  <para style="h">भजन संहिता</para>
  <para style="toc1">भजन संहिता</para>
  <para style="toc2">भजन संहिता</para>
  <para style="toc3">भजन.</para>
  <para style="mt">भजन संहिता</para>
  <para style="is">लेखक</para>
  <para style="ip">कविताओं का संग्रह, भजन संहिता पुराणे नियम की किताबां म्ह एक सै जिस म्ह अनेक रचयिताओं की रचनाओं का संग्रह सै। इसके अनेक लेखक सै: दाऊद, आसाप, कोरह के बेट्टे, सुलैमान, एतान, हेमान, मूसा अर अज्ञात भजनकार सै। सुलैमान अर मूसा की अपेक्षा सब भजनकार या तो याजक थे या लेवी थे जो दाऊद के राज्य म्ह पवित्र जगहां म्ह उपासना खात्तर संगीत की व्यवस्था का जिम्मेदारी निभाण लागरे थे।</para>
  <para style="is">लिखण की तारिख अर जगहां</para>
  <para style="ip">तकरीबन 1440 - 430 ई. पू.</para>
  <para style="ip">व्यक्तिगत भजन इतिहास म्ह मूसा के बखत तक पुराणे सै अर दाऊद, आसाप, सुलैमान अर एज्रा पंथियों (बाबेल की गुलाम्मी के बाद) तक के सै। इसका मतलब सै की इस किताब म्ह तकरीबन एक हजार साल का भजन संग्रह सै।</para>
  <para style="is">प्रापक</para>
  <para style="ip">इस्राएल की प्रजा परमेसवर नै उनकै खात्तर अर सम्पूर्ण इतिहास म्ह बिश्वासियाँ खात्तर के करया सै।</para>
  <para style="is">मकसद</para>
  <para style="ip">भजनां के विषय रहे सै: परमेसवर अर उसकी सृष्टि, युद्ध, आराधना, बुद्धि, पाप अर बुराई, दण्ड, न्याय अर मसीह का आगमन। भजन पाठकां ताहीं प्रोत्साहित करै सै के वे परमेसवर का अर उसके काम्मां का गुणगान करें। भजन म्हारे परमेसवर की महानता नै प्रकाशित करै सै। संकटकाल म्ह म्हारे खात्तर उसकी बिश्वासयोग्यता की पुष्टि करै सै अर हमनै उसके वचन की परम केन्द्रिता का याद करवावै सै।</para>
  <para style="is">खास बातें</para>
  <para style="ip">तारीफ</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. मसीही किताब <char style="ior"><ref loc="PSA 1:1-41:13">1:1-41:13</ref></char></para>
  <para style="io1">2. मनोकामना की किताब <char style="ior"><ref loc="PSA 42:1-72:20">42:1-72:20</ref></char></para>
  <para style="io1">3. इस्राएल की किताब <char style="ior"><ref loc="PSA 73:1-89:52">73:1-89:52</ref></char></para>
  <para style="io1">4. परमेसवर के शासन की किताब <char style="ior"><ref loc="PSA 90:1-106:48">90:1-106:48</ref></char></para>
  <para style="io1">5. गुणगान की किताब <char style="ior"><ref loc="PSA 107:1-150:6">107:1-150:6</ref></char></para>
  <chapter number="1" style="c" sid="PSA 1" />
  <para style="ms">पैहला भाग</para>
  <para style="mr">
    <ref loc="PSA 1-41">भजन संहिता 1-41</ref></para>
  <para style="s">परमेसवर के नियम-कायदा म्ह सच्‍चा सुख</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 1:1" />धन्य सै वो माणस जो दुष्टां की युक्ति पै न्ही चाल्दा,</para>
  <para style="q" vid="PSA 1:1">अर ना पापियाँ की राह म्ह खड्या होंदा;</para>
  <para style="q" vid="PSA 1:1">अर ना मजाक करण आळयां की मण्डळी म्ह बैठदा।<verse eid="PSA 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 1:2" />पर वो तो यहोवा के नियम-कायदा तै राज्जी रहवै सै;</para>
  <para style="q" vid="PSA 1:2">अर उसके नियमां पै रात-दिन ध्यान करै सै।<verse eid="PSA 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 1:3" />वो उस दरखतां कै ढाळ सै, जो बहन्दे होए पाणी के किनारे लगाया गया सै।</para>
  <para style="q" vid="PSA 1:3">अर अपणे मौसम म्ह फळै सै,</para>
  <para style="q" vid="PSA 1:3">अर जिसके पत्ते कदे भी मुरझांदे कोन्या।</para>
  <para style="q" vid="PSA 1:3">अर जो किमे वो माणस करै सै वो कामयाब होवै सै<verse eid="PSA 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 1:4" />पर दुष्ट माणस इसे न्ही होन्दे,</para>
  <para style="q" vid="PSA 1:4">वे उस फूस की ढाळ होवै सै, जो हवा तै उड़ाया जावै सै।<verse eid="PSA 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 1:5" />इस कारण दुष्ट माणस कच्हेड़ी म्ह टिके न्ही रह सकैगे,</para>
  <para style="q" vid="PSA 1:5">अर ना पापी धर्मियाँ की मण्डळी म्ह ठैहर सकैगें;<verse eid="PSA 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 1:6" />क्यूँके यहोवा धर्मियाँ की राह नै जाणै सै,</para>
  <para style="q" vid="PSA 1:6">पर दुष्टां का राह नाश हो जावैगा।<verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" sid="PSA 2" />
  <para style="s">बेट्टे का राज-तिलक</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 2:1" />जात्ति-जात्ति के माणस क्यूँ हुड़दंग मचावै सै,</para>
  <para style="q" vid="PSA 2:1">अर देश-देश के माणस क्यूँ साजिस रचण लागरे सै?<verse eid="PSA 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 2:2" />यहोवा अर उसके चुणे होये कै बिरुध्द धरती के राजा मिलकै,</para>
  <para style="q" vid="PSA 2:2">अर हाकिम आप्पस म्ह साजिस रचकै, कहवै सै,<verse eid="PSA 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 2:3" />“आओ, हम उनके बन्धनां नै तोड़ द्या,</para>
  <para style="q" vid="PSA 2:3">अर उनकी रस्सियाँ नै अपणे उप्पर तै उतार फेक्‍कां।”<verse eid="PSA 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 2:4" />वो जो सुर्ग म्ह बैठ्या सै, हास्सैगा,</para>
  <para style="q" vid="PSA 2:4">प्रभु उनका मजाक उड़ावैगा।<verse eid="PSA 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 2:5" />फेर वो उनतै छो म्ह बात करैगा,</para>
  <para style="q" vid="PSA 2:5">अर छो म्ह आकै यो कहकै उननै डरा देवैगा,<verse eid="PSA 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 2:6" />“मन्‍नै तो अपणा चुण्या होया राजा</para>
  <para style="q" vid="PSA 2:6">अपणे पवित्र पर्वत सिय्योन<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="fq" closed="false">सिय्योन </char><char style="ft" closed="false">सिय्योन का पर्वत जिसनै यरुशलेम नगर कह्या जावै था, जड़ै राजा सुलैमान नै मन्दर बणवाया था।</char></note> की राजगद्दी पै बिठा दिया सै।”<verse eid="PSA 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 2:7" />मै उस वचन का प्रचार करुँगा,</para>
  <para style="q" vid="PSA 2:7">जो यहोवा नै मेरै तै कह्या, “तू मेरा बेट्टा सै,</para>
  <para style="q" vid="PSA 2:7">आज ए मन्‍नै तेरे ताहीं जन्माया सै।<verse eid="PSA 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 2:8" />मेरै तै माँग, अर मै जात्ति-जात्ति के माणसां नै तेरी सम्पत्ति होण खात्तर,</para>
  <para style="q" vid="PSA 2:8">अर दूर-दूर के देशां नै तेरी अपणी धरती बणण खात्तर दे दियुँगा।<verse eid="PSA 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 2:9" />तू उननै लोहे के डण्‍डे तै टुकड़े-टुकड़े करैगा।</para>
  <para style="q" vid="PSA 2:9">तू कुम्हार के बरतन की तरियां उननै चकणाचूर कर देवैगा।”<verse eid="PSA 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 2:10" />इस करकै इब, हे राजाओं, अकलमंद बणो;</para>
  <para style="q" vid="PSA 2:10">हे धरती पै राज करण आळेयो, सावधान हो जाओ।<verse eid="PSA 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 2:11" />डरदे होए यहोवा की भक्ति करो,</para>
  <para style="q" vid="PSA 2:11">अर काँम्बदे होए मगन होओ।<verse eid="PSA 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 2:12" />बेट्टे तै प्यार करो, इसा ना हो के वो छो म्ह आवै,</para>
  <para style="q" vid="PSA 2:12">अर थम राह म्ह ए नाश हो जाओ;</para>
  <para style="q" vid="PSA 2:12">क्यूँके पलभर म्ह ए उसका छो भड़कण आळा सै।</para>
  <para style="q" vid="PSA 2:12">धन्य सै वे जो उस म्ह शरण लेवै सै।<verse eid="PSA 2:12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" sid="PSA 3" />
  <para style="s">संकट कै बखत आत्मबिश्वास</para>
  <para style="d">दाऊद का भजन। जिब वो अपणे बेट्टे अबशालोम कै स्याम्ही तै भाज्जै था</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 3:1" />हे यहोवा मेरे सताण आळे कितणे बढ़गे सै!</para>
  <para style="q" vid="PSA 3:1">वे जो मेरै बिरुध्द उठै सै घणे सै।<verse eid="PSA 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 3:2" />घणखरे मेरै बारै म्ह कहवै सै,</para>
  <para style="q" vid="PSA 3:2">के उसकी मदद<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fq" closed="false">मदद </char><char style="ft" closed="false">बचाव</char></note> परमेसवर की ओड़ तै न्ही हो सकदी। (सेला)<verse eid="PSA 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 3:3" />पर हे यहोवा, तू तो मेरै च्यांरु ओड़ मेरी ढाल सै,</para>
  <para style="q" vid="PSA 3:3">तू मेरी महिमा अर मेरा सिर ऊँच्‍चा करण आळा सै।<verse eid="PSA 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 3:4" />मै ऊँच्‍ची आवाज म्ह यहोवा नै पुकारूँगा,</para>
  <para style="q" vid="PSA 3:4">अर वो अपणे पवित्र पर्वत तै मन्‍नै जवाब देवै सै। (सेला)<verse eid="PSA 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 3:5" />मै लेट कै सो ग्या,</para>
  <para style="q" vid="PSA 3:5">फेर जाग ग्या, क्यूँके यहोवा मन्‍नै सम्भाळ सै।<verse eid="PSA 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 3:6" />मै उस भीड़ तै न्ही डरदा,</para>
  <para style="q" vid="PSA 3:6">जो मेरै बिरुध्द च्यांरु ओड़ पाँति बाँधे खड़े सै।<verse eid="PSA 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 3:7" />उठ, हे यहोवा! हे मेरे परमेसवर मन्‍नै बचाले!</para>
  <para style="q" vid="PSA 3:7">क्यूँके तन्‍नै मेरे सारे दुश्मनां के जबाडां पै मारया सै,</para>
  <para style="q" vid="PSA 3:7">अर तन्‍नै दुष्टां के दांद तोड़ दिये सै।<verse eid="PSA 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 3:8" />उद्धार<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="fq" closed="false">उद्धार </char><char style="ft" closed="false">जीत </char></note> यहोवा की ए ओड़ तै होवै सै,</para>
  <para style="q" vid="PSA 3:8">हे यहोवा तेरी आशीष तेरी प्रजा पै हो।<verse eid="PSA 3:8" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" sid="PSA 4" />
  <para style="s">परमेसवर पै भरोस्सा</para>
  <para style="d">प्रधान बजाण आळे खात्तर तारआळे बाज्यां के गैल। दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 4:1" />हे मेरे धर्मी परमेसवर,</para>
  <para style="q" vid="PSA 4:1">जिब मै पुकारूँ तब मन्‍नै जवाब दे; जिब मै बिप्दा म्ह पड्या तो तन्‍नै मेरे ताहीं सहारा दिया।</para>
  <para style="q" vid="PSA 4:1">मेरै पै दया कर अर मेरी प्रार्थना सुण ले।<verse eid="PSA 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 4:2" />हे माणसों, कद ताहीं मेरी महिमा का अनादर होंदा रहवैगा?</para>
  <para style="q" vid="PSA 4:2">थम कद ताहीं बेकार की बात्तां तै लगाव राक्खोगे अर झूठ्ठी युक्ति की टोह् म्ह रहोगे?<verse eid="PSA 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 4:3" />या जाण ल्यो के यहोवा नै अपणे भगत ताहीं अपणे खात्तर न्यारा छाँट राख्या सै,</para>
  <para style="q" vid="PSA 4:3">जब मै यहोवा नै पुकारूँगा तो वो मेरी सुण लेगा।<verse eid="PSA 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 4:4" />काँपते रहो अर पाप ना करो;</para>
  <para style="q" vid="PSA 4:4">अपणे-अपणे बिछोणे पै मन ए मन म्ह ध्यान करो अर चुपचाप रहो। (सेला)<verse eid="PSA 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 4:5" />धार्मिकता के बलिदान चढ़ाओ,</para>
  <para style="q" vid="PSA 4:5">अर यहोवा पै भरोस्सा राक्खो।<verse eid="PSA 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 4:6" />घणखरे सै जो कहवै सै, “कौण हमनै कुछ भलाई दिखावैगा?”</para>
  <para style="q" vid="PSA 4:6">हे यहोवा, तू अपणे मुँह का चान्दणा म्हारै पै चमका!<verse eid="PSA 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 4:7" />तन्‍नै मेरै मन म्ह उसतै घणा आनन्द भर दिया सै,</para>
  <para style="q" vid="PSA 4:7">जो उननै नाज अर दाखमधु की बढ़ोतरी तै होवै सै।<verse eid="PSA 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 4:8" />मै शान्ति तै लेट जाऊँगा अर सो जाऊँगा,</para>
  <para style="q" vid="PSA 4:8">क्यूँके, हे यहोवा, सिर्फ तू ए मन्‍नै निश्चिन्त रहण देवै सै।<verse eid="PSA 4:8" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" sid="PSA 5" />
  <para style="s">अगुवाई की प्रार्थना</para>
  <para style="d">प्रधान बजाण आळे खात्तर: बांसुरियाँ गैल, दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 5:1" />हे यहोवा, मेरे वचनां पै कान लगा;</para>
  <para style="q" vid="PSA 5:1">मेरै कराहण पै ध्यान लगा।<verse eid="PSA 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 5:2" />हे मेरे राजा, हे मेरे परमेसवर, मेरी दुहाई पै ध्यान दे,</para>
  <para style="q" vid="PSA 5:2">क्यूँके मै तेरे तै ए प्रार्थना<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="fq" closed="false">प्रार्थना </char><char style="ft" closed="false">बलिदान चढ़ाण खात्तर </char></note> करुँ सूं।<verse eid="PSA 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 5:3" />हे यहोवा, तड़कैए तन्‍नै मेरी वाणी सुणाई देगी,</para>
  <para style="q" vid="PSA 5:3">मै तड़कैए तेरी प्रार्थना करकै<note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="fq" closed="false">प्रार्थना करकै </char><char style="ft" closed="false">बलिदान चढ़ाण खात्तर</char></note> तेरी बाट देक्खुँगा।<verse eid="PSA 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 5:4" />क्यूँके तू इसा परमेसवर सै, जो बुराई तै राज्जी न्ही होन्दा;</para>
  <para style="q" vid="PSA 5:4">बुरे माणस तेरे गैल न्ही रह सकदे।<verse eid="PSA 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 5:5" />घमण्डी तेरे स्याम्ही खड़े न्ही होण पावैंगें;</para>
  <para style="q" vid="PSA 5:5">तन्‍नै सारे अनर्थकारियाँ तै घृणा सै।<verse eid="PSA 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 5:6" />तू उननै जो झूठ बोल्‍लै सै नाश करैगा;</para>
  <para style="q" vid="PSA 5:6">यहोवा तो हत्यारे अर कपटी माणस तै घृणा करै सै।<verse eid="PSA 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 5:7" />पर मै तो तेरी अपार करुणा कै कारण तेरे भवन म्ह आऊँगा,</para>
  <para style="q" vid="PSA 5:7">मै तेरा भय मानकै तेरे पवित्र मन्दर की ओड़ दण्डवत करुँगा।<verse eid="PSA 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 5:8" />हे यहोवा, मेरै दुश्मनां कै कारण अपणी धार्मिकता की राह म्ह मेरी अगुवाई कर;</para>
  <para style="q" vid="PSA 5:8">मेरै आग्गै-आग्गै अपणी सीध्धी राह दिखा।<verse eid="PSA 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 5:9" />क्यूँके उनकै मुँह म्ह कोए सच्‍चाई न्ही;</para>
  <para style="q" vid="PSA 5:9">उनके मन म्ह निरी बुराई भरी सै।</para>
  <para style="q" vid="PSA 5:9">उनका गळा खुली होड़ कब्र सै,</para>
  <para style="q" vid="PSA 5:9">वे अपणी जीभ तै चिकणी-चुपड़ी बात करै सै।<verse eid="PSA 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 5:10" />हे परमेसवर तू उननै दोषी ठैहरा;</para>
  <para style="q" vid="PSA 5:10">वे अपणी युक्तियाँ तै आप्पे गिर जावै;</para>
  <para style="q" vid="PSA 5:10">उननै उनके घणे अपराध्धां के कारण लिकाड़कै बाहरणै कर,</para>
  <para style="q" vid="PSA 5:10">क्यूँके उननै तेरे तै बलवा करया सै।<verse eid="PSA 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 5:11" />पर जितने तेरे म्ह शरण लेवै सै, वे सारे आनन्द करै,</para>
  <para style="q" vid="PSA 5:11">वे सदा ऊँच्‍ची आवाज म्ह गान्दे रहवै; क्यूँके तू उनकी हिफाजत करै सै,</para>
  <para style="q" vid="PSA 5:11">अर जो तेरे नाम के प्रेमी सै तेरे म्ह फुल्‍ले न्ही समावै।<verse eid="PSA 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 5:12" />क्यूँके तू धर्मी नै आशीष देवैगा; हे यहोवा,</para>
  <para style="q" vid="PSA 5:12">तू उसनै ढाल की तरियां अपणी कृपा तै घेरे रहवैगा।<verse eid="PSA 5:12" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" sid="PSA 6" />
  <para style="s">दया खात्तर प्रार्थना</para>
  <para style="d">प्रधान बजाण आळे खात्तर: ताराआळे बाज्यां कै गैल। खर्ज की राग म्ह, दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 6:1" />हे यहोवा, तू मन्‍नै अपणे छो म्ह ना डाँट,</para>
  <para style="q" vid="PSA 6:1">अर ना झुंझलाहट म्ह मन्‍नै ताड़ना दे।<verse eid="PSA 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 6:2" />हे यहोवा, मेरे पै दया कर, क्यूँके मै कुम्हला ग्या सूं;</para>
  <para style="q" vid="PSA 6:2">हे यहोवा, मन्‍नै चंगा कर, क्यूँके मेरी हाड्डियाँ म्ह बेचैनी सै।<verse eid="PSA 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 6:3" />मेरा जी घणा दुखी सै।</para>
  <para style="q" vid="PSA 6:3">अर तू हे यहोवा, कद तक?<verse eid="PSA 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 6:4" />लौट आ, हे यहोवा, अर मेरी जान बचा,</para>
  <para style="q" vid="PSA 6:4">अपणी करुणा कै मुताबिक मेरा उद्धार कर।<verse eid="PSA 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 6:5" />क्यूँके मरै पाच्छै तन्‍नै कोए याद न्ही करदा,</para>
  <para style="q" vid="PSA 6:5">अधोलोक<note caller="+" style="f"><char style="fr" closed="false">6:5 </char><char style="ft" closed="false">वो जगहां जड़ै मरे होए माणसां की आत्मा न्याय करण तै पैहले रहवै सै।</char></note> म्ह कौण तेरा धन्यवाद करैगा?<verse eid="PSA 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 6:6" />मै कहरान्दे-कहरान्दे थक ग्या;</para>
  <para style="q" vid="PSA 6:6">मै अपणी खाट आँसुआँ म्ह भेऊँ सूं;</para>
  <para style="q" vid="PSA 6:6">रोज रात नै मेरा बिछाणा भिझै सै।<verse eid="PSA 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 6:7" />मेरी आँख शोक तै बैठ्ठी जावै सै,</para>
  <para style="q" vid="PSA 6:7">अर मेरे सब सताण आळयां कै कारण वे धुँधळागी सै।<verse eid="PSA 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 6:8" />हे सब अनर्थकारियों मेरै धोरै तै दूर हो जाओ;</para>
  <para style="q" vid="PSA 6:8">क्यूँके यहोवा नै मेरा रोणा सुण लिया सै।<verse eid="PSA 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 6:9" />यहोवा नै मेरा गिड़गिड़ाणा सुण्या सै;</para>
  <para style="q" vid="PSA 6:9">यहोवा मेरी प्रार्थना नै भी सुणैगा।<verse eid="PSA 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 6:10" />मेरे सारे दुश्मन शर्मिन्दा होवैगें अर घणे घबरावैंगे;</para>
  <para style="q" vid="PSA 6:10">वे हार कै चले जावैंगे, अर चाणचक शर्मिन्दा होवैगें।<verse eid="PSA 6:10" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" sid="PSA 7" />
  <para style="s">न्याय खात्तर प्रार्थना</para>
  <para style="d">दाऊद का शिग्गायोन नाम का भजन जो बिन्‍यामीनी कूश की बात्तां कै कारण यहोवा कै स्याम्ही गाया</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 7:1" />हे मेरे परमेसवर यहोवा, मै तेरे म्ह शरण लेऊँ सूं;</para>
  <para style="q" vid="PSA 7:1">सारे पिच्छा करण आळयां तै मन्‍नै बचा अर छुटकारा दे,<verse eid="PSA 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 7:2" />इसा ना हो के वे मन्‍नै शेर की तरियां</para>
  <para style="q" vid="PSA 7:2">पाड़कै टुकड़े-टुकड़े करदे;</para>
  <para style="q" vid="PSA 7:2">अर कोए मेरा छुड़ाण आळा ना हो।<verse eid="PSA 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 7:3" />हे मेरे परमेसवर यहोवा,</para>
  <para style="q" vid="PSA 7:3">जै मन्‍नै यो करया हो, जै मेरै हाथ्थां तै कोए गलत काम होया हो,<verse eid="PSA 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 7:4" />जै मन्‍नै अपणे मेळ राक्खण आळयां तै भलाई कै बदलै बुराई करी हो,</para>
  <para style="q" vid="PSA 7:4">या मन्‍नै उस ताहीं जो बिना कारण मेरा बैरी था लूट्या हो<verse eid="PSA 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 7:5" />तो दुश्मन मेरी जान का प्यासा होकै मन्‍नै आण पकड़ै,</para>
  <para style="q" vid="PSA 7:5">अर मन्‍नै धरती पै रौंदे,</para>
  <para style="q" vid="PSA 7:5">अर मेरी बेजती करकै माट्टी म्ह मिला दे। (सेला)<verse eid="PSA 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 7:6" />हे यहोवा अपणे छो म्ह उठ;</para>
  <para style="q" vid="PSA 7:6">छो तै भरे मेरे सताण आळयां कै बिरुध्द तू खड्या हो जा;</para>
  <para style="q" vid="PSA 7:6">मेरै खात्तर जाग! तन्‍नै न्याय का हुक्म दे दिया सै।<verse eid="PSA 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 7:7" />देश-देश के माणस तेरे चारु कान्ही कठ्ठे होए सै;</para>
  <para style="q" vid="PSA 7:7">तू फेर तै उनकै उप्पर विराजमान हो!<verse eid="PSA 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 7:8" />यहोवा जात्ति-जात्ति का न्याय करै सै;</para>
  <para style="q" vid="PSA 7:8">यहोवा मेरै धार्मिकता अर खराई कै मुताबिक मेरा न्याय चुका दे।<verse eid="PSA 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 7:9" />भला हो के दुष्टां की बुराई का अंत हो जावै, पर धर्मी नै तू मजबूत कर;</para>
  <para style="q" vid="PSA 7:9">क्यूँके धर्मी परमेसवर मन अर मर्म का जाणण आळा सै।<verse eid="PSA 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 7:10" />मेरी ढाल परमेसवर कै हाथ म्ह सै,</para>
  <para style="q" vid="PSA 7:10">वो सीध्धे मन आळयां नै बचावै सै।<verse eid="PSA 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 7:11" />परमेसवर धर्मी अर न्यायी सै,</para>
  <para style="q" vid="PSA 7:11">बल्कि इसा परमेसवर सै, जो रोज छो करै सै।<verse eid="PSA 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 7:12" />जै माणस पाप करणा ना छोड़ै तो वो अपणी तलवार पै धार लगावैगा;</para>
  <para style="q" vid="PSA 7:12">अर वो युद्ध करण खात्तर अपणा धनुष तैयार करैगा।<verse eid="PSA 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 7:13" />अर उस माणस खात्तर उसनै मौत के हथियार तैयार कर लिए सै,</para>
  <para style="q" vid="PSA 7:13">वो अपणे तीरां नै अग्निबाण बणावै सै।<verse eid="PSA 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 7:14" />देख दुष्ट नै अनर्थ काम की तकलीफ होण लागरी सै,</para>
  <para style="q" vid="PSA 7:14">उसनै उत्पात का गर्भ सै, अर उसतै झूठ पैदा होया।<verse eid="PSA 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 7:15" />उसनै खड्डा खोदकै उस ताहीं ढुंघा करया,</para>
  <para style="q" vid="PSA 7:15">अर जो खाई उसनै बणाई थी उस म्ह वो आप्पे पड्या।<verse eid="PSA 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 7:16" />उसका उत्पात पलटकै उस्से कै सिर पै पड़ैगा;</para>
  <para style="q" vid="PSA 7:16">अर उसका उपद्रव उस्से कै माथ्थै पै पड़ैगा।<verse eid="PSA 7:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 7:17" />मै यहोवा के धर्म के मुताबिक उसका धन्यवाद करुँगा,</para>
  <para style="q" vid="PSA 7:17">अर परमप्रधान यहोवा के नाम का भजन गाऊँगा।<verse eid="PSA 7:17" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" sid="PSA 8" />
  <para style="s">परमेसवर की महिमा अर माणस का गौरव</para>
  <para style="d">प्रधान बजाण आळे खात्तर गित्तीत की राग पै दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 8:1" />हे यहोवा म्हारे प्रभु, तेरा नाम सारी धरती पै कितना प्रतापमय सै।</para>
  <para style="q" vid="PSA 8:1">तन्‍नै अपणा वैभव सुर्ग पै दिखाया सै।<verse eid="PSA 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 8:2" />तन्‍नै अपणे बैरियाँ कै कारण बाळकां अर दूध पीन्दे बच्यां कै जरिये अपणी बड़ाई करी सै,</para>
  <para style="q" vid="PSA 8:2">ताके तू दुश्मन अर पलटा लेण आळयां नै रोक्‍के राक्खै।<verse eid="PSA 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 8:3" />जिब मै अकास नै, जो तेरे हाथ का काम सै,</para>
  <para style="q" vid="PSA 8:3">अर चाँद अर तारयां नै जो तन्‍नै ए बणाये सै, देक्खूँ सूं।<verse eid="PSA 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 8:4" />तो फेर माणस के सै के तू उसनै याद राक्खै,</para>
  <para style="q" vid="PSA 8:4">अर आदमी के सै के तू उसकी सुधि ले?<verse eid="PSA 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 8:5" />क्यूँके तन्‍नै उस ताहीं परमेसवर<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="fq" closed="false">परमेसवर </char><char style="ft" closed="false">सुर्गदूत तै कम </char></note> तै थोड़ा ए घाट बणाया सै,</para>
  <para style="q" vid="PSA 8:5">अर महिमा अर प्रताप का मुकुट उसकै सिर पै धरया सै।<verse eid="PSA 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 8:6" />तन्‍नै उस ताहीं अपणे हाथ्थां के काम्मां पै प्रभुता दी सै,</para>
  <para style="q" vid="PSA 8:6">तन्‍नै उसकै पायां तळै सारा किमे कर दिया सै<note caller="+" style="f"><char style="fr" closed="false">8:6 </char><char style="fq" closed="false">तन्‍नै उसकै पायां तळै सारा किमे कर दिया सै </char><char style="ft" closed="false">1 कुरि 15:27; इफि 1:22; इब्रा 2:6-9; प्रेरि 17:31</char></note>।<verse eid="PSA 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 8:7" />सारी भेड़-बकरी अर गां-बळध</para>
  <para style="q" vid="PSA 8:7">अर जितने जंगळी-पशु सै,<verse eid="PSA 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 8:8" />अकास के पंछी अर समुन्दर की मछलियाँ,</para>
  <para style="q" vid="PSA 8:8">अर जितने जीव-जन्तु समुन्दरां म्ह चाल्‍लै-फिरै सै।<verse eid="PSA 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 8:9" />हे यहोवा, हे म्हारे प्रभु,</para>
  <para style="q" vid="PSA 8:9">तेरा नाम सारी धरती पै कितना प्रतापमय सै।<verse eid="PSA 8:9" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" sid="PSA 9" />
  <para style="s">जीत कै खात्तर धन्यवाद</para>
  <para style="d">प्रधान बजाण आळे कै खात्तर मुतलबैयन की राग पै दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 9:1" />हे यहोवा परमेसवर मै अपणे पूरे मन तै तेरा धन्यवाद करुँगा;</para>
  <para style="q" vid="PSA 9:1">मै तेरे सारे अचम्भे के काम्मां का जिक्र करुँगा।<verse eid="PSA 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 9:2" />मै तेरे कारण राज्जी अर फुल्या न्ही समाऊँगा,</para>
  <para style="q" vid="PSA 9:2">हे परमप्रधान, मै तेरे नाम का भजन गाऊँगा।<verse eid="PSA 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 9:3" />मेरे दुश्मन हार कै पाच्छै हटै सै,</para>
  <para style="q" vid="PSA 9:3">वे तेरे स्याम्ही ठोक्‍कर खाकै नाश होवै सै।<verse eid="PSA 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 9:4" />तन्‍नै मेरे मुकद्दमें का न्याय मेरे हक म्ह करया सै;</para>
  <para style="q" vid="PSA 9:4">तन्‍नै सिंहासन पै विराजमान हो कै धार्मिकता तै न्याय करया।<verse eid="PSA 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 9:5" />तन्‍नै जात्ति-जात्ति ताहीं झिड़क्या अर दुष्ट का नाश करया सै;</para>
  <para style="q" vid="PSA 9:5">तन्‍नै उनका नाम सदा काल खात्तर मिटा दिया सै।<verse eid="PSA 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 9:6" />दुश्मन अनन्त काल ताहीं उजड़ लिये सै;</para>
  <para style="q" vid="PSA 9:6">उनके नगरां ताहीं तन्‍नै ढ़ा दिया,</para>
  <para style="q" vid="PSA 9:6">अर उनका नामो-निशान भी मिट ग्या सै।<verse eid="PSA 9:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 9:7" />पर यहोवा सदा सिंहासन पै विराजमान सै,</para>
  <para style="q" vid="PSA 9:7">उसनै अपणा सिंहासन न्याय खात्तर सिध्द करया सै।<verse eid="PSA 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 9:8" />अर वो आप्पे दुनिया का न्याय धर्म तै करैगा;</para>
  <para style="q" vid="PSA 9:8">वो देश-देश के माणसां का मुकद्दमा खराई तै निपटावैगा।<verse eid="PSA 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 9:9" />यहोवा पईसे होया खात्तर ऊँच्‍चा गढ़ ठहरैगा,</para>
  <para style="q" vid="PSA 9:9">वो मुसीबत के बखत म्ह भी ऊँच्‍चा गढ़ ठहरैगा।<verse eid="PSA 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 9:10" />अर तेरे नाम के जाणण आळे तेरे पै भरोस्सा राक्खैंगें;</para>
  <para style="q" vid="PSA 9:10">क्यूँके हे यहोवा जो तन्‍नै टोहवै सै उननै तू त्यागै कोन्या।<verse eid="PSA 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 9:11" />यहोवा जो सिय्योन म्ह विराजमान सै, उसका भजन गाओ!</para>
  <para style="q" vid="PSA 9:11">जात्ति-जात्ति के माणसां म्ह उसके बड़े-बड़े काम्मां का प्रचार करो!<verse eid="PSA 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 9:12" />क्यूँके खून का पलटा लेण आळा उसनै याद करै सै;</para>
  <para style="q" vid="PSA 9:12">वो पिसे होए माणसां की दुहाई नै न्ही भूलदा।<verse eid="PSA 9:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 9:13" />हे यहोवा, मेरै पै दया कर। देख, मेरे बैरी मेरे पै जुल्म करण लागरे सै,</para>
  <para style="q" vid="PSA 9:13">तू ए मन्‍नै मौत के दरबाजे तै बचा सकै सै।<verse eid="PSA 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 9:14" />ताके मै सिय्योन के दरवाज्यां कै धोरै तेरे सारे गुणा का जिक्र करुँ,</para>
  <para style="q" vid="PSA 9:14">अर तेरे करे होए उद्धार तै मगन होऊँ।<verse eid="PSA 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 9:15" />दुसरी जात आळयां नै जो खड्डा खोद्या था, उस्से म्ह वे आप गिरगे;</para>
  <para style="q" vid="PSA 9:15">जो जाळ उननै लगाया था, उन म्ह उनका ए पैर फँस ग्या।<verse eid="PSA 9:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 9:16" />यहोवा नै अपणे-आप ताहीं उजागर करया, उसनै न्याय करया सै;</para>
  <para style="q" vid="PSA 9:16">दुष्ट अपणे करे होए काम्मां म्ह फँस जावै सै। (सेला)<verse eid="PSA 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 9:17" />दुष्ट अधोलोक म्ह चले जावैंगे,</para>
  <para style="q" vid="PSA 9:17">अर वे सारी जात भी जो परमेसवर नै भूल जावै सै।<verse eid="PSA 9:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 9:18" />क्यूँके दरिन्द्र माणस अनन्त काल तक बिसरे होए न्ही रहवैंगे,</para>
  <para style="q" vid="PSA 9:18">अर ना ए नम्र माणसां की आस सदा खात्तर नाश होवैगी।<verse eid="PSA 9:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 9:19" />उठ, हे परमेसवर, माणस हावी ना होण पावै!</para>
  <para style="q" vid="PSA 9:19">जातियाँ का न्याय तेरे स्याम्ही करया जावै।<verse eid="PSA 9:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 9:20" />हे यहोवा, उनकै डर बिठा!</para>
  <para style="q" vid="PSA 9:20">जातियाँ अपणे आप नै सिर्फ माणस ए जाणै। (सेला)<verse eid="PSA 9:20" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" sid="PSA 10" />
  <para style="s">न्याय खात्तर प्रार्थना</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 10:1" />हे यहोवा तू क्यूँ दूर खड्या रहवै सै?</para>
  <para style="q" vid="PSA 10:1">संकट कै बखत म्ह क्यूँ लुह्क्या रहवै सै?<verse eid="PSA 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 10:2" />दुष्टां के अहंकार के कारण दीन माणसां पै जुल्म होवै सै;</para>
  <para style="q" vid="PSA 10:2">वे अपणी ए लिकाड़ी होई युक्तियाँ म्ह फँस जावै।<verse eid="PSA 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 10:3" />क्यूँके दुष्ट अपणी अभिलाषा पै घमण्ड करै सै,</para>
  <para style="q" vid="PSA 10:3">अर लोभ्भी यहोवा नै छोड़ दे सै अर उसकी बदनाम्मी करै सै।<verse eid="PSA 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 10:4" />दुष्ट अपणे घमण्ड म्ह परमेसवर ताहीं न्ही टोहन्दा;</para>
  <para style="q" vid="PSA 10:4">उसकी सोच याए सै के कोए परमेसवर सै ए कोन्या<verse eid="PSA 10:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 10:5" />वो अपणी उस्से राह पै चाल्दा रहवै सै;</para>
  <para style="q" vid="PSA 10:5">तेरी धार्मिकता के नियम उसकी निगांह तै भोत दूर सै,</para>
  <para style="q" vid="PSA 10:5">जितने उसके बिरोधी सै उनपै वो फुँकारै सै।<verse eid="PSA 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 10:6" />वो अपणे मन म्ह कहवै सै के मै कदे टळण का न्ही</para>
  <para style="q" vid="PSA 10:6">मै पीढ़ी तै पीढ़ी दुख तै बच्या रहूँगा।<verse eid="PSA 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 10:7" />उसका मुँह श्राप, छळ अर धमकियाँ तै भरया सै;</para>
  <para style="q" vid="PSA 10:7">उत्पात अर अनर्थ की बात उसके मुँह म्ह सै।<verse eid="PSA 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 10:8" />वो गाम्मां म्ह हमला करण खात्तर लुह्क कै बैठ्ठै सै,</para>
  <para style="q" vid="PSA 10:8">अर गुप्त जगहां म्ह बेकसूर पै हमला करै सै,</para>
  <para style="q" vid="PSA 10:8">उसकी नजर लाचार पै हमला करण खात्तर लाग्गी रहवै सै।<verse eid="PSA 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 10:9" />वो शेर की तरियां झाड़ी म्ह लुह्क कै हमला करण खात्तर बैठ्या करै सै;</para>
  <para style="q" vid="PSA 10:9">वो दीन नै पकड़ण खात्तर हमला करै सै,</para>
  <para style="q" vid="PSA 10:9">वो दीन नै अपणे जाळ म्ह फँसाकै पकड़ लेवै सै।<verse eid="PSA 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 10:10" />लाचार माणसां ताहीं कुचल्या अर पिट्या जावै सै,</para>
  <para style="q" vid="PSA 10:10">वो उसके मजबूत जाळ म्ह फँस जावै सै।<verse eid="PSA 10:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 10:11" />वो अपणे मन म्ह सोच्‍चै सै, “परमेसवर भूल ग्या,</para>
  <para style="q" vid="PSA 10:11">वो अपणा मुँह ल्हकोवै सै; वो कदे न्ही देक्खैगा।”<verse eid="PSA 10:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 10:12" />उठ, हे यहोवा; हे परमेसवर, अपणा हाथ बढ़ा अर न्याय कर,</para>
  <para style="q" vid="PSA 10:12">अर दीन माणसां नै ना भूल।<verse eid="PSA 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 10:13" />परमेसवर नै दुष्ट क्यूँ छोट्टा जाणै सै,</para>
  <para style="q" vid="PSA 10:13">अर अपणे मन म्ह कहवै सै “तू लेखा न्ही लेगा?”<verse eid="PSA 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 10:14" />तन्‍नै देख लिया सै, क्यूँके तू उत्पात अर उत्पीडन पै नजर राक्खै सै, ताके उसका बदला अपणे हाथ म्ह राक्खै;</para>
  <para style="q" vid="PSA 10:14">लाचार अपणे आप नै तेरे हाथ्थां म्ह सौंपै सै;</para>
  <para style="q" vid="PSA 10:14">अनाथ्थां का तू ए मददगार रह्या सै।<verse eid="PSA 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 10:15" />दुष्ट अर बैरी की बांह नै तोड़दे;</para>
  <para style="q" vid="PSA 10:15">उनकी दुष्टता का लेखा ले, जिब तक के सारे उस म्ह तै दूर ना हो जावै।<verse eid="PSA 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 10:16" />यहोवा, अनन्त काल खात्तर महाराज सै,</para>
  <para style="q" vid="PSA 10:16">उसके देश म्ह तै जात्ति-जात्ति के लोग नाश होगे सै।<verse eid="PSA 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 10:17" />हे यहोवा, तन्‍नै नम्र माणसां की दुहाई सुणी सै,</para>
  <para style="q" vid="PSA 10:17">तू उनका मन मजबूत करैगा, तू कान लाकै सुणैगा,<verse eid="PSA 10:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 10:18" />ताके अनाथ अर पईसे होया का न्याय करै,</para>
  <para style="q" vid="PSA 10:18">ताके माणस जो माट्टी तै बण्या सै फेर वो डराण न्ही पावै।<verse eid="PSA 10:18" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" sid="PSA 11" />
  <para style="s">परमेसवर पै भरोस्सा</para>
  <para style="d">प्रधान बजाण आळे खात्तर दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 11:1" />मै यहोवा म्ह शरण लेऊँ सूं,</para>
  <para style="q" vid="PSA 11:1">तू किस तरियां तै मेरे प्राण नै कह सकै सै</para>
  <para style="q" vid="PSA 11:1">“पंछी की तरियां अपणे पहाड़ पै उड़ जा”;<verse eid="PSA 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 11:2" />क्यूँके देक्खो, दुष्ट अपणा धनुष चढ़ावै सै,</para>
  <para style="q" vid="PSA 11:2">अर अपणे तीर धनुष की डोरी पै चढ़ावै सै,</para>
  <para style="q" vid="PSA 11:2">के सीध्धे मन आळयां पै अन्धेरै म्ह तीर चलावै।<verse eid="PSA 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 11:3" />जै नींव ढ़ा दी जावै</para>
  <para style="q" vid="PSA 11:3">तो धर्मी के कर सकै सै?<verse eid="PSA 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 11:4" />यहोवा अपणे पवित्र भवन म्ह सै;</para>
  <para style="q" vid="PSA 11:4">यहोवा का सिंहासन सुर्ग म्ह सै;</para>
  <para style="q" vid="PSA 11:4">उसकी आँख माणस की औलाद नै सदा देखदी रहवै सै</para>
  <para style="q" vid="PSA 11:4">अर उसकी पलक उननै परखै सै।<verse eid="PSA 11:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 11:5" />यहोवा धर्मी अर दुष्ट नै परखै सै,</para>
  <para style="q" vid="PSA 11:5">पर जो उपद्रव तै लगाव राक्खै सै</para>
  <para style="q" vid="PSA 11:5">उनतै वो घृणा करै सै।<verse eid="PSA 11:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 11:6" />वो दुष्टां पै आग अर गन्धक बरसावैगा;</para>
  <para style="q" vid="PSA 11:6">अर तेज लू उनके कटोरे म्ह बाट दी जावैगी।<verse eid="PSA 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 11:7" />क्यूँके यहोवा धर्मी सै,</para>
  <para style="q" vid="PSA 11:7">वो धार्मिकता के काम्मां तै राज्जी रहवै सै;</para>
  <para style="q" vid="PSA 11:7">धर्मी माणस उसका दर्शन पावैंगें।<verse eid="PSA 11:7" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" sid="PSA 12" />
  <para style="s">दुष्ट के जरिये उत्पीड़न अर परमेसवर के जरिये स्थिर</para>
  <para style="d">प्रधान बजाण आळे खात्तर खर्ज की राग म्ह दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 12:1" />हे यहोवा बचाले, क्यूँके एक भी भगत न्ही रह्या;</para>
  <para style="q" vid="PSA 12:1">माणसां म्ह तै बिश्वास लायक माणस खतम हो लिए सै।<verse eid="PSA 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 12:2" />हरेक माणस अपणे पड़ोसी तै झूठ्ठी बात कहवै सै;</para>
  <para style="q" vid="PSA 12:2">वे चापलूसी के होठां तै दो रंगी बात करै सै।<verse eid="PSA 12:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 12:3" />यहोवा सारे चापलूस होठां नै</para>
  <para style="q" vid="PSA 12:3">अर उस जीभ नै जिसतै बड़ा बोल लिकड़ै सै काट देगा।<verse eid="PSA 12:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 12:4" />वे कहवै सै, “हम अपणी जीभ तै ए जीत्तांगें,</para>
  <para style="q" vid="PSA 12:4">म्हारे होठ म्हारे ए बस म्ह सै, म्हारे पै कौण राज कर सके सै?”<verse eid="PSA 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 12:5" />दीन माणसां के लूट जाण, अर दरिन्द्रां के कहराण कै कारण,</para>
  <para style="q" vid="PSA 12:5">यहोवा कहवै सै, “इब मै उठूँगा, जिसपै</para>
  <para style="q" vid="PSA 12:5">वे फुँकारै सै उसनै मै चैन आराम दियुँगा।”<verse eid="PSA 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 12:6" />यहोवा का वचन पवित्र सै,</para>
  <para style="q" vid="PSA 12:6">उस चाँदी कै समान जो भट्ठी म्ह माट्टी पै त्याई गई,</para>
  <para style="q" vid="PSA 12:6">अर सात बार निर्मल करी गई हो।<verse eid="PSA 12:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 12:7" />हे यहोवा तू ए म्हारी<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="fq" closed="false">म्हारी </char><char style="ft" closed="false">उनकी</char></note> सम्भाळ करैगा,</para>
  <para style="q" vid="PSA 12:7">हमनै<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="fq" closed="false">हमनै </char><char style="ft" closed="false">उननै </char></note> इस काल के माणसां तै सदा खात्तर बचाए राक्खैगा।<verse eid="PSA 12:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 12:8" />जिब माणसां म्ह बुराई का आदर होवै सै,</para>
  <para style="q" vid="PSA 12:8">फेर दुष्ट माणस चारु ओड़ अकड़दे फिरै सै।<verse eid="PSA 12:8" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" sid="PSA 13" />
  <para style="s">उद्धार खात्तर प्रार्थना</para>
  <para style="d">प्रधान बजाण आळे खात्तर दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 13:1" />हे यहोवा, तू कद तक? मन्‍नै भूल्या रहवैगा?</para>
  <para style="q" vid="PSA 13:1">तू कद ताहीं अपणा मुँह मेरै तै ल्हकोए राक्खैगा?<verse eid="PSA 13:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 13:2" />मै कद तक अपणे मन म्ह योजना बणान्दा रहूँ,</para>
  <para style="q" vid="PSA 13:2">अर दिन भर अपणे मन म्ह दुखी होंदा रहूँ,</para>
  <para style="q" vid="PSA 13:2">कद ताहीं मेरा दुश्मन मेरै पै हावी रहवैगा?<verse eid="PSA 13:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 13:3" />हे मेरे परमेसवर यहोवा मेरे कान्ही ध्यान दे अर मन्‍नै जवाब दे,</para>
  <para style="q" vid="PSA 13:3">मेरी आँखां म्ह चमक आण दे, न्ही तो मन्‍नै मौत की नींद आ जावैगी;<verse eid="PSA 13:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 13:4" />इसा ना हो के मेरा दुश्मन कहवै, “मै उसपै हावी होग्या”,</para>
  <para style="q" vid="PSA 13:4">अर इसा ना हो के जिब मै डगमगाण लाग्गू तो मेरे दुश्मन मगन हों।<verse eid="PSA 13:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 13:5" />पर मन्‍नै तो तेरी करुणा पै भरोस्सा राख्या सै;</para>
  <para style="q" vid="PSA 13:5">मेरा मन तेरे उद्धार तै मगन होवैगा।<verse eid="PSA 13:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 13:6" />मै यहोवा के नाम का भजन गाऊँगा,</para>
  <para style="q" vid="PSA 13:6">क्यूँके उसनै मेरी भलाई करी सै।<verse eid="PSA 13:6" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" sid="PSA 14" />
  <para style="s">पापियाँ की एक तस्वीर</para>
  <para style="d">प्रधान बजाण आळे खात्तर दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 14:1" />मूर्ख नै अपणे मन म्ह कह्या सै, “कोए परमेसवर सै ए कोन्या।”</para>
  <para style="q" vid="PSA 14:1">वे बिगड़गे, उननै घिनोणे काम करे सै,</para>
  <para style="q" vid="PSA 14:1">कोए आच्छा काम करणीया सै ए कोनी।<verse eid="PSA 14:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 14:2" />परमेसवर नै सुर्ग म्ह तै माणसां पै निगांह करी सै,</para>
  <para style="q" vid="PSA 14:2">देक्खै, के कोए अकलमंद,</para>
  <para style="q" vid="PSA 14:2">कोए परमेसवर नै टोह्ण आळा सै के न्ही।<verse eid="PSA 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 14:3" />वे सबके सब भटक ग्ये, वे सारे भ्रष्ट होग्ये;</para>
  <para style="q" vid="PSA 14:3">कोए आच्छा काम करणीया कोन्या एक भी कोन्या।<verse eid="PSA 14:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 14:4" />के किसे अनर्थकारी नै कुछ भी ज्ञान न्ही रहन्दा,</para>
  <para style="q" vid="PSA 14:4">जो मेरे माणसां नै इसे खा जावै सै जुकर रोट्टी,</para>
  <para style="q" vid="PSA 14:4">अर परमेसवर का नाम न्ही लेंदे?<verse eid="PSA 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 14:5" />ओड़ै उनपै भय छाग्या,</para>
  <para style="q" vid="PSA 14:5">क्यूँके परमेसवर धर्मी माणसां कै बिचाळै लगातार रहवै सै।<verse eid="PSA 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 14:6" />थम तो दीन की युक्ति पै हाँसी उड़ाओं सो</para>
  <para style="q" vid="PSA 14:6">पर यहोवा उसका शरणस्‍थान सै।<verse eid="PSA 14:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 14:7" />भला होंदा के इस्राएल का उद्धार सिय्योन तै उजागर होंदा!</para>
  <para style="q" vid="PSA 14:7">जिब यहोवा अपणी प्रजा नै गुलाम्मी तै बोहड़ा ल्यावैगा,</para>
  <para style="q" vid="PSA 14:7">फेर याकूब मगन अर इस्राएल देश राज्जी होवैगा।<verse eid="PSA 14:7" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" sid="PSA 15" />
  <para style="s">धर्मी का विवरण</para>
  <para style="d">दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 15:1" />हे यहोवा तेरे भवन म्ह कौण रहवैगा?</para>
  <para style="q" vid="PSA 15:1">तेरे पवित्र पर्वत पै कौण बसण पावैगा?<verse eid="PSA 15:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 15:2" />वो जो खराई तै चाल्‍लै अर धर्म के काम करै सै,</para>
  <para style="q" vid="PSA 15:2">अर दिल तै सच बोल्‍लै सै।<verse eid="PSA 15:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 15:3" />जो अपणी जीभ तै अपमान न्ही करदा,</para>
  <para style="q" vid="PSA 15:3">अर ना दुसरे माणसां की बुराई करदा,</para>
  <para style="q" vid="PSA 15:3">अर ना अपणे पड़ोसी का अपमान सुणै सै;<verse eid="PSA 15:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 15:4" />वो जिसकी निगांह म्ह निकम्मा माणस तुच्छ सै,</para>
  <para style="q" vid="PSA 15:4">पर जो यहोवा के भय मान्‍नण आळे का आदर करै सै,</para>
  <para style="q" vid="PSA 15:4">जो कसम खाकै बदलदा कोनी चाहे नुकसान ठाणा पड़ै;<verse eid="PSA 15:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 15:5" />जो अपणा रपियाँ ब्याज पै न्ही देंदा,</para>
  <para style="q" vid="PSA 15:5">अर बेकसूर का नुकसान करण खात्तर रिसवत न्ही लेन्दा।</para>
  <para style="q" vid="PSA 15:5">जो कोए इसी चाल चाल्‍लै सै वो कदे न्ही डगमगावैगा।<verse eid="PSA 15:5" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" sid="PSA 16" />
  <para style="s">परमेसवर मेरा भाग</para>
  <para style="d">दाऊद का मिक्ताम</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 16:1" />हे परमेसवर मेरी हिफाजत कर,</para>
  <para style="q" vid="PSA 16:1">क्यूँके मै तेराए शरणागत सूं।<verse eid="PSA 16:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 16:2" />मन्‍नै यहोवा तै कह्या सै, “तू ए मेरा प्रभु सै;</para>
  <para style="q" vid="PSA 16:2">तेरे सिवाए मेरी भलाई किते कोन्या।”<verse eid="PSA 16:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 16:3" />धरती पै जो पवित्र माणस सै,</para>
  <para style="q" vid="PSA 16:3">वोए आदर कै जोग्गे सै,</para>
  <para style="q" vid="PSA 16:3">अर उनतै मै राज्जी सूं।<verse eid="PSA 16:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 16:4" />जो पराये देवता कै पाच्छै भाग्गै सै उनका दुख बढ़ जावैगा;</para>
  <para style="q" vid="PSA 16:4">मै उन ताहीं लहूआळी भेंट न्ही चढ़ाऊँगा</para>
  <para style="q" vid="PSA 16:4">अर उनका नाम अपणे होठां तै न्ही ल्यूँगा।<verse eid="PSA 16:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 16:5" />यहोवा मेरा चुण्या होया भाग अर मेरा कटोरा सै;</para>
  <para style="q" vid="PSA 16:5">मेरै भाग नै तू टिकाये राक्खै सै।<verse eid="PSA 16:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 16:6" />मेरै खात्तर माप की डोरी मन भाण आळी जगहां म्ह पड़ी,</para>
  <para style="q" vid="PSA 16:6">मेरा भाग मन नै भावण आळा सै।<verse eid="PSA 16:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 16:7" />मै यहोवा नै धन्य कहूँ सूं,</para>
  <para style="q" vid="PSA 16:7">क्यूँके उसनै मेरै ताहीं तसल्‍ली दी सै;</para>
  <para style="q" vid="PSA 16:7">बल्के मेरा मन भी रात नै मन्‍नै शिक्षा देवै सै।<verse eid="PSA 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 16:8" />मन्‍नै यहोवा ताहीं लगातार अपणे स्याम्ही राख्या सै:</para>
  <para style="q" vid="PSA 16:8">इस करकै के वो मेरै सोळे हाथ नै रहवै सै मै कदे न्ही डगमगाऊँगा।<verse eid="PSA 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 16:9" />इस कारण मेरा मन आनन्दित</para>
  <para style="q" vid="PSA 16:9">अर मेरी आत्मा मगन होई;</para>
  <para style="q" vid="PSA 16:9">मेरी देह भी चैन तै रहवैगी।<verse eid="PSA 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 16:10" />क्यूँके तू मेरै प्राण नै अधोलोक म्ह न्ही छोड़ैगा,</para>
  <para style="q" vid="PSA 16:10">ना अपणे पवित्र भगत नै कब्र म्ह सड़ण देवैगा।<verse eid="PSA 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 16:11" />तू मन्‍नै जीवन की राह दिखावैगा;</para>
  <para style="q" vid="PSA 16:11">तेरे धोरै आनन्द की भरपूरी सै,</para>
  <para style="q" vid="PSA 16:11">तेरे सोळे हाथ म्ह सुख सदा बण्या रहवै सै।<verse eid="PSA 16:11" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" sid="PSA 17" />
  <para style="s">संरक्षण खात्तर प्रार्थना</para>
  <para style="d">दाऊद की प्रार्थना</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 17:1" />हे यहोवा परमेसवर सच्‍चाई के वचन सुण, मेरी पुकार की ओड़ ध्यान दे।</para>
  <para style="q" vid="PSA 17:1">मेरी प्रार्थना की ओड़ जो बिना कपट के मुँह तै लिकड़ै सै कान लगा।<verse eid="PSA 17:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 17:2" />मेरै मुकदमे का फैसला तेरे स्याम्ही हो!</para>
  <para style="q" vid="PSA 17:2">तेरी आँख न्याय पै लाग्गी रहवै।<verse eid="PSA 17:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 17:3" />जै तू मेरै मन नै परखदा तो जै तू रात नै मन्‍नै सिखान्दा,</para>
  <para style="q" vid="PSA 17:3">जै तू मन्‍नै परखदा तोभी खोट्टापण न्ही पान्दा;</para>
  <para style="q" vid="PSA 17:3">मेरै मुँह तै अपराध की बात न्ही लिकड़ैगी।<note caller="+" style="f"><char style="fr" closed="false">17:3 </char><char style="fq" closed="false">मेरै मुँह तै अपराध की बात न्ही लिकड़ैगी </char><char style="ft" closed="false">दुसरयां की तरियां मेरे मुँह तै अपराध की बात न्ही लिकड़ैगी </char></note><verse eid="PSA 17:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 17:4" />मानवीय काम्मां म्ह मै तेरे मुँह के वचन कै जरिये</para>
  <para style="q" vid="PSA 17:4">अधर्मियाँ के राह तै अपणे-आप ताहीं बचाए राख्या।<verse eid="PSA 17:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 17:5" />मेरै पाँ तेरे राह म्ह मजबुत्ती तै टिके रहवै, फिसळै न्ही।<verse eid="PSA 17:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 17:6" />हे परमेसवर, मन्‍नै तेरे तै प्रार्थना करी सै, क्यूँके तू मन्‍नै जवाब देवैगा।</para>
  <para style="q" vid="PSA 17:6">अपणा कान मेरी ओड़ लगाकै मेरी बिनती सुण ले।<verse eid="PSA 17:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 17:7" />तू जो अपणे सोळे हाथ तै अपणे</para>
  <para style="q" vid="PSA 17:7">शरणागतां नै बिरोधियाँ तै बचावै सै,</para>
  <para style="q" vid="PSA 17:7">अपणी अदभुत करुणा दिखा।<verse eid="PSA 17:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 17:8" />अपणी आँख्यां की पुतली की तरियां हिफाजत कर,</para>
  <para style="q" vid="PSA 17:8">अपणे पंखां कै तळै मन्‍नै लह्को के राख,<verse eid="PSA 17:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 17:9" />उन दुष्टां तै जो मेरै पै जुल्म करै सै,</para>
  <para style="q" vid="PSA 17:9">मेरी जान के दुश्मनां तै जो मन्‍नै घेरे खड़े सै।<verse eid="PSA 17:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 17:10" />उननै अपणे मन करड़े कर लिये सै;</para>
  <para style="q" vid="PSA 17:10">उनकै मुँह तै घमण्ड की बात लिकड़ै सै।<verse eid="PSA 17:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 17:11" />उननै कदम-कदम पै मेरे ताहीं घेरया सै;</para>
  <para style="q" vid="PSA 17:11">वे म्हारे ताहीं धरती पै पटकण खात्तर</para>
  <para style="q" vid="PSA 17:11">दा लगाये बेठ्ठे सै।<verse eid="PSA 17:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 17:12" />वो उस शेर की तरियां सै जो अपणे शिकार की लालसा करै सै,</para>
  <para style="q" vid="PSA 17:12">अर जवान शेर की तरियां दा लगाई होई जगहां म्ह बैठ्या रहवै सै।<verse eid="PSA 17:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 17:13" />उठ, हे यहोवा!</para>
  <para style="q" vid="PSA 17:13">उसका सामना कर अर उसनै पटक दे!</para>
  <para style="q" vid="PSA 17:13">अपणी तलवार कै जोर पै मेरी जान बैरी तै बचाले।<verse eid="PSA 17:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 17:14" />अपणा हाथ बढ़ाकै हे यहोवा, मन्‍नै माणसां तै बचा,</para>
  <para style="q" vid="PSA 17:14">यानी संसारिक माणसां तै जिनकी साझेदारी इस्से जीवन म्ह सै,</para>
  <para style="q" vid="PSA 17:14">अर जिनका पेट तू अपणे भण्डार तै भरै सै।</para>
  <para style="q" vid="PSA 17:14">वे बाळ-बच्‍चां तै संतुष्ट सै; अर बाक्‍की सम्पत्ति अपणे बाळकां खात्तर छोड़ जावै सै।<verse eid="PSA 17:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 17:15" />पर मै तो धर्मी होकै तेरा मुँह देक्खुँगा</para>
  <para style="q" vid="PSA 17:15">जिब मै जाग्गूंगा तब तेरे स्वरूप तै संतुष्ट होऊँगा<verse eid="PSA 17:15" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" sid="PSA 18" />
  <para style="s">दाऊद का मुक्तिगीत</para>
  <para style="d">प्रधान बजाण आळे खात्तर। यहोवा के दास दाऊद का गीत, जिसके वचन उसनै यहोवा खात्तर उस बखत गाया जिब यहोवा नै उस ताहीं उसके सारे दुश्मनां कै हाथ तै, अर शाऊल कै हाथ तै बचाया था, उसनै कह्या</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 18:1" />हे यहोवा, हे मेरी ताकत्त, मै तेरे तै प्यार करुँ सूं।<verse eid="PSA 18:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 18:2" />यहोवा मेरी चट्टान, अर मेरा गढ़ अर मेरा छुड़ाण आळा सै;</para>
  <para style="q" vid="PSA 18:2">मेरा परमेसवर, मेरी चट्टान सै, जिसका मै शरणागत सूं,</para>
  <para style="q" vid="PSA 18:2">वो मेरी ढाल, मेरै उद्धार का सींग,</para>
  <para style="q" vid="PSA 18:2">अर मेरा ऊँच्‍चा गढ़ सै।<verse eid="PSA 18:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 18:3" />मै यहोवा नै जो स्तुति कै लायक सै पुकारूँगा;</para>
  <para style="q" vid="PSA 18:3">इस ढाळ मै अपणे दुश्मनां तै बचाया जाऊँगा।<verse eid="PSA 18:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 18:4" />मौत की रस्सियाँ तै मै च्यांरु ओड़ तै घिर ग्या सूं,</para>
  <para style="q" vid="PSA 18:4">अर अधर्म की बाढ़ नै मेरे ताहीं डरा दिया;<verse eid="PSA 18:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 18:5" />अधोलोक की रस्सी मेरै च्यांरु ओड़ थी,</para>
  <para style="q" vid="PSA 18:5">अर मौत के फंदे मेरे पै आये थे।<verse eid="PSA 18:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 18:6" />अपणे संकट म्ह मन्‍नै यहोवा ताहीं पुकारया;</para>
  <para style="q" vid="PSA 18:6">मन्‍नै अपणे परमेसवर की दुहाई दी।</para>
  <para style="q" vid="PSA 18:6">अर उसनै अपणे मन्दर म्ह तै मेरी वाणी सुणी।</para>
  <para style="q" vid="PSA 18:6">अर मेरी दुहाई उसकै धोरै पोहचकै उसके कान्‍नां म्ह पड़ी।<verse eid="PSA 18:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 18:7" />फेर धरती हाल ग्यी, अर काप ग्यी,</para>
  <para style="q" vid="PSA 18:7">अर पहाड़ां की नींव काप कै हाल ग्यी</para>
  <para style="q" vid="PSA 18:7">क्यूँके वो भोत घणा छो म्ह भरग्या था।<verse eid="PSA 18:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 18:8" />उसकै नाक तै धुआँ लिकड़या,</para>
  <para style="q" vid="PSA 18:8">अर उसकै मुँह तै आग लिकड़कै भस्म करण लाग्गी;</para>
  <para style="q" vid="PSA 18:8">जिसतै कोल्‍ले दहक उठे।<verse eid="PSA 18:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 18:9" />वो सुर्ग नै झुका कै नीच्‍चै उतर आया;</para>
  <para style="q" vid="PSA 18:9">अर उसकै पायां तलै घोर अन्धकार था।<verse eid="PSA 18:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 18:10" />अर वो करूब<note caller="+" style="f"><char style="fr" closed="false">18:10 </char><char style="fq" closed="false">करूब </char><char style="ft" closed="false">करूब एक पंखा आळा माणस सै जो यहोवा के सुर्गीय सिंहासन की रक्षा करै सै </char></note> पै सवार होकै उड्या,</para>
  <para style="q" vid="PSA 18:10">बल्कि हवा के पंखां पै सवारी करकै वेग तै उड्या।<verse eid="PSA 18:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 18:11" />उसनै अन्धेरै ताहीं अपणे लुह्कण की जगहां</para>
  <para style="q" vid="PSA 18:11">अर अपणे च्यांरु ओड़ अकास की काळी घटा का मण्डप बणाया।<verse eid="PSA 18:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 18:12" />उसकै आग्गै बिजळी बरगे,</para>
  <para style="q" vid="PSA 18:12">ओळे अर अंगारे भी पड़े।<verse eid="PSA 18:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 18:13" />फेर यहोवा अकास म्ह गरज्या,</para>
  <para style="q" vid="PSA 18:13">अर परमप्रधान नै अपणी वाणी सुणाई, अर ओळे अर अंगारे भेज्जे।<verse eid="PSA 18:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 18:14" />उसनै अपणे तीर चला-चलाकै दुश्मनां ताहीं तित्तर-बितर;</para>
  <para style="q" vid="PSA 18:14">बल्कि बिजळी गेर-गेरकै उन ताहीं हरा दिया।<verse eid="PSA 18:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 18:15" />फेर पाणी के नाळे देखण नै मिले, अर दुनिया की नींव उजागर होई,</para>
  <para style="q" vid="PSA 18:15">यो तो यहोवा तेरी डाँट तै,</para>
  <para style="q" vid="PSA 18:15">अर तेरे नाक की साँस की झोंक तै होया।<verse eid="PSA 18:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 18:16" />उसनै उप्पर तै हाथ बढ़ाकै मेरे ताहीं थाम लिया,</para>
  <para style="q" vid="PSA 18:16">अर गहरे पाणी म्ह तै खींच लिया।<verse eid="PSA 18:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 18:17" />उसनै मेरे ताकतवर दुश्मन तै,</para>
  <para style="q" vid="PSA 18:17">अर उनतै जो मेरे तै नफरत करै थे,</para>
  <para style="q" vid="PSA 18:17">मेरे ताहीं छुड़ाया; क्यूँके वे घणे सामर्थी थे।<verse eid="PSA 18:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 18:18" />मेरी बिप्दा के दिन वे मेरे पै आण पड़े।</para>
  <para style="q" vid="PSA 18:18">पर यहोवा मेरा आसरा था।<verse eid="PSA 18:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 18:19" />अर उसनै मेरे ताहीं लिकाड़कै चौड़ी जगहां म्ह पोहचाया,</para>
  <para style="q" vid="PSA 18:19">उसनै मेरे ताहीं छुड़ाया, क्यूँके वो मेरे तै खुश था।<verse eid="PSA 18:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 18:20" />यहोवा नै मेरे तै मेरी धार्मिकता कै मुताबिक बरताव करया;</para>
  <para style="q" vid="PSA 18:20">अर मेरे हाथ्थां की शुद्धता के मुताबिक उसनै</para>
  <para style="q" vid="PSA 18:20">मेरे ताहीं बदला दिया।<verse eid="PSA 18:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 18:21" />क्यूँके मै यहोवा की राह पै चाल्दा रह्या,</para>
  <para style="q" vid="PSA 18:21">अर दुष्टता कै कारण अपणे परमेसवर तै दूर न्ही होया।<verse eid="PSA 18:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 18:22" />क्यूँके उसके सारे फैसले मेरे स्याम्ही बणे रहे</para>
  <para style="q" vid="PSA 18:22">अर मन्‍नै उसकी विधियाँ ताहीं न्ही छोड्या।<verse eid="PSA 18:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 18:23" />अर मै उसके स्याम्ही सिध्द बण्या रह्या,</para>
  <para style="q" vid="PSA 18:23">अर अधर्म तै अपणे-आपनै बचाए रह्या।<verse eid="PSA 18:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 18:24" />यहोवा नै मेरे तै मेरी धार्मिकता कै मुताबिक बदला दिया,</para>
  <para style="q" vid="PSA 18:24">अर मेरे हाथ्थां की उस शुद्धता के मुताबिक जिसनै वो देक्खै था।<verse eid="PSA 18:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 18:25" />भरोस्सेमंद कै गेल्या तू भरोस्सेमंद दिखावै;</para>
  <para style="q" vid="PSA 18:25">अर खरे माणस कै गेल्या तू अपणे-आपनै खरा दिखावै सै।<verse eid="PSA 18:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 18:26" />शुद्ध कै गेल्या तू अपणे-आपनै शुद्ध दिखावै,</para>
  <para style="q" vid="PSA 18:26">अर टेढ़ां कै गैल तू तिरछा बणै सै।<verse eid="PSA 18:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 18:27" />क्यूँके तू दीन माणसां नै बचावै सै;</para>
  <para style="q" vid="PSA 18:27">पर घमण्ड तै भरी आँखां नै तू निच्‍ची करै सै।<verse eid="PSA 18:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 18:28" />हाँ तू ए मेरै दीवै नै जळावै सै,</para>
  <para style="q" vid="PSA 18:28">मेरा परमेसवर यहोवा मेरे अंधियारे नै</para>
  <para style="q" vid="PSA 18:28">चाँदणा कर देवै सै।<verse eid="PSA 18:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 18:29" />क्यूँके तेरी मदद तै मै सेना पै हमला करुँ सूं,</para>
  <para style="q" vid="PSA 18:29">अर अपणे परमेसवर की मदद तै शहरपनाह नै लाँघ जाऊँ<note caller="+" style="f"><char style="fr" closed="false">18:29 </char><char style="fq" closed="false">शहरपनाह नै लाँघ जाऊँ </char><char style="ft" closed="false">दुश्मनां नै हराकै भीत नै रोंदू सूं</char></note> सूं।<verse eid="PSA 18:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 18:30" />परमेसवर की राह सिध्द सै,</para>
  <para style="q" vid="PSA 18:30">यहोवा का वचन त्याया होया सै,</para>
  <para style="q" vid="PSA 18:30">वो अपणे सारे शरणागतां की ढाल सै।<verse eid="PSA 18:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 18:31" />यहोवा कै अलावा के कोए परमेसवर सै?</para>
  <para style="q" vid="PSA 18:31">म्हारे परमेसवर कै अलावा के और कोए चट्टान सै?<verse eid="PSA 18:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 18:32" />यो वोए परमेसवर सै जो ताकत तै मेरा कटिबन्ध बाँधै सै,</para>
  <para style="q" vid="PSA 18:32">अर मेरी राह नै सिध्द करै सै।<verse eid="PSA 18:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 18:33" />वोए मेरे पायां नै हिरणी के पैरां की तरियां बणावै सै,</para>
  <para style="q" vid="PSA 18:33">अर मेरे ताहीं ऊँच्‍चे स्थानां पै खड्या करै सै।<verse eid="PSA 18:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 18:34" />वो मेरे हाथ्थां नै युद्ध करणा सिखावै सै,</para>
  <para style="q" vid="PSA 18:34">इस करकै मेरी बाजुआं तै पीत्तळ का धनुष झुक जावै सै।<verse eid="PSA 18:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 18:35" />तन्‍नै मेरे ताहीं अपणे बचाव की ढाल दी सै,</para>
  <para style="q" vid="PSA 18:35">तू अपणे सोळे हाथ तै मन्‍नै सम्भाळै सै,</para>
  <para style="q" vid="PSA 18:35">अर तेरी नम्रता नै मेरे ताहीं महान बणाया सै।<verse eid="PSA 18:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 18:36" />तन्‍नै मेरे पायां खात्तर खुल्‍ली जगहां कर दी सै,</para>
  <para style="q" vid="PSA 18:36">ताके मेरे पैर ना फिसळै।<verse eid="PSA 18:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 18:37" />मै अपणे दुश्मनां का पिच्छा करकै उननै पकड़ ल्यूँगा,</para>
  <para style="q" vid="PSA 18:37">अर जिब ताहीं उनका नाश न्ही कर ल्यु जिब तक न्ही बोहडुंगा।<verse eid="PSA 18:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 18:38" />मै उननै इस तरियां बेधूँगा के वे उठ न्ही सकैगें;</para>
  <para style="q" vid="PSA 18:38">वे मेरे पायां के नीच्‍चै गिर जावैंगे।<verse eid="PSA 18:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 18:39" />क्यूँके तन्‍नै युद्ध खात्तर मेरी कमर म्ह</para>
  <para style="q" vid="PSA 18:39">शक्ति का पटुका बाँधया सै,</para>
  <para style="q" vid="PSA 18:39">अर मेरे बिरोधियाँ ताहीं मेरे स्याम्ही नीच्‍चा कर दिया।<verse eid="PSA 18:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 18:40" />तन्‍नै मेरे दुश्मनां की पीठ मेरी ओड़ फेर दी,</para>
  <para style="q" vid="PSA 18:40">ताके मै उननै काट द्यु जो मेरे तै जलन राक्खै सै।<verse eid="PSA 18:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 18:41" />उननै दुहाई तो दी पर उननै बचाण आळा न्ही मिल्या,</para>
  <para style="q" vid="PSA 18:41">उननै यहोवा की भी दुहाई दी,</para>
  <para style="q" vid="PSA 18:41">पर उसनै भी उन ताहीं जवाब न्ही दिया।<verse eid="PSA 18:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 18:42" />फेर मन्‍नै उन ताहीं कूट-कूटकै हवा म्ह उड़ाई</para>
  <para style="q" vid="PSA 18:42">होई धूळ के ढाळ कर दिया;</para>
  <para style="q" vid="PSA 18:42">मन्‍नै उन ताहीं राह के कीचड़ की ढाळ लिकाड़ फेक्या।<verse eid="PSA 18:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 18:43" />तन्‍नै मेरे ताहीं प्रजा के झगड्या तै भी छुड़ाया;</para>
  <para style="q" vid="PSA 18:43">तन्‍नै मेरे ताहीं दुसरी जात्तां का प्रधान बणाया सै;</para>
  <para style="q" vid="PSA 18:43">जिन माणसां नै मै जाणु भी न्ही था वे मेरी</para>
  <para style="q" vid="PSA 18:43">सेवा करै सै।<verse eid="PSA 18:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 18:44" />मेरा नाम सुणदे ए वे मेरे हुकम का पालन करैगें,</para>
  <para style="q" vid="PSA 18:44">परदेशी मेरे बस म्ह हो जावैंगे।<verse eid="PSA 18:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 18:45" />परदेशी मुरझा जावैंगे,</para>
  <para style="q" vid="PSA 18:45">अर अपणे किलां म्ह तै थरथरान्दे होये लिकड़ैंगे।<verse eid="PSA 18:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 18:46" />यहोवा परमेसवर जिन्दा सै; मेरी चट्टान धन्य सै;</para>
  <para style="q" vid="PSA 18:46">अर मेरे मुक्तिदाता परमेसवर की बड़ाई हो।<verse eid="PSA 18:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 18:47" />धन्य सै मेरा बदला लेण आळा परमेसवर!</para>
  <para style="q" vid="PSA 18:47">जिसनै देश-देश के माणसां ताहीं मेरे बस म्ह कर दिया सै;<verse eid="PSA 18:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 18:48" />अर मन्‍नै मेरे दुश्मनां तै छुड़ाया सै;</para>
  <para style="q" vid="PSA 18:48">तू मेरे ताहीं मेरे बिरोधियाँ तै ऊँच्‍चा करै सै,</para>
  <para style="q" vid="PSA 18:48">अर उपद्रवी माणस तै बचावै सै।<verse eid="PSA 18:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 18:49" />इस कारण मै जात्ति-जात्ति कै स्याम्ही तेरा धन्यवाद करुँगा,</para>
  <para style="q" vid="PSA 18:49">अर तेरे नाम का भजन गाऊँगा।<verse eid="PSA 18:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 18:50" />वो अपणे ठहराए होए राजा नै भोत बड़ी जीत देवै सै,</para>
  <para style="q" vid="PSA 18:50">वो अपणे अभिषिक्त दाऊद पै</para>
  <para style="q" vid="PSA 18:50">अर उसके वंश पै युगानुयुग करुणा करदा रहवैगा।<verse eid="PSA 18:50" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" sid="PSA 19" />
  <para style="s">सृष्टि कै जरिये सृष्टिकर्ता की महिमा का जिक्र</para>
  <para style="d">प्रधान बजाण आळे खात्तर दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 19:1" />अकास परमेसवर की महिमा का जिक्र करण लाग रह्या सै;</para>
  <para style="q" vid="PSA 19:1">अर अकासमण्डल उसकी हाथ्थां की कला नै जाहिर करण लाग रह्या सै।<verse eid="PSA 19:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 19:2" />दिन तै दिन बात करै सै,</para>
  <para style="q" vid="PSA 19:2">अर रात नै रात ज्ञान सिखावै सै।<verse eid="PSA 19:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 19:3" />ना तो कोए बोल्‍ली अर ना कोए भाषा,</para>
  <para style="q" vid="PSA 19:3">जड़ै उनकी आवाज सुणाई न्ही देन्दी।<verse eid="PSA 19:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 19:4" />फेर भी उनका स्वर सारी धरती पै गूँजग्या सै,</para>
  <para style="q" vid="PSA 19:4">अर उनके वचन दुनिया की छोर ताहीं पोहचगे सै।</para>
  <para style="q" vid="PSA 19:4">उन म्ह उसनै सूरज खात्तर एक मण्डप खड्या करया सै,<verse eid="PSA 19:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 19:5" />जो बन्दड़े की तरियां अपणे महल तै लिकाड़ै सै।</para>
  <para style="q" vid="PSA 19:5">वो शूरवीर की तरियां अपणी दौड़ दौड़ण तै खुश होवै सै।<verse eid="PSA 19:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 19:6" />वो अकास की एक छोर तै लिकड़ै सै,</para>
  <para style="q" vid="PSA 19:6">अर वो उसकै दुसरे छोर तक चक्‍कर मारै सै;</para>
  <para style="q" vid="PSA 19:6">अर उसकी गर्मी सारया ताहीं पोहचै सै।<verse eid="PSA 19:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 19:7" />यहोवा के नियम खरे सै, वो जी म्ह नई ताजगी देवै सै;</para>
  <para style="q" vid="PSA 19:7">यहोवा के नियम बिश्वास लायक सै,</para>
  <para style="q" vid="PSA 19:7">साधारण माणसां नै बुद्धिमान बणा देवै सै।<verse eid="PSA 19:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 19:8" />यहोवा के उपदेश सिध्द सै; मन नै आनन्दित कर देवै सै;</para>
  <para style="q" vid="PSA 19:8">यहोवा का हुक्म निर्मल सै, वो आँखां म्ह</para>
  <para style="q" vid="PSA 19:8">रोशनी ले आवै सै।<verse eid="PSA 19:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 19:9" />यहोवा का भय मानणा पवित्र सै, वो अन्ततकाल तक टिक्या रहवै सै;</para>
  <para style="q" vid="PSA 19:9">यहोवा के नियम सच्‍चे अर पूरी रीति तै धर्म के सै।<verse eid="PSA 19:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 19:10" />वे तो सोन्‍ने तै अर घणे कुन्दन तै भी बढ़कै मनोहर सै;</para>
  <para style="q" vid="PSA 19:10">वे शहद तै अर टपकण आळे छात्ते तै भी बढ़कै मीठ्ठे सै।<verse eid="PSA 19:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 19:11" />अर उनतै ए तेरा दास समझाया जावै सै;</para>
  <para style="q" vid="PSA 19:11">उनकै मानण तै बड्ड़ा ए प्रतिफळ मिलै सै।<verse eid="PSA 19:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 19:12" />अपणी भूलचूक नै कौण समझ सकै सै?</para>
  <para style="q" vid="PSA 19:12">मेरै गुप्त पापां तै तू मन्‍नै पवित्र कर।<verse eid="PSA 19:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 19:13" />तू अपणे दास नै ढिठाई के पापां तै भी बचाए राख;</para>
  <para style="q" vid="PSA 19:13">वो मेरे पै प्रभुता करण न्ही पावै!</para>
  <para style="q" vid="PSA 19:13">फेर मै निर्दोष हो जाऊँगा, अर बड़े अपराध तै बचा रहूँगा।<verse eid="PSA 19:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 19:14" />हे यहोवा परमेसवर, मेरी चट्टान अर मेरे उद्धार करण आळे,</para>
  <para style="q" vid="PSA 19:14">मेरै मुँह के वचन अर मेरे मन का ध्यान तेरे स्याम्ही अपनाण जोग्गे हों,<verse eid="PSA 19:14" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" sid="PSA 20" />
  <para style="s">जीत खात्तर प्रार्थना</para>
  <para style="d">प्रधान बजाण आळे खात्तर दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 20:1" />मुसीबत कै दिन यहोवा तेरी सुण ले!</para>
  <para style="q" vid="PSA 20:1">याकूब के परमेसवर का नाम तेरे ताहीं</para>
  <para style="q" vid="PSA 20:1">ऊँच्‍चा पद दे!<verse eid="PSA 20:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 20:2" />वो पवित्र जगहां तै तेरी मदद करै,</para>
  <para style="q" vid="PSA 20:2">अर सिय्योन तै तन्‍नै सम्भाळै!<verse eid="PSA 20:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 20:3" />वो तेरी सारी भेटां नै याद करै,</para>
  <para style="q" vid="PSA 20:3">अर तेरे होमबलि नै कबूल करै। (सेला)<verse eid="PSA 20:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 20:4" />वो तेरे मन की इच्छा नै पूरी करै,</para>
  <para style="q" vid="PSA 20:4">अर तेरी सारी योजना नै सफल करै!<verse eid="PSA 20:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 20:5" />फेर हम तेरे उद्धार के कारण ऊँच्‍ची आवाज तै</para>
  <para style="q" vid="PSA 20:5">खुश होकै खावांगें,</para>
  <para style="q" vid="PSA 20:5">अर अपणे परमेसवर के नाम तै झण्डे खड़े करैंगें</para>
  <para style="q" vid="PSA 20:5">यहोवा तेरी सारी बिनती सुणै।<verse eid="PSA 20:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 20:6" />इब मै जाण ग्या के यहोवा अपणे अभिषिक्त नै बचावैगा;</para>
  <para style="q" vid="PSA 20:6">वो अपणे पवित्र सुर्ग तै,</para>
  <para style="q" vid="PSA 20:6">अपणे सोळे हाथ के उद्धार करण आळें सामर्थ्य तै उस ताहीं जवाब देवैगा।<verse eid="PSA 20:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 20:7" />किसे नै रथां का अर किसे नै घोड्या का भरोस्सा सै,</para>
  <para style="q" vid="PSA 20:7">पर हम तो अपणे परमेसवर यहोवा का ए नाम लेवांगें।<verse eid="PSA 20:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 20:8" />वे तो झुक ग्ये अर गिर ग्ये</para>
  <para style="q" vid="PSA 20:8">पर हम उठ्ठे अर सीध्धे खड़े सां।<verse eid="PSA 20:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 20:9" />हे यहोवा, राजा नै छुड़ा<note caller="+" style="f"><char style="fr" closed="false">20:9 </char><char style="fq" closed="false">छुड़ा </char><char style="ft" closed="false">जितवा दे</char></note>,</para>
  <para style="q" vid="PSA 20:9">जिब हम पुकारा तो म्हारी मदद कर।<verse eid="PSA 20:9" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" sid="PSA 21" />
  <para style="s">प्रभु के उद्धार म्ह आनन्द</para>
  <para style="d">प्रधान बजाण आळे खात्तर दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 21:1" />हे यहोवा तेरी सामर्थ्य तै राजा आनन्दित होवैगा;</para>
  <para style="q" vid="PSA 21:1">अर तेरे करे होए उद्धार तै वो घणा मगन होवैगा।<verse eid="PSA 21:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 21:2" />तन्‍नै उसका मनोरथ पूरा करया सै,</para>
  <para style="q" vid="PSA 21:2">अर उसके मुँह तै लिकड़ी बिनती तन्‍नै टाळी कोन्या। (सेला)<verse eid="PSA 21:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 21:3" />क्यूँके तू खास आशीष देंदा होया उसतै मिलै सै</para>
  <para style="q" vid="PSA 21:3">अर तू उसके सिर पै कुन्दन का मुकुट पिराहवै सै।<verse eid="PSA 21:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 21:4" />उसनै तेरे तै जीवन मांग्या, अर तन्‍नै जीवनदान दिया;</para>
  <para style="q" vid="PSA 21:4">तन्‍नै उसतै युगानुयुग का जीवन दिया सै।<verse eid="PSA 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 21:5" />तेरे उद्धार के कारण उसकी महिमा घणी सै;</para>
  <para style="q" vid="PSA 21:5">तू उसनै ठाट-बाट अर ऐश्‍वर्य तै भर दे सै।<verse eid="PSA 21:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 21:6" />क्यूँके तन्‍नै उस ताहीं सदा खात्तर आशीर्वाद दिया सै;</para>
  <para style="q" vid="PSA 21:6">तू अपणे स्याम्ही उसनै हर्ष अर आनन्द तै भर देवै सै।<verse eid="PSA 21:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 21:7" />क्यूँके राजा का भरोस्सा यहोवा कै उप्पर सै;</para>
  <para style="q" vid="PSA 21:7">अर परमप्रधान की करुणा तै वो कदे कोन्या टळै।<verse eid="PSA 21:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 21:8" />तेरा हाथ तेरे सारे दुश्मनां नै ढूँढ़ लेवैगा;</para>
  <para style="q" vid="PSA 21:8">तेरा सोळा हाथ तेरे सारे बैरियाँ का पता लगा लेवैगा।<verse eid="PSA 21:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 21:9" />तू अपणे मुँह कै स्याम्ही उननै जळदे होए भट्ठे</para>
  <para style="q" vid="PSA 21:9">की तरियां जळावैगा।</para>
  <para style="q" vid="PSA 21:9">यहोवा अपणे छो म्ह उननै निगळ जावैगा,</para>
  <para style="q" vid="PSA 21:9">अर आग उननै भस्म कर देवैगी।<verse eid="PSA 21:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 21:10" />तू उनके फळां नै धरती पै तै,</para>
  <para style="q" vid="PSA 21:10">अर उनके वंश नै माणसां म्ह तै नाश करैगा।<verse eid="PSA 21:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 21:11" />क्यूँके उननै तेरे नुकसान की ठाणी सै,</para>
  <para style="q" vid="PSA 21:11">उननै इसी योजना लिकाड़ी सै जिसनै वे</para>
  <para style="q" vid="PSA 21:11">पूरी न्ही कर सकैगें।<verse eid="PSA 21:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 21:12" />क्यूँके तू अपणा धनुष उनके बिरुध्द चढ़ावैगा,</para>
  <para style="q" vid="PSA 21:12">अर वे पीठ दिखाकै भाजैंगे।<verse eid="PSA 21:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 21:13" />हे यहोवा, अपणी सामर्थ्य म्ह महान हो!</para>
  <para style="q" vid="PSA 21:13">अर हम गा-गाकै तेरे पराक्रम का भजन सुणावांगें।<verse eid="PSA 21:13" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" sid="PSA 22" />
  <para style="s">मन की पुकार अर स्तुतिगान</para>
  <para style="d">प्रधान बजाण आळे खात्तर अभ्येलेरशर राग म्ह दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 22:1" />हे मेरे परमेसवर, हे मेरे परमेसवर,</para>
  <para style="q" vid="PSA 22:1">तन्‍नै मेरे ताहीं क्यूँ छोड़ दिया?</para>
  <para style="q" vid="PSA 22:1">तू मेरी बुलाहट तै अर मेरी मदद करण तै</para>
  <para style="q" vid="PSA 22:1">क्यूँ दूर रहवै सै? मेरा उद्धार कित्त सै?<verse eid="PSA 22:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 22:2" />हे मेरे परमेसवर, मै दिन म्ह पुकारूँ सूं</para>
  <para style="q" vid="PSA 22:2">पर तू जवाब न्ही देंदा;</para>
  <para style="q" vid="PSA 22:2">अर रात नै भी मै चुप न्ही रहन्दा।<verse eid="PSA 22:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 22:3" />पर तू जो इस्राएल की बड़ाई कै सिंहासन पै विराजमान सै,</para>
  <para style="q" vid="PSA 22:3">तू तो पवित्र सै।<verse eid="PSA 22:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 22:4" />म्हारे पूर्वज तेरे पै भरोस्सा राक्खै थे,</para>
  <para style="q" vid="PSA 22:4">वे भरोस्सा राक्खै थे,</para>
  <para style="q" vid="PSA 22:4">अर तू उननै छुड़ावै था।<verse eid="PSA 22:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 22:5" />उननै तेरी दुहाई दी अर तन्‍नै वे छुड़ाये</para>
  <para style="q" vid="PSA 22:5">वे तेरे पै भरोस्सा राक्खै थे</para>
  <para style="q" vid="PSA 22:5">अर कदे शर्मिन्दा कोन्या होए।<verse eid="PSA 22:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 22:6" />पर मै कीड़ा सूं, माणस कोन्या;</para>
  <para style="q" vid="PSA 22:6">माणसां म्ह मेरी बदनामी सै,</para>
  <para style="q" vid="PSA 22:6">अर लोग्गां म्ह मेरा अपमान होवै सै।<verse eid="PSA 22:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 22:7" />वो सारे जो मन्‍नै देक्खै सै मेरा मजाक बणावै सै,</para>
  <para style="q" vid="PSA 22:7">अर होठ बिचकाते</para>
  <para style="q" vid="PSA 22:7">अर या कहन्दे होए सिर हिलावै सै,<verse eid="PSA 22:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 22:8" />वे कहवै सै, “वो यहोवा पै भरोस्सा राक्खै सै,</para>
  <para style="q" vid="PSA 22:8">यहोवा उसनै छुड़ावै,</para>
  <para style="q" vid="PSA 22:8">वो उसनै उभारै क्यूँके वो उसतै राज्जी सै।”<verse eid="PSA 22:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 22:9" />पर तन्‍नै ए मै गर्भ तै लिकाड्या;</para>
  <para style="q" vid="PSA 22:9">जिब मै दूध-पीत्ता बाळक था,</para>
  <para style="q" vid="PSA 22:9">जब तै तन्‍नै मेरे ताहीं भरोस्सा राखणा सिखाया।<verse eid="PSA 22:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 22:10" />मै जन्म तै ए तेरे पै छोड़ दिया गया,</para>
  <para style="q" vid="PSA 22:10">माँ के कोख तै ए तू मेरा परमेसवर सै।<verse eid="PSA 22:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 22:11" />मेरे तै दूर ना हो क्यूँके संकट धोरै सै,</para>
  <para style="q" vid="PSA 22:11">अर कोए मददगार कोन्या।<verse eid="PSA 22:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 22:12" />घणे सारे सांड्डां नै मेरे ताहीं घेर लिया सै,</para>
  <para style="q" vid="PSA 22:12">बाशान के तगड़े सांड मन्‍नै च्यांरु ओड़ तै घेरे खड़े सै।<verse eid="PSA 22:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 22:13" />वे पाड़ण आळे अर गरजण आळे शेर की तरियां</para>
  <para style="q" vid="PSA 22:13">मेरे पै अपणा मुँह पाड़े खड़े सै।<verse eid="PSA 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 22:14" />मै पाणी की तरियां बह ग्या,</para>
  <para style="q" vid="PSA 22:14">अर मेरी सारी हाड्डियाँ के जोड़ उखड़गे,</para>
  <para style="q" vid="PSA 22:14">मेरा दिल मोम होग्या,</para>
  <para style="q" vid="PSA 22:14">वो मेरी देह कै भित्तर पिंघळ ग्या।<verse eid="PSA 22:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 22:15" />मेरी ताकत<note caller="+" style="f"><char style="fr" closed="false">22:15 </char><char style="fq" closed="false">ताकत-</char><char style="ft" closed="false">मेरा गळा सुख ग्या सै </char></note> खतम होगी, मै ठीकरा होग्या;</para>
  <para style="q" vid="PSA 22:15">अर मेरी जीभ मेरे ताळवै तै चिपगी;</para>
  <para style="q" vid="PSA 22:15">अर तू मन्‍नै मार के माट्टी म्ह मिला देवै सै।<verse eid="PSA 22:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 22:16" />क्यूँके कुत्याँ नै मै घेर लिया सूं:</para>
  <para style="q" vid="PSA 22:16">कुकर्मिया की मण्डळी मेरे च्यांरु ओड़ तै मन्‍नै घेरे खड़ी सै;</para>
  <para style="q" vid="PSA 22:16">वो मेरे हाथ अर मेरे पायां नै छेदै सै।<verse eid="PSA 22:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 22:17" />मै मेरी सारी हाड्डी गिण सकूँ सूं;</para>
  <para style="q" vid="PSA 22:17">वे मन्‍नै देक्खै अर घूरै सै;<verse eid="PSA 22:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 22:18" />मेरे लत्ते आप्पस म्ह बाट ले सै,</para>
  <para style="q" vid="PSA 22:18">अर मेरे पिराहवै पै पर्ची लिकाड़ै सै।<verse eid="PSA 22:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 22:19" />पर हे यहोवा तू मेरे तै दूर ना रहै!</para>
  <para style="q" vid="PSA 22:19">हे मेरे मददगार, मेरी मदद खात्तर फुर्ती कर!<verse eid="PSA 22:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 22:20" />मेरे प्राण नै तलवार तै बचा,</para>
  <para style="q" vid="PSA 22:20">मेरी जान नै कुत्याँ के पंजां तै बचाले!<verse eid="PSA 22:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 22:21" />मन्‍नै शेर के मुँह तै बचा,</para>
  <para style="q" vid="PSA 22:21">मै जो सताया होया सूं, जंगळी सांड के सीन्गां तै तू मन्‍नै बचा।<verse eid="PSA 22:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 22:22" />मै अपणे भाईयाँ के स्याम्ही तेरा प्रचार करुँगा,</para>
  <para style="q" vid="PSA 22:22">सभा कै बीच तेरी बड़ाई करुँगा।<verse eid="PSA 22:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 22:23" />हे यहोवा के भय मानण आळेयो, उसकी बड़ाई करो!</para>
  <para style="q" vid="PSA 22:23">हे याकूब के वंश, थम सारे उसकी महिमा करो,</para>
  <para style="q" vid="PSA 22:23">हे इस्राएल के वंश, थम उसका भय मान्‍नो!<verse eid="PSA 22:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 22:24" />क्यूँके उसनै दुखियाँ ताहीं तुच्छ न्ही जाण्या,</para>
  <para style="q" vid="PSA 22:24">अर ना उनतै घृणा करै सै,</para>
  <para style="q" vid="PSA 22:24">यहोवा नै उसतै अपणा मुँह कोन्या ल्हकोया,</para>
  <para style="q" vid="PSA 22:24">पर जिब उसनै उसकी दुहाई दी, फेर उसकी सुणली।<verse eid="PSA 22:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 22:25" />बड़ी सभा म्ह मेरा तेरी बड़ाई करणा तेरी ए ओड़ तै हो सै;</para>
  <para style="q" vid="PSA 22:25">मै अपणी मन्‍नतां नै जो उसका भय मान्‍नै सै उनकै स्याम्ही पूरा करुँगा।<verse eid="PSA 22:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 22:26" />नम्र लोग रोट्टी खाकै सन्‍तुष्‍ट होवैंगे;</para>
  <para style="q" vid="PSA 22:26">जो यहोवा नै टोह्ण आळे सै, वे उसकी बड़ाई करैंगे।</para>
  <para style="q" vid="PSA 22:26">उनके<note caller="+" style="f"><char style="fr" closed="false">22:26 </char><char style="fq" closed="false">उनके </char><char style="ft" closed="false">थारे</char></note> मन सदा जिन्दा रहवै!<verse eid="PSA 22:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 22:27" />धरती के सारे दूर-दूर के देशां के माणस उसनै याद करैंगे</para>
  <para style="q" vid="PSA 22:27">अर उसकी ओड़ बोहड़ैंगे;</para>
  <para style="q" vid="PSA 22:27">अर जात्ति-जात्ति के सारे कुल तेरे स्याम्ही सिर झुकावैंगे।<verse eid="PSA 22:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 22:28" />क्यूँके राज्य यहोवा का ए सै,</para>
  <para style="q" vid="PSA 22:28">अर सब जात्तां पै वोए राज करै सै।<verse eid="PSA 22:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 22:29" />धरती के सारे घमण्डी<note caller="+" style="f"><char style="fr" closed="false">22:29 </char><char style="fq" closed="false">घमण्डी</char><char style="ft" closed="false">धनवान लोग</char></note> माणस भोज<note caller="+" style="f"><char style="fr" closed="false">22:29 </char><char style="fq" closed="false">भोज </char><char style="ft" closed="false">जिमणवारा, दावत</char></note> खाकै सिर झुकावैंगे;</para>
  <para style="q" vid="PSA 22:29">वे सारे जितने माट्टी म्ह मिल जावै सै</para>
  <para style="q" vid="PSA 22:29">अर अपणी जान न्ही बचा सकदे,</para>
  <para style="q" vid="PSA 22:29">वे सारे उस्से कै स्याम्ही घुटने टेक्‍कैंगे।<verse eid="PSA 22:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 22:30" />एक वंश उसकी सेवा करैगा;</para>
  <para style="q" vid="PSA 22:30">दुसरी पीढ़ी तै प्रभु का जिक्र करया जावैगा।<verse eid="PSA 22:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 22:31" />वे आवैंगे अर उसके धार्मिकता के काम्मां नै एक</para>
  <para style="q" vid="PSA 22:31">वंश पै जो पैदा होवैगा, या कहकै जाहिर</para>
  <para style="q" vid="PSA 22:31">करैंगे के उसनै इसे-इसे अदभुत काम करे।<verse eid="PSA 22:31" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" sid="PSA 23" />
  <para style="s">परमेसवर अपणे माणसां का पाळी</para>
  <para style="d">दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 23:1" />यहोवा मेरा पाळी सै,</para>
  <para style="q" vid="PSA 23:1">मन्‍नै किमे घटी ना होवैगी।<verse eid="PSA 23:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 23:2" />वो मन्‍नै हरी-हरी चराईयाँ म्ह बिठावै सै;</para>
  <para style="q" vid="PSA 23:2">वो मन्‍नै सुखदाई पाणी के झरण्यां कै धोरै ले चाल्‍लै सै;<verse eid="PSA 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 23:3" />वो मेरे जी म्ह जी ले आवै सै।</para>
  <para style="q" vid="PSA 23:3">धर्म की राह म्ह वो अपणे नाम कै खात्तर</para>
  <para style="q" vid="PSA 23:3">मेरी अगुवाई करै सै।<verse eid="PSA 23:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 23:4" />चाहे म्ह घोर अन्धकार तै भरी होई तराई म्ह होकै चाल्‍लूँ,</para>
  <para style="q" vid="PSA 23:4">तोभी नुकसान तै न्ही डरुँगा,</para>
  <para style="q" vid="PSA 23:4">क्यूँके तू मेरै गैल रहवै सै;</para>
  <para style="q" vid="PSA 23:4">तेरी छड़ी अर लाठ्ठी तै मन्‍नै शान्ति मिलै सै।<verse eid="PSA 23:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 23:5" />तू मेरे सताण आळयां कै स्याम्ही मेरे खात्तर मेज बिछावै सै;</para>
  <para style="q" vid="PSA 23:5">तू मेरे सिर पै तेल तै अभिषेक करै सै,</para>
  <para style="q" vid="PSA 23:5">मेरा कटोरा उमड़ण लाग रह्या सै<note caller="+" style="f"><char style="fr" closed="false">23:5 </char><char style="fq" closed="false">उमड़ण लाग रह्या सै </char><char style="ft" closed="false">लूका 7:46</char></note>।<verse eid="PSA 23:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 23:6" />पक्‍का भलाई अर करुणा जीवन भर मेरे</para>
  <para style="q" vid="PSA 23:6">गैल-गैल बणी रहवैगी;</para>
  <para style="q" vid="PSA 23:6">अर मै यहोवा के धाम म्ह सदा वास करुँगा।<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" sid="PSA 24" />
  <para style="s">महिमामय राजा अर उसका राज</para>
  <para style="d">दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 24:1" />धरती अर जो किमे उस म्ह सै यहोवा का ए सै;</para>
  <para style="q" vid="PSA 24:1">दुनिया अर उस म्ह रहण आळे भी।<verse eid="PSA 24:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 24:2" />क्यूँके उस्से नै उसकी नींव समुन्दरां कै उप्पर मजबूत करकै धरी,</para>
  <para style="q" vid="PSA 24:2">अर बड़ी-बड़ी नदियाँ कै उप्पर स्थिर करया सै।<verse eid="PSA 24:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 24:3" />यहोवा के पर्वत<note caller="+" style="f"><char style="fr" closed="false">24:3 </char><char style="fq" closed="false">यहोवा के पर्वत </char><char style="ft" closed="false">सिय्योन पर्वत जित्त बाद मै मन्दर बणाया गया था</char></note> पै कौण चढ़ सकै सै?</para>
  <para style="q" vid="PSA 24:3">अर उसकी पवित्र जगहां म्ह कौण बड़ सकै सै?<note caller="+" style="f"><char style="fr" closed="false">24:3 </char><char style="fq" closed="false">बड़ सकै सै? </char><char style="ft" closed="false">खड्या हो सकै सै</char></note><verse eid="PSA 24:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 24:4" />जिसके काम निर्दोष अर मन साफ सै,</para>
  <para style="q" vid="PSA 24:4">जिसनै अपणे मन ताहीं बेकार की बात्तां की ओड़ न्ही लगाया,</para>
  <para style="q" vid="PSA 24:4">अर ना कपट तै कसम खाई।<verse eid="PSA 24:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 24:5" />वो यहोवा की ओड़ तै आशीष पावैगा,</para>
  <para style="q" vid="PSA 24:5">अर अपणे उद्धार करण आळे परमेसवर की</para>
  <para style="q" vid="PSA 24:5">ओड़ तै धर्मी ठहरैगा।<verse eid="PSA 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 24:6" />इसेए माणस उसके खोजी सै,</para>
  <para style="q" vid="PSA 24:6">याकूब के परमेसवर तेरे दर्शन के टोह्ण आळे याकूबवंशी सै<note caller="+" style="f"><char style="fr" closed="false">24:6 </char><char style="fq" closed="false">याकूब के परमेसवर तेरे दर्शन के टोह्ण आळे याकूबवंशी सै </char><char style="ft" closed="false">हे याकूब के परमेसवर तन्‍नै टोहवैं सै</char></note>। (सेला)<verse eid="PSA 24:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 24:7" />हे फाटकों, अपणे सिर ऊँच्‍चे करो,</para>
  <para style="q" vid="PSA 24:7">हे सनातन के दरबाज्यों, ऊँच्‍चे हो जाओ।</para>
  <para style="q" vid="PSA 24:7">क्यूँके प्रतापी राजा आण आळा सै।<verse eid="PSA 24:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 24:8" />वो प्रतापी राजा कौण सै,</para>
  <para style="q" vid="PSA 24:8">यहोवा जो ताकतवर अर पराक्रमी सै,</para>
  <para style="q" vid="PSA 24:8">परमेसवर जो युद्ध म्ह पराक्रमी सै!<verse eid="PSA 24:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 24:9" />हे फाटकों, अपणे सिर ऊँच्‍चे करो</para>
  <para style="q" vid="PSA 24:9">हे सनातन के दरबाज्यों थम भी खुल जाओ!</para>
  <para style="q" vid="PSA 24:9">क्यूँके प्रतापी राजा आवैगा!<verse eid="PSA 24:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 24:10" />वो प्रतापी राजा कौण सै?</para>
  <para style="q" vid="PSA 24:10">सेनाओं का यहोवा, वोए प्रतापी राजा सै। (सेला)<verse eid="PSA 24:10" /></para>
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" sid="PSA 25" />
  <para style="s">प्रभु कै सहारै</para>
  <para style="d">दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 25:1" />हे यहोवा, मै अपणे मन नै तेरी ओड़</para>
  <para style="q" vid="PSA 25:1">लगाऊ सूं।<verse eid="PSA 25:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 25:2" />हे मेरे परमेसवर, मन्‍नै तेरे पैए भरोस्सा राख्या सै,</para>
  <para style="q" vid="PSA 25:2">मन्‍नै शर्मिन्दा होण ना दे;</para>
  <para style="q" vid="PSA 25:2">मेरे दुश्मन मेरे पै जयजयकार ना करण पावै।<verse eid="PSA 25:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 25:3" />बल्के जितने तेरी बाट देक्खै सै उन म्ह तै कोए</para>
  <para style="q" vid="PSA 25:3">शर्मिन्दा ना हो;</para>
  <para style="q" vid="PSA 25:3">पर जो बेवजह धोक्खा करै सै वोए</para>
  <para style="q" vid="PSA 25:3">शर्मिन्दा हो।<verse eid="PSA 25:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 25:4" />हे यहोवा, अपणी राह मन्‍नै दिखा;</para>
  <para style="q" vid="PSA 25:4">अपणे पथ पै चालणा मन्‍नै सिखा दे।<verse eid="PSA 25:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 25:5" />मन्‍नै अपणे सच पै चला अर शिक्षा दे,</para>
  <para style="q" vid="PSA 25:5">क्यूँके तू मेरा उद्धार करण आळा परमेसवर सै,</para>
  <para style="q" vid="PSA 25:5">मै दिन भर तेरी बाट देख्दा रहूँ सूं।<verse eid="PSA 25:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 25:6" />हे यहोवा, अपणी दया अर करुणा के काम्मां नै याद कर;</para>
  <para style="q" vid="PSA 25:6">क्यूँके वे तो सदा तै ए होन्दे आए सै।<verse eid="PSA 25:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 25:7" />हे यहोवा, अपणी भलाई के कारण</para>
  <para style="q" vid="PSA 25:7">मेरी जवान्‍नी के पापां नै अर मेरी गलतियाँ नै याद ना करै;</para>
  <para style="q" vid="PSA 25:7">अपणी करुणा कै मुताबिक तू मन्‍नै याद कर।<verse eid="PSA 25:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 25:8" />यहोवा भला अर सीध्धा सै;</para>
  <para style="q" vid="PSA 25:8">इस करकै वो पापियाँ नै अपणी राह दिखावैगा।<verse eid="PSA 25:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 25:9" />वो नम्र माणसां नै न्याय की शिक्षा देवैगा,</para>
  <para style="q" vid="PSA 25:9">हाँ, वो नम्र माणसां नै अपणी राह दिखावैगा।<verse eid="PSA 25:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 25:10" />जो यहोवा के करार अर चेतावनियाँ नै मान्‍नै सै,</para>
  <para style="q" vid="PSA 25:10">उनकै खात्तर उसके सारे राह दया अर सच्‍चाई सै।<verse eid="PSA 25:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 25:11" />हे यहोवा, अपणे नाम कै खात्तर</para>
  <para style="q" vid="PSA 25:11">मेरे अधर्म नै जो भोत घणे सै माफ कर।<verse eid="PSA 25:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 25:12" />वो कौण सै जो यहोवा का भय मान्‍नै सै?</para>
  <para style="q" vid="PSA 25:12">प्रभु उसनै उस्से राह पै चलावैगा जिसतै वो</para>
  <para style="q" vid="PSA 25:12">राज्जी हो सै।<verse eid="PSA 25:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 25:13" />वो सही-सलामत टिक्या रहवैगा,</para>
  <para style="q" vid="PSA 25:13">अर उसका वंश धरती का अधिकारी होवैगा।<verse eid="PSA 25:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 25:14" />यहोवा के भेद नै वोए जाणै सै जो उसतै डरै सै,</para>
  <para style="q" vid="PSA 25:14">अर वो अपणा करार उनपै जाहिर करैगा।<verse eid="PSA 25:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 25:15" />मेरी आँख हमेशा यहोवा पै टकटकी लगाऐ रहवै सै,</para>
  <para style="q" vid="PSA 25:15">क्यूँके वोए मेरे पैरां नै जाळ म्ह तै छुड़ावैगा।<verse eid="PSA 25:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 25:16" />हे यहोवा, मेरी ओड़ बोहड़कै मेरे पै दया कर;</para>
  <para style="q" vid="PSA 25:16">क्यूँके मै एक्ला अर पीड़ित सूं।<verse eid="PSA 25:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 25:17" />मेरे मन की दुविधा बढ़गी सै,</para>
  <para style="q" vid="PSA 25:17">तू मन्‍नै मेरे दुखां तै छुड़ाले।<verse eid="PSA 25:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 25:18" />तू मेरे दुख अर कष्टां नै देख,</para>
  <para style="q" vid="PSA 25:18">अर मेरे सारे पापां नै माफ कर।<verse eid="PSA 25:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 25:19" />देख मेरे दुश्मनां नै देख के वे किस तरियां बढ़गे सै,</para>
  <para style="q" vid="PSA 25:19">अर मेरे तै घणा बैर राक्खै सै।<verse eid="PSA 25:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 25:20" />मेरे प्राण की हिफाजत कर, अर मन्‍नै छुड़ा;</para>
  <para style="q" vid="PSA 25:20">मन्‍नै शर्मिन्दा ना होण दे,</para>
  <para style="q" vid="PSA 25:20">क्यूँके मै तेरी शरण म्ह सूं।<verse eid="PSA 25:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 25:21" />खराई अर सिधाई मेरी हिफाजत करै,</para>
  <para style="q" vid="PSA 25:21">क्यूँके मन्‍नै तेरे पैए आस सै।<verse eid="PSA 25:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 25:22" />हे परमेसवर इस्राएल नै उसके सारे संकटां तै छुड़ाले।<verse eid="PSA 25:22" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" sid="PSA 26" />
  <para style="s">एक खरे माणस की प्रार्थना</para>
  <para style="d">दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 26:1" />हे यहोवा मेरा न्याय कर,</para>
  <para style="q" vid="PSA 26:1">क्यूँके मै खराई तै चाल्दा रह्या सूं,</para>
  <para style="q" vid="PSA 26:1">अर मेरा भरोस्सा यहोवा पै अटल बण्या सै।<verse eid="PSA 26:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 26:2" />हे यहोवा, मन्‍नै जाँच अर परख;</para>
  <para style="q" vid="PSA 26:2">मेरे मन अर दिल नै परख।<verse eid="PSA 26:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 26:3" />क्यूँके तेरी करुणा तो मेरी आँखां कै स्याम्ही सै,</para>
  <para style="q" vid="PSA 26:3">अर मै तेरे सच की राह पै चाल्दा रह्या सूं।<verse eid="PSA 26:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 26:4" />मै निकम्मी चाल-चाल्‍लण आळयां कै गैल न्ही बैठ्या,</para>
  <para style="q" vid="PSA 26:4">अर ना मै कपटियाँ कै गैल किते जाऊँगा;<verse eid="PSA 26:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 26:5" />मै कुकर्मिया की संगति तै घृणा राक्खूँ सूं,</para>
  <para style="q" vid="PSA 26:5">अर दुष्टां कै गैल न्ही बैठूँगा।<verse eid="PSA 26:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 26:6" />मै अपणे हाथ्थां नै निर्दोषता के पाणी तै धोऊँगा,</para>
  <para style="q" vid="PSA 26:6">हे यहोवा, फेर मै तेरी वेदी के चक्‍कर लगाऊँगा,<verse eid="PSA 26:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 26:7" />ताके तेरा धन्यवाद ऊँच्‍ची आवाज तै करुँ,</para>
  <para style="q" vid="PSA 26:7">अर तेरे सारे अचम्भे काम्मां का जिक्र करुँ।<verse eid="PSA 26:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 26:8" />हे यहोवा, मै तेरे धाम तै</para>
  <para style="q" vid="PSA 26:8">तेरी महिमा के रहण आळी जगहां तै प्रीति राक्खूँ सूं।<verse eid="PSA 26:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 26:9" />मेरे प्राण नै पापियाँ कै गैल,</para>
  <para style="q" vid="PSA 26:9">अर मेरे जीवन नै हत्यारां कै गैल ना मिला।<verse eid="PSA 26:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 26:10" />वे तो ओच्छेपण करण म्ह लाग्गे रहवै सै,</para>
  <para style="q" vid="PSA 26:10">अर उनका सोळा हाथ रिसवत तै भरया रहवै सै।<verse eid="PSA 26:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 26:11" />पर मै तो खराई तै चाल्दा रहूँगा।</para>
  <para style="q" vid="PSA 26:11">तू मन्‍नै छुड़ाले, अर मेरे पै अनुग्रह कर।<verse eid="PSA 26:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 26:12" />मेरे पैर चौरस जगहां म्ह टिके सै;</para>
  <para style="q" vid="PSA 26:12">हर सभा म्ह मै यहोवा नै धन्य कह्या करुँगा।<verse eid="PSA 26:12" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" sid="PSA 27" />
  <para style="s">बिश्वास की घोषणा</para>
  <para style="d">दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 27:1" />यहोवा मेरी ज्योति अर मेरा उद्धार सै;</para>
  <para style="q" vid="PSA 27:1">मै किसतै डरुँ?</para>
  <para style="q" vid="PSA 27:1">यहोवा मेरे जीवन का मजबूत गढ़ ठहरया सै,</para>
  <para style="q" vid="PSA 27:1">मै किसका भय खाऊँ?<verse eid="PSA 27:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 27:2" />जिब कुकर्मिया नै जो मन्‍नै सतावै अर मेरे तै ए</para>
  <para style="q" vid="PSA 27:2">बैर राक्खै थे,</para>
  <para style="q" vid="PSA 27:2">मन्‍नै मिटाण खात्तर मेरे पै चढ़ाई करी,</para>
  <para style="q" vid="PSA 27:2">फेर वेए ठोक्‍कर खाकै गिर पड़े।<verse eid="PSA 27:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 27:3" />चाहे सेना भी मेरै बिरुध्द धावा बोल्‍लै,</para>
  <para style="q" vid="PSA 27:3">तोभी मै न्ही डरुँगा; चाहे मेरै बिरुध्द लड़ाई छिड़ जावै,</para>
  <para style="q" vid="PSA 27:3">उस हालत म्ह भी मै हिम्मत बाँधे बेफिकर रहूँगा।<verse eid="PSA 27:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 27:4" />एक वर मन्‍नै यहोवा तै मांग्या सै,</para>
  <para style="q" vid="PSA 27:4">उस्से कै यत्न म्ह लाग्या रहूँगा;</para>
  <para style="q" vid="PSA 27:4">ताके मै जीवन भर यहोवा के भवन म्ह रहण पाऊँ,</para>
  <para style="q" vid="PSA 27:4">जिसतै के यहोवा की मनहोरता पै निगांह लगाऐ रहूँ,</para>
  <para style="q" vid="PSA 27:4">अर उसके मन्दर म्ह ध्यान करया करुँ।<verse eid="PSA 27:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 27:5" />क्यूँके वो तो मन्‍नै संकट के दिन म्ह अपणे</para>
  <para style="q" vid="PSA 27:5">मण्डप म्ह ल्हकोए राक्खैगा;</para>
  <para style="q" vid="PSA 27:5">अपणे तम्बू कै गुप्त स्‍थान म्ह वो मन्‍नै लह्को लेगा,</para>
  <para style="q" vid="PSA 27:5">अर चट्टान पै चढ़ावैगा।<verse eid="PSA 27:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 27:6" />इब मेरा सिर मेरे च्यांरु ओड़ के दुश्मनां तै ऊँच्‍चा होवैगा;</para>
  <para style="q" vid="PSA 27:6">अर मै यहोवा के तम्बू म्ह आनन्द के बलिदान चढ़ाऊँगा;</para>
  <para style="q" vid="PSA 27:6">अर मै गाऊँगा, अर यहोवा कै खात्तर भजन गाऊँगा।<verse eid="PSA 27:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 27:7" />हे यहोवा मेरी आवाज सुण, मै पुकारूँ सूं,</para>
  <para style="q" vid="PSA 27:7">तू मेरे पै दया कर अर मन्‍नै जवाब दे।<verse eid="PSA 27:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 27:8" />तन्‍नै कह्या सै, “मेरे दर्शन के खोजी हो।”</para>
  <para style="q" vid="PSA 27:8">इस करकै मेरा मन तेरे तै कहवै सै,</para>
  <para style="q" vid="PSA 27:8">“हे यहोवा, तेरे दर्शन का खोजी रहूँगा।”<verse eid="PSA 27:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 27:9" />अपणा मुँह मेरे तै ना ल्हकोवै।</para>
  <para style="q" vid="PSA 27:9">अपणे दास नै छो म्ह आकै ना हटा,</para>
  <para style="q" vid="PSA 27:9">तू मेरा मददगार बण्या सै।</para>
  <para style="q" vid="PSA 27:9">हे मेरे उद्धार करण आळे परमेसवर मन्‍नै त्यागै ना, अर मन्‍नै छोड़ै ना!<verse eid="PSA 27:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 27:10" />मेरे माँ-बाप नै तो मेरे ताहीं छोड़ दिया सै,</para>
  <para style="q" vid="PSA 27:10">पर यहोवा मन्‍नै सम्भाळ लेवैगा।<verse eid="PSA 27:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 27:11" />हे यहोवा, अपणी राह म्ह मेरी अगुवाई कर,</para>
  <para style="q" vid="PSA 27:11">अर मेरे बैरियाँ कै कारण मन्‍नै चौरस राह पै ले चाल।<verse eid="PSA 27:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 27:12" />मन्‍नै मेरे सताण आळयां की इच्छा के मुताबिक ना सौप्पैं,</para>
  <para style="q" vid="PSA 27:12">क्यूँके झूठ्ठे गवाह जो उपद्रव करण की धुन</para>
  <para style="q" vid="PSA 27:12">म्ह सै मेरे बिरुध्द उठ्ठे सै।<verse eid="PSA 27:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 27:13" />जै मन्‍नै बिश्वास न्ही होंदा के जिन्दयां की</para>
  <para style="q" vid="PSA 27:13">धरती पै यहोवा की भलाई नै देक्खुँगा<note caller="+" style="f"><char style="fr" closed="false">27:13 </char><char style="fq" closed="false">जै मन्‍नै बिश्वास न्ही होंदा के जिन्दयां की धरती पै यहोवा की भलाई नै देक्खुँगा </char><char style="ft" closed="false">मन्‍नै इब ताहीं बिश्वास सै के जिन्दयां की धरती पै यहोवा की भलाई नै देक्खुँगा,</char></note>,</para>
  <para style="q" vid="PSA 27:13">तो मै बेसुध हो जान्दा।<verse eid="PSA 27:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 27:14" />यहोवा की बाट देख्दा रह;</para>
  <para style="q" vid="PSA 27:14">हिम्मत बाँध अर तेरा मन मजबूत रहवै;</para>
  <para style="q" vid="PSA 27:14">हाँ, यहोवा ए की बाट देख्दा रह!<verse eid="PSA 27:14" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" sid="PSA 28" />
  <para style="s">बिनती अर धन्यवाद</para>
  <para style="d">दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 28:1" />हे यहोवा, मै तन्‍नै ए पुकारूँगा;</para>
  <para style="q" vid="PSA 28:1">हे मेरी चट्टान, मेरी पुकार नै अनसुणी ना करै,</para>
  <para style="q" vid="PSA 28:1">इसा ना हो के तेरे चुप रहण तै</para>
  <para style="q" vid="PSA 28:1">मै कब्र म्ह पड़े होयां की तरियां हो जाऊँ जो पताळ म्ह चले जावै सै।<verse eid="PSA 28:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 28:2" />जिब मै तेरी दुहाई देऊँ<note caller="+" style="f"><char style="fr" closed="false">28:2 </char><char style="fq" closed="false">तेरी दुहाई देऊँ </char><char style="ft" closed="false">मदद की ताहीं </char></note>,</para>
  <para style="q" vid="PSA 28:2">अर तेरे पवित्र स्‍थान की भित्तरली कोठड़ी</para>
  <para style="q" vid="PSA 28:2">की ओड़ मदद खात्तर अपणे हाथ ठाऊँ,</para>
  <para style="q" vid="PSA 28:2">फेर मेरी गिड़गिड़ाहट की आवाज नै सुण ले।<verse eid="PSA 28:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 28:3" />उन दुष्टां अर अनर्थकारियाँ कै गैल मन्‍नै ना घसीटै;</para>
  <para style="q" vid="PSA 28:3">जो अपणे पड़ोसियाँ तै बात तो मेळ-मिलाप की करै सै,</para>
  <para style="q" vid="PSA 28:3">पर मन म्ह बुराई राक्खै सै।<verse eid="PSA 28:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 28:4" />उनके काम्मां के अर उनकी करणी की बुराई</para>
  <para style="q" vid="PSA 28:4">कै मुताबिक उनतै बरताव कर,</para>
  <para style="q" vid="PSA 28:4">उनके हाथ्थां के काम्मां कै मुताबिक उननै बदला दे;</para>
  <para style="q" vid="PSA 28:4">उनके काम्मां का बदला उननै दे।<verse eid="PSA 28:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 28:5" />वे यहोवा की राह नै</para>
  <para style="q" vid="PSA 28:5">अर उसके हाथ के काम्मां नै न्ही समझदे,</para>
  <para style="q" vid="PSA 28:5">इस करकै वो उननै पछाड़ैगा अर फेर उठावै कोनी।<verse eid="PSA 28:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 28:6" />यहोवा धन्य सै;</para>
  <para style="q" vid="PSA 28:6">क्यूँके उसनै मेरी गिड़गिड़ाहट सुणी सै।<verse eid="PSA 28:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 28:7" />यहोवा मेरी ताकत अर मेरी ढाल सै;</para>
  <para style="q" vid="PSA 28:7">उसपै भरोस्सा राक्खण तै मेरे मन नै मदद मिलै सै;</para>
  <para style="q" vid="PSA 28:7">इस करकै मेरा मन फुल्या न्ही समान्दा;</para>
  <para style="q" vid="PSA 28:7">अर मै गीत गाकै उसका धन्यवाद करुँगा।<verse eid="PSA 28:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 28:8" />यहोवा उनकी ताकत सै,</para>
  <para style="q" vid="PSA 28:8">वो अपणे चुणे होए अभिषिक्त खात्तर उद्धार का मजबूत गढ़ सै।<verse eid="PSA 28:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 28:9" />हे यहोवा अपणी प्रजा का उद्धार कर,</para>
  <para style="q" vid="PSA 28:9">अर अपणे निज भाग के माणसां नै आशीष दे;</para>
  <para style="q" vid="PSA 28:9">अर उनकी चरवाही कर अर सदा उननै सम्भाळे रह।<verse eid="PSA 28:9" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" sid="PSA 29" />
  <para style="s">परमेसवर की आवाज</para>
  <para style="d">दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 29:1" />हे सुर्गदूत्तों, यहोवा का,</para>
  <para style="q" vid="PSA 29:1">हाँ, यहोवा ए का गुणगान करो,</para>
  <para style="q" vid="PSA 29:1">यहोवा की महिमा अर ताकत नै सराहो।<verse eid="PSA 29:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 29:2" />यहोवा के नाम की महिमा करो;</para>
  <para style="q" vid="PSA 29:2">पवित्रता तै शोभायमान होकै यहोवा नै दण्डवत करो।<verse eid="PSA 29:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 29:3" />यहोवा की वाणी बादळां कै उप्पर सै;</para>
  <para style="q" vid="PSA 29:3">प्रतापी परमेसवर गरजै सै,</para>
  <para style="q" vid="PSA 29:3">यहोवा घणे बादळां कै उप्पर रहवै सै।<verse eid="PSA 29:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 29:4" />यहोवा की वाणी शक्तिशाली सै,</para>
  <para style="q" vid="PSA 29:4">यहोवा की वाणी प्रतापमय सै।<verse eid="PSA 29:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 29:5" />यहोवा की वाणी देवदारां नै तोड़ देवै सै;</para>
  <para style="q" vid="PSA 29:5">यहोवा लबानोन के देवदारां नै भी तोड़ देवै सै।<verse eid="PSA 29:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 29:6" />वो लबानोन नै बाछड़े की तरियां</para>
  <para style="q" vid="PSA 29:6">अर सिर्योन नै जंगळी बाछड़े की तरियां उछाळै सै।<verse eid="PSA 29:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 29:7" />यहोवा की वाणी आग की लपटां नै चीर दे सै।<verse eid="PSA 29:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 29:8" />यहोवा की वाणी बण नै हिला दे सै,</para>
  <para style="q" vid="PSA 29:8">यहोवा कादेश के बण नै भी हिला दे सै।<verse eid="PSA 29:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 29:9" />यहोवा की वाणी सागवान की लाकड़ियाँ नै भी तोड़दे सै।<note caller="+" style="f"><char style="fr" closed="false">29:9 </char><char style="fq" closed="false">सागवान की लाकड़ियाँ नै भी तोड़दे सै</char><char style="ft" closed="false">हिरणीयाँ का भी गर्भ गिरजा सै। </char></note></para>
  <para style="q" vid="PSA 29:9">अर जंगळ म्ह पतझड़ होवै सै;</para>
  <para style="q" vid="PSA 29:9">अर उसके मन्दर म्ह हरेक</para>
  <para style="q" vid="PSA 29:9">महिमा ए महिमा बोल्दे रहवै सै।<verse eid="PSA 29:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 29:10" />जल-प्रलय कै बखत यहोवा विराजमान था;</para>
  <para style="q" vid="PSA 29:10">अर यहोवा सदा खात्तर राजा होकै</para>
  <para style="q" vid="PSA 29:10">विराजमान रहवै सै।<verse eid="PSA 29:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 29:11" />यहोवा अपणी प्रजा नै ताकत देवैगा;</para>
  <para style="q" vid="PSA 29:11">यहोवा अपणी प्रजा नै शान्ति की आशीष देवैगा।<verse eid="PSA 29:11" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" sid="PSA 30" />
  <para style="s">धन्यवाद की प्रार्थना</para>
  <para style="d">भवन की प्रतिष्ठा खात्तर दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 30:1" />हे यहोवा मै तेरे ताहीं सराहूँगा, क्यूँके तन्‍नै</para>
  <para style="q" vid="PSA 30:1">मेरे ताहीं खींच कै लिकाड्या सै,</para>
  <para style="q" vid="PSA 30:1">अर मेरे दुश्मनां ताहीं मेरे पै</para>
  <para style="q" vid="PSA 30:1">आनन्द न्ही करण दिया।<verse eid="PSA 30:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 30:2" />हे मेरे परमेसवर यहोवा,</para>
  <para style="q" vid="PSA 30:2">मन्‍नै तेरी दुहाई दी अर तन्‍नै मेरे ताहीं चंगा करया।<verse eid="PSA 30:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 30:3" />हे यहोवा तन्‍नै मेरा प्राण अधोलोक म्ह तै लिकाड्या सै,</para>
  <para style="q" vid="PSA 30:3">तन्‍नै मेरे ताहीं जिन्दा राख्या</para>
  <para style="q" vid="PSA 30:3">अर कब्र म्ह पड़ण तै बचाया सै।<verse eid="PSA 30:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 30:4" />थम जो बिश्वास लायक सो!</para>
  <para style="q" vid="PSA 30:4">यहोवा की बड़ाई करो,</para>
  <para style="q" vid="PSA 30:4">अर जिस पवित्र नाम तै उसका स्मरण होवै सै,</para>
  <para style="q" vid="PSA 30:4">उसका धन्यवाद करो।<verse eid="PSA 30:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 30:5" />क्यूँके उसका छो तो माड़ी देर का होवै सै,</para>
  <para style="q" vid="PSA 30:5">पर उसकी प्रसन्‍नता जीवन भर की होवै सै।</para>
  <para style="q" vid="PSA 30:5">भलाए रात नै रोणा पड़ै,</para>
  <para style="q" vid="PSA 30:5">पर सबेरै आनन्द मिलैगा।<verse eid="PSA 30:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 30:6" />मन्‍नै तो अपणे चैन कै बखत कह्या था,</para>
  <para style="q" vid="PSA 30:6">के मै कदे न्ही हटण का।<verse eid="PSA 30:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 30:7" />हे यहोवा तन्‍नै अपणी खुशी तै मेरे पहाड़ ताहीं मजबूत</para>
  <para style="q" vid="PSA 30:7">अर स्थिर करया था;</para>
  <para style="q" vid="PSA 30:7">जब तन्‍नै अपणा मुँह फेर लिया</para>
  <para style="q" vid="PSA 30:7">तब मै घबराग्या।<verse eid="PSA 30:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 30:8" />हे यहोवा मन्‍नै तेरे ताहीं ए पुकारया;</para>
  <para style="q" vid="PSA 30:8">अर प्रभु तै गिड़गिड़ाकै या बिनती करी, के<verse eid="PSA 30:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 30:9" />जिब मै कब्र म्ह चल्या जाऊँगा तो फेर मेरी मौत तै</para>
  <para style="q" vid="PSA 30:9">के फायदा होवैगा?</para>
  <para style="q" vid="PSA 30:9">के माट्टी तेरा धन्यवाद कर सकै सै?</para>
  <para style="q" vid="PSA 30:9">के वा तेरी सच्‍चाई का प्रचार कर सकै सै?<verse eid="PSA 30:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 30:10" />हे यहोवा, सुण, मेरे पै दया कर;</para>
  <para style="q" vid="PSA 30:10">हे यहोवा, तू मेरा मददगार बण।<verse eid="PSA 30:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 30:11" />तन्‍नै मेरे खात्तर दुख की घड़ी ताहीं नाच म्ह बदल दिया,</para>
  <para style="q" vid="PSA 30:11">तन्‍नै मेरा टाट उतरवा कै मेरी कमर म्ह आनन्द</para>
  <para style="q" vid="PSA 30:11">का पटका बाँधया सै;<verse eid="PSA 30:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 30:12" />ताके मेरा मन तेरा भजन गान्दा रहवै</para>
  <para style="q" vid="PSA 30:12">अर कदे चुप न्ही हो।</para>
  <para style="q" vid="PSA 30:12">हे मेरे परमेसवर यहोवा,</para>
  <para style="q" vid="PSA 30:12">मै सदा तेरा धन्यवाद करदा रहूँगा।<verse eid="PSA 30:12" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" sid="PSA 31" />
  <para style="s">परमेसवर पै भरोस्सा राक्खण की प्रार्थना</para>
  <para style="d">प्रधान बजाण आळे कै खात्तर दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 31:1" />हे यहोवा, मै तेरे म्ह शरण लेऊँ सूं,</para>
  <para style="q" vid="PSA 31:1">मन्‍नै कदे शर्मिन्दा होणा ना पड़ै;</para>
  <para style="q" vid="PSA 31:1">तू अपणे धर्मी होण कै कारण मन्‍नै छुड़ाले!<verse eid="PSA 31:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 31:2" />अपणा कान मेरी ओड़ लगाकै</para>
  <para style="q" vid="PSA 31:2">तावळा मन्‍नै छुड़ाले!<verse eid="PSA 31:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 31:3" />क्यूँके तू मेरै खात्तर चट्टान अर मेरा गढ़ सै;</para>
  <para style="q" vid="PSA 31:3">इस करकै अपणे नाम कै निमित मेरी अगुवाई कर,</para>
  <para style="q" vid="PSA 31:3">अर मन्‍नै आग्गै ले चाल।<verse eid="PSA 31:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 31:4" />जो जाळ उननै मेरै खात्तर बिछाया सै</para>
  <para style="q" vid="PSA 31:4">उसतै तू मन्‍नै छुड़ाले,</para>
  <para style="q" vid="PSA 31:4">क्यूँके तू ए मेरा मजबूत गढ़ सै।<verse eid="PSA 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 31:5" />मै अपणी आत्मा नै तेरे हाथ म्ह सौंप देऊँ सूं;</para>
  <para style="q" vid="PSA 31:5">हे यहोवा, हे बिश्वास लायक परमेसवर,</para>
  <para style="q" vid="PSA 31:5">तन्‍नै मेरे ताहीं मोल लेकै मुक्त करया सै।<verse eid="PSA 31:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 31:6" />जो बेकार म्ह मूर्तियाँ पै मन लगावै सै,</para>
  <para style="q" vid="PSA 31:6">उनतै मै घृणा करुँ सूं;</para>
  <para style="q" vid="PSA 31:6">पर मेरा भरोस्सा यहोवा पै सै।<verse eid="PSA 31:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 31:7" />मै तेरी करुणा तै मगन अर आनन्दित सूं,</para>
  <para style="q" vid="PSA 31:7">क्यूँके तन्‍नै मेरे दुख म्ह निगांह करी सै,</para>
  <para style="q" vid="PSA 31:7">मेरे बुरे बखत म्ह तन्‍नै मेरी सुधि ली सै।<verse eid="PSA 31:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 31:8" />अर तन्‍नै मेरे ताहीं बैरी कै हाथ म्ह न्ही सौप्या;</para>
  <para style="q" vid="PSA 31:8">तन्‍नै मेरे पायां ताहीं खुल्‍ली जगहां म्ह टिकाया सै।<verse eid="PSA 31:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 31:9" />हे यहोवा, मेरे पै अनुग्रह कर क्यूँके मै संकट म्ह सूं;</para>
  <para style="q" vid="PSA 31:9">मेरी आँख बल्के मेरे प्राण</para>
  <para style="q" vid="PSA 31:9">अर देह सब शोक के मारे घुळी जावै सै।<verse eid="PSA 31:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 31:10" />मेरी जिन्दगी दुख के मारे</para>
  <para style="q" vid="PSA 31:10">अर मेरी उम्र कराहन्दे-कराहन्दे घटगी सै;</para>
  <para style="q" vid="PSA 31:10">मेरी ताकत मेरे दुख<note caller="+" style="f"><char style="fr" closed="false">31:10 </char><char style="fq" closed="false">दुख </char><char style="ft" closed="false">अधर्म </char></note> कै कारण जान्दी रही,</para>
  <para style="q" vid="PSA 31:10">अर मेरी सारी हाड्डी घुळगी।<verse eid="PSA 31:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 31:11" />अपणे सब बिरोधियाँ कै कारण मेरे पड़ोसियाँ</para>
  <para style="q" vid="PSA 31:11">म्ह मेरी बदनामी होई सै,</para>
  <para style="q" vid="PSA 31:11">अपणे जाण-पिच्छाण आळयां खात्तर डर का कारण सूं,</para>
  <para style="q" vid="PSA 31:11">जो मन्‍नै सड़क पै देक्खै सै वो मेरे तै दूर भाग जावै सै।<verse eid="PSA 31:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 31:12" />मै मरे होया की तरियां माणसां के मन तै उतर ग्या सूं।</para>
  <para style="q" vid="PSA 31:12">मै टूट्टे होड़ बरतन की ढाळ होग्या सूं।<verse eid="PSA 31:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 31:13" />मन्‍नै घण्या कै मुँह तै अपणी बुराई सुणी,</para>
  <para style="q" vid="PSA 31:13">च्यांरु ओड़ डर ए डर सै!</para>
  <para style="q" vid="PSA 31:13">जिब उननै मेरै बिरुध्द आप्पस म्ह सलाह मिलाई</para>
  <para style="q" vid="PSA 31:13">फेर मेरी जान लेण की युक्ति बणाई।<verse eid="PSA 31:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 31:14" />पर हे यहोवा, मन्‍नै तो तेरे पैए भरोस्सा सै,</para>
  <para style="q" vid="PSA 31:14">मन्‍नै कह्या, “तू मेरा परमेसवर सै।”<verse eid="PSA 31:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 31:15" />मेरा बखत तेरे हाथ म्ह सै,</para>
  <para style="q" vid="PSA 31:15">तू मन्‍नै मेरे दुश्मनां</para>
  <para style="q" vid="PSA 31:15">अर मेरे सताण आळयां के हाथ तै छुड़ा।<verse eid="PSA 31:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 31:16" />अपणे दास पै अपणे मुँह का प्रकाश चमका,</para>
  <para style="q" vid="PSA 31:16">अपणी करुणा तै मेरा उद्धार कर।<verse eid="PSA 31:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 31:17" />हे यहोवा मन्‍नै शर्मिन्दा ना होण दे</para>
  <para style="q" vid="PSA 31:17">क्यूँके मन्‍नै तेरे ताहीं पुकारया सै,</para>
  <para style="q" vid="PSA 31:17">दुष्ट शर्मिन्दा हो</para>
  <para style="q" vid="PSA 31:17">अर वे पाताळ म्ह चुपचाप पड़े रहवै।<verse eid="PSA 31:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 31:18" />जो घमण्ड अर अपमान तै धर्मी की बुराई करै सै,</para>
  <para style="q" vid="PSA 31:18">उनके झूठ बोलण आळे मुँह बन्द करे जावै।<verse eid="PSA 31:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 31:19" />आहा, तेरी भलाई कितनी बड़ी सै</para>
  <para style="q" vid="PSA 31:19">जो तन्‍नै अपणे भय मान्‍नण आळयां खात्तर छोड्डी सै,</para>
  <para style="q" vid="PSA 31:19">अर अपणे शरण लेण आळयां खात्तर माणसां कै</para>
  <para style="q" vid="PSA 31:19">स्याम्ही जाहिर भी करी सै।<verse eid="PSA 31:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 31:20" />तू उननै दर्शन देण के गुप्त जगहां म्ह माणसां की</para>
  <para style="q" vid="PSA 31:20">बुरी योजना तै गुप्त राक्खैगा,</para>
  <para style="q" vid="PSA 31:20">तू उन ताहीं अपणे मण्डप म्ह झगड़े-रगड़े तै</para>
  <para style="q" vid="PSA 31:20">लह्कोए राक्खैगा।<verse eid="PSA 31:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 31:21" />यहोवा धन्य सै,</para>
  <para style="q" vid="PSA 31:21">क्यूँके उसनै मेरे ताहीं गढ़ आळे नगर म्ह राखकै</para>
  <para style="q" vid="PSA 31:21">मेरे पै अदभुत करुणा करी सै।<verse eid="PSA 31:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 31:22" />मन्‍नै तो घबराकै कह्या था, के मै यहोवा की</para>
  <para style="q" vid="PSA 31:22">नजर तै दूर होग्या।</para>
  <para style="q" vid="PSA 31:22">फेर भी जिब मन्‍नै तेरी दुहाई दी, तब तन्‍नै मेरी</para>
  <para style="q" vid="PSA 31:22">गिड़गिड़ाहट ताहीं सुण लिया।<verse eid="PSA 31:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 31:23" />हे यहोवा के मानण आळेयो उस ताहीं प्यार करो!</para>
  <para style="q" vid="PSA 31:23">यहोवा बिश्वास लायक माणसां की तो हिफाजत करै सै,</para>
  <para style="q" vid="PSA 31:23">पर जो घमण्ड करै सै,</para>
  <para style="q" vid="PSA 31:23">उसनै वो आच्छी ढाळ बदला देवै सै।<verse eid="PSA 31:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 31:24" />हे यहोवा पै आस राक्खण आळेयो,</para>
  <para style="q" vid="PSA 31:24">हिम्मत राक्खो अर थारे मन मजबूत रहवैं!<verse eid="PSA 31:24" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" sid="PSA 32" />
  <para style="s">माफी पाण की आशीष</para>
  <para style="d">दाऊद का भजन मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 32:1" />कितना धन्य सै वो जिसका पाप</para>
  <para style="q" vid="PSA 32:1">माफ करया गया,</para>
  <para style="q" vid="PSA 32:1">अर जिसका पाप ढक्या गया हो।<verse eid="PSA 32:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 32:2" />कितना धन्य सै वो माणस जिसके अधर्म</para>
  <para style="q" vid="PSA 32:2">का यहोवा लेखा ना ले,</para>
  <para style="q" vid="PSA 32:2">अर जिसकी आत्मा म्ह कपट ना हो।<verse eid="PSA 32:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 32:3" />जिब मै चुप रह्या</para>
  <para style="q" vid="PSA 32:3">तब दिन भर कहरान्दे-कहरान्दे मेरी हड्डियाँ</para>
  <para style="q" vid="PSA 32:3">पिंघळगी।<verse eid="PSA 32:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 32:4" />क्यूँके रात-दिन मै तेरे हाथ कै नीच्‍चै दब्या रह्या;</para>
  <para style="q" vid="PSA 32:4">अर मेरी तरावट घाम<note caller="+" style="f"><char style="fr" closed="false">32:4 </char><char style="fq" closed="false">घाम </char><char style="ft" closed="false">धूप</char></note> की तरियां झुर्राहट</para>
  <para style="q" vid="PSA 32:4">बणदी गई। (सेला)<verse eid="PSA 32:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 32:5" />जिब मन्‍नै अपणा पाप तेरे ताहीं बताया</para>
  <para style="q" vid="PSA 32:5">अर अपणा अधर्म न्ही छिपाया,</para>
  <para style="q" vid="PSA 32:5">अर कह्या, “मै यहोवा कै स्याम्ही अपणे अपराध मान ल्यूँगा;”</para>
  <para style="q" vid="PSA 32:5">फेर तन्‍नै मेरे अधर्म अर पाप माफ कर दिये। (सेला)<verse eid="PSA 32:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 32:6" />इस कारण हरेक भगत नै जरूरत कै बखत</para>
  <para style="q" vid="PSA 32:6">म्ह तेरे तै प्रार्थना करणी चाहिए।</para>
  <para style="q" vid="PSA 32:6">पक्‍का जिब पाणी की बड़ी बाढ़ आवै तोभी</para>
  <para style="q" vid="PSA 32:6">उस भगत कै धोरै न्ही जा पावैगी।<verse eid="PSA 32:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 32:7" />तू मेरे लुह्कण की जगहां सै;</para>
  <para style="q" vid="PSA 32:7">तू संकट म्ह मेरी हिफाजत करैगा;</para>
  <para style="q" vid="PSA 32:7">तू मन्‍नै च्यांरु ओड़ तै छुटकारै के गीतां तै घेर</para>
  <para style="q" vid="PSA 32:7">लेवैगा। (सेला)<verse eid="PSA 32:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 32:8" />मै तन्‍नै बुद्धि दियुँगा, अर जिस राह म्ह तन्‍नै</para>
  <para style="q" vid="PSA 32:8">चालणा सै उस म्ह तेरी अगुवाई करुँगा;</para>
  <para style="q" vid="PSA 32:8">मै तेरे पै कृपादृष्टि राक्खूँगा।</para>
  <para style="q" vid="PSA 32:8">अर तसल्‍ली दिया करुँगा।<verse eid="PSA 32:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 32:9" />थम घोड़े अर खच्‍चर की तरियां ना बणो जो समझ कोनी राक्खदे,</para>
  <para style="q" vid="PSA 32:9">उनकी उमंग लगाम अर मार तै रोकणी पड़ै सै,</para>
  <para style="q" vid="PSA 32:9">न्ही तो वे तेरे बस म्ह न्ही आण के।<verse eid="PSA 32:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 32:10" />दुष्ट नै तो घणी पीड़ा होवैगी;</para>
  <para style="q" vid="PSA 32:10">पर जो यहोवा पै भरोस्सा राक्खै सै</para>
  <para style="q" vid="PSA 32:10">वो करुणा तै घिरया रहवैगा।<verse eid="PSA 32:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 32:11" />हे धर्मियों यहोवा कै कारण आनन्दित</para>
  <para style="q" vid="PSA 32:11">अर मगन हो, अर हे सब सीध्धे मन आळेयो</para>
  <para style="q" vid="PSA 32:11">आनन्द तै जयजयकार करो!<verse eid="PSA 32:11" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" sid="PSA 33" />
  <para style="s">परमेसवर की बड़ाई का गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 33:1" />हे धर्मियों यहोवा कै कारण खुशी कै गैल जयजयकार करो।</para>
  <para style="q" vid="PSA 33:1">क्यूँके धर्मी माणसां नै स्तुति करणा शोभा देवै सै।<verse eid="PSA 33:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 33:2" />वीणा बजा-बजाकै यहोवा का धन्यवाद करो,</para>
  <para style="q" vid="PSA 33:2">दस तार आळी सारंगी बजा-बजाकै</para>
  <para style="q" vid="PSA 33:2">उसका भजन गाओ।<verse eid="PSA 33:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 33:3" />उसकै खात्तर नया गीत गाओ,</para>
  <para style="q" vid="PSA 33:3">जयजयकार कै गैल आच्छी ढाळ बजाओ।<verse eid="PSA 33:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 33:4" />क्यूँके यहोवा का वचन सीध्धा सै;</para>
  <para style="q" vid="PSA 33:4">अर उसका सारा काम सच्‍चाई तै होवै सै।<verse eid="PSA 33:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 33:5" />वो धर्म अर न्याय तै प्यार राक्खै सै;</para>
  <para style="q" vid="PSA 33:5">यहोवा की करुणा तै धरती भरपूर सै।<verse eid="PSA 33:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 33:6" />अकासमण्डल यहोवा के वचन तै,</para>
  <para style="q" vid="PSA 33:6">अर उसके सारे तारागण उसके मुँह की</para>
  <para style="q" vid="PSA 33:6">साँस तै बणे।<verse eid="PSA 33:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 33:7" />वो समुन्दर का पाणी ढेर की तरियां कठ्ठा करै सै;</para>
  <para style="q" vid="PSA 33:7">वो गहरे सागर नै अपणे भण्डार म्ह राक्खै सै।<verse eid="PSA 33:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 33:8" />सारी धरती के माणस यहोवा तै डरै,</para>
  <para style="q" vid="PSA 33:8">दुनिया म्ह सारे रहण आळे उसका भय मान्‍नै!<verse eid="PSA 33:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 33:9" />क्यूँके जिब उसनै कह्या, तब होग्या;</para>
  <para style="q" vid="PSA 33:9">जिब उसनै हुक्म दिया,</para>
  <para style="q" vid="PSA 33:9">तब सच म्ह उसाए होग्या।<verse eid="PSA 33:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 33:10" />यहोवा जात्ति-जात्ति की तरकीब नै</para>
  <para style="q" vid="PSA 33:10">बेकार कर देवै सै,</para>
  <para style="q" vid="PSA 33:10">वो देश-देश के माणसां की कल्पना</para>
  <para style="q" vid="PSA 33:10">नै नाकामयाब करै सै।<verse eid="PSA 33:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 33:11" />यहोवा की तरकीब सदा टिक्यी रहवैगी,</para>
  <para style="q" vid="PSA 33:11">उसके मन की कल्पना पीढ़ी तै पीढ़ी</para>
  <para style="q" vid="PSA 33:11">तक बणी रहवैगी।<verse eid="PSA 33:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 33:12" />कितनी धन्य सै वा जात्ति जिसका परमेसवर</para>
  <para style="q" vid="PSA 33:12">यहोवा सै,</para>
  <para style="q" vid="PSA 33:12">अर वो समाज जिस ताहीं उसनै अपणा निज भाग</para>
  <para style="q" vid="PSA 33:12">होण खात्तर छाँट लिया हो!<verse eid="PSA 33:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 33:13" />यहोवा सुर्ग तै निगांह करै सै,</para>
  <para style="q" vid="PSA 33:13">वो सब माणसां नै निहारै सै;<verse eid="PSA 33:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 33:14" />अपणी रहण की जगहां तै</para>
  <para style="q" vid="PSA 33:14">वो धरती के सारे रहण आळयां नै देक्खै सै,<verse eid="PSA 33:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 33:15" />वोए जो उन सारया के मनां नै बणावै,</para>
  <para style="q" vid="PSA 33:15">अर उनके सारे काम्मां का विचार करै सै।<verse eid="PSA 33:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 33:16" />कोए इसा राजा न्ही, जो</para>
  <para style="q" vid="PSA 33:16">भोत घणी सेना कै कारण बच सकै;</para>
  <para style="q" vid="PSA 33:16">वीर अपणी बड़ी ताकत कै कारण बच न्ही सकता।<verse eid="PSA 33:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 33:17" />बच लिकड़ण खात्तर घोड़ा बेकार की आस सै,</para>
  <para style="q" vid="PSA 33:17">वो अपणी बड़ी ताकत कै जरिये किसे नै</para>
  <para style="q" vid="PSA 33:17">न्ही बचा सकता।<verse eid="PSA 33:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 33:18" />देक्खो, यहोवा की निगांह उसके डरवैयां पै</para>
  <para style="q" vid="PSA 33:18">अर उनपै जो उसकी करुणा की आस राक्खै सै</para>
  <para style="q" vid="PSA 33:18">बणी रहवै सै,<verse eid="PSA 33:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 33:19" />के वो उसके जी नै मौत तै बचावै,</para>
  <para style="q" vid="PSA 33:19">अर अकाळ कै बखत उननै जिन्दा राक्खै।<verse eid="PSA 33:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 33:20" />हम यहोवा की बाट देखदे आये सां;</para>
  <para style="q" vid="PSA 33:20">वो म्हारा मददगार अर म्हारी ढाल सै।<verse eid="PSA 33:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 33:21" />म्हारा मन उसके कारण आनन्दित होवैगा,</para>
  <para style="q" vid="PSA 33:21">क्यूँके हमनै उसके पवित्र नाम पै भरोस्सा राख्या सै।<verse eid="PSA 33:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 33:22" />हे यहोवा जिसी तेरे पै म्हारी आस सै,</para>
  <para style="q" vid="PSA 33:22">उसीए तेरी करुणा भी म्हारै पै हो।<verse eid="PSA 33:22" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" sid="PSA 34" />
  <para style="s">परमेसवर धर्मी का उद्धारकर्ता</para>
  <para style="d">दाऊद का भजन जिब वो अबीमेलेक के स्याम्ही बौरहा बण्या, अर अबीमेलेक नै उस ताहीं लिकाड़ दिया, अर वो चल्या गया</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 34:1" />मै हर बखत यहोवा नै धन्य कह्या करुँगा;</para>
  <para style="q" vid="PSA 34:1">उसकी स्तुति लगातार मेरे मुँह तै होन्दी रहवैगी।<verse eid="PSA 34:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 34:2" />मै यहोवा पै घमण्ड करुँगा;</para>
  <para style="q" vid="PSA 34:2">नम्र लोग या सुणकै आनन्दित होवैंगे।<verse eid="PSA 34:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 34:3" />मेरे गैल यहोवा की बड़ाई करो,</para>
  <para style="q" vid="PSA 34:3">अर आओ हम मिलकै उसके नाम की स्तुति करां।<verse eid="PSA 34:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 34:4" />मन्‍नै यहोवा तै प्रार्थना करी,<note caller="+" style="f"><char style="fr" closed="false">34:4 </char><char style="fq" closed="false">मन्‍नै यहोवा तै प्रार्थना करी, </char><char style="ft" closed="false">मन्‍नै यहोवा ताहीं टोह्या</char></note></para>
  <para style="q" vid="PSA 34:4">तब उसनै मेरी सुण ली,</para>
  <para style="q" vid="PSA 34:4">अर मेरे ताहीं पूरी तरियां तै निर्भय करया।<verse eid="PSA 34:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 34:5" />जिननै उसकी ओड़ निगांह करी</para>
  <para style="q" vid="PSA 34:5">उननै ज्योति पाई;</para>
  <para style="q" vid="PSA 34:5">अर उनका मुँह कदे काळा न्ही होण पाया।<verse eid="PSA 34:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 34:6" />इस दीन जन नै पुकारया तब यहोवा नै सुण ली,</para>
  <para style="q" vid="PSA 34:6">अर उस ताहीं उसके सारे कष्टां तै छुड़ा लिया।<verse eid="PSA 34:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 34:7" />यहोवा के भय मान्‍नण आळयां कै च्यांरु ओड़ उसका दूत</para>
  <para style="q" vid="PSA 34:7">छावणी करे होए उननै बचावै सै।<verse eid="PSA 34:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 34:8" />परख कै देक्खो यहोवा किसा भला सै!</para>
  <para style="q" vid="PSA 34:8">कितना धन्य सै वो माणस जो उसकी शरण लेवै सै।<verse eid="PSA 34:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 34:9" />हे यहोवा के पवित्र माणसों, उसका भय मान्‍नो,</para>
  <para style="q" vid="PSA 34:9">क्यूँके उसका भय मान्‍नण आळयां नै किसे बात की कमी न्ही होन्दी!<verse eid="PSA 34:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 34:10" />जवान शेरां नै तो कमी हो ज्या सै</para>
  <para style="q" vid="PSA 34:10">अर वे भूखे भी रह ज्या सै;</para>
  <para style="q" vid="PSA 34:10">पर यहोवा के टोह्ण आळयां नै किसे भली</para>
  <para style="q" vid="PSA 34:10">चीज की कमी न्ही होगी।<verse eid="PSA 34:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 34:11" />हे बाळकों, आओ, मेरी सुणो,</para>
  <para style="q" vid="PSA 34:11">मै थमनै यहोवा का भय मानणा सिखाऊँगा।<verse eid="PSA 34:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 34:12" />वो कौण माणस सै जो जीवन की इच्छा राक्खै,</para>
  <para style="q" vid="PSA 34:12">अर लम्बी उम्र चाहवै सै ताके भलाई देक्खै?<verse eid="PSA 34:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 34:13" />अपणी जीभ नै बुराई तै रोक कै राख,</para>
  <para style="q" vid="PSA 34:13">अर अपणे मुँह की चौकसी कर ताके</para>
  <para style="q" vid="PSA 34:13">उसतै छळ की बात ना लिकड़ै।<verse eid="PSA 34:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 34:14" />बुराई नै छोड़ अर भलाई कर;</para>
  <para style="q" vid="PSA 34:14">मेळ नै ढूँढ़ अर उस्से का पिच्छा कर।<verse eid="PSA 34:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 34:15" />यहोवा की आँख धर्मियाँ पै लाग्गी रहवै सै,</para>
  <para style="q" vid="PSA 34:15">अर उसके कान भी उसकी दुहाई की</para>
  <para style="q" vid="PSA 34:15">ओड़ लाग्गे रहवै सै।<verse eid="PSA 34:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 34:16" />यहोवा बुराई करण आळयां कै खिलाफ रहवै सै,</para>
  <para style="q" vid="PSA 34:16">ताके उनकी याद धरती पै तै मिटा दे।<verse eid="PSA 34:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 34:17" />धर्मी दुहाई देवै सै अर यहोवा सुणै सै,</para>
  <para style="q" vid="PSA 34:17">अर उननै सारी विपतियाँ तै छुड़ावै सै।<verse eid="PSA 34:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 34:18" />यहोवा टूट्टे मन आळयां कै धोरै रहवै सै,</para>
  <para style="q" vid="PSA 34:18">अर पईसे होया का उद्धार करै सै।<verse eid="PSA 34:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 34:19" />धर्मी पै घणी विपति पड़ै तो सै,</para>
  <para style="q" vid="PSA 34:19">पर यहोवा उसनै उन सब तै</para>
  <para style="q" vid="PSA 34:19">मुक्त करै सै।<verse eid="PSA 34:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 34:20" />वो उसकी हाड्डी-हाड्डी की हिफाजत करै सै,</para>
  <para style="q" vid="PSA 34:20">अर उन म्ह तै एक भी टूटण न्ही पांदी।<verse eid="PSA 34:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 34:21" />दुष्ट अपणी बुराई कै कारण मारया जावैगा;</para>
  <para style="q" vid="PSA 34:21">अर धर्मी के बैरी दोषी ठहरैगें।<verse eid="PSA 34:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 34:22" />यहोवा अपणे दास्सां का प्राण मोल लेकै बचाले सै,</para>
  <para style="q" vid="PSA 34:22">अर जितने उसके शरणागत सै</para>
  <para style="q" vid="PSA 34:22">उन म्ह तै कोए भी दोषी न्ही ठहरैगा।<verse eid="PSA 34:22" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" sid="PSA 35" />
  <para style="s">जीत कै खात्तर प्रार्थना</para>
  <para style="d">दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 35:1" />हे यहोवा जो मेरै गैल मुकद्दमा लड़ै सै,</para>
  <para style="q" vid="PSA 35:1">उनकै गैल तू भी मुकद्दमा लड़,</para>
  <para style="q" vid="PSA 35:1">जो मेरे तै युद्ध करै से, उनतै तू युद्ध कर।<verse eid="PSA 35:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 35:2" />ढाल अर भाला लेकै मेरी मदद करण खात्तर</para>
  <para style="q" vid="PSA 35:2">खड्या हो।<verse eid="PSA 35:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 35:3" />बर्छी नै खींच अर मेरा पिच्छा करण आळयां कै</para>
  <para style="q" vid="PSA 35:3">स्याम्ही आकै उननै रोक;</para>
  <para style="q" vid="PSA 35:3">अर मेरे तै कह,</para>
  <para style="q" vid="PSA 35:3">के मै तेरा उद्धार सूं।<verse eid="PSA 35:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 35:4" />जो मेरे प्राण के ग्राहक सै</para>
  <para style="q" vid="PSA 35:4">वे शर्मिन्दा अर निरादर हो!</para>
  <para style="q" vid="PSA 35:4">जो मेरे नुकसान की कल्पना करै सै,</para>
  <para style="q" vid="PSA 35:4">वे पाच्छै हटाए जावै अर उनका मुँह काळा हो!<verse eid="PSA 35:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 35:5" />वे हवा तै उड़ जाण आळी भूसी कै समान हो,</para>
  <para style="q" vid="PSA 35:5">अर यहोवा का दूत उननै हाँकता जावै!<verse eid="PSA 35:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 35:6" />उनका राह अन्धियारा अर फिसळण भरया हो,</para>
  <para style="q" vid="PSA 35:6">अर यहोवा का दूत उननै खदेड़ता जावै।<verse eid="PSA 35:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 35:7" />क्यूँके बिना कारण उननै मेरै खात्तर अपणा</para>
  <para style="q" vid="PSA 35:7">जाळ खड्डे म्ह बिच्छाया;</para>
  <para style="q" vid="PSA 35:7">बिना कारण ए उननै मेरा प्राण लेण कै</para>
  <para style="q" vid="PSA 35:7">खात्तर खड्डा खोद्या सै।<verse eid="PSA 35:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 35:8" />चाणचक उनपै विपति आण पड़ै!</para>
  <para style="q" vid="PSA 35:8">अर जो जाळ उननै बिच्छाया सै</para>
  <para style="q" vid="PSA 35:8">उस्से म्ह वे आप्पे फसै;</para>
  <para style="q" vid="PSA 35:8">अर उस्से विपति म्ह वे आप्पे पड़ै!<verse eid="PSA 35:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 35:9" />पर मै यहोवा कै कारण अपणे</para>
  <para style="q" vid="PSA 35:9">मन म्ह मगन होऊँगा,</para>
  <para style="q" vid="PSA 35:9">मै उसके करे होए उद्धार तै हर्षित होऊँगा।<verse eid="PSA 35:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 35:10" />मेरी हाड्डी-हाड्डी कहवैंगी,</para>
  <para style="q" vid="PSA 35:10">“हे यहोवा, तेरे जिसा कौण सै,</para>
  <para style="q" vid="PSA 35:10">जो दीन नै बड़े-बड़े ताकतवरां तै बचावै सै,</para>
  <para style="q" vid="PSA 35:10">अर लुटेरयां तै दीन-दरिद्र माणसां की हिफाजत करै सै?”<verse eid="PSA 35:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 35:11" />अधर्मी गवाह खड़े होवै सै;</para>
  <para style="q" vid="PSA 35:11">वे मेरे पै झूठ्ठा दोष लगावै।<verse eid="PSA 35:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 35:12" />वे मेरे तै भलाई कै बदले बुराई करै सै;</para>
  <para style="q" vid="PSA 35:12">उरै ताहीं के मेरा प्राण ऊब ज्या सै।<verse eid="PSA 35:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 35:13" />जिब वे बीमार थे तब मै टाट पैहरे रह्या,</para>
  <para style="q" vid="PSA 35:13">अर उपवास कर-करकै दुख ठान्दा रह्या;</para>
  <para style="q" vid="PSA 35:13">अर मन्‍नै सिर झुका कै प्रार्थना करी उसका जवाब मन्‍नै न्ही मिल्या।<verse eid="PSA 35:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 35:14" />मै इसी भावना राक्खूँ था के मान्‍नो वे मेरे</para>
  <para style="q" vid="PSA 35:14">संगी या भाई सै; जिसा कोए माँ खात्तर</para>
  <para style="q" vid="PSA 35:14">बिलाप करदा हो, उसाए मन्‍नै शोक का</para>
  <para style="q" vid="PSA 35:14">पैहरावा पैहरे होए सिर झुका कै शोक करया।<verse eid="PSA 35:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 35:15" />पर जिब मै लंगड़ाण लाग्या तब वे</para>
  <para style="q" vid="PSA 35:15">माणस आनन्दित होकै कठ्ठे होए,</para>
  <para style="q" vid="PSA 35:15">नीच माणस अर जिन्हनै मै जाणु भी कोनी था</para>
  <para style="q" vid="PSA 35:15">वे मेरै बिरुध्द कठ्ठे होए; वे मन्‍नै लगातार बदनाम करदे रहे;<verse eid="PSA 35:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 35:16" />आदर के बिना वे मेरे पै तान्‍ना मारै सै;</para>
  <para style="q" vid="PSA 35:16">वे मेरे पै दाँत पिस्सै सै।।<verse eid="PSA 35:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 35:17" />हे प्रभु तू कद ताहीं देख्दा रह्वैगा?</para>
  <para style="q" vid="PSA 35:17">इस विपति तै, जिस म्ह उननै मेरे ताहीं</para>
  <para style="q" vid="PSA 35:17">गेरया सै मन्‍नै छुड़ा!</para>
  <para style="q" vid="PSA 35:17">जवान शेरां तै मेरी जान नै बचाले!<verse eid="PSA 35:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 35:18" />मै बड़ी सभा म्ह तेरा धन्यवाद करुँगा;</para>
  <para style="q" vid="PSA 35:18">घणखरे माणसां कै बीच म्ह मै तेरी स्तुति करुँगा।<verse eid="PSA 35:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 35:19" />मेरे झूठ बोल्‍लण आळे दुश्मन मेरै खिलाफ</para>
  <para style="q" vid="PSA 35:19">आनन्द न्ही करण पावै,</para>
  <para style="q" vid="PSA 35:19">जो बिना कारण मेरे बैरी सै,</para>
  <para style="q" vid="PSA 35:19">वे आप्पस म्ह नैन तै सैन न्ही करण पावै।<verse eid="PSA 35:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 35:20" />क्यूँके वे मेल की बात न्ही बोल्दे,</para>
  <para style="q" vid="PSA 35:20">पर देश म्ह जो चुपचाप रहवै सै,</para>
  <para style="q" vid="PSA 35:20">उनकै बिरुध्द छळ की कल्पना करै सै।<verse eid="PSA 35:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 35:21" />अर उननै मेरे बिरुध्द मुँह पसार कै कह्या;</para>
  <para style="q" vid="PSA 35:21">“आहा, आहा, हमनै अपणी आँखां तै देख्या सै!”<verse eid="PSA 35:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 35:22" />हे यहोवा, तन्‍नै तो देख्या सै; चुप ना रहवै!</para>
  <para style="q" vid="PSA 35:22">हे प्रभु, मेरे तै दूर ना रहवै!<verse eid="PSA 35:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 35:23" />उठ, मेरे न्याय खात्तर जाग,</para>
  <para style="q" vid="PSA 35:23">हे मेरे परमेसवर, हे मेरे प्रभु,</para>
  <para style="q" vid="PSA 35:23">मेरा मुकद्दमा निपटाण खात्तर आ!<verse eid="PSA 35:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 35:24" />हे मेरे परमेसवर यहोवा,</para>
  <para style="q" vid="PSA 35:24">तू अपणे धर्म कै मुताबिक मेरा न्याय चुका;</para>
  <para style="q" vid="PSA 35:24">अर उननै मेरे बिरुध्द आनन्द ना करण दे!<verse eid="PSA 35:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 35:25" />वे मन म्ह ना कहण पावै,</para>
  <para style="q" vid="PSA 35:25">“आहा! म्हारी तो इच्छा पूरी होई!</para>
  <para style="q" vid="PSA 35:25">वे यो ना कहवै, हमनै उसका सत्यानाश कर दिया सै<note caller="+" style="f"><char style="fr" closed="false">35:25 </char><char style="fq" closed="false">हमनै उसका सत्यानाश कर दिया सै </char><char style="ft" closed="false">हम उसनै निगळ ग्ये सा</char></note>।”<verse eid="PSA 35:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 35:26" />वो मेरे नुकसान तै आनन्दित होवै सैं</para>
  <para style="q" vid="PSA 35:26">उनके मुँह शर्म के मारे एक साथ काळे हो!</para>
  <para style="q" vid="PSA 35:26">जो मेरै बिरुध्द बड़ाई मारै सै</para>
  <para style="q" vid="PSA 35:26">वो शर्म अर अनादर तै ढँक जावै!<verse eid="PSA 35:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 35:27" />जो मेरे धर्म तै राज्जी रहवै सै,</para>
  <para style="q" vid="PSA 35:27">वे जयजयकार अर आनन्द करै,</para>
  <para style="q" vid="PSA 35:27">अर लगातार करदे रहवै, यहोवा की बड़ाई हो,</para>
  <para style="q" vid="PSA 35:27">जो अपणे दास की सलामती तै खुश होवै सै!<verse eid="PSA 35:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 35:28" />फेर मेरे मुँह तै तेरे धर्म की चर्चा होवैगी,</para>
  <para style="q" vid="PSA 35:28">अर दिन भर तेरी स्तुति लिकड़ैगी।<verse eid="PSA 35:28" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" sid="PSA 36" />
  <para style="s">परमेसवर का प्यार अर माणस की दुष्टता</para>
  <para style="d">प्रधान बजाण आळे खात्तर यहोवा के दास दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 36:1" />दुष्ट माणस का कसूर मेरे मन कै भित्तर न्यू कहवै सै;</para>
  <para style="q" vid="PSA 36:1">परमेसवर का भय उसकी नजर म्ह न्ही सै।<verse eid="PSA 36:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 36:2" />वो अपणे अधर्म के जाहिर होण</para>
  <para style="q" vid="PSA 36:2">अर घृणित रहण कै बारै म्ह</para>
  <para style="q" vid="PSA 36:2">अपणे मन म्ह चिकणी-चुपड़ी बात्तां की सोच्‍चै सै।<verse eid="PSA 36:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 36:3" />उसकी बात पाप अर धोक्खे की सै;</para>
  <para style="q" vid="PSA 36:3">उसनै बुद्धि अर भलाई के काम करण तै</para>
  <para style="q" vid="PSA 36:3">अपणे-आप ताहीं पाच्छै हटा लिया सै।<verse eid="PSA 36:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 36:4" />वो अपणे बिछोणे पै पड़े-पड़े</para>
  <para style="q" vid="PSA 36:4">अनर्थ की कल्पना करै सै;</para>
  <para style="q" vid="PSA 36:4">वो अपणे बुरे राह पै मजबुत्ती तै चाल्दा रहवै सै;</para>
  <para style="q" vid="PSA 36:4">बुराई तै वो न्ही हटदा।<verse eid="PSA 36:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 36:5" />हे यहोवा, तेरी करुणा सुर्ग म्ह सै,</para>
  <para style="q" vid="PSA 36:5">तेरी सच्‍चाई अकासमण्डल ताहीं पोहची सै।<verse eid="PSA 36:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 36:6" />तेरा धर्म ऊँच्‍चे पर्वतां कै समान सै,</para>
  <para style="q" vid="PSA 36:6">तेरे नियम अथाह सागर ठहरे सै;</para>
  <para style="q" vid="PSA 36:6">हे यहोवा, तू माणस अर पशु दोनुआ की</para>
  <para style="q" vid="PSA 36:6">हिफाजत करै सै।<verse eid="PSA 36:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 36:7" />हे परमेसवर, तेरी करुणा किसी अनमोल सै!</para>
  <para style="q" vid="PSA 36:7">माणस तेरे पंखां तळै शरण लेवै सै।<verse eid="PSA 36:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 36:8" />वे तेरे भवन के खाणे की</para>
  <para style="q" vid="PSA 36:8">भरपूरी तै तृप्त होंगे,</para>
  <para style="q" vid="PSA 36:8">अर तू उननै अपणी सुख की नदी</para>
  <para style="q" vid="PSA 36:8">म्ह तै प्यावैगा।<verse eid="PSA 36:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 36:9" />क्यूँके जीवन का सोता तेरैए धोरै सै;</para>
  <para style="q" vid="PSA 36:9">तेरे चाँदणे तै हम चान्दणा पावांगें।<verse eid="PSA 36:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 36:10" />अपणे जाणण आळयां पै करुणा करदा रहै,</para>
  <para style="q" vid="PSA 36:10">अर अपणे धर्म के काम अपणे सीध्धे</para>
  <para style="q" vid="PSA 36:10">मन आळयां म्ह करदा रहै!<verse eid="PSA 36:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 36:11" />अहंकारी मेरे पै लात ठाण न्ही पावै,</para>
  <para style="q" vid="PSA 36:11">अर ना बैरी अपणे बाजूआं के</para>
  <para style="q" vid="PSA 36:11">दम पै मन्‍नै भगाण पावै।<verse eid="PSA 36:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 36:12" />ओड़ै अनर्थकारी गिरगे सै;</para>
  <para style="q" vid="PSA 36:12">वे धकेल दिए, अर फेर उठ्ठ ना सकैगें।<verse eid="PSA 36:12" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" sid="PSA 37" />
  <para style="s">धर्मी की विरासत अर दुष्टा का अन्त</para>
  <para style="d">दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 37:1" />कुकर्मिया के कारण मत कुढ़,</para>
  <para style="q" vid="PSA 37:1">कुटिल काम करण आळयां कै बारें म्ह डाह ना करै!<verse eid="PSA 37:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 37:2" />क्यूँके वे घास की तरियां कट जावैंगे,</para>
  <para style="q" vid="PSA 37:2">अर हरी घास की तरियां मुरझा जावैंगे।<verse eid="PSA 37:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 37:3" />यहोवा पै भरोस्सा राख,</para>
  <para style="q" vid="PSA 37:3">अर भला कर, देश म्ह बस्या रहै,</para>
  <para style="q" vid="PSA 37:3">अर सच्‍चाई म्ह मन लगाये रहै।<verse eid="PSA 37:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 37:4" />यहोवा नै अपणे सुख का आधार जाण,</para>
  <para style="q" vid="PSA 37:4">अर वो तेरे मनोरथां नै पूरा करैगा।<verse eid="PSA 37:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 37:5" />अपणे राह की चिंता यहोवा पै छोड़ दे;</para>
  <para style="q" vid="PSA 37:5">अर उसपै भरोस्सा राख,</para>
  <para style="q" vid="PSA 37:5">वोए पूरा करैगा।<verse eid="PSA 37:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 37:6" />वो तेरा धर्म ज्योति की तरियां,</para>
  <para style="q" vid="PSA 37:6">अर तेरा न्याय दोपहर के उजियाळे की</para>
  <para style="q" vid="PSA 37:6">तरियां दिखावैगा।<verse eid="PSA 37:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 37:7" />यहोवा कै स्याम्ही चुप रहै,</para>
  <para style="q" vid="PSA 37:7">अर धीरज तै उसकी बाट देख;</para>
  <para style="q" vid="PSA 37:7">उस माणस कै कारण ना कुढ़, जिसके काम सफल होवै सै,</para>
  <para style="q" vid="PSA 37:7">अर वो बुरी तरकीब लिकाड़ै सै!<verse eid="PSA 37:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 37:8" />छो तै दूर रहै,</para>
  <para style="q" vid="PSA 37:8">अर जळजळाहट नै छोड़ दे!</para>
  <para style="q" vid="PSA 37:8">मत कुढ़, उसतै बुराई ए लिकड़ैगी।<verse eid="PSA 37:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 37:9" />क्यूँके कुकर्मी लोग काट दिए जावैंगे;</para>
  <para style="q" vid="PSA 37:9">अर जो यहोवा की बाट देक्खै सै,</para>
  <para style="q" vid="PSA 37:9">वोए धरती के हकदार होंगे।<verse eid="PSA 37:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 37:10" />थोड़े दिनां कै पाच्छै बैरी रहवै ए कोन्या;</para>
  <para style="q" vid="PSA 37:10">अर तू उननै देखणा चाहवैगा</para>
  <para style="q" vid="PSA 37:10">पर वे पावै कोन्या।<verse eid="PSA 37:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 37:11" />पर नरम लोग धरती के हकदार होंगे,</para>
  <para style="q" vid="PSA 37:11">अर बड़ी शान्ति के कारण आनन्द मनावैंगे।<verse eid="PSA 37:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 37:12" />दुष्ट धर्मी कै बिरुध्द बुरी तरकीब लिकाड़ै सै,</para>
  <para style="q" vid="PSA 37:12">अर उसपै दाँत पीस्सै सै;<verse eid="PSA 37:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 37:13" />पर प्रभु उसपै हास्सैगा,</para>
  <para style="q" vid="PSA 37:13">क्यूँके उसका दिन आण आळा सै।<verse eid="PSA 37:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 37:14" />दुष्ट माणस तलवार लिकाड़ै</para>
  <para style="q" vid="PSA 37:14">अर धनुष चढ़ाए होए सै,</para>
  <para style="q" vid="PSA 37:14">ताके दीन-दरिद्र नै गिरा दें,</para>
  <para style="q" vid="PSA 37:14">अर सीध्धी चाल चलण आळयां का वध करै।<verse eid="PSA 37:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 37:15" />उनकी तलवारां तै उनके मन छिदैंगे,</para>
  <para style="q" vid="PSA 37:15">अर उनके धनुष तोड़े जावैंगे।<verse eid="PSA 37:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 37:16" />धर्मी का थोड़ा धन बैरियाँ के</para>
  <para style="q" vid="PSA 37:16">घणे धन तै बढ़िया सै।<verse eid="PSA 37:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 37:17" />क्यूँके बैरियाँ की बाह तो तोड़ी जावैगी;</para>
  <para style="q" vid="PSA 37:17">पर यहोवा धर्मियाँ नै सम्भाळ सै।<verse eid="PSA 37:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 37:18" />यहोवा खरे माणसां की उम्र की सुधि राक्खै सै,</para>
  <para style="q" vid="PSA 37:18">अर उनका हिस्सा सदा बण्या रहवैगा।<verse eid="PSA 37:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 37:19" />मुसीबत कै बखत, उनकी आस न्ही टूट्टैगी अर ना वे शर्मिन्दा होवैंगे,</para>
  <para style="q" vid="PSA 37:19">अर अकाळ के दिनां म्ह वे तृप्त रहवैंगे।<verse eid="PSA 37:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 37:20" />बैरी माणस नाश हो जावैंगे;</para>
  <para style="q" vid="PSA 37:20">अर यहोवा के दुश्मन खेत की सुथरी घास</para>
  <para style="q" vid="PSA 37:20">की तरियां नाश होवैंगे,</para>
  <para style="q" vid="PSA 37:20">वे धूँए की तरियां गायब हो जावैंगे।<verse eid="PSA 37:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 37:21" />दुष्ट कर्ज लेवै सै,</para>
  <para style="q" vid="PSA 37:21">अर भरदा न्ही पर धर्मी</para>
  <para style="q" vid="PSA 37:21">अनुग्रह करकै दान देवै सै;<verse eid="PSA 37:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 37:22" />क्यूँके जो यहोवा तै आशीष पावै सै</para>
  <para style="q" vid="PSA 37:22">वे तो धरती के हकदार होंगे,</para>
  <para style="q" vid="PSA 37:22">पर जो उसतै श्रापित होवै सै,</para>
  <para style="q" vid="PSA 37:22">वे नाश हो जावैंगे।<verse eid="PSA 37:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 37:23" />इन्सान की चाल यहोवा की</para>
  <para style="q" vid="PSA 37:23">ओड़ तै मजबूत होवै सै,</para>
  <para style="q" vid="PSA 37:23">अर उसके चाल्‍लण तै वो खुश रहवै सै;<verse eid="PSA 37:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 37:24" />चाहे वो पड़ै तोभी पड्या न्ही रहवैगा,</para>
  <para style="q" vid="PSA 37:24">क्यूँके यहोवा उसका हाथ थाम्मे रहवै सै।<verse eid="PSA 37:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 37:25" />मै लड़कपण तै लेकै बुढ़ापे</para>
  <para style="q" vid="PSA 37:25">तक देख्दा आया सूं;</para>
  <para style="q" vid="PSA 37:25">पर ना तो कदे धर्मी नै त्यागा होया,</para>
  <para style="q" vid="PSA 37:25">अर ना उसके वंश ताहीं टुकड़े माँगदे होए देख्या सै।<verse eid="PSA 37:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 37:26" />वो तो दिन भर अनुग्रह कर-करकै उधार देवै सै,</para>
  <para style="q" vid="PSA 37:26">अर उसके वंश पै आशीष फलैदी रहवै सै।<verse eid="PSA 37:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 37:27" />बुराई नै छोड़ भलाई कर;</para>
  <para style="q" vid="PSA 37:27">अर तू सदा बण्या रहवैगा।<verse eid="PSA 37:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 37:28" />क्यूँके यहोवा न्याय तै लगाव राक्खै सै;</para>
  <para style="q" vid="PSA 37:28">अर अपणे भगतां नै कदे न्ही छोड्डैगा।</para>
  <para style="q" vid="PSA 37:28">उनकी तो हिफाजत सदा होवै सै,</para>
  <para style="q" vid="PSA 37:28">पर दुष्ट माणसां का वंश मिटा दिया जावैगा।<verse eid="PSA 37:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 37:29" />धर्मी लोग धरती के हकदार होवैंगे,</para>
  <para style="q" vid="PSA 37:29">अर उस म्ह सदा बसे रहवैंगे।<verse eid="PSA 37:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 37:30" />धर्मी अपणे मुँह तै बुद्धि की बात करै सै,</para>
  <para style="q" vid="PSA 37:30">अर न्याय का वचन कहवै सै।<verse eid="PSA 37:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 37:31" />उसके परमेसवर के नियम-कायदे उसके</para>
  <para style="q" vid="PSA 37:31">मन म्ह बणे रहवै सै,</para>
  <para style="q" vid="PSA 37:31">उसके पैर न्ही फिसळदे।<verse eid="PSA 37:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 37:32" />दुष्ट धर्मी की ताक म्ह रहवै सै।</para>
  <para style="q" vid="PSA 37:32">अर उस ताहीं मार देण की कोशिश करै सै।<verse eid="PSA 37:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 37:33" />यहोवा उस ताहीं उसके हाथ म्ह न्ही छोड़ैगा,</para>
  <para style="q" vid="PSA 37:33">अर जिब उसका विचार करया जावै</para>
  <para style="q" vid="PSA 37:33">फेर वो उस ताहीं दोषी न्ही ठहरावैगा।<verse eid="PSA 37:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 37:34" />यहोवा की बाट देख्दा रहै,</para>
  <para style="q" vid="PSA 37:34">अर उसकी राह पै चाल्दा रहै,</para>
  <para style="q" vid="PSA 37:34">अर वो तन्‍नै बढ़ाकै धरती का हकदार बणा देवैगा;</para>
  <para style="q" vid="PSA 37:34">जिब दुष्ट काट दिए जावैंगे, फेर तू देक्खैगा।<verse eid="PSA 37:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 37:35" />मन्‍नै दुष्ट ताहीं बड़ा ताकतवर</para>
  <para style="q" vid="PSA 37:35">अर इसा बढ़दा होया देख्या,</para>
  <para style="q" vid="PSA 37:35">जिसा कोए हरा पेड़<note caller="+" style="f"><char style="fr" closed="false">37:35 </char><char style="fq" closed="false">हरा पेड़</char><char style="ft" closed="false">लेबनान के देवदार के पेड़ की तरियां हरा पेड़</char></note></para>
  <para style="q" vid="PSA 37:35">अपणी खुद की धरती म्ह फळै सै।<verse eid="PSA 37:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 37:36" />पर जिब मै<note caller="+" style="f"><char style="fr" closed="false">37:36 </char><char style="fq" closed="false">पर जिब मै </char><char style="ft" closed="false">वो लिकड्या</char></note> ओड़ै तै लिकड्या तो</para>
  <para style="q" vid="PSA 37:36">के देख्या के वो ओड़ै था ए कोनी;</para>
  <para style="q" vid="PSA 37:36">अर मन्‍नै उस ताहीं टोह्या भी,</para>
  <para style="q" vid="PSA 37:36">पर किते न्ही पाया।<verse eid="PSA 37:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 37:37" />खरे माणस पै निगांह कर</para>
  <para style="q" vid="PSA 37:37">अर धर्मी नै देख,</para>
  <para style="q" vid="PSA 37:37">क्यूँके मेल तै रहण आळे माणस का</para>
  <para style="q" vid="PSA 37:37">अन्त आच्छा सै।<verse eid="PSA 37:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 37:38" />पर अपराध्धी एक साथ सत्यानाश करे जावैंगे;</para>
  <para style="q" vid="PSA 37:38">दुष्टां के का अन्त फळ सर्वनाश सै।<verse eid="PSA 37:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 37:39" />धर्मियाँ की मुक्‍ति यहोवा की</para>
  <para style="q" vid="PSA 37:39">ओड़ तै होवै सै;</para>
  <para style="q" vid="PSA 37:39">संकट के बखत वो उसका मजबूत गढ़ सै।<verse eid="PSA 37:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 37:40" />यहोवा उनकी मदद करकै उन ताहीं बचावै सै;</para>
  <para style="q" vid="PSA 37:40">वो उननै दुष्ट तै छुड़ाकै उनका उद्धार करै सै,</para>
  <para style="q" vid="PSA 37:40">इस करकै के उननै उस म्ह अपणी शरण ली सै।<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" sid="PSA 38" />
  <para style="s">पीड़ित माणस की प्रार्थना</para>
  <para style="d">यादगार खात्तर दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 38:1" />हे यहोवा, अपणे छो म्ह आकै मन्‍नै ना झिड़कै,</para>
  <para style="q" vid="PSA 38:1">अर जळजळाहट म्ह आकै मन्‍नै सजा ना देवै!<verse eid="PSA 38:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 38:2" />क्यूँके तेरे तीर मेरै लाग्गै सै,</para>
  <para style="q" vid="PSA 38:2">अर तेरे हाथ कै तळै दब्या सूं।<verse eid="PSA 38:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 38:3" />तेरे छो कै कारण मेरी देह म्ह कुछ भी</para>
  <para style="q" vid="PSA 38:3">ठीक-ठाक कोनी;</para>
  <para style="q" vid="PSA 38:3">अर मेरे पाप कै कारण मेरी हड्डियाँ म्ह</para>
  <para style="q" vid="PSA 38:3">भी बेचैनी सै।<verse eid="PSA 38:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 38:4" />क्यूँके मेरे अधर्म के काम्मां म्ह</para>
  <para style="q" vid="PSA 38:4">मेरा सिर डूब ग्या,</para>
  <para style="q" vid="PSA 38:4">अर वे भारी बोझ की तरियां मेरे सहण तै</para>
  <para style="q" vid="PSA 38:4">बाहर होग्ये सै।<verse eid="PSA 38:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 38:5" />मेरी मूर्खता के पाप कै कारण मेरे घाव सड़गे सै</para>
  <para style="q" vid="PSA 38:5">अर उनतै बदबू आवै सै।<verse eid="PSA 38:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 38:6" />मै घणा दुखी सूं अर झुक ग्या सूं;</para>
  <para style="q" vid="PSA 38:6">दिन भर मै शोक का पैहरावा</para>
  <para style="q" vid="PSA 38:6">पैहरकै मै घूम्मू सूं।<verse eid="PSA 38:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 38:7" />क्यूँके मै भित्तर तै जळदा रहूँ सूं,</para>
  <para style="q" vid="PSA 38:7">अर मेरी सेहत भी ठीक कोन्या।<verse eid="PSA 38:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 38:8" />मै कमजोर अर घणा टूटकै चूर होग्या सूं;</para>
  <para style="q" vid="PSA 38:8">मै अपणे मन की घबराहट तै कहराऊ सूं।<verse eid="PSA 38:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 38:9" />हे प्रभु मेरी सारी अभिलाषा तेरे स्याम्ही सै,</para>
  <para style="q" vid="PSA 38:9">अर मेरा कहराणा तेरे तै छिपा कोन्या।<verse eid="PSA 38:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 38:10" />मेरा मन घबरावै सै,</para>
  <para style="q" vid="PSA 38:10">मेरी ताकत घटती जावै सै;</para>
  <para style="q" vid="PSA 38:10">अर मेरी आँखां की रोशनी भी</para>
  <para style="q" vid="PSA 38:10">कम होगी।<verse eid="PSA 38:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 38:11" />मेरे मित्तर अर मेरे संगी</para>
  <para style="q" vid="PSA 38:11">मेरी हालत देखकै न्यारे पाटगे,</para>
  <para style="q" vid="PSA 38:11">अर मेरे कुण्बे आळे भी दूर जा खड़े होए।<verse eid="PSA 38:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 38:12" />मेरे प्राण के ग्राहक मेरै खात्तर जाळ बिछावै सै,</para>
  <para style="q" vid="PSA 38:12">अर मेरे नुकसान की योजना बणाण आळे</para>
  <para style="q" vid="PSA 38:12">बुराई की बात बोल्‍लै सै,</para>
  <para style="q" vid="PSA 38:12">अर दिन भर छळ की तरकीब सोच्‍चै सै।<verse eid="PSA 38:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 38:13" />पर मै बहरे की तरियां सुणदा ए कोनी,</para>
  <para style="q" vid="PSA 38:13">अर मै गूँगे के की तरियां मुँह कोन्या खोल्दा।<verse eid="PSA 38:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 38:14" />बल्के मै इसे माणस के बराबर सूं</para>
  <para style="q" vid="PSA 38:14">जो किमे न्ही सुणदा,</para>
  <para style="q" vid="PSA 38:14">अर जिसके मुँह तै विवाद की कोए</para>
  <para style="q" vid="PSA 38:14">बात न्ही लिकड़ती।<verse eid="PSA 38:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 38:15" />पर हे यहोवा,</para>
  <para style="q" vid="PSA 38:15">मन्‍नै तेरे पैए आस लगाई सै;</para>
  <para style="q" vid="PSA 38:15">हे प्रभु, मेरे परमेसवर,</para>
  <para style="q" vid="PSA 38:15">तू ए जवाब देगा।<verse eid="PSA 38:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 38:16" />क्यूँके मन्‍नै कह्या,</para>
  <para style="q" vid="PSA 38:16">“इसा ना हो के वे मेरे पै आनन्द करै;</para>
  <para style="q" vid="PSA 38:16">जै मेरा पैर तिसळ जावै सै,</para>
  <para style="q" vid="PSA 38:16">फेर मेरे पै अपणी बड़ाई मारे सै।”<verse eid="PSA 38:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 38:17" />क्यूँके मै तो गिरण पै सूं;</para>
  <para style="q" vid="PSA 38:17">अर मेरा शोक लगातार मेरे स्याम्ही सै।<verse eid="PSA 38:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 38:18" />इस करकै के मै तो अपणे अधर्म नै जाहिर करुँगा,</para>
  <para style="q" vid="PSA 38:18">अर अपणे पाप कै कारण दुखी रहूँगा।<verse eid="PSA 38:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 38:19" />पर मेरे दुश्मन अनगिणत सै,</para>
  <para style="q" vid="PSA 38:19">अर मेरे बैरी भोत होगे सै।<verse eid="PSA 38:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 38:20" />जो भलाई कै बदलै म्ह बुराई करै सै,</para>
  <para style="q" vid="PSA 38:20">वो भी मेरी भलाई कै पाच्छै चाल्‍लण कै</para>
  <para style="q" vid="PSA 38:20">कारण मेरे तै बिरोध करै सै।<verse eid="PSA 38:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 38:21" />हे यहोवा, मेरे ताहीं छोड़ै ना!</para>
  <para style="q" vid="PSA 38:21">हे मेरे परमेसवर, मेरे तै दूर ना हो!<verse eid="PSA 38:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 38:22" />हे यहोवा, मेरे उद्धारकर्ता,</para>
  <para style="q" vid="PSA 38:22">मेरी मदद खात्तर फुर्ती कर!<verse eid="PSA 38:22" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" sid="PSA 39" />
  <para style="s">बुद्धि अर माफी खात्तर प्रार्थना</para>
  <para style="d">यदूतून प्रधान बजाण आळे खात्तर दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 39:1" />मन्‍नै कह्या, “मै अपणी चालचलन म्ह चौकसी करुँगा,</para>
  <para style="q" vid="PSA 39:1">ताके मेरी जीभ तै पाप न्ही हो;</para>
  <para style="q" vid="PSA 39:1">जिब ताहीं बैरी मेरे स्याम्ही सै,</para>
  <para style="q" vid="PSA 39:1">तब तक मै लगाम लगाऐ अपणा मुँह बन्द करे रहूँगा।”<verse eid="PSA 39:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 39:2" />मै मौन धारण करकै गूँगा बणग्या,</para>
  <para style="q" vid="PSA 39:2">अर भलाई की ओड़ तै भी चुप्पी साधे रह्या;</para>
  <para style="q" vid="PSA 39:2">अर मेरा दर्द बढ़ ग्या,<verse eid="PSA 39:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 39:3" />मेरा मन भित्तर ए भित्तर जळण लाग रह्या था।</para>
  <para style="q" vid="PSA 39:3">सोचदे-सोचदे आग भड़क उठ्ठी;</para>
  <para style="q" vid="PSA 39:3">फेर मन्‍नै बोलणा शरु करया;<verse eid="PSA 39:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 39:4" />“हे यहोवा, इसा कर के मन्‍नै मेरे जीवन के अंत का</para>
  <para style="q" vid="PSA 39:4">बेरा लाग जावै,</para>
  <para style="q" vid="PSA 39:4">अर मेरे दिन कितणे बाकी सै;</para>
  <para style="q" vid="PSA 39:4">जिसतै मै जाण ल्यूँ के कितना अनजाण सूं!<verse eid="PSA 39:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 39:5" />देख, तन्‍नै मेरी उम्र थोड़ी-ए राक्खी सै,</para>
  <para style="q" vid="PSA 39:5">अर मेरी जिन्दगी तेरी निगांह म्ह कुछ सै ए कोनी।</para>
  <para style="q" vid="PSA 39:5">सचमुच सारे माणस कितणे ए मजबूत</para>
  <para style="q" vid="PSA 39:5">क्यूँ ना हो तोभी बेकार सै। (सेला)<verse eid="PSA 39:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 39:6" />सचमुच इन्सान छाया की तरियां चाल्‍लै-फिरै सै;</para>
  <para style="q" vid="PSA 39:6">सचमुच वे बेकार घबरावै सै;</para>
  <para style="q" vid="PSA 39:6">वो धन नै कठ्ठा तो करै सै</para>
  <para style="q" vid="PSA 39:6">पर कोन्या जाणदा के उसनै कौण लेवैगा!<verse eid="PSA 39:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 39:7" />इब हे प्रभु, मै किस बात की बाट देक्खूँ?</para>
  <para style="q" vid="PSA 39:7">मेरी आस तो तेरे पै लाग्गी सै।<verse eid="PSA 39:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 39:8" />मन्‍नै मेरे सारे अपराध्धां कै बन्धन तै छुड़ाले।</para>
  <para style="q" vid="PSA 39:8">मूर्ख मेरी बुराई न्ही करण पावै।<verse eid="PSA 39:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 39:9" />मै गूँगा बणग्या अर मुँह न्ही खोल्या;</para>
  <para style="q" vid="PSA 39:9">क्यूँके यो काम तन्‍नै ए करया सै।<verse eid="PSA 39:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 39:10" />तन्‍नै जो मुसीबत मेरै पै गेरी सै</para>
  <para style="q" vid="PSA 39:10">उसनै मेरै तै दूर करदे,</para>
  <para style="q" vid="PSA 39:10">क्यूँके मै तो तेरे हाथ की मार तै</para>
  <para style="q" vid="PSA 39:10">भस्म होया जाण लाग रह्या सूं।<verse eid="PSA 39:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 39:11" />जिब तू माणस नै अधर्म कै कारण</para>
  <para style="q" vid="PSA 39:11">डाट-डाट कै ताड़ना देवै सै;</para>
  <para style="q" vid="PSA 39:11">तब तू उसकी ताकत नै पतंगे की तरियां नाश करै सै;</para>
  <para style="q" vid="PSA 39:11">सचमुच सारे माणस बेकार म्ह अभिमान करै सै।<verse eid="PSA 39:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 39:12" />हे यहोवा, मेरी प्रार्थना सुण, अर मेरी दुहाई पै कान लगा;</para>
  <para style="q" vid="PSA 39:12">मेरा रोणा सुणकै शांत ना रहवै!</para>
  <para style="q" vid="PSA 39:12">क्यूँके मै तेरे गैल एक परदेशी की तरियां रहूँ सूं,</para>
  <para style="q" vid="PSA 39:12">अर अपणे सारे पूर्वजां की तरियां परदेशी सूं।<verse eid="PSA 39:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 39:13" />आह! इसतै पैहले की मै याड़ै तै चल्या जाऊँ</para>
  <para style="q" vid="PSA 39:13">अर ना रहूँ,</para>
  <para style="q" vid="PSA 39:13">मन्‍नै बचाले जिसतै मै प्रदीप्त जीवन पाऊँ!”<verse eid="PSA 39:13" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" sid="PSA 40" />
  <para style="s">स्तुति का एक गीत</para>
  <para style="d">प्रधान बजाण आळे खात्तर दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 40:1" />मै धीरज धरकै यहोवा की बाट देखदा रह्या;</para>
  <para style="q" vid="PSA 40:1">अर उसनै मेरी ओड़ झुककै मेरी दुहाई सुणी।<verse eid="PSA 40:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 40:2" />उसनै मेरै ताहीं सत्यानाश के खड्डे</para>
  <para style="q" vid="PSA 40:2">अर दलदल की गार म्ह तै लिकाड्या,</para>
  <para style="q" vid="PSA 40:2">अर मेरे ताहीं चट्टान पै खड्या करकै</para>
  <para style="q" vid="PSA 40:2">मेरे पैरां ताहीं मजबूत करया सै।<verse eid="PSA 40:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 40:3" />उसनै मेरै ताहीं एक नया गीत सिखाया</para>
  <para style="q" vid="PSA 40:3">जो म्हारे परमेसवर की स्तुति का सै।</para>
  <para style="q" vid="PSA 40:3">घणखरे लोग यो देक्खैंगे अर उसकी महिमा करैंगे,</para>
  <para style="q" vid="PSA 40:3">अर यहोवा पै भरोस्सा राक्खैंगे।<verse eid="PSA 40:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 40:4" />कितना धन्य सै वो माणस,</para>
  <para style="q" vid="PSA 40:4">जो यहोवा पै भरोस्सा करै सै,</para>
  <para style="q" vid="PSA 40:4">अर अभिमानियाँ<note caller="+" style="f"><char style="fr" closed="false">40:4 </char><char style="fq" closed="false">अभिमानियाँ</char><char style="ft" closed="false">मूर्तियाँ</char></note> अर झूठ्या की</para>
  <para style="q" vid="PSA 40:4">ओड़ मुड़ण आळयां की ओड़ मुँह न्ही फेरदा हो।<verse eid="PSA 40:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 40:5" />हे मेरे परमेसवर यहोवा, तन्‍नै भोत-से काम करे सै!</para>
  <para style="q" vid="PSA 40:5">जो अचम्भे काम अर कल्पना तू म्हारै खात्तर करै सै</para>
  <para style="q" vid="PSA 40:5">वे घणीए सै; तेरै बराबर कोए कोन्या!</para>
  <para style="q" vid="PSA 40:5">मै तो चाहूँ सूं के दिल खोल कै उनकी चर्चा करुँ,</para>
  <para style="q" vid="PSA 40:5">पर उनकी गिणती न्ही हो सकदी।<verse eid="PSA 40:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 40:6" />मेलबलि अर अन्‍नबलि तै तू खुश न्ही होन्दा</para>
  <para style="q" vid="PSA 40:6">तन्‍नै मेरे कान खोल्‍ले सै।</para>
  <para style="q" vid="PSA 40:6">होमबलि अर पापबलि तन्‍नै न्ही चाहिए।<verse eid="PSA 40:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 40:7" />फेर मन्‍नै कह्या,</para>
  <para style="q" vid="PSA 40:7">“देख, मै आया सूं; क्यूँके इस किताब म्ह</para>
  <para style="q" vid="PSA 40:7">मेरै बारै म्ह इसाए लिख्या होया सै।<verse eid="PSA 40:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 40:8" />हे परमेसवर,</para>
  <para style="q" vid="PSA 40:8">मै तेरी इच्छा पूरी करण तै राज्जी सूं;</para>
  <para style="q" vid="PSA 40:8">अर तेरे नियम-कायदे मेरे भित्तर म्ह बसे सै।”<verse eid="PSA 40:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 40:9" />मन्‍नै बड़ी सभा म्ह धार्मिकता के शुभ समाचार का प्रचार करया सै;</para>
  <para style="q" vid="PSA 40:9">देख, मन्‍नै अपणा मुँह बन्द न्ही करया, हे यहोवा,</para>
  <para style="q" vid="PSA 40:9">तू इस ताहीं जाणै सै।<verse eid="PSA 40:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 40:10" />मन्‍नै तेरी धार्मिकता मन म्ह ए न्ही राक्खी;</para>
  <para style="q" vid="PSA 40:10">मन्‍नै तेरी सच्‍चाई</para>
  <para style="q" vid="PSA 40:10">अर तेरे करे होए उद्धार की चर्चा करी सै;</para>
  <para style="q" vid="PSA 40:10">मन्‍नै तेरी करुणा अर सच्‍चाई बड़ी सभा तै गुप्त न्ही राक्खी।<verse eid="PSA 40:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 40:11" />हे यहोवा, तू भी अपणी बड़ी दया मेरे पै तै ना हटावै,</para>
  <para style="q" vid="PSA 40:11">तेरी करुणा अर सच्‍चाई तै हमेशा</para>
  <para style="q" vid="PSA 40:11">मेरी हिफाजत होन्दी रहवै!<verse eid="PSA 40:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 40:12" />क्यूँके मै अनगिणत बुराईयाँ तै घिरया होया सूं;</para>
  <para style="q" vid="PSA 40:12">मेरे अधर्म के काम्मां नै मेरे ताहीं पकड़ लिया सै</para>
  <para style="q" vid="PSA 40:12">अर मै निगांह न्ही ठा सकदा;</para>
  <para style="q" vid="PSA 40:12">वे गिणती म्ह मेरे सिर के बाळां तै भी घणे सै;</para>
  <para style="q" vid="PSA 40:12">इस करकै मेरा मन टूट ग्या।<verse eid="PSA 40:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 40:13" />हे यहोवा, कृपा करकै मन्‍नै छुड़ाले!</para>
  <para style="q" vid="PSA 40:13">हे यहोवा, मेरी मदद खात्तर फुर्ती कर!<verse eid="PSA 40:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 40:14" />जो मेरी जान के प्यासे सै,</para>
  <para style="q" vid="PSA 40:14">वे सारे शर्मसार हो; अर उनके मुँह काळे हों</para>
  <para style="q" vid="PSA 40:14">अर वे पाच्छै हटाए अर निरादर करे जावै</para>
  <para style="q" vid="PSA 40:14">जो मेरे नुकसान तै राज्जी होवै सै।<verse eid="PSA 40:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 40:15" />जो मेरे तै, “आहा, आहा,” कहवै सै,</para>
  <para style="q" vid="PSA 40:15">वे अपणी शर्म के मारे अचम्भित हों।<verse eid="PSA 40:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 40:16" />पर जितने तन्‍नै ढूँढ़ै सै,</para>
  <para style="q" vid="PSA 40:16">वे सब तेरे कारण खुश</para>
  <para style="q" vid="PSA 40:16">अर आनन्दित हों; जो तेरा करया होया उद्धार चाहवै सै,</para>
  <para style="q" vid="PSA 40:16">वे सदा कहन्दे रह, “यहोवा की बड़ाई हो!”<verse eid="PSA 40:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 40:17" />मै तो दीन अर दरिद्र सूं,</para>
  <para style="q" vid="PSA 40:17">तोभी प्रभु मेरी चिन्ता करै सै।</para>
  <para style="q" vid="PSA 40:17">तू मेरा मददगार अर छुड़ाण आळा सै;</para>
  <para style="q" vid="PSA 40:17">हे मेरे परमेसवर देर ना कर।<verse eid="PSA 40:17" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" sid="PSA 41" />
  <para style="s">धर्मी जन की पीड़ा अर आशीर्वाद</para>
  <para style="d">प्रधान बजाण आळे खात्तर दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 41:1" />कितना धन्य सै वो, जो कंगाल की सुधि राक्खै सै!</para>
  <para style="q" vid="PSA 41:1">मुसीबत कै दिन यहोवा उसनै बचावैगा।<verse eid="PSA 41:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 41:2" />यहोवा उसकी हिफाजत करकै उसनै जिन्दा राक्खैगा,</para>
  <para style="q" vid="PSA 41:2">अर वो धरती पै धन्य होवैगा।</para>
  <para style="q" vid="PSA 41:2">तू उसनै दुश्मनां की इच्छा पै ना छोड़।<verse eid="PSA 41:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 41:3" />जिब वो दर्द के मारे बिस्तर पै पड्या हो,</para>
  <para style="q" vid="PSA 41:3">फेर यहोवा उसनै सम्भालैगा;</para>
  <para style="q" vid="PSA 41:3">तू रोग म्ह उसके पूरे बिछोणे नै उल्ट कै ठीक करैगा।<verse eid="PSA 41:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 41:4" />मन्‍नै कह्या, “हे यहोवा, मेरे पै दया कर;</para>
  <para style="q" vid="PSA 41:4">मन्‍नै चंगा कर,</para>
  <para style="q" vid="PSA 41:4">क्यूँके मन्‍नै तो तेरे बिरुध्द पाप करया सै!”<verse eid="PSA 41:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 41:5" />मेरे दुश्मन या कहकै मेरी बुराई करै सै</para>
  <para style="q" vid="PSA 41:5">“वो कद मरैगा, अर उसका नाम कद मिटैगा?”<verse eid="PSA 41:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 41:6" />अर जिब वो मेरे तै मिलण आवै सै,</para>
  <para style="q" vid="PSA 41:6">तब वो बेकार की बात करै सै,</para>
  <para style="q" vid="PSA 41:6">जब के उसका मन अपणे भित्तर अधर्म की बात कठ्ठी करै सै;</para>
  <para style="q" vid="PSA 41:6">अर बाहर जाकै उनकी चर्चा करै सै।<verse eid="PSA 41:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 41:7" />मेरे सारे बैरी मिलकै मेरे बिरुध्द कानाफूसी करै सै;</para>
  <para style="q" vid="PSA 41:7">वे मेरे नुकसान की कल्पना करै सै।<verse eid="PSA 41:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 41:8" />वे कहवै सै के इसकै तो कोए बुरा रोग लागग्या सै;</para>
  <para style="q" vid="PSA 41:8">इब जो यो पड्या सै तो फेर कदे उठ्ठण न्ही पावैगा।<verse eid="PSA 41:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 41:9" />मेरा सबतै करीबी मित्तर जिसपै मै भरोस्सा राक्खूँ था,</para>
  <para style="q" vid="PSA 41:9">जो मेरै गैल रोट्टी खावै था,</para>
  <para style="q" vid="PSA 41:9">उसनै भी मेरे बिरुध्द लात ठाई सै।<verse eid="PSA 41:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 41:10" />पर हे यहोवा, तू मेरे पै दया करकै</para>
  <para style="q" vid="PSA 41:10">मन्‍नै ठीक कर ताके मै उन ताहीं बदला देऊँ।<verse eid="PSA 41:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 41:11" />मेरा दुश्मन जो मेरे पै जीत न्ही पांदा,</para>
  <para style="q" vid="PSA 41:11">इसतै मै जाण ग्या सूं के तू मेरे तै खुश सै।<verse eid="PSA 41:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 41:12" />अर मेरे ताहीं तो तू खराई तै सम्भाळ,</para>
  <para style="q" vid="PSA 41:12">अर सदा खात्तर अपणे स्याम्ही राक्खै सै।<verse eid="PSA 41:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 41:13" />इस्राएल का परमेसवर यहोवा</para>
  <para style="q" vid="PSA 41:13">शरुआत तै अन्तकाल तक धन्य सै</para>
  <para style="q" vid="PSA 41:13">आमीन, फेर आमीन।<verse eid="PSA 41:13" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" sid="PSA 42" />
  <para style="ms">दूसरा भाग</para>
  <para style="mr">
    <ref loc="PSA 42-72">भजन संहिता 42-72</ref></para>
  <para style="s">परमेसवर खात्तर लालसा</para>
  <para style="d">प्रधान बजाण आळे खात्तर कोरहवंशियों का मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 42:1" />जिस तरियां हिरणी नदी के पाणी खात्तर तिसाई सै,</para>
  <para style="q" vid="PSA 42:1">उस्से तरियां, हे परमेसवर, मै तेरे खात्तर तिसाया सूं।<verse eid="PSA 42:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 42:2" />जिन्दे परमेसवर, हाँ परमेसवर, का मै प्यासा सूं,</para>
  <para style="q" vid="PSA 42:2">मै कद जाकै परमेसवर नै अपणा मुँह दिखाऊँगा?<verse eid="PSA 42:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 42:3" />मै दिन अर रात अपणे आँसुआँ नै पीन्दा रहूँ सूं;</para>
  <para style="q" vid="PSA 42:3">अर लोग दिन भर मेरे तै कहवै सै,</para>
  <para style="q" vid="PSA 42:3">तेरा परमेसवर कित्त सै?<verse eid="PSA 42:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 42:4" />मै किस तरियां भीड़ कै गैल जाया करुँ था,</para>
  <para style="q" vid="PSA 42:4">मै जयजयकार अर धन्यवाद कै गैल</para>
  <para style="q" vid="PSA 42:4">त्यौहार मनाण आळी भीड़ कै बीच म्ह परमेसवर कै भवन</para>
  <para style="q" vid="PSA 42:4">म्ह धीरै-धीरै जाया करुँ था; या याद करकै मेरा जी शोकित हो जावै सै।<verse eid="PSA 42:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 42:5" />हे मेरे जी, तू क्यूँ गिरया जावै सै?</para>
  <para style="q" vid="PSA 42:5">अर तू भित्तर ए भित्तर क्यूँ व्याकुल सै?</para>
  <para style="q" vid="PSA 42:5">परमेसवर पै आस लगाये रहै;</para>
  <para style="q" vid="PSA 42:5">क्यूँके मै उसके दर्शन तै उद्धार पाकै फेर उसका धन्यवाद करुँगा।<verse eid="PSA 42:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 42:6" />हे मेरे परमेसवर; मेरा जी भित्तर तै गिरया जावै सै,</para>
  <para style="q" vid="PSA 42:6">इस करकै मै यरदन कै धोरै के देश तै अर हेर्मोन</para>
  <para style="q" vid="PSA 42:6">के पहाड़ां अर मिसगार की पहाड़ी कै उप्पर</para>
  <para style="q" vid="PSA 42:6">तै तन्‍नै याद करुँ सूं।<verse eid="PSA 42:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 42:7" />तेरी जलधाराओं का शब्द सुणकै</para>
  <para style="q" vid="PSA 42:7">पाणी नै बुलावै सै; तेरी सारी तरंगां</para>
  <para style="q" vid="PSA 42:7">अर लहरां म्ह, मै डूब ग्या सूं।<verse eid="PSA 42:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 42:8" />तोभी यहोवा दिन म्ह अपणी शक्ति</para>
  <para style="q" vid="PSA 42:8">अर करुणा दिखावैगा;</para>
  <para style="q" vid="PSA 42:8">अर रात नै भी मै उसका गीत गाऊँगा,</para>
  <para style="q" vid="PSA 42:8">अर अपणे जीवनदात्ता परमेसवर तै प्रार्थना करुँगा।<verse eid="PSA 42:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 42:9" />मै परमेसवर जो मेरी चट्टान सै कहूँगा,</para>
  <para style="q" vid="PSA 42:9">“तू मन्‍नै क्यूँ भूल ग्या?</para>
  <para style="q" vid="PSA 42:9">मै दुश्मन के जुल्म के मारे क्यूँ शोक का</para>
  <para style="q" vid="PSA 42:9">पैहरावा पैहरी चाल्‍लुँ-फिरूँ सूं?”<verse eid="PSA 42:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 42:10" />मेरे सताण आळे जो मेरी बुराई करै सै,</para>
  <para style="q" vid="PSA 42:10">मान्‍नो उसतै मेरी हाड्डी चूर-चूर हो सै,</para>
  <para style="q" vid="PSA 42:10">मान्‍नो कटार तै छिदी जावै सै,</para>
  <para style="q" vid="PSA 42:10">क्यूँके वे दिन भर मेरे तै कहन्दे रहवै सै, तेरा परमेसवर कित्त सै?<verse eid="PSA 42:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 42:11" />हे मेरे जी तू क्यूँ गिरया जावै सै?</para>
  <para style="q" vid="PSA 42:11">अर तू भित्तर ए भित्तर क्यूँ व्याकुल सै?</para>
  <para style="q" vid="PSA 42:11">परमेसवर पै भरोस्सा राख;</para>
  <para style="q" vid="PSA 42:11">क्यूँके वो मेरे मुख की चमक अर मेरा परमेसवर सै,</para>
  <para style="q" vid="PSA 42:11">मै फेर उसका धन्यवाद करुँगा।<verse eid="PSA 42:11" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" sid="PSA 43" />
  <para style="s">संकट के बखत प्रार्थना</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 43:1" />हे परमेसवर, मेरा न्याय चुका</para>
  <para style="q" vid="PSA 43:1">अर अधर्मी जात्ति तै मेरा मुकद्दमा लड़;</para>
  <para style="q" vid="PSA 43:1">मेरे ताहीं धोक्खेबाज अर कटिले माणस तै बचा।<verse eid="PSA 43:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 43:2" />क्यूँके तू मेरा सामर्थी परमेसवर सै,</para>
  <para style="q" vid="PSA 43:2">तन्‍नै मै क्यूँ छोड़ दिया?</para>
  <para style="q" vid="PSA 43:2">मै दुश्मन के जुल्म के मारे शोक का</para>
  <para style="q" vid="PSA 43:2">पैहरावा पैहरे होए क्यूँ फिरदा रहूँ?<verse eid="PSA 43:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 43:3" />अपणी ज्योति अर सच्‍चाई नै भेज;</para>
  <para style="q" vid="PSA 43:3">वे मेरी अगुवाई करै,</para>
  <para style="q" vid="PSA 43:3">वेए मेरे ताहीं तेरे पवित्र पर्वत</para>
  <para style="q" vid="PSA 43:3">पै अर तेरे निवास-स्थान म्ह पोहचावै!<verse eid="PSA 43:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 43:4" />फेर मै परमेसवर की वेदी कै धोरै जाऊँगा,</para>
  <para style="q" vid="PSA 43:4">उस परमेसवर कै धोरै जो मेरे अति</para>
  <para style="q" vid="PSA 43:4">आनन्द का कुण्ड सै; अर हे परमेसवर,</para>
  <para style="q" vid="PSA 43:4">हे मेरे परमेसवर, मै वीणा बजा-बजाकै तेरा धन्यवाद करुँगा।<verse eid="PSA 43:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 43:5" />हे मेरे जी तू क्यूँ गिरया जावै सै?</para>
  <para style="q" vid="PSA 43:5">तू म्ह ए म्ह क्यूँ व्याकुल सै?</para>
  <para style="q" vid="PSA 43:5">परमेसवर पै भरोस्सा राख, क्यूँके वो मेरे चेहरे की चमक</para>
  <para style="q" vid="PSA 43:5">अर मेरा परमेसवर सै; मै फेर उसका धन्यवाद करुँगा।<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" sid="PSA 44" />
  <para style="s">इस्राएल की शिकायत</para>
  <para style="d">प्रधान बजाण आळे खात्तर कोरहवंशियों का मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 44:1" />हे परमेसवर हमनै अपणे कान्‍नां तै सुण्या,</para>
  <para style="q" vid="PSA 44:1">म्हारे बाप-दाद्यां नै म्हारे तै जिक्र करया सै,</para>
  <para style="q" vid="PSA 44:1">के तन्‍नै उनके दिनां म्ह</para>
  <para style="q" vid="PSA 44:1">अर पुराणे बखत म्ह के-के काम करे सै।<verse eid="PSA 44:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 44:2" />तन्‍नै अपणे हाथ्थां तै जातियाँ ताहीं लिकाड़ दिया,</para>
  <para style="q" vid="PSA 44:2">अर इन ताहीं बसाया;</para>
  <para style="q" vid="PSA 44:2">तन्‍नै देश-देश के माणसां ताहीं दुख दिया,</para>
  <para style="q" vid="PSA 44:2">अर इन ताहीं चारु ओड़ फैला दिया;<verse eid="PSA 44:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 44:3" />क्यूँके वे ना तो अपणी तलवार कै</para>
  <para style="q" vid="PSA 44:3">दम पै इस देश के हकदार होए,</para>
  <para style="q" vid="PSA 44:3">अर ना अपणे बाजुआं कै दम पै पर तेरे सामर्थी हाथ तै</para>
  <para style="q" vid="PSA 44:3">अर तेरी बाजुआं अर तेरी खुश होण कारण जयवन्त होए;</para>
  <para style="q" vid="PSA 44:3">क्यूँके तू उननै चाहवै था।<verse eid="PSA 44:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 44:4" />हे परमेसवर, तू म्हारा महाराजा सै,</para>
  <para style="q" vid="PSA 44:4">तू याकूब के उद्धार<note caller="+" style="f"><char style="fr" closed="false">44:4 </char><char style="fq" closed="false">उद्धार</char><char style="ft" closed="false">जीत्तण का हुकम दे</char></note> का हुक्म देवै सै।<verse eid="PSA 44:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 44:5" />तेरी ए ताकत तै हम अपणे दुश्मनां ताहीं नीच्‍चै</para>
  <para style="q" vid="PSA 44:5">धकेल कै गिरा देवैंगे;</para>
  <para style="q" vid="PSA 44:5">तेरे नाम के प्रताप तै हम</para>
  <para style="q" vid="PSA 44:5">अपणे दुश्मनां नै रोन्दागे।<verse eid="PSA 44:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 44:6" />क्यूँके मै अपणे धनुष पै भरोस्सा न्ही राक्खूँगा,</para>
  <para style="q" vid="PSA 44:6">अर ना अपणी तलवार कै दम पै बचूँगा।<verse eid="PSA 44:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 44:7" />पर तन्‍नै ए म्हारै ताहीं दुश्मनां तै बचाया सै,</para>
  <para style="q" vid="PSA 44:7">अर म्हारे बैरियाँ ताहीं निराश</para>
  <para style="q" vid="PSA 44:7">अर शर्मसार करया सै।<verse eid="PSA 44:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 44:8" />हम परमेसवर की बड़ाई</para>
  <para style="q" vid="PSA 44:8">दिन भर करदे रहवां सां,</para>
  <para style="q" vid="PSA 44:8">अर सदा तेरे नाम का</para>
  <para style="q" vid="PSA 44:8">धन्यवाद करदे रहवांगे। (सेला)<verse eid="PSA 44:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 44:9" />तोभी तन्‍नै इब म्हारै ताहीं त्याग दिया</para>
  <para style="q" vid="PSA 44:9">अर म्हारा अनादर करया सै,</para>
  <para style="q" vid="PSA 44:9">अर म्हारी सेना कै गैल भी उनका साथ न्ही देंदा।<verse eid="PSA 44:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 44:10" />तू हमनै दुश्मनां के स्याम्ही तै हटा देवै से,</para>
  <para style="q" vid="PSA 44:10">अर म्हारै बैरी मनमान्‍नी करकै लूट मार करै सै।<verse eid="PSA 44:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 44:11" />तन्‍नै म्हारै ताहीं कसाई की भेड्डां की</para>
  <para style="q" vid="PSA 44:11">तरियां कर दिया सै,</para>
  <para style="q" vid="PSA 44:11">अर म्हारै ताहीं गैरजात्तां म्ह</para>
  <para style="q" vid="PSA 44:11">तित्तर-बितर कर दिया सै।<verse eid="PSA 44:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 44:12" />तन्‍नै अपणी प्रजा ताहीं मुफ्त बेच दिया सै,</para>
  <para style="q" vid="PSA 44:12">पर उनके मोल तै तू धनी न्ही होन्दा।<verse eid="PSA 44:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 44:13" />तू म्हारे पड़ोसियाँ तै म्हारी</para>
  <para style="q" vid="PSA 44:13">बदनामी करवावै सै,</para>
  <para style="q" vid="PSA 44:13">अर म्हारे चारु ओड़ के रहण आळे</para>
  <para style="q" vid="PSA 44:13">म्हारे तै मजाक करै सै।<verse eid="PSA 44:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 44:14" />तन्‍नै म्हारे ताहीं दुसरी जात आळयां कै बीच</para>
  <para style="q" vid="PSA 44:14">म्ह अपमान का कारण बणाया सै,</para>
  <para style="q" vid="PSA 44:14">अर देश-देश के माणस म्हारे</para>
  <para style="q" vid="PSA 44:14">कारण सिर हिलावै सै।<verse eid="PSA 44:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 44:15" />दिन भर हमनै अपमान सहणा पड़ै सै,</para>
  <para style="q" vid="PSA 44:15">अर कलंक लगाण</para>
  <para style="q" vid="PSA 44:15">अर बुराई करण आळयां के बोल तै,<verse eid="PSA 44:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 44:16" />दुश्मन अर बदला लेण आळयां के कारण,</para>
  <para style="q" vid="PSA 44:16">बुरा-भला कहण आळयां के</para>
  <para style="q" vid="PSA 44:16">अर निन्दा करण आळयां के कारण।<verse eid="PSA 44:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 44:17" />यो सारा किमे म्हारै गैल होया फेर</para>
  <para style="q" vid="PSA 44:17">भी हम तन्‍नै कोन्या भूल्‍लै,</para>
  <para style="q" vid="PSA 44:17">अर ना तेरे करार के बारै म्ह धोक्खा करया सै।<verse eid="PSA 44:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 44:18" />म्हारे मन ना तो बहकै,</para>
  <para style="q" vid="PSA 44:18">अर ना म्हारे पैर तेरी राह तै मुड़ै;<verse eid="PSA 44:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 44:19" />तोभी तन्‍नै म्हारे ताहीं गादड़ां कै बीच एक्ला छोड़ दिया,</para>
  <para style="q" vid="PSA 44:19">अर म्हारै ताहीं घोर अन्धकार म्ह लह्को दिया सै।<verse eid="PSA 44:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 44:20" />जै हम अपणे परमेसवर का नाम भूल जान्दे,</para>
  <para style="q" vid="PSA 44:20">या किसे पराये देवता की ओड़ अपणे हाथ फैलान्दे,<verse eid="PSA 44:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 44:21" />तो के परमेसवर इसका विचार कोन्या करदा?</para>
  <para style="q" vid="PSA 44:21">क्यूँके वो तो मन की गुप्त बात्तां नै जाणै सै।<verse eid="PSA 44:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 44:22" />पर हम दिन भर तेरे खात्तर</para>
  <para style="q" vid="PSA 44:22">मार दिए जावां सां,</para>
  <para style="q" vid="PSA 44:22">अर उन भेड्डां के तरियां समझे</para>
  <para style="q" vid="PSA 44:22">जावां सां जो वध होण पै सै।<verse eid="PSA 44:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 44:23" />हे प्रभु, जाग तू क्यूँ सोवै सै?</para>
  <para style="q" vid="PSA 44:23">उठ! म्हारे ताहीं सदा खात्तर त्यागै ना!<verse eid="PSA 44:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 44:24" />तू क्यूँ अपणा मुँह छिपा लेवै सै?</para>
  <para style="q" vid="PSA 44:24">अर म्हारा दुख अर सताया जाणा भूल जावै सै?<verse eid="PSA 44:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 44:25" />हम माट्टी म्ह मिलगे,</para>
  <para style="q" vid="PSA 44:25">म्हारी देह माट्टी तै चिप ग्यी सै।<verse eid="PSA 44:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 44:26" />म्हारी मदद खात्तर उठ खड्या हो।</para>
  <para style="q" vid="PSA 44:26">अर अपणी करुणा के निमित हमनै छुड़ाले।<verse eid="PSA 44:26" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" sid="PSA 45" />
  <para style="s">ब्याह का गीत</para>
  <para style="d">प्रधान बजाण आळे खात्तर शोशन्‍नीम म्ह कोरहवंशियों का मश्कील प्रेम प्रीति का गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 45:1" />मेरा मन एक सुन्दर भाव की उमंग तै</para>
  <para style="q" vid="PSA 45:1">उमड़ण लाग रह्या सै,</para>
  <para style="q" vid="PSA 45:1">जो बात मन्‍नै राजा कै बारै म्ह रची सै उस ताहीं</para>
  <para style="q" vid="PSA 45:1">सुणाऊँ सूं; मेरी जीभ एक अनुभवी लेखक की कलम सै।<verse eid="PSA 45:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 45:2" />तू माणसां की औलाद म्ह तै सारया तै सुन्दर सै;</para>
  <para style="q" vid="PSA 45:2">तेरे होठ्ठां म्ह अनुग्रह भरया सै;</para>
  <para style="q" vid="PSA 45:2">इस करकै परमेसवर नै तेरे तै सदा कै खात्तर आशीर्वाद</para>
  <para style="q" vid="PSA 45:2">दिया सै।<verse eid="PSA 45:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 45:3" />हे वीर, तू अपणी तलवार नै जो तेरा वैभव</para>
  <para style="q" vid="PSA 45:3">अर प्रताप सै अपणी कमर पै बाँध!<verse eid="PSA 45:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 45:4" />सच्‍चाई, नम्रता अर धर्म कै जरिये अपणे</para>
  <para style="q" vid="PSA 45:4">ऐश्‍वर्य अर प्रताप पै कामयाबी तै सवार हो;</para>
  <para style="q" vid="PSA 45:4">तेरा सोळा हाथ तन्‍नै भयानक काम सिखावै!<verse eid="PSA 45:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 45:5" />तेरे तीर तो तेज सै,</para>
  <para style="q" vid="PSA 45:5">तेरे स्याम्ही देश-देश के माणस झुकैंगे;</para>
  <para style="q" vid="PSA 45:5">राजा के दुश्मनां के मन उनतै छिदैंगे।<verse eid="PSA 45:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 45:6" />हे परमेसवर, तेरा सिंहासन<note caller="+" style="f"><char style="fr" closed="false">45:6 </char><char style="fq" closed="false">तेरा सिंहासन </char><char style="ft" closed="false">राज्य जो परमेसवर नै दिया सै </char></note> सदा सर्वदा बण्या</para>
  <para style="q" vid="PSA 45:6">रह्वैगा;</para>
  <para style="q" vid="PSA 45:6">तेरा राजदण्ड न्याय का सै।<verse eid="PSA 45:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 45:7" />तन्‍नै धार्मिकता तै प्रेम अर बुराई तै बैर राख्या सै।</para>
  <para style="q" vid="PSA 45:7">इस करकै परमेसवर नै हाँ, तेरे परमेसवर नै</para>
  <para style="q" vid="PSA 45:7">तेरे साथियाँ तै घणे आनन्द कै तेल</para>
  <para style="q" vid="PSA 45:7">तै तेरा अभिषेक करया सै।<verse eid="PSA 45:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 45:8" />तेरे सारे कपड़े, गन्धरस, अगर, अर तेज तै</para>
  <para style="q" vid="PSA 45:8">खसबूदार सै,</para>
  <para style="q" vid="PSA 45:8">तू हाथी दाँत के मन्दरां म्ह तारआळे बाजां कै</para>
  <para style="q" vid="PSA 45:8">कारण खुश होया सै।<verse eid="PSA 45:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 45:9" />तेरी प्रतिष्ठित बिरबानियाँ म्ह सारी राजकुमारी भी सै;</para>
  <para style="q" vid="PSA 45:9">तेरी सोळी ओड़ पटराणी, ओपीर के कुन्दन</para>
  <para style="q" vid="PSA 45:9">तै सजी खड़ी सै।<verse eid="PSA 45:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 45:10" />हे राजकुमारी सुण, अर कान लगाकै ध्यान दे;</para>
  <para style="q" vid="PSA 45:10">अपणे माणसां नै अर अपणे पिता के घर नै भूल जा;<verse eid="PSA 45:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 45:11" />अर राजा तेरे रूप की चाह करैगा।</para>
  <para style="q" vid="PSA 45:11">क्यूँके वो तेरा प्रभु सै, तू उस्से का आदर कर।<verse eid="PSA 45:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 45:12" />सोर नगर की राजकुमारी भी उपहार देण खात्तर</para>
  <para style="q" vid="PSA 45:12">ओड़ै होवैगी,</para>
  <para style="q" vid="PSA 45:12">प्रजा के धनी माणस तन्‍नै राज्जी करण का</para>
  <para style="q" vid="PSA 45:12">जतन करैगें।<verse eid="PSA 45:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 45:13" />राजकुमारी महल म्ह भोत खूबसूरत सै,</para>
  <para style="q" vid="PSA 45:13">उसके लत्यां म्ह सोन्‍ने के बुट्टे कढ़े होए सै;<verse eid="PSA 45:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 45:14" />वा बुट्टेदार लत्ते पिराह कै राजा कै धोरै</para>
  <para style="q" vid="PSA 45:14">पोहचाई जावैगी।</para>
  <para style="q" vid="PSA 45:14">जितनी कुमारी उसकी सहेली सै,</para>
  <para style="q" vid="PSA 45:14">वे उसकै पाच्छै-पाच्छै चाल्दी होई तेरे धोरै पोहचाई जावैगी।<verse eid="PSA 45:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 45:15" />वे आनन्दित अर मगन होकै पोहचाई जावैंगी,</para>
  <para style="q" vid="PSA 45:15">अर वे राजा कै महल म्ह दाखल होवैंगी।<verse eid="PSA 45:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 45:16" />तेरे पूर्वजां की जगहां तेरे बेट्टे होवैंगे;</para>
  <para style="q" vid="PSA 45:16">जिन ताहीं तू सारी धरती का प्रधान बणावैगा।<verse eid="PSA 45:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 45:17" />मै इसा करुँगा, के तेरे नाम की चर्चा पीढ़ी</para>
  <para style="q" vid="PSA 45:17">तै पीढ़ी तक होंदी रहवैगी;</para>
  <para style="q" vid="PSA 45:17">इस कारण देश-देश के लोग सदा-सदा तेरा</para>
  <para style="q" vid="PSA 45:17">धन्यवाद करदे रहवैंगे।<verse eid="PSA 45:17" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" sid="PSA 46" />
  <para style="s">परमेसवर म्हारा शरणस्‍थान</para>
  <para style="d">प्रधान बजाण आळे खात्तर कोरहवंशियों का, अलामोत की राग पै एक गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 46:1" />परमेसवर म्हारा शरणस्‍थान अर ताकत सै,</para>
  <para style="q" vid="PSA 46:1">संकट म्ह आसान्‍नी तै मिलण आळा मददगार।<verse eid="PSA 46:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 46:2" />इस कारण हमनै कोए डर कोन्या चाहे धरती</para>
  <para style="q" vid="PSA 46:2">उल्ट जावै,</para>
  <para style="q" vid="PSA 46:2">अर पहाड़ समुन्दर के बीच म्ह गेर दिए जावै;<verse eid="PSA 46:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 46:3" />चाहे समुन्दर का पाणी गरजै अर झाल उठ्ठै,</para>
  <para style="q" vid="PSA 46:3">अर पहाड़ उसकी बाढ़ तै काँप उठ्ठै। (सेला)<verse eid="PSA 46:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 46:4" />एक नदी सै जिसकै पाणी तै परमेसवर के</para>
  <para style="q" vid="PSA 46:4">नगर म्ह</para>
  <para style="q" vid="PSA 46:4">यानी परमप्रधान के पवित्र भवन नै</para>
  <para style="q" vid="PSA 46:4">आनन्द होवै सै।<verse eid="PSA 46:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 46:5" />परमेसवर उस नगर के बीच म्ह सै, वो कदे</para>
  <para style="q" vid="PSA 46:5">टळण का कोन्या;</para>
  <para style="q" vid="PSA 46:5">पौ फटते ही परमेसवर उसकी मदद करै सै।<verse eid="PSA 46:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 46:6" />जात्ति-जात्ति के माणस झल्‍ला उठे, राज्य-राज्य</para>
  <para style="q" vid="PSA 46:6">के माणस डगमगाण लाग्गे;</para>
  <para style="q" vid="PSA 46:6">वो बोल उठ्या, अर धरती पिघळगी।<verse eid="PSA 46:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 46:7" />सेनाओं का यहोवा म्हारै गैल सै;</para>
  <para style="q" vid="PSA 46:7">याकूब का परमेसवर म्हारा ऊँच्‍चा गढ़ सै। (सेला)<verse eid="PSA 46:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 46:8" />आओ, यहोवा के बड़े-बड़े काम्मां नै देक्खो,</para>
  <para style="q" vid="PSA 46:8">के उसनै धरती किस ढाळ विरान</para>
  <para style="q" vid="PSA 46:8">करी सै।<verse eid="PSA 46:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 46:9" />वो धरती की छोर तक लड़ाईयाँ नै मिटावै सै;</para>
  <para style="q" vid="PSA 46:9">वो धनुष नै तोड़ै, अर भाल्‍लै के दो टुकड़े करदे सै,</para>
  <para style="q" vid="PSA 46:9">अर लड़ाई के रथां नै आग म्ह झोंक देवै सै!<verse eid="PSA 46:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 46:10" />“चुप हो जाओ<note caller="+" style="f"><char style="fr" closed="false">46:10 </char><char style="fq" closed="false">चुप हो जाओ </char><char style="ft" closed="false">लड़ाई बन्द करो</char></note>, अर जाण ल्यो के मै ए परमेसवर सूं।</para>
  <para style="q" vid="PSA 46:10">मै जातियाँ म्ह महान सूं,</para>
  <para style="q" vid="PSA 46:10">मै पूरी दुनिया म्ह महान सूं!”<verse eid="PSA 46:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 46:11" />सेनाओं का यहोवा म्हारै गैल सै;</para>
  <para style="q" vid="PSA 46:11">याकूब का परमेसवर म्हारा ऊँच्‍चा गढ़ सै। (सेला)<verse eid="PSA 46:11" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" sid="PSA 47" />
  <para style="s">परमेसवर म्हारा राजा</para>
  <para style="d">प्रधान बजाण आळे खात्तर कोरहवंशियांँ का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 47:1" />हे देश-देश के सारे माणसों, ताड़ी बजाओ!</para>
  <para style="q" vid="PSA 47:1">जोर-जोर तै परमेसवर का जयजयकार करो!<verse eid="PSA 47:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 47:2" />क्यूँके यहोवा परमप्रधान अर भययोग्य सै,</para>
  <para style="q" vid="PSA 47:2">वो सारी धरती कै उप्पर महाराजा सै।<verse eid="PSA 47:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 47:3" />वो देश-देश के माणसां नै म्हारै स्याम्ही</para>
  <para style="q" vid="PSA 47:3">नीच्‍चा करै सै,</para>
  <para style="q" vid="PSA 47:3">अर जात्ति-जात्ति नै म्हारै कदमां तळै कर</para>
  <para style="q" vid="PSA 47:3">देवै सै।<verse eid="PSA 47:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 47:4" />वो म्हारै खात्तर बढ़िया भाग छाँट लेगा,</para>
  <para style="q" vid="PSA 47:4">जो उसके प्यारे याकूब के गर्व का कारण सै। (सेला)<verse eid="PSA 47:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 47:5" />परमेसवर जयजयकार गैल,</para>
  <para style="q" vid="PSA 47:5">यहोवा नरसिंगे की आवाज कै गैल उप्पर गया सै।<verse eid="PSA 47:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 47:6" />परमेसवर का भजन गाओ, भजन गाओ!</para>
  <para style="q" vid="PSA 47:6">म्हारे महाराजा का भजन गाओ, भजन गाओ!<verse eid="PSA 47:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 47:7" />क्यूँके परमेसवर सारी धरती का राजा सै,</para>
  <para style="q" vid="PSA 47:7">समझकै गैल बुद्धि तै भजन गाओ।<verse eid="PSA 47:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 47:8" />परमेसवर जात्ति-जात्ति पै राज करै सै;</para>
  <para style="q" vid="PSA 47:8">परमेसवर अपणे पवित्र सिंहासन पै</para>
  <para style="q" vid="PSA 47:8">विराजमान सै।<verse eid="PSA 47:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 47:9" />राज्य-राज्य के रईस अब्राहम के परमेसवर</para>
  <para style="q" vid="PSA 47:9">की प्रजा होण खात्तर कठ्ठे होये सै।</para>
  <para style="q" vid="PSA 47:9">क्यूँके सारी ढालें परमेसवर कै बस म्ह सै,</para>
  <para style="q" vid="PSA 47:9">वो सब तै ऊँच्‍चा सै!<verse eid="PSA 47:9" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" sid="PSA 48" />
  <para style="s">सिय्योन म्ह परमेसवर की महिमा</para>
  <para style="d">गीत। कोरहवंशियों का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 48:1" />म्हारे परमेसवर के नगर म्ह, अर अपणे</para>
  <para style="q" vid="PSA 48:1">पवित्र पर्वत पै</para>
  <para style="q" vid="PSA 48:1">यहोवा महान अर घणा बड़ाई के योग्य सै! (सेला)<verse eid="PSA 48:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 48:2" />सिय्योन पर्वत ऊँचाई म्ह सुन्दर अर सारी</para>
  <para style="q" vid="PSA 48:2">धरती कै आनन्द का कारण सै,</para>
  <para style="q" vid="PSA 48:2">राजाधिराज का नगर उत्तरी सिरे पै सै।<verse eid="PSA 48:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 48:3" />उस नगर के महल्‍लां म्ह परमेसवर ऊँच्‍चा गढ़ मान्या</para>
  <para style="q" vid="PSA 48:3">गया सै।<verse eid="PSA 48:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 48:4" />क्यूँके देक्खो, भोत-से राजा कठ्ठे होए,</para>
  <para style="q" vid="PSA 48:4">वे एक साथ हमला करण खात्तर आग्गै बढ़े।<verse eid="PSA 48:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 48:5" />उननै आप्पे देख्या,</para>
  <para style="q" vid="PSA 48:5">तो वे अचम्भित होग्ये, अर डरकै भाज ग्ये।<verse eid="PSA 48:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 48:6" />ओड़ै कँपकँपी नै उन ताहीं आ पकड्या,</para>
  <para style="q" vid="PSA 48:6">अर जच्‍चा की तरियां उनकै दर्द होण लाग्या।<verse eid="PSA 48:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 48:7" />तू पूर्वी हवा तै</para>
  <para style="q" vid="PSA 48:7">तर्शीश नगर के जहाजां नै तोड़दे सै।<verse eid="PSA 48:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 48:8" />सेनाओं के यहोवा के नगर म्ह,</para>
  <para style="q" vid="PSA 48:8">अपणे परमेसवर कै नगर म्ह, जिसा हमनै</para>
  <para style="q" vid="PSA 48:8">सुण्या था, उसाए देख्या भी सै;</para>
  <para style="q" vid="PSA 48:8">परमेसवर उसनै सदा सुरक्षित राक्खैगा।<verse eid="PSA 48:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 48:9" />हे परमेसवर हमनै तेरे मन्दर कै भित्तर</para>
  <para style="q" vid="PSA 48:9">तेरी करुणा पै ध्यान करया सै;<verse eid="PSA 48:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 48:10" />हे परमेसवर तेरे नाम के योग्य</para>
  <para style="q" vid="PSA 48:10">तेरी बड़ाई धरती की छोर तक हो सै।</para>
  <para style="q" vid="PSA 48:10">तेरा सोळा हाथ धार्मिकता तै भरया सै;<verse eid="PSA 48:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 48:11" />तेरे न्याय के काम्मां कै कारण</para>
  <para style="q" vid="PSA 48:11">सिय्योन पर्वत खुशी मनावै,</para>
  <para style="q" vid="PSA 48:11">अर यहूदा के नगरो<note caller="+" style="f"><char style="fr" closed="false">48:11 </char><char style="fq" closed="false">नगरो </char><char style="ft" closed="false">बेटियाँ</char></note> की बेट्टियो मगन हो!<verse eid="PSA 48:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 48:12" />सिय्योन के चारु ओड़ चाल्‍लों, अर उसका</para>
  <para style="q" vid="PSA 48:12">चक्‍कर लगाओ,</para>
  <para style="q" vid="PSA 48:12">उसके गुम्मटां नै गिण ल्यो,<verse eid="PSA 48:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 48:13" />उसकी मजबूत दीवारां पै निगांह करो, उसके</para>
  <para style="q" vid="PSA 48:13">महल्‍लां नै ध्यान तै देक्खो;</para>
  <para style="q" vid="PSA 48:13">जिसतै थम आण आळी पीढ़ी नै</para>
  <para style="q" vid="PSA 48:13">इसकै बारें म्ह बता सकों।<verse eid="PSA 48:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 48:14" />क्यूँके वो परमेसवर सदा-सदा म्हारा</para>
  <para style="q" vid="PSA 48:14">परमेसवर सै,</para>
  <para style="q" vid="PSA 48:14">वो मौत तक म्हारी अगुवाई करैगा।<verse eid="PSA 48:14" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" sid="PSA 49" />
  <para style="s">धन पै भरोस्सा राक्खण की बेकूफी</para>
  <para style="d">प्रधान बजाण आळे खात्तर कोरहवंशियों का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 49:1" />हे देश-देश के सारे माणसों सुणो!</para>
  <para style="q" vid="PSA 49:1">हे दुनिया म्ह रहण आळेयो, कान लगाओ!<verse eid="PSA 49:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 49:2" />के ऊँच, के नीच,</para>
  <para style="q" vid="PSA 49:2">के अमीर अर गरीब, थम सारे कान लगाओ!<verse eid="PSA 49:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 49:3" />मेरै मुँह तै बुद्धि की बात लिकड़ैगी;</para>
  <para style="q" vid="PSA 49:3">अर मेरे मन की बात समझ की होंगी।<verse eid="PSA 49:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 49:4" />मै नीतिवचन की ओड़ अपणे कान लगाऊँगा,</para>
  <para style="q" vid="PSA 49:4">मै वीणा बजान्दे होए अपणी गुप्त बात</para>
  <para style="q" vid="PSA 49:4">स्याम्ही ल्याऊँगा।<verse eid="PSA 49:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 49:5" />संकट कै दिनां म्ह मै क्यूँ डरुँ जिब अधर्म मन्‍नै आ घेरै?<verse eid="PSA 49:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 49:6" />जो अपणी सम्पत्ति पै भरोस्सा राक्खै सै,</para>
  <para style="q" vid="PSA 49:6">अर अपणे घणे धन कै कारण घणे फुल्‍लै सै,<verse eid="PSA 49:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 49:7" />उन म्ह तै कोए भी अपणे-आपनै<note caller="+" style="f"><char style="fr" closed="false">49:7 </char><char style="fq" closed="false">अपणे-आपनै</char><char style="ft" closed="false">भाई</char></note> किसे तरियां</para>
  <para style="q" vid="PSA 49:7">छुड़ा न्ही सकैगा;</para>
  <para style="q" vid="PSA 49:7">अर न परमेसवर नै उसकै बदलै प्रायश्चित</para>
  <para style="q" vid="PSA 49:7">म्ह कुछ दे सकै सै<verse eid="PSA 49:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 49:8" />क्यूँके उनके प्राण की छुड़ौती भारी सै</para>
  <para style="q" vid="PSA 49:8">वो अन्त ताहीं कदे भी चुका न्ही सकदा<verse eid="PSA 49:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 49:9" />कोए इसा कोन्या जो सदा खात्तर जिन्दा रहवै,</para>
  <para style="q" vid="PSA 49:9">अर कब्र नै ना देक्खै।<verse eid="PSA 49:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 49:10" />क्यूँके देखण म्ह आवै सै के अकलमंद भी मरै सै,</para>
  <para style="q" vid="PSA 49:10">अर मूर्ख भी अर पशु सरीखे माणस भी दोन्‍नु नाश होवै सै,</para>
  <para style="q" vid="PSA 49:10">अर अपणी सम्पत्ति दुसरयां खात्तर छोड़ जावै सै।<verse eid="PSA 49:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 49:11" />वे मन ए मन म्ह या सोच्‍चै सै के उनका घर</para>
  <para style="q" vid="PSA 49:11">सदा बण्या रह्वैगा,</para>
  <para style="q" vid="PSA 49:11">अर उनके निवास पीढ़ी तै पीढ़ी ताहीं बणै रहवैंगे,</para>
  <para style="q" vid="PSA 49:11">इस करकै वे अपणी-अपणी जगहां का नाम अपणे नाम पै राक्खै सै।<verse eid="PSA 49:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 49:12" />पर माणस मान-सम्मान पाकै भी टिक्या न्ही रहन्दा,</para>
  <para style="q" vid="PSA 49:12">वो पशुआं की तरियां हो सै, जो मर मिटै सै।<verse eid="PSA 49:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 49:13" />उनकी या चाल उनकी मूर्खता सै,</para>
  <para style="q" vid="PSA 49:13">तोभी उनके मरण कै बाद लोग उनकी बात्तां तै</para>
  <para style="q" vid="PSA 49:13">खुश होवै सै।<verse eid="PSA 49:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 49:14" />वे अधोलोक की भेड़-बकरियाँ की तरियां ठहराये गये सै;</para>
  <para style="q" vid="PSA 49:14">मौत उनका पाळी ठहरैगा;</para>
  <para style="q" vid="PSA 49:14">अर तड़कै ए तड़कै<note caller="+" style="f"><char style="fr" closed="false">49:14 </char><char style="fq" closed="false">तड़कै ए तड़कै </char><char style="ft" closed="false">अधोलोक म्ह चले जावैंगे</char></note> धर्मी लोग उनपै शासन करैगें;</para>
  <para style="q" vid="PSA 49:14">अर उनका सुन्दर रूप अधोलोक का निवाळा हो जावैगा अर उनका कोए आधार न्ही रह्वैगा।<verse eid="PSA 49:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 49:15" />पर परमेसवर मेरा प्राण अधोलोक के</para>
  <para style="q" vid="PSA 49:15">बस म्ह तै छुड़ा लेगा,</para>
  <para style="q" vid="PSA 49:15">क्यूँके वोए मन्‍नै अपणा लेगा।<verse eid="PSA 49:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 49:16" />जिब कोए धनी हो जावै अर उसके घर का</para>
  <para style="q" vid="PSA 49:16">वैभव<note caller="+" style="f"><char style="fr" closed="false">49:16 </char><char style="fq" closed="false">वैभव </char><char style="ft" closed="false">धन-दौलत</char></note> बढ़ जावै,</para>
  <para style="q" vid="PSA 49:16">तब तू उसका भय ना मानिये,<verse eid="PSA 49:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 49:17" />क्यूँके वो मरकै भी कुछ साथ न्ही ले जावैंगा;</para>
  <para style="q" vid="PSA 49:17">ना उसकी सम्पत्ति उसकै गैल उसकी कब्र म्ह जावैगी।<verse eid="PSA 49:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 49:18" />चाहे वो जिन्दे जी अपणे-आपनै धन्य कहन्दा रहवै।</para>
  <para style="q" vid="PSA 49:18">जिब तू अपणी भलाई करै सै, तब वे माणस</para>
  <para style="q" vid="PSA 49:18">तेरी तारीफ करै सै।<verse eid="PSA 49:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 49:19" />तोभी वो अपणे पूर्वजां के समाज म्ह मिलाया जावैगा,</para>
  <para style="q" vid="PSA 49:19">जो कदे चाँदणा कोन्या देक्खैंगे।<verse eid="PSA 49:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 49:20" />माणस चाहे प्रतिष्ठित भी हो पर जै वे</para>
  <para style="q" vid="PSA 49:20">समझ न्ही राखदे, तो</para>
  <para style="q" vid="PSA 49:20">वे पशु की तरियां सै, जो मर मिटै सै।<verse eid="PSA 49:20" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" sid="PSA 50" />
  <para style="s">परमेसवर धर्मी न्यायाधीश</para>
  <para style="d">आसाप का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 50:1" />सर्वशक्तिमान परमेसवर यहोवा नै कह्या सै,</para>
  <para style="q" vid="PSA 50:1">अर उदयाचल तै लेकै अस्ताचल तक धरती</para>
  <para style="q" vid="PSA 50:1">के माणसां ताहीं बुलाया सै।<verse eid="PSA 50:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 50:2" />सिय्योन तै जो परम सुन्दर सै,</para>
  <para style="q" vid="PSA 50:2">परमेसवर नै अपणा तेज दिखाया सै।<verse eid="PSA 50:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 50:3" />म्हारा परमेसवर आवैगा अर वो चुप न्ही रह्वैगा,</para>
  <para style="q" vid="PSA 50:3">आग उसकै आग्गै-आग्गै भस्म करदी जावैगी;</para>
  <para style="q" vid="PSA 50:3">अर उसकै चारु ओड़ बड़ी आँधी चाल्‍लैगी।<verse eid="PSA 50:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 50:4" />वो अपणी प्रजा का न्याय करण खात्तर</para>
  <para style="q" vid="PSA 50:4">उप्पर के अकास नै अर धरती नै भी पुकारैगा;<verse eid="PSA 50:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 50:5" />“मेरे भगतां ताहीं मेरै धोरै कठ्ठा करो,</para>
  <para style="q" vid="PSA 50:5">जिननै बलिदान चढ़ाकै मेरै तै करार करया सै!”<verse eid="PSA 50:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 50:6" />अर सुर्ग उसके धर्मी होण का प्रचार करैगा</para>
  <para style="q" vid="PSA 50:6">क्यूँके परमेसवर तो आप ए न्यायी सै। (सेला)<verse eid="PSA 50:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 50:7" />“हे मेरी प्रजा, सुण, मै बोल्‍लू सूं,</para>
  <para style="q" vid="PSA 50:7">अर हे इस्राएल, मै तेरे बारें म्ह गवाही देऊँ सूं।</para>
  <para style="q" vid="PSA 50:7">परमेसवर तेरा परमेसवर मै ए सूं।<verse eid="PSA 50:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 50:8" />मै तेरे पै तेरे मेलबलियां कै बारें म्ह दोष कोन्या लगान्दा,</para>
  <para style="q" vid="PSA 50:8">तेरे होमबलि तो सदा मेरै खात्तर चढ़ै सै।<verse eid="PSA 50:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 50:9" />मै ना तो तेरे घर तै बळध</para>
  <para style="q" vid="PSA 50:9">ना तेरे बाड़े तै तेरे बकरे ल्यूँगा।<verse eid="PSA 50:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 50:10" />क्यूँके बण के सारे जीव-जन्तु</para>
  <para style="q" vid="PSA 50:10">अर हजारों पहाड़ी जानवर मेरे ए तो सै।<verse eid="PSA 50:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 50:11" />पहाड़ां<note caller="+" style="f"><char style="fr" closed="false">50:11 </char><char style="fq" closed="false">पहाड़ां </char><char style="ft" closed="false">आसमान</char></note> के सारे पंछियाँ नै मै जाणु सूं,</para>
  <para style="q" vid="PSA 50:11">अर मैदानां म्ह चाल्‍लण-फिरण आळे जानवर मेरे ए तो सै।<verse eid="PSA 50:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 50:12" />जै मै भूक्खा होंदा तो तेरे तै न्ही कहन्दा;</para>
  <para style="q" vid="PSA 50:12">क्यूँके दुनिया अर उस म्ह जो कुछ सै वो मेरा सै।<verse eid="PSA 50:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 50:13" />के मै बळध का माँस खाऊँ,</para>
  <para style="q" vid="PSA 50:13">या बकरयां का लहू पीऊँ?<verse eid="PSA 50:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 50:14" />परमेसवर नै धन्यवाद की ए भेंट चढ़ा,</para>
  <para style="q" vid="PSA 50:14">अर परमप्रधान खात्तर अपणी मन्‍नत पूरी कर;<verse eid="PSA 50:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 50:15" />अर संकट कै दिन मन्‍नै पुकार;</para>
  <para style="q" vid="PSA 50:15">मै तन्‍नै छुड़ाऊँगा, अर तू मेरी महिमा करण पावैगा।”<verse eid="PSA 50:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 50:16" />पर दुष्ट तै परमेसवर कहवै सै:</para>
  <para style="q" vid="PSA 50:16">“तन्‍नै मेरी विधियाँ का जिक्र करण तै के काम?</para>
  <para style="q" vid="PSA 50:16">तू मेरी वाचा की जिक्र क्यूँ करै सै?<verse eid="PSA 50:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 50:17" />तू तो शिक्षा तै बैर करै सै,</para>
  <para style="q" vid="PSA 50:17">अर मेरे वचनां नै तुच्छ जाणै सै।<verse eid="PSA 50:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 50:18" />जद तन्‍नै चोर कान्ही देख्या, तो तू उसकी संगत तै खुश होया;</para>
  <para style="q" vid="PSA 50:18">अर उनकै गैल जारी म्ह भाग्गी होया।<verse eid="PSA 50:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 50:19" />तन्‍नै अपणा मुँह बुराई करण खात्तर खोल्या,</para>
  <para style="q" vid="PSA 50:19">अर तेरी जीभ धोक्खे की बात गढ़ै सै।<verse eid="PSA 50:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 50:20" />तू बैठा होया अपणे भाई कै बिरुध्द बोल्‍लै;</para>
  <para style="q" vid="PSA 50:20">अर अपणे सगे भाई की बुराई करै सै।<verse eid="PSA 50:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 50:21" />यो काम तन्‍नै करया, अर मै चुप रह्या;</para>
  <para style="q" vid="PSA 50:21">इस करकै तन्‍नै समझ लिया के परमेसवर बिल्कुल मेरी तरियां सै।</para>
  <para style="q" vid="PSA 50:21">पर मै तन्‍नै समझाऊँगा, अर तेरी आँखां कै</para>
  <para style="q" vid="PSA 50:21">स्याम्ही सब कुछ न्यारा-न्यारा दिखाऊँगा।<verse eid="PSA 50:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 50:22" />हे परमेसवर नै भूल्‍लण आळेयो या बात भली-भाँति समझ ल्यो,</para>
  <para style="q" vid="PSA 50:22">कदे इसा ना हो के मै थमनै टुकड़े-टुकड़े कर देऊँ,</para>
  <para style="q" vid="PSA 50:22">अर थारा कोए भी छुड़ाण आळा ना रहवै!<verse eid="PSA 50:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 50:23" />धन्यवाद की भेंट चढ़ाण आळा मेरी महिमा करै सै;</para>
  <para style="q" vid="PSA 50:23">अर जो अपणा चरित्र बढ़िया राक्खै सै;</para>
  <para style="q" vid="PSA 50:23">मै उसनै परमेसवर का करया होया उद्धार दिखाऊँगा!”<verse eid="PSA 50:23" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" sid="PSA 51" />
  <para style="s">पाप की माफी खात्तर प्रार्थना</para>
  <para style="d">प्रधान बजाण आळे खात्तर दाऊद का भजन जिब नातान नबी उसकै धोरै इस करकै आया के वो बतशेबा के धोरै गया था</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 51:1" />हे परमेसवर, अपणी करुणा कै मुताबिक मेरे पै अनुग्रह कर;</para>
  <para style="q" vid="PSA 51:1">अपणी बड़ी दया के मुताबिक मेरे अपराध्धां ताहीं मिटा दे।<verse eid="PSA 51:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 51:2" />मन्‍नै भली-भाँति धोकै मेरा अधर्म दूर कर,</para>
  <para style="q" vid="PSA 51:2">अर मेरे पाप छुड़ाकै मन्‍नै शुद्ध कर!<verse eid="PSA 51:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 51:3" />मै तो अपणे अपराध्धां नै जाणु सूं,</para>
  <para style="q" vid="PSA 51:3">अर मेरा पाप हमेशा मेरी निगांह म्ह रही जा सै।<verse eid="PSA 51:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 51:4" />मन्‍नै सिर्फ तेरैए बिरुध्द पाप करया,</para>
  <para style="q" vid="PSA 51:4">अर तेरी निगांह म्ह जो बुरा सै, वोए करया सै,</para>
  <para style="q" vid="PSA 51:4">ताके तू बोल्‍लण म्ह धर्मी</para>
  <para style="q" vid="PSA 51:4">अर न्याय करण म्ह निष्कलंक ठहरै।<verse eid="PSA 51:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 51:5" />देख, मै अधर्म कै गैल पैदा होया,</para>
  <para style="q" vid="PSA 51:5">अर जिस दिन तै मै अपणी माँ कै गर्भ म्ह पड्या उस्से दिन तै मै पापी सूं।<verse eid="PSA 51:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 51:6" />देख, तू मन की सच्‍चाई तै खुश होवै सै;</para>
  <para style="q" vid="PSA 51:6">अर मन्‍नै मेरे मन म्ह ए ज्ञान देवैगा।<verse eid="PSA 51:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 51:7" />पाप तै मन्‍नै लिकाड़<note caller="+" style="f"><char style="fr" closed="false">51:7 </char><char style="fq" closed="false">पाप तै मन्‍नै लिकाड़ </char><char style="ft" closed="false">जूफा तै मन्‍नै शुद्ध कर </char></note> तो मै पवित्र हो जाऊँगा;</para>
  <para style="q" vid="PSA 51:7">अर मन्‍नै जूफा तै धो अर मै बर्फ तै भी घणा सफेद बणुगाँ।<verse eid="PSA 51:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 51:8" />मन्‍नै खुशी की अर आनन्द की बात सुणा,</para>
  <para style="q" vid="PSA 51:8">जिसतै जो हाड्डी तन्‍नै तोड़ दी सै, वे</para>
  <para style="q" vid="PSA 51:8">मगन हो जावै।<verse eid="PSA 51:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 51:9" />अपणा मुँह मेरे पापां की ओड़ तै फेर ले,</para>
  <para style="q" vid="PSA 51:9">अर मेरे सारे अधर्म के काम्मां नै मिटा दे।<verse eid="PSA 51:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 51:10" />हे परमेसवर, मेरै भित्तर शुद्ध मन पैदा कर,</para>
  <para style="q" vid="PSA 51:10">अर मेरै भित्तर मजबूत आत्मा नये सिरे तै भर दे।<verse eid="PSA 51:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 51:11" />मन्‍नै अपणे स्याम्ही तै दूर ना करै,</para>
  <para style="q" vid="PSA 51:11">अर अपणी पवित्र आत्मा तै मन्‍नै दूर ना करै।<verse eid="PSA 51:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 51:12" />अपणे करे होए उद्धार की खुशी फेर तै मन्‍नै दे दे,</para>
  <para style="q" vid="PSA 51:12">अर उदारता का आत्मा देकै मन्‍नै सम्भाळ।<verse eid="PSA 51:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 51:13" />फेर मै अपराधियाँ नै तेरी राह पै चालणा सिखाऊँगा,</para>
  <para style="q" vid="PSA 51:13">अर पापी तेरी ओड़ आवैंगे।<verse eid="PSA 51:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 51:14" />हे परमेसवर, हे मेरे उद्धारकर्ता परमेसवर,</para>
  <para style="q" vid="PSA 51:14">मन्‍नै हत्या के अपराध तै छुड़ाले,</para>
  <para style="q" vid="PSA 51:14">फेर मै तेरे धार्मिकता का जयजयकार करण पाऊँगा।<verse eid="PSA 51:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 51:15" />हे प्रभु, मेरा मुँह खोल दे</para>
  <para style="q" vid="PSA 51:15">फेर मै तेरा गुणगान कर सकूँगा।<verse eid="PSA 51:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 51:16" />क्यूँके तू बलि तै राज्जी कोन्या होन्दा,</para>
  <para style="q" vid="PSA 51:16">न्ही तो मै देंदा;</para>
  <para style="q" vid="PSA 51:16">होमबलि तै भी तू राज्जी कोन्या होन्दा।<verse eid="PSA 51:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 51:17" />टूट्या मन परमेसवर के योग्य बलिदान सै<note caller="+" style="f"><char style="fr" closed="false">51:17 </char><char style="fq" closed="false">टूट्या मन परमेसवर के योग्य बलिदान सै </char><char style="ft" closed="false">हे परमेसवर मेरा बलिदान योए सै</char></note>;</para>
  <para style="q" vid="PSA 51:17">हे परमेसवर, तू टूट्टे अर पईसे होए मन ताहीं</para>
  <para style="q" vid="PSA 51:17">तुच्छ कोनी जाणदा।<verse eid="PSA 51:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 51:18" />राज्जी होकै सिय्योन की भलाई कर,</para>
  <para style="q" vid="PSA 51:18">यरुशलेम की चारदीवारी नै तू बणा।<verse eid="PSA 51:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 51:19" />फेर तू धर्म के बलिदान तै यानी सारे</para>
  <para style="q" vid="PSA 51:19">पशुआं के होमबलि तै खुश होवैगा;</para>
  <para style="q" vid="PSA 51:19">फेर लोग तेरी वेदी पै पवित्र बलिदान चढ़ावैंगे।<verse eid="PSA 51:19" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" sid="PSA 52" />
  <para style="s">दुष्ट का अन्त अर धर्मी की शान्ति</para>
  <para style="d">प्रधान बजाण आळे खात्तर मश्कील पै दाऊद का भजन जिब दोएग एदोमी नै शाऊल ताहीं बताया के दाऊद अहीमेलेक कै घरां गया था</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 52:1" />हे वीर तू बुराई करण<note caller="+" style="f"><char style="fr" closed="false">52:1 </char><char style="fq" closed="false">बुराई करण </char><char style="ft" closed="false">धर्मी माणसां के बिरुध्द म्ह</char></note> पै क्यूँ घमण्ड करै सै?</para>
  <para style="q" vid="PSA 52:1">परमेसवर की करुणा तो सदा की सै।<verse eid="PSA 52:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 52:2" />तेरी जीभ सिर्फ दुष्टता गढ़ै सै;</para>
  <para style="q" vid="PSA 52:2">धार लाग्गे होए उस्तरे की तरियां वो छळ</para>
  <para style="q" vid="PSA 52:2">का काम करै सै।<verse eid="PSA 52:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 52:3" />तू भलाई तै बढ़कै बुराई म्ह</para>
  <para style="q" vid="PSA 52:3">अर धर्म की बात तै बढ़कै झूठ तै प्यार राक्खै सै। (सेला)<verse eid="PSA 52:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 52:4" />हे छळी जीभ,</para>
  <para style="q" vid="PSA 52:4">तू सब नाश करण आळी बात्तां तै राज्जी रहवै सै।<verse eid="PSA 52:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 52:5" />जरुर परमेसवर तन्‍नै सदा खात्तर नाश कर देगा;</para>
  <para style="q" vid="PSA 52:5">वो तन्‍नै पकड़कै तेरे डेरे तै लिकाड़ देगा;</para>
  <para style="q" vid="PSA 52:5">अर जिन्दयां के लोक तै तन्‍नै उखाड़ देगा। (सेला)<verse eid="PSA 52:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 52:6" />फेर धर्मी माणस इस घटना नै देखकै डर जावैंगे,</para>
  <para style="q" vid="PSA 52:6">अर या कहकै उसपै हास्सैंगे,<verse eid="PSA 52:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 52:7" />“देक्खो, यो वोए माणस सै जिसनै परमेसवर ताहीं</para>
  <para style="q" vid="PSA 52:7">अपणी शरण न्ही मान्या,</para>
  <para style="q" vid="PSA 52:7">पर अपणे धन कै भरोस्से रहवै था,</para>
  <para style="q" vid="PSA 52:7">अर खुद नै दुष्टता म्ह मजबूत करदा रह्या!<note caller="+" style="f"><char style="fr" closed="false">52:7 </char><char style="fq" closed="false">खुद नै दुष्टता म्ह मजबूत करदा रह्या! </char><char style="ft" closed="false">खुद नै अपणी धन-दौलत म्ह ढुंढता रहया</char></note>”<verse eid="PSA 52:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 52:8" />पर मै तो परमेसवर के घर म्ह हरे जैतून के</para>
  <para style="q" vid="PSA 52:8">दरखतां कै समान सूं।</para>
  <para style="q" vid="PSA 52:8">मन्‍नै परमेसवर की करुणा पै सदा सर्वदा कै</para>
  <para style="q" vid="PSA 52:8">खात्तर भरोस्सा राख्या सै।<verse eid="PSA 52:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 52:9" />मै तेरा धन्यवाद सदा करदा रहूँगा, क्यूँके</para>
  <para style="q" vid="PSA 52:9">तन्‍नै ए यो काम करया सै।</para>
  <para style="q" vid="PSA 52:9">मै तेरे नाम पै आस राक्खूँ सूं, क्यूँके</para>
  <para style="q" vid="PSA 52:9">यो तेरे पवित्र भगतां कै स्याम्ही बड़ाई करुँगा<note caller="+" style="f"><char style="fr" closed="false">52:9 </char><char style="fq" closed="false">बड़ाई करुँगा </char><char style="ft" closed="false">मै धर्मी लोग्गां की उपस्थिति मै तेरे नाम की प्रशंसा करुँगा</char></note>।<verse eid="PSA 52:9" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" sid="PSA 53" />
  <para style="s">माणस की बेकूफी अर दुष्टता</para>
  <para style="d">प्रधान बजाण आळे खात्तर महलत की राग पै दाऊद का मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 53:1" />बेकूफ नै अपणे मन म्ह कह्या सै, “कोए परमेसवर सै ही कोन्या।”</para>
  <para style="q" vid="PSA 53:1">वे बिगड़ गए, उननै बेशर्मी के घिनोणे काम करे सै;</para>
  <para style="q" vid="PSA 53:1">कोए धर्मी कोन्या।<verse eid="PSA 53:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 53:2" />परमेसवर नै सुर्ग तै माणसां के उप्पर निगांह करी</para>
  <para style="q" vid="PSA 53:2">ताके देक्खे की कोए बुद्धि तै चलण आळा</para>
  <para style="q" vid="PSA 53:2">या परमेसवर नै पूच्छण आळा सै के न्ही।<verse eid="PSA 53:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 53:3" />वे सारे के सारे हटगे; सारे एकदम बिगड़गे;</para>
  <para style="q" vid="PSA 53:3">कोए सुकर्मी न्ही, एक भी न्ही।<verse eid="PSA 53:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 53:4" />के उन सारे अनर्थकारियाँ नै कुछ भी ज्ञान कोनी,</para>
  <para style="q" vid="PSA 53:4">जो मेरे माणसां नै लूट कै खावै सै<note caller="+" style="f"><char style="fr" closed="false">53:4 </char><char style="fq" closed="false">जो मेरे माणसां नै लूट कै खावै सै </char><char style="ft" closed="false">जो मेरे माणसां नै रोट्टी की तरियां खावै सै</char></note></para>
  <para style="q" vid="PSA 53:4">पर परमेसवर का नाम न्ही लेंदे?<verse eid="PSA 53:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 53:5" />ओड़ै उनपै डर छाग्या जित्त डर का कोए कारण भी ना था।</para>
  <para style="q" vid="PSA 53:5">क्यूँके यहोवा अधर्मी माणसां की हाड्डियाँ नै जो तेरे बिरुध्द छावणी डाले पड़े थे, आस्सै-पास्सै कर देवैगा,</para>
  <para style="q" vid="PSA 53:5">वे माणस आप्पे शर्मिन्दा होवैगें क्यूँके</para>
  <para style="q" vid="PSA 53:5">परमेसवर नै उन ताहीं त्याग दिया सै।<verse eid="PSA 53:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 53:6" />भला होन्दा के इस्राएल का उद्धार सिय्योन तै लिकड़दा!</para>
  <para style="q" vid="PSA 53:6">जिब परमेसवर अपणी प्रजा नै गुलामी तै उल्टा ले आवैगा।</para>
  <para style="q" vid="PSA 53:6">फेर याकूब मगन अर इस्राएल खुश होवैगा।<verse eid="PSA 53:6" /></para>
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" sid="PSA 54" />
  <para style="s">उद्धार खात्तर प्रार्थना</para>
  <para style="d">प्रधान बजाण आळे खात्तर, दाऊद का तारकले बाज्यां कै गैल मश्कील जिब जीपियों नै आकै शाऊल तै कह्या, “के दाऊद म्हारे बीच म्ह छिप्या न्ही रहन्दा?”</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 54:1" />हे परमेसवर अपणे नाम के जरिये मेरा उद्धार कर,</para>
  <para style="q" vid="PSA 54:1">अर अपणे पराक्रम तै मेरा न्याय कर।<verse eid="PSA 54:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 54:2" />हे परमेसवर, मेरी प्रार्थना सुण ले,</para>
  <para style="q" vid="PSA 54:2">मेरे मुँह के वचनां की ओड़ कान लगा।<verse eid="PSA 54:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 54:3" />क्यूँके परदेशी<note caller="+" style="f"><char style="fr" closed="false">54:3 </char><char style="fq" closed="false">परदेशी </char><char style="ft" closed="false">घमण्डी</char></note> मेरे बिरुध्द उठ्ठे सै,</para>
  <para style="q" vid="PSA 54:3">अर कुकर्मी मेरी जान के गाहक होए सै,</para>
  <para style="q" vid="PSA 54:3">उननै परमेसवर ताहीं अपणे स्याम्ही न्ही जाण्या।<verse eid="PSA 54:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 54:4" />देक्खो, परमेसवर मेरा मददगार सै;</para>
  <para style="q" vid="PSA 54:4">प्रभु मेरी जान नै सम्भाळण आळा सै।<verse eid="PSA 54:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 54:5" />वो मेरे बिरोधियाँ की बुराई नै उनपै ए उल्टा देवैगा;</para>
  <para style="q" vid="PSA 54:5">हे परमेसवर, अपणी सच्‍चाई के कारण उनका नाश कर।<verse eid="PSA 54:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 54:6" />मै तेरे ताहीं स्वेच्छाबलि चढ़ाऊँगा;</para>
  <para style="q" vid="PSA 54:6">हे यहोवा, मै तेरे नाम का धन्यवाद करुँगा,</para>
  <para style="q" vid="PSA 54:6">क्यूँके यो उत्तम सै।<verse eid="PSA 54:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 54:7" />क्यूँके तन्‍नै मेरे ताहीं सारे दुखां तै छुड़ाया सै,</para>
  <para style="q" vid="PSA 54:7">अर मै अपणे दुश्मनां पै जीत कै गैल निगांह करी सै।<verse eid="PSA 54:7" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" sid="PSA 55" />
  <para style="s">धोक्खेबाज कै नाश खात्तर प्रार्थना</para>
  <para style="d">प्रधान बजाण आळे खात्तर, तारआळे बाज्यां कै गैल। दाऊद का मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 55:1" />हे परमेसवर, मेरी प्रार्थना की ओड़ कान लगा;</para>
  <para style="q" vid="PSA 55:1">अर मेरी गिड़गिड़ाहट तै मुँह ना मोड़!<verse eid="PSA 55:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 55:2" />मेरी ओड़ ध्यान देकै, मन्‍नै जवाब दे;</para>
  <para style="q" vid="PSA 55:2">मुसीबतां के कारण मै बेचैन होऊँ सूं।<verse eid="PSA 55:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 55:3" />क्यूँके दुश्मन हाहाकार</para>
  <para style="q" vid="PSA 55:3">अर दुष्ट उपद्रव करण लागरे सै;</para>
  <para style="q" vid="PSA 55:3">वे मेरे पै दोष लगावै सै,</para>
  <para style="q" vid="PSA 55:3">अर छो म्ह आकै मन्‍नै सतावै सै।<verse eid="PSA 55:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 55:4" />मेरा मन भित्तर ए भित्तर दुखी सै,</para>
  <para style="q" vid="PSA 55:4">अर मौत का डर मेरे म्ह समा ग्या सै।<verse eid="PSA 55:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 55:5" />डर अर कँपकँपी नै मै पकड़ लिया सूं,</para>
  <para style="q" vid="PSA 55:5">अर डर के कारण मेरे रुंग-रुंग खड़े होगे सै।<verse eid="PSA 55:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 55:6" />फेर मन्‍नै कह्या, “भला होन्दा के मेरै कबूतर की तरियां पंख होन्दे</para>
  <para style="q" vid="PSA 55:6">तो मै उड़ जान्दा अर आराम पान्दा!<verse eid="PSA 55:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 55:7" />देक्खो, फेर तो मै उड़दे-उड़दे दूर लिकड़ जान्दा</para>
  <para style="q" vid="PSA 55:7">अर जंगळ म्ह बसेरा लेन्दा,<verse eid="PSA 55:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 55:8" />मै आँधी अर तूफान के झोंक्यां तै</para>
  <para style="q" vid="PSA 55:8">बचकै किसे शरणस्‍थान जगहां म्ह भाज जान्दा।”<verse eid="PSA 55:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 55:9" />हे प्रभु, उनका सत्यानाश कर,</para>
  <para style="q" vid="PSA 55:9">अर उनकी भाषा म्ह गड़बड़ी गेर दे;</para>
  <para style="q" vid="PSA 55:9">क्यूँके मन्‍नै नगर म्ह उपद्रव अर झगड़ा देख्या सै।<verse eid="PSA 55:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 55:10" />रात-दिन वे उसकी दीवारां पै चढ़कै च्यांरु ओड़ घूम्मै सै;</para>
  <para style="q" vid="PSA 55:10">अर उसके भित्तर दुष्टता अर उत्पात होवै सै।<verse eid="PSA 55:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 55:11" />उसके भित्तर दुष्टता नै बसेरा करया सै;</para>
  <para style="q" vid="PSA 55:11">अर जुल्म अर छळ उसके चौक तै दूर कोन्या होन्दे।<verse eid="PSA 55:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 55:12" />जो मेरी बेजती करै सै वो मेरा दुश्मन कोन्या था,</para>
  <para style="q" vid="PSA 55:12">न्ही तो मै उसनै सह लेन्दा;</para>
  <para style="q" vid="PSA 55:12">जो मेरे खिलाफ बड़ाई मारै सै वो मेरा बैरी कोन्या सै,</para>
  <para style="q" vid="PSA 55:12">न्ही तो मै उसतै लुह्क जान्दा।<verse eid="PSA 55:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 55:13" />पर वो तो तू ए था जो मेरी बराबरी का माणस</para>
  <para style="q" vid="PSA 55:13">मेरा खास मित्तर अर मेरी जाण-पिच्छाण का था।<verse eid="PSA 55:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 55:14" />हम दोनु आप्पस म्ह किसी मिठ्ठी-मिठ्ठी बात करया करां थे,</para>
  <para style="q" vid="PSA 55:14">हम भीड़ के गैल परमेसवर कै भवन म्ह जाया करै थे।<verse eid="PSA 55:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 55:15" />उन ताहीं मौत चाणचक आ दबावै;</para>
  <para style="q" vid="PSA 55:15">वो जिन्दे ही अधोलोक म्ह उतर जावै;</para>
  <para style="q" vid="PSA 55:15">क्यूँके उनके घर अर मन दोनुआ म्ह बुराई अर उत्पात भरया सै।<verse eid="PSA 55:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 55:16" />पर मै तो परमेसवर नै पुकारूँगा;</para>
  <para style="q" vid="PSA 55:16">अर यहोवा मन्‍नै बचा लेवैगा।<verse eid="PSA 55:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 55:17" />साँझ, सबेरै, दोफ्फारै, तीन्‍नु पहर</para>
  <para style="q" vid="PSA 55:17">मै दोहाई देऊँगा अर कराहन्दा रहूँगा।</para>
  <para style="q" vid="PSA 55:17">अर वो मेरा शब्द सुण लेवैगा।<verse eid="PSA 55:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 55:18" />जो लड़ाई मेरे बिरुध्द माच्‍ची थी उसतै उसनै मेरे ताहीं सही-सलामत बचा लिया सै।</para>
  <para style="q" vid="PSA 55:18">उननै तो घणखरयां ताहीं गैल लेकै मेरा सामना करया था।<verse eid="PSA 55:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 55:19" />परमेसवर जो शरुवात तै विराजमान सै या सुणकै उन ताहीं जवाब देवैगा।</para>
  <para style="q" vid="PSA 55:19">ये वे सै जिन म्ह कोए बदलाव कोन्या, अर उन म्ह परमेसवर का डर सै ए कोन्या।<verse eid="PSA 55:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 55:20" />उसनै अपणे मेल राक्खण आळयां पै भी हाथ उठाया सै,</para>
  <para style="q" vid="PSA 55:20">उसनै अपणे करार ताहीं तोड़ दिया सै।<verse eid="PSA 55:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 55:21" />उसके मुँह की बात तो मक्खन की ढाळ चिकणी थी</para>
  <para style="q" vid="PSA 55:21">पर उसके मन म्ह लड़ाई की भोत सारी बात थी;</para>
  <para style="q" vid="PSA 55:21">उसके वचन तेल तै घणे नरम तो थे</para>
  <para style="q" vid="PSA 55:21">पर नंगी तलवार थी।<verse eid="PSA 55:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 55:22" />अपणा बोझ यहोवा पर गेर दे, वो तेरे ताहीं सम्भालैगा;</para>
  <para style="q" vid="PSA 55:22">वो धर्मी ताहीं कदे टळण न्ही देवैगा।<verse eid="PSA 55:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 55:23" />पर हे परमेसवर, तू उन माणसां नै नाश के गड्ढे म्ह गिरा देवैगा;</para>
  <para style="q" vid="PSA 55:23">हत्यारे अर कपटी माणस अपणी आध्धी उम्र तक भी जिन्दे न्ही रहवैंगे।</para>
  <para style="q" vid="PSA 55:23">पर मै तेरे पै भरोस्सा राक्खे रहूँगा।<verse eid="PSA 55:23" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" sid="PSA 56" />
  <para style="s">उत्पीड़कां तै राहत खात्तर प्रार्थना</para>
  <para style="d">प्रधान बजाण आळे खात्तर योनतेलेखद्दोकीम म्ह दाऊद का मिक्ताम जिब पलिश्तियाँ नै उस ताहीं गत नगर म्ह पकड्या था</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 56:1" />हे परमेसवर, मेरे पै दया कर, क्यूँके माणस मेरे ताहीं निगळणा चाहवै सै;</para>
  <para style="q" vid="PSA 56:1">वे दिन भर लड़कै मन्‍नै सतावै सै।<verse eid="PSA 56:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 56:2" />मेरे बिरोधी दिन भर मन्‍नै निगळणा चाहवै सै,</para>
  <para style="q" vid="PSA 56:2">क्यूँके जो माणस घमण्ड करकै मेरे तै लड़ै सै वे भोत घणे सै।<verse eid="PSA 56:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 56:3" />जिस बखत मन्‍नै डर लाग्गैगा,</para>
  <para style="q" vid="PSA 56:3">मै तेरे पै भरोस्सा राक्खूँगा।<verse eid="PSA 56:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 56:4" />परमेसवर की मदद तै मै उसके वचन की बड़ाई करुँगा,</para>
  <para style="q" vid="PSA 56:4">परमेसवर पै मन्‍नै भरोस्सा राख्या सै, मै कोन्या डरुँगा।</para>
  <para style="q" vid="PSA 56:4">कोए माणस मेरा के कर सकै सै?<verse eid="PSA 56:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 56:5" />वे दिन भर मेरे वचनां का, उलटा मतलब काढ-काढकै मरोड़दे रहवै सै;</para>
  <para style="q" vid="PSA 56:5">उनकी सारी तरकीब मेरी ए बुराई करण की होवै सै।<verse eid="PSA 56:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 56:6" />वे सारे मिलकै कठ्ठे होवै सै अर लुह्क कै बैठ्ठै सै;</para>
  <para style="q" vid="PSA 56:6">वे मेरे पैरां के निशान्‍नां नै भी ध्यान तै देक्खै सै,</para>
  <para style="q" vid="PSA 56:6">मान्‍नो वे मेरी जान लेण की ताक म्ह बेठ्ठे हों।<verse eid="PSA 56:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 56:7" />के वो बुराई करकै भी बच जावैंगे?</para>
  <para style="q" vid="PSA 56:7">हे परमेसवर, अपणे छो तै देश-देश के माणसां नै गेर दे!<verse eid="PSA 56:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 56:8" />तू मेरे मारे-मारे फिरण का हिसाब राक्खै सै;</para>
  <para style="q" vid="PSA 56:8">तू मेरे आँसुआँ नै अपणी कुप्‍पी म्ह धर ले!</para>
  <para style="q" vid="PSA 56:8">के उनकी चर्चा तेरी किताब म्ह न्ही सै?<verse eid="PSA 56:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 56:9" />फेर जिस बखत मै पुकारूँगा, उस्से बखत मेरे दुश्मन उलटे बोहड़ जावैंगे।</para>
  <para style="q" vid="PSA 56:9">या मै जाणु सूं, के<note caller="+" style="f"><char style="fr" closed="false">56:9 </char><char style="fq" closed="false">के </char><char style="ft" closed="false">क्यूँके</char></note> परमेसवर मेरी ओड़ सै।<verse eid="PSA 56:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 56:10" />परमेसवर की मदद तै मै उसके वचन की बड़ाई करुँगा,</para>
  <para style="q" vid="PSA 56:10">यहोवा की मदद तै मै उसके वचन की बड़ाई करुँगा।<verse eid="PSA 56:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 56:11" />मन्‍नै परमेसवर पै भरोस्सा राख्या सै, मै कोन्या डरुँगा।</para>
  <para style="q" vid="PSA 56:11">माणस मेरा के कर सकै सै?<verse eid="PSA 56:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 56:12" />हे परमेसवर, तेरी मन्‍नतां का भार मेरे पै बण्या सै;</para>
  <para style="q" vid="PSA 56:12">मै तेरे ताहीं धन्यवाद-बलि चढ़ाऊँगा।<verse eid="PSA 56:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 56:13" />क्यूँके तन्‍नै मेरे ताहीं मौत तै बचाया सै;</para>
  <para style="q" vid="PSA 56:13">तन्‍नै मेरे पैरां ताहीं भी फिसळण तै बचाया सै,</para>
  <para style="q" vid="PSA 56:13">ताके मै परमेसवर के स्याम्ही जिन्दे माणसां के उजियाळे म्ह चाल्‍लूँ फिरुँ?<verse eid="PSA 56:13" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" sid="PSA 57" />
  <para style="s">दुश्मनां तै सलामती खात्तर प्रार्थना</para>
  <para style="d">प्रधान बजाण आळे खात्तर अल-तशहेत राग म्ह दाऊद का मिक्ताम जिब वो शाऊल तै भाग कै गुफा म्ह लुह्क ग्या था</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 57:1" />हे परमेसवर, मेरे पै दया कर, मेरे पै दया कर,</para>
  <para style="q" vid="PSA 57:1">क्यूँके मन्‍नै तेरी शरण ली सै;</para>
  <para style="q" vid="PSA 57:1">अर जिब ताहीं ये मुसीबत लिकड़ ना जावै,</para>
  <para style="q" vid="PSA 57:1">तब तक मै तेरे पंखां के तळै शरण लिए रहूँगा।<verse eid="PSA 57:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 57:2" />मै परमप्रधान परमेसवर नै पुकारूँगा,</para>
  <para style="q" vid="PSA 57:2">परमेसवर ताहीं जो मेरे खात्तर सब कुछ सिध्द करै सै।<verse eid="PSA 57:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 57:3" />परमेसवर सुर्ग तै भेजकै मेरे ताहीं बचा लेवैगा,</para>
  <para style="q" vid="PSA 57:3">जिब मेरा निगळने आळा बुराई करण लागरया हो। (सेला)</para>
  <para style="q" vid="PSA 57:3">परमेसवर अपणी करुणा अर सच्‍चाई जाहिर करैगा।<verse eid="PSA 57:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 57:4" />मै शेरां के बीच म्ह सूं,</para>
  <para style="q" vid="PSA 57:4">जो मेरे ताहीं पाड़-खाण नै तैयार सै मन्‍नै उनकै बीच म्ह लेटणा पड्या सै,</para>
  <para style="q" vid="PSA 57:4">मतलब इसे माणसां कै बीच म्ह जिनके दाँत बर्छी अर तीर सै<note caller="+" style="f"><char style="fr" closed="false">57:4 </char><char style="ft" closed="false">मेरा जीवन शेरां के बीच मै सै, मै माणसां कै बीच म्ह झूठ बोल्‍लू सूं</char></note>,</para>
  <para style="q" vid="PSA 57:4">अर जिनकी जीभ तेज तलवार सै।<verse eid="PSA 57:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 57:5" />हे परमेसवर तू सुर्ग कै उप्पर घणा महान अर तेजोमय सै,</para>
  <para style="q" vid="PSA 57:5">तेरी महिमा सारी धरती कै उप्पर फैल जावै!<verse eid="PSA 57:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 57:6" />उननै मेरे पैरां खात्तर जाळ बिछाया सै;</para>
  <para style="q" vid="PSA 57:6">मेरा जी लिकड़या जावै सै।</para>
  <para style="q" vid="PSA 57:6">उननै मेरै आग्गै खड्डा खोद्या,</para>
  <para style="q" vid="PSA 57:6">पर खुद उस म्ह गिर पड़े।<verse eid="PSA 57:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 57:7" />हे परमेसवर, मेरा मन मजबूत सै, मेरा मन मजबूत सै;</para>
  <para style="q" vid="PSA 57:7">मै गाऊँगा बलके भजन कीर्तन करुँगा।<verse eid="PSA 57:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 57:8" />हे मेरे मन जाग जा! हे सारंगी अर बीन जाग जाओ।</para>
  <para style="q" vid="PSA 57:8">मै भी दिन लिकड़दे ए जाग उठूँगा।<verse eid="PSA 57:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 57:9" />हे प्रभु, मै देश-देश के माणसां के बीच तेरा धन्यवाद करुँगा;</para>
  <para style="q" vid="PSA 57:9">मै राज्य-राज्य के माणसां के बीच म्ह तेरा भजन गाऊँगा।<verse eid="PSA 57:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 57:10" />क्यूँके तेरी करुणा की पोहच सुर्ग तक सै,</para>
  <para style="q" vid="PSA 57:10">अर तेरी सच्‍चाई आकाशमण्‍डल तक पोहचै सै।<verse eid="PSA 57:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 57:11" />हे परमेसवर, तू सुर्ग के उप्पर घणा महान सै!</para>
  <para style="q" vid="PSA 57:11">तेरी महिमा सारी धरती के उप्पर फैल जावै!<verse eid="PSA 57:11" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" sid="PSA 58" />
  <para style="s">अन्याय कै खिलाफ प्रार्थना</para>
  <para style="d">प्रधान बजाण आळे खात्तर अल-तशहेत राग म्ह दाऊद का मिक्ताम</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 58:1" />हे राज करण आळेयो<note caller="+" style="f"><char style="fr" closed="false">58:1 </char><char style="fq" closed="false">राज करण आळेयो </char><char style="ft" closed="false">देवताओं, हे गूँगे माणसों</char></note>, के थम सच म्ह ए धार्मिकता की बात बोल्‍लो सों?</para>
  <para style="q" vid="PSA 58:1">अर हे आदम जात, के थम सिधाई तै फैसला करो सों?<verse eid="PSA 58:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 58:2" />न्ही, थम मन ए मन म्ह बुरे काम करो सो;</para>
  <para style="q" vid="PSA 58:2">थम पूरे देश म्ह दंगे करदे जाओ सों।<verse eid="PSA 58:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 58:3" />दुष्ट माणस जन्‍म तैए पराए हो जावै सै,</para>
  <para style="q" vid="PSA 58:3">वे पेट तै लिकड़ती ए झूठ बोलदे होए भटक जावै सै।<verse eid="PSA 58:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 58:4" />उन म्ह साँप का जिसा जहर सै;</para>
  <para style="q" vid="PSA 58:4">वे उस नाग की तरियां सै, जो सुणणा न्ही चाहन्दा;<verse eid="PSA 58:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 58:5" />अर सपेरा कितनी ही चालाकी तै क्यूँ ना मंत्र पढ़ै,</para>
  <para style="q" vid="PSA 58:5">फेर भी वो उसकी न्ही सुणदा।<verse eid="PSA 58:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 58:6" />हे परमेसवर, उनके मुँह म्ह तै दान्दां नै तोड़दे;</para>
  <para style="q" vid="PSA 58:6">हे यहोवा उन जवान शेरां की जाड़ां नै उखाड़ दे।<verse eid="PSA 58:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 58:7" />वो घुळ कै बहन्दे होए पाणी की तरियां हो जावै;</para>
  <para style="q" vid="PSA 58:7">जिब वो अपणे तीर चढ़ावै, तो तीर मान्‍नो दो टुकड़े हो जावै।<verse eid="PSA 58:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 58:8" />वो घोंघे की तरियां हो जावै जो घुळ कै नाश हो जावै सै,</para>
  <para style="q" vid="PSA 58:8">अर औरत के गिरे होए गर्भ की तरियां हो जिसनै सूरज ताहीं देख्या ए ना हो।<verse eid="PSA 58:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 58:9" />इसतै पैहले की थारी हाड्डियाँ म्ह काँड्या की आँच लाग्गै,</para>
  <para style="q" vid="PSA 58:9">हरे अर जळे, दोनुआ ताहीं वो भम्बुळिये तै उड़ा ले जावैगा।<verse eid="PSA 58:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 58:10" />परमेसवर का इसा बदला देखकै वो खुश होवैगा;</para>
  <para style="q" vid="PSA 58:10">वो अपणे पैरां नै दुष्ट के खून म्ह धोवैगा।<verse eid="PSA 58:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 58:11" />फेर माणस कहण लाग्गे, पक्‍का धर्मी खात्तर फळ सै;</para>
  <para style="q" vid="PSA 58:11">पक्‍का परमेसवर सै, जो धरती पै न्याय करै सै।<verse eid="PSA 58:11" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" sid="PSA 59" />
  <para style="s">सलामती खात्तर प्रार्थना</para>
  <para style="d">प्रधान बजाण आळे खात्तर अल-तशहेत राग म्ह दाऊद का मिक्ताम; जिब शाऊल के भेज्जे होए माणसां नै घर का पैहरा दिया ताके उस ताहीं मारदे</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 59:1" />हे मेरे परमेसवर, मेरे ताहीं दुश्मनां तै बचा,</para>
  <para style="q" vid="PSA 59:1">मेरे ताहीं ऊँच्‍ची जगहां पै राखकै मेरे बिरोधियाँ तै बचा,<verse eid="PSA 59:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 59:2" />मेरे ताहीं बुराई करण आळे के हाथ तै बचा,</para>
  <para style="q" vid="PSA 59:2">अर हत्‍यारां तै मेरा उद्धार कर।<verse eid="PSA 59:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 59:3" />क्यूँके देख, वे मेरी बाट म्ह सै;</para>
  <para style="q" vid="PSA 59:3">हे यहोवा, मेरा कोए कसूर या पाप न्ही सै,</para>
  <para style="q" vid="PSA 59:3">तोभी जुल्मी माणस मेरे खिलाफ कठ्ठे होए सै।<verse eid="PSA 59:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 59:4" />मै बेकसूर सूं तोभी वे मेरे तै लड़ण खात्तर मेरी ओड़ भाज-भाजकै आवै सै।</para>
  <para style="q" vid="PSA 59:4">जाग, अर मेरी मदद कर, अर यो देख!<verse eid="PSA 59:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 59:5" />हे सेनाओं के परमेसवर यहोवा,</para>
  <para style="q" vid="PSA 59:5">हे इस्राएल के परमेसवर सारी गैरजात्तां ताहीं दण्ड देण खात्तर जाग;</para>
  <para style="q" vid="PSA 59:5">किसे धोक्खेबाज जुल्मी पै दया ना कर।<verse eid="PSA 59:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 59:6" />वो माणस साँझ नै बोहड़कै कुत्तै की तरियां गुर्रावै सै,</para>
  <para style="q" vid="PSA 59:6">अर नगर के च्यांरु ओड़ घूम्मै सै।<verse eid="PSA 59:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 59:7" />देख वे डकारै सै, उनके मुँह के भित्तर तलवार सै,</para>
  <para style="q" vid="PSA 59:7">क्यूँके वो कहवै सै, “कौण म्हारे ताहीं सुणै सै?”<verse eid="PSA 59:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 59:8" />पर हे यहोवा, तू उनपै हास्सैगा;</para>
  <para style="q" vid="PSA 59:8">तू सारी गैरजात्तां ताहीं मजाक म्ह उड़ावैगा।<verse eid="PSA 59:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 59:9" />हे मेरे परमेसवर, मेरी ताकत, मै तेरे पैए ध्यान लगाऊँगा;</para>
  <para style="q" vid="PSA 59:9">तू मेरा ऊँच्‍चा गढ़ सै।<verse eid="PSA 59:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 59:10" />परमेसवर करुणा करदा होया मेरे तै मिलैगा;</para>
  <para style="q" vid="PSA 59:10">परमेसवर मेरे बिरोधियाँ के बारै म्ह मेरी इच्छा पूरी कर देवैगा।<verse eid="PSA 59:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 59:11" />उननै घात ना करै, इसा ना हो के मेरी प्रजा भूल जावै;</para>
  <para style="q" vid="PSA 59:11">हे प्रभु, हे म्हारी ढाल!</para>
  <para style="q" vid="PSA 59:11">अपणी शक्ति तै उननै तित्तर-बितर कर, उन ताहीं दबा दे।<verse eid="PSA 59:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 59:12" />वो अपणे मुँह के पाप, अर होठ्ठां के वचन,</para>
  <para style="q" vid="PSA 59:12">अर श्राप देण, अर झूठ बोलण के कारण,</para>
  <para style="q" vid="PSA 59:12">अभिमान म्ह फँसे होए पकड़े जावै।<verse eid="PSA 59:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 59:13" />आग बबूळा होकै उनका नाश कर,</para>
  <para style="q" vid="PSA 59:13">उनका अन्त करदे ताके वो खतम हो जावै</para>
  <para style="q" vid="PSA 59:13">फेर लोग जाणैगें के परमेसवर याकूब<note caller="+" style="f"><char style="fr" closed="false">59:13 </char><char style="fq" closed="false">याकूब </char><char style="ft" closed="false">इस्राएल के माणसों</char></note> पै,</para>
  <para style="q" vid="PSA 59:13">बलके धरती की छोर तक प्रभुता करै सै।<verse eid="PSA 59:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 59:14" />वो साँझ नै बोहड़कै कुत्याँ की तरियां गुर्रावै सै,</para>
  <para style="q" vid="PSA 59:14">अर नगर के च्यांरु ओड़ घूम्मै सै।<verse eid="PSA 59:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 59:15" />वो टुकड़े खात्तर मारे-मारे फिरे,</para>
  <para style="q" vid="PSA 59:15">अर ना छिके फेर भी रात भर<note caller="+" style="f"><char style="fr" closed="false">59:15 </char><char style="fq" closed="false">रात भर </char><char style="ft" closed="false">कुड़कुड़ावै सै, शिकायत</char></note> गुर्रावै सै।<verse eid="PSA 59:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 59:16" />पर मै तेरी सामर्थ्य का यश गाऊँगा,</para>
  <para style="q" vid="PSA 59:16">अर सबेरै तेरी करुणा का जयजयकार करुँगा।</para>
  <para style="q" vid="PSA 59:16">क्यूँके तू मेरा ऊँच्‍चा गढ़ सै,</para>
  <para style="q" vid="PSA 59:16">अर मुसीबत के बखत मेरा शरणस्‍थान ठहरा सै।<verse eid="PSA 59:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 59:17" />हे मेरे बल, मै तेरा भजन गाऊँगा,</para>
  <para style="q" vid="PSA 59:17">क्यूँके हे परमेसवर, तू मेरा ऊँच्‍चा गढ़</para>
  <para style="q" vid="PSA 59:17">अर मेरा करुणामय परमेसवर सै।<verse eid="PSA 59:17" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" sid="PSA 60" />
  <para style="s">छुटकारै खात्तर प्रार्थना</para>
  <para style="d">प्रधान बजाण आळे खात्तर दाऊद का मिक्ताम शूशनेदूत राग म्ह। शिक्षादायक। जिब वो अरम्नहरैम अर अरमसोबा तै लड़ै था। अर योआब नै बोहड़कै नमक की तराई म्ह एदोमियां म्ह तै बारहा हजार माणस मार लिये</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 60:1" />हे परमेसवर तन्‍नै मेरे ताहीं त्याग दिया,</para>
  <para style="q" vid="PSA 60:1">अर म्हारै ताहीं तोड़ दिया सै;</para>
  <para style="q" vid="PSA 60:1">तू छो म्ह आया, फेर म्हारै ताहीं ज्यों का त्यों करदे।<verse eid="PSA 60:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 60:2" />तन्‍नै धरती ताहीं कंपया अर पाड़ दिया सै;</para>
  <para style="q" vid="PSA 60:2">उसके दरारां नै भर दे, क्यूँके वो डगमगावै सै।<verse eid="PSA 60:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 60:3" />तन्‍नै अपणी प्रजा ताहीं मुश्किल बखत दिखाया;</para>
  <para style="q" vid="PSA 60:3">तन्‍नै म्हारे ताहीं लड़खडाण आळा दाखमधु पिलाया सै।<verse eid="PSA 60:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 60:4" />तन्‍नै अपणे भय मानण आळा ताहीं झण्डा दिया सै,</para>
  <para style="q" vid="PSA 60:4">ताके वो सच्‍चाई के कारण<note caller="+" style="f"><char style="fr" closed="false">60:4 </char><char style="fq" closed="false">सच्‍चाई के कारण </char><char style="ft" closed="false">धनुष तै</char></note> फैहराया जावै। (सेला)<verse eid="PSA 60:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 60:5" />तू अपणे सोळे हाथ तै बचा, अर म्हारी सुण ले</para>
  <para style="q" vid="PSA 60:5">ताके तेरे प्रिय छुड़ाए जावै।<verse eid="PSA 60:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 60:6" />परमेसवर पवित्र जगहां<note caller="+" style="f"><char style="fr" closed="false">60:6 </char><char style="fq" closed="false">पवित्र जगहां </char><char style="ft" closed="false">पवित्रता के गैल </char></note> म्ह तै बोल्या सै, “मै फूल्‍ला न्ही समाऊँगा;</para>
  <para style="q" vid="PSA 60:6">मै शेकेम नै बाँट ल्यूँगा, अर सुक्‍कोत की तराई नै नपवाऊँगा।<verse eid="PSA 60:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 60:7" />गिलाद मेरा सै; मनश्‍शे भी मेरा सै;</para>
  <para style="q" vid="PSA 60:7">अर एप्रैम मेरे सिर का टोप,</para>
  <para style="q" vid="PSA 60:7">यहूदा मेरा राजदण्ड सै।<verse eid="PSA 60:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 60:8" />मोआब मेरे धोण का पात्र सै;</para>
  <para style="q" vid="PSA 60:8">मै एदोम पै अपणा जूत्ता फेंक्‍कूँगा;</para>
  <para style="q" vid="PSA 60:8">हे पलिश्‍तीन, मन्‍नै उस ताहीं जीत लिया सै अर मै खुशी तै चिल्‍लाऊ सूं।”<verse eid="PSA 60:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 60:9" />मन्‍नै गढ़आळे नगर म्ह कौण पोहचावैगा?</para>
  <para style="q" vid="PSA 60:9">एदोम तक मेरी अगुवाई किसनै करी सै?<verse eid="PSA 60:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 60:10" />हे परमेसवर, के तन्‍नै म्हारे ताहीं त्याग न्ही दिया?</para>
  <para style="q" vid="PSA 60:10">हे परमेसवर, तू म्हारी सेना की गैल न्ही जान्दा।<verse eid="PSA 60:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 60:11" />दुश्मन के खिलाफ म्हारी मदद कर,</para>
  <para style="q" vid="PSA 60:11">क्यूँके माणस की करी होई मदद बेकार सै।<verse eid="PSA 60:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 60:12" />परमेसवर की मदद तै हम वीरता दिखावागें,</para>
  <para style="q" vid="PSA 60:12">क्यूँके म्हारे दुश्मनां नै वोए रौंदैगा।<verse eid="PSA 60:12" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" sid="PSA 61" />
  <para style="s">सलामती खात्तर प्रार्थना</para>
  <para style="d">प्रधान बजाण आळे खात्तर तारआळे बाजै गैल दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 61:1" />हे परमेसवर, मेरा चिल्‍लाणा सुण,</para>
  <para style="q" vid="PSA 61:1">मेरी प्रार्थना की ओड़ ध्यान दे।<verse eid="PSA 61:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 61:2" />मूर्छा खाते बखत मै धरती की छोर तै भी तेरे ताहीं पुकारूँगा,</para>
  <para style="q" vid="PSA 61:2">जो चट्टान मेरे खात्तर ऊँच्‍ची सै, उसपै मेरे ताहीं ले चल;<verse eid="PSA 61:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 61:3" />क्यूँके तू मेरा शरणस्‍थान सै,</para>
  <para style="q" vid="PSA 61:3">अर दुश्मन तै बचण खात्तर ऊँच्‍चा गढ़ सै।<verse eid="PSA 61:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 61:4" />मै तेरे तम्बू म्ह युगानुयुग बण्या रहूँगा।</para>
  <para style="q" vid="PSA 61:4">मै तेरे पंखां की ओट म्ह शरण लिए रहूँगा। (सेला)<verse eid="PSA 61:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 61:5" />क्यूँके हे परमेसवर, तन्‍नै मेरी सारी मन्‍नत सुणी,</para>
  <para style="q" vid="PSA 61:5">जो तेरे नाम के भय मानण आळे सै, उनका सा भाग तन्‍नै मेरे ताहीं दिया सै।<verse eid="PSA 61:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 61:6" />तू राजा की उम्र नै भोत बढ़ावैगा;</para>
  <para style="q" vid="PSA 61:6">उसके साल पीढ़ी-पीढ़ी की तरियां होंगे।<verse eid="PSA 61:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 61:7" />वो परमेसवर के स्याम्ही सदा बण्या रहवैगा;</para>
  <para style="q" vid="PSA 61:7">तू अपणी दया अर सच्‍चाई नै उसकी हिफाजत खात्तर बणाए राख।<verse eid="PSA 61:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 61:8" />इस तरियां मै सदा तेरे नाम का भजन गा-गाकै</para>
  <para style="q" vid="PSA 61:8">अपणी सारी मन्‍नत हर दिन पूरी करया करुँगा।<verse eid="PSA 61:8" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" sid="PSA 62" />
  <para style="s">परमेसवर के उद्धार खात्तर बाट</para>
  <para style="d">प्रधान बजाण आळे खात्तर दाऊद का भजन। यदूतून कै राग पै</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 62:1" />सचमुच मै चुपचाप होकै परमेसवर की ओड़ मन लगाऐ सूं;</para>
  <para style="q" vid="PSA 62:1">मेरा उद्धार उस्से तै होवै सै।<verse eid="PSA 62:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 62:2" />सचमुच वोए, मेरी चट्टान अर मेरा उद्धार सै,</para>
  <para style="q" vid="PSA 62:2">वो मेरा गढ़ सै; मै कदे न्ही डिगूँगा।<verse eid="PSA 62:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 62:3" />थम कद तक एक माणस पै धावा बोलदे रहोगे,</para>
  <para style="q" vid="PSA 62:3">के सारे मिलकै उसका नाश करो?</para>
  <para style="q" vid="PSA 62:3">वो तो झुकी होई भीत या गिरदे होए बाड़े की तरियां सै<note caller="+" style="f"><char style="fr" closed="false">62:3 </char><char style="fq" closed="false">झुकी होई भीत या गिरदे होए बाड़े की तरियां सै </char><char style="ft" closed="false">थम सब मर जाओगे, झुकी होई भीत की तरियां हो जाओगे</char></note>।<verse eid="PSA 62:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 62:4" />सचमुच वे उस ताहीं, उसके ऊँच्‍चे पद तै गिराण की सलाह करै सै;</para>
  <para style="q" vid="PSA 62:4">वे झूठ तै खुश रहवै सै।</para>
  <para style="q" vid="PSA 62:4">मुँह तै तो वे आशीर्वाद देवै पर मन म्ह कोस्सै सै।<verse eid="PSA 62:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 62:5" />हे मेरे मन, परमेसवर के स्याम्ही चुपचाप रह,</para>
  <para style="q" vid="PSA 62:5">क्यूँके मेरी आस उस्से पै सै।<verse eid="PSA 62:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 62:6" />सचमुच वो मेरी चट्टान, अर मेरा उद्धार सै,</para>
  <para style="q" vid="PSA 62:6">वो मेरा गढ़ सै; इस करकै मै ना डिगूँगा।<verse eid="PSA 62:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 62:7" />मेरे उद्धार अर मेरी महिमा का आधार परमेसवर सै;</para>
  <para style="q" vid="PSA 62:7">मेरी मजबूत चट्टान, अर मेरा शरणस्‍थान परमेसवर सै।<verse eid="PSA 62:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 62:8" />हे माणसों, हर बखत उस पर भरोस्सा राक्खो;</para>
  <para style="q" vid="PSA 62:8">उसतै अपणे-अपणे मन की सारी बात खोलकै कहो;</para>
  <para style="q" vid="PSA 62:8">परमेसवर म्हारा शरणस्‍थान सै।<verse eid="PSA 62:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 62:9" />सचमुच नीच माणस तो अस्‍थाई, अर बड़े लोग झूठ्ठे ए सै;</para>
  <para style="q" vid="PSA 62:9">तौल म्ह वो हळके लिकड़ै सै;</para>
  <para style="q" vid="PSA 62:9">वो सारे के सारे साँस तै भी हळके सै।<verse eid="PSA 62:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 62:10" />अन्धेर करण पै भरोस्सा ना राक्खो,</para>
  <para style="q" vid="PSA 62:10">अर लूट-पाट करणे पै ना फूल्‍लो;</para>
  <para style="q" vid="PSA 62:10">चाहे धन-सम्पत्ति बढ़े, फेर भी उसपै मन ना लगाईयो।<verse eid="PSA 62:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 62:11" />परमेसवर नै एक बार कह्या सै;</para>
  <para style="q" vid="PSA 62:11">अर दो बार मन्‍नै सुण्या सै:</para>
  <para style="q" vid="PSA 62:11">के सामर्थ्य परमेसवर की सै।<verse eid="PSA 62:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 62:12" />अर हे प्रभु, करुणा भी तेरी सै।</para>
  <para style="q" vid="PSA 62:12">क्यूँके तू एक-एक माणस नै उसके काम के मुताबिक फळ देवै सै।<verse eid="PSA 62:12" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" sid="PSA 63" />
  <para style="s">प्यासा मन परमेसवर म्ह तृप्त</para>
  <para style="d">दाऊद का भजन; जिब वो यहूदा के जंगळ म्ह था।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 63:1" />हे परमेसवर, तू मेरा परमेसवर सै,</para>
  <para style="q" vid="PSA 63:1">मै तेरे ताहीं लगन तै ढूँढ़ूगा;</para>
  <para style="q" vid="PSA 63:1">सूक्खी अर निर्जल बंजर धरती पै,</para>
  <para style="q" vid="PSA 63:1">मेरा मन तेरा तिसाया सै, मेरी देह तेरी घणी इच्छा करै सै।<verse eid="PSA 63:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 63:2" />इस तरियां तै मन्‍नै पवित्र स्‍थान म्ह तेरे पै निगांह करी,</para>
  <para style="q" vid="PSA 63:2">ताके तेरी सामर्थ्य अर महिमा नै देक्खूँ।<verse eid="PSA 63:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 63:3" />क्यूँके तेरी करुणा जीवन तै भी आच्छी सै,</para>
  <para style="q" vid="PSA 63:3">मै तेरी बड़ाई करुँगा।<verse eid="PSA 63:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 63:4" />इस तरियां मै जीवन भर तेरे ताहीं धन्य कहन्दा रहूँगा;</para>
  <para style="q" vid="PSA 63:4">अर तेरा नाम लेकै अपणे हाथ ठाऊँगा।<verse eid="PSA 63:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 63:5" />मेरा जी मान्‍नो चर्बी अर चिकणे खाणे तै छिक्या हो,</para>
  <para style="q" vid="PSA 63:5">अर मै जयजयकार करकै तेरी बड़ाई करुँगा।<verse eid="PSA 63:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 63:6" />जब मै बिछोणे पै पड्या तन्‍नै याद करुँगा,</para>
  <para style="q" vid="PSA 63:6">तब रात के एक-एक पहर म्ह तेरे पै ध्यान करुँगा;<verse eid="PSA 63:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 63:7" />क्यूँके तू मेरा मददगार बण्या सै,</para>
  <para style="q" vid="PSA 63:7">इस करकै मै तेरे पंखां की छाया म्ह जयजयकार करुँगा।<verse eid="PSA 63:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 63:8" />मेरा मन तेरे पाच्छै-पाच्छै लाग्या सै;</para>
  <para style="q" vid="PSA 63:8">अर मेरे ताहीं तो तू अपणे सोळे हाथ तै थाम्मे रहवै सै।<verse eid="PSA 63:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 63:9" />पर जो मेरी जान के दुश्मन सै,</para>
  <para style="q" vid="PSA 63:9">वो धरती की निचली जगहां म्ह जा पड़ैगें;<verse eid="PSA 63:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 63:10" />वे तलवार तै मारे जावैंगे,</para>
  <para style="q" vid="PSA 63:10">अर गादड़ां का खाणा हो जावैंगे।<verse eid="PSA 63:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 63:11" />पर राजा परमेसवर कै कारण खुश होवैगा;</para>
  <para style="q" vid="PSA 63:11">जो कोए परमेसवर की कसम खावै, वो बड़ाई करण पावैगा;</para>
  <para style="q" vid="PSA 63:11">पर झूठ बोलण आळे का मुँह बन्‍द करया जावैगा।<verse eid="PSA 63:11" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" sid="PSA 64" />
  <para style="s">अनर्थकारियाँ तै संरक्षण</para>
  <para style="d">प्रधान बजाण आळे खात्तर दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 64:1" />हे परमेसवर, जिब मै तेरी दोहाई देऊँ, तब मेरी सुण;</para>
  <para style="q" vid="PSA 64:1">दुश्मन के बणाये होए भय के बखत मेरी जान की हिफाजत कर।<verse eid="PSA 64:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 64:2" />कुकर्मियों की साजिस तै,</para>
  <para style="q" vid="PSA 64:2">अर अनर्थकारियाँ के हुल्‍लड़ तै मेरी आड़ हो।<verse eid="PSA 64:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 64:3" />उननै अपणी जीभ ताहीं तलवार की तरियां तेज करया सै,</para>
  <para style="q" vid="PSA 64:3">अर अपणे कड़वे वचनां के तीरां नै चढ़ाया सै;<verse eid="PSA 64:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 64:4" />ताके लुह्क कै खरे माणस नै मारै;</para>
  <para style="q" vid="PSA 64:4">वे बेधड़क होकै उस ताहीं चाणचक मारै भी सै।<verse eid="PSA 64:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 64:5" />वे बुरे काम करण की हिम्मत भी करै सै;</para>
  <para style="q" vid="PSA 64:5">वे जाळ बिछाण खात्तर बातचीत करै सै;</para>
  <para style="q" vid="PSA 64:5">अर कहवै सै, “म्हारे<note caller="+" style="f"><char style="fr" closed="false">64:5 </char><char style="fq" closed="false">म्हारे </char><char style="ft" closed="false">उन चिज्जां</char></note> ताहीं कौण देक्खैगा?”<verse eid="PSA 64:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 64:6" />वे कुटिलता की योजना लिकाड़ै सै;</para>
  <para style="q" vid="PSA 64:6">अर कहवै सै, “हमनै पक्‍की तरकीब टोह कै लिकाड़ी सै।”</para>
  <para style="q" vid="PSA 64:6">क्यूँके माणस के मन के विचार तो कपट तै भरे सै!<verse eid="PSA 64:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 64:7" />पर परमेसवर उनपै तीर चलावैगा;</para>
  <para style="q" vid="PSA 64:7">वे चाणचक घायल हो जावैंगे।<verse eid="PSA 64:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 64:8" />वे अपणे ही वचनां के कारण ठोक्‍कर खाकै गिर पड़ैंगे;</para>
  <para style="q" vid="PSA 64:8">जितने उनपै निगांह करैंगे वे सारे अपणे-अपणे सिर हिलावैगे<verse eid="PSA 64:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 64:9" />फेर सारे लोग डर जावैंगे;</para>
  <para style="q" vid="PSA 64:9">अर परमेसवर के काम्मां का जिक्र करैंगे,</para>
  <para style="q" vid="PSA 64:9">अर परमेसवर के काम्मां नै भली-भाँति समझैगें।<verse eid="PSA 64:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 64:10" />धर्मी तो यहोवा के कारण खुश होकै उसकी शरण लेवैगा,</para>
  <para style="q" vid="PSA 64:10">अर सारे सीध्धे मन आळे बड़ाई करैंगे।<verse eid="PSA 64:10" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" sid="PSA 65" />
  <para style="s">परमेसवर की स्तुति अर धन्यवाद</para>
  <para style="d">प्रधान बजाण आळे खात्तर दाऊद का भजन, गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 65:1" />हे परमेसवर, सिय्योन म्ह स्तुति तेरी बाट देक्खै सै;</para>
  <para style="q" vid="PSA 65:1">अर तेरे खात्तर मन्‍नत पूरी करी जावैगी।<verse eid="PSA 65:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 65:2" />हे प्रार्थना के सुणण आळे!</para>
  <para style="q" vid="PSA 65:2">सारे माणस तेरैए धोरै आवैंगे।<verse eid="PSA 65:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 65:3" />अधर्म के काम मेरे पै हावी होए सै;</para>
  <para style="q" vid="PSA 65:3">म्हारे अपराध्धां नै तू माफ करैगा<note caller="+" style="f"><char style="fr" closed="false">65:3 </char><char style="fq" closed="false">तू माफ करैगा </char><char style="ft" closed="false">तन्‍नै म्हारे ताहीं पश्चाताप कराया</char></note>।<verse eid="PSA 65:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 65:4" />कितणे धन्य सै वो; जिस ताहीं तू चुण कै अपणे धोरै आण देवै सै,</para>
  <para style="q" vid="PSA 65:4">ताके वो तेरे आँगणां म्ह वास करे!</para>
  <para style="q" vid="PSA 65:4">हम तेरे भवन के, मतलब तेरे पवित्र मन्दर के उत्तम-उत्तम पदार्थां तै तृप्त होंगे।<verse eid="PSA 65:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 65:5" />हे म्हारे उद्धारकर्त्ता परमेसवर,</para>
  <para style="q" vid="PSA 65:5">हे धरती के सारे दूर-दूर देशां के अर दूर के समुन्दर पै रहण आळयां का आधार,</para>
  <para style="q" vid="PSA 65:5">तू धर्म तै करे होए अदभुत काम्मां के जरिये म्हारे ताहीं जवाब देवैगा;<verse eid="PSA 65:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 65:6" />तू जो पराक्रम का पटका कसे होए,</para>
  <para style="q" vid="PSA 65:6">अपणी सामर्थ्य के पर्वतां नै मजबूत करै सै;<verse eid="PSA 65:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 65:7" />तू जो समुन्दर का महाशब्‍द, उसकी तरंगो का महाशब्‍द,</para>
  <para style="q" vid="PSA 65:7">अर देश-देश के लोगों का कोलाहल शान्त करै सै;<verse eid="PSA 65:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 65:8" />इस करकै दूर-दूर देशां के रहण आळे तेरे चमत्कार देखकै डरगे सै;</para>
  <para style="q" vid="PSA 65:8">तू उदयाचल अर अस्ताचल दोनुआं तै जयजयकार करवावै सै।<verse eid="PSA 65:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 65:9" />तू धरती की सुधि लेकै उस ताहीं सींच सै,</para>
  <para style="q" vid="PSA 65:9">तू उस ताहीं भोत घणा उपजाऊ बणावै सै;</para>
  <para style="q" vid="PSA 65:9">परमेसवर की नदी पाणी तै भरी रहवै सै;</para>
  <para style="q" vid="PSA 65:9">तू धरती नै तैयार करकै माणसां खात्तर नाज तैयार करै सै।<verse eid="PSA 65:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 65:10" />तू क्यारियाँ नै भली-भाँति सींचै सै,</para>
  <para style="q" vid="PSA 65:10">अर उनकै बीच की माट्टी नै बिठावै सै,</para>
  <para style="q" vid="PSA 65:10">तू धरती नै मिह तै नरम करै सै,</para>
  <para style="q" vid="PSA 65:10">अर उसकी उपज पै आशीष देवै सै।<verse eid="PSA 65:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 65:11" />तेरी भलाई तै, तू साल नै मुकुट पिहरावै सै;</para>
  <para style="q" vid="PSA 65:11">तेरी राह म्ह बढ़िया तै बढ़िया चीज पाई जावै सै।<verse eid="PSA 65:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 65:12" />जंगळ म्ह हरियाली उमड़ आवै सै;</para>
  <para style="q" vid="PSA 65:12">अर पहाड़ियाँ हर्ष का पटका बाँधे होए सै।<verse eid="PSA 65:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 65:13" />घास के मैदान भेड़-बकरियाँ तै भरे होए सै;</para>
  <para style="q" vid="PSA 65:13">अर घाटी नाज तै ढँकी होई सै,</para>
  <para style="q" vid="PSA 65:13">वे जयजयकार करै अर गावै भी सै।<verse eid="PSA 65:13" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" sid="PSA 66" />
  <para style="s">पराक्रम के काम्मां खात्तर परमेसवर की स्तुति</para>
  <para style="d">प्रधान बजाण आळे खात्तर भजन, गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 66:1" />हे सारी धरती के माणसों, परमेसवर खात्तर जयजयकार करो;<verse eid="PSA 66:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 66:2" />उसके नाम की महिमा का भजन गाओ;</para>
  <para style="q" vid="PSA 66:2">उसकी बड़ाई करदे होए, उसकी महिमा करो।<verse eid="PSA 66:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 66:3" />परमेसवर तै कहो, “तेरे काम कितणे अदभुत सै!</para>
  <para style="q" vid="PSA 66:3">तेरी बड़ी सामर्थ्य कै कारण तेरे दुश्मन तेरी चापलूसी करैंगें।<verse eid="PSA 66:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 66:4" />सारी धरती के माणस तेरे ताहीं दण्डवत करैंगें,</para>
  <para style="q" vid="PSA 66:4">अर तेरा भजन गावैंगे;</para>
  <para style="q" vid="PSA 66:4">वे तेरे नाम का भजन गावैंगे।”<verse eid="PSA 66:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 66:5" />आओ परमेसवर के काम्मां नै देक्खो;</para>
  <para style="q" vid="PSA 66:5">वो अपणे काम्मां कै कारण माणसां नै अदभुत दिक्खै सै।<verse eid="PSA 66:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 66:6" />उसनै समुन्दर ताहीं सूक्खी धरती बणा दिया;</para>
  <para style="q" vid="PSA 66:6">वे समुन्दर म्ह तै पैदल पार उतरगे।</para>
  <para style="q" vid="PSA 66:6">ओड़ै हम उसकै कारण आनन्दित होए,<verse eid="PSA 66:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 66:7" />जो अपणे पराक्रम तै सदा प्रभुता करै सै,</para>
  <para style="q" vid="PSA 66:7">अर अपणी आँखां तै जात्ति-जात्ति नै देक्खै सै।</para>
  <para style="q" vid="PSA 66:7">बिद्रोही अपणे सिर ना ठावै।<verse eid="PSA 66:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 66:8" />हे देश-देश के माणसों, म्हारे परमेसवर नै धन्य कहो,</para>
  <para style="q" vid="PSA 66:8">अर उसकी बड़ाई म्ह राग ठाओ,<verse eid="PSA 66:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 66:9" />जो म्हारे ताहीं जिन्दा राक्खै सै;</para>
  <para style="q" vid="PSA 66:9">अर म्हारे पायां नै फिसळण न्ही देन्दा।<verse eid="PSA 66:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 66:10" />क्यूँके हे परमेसवर तन्‍नै म्हारे ताहीं जाँच्‍चा;</para>
  <para style="q" vid="PSA 66:10">तन्‍नै म्हारे ताहीं चाँदी की तरियां त्याया था।<verse eid="PSA 66:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 66:11" />तन्‍नै म्हारे ताहीं जाळ म्ह फँसाया;</para>
  <para style="q" vid="PSA 66:11">अर म्हारी कड़ पै भारी बोझ बाँध्या था;<verse eid="PSA 66:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 66:12" />तन्‍नै घुड़सवारां ताहीं म्हारे सिरां के उप्पर तै चलाया,</para>
  <para style="q" vid="PSA 66:12">हम आग अर पाणी म्ह तै होकै गए;</para>
  <para style="q" vid="PSA 66:12">पर तन्‍नै म्हारे ताहीं उभार कै सुख तै भर दिया सै।<verse eid="PSA 66:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 66:13" />मै होमबलि लेकै तेरे भवन म्ह आऊँगा</para>
  <para style="q" vid="PSA 66:13">मै उन मन्‍नतां नै तेरे खात्तर पूरी करुँगा,<verse eid="PSA 66:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 66:14" />जो मन्‍नै मुँह खोल कै मान्‍नी,</para>
  <para style="q" vid="PSA 66:14">अर मुसीबत के बखत कही थी।<verse eid="PSA 66:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 66:15" />मै तेरे ताहीं मोट्टे पशुआं की होमबलि,</para>
  <para style="q" vid="PSA 66:15">मिंढा की चर्बी की धूप समेत चढ़ाऊँगा;</para>
  <para style="q" vid="PSA 66:15">मै बकरां समेत बळध चढ़ाऊँगा।<verse eid="PSA 66:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 66:16" />हे परमेसवर के सारे भय मानण आळेयो, आकै सुणो,</para>
  <para style="q" vid="PSA 66:16">मै बताऊँगा की उसनै मेरी खात्तर के-के करया सै।<verse eid="PSA 66:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 66:17" />मन्‍नै उस ताहीं पुकारया,</para>
  <para style="q" vid="PSA 66:17">अर उस्से का गुणगान मेरे तै होया।<verse eid="PSA 66:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 66:18" />जै मै मन म्ह अनर्थ की बात सोचदा</para>
  <para style="q" vid="PSA 66:18">तो प्रभु मेरी ना सुणदा।<verse eid="PSA 66:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 66:19" />पर परमेसवर नै तो सुण्या सै;</para>
  <para style="q" vid="PSA 66:19">उसनै मेरी प्रार्थना की ओड़ ध्यान दिया सै।<verse eid="PSA 66:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 66:20" />धन्य सै परमेसवर,</para>
  <para style="q" vid="PSA 66:20">जिसनै ना तो मेरी प्रार्थना अनसुणी करी,</para>
  <para style="q" vid="PSA 66:20">अर ना मेरे तै अपणी करुणा दूर करी सै!<verse eid="PSA 66:20" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" sid="PSA 67" />
  <para style="s">धन्यवाद का भजन</para>
  <para style="d">प्रधान बजाण आळे खात्तर तारआळे बाज्यां कै गैल भजन, गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 67:1" />परमेसवर म्हारे पै अनुग्रह करै अर म्हारे ताहीं आशीष दे;</para>
  <para style="q" vid="PSA 67:1">वो म्हारे पै अपणे मुख का प्रकाश चमकावै। (सेला)<verse eid="PSA 67:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 67:2" />जिसतै तेरी गति धरती पै,</para>
  <para style="q" vid="PSA 67:2">अर तेरा करया होया उद्धार सारी जातियाँ म्ह जाण्या जावै।<verse eid="PSA 67:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 67:3" />हे परमेसवर, देश-देश के माणस तेरा धन्यवाद करै;</para>
  <para style="q" vid="PSA 67:3">देश-देश के सारे माणस तेरा धन्यवाद करै।<verse eid="PSA 67:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 67:4" />राज्य-राज्य के माणस खुशी मनावै,</para>
  <para style="q" vid="PSA 67:4">अर जयजयकार करै,</para>
  <para style="q" vid="PSA 67:4">क्यूँके तू देश-देश के माणसां का न्याय धर्म तै करैगा,</para>
  <para style="q" vid="PSA 67:4">अर धरती के राज्य-राज्य के माणसां की अगुवाई करैगा।<verse eid="PSA 67:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 67:5" />हे परमेसवर, देश-देश के माणस तेरा धन्यवाद करै;</para>
  <para style="q" vid="PSA 67:5">देश-देश के सारे माणस तेरा धन्यवाद करै।<verse eid="PSA 67:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 67:6" />धरती नै अपणी उपज दी सै,</para>
  <para style="q" vid="PSA 67:6">परमेसवर जो म्हारा परमेसवर सै, उसनै म्हारे ताहीं आशीष दी सै।<verse eid="PSA 67:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 67:7" />परमेसवर म्हारे ताहीं आशीष देवैगा;</para>
  <para style="q" vid="PSA 67:7">अर धरती के दूर-दूर देशां के सारे माणस उसका भय मान्‍नैगें।<verse eid="PSA 67:7" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" sid="PSA 68" />
  <para style="s">इस्राएल की जीत का गीत</para>
  <para style="d">प्रधान बजाण आळे खात्तर दाऊद का भजन, गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 68:1" />परमेसवर उठ्ठै, उसके दुश्मन तित्तर-बितर हों;</para>
  <para style="q" vid="PSA 68:1">अर उसके बैरी उसके स्याम्ही तै भाज जावै।<verse eid="PSA 68:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 68:2" />जिस तरियां धुम्मा उड़ जावै सै, उस्से तरियां ए तू उन ताहीं उड़ा दे;</para>
  <para style="q" vid="PSA 68:2">जिस तरियां मोम आग की आँच तै पिघळ जावै सै,</para>
  <para style="q" vid="PSA 68:2">उसे तरियां ए दुष्ट लोग परमेसवर की मौजूदगी तै नाश हों।<verse eid="PSA 68:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 68:3" />पर धर्मी खुश हों; वे परमेसवर के स्याम्ही प्रफुल्‍लित हों;</para>
  <para style="q" vid="PSA 68:3">वे आनन्द म्ह मगन हों!<verse eid="PSA 68:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 68:4" />परमेसवर का गीत गाओ, उसके नाम का भजन गाओ;</para>
  <para style="q" vid="PSA 68:4">जो निर्जल देशां म्ह<note caller="+" style="f"><char style="fr" closed="false">68:4 </char><char style="fq" closed="false">निर्जल देशां म्ह </char><char style="ft" closed="false">बादळां पै </char></note> सवार होकै चाल्‍लै सै,</para>
  <para style="q" vid="PSA 68:4">उस खात्तर सड़क बणाओ;</para>
  <para style="q" vid="PSA 68:4">उसका नाम यहोवा सै, इस खात्तर थम उसके स्याम्ही प्रफुल्‍लित हो!<verse eid="PSA 68:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 68:5" />परमेसवर अपणे पवित्र धाम म्ह,</para>
  <para style="q" vid="PSA 68:5">अनाथ्थां का पिता अर विधवाओं का रुखाळी<note caller="+" style="f"><char style="fr" closed="false">68:5 </char><char style="fq" closed="false">रुखाळी </char><char style="ft" closed="false">न्यायी</char></note> सै।<verse eid="PSA 68:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 68:6" />परमेसवर अनाथ्थां का घर बसावै सै;</para>
  <para style="q" vid="PSA 68:6">अर बन्दियाँ नै छुड़ाकै सम्पन्‍न करै सै;</para>
  <para style="q" vid="PSA 68:6">पर विद्रोहियाँ नै सूक्खी धरती पै रहणा पड़ै सै।<verse eid="PSA 68:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 68:7" />हे परमेसवर, जिब तू अपणी प्रजा कै आग्गै-आग्गै चाल्या था,</para>
  <para style="q" vid="PSA 68:7">जिब तू निर्जल धरती म्ह सेना समेत चाल्या,<verse eid="PSA 68:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 68:8" />फेर धरती काँप उठी,</para>
  <para style="q" vid="PSA 68:8">अर अकास भी परमेसवर के स्याम्ही टपकण लाग्या,</para>
  <para style="q" vid="PSA 68:8">ओड़ै सीनै पर्वत परमेसवर, हाँ इस्राएल के परमेसवर कै स्याम्ही काँप उठ्या।<verse eid="PSA 68:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 68:9" />हे परमेसवर, तन्‍नै भोत घणी बारिस करी;</para>
  <para style="q" vid="PSA 68:9">तेरा अपणा भाग तो भोत सूखा था, पर तन्‍नै उस ताहीं हरा-भरा करया सै;<verse eid="PSA 68:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 68:10" />तेरा झुण्ड उस म्ह बसण लाग्या;</para>
  <para style="q" vid="PSA 68:10">हे परमेसवर तन्‍नै अपणी भलाई तै दीन जन खात्तर तैयारी करी सै।<verse eid="PSA 68:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 68:11" />प्रभु हुकम देवै सै,</para>
  <para style="q" vid="PSA 68:11">फेर खुशखबरी सुणाण आळियाँ की बड़ी सेना हो जावै सै।<verse eid="PSA 68:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 68:12" />अपणी-अपणी सेना समेत राजा भागे जावै सै,</para>
  <para style="q" vid="PSA 68:12">अर घरबारण लूट नै बाँट लेवै सै।<verse eid="PSA 68:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 68:13" />के थम भेड्डां के बाड़े कै बीच लेट जाओगे?</para>
  <para style="q" vid="PSA 68:13">अर इसी कबूतरी की तरियां होगे जिसके पंख चाँदी तै</para>
  <para style="q" vid="PSA 68:13">अर जिसके पर पीळे सोन्‍ने तै मढ़े होए हों?<verse eid="PSA 68:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 68:14" />जिब सर्वशक्तिमान नै उस म्ह राजाओं ताहीं तित्तर-बितर करया,</para>
  <para style="q" vid="PSA 68:14">फेर जणु सल्‍मोन पर्वत पै बर्फ पड़ी।<verse eid="PSA 68:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 68:15" />बाशान का पहाड़ परमेसवर का पहाड़ सै;</para>
  <para style="q" vid="PSA 68:15">बाशान का पहाड़ भोत ऊँच्‍ची चोट्टी आळा पहाड़ सै।<verse eid="PSA 68:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 68:16" />पर हे ऊँच्‍ची चोट्टी आळे पाहाड़ों, थम क्यूँ उस पहाड़ नै घूरो हो,</para>
  <para style="q" vid="PSA 68:16">जिस ताहीं परमेसवर नै अपणे रहण खात्तर चाह्या सै,</para>
  <para style="q" vid="PSA 68:16">अर जित्त यहोवा सदा वास करे रहवैगा?<verse eid="PSA 68:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 68:17" />परमेसवर के रथ बीस हजार, बलके हजारों हजार सै;</para>
  <para style="q" vid="PSA 68:17">प्रभु उनकै बीच म्ह सै,</para>
  <para style="q" vid="PSA 68:17">जिस तरियां वो सीनै पहाड़ तै अपणे पवित्र जगहां म्ह सै।<verse eid="PSA 68:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 68:18" />तू ऊँच्‍चे पै चढ़ा, तू लोग्गां नै गुलाम्मी म्ह लेग्या;</para>
  <para style="q" vid="PSA 68:18">तन्‍नै माणसां तै, बलके हठीले माणसां तै भी भेंट ली,</para>
  <para style="q" vid="PSA 68:18">जिसतै यहोवा परमेसवर उन म्ह वास करै।<verse eid="PSA 68:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 68:19" />धन्य सै प्रभु, जो हर रोज म्हारा बोझ ठावै सै;</para>
  <para style="q" vid="PSA 68:19">वोए म्हारा उद्धारकर्ता परमेसवर सै।<verse eid="PSA 68:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 68:20" />वोए म्हारे खात्तर बचाण आळा परमेसवर ठैहरा;</para>
  <para style="q" vid="PSA 68:20">यहोवा प्रभु मौत तै भी बचावै सै।<verse eid="PSA 68:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 68:21" />पक्‍का परमेसवर अपणे दुश्मनां के सिर पै,</para>
  <para style="q" vid="PSA 68:21">अर जो अधर्म के राह पै चालदा रहवै सै,</para>
  <para style="q" vid="PSA 68:21">उसके बाळां तै भरी खोपड़ी पै मार-मार के उसनै चूर करैगा।<verse eid="PSA 68:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 68:22" />प्रभु नै कह्या सै, “मै उननै बाशान<note caller="+" style="f"><char style="fr" closed="false">68:22 </char><char style="fq" closed="false">बाशान </char><char style="ft" closed="false">देश का नाम</char></note> देश तै लिकाड़ लाऊँगा,</para>
  <para style="q" vid="PSA 68:22">मै उन ताहीं ढुंघे समुन्दर के तळै तै भी फेर ले आऊँगा,<verse eid="PSA 68:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 68:23" />ताके तू अपणे पायां नै लहू म्ह डुबोवै,</para>
  <para style="q" vid="PSA 68:23">अर तेरे दुश्मन तेरे कुत्याँ का भाग ठहरें।”<verse eid="PSA 68:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 68:24" />हे परमेसवर तेरी शोभायात्रा देक्खी गई,</para>
  <para style="q" vid="PSA 68:24">मेरे परमेसवर, अर मेरे राजा की शोभायात्रा पवित्र स्‍थान म्ह जान्दी होई दिखाई दी;<verse eid="PSA 68:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 68:25" />गाणआळे आग्गै-आग्गै अर तारआळे बाज्यां के बजाण आळे पाच्छै-पाच्छै गए,</para>
  <para style="q" vid="PSA 68:25">चारु ओड़ कुमारियाँ डफ बजावै थी।<verse eid="PSA 68:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 68:26" />सभाओं म्ह परमेसवर का,</para>
  <para style="q" vid="PSA 68:26">हे इस्राएल के चोए तै लिकड़े होए माणसों,</para>
  <para style="q" vid="PSA 68:26">प्रभु का धन्यवाद करो।<verse eid="PSA 68:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 68:27" />पैहला बिन्‍यामीन जो छोट्टा गोत्र सै,</para>
  <para style="q" vid="PSA 68:27">फेर यहूदा के हाकिम अर उसकी सभा</para>
  <para style="q" vid="PSA 68:27">अर जबूलून अर नप्ताली के हाकिम सै।<verse eid="PSA 68:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 68:28" />तेरे परमेसवर नै तेरी सामर्थ ताहीं बणाया सै,<note caller="+" style="f"><char style="fr" closed="false">68:28 </char><char style="fq" closed="false">तेरी सामर्थ ताहीं बणाया सै, </char><char style="ft" closed="false">हे परमेसवर तेरी सामर्थ दिखा</char></note></para>
  <para style="q" vid="PSA 68:28">हे परमेसवर, अपणी सामर्थ्य नै म्हारे पै जाहिर कर, जिसा तन्‍नै पैहले जाहिर करी थी।<verse eid="PSA 68:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 68:29" />तेरे मन्दर के कारण जो यरुशलेम म्ह सै,</para>
  <para style="q" vid="PSA 68:29">राजा तेरे खात्तर भेंट ले आवैंगे।<verse eid="PSA 68:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 68:30" />नरकटां म्ह रहण आळे जंगळी-पशुआं नै,</para>
  <para style="q" vid="PSA 68:30">खागड़ां के झुण्ड नै अर देश-देश के बाछड़ां नै झिड़क दे।</para>
  <para style="q" vid="PSA 68:30">वे चाँदी के टुकड़े लिये होए प्रणाम करैगें;</para>
  <para style="q" vid="PSA 68:30">जो माणस युद्ध तै खुश रहवै सै, उन ताहीं उसनै तित्तर-बितर करया सै।<verse eid="PSA 68:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 68:31" />मिस्र तै अधिकारी आवैंगे;</para>
  <para style="q" vid="PSA 68:31">कूश देश के लोग अपणे हाथ्थां नै परमेसवर की ओड़ फुर्ती तै फैलावैंगे।<verse eid="PSA 68:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 68:32" />हे धरती पै के राज्य-राज्य के लोगों परमेसवर का गीत गाओ;</para>
  <para style="q" vid="PSA 68:32">प्रभु का भजन गाओ,<verse eid="PSA 68:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 68:33" />जो सब तै ऊँच्‍चे सनातन सुर्ग म्ह सवार होकै चाल्‍लै सै;</para>
  <para style="q" vid="PSA 68:33">देक्खो वो अपणी वाणी सुणावै सै, वा गम्भीर वाणी शक्तिशाली सै।<verse eid="PSA 68:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 68:34" />परमेसवर की सामर्थ्य की बड़ाई करो,</para>
  <para style="q" vid="PSA 68:34">उसका प्रताप इस्राएल पर छाया होया सै,</para>
  <para style="q" vid="PSA 68:34">अर उसकी सामर्थ्य आकाशमण्‍डल म्ह सै।<verse eid="PSA 68:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 68:35" />हे परमेसवर, तू अपणे पवित्रस्‍थानां म्ह अदभुत सै,</para>
  <para style="q" vid="PSA 68:35">इस्राएल का परमेसवर ए अपणी प्रजा नै सामर्थ्य अर शक्ति का देण आळा सै।</para>
  <para style="q" vid="PSA 68:35">परमेसवर धन्य सै।<verse eid="PSA 68:35" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" sid="PSA 69" />
  <para style="s">संकट म्ह मदद खात्तर पुकार</para>
  <para style="d">प्रधान बजाण आळे खात्तर शोशन्‍नीम राग म्ह दाऊद का गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 69:1" />हे परमेसवर, मेरा उद्धार कर, मै पाणी म्ह डूब्या जाऊँ सूं।<verse eid="PSA 69:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 69:2" />मै घणी दलदल म्ह धस्या जाऊँ सूं, अर मेरे पैर किते ना रुकते;</para>
  <para style="q" vid="PSA 69:2">मै ढुंघे पाणी म्ह आ ग्या, अर धारा म्ह डूब्या जाऊँ सूं।<verse eid="PSA 69:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 69:3" />मै पुकारदे-पुकारदे थक ग्या, मेरा गला सूख ग्या सै;</para>
  <para style="q" vid="PSA 69:3">अपणे परमेसवर की बाट देखदे-देखदे मेरी आँख धुँधळी पड़गी सै।<verse eid="PSA 69:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 69:4" />जो बिना बात के मेरे बैरी सै, वे गिणती म्ह मेरे सिर के बाळां तै भी घणे सै;</para>
  <para style="q" vid="PSA 69:4">मेरा नाश करण आळे जो बेवजह मेरे दुश्मन सै, वे सामर्थी सै,</para>
  <para style="q" vid="PSA 69:4">इस करकै जो मन्‍नै लूट्या न्ही वो भी मन्‍नै देणा पड्या।<verse eid="PSA 69:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 69:5" />हे परमेसवर, तू तो मेरी बेकूफी नै जाणै सै,</para>
  <para style="q" vid="PSA 69:5">अर मेरे दोष तेरे तै लुह्के न्ही सै।<verse eid="PSA 69:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 69:6" />हे प्रभु, हे सेनाओं के यहोवा, जो तेरी बाट देक्खै सै, वे मेरे कारण शर्मिन्दा ना होवै,</para>
  <para style="q" vid="PSA 69:6">हे इस्राएल के परमेसवर, जो तेरे ताहीं ढूँढै सै, वे मेरे कारण शर्मिन्दा ना होवै।<verse eid="PSA 69:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 69:7" />तेरे ए कारण मेरी बुराई होई सै,</para>
  <para style="q" vid="PSA 69:7">अर मेरा मुँह शर्मिन्दगी तै ढँक्या सै।<verse eid="PSA 69:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 69:8" />मै अपणे भाईयाँ कै स्याम्ही अजनबी होया,</para>
  <para style="q" vid="PSA 69:8">अर अपणे सगे भाईयाँ की निगांह म्ह परदेशी बण्या सूं।<verse eid="PSA 69:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 69:9" />क्यूँके मै तेरे भवन के निमित्त जळदे-जळदे भस्‍म होया,</para>
  <para style="q" vid="PSA 69:9">अर जो बुराई वे तेरी करै सै, वाए बुराई मेरे ताहीं सहणी पड़ी सै।<verse eid="PSA 69:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 69:10" />जब मै रोकै अर उपवास करकै दुख ठाया करदा,<note caller="+" style="f"><char style="fr" closed="false">69:10 </char><char style="fq" closed="false">जब मै रोकै अर उपवास करकै दुख ठाया करदा, </char><char style="ft" closed="false">मन्‍नै उपवास करकै अपणे-आप ताहीं नरम बणाया</char></note></para>
  <para style="q" vid="PSA 69:10">फेर उसतै भी मेरी बदनाम्मी ए होई।<verse eid="PSA 69:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 69:11" />अर जिब मै टाट के लत्तें पैहरे था,</para>
  <para style="q" vid="PSA 69:11">तो मै उनकै खात्तर एक उदाहरण बणग्या।<verse eid="PSA 69:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 69:12" />फाटक के धोरै बैठ्ठण आळे मेरे बारै म्ह बातचीत करै सै,</para>
  <para style="q" vid="PSA 69:12">अर मदिरा पीण आळे मेरे चुभ्दा होया गीत गावै सै<verse eid="PSA 69:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 69:13" />पर हे यहोवा, मेरी प्रार्थना तो तेरी प्रसन्‍नता के बखत म्ह होण लागरी सै;</para>
  <para style="q" vid="PSA 69:13">हे परमेसवर अपणी घणी करुणा तै,</para>
  <para style="q" vid="PSA 69:13">अर बचाण की अपणी सच्‍ची प्रतिज्ञा कै मुताबिक मेरी सुण ले।<verse eid="PSA 69:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 69:14" />मेरे ताहीं दलदल म्ह तै उभार, ताके मै धस ना जाऊँ;</para>
  <para style="q" vid="PSA 69:14">मै अपणे बैरियाँ तै, अर ढुंघे पाणी म्ह तै बच जाऊँ।<verse eid="PSA 69:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 69:15" />मै धारा म्ह डूब ना जाऊँ,</para>
  <para style="q" vid="PSA 69:15">अर ना मै गहरे जल म्ह डूब मरुँ,</para>
  <para style="q" vid="PSA 69:15">अर ना पाताळ का मुँह मेरे उप्पर बन्‍द हो।<verse eid="PSA 69:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 69:16" />हे यहोवा, मेरी सुण ले, क्यूँके तेरी दया उत्तम सै;</para>
  <para style="q" vid="PSA 69:16">अपणी दया की भरपूरी कै मुताबिक मेरी ओड़ ध्यान दे।<verse eid="PSA 69:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 69:17" />अपणे दास तै अपणा मुँह ना मोड़;</para>
  <para style="q" vid="PSA 69:17">क्यूँके मै संकट म्ह सूं, फुर्ती तै मेरी सुण ले।<verse eid="PSA 69:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 69:18" />मेरै धोरै आकै मन्‍नै छुड़ाले,</para>
  <para style="q" vid="PSA 69:18">मेरे दुश्मनां तै मन्‍नै छुटकारा दे।<verse eid="PSA 69:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 69:19" />मेरी बदनाम्मी, शर्म अर अनादर नै तू जाणै सै:</para>
  <para style="q" vid="PSA 69:19">मेरे सारे बिरोधी तेरै स्याम्ही सै।<verse eid="PSA 69:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 69:20" />मेरा दिल बदनाम्मी कै कारण टूट ग्या, अर मै भोत उदास हूँ।</para>
  <para style="q" vid="PSA 69:20">मन्‍नै किसे तरस खाण आळे की आस तो करी,</para>
  <para style="q" vid="PSA 69:20">पर किसे ताहीं न्ही पाया,</para>
  <para style="q" vid="PSA 69:20">अर शान्ति देण आळे ताहीं ढूँढ़दा तो रहया, पर कोए न्ही मिल्या।<verse eid="PSA 69:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 69:21" />अर माणसां नै मेरे ताहीं खाण खात्तर जहर दिया,</para>
  <para style="q" vid="PSA 69:21">अर मेरी प्‍यास बुझाण खात्तर मेरे ताहीं सिरका पिलाया।<verse eid="PSA 69:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 69:22" />उनका खाणा उनकै खात्तर फन्‍दा हो जावै;</para>
  <para style="q" vid="PSA 69:22">अर उनके सुख के बखत<note caller="+" style="f"><char style="fr" closed="false">69:22 </char><char style="fq" closed="false">सुख के बखत </char><char style="ft" closed="false">बलिदान की दावत</char></note> जाळ बण जावै।<verse eid="PSA 69:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 69:23" />उनकी आँखां पै अन्धेरा छा जावै, ताके वे देख ना सकै;</para>
  <para style="q" vid="PSA 69:23">अर तू उनकी कमर नै लगातार कँपाता रह।<verse eid="PSA 69:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 69:24" />उनके उप्पर अपणा रोष भड़का,</para>
  <para style="q" vid="PSA 69:24">अर तेरे छो की आँच उनकै लाग्गै।<verse eid="PSA 69:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 69:25" />उनकी छावणी उजड़ जावै,</para>
  <para style="q" vid="PSA 69:25">उनके डेरां म्ह कोए ना रहवै।<verse eid="PSA 69:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 69:26" />क्यूँके जिस ताहीं तन्‍नै मारया, वे उसकै पाच्छै पड़े सै,</para>
  <para style="q" vid="PSA 69:26">अर जिन ताहीं तन्‍नै घायल करया, वे उनके दर्द की चर्चा करै सै।<verse eid="PSA 69:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 69:27" />उनके अधर्म पै अधर्म बढ़ा;</para>
  <para style="q" vid="PSA 69:27">अर वे तेरे धर्म नै पा न्ही सके।<verse eid="PSA 69:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 69:28" />उनका नाम जीवन की किताब म्ह तै काटया जावै,</para>
  <para style="q" vid="PSA 69:28">अर धर्मियों के संग लिख्या ना जावै।<verse eid="PSA 69:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 69:29" />पर मै तो दुखी अर पीड़ित हूँ,</para>
  <para style="q" vid="PSA 69:29">इस करकै हे परमेसवर, तू मेरा उद्धार करकै मेरे ताहीं ऊँच्‍ची जगहां पै बिठा।<verse eid="PSA 69:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 69:30" />मै गीत गाकै तेरे नाम की स्तुति करुँगा,</para>
  <para style="q" vid="PSA 69:30">अर धन्यवाद करदा होया तेरी बड़ाई करुँगा।<verse eid="PSA 69:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 69:31" />यहोवा नै यो बळध तै घणा,</para>
  <para style="q" vid="PSA 69:31">बलके सींग अर खुराआळे बळध तै भी घणा भावैगा।<verse eid="PSA 69:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 69:32" />नम्र लोग इस ताहीं देखकै खुश होवैंगे,</para>
  <para style="q" vid="PSA 69:32">हे परमेसवर के खोजियों थारा मन हरा हो जावै।<verse eid="PSA 69:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 69:33" />क्यूँके यहोवा गरीबां की ओड़ कान लगावै सै,</para>
  <para style="q" vid="PSA 69:33">अर अपणे माणसां नै जो बन्दी सै तुच्छ न्ही जाणदा।<verse eid="PSA 69:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 69:34" />सुर्ग अर धरती उसकी बड़ाई करै,</para>
  <para style="q" vid="PSA 69:34">अर समुन्दर अपणे सारे जीव जन्‍तुओं समेत उसकी बड़ाई करै।<verse eid="PSA 69:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 69:35" />क्यूँके परमेसवर सिय्योन का उद्धार करैगा,</para>
  <para style="q" vid="PSA 69:35">अर यहूदा के नगरां नै फेर बसावैगा;</para>
  <para style="q" vid="PSA 69:35">अर लोग फेर ओड़ै बसकै उसके अधिकारी हो जावैंगे।<verse eid="PSA 69:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 69:36" />उन्हे दास्सां के वंश उस ताहीं अपणे भाग म्ह पावैगा,</para>
  <para style="q" vid="PSA 69:36">अर उन्हे के नाम के प्रेमी उस म्ह वास करैगें।<verse eid="PSA 69:36" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" sid="PSA 70" />
  <para style="s">मदद खात्तर प्रार्थना</para>
  <para style="d">प्रधान बजाण आळे खात्तर: याद कराण खात्तर दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 70:1" />हे परमेसवर मेरे ताहीं छुड़ाण खात्तर, हे यहोवा मेरी मदद करण खात्तर फुर्ती कर।<verse eid="PSA 70:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 70:2" />जो मेरी जान के दुश्मन सै,</para>
  <para style="q" vid="PSA 70:2">वे शर्मसार अर अपमानित हो जावै!</para>
  <para style="q" vid="PSA 70:2">जो मेरे नुकसान तै खुश होवै सै,</para>
  <para style="q" vid="PSA 70:2">वे पाच्छै हटाए अर निरादर करे जावै।<verse eid="PSA 70:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 70:3" />जो कहवै सै, “आहा, आहा!”</para>
  <para style="q" vid="PSA 70:3">वे अपणी शर्म के मारे उलटे बोहड़ जावै।<verse eid="PSA 70:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 70:4" />जितने तन्‍नै ढूँढ़ै सै, वे सब तेरे कारण खुश अर मगन हों!</para>
  <para style="q" vid="PSA 70:4">अर जो तेरा उद्धार चाहवै सै, वे लगातार कहन्दे रहवै, “परमेसवर की बड़ाई हो!”<verse eid="PSA 70:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 70:5" />मै तो दीन अर दरिद्र सूं;</para>
  <para style="q" vid="PSA 70:5">हे परमेसवर मेरे खात्तर तगाजा कर!</para>
  <para style="q" vid="PSA 70:5">तू मेरा मददगार अर छुड़ाण आळा सै;</para>
  <para style="q" vid="PSA 70:5">हे यहोवा देर ना करै!<verse eid="PSA 70:5" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" sid="PSA 71" />
  <para style="s">एक बुजुर्ग की प्रार्थना</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 71:1" />हे यहोवा, मै तेरा शरणागत सूं;</para>
  <para style="q" vid="PSA 71:1">मन्‍नै शर्मिन्दा ना होण दे!<verse eid="PSA 71:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 71:2" />तू तो धर्मी सै, मेरे ताहीं छुड़ा अर मेरा उद्धार कर;</para>
  <para style="q" vid="PSA 71:2">मेरी ओड़ कान लगा, अर मेरा उद्धार कर!<verse eid="PSA 71:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 71:3" />मेरे खात्तर सनातन काल की चट्टान का धाम बण, जिस म्ह मै हर बखत जा सकूँ;</para>
  <para style="q" vid="PSA 71:3">तन्‍नै मेरे उद्धार का हुकम तो दिया सै,</para>
  <para style="q" vid="PSA 71:3">क्यूँके तू मेरी चट्टान अर मेरा गढ़ ठहरया सै।<verse eid="PSA 71:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 71:4" />हे मेरे परमेसवर, दुष्ट,</para>
  <para style="q" vid="PSA 71:4">कुटिल अर जुलमी माणस कै हाथ तै मेरी हिफाजत कर।<verse eid="PSA 71:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 71:5" />क्यूँके हे प्रभु यहोवा, मै तेरी ए बाट देख्दा आया सूं;</para>
  <para style="q" vid="PSA 71:5">बचपन तै तू ए मेरा आधार सै।<verse eid="PSA 71:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 71:6" />मै गर्भ तै लिकड़दे, तेरे जरिये सम्भाळया गया;</para>
  <para style="q" vid="PSA 71:6">मेरे ताहीं माँ की कोख तैए तन्‍नै लिकाड्या;</para>
  <para style="q" vid="PSA 71:6">इस करकै मै हर बखत तेरी बड़ाई करदा रहूँगा।।<verse eid="PSA 71:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 71:7" />मै घण्या खात्तर चमत्कार बण्या सूं;</para>
  <para style="q" vid="PSA 71:7">पर तू मेरा दृढ़ शरणस्‍थान सै।<verse eid="PSA 71:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 71:8" />मेरे मुँह तै तेरे गुणगान,</para>
  <para style="q" vid="PSA 71:8">अर दिन भर तेरी शोभा का जिक्र भोत होया करै।<verse eid="PSA 71:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 71:9" />बुढ़ापे कै बखत मन्‍नै त्यागै ना;</para>
  <para style="q" vid="PSA 71:9">जिब मेरी ताकत घटै तब मेरे ताहीं छोड़ै ना।<verse eid="PSA 71:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 71:10" />क्यूँके मेरे दुश्मन मेरै बारै म्ह बात करै सै,</para>
  <para style="q" vid="PSA 71:10">अर जो मेरे प्राण की ताक म्ह सै,</para>
  <para style="q" vid="PSA 71:10">वे आप्पस म्ह या सलाह मिलावै सै, के<verse eid="PSA 71:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 71:11" />परमेसवर नै उस ताहीं छोड़ दिया सै;</para>
  <para style="q" vid="PSA 71:11">उसका पिच्छा करकै उसनै पकड़ ल्यो, क्यूँके उसका कोए छुड़ाण आळा कोन्या।<verse eid="PSA 71:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 71:12" />हे परमेसवर, मेरे तै दूर ना रहवै;</para>
  <para style="q" vid="PSA 71:12">हे मेरे परमेसवर, मेरी मदद खात्तर फुर्ती कर।<verse eid="PSA 71:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 71:13" />जो मेरे प्राण के बिरोधी सै, वे शर्मिन्दा हो</para>
  <para style="q" vid="PSA 71:13">अर उनका अन्त हो जावै;</para>
  <para style="q" vid="PSA 71:13">जो मेरे नुकसान के अभिलाषी सै, वे बदनामी</para>
  <para style="q" vid="PSA 71:13">अर अनादर म्ह गड़ जावै।<verse eid="PSA 71:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 71:14" />मै लगातार आस लगाऐ रहूँगा,</para>
  <para style="q" vid="PSA 71:14">अर तेरी बड़ाई और घणी करदा जाऊँगा।<verse eid="PSA 71:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 71:15" />मै अपणे मुँह तै तेरी धार्मिकता का,</para>
  <para style="q" vid="PSA 71:15">अर तेरे करे होए उद्धार का जिक्र दिन भर करदा रहूँगा,</para>
  <para style="q" vid="PSA 71:15">पर उनका पूरा लेखा-जोखा मेरी समझ तै परै सै।<verse eid="PSA 71:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 71:16" />मै प्रभु यहोवा के पराक्रम के काम्मां नै बयान करदा होया आऊँगा,</para>
  <para style="q" vid="PSA 71:16">मै केवल तेरी ए धार्मिकता की चर्चा करया करुँगा।<verse eid="PSA 71:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 71:17" />हे परमेसवर, तू तो मेरे ताहीं बचपन तै ए सिखान्दा आया सै,</para>
  <para style="q" vid="PSA 71:17">अर इब ताहीं मै तेरे बड़े-बड़े काम्मां का प्रचार करदा आया सूं।<verse eid="PSA 71:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 71:18" />इस करकै हे परमेसवर जद मै बूढ़ा हो जाऊँ</para>
  <para style="q" vid="PSA 71:18">अर मेरे बाळ धोळे हो जावै, फेर भी तू मन्‍नै ना छोड़िए,</para>
  <para style="q" vid="PSA 71:18">जिब तक मै आण आळी पीढ़ी के माणसां नै</para>
  <para style="q" vid="PSA 71:18">तेरा बाहुबल अर सब पैदा होण आळयां नै तेरा पराक्रम सुणाऊँ।<verse eid="PSA 71:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 71:19" />हे परमेसवर, तेरी धार्मिकता घणी महान सै।</para>
  <para style="q" vid="PSA 71:19">तू जिसनै बड़े-बड़े काम करे सै,</para>
  <para style="q" vid="PSA 71:19">हे परमेसवर तेरै बराबर कौण सै?<verse eid="PSA 71:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 71:20" />तन्‍नै तो म्हारे ताहीं भोत-से दुख दिखाए सै</para>
  <para style="q" vid="PSA 71:20">पर इब तू फिर तै म्हारे ताहीं जिवावैगा;</para>
  <para style="q" vid="PSA 71:20">अर धरती के गहरे खड्डे म्ह तै उभार लेगा।<verse eid="PSA 71:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 71:21" />तू मेरा आदर-मान बढ़ावैगा,</para>
  <para style="q" vid="PSA 71:21">अर फिर तै मेरे ताहीं शान्ति देवैगा<verse eid="PSA 71:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 71:22" />हे मेरे परमेसवर,</para>
  <para style="q" vid="PSA 71:22">मै भी तेरी सच्‍चाई का धन्यवाद सारंगी बजाकै गाऊँगा;</para>
  <para style="q" vid="PSA 71:22">हे इस्राएल के पवित्र मै वीणा बजाकै तेरा भजन गाऊँगा।<verse eid="PSA 71:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 71:23" />जिब मै तेरा भजन गाऊँगा, तब अपणे मुँह तै</para>
  <para style="q" vid="PSA 71:23">अर अपणी जान तै भी जो तन्‍नै बचा ली सै, जयजयकार करुँगा।<verse eid="PSA 71:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 71:24" />अर मै तेरी धार्मिकता की चर्चा दिन भर करदा रहूँगा;</para>
  <para style="q" vid="PSA 71:24">क्यूँके जो मेरे नुकसान के अभिलाषी थे,</para>
  <para style="q" vid="PSA 71:24">वे शर्मिन्दा अर बेजत होए।<verse eid="PSA 71:24" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" sid="PSA 72" />
  <para style="s">धर्मी राजा के शासनकाल की महिमा</para>
  <para style="d">सुलैमान का गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 72:1" />हे परमेसवर, राजा नै अपणा नियम बता,</para>
  <para style="q" vid="PSA 72:1">राजपुत्र नै अपणा धार्मिकता सिखा।<verse eid="PSA 72:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 72:2" />वो तेरी प्रजा का न्याय धार्मिकता तै,</para>
  <para style="q" vid="PSA 72:2">अर तेरे दीन माणसां का न्याय ठीक-ठीक चुकावैगा।<verse eid="PSA 72:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 72:3" />पहाड़ां अर पहाड़ियाँ तै प्रजा खात्तर,</para>
  <para style="q" vid="PSA 72:3">धार्मिकता के जरिए शान्ति मिल्या करैगी<verse eid="PSA 72:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 72:4" />वो प्रजा के दीन माणसां का न्याय करैगा, अर दरिद्र माणसां नै बचावैगा;</para>
  <para style="q" vid="PSA 72:4">अर अन्धेर करण आळयां नै चूर करैगा।<verse eid="PSA 72:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 72:5" />जिब ताहीं सूरज अर चाँद बणे रहवैगें</para>
  <para style="q" vid="PSA 72:5">तब तक लोग पीढ़ी-पीढ़ी ताहीं जिन्दा रहवैगें<note caller="+" style="f"><char style="fr" closed="false">72:5 </char><char style="fq" closed="false">जिन्दा रहवैगें </char><char style="ft" closed="false">तेरा भय मानते रहवैगें </char></note>।<verse eid="PSA 72:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 72:6" />वो घास की खूँटी पै बरसण आळे मिह,</para>
  <para style="q" vid="PSA 72:6">अर धरती सिच्‍चण आळी झाड़ियाँ की तरियां होवैगा।<verse eid="PSA 72:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 72:7" />उस राजा के बखत म्ह धार्मिकता<note caller="+" style="f"><char style="fr" closed="false">72:7 </char><char style="fq" closed="false">धार्मिकता </char><char style="ft" closed="false">धर्मी फुल्‍लै फळैगें</char></note> फूल्‍लै-फळैगी,</para>
  <para style="q" vid="PSA 72:7">अर जिब तक चाँद बण्या रहवैगा, तब ताहीं शान्ति बणी रहवैगी।<verse eid="PSA 72:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 72:8" />वो समुन्दर तै समुन्दर तक</para>
  <para style="q" vid="PSA 72:8">अर बड़ी नदी तै धरती की छोर तक राज करैगा।<verse eid="PSA 72:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 72:9" />उसके स्याम्ही जंगळ के रहण आळे<note caller="+" style="f"><char style="fr" closed="false">72:9 </char><char style="fq" closed="false">जंगळ के रहण आळे </char><char style="ft" closed="false">उसके दुश्मन</char></note> घुटने टेक्‍कैंगे,</para>
  <para style="q" vid="PSA 72:9">अर उसके दुश्मन माट्टी चाटैंगे।<verse eid="PSA 72:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 72:10" />तर्शीश देश अर द्वीप-द्वीप के राजा भेंट ले आवैंगे,</para>
  <para style="q" vid="PSA 72:10">शेबा अर सबा देश के राजा उपहार पोहचावैंगे।<verse eid="PSA 72:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 72:11" />सारे राजा उस ताहीं दण्डवत करैगें,</para>
  <para style="q" vid="PSA 72:11">जात्ति-जात्ति के माणस उसकै अधीन हो जावैंगे।<verse eid="PSA 72:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 72:12" />क्यूँके वो दोहाई देण आळे दरिद्र नै,</para>
  <para style="q" vid="PSA 72:12">अर दुखी अर बेसहारा माणसां का उद्धार करैगा।<verse eid="PSA 72:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 72:13" />वो कंगाल अर दरिद्र पै तरस खावैगा,</para>
  <para style="q" vid="PSA 72:13">अर दरिद्रां के प्राणां नै बचावैगा।<verse eid="PSA 72:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 72:14" />वो उनके प्राणां नै जुल्म अर उपद्रव तै छुड़ा लेवैगा;</para>
  <para style="q" vid="PSA 72:14">अर उनका लहू<note caller="+" style="f"><char style="fr" closed="false">72:14 </char><char style="fq" closed="false">उनका लहू </char><char style="ft" closed="false">उनका जीवन</char></note> उसकी नजर म्ह अनमोल ठहरैगा।<verse eid="PSA 72:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 72:15" />वो तो जिन्दा रहवैगा, अर शेबा के सोन्‍ने म्ह तै उस ताहीं दिया जावैगा।</para>
  <para style="q" vid="PSA 72:15">लोग उस खात्तर हर बखत प्रार्थना करैंगे;</para>
  <para style="q" vid="PSA 72:15">अर दिन भर उस ताहीं धन्य कहते रहवैंगे।<verse eid="PSA 72:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 72:16" />देश म्ह पहाड़ां की चोटियां पै भोत सा नाज होवैगा;</para>
  <para style="q" vid="PSA 72:16">जिसकी बालें लबानोन के देवदारां की तरियां झूम्मैगी;</para>
  <para style="q" vid="PSA 72:16">अर नगर के माणस घास की तरियां लहलावैंगे।<verse eid="PSA 72:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 72:17" />उसका नाम सदा-सदा बण्या रहवैगा;</para>
  <para style="q" vid="PSA 72:17">जिब तक सूरज बण्या रहवैगा, तब ताहीं उसका नाम हमेशा नया होन्दा रहवैगा,</para>
  <para style="q" vid="PSA 72:17">अर लोग अपणे-आपनै उसके कारण धन्य गिणैगे,</para>
  <para style="q" vid="PSA 72:17">सारी जातियाँ उस ताहीं भाग्‍यवान कहवैगी।<verse eid="PSA 72:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 72:18" />धन्य सै, यहोवा परमेसवर, जो इस्राएल का परमेसवर सै;</para>
  <para style="q" vid="PSA 72:18">चमत्कार सिर्फ वोए करै सै।<verse eid="PSA 72:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 72:19" />उसका महिमायुक्‍त नाम सदा धन्य रहवैगा;</para>
  <para style="q" vid="PSA 72:19">अर सारी धरती महिमा तै भरपूर हो जावैगी।</para>
  <para style="q" vid="PSA 72:19">आमीन फेर आमीन।<verse eid="PSA 72:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 72:20" />यिशै के बेट्टे दाऊद की प्रार्थना खतम होई।<verse eid="PSA 72:20" /></para>
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" sid="PSA 73" />
  <para style="ms">तीसरा भाग</para>
  <para style="mr">
    <ref loc="PSA 73-89">भजन संहिता 73-89</ref></para>
  <para style="s">परमेसवर का न्याय</para>
  <para style="d">आसाप का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 73:1" />सचमुच इस्राएल खात्तर मतलब शुद्ध मन आळयां खात्तर परमेसवर भला सै।<verse eid="PSA 73:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 73:2" />मेरे कदम तो उखड़ना चाहवै थे,</para>
  <para style="q" vid="PSA 73:2">मेरे कदम फिसळण पैए थे।<verse eid="PSA 73:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 73:3" />क्यूँके जिब मै दुष्टां की सलामती देक्खूँ था,</para>
  <para style="q" vid="PSA 73:3">फेर उन घमण्डियाँ कै बारै म्ह जळण करुँ था।<verse eid="PSA 73:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 73:4" />क्यूँके उनकी मौत म्ह तकलीफ न्ही होन्दी,</para>
  <para style="q" vid="PSA 73:4">पर उनकी ताकत अटूट रहवै सै।<verse eid="PSA 73:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 73:5" />उननै दुसरे माणसां की तरियां दुख न्ही होन्दा;</para>
  <para style="q" vid="PSA 73:5">अर दुसरे माणसां की तरियां उनपै मुसीबत न्ही पड़दी।<verse eid="PSA 73:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 73:6" />इस कारण घमण्ड उनके गळे का हार बण्या सै;</para>
  <para style="q" vid="PSA 73:6">उनका ओढ़णा उपद्रव सै।<verse eid="PSA 73:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 73:7" />उनकी आँखां पै चर्बी चढ़री सै,</para>
  <para style="q" vid="PSA 73:7">उनकी मन की भावनाएँ उमड़ै सै।<verse eid="PSA 73:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 73:8" />वे मजाक करै सै, अर दुष्टता तै अन्धेर की बात बोल्‍लै सै;</para>
  <para style="q" vid="PSA 73:8">वे डींग मारै सै।<verse eid="PSA 73:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 73:9" />वे जणु सुर्ग म्ह बेठ्ठे होए बोल्‍लै सै,</para>
  <para style="q" vid="PSA 73:9">अर वे धरती पै बोलदे फिरै सै।<verse eid="PSA 73:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 73:10" />फेर भी उसकी प्रजा उरै उलटी बोहड़ आवैगी,</para>
  <para style="q" vid="PSA 73:10">अर उन ताहीं भरे होए प्‍याल्‍ले का पाणी मिलैगा।<verse eid="PSA 73:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 73:11" />फेर वो कहवै सै, “परमेसवर किस तरियां जाणै सै?</para>
  <para style="q" vid="PSA 73:11">के परमप्रधान नै कुछ ज्ञान सै?”<verse eid="PSA 73:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 73:12" />देक्खो, ये तो दुष्ट माणस सै;</para>
  <para style="q" vid="PSA 73:12">फेर भी सदा आराम तै रहकै, धन-सम्पत्ति बटोरते रहवै सै।<verse eid="PSA 73:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 73:13" />हाँ, मन्‍नै अपणे दिल ताहीं बेकार म्ह शुद्ध करया</para>
  <para style="q" vid="PSA 73:13">अर अपणे हाथ निर्दोषता म्ह धोए सै;<verse eid="PSA 73:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 73:14" />क्यूँके मै दिन भर मार खान्दा आया सूं</para>
  <para style="q" vid="PSA 73:14">अर हर रोज सबेरै मेरी ताड़ना होन्दी आई सै।<verse eid="PSA 73:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 73:15" />जै मन्‍नै कह्या होन्दा के “मै इसाए कहूँगा,”</para>
  <para style="q" vid="PSA 73:15">तो देख मै तेरी औलाद कै गैल कपट करदा,<verse eid="PSA 73:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 73:16" />जिब मै सोच्‍चण लाग्या के इस ताहीं मै किस तरियां समझूँ,</para>
  <para style="q" vid="PSA 73:16">तो या मेरी नजर म्ह घणी बड़ी समस्या थी,<verse eid="PSA 73:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 73:17" />जिब तक मन्‍नै परमेसवर के पवित्र स्‍थान म्ह जाकै</para>
  <para style="q" vid="PSA 73:17">उन माणसां के नतिज्जें के बारै म्ह ना सोच्‍चा।<verse eid="PSA 73:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 73:18" />पक्‍का तू उननै फिसळण आळी जगहां म्ह राक्खै सै;</para>
  <para style="q" vid="PSA 73:18">अर गेरकै सत्यानाश कर देवै सै।<verse eid="PSA 73:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 73:19" />वे पलभर म्ह किस तरियां उजड़गे सै!</para>
  <para style="q" vid="PSA 73:19">वे मिटगे, वे डरदे-डरदे नाश होगे सै।<verse eid="PSA 73:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 73:20" />जिस तरियां जागण आळा सपने नै तुच्छ जाणै सै,</para>
  <para style="q" vid="PSA 73:20">उसे तरियां ए प्रभु जिब तू उठ्ठैगा, तब उन ताहीं छाया की तरियां समझकै तुच्छ जाणैगा।<verse eid="PSA 73:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 73:21" />मेरा मन तो कड़वा होग्या था,</para>
  <para style="q" vid="PSA 73:21">मेरा अन्‍त:करण छिद ग्या था,<verse eid="PSA 73:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 73:22" />मै तो अज्ञानी अर नासमझ था,</para>
  <para style="q" vid="PSA 73:22">मै तो तेरे स्याम्ही पशु की ढाळ था।<verse eid="PSA 73:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 73:23" />फेर भी मै लगातार तेरै गैल था;</para>
  <para style="q" vid="PSA 73:23">तन्‍नै मेरे सोळे हाथ ताहीं पकड़े राख्या।<verse eid="PSA 73:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 73:24" />तू सलाह देन्दा होया, मेरी अगुवाई करैगा,</para>
  <para style="q" vid="PSA 73:24">अर तब मेरी महिमा करकै मेरे ताहीं अपणे धोरै राक्खैगा।<verse eid="PSA 73:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 73:25" />सुर्ग म्ह मेरा और कौण सै?</para>
  <para style="q" vid="PSA 73:25">तेरै गैल रहन्दे होए मै धरती पै और कुछ न्ही चाहन्दा।<verse eid="PSA 73:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 73:26" />मेरी देह अर मन दोन्‍नु तो हारगे सै,</para>
  <para style="q" vid="PSA 73:26">पर परमेसवर सदा खात्तर मेरा भाग</para>
  <para style="q" vid="PSA 73:26">अर मेरे दिल की ताकत<note caller="+" style="f"><char style="fr" closed="false">73:26 </char><char style="fq" closed="false">ताकत </char><char style="ft" closed="false">चट्टान </char></note> बण्या सै।<verse eid="PSA 73:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 73:27" />जो तेरे तै दूर रहवै सै वो तो नाश होवैंगे;</para>
  <para style="q" vid="PSA 73:27">जो कोए तेरे खिलाफ जारी करै सै,</para>
  <para style="q" vid="PSA 73:27">उसनै तू नाश करै सै।<verse eid="PSA 73:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 73:28" />पर परमेसवर के धोरै रहणा, योए मेरे खात्तर भला सै;</para>
  <para style="q" vid="PSA 73:28">मन्‍नै प्रभु यहोवा ताहीं अपणा शरणस्‍थान मान्या सै,</para>
  <para style="q" vid="PSA 73:28">जिसतै मै तेरे सारे काम्मां का जिक्र करुँ।<verse eid="PSA 73:28" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" sid="PSA 74" />
  <para style="s">उत्पीड़कां तै राहत खात्तर प्रार्थना</para>
  <para style="d">आसाप का मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 74:1" />हे परमेसवर, तन्‍नै म्हारे ताहीं क्यूँ सदा खात्तर छोड़ दिया सै?</para>
  <para style="q" vid="PSA 74:1">तेरी कोपाग्‍नि का धुम्मा तेरी चराई की भेड्डां कै खिलाफ क्यूँ उठ्ठण लागरया सै?<verse eid="PSA 74:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 74:2" />अपणी मण्डळी नै जिस ताहीं तन्‍नै पुराणे बखत म्ह मोल लिया था,</para>
  <para style="q" vid="PSA 74:2">अर अपणे निज भाग का गोत्र होण खात्तर छुड़ा लिया था,</para>
  <para style="q" vid="PSA 74:2">अर इस सिय्योन पर्वत ताहीं भी, जिसपै तू रहया था, याद कर!<verse eid="PSA 74:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 74:3" />अपणे कदम अनन्त के खण्डहरां की ओड़ बढ़ा;</para>
  <para style="q" vid="PSA 74:3">मतलब उन सारी बुराइयां की ओड़ जो दुश्मन नै पवित्र स्‍थान म्ह करी सै।<verse eid="PSA 74:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 74:4" />तेरे बिरोधी तेरे पवित्र स्‍थान कै बीच गरजते रहवै सै;</para>
  <para style="q" vid="PSA 74:4">उननै अपणे ए झण्डे ताहीं निशान बणाया सै।<verse eid="PSA 74:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 74:5" />वे उन माणसां के समान थे</para>
  <para style="q" vid="PSA 74:5">जो घणे बण के दरखतां पै कुहाड़े चलावै सै।<verse eid="PSA 74:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 74:6" />अर इब वो उस भवन की नक्‍काशी नै,</para>
  <para style="q" vid="PSA 74:6">कुहाड़ियाँ अर हथौड़ा तै कती तोड़ देवै सै।<verse eid="PSA 74:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 74:7" />उननै तेरे पवित्र स्‍थान ताहीं आग म्ह झोंक दिया सै,</para>
  <para style="q" vid="PSA 74:7">अर तेरे नाम के भवन ताहीं गेर कै अशुद्ध कर दिया सै।<verse eid="PSA 74:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 74:8" />उननै मन म्ह कह्या के “हम इन ताहीं एकदम दबा देवांगें।”</para>
  <para style="q" vid="PSA 74:8">उननै इस देश म्ह परमेसवर के सारी सभा की जगहां ताहीं फूँक दिया सै।<verse eid="PSA 74:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 74:9" />हमनै इब परमेसवर के कोए चमत्कार न्ही दिखाई देन्दे;</para>
  <para style="q" vid="PSA 74:9">इब कोए नबी न्ही रहया,</para>
  <para style="q" vid="PSA 74:9">ना म्हारे बीच कोए जाणण आळा सै के म्हारी या दशा कद ताहीं रहवैगी।<verse eid="PSA 74:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 74:10" />हे परमेसवर बिरोधी कद तक बदनाम्मी करदा रहवैगा?</para>
  <para style="q" vid="PSA 74:10">के दुश्मन, तेरे नाम की बुराई सदा करदा रहवैगा?<verse eid="PSA 74:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 74:11" />तू अपणा सोळा हाथ क्यूँ रोक्‍के रहवै सै?</para>
  <para style="q" vid="PSA 74:11">उसनै अपणे पंजर तै काढ कर उनका अन्त करदे।<verse eid="PSA 74:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 74:12" />परमेसवर तो पुराणे बखत तै मेरा राजा सै,</para>
  <para style="q" vid="PSA 74:12">वो धरती पै उद्धार के काम करदा आया सै।<verse eid="PSA 74:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 74:13" />तन्‍नै तो अपणी शक्ति तै समुन्दर ताहीं दो भाग कर दिया;</para>
  <para style="q" vid="PSA 74:13">तन्‍नै तो समुन्दरी राक्षसां के सिरां ताहीं फोड़ दिया।<verse eid="PSA 74:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 74:14" />तन्‍नै तो लिव्यातान<note caller="+" style="f"><char style="fr" closed="false">74:14 </char><char style="fq" closed="false">लिव्यातान </char><char style="ft" closed="false">यो उस बखत का एक भोत बड़ा समुन्दरी जीव था जो बुराई का प्रतीक मान्या जावै था </char></note> के सिर टुकड़े-टुकड़े करकै जंगळी जानवरां<note caller="+" style="f"><char style="fr" closed="false">74:14 </char><char style="fq" closed="false">जंगळी जानवरां </char><char style="ft" closed="false">बियाबान म्ह रहण आळे माणस</char></note> ताहीं खुआ दिए।<verse eid="PSA 74:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 74:15" />तन्‍नै तो चोए खोलकै जल की धारा बहाई,</para>
  <para style="q" vid="PSA 74:15">तन्‍नै तो बारहुमास बहण आळी नदियाँ ताहीं सूखा दिया।<verse eid="PSA 74:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 74:16" />दिन तेरा सै रात भी तेरी सै;</para>
  <para style="q" vid="PSA 74:16">सूरज अर चाँद ताहीं तन्‍नै स्थिर करया सै।<verse eid="PSA 74:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 74:17" />तन्‍नै तो धरती की सारी हद ठैहराई;</para>
  <para style="q" vid="PSA 74:17">गर्मी अर सर्दी दोन्‍नु तन्‍नै बणाए सै।<verse eid="PSA 74:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 74:18" />हे यहोवा, याद कर के दुश्मन नै तेरा मजाक बणाया सै,</para>
  <para style="q" vid="PSA 74:18">अर बेकूफ माणसां नै तेरे नाम की बुराई करी सै।<verse eid="PSA 74:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 74:19" />अपणी कबूतरी की जान नै जंगळी-पशु कै बस म्ह ना कर;</para>
  <para style="q" vid="PSA 74:19">अपणे दीन माणसां नै सदा खात्तर ना भूल्‍लै<verse eid="PSA 74:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 74:20" />अपणे करार की ओड़ ध्यान दे;</para>
  <para style="q" vid="PSA 74:20">क्यूँके देश की अन्धेरी जगहां अत्याचार के घरां तै भरपूर सै।<verse eid="PSA 74:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 74:21" />पईसे होए माणस नै निरादर होकै आणा ना पड़ै;</para>
  <para style="q" vid="PSA 74:21">दीन अर दरिद्र लोग तेरे नाम की बड़ाई करण पावै।<verse eid="PSA 74:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 74:22" />हे परमेसवर, उठ, अपणा मुकद्दमा आप्पे लड़;</para>
  <para style="q" vid="PSA 74:22">बेकूफ जो दिन भर तेरा मजाक उड़ान्दे रहवै सै, उसनै याद कर।<verse eid="PSA 74:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 74:23" />अपणे द्रोहियाँ का बड़ा बोल ना भूल्‍लै,</para>
  <para style="q" vid="PSA 74:23">तेरे बिरोधियाँ का कोलाहल तो लगातार उठदा रहवै सै।<verse eid="PSA 74:23" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" sid="PSA 75" />
  <para style="s">न्याय खात्तर परमेसवर का धन्यवाद</para>
  <para style="d">प्रधान बजाण आळे खात्तर: अलतशहेत राग म्ह आसाप का भजन। गीत।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 75:1" />हे परमेसवर हम तेरा धन्यवाद करां, हम तेरे नाम का धन्यवाद करां सां;</para>
  <para style="q" vid="PSA 75:1">क्यूँके तेरा नाम जाहिर होया सै, तेरे अदभुत काम्मां का जिक्र होण लागरया सै।<verse eid="PSA 75:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 75:2" />जिब ठीक बखत आवैगा</para>
  <para style="q" vid="PSA 75:2">जद मै आप्पे ठीक-ठीक न्याय करुँगा।<verse eid="PSA 75:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 75:3" />जिब धरती अपणे सारे रहण आळयां समेत डोलण लागरी सै,</para>
  <para style="q" vid="PSA 75:3">फेर मै ए उसके खम्‍भां ताहीं मजबूत करुँ सूं। (सेला)<verse eid="PSA 75:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 75:4" />मन्‍नै घमण्डियाँ तै कह्या, “घमण्ड ना करो,”</para>
  <para style="q" vid="PSA 75:4">अर दुष्टां तै, “सींग ऊँच्‍चा ना करो;<verse eid="PSA 75:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 75:5" />अपणा सींग ज्यादा ऊँच्‍चा मत करो,</para>
  <para style="q" vid="PSA 75:5">ना सिर ठाकै ढिठपण की बात करो,”<verse eid="PSA 75:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 75:6" />क्यूँके बढ़ोतरी ना तो पूरब तै ना पश्चिम तै,</para>
  <para style="q" vid="PSA 75:6">अर ना जंगळ की ओड़ तै आवै सै;<verse eid="PSA 75:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 75:7" />पर परमेसवर ए न्यायी सै,</para>
  <para style="q" vid="PSA 75:7">वो एक नै घटावै अर दुसरे नै बढ़ावै सै।<verse eid="PSA 75:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 75:8" />यहोवा के हाथ म्ह एक कटोरा सै, जिसका दाखमधु झागआळा सै;</para>
  <para style="q" vid="PSA 75:8">उस म्ह मसाला मिल्या सै, अर वो उस म्ह तै उण्डेलै सै,</para>
  <para style="q" vid="PSA 75:8">पक्‍का उसकी तलछट तक धरती के सारे दुष्ट माणस पी जावैंगे।<verse eid="PSA 75:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 75:9" />पर मै तो सदा प्रचार करदा रहूँगा,</para>
  <para style="q" vid="PSA 75:9">मै याकूब के परमेसवर का भजन गाऊँगा।<verse eid="PSA 75:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 75:10" />दुष्टां के सारे सींगां<note caller="+" style="f"><char style="fr" closed="false">75:10 </char><char style="fq" closed="false">सींगां </char><char style="ft" closed="false">ताकत</char></note> नै मै काट दियुँगा,</para>
  <para style="q" vid="PSA 75:10">पर धर्मी के सींग<note caller="+" style="f"><char style="fr" closed="false">75:10 </char><char style="fq" closed="false">सींग </char><char style="ft" closed="false">ताकत</char></note> ऊँच्‍चे करे जावैंगे।<verse eid="PSA 75:10" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" sid="PSA 76" />
  <para style="s">जयवन्त परमेसवर</para>
  <para style="d">प्रधान बजाण आळे खात्तर: तारआळे बाज्यां कै गैल, आसाप का भजन, गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 76:1" />परमेसवर यहूदा म्ह जाण्या गया सै,</para>
  <para style="q" vid="PSA 76:1">उसका नाम इस्राएल म्ह महान होया सै।<verse eid="PSA 76:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 76:2" />अर उसका मण्‍डप शालेम<note caller="+" style="f"><char style="fr" closed="false">76:2 </char><char style="fq" closed="false">शालेम </char><char style="ft" closed="false">यरुशलेम का नगर</char></note> म्ह,</para>
  <para style="q" vid="PSA 76:2">अर उसका धाम सिय्योन म्ह सै।<verse eid="PSA 76:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 76:3" />ओड़ै उसनै तीरां ताहीं,</para>
  <para style="q" vid="PSA 76:3">अर ढाल, तलवार अर लड़ाई के और हथियारां ताहीं तोड़ गेरया। (सेला)<verse eid="PSA 76:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 76:4" />हे परमेसवर तू तो ज्योतिर्मय सै,</para>
  <para style="q" vid="PSA 76:4">तू शिकार तै भरे होए पहाड़ां तै भी घणा बढ़कै अर महान सै।<verse eid="PSA 76:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 76:5" />मजबूत मन आळे लुटगे, अर गहरी नींद म्ह पड़े सै;</para>
  <para style="q" vid="PSA 76:5">अर शूरवीरां म्ह तै किसे का हाथ कोनी चाल्या।<verse eid="PSA 76:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 76:6" />हे याकूब के परमेसवर, तेरी धमकी तै,</para>
  <para style="q" vid="PSA 76:6">रथां समेत घोड़े गहरी नींद म्ह पड़े सै।<verse eid="PSA 76:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 76:7" />सिर्फ तू ए भययोग्य सै;</para>
  <para style="q" vid="PSA 76:7">अर जिब तू छो करण लाग्गै, फेर तेरे स्याम्ही कौण खड्या रह सकैगा?<verse eid="PSA 76:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 76:8" />तन्‍नै सुर्ग तै फैसला सुणाया सै,</para>
  <para style="q" vid="PSA 76:8">धरती उस बखत सुणकै डरगी, अर चुप रही,<verse eid="PSA 76:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 76:9" />जिब परमेसवर न्याय करण नै,</para>
  <para style="q" vid="PSA 76:9">अर धरती के सारे नरम माणसां का उद्धार करण नै उठ्या। (सेला)<verse eid="PSA 76:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 76:10" />जरुर माणस की जळजळाहट तेरी बड़ाई का कारण हो ज्यागी,</para>
  <para style="q" vid="PSA 76:10">अर जो जळजळाहट रह जावै, उसनै तू रोक्‍कैगा।<note caller="+" style="f"><char style="fr" closed="false">76:10 </char><char style="fq" closed="false">अर जो जळजळाहट रह जावै, उसनै तू रोक्‍कैगा। </char><char style="ft" closed="false">जो माणस युद्ध म्ह बचगे वो तेरा त्यौहार मनावैंगे</char></note><verse eid="PSA 76:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 76:11" />अपणे परमेसवर यहोवा की मन्‍नत ओट्टो अर पूरी भी करो,</para>
  <para style="q" vid="PSA 76:11">वो जो भय कै योग्य सै, उसके लोवै-धोरै के सारे उसकै खात्तर भेंट ले आवै।<verse eid="PSA 76:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 76:12" />वो तो प्रधानां का घमण्ड मिटा देगा;</para>
  <para style="q" vid="PSA 76:12">वो धरती के सारे राजयां नै भययोग्य जाण पड़ै सै।<verse eid="PSA 76:12" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" sid="PSA 77" />
  <para style="s">संकट कै बखत म्ह तसल्‍ली</para>
  <para style="d">प्रधान बजाण आळे खात्तर: यदूतून की राग पै, आसाप का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 77:1" />मै परमेसवर की दुहाई चिल्‍ला-चिल्‍लाकै दियुँगा,</para>
  <para style="q" vid="PSA 77:1">मै परमेसवर की दोहाई दियुँगा, अर वो मेरी और कान लगावैगा।<verse eid="PSA 77:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 77:2" />मुसीबत के दिन म्ह प्रभु की खोज म्ह लाग्या रहया;</para>
  <para style="q" vid="PSA 77:2">रात नै मेरा हाथ फैल्या रहया, अर ढील्‍ला ना होया,</para>
  <para style="q" vid="PSA 77:2">मेरे म्ह शान्ति आई ए कोनी।<verse eid="PSA 77:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 77:3" />मै परमेसवर नै याद कर-करकै कहराऊ सूं;</para>
  <para style="q" vid="PSA 77:3">मै चिन्ता करदे-करदे बेसुध हो चल्या सूं। (सेला)<verse eid="PSA 77:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 77:4" />तू मन्‍नै झपकी भी लेण न्ही देन्दा;</para>
  <para style="q" vid="PSA 77:4">मै इसा घबराया सूं के मेरे मुँह तै बात न्ही लिकड़दी।<verse eid="PSA 77:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 77:5" />मन्‍नै पुराणे बखत के दिनां म्ह,</para>
  <para style="q" vid="PSA 77:5">अर युग-युग के साल्‍लां कै बारै म्ह सोच्या सै।<verse eid="PSA 77:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 77:6" />मै रात कै बखत अपणे गीत नै याद करदा;</para>
  <para style="q" vid="PSA 77:6">अर मन म्ह ध्यान करुँ सूं,<note caller="+" style="f"><char style="fr" closed="false">77:6 </char><char style="ft" closed="false">मै रात नै अपणी आत्मा म्ह बात करुँ सूं, अर ध्यान करुँ सूं अर भलाई नै मन म्ह टोह्ऊ सूं,</char></note></para>
  <para style="q" vid="PSA 77:6">अर मन म्ह आच्छी तरियां विचार करुँ सूं;<verse eid="PSA 77:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 77:7" />“के मन्‍नै प्रभु युग-युग खात्तर छोड़ देवैगा;</para>
  <para style="q" vid="PSA 77:7">अर फेर कदे खुश न्ही होवैगा?<verse eid="PSA 77:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 77:8" />के उसकी करुणा हमेशा खात्तर जान्दी रही?</para>
  <para style="q" vid="PSA 77:8">के उसका वचन पीढ़ी-पीढ़ी खात्तर नाकामयाब होग्या?<verse eid="PSA 77:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 77:9" />के परमेसवर अनुग्रह करणा भूल ग्या?</para>
  <para style="q" vid="PSA 77:9">के उसनै छो करकै अपणी सारी दया ताहीं रोक राख्या सै?” (सेला)<verse eid="PSA 77:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 77:10" />मन्‍नै कह्या, “योए तो मेरा दुख सै, के परमप्रधान का सोळा हाथ बदल ग्या सै।”<verse eid="PSA 77:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 77:11" />मै यहोवा के बड़े काम्मां की चर्चा करुँगा;</para>
  <para style="q" vid="PSA 77:11">जरुर मै तेरे पुराणे बखत आळे अदभुत काम्मां नै याद करुँगा।<verse eid="PSA 77:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 77:12" />मै तेरे सारे काम्मां पै ध्यान करुँगा,</para>
  <para style="q" vid="PSA 77:12">अर तेरे बड़े काम्मां कै बारै म्ह सोच्‍चूँगा।<verse eid="PSA 77:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 77:13" />हे परमेसवर तेरी चाल पवित्रता की सै।</para>
  <para style="q" vid="PSA 77:13">कौण सा देवता परमेसवर कै बराबर बड़ा सै?<verse eid="PSA 77:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 77:14" />अदभुत काम करण आळा परमेसवर तू ए सै,</para>
  <para style="q" vid="PSA 77:14">तन्‍नै देश-देश के माणसां पै अपणी शक्ति जाहिर करी सै।<verse eid="PSA 77:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 77:15" />तन्‍नै अपणे भुजबल तै अपणी प्रजा,</para>
  <para style="q" vid="PSA 77:15">याकूब अर यूसुफ के वंश ताहीं छुड़ा लिया सै। (सेला)<verse eid="PSA 77:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 77:16" />हे परमेसवर जद समुन्दर नै तेरे ताहीं देख्या,</para>
  <para style="q" vid="PSA 77:16">तो समुन्दर तन्‍नै देखकै डरग्या,</para>
  <para style="q" vid="PSA 77:16">गहरा सागर भी काँप ग्या।<verse eid="PSA 77:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 77:17" />बादळां तै बड़ी बारिस होई;</para>
  <para style="q" vid="PSA 77:17">अकास तै शब्‍द होया;</para>
  <para style="q" vid="PSA 77:17">फेर तेरे तीर आस्सै-पास्सै चाल्‍ले।<verse eid="PSA 77:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 77:18" />बवण्डर म्ह तेरे गरजण का शब्‍द सुणै था;</para>
  <para style="q" vid="PSA 77:18">दुनिया बिजळी तै प्रकाशित होई;</para>
  <para style="q" vid="PSA 77:18">धरती काँप अर थरथरागी।<verse eid="PSA 77:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 77:19" />तेरा राह समुन्दर म्ह सै,</para>
  <para style="q" vid="PSA 77:19">अर तेरा रास्ता गहरे पाणी म्ह होया;</para>
  <para style="q" vid="PSA 77:19">अर तेरे पैरां की कोए पैड भी न्ही दिखदी।<verse eid="PSA 77:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 77:20" />तन्‍नै मूसा अर हारुन के जरिये,</para>
  <para style="q" vid="PSA 77:20">अपणी प्रजा की अगुवाई भेड़ की तरियां करी।<verse eid="PSA 77:20" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" sid="PSA 78" />
  <para style="s">परमेसवर अर उसके लोग</para>
  <para style="d">आसाप का मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 78:1" />हे मेरे माणसों, मेरी शिक्षा सुणो;</para>
  <para style="q" vid="PSA 78:1">मेरे वचनां की ओड़ कान लगाओ!<verse eid="PSA 78:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 78:2" />मै अपणा मुँह ज्ञान की बात कहण खात्तर खोल्‍लूँगा;</para>
  <para style="q" vid="PSA 78:2">मै पुराणे बखत की गुप्त बात कहूँगा,<verse eid="PSA 78:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 78:3" />जिन बात्तां ताहीं हमनै सुण्या,</para>
  <para style="q" vid="PSA 78:3">अर जाण लिया, अर म्हारे पूर्वजां नै म्हारे तै जिक्र करया सै।<verse eid="PSA 78:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 78:4" />उननै हम उनकी औलाद तै लह्को के न्ही राक्खागें,</para>
  <para style="q" vid="PSA 78:4">पर आण आळी पीढ़ी के माणसां तै,</para>
  <para style="q" vid="PSA 78:4">यहोवा का गुणगान अर उसकी सामर्थ्य</para>
  <para style="q" vid="PSA 78:4">अर बड़े-बड़े काम्मां का जिक्र करागें।<verse eid="PSA 78:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 78:5" />उसनै तो याकूब म्ह एक चितौनी ठहराई,</para>
  <para style="q" vid="PSA 78:5">अर इस्राएल म्ह नियम-कायदा चलाया,</para>
  <para style="q" vid="PSA 78:5">जिसके बाबत उसनै म्हारे बाप-दाद्यां ताहीं हुक्म दिया,</para>
  <para style="q" vid="PSA 78:5">के थम इननै अपणे-अपणे बाळ-बच्‍चां ताहीं बताइयो;<verse eid="PSA 78:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 78:6" />के आण आळी पीढ़ी के लोग, मतलब जो बाळक पैदा होण आळे सै, वो इननै जाणै;</para>
  <para style="q" vid="PSA 78:6">अर अपणे-अपणे बाळ-बच्‍चां ताहीं इनका जिक्र करण म्ह इच्छुक हों,<verse eid="PSA 78:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 78:7" />जिसतै वे परमेसवर पै भरोस्सा राक्खै, परमेसवर के बड़े काम्मां नै भूल ना जावै,</para>
  <para style="q" vid="PSA 78:7">पर उसके हुकमां नै मानते रहवै;<verse eid="PSA 78:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 78:8" />अर अपणे बाप-दाद्यां की तरियां ना हो,</para>
  <para style="q" vid="PSA 78:8">क्यूँके उस पीढ़ी के लोग तो ढ़ीठ अर झगड़ालू थे,</para>
  <para style="q" vid="PSA 78:8">अर उननै अपणा मन मजबूत न्ही करया था,</para>
  <para style="q" vid="PSA 78:8">अर ना उनकी आत्मा परमेसवर की ओड़ साच्‍ची रही।<verse eid="PSA 78:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 78:9" />एप्रैमियां नै तो शस्‍त्रधारी अर धनुर्धारी होण पै भी,</para>
  <para style="q" vid="PSA 78:9">लड़ाई के बखत पीठ दिखा दी।<verse eid="PSA 78:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 78:10" />उननै परमेसवर के करार का पालन न्ही करया,</para>
  <para style="q" vid="PSA 78:10">अर उसके नियम-कायदा पै चाल्‍लण तै इनकार करया।<verse eid="PSA 78:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 78:11" />उननै उसके बड़े काम्मां ताहीं अर जो चिन्ह अर चमत्कार उसनै उनके स्याम्ही करे थे,</para>
  <para style="q" vid="PSA 78:11">उन ताहीं भूला दिया।<verse eid="PSA 78:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 78:12" />उसनै तो उनके बाप-दाद्यां के स्याम्ही मिस्र देश के सोअन के मैदान म्ह अदभुत काम करे थे।<verse eid="PSA 78:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 78:13" />उसनै समुन्दर ताहीं दो भाग करकै उनतै पार करा दिया,</para>
  <para style="q" vid="PSA 78:13">अर पाणी ताहीं ढ़ेर की तरियां खड्या कर दिया।<verse eid="PSA 78:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 78:14" />अर उसनै दिन म्ह बादळ के खम्‍भयां तै</para>
  <para style="q" vid="PSA 78:14">अर रात भर आग की रोशनी के जरिये उनकी अगुवाई करी।<verse eid="PSA 78:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 78:15" />वो जंगळ म्ह चट्टान पाड़कै,</para>
  <para style="q" vid="PSA 78:15">उन ताहीं मान्‍नो गहरे जलाशयों म्ह तै मन मान्या पियाया करै था।<verse eid="PSA 78:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 78:16" />उसनै चट्टान म्ह तै भी धारा लिकाड़ी</para>
  <para style="q" vid="PSA 78:16">अर नदियाँ की तरियां पाणी बहाया।<verse eid="PSA 78:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 78:17" />तोभी वे फेर उसके खिलाफ घणे पाप करदे गए,</para>
  <para style="q" vid="PSA 78:17">अर निर्जल देश म्ह परमप्रधान के खिलाफ उठदे रह्ये।<verse eid="PSA 78:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 78:18" />अर अपणी मर्जी के मुताबिक खाणा माँगकै मन ए मन म्ह परमेसवर का इम्तिहान लिया।<verse eid="PSA 78:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 78:19" />वे परमेसवर के खिलाफ बोल्‍ले,</para>
  <para style="q" vid="PSA 78:19">अर कहण लाग्गे, “के परमेसवर जंगळ म्ह मेज लगा सकै सै के?<verse eid="PSA 78:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 78:20" />उसनै चट्टान पै मारकै पाणी बहा तो दिया,</para>
  <para style="q" vid="PSA 78:20">अर धाराएँ उमड़ चली,</para>
  <para style="q" vid="PSA 78:20">पर के वो रोट्टी भी दे सकै सै?</para>
  <para style="q" vid="PSA 78:20">के वो अपणी प्रजा खात्तर माँस भी तैयार कर सकै सै?”<verse eid="PSA 78:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 78:21" />यहोवा सुणकै छो तै भरग्या,</para>
  <para style="q" vid="PSA 78:21">फेर याकूब के खिलाफ उसकी आग भड़क उठ्ठी,</para>
  <para style="q" vid="PSA 78:21">अर इस्राएल कै खिलाफ छो भड़क्या;<verse eid="PSA 78:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 78:22" />इस करकै उननै परमेसवर पै बिश्वास न्ही राख्या था,</para>
  <para style="q" vid="PSA 78:22">ना उसकी उद्धार करण की शक्ति पै भरोस्सा करया।<verse eid="PSA 78:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 78:23" />तोभी उसनै अकास ताहीं हुकम दिया,</para>
  <para style="q" vid="PSA 78:23">अर सुर्ग के दरवाज्यां ताहीं खोल्या;<verse eid="PSA 78:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 78:24" />अर उनकै खात्तर खाण नै मन्‍ना बरसाया,</para>
  <para style="q" vid="PSA 78:24">अर उन ताहीं सुर्ग का अन्‍न दिया।<verse eid="PSA 78:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 78:25" />इन्सानां ताहीं सुर्गदूत्तां की रोट्टी मिली;</para>
  <para style="q" vid="PSA 78:25">उसनै उन ताहीं मन चाह्या भोजन दिया।<verse eid="PSA 78:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 78:26" />उसनै अकास म्ह पूर्वी हवा चलाई,</para>
  <para style="q" vid="PSA 78:26">अर अपणी शक्ति तै दक्षिणी हवा बहाई;<verse eid="PSA 78:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 78:27" />अर उनकै खात्तर माँस धूळ की तरियां भोत बरसाया,</para>
  <para style="q" vid="PSA 78:27">अर समुन्दर के रेत की तरियां अनगिणत पंछी भेजे:<verse eid="PSA 78:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 78:28" />अर उनके डेरां कै बीच म्ह,</para>
  <para style="q" vid="PSA 78:28">उसके घरां के च्यांरु ओड़ गिराए।<verse eid="PSA 78:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 78:29" />अर वे खाकै पूरी तरियां तै छिकगे,</para>
  <para style="q" vid="PSA 78:29">अर उसनै उनकी कामना पूरी करी।<verse eid="PSA 78:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 78:30" />उनकी कामना बणी ए रही,</para>
  <para style="q" vid="PSA 78:30">उनका खाणा उनके मुँह ए म्ह था,<verse eid="PSA 78:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 78:31" />के परमेसवर का छो उनपै भड़क्या,</para>
  <para style="q" vid="PSA 78:31">अर उसनै उनके हट्टा-कट्यां ताहीं मार गेरया,</para>
  <para style="q" vid="PSA 78:31">अर इस्राएल के जवान्‍नां ताहीं गिरा दिया।<verse eid="PSA 78:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 78:32" />इतणा होण पै भी वे और घणे पाप करदे गए;</para>
  <para style="q" vid="PSA 78:32">अर परमेसवर के बड़े-बड़े काम्मां का बिश्वास न्ही करया।<verse eid="PSA 78:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 78:33" />फेर उसनै उनके जीवन के दिनां ताहीं बेकार की मेहनत म्ह,</para>
  <para style="q" vid="PSA 78:33">अर उनके साल ताहीं घबराहट म्ह कटवाया।<verse eid="PSA 78:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 78:34" />जिब वो उन ताहीं घात करण लाग्गै, फेर वे उस ताहीं पूच्छै थे;</para>
  <para style="q" vid="PSA 78:34">अर दोबारा परमेसवर नै यतन तै टोहवै थे।<verse eid="PSA 78:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 78:35" />अर उन ताहीं याद आया करै था के परमेसवर म्हारी चट्टान सै,</para>
  <para style="q" vid="PSA 78:35">अर परमप्रधान परमेसवर म्हारा छुड़ाण आळा सै।<verse eid="PSA 78:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 78:36" />फेर भी उननै उसकी चापलूसी करी;</para>
  <para style="q" vid="PSA 78:36">वे उसतै झूठ बोल्‍ले।<verse eid="PSA 78:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 78:37" />क्यूँके उनका दिल उसकी ओड़ तै मजबूत ना था;</para>
  <para style="q" vid="PSA 78:37">ना वे उसकै करार के बारै म्ह सच्‍चे थे।<verse eid="PSA 78:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 78:38" />पर वो दयालु सै, वो अधर्म नै ढकै सै, अर नाश न्ही करदा;</para>
  <para style="q" vid="PSA 78:38">वो बार-बार अपणे छो नै ठण्डा करै सै,</para>
  <para style="q" vid="PSA 78:38">अर अपणी जळजळाहट नै पूरी रीति तै भड़कण न्ही देन्दा।<verse eid="PSA 78:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 78:39" />उसनै याद आया के ये नाशवान सै,</para>
  <para style="q" vid="PSA 78:39">ये हवा की तरियां सै जो चली जावै सै अर उलटी न्ही आन्दी।<verse eid="PSA 78:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 78:40" />उननै कितनी ए बार जंगळ म्ह उसका बिरोध करया,</para>
  <para style="q" vid="PSA 78:40">अर बियाबान देश म्ह उस ताहीं उदास करया!<verse eid="PSA 78:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 78:41" />वे बार-बार परमेसवर का इम्तिहान करदे रहे,</para>
  <para style="q" vid="PSA 78:41">अर इस्राएल के पवित्र परमेसवर नै दुखी करदे रहे।<verse eid="PSA 78:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 78:42" />उननै ना तो उसकी ताकत ताहीं याद करया,</para>
  <para style="q" vid="PSA 78:42">ना वो दिन जब उसनै उन ताहीं विरोधियों के बस म्ह तै छुड़ाया था;<verse eid="PSA 78:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 78:43" />के उसनै किस तरियां के काम मिस्र देश म्ह,</para>
  <para style="q" vid="PSA 78:43">अर अपणे चमत्कार सोअन के मैदान म्ह करे थे।<verse eid="PSA 78:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 78:44" />उसनै तो मिस्रियाँ की नदियाँ का पाणी खून बणा दिया,</para>
  <para style="q" vid="PSA 78:44">अर वे अपणी नदियाँ का पाणी पी भी न्ही सके।<verse eid="PSA 78:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 78:45" />उसनै उनके बीच म्ह डांस भेज्जे जिन नै उन ताहीं काट खाया,</para>
  <para style="q" vid="PSA 78:45">अर मिंढ़क भी भेज्जे, जिन नै उन ताहीं बिगाड़ किया।<verse eid="PSA 78:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 78:46" />उसनै उनकी धरती की उपज कीड़ियाँ ताहीं,</para>
  <para style="q" vid="PSA 78:46">अर उनकी खेत्तीबाड़ी टिड्डियाँ ताहीं खुआ दी थी।<verse eid="PSA 78:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 78:47" />उसनै उनकी अंगूर की बेल ताहीं ओळयां तै,</para>
  <para style="q" vid="PSA 78:47">अर उनके गूलर के दरखतां ताहीं बड़े-बड़े ओळे बरसा कै नाश करया।<verse eid="PSA 78:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 78:48" />उसनै उनके पशुआं ताहीं ओळयां तै,</para>
  <para style="q" vid="PSA 78:48">अर उनके ढोरां ताहीं बिजळियाँ तै मिटा दिया।<verse eid="PSA 78:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 78:49" />उसनै उनके उप्पर अपणा खतरनाक छो अर रोष भड़काया,</para>
  <para style="q" vid="PSA 78:49">अर उन ताहीं मुसीबत म्ह गेरया,</para>
  <para style="q" vid="PSA 78:49">अर दुखदाई दूत्तां का दल भेज्या।<verse eid="PSA 78:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 78:50" />उसनै अपणे छो का राह खोल्या,</para>
  <para style="q" vid="PSA 78:50">अर उनके प्राण ताहीं मौत तै ना बचाया,</para>
  <para style="q" vid="PSA 78:50">पर उन ताहीं मरी के बस म्ह कर दिया।<verse eid="PSA 78:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 78:51" />उसनै मिस्र के सारे जेठ्यां ताहीं मारया,</para>
  <para style="q" vid="PSA 78:51">जो हाम के डेरां<note caller="+" style="f"><char style="fr" closed="false">78:51 </char><char style="fq" closed="false">जो हाम के डेरां </char><char style="ft" closed="false">मिस्र देश का दूसरा नाम हाम था जो नूह का बेट्टा था वो मिस्र देश नै बसाण आळा भी था</char></note> म्ह माणस के पैहले फळ थे;<verse eid="PSA 78:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 78:52" />पर अपणी प्रजा तै भेड़-बकरियाँ की तरियां चलाये,</para>
  <para style="q" vid="PSA 78:52">अर जंगळ म्ह उनकी अगुवाई पशुआं के झुण्ड की तरियां करी।<verse eid="PSA 78:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 78:53" />फेर वे उसके चलाण तै बेधड़क चाल्‍ले अर उननै किमे डर ना होया,</para>
  <para style="q" vid="PSA 78:53">पर उनके दुश्मन समुन्दर म्ह डूबगे।<verse eid="PSA 78:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 78:54" />अर उसनै उन ताहीं अपणे पवित्र देश की हद तक,</para>
  <para style="q" vid="PSA 78:54">इसे पहाड़ी देश म्ह पोहचाया, जो उसनै अपणे सोळे हाथ तै मिल्या था।<verse eid="PSA 78:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 78:55" />उसनै उनके स्याम्ही तै गैरजात्तां ताहीं भजा दिया;</para>
  <para style="q" vid="PSA 78:55">अर उनकी धरती नै डोरी तै नाप-नाप कै बाँट दिया;</para>
  <para style="q" vid="PSA 78:55">अर इस्राएल के गोत्रां ताहीं उनके डेरां म्ह बसाया।<verse eid="PSA 78:55" /></para>
  <para style="q">
    <verse number="56" style="v" sid="PSA 78:56" />फेर भी परमप्रधान परमेसवर का इम्तिहान लिया अर उसतै बिद्रोह करया,</para>
  <para style="q" vid="PSA 78:56">अर उसकी चितौनियाँ नै ना मान्या,<verse eid="PSA 78:56" /></para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 78:57" />अर मुड़कै अपणे बुजुर्गां की तरियां बिश्वासघात करया;</para>
  <para style="q" vid="PSA 78:57">उननै निकम्मे धनुष की तरियां धोखा दिया।<verse eid="PSA 78:57" /></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 78:58" />क्यूँके उननै आराधना की ऊँच्‍ची जगहां<note caller="+" style="f"><char style="fr" closed="false">78:58 </char><char style="fq" closed="false">ऊँच्‍ची जगहां </char><char style="ft" closed="false">पूजा करण की जगहां</char></note> बणाकै उस ताहीं छो दुवाया,</para>
  <para style="q" vid="PSA 78:58">अर बणाई होए मूर्तियाँ के जरिये उस म्ह जळण उपजाई।<verse eid="PSA 78:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 78:59" />परमेसवर सुणकै छो तै भरग्या,</para>
  <para style="q" vid="PSA 78:59">अर उसनै इस्राएल ताहीं जमाए छोड़ दिया।<verse eid="PSA 78:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 78:60" />उसनै शीलो<note caller="+" style="f"><char style="fr" closed="false">78:60 </char><char style="fq" closed="false">शीलो </char><char style="ft" closed="false">या वा खास जगहां थी जड़ै इस्राएल के माणस परमेसवर की आराधना करया करदे, यो यरुशलेम तै बत्तीस किलोमीटर दूर दक्षिण म्ह था अर उरैए करार का सन्दूक धरया गया था </char></note> के निवास,</para>
  <para style="q" vid="PSA 78:60">मतलब उस तम्‍बु ताहीं जो उसनै माणसां के बीच खड्या करया था, छोड़ दिया,<verse eid="PSA 78:60" /></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 78:61" />अर करार के सन्दूक<note caller="+" style="f"><char style="fr" closed="false">78:61 </char><char style="fq" closed="false">करार के सन्दूक </char><char style="ft" closed="false">शक्ति</char></note> ताहीं गुलाम्मी म्ह जाण दिया,</para>
  <para style="q" vid="PSA 78:61">अर अपणी शोभा ताहीं बिरोधियाँ के बस म्ह कर दिया।<verse eid="PSA 78:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 78:62" />उसनै अपणी प्रजा ताहीं तलवार तै मरवा दिया,</para>
  <para style="q" vid="PSA 78:62">अर अपणे खास माणसां पै छो तै भरग्या।<verse eid="PSA 78:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 78:63" />उनके जवान आग तै भस्‍म होए,</para>
  <para style="q" vid="PSA 78:63">अर उनकी कुमारियाँ के ब्याह के गीत न्ही गाये गये।<verse eid="PSA 78:63" /></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 78:64" />उनके याजक तलवार तै मारे गए,</para>
  <para style="q" vid="PSA 78:64">अर उनकी बिधवा रोण न्ही पाई।<verse eid="PSA 78:64" /></para>
  <para style="q">
    <verse number="65" style="v" sid="PSA 78:65" />फेर प्रभु मान्‍नो नींद तै चौंक कै उठ्या,</para>
  <para style="q" vid="PSA 78:65">अर इसे वीर की तरियां उठ्या जो दाखमधु पी कै ललकारदा हो।<verse eid="PSA 78:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 78:66" />अर उसनै अपणे दुश्मनां ताहीं मारकै पाच्छै हटा दिया;</para>
  <para style="q" vid="PSA 78:66">अर उनकी सदा की बदनामी कराई।<verse eid="PSA 78:66" /></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 78:67" />फेर उसनै यूसुफ के तम्‍बु<note caller="+" style="f"><char style="fr" closed="false">78:67 </char><char style="fq" closed="false">तम्‍बु </char><char style="ft" closed="false">यूसुफ की आण आळी पीढ़ी</char></note> ताहीं छोड़ दिया;</para>
  <para style="q" vid="PSA 78:67">अर एप्रैम के गोत्र ताहीं ना चुण्या;<verse eid="PSA 78:67" /></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 78:68" />पर यहूदा ए के गोत्र ताहीं,</para>
  <para style="q" vid="PSA 78:68">अर अपणे प्यारे सिय्योन पहाड़ ताहीं चुण लिया।<verse eid="PSA 78:68" /></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 78:69" />उसनै अपणे पवित्र जगहां ताहीं भोत ऊँच्‍चा बणा दिया,</para>
  <para style="q" vid="PSA 78:69">अर धरती की तरियां मजबूत बणाया, जिसकी नींव उसनै सदा खात्तर डाली सै।<verse eid="PSA 78:69" /></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 78:70" />फिर उसनै अपणे दास दाऊद ताहीं चुण कै भेड्डां के बाड़े म्ह तै ले लिया;<verse eid="PSA 78:70" /></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 78:71" />वो उसनै बच्‍चयां आळी भेड्डां कै पाच्छै-पाच्छै फिरण तै ले आया</para>
  <para style="q" vid="PSA 78:71">के वो उसकी प्रजा याकूब की मतलब उसके खास भाग इस्राएल की चरवाही करै।<verse eid="PSA 78:71" /></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 78:72" />फेर उसनै खरे मन तै उनकी चरवाही करी,</para>
  <para style="q" vid="PSA 78:72">अर अपणे हाथ की कुशलता तै उनकी अगुवाई करी।<verse eid="PSA 78:72" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" sid="PSA 79" />
  <para style="s">इस्राएल के छुटकारै खात्तर प्रार्थना</para>
  <para style="d">आसाप का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 79:1" />हे परमेसवर गैर जात तेरी अपणी विरासत म्ह घुस आई;</para>
  <para style="q" vid="PSA 79:1">उननै तेरे पवित्र मन्दर ताहीं अशुद्ध कर दिया;</para>
  <para style="q" vid="PSA 79:1">अर यरुशलेम ताहीं खण्डहर कर दिया सै।<verse eid="PSA 79:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 79:2" />उननै तेरे दास्सां की लाशां ताहीं अकास के पंछियाँ का खाणा बणा दिया,</para>
  <para style="q" vid="PSA 79:2">अर तेरे भक्‍तां का माँस धरती के बण पशुआं तै खुआ दिया सै।<verse eid="PSA 79:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 79:3" />उननै उनका खून यरुशलेम के च्यांरु ओड़ पाणी की तरियां बहाया,</para>
  <para style="q" vid="PSA 79:3">अर उननै माट्टी देण आळा कोए न्ही था।<verse eid="PSA 79:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 79:4" />पड़ोसियाँ कै बीच म्हारी बदनामी होई;</para>
  <para style="q" vid="PSA 79:4">च्यांरु ओड़ के रहण आळे म्हारे पै हास्सै, अर मजाक करै सै।<verse eid="PSA 79:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 79:5" />हे यहोवा, तू कद तक लगातार छो करदा रहवैगा?</para>
  <para style="q" vid="PSA 79:5">तेरे म्ह आग के जिसी जळण कद तक भड़कदी रहवैगी?<verse eid="PSA 79:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 79:6" />जो जात तन्‍नै न्ही जाणदी,</para>
  <para style="q" vid="PSA 79:6">अर जिस राज्य के लोग तेरे तै प्रार्थना न्ही करदे,</para>
  <para style="q" vid="PSA 79:6">उन्हे पै अपणी सारी जळजळाहट भड़का!<verse eid="PSA 79:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 79:7" />क्यूँके उननै याकूब ताहीं निगळ लिया,</para>
  <para style="q" vid="PSA 79:7">अर उसके वासस्‍थान ताहीं उजाड़ दिया सै।<verse eid="PSA 79:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 79:8" />म्हारे नुकसान खात्तर म्हारे बुजुर्गां के अधर्म के काम्मां नै याद ना करै;</para>
  <para style="q" vid="PSA 79:8">तेरी दया म्हारे पै तावळ करकै हो, क्यूँके हम बड़ी दुर्दशा म्ह पड़े सां।<verse eid="PSA 79:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 79:9" />हे म्हारे उद्धारकर्त्ता परमेसवर, अपणे नाम की महिमा खात्तर म्हारी मदद कर;</para>
  <para style="q" vid="PSA 79:9">अर अपणे नाम कै खात्तर म्हारे ताहीं छुड़ाकै म्हारे पापां नै ढक दे।<verse eid="PSA 79:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 79:10" />गैर जात क्यूँ कहण पावै के उनका परमेसवर कड़ै गया?</para>
  <para style="q" vid="PSA 79:10">तेरे दासों के खून का बदला गैरजात्तां तै म्हारे देखदे लिया जावै।<verse eid="PSA 79:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 79:11" />बन्दियाँ का कराहणा तेरे कान्‍नां तक पोहचै;</para>
  <para style="q" vid="PSA 79:11">नाश होण आळयां ताहीं अपणे बाजुआं के जोर तै बचा।<verse eid="PSA 79:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 79:12" />हे प्रभु, म्हारे पड़ोसियाँ नै जो तेरी निन्‍दा करी सै,</para>
  <para style="q" vid="PSA 79:12">उसका सातगुणा बदला उननै दे!<verse eid="PSA 79:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 79:13" />फेर हम जो तेरी प्रजा अर तेरी चराई की भेड़ सां,</para>
  <para style="q" vid="PSA 79:13">तेरा धन्यवाद सदा करदे रहवांगें;</para>
  <para style="q" vid="PSA 79:13">अर पीढ़ी तै पीढ़ी तक तेरा गुणगान करदे रहवांगें।<verse eid="PSA 79:13" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" sid="PSA 80" />
  <para style="s">इस्राएली जात्ति कै खात्तर प्रार्थना</para>
  <para style="d">प्रधान बजाण आळे खात्तर: शोशत्रीमेदूत राग म्ह आसाप का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 80:1" />हे इस्राएल के पाळी, परमेसवर</para>
  <para style="q" vid="PSA 80:1">तू तो यूसुफ की अगुवाई भेड्डां की तरियां करै सै, कान लगा!</para>
  <para style="q" vid="PSA 80:1">तू जो करूबां पै विराजमान सै, अपणा तेज दिखा!<verse eid="PSA 80:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 80:2" />एप्रैम, बिन्‍यामीन, अर मनश्‍शे कै स्याम्ही अपणा पराक्रम दिखाकै,</para>
  <para style="q" vid="PSA 80:2">म्हारा उद्धार करण आ!<verse eid="PSA 80:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 80:3" />हे परमेसवर, म्हारे ताहीं ज्यों का त्यों करदे;</para>
  <para style="q" vid="PSA 80:3">अर अपणे मुँह की ज्योति चमका, फेर म्हारा उद्धार हो जावैगा!<verse eid="PSA 80:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 80:4" />हे सेनाओं के परमेसवर यहोवा,</para>
  <para style="q" vid="PSA 80:4">तू कद तक अपणी प्रजा की प्रार्थना पै छो म्ह रहवैगा?<verse eid="PSA 80:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 80:5" />तन्‍नै आँसुआँ ताहीं उनका खाणा बणा दिया,</para>
  <para style="q" vid="PSA 80:5">अर घड़े भर-भरकै उन ताहीं आँसू प्याए सै।<verse eid="PSA 80:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 80:6" />तू हमनै म्हारे पड़ोसियाँ की लड़ाई का कारण बणा देवै सै;</para>
  <para style="q" vid="PSA 80:6">अर म्हारे दुश्मन मन मान्या मजाक करै सै।<verse eid="PSA 80:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 80:7" />हे सेनाओं के परमेसवर, म्हारे ताहीं ज्यों का त्यों करदे;</para>
  <para style="q" vid="PSA 80:7">अर अपणे मुँह की ज्योति चमका,</para>
  <para style="q" vid="PSA 80:7">फेर म्हारा उद्धार हो जावैगा!<verse eid="PSA 80:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 80:8" />तू मिस्र तै एक अंगूर की डाळी ले आया;</para>
  <para style="q" vid="PSA 80:8">अर गैरजात्तां ताहीं काढ कै उस ताहीं लगा दिया।<verse eid="PSA 80:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 80:9" />तन्‍नै उसकै खात्तर जगहां तैयार करी सै;</para>
  <para style="q" vid="PSA 80:9">अर उसनै जड़ पकड़ी अर फैल कै देश ताहीं भर दिया।<verse eid="PSA 80:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 80:10" />उसकी छाया पहाड़ां पै फैलगी,</para>
  <para style="q" vid="PSA 80:10">अर उसकी डाळी ऊँच्‍चे देवदारां की तरियां होई;<verse eid="PSA 80:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 80:11" />उसकी शाखाएँ समुन्दर ताहीं बढ़गी,</para>
  <para style="q" vid="PSA 80:11">अर उसके अंकुर फरात तक फैलगे।<verse eid="PSA 80:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 80:12" />फेर तन्‍नै उसके बाड़याँ ताहीं क्यूँ गेर दिया,</para>
  <para style="q" vid="PSA 80:12">के सारे राहगीर उसके फळां नै तोड़ै सै?<verse eid="PSA 80:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 80:13" />जगंली सूंअर उस ताहीं नाश करै सै,</para>
  <para style="q" vid="PSA 80:13">अर मैदान के सारे पशु उसनै चर ज्या सै।<verse eid="PSA 80:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 80:14" />हे सेनाओं के परमेसवर, बोहड़ आ!</para>
  <para style="q" vid="PSA 80:14">सुर्ग तै ध्यान देकै देख, अर इस अंगूर की डाळी की सुधि ले,<verse eid="PSA 80:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 80:15" />यो पौधां तन्‍नै अपणे सोळे हाथ तै लगाया,</para>
  <para style="q" vid="PSA 80:15">अर जो बेल की टह्णी तन्‍नै अपणे खात्तर मजबूत करी सै।<verse eid="PSA 80:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 80:16" />वा जळगी सै, वा कटगी सै;</para>
  <para style="q" vid="PSA 80:16">तेरी धमकी तै तेरे दुश्मन नाश हो जावै।<verse eid="PSA 80:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 80:17" />तेरे सोळे हाथ के सम्भाळे होए आदमी पै तेरा हाथ धरया रहवै,</para>
  <para style="q" vid="PSA 80:17">उस आदमी पै, जिस ताहीं तन्‍नै अपणा खात्तर मजबूत करया सै।<verse eid="PSA 80:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 80:18" />फेर हम लोग तेरे तै ना मुड़ागें:</para>
  <para style="q" vid="PSA 80:18">तू म्हारे ताहीं जिन्दा कर, अर हम तेरे तै प्रार्थना कर सकागें।<verse eid="PSA 80:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 80:19" />हे सेनाओं के परमेसवर यहोवा, हमनै ज्यों का त्यों करदे;</para>
  <para style="q" vid="PSA 80:19">अर अपणे मुँह की ज्योति चमका,</para>
  <para style="q" vid="PSA 80:19">फेर म्हारा उद्धार हो जावैगा!<verse eid="PSA 80:19" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" sid="PSA 81" />
  <para style="s">आज्ञाकारिता खात्तर बुलाहट</para>
  <para style="d">प्रधान बजाण आळे खात्तर: गित्तीथ राग म्ह आसाप का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 81:1" />परमेसवर जो म्हारा बल सै, उसका गीत खुशी तै गाओ;</para>
  <para style="q" vid="PSA 81:1">याकूब के परमेसवर की जयजयकार करो!<verse eid="PSA 81:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 81:2" />गीत गाओ, डफ अर मधुर बाज्जण आळी वीणा अर सारंगी नै ले आओ।<verse eid="PSA 81:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 81:3" />नये चाँद के दिन,</para>
  <para style="q" vid="PSA 81:3">अर पूर्णमासी नै म्हारे त्यौहार कै दिन नरसिंगा फूँको।<verse eid="PSA 81:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 81:4" />क्यूँके या इस्राएल खात्तर विधि,</para>
  <para style="q" vid="PSA 81:4">अर याकूब के परमेसवर का ठहराया होया नियम सै।<verse eid="PSA 81:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 81:5" />इस ताहीं उसनै यूसुफ खात्तर चितौनी की रीति पै उस बखत चलाया,</para>
  <para style="q" vid="PSA 81:5">जिब वो मिस्र देश कै खिलाफ चाल्या।</para>
  <para style="q" vid="PSA 81:5">ओड़ै मन्‍नै एक अनजाणी भाषा सुणी;<verse eid="PSA 81:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 81:6" />“मन्‍नै उनके कान्धयां पै तै बोझ तार दिया;</para>
  <para style="q" vid="PSA 81:6">उनका टोकरी ढोणा छूट ग्या।<verse eid="PSA 81:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 81:7" />तन्‍नै मुसीबत म्ह पड़कै पुकारया, फेर मन्‍नै तेरे ताहीं छुड़ाया;</para>
  <para style="q" vid="PSA 81:7">बादळ गरजण की गुप्त जगहां म्ह तै मन्‍नै तेरी सुणी,</para>
  <para style="q" vid="PSA 81:7">अर मरीबा नाम के चोवै कै धोरै तेरा इम्तिहान लिया। (सेला)<verse eid="PSA 81:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 81:8" />हे मेरी प्रजा, सुण, मै तेरे ताहीं चेतावनी दियुँ सूं!</para>
  <para style="q" vid="PSA 81:8">हे इस्राएल भला हो के तू मेरी सुणै!<verse eid="PSA 81:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 81:9" />तेरै बीच म्ह कोए पराया ईश्‍वर ना हो;</para>
  <para style="q" vid="PSA 81:9">अर ना तू किसे पराए देवता नै दण्डवत करिये!<verse eid="PSA 81:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 81:10" />तेरा परमेसवर यहोवा मै सूं,</para>
  <para style="q" vid="PSA 81:10">जो थमनै मिस्र देश तै लिकाड़ ल्याया सूं।</para>
  <para style="q" vid="PSA 81:10">तू अपणा मुँह खोल, मै उसनै भर दियुँगा।<verse eid="PSA 81:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 81:11" />पर मेरी प्रजा नै मेरी न्ही सुणी;</para>
  <para style="q" vid="PSA 81:11">इस्राएल नै मेरे ताहीं न्ही चाह्या।<verse eid="PSA 81:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 81:12" />इस करकै मन्‍नै उन ताहीं उनके मन के हठ पै छोड़ दिया,</para>
  <para style="q" vid="PSA 81:12">ताके वो अपणी ए योजना कै मुताबिक चाल्‍लै।<verse eid="PSA 81:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 81:13" />जै मेरी प्रजा मेरी सुणै,</para>
  <para style="q" vid="PSA 81:13">जै इस्राएल मेरे राह पै चाल्‍लै,<verse eid="PSA 81:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 81:14" />तो मै पलभर म्ह थारे दुश्मनां नै दबाऊँ,</para>
  <para style="q" vid="PSA 81:14">अर अपणा हाथ थारे बैरियाँ कै खिलाफ चलाऊँ।<verse eid="PSA 81:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 81:15" />यहोवा के बैरी तो यहोवा के भय म्ह उसनै दण्डवत करै,</para>
  <para style="q" vid="PSA 81:15">उन ताहीं हमेशा खात्तर शर्मिन्दा करया जावैगा।<verse eid="PSA 81:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 81:16" />पर मै थमनै उनतै आच्छी तै आच्छी गेहूँ खुवान्दा,</para>
  <para style="q" vid="PSA 81:16">अर मै चट्टान के शहद तै थमनै छिकान्दा।”<verse eid="PSA 81:16" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" sid="PSA 82" />
  <para style="s">सच्‍चे न्याय कै खात्तर बिनती</para>
  <para style="d">आसाप का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 82:1" />परमेसवर दिव्य सभा म्ह खड्या सै:</para>
  <para style="q" vid="PSA 82:1">वो ईश्‍वरां<note caller="+" style="f"><char style="fr" closed="false">82:1 </char><char style="fq" closed="false">ईश्‍वरां </char><char style="ft" closed="false">सुर्गदूत्तां</char></note> के बीच म्ह न्याय करै सै।<verse eid="PSA 82:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 82:2" />“थम लोग कद तक टेढ़ा न्याय करदे</para>
  <para style="q" vid="PSA 82:2">अर दुष्टां का पक्ष लेन्दे रहोगे? (सेला)<verse eid="PSA 82:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 82:3" />कंगाल अर अनाथ्थां का न्याय चुकाओ,</para>
  <para style="q" vid="PSA 82:3">दीन-दरिद्र की धर्म तै हिफाजत करो।<verse eid="PSA 82:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 82:4" />कंगाल अर गरीब नै बचा ल्यो;</para>
  <para style="q" vid="PSA 82:4">दुष्टां के हाथ तै उननै छुड़ाओ।<verse eid="PSA 82:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 82:5" />वे ना तो किमे समझदे अर ना किमे जाणै सै,</para>
  <para style="q" vid="PSA 82:5">पर अन्धेरै म्ह चाल्दे-फिरदे रहवै सै;</para>
  <para style="q" vid="PSA 82:5">धरती की पूरी नींव हाल जावै सै।<verse eid="PSA 82:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 82:6" />मन्‍नै कह्या था के थम ईश्‍वर सों,</para>
  <para style="q" vid="PSA 82:6">अर सबके सब परमप्रधान के बेट्टे हो;<verse eid="PSA 82:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 82:7" />फेर भी थम लोगां की तरियां मरोगे,</para>
  <para style="q" vid="PSA 82:7">अर किसे प्रधान की तरियां गिर जाओगे।”<verse eid="PSA 82:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 82:8" />हे परमेसवर उठ, धरती का न्याय कर;</para>
  <para style="q" vid="PSA 82:8">क्यूँके तू ए सारी जात्तां नै अपणे हक म्ह लेवैगा!<verse eid="PSA 82:8" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" sid="PSA 83" />
  <para style="s">दुश्मनां कै बिरुध्द प्रार्थना गीत</para>
  <para style="d">आसाप का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 83:1" />हे परमेसवर चुप ना रह;</para>
  <para style="q" vid="PSA 83:1">हे परमेसवर चुप ना रह, अर ना शांत रह!<verse eid="PSA 83:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 83:2" />क्यूँके देख तेरे दुश्मन धूम मचारे सै;</para>
  <para style="q" vid="PSA 83:2">अर तेरे बैरियाँ नै सिर ठाया सै।<verse eid="PSA 83:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 83:3" />वे चालाकी तै तेरी प्रजा के नुकसान की सलाह करै सै,</para>
  <para style="q" vid="PSA 83:3">अर तेरे बचाये होए माणसां कै खिलाफ योजना लिकाड़ै सै।<verse eid="PSA 83:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 83:4" />उननै कह्या, “आओ, हम उनका इसा नाश करां के राज्य भी मिट जावै;</para>
  <para style="q" vid="PSA 83:4">अर इस्राएल का नाम आग्गै तै याद ना रहवै।”<verse eid="PSA 83:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 83:5" />उननै एक मन हो कै योजना बणाई सै,</para>
  <para style="q" vid="PSA 83:5">अर तेरैए खिलाफ करार करया सै।<verse eid="PSA 83:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 83:6" />ये तो एदोम के तम्बू आळे</para>
  <para style="q" vid="PSA 83:6">अर इश्माएली, मोआबी अर हग्री,<verse eid="PSA 83:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 83:7" />गबाली, अम्‍मोनी, अमालेकी,</para>
  <para style="q" vid="PSA 83:7">अर सोर समेत पलिश्ती सै।<verse eid="PSA 83:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 83:8" />इनकै गैल अश्शूरी भी मिलगे सै;</para>
  <para style="q" vid="PSA 83:8">उनतै भी लूतवंशियां नै सहारा मिल्या सै। (सेला)<verse eid="PSA 83:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 83:9" />इनतै इसा कर जिसा मिद्यानियाँ तै,</para>
  <para style="q" vid="PSA 83:9">अर कीशोन नदी म्ह सीसरा अर याबीन तै करया था,<verse eid="PSA 83:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 83:10" />जो एनदोर म्ह नाश होए,</para>
  <para style="q" vid="PSA 83:10">अर धरती खात्तर खाद बणगे।<verse eid="PSA 83:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 83:11" />इनकै रईसां ताहीं ओरेब अर जएब सरीखे,</para>
  <para style="q" vid="PSA 83:11">अर इनकै सारे प्रधानां नै जेबह अर सल्मुन्‍ना की तरियां करदे,<verse eid="PSA 83:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 83:12" />जिन नै कह्या था,</para>
  <para style="q" vid="PSA 83:12">“हम परमेसवर की चराईयाँ के अधिकारी खुदे हो जावागें।”<verse eid="PSA 83:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 83:13" />हे मेरे परमेसवर इननै बमबुळिया की धूळ,</para>
  <para style="q" vid="PSA 83:13">या हवा तै उड़ाए होए तुड़ी की तरियां करदे।<verse eid="PSA 83:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 83:14" />उस आग की तरियां जो बण नै भस्‍म करै सै,</para>
  <para style="q" vid="PSA 83:14">अर उस लौ की ढाळ जो पहाड़ां नै जळा देवै सै,<verse eid="PSA 83:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 83:15" />तू इननै अपणी आँधी तै भजा दे,</para>
  <para style="q" vid="PSA 83:15">अर अपणे बमबुळिया तै घबरा दे!<verse eid="PSA 83:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 83:16" />इनकै मुँह नै शर्मिन्दगी तै नीच्‍चा कर,</para>
  <para style="q" vid="PSA 83:16">के हे यहोवा ये तेरे नाम नै टोह्वै।<verse eid="PSA 83:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 83:17" />ये सदा खात्तर शर्मिन्दा अर घबराए रहवैं</para>
  <para style="q" vid="PSA 83:17">इनकै मुँह काळे हों, अर इनका नाश हो जावै,<verse eid="PSA 83:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 83:18" />जिसतै ये जाणै के सिर्फ तू जिसका नाम यहोवा सै,</para>
  <para style="q" vid="PSA 83:18">सारी धरती कै उप्पर परमप्रधान सै।<verse eid="PSA 83:18" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" sid="PSA 84" />
  <para style="s">परमेसवर के भवन की चाहत</para>
  <para style="d">प्रधान बजाण आळे खात्तर गित्तीथ म्ह कोरहवंशियों का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 84:1" />हे सेनाओं के यहोवा, तेरे रहण की जगहां कितनी प्यारी सै!<verse eid="PSA 84:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 84:2" />मेरा जी यहोवा के आँगणां की अभिलाषा करदे-करदे बेसुध होग्या सै;</para>
  <para style="q" vid="PSA 84:2">मेरा तन-मन दोन्‍नु जिन्दे परमेसवर नै पुकारण लागरे सै।<verse eid="PSA 84:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 84:3" />हे सेनाओं के यहोवा, हे मेरे राजा, अर मेरे परमेसवर, तेरी वेदियाँ म्ह गौरैया<note caller="+" style="f"><char style="fr" closed="false">84:3 </char><char style="fq" closed="false">गौरैया </char><char style="ft" closed="false">एक छोट्टी चिड़ियाँ</char></note> नै अपणा बसेरा</para>
  <para style="q" vid="PSA 84:3">अर शूपाबेनी नै आल्हणा बणा लिया सै जिस म्ह वा अपणे बच्‍चें राक्खे।<verse eid="PSA 84:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 84:4" />कितणे धन्य सै वो, जो तेरे भवन म्ह रहवै सै;</para>
  <para style="q" vid="PSA 84:4">वो तेरी स्तुति लगातार करदे रहवैगें। (सेला)<verse eid="PSA 84:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 84:5" />कितणे धन्य सै, वो माणस जो तेरे तै ताकत पावै सै,</para>
  <para style="q" vid="PSA 84:5">अर वो जिन नै सिय्योन की सड़क का ख्याल रहवै सै।<verse eid="PSA 84:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 84:6" />वे रोण की तराई म्ह जान्दे होए उसनै चोयां की जगहां बणावै सै;</para>
  <para style="q" vid="PSA 84:6">फेर बारिस की आगली बूंद उस म्ह आशीष ए आशीष तै उपजावै सै।<verse eid="PSA 84:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 84:7" />वो ताकत पै ताकत पान्दे जावै सै;</para>
  <para style="q" vid="PSA 84:7">उन म्ह तै हर एक जन सिय्योन म्ह परमेसवर नै अपणा मुँह दिखावैगा।<verse eid="PSA 84:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 84:8" />हे सेनाओं के परमेसवर यहोवा, मेरी प्रार्थना सुण,</para>
  <para style="q" vid="PSA 84:8">हे याकूब के परमेसवर, कान लगा! (सेला)<verse eid="PSA 84:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 84:9" />हे परमेसवर, हे म्हारी ढाल, निगांह कर;</para>
  <para style="q" vid="PSA 84:9">अर अपणे अभिषिक्त का मुँह देख!<verse eid="PSA 84:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 84:10" />क्यूँके तेरे आँगणां म्ह का एक दिन किते और के हजार दिनां तै घणा बढ़कै सै।</para>
  <para style="q" vid="PSA 84:10">दुष्टां‍ के डेरयां म्ह रहण तै</para>
  <para style="q" vid="PSA 84:10">अपणे परमेसवर के भवन की देह्ळी पै खड्या रहणा ए मन्‍नै घणा भावै सै।<verse eid="PSA 84:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 84:11" />क्यूँके यहोवा परमेसवर सूरज अर ढाल सै;</para>
  <para style="q" vid="PSA 84:11">यहोवा अनुग्रह करैगा, अर महिमा देवैगा;</para>
  <para style="q" vid="PSA 84:11">अर जो माणस खरी चाल चाल्‍लै सै;</para>
  <para style="q" vid="PSA 84:11">उननै वो किसे भी आच्छी चीज कै बिना न्ही रहण देगा।<verse eid="PSA 84:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 84:12" />हे सेनाओं के यहोवा,</para>
  <para style="q" vid="PSA 84:12">कितना धन्य सै वो माणस, जो तेरे पै भरोस्सा राक्खै सै!<verse eid="PSA 84:12" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" sid="PSA 85" />
  <para style="s">राष्ट्र के कल्याण खात्तर प्रार्थना</para>
  <para style="d">प्रधान बजाण आळयां खात्तर: कोरहवंशियों का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 85:1" />हे यहोवा, तू अपणे देश पै खुश होया, याकूब नै गुलाम्मी तै छुड़ा ल्याया सै।<verse eid="PSA 85:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 85:2" />तन्‍नै अपणी प्रजा के अधर्म ताहीं माफ करया सै;</para>
  <para style="q" vid="PSA 85:2">अर उसके सारे पाप ढक दिये सै। (सेला)<verse eid="PSA 85:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 85:3" />तन्‍नै अपणा छो शान्त करया सै;</para>
  <para style="q" vid="PSA 85:3">अर अपणे भड़के होए छो नै दूर करया सै।<verse eid="PSA 85:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 85:4" />हे म्हारे उद्धारकर्त्ता परमेसवर, हमनै दोबारा तै बसा,</para>
  <para style="q" vid="PSA 85:4">अर अपणा छो म्हारे पै तै दूर कर!<verse eid="PSA 85:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 85:5" />के तू म्हारे पै सदा गुस्सा रहवैगा?</para>
  <para style="q" vid="PSA 85:5">के तू पीढ़ी तै पीढ़ी तक छो करदा रहवैगा?<verse eid="PSA 85:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 85:6" />के तू हमनै फेर ना जिवावैगा,</para>
  <para style="q" vid="PSA 85:6">ताके तेरी प्रजा तेरे म्ह आनन्द करे?<verse eid="PSA 85:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 85:7" />हे यहोवा अपणी दया हमनै दिखा,</para>
  <para style="q" vid="PSA 85:7">अर तू म्हारा उद्धार कर।<verse eid="PSA 85:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 85:8" />मै कान लगाऐ रहूँगा के परमेसवर यहोवा के कहवै सै,</para>
  <para style="q" vid="PSA 85:8">वो तो अपणी प्रजा तै जो उसके भक्‍त सै, शान्ति की बात कहवैगा;</para>
  <para style="q" vid="PSA 85:8">ताके वे मुड़कै बेकूफी ना करण लाग्गै।<verse eid="PSA 85:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 85:9" />जरुर उसका भय मानण आळयां के उद्धार का बखत धोरै सै,</para>
  <para style="q" vid="PSA 85:9">फेर म्हारे देश म्ह महिमा का निवास होवैगा।<verse eid="PSA 85:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 85:10" />करुणा अर सच्‍चाई आप्पस मै मिलगी सै;</para>
  <para style="q" vid="PSA 85:10">धर्म अर शान्ति नै आप्पस म्ह चुम्‍बन करया सै।<verse eid="PSA 85:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 85:11" />धरती म्ह तै सच्‍चाई उगै</para>
  <para style="q" vid="PSA 85:11">अर सुर्ग तै धर्म झुकै सै।<verse eid="PSA 85:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 85:12" />हाँ, यहोवा खास चीज देवैगा,</para>
  <para style="q" vid="PSA 85:12">अर म्हारी धरती अपणी पैदावार देवैगी।<verse eid="PSA 85:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 85:13" />धर्म उसकै आग्गै-आग्गै चाल्‍लैगा,</para>
  <para style="q" vid="PSA 85:13">अर उसके पायां के निसानां नै म्हारे खात्तर राह बणावैगा।<verse eid="PSA 85:13" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" sid="PSA 86" />
  <para style="s">बिलाप अर प्रार्थना</para>
  <para style="d">दाऊद की प्रार्थना</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 86:1" />हे यहोवा कान लगाकै मेरी सुण ले,</para>
  <para style="q" vid="PSA 86:1">क्यूँके मै दीन अर दरिद्र सूं।<verse eid="PSA 86:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 86:2" />मेरी जान की हिफाजत कर, क्यूँके मै भक्‍त सूं;</para>
  <para style="q" vid="PSA 86:2">तू मेरा परमेसवर सै, इस करकै अपणे दास का,</para>
  <para style="q" vid="PSA 86:2">जिसका भरोस्सा तेरे पै सै, उद्धार कर।<verse eid="PSA 86:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 86:3" />हे प्रभु, मेरे पै अनुग्रह कर,</para>
  <para style="q" vid="PSA 86:3">क्यूँके मै तन्‍नै ए लगातार पुकारदा रहूँ सूं।<verse eid="PSA 86:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 86:4" />अपणे दास के मन नै आनन्दित कर,</para>
  <para style="q" vid="PSA 86:4">क्यूँके हे प्रभु, मै अपणा मन तेरी ए ओड़ लगाऊ सूं।<verse eid="PSA 86:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 86:5" />क्यूँके हे प्रभु, तू भला अर माफ करण आळा सै,</para>
  <para style="q" vid="PSA 86:5">अर जितने तेरे ताहीं पुकारै सै उन सारया खात्तर तू अति करुणामय सै।<verse eid="PSA 86:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 86:6" />हे यहोवा मेरी प्रार्थना की ओड़ कान लगा,</para>
  <para style="q" vid="PSA 86:6">अर मेरे गिड़गिड़ाणे नै ध्यान तै सुण।<verse eid="PSA 86:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 86:7" />मुसीबत कै दिन मै तन्‍नै पुकारूँगा,</para>
  <para style="q" vid="PSA 86:7">क्यूँके तू मेरी सुण लेगा।<verse eid="PSA 86:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 86:8" />हे प्रभु, देवत्यां म्ह तै कोए भी तेरै बरगा न्ही,</para>
  <para style="q" vid="PSA 86:8">अर ना किसी के काम तेरे काम्मां कै बराबर सै।<verse eid="PSA 86:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 86:9" />हे प्रभु जितनी जातियाँ ताहीं तन्‍नै बणाया सै,</para>
  <para style="q" vid="PSA 86:9">सारी आकै तेरे स्याम्ही झुकैंगी</para>
  <para style="q" vid="PSA 86:9">अर तेरे नाम की महिमा करैगी।<verse eid="PSA 86:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 86:10" />क्यूँके तू महान अर बड़े-बड़े काम करण आळा सै,</para>
  <para style="q" vid="PSA 86:10">सिर्फ तू ए परमेसवर सै।<verse eid="PSA 86:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 86:11" />हे यहोवा अपणा राह मन्‍नै दिखा, फेर मै तेरे सच्‍चे राह पै चाल्‍लूँगा,</para>
  <para style="q" vid="PSA 86:11">मेरे ताहीं एक चित्त कर ताके मै तेरे नाम का भय मान्‍नु।<verse eid="PSA 86:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 86:12" />हे प्रभु, हे मेरे परमेसवर, मै अपणे पूरे मन तै तेरा धन्यवाद करुँगा,</para>
  <para style="q" vid="PSA 86:12">अर तेरे नाम की महिमा सदा करदा रहूँगा।<verse eid="PSA 86:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 86:13" />क्यूँके तेरी करुणा मेरे उप्पर बड़ी सै;</para>
  <para style="q" vid="PSA 86:13">अर तन्‍नै मेरे ताहीं अधोलोक की तह म्ह जाण तै बचा लिया सै।<verse eid="PSA 86:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 86:14" />हे परमेसवर, अभिमानी लोग मेरे खिलाफ उठे सै,</para>
  <para style="q" vid="PSA 86:14">अर उपद्रवियाँ का झुण्ड मेरी जान का खोज्जी होया सै,</para>
  <para style="q" vid="PSA 86:14">अर वे तेरे बारै म्ह कुछ न्ही सोचदे।<verse eid="PSA 86:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 86:15" />पर प्रभु दयालु अर अनुग्रहकारी परमेसवर सै,</para>
  <para style="q" vid="PSA 86:15">तू देर तै छो करण आळा अर अति करुणामय सै।<verse eid="PSA 86:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 86:16" />मेरी और मुड़कै मेरे पै दया कर;</para>
  <para style="q" vid="PSA 86:16">अपणे दास नै तू शक्ति दे,</para>
  <para style="q" vid="PSA 86:16">अर अपणी दास्सी के बेट्टे का उद्धार कर।<verse eid="PSA 86:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 86:17" />मन्‍नै भलाई की कोए निशान्‍नी दिखा,</para>
  <para style="q" vid="PSA 86:17">जिसनै देखकै मेरे बैरी निराश हों,</para>
  <para style="q" vid="PSA 86:17">क्यूँके हे यहोवा तन्‍नै आप मेरी मदद करी</para>
  <para style="q" vid="PSA 86:17">अर मेरे ताहीं शान्ति दी सै।<verse eid="PSA 86:17" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" sid="PSA 87" />
  <para style="s">परमेसवर का नगर सिय्योन की स्तुति म्ह</para>
  <para style="d">कोरहवंशियों का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 87:1" />उसकी नींव पवित्र पहाड़ां म्ह सै;<verse eid="PSA 87:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 87:2" />अर यहोवा सिय्योन के दरवाज्यां तै याकूब के सारे रहण आळयां तै बढ़कै प्यार राक्खै सै।<verse eid="PSA 87:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 87:3" />हे परमेसवर के नगर,</para>
  <para style="q" vid="PSA 87:3">तेरे बारै म्ह महिमा की बात कही सै। (सेला)<verse eid="PSA 87:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 87:4" />मै अपणे जाण-पिछाण आळयां तै रहब<note caller="+" style="f"><char style="fr" closed="false">87:4 </char><char style="fq" closed="false">रहब </char><char style="ft" closed="false">यो मिस्र का एक काव्य नाम सै</char></note> अर बाबेल की भी चर्चा करुँगा;</para>
  <para style="q" vid="PSA 87:4">पलिश्‍त, सोर अर कूश नै देक्खो,</para>
  <para style="q" vid="PSA 87:4">“यो ओड़ै पैदा होया था।”<verse eid="PSA 87:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 87:5" />अर सिय्योन कै बारै म्ह यो कह्या जावैगा,</para>
  <para style="q" vid="PSA 87:5">“इन म्ह तै हरेक का जन्म उस म्ह होया था,”</para>
  <para style="q" vid="PSA 87:5">अर परमप्रधान आप्पे उसनै मजबूत राक्खैगा।<verse eid="PSA 87:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 87:6" />यहोवा जिब देश-देश के माणसां के नाम लिखकै गिण लेगा, फेर न्यू कहवैगा,</para>
  <para style="q" vid="PSA 87:6">“यो ओड़ै पैदा होया था।” (सेला)<verse eid="PSA 87:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 87:7" />गाणिया अर नाच्‍चणीये दोन्‍नु कहवैगें,</para>
  <para style="q" vid="PSA 87:7">“म्हारे सारे चोए तेरे म्ह पाए जावै सै।”<verse eid="PSA 87:7" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" sid="PSA 88" />
  <para style="s">निराशा म्ह मदद खात्तर प्रार्थना गीत</para>
  <para style="d">कोरहवंशियों का भजन</para>
  <para style="d">प्रधान बजाण आळे खात्तर महलतलग्नोत राग म्ह एज्रावंशी हेमान का मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 88:1" />हे मेरे उद्धारकर्त्ता परमेसवर यहोवा,</para>
  <para style="q" vid="PSA 88:1">मै दिन-रात तेरै आग्गै चिल्‍लान्दा आया सूं।<verse eid="PSA 88:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 88:2" />मेरी प्रार्थना तेरै ताहीं पोहचै,</para>
  <para style="q" vid="PSA 88:2">मेरे चिल्‍लाणे की और कान लगा!<verse eid="PSA 88:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 88:3" />क्यूँके मेरा जी क्ळेश म्ह भरया होया सै,</para>
  <para style="q" vid="PSA 88:3">अर मेरा जी अधोलोक कै धोरै पोहच्या सै।<verse eid="PSA 88:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 88:4" />मै कब्र म्ह पड़ण आळयां म्ह गिण्या गया सूं;</para>
  <para style="q" vid="PSA 88:4">मै कमजोर माणसां की तरियां होग्या सूं।<verse eid="PSA 88:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 88:5" />मै मुर्दयां कै बीच छोड्या गया सूं,</para>
  <para style="q" vid="PSA 88:5">अर जो घात होकै कब्र म्ह पड़े सै,</para>
  <para style="q" vid="PSA 88:5">जिननै तू फेर याद न्ही करदा</para>
  <para style="q" vid="PSA 88:5">अर वे तेरी मदद कै बिना सै,</para>
  <para style="q" vid="PSA 88:5">उनकी तरियां मै होग्या सूं।<verse eid="PSA 88:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 88:6" />तन्‍नै मेरे ताहीं खड्डे के तळी म्ह,</para>
  <para style="q" vid="PSA 88:6">अन्धेरै अर ढुंघी जगहां म्ह राख्या सै।<verse eid="PSA 88:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 88:7" />तेरी जळजळाहट मेरे पै बणी होई सै,</para>
  <para style="q" vid="PSA 88:7">अर तन्‍नै अपणे सारे तरगां तै मेरे ताहीं दुख दिया सै।<verse eid="PSA 88:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 88:8" />तन्‍नै मेरे पिछाणन आळयां ताहीं मेरे तै दूर करया सै;</para>
  <para style="q" vid="PSA 88:8">अर मेरे ताहीं उनकी नजर म्ह घिनोणा करया सै।</para>
  <para style="q" vid="PSA 88:8">मै कैद्दी सूं अर लिकड़ न्ही सकदा;<verse eid="PSA 88:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 88:9" />दुख भुगतदे-भुगतदे मेरी आँख धुँधळागी।</para>
  <para style="q" vid="PSA 88:9">हे यहोवा, मै लगातार तेरे ताहीं पुकारदा अर अपणे हाथ तेरी ओड़ फैलान्दा आया सूं।<verse eid="PSA 88:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 88:10" />के तू मुर्दयां खात्तर अदभुत काम करैगा?</para>
  <para style="q" vid="PSA 88:10">के मरे होये लोग उठकै तेरा धन्यवाद करैगें? (सेला)<verse eid="PSA 88:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 88:11" />के कब्र म्ह तेरी दया का,</para>
  <para style="q" vid="PSA 88:11">अर बर्बादी की हालत मै तेरी सच्‍चाई का वर्णन करया जावैगा?<verse eid="PSA 88:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 88:12" />के तेरे अदभुत काम अन्धकार म्ह,</para>
  <para style="q" vid="PSA 88:12">या तेरा धर्म बर्बादी की हालत की म्ह जाण्या जावैगा?<verse eid="PSA 88:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 88:13" />पर हे यहोवा, मन्‍नै तेरी दोहाई दी सै;</para>
  <para style="q" vid="PSA 88:13">अर सबेरै कै बखत मेरी प्रार्थना तेरै तक पोंहचैगी।<verse eid="PSA 88:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 88:14" />हे यहोवा, तू मन्‍नै क्यूँ छोड्डै सै?</para>
  <para style="q" vid="PSA 88:14">तू अपणा मुँह मेरे तै क्यूँ छिपाये रहवै सै?<verse eid="PSA 88:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 88:15" />मै बचपन तै दुखी यानी अधमरया सूं,</para>
  <para style="q" vid="PSA 88:15">तेरे तै भय खान्दे मै घणा बेचैन हो होग्या सूं।<verse eid="PSA 88:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 88:16" />तेरा छो मेरे पै पड्या सै;</para>
  <para style="q" vid="PSA 88:16">उस भय तै मै मिट ग्या सूं।<verse eid="PSA 88:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 88:17" />वो दिन भर पाणी की तरियां मेरे ताहीं घेरे रहवै सै;</para>
  <para style="q" vid="PSA 88:17">वो मेरे च्यांरु ओड़ दिखाई देवै सै।<verse eid="PSA 88:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 88:18" />तन्‍नै दोस्त अर भाई दोनुआ ताहीं मेरे तै दूर करया सै;</para>
  <para style="q" vid="PSA 88:18">अर मेरी जाण-पिछाण आळयां ताहीं अन्धकार म्ह गेर दिया सै।<verse eid="PSA 88:18" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" sid="PSA 89" />
  <para style="s">राष्ट्रीय मुसीबत कै बखत स्तुतिगान</para>
  <para style="d">एतान एज्रावंशी का मश्कील</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 89:1" />मै यहोवा की सारी करुणा खात्तर सदा गान्दा रहूँगा;</para>
  <para style="q" vid="PSA 89:1">मै तेरी सच्‍चाई पीढ़ी तै पीढ़ी तक बतान्दा रहूँगा।<verse eid="PSA 89:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 89:2" />क्यूँके मन्‍नै कह्या सै, “तेरी करुणा सदा बणी रहवैगी,</para>
  <para style="q" vid="PSA 89:2">तू सुर्ग म्ह अपणी सच्‍चाई नै स्थिर राक्खैगा।”<verse eid="PSA 89:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 89:3" />तन्‍नै कह्या, “मन्‍नै अपणे चुणे होए तै करार करया सै,</para>
  <para style="q" vid="PSA 89:3">मन्‍नै अपणे दास दाऊद तै कसम खाई सै,<verse eid="PSA 89:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 89:4" />‘मै तेरे खानदान नै सदा बणाए राक्खूँगा;</para>
  <para style="q" vid="PSA 89:4">अर तेरी राजगद्दी नै पीढ़ी-पीढ़ी तक बणाए राक्खूँगा’।”<verse eid="PSA 89:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 89:5" />हे यहोवा, सुर्ग म्ह तेरे अदभुत काम्मां की,</para>
  <para style="q" vid="PSA 89:5">अर पवित्रां की सभा म्ह तेरी सच्‍चाई की बड़ाई होवैगी।<verse eid="PSA 89:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 89:6" />क्यूँके आकाशमण्‍डल म्ह यहोवा कै बराबर कौण हो सकै सै?</para>
  <para style="q" vid="PSA 89:6">ताकतवर के बेट्याँ म्ह तै कौण सै जिसके गैल यहोवा की बराबरी करी जावैगी?<verse eid="PSA 89:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 89:7" />परमेसवर पवित्रां की सभा म्ह घणा बड़ाई के योग्य,</para>
  <para style="q" vid="PSA 89:7">अर अपणे चारु ओड़ सारे रहण आळयां तै घणा भययोग्य सै।<verse eid="PSA 89:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 89:8" />हे सेनाओं के परमेसवर यहोवा,</para>
  <para style="q" vid="PSA 89:8">हे यहोवा, तेरे बराबर कौण सामर्थी सै?</para>
  <para style="q" vid="PSA 89:8">तेरी सच्‍चाई तो तेरै च्यांरु ओड़ सै!<verse eid="PSA 89:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 89:9" />समुन्दर के घमण्ड नै तू ए तोड़ै सै;</para>
  <para style="q" vid="PSA 89:9">जिब उसके तरंग उठ्ठै सै, फेर तू उन ताहीं शान्त कर देवै सै।<verse eid="PSA 89:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 89:10" />तन्‍नै रहब<note caller="+" style="f"><char style="fr" closed="false">89:10 </char><char style="fq" closed="false">रहब </char><char style="ft" closed="false">यो उस बखत की कहाणियाँ म्ह बोल्या जाण आळा एक समुन्दरी जीव था अर वो एक बुरे माणसां का एक प्रतीक था</char></note> ताहीं घात करै होया की तरियां कुचळ दिया,</para>
  <para style="q" vid="PSA 89:10">अर अपणे दुश्मनां नै अपणे बाजूवां के जोर तै तित्तर-बितर करया सै।<verse eid="PSA 89:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 89:11" />अकास तेरा सै, धरती भी तेरी सै;</para>
  <para style="q" vid="PSA 89:11">दुनिया अर जो कुछ उस म्ह सै, वो तन्‍नै ए बणाया सै।<verse eid="PSA 89:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 89:12" />उत्तर अर दक्षिण ताहीं तन्‍नै ए रच्या;</para>
  <para style="q" vid="PSA 89:12">ताबोर<note caller="+" style="f"><char style="fr" closed="false">89:12 </char><char style="fq" closed="false">ताबोर </char><char style="ft" closed="false">यो एक 555 मीटर ऊँच्‍चा पहाड़ था जो गलील राज्य के दक्षिणी छोर म्ह था </char></note> अर हेर्मोन<note caller="+" style="f"><char style="fr" closed="false">89:12 </char><char style="fq" closed="false">हेर्मोन </char><char style="ft" closed="false">यो एक 2,750 मीटर ऊँच्‍चा पहाड़ था जो गलीली झील तै 75 किलोमीटर की दूरी पै था</char></note> तेरे नाम का जयजयकार करै सै।<verse eid="PSA 89:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 89:13" />तेरी भुजा ताकतवर सै;</para>
  <para style="q" vid="PSA 89:13">तेरा हाथ शक्तिमान अर तेरा सोळा हाथ भारी सै।<verse eid="PSA 89:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 89:14" />तेरे सिंहासन का मूल, धर्म अर न्याय सै;</para>
  <para style="q" vid="PSA 89:14">करुणा अर सच्‍चाई तेरा आग्गै-आग्गै चाल्‍लै सै।<verse eid="PSA 89:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 89:15" />कितना धन्य सै वो समाज जो खुशी की ललकार<note caller="+" style="f"><char style="fr" closed="false">89:15 </char><char style="fq" closed="false">खुशी की ललकार </char><char style="ft" closed="false">परमेसवर की आराधना म्ह स्तुति करण की आवाज</char></note> नै पिच्छाणै सै;</para>
  <para style="q" vid="PSA 89:15">हे यहोवा, वे माणस तेरे तेज की रोशनी म्ह चाल्‍लै सै,<verse eid="PSA 89:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 89:16" />वे तेरे नाम के कारण दिन भर मगन रहवै सै,</para>
  <para style="q" vid="PSA 89:16">अर तेरे धर्म कै कारण महान हो ज्या सै।<verse eid="PSA 89:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 89:17" />क्यूँके तू उनके ताकत की शोभा सै,</para>
  <para style="q" vid="PSA 89:17">अर अपणी प्रसन्‍नता तै म्हारे सींग<note caller="+" style="f"><char style="fr" closed="false">89:17 </char><char style="fq" closed="false">सींग </char><char style="ft" closed="false">ताकत</char></note> नै ऊँच्‍चा करैगा<note caller="+" style="f"><char style="fr" closed="false">89:17 </char><char style="fq" closed="false">म्हारे सींग नै ऊँच्‍चा करैगा </char><char style="ft" closed="false">म्हारी ताकत नै बढ़ावैगा</char></note>।<verse eid="PSA 89:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 89:18" />क्यूँके म्हारी ढाल यहोवा की ओड़ तै सै,</para>
  <para style="q" vid="PSA 89:18">म्हारा राजा इस्राएल के पवित्र की ओड़ तै सै।<verse eid="PSA 89:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 89:19" />एक बखत तन्‍नै अपणे भक्‍त तै दर्शन देकै बात करी;</para>
  <para style="q" vid="PSA 89:19">अर कह्या, “मन्‍नै मदद करण की जिम्मेदारी एक वीर तै दे राक्खी सै,</para>
  <para style="q" vid="PSA 89:19">अर प्रजा म्ह तै एक ताहीं चुण कै बढ़ाया सै।<verse eid="PSA 89:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 89:20" />मन्‍नै अपणे दास दाऊद ताहीं लेकै,</para>
  <para style="q" vid="PSA 89:20">अपणे पवित्र तेल तै उसका अभिषेक करया सै।<verse eid="PSA 89:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 89:21" />मेरा हाथ उसकै गैल बण्या रहवैगा,</para>
  <para style="q" vid="PSA 89:21">अर मेरी बाजू उसनै मजबूत राक्खैगी।<verse eid="PSA 89:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 89:22" />दुश्मन उस ताहीं तंग करण न्ही पावैगा,</para>
  <para style="q" vid="PSA 89:22">अर ना कठोर माणस उसनै दुख देण पावैगा।<verse eid="PSA 89:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 89:23" />मै उसके दुश्मनां नै उसकै स्याम्ही तै नाश करुँगा,</para>
  <para style="q" vid="PSA 89:23">अर उसके बैरियाँ पै मुसीबत गेरूँगा।<verse eid="PSA 89:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 89:24" />पर मेरी सच्‍चाई अर करुणा उसपै बणी रहवैगी,</para>
  <para style="q" vid="PSA 89:24">अर मेरा नाम कै कारण उसका सींग ऊँच्‍चा हो जावैगा।<verse eid="PSA 89:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 89:25" />मै समुन्दर नै उसके हाथ कै नीच्‍चै</para>
  <para style="q" vid="PSA 89:25">अर महानदा नै उसके सोळे हाथ कै नीच्‍चै कर दियुँगा।<verse eid="PSA 89:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 89:26" />वो मेरे ताहीं पुकार कै कहवैगा, ‘तू मेरा पिता सै,</para>
  <para style="q" vid="PSA 89:26">मेरा परमेसवर अर मेरे उद्धार की चट्टान सै।’<verse eid="PSA 89:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 89:27" />फेर मै उसनै अपणा जेठ्ठा,</para>
  <para style="q" vid="PSA 89:27">अर धरती के राजायां पै प्रधान बणाऊँगा।<verse eid="PSA 89:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 89:28" />मै अपणी दया उसपै सदा बणाए राखूँगा,</para>
  <para style="q" vid="PSA 89:28">अर मेरा करार उसकै खात्तर अटल रहवैगा।<verse eid="PSA 89:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 89:29" />मै उसके वंश नै सदा बणाए राखूँगा,</para>
  <para style="q" vid="PSA 89:29">अर उसकी राजगद्दी सुर्ग की तरियां सदा बणी रहवैगी।<verse eid="PSA 89:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 89:30" />जै उसके वंश के माणस मेरे नियम-कायदे नै छोड्डै</para>
  <para style="q" vid="PSA 89:30">अर मेरे नियमां के मुताबिक ना चाल्‍ले,<verse eid="PSA 89:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 89:31" />जै वे मेरी विधियाँ का उलंघण करै,</para>
  <para style="q" vid="PSA 89:31">अर मेरे हुकमां नै ना मान्‍नै,<verse eid="PSA 89:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 89:32" />तो मै उनके अपराध्धां की सजा सोंटें तै,</para>
  <para style="q" vid="PSA 89:32">अर उनके अधर्म का दण्ड कोड़े तै दियुँगा।<verse eid="PSA 89:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 89:33" />फेर भी मै अपणी दया उसपै तै ना हटाऊँगा,</para>
  <para style="q" vid="PSA 89:33">अर ना सच्‍चाई त्याग कै झूठ्ठा ठहरूँगा।<verse eid="PSA 89:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 89:34" />मै अपणे करार नै न्ही तोड़ूँगा,</para>
  <para style="q" vid="PSA 89:34">अर जो मेरे मुँह तै लिकड़ चुक्या सै, उस ताहीं न्ही बदलूँगा।<verse eid="PSA 89:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 89:35" />एक बार मै अपणी पवित्रता की कसम खा चुक्या सूं;</para>
  <para style="q" vid="PSA 89:35">मै दाऊद नै कदे धोक्खा न्ही दियुँगा।<verse eid="PSA 89:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 89:36" />उसका वंश सदा रहवैगा,</para>
  <para style="q" vid="PSA 89:36">अर उसकी राजगद्दी सूरज की तरियां मेरै स्याम्ही बणी रहवैगी।<verse eid="PSA 89:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 89:37" />वो चाँद की तरियां,</para>
  <para style="q" vid="PSA 89:37">अर आकाशमण्‍डल के बिश्वास लायक गवाह की तरियां सदा बण्या रहवैगा।”<verse eid="PSA 89:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 89:38" />फेर भी तन्‍नै अपणे अभिषिक्त ताहीं छोड़ दिया, अर जमाए छोड़ दिया,</para>
  <para style="q" vid="PSA 89:38">अर उसपै घणा छो करया सै।<verse eid="PSA 89:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 89:39" />तन्‍नै अपणे दास कै गैल करे होए करार ताहीं छोड़ दिया,</para>
  <para style="q" vid="PSA 89:39">अर उसके मुकुट ताहीं धरती पै गिराकै अशुद्ध करया सै।<verse eid="PSA 89:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 89:40" />तन्‍नै उसके सारे बाड़याँ ताहीं तोड़ दिया सै,</para>
  <para style="q" vid="PSA 89:40">अर उसके गढ़ां ताहीं उजाड़ दिया सै।<verse eid="PSA 89:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 89:41" />सारे मुसाफिर उसनै लूट लेवै सै,</para>
  <para style="q" vid="PSA 89:41">अर उसके पड़ोसियाँ तै उसकी बदनामी होवै सै।<verse eid="PSA 89:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 89:42" />तन्‍नै उसके बिरोधियाँ ताहीं हावी करया;</para>
  <para style="q" vid="PSA 89:42">अर उसके सारे दुश्मनां ताहीं खुश करया सै।<verse eid="PSA 89:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 89:43" />फेर तू उसकी तलवार की धार नै मोड़ देवै सै,</para>
  <para style="q" vid="PSA 89:43">अर युद्ध म्ह उसके पैर जमण न्ही देन्दा।<verse eid="PSA 89:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 89:44" />तन्‍नै उसका तेज<note caller="+" style="f"><char style="fr" closed="false">89:44 </char><char style="fq" closed="false">तेज </char><char style="ft" closed="false">राजदंड</char></note> ले लिया सै,</para>
  <para style="q" vid="PSA 89:44">अर उसके सिंहासन ताहीं धरती पै पटक दिया सै।<verse eid="PSA 89:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 89:45" />तन्‍नै उसकी जवान्‍नी ताहीं घटाया,</para>
  <para style="q" vid="PSA 89:45">अर उस ताहीं शर्मिन्दगी तै ढँक दिया सै।<verse eid="PSA 89:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 89:46" />हे यहोवा, तू कद तक लगातार मुँह फेरे रहवैगा,</para>
  <para style="q" vid="PSA 89:46">तेरी जळजळाहट कद तक आग की तरियां भड़की रहवैगी।<verse eid="PSA 89:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 89:47" />मन्‍नै याद कर, के मै किसा अभागा सूं,</para>
  <para style="q" vid="PSA 89:47">तन्‍नै सारे माणसां ताहीं क्यूँ खामखा बणाया सै?<verse eid="PSA 89:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 89:48" />कौण आदमी सदा अमर रहवैगा?</para>
  <para style="q" vid="PSA 89:48">के कोए अपणी जान नै अधोलोक तै बचा सकैगा?<verse eid="PSA 89:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 89:49" />हे प्रभु तेरी पुराणे बखत की दया कित्त गई,</para>
  <para style="q" vid="PSA 89:49">जिसके खात्तर तन्‍नै अपणी सच्‍चाई की कसम दाऊद तै खाई थी?<verse eid="PSA 89:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 89:50" />हे प्रभु अपणे दास्सां की बदनामी की सुधि ले;</para>
  <para style="q" vid="PSA 89:50">मै तो सारी ताकतवर जात्तां का बोझ लिए रहूँ सूं।<verse eid="PSA 89:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 89:51" />तेरे उन दुश्मनां नै तो हे यहोवा,</para>
  <para style="q" vid="PSA 89:51">तेरे अभिषिक्त कै पाच्छै पड़कै उसका मजाक उड़ाया सै।<verse eid="PSA 89:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 89:52" />यहोवा सदा धन्य रहवैगा!</para>
  <para style="q" vid="PSA 89:52">आमीन फेर आमीन।<verse eid="PSA 89:52" /></para>
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" sid="PSA 90" />
  <para style="ms">चौथा भाग</para>
  <para style="mr">
    <ref loc="PSA 90-106">भजन संहिता 90-106</ref></para>
  <para style="s">अनन्त परमेसवर अर नशवर माणस</para>
  <para style="d">परमेसवर के जन मूसा की प्रार्थना</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 90:1" />हे प्रभु, तू पीढ़ी तै पीढ़ी तक म्हारे खात्तर धाम बण्या सै।<verse eid="PSA 90:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 90:2" />इसतै पैहला के पहाड़ पैदा होए,</para>
  <para style="q" vid="PSA 90:2">या तन्‍नै धरती अर दुनिया की रचना करी,</para>
  <para style="q" vid="PSA 90:2">यानी शरुवात तै अंत तक तू ए परमेसवर सै।<verse eid="PSA 90:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 90:3" />तू माणस नै माट्टी म्ह ए मिला देवैगा,</para>
  <para style="q" vid="PSA 90:3">अर न्यू कहवै सै, “हे माणसों, बोहड़ आओ!”<verse eid="PSA 90:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 90:4" />क्यूँके हजार साल तेरी नजर म्ह इसे सै,</para>
  <para style="q" vid="PSA 90:4">जिसा कल का दिन जोणसा बीतग्या,</para>
  <para style="q" vid="PSA 90:4">या रात का एक पहर।<verse eid="PSA 90:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 90:5" />तू माणसां नै धारां म्ह बहा देवै सै;</para>
  <para style="q" vid="PSA 90:5">वे सपने जिसे लाग्गै सै,</para>
  <para style="q" vid="PSA 90:5">वो सबेरै नै बढ़ण आळी घास की तरियां होवै सै।<verse eid="PSA 90:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 90:6" />वो सुबेरै फुल्‍लै अर बढै़ सै,</para>
  <para style="q" vid="PSA 90:6">अर साँझ तक कटकै मुरझा जावै सै।<verse eid="PSA 90:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 90:7" />क्यूँके हम तेरे छो तै नाश होवां सां;</para>
  <para style="q" vid="PSA 90:7">अर तेरी जळजळाहट तै घबरागे सां।<verse eid="PSA 90:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 90:8" />तन्‍नै म्हारे अधर्म के काम्मां ताहीं अपणे स्याम्ही,</para>
  <para style="q" vid="PSA 90:8">अर म्हारे छिपे होए पापां ताहीं अपणी नजरां कै स्याम्ही राख्या सै।<verse eid="PSA 90:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 90:9" />क्यूँके म्हारे सारे दिन तेरे छो म्ह बीत ज्या सै,</para>
  <para style="q" vid="PSA 90:9">हम अपणे साल शब्‍द की तरियां बितावां सां।<verse eid="PSA 90:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 90:10" />म्हारी उम्र के साल सत्तर तो होवै सै,</para>
  <para style="q" vid="PSA 90:10">अर चाहे जोर कै कारण अस्सी साल भी हो जावै,</para>
  <para style="q" vid="PSA 90:10">फेर भी उनका घमण्ड सिर्फ कष्‍ट अर दुखे-दुख सै;</para>
  <para style="q" vid="PSA 90:10">क्यूँके वो तावळी कट ज्या सै, अर हम जान्दे रहवां सां।<verse eid="PSA 90:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 90:11" />तेरे छो की शक्ति नै</para>
  <para style="q" vid="PSA 90:11">अर तेरे भय कै योग्य छो नै कौण समझ सकै सै?<verse eid="PSA 90:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 90:12" />हमनै अपणे दिन गिणन की समझ दे के हम बुद्धिमान हो जावां।<verse eid="PSA 90:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 90:13" />हे यहोवा बोहड़ आ! कद तक?</para>
  <para style="q" vid="PSA 90:13">अर अपणे दास्सां पै तरस खा!<verse eid="PSA 90:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 90:14" />सबेरै कै बखत म्हारे ताहीं अपणी दया तै छिका,</para>
  <para style="q" vid="PSA 90:14">के हम जिन्दगी भर जयजयकार अर खुशी मनान्दे रहवां।<verse eid="PSA 90:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 90:15" />जितने दिन तू हमनै दुख देन्दा आया,</para>
  <para style="q" vid="PSA 90:15">अर जितने साल हम क्ळेश भोगदे आए सां</para>
  <para style="q" vid="PSA 90:15">उतने ए साल हमनै खुशी दे।<verse eid="PSA 90:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 90:16" />तेरा काम तेरे दास्सां पै,</para>
  <para style="q" vid="PSA 90:16">अर तेरा प्रताप उनकी औलादां पै जाहिर हो।<verse eid="PSA 90:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 90:17" />म्हारे परमेसवर यहोवा की मनोहरता म्हारे पै जाहिर हो,</para>
  <para style="q" vid="PSA 90:17">तू म्हारे हाथ्थां का काम म्हारै खात्तर मजबूत कर,</para>
  <para style="q" vid="PSA 90:17">म्हारे हाथ्थां के काम नै मजबूत कर।<verse eid="PSA 90:17" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" sid="PSA 91" />
  <para style="s">परमेसवर म्हारा रक्षक</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 91:1" />जो परमप्रधान की ओट म्ह बैठ्या रहवैगा,</para>
  <para style="q" vid="PSA 91:1">वो सर्वशक्तिमान की छाया म्ह ठिकाणा पावैगा।<verse eid="PSA 91:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 91:2" />मै यहोवा कै खात्तर कहूँगा, “वो मेरा शरणस्‍थान अर गढ़ सै;</para>
  <para style="q" vid="PSA 91:2">वो मेरा परमेसवर सै, जिसपै मै भरोस्सा राक्खूँगा”<verse eid="PSA 91:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 91:3" />वो मेरे ताहीं शिकारी के जाळ तै,</para>
  <para style="q" vid="PSA 91:3">अर महामारी तै बचावैगा;<verse eid="PSA 91:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 91:4" />वो मन्‍नै अपणे पंखा की आड़ म्ह ले लेगा,</para>
  <para style="q" vid="PSA 91:4">अर तू उसके पखां कै तळै ठिकाणा पावैगा;</para>
  <para style="q" vid="PSA 91:4">उसकी सच्‍चाई तेरै खात्तर ढाल अर झिलम ठैहरैगी।<verse eid="PSA 91:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 91:5" />तू ना तो रात के भय तै डरैगा,</para>
  <para style="q" vid="PSA 91:5">अर ना उस तीर तै जो दिन म्ह उडै सै,<verse eid="PSA 91:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 91:6" />ना उस मरी तै जो अन्धेरै म्ह फैल्‍लै सै,</para>
  <para style="q" vid="PSA 91:6">अर ना उस बड़े रोग तै जो दिन-दुफैरी म्ह उजाड़ै सै।<verse eid="PSA 91:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 91:7" />तेरै धोरै हजार,</para>
  <para style="q" vid="PSA 91:7">अर तेरी सोळी ओड़ दस हजार पड़ैगें;</para>
  <para style="q" vid="PSA 91:7">फेर भी वो तेरे धोरै ना आवैगा।<verse eid="PSA 91:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 91:8" />पर तू अपणी आँखां तै</para>
  <para style="q" vid="PSA 91:8">अर दुष्टां‍ का अन्त देक्खैगा।<verse eid="PSA 91:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 91:9" />हे यहोवा, तू मेरा शरणस्‍थान बण्या सै।</para>
  <para style="q" vid="PSA 91:9">तन्‍नै जो परमप्रधान ताहीं अपणा धाम मान लिया सै,<verse eid="PSA 91:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 91:10" />इस करकै कोए मुसीबत तेरे पै ना पड़ैगी,</para>
  <para style="q" vid="PSA 91:10">अर ना कोए दुख तेरे डेरे कै धोरै आवैगा।<verse eid="PSA 91:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 91:11" />क्यूँके वो अपणे दूत्तां नै तेरै खात्तर हुकम देवैगा,</para>
  <para style="q" vid="PSA 91:11">के जित्त किते तू जावै वो तेरी मदद करै।<verse eid="PSA 91:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 91:12" />वो तेरे ताहीं हाथो हाथ ठा लेवैंगे,</para>
  <para style="q" vid="PSA 91:12">इसा ना हो के तेरे पायां म्ह पत्त्थर तै ठोक्‍कर लाग्गै।<verse eid="PSA 91:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 91:13" />तू शेर अर नाग नै कुचळैगा,</para>
  <para style="q" vid="PSA 91:13">तू जवान शेर अर अजगर नै लताड़ैगा।<verse eid="PSA 91:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 91:14" />उसनै मेरे तै जो प्यार करया सै, इस करकै मै उसनै छुड़ाऊँगा;</para>
  <para style="q" vid="PSA 91:14">मै उस ताहीं ऊँच्‍ची जगहां म्ह राक्खूँगा, क्यूँके उसनै मेरे नाम ताहीं जाण लिया सै।<verse eid="PSA 91:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 91:15" />जिब वो मन्‍नै पुकारै, फेर मै उसकी सुणूँगा;</para>
  <para style="q" vid="PSA 91:15">मुसीबत कै बखत मै उसकै गैल रहूँगा,</para>
  <para style="q" vid="PSA 91:15">मै उसनै बचाकै उसकी महिमा बढ़ाऊँगा।<verse eid="PSA 91:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 91:16" />मै उसनै लम्बी उम्र तै तृप्त कर दियुँगा,</para>
  <para style="q" vid="PSA 91:16">अर अपणे करे होये उद्धार का दर्शन दिखाऊँगा<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" sid="PSA 92" />
  <para style="s">स्तुति का गीत</para>
  <para style="d">भजन। विश्राम खात्तर गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 92:1" />यहोवा का धन्यवाद करणा भला सै,</para>
  <para style="q" vid="PSA 92:1">हे परमप्रधान, तेरे नाम का भजन गाणा;<verse eid="PSA 92:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 92:2" />सबेरै कै बखत तेरी करुणा</para>
  <para style="q" vid="PSA 92:2">अर रोज रात तेरी सच्‍चाई का प्रचार करणा,<verse eid="PSA 92:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 92:3" />दस तारआळे बाजे अर सारंगी पै,</para>
  <para style="q" vid="PSA 92:3">अर वीणा पै गम्भीर स्वर तै गाणा भला सै।<verse eid="PSA 92:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 92:4" />क्यूँके, हे यहोवा, तन्‍नै मेरे ताहीं अपणे काम्मां तै खुश करया सै;</para>
  <para style="q" vid="PSA 92:4">अर मै तेरे हाथ्थां के काम्मां कै कारण तेरी जयजयकार करुँगा।<verse eid="PSA 92:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 92:5" />हे यहोवा, तेरे काम कितणे बड़े सै!</para>
  <para style="q" vid="PSA 92:5">तेरी योजना घणी गम्भीर सै;<verse eid="PSA 92:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 92:6" />पशु बरगा माणस इस ताहीं न्ही समझदा,</para>
  <para style="q" vid="PSA 92:6">अर मूर्ख इसका विचार न्ही करदा:<verse eid="PSA 92:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 92:7" />के दुष्ट जो घास की तरियां फूल्‍लै-फळै सै,</para>
  <para style="q" vid="PSA 92:7">अर सारे गलत करणीये जो घणे राज्जी होवै सै,</para>
  <para style="q" vid="PSA 92:7">यो इस करकै होवै सै, के वो सदा खात्तर नाश हो ज्या,<verse eid="PSA 92:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 92:8" />पर हे यहोवा, तू सदा विराजमान रहवैगा।<verse eid="PSA 92:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 92:9" />क्यूँके हे यहोवा, तेरे दुश्मन, हाँ तेरे दुश्मन नाश होंगे;</para>
  <para style="q" vid="PSA 92:9">सब गलत करणीये तित्तर-बितर होवैगें।<verse eid="PSA 92:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 92:10" />पर मेरा सींग<note caller="+" style="f"><char style="fr" closed="false">92:10 </char><char style="fq" closed="false">सींग </char><char style="ft" closed="false">शक्ति</char></note> तन्‍नै जंगळी सांड की तरियां ऊँच्‍चा करया सै;</para>
  <para style="q" vid="PSA 92:10">तन्‍नै ताजे तेल तै मेरा अभिषेक करया सै<note caller="+" style="f"><char style="fr" closed="false">92:10 </char><char style="fq" closed="false">तन्‍नै ताजे तेल तै मेरा अभिषेक करया सै </char><char style="ft" closed="false">तन्‍नै मेरे ताहीं खुशी तै भरया सै</char></note>।<verse eid="PSA 92:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 92:11" />मै अपणे दुश्मनां पै निगांह करकै,</para>
  <para style="q" vid="PSA 92:11">अर उन कुकर्मियाँ का हाल जो मेरै खिलाफ उठ्ठे थे, सुणकै संतुष्ट होया सूं।<verse eid="PSA 92:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 92:12" />धर्मी माणस खजूर की तरियां फूल्‍लै-फळगें,</para>
  <para style="q" vid="PSA 92:12">अर लबानोन के देवदार की तरियां बढ़दे रहवैंगे।<verse eid="PSA 92:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 92:13" />वे यहोवा के भवन म्ह बोए जाकै</para>
  <para style="q" vid="PSA 92:13">म्हारे परमेसवर के आँगणां म्ह फूल्‍लै-फळगें।<verse eid="PSA 92:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 92:14" />वो पुराणे होण पै भी फळदे रहवैगें,</para>
  <para style="q" vid="PSA 92:14">अर रस भरे अर लहरान्दे रहवैंगे,<verse eid="PSA 92:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 92:15" />जिसतै या बात जाहिर हो, के यहोवा सच्‍चा सै;</para>
  <para style="q" vid="PSA 92:15">वो मेरी चट्टान सै, अर उस म्ह कुछ भी बुराई कोनी।<verse eid="PSA 92:15" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" sid="PSA 93" />
  <para style="s">परमेसवर के राज्य की महिमा</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 93:1" />यहोवा राजा सै; उसनै महानता का पहरावा पैहरया सै;</para>
  <para style="q" vid="PSA 93:1">यहोवा पहरावा पहरे होये, अर सामर्थ्य का पटका बाँधे सै।</para>
  <para style="q" vid="PSA 93:1">इस करकै दुनिया स्थिर सै, वो न्ही टळण का।<verse eid="PSA 93:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 93:2" />हे यहोवा, तेरी राजगद्दी सदाकाल तै स्थिर सै,</para>
  <para style="q" vid="PSA 93:2">तू हमेशा तै सै।<verse eid="PSA 93:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 93:3" />हे यहोवा, महानदा का शोर हो रह्या सै,</para>
  <para style="q" vid="PSA 93:3">महानदा का बड़ा शब्‍द हो रह्या सै,</para>
  <para style="q" vid="PSA 93:3">महानद गरजै सै।<verse eid="PSA 93:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 93:4" />महासागर के शब्‍द तै भी,</para>
  <para style="q" vid="PSA 93:4">अर समुन्दर की महातरंगां तै भी,</para>
  <para style="q" vid="PSA 93:4">विराजमान यहोवा घणाए महान सै।<verse eid="PSA 93:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 93:5" />तेरी चितौनी घणी बिश्वास लायक सै;</para>
  <para style="q" vid="PSA 93:5">हे यहोवा, तेरे भवन नै युग-युग पवित्रता ए शोभा देवै सै।<verse eid="PSA 93:5" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" sid="PSA 94" />
  <para style="s">परमेसवर धर्मी का शरणस्‍थान</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 94:1" />हे यहोवा, हे पलटा लेण आळे परमेसवर,</para>
  <para style="q" vid="PSA 94:1">हे पलटा लेण आळे परमेसवर, अपणा तेज दिखा<note caller="+" style="f"><char style="fr" closed="false">94:1 </char><char style="fq" closed="false">अपणा तेज दिखा </char><char style="ft" closed="false">चमका दिखा</char></note>!<verse eid="PSA 94:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 94:2" />हे धरती के न्यायी, उठ;</para>
  <para style="q" vid="PSA 94:2">अर घमण्डियाँ नै बदला दे!<verse eid="PSA 94:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 94:3" />हे यहोवा, दुष्ट माणस कद तक,</para>
  <para style="q" vid="PSA 94:3">दुष्ट माणस कद तक बड़ाई मारदे रहवैगें?<verse eid="PSA 94:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 94:4" />वे अभिमानी अर ढ़िठाई की बात करै सै,</para>
  <para style="q" vid="PSA 94:4">सारे अनर्थकारी बड़ाई मारै सै।<verse eid="PSA 94:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 94:5" />हे यहोवा, वे तेरी प्रजा नै पिस गेरै सै,</para>
  <para style="q" vid="PSA 94:5">वे तेरे अपणे हिस्से नै दुख देवै सै।<verse eid="PSA 94:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 94:6" />वे बिधवा अर परदेशी का घात करै,</para>
  <para style="q" vid="PSA 94:6">अर अनाथ्थां नै मार गेरै सै;<verse eid="PSA 94:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 94:7" />अर न्यू कहवै सै, “यहोवा न्ही देक्खैगा,</para>
  <para style="q" vid="PSA 94:7">याकूब का परमेसवर किमे न्ही सोचदा।”<verse eid="PSA 94:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 94:8" />थम जो प्रजा म्ह पशु बरगे सो, सोचो करो;</para>
  <para style="q" vid="PSA 94:8">अर हे मूर्खो थम कद बुद्धिमान बणोगे?<verse eid="PSA 94:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 94:9" />जिसनै कान दिये, के वो खुद न्ही सुणदा?</para>
  <para style="q" vid="PSA 94:9">जिसनै आँख बणाई, के वो खुद न्ही देख्दा?<verse eid="PSA 94:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 94:10" />जो जात-जात नै ताड़ना देवै, अर माणसां नै ज्ञान सिखावै सै,</para>
  <para style="q" vid="PSA 94:10">के वो ना सुधारैगा?<verse eid="PSA 94:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 94:11" />यहोवा माणसां की सारी योजना नै जाणै सै के वो झूठ सै।<verse eid="PSA 94:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 94:12" />हे यहोवा, कितना धन्य सै वो माणस जिसकी तू ताड़ना करै सै,</para>
  <para style="q" vid="PSA 94:12">अर अपणे नियम-कायदे सिखावै सै,<verse eid="PSA 94:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 94:13" />क्यूँके तू उसनै मुसीबत के दिनां म्ह उस बखत तक चैन देन्दा रहवै सै,</para>
  <para style="q" vid="PSA 94:13">जिब तक दुष्टां कै खात्तर खड्डा न्ही खोद्या जान्दा।<verse eid="PSA 94:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 94:14" />क्यूँके यहोवा अपणी प्रजा नै ना छोड्डैगा,</para>
  <para style="q" vid="PSA 94:14">वो अपणे खास हिस्से नै ना छोड़ैगा;<verse eid="PSA 94:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 94:15" />पर न्याय फेर भी धर्म कै मुताबिक करया जावैगा,</para>
  <para style="q" vid="PSA 94:15">अर सारे सीध्धे मन आळे उसकै पाच्छै-पाच्छै हो लेंगे।<verse eid="PSA 94:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 94:16" />कुकर्मियाँ कै खिलाफ मेरी ओड़ कौण खड्या होवैगा?</para>
  <para style="q" vid="PSA 94:16">मेरी और तै अनर्थकारियाँ का कौण सामना करैगा?<verse eid="PSA 94:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 94:17" />जै यहोवा मेरा मददगार ना होन्दा,</para>
  <para style="q" vid="PSA 94:17">तो मन्‍नै एकदम चुपचाप होकै रहणा पड़दा।<verse eid="PSA 94:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 94:18" />जिब मन्‍नै कह्या, “मेरा पैर फिसळण लाग्या,”</para>
  <para style="q" vid="PSA 94:18">फेर हे यहोवा, तेरी करुणा नै मै थाम लिया।<verse eid="PSA 94:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 94:19" />जिब मेरे मन म्ह भोत सी चिन्ता होवै सै,</para>
  <para style="q" vid="PSA 94:19">फेर हे यहोवा, तेरी दी होई शान्ति तै मन्‍नै सुख होवै सै।<verse eid="PSA 94:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 94:20" />के तेरे अर दुष्टां के सिंहासन कै बीच म्ह मेळ-मिलाप होग्या,</para>
  <para style="q" vid="PSA 94:20">जो नियम-कायदे की आड़ म्ह उत्पात मचावै सै?<verse eid="PSA 94:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 94:21" />वो धर्मी की जान लेण ताहीं टोळ बणावै सै,</para>
  <para style="q" vid="PSA 94:21">अर बेकसूर नै मौत कै घाट उतार देवै सै।<verse eid="PSA 94:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 94:22" />पर यहोवा मेरा गढ़,</para>
  <para style="q" vid="PSA 94:22">अर मेरा परमेसवर मेरी शरण की चट्टान ठैहराया सै।<verse eid="PSA 94:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 94:23" />उसनै उनका अनर्थ काम उन्हे पै गेर दिया</para>
  <para style="q" vid="PSA 94:23">अर वो उननै उनकी बुराई कै जरिये सत्यानाश करैगा।</para>
  <para style="q" vid="PSA 94:23">म्हारा परमेसवर यहोवा उननै सत्यानाश करैगा।<verse eid="PSA 94:23" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" sid="PSA 95" />
  <para style="s">स्तुतिगान</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 95:1" />आओ हम यहोवा कै खात्तर ऊँच्‍ची आवाज तै गावां,</para>
  <para style="q" vid="PSA 95:1">अपणे उद्धार की चट्टान का जयजयकार करां!<verse eid="PSA 95:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 95:2" />हम धन्यवाद करदे होये उसकै स्याम्ही आवां,</para>
  <para style="q" vid="PSA 95:2">अर भजन गान्दे होए उसका जयजयकार करां।<verse eid="PSA 95:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 95:3" />क्यूँके यहोवा महान परमेसवर सै,</para>
  <para style="q" vid="PSA 95:3">अर सारे देवत्यां का उप्पर महान राजा सै।<verse eid="PSA 95:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 95:4" />धरती की ढुंघी जगहां भी उसे कै हाथ म्ह सै;</para>
  <para style="q" vid="PSA 95:4">अर पहाड़ां की चोट्टी भी उसे की सै।<verse eid="PSA 95:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 95:5" />समुन्दर उसका सै, अर उसे नै उस ताहीं बणाया,</para>
  <para style="q" vid="PSA 95:5">अर सुखी धरती भी उसे के हाथ की रचना सै।<verse eid="PSA 95:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 95:6" />आओ हम झुककै दण्डवत करां,</para>
  <para style="q" vid="PSA 95:6">अर अपणे कर्त्ता यहोवा कै स्याम्ही घुटने टेकां!<verse eid="PSA 95:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 95:7" />क्यूँके वोए म्हारा परमेसवर सै,</para>
  <para style="q" vid="PSA 95:7">अर हम उसकी चराई की प्रजा</para>
  <para style="q" vid="PSA 95:7">अर उसकै हाथ की भेड़ सां।</para>
  <para style="q" vid="PSA 95:7">आच्छा होन्दा, के आज थम उसकी बात सुणदे!<verse eid="PSA 95:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 95:8" />अपणा-अपणा दिल इसा कठोर ना करो, जिसा मरीबा<note caller="+" style="f"><char style="fr" closed="false">95:8 </char><char style="fq" closed="false">मरीबा </char><char style="ft" closed="false">झगड़ा करणा</char></note> म्ह,</para>
  <para style="q" vid="PSA 95:8">अर मस्सा के दिन बियाबान म्ह होया था,<verse eid="PSA 95:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 95:9" />जिब थारे बुजुर्गां नै मेरे ताहीं परख्या,</para>
  <para style="q" vid="PSA 95:9">उननै मेरे ताहीं जाँच्या अर मेरे काम ताहीं भी देख्या।<verse eid="PSA 95:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 95:10" />चाळीस साल ताहीं मै उस पीढ़ी के लोग्गां तै रुस्या रह्या,</para>
  <para style="q" vid="PSA 95:10">अर मन्‍नै कह्या, “ये तो भरमाण आळे मन के सै,</para>
  <para style="q" vid="PSA 95:10">अर उननै मेरी राह न्ही पिच्छाणी<note caller="+" style="f"><char style="fr" closed="false">95:10 </char><char style="fq" closed="false">उननै मेरी राह न्ही पिच्छाणी</char><char style="ft" closed="false">उननै मेरे हुकमां का पालन न्ही करया</char></note>।”<verse eid="PSA 95:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 95:11" />इस करकै मन्‍नै छो म्ह आकै कसम खाई के</para>
  <para style="q" vid="PSA 95:11">ये मेरे बिश्राम स्‍थान म्ह कदे बड़ न्ही पावैंगें।<verse eid="PSA 95:11" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" sid="PSA 96" />
  <para style="s">परमेसवर सब तै बड़ा राजा</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 96:1" />यहोवा खात्तर एक नया गीत गाओ,</para>
  <para style="q" vid="PSA 96:1">हे सारी धरती के माणसों यहोवा खात्तर गाओ!<verse eid="PSA 96:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 96:2" />यहोवा खात्तर गाओ, उसके नाम नै धन्य कहो;</para>
  <para style="q" vid="PSA 96:2">हर रोज उसके करे होए उद्धार की खुशखबरी सुणान्दे रहो।<verse eid="PSA 96:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 96:3" />गैरजात्तां म्ह उसकी महिमा का,</para>
  <para style="q" vid="PSA 96:3">अर देश-देश के माणसां म्ह उसके अदभुत काम्मां का जिक्र करो।<verse eid="PSA 96:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 96:4" />क्यूँके यहोवा महान अर घणा स्तुति कै लायक सै;</para>
  <para style="q" vid="PSA 96:4">वो तो सारे देवत्यां तै घणा भययोग्य सै।<verse eid="PSA 96:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 96:5" />क्यूँके देश-देश के सारे देवता तो मूर्त ए सै;</para>
  <para style="q" vid="PSA 96:5">पर सुर्ग यहोवा नै ए बणाया सै।<verse eid="PSA 96:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 96:6" />उसके च्यांरु ओड़ महिमा अर ताकत सै;</para>
  <para style="q" vid="PSA 96:6">उसके पवित्र स्‍थान म्ह सामर्थ्य अर शोभा सै।<verse eid="PSA 96:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 96:7" />हे देश-देश के कुलों, यहोवा का गुणगान करो,</para>
  <para style="q" vid="PSA 96:7">यहोवा की महिमा अर सामर्थ्य नै मान्‍नो!<verse eid="PSA 96:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 96:8" />यहोवा कै नाम की इसी महिमा करो जो उसके योग्य सै;</para>
  <para style="q" vid="PSA 96:8">भेंट लेकै उसके आँगणां म्ह आओ!<verse eid="PSA 96:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 96:9" />पवित्रता तै शोभामान होकै यहोवा नै दण्डवत करो;</para>
  <para style="q" vid="PSA 96:9">हे सारी धरती के माणसों उसकै स्याम्ही कापते रहो!<verse eid="PSA 96:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 96:10" />जात-जात म्ह कहो, “यहोवा राजा होया सै!</para>
  <para style="q" vid="PSA 96:10">अर दुनिया इसी मजबूत सै, के वो टळण की कोनी;</para>
  <para style="q" vid="PSA 96:10">वो देश-देश के माणसां का न्याय खराई तै करैगा।”<verse eid="PSA 96:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 96:11" />अकास आनन्द मनावै, अर धरती मगन हो;</para>
  <para style="q" vid="PSA 96:11">समुन्दर अर उस म्ह की सारी चीज गरज उठै;<verse eid="PSA 96:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 96:12" />मैदान अर जो कुछ उस म्ह सै, वो प्रफुल्‍लित हो;</para>
  <para style="q" vid="PSA 96:12">उसे बखत बण के सारे दरखत जयजयकार करैगें।<verse eid="PSA 96:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 96:13" />यो यहोवा कै स्याम्ही हो, क्यूँके वो आण आळा सै।</para>
  <para style="q" vid="PSA 96:13">वो धरती का न्याय करण आण आळा सै, वो धर्म तै दुनिया का,</para>
  <para style="q" vid="PSA 96:13">अर सच्‍चाई तै देश-देश के लोगां का न्याय करैगा।<verse eid="PSA 96:13" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" sid="PSA 97" />
  <para style="s">परमेसवर सब तै बड़ा शासक</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 97:1" />यहोवा राजा होया सै, धरती मगन हो;</para>
  <para style="q" vid="PSA 97:1">अर द्वीप जो भोत-से सै, वो भी खुशी मनावै!<verse eid="PSA 97:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 97:2" />बादळ अर अँधेरा उसके च्यांरु ओड़ सै;</para>
  <para style="q" vid="PSA 97:2">उसके सिंहासन की नींव धर्म अर न्याय सै।<note caller="+" style="f"><char style="fr" closed="false">97:2 </char><char style="ft" closed="false">वो धार्मिकता अर न्याय पै राज करण आळा सै</char></note><verse eid="PSA 97:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 97:3" />उसकै आग्गै-आग्गै आग चाल्दी होई</para>
  <para style="q" vid="PSA 97:3">उसके दुश्मनां नै च्यांरु ओड़ तै भस्‍म करै सै।<verse eid="PSA 97:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 97:4" />उसकी बिजळियाँ तै दुनिया रोशन होई,</para>
  <para style="q" vid="PSA 97:4">धरती देखकै थरथरागी सै!<verse eid="PSA 97:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 97:5" />पहाड़ यहोवा कै स्याम्ही,</para>
  <para style="q" vid="PSA 97:5">मोम की तरियां पिघळगें,</para>
  <para style="q" vid="PSA 97:5">यानिके सारी धरती के परमेसवर कै स्याम्ही।<verse eid="PSA 97:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 97:6" />अकास नै उसके धर्म की गवाही दी;</para>
  <para style="q" vid="PSA 97:6">अर देश-देश के सारे माणसां नै उसकी महिमा देक्खी सै।<verse eid="PSA 97:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 97:7" />यहोवा उनतै प्यार करै सै जो बुराई तै नफरत करै सै<note caller="+" style="f"><char style="fr" closed="false">97:7 </char><char style="fq" closed="false">यहोवा उनतै प्यार करै सै जो बुराई तै नफरत करै सै </char><char style="ft" closed="false">जो यहोवा तै प्यार करै सै वो बुराई तै नफरत करै सै</char></note></para>
  <para style="q" vid="PSA 97:7">अर जो मूरतां पै घमण्ड करै सै, वे शर्मिन्दा हों;</para>
  <para style="q" vid="PSA 97:7">हे सारे देवताओं थम उसे नै दण्डवत करो।<verse eid="PSA 97:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 97:8" />सिय्योन सुणकै खुश होया,</para>
  <para style="q" vid="PSA 97:8">अर यहूदा की बेट्टी मगन होई;</para>
  <para style="q" vid="PSA 97:8">हे यहोवा, यो तेरे नियमां कै कारण होया।<verse eid="PSA 97:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 97:9" />क्यूँके हे यहोवा, तू सारी धरती कै उप्पर परमप्रधान सै;</para>
  <para style="q" vid="PSA 97:9">तू सारे देवत्यां तै घणा महान ठहरया सै।<verse eid="PSA 97:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 97:10" />हे यहोवा के प्रेमियों, बुराई तै नफरत करो;</para>
  <para style="q" vid="PSA 97:10">वो अपणे भक्‍तां की जान की हिफाजत करै सै,</para>
  <para style="q" vid="PSA 97:10">अर उन ताहीं दुष्टां कै हाथ तै बचावै सै।<verse eid="PSA 97:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 97:11" />चान्दणा धर्मी माणसां पै चमकै सै<note caller="+" style="f"><char style="fr" closed="false">97:11 </char><char style="fq" closed="false">चान्दणा धर्मी माणसां पै चमकै सै </char><char style="ft" closed="false">चान्दणा धर्मी माणसां खात्तर बोया गया सै</char></note>,</para>
  <para style="q" vid="PSA 97:11">अर सीध्धे मन आळयां खात्तर आनन्द बोया गया सै।<verse eid="PSA 97:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 97:12" />हे धर्मियों, यहोवा कै कारण खुश हो;</para>
  <para style="q" vid="PSA 97:12">अर जिस पवित्र नाम तै वो याद करया जावै सै, उसका धन्यवाद करो!<verse eid="PSA 97:12" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" sid="PSA 98" />
  <para style="s">उद्धार अर न्याय खात्तर स्तुतिगान</para>
  <para style="d">भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 98:1" />यहोवा कै खात्तर एक नया गीत गाओ,</para>
  <para style="q" vid="PSA 98:1">क्यूँके उसनै बड़े-बड़े काम करे सै!</para>
  <para style="q" vid="PSA 98:1">उसके सोळे हाथ अर पवित्र भुजा नै उसकै खात्तर उद्धार करया सै!<verse eid="PSA 98:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 98:2" />यहोवा नै अपणा करया होया उद्धार जाहिर करया सै,</para>
  <para style="q" vid="PSA 98:2">उसनै गैरजात्तां की नजर म्ह अपणा धर्म प्रगट करया सै।<verse eid="PSA 98:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 98:3" />उसनै इस्राएल के घरान्‍ने पै अपणी दया</para>
  <para style="q" vid="PSA 98:3">अर सच्‍चाई की सुधि ली,</para>
  <para style="q" vid="PSA 98:3">अर धरती के सारे दूर-दूर के देशां नै म्हारे परमेसवर का करया होया उद्धार देख्या सै।<verse eid="PSA 98:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 98:4" />हे सारी धरती के माणसों, यहोवा की जयजयकार करो;</para>
  <para style="q" vid="PSA 98:4">खुशी की गैल जयजयकार करो, अर भजन गाओ!<verse eid="PSA 98:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 98:5" />वीणा बजाकै यहोवा का भजन गाओ,</para>
  <para style="q" vid="PSA 98:5">वीणा बजाकै भजन के बोल सुणाओ।<verse eid="PSA 98:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 98:6" />तुरही अर नरसिंगे बजा-बजाकै</para>
  <para style="q" vid="PSA 98:6">यहोवा राजा की जयजयकार करो।<verse eid="PSA 98:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 98:7" />समुन्दर अर उस म्ह की सारी चीज गरज उठै;</para>
  <para style="q" vid="PSA 98:7">दुनिया अर उसके रहण आळे ऊँच्‍ची आवाज तै!<verse eid="PSA 98:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 98:8" />नदियाँ ताड़ी बजावै;</para>
  <para style="q" vid="PSA 98:8">पहाड़ मिलकै जयजयकार करै।<verse eid="PSA 98:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 98:9" />यो यहोवा कै स्याम्ही हो, क्यूँके वो धरती का न्याय करण खात्तर आण आळा सै।</para>
  <para style="q" vid="PSA 98:9">वो धर्म तै दुनिया का,</para>
  <para style="q" vid="PSA 98:9">अर सच्‍चाई तै देश-देश के लोगां का न्याय करैगा।<verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" sid="PSA 99" />
  <para style="s">पवित्रता खात्तर स्तुतिगान</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 99:1" />यहोवा राजा होया सै; देश-देश के लोग काँपगे!</para>
  <para style="q" vid="PSA 99:1">वो करूबां पै बैठ्या सै; धरती डोल उठै!<verse eid="PSA 99:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 99:2" />यहोवा सिय्योन म्ह महान सै;</para>
  <para style="q" vid="PSA 99:2">अर वो देश-देश के माणसां कै उप्पर प्रधान सै।<verse eid="PSA 99:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 99:3" />वो तेरे महान अर भययोग्य नाम का धन्यवाद करै!</para>
  <para style="q" vid="PSA 99:3">क्यूँके वो तो पवित्र सै।<verse eid="PSA 99:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 99:4" />ताकतवर राजा न्याय तै प्यार करै सै,<note caller="+" style="f"><char style="fr" closed="false">99:4 </char><char style="fq" closed="false">ताकतवर राजा न्याय तै प्यार करै सै </char><char style="ft" closed="false">राजा ताकतवर सै अर वो न्याय तै प्यार करै सै</char></note></para>
  <para style="q" vid="PSA 99:4">तन्‍नै ए सच्‍चाई ताहीं लाग्गू करया सै;</para>
  <para style="q" vid="PSA 99:4">न्याय अर धर्म ताहीं याकूब म्ह तन्‍नै ए चाल्‍लूँ करया सै।<verse eid="PSA 99:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 99:5" />म्हारे परमेसवर यहोवा नै सराहो;</para>
  <para style="q" vid="PSA 99:5">अर उसके पैरां की चौकी कै स्याम्ही दण्डवत करो!</para>
  <para style="q" vid="PSA 99:5">क्यूँके वो पवित्र सै!<verse eid="PSA 99:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 99:6" />उसके याजकां म्ह मूसा अर हारुन,</para>
  <para style="q" vid="PSA 99:6">अर उसके प्रार्थना करण आळयां म्ह तै शमूएल यहोवा नै पुकारै था, अर वो उनकी सुण लेवै था।<verse eid="PSA 99:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 99:7" />वो बादळ के खम्भे म्ह हो कै उनतै बात करया करदा;</para>
  <para style="q" vid="PSA 99:7">अर वे उसकी चितौनियाँ अर उसकी दी होई विधियाँ पै चाल्या करदे।<verse eid="PSA 99:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 99:8" />हे म्हारे परमेसवर यहोवा तू उनकी सुण लेवै था</para>
  <para style="q" vid="PSA 99:8">तू उनके काम्मां का पलटा तो लेवै था</para>
  <para style="q" vid="PSA 99:8">फेर भी उन खात्तर माफ करण आळा परमेसवर था।<verse eid="PSA 99:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 99:9" />म्हारे परमेसवर यहोवा नै सराहो,</para>
  <para style="q" vid="PSA 99:9">अर उसके पवित्र पर्वत पै दण्डवत करो;</para>
  <para style="q" vid="PSA 99:9">क्यूँके म्हारा परमेसवर यहोवा पवित्र सै!<verse eid="PSA 99:9" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" sid="PSA 100" />
  <para style="s">परमेसवर की स्तुति का गीत</para>
  <para style="d">धन्यवाद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 100:1" />हे सारी धरती के माणसों यहोवा की जयजयकार करो!<verse eid="PSA 100:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 100:2" />खुशी तै यहोवा की आराधना करो!</para>
  <para style="q" vid="PSA 100:2">जयजयकार के गैल उसकै स्याम्ही आओ!<verse eid="PSA 100:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 100:3" />या बात जरुर जाणो के यहोवा ए परमेसवर सै</para>
  <para style="q" vid="PSA 100:3">उस्से नै म्हारे ताहीं बणाया सै, अर हम उसे के सां;</para>
  <para style="q" vid="PSA 100:3">हम उसकी प्रजा, अर उसकी चराई की भेड़ सां।<verse eid="PSA 100:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 100:4" />उसके फाटकां म्ह धन्यवाद,</para>
  <para style="q" vid="PSA 100:4">अर उसके आँगणां म्ह स्तुति करदे होये बड़या करो,</para>
  <para style="q" vid="PSA 100:4">उसका धन्यवाद करो, अर उसके नाम नै धन्य कहो!<verse eid="PSA 100:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 100:5" />क्यूँके यहोवा भला सै, उसकी दया हमेशा खात्तर सै,</para>
  <para style="q" vid="PSA 100:5">अर उसकी सच्‍चाई पीढ़ी तै पीढ़ी ताहीं बणी रहवै सै।<verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" sid="PSA 101" />
  <para style="s">बिश्वासयोग्य जीवन बिताण का इरादा</para>
  <para style="d">दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 101:1" />मै करुणा अर न्याय कै बारै म्ह गाऊँगा;</para>
  <para style="q" vid="PSA 101:1">हे यहोवा, मै तेराए भजन गाऊँगा।<verse eid="PSA 101:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 101:2" />मै बुद्धिमानी तै खरे राह म्ह चाल्‍लूँगा।</para>
  <para style="q" vid="PSA 101:2">तू मेरै धोरै कद आवैगा?</para>
  <para style="q" vid="PSA 101:2">मै अपणे घर म्ह मन की खराई तै अपणी चाल चाल्‍लूँगा;<verse eid="PSA 101:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 101:3" />मै किसे ओच्छे काम पै मन न्ही लाऊँगा।</para>
  <para style="q" vid="PSA 101:3">मै गलत राह पै चालण आळयां के काम तै नफरत राक्खूँ सूं;</para>
  <para style="q" vid="PSA 101:3">मै इस्से काम पै ना लाग्गूँगा।<verse eid="PSA 101:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 101:4" />टेढ़ा सुभाव मेरे तै दूर रहवैगा;</para>
  <para style="q" vid="PSA 101:4">मै बुराई नै जाणुगाँ भी न्ही।<verse eid="PSA 101:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 101:5" />जो छिपकै अपणे पड़ोसी की चुगली करै,</para>
  <para style="q" vid="PSA 101:5">मै उसका सत्यानाश करुँगा;</para>
  <para style="q" vid="PSA 101:5">जिसकी आँख चढ़ी हों अर जिसका मन घमण्डी सै, उसकी मै ना सहूँगा।<verse eid="PSA 101:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 101:6" />मेरी आँख देश के बिश्वास लायक माणसां पै लाग्गी रहवैगी के वो मेरे गेल्या रहवैं;</para>
  <para style="q" vid="PSA 101:6">जो खरे राह पै चाल्‍लै सै वोए मेरा सेवक होवैगा।<verse eid="PSA 101:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 101:7" />जो छळ करै सै वो मेरै घर कै भित्तर न्ही रहण पावैगा;</para>
  <para style="q" vid="PSA 101:7">जो झूठ बोल्‍लै सै वो मेरे स्याम्ही बण्या न्ही रहवैगा।<verse eid="PSA 101:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 101:8" />हर रोज सबेरै, मै देश के सारे दुष्टां का सत्यानाश करया करुँगा,</para>
  <para style="q" vid="PSA 101:8">ताके यहोवा के नगर के सारे अनर्थकारियाँ ताहीं नाश करुँ।<verse eid="PSA 101:8" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" sid="PSA 102" />
  <para style="s">संकट म्ह पड़े माणस की प्रार्थना</para>
  <para style="d">दीन जन की उस बखत की प्रार्थना जिब वो दुख का मारया अपणे शोक की बात यहोवा कै स्याम्ही खोलकै कहन्दा हो</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 102:1" />हे यहोवा, मेरी प्रार्थना सुण;</para>
  <para style="q" vid="PSA 102:1">मेरी दुहाई तेरे तक पोहचै!<verse eid="PSA 102:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 102:2" />मेरे मुसीबत कै दिन अपणा मुँह मेरै तै ना लह्को;</para>
  <para style="q" vid="PSA 102:2">अपणा कान मेरी ओड़ लगा;</para>
  <para style="q" vid="PSA 102:2">जिस बखत मै पुकारूँ, उसे बखत तावळ करकै मेरी सुण ले।<verse eid="PSA 102:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 102:3" />क्यूँके मेरे दिन धुम्मै की तरियां उड़े जावै सै,</para>
  <para style="q" vid="PSA 102:3">अर मेरी हाड्डी आग की तरियां जळगी सै।<verse eid="PSA 102:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 102:4" />मेरा मन जळी होई घास की तरियां सूख ग्या सै;</para>
  <para style="q" vid="PSA 102:4">अर मै अपणी रोट्टी खाणा भी भूल जाऊँ सूं।<verse eid="PSA 102:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 102:5" />कहरान्दे-कहरान्दे मेरी चमड़ी हाड्डियाँ कै चिपगी सै।<verse eid="PSA 102:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 102:6" />मै बियाबान के चील<note caller="+" style="f"><char style="fr" closed="false">102:6 </char><char style="fq" closed="false">बियाबान के चील </char><char style="ft" closed="false">जंगळी उल्‍लू</char></note> की तरियां होग्या सूं,</para>
  <para style="q" vid="PSA 102:6">मै उजड़ी होई जगहां के उल्‍लू की तरियां बणग्या सूं।<verse eid="PSA 102:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 102:7" />मै पड्या-पड्या जागदा रहूँ सूं अर गौरे की तरियां होग्या सूं</para>
  <para style="q" vid="PSA 102:7">जो छात पै एक्ला बेठ्या करै सै।<verse eid="PSA 102:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 102:8" />मेरे दुश्मन लगातार मेरी बदनामी करै सै,</para>
  <para style="q" vid="PSA 102:8">जो मेरै खिलाफ मजाक उडावै सै,</para>
  <para style="q" vid="PSA 102:8">वे मेरा नाम ले ले के श्राप देवै सै।<verse eid="PSA 102:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 102:9" />क्यूँके मन्‍नै रोट्टी की तरियां राख खाई अर आँसू मिलाकै पाणी पीऊँ सूं।<verse eid="PSA 102:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 102:10" />यो तेरे छो अर कोप कै कारण होया सै,</para>
  <para style="q" vid="PSA 102:10">क्यूँके तन्‍नै मै ठाया, अर फेर फेंक दिया।<verse eid="PSA 102:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 102:11" />मेरी उम्र ढळदी छाया की तरियां सै;</para>
  <para style="q" vid="PSA 102:11">अर मै आप घास की तरियां सूख ग्या सूं।<verse eid="PSA 102:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 102:12" />पर हे यहोवा, तू सदा विराजमान रहवैगा;</para>
  <para style="q" vid="PSA 102:12">अर जिस नाम तै तेरा स्मरण होवै सै,</para>
  <para style="q" vid="PSA 102:12">वो पीढ़ी तै पीढ़ी तक बण्या रहवैगा।<verse eid="PSA 102:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 102:13" />तू उठकै सिय्योन पै दया करैगा;</para>
  <para style="q" vid="PSA 102:13">क्यूँके उसपै दया करण का ठहराया होया बखत आ पोहच्या सै।<verse eid="PSA 102:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 102:14" />क्यूँके तेरे दास उसके पत्थरां नै भी चाहवै सै,</para>
  <para style="q" vid="PSA 102:14">अर उसके खण्डहरां की धूळ पै तरस खावै सै।<verse eid="PSA 102:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 102:15" />इस करकै जात्ति-जात्ति यहोवा के नाम का भय मान्‍नैगी,</para>
  <para style="q" vid="PSA 102:15">अर धरती के सारे राजा तेरे प्रताप तै डरैगें।<verse eid="PSA 102:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 102:16" />क्यूँके यहोवा नै सिय्योन फेर बसाया सै,</para>
  <para style="q" vid="PSA 102:16">अर वो अपणी महिमा गैल दिखाई देवै सै;<verse eid="PSA 102:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 102:17" />वो लाचार की प्रार्थना की ओड़ मुँह करै सै,</para>
  <para style="q" vid="PSA 102:17">अर उनकी प्रार्थना नै छोट्टी न्ही जाणदा।<verse eid="PSA 102:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 102:18" />या बात आण आळी पीढ़ी खात्तर लिखी जावैगी,</para>
  <para style="q" vid="PSA 102:18">ताके एक जात जो पैदा होवैगी, वा यहोवा की स्तुति करैगी।<verse eid="PSA 102:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 102:19" />क्यूँके यहोवा नै अपणे ऊँच्‍चे अर पवित्र स्‍थान म्ह तै निगांह करी;</para>
  <para style="q" vid="PSA 102:19">सुर्ग तै धरती की ओड़ देख्या सै,<verse eid="PSA 102:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 102:20" />के कैदियाँ का कराहणा सुणै,</para>
  <para style="q" vid="PSA 102:20">अर मरण आळयां के बंधन खोल्‍लै;<verse eid="PSA 102:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 102:21" />फेर लोग सिय्योन म्ह यहोवा के नाम का जिक्र करैगें,</para>
  <para style="q" vid="PSA 102:21">अर यरुशलेम म्ह उसकी स्तुति करी जावैगी;<verse eid="PSA 102:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 102:22" />यो उस बखत होवैगा जिब देश-देश,</para>
  <para style="q" vid="PSA 102:22">अर राज्य-राज्य के माणस यहोवा की उपासना करण खात्तर कठ्ठे होवैगें।<verse eid="PSA 102:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 102:23" />उसनै मेरी जिन्दगी के सफर म्ह<note caller="+" style="f"><char style="fr" closed="false">102:23 </char><char style="fq" closed="false">उसनै मेरी जिन्दगी के सफर म्ह </char><char style="ft" closed="false">जिब मै जवान ए था</char></note> दुख देकै,</para>
  <para style="q" vid="PSA 102:23">मेरी ताकत अर उम्र घटाई सै।<verse eid="PSA 102:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 102:24" />मन्‍नै कह्या, “हे मेरे परमेसवर, मेरे ताहीं आध्धी उम्र म्ह ना ठावै,</para>
  <para style="q" vid="PSA 102:24">तेरे साल पीढ़ी तै पीढ़ी ताहीं बणे रहवैगें।”<verse eid="PSA 102:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 102:25" />शरु म्ह तन्‍नै धरती की नींव डाली,</para>
  <para style="q" vid="PSA 102:25">अर अकास तेरे हाथ्थां का बणाया होया सै।<verse eid="PSA 102:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 102:26" />वो तो नाश होवैगा, पर तू बण्या रहवैगा;</para>
  <para style="q" vid="PSA 102:26">अर वो सारा कपड़े की तरियां पुराणा हो ज्यागा।</para>
  <para style="q" vid="PSA 102:26">तू उसनै कपड़ेयां की तरियां बदल देगा, अर वो तो मिट ज्यागा।<verse eid="PSA 102:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 102:27" />पर तू वोए सै,</para>
  <para style="q" vid="PSA 102:27">तेरे साल खतम न्ही होंगे।<verse eid="PSA 102:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 102:28" />तेरे दास्सां की औलाद बणी रहवैगी;</para>
  <para style="q" vid="PSA 102:28">अर उनका वंश तेरे आग्गै टिक्या रहवैगा।<verse eid="PSA 102:28" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" sid="PSA 103" />
  <para style="s">परमेसवर की दया कै खात्तर स्तुतिगान</para>
  <para style="d">दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 103:1" />हे मेरे मन, यहोवा नै धन्य कह;</para>
  <para style="q" vid="PSA 103:1">अर जो कुछ मेरै म्ह सै, वो उसके पवित्र नाम नै धन्य कहवै!<verse eid="PSA 103:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 103:2" />हे मेरे मन, यहोवा नै धन्य कह,</para>
  <para style="q" vid="PSA 103:2">अर उसके किसे उपकार नै ना भूल।<verse eid="PSA 103:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 103:3" />वोए तो तेरे सारे अधर्म नै माफ करै सै,</para>
  <para style="q" vid="PSA 103:3">अर तेरे सारे रोगां नै चंगा करै सै,<verse eid="PSA 103:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 103:4" />वोए तो तेरी जान नै नाश होण तै बचावै सै,</para>
  <para style="q" vid="PSA 103:4">अर तेरे सिर पै करुणा अर दया का मुकुट बाँधै सै<note caller="+" style="f"><char style="fr" closed="false">103:4 </char><char style="fq" closed="false">तेरे सिर पै करुणा अर दया का मुकुट बाँधै सै </char><char style="ft" closed="false">वो थमनै प्यार अर दया तै आशिषित करै सै</char></note>,<verse eid="PSA 103:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 103:5" />वोए तेरी लालसा नै खास चिज्जां तै छिकावै सै,</para>
  <para style="q" vid="PSA 103:5">जिसतै तेरी जवान्‍नी उकाब की तरियां नई हो ज्या सै।<verse eid="PSA 103:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 103:6" />यहोवा सारे पईसे होया खात्तर</para>
  <para style="q" vid="PSA 103:6">धर्म अर न्याय के काम करै सै।<verse eid="PSA 103:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 103:7" />उसनै मूसा ताहीं अपणी योजना,</para>
  <para style="q" vid="PSA 103:7">अर इस्राएलियाँ पै अपणे काम जाहिर करे।<verse eid="PSA 103:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 103:8" />यहोवा दयालु अर अनुग्रह करण आळा, देर तै छो करण आळा अर भोत-ए करुणा करण आळा सै।<verse eid="PSA 103:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 103:9" />वो हमेशा वाद-विवाद करदा ना रहवैगा,</para>
  <para style="q" vid="PSA 103:9">ना उसका छो सदा खात्तर भड़का रहवैगा।<verse eid="PSA 103:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 103:10" />उसनै म्हारे पापां कै मुताबिक म्हारे तै बरतावै न्ही करया,</para>
  <para style="q" vid="PSA 103:10">अर ना म्हारे अधर्म के काम्मां कै मुताबिक म्हारै ताहीं बदला दिया सै।<verse eid="PSA 103:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 103:11" />जिस तरियां अकास धरती कै उप्पर ऊँच्‍चा सै,</para>
  <para style="q" vid="PSA 103:11">उसे तरियां उसकी करुणा उसके डरण आळयां कै उप्पर सै।<verse eid="PSA 103:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 103:12" />पूर्व तै पश्‍चिम जितनी दूर सै,</para>
  <para style="q" vid="PSA 103:12">उसनै म्हारे अपराध्धां ताहीं म्हारे तै उतने दूर करै सै।<verse eid="PSA 103:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 103:13" />जिस तरियां बाप अपणे बाळकां पै दया करै सै,</para>
  <para style="q" vid="PSA 103:13">उसे तरियां यहोवा अपणे डरण आळयां पै दया करै सै।<verse eid="PSA 103:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 103:14" />क्यूँके वो म्हारी रचना जाणै सै;</para>
  <para style="q" vid="PSA 103:14">अर उसनै याद रहवै सै के माणस माट्टी ए सै।<verse eid="PSA 103:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 103:15" />माणस की जिन्दगी के दिन घास की तरियां होवै सै,</para>
  <para style="q" vid="PSA 103:15">वो मैदान के फूल की तरियां फुल्‍लै सै,<verse eid="PSA 103:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 103:16" />जो हवा लाग्दे ए रुक न्ही सकदा,</para>
  <para style="q" vid="PSA 103:16">अर ना वो अपणी जगहां म्ह फेर मिलैगा।<verse eid="PSA 103:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 103:17" />पर यहोवा की करुणा उसके डरण आळयां पै युग-युग,</para>
  <para style="q" vid="PSA 103:17">अर उसका धर्म उसके नात्ती-पोत्यां पै भी प्रगट होन्दा रहवै सै,<verse eid="PSA 103:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 103:18" />यानिके उनपै जो उसके करार का पालन करै</para>
  <para style="q" vid="PSA 103:18">अर उसके हुकम नै याद करकै उनपै चाल्‍लै सै।<verse eid="PSA 103:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 103:19" />यहोवा नै तो अपणा सिंहासन सुर्ग म्ह टिकाया सै,</para>
  <para style="q" vid="PSA 103:19">अर उसका राज पूरी दुनिया म्ह सै।<verse eid="PSA 103:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 103:20" />हे यहोवा के दूतों थम जो बड़े वीर हो,</para>
  <para style="q" vid="PSA 103:20">अर उसके वचन नै मानकै उन ताहीं पूरा करो सो</para>
  <para style="q" vid="PSA 103:20">उस ताहीं धन्य कहो।<verse eid="PSA 103:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 103:21" />हे यहोवा की सारी सेनाओं, हे उसके सेवकों,</para>
  <para style="q" vid="PSA 103:21">थम जो उसकी इच्छा पूरी करो सौ, उस ताहीं धन्य कहो!<verse eid="PSA 103:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 103:22" />हे यहोवा की सारी रचना,</para>
  <para style="q" vid="PSA 103:22">उसके राज्य की सारी जगहां म्ह उस ताहीं धन्य कहो।</para>
  <para style="q" vid="PSA 103:22">हे मेरे मन, तू यहोवा नै धन्य कह!<verse eid="PSA 103:22" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" sid="PSA 104" />
  <para style="s">सृष्टिकर्ता की स्तुति</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 104:1" />हे मेरे मन, तू यहोवा नै धन्य कह!</para>
  <para style="q" vid="PSA 104:1">हे मेरे परमेसवर यहोवा,</para>
  <para style="q" vid="PSA 104:1">तू घणाए महान सै!</para>
  <para style="q" vid="PSA 104:1">तू शानों-शोकत अर ऐश्‍वर्य के कपड़े पहरे होये सै,<verse eid="PSA 104:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 104:2" />तू चाँदणे नै चाद्दर की तरियां ओढ़े रहवै सै,</para>
  <para style="q" vid="PSA 104:2">अर अकास नै तम्बू की तरियां ताणे रहवै सै।<verse eid="PSA 104:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 104:3" />जो अपणी अटारियाँ की कड़ी पाणी म्ह धरै सै,</para>
  <para style="q" vid="PSA 104:3">अर बादळां नै अपणा रथ बणावै सै,</para>
  <para style="q" vid="PSA 104:3">अर हवा के पंखां पै चाल्‍लै सै,<verse eid="PSA 104:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 104:4" />जो हवा नै अपणे दूत,</para>
  <para style="q" vid="PSA 104:4">अर धधकती आग नै अपणे सेवक बणावै सै<note caller="+" style="f"><char style="fr" closed="false">104:4 </char><char style="fq" closed="false">जो हवा नै अपणे दूत, अर धधकती आग नै अपणे सेवक बणावै सै </char><char style="ft" closed="false">जो अपणे दूत नै हवा की तरियां अर अपणे सेवक नै धधकती आग की तरियां बणा देवै सै</char></note>।<verse eid="PSA 104:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 104:5" />तन्‍नै धरती उसकी नींव पै टिकाये राक्खी सै,</para>
  <para style="q" vid="PSA 104:5">ताके वो कदे भी ना डगमगावै।<verse eid="PSA 104:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 104:6" />तन्‍नै उस ताहीं गहरे सागर तै ढँक दिया सै जिस तरियां कपड़यां तै;</para>
  <para style="q" vid="PSA 104:6">पाणी पहाड़ां पै रुक ग्या।<verse eid="PSA 104:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 104:7" />तेरी फटकार तै वो भाजग्या;</para>
  <para style="q" vid="PSA 104:7">तेरी गरजण की आवाज सुणदे ए, वो तावळ करकै बह ग्या।<verse eid="PSA 104:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 104:8" />वो पहाड़ां पै चढ़ ग्या, अर तराइयां कै राह तै उस जगहां म्ह उतर ग्या</para>
  <para style="q" vid="PSA 104:8">जो तन्‍नै उसकै खात्तर त्यार करी थी।<verse eid="PSA 104:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 104:9" />तन्‍नै एक हद ठहराई जिसनै वो पार न्ही कर सकदा,</para>
  <para style="q" vid="PSA 104:9">अर ना उल्ट कै धरती नै लाँघ सकदा।<verse eid="PSA 104:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 104:10" />तू तराइयां म्ह चोए बहावै सै;</para>
  <para style="q" vid="PSA 104:10">वे पहाड़ां कै बीच म्ह तै बहवै सै।<verse eid="PSA 104:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 104:11" />उस म्ह तै मैदान के सारे जीव जन्तु पाणी पीवैं सै,</para>
  <para style="q" vid="PSA 104:11">जंगळी गधे भी अपणी प्यास बुझा लेवै सै।<verse eid="PSA 104:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 104:12" />उनकै धोरै अकास के पंछी बसेरा करै,</para>
  <para style="q" vid="PSA 104:12">अर डाळियाँ कै बीच म्ह तै बोल्‍लै सै।<verse eid="PSA 104:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 104:13" />तू अपणी अटारियाँ म्ह<note caller="+" style="f"><char style="fr" closed="false">104:13 </char><char style="fq" closed="false">अटारियाँ म्ह </char><char style="ft" closed="false">ऊप्परली कोठड़ी</char></note> तै पहाड़ां नै पाणी तै सींच दे सै</para>
  <para style="q" vid="PSA 104:13">तेरे काम्मां के फळ तै धरती छिकी रहवै सै।<verse eid="PSA 104:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 104:14" />तू पशुआं खात्तर घास,</para>
  <para style="q" vid="PSA 104:14">अर माणसां खात्तर अनाज उगावै सै,</para>
  <para style="q" vid="PSA 104:14">अर इस तरियां वो धरती तै खाण-पीण की चीज पैदा करै सै।<verse eid="PSA 104:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 104:15" />अर दाखमधु जिसतै माणस का मन खुश होवै सै,</para>
  <para style="q" vid="PSA 104:15">अर तेल जिसतै उसका मुँह चमकै सै,</para>
  <para style="q" vid="PSA 104:15">अर अनाज जिसतै वो सम्भळ जावै सै।<verse eid="PSA 104:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 104:16" />यहोवा के दरखत छिके रहवै सै,</para>
  <para style="q" vid="PSA 104:16">यानिके लबानोन के देवदार जो उसे के लगाऐ होये सै।<verse eid="PSA 104:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 104:17" />उन म्ह चिड़ियाँ अपणे घोसले बणावै सै,</para>
  <para style="q" vid="PSA 104:17">सारस का घर सनोवर के दरखतां म्ह होवै सै।<verse eid="PSA 104:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 104:18" />ऊँच्‍चे पहाड़ जंगळी बकरयां खात्तर सै;</para>
  <para style="q" vid="PSA 104:18">अर पहाड़ियाँ शापानां के शरणस्‍थान सै।<verse eid="PSA 104:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 104:19" />उसनै ठहराए होये बखत खात्तर चाँद बणाया सै,</para>
  <para style="q" vid="PSA 104:19">सूरज अपणे छिपण का बखत जाणै सै।<verse eid="PSA 104:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 104:20" />तू अन्धेरा करै सै, तो रात हो ज्या सै;</para>
  <para style="q" vid="PSA 104:20">जिस म्ह बण के सारे जीव जन्तु घूम्मै-फिरै सै।<verse eid="PSA 104:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 104:21" />जवान शेर शिकार खात्तर गरजै सै,</para>
  <para style="q" vid="PSA 104:21">अर परमेसवर तै अपणा खाणा माँग्गै सै।<verse eid="PSA 104:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 104:22" />सूरज लिकड़दे ए वे चले जावै सै</para>
  <para style="q" vid="PSA 104:22">अर अपणी-अपणी गुफा म्ह जा बेठै सै।<verse eid="PSA 104:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 104:23" />फेर माणस अपणे काम खात्तर</para>
  <para style="q" vid="PSA 104:23">अर साँझ तक मेहनत करण खात्तर लिकड़ै सै।<verse eid="PSA 104:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 104:24" />हे यहोवा तेरे काम अनगिणत सै!</para>
  <para style="q" vid="PSA 104:24">ये सारी चीज तन्‍नै बुद्धि तै बणाई सै;</para>
  <para style="q" vid="PSA 104:24">धरती तेरी सम्पत्ति तै भरपूर सै।<verse eid="PSA 104:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 104:25" />इस तरियां समुन्दर बड़ा अर घणाए चौड़ा सै,</para>
  <para style="q" vid="PSA 104:25">अर उस म्ह अनगिणत जीव जन्तु,</para>
  <para style="q" vid="PSA 104:25">के छोट्टे, के बड़े भरे पड़े सै।<verse eid="PSA 104:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 104:26" />उस म्ह जहाज भी आवै-जावै सै,</para>
  <para style="q" vid="PSA 104:26">अर लिव्यातान<note caller="+" style="f"><char style="fr" closed="false">104:26 </char><char style="fq" closed="false">लिव्यातान </char><char style="ft" closed="false">भजन 74:14</char></note> भी जो तन्‍नै ओड़ै खेलण खात्तर बणाया सै।<verse eid="PSA 104:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 104:27" />इन सब नै तेराए आसरा सै,</para>
  <para style="q" vid="PSA 104:27">के तू इनका खाणा बखत पै दिया करै।<verse eid="PSA 104:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 104:28" />तू उननै देवै सै, अर वे चुण ले सै;</para>
  <para style="q" vid="PSA 104:28">तू अपणी मुट्ठी खोल्‍लै सै अर वे उत्तम चिज्जां तै संतुष्ट होवै सै।<verse eid="PSA 104:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 104:29" />तू मुँह फेर ले सै, अर वे घबरा ज्या सै;</para>
  <para style="q" vid="PSA 104:29">तू उनकी साँस ले लेवै सै, अर उनकी जान लिकड़ज्या सै</para>
  <para style="q" vid="PSA 104:29">अर वे माट्टी म्ह मिल ज्या सै<verse eid="PSA 104:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 104:30" />फेर तू अपणी ओड़ तै साँस भेज्जै सै,</para>
  <para style="q" vid="PSA 104:30">अर वे बणाए जावै सै; अर तू धरती नै नया करदे सै।<verse eid="PSA 104:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 104:31" />यहोवा की महिमा हमेशा तक बणी रहवै,</para>
  <para style="q" vid="PSA 104:31">यहोवा अपणे काम्मां तै खुश होवै!<verse eid="PSA 104:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 104:32" />उसकै देखण तै ए धरती काँप जावै सै,</para>
  <para style="q" vid="PSA 104:32">अर उसकै छुन्दे ए पहाड़ां तै धुम्मा लिकड़ै सै।<verse eid="PSA 104:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 104:33" />मै जिन्दगी भर यहोवा के गीत गान्दा रहूँगा;</para>
  <para style="q" vid="PSA 104:33">जिब तक मै बण्या रहूँगा तब तक अपणे यहोवा का भजन गान्दा रहूँगा।<verse eid="PSA 104:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 104:34" />मेरा ध्यान करणा उसनै प्यारा लाग्गै,</para>
  <para style="q" vid="PSA 104:34">क्यूँके मै तो यहोवा कै कारण खुश रहूँगा।<verse eid="PSA 104:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 104:35" />पापी लोग धरती पै तै मिट जावै,</para>
  <para style="q" vid="PSA 104:35">अर दुष्ट लोग आग्गै तक ना रहवै!</para>
  <para style="q" vid="PSA 104:35">हे मेरे मन यहोवा नै धन्य कह!</para>
  <para style="q" vid="PSA 104:35">यहोवा की बड़ाई करो!<verse eid="PSA 104:35" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" sid="PSA 105" />
  <para style="s">परमेसवर अर उसके लोग</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 105:1" />यहोवा का धन्यवाद करो, उसतै प्रार्थना करो,</para>
  <para style="q" vid="PSA 105:1">देश-देश के लोगां म्ह उसके काम्मां का प्रचार करो!<verse eid="PSA 105:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 105:2" />उसकै खात्तर गीत गाओ, उसकै खात्तर भजन गाओ,</para>
  <para style="q" vid="PSA 105:2">उसके सारे अचम्भे के काम्मां का जिक्र करो।<verse eid="PSA 105:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 105:3" />उसकै पवित्र नाम की स्तुति करो;</para>
  <para style="q" vid="PSA 105:3">यहोवा नै टोह्ण आळयां का दिल खुश रहवै!<verse eid="PSA 105:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 105:4" />यहोवा अर उसकी सामर्थ्य नै खोजो,</para>
  <para style="q" vid="PSA 105:4">उसके दर्शनां के खोजी बणे रहो!<verse eid="PSA 105:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 105:5" />उसके करे होए अचम्भे काम याद करो,</para>
  <para style="q" vid="PSA 105:5">उसके चमत्कार अर फैसले याद करो,<verse eid="PSA 105:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 105:6" />हे उसके दास अब्राहम के वंश,</para>
  <para style="q" vid="PSA 105:6">हे याकूब की औलाद, थम तो उसके चुणे होये सो!<verse eid="PSA 105:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 105:7" />वोए म्हारा परमेसवर यहोवा सै;</para>
  <para style="q" vid="PSA 105:7">सारी धरती म्ह उसके फैसले होवै सै।<verse eid="PSA 105:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 105:8" />वो अपणे करार नै हमेशा याद राक्खै सै,</para>
  <para style="q" vid="PSA 105:8">यो वोए वचन सै जो उसनै हजार पीढ़ियाँ खात्तर ठहराया सै।<verse eid="PSA 105:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 105:9" />वोए करार जो उसनै अब्राहम गैल करया,</para>
  <para style="q" vid="PSA 105:9">अर उसकै बारै म्ह उसनै इसहाक तै कसम खाई,<verse eid="PSA 105:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 105:10" />अर उसे ताहीं उसनै याकूब खात्तर विधि करकै,</para>
  <para style="q" vid="PSA 105:10">अर इस्राएल खात्तर न्यू कहकै सदा का करार करकै पक्‍का करया,<verse eid="PSA 105:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 105:11" />मै कनान देश तन्‍नै ए दियुँगा, वो बाँट्टण म्ह थारा अपणा हिस्सा होवैगा।<verse eid="PSA 105:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 105:12" />उस बखत तो वो गिणती म्ह थोड़े थे, हाँ घणे थोड़े थे,</para>
  <para style="q" vid="PSA 105:12">अर उस देश म्ह परदेशी थे।<verse eid="PSA 105:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 105:13" />वे एक जात तै दुसरी जात म्ह,</para>
  <para style="q" vid="PSA 105:13">अर एक राज्य तै दुसरे राज्य म्ह फिरदे रहै;<verse eid="PSA 105:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 105:14" />पर उसनै किसे माणस ताहीं उनपै अंधेर न्ही करण दिया;</para>
  <para style="q" vid="PSA 105:14">अर वो सारे राजयां नै उनकै खात्तर या धमकी देवै था,<verse eid="PSA 105:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 105:15" />“मेरे अभिषिक्तां नै मत छूओ,</para>
  <para style="q" vid="PSA 105:15">अर ना मेरे नबियाँ का नुकसान करो!”<verse eid="PSA 105:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 105:16" />फेर उसनै देश म्ह<note caller="+" style="f"><char style="fr" closed="false">105:16 </char><char style="fq" closed="false">उसनै देश म्ह </char><char style="ft" closed="false">उसनै मिस्र देश म्ह</char></note> अकाळ भेज्या,</para>
  <para style="q" vid="PSA 105:16">अर अनाज के सारे आधार बन्द कर दिए।<verse eid="PSA 105:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 105:17" />उसनै यूसुफ नाम का एक माणस उनतै पैहला भेज्या था,</para>
  <para style="q" vid="PSA 105:17">जो दास होण खात्तर बेच्या गया था।<verse eid="PSA 105:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 105:18" />लोग्गां नै उसके पैरां म्ह बेड़ियाँ तै बान्ध कै उस ताहीं दुख दिया;</para>
  <para style="q" vid="PSA 105:18">वो लोहे की साँकळां तै बाँधया गया;<verse eid="PSA 105:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 105:19" />जिब तक उसकी बात पूरी ना होई</para>
  <para style="q" vid="PSA 105:19">तब ताहीं यहोवा का वचन उसनै कसौटी पै कस्दा रहया।<verse eid="PSA 105:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 105:20" />फेर राजा नै दूत भेजकै उस ताहीं लिकड़वा लिया,</para>
  <para style="q" vid="PSA 105:20">अर देश-देश के माणसां के स्वामियां नै उसके बन्धन खुलवाए;<verse eid="PSA 105:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 105:21" />उसनै उस ताहीं अपणे घर का मुखिया</para>
  <para style="q" vid="PSA 105:21">अर अपणी सारी दौलत पै अधिकारी ठैहराया,<verse eid="PSA 105:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 105:22" />के वो उसके हाकिमां नै अपणी मर्जी तै चलावै</para>
  <para style="q" vid="PSA 105:22">अर बुजुर्गां नै ज्ञान सिखावै।<verse eid="PSA 105:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 105:23" />फेर इस्राएल मिस्र म्ह आया;</para>
  <para style="q" vid="PSA 105:23">अर याकूब हाम कै देश म्ह परदेशी होकै रह्या।<verse eid="PSA 105:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 105:24" />फेर उसनै अपणी प्रजा गिणती म्ह मै घणी बढ़ाई,</para>
  <para style="q" vid="PSA 105:24">अर उसके दुश्मनां तै घणे ताकतवर करे।<verse eid="PSA 105:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 105:25" />उसनै मिस्री माणसां के मन इसे बदल दिए,</para>
  <para style="q" vid="PSA 105:25">के वो उसकी प्रजा तै दुश्मनी राक्खण,</para>
  <para style="q" vid="PSA 105:25">अर उसके दास्सां तै धोक्खा करण लाग्गे।<verse eid="PSA 105:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 105:26" />उसनै अपणे दास मूसा</para>
  <para style="q" vid="PSA 105:26">अर अपणे चुणे होये हारुन ताहीं भेज्या।<verse eid="PSA 105:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 105:27" />उननै मिस्रियाँ म्ह उसकी ओड़ तै न्यारे-न्यारे काम,</para>
  <para style="q" vid="PSA 105:27">अर हाम कै देश म्ह चमत्कार दिखाए।<verse eid="PSA 105:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 105:28" />उसनै अन्धेरा कर दिया,</para>
  <para style="q" vid="PSA 105:28">अर अन्धेरा होग्या;</para>
  <para style="q" vid="PSA 105:28">अर उननै उसकी बात न्ही मान्‍नी<note caller="+" style="f"><char style="fr" closed="false">105:28 </char><char style="fq" closed="false">उसकी बात न्ही मान्‍नी </char><char style="ft" closed="false">उननै उसके वचन के खिलाफ बगावत कोनी करी</char></note>।<verse eid="PSA 105:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 105:29" />उसनै मिस्री का सारा पाणी लहू बणा दिया,</para>
  <para style="q" vid="PSA 105:29">अर मच्छी मार गेरी।<verse eid="PSA 105:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 105:30" />मिंढ़क उनकी धरती म्ह मतलब उनके राजा के कमरयां म्ह भी भरगे।<verse eid="PSA 105:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 105:31" />उसनै आज्ञा दी, फेर डांस आगे,</para>
  <para style="q" vid="PSA 105:31">अर उनकै सारे देश म्ह लड़ण आळी माक्खी आ गई।<verse eid="PSA 105:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 105:32" />उसनै उन खात्तर बरसात कै बदले ओळे,</para>
  <para style="q" vid="PSA 105:32">अर उनकै देश म्ह धधकती आग बरसाई।<verse eid="PSA 105:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 105:33" />अर उसनै उनकी अंगूर की बेल अर अंजीर के पेड़,</para>
  <para style="q" vid="PSA 105:33">बल्कि उनके देश के सारे पेड़ तोड़ दिए।<verse eid="PSA 105:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 105:34" />उसनै आज्ञा दी फेर अनगिणत टिड्डियाँ, अर कीड़े आए।<verse eid="PSA 105:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 105:35" />अर उननै उनकै देश का सारा अनाज आदि खा लिया;</para>
  <para style="q" vid="PSA 105:35">अर उनकी धरती के सारे फळ चट करगे।<verse eid="PSA 105:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 105:36" />उसनै उनके देश के सारे जेठ्ठे,</para>
  <para style="q" vid="PSA 105:36">उनकी मर्दानगी के सारे पैहले फळ नाश कर दिए।<verse eid="PSA 105:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 105:37" />फेर वो इस्राएल नै सोन्‍ना-चाँदी दुवाकै काढ ल्याया,</para>
  <para style="q" vid="PSA 105:37">अर उन म्ह तै कोए भी कमजोर न्ही था।<verse eid="PSA 105:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 105:38" />उनकै जाण तै मिस्री खुश होये,</para>
  <para style="q" vid="PSA 105:38">क्यूँके उनका डर उन म्ह समा ग्या था।<verse eid="PSA 105:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 105:39" />उसनै छाया खात्तर बादल फैलाया,</para>
  <para style="q" vid="PSA 105:39">अर रात नै चाँदणा देण खात्तर आग प्रगट करी।<verse eid="PSA 105:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 105:40" />उननै मांग्या तो उसनै बटेर पोहचाई,</para>
  <para style="q" vid="PSA 105:40">अर उन ताहीं सुर्गीय खाणे तै छिका दिया।<verse eid="PSA 105:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 105:41" />उसनै चट्टान पाड़ी तो पाणी बह लिकड़या;</para>
  <para style="q" vid="PSA 105:41">अर बंजर धरती पै नदी बहण लाग्गी।<verse eid="PSA 105:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 105:42" />क्यूँके उसनै अपणे पवित्र वचन</para>
  <para style="q" vid="PSA 105:42">अर अपणे दास अब्राहम ताहीं याद करया।<verse eid="PSA 105:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 105:43" />वो अपणी प्रजा नै खुश करकै</para>
  <para style="q" vid="PSA 105:43">अर अपणे चुणे होया पै जयजयकार कराकै लिकाड़ ल्याया;<verse eid="PSA 105:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 105:44" />अर उन ताहीं जात्ति-जात्ति के देश दिए;</para>
  <para style="q" vid="PSA 105:44">अर वे दुसरे लोगां की मेहनत के फळ के हकदार कर दिये गये,<verse eid="PSA 105:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 105:45" />ताके वे उसकी विधियाँ नै मान्‍नै,</para>
  <para style="q" vid="PSA 105:45">अर उसके नियम-कायदे नै पूरे करै।</para>
  <para style="q" vid="PSA 105:45">यहोवा की स्तुति करो!<verse eid="PSA 105:45" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" sid="PSA 106" />
  <para style="s">परमेसवर खात्तर इस्राएल का अबिश्वास</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 106:1" />यहोवा की स्तुति करो! यहोवा का धन्यवाद करो, क्यूँके वो भला सै</para>
  <para style="q" vid="PSA 106:1">अर उसकी करुणा सदा की सै!<verse eid="PSA 106:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 106:2" />यहोवा के सामर्थ के काम्मां का जिक्र कौण कर सकै सै,</para>
  <para style="q" vid="PSA 106:2">या उसके सारे गुणा का कौण जिक्र कर सकै सै?<verse eid="PSA 106:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 106:3" />कितणे धन्य सै वे जो न्याय पै चाल्‍लै,</para>
  <para style="q" vid="PSA 106:3">अर हर बखत धर्म के काम करै सै!<verse eid="PSA 106:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 106:4" />हे यहोवा, अपणी प्रजा पै करी खुशी कै कारण मन्‍नै याद कर,</para>
  <para style="q" vid="PSA 106:4">मेरे उद्धार खात्तर मेरी सुधि ले,<verse eid="PSA 106:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 106:5" />के मै तेरे चुणे होया की भलाई देक्खूँ,</para>
  <para style="q" vid="PSA 106:5">अर तेरी प्रजा की खुशी म्ह खुश हो जाऊँ;</para>
  <para style="q" vid="PSA 106:5">अर तेरे अपणे हिस्से कै गैल बड़ाई करण पाऊँ।<verse eid="PSA 106:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 106:6" />हमनै तो अपणे बुजुर्गां की तरियां पाप करया सै; हमनै बुरे काम करे,</para>
  <para style="q" vid="PSA 106:6">हमनै दुष्टता करी सै!<verse eid="PSA 106:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 106:7" />मिस्र म्ह म्हारे पूर्वजां नै तेरे अचम्भे के काम्मां पै मन न्ही लाया,</para>
  <para style="q" vid="PSA 106:7">ना तेरी अपार करुणा ताहीं याद राख्या;</para>
  <para style="q" vid="PSA 106:7">उननै समुन्दर कै किनारे पै, यानिके लाल समुन्दर कै किनारे पै बलवा करया।<verse eid="PSA 106:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 106:8" />फेर भी उसनै अपणे नाम कै मुताबिक उनका उद्धार करया,</para>
  <para style="q" vid="PSA 106:8">जिसतै वो अपणे बड़े-बड़े काम्मां नै दिखावै।<verse eid="PSA 106:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 106:9" />फेर उसनै लाल समुन्दर ताहीं घुड़क्या अर वो सूख ग्या;</para>
  <para style="q" vid="PSA 106:9">अर वो उननै गहरे पाणी कै बीच म्ह तै मान्‍नो जंगळ म्ह तै लिकाड़ लेग्या।<verse eid="PSA 106:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 106:10" />उसनै उन ताहीं बैरी कै हाथ तै बचाया,</para>
  <para style="q" vid="PSA 106:10">अर दुश्मनां कै हाथ तै छुड़ा लिया।<verse eid="PSA 106:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 106:11" />अर उनके दुश्मन पाणी म्ह डूबगे;</para>
  <para style="q" vid="PSA 106:11">उन म्ह तै एक भी ना बच्या।<verse eid="PSA 106:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 106:12" />फेर उननै उसके वचनां का बिश्वास करया;</para>
  <para style="q" vid="PSA 106:12">अर उसकी स्तुति गाण लाग्गे।<verse eid="PSA 106:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 106:13" />पर वे तावळे उसके काम्मां नै भूलगे;</para>
  <para style="q" vid="PSA 106:13">अर उसकी योजना खात्तर ना रुके।<verse eid="PSA 106:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 106:14" />उननै जंगळ म्ह घणी लालसा करी</para>
  <para style="q" vid="PSA 106:14">अर जंगळ बियाबान म्ह परमेसवर का इम्तिहान लिया।<verse eid="PSA 106:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 106:15" />फेर उसनै उनतै मुँह मांग्या वर तो दिया,</para>
  <para style="q" vid="PSA 106:15">पर उनकी जान सूखा दी।<verse eid="PSA 106:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 106:16" />उननै छावणी म्ह मूसा के,</para>
  <para style="q" vid="PSA 106:16">अर यहोवा के पवित्र जन हारुन कै खिलाफ म्ह जळण करी,<verse eid="PSA 106:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 106:17" />धरती पाटगी अर दातान नै निगळगी,</para>
  <para style="q" vid="PSA 106:17">अर अबीराम के झुण्ड नै भी निगळगी।<verse eid="PSA 106:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 106:18" />अर उनके झुण्ड म्ह आग भड़क उठी;</para>
  <para style="q" vid="PSA 106:18">अर दुष्ट लोग लौ तै भस्‍म होगे।<verse eid="PSA 106:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 106:19" />उननै होरेब म्ह बाछड़ा बणाया,</para>
  <para style="q" vid="PSA 106:19">अर बणाई होई मूर्ति ताहीं दण्डवत करया।<verse eid="PSA 106:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 106:20" />उननै परमेसवर की महिमा, ताहीं घास खाण आळे बाछड़े की मूर्ति म्ह बदल दिया<verse eid="PSA 106:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 106:21" />वे अपणे उद्धारकर्ता परमेसवर नै भूलगे,</para>
  <para style="q" vid="PSA 106:21">जिसनै मिस्र म्ह बड़े-बड़े काम करे थे।<verse eid="PSA 106:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 106:22" />उसनै तो हाम कै देश म्ह अचम्भे के काम</para>
  <para style="q" vid="PSA 106:22">अर लाल समुन्दर कै किनारे पै खतरनाक काम करे थे।<verse eid="PSA 106:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 106:23" />ज्यांतै उसनै कह्या, के मै इनका सत्यानाश कर देन्दा</para>
  <para style="q" vid="PSA 106:23">जै मेरा चुण्या होया मूसा जोखिम की जगहां म्ह उन खात्तर खड्या ना होन्दा</para>
  <para style="q" vid="PSA 106:23">ताके मेरी जळजळाहट नै ठण्डा करै कदे इसा ना हो के मै उननै नाश कर देऊँ।<verse eid="PSA 106:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 106:24" />उननै मन भाण आळे देश ताहीं निकम्‍मा जाण्या,</para>
  <para style="q" vid="PSA 106:24">अर उसके वचन का बिश्वास ना करया।<verse eid="PSA 106:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 106:25" />वे अपणे तम्‍बुआं म्ह बड़बड़ाए,</para>
  <para style="q" vid="PSA 106:25">अर यहोवा का कहणा न्ही मान्या।<verse eid="PSA 106:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 106:26" />फेर उसनै उनकै बारै म्ह कसम खाई के मै इननै जंगळ म्ह नाश करुँगा,<verse eid="PSA 106:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 106:27" />अर इनकै कुण्बा नै गैरजात्तां कै आग्गै गेर दियुँगा,</para>
  <para style="q" vid="PSA 106:27">अर देश-देश म्ह तित्तर-बितर करुँगा<verse eid="PSA 106:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 106:28" />वे बालपोर देवता नै पूज्जण लाग्गे अर मुर्दयां ताहीं चढ़ाए होये पशुआं का माँस खाण लाग्गे।<verse eid="PSA 106:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 106:29" />इस तरियां उननै अपणे काम्मां तै उस ताहीं छो दुवाया,</para>
  <para style="q" vid="PSA 106:29">अर महामारी उन म्ह आगी।<verse eid="PSA 106:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 106:30" />फेर पीनहास नै उठकै न्‍यायदण्‍ड दिया,</para>
  <para style="q" vid="PSA 106:30">जिसतै महामारी थमगी।<verse eid="PSA 106:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 106:31" />अर यो उसके लेखे म्ह पीढ़ी तै पीढ़ी तक सदा खात्तर धर्म गिणया गया।<verse eid="PSA 106:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 106:32" />उननै मरीबा कै सोता कै धोरै भी यहोवा का छो भड़काया,</para>
  <para style="q" vid="PSA 106:32">अर उनकै कारण मूसा का नुकसान होया;<verse eid="PSA 106:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 106:33" />क्यूँके उननै उसकी आत्मा तै बलवा करया,</para>
  <para style="q" vid="PSA 106:33">फेर मूसा बिना सोच्‍चे बोल पड्या।<verse eid="PSA 106:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 106:34" />जिन लोगां कै बारै म्ह यहोवा नै</para>
  <para style="q" vid="PSA 106:34">उनतै हुकम दिया था, उसनै उन ताहीं सत्यानाश न्ही करया,<verse eid="PSA 106:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 106:35" />पर वे उन्हे जात्तां तै हिलमिल ग्ये</para>
  <para style="q" vid="PSA 106:35">अर उनके तौर तरीके सीख लिये;<verse eid="PSA 106:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 106:36" />अर उनकी मूर्तियाँ की पूजा करण लाग्गे,</para>
  <para style="q" vid="PSA 106:36">अर वे उन खात्तर फंदा बणगी।<verse eid="PSA 106:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 106:37" />पर उननै अपणे बेट्टा-बेट्टी भूत-पिशाचां खात्तर बलि कर दिए;<verse eid="PSA 106:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 106:38" />अर अपणे निर्दोष बेट्टे-बेटियाँ का लहू बहाया</para>
  <para style="q" vid="PSA 106:38">जिन नै उन ताहीं कनान की मूर्तियाँ पै बलि करया,</para>
  <para style="q" vid="PSA 106:38">ज्यांतै देश खून तै अपवित्र होग्या।<verse eid="PSA 106:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 106:39" />अर वे आप अपणे काम्मां कै कारण अशुद्ध होगे,</para>
  <para style="q" vid="PSA 106:39">अर अपणे काम्मां कै कारण जार भी बणगे<verse eid="PSA 106:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 106:40" />फेर यहोवा का छो अपणी प्रजा पै भड़क्या,</para>
  <para style="q" vid="PSA 106:40">अर उसनै अपणी निज प्रजा तै नफरत होई;<verse eid="PSA 106:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 106:41" />फेर उसनै उन ताहीं गैरजात्तां कै बस म्ह कर दिया,</para>
  <para style="q" vid="PSA 106:41">अर उनके बैरियाँ नै उनपै राज करया।<verse eid="PSA 106:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 106:42" />उनके दुश्मनां नै उनपै अन्धेर करया,</para>
  <para style="q" vid="PSA 106:42">अर वो उनकै हाथ नीच्‍चै दबगे।<verse eid="PSA 106:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 106:43" />बार-बार उसनै वे छुड़ाये,</para>
  <para style="q" vid="PSA 106:43">पर वो उसके खिलाफ बलवा करदे गए,</para>
  <para style="q" vid="PSA 106:43">अर अपणे अधर्म के कारण दबदे गए।<verse eid="PSA 106:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 106:44" />तोभी जिब-जिब उनका चिल्‍लाणा उसकै कान म्ह पड्या,</para>
  <para style="q" vid="PSA 106:44">तब-तब उसनै उनके संकट पै निगांह करी!<verse eid="PSA 106:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 106:45" />अर उनके हित म्ह अपणे करार ताहीं याद करकै</para>
  <para style="q" vid="PSA 106:45">अपणी अपार करुणा के मुताबिक तरस खाया,<verse eid="PSA 106:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 106:46" />अर जो उननै बन्दी बणाकै लेगे थे उन सबतै उनपै दया कराई।<verse eid="PSA 106:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 106:47" />हे म्हारे परमेसवर यहोवा, म्हारा उद्धार कर,</para>
  <para style="q" vid="PSA 106:47">अर हमनै गैरजात्तां म्ह तै कठ्ठा कर ले,</para>
  <para style="q" vid="PSA 106:47">ताके हम तेरे पवित्र नाम का धन्यवाद करां,</para>
  <para style="q" vid="PSA 106:47">अर तेरी स्तुति करदे होए तेरै बारै म्ह बड़ाई करां।<verse eid="PSA 106:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 106:48" />इस्राएल का परमेसवर यहोवा</para>
  <para style="q" vid="PSA 106:48">अनादिकाल तै अनन्त काल तक धन्य सै!</para>
  <para style="q" vid="PSA 106:48">अर सारी प्रजा कहवै आमीन!</para>
  <para style="q" vid="PSA 106:48">यहोवा की स्तुति करो।<verse eid="PSA 106:48" /></para>
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" sid="PSA 107" />
  <para style="ms">पाँचवाँ भाग</para>
  <para style="mr">
    <ref loc="PSA 107-150">भजन संहिता 107-150</ref></para>
  <para style="s">परमेसवर के दिए उद्धार कै खात्तर धन्यवाद</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 107:1" />यहोवा का धन्यवाद करो, क्यूँके वो भला सै;</para>
  <para style="q" vid="PSA 107:1">अर उसकी करुणा सदा की सै!<verse eid="PSA 107:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 107:2" />यहोवा के छुड़ाए होये इसे तरियां कहवै,</para>
  <para style="q" vid="PSA 107:2">जिननै उस ताहीं दुश्मनां कै हाथ तै दाम देकै छुड़ा लिया सै,<verse eid="PSA 107:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 107:3" />अर उननै देश-देश तै</para>
  <para style="q" vid="PSA 107:3">पूरब-पश्‍चिम, उत्तर अर दक्षिण तै कठ्ठा करया सै।<verse eid="PSA 107:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 107:4" />वो जंगळ म्ह सूक्खी धरती के राह म्ह भटकदे फिरे,</para>
  <para style="q" vid="PSA 107:4">अर कोए बस्या होया नगर ना पाया;<verse eid="PSA 107:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 107:5" />भूख अर प्‍यास के मारे,</para>
  <para style="q" vid="PSA 107:5">वे तड़फगे।<verse eid="PSA 107:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 107:6" />फेर उननै मुसीबत म्ह यहोवा की दोहाई दी,</para>
  <para style="q" vid="PSA 107:6">अर उसनै उन ताहीं संकट तै छुड़ाया;<verse eid="PSA 107:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 107:7" />अर उन ताहीं ठीक राह पै चलाया,</para>
  <para style="q" vid="PSA 107:7">ताके वो बसण खात्तर किसे नगर म्ह जा पोहचे।<verse eid="PSA 107:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 107:8" />लोग यहोवा की करुणा के कारण,</para>
  <para style="q" vid="PSA 107:8">अर उन बड़े-बड़े काम्मां कै कारण, जो वो माणसां खात्तर करै सै, उसका धन्यवाद करैं!<verse eid="PSA 107:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 107:9" />क्‍यूँके वो अभिलाषी जीव नै सन्‍तुष्‍ट करै सै,</para>
  <para style="q" vid="PSA 107:9">अर भूखे नै उत्तम चिज्जां तै छिकावै सै।<verse eid="PSA 107:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 107:10" />जो अन्धेरै अर मौत की छाया म्ह बेठ्ठे,</para>
  <para style="q" vid="PSA 107:10">अर दुख म्ह पड़े अर बेड़ियाँ तै जकड़े होए थे,<verse eid="PSA 107:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 107:11" />इस करकै के वो परमेसवर के वचनां कै खिलाफ चाल्‍ले,</para>
  <para style="q" vid="PSA 107:11">अर परमप्रधान की सम्मति नै निकम्मा जाणया।<verse eid="PSA 107:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 107:12" />फेर उसनै उन ताहीं दुख कै जरिये दबाया;</para>
  <para style="q" vid="PSA 107:12">वे ठोक्‍कर खाकै पड़गे, अर उननै कोए मददगार ना मिल्या।<verse eid="PSA 107:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 107:13" />फेर उननै मुसीबत म्ह यहोवा की दोहाई दी,</para>
  <para style="q" vid="PSA 107:13">अर उसनै विपति तै उनका उद्धार करया;<verse eid="PSA 107:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 107:14" />उसनै उन ताहीं अन्धेरै अर मौत की छाया म्ह तै लिकाड़ लिया;</para>
  <para style="q" vid="PSA 107:14">अर उनके बन्‍धनां ताहीं तोड़ गेरया।<verse eid="PSA 107:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 107:15" />माणस यहोवा की करुणा कै कारण,</para>
  <para style="q" vid="PSA 107:15">अर उन अचम्भे के काम्मां कै कारण जो वो माणसां खात्तर करैं सै,</para>
  <para style="q" vid="PSA 107:15">उसका धन्यवाद करैं!<verse eid="PSA 107:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 107:16" />क्यूँके उसनै पीतळ के फाटकां ताहीं ताेड़या,</para>
  <para style="q" vid="PSA 107:16">अर लोहे के सलांखां के टुकड़े-टुकड़े कर दिए।<verse eid="PSA 107:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 107:17" />मूर्ख अपणी उल्टी चाल,</para>
  <para style="q" vid="PSA 107:17">अर अधर्म के काम्मां कै कारण घणे दुखी होवै सै।<verse eid="PSA 107:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 107:18" />उनका जी सारी तरियां के भोजन तै मिचलावै सै,</para>
  <para style="q" vid="PSA 107:18">अर वे मौत के फाटक तक पोहचै सै।<verse eid="PSA 107:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 107:19" />फेर वो मुसीबत म्ह यहोवा की दोहाई देवै सै,</para>
  <para style="q" vid="PSA 107:19">अर वो विपति तै उनका उद्धार करै सै;<verse eid="PSA 107:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 107:20" />वो अपणे वचन के जरिये उननै चंगा करै सै</para>
  <para style="q" vid="PSA 107:20">अर जिस खड्डे म्ह वे पड़े सै, उस म्ह तै लिकाड़ लेवै सै।<verse eid="PSA 107:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 107:21" />लोग यहोवा की करुणा कै कारण</para>
  <para style="q" vid="PSA 107:21">अर उन अचम्भे के काम्मां कै कारण जो वो लोगां खात्तर करै सै, उसका धन्यवाद करैं!<verse eid="PSA 107:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 107:22" />अर वो धन्यवाद की भेंट चढ़ावैं,</para>
  <para style="q" vid="PSA 107:22">अर जयजयकार करदे होए, उसके काम्मां का जिक्र करै।<verse eid="PSA 107:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 107:23" />जो लोग जहाजां म्ह समुन्दर पै चाल्‍लै सै,</para>
  <para style="q" vid="PSA 107:23">अर महासागर पै होकै कारोबार करै सै;<verse eid="PSA 107:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 107:24" />वो यहोवा के काम्मां नै,</para>
  <para style="q" vid="PSA 107:24">अर उन अचम्भे के काम्मां नै जो वो डून्घे समुन्दर म्ह करै सै, देक्खै सै।<verse eid="PSA 107:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 107:25" />क्यूँके वो आज्ञा दे सै, फेर घणी तेज आन्धी उठकै तरंगां नै ठावै सै।<verse eid="PSA 107:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 107:26" />वे अकास तक चढ़ जावै, फेर गहराई म्ह उतर आवै सै;</para>
  <para style="q" vid="PSA 107:26">अर क्‍लेश के मारे उनके जी म्ह जी न्ही रहन्दा;<verse eid="PSA 107:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 107:27" />वे चक्‍कर खावै, अर मतवाळयां की तरियां लड़खड़ावै सै,</para>
  <para style="q" vid="PSA 107:27">अर उनकी सारी बुद्धि मारी जावै सै।<verse eid="PSA 107:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 107:28" />फेर वे मुसीबत म्ह यहोवा की दोहाई दे सै,</para>
  <para style="q" vid="PSA 107:28">अर वो उननै विपति म्ह तै लिकाड़ लेवै सै।<verse eid="PSA 107:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 107:29" />वो आँधी नै थाम दे सै अर तरंगें बैठ ज्या सै।<verse eid="PSA 107:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 107:30" />फेर वो उनके बैठण तै खुश होवै सै,</para>
  <para style="q" vid="PSA 107:30">अर वो उननै मन चाहे बन्‍दरगाह म्ह पोहचां दे सै।<verse eid="PSA 107:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 107:31" />लोग यहोवा की करुणा कै कारण,</para>
  <para style="q" vid="PSA 107:31">अर उन अचम्भे के काम्मां कै कारण जो वो लोगां खात्तर करैं सै,</para>
  <para style="q" vid="PSA 107:31">उसका धन्यवाद करै।<verse eid="PSA 107:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 107:32" />अर सभा म्ह उसनै सराहवै,</para>
  <para style="q" vid="PSA 107:32">अर बुजुर्गां की बैठक म्ह उसकी स्तुति करै।<verse eid="PSA 107:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 107:33" />वो नदियाँ नै जंगळ बणा दे सै,</para>
  <para style="q" vid="PSA 107:33">अर पाणी के चोयां नै सूक्खी धरती करदे सै।<verse eid="PSA 107:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 107:34" />वो फळवन्‍त धरती नै बंजर बणा दे सै,</para>
  <para style="q" vid="PSA 107:34">यो ओड़ै के रहण आळ्‍या की दुष्टता कै कारण होवै सै।<verse eid="PSA 107:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 107:35" />वो जंगळ नै पाणी के ताल,</para>
  <para style="q" vid="PSA 107:35">अर निर्जल देश नै पाणी के चोए बणा दे सै।<verse eid="PSA 107:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 107:36" />अर ओड़ै वो भूख्यां नै बसावै सै,</para>
  <para style="q" vid="PSA 107:36">ताके वो बसण खात्तर नगर त्यार करै;<verse eid="PSA 107:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 107:37" />अर खेत्ती करै, अर अंगूर के बाग लगावै,</para>
  <para style="q" vid="PSA 107:37">अर न्यारे-न्यारे तरियां के फळ उगा ले।<verse eid="PSA 107:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 107:38" />अर वो उननै इसी आशीष देवै सै के वो भोत बढ़ ज्या सै,</para>
  <para style="q" vid="PSA 107:38">अर उनके पशुआं नै भी वो घटण न्ही देन्दा।<verse eid="PSA 107:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 107:39" />फेर अन्धेर, विपति अर शोक कै कारण,</para>
  <para style="q" vid="PSA 107:39">वे घटदे अर दब जावै सै।<verse eid="PSA 107:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 107:40" />अर वो हाकिमां नै अपमान तै लादकै बिना राह के जंगळ म्ह भटकावै सै;<verse eid="PSA 107:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 107:41" />वो गरीबां नै दुख तै छुड़ाकै ऊँच्‍चे पै राक्खै सै,</para>
  <para style="q" vid="PSA 107:41">अर उननै भेड्डां के टोळ की तरियां परिवार देवै सै।<verse eid="PSA 107:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 107:42" />सीध्धे लोग देखकै खुश होवै सै;</para>
  <para style="q" vid="PSA 107:42">अर सारे कठोर लोग अपणे मुँह बन्‍द करै सै।<verse eid="PSA 107:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 107:43" />जो कोए बुद्धिमान हो, वो इन बात्तां पै ध्यान करैगा;</para>
  <para style="q" vid="PSA 107:43">अर यहोवा की करुणा के काम्मां पै ध्यान करैगा।<verse eid="PSA 107:43" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" sid="PSA 108" />
  <para style="s">दुश्मनां पै विजय का आश्वासन गीत</para>
  <para style="d">दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 108:1" />हे परमेसवर, मेरा दिल मजबूत सै;</para>
  <para style="q" vid="PSA 108:1">मै गाऊँगा, मै अपणी आत्मा तै भी भजन गाऊँगा।<verse eid="PSA 108:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 108:2" />हे सारंगी अर वीणा जाग्गो!</para>
  <para style="q" vid="PSA 108:2">मै आप सबेरै-सबेरै जाग उठूँगा!<verse eid="PSA 108:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 108:3" />हे यहोवा, मै देश-देश के माणसां कै बीच म्ह तेरा धन्यवाद करुँगा,</para>
  <para style="q" vid="PSA 108:3">अर राज्य-राज्य के माणसां कै बीच म्ह तेरा भजन गाऊँगा।<verse eid="PSA 108:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 108:4" />क्यूँके तेरी दया अकास तै भी ऊँच्‍ची सै,</para>
  <para style="q" vid="PSA 108:4">अर तेरी सच्‍चाई आकाशमण्‍डल तक सै।<verse eid="PSA 108:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 108:5" />हे परमेसवर, तू सुर्ग कै उप्पर हो!</para>
  <para style="q" vid="PSA 108:5">अर तेरी महिमा सारी धरती कै उप्पर हो!<verse eid="PSA 108:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 108:6" />इस करकै तेरे प्यारे माणस छुड़ाए जावै,</para>
  <para style="q" vid="PSA 108:6">तू अपणे सोळे हाथ तै हमनै बचाले अर म्हारी बिनती सुण ले!<verse eid="PSA 108:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 108:7" />परमेसवर नै अपणी पवित्रता म्ह होकै कह्या सै,</para>
  <para style="q" vid="PSA 108:7">“मै पूरा खुश होकै शेकेम नै बाँट ल्यूँगा,</para>
  <para style="q" vid="PSA 108:7">अर सुक्‍कोत की तराई नै नपवाऊँगा।<verse eid="PSA 108:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 108:8" />गिलाद मेरा सै, मनश्‍शे भी मेरा सै;</para>
  <para style="q" vid="PSA 108:8">अर एप्रैम मेरे सिर का ताज सै; यहूदा मेरा राजदण्ड सै।<verse eid="PSA 108:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 108:9" />मोआब मेरे धोणे का बरतन सै,</para>
  <para style="q" vid="PSA 108:9">मै एदोम पै अपणा जूत्ता फेंक्‍कूँगा, पलिश्‍त पै मै जयजयकार करुँगा।”<verse eid="PSA 108:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 108:10" />मन्‍नै गढ़ आळे नगर म्ह कौण पोहचावैगा?</para>
  <para style="q" vid="PSA 108:10">एदोम तक मेरी अगुवाई किसनै करी सै?<verse eid="PSA 108:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 108:11" />हे परमेसवर, के तन्‍नै म्हारे ताहीं न्ही छोड़ दिया?</para>
  <para style="q" vid="PSA 108:11">अर हे परमेसवर, तू म्हारी सेना कै आग्गै-आग्गै न्ही चालदा।<verse eid="PSA 108:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 108:12" />दुश्मनां कै खिलाफ म्हारी मदद कर,</para>
  <para style="q" vid="PSA 108:12">क्यूँके आदमी की मदद बेकार सै!<verse eid="PSA 108:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 108:13" />परमेसवर की मदद तै हम वीरता दिखावैगें,</para>
  <para style="q" vid="PSA 108:13">म्हारे दुश्मनां नै वोए रौंदैगा।<verse eid="PSA 108:13" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" sid="PSA 109" />
  <para style="s">झूठ्ठे अभियोक्ता कै बिरुध्द याचिका</para>
  <para style="d">प्रधान बजाण आळे खात्तर दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 109:1" />हे परमेसवर, तू जिसकी मै स्तुति करुँ सूं, चुप ना रह!<verse eid="PSA 109:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 109:2" />क्यूँके दुष्ट अर कपटी माणसां नै मेरे खिलाफ मुँह खोल्या सै,</para>
  <para style="q" vid="PSA 109:2">वो मेरै बारै म्ह झूठ बोल्‍लै सै।<verse eid="PSA 109:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 109:3" />उननै बैर के वचनां तै मेरे ताहीं चारु ओड़ तै घेर लिया सै,</para>
  <para style="q" vid="PSA 109:3">अर खाम्मे-खा मेरे तै लड़ै सै।<verse eid="PSA 109:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 109:4" />मेरे प्यार कै बदलै म्ह वो मेरे तै चुगली करै सै,</para>
  <para style="q" vid="PSA 109:4">पर मै तो प्रार्थना म्ह मगन रहूँ सूं।<verse eid="PSA 109:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 109:5" />उननै भलाई के बदले म्ह मेरे तै बुराई करी</para>
  <para style="q" vid="PSA 109:5">अर मेरे प्यार कै बदले मेरे तै बैर करया सै।<verse eid="PSA 109:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 109:6" />तू उसनै किसे दुष्ट के अधिकार म्ह राख,</para>
  <para style="q" vid="PSA 109:6">अर कोए बिरोधी उसकी सोळी ओड़ खड्या रहवै।<verse eid="PSA 109:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 109:7" />जिब उसका न्याय करया जावै, फेर वो दोषी लिकड़ै,</para>
  <para style="q" vid="PSA 109:7">अर उसकी प्रार्थना पाप गिणी जावै!<verse eid="PSA 109:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 109:8" />उसके दिन थोड़े हों,</para>
  <para style="q" vid="PSA 109:8">अर उसके पद नै दूसरा ले!<verse eid="PSA 109:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 109:9" />उसके बाळक अनाथ हो जावै</para>
  <para style="q" vid="PSA 109:9">अर उसकी औरत बिधवा हो जावै!<verse eid="PSA 109:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 109:10" />अर उसके बाळक मारे-मारे फिरै, अर भीख मांग्या करै;</para>
  <para style="q" vid="PSA 109:10">उननै अपणे उजड़े होए घर तै दूर जाकै टुकड़े माँगणा पड़ै!<note caller="+" style="f"><char style="fr" closed="false">109:10 </char><char style="fq" closed="false">उननै अपणे उजड़े होए घर तै दूर जाकै टुकड़े माँगणा पड़ै! </char><char style="ft" closed="false">अपणे उजड़े होए घर तै भी दूर जाकै टुकड़े माँगणा पड़ै!</char></note><verse eid="PSA 109:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 109:11" />साहूकार फन्‍दा लगाकै, उसका सब किमे ले ले;</para>
  <para style="q" vid="PSA 109:11">अर परदेशी उसकी कमाई नै लूट ले!<verse eid="PSA 109:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 109:12" />कोए ना हो जो उसपै दया करदा रहवै,</para>
  <para style="q" vid="PSA 109:12">अर उसके अनाथ बाळकां पै कोए तरस ना करै!<verse eid="PSA 109:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 109:13" />उसका वंश नाश हो जावै,</para>
  <para style="q" vid="PSA 109:13">दुसरी पीढ़ी म्ह उसका<note caller="+" style="f"><char style="fr" closed="false">109:13 </char><char style="fq" closed="false">उसका </char><char style="ft" closed="false">उनका </char></note> नाम मिट जावै!<verse eid="PSA 109:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 109:14" />उसके बाप-दाद्यां का अधर्म यहोवा नै याद रहवै,</para>
  <para style="q" vid="PSA 109:14">अर उसकी माँ का पाप ना मिटै!<verse eid="PSA 109:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 109:15" />वो लगातार यहोवा कै स्याम्ही रहवै, ताके</para>
  <para style="q" vid="PSA 109:15">वो उनका नाम धरती पै तै मिटा दे!<verse eid="PSA 109:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 109:16" />क्यूँके वो दुष्ट, दया करणा भूल ग्या</para>
  <para style="q" vid="PSA 109:16">फेर भी दीन अर गरीबां नै सताया करै था</para>
  <para style="q" vid="PSA 109:16">अर मार गेरण की इच्छा तै दुखी मन आळयां कै पाच्छै पड्या रहवै था।<verse eid="PSA 109:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 109:17" />वो श्राप देण तै प्यार राक्खै था, अर श्राप उसपै आ पड्या;</para>
  <para style="q" vid="PSA 109:17">वो आशीर्वाद देण तै खुश ना होवै था,</para>
  <para style="q" vid="PSA 109:17">इस करकै आर्शीवाद उसतै दूर रहया।<verse eid="PSA 109:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 109:18" />वो श्राप देणा कपड़े की तरियां पैहरा था,</para>
  <para style="q" vid="PSA 109:18">अर वो उसके पेट म्ह पाणी की तरियां</para>
  <para style="q" vid="PSA 109:18">अर उसकी हाड्डियाँ म्ह तेल की तरियां समा ग्या।<verse eid="PSA 109:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 109:19" />वो उसकै खात्तर ओढ़णे का काम दे,</para>
  <para style="q" vid="PSA 109:19">अर फेंटे की तरियां उसका कटिबन्ध लगातार कस्या रहवै।<verse eid="PSA 109:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 109:20" />यहोवा की ओड़ तै मेरे बिरोधियाँ नै,</para>
  <para style="q" vid="PSA 109:20">अर मेरे खिलाफ बुरा कहण आळयां नै न्यूए बदला मिलै!<verse eid="PSA 109:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 109:21" />पर मेरे तै हे यहोवा प्रभु, तू अपणे नाम के मुताबिक बरताव कर;</para>
  <para style="q" vid="PSA 109:21">तेरी करुणा तो बड़ी सै, इस करकै तू मन्‍नै छुटकारा दे!<verse eid="PSA 109:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 109:22" />क्यूँके मै दीन अर गरीब सूं,</para>
  <para style="q" vid="PSA 109:22">अर मेरा दिल घायल होया सै।<verse eid="PSA 109:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 109:23" />मै ढळती होई छाया की तरियां जान्दा रहया सूं;</para>
  <para style="q" vid="PSA 109:23">मै टिड्डी की तरियां उडा दिया गया सूं।<verse eid="PSA 109:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 109:24" />उपवास करदे-करदे मेरे घुटने कमजोर होगे;</para>
  <para style="q" vid="PSA 109:24">अर मेरे म्ह चर्बी ना रहण तै मै सूख ग्या सूं।<verse eid="PSA 109:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 109:25" />मेरी तो उन माणसां तै बदनामी होवै सै;</para>
  <para style="q" vid="PSA 109:25">जिब वो मन्‍नै देक्खै, फेर सिर हिलावै सै।<verse eid="PSA 109:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 109:26" />हे मेरे परमेसवर यहोवा, मेरी मदद कर!</para>
  <para style="q" vid="PSA 109:26">अपणी करुणा कै मुताबिक मेरा उद्धार कर!<verse eid="PSA 109:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 109:27" />जिसतै वो जाण ज्या के यो तेरा काम सै,</para>
  <para style="q" vid="PSA 109:27">अर हे यहोवा, तन्‍नै ए यो करया सै!<verse eid="PSA 109:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 109:28" />वे मन्‍नै कोसदे तो रहवै, पर तू आशीष दे!</para>
  <para style="q" vid="PSA 109:28">वो तो उठदे ए शर्मिन्दा हों, पर तेरा दास खुश हो!<verse eid="PSA 109:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 109:29" />मेरे बिरोधियाँ नै बेजती के कपड़े पिरहाये जावै,</para>
  <para style="q" vid="PSA 109:29">अर वो अपणी बेजती नै काम्बळ की तरियां ओढ़ै!<verse eid="PSA 109:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 109:30" />मै यहोवा का भोत धन्यवाद करुँगा,</para>
  <para style="q" vid="PSA 109:30">अर भोत लोगां कै बीच म्ह उसकी स्तुति करुँगा।<verse eid="PSA 109:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 109:31" />क्यूँके वो गरीब की मदद करैगा<note caller="+" style="f"><char style="fr" closed="false">109:31 </char><char style="fq" closed="false">क्यूँके वो गरीब की मदद करैगा </char><char style="ft" closed="false">वो गरीब की सोळी ओड़ खड्या रहवैगा, </char></note>,</para>
  <para style="q" vid="PSA 109:31">ताके उसनै मौत की सजा देण आळयां तै बचावै।<verse eid="PSA 109:31" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" sid="PSA 110" />
  <para style="s">परमेसवर अर उसका चुण्या होया राजा</para>
  <para style="d">दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 110:1" />मेरे प्रभु तै यहोवा की या वाणी सै, “तू मेरे सोळे हाथ नै बैठ,</para>
  <para style="q" vid="PSA 110:1">जिब ताहीं मै तेरे दुश्मनां नै तेरे पैंरां की चौकी ना कर देऊँ।”<verse eid="PSA 110:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 110:2" />तेरी शक्ति का राजदंड यहोवा सिय्योन तै बढ़ावैगा।</para>
  <para style="q" vid="PSA 110:2">तू अपणे दुश्मनां कै बीच म्ह राज कर।<verse eid="PSA 110:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 110:3" />तेरी प्रजा के माणस तेरे पराक्रम कै दिन अपणी मर्जी तै स्वेच्छाबलि बणै सै;</para>
  <para style="q" vid="PSA 110:3">तेरे जवान लोग पवित्रताई तै शोभायमान,</para>
  <para style="q" vid="PSA 110:3">अर सबेरै कै गर्भ तै पैदा होई ओस की तरियां तेरे धोरै सै।<verse eid="PSA 110:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 110:4" />यहोवा नै कसम खाई अर ना पछतावैगा,</para>
  <para style="q" vid="PSA 110:4">“तू मलिकिसिदक की तरियां सदा खात्तर याजक सै।”<verse eid="PSA 110:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 110:5" />प्रभु तेरे सोळे ओड़ होकै</para>
  <para style="q" vid="PSA 110:5">अपणे छो कै दिन राजयां नै चूर कर देवैगा।<verse eid="PSA 110:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 110:6" />वो जात-जात म्ह न्याय चुकावैगा, रणभूमि लाशां तै भर ज्यागी;</para>
  <para style="q" vid="PSA 110:6">वो लम्बे-चौड़े देश के प्रधानां नै चूर-चूर कर देगा।<verse eid="PSA 110:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 110:7" />वो राह म्ह चाल्दे-चाल्दे नदी का पाणी पीवैगा</para>
  <para style="q" vid="PSA 110:7">अर फेर वो जीत कै बाद अपणे सिर नै ऊँच्‍चा करैगा।<verse eid="PSA 110:7" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" sid="PSA 111" />
  <para style="s">परमेसवर की सच्‍चाई अर न्याय खात्तर स्तुतिगान</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 111:1" />परमेसवर की स्तुति करो। मै सीध्धे माणसां की सभा म्ह</para>
  <para style="q" vid="PSA 111:1">अर मण्डळी म्ह सारे मन तै यहोवा का धन्यवाद करुँगा।<verse eid="PSA 111:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 111:2" />यहोवा के काम बड़े सै,</para>
  <para style="q" vid="PSA 111:2">जितने उसतै खुश रहवैं, वो उनपै ध्यान लगावै सै।<verse eid="PSA 111:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 111:3" />उसकै काम वैभवशाली अर शोभायमान होवै सै,</para>
  <para style="q" vid="PSA 111:3">अर उसका धर्म सदा तक बण्या रहवैगा।<verse eid="PSA 111:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 111:4" />उसनै अपणे अचम्भे के काम याद कराये सै;</para>
  <para style="q" vid="PSA 111:4">यहोवा अनुग्रह करण आळा अर दयावंत सै।<verse eid="PSA 111:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 111:5" />उसनै अपणे डरण आळयां तै खाणा दिया सै;</para>
  <para style="q" vid="PSA 111:5">वो अपणे करार नै सदा तक याद राक्खैगा।<verse eid="PSA 111:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 111:6" />उसनै अपणी प्रजा तक जात-जात का भाग देण खात्तर,</para>
  <para style="q" vid="PSA 111:6">अपणे काम्मां का प्रताप दिखाया सै।<verse eid="PSA 111:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 111:7" />सच्‍चाई अर न्याय उसके हाथ्थां के काम सै;</para>
  <para style="q" vid="PSA 111:7">उसके सारे उपदेश बिश्वास लायक सै।<verse eid="PSA 111:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 111:8" />वो कदे भी न्ही टळैगें;</para>
  <para style="q" vid="PSA 111:8">वो सच्‍चाई अर सिधाई तै करे होए सै।<verse eid="PSA 111:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 111:9" />उसनै अपणी प्रजा का उद्धार करया सै;</para>
  <para style="q" vid="PSA 111:9">उसनै अपणे करार ताहीं सदा खात्तर ठहराया सै।</para>
  <para style="q" vid="PSA 111:9">उसका नाम पवित्र अर भययोग्य सै।<verse eid="PSA 111:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 111:10" />बुद्धि की जड़ परमेसवर का डर सै;</para>
  <para style="q" vid="PSA 111:10">जितने उसके हुकमां नै मान्‍नै सै,</para>
  <para style="q" vid="PSA 111:10">उनकी समझ आच्छी होवै सै।</para>
  <para style="q" vid="PSA 111:10">उसकी स्तुति सदा बणी रहवैगी।<verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" sid="PSA 112" />
  <para style="s">धर्मी माणस के लक्षण</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 112:1" />यहोवा की स्तुति करो।</para>
  <para style="q" vid="PSA 112:1">कितना धन्य सै वो आदमी जो यहोवा का भय मान्‍नै सै,</para>
  <para style="q" vid="PSA 112:1">अर उसके हुकमां तै घणाए खुश रहवै सै!<verse eid="PSA 112:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 112:2" />उसका खानदान धरती पै शक्तिशाली होवैगा;</para>
  <para style="q" vid="PSA 112:2">सीध्धे लोगां की औलाद आशीष पावैगी।<verse eid="PSA 112:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 112:3" />उसकै घर म्ह धन-सम्पत्ति रहवैगी;</para>
  <para style="q" vid="PSA 112:3">अर उसका धर्म सदा बण्या रहवैगा।<verse eid="PSA 112:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 112:4" />सीध्धे माणसां खात्तर अन्धकार कै बीच म्ह चाँदणा चमकै सै;</para>
  <para style="q" vid="PSA 112:4">वो अनुग्रह करण आळा, दयावान अर धर्मी होवै सै।<note caller="+" style="f"><char style="fr" closed="false">112:4 </char><char style="fq" closed="false">वो अनुग्रह करण आळा, दयावान अर धर्मी होवै सै। </char><char style="ft" closed="false">प्रभु अनुग्रह करण आळा, दयावान अर धर्मी होवै सै। </char></note><verse eid="PSA 112:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 112:5" />जो माणस अनुग्रह करै अर उधार देवै सै,</para>
  <para style="q" vid="PSA 112:5">अर ईमानदारी कै गैल अपणे काम करै सै, उसका भला होवै सै,<verse eid="PSA 112:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 112:6" />वो तो सदा ताहीं बण्या रहवैगा;</para>
  <para style="q" vid="PSA 112:6">धर्मी की याद सदा ताहीं बणी रहवैगी।<verse eid="PSA 112:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 112:7" />वो बुरी खबर तै न्ही डरदा;</para>
  <para style="q" vid="PSA 112:7">उसका दिल यहोवा पै भरोस्सा करण तै मजबूत रहवै सै।<verse eid="PSA 112:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 112:8" />उसका दिल सम्भळया होया सै, इस करकै वो ना डरैगा,</para>
  <para style="q" vid="PSA 112:8">पर अपणे बैरियाँ पै निगांह करकै खुश होवैगा।<verse eid="PSA 112:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 112:9" />उसनै दिल खोल कै गरीबां ताहीं दान दिया,</para>
  <para style="q" vid="PSA 112:9">उसका धर्म सदा ताहीं बण्या रहवैगा;</para>
  <para style="q" vid="PSA 112:9">अर उसका सींग महिमा गैल ऊँच्‍चा करया जावैगा।<note caller="+" style="f"><char style="fr" closed="false">112:9 </char><char style="fq" closed="false">अर उसका सींग महिमा गैल ऊँच्‍चा करया जावैगा। </char><char style="ft" closed="false">वो ताकतवर अर आदरणीय होवैगा </char></note><verse eid="PSA 112:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 112:10" />दुष्ट इसनै देखकै कुढैगा;</para>
  <para style="q" vid="PSA 112:10">वो दांद पिस-पिसकै गळ ज्यागा।</para>
  <para style="q" vid="PSA 112:10">दुष्टां की लालसा पूरी न्ही होवैगी<verse eid="PSA 112:10" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" sid="PSA 113" />
  <para style="s">स्तुति के लायक नाम</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 113:1" />यहोवा की स्तुति करो!</para>
  <para style="q" vid="PSA 113:1">हे यहोवा के दासों स्तुति करो,</para>
  <para style="q" vid="PSA 113:1">यहोवा कै नाम की स्तुति करो!<verse eid="PSA 113:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 113:2" />यहोवा का नाम</para>
  <para style="q" vid="PSA 113:2">इब तै लेकै सदा ताहीं धन्य कह्या जावै!<verse eid="PSA 113:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 113:3" />उदयाचल तै लेकै अस्ताचल तक,</para>
  <para style="q" vid="PSA 113:3">यहोवा का नाम स्तुति कै लायक सै।<verse eid="PSA 113:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 113:4" />यहोवा सारी जातियाँ कै उप्पर बड़ा महान सै,</para>
  <para style="q" vid="PSA 113:4">अर उसकी महिमा आसमान तै भी ऊँच्‍ची सै।<verse eid="PSA 113:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 113:5" />म्हारे परमेसवर यहोवा बरगा कौण सै?</para>
  <para style="q" vid="PSA 113:5">वो तो ऊँच्‍चे पै बैठ्या सै,<verse eid="PSA 113:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 113:6" />अर अकास अर धरती पै भी,</para>
  <para style="q" vid="PSA 113:6">देखण खात्तर झुकै सै।<verse eid="PSA 113:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 113:7" />वो कंगाल नै माट्टी पै तै,</para>
  <para style="q" vid="PSA 113:7">अर गरीब नै राख के ढेर पै तै ठा कै ऊँच्‍चा कर सै,<verse eid="PSA 113:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 113:8" />ताके उसनै प्रधानां कै गैल,</para>
  <para style="q" vid="PSA 113:8">यानी अपणी प्रजा कै प्रधानां कै गैल बिठावै।<verse eid="PSA 113:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 113:9" />वो बाँझ नै घर म्ह बाळ-बच्‍चां की खुशी मनाण आळी माँ बणावै सै।</para>
  <para style="q" vid="PSA 113:9">यहोवा की स्तुति करो!<verse eid="PSA 113:9" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" sid="PSA 114" />
  <para style="s">फसह का गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 114:1" />जिब इस्राएल नै मिस्र तै, यानी के याकूब कै कुण्बे नै न्यारी बोल्‍ली आळयां कै बीच म्ह चालणा शरु करया,<verse eid="PSA 114:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 114:2" />फेर यहूदा यहोवा का पवित्र स्‍थान</para>
  <para style="q" vid="PSA 114:2">अर इस्राएल उसके राज्य के लोग होंगे।<verse eid="PSA 114:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 114:3" />समुन्दर देखकै भाज्या,</para>
  <para style="q" vid="PSA 114:3">यरदन नदी उलटी बहण लाग्गी।<verse eid="PSA 114:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 114:4" />पहाड़ मिंढा की तरियां उछळण लाग्गे,</para>
  <para style="q" vid="PSA 114:4">अर पहाड़ियाँ भेड़-बकरियाँ कै बच्यां की तरियां उछळण लाग्गी।<verse eid="PSA 114:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 114:5" />हे समुन्दर, तेरै के होया, के तू भाज्या?</para>
  <para style="q" vid="PSA 114:5">अर हे यरदन नदी तेरै के होया के तू उलटी बही?<verse eid="PSA 114:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 114:6" />हे पहाड़ों थारै के होया, के थम भेड्डां की तरियां,</para>
  <para style="q" vid="PSA 114:6">अर हे पहाड़ियों थारै के होया, के थम भेड़-बकरियाँ के बच्यां की तरियां उछळे?<verse eid="PSA 114:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 114:7" />हे धरती प्रभु कै आग्गै,</para>
  <para style="q" vid="PSA 114:7">हाँ, याकूब के परमेसवर कै आग्गै थरथरा।<verse eid="PSA 114:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 114:8" />वो पहाड़ नै पाणी का जोह्ड़,</para>
  <para style="q" vid="PSA 114:8">कठोर चकमक के पत्थर नै पाणी का चोवा बणा दे सै।<verse eid="PSA 114:8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" sid="PSA 115" />
  <para style="s">एक सच्‍चा परमेसवर और मूर्ति</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 115:1" />हे यहोवा, म्हारी न्ही, म्हारी न्ही, पर अपणे ही नाम की महिमा,</para>
  <para style="q" vid="PSA 115:1">अपणी करुणा अर सच्‍चाई कै मुताबिक कर।<verse eid="PSA 115:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 115:2" />जात-जात के माणस क्यूँ कहण पावै,</para>
  <para style="q" vid="PSA 115:2">“के उनका परमेसवर कित्त सै?”<verse eid="PSA 115:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 115:3" />म्हारा परमेसवर तो सुर्ग म्ह सै;</para>
  <para style="q" vid="PSA 115:3">उसनै जो चाह्या वो करया सै।<verse eid="PSA 115:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 115:4" />उन सारे लोग्गां की मूर्ति सोन्‍ने-चाँदी की तो सै,</para>
  <para style="q" vid="PSA 115:4">वे माणसां के हाथ्थां की बणाई होई सै।<verse eid="PSA 115:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 115:5" />उनकै मुँह तो सै पर वे बोल न्ही सकदी;</para>
  <para style="q" vid="PSA 115:5">उनकी आँख तो सै, पर वे देख न्ही सकदी।<verse eid="PSA 115:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 115:6" />उनकै कान तो सै, पर वे सुण न्ही सकदी;</para>
  <para style="q" vid="PSA 115:6">उनकै नाक तो सै, पर वे सूंघ न्ही सकदी।<verse eid="PSA 115:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 115:7" />उनकै हाथ तो सै, पर वे छू न्ही सकदी;</para>
  <para style="q" vid="PSA 115:7">उनकै पैर तो सै, पर वे चाल न्ही सकदी;</para>
  <para style="q" vid="PSA 115:7">अर उनके गळे तै कोए आवाज न्ही लिकड़ सकदी।<verse eid="PSA 115:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 115:8" />जिस तरियां वो सै उसे तरियां उनके बणाण आळे भी सै;</para>
  <para style="q" vid="PSA 115:8">अर उनपै भरोस्सा राक्खण आळे भी सारे उसे तरियां हो ज्यांगे।<verse eid="PSA 115:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 115:9" />हे इस्राएल, यहोवा पै भरोस्सा राख!</para>
  <para style="q" vid="PSA 115:9">तेरा मददगार अर ढाल वोए सै।<verse eid="PSA 115:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 115:10" />हे हारुन के कुण्बे, यहोवा पै भरोस्सा राख!</para>
  <para style="q" vid="PSA 115:10">तेरा मददगार अर ढाल वोए सै।<verse eid="PSA 115:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 115:11" />हे यहोवा के डरण आळेयो, यहोवा पै भरोस्सा राक्खो!</para>
  <para style="q" vid="PSA 115:11">थारा मददगार अर ढाल वोए सै।<verse eid="PSA 115:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 115:12" />यहोवा नै म्हारे ताहीं याद करया सै; वो आशीष देवैगा;</para>
  <para style="q" vid="PSA 115:12">वो इस्राएल के घरान्‍ने नै आशीष देवैगा;</para>
  <para style="q" vid="PSA 115:12">वो हारुन कै घरान्‍ने नै आशीष देवैगा।<verse eid="PSA 115:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 115:13" />के छोट्टे के बड़े</para>
  <para style="q" vid="PSA 115:13">जितने परमेसवर तै डरणिये सै, वो उननै आशीष देवैगा।<verse eid="PSA 115:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 115:14" />यहोवा थमनै अर थारे वंश नै और भी घणाए बढ़ावैगा।<verse eid="PSA 115:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 115:15" />यहोवा जो अकास अर धरती नै बणाण आळा सै,</para>
  <para style="q" vid="PSA 115:15">उसकी ओड़ तै थमनै आशीष पाई सै।<verse eid="PSA 115:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 115:16" />सुर्ग तो यहोवा का सै,</para>
  <para style="q" vid="PSA 115:16">पर धरती उसनै माणसां ताहीं दी सै।<verse eid="PSA 115:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 115:17" />मरे होये जितने चुपचाप पड़े सै,</para>
  <para style="q" vid="PSA 115:17">वो तो परमेसवर की स्तुति न्ही कर सकदे,<verse eid="PSA 115:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 115:18" />पर हम लोग परमेसवर नै</para>
  <para style="q" vid="PSA 115:18">इब तै लेकै सदा ताहीं धन्य कहवागें।</para>
  <para style="q" vid="PSA 115:18">परमेसवर की स्तुति करो!<verse eid="PSA 115:18" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" sid="PSA 116" />
  <para style="s">मौत तै बचण पै परमेसवर का धन्यवाद</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 116:1" />मै प्यार करुँ सूं, इस करकै के यहोवा नै मेरे गिड़गिड़ाणे ताहीं सुण्या सै।<verse eid="PSA 116:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 116:2" />उसनै जो मेरी ओड़ कान लगाया सै,</para>
  <para style="q" vid="PSA 116:2">इस करकै मै जिन्दगी भर उसनै पुकारया करुँगा।<verse eid="PSA 116:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 116:3" />मौत की रस्सी मेरै चारुँ ओड़ थी;</para>
  <para style="q" vid="PSA 116:3">मै अधोलोक की मुसीबत म्ह पड्या था;</para>
  <para style="q" vid="PSA 116:3">मन्‍नै मुसीबत अर शोक भोगणा पड्या।<verse eid="PSA 116:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 116:4" />फेर मन्‍नै यहोवा तै प्रार्थना करी,</para>
  <para style="q" vid="PSA 116:4">“हे यहोवा, बिनती सुणकै मेरी जान बचाले!”<verse eid="PSA 116:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 116:5" />यहोवा करुणामय अर धर्मी सै;</para>
  <para style="q" vid="PSA 116:5">अर म्हारा परमेसवर दया करण आळा सै।<verse eid="PSA 116:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 116:6" />यहोवा भोळयां की रुखाळी करै सै;</para>
  <para style="q" vid="PSA 116:6">जिब मै कमजोर होग्या था, उसनै मेरा उद्धार करया।<verse eid="PSA 116:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 116:7" />हे मेरी जान तू अपणे आराम की जगहां म्ह बोहड़ आ;</para>
  <para style="q" vid="PSA 116:7">क्यूँके यहोवा नै तेरे पै उपकार करया सै।<verse eid="PSA 116:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 116:8" />तन्‍नै तो मेरी जान ताहीं मौत तै,</para>
  <para style="q" vid="PSA 116:8">मेरी आँख नै आँसू बहाण तै,</para>
  <para style="q" vid="PSA 116:8">अर मेरे पैर ठोक्‍कर खाण तै बचाए सै।<verse eid="PSA 116:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 116:9" />मै जिन्दा रहन्दे होये,</para>
  <para style="q" vid="PSA 116:9">अपणे-आपनै यहोवा कै स्याम्ही जाणकै सदा चालदा रहूँगा।<verse eid="PSA 116:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 116:10" />मन्‍नै जो इस तरियां कह्या सै, यहोवा नै बिश्वास की कसोट्टी पै कस के कह्या सै,<note caller="+" style="f"><char style="fr" closed="false">116:10 </char><char style="fq" closed="false">यहोवा नै बिश्वास की कसोट्टी पै कस के कह्या सै, </char><char style="ft" closed="false">मै यहोवा पै भरोस्सा करुँ सूं इस करकै मन्‍नै कह्या “मै घणाए दुखी सूं” </char></note></para>
  <para style="q" vid="PSA 116:10">“मै तो घणाए दुखी सूं;”<verse eid="PSA 116:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 116:11" />मन्‍नै जल्दबाजी तै कह्या,</para>
  <para style="q" vid="PSA 116:11">“सारे माणस झूठ्ठे सै।”<verse eid="PSA 116:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 116:12" />यहोवा नै मेरै पै जितने उपकार करे सै,</para>
  <para style="q" vid="PSA 116:12">उनका बदला मै उसनै किस तरियां दियुँ।<verse eid="PSA 116:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 116:13" />मै दाखमधु का कटोरा ठाकै,</para>
  <para style="q" vid="PSA 116:13">यहोवा ताहीं भेंट चढ़ाऊँगा जिसनै मेरे ताहीं बचाया सै।<verse eid="PSA 116:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 116:14" />मै यहोवा खात्तर अपणी मन्‍नत, सारया की निगांह म्ह खुल्‍लम-खुल्‍ला उसके सारे माणसां कै स्याम्ही पूरी करुँगा।<verse eid="PSA 116:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 116:15" />यहोवा के भगतां की मौत,</para>
  <para style="q" vid="PSA 116:15">उसकी नजर म्ह अनमोल सै।<verse eid="PSA 116:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 116:16" />हे यहोवा, सुण, मै तो तेरा दास सूं;</para>
  <para style="q" vid="PSA 116:16">मै तेरा दास, अर तेरी दास्सी का बेट्टा सूं।</para>
  <para style="q" vid="PSA 116:16">तन्‍नै मेरे बंधन खोल दिए सै।<verse eid="PSA 116:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 116:17" />मै तन्‍नै धन्यवाद की भेंट चढ़ाऊँगा,</para>
  <para style="q" vid="PSA 116:17">अर यहोवा तै प्रार्थना करुँगा।<verse eid="PSA 116:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 116:18" />मै यहोवा खात्तर अपणी मन्‍नतां नै,</para>
  <para style="q" vid="PSA 116:18">खुलकै उसके सारे लोगां कै स्याम्ही<verse eid="PSA 116:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 116:19" />यहोवा के घर के आँगणां म्ह,</para>
  <para style="q" vid="PSA 116:19">हे यरुशलेम, तेरे भित्तर पूरी करुँगा।</para>
  <para style="q" vid="PSA 116:19">परमेसवर की स्तुति करो!<verse eid="PSA 116:19" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" sid="PSA 117" />
  <para style="s">स्तुति का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 117:1" />हे जात-जात के सारे माणसों, यहोवा की स्तुति करो!</para>
  <para style="q" vid="PSA 117:1">हे राज्य-राज्य के सारे माणसों, उसकी प्रशंसा करो!<verse eid="PSA 117:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 117:2" />क्यूँके उसकी करुणा म्हारै पै प्रगट होई सै;</para>
  <para style="q" vid="PSA 117:2">अर यहोवा की सच्‍चाई सदा की सै</para>
  <para style="q" vid="PSA 117:2">परमेसवर की स्तुति करो!<verse eid="PSA 117:2" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" sid="PSA 118" />
  <para style="s">जीत खात्तर धन्यवाद</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 118:1" />यहोवा का धन्यवाद करो, क्यूँके वो भला सै;</para>
  <para style="q" vid="PSA 118:1">अर उसकी करुणा सदा की सै!<verse eid="PSA 118:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 118:2" />इस्राएल कहवै,</para>
  <para style="q" vid="PSA 118:2">उसकी करुणा सदा की सै।<verse eid="PSA 118:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 118:3" />हारुन का कुण्बा कहवै,</para>
  <para style="q" vid="PSA 118:3">उसकी करुणा सदा तक की सै।<verse eid="PSA 118:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 118:4" />यहोवा तै डरण आळे कहवै,</para>
  <para style="q" vid="PSA 118:4">उसकी करुणा सदा की सै।<verse eid="PSA 118:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 118:5" />मन्‍नै मुसीबत म्ह परमेसवर ताहीं पुकारया,</para>
  <para style="q" vid="PSA 118:5">परमेसवर नै मेरी सुणकै, मेरे ताहीं खुल्‍ली जगहां म्ह पोहचाया।<verse eid="PSA 118:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 118:6" />यहोवा मेरी ओड़ सै, मै ना डरुँगा।</para>
  <para style="q" vid="PSA 118:6">माणस मेरा के बिगाड़ सकै सै?<verse eid="PSA 118:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 118:7" />यहोवा मेरी ओड़ मेरा मददगार सै,</para>
  <para style="q" vid="PSA 118:7">मै अपणे दुश्मनां पै निगांह करकै सन्‍तुष्‍ट होऊँगा।<verse eid="PSA 118:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 118:8" />यहोवा की शरण म्ह जाणा,</para>
  <para style="q" vid="PSA 118:8">माणसां पै भरोस्सा राक्खण तै आच्छा सै।<verse eid="PSA 118:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 118:9" />यहोवा की शरण लेणा,</para>
  <para style="q" vid="PSA 118:9">प्रधानां पै भी भरोस्सा राक्खण तै आच्छा सै।<verse eid="PSA 118:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 118:10" />सारी जात्तां नै मेरे ताहीं घेर लिया सै;</para>
  <para style="q" vid="PSA 118:10">पर यहोवा कै नाम तै मै उननै जरुर नाश कर दियुँगा।<verse eid="PSA 118:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 118:11" />उननै मेरै ताहीं घेर लिया सै, बेशक, घेर लिया सै;</para>
  <para style="q" vid="PSA 118:11">पर यहोवा के नाम तै मै उननै जरुर नाश कर दियुँगा।<verse eid="PSA 118:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 118:12" />उननै मै म्हाळ की माक्खियां की तरियां घेर लिया,</para>
  <para style="q" vid="PSA 118:12">पर काँड्या की आग की तरियां वे बुझगे;</para>
  <para style="q" vid="PSA 118:12">यहोवा के नाम तै मै जरुर उननै नाश कर दियुँगा!<verse eid="PSA 118:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 118:13" />तन्‍नै मेरै ताहीं बड़ा धक्‍का दिया तो था, के मै पड़ जाऊँ,</para>
  <para style="q" vid="PSA 118:13">पर यहोवा नै मेरी मदद करी।<verse eid="PSA 118:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 118:14" />परमेसवर मेरा जोर अर गीतां का कारण सै;</para>
  <para style="q" vid="PSA 118:14">वो मेरा उद्धार बण्या सै।<verse eid="PSA 118:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 118:15" />धर्मियाँ के तम्बू म्ह जयजयकार अर उद्धार की आवाज होरी सै,</para>
  <para style="q" vid="PSA 118:15">यहोवा के सोळे हाथ तै पराक्रम के काम होवै सै।<verse eid="PSA 118:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 118:16" />यहोवा का सोळा हाथ महान होया सै,</para>
  <para style="q" vid="PSA 118:16">यहोवा के सोळे हाथ तै पराक्रम के काम होवै सै!<verse eid="PSA 118:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 118:17" />मै ना मरुँगा पर जिन्दा रहूँगा,</para>
  <para style="q" vid="PSA 118:17">अर परमेसवर के काम्मां का जिक्र करदा रहूँगा।<verse eid="PSA 118:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 118:18" />परमेसवर नै मेरी बड़ी ताड़ना तो करी सै</para>
  <para style="q" vid="PSA 118:18">पर मेरे ताहीं मौत कै बस म्ह न्ही छोड्या।<verse eid="PSA 118:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 118:19" />मेरै खात्तर धर्म के दरवाज्जे<note caller="+" style="f"><char style="fr" closed="false">118:19 </char><char style="fq" closed="false">धर्म के दरवाज्जे</char><char style="ft" closed="false">वे दरबाजे जिस म्ह धर्मी माणस दाखल होवैगें यानी आराधनालय </char></note> खोल्‍लो,</para>
  <para style="q" vid="PSA 118:19">मै भित्तर जाकै यहोवा का धन्यवाद करुँगा।<verse eid="PSA 118:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 118:20" />यहोवा का दरवाज्जा योए सै,</para>
  <para style="q" vid="PSA 118:20">इस म्ह धर्मी भित्तर जाण पावैगें।<verse eid="PSA 118:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 118:21" />हे यहोवा, मै तेरा धन्यवाद करुँगा,</para>
  <para style="q" vid="PSA 118:21">क्यूँके तन्‍नै मेरी सुण ली सै,</para>
  <para style="q" vid="PSA 118:21">अर तू मेरा उद्धार बण्या सै।<verse eid="PSA 118:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 118:22" />राजमिस्त्रियाँ नै जो पत्थर निकम्मा ठहराया था</para>
  <para style="q" vid="PSA 118:22">वोए कुणे का सिरा बणग्या सै।<verse eid="PSA 118:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 118:23" />यो तो यहोवा की ओड़ तै होया सै,</para>
  <para style="q" vid="PSA 118:23">वो म्हारी नजर म्ह अदभुत सै।<verse eid="PSA 118:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 118:24" />आज वो दिन सै जो यहोवा नै बणाया सै;</para>
  <para style="q" vid="PSA 118:24">हम इस म्ह मगन अर आनन्दित होवांगे।<verse eid="PSA 118:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 118:25" />हे यहोवा बिनती सुण, उद्धार कर!</para>
  <para style="q" vid="PSA 118:25">हे यहोवा, बिनती सुण, कामयाबी दे।<verse eid="PSA 118:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 118:26" />धन्य सै वो जो यहोवा कै नाम तै आवै सै!</para>
  <para style="q" vid="PSA 118:26">हमनै थारे ताहीं यहोवा के घर तै आशीर्वाद दिया सै।<verse eid="PSA 118:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 118:27" />यहोवा परमेसवर सै, अर उसनै म्हारे ताहीं चान्दणा दिया सै।</para>
  <para style="q" vid="PSA 118:27">यज्ञपशु नै वेदी के खम्बा तै रस्सियाँ कै गैल बाँधो!<verse eid="PSA 118:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 118:28" />हे यहोवा, तू मेरा परमेसवर सै, मै तेरा धन्यवाद करुँगा;</para>
  <para style="q" vid="PSA 118:28">तू मेरा परमेसवर सै, मै तेरी स्तुति करुँगा।<verse eid="PSA 118:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 118:29" />यहोवा का धन्यवाद करो, क्यूँके वो भला सै;</para>
  <para style="q" vid="PSA 118:29">अर उसकी करुणा सदा बणी रहवैगी!<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" sid="PSA 119" />
  <para style="s">परमेसवर के नियम-कायदे की श्रेष्ठता पै ध्यान</para>
  <para style="d">आलेफ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 119:1" />कितणे धन्य सै वे जो चाल के खरे सै,</para>
  <para style="q" vid="PSA 119:1">अर यहोवा के नियम-कायदे पै चाल्‍लै सै!<verse eid="PSA 119:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 119:2" />कितणे धन्य सै वे जो उसकी चितौनियाँ नै मान्‍नै सै,</para>
  <para style="q" vid="PSA 119:2">अर पूरे मन तै उसकै धोरै आवै सै!<verse eid="PSA 119:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 119:3" />फेर वे बुराई के काम कोन्या करदे,</para>
  <para style="q" vid="PSA 119:3">वे उसकी राह पै चाल्‍लै सै।<verse eid="PSA 119:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 119:4" />तन्‍नै अपणे उपदेश इस करकै दिए सै,</para>
  <para style="q" vid="PSA 119:4">ताके हम उसनै यतन करकै मान्‍ना।<verse eid="PSA 119:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 119:5" />आच्छा होन्दा के</para>
  <para style="q" vid="PSA 119:5">तेरी विधियाँ नै मान्‍नण खात्तर मेरी चाल-चलण मजबूत हो जावै!<verse eid="PSA 119:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 119:6" />फेर मै तेरे सारे हुकमां पै मन लगाये रहूँगा,</para>
  <para style="q" vid="PSA 119:6">अर मै शर्मिन्दा न्ही होऊँगा।<verse eid="PSA 119:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 119:7" />जिब मै तेरे धर्म के नियमां नै सीखूंगा,</para>
  <para style="q" vid="PSA 119:7">फेर मै तेरा धन्यवाद सीध्धे मन तै करुँगा।<verse eid="PSA 119:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 119:8" />मै तेरी विधियाँ नै मान्‍नुगां:</para>
  <para style="q" vid="PSA 119:8">मन्‍नै पूरी तरियां तै ना छोड़!</para>
  <para style="s" vid="PSA 119:8">नियम-कायदे नै मानणा</para>
  <para style="d" vid="PSA 119:8">बेथ<verse eid="PSA 119:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 119:9" />गाबरू अपणी चाल नै किस तरियां तै शुद्ध राख सकै सै?</para>
  <para style="q" vid="PSA 119:9">तेरे वचन कै मुताबिक सावधान रहण तै।<verse eid="PSA 119:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 119:10" />मै पूरे मन तै तेरी टोह् म्ह लाग्या सूं;</para>
  <para style="q" vid="PSA 119:10">मन्‍नै तेरे हुकमां के राह तै भटकण ना दे!<verse eid="PSA 119:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 119:11" />मन्‍नै तेरे वचन अपणे दिल म्ह धर राक्खे सै,</para>
  <para style="q" vid="PSA 119:11">ताके तेरे खिलाफ पाप ना करुँ।<verse eid="PSA 119:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 119:12" />हे यहोवा तू धन्य सै;</para>
  <para style="q" vid="PSA 119:12">मन्‍नै अपणी विधि सिखा!<verse eid="PSA 119:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 119:13" />तेरे कहे होये सारे नियमां का जिक्र,</para>
  <para style="q" vid="PSA 119:13">मन्‍नै अपणे मुँह तै करया सै।<verse eid="PSA 119:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 119:14" />मै तेरी चितौनियाँ की राह पै,</para>
  <para style="q" vid="PSA 119:14">मान्‍नो सारे ढाळ के धन तै खुश होया सूं।<verse eid="PSA 119:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 119:15" />मै तेरे उपदेशां पै ध्यान करुँगा,</para>
  <para style="q" vid="PSA 119:15">अर तेरी राह पै नजर राखूँगा।<verse eid="PSA 119:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 119:16" />मै तेरी विधियाँ तै सुख पाऊँगा;</para>
  <para style="q" vid="PSA 119:16">अर तेरे वचनां नै ना भूल्‍लूँगा।</para>
  <para style="s" vid="PSA 119:16">नियम-कायदे म्ह आनन्द</para>
  <para style="d" vid="PSA 119:16">गिमेल<verse eid="PSA 119:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 119:17" />अपणे दास पै मेहरबानी कर ताके मै जिन्दा रहूँ,</para>
  <para style="q" vid="PSA 119:17">अर तेरे वचन पै चाल्दा रहूँ।<verse eid="PSA 119:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 119:18" />मेरी आँख खोल दे, के मै तेरे नियम-कायदे की</para>
  <para style="q" vid="PSA 119:18">अदभुत बात्तां नै देख सकूँ।<verse eid="PSA 119:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 119:19" />मै तो धरती पै परदेशी सूं;</para>
  <para style="q" vid="PSA 119:19">अपणे हुकमां नै मेरै तै छिपा कै ना राख!<verse eid="PSA 119:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 119:20" />मेरा मन तेरे नियमां की लालसा कै कारण</para>
  <para style="q" vid="PSA 119:20">हर बखत दुखी रहवै सै।<verse eid="PSA 119:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 119:21" />तन्‍नै घमण्डियाँ ताहीं, जो श्रापित सै, झिड़क्या सै,</para>
  <para style="q" vid="PSA 119:21">वे तेरे हुकमां तै भटके होये सै।<verse eid="PSA 119:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 119:22" />मेरी बदनाम्मी अर बेजती दूर कर,</para>
  <para style="q" vid="PSA 119:22">क्यूँके मै तेरी चितौनियाँ नै पकड़े सूं।<verse eid="PSA 119:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 119:23" />हाकिम भी बेठै होये आपसरी म्ह मेरै खिलाफ बात करै थे,</para>
  <para style="q" vid="PSA 119:23">पर तेरा दास तेरी विधियाँ पै ध्यान करदा रहया।<verse eid="PSA 119:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 119:24" />तेरी चितौनी मेरे सुख की नींव</para>
  <para style="q" vid="PSA 119:24">अर मेरे सलाहकार सै।</para>
  <para style="s" vid="PSA 119:24">नियम-कायदा ताहीं मान्‍नण का इरादा</para>
  <para style="d" vid="PSA 119:24">दाल्थ<verse eid="PSA 119:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 119:25" />मै धूळ मै पड्या सूं;</para>
  <para style="q" vid="PSA 119:25">तू अपणे वचन कै मुताबिक मन्‍नै जिन्दा कर!<verse eid="PSA 119:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 119:26" />मन्‍नै अपणे चाल चलण का, तेरे ताहीं जिक्र करया सै अर तन्‍नै मेरी बात मान ली सै;</para>
  <para style="q" vid="PSA 119:26">तू मन्‍नै अपणी सारी विधि सिखा।<verse eid="PSA 119:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 119:27" />अपणे उपदेशां की राह मन्‍नै समझा,</para>
  <para style="q" vid="PSA 119:27">फेर मै तेरे अचम्भे के काम्मां<note caller="+" style="f"><char style="fr" closed="false">119:27 </char><char style="fq" closed="false">काम्मां </char><char style="ft" closed="false">शिक्षा</char></note> पै ध्यान करुँगा।<verse eid="PSA 119:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 119:28" />मेरी जान उदासी कै कारण गळ चाल्‍ली सै,</para>
  <para style="q" vid="PSA 119:28">तू अपणे वचन कै मुताबिक मन्‍नै सम्भाळ!<verse eid="PSA 119:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 119:29" />मन्‍नै झूठ की राह तै दूर कर;</para>
  <para style="q" vid="PSA 119:29">अर कृपा करकै अपणे नियम-कायदे मन्‍नै दे।<verse eid="PSA 119:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 119:30" />मन्‍नै सच्‍चाई की राह चुण ली सै,</para>
  <para style="q" vid="PSA 119:30">तेरे नियमां की ओड़ मै मन लगाये रहूँ सूं।<verse eid="PSA 119:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 119:31" />मै तेरी चितौनियाँ म्ह मगन सूं,</para>
  <para style="q" vid="PSA 119:31">हे यहोवा, मन्‍नै शर्मिन्दा ना होण दे!<verse eid="PSA 119:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 119:32" />जिब तू मेरी हिम्मत बढ़ावैगा,</para>
  <para style="q" vid="PSA 119:32">फेर मै तेरे हुकमां की राह म्ह दौड़ूँगा।</para>
  <para style="s" vid="PSA 119:32">समझ खात्तर प्रार्थना</para>
  <para style="d" vid="PSA 119:32">हे<verse eid="PSA 119:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 119:33" />हे यहोवा, मन्‍नै अपणी विधियाँ का राह सिखा;</para>
  <para style="q" vid="PSA 119:33">फेर मै उसनै आखरी तक पकड़े रहूँगा।<verse eid="PSA 119:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 119:34" />मन्‍नै समझ दे, फेर मै तेरे नियम-कायदे नै पकड़े रहूँगा।</para>
  <para style="q" vid="PSA 119:34">अर सारे मन तै उसपै चाल्‍लूँगा।<verse eid="PSA 119:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 119:35" />अपणे हुकमां की राह पै मन्‍नै चला,</para>
  <para style="q" vid="PSA 119:35">क्यूँके मै उसे तै खुश सूं।<verse eid="PSA 119:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 119:36" />मेरै मन नै लालच की ओड़ न्ही,</para>
  <para style="q" vid="PSA 119:36">अपणी चितौनियाँ की ओड़ फेर दे।<verse eid="PSA 119:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 119:37" />मेरी आँखां नै बेकार चिज्जां की ओड़ तै हटा दे;</para>
  <para style="q" vid="PSA 119:37">तू अपणी राह म्ह मन्‍नै जिवा।<verse eid="PSA 119:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 119:38" />तेरा वादा जो तेरे डरण आळयां खात्तर सै,</para>
  <para style="q" vid="PSA 119:38">उसनै अपणे दास खात्तर पूरा कर।<verse eid="PSA 119:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 119:39" />जिस बदनाम्मी तै मै डरुँ सूं, उसनै दूर कर;</para>
  <para style="q" vid="PSA 119:39">क्यूँके तेरे नियम खास सै।<verse eid="PSA 119:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 119:40" />देख, मै तेरे उपदेशां का अभिलाषी सूं;</para>
  <para style="q" vid="PSA 119:40">अपणे धर्म कै कारण मन्‍नै जिन्दा कर।</para>
  <para style="s" vid="PSA 119:40">परमेसवर के नियम-कायदे पै भरोस्सा</para>
  <para style="d" vid="PSA 119:40">वाव<verse eid="PSA 119:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 119:41" />हे यहोवा, तेरी करुणा अर तेरा करया होया उद्धार,</para>
  <para style="q" vid="PSA 119:41">तेरे वादे कै कारण मन्‍नै भी मिलै;<verse eid="PSA 119:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 119:42" />फेर मै अपणी बदनाम्मी करण आळयां नै किमे जवाब दे सकूँगा,</para>
  <para style="q" vid="PSA 119:42">क्यूँके मेरा भरोस्सा, तेरे वचन पै सै।<verse eid="PSA 119:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 119:43" />मन्‍नै अपणे सच्‍चे वचन कहण तै ना रोक</para>
  <para style="q" vid="PSA 119:43">क्यूँके मेरी उम्मीद तेरे नियमां पै सै।<verse eid="PSA 119:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 119:44" />फेर मै तेरे नियम-कायदे पै लगातार,</para>
  <para style="q" vid="PSA 119:44">हमेशा-हमेशा चाल्दा रहूँगा;<verse eid="PSA 119:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 119:45" />अर मै खुल्‍ली जगहां मै चल्या फिरया करुँगा,</para>
  <para style="q" vid="PSA 119:45">क्यूँके मन्‍नै तेरे उपदेशां का ख्याल राख्या सै।<verse eid="PSA 119:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 119:46" />अर मै तेरी चितौनियाँ की चर्चा राजयां कै आग्गै भी करुँगा,</para>
  <para style="q" vid="PSA 119:46">अर शर्मिन्दा ना होऊँगा;<verse eid="PSA 119:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 119:47" />क्यूँके मै तेरी आज्ञा कै कारण सुखी सूं,</para>
  <para style="q" vid="PSA 119:47">अर मै उनतै प्रेम राक्खूँ सूं।<verse eid="PSA 119:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 119:48" />मै तेरे हुकमां की ओड़ जिनतै मै प्रेम राक्खूँ सूं, हाथ फैलाऊँगा</para>
  <para style="q" vid="PSA 119:48">अर तेरी विधियाँ पै ध्यान करुँगा।</para>
  <para style="s" vid="PSA 119:48">परमेसवर के नियम-कायदे म्ह आशा</para>
  <para style="d" vid="PSA 119:48">ज़ैन<verse eid="PSA 119:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 119:49" />जो वादा तन्‍नै अपणे दास तै करया सै, उसनै याद कर,</para>
  <para style="q" vid="PSA 119:49">क्यूँके तन्‍नै मेरे ताहीं उम्मीद दी सै।<verse eid="PSA 119:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 119:50" />मेरे दुख म्ह मन्‍नै शान्ति उसे तै होई सै,</para>
  <para style="q" vid="PSA 119:50">क्यूँके तेरे वचन कै कारण मन्‍नै जीवन पाया सै।<verse eid="PSA 119:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 119:51" />घमण्डियाँ नै मेरे ताहीं घणा मजाक म्ह उड़ाया सै,</para>
  <para style="q" vid="PSA 119:51">तोभी मै तेरे नियम-कायदे तै न्ही हटया।<verse eid="PSA 119:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 119:52" />हे यहोवा, मन्‍नै तेरे पुराणे नियमां ताहीं, याद करकै</para>
  <para style="q" vid="PSA 119:52">शान्ति पाई सै।<verse eid="PSA 119:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 119:53" />जो दुष्ट तेरे नियम-कायदे नै छोड्डे होये सै,</para>
  <para style="q" vid="PSA 119:53">उनकै कारण मै छो तै जळु सूं।<verse eid="PSA 119:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 119:54" />जित्त मै परदेशी होकै रहूँ सूं, ओड़ै तेरी विधि,</para>
  <para style="q" vid="PSA 119:54">मेरे गीत गाण का कारण बणी सै।<verse eid="PSA 119:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 119:55" />हे यहोवा मन्‍नै रात नै तेरा नाम याद करया,</para>
  <para style="q" vid="PSA 119:55">अर तेरे नियम-कायदे पै चल्या सूं।<verse eid="PSA 119:55" /></para>
  <para style="q">
    <verse number="56" style="v" sid="PSA 119:56" />यो मेरै तै इस कारण होया,</para>
  <para style="q" vid="PSA 119:56">के मै तेरे उपदेशां नै पकड़े होये था।</para>
  <para style="s" vid="PSA 119:56">नियम-कायदे के प्रति भगति</para>
  <para style="d" vid="PSA 119:56">हेथ<verse eid="PSA 119:56" /></para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 119:57" />यहोवा मेरा हक सै;</para>
  <para style="q" vid="PSA 119:57">मन्‍नै तेरे वचनां कै मुताबिक चालण का फैसला करया सै।<verse eid="PSA 119:57" /></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 119:58" />मन्‍नै पूरे मन तै तेरे ताहीं मनाया सै;</para>
  <para style="q" vid="PSA 119:58">इस करकै अपणे वादे कै मुताबिक मेरै पै दया कर।<verse eid="PSA 119:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 119:59" />मन्‍नै अपणी चाल चलण ताहीं परख्या,</para>
  <para style="q" vid="PSA 119:59">अर तेरी चितौनियाँ की राह ली।<verse eid="PSA 119:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 119:60" />मन्‍नै तेरे हुकम मानण म्ह देर न्ही, तावळ करी सै।<verse eid="PSA 119:60" /></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 119:61" />मै दुष्टा की रस्सियाँ तै बंध ग्या सूं,</para>
  <para style="q" vid="PSA 119:61">फेर भी मै तेरे नियम-कायदे नै न्ही भूल्या।<verse eid="PSA 119:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 119:62" />तेरे धर्म के नियमां कै कारण</para>
  <para style="q" vid="PSA 119:62">मै आध्धी रात नै तेरा धन्यवाद करण खात्तर उठूँगा।<verse eid="PSA 119:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 119:63" />जितने तेरा भय मान्‍नै अर तेरे उपदेशां पै चाल्‍लै सै,</para>
  <para style="q" vid="PSA 119:63">उनका मै साथी सूं।<verse eid="PSA 119:63" /></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 119:64" />हे यहोवा, तेरी करुणा धरती मै भरी पड़ी सै;</para>
  <para style="q" vid="PSA 119:64">तू मन्‍नै अपणी विधियाँ ताहीं सिखा!</para>
  <para style="s" vid="PSA 119:64">नियम-कायदे का महत्व</para>
  <para style="d" vid="PSA 119:64">टेथ<verse eid="PSA 119:64" /></para>
  <para style="q">
    <verse number="65" style="v" sid="PSA 119:65" />हे यहोवा, तन्‍नै अपणे वचन कै मुताबिक</para>
  <para style="q" vid="PSA 119:65">अपणे दास कै गैल भलाई करी सै।<verse eid="PSA 119:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 119:66" />मन्‍नै भली अन्तर-आत्मा की शक्ति अर समझ दे,</para>
  <para style="q" vid="PSA 119:66">क्यूँके मन्‍नै तेरे हुकमां का बिश्वास करया सै।<verse eid="PSA 119:66" /></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 119:67" />इसतै पैहल्या के मै दुखी होया, मै भटक्या होया था;</para>
  <para style="q" vid="PSA 119:67">पर इब मै तेरे वचन नै मान्‍नु सूं।<verse eid="PSA 119:67" /></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 119:68" />तू भला सै, अर भला करै भी सै;</para>
  <para style="q" vid="PSA 119:68">मन्‍नै अपणी विधियाँ सिखा।<verse eid="PSA 119:68" /></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 119:69" />घमण्डियाँ नै तो मेरै खिलाफ झूठ्ठी बात बणाई सै,</para>
  <para style="q" vid="PSA 119:69">पर मै तेरे उपदेशां नै पूरे मन तै पकड़े रहूँगा।<verse eid="PSA 119:69" /></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 119:70" />उनका मन मोट्टा होग्या सै,<note caller="+" style="f"><char style="fr" closed="false">119:70 </char><char style="fq" closed="false">उनका मन मोट्टा होग्या सै, </char><char style="ft" closed="false">उनके मन म्ह कोए सच्‍चाई न्ही बची </char></note></para>
  <para style="q" vid="PSA 119:70">पर मै तेरे नियम-कायदे कै कारण सुखी सूं।<verse eid="PSA 119:70" /></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 119:71" />मन्‍नै जो दुख होया वो मेरै खात्तर आच्छा ए होया सै</para>
  <para style="q" vid="PSA 119:71">जिसतै मै तेरी विधियाँ नै सीख सकूँ।<verse eid="PSA 119:71" /></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 119:72" />तेरे दिये होये नियम-कायदे मेरै खात्तर</para>
  <para style="q" vid="PSA 119:72">हजारों रपियाँ अर मोहरां तै भी खास सै।</para>
  <para style="s" vid="PSA 119:72">नियम-कायदे का न्याय</para>
  <para style="d" vid="PSA 119:72">योध<verse eid="PSA 119:72" /></para>
  <para style="q">
    <verse number="73" style="v" sid="PSA 119:73" />तेरे हाथ्थां तै मै बणाया अर रच्या गया सूं;</para>
  <para style="q" vid="PSA 119:73">मन्‍नै समझ दे के मै तेरे हुकमां नै सिखूं।<verse eid="PSA 119:73" /></para>
  <para style="q">
    <verse number="74" style="v" sid="PSA 119:74" />तेरे डरण आळे मन्‍नै देखकै खुश होवैगें,</para>
  <para style="q" vid="PSA 119:74">क्यूँके मन्‍नै तेरे वचन पै आस लगाई सै।<verse eid="PSA 119:74" /></para>
  <para style="q">
    <verse number="75" style="v" sid="PSA 119:75" />हे यहोवा, मै जाण ग्या के तेरे नियम धार्मिकता के सै,</para>
  <para style="q" vid="PSA 119:75">अर तन्‍नै अपणी सच्‍चाई कै मुताबिक मन्‍नै दुख दिया सै।<verse eid="PSA 119:75" /></para>
  <para style="q">
    <verse number="76" style="v" sid="PSA 119:76" />मन्‍नै अपणी करुणा तै शान्ति दे,</para>
  <para style="q" vid="PSA 119:76">क्यूँके तन्‍नै अपणे दास तै इसाए वादा करया सै।<verse eid="PSA 119:76" /></para>
  <para style="q">
    <verse number="77" style="v" sid="PSA 119:77" />तेरी दया मेरै पै हो, फेर मै जिन्दा रहूँगा;</para>
  <para style="q" vid="PSA 119:77">क्यूँके मै तेरे नियम-कायदे तै सुखी सूं।<verse eid="PSA 119:77" /></para>
  <para style="q">
    <verse number="78" style="v" sid="PSA 119:78" />घमण्डी शर्मिन्दा करे जावै, क्यूँके उननै मै झूठ के जरिये गेर दिया सूं;</para>
  <para style="q" vid="PSA 119:78">पर मै तेरे उपदेशां पै ध्यान करुँगा।<verse eid="PSA 119:78" /></para>
  <para style="q">
    <verse number="79" style="v" sid="PSA 119:79" />जो तेरा भय मान्‍नै सै, वे मेरी और फिरै,</para>
  <para style="q" vid="PSA 119:79">फेर वे तेरी चितौनियाँ नै समझ लेवैगें।<verse eid="PSA 119:79" /></para>
  <para style="q">
    <verse number="80" style="v" sid="PSA 119:80" />मेरा मन तेरी विधियाँ नै मानण म्ह सिध्द हो,</para>
  <para style="q" vid="PSA 119:80">इसा ना हो के मन्‍नै शर्मिन्दा होणा पड़ै।</para>
  <para style="s" vid="PSA 119:80">छुटकारै खात्तर प्रार्थना</para>
  <para style="d" vid="PSA 119:80">क़ाफ<verse eid="PSA 119:80" /></para>
  <para style="q">
    <verse number="81" style="v" sid="PSA 119:81" />मेरा जी तेरे उद्धार खात्तर बेचैन सै;</para>
  <para style="q" vid="PSA 119:81">पर मन्‍नै तेरे वचन पै आस रहवै सै।<verse eid="PSA 119:81" /></para>
  <para style="q">
    <verse number="82" style="v" sid="PSA 119:82" />मेरी आँख तेरे वादे नै पूरा होण की बाट देखदे-देखदे धुँधळी पड़गी सै;</para>
  <para style="q" vid="PSA 119:82">अर मै कहूँ सूं के तू मन्‍नै कद शान्ति देवैगा?<verse eid="PSA 119:82" /></para>
  <para style="q">
    <verse number="83" style="v" sid="PSA 119:83" />क्यूँके मै धुँम्मे की कुप्‍पी की तरियां होग्या सूं,</para>
  <para style="q" vid="PSA 119:83">तोभी तेरी विधियाँ नै न्ही भूल्या।<verse eid="PSA 119:83" /></para>
  <para style="q">
    <verse number="84" style="v" sid="PSA 119:84" />तेरे दास के कितणे दिन रहगें सै?</para>
  <para style="q" vid="PSA 119:84">तू मेरै पाच्छै पड़े होया नै सजा कद देवैगा?<verse eid="PSA 119:84" /></para>
  <para style="q">
    <verse number="85" style="v" sid="PSA 119:85" />घमण्डी जो तेरे नियम-कायदे कै मुताबिक न्ही चाल्दे,</para>
  <para style="q" vid="PSA 119:85">उननै मेरै खात्तर खड्डे खोद्दे सै।<verse eid="PSA 119:85" /></para>
  <para style="q">
    <verse number="86" style="v" sid="PSA 119:86" />तेरे सारे हुक्म बिश्वास करण आळें सै;</para>
  <para style="q" vid="PSA 119:86">वे लोग झूठ बोलदे होये मेरै पाच्छै पड़े सै;</para>
  <para style="q" vid="PSA 119:86">तू मेरी मदद कर!<verse eid="PSA 119:86" /></para>
  <para style="q">
    <verse number="87" style="v" sid="PSA 119:87" />वे मन्‍नै धरती पै तै मिटा देण पैए थे,</para>
  <para style="q" vid="PSA 119:87">पर मन्‍नै तेरे उपदेशां ताहीं न्ही छोड्या।<verse eid="PSA 119:87" /></para>
  <para style="q">
    <verse number="88" style="v" sid="PSA 119:88" />अपणी करुणा कै मुताबिक मेरी हिफाजत कर<note caller="+" style="f"><char style="fr" closed="false">119:88 </char><char style="fq" closed="false">मेरी हिफाजत कर </char><char style="ft" closed="false">मन्‍नै जिन्दा कर </char></note>,</para>
  <para style="q" vid="PSA 119:88">फेर मै तेरी दी होई चितौनी नै मान्‍नुगा।</para>
  <para style="s" vid="PSA 119:88">नियम-कायदे म्ह बिश्वास</para>
  <para style="d" vid="PSA 119:88">लामेध<verse eid="PSA 119:88" /></para>
  <para style="q">
    <verse number="89" style="v" sid="PSA 119:89" />हे यहोवा, तेरा वचन</para>
  <para style="q" vid="PSA 119:89">अकास म्ह सदा तक टिक्या रहवै सै।<verse eid="PSA 119:89" /></para>
  <para style="q">
    <verse number="90" style="v" sid="PSA 119:90" />तेरी सच्‍चाई पीढ़ी तै पीढ़ी तक बणी रहवै सै;</para>
  <para style="q" vid="PSA 119:90">तन्‍नै धरती ताहीं मजबूत करया, इस करकै वा टीकी सै।<verse eid="PSA 119:90" /></para>
  <para style="q">
    <verse number="91" style="v" sid="PSA 119:91" />वे आज कै दिन तक तेरे नियमां कै मुताबिक बणी सै;</para>
  <para style="q" vid="PSA 119:91">क्यूँके सारी सृष्टि तेरे अधीन सै।<verse eid="PSA 119:91" /></para>
  <para style="q">
    <verse number="92" style="v" sid="PSA 119:92" />जै मै तेरे नियम-कायदे तै सुखी ना होन्दा,</para>
  <para style="q" vid="PSA 119:92">तो मै दुख कै बखत नाश हो जान्दा।<verse eid="PSA 119:92" /></para>
  <para style="q">
    <verse number="93" style="v" sid="PSA 119:93" />मै तेरे उपदेशां नै कदे भी ना भूल्‍लूँगा;</para>
  <para style="q" vid="PSA 119:93">क्यूँके उन्हे कै कारण तन्‍नै मेरे ताहीं जिन्दा करया सै।<verse eid="PSA 119:93" /></para>
  <para style="q">
    <verse number="94" style="v" sid="PSA 119:94" />मै तेराए सूं, तू मेरा उद्धार कर;</para>
  <para style="q" vid="PSA 119:94">क्यूँके मै तेरे उपदेशां की सुधि राक्खूँ सूं।<verse eid="PSA 119:94" /></para>
  <para style="q">
    <verse number="95" style="v" sid="PSA 119:95" />दुष्ट मेरा नाश करण खात्तर मेरी ताक म्ह लाग्गै सै;</para>
  <para style="q" vid="PSA 119:95">पर मै तेरी चितौनियाँ पै ध्यान करुँ सूं।<verse eid="PSA 119:95" /></para>
  <para style="q">
    <verse number="96" style="v" sid="PSA 119:96" />मन्‍नै देख्या सै के सब क्याँए की हद होवै सै,</para>
  <para style="q" vid="PSA 119:96">पर तेरे हुकमां का विस्तार बड़ा अर हद तै ज्यादा सै।</para>
  <para style="s" vid="PSA 119:96">नियम-कायदे के प्रति प्रेम</para>
  <para style="d" vid="PSA 119:96">मीम<verse eid="PSA 119:96" /></para>
  <para style="q">
    <verse number="97" style="v" sid="PSA 119:97" />आहा! मै तेरे नियम-कायदे तै किसा प्रेम राक्खूँ सूं!</para>
  <para style="q" vid="PSA 119:97">दिन भर मेरा ध्यान उस्से पै लाग्या रहवै सै।<verse eid="PSA 119:97" /></para>
  <para style="q">
    <verse number="98" style="v" sid="PSA 119:98" />तू अपणी आज्ञा कै कारण मन्‍नै अपणे दुश्मनां तै घणा बुद्धिमान करै सै,</para>
  <para style="q" vid="PSA 119:98">क्यूँके वो सदा मेरै मन मै रहवै सै।<verse eid="PSA 119:98" /></para>
  <para style="q">
    <verse number="99" style="v" sid="PSA 119:99" />मै अपणे सारे सिखाण आळयां तै भी घणी समझ राक्खूँ सूं,</para>
  <para style="q" vid="PSA 119:99">क्यूँके मेरा ध्यान तेरी चितौनियाँ पै लाग्या सै।<verse eid="PSA 119:99" /></para>
  <para style="q">
    <verse number="100" style="v" sid="PSA 119:100" />मै अगुवां तै भी समझदार सूं,</para>
  <para style="q" vid="PSA 119:100">क्यूँके मै तेरे उपदेशां नै पकड़े होये सूं।<verse eid="PSA 119:100" /></para>
  <para style="q">
    <verse number="101" style="v" sid="PSA 119:101" />मन्‍नै अपणे पैर हर एक बुरी राह तै रोक राक्खे सै,</para>
  <para style="q" vid="PSA 119:101">जिसतै मै तेरे वचन कै मुताबिक चाल्‍लूँ।<verse eid="PSA 119:101" /></para>
  <para style="q">
    <verse number="102" style="v" sid="PSA 119:102" />मै तेरे नियमां तै न्ही हटया,</para>
  <para style="q" vid="PSA 119:102">क्यूँके तन्‍नै ए मेरे ताहीं सिखाया सै।<verse eid="PSA 119:102" /></para>
  <para style="q">
    <verse number="103" style="v" sid="PSA 119:103" />तेरे वचन मन्‍नै किसे मीठ्ठे लाग्गै सै,</para>
  <para style="q" vid="PSA 119:103">वे मेरै मुँह म्ह शहद तै भी मीठ्ठे सै!<verse eid="PSA 119:103" /></para>
  <para style="q">
    <verse number="104" style="v" sid="PSA 119:104" />तेरे उपदेशां कै कारण मै समझदार हो ज्याऊँ सूं,</para>
  <para style="q" vid="PSA 119:104">इस कारण मै सारे झूठ के राह तै दुश्मनी राक्खूँ सूं।</para>
  <para style="s" vid="PSA 119:104">नियम-कायदे का प्रकाश</para>
  <para style="d" vid="PSA 119:104">नून<verse eid="PSA 119:104" /></para>
  <para style="q">
    <verse number="105" style="v" sid="PSA 119:105" />तेरा वचन मेरे पैरां खात्तर दीवा,</para>
  <para style="q" vid="PSA 119:105">अर मेरी राह खात्तर चान्दणा सै।<verse eid="PSA 119:105" /></para>
  <para style="q">
    <verse number="106" style="v" sid="PSA 119:106" />मन्‍नै कसम खाई, अर ठाण लिया सै</para>
  <para style="q" vid="PSA 119:106">के मै तेरे धर्म के नियमां कै मुताबिक चाल्‍लूँगा।<verse eid="PSA 119:106" /></para>
  <para style="q">
    <verse number="107" style="v" sid="PSA 119:107" />मै घणा दुख म्ह पड्या सूं;</para>
  <para style="q" vid="PSA 119:107">हे यहोवा, अपणे वादे कै मुताबिक मन्‍नै जिन्दा कर।<verse eid="PSA 119:107" /></para>
  <para style="q">
    <verse number="108" style="v" sid="PSA 119:108" />हे यहोवा, मेरे वचनां नै स्वेच्छाबलि जाणकै<note caller="+" style="f"><char style="fr" closed="false">119:108 </char><char style="fq" closed="false">स्वेच्छाबलि </char><char style="ft" closed="false">अपणी इच्छा </char></note> कबूल कर,</para>
  <para style="q" vid="PSA 119:108">अर अपणे नियमां नै मेरे ताहीं सिखा।<verse eid="PSA 119:108" /></para>
  <para style="q">
    <verse number="109" style="v" sid="PSA 119:109" />मेरी जान हमेशा मेरी हथेळी पै<note caller="+" style="f"><char style="fr" closed="false">119:109 </char><char style="fq" closed="false">मेरी जान हमेशा मेरी हथेळी पै </char><char style="ft" closed="false">जान खतरे मै</char></note> रहवै सै,</para>
  <para style="q" vid="PSA 119:109">फेर भी मै तेरे नियम-कायदा नै न्ही भूल्या।<verse eid="PSA 119:109" /></para>
  <para style="q">
    <verse number="110" style="v" sid="PSA 119:110" />दुष्टा नै मेरै खात्तर फंदा लगाया सै,</para>
  <para style="q" vid="PSA 119:110">पर मै तेरे उपदेशां की राह तै ना भटक्या।<verse eid="PSA 119:110" /></para>
  <para style="q">
    <verse number="111" style="v" sid="PSA 119:111" />मन्‍नै तेरी चितौनियाँ ताहीं सदा खात्तर अपणा खास हिस्सा बणा लिया सै,</para>
  <para style="q" vid="PSA 119:111">क्यूँके वे मेरे दिल की खुशी का कारण सै।<verse eid="PSA 119:111" /></para>
  <para style="q">
    <verse number="112" style="v" sid="PSA 119:112" />मन्‍नै अपणा मन इस बात पै लगाया सै,</para>
  <para style="q" vid="PSA 119:112">के आखरी तक तेरी विधियाँ पै सदा चाल्दा रहूँ।</para>
  <para style="s" vid="PSA 119:112">नियम-कायदे म्ह हिफाजत</para>
  <para style="d" vid="PSA 119:112">सामेख<verse eid="PSA 119:112" /></para>
  <para style="q">
    <verse number="113" style="v" sid="PSA 119:113" />मै दो मन आळयां तै बैर राक्खूँ सूं,</para>
  <para style="q" vid="PSA 119:113">पर तेरे नियम-कायदे तै प्रेम राक्खूँ सूं।<verse eid="PSA 119:113" /></para>
  <para style="q">
    <verse number="114" style="v" sid="PSA 119:114" />तू मेरी आड़ अर ढाल सै;</para>
  <para style="q" vid="PSA 119:114">मेरी आस तेरे वचन पै सै।<verse eid="PSA 119:114" /></para>
  <para style="q">
    <verse number="115" style="v" sid="PSA 119:115" />हे बुरा काम करणियों, मेरै तै दूर हो जाओ,</para>
  <para style="q" vid="PSA 119:115">ताके मै अपणे परमेसवर के हुकमां नै पकड़े रहूँ!<verse eid="PSA 119:115" /></para>
  <para style="q">
    <verse number="116" style="v" sid="PSA 119:116" />हे यहोवा, अपणे वचन कै मुताबिक मन्‍नै सम्भाळ, ताके मै जिन्दा रहूँ,</para>
  <para style="q" vid="PSA 119:116">अर मेरी आस ना तोड़।<verse eid="PSA 119:116" /></para>
  <para style="q">
    <verse number="117" style="v" sid="PSA 119:117" />मन्‍नै थाम्मे राख, फेर मै बचा रहूँगा,</para>
  <para style="q" vid="PSA 119:117">अर लगातार तेरी विधियाँ की ओड़ मन लगाऐ राक्खूँगा!<verse eid="PSA 119:117" /></para>
  <para style="q">
    <verse number="118" style="v" sid="PSA 119:118" />जितने तेरी विधियाँ के राह तै भटक ज्या सै,</para>
  <para style="q" vid="PSA 119:118">उन सारया नै निकम्मा जाणै सै,</para>
  <para style="q" vid="PSA 119:118">क्यूँके उनकी चतुराई झूठ सै।<verse eid="PSA 119:118" /></para>
  <para style="q">
    <verse number="119" style="v" sid="PSA 119:119" />तन्‍नै धरती के सारे दुष्ट माणसां ताहीं लोहे कै लाग्गे होये जर की तरियां दूर करया सै;</para>
  <para style="q" vid="PSA 119:119">इस करकै मै तेरी चितौनियाँ तै प्रेम करुँ सूं।<verse eid="PSA 119:119" /></para>
  <para style="q">
    <verse number="120" style="v" sid="PSA 119:120" />तेरे डर तै मेरी देह काँप उठ्ठी सै,</para>
  <para style="q" vid="PSA 119:120">अर मै तेरे नियमां तै डरुँ सूं।</para>
  <para style="s" vid="PSA 119:120">परमेसवर के नियम-कायदे नै मानणा</para>
  <para style="d" vid="PSA 119:120">ऐन<verse eid="PSA 119:120" /></para>
  <para style="q">
    <verse number="121" style="v" sid="PSA 119:121" />मन्‍नै तो न्याय अर धर्म का काम करया सै;</para>
  <para style="q" vid="PSA 119:121">तू मन्‍नै अत्याचार करणीये कै हाथ म्ह ना छोड़।<verse eid="PSA 119:121" /></para>
  <para style="q">
    <verse number="122" style="v" sid="PSA 119:122" />अपणे दास की भलाई खात्तर जमानती हो,</para>
  <para style="q" vid="PSA 119:122">ताके घमण्डी मेरै पै अत्याचार ना करण पावैं।<verse eid="PSA 119:122" /></para>
  <para style="q">
    <verse number="123" style="v" sid="PSA 119:123" />मेरी आँख तेरे तै उद्धार पाण,</para>
  <para style="q" vid="PSA 119:123">अर तेरे धर्म के वचन नै पूरा होण की बाट देखदे-देखदे धुँधळी पड़गी सै।<verse eid="PSA 119:123" /></para>
  <para style="q">
    <verse number="124" style="v" sid="PSA 119:124" />अपणे दास कै गैल अपणी करुणा कै मुताबिक बरताव कर,</para>
  <para style="q" vid="PSA 119:124">अर अपणी विधि मन्‍नै सिखा।<verse eid="PSA 119:124" /></para>
  <para style="q">
    <verse number="125" style="v" sid="PSA 119:125" />मै तेरा दास सूं, तू मन्‍नै समझ दे</para>
  <para style="q" vid="PSA 119:125">ताके मै तेरी चितौनियाँ नै समझूँ।<verse eid="PSA 119:125" /></para>
  <para style="q">
    <verse number="126" style="v" sid="PSA 119:126" />वो बखत आया सै, के यहोवा काम करै,</para>
  <para style="q" vid="PSA 119:126">क्यूँके लोगां नै तेरे नियम-कायदे तोड़ दिये सै।<verse eid="PSA 119:126" /></para>
  <para style="q">
    <verse number="127" style="v" sid="PSA 119:127" />इस कारण मै तेरे हुकमां नै सोन्‍ने बल्के कुन्दन तै भी घणा प्यारा मान्‍नु सूं।<verse eid="PSA 119:127" /></para>
  <para style="q">
    <verse number="128" style="v" sid="PSA 119:128" />इस्से कारण मै तेरे सारे उपदेशां कै बारै म्ह ठीक जाणु सूं;</para>
  <para style="q" vid="PSA 119:128">अर सारे झूठ्ठे राह तै बैर राक्खूँ सूं।</para>
  <para style="s" vid="PSA 119:128">नियम-कायदे पै चाल्‍लण की इच्छा</para>
  <para style="d" vid="PSA 119:128">पै<verse eid="PSA 119:128" /></para>
  <para style="q">
    <verse number="129" style="v" sid="PSA 119:129" />तेरी चितौनियाँ अनोखी सै,</para>
  <para style="q" vid="PSA 119:129">इस कारण मै उननै अपणे जी तै पकड़े होये सूं।<verse eid="PSA 119:129" /></para>
  <para style="q">
    <verse number="130" style="v" sid="PSA 119:130" />तेरी बात्तां कै खुलण तै चान्दणा होवै सै;</para>
  <para style="q" vid="PSA 119:130">उसतै भोळे लोग समझ पाया करै सै।<verse eid="PSA 119:130" /></para>
  <para style="q">
    <verse number="131" style="v" sid="PSA 119:131" />मै मुँह खोल कै हांफण लाग्या,</para>
  <para style="q" vid="PSA 119:131">क्यूँके मै तेरे हुकमां का प्यासा था।<verse eid="PSA 119:131" /></para>
  <para style="q">
    <verse number="132" style="v" sid="PSA 119:132" />जिस तरियां तेरी रीत अपणे नाम के प्रेम राक्खण आळयां तै सै,</para>
  <para style="q" vid="PSA 119:132">उस्से तरियां मेरी ओड़ भी मुड़कै मेरै पै दया कर।<verse eid="PSA 119:132" /></para>
  <para style="q">
    <verse number="133" style="v" sid="PSA 119:133" />मेरे पैरां नै अपणे वचन के राह पै मजबूत कर,</para>
  <para style="q" vid="PSA 119:133">अर किस्से गलत बात नै मेरै पै राज ना करण दे।<verse eid="PSA 119:133" /></para>
  <para style="q">
    <verse number="134" style="v" sid="PSA 119:134" />मन्‍नै माणसां के अत्याचार तै छुड़ाले,</para>
  <para style="q" vid="PSA 119:134">फेर मै तेरे वचनां नै मान्‍नुगा।<verse eid="PSA 119:134" /></para>
  <para style="q">
    <verse number="135" style="v" sid="PSA 119:135" />अपणे दास पै अपणे मुँह का चान्दणा चमका दे,</para>
  <para style="q" vid="PSA 119:135">अर अपणी विधियाँ मन्‍नै सिखा।<verse eid="PSA 119:135" /></para>
  <para style="q">
    <verse number="136" style="v" sid="PSA 119:136" />मेरी आँखां तै आँसुआँ की धार बहन्दी रहवै सै,</para>
  <para style="q" vid="PSA 119:136">क्यूँके लोग तेरे नियम-कायदे नै न्ही मान्दे।</para>
  <para style="s" vid="PSA 119:136">नियम-कायदे का न्याय</para>
  <para style="d" vid="PSA 119:136">सांदे<verse eid="PSA 119:136" /></para>
  <para style="q">
    <verse number="137" style="v" sid="PSA 119:137" />हे यहोवा, तू धर्मी सै,</para>
  <para style="q" vid="PSA 119:137">अर तेरे नियम सीध्धे सै।<verse eid="PSA 119:137" /></para>
  <para style="q">
    <verse number="138" style="v" sid="PSA 119:138" />तन्‍नै अपणी चितौनियाँ ताहीं</para>
  <para style="q" vid="PSA 119:138">धर्म अर पूरी सच्‍चाई तै कही सै।<verse eid="PSA 119:138" /></para>
  <para style="q">
    <verse number="139" style="v" sid="PSA 119:139" />मै तेरी धुन म्ह भस्म होरया सूं,</para>
  <para style="q" vid="PSA 119:139">क्यूँके मेरे सताण आळे तेरे वचनां नै भूलगे सै।<verse eid="PSA 119:139" /></para>
  <para style="q">
    <verse number="140" style="v" sid="PSA 119:140" />तेरा वचन पूरी तरियां त्याया होया सै,</para>
  <para style="q" vid="PSA 119:140">इस करकै तेरा दास उसतै प्रेम राक्खै सै।<verse eid="PSA 119:140" /></para>
  <para style="q">
    <verse number="141" style="v" sid="PSA 119:141" />मै छोट्टा अर कुछ भी न्ही सूं,</para>
  <para style="q" vid="PSA 119:141">तोभी मै तेरे उपदेशां नै न्ही भूलदा।<verse eid="PSA 119:141" /></para>
  <para style="q">
    <verse number="142" style="v" sid="PSA 119:142" />तेरा धर्म सदा का धर्म सै,</para>
  <para style="q" vid="PSA 119:142">अर तेरे नियम-कायदे सच्‍चे सै।<verse eid="PSA 119:142" /></para>
  <para style="q">
    <verse number="143" style="v" sid="PSA 119:143" />मै संकट अर मुसीबत म्ह फस्या सूं,</para>
  <para style="q" vid="PSA 119:143">पर मै तेरे हुकमां तै सुखी सूं।<verse eid="PSA 119:143" /></para>
  <para style="q">
    <verse number="144" style="v" sid="PSA 119:144" />तेरी चितौनियाँ सदा धर्म की सै,</para>
  <para style="q" vid="PSA 119:144">तू मन्‍नै समझ दे के मै जिन्दा रहूँ।</para>
  <para style="s" vid="PSA 119:144">छुटकारै खात्तर प्रार्थना</para>
  <para style="d" vid="PSA 119:144">क़ाफ़<verse eid="PSA 119:144" /></para>
  <para style="q">
    <verse number="145" style="v" sid="PSA 119:145" />मन्‍नै पूरे मन तै प्रार्थना करी सै,</para>
  <para style="q" vid="PSA 119:145">हे यहोवा मेरी सुण ले!</para>
  <para style="q" vid="PSA 119:145">मै तेरी विधियाँ नै पकड़े रहूँगा।<verse eid="PSA 119:145" /></para>
  <para style="q">
    <verse number="146" style="v" sid="PSA 119:146" />मन्‍नै तेरे तै प्रार्थना करी सै तू मेरा उद्धार कर,</para>
  <para style="q" vid="PSA 119:146">अर मै तेरी चितौनियाँ नै मान्या करुँगा।<verse eid="PSA 119:146" /></para>
  <para style="q">
    <verse number="147" style="v" sid="PSA 119:147" />मन्‍नै सबेर होण तै पैहल्या मदद खात्तर दुहाई दी;</para>
  <para style="q" vid="PSA 119:147">मेरी आस तेरे वचनां पै थी।<verse eid="PSA 119:147" /></para>
  <para style="q">
    <verse number="148" style="v" sid="PSA 119:148" />मेरी आँख रात के एक-एक पहर तै पैहल्या खुलगी,</para>
  <para style="q" vid="PSA 119:148">ताके मै तेरे वचनां पै ध्यान करुँ।<verse eid="PSA 119:148" /></para>
  <para style="q">
    <verse number="149" style="v" sid="PSA 119:149" />अपणी करुणा कै मुताबिक मेरी सुण ले;</para>
  <para style="q" vid="PSA 119:149">हे यहोवा, अपणी रीति कै मुताबिक मन्‍नै जिन्दा कर।<verse eid="PSA 119:149" /></para>
  <para style="q">
    <verse number="150" style="v" sid="PSA 119:150" />जो गलत काम्मां की धुन म्ह सै, वो धोरै आ ग्ये सै;</para>
  <para style="q" vid="PSA 119:150">वे तेरे नियम-कायदे तै दूर सै।<verse eid="PSA 119:150" /></para>
  <para style="q">
    <verse number="151" style="v" sid="PSA 119:151" />हे यहोवा, तू धोरै सै,</para>
  <para style="q" vid="PSA 119:151">अर तेरे सारे हुक्म सच्‍चे सै।<verse eid="PSA 119:151" /></para>
  <para style="q">
    <verse number="152" style="v" sid="PSA 119:152" />घणे बखत तै मै तेरी चितौनियाँ नै जाणु सूं,</para>
  <para style="q" vid="PSA 119:152">के तन्‍नै उसकी नींव सदा खात्तर डाली सै।</para>
  <para style="s" vid="PSA 119:152">मदद खात्तर बिनती</para>
  <para style="d" vid="PSA 119:152">रेश<verse eid="PSA 119:152" /></para>
  <para style="q">
    <verse number="153" style="v" sid="PSA 119:153" />मेरा दुख देखकै मन्‍नै छुड़ाले,</para>
  <para style="q" vid="PSA 119:153">क्यूँके मै तेरे नियम-कायदे नै कदे न्ही भूल्या।<verse eid="PSA 119:153" /></para>
  <para style="q">
    <verse number="154" style="v" sid="PSA 119:154" />मेरा मुकद्दमा लड़, अर मन्‍नै छुड़ाले;</para>
  <para style="q" vid="PSA 119:154">अपणे वादे कै मुताबिक मन्‍नै जिन्दा कर।<verse eid="PSA 119:154" /></para>
  <para style="q">
    <verse number="155" style="v" sid="PSA 119:155" />दुष्टां नै उद्धार मिलणा मुश्किल सै,</para>
  <para style="q" vid="PSA 119:155">क्यूँके वे तेरी विधियाँ का ख्याल न्ही राखदे।<verse eid="PSA 119:155" /></para>
  <para style="q">
    <verse number="156" style="v" sid="PSA 119:156" />हे यहोवा, तेरी दया तो बड़ी सै;</para>
  <para style="q" vid="PSA 119:156">इस करकै अपणे नियमां कै मुताबिक मन्‍नै जिन्दा कर।<verse eid="PSA 119:156" /></para>
  <para style="q">
    <verse number="157" style="v" sid="PSA 119:157" />मेरा पिच्छा करण आळे अर मेरे सताण आळे घणे सै,</para>
  <para style="q" vid="PSA 119:157">पर मै तेरी चितौनियाँ तै न्ही हटया।<verse eid="PSA 119:157" /></para>
  <para style="q">
    <verse number="158" style="v" sid="PSA 119:158" />मै धोक्खेबाजां नै देखकै नफरत करुँ सूं,</para>
  <para style="q" vid="PSA 119:158">क्यूँके वे तेरे वचन नै न्ही मान्दे।<verse eid="PSA 119:158" /></para>
  <para style="q">
    <verse number="159" style="v" sid="PSA 119:159" />देख, मै तेरे नियमां तै किसा प्रेम राक्खूँ सूं!</para>
  <para style="q" vid="PSA 119:159">हे यहोवा, अपणी करुणा कै मुताबिक मन्‍नै जिन्दा कर।<verse eid="PSA 119:159" /></para>
  <para style="q">
    <verse number="160" style="v" sid="PSA 119:160" />तेरे सारे वचन सच्‍चे सै;</para>
  <para style="q" vid="PSA 119:160">अर तेरे हरेक धर्म के नियम सदा तक अटल सै।</para>
  <para style="s" vid="PSA 119:160">नियम-कायदे कै प्रति समर्पण</para>
  <para style="d" vid="PSA 119:160">शीन<verse eid="PSA 119:160" /></para>
  <para style="q">
    <verse number="161" style="v" sid="PSA 119:161" />हाकिम खामखां मेरै पाच्छै पड़े सै,</para>
  <para style="q" vid="PSA 119:161">पर मेरा दिल तेरे वचनां का भय मान्‍नै सै।<verse eid="PSA 119:161" /></para>
  <para style="q">
    <verse number="162" style="v" sid="PSA 119:162" />जिस तरियां कोए बड़ी लूट पा के खुश होवै सै,</para>
  <para style="q" vid="PSA 119:162">उस्से तरियां मै तेरे वचनां कै कारण खुश सूं।<verse eid="PSA 119:162" /></para>
  <para style="q">
    <verse number="163" style="v" sid="PSA 119:163" />झूठ तै तो मै बैर अर नफरत करुँ सूं,</para>
  <para style="q" vid="PSA 119:163">पर तेरे नियम-कायदे तै प्यार राक्खूँ सूं।<verse eid="PSA 119:163" /></para>
  <para style="q">
    <verse number="164" style="v" sid="PSA 119:164" />तेरे धर्म के नियमां खात्तर म्ह हर रोज</para>
  <para style="q" vid="PSA 119:164">सात बार तेरी स्तुति करुँ सूं।<verse eid="PSA 119:164" /></para>
  <para style="q">
    <verse number="165" style="v" sid="PSA 119:165" />तेरे नियम-कायदे तै प्रेम राक्खण आळयां नै घणी शान्ति होवै सै;</para>
  <para style="q" vid="PSA 119:165">अर उनकै कोए ठोक्‍कर न्ही लागदी।<verse eid="PSA 119:165" /></para>
  <para style="q">
    <verse number="166" style="v" sid="PSA 119:166" />हे यहोवा, मै तेरे तै उद्धार पाण की आस राक्खूँ सूं;</para>
  <para style="q" vid="PSA 119:166">अर तेरे हुकमां पै चाल्दा आया सूं।<verse eid="PSA 119:166" /></para>
  <para style="q">
    <verse number="167" style="v" sid="PSA 119:167" />मै तेरी चितौनियाँ नै जी तै मान्‍नु सूं,</para>
  <para style="q" vid="PSA 119:167">अर उसतै भोत प्रेम राखदा आया सूं।<verse eid="PSA 119:167" /></para>
  <para style="q">
    <verse number="168" style="v" sid="PSA 119:168" />मै तेरे उपदेशां अर चितौनियाँ नै मान्दा आया सूं,</para>
  <para style="q" vid="PSA 119:168">क्यूँके मेरा सारा चाल चलण तेरै स्याम्ही प्रगट सै।</para>
  <para style="s" vid="PSA 119:168">परमेसवर तै मदद पाण की लालसा</para>
  <para style="d" vid="PSA 119:168">ताव<verse eid="PSA 119:168" /></para>
  <para style="q">
    <verse number="169" style="v" sid="PSA 119:169" />हे यहोवा, मेरी दोहाई तेरे तक पोहचै;</para>
  <para style="q" vid="PSA 119:169">तू अपणे वचन कै मुताबिक मन्‍नै समझ दे।<verse eid="PSA 119:169" /></para>
  <para style="q">
    <verse number="170" style="v" sid="PSA 119:170" />मेरा गिड़गिड़ाणा तेरे तक पोहचै;</para>
  <para style="q" vid="PSA 119:170">तू अपणे वचन कै मुताबिक मन्‍नै छुड़ाले।<verse eid="PSA 119:170" /></para>
  <para style="q">
    <verse number="171" style="v" sid="PSA 119:171" />मेरे मुँह तै तेरी स्तुति लिक्ड़या करै,</para>
  <para style="q" vid="PSA 119:171">क्यूँके तू मन्‍नै अपणी विधि सिखावै सै।<verse eid="PSA 119:171" /></para>
  <para style="q">
    <verse number="172" style="v" sid="PSA 119:172" />मै तेरे वचन का गीत गाऊँगा,</para>
  <para style="q" vid="PSA 119:172">क्यूँके तेरे सारे हुकम धर्म के सै।<verse eid="PSA 119:172" /></para>
  <para style="q">
    <verse number="173" style="v" sid="PSA 119:173" />तेरा हाथ मेरी मदद करण नै त्यार रहवै सै,</para>
  <para style="q" vid="PSA 119:173">क्यूँके मन्‍नै तेरे उपदेशां ताहीं अपणाया सै।<verse eid="PSA 119:173" /></para>
  <para style="q">
    <verse number="174" style="v" sid="PSA 119:174" />हे यहोवा, मै तेरे तै उद्धार पाण की लालसा करुँ सूं,</para>
  <para style="q" vid="PSA 119:174">मै तेरे नियम-कायदे तै सुखी सूं।<verse eid="PSA 119:174" /></para>
  <para style="q">
    <verse number="175" style="v" sid="PSA 119:175" />मन्‍नै जिन्दा कर, अर मै तेरी स्तुति करुँगा,</para>
  <para style="q" vid="PSA 119:175">तेरे नियमां तै मेरी मदद हो<verse eid="PSA 119:175" /></para>
  <para style="q">
    <verse number="176" style="v" sid="PSA 119:176" />मै खोई होई भेड़ की तरियां भटक्या होया सूं;</para>
  <para style="q" vid="PSA 119:176">तू अपणे दास नै ढूँढ़ ले,</para>
  <para style="q" vid="PSA 119:176">क्यूँके मै तेरे हुकमां नै न्ही भूल्या।<verse eid="PSA 119:176" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" sid="PSA 120" />
  <para style="s">परमेसवर तै मदद खात्तर प्रार्थना</para>
  <para style="d">यात्रा का गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 120:1" />मुसीबत कै बखत म्ह मन्‍नै यहोवा ताहीं पुकारया,</para>
  <para style="q" vid="PSA 120:1">अर उसनै मेरी सुण ली।<verse eid="PSA 120:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 120:2" />हे यहोवा, झूठ बोल्‍लण आळे मुँह तै</para>
  <para style="q" vid="PSA 120:2">अर छळी जीभ तै मेरी हिफाजत कर।<verse eid="PSA 120:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 120:3" />हे छळी जीभ,</para>
  <para style="q" vid="PSA 120:3">तन्‍नै के मिलै? अर तेरी गैल और के घणा करया जावै?<verse eid="PSA 120:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 120:4" />वीर<note caller="+" style="f"><char style="fr" closed="false">120:4 </char><char style="fq" closed="false">वीर </char><char style="ft" closed="false">ताकतवर </char></note> के तिक्खे तीर</para>
  <para style="q" vid="PSA 120:4">अर झाऊ के अंगारे!<verse eid="PSA 120:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 120:5" />हाय-हाय इस करकै मन्‍नै मेशेक म्ह परदेशी होकै रहणा पड्या</para>
  <para style="q" vid="PSA 120:5">अर केदार<note caller="+" style="f"><char style="fr" closed="false">120:5 </char><char style="fq" closed="false">मेशेक म्ह परदेशी होकै रहणा पड्या अर केदार </char><char style="ft" closed="false">ये दोन्‍नु न्यारे-न्यारे देश थे जो एक-दुसरे तै घणी दूर थे इनकै माणस जालिम था</char></note> के तम्‍बुआं म्ह बसणा पड्या सै।<verse eid="PSA 120:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 120:6" />घणे बखत तै मन्‍नै मेल के दुश्मनां कै गैल बसणा पड्या सै।<verse eid="PSA 120:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 120:7" />मै तो मेल चाहूँ सूं;</para>
  <para style="q" vid="PSA 120:7">पर मेरे बोलदे ए, वो लड़णा चाहवै सै!<verse eid="PSA 120:7" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" sid="PSA 121" />
  <para style="s">परमेसवर म्हारा रक्षक</para>
  <para style="d">यात्रा का गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 121:1" />मै अपणी आँख पहाड़ां की ओड़ लगाऊँगा।</para>
  <para style="q" vid="PSA 121:1">मन्‍नै मदद कित्त तै मिलैगी?<verse eid="PSA 121:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 121:2" />मन्‍नै मदद यहोवा की ओड़ तै मिलै सै,</para>
  <para style="q" vid="PSA 121:2">जो अकास अर धरती नै बणाण आळा सै।<verse eid="PSA 121:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 121:3" />वो तेरे पैरां नै टळण न्ही देगा,</para>
  <para style="q" vid="PSA 121:3">तेरा रुखाळी कदे ना ऊँघैगा।<verse eid="PSA 121:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 121:4" />सुण, इस्राएल का रक्षक,</para>
  <para style="q" vid="PSA 121:4">ना ऊँघैगा अर ना सोवैगा।<verse eid="PSA 121:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 121:5" />यहोवा तेरा रुखाळी सै;</para>
  <para style="q" vid="PSA 121:5">यहोवा तेरी सोळी और तेरी आड़ सै।<verse eid="PSA 121:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 121:6" />ना तो दिन के घाम तै,</para>
  <para style="q" vid="PSA 121:6">अर ना रात की चाँदणी तै तेरा किमे नुकसान होवैगा।<verse eid="PSA 121:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 121:7" />यहोवा सारी मुसीबत तै तेरी हिफाजत करैगा:</para>
  <para style="q" vid="PSA 121:7">वो तेरी जान की हिफाजत करैगा।<verse eid="PSA 121:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 121:8" />यहोवा तेरे आणे जाणे म्ह</para>
  <para style="q" vid="PSA 121:8">तेरी रुखाळी इब तै लेकै सदा ताहीं करदा रहवैगा।<verse eid="PSA 121:8" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" sid="PSA 122" />
  <para style="s">यरुशलेम की शान्ति खात्तर प्रार्थना</para>
  <para style="d">दाऊद की यात्रा का गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 122:1" />जिब माणसां नै मेरे तै कह्या, “आओ हम यहोवा के घर नै चाल्‍लां”</para>
  <para style="q" vid="PSA 122:1">फेर मै घणाए खुश होया।<verse eid="PSA 122:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 122:2" />हे यरुशलेम, तेरे फाटकां कै भित्तर,</para>
  <para style="q" vid="PSA 122:2">हम खड़े होगे सां।<verse eid="PSA 122:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 122:3" />हे यरुशलेम, तू इस तरियां के नगर कै बराबर बण्या सै,</para>
  <para style="q" vid="PSA 122:3">जिसके घर एक-दुसरे तै मिले होए सै।<verse eid="PSA 122:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 122:4" />ओड़ै यहोवा के गोत्र-गोत्र के माणस यहोवा के नाम का धन्यवाद करण नै जावै सै;</para>
  <para style="q" vid="PSA 122:4">या इस्राएल खात्तर गवाई सै।<verse eid="PSA 122:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 122:5" />ओड़ै तो न्याय के सिंहासन,</para>
  <para style="q" vid="PSA 122:5">दाऊद के कुण्बे खात्तर धरे होए सै।<verse eid="PSA 122:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 122:6" />यरुशलेम की शान्ति का वरदान माँग्गो,</para>
  <para style="q" vid="PSA 122:6">तेरे प्रेमी सही-सलामत रहवै।<verse eid="PSA 122:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 122:7" />तेरे नगर की चारदीवारी<note caller="+" style="f"><char style="fr" closed="false">122:7 </char><char style="fq" closed="false">चारदीवारी </char><char style="ft" closed="false">शहरपनाह </char></note> कै भित्तर शान्ति,</para>
  <para style="q" vid="PSA 122:7">अर तेरे महल्‍लां म्ह सलामती होवै!<verse eid="PSA 122:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 122:8" />अपणे भाईयाँ अर साथियाँ कै कारण,</para>
  <para style="q" vid="PSA 122:8">मै कहूँगा के थारे म्ह शान्ति होवै!<verse eid="PSA 122:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 122:9" />अपणे परमेसवर यहोवा के घर कै कारण,</para>
  <para style="q" vid="PSA 122:9">मै तेरी भलाई नै टोहऊँगा<note caller="+" style="f"><char style="fr" closed="false">122:9 </char><char style="fq" closed="false">टोहऊँगा</char><char style="ft" closed="false">मै तेरी भलाई की ताहीं प्रार्थना करुँगा</char></note>।<verse eid="PSA 122:9" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" sid="PSA 123" />
  <para style="s">परमेसवर की दया खात्तर प्रार्थना</para>
  <para style="d">यात्रा का गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 123:1" />हे सुर्ग म्ह विराजमान</para>
  <para style="q" vid="PSA 123:1">मै अपणी आँख तेरी ओड़ लगाऊ सूं!<verse eid="PSA 123:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 123:2" />देख, जिस तरियां दास्सां की आँख अपणे मालिकां की हाथ की ओड़,</para>
  <para style="q" vid="PSA 123:2">जिस तरियां दासियाँ की आँख अपणी मालकिन के हाथ की ओड़ लाग्गी रहवै सै,</para>
  <para style="q" vid="PSA 123:2">उसे तरियां म्हारी आँख भी अपणे परमेसवर यहोवा की ओड़ उस बखत तक लाग्गी रहवैंगी,</para>
  <para style="q" vid="PSA 123:2">जिब ताहीं वो म्हारे पै दया ना करै।<verse eid="PSA 123:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 123:3" />म्हारे पै दया कर, हे यहोवा, म्हारे पै कृपा कर,</para>
  <para style="q" vid="PSA 123:3">क्यूँके हम बेजती तै भोत घणे भरगे सां।<verse eid="PSA 123:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 123:4" />म्हारा जीवन सुखी माणसां के मखौल तै,</para>
  <para style="q" vid="PSA 123:4">अर घमण्डियाँ की बेजती तै भोत-ए घणा भरग्या सै।<verse eid="PSA 123:4" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" sid="PSA 124" />
  <para style="s">परमेसवर अपणे लोग्गां का रक्षक</para>
  <para style="d">दाऊद की यात्रा का गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 124:1" />इस्राएल न्यू कहवै,</para>
  <para style="q" vid="PSA 124:1">के जै यहोवा म्हारी ओड़ ना होन्दा,<verse eid="PSA 124:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 124:2" />जै यहोवा उस बखत म्हारी ओड़ ना होन्दा</para>
  <para style="q" vid="PSA 124:2">जिब दुश्मनां नै म्हारै पै चढ़ाई करी,<verse eid="PSA 124:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 124:3" />वे तो हमनै उस्से बखत निगळ जान्दे,</para>
  <para style="q" vid="PSA 124:3">जिब उनका छो म्हारे पै भड़क्या था,<verse eid="PSA 124:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 124:4" />हम उस्से बखत पाणी म्ह डूब जान्दे</para>
  <para style="q" vid="PSA 124:4">अर धार मै बह जान्दे<verse eid="PSA 124:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 124:5" />उमड़ते पाणी म्ह हम उसे बखत बह जान्दे।<verse eid="PSA 124:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 124:6" />धन्य सै यहोवा,</para>
  <para style="q" vid="PSA 124:6">जिसनै म्हारे ताहीं उनके दान्दां तळै जाण न्ही दिया!<verse eid="PSA 124:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 124:7" />म्हारा जी पंछी की तरियां चिड़ीमार के जाळ तै छूट ग्या;</para>
  <para style="q" vid="PSA 124:7">जाळ पाट ग्या, हम बच लिकड़े।<verse eid="PSA 124:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 124:8" />यहोवा जो अकास अर धरती का बणाण आळा सै,</para>
  <para style="q" vid="PSA 124:8">म्हारी मदद उसे कै नाम तै होवै सै।<verse eid="PSA 124:8" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" sid="PSA 125" />
  <para style="s">परमेसवर अपणे लोग्गां की ताकत</para>
  <para style="d">दाऊद की यात्रा का गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 125:1" />जो यहोवा पै भरोस्सा राक्खैं सै,</para>
  <para style="q" vid="PSA 125:1">वो सिय्योन पर्वत की तरियां सै,</para>
  <para style="q" vid="PSA 125:1">जो टळदा न्ही, पर सदा बण्या रहवै सै।<verse eid="PSA 125:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 125:2" />जिस तरियां यरुशलेम के च्यांरु ओड़ पहाड़ सै,</para>
  <para style="q" vid="PSA 125:2">उस्से तरियां यहोवा अपणी प्रजा कै</para>
  <para style="q" vid="PSA 125:2">और इब तै लेकै सदा ताहीं बण्या रहवैगा।<verse eid="PSA 125:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 125:3" />क्यूँके दुष्टां का राजदण्ड धर्मियाँ कै हक पै बण्या ना रहवैगा,</para>
  <para style="q" vid="PSA 125:3">इसा ना हो के धर्मी अपणे हाथ कठोरता के काम्मां की ओड़ बढ़ावै।<verse eid="PSA 125:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 125:4" />हे यहोवा, भले माणसां का!</para>
  <para style="q" vid="PSA 125:4">अर साफ मन आळयां का भला कर<verse eid="PSA 125:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 125:5" />पर जो मुड़कै गलत राह मै चाल्‍लै सै,</para>
  <para style="q" vid="PSA 125:5">उननै यहोवा बुरे काम करणियां की गैल लिकाड़ देवैगा!</para>
  <para style="q" vid="PSA 125:5">इस्राएल नै शान्ति मिलै!<verse eid="PSA 125:5" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" sid="PSA 126" />
  <para style="s">सिय्योन की खुशी कै गैल वापसी</para>
  <para style="d">यात्रा का गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 126:1" />जिब यहोवा गुलाम्मी म्ह तै सिय्योन<note caller="+" style="f"><char style="fr" closed="false">126:1 </char><char style="fq" closed="false">सिय्योन </char><char style="ft" closed="false">इस्राएली लोग</char></note> नै छुड़ा ल्याया,</para>
  <para style="q" vid="PSA 126:1">फेर हम सपना देखण आळयां की तरियां होगे।<verse eid="PSA 126:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 126:2" />फेर हम खुशी तै हाँसण</para>
  <para style="q" vid="PSA 126:2">अर जयजयकार करण लाग्ये;</para>
  <para style="q" vid="PSA 126:2">फेर जात-जात कै बीच म्ह कह्या जावै था,</para>
  <para style="q" vid="PSA 126:2">“यहोवा नै, इनकै गैल बड़े-बड़े काम करै सै।”<verse eid="PSA 126:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 126:3" />यहोवा नै म्हारी गैल बड़े-बड़े काम करै सै;</para>
  <para style="q" vid="PSA 126:3">अर इसतै हम घणे खुश सां।<verse eid="PSA 126:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 126:4" />हे यहोवा, दक्षिण देश की पाणी की धारा की तरियां,</para>
  <para style="q" vid="PSA 126:4">म्हारे कैदियाँ नै उल्टा ले आ!<verse eid="PSA 126:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 126:5" />जो रोन्दे होए बोवै सै,</para>
  <para style="q" vid="PSA 126:5">वो जयजयकार करदे होये काटण पावैंगें।<verse eid="PSA 126:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 126:6" />चाहे बोण आळा बीज लेकै रोन्दा होया भी चल्या जावै,</para>
  <para style="q" vid="PSA 126:6">पर वो फेर फसल लिए होया जयजयकार करदा जरुर उलटा आवैगा।<verse eid="PSA 126:6" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" sid="PSA 127" />
  <para style="s">परमेसवर का आशीर्वाद</para>
  <para style="d">सुलैमान की यात्रा का गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 127:1" />जै घर नै यहोवा ना बणावै,</para>
  <para style="q" vid="PSA 127:1">तो उसके बणाण आळयां की मेहनत बेकार सै।</para>
  <para style="q" vid="PSA 127:1">जै नगर की रुखाळी यहोवा ना करै,</para>
  <para style="q" vid="PSA 127:1">तो रुखाळी करण आळे का जागणा बेकार सै।<verse eid="PSA 127:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 127:2" />थम जो सबेरै उठो सो अर देर करकै आराम करो सो</para>
  <para style="q" vid="PSA 127:2">अर कड़ी मेहनत भरी रोट्टी खाओ सो, या सब थारै खात्तर बेकार सै;</para>
  <para style="q" vid="PSA 127:2">क्यूँके यहोवा अपणे प्रेमियाँ नै न्यूए नींद<note caller="+" style="f"><char style="fr" closed="false">127:2 </char><char style="fq" closed="false">नींद </char><char style="ft" closed="false">वो अपणे प्यारे माणसां नै इस तरियां देवै सै जणु नींद म्ह सोवै सै</char></note> देवै सै।<verse eid="PSA 127:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 127:3" />देक्खो बच्‍चे यहोवा का दिया होया भाग<note caller="+" style="f"><char style="fr" closed="false">127:3 </char><char style="fq" closed="false">भाग </char><char style="ft" closed="false">विरासत</char></note> सै,</para>
  <para style="q" vid="PSA 127:3">गर्भ का फळ उसकी ओड़ तै ईनाम सै<note caller="+" style="f"><char style="fr" closed="false">127:3 </char><char style="fq" closed="false">ओड़ तै ईनाम सै </char><char style="ft" closed="false">सच्‍ची आशीष सै</char></note>।<verse eid="PSA 127:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 127:4" />जिस तरियां वीर कै हाथ म्ह तीर,</para>
  <para style="q" vid="PSA 127:4">उसे तरियां जवान्‍नी के बच्‍चे होवैं सै।<verse eid="PSA 127:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 127:5" />कितना धन्य सै वो माणस जिसनै अपणे तरकश ताहीं उनतै भर लिया हो!</para>
  <para style="q" vid="PSA 127:5">वो फाटक कै धोरै दुश्मनां तै बात करदे हानि कणतावैगा कोनी।<verse eid="PSA 127:5" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" sid="PSA 128" />
  <para style="s">परमेसवर का भय मान्‍नण तै आशीष</para>
  <para style="d">यात्रा का गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 128:1" />कितना धन्य सै हर एक वो माणस जो यहोवा का भय मान्‍नै सै,</para>
  <para style="q" vid="PSA 128:1">अर उसकी राह पै चाल्‍लै सै!<verse eid="PSA 128:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 128:2" />तू अपणी कमाई नै जरुर खाण पावैगा;</para>
  <para style="q" vid="PSA 128:2">तू धन्य होवैगा, अर तेरा भलाए होवैगा।<verse eid="PSA 128:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 128:3" />तेरे घर कै भित्तर तेरी घरआळी फळ देण आळी अंगूर की बेल की तरियां होवैगी;</para>
  <para style="q" vid="PSA 128:3">तेरी मेज कै च्यांरु ओड़ तेरे बाळक जैतून के पौध्यां की तरियां होवैगें।<verse eid="PSA 128:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 128:4" />सुण जो माणस यहोवा का भय मान्‍ने सै,</para>
  <para style="q" vid="PSA 128:4">वो इस्से तरियां आशीष पावैगा।<verse eid="PSA 128:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 128:5" />यहोवा थमनै सिय्योन तै आशीष देवै,</para>
  <para style="q" vid="PSA 128:5">अर तू जीवन भर यरुशलेम की सलामती देख्दा रहवै।<verse eid="PSA 128:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 128:6" />बलके तू अपणे दोत्ते पोत्यां नै भी देखण पावैगा।</para>
  <para style="q" vid="PSA 128:6">इस्राएल नै शान्ति मिलै।<verse eid="PSA 128:6" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" sid="PSA 129" />
  <para style="s">सिय्योन के दुश्मनां पै विजय का गीत</para>
  <para style="d">यात्रा का गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 129:1" />इस्राएल इब न्यू कहवै,</para>
  <para style="q" vid="PSA 129:1">“मेरे बचपन तै लोग मन्‍नै बार-बार क्ळेश देन्दे आए सै,<verse eid="PSA 129:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 129:2" />मेरे बचपन तै ए वो मन्‍नै बार-बार क्ळेश देन्दे तो आये सै,</para>
  <para style="q" vid="PSA 129:2">फेर वो कदे भी मेरे पै हावी न्ही होए।<verse eid="PSA 129:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 129:3" />हाळियाँ नै मेरी पीठ कै उप्पर हळ चलाया,</para>
  <para style="q" vid="PSA 129:3">अर लाम्बी-लाम्बी लकीर बणाई।”<verse eid="PSA 129:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 129:4" />यहोवा धर्मी सै;</para>
  <para style="q" vid="PSA 129:4">उसनै मेरे ताहीं दुष्टां की गुलाम्मी तै छुड़ाया;<note caller="+" style="f"><char style="fr" closed="false">129:4 </char><char style="fq" closed="false">उसनै मेरे ताहीं दुष्टां की गुलाम्मी तै छुड़ाया। </char><char style="ft" closed="false">उसनै दुष्टां का जाळ काट गेरया </char></note><verse eid="PSA 129:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 129:5" />जितने सिय्योन तै बैर राक्खै सै,</para>
  <para style="q" vid="PSA 129:5">वो सारे शर्मिन्दा हों, अर हार कै पाच्छै हट जावै!<verse eid="PSA 129:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 129:6" />वो छात पै घास की तरियां होवै सै,</para>
  <para style="q" vid="PSA 129:6">जो बढ़ण तै पैहल्या सुख जावै सै;<verse eid="PSA 129:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 129:7" />जिसतै काटण आळा अपणी मुट्ठी न्ही भरदा, अर</para>
  <para style="q" vid="PSA 129:7">ना पूळियाँ नै बांधण आळा अपणी आँगो भरण पावै सै,<verse eid="PSA 129:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 129:8" />अर ना आण-जाण आळेयो कहवै सै,</para>
  <para style="q" vid="PSA 129:8">“यहोवा की आशीष थारै पै होवै।</para>
  <para style="q" vid="PSA 129:8">हम थमनै यहोवा कै नाम तै आशीर्वाद देवां सां।”<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" sid="PSA 130" />
  <para style="s">करुणामय परमेसवर</para>
  <para style="d">यात्रा का गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 130:1" />हे यहोवा, मन्‍नै मुसीबतां म्ह ढुंघी जगहां म्ह तै तेरे ताहीं पुकारया सै।<verse eid="PSA 130:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 130:2" />हे प्रभु, मेरी सुण!</para>
  <para style="q" vid="PSA 130:2">तेरे कान मेरे गिड़गिड़ाण की ओड़ ध्यान तै लाग्गे रहवै!<verse eid="PSA 130:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 130:3" />हे यहोवा, जै तू अधर्म के काम्मां का लेखा ले,</para>
  <para style="q" vid="PSA 130:3">तो हे प्रभु कौण खड्या रह पावैगा?<verse eid="PSA 130:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 130:4" />पर तू माफ करण आळा सै?</para>
  <para style="q" vid="PSA 130:4">जिसतै तेरा भय मान्या जावै।<verse eid="PSA 130:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 130:5" />मै यहोवा की बाट देक्खूँ सूं, मै जी तै उसकी बाट देक्खूँ सूं,</para>
  <para style="q" vid="PSA 130:5">अर मेरी आस उसकै वचन पै सै;<verse eid="PSA 130:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 130:6" />रुखाळी करण आळे जितना सबेरै नै चाहवै सै, हाँ</para>
  <para style="q" vid="PSA 130:6">रुखाळी करण आळे जितना सबेरै नै चाहवै सै,</para>
  <para style="q" vid="PSA 130:6">उसतै भी घणा मै यहोवा नै अपणे जी तै चाहूँ सूं।<verse eid="PSA 130:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 130:7" />इस्राएल यहोवा पै आस लगाऐ रहवै!</para>
  <para style="q" vid="PSA 130:7">क्यूँके यहोवा करुणा करण आळा</para>
  <para style="q" vid="PSA 130:7">अर पूरा छुटकारा देण आळा सै।<verse eid="PSA 130:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 130:8" />इस्राएल नै उसके सारे अधर्म के काम्मां तै वोए छुड़ावैगा।<verse eid="PSA 130:8" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" sid="PSA 131" />
  <para style="s">परमेसवर म्ह बच्‍चे की तरियां भरोस्सा</para>
  <para style="d">दाऊद की यात्रा का गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 131:1" />हे यहोवा, ना तो मेरा मन मान-बड़ाई तै</para>
  <para style="q" vid="PSA 131:1">अर ना मेरी नजर घमण्ड तै भरी सै;</para>
  <para style="q" vid="PSA 131:1">अर जो बात बड़ी अर मेरै खात्तर घणी मुश्किल सै,</para>
  <para style="q" vid="PSA 131:1">उनतै मै काम न्ही राखदा।<verse eid="PSA 131:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 131:2" />पक्‍का मन्‍नै अपणे मन ताहीं शान्त अर चुप कर दिया सै,</para>
  <para style="q" vid="PSA 131:2">जिस तरियां दूध छुड़ाया होया बच्‍चा अपणी माँ की गोद्दी म्ह रहवै सै,</para>
  <para style="q" vid="PSA 131:2">उसे तरियां दूध छुड़ाये होये बाळक की ढाळ मेरा मन भी रहवै सै।<verse eid="PSA 131:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 131:3" />हे इस्राएल, इब तै लेकै सदा-सदा तक यहोवा ए पै आस लगाऐ रह।<verse eid="PSA 131:3" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" sid="PSA 132" />
  <para style="s">मन्दर खात्तर प्रार्थना</para>
  <para style="d">यात्रा का गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 132:1" />हे यहोवा, दाऊद खात्तर उसकी सारी बुरी हालत नै याद कर;<verse eid="PSA 132:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 132:2" />उसनै यहोवा तै कसम खाई,</para>
  <para style="q" vid="PSA 132:2">अर याकूब के सर्वशक्तिमान की मन्‍नत मान्‍नी सै,<verse eid="PSA 132:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 132:3" />उसनै कह्या “पक्‍का मै उस बखत तक अपणे घर म्ह न्ही जाऊँगा,</para>
  <para style="q" vid="PSA 132:3">अर ना अपणे पलंग पै चढूंगा;<verse eid="PSA 132:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 132:4" />ना अपणी आँख मै नींद,</para>
  <para style="q" vid="PSA 132:4">अर ना अपणी पलकां म्ह झपकी आण दियुँगा,<verse eid="PSA 132:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 132:5" />जिब ताहीं मै यहोवा खात्तर एक जगहां,</para>
  <para style="q" vid="PSA 132:5">यानिके याकूब के सर्वशक्तिमान खात्तर रहण की जगहां ना बणाऊँ।”<verse eid="PSA 132:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 132:6" />देक्खो, हमनै एप्राता म्ह इसकी चर्चा सुणी सै,</para>
  <para style="q" vid="PSA 132:6">हमनै इन ताहीं बण के खेत्तां म्ह पाया सै।<verse eid="PSA 132:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 132:7" />आओ, हम उसके रहण की जगहां म्ह जावै,</para>
  <para style="q" vid="PSA 132:7">हम उसके पैरां की चौकी कै आग्गै दण्डवत करां।<verse eid="PSA 132:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 132:8" />हे यहोवा उठकै अपणे अाराम की जगहां म्ह</para>
  <para style="q" vid="PSA 132:8">अपणे सामर्थ्य के सन्दूक समेत आ।<verse eid="PSA 132:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 132:9" />तेरे याजक धर्म के कपड़े पहरे रह,</para>
  <para style="q" vid="PSA 132:9">अर तेरे भगत माणस जयजयकार करै।<verse eid="PSA 132:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 132:10" />अपणे दास दाऊद खात्तर</para>
  <para style="q" vid="PSA 132:10">अपणे अभिषिक्त की प्रार्थना नै अनसुणी ना कर।<verse eid="PSA 132:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 132:11" />यहोवा नै दाऊद तै सच्‍ची कसम खाई सै अर वो उसतै न्ही मुकरैगा:</para>
  <para style="q" vid="PSA 132:11">“मै तेरी गद्दी पै तेरे एक खास बेट्टे नै बिठाऊँगा।<verse eid="PSA 132:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 132:12" />जै तेरे खानदान के लोग मेरे हुकमां नै मान्या करैं</para>
  <para style="q" vid="PSA 132:12">अर जो चितौनी मै उननै सिखाऊँगा, उसपै चाल्‍लै,</para>
  <para style="q" vid="PSA 132:12">तो उनके खानदान के लोग भी तेरी गद्दी पै युग-युग बैठदे रहवैगें।”<verse eid="PSA 132:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 132:13" />क्यूँके यहोवा नै सिय्योन ताहीं चुण्या सै,</para>
  <para style="q" vid="PSA 132:13">अर उसनै अपणे रहण खात्तर चाह्या सै।<verse eid="PSA 132:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 132:14" />“या तो युग-युग खात्तर मेरे अाराम की जगहां सै;</para>
  <para style="q" vid="PSA 132:14">आड़ै मै रहूँगा, क्यूँके मन्‍नै इस ताहीं चाह्या सै।<verse eid="PSA 132:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 132:15" />मै इस म्ह खाण-पीण की चिज्जां पै घणी आशीष दियुँगा;</para>
  <para style="q" vid="PSA 132:15">अर इसके भूख्यां नै रोट्टी तै छिकाऊँगा।<verse eid="PSA 132:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 132:16" />इसके याजकां नै मै उद्धार के कपड़े पिराऊँगा,</para>
  <para style="q" vid="PSA 132:16">अर इसके भगत माणस ऊँच्‍ची आवाज म्ह जयजयकार करैगें।<verse eid="PSA 132:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 132:17" />ओड़ै मै दाऊद की पीढियाँ नै महान राजा बणा दियुँगा</para>
  <para style="q" vid="PSA 132:17">अर याड़ै मै चुणे होया के राज्य की रुखाळी करुँगा;<note caller="+" style="f"><char style="fr" closed="false">132:17 </char><char style="fq" closed="false">ओड़ै मै दाऊद की पीढियाँ नै महान राजा बणा दियुँगा अर याड़ै मै चुणे होया के राज्य की रुखाळी करुँगा, </char><char style="ft" closed="false">ओड़ै मै दाऊद का एक सींग उगाऊँगा, मन्‍नै अपणे अभिषिक्त खात्तर एक दीवा बणा राख्या सै। </char></note><verse eid="PSA 132:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 132:18" />मै उसके दुश्मनां नै शर्मिन्दा कर दियुँगा,</para>
  <para style="q" vid="PSA 132:18">पर उसका राज्य बण्या रहवैगा।”<note caller="+" style="f"><char style="fr" closed="false">132:18 </char><char style="fq" closed="false">मै उसके दुश्मनां नै शर्मिन्दा कर दियुँगा, पर उसका राज्य बण्या रहवैगा </char><char style="ft" closed="false">मै उसके दुश्मनां नै तो बेजती के लत्ते पिराऊँगा, पर उसकै सिर पै उसका मुकट शोभायमान रहवैगा </char></note><verse eid="PSA 132:18" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" sid="PSA 133" />
  <para style="s">परमेसवर के लोग्गां की एकता</para>
  <para style="d">दाऊद की यात्रा का गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 133:1" />देक्खो, या कितनी भली अर मनभावणी बात सै</para>
  <para style="q" vid="PSA 133:1">के भाई लोग आप्पस मै मिलै रहवै।<verse eid="PSA 133:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 133:2" />यो तो उस खास तेल की तरियां सै,</para>
  <para style="q" vid="PSA 133:2">जो हारुन कै सिर पै गेरया गया था,</para>
  <para style="q" vid="PSA 133:2">अर उसकी डाढी पै तै बहकै,</para>
  <para style="q" vid="PSA 133:2">उसके कपड़े की कूण तक पोहच ग्या।<verse eid="PSA 133:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 133:3" />वो हेर्मोन पहाड़ी की उस ओस की तरियां सै,</para>
  <para style="q" vid="PSA 133:3">जो सिय्योन कै पहाड़ां पै गिरै सै!</para>
  <para style="q" vid="PSA 133:3">यहोवा नै तो वाए सदा के जीवन की आशीष ठहराई सै।<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" sid="PSA 134" />
  <para style="s">स्तुति करण का आह्वान</para>
  <para style="d">यात्रा का गीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 134:1" />हे यहोवा के सारे सेवकों, सुणो,</para>
  <para style="q" vid="PSA 134:1">थम जो रात-रात भर यहोवा कै भवन म्ह खड़े रहों सो,</para>
  <para style="q" vid="PSA 134:1">यहोवा नै धन्य कहो।<verse eid="PSA 134:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 134:2" />अपणे हाथ पवित्र स्‍थान म्ह ठाकै,</para>
  <para style="q" vid="PSA 134:2">यहोवा नै धन्य कहो।<verse eid="PSA 134:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 134:3" />यहोवा जो अकास अर धरती नै बणाण आळा सै,</para>
  <para style="q" vid="PSA 134:3">वो सिय्योन तै थमनै आशीष देवै।<verse eid="PSA 134:3" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" sid="PSA 135" />
  <para style="s">यहोवा महान सै</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 135:1" />यहोवा की स्तुति करो,</para>
  <para style="q" vid="PSA 135:1">यहोवा के नाम की स्तुति करो,</para>
  <para style="q" vid="PSA 135:1">हे यहोवा के सेवकों थम भी उसकी स्तुति करो,<verse eid="PSA 135:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 135:2" />थम जो यहोवा के भवन म्ह,</para>
  <para style="q" vid="PSA 135:2">मतलब म्हारे परमेसवर के घर कै आँगणां म्ह खड़े रहो सो।<verse eid="PSA 135:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 135:3" />यहोवा की स्तुति करो, क्यूँके यहोवा भला सै;</para>
  <para style="q" vid="PSA 135:3">उसकै नाम का भजन गाओ, क्यूँके यो मनभावणा सै।<verse eid="PSA 135:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 135:4" />यहोवा नै तो अपणे खात्तर याकूब ताहीं चुण्या सै,</para>
  <para style="q" vid="PSA 135:4">यानिके इस्राएल ताहीं अपणा खास धन होण खात्तर चुण्या सै।<verse eid="PSA 135:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 135:5" />मै तो जाणु सूं के म्हारा प्रभु यहोवा महान सै,</para>
  <para style="q" vid="PSA 135:5">म्हारा प्रभु सारे देवत्यां तै ऊँच्‍चा सै।<verse eid="PSA 135:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 135:6" />जो किमे यहोवा नै चाह्या</para>
  <para style="q" vid="PSA 135:6">वोए उसनै अकास अर धरती अर समुन्दर</para>
  <para style="q" vid="PSA 135:6">अर सारी ढुंघी जगहां म्ह करया सै।<verse eid="PSA 135:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 135:7" />वो धरती के कुणे म्ह तै धुन्ध ठावै सै,</para>
  <para style="q" vid="PSA 135:7">अर बारिस खात्तर बिजळी नै बणावै सै,</para>
  <para style="q" vid="PSA 135:7">अर हवा नै अपणे भण्डार म्ह तै काढै सै।<verse eid="PSA 135:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 135:8" />उसनै मिस्र देश म्ह के माणस के पशु,</para>
  <para style="q" vid="PSA 135:8">सारया के जेठ्ठे ताहीं मार गेरया!<verse eid="PSA 135:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 135:9" />हे मिस्र, यहोवा नै तेरे बीच म्ह फिरौन</para>
  <para style="q" vid="PSA 135:9">अर उसके सारे मुलाजिमां कै बीच म्ह चिन्ह अर चमत्कार करे।<verse eid="PSA 135:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 135:10" />उसनै घणी जात्तां ताहीं नाश करया,</para>
  <para style="q" vid="PSA 135:10">अर सामर्थी राजायां ताहीं भी,<verse eid="PSA 135:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 135:11" />यानिके, एमोरियां के राजा सीहोन ताहीं,</para>
  <para style="q" vid="PSA 135:11">अर बाशान के राजा ओग ताहीं,</para>
  <para style="q" vid="PSA 135:11">अर कनान के सारे राजां का भी नाश करया;<verse eid="PSA 135:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 135:12" />अर उनके देश नै बाट कै,</para>
  <para style="q" vid="PSA 135:12">अपणी प्रजा इस्राएल का भाग होण खात्तर दे दिया।<verse eid="PSA 135:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 135:13" />हे यहोवा, तेरा नाम सदा खात्तर मजबूत बण्या सै,</para>
  <para style="q" vid="PSA 135:13">हे यहोवा जिस नाम तै तू याद होवै सै,</para>
  <para style="q" vid="PSA 135:13">वो पीढ़ी-पीढ़ी बण्या रहवैगा।<verse eid="PSA 135:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 135:14" />यहोवा तो अपणी प्रजा का न्याय चुकावैगा,</para>
  <para style="q" vid="PSA 135:14">अर अपणे दास्सां की हालत देखकै तरस खावैगा।<verse eid="PSA 135:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 135:15" />गैरजात्तां की मूर्ति सोन्‍ना-चाँदी ए सै,</para>
  <para style="q" vid="PSA 135:15">वे माणसां के हाथ तै बणाई होई सै।<verse eid="PSA 135:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 135:16" />उनका मुँह तो होवै सै, पर वो बोल न्ही सकदी,</para>
  <para style="q" vid="PSA 135:16">उनकै आँख तो होवै सै, पर वो देख न्ही सकदी,<verse eid="PSA 135:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 135:17" />उनकै कान तो होवै सै, पर वो सुण न्ही सकदी,</para>
  <para style="q" vid="PSA 135:17">ना किमे उन म्ह साँस चाल्‍लै सै।<verse eid="PSA 135:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 135:18" />जिस तरियां की वो सै उसे तरियां के उनके बणाण आळे भी सै;</para>
  <para style="q" vid="PSA 135:18">अर उनपै सारे भरोस्सा राक्खण आळे भी उसे तरियां के हो जावैंगे!<verse eid="PSA 135:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 135:19" />हे इस्राएल के घरान्‍ने, यहोवा नै धन्य कह!</para>
  <para style="q" vid="PSA 135:19">हे हारुन के कुण्बे यहोवा नै धन्य कह!<verse eid="PSA 135:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 135:20" />हे लेवी के कुण्बे, यहोवा नै धन्य कह!</para>
  <para style="q" vid="PSA 135:20">हे यहोवा तै डरण आळेयो, यहोवा नै धन्य कहो!<verse eid="PSA 135:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 135:21" />यहोवा जो यरुशलेम म्ह रहवै सै,</para>
  <para style="q" vid="PSA 135:21">उस ताहीं सिय्योन म्ह धन्य कह्या जावै!</para>
  <para style="q" vid="PSA 135:21">यहोवा की स्तुति करो!<verse eid="PSA 135:21" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" sid="PSA 136" />
  <para style="s">परमेसवर की करुणा सदा की सै</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 136:1" />यहोवा का धन्यवाद करो,</para>
  <para style="q" vid="PSA 136:1">क्यूँके वो भला सै,</para>
  <para style="q" vid="PSA 136:1">अर उसकी करुणा सदा की सै।<verse eid="PSA 136:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 136:2" />जो ईश्‍वरां का परमेसवर सै, उसका धन्यवाद करो,</para>
  <para style="q" vid="PSA 136:2">उसकी करुणा सदा की सै।<verse eid="PSA 136:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 136:3" />जो प्रभुआं का प्रभु सै, उसका धन्यवाद करो,</para>
  <para style="q" vid="PSA 136:3">उसकी करुणा सदा की सै।<verse eid="PSA 136:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 136:4" />उसनै छोड़कै कोए बड़े-बड़े अचम्भे के काम न्ही करदा,</para>
  <para style="q" vid="PSA 136:4">उसकी करुणा सदा की सै।<verse eid="PSA 136:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 136:5" />उसनै अपणी समझ तै अकास बणाया,</para>
  <para style="q" vid="PSA 136:5">उसकी करुणा सदा की सै।<verse eid="PSA 136:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 136:6" />उसनै धरती ताहीं पाणी कै उप्पर फैलाया सै,</para>
  <para style="q" vid="PSA 136:6">उसकी करुणा सदा की सै।<verse eid="PSA 136:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 136:7" />उसनै बड़ी-बड़ी ज्योतियाँ बणाई,</para>
  <para style="q" vid="PSA 136:7">उसकी करुणा सदा की सै।<verse eid="PSA 136:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 136:8" />दिन पै राज करण खात्तर सूरज बणाया,</para>
  <para style="q" vid="PSA 136:8">उसकी करुणा सदा की सै।<verse eid="PSA 136:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 136:9" />अर रात पै राज करण खात्तर चाँद अर तारयां ताहीं बणाया,</para>
  <para style="q" vid="PSA 136:9">उसकी करुणा सदा की सै।<verse eid="PSA 136:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 136:10" />उसनै मिस्र देश म्ह जेठ्यां ताहीं मारया,</para>
  <para style="q" vid="PSA 136:10">उसकी करुणा सदा की सै।<verse eid="PSA 136:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 136:11" />उनकै बीच म्ह तै इस्राएलियाँ ताहीं लिकाड्या,</para>
  <para style="q" vid="PSA 136:11">उसकी करुणा सदा की सै।<verse eid="PSA 136:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 136:12" />ताकतवर हाथ अर बढ़ाई होई भुजा तै लिकाड़ ले आया,</para>
  <para style="q" vid="PSA 136:12">उसकी करुणा सदा की सै।<verse eid="PSA 136:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 136:13" />उसनै लाल समुन्दर के दो भाग कर दिए,</para>
  <para style="q" vid="PSA 136:13">उसकी करुणा सदा की सै।<verse eid="PSA 136:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 136:14" />अर इस्राएल ताहीं उसकै बीच तै पार कर दिया,</para>
  <para style="q" vid="PSA 136:14">उसकी करुणा सदा की सै;<verse eid="PSA 136:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 136:15" />अर फिरौन ताहीं सेना समेत लाल समुन्दर म्ह गेर दिया,</para>
  <para style="q" vid="PSA 136:15">उसकी करुणा सदा की सै।<verse eid="PSA 136:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 136:16" />वो अपणी प्रजा नै जंगळ म्ह ले चाल्या,</para>
  <para style="q" vid="PSA 136:16">उसकी करुणा सदा की सै।<verse eid="PSA 136:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 136:17" />उसनै बड़े-बड़े राजा मारे,</para>
  <para style="q" vid="PSA 136:17">उसकी करुणा सदा की सै।<verse eid="PSA 136:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 136:18" />उसनै सारे ताकतवर राजा भी मारे,</para>
  <para style="q" vid="PSA 136:18">उसकी करुणा सदा की सै;<verse eid="PSA 136:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 136:19" />एमोरियां के राजा सीहोन ताहीं,</para>
  <para style="q" vid="PSA 136:19">उसकी करुणा सदा की सै;<verse eid="PSA 136:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 136:20" />अर बाशान के राजा ओग ताहीं मारया,</para>
  <para style="q" vid="PSA 136:20">उसकी करुणा सदा की सै।<verse eid="PSA 136:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 136:21" />अर उनके देश का भाग होण खात्तर,</para>
  <para style="q" vid="PSA 136:21">उसकी करुणा सदा की सै;<verse eid="PSA 136:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 136:22" />अपणे दास इस्राएलियाँ का भाग होण खात्तर दे दिया,</para>
  <para style="q" vid="PSA 136:22">उसकी करुणा सदा की सै।<verse eid="PSA 136:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 136:23" />उसनै म्हारी बुरी हालत म्ह म्हारी सुधि ली,</para>
  <para style="q" vid="PSA 136:23">उसकी करुणा सदा की सै;<verse eid="PSA 136:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 136:24" />अर म्हारे ताहीं दुश्मनां तै भी छुड़ाया सै,</para>
  <para style="q" vid="PSA 136:24">उसकी करुणा सदा की सै,<verse eid="PSA 136:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 136:25" />वो सारे प्राणियाँ नै खाण नै देवै सै,</para>
  <para style="q" vid="PSA 136:25">उसकी करुणा सदा की सै।<verse eid="PSA 136:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 136:26" />सुर्ग के परमेसवर का धन्यवाद करो,</para>
  <para style="q" vid="PSA 136:26">उसकी करुणा सदा की सै।<verse eid="PSA 136:26" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" sid="PSA 137" />
  <para style="s">गुलामी म्ह इस्राएल का विलापगीत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 137:1" />बाबेल की नदियाँ कै किनारे हम लोग बैठगे,</para>
  <para style="q" vid="PSA 137:1">अर सिय्योन नै याद करकै रो पड़े!<verse eid="PSA 137:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 137:2" />उसके बीच के मजनू दरखतां पै</para>
  <para style="q" vid="PSA 137:2">हमनै अपणी सारी वीणा ताहीं टाँग दिया;<verse eid="PSA 137:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 137:3" />क्यूँके जो हमनै गुलाम बणाकै लेगे थे,</para>
  <para style="q" vid="PSA 137:3">उननै ओड़ै म्हारे तै गीत गुवाणा चाह्या,</para>
  <para style="q" vid="PSA 137:3">अर म्हारे रुआण आळयां नै म्हारे तै खुशी चाहकै कह्या,</para>
  <para style="q" vid="PSA 137:3">“सिय्योन कै गीतां म्ह तै म्हारे खात्तर गीत गाओ।”<verse eid="PSA 137:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 137:4" />हम यहोवा के गीत नै,</para>
  <para style="q" vid="PSA 137:4">पराए देश मै किस तरियां गांवा?<verse eid="PSA 137:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 137:5" />हे यरुशलेम, जै मै तन्‍नै भूल ज्याऊँ,</para>
  <para style="q" vid="PSA 137:5">मै अपणे सोळे हाथ तै वीणा फेर दुबारा न्ही पाऊँगा!<note caller="+" style="f"><char style="fr" closed="false">137:5 </char><char style="fq" closed="false">मै अपणे सोळे हाथ तै वीणा फेर दुबारा न्ही पाऊँगा। </char><char style="ft" closed="false">तो मेरा सोळा हाथ सुख जावै। </char></note><verse eid="PSA 137:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 137:6" />जै मै तन्‍नै याद ना राक्खूँ,</para>
  <para style="q" vid="PSA 137:6">जै मै यरुशलेम नै,</para>
  <para style="q" vid="PSA 137:6">सारी खुशियाँ तै आच्छी ना जाणु,</para>
  <para style="q" vid="PSA 137:6">तो मेरी जीभ ताळुवै तै चिपक ज्या<note caller="+" style="f"><char style="fr" closed="false">137:6 </char><char style="fq" closed="false">मेरी जीभ ताळुवै तै चिपक ज्या </char><char style="ft" closed="false">मै दोबारा न्ही गाणा गा पाऊँगा</char></note>!<verse eid="PSA 137:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 137:7" />हे यहोवा यरुशलेम के गिराए जाण के दिन नै एदोमियां कै खिलाफ याद कर</para>
  <para style="q" vid="PSA 137:7">के वे किस तरियां कहवै थे, “ढाओ! उसनै नींव तै गेर द्यो।”<verse eid="PSA 137:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 137:8" />हे बाबेल, तू जो उजड़ण आळी सै,</para>
  <para style="q" vid="PSA 137:8">कितना धन्य होवैगा वो, जो तेरे तै इसा बरताव करैगा</para>
  <para style="q" vid="PSA 137:8">जिसा तन्‍नै म्हारे तै करया सै!<verse eid="PSA 137:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 137:9" />कितना धन्य होवैगा वो, जो तेरे बाळकां नै पकड़कै,</para>
  <para style="q" vid="PSA 137:9">चट्टान पै पटक देगा!<verse eid="PSA 137:9" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" sid="PSA 138" />
  <para style="s">परमेसवर की कृपा खात्तर धन्यवाद</para>
  <para style="d">दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 138:1" />मै पूरे मन तै तेरा धन्यवाद करुँगा;</para>
  <para style="q" vid="PSA 138:1">देवत्यां कै स्याम्ही मै तेरा भजन गाऊँगा।<verse eid="PSA 138:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 138:2" />मै तेरे पवित्र मन्दर की ओड़ झुककै दण्डवत करुँगा,</para>
  <para style="q" vid="PSA 138:2">अर तेरी करुणा अर सच्‍चाई कै कारण तेरे नाम का धन्यवाद करुँगा;</para>
  <para style="q" vid="PSA 138:2">क्यूँके तन्‍नै अपणे वचन ताहीं, अपणे नाम अर हुकम तै सबतै ऊँच्‍चा करया सै।<note caller="+" style="f"><char style="fr" closed="false">138:2 </char><char style="fq" closed="false">क्यूँके तन्‍नै अपणे वचन ताहीं, अपणे नाम अर हुकम तै सबतै ऊँच्‍चा करया सै। </char><char style="ft" closed="false">क्यूँके तन्‍नै अपणे वचन ताहीं अपणे बड़े नाम ताहीं सबतै घणा खास जाण्या सै। </char></note><verse eid="PSA 138:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 138:3" />जिस दिन मन्‍नै पुकारया, उसे दिन तन्‍नै मेरी सुण ली,</para>
  <para style="q" vid="PSA 138:3">अर तन्‍नै ताकत देकै मेरी हिम्मत बन्‍धाई।<verse eid="PSA 138:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 138:4" />हे यहोवा, धरती के सारे राजा तेरा धन्यवाद करैगें,</para>
  <para style="q" vid="PSA 138:4">क्यूँके उननै तेरे वचन सुणे सै;<verse eid="PSA 138:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 138:5" />अर वो यहोवा की चाल कै बारै म्ह गावैगें,</para>
  <para style="q" vid="PSA 138:5">क्यूँके यहोवा की महिमा बड़ी सै।<verse eid="PSA 138:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 138:6" />यहोवा महान सै, फेर भी वो नरम माणसां की ओड़ निगांह करै सै;</para>
  <para style="q" vid="PSA 138:6">पर घमण्डी नै दूर तै ए पिच्छाणै सै।<verse eid="PSA 138:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 138:7" />चाहे मै मुसीबत कै बीच म्ह चाल्‍लूँ, फेर भी तू मन्‍नै सही-सलामत राक्खैगा<note caller="+" style="f"><char style="fr" closed="false">138:7 </char><char style="fq" closed="false">सलामत राक्खैगा </char><char style="ft" closed="false">दुबारा जिन्दा करणा </char></note>,</para>
  <para style="q" vid="PSA 138:7">तू मेरे छो तै भरे होये दुश्मनां कै खिलाफ हाथ बढ़ावैगा,</para>
  <para style="q" vid="PSA 138:7">अर अपणे सोळे हाथ तै मेरा उद्धार करैगा।<verse eid="PSA 138:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 138:8" />यहोवा मेरै खात्तर सब कुछ पूरा करैगा;</para>
  <para style="q" vid="PSA 138:8">हे यहोवा तेरी करुणा सदा की सै।</para>
  <para style="q" vid="PSA 138:8">तू अपणे हाथ्थां के काम्मां नै ना छोड़।<verse eid="PSA 138:8" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" sid="PSA 139" />
  <para style="s">परमेसवर का सिध्द ज्ञान</para>
  <para style="d">प्रधान बजाण आळे खात्तर दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 139:1" />हे यहोवा तन्‍नै मेरे ताहीं जाँचकै जाण लिया सै।<verse eid="PSA 139:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 139:2" />तू मेरा उठणा-बैठणा जाणै सै;</para>
  <para style="q" vid="PSA 139:2">अर मेरे विचारां नै दूरे तै समझ लेवै सै।<verse eid="PSA 139:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 139:3" />मेरे चाल्‍लण अर लेट्टण की तू आच्छी ढाळ छाणबीन करै सै,</para>
  <para style="q" vid="PSA 139:3">अर मेरी पूरी चाल चलण का भेद तू जाणै सै।<verse eid="PSA 139:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 139:4" />हे यहोवा, मेरे मुँह म्ह इसी कोए बात न्ही</para>
  <para style="q" vid="PSA 139:4">जिसनै तू पूरी तरियां तै ना जाणदा हो।<verse eid="PSA 139:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 139:5" />तन्‍नै मेरे ताहीं आग्गै-पाच्छै तै घेर राख्या सै,</para>
  <para style="q" vid="PSA 139:5">अर अपणा हाथ मेरे पै राक्खे रहवै सै।<verse eid="PSA 139:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 139:6" />यो ज्ञान मेरै खात्तर भोत मुश्किल सै;</para>
  <para style="q" vid="PSA 139:6">यो गम्भीर अर समझ तै बाहर सै।<verse eid="PSA 139:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 139:7" />मै तेरी आत्मा तै भाजकै कित्त जाऊँ?</para>
  <para style="q" vid="PSA 139:7">या तेरै स्याम्ही तै कित्त भाज्जूँ?<verse eid="PSA 139:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 139:8" />जै मै अकास पै चढूँ, तो तू ओड़ै सै!</para>
  <para style="q" vid="PSA 139:8">जै मै अपणा बिछोणा अधोलोक म्ह बिछाऊँ तो ओड़ै भी तू सै!<verse eid="PSA 139:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 139:9" />जै मै सबेरै की किरणा पै चढ़कै समुन्दर कै पार जा बसूं,<verse eid="PSA 139:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 139:10" />तो ओड़ै भी तू अपणे हाथ तै मेरी अगुवाई करैगा।</para>
  <para style="q" vid="PSA 139:10">अर अपणे सोळे हाथ तै मन्‍नै पकड़े रहवैगा।<verse eid="PSA 139:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 139:11" />जै मै कहूँ के अँधेरे म्ह तो मै छिप ज्याऊँगा,</para>
  <para style="q" vid="PSA 139:11">अर मेरै चारु ओड़ का चान्दणा रात का अँधेरा हो ज्यागा,<verse eid="PSA 139:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 139:12" />फेर भी अँधेरा मन्‍नै तेरे तै ना छिपावैगा रात तो दिन की तरियां चान्दणा देवैगी;</para>
  <para style="q" vid="PSA 139:12">क्यूँके तेरै खात्तर अँधेरा अर चान्दणा दोनु एक जिसे सै।<verse eid="PSA 139:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 139:13" />तन्‍नै मेरे अन्दरूनी अंगां ताहीं बणाया सै;</para>
  <para style="q" vid="PSA 139:13">तन्‍नै मेरे ताहीं माँ की कोख म्ह बणाया।<verse eid="PSA 139:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 139:14" />मै तेरा धन्यवाद करुँगा, इस करकै के मै खतरनाक अर बेमिसाल तरीके तै बणाया गया सूं।</para>
  <para style="q" vid="PSA 139:14">तेरे काम तो अचम्भे के सै,</para>
  <para style="q" vid="PSA 139:14">म्ह इननै आच्छी तरियां तै जाणु सूं।<verse eid="PSA 139:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 139:15" />जिब मै गुप्त जगहां म्ह बणाया जान्दा,</para>
  <para style="q" vid="PSA 139:15">अर धरती के निचली जगहां म्ह बणाया जाऊँ था,</para>
  <para style="q" vid="PSA 139:15">जद मेरी देह तेरे तै छिपी ना थी।<verse eid="PSA 139:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 139:16" />तेरी आँखां नै मेरे बिना आकार के तत्व ताहीं देख्या;</para>
  <para style="q" vid="PSA 139:16">अर मेरे सारे अंग जो दिन बै दिन बणदे जाया करदे वे बणन तै पैहल्या</para>
  <para style="q" vid="PSA 139:16">तेरी किताब म्ह लिखे होये थे।<verse eid="PSA 139:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 139:17" />मेरै खात्तर तो हे परमेसवर, तेरे विचार भोत अनमोल सै!</para>
  <para style="q" vid="PSA 139:17">उनकी गिणती का जोड़ कितना बड़ा सै!<verse eid="PSA 139:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 139:18" />जै मै उननै गिणदा तो वो रेत कै कणां तै भी घणे होन्दे।</para>
  <para style="q" vid="PSA 139:18">जिब मै जाग जाऊँ सूं, तब भी तेरे गैल रहूँ सूं।<verse eid="PSA 139:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 139:19" />हे यहोवा जरुर तू दुष्ट नै घात करैगा!</para>
  <para style="q" vid="PSA 139:19">हे जुल्मियों<note caller="+" style="f"><char style="fr" closed="false">139:19 </char><char style="fq" closed="false">जुल्मियों </char><char style="ft" closed="false">खून के प्यास्से </char></note>, मेरे तै दूर हो जाओ।<verse eid="PSA 139:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 139:20" />क्यूँके वो तेरे खिलाफ विद्रोह करकै अर छळ के काम करै सै;</para>
  <para style="q" vid="PSA 139:20">तेरे दुश्मन तेरा नाम झूठ्ठी बात पै लेवै सै।<verse eid="PSA 139:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 139:21" />हे यहोवा, के मै तेरे बैरियाँ तै बैर ना राक्खूँ,</para>
  <para style="q" vid="PSA 139:21">अर तेरे बिरोधियाँ तै नफरत ना करुँ?<verse eid="PSA 139:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 139:22" />हाँ, मै उनतै पूरा बैर राक्खूँ सूं;</para>
  <para style="q" vid="PSA 139:22">मै उननै अपणा दुश्मन समझू सूं।<verse eid="PSA 139:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 139:23" />हे यहोवा, मन्‍नै आच्छी रीति तै जाण ले!</para>
  <para style="q" vid="PSA 139:23">अर मन्‍नै परख कै मेरी चिन्ता नै जाण ले!<verse eid="PSA 139:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 139:24" />अर देख के मेरे म्ह कोए बुरी चाल सै के न्ही,</para>
  <para style="q" vid="PSA 139:24">अर हमेशा की जिन्दगी की राह म्ह मेरी अगुवाई कर!<verse eid="PSA 139:24" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" sid="PSA 140" />
  <para style="s">बचाव खात्तर प्रार्थना</para>
  <para style="d">प्रधान बजाण आळे खात्तर दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 140:1" />हे यहोवा, मन्‍नै बुरे माणसां तै बचाले;</para>
  <para style="q" vid="PSA 140:1">उपद्रवी माणसां तै मेरी हिफाजत कर,<verse eid="PSA 140:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 140:2" />क्यूँके उननै मन म्ह बुरी कल्पनां करी सै;</para>
  <para style="q" vid="PSA 140:2">वे लगातार लड़ाई करै सै।<verse eid="PSA 140:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 140:3" />उनका बोळणा साँप का काटण सा सै,</para>
  <para style="q" vid="PSA 140:3">उनकै मुँह म्ह नाग बरगा जहर रहवै सै।<verse eid="PSA 140:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 140:4" />हे यहोवा मन्‍नै दुष्ट माणसां कै हाथ तै बचाले;</para>
  <para style="q" vid="PSA 140:4">उपद्रवी माणसां तै मेरी सम्भाळ कर,</para>
  <para style="q" vid="PSA 140:4">क्यूँके उननै मेरे पैर उखाड़ण की योजना बणाई सै।<verse eid="PSA 140:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 140:5" />घमण्डियाँ नै मेरी खात्तर जाळ अर सिकन्जे लगाऐ,</para>
  <para style="q" vid="PSA 140:5">अर राह कै किनारे जाळ बिछाया सै;</para>
  <para style="q" vid="PSA 140:5">उननै मेरी खात्तर जाळ लगा राक्खे सै। (सेला)<verse eid="PSA 140:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 140:6" />हे यहोवा, मन्‍नै तेरे तै कह्या सै के तू मेरा परमेसवर सै;</para>
  <para style="q" vid="PSA 140:6">हे यहोवा, मेरे गिड़गड़ाणे की ओड़ कान लगा!<verse eid="PSA 140:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 140:7" />हे यहोवा प्रभु, हे मेरे सामर्थी उद्धार करण आळे,</para>
  <para style="q" vid="PSA 140:7">तन्‍नै युद्ध कै बखत मेरे ताहीं सम्भाळया सै।<verse eid="PSA 140:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 140:8" />हे यहोवा दुष्ट माणसां की मर्जी नै पूरा ना होण दे,</para>
  <para style="q" vid="PSA 140:8">उनकी बुरी योजना नै कामयाब ना कर, न्ही तो वो घमण्ड करैगा। (सेला)<verse eid="PSA 140:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 140:9" />मेरे ताहीं घेरे खड़े सै वे जीत्तण न्ही पावै, उनकी धमकी उनपै ए पड़ै!<note caller="+" style="f"><char style="fr" closed="false">140:9 </char><char style="fq" closed="false">मेरे ताहीं घेरे खड़े सै वे जीत्तण न्ही पावै, उनकी धमकी उनपै ए पड़ै! </char><char style="ft" closed="false">मेरे ताहीं घेरण आळयां कै सिर पै उननै का सोच्या होया उत्पात आ पड़ै!</char></note><verse eid="PSA 140:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 140:10" />उनपै अंगारे गेरे जावै।</para>
  <para style="q" vid="PSA 140:10">वे आग म्ह गेर दिए जावै।</para>
  <para style="q" vid="PSA 140:10">अर इसे खड्डे म्ह गिरै, के वे फेर ना उठ सकै!<verse eid="PSA 140:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 140:11" />बकवादी धरती पै मजबूत ना होवैगा;</para>
  <para style="q" vid="PSA 140:11">उपद्रवी माणसां नै गिराण खात्तर बुराई उसका पिच्छा करैगी।<verse eid="PSA 140:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 140:12" />हे यहोवा, मन्‍नै तो पक्‍का यकिन सै के तू दीन माणस का</para>
  <para style="q" vid="PSA 140:12">अर दरिद्रां का न्याय करैगा।<verse eid="PSA 140:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 140:13" />बेसक धर्मी तेरे नाम का धन्यवाद करण पावैंगें;</para>
  <para style="q" vid="PSA 140:13">सीध्धे माणस तेरे स्याम्ही रहवैगें।<verse eid="PSA 140:13" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" sid="PSA 141" />
  <para style="s">पाप अर पापियाँ तै बचाव</para>
  <para style="d">दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 141:1" />हे यहोवा, मन्‍नै तेरे ताहीं पुकारया सै; मेरे खात्तर फुर्ती कर!</para>
  <para style="q" vid="PSA 141:1">जिब मै तेरे ताहीं पुकारूँ, फेर मेरी ओड़ कान लगा!<verse eid="PSA 141:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 141:2" />मेरी प्रार्थना तेरी स्याम्ही खसबूदार धूप,</para>
  <para style="q" vid="PSA 141:2">अर मेरा हाथ फैलाणा, साँझ कै बखत का अन्‍नबलि बणै!<verse eid="PSA 141:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 141:3" />ये यहोवा, मेरे मुँह पै पैहरा बिठा,</para>
  <para style="q" vid="PSA 141:3">मेरे होठ्ठां के दरबाजे पै रुखाळी कर!<verse eid="PSA 141:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 141:4" />मेरा मन किसे बुरी बात की ओड़ फिरण ना दे;</para>
  <para style="q" vid="PSA 141:4">मै अनर्थकारी माणसां कै गैल,</para>
  <para style="q" vid="PSA 141:4">बुरे काम्मां म्ह ना लाग्गू,</para>
  <para style="q" vid="PSA 141:4">अर मै उनके स्वादिष्ट भोजनवस्तुओं म्ह तै कुछ ना खाऊँ!<verse eid="PSA 141:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 141:5" />धर्मी मेरे ताहीं मारै तो करुणा मान्‍नी जावैगी,</para>
  <para style="q" vid="PSA 141:5">अर वो मन्‍नै धमका दे, तो यो मेरे सिर पै का तेल ठहरैगा;</para>
  <para style="q" vid="PSA 141:5">मेरा सिर उसतै इन्कार ना करैगा।</para>
  <para style="q" vid="PSA 141:5">दुष्ट लोगां के बुरे काम्मां कै खिलाफ मै रोज प्रार्थना करदा रहूँगा।<verse eid="PSA 141:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 141:6" />जिब उनके न्यायी पहाड़ कै उप्पर तै गेरे गये,</para>
  <para style="q" vid="PSA 141:6">फेर उननै मेरे वचन सुण लिए; क्यूँके वे मधुर सै।<verse eid="PSA 141:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 141:7" />जिस तरियां खेत म्ह हळ चाल्दे हाण डळे फुट्टै सै,</para>
  <para style="q" vid="PSA 141:7">उसे तरियां म्हारी हड्डियाँ अधोलोक के मुँह पै बिखेरी गई सै।<verse eid="PSA 141:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 141:8" />पर हे यहोवा प्रभु, मेरी आँख तेरी ए ओड़ लागरी सै;</para>
  <para style="q" vid="PSA 141:8">मै तेरा शरणागत सूं; तू मेरी जान ना जाण दे!<verse eid="PSA 141:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 141:9" />मन्‍नै उनके जाळ तै, जो उननै मेरे खात्तर लगाया सै,</para>
  <para style="q" vid="PSA 141:9">अर अनर्थकारियाँ के जाळ तै मेरी मदद कर!<verse eid="PSA 141:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 141:10" />दुष्ट माणस अपणे जाळ म्ह खुद ए फंसै,</para>
  <para style="q" vid="PSA 141:10">अर मै बच लिकडु।<verse eid="PSA 141:10" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" sid="PSA 142" />
  <para style="s">अत्याचारी तै राहत खात्तर बिनती</para>
  <para style="d">दाऊद का मश्कील, जिब वो गुफा म्ह था प्रार्थना</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 142:1" />मै यहोवा की दुहाई देऊँ सूं,</para>
  <para style="q" vid="PSA 142:1">मै यहोवा तै गिड़गिड़ाऊँ सूं,<verse eid="PSA 142:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 142:2" />मै अपणे दुख की बात उसतै खोल कै कहूँ,</para>
  <para style="q" vid="PSA 142:2">मै अपणी समस्या उसकै आग्गै प्रगट करुँ सूं।<verse eid="PSA 142:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 142:3" />जिब मेरी आत्मा मेरे भित्तर परेशान होरी थी,</para>
  <para style="q" vid="PSA 142:3">तब तू मेरी हालत नै जाणै था!</para>
  <para style="q" vid="PSA 142:3">जिस रास्ते पै मै जाण आळा था, उस्से म्ह उननै मेरे खात्तर जाळ बिछाया।<verse eid="PSA 142:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 142:4" />मन्‍नै सोळी ओड़ देख्या, पर कोए ना दिख्या।</para>
  <para style="q" vid="PSA 142:4">मेरी खात्तर शरण किते ना रही, ना मन्‍नै कोए पूच्छै सै।<verse eid="PSA 142:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 142:5" />हे यहोवा, मन्‍नै तेरी दुहाई दी सै;</para>
  <para style="q" vid="PSA 142:5">मन्‍नै कह्या, तो मेरा शरणस्‍थान सै,</para>
  <para style="q" vid="PSA 142:5">मेरे जिन्दे जी तू मेरा भाग सै।<verse eid="PSA 142:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 142:6" />मेरे चिल्‍लाण की ओड़ ध्यान देकै सुण,</para>
  <para style="q" vid="PSA 142:6">क्यूँके मेरी बड़ी बुरी हालत होगी सै।</para>
  <para style="q" vid="PSA 142:6">जो मेरे पाच्छै पड़े सै, उनतै मन्‍नै बचाले;</para>
  <para style="q" vid="PSA 142:6">क्यूँके वो मेरे तै घणे ताकतवर सै।<verse eid="PSA 142:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 142:7" />मन्‍नै जेळ म्ह तै काढ ताके मै तेरे नाम का धन्यवाद करुँ!</para>
  <para style="q" vid="PSA 142:7">धर्मी माणस मेरी च्यांरु ओड़ आवैंगे;</para>
  <para style="q" vid="PSA 142:7">क्यूँके तू मेरे पै करुणा करैगा।<verse eid="PSA 142:7" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" sid="PSA 143" />
  <para style="s">मार्गदर्शन अर उद्धार खात्तर प्रार्थना</para>
  <para style="d">दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 143:1" />हे यहोवा मेरी प्रार्थना सुण;</para>
  <para style="q" vid="PSA 143:1">मेरे गिड़गिड़ाणे की ओड़ कान लगा!</para>
  <para style="q" vid="PSA 143:1">तू जो सच्‍च्‍चा अर धर्मी सै, इस करकै मेरी सुण ले,<verse eid="PSA 143:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 143:2" />अर अपणे दास पै मुकद्दमा ना चला!</para>
  <para style="q" vid="PSA 143:2">क्यूँके कोए जीव तेरी नजर म्ह बेकसूर न्ही ठहर सकदा।<verse eid="PSA 143:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 143:3" />दुश्मन तो मेरी जान का गाहक होया सै;</para>
  <para style="q" vid="PSA 143:3">उसनै मेरे ताहीं चूर करकै माट्टी म्ह मिलाया सै,</para>
  <para style="q" vid="PSA 143:3">अर मेरे ताहीं घणे दिन के मरे होये की तरियां अँधेरी जगहां म्ह गेर दिया सै।<verse eid="PSA 143:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 143:4" />मेरी आत्मा मेरे भित्तर तै बेचैन होरी सै</para>
  <para style="q" vid="PSA 143:4">मेरा मन व्याकुल सै।<verse eid="PSA 143:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 143:5" />मेरे ताहीं पुराणे दिन याद आवै सै,</para>
  <para style="q" vid="PSA 143:5">मै तेरे सारे बेमिसाल काम्मां पै ध्यान करुँ सूं,</para>
  <para style="q" vid="PSA 143:5">अर तेरे हाथ्थां के काम्मां नै याद करुँ सूं।<verse eid="PSA 143:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 143:6" />मै तेरी ओड़ अपणे हाथ फैलाऊं सूं;</para>
  <para style="q" vid="PSA 143:6">सूक्खी धरती की तरियां मै तेरा प्यासा सूं।<verse eid="PSA 143:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 143:7" />हे यहोवा, तावळ करकै मेरी सुण ले; (सेला)</para>
  <para style="q" vid="PSA 143:7">क्यूँके मेरी जान लिकड़ण आळी सै!</para>
  <para style="q" vid="PSA 143:7">मेरे तै अपणा मुँह ना छिपा, इसा ना हो के मै कब्र म्ह पड़े होया कै बरगा ना हो जाऊँ।<verse eid="PSA 143:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 143:8" />सबेरै कै बखत अपणी करुणा की बात मन्‍नै सुणा,</para>
  <para style="q" vid="PSA 143:8">क्यूँके मन्‍नै तेरे पै भरोस्सा राख्या सै।</para>
  <para style="q" vid="PSA 143:8">जिस रास्ते पै मन्‍नै चालणा सै, वो मन्‍नै बता दे,</para>
  <para style="q" vid="PSA 143:8">क्यूँके मै अपणा मन तेरी ओड़ लगाऊँ सूं।<verse eid="PSA 143:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 143:9" />हे यहोवा, मन्‍नै दुश्मनां तै बचाले;</para>
  <para style="q" vid="PSA 143:9">मै तेरी ए आड़ म्ह आ छिप्या सूं।<verse eid="PSA 143:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 143:10" />मन्‍नै या सिखा, के मै तेरी इच्छा किस तरियां पूरी करुँ, क्यूँके मेरा परमेसवर तू ए सै!</para>
  <para style="q" vid="PSA 143:10">तेरी भली आत्मा मन्‍नै धर्म कै राह म्ह ले चाल्‍लै!<verse eid="PSA 143:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 143:11" />हे यहोवा, मन्‍नै अपणे नाम कै मुताबिक चला!</para>
  <para style="q" vid="PSA 143:11">तू जो धर्मी सै, मन्‍नै मुसीबत तै छुड़ाले!<verse eid="PSA 143:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 143:12" />अर करुणा करकै मेरे दुश्मनां का सत्यानाश कर,</para>
  <para style="q" vid="PSA 143:12">अर मेरे सारे सताण आळे का नाश करदे,</para>
  <para style="q" vid="PSA 143:12">क्यूँके मै तेरा दास सूं।<verse eid="PSA 143:12" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" sid="PSA 144" />
  <para style="s">बचाव अर समृद्धि खात्तर प्रार्थना</para>
  <para style="d">दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 144:1" />धन्य सै यहोवा, जो मेरी चट्टान सै,</para>
  <para style="q" vid="PSA 144:1">वो युद्ध खात्तर मेरे हाथ्थां नै,</para>
  <para style="q" vid="PSA 144:1">अर लड़ाई खात्तर मेरी आँगळियाँ नै त्यार करावै सै।<verse eid="PSA 144:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 144:2" />वो मेरे खात्तर करुणानिधान अर गढ़,</para>
  <para style="q" vid="PSA 144:2">ऊँच्‍ची जगहां अर छुड़ाण आळा सै,</para>
  <para style="q" vid="PSA 144:2">वो मेरी ढाल अर शरणस्‍थान सै,</para>
  <para style="q" vid="PSA 144:2">जो जात्तां<note caller="+" style="f"><char style="fr" closed="false">144:2 </char><char style="fq" closed="false">जात्तां </char><char style="ft" closed="false">मेरी जात्तां</char></note> नै मेरे बस म्ह करदे सै।<verse eid="PSA 144:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 144:3" />हे यहोवा, माणस के सै के तू उसकी सुधि लेवै सै,</para>
  <para style="q" vid="PSA 144:3">या इन्सान के सै, के तू उसकी चिन्ता करै सै?<verse eid="PSA 144:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 144:4" />इन्सान तो साँस की तरियां सै;</para>
  <para style="q" vid="PSA 144:4">उसके दिन ढळदी होई छाया की तरियां सै।<verse eid="PSA 144:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 144:5" />हे यहोवा, अपणे सुर्ग नै नीच्‍चा करकै उतर आ!</para>
  <para style="q" vid="PSA 144:5">पहाड़ां नै छू फेर उन म्ह तै धुम्मा उठैगा!<verse eid="PSA 144:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 144:6" />बिजळी कड़-कड़ा कै उननै आस्सै-पास्सै करदे,</para>
  <para style="q" vid="PSA 144:6">अपणे तीर चलाकै उननै घबरा दे!<verse eid="PSA 144:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 144:7" />अपणा हाथ उप्पर तै बढ़ाकै मन्‍नै महासागर तै उभार,</para>
  <para style="q" vid="PSA 144:7">यानिके परदेशियाँ कै बस म्ह तै छुड़ा।<verse eid="PSA 144:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 144:8" />उनकै मुँह तै तो झूठ्ठी बात लिकड़ै सै,</para>
  <para style="q" vid="PSA 144:8">अर उनकै सोळे हाथ तै धोक्खे के काम होवै सै।<verse eid="PSA 144:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 144:9" />हे परमेसवर, मै तेरी स्तुति का नया गीत गाऊँगा;</para>
  <para style="q" vid="PSA 144:9">मै दस तार आळी सारंगी बजाकै तेरा भजन गाऊँगा।<verse eid="PSA 144:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 144:10" />तू राजायां का उद्धार करै सै,</para>
  <para style="q" vid="PSA 144:10">अर अपणे दास दाऊद नै तलवार की मार तै बचावै सै।<verse eid="PSA 144:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 144:11" />मन्‍नै ठा अर परदेशियाँ कै बस तै छुड़ाले,</para>
  <para style="q" vid="PSA 144:11">जिनकै मुँह तै झूठ्ठी बात लिकड़ै सै,</para>
  <para style="q" vid="PSA 144:11">अर जिनका सोळा हाथ झूठ का सोळा हाथ सै।<verse eid="PSA 144:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 144:12" />जिब म्हारे बेट्टे जवानी कै बखत पौध्यां की तरियां बढ़दे होये,</para>
  <para style="q" vid="PSA 144:12">अर म्हारी बेटियाँ उन कूण आळे खम्‍भयां की तरियां हों, जो महल खात्तर बणाए जावै;<verse eid="PSA 144:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 144:13" />म्हारे खेत भरे रहवै, अर उन म्ह न्यारे-न्यारे ढाळ का नाज धरया जावै,</para>
  <para style="q" vid="PSA 144:13">अर म्हारी भेड़-बकरी म्हारे मैदानां म्ह हजारां-हजार बच्‍चें पैदा करै;<verse eid="PSA 144:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 144:14" />जिब म्हारे बळध खूब लदे होये हों;</para>
  <para style="q" vid="PSA 144:14">जिब हमनै ना कोए समस्या हो अर न म्हारा किते जाणा हो,</para>
  <para style="q" vid="PSA 144:14">अर ना म्हारे चौकां म्ह रोणा-पीटणा हो,<verse eid="PSA 144:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 144:15" />तो इस हाल म्ह जो राज्य हो वो कितना धन्य होवैगा!</para>
  <para style="q" vid="PSA 144:15">जिस राज्य का परमेसवर यहोवा सै, वो कितना धन्य सै!<verse eid="PSA 144:15" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" sid="PSA 145" />
  <para style="s">परमेसवर की महिमा अर प्रेम का गीत</para>
  <para style="d">दाऊद का भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 145:1" />हे मेरे परमेसवर, हे राजा, मै तन्‍नै सराहूँगा,</para>
  <para style="q" vid="PSA 145:1">अर तेरे नाम नै सदा-सदा धन्य कहन्दा रहूँगा।<verse eid="PSA 145:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 145:2" />हर रोज मै तन्‍नै धन्य कह्या करुँगा,</para>
  <para style="q" vid="PSA 145:2">अर तेरे नाम की स्तुति सदा-सदा करदा रहूँगा।<verse eid="PSA 145:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 145:3" />यहोवा महान अर घणी स्तुति कै लायक सै,</para>
  <para style="q" vid="PSA 145:3">अर उसकी स्तुति अगम सै।<verse eid="PSA 145:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 145:4" />तेरे काम्मां की स्तुति अर तेरे पराक्रम के काम्मां का जिक्र,</para>
  <para style="q" vid="PSA 145:4">पीढ़ी-पीढ़ी तक होन्दा चल्या जावैगा<verse eid="PSA 145:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 145:5" />वे एक-दुसरे तै तेरे ऐश्‍वर्य की महिमा के प्रताप की बात करैगें</para>
  <para style="q" vid="PSA 145:5">अर मै तेरे न्यारे-न्यारे अचम्भे के काम्मां पै ध्यान करुँगा।<note caller="+" style="f"><char style="fr" closed="false">145:5 </char><char style="fq" closed="false">वे एक-दुसरे तै तेरे ऐश्‍वर्य की महिमा के प्रताप की बात करैगें अर मै तेरे न्यारे-न्यारे अचम्भे के काम्मां पै ध्यान करुँगा। </char><char style="ft" closed="false">मै तेरे ऐश्‍वर्य की महिमा के प्रताप पै अर तेरे न्यारे-न्यारे अचम्भे के काम्मां पै ध्यान करुँगा। </char></note><verse eid="PSA 145:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 145:6" />लोग तेरे भयानक काम्मां की शक्ति की चर्चा करैगें,</para>
  <para style="q" vid="PSA 145:6">अर मै तेरे बड़े-बड़े काम्मां का चर्चा करुँगा।<verse eid="PSA 145:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 145:7" />लोग तेरी बड़ी भलाई नै याद करकै उसका वर्णन करैगें,</para>
  <para style="q" vid="PSA 145:7">अर तेरे धर्म का जयजयकार करैगें।<verse eid="PSA 145:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 145:8" />यहोवा अनुग्रहकारी अर दयालु,</para>
  <para style="q" vid="PSA 145:8">देर तै छो करण आळा अर घणा करुणामय सै।<verse eid="PSA 145:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 145:9" />यहोवा सारया खात्तर भला सै,</para>
  <para style="q" vid="PSA 145:9">अर उसकी दया उसकी सारी सृष्टि पै सै।<verse eid="PSA 145:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 145:10" />हे यहोवा, तेरी सारी सृष्टि तेरा धन्यवाद करैगी,</para>
  <para style="q" vid="PSA 145:10">अर तेरे भक्‍त तन्‍नै धन्य कह्या करैगें!<verse eid="PSA 145:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 145:11" />वो तेरे राज्य की महिमा की चर्चा करैगें,</para>
  <para style="q" vid="PSA 145:11">अर तेरे पराक्रम कै बारै म्ह बात करैगें;<verse eid="PSA 145:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 145:12" />के वो माणसां पै तेरे पराक्रम के काम</para>
  <para style="q" vid="PSA 145:12">अर तेरे राज्य के प्रताप की महिमा प्रगट करैं।<verse eid="PSA 145:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 145:13" />तेरा राज युग-युग का</para>
  <para style="q" vid="PSA 145:13">अर तेरी प्रभुता सारी पीढ़ियाँ पै बणी रहवैगी।<verse eid="PSA 145:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 145:14" />यहोवा सारे गिरदे होया नै सम्भाळै सै,</para>
  <para style="q" vid="PSA 145:14">अर सारे झुके होया नै सीध्धा खड्या करै सै।<verse eid="PSA 145:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 145:15" />सारया की आँख तेरी ओड़ लाग्गी रहवै सै,</para>
  <para style="q" vid="PSA 145:15">अर तू उननै बखत पै खाणा देवै सै<verse eid="PSA 145:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 145:16" />तू अपणी मुट्ठी खोल कै,</para>
  <para style="q" vid="PSA 145:16">सारे प्राणियाँ नै खाणे तै छिकावै सै।<verse eid="PSA 145:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 145:17" />यहोवा अपणी सारी चाल म्ह धर्मी</para>
  <para style="q" vid="PSA 145:17">अर अपणे सारे काम्मां म्ह करुणामय सै।<verse eid="PSA 145:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 145:18" />जितने यहोवा नै पुकारै सै, यानिके जितने उसनै सच्‍चाई तै पुकारै सै;</para>
  <para style="q" vid="PSA 145:18">उन सारया कै वो धोरै रहवै सै।<verse eid="PSA 145:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 145:19" />वो अपणे डरणियाँ की मर्जी पूरी करै सै,</para>
  <para style="q" vid="PSA 145:19">अर उनकी दुहाई सुणकै उनका उद्धार करै सै।<verse eid="PSA 145:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 145:20" />यहोवा अपणे सारे प्रेमियाँ की तो सम्भाल करै सै,</para>
  <para style="q" vid="PSA 145:20">पर सारे दुष्टां का सत्यानाश करै सै।<verse eid="PSA 145:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 145:21" />मै यहोवा की स्तुति करुँगा,</para>
  <para style="q" vid="PSA 145:21">अर सारे प्राणी उसके पवित्र नाम नै सदा-सदा धन्य कहन्दे रहवै।<verse eid="PSA 145:21" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" sid="PSA 146" />
  <para style="s">उद्धारकर्ता परमेसवर की स्तुति</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 146:1" />यहोवा की स्तुति करो।</para>
  <para style="q" vid="PSA 146:1">हे मेरे मन यहोवा की स्तुति कर!<verse eid="PSA 146:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 146:2" />मै सारी उम्र यहोवा की स्तुति करदा रहूँगा;</para>
  <para style="q" vid="PSA 146:2">जिब तक मै जिन्दा रहूँगा, तब तक अपणे परमेसवर का गीत गान्दा रहूँगा।<verse eid="PSA 146:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 146:3" />थम प्रधानां पै भरोस्सा ना राखियो,</para>
  <para style="q" vid="PSA 146:3">ना किसे आदमी पै, क्यूँके उस म्ह उद्धार करण की ताकत्त कोन्या।<verse eid="PSA 146:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 146:4" />क्यूँके उसकी भी जान लिकड़ैगी, वो भी माट्टी म्ह मिल जावैगा;</para>
  <para style="q" vid="PSA 146:4">उसे दिन उसकी सारी योजना नाश हो जावैगी।<verse eid="PSA 146:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 146:5" />कितनी भली बात सै,</para>
  <para style="q" vid="PSA 146:5">जिसकी मदद करण आळा याकूब का परमेसवर सै,</para>
  <para style="q" vid="PSA 146:5">अर जिसकी आस अपणे परमेसवर यहोवा पै सै।<verse eid="PSA 146:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 146:6" />वो अकास अर धरती अर समुन्दर</para>
  <para style="q" vid="PSA 146:6">अर जो किमे उस म्ह सै, सब का बणाण आळा सै;</para>
  <para style="q" vid="PSA 146:6">वो अपणा शब्द हमेशा खात्तर पूरा करदा रहवैगा।<verse eid="PSA 146:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 146:7" />वो जिनपै जुल्म होया सै उनका न्याय चुकावै सै;</para>
  <para style="q" vid="PSA 146:7">अर भूखे नै रोट्टी देवै सै।</para>
  <para style="q" vid="PSA 146:7">यहोवा कैदियाँ नै छुड़ावै सै;<verse eid="PSA 146:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 146:8" />यहोवा आन्धयां नै आँख देवै सै।</para>
  <para style="q" vid="PSA 146:8">यहोवा झुके होया नै सीध्धा खड्या करै सै;</para>
  <para style="q" vid="PSA 146:8">यहोवा धर्मियाँ तै प्यार करै सै।<verse eid="PSA 146:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 146:9" />यहोवा परदेशियाँ की सम्भाल करै सै;</para>
  <para style="q" vid="PSA 146:9">अर अनाथ्थां अर बिधवा की वो देखभाळ करै सै;</para>
  <para style="q" vid="PSA 146:9">पर दुष्टां की राह नै टेढ़ा-मेढ़ा कर देवै सै।<verse eid="PSA 146:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 146:10" />हे सिय्योन, यहोवा हमेशा खात्तर,</para>
  <para style="q" vid="PSA 146:10">तेरा परमेसवर पीढ़ी-पीढ़ी राज करदा रहवैगा।</para>
  <para style="q" vid="PSA 146:10">यहोवा की स्तुति करो!<verse eid="PSA 146:10" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" sid="PSA 147" />
  <para style="s">सर्वशक्तिमान परमेसवर की स्तुति</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 147:1" />यहोवा की स्तुति करो!</para>
  <para style="q" vid="PSA 147:1">क्यूँके अपणे परमेसवर का भजन गाणा आच्छा सै;</para>
  <para style="q" vid="PSA 147:1">क्यूँके वो मनभावणा सै, उसकी स्तुति करणा आच्छा सै।<verse eid="PSA 147:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 147:2" />यहोवा यरुशलेम नै फेर तै बसावै सै;</para>
  <para style="q" vid="PSA 147:2">वो लिकड़े होए इस्राएलियाँ नै कठ्ठा करण लाग रहया सै।<verse eid="PSA 147:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 147:3" />वो दुखी मन आळयां नै ठीक करै सै,</para>
  <para style="q" vid="PSA 147:3">अर उनके घा पै मरहम-पट्टी बाँधै सै।<verse eid="PSA 147:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 147:4" />वो तारां नै गिणै,</para>
  <para style="q" vid="PSA 147:4">अर उन म्ह तै एक-एक का नाम धरै सै।<verse eid="PSA 147:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 147:5" />म्हारा प्रभु महान अर घणा सामर्थी सै;</para>
  <para style="q" vid="PSA 147:5">उसकी समझ अपरम्‍पार सै।<verse eid="PSA 147:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 147:6" />यहोवा नम्र माणसां नै तो सम्भाळै सै,</para>
  <para style="q" vid="PSA 147:6">अर दुष्टां नै धरती पै गेर देवै सै।<verse eid="PSA 147:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 147:7" />धन्यवाद करदे होए यहोवा का गीत गाओ;</para>
  <para style="q" vid="PSA 147:7">वीणा बजान्दे होए म्हारे परमेसवर का भजन गाओ।<verse eid="PSA 147:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 147:8" />वो अकास नै बादळां तै भर देवै सै,</para>
  <para style="q" vid="PSA 147:8">अर धरती खात्तर मिह की त्यारी करै सै, अर पहाड़ां पै घास उगावै सै।<verse eid="PSA 147:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 147:9" />वो पशुआं नै अर काग के बच्‍चां नै जो पुकारै सै,</para>
  <para style="q" vid="PSA 147:9">खाणा देवै सै।<verse eid="PSA 147:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 147:10" />ना तो वो घोड़ां की ताकत्त नै चाहवै सै,</para>
  <para style="q" vid="PSA 147:10">अर ना ताकतवर माणस के पैरां तै खुश होवै सै;<verse eid="PSA 147:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 147:11" />यहोवा अपणे डरण आळयां तै ए खुश होवै सै,</para>
  <para style="q" vid="PSA 147:11">मतलब उनतै जो उसकी करुणा पै आस लगाऐ रहवै सै।<verse eid="PSA 147:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 147:12" />हे यरुशलेम, यहोवा की बड़ाई कर!</para>
  <para style="q" vid="PSA 147:12">हे सिय्योन, अपणे परमेसवर की स्तुति कर!<verse eid="PSA 147:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 147:13" />क्यूँके उसनै तेरे फाटकां के खम्‍भयां ताहीं मजबूत करया सै;</para>
  <para style="q" vid="PSA 147:13">अर तेरे बाळकां ताहीं आशीष दी सै।<verse eid="PSA 147:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 147:14" />वो तेरी सीमा म्ह शान्ति देवै सै,</para>
  <para style="q" vid="PSA 147:14">अर तन्‍नै आच्छे तै आच्छी कणक तै भरपूर करै सै।<verse eid="PSA 147:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 147:15" />वो धरती पै अपणे हुकमां का प्रचार करै सै,</para>
  <para style="q" vid="PSA 147:15">उसका वचन भोत तेज दौड़ै सै।<verse eid="PSA 147:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 147:16" />वो ऊन की तरियां बर्फ नै गिरावै सै,</para>
  <para style="q" vid="PSA 147:16">अर राख की तरियां पाळा बिखेरै सै।<verse eid="PSA 147:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 147:17" />वो बर्फ के टुकड़े गिरावै सै,</para>
  <para style="q" vid="PSA 147:17">उसकी करी होई ठण्ड नै कौण सह सकै सै?<verse eid="PSA 147:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 147:18" />वो हुक्म देकै उननै गळावै सै;</para>
  <para style="q" vid="PSA 147:18">वो हवा चलावै सै, फेर पाणी बहण लाग ज्या सै।<verse eid="PSA 147:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 147:19" />वो याकूब नै अपणा वचन,</para>
  <para style="q" vid="PSA 147:19">अर इस्राएल नै अपणी विधियाँ अर नियम बतावै सै।<verse eid="PSA 147:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 147:20" />किसे और जात तै उसनै इसा बरताव न्ही करया;</para>
  <para style="q" vid="PSA 147:20">अर उसके नियमां ताहीं औरां नै न्ही जाण्या।</para>
  <para style="q" vid="PSA 147:20">यहोवा की स्तुति करो।<verse eid="PSA 147:20" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" sid="PSA 148" />
  <para style="s">सारी सृष्टि परमेसवर की स्तुति करै</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 148:1" />यहोवा की स्तुति करो!</para>
  <para style="q" vid="PSA 148:1">यहोवा की स्तुति सुर्ग म्ह तै करो,</para>
  <para style="q" vid="PSA 148:1">उसकी स्तुति ऊँच्‍ची जगहां म्ह करो!<verse eid="PSA 148:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 148:2" />हे उसके सारे दूतों, उसकी स्तुति करो;</para>
  <para style="q" vid="PSA 148:2">हे उसकी सारी सेना उसकी स्तुति करो!<verse eid="PSA 148:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 148:3" />हे सूरज अर चाँद उसकी स्तुति करो,</para>
  <para style="q" vid="PSA 148:3">हे सारे चमकण आळे तारागण उसकी स्तुति करो!<verse eid="PSA 148:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 148:4" />हे सारया तै ऊँच्‍चे अकास,</para>
  <para style="q" vid="PSA 148:4">अर हे अकास कै उप्पर आळे पाणी, थम दोन्‍नु उसकी स्तुति करो।<verse eid="PSA 148:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 148:5" />वो यहोवा कै नाम की स्तुति करैं,</para>
  <para style="q" vid="PSA 148:5">क्यूँके उसे नै हुक्म दिया अर ये बणाए गये।<verse eid="PSA 148:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 148:6" />अर उसनै उन ताहीं सदा खात्तर मजबूत करया सै;</para>
  <para style="q" vid="PSA 148:6">अर इसी विधि ठहराई सै, जो टळ न्ही सकदी।<verse eid="PSA 148:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 148:7" />धरती पै तै यहोवा की स्तुति करो,</para>
  <para style="q" vid="PSA 148:7">हे समुन्दरी अजगरों अर ढुंघे समुन्दर,<verse eid="PSA 148:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 148:8" />हे आग अर ओळों, हे बर्फ अर बादळो,</para>
  <para style="q" vid="PSA 148:8">हे उसका वचन मानण आळी घणी तेज आन्धी।<verse eid="PSA 148:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 148:9" />हे पाहाड़ों अर सारे टीलों,</para>
  <para style="q" vid="PSA 148:9">हे फळ देण आळे दरखतां अर सारे देवदारों!<verse eid="PSA 148:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 148:10" />हे जंगळी पशुओ अर घरेलू पशुओं,</para>
  <para style="q" vid="PSA 148:10">हे रेंगण आळे जन्‍तुओं अर हे पंछियों!<verse eid="PSA 148:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 148:11" />हे धरती के राजाओं, अर राज्य-राज्य के सारे माणसों,</para>
  <para style="q" vid="PSA 148:11">हे हाकिमों अर धरती के सारे न्याय करण आळेयो!<verse eid="PSA 148:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 148:12" />हे जवानों अर कुमारियों,</para>
  <para style="q" vid="PSA 148:12">हे बुजुर्गों अर बाळकों!<verse eid="PSA 148:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 148:13" />यहोवा कै नाम की स्तुति करो,</para>
  <para style="q" vid="PSA 148:13">क्यूँके सिर्फ उसे का नाम महान सै;</para>
  <para style="q" vid="PSA 148:13">उसका ऐश्‍वर्य धरती अर आसमान कै उप्पर सै।<verse eid="PSA 148:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 148:14" />अर उसनै अपणी प्रजा खात्तर एक सींग ऊँच्‍चा ठाया सै,</para>
  <para style="q" vid="PSA 148:14">या उसके सारे भगतां खात्तर</para>
  <para style="q" vid="PSA 148:14">यानिके इस्राएलियाँ खात्तर अर उसकै धोरै रहण आळी प्रजा खात्तर स्तुति करण का कारण सै</para>
  <para style="q" vid="PSA 148:14">यहोवा की स्तुति करो!<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" sid="PSA 149" />
  <para style="s">इस्राएल परमेसवर की स्तुति करै</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 149:1" />यहोवा की स्तुति करो!</para>
  <para style="q" vid="PSA 149:1">यहोवा खात्तर नया गीत गाओ,</para>
  <para style="q" vid="PSA 149:1">भगतां की सभा म्ह उसकी स्तुति गाओ!<verse eid="PSA 149:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 149:2" />इस्राएल अपणे बणाण आळे परमेसवर तै खुश हो,</para>
  <para style="q" vid="PSA 149:2">सिय्योन के रहण आळे अपणे राजा कै कारण खुश हो!<verse eid="PSA 149:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 149:3" />वे नाचदे होए उसकै नाम की स्तुति करैं,</para>
  <para style="q" vid="PSA 149:3">अर डफ अर वीणा बजान्दे होए उसके गीत गावैं!<verse eid="PSA 149:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 149:4" />क्यूँके यहोवा अपणी प्रजा तै खुश रहवै सै;</para>
  <para style="q" vid="PSA 149:4">वो नरम माणसां का उद्धार करकै उनका आदर बढ़ावैगा।<verse eid="PSA 149:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 149:5" />भगत माणस उनकी महिमा<note caller="+" style="f"><char style="fr" closed="false">149:5 </char><char style="fq" closed="false">उनकी महिमा </char><char style="ft" closed="false">महिमा </char></note> कै कारण मगन हों;</para>
  <para style="q" vid="PSA 149:5">अर अपणे बिछोणे पै भी पड़े-पड़े जयजयकार करैं।<verse eid="PSA 149:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 149:6" />उनके गळे तै परमेसवर की तारीफ हो,</para>
  <para style="q" vid="PSA 149:6">अर उनके हाथ्थां म्ह दोधारी तलवार रहवैं,<verse eid="PSA 149:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 149:7" />ताके वो जात-जात तै बदला ले सकै;</para>
  <para style="q" vid="PSA 149:7">अर राज्य-राज्य के माणसां नै ताड़ना दे,<verse eid="PSA 149:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 149:8" />अर उनके राजाओ नै साँकलां तै,</para>
  <para style="q" vid="PSA 149:8">अर उनके धनी माणसां नै लोहे की बेल्‍लां तै बाँधे राक्खे,<verse eid="PSA 149:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 149:9" />अर उन ताहीं ठहराई होई सजा देगें!</para>
  <para style="q" vid="PSA 149:9">उसके सारे भगतां का इसाए आदर मान होवैगा।</para>
  <para style="q" vid="PSA 149:9">यहोवा की स्तुति करो।<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" sid="PSA 150" />
  <para style="s">प्रशंसा का एक भजन</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 150:1" />यहोवा की स्तुति करो!</para>
  <para style="q" vid="PSA 150:1">परमेसवर की पवित्र जगहां म्ह उसकी स्तुति करो;</para>
  <para style="q" vid="PSA 150:1">उसकी सामर्थ तै भरे होये अकासमण्डल म्ह</para>
  <para style="q" vid="PSA 150:1">उसकी स्तुति करो!<verse eid="PSA 150:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 150:2" />उसके बड़े-बड़े काम्मां कै कारण</para>
  <para style="q" vid="PSA 150:2">उसकी स्तुति करो;</para>
  <para style="q" vid="PSA 150:2">उसकी भोत घणी बड़ाई कै गैल उसकी स्तुति करो!<verse eid="PSA 150:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 150:3" />नरसिंगा बजान्दे होए उसकी स्तुति करो;</para>
  <para style="q" vid="PSA 150:3">सारंगी अर वीणा बजान्दे होए उसकी स्तुति करो!<verse eid="PSA 150:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 150:4" />डफ बजान्दे अर नाचदे होये उसकी स्तुति करो;</para>
  <para style="q" vid="PSA 150:4">तारआळे बाजे अर बाँसुरी बजान्दे होये</para>
  <para style="q" vid="PSA 150:4">उसकी स्तुति करो!<verse eid="PSA 150:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 150:5" />जोर-जोर तै बाज्जण आळी झाँझ बजान्दे होए</para>
  <para style="q" vid="PSA 150:5">उसकी स्तुति करो;</para>
  <para style="q" vid="PSA 150:5">खुशी की महाशब्‍द आळी झाँझ बजान्दे होए</para>
  <para style="q" vid="PSA 150:5">उसकी स्तुति करो!<verse eid="PSA 150:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 150:6" />जितने प्राणी सै</para>
  <para style="q" vid="PSA 150:6">वो सारे के सारे यहोवा की स्तुति करो!</para>
  <para style="q" vid="PSA 150:6">यहोवा की स्तुति करो!<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
</usx>