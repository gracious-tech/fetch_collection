  <para style="h">सभोपदेशक</para>
  <para style="toc1">सभोपदेशक की किताब</para>
  <para style="toc2">सभोपदेशक</para>
  <para style="toc3">सभो.</para>
  <para style="mt">सभोपदेशक की किताब</para>
  <para style="is">लेखक</para>
  <para style="ip">सभोपदेशक की किताब स्पष्ट रूप तै लेखक का परिचय कोनी देती। <char style="xt"><ref loc="ECC 1:1">सभो. 1:1</ref></char> म्ह लेखक अपणी पहचान जाहिर करै सै। उपदेशक (इब्रानी म्ह कोहेलेथ) खुद नै दाऊद का पुत्र कहवै सै जो यरुशलेम का राजा था अर उसतै पैहले यरुशलेम के सारे शासकां तै भोत घणा बुद्धि म्ह बढ़ ग्या था अर उसनै अनेक नीतिवचनां का संग्रह करया था (<char style="xt"><ref loc="ECC 1:1">सभो. 1:1</ref>,<ref loc="ECC 1:16">16</ref>; <ref loc="ECC 2:9">2:9</ref></char>)। सुलैमान दाऊद के बाद सिंहासन पै बैठ्या वो दाऊद का एकमात्र बेट्टा था, जिसनै यरुशलेम नगर तै सम्पूर्ण इस्राएल देश पर राज करया था (<char style="xt"><ref loc="ECC 1:12">सभो. 1:12</ref></char>) अनेक पद दर्शावै सै के इस किताब का लेखक सुलैमान सै। संदर्भ म्ह कुछ संकेत सै जो दिखावै सै के सुलैमान के मरण के बाद-हो सकै सै सैंकड़ों साल बाद किसे और नै या किताब लिखी थी।</para>
  <para style="is">लिखण की तारिख अर जगहां</para>
  <para style="ip">लगभग 940 - 931 ई. पू.</para>
  <para style="ip">सभोपदेशक की किताब हो सकै सै सुलैमान के राज्य के अन्त म्ह, यरुशलेम म्ह लिखी गई लाग्गै हो सै।</para>
  <para style="is">प्रापक</para>
  <para style="ip">सभोपदेशक की किताब प्राचीन युग के इस्राएलियाँ अर सारे उत्तरकालीन पाठकां खात्तर लिखी गई थी।</para>
  <para style="is">मकसद</para>
  <para style="ip">या किताब म्हारे खात्तर स्पष्ट चेतावनी सै। परमेसवर के भय अर लक्ष्य तै रहित जीवन व्यर्थ सै। वो हवा पकड़ण जिसा सै। हम चाहे सुख भोग, धन-सम्पदा, कला, बुद्धि, या मात्र भोत घणी खुशी का यत्न करते रहवां तोभी हम जीवन के अन्त म्ह योए देखांगे के जीवन बेकार ही रह्या। जीवन का मतलब परमेसवर म्ह केन्द्रित जीवन तै मिलै सै।</para>
  <para style="is">खास बातें</para>
  <para style="ip">परमेसवर तै अलग होकै सब कुछ बेकार सै</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. प्रस्तावना <char style="ior"><ref loc="ECC 1:1-11">1:1-11</ref></char></para>
  <para style="io1">2. जीवन के विभिन्‍न पक्षों की निस्सारता <char style="ior"><ref loc="ECC 1:12-5:7">1:12-5:7</ref></char></para>
  <para style="io1">3. परमेसवर का भय <char style="ior"><ref loc="ECC 5:8-12:8">5:8-12:8</ref></char></para>
  <para style="io1">4. उपसंहार <char style="ior"><ref loc="ECC 12:9-14">12:9-14</ref></char></para>
  <chapter number="1" style="c" sid="ECC 1" />
  <para style="s">सब कुछ बेकार सै</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 1:1" />यरुशलेम के राजा, दाऊद के बेट्टे अर उपदेशक के वचन। <verse eid="ECC 1:1" /><verse number="2" style="v" sid="ECC 1:2" />उपदेशक का यो वचन सै, “बेकार ए बेकार, बेकार ए बेकार! सब किमे बेकार सै।” <verse eid="ECC 1:2" /><verse number="3" style="v" sid="ECC 1:3" />उस सारी मेहनत नै जिस ताहीं माणस सूरज के नीच्‍चै<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="fq" closed="false">सूरज के नीच्‍चै </char><char style="ft" closed="false">धरती पै </char></note> करै सै, उसका के फायदा होवै सै? <verse eid="ECC 1:3" /><verse number="4" style="v" sid="ECC 1:4" />एक पीढ़ी दुनिया तै जावै सै, अर दुसरी पीढ़ी दुनिया मै आवै सै, पर धरती सदा बणी रहवै सै। <verse eid="ECC 1:4" /><verse number="5" style="v" sid="ECC 1:5" />सूरज लिकड़कै डुबै भी सै, अर फेर लिकड़ भी जावै सै। <verse eid="ECC 1:5" /><verse number="6" style="v" sid="ECC 1:6" />हवा दक्षिण की ओड़ बहवै सै, अर उत्तर की ओड़ घुमदी जावै सै; वो घुमदी अर बहन्दी रहवै सै, अर अपणी दिशा म्ह बोहड़ आवै सै। <verse eid="ECC 1:6" /><verse number="7" style="v" sid="ECC 1:7" />सारी नदी समुन्दर म्ह जा मिलै सै, फेर भी समुन्दर भरदा कोनी, जिस जगहां तै सारी नदी लिकड़ै सै, ओड़ैए वे फेर चली जावै सै। <verse eid="ECC 1:7" /><verse number="8" style="v" sid="ECC 1:8" />सारी बात मेहनत तै भरी सै, माणस इसका बखान न्ही कर सकदा, ना तो आँख देक्खण तै छिकै सै, अर ना कान सुणण तै भरै सै। <verse eid="ECC 1:8" /><verse number="9" style="v" sid="ECC 1:9" />जो किमे होया था, वोए फेर होवैगा, अर जो कुछ बण चुक्या सै वोए फेर बणाया जावैगा, अर सूरज के नीच्‍चै कोए बात नई कोनी। <verse eid="ECC 1:9" /><verse number="10" style="v" sid="ECC 1:10" />के इसी कोए बात सै जिसके बारे म्ह लोग कह सकै के देख या नई सै? या तो पुराणे जमान्‍नै म्ह भोत पैहले तै थी। <verse eid="ECC 1:10" /><verse number="11" style="v" sid="ECC 1:11" />पुराणे बखत की बात्तां की कुछ याद न्ही रही, अर होण आळी बात्तां की भी याद उनकै बाद होण आळयां नै न्ही रहवैगी।<verse eid="ECC 1:11" /></para>
  <para style="s">ज्ञान का शोक</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12" />मै उपदेशक यरुशलेम म्ह इस्राएल का राजा था। <verse eid="ECC 1:12" /><verse number="13" style="v" sid="ECC 1:13" />मन्‍नै अपणा मन लगाया के जो कुछ आसमान कै नीच्‍चै करया जावै सै, उसका भेद बुद्धि तै सोच-सोचकै पता करुँ, यो बड़े दुख का काम सै जो परमेसवर नै माणसां खात्तर ठहराया सै ताके वे उस म्ह लाग्गै। <verse eid="ECC 1:13" /><verse number="14" style="v" sid="ECC 1:14" />मन्‍नै उन सारे काम्मां ताहीं देख्या जो सूरज कै नीच्‍चै करे जावैं सै, देक्खो वे सारे बेकार अर मान्‍नो हवा कै पाच्छै पकड़ण भाजणा जिसा सै। <verse eid="ECC 1:14" /><verse number="15" style="v" sid="ECC 1:15" />जो टेढ़ा सै, वो सीध्धा न्ही हो सकदा, अर जितनी चीज न्ही सै, वे गिणी न्ही जान्दी।<verse eid="ECC 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 1:16" />मन्‍नै मन म्ह कह्या, “देख, जितने यरुशलेम म्ह मेरे तै पैहल्या थे, उन सारया तै मन्‍नै भोत घणी बुद्धि पाई सै, अर मन्‍नै भोत घणी बुद्धि अर ज्ञान मिल्या सै।” <verse eid="ECC 1:16" /><verse number="17" style="v" sid="ECC 1:17" />अर मन्‍नै अपणा मन लगाया के बुद्धि का भेद ल्यूँ अर बावळेपण अर बेकूफी नै भी जाण ल्यूँ। मन्‍नै समझ आया के यो भी हवा नै पकड़ण जिसा सै।<verse eid="ECC 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ECC 1:18" />क्यूँके भोत बुद्धि कै गैल भोत घणे दुख भी होवै सै,</para>
  <para style="q" vid="ECC 1:18">अर जो अपणा ज्ञान बढ़ावै सै वो अपणा दुख भी बढ़ावै सै।<verse eid="ECC 1:18" /></para>
  <chapter eid="ECC 1" />
  <chapter number="2" style="c" sid="ECC 2" />
  <para style="s">सुख बेकार सै</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1" />मन्‍नै अपणे मन तै कह्या, “चाल, मै तेरे ताहीं आनन्द के जरिये जाच्‍चूँगा, इस करकै आनन्दित अर मगन हो।” पर देक्खो, यो भी बेकार सै। <verse eid="ECC 2:1" /><verse number="2" style="v" sid="ECC 2:2" />मन्‍नै हँसी-खुशी कै बारे म्ह कह्या, “यो तो बोळापण सै,” अर आनन्द कै बारे म्ह, “उसतै के मिलै सै?” <verse eid="ECC 2:2" /><verse number="3" style="v" sid="ECC 2:3" />मन्‍नै मन म्ह सोच्या के किस तरियां तै मेरी बुद्धि बणी रहवै अर मै अपणे जी नै दाखमधु पीण तै किस तरियां भळोऊँ अर किस ढाळ बेकूफी नै थाम्मे रहूँ, जिब ताहीं बेरा ना करुँ के वो आच्छा काम कोणसा सै जिस ताहीं माणस अपणी जिन्दगी भर करदा रहवै। <verse eid="ECC 2:3" /><verse number="4" style="v" sid="ECC 2:4" />मन्‍नै बड़े-बड़े काम करे, मन्‍नै अपणे खात्तर घर बणवा लिए अर अपणे खात्तर अंगूर के बाग लगवाऐ; <verse eid="ECC 2:4" /><verse number="5" style="v" sid="ECC 2:5" />मन्‍नै अपणे खात्तर बाग बगीचे लगवा लिए, अर उन म्ह न्यारे-न्यारे ढाळ के फळ लागण आळे दरखत लगाऐ। <verse eid="ECC 2:5" /><verse number="6" style="v" sid="ECC 2:6" />मन्‍नै अपणे खात्तर कुण्ड खुदवा लिए ताके उनतै वो बण सिंच्या जावै जिस म्ह दरखतां ताहीं लगाया जावै था। <verse eid="ECC 2:6" /><verse number="7" style="v" sid="ECC 2:7" />मन्‍नै दास अर दासियाँ खरीद ली, अर मेरे घर म्ह दास भी पैदा होए; अर जितने मेरे तै पैहल्या यरुशलेम म्ह थे उनतै भोत घणी गां-बळध अर भेड़-बकरियाँ का मै माल्‍लिक था। <verse eid="ECC 2:7" /><verse number="8" style="v" sid="ECC 2:8" />मन्‍नै चाँदी अर सोन्‍ना अर राजयां अर प्रान्तां के घणी कीमती चिज्जां ताहीं भी कठ्ठा करया; मन्‍नै अपणे खात्तर गाणिये अर गाण आळियाँ ताहीं राख्या, अर भोत सी कामिनियाँ भी, जिनतै माणस सुख पावै सै, अपणी कर ली।<verse eid="ECC 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 2:9" />इस तरियां मै अपणे तै पैहल्या के सारे यरुशलेम के बासिन्दया तै घणा महान अर साहूकार होग्या; फेर भी मेरी बुद्धि ठिकाणै रही। <verse eid="ECC 2:9" /><verse number="10" style="v" sid="ECC 2:10" />अर जितनी चिज्जां ताहीं देक्खण की मन्‍नै लालसा करी, उन सारया नै देक्खण तै मै न्ही रुक्या; मन्‍नै अपणा मन किसे ढाळ का आनन्द भोग्गण तै न्ही रोक्या क्यूँके मेरा मन मेरी सारी मेहनत कै कारण आनन्दित होया; अर मेरी सारी मेहनत तै मन्‍नै योए भाग मिल्या। <verse eid="ECC 2:10" /><verse number="11" style="v" sid="ECC 2:11" />फेर मन्‍नै दुबारै तै अपणे हाथ्थां के सारे काम्मां ताहीं, अर अपणी सारी मेहनत ताहीं देख्या, तो के देख्या की सब कुछ बेकार अर हवा नै पकड़ण कै बराबर सै, और सूरज कै नीच्‍चै कोए फायदा न्ही।<verse eid="ECC 2:11" /></para>
  <para style="s">बुद्धिमान अर बेकूफ का अन्त</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 2:12" />फेर मन्‍नै अपणे मन ताहीं मोड्या के बुद्धि अर बावळापण अर बेकूफी के काम्मां नै देक्खूँ; क्यूँके जो माणस राजा कै पाच्छै आवैगा, वो के करैगा? बस वोए जो होन्दा चल्या आया सै। <verse eid="ECC 2:12" /><verse number="13" style="v" sid="ECC 2:13" />फेर मन्‍नै देख्या के चाँदणा अँधेरे तै बढ़िया सै, उतणी बुद्धि भी बेकूफी तै बढ़िया सै। <verse eid="ECC 2:13" /><verse number="14" style="v" sid="ECC 2:14" />जो बुद्धिमान सै, उसके सिर म्ह आँख होवै सै, पर बेकूफ अँधेरे म्ह चाल्‍लै सै; फेर भी मन्‍नै जाण लिया के दोनुवां की हालत एक जिसी होवै सै। <verse eid="ECC 2:14" /><verse number="15" style="v" sid="ECC 2:15" />फेर मन्‍नै मन म्ह कह्या, “जिसी बेकूफ की हालत होवैगी, उसीए मेरी भी होवैगी; फेर मै क्यूँ घणा बुद्धिमान होया?” अर मन्‍नै मन म्ह कह्या, यो भी बेकार ए सै। <verse eid="ECC 2:15" /><verse number="16" style="v" sid="ECC 2:16" />क्यूँके ना तो बुद्धिमान की अर ना मूर्ख की यादगारी सदा बणी रहवैगी, पर आण आळे बखत म्ह सारा किमे भूला दिया जावैगा। बुद्धिमान किस तरियां मूर्ख की ढाळ मरै सै! <verse eid="ECC 2:16" /><verse number="17" style="v" sid="ECC 2:17" />इस करकै मन्‍नै अपणी जिन्दगी तै नफरत करी, क्यूँके जो काम सूरज के नीच्‍चै करया जावै सै मन्‍नै बुरा मालुम होया; क्यूँके सारा किमे बेकार अर हवा नै पकड़ण के जिसा सै।<verse eid="ECC 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 2:18" />मन्‍नै अपणे सारे मेहनत के फळ तै जिस ताहीं मन्‍नै सूरज कै नीच्‍चै करया था नफरत करी, क्यूँके जरूरी सै के मै उसका फळ उस माणस की खात्तर छोड़ जाऊँ जो मेरे बाद आवैगा। <verse eid="ECC 2:18" /><verse number="19" style="v" sid="ECC 2:19" />यो कौण जाणै सै के वो माणस बुद्धिमान होवैगा या मूर्ख? फेर भी सूरज कै नीच्‍चै जितनी मेहनत मन्‍नै करी, अर उसकी खात्तर बुद्धि इस्तमाल करी उस सारे का भी वोए अधिकारी होवैगा। यो भी बेकार ए सै। <verse eid="ECC 2:19" /><verse number="20" style="v" sid="ECC 2:20" />फेर मै अपणे मन म्ह उस सारी मेहनत के बारे म्ह जो मन्‍नै सूरज कै नीच्‍चै करी थी निराश होया, <verse eid="ECC 2:20" /><verse number="21" style="v" sid="ECC 2:21" />क्यूँके इसे माणस भी सै, जिसका काम मेहनत अर बुद्धि अर ज्ञान तै होवै सै अर कामयाब भी होवै सै, फेर भी उस ताहीं इसे माणस की खात्तर छोड़ जाणा पड़ै सै, जिसनै उस म्ह कुछ भी मेहनत न्ही करी हो। यो भी बेकार अर भोत-ए बुरा सै। <verse eid="ECC 2:21" /><verse number="22" style="v" sid="ECC 2:22" />माणस जो सूरज कै नीच्‍चै मन लगा-लगा कै मेहनत करै सै उस नै उसतै के फायदा होवै सै? <verse eid="ECC 2:22" /><verse number="23" style="v" sid="ECC 2:23" />उसके जीवन के दिन तो दुखां तै भरे रहवैं सै, अर उसका काम दुख कै गैल होवै सै; रात नै भी उसका मन चैन न्ही पान्दा। यो भी बेकार ए सै।<verse eid="ECC 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ECC 2:24" />माणस कै खात्तर खाण-पीण अर मेहनत करदे होए अपणी जिन्दगी नै सुखी राक्खण के सिवाय और कुछ भी आच्छा कोनी। मन्‍नै देख्या के यो भी परमेसवर की ओड़ तै मिलै सै। <verse eid="ECC 2:24" /><verse number="25" style="v" sid="ECC 2:25" />क्यूँके खाण-पीण म्ह उसतै घणा ताकतवर कौण सै? अर सुख भोग्गण म्ह उसतै<note caller="+" style="f"><char style="fr" closed="false">2:25 </char><char style="fq" closed="false">उसतै </char><char style="ft" closed="false">मेरे तै </char></note> घणा ताकतवर कौण सै? <verse eid="ECC 2:25" /><verse number="26" style="v" sid="ECC 2:26" />जो माणस परमेसवर की निगांह म्ह आच्छा सै, उसनै वो बुद्धि, ज्ञान अर आनन्द देवै सै; पर पापी नै वो दुख भरया काम देवै सै ताके वो उसनै देण खात्तर कठ्ठा करकै ढेर लगावै जो परमेसवर की निगांह म्ह आच्छा हो। यो भी बेकार अर हवा नै पकड़ण के बराबर सै।<verse eid="ECC 2:26" /></para>
  <chapter eid="ECC 2" />
  <chapter number="3" style="c" sid="ECC 3" />
  <para style="s">हर बात का अपणा बखत</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 3:1" />हर एक बात का एक मौक्‍का अर हरेक काम का, जो आसमान कै नीच्‍चै होवै सै, एक बखत सै।<verse eid="ECC 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ECC 3:2" />जन्म का बखत अर मरण का भी बखत;</para>
  <para style="q" vid="ECC 3:2">बोण का बखत, अर बोए होए नै उखाड़ण का भी बखत होवै सै,<verse eid="ECC 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ECC 3:3" />घाव देण का बखत, अर चंगा करण का भी बखत;</para>
  <para style="q" vid="ECC 3:3">गिरा देण का बखत, अर बणाण का भी बखत होवै सै;<verse eid="ECC 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ECC 3:4" />रोण का बखत, अर हाँसण का भी बखत;</para>
  <para style="q" vid="ECC 3:4">छात्ती पीटण का बखत, अर नाचण का भी बखत होवै सै;<verse eid="ECC 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ECC 3:5" />पत्थर फैक्‍कण का बखत, अर पत्थर बटोरण का भी बखत;</para>
  <para style="q" vid="ECC 3:5">गळे लगाण का बखत, अर गळे लगाण तै रुकण का भी बखत होवै सै;<verse eid="ECC 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ECC 3:6" />ढूँढ़ण का बखत अर खो देण का भी बखत;</para>
  <para style="q" vid="ECC 3:6">बचा राक्खण का बखत अर फेंक देण का भी बखत होवै सै;<verse eid="ECC 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ECC 3:7" />पाड़ण का बखत अर सिम्मण का भी बखत;</para>
  <para style="q" vid="ECC 3:7">चुप रहण का बखत अर बोल्‍लण का भी बखत होवै सै;<verse eid="ECC 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ECC 3:8" />प्यार करण का बखत अर बैर करण का भी बखत;</para>
  <para style="q" vid="ECC 3:8">लड़ाई का बखत अर मेल का भी बखत होवै सै।<verse eid="ECC 3:8" /></para>
  <para style="s">परमेसवर जरिये दिया गया काम</para>
  <para style="q">
    <verse number="9" style="v" sid="ECC 3:9" />काम करण आळे नै अपणी मेहनत तै के फायदा होवै सै?<verse eid="ECC 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 3:10" />मन्‍नै उस दुख भरे काम ताहीं देख्या सै जो परमेसवर नै माणसां कै खात्तर ठहराया सै ताके वे उस म्ह लाग्गे रहवै। <verse eid="ECC 3:10" /><verse number="11" style="v" sid="ECC 3:11" />उसनै सारा किमे इसा बणाया के अपणे-अपणे बखत पै वे सुन्दर होवै सै; फेर उस नै माणसां के मन म्ह सारे तै पैहला अर सदा काल तक का ज्ञान पैदा करया सै, फेर भी जो काम परमेसवर नै करया सै, वो शरु तै आखिर तक माणस समझ न्ही सकदा। <verse eid="ECC 3:11" /><verse number="12" style="v" sid="ECC 3:12" />मन्‍नै जाण लिया सै के माणसां कै खात्तर आनन्द करण अर जिन्दगी भर भलाई करण के सिवाए, और किमे भी आच्छा न्ही; <verse eid="ECC 3:12" /><verse number="13" style="v" sid="ECC 3:13" />अर यो भी परमेसवर का दान सै के माणस खावै-पीवै अर अपणी सारी मेहनत म्ह सुखी रहवै। <verse eid="ECC 3:13" /><verse number="14" style="v" sid="ECC 3:14" />मै जाणु सूं के जो किमे परमेसवर करै सै वो सदा टिक्या रहवैगा; ना तो उस म्ह किमे बढ़ाया जा सकै सै अर ना किमे घटाया जा सकै सै; परमेसवर इसा इस करकै करै सै के लोग उसका भय मान्‍नै। <verse eid="ECC 3:14" /><verse number="15" style="v" sid="ECC 3:15" />जो कुछ होया वो इसतै पैहल्या भी हो चुक्या; जो होणआळा सै, वो हो भी चुक्या सै; अर परमेसवर बीत्ती होई बात नै फेर पूच्छै सै।<verse eid="ECC 3:15" /></para>
  <para style="s">अन्याय का हावी होणा</para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 3:16" />फेर मन्‍नै सूरज कै नीच्‍चै के देख्या के न्याय की जगहां म्ह दुष्टता होवै सै, अर धार्मिकता की जगहां म्ह भी दुष्टता होवै सै। <verse eid="ECC 3:16" /><verse number="17" style="v" sid="ECC 3:17" />मन्‍नै मन म्ह कह्या, “परमेसवर धर्मी अर दुष्ट दोनुवां का न्याय करैगा,” क्यूँके उसके ओड़ै एक-एक बात कै बारे म्ह अर एक-एक काम का बखत सै। <verse eid="ECC 3:17" /><verse number="18" style="v" sid="ECC 3:18" />मन्‍नै मन म्ह कह्या, “यो इस करकै होवै सै के परमेसवर माणसां नै परखै अर वो देख सकै के वे पशुआं बरगे सैं।” <verse eid="ECC 3:18" /><verse number="19" style="v" sid="ECC 3:19" />क्यूँके जिसी माणसां की उसीए पशुआं की भी हालत होवै सै; दोनुवां की वोए हालत होवै सै, जिस तरियां एक मरै उसे तरियां ए दूसरा भी मरै सै। सारया की साँस एक जिसी सै, अर माणस पशु तै किमे बढ़कै न्ही; सारा किमे बेकार सै। <verse eid="ECC 3:19" /><verse number="20" style="v" sid="ECC 3:20" />सारे एक जगहां म्ह जावै सैं; सारे माट्टी तै बणे सैं, अर सारे माट्टी म्ह फेर मिल जावै सैं। <verse eid="ECC 3:20" /><verse number="21" style="v" sid="ECC 3:21" />के माणस का जी उप्पर की ओड़ चढ़ै सै अर पशुआं का जी नीच्‍चै की ओड़ जाकै माट्टी म्ह मिल जावै सै? यो कौण जाणै सै? <verse eid="ECC 3:21" /><verse number="22" style="v" sid="ECC 3:22" />आखर मन्‍नै यो देख्या के इसतै घणा किमे आच्छा न्ही के माणस अपणे काम्मां म्ह राज्जी रहवै, क्यूँके उसका भाग योए सै; कौण उसके बाद आण आळी बात्तां नै देक्खण कै खात्तर उस ताहीं बोहड़ा ल्यावैगा?<verse eid="ECC 3:22" /></para>
  <chapter eid="ECC 3" />
  <chapter number="4" style="c" sid="ECC 4" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 4:1" />फेर मन्‍नै वो सारा अंधेर देख्या जो सूरज कै नीच्‍चै होवै सै। अर के देख्या, के अंधेर सहण आळयां के आँसू बहण लागरे सै, अर उन ताहीं कोए शान्ति देण आळा कोनी! अंधेर करण आळयां के हाथ म्ह ताकत थी, पर उन ताहीं कोए शान्ति देण आळा न्ही था। <verse eid="ECC 4:1" /><verse number="2" style="v" sid="ECC 4:2" />इस करकै मन्‍नै मरे होयां ताहीं जो मरगें सै, उन जिन्दयां तै जो इब तक जिन्दा सै घणा धन्य कह्या; <verse eid="ECC 4:2" /><verse number="3" style="v" sid="ECC 4:3" />बल्के उन दोनुवां तै घणा आच्छा वो सै जो इब ताहीं पैदा ए न्ही होया, ना ये बुरे काम देक्खे जो सूरज कै नीच्‍चै होवै सै।<verse eid="ECC 4:3" /></para>
  <para style="s">मतलबी मेहनत भी बेकार सै</para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 4:4" />फेर मन्‍नै सारे मेहनत के काम अर सारे सफल काम्मां ताहीं देख्या जो लोग अपणे पड़ोसी तै जळण कै कारण करै सै। यो भी बेकार अर हवा नै पकड़ण के जिसा सै।<verse eid="ECC 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 4:5" />बेकूफ छात्ती पै हाथ धरे रहवै अर मान्‍नो बिना काम करे अपणे आप नै खतम करै सै<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="ft" closed="false">अपणा ए माँस खावै सै</char></note>।<verse eid="ECC 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 4:6" />चैन की गैल एक मुट्ठी उन दो मुट्ठियाँ तै आच्छी सै, जिनकी गैल मेहनत अर हवा नै पकड़णा हो।<verse eid="ECC 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 4:7" />फेर मन्‍नै सूरज कै नीच्‍चै यो भी बेकार बात देक्खी। <verse eid="ECC 4:7" /><verse number="8" style="v" sid="ECC 4:8" />कोए एक्ला रहवै अर उसका कोए न्ही सै; ना उसका बेट्टा सै, ना भाई सै, फेर भी उसकी मेहनत का अन्त न्ही होन्दा; ना उसकी आँख धन तै छिकदी, अर ना वो कहवै सै, मै किसकी खात्तर मेहनत करुँ अर अपणी जिन्दगी नै दुखी राक्खूँ सूं? यो भी बेकार अर कती दुख भरया काम सै।<verse eid="ECC 4:8" /></para>
  <para style="s">मित्तर का मोल</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 4:9" />एक तै दो भले सै, क्यूँके उनकी मेहनत का आच्छा फळ मिलै सै। <verse eid="ECC 4:9" /><verse number="10" style="v" sid="ECC 4:10" />क्यूँके जै उन म्ह तै एक गिरै, तो दूसरा उस नै ठावैगा; पर हाय उसपै जो एक्ला होकै गिरै अर उसका कोए ठाणिया ना हो। <verse eid="ECC 4:10" /><verse number="11" style="v" sid="ECC 4:11" />फेर जै दो जणे कठ्ठे सोवै तो वे गरम रहवैंगे, पर कोए एक्ला किस तरियां गरम हो सकै सै? <verse eid="ECC 4:11" /><verse number="12" style="v" sid="ECC 4:12" />जै कोए एक्ले पै हावी हो तो हो, पर दो उसका मुकाबला कर सकैगें। जो डोरी तीन ताघयां तै बटी हो तो वो ताव्ळी न्ही टूटदी।<verse eid="ECC 4:12" /></para>
  <para style="s">मशहुर होन्दे जाणा</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 4:13" />बुद्धिमान जवान गरीब होण पै भी इसे बूढ़े अर बेकूफ राजा तै घणा बढ़िया सै जो सलाह न्ही लेन्दा, <verse eid="ECC 4:13" /><verse number="14" style="v" sid="ECC 4:14" />चाहे वो उसके राज्य म्ह गरीब पैदा होया हो, या जेळ म्ह तै लिकड़कै राजा बण्या हो। <verse eid="ECC 4:14" /><verse number="15" style="v" sid="ECC 4:15" />मन्‍नै सारे जिन्दयां ताहीं जो सूरज कै नीच्‍चै चाल्‍लै-फिरै सै देख्या के वे उस राजा बणाण आळे जवान कै गैल हो लिये सै जो उनकी जगहां लेण की खात्तर खड्या होया। <verse eid="ECC 4:15" /><verse number="16" style="v" sid="ECC 4:16" />वे सारे माणस अनगिणत थे जिनपै वो प्रधान होया था। फेर भी आण आळे बखत म्ह नई पीढ़ी के माणस उसके कारण खुश न्ही होवैंगे। बे-शक यो भी बेकार अर हवा नै पकड़णा सै।<verse eid="ECC 4:16" /></para>
  <chapter eid="ECC 4" />
  <chapter number="5" style="c" sid="ECC 5" />
  <para style="s">परमेसवर का भय मानणा अर मन्‍नत ताहीं पूरा करणा</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 5:1" />जिब तू परमेसवर के भवन म्ह जावै, तो सावधानी तै चालिये; सुणण कै खात्तर धोरै जाणा बेकूफां के बलिदान चढ़ाण तै आच्छा सै; क्यूँके वे न्ही जाणदे के बुरा करै सै। <verse eid="ECC 5:1" /><verse number="2" style="v" sid="ECC 5:2" />बात करण म्ह जल्दबाजी ना करिये, अर ना अपणे मन तै कोए बात जल्दबाजी तै परमेसवर कै स्याम्ही बोलिये, क्यूँके परमेसवर सुर्ग म्ह सै अर तू धरती पै सै; इस करकै तेरे शब्द थोड़े ए हो।<verse eid="ECC 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 5:3" />क्यूँके जिस तरियां घणे काम के कारण सपना देख्या जावै सै, उसे तरियां ए घणी बात्तां का बोलण आळा बेकूफ ठहरै सै।<verse eid="ECC 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 5:4" />जिब तू परमेसवर कै खात्तर मन्‍नत मान्‍नै, तो उसनै पूरा करण म्ह देर ना करिये; क्यूँके वो बेकूफां तै खुश न्ही होन्दा। जो मन्‍नत तन्‍नै मान्‍नी हो उस ताहीं पूरी करिये। <verse eid="ECC 5:4" /><verse number="5" style="v" sid="ECC 5:5" />मन्‍नत मान कै पूरी ना करण तै मन्‍नत का ना मानणा ए भला सै। <verse eid="ECC 5:5" /><verse number="6" style="v" sid="ECC 5:6" />कोए शब्द कहकै अपणे आप नै पाप म्ह ना फँसाइये, अर ना परमेसवर के दूत कै स्याम्ही कहिये के यो भूल तै होया; परमेसवर क्यूँ तेरा बोल सुणकै गुस्सा हो, अर तेरे हाथ के काम्मां नै नाश करै?<verse eid="ECC 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 5:7" />क्यूँके सपने घणे होण तै बेकार बात्तां की बढ़ोतरी होवै सै: पर तू परमेसवर का भय मानिये।<verse eid="ECC 5:7" /></para>
  <para style="s">पा लेणा अर सम्मान की व्यर्थता</para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 5:8" />जै तू किसे प्रान्त म्ह गरीबां पै अंधेर अर न्याय अर धर्म नै बिगड़दा देक्खै, तो इसतै अचम्भित न्ही होणा; क्यूँके एक अधिकारी तै बड़ा दूसरा रहवै सै जिस ताहीं इन बात्तां की जानकारी रहवै सै, अर उनतै भी बड़े अधिकारी रहवै सै। <verse eid="ECC 5:8" /><verse number="9" style="v" sid="ECC 5:9" />धरती की पैदावार सारया की खात्तर सै, बल्के खेत्ती तै राजा का भी काम चाल्‍लै सै।<verse eid="ECC 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 5:10" />जो रपियाँ तै प्यार करै सै वो रपियाँ तै कोनी छिकैगा; अर ना जो घणे धन तै प्यार करै सै, मुनाफै तै, यो भी बेकार सै।<verse eid="ECC 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 5:11" />जिब धन-सम्पत्ति बढै़ सै, तो उसके खाणआळे भी बढै़ सै, फेर उसके माल्‍लिक नै इस ताहीं छोड़ और के फायदा होवै सै के उस धन-सम्पत्ति नै अपणी आँखां तै देक्खै?<verse eid="ECC 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 5:12" />मेहनत करण आळा चाहे थोड़ा खावै, या घणा, तोभी उसकी नींद सुखदाई होवै सै; पर धनी के धन बढ़ण के कारण उस नै नींद न्ही आन्दी।<verse eid="ECC 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 5:13" />मन्‍नै सूरज कै नीच्‍चै एक बड़ी बुरी बला देक्खी सै; यानी वो धन जिस ताहीं उसके माल्‍लिक नै अपणे नुकसान कै खात्तर राख्या हो, <verse eid="ECC 5:13" /><verse number="14" style="v" sid="ECC 5:14" />अर वो धन किसे नुकसान के काम म्ह उड़ जावै सै; अर उसके घर म्ह बेट्टा पैदा होवै सै पर उसके हाथ म्ह बेट्टे तै देण तांई कुछ न्ही रहन्दा। <verse eid="ECC 5:14" /><verse number="15" style="v" sid="ECC 5:15" />जिसा वो माँ के पेट तै लिकड्या उसाए लौट जावैगा; जिसा खाल्‍ली हाथ आया था, अर अपणे मेहनत के बदले किमे भी न्ही पावैगा जिस ताहीं वो अपणे हाथ म्ह ले जा सकै। <verse eid="ECC 5:15" /><verse number="16" style="v" sid="ECC 5:16" />यो भी एक बड़ी बला सै के जिसा वो आया, ठीक उसाए वो जावैगा; उस नै उस बेकार मेहनत तै और के फायदा सै क्यूँके वे हवा नै पकड़ण म्ह मेहनत करे सै? <verse eid="ECC 5:16" /><verse number="17" style="v" sid="ECC 5:17" />सिर्फ इसके के वो जिन्दगी भर अन्धकार म्ह जीवै सै<note caller="+" style="f"><char style="fr" closed="false">5:17 </char><char style="fq" closed="false">अन्धकार म्ह जीवै सै </char><char style="ft" closed="false">अन्धकार म्ह खाणा खावै सै</char></note>, अर भोत दुखी अर रोगी रहया अर गुस्सा भी करदा रहया?<verse eid="ECC 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 5:18" />सुण, जो भली बात मन्‍नै देक्खी सै, बल्के जो सही सै, वो या के माणस खावै-पीवै अर अपणी मेहनत तै जो वो सूरज कै नीच्‍चै करै सै, अपणी सारी उम्र भर जो परमेसवर नै उस ताहीं दी सै, सुखी रहवै क्यूँके उसका भाग योए सै। <verse eid="ECC 5:18" /><verse number="19" style="v" sid="ECC 5:19" />बल्के हर एक माणस जिस ताहीं परमेसवर नै धन-सम्पत्ति दी हो, अर उनतै आनन्द भोग्गण अर उस म्ह तै अपणा भाग लेण अर मेहनत करदे होए खुशी मनाण की शक्ति भी दी हो यो परमेसवर का वरदान सै। <verse eid="ECC 5:19" /><verse number="20" style="v" sid="ECC 5:20" />उसकी जिन्दगी के घणखरे दिन उसनै याद कोनी रहवैंगे, क्यूँके परमेसवर उसनै उन चिज्जां म्ह व्यस्त राक्खै सै जिन ताहीं उसनै करण म्ह खुशी मिलै सै।<verse eid="ECC 5:20" /></para>
  <chapter eid="ECC 5" />
  <chapter number="6" style="c" sid="ECC 6" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1" />एक बुराई जो मन्‍नै सूरज कै नीच्‍चै देक्खी सै, वो माणसां नै घणी भारी लाग्गै सै: <verse eid="ECC 6:1" /><verse number="2" style="v" sid="ECC 6:2" />किसे माणस नै परमेसवर धन-सम्पत्ति अर मान-बड़ाई उरै तक देवै सै, के जो किमे उसका मन चाहवै सै उसनै उसकी किमे भी घटी न्ही होन्दी, फेर भी परमेसवर उसनै उस म्ह तै खाण न्ही देन्दा, कोए दूसरा ए माणस उसनै खावै सै; या बेकार अर बड़े दुख की बात सै। <verse eid="ECC 6:2" /><verse number="3" style="v" sid="ECC 6:3" />जै किसे माणस के सौ बेट्टे हो, अर वो घणे साल जिन्दा रहवै अर उसकी उम्र बढ़ जावै, पर ना उसका जी राज्जी रहवै अर ना उसकी आखरी रसम पूरी करी जावै, तो मै कहूँ सूं के इसे माणस तै आध्धे बखत का जाम्या होया बच्‍चा आच्छा सै। <verse eid="ECC 6:3" /><verse number="4" style="v" sid="ECC 6:4" />क्यूँके वो बच्‍चा बेकार ए आया अर अँधेरे म्ह चल्या गया, अर उसका नाम भी अँधेरे म्ह छिप ग्या; <verse eid="ECC 6:4" /><verse number="5" style="v" sid="ECC 6:5" />अर ना सूरज ताहीं देख्या, ना किसे चीज नै जाणण पाया, फेर भी इसनै उस माणस तै घणा चैन मिल्या। <verse eid="ECC 6:5" /><verse number="6" style="v" sid="ECC 6:6" />हाँ चाहे वो दो हजार साल जिन्दा रहवै, अर किमे सुख भोग्गण न्ही पावै, तो उस नै के? के सारे के सारे एके जगहां म्ह न्ही जान्दे?<verse eid="ECC 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 6:7" />माणस की सारी मेहनत उसके पेट कै खात्तर होवै सै फेर भी उसका मन न्ही भरदा। <verse eid="ECC 6:7" /><verse number="8" style="v" sid="ECC 6:8" />जो बुद्धिमान सै वो बेकूफ तै किस बात म्ह बढ़कै सै? अर कंगाल जो यो जाणै सै के इस जिन्दगी म्ह किस ढाळ तै चालणा चाहिये, वो भी उसतै किस बात म्ह बढ़कै सै? <verse eid="ECC 6:8" /><verse number="9" style="v" sid="ECC 6:9" />आँख्यां तै देखणा मन की चंचलता तै बढ़कै सै: यो भी बेकार अर हवा नै पकड़णा सै।<verse eid="ECC 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 6:10" />जो किमे होया सै उसका नाम युग की शरुआत तै धरया गया सै, अर यो जाहिर सै के माणस सिर्फ माट्टी सै, ताके माणस उसतै जो उसतै घणा शक्तिमान सै झगड़ा न्ही कर सकदा। <verse eid="ECC 6:10" /><verse number="11" style="v" sid="ECC 6:11" />भोत सी इसी बात सै जिनकै कारण जिन्दगी और भी बेकार होवै सै तो फेर माणस नै के फायदा? <verse eid="ECC 6:11" /><verse number="12" style="v" sid="ECC 6:12" />क्यूँके माणस का हरेक पल बेकार जिन्दगी म्ह जो वो छाया की तरियां बितावै सै कौण जाणै सै, के उसकै खात्तर के आच्छा सै? क्यूँके माणस नै कौण बता सकै सै के उसके मरण कै बाद सूरज कै नीच्‍चै के होवैगा?<verse eid="ECC 6:12" /></para>
  <chapter eid="ECC 6" />
  <chapter number="7" style="c" sid="ECC 7" />
  <para style="s">ज्ञान का मोल</para>
  <para style="q">
    <verse number="1" style="v" sid="ECC 7:1" />आच्छा नाम अनमोल इत्र तै अर मौत का दिन जन्म के दिन तै बढ़िया सै।<verse eid="ECC 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ECC 7:2" />दावत के घर म्ह जाण तै दुख के घर म्ह जाणा आच्छा सै;</para>
  <para style="q" vid="ECC 7:2">क्यूँके सारे माणसां का अन्त योए सै,</para>
  <para style="q" vid="ECC 7:2">अर जो जिन्दा सै वो मन लगाकै इसकै बारे म्ह सोच्‍चैगा।<verse eid="ECC 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ECC 7:3" />हाँस्सी तै दुख आच्छा सै, क्यूँके मुँह की उदासी तै मन सुधरै सै।<verse eid="ECC 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ECC 7:4" />बुद्धिमानां का मन शोक करण आळयां के घर की ओड़ लाग्या रहवै सै</para>
  <para style="q" vid="ECC 7:4">पर बेकूफां का मन आनन्द करण आळयां के घर की ओड़ लाग्या रहवै सै।<verse eid="ECC 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ECC 7:5" />बेकूफां के गीत सुणण तै बुद्धिमान की फटकार सुणनी आच्छी सै।<verse eid="ECC 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ECC 7:6" />क्यूँके बेकूफ की हाँस्सी चूल्हे पै धरी हाण्डी कै नीच्‍चै जळदे होए काँडण्यां की चरड़-चरड़ की तरियां होवै सै;</para>
  <para style="q" vid="ECC 7:6">यो भी बेकार सै।<verse eid="ECC 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ECC 7:7" />जरुर अंधेर तै बुद्धिमान बावळा हो जावै सै;</para>
  <para style="q" vid="ECC 7:7">और रिसवत लेण आळे की बुद्धि नाश होज्या सै।<verse eid="ECC 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ECC 7:8" />किसे काम की शरुआत तै उसका अन्त बढ़िया सै;</para>
  <para style="q" vid="ECC 7:8">और समाई राक्खणीया माणस घमण्डी तै बढ़िया हो सै।<verse eid="ECC 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ECC 7:9" />अपणे मन म्ह ताव्ळी तै गुस्सा ना हो,</para>
  <para style="q" vid="ECC 7:9">क्यूँके गुस्सा बेकूफां ए के मन म्ह रहवै सै।<verse eid="ECC 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ECC 7:10" />न्यू ना कहिये, “बीत्ते दिन इन दिनां तै क्यूँ बढ़िया थे?”</para>
  <para style="q" vid="ECC 7:10">क्यूँके यो तू बुद्धिमानी तै न्ही पूछदा।<verse eid="ECC 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ECC 7:11" />बुद्धि विरासत कै गैल आच्छी होवै सै,</para>
  <para style="q" vid="ECC 7:11">बल्के जगत मै जिन्दा रहण आळयां कै खात्तर फायदेमन्द सै।<verse eid="ECC 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ECC 7:12" />क्यूँके बुद्धि की आड़ रपियाँ की आड़ का काम देवै सै;</para>
  <para style="q" vid="ECC 7:12">पर ज्ञान की श्रेष्ठता या सै के बुद्धि तै उसके राक्खणीया के प्राण की हिफाजत होवै सै।<verse eid="ECC 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ECC 7:13" />परमेसवर के काम पै निगांह कर; जिस चीज ताहीं उसनै टेढ़ा करया हो उस ताहीं कौण सीध्धा कर सकै सै?<verse eid="ECC 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ECC 7:14" />सुख के दिन खुशी मना, और दुख के दिन सोच विचार कर;</para>
  <para style="q" vid="ECC 7:14">क्यूँके परमेसवर नै दोनुवां ताहीं एक साथ राख्या सै, जिसतै माणस अपणे बाद होण आळी किसे बात नै न्ही समझ सकै।<verse eid="ECC 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ECC 7:15" />अपणी बेकार जिन्दगी म्ह मन्‍नै यो सारा किमे देख्या सै;</para>
  <para style="q" vid="ECC 7:15">कोए धर्मी अपणे धार्मिकता के काम करदे होए नाश हो ज्या सै,</para>
  <para style="q" vid="ECC 7:15">अर दुष्ट बुराई करदे होए लाम्बी उम्र पावै सै।<verse eid="ECC 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 7:16" />अपणे आप नै घणा धर्मी ना बणाईये और ना अपणे आप नै घणा बुद्धिमान बणा; तू क्यूँ अपणा ए नाश का कारण हो? <verse eid="ECC 7:16" /><verse number="17" style="v" sid="ECC 7:17" />घणा दुष्ट भी ना बणै, अर ना बेकूफ बण; तू क्यूँ अपणे बखत तै पैहला मरै? <verse eid="ECC 7:17" /><verse number="18" style="v" sid="ECC 7:18" />यो आच्छा सै के तू इस बात नै पकड़े रहवै; अर उस बात पै तै भी हाथ न्ही ठावै; क्यूँके जो परमेसवर का भय मान्‍नै सै वो इन सारी मुसीबतां तै पार हो जावैगा।<verse eid="ECC 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ECC 7:19" />बुद्धि तै ए बुद्धिमान माणस नगर के दस हाकिमां तै घणा ताकतवर सै। <verse eid="ECC 7:19" /><verse number="20" style="v" sid="ECC 7:20" />बे-शक धरती पै कोए इसा धर्मी माणस न्ही जो भलाई ए करै अर जिसतै पाप न्ही होया हो।<verse eid="ECC 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ECC 7:21" />जितनी बात कही जावै सारे पै कान ना लगाईये, इसा ना हो के तू सुणै के तेरा दास तन्‍नै ए श्राप देवै सै; <verse eid="ECC 7:21" /><verse number="22" style="v" sid="ECC 7:22" />क्यूँके तू आप जाणै सै के तन्‍नै भी भोत बार औरां तै श्राप दिया सै।<verse eid="ECC 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ECC 7:23" />यो सारे मन्‍नै बुद्धि तै जाँच लिया सै; मन्‍नै कह्या, “मै बुद्धिमान हो जाऊँगा,” पर यो मेरे तै दूर रहया। <verse eid="ECC 7:23" /><verse number="24" style="v" sid="ECC 7:24" />वो जो दूर अर भोत घणा गहरा सै, उसका भेद कौण पा सकै सै? <verse eid="ECC 7:24" /><verse number="25" style="v" sid="ECC 7:25" />मन्‍नै अपणा मन लगाया के बुद्धि कै बारे म्ह जाण ल्यूँ; के टोह ल्यूँ अर उसका भेद जाणु, के दुष्टता की मूर्खता अर मूर्खता जो जमाए बावळापण सै, उस ताहीं जाणु। <verse eid="ECC 7:25" /><verse number="26" style="v" sid="ECC 7:26" />अर मन्‍नै मौत तै भी घणी दुखदाई एक चीज पाई, यानी वो जनान्‍नी जिसका मन फंदा अर जाळ सै और जिसके हाथ हथकड़ी सै; जिस माणस तै परमेसवर खुश सै वोए उसतै बचैगा, पर पापी उसका शिकार होवैगा। <verse eid="ECC 7:26" /><verse number="27" style="v" sid="ECC 7:27" />देख, उपदेशक कह सै, मन्‍नै ज्ञान कै कारण न्यारी-न्यारी बात मिलाकै परखी, अर यो बात काड्डी, <verse eid="ECC 7:27" /><verse number="28" style="v" sid="ECC 7:28" />जिस ताहीं मेरा मन इब तक टोह्ण लाग रहया सै, पर न्ही पाई। हजार म्ह तै मन्‍नै एक माणस पाया, पर उन म्ह एक भी जनान्‍नी न्ही पाई। <verse eid="ECC 7:28" /><verse number="29" style="v" sid="ECC 7:29" />देक्खो, मन्‍नै केवल यो बात पाई सै, के परमेसवर नै माणस ताहीं सीध्धा बणाया, पर उननै भोत घणी तरकीब काड्डी सै।<verse eid="ECC 7:29" /></para>
  <chapter eid="ECC 7" />
  <chapter number="8" style="c" sid="ECC 8" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 8:1" />बुद्धिमान कै बराबर कौण सै? अर किसे बात का मतलब कौण बता सकै सै? माणस की बुद्धि कै कारण उसका मुँह चमकै, अर उसके मुँह की कठोरता दूर हो ज्या सै।<verse eid="ECC 8:1" /></para>
  <para style="s">राजा का हुकम मान</para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 8:2" />मै तेरे ताहीं सलाह देऊँ सूं के परमेसवर की कसम कै कारण राजा के हुकम मान। <verse eid="ECC 8:2" /><verse number="3" style="v" sid="ECC 8:3" />राजा कै स्याम्ही जल्दबाजी म्ह ना बोहड़िये अर ना बुरी बात की जिद करिये, क्यूँके राजा जो किमे चाहवै सै वोए करै सै। <verse eid="ECC 8:3" /><verse number="4" style="v" sid="ECC 8:4" />क्यूँके राजा के शब्दां म्ह तो ताकत होवै सै, अर कौण उसतै कह सकै सै के तू के करै सै? <verse eid="ECC 8:4" /><verse number="5" style="v" sid="ECC 8:5" />जो राजा के हुकम नै मान्‍ने सै, वो मुसीबत तै बचैगा, अर बुद्धिमान का मन बखत अर न्याय का भेद जाणै सै। <verse eid="ECC 8:5" /><verse number="6" style="v" sid="ECC 8:6" />क्यूँके हर एक बात का बखत अर नियम होवै सै, फेर भी माणस का दुख उसकै खात्तर भोत घणा भारी होवै सै। <verse eid="ECC 8:6" /><verse number="7" style="v" sid="ECC 8:7" />वो न्ही जाणदा के होण आळा सै, अर कद होवैगा? यो उसनै कौण बता सकै सै? <verse eid="ECC 8:7" /><verse number="8" style="v" sid="ECC 8:8" />इसा कोए माणस न्ही जिसका वश प्राण पै चाल्‍ले के वो उस ताहीं लिकड़दे बखत रोक ले, अर ना कोए मौत के दिन पै अधिकारी होया सै; अर ना उस ताहीं लड़ाई तै छुट्टी मिल सकै सै, अर ना दुष्ट माणस अपणी दुष्टता कै कारण बच सकै सै। <verse eid="ECC 8:8" /><verse number="9" style="v" sid="ECC 8:9" />जितने काम सूरज कै नीच्‍चै करे जावैं सै उन सारे नै ध्यान तै देक्खण म्ह यो सारा किमे मन्‍नै देख्या, और यो भी देख्या के एक माणस दुसरे माणस पै अधिकारी होकै अपणे उप्पर हानि ल्यावै सै।<verse eid="ECC 8:9" /></para>
  <para style="s">दुष्ट अर धर्मी</para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 8:10" />फेर मन्‍नै दुष्टां ताहीं मरकै गाड्डे जान्दे देख्या, जो पवित्र स्‍थान म्ह आया-जाया करया करदे, अर जिस नगर म्ह वे प्रशंसा करया करदे ओड़ैए वे दफनाये गए<note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="fq" closed="false">वे दफनाये गए </char><char style="ft" closed="false">उनकी याद भी न्ही रही</char></note>; यो भी बेकार ए सै। <verse eid="ECC 8:10" /><verse number="11" style="v" sid="ECC 8:11" />बुरे काम की सजा का हुकम जल्दबाजी म्ह न्ही दिया जान्दा; इस कारण माणसां का मन बुरा काम करण की इच्छा तै भरया रहवै सै। <verse eid="ECC 8:11" /><verse number="12" style="v" sid="ECC 8:12" />चाहे पापी सौ बार पाप करै अपणे दिन भी बढ़ावै, तोभी मन्‍नै यकिन सै के जो परमेसवर तै डरै सै अर उस ताहीं स्याम्ही जाणकै भय तै चाल्‍लै सै, उनका भलाए होवैगा; <verse eid="ECC 8:12" /><verse number="13" style="v" sid="ECC 8:13" />पर दुष्ट का भला न्ही होण का, अर ना उसकी जीवनरूपी छाया लाम्बी होण पावैगी, क्यूँके वो परमेसवर का भय न्ही मान्दा।<verse eid="ECC 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 8:14" />एक बेकार बात धरती पै होवै सै, यानी इस तरियां के धर्मी सै जिनकी वो हालत होवै सै जो दुष्टां की होणी चाहिये, अर इस तरियां के दुष्ट सै जिनकी इसी दशा होवै सै जो धर्मियाँ की होणी चाहिये। मन्‍नै कह्या के यो भी बेकार ए सै। <verse eid="ECC 8:14" /><verse number="15" style="v" sid="ECC 8:15" />फेर मन्‍नै खुशी ताहीं सराहया, क्यूँके सूरज कै नीच्‍चै माणसां कै खात्तर खाण-पीण अर खुशी मनाण नै छोड़ और किमे भी आच्छा कोनी, क्यूँके योए उसकी जिन्दगी भर जो परमेसवर नै उसकै खात्तर सूरज कै नीच्‍चै ठहराया, उसकी मेहनत म्ह उसकै गैल बण्या रहवैगा।<verse eid="ECC 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 8:16" />जिब मन्‍नै बुद्धि प्राप्त करण अर सारे काम देक्खण कै खात्तर जो धरती पै करे जावैं सै अपणा मन लगाया, के किस तरियां माणस रात-दिन जागदे रहवैं सैं; <verse eid="ECC 8:16" /><verse number="17" style="v" sid="ECC 8:17" />फेर मन्‍नै परमेसवर का सारा काम देख्या जो सूरज कै नीच्‍चै करया जावै सै, उसकी थाह माणस न्ही पा सकदा। चाहे माणस उसकी खोज म्ह कितनी भी मेहनत करै, फेर भी उस ताहीं न्ही जाण पावैगा; अर फेर भी जै बुद्धिमान कहवै भी के मै उस ताहीं समझूगाँ, तोभी वो उस ताहीं न्ही पा सकैगा।<verse eid="ECC 8:17" /></para>
  <chapter eid="ECC 8" />
  <chapter number="9" style="c" sid="ECC 9" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1" />यो सारा किमे मन्‍नै मन लगाकै सोच्या के इन सारी बात्तां का भेद पाऊँ, के किस तरियां धर्मी अर बुद्धिमान माणस अर उनके काम परमेसवर के हाथ म्ह सै; माणस कै आग्गै सारी तरियां की बात सै पर वो न्ही जाणदा के वो प्यार सै या नफरत। <verse eid="ECC 9:1" /><verse number="2" style="v" sid="ECC 9:2" />सारी बात सारया कै खात्तर बराबर होवै सै, धर्मी हो या दुष्ट, भले, शुद्ध या अशुद्ध, यज्ञ करण अर ना करण आळे, सारया की हालत एक जिसी होवै सै। जिसी भले माणस की हालत, उसीए पापी की हालत; जिसी कसम, खाण आळे की हालत, उसीए उसकी जो कसम, खाण तै डरै सै। <verse eid="ECC 9:2" /><verse number="3" style="v" sid="ECC 9:3" />जो किमे सूरज कै नीच्‍चै करया जावै सै उस म्ह यो एक दोष सै के सारे माणसां की एक जिसी हालत होवै सै; अर माणसां के मनां म्ह बुराई भरी होई सै, अर जिब ताहीं वे जिन्दा रहवै सै उनके मन म्ह बावळापण रहवै सै, अर उसकै बाद वे मरे होया म्ह जा मिलै सै। <verse eid="ECC 9:3" /><verse number="4" style="v" sid="ECC 9:4" />पर जो सारे जिन्दयां म्ह सै, उस ताहीं उम्मीद सै, क्यूँके जिन्दा कुत्ता मरे होए शेर तै बढ़कै सै। <verse eid="ECC 9:4" /><verse number="5" style="v" sid="ECC 9:5" />क्यूँके जिन्दे माणस तो इतणा जाणै सै के वे मरैगें, पर मरे होए कुछ भी न्ही जाणदे, अर ना उन ताहीं कुछ और बदला मिल सकै सै, क्यूँके उनकी याद मिट ग्यी सै। <verse eid="ECC 9:5" /><verse number="6" style="v" sid="ECC 9:6" />उनका प्यार अर उनका बैर अर उनकी जळण नाश हो ली, अर इब जो कुछ सूरज कै नीच्‍चै करया जावै सै उस म्ह सदा कै खात्तर उनका और कोए हिस्‍सा न्ही होवैगा।<verse eid="ECC 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 9:7" />अपणी राह पै चल्या जा, अपणी रोट्टी खुशी तै खाया कर, अर मन म्ह सुख मान कै अपणा दाखमधु पिया कर; क्यूँके परमेसवर तेरे काम्मां तै खुश हो चुक्या सै।<verse eid="ECC 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 9:8" />तेरे कपड़े हमेशा चमकदे रहवै, अर तेरे सिर पै अभिषेक के तेल की कमी ना हो।<verse eid="ECC 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 9:9" />अपणी बेकार जिन्दगी के सारे दिन जो उसनै सूरज कै नीच्‍चै तेरै खात्तर ठहराए सै अपणी प्यारी पत्नी कै गैल म्ह बिताणा, क्यूँके तेरी जिन्दगी अर तेरी मेहनत म्ह जो तू सूरज कै नीच्‍चै करै सै तेरा योए हिस्‍सा सै। <verse eid="ECC 9:9" /><verse number="10" style="v" sid="ECC 9:10" />जो काम तन्‍नै मिलै उस ताहीं अपणा मन लगाकै करिये, क्यूँके अधोलोक म्ह जित्त तू जाण आळा सै, ना काम ना योजना ना ज्ञान अर ना बुद्धि सै।<verse eid="ECC 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 9:11" />फेर मन्‍नै सूरज कै नीच्‍चै देख्या के ना तो दौड़ म्ह तेज दौड़ण आळे अर ना युद्ध म्ह शूरवीर जीतदे; ना बुद्धिमान माणस रोट्टी पावैं, ना समझ आळे धन, अर ना होशियार पै अनुग्रह होवै सै, वे सारे बखत अर हालात कै वश म्ह सै। <verse eid="ECC 9:11" /><verse number="12" style="v" sid="ECC 9:12" />क्यूँके माणस अपणा बखत न्ही जाणदा। जिस तरियां मछलियाँ दुखदाई जाळ म्ह अर चिड़ियाँ फंदे म्ह फंसै सै, उसे तरियां माणस दुखदाई बखत म्ह जो उनपै चाणचक आ पड़ै सै, फँस जावै सै।<verse eid="ECC 9:12" /></para>
  <para style="s">बेकूफी तै ज्ञान श्रेष्ठ सै</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13" />मन्‍नै सूरज कै नीच्‍चै इस तरियां की बुद्धि की बात भी देक्खी सै, जो मन्‍नै भोत बढ़िया लाग्गी। <verse eid="ECC 9:13" /><verse number="14" style="v" sid="ECC 9:14" />एक छोट्टा सा नगर था, जिस म्ह थोड़े ए माणस थे; अर किसे बड़े राजा नै उसपै चढ़ाई कर कै उस ताहीं घेर लिया, अर उसकै खिलाफ बड़ी मोर्चाबन्‍दी कर दी। <verse eid="ECC 9:14" /><verse number="15" style="v" sid="ECC 9:15" />पर उस म्ह एक गरीब बुद्धिमान माणस पाया गया, अर उसनै उस नगर ताहीं अपणी बुद्धि के जरिये बचाया। फेर भी किसे नै उस गरीब माणस ताहीं याद न्ही राख्या। <verse eid="ECC 9:15" /><verse number="16" style="v" sid="ECC 9:16" />फेर मन्‍नै कह्या, “जै गरीब की बुद्धि छोट्टी समझी जावै सै अर उसका शब्द कोए न्ही सुणदा फेर भी ताकत तै बुद्धि बढ़िया सै।”<verse eid="ECC 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 9:17" />बुद्धिमानां के शब्द जो सहज-सहज कहे जावै सै वे बेकूफां कै बीच राज करण आळे के जोर-जोर तै रुक्‍का मारकै कहण तै घणे सुणे जावैं सै। <verse eid="ECC 9:17" /><verse number="18" style="v" sid="ECC 9:18" />लड़ाई के हथियारां तै बुद्धि उत्तम सै, पर एक पापी घण्या की भलाई का नाश करै सै।<verse eid="ECC 9:18" /></para>
  <chapter eid="ECC 9" />
  <chapter number="10" style="c" sid="ECC 10" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 10:1" />मरी होई माक्खियां कै कारण गंधी के तेल म्ह तै सड़ण अर बदबू आण लाग्गै सै; अर थोड़ी सी बेकूफी बुद्धि अर मान-बड़ाई नै घटा दे सै। <verse eid="ECC 10:1" /><verse number="2" style="v" sid="ECC 10:2" />बुद्धिमान का मन सही बात की ओड़ लाग्या रहवै सै पर बेकूफ का मन उसके उल्ट रहवै सै। <verse eid="ECC 10:2" /><verse number="3" style="v" sid="ECC 10:3" />बल्के जिब बेकूफ राह पै चालै सै, तो उसकी समझ काम न्ही करदी, अर वो सारे तै कहवै सै, “मै बेकूफ सूं।”<verse eid="ECC 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 10:4" />जै हाकिम का छो तेरे पै भड़कै, तो अपणी जगहां ना छोड़िए, क्यूँके धीरज धरण<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="fq" closed="false">धीरज धरण </char><char style="ft" closed="false">अगर तू चुप रहवै तो तेरे सारे पाप माफ जो ज्यांगे</char></note> तै बड़े-बड़े पाप रुकै सै।<verse eid="ECC 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 10:5" />एक बुराई सै जो मन्‍नै सूरज कै नीच्‍चै देक्खी, वो हाकिम की भूल तै होवै सै: <verse eid="ECC 10:5" /><verse number="6" style="v" sid="ECC 10:6" />यानी बेकूफ बड़ी मान-बड़ाई की जगहां म्ह ठहराए जावै सै, अर धनी माणस नीच्‍चै बैठ्ठै सै। <verse eid="ECC 10:6" /><verse number="7" style="v" sid="ECC 10:7" />मन्‍नै गुलामां ताहीं घोड़े पै चढ़े, अर साहूकारां ताहीं गुलामां की तरियां धरती पै चाल्दे होए देख्या सै।<verse eid="ECC 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 10:8" />जो गड्डा खोदै वो उस म्ह पड़ैगा अर जो बाड़ा तोड़ैगा उसनै साँप डसैगा। <verse eid="ECC 10:8" /><verse number="9" style="v" sid="ECC 10:9" />जो पत्थर फोड़ै, वो उनतै घायल होवैगा, अर जो लाकड़ी काटै, उस नै उस्से तै डर होवैगा। <verse eid="ECC 10:9" /><verse number="10" style="v" sid="ECC 10:10" />जै कुहाड़ा खुन्डा हो अर माणस उसकी धार नै पैन्‍नी ना करै, तो घणी ताकत लगाणी पड़ैगी, पर कामयाब होण खात्तर बुद्धि तै फायदा होवै सै। <verse eid="ECC 10:10" /><verse number="11" style="v" sid="ECC 10:11" />जै मंत्र तै पैहल्या साँप डसै, तो मंत्र पढ़ण आळे नै कोए फायदा कोनी।<verse eid="ECC 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 10:12" />बुद्धिमान के शब्द कै कारण अनुग्रह होवै सै, पर बेकूफ अपणे शब्दां के जरिये नाश होवै सै। <verse eid="ECC 10:12" /><verse number="13" style="v" sid="ECC 10:13" />उसकी बात की शरुआत बेकूफी की, अर उनका अन्त दुखदाई अर बावळापण होवै सै। <verse eid="ECC 10:13" /><verse number="14" style="v" sid="ECC 10:14" />बेकूफ भोत बात बढ़ाकै बोल्‍लै सै, फेर भी कोए माणस न्ही जाणदा के, के होवैगा, अर कौण बता सकै सै के उसकै बाद के होणआळा सै? <verse eid="ECC 10:14" /><verse number="15" style="v" sid="ECC 10:15" />बेकूफ नै मेहनत तै थकावट ए होवै सै, उरै तक के वो न्ही जाणदा के नगर म्ह किस तरियां जावै।<verse eid="ECC 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 10:16" />हे देश! तेरे पै धिक्‍कार सै, जै तेरा राजा<note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="fq" closed="false">राजा </char><char style="ft" closed="false">जब राजा एक दास सै</char></note> अनुभव-हीन सै अर तेरे हाकिम सुबेरै खाणा खावै सै! <verse eid="ECC 10:16" /><verse number="17" style="v" sid="ECC 10:17" />हे देश, तू धन्य सै जै तेरा राजा कुलीन सै; अर तेरे हाकिम बखत पै खाणा खावै सै, अर वो भी मतवाळे होण ताहीं न्ही, बल्के ताकत बढ़ाण खात्तर!<verse eid="ECC 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 10:18" />आळस कै कारण छात की कड़ी दब ज्यां सै, अर हाथ्थां की सुस्ती तै घर टपकै सै। <verse eid="ECC 10:18" /><verse number="19" style="v" sid="ECC 10:19" />खाणा हँसी-खुशी खात्तर खाया जावै सै, अर दाखमधु तै जिन्दगी नै आनन्द मिलै सै; अर रपियाँ तै सारा किमे मिलै सै। <verse eid="ECC 10:19" /><verse number="20" style="v" sid="ECC 10:20" />राजा नै मन म्ह भी श्राप न्ही दिये, अर ना धनवान ताहीं अपणी सोण की कोठड़ी म्ह श्राप दिये; क्यूँके कोए आसमान का पंछी तेरी बात नै ले जावैगा, अर कोए उड़ण आळा जन्तु उस बात नै उजागर कर देवैगा।<verse eid="ECC 10:20" /></para>
  <chapter eid="ECC 10" />
  <chapter number="11" style="c" sid="ECC 11" />
  <para style="s">मेहनत की कीमत</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 11:1" />अपणा धन खुल्‍ले मन तै दुसरयां नै बाट दे<note caller="+" style="f"><char style="fr" closed="false">11:1 </char><char style="ft" closed="false">अपणी रोट्टी-पाणी के उप्पर गेर दे</char></note>, क्यूँके भोत दिन कै बाद तू उस ताहीं फेर पावैगा। <verse eid="ECC 11:1" /><verse number="2" style="v" sid="ECC 11:2" />सात बल्के आठ माणसां नै भी हिस्सा दे, क्यूँके तू न्ही जाणदा के धरती पै के मुसीबत्त आ पड़ैगी। <verse eid="ECC 11:2" /><verse number="3" style="v" sid="ECC 11:3" />जै बादळ पाणी तै भरै सै, तो उस ताहीं धरती पै उण्डेल देवै सै; अर दरखत चाहे दक्षिण की ओड़ गिरै या उत्तर की ओड़, फेर भी जिस जगहां पै दरखत पड़ैगा, ओड़ पड्या रहवैगा। <verse eid="ECC 11:3" /><verse number="4" style="v" sid="ECC 11:4" />जो हवा नै देख्दा रहवैगा वो बीज न्ही बोण पावैगा; अर जो बादळां नै देख्दा रहवैगा वो काट्टण भी न्ही पावैगा। <verse eid="ECC 11:4" /><verse number="5" style="v" sid="ECC 11:5" />जिस तरियां तू हवा<note caller="+" style="f"><char style="fr" closed="false">11:5 </char><char style="fq" closed="false">हवा </char><char style="ft" closed="false">आत्मा</char></note> के चाल्‍लण की राह न्ही जाणदा अर किस तरियां तै गर्भवती के पेट म्ह बच्‍चे की हाड्डियाँ बढै़ सै, उसे तरियां तू परमेसवर का काम भी न्ही जाणदा जो सारा किमे करै सै।<verse eid="ECC 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 11:6" />सबेरै नै अपणा बीज बो, अर साँझ नै भी अपणा हाथ ना रोकै; क्यूँके तू न्ही जाणदा के कोणसा कामयाब होवैगा, यो या वो या दोन्‍नु के दोन्‍नु आच्छे लिकड़ैगें।<verse eid="ECC 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 11:7" />चाँदणा मन नै भावै सै, अर धूप के देक्खण तै आँखां नै सुख होवै सै।<verse eid="ECC 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 11:8" />जै माणस भोत साल जिन्दा रहवै, तो उन सारया म्ह खुश रहवै; पर यो याद राक्खै के अँधेरे के दिन भी भोत घणे होवैंगे। जो कुछ होवै सै वो भी बेकार सै।<verse eid="ECC 11:8" /></para>
  <para style="s">शरुआती जिन्दगी म्ह परमेसवर की खोज</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 11:9" />हे जवान, अपणी जवान्‍नी म्ह आनन्द कर, और अपणी जवान्‍नी के दिनां म्ह मग्न रह; अपणी मनमान्‍नी कर अर अपणी निगांह म्ह जो तन्‍नै सही लाग्गै उसकै मुताबिक चाल। पर यो बात जाण ले, के इन सारी बात्तां कै बारै म्ह परमेसवर तेरा न्याय करैगा।<verse eid="ECC 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 11:10" />अपणे मन तै खेद अर अपणी देह तै दुख दूर कर, क्यूँके बचपन अर जवान्‍नी दोन्‍नु बेकार सै।<verse eid="ECC 11:10" /></para>
  <chapter eid="ECC 11" />
  <chapter number="12" style="c" sid="ECC 12" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 12:1" />अपणी जवान्‍नी के दिनां म्ह अपणे सृजनहार नै याद राख, इसतै पैहला के मुसीबत के दिन अर वे साल आवै, जिन म्ह तू कहवै के मेरा मन इन म्ह न्ही लागदा। <verse eid="ECC 12:1" /><verse number="2" style="v" sid="ECC 12:2" />इसतै पैहल्या के सूरज अर प्रकाश अर चाँद अर तारा गण अन्‍धकारमय हो जावैंगे, अर बारिस होण कै बाद बादळ फेर घिर आवै, <verse eid="ECC 12:2" /><verse number="3" style="v" sid="ECC 12:3" />उस बखत घर के पहरेदार कांम्बैगें, अर ताकतवर झुक जावैंगे, अर पिस्सण-आळी थोड़ी रहण कै कारण काम छोड़ देगी, अर झरोख्यां म्ह तै देखण आळी आँधी हो जावैगी<note caller="+" style="f"><char style="fr" closed="false">12:3 </char><char style="ft" closed="false">कल्पना नै अक्सर माणस शरीर (घर) समझया जावै सै, रखवाळे हाथ होंगे और जो मजबूत सै चाक्‍की दांद सै, वे जो दिखे सै, आँख सै. कुछ लोग इन बात्तां नै मौत मान्‍ने सै</char></note>, <verse eid="ECC 12:3" /><verse number="4" style="v" sid="ECC 12:4" />अर सड़क की ओड़ के किवाड़ बन्द होवैंगे, अर चाक्‍की पिस्सण का शब्द धीमा होवैगा, अर सबेरै चिड़ियाँ बोलदे ए एक उठ जावैगा, अर सारी गाण-आळियाँ का शब्द धीमा हो जावैगा। <verse eid="ECC 12:4" /><verse number="5" style="v" sid="ECC 12:5" />फेर जो ऊँच्‍चा हो उसतै भय खाया जावैगा, अर राह म्ह डरावणी चीज मान्‍नी जावैगी; अर बदाम का पेड़ फूल्‍लैगा, अर टिड्डी भी भारी लाग्गैगी, अर भूख बढाण आळा फळ फेर काम न्ही देवैगा; क्यूँके माणस अपणे सदा के घर म्ह जावैगा, अर रोण-पीटण आळे गळी-गळी फिरैगें। <verse eid="ECC 12:5" /><verse number="6" style="v" sid="ECC 12:6" />उस बखत चाँदी का तार दो टुकड़े हो जावैगी अर सोन्‍ने का कटोरा टूट्टैगा; अर चोए कै धोरै घड़ा फुट्टैगा, अर कुण्ड के धोरै गिरड़ी<note caller="+" style="f"><char style="fr" closed="false">12:6 </char><char style="fq" closed="false">गिरड़ी </char><char style="ft" closed="false">चकळी, पहिया</char></note> टूट जावैगी, <verse eid="ECC 12:6" /><verse number="7" style="v" sid="ECC 12:7" />जिब माट्टी ज्यों की त्यों माट्टी म्ह मिल जावैगी, अर आत्मा परमेसवर कै धोरै जिसनै उस ताहीं भेज्या था वापस लौट जावैगी। <verse eid="ECC 12:7" /><verse number="8" style="v" sid="ECC 12:8" />उपदेशक कहवै सै, सारा बेकार ए बेकार; सारा किमे बेकार सै।<verse eid="ECC 12:8" /></para>
  <para style="s">माणस का पूरा फर्ज</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9" />उपदेशक जो बुद्धिमान था, वो प्रजा नै ज्ञान भी सिखान्दा रह्या, अर ध्यान लगाकै अर जाँच-परख कै भोत सारे नीतिवचन क्रम तै राख्या करै था। <verse eid="ECC 12:9" /><verse number="10" style="v" sid="ECC 12:10" />उपदेशक नै मन नै भावण आळे शब्द टोह्ये अर सिधाई तै या सच्‍ची बात लिख दी।<verse eid="ECC 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 12:11" />बुद्धिमानां के शब्द नुकील्‍ली चीज की तरियां होवै सै, अर प्रधानां के वचन गाड्डी होई कील्‍लां की तरियां सै, क्यूँके वो एके पाळी<note caller="+" style="f"><char style="fr" closed="false">12:11 </char><char style="fq" closed="false">पाळी </char><char style="ft" closed="false">परमेसवर या सुलैमान</char></note> की ओड़ तै मिलै सै। <verse eid="ECC 12:11" /><verse number="12" style="v" sid="ECC 12:12" />हे मेरे बेट्टे, इन म्ह तै चौकसी सीख। भोत सारी किताबां का बणाये जाण का अन्त न्ही होन्दा, अर भोत पढ़णा देह नै थका देवै सै।<verse eid="ECC 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 12:13" />सारा किमे सुण्या गया; आखरी की बात या सै के परमेसवर का भय मान अर उसके हुकमां का पालन कर; क्यूँके माणस का पूरा फर्ज योए सै। <verse eid="ECC 12:13" /><verse number="14" style="v" sid="ECC 12:14" />क्यूँके परमेसवर सारे काम्मां का अर सारी गुप्त बात्तां का, चाहे वे आच्छी हो या बुरी हो, न्याय करैगा।<verse eid="ECC 12:14" /></para>
  <chapter eid="ECC 12" />
</usx>