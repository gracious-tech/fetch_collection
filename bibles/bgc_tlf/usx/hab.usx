  <para style="h">हबक्‍कूक</para>
  <para style="toc1">हबक्‍कूक नबी की किताब</para>
  <para style="toc2">हबक्‍कूक</para>
  <para style="toc3">हब.</para>
  <para style="mt">हबक्‍कूक नबी की किताब</para>
  <para style="is">लेखक</para>
  <para style="ip">
    <char style="xt">
      <ref loc="HAB 1:1">हब. 1:1</ref>
    </char> भविष्यवक्ता हबक्‍कूक के वचन के रूप म्ह इस किताब की पिच्छाण होवै सै। उनके नाम के अलावा हम हबक्‍कूक कै बारै म्ह और किमे न्ही जाणदे। या बात सै के उस ताहीं “हबक्‍कूक नबी” कह्या गया सै या बतावै सै के वो एक मान्या होया माणस था अर उस ताहीं पिच्छाण की जरूरत न्ही थी।</para>
  <para style="is">लिखण तारिख अर जगहां</para>
  <para style="ip">लगभग 612-605 ई. पू.</para>
  <para style="ip">हबक्‍कूक नै या किताब जरुर दक्षिणी राज्य, यहूदा के पतन तै पैहले, भोत-ए कम बखत पैहल्या लिखी थी।</para>
  <para style="is">प्रापक</para>
  <para style="ip">दक्षिणी राज्य, यहूदा की प्रजा और सारे परमेसवर के माणसां कै खात्तर एक चिट्ठी।</para>
  <para style="is">मकसद</para>
  <para style="ip">हबक्‍कूक सोच रह्या था के परमेसवर अपणे चुणे होया नै उनके बैरियाँ के हाथां कष्ट क्यूँ भोग्गण दे रह्या सै। परमेसवर उसनै जवाब देवै सै अर उसका बिश्वास मजबूत होवै सै। इस किताब का मकसद सै के यहोवा, उसके माणसां का रक्षक, बिश्वास करण आळयां नै सुरक्षित राक्खैगा अर यो घोषणा करणा के यहोवा, यहूदा का परमप्रधान योद्धा एक दिन अन्यायी बाबेल नै सजा देवैगा। हबक्‍कूक की किताब हमनै घमण्डियाँ नै विनम्र बणाण का चित्रण दिखावै सै जबकि धर्म पै बण्या रहण आळा माणस परमेसवर म्ह बिश्वास के जरिये जिन्दा रहवै सैं। <char style="xt"><ref loc="HAB 2:4">2:4</ref></char></para>
  <para style="is">खास बातें</para>
  <para style="ip">प्रभु परमेसवर पै भरोस्सा करणा</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. हबक्‍कूक की शिकायत <char style="ior"><ref loc="HAB 1:1-2:20">1:1-2:20</ref> </char></para>
  <para style="io1">2. हबक्‍कूक की प्रार्थना <char style="ior"><ref loc="HAB 3:1-19">3:1-19</ref> </char></para>
  <chapter number="1" style="c" sid="HAB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1" />भारी वचन जिस ताहीं हबक्‍कूक नबी नै दर्शन म्ह पाया।<verse eid="HAB 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 1:2" />हे यहोवा मै कद ताहीं तेरी दुहाई देन्दा रहूँगा<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="fq" closed="false">मै कद ताहीं तेरी दुहाई देन्दा रहूँगा </char><char style="ft" closed="false">भविष्यवक्ता उरै व्यक्त करै सै के पैहले तै ए घणा लाम्बा बखत हो चुक्या सै अर उस लाम्बे बखत कै दौरान वो परमेसवर ताहीं पुकारै सै लेकिन कोए परिवर्तन न्ही होया।</char></note>, अर तू न्ही सुणैगा? मै कद ताहीं तेरै स्याम्ही “उड़दंग”, “उड़दंग” चिल्‍लान्दा रहूँगा? के तू उद्धार न्ही करैगा? मन्‍नै इस हिंसा तै बचा। <verse eid="HAB 1:2" /><verse number="3" style="v" sid="HAB 1:3" />तू मेरे ताहीं अनर्थ काम क्यूँ दिखावै सै? अर के कारण सै के तू उड़दंग नै देखदा ए रहवै सै? मेरै स्याम्ही लूट-पाट अर उड़दंग होन्दे रहवै सैं; अर झगड़ा होया करै सै अर वाद-विवाद बढ़दा जावै सै। <verse eid="HAB 1:3" /><verse number="4" style="v" sid="HAB 1:4" />इस करकै नियम-कायदे ढील्‍ले होगे अर न्याय कदे भी न्ही प्रगट होन्दा। दुष्ट माणस धर्मी नै घेर लेवै सैं; इस करकै न्याय का खून हो रह्या सै<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="fq" closed="false">खून हो रह्या सै </char><char style="ft" closed="false">यानिके बिगड़ रहया सै या बदल रहया सै।</char></note>।<verse eid="HAB 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HAB 1:5" />यहोवा नै अपणे माणसां तै कह्या, “जात्ति-जात्ति की और ध्यान लगाकै देक्खो, अर घणाए हैरान हो। क्यूँके मै थारे ए दिनां म्ह इसा काम करण पै सूं के जिब वो थारे तै बताया जावै तो थम उसपै बिश्वास न्ही करोगे।”<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="ACT 13:41">प्रेरि. 13:41</ref></char></char></note> <verse eid="HAB 1:5" /><verse number="6" style="v" sid="HAB 1:6" />देक्खो, “मै कसदियाँ<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">कसदियाँ के माणस मूल रूप तै बाबेल के माणस थे पर हबक्‍कूक के बखत ताहीं इसका मतलब और बड़ा हो गया जिननै आज बाबेलवासी कह्या जावै सै। </char></note> नै उभारण पै सूं, वे जुल्मी अर उतावळी करण आळी जात्ति सैं, जो परायां की रहण आळी जगहां के राजनैतिक अधिकारी होण कै खात्तर धरती भर म्ह फैलगे सैं।<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="REV 20:9">प्रका. 20:9</ref></char></char></note> <verse eid="HAB 1:6" /><verse number="7" style="v" sid="HAB 1:7" />वे भयानक अर डरावणे सैं, वे आप्पे अपणे न्याय की बड़ाई अर प्रशंसा का कारण सैं। <verse eid="HAB 1:7" /><verse number="8" style="v" sid="HAB 1:8" />उनके घोड़े सिपाही चीत्यां तै भी घणी रफतार तै चाल्‍लण आळे सैं, अर साँझ नै शिकार करण आळे भेड़ियाँ तै भी घणे खुंखार सैं; उनके सवार दूर-दूर कूदते-फाँदते आवै सैं। हाँ, वे दूर तै चले आवै सैं; अर शिकार पै झपटण आळे उकाब की तरियां झपट्टा मारै सैं। <verse eid="HAB 1:8" /><verse number="9" style="v" sid="HAB 1:9" />बाबेल के सारे के सारे सिपाही उड़दंग करण कै खात्तर आवै सैं; स्याम्ही की और मुँह करे होए वे सीध्धे बढ़े चले जावै सैं, अर गुलाम्मां नै रेत के किणक्यां की तरियां बटोरै सैं। <verse eid="HAB 1:9" /><verse number="10" style="v" sid="HAB 1:10" />राजयां नै वे मजाक म्ह उड़ावै अर हाकिमां का मखौल करै सैं; वे सारे मजबूत गढां नै निकम्मा जाणै सैं, क्यूँके वे दमदमा बाँधकै उननै जीत लेवै सैं। <verse eid="HAB 1:10" /><verse number="11" style="v" sid="HAB 1:11" />फेर वे हवा की तरियां चाल्दे अर मर्यादा छोड़कै दोषी ठहरै सैं, क्यूँके उनका जोर ए उनका देवता सै।”<verse eid="HAB 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HAB 1:12" />हबक्‍कूक नै परमेसवर तै शिकायत करी के हे मेरे प्रभु यहोवा, हे मेरे पवित्र परमेसवर, के तू अनादिकाल तै न्ही सै? इस करकै हम न्ही मरण के। हे यहोवा, तन्‍नै उन ताहीं न्याय करण कै खात्तर ठहराया सै; हे चट्टान, तन्‍नै उल्हाणा देण कै खात्तर उन ताहीं बिठाया सै। <verse eid="HAB 1:12" /><verse number="13" style="v" sid="HAB 1:13" />तेरी आँख इसी शुद्ध सैं के तू बुराई नै देख ए न्ही सकदा, अर उड़दंग नै देखकै चुप न्ही रह सकदा; फेर तू धोक्खेबाजां नै क्यूँ देखदा रहवै, अर जिब दुष्ट निर्दोष नै निगळ जावै सै, फेर तू क्यूँ चुप रहवै सै? <verse eid="HAB 1:13" /><verse number="14" style="v" sid="HAB 1:14" />तू क्यूँ माणसां नै समुन्दर की मछलियाँ की तरियां अर उन रेंगण आळे जन्तुआं की तरियां बणावै सै जिनपै कोए शासन करण आळा न्ही सै<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="fq" closed="false">जिनपै कोए शासन करण आळा न्ही सै </char><char style="ft" closed="false">मार्गदर्शन करण आळा, हुकम देण आळा, रक्षा करण आळा कोए न्ही उसे तरियां परमेसवर की देख-रेख अर प्रावधान तै वंचित माणस का यो चित्रण सै।</char></note>। <verse eid="HAB 1:14" /><verse number="15" style="v" sid="HAB 1:15" />बाबेलवासी उन सारे माणसां नै बंसी तै पकड़कै ठा लेवै अर जाळ म्ह घसीटदा अर महाजाल म्ह फँसा लेवै सै; इस कारण वो आनन्दित अर मगन सै। <verse eid="HAB 1:15" /><verse number="16" style="v" sid="HAB 1:16" />इस करकै वो अपणे जाळ कै स्याम्ही बलि चढ़ावैं अर अपणे महाजाल कै आगै धूप जळावै सै; क्यूँके इन्हे के जरिये उसका भाग मजबूत होवै, अर उसका भोजन चिकणा होवै सै। <verse eid="HAB 1:16" /><verse number="17" style="v" sid="HAB 1:17" />के वो जाळ नै खाल्‍ली करण अर जात-जात के माणसां नै लगातार निर्दयता तै घात करण तै हाथ न्ही रोकैगा?<verse eid="HAB 1:17" /></para>
  <chapter eid="HAB 1" />
  <chapter number="2" style="c" sid="HAB 2" />
  <para style="s">हबक्‍कूक ताहीं परमेसवर का जवाब</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 2:1" />हबक्‍कूक नबी नै कह्या मै अपणे पहरे पै खड्या रहूँगा, अर गुम्मट पै चढ़कै ठहरया रहूँगा, अर देखदा रहूँगा के मेरे ताहीं यहोवा के कहवैगा? मै अपणे दिए होए उल्हाणे कै बारै म्ह के उत्तर दियुँ?<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">नबियाँ की तुलना अकसर देखभाळ करण आळयां तै करी जावै सै। <char style="xt"><ref loc="ISA 21:6-12">यशा. 21:6-12</ref>; <ref loc="JER 6:17">यिर्म. 6:17</ref>; <ref loc="EZK 3:17">यहे. 3:17</ref>; <ref loc="EZK 33:7">33:7</ref>; <ref loc="MIC 7:4">मीका. 7:4</ref></char></char></note><verse eid="HAB 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 2:2" />फेर यहोवा नै मेरे ताहीं जवाब दिया, “दर्शन की बात लिखदे; बलके पटियाँ पै साफ-साफ लिखदे के भाजदे होए भी वे आसान्‍नी तै पढ़ी जावैं। <verse eid="HAB 2:2" /><verse number="3" style="v" sid="HAB 2:3" />क्यूँके इस दर्शन की बात सही बखत म्ह पूरी होण आळी सै<note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="fq" closed="false">इस दर्शन की बात सही बखत म्ह पूरी होण आळी सै </char><char style="ft" closed="false">वर्तमान म्ह तो न्ही लेकिन बखत के अन्तराल म्ह विकसित होकै उस बखत होवैगी जो सिर्फ परमेसवर ए जाणै सै।</char></note>, बलके इसके पूरे होण का बखत रफतार तै आवै सै; इस म्ह धोखा न्ही होवैगा। चाहे इस म्ह देर भी हो, फेर भी उसकी बाट देखदे रहणा; क्यूँके वो जरुर पूरी होवैगी अर उस म्ह देर न्ही होवैगी। <verse eid="HAB 2:3" /><verse number="4" style="v" sid="HAB 2:4" />देख, उसका मन फुल्या होया सै, उसका मन सीध्धा न्ही सै; फेर भी धर्मी अपणे बिश्वास के जरिये जिन्दा अर परमेसवर के खात्तर वफादार रहवैगा।<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="HEB 10:37-38">इब्रा. 10:37-38</ref>; <ref loc="2PE 3:9">2 पत. 3:9</ref>; <ref loc="ROM 1:17">रोम. 1:17</ref>; <ref loc="GAL 3:11">गला. 3:11</ref> </char></char></note> <verse eid="HAB 2:4" /><verse number="5" style="v" sid="HAB 2:5" />दाखमधु तै धोखा होवै सै; घमण्डी माणस घर म्ह न्ही रहन्दा, अर उसकी लालसा अधोलोक की तरियां पूरी न्ही होन्दी, अर मौत की तरियां उसका पेट न्ही भरदा। वो सारी जातियाँ नै अपणे धोरै खींच लेवै, अर सारे देशां के माणसां नै अपणे धोरै कठ्ठे करे राक्खै सै।”<verse eid="HAB 2:5" /></para>
  <para style="s">दुष्ट का विनाश जरूरी</para>
  <para style="p">
    <verse number="6" style="v" sid="HAB 2:6" />के वे सारे उसका उदाहरण बताकै, अर उसपै तान्‍ना मारकै न्ही कहवैंगे “हाय उसपै जो पराया धन खोस खोसकै अमीर हो जावै सै? कद ताहीं? हाय उसपै जो अपणा घर बन्धक की चिज्जां तै भर लेवै सै!” <verse eid="HAB 2:6" /><verse number="7" style="v" sid="HAB 2:7" />जो तेरै तै कर्ज लेवै सैं, के वे माणस चाणचक न्ही उठैगें? अर के वे ना जागैंगे जो तन्‍नै संकट म्ह गेरैगें? <verse eid="HAB 2:7" /><verse number="8" style="v" sid="HAB 2:8" />अर के तू उनतै लूट्या न्ही जावैगा? तन्‍नै भोत सी जात्तां ताहीं लूट लिया सै, इस करकै सारे बचे होए माणस तेरे ताहीं भी लूट लेवैंगे। इसका कारण माणसां की हत्या सै, अर वो उड़दंग भी जो तन्‍नै इस देश अर राजधानी अर इसके सारे रहण आळयां पै करया सै।<verse eid="HAB 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HAB 2:9" />हाय उसपै, जो अपणे घर कै खात्तर अन्याय के फायदे का लोभ्भी सै ताके वो अपणा घोंसला ऊँच्‍ची जगहां म्ह बणाकै मुसीबत तै बचै। <verse eid="HAB 2:9" /><verse number="10" style="v" sid="HAB 2:10" />तन्‍नै भोत सी जात्तां ताहीं काटकै अपणे घर कै खात्तर शर्म की युक्ति बाँधी, अर अपणे ए प्राण का दोषी ठहरया सै। <verse eid="HAB 2:10" /><verse number="11" style="v" sid="HAB 2:11" />क्यूँके घर की दीवार का पत्थर दुहाई देवै सै, अर उसके छात की कड़ी उनके स्वर म्ह स्वर मिलाकै जवाब देवै सैं।<verse eid="HAB 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HAB 2:12" />हाय उसपै जो हत्या करकै नगर नै बणावै, अर कुटिलता करकै शहर नै मजबूत करै सै। <verse eid="HAB 2:12" /><verse number="13" style="v" sid="HAB 2:13" />देक्खो, के सेनाओं के यहोवा की और तै यो न्ही होन्दा के देश-देश के माणस मेहनत तो करै सैं पर वे आग का निवाळा होवैं सैं; अर राज्य-राज्य के माणसां की मेहनत बेकार ए ठहरै सै? <verse eid="HAB 2:13" /><verse number="14" style="v" sid="HAB 2:14" />क्यूँके धरती यहोवा की महिमा के ज्ञान तै इसी भर ज्यागी<note caller="+" style="f"><char style="fr" closed="false">2:14 </char><char style="fq" closed="false">धरती यहोवा की महिमा के ज्ञान तै इसी भर ज्यागी </char><char style="ft" closed="false">क्यूँके प्रभु की आत्मा तै धरती इसी भरगी अर भरण के कारण प्रभु की महिमा का ज्ञान पूरा होग्या जिसतै अज्ञानी अर अणपढ माणस बुद्धिमान अर बोल्‍लण म्ह माहिर होग्या।</char></note> जिस तरियां समुन्दर पाणी तै भर ज्यावै सै।<verse eid="HAB 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HAB 2:15" />हाय उसपै, जो अपणे पड़ोसी नै शराब पिलावै, अर उस म्ह जहर मिलाकै उस ताहीं मतवाळा कर देवै सै के उसनै नंगा देक्खै। <verse eid="HAB 2:15" /><verse number="16" style="v" sid="HAB 2:16" />तू महिमा कै बदले बेजती ए तै भरग्या सै। तू भी पी, अर अपणे आप नै बिना खतना के साबित कर! जो कटोरा यहोवा के सोळे हाथ म्ह रहवै सै, वो घूमकै तेरी और भी जावैगा, अर तेरा वैभव तेरी उल्टी तै अशुद्ध हो जावैगा। <verse eid="HAB 2:16" /><verse number="17" style="v" sid="HAB 2:17" />क्यूँके लबानोन<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="ft" closed="false">बाबेल के माणसां नै लबानोन के जंगलां नै काट दिया अर धरती नै बंजर कर दिया। </char></note> म्ह तेरा करया होया उड़दंग अर ओड़ै के जंगळी-पशुआं पै तेरा करया होया उत्पात, जिनतै वे डरगे थे, सिर्फ तेरे पैए आण पड़ैगें। यो माणसां की हत्या अर उस उत्पात के कारण होवैगा, जो इस देश अर राजधानी अर इसके सारे रहण आळयां पै करया गया सै।<verse eid="HAB 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HAB 2:18" />खुदी होई मूरत म्ह के फायदा देखकै<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="fq" closed="false">खुदी होई मूरत म्ह के फायदा देखकै </char><char style="ft" closed="false">यो मूर्तिपूजा की खास मूर्खता थी। उसकी रचना हस्तकार तै भी कम सै। यो मूर्तिपूजा का एक भ्रष्ट विचार सै के कलाकार अपणी ए रची होई चीज म्ह आस्था राक्खै।</char></note> बणाण आळे नै उस ताहीं खोद्या सै? फेर झूठ सिखाण आळी अर ढळी होई मूरत म्ह के लाभ देखकै ढाळण आळे नै उसपै इतणा भरोस्सा राख्या सै के ना बोलण आळी अर निकम्मी मूरत बणावै?<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 115:4-8">भजन. 115:4-8</ref>; <ref loc="PSA 135:15-18">135:15-18</ref>; <ref loc="ISA 44:9-20">यशा. 44:9-20</ref>; <ref loc="ISA 46:6-7">46:6-7</ref>; <ref loc="JER 10:2-16">यिर्म. 10:2-16</ref></char> </char></note> <verse eid="HAB 2:18" /><verse number="19" style="v" sid="HAB 2:19" />हाय उसपै जो काठ तै कहवै सै, जाग, या अणबोल पत्थर<note caller="+" style="f"><char style="fr" closed="false">2:19 </char><char style="ft" closed="false">लाकड़ी अर पत्थर की मूरतां</char></note> तै, उठ! के वो सिखावैगा? देक्खो, वो सोन्‍ने-चाँदी म्ह मढ़यां होया सै, लेकिन उस म्ह साँस न्ही सै।<note caller="+" style="f"><char style="fr" closed="false">2:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="1CO 12:2">1 कुरि. 12:2</ref></char></char></note><verse eid="HAB 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HAB 2:20" />पर यहोवा अपणे पवित्र मन्दर म्ह सै; सारी पृथ्वी उसकै स्याम्ही शान्त रहवै।<verse eid="HAB 2:20" /></para>
  <chapter eid="HAB 2" />
  <chapter number="3" style="c" sid="HAB 3" />
  <para style="s">हबक्‍कूक की प्रार्थना</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 3:1" />शिग्योनीत<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="ft" closed="false">शिग्योनीत इब्रानी भाषा का शब्द सै जो भजन संहिता कै गैल निर्देशां ताहीं गाया जावै सै। </char></note> की रीति पै हबक्‍कूक नबी की प्रार्थना।<verse eid="HAB 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HAB 3:2" />हे यहोवा, मै तेरी कीर्ति<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fq" closed="false">कीर्ति </char><char style="ft" closed="false">भजन 7 के अलावा यो इब्रानी शब्द शिग्योनीत : एके बार प्रगट सै भजनां म्ह यो संगीतवाद्य कै गैल सै मिठ्ठी धुन या भजन कै पैहल्या शब्द जिसकी धुन ग्रहण करी गई सै।</char></note> सुणकै डर ग्या।</para>
  <para style="q" vid="HAB 3:2">हे यहोवा, वर्तमान युग म्ह अपणे काम नै पूरा कर;</para>
  <para style="q" vid="HAB 3:2">इस्से युग म्ह तू उसनै प्रगट कर;</para>
  <para style="q" vid="HAB 3:2">छो करदे होए भी दया करणा याद राख।<verse eid="HAB 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HAB 3:3" />परमेसवर तेमान<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">तेमान एदोम का जिला सै अर यहूदा का दक्षिणी पूर्वी देश सै। या एदोम पूरा देश की तरियां सै। </char></note> तै आया,</para>
  <para style="q" vid="HAB 3:3">पवित्र परमेसवर पारान पहाड़<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">पारान पहाड़ अकाबा के गल्फ के पश्चिमी सीनै उपद्वीप के बंजर पहाड़ां के बारे म्ह सै। </char></note> तै आ रह्या सै। <char style="qs">(सेला) </char></para>
  <para style="q" vid="HAB 3:3">उसका तेज अकास पै छाया होया सै,</para>
  <para style="q" vid="HAB 3:3">अर धरती उसकी स्तुति तै भरगी सै।<verse eid="HAB 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HAB 3:4" />उसकी ज्योति सूरज कै बराबर थी,</para>
  <para style="q" vid="HAB 3:4">उसके हाथ तै किरण लिकड़ रही थी;</para>
  <para style="q" vid="HAB 3:4">अर इन म्ह उसकी ताकत छिपी होई थी।<verse eid="HAB 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HAB 3:5" />उसकै आगै-आगै मरी फैलदी गई,</para>
  <para style="q" vid="HAB 3:5">अर उसके पैरां तै महाज्वर लिकड़दा गया।<verse eid="HAB 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HAB 3:6" />वो खड्या होकै धरती नै नाप रह्या था;</para>
  <para style="q" vid="HAB 3:6">उसनै देख्या अर धरती की सारी जात्ति-जात्ति के माणस घबरागे;</para>
  <para style="q" vid="HAB 3:6">फेर सनातन पहाड़ चकणाचूर होगे, अर सनातन की पहाड़ियाँ झुक गी</para>
  <para style="q" vid="HAB 3:6">उसकी गति अनन्त काल तै एक जिसी सै।<verse eid="HAB 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HAB 3:7" />मेरे ताहीं कूशान<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">कूशान के तम्बू माणसां के रहण नै दिखावै सै। या माणस बियाबान के वासी थे जो की भेड़ा के ऊन अर उनके चमड़ा के कपड़े पहरया करदे होए तम्बूआं म्ह रह्या करदे। </char></note> गोत्र के माणसां के तम्बू म्ह रहण आळे दुःख तै दबे दिखाई पड़े;</para>
  <para style="q" vid="HAB 3:7">अर मिद्यान देश के डेरे डगमगा गे।<verse eid="HAB 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HAB 3:8" />हे यहोवा, के तू नदियाँ पै रिसियाया था?</para>
  <para style="q" vid="HAB 3:8">के तेरा छो नदियाँ पै भड़क्या था,</para>
  <para style="q" vid="HAB 3:8">या के तेरी जळजळाहट समुन्दर पै भड़की थी,</para>
  <para style="q" vid="HAB 3:8">जिब तू अपणे घोड़यां पै अर उद्धार करण आळे जीत के रथां पै चढ़कै आ रह्या था?<verse eid="HAB 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HAB 3:9" />तेरा धनुष खोल म्ह तै लिकड़ ग्या,</para>
  <para style="q" vid="HAB 3:9">तेरी सजा का वचन कसम कै गैल होया था। <char style="qs">(सेला) </char></para>
  <para style="q" vid="HAB 3:9">तन्‍नै धरती ताहीं नदियाँ तै चीर दिया।<verse eid="HAB 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HAB 3:10" />पहाड़ तेरे ताहीं देखकै काँम्ब उठे;</para>
  <para style="q" vid="HAB 3:10">आँधी अर जल-प्रलय लिकड़गे;</para>
  <para style="q" vid="HAB 3:10">ढुंघा सागर बोल उठ्या अर अपणे हाथां</para>
  <para style="q" vid="HAB 3:10">यानिके लहरां ताहीं उप्पर ठाया।<verse eid="HAB 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HAB 3:11" />तेरे उड़ण आळे तीरां के चाल्‍लण की ज्योति तै,</para>
  <para style="q" vid="HAB 3:11">अर तेरे चमकीले भाल्‍ले की झलक की रोशनी तै सूरज अर चाँद अपणी-अपणी जगहां पै ठहरगे।<verse eid="HAB 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HAB 3:12" />तू छो म्ह आकै धरती पै चाल लिकड़या,</para>
  <para style="q" vid="HAB 3:12">तन्‍नै जात्ति-जात्ति ताहीं छो तै नाश करया।<verse eid="HAB 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HAB 3:13" />तू अपणी प्रजा के उद्धार कै खात्तर लिकड़या,</para>
  <para style="q" vid="HAB 3:13">हाँ, अपणे अभिषिक्त कै गैल होकै उद्धार कै खात्तर लिकड़या।</para>
  <para style="q" vid="HAB 3:13">तन्‍नै दुष्ट के घर के सिर ताहीं कुचळ कै उसनै गळे तै नींव ताहीं नंगा कर दिया। <char style="qs">(सेला) </char><verse eid="HAB 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HAB 3:14" />तन्‍नै उसके योद्धयां के सिरां ताहीं उसे की बर्छी तै छेद्या सै,</para>
  <para style="q" vid="HAB 3:14">वे मन्‍नै आस्सै-पास्सै करण कै खात्तर बवंडर की आँधी की तरियां आए,</para>
  <para style="q" vid="HAB 3:14">अर दीन माणसां नै घात लगाकै मार गेरण की उम्मीद तै आनन्दित थे।<verse eid="HAB 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HAB 3:15" />तू अपणे घोड़यां पै सवार होकै समुन्दर तै हाँ, जल-प्रलय तै पार होग्या।<verse eid="HAB 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HAB 3:16" />यो सब सुणदे ए मेरा कळेजा<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="fq" closed="false">यो सब सुणदे ए मेरा कळेजा </char><char style="ft" closed="false">यानिके सारा आन्तरिक मनुष्यत्व शरीर अर मानसिक स्थिति, सब शक्तियाँ काँम्ब उठी।</char></note> काँम्ब उठ्या,</para>
  <para style="q" vid="HAB 3:16">मेरे होठ थरथराण लाग्गे;</para>
  <para style="q" vid="HAB 3:16">मेरी हाड्डी सड़ण लाग्गी, अर मै खड़े-खड़े काँम्बण लाग्या।</para>
  <para style="q" vid="HAB 3:16">मै शान्ति तै उस दिन की बाट देखदा रहूँगा</para>
  <para style="q" vid="HAB 3:16">जिब दल बाँधकै प्रजा चढ़ाई करै।<verse eid="HAB 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HAB 3:17" />क्यूँके चाहे अंजीर के दरखतां म्ह फूल ना लाग्गे,</para>
  <para style="q" vid="HAB 3:17">अर ना दाखलता म्ह फळ लाग्गे,</para>
  <para style="q" vid="HAB 3:17">जैतून के दरखत तै सिर्फ धोखा पाया जावै</para>
  <para style="q" vid="HAB 3:17">अर खेत्तां म्ह अन्‍न ना उगै,</para>
  <para style="q" vid="HAB 3:17">बाड़याँ म्ह भेड़-बकरी ना रहवैं,</para>
  <para style="q" vid="HAB 3:17">अर ना थान्‍नां म्ह गां-बळध हों<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="LUK 13:6">लूका. 13:6</ref></char></char></note>,<verse eid="HAB 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="HAB 3:18" />फेर भी मै यहोवा कै कारण आनन्दित अर मगन रहूँगा,</para>
  <para style="q" vid="HAB 3:18">अर अपणे उद्धारकर्ता परमेसवर कै जरिये भोत खुश रहूँगा<verse eid="HAB 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="HAB 3:19" />यहोवा परमेसवर मेरे जोर का कारण सै,</para>
  <para style="q" vid="HAB 3:19">वो मेरे पैर हिरण की तरियां बणा देवै सै,</para>
  <para style="q" vid="HAB 3:19">वो मन्‍नै मेरी ऊँच्‍ची जगहां<note caller="+" style="f"><char style="fr" closed="false">3:19 </char><char style="ft" closed="false">पहाड़ां</char></note> पै चलावै सै।<verse eid="HAB 3:19" /></para>
  <chapter eid="HAB 3" />
</usx>