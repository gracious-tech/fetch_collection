<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id" />
  <para style="h">2 यूहन्‍ना</para>
  <para style="toc3">2 यूह.</para>
  <para style="toc2">2 यूहन्‍ना</para>
  <para style="toc1">यूहन्‍ना दुसरी चिट्ठी</para>
  <para style="mt">यूहन्‍ना की दुसरी चिट्ठी</para>
  <para style="is">लेखक</para>
  <para style="ip">इस चिट्ठी का लेखक प्रेरित यूहन्‍ना सै। 2 यूहन्‍ना म्ह वो खुद ताहीं एक “प्राचीन” कहवै सै। इस चिट्ठी का शीर्षक “यूहन्‍ना की दुसरी चिट्ठी” सै। या चिट्ठी तीन की श्रृंखला म्ह दुसरी सै जो यूहन्‍ना के नाम तै सै। इस दुसरी चिट्ठी का लक्ष्य वे झूठ्ठे शिक्षक सैं जो यूहन्‍ना की कलीसियाओं म्ह घूमदे होए प्रचार करण लागरे थे। उनका लक्ष्य था अपणे अनुयायी बणाकै अपणे मकसद के निमित्त मसीही महमान-नवाजी का अनुचित लाभ ठावै।</para>
  <para style="is">लिखण की तारिख अर जगहां</para>
  <para style="ip">लगभग ईस्वी 85 - 95</para>
  <para style="ip">लिखण की जगहां शायद इफिसुस था।</para>
  <para style="is">प्रापक</para>
  <para style="ip">या चिट्ठी जिस कलीसिया ताहीं लिखी गई थी उसनै यूहन्‍ना “चुणी होई जनान्‍नी अर उसके बच्यां के नाम” कहवै सै।</para>
  <para style="is">मकसद</para>
  <para style="ip">यूहन्‍ना नै या चिट्ठी लिखकै “उस जनान्‍नी अर उसके बच्यां” के प्रति अपणी निष्ठा दर्शाई सै अर उस ताहीं प्रोत्साहित करया सै के प्रेम म्ह रहते होए वे प्रभु की सारी आज्ञा नै मान्‍नै। वो उननै झूठ्ठे शिक्षकां तै सावधान करै सै अर उन्हें बतावै सै के वो भोत तावळा उनतै भेंट करैगा। यूहन्‍ना उसकी “भाण” ताहीं भी नमस्कार कहवै सै।</para>
  <para style="is">खास बातें</para>
  <para style="ip">बिश्वासियाँ का विवेक</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. अभिवादन <char style="ior"><ref loc="2JN 1:1-3">1:1-3</ref> </char></para>
  <para style="io1">2. प्रेम म्ह सत्य का निर्वाहन करणा <char style="ior"><ref loc="2JN 1:4-11">1:4-11</ref></char></para>
  <para style="io1">3. आखरी नमस्कार <char style="ior"><ref loc="2JN 1:12">1:12</ref>,<ref loc="2JN 1:13">13</ref> </char></para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="s">नमस्कार</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />या चिट्ठी मुझ यूहन्‍ना की ओड़ तै सै, जो कलीसिया का अगुवां सै, मै उस परमेसवर के जरिये चुणी गई बिरबान्‍नी अर उसके बाळकां के नाम या चिट्ठी लिखण लागरया सूं, जिनतै मै सच्‍चा प्यार करुँ सूं, अर सिर्फ मै ए न्ही बल्के वे सारे भी प्यार करै सै, जो सच्‍चाई नै जाणै सै। <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />हम थारे तै प्यार करा सां, क्यूँके सच्‍ची शिक्षा म्हारे म्ह रहवै सै, अर म्हारे साथ सदा रहवैगी। <verse eid="2JN 1:2" /><verse number="3" style="v" sid="2JN 1:3" />परमेसवर पिता, अर उसके बेट्टे यीशु मसीह की ओड़ तै अनुग्रह, दया, शान्ति, ये सब उनकै साथ रहवैंगी, जो इस सच्‍चाई नै मान्‍नै सै, अर एक-दुसरे तै प्यार करै सै।<verse eid="2JN 1:3" /></para>
  <para style="s">सच अर प्यार</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />मै घणा राज्जी होया के मन्‍नै तेरे कई बाळकां ताहीं उस हुकम कै मुताबिक, जो म्हारै पिता की ओड़ तै मिल्या था, सच पै चाल्दे होए पाया। <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />इब हे नारी, मै तेरे तै बिनती करुँ सूं, के हमनै एक-दुसरे तै प्यार करणा चाहिए, यो कोए नया हुकम कोनी, बल्के यो वो हुकम सै जिसनै हम उस बखत तै जाणा सां, जिब हमनै मसीह कै पाच्छै चालणा शरु करया था। <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />अर सच्‍चा प्यार यो सै, के हम परमेसवर के हुकमां कै मुताबिक चाल्‍लां, जिस दिन तै थमनै मसीह कै पाच्छै चालणा शरु करया था, उस दिन तै थम जाणो सों, के परमेसवर नै म्हारे ताहीं हुकम दिया सै, के हम सदा एक-दुसरे तै प्यार करा।<verse eid="2JN 1:6" /></para>
  <para style="s">मसीह बिरोधी के धोक्खे तै सावधान</para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />मै ज्यांतै कहूँ सूं, क्यूँके भोत-से लोग झूठ्ठी शिक्षा तै दुसरयां नै धोक्खा देण आळे, इस दुनिया म्ह अलग-अलग जगहां तै लिकड़ आए सै, वे कहवै सै, के मसीह इस दुनिया म्ह इन्सान का रूप धारण करकै न्ही आया, जै कोए माणस ये बात कहवै सै तो वो माणस यीशु मसीह का बिरोधी सै, वो दुसरयां ताहीं भरमाण आळा सै। <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />थमनै चौक्‍कस रहणा चाहिए, के ये लोग थमनै धोक्खा न्ही देण पावै, ताके परमेसवर की सेवा करण म्ह जो मेहनत थमनै करी सै, वा बेकार ना जावै, पर परमेसवर थारी उस मेहनत का थमनै ईनाम देवैगा। <verse eid="2JN 1:8" /><verse number="9" style="v" sid="2JN 1:9" />जै कोए माणस, मसीह नै जो शिक्षाएँ दी सै उसका पालन न्ही करदा, अर अपणी ओड़ तै उन शिक्षा म्ह कुछ और जोडै सै, तो उसकी परमेसवर कै गैल साझेदारी कोनी, पर जो कोए उसकी दी गई शिक्षा का पालन करदा रह सै, उसकी पिता परमेसवर अर उसके बेट्टे यीशु मसीह कै गैल साझेदारी सै। <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />जै कोए थारे धोरै आवै अर वा शिक्षा दे जो मसीह की शिक्षा तै न्यारी सै, तो उस ताहीं थम ना तो घर म्ह आण द्यो अर ना नमस्कार करो। <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />क्यूँके जो कोए इसे माणस नै नमस्कार करै सै, वो उसके भुन्डे़ काम्मां म्ह साझ्झी होवै सै।<verse eid="2JN 1:11" /></para>
  <para style="s">आखरी नमस्कार</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />मन्‍नै घणीए बात थारे ताहीं बताणी सै, पर मै उन बात्तां नै इस चिट्ठी म्ह लिखणा कोनी चाहन्दा, अर उम्मीद सै के मै थारे धोरै आऊँगा, अर आम्ही-स्याम्ही थारे तै बात करुँगा, अर फेर हम आच्छी ढाळ खुशी मनावांगे। <verse eid="2JN 1:12" /><verse number="13" style="v" sid="2JN 1:13" />परमेसवर के जरिये चुणी गई बेब्बे के बाळकां का, थारे ताहीं नमस्कार।<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>