<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id"/>
  <para style="h">2 यूहन्ना</para>
  <para style="toc3">2 यूह</para>
  <para style="toc2">2 यूहन्ना</para>
  <para style="toc1">2 यूहन्ना</para>
  <para style="mt1">यूहन्ना की दुसरी चिट्ठी</para>
  <para style="is">जानकारी</para>
  <para style="ip">यूहन्ना की दुसरी चिट्ठी “यूहन्ना” की ओड़ तै चुणी होई बिरबान्नी अर उसकै बाळकां कै नाम लिक्खी गई सै, हो सके सै: उसका मतलब एक घरेलू कलीसिया अर उसकै सदस्य। साफ तौर तै इसका सन्देस सै, एक-दुसरयां तै प्यार करण की बिनती अर झूठ्ठी शिक्षकां अर उनकी झूठ्ठी शिक्षा के खिलाफ चेतावनी।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">जानकारी 1-3</para>
  <para style="io1">प्यार की बड़ाई 4-6</para>
  <para style="io1">झूठ्ठे रीति-रिवाजां के खिलाफ चेतावनी 7-11</para>
  <para style="io1">समापन 12,13</para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="s">नमस्कार</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1"/>या चिट्ठी मुझ यूहन्ना की ओड़ तै सै, जो कलीसिया का अगुवां सै, मै उस परमेसवर के जरिये चुणी गई बिरबान्नी अर उसके बाळकां के नाम या चिट्ठी लिखण लागरया सूं, जिनतै मै सच्चा प्यार करुँ सूं, अर सिर्फ मै ए न्ही बल्के वे सारे भी प्यार करै सै, जो सच्चाई नै जाणै सै। <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>हम थारे तै प्यार करा सां, क्यूँके सच्ची शिक्षा म्हारे म्ह रहवै सै, अर म्हारे साथ सदा रहवैगी। <verse eid="2JN 1:2"/><verse number="3" style="v" sid="2JN 1:3"/>परमेसवर पिता, अर उसके बेट्टे यीशु मसीह की ओड़ तै अनुग्रह, दया, शान्ति, ये सब उनकै साथ रहवैंगी, जो इस सच्चाई नै मान्नै सै, अर एक-दुसरे तै प्यार करै सै।<verse eid="2JN 1:3"/></para>
  <para style="s">सच अर प्यार</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>मै घणा राज्जी होया के मन्नै तेरे कई बाळकां ताहीं उस हुकम कै मुताबिक, जो म्हारै पिता की ओड़ तै मिल्या था, सच पै चाल्दे होए पाया। <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/>इब हे नारी, मै तेरे तै बिनती करुँ सूं, के हमनै एक-दुसरे तै प्यार करणा चाहिए, यो कोए नया हुकम कोनी, बल्के यो वो हुकम सै जिसनै हम उस बखत तै जाणा सां, जिब हमनै मसीह कै पाच्छै चालणा शरु करया था। <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>अर सच्चा प्यार यो सै, के हम परमेसवर के हुकमां कै मुताबिक चाल्लां, जिस दिन तै थमनै मसीह कै पाच्छै चालणा शरु करया था, उस दिन तै थम जाणो सों, के परमेसवर नै म्हारे ताहीं हुकम दिया सै, के हम सदा एक-दुसरे तै प्यार करा। <verse eid="2JN 1:6"/><verse number="7" style="v" sid="2JN 1:7"/>मै ज्यांतै कहूँ सूं, क्यूँके भोत-से लोग झूठ्ठी शिक्षा तै दुसरयां नै धोक्खा देण आळे, इस दुनिया म्ह अलग-अलग जगहां तै लिकड़ आए सै, वे कहवै सै, के मसीह इस दुनिया म्ह इन्सान का रूप धारण करकै न्ही आया, जै कोए माणस ये बात कहवै सै तो वो माणस यीशु मसीह का बिरोधी सै, वो दुसरयां ताहीं भरमाण आळा सै। <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>थमनै चौक्कस रहणा चाहिए, के ये लोग थमनै धोक्खा न्ही देण पावै, ताके परमेसवर की सेवा करण म्ह जो मेहनत थमनै करी सै, वा बेकार ना जावै, पर परमेसवर थारी उस मेहनत का थमनै ईनाम देवैगा। <verse eid="2JN 1:8"/><verse number="9" style="v" sid="2JN 1:9"/>जै कोए माणस, मसीह नै जो शिक्षाएँ दी सै उसका पालन न्ही करदा, अर अपणी ओड़ तै उन शिक्षा म्ह कुछ और जोडै सै, तो उसकी परमेसवर कै गैल साझेदारी कोनी, पर जो कोए उसकी दी गई शिक्षा का पालन करदा रह सै, उसकी पिता परमेसवर अर उसके बेट्टे यीशु मसीह कै गैल साझेदारी सै। <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>जै कोए थारे धोरै आवै अर वा शिक्षा दे जो मसीह की शिक्षा तै न्यारी सै, तो उस ताहीं थम ना तो घर म्ह आण द्यो अर ना नमस्कार करो। <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>क्यूँके जो कोए इसे माणस नै नमस्कार करै सै, वो उसके भुन्डे़ काम्मां म्ह साझ्झी होवै सै।<verse eid="2JN 1:11"/></para>
  <para style="s">आखरी नमस्कार</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>मन्नै घणीए बात थारे ताहीं बताणी सै, पर मै उन बात्तां नै इस चिट्ठी म्ह लिखणा कोनी चाहन्दा, अर उम्मीद सै के मै थारे धोरै आऊँगा, अर आम्ही-स्याम्ही थारे तै बात करुँगा, अर फेर हम आच्छी ढाळ खुशी मनावांगे। <verse eid="2JN 1:12"/><verse number="13" style="v" sid="2JN 1:13"/>परमेसवर के जरिये चुणी गई बेब्बे के बाळकां का, थारे ताहीं नमस्कार।<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
