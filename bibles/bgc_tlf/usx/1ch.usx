<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CH" style="id" />
  <para style="ide">UTF-8</para>
  <para style="rem">Copyright Information: Creative Commons Attribution-ShareAlike 4.0 License</para>
  <para style="h">1 इतिहास</para>
  <para style="toc1">इतिहास की पैहली किताब</para>
  <para style="toc2">1 इतिहास</para>
  <para style="toc3">1 इति.</para>
  <para style="mt">इतिहास की पैहली किताब</para>
  <para style="is">लेखक</para>
  <para style="ip">1 इतिहास की किताब म्ह लेखक का नाम न्ही सै, यहूदी परम्परा के मुताबिक एज्रा इसका लेखक सै। 1 इतिहास की किताब की शरुआत इस्राएलियाँ के परिवारां की सूची तै होवै सै। ठीक उसकै बाद संगठित राज्य इस्राएल पै राजा दाऊद के राज्यकाल का वृत्तान्त दिया गया सै। यो किताब राजा दाऊद की कहाँनी की निकट झलक सै जो पुराणे नियम का एक खास नायक था। इसका व्यापक झलक प्राचीन इस्राएल का राजनैतिक अर धार्मिक इतिहास सै।</para>
  <para style="is">लेखन तारिख अर जगहां</para>
  <para style="ip">लगभग 450-400 ई. पू.</para>
  <para style="ip">या पक्‍का सै की इसका बखत बाबेल की बन्धुआई तै लौटण के बाद का सै। <char style="xt"><ref loc="1CH 3:19-24">1 इति. 3:19-24</ref></char> म्ह दाऊद के वंश नै जरुब्बाबेल कै पाच्छै ताहीं, छटी पीढ़ी तक दर्शाया गया सै।</para>
  <para style="is">प्रापक</para>
  <para style="ip">प्राचीनकाल के यहूदी अर सारे बाइबल पाठक</para>
  <para style="is">मकसद</para>
  <para style="ip">1 इतिहास की किताब बन्धुआई तै लौटण आळे यहूदियाँ खात्तर लिखी गई थी की वे परमेसवर की उपासना किस तरियां करै। इसका इतिहास दक्षिणी राज्य-यहूदा, बिन्‍यामीन अर लेवी के गोत्रां पै केन्द्रित सै। ये गोत्र परमेसवर के घणे स्वामिभक्त प्रतीत होवै थे। परमेसवर नै दाऊद के परिवार या राज्य नै सदा खात्तर मजबूत राक्खण का करार बांध्या था, जिस ताहीं वो बिश्वासयोग्य रह्या। संसारिक राजा इसा न्ही कर सकै थे, दाऊद अर सुलैमान के द्वारा परमेसवर नै अपणा मन्दर बणवाया जित्त लोग आराधना खात्तर आ सकै थे। सुलैमान द्वारा निर्मित मन्दर बाबेल की सेना नै नाश कर दिया था।</para>
  <para style="is">खास बातें</para>
  <para style="ip">इस्राएल का आध्यात्मिक इतिहास</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. वंशावली <char style="ior"><ref loc="1CH 1:1-9:44">1:1-9:44</ref></char></para>
  <para style="io1">2. शाऊल की मौत <char style="ior"><ref loc="1CH 10:1-14">10:1-14</ref></char></para>
  <para style="io1">3. दाऊद का अभिषेक अर सत्ता <char style="ior"><ref loc="1CH 11:1-29:30">11:1-29:30</ref> </char></para>
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s">आदम तै अब्राहम ताहीं वंशावली</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 1:1" />आदम, शेत, एनोश; <verse eid="1CH 1:1" /><verse number="2" style="v" sid="1CH 1:2" />केनान, महललेल, येरेद; <verse eid="1CH 1:2" /><verse number="3" style="v" sid="1CH 1:3" />हनोक, मतूशेलह, लेमेक; <verse eid="1CH 1:3" /><verse number="4" style="v" sid="1CH 1:4" />नूह, शेम, हाम अर येपेत<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="fq" closed="false">येपेत </char><char style="ft" closed="false">लूका 3:36-38</char></note>।<verse eid="1CH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 1:5" />येपेत के बेट्टे: गोमेर, मागोग, मादै, यावान, तूबल, मेशेक अर तीरास। <verse eid="1CH 1:5" /><verse number="6" style="v" sid="1CH 1:6" />गोमेर के बेट्टे: अश्कनज, दीपत अर तोगर्मा <verse eid="1CH 1:6" /><verse number="7" style="v" sid="1CH 1:7" />यावान के बेट्टे: एलीशा, तर्शीश, अर कित्ती अर रोदानी माणस।<verse eid="1CH 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 1:8" />हाम के बेट्टे: कूश, मिस्र पूत अर कनान थे। <verse eid="1CH 1:8" /><verse number="9" style="v" sid="1CH 1:9" />कूश के बेट्टे: सबा, हवीला, सबता, रामाह अर सब्तका थे। अर रामाह के बेट्टे: शेबा अर ददान थे। <verse eid="1CH 1:9" /><verse number="10" style="v" sid="1CH 1:10" />अर कूश तै निम्रोद<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fq" closed="false">निम्रोद </char><char style="ft" closed="false">निम्रोद अश्शूर का संस्थापक था। (देखें उत्पत्ति 10:8-12) भविष्यवक्ता मीका अश्शूर को निम्रोद की धरती (मीका 5:6) के रूप म्ह संदर्भित करै सै। निम्रोद के मेसोपोटामिया के वंशज उस बखत के दौरान इस्राएल के बड़े दुश्मन बणगे जिब अश्शूरियां अर बेबीलोनियां नै प्राचीन धोरै पूर्व पै शासन करया था।</char></note> पैदा होया; धरती पै पैहला वीर वोए होया।<verse eid="1CH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 1:11" />अर मिस्र तै लूदी, अनामी, लहाबी, नप्तूही, <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" />पत्रूसी, कसलूही (जिनतै पलिश्ती पैदा होए) अर कप्तोरी पैदा होए।<verse eid="1CH 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 1:13" />कनान तै उसका जेठ्ठा सीदोन अर हित्त, <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />अर यबूसी, एमोरी, गिर्गाशी, <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" />हिब्बी, अर्की, सीनी, <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" />अर्वदी, समारी अर हमाती पैदा होए।<verse eid="1CH 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 1:17" />शेम के बेट्टे एलाम, अश्शूर, अर्पक्षद, लूद, अराम, ऊस, हूल, गेतेर अर मेशेक थे। <verse eid="1CH 1:17" /><verse number="18" style="v" sid="1CH 1:18" />अर अर्पक्षद तै शेलह अर शेलह तै एबेर पैदा होया। <verse eid="1CH 1:18" /><verse number="19" style="v" sid="1CH 1:19" />एबेर के दो बेट्टे पैदा होये एक का नाम पेलेग इस कारण धरया गया के उसके दिनां म्ह माणस अलग-अलग भाषा समूह म्ह बँटगे; अर उसके भाई का नाम योक्तान था। <verse eid="1CH 1:19" /><verse number="20" style="v" sid="1CH 1:20" />अर योक्तान तै अल्मोदाद, शेलेप, हसर्मावेत, येरह, <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" />हदोराम, ऊजाल, दिक्ला, <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" />एबाल, अबीमाएल, शेबा, <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" />ओपीर, हवीला अर योबाब पैदा होए; येए सारे योक्तान के बेट्टे थे।<verse eid="1CH 1:23" /></para>
  <para style="s">शेम की वंशावली</para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 1:24" />शेम, अर्पक्षद, शेलह, <verse eid="1CH 1:24" /><verse number="25" style="v" sid="1CH 1:25" />एबेर, पेलेग, रु, <verse eid="1CH 1:25" /><verse number="26" style="v" sid="1CH 1:26" />सरूग, नाहोर, तेरह, <verse eid="1CH 1:26" /><verse number="27" style="v" sid="1CH 1:27" />अब्राम, वो अब्राहम भी कुह्वावै सै। <verse eid="1CH 1:27" /><verse number="28" style="v" sid="1CH 1:28" />अब्राहम के बेट्टे इसहाक अर इश्माएल<note caller="+" style="f"><char style="fr" closed="false">1:28 </char><char style="fq" closed="false">इसहाक अर इश्माएल </char><char style="ft" closed="false">हालाकि इसहाक इश्माएल तै छोट्टा था, पर उसका नाम पैहले लिख्‌या गया सै क्यूँके वो वैध औलाद था, क्यूँके उसकी माँ सारा अब्राहम की वास्तविक पत्नी थी।</char></note>।<verse eid="1CH 1:28" /></para>
  <para style="s">इश्माएल की वंशावली</para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 1:29" />इनकी पीढ़ियाँ ये सैं। इश्माएल का जेठ्ठा नबायोत, फेर केदार, अदबएल, मिबसाम, <verse eid="1CH 1:29" /><verse number="30" style="v" sid="1CH 1:30" />मिश्मा, दूमा, मस्सा, हदद, तेमा, <verse eid="1CH 1:30" /><verse number="31" style="v" sid="1CH 1:31" />यतूर, नापीश, केदमा। ये इश्माएल के बेट्टे होए।<verse eid="1CH 1:31" /></para>
  <para style="s">कतूरा की सन्तान</para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 1:32" />फेर कतूरा जो अब्राहम की रखैल थी, उसके ये बेट्टे पैदा होए, यानिके उसतै जिम्रान, योक्षान, मदान, मिद्यान, यिशबाक अर शूह पैदा होए। योक्षान के बेट्टे: शेबा अर ददान। <verse eid="1CH 1:32" /><verse number="33" style="v" sid="1CH 1:33" />अर मिद्यान के बेट्टे: एपा, एपेर, हनोक, अबीदा अर एल्दा, ये सारे कतूरा के वंशज सैं।<verse eid="1CH 1:33" /></para>
  <para style="s">इसहाक की वंशावली</para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 1:34" />अब्राहम तै इसहाक पैदा होया। इसहाक के बेट्टे: एसाव अर इस्राएल। <verse eid="1CH 1:34" /><verse number="35" style="v" sid="1CH 1:35" />एसाव के बेट्टे: एलीपज, रूएल, यूश, यालाम अर कोरह थे। <verse eid="1CH 1:35" /><verse number="36" style="v" sid="1CH 1:36" />एलीपज के ये बेट्टे होए: तेमान, ओमार, सपी, गाताम, कनज, तिम्ना अर अमालेक। <verse eid="1CH 1:36" /><verse number="37" style="v" sid="1CH 1:37" />रूएल के बेट्टे: नहत, जेरह, शम्मा अर मिज्जा।<verse eid="1CH 1:37" /></para>
  <para style="s">सेईर की वंशावली</para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 1:38" />फेर सेईर के बेट्टे: लोतान, शोबाल, सिबोन, अना, दीशोन, एसेर अर दीशान होए। <verse eid="1CH 1:38" /><verse number="39" style="v" sid="1CH 1:39" />अर लोतान के बेट्टे: होरी अर होमाम, अर लोतान की भाण तिम्ना थी। <verse eid="1CH 1:39" /><verse number="40" style="v" sid="1CH 1:40" />शोबाल के बेट्टे: अल्यान, मानहत, एबाल, शपी अर ओनाम। अर सिबोन के बेट्टे: अय्या, अर अना। <verse eid="1CH 1:40" /><verse number="41" style="v" sid="1CH 1:41" />अना का बेट्टा: दीशोन। अर दीशोन के बेट्टा: हम्रान, एशबान, यित्रान अर करान। <verse eid="1CH 1:41" /><verse number="42" style="v" sid="1CH 1:42" />एसेर के बेट्टे: बिल्हान, जावान अर याकान। अर दीशान के बेट्टे: ऊस अर अरान।<verse eid="1CH 1:42" /></para>
  <para style="s">एदोमियां का राजा</para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 1:43" />जिब किसे राजा नै इस्राएलियाँ पै राज न्ही करया था, फेर एदोम के देश म्ह ये राजा होए यानिके बोर का बेट्टा बेला अर उसकी राजधानी का नाम दिन्हाबा था। <verse eid="1CH 1:43" /><verse number="44" style="v" sid="1CH 1:44" />बेला के मरण पै, बोस्राई जेरह का बेट्टा योबाब, उसकी जगहां पै राजा होया। <verse eid="1CH 1:44" /><verse number="45" style="v" sid="1CH 1:45" />अर योबाब कै मरण पै, तेमानियाँ के देश का हूशाम उसकी जगहां पै राजा होया। <verse eid="1CH 1:45" /><verse number="46" style="v" sid="1CH 1:46" />फेर हूशाम कै मरण पै, बदद का बेट्टा हदद, उसकी जगहां पै राजा होया: यो वोए सै जिसनै मिद्यानियाँ ताहीं मोआब के देश म्ह मार दिया; अर उसकी राजधानी का नाम अबीत था। <verse eid="1CH 1:46" /><verse number="47" style="v" sid="1CH 1:47" />अर हदद कै मरण पै, मस्रेकाई सम्ला उसके जगहां पै राजा होया। <verse eid="1CH 1:47" /><verse number="48" style="v" sid="1CH 1:48" />फेर सम्ला कै मरण पै शाऊल, जो महानद के तट पै के रहोबोत नगर का था, वो उसकी जगहां पै राजा होया। <verse eid="1CH 1:48" /><verse number="49" style="v" sid="1CH 1:49" />अर शाऊल कै मरण पै अकबोर का बेट्टा बाल्हानान उसकी जगहां पै राजा होया। <verse eid="1CH 1:49" /><verse number="50" style="v" sid="1CH 1:50" />अर बाल्हानान कै मरण पै, हदद उसकी जगहां पै राजा होया; अर उसकी राजधानी का नाम पाऊ होया, उसकी घरआळी का नाम महेतबेल था जो मेज़ाहाब की नातिन अर मत्रेद की बेट्टी थी। <verse eid="1CH 1:50" /><verse number="51" style="v" sid="1CH 1:51" />अर हदद मर ग्या।</para>
  <para style="p" vid="1CH 1:51">फेर एदोम के अधिपति ये थे: यानिके अधिपति तिम्ना, अधिपति अल्वा, अधिपति यतेत, <verse eid="1CH 1:51" /><verse number="52" style="v" sid="1CH 1:52" />अधिपति ओहोलीबामा, अधिपति एला, अधिपति पीनोन, <verse eid="1CH 1:52" /><verse number="53" style="v" sid="1CH 1:53" />अधिपति कनज, अधिपति तेमान, अधिपति मिबसार, <verse eid="1CH 1:53" /><verse number="54" style="v" sid="1CH 1:54" />अधिपति मग्दीएल, अधिपति ईराम। एदोम के ये अधिपति होए।<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 2:1" />इस्राएल कै ये बारहा बेट्टे होए<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fq" closed="false">इस्राएल कै ये बारहा बेट्टे होए </char><char style="ft" closed="false">उरै नाम्मां का क्रम उनके जन्म की अर वैधता कै हिसाब तै सै।</char></note>; रूबेन, शिमोन, लेवी, यहूदा, इस्साकार, जबूलून, <verse eid="1CH 2:1" /><verse number="2" style="v" sid="1CH 2:2" />दान, यूसुफ, बिन्‍यामीन, नप्ताली, गाद अर आशेर।<verse eid="1CH 2:2" /></para>
  <para style="s">यहूदा तै दाऊद ताहीं की वंशावली</para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 2:3" />यहूदा के ये बेट्टे होए एर, ओनान अर शेला, उसके ये तीन्‍नु बेट्टे, शूआ नाम की एक कनानी बिरबान्‍नी की बेट्टी तै पैदा होए। अर यहूदा का जेठ्ठा एर, यहोवा की नजर म्ह बुरा था, इस कारण उसनै उस ताहीं मार दिया। <verse eid="1CH 2:3" /><verse number="4" style="v" sid="1CH 2:4" />यहूदा की बहू तामार तै पेरेस अर जेरह पैदा होए। यहूदा के कुल पाँच बेट्टे होए।<verse eid="1CH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 2:5" />पेरेस के बेट्टे: हेस्रोन अर हामूल। <verse eid="1CH 2:5" /><verse number="6" style="v" sid="1CH 2:6" />अर जेरह के बेट्टे: जिम्री, एतान, हेमान, कलकोल अर दारा सारे मिलकै पाँच बेट्टे होए। <verse eid="1CH 2:6" /><verse number="7" style="v" sid="1CH 2:7" />फेर कर्मी<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="fq" closed="false">कर्मी </char><char style="ft" closed="false">कर्मी समर्पित करी गई लूट म्ह तै कुछ ताहीं राक्खण के जरिये इस्राएलियाँ पै विपत्ति ल्याया। यहोशू अध्याय 7 </char></note> का बेट्टा: आकार जो चढ़ाई होई चिज्जां कै बारै म्ह बिश्वासघात करकै इस्राएलियाँ नै दुख देण आळा होया। <verse eid="1CH 2:7" /><verse number="8" style="v" sid="1CH 2:8" />अर एतान का बेट्टा: अजर्याह। <verse eid="1CH 2:8" /><verse number="9" style="v" sid="1CH 2:9" />हेस्रोन के जो बेट्टे पैदा होए यरहमेल, राम अर कलूबै। <verse eid="1CH 2:9" /><verse number="10" style="v" sid="1CH 2:10" />अर राम तै अम्मीनादाब अर अम्मीनादाब तै नहशोन पैदा होया जो यहूदा वंशियाँ का प्रधान बण्या। <verse eid="1CH 2:10" /><verse number="11" style="v" sid="1CH 2:11" />अर नहशोन तै सल्मा अर सल्मा तै बोअज; <verse eid="1CH 2:11" /><verse number="12" style="v" sid="1CH 2:12" />अर बोअज तै ओबेद अर ओबेद<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="fq" closed="false">ओबेद </char><char style="ft" closed="false">मत्ती 1:4-5</char></note> तै यिशै पैदा होया। <verse eid="1CH 2:12" /><verse number="13" style="v" sid="1CH 2:13" />अर यिशै तै उसका जेठ्ठा एलीआब अर दूसरा अबीनादाब तीसरा शिमा, <verse eid="1CH 2:13" /><verse number="14" style="v" sid="1CH 2:14" />चौथा नतनेल अर पाँचवाँ रद्दैं। <verse eid="1CH 2:14" /><verse number="15" style="v" sid="1CH 2:15" />छठा ओसेम अर सातवाँ दाऊद पैदा होया। <verse eid="1CH 2:15" /><verse number="16" style="v" sid="1CH 2:16" />इनकी भाण सरूयाह अर अबीगैल थी। अर सरूयाह के बेट्टे अबीशै, योआब अर असाहेल ये तीन थे। <verse eid="1CH 2:16" /><verse number="17" style="v" sid="1CH 2:17" />अर अबीगैल तै अमासा पैदा होया, अर अमासा का बाप इश्माएली येतेर था।<verse eid="1CH 2:17" /></para>
  <para style="s">हेस्रोन के वंशज</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 2:18" />हेस्रोन के बेट्टे कालेब के अजूबा नाम एक औरत तै, अर यरीओत तै, बेट्टे पैदा होए; अर इसके बेट्टे ये होए; यानिके येशेर, शोबाब अर अर्दोन। <verse eid="1CH 2:18" /><verse number="19" style="v" sid="1CH 2:19" />जिब अजूबा मरगी, फेर कालेब नै एप्राता ताहीं ब्याह लिया; अर जिसतै हूर पैदा होया। <verse eid="1CH 2:19" /><verse number="20" style="v" sid="1CH 2:20" />अर हूर तै ऊरी अर ऊरी तै बसलेल पैदा होया।<verse eid="1CH 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 2:21" />इसकै बाद हेस्रोन गिलाद के पिता माकीर की बेट्टी कै धोरै गया, जिसतै उसनै जिब ब्याह लिया, जिब वो साठ साल का था; अर उसतै सगूब पैदा होया। <verse eid="1CH 2:21" /><verse number="22" style="v" sid="1CH 2:22" />अर सगूब तै याईर पैदा होया, जिसके गिलाद देश म्ह तेईस नगर थे। <verse eid="1CH 2:22" /><verse number="23" style="v" sid="1CH 2:23" />अर गशूर अर अराम नै याईर की बस्तियाँ ताहीं अर गाम समेत कनात ताहीं, उनतै ले लिया; ये सारे नगर मिलकै साठ थे। ये सारे गिलाद के पिता माकीर के बेट्टे थे। <verse eid="1CH 2:23" /><verse number="24" style="v" sid="1CH 2:24" />अर जिब हेस्रोन कालेब एप्राता नगर म्ह मर ग्या, फेर उसकी अबिय्याह नाम औरत तै अशहूर पैदा होया जो तकोआ का पिता होया।<verse eid="1CH 2:24" /></para>
  <para style="s">यरहमेल के वंशज</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 2:25" />अर हेस्रोन के जेठ्ठे यरहमेल के ये बेट्टे होए यानिके राम जो उसका जेठ्ठा था; अर बूना, ओरेन, ओसेम अर अहिय्याह। <verse eid="1CH 2:25" /><verse number="26" style="v" sid="1CH 2:26" />अर यरहमेल की एक और घरआळी थी, जिसका नाम अतारा था; वा ओनाम की माँ थी। <verse eid="1CH 2:26" /><verse number="27" style="v" sid="1CH 2:27" />अर यरहमेल के जेठ्ठे राम के ये बेट्टे होए यानिके मास, यामीन अर एकेर। <verse eid="1CH 2:27" /><verse number="28" style="v" sid="1CH 2:28" />अर ओनाम के बेट्टे शम्मै अर यादा होए। अर शम्मै के बेट्टे नादाब अर अबीशूर होए। <verse eid="1CH 2:28" /><verse number="29" style="v" sid="1CH 2:29" />अर अबीशूर की घरआळी का नाम अबीहैल था, अर उसतै अहबान अर मोलीद पैदा होए। <verse eid="1CH 2:29" /><verse number="30" style="v" sid="1CH 2:30" />अर नादाब के बेट्टे सेलेद अर अप्पैम होए; सेलेद तो बे-ऊलाद मर ग्या <verse eid="1CH 2:30" /><verse number="31" style="v" sid="1CH 2:31" />अर अप्पैम का बेट्टा यिशी अर यिशी का बेट्टा शेशान अर शेशान का बेट्टा: अहलै। <verse eid="1CH 2:31" /><verse number="32" style="v" sid="1CH 2:32" />फेर शम्मै के भाई यादा के बेट्टे: येतेर अर योनातान होए; येतेर तो बे-ऊलाद मर ग्या। <verse eid="1CH 2:32" /><verse number="33" style="v" sid="1CH 2:33" />योनातान के बेट्टे पेलेत अर जाजा; यरहमेल के बेट्टे ये होए। <verse eid="1CH 2:33" /><verse number="34" style="v" sid="1CH 2:34" />शेशान के तो बेट्टा ना होया, सिर्फ बेटियाँ होई। शेशान कै धोरै यर्हा नाम एक मिस्री दास था। <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" />अर शेशान नै उस ताहीं अपणी बेट्टी ब्याह दी, अर उसतै अत्तै पैदा होया। <verse eid="1CH 2:35" /><verse number="36" style="v" sid="1CH 2:36" />अर अत्तै तै नातान, नातान तै जाबाद, <verse eid="1CH 2:36" /><verse number="37" style="v" sid="1CH 2:37" />जाबाद तै एपलाल, एपलाल तै ओबेद, <verse eid="1CH 2:37" /><verse number="38" style="v" sid="1CH 2:38" />ओबेद तै येहू, येहू तै अजर्याह, <verse eid="1CH 2:38" /><verse number="39" style="v" sid="1CH 2:39" />अजर्याह तै हेलेस, हेलेस तै एलासा, <verse eid="1CH 2:39" /><verse number="40" style="v" sid="1CH 2:40" />एलासा तै सिस्मै, सिस्मै तै शल्‍लूम, <verse eid="1CH 2:40" /><verse number="41" style="v" sid="1CH 2:41" />शल्‍लूम तै यकम्याह अर यकम्याह तै एलीशामा पैदा होए।<verse eid="1CH 2:41" /></para>
  <para style="s">कालेब के वंशज</para>
  <para style="p">
    <verse number="42" style="v" sid="1CH 2:42" />फेर यरहमेल के भाई कालेब के ये बेट्टे होए यानिके उसका जेठ्ठा मेशा जो जीप का पिता होया। अर मारेशा का बेट्टा हेब्रोन भी उसे कै वंश म्ह होया। <verse eid="1CH 2:42" /><verse number="43" style="v" sid="1CH 2:43" />अर हेब्रोन के बेट्टे कोरह, तप्पूह, रेकेम अर शेमा। <verse eid="1CH 2:43" /><verse number="44" style="v" sid="1CH 2:44" />अर शेमा तै योर्काम का पिता रहम अर रेकेम तै शम्मै पैदा होया था। <verse eid="1CH 2:44" /><verse number="45" style="v" sid="1CH 2:45" />अर शम्मै का बेट्टा माओन होया; अर माओन बेतसूर का पिता होया। <verse eid="1CH 2:45" /><verse number="46" style="v" sid="1CH 2:46" />फेर एपा जो कालेब की रखैल थी, उसतै हारान, मोसा अर गाजेज पैदा होए; अर हारान तै गाजेज पैदा होया। <verse eid="1CH 2:46" /><verse number="47" style="v" sid="1CH 2:47" />फेर याहदै के बेट्टे रेगेम, योताम, गेशान, पेलेत, एपा अर शाप। <verse eid="1CH 2:47" /><verse number="48" style="v" sid="1CH 2:48" />अर माका जो कालेब की रखैल थी, उसतै शेबेर अर तिर्हाना पैदा होए। <verse eid="1CH 2:48" /><verse number="49" style="v" sid="1CH 2:49" />फेर उसतै मदमन्‍ना का पिता शाप अर मकबेना अर गिबा का पिता शबा पैदा होए। अर कालेब की बेट्टी अकसा थी। कालेब के वंश म्ह ये होए। <verse eid="1CH 2:49" /><verse number="50" style="v" sid="1CH 2:50" />एप्राता के जेठ्ठे हूर का बेट्टा: किर्यत्यारीम का पिता शोबाल, <verse eid="1CH 2:50" /><verse number="51" style="v" sid="1CH 2:51" />बैतलहम का पिता सल्मा अर बेतगादेर का पिता हारेप। <verse eid="1CH 2:51" /><verse number="52" style="v" sid="1CH 2:52" />अर किर्यत्यारीम के पिता शोबाल कै वंश म्ह हारोए आध्धे मनुहोतवासी, <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" />अर किर्यत्यारीम के कुल यानिके येतेरी, पूती, शूमाती अर मिश्राई अर इनतै सोराई अर एश्ताओली लिकड़े। <verse eid="1CH 2:53" /><verse number="54" style="v" sid="1CH 2:54" />फेर सल्मा कै वंश म्ह बैतलहम अर नतोपाई, अत्रोतबेत्योआब अर आध्धे मानहती, सोरी। <verse eid="1CH 2:54" /><verse number="55" style="v" sid="1CH 2:55" />याबेस शहर म्ह रहणआळे लेखकां के कुल यानिके तिराती, शिमाती अर सूकाती होए। ये रेकाब के घरान्‍ने के मूलपुरुष हम्मत के वंश आळे केनी सैं।<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s">दाऊद की वंशावली</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 3:1" />दाऊद के बेट्टे जो हेब्रोन म्ह उसतै पैदा होए वे ये सै: जेठ्ठा अम्नोन जो यिज्रेली शहर अहीनोअम तै, दूसरा दानिय्येल जो कर्मेली शहर अबीगैल तै पैदा होया। <verse eid="1CH 3:1" /><verse number="2" style="v" sid="1CH 3:2" />तीसरा अबशालोम जो गशूर<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fq" closed="false">गशूर </char><char style="ft" closed="false">गशूर एक छोट्टा सीरिया राज्य था जो गलील सागर के उत्तर-पूर्व म्ह स्थित था।</char></note> के राजा तल्मै की बेट्टी माका का बेट्टा था, चौथा अदोनिय्याह जो हग्गीत का बेट्टा था। <verse eid="1CH 3:2" /><verse number="3" style="v" sid="1CH 3:3" />पाँचवाँ शपत्याह जो अबीतल तै, अर छठवाँ यित्राम जो उसकी घरआळी एग्ला तै पैदा होया। <verse eid="1CH 3:3" /><verse number="4" style="v" sid="1CH 3:4" />दाऊद के हेब्रोन म्ह छः बेट्टे पैदा होए, अर ओड़ै उसनै साढ़े सात साल राज करया; यरुशलेम म्ह तैंतीस साल राज करया। <verse eid="1CH 3:4" /><verse number="5" style="v" sid="1CH 3:5" />यरुशलेम म्ह उसके ये बेट्टे पैदा होए: यानिके शिमा, शोबाब, नातान अर सुलैमान, ये च्यांरु अम्मीएल की बेट्टी बतशेबा तै पैदा होए। <verse eid="1CH 3:5" /><verse number="6" style="v" sid="1CH 3:6" />अर यिभार, एलीशामा एलीपेलेत, <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" />नोगह, नेपेग, यापी, <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" />एलीशामा, एल्यादा अर एलीपेलेत, ये नौ बेट्टे थे। <verse eid="1CH 3:8" /><verse number="9" style="v" sid="1CH 3:9" />ये सारे दाऊद के बेट्टे थे; अर इननै छोड़ रखैलां के भी बेट्टे थे, अर इनकी भाण तामार थी।<verse eid="1CH 3:9" /></para>
  <para style="s">सुलैमान के वंशज</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 3:10" />फेर सुलैमान कै बेट्टा रहबाम पैदा होया; रहबाम का अबिय्याह, अबिय्याह का आसा, आसा का यहोशापात, <verse eid="1CH 3:10" /><verse number="11" style="v" sid="1CH 3:11" />यहोशापात का योराम, योराम का अहज्याह, अहज्याह का योआश; <verse eid="1CH 3:11" /><verse number="12" style="v" sid="1CH 3:12" />योआश का अमस्याह, अमस्याह का अजर्याह, अजर्याह का योताम; <verse eid="1CH 3:12" /><verse number="13" style="v" sid="1CH 3:13" />योताम का आहाज, आहाज का हिजकिय्याह, हिजकिय्याह का मनश्शे; <verse eid="1CH 3:13" /><verse number="14" style="v" sid="1CH 3:14" />मनश्शे का आमोन, अर आमोन का योशिय्याह बेट्टा होया<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="fq" closed="false">होया </char><char style="ft" closed="false">मत्ती 1:7-10 </char></note>। <verse eid="1CH 3:14" /><verse number="15" style="v" sid="1CH 3:15" />अर योशिय्याह के बेट्टे: उसका जेठ्ठा योहानान, दूसरा यहोयाकीम; तीसरा सिदकिय्याह, चौथा शल्‍लूम। <verse eid="1CH 3:15" /><verse number="16" style="v" sid="1CH 3:16" />यहोयाकीम का बेट्टा यकोन्याह, इसका बेट्टा सिदकिय्याह<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="fq" closed="false">सिदकिय्याह </char><char style="ft" closed="false">मत्ती 1:11</char></note>। <verse eid="1CH 3:16" /><verse number="17" style="v" sid="1CH 3:17" />अर यकोन्याह का बेट्टा अस्सीर, उसका बेट्टा शालतीएल<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">मत्ती 1:12, लूका 3:27</char></note>; <verse eid="1CH 3:17" /><verse number="18" style="v" sid="1CH 3:18" />अर मल्कीराम, पदायाह, शेनस्सर, यकम्याह, होशामा अर नदब्याह; <verse eid="1CH 3:18" /><verse number="19" style="v" sid="1CH 3:19" />अर पदायाह के बेट्टे जरुब्बाबेल अर शिमी होए; अर जरुब्बाबेल<note caller="+" style="f"><char style="fr" closed="false">3:19 </char><char style="fq" closed="false">जरुब्बाबेल </char><char style="ft" closed="false">जिसनै अन्य स्थानां म्ह शालतीएल का बेट्टा भी कह्या गया सै क्यूँके वोए शालतीएल का उत्तराधिकारी अर वंशज था क्यूँके वो उसका भतीजा था उसके भाई पदायाह का बेट्टा।</char></note> के बेट्टे मशुल्‍लाम अर हनन्याह, जिनकी भाण शलोमीत थी; <verse eid="1CH 3:19" /><verse number="20" style="v" sid="1CH 3:20" />अर हशूबा, ओहेल, बेरेक्याह, हसद्याह अर यूशब-हेसेद, पाँच। <verse eid="1CH 3:20" /><verse number="21" style="v" sid="1CH 3:21" />अर हनन्याह के बेट्टे: पलत्याह अर यशायाह, अर उसका बेट्टा रपायाह, उसका बेट्टा अर्नान, उसका बेट्टा ओबद्याह, उसका बेट्टा शकन्याह। <verse eid="1CH 3:21" /><verse number="22" style="v" sid="1CH 3:22" />अर शकन्याह का बेट्टा शमायाह, अर शमायाह के बेट्टे हत्तूश अर यिगाल, बारीह, नार्याह अर शापात, छः। <verse eid="1CH 3:22" /><verse number="23" style="v" sid="1CH 3:23" />अर नार्याह के बेट्टे एल्योएनै, हिजकिय्याह अर अज्रीकाम, तीन। <verse eid="1CH 3:23" /><verse number="24" style="v" sid="1CH 3:24" />अर एल्योएनै के बेट्टे होदव्याह, एल्याशीब, पलायाह, अक्‍कूब, योहानान, दलायाह अर अनानी, सात।<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s">यहूदा की वंशावली</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 4:1" />यहूदा के बेट्टे: पेरेस, हेस्रोन, कर्मी, हूर अर शोबाल<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">उरै बेट्यां ताहीं “वंशजां” के अर्थ म्ह समझा जाणा चाहिए, क्यूँके इस सूची म्ह सिर्फ पेरेस यहूदा का बेट्टा था।</char></note>। <verse eid="1CH 4:1" /><verse number="2" style="v" sid="1CH 4:2" />अर शोबाल के बेट्टे: रायाह तै यहत अर यहत तै अहूमै अर लहद पैदा होए, ये सोराई कुल सैं। <verse eid="1CH 4:2" /><verse number="3" style="v" sid="1CH 4:3" />एताम के पिता के ये बेट्टे होए यानिके यिज्रेल, यिश्मा अर यिद्वाश, जिनकी भाण का नाम हस्सलेलपोनी था; <verse eid="1CH 4:3" /><verse number="4" style="v" sid="1CH 4:4" />अर गदोर का पिता पनूएल, अर हूशाह का पिता एजेर। ये एप्राता के जेठ्ठे हूर की सन्तान थे, जो बैतलहम का पिता होया। <verse eid="1CH 4:4" /><verse number="5" style="v" sid="1CH 4:5" />अर तकोआ के पिता अशहूर कै हेला अर नारा नाम की दो जनानियाँ थी। <verse eid="1CH 4:5" /><verse number="6" style="v" sid="1CH 4:6" />नारा तै अहुज्जाम, हेपेर, तेमनी अर हाहशतारी पैदा होए, नारा के येए बेट्टे होए। <verse eid="1CH 4:6" /><verse number="7" style="v" sid="1CH 4:7" />अर हेला के बेट्टे, सेरेत, यिसहर अर एत्ना। <verse eid="1CH 4:7" /><verse number="8" style="v" sid="1CH 4:8" />कोस तै आनूब अर सोबेबा पैदा होए अर उसकै वंश म्ह हारूम के बेट्टे अहर्हेल के कुल भी पैदा होए। <verse eid="1CH 4:8" /><verse number="9" style="v" sid="1CH 4:9" />अर याबेस अपणे भाईयाँ तै घणा प्रतिष्ठित होया, अर उसकी माँ नै यो कहकै उसका नाम याबेस<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="fq" closed="false">याबेस </char><char style="ft" closed="false">यो एक हैरान करण आळी बात सै के याबेस का परिचय बिना बखान करया गया सै जिसा के वो एक प्रसिद्ध आदमी था। याबेस के नाम का मतलब सै दुःखी अर उसकी मनोकामना थी के उसनै उसके नाम का जो मतलब सै वो उसपै ना घटै।</char></note> राख्या, “मन्‍नै इसनै पीड़ित होकै पैदा करया।” <verse eid="1CH 4:9" /><verse number="10" style="v" sid="1CH 4:10" />अर एक दिन याबेस नै इस्राएल के परमेसवर तै या कहकै पुकारया, “भला होन्दा, के तू मन्‍नै सचमुच आशीष देन्दा, अर मेरा देश बढ़ान्दा, अर तेरा हाथ मेरै गैल रहन्दा, अर तू मन्‍नै बुराई तै इसा बचाए राखदा के मै उसतै पीड़ित ना होन्दा!” अर जो किमे उसनै मांग्या, वो परमेसवर नै उसतै दिया। <verse eid="1CH 4:10" /><verse number="11" style="v" sid="1CH 4:11" />फेर शूहा के भाई कलूब तै एशतोन का पिता महीर पैदा होया। <verse eid="1CH 4:11" /><verse number="12" style="v" sid="1CH 4:12" />एशतोन के वंश म्ह बेतरापा का घरान्‍नां, अर पासेह अर ईर्नाहाश का पिता तहिन्‍ना पैदा होए, रेका नगर के माणस येए सैं। <verse eid="1CH 4:12" /><verse number="13" style="v" sid="1CH 4:13" />कनज के बेट्टे: ओत्नीएल अर सरायाह, अर ओत्नीएल का बेट्टा हतत। <verse eid="1CH 4:13" /><verse number="14" style="v" sid="1CH 4:14" />मोनोतै तै ओप्रा अर सरायाह तै योआब जो गेहराशीम का पिता होया; वे कारीगर थे। <verse eid="1CH 4:14" /><verse number="15" style="v" sid="1CH 4:15" />अर यपुन्‍ने के बेट्टे कालेब के बेट्टे: ईरू, एला अर नाम; अर एला के बेट्टे: कनज। <verse eid="1CH 4:15" /><verse number="16" style="v" sid="1CH 4:16" />यहलेल के बेट्टे, जीप, जीपा, तीरया अर असरेल। <verse eid="1CH 4:16" /><verse number="17" style="v" sid="1CH 4:17" />अर एज्रा के बेट्टे: येतेर, मेरेद, एपेर अर यालोन, अर उसकी घरआळी तै मिर्याम, शम्मै अर एश्तमो का पिता यिशबह पैदा होए। <verse eid="1CH 4:17" /><verse number="18" style="v" sid="1CH 4:18" />उसकी यहूदिन औरत तै गदोर का पिता येरेद, सोको के पिता हेबेर अर जानोह के पिता यकूतीएल पैदा होए, ये फिरौन राजा की बेट्टी बित्या के बेट्टे थे जिसनै मेरेद ब्याह लिया था। <verse eid="1CH 4:18" /><verse number="19" style="v" sid="1CH 4:19" />अर होदिय्याह की घरआळी जो नहम की भाण थी, उसके बेट्टे: कीला का पिता एक गेरेमी अर एश्तमो का पिता एक माकाई। <verse eid="1CH 4:19" /><verse number="20" style="v" sid="1CH 4:20" />अर शिमोन के बेट्टे: अम्नोन, रिन्‍ना, बेन्हानान अर तोलोन; अर यिशी के बेट्टे: जोहेत अर बेनजोहेत। <verse eid="1CH 4:20" /><verse number="21" style="v" sid="1CH 4:21" />यहूदा के बेट्टे शेला के बेट्टे: लेका का पिता एर, मारेशा का पिता लादा अर बेत-अशबे म्ह उस घरान्‍ने के कुल जिस म्ह सण के कपड़े का काम होवै था; <verse eid="1CH 4:21" /><verse number="22" style="v" sid="1CH 4:22" />अर योकीम अर कोजेबा के माणस अर योआश अर साराप जो मोआब<note caller="+" style="f"><char style="fr" closed="false">4:22 </char><char style="fq" closed="false">मोआब </char><char style="ft" closed="false">दाऊद नै मोआब जीत लिया था (2 शमू 8:2) अर फेर ओम्री नै उस ताहीं जीत्या अर अहाब की मौत वो इस्राएल कै अधीन रहया। (2 राजा 3:5)</char></note> म्ह प्रभुता करैं थे अर याशूब, लेहेम इनका पुराणा जिक्र सै। <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />ये कुम्हार थे, अर नताईम अर गदेरा म्ह रहवैं थे जित्त वे राजा का काम-काज करदे होए उसकै धोरै रहवैं थे।<verse eid="1CH 4:23" /></para>
  <para style="s">शिमोन के वंशज</para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 4:24" />शिमोन के बेट्टे: नमूएल, यामीन, यारीब, जेरह अर शाऊल; <verse eid="1CH 4:24" /><verse number="25" style="v" sid="1CH 4:25" />अर शाऊल का बेट्टा शल्‍लूम, शल्‍लूम का बेट्टा मिबसाम अर मिबसाम का मिश्मा होया। <verse eid="1CH 4:25" /><verse number="26" style="v" sid="1CH 4:26" />अर मिश्मा का बेट्टा हम्मूएल, उसका बेट्टा जक्‍कूर, अर उसका बेट्टा शिमी। <verse eid="1CH 4:26" /><verse number="27" style="v" sid="1CH 4:27" />शिमी के सोलह बेट्टे अर छः बेटियाँ होई पर उसके भाईयाँ के घणे बेट्टे न्ही होए; अर उनका सारा कुल यहूदियाँ के बराबर ना बढ़या। <verse eid="1CH 4:27" /><verse number="28" style="v" sid="1CH 4:28" />वे बेर्शेबा, मोलादा, हसर्शूआल, <verse eid="1CH 4:28" /><verse number="29" style="v" sid="1CH 4:29" />बिल्हा, एसेम, तोलाद, <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" />बतूएल, होर्मा, सिकलग, <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" />बेत्मर्काबोत, हसर्सूसीम, बेतबिरी अर शारैंम म्ह बसगे; दाऊद के राज्य कै बखत उनके येए नगर रहे। <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />अर उनके गाम एताम, ऐन, रिम्मोन, तोकेन अर आशान नाम के पाँच नगर; <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />अर बाल जितने गाम इन नगरां कै आस्सै-पास्सै थे, उनकै बसण की जगहां योए थी, अर या उनकी वंशावली सैं।<verse eid="1CH 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 4:34" />फेर मशोबाब अर यम्लेक अर अमस्याह का बेट्टा योशा, <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" />अर योएल अर योशिब्याह का बेट्टा येहू, जो सरायाह का पोत्ता, अर असीएल का पड़पोत्ता था, <verse eid="1CH 4:35" /><verse number="36" style="v" sid="1CH 4:36" />अर एल्योएनै अर याकोबा, यशोहायाह अर असायाह अर अदीएल अर यसीमीएल अर बनायाह, <verse eid="1CH 4:36" /><verse number="37" style="v" sid="1CH 4:37" />अर शिपी का बेट्टा जीजा जो अल्‍लोन का बेट्टा, यो यदायाह का बेट्टा, यो शिम्री का बेट्टा, यो शमायाह का बेट्टा था। <verse eid="1CH 4:37" /><verse number="38" style="v" sid="1CH 4:38" />ये जिनके नाम लिखे होए सैं, अपणे-अपणे कुल म्ह प्रधान थे; अर उनके पितरां के घरान्‍ने घणे बढ़गे। <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />ये अपणी भेड़-बकरियाँ कै खात्तर चराई ढूँढ़ण नै गदोर शहर की घाटी की तराई कै पूर्व और गए। <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />अर उन बढ़िया तै बढ़िया चराई मिली, अर देश लाम्बा-चौड़ा, चैन अर शान्ति का था; क्यूँके ओड़ै के पैहले रहणआळे हाम के वंश<note caller="+" style="f"><char style="fr" closed="false">4:40 </char><char style="fq" closed="false">हाम के वंश </char><char style="ft" closed="false">वे नूह के बेट्टे हाम के वंशज थे</char></note> के थे। <verse eid="1CH 4:40" /><verse number="41" style="v" sid="1CH 4:41" />अर जिनके नाम उप्पर लिखे सैं, उन यहूदा के राजा हिजकिय्याह के दिनां म्ह ओड़ै आकै जो मूनी ओड़ै मिले, उन डेरां समेत मारकै इसा सत्यानाश कर दिया के आज उनका पता न्ही सै, अर वे उनकी जगहां म्ह रहण लाग्गे, क्यूँके ओड़ै उनकी भेड़-बकरियाँ कै खात्तर चराई थी। <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" />अर उन म्ह तै यानिके शिमोनियां म्ह तै पाँच सौ माणस अपणे उप्पर पलत्याह, नार्याह, रपायाह अर उज्जीएल नाम यिशी के बेट्यां तै अपणा प्रधान ठहराया; <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" />फेर वे सेईद पहाड़ पै गए, अर जो अमालेकी बचकै रह गए थे उन ताहीं मारया, अर आज कै दिन ओड़ै रहवैं सैं।<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s">रूबेन के वंशज</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 5:1" />इस्राएल का जेठ्ठा तो रूबेन था, पर उसनै जो अपणे पिता के बिछोणे ताहीं अशुद्ध करया, इस कारण जेठ्ठे का हक इस्राएल के बेट्टे यूसुफ के बेट्टे ताहीं दिया गया। पीढी<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="fq" closed="false">पीढी </char><char style="ft" closed="false">रूबेन नै बिल्हा के गैल कुकर्म करया था, जो उसके पिता की रखैलियाँ म्ह तै एक थी उत्पत्ति 35:22; 49:3-4।</char></note> जेठ्ठे कै हक के मुताबिक न्ही ठैहरी। <verse eid="1CH 5:1" /><verse number="2" style="v" sid="1CH 5:2" />जै यहूदा अपणे भाईयाँ पै हावी होग्या, अर प्रधान उसके वंश तै होया पर जेठ्ठे का हक यूसुफ का था <verse eid="1CH 5:2" /><verse number="3" style="v" sid="1CH 5:3" />इस्राएल के जेठ्ठे बेट्टे रूबेन के बेट्टे ये होए: यानिके हनोक, पल्‍लू, हेस्रोन अर कर्मी। <verse eid="1CH 5:3" /><verse number="4" style="v" sid="1CH 5:4" />योएल का बेट्टा शमायाह, शमायाह का गोग, गोग का शिमी, <verse eid="1CH 5:4" /><verse number="5" style="v" sid="1CH 5:5" />शिमी का मीका, मीका का रायाह, रायाह का बाल, <verse eid="1CH 5:5" /><verse number="6" style="v" sid="1CH 5:6" />अर बाल का बेट्टा बएराह, इसनै अश्शूर का राजा तिग्लत्पिलेसेर बन्दी बणाकै लेग्या; अर वो रूबेनियाँ का प्रधान था। <verse eid="1CH 5:6" /><verse number="7" style="v" sid="1CH 5:7" />अर उसके भाईयाँ की पीढी के लिखदे बखत वे अपणे-अपणे कुल कै मुताबिक ये ठैहरे, यानिके खास तो यीएल, फेर जकर्याह, <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" />अर अजाज का बेट्टा बेला जो शेमा का पोत्ता अर योएल का पड़पोत्ता था, वो अरोएर म्ह अर नबो अर बालमोन ताहीं रहवै था। <verse eid="1CH 5:8" /><verse number="9" style="v" sid="1CH 5:9" />अर पूर्व की और वो उस बियाबान की हद ताहीं<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="fq" closed="false">उस बियाबान की हद ताहीं </char><char style="ft" closed="false">वो यानिके रूबेन। पूर्व की और रूबेन का गोत्र सीरिया के विशाल रेगिस्तान ताहीं उसपै हक करे होए था जो फरात नदी तै उनकी हद ताहीं का था।</char></note> रहया जो फरात महानद ताहीं पोहच्या सै, क्यूँके उनके पशु गिलाद देश म्ह बढ़ गए थे। <verse eid="1CH 5:9" /><verse number="10" style="v" sid="1CH 5:10" />अर शाऊल के दिनां म्ह उननै हग्रियाँ तै युद्ध करया, अर हग्री उनकै हाथ तै मारे गए; फेर वे गिलाद के सारे पूर्वी भाग म्ह अपणे डेरयां म्ह रहण लाग्गे।<verse eid="1CH 5:10" /></para>
  <para style="s">गाद के वंशज</para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 5:11" />गादी उनके स्याम्ही सल्का ताहीं बाशान देश म्ह रहवैं थे। <verse eid="1CH 5:11" /><verse number="12" style="v" sid="1CH 5:12" />यानिके खास तो योएल अर दूसरा शापाम फेर यानै अर शापात, ये बाशान म्ह रहवैं थे। <verse eid="1CH 5:12" /><verse number="13" style="v" sid="1CH 5:13" />अर उनके भाई अपणे-अपणे पितरां के घरान्यां कै मुताबिक मीकाएल, मशुल्‍लाम, शेबा, योरै, याकान, जी अर एबेर, सात थे। <verse eid="1CH 5:13" /><verse number="14" style="v" sid="1CH 5:14" />ये अबीहैल के बेट्टे थे, जो हूरी का बेट्टा था, यो योराह का बेट्टा, यो गिलाद का बेट्टा, यो मीकाएल का बेट्टा, यो यशीशै का बेट्टा, यो यहदो का बेट्टा, यो बूज का बेट्टा था। <verse eid="1CH 5:14" /><verse number="15" style="v" sid="1CH 5:15" />इनके पितरां के घरान्यां का खास आदमी अब्दीएल का बेट्टा, अर गूनी का पोत्ता अही था। <verse eid="1CH 5:15" /><verse number="16" style="v" sid="1CH 5:16" />ये लोग बाशान म्ह, गिलाद अर उसके गाम्मां म्ह, अर शारोन की सारी चराईयाँ म्ह उसकी दुसरी और ताहीं रहवै थे। <verse eid="1CH 5:16" /><verse number="17" style="v" sid="1CH 5:17" />इन सारया की पीढी यहूदा के राजा योताम के दिनां अर इस्राएल के राजा यारोबाम के दिनां म्ह लिक्खी गई। <verse eid="1CH 5:17" /><verse number="18" style="v" sid="1CH 5:18" />रूबेनियाँ, गादियाँ अर मनश्शे के आध्धे गोत्र के योद्धा जो ढाल बाँधण, तलवार चलाण, अर धनुष के तीर छोड़ण कै लायक अर युद्ध करणा सीखे होए थे, वे चौवाळीस हजार सात सौ साठ थे, जो युद्ध म्ह जाणकै लायक थे। <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />इननै हग्रियाँ अर यतूर नापीश अर नोदाब तै युद्ध करया था। <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />उनकै खिलाफ इन ताहीं मदद मिली, अर हग्री उन सारया समेत जो उनकै गैल थे उनके हाथ म्ह कर दिए गए, क्यूँके युद्ध म्ह इननै परमेसवर की दुहाई दी थी अर उसनै उनकी बिनती इस कारण सुणी, के इननै उसपै भरोस्सा राख्या था। <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />अर इननै उनके पशु खोस लिए, यानिके ऊँट तो पचास हजार, भेड़-बकरी ढाई लाख, गधे दो हजार, अर माणस एक लाख कैदी करकै लेगे। <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />अर घणखरे मरे पड़े थे क्यूँके वो लड़ाई परमेसवर की और तै होई। अर ये उनके जगहां म्ह गुलाम्मी कै बखत ताहीं बसे रहे।<verse eid="1CH 5:22" /></para>
  <para style="s">मनश्शे के वंशज (पूर्व म्ह रहणआळे)</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />फेर मनश्शे के आध्धे गोत्र की सन्तान उस देश म्ह बसगी, अर वे बाशान तै ले बालहेर्मोन, अर सनीर अर हेर्मोन पर्वत ताहीं फैल गए। <verse eid="1CH 5:23" /><verse number="24" style="v" sid="1CH 5:24" />अर उनके पितरां के घरान्यां के खास आदमी ये थे, यानिके एपेर, यिशी, एलीएल, अज्रीएल, यिर्मयाह, होदव्याह अर यहदीएल, ये बड़े वीर अर नाम्मी अर अपणे पितरां के घरान्यां के खास आदमी थे। <verse eid="1CH 5:24" /><verse number="25" style="v" sid="1CH 5:25" />पर उननै अपणे पितरां के परमेसवर तै बिश्वासघात करया, अर उस देश के माणस जिननै परमेसवर ताहीं उनकै स्याम्ही तै विनाश करया था, उनके देवत्यां कै पाच्छै व्यभिचारिणी की तरियां हो लिए। <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />ज्यांतै इस्राएल के परमेसवर नै अश्शूर के राजा पूल अर अश्शूर के राजा तिग्लत्पिलेसेर का मन उभारया, अर इननै उन ताहीं यानिके रूबेनियाँ, गादियाँ अर मनश्शे के आध्धे गोत्र के माणसां ताहीं कैदी करकै हलह, हाबोर<note caller="+" style="f"><char style="fr" closed="false">5:26 </char><char style="fq" closed="false">हाबोर </char><char style="ft" closed="false">एक नगर या रेगिस्तान प्रतीत होवै सै। ना के नदी सै।</char></note> अर हारा शहर अर गोजान नदी के धोरै पोंहचा दिया; अर वे आज कै दिन तक ओड़ैए रहवैं सैं।<verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s">लेवी की वंशावली</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 6:1" />लेवी के बेट्टे गेर्शोन, कहात अर मरारी। <verse eid="1CH 6:1" /><verse number="2" style="v" sid="1CH 6:2" />अर कहात के बेट्टे, अम्राम, यिसहार, हेब्रोन अर उज्जीएल। <verse eid="1CH 6:2" /><verse number="3" style="v" sid="1CH 6:3" />अर अम्राम की सन्तान हारुन, मूसा अर मरियम, अर हारुन के बेट्टे, नादाब, अबीहू, एलीआजर अर ईतामार। <verse eid="1CH 6:3" /><verse number="4" style="v" sid="1CH 6:4" />एलीआजर तै पीनहास, पीनहास तै अबीशू, <verse eid="1CH 6:4" /><verse number="5" style="v" sid="1CH 6:5" />अबीशू तै बुक्‍की, बुक्‍की तै उज्जी, <verse eid="1CH 6:5" /><verse number="6" style="v" sid="1CH 6:6" />उज्जी तै जरहयाह, जरहयाह तै मरायोत, <verse eid="1CH 6:6" /><verse number="7" style="v" sid="1CH 6:7" />मरायोत तै अमर्याह, अमर्याह तै अहीतूब, <verse eid="1CH 6:7" /><verse number="8" style="v" sid="1CH 6:8" />अहीतूब तै सादोक, सादोक तै अहीमास, <verse eid="1CH 6:8" /><verse number="9" style="v" sid="1CH 6:9" />अहीमास तै अजर्याह, अजर्याह तै योहानान, <verse eid="1CH 6:9" /><verse number="10" style="v" sid="1CH 6:10" />अर योहानान तै अजर्याह पैदा होया (जो सुलैमान कै यरुशलेम म्ह बणाए होए भवन म्ह याजक का काम करै था)। <verse eid="1CH 6:10" /><verse number="11" style="v" sid="1CH 6:11" />अजर्याह तै अमर्याह, अमर्याह तै अहीतूब, <verse eid="1CH 6:11" /><verse number="12" style="v" sid="1CH 6:12" />अहीतूब तै सादोक, सादोक तै शल्‍लूम, <verse eid="1CH 6:12" /><verse number="13" style="v" sid="1CH 6:13" />शल्‍लूम तै हिल्किय्याह, हिल्किय्याह तै अजर्याह, <verse eid="1CH 6:13" /><verse number="14" style="v" sid="1CH 6:14" />अजर्याह तै सरायाह, अर सरायाह तै यहोसादाक पैदा होया। <verse eid="1CH 6:14" /><verse number="15" style="v" sid="1CH 6:15" />अर जिब यहोवा, यहूदा अर यरुशलेम ताहीं नबूकदनेस्सर के जरिये बन्दी बणाकै लेग्या, फेर यहोसादाक<note caller="+" style="f"><char style="fr" closed="false">6:15 </char><char style="fq" closed="false">यहोसादाक </char><char style="ft" closed="false">इस नाम का मतलब सै यहोवा धर्मी सै।</char></note> भी कैदी होकै गया। <verse eid="1CH 6:15" /><verse number="16" style="v" sid="1CH 6:16" />लेवी के बेट्टे गेर्शोम, कहात अर मरारी। <verse eid="1CH 6:16" /><verse number="17" style="v" sid="1CH 6:17" />अर गेर्शोम के बेट्यां के नाम ये थे, यानिके लिब्नी अर शिमी। <verse eid="1CH 6:17" /><verse number="18" style="v" sid="1CH 6:18" />अर कहात के बेट्टे अम्राम, यिसहार, हेब्रोन अर उज्जीएल। <verse eid="1CH 6:18" /><verse number="19" style="v" sid="1CH 6:19" />अर मरारी के बेट्टे महली अर मूशी अर अपणे-अपणे पितरां के घरान्यां कै मुताबिक लेवियाँ के कुल ये होए। <verse eid="1CH 6:19" /><verse number="20" style="v" sid="1CH 6:20" />यानिके, गेर्शोम का बेट्टा लिब्नी होया, लिब्नी का यहत, यहत का जिम्मा। <verse eid="1CH 6:20" /><verse number="21" style="v" sid="1CH 6:21" />जिम्मा का योआह, योआह का इद्दो, इद्दो का जेरह, अर जेरह का बेट्टा यातरै होया। <verse eid="1CH 6:21" /><verse number="22" style="v" sid="1CH 6:22" />फेर कहात का बेट्टा अम्मीनादाब होया, अम्मीनादाब का कोरह, कोरह का अस्सीर, <verse eid="1CH 6:22" /><verse number="23" style="v" sid="1CH 6:23" />अस्सीर का एलकाना, एलकाना का एब्यासाप, एब्यासाप का अस्सीर, <verse eid="1CH 6:23" /><verse number="24" style="v" sid="1CH 6:24" />अस्सीर का तहत, तहत का ऊरीएल, ऊरीएल का उज्जियाह अर उज्जियाह का बेट्टा शाऊल होया। <verse eid="1CH 6:24" /><verse number="25" style="v" sid="1CH 6:25" />फेर एल्काना के बेट्टे अमासै अर अहीमोत। <verse eid="1CH 6:25" /><verse number="26" style="v" sid="1CH 6:26" />एल्काना का बेट्टा सोपै, सोपै का नहत, <verse eid="1CH 6:26" /><verse number="27" style="v" sid="1CH 6:27" />नहत का एलीआब, एलीआब का यरोहाम, अर यरोहाम का बेट्टा एल्काना होया। <verse eid="1CH 6:27" /><verse number="28" style="v" sid="1CH 6:28" />शमूएल के बेट्टे: उसका जेठ्ठा योएल अर दूसरा अबिय्याह होया। <verse eid="1CH 6:28" /><verse number="29" style="v" sid="1CH 6:29" />फेर मरारी का बेट्टा महली, महली का लिब्नी, लिब्नी का शिमी, शिमी का उज्जा। <verse eid="1CH 6:29" /><verse number="30" style="v" sid="1CH 6:30" />उज्जा का शिमा; शिमा का हग्गिय्याह अर हग्गिय्याह का बेट्टा असायाह होया।<verse eid="1CH 6:30" /></para>
  <para style="s">परमेसवर के भवन के संगीतकार</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />फेर जिन ताहीं दाऊद नै सन्दूक कै भवन म्ह धरे जाणकै बाद, यहोवा के भवन म्ह गाण का अधिकारी ठहरा दिया वे ये सै। <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />जिब ताहीं सुलैमान यरुशलेम म्ह यहोवा के भवन नै बणवा न्ही लिया, जिब ताहीं वे मिलापआळे तम्बू के निवास के स्याम्ही गाण के जरिये सेवा करैं थे<note caller="+" style="f"><char style="fr" closed="false">6:32 </char><char style="fq" closed="false">सेवा करैं थे </char><char style="ft" closed="false">आराधनालय म्ह संगीत की सेवा के शरुआत एवं लगातार।</char></note>; अर इस सेवा म्ह नियम के मुताबिक मौजूद होया करैं थे। <verse eid="1CH 6:32" /><verse number="33" style="v" sid="1CH 6:33" />जो अपणे-अपणे बेट्यां समेत मौजूद होया करैं थे वे ये सै, यानिके कहातियाँ म्ह तै हेमान गवैया जो योएल का बेट्टा था, अर योएल शमूएल का, <verse eid="1CH 6:33" /><verse number="34" style="v" sid="1CH 6:34" />शमूएल एल्काना का, एल्काना यरोहाम का, यरोहाम एलीएल का, एलीएल तोह का, <verse eid="1CH 6:34" /><verse number="35" style="v" sid="1CH 6:35" />तोह सूफ का, सूफ एल्काना का, एल्काना महत का, महत अमासै का, <verse eid="1CH 6:35" /><verse number="36" style="v" sid="1CH 6:36" />अमासै एल्काना का, एल्काना योएल का, योएल अजर्याह का, अजर्याह सपन्याह का, <verse eid="1CH 6:36" /><verse number="37" style="v" sid="1CH 6:37" />सपन्याह तहत का, तहत अस्सीर का, अस्सीर एब्यासाप का, एब्यासाप कोरह का, <verse eid="1CH 6:37" /><verse number="38" style="v" sid="1CH 6:38" />कोरह यिसहार का, यिसहार कहात का, कहात लेवी का अर लेवी इस्राएल का बेट्टा था। <verse eid="1CH 6:38" /><verse number="39" style="v" sid="1CH 6:39" />अर उसका भाई आसाप जो उसके दाहिने खड़या होया करै था वो बेरेक्याह का बेट्टा था, अर बेरेक्याह शिमा का, <verse eid="1CH 6:39" /><verse number="40" style="v" sid="1CH 6:40" />शिमा मीकाएल का, मीकाएल बासेयाह का, बासेयाह मल्किय्याह का, <verse eid="1CH 6:40" /><verse number="41" style="v" sid="1CH 6:41" />मल्किय्याह एत्नी का, एत्नी जेरह का, जेरह अदायाह का, <verse eid="1CH 6:41" /><verse number="42" style="v" sid="1CH 6:42" />अदायाह एतान का, एतान जिम्मा का, जिम्मा शिमी का, <verse eid="1CH 6:42" /><verse number="43" style="v" sid="1CH 6:43" />शिमी यहत का, यहत गेर्शोम का, गेर्शोम लेवी का बेट्टा था। <verse eid="1CH 6:43" /><verse number="44" style="v" sid="1CH 6:44" />अर ओळी ओड़ उनके भाई मरारी खड़े होवैं थे, यानिके एतान जो कीशी का बेट्टा था, अर कीशी अब्दी का, अब्दी मल्‍लूक का, <verse eid="1CH 6:44" /><verse number="45" style="v" sid="1CH 6:45" />मल्‍लूक हशब्याह का, हशब्याह अमस्याह का, अमस्याह हिल्किय्याह का, <verse eid="1CH 6:45" /><verse number="46" style="v" sid="1CH 6:46" />हिल्किय्याह अमसी का, अमसी बानी का, बानी शेमेर का, <verse eid="1CH 6:46" /><verse number="47" style="v" sid="1CH 6:47" />शेमेर महली का, महली मूशी का, मूशी मरारी का, अर मरारी लेवी का बेट्टा था; <verse eid="1CH 6:47" /><verse number="48" style="v" sid="1CH 6:48" />अर इनके भाई जो लेवीय थे वे परमेसवर कै भवन के निवास की सारी तरियां की सेवा कै खात्तर अर्पण करे होए थे।<verse eid="1CH 6:48" /></para>
  <para style="s">हारुन के बेट्टे</para>
  <para style="p">
    <verse number="49" style="v" sid="1CH 6:49" />पर हारुन अर उसके बेट्टे होमबलि की वेदी, अर धूप की वेदी दोनुवां पै बलिदान चढ़ान्दे, अर परमपवित्र स्थान का सारा काम करदे, अर इस्राएलियाँ कै खात्तर प्रायश्चित करैं थे, जिसा के परमेसवर के दास मूसा नै हुकम दिया था। <verse eid="1CH 6:49" /><verse number="50" style="v" sid="1CH 6:50" />अर हारुन के वंश म्ह ये होए: यानिके उसका बेट्टा एलियाजर होया, अर एलीआजर का पीनहास, पीनहास का अबीशू, <verse eid="1CH 6:50" /><verse number="51" style="v" sid="1CH 6:51" />अबीशू का बुक्‍की, बुक्‍की का उज्जी, उज्जी का जरहयाह, <verse eid="1CH 6:51" /><verse number="52" style="v" sid="1CH 6:52" />जरहयाह का मरायोत, मरायोत का अमर्याह, अमर्याह का अहीतूब, <verse eid="1CH 6:52" /><verse number="53" style="v" sid="1CH 6:53" />अहीतूब का सादोक अर सादोक का अहीमास बेट्टा होया।<verse eid="1CH 6:53" /></para>
  <para style="s">लेवियाँ के ठहराए होए निवास स्थान</para>
  <para style="p">
    <verse number="54" style="v" sid="1CH 6:54" />उनके हिस्यां म्ह उनकी छावनियाँ कै मुताबिक उनकी बस्तियाँ ये सैं यानिके कहात के कुलां म्ह तै पैहली चिट्ठी जो हारुन की सन्तान कै नाम पै लिकड़ी; <verse eid="1CH 6:54" /><verse number="55" style="v" sid="1CH 6:55" />यानिके च्यांरु और की चराईयाँ समेत यहूदा देश का हेब्रोन उननै मिल्या। <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" />पर उस नगर के खेत अर गाम यपुन्‍ने के बेट्टे कालेब तै दिए गए। <verse eid="1CH 6:56" /><verse number="57" style="v" sid="1CH 6:57" />अर हारुन की सन्तान तै शरणनगर हेब्रोन, अर चराईयाँ समेत लिब्ना, अर यत्तीर नगर अर अपणी-अपणी चराईयाँ समेत एश्तमो; <verse eid="1CH 6:57" /><verse number="58" style="v" sid="1CH 6:58" />अपणी-अपणी चराईयाँ समेत हीलेन अर दबीर; <verse eid="1CH 6:58" /><verse number="59" style="v" sid="1CH 6:59" />आशान अर बेतशेमेश। <verse eid="1CH 6:59" /><verse number="60" style="v" sid="1CH 6:60" />अर बिन्‍यामीन के गोत्र म्ह तै अपणी-अपणी चराईयाँ समेत गेबा, आलेमेत अर अनातोत दिए गए। उनके घरान्यां के सारे नगर तेरह थे।<verse eid="1CH 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="1CH 6:61" />अर बचे होए कहातियाँ के गोत्र के कुल, यानिके मनश्शे के आध्धे गोत्र म्ह तै चिट्ठी डालकै दस नगर दिए गए। <verse eid="1CH 6:61" /><verse number="62" style="v" sid="1CH 6:62" />अर गेर्शोमियाँ के कुलां कै मुताबिक उननै इस्साकार, आशेर अर नप्ताली के गोत्र, अर बाशान म्ह रहणआळे मनश्शे के गोत्र म्ह तै तेरह नगर मिले। <verse eid="1CH 6:62" /><verse number="63" style="v" sid="1CH 6:63" />मरारियाँ के कुलां कै मुताबिक उननै रूबेन, गाद अर जबूलून के गोत्रां म्ह तै चिट्ठी डालकै बारहा नगर दिए गए। <verse eid="1CH 6:63" /><verse number="64" style="v" sid="1CH 6:64" />इस्राएलियाँ नै लेवियाँ ताहीं ये नगर चराईयाँ समेत दिए। <verse eid="1CH 6:64" /><verse number="65" style="v" sid="1CH 6:65" />उन ताहीं यहूदियाँ, शिमोनियां अर बिन्‍यामीनियाँ के गोत्रां म्ह तै वे नगर दिए, जिनके नाम उप्पर दिए गए सैं।<verse eid="1CH 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="1CH 6:66" />अर कहातियाँ के कई कुलां ताहीं उनके भाग के नगर एप्रैम के गोत्र म्ह तै मिले। <verse eid="1CH 6:66" /><verse number="67" style="v" sid="1CH 6:67" />सो उन ताहीं अपणी-अपणी चराईयाँ समेत एप्रैम की पहाड़ी देश का शेकेम जो शरणनगर था, फेर गेजेर, <verse eid="1CH 6:67" /><verse number="68" style="v" sid="1CH 6:68" />योकमाम, बेथोरोन शहर, <verse eid="1CH 6:68" /><verse number="69" style="v" sid="1CH 6:69" />अय्यालोन अर गत्रिम्मोन; <verse eid="1CH 6:69" /><verse number="70" style="v" sid="1CH 6:70" />अर मनश्शे के आध्धे गोत्र म्ह तै अपणी-अपणी चराईयाँ समेत आनेर अर बिलाम बाकी कहातियाँ के कुल ताहीं मिले। <verse eid="1CH 6:70" /><verse number="71" style="v" sid="1CH 6:71" />फेर गेर्शोमियाँ ताहीं मनश्शे के आध्धे गोत्र के कुल म्ह तै तो अपणी-अपणी चराईयाँ समेत बाशान का गोलन अर अश्तारोत; <verse eid="1CH 6:71" /><verse number="72" style="v" sid="1CH 6:72" />अर इस्साकार के गोत्र म्ह तै अपणी-अपणी चराईयाँ समेत केदेश, दाबरात, <verse eid="1CH 6:72" /><verse number="73" style="v" sid="1CH 6:73" />रामोत अर आनेम, <verse eid="1CH 6:73" /><verse number="74" style="v" sid="1CH 6:74" />अर आशेर के गोत्र म्ह तै अपणी-अपणी चराईयाँ समेत माशाल, अब्दोन, <verse eid="1CH 6:74" /><verse number="75" style="v" sid="1CH 6:75" />हूकोक अर रहोब; <verse eid="1CH 6:75" /><verse number="76" style="v" sid="1CH 6:76" />अर नप्ताली के गोत्र म्ह तै अपणी-अपणी चराईयाँ समेत गलील का केदेश हम्मोन अर किर्यातैम मिले। <verse eid="1CH 6:76" /><verse number="77" style="v" sid="1CH 6:77" />फेर बचे होए लेवियाँ यानिके मरारियाँ ताहीं जबूलून के गोत्र म्ह तै तो अपणी-अपणी चराईयाँ समेत रिम्मोन अर ताबोर। <verse eid="1CH 6:77" /><verse number="78" style="v" sid="1CH 6:78" />अर यरीहो कै धोरै की यरदन नदी के पूर्व और रूबेन के गोत्र म्ह तै तो अपणी-अपणी चराईयाँ समेत जंगळ का बेसेर, यहस, <verse eid="1CH 6:78" /><verse number="79" style="v" sid="1CH 6:79" />कदेमोत अर मेपात; <verse eid="1CH 6:79" /><verse number="80" style="v" sid="1CH 6:80" />अर गाद के गोत्र म्ह तै अपणी-अपणी चराईयाँ समेत गिलाद का रामोत महनैम, <verse eid="1CH 6:80" /><verse number="81" style="v" sid="1CH 6:81" />हेशबोन अर याजेर दिए गए।<verse eid="1CH 6:81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="s">इस्साकार की वंशावली</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 7:1" />इस्साकार के बेट्टे: तोला, पूआ, याशूब अर शिम्रोन, च्यार थे। <verse eid="1CH 7:1" /><verse number="2" style="v" sid="1CH 7:2" />अर तोला के बेट्टे: उज्जी, रपायाह, यरीएल, यहमै, यिबसाम अर शमूएल, ये अपणे-अपणे पितरां के घरान्यां यानिके तोला की सन्तान के खास आदमी अर बड़े वीर थे, अर दाऊद के दिनां म्ह उनके वंश की गिणती बाईस हजार छः सौ थी। <verse eid="1CH 7:2" /><verse number="3" style="v" sid="1CH 7:3" />अर उज्जी का बेट्टा: यिज्रह्याह, अर यिज्रह्याह के बेट्टे मीकाएल, ओबद्याह, योएल अर यिश्शिय्याह पाँच थे; ये सारे खास आदमी थे; <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />अर उनकै गैल उनकी वंशावलियाँ अर पितरां के घरान्यां के मुताबिक सेना के दलां के छत्तीस हजार योद्धा थे; क्यूँके उनकी भोत सी जनानियाँ अर बेट्टे थे। <verse eid="1CH 7:4" /><verse number="5" style="v" sid="1CH 7:5" />अर उनके भाई जो इस्साकार के सारे कुलां म्ह तै थे, वे सत्तासी हजार बड़े वीर थे, जो अपणी-अपणी वंशावली कै मुताबिक गिणे गए।<verse eid="1CH 7:5" /></para>
  <para style="s">बिन्‍यामीन अर नप्ताली की वंशावली</para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 7:6" />बिन्‍यामीन के बेट्टे: बेला, बेकेर अर यदीएल ये तीन थे। <verse eid="1CH 7:6" /><verse number="7" style="v" sid="1CH 7:7" />बेला के बेट्टे: एसबोन, उज्जी, उज्जीएल, यरीमोत अर ईरी ये पाँच थे। ये अपणे-अपणे पितरां के घरान्यां के खास आदमी अर बड़े वीर थे, अर अपणी-अपणी वंशावली कै मुताबिक उनकी गिणती बाईस हजार चौंतीस थी। <verse eid="1CH 7:7" /><verse number="8" style="v" sid="1CH 7:8" />अर बेकेर के बेट्टे: जमीरा, योआश, एलीएजेर, एल्योएनै, ओम्री, यरेमोत, अबिय्याह, अनातोत अर आलेमेत ये सारे बेकेर के बेट्टे थे। <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />ये जो अपणे-अपणे पितरां के घरान्यां के खास आदमी अर बड़े वीर थे, इनके वंश की गिणती अपणी-अपणी वंशावली कै मुताबिक बीस हजार दो सौ थी। <verse eid="1CH 7:9" /><verse number="10" style="v" sid="1CH 7:10" />अर यदीएल का बेट्टा बिल्हान, अर बिल्हान के बेट्टे, यूश, बिन्‍यामीन, एहूद, कनाना, जेतान, तर्शीश अर अहीशहर थे। <verse eid="1CH 7:10" /><verse number="11" style="v" sid="1CH 7:11" />ये सारे जो यदीएल की सन्तान अर अपणे-अपणे पितरां के घरान्यां म्ह खास आदमी अर बड़े वीर थे, इनका वंश तै सेना म्ह युद्ध करण के लायक सत्रह हजार दो सौ माणस थे। <verse eid="1CH 7:11" /><verse number="12" style="v" sid="1CH 7:12" />अर ईर के बेट्टे शुप्पीम अर हुप्पीम अर शिकार के बेट्टे हूशीम थे। <verse eid="1CH 7:12" /><verse number="13" style="v" sid="1CH 7:13" />नप्ताली के बेट्टे, यहसीएल, गूनी, येसेर अर शल्‍लूम थे, ये बिल्हा के पोत्ते थे।<verse eid="1CH 7:13" /></para>
  <para style="s">मनश्शे के वंशज (पश्चिम म्ह बसे)</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 7:14" />मनश्शे के बेट्टे: अस्रीएल जो उसकी अरामी रखैल जनान्‍नी तै पैदा होया था; अर उस अरामी जनान्‍नी नै गिलाद के पिता माकीर तै भी जन्म दिया। <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" />अर माकीर (जिसकी भाण का नाम माका था) उसनै हुप्पीम अर शुप्पीम कै खात्तर जनान्‍नी ब्याह ली, अर दुसरे का नाम सलोफाद था, अर सलोफाद के बेटियाँ होई। <verse eid="1CH 7:15" /><verse number="16" style="v" sid="1CH 7:16" />फेर माकीर की जनान्‍नी माका कै एक बेट्टा पैदा होया अर उसका नाम पेरेश धरया; अर उसके भाई का नाम शेरेश था; अर इसके बेट्टे ऊलाम अर राकेम थे। <verse eid="1CH 7:16" /><verse number="17" style="v" sid="1CH 7:17" />अर ऊलाम का बेट्टा: बदान। ये गिलाद की सन्तान थे जो माकीर का बेट्टा अर मनश्शे का पोत्ता था। <verse eid="1CH 7:17" /><verse number="18" style="v" sid="1CH 7:18" />फेर उसकी भाण हम्मोलेकेत नै ईशहोद, अबीएजेर<note caller="+" style="f"><char style="fr" closed="false">7:18 </char><char style="fq" closed="false">अबीएजेर </char><char style="ft" closed="false">उसके वंशज मनश्शे की अति महत्त्वपूर्ण डाली होए। उन्हे म्ह तै गिदोन जिसा महानतम् न्यायी होया।</char></note> अर महला तै जन्म दिया। <verse eid="1CH 7:18" /><verse number="19" style="v" sid="1CH 7:19" />शमीदा के बेट्टे अह्यान, शेकेम, लिखी अर अनीआम थे।<verse eid="1CH 7:19" /></para>
  <para style="s">एप्रैम के वंशज</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 7:20" />एप्रैम के बेट्टे शूतेलह अर शूतेलह का बेरेद, बेरेद का तहत, तहत का एलादा, एलादा का तहत; <verse eid="1CH 7:20" /><verse number="21" style="v" sid="1CH 7:21" />तहत का जाबाद अर जाबाद का बेट्टा शूतेलह होया, अर एजेर अर एलाद भी जिननै गत के माणसां तै जो उस देश म्ह पैदा होए थे ज्यांतै घात करया, के वे उनके पशु चुराण नै उतर आए थे। <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />सो उनका पिता एप्रैम उनकै खात्तर घणे दिन शोक करदा रहया, अर उसके भाई उसनै शान्ति देण ताहीं आए। <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />अर वो अपणी घरआळी कै धोरै गया, अर उसनै गर्भवती होकै एक बेट्टे तै जन्म दिया अर एप्रैम नै उसका नाम इस कारण बरीआ धरया, के उसके घरान्‍ने म्ह विपति पड़ी थी। <verse eid="1CH 7:23" /><verse number="24" style="v" sid="1CH 7:24" />उसकी बेट्टी शेरा थी, जिसनै निचले अर उप्पर आळे दोन्‍नु बेथोरोन नाम के नगरां ताहीं अर उज्जेनशेरा ताहीं मजबूत कराया। <verse eid="1CH 7:24" /><verse number="25" style="v" sid="1CH 7:25" />उसका बेट्टा रेपा था, अर रेशेप भी, अर उसका बेट्टा तेलह, तेलह का तहन, तहन का लादान, <verse eid="1CH 7:25" /><verse number="26" style="v" sid="1CH 7:26" />लादान का अम्मीहूद, अम्मीहूद का एलीशामा, <verse eid="1CH 7:26" /><verse number="27" style="v" sid="1CH 7:27" />एलीशामा का नून, अर नून का बेट्टा यहोशू था। <verse eid="1CH 7:27" /><verse number="28" style="v" sid="1CH 7:28" />उनकी अपणी धरती अर बस्ती गाम समेत बेतेल अर पूर्व की और नारान अर पश्चिम की और गाम समेत गेजेर, फेर गाम समेत शेकेम, अर गाम समेत अय्या थी; <verse eid="1CH 7:28" /><verse number="29" style="v" sid="1CH 7:29" />अर मनश्शेइयां की हद कै धोरै अपणे-अपणे गामां समेत बेतशान, तानाक, मगिद्दो अर दोर। इन म्ह इस्राएल के बेट्टे यूसुफ की सन्तान के माणस रहवैं थे।<verse eid="1CH 7:29" /></para>
  <para style="s">आशेर के वंशज</para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 7:30" />आशेर के बेट्टे: यिम्ना, यिश्वा, यिश्वी अर बरीआ, अर उनकी भाण सेरह होई। <verse eid="1CH 7:30" /><verse number="31" style="v" sid="1CH 7:31" />अर बरीआ के बेट्टे: हेबेर अर मल्कीएल अर यो बिर्जोत का पिता होया। <verse eid="1CH 7:31" /><verse number="32" style="v" sid="1CH 7:32" />हेबेर नै यपलेत, शोमेर, होताम अर उनकी भाण शूआ ताहीं जन्म दिया। <verse eid="1CH 7:32" /><verse number="33" style="v" sid="1CH 7:33" />अर यपलेत के बेट्टे पासक बिम्हाल अर अश्‍वात। यपलेत के येए बेट्टे थे। <verse eid="1CH 7:33" /><verse number="34" style="v" sid="1CH 7:34" />शेमेर के बेट्टे: अही, रोहगा, यहुब्बा अर अराम। <verse eid="1CH 7:34" /><verse number="35" style="v" sid="1CH 7:35" />उसके भाई हेलेम के बेट्टे सोपह, यिम्ना, शेलेश अर आमाल। <verse eid="1CH 7:35" /><verse number="36" style="v" sid="1CH 7:36" />सोपह के बेट्टे, सूह, हर्नेपेर, शूआल, बेरी, इम्रा। <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" />बेसेर, होद, शम्मा, शिलसा, यित्रान अर बेरा। <verse eid="1CH 7:37" /><verse number="38" style="v" sid="1CH 7:38" />येतेर के बेट्टे: यपुन्‍ने, पिस्पा अर अरा। <verse eid="1CH 7:38" /><verse number="39" style="v" sid="1CH 7:39" />उल्‍ला के बेट्टे: आरह, हन्‍नीएल अर रिस्या। <verse eid="1CH 7:39" /><verse number="40" style="v" sid="1CH 7:40" />ये सारे आशेर के वंश म्ह होए, अर अपणे-अपणे पितरां के घरान्यां म्ह खास आदमी अर बड़े तै बड़े वीर थे अर प्रधानां म्ह खास थे। ये जो अपणी-अपणी वंशावली कै मुताबिक सेना म्ह युद्ध करण कै खात्तर गिणे गए, इनकी गिणती छब्बीस हजार थी।<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s">बिन्‍यामीन की वंशावली</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 8:1" />बिन्‍यामीन तै उसका जेठ्ठा बेला, दूसरा अश्बेल, तीसरा अहृह, <verse eid="1CH 8:1" /><verse number="2" style="v" sid="1CH 8:2" />चौथा नोहा अर पाँचवाँ रापा पैदा होया। <verse eid="1CH 8:2" /><verse number="3" style="v" sid="1CH 8:3" />बेला के बेट्टे अद्दार, गेरा, अबीहूद, <verse eid="1CH 8:3" /><verse number="4" style="v" sid="1CH 8:4" />अबीशू, नामान, अहोह, <verse eid="1CH 8:4" /><verse number="5" style="v" sid="1CH 8:5" />गेरा, शपूपान अर हूराम थे। <verse eid="1CH 8:5" /><verse number="6" style="v" sid="1CH 8:6" />एहूद के बेट्टे ये होए (गेबा के बासिन्दया के पितरां के घरान्यां म्ह खास आदमी ये थे, जिननै बन्दी बणाकै मानहत ताहीं ले जाया गया था)। <verse eid="1CH 8:6" /><verse number="7" style="v" sid="1CH 8:7" />अर नामान, अहिय्याह अर गेरा (इननै भी कैदी बणाकै मानहत ताहीं ले गए थे), अर उसनै उज्जा अर अहीहूद तै जन्म दिया। <verse eid="1CH 8:7" /><verse number="8" style="v" sid="1CH 8:8" />अर शहरैम तै हूशीम अर बारा नाम की अपणी जनानियाँ ताहीं छोड़ देण कै बाद, मोआब देश म्ह छोरे पैदा होए। <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />उसकी अपणी जनान्‍नी होदेश तै योबाब, सिब्या, मेशा, मल्काम, यूस, सोक्या, <verse eid="1CH 8:9" /><verse number="10" style="v" sid="1CH 8:10" />अर मिर्मा पैदा होए। उसके ये बेट्टे अपणे-अपणे पितरां के घरान्यां म्ह खास आदमी थे। <verse eid="1CH 8:10" /><verse number="11" style="v" sid="1CH 8:11" />अर हूशीम तै अबीतूब अर एल्पाल का जन्म होया। <verse eid="1CH 8:11" /><verse number="12" style="v" sid="1CH 8:12" />एल्पाल के बेट्टे एबेर, मिशाम अर शामेद, इसे नै ओनो अर गाम समेत लोद ताहीं बसाया। <verse eid="1CH 8:12" /><verse number="13" style="v" sid="1CH 8:13" />फेर बरीआ अर शेमा जो अय्यालोन के बासिन्दया के पितरां कै घरान्यां म्ह खास आदमी थे, अर जिन ताहीं गत के बासिन्दया ताहीं भजा दिया, <verse eid="1CH 8:13" /><verse number="14" style="v" sid="1CH 8:14" />अर अह्यो, शाशक, यरेमोत, <verse eid="1CH 8:14" /><verse number="15" style="v" sid="1CH 8:15" />जबद्याह, अराद, एदेर, <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" />मीकाएल, यिस्पा, योहा, जो बरीआ के बेट्टे थे, <verse eid="1CH 8:16" /><verse number="17" style="v" sid="1CH 8:17" />जबद्याह, मशुल्‍लाम, हिजकी, हेबेर, <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" />यिशमरै, यिजलीआ, योबाब जो एल्पाल के बेट्टे थे। <verse eid="1CH 8:18" /><verse number="19" style="v" sid="1CH 8:19" />अर याकीम, जिक्री, जब्दी, <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" />एलीएनै, सिल्‍लतै, एलीएल, <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" />अदायाह, बरायाह अर शिम्रात जो शिमी के बेट्टे थे। <verse eid="1CH 8:21" /><verse number="22" style="v" sid="1CH 8:22" />यिशपान, एबेर, एलीएल, <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" />अब्दोन, जिक्री, हानान, <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" />हनन्याह, एलाम, अन्तोतिय्याह, <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" />यिपदयाह अर पनूएल जो शाशक के बेट्टे थे। <verse eid="1CH 8:25" /><verse number="26" style="v" sid="1CH 8:26" />अर शमशरै, शहर्याह, अतल्याह, <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" />योरेश्याह, एलिय्याह अर जिक्री जो यरोहाम के बेट्टे थे। <verse eid="1CH 8:27" /><verse number="28" style="v" sid="1CH 8:28" />ये अपणी-अपणी पीढ़ी म्ह अपणे-अपणे पितरां के घरान्यां म्ह खास आदमी अर प्रधान थे, ये यरुशलेम म्ह रहवै थे। <verse eid="1CH 8:28" /><verse number="29" style="v" sid="1CH 8:29" />गिबोन म्ह गिबोन का पिता रहवैं था, जिसकी घरआळी का नाम माका था। <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />अर उसका जेठ्ठा बेट्टा अब्दोन था, फेर सूर, कीश, बाल, नादाब, <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" />गदोर; अह्यो अर जेकेर होए। <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" />मिक्लोत तै शिमआह पैदा होया। अर ये भी अपणे भाईयाँ कै स्याम्ही यरुशलेम म्ह रहवैं थे, अपणे भाईयाँ ए कै गैल। <verse eid="1CH 8:32" /><verse number="33" style="v" sid="1CH 8:33" />नेर तै कीश पैदा होया, कीश तै शाऊल, अर शाऊल तै योनातान, मल्कीशूअ, अबीनादाब, अर एशबाल पैदा होया; <verse eid="1CH 8:33" /><verse number="34" style="v" sid="1CH 8:34" />अर योनातान का बेट्टा मरीब्बाल होया, अर मरीब्बाल तै मीका पैदा होया। <verse eid="1CH 8:34" /><verse number="35" style="v" sid="1CH 8:35" />मीका के बेट्टे: पीतोन, मेलेक, तारे अर आहाज। <verse eid="1CH 8:35" /><verse number="36" style="v" sid="1CH 8:36" />आहाज तै यहोअद्दा पैदा होया, अर यहोअद्दा तै आलेमेत, अज्मावेत अर जिम्री; अर जिम्री तै मोसा। <verse eid="1CH 8:36" /><verse number="37" style="v" sid="1CH 8:37" />मिस्पे तै बिना पैदा होया, अर इसका बेट्टा रापा होया, रापा का एलासा अर एलासा का बेट्टा आसेल होया। <verse eid="1CH 8:37" /><verse number="38" style="v" sid="1CH 8:38" />अर आसेल के छः बेट्टे होए जिनके ये नाम थे, यानिके अज्रीकाम, बोकरू, इश्माएल, शरायाह, ओबद्याह, अर हानान। ये सारे आसेल के बेट्टे थे। <verse eid="1CH 8:38" /><verse number="39" style="v" sid="1CH 8:39" />उसके भाई एसेक के ये बेट्टे होए, यानिके उसका जेठ्ठा ऊलाम, दूसरा यूश, तीसरा एलीपेलेत। <verse eid="1CH 8:39" /><verse number="40" style="v" sid="1CH 8:40" />ऊलाम के बेट्टे शूरवीर अर धनुर्धारी होए, अर उनके घणे बेट्टे-पोत्ते यानिके डेढ़ सौ होए।<note caller="+" style="f"><char style="fr" closed="false">8:40 </char><char style="fq" closed="false">घणे बेट्टे-पोत्ते यानिके डेढ़ सौ होए। </char><char style="ft" closed="false">शाऊल के घरान्‍ने की यो पीढी पीढ़ियाँ की गिणती कै मुताबिक सै जो लगभग: हिजकिय्याह के बखत की सै।</char></note> येए सारे बिन्‍यामीन के वंश के थे।<verse eid="1CH 8:40" /></para>
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="s">यरुशलेम म्ह रहण आळयां का इन्तजाम</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />इस तरियां सारे इस्राएली अपणी-अपणी वंशावली कै मुताबिक, जो इस्राएल के राजयां के वृत्तान्त की किताब म्ह लिक्खे सैं, गिणे गए। अर यहूदी अपणे बिश्वासघात कै कारण बन्दी बणाकै बाबेल नै पोहचाये गए। <verse eid="1CH 9:1" /><verse number="2" style="v" sid="1CH 9:2" />गुलामी तै बोहड़कै जो माणस अपणी-अपणी खुद की धरती यानिके अपणे नगरां म्ह रहवैं थे<note caller="+" style="f"><char style="fr" closed="false">9:2 </char><char style="fq" closed="false">अपणी-अपणी खुद की धरती यानिके अपणे नगरां म्ह रहवैं थे </char><char style="ft" closed="false">बन्धुआई तै बोहड़ण आळे पवित्र देश के पैहले निवासी ये चार कुणब्यां म्ह गिणे गए इस्राएली, पुरोहित, लेवी अर आराधनालय के सेवक।</char></note>, वो इस्राएली, याजक, लेवीय अर आराधनालय के सेवक थे। <verse eid="1CH 9:2" /><verse number="3" style="v" sid="1CH 9:3" />यरुशलेम म्ह कुछ यहूदी; कुछ बिन्‍यामीन, अर कुछ एप्रैमी, अर मनश्शेई, रहवैं थे <verse eid="1CH 9:3" /><verse number="4" style="v" sid="1CH 9:4" />यानिके यहूदा के बेट्टे पेरेस के वंश म्ह तै अम्मीहूद का बेट्टा ऊतै, जो ओम्री का बेट्टा, अर इम्री का पोत्ता, अर बानी का पड़पोत्ता था। <verse eid="1CH 9:4" /><verse number="5" style="v" sid="1CH 9:5" />अर शीलोईयां म्ह तै उसका जेठ्ठा बेट्टा असायाह अर उसके बेट्टे। <verse eid="1CH 9:5" /><verse number="6" style="v" sid="1CH 9:6" />जेरह के वंश म्ह तै यूएल, अर इनके भाई, ये छः सौ नब्बे होए। <verse eid="1CH 9:6" /><verse number="7" style="v" sid="1CH 9:7" />फेर बिन्‍यामीन के वंश म्ह तै सल्‍लू जो मशुल्‍लाम का बेट्टा, होदव्याह का पोत्ता, अर हस्सनूआ का पड़पोत्ता था। <verse eid="1CH 9:7" /><verse number="8" style="v" sid="1CH 9:8" />अर यिब्रिय्याह जो यरोहाम का बेट्टा था, अर एला जो उज्जी का बेट्टा, अर मिक्री का पोत्ता था, अर मशुल्‍लाम जो शपत्याह का बेट्टा, रूएल का पोत्ता, अर यिब्निय्याह का पड़पोत्ता था; <verse eid="1CH 9:8" /><verse number="9" style="v" sid="1CH 9:9" />अर इनके भाई जो अपणी-अपणी वंशावली कै मुताबिक मिलकै नौ सौ छप्पन। ये सारे माणस अपणे-अपणे पितरां के घरान्यां कै मुताबिक पितरां के घरान्यां म्ह खास थे।<verse eid="1CH 9:9" /></para>
  <para style="s">यरुशलेम के बासिंदे याजक</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 9:10" />याजकां म्ह तै यदायाह, यहोयारीब अर याकीन<note caller="+" style="f"><char style="fr" closed="false">9:10 </char><char style="fq" closed="false">यदायाह, यहोयारीब अर याकीन </char><char style="ft" closed="false">ये नाम माणसां के न्ही पुरोहितीय परिवारां के सैं।</char></note>, <verse eid="1CH 9:10" /><verse number="11" style="v" sid="1CH 9:11" />अर अजर्याह जो परमेसवर के भवन का प्रधान अर हिल्किय्याह का बेट्टा था, यो मशुल्‍लाम का बेट्टा, यो सादोक का बेट्टा, यो मरायोत का बेट्टा, यो अहीतूब का बेट्टा था;<verse eid="1CH 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 9:12" />अर अदायाह जो यरोहाम का बेट्टा था, यो पशहूर का बेट्टा, यो मल्किय्याह का बेट्टा, यो मासै का बेट्टा, यो अदीएल का बेट्टा, यो जेरा का बेट्टा, यो मशुल्‍लाम का बेट्टा, यो मशिल्‍लीत का बेट्टा, यो इम्मेर का बेट्टा था; <verse eid="1CH 9:12" /><verse number="13" style="v" sid="1CH 9:13" />अर इनके भाई थे जो अपणे-अपणे पितरां के घरान्यां म्ह सत्रह सौ साठ खास आदमी थे, वे परमेसवर के भवन की सेवा के काम म्ह घणे होशियार माणस थे। <verse eid="1CH 9:13" /><verse number="14" style="v" sid="1CH 9:14" />फेर लेवियाँ म्ह तै मरारी के वंश म्ह तै शमायाह जो हश्शूब का बेट्टा, अज्रीकाम का पोत्ता, अर हशब्याह का पड़पोत्ता था; <verse eid="1CH 9:14" /><verse number="15" style="v" sid="1CH 9:15" />अर बकबक्‍कर, हेरेश अर गालाल अर आसाप के वंश म्ह तै मत्तन्याह जो मीका का बेट्टा, अर जिक्री का पोत्ता था; <verse eid="1CH 9:15" /><verse number="16" style="v" sid="1CH 9:16" />अर ओबद्याह जो शमायाह का बेट्टा, गालाल का पोत्ता अर यदूतून का पड़पोत्ता था: अर बेरेक्याह जो आसा का बेट्टा, अर एल्काना का पोत्ता था, जो नतोपाइयां के गाम्मां म्ह रहवै था।<verse eid="1CH 9:16" /></para>
  <para style="s">लेवी जो द्वारपाल थे</para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 9:17" />द्वारपालां म्ह तै अपणे-अपणे भाईयाँ समेत शल्‍लूम, अक्‍कूब, तल्मोन अर अहीमन, इन म्ह तै खास तो शल्‍लूम था। <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />अर वो इब ताहीं पूर्व की और राजा के फाटक कै धोरै द्वारपाली करया करै था। लेवियाँ की छावणी के द्वारपाल येए थे। <verse eid="1CH 9:18" /><verse number="19" style="v" sid="1CH 9:19" />अर शल्‍लूम जो कोरे का बेट्टा, एब्यासाप का पोत्ता, अर कोरह का पड़पोत्ता था, अर उसके भाई जो उसके मूलपुरुष के घरान्‍ने के यानिके कोरही थे, वो इस काम के अधिकारी थे के वे तम्बू के द्वारपाल हों। उनके पुरखा तो यहोवा की छावणी के अधिकारी, अर प्रवेश-द्वार के रखवाळे थे। <verse eid="1CH 9:19" /><verse number="20" style="v" sid="1CH 9:20" />पुराणे बखत म्ह एलीआजर का बेट्टा पीनहास, जिसकै गैल यहोवा रहया करै था, वो उनका प्रधान था। <verse eid="1CH 9:20" /><verse number="21" style="v" sid="1CH 9:21" />मशेलेम्याह का बेट्टा जकर्याह मिलापआळे तम्बू का द्वारपाल था। <verse eid="1CH 9:21" /><verse number="22" style="v" sid="1CH 9:22" />ये सारे जो द्वारपाल होण नै चुणे गए, वो दो सौ बारहा थे। ये जिनके पुरखां ताहीं दाऊद अर शमूएल दर्शी नै बिश्वासयोग्य जाणकै ठैहराया था, वो अपणे-अपणे गाम म्ह अपणी-अपणी वंशावली कै मुताबिक गिणे गए। <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />आखर वे अर उनकी सन्तान यहोवा के भवन यानिके तम्बू के भवन के फाटकां का हक बारी-बारी राक्खैं थे। <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />द्वारपाल पूर्व, पश्चिम, उत्तर, दक्षिण, च्यांरु दिशा की और पैहरा देवैं थे। <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />अर उनके भाई जो गाम्मां म्ह रहवैं थे, उन ताहीं सात-सात दिन के बाद बारी-बारी तै उनकै गैल रहण कै खात्तर आणा पड़ै था। <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" />क्यूँके च्यांरु प्रधान द्वारपाल जो लेवीय थे, वे बिश्वासयोग्य जाणकै परमेसवर के भवन की कोठड़ियाँ अर भण्डारां के अधिकारी ठहराए गए थे। <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />वे परमेसवर के भवन कै आस्सै-पास्सै ज्यांतै रात बितावै थे के उसकी हिफाजत उननै सौंपी गई थी, अर हर रोज सबेरै नै उस ताहीं खोलणा उनका काम था।<verse eid="1CH 9:27" /></para>
  <para style="s">लेवियाँ की और जिम्मेदारी</para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28" />उन म्ह तै किमे उपासना के बरतनां के अधिकारी थे, क्यूँके ये बरतन गिणकै भित्तर पोहचावै, अर गिणकै बाहर लिकाड़े भी जावैं थे। <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />अर उन म्ह तै किमे सामान के, अर पवित्र जगहां के बरतनां के, अर मैद्दे, दाखमधु, तेल, लोबान अर सुगन्ध-द्रव्यां के अधिकारी ठहराए गए थे। <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" />याजकां के बेट्टयाँ म्ह तै किमे सुगन्ध-द्रव्यां के मिश्रण त्यार करण का काम करैं थे। <verse eid="1CH 9:30" /><verse number="31" style="v" sid="1CH 9:31" />अर मत्तित्याह नाम का एक लेवीय जो कोरही शल्‍लूम का जेठ्ठा था उसे बिश्वासयोग्य जाणकै तव्यां पै बणाई होई चिज्जां का अधिकारी नियुक्त करया था। <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" />उसके भाईयाँ यानिके कहातियाँ म्ह तै किमे तो भेंट आळी रोट्टी के अधिकारी थे, के हर एक विश्रामदिन नै उस ताहीं त्यार करया करैं।<verse eid="1CH 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33" />ये गवैये थे जो लेवीय पितरां के घरान्यां म्ह खास थे, अर आराधनालय म्ह रहवै, अर और सेवा के काम तै छूटे थे; क्यूँके वे रात-दिन अपणे काम म्ह लाग्गे रहवैं थे। <verse eid="1CH 9:33" /><verse number="34" style="v" sid="1CH 9:34" />येए अपणी-अपणी पीढ़ी म्ह लेवियाँ के पितरां के घरान्यां म्ह खास आदमी थे, ये यरुशलेम म्ह रहवैं थे।<verse eid="1CH 9:34" /></para>
  <para style="s">शाऊल राजा की वंशावली</para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 9:35" />गिबोन म्ह गिबोन का पिता यीएल रहया करै था, जिसकी घरआळी का नाम माका था। <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />उसका जेठ्ठा बेट्टा अब्दोन होया, फेर सूर, कीश, बाल, नेर, नादाब, <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" />गदोर, अह्यो, जकर्याह अर मिक्लोत; <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" />अर मिक्लोत तै शिमाम पैदा होया अर ये भी अपणे भाईयाँ कै स्याम्ही अपणे भाईयाँ कै गैल यरुशलेम म्ह रहवैं थे। <verse eid="1CH 9:38" /><verse number="39" style="v" sid="1CH 9:39" />नेर तै कीश, कीश तै शाऊल, अर शाऊल तै योनातान, मल्कीशूअ, अबीनादाब अर एशबाल पैदा होए। <verse eid="1CH 9:39" /><verse number="40" style="v" sid="1CH 9:40" />अर योनातान का बेट्टा मरीब्बाल होया, अर मरीब्बाल तै मीका पैदा होया। <verse eid="1CH 9:40" /><verse number="41" style="v" sid="1CH 9:41" />मीका के बेट्टे पीतोन, मेलेक, तह्रे अर आहाज; <verse eid="1CH 9:41" /><verse number="42" style="v" sid="1CH 9:42" />अर आहाज, तै यारा, अर यारा तै आलेमेत, अज्मावेत अर जिम्री, अर जिम्री तै मोसा, <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" />अर मोसा तै बिना पैदा होया अर बिना का बेट्टा रपायाह होया, रपायाह का एलासा, अर एलासा का बेट्टा आसेल होया। <verse eid="1CH 9:43" /><verse number="44" style="v" sid="1CH 9:44" />अर आसेल के छः बेट्टे होए जिनके ये नाम थे, यानिके अज्रीकाम, बोकरू, इश्माएल, शरायाह, ओबद्याह अर हानान; आसेल के येए बेट्टे होए।<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s">शाऊल की मौत</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />एक दिन पलिश्ती इस्राएलियाँ तै लड़े; अर इस्राएली पलिश्तियाँ कै स्याम्ही तै भाज्जे, अर गिलबो नाम के पहाड़ पै मारे गए। <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" />पर पलिश्ती शाऊल अर उसके बेट्यां कै पाच्छै लाग्गे रहे, अर पलिश्तियाँ नै शाऊल के बेट्टे योनातान, अबीनादाब अर मल्कीशूअ ताहीं मार गेरया। <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" />शाऊल कै गैल घमासान युद्ध होन्दा रह्या अर धनुर्धारियाँ नै उस ताहीं जा लिया, अर वो उनकै कारण व्याकुल होग्या। <verse eid="1CH 10:3" /><verse number="4" style="v" sid="1CH 10:4" />फेर शाऊल नै अपणे हथियार ढोणआळे तै कह्या, “अपणी तलवार खींचकै मेरै घोप दे, कदे इसा ना हो के वे खतनारहित माणस आकै मेरा मजाक करैं;” पर उसके हथियार ढोणआळे नै भयभीत होकै इसा करण तै इन्कार करया। फेर शाऊल अपणी तलवार खड़ी करकै उसपै गिर पड्या। <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />या देखकै के शाऊल मर ग्या सै उसका हथियार ढोणआळे अपणी तलवार पै आप गिरकै मर ग्या। <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />इस तरियां शाऊल अर उसके तीन्‍नु बेट्टे, अर उसके घरान्‍ने के सारे माणस एक साथ मर गए।<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="fq" closed="false">साथ मर गए। </char><char style="ft" closed="false">पूरा परिवार न्ही, सारे बेट्टे।</char></note> <verse eid="1CH 10:6" /><verse number="7" style="v" sid="1CH 10:7" />या देखकै के वे भाज गए, अर शाऊल अर उसके बेट्टे मर गए, उस तराई म्ह रहणआळे सारे इस्राएली माणस अपणे-अपणे नगर नै छोड़कै भाजगे; अर पलिश्ती आकै उन म्ह रहण लाग्गे।<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8" />दुसरे दिन जिब पलिश्ती मारे होयां के माल नै लूटण आए, फेर उननै शाऊल अर उसके बेट्टे गिलबो पहाड़ पै पड़े होए मिले। <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />फेर उननै उसके कपड़ेयां ताहीं उतार उसका सिर अर हथियार ले लिए अर पलिश्तियाँ के देश के सारी जगहां म्ह दूत्तां ताहीं ज्यांतै भेज्या के उनके देवत्यां अर साधारण माणसां म्ह यो शुभ समाचार देन्दे जावैं। <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />फेर उननै उसके हथियार अपणे मन्दर म्ह धरे, अर उसकी खोपड़ी ताहीं उनके देवता दागोन कै मन्दर म्ह लटका दी। <verse eid="1CH 10:10" /><verse number="11" style="v" sid="1CH 10:11" />जिब गिलाद के याबेश के सारे माणसां नै सुण्या के पलिश्तियाँ नै शाऊल कै गैल के-के करया सै। <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />फेर सारे शूरवीर चाल्‍ले अर शाऊल अर उसके बेट्यां की लाश ताहीं ठाकै याबेश म्ह ले आए, अर उनकी हाड्डियाँ ताहीं याबेश म्ह एक बांज दरखत कै तळै गाड़ दी अर सात दिन ताहीं उपवास करया।<verse eid="1CH 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13" />इस तरियां शाऊल उस बिश्वासघात कै कारण मर ग्या, जो उसनै यहोवा तै करया था; क्यूँके उसनै यहोवा का वचन टाळ दिया था, फेर उसनै भूत-सिद्धि करण आळी तै पूछ कै सलाह ली थी। <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />उसनै यहोवा तै ना पूच्छया था, ज्यांतै यहोवा नै उस ताहीं मारकै राजपाट ताहीं यिशै के बेट्टे दाऊद तै दे दिया।<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s">दाऊद ताहीं पूरे इस्राएल का राजा ठहराया गया</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />फेर सारे इस्राएली दाऊद कै धोरै हेब्रोन म्ह कठ्ठे होकै कहण लाग्गे, “सुण, हम माणस अर तू एक ए हाड्डी अर माँस सां। <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />पिछले दिनां म्ह जिब शाऊल राजा था, फेर भी इस्राएलियाँ का अगुआ तू ए था, अर तेरे परमेसवर यहोवा नै तेरे तै कह्या, ‘मेरी प्रजा इस्राएल का पाळी, अर मेरी प्रजा इस्राएल का प्रधान, तू ए होवैगा<note caller="+" style="f"><char style="fr" closed="false">11:2 </char><char style="fq" closed="false">होवैगा </char><char style="ft" closed="false">मत्ती 2:6 भजन 78:71 </char></note>।’” <verse eid="1CH 11:2" /><verse number="3" style="v" sid="1CH 11:3" />ज्यांतै सारे इस्राएली अगुवे हेब्रोन म्ह राजा कै धोरै आए, अर दाऊद नै उनकै गैल हेब्रोन म्ह यहोवा कै स्याम्ही करार करया; अर उननै यहोवा के वचन कै मुताबिक, जो उसनै शमूएल तै कह्या था, इस्राएल का राजा होण कै खात्तर दाऊद का अभिषेक करया।<verse eid="1CH 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />फेर सारे इस्राएलियाँ समेत दाऊद यरुशलेम गया, जो यबूस भी कुह्वावै था, अर ओड़ै यबूसी नाम के उस देश के निवासी रहवैं थे। <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" />फेर यबूस के बासिन्दया नै दाऊद तै कह्या, “तू उरै आण न्ही पावैगा।” फेर भी दाऊद नै सिय्योन नाम के गढ़ ताहीं ले लिया, वोए दाऊदपुर भी कुह्वावै सै। <verse eid="1CH 11:5" /><verse number="6" style="v" sid="1CH 11:6" />दाऊद नै कह्या, “जो कोए यबूसियाँ ताहीं सारे तै पैहल्या मारैगा, वो खास सेनापति होवैगा,” फेर सरूयाह का बेट्टा योआब<note caller="+" style="f"><char style="fr" closed="false">11:6 </char><char style="fq" closed="false">सरूयाह का बेट्टा योआब </char><char style="ft" closed="false">उसकी प्रवीणता इस बखत अर दाऊद नगरी के निर्माण कै बखत (1 इति. 11:8) सिर्फ इतिहास के इस एक संदर्भ तै हमनै बेरा लाग्गै सै।</char></note> सारे तै पैहल्या चढ़ गया, अर सेनापति बणग्या। <verse eid="1CH 11:6" /><verse number="7" style="v" sid="1CH 11:7" />फेर दाऊद उस गढ़ म्ह रहण लाग्या, ज्यांतै उसका नाम दाऊदपुर पड़या। <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" />अर उसनै नगर के च्यांरु ओड़, यानिके मिल्‍लो तै लेकै च्यांरु ओड़ शहरपनाह बणवाई, अर योआब नै बचे होए नगर के खण्डहरां ताहीं फेर बसाया। <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" />अर दाऊद का आदर-मान घणा बढ़दा गया अर सेनाओं का यहोवा उसकै गैल था।<verse eid="1CH 11:9" /></para>
  <para style="s">दाऊद के शूरवीर</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />यहोवा नै इस्राएल कै बारै म्ह जो वचन कह्या था, उसके मुताबिक दाऊद के जिन शूरवीरां नै सारे इस्राएलियाँ समेत उसके राज्य म्ह उसकै पक्ष म्ह होकै, उसतै राजा बणाण का जोर दिया, उन म्ह तै खास आदमी ये सै। <verse eid="1CH 11:10" /><verse number="11" style="v" sid="1CH 11:11" />दाऊद के शूरवीरां की नामावली यो सै, यानिके एक हक्मोनी का बेट्टा याशोबाम जो तीसां म्ह खास था, उसनै तीन सौ माणसां पै भाला चलाकै, उन ताहीं एक ए बखत म्ह मार गेरया।<verse eid="1CH 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12" />उसकै बाद अहोही दोदो का बेट्टा एलियाजर जो तीन्‍नु महान वीरां म्ह तै एक था। <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />वो पसदम्मीम म्ह जित्त जौ का एक खेत था, दाऊद कै गैल रहया जिब पलिश्ती ओड़ै युद्ध करण नै कठ्ठे होए थे, और माणस पलिश्तियाँ कै स्याम्ही तै भाज गए। <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />फेर उन ताहीं उस खेत कै बीच म्ह खड़े होकै उसकी हिफाजत करी, अर पलिश्तियाँ ताहीं मारया, अर यहोवा नै उनका बड़ा उद्धार करया।<verse eid="1CH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15" />तीसों खास आदमियाँ म्ह तै तीन दाऊद कै धोरै चट्टान नै, यानिके अदुल्‍लाम नाम की गुफा म्ह गए, अर पलिश्तियाँ की छावणी रपाईम नाम की तराई म्ह पड़ी होई थी। <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />उस बखत दाऊद गढ़ म्ह था, अर उस बखत पलिश्तियाँ की एक चौकी बैतलहम म्ह थी। <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" />फेर दाऊद नै बड़ी अभिलाषा कै गैल कह्या, “कौण मन्‍नै बैतलहम के फाटक कै धोरै के कुएँ का पाणी प्यावैगा।” <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />फेर वे तीन्‍नु जन पलिश्तियाँ की छावणी पै टूट पड़े अर बैतलहम के फाटक के कुएँ तै पाणी भरकै दाऊद कै धोरै ले आए; पर दाऊद नै पीण तै इन्कार करया अर यहोवा कै स्याम्ही अर्घ करकै उण्डेल्या: <verse eid="1CH 11:18" /><verse number="19" style="v" sid="1CH 11:19" />अर उसनै कह्या, “मेरा परमेसवर मेरै तै इसा करणा दूर राक्खै। के मै इन माणसां का लहू पीऊँ जिननै अपणी जान पै खेल्या सै? ये तो अपणे प्राण पै खेलकै उस ताहीं ले आए सैं।” ज्यांतै उसनै वो पाणी पीण तै इन्कार करया। इन तीन वीरां नै येए काम करे।<verse eid="1CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20" />अबीशै जो योआब का भाई था, वो तीन्‍नु म्ह खास था। उसनै अपणा भाला चलाकै तीन सौ ताहीं मार गेरया अर तीन्‍नु म्ह नाम्मी होग्या। <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />दुसरी श्रेणी के तीन्‍नु म्ह वो घणा प्रतिष्ठित था, अर उनका प्रधान होग्या, पर खास तीन्‍नु के पद ताहीं ना पोहच्या<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22" />यहोयादा का बेट्टा बनायाह था, जो कबसेल के एक वीर का बेट्टा था, जिसनै बड़े-बड़े काम करे थे, उसनै शेर बराबर दो मोआबियाँ ताहीं मार गेरया, अर हिमऋतु म्ह उसनै एक गड्ढे म्ह उतरकै एक शेर ताहीं मार गेरया। <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />फेर उसनै एक डील-डोल आळे यानिके पाँच हाथ लाम्बे मिस्री माणस ताहीं मार गेरया, वो मिस्री हाथ म्ह जुलाहों का ढेका-सा एक भाला लिए होए था, पर बनायाह एक लाठ्ठी ए लिए होए उसकै धोरै गया, अर मिस्री के हाथ तै भाले ताहीं खोसकै उसे के भाले तै उसे ताहीं घात करया। <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />इसे-इसे काम करकै यहोयादा का बेट्टा बनायाह उन तीन्‍नु वीरां म्ह नाम्मी होग्या। <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />वो तो तीसों तै घणा प्रतिष्ठित था, पर खास तीन्‍नु के पद ताहीं ना पोहच्या। उस ताहीं दाऊद नै अपणे अंगरक्षकां का प्रधान नियुक्त करया।<verse eid="1CH 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 11:26" />फेर दलां के वीर ये थे, यानिके योआब का भाई असाहेल, बैतलहमी दोदो का बेट्टा एल्हनान, <verse eid="1CH 11:26" /><verse number="27" style="v" sid="1CH 11:27" />हरोरी शम्मोत, पलोनी हेलेस, <verse eid="1CH 11:27" /><verse number="28" style="v" sid="1CH 11:28" />तकोई इक्‍केश का बेट्टा ईरा, अनातोती अबीएजेर, <verse eid="1CH 11:28" /><verse number="29" style="v" sid="1CH 11:29" />सिब्बकै हूशाई, अहोही ईलै, <verse eid="1CH 11:29" /><verse number="30" style="v" sid="1CH 11:30" />महरै नतोपाई, एक और नतोपाई बानाह का बेट्टा हेलेद, <verse eid="1CH 11:30" /><verse number="31" style="v" sid="1CH 11:31" />बिन्‍यामीनियाँ के गिबा नगरवासी रीबै का बेट्टा इत्तै, पिरातोनी बनायाह, <verse eid="1CH 11:31" /><verse number="32" style="v" sid="1CH 11:32" />गाश के नालों कै धोरै रहण आळा हूरै, अराबावासी अबीएल, <verse eid="1CH 11:32" /><verse number="33" style="v" sid="1CH 11:33" />बहूरीमी अज्मावेत, शालबोनी एल्यहबा, <verse eid="1CH 11:33" /><verse number="34" style="v" sid="1CH 11:34" />गीजोई हाशेम के बेट्टे, फेर हरारी शागे का बेट्टा योनातान, <verse eid="1CH 11:34" /><verse number="35" style="v" sid="1CH 11:35" />हरारी साकार का बेट्टा अहीआम, ऊर का बेट्टा एलीपाल, <verse eid="1CH 11:35" /><verse number="36" style="v" sid="1CH 11:36" />मकेराई हेपेर, पलोनी अहिय्याह, <verse eid="1CH 11:36" /><verse number="37" style="v" sid="1CH 11:37" />कर्मेली हेस्रो, एज्बै का बेट्टा नारै, <verse eid="1CH 11:37" /><verse number="38" style="v" sid="1CH 11:38" />नातान का भाई योएल, हग्री का बेट्टा मिभार, <verse eid="1CH 11:38" /><verse number="39" style="v" sid="1CH 11:39" />अम्‍मोनी सेलेक, बेरोती नहरै जो सरूयाह के बेट्टे योआब का हथियार ढोण आळा था, <verse eid="1CH 11:39" /><verse number="40" style="v" sid="1CH 11:40" />येतेरी ईरा अर गारेब, <verse eid="1CH 11:40" /><verse number="41" style="v" sid="1CH 11:41" />हित्ती ऊरिय्याह, अहलै का बेट्टा जाबाद, <verse eid="1CH 11:41" /><verse number="42" style="v" sid="1CH 11:42" />तीस माणसां समेत रूबेनी शीजा का बेट्टा अदीना जो रूबेनियाँ का मुखिया था, <verse eid="1CH 11:42" /><verse number="43" style="v" sid="1CH 11:43" />माका का बेट्टा हानान, मेतेनी योशापात, <verse eid="1CH 11:43" /><verse number="44" style="v" sid="1CH 11:44" />अश्तारोती उज्जियाह, अरोएरी होताम के बेट्टे शामा अर यीएल, <verse eid="1CH 11:44" /><verse number="45" style="v" sid="1CH 11:45" />शिम्री का बेट्टा यदीएल अर उसका भाई तीसी, योहा, <verse eid="1CH 11:45" /><verse number="46" style="v" sid="1CH 11:46" />महवीमी एलीएल, एलनाम के बेट्टे यरीबै अर योशव्याह, <verse eid="1CH 11:46" /><verse number="47" style="v" sid="1CH 11:47" />मोआबी यित्मा, एलीएल, ओबेद अर मसोबाई यासीएल।<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s">सिकलग म्ह दाऊद के बिन्‍यामीनी समर्थक</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 12:1" />जिब दाऊद सिकलग म्ह कीश के बेट्टे राजा शाऊल के डर के मारे छिप्या रहवै था, फेर ये उसकै धोरै ओड़ै आए, अर ये उन वीरां म्ह तै थे जो युद्ध म्ह उसके मददगार थे। <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />ये धनुर्धारी थे, जो दाएँ-बाएँ, दोनु हाथ्थां तै गोफन के पत्थर अर धनुष के तीर चला सकैं थे; अर ये शाऊल के भाईयाँ म्ह तै बिन्‍यामीनी<note caller="+" style="f"><char style="fr" closed="false">12:2 </char><char style="fq" closed="false">बिन्‍यामीनी </char><char style="ft" closed="false">बिन्यामिनियों की धनुष कला उरै व्यक्त सै। (1 इति. 8:40, 2 इति 14:8) बाएँ हाथ के इस्तमाल म्ह उनकी दक्षता न्यायियाँ के वृत्तान्त म्ह बताई गई सै (न्याय. 3:15 अर पार्श्व टिप्पणी) अर गोफन चलाण म्ह उनकी उत्कृष्टता भी व्यक्त सै। </char></note> थे, <verse eid="1CH 12:2" /><verse number="3" style="v" sid="1CH 12:3" />खास तो अहीएजेर अर दूसरा योआश था जो गिबावासी शमाआ का बेट्टा था; फेर अज्मावेत के बेट्टे यजीएल अर पेलेत, फेर बराका अर अनातोती येहू, <verse eid="1CH 12:3" /><verse number="4" style="v" sid="1CH 12:4" />अर गिबोनी यिशमायाह जो तीसों म्ह तै एक वीर अर उनकै उप्पर भी था; फेर यिर्मयाह, यहजीएल, योहानान, गदेरावासी योजाबाद, <verse eid="1CH 12:4" /><verse number="5" style="v" sid="1CH 12:5" />एलूजै, यरीमोत, बाल्याह, शेमर्याह, हारूपी शपत्याह, <verse eid="1CH 12:5" /><verse number="6" style="v" sid="1CH 12:6" />एल्काना, यिश्शिय्याह, अजरेल, योएजेर, याशोबाम, जो सारे कोरहवंशी थे, <verse eid="1CH 12:6" /><verse number="7" style="v" sid="1CH 12:7" />अर गदोरवासी यरोहाम के बेट्टे योएला अर जबद्याह। <verse eid="1CH 12:7" /><verse number="8" style="v" sid="1CH 12:8" />फेर जिब दाऊद जंगळ के गढ़ म्ह रहवै था, फेर ये गादी जो शूरवीर थे, अर युद्ध विद्या सीखे होए अर ढाल अर भाला काम म्ह ल्याण आळे थे, अर उनके मुँह शेर के जिसे अर वे पहाड़ी मृग कै बराबर तेज भाजण आळे थे, ये अर गादियाँ तै न्यारे होकै उसकै धोरै आए, <verse eid="1CH 12:8" /><verse number="9" style="v" sid="1CH 12:9" />यानिके खास तो एजेर, दूसरा ओबद्याह, तीसरा एलीआब, <verse eid="1CH 12:9" /><verse number="10" style="v" sid="1CH 12:10" />चौथा मिश्मन्‍ना, पाँचवाँ यिर्मयाह, <verse eid="1CH 12:10" /><verse number="11" style="v" sid="1CH 12:11" />छठा अत्तै, सातवाँ एलीएल, <verse eid="1CH 12:11" /><verse number="12" style="v" sid="1CH 12:12" />आठवाँ योहानान, नौवां एलजाबाद, <verse eid="1CH 12:12" /><verse number="13" style="v" sid="1CH 12:13" />दसमां यिर्मयाह अर ग्यारहवाँ मकबन्‍नै था, <verse eid="1CH 12:13" /><verse number="14" style="v" sid="1CH 12:14" />ये गादी खास योद्धा थे, उन म्ह तै जो सबतै छोट्टा था वो तो एक सौ कै उप्पर, अर जो सबतै बड़ा था, वो हजार कै उप्पर था। <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" />येए वे सैं, जो पैहले महिन्‍ने म्ह जिब यरदन नदी सारे किनारयाँ कै ऊपर-ऊपर बहवै थी, जद उसकै पार उतरे; अर पूर्व अर पश्चिम दोन्‍नु और की सारी तराई के रहण आळयां ताहीं भजा दिया। <verse eid="1CH 12:15" /><verse number="16" style="v" sid="1CH 12:16" />कई एक बिन्‍यामीनी अर यहूदी भी दाऊद कै धोरै गढ़ म्ह आए। <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" />उनतै मिलण नै दाऊद लिकड़या अर उनतै कह्या, “जै थम मेरै गैल मित्रभाव तै मेरी मदद करण नै आए हो, फेर तो मेरा मन थारे तै लाग्या रहवैगा; पर जै थम मन्‍नै धोक्खा देकै मेरे दुश्मनां कै हाथ पकड़वाण आए हो, तो म्हारे पितरां का परमेसवर इसपै नजर करकै डाँटै, क्यूँके मेरे हाथ तै कोए उपद्रव न्ही होया।” <verse eid="1CH 12:17" /><verse number="18" style="v" sid="1CH 12:18" />फेर आत्मा अमासै म्ह समाया, जो तीसों वीरां म्ह खास था, अर उसनै कह्या,</para>
  <para style="q" vid="1CH 12:18">“हे दाऊद! हम तेरे सां;</para>
  <para style="q" vid="1CH 12:18">हे यिशै के बेट्टे! हम तेरी और के सां,</para>
  <para style="q" vid="1CH 12:18">तेरा कल्याण ए कल्याण हो अर तेरे मददगारां का कल्याण हो,</para>
  <para style="q" vid="1CH 12:18">क्यूँके तेरा परमेसवर तेरी मदद करया करै सै।”</para>
  <para style="p" vid="1CH 12:18">ज्यांतै दाऊद नै उन ताहीं राख लिया, अर अपणे दल के मुखिए ठहरा दिए। <verse eid="1CH 12:18" /><verse number="19" style="v" sid="1CH 12:19" />फेर किमे मनश्शेई भी उस बखत दाऊद कै धोरै भाज आए, जिब वो पलिश्तियाँ कै गैल होकै शाऊल तै लड़ण नै गया, पर वो उसकी किमे मदद ना कर सक्या, क्यूँके पलिश्तियाँ के सरदारां नै सलाह लेण पै यो कहकै उसतै विदा करया, “वो म्हारे सिर कटवाकै अपणे स्वामी शाऊल तै फेर मिल ज्यागा।” <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" />जिब वो सिकलग नै जा रह्या था, फेर ये मनश्शेई उसकै धोरै भाज आए; यानिके अदनह, योजाबाद, यदीएल, मीकाएल, योजाबाद, एलीहू अर सिल्‍लतै जो मनश्शे के हजारां के मुखिए थे। <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" />इननै लुटेरयां के दल कै बिरुध्द दाऊद की मदद करी, क्यूँके ये सारे शूरवीर थे, अर सेना के प्रधान भी बण गए। <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />बलके रोज माणस दाऊद की मदद करण नै उसकै धोरै आन्दे रहे, उरै ताहीं के परमेसवर की सेना कै बराबर एक बड़ी सेना बणगी।<verse eid="1CH 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 12:23" />फेर माणस लड़ण खात्तर हथियार बाँधे होए हेब्रोन म्ह दाऊद कै धोरै ज्यांतै आए के यहोवा कै वचन के मुताबिक शाऊल का राज्य उसके हाथ म्ह करदे : उनके मुखिया की गिणती या सै। <verse eid="1CH 12:23" /><verse number="24" style="v" sid="1CH 12:24" />यहूदा के ढाल अर भाला लिए होए छः हजार आठ सौ हथियार-बन्द लड़ण नै आए। <verse eid="1CH 12:24" /><verse number="25" style="v" sid="1CH 12:25" />शिमोनी सात हजार एक सौ त्यार शूरवीर लड़ण नै आए। <verse eid="1CH 12:25" /><verse number="26" style="v" sid="1CH 12:26" />लेवीय च्यार हजार छः सौ आए। <verse eid="1CH 12:26" /><verse number="27" style="v" sid="1CH 12:27" />अर हारुन के घराने का प्रधान यहोयादा था, अर उसके गैल तीन हजार सात सौ आए। <verse eid="1CH 12:27" /><verse number="28" style="v" sid="1CH 12:28" />अर सादोक नाम का एक जवान वीर भी आया, अर उसके पिता के कुण्बे के बाईस प्रधान आए। <verse eid="1CH 12:28" /><verse number="29" style="v" sid="1CH 12:29" />अर शाऊल के भाई बिन्‍यामीनियाँ म्ह तै तीन हजार आए, क्यूँके उस बखत ताहीं आध्धे बिन्‍यामीनियाँ तै घणे शाऊल के घराने का पक्ष करदे रहे। <verse eid="1CH 12:29" /><verse number="30" style="v" sid="1CH 12:30" />फेर एप्रैमियां म्ह तै बड़े वीर अर अपणे-अपणे पितरां के घरान्यां म्ह नाम्मी माणस बीस हजार आठ सौ आए। <verse eid="1CH 12:30" /><verse number="31" style="v" sid="1CH 12:31" />मनश्शे के आध्धे गोत्र म्ह तै दाऊद नै राजा बणाण कै खात्तर अठारह हजार आए, जिनके नाम बताए गए थे। <verse eid="1CH 12:31" /><verse number="32" style="v" sid="1CH 12:32" />इस्साकारियाँ म्ह तै जो बखत नै पिच्छाणै थे, के इस्राएल नै के करणा उचित सै, उनके प्रधान दो सौ थे; अर उनके सारे भाई उनके हुकम म्ह रहवैं थे। <verse eid="1CH 12:32" /><verse number="33" style="v" sid="1CH 12:33" />फेर जबूलून म्ह तै युद्ध के सारे ढाळ के हथियार लिए होए लड़ण नै पाँति बाँधण आळे योद्धा पचास हजार आए, वे पाँति बाँधण आळे थे अर चंचल ना थे। <verse eid="1CH 12:33" /><verse number="34" style="v" sid="1CH 12:34" />फेर नप्ताली म्ह तै प्रधान तो एक हजार, अर उनकै गैल ढाल अर भाला लिए सैंतीस हजार आए। <verse eid="1CH 12:34" /><verse number="35" style="v" sid="1CH 12:35" />दानियां म्ह तै लड़ण खात्तर पाँति बाँधण आळे अट्ठाईस हजार छः सौ आए। <verse eid="1CH 12:35" /><verse number="36" style="v" sid="1CH 12:36" />अर आशेर म्ह तै लड़ण नै पाँति बाँधण आळे चाळीस हजार योद्धा आए। <verse eid="1CH 12:36" /><verse number="37" style="v" sid="1CH 12:37" />अर यरदन पार रहणआळे रूबेनी, गादी अर मनश्शे के आध्धे गोत्रियाँ म्ह तै युद्ध के सारे ढाळ के हथियार लिए होए एक लाख बीस हजार आए।<verse eid="1CH 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 12:38" />ये सारे युद्ध खात्तर पाँति बाँधण आळे दाऊद नै सारे इस्राएल का राजा बणाण कै खात्तर हेब्रोन म्ह सच्‍चे मन तै आए, अर और सारे इस्राएली भी दाऊद नै राजा बणाण कै खात्तर सहमत थे। <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />वे ओड़ै तीन दिन दाऊद के गैल खान्दे-पीन्दे रहे, क्यूँके उनके भाईयाँ नै उनकै खात्तर तैयारी करी थी, <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />अर जो उनकै लोवै बलके इस्साकार, जबूलून अर नप्ताली तक रहवैं थे, वे भी गधां, ऊँटां, खच्‍चरां अर बळधां पै मैद्दा, अंजीरां अर किशमिश की टिकियाँ, दाखमधु, तेल अर भोजनवस्तु लादकै लाए, अर बळध अर भेड़-बकरियाँ बहुतायत तै लाए; क्यूँके इस्राएल म्ह आनन्द मनाया जा रह्या था।<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s">पवित्र सन्दूक का यरुशलेम म्ह पोहचाया जाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />दाऊद नै सहस्‍त्रपतियाँ, शतपतियाँ अर सारे प्रधानां<note caller="+" style="f"><char style="fr" closed="false">13:1 </char><char style="fq" closed="false">प्रधानां </char><char style="ft" closed="false">हो सकै सै: इसी व्यवस्था दाऊद तै पैहले सारे गोत्रां म्ह कर दी गई थी पर दाऊद वो पैहला आदमी था जिसनै इन प्रधानां म्ह माणसां के प्रतिनिधित्व ताहीं पिछाणा था के उनतै जनता के बारें म्ह सलाह देई जावै अर उन ताहीं कोए राजनैतिक पद दिया जावै।</char></note> तै सलाह ली। <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />फेर दाऊद नै इस्राएल की सारी मण्डळी तै कह्या, “जै यो थमनै आच्छा लाग्गै अर म्हारे परमेसवर की इच्छा हो, तो इस्राएल के सारे देशां म्ह जो म्हारे भाई रह गए सैं अर उनकै गैल जो याजक अर लेवीय अपणे-अपणे चराई आळे नगरां म्ह रहवै सैं, उनकै धोरै भी यो खबर भेज्जे के म्हारै धोरै कठ्ठे हो जाओ, <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />अर हम अपणे परमेसवर के सन्दूक नै अपणे उरै ले आए; क्यूँके शाऊल के दिनां म्ह हम उसके धोरै न्ही जावां थे।” <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" />अर सारी मण्डळी नै कह्या, के वे इसाए करैगें, क्यूँके या बात उन सारे माणसां की नजरां म्ह उचित मालुम होई।<verse eid="1CH 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5" />फेर दाऊद नै मिस्र के शीहोर तै ले हमात<note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="fq" closed="false">ले हमात </char><char style="ft" closed="false">हमात शहर के दक्षिण म्ह पहाड़ी दर्रा</char></note> की घाटी ताहीं के सारे इस्राएलियाँ ताहीं ज्यांतै कठ्ठा करया, के परमेसवर के सन्दूक नै किर्यत्यारीम तै ले आए। <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" />फेर दाऊद सारे इस्राएलियाँ नै गैल लेकै बाला नै गया, जो किर्यत्यारीम भी कुह्वावै था अर यहूदा के भाग म्ह था, के परमेसवर यहोवा का सन्दूक ओड़ै तै ले आए; वो तो करूबां पै विराजण आळा सै, अर उसका नाम भी योए लिया जावै सै। <verse eid="1CH 13:6" /><verse number="7" style="v" sid="1CH 13:7" />फेर उन ताहीं परमेसवर का सन्दूक एक नई गाड़ी पै चढ़ाकै, अबीनादाब के घर तै लिकाड़या, अर उज्जा अर अह्यो उस गाड़ी नै चलाण लाग्गे। <verse eid="1CH 13:7" /><verse number="8" style="v" sid="1CH 13:8" />दाऊद अर सारे इस्राएली परमेसवर कै स्याम्ही तन-मन तै गीत गान्दे अर वीणा, सारंगी, डफ, झाँझ अर तुरहियाँ बजावैं थे।<verse eid="1CH 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9" />जिब वे किदोन कै खलिहाण ताहीं आए, फेर उज्जा नै अपणा हाथ सन्दूक थामण नै बढ़ाया, क्यूँके बळधां नै ठोक्‍कर खाई थी। <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" />फेर यहोवा का कोप उज्जा पै भड़क उठ्या; अर उसनै उन ताहीं मारया क्यूँके उसनै सन्दूक पै हाथ लगाया था; वो ओड़ैए परमेसवर कै स्याम्ही मर ग्या। <verse eid="1CH 13:10" /><verse number="11" style="v" sid="1CH 13:11" />फेर दाऊद नाराज होया, ज्यांतै के यहोवा उज्जा पै टूट पड़या था; अर उसनै उस जगहां का नाम पेरेसुज्जा<note caller="+" style="f"><char style="fr" closed="false">13:11 </char><char style="fq" closed="false">पेरेसुज्जा </char><char style="ft" closed="false">उज्जा की सजा</char></note> राख्या, यो नाम आज ताहीं बण्या सै। <verse eid="1CH 13:11" /><verse number="12" style="v" sid="1CH 13:12" />उस दिन दाऊद परमेसवर तै डरकै कहण लाग्या, “मै परमेसवर के सन्दूक नै अपणे उरै किस तरियां ले आऊँ?” <verse eid="1CH 13:12" /><verse number="13" style="v" sid="1CH 13:13" />फेर दाऊद सन्दूक नै अपणे उरै दाऊदपुर म्ह ना ल्याया, पर ओबेदेदोम नाम के गती कै ओड़ै लेग्या। <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />अर परमेसवर का सन्दूक ओबेदेदोम कै उरै उसके घरान्‍ने कै धोरै तीन महिन्‍ने ताहीं रहया, अर यहोवा नै ओबेदेदोम के घराने पै अर जो किमे उसका था उसपै भी आशीष दी।<verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s">दाऊद का यरुशलेम म्ह स्थिर होणा</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />सोर के राजा हीराम नै दाऊद कै धोरै दूत भेज्जे, अर उसका भवन बणाण नै देवदार की लाकड़ी अर राजमिस्त्री अर बढ़ई भेज्जे। <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" />फेर दाऊद नै पक्‍का होग्या के यहोवा नै उस ताहीं इस्राएल का राजा करकै स्थिर करया सै, क्यूँके उसकी प्रजा इस्राएल के निमित्त उसका राज्य भोत घणा बढ़ ग्या था।<verse eid="1CH 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3" />यरुशलेम म्ह दाऊद नै और जनानियाँ तै ब्याह कर लिया, अर उनतै बेट्टे-बेटियाँ पैदा होई। <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />उसकै जो सन्तान यरुशलेम म्ह पैदा होई, उनके नाम ये सै : शम्मू, शोबाब, नातान, सुलैमान; <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" />यिभार, एलीशू, एलपेलेत; <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" />नोगह, नेपेग, यापी, एलीशामा, <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" />बेल्यादा अर एलीपेलेत।<verse eid="1CH 14:7" /></para>
  <para style="s">पलिश्तियाँ की हार</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />जिब पलिश्तियाँ नै सुण्या के पूरे इस्राएल का राजा होण खात्तर दाऊद का अभिषेक होया, फेर सारे पलिश्तियाँ नै दाऊद की खोज म्ह चढ़ाई करी; या सुणकै दाऊद उनका सामना करण नै लिकड़ ग्या। <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" />पलिश्ती आए अर रपाईम नाम की तराई म्ह धावा बोल्या। <verse eid="1CH 14:9" /><verse number="10" style="v" sid="1CH 14:10" />फेर दाऊद नै परमेसवर तै पूच्छया, “के मै पलिश्तियाँ पै चढ़ाई करुँ? अर के तू उननै मेरै हाथ म्ह कर देगा?” यहोवा नै उसतै कह्या, “चढ़ाई कर, क्यूँके मै उननै तेरै हाथ म्ह कर दियुँगा।” <verse eid="1CH 14:10" /><verse number="11" style="v" sid="1CH 14:11" />ज्यांतै जिब वे बालपरासीम नै आए, फेर दाऊद नै उन ताहीं ओड़ैए मार लिया; फेर दाऊद नै कह्या, “परमेसवर मेरे जरिये मेरे दुश्मनां पै पाणी की धारा कै बराबर टूट पड़या सै।” इस कारण उस जगहां का नाम बालपरासीम<note caller="+" style="f"><char style="fr" closed="false">14:11 </char><char style="fq" closed="false">बालपरासीम </char><char style="ft" closed="false">बालपरासीम का मतलब सै प्रभु नै भाग लिया या प्रभु के जरिये तै फट ग्या।</char></note> धरया गया। <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" />ओड़ै वे अपणी मूर्तियाँ नै छोड़गे<note caller="+" style="f"><char style="fr" closed="false">14:12 </char><char style="fq" closed="false">अपणी मूर्तियाँ नै छोड़गे </char><char style="ft" closed="false">प्राचीन युग की जात्तां म्ह अपणे देवत्यां नै लेकै युद्ध म्ह जाणा एक सामान्य रीत थी जो इस अंधबिश्वास तै शरुआत होया के मूर्तियाँ म्ह कुछ गुण सै अर उनके जरिये सेना नै कामयाबी हासिल होवै सै।</char></note>, अर दाऊद के हुकम तै वे आग लगाकै फूँक दिए गए।<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13" />फेर दुसरी बार पलिश्तियाँ नै उसे तराई म्ह धावा बोल्या। <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" />फेर दाऊद नै परमेसवर तै फेर पूच्छया, अर परमेसवर नै उसतै कह्या, “उनका पिच्छा न कर; उनतै मुड़कै तूत के दरखतां कै स्याम्ही तै उनपै छाप्पा मार। <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />अर जिब तूत के दरखतां की चोट्टी म्ह तै सेना के चालण की जिसी आहट तन्‍नै सुण पड़ै, फेर यो जाणकै युद्ध करण नै लिकड़ जाणा के परमेसवर पलिश्तियाँ की सेना नै मारण कै खात्तर तेरै आग्गै जा रहया सै।” <verse eid="1CH 14:15" /><verse number="16" style="v" sid="1CH 14:16" />परमेसवर के इस हुकम कै मुताबिक दाऊद नै करया, अर इस्राएलियाँ नै पलिश्तियाँ की सेना ताहीं गिबोन तै लेकै गेजेर ताहीं मार लिया। <verse eid="1CH 14:16" /><verse number="17" style="v" sid="1CH 14:17" />फेर दाऊद की कीर्ति सारे देशां म्ह फैलगी, अर यहोवा नै सारी जात्तां के मन म्ह उसका डर भर दिया।<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s">पवित्र सन्दूक की यरुशलेम म्ह वापसी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />फेर दाऊद नै दाऊदपुर म्ह भवन बणवाए, अर परमेसवर के सन्दूक कै खात्तर एक जगहां त्यार करकै एक तम्बू खड़या करया<note caller="+" style="f"><char style="fr" closed="false">15:1 </char><char style="fq" closed="false">एक तम्बू खड़या करया </char><char style="ft" closed="false">मिलापआळा तम्बू तो इब भी गिबोन म्ह था। </char></note>। <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />फेर दाऊद नै कह्या, “लेवियाँ नै छोड़ और किसे नै परमेसवर का सन्दूक ठाणा न्ही चाहिये<note caller="+" style="f"><char style="fr" closed="false">15:2 </char><char style="fq" closed="false">लेवियाँ नै छोड़ और किसे नै परमेसवर का सन्दूक ठाणा न्ही चाहिये </char><char style="ft" closed="false">उज्जा पै परमेसवर के प्रकोप (1 इति. 13:11) कै बाद दाऊद नै वाचा के सन्दूक नै ठाण खात्तर सारे वैधानिक अनिवार्यताओं पै ध्यान दिया अर वो उनके पाळण के प्रति सावधान था। </char></note>, क्यूँके यहोवा नै उन ताहीं ज्यांतै चुण्या सै के वे परमेसवर का सन्दूक ठावै अर उसकी सेवा टहल सदा करया करैं<note caller="+" style="f"><char style="fr" closed="false">15:2 </char><char style="ft" closed="false">गिनती 1:50, व्यव. 10:8</char></note>।” <verse eid="1CH 15:2" /><verse number="3" style="v" sid="1CH 15:3" />फेर दाऊद नै सारे इस्राएलियाँ ताहीं यरुशलेम म्ह ज्यांतै कठ्ठा करया के यहोवा का सन्दूक उस जगहां पै पोहचावै, जिन ताहीं उसनै उसकै खात्तर त्यार करया था। <verse eid="1CH 15:3" /><verse number="4" style="v" sid="1CH 15:4" />ज्यांतै दाऊद नै हारुन के सन्तानां अर लेवियाँ ताहीं कठ्ठा करया: <verse eid="1CH 15:4" /><verse number="5" style="v" sid="1CH 15:5" />यानिके कहातियाँ म्ह तै ऊरीएल नाम के प्रधान नै अर उसके एक सौ बीस भाईयाँ ताहीं; <verse eid="1CH 15:5" /><verse number="6" style="v" sid="1CH 15:6" />मरारियाँ म्ह तै असायाह नाम के प्रधान नै अर उसके दो सौ बीस भाईयाँ ताहीं; <verse eid="1CH 15:6" /><verse number="7" style="v" sid="1CH 15:7" />गेर्शोमियाँ म्ह तै योएल नाम के प्रधान नै अर उसके एक सौ तीस भाईयाँ ताहीं; <verse eid="1CH 15:7" /><verse number="8" style="v" sid="1CH 15:8" />एलीसापानियाँ म्ह तै शमायाह नाम के प्रधान नै अर उसके दो सौ भाईयाँ ताहीं; <verse eid="1CH 15:8" /><verse number="9" style="v" sid="1CH 15:9" />हेब्रोनियाँ म्ह तै एलीएल नाम के प्रधान नै अर उसके अस्सी भाईयाँ ताहीं; <verse eid="1CH 15:9" /><verse number="10" style="v" sid="1CH 15:10" />अर उज्जीएलियाँ म्ह तै अम्मीनादाब नाम के प्रधान नै अर उसके एक सौ बारहा भाईयाँ ताहीं। <verse eid="1CH 15:10" /><verse number="11" style="v" sid="1CH 15:11" />फेर दाऊद नै सादोक अर एब्यातार नाम के याजकां ताहीं, अर ऊरीएल, असायाह, योएल, शमायाह, एलीएल अर अम्मीनादाब नाम के लेवियाँ तै बुलवाकै उनतै कह्या, <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />“थम तो लेवीय पितरां के घरान्यां म्ह खास आदमी सो; ज्यांतै अपणे भाईयाँ समेत अपणे-आपनै पवित्र करो, के थम इस्राएल के परमेसवर यहोवा का सन्दूक उस जगहां पै पोंहचा सको जिस ताहीं मन्‍नै उसकै खात्तर त्यार करया सै। <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />क्यूँके पिछली बार थमनै उस ताहीं न्ही उठाया था इस कारण म्हारा परमेसवर यहोवा म्हारे पै टूट पड़या, क्यूँके हम उसकी खोज म्ह नियम कै मुताबिक ना लाग्गे थे।” <verse eid="1CH 15:13" /><verse number="14" style="v" sid="1CH 15:14" />फेर याजकां अर लेवियाँ नै अपणे-आप ताहीं पवित्र करया, के इस्राएल के परमेसवर यहोवा का सन्दूक ले जा सकैं। <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" />फेर उस हुकम कै मुताबिक जो मूसा नै यहोवा का वचन सुणकै दिया था, लेवियाँ नै सन्दूक तै डण्ड्याँ कै बळ अपणे कंध्यां पै ठा लिया।<verse eid="1CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16" />फेर दाऊद नै प्रधान लेवियाँ तै हुकम दिया के अपणे भाई गवैयां<note caller="+" style="f"><char style="fr" closed="false">15:16 </char><char style="fq" closed="false">गवैयां </char><char style="ft" closed="false">भजन गाण तै घणा पैहले ए तै धार्मिक संस्कारां म्ह उचित मान्या गया था। (निर्ग. 15:21, न्या. 5:1, 1 इति. 13:8) पर उरै हम पैहली बार देक्खां सां के संगीत का आयोजन करणा लेवियाँ का उत्तरदायित्व था।</char></note> नै बाजे यानिके सारंगी, वीणा अर झाँझ देकै बजाण अर आनन्द कै गैल ऊँच्‍चे स्वर तै गाण कै खात्तर नियुक्त करैं। <verse eid="1CH 15:16" /><verse number="17" style="v" sid="1CH 15:17" />फेर लेवियाँ नै योएल के बेट्टे हेमान तै, अर उसके भाईयाँ म्ह तै बेरेक्याह के बेट्टे आसाप ताहीं, अर अपणे भाई मरारियाँ म्ह तै कूशायाह के बेट्टे एतान ताहीं ठैहराया। <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />उनकै गैल उन ताहीं दुसरे पद के अपणे भाईयाँ ताहीं यानिके जकर्याह, बेन, याजीएल, शमीरामोत, यहीएल, उन्‍नी, एलीआब, बनायाह, मासेयाह, मत्तित्याह, एलीपलेह, मिकनेयाह, अर ओबेदेदोम अर यीएल ताहीं जो द्वारपाल थे ठैहराया। <verse eid="1CH 15:18" /><verse number="19" style="v" sid="1CH 15:19" />आखर हेमान, आसाप अर एतान नाम के गवैये तो पीतळ की झाँझ बजा-बजाकै राग चलाण ताहीं; <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" />अर जकर्याह, अजीएल, शमीरामोत, यहीएल, उन्‍नी, एलीआब, मासेयाह, अर बनायाह, अलामोत, नाम का राग म्ह सारंगी बजाण ताहीं; <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" />अर मत्तित्याह, एलीपलेह, मिकनेयाह ओबेदेदोम, यीएल अर अजज्याह वीणा खर्ज म्ह छेड़ण ताहीं ठहराए गए। <verse eid="1CH 15:21" /><verse number="22" style="v" sid="1CH 15:22" />अर राग उठाणे का अधिकारी कनन्याह नाम के लेवियाँ का प्रधान था, वो राग उठाणे कै बारै म्ह शिक्षा देवै था, क्यूँके वो निपुण था। <verse eid="1CH 15:22" /><verse number="23" style="v" sid="1CH 15:23" />अर बेरेक्याह अर एल्काना सन्दूक के द्वारपाल थे। <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" />अर शबन्याह, योशापात, नतनेल, अमासै, जकर्याह, बनायाह अर एलीएजेर नाम के याजक परमेसवर के सन्दूक कै आगै-आगै तुरहियाँ बजान्दे होए चाल्‍ले अर ओबेदेदोम अर यहिय्याह उसके द्वारपाल थे; <verse eid="1CH 15:24" /><verse number="25" style="v" sid="1CH 15:25" />दाऊद अर इस्राएलियाँ के अगुवे अर सहस्त्रपति सारे मिलकै यहोवा की वाचा का सन्दूक ओबेदेदोम कै घर तै आनन्द कै गैल ल्याण कै खात्तर गए। <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />जिब परमेसवर नै लेवियाँ की मदद करी जो यहोवा की वाचा का सन्दूक ठाणआळे थे, फेर उननै सात बळध अर सात मिंढे बलि करे। <verse eid="1CH 15:26" /><verse number="27" style="v" sid="1CH 15:27" />दाऊद, अर यहोवा की वाचा का सन्दूक ठाणआळे सारे लेवीय अर गाणआळे अर गाण आळयां कै गैल राग ठाणआळे का प्रधान कनन्याह, ये सारे तो सण के कपड़े के बागे पैहरे थे, अर दाऊद सण के कपड़े का एपोद पैहरे था। <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />इस तरियां सारे इस्राएली यहोवा की वाचा के सन्दूक नै जयजयकार करदे, अर नरसिंगे, तुरहियाँ अर झाँझ बजान्दे अर सारंगियाँ अर वीणा बजान्दे होए ले चाल्‍ले। <verse eid="1CH 15:28" /><verse number="29" style="v" sid="1CH 15:29" />इस तरियां यहोवा की वाचा का सन्दूक दाऊदपुर म्ह पोहच्या फेर शाऊल की बेट्टी मीकल<note caller="+" style="f"><char style="fr" closed="false">15:29 </char><char style="fq" closed="false">मीकल </char><char style="ft" closed="false">मीकल दाऊद की घरआळियाँ म्ह तै एक थी। (देखें <char style="xt"><ref loc="1SA 18:17-30">1 शमू. 18:17-30</ref></char>)</char></note> नै खिड़की म्ह तै झाँककै दाऊद राजा ताहीं कूदते अर नाचदे होए देख्या, अर उस ताहीं मन ए मन तुच्छ जाण्या।<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="s">सन्दूक का तम्बू म्ह राख्या जाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1" />फेर परमेसवर का सन्दूक ल्याकै उस तम्बू म्ह धरया गया जो दाऊद नै उसकै खात्तर खड़या कराया था; अर परमेसवर कै स्याम्ही होमबलि अर मेलबलि चढ़ाए गए। <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" />जिब दाऊद होमबलि अर मेलबलि चढ़ा चुक्या, फेर उसनै यहोवा कै नाम तै प्रजा ताहीं आशीर्वाद दिया। <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />अर उसनै के माणस, के जनान्‍नी, सारे इस्राएलियाँ ताहीं एक-एक रोट्टी अर एक-एक टुकड़ा माँस अर किशमिश की एक-एक टिकिया बँटवा दी।<verse eid="1CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4" />फेर उसनै कई लेवियाँ ताहीं ज्यांतै ठहरा दिया, के यहोवा के सन्दूक कै स्याम्ही सेवा पाणी करया करैं, अर इस्राएल के परमेसवर यहोवा की चर्चा अर उसका धन्यवाद अर स्तुति करया करैं। <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />उनका मुखिया तो आसाप था, अर उसकै नीच्‍चै जकर्याह था, फेर यीएल, शमीरामोत, यहीएल, मत्तित्याह, एलीआब बनायाह, ओबेदेदोम अर यीएल थे; ये तो सारंगियाँ अर वीणा लिये होए थे, अर आसाप झाँझ पै राग बजावै था। <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" />बनायाह अर यहजीएल नाम के याजक परमेसवर के वाचा के सन्दूक कै स्याम्ही रोज तुरहियाँ बजाण कै खात्तर नियुक्त करे गए।<verse eid="1CH 16:6" /></para>
  <para style="s">दाऊद कै जरिये धन्यवाद गीत</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7" />फेर उसे दिन दाऊद नै यहोवा का धन्यवाद करण का काम आसाप अर उसके भाईयाँ तै सौंप दिया।<verse eid="1CH 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="1CH 16:8" />यहोवा का धन्यवाद करो<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="fq" closed="false">यहोवा का धन्यवाद करो </char><char style="ft" closed="false">इतिहासकार नै म्हारे अाग्गै जो भजन राख्या सै वो आराधना विधि सरूप आसाप अर उसके भाईयाँ कै जरिये उस बखत गाया गया था जिब वाचा का सन्दूक यरुशलेम म्ह प्रवेश कर रहया था।</char></note>, उसतै प्रार्थना करो;</para>
  <para style="q" vid="1CH 16:8">देश-देश म्ह उसके काम्मां का प्रचार करो।<verse eid="1CH 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="1CH 16:9" />उसका गीत गाओ, उसका भजन करो,</para>
  <para style="q" vid="1CH 16:9">उसके सारे आश्चर्यकर्मा का ध्यान करो।<verse eid="1CH 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="1CH 16:10" />उसके पवित्र नाम पै घमण्ड करो;</para>
  <para style="q" vid="1CH 16:10">यहोवा के खोजियाँ का मन आनन्दित हो।<verse eid="1CH 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="1CH 16:11" />यहोवा अर उसकी सामर्थ्य की खोज करो;</para>
  <para style="q" vid="1CH 16:11">उसके दर्शन कै खात्तर लगातार खोज करो।<verse eid="1CH 16:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="1CH 16:12" />उसके करे होए चमत्कार,</para>
  <para style="q" vid="1CH 16:12">उसके चमत्कार अर न्यायवचन याद करो।<verse eid="1CH 16:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="1CH 16:13" />हे उसके दास इस्राएल के वंश,</para>
  <para style="q" vid="1CH 16:13">हे याकूब की सन्तान थम जो उसके चुणे होए सो!<verse eid="1CH 16:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="1CH 16:14" />वोए म्हारा परमेसवर यहोवा सै,</para>
  <para style="q" vid="1CH 16:14">उसके न्याय के काम धरती भर म्ह होवै सैं।<verse eid="1CH 16:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="1CH 16:15" />उसके करार नै सदा याद राक्खो,</para>
  <para style="q" vid="1CH 16:15">यो वोए वचन सै जो उसनै हजार पीढ़ियाँ कै खात्तर ठहरा दिया।<verse eid="1CH 16:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="1CH 16:16" />वो करार उसनै अब्राहम कै गैल बाँध्या</para>
  <para style="q" vid="1CH 16:16">और उसे कै बारै म्ह उसनै इसहाक तै शपथ खाई,<verse eid="1CH 16:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="1CH 16:17" />अर उसे ताहीं उसनै याकूब कै खात्तर विधि</para>
  <para style="q" vid="1CH 16:17">करकै अर इस्राएल कै खात्तर सदा का करार बाँधकै यो कहकै दृढ़ करया,<verse eid="1CH 16:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="1CH 16:18" />“मै कनान देश तेरै ताहीं दियुँगा,</para>
  <para style="q" vid="1CH 16:18">वो बाँट म्ह थारा अपणा हिस्सा होवैगा।”<verse eid="1CH 16:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="1CH 16:19" />उस बखत तो थम गिणती म्ह थोड़े थे,</para>
  <para style="q" vid="1CH 16:19">बलके घणेए थोड़े अर उस देश म्ह परदेशी थे।<verse eid="1CH 16:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="1CH 16:20" />अर वे एक जात तै दुसरी जात म्ह,</para>
  <para style="q" vid="1CH 16:20">अर एक राज्य तै दुसरे म्ह फिरदे तो रहे,<verse eid="1CH 16:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="1CH 16:21" />पर उसनै किसे माणस ताहीं उनपै अंधेर करण ना दिया;</para>
  <para style="q" vid="1CH 16:21">अर वो राजयां ताहीं उनकै निमित्त या धमकी देवै था,<verse eid="1CH 16:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="1CH 16:22" />“मेरे अभिषिक्तां नै ना छूओ,</para>
  <para style="q" vid="1CH 16:22">अर ना मेरे नबियाँ का किमे नुकसान करो।”<verse eid="1CH 16:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="1CH 16:23" />हे सारे पृथ्वी के माणसों यहोवा का गीत गाओ।</para>
  <para style="q" vid="1CH 16:23">रोज उसके करे होए उद्धार का शुभ समाचार सुणान्दे रहो।<verse eid="1CH 16:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="1CH 16:24" />गैरजात्तां म्ह उसकी महिमा का,</para>
  <para style="q" vid="1CH 16:24">अर देश-देश के माणसां म्ह उसके अदभुत काम्मां का जिक्र करो।<verse eid="1CH 16:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="1CH 16:25" />क्यूँके यहोवा महान अर स्तुति के अति योग्य सै,</para>
  <para style="q" vid="1CH 16:25">वो तो सारे देवत्यां तै घणा भययोग्य सै।<verse eid="1CH 16:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="1CH 16:26" />क्यूँके देश-देश के सारे देवता तो मूर्ति ए सैं;</para>
  <para style="q" vid="1CH 16:26">पर यहोवा ए नै सुर्ग ताहीं बणाया सै।<verse eid="1CH 16:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="1CH 16:27" />उसके च्यांरु ओड़ वैभव अर ऐश्वर्य सै;</para>
  <para style="q" vid="1CH 16:27">उसकी जगहां म्ह सामर्थ्य अर आनन्द सै।<verse eid="1CH 16:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="1CH 16:28" />हे देश-देश के कुलों, यहोवा का गुणानुवाद करो,</para>
  <para style="q" vid="1CH 16:28">यहोवा की महिमा अर सामर्थ्य नै मान्‍नो।<verse eid="1CH 16:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="1CH 16:29" />यहोवा के नाम की महिमा इसी मान्‍नो जो उसके नाम कै योग्य सै।</para>
  <para style="q" vid="1CH 16:29">भेंट लेकै उसकै स्याम्ही आओ,</para>
  <para style="q" vid="1CH 16:29">पवित्रता तै शोभायमान होकै यहोवा नै दण्डवत करो।<verse eid="1CH 16:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="1CH 16:30" />हे सारी धरती के माणसों उसकै स्याम्ही थरथराओ!</para>
  <para style="q" vid="1CH 16:30">जगत इसा स्थिर सै, के वो टळण का न्ही।<verse eid="1CH 16:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="1CH 16:31" />अकास आनन्द करै अर पृथ्वी मगन हो,</para>
  <para style="q" vid="1CH 16:31">अर जात-जात म्ह लोग कहवै, “यहोवा राजा होया सै।”<verse eid="1CH 16:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="1CH 16:32" />समुन्दर अर उस म्ह की सारी चीज गरज उठै,</para>
  <para style="q" vid="1CH 16:32">मैदान अर जो किमे उस म्ह सै वो प्रफुल्‍लित हो।<verse eid="1CH 16:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="1CH 16:33" />उसे बखत बण के पेड़ यहोवा कै स्याम्ही जयजयकार करैं,</para>
  <para style="q" vid="1CH 16:33">क्यूँके वो धरती का न्याय करण नै आण आळा सै।<verse eid="1CH 16:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="1CH 16:34" />यहोवा का धन्यवाद करो, क्यूँके वो भला सै;</para>
  <para style="q" vid="1CH 16:34">उसकी करुणा सदा की सै।<verse eid="1CH 16:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="1CH 16:35" />अर या कहो, “हे म्हारे उद्धार करण आळे परमेसवर म्हारा उद्धार कर,</para>
  <para style="q" vid="1CH 16:35">अर हमनै कठ्ठा करकै गैरजात्तां तै छुड़ा,</para>
  <para style="q" vid="1CH 16:35">के हम तेरे पवित्र नाम का धन्यवाद करां,</para>
  <para style="q" vid="1CH 16:35">अर तेरी स्तुति करदे होए तेरै बारै म्ह बड़ाई करां<note caller="+" style="f"><char style="fr" closed="false">16:35 </char><char style="fq" closed="false">बड़ाई करां </char><char style="ft" closed="false">भजन. 106:47</char></note>।<verse eid="1CH 16:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="1CH 16:36" />शरुआत तै अनन्त काल ताहीं इस्राएल का</para>
  <para style="q" vid="1CH 16:36">परमेसवर यहोवा धन्य सै।”</para>
  <para style="m" vid="1CH 16:36">फेर सारी प्रजा नै “आमीन” कह्या: अर यहोवा की स्तुति करी। <verse eid="1CH 16:36" /><verse number="37" style="v" sid="1CH 16:37" />फेर उसनै ओड़ै यानिके यहोवा की वाचा के सन्दूक कै स्याम्ही आसाप अर उसके भाईयाँ ताहीं छोड़ दिया, के रोज की जरूरत कै मुताबिक वे सन्दूक के स्याम्ही रोज सेवा पाणी करया करैं, <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />अर अड़सठ भाईयाँ समेत ओबेदेदोम ताहीं, अर द्वारपालां कै खात्तर यदूतून के बेट्टे ओबेदेदोम अर होसा ताहीं छोड़ दिया। <verse eid="1CH 16:38" /><verse number="39" style="v" sid="1CH 16:39" />फेर उसनै सादोक याजक अर उसके भाई याजकां ताहीं यहोवा के निवास कै स्याम्ही, जो गिबोन के ऊँच्‍ची जगहां म्ह था, ठहरा दिया, <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />के वे रोज सबेरै अर शाम नै होमबलि की वेदी<note caller="+" style="f"><char style="fr" closed="false">16:40 </char><char style="fq" closed="false">होमबलि की वेदी </char><char style="ft" closed="false">होमबलि की वेदी (निर्ग. 27:1-8) गिबोन म्ह मिलापआळे तम्बू ए म्ह थी (2 इति. 1:3, 2 इति. 1:5) हो सकै सै के दाऊद नै यरुशलेम म्ह बलि चढ़ाण कै खात्तर एक नई वेदी बणाई।</char></note> पै यहोवा ताहीं होमबलि चढ़ाया करै, अर उन सारे कै मुताबिक करया करैं, जो यहोवा के नियम-कायदे म्ह लिख्या सै, जिन ताहीं उसनै इस्राएल तै दिए थे। <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />अर उनकै गैल उसनै हेमान अर यदूतून अर दुसरयां ताहीं भी जो नाम लेकै चुणे गए थे ठहरा दिया, के यहोवा की सदा की करुणा कै कारण उसका धन्यवाद करैं। <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" />अर उनकै गैल उसनै हेमान अर यदूतून ताहीं बजाण आळयां कै खात्तर तुरहियाँ अर झाँझें अर परमेसवर के गीत गाण कै खात्तर बाजे दिए, अर यदूतून के बेट्यां ताहीं फाटक की रुखाळी करण नै ठहरा दिया।<verse eid="1CH 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43" />फेर प्रजा के सारे माणस अपणे-अपणे घर चले गए, अर दाऊद अपणे घरान्‍ने नै आशीर्वाद देण नै बोहड़ ग्या।<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s">दाऊद के गैल परमेसवर का करार</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />जिब दाऊद अपणे भवन म्ह रहण लाग्या, फेर दाऊद नै नातान नबी तै कह्या, “देख, मै तो देवदार के बणे होए घर म्ह रहया करुँ सूं, पर यहोवा के वाचा का सन्दूक तम्बू म्ह रहवै सै।” <verse eid="1CH 17:1" /><verse number="2" style="v" sid="1CH 17:2" />नातान नै दाऊद तै कह्या, “जो किमे तेरै मन म्ह हो उसनै कर, क्यूँके परमेसवर तेरै गैल सै।”<verse eid="1CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3" />उसे दिन-रात नै परमेसवर का यो वचन नातान कै धोरै पोहच्या, “जाकै मेरे दास दाऊद तै कह, <verse eid="1CH 17:3" /><verse number="4" style="v" sid="1CH 17:4" />‘यहोवा यों कहवै सै: मेरे निवास कै खात्तर तू घर बणवाण ना पावैगा। <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />क्यूँके जिस दिन तै मै इस्राएलियाँ नै मिस्र तै ले आया, आज कै दिन ताहीं मै कदे घर म्ह न्ही रहया; पर एक तम्बू तै दुसरे तम्बू ताहीं अर एक निवास तै दुसरे निवास ताहीं आया-जाया करुँ सूं। <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />जित्त-जित्त मन्‍नै सारे इस्राएलियाँ कै बीच म्ह आणा-जाणा करया, के मन्‍नै इस्राएल के न्यायियाँ म्ह तै जिन ताहीं मन्‍नै अपणी प्रजा की रुखाळ करण नै ठैहराया था, किसे तै इसी बात कदे कही के थम माणसां नै मेरै खात्तर देवदार का घर क्यूँ न्ही बणवाया? <verse eid="1CH 17:6" /><verse number="7" style="v" sid="1CH 17:7" />आखर: इब तू मेरे दास दाऊद तै इसा कह, के सेनाओं का यहोवा न्यू कहवै सै, के मन्‍नै तो तेरै ताहीं भेड़शाला तै अर भेड़-बकरियाँ कै पाच्छै-पाच्छै फिरण तै इस इरादे तै बुला लिया, के तू मेरी प्रजा इस्राएल का प्रधान हो जावै; <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />अर जित्त किते तू आया अर गया, ओड़ै मै तेरै गैल रहया, अर तेरे सारे दुश्मनां ताहीं तेरै स्याम्ही तै नाश करया सै। इब मै तेरे नाम नै धरती के बड़े-बड़े माणसां के नाम्मां कै बराबर बड़ा कर दियुँगा। <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />अर मै अपणी प्रजा इस्राएल कै खात्तर एक जगहां ठहराऊँगा, अर उसनै स्थिर करुँगा ताके वो अपणी ए जगहां म्ह बसे रहवैं अर कदे घुमक्‍कड़ ना हो; अर कुटिल माणस उन ताहीं नाश ना करण पावैगें, जिसा के पैहले दिनां म्ह करैं थे, <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />बलके उस बखत भी जिब मै अपणी प्रजा इस्राएल कै उप्पर न्यायी ठहराऊँ था; आखर मै तेरे सारे दुश्मनां नै दबा दियुँगा। फेर मै तन्‍नै या भी बताऊँ सूं, के यहोवा तेरा घर बणाए राक्खैगा। <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />जिब तेरी उम्र पूरी हो ज्यागी अर तन्‍नै अपणे पितरां कै गैल जाणा पड़ैगा, फेर मै तेरै बाद तेरे वंश ताहीं जो तेरे बेट्टयाँ म्ह तै होगा, खड़या करकै उसके राज्य नै स्थिर करुँगा<note caller="+" style="f"><char style="fr" closed="false">17:11 </char><char style="ft" closed="false">1 राजा 2:10-11, 2 शमूएल 7:12</char></note>। <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />मेरै खात्तर एक घर वोए बणावैगा, अर मै उसकी राजगद्दी नै सदा स्थिर राखूँगा। <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />मै उसका पिता ठहरूँगा अर वो मेरा बेट्टा ठहरैगा; अर जिसी मन्‍नै अपणी करुणा उसपै तै जो तेरे तै पैहले था हटाई, उसे ढाळ मै उसपै तै ना हटाऊँगा<note caller="+" style="f"><char style="fr" closed="false">17:13 </char><char style="ft" closed="false">2 शमूएल 7:14</char></note>, <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />बलके मै उस ताहीं अपणे घर अर अपणे राज्य म्ह सदा स्थिर राखूँगा अर उसकी राजगद्दी सदा अटल रहवैगी।’” <verse eid="1CH 17:14" /><verse number="15" style="v" sid="1CH 17:15" />इन सारी बात्तां अर इस दर्शन कै मुताबिक नातान नै दाऊद ताहीं समझा दिया।<verse eid="1CH 17:15" /></para>
  <para style="s">दाऊद कै जरिये धन्यवाद की प्रार्थना</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />फेर दाऊद राजा भित्तर जाकै यहोवा के स्याम्ही बैठ्या, अर कहण लाग्या, “हे यहोवा परमेसवर! मै के सूं? अर मेरा घराना के सै? के तन्‍नै मेरै ताहीं उरै ताहीं पोहचाया सै? <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />हे परमेसवर! यो तेरी निगांह म्ह छोट्टी सी बात होई, क्यूँके तन्‍नै अपणे दास के घरान्‍ने कै बारै म्ह भविष्य के भोत दिनां ताहीं की चर्चा करी सै, अर हे यहोवा परमेसवर! तन्‍नै मेरै ताहीं ऊँच्‍चे पद<note caller="+" style="f"><char style="fr" closed="false">17:17 </char><char style="fq" closed="false">ऊँच्‍चे पद </char><char style="ft" closed="false">यानिके परमेसवर नै मेरे राज्य ताहीं सदा तक बणाकै मेरै ताहीं और माणसां तै ऊँच्‍चा उठ्या दिया सै जिसा के मै एक ऊँच्‍चा माणस सूं।</char></note> का माणस सा जाण्या सै। <verse eid="1CH 17:17" /><verse number="18" style="v" sid="1CH 17:18" />जो महिमा तेरे दास पै दिखाई गई सै, उसकै बारै म्ह दाऊद तेरे तै और के कह सकै सै? तू तो अपणे दास नै जाणै सै। <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />हे यहोवा! तन्‍नै अपणे दास कै निमित्त अर अपणे मन कै मुताबिक यो बड़ा काम करया सै, के तेरा दास उस ताहीं जाण ले। <verse eid="1CH 17:19" /><verse number="20" style="v" sid="1CH 17:20" />हे यहोवा! जो किमे मन्‍नै अपणे कान्‍नां तै सुण्या सै, उसकै मुताबिक तेरै बराबर कोए न्ही, अर ना तन्‍नै छोड़ और कोए परमेसवर सै। <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />फेर तेरी प्रजा इस्राएल कै भी तुल्य कौण सै? वो तो धरती भर म्ह एक ए जात सै, उस ताहीं परमेसवर नै जाकै अपणी खुद की प्रजा करण नै छुड़ाया, ज्यांतै के तू बड़े अर डरावणे काम करकै अपणा नाम करै, अर अपणी प्रजा कै स्याम्ही तै जो तन्‍नै मिस्र तै छुड़ा ली थी, जात-जात के माणसां नै लिकाड़ दे। <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />क्यूँके तन्‍नै अपणी प्रजा इस्राएल ताहीं अपणी सदा की प्रजा होण कै खात्तर ठैहराया, अर हे यहोवा! तू आप उसका परमेसवर ठहरया। <verse eid="1CH 17:22" /><verse number="23" style="v" sid="1CH 17:23" />ज्यांतै, इब हे यहोवा, तन्‍नै जो वचन अपणे दास के अर उसकै घरान्‍ने के बारै म्ह दिया सै, वो सदा अटल रहवै, अर अपणे वचन कै मुताबिक ए कर। <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />अर तेरा नाम सदा अटल रहवै, अर या कहकै तेरी बड़ाई सदा करी जावै<note caller="+" style="f"><char style="fr" closed="false">17:24 </char><char style="fq" closed="false">तेरी बड़ाई सदा करी जावै </char><char style="ft" closed="false">तेरा नाम स्थिर रहवै अर प्रतिष्ठित हो।</char></note>, के सेनाओं का यहोवा इस्राएल का परमेसवर सै, बलके वो इस्राएल ए कै खात्तर परमेसवर सै, अर तेरा दास दाऊद का घराना तेरै स्याम्ही स्थिर रहवै। <verse eid="1CH 17:24" /><verse number="25" style="v" sid="1CH 17:25" />क्यूँके हे मेरे परमेसवर, तन्‍नै या कहकै अपणे दास पै प्रगट करया सै के मै तेरा घर बणाए राखूँगा, इस कारण तेरे दास नै तेरै स्याम्ही प्रार्थना करण का होसला होया सै। <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />अर इब हे यहोवा तू ए परमेसवर सै, अर तन्‍नै अपणे दास ताहीं यो भलाई करण का वचन दिया सै; <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />अर इब तन्‍नै खुश होकै, अपणे दास के घरान्‍ने पै इसी आशीष दी सै, के वो तेरै सम्मुख सदा बण्या रहवै, क्यूँके हे यहोवा, तू आशीष दे चुक्या सै, ज्यांतै वो सदा आशिषित बण्या रहवै।”<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s">दाऊद की जीत का बखान</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />इसकै बाद दाऊद नै पलिश्तियाँ ताहीं जीत कै अपणे अधीन कर लिया, अर गाम समेत गत नगर ताहीं पलिश्तियाँ के हाथ तै छीन लिया। <verse eid="1CH 18:1" /><verse number="2" style="v" sid="1CH 18:2" />फेर उसनै मोआबियाँ ताहीं भी जीत लिया, अर मोआबी दाऊद कै अधीन होकै भेंट ल्याण लाग्गे।<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3" />फेर जिब सोबा का राजा हदादेजेर फरात महानद कै धोरै अपणे राज्य स्थिर करण नै जा रह्या था, फेर दाऊद नै उस ताहीं हमात कै लोवै जीत लिया। <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" />दाऊद नै उसतै एक हजार रथ, सात हजार सवार, अर बीस हजार प्यादे हर लिए, अर दाऊद नै सारे रथ आळे घोड़यां के घुटन्या कै पाच्छै की नस कटवाई, पर एक सौ रथ आळे घोड़े बचा राक्खे। <verse eid="1CH 18:4" /><verse number="5" style="v" sid="1CH 18:5" />जिब दमिश्क के अरामी, सोबा के राजा हदादेजेर की मदद करण ताहीं आए, फेर दाऊद नै अरामियां म्ह तै बाईस हजार माणस मारे। <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" />फेर दाऊद नै दमिश्क के अराम म्ह सिपाहियाँ की चौकियाँ बैठाई; आखर अरामी दाऊद कै अधीन होकै भेंट ल्याण लाग्गे। अर जित्त-जित्त दाऊद जान्दा, ओड़ै-ओड़ै यहोवा उसनै जय दिलावै था। <verse eid="1CH 18:6" /><verse number="7" style="v" sid="1CH 18:7" />अर हदादेजेर के कर्मचारियाँ कै धोरै सोन्‍ने की जो ढाल थी, उननै दाऊद लेकै यरुशलेम नै आया। <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" />अर हदादेजेर के तिभत अर कून नाम के नगरां तै दाऊद भोत सा पीतळ ले आया; अर उसे तै सुलैमान नै पीतळ के हौद अर खम्भ्यां अर पीतळ के बरतनां ताहीं बणवाया।<verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9" />जिब हमात के राजा तोऊ नै सुण्या के दाऊद नै सोबा के राजा हदादेजेर की सारी सेना ताहीं जीत लिया सै, <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />फेर उसनै हदोराम नाम के अपणे बेट्टे ताहीं दाऊद राजा कै धोरै उसका हाल-चाल पूछण अर उसतै बधाई देण नै भेज्या, ज्यांतै के उसनै हदादेजेर तै लड़कै उस ताहीं जीत लिया था; (क्यूँके हदादेजेर तोऊ तै लड़या करै था) अर हदोराम सोन्‍ने-चाँदी अर पीतळ के सारे ढाळ के बरतन लिये होए आया। <verse eid="1CH 18:10" /><verse number="11" style="v" sid="1CH 18:11" />इन ताहीं दाऊद राजा नै यहोवा कै खात्तर पवित्र करकै धरया, अर उसाए उस सोन्‍ने-चाँदी तै भी करया जिस ताहीं सारी जात्तां तै, यानिके एदोमियां, मोआबियाँ, अम्मोनियाँ, पलिश्तियाँ, अर अमालेकियाँ तै प्राप्त करया था।<verse eid="1CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12" />फेर सरूयाह के बेट्टे अबीशै नै नमक की तराई म्ह अठारह हजार एदोमियां ताहीं मार लिया। <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" />फेर उसनै एदोम म्ह सिपाहियाँ की चौकियाँ बैठाई; अर सारे एदोमी दाऊद कै अधीन हो गए। अर दाऊद जित्त-जित्त जावै था ओड़ै-ओड़ै यहोवा उसनै जय दिलावै था। <verse eid="1CH 18:13" /><verse number="14" style="v" sid="1CH 18:14" />दाऊद सारा इस्राएल पै राज करया करै था, अर वो अपणी सारी प्रजा कै गैल न्याय अर धार्मिकता के काम करया करै था। <verse eid="1CH 18:14" /><verse number="15" style="v" sid="1CH 18:15" />प्रधान सेनापति सरूयाह का बेट्टा योआब था; इतिहास का लिखण आळा अहीलूद का बेट्टा यहोशापात था; <verse eid="1CH 18:15" /><verse number="16" style="v" sid="1CH 18:16" />प्रधान याजक, अहीतूब का बेट्टा सादोक अर एब्यातार का बेट्टा अबीमेलेक थे, मंत्री<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="fq" closed="false">मंत्री </char><char style="ft" closed="false">शाही लेखक</char></note> शबशा था; <verse eid="1CH 18:16" /><verse number="17" style="v" sid="1CH 18:17" />करेतियां अर पलेतियां का प्रधान यहोयादा का बेट्टा बनायाह था; अर दाऊद के बेट्टे राजा कै धोरै प्रधान होकै रहवैं थे।<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s">अम्मोनियाँ पै जीत</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />इसकै बाद अम्मोनियाँ का राजा नाहाश मर ग्या, अर उसका बेट्टा उसकी जगहां पै राजा होया। <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" />फेर दाऊद नै यो सोच्या, “हानून के पिता नाहाश नै जो मेरे ताहीं प्रीति दिखाई थी, ज्यांतै मै भी उसपै प्रीति दिखाऊँगा।” फेर दाऊद नै उसके पिता कै बारै म्ह शान्ति देण खात्तर दूत भेज्जे। अर दाऊद के कर्मचारी अम्मोनियाँ के देश म्ह हानून कै धोरै उसतै शान्ति देण नै आए। <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />पर अम्मोनियाँ के हाकिम हानून तै कहण लाग्गे, “दाऊद नै जो तेरै धोरै शान्ति देण आळे भेज्जे सैं, वो के तेरी समझ म्ह तेरे पिता का आदर करण की मनसा तै भेज्जे सैं? के उसके कर्मचारी इसी मनसा तै तेरै धोरै न्ही आए, के ढूँढ़-ढाँढ़ करैं अर नाश करैं, अर देश का भेद लें?” <verse eid="1CH 19:3" /><verse number="4" style="v" sid="1CH 19:4" />ज्यांतै हानून नै दाऊद के कर्मचारियाँ ताहीं पकड्या, अर उनके बाळ मुँण्डवाए, अर आध्धे कपड़े यानिके नितम्ब ताहीं कटवाकै उन ताहीं जाण दिया। <verse eid="1CH 19:4" /><verse number="5" style="v" sid="1CH 19:5" />फेर कुछ माणसां नै जाकै दाऊद ताहीं बता दिया के उन आदमियाँ कै गैल किसा बरताव करया गया, आखर उसनै उन माणसां तै मिलण कै खात्तर माणसां ताहीं भेज्या क्यूँके वे माणस घणे शर्मिन्दा थे, अर राजा नै कह्या, “जिब तक थारी दाढ़ी बढ़ ना जावै, जिब ताहीं यरीहो म्ह ठैहरे रहो, अर बाद म्ह बोहड़ आणा।”<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6" />जिब अम्मोनियाँ नै देख्या, के हम दाऊद नै घिनोणे लाग्गां सां, फेर हानून अर अम्मोनियाँ नै एक हजार किक्‍कार चाँदी<note caller="+" style="f"><char style="fr" closed="false">19:6 </char><char style="fq" closed="false">एक हजार किक्‍कार चाँदी </char><char style="ft" closed="false">उस बखत पश्चिमी आसिया म्ह सैनिकां ताहीं किराए पै लेण की रीत थी।</char></note>, अरम्नहरैम अर अरम्माका अर सोबा ताहीं भेज्जी, के रथ अर सवार किराये पै बुलाए। <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />सो उन ताहीं बत्तीस हजार रथ, अर माका के राजा अर उसकी सेना ताहीं किराये पै बुलाया, अर इननै आकै मेदबा के स्याम्ही, अपणे डेरे खड़े करे। अर अम्मोनी अपणे-अपणे नगर म्ह तै कठ्ठे होकै लड़ण नै आए। <verse eid="1CH 19:7" /><verse number="8" style="v" sid="1CH 19:8" />यो सुणकै दाऊद नै योआब अर शूरवीरां की पूरी सेना ताहीं भेज्या। <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" />फेर अम्मोनी लिकड़े अर नगर के फाटक कै धोरै पाँति बाँधी, अर जो राजा आए थे, वे उनतै न्यारा मैदान म्ह थे।<verse eid="1CH 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10" />यो देखकै के आग्गै-पाच्छै दोन्‍नु ओड़ म्हारै बिरुध्द पाँति बंधी सैं, योआब नै सारे बड़े-बड़े इस्राएली वीरां म्ह तै कुछ ताहीं छाँटकै अरामियां कै स्याम्ही उनकी पाँति बँधाई; <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />अर बचे होए माणसां ताहीं अपणे भाई अबीशै कै हाथ सौंप दिया, अर उननै अम्मोनियाँ कै स्याम्ही पाँति बाँधी। <verse eid="1CH 19:11" /><verse number="12" style="v" sid="1CH 19:12" />अर उसनै कह्या, “जै अरामी मेरै पै हावी होण लाग्गे, तो तू मेरी मदद करणा; अर जै अम्मोनी तेरे पै हावी होण लाग्गे, तो मै तेरी मदद करुँगा। <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />तू हियाव बाँध अर हम सारे अपणे माणसां अर अपणे परमेसवर के नगरां कै निमित्त पुरुषार्थ करां; अर यहोवा जिसा उसनै आच्छा लाग्गै, उसाए करैगा।” <verse eid="1CH 19:13" /><verse number="14" style="v" sid="1CH 19:14" />फेर योआब अर जो माणस उसके गैल गये थे, अरामियां तै युद्ध करण नै उनकै स्याम्ही गए, अर वे उसकै स्याम्ही तै भाज्जे। <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" />यो देखकै के अरामी भाजगे सैं, अम्मोनी भी उसके भाई अबीशै कै स्याम्ही तै भाजकै नगर कै भित्तर घुसे। फेर योआब यरुशलेम नै बोहड़ आया।<verse eid="1CH 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16" />फेर यो देखकै के वे इस्राएलियाँ तै हार गए सैं, अरामियां नै दूत भेजकै फरात कै पार के अरामियां ताहीं बुलवाया, अर हदादेजेर के सेनापति शोपक ताहीं अपणा प्रधान बणाया। <verse eid="1CH 19:16" /><verse number="17" style="v" sid="1CH 19:17" />इसकी खबर पाकै दाऊद नै सारे इस्राएलियाँ ताहीं कठ्ठा करया, अर यरदन पार होकै उनपै चढ़ाई करी अर उनकै बिरुध्द पाँति बँधाई, फेर वे उसतै लड़ण लाग्गे। <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" />पर अरामी इस्राएलियाँ तै भाज्जे, अर दाऊद नै उन म्ह तै सात हजार रथियाँ अर चाळीस हजार प्यादां ताहीं मार गेरया, अर शोपक सेनापति ताहीं भी मार गेरया। <verse eid="1CH 19:18" /><verse number="19" style="v" sid="1CH 19:19" />या देखकै के वे इस्राएलियाँ तै हार गए सैं, हदादेजेर के कर्मचारियाँ नै दाऊद तै संधि करी अर उसकै अधीन होगे; अर अरामियां नै अम्मोनियाँ की मदद फेर करणी ना चाही।<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s">रब्‍बाह पै जीत</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />फेर नये साल के शरुआत म्ह जिब राजे युद्ध करण नै लिकड़या करैं सैं, फेर योआब नै भारी सेना गैल ले जाकै अम्मोनियाँ का देश उजाड़ दिया अर आकै रब्‍बाह ताहीं घेर लिया; पर दाऊद यरुशलेम म्ह रह गया; अर योआब नै रब्‍बाह ताहीं जीत कै ढ़ा दिया<note caller="+" style="f"><char style="fr" closed="false">20:1 </char><char style="ft" closed="false">2 शमूएल 11:1</char></note>। <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" />फेर दाऊद नै उनके राजा का मुकुट<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="fq" closed="false">उनके राजा का मुकुट </char><char style="ft" closed="false">अम्मोनी देवता, मिल्कोम की मूर्ति के सिर तै</char></note> उसकै सिर तै उतारकै के देख्या, के उसका तौल किक्‍कार भर सोन्‍ने का सै, अर उस म्ह मणि भी जड़े थे; अर वो दाऊद कै सिर पै धरया गया। फेर उस नगर तै घणा सामान लूट म्ह मिल्या। <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />उसनै उन म्ह रहण आळयां ताहीं लिकाड़कै आरयां अर लोहे के गेत्ती अर कुल्हाड़ियां तै कटवाया; अर अम्मोनियाँ के सारे नगरां कै गैल भी दाऊद नै उसाए करया। फेर दाऊद सारे माणसां समेत यरुशलेम नै बोहड़ गया।<verse eid="1CH 20:3" /></para>
  <para style="s">पलिश्ती दानवां का नाश</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />इसकै बाद गेजेर म्ह पलिश्तियाँ कै गैल युद्ध होया; उस बखत हूशाई सिब्बकै<note caller="+" style="f"><char style="fr" closed="false">20:4 </char><char style="fq" closed="false">सिब्बकै </char><char style="ft" closed="false">इस नाम का मतलब सै परमेसवर सुधि लेवै सै, वो दाऊद की सेना के शूरवीरां म्ह तै एक था।</char></note> नै सिप्पै ताहीं, जो रपाई की सन्तान था, मार गेरया; अर वे दब गए। <verse eid="1CH 20:4" /><verse number="5" style="v" sid="1CH 20:5" />पलिश्तियाँ कै गैल फेर युद्ध होया; उस म्ह याईर के बेट्टे एल्हनान नै गती गोलियत के भाई लहमी ताहीं मार गेरया, जिसके बर्छे की छड़, जुलाहे की डोंगी के बराबर थी। <verse eid="1CH 20:5" /><verse number="6" style="v" sid="1CH 20:6" />फेर गत म्ह भी युद्ध होया, अर ओड़ै एक बड़े डील-डोल का माणस था, जो रापा की सन्तान था, अर उसके एक-एक हाथ-पैर म्ह छः-छः उगंळियां यानिके सारी मिलाकै चौबीस उगंळियां थी। <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />जिब उसनै इस्राएलियाँ ताहीं ललकारया, फेर दाऊद के भाई शिमा के बेट्टे योनातान नै उस ताहीं मारया। <verse eid="1CH 20:7" /><verse number="8" style="v" sid="1CH 20:8" />येए गत म्ह रापा तै पैदा होए थे, अर वे दाऊद अर उसके सैनिकां के हाथ तै मार गेरे गए।<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s">दाऊद कै जरिये इस्राएल की जनगणना</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />अर एक दिन शैतान<note caller="+" style="f"><char style="fr" closed="false">21:1 </char><char style="fq" closed="false">शैतान </char><char style="ft" closed="false">उरै पैहली बार शैतान का नाम म्हारै स्याम्ही आवै सै। उरै वो माणस ताहीं बाहर तै नुकसान पोहचाण आळा दुश्मन मात्र ए न्ही बलके मन म्ह पाप करण अर विचार करण के जरिये उसके विनाश की परीक्षा ल्याण आळा सै।</char></note> नै इस्राएल कै खिलाफ उठकै, दाऊद ताहीं उकसाया के इस्राएलियाँ की गिणती ले। <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" />फेर दाऊद नै योआब अर प्रजा के हाकिमां तै कह्या, “थम जाकै बेर्शेबा तै ले दान ताहीं के इस्राएल की गिणती लेकै मेरै ताहीं बताओ, कै मै जाण लूँ के वे कितणे सैं।” <verse eid="1CH 21:2" /><verse number="3" style="v" sid="1CH 21:3" />योआब नै कह्या, “यहोवा की प्रजा के कितणे ए क्यूँ ना हों, वो उन ताहीं सौ गुणा बढ़ा दे; पर हे मेरे प्रभु! हे राजा! के वे सारे राजा कै अधीन न्ही सैं? मेरा प्रभु इसी बात क्यूँ चाहवै सै? वो इस्राएल पै दोष लागण का कारण क्यूँ बणै?” <verse eid="1CH 21:3" /><verse number="4" style="v" sid="1CH 21:4" />फेर भी राजा का हुकम योआब पै प्रबल होया। फेर योआब विदा होकै सारे इस्राएल म्ह घूमकै यरुशलेम नै बोहड़ आया। <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" />फेर योआब नै प्रजा की गिणती का जोड़, दाऊद तै सुणाया अर सारे तलवार चलाण आळे माणस इस्राएल के तो ग्यारह लाख, अर यहूदा के च्यार लाख सत्तर हजार ठैहरे। <verse eid="1CH 21:5" /><verse number="6" style="v" sid="1CH 21:6" />पर उन म्ह योआब नै लेवी अर बिन्‍यामीन ताहीं ना गिण्या, क्यूँके वो राजा के हुकम तै घृणा करैं था<verse eid="1CH 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 21:7" />अर दाऊद का यो हुकम परमेसवर नै बुरी लाग्या, ज्यांतै उसनै इस्राएल ताहीं मारया। <verse eid="1CH 21:7" /><verse number="8" style="v" sid="1CH 21:8" />अर दाऊद नै परमेसवर तै कह्या, “यो काम जो मन्‍नै करया, वो महापाप सै। पर इब अपणे दास का अधर्म दूर कर; मेरे तै तो बड़ी बेकूफी होई सै।” <verse eid="1CH 21:8" /><verse number="9" style="v" sid="1CH 21:9" />फेर यहोवा नै दाऊद के दर्शी गाद तै कह्या, <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />“जाकै दाऊद तै कह, ‘यहोवा यो कहवै सै कै मै तेरै ताहीं तीन विपत्तियाँ दिखाऊँ सूं, उन म्ह तै एक नै चुण ले, के मै उसनै तेरै पै गेरू।’” <verse eid="1CH 21:10" /><verse number="11" style="v" sid="1CH 21:11" />फेर गाद नै दाऊद कै धोरै जाकै उसतै कह्या, “यहोवा न्यू कहवै सै, के जिस ताहीं तू चावै उसनै चुण ले : <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />या तो तीन साल का अकाळ पड़े; या तीन महिन्‍ने तक तेरे बिरोधी तन्‍नै नाश करदे रहवै, अर तेरे दुश्मनां की तलवार तेरे पै चाल्दी रहवै; या तीन दिन तक यहोवा की तलवार चाल्‍ले, यानिके मरी देश म्ह फैल्‍लै अर यहोवा का दूत इस्राएली देश म्ह च्यांरु ओड़ विनाश करदा रहवै। इब सोच, के मै अपणे भेज्जणआळे तै के जवाब देऊँ।” <verse eid="1CH 21:12" /><verse number="13" style="v" sid="1CH 21:13" />दाऊद नै गाद तै कह्या, “मै बड़े संकट म्ह पड़या सूं; मै यहोवा कै हाथ म्ह पड़ूँ, क्यूँके उसकी दया भोत बड़ी सै; पर माणस कै हाथ म्ह मेरै ताहीं पड़णा ना पड़ै।”<verse eid="1CH 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14" />फेर यहोवा नै इस्राएल म्ह मरी फैलाई, अर इस्राएल म्ह सत्तर हजार माणस मर मिटे। <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" />फेर परमेसवर नै एक दूत यरुशलेम ताहीं भी उसका नाश करण नै भेज्या; अर वो नाश करणे ए पै था, के यहोवा दुःख देण तै दुखी होया, अर नाश करण आळे दूत तै कह्या, “बस कर; इब अपणा हाथ खींच ले।” अर यहोवा का दूत यबूसी ओर्नान के खलिहाण कै धोरै खड़या था। <verse eid="1CH 21:15" /><verse number="16" style="v" sid="1CH 21:16" />अर दाऊद नै नजर ठाकै देख्या के यहोवा का दूत हाथ म्ह खींची होई अर यरुशलेम कै उप्पर बढाई होई एक तलवार लिये होए अकास कै बीच खड़या सै, फेर दाऊद अर अगुवे टाट<note caller="+" style="f"><char style="fr" closed="false">21:16 </char><char style="fq" closed="false">टाट </char><char style="ft" closed="false">टाट बकरियाँ के बाळां तै बण्या एक मोटा कपड़ा होवै था, जो शोक या संकट के इशारे के रूप म्ह पैहरया जावै था।</char></note> पहरे होए मुँह कै बळ गिरे। <verse eid="1CH 21:16" /><verse number="17" style="v" sid="1CH 21:17" />फेर दाऊद नै परमेसवर तै कह्या, “जिसनै प्रजा की गिणती लेण का हुकम दिया था, के वो मै न्ही सूं? हाँ, जिसनै पाप करया अर घणी बुराई करी सै, वो तो मै ए सूं। पर इन भेड़-बकरियाँ नै के करया सै? ज्यांतै हे मेरे परमेसवर यहोवा! तेरा हाथ मेरे पिता के कुण्बे कै बिरुध्द हो, पर तेरी प्रजा के बिरुध्द ना हो, के वे मारे जावैं।”<verse eid="1CH 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />फेर यहोवा के दूत<note caller="+" style="f"><char style="fr" closed="false">21:18 </char><char style="fq" closed="false">यहोवा के दूत </char><char style="ft" closed="false">बेशक सुर्गदूत परमेसवर अर माणस कै बिचाळै सन्देस का जरिये‌ नियुक्त करे गए थे। उरै गाद सुर्गदूत तो परमेसवर की इच्छा जाणै सै।</char></note> नै गाद ताहीं दाऊद तै या कहण का हुकम दिया के दाऊद चढ़कै यबूसी ओर्नान कै खलिहाण म्ह यहोवा की एक वेदी बणावै। <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" />गाद के इस वचन कै मुताबिक जो उसनै यहोवा के नाम तै कह्या था, दाऊद चढ़ ग्या। <verse eid="1CH 21:19" /><verse number="20" style="v" sid="1CH 21:20" />फेर ओर्नान नै पाच्छै फिरकै दूत ताहीं देख्या, अर उसके च्यांरु बेट्टे जो उसकै गैल थे छिप गए, ओर्नान तो गेहूँ काढै था। <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" />जिब दाऊद ओर्नान के धोरै आया, फेर ओर्नान नै नजर करकै दाऊद ताहीं देख्या अर खलिहाण तै बाहर जाकै धरती ताहीं झुककै दाऊद ताहीं दण्डवत करया। <verse eid="1CH 21:21" /><verse number="22" style="v" sid="1CH 21:22" />फेर दाऊद नै ओर्नान तै कह्या, “इस खलिहाण की जगहां मन्‍नै दे दे, के मै इसपै यहोवा कै खात्तर एक वेदी बणाऊँ, उसका पूरा दाम लेकै उसनै मेरै ताहीं दे, के या बिप्दा प्रजा पै तै दूर करी जावै।” <verse eid="1CH 21:22" /><verse number="23" style="v" sid="1CH 21:23" />ओर्नान नै दाऊद तै कह्या, “इसनै ले ले, अर मेरे प्रभु राजा नै जो कुछ भावै वो वाए करै; सुण, मै तन्‍नै होमबलि कै खात्तर बळध अर ईधण कै खात्तर दाँवने के हथियार अर अन्‍नबलि कै खात्तर गेहूँ, यो सारे मै देऊँ सूं।” <verse eid="1CH 21:23" /><verse number="24" style="v" sid="1CH 21:24" />राजा दाऊद नै ओर्नान तै कह्या, “ना, मै जरुर इसका पूरा दाम ए देकै इसनै मोल ल्यूँगा; जो तेरा सै, उसनै मै यहोवा कै खात्तर ना ल्यूँगा, अर ना मुफ्त का होमबलि चढ़ाऊँगा।” <verse eid="1CH 21:24" /><verse number="25" style="v" sid="1CH 21:25" />फेर दाऊद नै उस जगहां कै खात्तर ओर्नान ताहीं छः सौ शेकेल सोन्‍ना<note caller="+" style="f"><char style="fr" closed="false">21:25 </char><char style="fq" closed="false">छः सौ शेकेल सोन्‍ना </char><char style="ft" closed="false">लगभग सात किलो सोन्‍ना</char></note> तौलकै दिया। <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" />फेर दाऊद नै ओड़ै यहोवा की एक वेदी बणाई अर होमबलि अर मेलबलि चढ़ाकै यहोवा तै प्रार्थना करी, अर उसनै होमबलि की वेदी पै सुर्ग तै आग गिराकै उसकी सुण ली। <verse eid="1CH 21:26" /><verse number="27" style="v" sid="1CH 21:27" />फेर यहोवा नै दूत तै हुकम दिया; अर उसनै अपणी तलवार फेर म्यान म्ह कर ली।<verse eid="1CH 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 21:28" />यो देखकै के यहोवा नै यबूसी ओर्नान के खलिहाण म्ह मेरी सुण ली सै, दाऊद नै उसे बखत ओड़ै बलिदान करया। <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" />यहोवा का निवास जो मूसा नै जंगळ म्ह बणाया था, अर होमबलि की वेदी, ये दोन्‍नु उस बखत गिबोन के ऊँच्‍ची जगहां पै थे। <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />पर दाऊद परमेसवर कै धोरै उसकै स्याम्ही ना जा सक्या, क्यूँके वो यहोवा के दूत की तलवार<note caller="+" style="f"><char style="fr" closed="false">21:30 </char><char style="fq" closed="false">दूत की तलवार </char><char style="ft" closed="false">यो जाणदे होए के उस वेदी पै भेंट चढ़ाण कै कारण दाऊद नै सुर्गदूत का हाथ रोक लिया, अत: वो अपणी भेंट नै किते और ले जाण तै डर ग्या था इसा ना हो के सुर्गदूत फेर अपणा काम करैं अर महामारी फैल जा।</char></note> तै डर ग्या था।<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1" />फेर दाऊद कहण लाग्या, “यहोवा परमेसवर का भवन<note caller="+" style="f"><char style="fr" closed="false">22:1 </char><char style="fq" closed="false">यहोवा परमेसवर का भवन </char><char style="ft" closed="false">सुर्गदूत का प्रगट होणा अर सुर्ग तै आग गिरणा, इन दोन्‍नु चमत्कारां नै दाऊद ताहीं बिश्वास दिला दिया था के यहोवा के घर का पूर्व निर्धारित जगहां वोए सै जित्त उसका बेट्टा भविष्यवाणी कै मुताबिक भवन बणावैगा।</char></note> योए सै, अर इस्राएल कै खात्तर होमबलि की वेदी योए सै।”<verse eid="1CH 22:1" /></para>
  <para style="s">मन्दर के बणाण की तैयारी</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />फेर दाऊद नै इस्राएल के देश म्ह जो परदेशी थे उन ताहीं कठ्ठा करण का हुकम दिया, अर परमेसवर का भवन बणाण ताहीं पत्थर गढ़ण कै खात्तर संगतराश ठहरा दिए। <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" />फेर दाऊद नै फाटकां के किवाड़ां की कील्‍लां अर जोड़ां कै खात्तर भोत सा लोहा, अर तौल तै बाहर घणाए पीतळ, <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />अर गिणती तै बाहर देवदार के पेड़ कठ्ठे करये; क्यूँके सीदोन अर सोर के माणस दाऊद कै धोरै भोत-से देवदार के पेड़ ल्याये थे। <verse eid="1CH 22:4" /><verse number="5" style="v" sid="1CH 22:5" />अर दाऊद नै कह्या, “मेरा बेट्टा सुलैमान सुकुमार अर छोरा सै, अर जो भवन यहोवा कै खात्तर बणाणा सै, उस ताहीं अत्यन्त तेजोमय अर सारे देशां म्ह प्रसिद्ध अर शोभायमान होणा चाहिये; ज्यांतै मै उसकै खात्तर तैयारी करुँगा।” आखर दाऊद नै मरण तै पैहल्या घणी त्यारी करी।<verse eid="1CH 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6" />फेर उसनै अपणे बेट्टे सुलैमान ताहीं बुलाकै इस्राएल के परमेसवर यहोवा कै खात्तर भवन बणाण का हुकम दिया। <verse eid="1CH 22:6" /><verse number="7" style="v" sid="1CH 22:7" />दाऊद नै अपणे बेट्टे सुलैमान तै कह्या, “मेरी मनसा तो थी के अपणे परमेसवर यहोवा के नाम का एक भवन बणाऊँ। <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />पर यहोवा का यो वचन मेरै गैल पोहच्या, ‘तन्‍नै लहू घणाए बहाया अर बड़े-बड़े युद्ध करे सैं, ज्यांतै तू मेरै नाम का भवन ना बणाण पावैगा, क्यूँके तन्‍नै धरती पै मेरी नजर म्ह घणाए लहू बहाया सै। <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />देख, तेरै तै एक बेट्टा पैदा होवैगा, जो शान्त माणस होवैगा; अर मै उसनै च्यांरु और के दुश्मनां तै शान्ति दियुँगा; उसका नाम तो सुलैमान होवैगा, अर उसके दिनां म्ह मै इस्राएल ताहीं शान्ति अर चैन दियुँगा। <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />वो मेरै नाम का भवन बणावैगा। अर वो मेरा बेट्टा ठहरैगा अर मै उसका पिता ठहरूँगा, अर उसकी राजगद्दी नै मै इस्राएल कै उप्पर सदा खात्तर स्थिर राखूँगा।’ <verse eid="1CH 22:10" /><verse number="11" style="v" sid="1CH 22:11" />इब हे मेरे बेट्टे, यहोवा तेरै गैल रहवै, अर तू सिध्द होकै उस वचन कै मुताबिक जो तेरे परमेसवर यहोवा नै तेरै बारै म्ह कह्या सै, उसका भवन बणाणा। <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" />इब यहोवा तन्‍नै बुद्धि अर समझ दे अर इस्राएल का अधिकारी ठहरा दे, अर तू अपणे परमेसवर यहोवा के नियम-कायदे नै मानदा रहवै। <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />तू जिब ए सफल होगा जिब उन विधियाँ अर नियमां पै चालण की चौकसी करैगा, जिनके हुकम यहोवा नै इस्राएल कै खात्तर मूसा तै दिये थे। होसला राख अर मजबूत हो।<note caller="+" style="f"><char style="fr" closed="false">22:13 </char><char style="fq" closed="false">होसला राख अर मजबूत हो। </char><char style="ft" closed="false">इस्राएलियाँ अर यहोशू तै कहे गए शब्दां का इस्तमाल उरै दाऊद करण लागरया सै।</char></note> डरै ना; अर तेरा मन कच्‍चा ना हो। <verse eid="1CH 22:13" /><verse number="14" style="v" sid="1CH 22:14" />सुण, मन्‍नै अपणे क्ळेश कै बखत<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="fq" closed="false">क्ळेश कै बखत </char><char style="ft" closed="false">दाऊद अपणे राज्यकाल की अनेक मुश्किलां ताहीं दोष दे रहता सै जिनकै कारण वो घणा भण्डार कठ्ठा करण म्ह कामयाब न्ही हो पाया था।</char></note> यहोवा के भवन कै खात्तर एक लाख किक्‍कार सोन्‍ना, अर दस लाख किक्‍कार चाँदी, अर पीतळ अर लोहा इतणा कठ्ठा करया सै, के बहुतायत कै कारण तौल तै बाहर सै; अर लाकड़ी अर पत्थर मन्‍नै कठ्ठे करें सैं, अर तू उन ताहीं बढ़ा सकैगा। <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />अर तेरै धोरै घणे कारीगर सैं, यानिके पत्थर अर लाकड़ी के काटण अर गढ़ण आळे बलके सारे ढाळ के काम कै खात्तर सारे ढाळ के प्रवीण माणस सैं। <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />सोन्‍ना, चाँदी, पीतळ अर लोहे की तो किमे गिणती न्ही सै, सो तू उस काम म्ह लाग जा! यहोवा तेरै गैल लगातार रहवै।”<verse eid="1CH 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17" />फेर दाऊद नै इस्राएल के सारे हाकिमां ताहीं अपणे बेट्टे सुलैमान की मदद करण का हुकम या कहकै दिया, <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" />“के थारा परमेसवर यहोवा थारै गैल न्ही सै? के उसनै थारै च्यांरु ओड़ तै विश्राम न्ही दिया? उसनै तो देश के निवासियां ताहीं मेरै वश म्ह कर दिया सै; अर देश यहोवा अर उसकी प्रजा कै स्याम्ही दब्या होया सै। <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />इब तन-मन तै अपणे परमेसवर यहोवा कै धोरै जाया करो, अर जी लगाकै यहोवा परमेसवर की पवित्र जगहां बणाणा, के थम यहोवा की वाचा का सन्दूक अर परमेसवर के पवित्र बरतन उस भवन म्ह ल्याओ जो यहोवा के नाम का बणण आळा सै।”<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="s">लेवियाँ ताहीं जिम्मेदारियांँ बाट्या जाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />दाऊद तो बूढ़ा बलके घणाए बूढ़ा होग्या था, ज्यांतै उसनै अपणे बेट्टे सुलैमान ताहीं इस्राएल पै राजा नियुक्त कर दिया। <verse eid="1CH 23:1" /><verse number="2" style="v" sid="1CH 23:2" />फेर उसनै इस्राएल के सारे हाकिमां अर याजकां अर लेवियाँ ताहीं कठ्ठा करया। <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />जितने लेवीय तीस साल के अर उसतै घणी उम्र के थे, वे गिणे गए, अर एक-एक आदमी के गिणन तै उनकी गिणती अड़तीस हजार होई<note caller="+" style="f"><char style="fr" closed="false">23:3 </char><char style="ft" closed="false">गिनती 4:3,23,30</char></note>। <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />इन म्ह तै चौबीस हजार तो यहोवा के भवन का काम चलाण कै खात्तर नियुक्त होए, अर छः हजार सरदार अर न्यायी। <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />अर च्यार हजार द्वारपाल नियुक्त होए, अर च्यार हजार उन बाजां तै यहोवा की स्तुति करण कै खात्तर ठहराए गए जो दाऊद नै स्तुति करण कै खात्तर बणाए थे। <verse eid="1CH 23:5" /><verse number="6" style="v" sid="1CH 23:6" />फेर दाऊद नै उन ताहीं गेर्शोन, कहात अर मरारी नाम के लेवी के बेट्टयाँ कै मुताबिक दलां म्ह न्यारे-न्यारे कर दिये।<verse eid="1CH 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 23:7" />गेर्शोनियाँ म्ह तै तो लादान अर शिमी थे। <verse eid="1CH 23:7" /><verse number="8" style="v" sid="1CH 23:8" />अर लादान के बेट्टे: सरदार यहीएल, फेर जेताम अर योएल ये तीन थे। <verse eid="1CH 23:8" /><verse number="9" style="v" sid="1CH 23:9" />शिमी के बेट्टे: शलोमीत, हजीएल अर हारान ये तीन थे। लादान के कुल के पूर्वजां के घरान्यां के खास आदमी येए थे। <verse eid="1CH 23:9" /><verse number="10" style="v" sid="1CH 23:10" />फेर शिमी के बेट्टे: यहत, जीना, यूश, अर बरीआ, शिमी के ये च्यार बेट्टे थे। <verse eid="1CH 23:10" /><verse number="11" style="v" sid="1CH 23:11" />यहत खास था, अर जीजा दूसरा; यूश अर बरीआ के घणे बेट्टे ना होए, इस कारण वे सारे मिलकै पितरां का एक ए घराना ठैहरे।<verse eid="1CH 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 23:12" />कहात के बेट्टे: अम्राम, यिसहार, हेब्रोन अर उज्जीएल च्यार। अम्राम के बेट्टे: हारुन अर मूसा। <verse eid="1CH 23:12" /><verse number="13" style="v" sid="1CH 23:13" />हारुन तो ज्यांतै न्यारा करया गया, के वो अर उसकी सन्तान सदा परमपवित्र चिज्जां ताहीं पवित्र ठहरावै, अर सदा यहोवा के धोरै धूप जळाया करैं अर उसकी सेवा पाणी करैं, अर उसके नाम तै आशीर्वाद दिया करै। <verse eid="1CH 23:13" /><verse number="14" style="v" sid="1CH 23:14" />पर परमेसवर के भगत मूसा के बेट्यां के नाम लेवी के गोत्र कै बीच म्ह गिणे गए। <verse eid="1CH 23:14" /><verse number="15" style="v" sid="1CH 23:15" />मूसा के बेट्टे, गेर्शोम अर एलीएजेर<note caller="+" style="f"><char style="fr" closed="false">23:15 </char><char style="ft" closed="false">निर्गमन 18:3-4</char></note>। <verse eid="1CH 23:15" /><verse number="16" style="v" sid="1CH 23:16" />अर गेर्शोम का बेट्टा शबूएल खास था। <verse eid="1CH 23:16" /><verse number="17" style="v" sid="1CH 23:17" />एलीएजेर के बेट्टे: रहब्याह खास; अर एलीएजेर के और कोए बेट्टा ना होया, पर रहब्याह के घणे बेट्टे होए। <verse eid="1CH 23:17" /><verse number="18" style="v" sid="1CH 23:18" />यिसहार के बेट्टयाँ म्ह तै शलोमीत खास ठहरया। <verse eid="1CH 23:18" /><verse number="19" style="v" sid="1CH 23:19" />हेब्रोन के बेट्टे: यरिय्याह खास, दूसरा अमर्याह, तीसरा यहजीएल, अर चौथा यकमाम। <verse eid="1CH 23:19" /><verse number="20" style="v" sid="1CH 23:20" />उज्जीएल के बेट्टयाँ म्ह तै खास तो मीका अर दूसरा यिश्शिय्याह था।<verse eid="1CH 23:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 23:21" />मरारी के बेट्टे: महली अर मूशी। महली के बेट्टे: एलीआजर अर कीश। <verse eid="1CH 23:21" /><verse number="22" style="v" sid="1CH 23:22" />एलीआजर बिना छोरयां के मर ग्या, उसकै सिर्फ बेटियाँ होई; आखर कीश के बेट्टे नै जो उनके भाई थे उन ताहीं ब्याह लिया। <verse eid="1CH 23:22" /><verse number="23" style="v" sid="1CH 23:23" />मूशी के बेट्टे: महली; एदेर अर यरेमोत ये तीन थे।<verse eid="1CH 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 23:24" />लेवीय पितरां के घरान्यां के खास आदमी येए थे, ये नाम ले-लेकै, एक-एक आदमी करकै गिणे गए, अर बीस साल की या उसतै घणी उम्र के थे अर यहोवा के भवन म्ह सेवा पाणी करैं थे। <verse eid="1CH 23:24" /><verse number="25" style="v" sid="1CH 23:25" />क्यूँके दाऊद नै कह्या, “इस्राएल के परमेसवर यहोवा नै अपणी प्रजा ताहीं आराम दिया सै, के वे यरुशलेम म्ह सदा रह सकै। <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" />अर लेवियाँ ताहीं निवास अर उसकी उपासना का सामान फेर उठाणा न्ही पड़ैगा।” <note caller="+" style="f"><char style="fr" closed="false">23:26 </char><char style="ft" closed="false">गिनती 1:50-53, 3:21-37, 4:15; व्यवस्थाविवरण 10:8 </char></note> <verse eid="1CH 23:26" /><verse number="27" style="v" sid="1CH 23:27" />क्यूँके दाऊद के पिछले हुकम<note caller="+" style="f"><char style="fr" closed="false">23:27 </char><char style="fq" closed="false">दाऊद के पिछले हुकम </char><char style="ft" closed="false">किमे कै विचार म्ह यो उसके राज्यकाल के उत्तरकालीन युग की ऐतिहासिक रचना सै, हो सकै सै गाद या नातान जरिये रचित (1 इति. 27:24, 1 इति. 29:29) दुसरयां के विचार म्ह उसनै पवित्र जगहां म्ह सेवा के निर्देशन लिखकै धर दिए थे।</char></note> के मुताबिक बीस साल या उसतै घणी उम्र के लेवीय गिणे गए। <verse eid="1CH 23:27" /><verse number="28" style="v" sid="1CH 23:28" />क्यूँके उनका काम तो हारुन की सन्तान की सेवा पाणी करणा था, यानिके यो के वे आँगणां अर कोठड़ियाँ म्ह, अर सारी पवित्र चिज्जां के शुद्ध करण म्ह अर परमेसवर के भवन की उपासना के सारे काम्मां म्ह सेवा पाणी करै; <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />अर भेंट की रोट्टी का, अन्‍नबलियाँ के मैद्दे का, अर अखमीरी पापड़ियाँ का, अर तवे पै बणाए होए अर सणे होए का, अर मापण अर तौलण के सारी तरियां का काम करैं। <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />अर रोज सबेरै अर रोज शाम ताहीं यहोवा का धन्यवाद अर उसकी स्तुति करण कै खात्तर खड़े रहया करैं। <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />अर विश्रामदिनां अर नये चाँद के दिनां, अर नियत त्यौहारां म्ह गिणती के नियम कै मुताबिक रोज यहोवा के सारे होमबलियाँ नै चढ़ावैं<note caller="+" style="f"><char style="fr" closed="false">23:31 </char><char style="fq" closed="false">सारे होमबलियाँ नै चढ़ावैं </char><char style="ft" closed="false">तोभी लेवियाँ नै बलि चढ़ाण की इजाजत न्ही थी, अनेक अवसर इसे थे जिब वे बलि चढ़ाण म्ह पुरोहितां नै योगदान देवैं थे।</char></note>; <verse eid="1CH 23:31" /><verse number="32" style="v" sid="1CH 23:32" />अर यहोवा के भवन की उपासना कै बारै मिलापआळे तम्बू अर पवित्र जगहां की हिफाजत करै, अर अपणे भाई हारुनियां के सौंपे होए काम नै चौकसी तै करै<note caller="+" style="f"><char style="fr" closed="false">23:32 </char><char style="ft" closed="false">गिनती 18:3-5</char></note>।<verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="s">याजकां की जिम्मेदारियांँ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />फेर हारुन की सन्तान के दल ये थे। हारुन के बेट्टे तो नादाब, अबीहू, एलीआजर अर ईतामार थे। <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" />पर नादाब अर अबीहू अपणे पिता हारुन कै स्याम्ही बिना छोरयां के मर गए, ज्यांतै याजक का काम एलीआजर अर ईतामार करया करैं थे<note caller="+" style="f"><char style="fr" closed="false">24:2 </char><char style="ft" closed="false">लैव्यवस्था 10:1-2 अर गिनती 3:4 </char></note>। <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" />अर दाऊद नै एलीआजर कै वंश के सादोक अर ईतामार के वंश<note caller="+" style="f"><char style="fr" closed="false">24:3 </char><char style="fq" closed="false">सादोक अर ईतामार के वंश </char><char style="ft" closed="false">सादोक अर अहीमेलेक नै पुरोहितीयदायित्वों ताहीं त्यार करण म्ह दाऊद की मदद करी थी, जिस तरियां के दलां के प्रधानां नै गायकां ताहीं दलां म्ह बाँट्टण म्ह उसकी मदद करी थी।</char></note> के अहीमेलेक की मदद तै उन ताहीं अपणी-अपणी सेवा कै मुताबिक दल-दल करकै बाँट दिया। <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />एलीआजर कै वंश के खास आदमी, ईतामार कै वंश के खास आदमियाँ तै घणे थे, अर वे इस्से बाँटे गए: यानिके एलीआजर कै वंश के पितरां के घरान्यां के सोलह, अर ईतामार कै वंश के पितरां के घरान्यां के आठ खास आदमी थे। <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />फेर वे चिट्ठी गेरकै बराबर-बराबर बाँटे गए, क्यूँके एलीआजर अर ईतामार दोन्‍नु के वंशां म्ह पवित्र जगहां के हाकिम अर परमेसवर के हाकिम ठहराए होए थे। <verse eid="1CH 24:5" /><verse number="6" style="v" sid="1CH 24:6" />अर नतनेल के बेट्टे शमायाह जो शास्त्री अर लेवीय था, उनके नाम राजा अर हाकिमां अर सादोक याजक, अर एब्यातार के बेट्टे अहीमेलेक अर याजकां अर लेवियाँ के पितरां के घरान्यां के खास आदमियाँ कै स्याम्ही लिखे; यानिके पितरां का एक घरान्‍नां तो एलीआजर कै वंश म्ह तै अर एक ईतामार कै वंश म्ह तै लिया गया।<verse eid="1CH 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 24:7" />पैहली चिट्ठी तो यहोयारीब के, अर दुसरी यदायाह, <verse eid="1CH 24:7" /><verse number="8" style="v" sid="1CH 24:8" />तीसरी हारीम के, चौथी सोरीम के, <verse eid="1CH 24:8" /><verse number="9" style="v" sid="1CH 24:9" />पाँचमी मल्किय्याह के, छठवीं मिय्यामीन के, <verse eid="1CH 24:9" /><verse number="10" style="v" sid="1CH 24:10" />सातवीं हक्‍कोस के, आठवीं अबिय्याह के<note caller="+" style="f"><char style="fr" closed="false">24:10 </char><char style="ft" closed="false">लूका 1:5</char></note>, <verse eid="1CH 24:10" /><verse number="11" style="v" sid="1CH 24:11" />नौवीं येशू के, दसवीं शकन्याह के, <verse eid="1CH 24:11" /><verse number="12" style="v" sid="1CH 24:12" />ग्यारहवीं एल्याशीब के, बारहवीं याकीम के, <verse eid="1CH 24:12" /><verse number="13" style="v" sid="1CH 24:13" />तेरहवीं हुप्पा के, चौदहवीं येसेबाब के, <verse eid="1CH 24:13" /><verse number="14" style="v" sid="1CH 24:14" />पन्द्रहवीं बिल्गा के, सोलहवीं इम्मेर के, <verse eid="1CH 24:14" /><verse number="15" style="v" sid="1CH 24:15" />सत्रहवीं हेजीर के, अठारहवीं हप्पित्सेस के, <verse eid="1CH 24:15" /><verse number="16" style="v" sid="1CH 24:16" />उन्‍नीसवीं पतह्याह के, बीसवीं यहेजकेल के, <verse eid="1CH 24:16" /><verse number="17" style="v" sid="1CH 24:17" />इक्‍कीसवीं याकीन के, बाईसवीं गामूल के, <verse eid="1CH 24:17" /><verse number="18" style="v" sid="1CH 24:18" />तेईसवीं दलायाह के, अर चौबीसवीं माज्याह के नाम पै लिकड़ी। <verse eid="1CH 24:18" /><verse number="19" style="v" sid="1CH 24:19" />उनकी सेवकाई कै खात्तर उनका योए नियम ठहराया गया के वे अपणे उस नियम कै मुताबिक जो इस्राएल के परमेसवर यहोवा का हुकम कै मुताबिक उनके मूलपुरुष हारुन नै चलाया था, यहोवा के भवन म्ह जाया करैं।<verse eid="1CH 24:19" /></para>
  <para style="s">अन्य लेवी</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 24:20" />बचे होए लेवियाँ म्ह तै अम्राम कै वंश म्ह तै शूबाएल, शूबाएल कै वंश म्ह तै येहदयाह। <verse eid="1CH 24:20" /><verse number="21" style="v" sid="1CH 24:21" />बच्या रहब्याह, आखर रहब्याह, कै वंश म्ह तै यिश्शिय्याह खास था। <verse eid="1CH 24:21" /><verse number="22" style="v" sid="1CH 24:22" />यिसहारियाँ म्ह तै शलोमोत अर शलोमोत कै वंश म्ह तै यहत। <verse eid="1CH 24:22" /><verse number="23" style="v" sid="1CH 24:23" />हेब्रोन कै वंश म्ह तै खास तो यरिय्याह, दूसरा अमर्याह, तीसरा यहजीएल, अर चौथा यकमाम। <verse eid="1CH 24:23" /><verse number="24" style="v" sid="1CH 24:24" />उज्जीएल कै वंश म्ह तै मीका अर मीका कै वंश म्ह तै शामीर। <verse eid="1CH 24:24" /><verse number="25" style="v" sid="1CH 24:25" />मीका का भाई यिश्शिय्याह, यिश्शिय्याह कै वंश म्ह तै जकर्याह। <verse eid="1CH 24:25" /><verse number="26" style="v" sid="1CH 24:26" />मरारी के बेट्टे महली अर मूशी अर याजिय्याह का बेट्टा बिनो था। <verse eid="1CH 24:26" /><verse number="27" style="v" sid="1CH 24:27" />मरारी के बेट्टे: याजिय्याह तै बिनो अर शोहम, जक्‍कूर अर इब्री थे। <verse eid="1CH 24:27" /><verse number="28" style="v" sid="1CH 24:28" />महली तै, एलीआजर जिसकै कोए बेट्टा ना था। <verse eid="1CH 24:28" /><verse number="29" style="v" sid="1CH 24:29" />कीश तै कीश कै वंश म्ह यरहमेल। <verse eid="1CH 24:29" /><verse number="30" style="v" sid="1CH 24:30" />अर मूशी के बेट्टे, महली, एदेर अर यरीमोत। अपणे-अपणे पितरां के घरान्यां कै मुताबिक येए लेवीय सन्तान के थे। <verse eid="1CH 24:30" /><verse number="31" style="v" sid="1CH 24:31" />इननै भी अपणे भाई हारुन की सन्तान की तरह दाऊद राजा अर सादोक अर अहीमेलेक अर याजकां अर लेवियाँ के पितरां कै घरान्यां के खास आदमियाँ के स्याम्ही चिट्ठियाँ डाली, यानिके खास आदमी के पितरां का घरान्‍नां उसके छोट्टे भाई के पितरां के घरान्‍ने कै बराबर ठहरया।<note caller="+" style="f"><char style="fr" closed="false">24:31 </char><char style="fq" closed="false">खास आदमी के पितरां का घरान्‍नां उसके छोट्टे भाई के पितरां के घरान्‍ने कै बराबर ठहरया। </char><char style="ft" closed="false">यानिके समस्त लेवीय परिवारां की गिणती चिट्ठियाँ के जरिये बराबर शर्तां पै करी गई के वे के सेवा करैंगे। खास आदमियाँ के घरान्यां नै छोट्टे भाई के घरान्यां तै घणा कुछ फायदा न्ही था।</char></note><verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s">दाऊद के संगीतकार</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />फेर दाऊद अर सेनापतियाँ नै आसाप, हेमान अर यदूतून के कुछ बेट्टयाँ ताहीं सेवकाई कै खात्तर न्यारा करया के वे वीणा, सारंगी अर झाँझ बजा-बजाकै नबूवत करैं। अर इस सेवकाई के काम करण आळे माणसां की गिणती या थी: <verse eid="1CH 25:1" /><verse number="2" style="v" sid="1CH 25:2" />यानिके आसाप के च्यार बेट्टयाँ म्ह तै जक्‍कूर, यूसुफ, नतन्याह अर अशरेला, आसाप के ये बेट्टे आसाप ए के हुकम म्ह थे, जो राजा के हुकम कै मुताबिक नबूवत करै था<note caller="+" style="f"><char style="fr" closed="false">25:2 </char><char style="fq" closed="false">राजा के हुकम कै मुताबिक नबूवत करै था </char><char style="ft" closed="false">यानिके, आसाप के हुकमां के मुताबिक “जो खुद भविष्यवाणी करया करै था यो पवित्र सेवा करया करै था।”</char></note>। <verse eid="1CH 25:2" /><verse number="3" style="v" sid="1CH 25:3" />फेर यदूतून के छ: बेट्टयाँ म्ह तै गदल्याह, सरी, यशायाह, शिमी, हशब्याह, मत्तित्याह, येए छः अपणे पिता यदूतून के हुकम म्ह होकै जो यहोवा का धन्यवाद अर स्तुति करकै नबूवत करया करै था, वीणा बजावै थे। <verse eid="1CH 25:3" /><verse number="4" style="v" sid="1CH 25:4" />हेमान के बेट्टयाँ म्ह तै, बुक्‍किय्याह, मत्तन्याह, उज्जीएल, शबूएल, यरीमोत, हनन्याह, हनानी, एलीआता, गिद्दलती, रोममतीएजेर, योशबकाशा, मल्‍लोती, होतीर अर महजीओत; <verse eid="1CH 25:4" /><verse number="5" style="v" sid="1CH 25:5" />परमेसवर के वायदे कै मुताबिक जो उसका नाम बढ़ाण की<note caller="+" style="f"><char style="fr" closed="false">25:5 </char><char style="fq" closed="false">नाम बढ़ाण की </char><char style="ft" closed="false">परमेसवर नै हेमान का वंश बढ़ाया या उसतै चौदाह बेट्टे अर तीन बेटियाँ देकै उसका आदर-मान बढ़ाया।</char></note> थी, ये सारे हेमान के बेट्टे थे जो राजा का दर्शी था; क्यूँके परमेसवर नै हेमान ताहीं चौदाह बेट्टे अर तीन बेटियाँ दी थी। <verse eid="1CH 25:5" /><verse number="6" style="v" sid="1CH 25:6" />ये सारे उसके बेट्टे यहोवा के भवन म्ह गाण खात्तर अपणे-अपणे पिता कै अधीन रहकै, परमेसवर के भवन, की सेवकाई म्ह झाँझ, सारंगी अर वीणा बजावै थे। आसाप, यदूतून अर हेमान राजा कै अधीन रहवैं थे। <verse eid="1CH 25:6" /><verse number="7" style="v" sid="1CH 25:7" />इन सारया की गिणती भाईयाँ समेत<note caller="+" style="f"><char style="fr" closed="false">25:7 </char><char style="fq" closed="false">भाईयाँ समेत </char><char style="ft" closed="false">यानिके लेवी गोत्र के अन्य सदस्यां कै गैल। आसाप का हरेक बेट्टा यदूतून अर हेमान बारहा-बारहा प्रवीण संगीतकारां के दल के मुखिया थे, इन दलां म्ह उसके अपणे बेट्टे अर और परिवारां के सदस्य थे।</char></note> जो यहोवा के गीत सीखे होए अर सारे ढाळ तै होशियार थे, दो सौ अट्ठासी थे। <verse eid="1CH 25:7" /><verse number="8" style="v" sid="1CH 25:8" />उन ताहीं के बड़ा, के छोट्टा, के गुरु, के चेल्‍ला, अपणी-अपणी बारी कै खात्तर चिट्ठी डाली।<verse eid="1CH 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 25:9" />पैहली चिट्ठी आसाप के बेट्यां म्ह तै यूसुफ कै नाम पै लिकड़ी, दुसरी गदल्याह के नाम पै लिकड़ी, जिसके बेट्टे अर भाई उस समेत बारहा थे। <verse eid="1CH 25:9" /><verse number="10" style="v" sid="1CH 25:10" />तीसरी जक्‍कूर कै नाम पै लिकड़ी, जिसके बेट्टे अर भाई उस समेत बारहा थे। <verse eid="1CH 25:10" /><verse number="11" style="v" sid="1CH 25:11" />चौथी यिस्री कै नाम पै लिकड़ी, जिसके बेट्टे अर भाई उस समेत बारहा थे। <verse eid="1CH 25:11" /><verse number="12" style="v" sid="1CH 25:12" />पाँचमी नतन्याह कै नाम पै लिकड़ी, जिसके बेट्टे अर भाई उस समेत बारहा थे। <verse eid="1CH 25:12" /><verse number="13" style="v" sid="1CH 25:13" />छटी बुक्‍किय्याह कै नाम पै लिकड़ी जिसके बेट्टे अर भाई उस समेत बारहा थे। <verse eid="1CH 25:13" /><verse number="14" style="v" sid="1CH 25:14" />सातवीं यसरेला कै नाम पै लिकड़ी, जिसके बेट्टे अर भाई उस समेत बारहा थे। <verse eid="1CH 25:14" /><verse number="15" style="v" sid="1CH 25:15" />आठवीं यशायाह कै नाम पै लिकड़ी जिसके बेट्टे अर भाई उस समेत बारहा थे। <verse eid="1CH 25:15" /><verse number="16" style="v" sid="1CH 25:16" />नौवीं मत्तन्याह कै नाम पै लिकड़ी, जिसके बेट्टे अर भाई समेत बारहा थे। <verse eid="1CH 25:16" /><verse number="17" style="v" sid="1CH 25:17" />दसवीं शिमी कै नाम पै लिकड़ी, जिसके बेट्टे अर भाई उस समेत बारहा थे। <verse eid="1CH 25:17" /><verse number="18" style="v" sid="1CH 25:18" />ग्यारहवीं अजरेल कै नाम पै लिकड़ी जिसके बेट्टे अर भाई उस समेत बारहा थे। <verse eid="1CH 25:18" /><verse number="19" style="v" sid="1CH 25:19" />बारहवीं हशब्याह कै नाम पै लिकड़ी, जिसके बेट्टे अर भाई उस समेत बारहा थे। <verse eid="1CH 25:19" /><verse number="20" style="v" sid="1CH 25:20" />तेरहवीं शूबाएल कै नाम पै लिकड़ी, जिसके बेट्टे अर भाई उस समेत बारहा थे। <verse eid="1CH 25:20" /><verse number="21" style="v" sid="1CH 25:21" />चौदहवीं मत्तित्याह कै नाम पै लिकड़ी, जिसके बेट्टे अर भाई उस समेत बारहा थे। <verse eid="1CH 25:21" /><verse number="22" style="v" sid="1CH 25:22" />पन्द्रहवीं यरेमोत कै नाम पै लिकड़ी, जिसके बेट्टे अर भाई उस समेत बारहा थे। <verse eid="1CH 25:22" /><verse number="23" style="v" sid="1CH 25:23" />सोलहवीं हनन्याह कै नाम पै लिकड़ी, जिसके बेट्टे अर भाई उस समेत बारहा थे। <verse eid="1CH 25:23" /><verse number="24" style="v" sid="1CH 25:24" />सत्रहवीं योशबकाशा कै नाम पै लिकड़ी जिसके बेट्टे अर भाई उस समेत बारहा थे। <verse eid="1CH 25:24" /><verse number="25" style="v" sid="1CH 25:25" />अठारहवीं हनानी कै नाम पै लिकड़ी, जिसके बेट्टे अर भाई उस समेत बारहा थे। <verse eid="1CH 25:25" /><verse number="26" style="v" sid="1CH 25:26" />उन्‍नीसवीं मल्‍लोती कै नाम पै लिकड़ी, जिसके बेट्टे अर भाई उस समेत बारहा थे। <verse eid="1CH 25:26" /><verse number="27" style="v" sid="1CH 25:27" />बीसवीं एलियातह कै नाम पै लिकड़ी, जिसके बेट्टे अर भाई उस समेत बारहा थे। <verse eid="1CH 25:27" /><verse number="28" style="v" sid="1CH 25:28" />इक्‍कीसवीं होतीर कै नाम पै लिकड़ी, जिसके बेट्टे अर भाई उस समेत बारहा थे। <verse eid="1CH 25:28" /><verse number="29" style="v" sid="1CH 25:29" />बाईसवीं गिद्दलती कै नाम पै लिकड़ी, जिसके बेट्टे अर भाई उस समेत बारहा थे। <verse eid="1CH 25:29" /><verse number="30" style="v" sid="1CH 25:30" />तेईसवीं महजीओत; कै नाम पै लिकड़ी जिसके बेट्टे अर भाई उस समेत बारहा थे। <verse eid="1CH 25:30" /><verse number="31" style="v" sid="1CH 25:31" />चौबीसवीं चिट्ठी रोममतीएजेर कै नाम पै लिकड़ी, जिसके बेट्टे अर भाई उस समेत बारहा थे।<verse eid="1CH 25:31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" sid="1CH 26" />
  <para style="s">मन्दर के द्वारपाल</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 26:1" />फेर पैहरेदारां के दल ये थे कोरहियाँ म्ह तै तो मशेलेम्याह, जो कोरे का बेट्टा अर आसाप के सन्तानां म्ह तै था। <verse eid="1CH 26:1" /><verse number="2" style="v" sid="1CH 26:2" />अर मशेलेम्याह कै बेट्टे होए, यानिके उसका जेठ्ठा जकर्याह दूसरा यदीएल, तीसरा जबद्याह, <verse eid="1CH 26:2" /><verse number="3" style="v" sid="1CH 26:3" />चौथा यातनीएल, पाँचवाँ एलाम, छठवाँ यहोहानान अर सातवाँ एल्यहोएनै। <verse eid="1CH 26:3" /><verse number="4" style="v" sid="1CH 26:4" />फेर ओबेदेदोम<note caller="+" style="f"><char style="fr" closed="false">26:4 </char><char style="fq" closed="false">ओबेदेदोम </char><char style="ft" closed="false">ओबेदेदोम अर होसा (1 इति. 26:10) द्वारपाल थे यरुशलेम म्ह वाचा का सन्दूक ल्याण कै बखत तै ए वे द्वारपाल थे। (1 इति. 15:2, 1 इति. 16:38)</char></note> कै भी बेट्टे होए, उसका जेठ्ठा शमायाह, दूसरा यहोजाबाद, तीसरा योआह, चौथा साकार, पाँचवाँ नतनेल, <verse eid="1CH 26:4" /><verse number="5" style="v" sid="1CH 26:5" />छठवाँ अम्मीएल, सातवाँ इस्साकार अर आठवाँ पुल्‍लतै, क्यूँके परमेसवर नै उस ताहीं आशीष दी थी। <verse eid="1CH 26:5" /><verse number="6" style="v" sid="1CH 26:6" />अर ओबेदेदोम के जेठ्ठे बेट्टे शमायाह कै भी बेट्टे पैदा होए, जो शूरवीर होण कै कारण अपणे पिता के कुण्बे पै प्रभुता करै थे। <verse eid="1CH 26:6" /><verse number="7" style="v" sid="1CH 26:7" />शमायाह के बेट्टे ये थे, यानिके ओतनी, रपाएल, ओबेद, एलजाबाद अर उनके भाई एलीहू अर समक्याह ताकतवर माणस थे। <verse eid="1CH 26:7" /><verse number="8" style="v" sid="1CH 26:8" />यो सारे ओबेदेदोम की सन्तानां म्ह तै थे, वे अर उनके बेट्टे अर भाई इस सेवकाई कै खात्तर बलवान अर शक्तिमान थे; ये ओबेदेदोमी बासठ थे। <verse eid="1CH 26:8" /><verse number="9" style="v" sid="1CH 26:9" />मशेलेम्याह के बेट्टे अर भाई अठारह थे, जो बलवान थे। <verse eid="1CH 26:9" /><verse number="10" style="v" sid="1CH 26:10" />फेर मरारी कै वंश म्ह तै होसा के भी बेट्टे थे, यानिके खास तो शिम्री (जिस ताहीं जेठ्ठा ना होण पै भी उसके पिता नै खास ठैहराया), <verse eid="1CH 26:10" /><verse number="11" style="v" sid="1CH 26:11" />दूसरा हिल्किय्याह, तीसरा तबल्याह अर चौथा जकर्याह था; होसा के सारे बेट्टे अर भाई मिलकै तेरह थे।<verse eid="1CH 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 26:12" />द्वारपालां के दल इन खास आदमियाँ के थे, ये अपणे भाईयाँ कै बराबर ए यहोवा के भवन म्ह सेवा पाणी करया करै थे। <verse eid="1CH 26:12" /><verse number="13" style="v" sid="1CH 26:13" />इननै के छोट्टे, के बड़े, अपणे-अपणे पितरां के घरान्यां कै मुताबिक एक-एक फाटक कै खात्तर चिट्ठी डाली। <verse eid="1CH 26:13" /><verse number="14" style="v" sid="1CH 26:14" />पूर्व की और की चिट्ठी शेलेम्याह कै नाम पै लिकड़ी। फेर उन ताहीं उसके बेट्टे जकर्याह कै नाम की चिट्ठी डाली (वो बुद्धिमान मंत्री था) अर चिट्ठी उत्तर खात्तर लिकड़ी। <verse eid="1CH 26:14" /><verse number="15" style="v" sid="1CH 26:15" />दक्षिण की खात्तर ओबेदेदोम कै नाम पै चिट्ठी लिकड़ी, अर उसके बेट्यां के नाम पै खजाने की कोठड़ी खात्तर। <verse eid="1CH 26:15" /><verse number="16" style="v" sid="1CH 26:16" />फेर शुप्पीम अर होसा के नाम्मां की चिट्ठी पश्चिम की खात्तर लिकड़ी, के वे शल्‍लेकेत नाम के फाटक कै धोरै चढ़ाई की सड़क पै आम्ही-स्याम्ही चौकीदारी<note caller="+" style="f"><char style="fr" closed="false">26:16 </char><char style="fq" closed="false">आम्ही-स्याम्ही चौकीदारी </char><char style="ft" closed="false">होसा कै धोरै आराधनालय का पश्चिमी द्वार अर स्याम्ही की बाहरी दीवार का शल्‍लेकेत द्वार का जिम्मेदारी था। इस तरियां उस ताहीं दोहरी निगरानी करणी थी एक कै उप्पर एक।</char></note> करया करैं। <verse eid="1CH 26:16" /><verse number="17" style="v" sid="1CH 26:17" />पूर्व की और तो छः लेवीय थे, उत्तर की और रोज च्यार, दक्षिण की और रोज च्यार, अर खजाने की कोठड़ी कै धोरै दो ठैहरे। <verse eid="1CH 26:17" /><verse number="18" style="v" sid="1CH 26:18" />पश्चिम की और के पर्बार नाम की जगहां पै ऊँच्‍ची सड़क कै धोरै तो च्यार अर पर्बार कै धोरै दो रहे। <verse eid="1CH 26:18" /><verse number="19" style="v" sid="1CH 26:19" />ये द्वारपालां के दल थे, जिन म्ह तै कितणे तो कोरह के अर किमे मरारी के वंश के थे।<verse eid="1CH 26:19" /></para>
  <para style="s">मन्दर के भण्डारी और अन्य सेवाएँ</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20" />फेर लेवियाँ म्ह तै अहिय्याह परमेसवर के भवन अर पवित्र करी होई चिज्जां, दोन्‍नु के भण्डारां का अधिकारी नियुक्त होया। <verse eid="1CH 26:20" /><verse number="21" style="v" sid="1CH 26:21" />ये लादान की सन्तान के थे, यानिके गेर्शोनियाँ की सन्तान जो लादान के कुल के थे, यानिके लादान अर गेर्शोनी के पितरां के घरान्यां के खास आदमी थे, यानिके यहोएली।<verse eid="1CH 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 26:22" />यहोएली के बेट्टे ये थे, यानिके जेताम अर उसका भाई योएल जो यहोवा के भवन के खजाने के अधिकारी थे। <verse eid="1CH 26:22" /><verse number="23" style="v" sid="1CH 26:23" />अम्रामियाँ, यिसहारियाँ, हेब्रोनियाँ अर उज्जीएलियाँ म्ह तै। <verse eid="1CH 26:23" /><verse number="24" style="v" sid="1CH 26:24" />शबूएल जो मूसा के बेट्टे गेर्शोम के वंश का था, वो खजान्यां का खास अधिकारी था। <verse eid="1CH 26:24" /><verse number="25" style="v" sid="1CH 26:25" />अर उसके भाईयाँ का वृत्तान्त यो सै: एलीएजेर कै कुल म्ह उसका बेट्टा रहब्याह, रहब्याह का बेट्टा यशायाह, यशायाह का बेट्टा योराम, योराम का बेट्टा जिक्री, अर जिक्री का बेट्टा शलोमोत था। <verse eid="1CH 26:25" /><verse number="26" style="v" sid="1CH 26:26" />योए शलोमोत अपणे भाईयाँ समेत उन सारी पवित्र करी होई चिज्जां के भण्डारां का अधिकारी था, जो राजा दाऊद अर पितरां के घरान्यां के खास-खास आदमियाँ अर सहस्त्रपतियां अर शतपतियाँ अर खास सेनापतियाँ नै पवित्र करी थी। <verse eid="1CH 26:26" /><verse number="27" style="v" sid="1CH 26:27" />जो लूट लड़ाईयाँ म्ह मिलै थी, उस म्ह तै उननै यहोवा का भवन मजबूत करण कै खात्तर कुछ पवित्र करया। <verse eid="1CH 26:27" /><verse number="28" style="v" sid="1CH 26:28" />बल्के जितना शमूएल दर्शी, कीश के बेट्टे शाऊल, नेर के बेट्टे अब्नेर, अर सरूयाह के बेट्टे योआब नै पवित्र करया था, अर जो कुछ जिस किसे नै पवित्र कर राख्या था, वो सारा शलोमोत अर उसके भाईयाँ के हक म्ह था। <verse eid="1CH 26:28" /><verse number="29" style="v" sid="1CH 26:29" />यिसहारियाँ म्ह तै कनन्याह अर उसके बेट्टे, इस्राएल के देश का काम यानिके सरदार अर न्यायी का काम करण कै खात्तर नियुक्त होए। <verse eid="1CH 26:29" /><verse number="30" style="v" sid="1CH 26:30" />अर हेब्रोनियाँ म्ह तै हशब्याह अर उसके भाई जो सत्रह सौ बलवान माणस थे, वे यहोवा के सारे काम<note caller="+" style="f"><char style="fr" closed="false">26:30 </char><char style="fq" closed="false">सारे काम </char><char style="ft" closed="false">जिस म्ह दशमांश लेणा, मुक्तिदान अर अपणी इच्छा तै दान शामिल थे।</char></note> अर राजा की सेवा के बारै यरदन के पश्चिम ओड़ रहणआळे इस्राएलियाँ के अधिकारी ठैहरे। <verse eid="1CH 26:30" /><verse number="31" style="v" sid="1CH 26:31" />हेब्रोनियाँ म्ह तै यरिय्याह खास था, यानिके हेब्रोनियाँ की पीढ़ी-पीढ़ी के पितरां के घरान्यां कै मुताबिक दाऊद के राज्य के चाळीसवें साल म्ह वे ढूँढ़े गए, अर उन म्ह तै कई शूरवीर गिलाद के याजेर म्ह मिले। <verse eid="1CH 26:31" /><verse number="32" style="v" sid="1CH 26:32" />उसके भाई जो वीर थे, पितरां के घरान्यां कै दो हजार सात सौ खास आदमी थे, इन ताहीं दाऊद राजा नै परमेसवर के सारे विषयों अर राजा कै बारै म्ह रूबेनियाँ, गादियाँ अर मनश्शे के आध्धे गोत्र का अधिकारी ठहराया।<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" sid="1CH 27" />
  <para style="s">देश का प्रबन्ध</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 27:1" />इस्राएलियाँ की गिणती, यानिके पितरां के घरान्यां के खास-खास आदमियाँ अर सहस्‍त्रपतियाँ अर शतपतियाँ अर उनके सरदारां की गिणती जो साल भर के महीन्‍ने-महीन्‍ने उपस्थित होण अर छुट्टी पाण आळे दलां के थे अर सारे विषयों म्ह राजा की सेवा पाणी करया करैं थे, एक-एक दल म्ह चौबीस हजार थे।<verse eid="1CH 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 27:2" />पैहले महिन्‍ने कै खात्तर पैहले दल का अधिकारी जब्दीएल का बेट्टा याशोबाम<note caller="+" style="f"><char style="fr" closed="false">27:2 </char><char style="fq" closed="false">याशोबाम </char><char style="ft" closed="false">वो दाऊद के वीरां का प्रधान था अर यहूदा के गोत्र का सदस्य था।</char></note> नियुक्त होया; अर उसके दल म्ह चौबीस हजार थे। <verse eid="1CH 27:2" /><verse number="3" style="v" sid="1CH 27:3" />वो पेरेस के वंश का था अर पैहले महिन्‍ने म्ह सारे सेनापतियाँ का अधिकारी था। <verse eid="1CH 27:3" /><verse number="4" style="v" sid="1CH 27:4" />दुसरे महिन्‍ने के दल का अधिकारी दोदै नाम का एक अहोही था, अर उसके दल का प्रधान मिक्लोत था, अर उसके दल म्ह चौबीस हजार थे। <verse eid="1CH 27:4" /><verse number="5" style="v" sid="1CH 27:5" />तीसरे महिन्‍ने कै खात्तर तीसरा सेनापति यहोयादा याजक का बेट्टा बनायाह था अर उसके दल म्ह चौबीस हजार थे। <verse eid="1CH 27:5" /><verse number="6" style="v" sid="1CH 27:6" />यो वोए बनायाह सै, जो तीसों शूरां म्ह वीर, अर तीसों म्ह श्रेष्ठ भी था; अर उसके दल म्ह उसका बेट्टा अम्मीजाबाद था। <verse eid="1CH 27:6" /><verse number="7" style="v" sid="1CH 27:7" />चौथे महिन्‍ने कै खात्तर चौथा सेनापति योआब का भाई असाहेल था, अर उसकै बाद उसका बेट्टा जबद्याह था अर उसके दल म्ह चौबीस हजार थे। <verse eid="1CH 27:7" /><verse number="8" style="v" sid="1CH 27:8" />पाँचवें महिन्‍ने कै खात्तर पाँचवाँ सेनापति यिज्राही शम्हूत था अर उसके दल म्ह चौबीस हजार थे। <verse eid="1CH 27:8" /><verse number="9" style="v" sid="1CH 27:9" />छठवें महिन्‍ने कै खात्तर छठवाँ सेनापति तकोई इक्‍केश का बेट्टा ईरा था अर उसके दल म्ह चौबीस हजार थे। <verse eid="1CH 27:9" /><verse number="10" style="v" sid="1CH 27:10" />सातवें महिन्‍ने कै खात्तर सातवाँ सेनापति एप्रैम के वंश का हेलेस पलोनी था अर उसके दल म्ह चौबीस हजार थे। <verse eid="1CH 27:10" /><verse number="11" style="v" sid="1CH 27:11" />आठवें महिन्‍ने कै खात्तर आठवाँ सेनापति जेरह के वंश म्ह तै हूशाई सिब्बकै था अर उसके दल म्ह चौबीस हजार थे। <verse eid="1CH 27:11" /><verse number="12" style="v" sid="1CH 27:12" />नौवें महिन्‍ने कै खात्तर नौवां सेनापति बिन्‍यामीनी अबीएजेर अनातोतवासी था अर उसके दल म्ह चौबीस हजार थे। <verse eid="1CH 27:12" /><verse number="13" style="v" sid="1CH 27:13" />दसवें महिन्‍ने कै खात्तर दसमां सेनापति जेरही महरै नतोपावासी था अर उसके दल म्ह चौबीस हजार थे। <verse eid="1CH 27:13" /><verse number="14" style="v" sid="1CH 27:14" />ग्यारहवें महिन्‍ने कै खात्तर ग्यारहवाँ सेनापति एप्रैम के वंश का बनायाह पिरातोनवासी था अर उसके दल म्ह चौबीस हजार थे। <verse eid="1CH 27:14" /><verse number="15" style="v" sid="1CH 27:15" />बारहवें महिन्‍ने कै खात्तर बारहवां सेनापति ओत्नीएल के वंश का हेल्दै नतोपावासी था अर उसके दल म्ह चौबीस हजार थे। <verse eid="1CH 27:15" /><verse number="16" style="v" sid="1CH 27:16" />फेर इस्राएली गोत्रां के ये अधिकारी थे: यानिके रूबेनियाँ का प्रधान जिक्री का बेट्टा एलीएजेर; शिमोनियां म्ह तै माका का बेट्टा शपत्याह; <verse eid="1CH 27:16" /><verse number="17" style="v" sid="1CH 27:17" />लेवी तै कमूएल का बेट्टा हशब्याह; हारुन की सन्तान का सादोक; <verse eid="1CH 27:17" /><verse number="18" style="v" sid="1CH 27:18" />यहूदा का एलीहू नाम का दाऊद का एक भाई, इस्साकार तै मीकाएल का बेट्टा ओम्री; <verse eid="1CH 27:18" /><verse number="19" style="v" sid="1CH 27:19" />जबूलून तै ओबद्याह का बेट्टा यिशमायाह, नप्ताली तै अज्रीएल का बेट्टा यरीमोत; <verse eid="1CH 27:19" /><verse number="20" style="v" sid="1CH 27:20" />एप्रैम तै अजज्याह का बेट्टा होशे, मनश्शे तै आध्धे गोत्र का, पदायाह का बेट्टा योएल; <verse eid="1CH 27:20" /><verse number="21" style="v" sid="1CH 27:21" />गिलाद म्ह आध्धे गोत्र मनश्शे तै जकर्याह का बेट्टा इद्दो, बिन्‍यामीन तै अब्नेर का बेट्टा यासीएल; <verse eid="1CH 27:21" /><verse number="22" style="v" sid="1CH 27:22" />अर दान तै यरोहाम का बेट्टा अजरेल प्रधान ठहरया। येए इस्राएल के गोत्रां के हाकिम थे। <verse eid="1CH 27:22" /><verse number="23" style="v" sid="1CH 27:23" />पर दाऊद नै उनकी गिणती बीस साल की उम्र कै नीच्‍चै ना करी, क्यूँके यहोवा नै इस्राएल की गिणती अकास के तारयां कै बराबर बढ़ाण खात्तर कह्या था<note caller="+" style="f"><char style="fr" closed="false">27:23 </char><char style="ft" closed="false">उत्पत्ति 15.5; 22:17; 26:4</char></note>। <verse eid="1CH 27:23" /><verse number="24" style="v" sid="1CH 27:24" />सरूयाह का बेट्टा योआब गिणती लेण लाग्या, पर निपटा न्ही सक्या क्यूँके परमेसवर का छो इस्राएल पै भड़क्या, अर या गिणती राजा दाऊद कै इतिहास म्ह न्ही लिक्खी गई<note caller="+" style="f"><char style="fr" closed="false">27:24 </char><char style="fq" closed="false">इतिहास म्ह न्ही लिक्खी गई </char><char style="ft" closed="false">जनगणना के परिणामस्वरूप जो विनाश आया उसतै हो सकै सै उन म्ह यो भावना पैदा होई के सरकारी अभिलेखां म्ह इसका ब्यौरा व्यक्त करण पै परमेसवर और घणा क्रोधित होवैगा।</char></note>। <verse eid="1CH 27:24" /><verse number="25" style="v" sid="1CH 27:25" />फेर अदीएल का बेट्टा अज्मावेत राज भण्डारां का अधिकारी था, अर देहात अर नगरां अर गाम्मां अर गढां के भण्डारां का अधिकारी उज्जियाह का बेट्टा यहोनातान था। <verse eid="1CH 27:25" /><verse number="26" style="v" sid="1CH 27:26" />अर जो धरती नै जोतकै बोकै खेत्ती करया करैं थे, उनका अधिकारी कलूब का बेट्टा एज्री था। <verse eid="1CH 27:26" /><verse number="27" style="v" sid="1CH 27:27" />अर दाख की बारियां का अधिकारी रामाई नगर की शिमी अर दाख की बारियां की उपज जो दाखमधु के भण्डारां म्ह धरण खात्तर थी, उसका अधिकारी शापामी जब्दी था। <verse eid="1CH 27:27" /><verse number="28" style="v" sid="1CH 27:28" />अर नीच्‍चै के देश के जैतून अर गूलर के दरखतां का अधिकारी गदेरी नगर का बाल्हानान था अर तेल के भण्डारां का अधिकारी योआश था। <verse eid="1CH 27:28" /><verse number="29" style="v" sid="1CH 27:29" />अर शारोन<note caller="+" style="f"><char style="fr" closed="false">27:29 </char><char style="fq" closed="false">शारोन </char><char style="ft" closed="false">शारोन “शारोन के मैदान” ताहीं दर्शावै सै, जो भूमध्य सागर तट के गैल कर्मेल पहाड़ के दक्षिण म्ह एक उपजाऊ मैदान सै।</char></note> म्ह चरण आळे गां-बळधां का अधिकारी शारोनी शित्रै था अर तराइयां के गां-बळधां का अधिकारी अदलै का बेट्टा शापात था। <verse eid="1CH 27:29" /><verse number="30" style="v" sid="1CH 27:30" />अर ऊँटां का अधिकारी इश्माएली ओबील<note caller="+" style="f"><char style="fr" closed="false">27:30 </char><char style="fq" closed="false">ओबील </char><char style="ft" closed="false">हिब्रू नाम ओबील का मतलब सै ऊँट चलाण आळा।</char></note> अर गधियाँ का अधिकारी मेरोनोतवासी येहदयाह। <verse eid="1CH 27:30" /><verse number="31" style="v" sid="1CH 27:31" />अर भेड़-बकरियाँ का अधिकारी हग्री याजीज था। येए सारे राजा दाऊद की धन-सम्पत्ति के अधिकारी थे। <verse eid="1CH 27:31" /><verse number="32" style="v" sid="1CH 27:32" />अर दाऊद का भतीजा योनातान एक समझदार मंत्री अर शास्त्री था, अर एक हक्मोनी का बेट्टा यहीएल राजपुत्रां कै गैल रह्या करै था। <verse eid="1CH 27:32" /><verse number="33" style="v" sid="1CH 27:33" />अर अहीतोपेल राजा का मंत्री था, अर एरेकी हूशै राजा का मित्तर था। <verse eid="1CH 27:33" /><verse number="34" style="v" sid="1CH 27:34" />अर अहीतोपेल के मरण कै बाद बनायाह का बेट्टा यहोयादा अर एब्यातार मंत्री ठहराए गए। अर राजा दाऊद का प्रधान सेनापति योआब था।<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" sid="1CH 28" />
  <para style="s">दाऊद की आखरी सभा अर निर्देशन</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1" />अर दाऊद नै इस्राएल के सारे हाकिमां ताहीं, यानिके गोत्रां के हाकिमां अर राजा की सेवा पाणी करण आळे दलां के हाकिमां ताहीं अर सहस्‍त्रपतियाँ अर शतपतियाँ अर राजा अर उसके बेट्यां के पशु आदि सारे धन-सम्पत्ति के अधिकारियां, सरदारां अर वीरां अर सारे शूरवीरां ताहीं यरुशलेम म्ह बुलवाया। <verse eid="1CH 28:1" /><verse number="2" style="v" sid="1CH 28:2" />फेर दाऊद राजा खड़या होकै कहण लाग्या, “हे मेरे भाईयो! अर हे मेरी प्रजा के माणसों! मेरी सुणो, मेरी मनसा तो थी के यहोवा की वाचा के सन्दूक कै खात्तर अर हम माणसां के परमेसवर के चरणां की पीढ़ी<note caller="+" style="f"><char style="fr" closed="false">28:2 </char><char style="fq" closed="false">चरणां की पीढ़ी </char><char style="ft" closed="false">दाऊद वाचा के सन्दूक नै परमेसवर के चरणां की पीढ़ी कहवै सै क्यूँके वो उसकै उप्पर विराजमान रहया करदा या उस प्रकाशमान बाद्दळ म्ह जो दया के आसन एवं करूबां के बिचाळै था। </char></note> कै खात्तर विश्राम का एक भवन बणाऊँ, अर मन्‍नै उसके बणाण की त्यारी करी थी। <verse eid="1CH 28:2" /><verse number="3" style="v" sid="1CH 28:3" />पर परमेसवर नै मेरै तै कह्या, ‘तू मेरे नाम का भवन बणाण न्ही पावैगा, क्यूँके तू युद्ध करण आळा सै अर तन्‍नै लहू बहाया सै।’ <verse eid="1CH 28:3" /><verse number="4" style="v" sid="1CH 28:4" />फेर भी इस्राएल के परमेसवर यहोवा नै मेरे पिता के सारे घरान्‍ने म्ह तै मेरै ताहीं चुण लिया, के इस्राएल का राजा सदा बण्या रहूँ यानिके उसनै यहूदा ताहीं प्रधान होण कै खात्तर अर यहूदा के घरान्‍ने म्ह तै मेरे पिता के कुण्बे ताहीं चुण लिया अर मेरे पिता के बेट्टयाँ म्ह तै वो मेरे ताहीं सारे इस्राएल का राजा बणाण कै खात्तर खुश होया। <verse eid="1CH 28:4" /><verse number="5" style="v" sid="1CH 28:5" />अर मेरे सारे बेट्टयाँ म्ह तै (यहोवा नै तो मेरे तै घणे बेट्टे दिए सैं) उसनै मेरे बेट्टे सुलैमान ताहीं चुण लिया सै, के वो इस्राएल कै उप्पर यहोवा के राज्य की गद्दी पै विराजै। <verse eid="1CH 28:5" /><verse number="6" style="v" sid="1CH 28:6" />अर यहोवा नै मेरे तै कह्या, ‘तेरा बेट्टा सुलैमान ए मेरे भवन अर आँगणां नै बणावैगा, क्यूँके मन्‍नै उस ताहीं चुण लिया सै के मेरा बेट्टा ठैहरे, अर मै उसका पिता ठहरूँगा। <verse eid="1CH 28:6" /><verse number="7" style="v" sid="1CH 28:7" />अर जै वो मेरे हुकम अर नियमां कै मानण म्ह आजकाल के बराबर मजबूत रहवै<note caller="+" style="f"><char style="fr" closed="false">28:7 </char><char style="fq" closed="false">मजबूत रहवै </char><char style="ft" closed="false">दाऊद तै जो प्रतिज्ञा करी गई वो शर्त पै आधारित थी अर यहूदी सिंहासन पै उसके वंश का बैठणा वो शर्त पै आधारित था (2 शमू 7:14) इब साफ तौर तै घोषित करया गया।</char></note>, तो मै उसका राज्य सदा स्थिर राक्खूँगा।’ <verse eid="1CH 28:7" /><verse number="8" style="v" sid="1CH 28:8" />इस खात्तर इब इस्राएल के देखदे यानिके यहोवा की मण्डळी के देखदे, अर अपणे परमेसवर कै स्याम्ही, अपणे परमेसवर यहोवा के सारे हुकमां नै मान्‍नो अर उनपै ध्यान करदे रहो; ताके थम इस आच्छे देश के अधिकारी बणे रहो, अर इस ताहीं अपणे बाद अपणे वंश का सदा का भाग होण कै खात्तर छोड़ जाओ।”<verse eid="1CH 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9" />“हे मेरे बेट्टे सुलैमान! तू अपणे पिता के परमेसवर का ज्ञान राख, अर खरे मन अर खुश जी तै उसकी सेवा करदा रह; क्यूँके यहोवा मन नै जाँच्‍चै अर विचार म्ह जो कुछ पैदा होवै सै उसनै समझै सै। जै तू उसकी खोज म्ह रहवै, तो वो तन्‍नै मिलैगा; पर जै तू उसनै त्याग दे तो वो सदा खात्तर तेरै ताहीं छोड़ देगा। <verse eid="1CH 28:9" /><verse number="10" style="v" sid="1CH 28:10" />इब चौक्‍कस रह, यहोवा नै तेरे ताहीं एक इसा भवन बणाण खात्तर चुण लिया सै, जो पवित्र जगहां ठहरैगा, हियाव बाँधकै इस काम म्ह लाग जा।”<verse eid="1CH 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11" />फेर दाऊद नै अपणे बेट्टे सुलैमान तै मन्दर के ओसारे, कोठड़ियाँ, भण्डारां, अटारियाँ, भीतरी कोठड़ियाँ, अर प्रायश्चित के ढक्‍कण के जगहां का नमूना, <verse eid="1CH 28:11" /><verse number="12" style="v" sid="1CH 28:12" />अर यहोवा के भवन के आँगणां अर च्यांरु और की कोठड़ियाँ, अर परमेसवर के भवन के भण्डारां अर पवित्र करी होई चिज्जां कै भण्डारां के, जो-जो नमूने परमेसवर के आत्मा की प्रेरणा तै उस ताहीं मिले थे, वे सारे दे दिए। <verse eid="1CH 28:12" /><verse number="13" style="v" sid="1CH 28:13" />फेर याजकां अर लेवियाँ के दलां, अर यहोवा के भवन की सेवा के सारे काम्मां, अर यहोवा के भवन की सेवा के सारे सामान, <verse eid="1CH 28:13" /><verse number="14" style="v" sid="1CH 28:14" />यानिके सारी ढाळ की सेवा कै खात्तर सोन्‍ने के बरतनां कै निमित्त सोन्‍ना तौलकै, अर सारी ढाळ की सेवा कै खात्तर चाँदी के बरतनां कै निमित्त चाँदी तौल कै, <verse eid="1CH 28:14" /><verse number="15" style="v" sid="1CH 28:15" />अर सोन्‍ने की दीवटां कै खात्तर, अर उनके दीव्यां कै खात्तर हर एक दीवट, अर उसके दीव्यां का सोन्‍ना तौलकै अर चाँदी के दीवटां कै खात्तर एक-एक दीवट, अर उसके दीवे की चाँदी, हर एक दीवट के काम कै मुताबिक तौल कै, <verse eid="1CH 28:15" /><verse number="16" style="v" sid="1CH 28:16" />अर भेंट की रोट्टी की मेजां कै खात्तर एक-एक मेज का सोन्‍ना तौलकै, अर चाँदी की मेजां कै खात्तर चाँदी, <verse eid="1CH 28:16" /><verse number="17" style="v" sid="1CH 28:17" />अर शुद्ध सोन्‍ने के काँटों, कटोरयां अर प्यालां अर सोन्‍ने की कटोरियां कै खात्तर एक-एक कटोरी का सोन्‍ना तौलकै, अर चाँदी की कटोरियां कै खात्तर एक-एक कटोरी की चाँदी तौल कै, <verse eid="1CH 28:17" /><verse number="18" style="v" sid="1CH 28:18" />अर धूप की वेदी कै खात्तर त्याया होया सोन्‍ना तौलकै, अर रथ यानिके यहोवा की वाचा का सन्दूक<note caller="+" style="f"><char style="fr" closed="false">28:18 </char><char style="fq" closed="false">वाचा का सन्दूक </char><char style="ft" closed="false">वाचा का सन्दूक खुद सै। यहोवा करूबां पै सवारी करै सै, अत: वे उसका रथ सै। (भजन. 18:10, भजन. 99:1)</char></note> ढ़कण आळे अर पंख फैलाए होए करूबां के नमूने कै खात्तर सोन्‍ना दे दिया। <verse eid="1CH 28:18" /><verse number="19" style="v" sid="1CH 28:19" />दाऊद नै सुलैमान तै कह्या “मन्‍नै यहोवा की शक्ति तै जो मेरै ताहीं मिली, यो सारा किमे बूझ कै लिख दिया सै।”<verse eid="1CH 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20" />फेर दाऊद नै अपणे बेट्टे सुलैमान तै कह्या, “हियाव बाँध अर मजबूत होकै इस काम म्ह लाग जा। डर मत, अर तेरा मन कच्‍चा ना हो, क्यूँके यहोवा परमेसवर जो मेरा परमेसवर सै, वो तेरै गैल सै; अर जिब तक यहोवा कै भवन म्ह जितना काम करणा हो वो ना हो ले, तब तक वो ना तो तन्‍नै धोक्खा देवैगा अर ना तन्‍नै त्यागैगा। <verse eid="1CH 28:20" /><verse number="21" style="v" sid="1CH 28:21" />अर देख परमेसवर के भवन के सारे काम कै खात्तर याजकां अर लेवियाँ के दल ठहराए गए सैं, अर सारी ढाळ की सेवा कै खात्तर सारे ढाळ के काम खुशी तै करण आळे बुद्धिमान माणस भी तेरा साथ देवैंगे; अर हाकिम अर सारी प्रजा के माणस भी जो कुछ तू कहवैगा वोए करैंगे।”<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" sid="1CH 29" />
  <para style="s">मन्दर निर्माण खात्तर भेंट</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1" />फेर राजा दाऊद नै सारी सभा तै कह्या, “मेरा बेट्टा सुलैमान सुकुमार छोरा सै, अर केवल उसे ताहीं परमेसवर नै चुण्या सै; काम तो भारी सै, क्यूँके यो भवन माणस कै खात्तर न्ही, पर यहोवा परमेसवर कै खात्तर बणैगा। <verse eid="1CH 29:1" /><verse number="2" style="v" sid="1CH 29:2" />मन्‍नै तो अपणी शक्ति भर, अपणे परमेसवर कै भवन के निमित्त सोन्‍ने की चिज्जां कै खात्तर सोन्‍ना, चाँदी की चिज्जां कै खात्तर चाँदी, पीतळ की चिज्जां कै खात्तर पीतळ, लोहे की चिज्जां कै खात्तर लोहा, अर लाकड़ी की चिज्जां कै खात्तर लाकड़ी, अर सुलैमानी पत्थर, अर जड़ण कै लायक मणि, अर पच्‍चीकारी के काम कै खात्तर अलग-अलग रंगां के नग, अर सारे तरियां के मणि अर भोत सा संगमरमर कठ्ठा करया सै। <verse eid="1CH 29:2" /><verse number="3" style="v" sid="1CH 29:3" />फेर मेरा मन अपणे परमेसवर कै भवन म्ह लाग्या सै, इस कारण जो कुछ मन्‍नै पवित्र भवन कै खात्तर कठ्ठा करया सै, उस सबतै ज्यादा मै अपणा निज धन<note caller="+" style="f"><char style="fr" closed="false">29:3 </char><char style="fq" closed="false">निज धन </char><char style="ft" closed="false">वो इस दान की सरेआम घोषणा करै सै के जनता भी प्रोत्साहित होकै देवै।</char></note> भी जो सोन्‍ना-चाँदी के रूप म्ह मेरै धोरै सै, अपणे परमेसवर के भवन कै खात्तर दे देऊँ सूं। <verse eid="1CH 29:3" /><verse number="4" style="v" sid="1CH 29:4" />यानिके तीन हजार किक्‍कार ओपीर का सोन्‍ना, अर सात हजार किक्‍कार तपाई होई चाँदी<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="fq" closed="false">तीन हजार किक्‍कार ओपीर का सोन्‍ना, अर सात हजार किक्‍कार तपाई होई चाँदी </char><char style="ft" closed="false">सौ टन ओपीर सोन्‍ना अर लगभग 240 टन शुद्ध चाँदी</char></note>, जिसतै कोठरियां की भींत मढ़ी जावै। <verse eid="1CH 29:4" /><verse number="5" style="v" sid="1CH 29:5" />अर सोन्‍ने की चिज्जां कै खात्तर सोन्‍ना, अर चाँदी की चिज्जां कै खात्तर चाँदी, अर कारीगरां तै बणाण आळे सारे ढाळ के काम कै खात्तर मै उस ताहीं देऊँ सूं। अर कौण अपणी इच्छा तै यहोवा कै खात्तर अपणे आप ताहीं अर्पण कर देवै सै<note caller="+" style="f"><char style="fr" closed="false">29:5 </char><char style="fq" closed="false">अर्पण कर देवै सै </char><char style="ft" closed="false">यहोवा की सेवा म्ह सर्वांग समर्पण। इन शब्दां जरिये जनता तै खुद की इच्छा दान का आग्रह करया गया सै।</char></note>?”<verse eid="1CH 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6" />फेर पितरां के घरान्यां के प्रधानां अर इस्राएल के गोत्रां के हाकिमां अर सहस्‍त्रपतियाँ अर शतपतियाँ अर राजा कै काम के अधिकारियां नै अपणी-अपणी इच्छा तै, <verse eid="1CH 29:6" /><verse number="7" style="v" sid="1CH 29:7" />परमेसवर के भवन के काम कै खात्तर पाँच हजार किक्‍कार अर दस हजार दर्कमोन सोन्‍ना, दस हजार किक्‍कार चाँदी, अठारह हजार किक्‍कार पीतळ, अर एक लाख किक्‍कार लोहा दे दिया<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">170 टन तै घणा सोन्‍ना, 340 टन तै घणा चाँदी, लगभग 620 टन कांस्य अर 3,400 टन तै घणा लोहा।</char></note>। <verse eid="1CH 29:7" /><verse number="8" style="v" sid="1CH 29:8" />अर जिनकै धोरै मणि थे, उननै उन ताहीं यहोवा के भवन के खजाने कै खात्तर गेर्शोनी यहीएल के हाथ म्ह दे दिया। <verse eid="1CH 29:8" /><verse number="9" style="v" sid="1CH 29:9" />फेर प्रजा के माणस आनन्दित होए, क्यूँके हाकिमां नै खुश होकै खरे मन अर अपणी-अपणी इच्छा तै यहोवा कै खात्तर भेंट दी थी; अर दाऊद राजा घणाए आनन्दित होया।<verse eid="1CH 29:9" /></para>
  <para style="s">दाऊद कै जरिये परमेसवर का धन्यवाद</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10" />फेर दाऊद नै सारी सभा के स्याम्ही यहोवा का धन्यवाद करया, अर दाऊद नै कह्या, “हे यहोवा! हे म्हारे मूलपुरुष इस्राएल के परमेसवर! अनादिकाल तै अनन्त काल तक तू धन्य सै। <verse eid="1CH 29:10" /><verse number="11" style="v" sid="1CH 29:11" />हे यहोवा! महिमा, पराक्रम, शोभा, सामर्थ्य अर वैभव, तेराए सै; क्यूँके अकास अर पृथ्वी म्ह जो कुछ सै, वो तेराए सै; हे यहोवा! राज्य तेरा सै, अर तू सब कै उप्पर खास अर महान ठहरया सै<note caller="+" style="f"><char style="fr" closed="false">29:11 </char><char style="ft" closed="false">प्रकाशितवाक्य 5:12-13 </char></note>। <verse eid="1CH 29:11" /><verse number="12" style="v" sid="1CH 29:12" />धन अर महिमा तेरी और तै मिलै सैं, अर तू सारया कै उप्पर प्रभुता करया करै सैं। सामर्थ्य अर पराक्रम तेरे ए हाथ म्ह सैं, अर सारे माणसां ताहीं बढ़ाणा अर बल देणा तेरे हाथ म्ह सै। <verse eid="1CH 29:12" /><verse number="13" style="v" sid="1CH 29:13" />इस करकै इब हे म्हारे परमेसवर! हम तेरा धन्यवाद अर तेरे महिमायुक्‍त नाम की स्तुति करां सां।”<verse eid="1CH 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14" />“मै के सूं अर मेरी प्रजा के सै? के हमनै इस तरियां तै अपणी इच्छा तै तेरे ताहीं भेंट देण की शक्ति मिलै? तेरे तै तो सारा किमे मिलै सै, अर हमनै तेरै हाथ तै पाकै तेरे तै दिया सै। <verse eid="1CH 29:14" /><verse number="15" style="v" sid="1CH 29:15" />तेरी निगांह म्ह हम तो अपणे सारे पुरखाओं कै बराबर पराए अर परदेशी सैं; धरती पै म्हारे दिन छां की तरियां बीत जावैं सैं, अर म्हारा किमे ठिकाणा न्ही<note caller="+" style="f"><char style="fr" closed="false">29:15 </char><char style="ft" closed="false">इब्रानियों। 11:13, भजन संहिता 39:12, 114:4</char></note>। <verse eid="1CH 29:15" /><verse number="16" style="v" sid="1CH 29:16" />हे म्हारे परमेसवर यहोवा! वो जो बड़ा संचय हमनै तेरे पवित्र नाम का एक भवन बणाण कै खात्तर करया सै, वो तेरे ए हाथ तै हमनै मिल्या था, अर सारा तेराए सै। <verse eid="1CH 29:16" /><verse number="17" style="v" sid="1CH 29:17" />अर हे मेरे परमेसवर! मै जाणु सूं के तू मन नै जाँच्‍चै सै अर सिधाई तै खुश रहवै सै; मन्‍नै तो यो सारा किमे मन की सिधाई अर अपणी इच्छा तै दिया सै; अर इब मन्‍नै आनन्द तै देख्या सै, के तेरी प्रजा के माणस जो उरै उपस्थित सैं, वो अपणी इच्छा तै तेरै खात्तर भेंट देवै सैं। <verse eid="1CH 29:17" /><verse number="18" style="v" sid="1CH 29:18" />हे यहोवा! हे म्हारे पुरखा अब्राहम, इसहाक अर इस्राएल के परमेसवर! अपणी प्रजा के मन के विचारां म्ह या बात बणाए राख अर उनके मन अपणी और लगाऐ राख<note caller="+" style="f"><char style="fr" closed="false">29:18 </char><char style="ft" closed="false">सहजता अर खुद की इच्छा तै दान देण कै खात्तर उनकी आत्मा नै बणाए राख अर उनके मन अपणे म्ह स्थिर राख।</char></note>। <verse eid="1CH 29:18" /><verse number="19" style="v" sid="1CH 29:19" />अर मेरे बेट्टे सुलैमान का मन इसा खरा कर दे के वो तेरे हुकमां, चितौनियाँ अर विधियाँ नै मानदा रहवै अर यो सारा किमे करे, अर उस भवन नै बणावै, जिसकी त्यारी मन्‍नै करी सै।”<verse eid="1CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20" />फेर दाऊद नै सारी सभा तै कह्या, “थम अपणे परमेसवर यहोवा का धन्यवाद करो।” फेर सभा के सारे माणसां नै अपणे पितरां के परमेसवर यहोवा का धन्यवाद करया, अर अपणा-अपणा सिर झुकाकै यहोवा तै अर राजा ताहीं दण्डवत करया।<verse eid="1CH 29:20" /></para>
  <para style="s">सुलैमान का राज्याभिषेक</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21" />अर दुसरे दिन उननै यहोवा कै खात्तर बलिदान करे, यानिके अर्घां समेत एक हजार बळध, एक हजार मिंढे अर एक हजार भेड़ के बच्‍चे होमबलि करकै चढ़ाए, अर सारे इस्राएल कै खात्तर घणे सारे मेलबलि चढ़ाए। <verse eid="1CH 29:21" /><verse number="22" style="v" sid="1CH 29:22" />उसे दिन यहोवा कै स्याम्ही उननै बड़े आनन्द तै खाया अर पिया।</para>
  <para style="p" vid="1CH 29:22">फेर उननै दाऊद के बेट्टे सुलैमान ताहीं दुसरी बार राजा ठहराकै यहोवा की और तै प्रधान होण कै खात्तर उसका अर याजक होण कै खात्तर सादोक का अभिषेक करया। <verse eid="1CH 29:22" /><verse number="23" style="v" sid="1CH 29:23" />फेर सुलैमान अपणे पिता दाऊद की जगहां पै राजा होकै यहोवा के सिंहासन पै विराजण लाग्या अर समृद्ध होया, अर इस्राएल उसकै अधीन होया। <verse eid="1CH 29:23" /><verse number="24" style="v" sid="1CH 29:24" />अर सारे हाकिमां अर शूरवीरां अर राजा दाऊद के सारे बेट्टयाँ नै सुलैमान राजा की अधीनता अंगीकार करी। <verse eid="1CH 29:24" /><verse number="25" style="v" sid="1CH 29:25" />अर यहोवा नै सुलैमान ताहीं सारे इस्राएल के देखदे घणाए बढ़ाया, अर उसतै इसा राजकीय ऐश्‍वर्य दिया, जिसा उसतै पैहले इस्राएल के किसे राजा का ना होया था।<verse eid="1CH 29:25" /></para>
  <para style="s">दाऊद की मौत</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26" />इस तरियां यिशै के बेट्टे दाऊद नै सारे इस्राएल कै उप्पर राज करया। <verse eid="1CH 29:26" /><verse number="27" style="v" sid="1CH 29:27" />अर उसके इस्राएल पै राज करण का समय चाळीस साल का था; उसनै सात साल तो हेब्रोन म्ह अर तैंतीस साल यरुशलेम म्ह राज करया। <verse eid="1CH 29:27" /><verse number="28" style="v" sid="1CH 29:28" />अर वो पूरे बुढ़ापे की अवस्था म्ह लम्बी उम्र का होकै अर धन अर वैभव, मन मान्या भोग कै मर ग्या; अर उसका बेट्टा सुलैमान उसकी जगहां पै राजा होया। <verse eid="1CH 29:28" /><verse number="29" style="v" sid="1CH 29:29" />आदि तै अन्त ताहीं राजा दाऊद के सारे काम्मां का वृत्तान्त, <verse eid="1CH 29:29" /><verse number="30" style="v" sid="1CH 29:30" />अर उसके सारे राज्य अर पराक्रम का, अर उसपै अर इस्राएल पै, बलके देश-देश दे सारे राज्याँ पै जो किमे बीत्या, इसका भी वृत्तान्त शमूएल दर्शी अर नातान नबी अर गाद दर्शी<note caller="+" style="f"><char style="fr" closed="false">29:30 </char><char style="fq" closed="false">शमूएल दर्शी अर नातान नबी अर गाद दर्शी </char><char style="ft" closed="false">किसे-किसे अनुवाद म्ह गाद साफ-साफ शमूएल का पद उच्‍चतर उपाधि का सै जो सिर्फ उसे अर हनानी तै दिया गया था।</char></note> की किताबां म्ह लिख्या होया सै।<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>