  <para style="h">लैव्यव्यवस्था</para>
  <para style="toc1">लैव्यव्यवस्था</para>
  <para style="toc2">लैव्यव्यवस्था</para>
  <para style="toc3">लैव्य.</para>
  <para style="mt">लैव्यव्यवस्था</para>
  <para style="is">लेखक</para>
  <para style="ip">किताब का आखरी पद लेखक के प्रश्न नै हल कर देवै सै, “जो सारी आज्ञा यहोवा नै इस्राएल खात्तर सीनै पर्वत पै मूसा ताहीं दी थी, वे येए सै” (<char style="xt"><ref loc="LEV 27:34">लैव्य. 27:34</ref></char>; तुलना करें <char style="xt"><ref loc="LEV 7:38">7:38</ref>; <ref loc="LEV 25:1">25:1</ref>; <ref loc="LEV 26:46">26:46</ref></char>)। इस किताब म्ह विधि विधान सम्बन्धित अनेक ऐतिहासिक विवरण सै (<char style="xt"><ref loc="LEV 8:10">लैव्य. 8:10</ref></char><char style="xt"><ref loc="LEV 24:10-23">24:10-23</ref></char>)। लैव्यव्यवस्था शब्द लेवी गोत्र तै लिकड्या सै जिसके सदस्यां ताहीं परमेसवर नै पुरोहित होण अर आराधना म्ह अगुवाई करण खात्तर न्यारा करया था। इस किताब म्ह लेवियों की जिम्मेदारियांँ का वर्णन सै, इसतै बढ़कै महत्त्वपूर्ण बात या सै के पुरोहितां ताहीं निर्देश दिए गये सै के वे आराधना म्ह उपासकां की सेवा किस तरियां करै अर प्रजा ताहीं आदेश दिये गये सै के वे किस तरियां पवित्र जीवन जीवै।</para>
  <para style="is">लिखण की तारिख अर जगहां</para>
  <para style="ip">लगभग 1446 - 1405 ई. पू.</para>
  <para style="ip">लैव्यव्यवस्था की किताब म्ह जो नियम दिये गये सै वे सीनै पर्वत पै या उसके धोरै परमेसवर नै मूसा ताहीं दिए थे। ओड़ै कुछ बखत खात्तर इस्राएलियाँ नै छावणी डाली थी।</para>
  <para style="is">प्रापक</para>
  <para style="ip">यह किताब पुरोहितां, लेवियाँ अर इस्राएलियाँ की सारी पीढ़ियाँ खात्तर लिखी गई थी।</para>
  <para style="is">मकसद</para>
  <para style="ip">लैव्यव्यवस्था की किताब की शरुआत मिलापआळे तम्बू तै परमेसवर के जरिये मूसा ताहीं पुकारण तै हो सै। लैव्यव्यवस्था की किताब म्ह मुक्ति पाए उस समुदाय ताहीं उनके महिमामय परमेसवर के साथ उचित सम्बन्ध म्ह रहण के निर्देश सै, वो उनकै बीच म्ह ए वास करै था।</para>
  <para style="ip">उस समुदाय नै मिस्र तै पलायन करया था अर उसकी संस्कृति अर धर्म का त्याग करया था। इब वे कनान म्ह दाखिल होण खात्तर जाण लागरे थे जड़ै दुसरी संस्कृतियाँ और धर्म उस राष्ट्र नै प्रभावित करैगें। लैव्यव्यवस्था की किताब म्ह इस्राएल ताहीं आदेश दिए सै के वे ओड़ै की संस्कृतियाँ तै अलग (पवित्र) होकै रहवै अर यहोवा के बिश्वासयोग्य बणे रहै।</para>
  <para style="is">खास बातें</para>
  <para style="ip">निर्देश</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. भेंट चढ़ाण के नियम <char style="ior"><ref loc="LEV 1:1-7:38">1:1-7:38</ref></char></para>
  <para style="io1">2. पुरोहितां खात्तर परमेसवर के निर्देश <char style="ior"><ref loc="LEV 8:1-10:20">8:1-10:20</ref></char></para>
  <para style="io1">3. परमेसवर की प्रजा ताहीं निर्देश <char style="ior"><ref loc="LEV 11:1-15:33">11:1-15:33</ref></char></para>
  <para style="io1">4. वेदी और प्रायश्चित दिवस के निर्देश <char style="ior"><ref loc="LEV 16:1-34">16:1-34</ref></char></para>
  <para style="io1">5. व्यावहारिक पवित्रता <char style="ior"><ref loc="LEV 17:1-22:33">17:1-22:33</ref></char></para>
  <para style="io1">6. सब्त, त्यौहार अर उत्सव <char style="ior"><ref loc="LEV 23:1-25:55">23:1-25:55</ref></char></para>
  <para style="io1">7. परमेसवर तै आशीष पाण की शर्तें <char style="ior"><ref loc="LEV 26:1-27:34">26:1-27:34</ref></char></para>
  <chapter number="1" style="c" sid="LEV 1" />
  <para style="s">होमबलि की विधि</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 1:1" />यहोवा नै मिलापआळे तम्बू म्ह तै मूसा ताहीं बुलाकै उसतै कह्या, <verse eid="LEV 1:1" /><verse number="2" style="v" sid="LEV 1:2" />“इस्राएलियाँ तै कह के थारे म्ह तै जो कोए माणस यहोवा कै खात्तर पशु का चढ़ावा चढ़ावै, तो उसका बलिपशु गां-बळध या भेड़-बकरियाँ म्ह तै एक का हो।”<verse eid="LEV 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 1:3" />“जै वो गां-बळध म्ह तै होमबलि करै, तो बेकसूर नर मिलापआळे तम्बू कै दरबाजे पै चढ़ावै के यहोवा उस ताहीं कबूल करै। <verse eid="LEV 1:3" /><verse number="4" style="v" sid="LEV 1:4" />वो अपणा हाथ होमबलि पशु कै सिर पै धरै, अर वो उनकै खात्तर प्रायश्चित करण नै कबूल करया जावैगा। <verse eid="LEV 1:4" /><verse number="5" style="v" sid="LEV 1:5" />फेर वो उस बाछड़े नै यहोवा कै स्याम्ही बलि करै; अर हारुन के बेट्टे जो याजक सै वे लहू नै धोरै ले जाकै उस वेदी कै चौगरदे नै छिड़कै जो मिलापआळे तम्बू कै दरबाजे पै सै। <verse eid="LEV 1:5" /><verse number="6" style="v" sid="LEV 1:6" />फेर वो होमबलि पशु की खाल लिकाड़कै उस पशु नै टुकड़े-टुकड़े करै; <verse eid="LEV 1:6" /><verse number="7" style="v" sid="LEV 1:7" />फेर हारुन याजक के बेट्टे वेदी पै आग धरे, अर आग पै लाकड़ी सजा कै धरै; <verse eid="LEV 1:7" /><verse number="8" style="v" sid="LEV 1:8" />अर हारुन के बेट्टे जो याजक सैं वे सिर अर चर्बी सुधा पशु के टुकड्या नै उस लाकड़ी पै जो वेदी की आग पै होवैगी सजा कै धरै; <verse eid="LEV 1:8" /><verse number="9" style="v" sid="LEV 1:9" />अर वो उसकी आंतड़ी अर पैरां नै पाणी तै धोकै। फेर याजक सारया नै वेदी पै जळावै के वो होमबलि यहोवा कै खात्तर सुखदायक सुगन्धआळा हवन ठहरै।”<verse eid="LEV 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 1:10" />“जै वो भेड्डां या बकरयां म्ह तै एक की होमबलि चढ़ावै, तो बेकसूर नर नै चढ़ावै। <verse eid="LEV 1:10" /><verse number="11" style="v" sid="LEV 1:11" />अर वो उस ताहीं यहोवा कै आग्गै वेदी कै उत्तरी ओड़ बलि करै; अर हारुन के बेट्टे जो याजक सै वे उसकै लहू नै वेदी कै चौगरदे नै छिड़कै। <verse eid="LEV 1:11" /><verse number="12" style="v" sid="LEV 1:12" />अर वो उसनै सिर अर चर्बी सुधा टुकड़े-टुकड़े करै, अर याजक इन सारया नै उस लाकड़ी पै सजा कै धर लेवै जो वेदी की आग पै होवैगी; <verse eid="LEV 1:12" /><verse number="13" style="v" sid="LEV 1:13" />वो उसकी आंतड़ी अर पैरां नै पाणी तै धोवै। अर याजक वेदी पै जळावै के वो होमबलि हो अर यहोवा कै खात्तर सुखदायक सुगन्धआळा हवन ठहरै।”<verse eid="LEV 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 1:14" />“जै वो यहोवा कै खात्तर पंछियाँ का होमबलि चढ़ावै, तो पंडुक या कबूतरां का चढ़ावा चढ़ावै। <verse eid="LEV 1:14" /><verse number="15" style="v" sid="LEV 1:15" />याजक उसनै वेदी कै धोरै ले जाकै उसका गळा मरोड़कै सिर नै धड़ तै न्यारा करै, अर वेदी पै जळावै; अर उसका सारा लहू उस वेदी कै बाजू पै गेरया जावै; <verse eid="LEV 1:15" /><verse number="16" style="v" sid="LEV 1:16" />अर वो उसकी गळ-थेल्‍ली नै मल सुधा लिकाड़कै वेदी कै पूरब की ओड़ तै राख गेरण की जगहां पै गेर दे; <verse eid="LEV 1:16" /><verse number="17" style="v" sid="LEV 1:17" />अर वो उसनै पंखां कै बिचाळै तै पाड़ै, पर न्यारा-न्यारा ना करै। फेर याजक उसनै वेदी पै उस लाकड़ी कै उप्पर धरकै जो आग पै होवैगी जळावै के वो होमबलि अर यहोवा कै खात्तर सुखदायक सुगन्धआळा हवन ठहरै।”<verse eid="LEV 1:17" /></para>
  <chapter eid="LEV 1" />
  <chapter number="2" style="c" sid="LEV 2" />
  <para style="s">अन्‍नबलि की विधि</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 2:1" />“जिब कोए यहोवा कै खात्तर अन्‍नबलि का चढ़ावा चढ़ाणा चावै, तो वो मैद्दा चढ़ावै; अर उसपै तेल<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fq" closed="false">तेल </char><char style="ft" closed="false">जैतून का तेल</char></note> गेर कै उसके उप्पर लोबान धरै; <verse eid="LEV 2:1" /><verse number="2" style="v" sid="LEV 2:2" />अर वो उसनै हारुन के बेट्याँ कै धोरै जो याजक सै ल्यावै। अर अन्‍नबलि के तेल मिले होए मैदे म्ह तै इस ढाळ अपणी मुट्ठी भरकै काड्डै के सारा लोबान उस म्ह आ ज्या; अर याजक उननै याद दुआण आळे हिस्से कै खात्तर वेदी पै जळावै के यो यहोवा कै खात्तर सुखदायक खुशबुदार हवन ठहरै। <verse eid="LEV 2:2" /><verse number="3" style="v" sid="LEV 2:3" />अर अन्‍नबलि म्ह तै जो बच्या रहवै सै वो हारुन अर उसके बेट्याँ का ठहरै; यो यहोवा कै हवनां म्ह तै परमपवित्र भाग होवैगा।”<verse eid="LEV 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 2:4" />“जिब तू अन्‍नबलि कै खात्तर तंदूर म्ह पकाया होया चढ़ावा चढ़ावै, तो वो तेल तै सणे होए अखमीरी मैदे कै फुलक्यां, या तेल तै चोपड़ी होई अखमीरी रोट्टी का हो। <verse eid="LEV 2:4" /><verse number="5" style="v" sid="LEV 2:5" />अर जै तेरा चढ़ावा तवे पै पकाया होया अन्‍नबलि हो, तो वो तेल तै सणे होए अखमीरी मैदे का हो; <verse eid="LEV 2:5" /><verse number="6" style="v" sid="LEV 2:6" />उसनै टुकड़े-टुकड़े करकै उसपै तेल गेरिये, फेर वो अन्‍नबलि हो ज्यागा। <verse eid="LEV 2:6" /><verse number="7" style="v" sid="LEV 2:7" />अर जै तेरा चढ़ावा कढ़ाही म्ह तळ्या होया अन्‍नबलि हो, तो वो मैदे तै तेल म्ह बणाया जावै। <verse eid="LEV 2:7" /><verse number="8" style="v" sid="LEV 2:8" />अर जो अन्‍नबलि इन चिज्जां म्ह तै किसे का बण्या हो उसनै यहोवा कै धोरै ले जाईयो; अर जिब वो याजक कै धोरै ल्याया जावै, तो याजक उसनै वेदी कै धोरै ले जावै। <verse eid="LEV 2:8" /><verse number="9" style="v" sid="LEV 2:9" />अर याजक अन्‍नबलि म्ह तै याद दिलाण आळे हिस्से नै लिकाड़कै वेदी पै जळावै ताके वो यहोवा कै खात्तर सुखदायक सुगन्धआळा हवन ठहरै; <verse eid="LEV 2:9" /><verse number="10" style="v" sid="LEV 2:10" />अर अन्‍नबलि म्ह तै जो बच्या रहवै सै वो हारुन अर उसकै बेट्याँ का ठहरै; वो यहोवा कै हवनां म्ह परमपवित्र हिस्सा होवैगा।”<verse eid="LEV 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 2:11" />“कोए अन्‍नबलि जिसनै थम यहोवा कै खात्तर चढ़ाओ खमीर मिलाकै बणाया ना जावै; थम कदे हवन म्ह यहोवा कै खात्तर खमीर अर शहद ना जळाईयो। <verse eid="LEV 2:11" /><verse number="12" style="v" sid="LEV 2:12" />थम इननै पैहली पैदावार का चढ़ावा करकै यहोवा कै खात्तर चढ़ाईयों, पर वे सुखदायक सुगन्ध कै खात्तर वेदी पै चढ़ाए ना जावै। <verse eid="LEV 2:12" /><verse number="13" style="v" sid="LEV 2:13" />फेर अपणे सारे अन्‍नबलियाँ नै नमकीन<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="fq" closed="false">नमकीन </char><char style="ft" closed="false">किसी चीज नै नमकीन बणाण का मतलब सै के उसनै लाम्बे बखत खात्तर राख्या जा सकै</char></note> बणाईयो; अर अपणा कोए अन्‍नबलि अपणे परमेसवर कै गैल करे होए करार<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="fq" closed="false">परमेसवर कै गैल करे होए करार </char><char style="ft" closed="false">इसका मतलब सै के पक्‍का करार</char></note> के नमक तै दूर न्ही होण देणा; अपणे सारे चढ़ावयां कै गेल्या नमक भी चढ़ाईयों।”<verse eid="LEV 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 2:14" />“जै तू यहोवा कै खात्तर पैहली पैदावार का अन्‍नबलि चढ़ावै, तो अपणी पैहली उपज के अन्‍नबलि कै खात्तर आग म्ह भुनी होई हरी-हरी बालें, यानिके हरी-हरी बाल्‍लां नै मशळ कै लिकाड़ लियो, फेर अन्‍न नै चढ़ाईयों। <verse eid="LEV 2:14" /><verse number="15" style="v" sid="LEV 2:15" />अर उस म्ह तेल गेरियो, अर उसकै उप्पर लोबान धरियो; फेर वो अन्‍नबलि हो ज्यागा। <verse eid="LEV 2:15" /><verse number="16" style="v" sid="LEV 2:16" />अर याजक मशळ कै लिकाड़े होए अन्‍न नै, अर तेल नै, अर सारे लोबान नै याद दिलाण आळा हिस्सा करकै जळा दे; वो यहोवा कै खात्तर हवन ठहरै।”<verse eid="LEV 2:16" /></para>
  <chapter eid="LEV 2" />
  <chapter number="3" style="c" sid="LEV 3" />
  <para style="s">मेलबलि की विधि</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 3:1" />“जै उसका चढ़ावा मेलबलि का हो, अर जै वो गां-बळधां म्ह तै किसे नै चढ़ावै, तो चाहे वो पशु नर हो या मादा, पर जो निर्दोष हो उस्से नै वो यहोवा कै आग्गै चढ़ावै। <verse eid="LEV 3:1" /><verse number="2" style="v" sid="LEV 3:2" />अर वो अपणा हाथ अपणे चढ़ावै के पशु कै सिर पै धरै अर उसनै मिलापआळे तम्बू कै दरबाजे पै बलि करै; अर हारुन के बेट्टे जो याजक सै वे उसकै लहू नै वेदी कै चौगरदे नै छिड़कै। <verse eid="LEV 3:2" /><verse number="3" style="v" sid="LEV 3:3" />वो मेलबलि म्ह तै यहोवा कै खात्तर हवन करै, यानिके जिस चर्बी तै आंतड़ी ढकी रहवै सै, अर जो चर्बी उन म्ह लिपटी रहवै सै वो भी, <verse eid="LEV 3:3" /><verse number="4" style="v" sid="LEV 3:4" />अर दोन्‍नु गुर्दे अर उनकै उप्पर की चर्बी जो कमर कै धोरै होवै सै, अर गुर्देयां सुधा कळेजे कै उप्पर की झिल्‍ली, इन सारया नै वो न्यारा करै। <verse eid="LEV 3:4" /><verse number="5" style="v" sid="LEV 3:5" />फेर हारुन के बेट्टे इननै वेदी पै उस होमबलि कै उप्पर जळावै, जो उन लाकड़ियाँ पै होवैगी जो आग कै उप्पर सै, ताके यो यहोवा कै खात्तर सुखदायक सुगन्धआळा हवन ठहरै।”<verse eid="LEV 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 3:6" />“जै यहोवा के मेलबलि कै खात्तर उसका चढ़ावा भेड़-बकरियाँ म्ह तै हो, तो चाहे वो नर हो या मादा, पर जो निर्दोष हो उस्से ताहीं वो चढ़ावै। <verse eid="LEV 3:6" /><verse number="7" style="v" sid="LEV 3:7" />जै वो भेड़ का बच्‍चा चढ़ान्दा हो, तो उसनै यहोवा कै स्याम्ही चढ़ावै, <verse eid="LEV 3:7" /><verse number="8" style="v" sid="LEV 3:8" />अर वो अपणे चढ़ावा के पशु कै सिर पै हाथ धरै अर उसनै मिलापआळे तम्बू कै आग्गै बलि करै; अर हारुन के बेट्टे उसके लहू नै वेदी कै चौगरदे नै छिड़कै। <verse eid="LEV 3:8" /><verse number="9" style="v" sid="LEV 3:9" />फेर मेलबलि नै यहोवा कै खात्तर हवन करै, अर उसकी चर्बी भरी मोट्टी पुन्झड़ नै वो रीढ़ की हाड्ड़ी कै धोरै तै न्यारा करै, अर जिस चर्बी तै आंतड़ी ढकी रहवै सै, अर जो चर्बी उन म्ह लिपटी होवै सै, <verse eid="LEV 3:9" /><verse number="10" style="v" sid="LEV 3:10" />अर दोन्‍नु गुर्दे, अर जो चर्बी उनकै उप्पर कमर कै धोरै होवै सै, अर गुर्देयां सुधा कळेजे कै उप्पर की झिल्‍ली, इन सारया नै वो न्यारा करै। <verse eid="LEV 3:10" /><verse number="11" style="v" sid="LEV 3:11" />अर याजक इननै वेदी पै जळावै; यो यहोवा कै खात्तर हवन रूपी खाणा ठहरै।”<verse eid="LEV 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 3:12" />“जै वो बकरा या बकरी चढ़ावै, तो उसनै यहोवा कै स्याम्ही चढ़ावै। <verse eid="LEV 3:12" /><verse number="13" style="v" sid="LEV 3:13" />अर वो अपणा हाथ उसकै सिर पै धरै, अर उसनै मिलापआळे तम्बू कै आग्गै बलि करै; अर हारुन के बेट्टे उस लहू नै वेदी कै चौगरदे नै छिड़कै। <verse eid="LEV 3:13" /><verse number="14" style="v" sid="LEV 3:14" />फेर वो उस म्ह तै अपणा चढ़ावा यहोवा कै खात्तर हवन करकै चढ़ावै, अर जिस चर्बी तै आंतड़ी ढकी रहवै सैं, अर जो चर्बी उन म्ह लिपटी होवै सै वो भी, <verse eid="LEV 3:14" /><verse number="15" style="v" sid="LEV 3:15" />अर दोन्‍नु गुर्दे अर जो चर्बी उनकै उप्पर कमर कै धोरै होवै सै, अर गुर्देयां सुधा कळेजे कै उप्पर की झिल्‍ली, इन सारया नै वो न्यारा करै। <verse eid="LEV 3:15" /><verse number="16" style="v" sid="LEV 3:16" />अर याजक उननै वेदी पै जळावै; यो हवन रूपी खाणा सै जो सुखदायक सुगन्ध कै खात्तर होवै सै; क्यूँके सारी चर्बी यहोवा की सै। <verse eid="LEV 3:16" /><verse number="17" style="v" sid="LEV 3:17" />यो थारे घरां म्ह थारी पीढ़ी-पीढ़ी कै खात्तर सदा की विधि ठैहरैगी के थम चर्बी अर लहू कदे भी ना खाओ।”<verse eid="LEV 3:17" /></para>
  <chapter eid="LEV 3" />
  <chapter number="4" style="c" sid="LEV 4" />
  <para style="s">पापबलि की विधि</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 4:1" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 4:1" /><verse number="2" style="v" sid="LEV 4:2" />“इस्राएलियाँ तै न्यू कह के जो कोए माणस उन काम्मां म्ह तै जिन ताहीं यहोवा नै मना करया सै, किसे काम नै भूल तै करकै पापी हो जावै; <verse eid="LEV 4:2" /><verse number="3" style="v" sid="LEV 4:3" />अर जै अभिषिक्त<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="fq" closed="false">अभिषिक्त </char><char style="ft" closed="false">महायाजक</char></note> याजक इसा पाप करै, जिसतै प्रजा कसूरवार ठहरै, तो अपणे पाप कै कारण वो एक निर्दोष बाछड़ा यहोवा नै पापबलि करकै चढ़ावै। <verse eid="LEV 4:3" /><verse number="4" style="v" sid="LEV 4:4" />वो उस बाछड़े नै मिलापआळे तम्बू के दरबाजे पै यहोवा कै आग्गै ले जाकै उसकै सिर पै हाथ धरै, अर उस बाछड़े नै यहोवा कै स्याम्ही बलि करै। <verse eid="LEV 4:4" /><verse number="5" style="v" sid="LEV 4:5" />अर अभिषिक्त याजक बाछड़े कै लहू म्ह तै कुछ लेकै मिलापआळे तम्बू म्ह ले जावै; <verse eid="LEV 4:5" /><verse number="6" style="v" sid="LEV 4:6" />अर याजक अपणी आंगळी लहू म्ह डबो-डबो कै अर उस म्ह तै कुछ लेकै पवित्र स्‍थान कै बीचआळे पड़दे कै आग्गै यहोवा कै स्याम्ही सात बार छिड़कै। <verse eid="LEV 4:6" /><verse number="7" style="v" sid="LEV 4:7" />अर याजक उस लहू म्ह तै कुछ और लेकै खुशबुदार धूप की वेदी कै सीन्गां पै जो मिलापआळे तम्बू म्ह सै यहोवा कै स्याम्ही लगावै; फेर बाछड़े के सारे लहू नै वेदी कै पावेयां पै होमबलि की वेदी जो मिलापआळे तम्बू कै दरबाजे पै सै उण्डेल देवै। <verse eid="LEV 4:7" /><verse number="8" style="v" sid="LEV 4:8" />फेर वो पापबलि कै बाछड़े की सारी चर्बी नै उसतै न्यारा करै, यानिके जिस चर्बी तै आंतड़ी ढकी होवै सै, अर जितनी चर्बी उन म्ह लिपटी रहवै सै, <verse eid="LEV 4:8" /><verse number="9" style="v" sid="LEV 4:9" />अर दोन्‍नु गुर्दे अर उनकै उप्पर की चर्बी जो कमर कै धोरै होवै सै, अर गुर्देयां सुधा कळेजे कै उप्पर की झिल्‍ली, इन सारया नै वो इस तरियां न्यारा करै, <verse eid="LEV 4:9" /><verse number="10" style="v" sid="LEV 4:10" />जिस तरियां मेलबलि आळे चढ़ावै के बाछड़े तै न्यारी करी जावै सैं, अर याजक इननै होमबलि की वेदी पै जळावै। <verse eid="LEV 4:10" /><verse number="11" style="v" sid="LEV 4:11" />पर उस बाछड़े की खाल, पैर, सिर, आंतड़ी, गोबर, <verse eid="LEV 4:11" /><verse number="12" style="v" sid="LEV 4:12" />अर सारा माँस, यानिके सारा बाछड़ा छावणी तै बाहर शुद्ध जगहां म्ह, जड़ै राख गेरी जावैगी, ले जाकै लाकड़ी पै धरकै आग तै जळावै; जड़ै राख गेरी जावै सै वो ओड़ैए जळाया जावै।”<verse eid="LEV 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 4:13" />“जै इस्राएल की सारी मण्डळी<note caller="+" style="f"><char style="fr" closed="false">4:13 </char><char style="fq" closed="false">मण्डळी </char><char style="ft" closed="false">इस्राएलियाँ के सारे माणस</char></note> अज्ञानता कै कारण पाप करै अर वा बात मण्डळी की आँखां तै लुक्ही हो, अर वे यहोवा के किसे हुकम कै खिलाफ किमे करकै कसूरवार ठहरे हों; <verse eid="LEV 4:13" /><verse number="14" style="v" sid="LEV 4:14" />तो जिब उनका करया होया पाप जाहिर हो ज्या फेर मण्डळी एक बाछड़े नै पापबलि करकै चढ़ावै। वो उस ताहीं मिलापआळे तम्बू कै आग्गै ले जावै, <verse eid="LEV 4:14" /><verse number="15" style="v" sid="LEV 4:15" />अर मण्डळी के बुजुर्ग माणस अपणे-अपणे हाथ्थां नै यहोवा कै आग्गै बाछड़े कै सिर पै धरैं, अर वो बाछड़ा यहोवा कै स्याम्ही बलि करया जावै। <verse eid="LEV 4:15" /><verse number="16" style="v" sid="LEV 4:16" />फेर अभिषिक्त याजक बाछड़े कै लहू म्ह तै कुछ मिलापआळे तम्बू म्ह ले जावै; <verse eid="LEV 4:16" /><verse number="17" style="v" sid="LEV 4:17" />अर याजक अपणी आंगळी लहू म्ह डबो-डबो कै उस ताहीं बीचआळे पड़दे कै आग्गै सात बार यहोवा कै स्याम्ही छिड़कै। <verse eid="LEV 4:17" /><verse number="18" style="v" sid="LEV 4:18" />अर उस्से लहू म्ह तै वेदी कै सीन्गां पै जो यहोवा कै आग्गै मिलापआळे तम्बू म्ह सै लगावै; अर बच्या होया सारा लहू होमबलि की वेदी कै पावेयां पै जो मिलापआळे तम्बू कै दरबाजे पै सै उण्डेल दे। <verse eid="LEV 4:18" /><verse number="19" style="v" sid="LEV 4:19" />अर वो बाछड़े की सारी चर्बी लिकाड़कै वेदी पै जळावै। <verse eid="LEV 4:19" /><verse number="20" style="v" sid="LEV 4:20" />जिस तरियां पापबलि कै बाछड़े तै करया था उस्से तरियां ए इसनै भी करै; इस ढाळ याजक इस्राएलियाँ कै खात्तर प्रायश्चित करै, फेर उनका पाप माफ करया जावैगा। <verse eid="LEV 4:20" /><verse number="21" style="v" sid="LEV 4:21" />अर वो बाछड़े नै छावणी तै बाहर ले जाकै उस्से ढाळ जळावै जिस तरियां पैहल्या बाछड़े ताहीं जळाया था; यो तो मण्डळी कै कारण पापबलि ठहरैगा।”<verse eid="LEV 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 4:22" />“जिब कोए प्रधान माणस पाप करकै, यानिके अपणे परमेसवर यहोवा के किसे हुकम कै खिलाफ भूल तै किमे करकै कसूरवार हो जावै, <verse eid="LEV 4:22" /><verse number="23" style="v" sid="LEV 4:23" />अर उसका पाप उसपै जाहिर हो जावै, तो वो एक बेकसूर बकरा बलिदान करण कै खात्तर ले आवै; <verse eid="LEV 4:23" /><verse number="24" style="v" sid="LEV 4:24" />अर बकरे कै सिर पै अपणा हाथ धरै, अर बकरे नै उस जगहां पै बलि करै जड़ै होमबलि पशु यहोवा कै आग्गै बलि करे जावै सैं; यो पापबलि ठहरैगा। <verse eid="LEV 4:24" /><verse number="25" style="v" sid="LEV 4:25" />फेर याजक अपणी आन्गळी तै पापबलि पशु कै लहू म्ह तै कुछ लेकै होमबलि की वेदी कै सीन्गां पै लगावै, अर उसका लहू होमबलि की वेदी कै पावेयां पै उण्डेल दे। <verse eid="LEV 4:25" /><verse number="26" style="v" sid="LEV 4:26" />अर वो उसकी सारी चर्बी नै मेलबलि की चर्बी की ढाळ वेदी पै जळावै; अर याजक उसकै पाप कै बारै म्ह प्रायश्चित करै, फेर वो माफ करया जावैगा।”<verse eid="LEV 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 4:27" />“जै साधारण माणसां म्ह तै कोए अज्ञानता तै पाप करै, यानिके कोए इसा काम जिस ताहीं यहोवा नै मना करया हो करकै कसूरवार हो ज्या, अर उसका वो पाप उसपै जाहिर हो जावै, <verse eid="LEV 4:27" /><verse number="28" style="v" sid="LEV 4:28" />तो वो उस पाप कै कारण एक बेकसूर बकरी नै बलिदान कै खात्तर ले आवै; <verse eid="LEV 4:28" /><verse number="29" style="v" sid="LEV 4:29" />अर वो अपणा हाथ पापबलि पशु कै सिर पै धरै, अर होमबलि कै जगहां पै पापबलि पशु का बलिदान करै। <verse eid="LEV 4:29" /><verse number="30" style="v" sid="LEV 4:30" />अर याजक उसके लहू म्ह तै अपणी आन्गळी तै कुछ लेकै होमबलि की वेदी कै सीन्गां पै लगावै, अर उसके सारे लहू नै उस्से वेदी कै पावेयां पै उण्डेल देवै। <verse eid="LEV 4:30" /><verse number="31" style="v" sid="LEV 4:31" />अर वो उसकी सारी चर्बी नै मेलबलि पशु की चर्बी की ढाळ न्यारा करै, फेर याजक उसनै वेदी पै यहोवा कै खात्तर सुखदायक सुगन्ध कै खात्तर जळावै; अर इस तरियां याजक उसकै खात्तर प्रायश्चित करै, फेर उस ताहीं माफी मिल ज्यागी।”<verse eid="LEV 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 4:32" />“जै वो पापबलि कै खात्तर एक मेम्‍ना ले आवै, तो वो निर्दोष मादा हो, <verse eid="LEV 4:32" /><verse number="33" style="v" sid="LEV 4:33" />अर वो अपणा हाथ पापबलि पशु कै सिर पै धरै, अर उसनै पापबलि कै खात्तर उड़ैए बलिदान करै जड़ै होमबलि पशु बलि करया जावै सै। <verse eid="LEV 4:33" /><verse number="34" style="v" sid="LEV 4:34" />फेर याजक अपणी आन्गळी तै पापबलि कै लहू म्ह तै कुछ लेकै होमबलि की वेदी कै सीन्गां पै लगावै, अर उसके सारे लहू नै वेदी कै पावेयां पै उण्डेल देवै। <verse eid="LEV 4:34" /><verse number="35" style="v" sid="LEV 4:35" />अर वो उसकी सारी चर्बी नै मेलबलि आळे मेम्‍ने की चर्बी की ढाळ न्यारा करै, अर याजक उसनै वेदी पै यहोवा कै हवनां कै उप्पर जळावै; अर इस तरियां याजक उसकै पाप कै खात्तर प्रायश्चित करै, अर वो माफ करया जावैगा।”<verse eid="LEV 4:35" /></para>
  <chapter eid="LEV 4" />
  <chapter number="5" style="c" sid="LEV 5" />
  <para style="s">दोषबलि की विधि</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 5:1" />“जै कोए गवाह होकै इसा पाप करै के कसम खुवाकै बुझ्झण पै भी के तन्‍नै यो सुण्या या जाणै सै, अर वा बात जाहिर ना करै, तो उसनै अपणे अधर्म का बोझ ठाणा पड़ैगा। <verse eid="LEV 5:1" /><verse number="2" style="v" sid="LEV 5:2" />या जै कोए किसे अशुद्ध चीज नै भूल तै छू ले, चाहे वो अशुद्ध जंगळी-पशु की हो, या घरेलू पशु की, या रेंगण आळे जीव-जन्तु की लोथ हो, तो वो अशुद्ध होकै कसूरवार ठहरैगा। <verse eid="LEV 5:2" /><verse number="3" style="v" sid="LEV 5:3" />या जै कोए माणस किसे अशुद्ध चीज नै भूल तै छू ले, चाहे वो अशुद्ध चीज किसे भी ढाळ की क्यूँ ना हो जिसतै माणस अशुद्ध हो ज्या सै तो जिब वो उस बात नै जाण लेगा फेर वो कसूरवार ठहरैगा। <verse eid="LEV 5:3" /><verse number="4" style="v" sid="LEV 5:4" />या जै कोए बुरा या भला करण खात्तर बिना सोच्‍चे-समझे कसम खावै, चाहे किसे ढाळ की बात वो बिना सोच्‍चे-समझे कसम खाकै कहवै, तो इसी बात म्ह वो कसूरवार उस बखत होवैगा जिब उस ताहीं बेरा लाग ज्यागा। <verse eid="LEV 5:4" /><verse number="5" style="v" sid="LEV 5:5" />अर जिब वो इन बात्तां म्ह तै किसे भी बात म्ह कसूरवार हो, तो जिस बारै म्ह उसनै पाप करया हो वो उसनै मान ले, <verse eid="LEV 5:5" /><verse number="6" style="v" sid="LEV 5:6" />अर वो यहोवा कै स्याम्ही अपणा दोषबलि ले आवै, यानिके उस पाप कै कारण वो एक मादा भेड़ या बकरी पापबलि करण कै खात्तर ले आवै; फेर याजक उस पाप कै बारै म्ह उसकै खात्तर प्रायश्चित करै।”<verse eid="LEV 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 5:7" />“पर जै उसकी भेड़ या बकरी देण की ओकात ना हो, तो अपणे पाप कै कारण दो पिंडुक या कबूतरी के दो बच्‍चे दोषबलि चढ़ाण कै खात्तर यहोवा कै धोरै ले आवै, उन म्ह तै एक तो पापबलि कै खात्तर अर दूसरा होमबलि कै खात्तर। <verse eid="LEV 5:7" /><verse number="8" style="v" sid="LEV 5:8" />वो उन ताहीं याजक कै धोरै ले आवै, अर याजक पापबलि आळे नै पैहल्या चढ़ावै, अर उसकी नाड़ मरोड़दे, पर न्यारा ना करै, <verse eid="LEV 5:8" /><verse number="9" style="v" sid="LEV 5:9" />अर वो पापबलि पशु कै लहू म्ह तै कुछ वेदी कै बाजू पै छिड़कै, अर जो लहू बाकी रहवै सै वो वेदी कै पावेयां पै उण्डेल्या जावै; वो तो पापबलि ठहरैगा। <verse eid="LEV 5:9" /><verse number="10" style="v" sid="LEV 5:10" />फेर दुसरे पंछी नै वो नियम<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="fq" closed="false">नियम </char><char style="ft" closed="false">वो सारे नियम-कायदे जो पैहले ए बताये गए थे</char></note> कै मुताबिक होमबलि करै, अर याजक उसकै पाप का प्रायश्चित करैं, अर फेर वो माफ करया जावैगा।”<verse eid="LEV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 5:11" />“जै वो दो पिंडुक या कबूतरी कै दो बच्‍चे भी न्ही दे सकै, तो वो अपणे पाप कै कारण अपणा चढ़ावा एपा<note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="fq" closed="false">एपा </char><char style="ft" closed="false">1 किलोग्राम</char></note> का दसमां हिस्सा मैद्दा पापबलि करकै ले आवै; उसपै ना तो वो तेल गेरै, अर ना लोबान धरै, क्यूँके वो पापबलि होवैगा <verse eid="LEV 5:11" /><verse number="12" style="v" sid="LEV 5:12" />वो उस ताहीं याजक कै धोरै ले जावै, अर याजक उस म्ह तै अपणी मुट्ठी भर याद दिलाण आळा हिस्सा जाणकै वेदी पै यहोवा कै हवनां कै उप्पर जळावै; वो तो पापबलि ठहरैगा। <verse eid="LEV 5:12" /><verse number="13" style="v" sid="LEV 5:13" />अर इन बात्तां म्ह तै किसे भी बात कै बारै म्ह जो कोए पाप करै, याजक उसका प्रायश्चित करै, अर फेर वो पाप माफ करया जावैगा। अर इस पापबलि का बाकी अन्‍नबलि का बाकी समान याजक का ठहरैगा।”<verse eid="LEV 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 5:14" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 5:14" /><verse number="15" style="v" sid="LEV 5:15" />“जै कोए यहोवा की पवित्र करी होई चिज्जां कै बारै म्ह भूल तै बिश्वासघात करै अर पापी ठहरै, तो वो यहोवा कै धोरै एक निर्दोष मिंढा दोषबलि कै खात्तर ले आवै; उसका दाम पवित्र स्‍थान कै शेकेल कै मुताबिक उतने ए शेकेल चाँदी का हो जितना याजक ठहरावै। <verse eid="LEV 5:15" /><verse number="16" style="v" sid="LEV 5:16" />अर जिस पवित्र चीज कै बारै म्ह उसनै पाप करया हो, उस म्ह वो पाँचवाँ हिस्सा और बढ़ाकै याजक नै दे; अर याजक दोषबलि का मिंढा चढ़ाकै उसकै खात्तर प्रायश्चित करै, फेर उसका पाप माफ करया जावैगा। <verse eid="LEV 5:16" /><verse number="17" style="v" sid="LEV 5:17" />जै कोए इसा पाप करै, के उन काम्मां म्ह तै जिन ताहीं यहोवा नै मना करया सै किसे काम नै करै, तो चाहे वो उसतै अनजाणे म्ह होया हो, फेर भी वो कसूरवार ठहरैगा, अर उसनै अपणे अधर्म का बोझ ठाणा पड़ैगा। <verse eid="LEV 5:17" /><verse number="18" style="v" sid="LEV 5:18" />ज्यांतै वो एक बेकसूर मिंढा दोषबलि करकै याजक कै धोरै ले आवै, वो उतने दाम का हो जितना याजक ठहरावै, अर याजक उसकै खात्तर उसकी उस भूल का जो उसनै अनजाणे म्ह करी हो प्रायश्चित करै, अर वो माफ करया जावैगा। <verse eid="LEV 5:18" /><verse number="19" style="v" sid="LEV 5:19" />या दोषबलि ठहरै; क्यूँके वो माणस पक्‍का यहोवा कै स्याम्ही कसूरवार ठहरैगा।”<verse eid="LEV 5:19" /></para>
  <chapter eid="LEV 5" />
  <chapter number="6" style="c" sid="LEV 6" />
  <para style="s">बेईमान माणसां खात्तर दोषबलि</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 6:1" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 6:1" /><verse number="2" style="v" sid="LEV 6:2" />“जै कोए यहोवा का बिश्वासघात करकै पापी ठहरै, जिसा के धरोहर, या लेण-देण, या लूट कै बारै म्ह अपणे भाई तै छळ करै, या उसपै अत्याचार करै, <verse eid="LEV 6:2" /><verse number="3" style="v" sid="LEV 6:3" />या पड़ी होई चीज नै पाकै उसकै बारै झूठ बोल्‍लै अर झूठ्ठी कसम भी खावै; इसी कोए भी बात क्यूँ ना हो जिसनै करकै माणस पापी ठहरै सै, <verse eid="LEV 6:3" /><verse number="4" style="v" sid="LEV 6:4" />तो जिब वो इसा काम करकै कसूरवार हो ज्या, फेर जो भी चीज उसनै लूट, या अत्याचार करकै, या धरोहर, या पड़ी पाई हो; <verse eid="LEV 6:4" /><verse number="5" style="v" sid="LEV 6:5" />चाहे कोए चीज क्यूँ ना हो जिसकै बारै म्ह उसनै झूठ्ठी कसम खाई हो; तो वो उस ताहीं पूरी-पूरी बोहड़ा दे, अर पाँचवाँ हिस्सा भी बढ़ाकै भर दे, जिस दिन न्यू बेरा पाट्टै के वो कसूरवार सै, उस्से दिन वो उस चीज नै उसकै माल्‍लिक तै वापस दे दे। <verse eid="LEV 6:5" /><verse number="6" style="v" sid="LEV 6:6" />अर वो यहोवा कै स्याम्ही अपणा दोषबलि भी ले आवै, यानिके एक बेकसूर मिंढा दोषबलि कै खात्तर याजक कै धोरै ले आवै, वो उतने ए दाम का हो जितना याजक ठहरावै। <verse eid="LEV 6:6" /><verse number="7" style="v" sid="LEV 6:7" />इस तरियां याजक उसकै खात्तर यहोवा कै स्याम्ही प्रायश्चित करै, अर जिस काम नै करकै वो कसूरवार होया सै उसकी माफी उसनै मिलैगी।”<verse eid="LEV 6:7" /></para>
  <para style="s">न्यारे-न्यारे ढाळ के बलिदानां की विधि</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 6:8" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 6:8" /><verse number="9" style="v" sid="LEV 6:9" />“हारुन अर उसके बेट्याँ नै हुकम देकै न्यू कह के होमबलि के नियम-कायदे ये सै: होमबलि लाकड़ी कै उप्पर रात भर तड़कैए ताहीं वेदी पै पड्या रहवै, अर वेदी की आग वेदी पै जळदी रहवै। <verse eid="LEV 6:9" /><verse number="10" style="v" sid="LEV 6:10" />अर याजक अपणे सणी कै कपड़ेयां अर अपणे तन पै अपणी सणी की जाँघिया पहरकै होमबलि की राख, जो आग कै भस्म करण तै वेदी पै रह जावै, उसनै ठाकै वेदी कै धोरै धरै। <verse eid="LEV 6:10" /><verse number="11" style="v" sid="LEV 6:11" />फेर वो अपणे ये कपड़े तारकै दुसरे कपड़े पहरकै राख नै छावणी तै बाहर किसे शुद्ध जगहां पै ले जावै। <verse eid="LEV 6:11" /><verse number="12" style="v" sid="LEV 6:12" />वेदी पै आग जळदी रहवै, अर कदे बुझण न्ही पावै; अर याजक हरेक दिन तड़कैए तड़क नै उसपै लाकड़ी बाळ कै होमबलि के टुकड्या नै उसकै उप्पर सजा कै धरदे, अर उसकै उप्पर मेलबलियां की चर्बी नै जळाया करै। <verse eid="LEV 6:12" /><verse number="13" style="v" sid="LEV 6:13" />वेदी पै आग लगातार जळदी रहवै; वो कदे बुझण न्ही पावै।”<verse eid="LEV 6:13" /></para>
  <para style="s">अन्‍नबलि</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 6:14" />“अन्‍नबलि के नियम-कायदे इस तरियां सै: हारुन के बेट्टे उसनै वेदी कै आग्गै यहोवा कै धोरै ले आवै। <verse eid="LEV 6:14" /><verse number="15" style="v" sid="LEV 6:15" />अर वो अन्‍नबलि के तेल मिले होए मैदे म्ह तै मुट्ठी भर अर उसकै उप्पर का सारा लोबान ठाकै अन्‍नबलि कै यादगारी के तौर पै इस हिस्से नै यहोवा कै स्याम्ही सुखदायक सुगन्ध कै खात्तर वेदी पै जळावै। <verse eid="LEV 6:15" /><verse number="16" style="v" sid="LEV 6:16" />अर उस म्ह तै जो बाकी रह जावै उसनै हारुन अर उसके बेट्टे खावै; वो बिना खमीर पवित्र स्‍थान म्ह खाया जावै, यानिके वे मिलापआळे तम्बू कै आँगण म्ह उसनै खावैं। <verse eid="LEV 6:16" /><verse number="17" style="v" sid="LEV 6:17" />वो खमीर कै गेल्या पकाया ना जावै; क्यूँके मन्‍नै अपणे हवन म्ह तै उस ताहीं उनका खुद का हिस्सा होण कै खात्तर दिया सै; ज्यांतै जिसा पापबलि अर दोषबलि परमपवित्र सैं उस्से ढाळ वो भी सै। <verse eid="LEV 6:17" /><verse number="18" style="v" sid="LEV 6:18" />थारी पीढ़ी-पीढ़ी म्ह हारुन के वंश के सारे आदमी उस म्ह तै खा सकै सैं, यहोवा के हवनां म्ह तै यो उनका हिस्सा सदा बण्या रहवैगा; जो कोए उन हवनां नै छुवै वो पवित्र ठहरैगा।”<verse eid="LEV 6:18" /></para>
  <para style="s">याजकां की अन्‍नबलि</para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 6:19" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 6:19" /><verse number="20" style="v" sid="LEV 6:20" />“जिस दिन हारुन का अभिषेक हो उस दिन वो अपणे बेट्याँ कै गेल्या यहोवा नै यो चढ़ावा चढ़ावै; यानिके एपा का दसमां हिस्सा मैद्दा रोज अन्‍नबलि म्ह चढ़ावै, उस म्ह तै आध्धा तड़कैए तड़क नै अर आध्धा साँझ कै बखत चढ़ावै। <verse eid="LEV 6:20" /><verse number="21" style="v" sid="LEV 6:21" />वो तवे पै तेल तै पकाया जावै; जिब वो तेल तै तर हो ज्या फेर उसनै ले आईये, इस अन्‍नबलि के पके होए टुकड़े यहोवा कै सुखदायक सुगन्ध कै खात्तर चढ़ाईयों। <verse eid="LEV 6:21" /><verse number="22" style="v" sid="LEV 6:22" />हारुन के बेट्याँ म्ह तै जो भी उस याजक पद पै अभिषिक्त होवैगा, वो भी उस्से तरियां का चढ़ावा चढ़ाया करैं; या धार्मिक विधि सदा कै खात्तर सै, के यहोवा कै स्याम्ही वो पूरा चढ़ावा जळाया जावै। <verse eid="LEV 6:22" /><verse number="23" style="v" sid="LEV 6:23" />याजक के पूरे अन्‍नबलि सारे जळावै जावैं; वो कदे न्ही खाया जावै।”<verse eid="LEV 6:23" /></para>
  <para style="s">पापबलि</para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 6:24" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 6:24" /><verse number="25" style="v" sid="LEV 6:25" />“हारुन अर उसकै बेट्याँ तै या कह के पापबलि के नियम-कायदे ये सै: जिस जगहां म्ह होमबलि पशु मारया जावै सै उस्से म्ह पापबलि पशु भी यहोवा कै स्याम्ही बलि करया जावै; वो परमपवित्र सै। <verse eid="LEV 6:25" /><verse number="26" style="v" sid="LEV 6:26" />जो याजक पापबलि चढ़ावै वो उस ताहीं खावै; वो पवित्र स्‍थान म्ह यानिके मिलापआळे तम्बू कै आँगण म्ह खाया जावै। <verse eid="LEV 6:26" /><verse number="27" style="v" sid="LEV 6:27" />जो कुछ उसकै माँस तै छुया जावै, वो पवित्र ठहरैगा; अर जै उसके लहू के छिट्टे किसे के कपड़यां पै पड़ ज्यां, तो उस ताहीं पवित्र स्‍थान म्ह धो दियो। <verse eid="LEV 6:27" /><verse number="28" style="v" sid="LEV 6:28" />अर वो माट्टी का बरतन जिस म्ह वो पकाया गया हो तोड़ दिया जावै; जै वो पीत्तळ कै बरतन म्ह उबाळया गया हो, तो वो मांज्या जावै, अर पाणी तै धो लिया जावै। <verse eid="LEV 6:28" /><verse number="29" style="v" sid="LEV 6:29" />याजकां म्ह तै सारे माणस उसनै खा सकै सै; वो परमपवित्र चीज सै। <verse eid="LEV 6:29" /><verse number="30" style="v" sid="LEV 6:30" />पर जिस पापबलि पशु कै लहू म्ह तै कुछ भी लहू मिलापआळे तम्बू कै भित्तर पवित्र स्‍थान म्ह प्रायश्चित करण खात्तर पोहचाया जावै उसका माँस कदे न्ही खाया जावै; वो आग म्ह जळा दिया जावै।”<verse eid="LEV 6:30" /></para>
  <chapter eid="LEV 6" />
  <chapter number="7" style="c" sid="LEV 7" />
  <para style="s">दोषबलि</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 7:1" />“फेर दोषबलि<note caller="+" style="f"><char style="fr" closed="false">7:1 </char><char style="fq" closed="false">दोषबलि </char><char style="ft" closed="false">करया होया पाप/गलती खात्तर भरपाई</char></note> के नियम-कायदे ये सै। वो परमपवित्र सै; <verse eid="LEV 7:1" /><verse number="2" style="v" sid="LEV 7:2" />जिस जगहां पै होमबलि पशु का वध करैं सै उस्से जगहां पै दोषबलि पशु भी बलि करैं, अर उसके लहू नै याजक वेदी पै चौगरदे छिड़कै। <verse eid="LEV 7:2" /><verse number="3" style="v" sid="LEV 7:3" />अर वो उस म्ह की सारी चर्बी नै चढ़ावै, यानिके उसकी मोट्टी पुन्झड़ नै, अर जिस चर्बी तै आंतड़ी ढकी रहवै सै वा भी, <verse eid="LEV 7:3" /><verse number="4" style="v" sid="LEV 7:4" />अर दोन्‍नु गुर्दे अर जो चर्बी उनकै उप्पर अर कमर कै धोरै होवै सै, अर गुर्देयां सुधा कळेजे कै उप्पर की झिल्‍ली; इन सारया नै वो न्यारा करै; <verse eid="LEV 7:4" /><verse number="5" style="v" sid="LEV 7:5" />अर याजक इन ताहीं वेदी पै यहोवा कै खात्तर हवन करै; फेर वो दोषबलि होवैगा। <verse eid="LEV 7:5" /><verse number="6" style="v" sid="LEV 7:6" />याजकां म्ह के सारे माणस उस म्ह तै खा सकै सैं; वो किसे पवित्र स्‍थान म्ह खाया जावै; क्यूँके वो परमपवित्र सै। <verse eid="LEV 7:6" /><verse number="7" style="v" sid="LEV 7:7" />जिसा पापबलि सै उस्से तरियां ए दोषबलि भी सै, उन दोनुआ के एक ए नियम-कायदे सै; जो याजक उन बलियां नै चढ़ाकै प्रायश्चित करै सै वोए उन चिज्जां नै ले-ले। <verse eid="LEV 7:7" /><verse number="8" style="v" sid="LEV 7:8" />अर जो याजक किसे कै खात्तर होमबलि नै चढ़ावै उस होमबलि के पशु की खाल नै वोए याजक ले-ले। <verse eid="LEV 7:8" /><verse number="9" style="v" sid="LEV 7:9" />अर तंदूर म्ह, या कढ़ाही म्ह, या तवे पै पके होए सारे अन्‍नबलि उस्से याजक की होवैगीं जो उननै चढ़ावै सै। <verse eid="LEV 7:9" /><verse number="10" style="v" sid="LEV 7:10" />अर सारे अन्‍नबलि, जो चाहे तेल तै सणे होए हों चाहे सूखे हों, वे दोन्‍नु हारुन के सारे बेट्याँ नै एक बराबर मिलै।”<verse eid="LEV 7:10" /></para>
  <para style="s">मेलबलि</para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 7:11" />“जो कोए मेलबलि यहोवा कै खात्तर चढ़ाणा चाहवै सै उसके नियम-कायदे ये सै: <verse eid="LEV 7:11" /><verse number="12" style="v" sid="LEV 7:12" />जै वो उस ताहीं धन्यवाद कै खात्तर चढ़ावै, तो धन्यवाद-बलि कै गेल्या तेल तै सणे होए अखमीरी फुलके, अर तेल तै चोपड़ी होई अखमीरी रोट्टी, अर तेल तै सणे होए मैदे कै फुलके तेल तै तर चढ़ावै। <verse eid="LEV 7:12" /><verse number="13" style="v" sid="LEV 7:13" />अर वो अपणे धन्यवाद आळे मेलबलि कै गेल्या अखमीरी रोट्टी भी चढ़ावै। <verse eid="LEV 7:13" /><verse number="14" style="v" sid="LEV 7:14" />अर इस तरियां एक-एक चढ़ावे म्ह तै वो एक-एक रोट्टी यहोवा नै ठाणे की भेंट करकै चढ़ावै; वो मेलबलि कै लहू कै छिड़कण आळे याजक की होवैगी। <verse eid="LEV 7:14" /><verse number="15" style="v" sid="LEV 7:15" />अर उस धन्यवाद आळे मेलबलि का माँस बलिदान चढ़ाण कै दिन ए खाया जावै; उस म्ह तै कुछ भी तड़कैए ताहीं बाकी ना रहवै। <verse eid="LEV 7:15" /><verse number="16" style="v" sid="LEV 7:16" />पर जै उसकै बलिदान का चढ़ावा मन्‍नत का या स्वेच्छा का हो, तो उस बलिदान नै जिस दिन वो चढ़ाया जावै उस्से दिन वो खाया जावै, अर उस म्ह तै जो बाकी रह ज्या वो दुसरे दिन भी खाया जावै। <verse eid="LEV 7:16" /><verse number="17" style="v" sid="LEV 7:17" />पर जो कुछ बलिदान के माँस म्ह तै तीसरे दिन तक रह ज्या वो आग म्ह जळा दिया जावै। <verse eid="LEV 7:17" /><verse number="18" style="v" sid="LEV 7:18" />अर उसकै मेलबलि के माँस म्ह तै जै कुछ भी तीसरे दिन खाया जावै, तो वो कबूल न्ही करया जावैगा, अर ना उसके हित म्ह गिण्या जावैगा; वो घृणित काम समझया जावैगा, अर जो कोए उस म्ह तै खावै उसका अधर्म उस्से कै सिर पै पड़ैगा।”<verse eid="LEV 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 7:19" />“फेर जो माँस किसे अशुद्ध चीज तै छू जावै वो ना खाया जावै; वो आग म्ह जळा दिया जावै। फेर मेलबलि का माँस जितने शुद्ध हों वोए खावैं, <verse eid="LEV 7:19" /><verse number="20" style="v" sid="LEV 7:20" />पर जो अशुद्ध होकै यहोवा के मेलबलि कै माँस म्ह तै कुछ खावै सै वो अपणे लोगां म्ह तै नाश करया जावै। <verse eid="LEV 7:20" /><verse number="21" style="v" sid="LEV 7:21" />अर जै कोए किसे अशुद्ध चीज नै छू के यहोवा के मेलबलि पशु कै माँस म्ह तै खावै, तो वो भी अपणे माणसां म्ह तै नाश करया जावै, चाहे वो माणस की कोए अशुद्ध चीज या अशुद्ध पशु या कोए भी अशुद्ध अर घृणित चीज हो।”<verse eid="LEV 7:21" /></para>
  <para style="s">मना करया होया लहू अर चर्बी</para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 7:22" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 7:22" /><verse number="23" style="v" sid="LEV 7:23" />“इस्राएलियाँ तै इस तरियां कह: थम ना तो बळध की कुछ चर्बी खाईयों अर ना ए भेड़ या बकरी की। <verse eid="LEV 7:23" /><verse number="24" style="v" sid="LEV 7:24" />अर जो पशु खुद मर जावै, अर जो दुसरे पशु तै पाड़या जावै, उसकी चर्बी और काम म्ह इस्तमाल कर सको सों, पर उस ताहीं ना खाईयों। <verse eid="LEV 7:24" /><verse number="25" style="v" sid="LEV 7:25" />जो कोए इसे पशु की चर्बी खावैगा जिस म्ह तै माणस कुछ यहोवा कै खात्तर हवन करकै चढ़ाया करै सैं वो खाणआळा अपणे माणसां म्ह तै नाश करया जावैगा। <verse eid="LEV 7:25" /><verse number="26" style="v" sid="LEV 7:26" />अर थम अपणे घर म्ह किसे ढाळ का लहू, चाहे पंछी का हो चाहे पशु का हो, उसनै ना खाईयों। <verse eid="LEV 7:26" /><verse number="27" style="v" sid="LEV 7:27" />हरेक प्राणी जो किसे ढाळ का लहू खावैगा वो अपणे माणसां म्ह तै नाश करया जावैगा।”<verse eid="LEV 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 7:28" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 7:28" /><verse number="29" style="v" sid="LEV 7:29" />“इस्राएलियाँ तै इस तरियां कह: जो यहोवा कै खात्तर मेलबलि चढ़ावै वो उस्से मेलबलि म्ह तै यहोवा कै धोरै भेंट ले आवै; <verse eid="LEV 7:29" /><verse number="30" style="v" sid="LEV 7:30" />वो अपणे ए हाथ्थां तै यहोवा कै हवन नै, यानिके छात्ती सुधा चर्बी नै ले आवै के छात्ती हिलाणे की भेंट करकै यहोवा कै स्याम्ही हिलाई जावै। <verse eid="LEV 7:30" /><verse number="31" style="v" sid="LEV 7:31" />अर याजक चर्बी नै तो वेदी पै जळावै, पर छात्ती हारुन अर उसकै बेट्याँ की होवैगी। <verse eid="LEV 7:31" /><verse number="32" style="v" sid="LEV 7:32" />फेर थम अपणे मेलबलियां म्ह तै सोळी जाँघ नै भी ठाण की भेंट करकै याजक तै दियो; <verse eid="LEV 7:32" /><verse number="33" style="v" sid="LEV 7:33" />हारुन कै बेट्याँ म्ह तै जो मेलबलि कै लहू अर चर्बी नै चढ़ावै सोळी जाँघ उस्से का हिस्सा होवैगी। <verse eid="LEV 7:33" /><verse number="34" style="v" sid="LEV 7:34" />क्यूँके इस्राएलियाँ कै मेलबलियां म्ह तै हिलाणे की भेंट की छात्ती अर ठाण की भेंट की जाँघ नै लेकै मन्‍नै याजक हारुन अर उसकै बेट्याँ तै दिया सै, के यो सदा इस्राएल के माणसां की ओड़ तै उनका हक बण्या रहवै।”<verse eid="LEV 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 7:35" />“जिस दिन हारुन अर उसके बेट्टे यहोवा कै धोरै याजक पद कै खात्तर ल्याए गए, उस्से दिन यहोवा कै हवन म्ह तै उनका योए अभिषिक्त हिस्सा ठहराया गया; <verse eid="LEV 7:35" /><verse number="36" style="v" sid="LEV 7:36" />यानिके जिस दिन यहोवा नै उनका अभिषेक करया उस्से दिन उसनै हुकम दिया के उन ताहीं इस्राएल के माणसां की ओड़ तै यो हिस्सा रोज मिल्या करै; उनकी पीढ़ी-पीढ़ी कै खात्तर उनका योए हक ठहराया गया।”<verse eid="LEV 7:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 7:37" />होमबलि, अन्‍नबलि, पापबलि, दोषबलि, याजकां के संस्कार बलि, अर मेलबलि के नियम-कायदे योए सै; <verse eid="LEV 7:37" /><verse number="38" style="v" sid="LEV 7:38" />जिब यहोवा नै सीनै पर्वत कै धोरै के जंगळ म्ह मूसा तै हुकम दिया के इस्राएली मेरै खात्तर के-के चढ़ावा चढ़ावै, फेर उसनै उनतै योए नियम-कायदे दिये थे।<verse eid="LEV 7:38" /></para>
  <chapter eid="LEV 7" />
  <chapter number="8" style="c" sid="LEV 8" />
  <para style="s">हारुन अर उसके बेट्याँ का अभिषेक</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 8:1" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 8:1" /><verse number="2" style="v" sid="LEV 8:2" />“तू हारुन अर उसके बेट्याँ की पोशाक, अर अभिषेक के तेल, अर पापबलि के बाछड़े, अर दोन्‍नु मिंढे, अर अखमीरी रोट्टी की टोकरी नै <verse eid="LEV 8:2" /><verse number="3" style="v" sid="LEV 8:3" />मिलापआळे तम्बू कै दरबाजे पै ले आ, अर उड़ैए सारी मण्डळी नै कठ्ठा कर।”<verse eid="LEV 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 8:4" />यहोवा के इस हुकम कै मुताबिक मूसा नै करया; अर मण्डळी मिलापआळे तम्बू कै दरबाजे पै कठ्ठी होई। <verse eid="LEV 8:4" /><verse number="5" style="v" sid="LEV 8:5" />फेर मूसा नै मण्डळी तै कह्या, “जो काम करण का हुकम यहोवा नै दिया सै वो यो सै।”<verse eid="LEV 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 8:6" />फेर मूसा नै हारुन अर उसके बेट्याँ ताहीं धोरै ल्याकै पाणी तै नुहाया। <verse eid="LEV 8:6" /><verse number="7" style="v" sid="LEV 8:7" />फेर उसनै उनतै अंगरखा पैहराया, अर कटिबन्ध लपेटकै चोग्गा पिराह दिया, अर एपोद लगाकै एपोद के काढ़े होए पट्टे तै एपोद ताहीं बाँधकै कस दिया। <verse eid="LEV 8:7" /><verse number="8" style="v" sid="LEV 8:8" />अर उसनै चपरास लगाकै चपरास म्ह ऊरीम अर तुम्मीम धर दिए। <verse eid="LEV 8:8" /><verse number="9" style="v" sid="LEV 8:9" />फेर उसनै उसकै सिर पै पगड़ी बाँधकै पगड़ी कै स्याम्ही सोन्‍ने के टीक्‍के नै, यानिके पवित्र मुकुट ताहीं लगाया, जिस तरियां यहोवा नै मूसा तै हुकम दिया था।<verse eid="LEV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 8:10" />फेर मूसा नै अभिषेक का तेल लेकै निवास का अर जो कुछ उस म्ह था उन सारया का भी अभिषेक करकै उन ताहीं पवित्र करया। <verse eid="LEV 8:10" /><verse number="11" style="v" sid="LEV 8:11" />अर उस तेल म्ह तै कुछ उसनै वेदी पै सात बार छिड़क्या, अर सारे सामान सुधा वेदी का अर पावेयां सुधा हौदी का अभिषेक करकै पवित्र करया। <verse eid="LEV 8:11" /><verse number="12" style="v" sid="LEV 8:12" />अर उसनै अभिषेक कै तेल म्ह तै कुछ मूसा हारुन कै सिर पै गेर कै उसका अभिषेक करकै उस ताहीं पवित्र करया। <verse eid="LEV 8:12" /><verse number="13" style="v" sid="LEV 8:13" />फेर मूसा नै हारुन के बेट्याँ ताहीं धोरै ल्याकै, अंगरखे पिराह कै, कटिबन्ध बाँधकै उनकै सिर पै टोपी धर दी, जिस तरियां यहोवा नै मूसा तै हुकम दिया था।<verse eid="LEV 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 8:14" />फेर वो पापबलि कै बाछड़े नै धोरै लेग्या; अर हारुन अर उसकै बेट्याँ नै अपणे-अपणे हाथ पापबलि के बाछड़े कै सिर पै धरे। <verse eid="LEV 8:14" /><verse number="15" style="v" sid="LEV 8:15" />फेर वो बलि करया गया, अर मूसा नै लहू ताहीं लेकै आन्गळी तै वेदी कै च्यांरु सीन्गां पै लगाकै पवित्र करया, अर लहू ताहीं वेदी कै पावेयां पै उण्डेल दिया, अर उसकै खात्तर प्रायश्चित करकै उस ताहीं पवित्र करया। <verse eid="LEV 8:15" /><verse number="16" style="v" sid="LEV 8:16" />अर मूसा नै आंतड़ी पै की सारी चर्बी, अर कळेजे पै की झिल्‍ली, अर चर्बी सुधा दोन्‍नु गुर्देयां नै लेकै वेदी पै जळाया। <verse eid="LEV 8:16" /><verse number="17" style="v" sid="LEV 8:17" />पर बाछड़े म्ह तै जो कुछ बाकी रहग्या उस ताहीं, यानिके गोबर सुधा उसकी खाल अर माँस ताहीं उसनै छावणी तै बाहर आग म्ह जळा दिया, जिस तरियां यहोवा नै मूसा तै हुकम दिया था।<verse eid="LEV 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 8:18" />फेर वो होमबलि के मिंढे नै धोरै लेग्या, अर हारुन अर उसके बेट्याँ नै अपणे-अपणे हाथ मिंढे कै सिर पै धरै। <verse eid="LEV 8:18" /><verse number="19" style="v" sid="LEV 8:19" />फेर वो बलि करया गया, अर मूसा नै उसका लहू वेदी पै चौगरदे छिड़क्या। <verse eid="LEV 8:19" /><verse number="20" style="v" sid="LEV 8:20" />फेर मिंढा टुकड़े-टुकड़े करया गया, अर मूसा नै सिर अर चर्बी सुधा टुकड्या ताहीं जळाया। <verse eid="LEV 8:20" /><verse number="21" style="v" sid="LEV 8:21" />फेर आंतड़ी अर पैर पाणी तै धोये गए, अर मूसा नै पूरे मिंढे ताहीं वेदी पै जळाया, अर वो सुखदायक सुगन्ध देण कै खात्तर होमबलि अर यहोवा कै खात्तर हवन होग्या, जिस तरियां यहोवा नै मूसा तै हुकम दिया था।<verse eid="LEV 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 8:22" />फेर वो दुसरे मिंढे नै जो विधि का मिंढा था धोरै लेग्या, अर हारुन अर उसके बेट्याँ नै अपणे-अपणे हाथ मिंढे कै सिर पै धरै। <verse eid="LEV 8:22" /><verse number="23" style="v" sid="LEV 8:23" />फेर वो बलि करया गया, अर मूसा नै उसके लहू म्ह तै कुछ लेकै हारुन कै सोळे कान के सिरे पै अर उसकै सोळे हाथ अर सोळे पैर कै अँगूठयाँ पै लगाया। <verse eid="LEV 8:23" /><verse number="24" style="v" sid="LEV 8:24" />अर वो हारुन के बेट्याँ नै धोरै लेग्या, अर लहू म्ह तै कुछ एक-एक कै सोळे कान के सिरे पै अर सोळे हाथ अर सोळे पैर कै अँगूठयाँ पै लगाया; अर मूसा नै लहू ताहीं वेदी पै चौगरदे छिड़क्या। <verse eid="LEV 8:24" /><verse number="25" style="v" sid="LEV 8:25" />अर उसनै चर्बी, अर मोट्टी पुन्झड़, अर अंतड़ियाँ पै की सारी चर्बी, अर कळेजे पै की झिल्‍ली सुधा दोन्‍नु गुर्दे, अर सोळी जाँघ, ये सारे लेकै न्यारे राक्खै; <verse eid="LEV 8:25" /><verse number="26" style="v" sid="LEV 8:26" />अर अखमीरी रोट्टी की टोकरी जो यहोवा कै आग्गै धरी गई थी उस म्ह तै एक अखमीरी रोट्टी, अर तेल तै सणे होए मैदे का एक फुलका, अर एक पापड़ी लेकै चर्बी अर सोळी जाँघ पै धर दी; <verse eid="LEV 8:26" /><verse number="27" style="v" sid="LEV 8:27" />अर ये सारी चीज हारुन अर उसके बेट्याँ कै हाथ्थां पै धर दी गई, अर हिलाणे की भेंट कै खात्तर यहोवा कै स्याम्ही हिलाई गई। <verse eid="LEV 8:27" /><verse number="28" style="v" sid="LEV 8:28" />फेर मूसा नै उन ताहीं फेर उनकै हाथ्थां पै तै लेकै उनतै वेदी पै होमबलि कै उप्पर जळाया, यो सुखदायक सुगन्ध देण कै खात्तर विधि की भेंट अर यहोवा कै खात्तर हवन था। <verse eid="LEV 8:28" /><verse number="29" style="v" sid="LEV 8:29" />फेर मूसा नै छात्ती ताहीं लेकै हिलाणे की भेंट कै खात्तर यहोवा कै आग्गै हिलाया; अर विधि के मिंढे म्ह तै मूसा का हिस्सा योए होया जिसा यहोवा नै मूसा तै हुकम दिया था।<verse eid="LEV 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 8:30" />फेर मूसा नै अभिषेक के तेल अर वेदी पै के लहू, दोनुआ म्ह तै कुछ लेकै हारुन अर उसकै पोशाक पै, अर उसके बेट्याँ अर उनकी पोशाक पै भी छिड़क्या; अर उसनै पोशाक सुधा हारुन ताहीं भी पवित्र करया।<verse eid="LEV 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 8:31" />फेर मूसा नै हारुन अर उसके बेट्याँ तै कह्या, “माँस नै मिलापआळे तम्बू के दरबाजे पै पकाओ, अर उस रोट्टी नै जो विधि की टोकरी म्ह सै उड़ैए खाओ, जिसा मन्‍नै हुकम दिया सै के हारुन अर उसकै बेट्टे उसनै खावैं। <verse eid="LEV 8:31" /><verse number="32" style="v" sid="LEV 8:32" />अर माँस अर रोट्टी म्ह तै जो बाकी रह ज्या उसनै आग म्ह जळा दियो। <verse eid="LEV 8:32" /><verse number="33" style="v" sid="LEV 8:33" />अर जिब तक विधि के दिन पूरे ना हों तब ताहीं, यानिके सात दिन तक मिलापआळे तम्बू के दरबाजे कै बाहर ना जाईयो, क्यूँके वो सात दिन तक थारा विधि संस्कार करदा रहवैगा। <verse eid="LEV 8:33" /><verse number="34" style="v" sid="LEV 8:34" />जिस तरियां आज करया गया सै उस्से तरियां ए करण का हुकम यहोवा नै दिया सै, जिसतै थारा प्रायश्चित करया जावै। <verse eid="LEV 8:34" /><verse number="35" style="v" sid="LEV 8:35" />इस करकै थम मिलापआळे तम्बू कै दरबाजे पै सात दिन ताहीं दिन-रात रुके रहियो, अर यहोवा कै हुकम नै मानियो, ताके थम मर ना जाओ; क्यूँके इसाए हुकम मेरे ताहीं दिया गया सै।” <verse eid="LEV 8:35" /><verse number="36" style="v" sid="LEV 8:36" />फेर यहोवा के इन सारे हुकमां कै मुताबिक जो उसनै मूसा कै जरिये दिये थे हारुन अर उसके बेट्याँ नै करया।<verse eid="LEV 8:36" /></para>
  <chapter eid="LEV 8" />
  <chapter number="9" style="c" sid="LEV 9" />
  <para style="s">याजकीय सेवकाई (बलि-अर्पण)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 9:1" />आठवें<note caller="+" style="f"><char style="fr" closed="false">9:1 </char><char style="fq" closed="false">आठवें </char><char style="ft" closed="false">अगुवां बणाये जाण पै सात दिनां कै पाच्छै</char></note> दिन मूसा नै हारुन अर उसकै बेट्याँ तै अर इस्राएली अगुवां ताहीं बुलवाकै हारुन तै कह्या, <verse eid="LEV 9:1" /><verse number="2" style="v" sid="LEV 9:2" />“पापबलि कै खात्तर एक बेकसूर बाछड़ा, अर होमबलि कै खात्तर एक बेकसूर मिंढा लेकै यहोवा कै स्याम्ही भेंट चढ़ा। <verse eid="LEV 9:2" /><verse number="3" style="v" sid="LEV 9:3" />अर इस्राएल के माणसां तै न्यू कह, ‘थम पापबलि कै खात्तर एक बकरा, अर होमबलि कै खात्तर एक बाछड़ा अर एक भेड़ का बच्‍चा ल्यो, जो एक साल के हों अर बेकसूर हों, <verse eid="LEV 9:3" /><verse number="4" style="v" sid="LEV 9:4" />अर मेलबलि कै खात्तर यहोवा कै स्याम्ही चढ़ाण कै खात्तर एक बळध अर एक मिंढा, अर तेल तै सणे होए मैदे का एक अन्‍नबलि भी ले ल्यो; क्यूँके आज यहोवा थारे ताहीं दर्शन देवैगा।’” <verse eid="LEV 9:4" /><verse number="5" style="v" sid="LEV 9:5" />अर जिस-जिस चीज का हुकम मूसा नै दिया उन सारया नै वे मिलापआळे तम्बू कै आग्गै ले आए; अर सारी मण्डळी धोरै जाकै यहोवा कै स्याम्ही खड़ी होई। <verse eid="LEV 9:5" /><verse number="6" style="v" sid="LEV 9:6" />फेर मूसा नै कह्या, “यो वो काम सै जिसकै करण कै खात्तर यहोवा नै हुकम दिया सै के थम उसनै करो; अर यहोवा की महिमा का तेज थारे ताहीं दिखाई देवैगा।” <verse eid="LEV 9:6" /><verse number="7" style="v" sid="LEV 9:7" />फेर मूसा नै हारुन तै कह्या, “यहोवा के हुकम कै मुताबिक वेदी कै धोरै जाकै अपणे पापबलि अर होमबलि नै चढ़ाकै अपणे अर सारी जनता कै खात्तर प्रायश्चित कर अर जनता कै चढ़ावा नै भी चढ़ाकै उनकै खात्तर प्रायश्चित कर।”<verse eid="LEV 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 9:8" />इस करकै हारुन नै वेदी कै धोरै जाकै अपणे पापबलि के बाछड़े ताहीं बलिदान करया। <verse eid="LEV 9:8" /><verse number="9" style="v" sid="LEV 9:9" />अर हारुन के बेट्टे लहू नै उसकै धोरै लेगे, फेर उसनै अपणी आंगळी ताहीं लहू म्ह डुबा कै वेदी कै सीन्गां पै लहू ताहीं लगाया, अर बाकी लहू तै वेदी कै पावेयां पै उण्डेल दिया; <verse eid="LEV 9:9" /><verse number="10" style="v" sid="LEV 9:10" />अर पापबलि म्ह की चर्बी अर गुर्दे अर कळेजे पै की झिल्‍ली ताहीं उसनै वेदी पै जळाया, जिसा यहोवा नै मूसा तै हुकम दिया था। <verse eid="LEV 9:10" /><verse number="11" style="v" sid="LEV 9:11" />अर माँस अर खाल ताहीं उसनै छावणी तै बाहर आग म्ह जळाया।<verse eid="LEV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 9:12" />फेर होमबलि पशु ताहीं बलिदान करया; अर हारुन के बेट्याँ नै लहू ताहीं उसकै हाथ म्ह दिया, अर उसनै उस ताहीं वेदी पै चौगरदे नै छिड़क दिया। <verse eid="LEV 9:12" /><verse number="13" style="v" sid="LEV 9:13" />फेर उननै होमबलि पशु के टुकड़े-टुकड़े करकै सिर सुधा उसकै हाथ्थां म्ह दे दिया अर उसनै उनतै वेदी पै जळा दिया। <verse eid="LEV 9:13" /><verse number="14" style="v" sid="LEV 9:14" />अर उसनै आंतड़ी अर पायां ताहीं धोया अर वेदी पै होमबलि कै उप्पर जळाया।<verse eid="LEV 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 9:15" />फेर उसनै माणसां के चढ़ाव्यां ताहीं आग्गै लेकै अर उस पापबलि कै बकरे नै जो उनकै खात्तर था लेकै उसका बलिदान करया, अर पैहल्या की ढाळ उस ताहीं भी पापबलि करकै चढ़ाया। <verse eid="LEV 9:15" /><verse number="16" style="v" sid="LEV 9:16" />अर उसनै होमबलि ताहीं भी धोरै ले जाकै विधि कै मुताबिक चढ़ाया। <verse eid="LEV 9:16" /><verse number="17" style="v" sid="LEV 9:17" />अर अन्‍नबलि नै भी धोरै ले जाकै उस म्ह तै मुट्ठी भर वेदी पै जळाया, यो तड़कैए कै होमबलि के अलावा चढ़ाया गया।<verse eid="LEV 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 9:18" />बळध अर मिंढा, यानिके जो मेलबलि पशु जनता कै खात्तर थे वे भी बलि करे गए; अर हारुन के बेट्याँ नै लहू ताहीं उसकै हाथ म्ह दिया, अर उसनै उस ताहीं वेदी पै चौगरदे नै छिड़क दिया; <verse eid="LEV 9:18" /><verse number="19" style="v" sid="LEV 9:19" />अर उननै बळध की चर्बी तै, अर मिंढे म्ह तै मोट्टी पुन्झड़ ताहीं, अर जिस चर्बी तै आंतड़ी ढकी होवै सै उस ताहीं, अर गुर्देयां सुधा कळेजे पै की झिल्‍ली ताहीं भी उसकै हाथ म्ह दिया; <verse eid="LEV 9:19" /><verse number="20" style="v" sid="LEV 9:20" />अर उननै चर्बी ताहीं छात्ती पै धरया; अर उसनै वो चर्बी वेदी पै जळाई, <verse eid="LEV 9:20" /><verse number="21" style="v" sid="LEV 9:21" />पर छात्ती अर सोळी जाँघ ताहीं हारुन नै मूसा के हुकम कै मुताबिक हिलाणे की भेंट कै खात्तर यहोवा कै स्याम्ही हिलाया।<verse eid="LEV 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 9:22" />फेर हारुन नै माणसां की ओड़ हाथ बढ़ाकै उन ताहीं आशीर्वाद दिया; अर पापबलि, होमबलि, अर मेलबलियां नै चढ़ाकै वो तळै उतर आया। <verse eid="LEV 9:22" /><verse number="23" style="v" sid="LEV 9:23" />फेर मूसा अर हारुन मिलापआळे तम्बू म्ह गए, अर लिकड़कै माणसां तै आशीर्वाद दिया; फेर यहोवा का तेज सारी जनता नै दिखाई दिया। <verse eid="LEV 9:23" /><verse number="24" style="v" sid="LEV 9:24" />अर यहोवा कै स्याम्ही तै आग लिकड़ी चर्बी सुधा होमबलि नै वेदी पै भस्म कर दिया; इसनै देखकै जनता नै जय-जयकार का नारा लगाया, अर अपणे-अपणे मुँह कै बळ गिरकै दण्‍डवत करया।<verse eid="LEV 9:24" /></para>
  <chapter eid="LEV 9" />
  <chapter number="10" style="c" sid="LEV 10" />
  <para style="s">नादाब अर अबीहू के भस्म होण का बखान</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 10:1" />फेर नादाब अर अबीहू नाम के हारुन के बेट्याँ म्ह तै दो बेट्याँ नै अपणा-अपणा धूपदान लिया, अर उन म्ह आग भरी, अर उस म्ह धूप गेर कै उस आग तै जिसका हुकम यहोवा नै कोनी दिया था यहोवा कै स्याम्ही अर्पित करी। <verse eid="LEV 10:1" /><verse number="2" style="v" sid="LEV 10:2" />फेर यहोवा कै स्याम्ही तै आग लिकड़ी अर उन दोनुआ ताहीं भस्म कर दिया, अर वे यहोवा कै स्याम्ही मरगे। <verse eid="LEV 10:2" /><verse number="3" style="v" sid="LEV 10:3" />फेर मूसा नै हारुन तै कह्या, “या वाए बात सै जिस ताहीं यहोवा नै कह्या था, के जो मेरै धोरै आवै जरूरी सै के वो मन्‍नै पवित्र जाणै, अर सारी जनता कै स्याम्ही मेरी महिमा करै।” अर हारुन चुप रहया।<verse eid="LEV 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 10:4" />फेर मूसा नै मीशाएल अर एलसाफान तै जो हारुन कै चाचा उज्जीएल के बेट्टे थे बुलाकै कह्या, “धोरै आओ, अर अपणे भतीज्यां नै पवित्र स्‍थान कै आग्गै तै ठाकै छावणी कै बाहर ले जाओ।” <verse eid="LEV 10:4" /><verse number="5" style="v" sid="LEV 10:5" />मूसा के इस हुकम कै मुताबिक वे धोरै जाकै उननै अंगरख्याँ सुधा ठाकै छावणी कै बाहर लेगे। <verse eid="LEV 10:5" /><verse number="6" style="v" sid="LEV 10:6" />फेर मूसा नै हारुन तै अर उसके बेट्टे एलीआजर अर ईतामार तै कह्या, “थम लोग अपणे सिर कै बाळ ना बिखराओ, अर ना अपणी पोशाक नै पाड़ो, इसा ना हो के थम भी मर जाओ, अर सारी मण्डळी पै उसका छो भड़क उठै; पर इस्राएल के सारे कुण्बे के माणस जो थारे भाई-बन्धु सै वो यहोवा की लगाई होई आग पै बिलाप करैं। <verse eid="LEV 10:6" /><verse number="7" style="v" sid="LEV 10:7" />अर थम माणस मिलापआळे तम्बू के दरबाजे कै बाहर ना जाईयो, इसा ना हो के थम मर जाओ; क्यूँके यहोवा के अभिषेक का तेल थारे पै लाग्या होया सै।” मूसा के इस वचन कै मुताबिक उननै करया।<verse eid="LEV 10:7" /></para>
  <para style="s">याजकां खात्तर निर्धारित चाल चलण</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 10:8" />फेर यहोवा नै हारुन तै कह्या, <verse eid="LEV 10:8" /><verse number="9" style="v" sid="LEV 10:9" />“जिब-जिब तू या तेरे बेट्टे मिलापआळे तम्बू म्ह आवैं तब-तब थारे म्ह तै कोए ना तो दाखमधु पिए हो ना और किसे ढाळ का नशा, कदे इसा ना हो के थम मर जाओ; थारी पीढ़ी-पीढ़ी म्ह या विधि मान्‍नी जान्दी रहवै, <verse eid="LEV 10:9" /><verse number="10" style="v" sid="LEV 10:10" />जिसतै थम पवित्र अर अपवित्र म्ह, अर शुद्ध अर अशुद्ध म्ह अन्तर कर सको; <verse eid="LEV 10:10" /><verse number="11" style="v" sid="LEV 10:11" />अर इस्राएलियाँ तै उन सारी विधियाँ नै सिखा सको, जिस ताहीं यहोवा नै मूसा कै जरिये उनतै बताई सैं।”<verse eid="LEV 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 10:12" />फेर मूसा नै हारुन तै अर उसके बचे होए दोन्‍नु बेट्याँ एलीआजर अर ईतामार तै भी कह्या, “यहोवा कै हवन म्ह तै जो अन्‍नबलि बच्या सै उसनै लेकै वेदी कै धोरै बिना खमीर खाओ, क्यूँके वो परमपवित्र सै; <verse eid="LEV 10:12" /><verse number="13" style="v" sid="LEV 10:13" />अर थम उसनै किसे पवित्र स्‍थान म्ह खाओ, वो यहोवा कै हवन म्ह तै तेरा अर तेरे बेट्याँ का हक सै; क्यूँके मन्‍नै इसाए हुकम पाया सै। <verse eid="LEV 10:13" /><verse number="14" style="v" sid="LEV 10:14" />फेर हिलाई होई भेंट की छात्ती अर ठाई होई भेंट की जाँघ नै थम लोग, यानिके तू अर तेरे बेट्टे-बेटियाँ सारे किसे शुद्ध जगहां म्ह खाओ; क्यूँके वे इस्राएलियाँ कै मेलबलियां म्ह तै तेरा अर तेरे बाळकां का हक ठहरा दिया गया सै। <verse eid="LEV 10:14" /><verse number="15" style="v" sid="LEV 10:15" />चर्बी कै हवन सुधा जो ठाई होई जाँघ अर हिलाई होई छात्ती यहोवा कै स्याम्ही हिलाणे कै खात्तर आया करैगी, यो हिस्सा यहोवा के हुकम कै मुताबिक सदा की विधि के नियम-कायदे तै तेरा अर तेरे बाळकां कै खात्तर सैं।”<verse eid="LEV 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 10:16" />फेर मूसा नै पापबलि के बकरे की खोजबीन करी, तो के पाया के, वो जळाया गया सै, ज्यांतै एलीआजर अर ईतामार जो हारुन के बेट्टे बचे थे उनतै वो छो म्ह आकै कहण लाग्या, <verse eid="LEV 10:16" /><verse number="17" style="v" sid="LEV 10:17" />“पापबलि जो परमपवित्र सै अर जिस ताहीं यहोवा नै तेरे तै ज्यांतै दिया सै के थम मण्डळी के अधर्म का बोझ अपणे पै ठाकै उनकै खात्तर यहोवा कै स्याम्ही प्रायश्चित करो, थमनै उसका माँस पवित्र स्‍थान म्ह क्यूँ न्ही खाया? <verse eid="LEV 10:17" /><verse number="18" style="v" sid="LEV 10:18" />देक्खो, उसका लहू पवित्र स्‍थान कै भित्तर तो ल्याया ए न्ही गया, बेशक ठीक था के थम मेरे हुकम कै मुताबिक उसकै माँस नै पवित्र स्‍थान म्ह खान्दे।” <verse eid="LEV 10:18" /><verse number="19" style="v" sid="LEV 10:19" />इसका जवाब हारुन नै मूसा तै इस तरियां दिया, “देख, आज ए उननै अपणे पापबलि अर होमबलि ताहीं यहोवा कै स्याम्ही चढ़ाया; फेर मेरै पै इसी बिप्दा आण पड़ी सै! इस करकै जै मै आज पापबलि का माँस खान्दा तो के या बात यहोवा कै स्याम्ही भली होन्दी?” <verse eid="LEV 10:19" /><verse number="20" style="v" sid="LEV 10:20" />जिब मूसा नै यो सुण्या फेर उसनै तसल्‍ली होई।<verse eid="LEV 10:20" /></para>
  <chapter eid="LEV 10" />
  <chapter number="11" style="c" sid="LEV 11" />
  <para style="s">धरती के शुद्ध अर अशुद्ध पशु</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 11:1" />फेर यहोवा नै मूसा अर हारुन तै कह्या, <verse eid="LEV 11:1" /><verse number="2" style="v" sid="LEV 11:2" />“इस्राएलियाँ तै कहो: जितने पशु धरती पै सै उन सारया म्ह तै थम इन जीवधारियां का माँस खा सको सो। <verse eid="LEV 11:2" /><verse number="3" style="v" sid="LEV 11:3" />पशुआं म्ह तै जितने चिरे या पाट्टे खुर के होवै सैं अर जुगाळी करै सै उननै खा सको सो। <verse eid="LEV 11:3" /><verse number="4" style="v" sid="LEV 11:4" />पर जुगाळी करण आळे या पाट्टे खुरआळे म्ह तै इन पशुआं नै ना खाईयों, यानिके ऊँट, जो जुगाळी तो करै सै पर चिरे खुर का कोनी होन्दा, ज्यांतै वो थारे खात्तर अशुद्ध ठहरै सै। <verse eid="LEV 11:4" /><verse number="5" style="v" sid="LEV 11:5" />अर पहाड़ी बिज्जू, जो जुगाळी तो करै सै पर चिरे खुर का कोनी होन्दा, वो भी थारे खात्तर अशुद्ध सै। <verse eid="LEV 11:5" /><verse number="6" style="v" sid="LEV 11:6" />अर खरगोश, जो जुगाळी तो करै सै पर चिरे खुर का कोनी होन्दा, ज्यांतै वो भी थारे खात्तर अशुद्ध सै। <verse eid="LEV 11:6" /><verse number="7" style="v" sid="LEV 11:7" />अर सूअर, जो चिरे यानिके पाट्टे खुर का तो होवै सै पर जुगाळी कोनी करदा, ज्यांतै वो थारे खात्तर अशुद्ध सै। <verse eid="LEV 11:7" /><verse number="8" style="v" sid="LEV 11:8" />इनकै माँस म्ह तै ना तो कुछ खाईयों, अर इनकी लोथ नै भी ना छूईयो; ये तो थारै खात्तर अशुद्ध सै।”<verse eid="LEV 11:8" /></para>
  <para style="s">शुद्ध अर अशुद्ध जलजन्तु</para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 11:9" />“फेर जितने जलजन्तु सै उन म्ह तै थम इननै खा सको सो, यानिके समुन्दर या नदियाँ के पाणी के जन्तुआं म्ह तै जितन्या के पंख अर चोंयेटे होवै सै उननै खा सको सो। <verse eid="LEV 11:9" /><verse number="10" style="v" sid="LEV 11:10" />अर जलचर प्राणियाँ म्ह तै जितने जीवधारी बिना पंख अर चोंयेटे के समुन्दर या नदियाँ म्ह रहवै सै वे सारे थारे खात्तर घृणित सै। <verse eid="LEV 11:10" /><verse number="11" style="v" sid="LEV 11:11" />वे थारे खात्तर घृणित ठहरै; थम उनके माँस म्ह तै कुछ ना खाईयों, अर उनकी लोथां नै अशुद्ध जाणियो। <verse eid="LEV 11:11" /><verse number="12" style="v" sid="LEV 11:12" />पाणी म्ह जिस किसे जन्तु कै पंख अर चोंयेटे कोनी होन्दे वो थारे खात्तर अशुद्ध सै।”<verse eid="LEV 11:12" /></para>
  <para style="s">अशुद्ध पन्छी</para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 11:13" />“फेर पंछियाँ म्ह तै इननै अशुद्ध जाणियो, ये अशुद्ध होण कै कारण खाए ना जावैं, यानिके उकाब, हड़फोड़, कुरर, <verse eid="LEV 11:13" /><verse number="14" style="v" sid="LEV 11:14" />चील, अर कई ढाळ के बाज, <verse eid="LEV 11:14" /><verse number="15" style="v" sid="LEV 11:15" />अर कई ढाळ के सारे काग, <verse eid="LEV 11:15" /><verse number="16" style="v" sid="LEV 11:16" />शुतुर्मुर्ग, तखमास, जलकुक्‍कट, अर कई ढाळ के जलकुक्‍कट, <verse eid="LEV 11:16" /><verse number="17" style="v" sid="LEV 11:17" />हबासिल, हाड़गील, उल्‍लू, <verse eid="LEV 11:17" /><verse number="18" style="v" sid="LEV 11:18" />राजहँस, धनेश, गिद्ध, <verse eid="LEV 11:18" /><verse number="19" style="v" sid="LEV 11:19" />सारस, कई ढाळ के बुगले, टिटीहरी अर चमगादड़।”<verse eid="LEV 11:19" /></para>
  <para style="s">शुद्ध अर अशुद्ध कीड़े</para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 11:20" />“जितने पंखआळे कीड़े च्यार पैरां कै बल चाल्‍लै सै वे सारे थारे खात्तर अशुद्ध सै। <verse eid="LEV 11:20" /><verse number="21" style="v" sid="LEV 11:21" />पर रेंगण आळे अर पंखआळे जो च्यार पैरां कै बल चाल्‍लै सै, जिनकै धरती पै कूदण नै टाँग होवै सैं उननै तो खा सको सों। <verse eid="LEV 11:21" /><verse number="22" style="v" sid="LEV 11:22" />वे ये सैं, यानिके कई ढाळ की टिड्डी, कई ढाळ के फनगे, कई ढाळ के झींगुर, अर कई ढाळ के टिड्डे। <verse eid="LEV 11:22" /><verse number="23" style="v" sid="LEV 11:23" />पर और सारे रेंगणआळे पंखआळे जो च्यार पैरां आळे होवै सै वे थारे खात्तर अशुद्ध सै।”<verse eid="LEV 11:23" /></para>
  <para style="s">मरे होए पशु तै छूण कै बाद शुद्धिकरण</para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 11:24" />“इनके कारण थम अशुद्ध ठहरोगे; जिस किसे तै इनकी लोथ छू जावै वो साँझ ताहीं अशुद्ध ठहरै। <verse eid="LEV 11:24" /><verse number="25" style="v" sid="LEV 11:25" />अर जो कोए इनकी लोथ म्ह का कुछ भी ठावै वो अपणे कपड़ेयां नै धोवै अर साँझ ताहीं अशुद्ध रहवै। <verse eid="LEV 11:25" /><verse number="26" style="v" sid="LEV 11:26" />फेर जितने पशु चिरे खुर के होवै सै पर ना तो जमाए पाट्टे खुर अर ना जुगाळी करण आळे सै वे थारे खात्तर अशुद्ध सै; जो कोए उननै छुवै वो अशुद्ध ठहरैगा। <verse eid="LEV 11:26" /><verse number="27" style="v" sid="LEV 11:27" />अर च्यार पैरां कै बल चाल्‍लण आळे पशुआं म्ह तै जितने पंज्याँ कै बल चाल्‍लै सै वे सारे थारै खात्तर अशुद्ध सै; जो कोए उनकी लोथ नै छुवै वो साँझ ताहीं अशुद्ध रहवै। <verse eid="LEV 11:27" /><verse number="28" style="v" sid="LEV 11:28" />अर जो कोए उनकी लोथ ठावै वो अपणे कपड़ेयां नै धोवै अर साँझ ताहीं अशुद्ध रहवै; क्यूँके वे थारे खात्तर अशुद्ध सै।”<verse eid="LEV 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 11:29" />“अर जो धरती पै रेंगै सै उन म्ह तै ये रेंगणआळे थारे खात्तर अशुद्ध सै, यानिके नेवळा, चूहा, अर कई ढाळ की गोह, <verse eid="LEV 11:29" /><verse number="30" style="v" sid="LEV 11:30" />अर छिपकली, मगर, टिकटिक, सांडा, अर गिरगिट। <verse eid="LEV 11:30" /><verse number="31" style="v" sid="LEV 11:31" />सारे रेंगण आळयां म्ह तै येए थारै खात्तर अशुद्ध सै; जो कोए इनकी लोथ नै छुवै वो साँझ तक अशुद्ध रहवै। <verse eid="LEV 11:31" /><verse number="32" style="v" sid="LEV 11:32" />अर इन म्ह तै किसे की लोथ जिस किसे चीज पै पड़ ज्या वो भी अशुद्ध ठहरै, चाहे वो काठ का कोए बरतन हो, चाहे कपड़ा, चाहे खाल, चाहे बोरा, चाहे किसे काम का किसा ए बरतन आदि क्यूँ ना हो; वो पाणी म्ह गेरया जावै, अर साँझ ताहीं अशुद्ध रहवै, फेर शुद्ध समझया जावै। <verse eid="LEV 11:32" /><verse number="33" style="v" sid="LEV 11:33" />अर जै माट्टी का कोए बरतन हो जिस म्ह इन जन्तुआं म्ह तै कोए पड़ै, तो उस बरतन म्ह जो कुछ हो वो अशुद्ध ठहरै, अर उस बरतन नै थम तोड़ दियो। <verse eid="LEV 11:33" /><verse number="34" style="v" sid="LEV 11:34" />उस म्ह जो खाण कै लायक खाणा हो, जिस म्ह पाणी का छुआव हो वो सारा अशुद्ध ठहरै; फेर जै इसे बरतन म्ह पीण कै खात्तर कुछ हो तो वो भी अशुद्ध ठहरै। <verse eid="LEV 11:34" /><verse number="35" style="v" sid="LEV 11:35" />अर जै इनकी लोथ म्ह का कुछ तंदूर या चूल्हे पै पड़ै तो वो भी अशुद्ध ठहरै, अर तोड़ दिया जावै; क्यूँके वो अशुद्ध हो ज्यागा, वो थारे खात्तर भी अशुद्ध ठहरै। <verse eid="LEV 11:35" /><verse number="36" style="v" sid="LEV 11:36" />पर चोयां या तालाब जिस म्ह पाणी इकट्ठा हो वो तो शुद्ध ए रहवै; पर जो कोए इनकी लोथ नै छुवै वो अशुद्ध ठहरै। <verse eid="LEV 11:36" /><verse number="37" style="v" sid="LEV 11:37" />अर जै इनकी लोथ म्ह का कुछ किसे ढाळ के बीज पै जो बोण कै खात्तर हो पड़ै, तो वो बीज शुद्ध रहवै; <verse eid="LEV 11:37" /><verse number="38" style="v" sid="LEV 11:38" />पर जै बीज पै पाणी गेर दिया गया हो अर बाद म्ह लोथ का कुछ उसपै पड़ ज्या, तो वो थारै खात्तर अशुद्ध ठहरै। <verse eid="LEV 11:38" /><verse number="39" style="v" sid="LEV 11:39" />फेर जिन पशुआं कै खाण का हुकम थारे तै दिया गया सै जै उन म्ह तै कोए पशु मरै, तो जो कोए उसकी लोथ छुवै वो साँझ तक अशुद्ध रहवै। <verse eid="LEV 11:39" /><verse number="40" style="v" sid="LEV 11:40" />अर उसकी लोथ म्ह तै जो कोए कुछ खावै सै वो अपणे कपड़ेयां नै धोवै अर साँझ तक अशुद्ध रहवै; अर जो कोए उसकी लोथ ठावै वो भी अपणे कपड़ेयां नै धोवै अर साँझ तक अशुद्ध रहवै।”<verse eid="LEV 11:40" /></para>
  <para style="s">अशुद्ध रेंगण आळे जीव</para>
  <para style="p">
    <verse number="41" style="v" sid="LEV 11:41" />“सारे ढाळ के धरती पै रेंगणआळे जन्तु घिनोणे सै; वे खाए ना जावै। <verse eid="LEV 11:41" /><verse number="42" style="v" sid="LEV 11:42" />धरती पै सारे रेंगण आळयां म्ह तै जितने पेट या च्यार पैरां कै बल चाल्‍लै सै, या घणे पैर आळे होवै सैं, उननै थम ना खाईयों; क्यूँके वे घिनोणे सै। <verse eid="LEV 11:42" /><verse number="43" style="v" sid="LEV 11:43" />थम किसे ढाळ के रेंगण आळे जन्तु कै जरिये अपणे-आपनै घिनोणा ना बणाईयो; अर ना उनकै जरिये खुद नै अशुद्ध करकै अपवित्र ठहरियो। <verse eid="LEV 11:43" /><verse number="44" style="v" sid="LEV 11:44" />क्यूँके मै थारा परमेसवर यहोवा सूं; इस करकै खुद नै शुद्ध करकै पवित्र बणे रहो, क्यूँके मै पवित्र सूं। इस करकै थम किसे ढाळ के रेंगणआळे जन्तु कै जरिये जो धरती पै चाल्‍लै सै अपणे-आपनै अशुद्ध ना करियो। <verse eid="LEV 11:44" /><verse number="45" style="v" sid="LEV 11:45" />क्यूँके मै वो यहोवा सूं जो थमनै मिस्र देश तै इस करकै लिकाड़ ले आया सूं के थारा परमेसवर ठहरूँ; इस करकै थम पवित्र बणो, क्यूँके मै पवित्र सूं।”<verse eid="LEV 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 11:46" />“पशु, पंछियाँ, अर सारे जलचर प्राणियाँ, अर धरती पै सारे रेंगणआळे प्राणियाँ कै बारें म्ह येए नियम-कायदे सै, <verse eid="LEV 11:46" /><verse number="47" style="v" sid="LEV 11:47" />के शुद्ध-अशुद्ध अर खाण अर ना खाण आळे जीवधारियां म्ह भेद करया जावै।”<verse eid="LEV 11:47" /></para>
  <chapter eid="LEV 11" />
  <chapter number="12" style="c" sid="LEV 12" />
  <para style="s">जाप्पै के शुद्धिकरण के नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 12:1" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 12:1" /><verse number="2" style="v" sid="LEV 12:2" />“इस्राएलियाँ तै कह: जो औरत गर्भवती हो अर उसकै छोरा हो, तो वा सात दिन ताहीं अशुद्ध रहवैगी; जिस तरियां वा मासिक धर्म कै बखत अशुद्ध रहया करदी। <verse eid="LEV 12:2" /><verse number="3" style="v" sid="LEV 12:3" />अर आठवें दिन छोरे का खतना करया जावै। <verse eid="LEV 12:3" /><verse number="4" style="v" sid="LEV 12:4" />फेर वा औरत अपणे शुद्ध करण आळे रूधिर म्ह तैंतीस दिन रहवै; अर जिब ताहीं उसकै शुद्ध हो जाण के दिन पूरे ना हों जिब तक वा ना तो किसे पवित्र चीज नै छुवै, अर ना पवित्र स्‍थान म्ह दाखल होवै। <verse eid="LEV 12:4" /><verse number="5" style="v" sid="LEV 12:5" />अर जै उसकै छोरी पैदा हो, तो उस ताहीं मासिक धर्म की जिसी अशुद्धता चौदहा दिन की लाग्गै; अर फेर छियासठ दिन ताहीं अपणे शुद्ध करण आळे रूधिर म्ह रहवै।”<verse eid="LEV 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 12:6" />“जिब उसकै शुद्ध हो जाण के दिन पूरे हों, फेर चाहे उसकै बेट्टा होया हो चाहे बेट्टी, वा होमबलि कै खात्तर एक साल का भेड़ का बच्‍चा, अर पापबलि कै खात्तर कबूतरी का एक बच्‍चा या पिंडुकी मिलापआळे तम्बू के दरबाजे पै याजक कै धोरै ल्यावै। <verse eid="LEV 12:6" /><verse number="7" style="v" sid="LEV 12:7" />फेर याजक उसनै यहोवा कै स्याम्ही भेंट चढ़ाकै उसकै खात्तर प्रायश्चित करै; अर वा अपणे रूधिर कै बहण की अशुद्धता तै छूट कै शुद्ध ठहरैगी। जिस औरत कै छोरा या छोरी पैदा हो उसकै खात्तर योए नियम-कायदे सै। <verse eid="LEV 12:7" /><verse number="8" style="v" sid="LEV 12:8" />अर जै उसकै धोरै भेड़ या बकरी देण की पूंजी ना हो, तो दो पिंडुकी या कबूतरी के दो बच्‍चे, एक तो होमबलि अर दूसरा पापबलि कै खात्तर दे; अर याजक उसकै खात्तर प्रायश्चित करै, फेर वो शुद्ध ठहरैगी।”<verse eid="LEV 12:8" /></para>
  <chapter eid="LEV 12" />
  <chapter number="13" style="c" sid="LEV 13" />
  <para style="s">चर्म रोग के लक्षण कै बारै म्ह नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 13:1" />फेर यहोवा नै मूसा अर हारुन तै कह्या, <verse eid="LEV 13:1" /><verse number="2" style="v" sid="LEV 13:2" />“जिब किसे माणस कै शरीर कै चमड़ी म्ह सोई या पापड़ी या दाग हो, अर इसतै उसकै चमड़ी म्ह कोढ़ के लक्षण दिखाई दे, तो उसनै हारुन याजक कै धोरै या उसके बेट्टे जो याजक सैं, उन म्ह तै किसे कै धोरै ले जावै। <verse eid="LEV 13:2" /><verse number="3" style="v" sid="LEV 13:3" />जिब याजक उसकै चमड़ी के लक्षण नै देक्खै, अर जै उस लक्षण के जगहां का रुगं धोळा होग्या हों अर लक्षण चमड़ी तै डून्घा दिखाई दे, तो वो जाण ले के यो कोढ़ के लक्षण सै; अर याजक उस माणस नै देखकै उस ताहीं अशुद्ध ठहरावै। <verse eid="LEV 13:3" /><verse number="4" style="v" sid="LEV 13:4" />पर जै वो दाग उसकी चमड़ी म्ह धोळा तो हो, पर चमड़ी तै डून्घा ना दिखाई दे, अर ना ओड़ै का रुगं धोळा होया हों, तो याजक उसनै सात दिन ताहीं बन्द करकै राक्खै; <verse eid="LEV 13:4" /><verse number="5" style="v" sid="LEV 13:5" />अर सातमै दिन याजक उसनै देक्खै, अर जै वो लक्षण जिसै के तिसे बणे रहवै अर उसकी चमड़ी म्ह ना फैल्या हो, तो याजक उसनै और भी सात दिन ताहीं बन्द करकै राक्खै; <verse eid="LEV 13:5" /><verse number="6" style="v" sid="LEV 13:6" />अर सातमै दिन याजक उसनै फेर देक्खै, अर जै दिखाई दे के लक्षण की चमक घाट सै अर लक्षण चमड़ी पै फैल्या ना हो, तो याजक उसनै शुद्ध ठहरावै; क्यूँके उसकै तो चमड़ी म्ह पापड़ी सै; अर वो अपणे कपड़े धोकै इस बीमारी तै ठीक हो जावै। <verse eid="LEV 13:6" /><verse number="7" style="v" sid="LEV 13:7" />पर जै याजक की उस जाँचकै बाद जिस म्ह वो शुद्ध ठहराया गया था, वो पापड़ी उसकै चमड़ी पै भोत फैल ज्या, तो वो फेर याजक तै दिखाया जावै; <verse eid="LEV 13:7" /><verse number="8" style="v" sid="LEV 13:8" />अर जै याजक नै दिखाई पड़ै के पापड़ी चमड़ी म्ह फैलगी सै, तो वो उसनै अशुद्ध ठहरावै; क्यूँके वो कोढ़ ए सै।”<verse eid="LEV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 13:9" />“जै कोढ़ के जिसे लक्षण किसे माणस कै हों, तो वो याजक कै धोरै पोहचाया जावै; <verse eid="LEV 13:9" /><verse number="10" style="v" sid="LEV 13:10" />अर याजक उसनै देक्खै, अर जै वो सोई उसकै चमड़ी म्ह धोळी हो, अर उसकै कारण रुगं भी धोळा होग्या हों, अर उस सोई म्ह बिना चमड़ी का माँस हो, <verse eid="LEV 13:10" /><verse number="11" style="v" sid="LEV 13:11" />तो याजक जाणै के उसकै चमड़ी म्ह पुराणा कोढ़ सै, इस करकै वो उसनै अशुद्ध ठहरावै; अर बन्द ना राक्खै, क्यूँके वो तो अशुद्ध सै। <verse eid="LEV 13:11" /><verse number="12" style="v" sid="LEV 13:12" />अर जै कोढ़ किसे कै चमड़ी म्ह फूट कै उरै ताहीं फैल ज्या, के जित्त किते याजक देक्खै रोगी कै सिर तै पैर कै तळवे तक कोढ़ नै सारी चमड़ी ताहीं ढक लिया हो, <verse eid="LEV 13:12" /><verse number="13" style="v" sid="LEV 13:13" />तो याजक ध्यान तै देक्खै, अर जै कोढ़ उसके सारे शरीर पै छाग्या हो, तो वो उस माणस नै शुद्ध ठहरावै; अर उसका शरीर जो जमाए धोळा होग्या सै तो वो शुद्ध ए ठहरै। <verse eid="LEV 13:13" /><verse number="14" style="v" sid="LEV 13:14" />पर जिब उस म्ह बिना चमड़ी का माँस दिखाई पड़ै, फेर वो अशुद्ध ठहरै। <verse eid="LEV 13:14" /><verse number="15" style="v" sid="LEV 13:15" />अर याजक बिना चमड़ी के माँस नै देखकै उसनै अशुद्ध ठहरावै; क्यूँके उसा बिना चमड़ी का माँस अशुद्ध ए होवै सै; वो कोढ़ सै। <verse eid="LEV 13:15" /><verse number="16" style="v" sid="LEV 13:16" />पर जै वो बिना चमड़ी का माँस फेर धोळा हो ज्या, तो वो माणस याजक कै धोरै जावै, <verse eid="LEV 13:16" /><verse number="17" style="v" sid="LEV 13:17" />अर याजक उसनै देखकै, अर जै वा जगहां फेर तै धोळी होगी हो, तो याजक रोगी नै शुद्ध जाणै; वो ठीक सै।”<verse eid="LEV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 13:18" />“फेर जै किसे कै चमड़ी म्ह फोड़ा होकै ठीक होग्या हो, <verse eid="LEV 13:18" /><verse number="19" style="v" sid="LEV 13:19" />अर फोड़े कै जगहां म्ह धोळी-धोळी सी सोई या लाल्‍ली लिए होए धोळा दाग हो, तो वो याजक ताहीं दिखाया जावै; <verse eid="LEV 13:19" /><verse number="20" style="v" sid="LEV 13:20" />अर याजक उस सोई नै देक्खै, अर जै वा चमड़ी तै डून्घा दिखाई पड़ै, अर उसका रुगं भी धोळा होग्या हों, तो याजक न्यू जाणकै उस माणस नै अशुद्ध ठहरावै; क्यूँके वो कोढ़ के लक्षण सै जो फोड़े म्ह तै फूट कै लिकड़े सै। <verse eid="LEV 13:20" /><verse number="21" style="v" sid="LEV 13:21" />पर जै याजक देक्खै के उस म्ह धोळा रुगं कोनी सै, अर वो चमड़ी तै डून्घा कोनी, अर उसकी चमक घाट होई सै, तो याजक उस माणस नै सात दिन ताहीं बन्द करकै राक्खै। <verse eid="LEV 13:21" /><verse number="22" style="v" sid="LEV 13:22" />अर जै वो रोग उस बखत तक चमड़ी म्ह साच्‍चए फैल ज्या, तो याजक उस माणस नै अशुद्ध ठहरावै; क्यूँके वो कोढ़ के लक्षण सै। <verse eid="LEV 13:22" /><verse number="23" style="v" sid="LEV 13:23" />पर जै वो दाग ना फैलै अर अपणी जगहां पैए बण्या रहवै, तो वो फोड़े का दाग सै; याजक उस माणस नै शुद्ध ठहरावै।”<verse eid="LEV 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 13:24" />“फेर जै किसे कै चमड़ी म्ह जळण का घाव हो, अर उस जळण कै घाव म्ह चमड़ी कै बिना दाग लाल्‍ली लिए होए धोळा-धोळा सा हो ज्या, <verse eid="LEV 13:24" /><verse number="25" style="v" sid="LEV 13:25" />तो याजक उसनै देक्खै, अर जै उस दाग म्ह का रुगं धोळा होग्या हों अर वो चमड़ी तै डून्घा दिखाई पड़ै, तो वो कोढ़ सै; जो उस जळण के दाग म्ह तै फूट लिकड़या सै; याजक उस माणस नै अशुद्ध ठहरावै; क्यूँके उस म्ह कोढ़ के लक्षण सै। <verse eid="LEV 13:25" /><verse number="26" style="v" sid="LEV 13:26" />पर जै याजक देक्खै, के दाग म्ह धोळा रुगं कोनी अर ना वो चमड़ी तै कुछ डून्घा सै, अर उसकी चमक घाट होई सै, तो वो उस ताहीं सात दिन तक बन्द करकै राक्खै, <verse eid="LEV 13:26" /><verse number="27" style="v" sid="LEV 13:27" />अर सातमै<note caller="+" style="f"><char style="fr" closed="false">13:27 </char><char style="fq" closed="false">सातमै </char><char style="ft" closed="false">एक्ला रहण कै सात दिनां पाच्छै</char></note> दिन याजक उसनै देक्खै, अर जै वो चमड़ी म्ह फैलग्या हो, तो वो उस माणस नै अशुद्ध ठहरावै; क्यूँके उसकै कोढ़ के लक्षण सै। <verse eid="LEV 13:27" /><verse number="28" style="v" sid="LEV 13:28" />पर जै वो दाग चमड़ी म्ह न्ही फैल्या अर अपणी जगहां पै न्यू का न्यू बण्या हो, अर उसकी चमक घाट होई हो, तो वो जळ जाणकै कारण सूज्या होया सै, याजक उस माणस नै शुद्ध ठहरावै; क्यूँके वो दाग जळ जाण के कारण सै।”<verse eid="LEV 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 13:29" />“फेर जै किसे आदमी या औरत कै सिर पै, या आदमी की दाढ़ी म्ह रोग हो, <verse eid="LEV 13:29" /><verse number="30" style="v" sid="LEV 13:30" />तो याजक लक्षण नै देक्खै, अर जै वो चमड़ी तै डून्घी दिखाई पड़ै, अर उस म्ह भूरे-भूरे पतळे बाळ हों, तो याजक उस माणस नै अशुद्ध ठहरावै; वो लक्षण तै होया, यानिके सिर या दाढ़ी का कोढ़ सै। <verse eid="LEV 13:30" /><verse number="31" style="v" sid="LEV 13:31" />अर जै याजक सेंहुएँ के लक्षण नै देक्खै, के वो चमड़ी तै डून्घी न्ही सै अर उस म्ह काळे-काळे बाळ न्ही सै, तो वो सेंहुएँ<note caller="+" style="f"><char style="fr" closed="false">13:31 </char><char style="fq" closed="false">सेंहुएँ </char><char style="ft" closed="false">सेंहुएँ </char><char style="ft" closed="false">यो एक किस्म का चमड़ी रोग सै</char></note> कै रोगी नै सात दिन ताहीं बन्द करकै राक्खै, <verse eid="LEV 13:31" /><verse number="32" style="v" sid="LEV 13:32" />अर सातमै दिन याजक लक्षण नै देक्खै, फेर जै वो सेंहुआ फैल्या ना हो, अर उस म्ह भूरे-भूरे बाळ ना हों, अर सेंहुआ चमड़ी तै डून्घा ना दिखाई पड़ै, <verse eid="LEV 13:32" /><verse number="33" style="v" sid="LEV 13:33" />तो यो माणस मूंडया जावै, पर जड़ै सेंहुआ हो ओड़ै तै ना मूंडया जावै; अर याजक उस सेंहुएँ तै ग्रस्‍त आळे माणस नै और भी सात दिन ताहीं बन्द करै; <verse eid="LEV 13:33" /><verse number="34" style="v" sid="LEV 13:34" />अर सातमै दिन याजक सेंहुएँ नै देक्खै, अर जै वो सेंहुआ चमड़ी म्ह फैल्या ना हो अर चमड़ी तै डून्घा ना दिखाई पड़ै, तो याजक उस माणस नै शुद्ध ठहरावै; अर वो अपणे कपड़े धोकै शुद्ध ठहरै। <verse eid="LEV 13:34" /><verse number="35" style="v" sid="LEV 13:35" />पर जै उसकै शुद्ध ठहरण कै बाद सेंहुआ चमड़ी म्ह कुछ भी फैलै, <verse eid="LEV 13:35" /><verse number="36" style="v" sid="LEV 13:36" />तो याजक उसनै देक्खै, अर जै वो चमड़ी म्ह फैल्या हो, तो याजक भूरे बाळ ना, टोवै क्यूँके वो माणस अशुद्ध सै। <verse eid="LEV 13:36" /><verse number="37" style="v" sid="LEV 13:37" />पर जै उसकी निगांह म्ह वो सेंहुआ न्यू का न्यू बण्या हो, अर उस म्ह काळे-काळे बाळ जमे हों, तो वो जाणै के सेंहुआ ठीक होग्या सै, अर वो माणस शुद्ध सै; याजक उसनै शुद्ध ए ठहरावै।”<verse eid="LEV 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LEV 13:38" />“फेर जै किसे आदमी या औरत कै चमड़ी म्ह धोळा दाग हों, <verse eid="LEV 13:38" /><verse number="39" style="v" sid="LEV 13:39" />तो याजक देक्खै, अर जै उसकै चमड़ी म्ह वो दाग घाट धोळा हों, तो वो जाणै के उस ताहीं चमड़ी म्ह लिकड़या होया दाद ए सै; वो माणस शुद्ध ठहरै।”<verse eid="LEV 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 13:40" />“फेर जिसके सिर के बाळ झड़ ग्ये हों, तो जाणियो के वो गंजा तो सै पर शुद्ध सै। <verse eid="LEV 13:40" /><verse number="41" style="v" sid="LEV 13:41" />अर जिसकै सिर कै आग्गै के बाळ झड़ ग्ये हों, तो वो माथ्थै का गंजा तो सै पर शुद्ध सै। <verse eid="LEV 13:41" /><verse number="42" style="v" sid="LEV 13:42" />पर जै गंजे माथ्थै पै लाल्‍ली लिए होए धोळा रोग हो, तो जाणियो के वो उसकै गंजे सिर पै या गंजे माथ्थै पै लिकड़या होया कोढ़ सै। <verse eid="LEV 13:42" /><verse number="43" style="v" sid="LEV 13:43" />ज्यांतै याजक उसनै देक्खै, अर जै रोग की सोई उसकै गंजे सिर या गंजे माथ्थै पै इसी लाल्‍ली लिए होए धोळी हो जिसा चमड़ी कै कोढ़ म्ह होवै सै, <verse eid="LEV 13:43" /><verse number="44" style="v" sid="LEV 13:44" />तो वो माणस जो कोढ़ी सै अर अशुद्ध सै; अर याजक उसनै जरुर अशुद्ध ठहरावै; क्यूँके वो रोग उसकै सिर पै सै।”<verse eid="LEV 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LEV 13:45" />“जिस म्ह वो रोग हो उस कोढ़ी के कपड़े अर सिर के बाळ बिखरे रहवैं, अर वो अपणे उप्पर आळे होठ नै ढके होए अशुद्ध, अशुद्ध पुकारया करै। <verse eid="LEV 13:45" /><verse number="46" style="v" sid="LEV 13:46" />जितने दिन तक वो रोग उस म्ह रहवै उतने दिन ताहीं वो अशुद्ध रहवैगा; अर वो अशुद्ध ठहरया रहवै; ज्यांतै वो एक्ला रहया करै, उसकी रहण की जगहां छावणी कै बाहर हो।”<verse eid="LEV 13:46" /></para>
  <para style="s">खराब कपड़े</para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 13:47" />“फेर जिस कपड़े म्ह कोढ़ का रोग हो, चाहे वो कपड़े ऊन के हो चाहे सणी के, <verse eid="LEV 13:47" /><verse number="48" style="v" sid="LEV 13:48" />वो रोग चाहे उस सणी या ऊन कै कपड़े कै ताणे म्ह चाहे बाने म्ह, या वो लक्षण चमड़े म्ह या चमड़े की बणी होई किसे चीज म्ह हो, <verse eid="LEV 13:48" /><verse number="49" style="v" sid="LEV 13:49" />जै वो लक्षण किसे कपड़े कै चाहे ताणे म्ह चाहे बाने म्ह, या चमड़े म्ह या चमड़े की किसे चीज म्ह हरी हो या लाल जिसी हो, तो जाणियो के वो कोढ़ के लक्षण सै अर वो याजक ताहीं दिखाया जावै। <verse eid="LEV 13:49" /><verse number="50" style="v" sid="LEV 13:50" />अर याजक लक्षण नै देक्खै, अर लक्षण आळी चीज नै सात दिन कै खात्तर बन्द करै; <verse eid="LEV 13:50" /><verse number="51" style="v" sid="LEV 13:51" />अर सातमै दिन वो उस लक्षण नै देक्खै, अर जै वो कपड़े कै चाहे ताणे म्ह चाहे बाने म्ह, या चमड़े म्ह या चमड़े की बणी होई किसे चीज म्ह फैलग्या हो, तो जाणियो के लक्षण गलित कोढ़ सै, ज्यांतै वो चीज, चाहे किसे तरियां काम म्ह क्यूँ न्ही आन्दी हो, फेर भी अशुद्ध ठहरैगी। <verse eid="LEV 13:51" /><verse number="52" style="v" sid="LEV 13:52" />वो उस कपड़े नै जिसकै ताणे या बाने म्ह वो लक्षण हो, चाहे वो ऊन का हो चाहे सणी का, या चमड़े की चीज हो, उस ताहीं जळा दे, वो लक्षण गलित कोढ़ के सै; वो चीज आग म्ह जळाई जावै।”<verse eid="LEV 13:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LEV 13:53" />“जै याजक देक्खै सै के वो लक्षण उस कपड़े कै ताणे या बाने म्ह, या चमड़े की उस चीज म्ह कोनी फैल्या, <verse eid="LEV 13:53" /><verse number="54" style="v" sid="LEV 13:54" />तो जिस चीज म्ह लक्षण हो उसकै धोण का हुकम दे, फेर उसनै और भी सात दिन ताहीं बन्द करकै राक्खै; <verse eid="LEV 13:54" /><verse number="55" style="v" sid="LEV 13:55" />अर उसकै धोण कै बाद याजक उसनै देक्खै, अर जै व्याधि का ना तो रंग बदल्या हो, अर ना रोग फैल्या हो, तो जाणियो के वो अशुद्ध सै; उस ताहीं आग म्ह जळाईयो, क्यूँके चाहे वो रोग भित्तर चाहे ऊपरी हो फेर भी वो खा जाण आळा रोग सै। <verse eid="LEV 13:55" /><verse number="56" style="v" sid="LEV 13:56" />पर जै याजक देक्खै, के उसकै धोण कै बाद रोग की चमक घाट होगी, तो वो उस ताहीं कपड़े के ताणे म्ह चाहे बाने म्ह, या चमड़े म्ह तै पाड़कै लिकाड़ो; <verse eid="LEV 13:56" /><verse number="57" style="v" sid="LEV 13:57" />अर जै वो रोग फेर भी उस कपड़ेयां कै ताणे या बाने म्ह, या चमड़े की उस चीज म्ह दिखाई पड़ै, तो जाणियो के वो फूट कै लिकड़या होया रोग सै; अर जिस म्ह वो रोग हो उसनै आग म्ह जळाईयो। <verse eid="LEV 13:57" /><verse number="58" style="v" sid="LEV 13:58" />जै उस कपड़े तै जिसकै ताणे या बाने म्ह लक्षण हो, या चमड़े की जो चीज हो उसतै जिब धोई जावै अर लक्षण जान्दा रहया, तो वो दुसरी बार धुकै शुद्ध ठहरै।”<verse eid="LEV 13:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LEV 13:59" />ऊन या सणी कै कपड़ेयां म्ह कै ताणे या बाने म्ह, या चमड़े की किसे चीज म्ह जो कोढ़ का रोग हो उसकै शुद्ध अर अशुद्ध ठहराण के योए नियम-कायदे सै।<verse eid="LEV 13:59" /></para>
  <chapter eid="LEV 13" />
  <chapter number="14" style="c" sid="LEV 14" />
  <para style="s">चर्म रोग शुद्धिकरण का नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 14:1" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 14:1" /><verse number="2" style="v" sid="LEV 14:2" />“कोढ़ी कै शुद्ध ठहराण के नियम-कायदे ये सै: वो याजक कै धोरै पोहचाया जावै; <verse eid="LEV 14:2" /><verse number="3" style="v" sid="LEV 14:3" />अर याजक छावणी कै बाहर जावै, अर याजक उस कोढ़ी नै देक्खै, अर जै उसका कोढ़ का रोग चंगा होया हो, <verse eid="LEV 14:3" /><verse number="4" style="v" sid="LEV 14:4" />तो याजक हुकम दे के शुद्ध होण कै खात्तर दो शुद्ध अर जिन्दा पंछी, देवदार की लाकड़ी, अर लाल रंग का कपड़ा अर जूफा ये सारे लिये जावैं; <verse eid="LEV 14:4" /><verse number="5" style="v" sid="LEV 14:5" />अर याजक हुकम दे के एक पंछी बहन्दे होए पाणी कै उप्पर माट्टी कै बरतन म्ह बलि करया जावै। <verse eid="LEV 14:5" /><verse number="6" style="v" sid="LEV 14:6" />फेर वो जिन्दा पंछी नै देवदार की लाकड़ी अर लाल रंग के कपड़े अर जूफा इन सारया नै लेकै एक साथ उस पंछी कै लहू म्ह जो बहन्दे होए पाणी कै उप्पर बलि करया गया सै डुबा दें; <verse eid="LEV 14:6" /><verse number="7" style="v" sid="LEV 14:7" />अर कोढ़ तै ठीक ठहरण आळे पै सात बार छिड़क कै उसनै शुद्ध ठहरावै, फेर उस जिन्दा पंछी नै मैदान म्ह छोड़ दे। <verse eid="LEV 14:7" /><verse number="8" style="v" sid="LEV 14:8" />अर शुद्ध ठहरण आळा अपणे कपड़ेयां नै धोवै, अर सारे बाळ मुंडवा कै पाणी तै स्नान करै, फेर वो शुद्ध ठहरैगा; अर उसकै बाद वो छावणी म्ह आण पावै, पर सात दिन तक अपणे डेरे तै बाहर ए रहवै। <verse eid="LEV 14:8" /><verse number="9" style="v" sid="LEV 14:9" />अर सातमै दिन वो सिर, दाढ़ी अर भौहों के सारे बाळ मुंडावै, अर सारे अंग मुण्डन करवावै, अर अपणे कपड़ेयां नै धोवै, अर पाणी तै स्नान करै, फेर वो शुद्ध ठहरैगा।”<verse eid="LEV 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 14:10" />“आठवें दिन वो दो बेकसूर भेड़ कै बच्‍चे, अर एक साल की बेकसूर भेड़ की बच्‍ची, अर अन्‍नबलि कै खात्तर तेल तै सण्या होया एपा का तीन दहाई हिस्सा मैद्दा, अर लोज भर तेल<note caller="+" style="f"><char style="fr" closed="false">14:10 </char><char style="fq" closed="false">तेल </char><char style="ft" closed="false">334 ग्राम जैतून का तेल अर 3 किलोग्राम मैद्दा</char></note> ल्यावै। <verse eid="LEV 14:10" /><verse number="11" style="v" sid="LEV 14:11" />अर शुद्ध ठहराण आळा याजक इन चिज्जां सुधा उस शुद्ध होण आळे माणस नै यहोवा कै स्याम्ही मिलापआळे तम्बू कै दरबाजे पै खड्या करै। <verse eid="LEV 14:11" /><verse number="12" style="v" sid="LEV 14:12" />फेर याजक एक ए भेड़ का बच्‍चा लेकै दोषबलि कै खात्तर उस ताहीं अर उस लोज भर तेल नै धोरै ल्यावै, अर इन दोनुआ नै हिलाणे की भेंट कै खात्तर यहोवा कै स्याम्ही हिलावै; <verse eid="LEV 14:12" /><verse number="13" style="v" sid="LEV 14:13" />अर वो उस भेड़ के बच्‍चे नै उस्से जगहां म्ह जड़ै वो पापबलि अर होमबलि पशुआं का बलिदान करया करैगा, यानिके पवित्र स्‍थान म्ह बलिदान करै; क्यूँके जिस तरियां पापबलि याजक का खुद का हिस्सा होवैगा उस्से तरियां ए दोषबलि भी उस्से का खुद हिस्सा ठहरैगा; वो परमपवित्र सै। <verse eid="LEV 14:13" /><verse number="14" style="v" sid="LEV 14:14" />फेर याजक दोषबलि कै लहू म्ह तै कुछ लेकै शुद्ध ठहराण आळे कै सोळे कान के सिरे पै, अर उसकै सोळे हाथ अर सोळे पैर कै अँगूठयाँ पै लगावै। <verse eid="LEV 14:14" /><verse number="15" style="v" sid="LEV 14:15" />फेर याजक उस लोज भर तेल म्ह तै कुछ लेकै अपणे ओळे हाथ की हथेळी पै गेरै, <verse eid="LEV 14:15" /><verse number="16" style="v" sid="LEV 14:16" />अर याजक अपणे सोळे हाथ की आंगळी नै अपणी ओळी हथेळी पै कै तेल म्ह डबोकै उस तेल म्ह तै कुछ अपणी आन्गळी तै यहोवा कै स्याम्ही सात बार छिड़कै। <verse eid="LEV 14:16" /><verse number="17" style="v" sid="LEV 14:17" />अर जो तेल उसकी हथेळी पै रह जावैगा याजक उस म्ह तै कुछ शुद्ध होण आळे कै सोळे कान के सिरे पै, अर उसकै सोळे हाथ अर सोळे पैर कै अँगूठयाँ पै दोषबलि के लहू कै उप्पर लगावै; <verse eid="LEV 14:17" /><verse number="18" style="v" sid="LEV 14:18" />अर जो तेल याजक की हथेळी पै रह ज्या उसनै वो शुद्ध होण आळे कै सिर पै गेर दे। अर याजक उसकै खात्तर यहोवा कै स्याम्ही प्रायश्चित करै। <verse eid="LEV 14:18" /><verse number="19" style="v" sid="LEV 14:19" />याजक पापबलि नै भी चढ़ाकै उसकै खात्तर जो अपणी अशुद्धता तै शुद्ध होण आळा हो प्रायश्चित करै; अर उसकै बाद होमबलि पशु का बलिदान करकै <verse eid="LEV 14:19" /><verse number="20" style="v" sid="LEV 14:20" />अन्‍नबलि सुधा वेदी पै चढ़ावै अर याजक उसकै खात्तर प्रायश्चित करै, अर वो शुद्ध ठहरैगा।”<verse eid="LEV 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 14:21" />“पर जै वो गरीब हो अर इतणा ल्याण कै खात्तर उसकै धोरै पूंजी ना हो, तो वो अपणा प्रायश्चित करवाण के खात्तर, हिलाणे कै खात्तर भेड़ का बच्‍चा दोषबलि कै खात्तर, अर तेल तै सण्या होया एपा का दसमां हिस्सा मैद्दा अन्‍नबलि करकै, अर लोज भर<note caller="+" style="f"><char style="fr" closed="false">14:21 </char><char style="fq" closed="false">लोज भर </char><char style="ft" closed="false">334 ग्राम जैतून का तेल अर 3 किलोग्राम मैद्दा</char></note> तेल लावै; <verse eid="LEV 14:21" /><verse number="22" style="v" sid="LEV 14:22" />अर दो पंडुक, या कबूतरी के दो बच्‍चे ल्यावै, जो वो ल्या सकै; अर इन म्ह तै एक तो पापबलि कै खात्तर अर दूसरा होमबलि कै खात्तर हो। <verse eid="LEV 14:22" /><verse number="23" style="v" sid="LEV 14:23" />अर आठवें<note caller="+" style="f"><char style="fr" closed="false">14:23 </char><char style="fq" closed="false">आठवें </char><char style="ft" closed="false">शुद्धिकरण के आठवें दिन</char></note> दिन वो इन सारया नै अपणे शुद्ध ठहरण कै खात्तर मिलापआळे तम्बू के दरबाजे पै, यहोवा कै स्याम्ही, याजक कै धोरै ले आवै; <verse eid="LEV 14:23" /><verse number="24" style="v" sid="LEV 14:24" />फेर याजक उस लोज भर तेल अर दोषबलि आळे भेड़ कै बच्यां नै लेकै हिलाणे की भेंट कै खात्तर यहोवा कै स्याम्ही हिलावै। <verse eid="LEV 14:24" /><verse number="25" style="v" sid="LEV 14:25" />फेर दोषबलि के भेड़ के बच्‍चे का बलिदान करया जावै; अर याजक उसके लहू म्ह तै कुछ लेकै शुद्ध ठहरण आळे कै सोळे कान के सिरे पै, अर उसकै सोळे हाथ अर सोळे पैर कै अँगूठयाँ पै लगावै। <verse eid="LEV 14:25" /><verse number="26" style="v" sid="LEV 14:26" />फेर याजक उस तेल म्ह तै कुछ अपणे ओळे हाथ की हथेळी पै गेर कै, <verse eid="LEV 14:26" /><verse number="27" style="v" sid="LEV 14:27" />अपणे सोळे हाथ की आन्गळी तै अपणी ओळी हथेळी पै कै तेल म्ह तै कुछ यहोवा कै स्याम्ही सात बार छिड़कै; <verse eid="LEV 14:27" /><verse number="28" style="v" sid="LEV 14:28" />फेर याजक अपणी हथेळी पै कै तेल म्ह तै कुछ शुद्ध ठहरण आळे कै सोळे कान के सिरे पै, अर उसकै सोळे हाथ अर सोळे पैर कै अँगूठयाँ पै, दोषबलि के लहू कै जगहां पै लगावै। <verse eid="LEV 14:28" /><verse number="29" style="v" sid="LEV 14:29" />अर जो तेल याजक की हथेळी पै रह जावै उसनै वो शुद्ध ठहरण आळे कै खात्तर यहोवा कै स्याम्ही प्रायश्चित करण नै उसकै सिर पै गेर दे। <verse eid="LEV 14:29" /><verse number="30" style="v" sid="LEV 14:30" />फेर वो पंडुक या कबूतरी के बच्यां म्ह तै जो वो ल्या सक्या हो एक नै चढ़ावै, <verse eid="LEV 14:30" /><verse number="31" style="v" sid="LEV 14:31" />यानिके जो पंछी वो ल्या सक्या हो, उन म्ह तै वो एक नै पापबलि कै खात्तर अर अन्‍नबलि सुधा दुसरे नै होमबलि कै खात्तर चढ़ावै; इस तरियां तै याजक शुद्ध ठहरण आळे कै खात्तर यहोवा कै स्याम्ही प्रायश्चित करै। <verse eid="LEV 14:31" /><verse number="32" style="v" sid="LEV 14:32" />जिसकै कोढ़ का रोग होया हो, अर उसपै इतणी पूंजी ना हो के वो शुद्ध ठहरण की सामग्री नै ल्या सकै, तो उसकै खात्तर योए नियम-कायदे सै।”<verse eid="LEV 14:32" /></para>
  <para style="s">घर म्ह लाग्गी फफूंदी कै खात्तर नियम</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 14:33" />फेर यहोवा नै मूसा अर हारुन तै कह्या, <verse eid="LEV 14:33" /><verse number="34" style="v" sid="LEV 14:34" />“जिब थम कनान देश म्ह पोहचों, जिस ताहीं मै थारी अपणी धरती होण कै खात्तर थारै तै देऊँ सूं, उस बखत जै मै कोढ़ के रोग थारे हक कै किसे घर म्ह दिखाऊँ, <verse eid="LEV 14:34" /><verse number="35" style="v" sid="LEV 14:35" />तो जिसका वो घर हो वो आकै याजक नै बता दे के मन्‍नै इसा दिखाई पड़ै सै के घर म्ह मान्‍नो कोए रोग सै। <verse eid="LEV 14:35" /><verse number="36" style="v" sid="LEV 14:36" />फेर याजक हुकम दे के उस घर म्ह रोग देखण कै खात्तर मेरै जाण तै पैहल्या उसनै खाल्‍ली कर द्यो, कदे इसा ना हो के जो कुछ घर म्ह हो वो सारा अशुद्ध ठहरै; अर इसकै बाद याजक घर देखण भित्तर जावै। <verse eid="LEV 14:36" /><verse number="37" style="v" sid="LEV 14:37" />फेर वो उस लक्षण नै देक्खै; अर जै वो लक्षण घर की दीवारां पै हरी-हरी या लाल-लाल मान्‍नो खुदी होई लकीरां के रूप म्ह हो, अर ये लकीर दीवार म्ह डून्घी दिखाई पड़दी हों, <verse eid="LEV 14:37" /><verse number="38" style="v" sid="LEV 14:38" />तो याजक घर तै बाहर दरबाजे पै जाकै घर नै सात दिन तक बन्द करकै राक्खै। <verse eid="LEV 14:38" /><verse number="39" style="v" sid="LEV 14:39" />अर सातमै दिन याजक आकै देक्खै; अर जै वो लक्षण घर की दीवारां पै फैलग्या हो, <verse eid="LEV 14:39" /><verse number="40" style="v" sid="LEV 14:40" />तो याजक हुकम दे के जिन पत्थरां कै लक्षण सै उननै लिकाड़कै नगर तै बाहर किसे अशुद्ध जगहां म्ह बगा दें; <verse eid="LEV 14:40" /><verse number="41" style="v" sid="LEV 14:41" />अर वो घर कै भित्तर ए भित्तर चौगरदे खुरचवावै, अर वो खुरचण की माट्टी नगर तै बाहर किसे अशुद्ध जगहां म्ह गेर दी जावै; <verse eid="LEV 14:41" /><verse number="42" style="v" sid="LEV 14:42" />अर उन पत्थरां की जगहां म्ह और दुसरे पत्थर ल्याकै लगावै अर याजक ताजा गारा लेकै घर की जुड़ाई करै।”<verse eid="LEV 14:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LEV 14:43" />“जै पत्थरां कै काड्डै जाण अर घर कै खुरचे अर लिपाई हो जाणकै बाद वो लक्षण फेर घर म्ह फूट लिकड़ै, <verse eid="LEV 14:43" /><verse number="44" style="v" sid="LEV 14:44" />तो याजक आकै देक्खै; अर जै वो लक्षण घर म्ह फैलग्या हो, तो वो जाण ले के घर म्ह गलित कोढ़ सै; वो अशुद्ध सै। <verse eid="LEV 14:44" /><verse number="45" style="v" sid="LEV 14:45" />अर वो सारे गारा सुधा पत्थर, लाकड़ी अर घर नै खुदवाकै गिरवा दे; अर उन सारी चिज्जां नै ठुवा कै नगर तै बाहर किसे अशुद्ध जगहां पै फिकवा दे। <verse eid="LEV 14:45" /><verse number="46" style="v" sid="LEV 14:46" />अर जिब ताहीं वो घर बन्द रहवै जद तक जो कोए उस म्ह जावै तो वो साँझ ताहीं अशुद्ध रहवै; <verse eid="LEV 14:46" /><verse number="47" style="v" sid="LEV 14:47" />अर जो कोए उस घर म्ह सोग्या वो अपणे कपड़ेयां नै धोवै; अर जो कोए उस घर म्ह खाणा खावै सै वो भी अपणे कपड़ेयां नै धोवै।”<verse eid="LEV 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LEV 14:48" />“पर जै याजक आकै देक्खै के जिब तै घर लिप्या गया सै जद तै उस म्ह रोग कोनी फैल्या सै, तो न्यू जाणकै के वो रोग दूर होग्या सै, घर नै शुद्ध ठहरावै। <verse eid="LEV 14:48" /><verse number="49" style="v" sid="LEV 14:49" />अर उस घर नै पवित्र करण कै खात्तर दो पंछी, देवदार की लाकड़ी, लाल रंग का कपड़ा अर जूफा ल्यावै, <verse eid="LEV 14:49" /><verse number="50" style="v" sid="LEV 14:50" />अर एक पंछी बहन्दे होए पाणी कै उप्पर माट्टी कै बरतन म्ह बलिदान करै, <verse eid="LEV 14:50" /><verse number="51" style="v" sid="LEV 14:51" />फेर वो देवदार की लाकड़ी, लाल रंग के कपड़े अर जूफा अर जिन्दा पंछी इन सारया नै लेकै बलिदान करे होए पंछी कै लहू म्ह अर बहन्दे होए पाणी म्ह डबो दे, अर उस घर पै सात बार छिड़कै। <verse eid="LEV 14:51" /><verse number="52" style="v" sid="LEV 14:52" />इस तरियां वो पंछी कै लहू, अर बहन्दे होए पाणी, अर जिन्दा पंछी, अर देवदार की लाकड़ी, अर जूफा अर लाल रंग के कपड़े कै जरिये घर नै पवित्र करै; <verse eid="LEV 14:52" /><verse number="53" style="v" sid="LEV 14:53" />फेर वो जिन्दा पंछी नै नगर तै बाहर मैदान म्ह छोड़ दे; इस्से तरियां तै वो घर कै खात्तर प्रायश्चित करै, फेर वो शुद्ध ठहरैगा।”<verse eid="LEV 14:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="LEV 14:54" />सारे ढाळ के कोढ़ के लक्षण, अर सेंहुएँ, <verse eid="LEV 14:54" /><verse number="55" style="v" sid="LEV 14:55" />अर कपड़े, अर घर कै कोढ़, <verse eid="LEV 14:55" /><verse number="56" style="v" sid="LEV 14:56" />अर सोई, अर पापड़ी, अर दाग कै बारै म्ह, <verse eid="LEV 14:56" /><verse number="57" style="v" sid="LEV 14:57" />शुद्ध अर अशुद्ध ठहराण की शिक्षा देण के नियम-कायदे योए सै। सारे ढाळ के कोढ़ के नियम-कायदे येए सै।<verse eid="LEV 14:57" /></para>
  <chapter eid="LEV 14" />
  <chapter number="15" style="c" sid="LEV 15" />
  <para style="s">शरीर तै बहणआळे अशुद्ध स्राव</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 15:1" />फेर यहोवा नै मूसा अर हारुन तै कह्या, <verse eid="LEV 15:1" /><verse number="2" style="v" sid="LEV 15:2" />“इस्राएलियाँ तै कहो के जिस-जिस आदमी कै धातु रोग हो, तो वो धातु रोग कै कारण अशुद्ध ठहरै। <verse eid="LEV 15:2" /><verse number="3" style="v" sid="LEV 15:3" />वो चाहे बैहन्दा रहवै, चाहे बहणा बन्द भी हो, तोभी उसकी अशुद्धता बणी रहवैगी। <verse eid="LEV 15:3" /><verse number="4" style="v" sid="LEV 15:4" />जिसकै धातु रोग हो वो जिस-जिस बिछाणा पै लेटै वो अशुद्ध ठहरै, अर जिस-जिस चीज पै वो बैठ्ठै वो भी अशुद्ध ठहरै। <verse eid="LEV 15:4" /><verse number="5" style="v" sid="LEV 15:5" />अर जो कोए उसके बिछोणे नै छुवै वो अपणे कपड़े नै धोकै पाणी तै नहावै, अर साँझ तक अशुद्ध ठहरया रहवै। <verse eid="LEV 15:5" /><verse number="6" style="v" sid="LEV 15:6" />अर जिसकै धातु रोग हो अर वो जिस चीज पै बैठ्या हो, उसपै जो कोए बैठ्ठै वो अपणे कपड़ेयां नै धोकै पाणी तै नहावै, अर साँझ तक अशुद्ध ठहरया रहवै। <verse eid="LEV 15:6" /><verse number="7" style="v" sid="LEV 15:7" />अर जिसकै धातु रोग हो उसतै जो कोए छू जावै सै वो अपणे कपड़ेयां नै धोकै पाणी तै नहावै अर साँझ तक अशुद्ध रहवै। <verse eid="LEV 15:7" /><verse number="8" style="v" sid="LEV 15:8" />अर जिसकै धातु रोग हो जै वो किसे शुद्ध माणस पै थूकै, तो वो अपणे कपड़ेयां नै धोकै पाणी तै नहावै, अर साँझ तक अशुद्ध रहवै। <verse eid="LEV 15:8" /><verse number="9" style="v" sid="LEV 15:9" />अर जिसकै धातु रोग हो वो सवारी की जिस चीज पै बैठ्ठै वो अशुद्ध ठहरै। <verse eid="LEV 15:9" /><verse number="10" style="v" sid="LEV 15:10" />अर जो कोए उस चीज नै जो उसकै तळै रही हो छुवै, वो साँझ तक अशुद्ध रहवै; अर जो कोए इसी किसे चीज नै ठावै वो अपणे कपड़ेयां नै धोवै अर पाणी तै नहावै, अर साँझ तक अशुद्ध रहवै। <verse eid="LEV 15:10" /><verse number="11" style="v" sid="LEV 15:11" />अर जिसकै धातु रोग हो वो जिस किसे नै बिना हाथ धोए छुवै वो अपणे कपड़ेयां नै धोकै पाणी तै नहावै, अर साँझ तक अशुद्ध रहवै। <verse eid="LEV 15:11" /><verse number="12" style="v" sid="LEV 15:12" />अर जिसकै प्रमेह हो वो माट्टी के जिस किसे बरतन नै छुवै वो तोड़ दिया जावै, अर काठ के सारे ढाळ के बरतन पाणी तै धोए जावै।”<verse eid="LEV 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 15:13" />“फेर जिसकै धातु रोग हो वो जिब अपणे रोग तै ठीक हो जावै, तब तै शुद्ध ठहरण के सात दिन गिण ले, अर उनकै बीतण पै अपणे कपड़ेयां नै धोकै बहन्दे होए पाणी म्ह नहावै; फेर वो शुद्ध ठहरैगा। <verse eid="LEV 15:13" /><verse number="14" style="v" sid="LEV 15:14" />अर आठवें दिन वो दो पंडुक या कबूतरी के दो बच्‍चे लेकै मिलापआळे तम्बू कै दरबाजे पै यहोवा कै स्याम्ही जाकै उननै याजक नै दे। <verse eid="LEV 15:14" /><verse number="15" style="v" sid="LEV 15:15" />फेर याजक उन म्ह तै एक नै पापबलि; अर दुसरे नै होमबलि कै खात्तर चढ़ावा चढ़ावै; अर याजक उसकै खात्तर उसके धातु रोग कै कारण यहोवा कै स्याम्ही प्रायश्चित करै।”<verse eid="LEV 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 15:16" />“फेर जै किसे आदमी का वीर्यपात हो जावै, तो वो अपणे सारे शरीर नै पाणी तै धोवै, अर साँझ तक अशुद्ध रहवै। <verse eid="LEV 15:16" /><verse number="17" style="v" sid="LEV 15:17" />अर जिस किसे कपड़े या चमड़े पै वो वीर्य पड़ै वो पाणी तै धोया जावै, अर साँझ तक अशुद्ध रहवै। <verse eid="LEV 15:17" /><verse number="18" style="v" sid="LEV 15:18" />अर जिब कोए आदमी औरत तै प्रसंग करै तो वे दोन्‍नु पाणी तै स्नान करै, अर साँझ तक अशुद्ध रहवै।”<verse eid="LEV 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 15:19" />“फेर जिब किसे औरत नै मासिक धर्म रहवै, तो वो सात दिन तक अशुद्ध बणी रहवै, अर जो कोए उसनै छुवै वो साँझ ताहीं अशुद्ध रहवै।<verse eid="LEV 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 15:20" />अर जिब तक वो अशुद्ध रहवै जद तक जिस-जिस चीज पै वो लेटै, अर जिस-जिस चीज पै वो बैठ्ठै वे सारी अशुद्ध ठहरै। <verse eid="LEV 15:20" /><verse number="21" style="v" sid="LEV 15:21" />अर जो कोए उसके बिछोणे नै छुवै वो अपणे कपड़े धोकै पाणी तै नहावै, अर साँझ तक अशुद्ध रहवै। <verse eid="LEV 15:21" /><verse number="22" style="v" sid="LEV 15:22" />अर जो कोए किसे चीज नै छुए जिसपै वो बैठ्ठी हो वो अपणे कपड़े धोकै पाणी तै नहावै अर साँझ तक अशुद्ध रहवै। <verse eid="LEV 15:22" /><verse number="23" style="v" sid="LEV 15:23" />अर जै बिछोणे या और किसे चीज पै जिसपै वो बैठ्ठी हो जै कोए उस चीज नै छुवै, तो छूण आळे साँझ तक अशुद्ध रहवै। <verse eid="LEV 15:23" /><verse number="24" style="v" sid="LEV 15:24" />अर जै कोए आदमी उसतै प्रसंग करै, अर उसका रूधिर उसकै लाग ज्या, तो वो आदमी सात दिन तक अशुद्ध रहवै, अर जिस-जिस बिछोणा पै वो लेटै वे सारे अशुद्ध ठहरै।”<verse eid="LEV 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 15:25" />“फेर जै किसे औरत कै अपणे मासिक धर्म के नियुक्त बखत तै घणे दिन ताहीं रूधिर बैहन्दा रहवै, या उस नियुक्त बखत तै ज्यादा बखत तक मासिक धर्म रहवै तो जिब तक वो इसी हालत म्ह रहवै तब ताहीं वो अशुद्ध बणी रहवै। <verse eid="LEV 15:25" /><verse number="26" style="v" sid="LEV 15:26" />उसकै मासिक धर्म रहण के सारे दिनां म्ह जिस-जिस बिछोणे पै वो लेटै वे सारे उसकै मासिक धर्म के बिछोणे की ढाळ ठहरै; अर जिस-जिस चीज पै वो बैठ्ठै वे भी उसकै मासिक धर्म रहण कै दिनां की तरियां अशुद्ध ठहरै। <verse eid="LEV 15:26" /><verse number="27" style="v" sid="LEV 15:27" />अर जो कोए उन चिज्जां नै छुवै वो अशुद्ध ठहरै, ज्यांतै वो अपणे कपड़े धोकै पाणी तै नहावै, अर साँझ तक अशुद्ध रहवै। <verse eid="LEV 15:27" /><verse number="28" style="v" sid="LEV 15:28" />अर जिब वो औरत अपणे मासिक धर्म तै ठीक हो ज्या, फेर तै वो सात दिन गिण ले, अर उन दिनां कै बीतण पै वो शुद्ध ठहरै। <verse eid="LEV 15:28" /><verse number="29" style="v" sid="LEV 15:29" />फेर आठवें दिन वो दो पंडुक या कबूतरी के दो बच्‍चे लेकै मिलापआळे तम्बू कै दरबाजे पै याजक कै धोरै जावै। <verse eid="LEV 15:29" /><verse number="30" style="v" sid="LEV 15:30" />फेर याजक एक नै पापबलि अर दुसरे नै होमबलि कै खात्तर चढ़ावै; अर याजक उसकै खात्तर उसकै मासिक धर्म की अशुद्धता के कारण यहोवा कै स्याम्ही प्रायश्चित करै।”<verse eid="LEV 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 15:31" />“इस तरियां तै थम इस्राएलियाँ नै उनकी अशुद्धता तै न्यारे राख्या करो, कदे इसा ना हो के वे यहोवा का निवास जो उनकै बिचाळै सै अशुद्ध करकै अपणी अशुद्धता म्ह फँसकै मर ज्यां।”<verse eid="LEV 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 15:32" />जिसकै धातु रोग हो अर जो आदमी वीर्यपात होण तै अशुद्ध हो; <verse eid="LEV 15:32" /><verse number="33" style="v" sid="LEV 15:33" />अर जो औरत मासिक धर्म तै हो; अर के आदमी के औरत, जिस किसे कै धातु रोग हो, अर जो आदमी अशुद्ध औरत कै गेल्या प्रसंग करै, इन सारया कै खात्तर येए नियम-कायदे सै।<verse eid="LEV 15:33" /></para>
  <chapter eid="LEV 15" />
  <chapter number="16" style="c" sid="LEV 16" />
  <para style="s">पाप तै छुटकारै का दिन</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 16:1" />जिब हारुन के दो बेट्टे यहोवा कै स्याम्ही धोरै जाकै मरगे, उसकै बाद यहोवा नै मूसा तै बात करी; <verse eid="LEV 16:1" /><verse number="2" style="v" sid="LEV 16:2" />अर यहोवा नै मूसा तै कह्या, “अपणे भाई हारुन तै कह के सन्दूक कै उप्पर कै प्रायश्चित आळे ढक्‍कण कै आग्गै, बीचआळे पड़दे कै भित्तर, अति पवित्र स्‍थान म्ह हर बखत दाखल ना होया करै, न्ही तो वो मर ज्यागा; क्यूँके मै प्रायश्चित आळे ढक्‍कण कै उप्पर बाद्दळ म्ह दिखाई दियुँगा। <verse eid="LEV 16:2" /><verse number="3" style="v" sid="LEV 16:3" />जिब हारुन अति पवित्र स्‍थान म्ह दाखल होवै फेर इस तरियां तै जाया करै, यानिके पापबलि कै खात्तर एक बाछड़े नै अर होमबलि कै खात्तर एक मिंढे नै लेकै आवै। <verse eid="LEV 16:3" /><verse number="4" style="v" sid="LEV 16:4" />वो सणी के कपड़े का पवित्र अंगरखा, अर अपणे तन पै सणी के कपड़े का जाँघिया पहरे होए, अर सणी के कपड़े का कटिबन्ध, अर सणी के कपड़े की पगड़ी बाँधे होए दाखल हो; ये पवित्र कपड़े सैं, अर वो पाणी तै नहाकै इननै पहरै। <verse eid="LEV 16:4" /><verse number="5" style="v" sid="LEV 16:5" />फेर वो इस्राएल की मण्डळी कै धोरै तै पापबलि कै खात्तर दो बकरे अर होमबलि कै खात्तर एक मिंढा ले। <verse eid="LEV 16:5" /><verse number="6" style="v" sid="LEV 16:6" />अर हारुन उस पापबलि कै बाछड़े नै जो उस्से कै खात्तर चढ़ाकै अपणे अर अपणे कुण्बे कै खात्तर प्रायश्चित करै। <verse eid="LEV 16:6" /><verse number="7" style="v" sid="LEV 16:7" />अर उन दोन्‍नु बकरयां नै लेकै मिलापआळे तम्बू के दरबाजे पै यहोवा कै स्याम्ही खड्या करै; <verse eid="LEV 16:7" /><verse number="8" style="v" sid="LEV 16:8" />अर हारुन दोन्‍नु बकरयां पै चिट्ठी गेरै, एक चिट्ठी यहोवा कै खात्तर अर दुसरी अजाजेल कै खात्तर हो। <verse eid="LEV 16:8" /><verse number="9" style="v" sid="LEV 16:9" />अर जिस बकरे पै यहोवा कै नाम की चिट्ठी लिकड़ै उसनै हारुन पापबलि कै खात्तर चढ़ावै; <verse eid="LEV 16:9" /><verse number="10" style="v" sid="LEV 16:10" />पर जिस बकरे पै अजाजेल कै खात्तर चिट्ठी लिकड़ै वो यहोवा कै स्याम्ही जिन्दा खड्या करया जावै के उसतै प्रायश्चित करया जावै, अर वो अजाजेल कै खात्तर जंगळ-बियाबान म्ह छोड्या जावै।”<verse eid="LEV 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 16:11" />“हारुन उस पापबलि के बाछड़े नै, जो उस्से कै खात्तर होवैगा, धोरै ले आवै, अर उसनै बलिदान करकै अपणे अर अपणे कुण्बे कै खात्तर प्रायश्चित करै। <verse eid="LEV 16:11" /><verse number="12" style="v" sid="LEV 16:12" />अर जो वेदी यहोवा कै स्याम्ही सै, उसपै के जळदे होए कोयला तै भरे होए धूपदान नै लेकै, अर अपणी दोन्‍नु मुट्ठियाँ नै कूटे होए खुशबुदार धूप तै भरकै, बीच आळे पड़दे कै भित्तर ल्याकै <verse eid="LEV 16:12" /><verse number="13" style="v" sid="LEV 16:13" />उस धूप नै यहोवा कै स्याम्ही आग म्ह गेरै, जिसतै धूपदान का धुम्मा साक्षीपत्र कै उप्पर के प्रायश्चित कै ढक्‍कण के उप्पर छा जावै, न्ही तो वो मर ज्यागा; <verse eid="LEV 16:13" /><verse number="14" style="v" sid="LEV 16:14" />फेर वो बाछड़े कै लहू म्ह तै कुछ लेकै पूरब की ओड़ प्रायश्चित कै ढक्‍कण कै उप्पर अपणी आन्गळी तै छिड़कै, अर फेर उस लहू म्ह तै कुछ आंगळी कै जरिये उस ढक्‍कण कै स्याम्ही भी सात बार छिड़क दे। <verse eid="LEV 16:14" /><verse number="15" style="v" sid="LEV 16:15" />फेर वो उस पापबलि कै बकरे नै जो साधारण जनता कै खात्तर होवैगा बलिदान करकै उसकै लहू नै बीचआळे पड़दे कै भित्तर ले आवै, अर जिस तरियां बाछड़े कै लहू तै उसनै करया था ठीक उस्से तरियां ए वो बकरे कै लहू तै भी करै, यानिके उसनै प्रायश्चित कै ढक्‍कण कै उप्पर अर उसकै स्याम्ही छिड़कै। <verse eid="LEV 16:15" /><verse number="16" style="v" sid="LEV 16:16" />अर वो इस्राएलियाँ की कई ढाळ की अशुद्धता, अर अपराध्धां, अर उनके सारे पापां के कारण पवित्र स्‍थान कै खात्तर प्रायश्चित करै; अर मिलापआळा तम्बू जो उनकै गैल उनकी कई ढाळ की अशुद्धता के बिचाळै रहवै सै उसकै खात्तर भी वो उस्से तरियां ए करै। <verse eid="LEV 16:16" /><verse number="17" style="v" sid="LEV 16:17" />जिब हारुन प्रायश्चित करण कै खात्तर अति पवित्र स्‍थान म्ह दाखल हो, जिब तक वो अपणे अर अपणे कुण्बे अर इस्राएल की सारी मण्डळी कै खात्तर प्रायश्चित करकै बाहर ना लिकड़ै तब ताहीं कोए माणस मिलापआळे तम्बू म्ह ना रहवै। <verse eid="LEV 16:17" /><verse number="18" style="v" sid="LEV 16:18" />फेर वो लिकड़कै उस वेदी कै धोरै जो यहोवा कै स्याम्ही सै जावै अर उसकै खात्तर प्रायश्चित करै, यानिके बाछड़े कै लहू अर बकरे कै लहू दोनुआं म्ह तै कुछ लेकै उस वेदी कै च्यांरु कुण्यां कै सीन्गां पै लगावै। <verse eid="LEV 16:18" /><verse number="19" style="v" sid="LEV 16:19" />अर उस लहू म्ह तै कुछ अपणी आंगळी कै जरिये सात बार उसपै छिड़क कै उसनै इस्राएलियाँ की कई ढाळ की अशुद्धता तै छुड़ाकै शुद्ध अर पवित्र करै।”<verse eid="LEV 16:19" /></para>
  <para style="s">प्रायश्चित का बकरा</para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 16:20" />“जिब वो पवित्र स्‍थान अर मिलापआळे तम्बू अर वेदी कै खात्तर प्रायश्चित कर ले, तो फेर वो जिन्दा बकरे नै आग्गै ल्यावै; <verse eid="LEV 16:20" /><verse number="21" style="v" sid="LEV 16:21" />अर हारुन अपणे दोन्‍नु हाथ्थां नै जिन्दा बकरे पै धरकै इस्राएलियाँ के सारे अधर्म के काम्मां, अर उनके सारे अपराध्धां, यानिके उनके सारे पापां नै मानकै, अर उन ताहीं बकरे कै सिर पै धरकै उसनै किसे माणस कै हाथ जो इस काम कै खात्तर त्यार हो जंगळ-बियाबान म्ह भेजकै छुड़वा दे। <verse eid="LEV 16:21" /><verse number="22" style="v" sid="LEV 16:22" />वो बकरा उनके सारे अधर्म के काम्मां नै अपणे उप्पर लादे होए किसे निर्जन देश म्ह ठा ले जावैगा; ज्यांतै वो माणस उस बकरे नै जंगळ-बियाबान म्ह छोड़ दे।”<verse eid="LEV 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 16:23" />“फेर हारुन मिलापआळे तम्बू म्ह आवै, अर जिस सणी की पोशाक नै पहरे होए वो अति पवित्रस्‍थान म्ह दाखल होया था उननै तारकै उड़ैए धरदे। <verse eid="LEV 16:23" /><verse number="24" style="v" sid="LEV 16:24" />फेर वो किसे पवित्र स्‍थान म्ह पाणी तै नहाकै अपणे कपड़े पैहर ले, अर बाहर जाकै अपणे होमबलि अर साधारण जनता कै होमबलि नै चढ़ाकै अपणे अर जनता कै खात्तर प्रायश्चित करै। <verse eid="LEV 16:24" /><verse number="25" style="v" sid="LEV 16:25" />अर पापबलि की चर्बी नै वो वेदी पै जळावै। <verse eid="LEV 16:25" /><verse number="26" style="v" sid="LEV 16:26" />अर जो माणस बकरे नै अजाजेल कै खात्तर छोड़कै आये वो भी अपणे कपड़ेयां नै, धोवै पाणी तै नहावै, अर फेर वो छावणी म्ह दाखल होवै। <verse eid="LEV 16:26" /><verse number="27" style="v" sid="LEV 16:27" />अर पापबलि का बाछड़ा अर पापबलि का बकरा भी जिनका लहू पवित्र स्‍थान म्ह प्रायश्चित करण कै खात्तर पोहचाया जावै वे दोन्‍नु छावणी तै बाहर भेज्जे जावै; अर उनका चमड़ा, माँस, अर गोबर आग म्ह जळा दिए जावै। <verse eid="LEV 16:27" /><verse number="28" style="v" sid="LEV 16:28" />अर जो उन ताहीं जळावै वो अपणे कपड़ेयां नै धोवै, अर पाणी तै नहावै, अर इसकै बाद वो छावणी म्ह दाखल हो पावै।”<verse eid="LEV 16:28" /></para>
  <para style="s">पाप तै प्रायश्चित का दिन मानणा</para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 16:29" />“थारा खात्तर न्यू सदा की विधि होवैगी के सातमै महिन्‍ने कै दसवें दिन म्ह थम उपवास करियो, अर उस दिन कोए भी, चाहे वो थारे अपणे देश का हो चाहे थारै बिचाळै रहणआळे कोए परदेशी हो, कोए भी किसे ढाळ का काम-काज ना करै; <verse eid="LEV 16:29" /><verse number="30" style="v" sid="LEV 16:30" />क्यूँके उस दिन थमनै शुद्ध करण कै खात्तर थारै करकै प्रायश्चित करया जावैगा; अर थम अपणे सारे पापां तै यहोवा कै स्याम्ही पवित्र ठहरोगे। <verse eid="LEV 16:30" /><verse number="31" style="v" sid="LEV 16:31" />यो थारे खात्तर परमविश्राम का दिन ठहरै, अर थम उस दिन उपवास करियो अर किसे ढाळ का काम-काज ना करियो; यो सदा की विधि सै। <verse eid="LEV 16:31" /><verse number="32" style="v" sid="LEV 16:32" />अर जिसका अपणे पिता कै जगहां पै याजक पद कै खात्तर अभिषेक अर संस्कार करया जावै सै वो याजक प्रायश्चित करया करै, यानिके वो सणी के पवित्र कपड़ेयां नै पैहरकै, <verse eid="LEV 16:32" /><verse number="33" style="v" sid="LEV 16:33" />पवित्र स्‍थान, अर मिलापआळे तम्बू, अर वेदी कै खात्तर प्रायश्चित करै; अर याजकां कै अर मण्डळी के सारे माणसां कै खात्तर भी प्रायश्चित करै। <verse eid="LEV 16:33" /><verse number="34" style="v" sid="LEV 16:34" />अर यो थारै खात्तर आग्गै तक की विधि होवैगी, के इस्राएलियाँ कै खात्तर हरेक साल एक बार थारे सारे पापां कै खात्तर प्रायश्चित करया जावै।” यहोवा के इस हुकम कै मुताबिक जो उसनै मूसा तै दिया था, हारुन नै करया।<verse eid="LEV 16:34" /></para>
  <chapter eid="LEV 16" />
  <chapter number="17" style="c" sid="LEV 17" />
  <para style="s">बलिदान की जगहां</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 17:1" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 17:1" /><verse number="2" style="v" sid="LEV 17:2" />“हारुन अर उसकै बेट्याँ तै अर सारे इस्राएल के माणसां तै कह के यहोवा नै यो हुकम दिया सै: <verse eid="LEV 17:2" /><verse number="3" style="v" sid="LEV 17:3" />इस्राएल कै घरान्यां म्ह तै कोए माणस हो जो बळध या भेड़ कै बच्यां, या बकरी नै, चाहे छावणी म्ह चाहे छावणी तै बाहर मारकै <verse eid="LEV 17:3" /><verse number="4" style="v" sid="LEV 17:4" />मिलापआळे तम्बू कै दरबाजे पै, यहोवा के निवास कै स्याम्ही यहोवा के चढ़ाण कै खात्तर ना ले जावै, तो उस माणस कै लहू बहाण का दोष लाग्गैगा; अर वो माणस लहू बहाण आळा ठहरैगा, वो अपणे माणसां कै बिचाळै तै नाश करया जावै। <verse eid="LEV 17:4" /><verse number="5" style="v" sid="LEV 17:5" />इस विधि का यो कारण सै के इस्राएली अपणे बलिदान जिननै वे खुल्‍ले मदानां म्ह मारण जावैं सै, वे उननै मिलापआळे तम्बू के दरबाजे पै याजक कै धोरै, यहोवा कै खात्तर ले जाकै उस्से कै खात्तर मेलबलि करकै बलिदान करया करैं; <verse eid="LEV 17:5" /><verse number="6" style="v" sid="LEV 17:6" />अर याजक लहू नै मिलापआळे तम्बू के दरबाजे पै यहोवा की वेदी कै उप्पर छिड़कै, अर चर्बी नै उसकै सुखदायक सुगन्ध कै खात्तर जळावै। <verse eid="LEV 17:6" /><verse number="7" style="v" sid="LEV 17:7" />वे जो बकरयां<note caller="+" style="f"><char style="fr" closed="false">17:7 </char><char style="fq" closed="false">बकरयां </char><char style="ft" closed="false">दुष्ट आत्मा</char></note> कै पूजण आळे होकै जारी करैं सै वे फेर अपणे बलिपशुआँ नै उनकै खात्तर बलिदान ना करैं। थारी<note caller="+" style="f"><char style="fr" closed="false">17:7 </char><char style="fq" closed="false">थारी </char><char style="ft" closed="false">इसा पाप करणा व्यभिचार के बराबर मान्या जावै था</char></note> पीढ़ियाँ कै खात्तर न्यू सदा की विधि होवैगी।”<verse eid="LEV 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 17:8" />“तू उनतै कह के इस्राएल के कुण्बे के माणसां म्ह तै या उनकै बिचाळै रहण आळे परदेशियाँ म्ह तै कोए माणस क्यूँ ना हो जो होमबलि या मेलबलि चढ़ावै, <verse eid="LEV 17:8" /><verse number="9" style="v" sid="LEV 17:9" />अर उसनै मिलापआळे तम्बू कै दरबाजे पै यहोवा कै खात्तर चढ़ाण नै ना ल्यावै; वो माणस अपणे माणसां म्ह तै नाश करया जावै।”<verse eid="LEV 17:9" /></para>
  <para style="s">जानवरां नै मारण अर खाण का नियम</para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 17:10" />“फेर इस्राएल के कुण्बे के माणसां म्ह तै या उनकै बिचाळै रहण आळे परदेशियाँ म्ह तै कोए माणस क्यूँ ना हो जो किसे ढाळ का लहू खावै, मै उस लहू खाणआळे कै बिरुध्द होकै उसनै उनके माणसां कै बिचाळै म्ह तै नाश कर दियुँगा। <verse eid="LEV 17:10" /><verse number="11" style="v" sid="LEV 17:11" />क्यूँके शरीर का प्राण लहू म्ह होवै सै; अर उस ताहीं मन्‍नै थारे माणसां तै वेदी पै चढ़ाण कै खात्तर दिया सै के थारे प्राणां कै खात्तर प्रायश्चित करया जावै; क्यूँके प्राण कै खात्तर लहू तै ए प्रायश्चित होवै सै। <verse eid="LEV 17:11" /><verse number="12" style="v" sid="LEV 17:12" />इस करकै मै इस्राएल के माणसां तै कहूँ सूं के थारै म्ह तै कोए प्राणी लहू न्ही खावै, अर जै परदेशी थारै बिचाळै रहन्दे हो वो भी लहू कदे न्ही खावै।”<verse eid="LEV 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 17:13" />“इस्राएलियाँ म्ह तै या उनकै बिचाळै रहण आळे परदेशियाँ म्ह तै, कोए माणस क्यूँ न्ही हो, जो शिकार करकै खाण के लायक पशु या पंछी नै पकड़ै, वो उसके लहू नै उण्डेल कै धूळ तै ढक दे। <verse eid="LEV 17:13" /><verse number="14" style="v" sid="LEV 17:14" />क्यूँके शरीर का प्राण जो सै, वो उसका लहू ए सै जो उसकै प्राण कै गेल्या एक सै; ज्यांतै मै इस्राएलियाँ तै कहूँ सूं, के किसे ढाळ के प्राणी कै लहू नै थम ना खाईयों, क्यूँके सारे प्राणियाँ का प्राण उनका लहू ए सै; जो कोए उसनै खावै सै, वो नाश करया जावैगा। <verse eid="LEV 17:14" /><verse number="15" style="v" sid="LEV 17:15" />अर चाहे, वो देशी हो या परदेशी हो, जो कोए किसे लोथ या पाड़े होए पशु का माँस खावै सै वो अपणे कपड़ेयां नै धोवै अर पाणी तै नहावै, अर साँझ तक अशुद्ध रहवै; फेर वो शुद्ध होवैगा। <verse eid="LEV 17:15" /><verse number="16" style="v" sid="LEV 17:16" />पर जै वो उननै न्ही धोवै अर ना नहावै, तो उसनै अपणे अधर्म का बोझ खुद ठाणा पड़ैगा।”<verse eid="LEV 17:16" /></para>
  <chapter eid="LEV 17" />
  <chapter number="18" style="c" sid="LEV 18" />
  <para style="s">यौन नैतिकता का नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 18:1" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 18:1" /><verse number="2" style="v" sid="LEV 18:2" />“इस्राएलियाँ तै कह के मै थारा परमेसवर यहोवा सूं। <verse eid="LEV 18:2" /><verse number="3" style="v" sid="LEV 18:3" />थम मिस्र देश के काम्मां कै मुताबिक, जिस म्ह थम रहों थे, ना करियो; अर कनान देश के काम्मां कै तरियां भी, जड़ै मै थमनै ले चाल्‍लूँ सूं, ना करियो; अर ना उन देशां की विधियाँ कै मुताबिक अपणा जीवन बिताईयो। <verse eid="LEV 18:3" /><verse number="4" style="v" sid="LEV 18:4" />मेरे ए नियमां नै मान्दे होए मेरी ए विधियाँ नै मान्दे होए उनपै चालियो। मै थारा परमेसवर यहोवा सूं। <verse eid="LEV 18:4" /><verse number="5" style="v" sid="LEV 18:5" />इस करकै थम मेरे नियमां अर मेरी विधियाँ नै लगातार मानियो; जो माणस उननै मान्‍नै सै वो उनकै कारण जिन्दा रहवैगा। मै यहोवा सूं।”<verse eid="LEV 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 18:6" />“थारे म्ह तै कोए अपणे कुण्बे की जनान्‍नी कै गैल शारीरिक सम्बन्ध ना बणावै। मै यहोवा सूं। <verse eid="LEV 18:6" /><verse number="7" style="v" sid="LEV 18:7" />थारी माँ का तन, जो तेरे पिता का तन सै, उसतै शारीरिक सम्बन्ध ना बणाणा; वा तो थारी माँ सै, इस करकै थम उसकै साथ शारीरिक सम्बन्ध ना बणाईयो। <verse eid="LEV 18:7" /><verse number="8" style="v" sid="LEV 18:8" />अपणी सौतेल्‍ली माँ कै गैल भी शारीरिक सम्बन्ध ना बणाईयो; वो तो थारे पिता का ए तन सै। <verse eid="LEV 18:8" /><verse number="9" style="v" sid="LEV 18:9" />अपणी भाण चाहे सगी हो चाहे सौतेल्‍ली हो, चाहे वो घर म्ह पैदा होई हो चाहे बाहर, उसकै गैल भी शारीरिक सम्बन्ध ना बणाईयो। <verse eid="LEV 18:9" /><verse number="10" style="v" sid="LEV 18:10" />अपणी पोत्ती या अपणी दोहती कै गैल भी शारीरिक सम्बन्ध ना बणाईयो, क्यूँके उनका अपमान तो थारा ए अपमान सै। <verse eid="LEV 18:10" /><verse number="11" style="v" sid="LEV 18:11" />थारी सौतेल्‍ली भाण जो थारे पिता तै पैदा होई, वो थारी भाण सै, इस करकै उसकै गैल भी शारीरिक सम्बन्ध ना बणाईयो। <verse eid="LEV 18:11" /><verse number="12" style="v" sid="LEV 18:12" />अपणी बुआ कै गैल भी शारीरिक सम्बन्ध ना बणाईयो; वो तो थारे पिता के कुण्बे की सै। <verse eid="LEV 18:12" /><verse number="13" style="v" sid="LEV 18:13" />अपणी मौस्सी कै गैल भी शारीरिक सम्बन्ध ना बणाईयो; क्यूँके वो थारी माँ कै कुण्बे की सै। <verse eid="LEV 18:13" /><verse number="14" style="v" sid="LEV 18:14" />अपणे चाचा का अपमान ना करियो, यानिके उसकी जनान्‍नी कै गैल भी शारीरिक सम्बन्ध ना बणाईये; वो तो थारी चाच्‍ची सै। <verse eid="LEV 18:14" /><verse number="15" style="v" sid="LEV 18:15" />अपणी बहू कै साथ शारीरिक सम्बन्ध ना बणाईयो क्यूँके वो तो तेरे बेट्टे की जनान्‍नी सै, इस करकै थम उसकै साथ शारीरिक सम्बन्ध ना बणाईयो। <verse eid="LEV 18:15" /><verse number="16" style="v" sid="LEV 18:16" />अपणी भाभ्भी कै गैल शारीरिक सम्बन्ध ना बणाईयो; वो तो तेरे भाई का ए तन सै। <verse eid="LEV 18:16" /><verse number="17" style="v" sid="LEV 18:17" />किसे औरत अर उसकी बेट्टी दोनुआं कै साथ शारीरिक सम्बन्ध ना बणाईयो, अर अपणी पोत्ती नै या अपणी दोहती नै अपणी औरत करकै उसकै साथ शारीरिक सम्बन्ध ना बणाईयो; वे तो धोरै के कुण्बे की सै; इसा करणा महापाप सै। <verse eid="LEV 18:17" /><verse number="18" style="v" sid="LEV 18:18" />अर अपणी जनान्‍नी की भाण नै भी अपणी औरत करकै उसकी सौत ना बणाईये कदे पैहली के जिन्दा रहन्दे होए उसकै साथ शारीरिक सम्बन्ध ना बणाईये।”<verse eid="LEV 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 18:19" />“फेर जिब तक कोए औरत अपणे मासिक धर्म कै कारण अशुद्ध रहवै जद तक उसकै गैल शारीरिक सम्बन्ध बणाण कै खात्तर उसकै धोरै ना जाईये। <verse eid="LEV 18:19" /><verse number="20" style="v" sid="LEV 18:20" />फेर अपणे भाई-बन्धु की औरत तै कुकर्म करकै अशुद्ध ना हो जाईयो। <verse eid="LEV 18:20" /><verse number="21" style="v" sid="LEV 18:21" />अपणे बाळकां म्ह तै किसे नै मोलेक<note caller="+" style="f"><char style="fr" closed="false">18:21 </char><char style="fq" closed="false">मोलेक </char><char style="ft" closed="false">शर्म का देवता</char></note> देवता कै खात्तर होम करकै ना चढ़ाईयो, अर ना अपणे परमेसवर कै नाम नै अपवित्र ठहराणा; मै यहोवा सूं। <verse eid="LEV 18:21" /><verse number="22" style="v" sid="LEV 18:22" />स्त्रीगमन की तरियां पुरुषगमन न्ही करणा; वो तो घिनोणा काम सै। <verse eid="LEV 18:22" /><verse number="23" style="v" sid="LEV 18:23" />किसे भी जात कै पशु कै गेल्या पशुगमन करकै अशुद्ध ना होइयो, अर ना कोए औरत पशु कै स्याम्ही इस करकै खड़ी हो के उसकै गेल्या कुकर्म करै; या तो उलटी बात सै।”<verse eid="LEV 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 18:24" />“इसा-इसा कोए भी काम करकै अशुद्ध ना हो जाणा, क्यूँके जिन जात्तां नै मै थारे आग्गै तै लिकाड़ण पै सूं वे इसे-इसे काम करकै अशुद्ध होगी सै; <verse eid="LEV 18:24" /><verse number="25" style="v" sid="LEV 18:25" />अर उनका देश भी अशुद्ध होग्या सै, इस करकै मै उसपै उसके अधर्म की सजा देऊँ सूं, अर वो देश अपणे बासिन्दया नै उगळ देवै सै। <verse eid="LEV 18:25" /><verse number="26" style="v" sid="LEV 18:26" />इस करकै थम मेरी विधि अर नियमां नै लगातार मानियो, अर चाहे देशी, चाहे थारे बिचाळै रहणआळे परदेशी हो, थारे म्ह तै कोए भी इसा घिनोणा काम ना करै; <verse eid="LEV 18:26" /><verse number="27" style="v" sid="LEV 18:27" />क्यूँके इसे सारे घिनोणे काम्मां नै उस देश के माणस जो थारै तै पैहल्या उस म्ह रहवैं थे, वे करदे आये सैं, इस्से तै वो देश अशुद्ध होग्या सै। <verse eid="LEV 18:27" /><verse number="28" style="v" sid="LEV 18:28" />इब इसा ना हो के जिस तरियां तै जो जात थारै तै पैहल्या उस देश म्ह रहवै थी, उस ताहीं उसनै उगळ दिया, उस्से तरियां जिब थम उसनै अशुद्ध करो, तो वो थारे ताहीं भी उगळ दे। <verse eid="LEV 18:28" /><verse number="29" style="v" sid="LEV 18:29" />जितने इसा कोए घिनोणा काम करै वे सारे माणस अपणे माणसां म्ह तै नाश करै जावै। <verse eid="LEV 18:29" /><verse number="30" style="v" sid="LEV 18:30" />ये हुकम जो मन्‍नै थारे ताहीं मान्‍नण नै दिये सै, उसनै थम मानियो, अर जो घिनोणे रीति-रिवाज थारे तै पैहल्या मान्‍नै जावै सै, उन म्ह तै किसे पै ना चालियो, अर ना उनकै कारण अशुद्ध होइयो। मै थारा परमेसवर यहोवा सूं।”<verse eid="LEV 18:30" /></para>
  <chapter eid="LEV 18" />
  <chapter number="19" style="c" sid="LEV 19" />
  <para style="s">पवित्रता का नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 19:1" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 19:1" /><verse number="2" style="v" sid="LEV 19:2" />“इस्राएलियाँ की सारी मण्डळी तै कह के थम पवित्र बणे रहो; क्यूँके मै थारा परमेसवर यहोवा पवित्र सूं। <verse eid="LEV 19:2" /><verse number="3" style="v" sid="LEV 19:3" />थम अपणे माँ-बाप का आदर करियो, अर मेरे विश्रामदिनां नै मानियो: मै थारा परमेसवर यहोवा सूं। <verse eid="LEV 19:3" /><verse number="4" style="v" sid="LEV 19:4" />थम मूर्तियाँ की ओड़ ना मुड़ियो, अर देवत्यां की मूर्ति ढाळ कै ना बणाईयो; मै थारा परमेसवर यहोवा सूं।”<verse eid="LEV 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 19:5" />“जिब थम यहोवा कै खात्तर मेलबलि करो, तो इसा बलिदान करियो जिसतै मै थारे तै खुश हो जाऊँ। <verse eid="LEV 19:5" /><verse number="6" style="v" sid="LEV 19:6" />उसका माँस बलिदान कै दिन अर दुसरे दिन खाया जावै, पर तीसरे दिन ताहीं जो रह जावै सै वो आग म्ह जळा दिया जावै। <verse eid="LEV 19:6" /><verse number="7" style="v" sid="LEV 19:7" />जै उस म्ह तै कुछ भी तीसरे दिन खाया जावै, तो यो घृणित ठहरैगा, अर कबूल न्ही करया जावैगा। <verse eid="LEV 19:7" /><verse number="8" style="v" sid="LEV 19:8" />अर उसका खाणआळा यहोवा कै पवित्र पदार्थ ताहीं अपवित्र ठैहरावै सै, ज्यांतै उसनै अपणे अधर्म का बोझ खुद ठाणा पड़ैगा; अर वो प्राणी अपणे माणसां म्ह तै नाश करया जावैगा।”<verse eid="LEV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 19:9" />“फेर जिब थम अपणे देश के खेत काट्टो, तब अपणे खेत कै कोणे-कोणे तक पूरा ना काटियो, अर काट्टे होए खेत्तां की गिरी पड़ी बाळां नै ना चुगीयो। <verse eid="LEV 19:9" /><verse number="10" style="v" sid="LEV 19:10" />अर अपणे अंगूर के बाग का दाणा-दाणा ना तोड़ियो, अर अपणे अंगूर के बाग के झड़े होए अंगूरां नै ना बटोरियो; उननै गरीब अर परदेशी माणसां कै खात्तर छोड़ दियो; मै थारा परमेसवर यहोवा सूं।”<verse eid="LEV 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 19:11" />“थम चोरी ना करियो, अर एक-दुसरे तै, ना कपट करियो, अर ना झूठ बोलियो। <verse eid="LEV 19:11" /><verse number="12" style="v" sid="LEV 19:12" />थम मेरै नाम की झूठ्ठी कसम खाकै अपणे परमेसवर का नाम अपवित्र ना ठहराइयो; मै यहोवा सूं।”<verse eid="LEV 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 19:13" />“एक-दुसरे पै अंधेर ना करियो, अर ना एक-दुसरे नै लूटियो। मजदूर की मजदूरी तेरै धोरै सारी रात सबेरै तक ना रहण पावै। <verse eid="LEV 19:13" /><verse number="14" style="v" sid="LEV 19:14" />बहरे नै श्राप ना दिये, अर ना आन्धे कै आग्गै ठोक्‍कर धरियो; अर अपणे परमेसवर का भय मानियो; मै यहोवा सूं।”<verse eid="LEV 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 19:15" />“न्याय म्ह कुटिलता ना करियो; अर ना कंगाल का पक्ष करियो अर ना बड़े माणसां का मुँह देख्या विचार करियो; एक-दुसरे का न्याय धार्मिकता तै करियो। <verse eid="LEV 19:15" /><verse number="16" style="v" sid="LEV 19:16" />बकवादी<note caller="+" style="f"><char style="fr" closed="false">19:16 </char><char style="fq" closed="false">बकवादी </char><char style="ft" closed="false">अपणे पड़ोसी का किसे भी ढाळ का कोए नुकसान न करिये</char></note> बणकै अपणे माणसां म्ह ना फिरणा, अर एक-दुसरे का लहू बहाण की योजना ना बणाईयो; मै यहोवा सूं।”<verse eid="LEV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 19:17" />“अपणे मन म्ह एक-दुसरे कै बारै म्ह बैर ना राखियो; अपणे पड़ोसी नै जरुर डाँटियो, न्ही तो उसके पाप का बोझ तन्‍नै ठाणा पड़ैगा। <verse eid="LEV 19:17" /><verse number="18" style="v" sid="LEV 19:18" />बदला ना लियो, अर ना अपणे जात्ति भाईयाँ तै बैर राखियो, पर एक-दुसरे तै अपणे जिसा प्यार करियो; मै यहोवा सूं।”<verse eid="LEV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 19:19" />“थम मेरी विधियाँ नै लगातार मानियो। अपणे पशुआं नै न्यारी-न्यारी जात के पशुआं तै मेल ना खाण दियो; अपणे खेत म्ह दो ढाळ के बीज कठ्ठे ना बोईयो; अर सणी अर ऊन की मिलावट तै बण्या होया कपड़ा ना पहरियो।”<verse eid="LEV 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 19:20" />“फेर कोए औरत दास्सी हो, अर उसकी सगाई किसे आदमी तै होई हो, पर वो ना तो दास तै अर ना मुफ्त म्ह स्वाधीन करी गई हो; उसतै जै कोए कुकर्म करै, तो उन दोनुआं नै सजा तो मिलै, पर उस औरत कै स्वाधीन ना होण कै कारण वे दोन्‍नु मारे न्ही जावैं। <verse eid="LEV 19:20" /><verse number="21" style="v" sid="LEV 19:21" />पर वो आदमी मिलापआळे तम्बू के दरबाजे पै यहोवा कै धोरै एक मिंढा दोषबलि कै खात्तर ले आवै। <verse eid="LEV 19:21" /><verse number="22" style="v" sid="LEV 19:22" />अर याजक उसके करे होए पाप कै कारण दोषबलि के मिंढे कै जरिये उसकै खात्तर यहोवा कै स्याम्ही प्रायश्चित करै; फेर उसका करया होया पाप माफ करया जावैगा।”<verse eid="LEV 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 19:23" />“फेर जिब थम कनान देश म्ह पोहचकै किसे ढाळ के फळ के पेड़ लगाओ, तो उनके फळ तीन साल तक थारै खात्तर मान्‍नो खतनारहित<note caller="+" style="f"><char style="fr" closed="false">19:23 </char><char style="fq" closed="false">खतनारहित </char><char style="ft" closed="false">अशुद्ध</char></note> ठहरे रहवै; इस करकै उन म्ह तै कुछ न्ही खाया जावै। <verse eid="LEV 19:23" /><verse number="24" style="v" sid="LEV 19:24" />अर चौथे साल म्ह उनके सारे फळ यहोवा की स्तुति करण कै खात्तर पवित्र ठहरै। <verse eid="LEV 19:24" /><verse number="25" style="v" sid="LEV 19:25" />फेर पाँचमै साल म्ह थम उनके फळ खाणा, ज्यांतै के उन म्ह तै थारे खात्तर घणा फळ मिलै; मै थारा परमेसवर यहोवा सूं।”<verse eid="LEV 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 19:26" />“थम लहू लाग्या होया कुछ भी माँस ना खाईयों। अर ना टूणा करियो, अर ना शुभ या अशुभ मुहूर्तां नै मानियो। <verse eid="LEV 19:26" /><verse number="27" style="v" sid="LEV 19:27" />अपणे सिर म्ह घेरा<note caller="+" style="f"><char style="fr" closed="false">19:27 </char><char style="fq" closed="false">अपणे सिर म्ह घेरा </char><char style="ft" closed="false">उस बखत कुछ दुसरे धर्म आळे किसे के मरण पै सिर मुँण्डवाते थे</char></note> धरकै ना मुँण्ड़ाईयो, अर ना अपणे गाल कै बाळां नै मुँण्ड़ाईयो। <verse eid="LEV 19:27" /><verse number="28" style="v" sid="LEV 19:28" />मुर्दयां कै कारण अपणी देह नै बिलकुल ना चिरीयो, अर ना उस म्ह छाप लगाईयो; मै यहोवा सूं।”<verse eid="LEV 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 19:29" />“अपणी बेटियाँ<note caller="+" style="f"><char style="fr" closed="false">19:29 </char><char style="fq" closed="false">अपणी बेटियाँ </char><char style="ft" closed="false">उस बखत कुछ दुसरे धर्म आळेयो काम करया करदे थे</char></note> नै वेश्या बणाकै अशुद्ध ना करियो, इसा ना हो के देश वेश्यागमन कै कारण महापाप तै भर जावै। <verse eid="LEV 19:29" /><verse number="30" style="v" sid="LEV 19:30" />मेरै विश्रामदिन नै मान्या करियो, अर मेरै पवित्रस्‍थान का भय लगातार मानियो; मै यहोवा सूं।”<verse eid="LEV 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 19:31" />“झाड़-फूंक करणीये अर भूत साधना करण आळे की और ना मुड़ियो, अर इस्यां की टोह् करकै उनकै कारण अशुद्ध ना हो जाईयो; मै थारा परमेसवर यहोवा सूं।”<verse eid="LEV 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 19:32" />“पके बाळ आळे कै स्याम्ही उठ खड़े होइयो, अर बुजुर्गां का आदर-मान करियो, अर अपणे परमेसवर का भय लगातार मानियो; मै यहोवा सूं।”<verse eid="LEV 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 19:33" />“जै कोए परदेशी थारा देश म्ह थारै गैल रहवै, तो उसनै दुख ना दियो। <verse eid="LEV 19:33" /><verse number="34" style="v" sid="LEV 19:34" />जो परदेशी थारे गैल रहवै सै वो थारै खात्तर देशी के बराबर हो, अर उसतै अपणे ए जिसा प्यार करियो; क्यूँके थम भी मिस्र देश म्ह परदेशी थे; मै थारा परमेसवर यहोवा सूं।”<verse eid="LEV 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 19:35" />“थम न्याय म्ह, अर परिमाण म्ह, अर तौल म्ह, अर नाप म्ह, हेरा-फेरी ना करियो। <verse eid="LEV 19:35" /><verse number="36" style="v" sid="LEV 19:36" />सच्‍चा तराजू, धर्म के बट्टे, सच्‍चा एपा, अर धार्मिकता का हीन थारे धोरै रहवै; मै थारा परमेसवर यहोवा सूं, जो थारै ताहीं मिस्र देश तै लिकाड़ ले आया। <verse eid="LEV 19:36" /><verse number="37" style="v" sid="LEV 19:37" />इस करकै थम मेरी सारी विधि अर सारे नियमां नै मान्दे होए लगातार पालन करो; मै यहोवा सूं।”<verse eid="LEV 19:37" /></para>
  <chapter eid="LEV 19" />
  <chapter number="20" style="c" sid="LEV 20" />
  <para style="s">मौत की सजा के लायक न्यारे-न्यारे ढाळ के पापां का बखान</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 20:1" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 20:1" /><verse number="2" style="v" sid="LEV 20:2" />“इस्राएलियाँ तै कह के इस्राएलियाँ म्ह तै, या इस्राएलियाँ कै बिचाळै रहण आळे परदेशियाँ म्ह तै, कोए भी क्यूँ ना हो, जो अपणी कोए सन्तान मोलेक देवता तै बलिदान करै वो जरुर मार दिया जावै; अर जनता उस ताहीं पथराव करै। <verse eid="LEV 20:2" /><verse number="3" style="v" sid="LEV 20:3" />मै भी उस माणस कै बिरुध्द हो कै, उसनै उसके माणसां म्ह तै इस कारण नाश करुँगा, के उसनै अपणी सन्तान मोलेक ताहीं देकै मेरे पवित्र स्‍थान ताहीं अशुद्ध करया, अर मेरे पवित्र नाम ताहीं भी अपवित्र ठहराया। <verse eid="LEV 20:3" /><verse number="4" style="v" sid="LEV 20:4" />अर जै कोए अपणी सन्तान मोलेक देवता तै बलिदान करै, अर जनता उसकै बारै म्ह आना-कानी करै, अर उसनै ना मारै, <verse eid="LEV 20:4" /><verse number="5" style="v" sid="LEV 20:5" />फेर मै खुद उस माणस अर उसकै कुण्बे कै बिरुध्द होकै उसनै अर जितने मोलेक कै पाच्छै होकै उसकै गेल्या कुकर्म करैं उन सारया नै भी उनकै माणसां के बीच म्ह तै नाश करुँगा।”<verse eid="LEV 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 20:6" />“फेर जो माणस झाड़-फूंक करणीये या भूत साधना करण आळयां की ओड़ मुड़कै, अर उनकै पाच्छै होकै व्यभिचारी बणै, फेर मै उस माणस कै बिरुध्द होकै उसनै उसके माणसां कै बीच म्ह तै नाश कर दियुँगा। <verse eid="LEV 20:6" /><verse number="7" style="v" sid="LEV 20:7" />इस करकै थम अपणे-आपनै पवित्र करो; अर पवित्र बणे रहो; क्यूँके मै थारा परमेसवर यहोवा सूं। <verse eid="LEV 20:7" /><verse number="8" style="v" sid="LEV 20:8" />अर थम मेरी विधियाँ नै मानियो, अर उनका पालन भी करियो; क्यूँके मै थारा पवित्र करण आळा यहोवा सूं।”<verse eid="LEV 20:8" /></para>
  <para style="s">परिवार अर यौन अपराध</para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 20:9" />“कोए क्यूँ ना हो, जो अपणे माँ-बाप नै श्राप देवै वो जरुर मार दिया जावै; उसनै अपणे माँ-बाप तै श्राप दिया सै, इस करकै उसका खून उस्से कै सिर पै पड़ैगा। <verse eid="LEV 20:9" /><verse number="10" style="v" sid="LEV 20:10" />फेर जै कोए पराई औरत कै गेल्या व्यभिचार करै, तो जिसनै किसे दुसरे की औरत कै गेल्या व्यभिचार करया हो तो वो व्यभिचारी अर वो व्यभिचारिणी दोन्‍नु जरुर मार दिये जावैं। <verse eid="LEV 20:10" /><verse number="11" style="v" sid="LEV 20:11" />जै कोए अपणी सौतेल्‍ली माँ कै गेल्या सोवै, वो अपणे पिता का ए तन उघाड़ण आळा ठहरैगा; ज्यांतै वे दोन्‍नु जरुर मार दिये जावै, उनका खून उन्हे कै सिर पै पड़ैगा। <verse eid="LEV 20:11" /><verse number="12" style="v" sid="LEV 20:12" />जै कोए अपणे बेट्टे की बहू कै गेल्या सोवै, तो वे दोन्‍नु जरुर मार दिये जावैं; क्यूँके वे उलटा काम करण आळे ठहरैगें, अर उनका खून उन्हे कै सिर पै पड़ैगा। <verse eid="LEV 20:12" /><verse number="13" style="v" sid="LEV 20:13" />जै कोए जिस तरियां औरत तै उस्से तरियां आदमी तै प्रसंग करै, तो वे दोन्‍नु घिनोणा काम करण आळे ठहरैगें; इस कारण वे जरुर मार दिये जावैं, उनका खून उन्हे कै सिर पै पड़ैगा। <verse eid="LEV 20:13" /><verse number="14" style="v" sid="LEV 20:14" />जै कोए अपणी घरआळी अर अपणी सास्सू दोनुआं नै राक्खै, तो यो महापाप सै; ज्यांतै वो आदमी अर वे बिरबान्‍नी तीन्‍नु कै तीन्‍नु आग म्ह जळाए जावैं, जिसतै थारै बिचाळै महापाप ना हो। <verse eid="LEV 20:14" /><verse number="15" style="v" sid="LEV 20:15" />फेर जै कोए आदमी पशुगामी हो, तो आदमी अर पशु दोन्‍नु जरुर मार दिये जावै। <verse eid="LEV 20:15" /><verse number="16" style="v" sid="LEV 20:16" />जै कोए औरत पशु कै धोरै जाकै उसकै गैल कुकर्म करै, तो तू उस औरत अर पशु दोनुआं नै घात करिये; वे जरुर मार दिये जावै, उनका खून उन्हे कै सिर पै पड़ैगा।”<verse eid="LEV 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 20:17" />“जै कोए अपणी भाण का, चाहे उसकी सगी भाण हो चाहे सौतेल्‍ली, उसका नंगा तन देक्खै, अर उसकी भाण भी उसका नंगा तन देक्खै तो यो शर्म की बात सै, वे दोन्‍नु अपणे जात्ति भाईयाँ की आँखां कै स्याम्ही नाश करे जावै; क्यूँके जो अपणी भाण कै गैल शारीरिक सम्बन्ध बणाण आळा ठहरैगा उसनै अपणे अधर्म का बोझ खुद ठाणा पड़ैगा। <verse eid="LEV 20:17" /><verse number="18" style="v" sid="LEV 20:18" />फेर जै कोए आदमी किसे औरत के गैल मासिक धर्म म्ह सो कै उसकै गैल शारीरिक सम्बन्ध बणावै, तो वो आदमी उसकै रूधिर के सोत्ते का उघाड़ण आळा ठहरैगा, अर वो औरत रूधिर के सोत्ते की उघाड़ण आळी ठहरैगी; इस कारण वे दोन्‍नु अपणे माणसां कै बिचाळै तै नाश करे जावै। <verse eid="LEV 20:18" /><verse number="19" style="v" sid="LEV 20:19" />अपणी मौस्सी या बुआ कै गैल शारीरिक सम्बन्ध ना बणाईयो, क्यूँके जो उसकै गैल सोवै वो अपणी कुण्बे आळी नै उघाड़ी करै सै; ज्यांतै इन दोनुआं नै अपणे अधर्म का बोझ ठाणा पड़ैगा। <verse eid="LEV 20:19" /><verse number="20" style="v" sid="LEV 20:20" />जै कोए अपणी चाच्‍ची के गैल सोवै, तो वो अपणे चाचा का तन उघाड़ण आळा ठहरैगा; ज्यांतै वे दोन्‍नु अपणे पाप के बोझ नै ठाए होए बे-ओलादे मर ज्यागें। <verse eid="LEV 20:20" /><verse number="21" style="v" sid="LEV 20:21" />जै कोए अपणी भाभ्भी नै अपणी घरआळी बणावै, तो इसनै घिनोणा काम जाणणा; अर वो अपणे भाई का तन उघाड़ण आळा ठहरैगा, इस करकै वे दोन्‍नु बे-ओलादे रहवैगें।”<verse eid="LEV 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 20:22" />“थम मेरी सारी विधि अर मेरे सारे नियमां नै समझकै गैल मानणा; जिसतै न्यू ना हो के जिस देश म्ह मै थमनै लिए जाण लागरया सूं वो थारे ताहीं उगळ दे। <verse eid="LEV 20:22" /><verse number="23" style="v" sid="LEV 20:23" />अर जिस जात के माणसां नै मै थारे आग्गै तै लिकाडु सूं उनकी रीति-रिवाज पै न्ही चालणा; क्यूँके उन माणसां नै जो ये सारे कुकर्म करै सैं, इस्से करकै मन्‍नै उनतै घृणा होगी सै। <verse eid="LEV 20:23" /><verse number="24" style="v" sid="LEV 20:24" />पर मै थारे तै कहूँ सूं के थम तो उनकी धरती के हकदार होवैगें, अर मै इस देश नै जिस म्ह दूध अर शहद की धारां बहवै सै थारै अधिकार म्ह कर दियुँगा; मै थारा परमेसवर यहोवा सूं, जिसनै थारै ताहीं और देशां के माणसां तै न्यारा करया सै। <verse eid="LEV 20:24" /><verse number="25" style="v" sid="LEV 20:25" />इस करकै थम शुद्ध अर अशुद्ध पशुआं म्ह, अर शुद्ध अर अशुद्ध पंछियाँ म्ह भेद करियो; अर कोए पशु या पंछी या किसे ढाळ का धरती पै रेंगण आळा जीव-जन्तु क्यूँ ना हो, जिस ताहीं मन्‍नै थारे खात्तर अशुद्ध ठहराकै मना करया सै, उसतै अपणे-आपनै अशुद्ध ना करियो। <verse eid="LEV 20:25" /><verse number="26" style="v" sid="LEV 20:26" />थम मेरै खात्तर पवित्र बणे रहियो; क्यूँके मै यहोवा खुद पवित्र सूं, अर मन्‍नै थारे ताहीं अर और देशां के माणसां तै इस करकै न्यारा करया सै के थम लगातार मेरे ए बणे रहो।”<verse eid="LEV 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 20:27" />“जै कोए आदमी या औरत झाड़-फूंक या भूत साधना करै, तो वो जरुर मार दिये जावै; इस्यां पै पत्थर बरसाए जावै, उनका खून उन्हे कै सिर पै पड़ैगा।”<verse eid="LEV 20:27" /></para>
  <chapter eid="LEV 20" />
  <chapter number="21" style="c" sid="LEV 21" />
  <para style="s">याजकां कै खात्तर खास विधि</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 21:1" />फेर यहोवा नै मूसा तै कह्या, “हारुन के बेट्टे जो याजक सै उनतै कह के थारे माणसां म्ह तै कोए भी मरै, तो उसकै कारण थारै म्ह तै कोए अपणे ताहीं अशुद्ध ना करै; <verse eid="LEV 21:1" /><verse number="2" style="v" sid="LEV 21:2" />अपणे नजदीकी कुण्बे आळे, यानिके अपणे माँ-बाप, या बेट्टा-बेट्टी, या भाई खात्तर, <verse eid="LEV 21:2" /><verse number="3" style="v" sid="LEV 21:3" />या अपणी कुँवारी भाण जिसका ब्याह न्ही होया हो, जिनका नजदीकी सम्बन्ध सै; उनकै खात्तर वो अपणे ताहीं अशुद्ध कर सकै सै। <verse eid="LEV 21:3" /><verse number="4" style="v" sid="LEV 21:4" />पर याजक होण के नात्ते तै वो अपणे माणसां म्ह प्रधान सै, ज्यांतै वो अपणे ताहीं इसा अशुद्ध ना करै के अपवित्र हो जावै। <verse eid="LEV 21:4" /><verse number="5" style="v" sid="LEV 21:5" />वे ना तो अपणे सिर मुंडावै, अर ना अपणे गाल कै बाळां नै मुंडावै, अर ना अपणी देह चिरै। <verse eid="LEV 21:5" /><verse number="6" style="v" sid="LEV 21:6" />वे अपणे परमेसवर कै खात्तर पवित्र बणे रहवैं, अर अपणे परमेसवर का नाम अपवित्र ना करै; क्यूँके वे यहोवा कै हव्य नै जो उनके परमेसवर का खाणा सै चढ़ाया करैं सै; इस करकै वे पवित्र बणे रहवै। <verse eid="LEV 21:6" /><verse number="7" style="v" sid="LEV 21:7" />वे वेश्या या भ्रष्ट होई नै ब्याह कै ना ल्यावै; अर ना छोड्डी होई तै ब्याह करै; क्यूँके याजक अपणे परमेसवर कै खात्तर पवित्र होवै सै। <verse eid="LEV 21:7" /><verse number="8" style="v" sid="LEV 21:8" />इस करकै तू याजक नै पवित्र जाणिये, क्यूँके वो थारे परमेसवर नै खाणा चढ़ाया करै सै; ज्यांतै वो तेरी निगांह म्ह पवित्र ठहरै; क्यूँके मै यहोवा, जो थमनै पवित्र करुँ सूं, पवित्र सूं। <verse eid="LEV 21:8" /><verse number="9" style="v" sid="LEV 21:9" />अर जै याजक की बेट्टी वेश्या बणकै अपणे-आपनै अपवित्र करै, तो वा अपणे पिता नै शर्मिन्दा करै सै; वा आग म्ह जळाई जावै।”<verse eid="LEV 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 21:10" />“जो अपणे भाईयाँ म्ह महायाजक हो, जिसकै सिर पै अभिषेक का तेल उण्‍डेल्या गया हो, अर जिसतै याजक पद खात्तर प्रतिष्‍ठित करया गया सै ताके वो याजक की पवित्र पोशाक पैहर सकै, वो अपणे सिर के बाळ बिखरण न्ही देवै, अर ना अपणे कपड़े पाड़ै; <verse eid="LEV 21:10" /><verse number="11" style="v" sid="LEV 21:11" />अर ना वो किसे लाश कै धोरै जावै, अर ना अपणे माँ-बाप कै कारण अपणे-आपनै अशुद्ध करै; <verse eid="LEV 21:11" /><verse number="12" style="v" sid="LEV 21:12" />अर वो पवित्र स्‍थान तै बाहर भी ना लिकड़ै, अर ना अपणे परमेसवर कै पवित्र स्‍थान नै अपवित्र ठहरावै; क्यूँके वो अपणे परमेसवर कै अभिषेक का तेल रूपी ताज धारण करे होए सै; मै यहोवा सूं। <verse eid="LEV 21:12" /><verse number="13" style="v" sid="LEV 21:13" />अर वो कुँवारी नै ब्याहवै। <verse eid="LEV 21:13" /><verse number="14" style="v" sid="LEV 21:14" />जो बिधवा, या छोड्डी होई, या भ्रष्ट, या वेश्या हो, इसी किसे तै वो ब्याह न्ही करै, वो अपणे माणसां कै बिचाळै की किसे कुँवारी छोरी तै ब्याह करै। <verse eid="LEV 21:14" /><verse number="15" style="v" sid="LEV 21:15" />अर वो अपणे बाळकां नै अपणे माणसां म्ह अशुद्ध ना करै; क्यूँके मै उसका पवित्र करण आळा यहोवा सूं।”<verse eid="LEV 21:15" /></para>
  <para style="s">शारीरिक दोष अर याजक</para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 21:16" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 21:16" /><verse number="17" style="v" sid="LEV 21:17" />“हारुन तै कह के तेरे वंश की पीढ़ी-पीढ़ी म्ह जिस किसे कै कोए भी शारीरिक दोष हो वो अपणे परमेसवर का खाणा चढ़ाण कै खात्तर धोरै न्ही जावै। <verse eid="LEV 21:17" /><verse number="18" style="v" sid="LEV 21:18" />कोए भी क्यूँ ना हो, जिस म्ह दोष हो, वो धोरै न्ही आवै, चाहे वो आन्धा हो, चाहे लंगड़ा, चाहे नकचपटा हो, चाहे उसकै किमे भी घणे अंग हों, <verse eid="LEV 21:18" /><verse number="19" style="v" sid="LEV 21:19" />या उसका पैर, या हाथ टूट्या हो, <verse eid="LEV 21:19" /><verse number="20" style="v" sid="LEV 21:20" />या वो कुबड़ा, या बोना हो, या उसकी आँख म्ह खोट हो, या उस माणस कै चाईं या खुजली हो, या उसकै अण्ड पिचके हों; <verse eid="LEV 21:20" /><verse number="21" style="v" sid="LEV 21:21" />हारुन याजक कै पीढ़ी म्ह तै जिस किसे म्ह कोए भी शारीरिक दोष हो, वो यहोवा नै हवन चढ़ाण कै खात्तर धोरै ना आवै; वो जो जिस म्ह दोष सै कदे भी अपणे परमेसवर का खाणा चढ़ाण कै खात्तर धोरै ना आवै। <verse eid="LEV 21:21" /><verse number="22" style="v" sid="LEV 21:22" />वो अपणे परमेसवर के पवित्र अर परमपवित्र दोन्‍नु ढाळ के खाणे नै खावै, <verse eid="LEV 21:22" /><verse number="23" style="v" sid="LEV 21:23" />पर उसकै दोष कै कारण वो ना तो बीचआळे पड़दे कै भित्तर आवै अर ना वेदी कै धोरै, जिसतै इसा ना हो के वो मेरै पवित्रस्‍थानां नै अपवित्र करै; क्यूँके मै उनका पवित्र करण आळा यहोवा सूं।” <verse eid="LEV 21:23" /><verse number="24" style="v" sid="LEV 21:24" />इस करकै मूसा नै हारुन अर उसकै बेट्याँ तै अर सारे इस्राएलियाँ तै या बात कह सुणाई।<verse eid="LEV 21:24" /></para>
  <chapter eid="LEV 21" />
  <chapter number="22" style="c" sid="LEV 22" />
  <para style="s">याजकीय अशुद्धता</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 22:1" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 22:1" /><verse number="2" style="v" sid="LEV 22:2" />“हारुन अर उसकै बेट्याँ तै कह के इस्राएलियाँ की पवित्र करी होई चिज्जां नै जिननै वे मेरै खात्तर पवित्र करै सैं न्यारे रहवै, अर मेरे पवित्र नाम नै अपवित्र ना करैं; मै यहोवा सूं। <verse eid="LEV 22:2" /><verse number="3" style="v" sid="LEV 22:3" />अर उनतै कह के थारी पीढ़ी-पीढ़ी म्ह थारे सारे वंश म्ह तै जो कोए अपणी अशुद्धता की हालत म्ह उन पवित्र करी होई चिज्जां कै धोरै जावै, जिन नै इस्राएली यहोवा कै खात्तर पवित्र करैं सैं, वो माणस मेरै स्याम्ही तै नाश करया जावैगा; मै यहोवा सूं। <verse eid="LEV 22:3" /><verse number="4" style="v" sid="LEV 22:4" />हारुन की पीढ़ी म्ह तै कोए भी क्यूँ ना हो, जो कोढ़ी हो, या उसकै प्रमेह हो, वो माणस जिब तक शुद्ध ना हो जावै, जिब ताहीं पवित्र करी होई चिज्जां म्ह तै कुछ न्ही खावै। अर जो लोथ कै कारण अशुद्ध होया हो, या जिसका वीर्य स्खलित होया हो, इसे माणस नै जो कोए छुवै, <verse eid="LEV 22:4" /><verse number="5" style="v" sid="LEV 22:5" />अर जो कोए किसे इसे रेंगणआळे जन्तु नै छुवै जिसतै माणस अशुद्ध हो सकै सै, या किसे इसे माणस नै छुवै जिस म्ह किसे ढाळ की अशुद्धता हो जो उसनै भी लाग सकै सै। <verse eid="LEV 22:5" /><verse number="6" style="v" sid="LEV 22:6" />तो वो याजक जो इन म्ह तै किसे नै छुवै साँझ तक अशुद्ध ठहरया रहवै, अर जिब ताहीं पाणी तै स्नान ना कर ले, जद तक पवित्र चिज्जां म्ह तै कुछ न्ही खावै। <verse eid="LEV 22:6" /><verse number="7" style="v" sid="LEV 22:7" />फेर सूरज छिप्या पाच्छै वा शुद्ध ठहरैगा; अर फेर वो पवित्र चिज्जां म्ह तै खा सकैगा, क्यूँके उसका खाणा वोए सै। <verse eid="LEV 22:7" /><verse number="8" style="v" sid="LEV 22:8" />जो पशु खुद तै मरया हो या जंगळी-जानवर तै पाड़या गया हो उसनै खाकै वो अपणे-आपनै अशुद्ध ना करै; मै यहोवा सूं। <verse eid="LEV 22:8" /><verse number="9" style="v" sid="LEV 22:9" />ज्यांतै याजक मेरी सौंपी होई चिज्जां की रुखाळ करैं, इसा ना हो के वे उननै अपवित्र करकै पाप का बोझ ठावै, अर इसकै कारण मर भी जावै; मै उनका पवित्र करण आळा यहोवा सूं।”<verse eid="LEV 22:9" /></para>
  <para style="s">पवित्र भोजन कै बारै म्ह निर्देश</para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 22:10" />“दुसरे कुल का माणस, किसे पवित्र वस्तु नै न्ही खाण पावै, चाहे वो याजक का मेहमान हो या मजदूर हो, फेर भी वो कोए पवित्र चीज ना खावै। <verse eid="LEV 22:10" /><verse number="11" style="v" sid="LEV 22:11" />जै याजक किसे नौक्‍कर नै रुपया देकै मोल ले, तो वो नौक्‍कर उस म्ह तै खा सकै सै; अर जो याजक कै घर म्ह पैदा होया हों चाहे कुटुम्बी या दास, वे भी उसकै खाणा म्ह तै खावैं। <verse eid="LEV 22:11" /><verse number="12" style="v" sid="LEV 22:12" />अर जै याजक की बेट्टी दुसरे कुल के किसे आदमी तै ब्याही हो, तो वो भेंट करी होई पवित्र चिज्जां म्ह तै ना खावै। <verse eid="LEV 22:12" /><verse number="13" style="v" sid="LEV 22:13" />जै याजक की बेट्टी बिधवा या छोड्डी होई हो, अर उसकै बाळक ना हो, अर वा अपणी बाळकपण तै रीत कै मुताबिक अपणे पिता कै घर म्ह रहन्दी हो, तो वा अपणे पिता कै खाणा म्ह तै खावै; पर दुसरे कुल का कोए उस म्ह तै न्ही खाण पावै। <verse eid="LEV 22:13" /><verse number="14" style="v" sid="LEV 22:14" />अर जै कोए माणस किसे पवित्र चीज म्ह तै कुछ भूल तै खा ले, तो वो उसका पाँचवाँ हिस्सा बढ़ाकै उसनै याजक तै भर दे। <verse eid="LEV 22:14" /><verse number="15" style="v" sid="LEV 22:15" />वे इस्राएलियाँ की पवित्र करी होई चिज्जां नै, जिन नै वे यहोवा कै खात्तर चढ़ावैं, अशुद्ध ना करैं। <verse eid="LEV 22:15" /><verse number="16" style="v" sid="LEV 22:16" />वे उननै अपणी पवित्र चिज्जां म्ह तै खुवाकै उनतै अपराध का दोष ना उठवावैं; मै उनका पवित्र करण आळा यहोवा सूं।”<verse eid="LEV 22:16" /></para>
  <para style="s">ग्रहणयोग्य पशुबलि</para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 22:17" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 22:17" /><verse number="18" style="v" sid="LEV 22:18" />“हारुन अर उसकै बेट्याँ तै अर इस्राएल के माणसां तै समझाकै कह के इस्राएल कै कुण्बे या इस्राएलियाँ म्ह रहण आळे परदेशियाँ म्ह तै कोए भी क्यूँ ना हो, जो मन्‍नत या स्वेच्छाबलि करण कै खात्तर यहोवा नै किमे होमबलि चढ़ावै, <verse eid="LEV 22:18" /><verse number="19" style="v" sid="LEV 22:19" />तो अपणे खात्तर ग्रहणयोग्य ठहरण कै खात्तर बळधां या भेड्डां या बकरियाँ म्ह तै बेकसूर नर चढ़ाया जावै। <verse eid="LEV 22:19" /><verse number="20" style="v" sid="LEV 22:20" />जिस म्ह कोए भी खोट हो उसनै ना चढ़ाईयो; क्यूँके वो थारे खात्तर ग्रहणयोग्य न्ही ठहरैगा। <verse eid="LEV 22:20" /><verse number="21" style="v" sid="LEV 22:21" />अर जो कोए बळधां या भेड़-बकरियाँ म्ह तै खास चीज मन्‍नत मानण कै या स्वेच्छाबलि खात्तर यहोवा नै मेलबलि चढ़ावै, तो ग्रहण होण कै खात्तर जरूरी सै के वो बेकसूर हो, उस म्ह कोए भी खोट ना हो। <verse eid="LEV 22:21" /><verse number="22" style="v" sid="LEV 22:22" />जो आन्धा या अंग का टूट्या या लूल्‍ला हो, या उसकै रसौळी या खौरा या खुजली हो, इस्यां नै यहोवा कै खात्तर ना चढ़ाईयों, उननै वेदी पै यहोवा कै खात्तर हवन न्ही चढ़ाणा। <verse eid="LEV 22:22" /><verse number="23" style="v" sid="LEV 22:23" />जिस किसे बळध या भेड़ या बकरे का कोए अंग घणा या कम हो उसनै स्वेच्छाबलि कै खात्तर चढ़ा सको सो, पर मन्‍नत पूरी करण कै खात्तर वो कबूल न्ही होवैगा। <verse eid="LEV 22:23" /><verse number="24" style="v" sid="LEV 22:24" />जिसके अण्ड दबे या कुचले या टूट्टे या कटगे हों उसनै यहोवा कै खात्तर ना चढ़ाईयों, अर अपणे देश म्ह भी इसा काम ना करियो। <verse eid="LEV 22:24" /><verse number="25" style="v" sid="LEV 22:25" />फेर इन म्ह तै किसे नै थम अपणे परमेसवर का खाणा जाणकै किसे परदेशी पै तै लेकै ना चढ़ाईयो; क्यूँके उन म्ह खोट अर कलंक सै, ज्यांतै वे थारे खात्तर कबूल न्ही होवैंगे।”<verse eid="LEV 22:25" /></para>
  <para style="s">बलिदान खात्तर ज्यादा नियम</para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 22:26" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 22:26" /><verse number="27" style="v" sid="LEV 22:27" />“जिब बाछड़ा या भेड़ या बकरी का बच्‍चा पैदा हो, तो वो सात दिन तक अपणी माँ कै गेल्या रहवै; फेर आठवें दिन कै बाद वो यहोवा के हवन चढ़ावै कै खात्तर कबूल करया जावैगा। <verse eid="LEV 22:27" /><verse number="28" style="v" sid="LEV 22:28" />चाहे गां, चाहे भेड़ या बकरी हो, उसनै अर उसके बच्‍चे नै एक ए दिन म्ह बलि ना करियो। <verse eid="LEV 22:28" /><verse number="29" style="v" sid="LEV 22:29" />अर जिब थम यहोवा कै खात्तर धन्यवाद का मेलबलि चढ़ाओ, तो उसनै इस्से तरियां तै करियो, जिसतै वो कबूल करया जावैगा। <verse eid="LEV 22:29" /><verse number="30" style="v" sid="LEV 22:30" />वो उस्से दिन खाया जावै, उस म्ह तै कुछ भी सबेरै तक न्ही रहण पावै; मै यहोवा सूं।”<verse eid="LEV 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 22:31" />“इस करकै थम मेरे हुकमां नै मानियो अर उनका पालन करियो; मै यहोवा सूं। <verse eid="LEV 22:31" /><verse number="32" style="v" sid="LEV 22:32" />अर मेरै पवित्र नाम नै अपवित्र ना ठहराइयो, क्यूँके मै इस्राएलियाँ कै बिचाळै जरुर पवित्र मान्या जाऊँगा; मै थारा पवित्र करण आळा यहोवा सूं, <verse eid="LEV 22:32" /><verse number="33" style="v" sid="LEV 22:33" />जो थमनै मिस्र देश तै लिकाड़ ल्याया सै जिसतै थारा परमेसवर बण्या रहूँ; मै यहोवा सूं।”<verse eid="LEV 22:33" /></para>
  <chapter eid="LEV 22" />
  <chapter number="23" style="c" sid="LEV 23" />
  <para style="s">खास त्यौहार का दिन</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 23:1" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 23:1" /><verse number="2" style="v" sid="LEV 23:2" />“इस्राएलियाँ तै कह के यहोवा के त्यौहार जिनका थमनै पवित्र सभा कठ्ठी करण कै खात्तर सही बखत पै प्रचार करणा होवैगा, मेरे वे त्यौहार ये सैं।”<verse eid="LEV 23:2" /></para>
  <para style="s">सब्त</para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 23:3" />“छः दिन काम-काज करया जावै, पर सातवाँ दिन परमविश्राम का अर पवित्र सभा का दिन सै; उस म्ह किसे ढाळ का काम-काज न्ही करया जावै; वो थारे सारे घरां म्ह यहोवा का विश्रामदिन ठहरै।”<verse eid="LEV 23:3" /></para>
  <para style="s">फसह अर अखमीरी रोट्टी</para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 23:4" />“फेर यहोवा के त्यौहार जिन म्ह तै एक-एक के ठहराये होए बखत म्ह थमनै पवित्र सभा करण कै खात्तर प्रचार करणा होवैगा वे ये सैं। <verse eid="LEV 23:4" /><verse number="5" style="v" sid="LEV 23:5" />पैहले महिन्‍ने कै<note caller="+" style="f"><char style="fr" closed="false">23:5 </char><char style="fq" closed="false">पैहले महिन्‍ने कै </char><char style="ft" closed="false">इब्रानी म्हीन्या कै हिसाब तै यो दिन साल कै बीच म्ह सी आवै</char></note> चौदहवें दिन म्ह साँझ कै बखत यहोवा का फसह का त्यौहार होया करै। <verse eid="LEV 23:5" /><verse number="6" style="v" sid="LEV 23:6" />अर उस्से महिन्‍ने कै पन्द्रहवें दिन नै यहोवा कै खात्तर अखमीरी रोट्टी का त्यौहार होया करै; उस म्ह थम सात दिन तक अखमीरी रोट्टी खाया करियो। <verse eid="LEV 23:6" /><verse number="7" style="v" sid="LEV 23:7" />उन म्ह तै पैहले दिन<note caller="+" style="f"><char style="fr" closed="false">23:7 </char><char style="fq" closed="false">पैहले दिन </char><char style="ft" closed="false">त्यौहार का पैहला दिन</char></note> थारी पवित्र सभा हो; अर उस दिन मेहनत का कोए काम ना करियो। <verse eid="LEV 23:7" /><verse number="8" style="v" sid="LEV 23:8" />अर सातों दिन थम यहोवा नै हव्य चढ़ाया करियो; अर सातमै दिन पवित्र सभा हो; उस दिन मेहनत का कोए काम ना करियो।”<verse eid="LEV 23:8" /></para>
  <para style="s">पैहली फसल का त्यौहार</para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 23:9" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 23:9" /><verse number="10" style="v" sid="LEV 23:10" />“इस्राएलियाँ तै कह के जिब थम उस देश म्ह दाखल होवो जिस ताहीं यहोवा थारे तै देवै सै अर उस म्ह के खेत काट्टो, फेर अपणे-अपणे पके खेत की पैहली उपज का पूळा याजक कै धोरै ल्याया करियो; <verse eid="LEV 23:10" /><verse number="11" style="v" sid="LEV 23:11" />अर वो उस पूळे नै यहोवा कै स्याम्ही हिलावै के वो थारै खात्तर ग्रहण करया जावै; वो उसनै विश्रामदिन के आगले दिन हिलावै। <verse eid="LEV 23:11" /><verse number="12" style="v" sid="LEV 23:12" />अर जिस दिन थम पूळे नै हिलवाओ उस्से दिन एक साल का बेकसूर भेड़ का बच्‍चा यहोवा कै खात्तर होमबलि चढ़ाईयों। <verse eid="LEV 23:12" /><verse number="13" style="v" sid="LEV 23:13" />अर उसकै गेल्या का अन्‍नबलि एपा कै दो दसमां हिस्सा<note caller="+" style="f"><char style="fr" closed="false">23:13 </char><char style="fq" closed="false">दो दसमां हिस्सा </char><char style="ft" closed="false">2 किलोग्राम मैद्दा अर 1 लीटर दाखमधु</char></note> तेल तै सणे होए मैद्दे का हो वो सुखदायक सुगन्ध कै खात्तर यहोवा का हवन हो; अर उसकै गेल्या का अर्घ हीन<note caller="+" style="f"><char style="fr" closed="false">23:13 </char><char style="fq" closed="false">अर्घ हीन </char><char style="ft" closed="false">लगभग 1 किलोग्राम जैतून का तेल</char></note> भर की चौथाई दाखमधु हो। <verse eid="LEV 23:13" /><verse number="14" style="v" sid="LEV 23:14" />अर जिब तक थम इस चढ़ावै नै अपणे परमेसवर कै धोरै ले जाओ, उस दिन तक नये खेत म्ह तै ना तो रोट्टी खाईयों अर ना भून्या होया अन्‍न अर ना हरी बाल; यो थारी पीढ़ी-पीढ़ी म्ह थारे सारे कुण्बे म्ह सदा की विधि ठहरै।”<verse eid="LEV 23:14" /></para>
  <para style="s">सप्ताहां का त्यौहार</para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 23:15" />“फेर उस विश्रामदिन कै दुसरे दिन तै, यानिके जिस दिन थम हलाई जाण आळी भेंट कै पूळे नै ल्याओगे, उस दिन तै पूरे सात विश्रामदिन गिण लियो; <verse eid="LEV 23:15" /><verse number="16" style="v" sid="LEV 23:16" />सातमै विश्रामदिन के आगले दिन तक पचास दिन गिणना, अर पचासवें दिन यहोवा कै खात्तर नया अन्‍नबलि चढ़ाईयों। <verse eid="LEV 23:16" /><verse number="17" style="v" sid="LEV 23:17" />थम अपणे घर म्ह तै एपा<note caller="+" style="f"><char style="fr" closed="false">23:17 </char><char style="fq" closed="false">एपा </char><char style="ft" closed="false">2 किलोग्राम मैद्दा</char></note> के दो दसमां हिस्से मैदे की दो रोट्टी हिलाण की भेंट कै खात्तर ले आणा; वे खमीर कै गेल्या पकाई जावैं, अर यहोवा कै खात्तर पैहली उपज ठहरै। <verse eid="LEV 23:17" /><verse number="18" style="v" sid="LEV 23:18" />अर उस रोट्टी के गैल एक-एक साल के सात बेकसूर भेड़ के बच्‍चे, अर एक बाछड़ा, अर दो मिंढे चढ़ाईयों; वे अपणे-अपणे गैल के अन्‍नबलि अर अर्घ सुधा यहोवा कै खात्तर होमबलि की ढाळ चढ़ाए जावैं, यानिके वे यहोवा कै खात्तर सुखदायक सुगन्ध देण आळा हवन ठहरै। <verse eid="LEV 23:18" /><verse number="19" style="v" sid="LEV 23:19" />फेर पापबलि कै खात्तर एक बकरा, अर मेलबलि कै खात्तर एक-एक साल कै दो भेड़ के बच्‍चे चढ़ाईयों। <verse eid="LEV 23:19" /><verse number="20" style="v" sid="LEV 23:20" />फेर याजक उननै पैहली उपज की रोट्टी सुधा यहोवा कै स्याम्ही हिलाण की भेंट कै खात्तर हिलावै, अर इन रोटियाँ कै गैल वे दो भेड़ के बच्‍चे भी हिलाए जावैं; वे यहोवा कै खात्तर पवित्र, अर याजक का हिस्सा ठहरै। <verse eid="LEV 23:20" /><verse number="21" style="v" sid="LEV 23:21" />अर थम उस दिन यो प्रचार करियो, के आज म्हारी एक पवित्र सभा होवैगी; अर मेहनत का कोए काम ना करियो; या थारे सारे कुण्बे म्ह थारी पीढ़ी-पीढ़ी म्ह सदा की विधि ठहरै।”<verse eid="LEV 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 23:22" />“जिब थम अपणे देश म्ह के खेत काट्टो, फेर अपणे खेत कै कुण्यां नै पूरी तरियां तै ना काटियो, अर खेत म्ह गिरी होई बाल्‍लां नै कठ्ठा ना करियो; उसनै गरीब अर परदेशी कै खात्तर छोड़ दियो; मै थारा परमेसवर यहोवा सूं।”<verse eid="LEV 23:22" /></para>
  <para style="s">नये साल का त्यौहार</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 23:23" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 23:23" /><verse number="24" style="v" sid="LEV 23:24" />“इस्राएलियाँ तै कह के सातमै महिन्‍ने कै पैहल्ड़े दिन म्ह थारे खात्तर परमविश्राम हो; उस दिन नै याद दुवाण कै खात्तर नरसिंगे फूँके जावैं, अर एक पवित्र सभा कठ्ठी हो। <verse eid="LEV 23:24" /><verse number="25" style="v" sid="LEV 23:25" />उस दिन थम मेहनत का कोए काम ना करियो, अर यहोवा कै खात्तर एक हवन चढ़ाईयों।”<verse eid="LEV 23:25" /></para>
  <para style="s">प्रायश्चित का दिन</para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 23:26" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 23:26" /><verse number="27" style="v" sid="LEV 23:27" />“उसे सातमै महिन्‍ने के दसवें दिन प्रायश्चित का दिन मान्या जावै; वो थारी पवित्र सभा का दिन होवैगा, अर उस म्ह थम उपवास करियो अर यहोवा का हवन चढ़ाईयों। <verse eid="LEV 23:27" /><verse number="28" style="v" sid="LEV 23:28" />उस दिन थम किसे ढाळ का काम-काज ना करियो; क्यूँके वो प्रायश्चित का दिन ठहराया गया सै जिस म्ह थारे परमेसवर यहोवा कै स्याम्ही थारै खात्तर प्रायश्चित करया जावैगा। <verse eid="LEV 23:28" /><verse number="29" style="v" sid="LEV 23:29" />इस करकै जो माणस उस दिन उपवास ना करै वो अपणे माणसां म्ह तै नाश करया जावैगा। <verse eid="LEV 23:29" /><verse number="30" style="v" sid="LEV 23:30" />अर जो माणस उस दिन किसे ढाळ का काम-काज करै सै उस माणस नै मै उसके माणसां के बीच म्ह तै नाश कर दियुँगा। <verse eid="LEV 23:30" /><verse number="31" style="v" sid="LEV 23:31" />थम किसे ढाळ का काम-काज ना करियो; या थारी पीढ़ी-पीढ़ी म्ह थारे घरान्यां म्ह सदा की विधि ठहरै। <verse eid="LEV 23:31" /><verse number="32" style="v" sid="LEV 23:32" />वो दिन थारे खात्तर परमविश्राम का हो, उस म्ह थम उपवास करियो; अर उस महिन्‍ने कै नोम्मे दिन की साँझ तै आगली साँझ तक अपणा विश्रामदिन मान्या करियो।”<verse eid="LEV 23:32" /></para>
  <para style="s">झोपड़ियां का त्यौहार</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 23:33" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 23:33" /><verse number="34" style="v" sid="LEV 23:34" />“इस्राएलियाँ तै कह के उस्से सातमै महिन्‍ने कै पन्द्रहवें दिन तै सात दिन तक यहोवा कै खात्तर झोपड़ियां का त्यौहार रह्या करै। <verse eid="LEV 23:34" /><verse number="35" style="v" sid="LEV 23:35" />पैहल्ड़े दिन पवित्र सभा हो; उस म्ह मेहनत का कोए काम ना करया जावै। <verse eid="LEV 23:35" /><verse number="36" style="v" sid="LEV 23:36" />सातों दिन यहोवा कै खात्तर हवन चढ़ाया करियो, फेर आठवें दिन थारी पवित्र सभा हो, अर यहोवा कै खात्तर हवन चढ़ाईयों; वो बड्डी सभा का दिन सै, अर उस म्ह मेहनत का कोए काम ना करियो।”<verse eid="LEV 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 23:37" />“यहोवा के त्यौहार येए सैं, इन म्ह थम यहोवा नै हवन चढ़ाईयों, यानिके होमबलि, अन्‍नबलि, मेलबलि, अर अर्घ, हरेक अपणे-अपणे सही बखत पै चढ़ाएँ जावै अर पवित्र सभा का प्रचार करियो। <verse eid="LEV 23:37" /><verse number="38" style="v" sid="LEV 23:38" />इन सारया तै घणा यहोवा कै विश्रामदिनां नै मानियो, अर अपणी भेटां, अर सारी मन्‍नतां, अर स्वेच्छाबलियां नै जो यहोवा तै अर्पण करोगे चढ़ाया करियो।”<verse eid="LEV 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 23:39" />“फेर सातमै महिन्‍ने कै पन्द्रहवें दिन नै, जिब थम देश की उपज नै कठ्ठा कर ल्यो, फेर सात दिन तक यहोवा का त्यौहार मनाईयो; पैहल्ड़े दिन परमविश्राम हो, अर आठवें दिन परमविश्राम हो। <verse eid="LEV 23:39" /><verse number="40" style="v" sid="LEV 23:40" />अर पैहल्ड़े दिन थारे आच्छे-आच्छे दरखत्तां की उपज, अर खजूर कै पत्ते, अर घणे दरखत्तां की डाळी, अर नदी म्ह कै मजनू नै लेकै अपणे परमेसवर यहोवा कै स्याम्ही सात दिन तक खुशी मनाईयो। <verse eid="LEV 23:40" /><verse number="41" style="v" sid="LEV 23:41" />हरेक साल सात दिन तक यहोवा कै खात्तर त्यौहार मान्या करियो; या थारी पीढ़ी-पीढ़ी म्ह सदा की विधि ठहरै, के सातमै महिन्‍ने म्ह यो त्यौहार मान्या जावै। <verse eid="LEV 23:41" /><verse number="42" style="v" sid="LEV 23:42" />सात दिन ताहीं थम झोपड़ियां म्ह रह्या करियो, यानिके जितने जन्म के इस्राएली सै वे सारे के सारे झोपड़ियां म्ह रहवै,”<verse eid="LEV 23:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LEV 23:43" />“ज्यांतै के थारी पीढ़ी-पीढ़ी के माणस जाण सकै, के जिब यहोवा हम इस्राएलियाँ नै मिस्र देश तै लिकाड़कै ल्याण लागरया था फेर उसनै उन ताहीं झोपड़ियां म्ह टिकाया था; मै थारा परमेसवर यहोवा सूं।” <verse eid="LEV 23:43" /><verse number="44" style="v" sid="LEV 23:44" />अर मूसा नै इस्राएलियाँ तै यहोवा के त्यौहार के सही बखत कह सुणाए।<verse eid="LEV 23:44" /></para>
  <chapter eid="LEV 23" />
  <chapter number="24" style="c" sid="LEV 24" />
  <para style="s">पवित्र दीव्यां ताहीं सजाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 24:1" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 24:1" /><verse number="2" style="v" sid="LEV 24:2" />“इस्राएलियाँ तै यो हुकम दे के मेरै धोरै चाँदणा देण कै खात्तर कूटकै काढ्या होया जैतून का शुद्ध तेल ले आणा, के दीवा लगातार जळदा रहवै। <verse eid="LEV 24:2" /><verse number="3" style="v" sid="LEV 24:3" />हारुन उसनै, मिलापआळे तम्बू म्ह, साक्षीपत्र<note caller="+" style="f"><char style="fr" closed="false">24:3 </char><char style="fq" closed="false">साक्षीपत्र </char><char style="ft" closed="false">करार कै सन्दूक का पड़दा</char></note> कै बीचआळे पड़दे तै बाहर, यहोवा कै स्याम्ही रोज साँझ तै तड़कैए ताहीं सजा कै धरै; या थारी पीढ़ी-पीढ़ी कै खात्तर सदा की विधि ठहरै। <verse eid="LEV 24:3" /><verse number="4" style="v" sid="LEV 24:4" />वो दीवे नै सोन्‍ने की दीवट पै यहोवा कै स्याम्ही रोज सजाया करै।”<verse eid="LEV 24:4" /></para>
  <para style="s">निवास की रोट्टी</para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 24:5" />“तू मैद्दा लेकै बारहा रोट्टी पकवाइये, हरेक रोट्टी म्ह एपा का दो दसमां हिस्सा मैद्दा हो। <verse eid="LEV 24:5" /><verse number="6" style="v" sid="LEV 24:6" />फेर उनकी दो कतार बणाकै, एक-एक कतार म्ह छः छ: रोट्टी, स्वच्छ मेज पै यहोवा कै स्याम्ही धरिये। <verse eid="LEV 24:6" /><verse number="7" style="v" sid="LEV 24:7" />अर एक-एक कतार पै शुद्ध लोबान धरिये के वो रोट्टी याद कराण आळी चीज अर यहोवा कै खात्तर हवन हो। <verse eid="LEV 24:7" /><verse number="8" style="v" sid="LEV 24:8" />हरेक विश्रामदिन म्ह वो उस ताहीं लगातार यहोवा कै स्याम्ही क्रम तै धरया करै, या सदा के करार की रीति की तरियां इस्राएलियाँ की ओड़ तै होया करै। <verse eid="LEV 24:8" /><verse number="9" style="v" sid="LEV 24:9" />अर वो हारुन अर उसके बेट्याँ की होवैगीं, अर वे उसनै किसे पवित्र स्‍थान म्ह खावैं, क्यूँके वा यहोवा कै हवनां म्ह तै सदा की विधि कै मुताबिक हारुन कै खात्तर परमपवित्र चीज ठहरी सै।”<verse eid="LEV 24:9" /></para>
  <para style="s">परमेसवर की निन्‍दा की सजा</para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 24:10" />उन दिनां म्ह किसे इस्राएली औरत का बेट्टा, जिसका पिता मिस्री आदमी था, इस्राएलियाँ कै बिचाळै चल्या गया; अर वो इस्राएली जनान्‍नी का बेट्टा अर एक इस्राएली आदमी छावणी कै बिचाळै आप्पस म्ह मारपीट करण लाग्गै, <verse eid="LEV 24:10" /><verse number="11" style="v" sid="LEV 24:11" />अर वो इस्राएली जनान्‍नी का बेट्टा यहोवा कै नाम की निन्‍दा करकै श्राप देण लाग्या। या सुणकै माणस उसनै मूसा कै धोरै लेगे। उसकी माँ का नाम शलोमीत था, जो दान कै गोत्र के दिब्री की बेट्टी थी। <verse eid="LEV 24:11" /><verse number="12" style="v" sid="LEV 24:12" />उननै उस ताहीं हवालात म्ह बन्द करया, जिसतै यहोवा के हुकम तै इस बात पै विचार करया जावै।<verse eid="LEV 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 24:13" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 24:13" /><verse number="14" style="v" sid="LEV 24:14" />“थम उस श्राप देण आळे नै छावणी तै बाहर ले जाओ; अर जितन्या नै वो निन्‍दा सुणी हो वे सारे अपणे-अपणे हाथ उसकै सिर पै धरैं, फेर सारी मण्डळी के माणस उसपै पत्थर बरसावैं। <verse eid="LEV 24:14" /><verse number="15" style="v" sid="LEV 24:15" />अर तू इस्राएल के माणसां तै कह के कोए भी क्यूँ ना हो, जो अपणे परमेसवर नै श्राप दे उसनै अपणे पाप का बोझ ठाणा पड़ैगा। <verse eid="LEV 24:15" /><verse number="16" style="v" sid="LEV 24:16" />यहोवा के नाम की बुराई करण आळा पक्‍का मार दिया जावै; सारी मण्डळी के माणस जरुर उसपै पथराव करैं; चाहे देशी हो चाहे परदेशी, जै कोए यहोवा के नाम की बुराई करै तो वो मार दिया जावै।”<verse eid="LEV 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 24:17" />“फेर जो कोए किसे माणस नै जान तै मारै वो जरुर मार दिया जावै। <verse eid="LEV 24:17" /><verse number="18" style="v" sid="LEV 24:18" />अर जो कोए किसे घरेलू पशु नै जान तै मारै वो उसका बदला दे, यानिके जान कै बदलै जान दे।”<verse eid="LEV 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 24:19" />“फेर जै कोए किसे दुसरे नै चोट पोहचावै, तो जिसा उसनै करया हो उसाए उसकै गेल्या भी करया जावै, <verse eid="LEV 24:19" /><verse number="20" style="v" sid="LEV 24:20" />यानिके अंग-भंग करण कै बदलै अंग-भंग करया जावै, आँख कै बदलै आँख, दाँत कै बदलै दाँत, जिसी चोट जिस किसे नै पोहचाई हो उस्से तरियां ए उस ताहीं भी पोहचाई जावै। <verse eid="LEV 24:20" /><verse number="21" style="v" sid="LEV 24:21" />पशु नै मार गेरण आळा उसका बदला दे, पर माणस का मार गेरण आळा मार दिया जावै। <verse eid="LEV 24:21" /><verse number="22" style="v" sid="LEV 24:22" />थारा नियम एक ए हो, जिसा देशी कै खात्तर उसाए परदेशी कै खात्तर भी हो; मै थारा परमेसवर यहोवा सूं।” <verse eid="LEV 24:22" /><verse number="23" style="v" sid="LEV 24:23" />आखर म्ह मूसा नै इस्राएलियाँ तै यो समझाया; फेर उननै उस श्राप देण आळे नै छावणी तै बाहर ले जाकै उसपै पथराव करया। अर इस्राएलियाँ नै उस्से तरियां ए करया जिसा यहोवा नै मूसा तै हुकम दिया था।<verse eid="LEV 24:23" /></para>
  <chapter eid="LEV 24" />
  <chapter number="25" style="c" sid="LEV 25" />
  <para style="s">धरती कै खात्तर आराम का साल</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 25:1" />फेर यहोवा नै सीनै पर्वत कै धोरै मूसा तै कह्या, <verse eid="LEV 25:1" /><verse number="2" style="v" sid="LEV 25:2" />“इस्राएलियाँ तै कह के जिब थम उस देश म्ह दाखल होओ जो मै थमनै देऊँ सूं, फेर धरती नै यहोवा कै खात्तर आराम मिल्या करै। <verse eid="LEV 25:2" /><verse number="3" style="v" sid="LEV 25:3" />छः साल तो अपणा-अपणा खेत बोया करियो, अर छहों साल अपणे-अपणे अंगूर के बाग छाँट-छाँट कै देश की उपज कठ्ठी करया करियो; <verse eid="LEV 25:3" /><verse number="4" style="v" sid="LEV 25:4" />पर सातमै साल धरती नै यहोवा कै खात्तर परमविश्रामकाल मिल्या करै; उस म्ह ना तो अपणा खेत बोईयो अर ना अपणे अंगूर के बाग नै छाँटियो। <verse eid="LEV 25:4" /><verse number="5" style="v" sid="LEV 25:5" />जो कुछ काट्टे होए खेत म्ह अपणे-आप तै उगै उस ताहीं ना काटियो, अर अपणी बिना छाँट्टी होई अंगूर की बेल की दाखां नै ना तोड़ियो; क्यूँके वो धरती कै खात्तर परमविश्राम का साल होवैगा। <verse eid="LEV 25:5" /><verse number="6" style="v" sid="LEV 25:6" />धरती के विश्रामकाल की ए पैदावार तै थमनै, अर थारे दास-दास्सी नै, अर थारै गेल्या रहण आळे मजदूरां अर परदेशियाँ नै भी खाणा मिलैगा; <verse eid="LEV 25:6" /><verse number="7" style="v" sid="LEV 25:7" />अर थारे डांगरां का अर देश म्ह जितने जीव-जन्तु हों उनका भी खाणा धरती की सारी पैदावार तै होवैगा।”<verse eid="LEV 25:7" /></para>
  <para style="s">जुबली का साल</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 25:8" />“सात आराम के साल, यानिके सातगुणा सात साल गिण लियो, सातों आराम के साल्‍लां का यो बखत उणनचास साल होवैगा। <verse eid="LEV 25:8" /><verse number="9" style="v" sid="LEV 25:9" />फेर सातमै महिन्‍ने कै दसवें दिन नै, यानिके प्रायश्चित कै दिन, जय-जयकार के महाशब्‍द का नरसिंगा अपणे सारे देश म्ह सारी जगहां म्ह बजवाईयो। <verse eid="LEV 25:9" /><verse number="10" style="v" sid="LEV 25:10" />अर उस पचासवें साल नै पवित्र करकै मानियो, अर देश के सारे बासिन्दया कै खात्तर छुड़ाण का प्रचार करियो; वो साल थारै उरै जुबली कुह्वावै; उस म्ह थम अपणी-अपणी खुद की धरती अर अपणे-अपणे घरान्यां म्ह बोहड़ण पाओगे<note caller="+" style="f"><char style="fr" closed="false">25:10 </char><char style="fq" closed="false">पाओगे </char><char style="ft" closed="false">जुबली का सही मतलब एक बजाण आळा सींग जो वापसी के साल कै त्यौहार कै बखत बजाया जावै था</char></note>। <verse eid="LEV 25:10" /><verse number="11" style="v" sid="LEV 25:11" />थारे उरै वो पचासवाँ साल जुबली का साल कुह्वावै; उस म्ह थम ना बोईयो, अर जो अपणे-आप उगै उसनै भी ना काटियो, अर ना बिना छाँट्टी होई अंगूर की बेल की दाखां नै तोड़ियो। <verse eid="LEV 25:11" /><verse number="12" style="v" sid="LEV 25:12" />क्यूँके वो तो जुबली का साल होवैगा; वो थारै खात्तर पवित्र होवैगा; थम उसकी पैदावार खेत म्ह तै ए लेकै खाईयों।”<verse eid="LEV 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 25:13" />“इस जुबली कै साल म्ह थम अपणी-अपणी खुद की धरती पै बोहड़ण पाओगे। <verse eid="LEV 25:13" /><verse number="14" style="v" sid="LEV 25:14" />अर जै थम अपणे भाई-बन्धु कै हाथ कुछ बेच्‍चो या अपणे भाई-बन्धु पै तै कुछ मोल ल्यो, तो थम एक-दुसरे पै उपद्रव ना करियो। <verse eid="LEV 25:14" /><verse number="15" style="v" sid="LEV 25:15" />जुबली कै बाद जितने साल बीत्ते होए हों उनकी गिणती कै मुताबिक दाम ठहराकै एक-दुसरे तै मोल लियो, अर बाकी साल्‍लां की पैदावार कै मुताबिक वो तेरे हाथ बेचै। <verse eid="LEV 25:15" /><verse number="16" style="v" sid="LEV 25:16" />जितने साल और रहवै उतनाए दाम बढ़ाईयो, अर जितने साल घाट रहवैं उतनाए दाम घटाईयो, क्यूँके साल की उपज की गिणती जितनी हो उतणी ए वो तेरे हाथ बेचैगा। <verse eid="LEV 25:16" /><verse number="17" style="v" sid="LEV 25:17" />थम अपणे-अपणे भाई-बन्धु पै उपद्रव ना करियो; अपणे परमेसवर का भय मानियो; मै थारा परमेसवर यहोवा सूं।”<verse eid="LEV 25:17" /></para>
  <para style="s">सातमै साल कै खात्तर इन्तजाम</para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 25:18" />“इस करकै थम मेरी विधियाँ नै मानियो, अर मेरै नियमां पै सूझ-बूझकै चालियो; क्यूँके इसा करण तै थम उस देश म्ह बिना डरे बसे रहोगे। <verse eid="LEV 25:18" /><verse number="19" style="v" sid="LEV 25:19" />धरती अपणी पैदावार उपजाया करैगी, अर थम पेट भर खाया करोगे, अर उस देश म्ह बिना डरे बसे रहोगे। <verse eid="LEV 25:19" /><verse number="20" style="v" sid="LEV 25:20" />अर जै थम कहो के सातमै साल म्ह हम के खावांगे, ना तो हम बोवांगे ना अपणे खेत की उपज कठ्ठी करांगे?” <verse eid="LEV 25:20" /><verse number="21" style="v" sid="LEV 25:21" />तो जाणो के मै थारे ताहीं छटमै साल म्ह इसी आशीष दियुँगा, के धरती की पैदावार तीन साल तक काम आवैगी। <verse eid="LEV 25:21" /><verse number="22" style="v" sid="LEV 25:22" />थम आठवें साल म्ह बोओगे, अर पुराणी पैदावार म्ह तै खान्दे रहोगे, अर नौवें साल की पैदावार जिब तक ना मिलै जद तक थम पुराणी पैदावार म्ह तै खान्दे रहोगे।<verse eid="LEV 25:22" /></para>
  <para style="s">रहण आळी धरती के नियम</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 25:23" />“धरती सदा कै खात्तर बेच्‍ची ना जावै, क्यूँके धरती मेरी सै; अर उस म्ह थम परदेशी अर बाहरी होवैगें। <verse eid="LEV 25:23" /><verse number="24" style="v" sid="LEV 25:24" />फेर भी थम अपणे हिस्सा के सारे देश म्ह धरती नै छुड़ाण दियो। <verse eid="LEV 25:24" /><verse number="25" style="v" sid="LEV 25:25" />जै तेरा कोए भाई-बन्धु कंगाल होकै अपणी खुद की धरती म्ह तै कुछ बेच देवै तो उसकै कुण्बे म्ह तै जो सबतै लोवै हो वो आकै अपणे भाई-बन्धु के बेच्‍चे होए हिस्से नै छुड़ाले। <verse eid="LEV 25:25" /><verse number="26" style="v" sid="LEV 25:26" />जै किसे माणस कै खात्तर कोए छुड़ाण आळा ना हो, अर उसकै धोरै इतणा धन हो के खुद ए अपणे हिस्से नै छुड़ा सकै, <verse eid="LEV 25:26" /><verse number="27" style="v" sid="LEV 25:27" />तो वो उसकै बिकण कै बखत तै साल्‍लां की गिणती करकै बाकी साल्‍लां की पैदावार का दाम उसतै, जिसनै उस ताहीं मोल लिया हो, बोहड़ा दे; फेर वो अपणी खुद की धरती का हकदार हो जावै। <verse eid="LEV 25:27" /><verse number="28" style="v" sid="LEV 25:28" />पर जै उसकै धोरै इतणी पूंजी ना हो के उस ताहीं दुबारा अपणी कर सकै, तो उसकी बेच्‍ची होई धरती जुबली कै साल तक मोल लेण आळयां कै हाथ्थां म्ह रहवै; अर जुबली कै साल म्ह आजाद हो जावै फेर वो माणस अपणी खुद की धरती का फेर हकदार हो जावै।”<verse eid="LEV 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 25:29" />“फेर जै कोए माणस चारदीवारी आळे नगर म्ह बसण का घर बेच्‍चै, तो वो बेच्‍चण कै बाद साल भरकै भित्तर उसनै छुड़ा सकैगा, यानिके पूरे साल भर उस माणस नै छुड़ाण का हक रहवैगा। <verse eid="LEV 25:29" /><verse number="30" style="v" sid="LEV 25:30" />पर जै वो साल भर म्ह न्ही छुड़ावै, तो वो घर जो चारदीवारी आळे नगर म्ह हो मोल लेण आळे का बण्या रहवै, अर पीढ़ी-पीढ़ी म्ह उस्से वंश का बण्या रहवै; अर जुबली कै साल म्ह भी न्ही छूटै। <verse eid="LEV 25:30" /><verse number="31" style="v" sid="LEV 25:31" />पर बिना चारदीवारी कै गाम्मां के घर तो देश कै खेत्तां की तरियां समझे जावैं; उनका छुड़ाणा भी हो सकैगा, अर वे जुबली कै साल म्ह छूट जावैं। <verse eid="LEV 25:31" /><verse number="32" style="v" sid="LEV 25:32" />फेर भी लेवियाँ के खुद के हिस्से के नगरां के जो घर हों उननै लेवी जिब चाहवैं वे तब छुड़ावै। <verse eid="LEV 25:32" /><verse number="33" style="v" sid="LEV 25:33" />अर जै कोए लेवी अपणा हिस्सा ना छुड़ावै, तो वो बेच्या होया घर जो उसकै हिस्सा कै नगर म्ह हो जुबली कै साल म्ह छूट जावै; क्यूँके इस्राएलियाँ कै बिचाळै लेवियाँ का हिस्सा उनकै नगरां म्ह वे घर ए सैं। <verse eid="LEV 25:33" /><verse number="34" style="v" sid="LEV 25:34" />पर उनकै नगरां कै चौगरदेकै की चराई की जमीन बेच्‍ची ना जावै; क्यूँके वो उनका सदा का हिस्सा होवैगा।”<verse eid="LEV 25:34" /></para>
  <para style="s">कंगालां नै उधार देणा</para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 25:35" />“फेर जै तेरा कोए भाई-बन्धु कंगाल हो ज्या, अर उसकी हालत तेरे स्याम्ही उसपै तरस कै लायक हो, तो तू उसनै संभाळिए; वो परदेशी या मुसाफिर की ढाळ तेरै गैल रहवै। <verse eid="LEV 25:35" /><verse number="36" style="v" sid="LEV 25:36" />उसतै ब्याज या बढ़दी ना लियो; अपणे परमेसवर का भय मानियो; जिसतै तेरा भाई-बन्धु तेरै गैल जिन्दगी गुजार सकै। <verse eid="LEV 25:36" /><verse number="37" style="v" sid="LEV 25:37" />उस ताहीं ब्याज पै रपिये ना दियो, अर ना उसनै खाण की चीज फायदा के लालच तै दिए। <verse eid="LEV 25:37" /><verse number="38" style="v" sid="LEV 25:38" />मै थारा परमेसवर यहोवा सूं; मै थमनै कनान देश देण कै खात्तर अर थारा परमेसवर ठहरण की इच्छा तै थारै ताहीं मिस्र देश तै लिकाड़ ल्याया सूं।”<verse eid="LEV 25:38" /></para>
  <para style="s">दास्सां नै छुड़ाण के नियम</para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 25:39" />“फेर जै तेरा कोए भाई-बन्धु तेरे स्याम्ही कंगाल होकै अपणे-आपनै तेरे हाथ बेच देवै, तो उसतै नौक्‍कर की तरियां सेवा न्ही करवाणा। <verse eid="LEV 25:39" /><verse number="40" style="v" sid="LEV 25:40" />वो तेरै गैल मजदूर या मुसाफिर की ढाळ रहवै, अर जुबली कै साल तक तेरै गैल रहकै सेवा करदा रहवै; <verse eid="LEV 25:40" /><verse number="41" style="v" sid="LEV 25:41" />फेर वो बाळ-बच्‍चे सुधा तेरै धोरै तै लिकड़ण पावै, अर अपणे कुण्बे म्ह अर अपणे बुजुर्गां की खुद की धरती म्ह बोहड़ जावै। <verse eid="LEV 25:41" /><verse number="42" style="v" sid="LEV 25:42" />क्यूँके वे मेरै ए दास सैं, जिन ताहीं मै मिस्र देश तै लिकाड़ ल्याया सूं; ज्यांतै वे दास की तरियां तै ना बेच्‍चे जावैं। <verse eid="LEV 25:42" /><verse number="43" style="v" sid="LEV 25:43" />उसपै कठोरता तै हक ना जमाणा; अपणे परमेसवर का भय मान्दे रहियो। <verse eid="LEV 25:43" /><verse number="44" style="v" sid="LEV 25:44" />तेरे जो दास-दास्सी हों वे थारै चौगरदे की जात्तां म्ह तै हों, अर दास अर दास्सी उन्हे म्ह तै मोल लियो। <verse eid="LEV 25:44" /><verse number="45" style="v" sid="LEV 25:45" />जो मुसाफिर माणस थारे बिचाळै म्ह परदेशी होकै रहवैंगे, उन म्ह तै अर उनकै घरान्यां म्ह तै भी जो थारै लोवै-धोरै हों, अर जो थारे देश म्ह पैदा होए हों, उन म्ह तै थम दास अर दास्सी मोल ल्यो; अर वे थारा हिस्सा ठहरै। <verse eid="LEV 25:45" /><verse number="46" style="v" sid="LEV 25:46" />थम अपणे बेट्याँ नै भी जो थारै बाद होवैगें उनके हकदार कर सकोगे, अर वे उनका हिस्सा ठहरै; उन म्ह तै थम सदा अपणे खात्तर दास लिया करियो, पर थारे भाई-बन्धु जो इस्राएली हों उनपै अपणा हक कठोरता तै ना जताईयो।”<verse eid="LEV 25:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 25:47" />“फेर जै तेरे स्याम्ही कोए परदेशी या मुसाफिर धनी हो जावै, अर उसकै स्याम्ही तेरा भाई कंगाल होकै अपणे-आपनै तेरे स्याम्ही उस परदेशी या मुसाफिर या उसकै पीढ़ी कै हाथ बेच दे, <verse eid="LEV 25:47" /><verse number="48" style="v" sid="LEV 25:48" />तो उसकै बिक जाणकै बाद वो फेर छुटाया जा सकै सै; उसके भाईयाँ म्ह तै कोए उसनै छुड़ा सकै सै, <verse eid="LEV 25:48" /><verse number="49" style="v" sid="LEV 25:49" />या उसका चाचा, या चचेरा भाई, या उसकै कुल का कोए भी नजदीकी कुटुम्बी उसनै छुड़ा सकै सै; या जै वो धनी हो जावै, तो वो खुद ए अपणे-आपनै छुड़ा सकै सै। <verse eid="LEV 25:49" /><verse number="50" style="v" sid="LEV 25:50" />वो अपणे मोल लेण आळे कै गेल्या अपणे बिकण कै साल तै जुबली कै साल तक का हिसाब करै, अर उसकै बिकण का दाम साल्‍लां की गिणती कै मुताबिक हो, यानिके वो दाम मजदूर की मजदूरी की ढाळ उसकै गेल्या होवैगा। <verse eid="LEV 25:50" /><verse number="51" style="v" sid="LEV 25:51" />जै जुबली कै साल के घणे साल रह जावै, तो जितने रपिये तै वो मोल लिया गया सै उन म्ह तै वो अपणे छुड़ाण का दाम उतने साल्‍लां कै मुताबिक बोहड़ा देवै। <verse eid="LEV 25:51" /><verse number="52" style="v" sid="LEV 25:52" />जै जुबली कै साल के थोड़े साल रह गये हों, फेर भी वो अपणे माल्‍लिक कै गेल्या हिसाब करकै अपणे छुड़ाण का दाम उतने ए साल्‍लां कै मुताबिक बोहड़ा दे। <verse eid="LEV 25:52" /><verse number="53" style="v" sid="LEV 25:53" />वो अपणे माल्‍लिक कै गैल उस मजदूर की ढाळ रहवै, जिसकी सालाना मजदूरी तय करी गई हो; अर उसका माल्‍लिक उसपै तेरै स्याम्ही कठोरता तै हक न्ही जताण पावै। <verse eid="LEV 25:53" /><verse number="54" style="v" sid="LEV 25:54" />अर जै वो इस तरियां तै छुड़ाया ना जावै, तो वो जुबली कै साल म्ह अपणे बाल-बच्यां सुधा छूट ज्या। <verse eid="LEV 25:54" /><verse number="55" style="v" sid="LEV 25:55" />क्यूँके इस्राएली मेरै ए दास सै; वे मिस्र देश म्ह तै मेरे ए लिकाड़े होए दास सै; मै थारा परमेसवर यहोवा सूं।”<verse eid="LEV 25:55" /></para>
  <chapter eid="LEV 25" />
  <chapter number="26" style="c" sid="LEV 26" />
  <para style="s">आशीष का करार</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 26:1" />“थम अपणे खात्तर मूर्ति ना बणाईयो, अर ना कोए खुदी होई मूर्ति या खम्बा अपणे खात्तर खड्या करियो, अर ना अपणे देश म्ह दण्‍डवत करण कै खात्तर नक्‍काशीदार पत्थर स्थापित करियो; क्यूँके मै थारा परमेसवर यहोवा सूं। <verse eid="LEV 26:1" /><verse number="2" style="v" sid="LEV 26:2" />थम मेरै विश्रामदिनां का पालन करियो अर मेरै पवित्र स्‍थान का भय मानियो; मै यहोवा सूं।”<verse eid="LEV 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 26:3" />“जै थम मेरे नियमां पै चाल्‍लों अर मेरे हुकमां नै मानकै उनका पालन करो, <verse eid="LEV 26:3" /><verse number="4" style="v" sid="LEV 26:4" />तो मै थारै खात्तर बखत-बखत पै मिह बरसाऊँगा, अर धरती अपणी उपज उगावैगी, अर मैदान के दरखत्त अपणे-अपणे फळ दिया करैंगे; <verse eid="LEV 26:4" /><verse number="5" style="v" sid="LEV 26:5" />उरै ताहीं के थम अंगूर तोड़ण कै बखत भी दाँवणी करदे रहोगे, अर बोण कै बखत भी भर-पेट अंगूर तोड़दे रहोगे, अर थम मनमान्‍नी रोट्टी खाया करोगे, अर अपणे देश म्ह बेफिकर बसे रहोगे। <verse eid="LEV 26:5" /><verse number="6" style="v" sid="LEV 26:6" />अर मै थारै देश म्ह सुख-चैन दियुँगा, अर थम सोओगे अर थमनै कोए डराण आळा न्ही होवैगा; अर मै उस देश म्ह खतरनाक जन्तुआं नै न्ही रहण दियुँगा, अर तलवार थारे देश म्ह न्ही चाल्‍लैगी। <verse eid="LEV 26:6" /><verse number="7" style="v" sid="LEV 26:7" />अर थम अपणे बैरियाँ नै मार भगा द्योगे, अर वे थारी तलवार तै मारे जावैंगे। <verse eid="LEV 26:7" /><verse number="8" style="v" sid="LEV 26:8" />थारे म्ह तै पाँच माणस सौ नै अर सौ माणस दस हजार नै भजावैंगें; अर थारे बैरी तलवार तै थारै आग्गै-आग्गै मारे जावैंगे; <verse eid="LEV 26:8" /><verse number="9" style="v" sid="LEV 26:9" />अर मै थारी ओड़ दया की निगांह करुँगा अर थारे ताहीं फळवन्त करुँगा अर बढ़ाऊँगा, अर थारै गैल अपणे करार नै पूरा करुँगा। <verse eid="LEV 26:9" /><verse number="10" style="v" sid="LEV 26:10" />अर थम धरे होए पुराणे अनाज नै खाओगे, अर नये कै रहंदे भी पुराणे नै लिकाड़ोगे। <verse eid="LEV 26:10" /><verse number="11" style="v" sid="LEV 26:11" />अर मै थारै बिचाळै अपणा निवास-स्थान बणाए राखूँगा, अर मेरा जी थारे तै नफरत न्ही करैगा। <verse eid="LEV 26:11" /><verse number="12" style="v" sid="LEV 26:12" />अर मै थारे बिचाळै चल्या फिरया करुँगा, अर थारा परमेसवर बण्या रहूँगा, अर थम मेरी प्रजा बणे रहोगे। <verse eid="LEV 26:12" /><verse number="13" style="v" sid="LEV 26:13" />मै तो थारा वो परमेसवर यहोवा सूं, जो थारे ताहीं मिस्र देश तै इस करकै लिकाड़ ले आया, के थम मिस्रियाँ के गुलाम ना बणे रहो; अर मन्‍नै थारे जूए ताहीं तोड़ दिया सै, अर थारे ताहीं सीध्धा खड्या करकै चलाया सै।”<verse eid="LEV 26:13" /></para>
  <para style="s">हुकम ना मानण की सजा</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 26:14" />“जै थम मेरी न्ही सुणोगे, अर इन सारे हुकमां नै न्ही मान्‍नोगे, <verse eid="LEV 26:14" /><verse number="15" style="v" sid="LEV 26:15" />अर मेरी विधियाँ नै निकम्मा जाणोगे, अर थारी आत्मा मेरे फैसल्यां तै नफरत करै, अर थम मेरे सारे हुकमां का पालन न्ही करोगे, बल्के मेरे करार नै तोड़ोगे, <verse eid="LEV 26:15" /><verse number="16" style="v" sid="LEV 26:16" />तो मै थारे तै न्यू करुँगा; यानिके मै थमनै बेचैन करुँगा, अर क्षयरोग अर बुखार तै पीड़ित करुँगा, अर इनकै कारण थारी आँख धुँधळी हों जावैंगी, अर थारा मन घणा उदास होवैगा। अर थारा बीज बोणा बेकार होवैगा, क्यूँके थारे बैरी उसकी उपज खा लेवैगें; <verse eid="LEV 26:16" /><verse number="17" style="v" sid="LEV 26:17" />अर मै भी थारे बिरुध्द हो ज्याऊँगा, अर थम अपणे बैरियाँ तै हार जाओगे; अर थारे बैरी थारै उप्पर हक जमावैंगें, अर जिब कोए थमनै भजावै भी कोनी, फेर भी थम भाज्जोगे। <verse eid="LEV 26:17" /><verse number="18" style="v" sid="LEV 26:18" />अर जै थम इन बात्तां कै बाद भी मेरी न्ही सुणो, तो मै थारे पापां के कारण थमनै सातगुणा ताड़ना और दियुँगा, <verse eid="LEV 26:18" /><verse number="19" style="v" sid="LEV 26:19" />अर मै थारी ताकत्त का घमण्ड तोड़ दियुँगा, अर थारे खात्तर अकास नै मान्‍नो लोहे का अर धरती नै मान्‍नो पीत्तळ की बण्या दियुँगा; <verse eid="LEV 26:19" /><verse number="20" style="v" sid="LEV 26:20" />अर थारा बल बेकार म्ह गँवाया जावैगा, क्यूँके थारी धरती अपणी पैदावार न्ही देवैगी, अर मैदान के दरखत्त अपणे फळ न्ही देवैंगे।”<verse eid="LEV 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 26:21" />“जै थम मेरै बिरुध्द चाल्दे-ए रहो, अर मेरा कहणा ना मान्‍नो, तो मै थारै पापां कै मुताबिक थारे उप्पर और सात गुणा मुसीबत्त गेरूँगा। <verse eid="LEV 26:21" /><verse number="22" style="v" sid="LEV 26:22" />अर मै थारे बिचाळै बणपशु भेज्जूँगा, जो थमनै बेबस करैंगे, अर थारे घरेलू डान्गरां नै नाश कर देवैंगे, अर थारी गिणती घटावैगें, जिसतै थारी सड़क सून्‍नी पड़ ज्यांगी।”<verse eid="LEV 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 26:23" />“फेर जै थम इन बात्तां पै भी मेरी ताड़ना तै ना सुधरो, अर मेरै बिरुध्द चाल्दे-ए रहो, <verse eid="LEV 26:23" /><verse number="24" style="v" sid="LEV 26:24" />तो मै भी थारे बिरुध्द चाल्‍लूँगा, अर थारे पापां के कारण मै खुद ए थारे ताहीं सात गुणा मारूँगा। <verse eid="LEV 26:24" /><verse number="25" style="v" sid="LEV 26:25" />अर मै थारे पै एक इसी तलवार चलवाऊँगा, जो करार तोड़ण का पूरा-पूरा बदला लेगी; अर जिब थम अपणे नगरां म्ह जा-जाकै कठ्ठे होवोगे फेर मै थारे बिचाळै मरी फैलाऊँगा, अर थम अपणे बैरियाँ कै बस म्ह सौंप दिए जाओगे। <verse eid="LEV 26:25" /><verse number="26" style="v" sid="LEV 26:26" />जिब मै थारै खात्तर अन्‍न कै आधार नै दूर कर दियुँगा, फेर दस बिरबान्‍नी थारी रोट्टी एक ए तंदूर म्ह पका कै तौल-तौल कै बांड देंगी; अर थम खाकै भी न्ही छिकोगे।”<verse eid="LEV 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 26:27" />“फेर जै थम इसकै बाद भी मेरी न्ही सुणोगे, अर मेरै बिरुध्द चाल्दे-ए रहोगे, <verse eid="LEV 26:27" /><verse number="28" style="v" sid="LEV 26:28" />तो मै अपणे न्याय म्ह थारै बिरुध्द चाल्‍लूँगा, अर थारे पापां के कारण थमनै सातगुणी ताड़ना और भी दियुँगा। <verse eid="LEV 26:28" /><verse number="29" style="v" sid="LEV 26:29" />अर थारे ताहीं अपणे बेट्याँ अर बेटियाँ का माँस खाणा पड़ैगा। <verse eid="LEV 26:29" /><verse number="30" style="v" sid="LEV 26:30" />अर मै थारे पूजा की ऊँच्‍ची जगहां नै गेर दियुँगा, अर थारे सूरज की मूर्तियाँ तोड़ दियुँगा, अर थारी लोथां नै थारी तोड़ी होई मूर्तियाँ पै बगा दियुँगा; अर मेरी आत्मा नै थारे तै नफरत हो जावैगी। <verse eid="LEV 26:30" /><verse number="31" style="v" sid="LEV 26:31" />अर मै थारे नगरां नै उजाड़ दियुँगा, अर थारे पवित्रस्‍थानां नै उजाड़ दियुँगा, अर थारा सुखदायक सुगन्ध कबूल न्ही करुँगा। <verse eid="LEV 26:31" /><verse number="32" style="v" sid="LEV 26:32" />अर मै थारे देश नै सुन्‍ना कर दियुँगा, अर थारे बैरी जो उस म्ह रहवै सैं वे इन बात्तां कै कारण हैरान होवैगें। <verse eid="LEV 26:32" /><verse number="33" style="v" sid="LEV 26:33" />अर मै थारे ताहीं हरेक देश के माणसां कै बिचाळै तित्तर-भित्तर करुँगा, अर थारे पाच्छै-पाच्छै तलवार खिचे रहूँगा; अर थारा देश सुन्‍ना हो ज्यागा, अर थारे नगर उजाड़ हो जावैंगे।”<verse eid="LEV 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LEV 26:34" />“फेर जितने दिन वो देश सुन्‍ना पड्या रहवैगा अर थम अपणे बैरियाँ कै देश म्ह रहोगे उतने दिन वो अपणे विश्रामकालां नै मान्दा रहवैगा। फेर ए वो देश आराम पावैगा, यानिके अपणे विश्रामकालां नै मान्दा रहवैगा। <verse eid="LEV 26:34" /><verse number="35" style="v" sid="LEV 26:35" />जितने दिन वो सुन्‍ना पड्या रहवैगा उतने दिन उसनै आराम रहवैगा, यानिके जो आराम उसनै थारै ओड़ै बसै रहण कै बखत विश्रामकालां म्ह न्ही मिल्या होगा वो उसनै फेर मिलैगा। <verse eid="LEV 26:35" /><verse number="36" style="v" sid="LEV 26:36" />अर थारे म्ह तै जो बचे रहवैंगे अर अपणे बैरियाँ कै देश म्ह होवैगें उनकै मन म्ह मै कायरता उपजाऊँगा; अर वे पत्ते कै खड़कण तै भी भाग जावैंगे, अर वे इसे भाजैंगे जिस तरियां कोए तलवार तै भाज्जै, अर किसे के बिना पिच्छा करे भी वे गिर पड़ैंगे। <verse eid="LEV 26:36" /><verse number="37" style="v" sid="LEV 26:37" />जिब कोए पिच्छा करणीया ना हो फेर भी मान्‍नो तलवार कै डर तै वे एक-दुसरे तै ठोक्‍कर खाकै गिरदे जावैंगे, अर थमनै अपणे बैरियाँ कै स्याम्ही ठहरण की कुछ ताकत ना होवैगी। <verse eid="LEV 26:37" /><verse number="38" style="v" sid="LEV 26:38" />फेर थम जात-जात के माणसां कै बिचाळै पोहचकै नाश हो जाओगे, अर थारे दुश्मनां की धरती थारे ताहीं खा ज्यागी। <verse eid="LEV 26:38" /><verse number="39" style="v" sid="LEV 26:39" />अर थारै म्ह तै जो बचे रहवैंगें वे अपणे बैरियाँ कै देशां म्ह अपणे अधर्म कै कारण गळ जावैंगे; अर अपणे पूर्वजां के अधर्म के काम्मां कै कारण भी वे उन्हे की ढाळ गळ जावैंगे।”<verse eid="LEV 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 26:40" />“पर जै वे अपणे अर अपणे पितरां के अधर्म कै काम्मां नै मान लेवैगें, यानिके उस बिश्वासघात नै जो उननै मेरै बिरुध्द करया, अर या भी मान लेवैगें, के हम यहोवा कै बिरुध्द चाल्‍ले थे, <verse eid="LEV 26:40" /><verse number="41" style="v" sid="LEV 26:41" />इस्से करकै वो म्हारे खिलाफ होकै हमनै दुश्मनां कै देश म्ह ले आया सै। जै उस बखत उनका खतनारहित हृदय दब जावैगा अर वे उस बखत अपणे अधर्म की सजा नै मान लेवैंगे; <verse eid="LEV 26:41" /><verse number="42" style="v" sid="LEV 26:42" />फेर जो करार मन्‍नै याकूब के गैल करया था उसनै मै याद करुँगा, अर जो करार मन्‍नै इसहाक तै अर जो करार मन्‍नै अब्राहम तै करया था उननै भी याद करुँगा, अर इस देश नै भी मै याद करुँगा। <verse eid="LEV 26:42" /><verse number="43" style="v" sid="LEV 26:43" />पर वो देश उनतै दूर होकै सुन्‍ना पड्या रहवैगा, अर उनकै बिना सुन्‍ना रहकै भी अपणे आराम के बखतां नै मान्दा रहवैगा; अर वे माणस अपणे अधर्म की सजा नै मान लेगें, इस्से कारण तै के उननै मेरे हुकमां का उलंघण करया था, अर उनकी आत्मा नै मेरी विधियाँ तै नफरत थी। <verse eid="LEV 26:43" /><verse number="44" style="v" sid="LEV 26:44" />इतणै पै भी जिब वे अपणे बैरियाँ कै देश म्ह होवैंगे, फेर मै उननै इस तरियां न्ही छोड़ूँगा, अर ना उनतै इसी नफरत करुँगा के उनका सत्यानाश कर दियुँ अर अपणे उस करार नै तोड़ दियुँ। जो मन्‍नै उनतै करया सै; क्यूँके मै उनका परमेसवर यहोवा सूं; <verse eid="LEV 26:44" /><verse number="45" style="v" sid="LEV 26:45" />पर मै उनकी भलाई कै खात्तर उनके पितरां तै करे होए करार नै याद करुँगा, जिननै मै गैरजात्तां की आँखां कै स्याम्ही तै मिस्र देश तै लिकाड़ ल्याया के मै उनका परमेसवर ठहरूँ; मै यहोवा सूं।”<verse eid="LEV 26:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 26:46" />जो-जो विधियाँ अर नियम-कायदे यहोवा नै अपणी ओड़ तै इस्राएलियाँ कै खात्तर सीनै पर्वत पै मूसा कै जरिये तय करे थे वे येए सैं।<verse eid="LEV 26:46" /></para>
  <chapter eid="LEV 26" />
  <chapter number="27" style="c" sid="LEV 27" />
  <para style="s">खास मन्‍नत की विधि</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 27:1" />फेर यहोवा नै मूसा तै कह्या, <verse eid="LEV 27:1" /><verse number="2" style="v" sid="LEV 27:2" />“इस्राएलियाँ तै न्यू कह के जिब कोए खास मन्‍नत मान्‍नै, तो मन्‍नत मानण आळा माणस तेरे ठहराण कै मुताबिक यहोवा के होवैगें; <verse eid="LEV 27:2" /><verse number="3" style="v" sid="LEV 27:3" />इस करकै जै वो बीस साल या उसतै घणा अर साठ साल तै घाट उम्र का आदमी हो, तो उसकै खात्तर पवित्र स्‍थान कै शेकेल कै मुताबिक पचास शेकेल<note caller="+" style="f"><char style="fr" closed="false">27:3 </char><char style="fq" closed="false">पचास शेकेल </char><char style="ft" closed="false">1 शेकेल का मतलब सै 8 तै 16 ग्राम का सिक्‍का या बाट</char></note> की चाँदी ठहरै। <verse eid="LEV 27:3" /><verse number="4" style="v" sid="LEV 27:4" />जै वो औरत हो, तो तीस शेकेल ठहरै। <verse eid="LEV 27:4" /><verse number="5" style="v" sid="LEV 27:5" />फेर जै उसकी उम्र पाँच साल या उसतै घणी अर बीस साल तै घाट की हो, तो छोरे कै खात्तर तो बीस शेकेल, अर छोरी कै खात्तर दस शेकेल ठहरै। <verse eid="LEV 27:5" /><verse number="6" style="v" sid="LEV 27:6" />जै उसकी उम्र एक महिन्‍ने, या उसतै घणी अर पाँच साल तै घाट की हो, तो छोरे कै खात्तर तो पाँच, अर छोरी कै खात्तर तीन शेकेल चाँदी ठहरै। <verse eid="LEV 27:6" /><verse number="7" style="v" sid="LEV 27:7" />फेर जै उसकी उम्र साठ साल की या उसतै घणी हो, अर वो आदमी हो तो उसकै खात्तर पन्द्रह शेकेल, अर औरत हो तो दस शेकेल ठहरै। <verse eid="LEV 27:7" /><verse number="8" style="v" sid="LEV 27:8" />पर जै कोए इतणा कंगाल हो के याजक का ठहराया होया दाम ना दे सकै, तो वो याजक कै स्याम्ही खड्या करया जावै, अर याजक उसकी पूंजी ठहरावै, यानिके जितनी मन्‍नत मानण आळे तै हो सकै, याजक उस्से कै मुताबिक ठहरावै।”<verse eid="LEV 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 27:9" />“फेर जिन डान्गरां म्ह तै माणस यहोवा नै चढ़ावा चढ़ावै सै, जै इस्यां म्ह तै कोए मन्‍नत मान्‍नी जावै, तो जो पशु कोए यहोवा नै देवै सै वो पवित्र ठहरैगा। <verse eid="LEV 27:9" /><verse number="10" style="v" sid="LEV 27:10" />वो उसनै किसे ढाळ तै न्ही बदलै, ना तो वो बुरे कै बदलै आच्छा, अर ना आच्छे कै बदलै बुरा दे; अर जै वो उस पशु कै बदलै दूसरा पशु दे, तो वो अर उसका बदलै दोन्‍नु पवित्र ठहरैगें। <verse eid="LEV 27:10" /><verse number="11" style="v" sid="LEV 27:11" />अर जिन अशुद्ध डान्गरां म्ह तै माणस यहोवा कै खात्तर चढ़ावा कोनी चढ़ान्दे इस्यां म्ह तै जै वो हो, तो वो उसनै याजक कै स्याम्ही खड्या करदे, <verse eid="LEV 27:11" /><verse number="12" style="v" sid="LEV 27:12" />फेर याजक पशु कै गुण-अवगुण दोन्‍नु विचार कै उसका मोल ठहरावै; अर जितना याजक ठहरावै उसका मोल उतनाए ठहरै। <verse eid="LEV 27:12" /><verse number="13" style="v" sid="LEV 27:13" />पर जै मन्‍नत मानण आळा उसनै किसे ढाळ तै छुड़ाणा चाहवै, तो जो मोल याजक नै ठहराया हो उस म्ह उसका पाँचवाँ हिस्सा और बढ़ाकै दे।”<verse eid="LEV 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 27:14" />“फेर जै कोए अपणा घर यहोवा कै खात्तर पवित्र ठहराकै इरादा करै, तो याजक उसकै गुण-अवगुण दोनुआं का विचार करकै उसका मोल ठहरावै; अर जितना याजक ठहरावै उसका मोल उतनाए ठहरै। <verse eid="LEV 27:14" /><verse number="15" style="v" sid="LEV 27:15" />अर जै घर का पवित्र करण आळा उसनै छुड़ाणा चाहवै, तो जितने रपिये याजक नै उसका मोल ठहराया हो उस म्ह वो पाँचवाँ हिस्सा और बढ़ाकै दे, फेर वो घर उस्से का रहवैगा।”<verse eid="LEV 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 27:16" />“फेर जै कोए अपणी खुद धरती का कोए हिस्सा यहोवा कै खात्तर पवित्र ठहराणा चाहवै, तो उसका मोल इसकै मुताबिक ठहरै, के उस म्ह कितना बीज पड़ैगा; जितना धरती म्ह होमेर<note caller="+" style="f"><char style="fr" closed="false">27:16 </char><char style="fq" closed="false">होमेर </char><char style="ft" closed="false">300 किलोग्राम</char></note> भर जौ पड़ै उतणी का मोल पचास शेकेल<note caller="+" style="f"><char style="fr" closed="false">27:16 </char><char style="fq" closed="false">शेकेल </char><char style="ft" closed="false">इसका मतलब सै पैदा होया नाज का तौल/भार</char></note> ठहरै। <verse eid="LEV 27:16" /><verse number="17" style="v" sid="LEV 27:17" />जै वो अपणा खेत जुबली कै साल म्ह ए पवित्र ठहरावै, तो उसका दाम तेरै ठहराण कै मुताबिक ठहरै; <verse eid="LEV 27:17" /><verse number="18" style="v" sid="LEV 27:18" />अर जै वो अपणा खेत जुबली कै साल कै बाद पवित्र ठहरावै, तो जितने साल दुसरी जुबली कै साल के बाकी रहवै उन्हे के मुताबिक याजक उसकै खात्तर रपिये का हिसाब करै, फेर जितना हिसाब म्ह आवै उतणा याजक कै ठहराण तै घाट हो। <verse eid="LEV 27:18" /><verse number="19" style="v" sid="LEV 27:19" />अर जै खेत नै पवित्र बणावै उसनै छुड़ाणा चाहवै, तो जो दाम याजक नै ठहराया हो उस म्ह वो पाँचवाँ हिस्सा और बढ़ाकै दे, फेर खेत उस्से का रहवैगा। <verse eid="LEV 27:19" /><verse number="20" style="v" sid="LEV 27:20" />अर जै वो खेत नै छुड़ाणा न्ही चाहवै, या उसनै उस ताहीं दुसरे कै हाथ बेच्या हो, तो खेत आग्गै तक कदे न्ही छुटाया जावै; <verse eid="LEV 27:20" /><verse number="21" style="v" sid="LEV 27:21" />पर जिब वो खेत जुबली कै साल म्ह छूटै, फेर पूरी तरियां तै अर्पण करे होए खेत्तां की तरियां यहोवा कै खात्तर पवित्र ठहरै, यानिके वो याजक ए की अपणी धरती हो जावै। <verse eid="LEV 27:21" /><verse number="22" style="v" sid="LEV 27:22" />फेर जै कोए अपणा मोल लिया होया खेत, जो उसकी खुद की धरती कै गैल खेत्तां म्ह का ना हो, यहोवा कै खात्तर पवित्र ठहरावै, <verse eid="LEV 27:22" /><verse number="23" style="v" sid="LEV 27:23" />तो याजक जुबली कै साल तक का हिसाब करकै उस माणस कै खात्तर जितना ठहरावै उतनाए वो यहोवा कै खात्तर पवित्र जाणकै उस्से दिन दे-दे। <verse eid="LEV 27:23" /><verse number="24" style="v" sid="LEV 27:24" />जुबली कै साल म्ह वो खेत उस्से कै अधिकार म्ह जिसतै वो मोल लिया गया सै फेर आ जावै, यानिके जिसकी वो खुद की धरती हो उस्से की फेर हो जावै। <verse eid="LEV 27:24" /><verse number="25" style="v" sid="LEV 27:25" />जिस-जिस चीज का मोल याजक ठहरावै उसका मोल पवित्र स्‍थान कै शेकेल कै हिसाब तै ठहरै: शेकेल बीस गेरा<note caller="+" style="f"><char style="fr" closed="false">27:25 </char><char style="fq" closed="false">गेरा </char><char style="ft" closed="false">भार नै तौलण आळा सबतै छोट्टा तौल (0.6 ग्राम तै भी कम)</char></note> का ठहरै।”<verse eid="LEV 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 27:26" />“पर घरेलू पशुआं का जेठ्ठा, जो जेठ्ठा होण कै कारण यहोवा का ठहरया सै, उसनै कोए पवित्र न्ही ठहरावै; चाहे वो बाछड़ा हो, चाहे भेड़ या बकरी का बच्‍चा, वो यहोवा का ए सै। <verse eid="LEV 27:26" /><verse number="27" style="v" sid="LEV 27:27" />पर जै वो अशुद्ध पशु का हो, तो उसका पवित्र बणाण आळा उसनै याजक कै ठहराए होए मोल कै मुताबिक उसका पाँचवाँ हिस्सा और बढ़ाकै छुड़ा सकै सै; अर जै वो ना छुटाया जावै, तो याजक कै ठहराए होए मोल पै बेच दिया जावै।”<verse eid="LEV 27:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 27:28" />“पर अपणी सारी चिज्जां म्ह तै जो कुछ यहोवा कै खात्तर अर्पण करै, चाहे माणस हो चाहे पशु, चाहे उसकी खुद की धरती का खेत हो, इसी कोए अर्पण करी होई चीज ना तो बेच्‍ची जावै अर ना छुड़ाई जावै; जो कुछ अर्पण करया जावै सै वो यहोवा कै खात्तर परमपवित्र ठहरै। <verse eid="LEV 27:28" /><verse number="29" style="v" sid="LEV 27:29" />माणसां म्ह तै जो कोए मौत की सजा कै खात्तर अर्पण करया जावै, वो छुड़ाया न्ही जावै; वो जरुर मार दिया जावै।”<verse eid="LEV 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 27:30" />“फेर धरती की पैदावार का सारा दशमांश, चाहे वो धरती का बीज हो चाहे दरखत का फळ, वो यहोवा का ए सै; वो यहोवा कै खात्तर पवित्र ठहरै।<verse eid="LEV 27:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 27:31" />जै कोए अपणे दशमांश म्ह तै कुछ छुड़ाणा चाहवै, तो पाँचवाँ हिस्सा बढ़ाकै उस ताहीं छुड़ावै। <verse eid="LEV 27:31" /><verse number="32" style="v" sid="LEV 27:32" />अर गां-बळध अर भेड़-बकरी, यानिके जो-जो पशु गिणन कै खात्तर लाठ्ठी कै तळै लिकड़ जाण आळे सैं उनका दशमांश, यानिके दस-दस कै पाच्छै एक-एक पशु यहोवा कै खात्तर पवित्र ठहरै। <verse eid="LEV 27:32" /><verse number="33" style="v" sid="LEV 27:33" />कोए उसकै गुण-अवगुण ना बिचारे, अर ना उस ताहीं बदलै; अर जै कोए उसनै बदल भी ले, तो वो अर उसका बदल्या होया दोन्‍नु पवित्र ठहरै; अर वो कदे न्ही छुड़ाया जावै।”<verse eid="LEV 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LEV 27:34" />जो हुकम यहोवा नै इस्राएलियाँ कै खात्तर सीनै पर्वत पै मूसा तै दिये थे, वे योए सैं।<verse eid="LEV 27:34" /></para>
  <chapter eid="LEV 27" />
</usx>