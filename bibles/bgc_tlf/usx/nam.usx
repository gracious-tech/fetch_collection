  <para style="h">नहूम</para>
  <para style="toc1">नहूम नबी की किताब</para>
  <para style="toc2">नहूम</para>
  <para style="toc3">नहू.</para>
  <para style="mt">नहूम नबी की किताब</para>
  <para style="is">लेखक</para>
  <para style="ip">नहूम की किताब का लेखक अपणा नाम नहूम बतावै सै। (इब्रानी म्ह इसका मतलब सै, “शान्तिदाता”) वो एल्कोशवासी था। <char style="xt"><ref loc="NAM 1:1">1:1</ref></char> नबी कै रूप म्ह नहूम अश्शूर म्ह खास करकै उनकी राजधानी नीनवे म्ह मन फिराव का प्रचार करण नै भेज्या गया था। यो योना तै 150 साल बाद की घटना सै। अंत म्ह साफ सै के उननै उस बखत मन फिराया पर दोबारा मूर्तिपूजा करण लाग्गे थे।</para>
  <para style="is">लिखण की तारिख अर जगहां</para>
  <para style="ip">लगभग 620-612 ई. पू.</para>
  <para style="ip">नहूम का लिखण का बखत साफ पता लगाया जा सकै सै क्यूँके उसकी भविष्यवाणी दो जगजाहीर घटना कै बीच की सै - तेबेस का पतन अर नीनवे का पतन</para>
  <para style="is">प्रापक</para>
  <para style="ip">नहूम की भविष्यवाणी उत्तरी राज्य के दस गोत्रां नै बन्धुआई म्ह ले जाण आळे अश्शूरां अर दक्षिणी राज्य यहूदिया दोन्‍नु कै खात्तर थी। यहूदिया नै भय था के उसका भी वोए हाल होगा जो इस्राएल का होगा।</para>
  <para style="is">मकसद</para>
  <para style="ip">परमेसवर का न्याय सही अर जरुर होवै सै। परमेसवर नै 150 साल पैहल्या भविष्यवक्ता योना ताहीं उनकै धोरै भेज्या था अर उनतै प्रतिज्ञा करी थी के जै वे अपणी दुष्टता म्ह रहवैंगे तो के होगा। उस बखत तो उननै मन फिराया पर इब वे और भी घणी बुराई म्ह थे। अश्शूर अपणी विजय म्ह भोत घणे धसगे थे। नहूम यहूदिया की प्रजा तै कह रह्या था के वे निराश ना होवैं क्यूँके परमेसवर नै न्याय की घोषणा कर दी सै अर अश्शूरां ताहीं उनके लायक सजा मिलैगी।</para>
  <para style="is">खास बातें</para>
  <para style="ip">तसल्‍ली</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. परमेसवर की प्रभुसत्ता <char style="ior"><ref loc="NAM 1:1-14">1:1-14</ref></char></para>
  <para style="io1">2. नीनवे नै परमेसवर की सजा <char style="ior"><ref loc="NAM 1:15-3:19">1:15-3:19</ref></char></para>
  <chapter number="1" style="c" sid="NAM 1" />
  <para style="s">परमेसवर का अपणे बैरियाँ पै छो</para>
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1" />नीनवे<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fq" closed="false">नीनवे </char><char style="ft" closed="false">नहूम की भविष्यवाणी भी घणी कठोर अर भयानक सै योना की चेतावनी सुणकै नीनवे के रहण आळयां नै मन फिराया था लेकिन वे फेर पाप म्ह गिरगे थे</char></note> कै बारै म्ह भविष्यवाणी। एल्कोशवासी नहूम शहर के दर्शन की किताब।<verse eid="NAM 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NAM 1:2" />यहोवा जळण राक्खण आळा अर बदला लेण आळा परमेसवर सै; यहोवा बदला लेण आळा अर जळजळाहट करण आळा सै; यहोवा अपणे धोक्खा देण आळयां तै बदला लेवै सै, अर अपणे बैरियाँ का पाप न्ही भूलदा। <verse eid="NAM 1:2" /><verse number="3" style="v" sid="NAM 1:3" />यहोवा देर तै छो करण आळा अर बड़ा शक्तिमान सै<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="fq" closed="false">बड़ा शक्तिमान सै </char><char style="ft" closed="false">दिव्य शक्ति कै गैल दैवीय सहनशीलता भी जावै सै परमेसवर धीरजवन्त सै उसका धीरज दुर्बलता का न्ही उसके ताकत का प्रतीक सै</char></note>; वो दोषी नै किसे तरियां निर्दोष न्ही ठहरावैगा। यहोवा बवंडर अर आँधी म्ह होकै चाल्‍लै सै, अर बादळ उसके पैरां की धूळ सैं।<verse eid="NAM 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NAM 1:4" />उसके झिड़कण तै महानद सूख जावै सैं, वो सारी नदियाँ नै सूखा देवै सै; बाशान के खेत अर कर्मेल के बाग कुम्हळान्दे अर लबानोन के फूलां की हरियाली जान्दी रहवै सै। <verse eid="NAM 1:4" /><verse number="5" style="v" sid="NAM 1:5" />उसकी उपस्थिति तै पहाड़ काँम्ब उठ्ठै सैं अर पहाड़ियाँ गळ जावै सैं; उसके प्रताप तै धरती बलके सारा संसार अपणे सारे रहण आळयां समेत थरथरा उठ्ठै सै।<verse eid="NAM 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NAM 1:6" />उसके छो का सामना कौण कर सकै सै? अर जिब उसका छो भड़कै सै, फेर कौण ठहर सकै सै? उसकी जळजळाहट आग की तरियां भड़क ज्या सै, अर चट्टान उसकी शक्ति तै पाट पाटकै गिरै सैं। <verse eid="NAM 1:6" /><verse number="7" style="v" sid="NAM 1:7" />यहोवा भला सै; संकट के दिन म्ह वो मजबूत गढ़ ठहरै सै, अर अपणे शरणागतां नै याद राक्खै सै। <verse eid="NAM 1:7" /><verse number="8" style="v" sid="NAM 1:8" />पर वो उमड़दी होई धारा तै उसकी जगहां का अन्त कर देगा, अर अपणे बैरियाँ नै खदेड़ कै अन्धकार म्ह भगा देगा। <verse eid="NAM 1:8" /><verse number="9" style="v" sid="NAM 1:9" />थम यहोवा कै खिलाफ के कल्पना कर रहे सो? वो थारा अन्त कर देवैगा; विपत्ति दुसरी बार पड़ण न्ही पावैगी। <verse eid="NAM 1:9" /><verse number="10" style="v" sid="NAM 1:10" />क्यूँके चाहे तेरे दुश्मन काण्डयाँ तै उळझे होए हों, अर शराब के नशे म्ह चूर भी हों, तोभी वे सूक्खी खूँटी की तरियां भस्म करे जावैंगे। <verse eid="NAM 1:10" /><verse number="11" style="v" sid="NAM 1:11" />हे नीनवे, तेरै म्ह तै एक दुष्ट लिकड़या सै, जो यहोवा कै खिलाफ कल्पना करै अर नीचता की योजना बणावै सै।<verse eid="NAM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NAM 1:12" />यहोवा अपणे लोग्गां तै न्यू कहवै सै, “चाहे वे<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">अश्शूर के रहण आळे</char></note> सारी तरियां तै ताकतवर हों, अर घणे भी हों, तोभी पूरी तरियां तै काट्टे जावैंगे अर जीरो हो जावैंगे। मन्‍नै तेरे ताहीं दुःख दिया सै, पर फेर न्ही देऊँगा। <verse eid="NAM 1:12" /><verse number="13" style="v" sid="NAM 1:13" />क्यूँके इब मै उसका जूआ तेरी गर्दन पै तै उतारकै तोड़ गेरूँगा, अर तेरा बन्धन पाड़ गेरूँगा।”<verse eid="NAM 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NAM 1:14" />यहोवा नै तेरे बारै म्ह न्यू हुकम दिया सै “आग्गै तै तेरा खानदान ना चाल्‍लै; मै तेरे देवालयां म्ह तै ढळी अर गढ़ी होई मूर्तियाँ नै काट गेरूँगा, मै अश्शूर के खात्तर कब्र खोदूँगा, क्यूँके तू जीण के लायक न्ही सै।”<verse eid="NAM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NAM 1:15" />देक्खो<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="ACT 10:36">प्रेरि. 10:36</ref>; <ref loc="ROM 10:15">रोम. 10:15</ref>; <ref loc="EPH 6:15">इफि. 6:15</ref></char></char></note>, पहाड़ां पै शुभ समाचार का सुणाण आळा अर शान्ति का प्रचार करण आळा आ रह्या सै! इब हे यहूदा, अपणे त्यौहार मना, अर परमेसवर ताहीं करे होए अपणे वायदे नै पूरा कर, क्यूँके वो दुष्ट फेर कदे तेरे बिचाळै होकै ना चाल्‍लैगा, वो पूरी तरियां तै नाश होया सै।<verse eid="NAM 1:15" /></para>
  <chapter eid="NAM 1" />
  <chapter number="2" style="c" sid="NAM 2" />
  <para style="s">नीनवे का विनाश</para>
  <para style="p">
    <verse number="1" style="v" sid="NAM 2:1" />यहोवा नै मेरे ताहीं कह्या, हे नीनवे, सत्यानाश करण आळा तेरै खिलाफ चढ़ आया सै। गढ़ नै मजबूत कर; राह देखदा होया चौक्‍कस रह; अपणी कमर कस; अपणा जोर बढ़ा दे।<verse eid="NAM 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NAM 2:2" />यहोवा याकूब की महिमा नै इस्राएल की महिमा की तरियां न्यू की न्यू कर रह्या सै, क्यूँके उजाड़ण आळयां नै उन ताहीं उजाड़ दिया सै अर दाख की डाळियाँ का नाश करया सै।<verse eid="NAM 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NAM 2:3" />उसके दुश्मनां शूरवीरां की ढाल लाल रंग तै रंगी गई, अर उसके योद्धा लाल रंग के कपड़े पहरे होए सैं। त्यारी के दिन रथां का लोहा आग की तरियां चमकै सै, अर भाल्‍ले हिलाए जावैं सैं। <verse eid="NAM 2:3" /><verse number="4" style="v" sid="NAM 2:4" />रथ सड़कां म्ह घणी रफतार तै चलाए जावैं अर चौकां म्ह आस्सै-पास्सै चलावै जावैं सैं; वे मशाल की तरियां दिखाई देवै सैं, अर उनकी रफतार बिजळी की जिसी सै। <verse eid="NAM 2:4" /><verse number="5" style="v" sid="NAM 2:5" />नीनवे अपणे चुणे होए खास शूरवीरां नै याद करै सै; वे चाल्दे-चाल्दे ठोक्‍कर खावैं सैं, वे शहरपनाह की दीवार की और फुर्ती तै जावैं सैं, अर हिफाजत आळी ढाल त्यार करी जावै सै। <verse eid="NAM 2:5" /><verse number="6" style="v" sid="NAM 2:6" />नहरां के राह खुल जावै सैं, अर राजभवन गळकै बैठ्या जावै सै। <verse eid="NAM 2:6" /><verse number="7" style="v" sid="NAM 2:7" />नीनवे के लोग लिकाड़े जावैंगे, अर उनकी जनान्‍नी नंगी करकै गुलाम्मी म्ह ले ली जावैगी, अर उसकी दासियाँ छात्ती पीटदी होई पिण्डुकां की तरियां विलाप करैंगी। <verse eid="NAM 2:7" /><verse number="8" style="v" sid="NAM 2:8" />नीनवे जिब तै बणी सै, जिब तै तालाब की तरियां सै, फेर भी वे भाजे जावैं सैं, अर “खड़े हो; खड़े हो”, इसा बुलाए जाण पै भी कोए मुँह न्ही मोड़दा। <verse eid="NAM 2:8" /><verse number="9" style="v" sid="NAM 2:9" />इनके शहर की चाँदी नै लुट्टो, सोन्‍ने नै लुट्टो, उसके जोड़े होये धन की बहुतायत, अर वैभव की सारी ढाळ की मनभावणी सामग्री का कुछ उदाहरण न्ही।<verse eid="NAM 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NAM 2:10" />वो खाल्‍ली, छूछी अर सून्‍नी होगी सै! मन कच्‍चा होग्या, अर पैर काँम्बै सैं; अर उन सारया की कमर म्ह बड़ी पीड़ा उठी, अर सारया के मुँह का रंग उड़ ग्या सै! <verse eid="NAM 2:10" /><verse number="11" style="v" sid="NAM 2:11" />शेरां की वा माँद, अर जवान शेर के आखेट की वा जगहां कित्त रही जिस म्ह शेर अर शेरणी अपणे बच्यां समेत बेधड़क फिरैं थे? <verse eid="NAM 2:11" /><verse number="12" style="v" sid="NAM 2:12" />शेर तो अपणे बच्यां कै खात्तर बड़े शिकार नै पकड़ै था, अर अपणी शेरणियाँ कै खात्तर शिकार का गळा घोट घोटकै ले जावै था, अर अपणी गुफा अर माँदां नै शिकार तै भर लेवै था।<verse eid="NAM 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NAM 2:13" />सेनाओं के यहोवा की या वाणी सै, मै तेरै खिलाफ सूं<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="fq" closed="false">मै तेरै खिलाफ सूं </char><char style="ft" closed="false">परमेसवर अपणे धीरज कै कारण उननै अणदेखा कर रहया था लेकिन इब उनकी और देक्खै सै अर उसकी नजर म्ह कोए भी निकम्मा खड्या न्ही रह सकदा।</char></note>, अर उसके रथां नै भस्म करकै धुएँ म्ह उड़ा दियुँगा, अर उसके वीर जवान शेर की तरियां तलवार तै मारे जावैंगे; मै तेरे शिकार ताहीं धरती पै तै नाश करुँगा, अर तेरे दूत्तां का बोल फेर सुण्या न्ही जावैगा।<verse eid="NAM 2:13" /></para>
  <chapter eid="NAM 2" />
  <chapter number="3" style="c" sid="NAM 3" />
  <para style="s">नीनवे का श्राप</para>
  <para style="p">
    <verse number="1" style="v" sid="NAM 3:1" />हाय उस हत्यारी नगरी नीनवे पै, वा तो छळ अर लूट के धन तै भरी होई सै; लूट कम न्ही होवै सै। <verse eid="NAM 3:1" /><verse number="2" style="v" sid="NAM 3:2" />कोड़यां की फटकार अर पहियाँ की घड़घड़ाट हो रही सै; घोड़े कूदते-फाँदते अर रथ उछळदे चाल्‍लै सैं। <verse eid="NAM 3:2" /><verse number="3" style="v" sid="NAM 3:3" />सवार<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">नीनवे को वेश्या जिसा बता के तुलना करी गयी सै</char></note> अपणे घोड़ा नै लेकै चढ़ाई करदे, तलवार अर भाल्‍ले बिजळी की तरियां चमकै सैं, मारे होया की बहुतायत अर लाशां का बड़ा ढेर सै; मुर्दयां की कोए गिणती न्ही, माणस मुर्दयां तै ठोक्‍कर खा-खाकै चाल्‍लै सैं! <verse eid="NAM 3:3" /><verse number="4" style="v" sid="NAM 3:4" />यो सारा उस घणी सुथरी वेश्या, अर होशियार टुणे-टोटके के ओच्छेपण की बहुतायत कै कारण होया, जो ओच्छेपण के जरिये जात-जात के माणसां नै, अर टुण्यां के जरिये कुल-कुल के माणसां नै बेच देवै सै।<verse eid="NAM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NAM 3:5" />सेनाओं के यहोवा की या वाणी सै, देख, मै तेरै खिलाफ सूं, अर तेरे कपड़े नै ठाकै, तेरे ताहीं जात-जात कै स्याम्ही नंगी अर राज्य-राज्य कै स्याम्ही नीच्‍चा दिखाऊँगा। <verse eid="NAM 3:5" /><verse number="6" style="v" sid="NAM 3:6" />मै तेरै पै घिनोणी चीज फेंक कै तेरे ताहीं निकम्मी कर दियुँगा, अर सब पै तेरी हाँसी कराऊँगा। <verse eid="NAM 3:6" /><verse number="7" style="v" sid="NAM 3:7" />अर जितने तेरे ताहीं देखैगें, सारे तेरे धोरै तै भाजकै कहवैंगे, नीनवे नाश होगी; कौण उसके कारण विलाप करै? हम उसकै खात्तर शान्ति देण आळा कित्त तै ढूँढ कै ले आवैं? <verse eid="NAM 3:7" /><verse number="8" style="v" sid="NAM 3:8" />के तू अमोन नगरी<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="fq" closed="false">अमोन नगरी </char><char style="ft" closed="false">मिस्र देश की राजधानी </char></note> तै बढ़कै सै, जो नहरां कै बीच बसी थी, अर उसके च्यांरु और पाणी था, अर महानद उसकै खात्तर किला अर शहरपनाह का काम देवै था? <verse eid="NAM 3:8" /><verse number="9" style="v" sid="NAM 3:9" />कूश अर मिस्री उसनै अनगिणत बल देवै थे, पूत अर लूबी देश तेरे साथ देणीये थे।<verse eid="NAM 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NAM 3:10" />फेर भी माणस उसनै गुलाम्मी म्ह लेगे, अर उसके छोट्टे बाळक सड़कां के सिरे पै पटक दिए गए; अर उसके प्रतिष्ठित माणसां कै खात्तर उननै चिट्ठी गेरी, अर उसके सब रईस बेड़ियाँ तै जकड़े गए। <verse eid="NAM 3:10" /><verse number="11" style="v" sid="NAM 3:11" />तू भी मतवाळी होवैगी, तू घबरा जावैगी; तू भी दुश्मन के डर के मारे शरण की जगहां टोहवैगी। <verse eid="NAM 3:11" /><verse number="12" style="v" sid="NAM 3:12" />तेरे सारे गढ़ इसे अंजीर के दरखतां की तरियां होवैंगे जिन म्ह पैहले पक्‍के अंजीर लाग्गे हों, जै वे हिलाए जावैं तो फळ खाणआळे कै मुँह म्ह गिरैंगे। <verse eid="NAM 3:12" /><verse number="13" style="v" sid="NAM 3:13" />देख, तेरे माणस जो तेरे बीच म्ह सैं, वे जनान्‍नी बणगे सैं। तेरे देश म्ह बड़ण आळे राह तेरे दुश्मनां कै खात्तर बिलकुल खुल्‍ले पड़े सैं; अर रुकावट की छड़ें आग का निवाळा होगी सैं।<verse eid="NAM 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NAM 3:14" />घेरे जाण के दिनां कै खात्तर पाणी भर ले, अर गढां नै घणा मजबूत कर; कीचड़ म्ह आकै गारा लताड़, अर भट्ठे नै सजा! <verse eid="NAM 3:14" /><verse number="15" style="v" sid="NAM 3:15" />ओड़ै तू आग म्ह भस्म होवैगी<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="fq" closed="false">ओड़ै तू आग म्ह भस्म होवैगी </char><char style="ft" closed="false">परमेसवर के छो की आग जिब्बे भस्म कर देवै सै</char></note>, अर तलवार तै तू नाश हो जावैगी। वो येलेक नाम की टिड्डी की तरियां तेरे ताहीं निगळ जावैगी। बेशक तू अर्बे नाम की टिड्डी की तरियां अनगिणत भी हो जावै!<verse eid="NAM 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NAM 3:16" />तेरे व्यापारी अकास के तारागण तै भी घणे अनगिणत होए। टिड्डी चट करकै उड़ जावै सै। <verse eid="NAM 3:16" /><verse number="17" style="v" sid="NAM 3:17" />तेरे मुकुट धारी माणस टिड्डियाँ की तरियां, अर तेरे सेनापति टिड्डियाँ के दलां जिसे ठैहरैगें जो जाड्यां के दिन म्ह बाड़याँ पै टिकैं सैं, पर जिब सूरज दिखाई देवै सै फेर भाज जावैं सैं; अर कोए न्ही जाणदा के वे कित्त गये।<verse eid="NAM 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NAM 3:18" />हे अश्शूर के राजा, तेरे ठहराए होए पाळी<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">राज करणीया</char></note> ऊँघै सैं; तेरे शूरवीर भारी नींद म्ह पड़गे सैं। तेरी प्रजा पहाड़ां पै आस्सै-पास्सै होगी सै, अर कोए उननै फेर कठ्ठा न्ही करदा। <verse eid="NAM 3:18" /><verse number="19" style="v" sid="NAM 3:19" />तेरा घाव न्ही भर सकैगा, तेरा रोग लाईलाज सै। जितने तेरे विनाश की खबर सुणैगें, वे तेरे उप्पर ताळी बजावैंगें। क्यूँके इसा कौण सै जिसपै तेरी लगातार बुराई का प्रभाव ना पड़या हो?<verse eid="NAM 3:19" /></para>
  <chapter eid="NAM 3" />
</usx>