<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Gowlan</book>
  <para style="h">आमोस</para>
  <para style="toc3">ओमोस</para>
  <para style="toc2">ओमोस</para>
  <para style="toc1">ओमोस</para>
  <para style="mt2">आमोस</para>
  <para style="mt1">आमोस</para>
  <para style="imt">पैछान</para>
  <para style="ip">आमोस कि पैछान या किताब मे आमोस को भविष्य सुचक संदेश हइ. आमोस एक ठाठ्यो <char style="xt"><ref loc="AMO 1:1">1:1</ref></char> अरु एक कास्तकार <char style="xt"><ref loc="AMO 7:14">7:14</ref> </char>थो. तब परमेश्वर ने ओके अपनो भविष्यवक्ता बनान का लिये बुलायो. आमोस टेकोआ शहर से थो जो यहुदा का दक्षिणी राज्य मे थो, लेकिन ओका जादा से जादा संदेश उत्तरी इस्राएल राज्य का लिये था. आमोस ने तब भविष्यवाणिहोन करी जब उज्जियाह यहुदा को राजो थो अरु यारोबाम दुसरा बार इस्राएल को राजो थो. या करीबन 750 साल पुरानी बात हइ</para>
  <para style="ip">आमोस ने पहले दो अध्यायहोन मे भोत राज्यहोन का खिलाप न्याय कि भविष्यवाणी करी, लेकिन ओका जादा से जादा संदेश इस्राएल का लिये था. यो इस्राएल का लिये खुशी को टेम थो. वा समृध्दी का दौरान वे परमेश्वर के भुली गया अरु गरीबहोन का सात बुरा व्यवहार कऱ्यो <char style="xt"><ref loc="AMO 2:6">2:6</ref></char>. येकालिये परमेश्वर को न्याय उनके बंन्दी बनयके ली जानो थो <char style="xt"><ref loc="AMO 7:17">7:17</ref></char>. फिर भी परमेश्वर ने वादो कऱ्यो कि उ इस्राएल का दुनियाहोन के वे सब के हर देशहोन पर फिर से जीत मिलना मे मदत करे जेका पर उन्हे पुराना काल मे शासन कऱ्यो थो <char style="xt" closed="false"><ref loc="AMO 9:12">9:12</ref>.</char></para>
  <para style="iot">रुप रेखा</para>
  <para style="io1">1. पहला पद मे आमोस अपनी पैछान बतास हइ.</para>
  <para style="io1">2. फिर उ भोत राज्यहोन पर फैसलो सुनास हइ. <char style="ior"><ref loc="AMO 1:2">1:2</ref></char></para>
  <para style="io1">3. इस्राएल को न्याय अरु बंधुआइ का बारे मे बात करस हइ. <char style="ior"><ref loc="AMO 3:9-11">3:9-11</ref></char></para>
  <para style="io1">4. आखरी मे, परमेश्वर शेष विश्वासिहोन के इस्राएल मे वापस लान को वादो करस हइ. <char style="ior"><ref loc="AMO 9:12-15">9:12-15</ref> </char></para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />तकोआवासी गाव को आमोस जो मेडा-बकरिहोन खे चरानआलो मे से थो, ओको यो वचन हइ जो उ ने यहूदा को राजो उजिय्याह का, अरू योआश को बेटो इस्राएल को राजो यारोबाम का दिनहोन मे, भूकम्प से दो साल पहले, इस्राएल का बारे मे दर्शन देखीखे बोले :<verse eid="AMO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2" />“यहोवा सिय्योन से गरज्ये, अरू यरुशलेम से अपना शब्द सुनाये; तब ठाठ्यो को चराइहोन दुख करे, अरू कर्म्मेल टेकडी कि चोटी झुली जाये<note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="JOL 3:16">योएल 3:16</ref></char></note>.”<verse eid="AMO 1:2" /></para>
  <para style="s">इस्राएल का बाजुआला राज्यहोन को न्याय</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />यहोवा यो बोलस हइ : “दमिश्क का बार-बार कऱ्या अपराधहोन का कारण मी ओको दन्ड नी छोडु<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">मुल मि ओखे नी फेरु</char></note>; क्योंकि उनने गिलाद का दावनकरनआलो लोहा को अवजार से खुदी डाल्यो हइ. <verse eid="AMO 1:3" /><verse number="4" style="v" sid="AMO 1:4" />येकालिये मी हजाएल का किल्ला मे अंगार लगायु, अरू ओका से बेन्हदद को किल्ला भी भस्म हुये जाये. <verse eid="AMO 1:4" /><verse number="5" style="v" sid="AMO 1:5" />मी दमिश्क का अंदर जान का दरवाजा खे तोडी डाल्यु, अरू आवेन नामको तराइ का र्हेनआलाहोन खे अरू बेतएदेन का घर मे ऱ्हेनवालो राजा खे खतम कऱ्यु; अरू आराम का दुनीया बन्दी हुइखे कीर खे जाया, यहोवा को योही वचन हइ.”<note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="ISA 17:1-3">यशया 17:1-3</ref>; <ref loc="JER 49:23-27">यिर्मया 49:23-27</ref>; <ref loc="ZEC 9:1">जखर्या 9:1</ref></char></note><verse eid="AMO 1:5" /></para>
  <para style="s">पलिश्तिया</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6" />यहोवा यो बोलस हइ : “गाजा का बार-बार कऱ्या अपराधहोन का कारण मी ओको दन्ड नी छोड्यु<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">मुल मे, मी ओखे नी फेरु</char></note>; क्योंकि उ सब दुनीयाहोन खे बन्दी बनयखे ली गयो कि उनखे एदोम का वश मे करी दे. <verse eid="AMO 1:6" /><verse number="7" style="v" sid="AMO 1:7" />येकालिये मी गाजा बागुड मे अंगार लगायु अरू ओका से ओको किल्ला भस्म हुइ जाये. <verse eid="AMO 1:7" /><verse number="8" style="v" sid="AMO 1:8" />मी अशदोद का र्हेनआलाहोन खे अरू अश्कलोन का राजा खे भी खतम कऱ्यु; मी अपना हाथ एक्रोन का खिलाप चलायु, अरू कुछ पलिश्ती दुनीया खतम हुइ,” परमेश्वर यहोवा को यही वचन हइ.<verse eid="AMO 1:8" /></para>
  <para style="s">सोर</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />यहोवा यो बोलस हइ : “सोर का बार-बार कऱ्या अपराधहोन का कारण मी ओको दन्ड नी छोड्यु<note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">यशया 14:29-31</ref>; <ref loc="JER 47:1-7">यिर्मया 47:1-7</ref>; <ref loc="EZK 25:15-17">यहेज्केल 25:15-17</ref>; <ref loc="JOL 3:4-8">योएल 3:4-8</ref>; <ref loc="ECC 2:4-7">उपदेशक 2:4-7</ref>; <ref loc="ZEC 9:5-7">जखर्या 9:5-7</ref> </char></note>; क्योंकि उनने सब दुनीयाहोन खे बन्दी बनयखे एदोम का कुल मे करी दियो अरू भइ का सात करी वाचा को याद नी कऱ्यो. <verse eid="AMO 1:9" /><verse number="10" style="v" sid="AMO 1:10" />येकालिये मी सोर कि शहरपनाह पर अंगार लगायु, अरू ओकासे ओको किल्लो भी भस्म हुइ जाये.”<note caller="+" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">यशया 23:1-18</ref>; <ref loc="EZK 26:1-28:19">यहेज्केल 26:1—28:19</ref>; <ref loc="JOL 3:4-8">योएल 3:4-8</ref>; <ref loc="ZEC 9:1-4">जखर्या 9:1-4</ref>; <ref loc="MAT 11:21">मत्ती 11:21</ref>,<ref loc="MAT 11:22">22</ref>; <ref loc="LUK 10:13">लूका 10:13</ref>,<ref loc="LUK 10:14">14</ref> </char></note><verse eid="AMO 1:10" /></para>
  <para style="s">एदोम</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />यहोवा यो बोलस हइ : “एदोम का बार-बार कऱ्या अपराधहोन का कारण मी ओको दन्ड नी छोड्यु<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">मुल मे, मी ओके नी फेरु</char></note>; क्योंकि ओने अपना भइ खे तलवार लिये हुयो हकाले अरू कुछ भी दया न करी<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">मुल मे, अपनी दया खे बिगाडे</char></note>, पन घुस्सा से उनखे लगातार चिरतो ही ऱ्हे, अरू अपना रोष खे हमेशा का लिये बनाये ऱ्हीये. <verse eid="AMO 1:11" /><verse number="12" style="v" sid="AMO 1:12" />येकालिये मी तेमान नगर मे अंगार लगायु, अरू ओका से बोस्रा को किल्लो भस्म हुइ जाये.”<verse eid="AMO 1:12" /></para>
  <para style="s">अम्मोन</para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />यहोवा यो बोलस हइ : “अम्मोन का बार-बार कऱ्या अपराधहोन का कारण मी ओको दन्ड नी छोड्यु<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">मुल मे, मी ओखे नी फेरु</char></note> क्योंकि उनने अपनी सीमा खे बड्य लेन का लिये गिलाद इलाका कि गर्भिणा बइहोन को पेट चीरी डाले. <verse eid="AMO 1:13" /><verse number="14" style="v" sid="AMO 1:14" />येकालिये मी रब्बा कि बागुड मे अंगार लगायु, अरू ओकासे ओको किल्ला भी भस्म हुइ जाये. उ लडय का दिन मे ललकार हुये, उ हवा धुन्द वरन् भुतडा को दिन हुये; <verse eid="AMO 1:14" /><verse number="15" style="v" sid="AMO 1:15" />अरू उनको राजो अपना अधिकारीहोन सब गुलामी मे जाये,” यहोवा का उइ वचन हइ.<note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="JER 49:1-6">यिर्मया 49:1-6</ref>; <ref loc="EZK 21:28-32">यहेज्केल 21:28-32</ref>; <ref loc="EZK 25:1-7">25:1-7</ref>; <ref loc="ECC 2:8-11">उपदेशक 2:8-11</ref></char></note><verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="s">मोआब</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1" />यहोवा यो बोलस हइ : “मोआब का बार-बार कऱ्या अपराधहोन का कारण, मी ओको दन्ड नी छोड्यु<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">मुल मे, मी ओखे नी फेरु</char></note>; क्योंकि ओने एदोम का राजो का हड्डीहोन खे जलयखे राख करी दी. <verse eid="AMO 2:1" /><verse number="2" style="v" sid="AMO 2:2" />येकालिये मी मोआब मे अंगार लगायु, अरू ओकासे करिय्योत नगर को किल्लो भस्म हुइ जाये; अरू मोआब प्रदेश चिल्लाये अरू ललकारे, अरू नरसिंगो का शब्द होते-होते मरी जाये. <verse eid="AMO 2:2" /><verse number="3" style="v" sid="AMO 2:3" />मी ओका बीच मे से न्यायी शासक खे खतम कऱ्यु, अरू साथ ही साथ ओका सब अधिकारीहोन खे भी मार्यु,” यहोवा को योही वचन हइ.<note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="JER 48:1-47">यिर्मया 48:1-47</ref>; <ref loc="EZK 25:8-11">यहेज्केल 25:8-11</ref>; <ref loc="ECC 2:8-11">उपदेशक 2:8-11</ref></char></note><verse eid="AMO 2:3" /></para>
  <para style="s">यहूदा</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />यहोवा यो बोलस हइ : “यहूदा प्रदेश का बार-बार कऱ्या अपराधहोन का कारण, मी ओको दन्ड नी छोड्यु<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">मुल मे, मी ओखे नी फेरु</char></note>; क्योंकि उनने यहोवा की व्यवस्था खे नकारो जास, अरू मरा नियमहोन खे नी माने; अरू अपना झुट का देवताहोन का कारण जिनका पीछे उनका बुर्जुख चल्या था, वे भी भटकी गया हइ. <verse eid="AMO 2:4" /><verse number="5" style="v" sid="AMO 2:5" />येकालिये मी यहूदा मे अंगार लगायु, अरू ओकासे यरुशलेम को किल्ला अंगार से भस्म हुइ जाये.”<verse eid="AMO 2:5" /></para>
  <para style="s">इस्राएल को न्याय</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />यहोवा यो बोलस हइ : “इस्राएल का बार-बार कऱ्या अपराधहोन का कारण, मी ओको दन्ड नी छोड्यु<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">मुल मे, मी ओखे नी फेरु </char></note>; क्योंकि उनने निर्दोष को रुप्या का लिये अरू गरीब खे एक जोडी जूताहोन का लिये बेची डाल्यो हइ. <verse eid="AMO 2:6" /><verse number="7" style="v" sid="AMO 2:7" />वे जमिन कि धुल्लो का जसो गरीबहोन को माथो कुचली देस हइ, अरू नम्र दुनीयाहोन खे रस्ता से बाजु करी देस हइ; अरू बाप-बेटा दोय एक ही कुमारी का पास जास हइ, जेका से मरो पवित्र नाम खे अपवित्र ठहराये. <verse eid="AMO 2:7" /><verse number="8" style="v" sid="AMO 2:8" />वे हर एक वेदी का पास गिरो रख्या कपडाहोन पर सोस हइ, अरू दन्ड का रुप्या से मोल लियो हुयो दाखमधु अपना देवता कि मदिरहोन मे पी लेस हइ.<verse eid="AMO 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 2:9" />“मेने उन का सामने से एमोरीहोन खे खतम कऱ्या था, जिनकी लम्बइ देवदारहोन का जसी, अरू जिन का ताकत बांज झाडहोन का जसो थो; तेभी मेने उपर से ओका फल, अरू नीचे से ओकी जडी खतम करी.<note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="DEU 3:8-11">व्यवस्था विवरन 3:8-11</ref></char></note> <verse eid="AMO 2:9" /><verse number="10" style="v" sid="AMO 2:10" />मी तूम खे मिस्र देस से निकाली लायु, अरू बंजर प्रदेश मे चालीस साल तक का लिये फिरता ऱ्हीया, कि तूम एमोरीहोन का देस का अधिकारीहोन हुइ जाये. <verse eid="AMO 2:10" /><verse number="11" style="v" sid="AMO 2:11" />मेने तुम्हारा बेटाहोन मे से नबी होन का लिये अरू तुम्हारा कुछ जुवानहोन मे से नाजीर<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">परमेश्वर का लिये समर्पित इन्सान जो विशेष व्रत लेस, माथा का बाल नी काटे, दारु नी पी अरु मुर्दा के हात नी लगाये.</char></note> होन का लिये ठहराये.<note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="NUM 6:1-8">गिनती 6:1-8</ref></char></note> हे इस्राएलीहोन, का यो सब सच्ची नी हइ?” यहोवा कि या वाणी हइ.<verse eid="AMO 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 2:12" />पन तूम ने नाजीर होन खे दाखमधु पिलायो, अरू भविष्यव्दाक्ताहोन के आज्ञा दी कि भविष्यद्वाणी नी करे.<verse eid="AMO 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 2:13" />“देख, मी तुम खे असो दबायु, जसो गठ्ठाहोन से भरी हुइ गाडी नीचे दबय जास हइ<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">या तुम्हारा नीचे असो दबय दियु जसी गाडीहोन जो पुलहोन से भरी हुइ दबी ऱ्हेस हइ</char></note> <verse eid="AMO 2:13" /><verse number="14" style="v" sid="AMO 2:14" />येकालिये गती से दौडनआलो खे भागी जान का लिये जगा नी मिले, अरू सामर्थी को सामर्थ्य कुछ काम नि दिये; अरू न पराक्रमी अपनी जान बचा सके : <verse eid="AMO 2:14" /><verse number="15" style="v" sid="AMO 2:15" />धनुर्धारी खडो नी ऱ्ही सखे, अरू फुर्ती से भागनआलो नी बचे; सवार भी अपनी जान नी बची सखे; <verse eid="AMO 2:15" /><verse number="16" style="v" sid="AMO 2:16" />अरू योध्याहो, मे जो जादा धीर हुये, उ भी उ दिन नंगो हुइके<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">बिना हत्यार को भागी जाये</char></note> भागी जाये,” यहोवा कि या वाणी हइ.<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />हे इस्राएलीहोन, यो वचन सुनो जो यहोवा ने तुमारा बारे मे पन वे सब कुल का बारे मे बोल्यो हइ जेखे मेने मिस्र देस से लायो हइ: <verse eid="AMO 3:1" /><verse number="2" style="v" sid="AMO 3:2" />“जमिन का पुरा कुलहोन मे से मे ने फक्त तुमारा पर मन लगायो हइ, यो कारण मी तुमारा सब अपराधहोन का कामहोन को दन्ड दियु.<verse eid="AMO 3:2" /></para>
  <para style="s">भविष्यद्वक्ता का काम</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 3:3" />“यदि दो इन्सान परस्पर सहमती नी हइ; ते का वे एक सात चल सखे? <verse eid="AMO 3:3" /><verse number="4" style="v" sid="AMO 3:4" />का सेर बिना शिकार पाये जंगल मे गरजे? का जुवान सेर बिना कुछ पकडये अपनी गुफा मे से गुर्राये? <verse eid="AMO 3:4" /><verse number="5" style="v" sid="AMO 3:5" />का चिडी बिना जाल लगाये फसे? का बिना कुछ फसे जाल जमीन पर उछले? <verse eid="AMO 3:5" /><verse number="6" style="v" sid="AMO 3:6" />का कोई नगर मे नरसिंगो फुकना पर दुनीया नी कापन का? का यहोवा का बिना भेज्या कोई नगर मे कोई संकट पडे? <verse eid="AMO 3:6" /><verse number="7" style="v" sid="AMO 3:7" />यो प्रकार से प्रभु यहोवा अपना दास भविष्यद्वक्ताहोन पर अपन भेद बिना प्रगट करे कुछ भी नी करे. <verse eid="AMO 3:7" /><verse number="8" style="v" sid="AMO 3:8" />सेर गरज्यो; कोन नी डरे? परमेश्वर यहोवा बोल्यो; कौन हइ जो भविष्यद्वाणी नी करे?”<verse eid="AMO 3:8" /></para>
  <para style="s">सामरिया का विनाश</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 3:9" />अशदोद को किल्लो अरू मिस्र देस का किल्ला पर प्रचार करी खे बोल : “सामरिया कि टेकडी पर जमा हुइखे देख कि ओमे का ही बडो कोलाहल अरू ओका बीच का ही अत्याचार हुये रो हइ!” <verse eid="AMO 3:9" /><verse number="10" style="v" sid="AMO 3:10" />यहोवा कि या वाणी हइ, “जो दुनीया अपना किल्लाहोन मे उपद्रव अरू लुटपाट को धन जमा रखस हइ, वे सीधा से काम करनो जाने ही नी.” <verse eid="AMO 3:10" /><verse number="11" style="v" sid="AMO 3:11" />यो कारण परमेश्वर यहोवा यो बोलस हइ: “देस के घेरनआलो दुसमन हुये, अरू उ तरी ताकत तोडये, अरू तरो किल्लो लुटी जाये.”<verse eid="AMO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />यहोवा यो बोलस हइ: “जो भाति ठाठ्यो सेर का मुडा से दो टांगहोन या कान का एक टुकडो छुडास हइ, वोसो ही इस्राएली दुनीया, जो सामरिया मे बिछानाहोन को एक कोना या रेशमी गद्दी को एक तुगडो, वे भी छुडायो जाये.”<verse eid="AMO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13" />सेनाहोन को परमेश्वर, प्रभु यहोवा कि या वाणी हइ, “देख, अरू याकूब का घराना का खिलाप गवय दे : <verse eid="AMO 3:13" /><verse number="14" style="v" sid="AMO 3:14" />जो टेम मी इस्राएल खे ओका अपराधहोन को दन्ड दियु, उही टेम मी बेतेल कि वेदीहोन खे भी दन्ड दियु, अरू वेदी का सिंग टुटीखे जमीन पर गिरी जाये.<note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="2KI 23:15">2 राजे 23:15</ref></char></note> <verse eid="AMO 3:14" /><verse number="15" style="v" sid="AMO 3:15" />मी ठंडी का घर खे अरू धुपकाल का घर, दोय खे गिरायु; अरू हात्तीदात को बनायो घर भी खतम हुये, अरू बात घर खतम हुये जाये,” यहोवा कि या वाणी हइ.<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 4:1" />“हे सामरी राज कि धनवान बइहोन<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">हे बाशान कि गायो </char></note>, हे सामरिया टेकडी कि बइहोन योही वचन सुन, तुम जो कंगालहोन पर अत्याचार करस, अरू गरीबहोन के कुचली डालस हइ, अरू अपना अदमी खे बोलस हइ, ‘ला, ताकि हम पिह्या!’ <verse eid="AMO 4:1" /><verse number="2" style="v" sid="AMO 4:2" />परमेश्वर यहोवा अपनी पवित्रता कि कसम खय खे बोलस हइ, देख, तूम पर असो दिन आनवालो हइ, कि तूम काटा से, अरू तुमारा बच्चा मछ्छी पकडन का गल से खीची ली जाये. <verse eid="AMO 4:2" /><verse number="3" style="v" sid="AMO 4:3" />तुम मेसे हर एक दिवारहोन कि दरार मे से हुइखे सीदी निकली जाये अरू हर्म्मोन टेकडीहोन मे डाली जाये,” यहोवा का या वाणी हइ.<verse eid="AMO 4:3" /></para>
  <para style="s">इस्राएल सुधरना मे असफल</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 4:4" />“बेतेल मे अय खे गुना कर, अरू गिलगाल मे अय खे बहुत सा गुना कर; अपनो चडानो फजर खे, अरू अपनो दशमांश हर तीसरा दिन ली आया कर; <verse eid="AMO 4:4" /><verse number="5" style="v" sid="AMO 4:5" />धन्यवाद भेट खमीर मिलयखे चडा, अरू अपना स्वेच्छाभेटहोन कि चर्चा चलयखे उनको प्रचार कर; क्योंकि हे इस्राएलीहोन, असो करनो तू भास हइ,” परमेश्वर यहोवा कि या वाणी हइ.<verse eid="AMO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 4:6" />“मे ने तुमारा सब नगरहोन मे अकाल भेज्यो हइ, अरू तुमारा सब जगाहोन मे रोटी कि कमी करी हइ, तेभी तूम मरा तरप फिरी खे नी आया,” यहोवा कि या वाणी हइ.<verse eid="AMO 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 4:7" />“जब कटना का तीन महीनो ऱ्ही गया, तब मे ने तुमारा लिये पाणी नी गिरायो; मे ने एक नगर मे पानी गिरय खे दुसरा मे नी गिरायो; एक खेत मे पानी गिऱ्यो, अरू दुसरो खेत जेमे नी गिऱ्यो, उ सुखी गो. <verse eid="AMO 4:7" /><verse number="8" style="v" sid="AMO 4:8" />येकालिये दुनीया नगरहोन मे पानी पीन का लिये माऱ्या माऱ्या फिरता हुया, तेभी वे मगम नी हुया; तेभी तूम मरा तरप नी फिऱ्या,” यहोवा कि या वाणी हइ.<verse eid="AMO 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 4:9" />“मे ने तूम खे लुह अरू गेरुई किडा से माऱ्यो हइ; अरू जब तुम्हारी वाटिकाहोन अरू दाख कि बारी होन, अरू अंजीर अरू जैतून का झाड बहुत हुइ गा, तब टोटरहोन ने उनखे खय लियो; तेभी तूम मरा तरप फिरी खे नी आया,” यहोवा कि या वाणी हइ.<verse eid="AMO 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 4:10" />“मे ने तुम्हारा बीच मे मिस्र देस का जसी बडी बेमारी फैली; मे ने तुम्हारा घोडाहोन खे छुडयखे तुम्हारा जुवानहोन खे तलवार से मारी डाल्यो; अरू तुम्हारो छावनी को बुरोयगधंयरो तुम्हारा पास पहुचायो; तेभी तूम मरा तरप फिरी खे नी आया,” यहोवा कि या वाणी हइ.<verse eid="AMO 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 4:11" />“मे ने तूम मे से कोय एक खे असो उलटय दियो, जसो परमेश्वर ने सदोम अरू आमोरा खे उलटय दियो थो,<note caller="+" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="EXO 19:24">निर्गमन 19:24</ref></char></note> अरू तूम अंगार से निकाली हुइ लकडी का जसा ठहऱ्या; तेभी तुम मरा तरप फिरी खे नी आया,” यहोवा कि या वाणी हइ.<verse eid="AMO 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 4:12" />“यो कारण, हे इस्राएल, मी तरा से असो ही कऱ्यु, अरू येकालिये कि मी तरा मे यो काम करना पर हइ, हे इस्राएल, अपना परमेश्वर का सामने आन का लिये तैयार हुइ जा!”<verse eid="AMO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 4:13" />देख, टेकडाहोन खे बनानआलो अरू हवा खे बनानआलो, अरू इन्सान खे ओको मन का बिचार बतानआला अरू फजर खे अंधारो करनआला, अरू जो पृथ्वी का उची जगाहोन पर चलनआलो हइ, ओको ही नाम सेनाहोन को परमेश्वर यहोवा हइ!<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s">पछतावो करनो बुलानो</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />हे इस्राएल को घरानो, यो दु:ख का गाना का बोल सुन जो मी तुम्हारा बारे मे बोलुस हइ: <verse eid="AMO 5:1" /><verse number="2" style="v" sid="AMO 5:2" />“इस्राएल राष्ट जो कुवारी पोरइ हइ जो गिरी गइ, अरू फिर उठी नी सकी; वा अपनी ही जमीन पर पटकी दी गय हइ अरू ओखे उठानआलो कोई नी.”<verse eid="AMO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3" />क्योंकि परमेश्वर यहोवा यो बोल हइ: “जो इस्राएल नगर से हजार निकल्या था, ओमे सौ ही बच्या ऱ्हीये, अरू जो से सौ निकलता था, ओमे दस बचये ऱ्हीहे.”<verse eid="AMO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />यहोवा, इस्राएल का घराना से यो बोलस हइ: मेखे ढुडना मे लग, तब जिन्दा ऱ्हीये. <verse eid="AMO 5:4" /><verse number="5" style="v" sid="AMO 5:5" />बेतेल खे डुंडना मे नी लगनु, नी गिलगाल मे प्रवेश करनु, अरू न बेर्शेबा खे जा : क्युकी गिलगाल निश्चय गुलामी मे जाये, अरु बेतेल सुन्यो पडे.<verse eid="AMO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 5:6" />यहोवा खे डुंडनो कर, तब जिन्दो ऱ्हीये, नी ते उ यूसुफ का घरानो पर अंगार का जसो भडकखे, अरू वा ओखे भस्म करे, अरू बेतेल मे कोय ओखे बुझानआलो नी हुये. <verse eid="AMO 5:6" /><verse number="7" style="v" sid="AMO 5:7" />हे न्याय के कडु बनानआला अरु न्यायीपन खे मंट्टी मे मिलानआलो!<verse eid="AMO 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 5:8" />जो कचपचिया अरु मृगशिरा नक्षत्र खे बनानआलो हइ, जो घोर अंधारा खे फजर खे उजालो बनास हइ, जो दिन को अंधारो करिखे रात बनय देस, अरू संमुदर को पानी जमिन का उपर बोहय देस, ओको नाम यहोवा हइ.<note caller="+" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="JOB 9:9">ईयोब 9:9</ref>; <ref loc="JOB 38:31">38:31</ref></char></note> <verse eid="AMO 5:8" /><verse number="9" style="v" sid="AMO 5:9" />उ तुरुत हि ताकतवर को खतमो करि देस, अरू किल्ला को भी सत्यानास करस हइ.<verse eid="AMO 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 5:10" />जो कोरट मे सच्चो न्याय करस हइ ओका से वे बैर रखस हइ, अरू सच्ची बात बोलनवालो से गुस्सा करस हइ.<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">मुल मे, फाटक</char></note> <verse eid="AMO 5:10" /><verse number="11" style="v" sid="AMO 5:11" />तूम जो कंगालहोन खे खुदस हइ, उनका अनाज पर कर लादस हइ, येकालिये जो घर तूम ने गड्या हुया फत्तरहोन से बनाया हइ, उन मे ऱ्ही नी पाये; अरू जो मनभावनी दाख कि बारी होन तूम ने लगय हइ, उनको दाखमधु नी पी पाये. <verse eid="AMO 5:11" /><verse number="12" style="v" sid="AMO 5:12" />क्योकि मी जानुस हइ कि तुमारो अपराध भारी हइ. तूम न्यायी खे सतास अरू घूस लेस, अरू कोरट मे गरीबहोन को न्याय बिगाडस हइ. <verse eid="AMO 5:12" /><verse number="13" style="v" sid="AMO 5:13" />यो कारण जो दिमाकआलो हुये, उ असो टेम चुप ऱ्हियो, क्योंकि टेम बुरो हइ.<verse eid="AMO 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 5:14" />हे दुनीयाहोन, बुराइ खे नी, भलाइ खे ढुंड, ताकि तूम जिन्दो ऱ्हिहे; सेनाहोन को परमेश्वर यहोवा सचमुच तुमारा सात ऱ्हीये, जसा तुमने बोल्यो हइ. <verse eid="AMO 5:14" /><verse number="15" style="v" sid="AMO 5:15" />बुराइ से दुसरा अरू भलाइ से प्रिति रख, अरू कोरट मे न्याय खे स्थिर कर; का जाने सेनाहोन को परमेश्वर यहोवा यूसुफ का बच्चा हुया पर अनुग्रह करे.<verse eid="AMO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16" />यो कारण सेनाहोन को परमेश्वर, प्रभु यहोवा यो बोलस हइ: “सब चौकोहोन मे रोनो-पिटनो हुये; अरू सब सडकहोन मे दुनीया हाय, हाय, करे! वे किसानहोन खे दु:ख का लिये, अरू जो दुनीया दु:ख करना मे निपुन हइ, उनखे रोना-पिटना खे फुकारे; <verse eid="AMO 5:16" /><verse number="17" style="v" sid="AMO 5:17" />अरू सब दाख कि बारी होन मे रोनो-पिटनो हुये,” क्योंकि यहोवा यो बोलस हइ, “मी तुमारा बीच मे से हुइखे जायु.”<verse eid="AMO 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="AMO 5:18" />हाय तूम पर, जो यहोवा का दिन कि अभिलाषा करस हइ! यहोवा का दिन से तुमारो का लाभ हुये? उ तो उजारो को नी, अन्धारा को दिन हुये. <verse eid="AMO 5:18" /><verse number="19" style="v" sid="AMO 5:19" />जसो कोय सेर से भागे अरू ओखे लिछडी मिले; या घर मे अयखे दिवाल पर हाथ रखे अरू साप ओखे चाबे. <verse eid="AMO 5:19" /><verse number="20" style="v" sid="AMO 5:20" />का यो सच्ची नी हइ कि यहोवा को दिन उजार को नी, पन अन्धारा हि को हुये? हव, असो घोर अंधारा को जेमे कुछ भी चमक नी हुये.<verse eid="AMO 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="AMO 5:21" />“मी तुम्हारा तिवारहोन से बैर रखुस, अरू उनखे ठुकरास हइ, अरू तुमारी महासभाहोन से मी प्रसन्न नी.<note caller="+" style="f"><char style="fr" closed="false">5:21 </char><char style="ft" closed="false">मुल मे, मी नी सुघ्यु</char></note> <verse eid="AMO 5:21" /><verse number="22" style="v" sid="AMO 5:22" />चाहे तूम मरा लिये होमबलि अरू अन्न दान चेडा, तेभी मी प्रसन्न नी हुयु, अरू तुमारा ताजा मोटा जनवरहोन खे मेलबलिहोन का तरप नी देख्यु.<note caller="+" style="x"><char style="xo" closed="false">5:22 </char><char style="xt" closed="false"><ref loc="ISA 1:11-14">यशया 1:11-14</ref></char></note> <verse eid="AMO 5:22" /><verse number="23" style="v" sid="AMO 5:23" />अपना गाना को सोर मरा से दूर कर; तुमारी सारंगीहोन को सुर मी नी सुनायु. <verse eid="AMO 5:23" /><verse number="24" style="v" sid="AMO 5:24" />पन न्याय खे नद्दी का जसो, अरू हमेशा बोहान वाली नद्दी का जसो दे.<verse eid="AMO 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="AMO 5:25" />“हे इस्राएल को घरानो, तूम सुनसान जगा मे चालीस साल तक जनवरबलि अरू अन्न दान का मेखे ही चडातो ऱ्हीये? <verse eid="AMO 5:25" /><verse number="26" style="v" sid="AMO 5:26" />तूम तो अपना राजा को मंडो, अरू अपनी मुर्तीहोन कि चौरंग, अरू अपना देवता का तारा लिये फिरता ऱ्हीये. <verse eid="AMO 5:26" /><verse number="27" style="v" sid="AMO 5:27" />यो कारण मी तूम खे दमिश्क का वा पार गुलामी मे करी दियु, सेनाहोन का परमेश्वर यहोवा का योही वचन हइ.<note caller="+" style="x"><char style="xo" closed="false">5:27 </char><char style="xt" closed="false"><ref loc="ACT 7:42">प्रेरित 7:42</ref></char></note><verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s">इस्राएल को नास</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 6:1" />“हाय उनका पर जो सिय्योन मे निश्चिन्त र्हेस हइ, अरू उनका पर जो सामरिया कि टेकडी पर सुरशित र्हेस हइ, वे जो बडी राष्ट मे प्रसिद्ध हइ, जिनका पास इस्राएल को घरानो आस हइ! <verse eid="AMO 6:1" /><verse number="2" style="v" sid="AMO 6:2" />कलनो नगर खे जयखे देख, अरू व्हा से हमात नामको बडा नगर खे जा; फिर पलिश्तिहोन का गत नगर खे जा. का ये राज्य हमारा दो राज्यहोन से अच्छा हइ? का उनकि सीमा तुमारी सीमा से बडी हइ का? <verse eid="AMO 6:2" /><verse number="3" style="v" sid="AMO 6:3" />तूम बुरा दिन खे दूर करी देस, अरू उपद्रव की गद्दी खे नजिक लिखे आस हइ.<verse eid="AMO 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 6:4" />“तूम हत्ती दात का पलंगहोन पर सोस हइ, अरू अपना अपना बिछानाहोन पर पाय फैलय सोस हइ, तुम मन पंसद मेडा अरु ताजा मोटा जुवान बैल के खास हइ. <verse eid="AMO 6:4" /><verse number="5" style="v" sid="AMO 6:5" />तूम सारंगी का साथ गानो गास, अरू दाउद का जसो भाति भाति का बाजा को आवाज निकालस हइ; <verse eid="AMO 6:5" /><verse number="6" style="v" sid="AMO 6:6" />अरू कटोरा मे से दाखमधु पिस, अरू अच्छो अच्छो तेल लगास हइ, पन यूसुफ पर आनवाली विपत्ति को हाल सुनीखे शोकित नी होय! <verse eid="AMO 6:6" /><verse number="7" style="v" sid="AMO 6:7" />येका कारण तुम अपना देश से पहले निकाली दियो जाये, अरू जो पाय फैलाया सोता था, उनकी विलासिता जाती ऱ्हीये.”<verse eid="AMO 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8" />परमेश्वर यहोवा ने अपनी ही कसम खय खे बोल्यो हइ: “जेका पर याकूब घमण्ड करस हइ, ओका से मी गुस्सा, अरू ओका किल्लाहोन से दुसरा रखस हइ; अरू मी यो नगर खे उ सब समेत जो ओमे हइ, दुसमन का काबु मे करी दियु.”<verse eid="AMO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />अगर कोय घर मे दस अदमी बच्या ऱ्हीये, तेभी वे मरी जाये. <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />जब कोय को काको, जो ओको जलानआलो हुये, ओकी हड्डीहोन का घर से निकालन का लिये उठाये, अरू जो घर का कोना मे हुये ओका से बोले, “का तरा पास कोई अरु हइ?” तब उ बोले, “कोई नी;” तब उ बोले, “चुप ऱ्ही! हमखे यहोवा को नाम नी लेनु चाहे.”<verse eid="AMO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 6:11" />क्योंकि यहोवा कि आज्ञा से बडा घर का तुकडा तुकडा, अरू छोटा घर मे फुट हुये. <verse eid="AMO 6:11" /><verse number="12" style="v" sid="AMO 6:12" />का घोडा टेकडी पर भागे? का कोई असी जगा मे गाय-बैल से जोत्ये जहा तूम दुनीयाहोन ने न्याय खे जहर मे, अरू अच्छा फल खे कडवा फल मे बदल डाल्यो हइ? <verse eid="AMO 6:12" /><verse number="13" style="v" sid="AMO 6:13" />तूम असा चिज का कारण खुशी करस हुये जो बेकार हइ; अरू बोलस हइ, “का हम अपनी ही यत्न से करनइम नगर जीत्यो?” <verse eid="AMO 6:13" /><verse number="14" style="v" sid="AMO 6:14" />यो कारण सेनाहोन का परमेश्वर यहोवा कि या वाणी हइ, “हे इस्राएल को घरानो, देख, मि तुम्हारा खिलाप एक असो राष्ट खडो कऱ्यु, जो हमात कि गुलय से लिखे अराबा कि नद्दी तक तूम खे परेशानि मे डाल्ये.”<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s">विनाश का तीन दर्शन</para>
  <para style="s2">टोटरहोन</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />परमेश्वर यहोवा ने मेखे यो बतायो अरू मी का देखुस हइ कि ओने पिछली घास का उगन का सुरु मे टोटरहोन पैदा करी; अरू उ राजा को पिक काटन का बाद की पिछली घास थी. <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />जब वे जमिन का सब घास खय चुकी, तब मे ने बोल्यो, “हे परमेश्वर यहोवा, माफ कर! नी ते याकूब कसो स्थिर ऱ्ही सखे? उ भोत छोटो हइ!” <verse eid="AMO 7:2" /><verse number="3" style="v" sid="AMO 7:3" />येका बारे मे यहोवा ने मन बदल्यो, अरू ओने बोल्यो, “असी बात अब नी हुये.”<verse eid="AMO 7:3" /></para>
  <para style="s">अंगार</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />परमेश्वर यहोवा ने मेखे यो बतायो अरू का देखुस हइ कि परमेश्वर यहोवा ने अंगार का वजेसे मुकद्दमा लड़न खे बुलायो, अरु अंगार से महासागर सुखी गयो, अरू जमिन भी भस्म होन लगी थी. <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />तब मे ने बोल्यो, “हे परमेश्वर यहोवा, रुखी जा! नी ते याकूब कसो स्थिर ऱ्ही सखे? उ भोत छोटो हइ.” <verse eid="AMO 7:5" /><verse number="6" style="v" sid="AMO 7:6" />येका बारे मे भी यहोवा पछतायो; अरू परमेश्वर यहोवा ने बोल्यो, “असी बात फिर नी हुये.”<verse eid="AMO 7:6" /></para>
  <para style="s">गोलो</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />ओने मेखे यो भी बतायो मे ने देख्यो कि प्रभु गोलो लगइखे बनय हुइ कोई दिवाल पर खडो हइ, अरू ओका हाथ मे गोलो हइ. <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />यहोवा ने मरा से बोल्यो, “हे आमोस, तोखे का देख्ये पड़स हइ?” मे ने बोल्यो, “एक गोलो.” तब परमेश्वर ने बोल्यो, “देख, मी अपनी जनंता इस्राएल का बीच मे गोलो लगायु. अब मी उनके बिना दण्ड दिये नी छोडु. <verse eid="AMO 7:8" /><verse number="9" style="v" sid="AMO 7:9" />इसहाक कि उची जगा उजाडी जाये, अरू इस्राएल कि पवित्रजगा खण्डर बनी जाये, अरू मी यारोबाम का घराना पर तलवार खीची हुइ चडय कऱ्यु.”<verse eid="AMO 7:9" /></para>
  <para style="s">आमोस अरू अमस्याह</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />तब बेतेल का याजक अमस्याह ने इस्राएल का राजा यारोबाम का पास बुलावो भेज्यो, “आमोस ने इस्राएल का घराना का बीच मे तरा से षडयन्त्र कि बात बोली हइ; ओका पुरो वचनहोन खे देस नी सय सक्यो. <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />क्योंकि आमोस यो बोलस हइ, ‘यारोबाम तलवार से माऱ्यो जाये, अरू इस्राएल का दुनियाहोन के अपना देश से बंन्दी बनयके निकाली दियो जाये.’” <verse eid="AMO 7:11" /><verse number="12" style="v" sid="AMO 7:12" />तब अमस्याह ने आमोस से बोल्यो, “हे दर्शन देखनआला, यहा से निकली खे यहुदा देश मे भागी जा, अरु वही रोटी खय खे, अरू वही भविष्यव्दाणी कऱ्यो करे; <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />पन बेतेल मे फिर कभी भविष्यव्दाणी नी करनु, क्युकी यो राजा को पवित्रजगा अरु राज-नगर हइ.” <verse eid="AMO 7:13" /><verse number="14" style="v" sid="AMO 7:14" />आमोस ने उत्तर दिखे अमस्याह से बोल्यो, “मी नी ते भविष्यद्वक्ता थो, अरू नी भविष्यद्वक्ता को बेटो; मी तो ठाठ्यो, अरू गुलेर का झाडहोन खे छाटनआलो थो, <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />अरू यहोवा ने मेखे मेडा-बकरिहोन का पीछे पीछे घुमना से बुलय खे बोल्यो, ‘जा, मरी जनंता इस्राएल से भविष्यद्वाणी कर.’ <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />येकालिये अब तू यहोवा को वचन सुन, तू बोलस हइ, ‘इस्राएल का खिलाप भविष्यवाणी मत कर; अरू इसहाक का घराना का खिलाप बार बार वचन मत सुना<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">मुल मे, हाहाकार करे</char></note>.’ <verse eid="AMO 7:16" /><verse number="17" style="v" sid="AMO 7:17" />येका कारण यहोवा यो बोलस हइ : ‘तरी बय नगर मे वेश्या हुये जाये, अरू तरा बेटा-बेटीहोन तलवार से माऱ्या जाये, अरू तरी जमीन रस्सी डालीखे बाटी ली जाये; अरू तू खुद अशुध्द देस मे मारे, अरु इस्राएल का दुनियाहोन के अपना देश से बंन्दी बनयके निकाली दियो जाये.’ ”<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s">फलहोन से भरी हुइ टोपली को दर्शन</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />परमेश्वर यहोवा ने मेखे यो बतायो कि धुपकाला का फलहोन से भरी हुइ एक टोपली हइ. <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />ओने बोल्यो, “हे आमोस, तोखे का देख पड़स हइ?” मेने बोल्यो, “धुपकाला का फलहोन से भरी हुइ एक टोपली.” तब यहोवा ने मरा से बोल्यो, “मरी जनंता इस्राएल को नास अय गा हइ; मी अब ओखे अरू नी छोड्यु.” <verse eid="AMO 8:2" /><verse number="3" style="v" sid="AMO 8:3" />परमेश्वर यहोवा की वाणी हइ, “उ दिन मन्दिर का गाना हाहाकार<note caller="+" style="f"><char style="fr" closed="false">8:3 </char><char style="ft" closed="false">मुल मे, हाहाकार करे</char></note> मे बदली जाये, अरू लासहोन को बडो ढेर लगे; अरू सब जगाहोन मे वे चुपचाप फेकी दिये जाये.”<verse eid="AMO 8:3" /></para>
  <para style="s">इस्राएल का पतन</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 8:4" />यो सुन, तूम जो गरीबहोन खे खुन्दनो अरू देस का दु:खी दुनीयाहोन खे खतम करनो चास हइ, <verse eid="AMO 8:4" /><verse number="5" style="v" sid="AMO 8:5" />जो बोलस हइ, “नवो चांद कब बीते कि हम अनाज बेची सखे? आराम दिन कब बीते, जेका से हम गहु बेचन के लय सके हम तराजु अरु गोटा<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">एपा </char></note> के असो बनय दिये कि दुनिया के बुद्दु बनय दिये, <verse eid="AMO 8:5" /><verse number="6" style="v" sid="AMO 8:6" />कि हम कंगालहोन खे रुप्या दिखे, अरू गरीबहोन खे एक जोडी जूताहोन कि किंमत मे मोल लिये, अरू खराब अनाज बेचे?”<verse eid="AMO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7" />यहोवा, जेका पर याकूब खे घमण्ड, यही अपनी कसम खायखे बोलस हइ, “मी तुम्हारा कोय काम खे कभी नी भुल्यु. <verse eid="AMO 8:7" /><verse number="8" style="v" sid="AMO 8:8" />का यो कारण जमीन नी कापे? का उनका पर का सब रेनआलो दु:ख नी करे? यो देस सब का सब मिस्र कि नील नद्दी का जसी हुये, जो उभलस हइ, अरू कम हुइ जास हइ.”<verse eid="AMO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9" />परमेश्वर यहोवा कि या वाणी हइ, “यो टेम मी सुरज खे दुपार का टेम डुबय दियु, अरू यो देस खे दिनदहाडे अन्धारो करी दियु. <verse eid="AMO 8:9" /><verse number="10" style="v" sid="AMO 8:10" />मी तुम्हारा तिवारहोन का उत्सव खे दूर करीखे दु:ख करायु, अरू तुमारा सब गाना खे दूर करीखे दु:ख का गाना गायु; मी तुम सब के दु:ख का कपडा पेनायु, अरू तूम सब का माथाहोन खे मुड्यु, अरू असो दु:ख करायु जसो एकलौता का लिये होस हइ, अरू ओको खातमो कठिन दु:ख का दिन का जसो हुये<note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="ft" closed="false">मुल मे, कडु दिन</char></note>.”<verse eid="AMO 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 8:11" />परमेश्वर यहोवा कि या वाणी हइ, “देख, असा दिन अय रा हइ, जब मी यो देस मे अकाल भेज्यु; दुनिया भुका हुइ पन अनाज का लिये नी, प्यासा हुये पन पानी का लिये नी पन यहोवा का वचनहोन खे भुख प्यास हुये <verse eid="AMO 8:11" /><verse number="12" style="v" sid="AMO 8:12" />दुनीया यहोवा का वचन खे डुंडना मे संमुद्र से संमुद्र तक अरु उत्तर से पुरब तक माऱ्या माऱ्या फिरे, पन ओखे मिल्यो नी.<verse eid="AMO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 8:13" />“वा टेम खुबसुरत पोरयहोन अरू जुवान अदमीहोन दोय प्यास का मारे बेहोस हुइ जाये. <verse eid="AMO 8:13" /><verse number="14" style="v" sid="AMO 8:14" />जो दुनीया सामरिया, दान अरु बेर्शेबा का देवता कि कसम खास हुये, वे सब गिरी पडे, अरू फिर नी उठे.”<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s">परमेश्वर को न्याय</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />मे ने प्रभु के वेदी का उपर खडो देख्यो, अरू ओने बोल्यो: “खम्भा कि चोटी पर मार जेकासे डेवढिहोन हिले, अरू उनखे सब दुनीयाहोन का माथा पर गिरय खे तुकडा तुकडा करे; अरू जो खतम होना से बच्या, उनखे मी तलवार से घात कर्यु; उनका मे से एक भी नी भाग निकले, अरू जो अपना खे बचाये, उ बच्यो नी पाये.<verse eid="AMO 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 9:2" />“क्युकी चाहे वे खोदीखे अधोलोक मे उतरी जाये, ते वहा से मी हात बडय खे उनखे लायु; चाहे वे आकाश मे चेडी जाये, ते वहा से मी उनखे उतारी लायु. <verse eid="AMO 9:2" /><verse number="3" style="v" sid="AMO 9:3" />चाहे वे कर्म्मेल टेकडी कि चुठ्ठी मे लुकी जाये, पन वे भी मी उनखे ढुंडी-ढुंडी खे पकडी लियु, अरू चाहे वे संमुद्र का थाह मे मरी नजर से ओट हुये, वे भी मी साप खे उनखे चाबन कि आज्ञा दियु. <verse eid="AMO 9:3" /><verse number="4" style="v" sid="AMO 9:4" />चाहे दुसमन उनखे पकडी के गुलामी मे ली जाये, वे भी मी आज्ञा दिखे तलवार से उनखे घात करायु; अरू मी उनका पर भलाइ करन का लिये नी, बुरय ही करन का लिये नजर कऱ्यु.”<verse eid="AMO 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 9:5" />सेनाहोन को परमेश्वर यहोवा खे स्पर्श करना से पृथ्वी पिघला हइ, अरू ओका पुरा रेनआलो दु:ख करस हइ; अरू वे सब का सब मिस्र कि नील नद्दी का जसा हुये जाये, जो उभलस हइ, अरू कम हुये जास हइ. <verse eid="AMO 9:5" /><verse number="6" style="v" sid="AMO 9:6" />जो आकाश मे अपनो घर बनास, अरू अपनी आकाश मंडल को पय्यो पृथ्वी पर डालस, अरू संमुद्र का पानी के आज्ञा दिके जमिन पर बोहय देस हइ, यो कोय नाम यहोवा हइ.<verse eid="AMO 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 9:7" />“हे इस्राएलीहोन,” यहोवा कि या वाणी हइ, “का तू मरा लिये कूशीहोन का जसो नहीं हुये? का मी इस्राएल खे मिस्र देस से अरू पलिश्तिहोन खे कप्तोर से नी निकाली लायो? अरू अराम होन खे कीर से नी लायो? <verse eid="AMO 9:7" /><verse number="8" style="v" sid="AMO 9:8" />देख, प्रभु यहोवा की नजर या पापमय राज्य पर लगी हइ, अरू मी येखे जमिन पर से खतम कऱ्यु; तेभी मी पूरी रिती से याकूब का घराना खे पुरी तराह खतम नी कऱ्यु,” यहोवा कि या वाणी हइ.<verse eid="AMO 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 9:9" />मरी आज्ञा से इस्राएल को घरानो सब राष्ट होन मे असो छान्यो जाये जसो अनाज चालनी मे छान्यो जास हइ, पन ओको एक भी पुष्ट दानो जमीन पर नी गिरे. <verse eid="AMO 9:9" /><verse number="10" style="v" sid="AMO 9:10" />मरी जनंता मे का सब पापी जो बोलस हइ, वा विपत्ति हम पर नी गिरे, अरू नी हमखे घेरे, वे सब तलवार से माऱ्यु जाये.<verse eid="AMO 9:10" /></para>
  <para style="s">इस्राएल का फिर से र्निमाण</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11" />“उ टेम मी दाउद कि गिरी हुये झोपडी खे खडो कऱ्यु, अरू ओका दिवार कि दरार खे सुधाऱ्यु, अरू ओका खण्डहरहोन खे फिर बनायु, अरू जसो उ प्रचिनकाल ने थो, ओखे असो ही बनय दियु; <verse eid="AMO 9:11" /><verse number="12" style="v" sid="AMO 9:12" />जेकासे वे बच्या हुया एदोमिहोन खे वरन् सब राष्ट होन खे जो मरा बोलस हइ, अपना अधिकार मे ले,” यहोवा जो यो काम पूरो करस हइ, ओकि या वाणी हइ.<note caller="+" style="x"><char style="xo" closed="false">9:12 </char><char style="xt" closed="false"><ref loc="ACT 15:16-18">प्रेरित 15:16-18</ref></char></note> <verse eid="AMO 9:12" /><verse number="13" style="v" sid="AMO 9:13" />यहोवा कि या भी वाणी हइ, “देख, असा दिन आस हइ, कि नागर जोतनआलो काटनवाला को अरू दाख खुदनवाला बीज बोनवाला का पास से आगे निकली जाये; अरू टेकडी से नयो दाखमधु टपकन लगे, अरू सब टेकडीहोन डुबी जाये. <verse eid="AMO 9:13" /><verse number="14" style="v" sid="AMO 9:14" />मी अपनी जनंता इस्राएल का बन्दीहोन खे वापस लिखे आयु, अरू व उजड्या हुया नगरहोन खे फिर से बनय के उन मे बसे; वे दाख कि बारी होन लगयखे दाखमधु पिह्ये, अरू बगीचो लगयखे उनका फल खाये. <verse eid="AMO 9:14" /><verse number="15" style="v" sid="AMO 9:15" />मी उनखे, उनकी जमिन पर मी बोयु, अरू वे अपनी जमीन मे से जो मे ने उनखे दि हइ, फिर कभी उखाड्या नी जाये,” तुमारा परमेश्वर यहोवा को यो वचन हइ.<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>