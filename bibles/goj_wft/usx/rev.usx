<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Gowlan</book>
  <para style="h">प्रक्याशितवाक्य</para>
  <para style="toc3">प्रकाशन</para>
  <para style="toc2">प्रकाशन</para>
  <para style="toc1">यूहन्ना खे मील्यो हुयो प्रक्याशितवाक्य</para>
  <para style="mt2">यहून्ना को मीला हुयो प्रक्याशि वाक्य</para>
  <para style="mt1">यहून्ना खे मील्यो हुयो प्रक्याशि वाक्य</para>
  <para style="imt">पैछान</para>
  <para style="ip">प्रकाशितवाक्य की या किताब नवा नीयम कि आखरी किताब हइ. ओसीय वा आखरी मे लिखनामे अय प्रेषित यहुन्ना ने यीशु मसीह का जन्म का बाद उ. स. वी 95 का नजीक पास वा लिखनामे अय <char style="xt"><ref loc="JHN 1:1">यहून्ना 1:1</ref></char> अरु उनने यूहन्‍ना कृत सुसमाचार अरु यहून्ना की पयली, दुसरी अरु तीसरी चिट्ठी लिखि ह्या यहून्ना का दुन्या “यीशु की जेका पर प्रिती होस” हुये करी खे पैछानस हइ <char style="xt"><ref loc="JHN 13:23">यहून्ना 13:23</ref> </char> यीशु मसीह कि खबर का वजेसे पवित्रआत्मा नाम बेटा पर जब शिक्षा भोगतो हुये वाटेम मे ओने या किताब लिखी <char style="xt"><ref loc="EXO 1:9">निर्गमन 1:9</ref> </char></para>
  <para style="ip">या किताब लिखना का पिच्छे यहून्ना को उद्देश होतो कि मरा पलनआला यीशु, अविश्वासी र्‍हेन, लिये प्रोत्साहन द्वारा अरु यीशु खे डबल आनो नजीक र्‍हेन का लिये ओका पास आस नीर्माण करणू <char style="xt"><ref loc="REV 1:3-22:7">1:3—22:7</ref> </char> ओने सब विश्वास करण या चिट्ठी लिखन पन खास करीखे वे सात मंडली लिखी जेको उल्लेख अध्याय दो अरु तिन मे मीलस हइ. 2:3 यहून्ना खुद कि लिखावट खे परमेश्वर का तरप से आयो हुयो खबर की भविष्यवानी असी बतास हइ अरु जो बात वा बात कि वर्णन वह अलंकारीक भाषा मे लिखस हइ. या जो किताब हइ या जुन्ना नीयम का कुछ मीलतो जुलतो विशेषता <char style="xt"><ref loc="ZEC 6:1-8">जखर्या 6:1-8</ref></char> ये आयात से उनका जसा हइ वसो सात तुतारी सात कटोरी ह्या परमेश्वर मिस्र पर लयआली पिडा की जसी हइ, <char style="xt"><ref loc="EXO 7:9">निर्गमन 7:9</ref> </char> प्रकाशितवाक्य आखरी का दिनहोन को वर्णन करते. आखरी यीशु विजय कसो हुये अरु उनको विश्वास रखन आलो उनका सात कसा जिन्दा र्‍हिये असो वे बोलस हय या किताब होन तुमखे चेतावनी मील्हे अरु यीशु खे फिर से आन का बारे मे तुमखे आस मील्हे</para>
  <para style="iot">रुप रेखा</para>
  <para style="io1">1. यहून्ना सुर्वात मे खुद कि पछान करीखे उनको भविष्य वाणी कसी मील्हे हइ या बतय खे सुरवात करस हइ. <char style="ior"><ref loc="REV 1:1-20">1:1—1:20</ref></char></para>
  <para style="io1">2. यीशु, तरप से सात मंडली खे प्रत्येक्ष मील्यो हुयी खबर यहून्ना देस हइ. <char style="ior"><ref loc="REV 1:1-3:22">1:1—3:22</ref> </char></para>
  <para style="io1">3. फिर वहा सात सिक्का, को उल्लेख करतो हइ.<char style="ior"><ref loc="REV 4:1-11:19">4:1—11:19</ref> </char></para>
  <para style="io1">4. येका लिये यहून्ना एक छोटा बच्चा सात माथा आला साप से कसो लडय करस हइ ह्या बतास हइ. <char style="ior"><ref loc="REV 12:1-14:20">12:1—14:20</ref></char></para>
  <para style="io1">5. येका बाद यहून्ना घुस्सा को कटोरा बाद यहून्ना, बारे मे लिख्यो हइ. <char style="ior"><ref loc="REV 15:1-16:18">15:1—16:18</ref> </char></para>
  <para style="io1">6. येका बाद परमेश्वर उनका बद्दल को दुश्मन पर कसो विजय मीलस हइ या बात हइ <char style="ior"><ref loc="REV 17:1-20:15">17:1—20:15</ref> </char></para>
  <para style="io1">7. जो नवो स्वर्ग अरु पृथ्वी आखरी मे आह्ये ओको वर्णन करस हइ <char style="ior"><ref loc="REV 21:1-22:21">21:1—22:21</ref> </char></para>
  <chapter number="1" style="c" sid="REV 1" />
  <para style="s">अभिनंदन</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1" />यीशु मसीह को प्रकाशन जो वोखे परमेश्वर ने येका लिये दियो कि अपनो सेवकहोन खे वे बात खे जेको तुरुत होनु जरुरती हइ दिखाये अरु वोने अपनो स्वर्ग दूतखे भेजीखे वो का वजेसे अपनो दास यहून्ना खे बतायो. <verse eid="REV 1:1" /><verse number="2" style="v" sid="REV 1:2" />यहुन्ना ने परमेश्वर को वचन अरु यीशु मसीह की गवय खे अगर जो कुछ ओने देख्यो थो ओकी गवइ दी. <verse eid="REV 1:2" /><verse number="3" style="v" sid="REV 1:3" />धन्य हइ वु जो या किताब, खे पडस हइ कि धन्य हइ भविष्यवाणी का वचन खे सुनस हइ कि अरु जो लिखस हइ अरु ओका जसो चलास हइ सुनस हइ क्युकि या सब बात घटित होन को टेम नजीक हइ.<verse eid="REV 1:3" /></para>
  <para style="s">सात मंडलीहोन को अभिवादन</para>
  <para style="p">
    <verse number="4" style="v" sid="REV 1:4" />यहून्ना का तरप से का खे देस का सात मंडलीहोन को नाम उ परमेश्वर का तरप से जो हइ, अरु जो थो अरु जो आनवालो हइ</para>
  <para style="p" vid="REV 1:4">अरु वे सात आत्माहोन का तरप से जो वोको राजगद्दी का सामने हइ<note caller="+" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="EXO 3:14">निर्गमन 3:14</ref>; <ref loc="REV 4:5">प्रकाशन 4:5</ref></char></note>, <verse eid="REV 1:4" /><verse number="5" style="v" sid="REV 1:5" />अरु यीशु मसीह का तरप से जो विश्वासयोग्य गवाह अरु मऱ्यो हुया मे से जिन्दो उठनआला मे पयलो अरु जमीन को राजाहोन को अधिकारी हइ, तुमखे अनुग्रह अरु शांती मीलती ऱ्हे. जो हमारा से प्यार से रखस हइ, अरु जेने अपना खुन का वजेसे हम पाप से छुडायो हइ<note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="PSA 55:4">भजन संहिता 55:4</ref> </char></note>, <verse eid="REV 1:5" /><verse number="6" style="v" sid="REV 1:6" />अरु हम एक राज अरु अपना बाप परमेश्वर का लिये याजक भी बनय दियो. यीशु मसीह अरु प्राक्रम पिडमपिडि ऱ्हिये. आमीन<note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="EXO 19:6">निर्गमन 19:6</ref>; <ref loc="REV 5:10">प्रकाशन 5:10</ref></char></note>.<verse eid="REV 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7" />देख, वु बद्दल का साथ आनवालो हइ, अरु हर एक आख वोखे देख्ये का क्युकी जिनने वोखे गड्यो थो वे भी वोखे देख्ये का अरु जमीन का सब दुन्या वोखे करन छाती ठोक्हे हुये<note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="DAN 7:13">दानिएल 7:13</ref>; <ref loc="MAT 24:30">मत्ती 24:30</ref>; <ref loc="MRK 13:26">मरकुस 13:26</ref>; <ref loc="LUK 21:27">लूका 21:27</ref>; <ref loc="1TH 4:17">1 थिस्‍सलुनीकियों 4:17</ref></char></note>. आमीन. <verse eid="REV 1:7" /><verse number="8" style="v" sid="REV 1:8" />“प्रभु परमेश्वर,” जो हइ अरु जो थो अरु जो आनवालो हइ, जो सर्व शक्तिमान हइ, ह्या बोल्योस हइ, मी ही पयलो अरु आखरी हय<note caller="+" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="REV 22:13">प्रकाशन 22:13</ref>; <ref loc="EXO 3:14">निर्गमन 3:14</ref> </char></note>.<verse eid="REV 1:8" /></para>
  <para style="s">यहून्ना खे मसीह को दर्शन</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9" />मी यहून्ना, को जो तुमारो भैइ अरु बहीन यीशु को बडो दुख अरु राज अरु रुखना मे तुमारो सात हय, परमेश्वर को वचन अरु यीशु की गवय कारन पतमेस नामको टेकडो मे थो. <verse eid="REV 1:9" /><verse number="10" style="v" sid="REV 1:10" />मी प्रभु को दिन आत्मा मे अय गयो, अरु अपना पिछे पिपडी का जसो बडो अवाज यो बोलते सुन्यो, <verse eid="REV 1:10" /><verse number="11" style="v" sid="REV 1:11" />“जो कुछ तु देखस हइ वोखे किताब मे लिखीखे साथ मंडलीहोन का पास भेजी दे, अगर इफिसुस अरु स्मुरना, अरु पिरगमुन, अरु थुआतीरा, अरु सरदीस, अरु फिलदिलफिया, अरु लौदिकिया खे.” <figure style="fig" alt="Map of seven churches in Asia" file="HK00378C.tif" size="span" copy="Horace Knowles ©" ref="1:11">एशिया मे सात मंडली को नकाशो</figure><verse eid="REV 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12" />तब मे ने वोखे, जो मरासे बोली रो थो, देखन का लिये अपनो मुडो फिरायो अरु पिछे घुमीखे मे ने सोना का साथ दिव्वा को वोडो देख्यो, <verse eid="REV 1:12" /><verse number="13" style="v" sid="REV 1:13" />अरु वे दिव्वा को वोका बिच मे इन्सान को बेटो सदृश एक इन्सान खे देख्यो, जो पाय तक का कपडा पेन्या अरु छाती पर सोन्ना को पट्टो बांधी खे हुयो थो<note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="DAN 7:13">दानिएल 7:13</ref>; <ref loc="DAN 10:5">10:5</ref> </char></note>. <verse eid="REV 1:13" /><verse number="14" style="v" sid="REV 1:14" />वोका माथो अरु बाल उजरा बाल अरु पाला का जसा उजालो थो, अरु वोकी आख अंगार का भडकती अंगार का जसी चमकती थी<note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="DAN 7:9">दानिएल 7:9</ref></char></note>. <verse eid="REV 1:14" /><verse number="15" style="v" sid="REV 1:15" />वोको पाय अच्छो पीतल का जसो थो, जो मान भट्टी मे तपायो गयोस हय, अरु वोको बात खुप पाणी का बात का जसो थो<note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="DAN 10:6">दानिएल 10:6</ref>; <ref loc="EXO 1-24">निर्गमन 1—24</ref> </char></note>. <verse eid="REV 1:15" /><verse number="16" style="v" sid="REV 1:16" />उ अपना जवना हात मे सात तारा लिये हुयो थो, अरु वोका मुडा से धार दोधारी तलवार नीकालती थी. वोको मेडो भर धुपार मे नीकल्यो हुयो सुरज का जसो चमकतो थो. <verse eid="REV 1:16" /><verse number="17" style="v" sid="REV 1:17" />जब मे ने वोखे देख्यो ते वोको पाय पर मुद का जसो गिरी गयो. वोने मरा पर “अपनो जवनो हात रखी खे बोल्यो, मत डरे. मी पयलो अरु आखरी हय<note caller="+" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="PSA 44:6-48:12">भजन संहिता 44:6—48:12</ref>; <ref loc="EXO 22:13">निर्गमन 22:13</ref></char></note>. <verse eid="REV 1:17" /><verse number="18" style="v" sid="REV 1:18" />मी जिन्दो हय मी मरी गयो थो, अरु आप देख मी हमेशा हमेशा जिनदो हय; अरु मऱ्यो पर अरु मरन का सब जगत पर मरो अधिकार हइ. <verse eid="REV 1:18" /><verse number="19" style="v" sid="REV 1:19" />येका लिये जो बात तो ने देखी हइ अरु जो बात हुय री हइ अरु जो बात येका बाद होनआली हइ, वे सब खे लिखी ले. <verse eid="REV 1:19" /><verse number="20" style="v" sid="REV 1:20" />अगर वे सात तारा को भेद जेने तो ने मरा जवना हात मे देख्यो थो, अरु वे सात सोन्ना को गुच्छो को भेद: वे सात तारा सात मंडलीहोन का दूत हइ, अरु वे सात दिव्वा को वोडो सात मंडली हइ.<verse eid="REV 1:20" /></para>
  <chapter eid="REV 1" />
  <chapter number="2" style="c" sid="REV 2" />
  <para style="s">इफिसुस खे खबर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1" />“इफिसुस कि मंडलीहोन को दूतखे यो लिख्यो:</para>
  <para style="p" vid="REV 2:1">“जो सात तारा अपना जवना हात मे लिये हुयो हइ,</para>
  <para style="p" vid="REV 2:1">“अरु सोन्ना की सात दिव्वा का वोडा का बिच मे फिरस हइ, व्हा यो बोलस हइ कि. <verse eid="REV 2:1" /><verse number="2" style="v" sid="REV 2:2" />जो तोने कर्‍यो, अरु तरो मेहनत खे अरु तरा रुखना खे समजस हय. अरु यो भी कि तू बुरा दुन्या खे देख्ये नी सकस, अरु जो अपना आप खे प्रेरित बोलस हइ, अरु नी वोखे तो ने ढुडीखे झुट्टी मील्यो. <verse eid="REV 2:2" /><verse number="3" style="v" sid="REV 2:3" />तू धिर धरस हइ, अरु मरा नाम का लिये दुख उठाते उठाते थक्यो नी. <verse eid="REV 2:3" /><verse number="4" style="v" sid="REV 2:4" />पन मेखे तरा खिलाप यो बोलनो हइ कि तो ने अपनो पैयले जसो प्यार छोडी दियो हइ. <verse eid="REV 2:4" /><verse number="5" style="v" sid="REV 2:5" />येका लिये याद कर कि तू खा से गिर्योस हइ अरु पाप से नी मन फिरायो ते मी तरा नजीक अयखे तरो दिव्वा को वोडा खे ओकी रस्ता से बाजु करी दिह्यु. <verse eid="REV 2:5" /><verse number="6" style="v" sid="REV 2:6" />पन ह्या, तरा मे या बात तो हइ कि तू नीकुलइयों को काम से जलन करस हइ.<verse eid="REV 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 2:7" />“जेका कान हुये वे सुनी ले कि आत्मा मंडलीहोन से का बोलस हइ.</para>
  <para style="p" vid="REV 2:7">“जो जय मील्हे, मी वोखे वु जिवन को झाड मे से जो परमेश्वर को स्वर्गलोक मे बडन आला मे हइ, फल खान को अधिकार दिह्यु.<verse eid="REV 2:7" /></para>
  <para style="s">स्मुरना कि मंडली खबर</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8" />“स्मुरना कि मंडली को दूत खे यो लिख्यो</para>
  <para style="p" vid="REV 2:8">“जो पयलो अरु आखरी हइ, जो मरी गयो थो अरु अब जिन्दो हुय गयो हइ, व्हा यो बोलस हइ कि. <verse eid="REV 2:8" /><verse number="9" style="v" sid="REV 2:9" />मी तरा दुख अरु गरीब खे जानुस हय; पन तु लकपती हइ, अरु जो दुन्या अपना आप खे यहूदीया बोलस हइ पन वे हइ नी, अरु तरा बारे मे जो आराधनालय बुरी बात बोलस हइ, वोखे भी समजुस हय अरु वे सैतान का हइ. <verse eid="REV 2:9" /><verse number="10" style="v" sid="REV 2:10" />जो दुख तोखे हि झेलनु हुये वोका से मत डर. देख, सैतान तुम मे से कोय खे जेलखाना मे डालन आला हइ क्युकि तुम पैछानी जाह्ये. अरु तुम दस दिन तक दुख वुठानु पड्ये. जान देना तक विश्वासी ऱ्हेव, ते मी विजय जिवन को मुकुट दिह्यु.<verse eid="REV 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 2:11" />“जेका कान हुये वे सुनी ले कि आत्मा मंडलीहोन से का बोलस हइ.</para>
  <para style="p" vid="REV 2:11">“जो विजय मील्हे, वो खे दुसरो मरना से तकलीप नी पहुच्हे.<verse eid="REV 2:11" /></para>
  <para style="s">पिरगमुन खे खबर</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12" />“पिरगमुन कि मंडली को दूतखे यो लिख:</para>
  <para style="p" vid="REV 2:12">“जेका पास दोधार अरु धार तलवार हइ, व्हा यो बोलस हइ कि <verse eid="REV 2:12" /><verse number="13" style="v" sid="REV 2:13" />मी यो जानुस हय कि तू व्हा ऱ्हेतो हइ जहा सैतान को राजगद्दी हइ. तू मरा साथ सच्चो हइ, अरु मरा नाम पर विश्वास करणा से वे दिन मे भी पिच्छे नी हुयो जेमे मरो विश्वासयोग्य गवाह अन्‍तिपास, तुमारा बिच वा जगा पर घात कऱ्यो गयो जहा सैतान ऱ्हेस हइ. <verse eid="REV 2:13" /><verse number="14" style="v" sid="REV 2:14" />पन मेखे तरा विरुध्द कुछ बात बोलनो हइ, क्युकि तरा ह्या कुछ असो हइ, जो बिलाम कि पडय खे मानस हइ, जेने बच्चा खे इस्त्राएलिहोन का आगे ठोकर को कारन रखनो सीखायो कि वे मूर्तिहोन पर चडायो गय चिज खै अरु व्यभीचार कर. <verse eid="REV 2:14" /><verse number="15" style="v" sid="REV 2:15" />वसो य तरा ह्या कुछ असो हइ जो नीकुलइयों कि पडय खे मानस हइ. <verse eid="REV 2:15" /><verse number="16" style="v" sid="REV 2:16" />आखरी मे पाप से मन फिरय, नी ते मी तरा पास झल्दी अयखे अपना मुडा कि तलवार से वुन का सात झगड्यु.<verse eid="REV 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 2:17" />“जेका नी हुये वे सुनी ले कि आत्मा मंडलीहोन से का बोलनो हइ. जो विजय मील्हे, वोखे</para>
  <para style="p" vid="REV 2:17">“मी चुपचाप मन्ना मे से दिह्यु, अरु वोखे एक उजरो फतर भी दिह्यु. अरु वु मेसे हे एक फत्तर पर एक नाम लिख्यो हुयो हुये खे जेखे वोखे मीलनवाला का सिवाय अरु कोय नी जान्हे.<verse eid="REV 2:17" /></para>
  <para style="s">थुआतीरा खे खबर</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18" />“थुआतीरा की मंडली को दूतखे लिख्यो</para>
  <para style="p" vid="REV 2:18">“परमेश्वर को बेटो जेको आख अंगार का जसो हइ, व्हा यो बोल्योस हइ कि <verse eid="REV 2:18" /><verse number="19" style="v" sid="REV 2:19" />मी तरा काम, तरा प्यार अरु विश्वास अरु सेवा अरु धिरज, खे जानुस हय अरु यो भी कि तरा जुना काम पैयले से बडीखे हइ. <verse eid="REV 2:19" /><verse number="20" style="v" sid="REV 2:20" />पन मेखे तरा विरुध्द यो बोल्योस हइ कि तू वा बय इजेबेल नाम कि वा बय खे सय ऱ्हेस हइ जो अपना आप खे परमेश्वर की खबर बतानालो भी बोलती हइ, अरु मरा शिक्षा को सेवक खे बुरोसंबध करणो अरु मुर्तिहोन खे सामे चड अगर गयो जिनुस खानु व्दरा मरी सेवा खे गलत गवय करस हइ. <verse eid="REV 2:20" /><verse number="21" style="v" sid="REV 2:21" />मे ने वोको पाप से मन फिरान का लिये मौको दियो, पन वु अपना व्यभिचार से मन फिरनो नी चाह्ये. <verse eid="REV 2:21" /><verse number="22" style="v" sid="REV 2:22" />अरु मी वोखे दुख पर डालुस हय. अरु जो वोका सात व्यभिचार करस हइ अगर वे भी वोका काम से मन नी फिराह्ये. <verse eid="REV 2:22" /><verse number="23" style="v" sid="REV 2:23" />मी वुनखे अनुयायी खे मारी डाह्यु. तब सब मंडलीहोन समजी लीह्ये कि दिल अरु मन खे पैछाननवालो मीय्य हय, तरा से हर एक को वोका काम जसो बदलो दिह्यु.<verse eid="REV 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 2:24" />“पन तुम थुआतीरा का बाकी दुन्या से जेतनी या पडय खे नी माने अरु वे बात खे जेखे सैतान की गयरी बात बोलस हइ नी जाने, यो बोलस हय कि तुम पर अरु बोझो नी डाह्यु. <verse eid="REV 2:24" /><verse number="25" style="v" sid="REV 2:25" />पन ह्या, जो तुम्हारा पास हइ वो खे मरा आना तक रुखी खे रखनु. <verse eid="REV 2:25" /><verse number="26" style="v" sid="REV 2:26" />जो विजय मील्हे अरु मरा काम का जसो आखरी तक करते ऱ्हेस कि मी ओखे व्हय अधिकार दिह्यु जो मरा बाप से लियो थो. <verse eid="REV 2:26" /><verse number="27" style="v" sid="REV 2:27" />मी उन खे राष्ट्र पर अधिकार व्हा लोखड को राजदण्ड लिये हुयो वोका पर लकडी कऱ्हे का जो रंग कुंम्हार को मट्टि को बर्तन खे चकना चूर करी दे. <verse eid="REV 2:27" /><verse number="28" style="v" sid="REV 2:28" />अरु मी बाप वोखे फजर को तारा भी दिह्यु.<verse eid="REV 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="REV 2:29" />“जेका कान हुये वे सुनी ले कि आत्मा मंडलीहोन से का बोलस हइ.<verse eid="REV 2:29" /></para>
  <chapter eid="REV 2" />
  <chapter number="3" style="c" sid="REV 3" />
  <para style="s">सरदीस खे खबर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1" />“सरदीस की मंडलीहोन को दूत खे यो लिख्यो</para>
  <para style="p" vid="REV 3:1">“जेका पास परमेश्वर का सात आत्माहोन अरु सात तारा हइ, व्हा यो बोलस हइ कि मी तरा काम खे जानुस हय दुन्या, बोलनो हइ कि तु जिन्दो हय पन व्यवस्था मे मऱ्यो हुयो हइ. <verse eid="REV 3:1" /><verse number="2" style="v" sid="REV 3:2" />येका लिये उठी जा, अरु ओखे सदृड कर कि कुछ बाकि हइ अरु जो मीटकान खे हइ, वुनखे मजबुत खे क्युकी मे ने तरा कोय काम खे अपनो परमेश्वर का नजर से पुरो नी मील्यो. <verse eid="REV 3:2" /><verse number="3" style="v" sid="REV 3:3" />येका वासते याद कर कि तोने कोय पडय अपनय करी अरु सुनी थी, अरु वोमे बन्यो ऱ्हे अरु मन फिरा. अगर तू हुशार नी र्‍हेन को ते मी चोर का जसो अचानक अय जाह्यु, अरु तू कभी भी नी जानी सक्हे कि मी कोय टेम्म तरा पास आस. <verse eid="REV 3:3" /><verse number="4" style="v" sid="REV 3:4" />पन ह्या का सरदीस मे तरा ह्या कुछ असा दुन्या हइ जिनने अपना अपना कपडा अच्छा रख्ये वे उजरा कपडा पेन्या हुया मरा सात घुम्हे, क्युकि वे यो योग्य हइ. <verse eid="REV 3:4" /><verse number="5" style="v" sid="REV 3:5" />जो जय मील्हे वोखे यो रंगेरंग उजरा कपडा पेन्याया जाह्ये का अरु मी वोको नाम जिवन की किताब मे से कोय रीत से नी काट्यु. पन वोको नाम अपनो बाप अरु वोको स्वर्गदूतहोन का सामे मानी लिह्यु.<verse eid="REV 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 3:6" />“जेका नी हुये वु सुनी ले कि आत्मा मंडलीहोन से का बोलस हइ.<verse eid="REV 3:6" /></para>
  <para style="s">फिलदिलफिया खे खबर</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7" />“फिलदिलफिया की मंडली का दूतखे यो लिख्यो</para>
  <para style="p" vid="REV 3:7">“जो पवित्र अरु सच्चो हइ, जो दाउद की चाबी रखस हइ, जेखे खोल्या आला खे कोय बन्द नी करी सकस अरु बन्द कर्‍य हुयो खे कोय खोली नी सकस का व्हा यो बोलस हइ की <verse eid="REV 3:7" /><verse number="8" style="v" sid="REV 3:8" />मी तरा काम खे जानुस हय. देख, मे ने तरा सामने एक दरवाजो खोली खे रख्योस हइ, जेखे कोय बंद नी करी सकस तरी सामर्थ्य जरा सी अरु ह्या समजी ले कि मे ने तरा पाय पर गिरीखे अरु यो वचन को पालन कऱ्योस हइ अरु मरो नाम खे मना नी कऱ्यो. <verse eid="REV 3:8" /><verse number="9" style="v" sid="REV 3:9" />देख मी सैतान वे आराधनालय खे तरा कुल मे करी दिह्यु जो यहूदीया बनी बठ्योस हइ पर नी क्युकि झुट्टी बोलस हइ देख, मी असो कर्‍हु कि वे अयखे तरा पाय पर गीरीऱ्हे कि अरु यो जानी लिह्ये कि मे ने तरा पाय पर गिरीखे अरु यो समजी ले एक दुसरा से प्यार रख्युस हइ. <verse eid="REV 3:9" /><verse number="10" style="v" sid="REV 3:10" />क्युकि तो ने मरा थामन को वचन खे रोख्यो हइ,येका वासते मी भी तोखे पेपर का वा टेम बच्यो र्हिये जो जमीन पर ऱ्हेनवाला खे पैछानन का वासते सब जगत पर आनवालो हइ. <verse eid="REV 3:10" /><verse number="11" style="v" sid="REV 3:11" />मी झल्दी ही आनवालो हय. जो कुछ तरा पास हइ वोखे रोखी खे र्‍हे कि कोय तरो मुकुट नी छुडय ले. <verse eid="REV 3:11" /><verse number="12" style="v" sid="REV 3:12" />जो विजय हुये वोखे मी अपना परमेश्वर कि आराधनालय मे एक खबो बनाह्यु, अरु व्हा फिर या आराधनालय से बाहेर नी निकाले. अरु मी अपनो परमेश्वर को नाम अरु अपनो परमेश्वर को शहर को नाम नवो येरुशलेम खे लिख्यु जो मरो परमेश्वर का पास से उन पर मी अपनो नवो नाम लिख्यु.<verse eid="REV 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 3:13" />“जेक न हुये वे सुनी ले कि आत्मा मंडलीहोन से का बोलस हइ.<verse eid="REV 3:13" /></para>
  <para style="s">लौदीकिया खे खबर</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14" />“लौदिकिया की मंडली को दूतखे यो लिख:</para>
  <para style="p" vid="REV 3:14">“जो आमीन अरु विश्वासलायाक अरु सच्चो गवाह हइ, अरु परमेश्वर कि सुष्टि को मेन करण हइ, व्हा यो बोलस हइ कि <verse eid="REV 3:14" /><verse number="15" style="v" sid="REV 3:15" />मी तरा काम खे जानुस हय कि तू नी ते ठंडो हइ अरु नी गरम अच्छो होतो कि तू ठंडो या गरम होतो. <verse eid="REV 3:15" /><verse number="16" style="v" sid="REV 3:16" />येका वासते कि तू कुनकुनो हइ अरु नी ठंडो नी गरम, मी तोखे अपना मुडा मे ओगलना पर हय. <verse eid="REV 3:16" /><verse number="17" style="v" sid="REV 3:17" />तु बोलस हइ कि मी लकपती हय अरु लखपती हुय गयोस हय अरु मेखे कोय जिनुस की कमी नी. अरु यो नी जाने कि तू अभागो अरु बुरो अरु कंगाल अरु अंधो अरु बिना कपडा को हइ. <verse eid="REV 3:17" /><verse number="18" style="v" sid="REV 3:18" />येका वासते मी तोखे सलो देस हय कि अंगार मे तप्यो हुयो सोन्नो मरा से मोल ले कि तु लकपती हुय जाह्येका अरु उजरो कपडा ली ले कि पेनीखे तोखे अपना नंगापना कि लाज नी हुये खे अरु अपनी आख मे लगान, लिये सुर्वो ले कि तू देखन लग्यो. <verse eid="REV 3:18" /><verse number="19" style="v" sid="REV 3:19" />मी जेखे जेका से प्यार करुस हय, वे सब खे उल्लास अरु दुख देस हय. येका लिये सरद गरम हुये अरु पाप से मन फिराव. <verse eid="REV 3:19" /><verse number="20" style="v" sid="REV 3:20" />देख मी डठ्ठा पर खडो हुयो खटखटास हय. अगर कोय मरो अवाज सुनीखे दरवाजो खोल्हे का ते मी वोका पास अंदर अयखे वोका सात खानो खाह्यु अरु उ मरा सात. <verse eid="REV 3:20" /><verse number="21" style="v" sid="REV 3:21" />जो विजय मील्हे मी वोखे अपना सात अपनी राजगद्दी पर बठ्यु, जसो मी भी विजय मीलीखे अपना बाप का सात वोखे राजगद्दी पर बठी गयो.<verse eid="REV 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 3:22" />“जे कान हुये वे सुनी ले कि आत्मा मंडलीहोन से का बोलस हइ.”<verse eid="REV 3:22" /></para>
  <chapter eid="REV 3" />
  <chapter number="4" style="c" sid="REV 4" />
  <para style="s">स्वर्ग मे प्रर्थना</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1" />या बात का बाद जो मे ने नजर की तु का देखस हय कि स्वर्ग मे एक दरवाजो खुल्लो हुयो हइ अरु जेखे मे ने पयली पिपडी की बात से अपना सात बात करते सुन्यो थो का उ बोलस हइ, ह्या उपर अय जा. अरु मी वा बात तोखे दिखाह्यु जेखे या बातहोन का बाद पुरो होनू जरुरी हइ. <verse eid="REV 4:1" /><verse number="2" style="v" sid="REV 4:2" />फिर मी तुरुत आत्मा ने मरापर नीयत्रण कऱ्यो. मे ने देख्यो की मरा सामने स्वर्ग मे राजगद्दी अरु ओका पर कोय बठ्यो नी थो. <verse eid="REV 4:2" /><verse number="3" style="v" sid="REV 4:3" />जो वोखे बठ्यो पर व्हा यशब अरु माणिक्य का फत्तर का जसो दिखयो देस हइ,अरु वु राजगद्दी का चारी तरप मरकत जसो एक मेघ धणुष दिखय देस हइ. <verse eid="REV 4:3" /><verse number="4" style="v" sid="REV 4:4" />वा राजगद्दी मे से बिजली कि चमक अरु बद्दल को गरझनो नीकली रोथो अरु या राजगद्दी पर चौबीस बापदादा दुन्या उजरो कपडा पेनीखे हुयो बठ्योस था का अरु वोका माथा पर सोना को मुकुट थो. <verse eid="REV 4:4" /><verse number="5" style="v" sid="REV 4:5" />वा राजगद्दी मे से बिजलीहोन अरु गरझनो नीकलस री थी अरु राजगद्दी का सामने अंगार का सात दिव्वो जली रोस थो वे परमेश्वर की सात आत्माहोन हइ.<verse eid="REV 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 4:6" />अरु भी राजगद्दी का सामने मान पारदर्शी काच का स्फटिक सागर जसो फैल्यो थो का राजगद्दी मे का ठिक सामने अरु ओका उनका दो अरु चार जनवर था, उनका आगे पिच्छे आख ही आख थी. <verse eid="REV 4:6" /><verse number="7" style="v" sid="REV 4:7" />पयलो जनवर सेर का जसो थो, अरु दुसरो जनवर बैल का जसो हइ, तिसरो जनवर को मेडो का जसो हइ, अरु चौथो जनवर तिन हुयो घुब्बड का जसो थो.<verse eid="REV 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 4:8" />चार जनवर का छे पंग. अरु चार तरफ अरु अन्दर आख था अरु वे रात दिन बिना अराम करीखे यो करते ऱ्हेस हइ.</para>
  <para style="q2" vid="REV 4:8">“पवित्र, पवित्र, पवित्र प्रभु परमेश्वर सबसेशक्तिमान का जो थो अरु जो हइ अरु जो आनवालो हइ.”<verse eid="REV 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 4:9" />जब वे जनवर वोकी जो राजगद्दी पर बठ्योस हइ, अरु जो हमेशा हमेशा जिन्दो हइ, महिमा अरु सम्मान अरु आशीर्वाद करी र्‍ही था. <verse eid="REV 4:9" /><verse number="10" style="v" sid="REV 4:10" />वे चौबीसों बापदादा दुन्या राजगद्दी पर बठनवाला खे साम्हे गिरी पडे ह्ये का अरु वोको जो हमेशा हमेशा जिन्दो हइ सबुत करख्ये. अरु वे अपना मुकुट डाल देस हइ अरु बोलस हइ, <verse eid="REV 4:10" /><verse number="11" style="v" sid="REV 4:11" />“हे हमारो प्रभु अरु परमेश्वर खे तु ही महिमा अरु आदर अरु सामर्थ्य मीलन का योग्य हइ. क्युकि तोने य सब चिजहोन बनय अरु वे तरी य इच्छा से वे अस्तित्व मे अय थी अरु जिन्दो हइ.”<verse eid="REV 4:11" /></para>
  <chapter eid="REV 4" />
  <chapter number="5" style="c" sid="REV 5" />
  <para style="s">किताब अरु मेडो</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1" />जो राजगद्दी पर बठ्यो थो का मे ने वोका जवना हात मे एक किताब देखी जो अंदर अरु बाहेर लिखी थी, अरु व्हा सात सिक्का लगय खे बन्द करी दि थी. <verse eid="REV 5:1" /><verse number="2" style="v" sid="REV 5:2" />फिर मे ने एक ताखत आलो स्वर्गदूत खे देख्यो जो बडा बात से यो प्रचार करतो थो, “या किताब खे खोलनो अरु सिक्का तोडन का योग्य कोन हइ?” <verse eid="REV 5:2" /><verse number="3" style="v" sid="REV 5:3" />पन नी स्वर्ग मे, नी का नीच्चे कोय वा किताब खे खोलनो या वोका पर नजर डाली की योग्य कोय नी नीकल्यो. <verse eid="REV 5:3" /><verse number="4" style="v" sid="REV 5:4" />तब मी फूटी फूटीखे रोन लग्यो का क्युकि वा किताब खे खोलनो या वोका पर नजर डालन को योग्य कोय नी मील्यो. <verse eid="REV 5:4" /><verse number="5" style="v" sid="REV 5:5" />येका पर वा बापदादाहोन मे से एक ने मरा से बोल्यो, “मत रोय. देख का यहूदा को गोत का वु सेर दाउद किताब खे खोलनो अरु वोकी सात सिक्का तोडन का वासते जिन्दो हुयोस हइ.”<verse eid="REV 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6" />तब मे ने देख्यो मेढो राजगद्दी का बिच खडो हइ अरु चारी जनवरहोन अरु वे बापदादा होन का बीच मेको मान एक खुन कऱ्यो हुयो मेडो खडो देख्यो. वो, सात सींग अरु सात आख था. यो परमेश्वर कि सात आत्माहोन हइ जो सब पृथ्वी पर भेज्यो गयो थो. <verse eid="REV 5:6" /><verse number="7" style="v" sid="REV 5:7" />वोने अयखे वोका जवना हात से जो राजगद्दी पर बठ्यो थो, वा किताब ली ली. <verse eid="REV 5:7" /><verse number="8" style="v" sid="REV 5:8" />जब वोने किताब ली ली ते वे चार जनवर अरु चौबीसों बापदादा दुन्या ने मुडा का सामने घुटना टेक गिरी पड्या.वोमेसे हर एक का हात मे जबान अरु अंगारो का जो पवित्र दुन्या की प्रार्थनाहोन हइ, से भऱ्या हुया सोना को कटोरा था. <verse eid="REV 5:8" /><verse number="9" style="v" sid="REV 5:9" />वे यो नवो गिद गान लग्या,</para>
  <para style="q1" vid="REV 5:9">“तु या किताब खे लेन का</para>
  <para style="q2" vid="REV 5:9">अरु येकी सिक्का को खोलन का योग्य हइ.</para>
  <para style="q1" vid="REV 5:9">क्युकि तोने खुन हुयखे अपनो खुन से हर एक कुल</para>
  <para style="q2" vid="REV 5:9">अरु भाषा अरु दुन्या अरु जमात मे से परमेश्वर को दुन्या खे हर जास से अरु सब गोत्र से सब राष्ट्र मोल लियोस हइ.<verse eid="REV 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10" />अरु वुन खे हमारो परमेश्वर की सेवा करण का लिये एक राज अरु मंत्री बनायो. अरु वे पृथ्वी पर राज करस हइ.”<verse eid="REV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11" />फिर से मे ने स्वर्गदूत कि आवाज सुन वे सिंहासन जनवर अरु वे बापदादा खे चारी तरप खुप से स्वर्गदूतहोन की बात सुनी जिन कि गिनती लाख अरु करोडो कि थी, <verse eid="REV 5:11" /><verse number="12" style="v" sid="REV 5:12" />अरु वे वुच्चा अवाज से यो गित गाते बोलतो थो,</para>
  <para style="q1" vid="REV 5:12">“खुन कऱ्यो हुयो मेडो ही सामर्थ्य अरु धन अरु ज्ञान अरु शक्ति अरु इज्जत अरु महिमा अरु धन्यवाद का योग्य हइ.” <verse eid="REV 5:12" /><verse number="13" style="v" sid="REV 5:13" />फिर मे ने स्वर्ग मे अरु पृथ्वी पर</para>
  <para style="q2" vid="REV 5:13">अरु का नीचे अरु समुद्र कि सब हुय चिजहोन खे अरु सब कुछ खे जो वुनमे हइ,</para>
  <para style="q2" vid="REV 5:13">यो बोलते सुन्यो, “जो राजगद्दी पर बठ्यो हइ वोका अरु मेडो को अरु सम्मान कि महिमा अरु राज हमेशा हमेशा ऱ्हिये.” <verse eid="REV 5:13" /><verse number="14" style="v" sid="REV 5:14" />अरु चार जनवरहोन ने आमीन बोल्यो कि अरु बुजरुक दुन्या ने गिरीखे पायपड्या.<verse eid="REV 5:14" /></para>
  <chapter eid="REV 5" />
  <chapter number="6" style="c" sid="REV 6" />
  <para style="s">सात सिक्का खे</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1" />फिर मे ने देख्यो कि मुडा ने वे सात सिक्का खे मे से एक खे खोल्यो. अरु वे चार जनवरहोन मे से एक खे गरझनो को जसो बात सुनी, “आ!” <verse eid="REV 6:1" /><verse number="2" style="v" sid="REV 6:2" />मे ने नजर करी अरु देख्यो, एक उजरो घोडो हइ, अरु वोका उपर बठीखे तिर लिखे हुयो हइ. अरु वोखे एक मुकुट दियो गयो, अरु व्हा विजय करते हुयो नीकल्यो कि अरु भी जय लिखे आह्ये.<verse eid="REV 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3" />जब मुडाने दुसरो सिक्काको खोल्यो का ते मे ने दुसरो जनवर खे यो बोलते सुन्यो, “आ!” <verse eid="REV 6:3" /><verse number="4" style="v" sid="REV 6:4" />फिर एक अरु घोडो नीकल्यो जो लाल रंग को थो. ओका पर बठी खे यो अधिकार दियो गयो कि पृथ्वी पर से शांती छुडय लेका अरु दुन्या से एक दुसरा को मारन करीखे. अरु वोखे एक बडी तलवार दी गय.<verse eid="REV 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5" />जब वोने तीसरो सिक्का खे खोल्यो का ते मे ने तिसरो जनवर खे यो बोलते सुन्यो, “आ!” मे ने नजर करी अरु देख्यो का एक कालो घोडो हइ, अरु वोका पर बठी खे हात मे एक तराजु हइ. <verse eid="REV 6:5" /><verse number="6" style="v" sid="REV 6:6" />अरु मे ने चार का बिच मे एक अवाज खे बोलते सुन्यो, “आना को सेर भर गहु, अरु आना का तीन सेर जेका पर एक अरु अंगूर का बगीचा खे नुकसान नी करणू.”<verse eid="REV 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7" />जब वोने चार सिक्काको खोल्यो, ते मे ने चार जनवर कि बात यो बोलते सुन्यो, “आ!” <verse eid="REV 6:7" /><verse number="8" style="v" sid="REV 6:8" />मे ने नजर करी, अरु देख्यो, एक पिलो जसो घोडो हइ. अरु वोक उपर को नाम मरनो हइ, अरु मृत्य लोक वोका पिछे पिछे था. अरु वुनखे जमीन कि एक चार भाग पर यो अधिकार दियो गयो कि तलवार, अरु अकाल अरु मऱ्या अरु जमीन का जंगल जनवरहोन का वजेसे दुन्या खे मारी डाल.<verse eid="REV 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9" />जब वोने पचवो सिक्काको खोल्यो, ते मेने वेदी का नीच्चे वुनको आत्माहोन खे मन से देख्यो जो परमेश्वर को वचन को यानेकी अरु गवय का यानेकी जो वुनने दी थी मार्‍यो कऱ्यो गयो थो. <verse eid="REV 6:9" /><verse number="10" style="v" sid="REV 6:10" />वुनने बडी बात से फुकारी खे बोल्यो, “हे सर्वशक्तिमान स्वामी, हे पवित्र अरु सच्चो परमेश्वर. तु कब तक न्याय नी करण को? अरु जमीन का ऱ्हेनवाला से हमारो खुन को बदलो कब तक नी लेनको?” <verse eid="REV 6:10" /><verse number="11" style="v" sid="REV 6:11" />वोमेसे से हर एक खे उजरो कपडा दियो गयो, अरु वोने बोल्यो गयो कि अरु थोडा देर तक अराम कर, जब तक कि तुम्हारा संग सेवक अरु भैइ जो तुम्हार जसा मरन होनवालो हइ वुनकी भी गिनती पुरी नी हुय ली.<verse eid="REV 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12" />जब मेडा साववो सिक्काको खोल्यो, ते मे ने देख्यो कि एक बडो भुकम्प हुयो, अरु सुरज जसो कालो अरु पूरो चाद खुन का जसो लाल हुय गयो. <verse eid="REV 6:12" /><verse number="13" style="v" sid="REV 6:13" />बद्दल को तारो जमीन असा गिरी पड्या जसी बडी हवा धुनद से हलयखे अंजीर का झाड मे से कच्चो फल झडस हइ. <verse eid="REV 6:13" /><verse number="14" style="v" sid="REV 6:14" />बद्दल असो सरकी गयो जसो किताब गुडनना से सरकी जास हइ. अरु हर एक टेकडी अरु छेडा, अपना अपना जगा से चली गया. <verse eid="REV 6:14" /><verse number="15" style="v" sid="REV 6:15" />जब जमीन को राज को अरु प्रधान को अरु सरदार अरु पैसाआलो अरु ताखतवाला दुन्या अरु हर एक सेवक हर एक आजाद टेकड खोरा मे अरु फत्तरमे जखे लुक्यो, <verse eid="REV 6:15" /><verse number="16" style="v" sid="REV 6:16" />अरु टेकडा अरु फत्तर से बोलन लग्या, “हमारा पर गिरी पड्या. अरु हम वोका से जो राजगद्दी पर बठ्योस हइ, अरु मेडो को डर से लुकी गो. <verse eid="REV 6:16" /><verse number="17" style="v" sid="REV 6:17" />क्युकि वो को डर को भयानक दिन अय पहुच्यो हइ, आब कोन हइ जो ओका जसो करस हइ?”<verse eid="REV 6:17" /></para>
  <chapter eid="REV 6" />
  <chapter number="7" style="c" sid="REV 7" />
  <para style="s">इस्त्राएल का कृपापात्र</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1" />येका बाद मे ने जमीन का चारी कोना पर चार स्वर्गदूत खडो देख्यो. वे जमीन का चारी हवाहोन खे रोखी थी जबकी जमीन या नंद्दी या कोय झाड पर हवा नी चली. <verse eid="REV 7:1" /><verse number="2" style="v" sid="REV 7:2" />फिर मे ने एक अरु स्वर्गदूत खे जिन्दो परमेश्वर की सिक्काको लिखे होते पुरब से वुपर का तरप आते देख्यो. वोने वे चार स्वर्गदूत से जिन खे जमीन अरु नंद्दी की नुकसान करण को अधिकार दियो गयो थो, वुच्ची अवाज से फूकारी खे बोल्यो, <verse eid="REV 7:2" /><verse number="3" style="v" sid="REV 7:3" />“जब तक हम अपनो परमेश्वर का सेवकहोन को माथा पर सिक्का को नी लगय दे, तब तक जमीन कि नंद्दी का झाड खे नुकसान नी पहुचानु.” <verse eid="REV 7:3" /><verse number="4" style="v" sid="REV 7:4" />जेका पर सिक्का को दीया मेने वुन कि गिनती सुनी, अगर इस्राएल का बच्चाहोन का सब गोत्र मे से एक लाख चौआलीस हजार पर सिक्का को दियो <verse eid="REV 7:4" /><verse number="5" style="v" sid="REV 7:5" />यहूदा क वंशमे से बारा हजार पर सिक्का को दियो गयो. रुबेन का गोत मे से बारा हजार पर, गाद को गोत मे से बारा हजार पर. <verse eid="REV 7:5" /><verse number="6" style="v" sid="REV 7:6" />आशेर का गोत मे से बारा हजार पर, नप्ताली को गोत मे से बारा हजार मनश्‍शे गोत पर, <verse eid="REV 7:6" /><verse number="7" style="v" sid="REV 7:7" />शमौन को गोत मे से बारा हजार पर, इस्साकार लेवी को गोत मे से बारा हजार पर, <verse eid="REV 7:7" /><verse number="8" style="v" sid="REV 7:8" />जबूलून का गोत मे से बारा हजार पर यूसुफ का गोत मे से बारा हजार पर, अरु बिन्यामीन को गोत मे से बारा हजार पर सिक्का को दीयो गयो.<verse eid="REV 7:8" /></para>
  <para style="s">एक बडी गर्दी</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9" />येका बाद मे ने नजर करी देख्यो, हर एक कुल अरु गोत्र अरु दुन्या अरु भाषा मे से एक असी बडी गर्दी, जेखे कोय नी गीनी सकतो थो, उजरो कपडा पेन्या अरु अपना हात खारीक की डांग लिये हुयो राजगद्दी का सामने अरु मुडा का सामने खडो हइ, <verse eid="REV 7:9" /><verse number="10" style="v" sid="REV 7:10" />अरु बडा जोर से पुकारी खे बोलस हइ, “उध्दार जो राजगद्दी पर बठ्यो हइ हमारो परमेश्वर का तरपसे अरु मुडा का तरप से जय जयकार हुये!” <verse eid="REV 7:10" /><verse number="11" style="v" sid="REV 7:11" />अरु सब स्वर्गदूत वा राजगद्दी अरु बापदादा अरु चारी जनवरहोन का चारी तरप खडो हइ अरु वे राजगद्दी का आगे मुडा पर गिरी पडयो अरु परमेश्वर का पायपड्यी खे बोल्यो, <verse eid="REV 7:11" /><verse number="12" style="v" sid="REV 7:12" />“आमीन! स्तुती अरु महिमा अरु ज्ञान अरु धन्यवाद पडे अरु सम्मान अरु सामर्थ्य अरु शक्ती पिडमपिडि से हमारो परमेश्वर को हइ”<verse eid="REV 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13" />येका पर बापदादा मे से एक ने मरा से बोल्यो, “ये उजरा कपडा पेन्या आलो कोन हइ? अरु से आयोस हइ?”<verse eid="REV 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14" />“मे ने ओकासे बोल्यो, हे स्वामी तुय जानस हइ.” वोने मरा से बोल्यो,</para>
  <para style="p" vid="REV 7:14">“ये वे आय, जो वु बडी संकट मे से नीकलीखे आयोस हइ. इनमे अपना अपना कपडा मुडा को खुन मे धोयखे उजरा कर्यास हइ. <verse eid="REV 7:14" /><verse number="15" style="v" sid="REV 7:15" />येका वजेसे वे परमेश्वर कि राजगद्दी का सामे हइ, अरु वोकि आराधनालय मे दिन रात वोकि सेवा करस हइ, अरु जो राजगद्दी पर बठ्यो हइ, व्हा खुद अपनी रक्षा कर्‍हे. <verse eid="REV 7:15" /><verse number="16" style="v" sid="REV 7:16" />वे फिर कभी फिर भुका अरु प्यासा नी हुये. अरु वुन का जिवन पर घाम, नी कोय तपनखे पडे. <verse eid="REV 7:16" /><verse number="17" style="v" sid="REV 7:17" />क्युकि मेडा जो राजगद्दी का बीच मे हइ वुनकी रखवालो हुये खे अरु वुनखे जिवन रुपी पाणी का सोत्रो का पास ली जाह्ये कऱ्हे. अरु परमेश्वर वुनकी आख से सब पानीपोछी डाल्हे.”<verse eid="REV 7:17" /></para>
  <chapter eid="REV 7" />
  <chapter number="8" style="c" sid="REV 8" />
  <para style="s">सातवो सिक्काको</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1" />जब वोने सातवो सिक्काको खोल्यो, ते स्वर्ग मे आदा घण्टा तक सन्नाटो हुय गयो. <verse eid="REV 8:1" /><verse number="2" style="v" sid="REV 8:2" />तब मे ने वे सात स्वर्गदूतहोन खे देख्यो जो परमेश्वर का सामने खडो ऱ्हेस हइ, अरु वुनखे सात तुरहीहोन दि गय.<verse eid="REV 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3" />फिर एक अरु स्वर्गदूत सोन्ना को धुपारनो लिये हुयो, अरु वेदी का नजीक खडो हुयो. अरु वोखे खुब धुप दियो गयो कि सब पवित्र दुन्या की प्रार्थनाहोन का सात सोन्ना कि वा वेदी पर का जो राजगद्दी का सामने चेढ्यो. <verse eid="REV 8:3" /><verse number="4" style="v" sid="REV 8:4" />वु धूप को धुवो पवित्र दुन्या कि प्रार्थनाहोन का बराबर स्वर्गदूत का हात से परमेश्वर का सामे पहुची गयो. <verse eid="REV 8:4" /><verse number="5" style="v" sid="REV 8:5" />फिर स्वर्गदूत ने धुपारनो लिखे वोमे वेदी कि अंगार भरी अरु जमीन पर डाली दी.अरु गर्जन अरु बात अरु बिजलीहोन अरु भुकम्प होन लग्या.<verse eid="REV 8:5" /></para>
  <para style="s">सात पिपडीहोन</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6" />तब वे सात स्वर्गदूत जिनका पास सात पिपडीहोन थी वुनखे फुकन कि तैयारी हुय.<verse eid="REV 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7" />पयलो स्वर्गदूत ने पिपडी फुकी, अरु खुन से मील्यो हुयो गिलो अरु अंगार पइदा हुय, अरु जमीन पर डाली गय. अरु झाड की एक तिहाइ जली गयो, अरु सब हरो घास भी जली गयो.<verse eid="REV 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8" />दुसरो स्वर्गदूत ने सयनय फुकी, ते मान अंगार जसो जलते हुयो एक बडी टेकडो नंद्दी मे डाली गयो. अरु नंद्दी को एक पिपडी खुन हुयगो, <verse eid="REV 8:8" /><verse number="9" style="v" sid="REV 8:9" />अरु नंद्दी को एक तिहाइ जनवर का मन से मरी गया, अरु एक तिहाइ डोंगो खतम हुय गो.<verse eid="REV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10" />तीसरा स्वर्गदूत ने तुम्हारी पिपडी फुकी अरु एक बडो तारो जो मशाल टेम्मा, जसो जलतो थो बद्दल से टुट्यो, अरु नंद्दी का एक तिहाइ पर अरु पाणी का स्रोत पर अय गिऱ्यो. <verse eid="REV 8:10" /><verse number="11" style="v" sid="REV 8:11" />वु तारा को नाम नागदौना हइ. अरु एक तिम ही पाणी नागदौना जसो कडवो हुय जाना से मरी गो.<verse eid="REV 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12" />चौथो स्वर्गदूत ने पिपडी फुकी, अरु सुरज कि एक तरा ही अरु चन्दा कि एक तिसरो अरु तारा कि एक तिहाइ पर फजित अय, ह्या तक कि वुनको एक तिसरो आंग अंधारो हुय गयो अरु दिन की एक तिसरो उजालो नी र्‍हियो, अरु वैसे ही रात मे भी.<verse eid="REV 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13" />जब मे ने फिर देख्यो, ते बद्दल का बिच मे एक घुब्बड खे वुडते अरु वुच्चा बात से यो बोलते सुन्यो, “वे तीन स्वर्गदूतहोन की तिसरा कि बात खे करन, जिन को पिपडी फुकनो अभी बाकि हइ, जमीन पर ऱ्हेन वालापर दुख ही दुख हुये!”<verse eid="REV 8:13" /></para>
  <chapter eid="REV 8" />
  <chapter number="9" style="c" sid="REV 9" />
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1" />जब पाच स्वर्गदूत होनकी पिपडी फुकी, ते मे ने स्वर्ग से जमीन पर एक तारो गिरते हुयो देख्यो, अरु वोखे अथाह कुण्ड की कुंजी दी गय. <verse eid="REV 9:1" /><verse number="2" style="v" sid="REV 9:2" />फिर उ तारा ने वा कुंजी अथाह कुण्ड खे खोल्यो, अरु ओमे से असो धुवो नीकल्यो जसो बडो भट्टी को धुवो नीकल्योस हइ, अरु कुण्ड को धुवा से सुरज अरु हवा काली हुय गय. <verse eid="REV 9:2" /><verse number="3" style="v" sid="REV 9:3" />वु धुवा से जमीन पर टोटर नीकली, अरु वुनने जमीन खे बिछुहोन का जसी शक्ती दि गय. <verse eid="REV 9:3" /><verse number="4" style="v" sid="REV 9:4" />वुनका से बोल्यो गयो कि नी जमीन की घास खे, नी कोय झाड खे तकलीप पवचानु का फक्त वे इन्सान खे तकलीप पवचानु जिन का माथा पर परमेश्वर को सिक्काको नी हइ. <verse eid="REV 9:4" /><verse number="5" style="v" sid="REV 9:5" />टोटर खे नीर्देश दियो गयो कि अरु वे दुन्या खे मारी डालन को ते नी का पर पाच महीना तक दुन्या खे दुख देन को अधिकार दियो गयो. अरु उनकी तखलीप असी थी, जसी बिच्छु का डंक मारना से इन्सान खे होस हइ. <verse eid="REV 9:5" /><verse number="6" style="v" sid="REV 9:6" />वे पाच महीना मे इन्सान मरना खे ढुडिरोस अरु नी मील्हे. अरु मरन कि लालुच कऱ्हे अरु मरनो उन से भागेह्ये.<verse eid="REV 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7" />वे टोटर को अयखे लडयो का लिये तैयार कऱ्यो हुयो थो घोडो का जसो थो, अरु उनको माथा पर समजो सोन्ना को टोपी थो का वुनको मेडो इन्सान का जसो थो. <verse eid="REV 9:7" /><verse number="8" style="v" sid="REV 9:8" />वुनका बाल बय का बाल जसा था अरु दात सेर का दात जसा था. <verse eid="REV 9:8" /><verse number="9" style="v" sid="REV 9:9" />उनका छाती चिलकत से झाकि हुइ थी अरु वे आंग मे जसो लोहा का जसी कवच से झाक्यो हुयो थो. वुनका पंग की अवाज एसी थी, जसी लडय मे खुप घोडा ज्योत्या हुया दौडते रथ कि होस हइ. <verse eid="REV 9:9" /><verse number="10" style="v" sid="REV 9:10" />वोकी पुस्टी बिच्छु को डंक का जसी थी अरु वुनकी पुस्टी मे ही दुन्याहोन खे पाच महीना तक दुख देन की सहन करी थी. <verse eid="REV 9:10" /><verse number="11" style="v" sid="REV 9:11" />अथाह कुण्ड को दूतहोन पर राजो थो. वो को नाम इब्रानी मे अबद्दोन, अरु यूनानी मे अपुल्लयोन हइ.<verse eid="REV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12" />पयली विपत्ति बिती गयस,देख, आब येका बाद दो विपत्तिहोन अभी बाकी हइ.<verse eid="REV 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13" />जब साव्वो स्वर्गदूत ने पिपडी फुकी ते मेने परमेश्वर, सामे वेदी हइ वो, सिंगपर मे से असी बात सुनी, <verse eid="REV 9:13" /><verse number="14" style="v" sid="REV 9:14" />समजनु कोय साव्वो स्वर्गदूत से, जेका नजीक पिपडी थी बोली रोस हइ, “वे चार स्वर्गदूत खे जो बडी नंद्दी फुरात का नजीक बाध्यो हुयो हइ, खोली दे.” <verse eid="REV 9:14" /><verse number="15" style="v" sid="REV 9:15" />वे चार दूत खोली दियो गयो जो जो वा टेम अरु दिन अरु महीनो, अरु बरस का वास्ते इन्सान कि एक तिसरा मे मारी डाली खे तैयार करी दियो थो. <verse eid="REV 9:15" /><verse number="16" style="v" sid="REV 9:16" />वुनकी फोज कि सवार गिनती बिस करोड थी. मे ने वुनकि गिनती सुनी. <verse eid="REV 9:16" /><verse number="17" style="v" sid="REV 9:17" />मेखे यो दर्शन मे घोडो अरु वुन का सवार दिखान दियो जिनको पाणी मे अंगार, अरु धुम्रकान्त अरु गन्धक का जसी थी अरु वे घोडा का माथा सेर जेका माथा का जसो थो. अरु वोका मुडा मे से अंगार, धुवौ अरु गन्धक नीकलतो थो. <verse eid="REV 9:17" /><verse number="18" style="v" sid="REV 9:18" />ये तीन महामारीहोन अगर अंगार अरु धुवौ अरु गन्धक से, जो वुनका मुडा से नीकलतो थो इन्सान को एक तिसरो मारी डाल्यो गयो. <verse eid="REV 9:18" /><verse number="19" style="v" sid="REV 9:19" />क्युकि वे घोडा कि सामर्थ्य वुनको मुडो अरु वुन की सेपटी मे थी. येका वास्ते कि वुनकी सेपटी साप जसी थी, अरु वु सेपटी का माथा भी थो अरु वुनने सेवा दुख पवचातो थो.<verse eid="REV 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20" />बाकि इन्सान ने जो वे मरीया से नी मऱ्यो थो, अपना हातकाम से मन नी मऱ्या था बुरीआत्माहोन की अरु चादी अरु पित्तल अरु फत्थर अरु काठ कि मूर्ती होन कि पुजा नी करनु जो नी देख्ये का सुनी नी सकती हइ. <verse eid="REV 9:20" /><verse number="21" style="v" sid="REV 9:21" />अरु जो खून, अरु टोना, अरु व्यभिचार, अरु चोरी वुन ने करी थी, वुनका से मन फिरयो.<verse eid="REV 9:21" /></para>
  <chapter eid="REV 9" />
  <chapter number="10" style="c" sid="REV 10" />
  <para style="s">स्वर्गदूत अरु छोटी किताब</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1" />फिर मेने एक अरु शक्तीशाली स्वर्गदूत खे बद्दल होड्यो हुयो स्वर्ग से वुतरते देख्यो. वोका माथा पर मेघ धनुष थो वोको मेडो सुरज का जसो अरु वोक पाय अंगार को खब्बो का जसो थो. <verse eid="REV 10:1" /><verse number="2" style="v" sid="REV 10:2" />वोको हात मे एक छोटी सी खुल्ली वाली किताब थी. वोने अपनो जवनो पाय नंद्दी पर अरु डाखोऱ्यो पाय जमीन पर रख्यो. <verse eid="REV 10:2" /><verse number="3" style="v" sid="REV 10:3" />अरु असो बडा जोर से चिचानो, जसो सेर गरजस हइ. अरु जब चिलायो ते गर्जन का सात बात सुनय दि. <verse eid="REV 10:3" /><verse number="4" style="v" sid="REV 10:4" />जब सात गर्जन कि बात सुनय हइ “वुनखे मगम रख का अरु मत लिखे.”<verse eid="REV 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5" />जो स्वर्गदूत खे मे ने नंद्दी अरु जमीन पर खडो देख्यो थो, वोने अपनो जवनो हात स्वर्ग का तरप उठायो, <verse eid="REV 10:5" /><verse number="6" style="v" sid="REV 10:6" />अरु जो पिडमपिडि से जिन्दो हइ, अरु जेने जमीन अरु स्वर्ग खे अरु जो कुछ वोका पर हइ, अरु नंद्दी खे अरु जो कुछ वोमेसे हइ सृजा, वोकि कसम खय खे बोल्यो, “आब तो देर नी होन कि. <verse eid="REV 10:6" /><verse number="7" style="v" sid="REV 10:7" />क्युकि सतवो स्वर्गदूत कि पिपडी फुकी पर होन आलो बात को दिन मे परमेश्वर को मोगम मनोगत वा खबर का जसो जो वोने अपनो सेवक भविष्यव्दक्ताहोन खे दियो, पूरो हुयगो.”<verse eid="REV 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8" />जो बात खे मे ने स्वर्ग से बोलते सुन्यो थो, व्हा फिर मरो बात करण लग्यो, “जो, जो स्वर्गदूत नंद्दी अरु जमीन पर खडो हइ, वोका हात मे की खुल्ली वाली किताब ली ली.”<verse eid="REV 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9" />मे ने स्वर्गदूत का नजीक जय खे बोल्यो, “या छोटी किताब मेखे दे.” वोने मरासे बोल्यो, “ले येखे खै ले. ह्या तरा पेट मे कडवो तो कर्‍हे, पर तरा मुडा मे मवरुस का जसी मीठ्ठो लग्हे.”<verse eid="REV 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 10:10" />आखरी मे व्हा छोटी किताब वा स्वर्गदूत का हात से लिखे खै लियो. वु मरा मुडा मे मवरुस जसो मीठ्ठो तो लग्हे, पर जब वोखे खै लियो, ते मरो पेट कडवो हुय गयो. <verse eid="REV 10:10" /><verse number="11" style="v" sid="REV 10:11" />तब मरा से यो बोल्यो गयो, “तोखे खुप जसा दुन्या, अरु जातहोन, अरु भाषाहोन अरु राजाहोन का बारे मे फिर भविष्यव्दाणी करणु हय.”<verse eid="REV 10:11" /></para>
  <chapter eid="REV 10" />
  <chapter number="11" style="c" sid="REV 11" />
  <para style="s">दो गवा</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1" />फिर मेखे मोजन का लिये लकडी दि गय, अरु कोय ने बोल्यो, “वुठ का परमेश्वर कि मन्‍दिर अरु वेदी, अरु मंदीर मे आराधना उ करण आलो कि गिनती करी ले. <verse eid="REV 11:1" /><verse number="2" style="v" sid="REV 11:2" />पन मन्‍दिर का बाहेर को अंगन छोडी दे; वो खे मत मोजे क्युकि वु गैरयहूदिहोन खे दियो गयोस हइ, अरु वे पवित्र नगर खे बेचालीस महीना तक खुघो दिह्ये. <verse eid="REV 11:2" /><verse number="3" style="v" sid="REV 11:3" />अरु मी अपनो दो गवा खे खुल्ली छोडी दे एक हजार दो सौव आठ दिन तक भविष्यवाणी करी वे उनका बोरा का कपडा होड्या हुया जे खे दुख प्रद्रषीत करता था.”<verse eid="REV 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4" />ये वे ही जैतून का दो झाड अरु दो ओडा हइ जो जमीन को प्रभु का जसौ खडो ऱ्हेस हइ. <verse eid="REV 11:4" /><verse number="5" style="v" sid="REV 11:5" />अरु अगर कोय वुनखे दुख पहुचानो चाहस हइ, ते दुशमन मुडा मे से अंगार नीकालीखे उनका दुसरा खे राख करस हइ. अरु अगर कोय वुनखे कोय दुख पहुचानो चाह्ये का ते जरुरत या रीति से मारी डाल्यो जाह्ये. <verse eid="REV 11:5" /><verse number="6" style="v" sid="REV 11:6" />वुनखे अधिकार हइ कि बद्दल खे बन्द कऱ्हे, कि वुनकी भविष्यव्दाणी का दिन मे झरना को पाणी नी गिऱ्ये. अरु वुन खडा सब पाणी का झरना पर अधीकार हइ कि वोखे खुन बनाह्ये का अरु जब जब चाह्ये तब तब जमीन पर हर तरीका कि विपत्ती लाह्ये.<verse eid="REV 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7" />जब वे अपनी गवय दि चुक्या, ते यथाह जनवर कुण्ड मे से निकाले, वोने वाद विवाद करीखे वुनखे जितन का अरु वुनखे मारी डालह्ये. <verse eid="REV 11:7" /><verse number="8" style="v" sid="REV 11:8" />वुनकि लास वा बडा नगर का चौक मे पड्या ऱ्हियेका जो आत्मा का रुप से सदोम अरु मीस्र बोल्यो जास हइ, जहा वुनको प्रभु भी क्रुस पर चडयो गयो थो. <verse eid="REV 11:8" /><verse number="9" style="v" sid="REV 11:9" />सब दुन्या अरु भाषाहोन अरु जातहोन का दुन्या वोकि लाश खे साडे तिन दिन तक देखते ऱ्हियेका अरु वोकि लाश मरगट मे रखन नी देन. <verse eid="REV 11:9" /><verse number="10" style="v" sid="REV 11:10" />जमीन पर र्‍हेन आला खुशी अरु मगम हुये खे अरु एक दुसरा का नजिक दान भेज्यो, क्युकि ये दो भविष्यव्दक्ताहोनने जमीन का ऱ्हेनवाला खे सतायो थो. <verse eid="REV 11:10" /><verse number="11" style="v" sid="REV 11:11" />पन साडे तिन दिन का बाद परमेश्वर का तरप से जिवन कि सास वोमे घुसिगो, अरु वे अपना पाय का वुपर खडो हुय गयो, अरु वुनका देखनआला पर बडो डर हुय गो. <verse eid="REV 11:11" /><verse number="12" style="v" sid="REV 11:12" />जब वुन खे बद्दल से एक बडो आवाज आयो “ह्या उपर!” ह्या सुनीखे वे बद्दल पर चेडी खे अपना दुसरा खे देखते देखते स्वर्ग पर चडयो गयो. <verse eid="REV 11:12" /><verse number="13" style="v" sid="REV 11:13" />फिर वायच टेम एक बडो भुकम्प हुयो, अरु नगर को दसवो भाग गिरी गयो. अरु वु भुकम्प से सात हजार दुन्या मरी गया, अरु बाकी डरी गया अरु स्वर्ग को परमेश्वर कि महिमा करी.<verse eid="REV 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14" />दुसरो विपत्ती बिती चुक्यो; देख्यो, तिसरो विपत्ती झल्दी आनवालो हइ.<verse eid="REV 11:14" /></para>
  <para style="s">सातवी पिपडी</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15" />जब सातवा दूतने पिपडी फुकी, ते स्वर्ग मे या बारेमे खे बडो राज हमारो प्रभु को “अरु वोकि मसीह को हुय गयो, अरु व्हा पिडमपिडि से राज कर्‍हे.” <verse eid="REV 11:15" /><verse number="16" style="v" sid="REV 11:16" />तब चोबीस सौ बुजरुक जो परमेश्वर का सामने अपना अपना राजगद्दी तरप बठ्या था का मुडा का पर गिरीखे परमेश्वर खे प्रणाम कऱ्यो. <verse eid="REV 11:16" /><verse number="17" style="v" sid="REV 11:17" />यो बोलन लग्यो</para>
  <para style="q1" vid="REV 11:17">“हे सर्वशक्तीमान प्रभु परमेश्वर,</para>
  <para style="q1" vid="REV 11:17">जो हइ अरु जो थो,</para>
  <para style="q1" vid="REV 11:17">हम तरो धन्यवाद करस</para>
  <para style="q2" vid="REV 11:17">हइ की तो ने अपनो बडा सामर्थ्य काम मे लयखे राज करणो सुरु कऱ्योस हइ.<verse eid="REV 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18" />जातहोन ने घृस्सा कऱ्यो,पर तरो घुस्सा अय पड्यो,</para>
  <para style="q2" vid="REV 11:18">अरु व्हा टेम अय पहुच्यो हइ कि मर्‍या के दुसरो कर्‍यो जाह्येका अरु तरो सेवक भविष्यव्दक्ताहोन</para>
  <para style="q2" vid="REV 11:18">अरु पवित्र दुन्या खे</para>
  <para style="q1" vid="REV 11:18">अरु वे छोटा बडा खे जो तरा नाम से डरस हइ</para>
  <para style="q2" vid="REV 11:18">बदली दियो जाह्यु</para>
  <para style="q1" vid="REV 11:18">अरु जमीन खे बिगाडनआलो खतम कर्‍यो जाह्ये.”<verse eid="REV 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19" />तब परमेश्वर कि मन्‍दिर स्वर्ग मे हइ,व्हा खोल्यो गयो,अरु वोकि मन्‍दिर मे उनकी वाचा को संदूक दिखाय दियो; बिजलीहोन अरु आवाज अरु गर्जन अरु भुकम्प हुयो अरु बडी गार गिऱ्यो.<verse eid="REV 11:19" /></para>
  <chapter eid="REV 11" />
  <chapter number="12" style="c" sid="REV 12" />
  <para style="s1">बय अरु बडोकाम अजिगर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1" />फिर स्वर्ग मे एक बडो चिन्हो दिखय दियो अगर एक बय जो सुरज होड्यो हुयो थो, अरु चाद वोका पय तल्ले थो, अरु वोका माथा पर बारा तारा को मुकुट थो. <verse eid="REV 12:1" /><verse number="2" style="v" sid="REV 12:2" />व्हा दोजिव हुये खे अरु चिल्लाती थी क्युकि प्रसव कि दुख मे थी.<verse eid="REV 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3" />एक अरु स्वर्ग मे दिखय दियो, एक बडो लाल अजिगर थो, जेका सात माथा अरु दस सींग था अरु वोका माथा पर सात राजमुकुट था. <verse eid="REV 12:3" /><verse number="4" style="v" sid="REV 12:4" />वोकि सेपटी ने बद्दल का एक तिसरा को खिचिखे जमीन पर डाली दियो.व्हा अजिगर वा बय का सामने जो सनज्यो थो, खडो हुयो कि जब बच्चो देते ही वु बच्चा खे गिली लियो. <verse eid="REV 12:4" /><verse number="5" style="v" sid="REV 12:5" />व्हा बेटो हुयो जो लोखण्ड को राजदण्ड लिये हुयो सब जातहोन पर राज करणा पर थो, अरु व्हा बच्चो एका एक परमेश्वर का पास अरु वोकी राजगद्दी का पास लकडी पहुचय दियो गयो. <verse eid="REV 12:5" /><verse number="6" style="v" sid="REV 12:6" />अरु वा बय वा जंगल मे भागी गय, झाहा परमेश्वर की तरप से वोका वासते एक जगा तैयार कर्या गइ थी कि व्हा वु एक हजार दो सौ साठ दिन तक पाल्य जाह्ये. <verse eid="REV 12:6" /><verse number="7" style="v" sid="REV 12:7" />फिर स्वर्ग मे वाद विवाद हुयो, मीखाइल अरु स्वर्गदूत अजिगर से झगडन खे नीकल्या. अरु अजिगर अरु वोको दूत वुनखे झगड्हे, <verse eid="REV 12:7" /><verse number="8" style="v" sid="REV 12:8" />पन प्रबल नी हुयो, अरु स्वर्ग मे वुनका वासते फिर जगा नी र्‍ही. <verse eid="REV 12:8" /><verse number="9" style="v" sid="REV 12:9" />जब व्हा बडो अजिगर, अगर उ जुन्नो साप जो इब्लीस अरु सैतान बोल्यो जास हइ अरु सब जगत को भरमानवालो हइ जमीन पर गिरय दियो गयो, अरु वोको दूत वोका सात गिरय दिया गया.<verse eid="REV 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10" />फिर मे ने स्वर्ग से यो उच्चो आवाज आते हुयो सुन्यो, “आब हमारो परमेश्वर को उध्दार अरु सामर्थ्य अरु राज अरु वोकि मसीह को राज को अधिकार प्रकट हुयोस हइ, क्युकि हमारो भैइहोन पर दोष लगानवालो, जो दिन-रात हमारो परमेश्वर का सामने वोका पर दोष लगायो करतो थो, <verse eid="REV 12:10" /><verse number="11" style="v" sid="REV 12:11" />वे मुडा को खुन कारन अरु अपनी गवय को वचन को का रन वोका पर जयवन्त हुयो, अरु वुनने अपना जान खे लाड नी जान्यो, ह्या तक कि मृत्यु भी सय लियो. <verse eid="REV 12:11" /><verse number="12" style="v" sid="REV 12:12" />यो करन हे स्वर्ग अरु वोमे र्‍हेन आलो, मगम हुये. हे जमीन का अरु नद्दी का तुन पर हाय! क्युकि सैतान बडा घुस्सा का सात तुमारा पास आयो तुम तक पहुची गयो हइ. वह बडो हइ क्युकि जन्यो हइ कि वोको जरा सी टेम अरु बाकि हइ.”<verse eid="REV 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13" />जब अजिगर ने देख्यो कि मी जमीन पर गिरय दियो गयो हय, ते वा बय खे जो बेटो परदा होते ही सतायो. <verse eid="REV 12:13" /><verse number="14" style="v" sid="REV 12:14" />पन वा बय खे बडा घुब्बड का दो पंग दिया गया कि साप का सामने से उडीखे जंगल मे वा जगा पहुची जा व्हा एक टेम अरु टेंम, अरु आदा टेम तक पच्यो जाये. <verse eid="REV 12:14" /><verse number="15" style="v" sid="REV 12:15" />अरु साप ने वा बय का पीछे अपनो मेडो से नंद्दी का सामने पानी बोहानो कि वोखे नंद्दी से बोहय दे. <verse eid="REV 12:15" /><verse number="16" style="v" sid="REV 12:16" />पन जमीन ने वा बय कि मद्दत करी, अरु अपना मेडो खोलीखे वा नंद्दी खे जो अजिगर ने अपना मुडा से बोहायो थो पी लियो. <verse eid="REV 12:16" /><verse number="17" style="v" sid="REV 12:17" />जब अजिगर बय पर घृस्सा हुयो, अरु वोकि शेष सन्तान से, जो परमेश्वर कि आज्ञाहोन को मानस अरु यीशु कि गवय देन पर रुख्यो हइ, झगडन खे गयो <verse eid="REV 12:17" /><verse number="18" style="v" sid="REV 12:18" />अरु वु नद्दी कि रेती पर खडो हुयो.<verse eid="REV 12:18" /></para>
  <chapter eid="REV 12" />
  <chapter number="13" style="c" sid="REV 13" />
  <para style="s">दो जनवर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1" />तब मे ने एक जनवर खे नद्दी मे से नीकलते हुयो देख्यो जेखे दस सींग अरु सात माथो थो. सिंग पर दस राजमुकुट, वोका माथा पर परमेश्वर की टिंगल को नाम लिख्यो हुयो थो. <verse eid="REV 13:1" /><verse number="2" style="v" sid="REV 13:2" />जो जनवर मे देख्यो वु चिता का जसो थो. अरु वोका पाय भालू का जसा अरु मेडो सेर का जसो थो. अरु अपनी राजगद्दी जसी अरु बडो अधिकार वोखे दियो. <verse eid="REV 13:2" /><verse number="3" style="v" sid="REV 13:3" />मे ने वोका माथा मे से एक पर असो बडो घाव लग्यो देख्यो जसो कि वु मरना पर हइ, फिर वोको जानजाना को घाव अच्छो हुय गयो, अरु सब जमीन का दुन्या वु जनवर का पिछे पिछे अच्मंबो करते हुये चल्या. <verse eid="REV 13:3" /><verse number="4" style="v" sid="REV 13:4" />दुन्या ने अजिगर कि पुजा करी क्युकि वोने जनवर खे अपनो अधिकार दि दियो थो, अरु यो बोलीखे जनवर कि पूजा करी “यो जनवर का जसो कोन हइ? कोन येका से वाद विवाद करस हइ?”<verse eid="REV 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5" />बडी बात अरु टिंगल करण का वासते वोखे एक मेडो दियो गयो, अरु वा बेचालीस महीना तक काम करण को अधिकार दियो गयो. <verse eid="REV 13:5" /><verse number="6" style="v" sid="REV 13:6" />तब वोने परमेश्वर कि टिंगल करण का वासते मेडो खोल्यो कि वोको नाम अरु वोकि झोपडि मंनज्हे स्वर्ग का र्हेनआला कि टिंगल कर्‍हे. <verse eid="REV 13:6" /><verse number="7" style="v" sid="REV 13:7" />वोखे यो भी अधिकार दियो गयो कि पवित्र दुन्या से झगड अरु वोका पर जय मील्हे का अरु वोखे हर एक थोडा अरु दुन्या अरु भाषा अरु जात पर अधिकार दियो गयो. <verse eid="REV 13:7" /><verse number="8" style="v" sid="REV 13:8" />जमीन का वे सब र्‍हेनवालो, जेको नाम वोखे मेडा का जिवन कि किताब मे लिख्यो नी गयो जो जगत कि उत्पत्ति का टेम से घात हुयो हइ, वु जनवर कि पुजा कर.<verse eid="REV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9" />जे कान हुये वे सुन. <verse eid="REV 13:9" /><verse number="10" style="v" sid="REV 13:10" />जेखे कैद मे गिर्‍यो हइ व्हा कैद मे गिरीयो. जो तलवार से मार्‍यो गयो, जरुरती हइ व्हा तलवार से मार्यो जाह्ये. पवित्र दुन्या को धीरज अरु विश्वासये मे हइ.<verse eid="REV 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11" />फिर तब मेने एक जनवर खे जमीन मे से नीकलते देख्यो ओका मुडा का से दो सिंग थो,अरु व्हा अजिगर का जसो बोलतो थो. <verse eid="REV 13:11" /><verse number="12" style="v" sid="REV 13:12" />व्हा पयलो जनवर को सब अधिकार ओका सामे काम लातो थो. अरु जमीन अरु ओका र्‍हेनवाला से उ पयलो जनवर को जेको जान बडो घाव अच्छो हुइ गयो थो, पुजा करतो थो. <verse eid="REV 13:12" /><verse number="13" style="v" sid="REV 13:13" />व्हा बडो-बडो चिन्हो दिखा तो थो यो जब की इन्सान का सामने स्वर्ग से पृथ्वी पर अंगार गिरय देती थी. <verse eid="REV 13:13" /><verse number="14" style="v" sid="REV 13:14" />उ चिन्हो करण जेने उ जानवर का समाने देखन को अधिकार ओका दियो गयो थो, व्हा पृथ्वी का ऱ्हेनवालो खे भरमाता तो अरु पृथ्वी खे ऱ्हेनवालो से बोलतो थो की जो जनवर का तलवार लगी थी व्हा जी गयो हइ, ओकी मूर्ति बनायो. <verse eid="REV 13:14" /><verse number="15" style="v" sid="REV 13:15" />ओका उ जनवर की मूर्ति मे जान डालना को अधिकार दियो गयो कि जनवर की चित्र बोलन लग्यो अरु जेत्ता दुन्या उ जनवर कि मूर्ति की पुजा नी कर, ओने मरी डाल्यो. <verse eid="REV 13:15" /><verse number="16" style="v" sid="REV 13:16" />ओने छोटा बडा लकपती गरीब खे आजाद सेवक सब को जवनो यो अरु ओका माथा पर एक सिक्का मारी दियो, <verse eid="REV 13:16" /><verse number="17" style="v" sid="REV 13:17" />कि ओका छोड जेका पर सिक्का मनजे उ जनवर को नाम यो ओको नाम को अंक हुये दुसरा कोय लेनो-देनो नी करी सुकु.<verse eid="REV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18" />ज्ञान ये मे हइ. जेको दिमाक हुये व्हा वे जनवर को अंक जोडी ले, क्युकि व्हा इन्सान को अंक हइ, अरु ओको अंक छे सौ छैसट हइ.<verse eid="REV 13:18" /></para>
  <chapter eid="REV 13" />
  <chapter number="14" style="c" sid="REV 14" />
  <para style="s">मेढो अरु वोका दुन्या</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1" />फिर मे ने नजर करी, अरु देख्यो, व्हा मेढो सिय्योन टेकडा पर खडो हइ, अरु ओका हात मे एक लाख चौरेचालीस हजार झन हइ, जेको माथा पर वोको अरु वोको बाप को नाम लिख्यो हुयो हइ. <verse eid="REV 14:1" /><verse number="2" style="v" sid="REV 14:2" />अरु स्वर्ग से तोखे एक असी बात सुनय दियो जो पानी कि खुप धारहोन अरु बडो गरझनो को जसो आवाज थो अरु जो आवाज मे ने सुन्यो व्हा असो थो समजो वानी बजानवाली वानी बजय रास हय <verse eid="REV 14:2" /><verse number="3" style="v" sid="REV 14:3" />वे राजगद्दी का सामे अरु चारी जनवर अरु बापदादा खे सामने एक नवो गिद गय राथा. वे एक लाख चौरेचालीस हजार जान को छोडी जो पृथ्वी पर से मोल लिये गयो थो, कोय भी वा गिद नी सीख सकतो थो. <verse eid="REV 14:3" /><verse number="4" style="v" sid="REV 14:4" />ये वे हइ जो बयहोन का साथ अशुध्द नी हुयो, पन कुव्वारो हइ. ये वे ही कि बोली जास हइ, वे ओका पीछे चलीदे हइ. ये तो परमेश्वर को नियम पैयले होन का लिये इन्सान मे से मोल लियो गयो हइ. <verse eid="REV 14:4" /><verse number="5" style="v" sid="REV 14:5" />ओका मुडा से कभी झुठ नी नीकल्यो थो, वे नीर्दोष हइ.<verse eid="REV 14:5" /></para>
  <para style="s">तीन स्वर्गदूत</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6" />फिर मे ने अरु स्वर्गदूत का बद्दल का बीच मे उड्यो हुयो देख्यो, जेका पास पृथ्वी पर का ऱ्हेनवालो की हर एक जात, अरु कुल, अरु भाषा, अरु दुन्या, सुनन का लिये सनातन सुसमाचार थो. <verse eid="REV 14:6" /><verse number="7" style="v" sid="REV 14:7" />ओने बडो शब्द से बोल्यो “परमेश्वर से डर्यो, अरु ओकि महिमा कर क्युकि ओको न्याय करण को टेम आयो हइ. अरु ओको भजन कर, जेने स्वर्ग अरु पृथ्वी अरु संमुदर अरु पाणी कि स्रोत बनायो.”<verse eid="REV 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8" />फिर येका बाद अरु, एक दुसरो, स्वर्गदूत यो बोल्यो हुयो आयो, “गिरी गयो, वा बडो बेबीलोन गिरी पड्यो,जेने अपनो व्यभिचार को कोपमय मदिरा सब जातहोन खे पिलायो हइ.”<verse eid="REV 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9" />फिर येका बाद एक अरु तीसरो, स्वर्गदूत बडो बोल से यो बोलतो आयो, “जो कोय भी उ जनवर अरु ओकी मूर्ति कि पुजा कर, अरु अपनो माथो यो अपनो हात पर ओकी छाप ले <verse eid="REV 14:9" /><verse number="10" style="v" sid="REV 14:10" />वा परमेश्वर को डर को मदिरा का जो बिना मीलावट को क्रोध को कठोर मे डल्यो गयो हइ, पीस अरु पवित्र स्वर्गदूत का सामने अरु मेडा का सामने आंग अरु गन्धक का पीडो मे पडे. <verse eid="REV 14:10" /><verse number="11" style="v" sid="REV 14:11" />ओको दुख को धुवो पिडमपिडि से उठ्यो ऱ्हेस, अरु जो उ जनवर अरु ओकि मूर्ति कि पुजा करस हइ, अरु जो उनको नाम को छाप लिये हइ, ओखे रात दिन चैन नी मीलस.”<verse eid="REV 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 14:12" />पवित्र दुन्या को धीरज येमे हइ, जो परमेश्वर को आज्ञाहोन खे मानस अरु यीशु पर विश्वास रखस हइ.<verse eid="REV 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13" />फिर मी ने स्वर्ग से यो बोल सुन्यो, “लिख जो मृतक प्रभु मे मरस हइ, वे आब से अनाज हइ.”</para>
  <para style="p" vid="REV 14:13">आत्मा बोलस हइ, “व्हा,क्युकि वे अपनो सब परिश्रम से आराम पास,अरु ओको कर्य ओका साथ लीस हइ.”<verse eid="REV 14:13" /></para>
  <para style="s">कटिन</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14" />मे ने नजर के, अरु देख, एक उजालो बद्दल हइ, अरु उ बद्दल पर इन्सान को बेटो सरीखो कोय भी बैठ्यो हइ, जेका पर सोना को मुकुट अरु हात मे दराती हइ. <verse eid="REV 14:14" /><verse number="15" style="v" sid="REV 14:15" />फिर एक अरु स्वर्गदूत ने मन्‍दिर मे से नीकलीखे ओका से, जो बद्दल पर बठ्यो थो,बडो बोल से पुकारी खे बोल, “अपनो लगय खे लवनी कर, क्युकि लवने को टेम आ पोच्यो हइ, येका लिये की पृथ्वी को खेत पकी गयो हइ.” <verse eid="REV 14:15" /><verse number="16" style="v" sid="REV 14:16" />आखरी जो बद्दल पर बठ्यो थो ओने पृथ्वी पर अपनो हसायु लगायो,अरु पृथ्वी को लवनी को गयो.<verse eid="REV 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17" />फिर एक अरु स्वर्गदूतउ मन्‍दिर मे से नीकल्यो जो स्वर्ग मे हइ, अरु ओका पास भी अच्छो हस्यो थो<verse eid="REV 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 14:18" />फिर एक अरु स्वर्गदूत का जेका आंग पर अधिकार थो, वेदी मे से नीकल्यो अरु जेका पास अच्छो हस्यो थो ओका से उचो बोल से बोल्यो, “अपनो अच्छो हस्यो लगय खे पृथ्वी को दाख को गुच्छो खे काटि ले, क्युकि ओकी अंगूर पकि गयइगस हइ.” <verse eid="REV 14:18" /><verse number="19" style="v" sid="REV 14:19" />तब उ स्वर्गदूत ने पृथ्वी पर अपनो हसायु लगयो अरु पृथ्वी को अंगूर को फल काटिखे अपनो परमेश्वर का दुख का बडो रसकुंण्ड मे डाली दियो. <verse eid="REV 14:19" /><verse number="20" style="v" sid="REV 14:20" />अरु नगर का बाहेर उ रसकुंण्ड मे देख्यो गयो, अरु रसकुंण्ड मे से येतनो खुन निकल्यो की घोडा की लगाम तक पोच्यो, अरु कोन तक बोहय गो.<verse eid="REV 14:20" /></para>
  <chapter eid="REV 14" />
  <chapter number="15" style="c" sid="REV 15" />
  <para style="s">आखरी विपत्तिहोन लानवाला दूत</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1" />फिर मे ने बद्दल मे एक अरु बडो अरु अद्भुत चिन्ह देख, अगर सात स्वर्गदूत जे पास सात आखरी विपतिहोन थो,क्युकि ओका खत्म हुए जाना पर परमेश्वर को दुख, आखरी हइ.<verse eid="REV 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2" />फिर मेने काच का जसो समुदर देख्ये दियो जेमे समजो अंगार मीली हुये. अरु मेने देख्यो की जिनने जनवर कि मेर्ती पर अरु ओको नाम पर विजय मीली हइ काच को समुदर पर खडो हइ नजिक परमेश्वर कि वाणीहोन दि. <verse eid="REV 15:2" /><verse number="3" style="v" sid="REV 15:3" />अरु वे परमेश्वर को सेवक मूसा को गीद कि अरु मुडा को गीद गय खे बोलता था ,</para>
  <para style="q1" vid="REV 15:3">“हे सर्वशक्‍तिमान प्रभू परमेश्वर,</para>
  <para style="q2" vid="REV 15:3">तरो कर्य महान अरु अद्भुत हइ.</para>
  <para style="q1" vid="REV 15:3">हे राष्ट्र को राजो कि</para>
  <para style="q2" vid="REV 15:3">तरी चाल ठिक अरु सच्ची हइ.” <verse eid="REV 15:3" /><verse number="4" style="v" sid="REV 15:4" />“हे प्रभु</para>
  <para style="q1" vid="REV 15:4">कोन तरा से नी डरे अरु तरो नाम को महिमा करस?</para>
  <para style="q2" vid="REV 15:4">क्युकि फक्त तु पवित्र हइ.सब जातहोन अयखे तरा सामने आराधना करस कि क्युकि</para>
  <para style="q2" vid="REV 15:4">तरो न्याय काम प्रगट हुए गयो हइ.”<verse eid="REV 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5" />येका बाद मेने देख्यो कि स्वर्ग मे झोपडि मे प्रतीज्ञा को तम्बु कि मन्‍दिर खोल्यो गयो. <verse eid="REV 15:5" /><verse number="6" style="v" sid="REV 15:6" />अरु वे सात स्वर्गदूत जे, पास विपतिहोन थोकाम लमल को शुध्द अरु चमकदार कपडा पेन्यो अरु छाती पर सोना को पट्टो बाधी दियो मन्‍दिर से नीकल्यो. <verse eid="REV 15:6" /><verse number="7" style="v" sid="REV 15:7" />तब उ चार जनवरहोन मे से एक ने उ सात स्वर्गदूत, परमेश्वर, जो हमेशा हमेशा जिस हइ, दुख से भऱ्यो हुए सोना को सात कटोरो दियो. <verse eid="REV 15:7" /><verse number="8" style="v" sid="REV 15:8" />अरु परमेश्वर कि महिमा अरु ओकि सामर्थ्य कारन मन्‍दिर खुसी से भरी गयो, अरु जब तक उ सात स्वर्गदूत कि सात विपतियो खतम नी हुयो जब तक कोय भी मन्‍दिर मे नी जय सक्यो.<verse eid="REV 15:8" /></para>
  <chapter eid="REV 15" />
  <chapter number="16" style="c" sid="REV 16" />
  <para style="s">परमेश्वर को प्रकोप का सात कटोरो</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1" />फिर मे ने मन्‍दिर मे कोय को उचो बोल से उ सात स्वर्गदूत से यो बोलते सुन्यो, “जा, परमेश्वर खे दुख का सात कटोरा खे पृथ्वी पर पलटय दे.”<verse eid="REV 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2" />पयलो दूत अरु अपनो कटोरो पृथ्वी पर उंडय दियो. अरु वे इन्सान खे जेका पर जनवर को चिन्ह थो जो ओकि पुजा करतो थो, उन एक पर भयानक दुख आलो छालो नीकली गयो.<verse eid="REV 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3" />दुसरा ने अपनो कटोरा समुदर पर पलदय दियो, अरु वा मरो हुयो इन्सान का मन से खुन जसो बनी गयो, अरु समुद्र मे को हर एक जीव धारी मरी गयो.<verse eid="REV 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4" />फिर तीसरा ने नद्दीहोन अरु पानी अपना कटोरा का धबधबा पर उलटय दियो, अरु नद्दी अरु धबधबो खुन बनी गया. <verse eid="REV 16:4" /><verse number="5" style="v" sid="REV 16:5" />अरु मेने पानी को स्वामी स्वर्गदूत खे यो बोलते सुन्यो, “हे पवित्र जो हइ अरु असो, तु न्यायी हइ अरु तोने यो न्याय बरोबर कऱ्यो हइ. <verse eid="REV 16:5" /><verse number="6" style="v" sid="REV 16:6" />क्युकि ओने परमेश्वर का दुन्या अरु भविष्यव्दक्ताहोन को खुन बोहायो थो, अरु तोने उनखे पिन खे खुन यी दियो, क्युकि वे येका योग्य हइ.” <verse eid="REV 16:6" /><verse number="7" style="v" sid="REV 16:7" />फिर मे ने वेदी से यो बोल सुन्यो, “हुयो, हे सर्वशक्तिमान प्रभु परमेश्वर तरो नीर्णय ठिक अरु सच्चो हइ.”<verse eid="REV 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8" />स्वर्गदूत ने अपनो कटोरा सुरज पर उंडल दियो, अरु उ इन्सान का आंग से झुलसो देन को अधिकार दियो गयो. <verse eid="REV 16:8" /><verse number="9" style="v" sid="REV 16:9" />अरु इन्सान भयानक गर्मी से झुलस गए ,अरु परमेश्वर का नाम को जेको ये विपतियो पर अधिकार हइ, नीन्दा का पर ओकि महिमा करण का लिये मन नी फिरायो अरु नी महीमा करी.<verse eid="REV 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10" />पाचवो स्वर्गदूत ने अपनो कटोरा उ जनवर का राजगद्दी पर दियो, अरु ओको राज पर अन्धेरा हुय गयो. दुन्या दुख कारण अपनी जीभ चाबन लग्या, <verse eid="REV 16:10" /><verse number="11" style="v" sid="REV 16:11" />अरु अपनी पडायो अरु फोडो करण स्वर्ग परमेश्वर को नीन्दा को पर अपनो अपनो काम से मन नी फिरायो.<verse eid="REV 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12" />साव्वो स्वर्गदूत ने अपनो कटोरा महानदी फरात पर उंडल दियो, अरु ओको पानी सुख गयो को पूर्व दिशा से आन आला राजाहोन का लिये रस्ता तैयार हुय जाए. <verse eid="REV 16:12" /><verse number="13" style="v" sid="REV 16:13" />फिर मे ने उ अजिगर का मुडा से अरु उ जनवर का मुडा से, अरु उ झुठ भविष्यव्दक्ता को मुडा से तीन अशुध्द आत्माहोन खे मेढको का रुप मे नीकलते देख्यो. <verse eid="REV 16:13" /><verse number="14" style="v" sid="REV 16:14" />ये चिन्ह चमत्कार दिखनआली बुरीआत्मा हइ, ये तीन आत्माहोन जो सब जगत का राजाहोन का पर नीकलीखे येका लिये जीत्यो हइ कि ओने सर्वशक्तिमान परमेश्वर का उ बडा दिन की लडाइ का लिये जमा कर.<verse eid="REV 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 16:15" />“देख मी चोर का जसो अउस हइ. धन्य वा हइ जो जागो ऱ्हेस हइ, अरु अपना कपडा को देखरेख करस हइ कि नंगो नी फिरस अरु दुन्या ओखे लाजवाने होते नी देख्ये का”<verse eid="REV 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16" />फिर वा बुरीआत्मा वा जगा कऱ्यो जो इब्रानी मे हरमनीदोन बोलस हइ.<verse eid="REV 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17" />सातवो स्वर्गदूत अपनो कटोरा हवा पर दियो, अरु मन्‍दिर राजगद्दी से वा बडो बोल हुयो, “ हुइ चुक्यो!” <verse eid="REV 16:17" /><verse number="18" style="v" sid="REV 16:18" />फिर बिजली चमकस, अरु बद्दल अवाज गर्जन हुए, अरु एक असो भयानक भूकम्प हुयो कि जब से इन्सान को उत्पत्ति पृथ्वी पर हुयो, तब से असो भयानक भुकम्प कभी नी अयो थो. <verse eid="REV 16:18" /><verse number="19" style="v" sid="REV 16:19" />येका से उ बडो नगर का तीन टुकडो हुय गयो अरु सब राष्ट्र को नगर गिरी गयो. अरु बडो बाबेल को स्मरण परमेश्वर बडो बाबेल खे दण्ड देन का लिये याद हुयो, ही वा अपनो घुस्सा की जलजलाहाट को मदिरा उ पिलायो. <verse eid="REV 16:19" /><verse number="20" style="v" sid="REV 16:20" />अरु हर एक टेकडो अपनी जगा से टल गयो, अरु पात नी चल. <verse eid="REV 16:20" /><verse number="21" style="v" sid="REV 16:21" />बद्दल से इन्सान पर मन-मन भऱ्यो, बडो गार का अरु येका लिये को यो विपत्ति बोल ही भारी थो, दुन्या ने आलो कि विपत्ति करन परमेश्वर को नीन्दा को.<verse eid="REV 16:21" /></para>
  <chapter eid="REV 16" />
  <chapter number="17" style="c" sid="REV 17" />
  <para style="s">प्रसिध्द वेश्या</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1" />येका बाद जो सात स्वर्गदूत का पास वे सात कटोरो थो, ओमे से एक ने अयखे मरासे यो बोल्यो, “इधर आ, मी तोखे वा बडी वेश्या को दण्ड दिखायु, जो भोत से पानी पर बैठी हइ, <verse eid="REV 17:1" /><verse number="2" style="v" sid="REV 17:2" />जेका साथ पृथ्वी का राजाहोन ने व्यभिचार कऱ्यो. अरु पृथ्वी का ऱ्हेनआला ओको व्यभिचार की मदिरा से नशामे चुर हुइ गया था.”<verse eid="REV 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3" />मेखे पुरीरीतिसे आत्मा ने कबजो कर्‍यो फिर स्वर्गदूत मेखे जंगल, ले गयो,अरु मी ने लाल रंग, जनवर पर जो नीन्दा का नाम से भरी थो, एक बैय खे बठी हुइ देख्यो. <verse eid="REV 17:3" /><verse number="4" style="v" sid="REV 17:4" />यो बैय बैंगनी अरु लाल रंग, कपडा पेनी थी ,अरु सोनो अरु बहुमूल्य रत्नो मणिहोन अरु मोतिहोन से सजी हुइ थी, अरु ओका हात मे एक सोना की कटोरो थो जो बुरा सामनहोन से अरु ओका व्यभिचार को अशुध्द सामनहोन से भऱ्यो हुयो थो. <verse eid="REV 17:4" /><verse number="5" style="v" sid="REV 17:5" />अरु ओका माथा पर यो नाम लिख्यो थो, “भेद-बडो हे बेबीलोन जमीन की सब वेश्याहोन अरु बुरा चिजहोन की माय.” <verse eid="REV 17:5" /><verse number="6" style="v" sid="REV 17:6" />मेने वा बैय खे पवित्र दुन्या को खुन</para>
  <para style="p" vid="REV 17:6">अरु यीशु कि गवाही खे पीने से मस्त देस: उ देखीखे मी गयो. <verse eid="REV 17:6" /><verse number="7" style="v" sid="REV 17:7" />“तब उ स्वर्गदूत ने मरा से बोल्यो,” तू चकित हुयो? मी ये बैय अरु उ जनवर को जेका पर वा सवार हइ अरु जेका सात माथा अरु दस सिग हइ, वा भेद बतास हय. <verse eid="REV 17:7" /><verse number="8" style="v" sid="REV 17:8" />जो जनवर तोने देख्यो हइ, उ पैयले तो थो पर अब नी हइ, अरु अथाह कुण्ड से नीकलि खे खतम हुय जास. अरु पृथ्वी का ऱ्हेनवाला जेको नाम जगत की उत्पत्ति को टेम से जिवन को किताब मे लिख्यो नी गयो, ये जनवर को यो दशा देखी, को पैयले थो अरु अब नी हइ अरु आ जास, अचम्भा करस.<verse eid="REV 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9" />उ बुध्दि का लिये जेमे ज्ञान हइ जेका पर वा बैय हइ. <verse eid="REV 17:9" /><verse number="10" style="v" sid="REV 17:10" />अरु उनमे से पाच राजा भी हइ,पाच ते हुए चुक्यो हइ,अरु एक अभी हइ,अरु एक अब तब आयो नी अरु जब अयो ते कुछ टेम तक ओको ऱ्हेस भी अवशय हइ. <verse eid="REV 17:10" /><verse number="11" style="v" sid="REV 17:11" />जो जंगली जनवर से पैयले थो, अरु अब नी हइ, उ अब आठवो हइ अरु उ सात मे से उत्पन्न हुयो अरु खतम हुइ जाये .<verse eid="REV 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12" />“जो दस संगी तो ने देख्या वे दस राजा हइ जेने अब तक राज्य नी पायो,पर उ जंगल जनवर, साथ घडी भर, लिये राजाहोन को अधिकार पास. <verse eid="REV 17:12" /><verse number="13" style="v" sid="REV 17:13" />ये सब एक मन हुए,अरु वे अपनी अपनी सामर्थ्य अरु अधिकार उ जनवर, देस. <verse eid="REV 17:13" /><verse number="14" style="v" sid="REV 17:14" />वे मेडा से लडस अरु मेढो उनका पर जय पाये,क्युकि उ प्रभुहोन को प्रभु अरु राजाहोन को राजा हइ,अरु जो बुलाया हुया अरु चुन्या हुया अरु विश्वास हइ वे ओका साथ हइ. वे भी जय पाये.”<verse eid="REV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15" />फिर ओने मरा से बोल्यो, “जो पानी तो ने देख्यो जेका पर वेश्या बठी हइ,वे तो दुन्या अरु गर्दी अरु जातहोन अरु भाषाहोन हइ. <verse eid="REV 17:15" /><verse number="16" style="v" sid="REV 17:16" />जो दस संग तो ने देखा,वे अरु जनवर उ वेश्या से अरु ओका मास खइ जये,अरु ओखे अंगार मे जलय दिये. <verse eid="REV 17:16" /><verse number="17" style="v" sid="REV 17:17" />अपनो परमेश्वर ओको मन मे जब तक परमेश्वर, वचन पुरो नी हुये तब तक एक मन कोय खे अपनो अपनो राज्य जनवर खे दिह्ये.<verse eid="REV 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 17:18" />“वा बैय खे जेखे तोने देख्यो हइ,वाहा बडो नगर हइ जो पृथ्वी का राजाहोन पर राज्य करस हइ.”<verse eid="REV 17:18" /></para>
  <chapter eid="REV 17" />
  <chapter number="18" style="c" sid="REV 18" />
  <para style="s">बेबीलोन को काम</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1" />येका बाद मे ने एक अरु स्वर्गदूत को स्वर्ग से उतरते देख्यो, जेखे बडो अधिकार मीलीगो थो. अरु पृथ्वी ओको तेज से चमकी उठी. <verse eid="REV 18:1" /><verse number="2" style="v" sid="REV 18:2" />ओने उच्चो बोल से फुकारी खे बोल्यो,गिरी गयो,बडो बेबीलोन गिरि गयो हइ! वा बुरीआत्मा होन को नीवास,अरु हर एक अशुध्द आत्मा को अंडो,अरु हर एक अशुध्द अरु घृणित चिडी को अंडो हुइ गयो. <verse eid="REV 18:2" /><verse number="3" style="v" sid="REV 18:3" />क्युकि ओको व्यभिचार को भयानक मदिरा का कारण सब जात गिरि गयो हइ,अरु पृथ्वी का राजाहोन ने ओका साथ व्यभिचार कऱ्यो हइ,अरु पृथ्वी का बेपारी ओको सुख-विलास को भोताकय कारण धनवान हुयो हइ.<verse eid="REV 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4" />फिर मे ने स्वर्ग से एक अरु बोल सुन्यो,</para>
  <para style="q1" vid="REV 18:4">हे मरा दुन्या ओमे से नीकली के</para>
  <para style="q1" vid="REV 18:4">आयो कि तुम ओका पाप मे हिस्सेदार नी हुये,</para>
  <para style="q2" vid="REV 18:4">अरु ओकि विपत्तिहोन मे से कोय भी तु पर नी पड्यो.<verse eid="REV 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5" />क्युकि ओको पाप को ढिग स्वर्ग तक पहुची गयो हइ, अरु ओको अधर्म परमेश्वर का स्मरण आयो हइ.<verse eid="REV 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6" />जसो ओने तोके दियो हइ असो ही ओका दे,</para>
  <para style="q2" vid="REV 18:6">अरु ओका काम का जसो उ</para>
  <para style="q1" vid="REV 18:6">डबल बदली दे. जेके कटोर मे ओने भरी दियो</para>
  <para style="q2" vid="REV 18:6">थो ओमे ओका लिये डबल भरी दे.<verse eid="REV 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7" />जतनी ओने अपनी बडाइ कऱ्यो</para>
  <para style="q2" vid="REV 18:7">अरु सुख विलास कऱ्यो, येतनो ओका दुख</para>
  <para style="q1" vid="REV 18:7">अरु शोक दे. क्युकी वा अपनो मन मे बोलस हइ,</para>
  <para style="q2" vid="REV 18:7">मी रानी हुइ बठी हइ विधवा नी.</para>
  <para style="q1" vid="REV 18:7">अरु शोक मे कभी नी गिऱ्यु.<verse eid="REV 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8" />येका कारन एक हि दिन मे उ पर विपत्तिहोन अय गिरे, अगर मरनो,</para>
  <para style="q2" vid="REV 18:8">अरु भस्म करी दियो जास,</para>
  <para style="q2" vid="REV 18:8">क्युकी ओको न्यायी प्रभु परमेश्वर शक्तिमान हइ.<verse eid="REV 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9" />पृथ्वी को राजो जेने ओका साथ व्यभिचार अरु दुख-विलास कऱ्यो,जब ओको जलन को धुवो देख्यो, ते ओका लिये रोस अरु छाती पीटस. <verse eid="REV 18:9" /><verse number="10" style="v" sid="REV 18:10" />ओका दुख डर मार बडि दुर खडो हुइ बोलस, “हे बडो नगर ,बेबीलोन! हे द्दढ नगर खे हाय हाय! घडि भर मे हि तोखे दण्ड मीलि गो हइ.”<verse eid="REV 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11" />पृथ्वी को बेपारी ओका लिये रोस अरु कलपलाह्ये, क्युकी अब उनकी चिज कोय मोल नी लिह्ये. <verse eid="REV 18:11" /><verse number="12" style="v" sid="REV 18:12" />अगर सोना, चांदी, रत्न का मोति, अरु मलमल, अरु बैजनी, रेशमी,अरु लाल रंग, कपडा,अरु हर प्रकार को सुगन्धित, अरु हत्ती को दात को हर प्रकार को सामन अरु खुप किमती अरु पीतल अरु लोहो अरु संगमरस को सब भाति को सामन, <verse eid="REV 18:12" /><verse number="13" style="v" sid="REV 18:13" />अरु दालचीनी काम सालो, धूप, अत्रर, लोबानकाम दिरा, तेल का मैदा, गहु, गाय बैल का मुडा बकरीहोन, घोडो, रथ, अरु चेलो, अरु इन्सान, आंग, मन. <verse eid="REV 18:13" /><verse number="14" style="v" sid="REV 18:14" />अब तरो मन भावने फल तरा पास से जाते ऱ्हेस,अरु सुख दुख अरु वैभव की सामन तरा से दुर हुयो हइ,अरु वे फिर कदापि नी मीलस. <verse eid="REV 18:14" /><verse number="15" style="v" sid="REV 18:15" />येका सामनहोन को बेपारी जो ओका वजेसे धनवान हुइ गय था,ओकि पीडा, डर, मारी दियु खडो हुए, अरु रोस अरु विलाप हुयो बोलस. <verse eid="REV 18:15" /><verse number="16" style="v" sid="REV 18:16" />“हाय हाय यो बडो नगर जो मलमल, अरु बैजनी अरु लाल रंग का कपडा पेन्यो थो,अरु सोनो अरु मोतिहोन से सजायो थो. <verse eid="REV 18:16" /><verse number="17" style="v" sid="REV 18:17" />घडी भर मे ही ओका असो भरी धन खतम हुइ गयो.हर एक माझी अरु”</para>
  <para style="p" vid="REV 18:17">यात्री अरु मल्लाह, अरु जतनो समुदर से कमास हइ सब दुर खडो हुयो, <verse eid="REV 18:17" /><verse number="18" style="v" sid="REV 18:18" />अरु ओको जलन को धुवो देख्यो हुयो फुरीखे बोलस, “कोन सो नगर येका बडो नगर, सामने हइ.” <verse eid="REV 18:18" /><verse number="19" style="v" sid="REV 18:19" />अरु अपना अपना माथा पर धुलो डालस, अरु रोतो हुयो “अरु विलाप करते हुयो चिल्ले चिल्लय खे बोलस हाय हाय यो बडो नगर जेकी सम्पति का वजेसे समुदर का सब डोंगा आला धनी हुइ गा था, घडि भर मे ही उजडी गयो.”<verse eid="REV 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 18:20" />हे स्वर्ग, अरु हे पवित्र दुन्या, अरु प्रेरित, अरु भविष्यव्दक्ताहोन, ओका पर आनन्द कर, क्युकि परमेश्वर ने न्याय करीखे ओकासे तुमारो बदलो लियो हइ!<verse eid="REV 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21" />फिर एक बलवन्त स्वर्गदूत ने बडी चक्की, पाट, सामने एक पत्थर उठायो, अरु यो बोलिखे समुदर मे फेकी दियो, बडो नगर बाबेल असा य बडा बल से गिरायो जाह्ये अरु फिर कभी ओको पतो नी चल्यो. <verse eid="REV 18:21" /><verse number="22" style="v" sid="REV 18:22" />वीणा बजानवाला, अरु गायक, अरु बंसी बजानवाला, अरु पिपडी फुकनवाला, अरु कोइ बोल फिर कभी तरा मे सुनायो नी दे अरु कऱ्यो उघम को कोय भी, “रागीर भी फिर कभी तरा मे नी मीलस अरु चक्की, चलन को बोल फिर कभी तरा मे सुनायो नी दे. <verse eid="REV 18:22" /><verse number="23" style="v" sid="REV 18:23" />अरु दिवा को उजालो फिर कभी तरा मे नी चमकस अरु दुलो अरु दुलिन को बोल फिर कभी तरा मे सुनइ नी देनकी; क्युकी तरा बेपारी पृथ्वी, प्रधान था, अरु तरा तोटा से सब जातहोन भरमइ गइ थी.”<verse eid="REV 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 18:24" />भविष्यव्दक्ताहोन अरु पवित्र दुन्याहोन, अरु पृथ्वी पर सब घात कऱ्यो हुया को खुन ओमे मे मीली गयो.<verse eid="REV 18:24" /></para>
  <chapter eid="REV 18" />
  <chapter number="19" style="c" sid="REV 19" />
  <para style="s">स्वर्ग मे परमेश्वर की स्तुती</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1" />येका बाद मे ने स्वर्ग मे आनो बडी गर्दी खे उच्ची आवाज से यो बोलते सुन्यो, “हल्लिलुयाह! उध्दार अरु महिमा अरु सामर्थ्य हमारो परमेश्वर ही कि हइ. <verse eid="REV 19:1" /><verse number="2" style="v" sid="REV 19:2" />क्युकि वोने नीर्णय बरोबर अरु ठीक हइ.वोने वा टेम वेश्या को, जो अपनो व्यभिचार से जमीन खे भ्रष्ट करती थी, न्याय कर्‍यो अरु ओकासे अपनो सेवक खुन खे पलटयो लीयो हइ.” <verse eid="REV 19:2" /><verse number="3" style="v" sid="REV 19:3" />फिर दुसरी बार वुनने बोल्यो परमेश्वर कि स्तुती हुये “वोका जलना को धुवो पिडमपिडि से रुखस हइ!” <verse eid="REV 19:3" /><verse number="4" style="v" sid="REV 19:4" />तब चौबीसी सौ बापदादा अरु चार जनवरहोन ने गिरीखे परमेश्वर खे कर्यो, जो राजगद्दी पर बठ्यो थो. अरु बोल्यो, “आमीन, परमेश्वर कि स्तुती हुये!”<verse eid="REV 19:4" /></para>
  <para style="s">मुडाको भ्याव को खानो</para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5" />तब राजगद्दी मे से एक आवाज नीकल्यो, “हे हमारो परमेश्वर से सब डरनवालो सेवक छोटो खे बडो. तुम सब वोकि स्तुती कर.” <verse eid="REV 19:5" /><verse number="6" style="v" sid="REV 19:6" />फिर मे ने बडी गर्दी को जसो अरु खुप पानी को जसो आवाज, अरु गरझनो का जसो बडो आवाज सुन्हे “हाल्लेलूयाह! क्युकि प्रभु हमारो परमेश्वर को सर्वशक्तिमान राज करस हइ, <verse eid="REV 19:6" /><verse number="7" style="v" sid="REV 19:7" />ओका हम खुशी अरु मगन हुये खे अरु वोकि स्तुती कर्‍हे क्युकि मेढो को भ्याव अय पहुच्यो हइ, अरु वोकि दुलीन ने अपना आप खे तैयारी करी ली हइ. <verse eid="REV 19:7" /><verse number="8" style="v" sid="REV 19:8" />वोखे अच्छो अरु उजरो चमकदार महीन मलमल पेनन को अधी दियो गयो” क्युकि वु महीन मलमल को अर्थ पवित्र दुन्या को धर्म को काम हइ.<verse eid="REV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9" />तब परमेश्वर से स्वर्गदूत ने मरा से बोल्यो, “यो लिख्यो कि धन्य हइ, जो मेडा को भ्याव का खाना मे बुलायोस हइ.”<verse eid="REV 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10" />तब मी वोखे दण्डवत करण का वासते वोका पाय पर गिरी गयो वोने मरा से बोल्यो, देख असो मत कर्‍हे, “मी तरा अरु तरो भैइय को जसो सेवक हय जो यीशु कि गवय देना पर रुख्यास हइ. परमेश्वर खे प्रनाम कर्‍हे.”</para>
  <para style="p" vid="REV 19:10">क्युकि यीशु की “गवय भविष्यवाणी की आत्मा हइ.”<verse eid="REV 19:10" /></para>
  <para style="s">उजरो घोडो को पर</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11" />फिर मे ने स्वर्ग खुल्लो हुयो देख्यो का अरु देखुस हय कि एक उजरो घोडो हइ. अरु वोका पर एक सवार हइ, जो विश्वासयोग्य अरु सच्ची बोल्यो जास हइ. अरु व्हा न्यायीपन का साथ न्याय अरु वाद विवाद करस हइ. <verse eid="REV 19:11" /><verse number="12" style="v" sid="REV 19:12" />वोको आख अंगार कि आच हइ अरु वोका माथा पर खुप से राजमुकुट हइ. वोका पर एक नाम लिख्यो हइ, जेने वोखे छोड्यो अरु कोय नी समजे. <verse eid="REV 19:12" /><verse number="13" style="v" sid="REV 19:13" />व्हा खुन मे डुबायो हुया कपडा पेन्यास हइ, अरु वोको नाम परमेश्वर को बात हइ. <verse eid="REV 19:13" /><verse number="14" style="v" sid="REV 19:14" />स्वर्ग की सेना उजरो घोडा पर सवार अरु उजरो अच्छो मलमल पेन्या हुयो वोका पीछे पीछे था. <verse eid="REV 19:14" /><verse number="15" style="v" sid="REV 19:15" />जात जात खे मारन का वासते वोने एक चोख्खी तलवार नीकलस हइ. व्हा लोखनड को राजदण्ड का वासते हुयो वे पर राज कर्ह्ये का अरु सर्वशक्तिमान परमेश्वर को भयानक प्रकोप की पाणी की मदिरा को गडो मे अंगुर रोद्ये. <verse eid="REV 19:15" /><verse number="16" style="v" sid="REV 19:16" />वोने कपडा झाग पर यो नाम लिख्योस हइ “राजाको राजो अरु प्रभु को प्रभु.”<verse eid="REV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17" />फिर मे ने एक स्वर्गदूत को सुरज पर खडो हुयो देख्य.वोने बडो आवाज से पुकार्‍यो बद्दल का बिच मे से उडनआला सब चिडी होन से बोल्यो आओ, परमेश्वर को बडो खाना का वासते जमा हुया, <verse eid="REV 19:17" /><verse number="18" style="v" sid="REV 19:18" />जेक से तु राजा को मास अरु सरदार को मास अरु शक्तिमान इन्सान को मास, अरु घोडा को अरु वुनको सवार को मास को “अरु का स्वतंत्रता का सेवक का छोटो का बडो सब दुन्या को मास खा.”<verse eid="REV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19" />फिर मेने वु जनवर, अरु जमीन को राजाहोन अरु वोकि सेनाहोन खे वु घोडा खे सवार अरु वोकि सेना से झगडन का वासते जमा देख्यो. <verse eid="REV 19:19" /><verse number="20" style="v" sid="REV 19:20" />व्हा जनवर, अरु वोका सात झुटी भविष्यव्दक्ता पकडय गयो जेने वोका सामने असो चिन्ह को दिखायो थो जेका वजेसे वोने वोखे भरमायो जिनका पर वा जनवर कि छाय थी अरु जो वोकि मेर्ति कि पुजा करतो थो. यो दो जिते जी वा अंगार कि नंद्दी मे, जो गन्धक से जलस हइ, डाल्हे गयो. <verse eid="REV 19:20" /><verse number="21" style="v" sid="REV 19:21" />बाकि का सैनीक वु घोडो को सवार की तलवार से जो वोको मुडा से नीकलती थी, मारी डाल्यो गया. अरु सब चिडी वोको मास से तृप्त हुय गयो.<verse eid="REV 19:21" /></para>
  <chapter eid="REV 19" />
  <chapter number="20" style="c" sid="REV 20" />
  <para style="s">हजार साल</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1" />फिर मे ने एक स्वर्गदूत खे स्वर्ग से उतरते देख्यो, जेका हात मे अथाह-गड्डा कि कुंजी अरु एक बडी साकल थी. <verse eid="REV 20:1" /><verse number="2" style="v" sid="REV 20:2" />वोने वु अजिगर, अगर जुन्नो साप खे जो इब्लीस अरु सैतान हइ, पकडी खे हजार बरस का वासते बाधी दियो, <verse eid="REV 20:2" /><verse number="3" style="v" sid="REV 20:3" />अरु वोने अथाह-गड्डा मे डालीखे बंद करी दियो अरु वोका पर सिक्का को लगय दियो कि व्हा हजार बरस खे पुरो होना तक जात जात, दुन्या खे फिर नी भरमायो. येका बाद जरुरती हइ कि व्‍हा थोडा देर का वासते फिर खोल्यो जाह्ये.<verse eid="REV 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4" />फिर मे ने राजगद्दी देख्ये अरु नी वो, पर दुन्या बठी गया, अरु वुनको न्याय करण को अधिकार दियो गयो. मे ने वुनकी आत्माहोन खे भी देख्यो जे, माथा यीशु मसीह की गवय देन अरु परमेश्वर को वचन को करन काट्यो गयो थो, अरु जिनने नी वे जनवर होन कि अरु नी वोकि मूर्ति की पूजा करी थी, अरु नी वोको सिक्का को अपनो माथो अरु हात पर ली थी वे जिन्दो हुय खे मसीहा का हजार बरस तक राज करते र्‍हिया. <verse eid="REV 20:4" /><verse number="5" style="v" sid="REV 20:5" />जब तक हजार बरस पुरा नी होय जब तक शेष मर्‍यो नी जिन्दो हुयो. यो ते पयलो डबल जन्म हइ. <verse eid="REV 20:5" /><verse number="6" style="v" sid="REV 20:6" />धन्य अरु पवित्र हइ, जो या पयलो पुनरुत्थान को भागी हइ. असा पर दुसरो मरना का थोडा भी अधिकार नी, पन वे परमेश्वर अरु को मसीह याजक हुये अरु वोका हात हजार बरस तक राज कर्‍हे.<verse eid="REV 20:6" /></para>
  <para style="s">सैतान खे हरानो</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7" />जब हजार बरस पुरा हुइ गा ते सैतान बन्दीगृह से छोडी दियो जाह्ये. <verse eid="REV 20:7" /><verse number="8" style="v" sid="REV 20:8" />सैतान जातहोन खे जो जमीन का चारी तरप हुये खे अगर गोग अरु मागोग खे जेकी गिनती नंद्दी की रेती का बराबर हुये अरु भरमाखे लडय का वासते जमा करण खे नीकल्या. <verse eid="REV 20:8" /><verse number="9" style="v" sid="REV 20:9" />वे सब जमीन पर फैली खे पवित्र दुन्या छाय अरु लाडेलो नगर खे घेरी लीह्ये. अरु अंगार स्वर्ग से उतरी खे उन खे खत्म करी दिह्ये. <verse eid="REV 20:9" /><verse number="10" style="v" sid="REV 20:10" />वो को भरमानवालो सैतान अंगार अरु गन्धक की वु नाला मे जेमे वु जनवर अरु झुटो भविष्यव्दक्ता भी हुये डाली दिह्ये जाह्ये. अरु वे रात दिन पिडमपिडि से दुख मे तडपते र्‍हिये.<verse eid="REV 20:10" /></para>
  <para style="s">आखरी न्याय</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11" />फिर मेने एक बडो उजरी राजगद्दी अरु वोखे जो वोका पर बठ्यो हइ, देख्यो वोका सामने से जमीन अरु बद्दल भागी गया, अरु वुनका वासते जगा नी मीली. <verse eid="REV 20:11" /><verse number="12" style="v" sid="REV 20:12" />फिर मे ने छोटो बडा सब मर्‍या हुया खे राजगद्दी का सामने खडो हुयो देख्ये का अरु किताब खोली गय. अरु फिर एक अरु जसो वे किताब मे लिख्यो हुयो थो, वोसो य वुनको काम का जसो मऱ्यो हुयो को न्याय कर्‍यो गयो. <verse eid="REV 20:12" /><verse number="13" style="v" sid="REV 20:13" />नद्दी ने वोमे मर्‍यो खे जो वोमे थो दि दियो, अरु मरनो अरु अधोलोक ने वे मर्‍या हुयो खे काम का जसो वुन सब को न्याय कर्‍यो गयो. <verse eid="REV 20:13" /><verse number="14" style="v" sid="REV 20:14" />मृत्यु अधोलोक अंगार को नाला मे डाल्यो गयो. यो अंगार की नालो दुसरी मरनो हइ. <verse eid="REV 20:14" /><verse number="15" style="v" sid="REV 20:15" />अरु जो कोय, नाम जिवन की किताब मे लिख्यो हुयो नी मील्यो, व्हा अंगार का नाला मे डाल्यो गयो.<verse eid="REV 20:15" /></para>
  <chapter eid="REV 20" />
  <chapter number="21" style="c" sid="REV 21" />
  <para style="s">नवो बद्दल अरु नवी जमीन</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1" />फिर मे ने नवो बद्दल अरु नवी जमीन खे देख, क्युकि पयलो बद्दल अरु पयली जमीन जाते र्‍हेती थी, अरु समुद्र भी नी र्‍ही. <verse eid="REV 21:1" /><verse number="2" style="v" sid="REV 21:2" />फिर मेने पवित्र नगर को नवो येरुशलेम खे स्वर्ग से परमेश्वर पास से उतरते देख्यो.व्हा वा दुलीन का सामे थी जो अपनो अदमी का वासते सिंगरी गय हुये. <verse eid="REV 21:2" /><verse number="3" style="v" sid="REV 21:3" />फिर मे ने राजगद्दी मे से कोय खे जोरसे बोल्यो से यो बोलते हुयो सुन्यो, “देख्यो परमेश्वर को डेरो इन्सान का बिच मे हइ.व्हा वुनका सात डेरो कर्‍हे, अरु वे वोक दुन्या हुये खे अरु परमेश्वर आप वुन, सात र्‍हिये अरु वुनको परमेश्वर हुये. <verse eid="REV 21:3" /><verse number="4" style="v" sid="REV 21:4" />व्हा वुनकी आख से सब आसु पोछी डाल्हे. अरु येका बाद मरन को नी र्‍हियेका अरु नी शोक नी विलाप को नी पीडा र्‍हिये पयली बात जाती र्‍हेस.”<verse eid="REV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5" />जो राजगद्दी पर बठ्यो थो, वोने बोल्यो, “देख, मी सब कुछ नवो करी दियो हय.” फिर वोने बोल्यो, “लिखी ले, क्युकि यो वचन विश्वास का योग्य अरु सच्ची हइ.” <verse eid="REV 21:5" /><verse number="6" style="v" sid="REV 21:6" />फिर वोने मरा से बोल्यो, “या बात पुरी हुय गी हइ. मी अल्फा अरु ओनेगा, पैयले अरु आखरी हय.मी प्यासा खे जीवन को पाणी को पाजर मे से सेंत-मेत पिलाह्यु. <verse eid="REV 21:6" /><verse number="7" style="v" sid="REV 21:7" />जो जय पाह्ये उ या जिनुसहोन को वारीस हुये खे अरु मी वोको परमेश्वर हुये अरु व्हा मरो बच्चा हुये. <verse eid="REV 21:7" /><verse number="8" style="v" sid="REV 21:8" />पन डरफोक ,अरु अविश्वासीहोन,अरु घिनौनो, अरु हत्यारो, अरु व्यभिचारिहोन, अरु टोन्हों, अरु मूर्तिपूजक खे ,अरु सब झूटी को भाग वु नाला मे मील्हे जो अंगार अरु गन्धक से जलती र्‍हेस हइ या दूसरो मरनो हइ.”<verse eid="REV 21:8" /></para>
  <para style="s">नवो येरुशलेम</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9" />फिर जो सात स्वर्गदूतहोन, पास सात आखरी विपत्तिहोन से भर्‍यो सात कटोरा था,वोमे से एक मरा पास आयो, अरु मरा सात बात करीखे बोल्यो, “इदर अकमानी तोखे दुलीन अगर मुडाकि बायको दिखाह्यु.” <verse eid="REV 21:9" /><verse number="10" style="v" sid="REV 21:10" />तब व्हा मेखे आत्मा मे एक बडो अरु उच्चो टेकडो पर ले गयो, अरु पवित्र नगर येरुशलेम खे स्वर्ग से परमेश्वर, पास से वुतरते दिखानो. <verse eid="REV 21:10" /><verse number="11" style="v" sid="REV 21:11" />परमेश्वर की महिमा वोमे थी, अरु वोकि उजालो खुप ही खुप किमती गोटो, अगर बगडी का जसो यशब का जसो अच्छोय थो. <verse eid="REV 21:11" /><verse number="12" style="v" sid="REV 21:12" />वोकि नगर पनाह बडी उच्ची थी,अरु वोकि बारा फाटक अरु फाटकहोन पर बारा स्वर्गदूत था अरु वे फाटक पर उत्तर, तरप तीन इस्राएलिहोन का बारा गोत को नाम लिख्यो थो. <verse eid="REV 21:12" /><verse number="13" style="v" sid="REV 21:13" />पुरब का तरप तीन फाटक, अरु उत्तर दिशा, तरप तीन फाटक, अरु तीन फाटक दक्षिण, तरप फाटक, अरु पश्चिम का तरप तीन फाटक थो. <verse eid="REV 21:13" /><verse number="14" style="v" sid="REV 21:14" />यो नगर की शहरपनाह की बारा पय्या था, अरु मुडाको बारा प्रेरितहोन का बारा नाम लीख्यो थो. <verse eid="REV 21:14" /><verse number="15" style="v" sid="REV 21:15" />जो मरा सात बात करते र्‍हेतो थो वोका पास नगर अरु फाटक अरु वोकी शहरपनाह खे मोजन का वासते एक सोन्ना को जगत थो. <verse eid="REV 21:15" /><verse number="16" style="v" sid="REV 21:16" />व्हा नगर वर्गाकार बठ्यो थो अरु वोकि लंबडोय च्चौवडा का बराबर थो. अरु वोने वु जगत से नगर खे मोज्यो ते साढे सात सौ कोस को नीकल्यो वोकि लंबय अरु च्चौडोय अरु उच्चो बराबर थो. <verse eid="REV 21:16" /><verse number="17" style="v" sid="REV 21:17" />वोने वोकि शहर पनाह खे इन्सान, अगर स्वर्गदूत को माप से मोज्यो ते एक सौ चौरेचालीस हात नीकल्यो. <verse eid="REV 21:17" /><verse number="18" style="v" sid="REV 21:18" />वोकि शहरपनाह यशब की बनी थी, अरु नगर असो हइ अच्छो सोन्ना को थो जो अच्छी काच का जसी हुये. <verse eid="REV 21:18" /><verse number="19" style="v" sid="REV 21:19" />वु नगर की पय्यो हर रंगेरंग की खुप किमती गोटो से सजायो हुयो थो. पयलो पय्यो यशब कि, दुसरी नीलमणी कि तीसरी लालडी कि चौथी मकरत की, <verse eid="REV 21:19" /><verse number="20" style="v" sid="REV 21:20" />पाचवो गोमेदक कि छे माणिक्यकी सातवी पीतमनी की, आठवी पेरोज की, नव्वी पुखराज की, दसवी लहसनिए की, ग्यारावी धूम्रकान्त, तरप बारावी याकुत की थी. <verse eid="REV 21:20" /><verse number="21" style="v" sid="REV 21:21" />बारा फाटक बारा मोती का था एक एक फाटक एक एक मोती को बनायो थो नगर की सडक अच्छी काच का जसी चोखी सोन्ना कि थी.<verse eid="REV 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22" />मे ने वोमे कोय मन्‍दिर नी देखी, क्युकि सर्वशक्तिमान प्रभु परमेश्वर अरु मेढो वोकि मंदीर हइ. <verse eid="REV 21:22" /><verse number="23" style="v" sid="REV 21:23" />वु नगर मे सुरज अरु चाद का उजार की जरुरत नी. क्युकि परमेश्वर को तेज से उजार हुय र्‍हीस हइ, अरु मेढो वोको दिव्वो हइ. <verse eid="REV 21:23" /><verse number="24" style="v" sid="REV 21:24" />जात जात, दुन्या वोकि प्रकाशन मे चलते फिरते, अरु जमीन को राजो अपनो अपनो तेज का जसो वोमे लग्यो. <verse eid="REV 21:24" /><verse number="25" style="v" sid="REV 21:25" />नगर कि फाटक दिन मे कभी बंन्द नी हुये खे अरु रात व्हा नी हुये. <verse eid="REV 21:25" /><verse number="26" style="v" sid="REV 21:26" />दुन्या जात जात को तेज अरु वैभव को जसो वोमे लाह्ये. <verse eid="REV 21:26" /><verse number="27" style="v" sid="REV 21:27" />पन वोमे कोय अपवित्र चिजहोन बुरा काम करणवालो, या झुटी को गाडनआलो कोय रीति से घुस्सा नी कर्‍यो, पन नी करण को पन फक्त वे दुन्या जेको नाम मुडाको जिवन की किताब मे लिख्यो हइ.<verse eid="REV 21:27" /></para>
  <chapter eid="REV 21" />
  <chapter number="22" style="c" sid="REV 22" />
  <para style="s">जिवन पाणी की नदी</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1" />फिर वोने मेखे बगडी का जसी झलकन हुयो, जान को पाणी कि नंद्दी दिखानो, जो परमेश्वर अरु मेडा खे राजगद्दी से नीकलीखे <verse eid="REV 22:1" /><verse number="2" style="v" sid="REV 22:2" />वा नगर कि सडक, बिचो बिच बोहाती थी. नद्दी का यो पार अरु वा पार जान को झाड थो. वोमे बोहय खे रेगेरंग को फल लगतो थो, अरु व्ह हर महीना मे फल आतो थो. अरु वु झाड को पत्ता से जात जात, दुन्या अच्छा होता था. <verse eid="REV 22:2" /><verse number="3" style="v" sid="REV 22:3" />फिर श्राप नी हुये खे अरु परमेश्वर वोको मुडा का सिंहासन वोकि सेवक कर्‍हे. <verse eid="REV 22:3" /><verse number="4" style="v" sid="REV 22:4" />वे वोका मुडो देख्ये</para>
  <para style="p" vid="REV 22:4">अरु वो को नाम वोका माथा पर लिख्यो हुयो हुये. <verse eid="REV 22:4" /><verse number="5" style="v" sid="REV 22:5" />फिर रात नी होनकी, अरु वुन खे दिव्वो अरु सुरज को उजाला की जरुरत नी हुये खे क्युकि प्रभु परमेश्वर वुन खे उजाला दिह्येका अरु वे पिडमपिडि से राज कर्‍ह्ये.<verse eid="REV 22:5" /></para>
  <para style="s">यीशु को आनो</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6" />फिर वोने मरा से बोल्यो, “या बात विश्वास का योग्य अरु सच्ची हइ प्रभु ने, जो भविष्यव्दक्ताहोन आत्माहोन को परमेश्वर हइ, अपनो स्वर्गदूत खे येका वासते भेज्यो कि अपनो सेवक खे वे बात, जिनको झल्दी पुरो होनो जरुरती हइ,दिखाये.” <verse eid="REV 22:6" /><verse number="7" style="v" sid="REV 22:7" />“देख मी” झल्दी. “आनवालो हय! धन्य हइ उ, जो यो किताब कि भविष्यवाणी की बात मानस हइ!” <verse eid="REV 22:7" /><verse number="8" style="v" sid="REV 22:8" />मी उ यहून्ना हय, जो या बात सुन्ह्ये अरु देखतो थो. जब मे ने सुन्यो अरु देख्यो, ते जो स्वर्गदूत मेखे या बात दिखातो थो, अरु मी वोको पाय पर दण्डवत करण का वासते गिरी गयो. <verse eid="REV 22:8" /><verse number="9" style="v" sid="REV 22:9" />पर वोने मेखे बोल्यो, “देख, असो मत कर्‍हे. क्युकि मी तरो अरु तरो भैइय भविष्यव्दक्ताहोन, अरु या किताब कि बात माननवाला, संग सेवक हय. परमेश्वर ही खे दण्डवत कर.” <verse eid="REV 22:9" /><verse number="10" style="v" sid="REV 22:10" />फिर वोने मरासे बोल्यो, “या किताब कि भविष्यवाणी कि बात मोगम मत कर्‍हे. क्युकि टेम नजीक हइ. <verse eid="REV 22:10" /><verse number="11" style="v" sid="REV 22:11" />जो अन्याय करस हइ उ अन्याय ही करतो र्‍हियो. अरु जो मीलनो हइ, व्हा मीलनो र्‍हिये. अरु जो धर्मी हइ व्हा मीलनो बन्यो र्‍हिये. अरु जो धर्मी बन्यो र्‍हियो. अरु जो पवित्र हइ.व्हा पवित्र बन्यो र्‍हिये.”<verse eid="REV 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12" />यीशु ने बोल्यो, “देख मी” झल्दी. आनवालो हय. “अरु हर” एक को काम का जसो बदलो देन का वासते प्रतीफल मरा पास हइ. <verse eid="REV 22:12" /><verse number="13" style="v" sid="REV 22:13" />मी अल्फा अरु ओनेगा पयलो अरु आखरी, पयलो अरु खत्म हुयो.<verse eid="REV 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14" />धन्य वे हइ का जो अपना कपडा धोय लेस हइ, क्युकि वोखे जिवन को झाड का पास आन नको अधिकार मील्हे का अरु वे फाटक से हुय खे नगर मे घुसी गो. <verse eid="REV 22:14" /><verse number="15" style="v" sid="REV 22:15" />पर कुत्तो, अरु टोन्नो, अरु व्यभिचारी, अरु हत्यारो अरु मूर्तिपूजक अरु हर एक झूठ खे प्रेम करस आलो अरु गाडनआलो बाहेर र्‍हिगो.<verse eid="REV 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16" />“मी यीशु ने अपनो स्वर्गदूत खे येका वासते भेज्यो कि तुम्हारा आगे मंडलीहोन का बारे मे या बात कि गवइ देस मी दाउद को किमती अरु कुल,अरु फजर को चमकते हुयो तारो हय.”<verse eid="REV 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17" />आत्मा अरु दुलीन दो बोलस हइ, “आ” अरु सुनन आलो भी बोल्ह्ये का “आ” जो</para>
  <para style="p" vid="REV 22:17">प्यासो हुये व्हा आयो,</para>
  <para style="p" vid="REV 22:17">अरु जो कोय चाह्ये व्हा जिवन को पाणि सेत मेत ली.<verse eid="REV 22:17" /></para>
  <para style="s">समापन</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18" />मी हर एक खे, जो या किताब की भविष्यवाणी की बात सुनतो हइ,गवइ देतो हय अगर कोय इन्सान या बात मे कुछ बडह्ये ते परमेश्वर वे विपत्तिहोन खे,जो या किताब मी लिखी हइ, वोका पर बडाह्ये. <verse eid="REV 22:18" /><verse number="19" style="v" sid="REV 22:19" />अगर कोय या भविष्यवाणी कि किताब मे से कुछ नीकली दिह्येका ते परमेश्वर वा जिवन को झाड अरु पवित्र नगर मे से, जेको वर्णन या किताब मे हइ, वोको भाग नी काली दिह्ये.<verse eid="REV 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20" />जो या बात कि गवइ देस हइ व्हा यो बोलस हइ,</para>
  <para style="p" vid="REV 22:20">“हा, मी झल्दी आनवालो हय.” आमीन. हे प्रभु यीशु आ!<verse eid="REV 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21" />प्रभु यीशु को अनुग्रह परमेश्वर का दुन्याहोन का सात र्‍हिये, आमीन.<verse eid="REV 22:21" /></para>
  <chapter eid="REV 22" />
</usx>