<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Gowlan</book>
  <para style="h">यहून्ना</para>
  <para style="toc3">यहून्ना</para>
  <para style="toc2">यहून्ना</para>
  <para style="toc1">यहून्ना रचित यीशु मसीह को सुसमाचार</para>
  <para style="mt2">यहून्ना रचित यीशु मसीह का सुसमाचार</para>
  <para style="mt1">यहून्ना रचित यीशु मसीह को सुसमाचार</para>
  <para style="imt">पैछान</para>
  <para style="ip">या यहुन्ना ने लिखी हइ सुसमाचार कि किताब नवा नीयम कि चार सुसमाचार कि किताब मे से एक हइ, जो यीशु को जिवन को वर्णन करस हइ, यीशु मसीह का मरना का बाद, मत्ती, मरकुस, लूका अरु यहुन्ना से या किताब लिखी गइ, या हर एक किताब को सुसमाचार कि किताब बोलस हइ, मसीह का जन्म का बाद 90 साल का आस पास यो सुसमाचार प्रेरितहोन ने लिख्यो हइ, या किताब मे असो लिख्यो नी कि 1 यहून्ना 2 यहुन्ना अरु 3 यहुन्ना कि लिखना से मेल खास हइ, उन दिन यहुन्ना इफिसुस मे लिखी गइ असा कुछ बुजरुकहोन लिखनो मानस हइ.</para>
  <para style="ip">यहुन्ना या किताब को उद्देश साफ करस हइ कि इन्सानहोन का लिये यीशु ही मसीह हइ अरु परमेश्वर को बेटो हइ या बात पर विश्वास मीलस हइ, ओका पर विश्वास करणा से ओका नाम से हम खे जिवन मीली सकस, या किताब यहूदीया अरु गैरयहूदीया का लिये लिखी गइ हइ, यहुन्ना को सुसमाचार मे तीन बातहोन सुसमाचार से बातहोन अलग हइ, यीशु मसीह का कर्या हुया चमत्कर पर यहुन्ना ध्यान करस हइ, अरु ओका बारे मे जादा नी लिख्यो गयो, यीशु को बपतिस्मो अरु सुनसान जगा मे परिक्षा कि असी घटनाहोन को यो सुसमाचार मे लिख्यो नी गयो हइ. <char style="xt"><ref loc="JHN 20:31">20:31</ref></char></para>
  <para style="iot">रुप रेखा</para>
  <para style="io1">1. यहुन्ना सुसमाचार की सुरुवात करस हइ <char style="ior"><ref loc="JHN 1:1-18">1:1-18</ref></char></para>
  <para style="io1">2. बाद मे उ चमत्कार होन का बारे मे लिखस हइ जो यीशु ने कर्यो <char style="ior"><ref loc="JHN 1:19-12:50">1:19—12:50</ref> </char></para>
  <para style="io1">3. उ यीशु का जिवन को वर्णन करस हइ जो ओखो मरनो अरु पुनरुत्थान का पास ली जास हइ की जन सेवा <char style="ior"><ref loc="JHN 13:1-20:31">13:1—20:31</ref></char></para>
  <para style="io1">4. यहुन्ना का अध्याय मे सुसमाचार खत्म करस हइ जोमे यीशु मरना से जिन्दो हुइ, इन्सानहोन खे दिखैइ देस हइ अरु आखरी दिन मे अपनी किताब लिखना को उद्देश बताता हुये खत्म करस हइ. <char style="ior"><ref loc="JHN 21">21</ref></char></para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">शब्द आंगधारी हुयो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />सुरु मे शब्द थो, अरु शब्द परमेश्वर का साथ थो, अरु शब्द परमेश्वर थो. <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />यो ही सुरु मे परमेश्वर का साथ थो. <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />सब कुछ ओका वजेसे पइदा हुयो अरु जो कुछ पइदा हुयो हइ ओमे से कोय भी चिज ओका बिना पइदा नी हुया. <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />उ जिवन थो, उ जिवन इन्सानहोन को उजालो थो. <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />अरु उजालो अंधारा मे चमकस हइ. अरु अंधारा ने ओखे कबुल नी कऱ्यो.<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />एक इन्सान परमेश्वर का तरप से आयो उपस्थित हुयो जोको नाम यहून्ना थो. <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />यो गवइ देन आयो, कि उजाला कि गवइ दे, ताकि सब ओका वजेसे विश्वास लाये. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />उ खुद तो उजालो नी थो, पर उ उजाला का बारेमे गवइ देन का लिये आयो थो. <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />सच्ची उजालो जो हर एक इन्सान खे उजालो करस हइ जगत मे आनआलो थो.<verse eid="JHN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10" />उ जगत मे थो, अरु इन्सान ओका वजेसे पइदा हुया, अरु इन्साहोन ने ओखे नी परछान्यो. <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />उ अपना घर मे आयो अरु ओका अपना ने ओखे कबुल नी कर्यो. <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />पर जोत्ता ने ओखे कबुल कर्यो, ओने उनखे परमेश्वर का बच्चा होन को अधिकार दियो, यानेकी उनने जो ओका नाम पर विश्वास रखस हइ. <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />वे नी ते खुन से, नी आंग की इच्छा से, नी इन्सान की इच्छा से, पर परमेश्वर से पइदा हुयो हइ.<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />अरु वचन देहधारी हुयो. अरु अनुग्रह अरु सच्चीइ से परिपूर्ण हुइखे हमारा बीच जियो, अरु हमने ओकी असी महिमा देखी जसी बाप का एकलौता बेटा की महिमा.<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />यहून्ना ने ओका बारे मे गवइ दी, अरु बुलय खे बोल्यो, यो उ हइ, जोको मेने वर्णन कर्यो, कि जो मरा बाद अय रो हइ, उ मरासे बडीखे हइ, क्युकी उ मरासे पइले थो.<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />क्युकि ओकी परिपूर्णता से हम सब ने मील्हे कर्यो मंनजे अनुग्रह पर अनुग्रह. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />येका लिये कि व्यवस्था तो मूसाक का वजेसे दी गवइ, पर अनुग्रह अरु सच्ची यीशु मसीह का वजेसे पहुची. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />परमेश्वर खे कोय ने कभी नी देख्यो, एकलोतो बेटो जो बाप का खोरा मे हइ, ओने ओखे प्रगट कर्यो.<verse eid="JHN 1:18" /></para>
  <para style="s">यहून्ना बपतिस्मा देनआला की गवइ</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />यहून्ना की गवइ या हइ, कि जब यहूदीयाहोन ने यरुशलेम से याजकहोन अरु लेवीहोन खे ओकासे पुछन का लिये भेज्यो, “तू कोन आय?”<verse eid="JHN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20" />ते ओने यो मानी लियो, अरु इनकार नी कर्यो, पर मानी लियो “मी मसीह नी आय.”<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />“तब ओने ओकासे पूछ्यो,” “ते फिर तू कोन आय?”</para>
  <para style="p" vid="JHN 1:21">“तू एलिय्याह आय?” ओने बोल्यो,</para>
  <para style="p" vid="JHN 1:21">“मी नी आय” का ते तू उ भविष्यव्दक्ता आय?</para>
  <para style="p" vid="JHN 1:21">“ओने जवाब दियो नी.”<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />“तब ओने ओका से पूछ्यो का फिर तू हइ कोन ताकि हम अपना भेजन आला खे जवाब दे कि तू अपना बारे मे का बोलस हइ?”<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />ओने बोल्यो, “जसो यशायाह भविष्यव्दक्ता ने बोल्यो हइ मी जंगल मे फुकारनआला को आवाज आय खे तुम प्रभु का लिये रस्ता सीधी करणु.” <verse eid="JHN 1:23" /><verse number="24" style="v" sid="JHN 1:24" />वे दूत जो फरीसीहोन का तरफ से भेज्या गया था. <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />उनने ओकासे यो सवाल पूछ्यो, “अगर तू नी मसीह हइ, अरु नी एलिय्याह, अरु नी उ भविष्यव्दक्ता आय, ते फिर बपतिस्मा क्यु देस हइ?”<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />यहून्ना ने उनखे जवाब दियो, मी पाणी से बपतिस्मा देउस हइ, पर तुम्हारा बीच मे एक इन्सान खडो हइ, जेखे तुम खे नी मालुम.<verse eid="JHN 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 1:27" />अगर मरा बाद आनआलो हइ, ओका जुता कि तन्नी मी खोलना का लायक नी.<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />या बातहोन यरदन नद्दी पार बैतनीय्याह मे हुइ खे , जहा यहून्ना बपतिस्मा देतो थो.<verse eid="JHN 1:28" /></para>
  <para style="s">परमेश्वर को मेडो</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />दूसरा दिन यहून्ना यीशु खे अपना तरफ आते देखी खे बोल्यो, “देखनु, यो परमेश्वर को मेडो हइ जो जगत को पाप उठै ली जास हइ. <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />यो उ आय, जोका बारे मे मेने बोल्यो थो, कि एक इन्सान मरा पीछे आस हइ, जो मरा से बडो हइ, क्युकि उ मरासे पैयले थो. <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />अरु मी तो ओखे परछानतो नी थो, पर येका लिये मी तो पाणी से बपतिस्मा देतो आयो, कि उ इस्राएल पर प्रगट हुइ जाह्ये.”<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />अरु यहून्ना ने या गवइ दी, मेने आत्मा खे कबूतर का रुप मे स्वर्ग से उतरता देख्यो हइ, अरु उ ओ पर ठैरी गयो. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />अरु मी तो ओखे परछानतो नी थो, पर जो ने मेखे पानी से बपतिस्मा देन खे भेज्यो, ओने मेखे बोल्यो, जोका पर तू आत्मा खे उतरते अरु रोखते देख्यो. उ पवित्र आत्मा से बपतिस्मा देनालो हइ. <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />अरु मेने देख्यो, अरु गवइ दी हइ कि यो मे परमेश्वर को बेटो हइ.<note caller="+" style="x"><char style="xo" closed="false">1:34 </char><char style="xt" closed="false"><ref loc="PSA 2:7">भजन संहिता 2:7</ref></char></note><verse eid="JHN 1:34" /></para>
  <para style="s">यीशु को पयलो चेलो</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />दूसरा दिन फिर यहून्ना अरु ओका सेवक मे से दो झन खडा हुया था. <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />अरु ओने यीशु पर जो जै रो थो, नजर करीखे बोल्यो, “देखनु, यो परमेश्वर को मेडो हइ.”<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />तब वे दो सेवक ओकी सुनीखे यीशु का पीछे गया. <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />यीशु ने घुमी खे अरु उनखे पीछे आते देखी खे उनसे बोल्यो, “तुम को की खोज मे हइ?” उनने ओकासे बोल्यो, “हे गुरु, मंनजे हे गुरु, तू खा र्‍हेस हइ?”<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />ओने उनसे बोल्यो, “चल, ते देखी लिये” तब उनने अय, ओकी र्‍हेन कि जगा देखी, अरु उ दिन ओका साथ र्‍हिया. अरु यो दसवा घंटा का नजीकपास थो.<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />वे दोइ मे से, जो यहून्ना की बात सुनीखे यीशु का पीछे चली गया था, एक शमौन पतरस को भैइ अन्द्रियास थो. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />ओने पैयले अपना सगो भैइ</para>
  <para style="p" vid="JHN 1:41">शमौन से मीलीखे ओकासे बोल्यो, “हमखे ख्रिस्त अगर मसीह मीली गयो.” <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />उ ओखे यीशु का पास लायो</para>
  <para style="p" vid="JHN 1:42">यीशु ने ओका पर नजर करीखे बोल्यो, “तू यहून्ना को बेटो शमौन हइ, तू कैफा मंनजे पतरस कहलाये.”<verse eid="JHN 1:42" /></para>
  <para style="s">फिलिप्पुस अरु नतनएल खे बुलायो जानो</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />दूसरा दिन यीशु ने गलील खे जानो चाह्यो, अरु फिलिप्पुस से मीलीखे बोल्यो, “मरा पीछे अय जा.” <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />फिलिप्पुस तो अन्द्रियास अरु पतरस को नगर बैतसैदा को नीवासी थो. <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />फिलिप्पुस ने नतनएल से मीलीखे ओकासे बोल्यो, “जेको वर्णन मूसा ने व्यवस्था मे अरु भविष्यव्दक्ताहोन ने कर्यो हइ, उ हमखे मीली गयो. उ यूसुफ को बेटो, यीशु नासरत हइ.”<note caller="+" style="x"><char style="xo" closed="false">1:45 </char><char style="xt" closed="false"><ref loc="MAT 21:11">मत्ती 21:11</ref></char></note><verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />नतनएल ने ओकासे बोल्यो “कोय अच्छी चिज भी</para>
  <para style="p" vid="JHN 1:46">“नासरत से नीकली सकस हइ?” फिलिप्पुस ने ओकासे बोल्यो, “चलीखे देखी ले.”<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />यीशु ने नतनएल खे अपना तरफ आते देखीखे ओका बारे मे बोल्यो, “देखनु, यो सच्ची मे इस्त्राएलि हइ येमे कपट नी.”<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />नतनएल ने ओका से बोल्यो, “तू मेखे कसो जानस हइ?” यीशु ने ओखे जवाब दियो, “येका से पैयले कि फिलिप्पुस ने तोखे बुलायो, जब तू अंजीर का झाड का नीचे थो, तब मेने तोखे देख्यो थो.”<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />नतनएल ने ओखे जवाब दियो, “हे गुरु, तू परमेश्वर को बेटो हइ. तू इस्राएल को महा राजो हइ.”<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />यीशु ने ओखे जवाब दियो “मेने जो तरा से बोल्यो, कि मेने तोखे अंजीर का झाड का नीचे देख्यो, तू येका लिए विश्वास करस हइ? तू येका से भी बडा-बडा काम देख्ये.” <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />फिर ओकासे बोल्यो “मी तुम से सच्ची-सच्ची बोलुस हइ कि तुम स्वर्ग खे खुल्यो हुयो, अरु परमेश्वर का स्वर्गदूतहोन खे इन्सान को बेटा का उपर उतरते अरु उपर जाते देख्ये.”<note caller="+" style="x"><char style="xo" closed="false">1:51 </char><char style="xt" closed="false"><ref loc="GEN 28:12">उत्पत्ति 28:12</ref></char></note><verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">काना शहर मे भ्याव</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />तीसरा दिन गलील का काना मे कोय एक का शहर भ्याव थो, अरु यीशु की माय भी व्हा थी. <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />यीशु अरु ओका सेवक भी उ भ्याव मे बुलाया था. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />जब अंगूर को रस खत्म हुइ गयो, ते यीशु की माय ने उकासे बोल्यो, “उनका पास अंगुरकोरस नी र्‍हियो.”<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />यीशु ने ओकासे बोल्यो, “हे बय मेखे तरा से का काम? अभी मरो टेम नी आयो.”<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />ओकी माय ने सेवकहोन से बोल्यो, “जो कुछ उ तुम से बोल्ये का उ करणु.”<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />व्हा यहूदीयाहोन खे अच्छो करण का लिये पत्थर का छे मडका रख्या था, जोमे दो दो, तीन-तीन मन समाता था. <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />यीशु ने उनसे बोल्यो, “मडका मे पानी भरी दे” तब उनने उनका मुडा तक भरी दियो. <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />तब ओने उनसे बोल्यो, “अरु नीकालीखे खाना का प्रधान का पास लि जा.” अरु वे लि गए. <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />जब खाना को प्रधान ने उ पानी चख्यो, जो अंगूर को रस बनी गया थो अरु नी जानतो थो कि उ खा से आयो हइ. पर जिन सेवकहोन ने पानी नीकल्या थो वे जानता था, ते खाना को प्रधान ने दूल्हा खे बुल्येइ खे ओकासे बोल्यो. <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />“हर एक इन्सान पैयले अच्छो अंगूर को रस देस हइ, अरु जब इन्सान पीखे छकी जास हइ, तब मध्यम देस हइ. पर तोने अच्छो अंगूर को रस अभी तक रख छोड्यो हइ.” <figure style="fig" alt="Filling water in the stone jars" file="LB00135C.TIF" size="col" copy="Horace Knowles ©" ref="2:7">फतर का मडका मे पाणी भरता हुये</figure><verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />यीशु ने गलील का काना मे अपनो पयलो चिन्ह देखीखे अपनी महिमा प्रगट करी अरु ओका सेवक होन ने ओका पर विश्वास कर्यो.<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />येका बाद उ अरु ओकी माय, ओका भैइ, ओका सेवक, कफरनहूम खे गया अरु व्हा कुछ दिन र्‍हिया.<verse eid="JHN 2:12" /></para>
  <para style="s">मन्‍दिर से बेपारीहोन खे नीकल्यो जानो</para>
  <para style="r">(<ref loc="MAT 21:12">मत्ती 21:12</ref>,<ref loc="MAT 21:13">13</ref>; <ref loc="MRK 11:15-17">मरकुस 11:15-17</ref>; <ref loc="LUK 19:45">लूका 19:45</ref>,<ref loc="LUK 19:46">46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />यहूदीयाहोन को फसह को त्योहार पास थो, अरु यीशु यरुशलेम खे गयो. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />अरु ओने मन्‍दिर मे बैल, अरु मेडो अरु कबूतर खे बेचनआला का तरफ सर्राफाहोन खे बठौ हुया पायो. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />तब ओने दोरकासहोन को कोडो बनैइ खे, सब मेढाहोन अरु बैलहोन खे मन्‍दिर से नीकाली दियो, अरु सर्राफाहोन का पैसा फैलय दिया,अरु मेज उलट्यै दी. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />अरु कबूतर बेचनआला से बोल्यो, “इनखे ह्या से लि जा, मरा बाप का भवन खे व्यापार को घर मत बनानु.” <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" />तब ओका सेवक होन खे, “याद आयो कि लिख्यो हइ, तरी मन्‍दिर की धुन मेखे खैइ जाये.”<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />येका पर यहूदीयाहोन ने ओकासे बोल्यो, “तू जो यो करस हइ ते हमखे कोनतो चिन्ह दिखास हइ?”<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />यीशु ने उनखे जवाब दियो, “या मन्‍दिर खे गिर्यैइ दे, अरु मी येखे तिन दिन मे खडी करी दिह्यु”<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />यहूदीयाहोन ने बोल्यो, “या मन्‍दिर खे बनाना मे छेचालीस साल लग्या हइ, अरु का तू ओखे तीन दिन मे खडी करी दिये?”<verse eid="JHN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21" />पर ओने अपनो आंग पर मन्‍दिर का बारे मे बोलतो थो. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />फिर जब उ मुर्दा मे से जिन्दो उठ्यो फिर ओका चेलाहोन खे याद आयो कि ओने यो बोल्यो थो. अरु उनने पवित्रशास्त्र अरु उ वचन को जो यीशु ने बोल्यो थो, विश्वास कर्यो.<verse eid="JHN 2:22" /></para>
  <para style="s">यीशु इन्सान का मन खे जानस हइ</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />जब उ यरुशलेम मे फसह का टेम को त्योहार मे थो, ते भोतझन ने उ चिन्ह खे जो उ दिखातो थो देखीखे ओका नाम पर विश्वास कर्यो. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />पर यीशु ने अपना आप खे उनका विश्वास पर नी छोडनु, क्युकी उ सब खे जानतो थो. <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />अरु ओखे प्रयोजन नी थो कि इन्सान का बारे मे कोय गवइ दे क्युकी उ खुद जानतो थो कि इन्सान का मन मे का हइ?<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">यीशु अरु नीकुदेमुस</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />फरीसीहोन मे से नीकुदेमुस नाम को एक इन्सान थो, जो यहूदीयाहोन को मुखियो थो. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />ओने रात खे यीशु का पास अयखे ओकासे बोल्यो, “हे गुरु, हम जानस हइ, कि तू परमेश्‍वर का तरफ से गुरु हुइ खे आयो हइ. क्युकी कोय इन चिन्ह खे जो तू दिखास हइ, अगर परमेश्वर ओका साथ नी हइ, ते नी दिखैइ सक्ये”<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />यीशु ने ओखे जवाब दियो, “मी तरा से सच्ची-सच्ची बोलुस हइ, अगर कोय नवा सिरा से नी जन्मे ते परमेश्वर को राज्य देख नी सक्ये.”<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />नीकुदेमुस ने ओकासे बोल्यो, “इन्सान जब बुढो हुइ गयो, ते कसो जन्म लि सकस हइ? उ अपना माय का गर्भ मे दूसरी बार प्रवेश करीखे जन्म लि सकस हइ?” <verse eid="JHN 3:4" /><verse number="5" style="v" sid="JHN 3:5" />यीशु ने जवाब दियो, “मी तरा से सच्ची-सच्ची बोलुस हइ, जब तक कोय इन्सान पानी अरु आत्मा से नी जन्मे ते उ परमेश्वर को राज्य मे प्रवेश नी करी सक्ये. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />क्युकी जो आंग से जन्म्यो हइ, वह आंग हइ. अरु जो आत्मा से जन्म्यो हइ, उ आत्मा हइ. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />अचम्बो नी करणु कि मेने तरा से बोल्यो, ‘तोखे नवा सिरा से जन्म लेनो जरुरी हइ.’ <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />हवा जिधर चलस हइ उधर चलस हइ, अरु तू ओकी अवाज सुनस हइ, पर नी जानु, कि वा खा से आस अरु किधर खे जास हइ? जो कोइ आत्मा से जन्म्यो हइ उ असा मे हइ.”<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />नीकुदेमुस ने ओखे जवाब दियो, “या बातहोन कसी हुइ सकस हइ?”<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />यो सुनीखे यीशु ने ओकासे बोल्यो, “तू इस्राएलिहोन को गुरु हुइखे भी का या बातहोन खे नी समझ्यो?” <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />मी तरा से सच्ची-सच्ची बोलुस हइ कि हम जो जानस हइ, उ बोलस हइ, अरु जेखे हमने देख्यो हइ ओकी गवइ देस हइ, अरु तुम हमारी गवइ स्वीकार नी करस. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />जब मेने तुम से पृथ्वी की बातहोन बोली, अरु तुम विश्वास नी कर्‍हे, ते अगर मी तुम से स्वर्ग की बातहोन बोलुका ते फिर क्यु विश्वास कर्ये? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />कोय स्वर्ग पर नी चड्यो, फक्त उ जो स्वर्ग से उतर्यो, अगर इन्सान को बेटो जो स्वर्ग मे हइ.<verse eid="JHN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14" />अरु जिस तरह से मूसा ने जंगल मे साप खे उच्चा पर चडायो, चाउ रीति से जरुरती हइ कि इन्सान को बेटो भी उच्चा पर चडायो जाये. <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />ताकि जो कोय ओका पर विश्वास कर्ये उ अनन्त जिवन पाये. <verse eid="JHN 3:15" /><verse number="16" style="v" sid="JHN 3:16" />क्युकी परमेश्वर ने जगत से असो प्रेम रख्यो कि ओने अपनो एकलौतो बेटो दि दियो, ताकि जो कोय ओ पर विश्वास कर्येका उ नाश नी हुइ खे पर अनन्त जिवन पाये. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />परमेश्वर ने अपना बेटा खे दुन्या मे येका लिये नी भेज्यो, कि जगत पर दण्ड की आज्ञा दे, पर येका लिए कि दुन्या ओका वजेसे उध्दार पाये.<verse eid="JHN 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18" />जो ओका पर विश्वास करस हइ, ओका पर दण्ड की आज्ञा नी होय, पर जो ओका पर विश्वास नी कर्‍हे, उ दोषी बनायो करी दी चुक्यो हइ. येका लिए कि ओने परमेश्वर का एकलौता बेटा का नाम पर विश्वास नी कर्यो. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />अरु न्याय की आज्ञा करण यो हइ कि ज्योति जगत मे अय हइ, अरु इन्सानहोन ने अंधारा खे ज्योति से जादा प्रिय जान्यो क्युकी उनको काम बुरो थो. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />क्युकी जो कोय बुरो करस हइ, उ ज्योति से बैर रखस हइ, अरु ज्योति का पास नी आय, असो नी हो कि ओका काम होन पर इलजाम लगायो जाये. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />पर जो सच्चीई पर चलस हइ, उ ज्योति का पास आस हइ, ताकि ओका काम मे प्रगट हो कि उ परमेश्वर का तरफ से कर्यो गयो हइ.<verse eid="JHN 3:21" /></para>
  <para style="s">यीशु का बारे मे यहून्ना की गवइ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />येका बाद यीशु अरु ओको सेवक यहूदीया देस मे आया. अरु उ व्हा उनका साथ र्‍हिखे बपतिस्मा देन लग्यो. <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />अरु यहून्ना भी सालेम का पास एनोन मे बपतिस्मा देतो थो, क्युकी व्हा भोत पानी थो, अरु इन्सानहोन अय खे बपतिस्मा लेता था. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />क्युकी यहून्ना वा टेम्म तक जोल खाना मे नी डाल्यो गयो थो.<verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />व्हा यहून्ना का सेवकहोन का कोय यहूदीया का साथ अच्छा का बारे मे वाद विवाद हुयो. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />अरु ओने यहून्ना का पास अयखे ओकासे बोल्यो, “हे गुरु, जो इन्सान यरदन नद्दी का पार तरा साथ था, अरु जोकी तोने गवइ दी हइ. देख, उ बपतिस्मा देस हइ, अरु सब ओका पास आस हइ.”<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />यहून्ना ने जवाब दियो, “जब तक इन्सान खे स्वर्ग से नी दियो जाये तब तक वह कुछ नी मीली सखे . <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />तुम तो आप मे मरा गवइ हइ, कि मेने बोल्यो, कि ‘मी मसीह नी हइ का पन ओका आगे भेजो गयो.’ <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />जोकी दुल्हिन हइ, उ दूलो हइ पर दूला को दोस्त जो खडो हुयो ओकी सुनस हइ, दूला की बात से भोत खुश होस हइ. अब मरी या खुशी पुरी हुइ हइ. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />जरुरती हइ कि उ बढ़े अरु मी घटू.”<verse eid="JHN 3:30" /></para>
  <para style="s">मसीह कि श्रेष्ठता</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />“जो उपर से आस हइ, उ सबसे अच्छो हइ, जो पृथ्वी से आस पृथ्वी को हइ. अरु पृथ्वी की बातहोन बोलस हइ जो स्वर्ग से आस हइ, उ सब का उपर हइ.<note caller="+" style="x"><char style="xo" closed="false">3:31 </char><char style="xt" closed="false"><ref loc="JHN 8:23">यहून्ना 8:23</ref></char></note> <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />जो कुछ ओने देख्यो, अरु सुन्यो हइ, ओकी गवइ देस हइ. अरु कोय ओकी गवइ ग्रहण नी कर्‍हे. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />जेने ओकी गवइ ग्रहण कर ली ओने या बात पर नीशान दि दी कि परमेश्वर सच्चो हइ. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />क्युकी जेखे परमेश्वर ने भेज्यो हइ, उ परमेश्वर की बातहोन बोलस हइ क्युकी वा आत्मा नापि खे नी दे. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />बाप बेटा से प्रेम रखस हइ, अरु ओने सब चिजहोन ओका हात मे दि दी हइ. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />जो बेटा पर विश्वास करस हइ, अनन्त जिवन ओको हइ. पर जो बेटा की नी माने, उ जिवन खे नी देख्ये पर परमेश्वर की घुस्सा ओका पर र्‍हेस हइ.”<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">यीशु को सामरी बय से बात करणो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />फिर जब प्रभु खे मालूम हुयो कि फरीसीहोन ने सुनायो हइ कि यीशु यहून्ना से जादा सेवक बनास अरु उनखे बपतिस्मा देस हइ. <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />अगर यीशु खुद नी क्युकी ओका सेवक बपतिस्मा देता था, <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />तब उ यहूदीयाहोन खे छोडी खे फिर गलील खे चली गयो, <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />अरु ओखे सामरिया से हुइखे जानो जरुरती थो.<verse eid="JHN 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5" />येकालिये उ सूखार नामक सामरिया का एक नगर तक आयो, जो वा जमीन का पास हइ जेखे याकूब ने अपनो बेटो यूसुफ खे दियो थो. <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />अरु याकूब को कुव्वो भी वहीं थो, यीशु रस्ता को थक्यो हुयो उ कुव्वा पर मे बठी गयो, अरु या बात नजीकपास दुपेर का टेम हुइ.<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />इत्ता मे एक सामरिया बय पानी भरन खे अय, यीशु ने ओकासे बोल्यो, “मेखे पानी पिला.” <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />ओका चेलाहोन तो नगर मे खानो मोल लेन खे गए था.<verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />वा सामरी बय ने ओकासे बोल्यो, “तू यहूदी हुइखे मेखे सामरी बय से पानी क्यु मागस हइ?” क्युकी यहूदी सामरिहोन का साथ कोय प्रकार को व्यव्हार नी रखे. <verse eid="JHN 4:9" /><verse number="10" style="v" sid="JHN 4:10" />यीशु ने जवाब दियो, “अगर तू परमेश्वर को वरदान खे जानती अरु यो भी जानती कि उ कोन हइ जो तरा से बोलस हइ, मेखे पानी पिला का ते तू ओकासे मागती का अरु उ तोखे जिवन को पानी देती.”<verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />बय ने ओकासे बोल्यो, “हे स्वामी, तरा पास पानी भरन खे तो कुछ हइ भी नी, अरु कुव्वो खोल हइ. ते फिर उ जिवन को पानी तरा पास खा से आयो? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />का तू हमारो बाप याकूब से बडो हइ, जेने हमखे यो कुव्वो दियो. अरु खुद ही अपना सन्तान अरु अपना जनवरहोन समेत ओमे से पीयो?”<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />यीशु ने ओखे जवाब दियो, “जो कोय यो पानी पीये उ फिर प्यासो हुये. <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />पर जो कोय उ पानी मे से पीये जो मी ओखे दियु, उ फिर पिडमपिडि तक प्यासो नी हुये. क्युकी जो पानी मी ओखे दियु, उ ओमे एक झरनो बनी जाये, जो अनन्त जिवन का लिये उमडतो र्‍हिये”<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />बय ने ओकासे बोल्यो, “हे प्रभु, उ पानी मेखे दे ताकिस मी प्यासी नी हुयु अरु नी पानी भरन खे इत्ता दूर आयु.”<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />यीशु ने ओकासे बोल्यो, “जा, अपना अदमी खे ह्या बुलैखे ला.”<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />बय ने जवाब दियो, “मी बिना अदमी की हइ,”</para>
  <para style="p" vid="JHN 4:17">यीशु ने ओकासे बोल्यो, “तू ठीक बोलस हइ, ‘मी बिना अदमी की हइ.’ <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />क्युकी तू पाच अदमी करी चुकी हइ, अरु जोका पास तू अब हइ उ भी तरो अदमी नी यो तोने सच्ची बोल्यो हइ.”<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />बय ने ओकासे बोल्यो, हे प्रभु, मेखे लगस हइ कि तू भविष्यव्दक्ता हइ. <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />हमारा बाप दादाहोन ने यो टेकडा पर परमेश्वर कि आराधना करी, अरु तुम बोलस हुये कि वा जगा झा आराधना करन खे होनु व्हा यरुशलेम मे हइ.स<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />यीशु ने ओकासे बोल्यो, “हे बय, मरी बात को विश्वास कर कि उ टेम आयो हइ कि तुम नी ते या टेकडि पर बाप को भजन कर्ये, नी यरुशलेम मे. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" /><note caller="+" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="JHN 4:22">4:22</ref> </char><char style="xt" closed="false"><ref loc="ISA 2:3">यशया 2:3</ref></char></note>तुम जेखे नी जाने, ओको भजन करस हइ. अरु हम जेखे जानस हइ, ओको भजन करस हइ. क्युकी उध्दार यहूदीहोन मे से हइ. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />पर उ टेम आयो हइ, क्युकी अब भी हइ, जेमे सच्चो भक्त बाप की आराधना आत्मा अरु सच्चीय से कर्ये, क्युकी बाप अपना लिये असोय भक्तहोन खे ढूढस हइ. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />परमेश्वर आत्मा हइ, अरु जरुरी हइ कि ओकी आराधना करणआला आत्मा अरु सच्चीइ से आराधना करणु.”<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />बय ने ओकासे बोल्यो, “मी जानुस हइ कि मसीह जो ख्रिस्त बोलस हइ, आनआला हइ. जब उ आह्ये ते हमखे सब बातहोन बतै दिये.”<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />यीशु ने ओकासे बोल्यो, “मी जो तरा से बोली रो हइ , उ हइ.”<verse eid="JHN 4:26" /></para>
  <para style="s">सेवकहोन की वापसी</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />इत्ता मे ओका सेवक अय गया , अरु अचम्बो करण लग्या कि वा बय से बात करी रो हइ. फिर भी कोय ने नी पूछ्यो, “तू का चाहस हइ?” या “को का लिये ओकासे बात करस हइ?”<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />तब बय अपनो मडका खे छोडी खे नगर मे चली गइ, अरु इन्सानहोन से बोलन लगी, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />“एक इन्सान खे देख्यो, जो ने सब कुछ जो मेने कर्यो मेखे बतय दियो का योही तो मसीह नी हइ?” <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />तब वे नगर से नीकली खे ओका पास आन लग्या.<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />इत्ता मे ओका सेवक यीशु से या प्रार्थना करण लग्या, “हे गुरु, कुछ ले.”<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />पर ओने उनसे बोल्यो, “मरा पास खान का लिये असो खानो हइ जेखे तुम नी जाने.”<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />तब सेवकहोन ने आपस मे बोल्यो, “का कोय ओका लिये कुछ खान खे लायो हइ?”<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />यीशु ने उनसे बोल्यो, “मरो खानो यो हइ, कि अपना भेजनआला की इच्छा का अनुसार चल्यू अरु ओको काम पूरो कर्यु. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />का तुम नी बोले, ‘पीक काटना मे अब भी चार महीना बाकी हइ’ देखनु, मी तुम से बोलुस हइ, अपनी आखहोन उठैखे खेतहोन पर नजर डालनु, कि वे काटन का लिये पकी चुक्या हइ. <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />अरु काटन आलो मजुरी पास का अरु अनन्त जिवन का लिये फल बटोरस हइ, ताकि बोनआलो अरु काटन आलो दोइ झन मीलीखे खुशी मनाये. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />क्युकी येका पर या खावत ठीक बठस हइ ‘बोनआलो अरु हइ काटन आलो अरु.’<note caller="+" style="x"><char style="xo" closed="false">4:37 </char><char style="xt" closed="false"><ref loc="MIC 6:15">मीखा 6:15</ref></char></note> <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />मेने तुमखे उ खेत काटन का लिये भेज्यो जोमे तुम ने मेहनत नी कर्यो दुसरा ने मेहनत कर्यो अरु तुम उनका मेहनत का फल मे हिस्सेदार हुया.”<verse eid="JHN 4:38" /></para>
  <para style="s">सामरिहोन को विश्वास करणो</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />अरु उ नगर का भोत सा सामरीहोन ने वा बय का बोलना से यीशु पर विश्वास कर्यो. जो ने या गवय दी थी, कि ओने सब कुछ जो मेने कर्यो हइ, मेखे बतै दियो. <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />तब जब या सामरी ओका पास अय, ते ओकासे प्रार्थना करण लगी कि हमारा ह्या र्‍हे, अरु उ व्हा दो दिन तक र्‍हियो.<verse eid="JHN 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41" />अरु ओका वचन का कारण अरु भी भोतझन ने विश्वास कर्यो. <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />अरु वा बय से बोल्यो, “अब हम तरा बोलना मे से विश्वास नी कर्‍हे. क्युकी हमने खुद ही सुनी लियो, अरु जानस हइ कि यो सच मुच ही जगत को उद्धारकर्ता हइ.”<verse eid="JHN 4:42" /></para>
  <para style="s">राजकर्मचारीहोन का बेटा खे अच्छो करनो</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />फिर उन दो दिन का बाद उ व्हा से नीकलीखे गलील खे गयो. <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />क्युकी यीशु ने खुद ही गवय दी कि भविष्यव्दक्ता अपना देस मे सम्मान नी पाय. <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />जब उ गलील मे आयो, ते गलीली खुशी का साथ ओकासे मील्या. क्युकी जोत्ता काम ओने यरुशलेम मे त्योहार का टेम मे कर्या था, उनने वे सब खे देख्यो थो , क्युकी वे भी त्योहार मे गया था.<verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />तब उ फिर गलील का काना मे आयो, झा ओने पानी खे अंगूर को रस बनायो थो उ राजा को एक कर्मचारी थो जोको बेटो कफरनहूम मे बीमार थो. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />उ यो सुनीखे कि यीशु यहूदीया से गलील मे अय गयो हइ, ओका पास गयो अरु ओकासे प्रार्थना करण लग्यो कि चलीखे मरा बेटा खे अच्छो करी दे क्युकी उ मरना पर हइ. <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />यीशु ने ओकासे बोल्यो, “जब तक तुम चिन्ह अरु अद्भुत काम नी देख्ये तब तक कभी भी विश्वास नी कर्ये”<note caller="+" style="x"><char style="xo" closed="false">4:48 </char><char style="xt" closed="false"><ref loc="DAN 4:2">दानिएल 4:2</ref></char></note><verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />राजा का कर्मचारी ने ओकासे बोल्यो, “हे प्रभु, मरा बेटा का मरना से पैयले चल.”<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />यीशु ने ओकासे बोल्यो, “जा, तरो बेटो जिन्दो हइ”</para>
  <para style="p" vid="JHN 4:50">उ इन्सान ने यीशु की बोली हुइ बात पर विश्वास कर्यो अरु चली गयो. <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />उ रस्ता मे थो, कि ओका सेवक ओकासे अयखे मील्या अरु बोलन लग्या, “तरो बेटो जिन्दो हइ.”<verse eid="JHN 4:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52" />ओने उनसे पूछ्यो, “कोय घडी उ अच्छो होन लग्यो?” उनने ओकासे बोल्यो, “कल सातवा घण्टा मे ओको ज्वर उतरी गयो.” <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />तब बाप जानी गयो कि यो उ घडी हुयो जो घडी यीशु ने ओकासे बोल्यो, “तरो बेटो जिन्दो हइ,” अरु ओने अरु ओका पुरा घराना ने विश्वास कर्यो.<verse eid="JHN 4:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54" />यो दूसरो चिन्ह थो जो यीशु ने यहूदीया से गलील मे अयखे दिखायो.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">अडोतीस साल का रोगी खे अच्छो करनो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />या बातहोन का बाद यहूदीयाहोन को एक त्योहार हुयो, अरु यीशु यरुशलेम खे गयो. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />यरुशलेम मे मेडा का फाटक का पास एक कुण्ड हइ, जो इब्रानी भाषा मे बैतहसदा बोलस हइ, अरु ओका पाच ओसरी हइ. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />येका मे भोत सा बीमार, अंधा, लगडा अरु सूख्या आंग आला पानी का हलान की आस मे पडया र्‍हेता था. <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />क्युकी चुन्या टेम पर परमेश्‍वर का स्वर्गदूत कुण्ड मे उतरीखे पानी खे हलायो करता था पानी हलाते मे जो कोय पैयले उतरतो, उ अच्छो हुइ जातो थो, चाह्ये ओकी कोय बीमारी क्यु नी हो. <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />व्हा एक इन्सान थो, जो अडतीस साल से बीमारी मे पड्यो थो. <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />यीशु ने ओखे पड्यो हुयो देखीखे अरु यो जानीखे कि उ भोत दिनहोन से योही दशा मे पड्यो हइ, ओकासे पूछ्यो “का तू अच्छो होनो चाहस हइ?”<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />उ बीमार ने ओखे जवाब दियो, “हे स्वामी, मरा पास कोय इन्सान नी, कि जब पानी हलायो जाये, ते मेखे कुण्ड मे उतारनु. पर मरा पहुचते-पहुचते दूसरो मरासे पैयले उतरी जास हइ.”<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />यीशु ने ओकासे बोल्यो, “उट, अपनी खटिया उठा अरु चल फिर.” <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />उ इन्सान तुरुत अच्छो हुइ गयो,</para>
  <para style="p" vid="JHN 5:9">अरु अपनी खटिया उठैइखे चलन फिरन लग्यो. <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />उ अराम को दिन थो, येका लिए यहूदीया ओकासे जो अच्छो हुयो थो, बोलन लग्यो, “आज तो अराम को दिन हइ, तोखे खटिया उठानो अच्छो नी.”<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />ओने उनखे जवाब दियो, “जेने मेखे अच्छो कर्यो, ओने मरासे बोल्यो, अपनी खटिया उठैइखे चल फिर.”<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />उनने ओकासे पुछ, “उ कोन इन्सान हइ, जो ने तरा से बोल्यो, खटिया उठा अरु चल फिर?” <verse eid="JHN 5:12" /><verse number="13" style="v" sid="JHN 5:13" />पर जो अच्छो हुइ गयो थो, उ नी जानतो थो कि उ कोन हइ. क्युकी वा जगा मे गर्दी होना कारण यीशु व्हा से हटी गयो थो.<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />या बातहोन का बाद उ यीशु खे मन्‍दिर मे मील्यो, तब ओने ओकासे बोल्यो, “देख, तू तो अच्छो हुइ गयो हइ. फिर से पाप मत करणु, असो नी हुये कि येका से कोय भारी विपत्ति तरा पर अय पड्ये.” <verse eid="JHN 5:14" /><verse number="15" style="v" sid="JHN 5:15" />उ इन्सान ने जैइखे यहूदीयाहोन से बोली दियो, कि जो ने मेखे अच्छो कर्यो, उ यीशु हइ. <verse eid="JHN 5:15" /><verse number="16" style="v" sid="JHN 5:16" />यो वजेसे यहूदीया यीशु खे सतान लग्या, क्युकी उ असो-असो काम अराम का दिन करतो थो.<verse eid="JHN 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 5:17" />येका पर यीशु ने उनसे बोल्यो, “ मरो बाप अब तक काम करस हइ, अरु मी भी काम करुस हइ.”<verse eid="JHN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18" />येका वजेसे यहूदीया अरु भी जादा ओखे मारी डालन की कोशीस करण लग्या, कि उ नी फक्त आराम का दिन की विधी खे तोडतो, पर परमेश्वर खे अपनो बाप बोलीखे, अपना आप खे परमेश्वर का बराबर ठहरातो थो.<verse eid="JHN 5:18" /></para>
  <para style="s">बेटा को अधिकार</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />येका पर यीशु ने उनसे बोल्यो, मी तुम से सच्ची-सच्ची बोलुस हइ, बेटो खुद से कुछ नी करी सकतो; फक्त उ जो बाप खे करते देखस हइ, क्युकी जो काम होन खे उ करस हइ, उनखे बेटो भी उ रीति से करस हइ. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />क्युकी बाप बेटा से प्रेम करस हइ. अरु जो-जो काम उ खुद करस हइ, उ सब ओखे दिखस हइ. अरु उ इनसे भी बडा काम ओखे दिखाये का ताकि तुम अचम्बो करणु. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />क्युकी जसो बाप मऱ्या हुया खे उठास अरु जिलास हइ, ओसो ही बेटो भी जेखे चाहस हइ, उनखे जिलास हइ. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />बाप कोय को न्याय भी नी कर्‍हे, पर न्याय करण को सब काम बेटा खे सोपी दियो हइ, <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />येका लिए कि सब इन्सान जसो बाप को सम्मान करस हइ ओसो मे बेटा को भी सम्मान करणु.जो बेटा को सम्मान नी कर्‍हे, उ बाप खे जेने ओखे भेज्यो हइ, सम्मान नी कर्‍हे.<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />मी तुम से सच्ची-सच्ची बोलुस हइ, जो मरो वचन सुनीखे मरा भेजनआला पर विश्वास करस हइ, अनन्त जिवन ओको हइ, अरु ओका पर दण्ड की आज्ञा नी होती पर उ मरना से पार हुइखे जिवन मे प्रवेश करी चुक्यो हइ. <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />“मी तुम से सच्ची-सच्ची बोलुस हइ, उ टेम आस हइ, अरु अब हइ, जेमे मर्यो परमेश्वर का बेटा को शब्द सुन्ये का अरु जो सुन्ये वे जीये. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />क्युकी जो रीति से बाप अपना आप मे जिवन रखस हइ, उ रीति से ओने बेटा खे भी यो अधिकार दियो हइ कि अपना आप मे जिवन रखनु. <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />अगर ओखे न्याय करण को भी अधिकार दिया हइ, येका लिए कि उ इन्सान को बेटो हइ. <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />येका से अचम्बो मत करणु. क्युकी उ टेम आस हइ, कि जोत्ता कब्रहोन मे हइ, ओको शब्द सुनीखे नीकल्ये. <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />जेने भलाइ करी हइ, वे जिवन का पुनरुत्थान का लिये जी उठ्ये अरु जेने बुरोइ करी हइ, वे दण्ड का पुनरुत्थान का लिये जी उठ्ये. <note caller="+" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="DAN 12:2">दानिएल 12:2</ref></char></note><verse eid="JHN 5:29" /></para>
  <para style="s">यीशु का बारे मे गवइ</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30" />“मी अपना आप से कुछ नी करी सकु जसो सुनुस हइ, ओसो न्याय करुस हइ, अरु मरो धर्मी सच्चो हइ. क्युकी मी अपनी इच्छा नी खे पर अपनो भेजन आला की इच्छा चाहुस हइ.<verse eid="JHN 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />“अगर मी खुद मे अपनी गवइ दियु. ते मरी गवइ सच्ची नी. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />एक अरु हइ जो मेरी गवइ देस हइ, अरु मी जानुस हइ कि मरी जो गवइ उ देस हइ, वा सच्ची हइ. <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" />तुम ने यहून्ना से पुछ्यो अरु ओने सच्ची की गवइ दी हइ. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />पर मी अपना बारे मे इन्सान की गवइ नी चाहु. फिर भी मी या बातहोन येका लिये बोलुस हइ, कि तुमखे उध्दार मील्ये. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />उ तो जलस अरु चमकतो हुयो दिवो थो. अरु तुमखे कुछ देर तक ओका उजाला मे मगन होनो अच्छा लग्यो. <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />पर मरा पास जो गवइ हइ, उ यहून्ना की गवइ से बडी हइ क्युकी जो काम बाप ने मेखे पूरो करण खे सोप्यो हइ अगर योही काम जो मी करुस हइ, वे मरा गवाह हइ, कि बाप ने मेखे भेज्यो हइ. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />अरु बाप जो ने मेखे भेज्यो हइ, ओ ने मरी गवइ दी हइ तुम ने नी कभी ओकी आवाज सुन्यो, अरु नी ओको रुप देख्यो हइ. <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />अरु ओको वचन खे मन मे स्थिर नी रख्ये क्युकी जेखे ओने भेज्यो तुम ओका पर विश्वास नी कर्‍हे. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />तुम पवित्रशास्त्र मे ढूडस हइ, क्युकी समझस हइ कि ओमे अनन्त जिवन तुमखे मीलस हइ, अरु यो उ हइ, जो मरी गवइ देस हइ. <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />फिर भी तुम जिवन पान का लिये मरा पास आनो नी चाह्ये.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />“मी इन्सानहोन से सम्मान नी चाहु. <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />पर मी तुमखे जानुस हइ, कि तुम मे परमेश्वर को प्रेम नी. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />मी अपना बाप को नाम से आयो हइ, अरु तुम मेखे ग्रहण नी कर्‍हे. अगर कोय अरु अपना ही नाम से आयो, ते ओखे ग्रहण करी लिये. <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />तुम जो एक दूसरा से सम्मान चाहस हइ अरु उ सम्मान जो एकमात्र परमेश्वर का तरफ से हइ, नी चाह्ये, कि कोय प्रकार विश्वास करी सकस हइ? <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />यो नी समझनु कि मी बाप का सामने तुम पर दोस लगाह्यु, तुम पर दोस लगानआलो तो हइ, यानेकी मूसा हइ जेका पर तुम ने भरोसो रख्यो हइ. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />क्युकी अगर तुम मूसा पर विश्वास करस, ते मरा पर भी विश्वास करस, येका लिए कि ओने मरा बारे मे लिख्यो हइ.<note caller="+" style="x"><char style="xo" closed="false">5:46 </char><char style="xt" closed="false"><ref loc="LUK 24:27">लूका 24:27</ref></char></note> <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />पर अगर तुम ओकी लिखी हुइ बातहोन पर विश्वास नी कर्‍हे, ते मरी बातहोन पर का विश्वास कर्ये?”<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">यीशु को पाच हजार दुन्याहोन खे खलानो</para>
  <para style="r">(<ref loc="MAT 14:13-21">मत्ती 14:13-21</ref>; <ref loc="MRK 6:30-44">मरकुस 6:30-44</ref>; <ref loc="LUK 9:10-17">लूका 9:10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />या बातहोन का बाद यीशु गलील को तललाव मंनजे तिबिरियुस की तलाव का पार गयो. <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />अरु एक बडी गर्दी ओका पीछे हुइ गइ क्युकी जो आश्चर्य कर्म उ बीमारहोन पर दिखातो थो वे उनखे देखेता था. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />तब यीशु टेकडी पर चडीखे अपना सेवक होन का साथ व्हा बठ्यो. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />अरु यहूदीयाहोन को फसह को त्योहार पास थो. <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />तब यीशु ने अपनी आखहोन उठ्यैखे एक बडी गर्दी खे अपना पास आते देख्यो, अरु फिलिप्पुस ने बोल्यो, “ हम इनखे खान का लिये खा से रोटी मोल लाह्या?” <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />पर ओने या बात ओखे परखन का लिये बोली. क्युकी उ खुद जानतो थो कि उ का कर्ये.<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />फिलिप्पुस ने ओखे जवाब दियो, “दो सौ सिक्का की रोटी भी उनका लिये पूरी नी हुये कि उनमे से हर एक खे थोड़ी-थोड़ी मीली जाये.”<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />ओका सेवक होन मे से शमौन पतरस को भैइ अन्द्रियास ने ओकासे बोल्यो , <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />“ह्या एक पोर्यो हइ, जोका पास जौ की पाच रोटी अरु दो मच्छीहोन हइ, पर इत्ता दुन्या का लिये वे का हइ.”<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />यीशु ने बोल्यो, “दुन्याहोन कि बठ्यैइ दे” वा जगा भोत घास था, तब वे दुन्या जो गिनती मे नजीकपास पाच हजार था, बठी गा. <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />तब यीशु ने रोटिहोन लीखे अरु धन्यवाद करीखे बठन आलाहोन खे बाटी खे बाटी दी. अरु ओसो मे मच्छीहोन मे से जोतनी वे चाहता था बाटी दि. <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />जब वे खैइ खे मगम हुइ गया, ते ओने अपना सेवक होन से बाटी ले बोलयो, “बच्या हुया टुकडा से बारा टोपली जमा करी ले, कि कुछ फेक्यो नी जाये.” <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />येका लिये उनने जमा हुया, अरु जौ की पाच रोटिहोन का टुकडा जो खानआला से बची र्‍हि थी, उनकी बारह टोपलीहोन भरी.<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />तब जो आश्चर्यकर्म ओने करी दिखायो ओखे वे इन्सान देखी खे बोलन लग्या. कि “उ भविष्यव्दक्ता जो जगत मे आनआलो थो जरुरत योही हइ.” <note caller="+" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="MAT 21:11">मत्ती 21:11</ref></char></note> <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />यीशु यो जानीखे कि वे ओखे राजो बनान का लिये अयखे पकडनो चाहस हइ, फिर टेकडी पर अयखेलो चले गयो.<verse eid="JHN 6:15" /></para>
  <para style="s">यीशु को पानी पर चलनो</para>
  <para style="r">(<ref loc="MAT 14:22-33">मत्ती 14:22-33</ref>; <ref loc="MRK 6:45-52">मरकुस 6:45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />फिर जब संज्जा हुइ, ते ओका सेवक होन से झील का किनारा गया, <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />अरु डोंगा पर चडीखे झील का पार कफरनहूम खे बिदा करण लग्यो वा टेम अधारो हुइ गयो थो, अरु यीशु अभी तक उनका पास नी आयो थो. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />अरु आधी करण झील मे लहरहोन उठन लगी. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />तब जब वे खेते-खेते तीन चार मील का नजीकपास नीकली गया, ते उनने यीशु खे झील पर चलता, अरु डोगा का पास आते देख्यो, अरु डरी गया. <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />पर ओने उनसे बोल्यो, हिम्मत रख मी आयो, डरनु मत. <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />तब वे ओखे डोंगा पर चडैइ देन का लिये तैयार हुया अरु जल्दी उ डोंगा उ जमीन पर जा पहुच्यो जहा उ जातो थो.<verse eid="JHN 6:21" /></para>
  <para style="s">इन्सानहोन को यीशु खे ढूढनो</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />दूसरा दिन वा गर्दी ने जो झील का पार खड़ी थी, यो देख्यो, कि यो एक खे छोडी खे अरु कोय छोटा डोंगा नी थो, अरु यीशु अपना सेवक होन का साथ वा डोंगा पर नी चड्यो, पर फक्त ओका सेवक मे गया था. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />ते भी अरु छोटी डोगाहोन तिबिरियुस से वा जगा पास अय, झा उनने प्रभु खे धन्यवाद करण का बाद रोटी खय थी. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />जब गर्दी ने देख्यो, कि ह्या नी यीशु हइ, अरु नी ओका सेवक, ते वे भी छोटी-छोटी डोगाहोन पर चडी खे यीशु खे ढुढतो हुया कफरनहूम खे पहुच्या.<verse eid="JHN 6:24" /></para>
  <para style="s">यीशु जिवन की रोटी</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />अरु झील का पार ओकासे मीलीखे बोल्यो, “हे गुरु, तू ह्या कब आयो?”<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />यीशु ने उनखे जवाब दियो, “मी तुम से सच्ची-सच्ची बोलुस हइ, तुम मेखे येका लिए नी ढूढस हइ कि तुम ने चमत्कार काम देख्या, पर येका लिए कि तुम रोटिहोन खैइ खे तृप्त हुया. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />नाशवान खाना का लिये परिश्रम नी करणु, पर उ खाना का लिये जो अनन्त जिवन तक ठैइरस हइ, जेखे इन्सान को बेटो तुमखे दिये क्युकी बाप खे मंनजे परमेश्वर ने ओका पर नीशान करी दी हइ.”<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />उनने ओकासे बोल्यो, “परमेश्वर काम कारण का लिये हम खे करणु?”<verse eid="JHN 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29" />यीशु ने उनखे जवाब दियो, “परमेश्वर को काम यो हइ, कि तुम ओका पर जेखे ओने भेज्यो हइ, विश्वास करणु.”<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />तब उनने ओकासे बोल्यो, “फिर तू कोन सो चिन्ह दिखास हइ कि हम ओखे देखीखे तरा पर विश्वास करणु? तू कोन सो काम दिखास हइ? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />हमारा बुजुरुखहोन ने जंगल मे मेडो खायो. जसो लिख्यो हइ, ‘ओने उनखे खान का लिये स्वर्ग से रोटी दी.’” <verse eid="JHN 6:31" /><verse number="32" style="v" sid="JHN 6:32" />यीशु ने उनसे बोल्यो, “मी तुम से सच्ची-सच्ची बोलुस हइ कि मूसा ने तुमखे वा रोटी स्वर्ग से नी दी, पर मरो बाप तुमखे सच्ची रोटी स्वर्ग से देस हइ. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />क्युकी परमेश्वर की रोटी वाइ हइ, जो स्वर्ग से उतरीखे जगत खे जिवन देस हइ.”<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />तब उनने ओकासे बोल्यो, “हे स्वामी, या रोटी हमखे हमेशा दिया करणु.”<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />यीशु ने उनसे बोल्यो, “जिवन की रोटी मी हइ जो मरा पास आह्ये उ कभी भूखो नी हुये अरु जो मरा पर विश्वास कर्ये उ कभी प्यासो नी हुये. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />पर मेने तुम से बोल्यो, कि तुम ने मेखे देखी भी लियो हइ, ते भी विश्वास नी कर्ये. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />जो कुछ बाप मेखे देस हइ वे सब मरा पास अह्ये का अरु जो कोय मरा पास आह्ये ओखे मी कभी नी नीकालीयु. <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />क्युकी मी अपनी इच्छा नी क्युकी अपना भेजनआला की इच्छा पूरी करण का लिये स्वर्ग से उतर्यो हइ. <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />अरु मरा भेजनआला की इच्छा या हइ कि जो कुछ ओने मेखे दियो हइ, ओमे से मी कुछ नी खोयु पर ओखे अन्नत दिन फिर जिन्दो उठायु. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />क्युकी मरा बाप की इच्छा या हइ, कि जो कोय बाप खे देख्ये का अरु बेटा पर विश्वास कर्यु, उ अन्नत जिवन पाये. अरु मी ओखे अनन्त दिन मे फिर जिन्दो उठायु.”<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />तब यहूदीया ओका पर कुरकुर करण लग्या, येका लिए कि ओने बोल्यो थो, “जो रोटी स्वर्ग से उतरी खे वा मी हइ.” <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />अरु उनने बोल्यो “ का यो यूसुफ को बेटो यीशु नी, जोका माय बाप खे हम जानस हइ? ते उ क्यु बोलस हइ कि मी स्वर्ग से उतर्यो हइ?”<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />यीशु ने उनखे जवाब दियो, “आपस मे मत कुरकुरानु. <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />कोय मरा पास नी अय सक्ये का जब तक बाप जेने मेखे भेज्यो हइ, ओखे खीची नी ले. अरु मी ओखे अन्नत दिन फिर जिला उठायु. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />भविष्यव्दक्ताहोन कि किताबहोन मे यो लिख्यो हइ वे सब परमेश्वर का तरफ से सिखाया हुया हुये खे जेखे कोय ने बाप से सुन्यो अरु सीख्यो हइ, उ मरा पास आस हइ. <note caller="+" style="x"><char style="xo" closed="false">6:45 </char><char style="xt" closed="false"><ref loc="ISA 54:13">यशया 54:13</ref></char></note> <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />यो नी, कि कोय ने बाप खे देख्यो हइ पर जो परमेश्वर का तरफ से हइ, फक्त ओ ने बाप खे देख्यो हइ. <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />मी तुम से सच्ची-सच्ची बोलुस हइ, कि जो कोय विश्वास करस हइ, अनन्त जिवन ओ को हइ. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />जिवन की रोटी मी हइ. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />तुमारा बुजुरुखहोन ने जंगल मे मन्ना खायो अरु मरी गया. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />या वा रोटी हइ जो स्वर्ग से उतरस हइ ताकि इन्सान ओमे से खाये अरु नी मर्ये. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />जिवन की रोटी जो स्वर्ग से उतरी मी आय अगर कोय या रोटी मे से खाये ते कभी भी जीवित र्‍हिये. अरु जो रोटी मी जगत कि जिवन का लिये दिह्यु, उ मरो मास हइ.”<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />येका पर यहूदीया यो बोलीखे आपस मे झगडन लग्या, “यो इन्सान कसो हमखे अपनो मास खान खे दि सकस हइ?” <verse eid="JHN 6:52" /><verse number="53" style="v" sid="JHN 6:53" />यीशु ने उनसे बोल्यो, “मी तुम से सच्ची-सच्ची बोलुस हइ जब तक इन्सान का बेटा को मास नी खाये, अरु ओको खुन नी पीयेका तुम मे जिवन नी. <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />जो मरो मास खास अरु मरो खुन पीस हइ, अनन्त जिवन ओ को हइ, अरु मी अन्नत दिन फिर ओखे जिन्दो उठाह्ये. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />क्युकी मरो मास वास्तव मे खान की चिज हइ अरु मरो खुन वास्तव मे पीन की चिज हइ. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />जो मरो मास खाये अरु मरो खुन पीस हइ, उ मरा मे स्थिर बन्यो र्हेस हइ, अरु मी ओमे. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />जसो जीन्दा बाप ने मेखे भेज्यो अरु मी बाप का करण जिन्दो हइ ओसा मे उ भी जो मेखे खाये मरा कारण जिन्दो र्‍हिये. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />जो रोटी स्वर्ग से उतरी या हइ, बुजुरुखहोन का जसा नी कि खायेका अरु मरी गया. जो कोय या रोटी खाये उ कभी भी जिन्दो र्‍हिये.”<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />ये बातहोन ओने कफरनहूम का एक आराधनालय मे उपदेस देता टेम बोली.<verse eid="JHN 6:59" /></para>
  <para style="s">अनन्त जिवन को वचन</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />येका लिये ओका सेवकहोन मे से भोतजन ने यो सुनीखे बोल्यो, “या तो कठोर शिक्षा हइ. येखे कोन मानी सकस हइ?”<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />यीशु ने अपना मन मे यो जानीखे कि मरा सेवक आपस मे या बात पर कुरकुर करीस हइ, उनसे पूछ्यो का “या बात से तुमखे ठोकर लगस हइ? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />अरु अगर तुम इन्सान का बेटा खे झा उ पैयले थो, व्हा उपर जाता देख्ये का ते हुये?<note caller="+" style="x"><char style="xo" closed="false">6:62 </char><char style="xt" closed="false"><ref loc="PSA 47:5">भजन संहिता 47:5</ref></char></note> <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />आत्मा तो जिवनदायक हइ, आंग से कुछ लाभ नी जो बातहोन मेने तुम से बोली हइ वे आत्मा हइ, अरु जिवन भी हइ. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />पर तुम मे से खेताने असो हइ जो विश्वास नी कर्‍हे” क्युकी यीशु तो पैयले मे से जानतो थो कि जो विश्वास नी कर्येका वे कोन हइ. अरु कोन मेखे पकडाये. <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />अरु ओने बोल्यो, “येका लिये मेने तुम से बोल्यो थो कि जब तक कोय खे बाप का तरफ से यो वरदान नी दियो जाये तब तक उ मरा पास नी अय सक्ये.”<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />येका पर ओका सेवक होन मे से भोत सारा उल्टा फिरी गया अरु येका बाद ओका साथ नी चल्यो. <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />तब यीशु ने उन बारा जन से बोल्यो का “तुम भी चली जानु चाहस हइ?”<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />शमौन पतरस ने ओखे जवाब दियो, “हे प्रभु, हम कोका पास जाये? अनन्त जिवन की बातहोन तो तरा ही पास हइ. <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />अरु हमने विश्वास कर्यो, अरु जानी गया हइ, कि परमेश्वर पवित्र जन तू ही हइ.”<verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />यीशु ने उनखे जवाब दियो का “मेने तुम बारा झन खे नी चुनी लियो? ते भी तुम मे से एक इन्सान सैतान हइ.” <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />यो ओने शमौन इस्करियोती को बेटो यहूदा का बारे मे बोल्यो, क्युकी योही जो उन बारा जन मे से थो, ओखे पकडान खे थो.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">यीशु को झोपडि मे खानो खान खे जानो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />या बातहोन का बाद यीशु गलील मे फिरतो र्‍हियो, क्युकी यहूदी ओखे मारी डालन का शाजीस करी र्‍हा था, येकालिये उ यहूदीया मे फिरनो नी चाहतो थो. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />अरु यहूदीहोन कि एक तिवार झोपडिहोन को तिवार पास थो. <note caller="+" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="LEV 23:34">लैव्यव्यवस्था 23:34</ref></char></note> <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />येकालिये ओका भैइहोन ने ओकासे बोल्यो, “ह्या से कूच करीखे यहूदीया मे चली जा, कि जो काम तू करस हइ, उनखे तरा सेवक भी देख्ये. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />क्युकी असो कोइ नी हुये जो प्रसिद्ध होनो चाह्ये, अरु रुखी खे काम कर्ये अगर तू यो काम करस हइ, ते अपना आप खे जगत पर प्रगट कर.” <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />क्युकी ओका भैइ भी ओका पर विश्वास नी करता था.<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />तब यीशु ने उनसे बोल्यो, “मरो टेम अभी नी आयो. पर तुमारा लिये सब टेम हइ. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />जगत तुम से बैर नी कर सक्ये, पर उ मरासे बैर करस हइ, क्युकी मी ओका विरोध मे या गवय देउस हइ, कि ओको काम बुरो हइ. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />तुम त्योहार मे जाओ. मी अभी यो त्याहार मे नी जउ, क्युकी अभी तक मरो टेम पूरो नी हुयो.” <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />उ उनसे या बातहोन बोलीखे गलील मे र्ही गयो.<verse eid="JHN 7:9" /></para>
  <para style="s">झोपडिहोन को त्योहार मे यीशु</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />पर जब ओका भैइ त्योहार मे चली गया, ते उ खुद मे प्रगट मे नी, पर माननु गुप्त हुइखे गया. <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />यहूदी त्योहार मे ओखे यो बोलीखे ढूढ़न लग्या कि “उ खा हइ?”<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />अरु दुन्या मे ओका बारे चुपखे-चुपखे भोत सी बातहोन हुइ कत्ता बोलता था, “उ अच्छो इन्सान हइ” अरु कत्ता बोलता था, “नी, उ दुन्याहोन खे भरमास हइ.” <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />ते भी यहूदीहोन का डर का मारे कोय इन्सान ओका बारे मे खुली खे नी बोलतो थो.<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />अरु जब त्योहार का आधो दिन बीती गयो. ते यीशु मन्दिर मे जैइखे उपदेस करण लग्यो. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />तब यहूदीहोन ने अचम्बो करीखे बोल्यो, “येखे बिन पडी शिक्षन कसी अय गइ?”<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />यीशु ने उनखे जवाब दियो, “मरो उपदेस मरो नी, पर मरो भेजनआला को हइ. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />अगर कोय ओकी इच्छा पर चलनो चाह्ये, ते उ यो उपदेस का बारे मे जानी जाये कि उ परमेश्वर का तरफ से हइ, या मी अपना तरफ से बोलूस हइ. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />जो अपना तरफ से कुछ बोलस हइ, उ अपनी मे बढ़ाइ चाहस हइ. पर जो अपना भेजनआला की बडाइ उ चाहस हइ उ सच्ची हइ, अरु ओमे बुरोकाम नी. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />का मूसा ने तुमखे व्यवस्था नी दी? ते भी तुम मे से कोय व्यवस्था पर नी चले, तुम का मेखे मारी डालनो चाहस हइ?”<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />दुन्याहोन ने जवाब दियो “तरा मे बुरीआत्मा हइ! कोन तोखे मारी डालनो चाहस हइ?”<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />यीशु ने उनखे जवाब दियो, “मेने एक काम कर्यो, अरु तुम सब अचम्बो करस हइ. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />यो कारण मूसा ने तुमखे खतना की आज्ञा दी हइ, यो नी कि उ मूसा का तरफ से हइ पर बुर्जुकहोन से चली अय हइ, अरु तुम अराम का दिन खे इन्सान को खतनो करस हइ. <note caller="+" style="x"><char style="xo" closed="false">7:22 </char><char style="xt" closed="false"><ref loc="GEN 17:10-13">उत्पत्ति 17:10-13</ref>; <ref loc="LEV 12:3">लैव्यव्यवस्था 12:3</ref></char></note> <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />जब अराम का दिन इन्सान को खतनो कर्या जास हइ ताकि मूसा की व्यवस्था की आज्ञा टली नी जाये, ते तुम मरा पर का येकालिये घुस्सा करस हइ, कि मेने अराम का दिन एक इन्सान का पूरी रीति से अच्छो कर्यो. <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />मुडो देखीखे धर्मी नी करणु, पर ठीक-ठीक न्याय करणु.”<note caller="+" style="x"><char style="xo" closed="false">7:24 </char><char style="xt" closed="false"><ref loc="ISA 11:3">यशया 11:3</ref>; <ref loc="JHN 8:15">यहून्ना 8:15</ref></char></note><verse eid="JHN 7:24" /></para>
  <para style="s">का यीशु मे मसीहा हइ</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />तब कत्ताने यरुशलेम वासीहोन बोलन लग्या, “का यो उ नी, जेखे मारी डालन की कोशिश कर्यो जय रो हइ? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />पर देखनु, उ तो खुल्लमखुल्ला बातहोन करस हइ अरु कोय ओकासे कुछ नी बोले. का मुमकीन हइ कि मुखियोहोन ने सच्ची सच्ची जानी लियो हइ. कि योही मसीह हइ? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />येखे तो हम जानस हइ, कि यो खा को हइ. पर मसीह जब आह्ये, तो कोइ नी जान्ये कि उ खा को हइ.”<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />तब यीशु ने मन्दिर मे उपदेस देते हुये पुकारी खे बोल्यो, “तुम मेखे जानस हइ कि यो भी जानस हइ कि मी खा को हइ, मी तो खुद से नी आयो पर मरो भेजनआलो सच्ची हइ, ओखे तुम नी जाने. <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />मी ओखे जानुस हइ. क्युकी मी ओका तरफ से हइ अरु ओने मेखे भेज्यो हइ.”<verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />येका पर उनने ओखे पकडनो चाह्यो ते भी कोय ने ओका पर हात नी डाल्यो, क्युकी ओको टेम अब तक नी आयो थो. <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />अरु गर्दी मे से भोतजन ने ओका पर विश्वास कर्यो, अरु बोलन लग्या, “मसीह जब आह्ये, ते का येकासे जादा चिन्ह खे दिखाये जो येने दिखाया?”<verse eid="JHN 7:31" /></para>
  <para style="s">यीशु खे पकडन की कोशिश</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />फरीसीहोन ने दुन्याहोन खे ओका बारे मे या बातहोन लुकीखे-लुकीखे करता सुन्यो. अरु मुखियो याजकहोन अरु फरीसीहोन ने पकडन खे सेवक भेज्या. <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />येका पर यीशु ने बोल्यो, “मी थोडि देर तक अरु तुमारा साथ हइ. तब अपना भेजनआला का पास चली जायु. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />तुम मेखे ढूढ्ये का पर नी पाये अरु झा मी हइ, व्हा तुम नी अय सक्ये.”<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />यहूदीहोन ने आपस मे बोल्यो, यो खा जाये कि हम येखे नी पाये? का उ उनका पास जाये जो यूनानीहोन मे तितर-बितर हूइ खे र्‍हेस हइ, अरु यूनानीहोन खे भी उपदेस दिये?<verse eid="JHN 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 7:36" />या का बात हइ जो उनने बोली कि तुम मेखे ढूढ्ये का पर नी पाये: अरु झा मी हइ, व्हा तुम नी अय सक्ये?<verse eid="JHN 7:36" /></para>
  <para style="s">जिवन-पानी की नद्दिहोन</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />फिर त्योहार का अन्नत दिन, जो मुख्य दिन हइ, यीशु खडो हुयो अरु पुकारी खे बोल्यो, “अगर कोइ प्यासो हइ ते मरा पास आनु अरु पीनु. <note caller="+" style="x"><char style="xo" closed="false">7:37 </char><char style="xt" closed="false"><ref loc="ISA 55:1">यशया 55:1</ref></char></note> <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />जो मरा पर विश्वास कर्ये, जसो पवित्रशास्त्र मे आयो हइ, ‘ओका अंदर से जिवन कि पानी की नदिहोन बोहय नीकल्ये.’” <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />ओने यो वचन या आत्मा का बारे मे बोल्यो, जो ओका पर विश्वास करण आला पाना पर था. क्युकी आत्मा आब तक नी उतरी थी, क्युकी यीशु आब तक अपनी महिमा खे नी पहुच्यो थो. <note caller="+" style="x"><char style="xo" closed="false">7:39 </char><char style="xt" closed="false"><ref loc="ISA 44:3">यशया 44:3</ref></char></note><verse eid="JHN 7:39" /></para>
  <para style="s">यीशु का बारे मतभेद</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />तब गर्दी मे से कोइ-कोइ ने या बातहोन सुनी खे बोल्यो, “सच मुच योही उ भविष्यव्दक्ता हइ.” <note caller="+" style="x"><char style="xo" closed="false">7:40 </char><char style="xt" closed="false"><ref loc="MAT 21:11">मत्ती 21:11</ref></char></note><verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />दुसराहोन ने बोल्यो, “यो मसीह हइ,” पर कोय ने बोल्यो,</para>
  <para style="p" vid="JHN 7:41">“क्यु? का मसीह गलील से आह्ये? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />का पवित्रशास्त्र मे नी आयो कि मसीह दाउद का वंश से अरु बैतलहम गाव से आह्ये, झा दाउद र्हेतो थो?” <note caller="+" style="x"><char style="xo" closed="false">7:42 </char><char style="xt" closed="false"><ref loc="ISA 11:1">यशया 11:1</ref>; <ref loc="MIC 5:2">मीखा 5:2</ref></char></note> <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />अन्नत ओका कारण दुन्याहोन मे फूट पडि. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />उनमे से कत्ताने ओखे पकडनो चाहता था, पर कोय ने ओका पर हात नी डाल्यो.<verse eid="JHN 7:44" /></para>
  <para style="s">यहूदी सेवक होन को अविश्वास</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />तब सेवकहोन मुखियो याजकहोन अरु फरीसीहोन का पास आह्ये, अरु उनने उनसे बोल्यो, “तुम ओखे क्यु नी लाये?”<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />सेवकहोन ने जवाब दियो, “कोय इन्सान ने कभी असी बातहोन नी करी.”<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />फरीसीहोन ने उनखे जवाब दियो, “का तुम भी भरमाया गया हइ.” <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />का मुखियोहोन या फरीसीहोन मे से कोय ने भी ओका पर विश्वास कर्यो हइ? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />पर ये इन्सान जो व्यवस्था नी जाने “का हमारी व्यवस्था कोय इन्सान खे जब तक पैयले ओकी सुनीखे जानी नी ले कि उ का करस हइ. दोषी ठहरास हइ?” <verse eid="JHN 7:49" /><verse number="50" style="v" sid="JHN 7:50" />नीकुदेमुस ने जो पैयले ओका पास आयो थो अरु उनमे से एक थो, उनसे बोल्यो, <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />“का हमारी व्यवस्था कोय इन्सान खे जब तक पैयले ओकी सुनीखे जानी नी ले कि उ का करस हइ; दोषी ठहरास हइ?”<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />उनने ओखे जवाब दियो, “का तू भी गलील को हइ? ढूढ़ अरु देख, कि गलील से कोय भविष्यव्दक्ता प्रगट नी होन को.” <verse eid="JHN 7:52" /><verse number="53" style="v" sid="JHN 7:53" />तब सब कोय अपना-अपना घर चली गया.<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s">व्यभिचारिणी खे माफी</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />पर यीशु जैतून कि टेकडी पर गयो. <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />अरु फजर खे फिर मन्‍दिर मे आयो, अरु सब इन्साहोन ओका पास आया. अरु उ बठीखे उनखे शिक्षन देन लग्यो. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />तब शास्त्री अरु फरीसी एक बय खे लैइ जो व्यभिचार मे पकडी गइ थी, अरु ओखे बीच मे खडी करीखे यीशु से बोल्यो, <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />“हे गुरु, या बय व्यभिचार करते पकडी गइ हइ. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />व्यवस्था मे मूसा ने हमखे आज्ञा दी हइ कि असी बयहोन खे पत्थराव करणु. अन्नत तू या बय का बारे मे का बोलस हइ?” <note caller="+" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="LEV 20:10">लैव्यव्यवस्था 20:10</ref></char></note> <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />उनने ओखे परखनन का लिये या बात बोली ताकि ओका पर इलजम लगान का लिये कोय बात पाये का पर यीशु झुकी खे उंगली से जमीन पर लिखन लग्यो. <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />जब वे ओकासे पुछता र्‍हिया, ते उ सीधो हुइ खे उनसे बोलीखे, “तुम मे जो नीष्पाप हुये उ पैयले ओखे पत्थर मारनु.”<note caller="+" style="x"><char style="xo" closed="false">8:7 </char><char style="xt" closed="false"><ref loc="ROM 2:1">रोमीयो 2:1</ref></char></note> <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />अरु फिर झुकी खे जमीन पर उंगली से लिखन लग्यो. <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />पर वे यो सुनी खे बापदादा से लीखे छोटा तक एक-एक करीखे नीकली गया, अरु यीशु अयखेलो र्‍हि गयो, अरु बय व्हा बीच मे खडी ऱ्ही गइ. <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />यीशु ने सीधो हुइ खे ओकासे बोल्यो, “हे बय, वे खा गया? कोय ने तरा पर दण्ड की आज्ञा नी दी?”<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />ओने बोल्यो, “हे प्रभु, कोय ने नी”</para>
  <para style="p" vid="JHN 8:11">यीशु ने बोल्यो, “मी भी तरा पर दण्ड की आज्ञा नी देउ. जा अरु फिर पाप नी करणु.”<verse eid="JHN 8:11" /></para>
  <para style="s">यीशु जगत की ज्योति</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />तब यीशु ने फिर दुन्याहोन से बोल्यो, “जगत की ज्योति मी हइ. जो मरा पीछे अह्ये खे उ अंधारा मे नी चल्ये का पर जिवन की ज्योति पाये.”<note caller="+" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="JHN 12:46">यहून्ना 12:46</ref></char></note><verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />फरीसीहोन ने ओकासे बोल्यो “तू अपनी गवइ खुद देउस हइ. तरी गवइ सच्ची नी.”<verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />यीशु ने उनखे जवाब दियो, “अगर मी अपनी गवइ खुद देउस हइ, ते भी मरी गवइ सच्ची हइ, क्युकी मी जानुस हइ, कि मी खा से आयो हइ अरु खा खे जाउस हइ? पर तुम नी जाने कि मी खा से आयो हइ या खा खे जउस हइ. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />तुम आंग का जसो न्याय करस हइ. मी कोय को न्याय नी करु. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />अरु अगर मी न्याय कर्हु भी, ते मरो न्याय सच्ची हइ. क्युकी मी अयखेलो नी, पर मी बाप का साथ हइ, जो ने मेखे भेज्यो हइ. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />अरु तुमारी व्यवस्था मे भी लिख्यो हइ. कि दो जनहोन की गवइ मीलीखे सच्ची होस हइ. <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />एक तो मी खुद अपनी गवइ देउस हइ, अरु दूसरो बाप मरी गवइ देउस हइ जो ने मेखे भेज्यो.”<verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />उनने ओकासे बोल्यो,</para>
  <para style="p" vid="JHN 8:19">“तरो बाप खा हइ?” यीशु ने जवाब दियो, “नी तुम मेखे जानस हइ, नी मरा बाप खे अगर मेखे जानस, ते मरो बाप खे भी जानता.”<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />ये बातहोन ओने मन्‍दिर मे उपदेस देता हुये दान घर मे बोली, अरु कोय ने ओखे नी पकड्यो. क्युकी ओको टेम अब तक नी आयो थो.<verse eid="JHN 8:20" /></para>
  <para style="s">अपना बारे मे यीशु को कथन</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />ओने फिर उनसे बोल्यो, “मी जउस हइ, अरु तुम मेखे ढूढ्ये अरु अपना पाप मे मर्ये. झा मी जउस हइ, व्हा तुम नी अय सक्ये.”<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />येका पर यहूदीयाहोन ने बोल्यो का उ अपना आप खे मारी डाल्येका जो बोलस हइ, “झा मी जउस हइ</para>
  <para style="b" vid="JHN 8:22">व्हा तुम नी अय सक्ये?”<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />ओने उनसे बोल्यो, “तुम नीचे का हइ, मी उपर को हइ. तुम जगत का हइ, मी जगत को नी. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />येका लिए मेने तुम से बोल्यो, कि तुम अपना पापहोन मे मर्ये. क्युकी अगर तुम विश्वास नी कर्ये कि मी उ हइ, ते अपना पापहोन मे मर्ये.”<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />उनने ओकासे बोल्यो, “तू कोन हइ?”</para>
  <para style="p" vid="JHN 8:25">यीशु ने उनसे बोल्यो, “उ हइ जो सुरुवात से तुम से बोलतो आयो हइ. <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />तुमारा बारे मे मेखे भोत कुछ बोलनो अरु नीर्णय करणो हइ पर मरो भेजनआलो सच्ची हइ. अरु जो मेने ओकासे सुन्यो हइ, उ जगत से बोलस हइ”<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />वे नी समझे कि हम बाप का बारे मे बोलस हइ. <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />तब यीशु ने बोल्यो, “जब तुम इन्सान का बेटा खे उच्चा पर चढाये का ते जान्ये कि मी उ हइ, अरु अपना आप से कुछ नी कर्येका पर जसो मरो बाप ने मेखे सिखायो, असो ही या बातहोन बोलुस हइ. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />अरु मरो भेजनआलो मरा साथ हइ. ओने मेखे एखलो नी छोड्यो. क्युकी मी हमेशा उ काम करुस हइ, जेका से उ प्रसन्‍न होस हइ.”<verse eid="JHN 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30" />उ या बातहोन बोली र्‍हो थो, कि भोतजन ने ओका पर विश्वास कर्यो.<verse eid="JHN 8:30" /></para>
  <para style="s">सच्चाइ तुमखे स्वतत्रता कर्ये</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />तब यीशु ने वे यहूदीयाहोन से जिन्हे ओका पर विश्वास कर्यो थो, बोल्यो, “अगर तुम मरा वचन मे बन्या र्‍हियेका ते सच मुच मरा सेवक ठैइऱ्यो. <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />अरु सच्चाइ खे जान्येका अरु सच्चाइ तुमखे स्वतत्रता कर्ये.”<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />उनने ओखे जवाब दियो, “हम तो अब्राहम का वंश से हइ, अरु कभी कोय, सेवक नी हुया. फिर तू क्यु बोलस हइ, कि तुम स्वतंत्र हुये जाये?”<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />यीशु ने उनखे जवाब दियो, “मी तुम से सच्ची-सच्ची‍ची बोलुस हइ कि जो कोय पाप करस हइ, उ पाप को सेवक हइ. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />अरु सेवक कभी भी घर मे नी र्‍हे. बाप हमेशा र्हेस हइ. <note caller="+" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="GAL 4:30">गलतिया 4:30</ref> </char></note> <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />येका लिए अगर बाप बेटा खे स्वतत्रता कर्हे ते सच्ची मे तुम स्वतत्रता हुइ जाये. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />मी जानुस हइ कि तुम अब्राहम का वंश से हइ. तो भी मरो वचन तुमारा मन मे जगा नी पाय, येका लिए तुम मेखे मारी डालनो चाहस हइ. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />मी उ बोलुस हइ, जो अपना बाप खे ह्या देखस हइ. अरु तुम उ करता र्‍हेस हइ जो तुम ने अपना बाप से सुन्यो हइ.”<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />उनने ओखे जवाब दियो,</para>
  <para style="p" vid="JHN 8:39">“हमारो बाप तो अब्राहम हइ.” यीशु ने उनसे बोल्यो,</para>
  <para style="p" vid="JHN 8:39">“अगर तुम अब्राहम का सन्तान होस, ते अब्राहम का जसो काम करता. <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />पर अब तुम मेखे जसो इन्सान खे मारी डालनो चाहस हइ, जो ने तुमखे उ सच्ची वचन बतायो जो परमेश्वर से सुन्यो, यो ते अब्राहम ने नी कर्यो थो. <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />तुम अपना बाप का जसा काम करस हइ”</para>
  <para style="p" vid="JHN 8:41">उनने ओकासे बोल्यो, “हम व्यभिचार से नी जन्मो, हमारो एक बाप हइ यानेकी परमेश्वर.”<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />यीशु ने उनसे बोल्यो, “अगर परमेश्वर तुमारो बाप होतो, ते तुम मरासे प्रेम रखता. क्युकी मी परमेश्वर मे से नीकलीखे आयो हइ. मी खुद से नी आयो, पर ओ ने मेखे भेज्यो. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />तुम मरी बात क्यु नी समझे? येका लिए कि मरो वचन सुनी नी सक्ये. <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />तुम अपना बाप सैतान से हइ, अरु अपना बाप की लालसाहोन खे पूरो करणो चाहस हइ उ ते सुरुवात से खुनी हइ, अरु सच्चीचाइ पर स्थिर नी र्हे, क्युकी सच्ची ओमे हइ ही नी. जब उ झूठ बोलस, ते अपना स्वभाव मे से बोलस हइ. क्युकी उ झूठो हइ, क्युकी झूठ को बाप हइ. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />पर मी जो सच्ची बोलस हइ, येका लिए तुम मरो विश्वास नी कर्ये. <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />तुम मे से कोन मेखे पापी ठैइरास हइ? अरु अगर मी सच्ची बोलुस हइ, ते तुम मरो विश्वास क्यु नी कर्ये? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />जो परमेश्वर से होस हइ, उ परमेश्वर की बातहोन सुनस हइ. अरु तुम येका लिए नी सुनस कि परमेश्वर की तरफ से नी हइ.”<verse eid="JHN 8:47" /></para>
  <para style="s">यीशु को अपना बारे मे दावो करणु</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />यो सुन्यो यहूदीयाहोन ने ओकासे बोल्यो “हम ठीक नी बोले, कि तू सामरी हइ, अरु तुम मे बुरीआत्मा हइ?”<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />“यीशु ने जवाब दियो,” मरा मे बुरीआत्मा नी. पर मी अपना बाप को आदर करुस हइ, अरु तुम मरो नीरादर करुस हइ. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />पर मी अपनी महिमा नी चाहु का हव, एक हइ जो चाहस हइ, अरु न्याय करस हइ.<verse eid="JHN 8:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 8:51" />मी तुम से सच्ची-सच्ची बोलुस हइ कि अगर कोय इन्सान मरा वचन पर चले का ते उ पिडमपिडि तक मरना खे नी देख्ये.<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />यहूदीयाहोन ने ओकासे बोल्यो, “अब हमने जानी लियो कि तरा मे बुरीआत्मा हइ अब्राहम मरी गयो, अरु भविष्यव्दक्ता भी मरी गए हइ अरु तू बोलस हइ, ‘अगर कोय मरो वचन पर चल्ये ते उ पिडमपिडि तक मरना को सवाद नी चख्ये.’ <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />हमारो बाप अब्राहम ते मरी गयो, तू ओकासे बडो हइ? अरु भविष्यव्दक्ता भी मरी गया, तू अपना आप खे ठैइरास हइ?”<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />यीशु ने जवाब दियो, “अगर मी खुद अपनी महिमा करु, ते मरी महीमा कुछ नी, पर मरी महिमा करण आलो मरो बाप हइ, जेखे तुम बोलस हइ, कि उ हमारो परमेश्वर हइ. <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />अरु तुम ने तो ओखे नी जान्यो पर मी ओखे जानुस हइ. अरु अगर बोलु कि मी ओखे नी जानू, ते मी तुमारो जसो झूठा ठैइरायु पर मी जानुस, अरु ओका वचन पर चलुस हइ. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />तुमारो बाप अब्राहम मरा दिन देखन की आस से भोत मगन थो. अरु ओने देख्यो, अरु खुशी करी.”<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />यहूदीयाहोन ने ओकासे बोल्यो, “अब तक तू पचास साल को नी, फिर भी तोने अब्राहम खे देख्यो हइ?”<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />यीशु ने उनसे बोल्यो, “ मी तुम से सच्ची-सच्ची बोलुस हइ, कि पैयले येका कि अब्राहम पइदा हुयो मी हइ.”<verse eid="JHN 8:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59" />तब उनने ओखे मारन का लिये पत्थर उठायो, पर यीशु लुकीखे मन्‍दिर से नीकली गयो.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">पइदा से अंधा सखे नजरदासन</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />फिर जाता हुया ओने एक इन्सान खे देख्यो, जो जन्म से अंधो थो. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />अरु ओका सेवक होन ने ओकासे पूछ्यो, “हे गुरु, कोय ने पाप कर्यो थो कि यो अंधो जन्म्यो यो इन्सान ने या ओकी माय बाप ने?”<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />यीशु ने जवाब दियो, “नी ते येने पाप कर्यो थो, नी येका माय बाप ने पर यो येका लिए हुयो, कि परमेश्वर का काम ओमे प्रगट हुये. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />जो ने मेखे भेज्यो हइ. हमखे ओका मे दिन हीस दिन मे करणो जरुरती हइ वा रात आनआली हइ जोमे कोय काम नी करी सकतो. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />जब तक मी जगत मे हइ, तब तक जगत को उजालो हइ.”<note caller="+" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="JHN 8:12">यहून्ना 8:12</ref></char></note><verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />यो बोलीखे ओने जमीन पर थूक्यो अरु उ थूक से मट्टी छासनी, अरु वा मट्टी उ अंधा का आखहोन पर लगैइखे. <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />ओकासे बोल्यो, “जा, शीलोह का कुण्ड मे धोइ ले” शीलोह को अर्थ भेज्यो हुयो हइ अन्नत ओने जैइखे ले, अरु देखता हुया लौटी आयो.<note caller="+" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="ISA 35:5">यशया 35:5</ref></char></note><verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />तब पडोसी अरु जिन्हे पैयले ओखे भीख मागते देख्यो थो, बोलन लग्या “यो उ नी जो बठ्यो भीख माग्या करतो थो?”<verse eid="JHN 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9" />कुछ दुन्या ने बोल्यो, “यो उ हइ,” दुसरा जन ने बोल्यो नी,</para>
  <para style="p" vid="JHN 9:9">पर ओका जसो हइ ओने बोल्यो, “मी उ हइ.”<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />“तब वे ओकासे पूछन लग्या?” तरी आखहोन कसी खुली गइ.<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />ओने जवाब दियो, “यीशु नामको एक इन्सान ने मट्टी छानी, अरु मरा आखहोन पर लगैइखे मरासे बोल्यो, शीलोह मे जैइखे धोइ ले, ते मी गयो, अरु धोइ खे देखन लग्यो.”<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />उनने ओकासे पूछ्यो, “उ खा हइ?”</para>
  <para style="p" vid="JHN 9:12">ओने बोल्यो, “मी नी जानु.”<verse eid="JHN 9:12" /></para>
  <para style="s">फरीसीहोन द्वारा चगाइ की जाच-पडताल</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />इन्सान जो पैयले अंधो थो फरीसीहोन का पास ली गयो. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />जो दिन यीशु ने मट्टी छानी खे ओकी आखहोन खोली थी उ अराम को दिन थो. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />फिर फरीसीहोन ने भी ओकासे पूछ्यो. तरी आखहोन कोनता रीति से खुली गइ? ओने उनसे बोल्यो, “ओने मरी आखहोन पर मट्टी लगइ, फिर मेने धोइ लियो, अरु अब देखुस हइ.”<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />येका पर कइ फरीसी बोलन लग्या, “यो इन्सान परमेश्वर का तरफ से नी, क्युकी उ अराम का दिन नी मानतो” दुसरा झन ने बोल्यो,</para>
  <para style="p" vid="JHN 9:16">“पापी इन्सान कसो असो चिन्ह दिखैइ सकस हइ?” अन्नत उनमे फूट पिडी.<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />उनने उ अंधा से फिर बोल्यो, “ओने जो तरी आखहोन खोली, तू ओका बारे मे का बोलस हइ?” ओने बोल्यो,</para>
  <para style="p" vid="JHN 9:17">“यो भविष्यव्दक्ता हइ.”<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />पर यहूदीयाहोन खे विश्वास नी हुयो कि यो अंधो थो अरु अब देखस हइ जब तक उनने ओका माय बाप खे जोकी आखहोन खुली गइ थी, बुलैइ खे. <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />उनसे पूछ्यो “का यो तुमारो बेटो हइ, जेखे तुम बोलस हइ कि अंधो जन्म्यो थो? फिर अब कसो देखस हइ?”<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />ओका माय-बाप ने जवाब दियो, “हम तो जानस हइ कि यो हमारो बेटो हइ, अरु अंधो जन्म्यो थो. <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />पर हम यो नी जानस हइ कि अब कसो देखस हइ. अरु नी यो जानस हइ, कि कोय ने ओका आखहोन खोली. उ सयानो हइ. ओका से पुछी ले. उ अपना बारे मे बोली दिये.” <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />या बातहोन ओका माय-बाप ने येका लिए बोली क्युकी वे यहूदीयाहोन से डरता था. क्युकी यहूदीया एकमत हुइ चुक्या था, कि अगर कोय बोल्ये कि उ मसीह हइ, ते आराधनालय से नीकाली जाये. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />यो कारण ओका माय बाप ने बोल्यो, “उ सयानो हइ. ओका से पूछी ले.”<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />तब उनने उ इन्सान खे जो अंधो थो दूसरी बार बुलैइ खे ओकासे बोल्यो, “परमेश्वर की महिमा कर. हम तो जानस हइ कि उ इन्सान पापी हइ.” <verse eid="JHN 9:24" /><verse number="25" style="v" sid="JHN 9:25" />ओने जवाब दियो, “मी नी जानु कि उ पापी हइ या नी मी एक बात जानूस हइ कि मी अंधो थो अरु अब देखुस हइ.”<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />उनने ओकासे फिर बोल्यो, “ओने तरा साथ का कर्यो? अरु कोनता तरीका से तरी आखहोन खोली?” <verse eid="JHN 9:26" /><verse number="27" style="v" sid="JHN 9:27" />ओने उनसे बोल्यो, “मी तो तुम से बोली चुक्यो, अरु तुम ने नी सुन्यो. अब दूसरी बार क्यु सुननो चाहस हइ? का तुम भी ओका सेवक होनु चाहस हइ?”<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />तब वे ओखे बुरो-भलो बोलीखे बोल्या, “तू ही ओको चेलो हइ. हम तो मूसा का सेवक हइ. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />हम जानस हइ कि परमेश्वर ने मूसा से बातहोन बोली. पर यो इन्सान खे नी जाने की खा को हइ.”<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />ओने उन खे जवाब दियो, “यो तो अचम की बात हइ कि तुम नी जाने की खा को हइ तेभी ओने मरी आखहोन खोली दी. <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />हम जानस हइ कि परमेश्वर पापीहोन की नी सुने पर अगर कोय परमेश्वर को भक्त हइ, अरु ओकी इच्छा पर चलस हइ, ते उ ओकी सुनस हइ. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />जगत कि सुरुवात से यो कभी सुनना मे नी आयो, कि कोय ने भी जन्म का अंधा की आखहोन खोली हो. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />अगर यो इन्सान परमेश्वर का तरफ से नी होतो, ते कुछ भी नी करी सकतो.”<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />उनने ओखे जवाब दियो, “तू तो बिलकुल पापहोन मे जन्म्यो हइ, तू हम खे का सिखास हइ?” अरु उनने ओखे भइर नीकाली दियो.<verse eid="JHN 9:34" /></para>
  <para style="s">आत्मीक अंधो पन</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />यीशु ने सुन्यो, कि उनने ओखे बाहेर नीकाली दियो हइ. अरु जब ओकासे मील्यो हुइ ते बोल्यो “तू परमेश्वर का बेटा पर विश्वास करस हइ?”<verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />ओने जवाब दियो, “हे प्रभु, उ कोन हइ कि मी ओका पर विश्वास करु?”<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />यीशु ने ओकासे बोल्यो, “तोने ओखे देख्यो भी हइ. अरु जो तरा साथ बातहोन करी र्‍हो हइ उ हइ.”<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />ओने बोल्यो, “हे प्रभु, मी विश्वास करुस हइ” अरु ओखे प्रणाम कर्यो.<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />तब यीशु ने बोल्यो, “मी यो जगत मे न्याय का लिये आयो हइ, ताकि जो नी देखे वे देख्ये का अरु जो देखस हइ वे अंधा हुइ जाये.”<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />जो फरीसी ओका साथ था, उनने या बातहोन सुनी खे ओकासे बोल्यो, “हम भी अंधा हइ?”<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />यीशु ने उनसे बोल्यो, “अगर तुम अंधा होस ते पापी नी ठैरता पर अब बोलुस हइ, कि हम देखस हइ, येका लिए तुमारा पाप बन्यो र्‍हेस हइ.<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">चरानआला अरु मेडा को दृष्टान्त</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />“मी तुम से सच्ची सच्ची बोलुस हइ, कि जो कोइ दरवाजा से मेडा कि खोली मे अंदर नी कर्ये का पर अरु कोय दुसरा से चडी जास हइ का उ चोर अरु डाकू हइ. <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />पर जो दरवाजा से अंदर प्रवेश करस हइ उ व्हा मेढाहोन को चरवाहा हइ. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />येका लिये द्वारपाल दरवाजो खोली देस हइ, अरु मेढाहोन ओकी आवाज शब्द सुनस हइ, अरु उ अपना मेढाहोन का नाम ली लीखे बुलास हइ बाहेर ली जास हइ. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />अरु जब उ अपनी सब मेढाहोन खे बाहेर नीकाली चुक्यो हइ, ते उनका आगे आगे चलस हइ, अरु मेढाहोन ओका पीछे-पीछे चली जास हइ. क्युकी वे ओकी आवाज पहचानस हइ. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />पर वे दुसरा का पीछे नी जायेका पर ओकासे भाग्येका क्युकी वे दुसरा को आवाज नी पहचाने.”<verse eid="JHN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6" />यीशु ने उनसे यो दृष्टान्त बोल्यो, पर वे नी समझे कि या बातहोन हइ जो वह हम से बोलस हइ.<verse eid="JHN 10:6" /></para>
  <para style="s">यीशु अच्छो चरानआलो</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />तब यीशु ने उनसे फिर बोल्यो, “मी तुम से सच्ची-सच्ची बोलुस हइ, कि मेढाहोन को दरवाजा मी हइ. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />जोत्ता मरासे पैयले आया. वे सब चोर अरु डाकू हइ, पर मेढाहोन ने उनकी नी सुनी. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />दरवाजो मी हइ. अगर कोय मरा वजेसे अंदर प्रवेश कर्ये ते उध्दारपाये अरु अंदर बाहर आह्ये-जाये कर्ये अरु चारो पाये. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />चोर कोइ अरु काम का लिये नी पर फक्त चोरी करण अरु मारन खे अरु खेत्म खे आस हइ, मी येका लिए आयो कि वे जिवन पायेका अरु भोतायत से पाये. <figure style="fig" alt="Shepherd with his sheep in sheepfold" file="LB00014C.TIF" size="span" copy="Horace Knowles ©" ref="10:7">मेडा को कोठा मे अपना मेडा का साथ</figure><verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />“अच्छो चरानआलो मी आय. अच्छो चरानआलो मेडा का लिये अपनो जान देस हइ. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />मजूर जो नी चरानआलो हइ, अरु नी मेढाहोन को मालिक हइ, लाडगाहोन खे आते हुया देख्यो, मेढाहोन खे छोडी खे भागी जास हइ, अरु लाडगाहोन उनखे पकडस अरु इधर-उधर करी देस हइ. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />उ येका लिए भागी जास हइ कि उ मजूर हइ, अरु ओखे मेडाहोन की चिन्ता नी <verse eid="JHN 10:13" /><verse number="14" style="v" sid="JHN 10:14" />अच्छो चरानआलो मी आय. मी अपनी मेडाहोन खे जानुस हइ, अरु मरा मेडाहोन मेखे जानस हइ. <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />जसो बाप मेखे जानस हइ, अरु मी बाप खे जानुस हइ, अरु मी मेडाहोन, लिये अपनो जान देउस हइ. <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />मरा अरु भी मेडा हइ, जो यो मेडा खोली की नी. मेखे उन खे भी लानो जरुरती हइ, वे मरो आवाज सुन्ये. तब एक मे झुण्ड अरु एक मे चरानआलो हुये.<verse eid="JHN 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17" />“बाप येका लिए मरासे प्रेम रखस हइ, कि मी अपनो जान देउस हइ, कि ओखे फिर ली लियु. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />कोय ओखे मरासे छीने नी, क्युकी मी ओखे खुद मे देउस हइ, मेखे ओखे देन को अधिकार हइ, अरु ओखे फिर लेन को भी अधिकार हइ, या आज्ञा मरो बाप से मेखे मीली हइ.”<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />या बातहोन का कारण यहूदीयाहोन मे फिर फूट पडी. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />उनमे से भोत जन बोलन लग्या, “ओमे बुरीआत्मा हइ, अरु उ पागल हइ. ओकी क्यु सुनस हइ?”<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />दुसरा ने बोल्यो, “या बातहोन असो इन्सान की नी जोमे बुरीआत्मा हइ, बुरीआत्मा अंधा की आख खोली सकस हइ?”<verse eid="JHN 10:21" /></para>
  <para style="s">यहूदीयाहोन को अविश्वास</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />यरुशलेम मे समर्पन त्योहार हुयो, अरु ठड को दिन थो. <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />अरु यीशु मन्‍दिर मे सुलेसमान कि ओसरी मे घुमीरो थो. <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />तब यहूदीयाहोन ने ओखे अय घेर्यो अरु पूछ्यो, “तू हमारा मन खे कब तक तखलीप मे रख्ये? अगर तू मसीह हइ, ते हम से सपा बोली दे.”<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />यीशु ने उनखे जवाब दियो, “मेने तुम से बोली दियो, अरु तुम विश्वास कर्‍हे ही नी, जो काम मी अपना बाप का नाम से करुस हइ वे य मरा गवा हइ. <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />पर तुम येका लिए विश्वास नी कर्‍हे, कि मरा मेडाहोन मे से नी हइ. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />मरा मेडाहोन मरो आवाज सुनस हइ, अरु मी उनखे जानुस हइ, अरु वे मरा पीछे पीछे चलस हइ. <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />अरु मी उनखे अनन्त जिवन देउस हइ, अरु वे कभी नाश नी हुये कि अरु कोय उनखे मरा हात से छीनी नी लिये. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />मरो बाप, जो ने उनखे मेखे दियो हइ, सबसे बडो हइ, अरु कोय उनखे बाप का हात से छीनी नी सक्ये. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />मी अरु बाप एक हइ.”<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />यहूदीयाहोन ने ओखे पत्थराव करण खे फिर पत्थर उठाया. <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />येका पर यीशु ने उनसे बोल्यो, “मेने तुमखे अपना बाप का तरफ से भोत सा भला काम दिखाया हइ, उनमे से कोनता काम का लिये तुम मेखे पत्थराव करस हइ?”<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />यहूदीयाहोन ने ओखे उत्तर दियो, “अच्छो काम का लिये हम तोखे पथर नी मारा, पन परमेश्वर की नीन्दा का कारण अरु येका लिये कि तू इन्सान हुयखे अपना आप खे परमेश्वर बनास हइ.” <note caller="+" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="LEV 24:16">लैव्यव्यवस्था 24:16</ref></char></note><verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />यीशु ने उनखे जवाब दियो “तुम्हारी व्यवस्था मे नी लिख्यो हइ कि ‘मेने बोल्यो, तु प्रभु हइ?’<note caller="+" style="x"><char style="xo" closed="false">10:34 </char><char style="xt" closed="false"><ref loc="PSA 82:6">भजन संहिता 82:6</ref></char></note> <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />अगर ओने उनखे प्रभु बोल्यो जिन का पास परमेश्वर को वचन पहुच्यो अरु पवित्रशास्त्र की बात लुकी नी हुइ सक्ये. <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />ते जेखे बाप ने पवित्र ठैइरी खे जगत मे भेज्यो हइ, तुम ओकासे बोलस हइ, तू नीन्दा करस हइ येका लिए कि मेने बोल्यो, मी परमेश्वर को बेटो हइ? <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />अगर मी अपना बाप को काम नी करु, ते मरो विश्वास नी करणु. <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />पर अगर मी करुस हइ, ते चाह्ये मरो विश्वास नी भी करणु, पर वे काम होन पर विश्वास करणु, ताकि तुम जान्येका अरु समझे, कि बाप मरा मे हइ, अरु मी बाप मे हइ.”<verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />तब उनने फिर ओखे पकडन कि कोशीस कर्यो पर उ उनका हात से नीकली गयो<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />फिर उ यरदन नद्दी का पार वा जगा पर चली गयो, झा यहून्ना पैयले बपतिस्मा दिया करतो थो, अरु वही र्‍हियो. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />अरु भोत सारा ओका पास अयखे बोलता था, “यहून्ना ने ते कोय चिन्ह नी दिखायो, पर जो कुछ यहून्ना ने येका बारे मे बोल्यो थो उ सब सच्ची थो.” <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />अरु उ भोतजन ने ओका पर विश्वास कर्यो.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">लाजर खे मारनो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />मरियम अरु उसकी भैइन मार्था को गाव बैतनीय्याह को लाजर नाम एक इन्सान बीमार थो. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />या उ मरियम थी जेने प्रभु पर अत्रर डालीखे ओका पायहोन खे अपना बालहोन से पोछ्यो थो, ओ को भैइ लाजर बीमार थो. <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />तब ओकी भैइनहोन ने ओखे बुलाओ भेज्यो, “हे प्रभु, देख, जोका से तू प्रेम करस हइ, उ बीमार हइ.”<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />यो सुनीखे यीशु ने बोल्यो, “या बीमारी मरन की नी, पर परमेश्वर की महिमा का लिये हइ, कि ओका वजेसे परमेश्वर का बेटा की महिमा हुये.”<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />अरु यीशु, मार्था अरु ओकी भैइन अरु लाजर से प्रेम रखतो थो. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />जब ओने सुन्यो, कि उ बीमार हइ, ते जो जगा पर उ थो, व्हा दो दिन अरु ठैरी गयो. <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />फिर ओका बाद ओने सेवक होन से बोल्यो, “ओका हम फिर यहूदीया खे चल्हे.”<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />सेवक होन ने ओकासे बोल्यो, “हे गुरु, अभी तो यहूदीया तोखे पत्थराव करणो चाहतो थो, अरु तू फिर भी वही जास हइ?”<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />यीशु ने जवाब दियो “ का दिन बारा घंटा नी होय? अगर कोय दिन मे चल्यो, ते ठोकर नी खाता, क्युकी यो जगत को उजालो देखस हइ. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />पर अगर कोय रात खे चल्ये का ते ठोकर खास हइ, क्युकी ओमे उजालो नी.” <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />ओने या बातहोन बोली, अरु येका बाद उनसे बोलन लग्यो, “हमारो दोस्त लाजर सोइ गयो हइ, पर मी ओखे जगान जउस हइ.”<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />तब सेवक होन ने ओकासे बोल्यो, “हे प्रभु, अगर उ सोइ गयो हइ, ते बची जाये.”<verse eid="JHN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13" />यीशु ने तो ओका मरना का बारे मे बोल्यो थो पर वे समझ्या कि ओने नीद से सोइ जाना का बारे मे बोल्यो. <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />तब यीशु ने उनसे साफ बोली दियो, “लाजर मरी गयो हइ. <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />अरु मी तुमारा कारण खुश हइ कि मी व्हा नी थो जोका से तुम विश्वास करणु. पन अब आ हम ओका पास चले.”<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />तब थोमा ने जो दिदिमुस बोलस हइ, अपना साथ का सेवक होन से बोल्यो, “ओका हम भी ओका साथ मरन खे चल्यो.”<verse eid="JHN 11:16" /></para>
  <para style="s">यीशु पुनरुत्थान अरु जिवन</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />फिर यीशु खे अयखे यो मालूम हुयो कि ओखे कब्र मे रख्या चार दिन हुइ चुक्या हइ. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />बैतनीय्याह यरुशलेम का सामने कोय दो मील की दूरी पर थो. <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />अरु भोत सा यहूदीया मार्था अरु मरियम का पास उनका भैइ का बारे मे शांती देन का लिये आया था.<verse eid="JHN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20" />जब मार्था यीशु को आन को समाचार सुनैखे ओकासे मीलन खे गइ, पर मरियम घर मे बठी र्‍हि. <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />मार्था ने यीशु से बोल्यो, “हे प्रभु, अगर तू ह्या होतो, ते मरो भैइ कभी नी मरतो. <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />अरु अब भी मी जानुस हइ, कि जो कुछ तू परमेश्वर से माग्ये परमेश्वर तोखे दिये.”<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />यीशु ने ओकासे बोल्यो, “तरो भैइ जी उठ्यो.”<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />मार्था ने ओकासे बोल्यो, “मी जानूस हइ, अन्नत दिन मे पुनरुत्थान का टेम उ जी उठ्ये.”<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />यीशु ने ओकासे बोल्यो, “पुनरुत्थान अरु जिवन मी आय, जो कोय मरा पर विश्वास करस हइ उ अगर मरी भी जाये ते भी जीये. <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />अरु जो कोइ जिन्दो हइ, अरु मरा पर विश्वास करस हइ, उ पिडमपिडि तक नी मर्येका तू या बात पर विश्वास करस हइ?”<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />ओने ओकासे बोल्यो, “हव, हे प्रभु, मी विश्वास करी चुकी हइ, कि परमेश्वर को बेटो मसीह जो जगत मे आनआलो थो, उ तू हीस हइ.”<verse eid="JHN 11:27" /></para>
  <para style="s">लाजर खे जिन्दो जानो</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />यो बोलीखे वा चली गइ, अरु अपनी भैइन मरियम खे चुपचाप से बुलैखे बोल्यो, “गुरु ह्यही हइ, अरु तोखे बुलास हइ.” <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />यो सुनते ही जल्दी उठीखे ओका पास अय. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />यीशु अभी गाव मे नी पहुच्यो थो, पर उ जगा मे थो झा मार्था ने ओकासे दान करी थी. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />तब जो यहूदीया ओका साथ घर मे था, अरु ओखे शांती दि र्‍हा था, यो देखीखे कि मरियम जल्दी उठीखे बाहेर गइ हइ अरु यो समझी खे कि उ कब्र पर रोन खे जास हइ, ओका पीछे गइ.<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />जब मरियम व्हा पहुची झा यीशु थो, ते ओखे देखता ही ओका पायहोन पर गिरीखे बोल्यो, “हे प्रभु, अगर तू ह्या होतो ते मरो भैइ नी मरतो.”<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />जब यीशु ने ओखे अरु वे यहूदीयाहोन खे जो ओका साथ आया था रोते हुया देख्यो, ते आत्मा मे भोत मे उदास अरु व्याकुल हुयो, <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />अरु बोल्यो, “तुम ने ओखे खाहा रख्यो हइ?” उनने ओकासे बोल्यो,</para>
  <para style="p" vid="JHN 11:34">“हे प्रभु, चलीखे देखी ले.”<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />यीशु रोयो <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />तब यहूदीया बोलन लग्या, “देखनु, उ ओकासे कसो प्रेम करतो थो.”<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />पर उनमे से केत्ता ने बोल्यो “का यो जेने अंधा की आखहोन खोली, यो भी नी करी सक्यो कि यो इन्सान नी मरतो?”<verse eid="JHN 11:37" /></para>
  <para style="s">लाजर खे जीवन दान</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />यीशु मन मे फिर भोत मे उदास हुइखे कब्र पर आयो, वा एक गुफा थी, अरु एक पत्थर ओका पर रख्यो थो. <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />यीशु ने बोल्यो, “पत्थर खे उठाव” उ मर्यो हुया की भैइन मार्था ओकासे बोलन लगी, “हे प्रभु, अब तो ओमे से बास आस हइ, क्युकी ओखे मर्या चार दिन हुइ गया.”<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />यीशु ने ओकासे बोल्यो “का मेने तरा से नी बोल्यो थो कि अगर तू विश्वास कर्येका ते परमेश्वर की महिमा खे देख्ये.” <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />तब उनने उ पत्थर खे हटायो, फिर यीशु ने आखहोन उठैइखे बोल्यो, “हे बाप, मी तरो धन्यवाद करुस हइ कि तोने मरी सुनी ली हइ. <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />अरु मी जानतो थो, कि तू हमेशा मेरी सुनस हइ, पर जो गर्दी आस-पास खड़ी हइ, उनका कारण मेने यो बोल्यो, जोका से कि वे विश्वास कर्येका कि तोने मेखे भेज्यो हइ.” <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />यो बोलीखे ओने बडा आवाज से पु,कार्यो, “हे लाजर, नीकलीखे आ!” <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />जो मरी गयो थो, उ कफन से हात पाय बध्या हुयो नीकलीखे आयो अरु ओको मेडो कपडो से लिपट्यो हुयो थो यीशु ने उनसे बोल्यो, “ओखे खोलीखे अरु जान दे”<verse eid="JHN 11:44" /></para>
  <para style="s">यीशु का खिलाफ साजिस</para>
  <para style="r">(<ref loc="MAT 26:1-5">मत्ती 26:1-5</ref>; <ref loc="MRK 14:1">मरकुस 14:1</ref>; <ref loc="MRK 2">2</ref>; <ref loc="LUK 2:1">लूका 2:1</ref>; <ref loc="LUK 2">2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />तब जो यहूदीया मरियम का पास आया था अरु ओको यो काम देख्यो थो, उनमे से भोत जन ने ओका पर विश्वास कर्यो. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />पर उनमे से खे त्ता ने फरीसीहोन का पास जैइखे यीशु का काम होन को समाचार दियो. <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />येका पर प्रधान याजकहोन अरु फरीसीहोन ने मुख्य सभा का दुन्याहोन खे जमा करीखे बोल्यो, “हम कारस का हइ? यो इन्सान तो भोत चिन्ह बतास हइ. <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />अगर हम ओखे असो मे छोडी दिये, ते सब ओका पर विश्वास ली आह्ये अरु रोमी अयखे हमारी जगा अरु राष्ट्रहोन दोइ पर अधिकार करी लिये.”<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />तब उनमे से कैफा नाम एक इन्सान ने जो उ साल को महायाजक थो, उनसे बोल्यो, “तुम कुछ नी जाने. <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />अरु नी यो सोचस हइ, कि तुमारा लिये यो अच्छो हइ, कि दुन्या का लिये एक इन्सान मर्ये, अरु नी यो कि पुरो जातहोन नाश हुये.” <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />या बात ओने अपना तरफ से नी बोली, पर उ साल को महायाजक हुइखे भविष्यवाणी करीखे कि यीशु वे राष्ट्रहोन का लिये मर्ये. <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />अरु नी फक्त वे राष्ट्रहोन का लिये क्युकी येका लिए भी, कि परमेश्वर की तितर-बितर सन्तानहोन खे एक करी दिये.<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />अन्नत उ दिन से वे ओखे मारी डालन की सम्मति करण लग्या. <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />येका लिए यीशु वा टेम से यहूदीयाहोन मे प्रगट हुइखे नी फिर्यो. पर व्हा से जंगल का नजीक पास परदेस को एप्रैम नाम का एक नगर खे चली गयो. अरु अपना सेवक होन का साथ वही र्‍हेन लग्यो.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />अरु यहूदीयाहोन को फसह को तीवार पास थो, अरु भोत सारा इन्सान फसह से पैयले दिहात से यरुशलेम खे गया कि अपना आप खे अच्छो करणु.<note caller="+" style="x"><char style="xo" closed="false">11:55 </char><char style="xt" closed="false"><ref loc="2CH 30:17">2 इतिहास 30:17</ref></char></note> <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />वे यीशु खे ढूढन अरु मन्‍दिर मे खडो हुइखे आपस मे बोलन लग्यो, “तुम का समझस हइ? का उ त्योहार मे नी आह्ये?” <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />अरु प्रधान याजकहोन अरु फरीसीहोन ने भी आज्ञा दि रखी थी, कि अगर कोय यो जाने कि यीशु खा हइ ते बतानु, कि ओखे पकडी ले.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">बैतनीय्याह मे यीशु को अभिषेक</para>
  <para style="r">(<ref loc="MAT 26:6-13">मत्ती 26:6-13</ref>; <ref loc="MRK 14:3-9">मरकुस 14:3-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />फिर यीशु फसह तिवार से छे दिन पैयले बैतनीय्याह मे आयो, झा लाजर थो. जेखे यीशु ने मर्या हुया मे से जिन्दो लायो थो. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />व्हा उनने ओका लिये खानो तैयार कर्यो, अरु मार्था सेवा करी र्‍हि थी, अरु लाजर उनमे से एक थो, जो ओका साथ खानो खान का लिये बठ्या था. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />तब मरियम ने जटामासी को आधो सेर बहुमूल्य अत्रर लीखे यीशु का पाय पर डाल्यो, अरु अपना बालहोन से ओका पाय पोछ्या, अरु अत्रर की सुगध से घर सुगन्धित हूइ गयो. <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />पर ओका सेवक होन मे से यहूदा इस्करियोती नाम एक चेलो जो ओखे पकडान पर थो, बोलन लग्यो, <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />“यो अत्रर तीन सौ सिक्का, मे बेचीखे गरीबहोन खे क्यु नी दिया गयो?” <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />ओने या बात येका लिए नी बोली, कि ओखे गरीबहोन की चिन्ता थी का पर येका लिए कि उ चोर थो अरु ओका पास उनकी थैली र्‍हेती थी, अरु ओमे जो कुछ डाल्या जातो थो काउ नीकाली लेतो थो. <figure style="fig" alt="Alabaster jars" file="HK00142C.TIF" size="col" copy="Horace Knowles ©" ref="12:3">संगमरमर को बर्तन</figure><verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />यीशु ने बोल्यो, “ओखे मरा गाड्या जान का दिन का लिये र्‍हेन दे. <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />क्युकी गरीब तो तुमारा साथ हमेशा र्‍हेस हइ, पर मी तुमारा साथ हमेशा नी र्‍हियु.”<verse eid="JHN 12:8" /></para>
  <para style="s">लाजर खे मारी डालन को नीर्णय</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />यहूदीयाहोन मे से साधारण दुन्या जानी गया, कि उ व्हा हइ, अरु वे नी फक्त यीशु का कारण आया पर येका लिए भी कि लाजर खे देख्ये का जेखे ओने मऱ्या हुया मे से जिन्दो थो. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />तब मुखियो याजकहोन ने लाजर खे भी मारी डालन की सम्मति करी. <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />क्युकी ओका कारण भोत सा यहूदीया चली गया, अरु यीशु पर विश्वास कर्यो.<verse eid="JHN 12:11" /></para>
  <para style="s">यीशु को यरुशलेम मे विजय-प्रवेश</para>
  <para style="r">(<ref loc="MAT 21:1-11">मत्ती 21:1-11</ref>; <ref loc="MRK 11:1-11">मरकुस 11:1-11</ref>; <ref loc="LUK 19:28-40">लूका 19:28-40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />दूसरा दिन भोत सा दुन्याहोन ने जो त्योहार मे आया था, यो सुनीखे, कि यीशु यरुशलेम मे अय र्हो हइ. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />उनने खारीक की डालिहोन ली, अरु ओकासे मीलन खे नीकल्या, अरु फुकारन लग्या, “होशन्ना! धन्य इस्राएल को राजो, जो प्रभु, नाम से आस हइ.”<verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />जब यीशु खे एक गधी को बच्चो मील्यो, ते उ ओका पर बठ्यो, जसो लिख्यो हइ,<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />“हे सिय्योन की बेटी,</para>
  <para style="q1" vid="JHN 12:15">मत डर.</para>
  <para style="q2" vid="JHN 12:15">देख, तरो राजो गधी का बच्चा पर चड्यो हुयो चल्यो आस हइ.”<verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />ओका सेवक या बातहोन पैयले नी समझ्या था. पर जब यीशु की महिमा प्रगट हुइ, ते उनखे याद आयो, कि या बातहोन ओका बारे मे लिखी हुइ थी. अरु दुन्याहोन ने ओकासे यो प्रकार को व्यव्हार कर्यो थो.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />तब गर्दी का दुन्याहोन ने जो उ टेम ओका साथ था या गवइ दी कि ओने लाजर खे कब्र मे से बुलैइ खे, मऱ्या हुया मे से जिन्दो थो. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />यो कारण इन्सानहोन ओकासे दान करण खे आया था क्युकी उनने सुन्यो थो, कि ओने यो आश्चर्यकर्म दिखायो हइ. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />तब फरीसीहोन ने आपस मे बोल्यो, “सोचनु की तुम इन्सान कुछ नी करी र्‍हा हइ. देखनु, जगत ओका पीछे हुइ चल्यो हइ.”<verse eid="JHN 12:19" /></para>
  <para style="s">यीशु अरु यूनानी</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />जो इन्सान उ त्योहार मे आराधना करण आया था उनमे से कइ यूनानी था. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />उनने गलील का बैतसैदा का र्‍हेनआला फिलिप्पुस का पास अयखे स्वामी से प्रार्थना करी, “श्रीमान हम यीशु से दान करणो चाहस हइ.”<verse eid="JHN 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22" />फिलिप्पुस ने अयखे अन्द्रियास से बोल्यो. तब अन्द्रियास अरु फिलिप्पुस ने यीशु से बोल्यो. <verse eid="JHN 12:22" /><verse number="23" style="v" sid="JHN 12:23" />येका पर यीशु ने उनसे बोल्यो, “ वा टेम अय गइ हइ, कि इन्सान का बेटा कि महिमा हुये. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />मी तुम से सच्ची-सच्ची बोलुस हइ, कि जब तक गहु का दानो जमीन मे गीरी खे मरी नी जाय, उ एकलो र्‍हेस हइ पर जब मरी जास हइ, ते भोत फल लास हइ. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />जो अपनो जान खे प्रेम जानस हइ, उ ओखे गमइ देस हइ. अरु जो यो जगत मे अपना जान खे अप्रिय जानस हइ. उ अनन्त जिवन का लिये ओकी रक्षा कर्ये. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />अगर कोय मरी सेवा कर्ये ते मरा पीछे अय जा. अरु झा मी हइ व्हा मरो सेवक भी हुये. अगर कोय मरी सेवा कर्ये ते बाप ओको आदर कर्ये.<verse eid="JHN 12:26" /></para>
  <para style="s">अपना मरना का बारे मे भविष्यद्वाणी</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />“अब मरी आत्मा अरु मन से व्याकुल हइ, येका लिए अब मी का बोलु ‘हे बाप का मेखे या टेम से बचा?’ पर मी यो करण से तो मी ह्यातक पहुच्योस हइ. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />हे बाप अपना नाम की महिमा कर,”</para>
  <para style="p" vid="JHN 12:28">तब या आकाशवाणी हुइ, “मेने ओकी महीमा करी हइ, अरु फिर भी कर्‍यु.”<verse eid="JHN 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29" />तब जो इन्सान खडा हुया सुनी र्‍हा था, उनने बोल्यो. कि बद्दल गरज्यो का दुसरा ने बोल्यो, “कोय स्वर्गदूत ओकासे बोल्हे.”<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />येका पर यीशु ने बोल्यो का “यो आवाज मरा लिये नी पर तुमारा लिये आयो हइ. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />अब यो जगत को न्याय होस हइ, अब यो जगत को मुखियो नीकाली दियो जाये. <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />अरु मी अगर पृथ्वी पर से उचो पर चढायो जाये ते सब खे अपना पास खीच्यु.” <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />असो बोलीखे ओने यो प्रगट करी दियो, कि उ कसी मृत्यु से मर्ये.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />येका पर दुन्याहोन ने ओकासे बोल्यो, “हमने व्यवस्था की या बात सुनइ हइ, कि मसीह कभी भी र्‍हिये का फिर तू का बोलस हइ, कि इन्सान का बेटा खे उचा पर चडायो जानो जरुरत हइ? यो इन्सान को बेटो कोन हइ?”<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />यीशु ने उनसे बोल्यो, “ज्योति अब थोड़ी देर तक तुमारा बीच मे हइ, जब तक ज्योति तुमारा साथ हइ तब तक चल्यो चलनु. असो नी हो कि अधारो तुमखे अय घेर्‍यो. जो अंधारा मे चलस हइ उ नी जाने कि किधर जास हइ <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />जब तक ज्योति तुमारा साथ हइ, ज्योति पर विश्वास करणु कि तुम ज्योति का सन्तान बननु” या बातहोन बोलीखे यीशु चली गयो अरु उनसे लुक्यो र्‍हियो.<verse eid="JHN 12:36" /></para>
  <para style="s">भविष्यवाणिहोन को पूरो होनो</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />अरु ओने उनका सामने इत्ता चिन्ह दिखाया, ते भी उनने ओका पर विश्वास नी कर्यो. <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />ताकि यशायाह भविष्यव्दक्ता को वचन पूरो हुये जो ओने बोल्यो:</para>
  <para style="q1" vid="JHN 12:38">“हे प्रभु, हमारा समाचार पर कोय ने विश्वास कर्यो हइ?</para>
  <para style="q2" vid="JHN 12:38">अरु प्रभु को बाहुबल को पर प्रकट हुयो?”<verse eid="JHN 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />यो कारण वे विश्वास नी करी सक्या, क्युकी यशायाह ने यो भी बोल्यो हइ<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />“ओने उनकी आख अंधी,</para>
  <para style="q2" vid="JHN 12:40">अरु उनको मन कठोर कर्यो हइ.</para>
  <para style="q1" vid="JHN 12:40">कही असो नी हो, कि आखहोन से देख्ये का</para>
  <para style="q2" vid="JHN 12:40">अरु मन से समझ्येका</para>
  <para style="q2" vid="JHN 12:40">अरु फिर्ये, अरु मी उनखे अच्छो कर्यु.”<verse eid="JHN 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />यशायाह ने या बातहोन येका लिए बोली, कि ओने ओकी महिमा देखी. अरु ओने ओका बारे मे बातहोन करी. <verse eid="JHN 12:41" /><verse number="42" style="v" sid="JHN 12:42" />ते भी मुखियोहोन मे से भी भोत जन ने ओका पर विश्वास कर्यो, पर फरीसीहोन का कारण प्रगट मे नी मानता था, असो नी हो कि आराधनालय मे से नीकाली जाये <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />क्युकी इन्सानहोन की प्रशसा उनखे परमेश्वर की प्रशसा से जादा प्रिय लगती थी.<verse eid="JHN 12:43" /></para>
  <para style="s">उजाला मे चलनो</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />यीशु ने पुकारी खे बोल्यो, “जो मरा पर विश्वास करस हइ, उ मरा पर नी, क्युकी मरा भेजनआला पर विश्वास करस हइ. <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />अरु जो मेखे देखस हइ, उ मरा भेजनआला खे देखस हइ. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />मी जगत मे उजालो हुइखे आयो हइ ताकि जो कोय मरा पर विश्वास कर्येका उ अंधारा मे नी र्‍हे. <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />अगर कोय मरी बातहोन सुनीखे नी माने, ते मी ओखे दोषी नी ठैरास, क्युकी मी जगत खे दोषी ठैरान का लिये नी, पर जगत को उध्दार करण का लिये आयो हइ. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />जो मेखे तुच्छ जानस हइ अरु मरी बातहोन खे अपनाय नी ओखे दोषी ठैरानआला तो एक हइ यानेकी जो वचन मेने बोल्यो हइ, उ अन्नत दिन मे ओखे दोषी ठैइराये. <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />क्युकी मेने अपना तरफ से बातहोन नी करी, पर बाप जेने मेखे भेज्यो हइ ओ ने मेखे आज्ञा दी हइ, कि का का बोलु अरु का का बतवु? <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />अरु मी जानुस हइ, कि ओकी आज्ञा अनन्त जिवन हइ येका लिए मी जो बोलुस हइ, उ जसो बाप ने मरासे बोल्यो हइ ओसो मी बोलस हइ.”<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">प्रभु भोज</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />फसह को त्योहार से पैयले जब यीशु ने जानी लियो, कि मरी वा टेम अय पहुची हइ कि जगत छोडी खे बाप का पास जायु ते अपना दुन्याहोन से जो जगत मे था, जसो प्रेम उ रखेतो थो, अन्नत तक ओसो मे प्रेम रखेतो र्‍हिये. <verse eid="JHN 13:1" /><verse number="2" style="v" sid="JHN 13:2" />अरु जब सैतान शमौन को बेटो यहूदा इस्करियोती का मन मे यो डाली चुक्यो थो, कि ओखे पकडनो हइ ते खाना का टेम मे. <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />यीशु ने यो जानीखे कि बाप ने सब कुछ ओका हात मे करी दियो हइ अरु मी परमेश्वर का पास से आयो हइ, अरु परमेश्‍वर का पास जउस हइ. <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />खाना पर से उठीखे अपना कपडा उतारी दिया, अरु डुप्पटा लीखे अपनी कम्मर बाधी. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />तब बर्तन मे पानी भरीखे सेवक होन का पाय धोनो अरु जो डुप्पटा से ओकी कम्मर बधी थी ओका से पोछन लग्यो. <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />जब उ शमौन पतरस का पास आयो तब ओने ओकासे बोल्यो, “हे प्रभु, का तू मरा पाय धोस हइ?”<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />यीशु ने ओखे जवाब दियो, “जो मी करुस हइ, तू अभी नी जानु, पर येका बाद समझ्ये.”<verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />पतरस ने ओकासे बोल्यो, “तू मरा पाय कभी नी धोय पाये!”</para>
  <para style="p" vid="JHN 13:8">यो सुनीखे यीशु ने ओकासे बोल्ये “अगर मी तोखे नी धोयु, ते मरा साथ तरा कुछ भी भाग नी”<verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />शमौन पतरस ने ओकासे बोल्यो, “हे प्रभु ते मरा पाय ही नी क्युकी हात अरु माथो भी धोइ दे.”<verse eid="JHN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10" />यीशु ने ओकासे बोल्यो, “जो नैइ चुक्यो हइ, ओका पाय सिवा अरु कुछ धोना को प्रयोजन नी. पर उ बिलकुल अच्छो हइ अरु तुम अच्छो हुये. पर सब का सब नी.” <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />उ ते अपना पकडनआला खे जानतो थो येका लिए ओने बोल्यो, “तुम सब का सब अच्छो नी.”<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />जब उ उनका पाय धो चुक्यो अरु अपना कपडा पेनीखे फिर बठी गयो ते उनसे बोलन लग्यो “तुम समझ्या कि मेने तुमारा साथ कर्यो? <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />तुम मेखे गुरु अरु प्रभु बोलस हइ, अरु भलो बोलस हइ, क्युकी मी उ आय. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />अगर मेने प्रभु अरु गुरु हुइखे तुमारा पाय धोया. ते तुमखे भी एक दूसरा का पाय धोनो होनु. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />क्युकी मेने तुमखे नमूनो दिखैइ दियो हइ, कि जसो मेने तुमारा साथ कर्यो हइ, तुम भी ओसो ही कर्या करणु. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />मी तुम से सच्ची-सच्ची बोलुस हइ, सेवक अपना स्वामी से बडो नी. अरु नी भेज्या हुया अपना भेजनआला से. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />तुम तो या बातहोन जानस हइ, अरु अगर उन पर चलनु, ते धन्य हुये.<verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />“मी तुम सब काबारे मे नी बोलस जिन खे मेने चुनी लियो हइ, उनखे मी जानस हइ. पर यो येका लिए हइ, कि पवित्रशास्त्र को यो वचन पूरा हुये, ‘जो मरी रोटी खास हइ ओने मरा पर लात उठैइ.’ <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />अब मी ओका होना से पैयले तुमखे बतैइ देउस हइ कि जब हुइ जाये ते तुम विश्वास करणु कि मी उ आय. <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />मी तुम से सच्ची-सच्ची बोलस हय, कि जो मेरा भेजो हुया खे ग्रहण करस हइ, उ मेखे ग्रहण करता हइ, अरु जो मेखे ग्रहण करस हइ, वह मेरे भेजनआला खे ग्रहण करस हइ.”<verse eid="JHN 13:20" /></para>
  <para style="s">विश्वासघात का तरफ इशारो</para>
  <para style="r">(<ref loc="MAT 26:20-25">मत्ती 26:20-25</ref>; <ref loc="MRK 14:17-21">मरकुस 14:17-21</ref>; <ref loc="LUK 22:21-23">लूका 22:21-23</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />या बातहोन बोलीखे यीशु आत्मा मे व्याकुल हुयो अरु या गवइ दी, “मी तुम से सच्ची-सच्ची बोलुस हइ, कि तुम मे से एक मेखे पकडवाये.”<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />सेवक होन यो संदेह करता हुया, कि उ को का बारे मे बोलस हइ, एक दूसरा का तरफ देखन लग्या. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />ओका सेवक होन मे से एक जोका से यीशु प्रेम रखेतो थो, यीशु कि छाती का तरफ झुक्यो हुयो बठौ थो. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />तब शमौन पतरस ने ओका तरफ हिसारो करीखे पूछ्यो, “बता तो, उ को का बारे मे बोलस हइ?”<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />तब ओने वा तरह यीशु की छाती का तरफ झुकीखे पूछ्यो, “हे प्रभु, उ कोन हइ?” यीशु ने जवाब दियो, “जेखे मी या रोटी को टुकडो डुबैइ खे दियु, उ हइ.”<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />यीशु ने उत्तर दियो अरु ओने टुकडो डुबैइ खे शमौन को बेटो यहूदा इस्करियोती खे दियो. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />अरु टुकडो लेते मे सैतान ओमे समैयी गयो तब यीशु ने ओकासे बोल्यो, “जो तू करणआलो हइ, जल्दी कर.” <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />पर बठनआलाहोन मे से कोय ने नी जान्यो कि ओने या बात ओकासे काय का लिये बोली. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />यहूदा का पास थैली र्‍हेती थी, येका लिए कोइ-कोय ने समझ्यो, कि यीशु ओकासे बोलस हइ, कि जो कुछ हमखे तिवार का लिये होनु उ मोल ले, या यो कि गरीबहोन खे कुछ दे.<verse eid="JHN 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 13:30" />तब उ टुकडो लीखे जल्दी बाहेर चली गयो, अरु रात को टेम थो.<verse eid="JHN 13:30" /></para>
  <para style="s">एक नइ आज्ञा</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />जब उ बाहेर चली गयो ते यीशु ने बोल्यो, “आब इन्सान का बेटा की महिमा हुइ, अरु परमेश्वर की महिमा ओमे हुय. <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />अरु परमेश्वर भी अपना मे ओकी महिमा कर्ये क्युकी झल्दी कर्ये. <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />हे बच्चाहोन, मी अरु थोड़ी देर तुमारा पास हइ फिर तुम मेखे ढूढ्येका अरु जसो मेने यहूदीयाहोन से बोल्यो, ‘झा मी जउस हइ, व्हा तुम नी अय सक्ये ओसो ही मी अब तुम से भी बोलुस हइ.’ <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />मी तुमखे एक नइ आज्ञा देउस हइ, कि एक दूसरा से प्रेम रखनु जसो मेने तुम से प्रेम रख्यो हइ, ओसो मे तुम भी एक दूसरा से प्रेम रखनु. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />अगर आपस मे प्रेम रख्ये ते येका से सब जान्ये कि तुम मरा सेवक हइ.”<verse eid="JHN 13:35" /></para>
  <para style="s">यीशु द्वारा पतरस को इनकासर की भविष्यद्वाणी</para>
  <para style="r">(<ref loc="MAT 26:31-35">मत्ती 26:31-35</ref>; <ref loc="MRK 14:27-31">मरकुस 14:27-31</ref>; <ref loc="LUK 22:31-34">लूका 22:31-34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />शमौन पतरस ने ओकासे बोल्यो, “हे प्रभु, तू खा जास हइ?”</para>
  <para style="p" vid="JHN 13:36">यीशु ने जवाब दियो, “झा मी जउस हइ, व्हा तू अब मरा पीछे अय नी सक्ये. पर येका बाद मरा पीछे आह्ये.”<verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />पतरस ने ओकासे बोल्यो, “हे प्रभु, अभी मी तरा पीछे क्यु नी अय सक्ये? मी तरा लिये अपनो जान दियु.”<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />यीशु ने जवाब दियो “तू मरा लिये अपनो जान दिये? मी तरा से सच्ची-सच्ची बोलुस हइ कि मुर्गा बांग नी दिये जब तक तू तीन बार मरो इनकार नी करी लिये.<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">यीशु का अपना चेलहोन खे धिरज देनो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />“तुम्हारो मन व्याकुल न हुये, तुम परमेश्वर पर विश्वास रखस हइ मरा पर भी विश्वास रखनु. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />मरा बाप का घर मे भोत सी र्‍हेन कि जगा हइ, अगर नी होती ते मी तुम से बोली देतो क्युकी मी तुमारा लिये जगा तैयार करण जउस हइ. <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />अरु अगर मी जैइखे तुमारा लिये जगा तैयार कर्यु, ते फिर अयखे तुमखे अपना ह्या ली जायू, कि झा मी र्‍हियु व्हा तुम भी र्‍हेनु. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />अरु झा मी जउस हइ तुम व्हा कि रस्ता जानस हइ.”<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />थोमा ने ओकासे बोल्यो, “हे प्रभु, हम नी जाने कि तू खा जास हइ. ते रस्ता कसा जान्ये?”<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />यीशु ने ओकासे बोल्यो, “रस्ता अरु सच्ची अरु जिवन मी ही हइ. बिना मरा वजेसे कोय बाप का पास नी पहुचे सक्ये. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />अगर तुम ने मेखे जान्यो होतो, ते मरा बाप खे भी जानता, अरु अब ओखे जानस हइ, अरु ओखे देख्यो भी हइ.”<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />फिलिप्पुस ने ओकासे बोल्यो, “हे प्रभु, बाप खे हमखे दिख्यै दे योही हमारा लिये भोत हइ.”<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />यीशु ने ओकासे बोल्यो, “हे फिलिप्पुस, मी येत्ता दिन से तुमारा साथ हइ, अरु का तू मेखे नी जाने? जे ने मेखे देख्यो हइ ओने बाप खे देख्यो हइ तू का बोलस हइ कि बाप खे हमखे दिखा? <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />का तू विश्वास नी कर्‍हे, कि मी बाप मे हइ, अरु बाप मरा मे हइ? या बातहोन जो मी तुम से बोलस हइ, अपना तरफ से नी बोलु, पर बाप मरा मे र्‍हिखे अपनो काम करस हइ. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />मरो ही विश्वास करणु, कि मी बाप मे हइ. अरु बाप मरा मे हइ. नी ते कामहोन का कारण मरो विश्वास करणु.<verse eid="JHN 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 14:12" />“मी तुम से सच्ची-सच्ची बोलुस हइ, कि जो मरा पर विश्वास रखस हइ, ये काम जो मी करस हइ उ भी कर्ये, क्युकी इनसे भी बडा काम कर्ये, क्युकी मी बाप का पास जउस हइ. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />अरु जो कुछ तुम मरा नाम से माग्ये, उ मी कर्यु कि बेटा का वजेसे बाप की महिमा हुये. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />अगर तुम मरासे मरा नाम से कुछ माग्ये, ते मी ओखे कर्यु.<verse eid="JHN 14:14" /></para>
  <para style="s">पवित्र आत्मा की प्रतीज्ञा</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />“अगर तुम मरासे प्रेम रखस हइ, ते मरी आज्ञाहोन खे मान्ये. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />अरु मी बाप से प्रार्थना कर्यु, अरु उ तुमखे एक अरु मदत करी दिह्ये, कि उ कभी भी तुमारा साथ र्‍हिये. <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />यानेकी सच्चीइ की आत्मा खे जेखे जगत ग्रहण नी करी सक्ये, क्युकी उ नी ओखे देखस हइ अरु नी ओखे जानस हइ तुम ओखे जानस हइ, क्युकी उ तुमारा साथ र्हेस हइ, अरु उ तुम मे हुये.<verse eid="JHN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18" />“मी तुमखे अनाथ नी छोड्यु, मी तुमारा पास वापस अउस हइ. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />अरु थोड़ी देर र्‍हि गइ हइ कि जगत मेखे नी देख्ये, पर तुम मेखे देख्ये, येकालिये कि मी जिन्दो हइ, तुम भी जिन्दो र्हिये. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />उ दिन तुम जान्ये, कि मी अपना बाप मे हइ, अरु तुम मरा मे, अरु मी तुम मे.<verse eid="JHN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21" />“जेका पास मरी आज्ञा हइ, अरु उ उनखे मानस हइ, उ मरासे प्रेम रखस हइ, अरु जो मरासे प्रेम रखस हइ, ओकासे मरो बाप प्रेम रख्ये, अरु मी ओकासे प्रेम रख्यु, अरु अपना आप खे ओका पर प्रगट कर्‍यु.”<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />उ यहूदा ने जो इस्करियोती नी थो, ओकासे बोल्यो, “हे प्रभु, का हुयो कि तू अपना आप खे हम पर प्रगट करणो चाहस हइ, अरु जगत पर नी?”<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />यीशु ने ओखे जवाब दियो, “अगर कोय मरासे प्रेम रख्ये, ते उ मरो वचन खे मान्ये, अरु मरो बाप ओकासे प्रेम रख्ये, अरु हम ओका पास आह्ये, अरु ओका साथ वास कर्ये. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />जो मरासे प्रेम नी रख्ये, उ मरो वचन नी माने, अरु जो वचन तुम सुनस हइ, उ मरो नी क्युकी बाप को हइ, जे ने मेखे भेज्यो.<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />“या बातहोन मेने तुमारा साथ र्‍हेता हुये तुम से बोली. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />पर मदतगार यानेकी पवित्र आत्मा जेखे बाप मरा नाम से भेज्ये, उ तुमखे सब बातहोन सिखाये, अरु जो कुछ मेने तुम से बोल्यो हइ, उ सब तुमखे याद कराये.”<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />मी तुमखे शांती दिखे जउस हइ, अपनी शांती तुमखे देउस हइ. जसो जगत देस हइ, मी तुमखे नी देउ तुमारो मन नी घबराये अरु नी डरनु. <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />तुम ने सुन्यो कि मेने तुम से बोल्यो, मी जउस हइ अरु तुमारा पास फिर अउस हइ. अगर तुम मरासे प्रेम रख्ये. ते या बात से खुश हुये, कि मी बाप का पास जउस हइ क्युकी बाप मरा से बडो हइ. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />अरु मेने अब येका होना से पैयले तुम से बोली दियो हइ, कि जब उ हुये जाये, ते तुम विश्वास करणू. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />मी अब से तुमारा साथ अरु भोत बातहोन कर्यु क्युकी यो जगत को मुखियो आस हइ, अरु मरा पर ओको कुछ अधिकार नी. <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />पर यो येकालिये होस हइ कि जगत जान्ये कि मी बाप से प्रेम रखुस हइ, अरु जो तरह बाप ने मेखे आज्ञा दी, मी ओसो ही करुस हइ,</para>
  <para style="p" vid="JHN 14:31">उठी खे ह्या से चल.<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">यीशु सच्ची अंगूर कि बेल</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />सच्ची अंगूर कि बेल मी हइ. अरु मरो बाप किसान हइ. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />जो डाली मरा मे हइ, अरु नी फले, ओखे उ काटी डालस हइ, अरु जो फलस हइ, ओखे उ छाटस हइ ताकि जादा फल्ये. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />तुम तो उ वचनकरण जो मेने तुम से बोल्यो हइ, अच्छो हुये. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />तुम मरा मे बन्या र्‍हेनु, अरु मी तुम मे जसी डाली अगर अंगूर कि बेल मे बनी नी ऱ्हिये ते अपना आप से नी फली सक्ये ओसो ही तुम भी अगर मरा मे बन्या नी र्‍हिये ते नी फली सक्ये.<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />मी अंगूर कि बेल हइ तुम डालीहोन हइ. जो मरा मे बन्यो र्‍हेस हइ, अरु मी ओमे, उ भोत फल फलस हइ, क्युकी मरासे अलग हुइखे तुम कुछ भी नी करी सक्ये. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />अगर कोय मरा मे बन्यो नी र्हियेका ते वा डाली का जसा फेकी दियो जास, अरु सूखी जास हइ. अरु इन्सान उनखे बटोरीखे अंगार मे फेकी देस हइ, अरु वे जली जास हइ. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />अगर तुम मरा मे बन्या र्‍हिये अरु मरी बातहोन तुम मे बनी र्‍हिये ते जो चाह्ये मागनू अरु उ तुमारा लिये हुइ जाये. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />मरा बाप की महिमा येमे से होस हइ, कि तुम भोत सो फल लानु, तब तुम मरा सेवक ठैइऱ्यो. <verse eid="JHN 15:8" /><verse number="9" style="v" sid="JHN 15:9" />जसो बाप ने मरासे प्रेम रख्यो, ओसो मेने तुम से प्रेम रख्यो, मरा प्रेम मे बन्या र्‍हिये. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />अगर तुम मरी आज्ञाहोन खे मान्ये का ते मरा प्रेम मे बन्या र्हिये जसा कि मेने अपना बाप की आज्ञाहोन खे मान्यो हइ, अरु ओका प्रेम मे बन्यो र्‍हेस हइ.<verse eid="JHN 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11" />मेने या बातहोन तुम से येका लिये बोली हइ, कि मरो आनन्द तुम मे बन्यो र्‍हिये अरु तुमारो आनन्द पूरा हुइ जाये.<verse eid="JHN 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 15:12" />मरी आज्ञा या हइ, कि जसो मेने तुम से प्रेम रख्यो, ओसो ही तुम भी एक दूसरा से प्रेम रखनु. <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />येका से बडो प्रेम कोय को नी, कि कोय अपना दोस्तहोन का लिये अपनो जान देनु. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />जो कुछ मी तुमखे आज्ञा देउस हइ, अगर ओखे करणु, ते तुम मरा दोस्त हुये. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />अब से मी तुमखे दास नी बोल्यु, क्युकी सेवक नी जाने, कि ओको स्वामी का करस हइ पर मेने तुमखे दोस्त बोल्यो हइ, क्युकी मेने जो बातहोन अपना बाप से सुनी, वे सब तुमखे बतैइ दी. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />तुम ने मेखे नी चुन्यो पर मेने तुमखे चुन्यो हइ अरु तुमखे ठैइरायो ताकि तुम जैइखे फल लानु. अरु तुमारो फल बन्यो र्‍हिये कि तुम मरा नाम से जो कुछ बाप से माग्ये उ तुमखे दिये. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />या बातहोन की आज्ञा मी तुमखे येका लिये देउस हइ, कि तुम एक दूसरा से प्रेम रखनु.<verse eid="JHN 15:17" /></para>
  <para style="s">जगत से सताव</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />“अगर जगत तुम से बैर रखस हइ, ते तुम जानस हइ, कि ओने तुम से पैयले मरासे भी बैर रख्यो. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />अगर तुम जगत का होस, ते जगत अपना से प्रेम रखेतो, पर यो कारण कि तुम जगत, नी क्युकी मेने तुमखे जगत मे से चुनी लियो हइ. येका लिये जगत तुम से बैर रखस हइ. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />जो बात मेने तुम से बोली थी, ‘सेवक अपना स्वामी से बडो नी होय.’ ओखे याद रखनु अगर उनने मेखे सतायो, ते तुमखे भी सताये. अगर उनने मरी बात मानी, ते तुमारी भी मान्ये. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />पर यो सब कुछ वे मरा नामकरण तुमारा साथ कर्ये क्युकी वे मरा भेजनआला खे जाने. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />अगर मी नी आतो अरु उनसे बातहोन नी करतो, ते वे पापी नी रोखता था पर अब उनके उनका पाप का लिये कोय बहानो नी. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />जो मरासे बैर रखस हइ, उ मरा बाप से भी बैर रखस हइ. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />अगर मी उनमे वे काम नी करतो, जो दुसरा कोय ने नी कर्या ते वे पापी नी ठैइरता, पर अब तो उनने मेखे अरु मरा बाप दोइ खे देख्यो, अरु दोइ से बैर कर्यो. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />अरु येका लिये हुयो, कि उ वचन पूरा हो, जो उनकी व्यवस्था मे लिख्यो हइ, ‘उनने मरासे बेकार बैर कर्यो.’<verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />“पर जब उ मदतगार अये जेखे मी तुमारा पास बाप का तरफ से भेजु, मंनजे सच्ची की आत्मा जो बाप, तरफ से नीकलस हइ, ते वा मरी गवइ दिये. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />अरु तुम भी गवइ होनु क्युकी तुम सुरुवात से मरा साथ हइ.<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />“या बातहोन मेने तुम से, येका लिए बोली कि तुम ठोकर नी खानू. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />वे तुमखे आराधनालयहोन मे से नीकाली दिये क्युकी उ टेम आस हइ, कि जो कोय तुमखे मारी डाल्ये यो समझ्ये कि मी परमेश्वर की सेवा करुस हइ. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />अरु येका लिए कर्ये कि उनने नी बाप खे जान्यो हइ अरु नी मेखे जानस हइ. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />पर या बातहोन मेने येका लिए तुम से बोली, कि जब उनखे पूरो होन को टेम आयो ते तुमखे याद अय जाये कि मेने तुम से पैयले ही बोली दियो थो.</para>
  <para style="s" vid="JHN 16:4">पवित्र आत्मा को काम</para>
  <para style="p" vid="JHN 16:4">“मेने सुरुवात मे तुम से या बातहोन येका लिए नी बोली क्युकी मी तुम्हारा साथ थो. <verse eid="JHN 16:4" /><verse number="5" style="v" sid="JHN 16:5" />अब मी अपना भेजन आला का पास जउस हइ अरु तुम मे से कोय मरासे नी पुछे, तू खा जास हइ? <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />पर मेने जो या बातहोन तुम से बोली हइ, येका लिए तुमारो मन शोक से भरी गयो. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />फिर भी मी तुम से सच्ची बोलुस हइ, कि मरो जानो तुमारा लिये अच्छा हइ, क्युकी अगर मी नी जाउ, ते उ मदतगार तुमारा पास नी आये का पर अगर मी जाह्यु, ते ओखे तुमारा पास भेजी दिह्यु. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />अरु उ अय खे जगत खे पाप अरु धार्मीकता अरु न्याय का बारे मे नीरुत्तर कर्ये. <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />पाप का बारे मे येका लिए कि वे मरा पर विश्वास नी कर्ये. <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />अरु धार्मीकता का बारे मे येका लिए कि मी बाप का पास जउस हइ, अरु तुम मेखे फिर नी देख्ये. <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />न्याय का बारे मे येका लिए कि जगत को मुखियो दोषी ठैरायो गयो हइ.<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />“मेखे तुम से अरु भी भोत सी बातहोन बोलनो हइ, पर अभी तुम उनखे सै नी सक्ये. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />पर जब उ मंनजे सचाइ कि आत्मा अये ते तुमखे सब सच्चीइ कि रस्ता बताये क्युकी उ अपना तरफ से नी बोल्ये पर जो कुछ सुन्ये का उ बोल्ये अरु आनआली बातहोन तुमखे बताये. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />उ मरी महिमा कर्ये क्युकी उ मरी बातहोन मे से लीखे तुमखे बताये. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />जो कुछ बाप को हइ, उ सब मरो हइ. येका लिए मेने बोल्यो, कि उ मरी बातहोन मे से लीखे तुमखे बताये.<verse eid="JHN 16:15" /></para>
  <para style="s">दुख खुशी मे बदली जाये</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />“थोडी देर मे तुम मेखे नी देख्ये, अरु फिर थोडी देर मे मेखे देख्ये.”<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />तब ओका केत्ता सेवक होन ने आपस मे बोल्यो, यो का हइ, जो उ हम से बोलस हइ, थोडी देर मे तुम मेखे नी देख्ये का अरु फिर थोड़ी देर मे मेखे देख्ये? अरु यो येका लिये कि मी बाप का पास जउस हइ? <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />तब उनने बोल्यो कि यो थोड़ी देर जो उ बोलस हइ का बात हइ? हम नी जाने कि का बोलस हइ.<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />यीशु ने यो जानीखे कि वे मरासे पुछनो चाउस हइ, उनसे बोल्यो तुम आपस मे मरी या बात का बारे मे पुछ-ताछ करस हइ, थोडी देर मे तुम मेखे नी देख्ये का अरु फिर थोड़ी देर मे मेखे देख्ये? <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />मी तुम से सच्ची सच्ची बोलुस हइ. कि तुम रोये अरु विलाप कर्ये पर जगत खुशी कर्ये तुमखे दुख हुये कि पर तुमारो दुख खुशी बनी जाये. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />जब बय जन्म देस हइ ते ओखे दुख होस हइ, क्युकी ओको दुख की घडी अय पहुची, पर जब उ बच्चा खे जन्म दि चुकी ते या खुशी से कि जगत मे एक इन्सान उत्पन्न हुयो, वा संकट खे फिर याद नी कर्ये. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />अरु तुमखे भी अब तो दुख हइ, पर मी तुम से फिर मील्यु अरु तुमारा मन मे खुशी हुये. अरु तुमारी खुशी कोय तुम से छुडय नी लीये.<verse eid="JHN 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23" />“उ दिन तुम मरासे कुछ नी पुछ्ये. मी तुम से सच्ची सच्ची बोलुस हइ, अगर बाप से कुछ माग्ये का ते उ मरा नाम से तुमखे दिये. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />अब तक तुम ने मरा नाम से कुछ नी माग्यो. माग्ये ते मील्हे जब कि तुमारी खुशी पूरी हुइ जाये.<verse eid="JHN 16:24" /></para>
  <para style="s">जगत पर विजय</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />“मेने या बातहो न तुम से बुरीआत्माहोन मे बोली हइ, पर उ टेम आस हइ, कि मी तुम से बुरीआत्माहोन मे अरु फिर नी कर्यु पर खोलीखे तुमखे बाप का बारे मे बतायु. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />उ दिन तुम मरा नाम से माग्ये, अरु मी तुम से यो नी बोलु, कि मी तुमारा लिये बाप से प्रार्थना कर्यु. <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />क्युकी बाप तो खुद मे तुम से प्रेम रखस हइ, येका लिए कि तुम ने मरा से प्रेम रख्यो हइ, अरु यो भी विश्वास कर्यो, कि मी बाप का तरफ से आयो. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />मी बाप का तरफ से जगत मे आयो हइ, फिर जगत खे छोडी खे बाप का पास वापस जउस हइ.”<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />ओका सेवक होन ने बोल्यो, “देख, अब तो तू खुली खे बोलस हइ, कोय दृष्‍टान्‍त नी बोले. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />आब हम जानी गया, कि तू सब कुछ जानस हइ, अरु जरुरत नी की कोय तरा से सवाल कर्ये येका से हम विश्वास करस हइ, कि तू परमेश्वर का तरफ से आयो हइ”<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />यो सुनी खे यीशु ने उनसे बोल्यो “का तुम आब विश्वास करस हइ? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />देखनु, वा घडी आस हइ क्युकी अय पहुची कि तुम सब इदर उदर हुइखे अपना-अपना रस्ता लिये अरु मेखे अयखेलो छोड दिये फिर भी मी एकलो नी क्युकी बाप मरा साथ हइ. <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />मेने या बातहोन तुम से येका लिए बोली हइ, कि तुमखे मरा मे शांती मीले. जगत मे तुमखे दुख होस हइ, पर हिम्मत बाधनु, मेने जगत खे जीती लियो हइ.”<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">यीशु की खुद का लिये प्रार्थना</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />यीशु ने या बातहोन बोली अरु अपनी आखहोन बद्दल का तरफ उठैइखे बोल्यो, “हे बाप, वा घडी अय पहुची, अपना बेटा की महिमा कर, कि बेटो भी तरी महिमा कर्ये <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />क्युकी तोने ओखे सब जनवरहोन पर अधिकार दियो, कि जिन खे तोने ओखे दियो हइ, उन सब खे उ अनन्त जिवन दे. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />अरु अनन्त जिवन यो हइ, कि वे तोखे एकी सच्ची परमेश्वर खे अरु यीशु मसीह खे, जेखे तोने भेज्यो हइ, जाने. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />जो काम तोने मेखे करण खे दियो थो, ओखे पूरो करीखे मेने पृथ्वी पर तरी महिमा करी हइ. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />अरु अब हे बाप, तू अपना साथ मरी महिमा कर जो जगत की सृष्टि पैयले, मरा तरा साथ थी.<verse eid="JHN 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />“मेने तरो नाम वे इन्सानहोन पर प्रगट कर्यो जिन खे तोने जगत मे से मेखे दियो वे तरा था अरु तोने उनने मेखे दियो अरु उनने तरा वचन खे मानी लियो हइ. <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />अब वे जानी गया हइ, कि जो कुछ तोने मेखे दियो हइ, सब तरा तरफ से हइ. <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />क्युकी जो बातहोन तोने मेखे पहुचैइ दी, मेने उनखे पहुचैइ दि अरु उनने उनखे ग्रहण कर्यो अरु सच्ची सच्ची जानी लियो हइ, कि मी तरा तरफ से आयो हइ, अरु यो विश्वास कर्यो हइ की तोने ही मेखे भेज्यो.<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />“मी उनका लिये प्रार्थना करुस हइ, जगत का लिये प्रार्थना नी करुस हइ पर उन्ही का लिये जिन खे तोने मेखे दियो हइ, क्युकी वे तरा हइ. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />अरु जो कुछ मरो हइ उ सब तरो हइ. अरु जो तरो हइ उ मरो हइ. अरु इनसे मरी महिमा प्रगट हुय हइ. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />मी अब जगत मे नी र्‍हियु, पर ये जगत मे ऱ्‍हियेका अरु मी तरा पास अउस हइ. हे पवित्र बाप, अपना उ नाम से जो तोने मेखे दियो हइ, उनकी रक्षा कर, कि वे हमारा जसो एक समान हो. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />जब मी उनका साथ थो, ते मेने तरा उ नाम से, जो तोने मेखे दियो हइ, उनकी रक्षा करी मेने उनकी देख-रेख करी अरु विनाश का बेटा खे छोड उनमे से कोय नाश नी हुयो, येका लिए कि पवित्रशास्त्र की बात पूरी हुये. <verse eid="JHN 17:12" /><verse number="13" style="v" sid="JHN 17:13" />पर आब मी तरा पास अउस हइ, अरु या बातहोन जगत मे बोलुस हइ, कि वे मरी खुशी अपना मे पूरा पाये. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />मेने तरो वचन उनखे पहुचैइ दियो हइ, अरु जगत ने उनसे बैर कर्यो, क्युकी जसो मी जगत को नी, ओसो ही वे भी जगत का नी. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />मी या प्रार्थना नी करु, कि तुम उनखे जगत से उठै ले, पर यो कि तुम उनखे उ दुष्ट से बचैइ रख. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />जसो मी जगत को नी, ओसो ही वे भी जगत नी. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />सच्चाइ का वजेसे उनखे पवित्र कर तरो वचन सच्ची हइ. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />जसो तोने जगत मे मेखे भेज्यो, ओसो मे मेने भी उनखे जगत मे भेज्यो. <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />अरु उनका लिये मी अपना आप खे पवित्र करुस हइ ताकि वे भी सच्चाइ का वजेसे पवित्र कर्या जाये.<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />“मी फक्त इन का लिये प्रार्थना नी करु, पर उनका लिये भी जो इन, वचन खे वजेसे मरा पर विश्वास कर्ये <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />कि वे सब एक हो. जसो तू हे बाप मरा मे हइ, अरु मी तरा मे हइ, ओसो ही वे भी हम मे हुये खे येका लिए कि जगत विश्वास कर्ये का कि तोने ही ने मेखे भेज्यो. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />अरु वा महिमा जो तोने मेखे दी, मेने उनखे दी हइ कि वे असो ही एक हो जसा कि हम एक हइ. <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />मी उनमे अरु तू मरा मे कि वे सिद्ध हुइखे एक हुय जाये अरु जगत जान कि तोने मेखे भेज्यो, अरु जसो तोने मरासे प्रेम रख्यो, ओसो ही उनसे प्रेम रख्यो.<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />“हे बाप, मी चाहुस हइ कि जिन खे तोने मेखे दियो हइ, झा मी हइ, व्हा वे भी मरा साथ हो कि वे मरी वा महिमा खे देख्ये जो तोने मेखे दी हइ, क्युकी तोने जगत की उत्पत्ति से पैयले मरासे प्रेम रख्यो. <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />हे धर्मी बाप, जगत ने मेखे नी जान्यो, पर मेने तोखे जान्यो अरु येने भी जान्यो कि तोने ही मेखे भेज्यो. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />अरु मेने तरो नाम उनखे बतायो अरु बतातो र्‍हियु कि जो प्रेम तोखे मरासे थो, उ उनमे र्‍हिये अरु मी उनमे र्‍हियु.”<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">बगीचा मे यीशु को पकडायो जानो</para>
  <para style="r">(<ref loc="MAT 26:47-56">मत्ती 26:47-56</ref>; <ref loc="MRK 14:43-50">मरकुस 14:43-50</ref>; <ref loc="LUK 22:47-53">लूका 22:47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />यीशु या बातहोन बोलीखे अपना सेवक होन का साथ किद्रोन का नाला का पार गयो, व्हा एक बारी थी, जोमे उ अरु ओका सेवक गया. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />अरु ओको पकडनआलो यहूदा भी वा जगा जानतो थो, क्युकी यीशु अपना सेवक होन का साथ व्हा जाया करतो थो. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />तब यहूदा सैना-दल का अरु प्रधान याजकहोन अरु फरीसीहोन का तरफ से सेवकहोन खे लीखे दीयाहोन अरु मशालहोन अरु हथियारहोन खे लिया हुया व्हा आयो. <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />तब यीशु वे सब बातहोन खे जो ओका पर आनआली थी, जानीखे नीकल्यो, अरु उनसे बोलन लग्यो, “कोखे ढूढस हइ?”<verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />उनने ओखे जवाब दियो, “यीशु नासरी खे”</para>
  <para style="p" vid="JHN 18:5">यीशु ने उनसे बोल्यो, “मी आय”</para>
  <para style="p" vid="JHN 18:5">अरु ओको पकडनआलो यहूदा भी उनका साथ खडो थो.<verse eid="JHN 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 18:6" />ओखे यो बोलतो ही, “मी आय,” वे पीछे हटीखे जमीन पर गिर पड्या. <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />तब ओने फिर उनसे पूछ्यो,</para>
  <para style="p" vid="JHN 18:7">“तुम को खे ढूढस हइ” वे बोल्या, “यीशु नासरी खे.”<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />यीशु ने जवाब दियो, “मी तो तुम से बोल चुक्यो हइ कि मी आय, अगर मेखे ढूढस हइ ते इनखे जान दे.” <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />यो येका लिए हुयो, कि यो वचन पूरो हुये, जो ओने बोल्यो थो “जिन खे तोने मेखे दियो, उनमे से मेने एक खे भी नी खोयो.”<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />शमौन पतरस ने तलवार, जो ओका पास थी, खीची अरु महायाजक का सेवक पर चलखे, ओको दाहिनो कान काटी दियो, उ दास को नाम मलखुस थो. <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" />तब यीशु ने पतरस से बोल्यो, “अपनी तलवार मयान मे रख जो कटोरो बाप ने मेखे दियो हइ, का मी ओखे नी पीयु?”<verse eid="JHN 18:11" /></para>
  <para style="s">हन्ना का सामने यीशु</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />तब सेवकहोन अरु उनका सुबेदार अरु यहूदीयाहोन का सेवकहोन ने यीशु खे पकडैखे बाधी लियो, <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />अरु पैयले ओखे हन्ना का पास ली गया क्युकी उ ओखे साल को महायाजक कैफा को सुसरो थो. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />यो उ कैफा थो, जेने यहूदीयाहोन खे सलाह दी थी कि हमारा दुन्याहोन का लिये एक इन्सान को मरनु अच्छो हइ.<verse eid="JHN 18:14" /></para>
  <para style="s">पतरस को यीशु खे पहचानना से इनकार</para>
  <para style="r">(<ref loc="MAT 26:69">मत्ती 26:69</ref>,<ref loc="MAT 26:70">70</ref>; <ref loc="MRK 14:66-68">मरकुस 14:66-68</ref>; <ref loc="LUK 22:55-57">लूका 22:55-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />शमौन पतरस अरु एक अरु चेलो भी यीशु का पीछे अय गा यो चेलो महायाजक को जाना पैछान्यो थो अरु यीशु का साथ महायाजक का अंगन मे गयो. <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />पर पतरस बाहेर दरवाजा पर खडो र्‍हियो, तब उ दूसरो चेलो जो महायाजक को जान्यो पहचान्यो थो, बाहेर नीकल्यो, अरु चौकीदार से बोलीखे पतरस खे अंदर ली आयो. <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />वा दासी ने जो चौकीदार थी, पतरस से बोल्यो “तू भी यो इन्सान का सेवक होन मे से हइ?”</para>
  <para style="p" vid="JHN 18:17">ओने बोल्यो, “मी नी आय.”<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />दास अरु सेवक ठडकारण कोयला जलय खे अंगार तापी र्‍हा था अरु पतरस भी उनका साथ खडो अंगार तापी र्‍हो थो.<verse eid="JHN 18:18" /></para>
  <para style="s">महायाजक का सामने यीशु</para>
  <para style="r">(<ref loc="MAT 26:59-66">मत्ती 26:59-66</ref>; <ref loc="MRK 14:55-64">मरकुस 14:55-64</ref>; <ref loc="LUK 22:66-71">लूका 22:66-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />तब महायाजक ने यीशु से ओका सेवक होन का बारे मे अरु ओका उपदेस का बारे मे पुछयो. <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />यीशु ने ओको जवाब दियो, “मेने जगत से खुली खे बातहोन करी. मेने आराधनालयहोन अरु मन्‍दिर मे झा सब यहूदीया जमा हुया करस हइ सदा उपदेस कर्यो अरु गुप्त मे कुछ भी नी बोल्यो. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />तू मरासे क्यु पूछस हइ? सुनानवाला से पूछ्यो कि मेने उनसे का बोल्यो? देख वे जानस हइ. कि मेने बोल्यो.”<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />जब ओने यो बोल्यो, तो सेवकहोन मे से एक ने जो पास खडो थो, यीशु खे थप्पड मारीखे बोल्यो, “ का तू महायाजक खे यो प्रकार जवाब देस हइ?”<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />यीशु ने ओखे जवाब दियो, “अगर मेने बुरो बोल्यो तरे वा बुरोइ पर गवइ दे. पर अगर भलो बोल्यो, तो मेखे क्यु मारस हइ?”<verse eid="JHN 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24" />हन्ना ने ओखे बध्यो हुया कैफा महायाजक खे पास भेजी दियो.<verse eid="JHN 18:24" /></para>
  <para style="s">पतरस को यीशु खे पहचानना से फिर से इनकार</para>
  <para style="r">(<ref loc="MAT 26:71-75">मत्ती 26:71-75</ref>; <ref loc="MRK 14:69-72">मरकुस 14:69-72</ref>; <ref loc="LUK 22:58-62">लूका 22:58-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />शमौन पतरस खडो हुयो अंगार तापी र्‍हो थो तब उनने ओकासे बोल्यो “ का तू भी ओका सेवक होन मे से हइ?”</para>
  <para style="p" vid="JHN 18:25">ओने इनकार करीखे बोल्यो, “मी नी आय”<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />महायाजक का सेवकहोन मे से एक जो ओका कुटुब मे से थो, जोको कान पतरस काटी डाल्यो थो, बोल्यो, “ का मेने तोखे ओका साथ बाडी मे नी देख्यो थो?”<verse eid="JHN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27" />पतरस फिर इनकार करी गयो अरु जल्दी मुर्गा ने बांग दी.<verse eid="JHN 18:27" /></para>
  <para style="s">यीशु खे पिलातुस का सामने लाया जानो</para>
  <para style="r">(<ref loc="MAT 27:1">मत्ती 27:1</ref>,<ref loc="MAT 27:2">2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="MRK 15:1-5">मरकुस 15:1-5</ref>; <ref loc="LUK 23:1-5">लूका 23:1-5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />अरु वे यीशु खे कैफा का पास से किल्ला मे खे ली गया अरु फजर को टेम थो, पर वे खुद किल्ला का अंदर नी गयो ताकि अशुद्ध नी हुये पर त्योवार खै सखे. <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />तब पिलातुस उनका पास बाहेर नीकली आयो अरु बोल्यो, “तुम यो इन्सान पर कोनती बात को इलजाम लगास हइ?”<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />उनने ओखे जवाब दियो, “अगर उ कुकर्मी नी होतो ते हम ओखे तरा हात नी सौपता.”<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />पिलातुस ने ओकासे बोल्यो, “तुम मे येखे ली जैइखे अपनी व्यवस्था का जसो ओको न्याय करणु.” यहूदीयाहोन ने ओकासे बोल्यो, “हमखे अधिकार नी कि कोइ कि जान ले.” <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />यो येका लिए हुयो, कि यीशु की वा बात पूरी हो जो ओने यो दर्शाता हुये बोली थी, कि ओको मरनो कसो हुये.<verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />तब पिलातुस फिर किल्ला का अंदर गयो अरु यीशु खे बुलैइ खे, ओकासे पूछ्यो “तू यहूदीयाहोन को राजो हइ?”<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />यीशु ने जवाब दियो, “का तू या बात अपना तरफ से बोलस हइ या दुसरा ने मरा बारे मे तरा से बोली?”<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />पिलातुस ने जवाब दियो, “मी यहूदीया आय? तरी मे जाति अरु प्रधान याजकहोन ने तोखे मरा हात दियो तोने का कर्यो हइ?”<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />यीशु ने जवाब दियो, “मरो राज्य यो जगत को नी, अगर मरो राज्य यो जगत को होतो, ते मरा सेवक लडता, कि मी यहूदीयाहोन का हात सोपी नी जातो पर अब मरो राज्य ह्या को नी.”<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />पिलातुस ने ओकासे बोल्यो, “ते का तू राजा हइ?”</para>
  <para style="p" vid="JHN 18:37">यीशु ने जवाब दियो, “तू बोलस हइ कि मी राजा आय. मेने येका लिए जन्म लियो, अरु येका लिए जगत मे आयो हइ कि सच्चाइ पर गवइ दे जो कोय सच्चाइ को हइ, उ मरी आवाज सुनस हइ.” 1 यूह. 4:6<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />पिलातुस ने ओकासे बोल्यो, “सच्चाइ हइ?” अरु यो बोलीखे उ फिर यहूदीयाहोन का पास नीकली गयो अरु उनसे बोल्यो,</para>
  <para style="s" vid="JHN 18:38">मरन का दण्ड कि आज्ञा</para>
  <para style="r" vid="JHN 18:38">(<ref loc="MAT 27:15-31">मत्ती 27:15-31</ref>; <ref loc="MRK 15:6-20">मरकुस 15:6-20</ref>; <ref loc="LUK 23:13-25">लूका 23:13-25</ref>)</para>
  <para style="p" vid="JHN 18:38">मी तो ओमे कुछ दोष नी होन.<verse eid="JHN 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 18:39" />पर तुम्हारी या रीति हइ कि, “मी त्योवारमे तुम्हारा लिये एक इन्सान खे छोडी दियू. ते का तुम चाहस हइ, कि मी तुम्हारा लिये यहूदीयाहोन को राजा का छोडी दियु?”<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />तब उनने फिर चिलैइ खे बोल्यो, “येखे नी पर हमारा लिये बरअब्बा खे छोडी दे.” अरु बरअब्बा डाकू थो.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />येका पर पिलातुस ने यीशु खे लिखे कोडा लगवाया. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />अरु सेवकहोन ने काटा को मुकुट गूधिखे ओका माथा रख्यो, अरु ओखे बैगनी कपडा पेनाया, <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />अरु ओका पास अयखे बोलन लग्या, “हे यहूदीयाहोन का राजा खे प्रणाम!” अरु ओखे थप्पड मार्यो.<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />तब पिलातुस ने फिर बाहेर नीकलीखे दुन्याहोन से बोल्यो, “देखनु, मी ओखे तुम्हारा पास फिर बाहेर लउस हइ. ताकि तुम जान्ये कि मी कुछ भी दोष नी मील्हे.”<verse eid="JHN 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 19:5" />तब यीशु का काटा को मुकुट अरु बैगनी कपडा परन्या हुया बाहेर नीकल्यो अरु पिलातुस ने उनसे बोल्यो, “देखनु यो इन्सान.”<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />जब प्रधान याजकहोन अरु सेवकहोन ने ओखे देख्यो ते चिलैइ खे बोल्यो, “ओखे क्रुस पर चडा, क्रुस पर!” पिलातुस ने उनसे बोल्यो,</para>
  <para style="p" vid="JHN 19:6">“तुम मे ओखे लिखे क्रुस पर चडा. क्युकी मी ओका मे दोष नी पायो.”<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />यहूदीयाहोन ने ओखे जवाब दियो, “हमारी भी व्यवस्था हइ अरु व्यवस्था का जसो उ मार्यो जान का योग्य हइ क्युकी ओने अपना आप खे परमेश्वर को बेटो बतायो.”<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />जब पिलातुस ने या बात सुनी ते अरु भी डरी गयो. <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />अरु फिर किल्ला का अंदर गयो अरु यीशु से बोल्यो,</para>
  <para style="p" vid="JHN 19:9">“तू खा को हइ?” पर यीशु ने ओखे कुछ भी जवाब नी दियो. <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />पिलातुस ने ओकासे बोल्यो, “मरासे क्यु नी बोले, तू नी जाने कि तोखे छोड़ देन को अधिकार मेखे हइ अरु तोखे क्रुस पर चडान को भी अधिकार हइ.”<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />यीशु ने जवाब दियो, “अगर तोखे उपर से नी दियो जातो, ते तरो मरा पर कुछ अधिकार नी होतो. येका लिए जेने मेखे तरो हात पकडवायो हइ, ओको पाप जादा हइ.”<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />येका से पिलातुस ने ओखे छोड़ देनो चायो, पर यहूदीयाहोन ने चिल्लै चिल्लय खे बोल्यो, “अगर तू येखे छोड़ दिये ते तू कैसर को दोस्त नी. जो कोय अपना आप खे राजो बनास हइ उ कैसर को सामनो करस हइ.”<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />या बातहोन सुनीखे पिलातुस यीशु खे बाहेर लायो अरु वा जगह मे एक चबूत्ररो थो का जो इब्रानी मे “गब्बता” बोलस हइ का अरु न्याय आसन पर बैठ्यो. <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />यो त्योवार को तैयारी को दिन थो अरु छे घंटा का नजीकपास थो तब ओने यहूदीहोन से बोल्यो, “देखनु, योही हइ, तुम्हारो राजो!”<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />पर वे चिल्लाया, ली जा!</para>
  <para style="p" vid="JHN 19:15">ली जा! ओखे क्रुस पर चढ़ा! पिलातुस ने उनसे बोल्यो “मी तुम्हारो राजा?”</para>
  <para style="p" vid="JHN 19:15">“खे क्रुस पर चढ़ाउ प्रधान याजकहोन ने जवाब दियो.”</para>
  <para style="p" vid="JHN 19:15">“कैसर खे छोड़ हमारो अरु कोय राजो नी.”<verse eid="JHN 19:15" /></para>
  <para style="s">क्रुस पर चढायो जानो</para>
  <para style="r">(<ref loc="MAT 27:32-44">मत्ती 27:32-44</ref>; <ref loc="MRK 15:21-32">मरकुस 15:21-32</ref>; <ref loc="LUK 23:26-43">लूका 23:26-43</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />तब ओने ओखे उनका हात सौप दियो ताकि उ क्रुस पर चढायो जाये. <verse eid="JHN 19:16" /><verse number="17" style="v" sid="JHN 19:17" />तब वे यीशु खे ली गया अरु उ अपनो क्रुस उठायो हुया उ जगा तक बाहेर गयो जो “खोपडी कि जगा” बोलस हइ अरु इब्रानी मे “गुलगुता.” <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />व्हा उनने ओखे अरु उ ओका साथ अरु दो इन्सानहोन खे क्रुस पर चढायो, एक खे इधर अरु एक खे उधर, अरु बीच मे यीशु खे. <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />अरु पिलातुस ने एक दोष चिट्टी लिखीखे क्रुस पर लगै दि अरु ओमे यो लिख्यो हुयो थो, “यीशु नासरी यहूदीयाहोन को राजो.” <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />यो दोष चिट्टी भोत यहूदीयाहोन ने पड्यो क्युकी वा जगा झा यीशु क्रुस पर चढायो गयो थो नगर का पास थी अरु चिट्टी इब्रानी अरु लतीनी अरु यूनानी मे लिखी हुइ थी. <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />तब यहूदीयाहोन को प्रधान याजकहोन ने पिलातुस से बोल्यो, “यहूदीयाहोन को राजो” मत लिख पर यो कि “ओने बोल्यो, मी यहूदीयाहोन को राजो हइ.”<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />पिलातुस ने जवाब दियो, “मेने जो लिखी दियो, उ लिखी दियो.”<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />जब सेवक होन ने यीशु खे क्रुस पर चडा चुक्या, ते ओका कपडा लिखे चार टुकडा कर्या, हर सेवक का लिये एक टुकडो अरु कुर्ता भी लियो, पर कुर्ता बिन सीअन उपर से नीचे तक सियो हुयो थो. <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />येका लिए उनने आपस मे बोल्यो, “हम येखे नी फाड्ये पर येका पर चिट्ठी डाल्ये कि उ कोको हुये” यो येका लिए हुयो,</para>
  <para style="q1" vid="JHN 19:24">कि पवित्रशास्त्र की बात पूरी हो,</para>
  <para style="q2" vid="JHN 19:24">“उनने मरा कपडा आपस मे बाटी लिया अरु मरा कपडा पर चिट्ठी डाली.”<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />अन्नत सेवकहोन ने असो मे कर्यो, पर यीशु खे क्रुस का पास ओकी माय अरु ओकी माय की भैइन मरियम, क्लोपास की लुगइ अरु मरियम मगदलीनी खड़ी थी. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />यीशु ने अपनी माय अरु ओका सेवक खे जोका से उ प्रेम रखेतो थो पास खडा देखीखे अपनी माय से बोल्यो, “हे बय, देख, यो तरो बेटो आय.” <verse eid="JHN 19:26" /><verse number="27" style="v" sid="JHN 19:27" />तब ओका सेवक से बोल्यो, “या तरी माय आय” अरु उ टेम से उ सेवक ओखे अपना घर ली गया.<verse eid="JHN 19:27" /></para>
  <para style="s">यीशु को मरनो</para>
  <para style="r">(<ref loc="MAT 27:45-56">मत्ती 27:45-56</ref>; <ref loc="MRK 15:33-41">मरकुस 15:33-41</ref>; <ref loc="LUK 23:44-49">लूका 23:44-49</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />येका बाद यीशु ने यो जानीखे कि आब सब कुछ हुइ चुक्यो. येका लिए कि पवित्रशास्त्र की बात पूरी हुये बोल्यो, “मी प्यासो हइ.” <verse eid="JHN 19:28" /><verse number="29" style="v" sid="JHN 19:29" />व्हा एक सिरका से भर्यो हुयो बर्तन धर्यो थो, येका लिए उनने सिरका भिजायो हुया पनसोख्‍ता को जूफा पर रखीखे ओका मुडा से लगायो. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />जब यीशु ने वह सिरकी लि खे बोल्यो, “पूरो हुय” अरु माथो झुखै खे आत्मा छोडी दियो.<verse eid="JHN 19:30" /></para>
  <para style="s">भाला से छेध्यो जानो</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />अरु येका लिए कि उ तैयारी को दिन थो, यहूदीयाहोन ने पिलातुस से प्रार्थना करीखे कि उनकी टाग तोडी दि जाह्ये अरु वे उतार्ये जाह्ये क्युकी अराम को दिन वे क्रुस पर नी र्‍हिये क्युकी उ अराम को दिन बडो दिन थो. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />येका लिए सेवक होन ने अयखे पहइले की टागहोन तोडी तब दूसरा की भी, जो ओका साथ क्रुसहोन पर चडाया गया था. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />पर जब यीशु का पास देख्यो कि उ मरी चुक्यो हइ, ते ओकी टागहोन नी तोडी. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />पर सेवक होन मे से एक ने ओको पजर बेधा अरु ओमे से जल्दी खुन अरु पानी नीकल्यो. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />जो ने यो देख्यो, ओ ने गवइ दी हइ, अरु ओकी गवइ सच्ची हइ. अरु उ जानस हइ, कि सच्ची बोलस हइ कि तुम भी विश्वास करणु. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />ये बातहोन येका लिए हुइ कि पवित्रशास्त्र की या बात पूरी हुये, “ओकी कोय हड्डी तोडी नी जाये.” <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />फिर एक अरु जगा पर यो लिख्यो हइ, “जोका से उनने बेध्यो हइ, ओ पर दृष्टि कर्ये.”<verse eid="JHN 19:37" /></para>
  <para style="s">यूसुफ का कब्र मे यीशु को दफनायो जानो</para>
  <para style="r">(<ref loc="MAT 27:45-56">मत्ती 27:45-56</ref>; <ref loc="MRK 15:33-41">मरकुस 15:33-41</ref>; <ref loc="LUK 23:44-49">लूका 23:44-49</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />या बातहोन का बाद अरिमतियाह का यूसुफ ने, जो यीशु को चेलो थो, पर यहूदीयाहोन का डर से या बात खे लुकायो थो, पिलातुस से प्रार्थना करीखे कि मी यीशु कि लास खे ली जउ, अरु पिलातुस ने ओकी प्रार्थना सुनी, अरु उ अय खे ओको लास ली गयो. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />नीकुदेमुस भी जो पहइले यीशु का पास रात खे गयो थो पचास सेर का लोबान मील्यो हुयो गन्धरस अरु एलवा ली आयो. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />तब उनने यीशु को लास खे लियो अरु यहूदीयाहोन का गाडन की रीति का जसो ओखे गधानवाली चिज का साथ कपडा मे गुड्यो. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />जगा पर झा यीशु क्रुस पर चढायो गयो थो, एक बारी थी. अरु वा बारी मे एक नइ कब्र थी. जोमे कभी कोय नी रख्यो गयो थो. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />अन्नत यहूदीयाहोन की तैयारी का दिन थो, उनने यीशु खे ओ मे रख्यो, क्युकी वा कब्र पास थी.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">खाली कब्र</para>
  <para style="r">(<ref loc="MAT 28:1-8">मत्ती 28:1-8</ref>; <ref loc="MRK 16:1-8">मरकुस 16:1-8</ref>; <ref loc="LUK 24:1-12">लूका 24:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />हप्ता, पैयले दिन मरियम मगदलीनी फजर का अधारो र्‍हेतो मे कब्र पर अय, अरु पत्थर खे कब्र से हट्यो हुयो देख्यो. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />तब वा दौडी अरु शमौन पतरस अरु उ दूसरा सेवक का पास जोका से यीशु प्रेम रखेतो थो अयखे बोल्यो, “वे प्रभु खे कब्र मे से नीकाली ली गया हइ. अरु हम नी जानती, कि ओखे खा रखी दियो हइ.”<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />तब पतरस अरु उ दूसरो चेलो नीकलीखे कब्र का तरफ चल्यो. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />अरु दोइ साथ-साथ दौडी र्‍हा था, पर दूसरो चेलो पतरस से आगे बडीखे कब्र पर पहइले पहुच्यो. <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />अरु झुकीखे कपडा पड्या देख्या ते भी उ अंदर नी गयो. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />तब शमौन पतरस ओका पीछे-पीछे पहुच्यो अरु कब्र का अंदर गयो अरु कपडा पड्या देख्या. <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />अरु उ कपडो जो ओका माथा पर बाध्यो हुयो थो कपडा का साथ पडयो हुयो नी पर अलग एक जगा लपेट्यो हुयो देख्यो. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />तब दूसरो चेलो भी जो कब्र पर पैयले पहुच्यो थो, अंदर गयो अरु देखीखे विश्वास कर्यो. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />वे तो अब तक पवित्रशास्त्र की वा बात नी समझता था, कि ओखे मर्या हुया मे से जी उठनो हुये. <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />तब ये सेवक अपना घर लौटी गया.<verse eid="JHN 20:10" /></para>
  <para style="s">मरियम मगदलीनी खे दर्शन</para>
  <para style="r">(<ref loc="MAT 28:9">मत्ती 28:9</ref>,<ref loc="MAT 28:10">10</ref>; <ref loc="LUK 16:9-11">लूका 16:9-11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />पर मरियम रोती हुइ कब्र का पास मे बाहेर खड़ी थी अरु रोते-रोते कब्र का तरफ झुकीखे, <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />दो स्वर्गदूतहोन खे सफात कपडा पेन्या हुया एक खे सिरहाना अरु दूसरा खे पाय का पास बठ्यो देख्यो, झा यीशु की लास पड्‍यो थो. <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />उनने ओकासे बोल्यो, “हे बय, तू क्यु रोस हइ?” ओने उनसे बोल्यो,</para>
  <para style="p" vid="JHN 20:13">“वे मरा प्रभु खे उठै ली गया अरु मी नी जानु कि ओखे खा रख्यो हइ.”<verse eid="JHN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14" />यो बोलीखे वा पीछे फिरी अरु यीशु खे खडो देख्यो अरु नी पहचान्यो कि यो यीशु हइ. <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />यीशु ने ओकासे बोल्यो, “हे बय तू क्यु रोस हइ? को खे ढूढस हइ?” ओने माली समझी खे ओकासे बोल्यो, “हे श्रीमान, अगर तोने ओखे उठै लियो हइ ते प्रभु से बोल कि ओखे खा रख्यो हइ अरु मी ओखे ली जायु.”<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />यीशु ने ओकासे बोल्यो, “मरियम!” ओने पीछे फिरीखे ओकासे इब्रानी मे बोल्यो का “रब्बूनी!” मंनजे हे गुरु.<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />यीशु ने ओकासे बोल्यो का “मेखे मत छी क्युकी मी अब तक बाप का पास उपर नी गयो, पर मरा भैइहोन का पास जैइखे उनसे बोली दे कि मी अपना बाप का अरु तुम्हारा बाप का अरु अपना परमेश्वर अरु तुम्हारा परमेश्वर का पास उपर जउस हइ.”<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />मरियम मगदलीनी ने जैइखे सेवक होन खे बतायो, “मेने प्रभु खे देख्यो अरु ओने मरासे बातहोन बोली.”<verse eid="JHN 20:18" /></para>
  <para style="s">सेवक होन का बीच मे यीशु को प्रगट होनो</para>
  <para style="r">(<ref loc="MAT 28:16-20">मत्ती 28:16-20</ref>; <ref loc="MRK 16:14-18">मरकुस 16:14-18</ref>; <ref loc="LUK 24:36-49">लूका 24:36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />उ दिन जो हप्ता का पहइलो दिन थो, शाम को टेम जब व्हा, दरवाजा झा सेवक था, यहूदीयाहोन का डर का मारे बन्द था, तब यीशु आयो अरु उनका बीच मे खडो हुइखे ओने बोल्यो, “तुम खे शांती मील्ये.” <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />अरु यो बोलीखे ओने अपना हात अरु अपनी हतेली उनखे दिखायो तब सेवक प्रभु खे देखीखे खुश हुया. <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />यीशु ने फिर उनसे बोल्यो, “तुमखे शांती मीले. जसो बाप ने मेखे भेज्यो हइ, वसो मी भी तुमखे भेजुस हइ.” <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />यो बोलीखे ओने उन पर फूक्यो अरु उनसे बोल्यो, “पवित्र आत्मा ले. <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />जिन को पाप तुम माफी करणु वे उनका लिये माफ कर्या गया हइ. जिन खे तुम रख्ये वे रख्या गया हइ.”<verse eid="JHN 20:23" /></para>
  <para style="s">देखनो अरु विश्वास करणु</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />पर बारा जन मे से एक इन्सान मंनजे थोमा जो दिदिमुस बोलस हइ, जब यीशु आयो ते उनखे साथ नी थो. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />जब अरु सेवक ओकासे बोलन लग्या, “हमने प्रभु खे देख्यो हइ,” तब ओने उनसे बोल्यो, “जब तक मी ओका हाथहोन मे खीला को छेद नी देखी लूका अरु खीला का छेदहोन मे अपनी उगली नी डाली लूका तब तक मी विश्वास नी कर्यु.”<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />आठ दिन का बाद ओका सेवक फिर घर का अंदर था, अरु थोमा उनका साथ थो, अरु दरवाजो बन्द था, तब यीशु ने अयखे अरु बीच मे खडो हुइखे बोल्यो, “तुम खे शांती मीले.”<verse eid="JHN 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 20:27" />तब ओने थोमा से बोल्यो, “अपनी उगली ह्या लैइखे मरा हाथहोन खे देख अरु अपनो हात लैइखे मरा हतेली मे डाल अरु अविश्वासी नी पर विश्वासी होनु”<verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />यो सुन्यो थोमा ने जवाब दियो, “हे मरा प्रभु, हे मरा परमेश्‍वर!”<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />यीशु ने ओकासे बोल्यो, “तोने तो मरो विश्वास कर्यो हइ? धन्य हइ वे जेने बिन देख्यो विश्वास कर्यो.”<verse eid="JHN 20:29" /></para>
  <para style="s">या किताब यहून्ना ने क्यु लिखी</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />यीशु ने अरु भी भोत चिन्ह सेवक होन का सामने दिखायो, जो या किताब मे लिख्यो नी गया. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />पर ये येका लिए लिख्यो गयो हइ, कि तुम विश्वास करणु, कि यीशु मे परमेश्वर को बेटो मसीह हइ अरु विश्वास करीखे ओका नाम से जिवन पाये.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">तिबिरियुस नद्दी का धुरा चेलाहोन पर प्रगट होनो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />या बातहोन का बाद यीशु ने अपना आप खे तिबिरियुस झील का किनारा सेवक होन पर प्रगट कर्ये अरु या रीति से प्रगट कर्यो. <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />शमौन पतरस अरु थोमा जो दिदिमुस बोलस हइ, अरु गलील का काना नगर का नतनएल अरु जब्दी को बेटो, अरु ओका सेवक होन मे से दो अरु जन जमा था. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />शमौन पतरस ने उनसे बोल्यो, “मी मछ्छी पकडन जास हइ.” उनने ओकासे बोल्यो, “हम भी तरा साथ चलस हइ.”</para>
  <para style="p" vid="JHN 21:3">येका लिए वे नीकलीखे डोंगा पर चड्या, पर उ रात कुछ नी पकड्यो. <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />फजर होते ही यीशु किनार पर खडो हुयो. फिर भी सेवक होन ने नी पहचान्यो कि यो यीशु हइ. <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />तब यीशु ने उनसे बोल्यो, “हे बच्चाहोन, तुम्हारा पास कुछ खान खे हइ?” उनने जवाब दियो, “नी.” <verse eid="JHN 21:5" /><verse number="6" style="v" sid="JHN 21:6" />ओने उनसे बोल्यो, “डोंगा की दाहिनी तरफ जाल डाल, ते पाये.” तब उनने जाल डाली,</para>
  <para style="p" vid="JHN 21:6">अरु अब मच्छीहोन का कारण जाल खीच नी सक्या.<verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />येका लिए वा सेवक ने जोका से यीशु प्रेम रकतो थो पतरस से बोल्यो, “यो तो प्रभु हइ” शमौन पतरस ने यो सुनीखे कि प्रभु हइ, कमर मे कपडा खे कसी लियो, क्युकी उ बिना कपडा को थो, अरु झील मे कूद पड्यो. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />पर अरु सेवक होन डोंगा पर मच्छीहोन से भरी हुइ जाल खीचते हुयो आयो का क्युकी वे किनार से जमीन जादा दूर नी कि कोय दो सौ हात पर थो. <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />जब किनारा पर जमीन पर उतर्या, ते उनने कोयला की आग का अरु ओका पर मच्छी रखी हुइ, अरु रोटी देखी. <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />यीशु ने उनसे बोल्यो, “जो मच्छीहोन तुम ने अभी पकडी हइ, उनमे से कुछ ला.”<verse eid="JHN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11" />शमौन पतरस ने डोंगा पर चडीखे एक सौ त्रिरेपन बडी मच्छीहोन से भर्यो हुयो जाल किनारा अरु जमीन पर खीच्यो, अरु इत्ती मच्छीहोन होना पर भी जाल नी फट्यो. <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />यीशु ने उनसे बोल्यो, “आ खानो या.” अरु सेवक होन मे से कोय खे हिम्मत नी हुयो, कि ओकासे पूछे, “तू कोन हइ?” क्युकी वे जानता था कि यो प्रभु हइ. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />यीशु आयो, अरु रोटी लीखे उनने दी अरु ओसो मे मच्छी भी.<verse eid="JHN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 21:14" />या तीसरी बार हइ, कि यीशु ने मऱ्या हुया मे से जिन्दो उठना का बाद सेवक होन खे दर्शन दियो.<verse eid="JHN 21:14" /></para>
  <para style="s">यीशु की पतरस से बातचीत</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />खानो खाना का बाद यीशु ने शमौन पतरस से बोल्यो,</para>
  <para style="p" vid="JHN 21:15">“हे शमौन, यहून्ना को बेटा, खे तू इनसे बडीखे मरासे प्रेम रखस हइ?” ओने ओकासे बोल्यो, “हव प्रभु. तू तो जानस हइ, कि मी तरा से प्रिती रखुस हइ.”</para>
  <para style="p" vid="JHN 21:15">ओने ओकासे बोल्यो, “मरा मेडाहोन खे चरा.” <verse eid="JHN 21:15" /><verse number="16" style="v" sid="JHN 21:16" />ओने फिर दूसरी बार ओकासे बोल्यो, “हे शमौन यहून्ना को बेटा खे तू मरासे प्रेम रखस हइ?” ओने उनसे बोल्यो, “हव, प्रभु तू जानस हइ, कि मी तरा से प्रिती रखुस हइ.” ओने ओकासे बोल्यो, “मरा मेडाहोन की रखवाली कर.” <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />ओने तीसरी बार ओकासे बोल्यो, “हे शमौन, यहून्ना को बेटा खे तू मरासे प्रिती रखस हइ?” पतरस उदास हुयो,</para>
  <para style="p" vid="JHN 21:17">कि ओने ओखे तीसरी बार असो बोल्यो, “तू मरासे प्रेम रखस हइ?” अरु ओकासे बोल्यो, “हे प्रभु तू तो सब कुछ जानस हइ तू यो जानस हइ कि मी तरा से प्रिती रखुस हइ”</para>
  <para style="p" vid="JHN 21:17">यीशु ने ओकासे बोल्यो, “मरा मेडाहोन खे चरा. <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />मी तरा से सच्ची-सच्ची बोलुस हइ, जब तू जवान थो, ते अपनी कमर बाधीखे झा चाहतो थो, व्हा फिरतो थो. पर जब तू बूढ्ढो हुये ते अपना हात लम्बा कर्येका अरु दूसरो तरी कमर बाधीखे झा तू नी चाह्ये व्हा तोखे ली जाये.” <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />ओने या बातहोन से दर्शायो कि पतरस कसो मरना से परमेश्वर की महिमा कर्ये. अरु यो बोलीखे ओकासे बोल्यो, “मरा पीछे अय जा.”<verse eid="JHN 21:19" /></para>
  <para style="s">यीशु अरु ओको प्रिय सेवक</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />पतरस ने फिरीखे उ सेवक खे पीछे आते देख्यो, जोका से यीशु प्रेम रखेतो थो, अरु जो ने खाना का टेम ओकी छाती का तरफ झुकीखे पूछ्यो “हे प्रभु, तरो पकडनआलो कोन हइ?” <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />ओखे देखीखे पतरस ने यीशु से बोल्यो, “हे प्रभु, येको का हाल हुये?”<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />यीशु ने ओकासे बोल्यो, “अगर मी चाहु कि उ मरा आना तक ठैर्यो र्‍हिये ते तोखे? तू मरा पीछे अय जा.”<verse eid="JHN 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23" />येका लिए भैइहोन मे या बात फैली गइ, कि उ चेलो नी मर्ये. ते भी यीशु ने ओकासे यो नी बोल्यो, कि यो नी मर्येका पर यो कि “अगर मी चाहु कि यो मरा आना तक ठैर्यो र्‍हिये ते तोखे येका से का?”<verse eid="JHN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />यो उ चेलो हइ, जो या बातहोन की गवइ देस हइ अरु जो ने या बातहोन खे लिख्यो हइ अरु हम जानस हइ, कि ओकी गवइ सच्ची ची हइ.<verse eid="JHN 21:24" /></para>
  <para style="s">परिनाम</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />अरु भी भोत सा काम हइ, जो यीशु ने कर्या. अगर वे एक-एक करीखे लिख्या जास, ते मी समझयुस हइ, कि किताबहोन जो लिखी जास वे जगत मे भी नी समाती.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>