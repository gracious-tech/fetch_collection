<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- Gowlan</book>
  <para style="h">1 तीमुथियुस</para>
  <para style="toc3">1 तिमोथी</para>
  <para style="toc2">1 तिमोथी</para>
  <para style="toc1">1 तीमुथियुस का नाम से पौलुस प्रेरित कि पहली चिठ्ठी</para>
  <para style="mt2">1 तीमुथियुस का नाम पौलुस प्रेरित कि चिठ्ठी</para>
  <para style="mt1">1 तीमुथियुस का नाम पौलुस प्रेरित कि चिठ्ठी</para>
  <para style="imt">पैछान</para>
  <para style="ip">तीमुथियुस की कि किताब प्रेरित पौलुस द्वारा अपने चेला तीमुथियुस खे लिख्यो गइ एक चिठ्ठी ह. 1 तिमोथी संभवत यीशु को जन्म का नजीक पास 62-64 साल बाद लिखा गया था. ये होता पौलुस को जीवन का आखरी का बाहेर थो. पौलुस को तीमुथियुस का साथ नजीक संबंध थो अरु व्हा ओको उल्लेख करतो थो एक बेटा का रुप मे खे त्ता बार <char style="xt"><ref loc="PHM 1:2-22">फिलेमोन 2-22</ref>; <ref loc="1TI 1:2-18">1 तिमोथी 1:2—1:18</ref></char></para>
  <para style="ip">ह्या पौलुस का चार चिठ्ठी मे से एक हइ जो मंडली का बजाय कोय इन्सान खे बतायोस हइ. दुसरी तीन चिठ्ठी 2 तीमुथियुस, तीतुस अरु फिलेमोन हइ 1 तीमुथियुस मे भोत सारी शिक्षाहोन हइ मंडली की पूजा पर <char style="xt"><ref loc="1TI 2:1-15">2:1-15</ref> </char>मंडली को नेताहोन का लिए योग्यता <char style="xt"><ref loc="1TI 3:1-13">3:1-13</ref></char> का अरु चुनोती का खिलाफ झूटी शिक्षक <char style="xt"><ref loc="1TI 1:3-11">1:3-11</ref>; <ref loc="1TI 4:1-5">4:1-5</ref>; <ref loc="1TI 6:2-5">6:2-5</ref> </char>. यो बतास हइ कि पौलुस तिमोथी को एक नेता बनन का लिए कसो शिक्षन करी रा था मंडली का बीच. 1 तीमुथियुस मे कोय सिद्धांन्त शामील हइ जो हमारी मंडली को नेताहोन की मदद करी सकस हइ व्हय कि मंडली का मंत्रालय को अधीकार करण का दिन.</para>
  <para style="iot">रुप रेखा</para>
  <para style="io1">1. पौलुस ने तीमुथियुस खे प्रनाम करीखे शुरुआत करी <char style="ior"><ref loc="1TI 1:1-2">1:1-2</ref></char>.</para>
  <para style="io1">2. फिर व्हा तीमुथियुस खे झूटा शिक्षक का खीलाप चेतावनी देस हइ <char style="ior"><ref loc="1TI 1:3-11">1:3-11</ref> </char>.</para>
  <para style="io1">3. पौलुस यो समझाते हुये आगे बडते हइ कि व्हा यीशु मसीह का लिए खे त्तो आभार हइ <char style="ior"><ref loc="1TI 1:12-19">1:12-19</ref> </char></para>
  <para style="io1">4. येका बाद व्हा तीमुथियुस खे पूजा अरु मंडली को नेताहोन का बारे मे नीर्देश देतस हइ <char style="ior"><ref loc="1TI 2-3">2—3</ref> </char>.</para>
  <para style="io1">5. पौलुस ने तीमुथियुस खे कुछ आखरी नीर्देश दिखे अपनी चिठ्ठी खत्म करी <char style="ior"><ref loc="1TI 4-6">4—6</ref> </char>.</para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="s">अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />पौलुस का तरप से जो हमारो उद्धारकर्ता परमेश्वर को अरु हमारी आस मसीह यीशु की आज्ञा से मसीह यीशु को प्रेरित.<verse eid="1TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 1:2" />ती तीमुथियुस को नाम जो विश्वास मे मरो सच्चो बेटो हइ बाप परमेश्वर को अरु हमारो</para>
  <para style="p" vid="1TI 1:2">प्रभु मसीह यीशु का तरप से तोखे अनुग्रह दया खे अरु शांती मीलती र्‍हे.<note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ACT 16:1">प्रेरित 16:1</ref></char></note><verse eid="1TI 1:2" /></para>
  <para style="s">झुठो मास्तरहोन का खीलाप चेतावनी</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />जसो मे ने मकिदुनी खे जान का टेम्म तो समझायो थो, कि इफिसुस मे ऱ्हि खे कुछ दुन्याहोन खे आज्ञा दि की झुटी प्रकार कि शिक्षा नी देनु, <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />अरु वा कानहोन अरु अनन्त पुरवजहोन पर मन नी लगायेका जेकासे वाद विवाद होस हइ, अरु परमेश्वर को उ प्रबन्ध का जसो नी, जो विश्वास से सम्बन्ध रखस हइ. असो मेय फिर भी बोलुस हइ. <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />आज्ञा को सारांश यो हइ कि सपा मन अरु अच्छो विवेक को अरु नीष्कपट विश्वास से परदा प्रेम होस. <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />इनखे छोडी केतना दुन्या बेकार बात मे भटकी गया हइ. <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />अरु वे व्यवस्थापक शिक्षक तो होनो चास हइ, पर जो बात बोलस अरु जेको</para>
  <para style="p" vid="1TI 1:7">दृढता से बोलस हइ, उनका समझस भी नी. <verse eid="1TI 1:7" /><verse number="8" style="v" sid="1TI 1:8" />पर हम जानस हइ की अगर कोय नीयम खे अच्छी रीति पर काम मे लगाये ते उ अच्छो हइ <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />यो जानी, कि धर्मी जन खे नीयम लिये नी अधर्मीहोन खे नीरंकुश भक्तिहीन पापिहोन, अपवित्र अरु अशुध्दकाम माय बाप मारनवालो, खुनी, <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />व्यभिचारी खे इन्सान गामीहोन, इन्सान खे बेचन आलो को झुट बोलनवालो अरु झुटी करम खानआलो का अरु इनखे छोडीखे स्च्ची शिक्षा को सब खिलाप खे लिये रोख्यो गयो हइ. <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />यो परमधन्य परमेश्वर कि महिमा को उ सुसमाचार का जसो हइ जो मे का दियो गयो हइ.<verse eid="1TI 1:11" /></para>
  <para style="s">परमेश्वर की दया का लिए धन्यवाद</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />अरु मी अपना प्रभु मसीह यीशु को जेने मे खे सामर्थ्य दी हइ, धन्यवाद करुस हइ कि ओने मे, विश्वासयोग्य समझी खे अपनी सेवा का लिये ठयरायो. <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />मी तो पैयले नीन्दा करणवालो खे अरु सतानवालो खे वाद विवाद करणवालो थो. ते भी मरा पर दया हुइ, क्युकी मे ने अविश्वास करण बिना समजे मेने यो सब कर्‍यो थो.<note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ACT 8:3-9">प्रेरित 8:3-9-4-5</ref></char></note> <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />अरु हमारो प्रभु को अनुग्रह उ विश्वास अरु प्रेम का सात जो मसीह यीशु मे हइ भोतायत से हुयो. <verse eid="1TI 1:14" /><verse number="15" style="v" sid="1TI 1:15" />या बात सची अरु हर प्रकार से मानन, योग्य हइ, की मसीह यीशु पापिहोन को उध्दार करण का लिये जगत मे आयो कि जेमे सबसे बडो पापी मी हइ. <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />पर मरा पर येका लिये दया हुइ कि मी सबसे बडो पापी मे यीशु मसीह अपनी पुरी सहनशिलता बतय, कि जो दुन्या ओका पर अनन्त जिवन का लिये विश्वास करस कि उनका लिये मी एक आदर्श बनु. <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />आब सनातन राजा मंनजे अविनाशी कि अनदेखी अद्वैत परमेश्वर कि इज्जत अरु महिमा हमेशा होस ऱ्हेस.<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />हे बेटा ती तीमुथियुस! उ भविष्यव्दाणीहोन का जसो कि जो पैयले तरा बारे मे करी गय थी किमी या आज्ञा दियुस हइ, कि तु उनका जसो अच्छो झगडा को झगरतो ऱ्हीहे, <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />अरु विश्वास अरु उ अच्छा विवेक खे पकड्यो रख का जेखे दुर करण करन खे तना को विश्वास रुपी डोगो डुबी गयो. <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />उनका मे से हुमीनयुस अरु आलेक्झांडर हइ, जिनको मे ने सैतान खेदि दियो कि नीन्दा करणो नी सी.<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="s">मंडी कि प्रार्थना</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />आब मी सब से पैयले यो आग्रह करुस हुये खे कि बिनती का अरु प्रार्थना को अरु नीवेदन को अरु धन्यवाद सब इन्सानहोन कालिये कऱ्यो जाये. <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />राजाहोन अरु सब उच्चा पदआलो खे नीमीत्त येका लिये कि हम अराम अरु चैन का सात परमेश्वर कि भक्ति अरु गरिमा से जिवन बितास. <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />यो हमारो उद्धारकर्ता परमेश्वर खे अच्छो लगस अरु भास भी हइ. <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />जो यो चाहस हइ, कि सब इन्सानहोन को उध्दार हुये. अरु वे सत्य कि ज्ञान कि भली-भाति पैच्छानी ले. <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />क्युकी परमेश्वर एक मेय हइ, अरु परमेश्वर अरु इन्सानहोन का बिच मे भी एक मेय बिचवइ हइ, अगर मसीह यीशु जो इन्सान हइ. <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />जेने अपना आप खे सबको छुट कारा को दाम मे दि दियो कि ताकी ओकी गवइ अच्छा टेम पर दि जाये. <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />मी सच्ची बोलुस हुये खे झुटी नी बोलुका कि मी यो उद्देश्य से प्रचार अरु प्रेरित अरु गैरयहूदीहोन का लिये विश्वास सत्य को शिक्षक ठहरायो गयो.<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />येका लिये मी चास हइ, कि हर उपासना कि जगा अदमी बिना घुस्सा अरु विवाद खे पवित्र हातहोन खे उठ्य प्रार्थना करस हुये. <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" />असो मेय बयहोन भी संकोच अरु धीरज का सात सुहावने कपडा से अपना आप खे सजास. नी की बाल गूथनो, सोनो, मोतिहोन खे अरु किमति कपडाहोन से. <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />पन अच्छा काम होन से क्युकी परमेश्वर कि भक्ति करनवाली बयहोन खे यो अच्छो भी हइ. <verse eid="1TI 2:10" /><verse number="11" style="v" sid="1TI 2:11" />अरु बय खे चुपचाप से पुरी अधीनता मे र्‍हिखे सिखनो चास. <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />सिकव पन मी बोलुस हइ, कि बय नी शिक्षा दे अरु नी अदमी पर अधिकार चलाये का पन चुपचाप र्‍हिये. <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />क्युकी आदम पैयले को ओका बाद हवा बनय गय. <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />अरु आदम भैकायो नी गयो कि पर बय भैइकया मे एक गुना हइ. <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />ते भी बय बच्चा जन्म का वजेसे उध्दार पायेका अगर वा धीरज का सात विश्वास को प्रेम का अरु पवित्र मे स्थिर ऱ्हीहे.<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="s">मुखीया की योग्यता</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />या बात सची हइ कि मुखियो को पद होनो चास हइ, ते उ अच्छा काम कि इच्छा करस हइ. <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />यो आकुल्यक हइ की मुखियो नीर्दोष, अरु एक मेय बायको को अदमी, संयमी, सुशील, सभ्य, अतिथी-सत्कार करणवालो,अरु सिखाना मे नीपुण हुये. <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />पियक्कड या मारपीट करणवालो नी होनु. पन नाजुक होनु, अरु नी झगडा लुका अरु नी धन को लोभ होनु. <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />अपना घर को अच्छो प्रबन्ध करस हुये खे अरु अपनो बाल बच्चा का सब गम्भीरता से अधीन मे रखस हुये. <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />जब कोय अपना घर मेय को प्रबन्ध करणो नी जानस हुये खे ते परमेश्वर कि मंडली की रखवाली कसो कर्‍हे. <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />फिर यो कि नवो विश्वासी नी होनु का असो नी हुये की अभिमान करी कि सैतान का जसो दण्ड पाये. <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />अरु मंडली का बाहेरवाला मे भी ओको सुनाम हुये असो नी हुये कि नीन्दित हुइखे सैतान का जाल फन्दा मे फसी जाये.<verse eid="1TI 3:7" /></para>
  <para style="s">मंडली को सेवक</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />असो मेय सेवक को जसो होनु चायेका दो मेडाको का अंगूर को रस पियक्कड खे अरु बेइमान कि लोभी नी होनु. <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />पर विश्वास को भेद खे अच्छा विवेक से सुरक्षित रखे. <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />अरु ये भी पैयले समज्हे जायेका तब अगर नीर्दोष नीकले ते सेवक को काम कर्‍हे. <verse eid="1TI 3:10" /><verse number="11" style="v" sid="1TI 3:11" />यो प्रकार से बयहोन खे भी गम्भीर होनु चाये दोष लगानवाली नी होनु, पर धीरज अरु सब बातहोन मे भरोसोयोग्य हुये. <verse eid="1TI 3:11" /><verse number="12" style="v" sid="1TI 3:12" />सेवक एक मेय बय को अदमी हुये अरु बाल बच्चा अरु अपना घर को अच्छो प्रबन्ध करणो जानस हुये. <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />क्युकी जो सेवक को काम अच्छा तरीका से करी सकस हइ वे अपना लिये अच्छो पद उ विश्वास मेका जो मसीह यीशु पर बडो साहस मील्हे करस हइ.<verse eid="1TI 3:13" /></para>
  <para style="s">महान रहस्य</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />मी तरा पास झल्दी आन की आस रखना पर भी या बात तोखे येका लिये लिखुस हुये <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />अगर मरा आना मे देर हुये ते तू जानी ले की परमेश्वर का घराना मे जो जिन्दो परमेश्वर कि मंडली हइ कि अरु जो सच को खबो अरु पय्यो हइ; कसो बरताव करणु चास हइ. <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />अरु येमे आंग नी कि भक्ति को भेद गम्भीर हइ:</para>
  <para style="q2" vid="1TI 3:16">अगर उ जो आंग मे प्रगट हुयो,</para>
  <para style="q2" vid="1TI 3:16">आत्मा मे न्यायी रुख्यो कि स्वर्गदूतहोन खे दिखाइ दियो,</para>
  <para style="q2" vid="1TI 3:16">गैरयहूदीयाहोन मे ओको प्रचार हुयो,</para>
  <para style="q1" vid="1TI 3:16">जगत मे ओका पर विश्वास कऱ्यो गयो,</para>
  <para style="q2" vid="1TI 3:16">अरु महिमा मे उपर उठायो गयो.<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="s">झुठी शिक्षा से चेतावनी</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />पवित्र आत्मा सपा से बोलस हइ कि आनवालो टेम मे कतना दुन्या भटकन आली आत्माहोन खे अरु बुरीआत्माहोन कि शिक्षाहोन पर मन लगय खे विश्वास से भैइकी जाये. <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />यो वु झूटा इन्सान को कपट करन हुये खे जेको विवेक मानो जलता हुया लोखोड से दबायो गयो हइ <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />जो भ्याव करणा से रोख्या अरु खान कि कुछ चिजहोन से दुर ऱ्हेन की आज्ञा दिखे जेने परमेश्वर ने येका लिये सृजा की विश्वासी अरु सच पहचानआलो उनका धन्यवाद का साथ खाये. <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />क्युकी परमेश्वर कि सृजी हुइ हर एक चिज अच्छी हइ अरु कोय चिज अस्विर करण का योग्य नी पर यो कि धन्यवाद का साथ खाय जाये हइ. <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />क्युकी परमेश्वर को वचन अरु प्रार्थना का वजेसे से शुध्द हुये जास हइ.<verse eid="1TI 4:5" /></para>
  <para style="s">यीशु मसीह खे अच्छा सेवक</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />अगर तू भैइहोन खे या बात की याद दिलातो र्‍हेस काते मसीह यीशु को अच्छो सेवक ठैहरे. अरु विश्वास अरु वा अच्छी शिक्षा की बात से जो तू मानतो आयो हइ, तरो पालन पोषण होतो ऱ्हीहे. <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />पर अशुध्द अरु डोकरीहोन कोनसी खानीहोन से अलग र्‍हेस. अरु भक्ति मे खुद को प्रशिक्षित कर्‍हे.<verse eid="1TI 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 4:8" />क्युकी आंग की साधना से कम लाभ होस हइ, पर भक्ति सब बात का लिये लाभदायक हइ, क्युकी यो टेम को अरु आनवाला जिवन की भी वादो येका लिये हइ. <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />या बात सची अरु हर प्रकार से मानन का योग्य हइ <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />क्युकी हम मेहनत अरु यत्न येका लिये करस हइ की हमारी आस उ जिन्दो परमेश्वर पर हइ, जो सब इन्सानहोन खे अरु विशेष रुप से विश्वासीहोन को उद्धारकर्ता हइ.<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />या बात की आज्ञा दिखे अरु सिखातो र्‍हे.<verse eid="1TI 4:11" /></para>
  <para style="s">सेवक का उपर ध्यान रखनो</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 4:12" />कोय तरी जवानी को तुच्छ नी समझ पाये. पर वचन को चाल चलन को अरु प्रेम का अरु विश्वास को अरु पवित्रता मे विश्वासिहोन का लिये आदर्श बनी जास. <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />जब तक मी नी अव तब तक पडन अरु उपदेस देन अरु सिखाना मे लौलीन र्‍हे. <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />उ वरदान से जो तरा मे हइ, अरु भविष्यद्वाणी का वजेसे बुजुरुख होन खे हात रखते टेम तोखे मील्यो थो, नीश्चिन्त मत र्‍हे <verse eid="1TI 4:14" /><verse number="15" style="v" sid="1TI 4:15" />वा बात खे करतो र्‍हे अरु येमे मी अपनो ध्यान लगायो ऱ्हे, ताकी तरी उन्नती सब पर प्रगट हुये. <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />अपनी अरु अपना उपदेस मे सावधानी रख. या बात पर स्थिर र्‍हे का क्युकी अगर असो करतो र्‍हिहे, ते तू अपना खे अरु अपना सुननवाला खे लिये भी उध्दार को करण हुये.<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="s">विश्वासीहोन का प्रती जबाबदारी</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />कोय बापदादा के नी गाली देनु का पर ओका बाप जानी खे समझ्य देनु का अरु जुवान खे अपनो भैइ समझनु. <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />डोकरी बयहोन खे माय जानी खे समझनु खे अरु जुवान बयहोन खे पुरी पवित्रता से बहन जानी खे समझय दे.<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />वे विधवाहोन जो सचमेच विधवा हइ इज्जत कर. <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />अरु अगर कोय विधवा को बच्चा या नाती पंत्ती हुये खे ते वे पैयले अपना घराना का सात ख्रिती धर्म का जसो जबाबदारी नीभान को अरु अपना माय बाप अरु आजी बाबा, समाली के उनको उपकार फेडे क्युकी यो परमेश्वर खे अच्छो हइ. <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />जो सचमेच विधवा हइ, अरु ओको कोय नी कि वा परमेश्वर पर आस रखस हइ, अरु रात दिन बिनती अरु प्रार्थना मे लौलीन ऱ्हेस हइ. <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />पर जो भोग विलास मे पड गइ, वा जीते जी मरी गइ हइ. <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />दुन्याहोन यो सुचना कर कि ताकि कोय उन पर नीर्दोष नी लगानु. <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />पर अगर कोय अपना रिश्तेदारहोन की विशेष रुप से अपना परिवार की चिन्ता नी कर्‍हे, ते उ विश्वास से मुकरी गयो हइ अरु अविश्वासी से भी बुरो बनी गयो हइ.<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />वा विधवा को नाम लिख्यो जाये जो साठ साल से कम की नी होनु कि अरु एक मेय अदमी कि लुगेन ऱ्ही हुये खे <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />अरु अच्छो काम मे सुनाम ऱ्ही हुये खे जेने बच्चाहोन को पालन पोषण कर्‍यो हइ. मीजवानहोन की सेवा करी हइ, पवित्र दुन्याहोन का पाय धोया हइ, दुखहोन की मदत करी हइ, अरु हर एक अच्छा काम मे मन लगायो हइ.<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />पर जुवान विधवाहोन को नाम नी लिखनु, क्युकी जब वे सुख विलासकरण भ्याव करणो चास हइ ते मसीह के चलस हइ <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />अरु दोष ठ्यरस हइ, क्युकी उनने अपनी पहली प्रतीज्ञा खे छोडी दि हइ. <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />अरु येका सात मे सात वे घर घर फिरी खे आलसी होन खे सीखस हइ, अरु फक्त आलसी पर बगबग करस ऱ्हेस हइ अरु दुसरा काम मे हात भी डालस हइ अरु अनुचीत बात बोलस हइ. <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />येका लिये मी यो चाहुस हुये कि जुवान विधवाहोन भ्याव कर्‍हे, अरु बच्चा परदा अरु घरदार सबाले, अरु कोय विरोधीहोन खे बदनाम करण को अवसर नी दे. <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />क्युकी कोइ एक तो भैकी खे सैतान का पिछे हुये गइ हइ. <verse eid="1TI 5:15" /><verse number="16" style="v" sid="1TI 5:16" />अगर कोय विश्वासिनी खे ह्या विधवा हुये खे ते वा उनकी मदत कर्‍हे कि मंडली पर बोज नी हुये खे ताकि वा उनकी मदत करी सके जो सचमेच विधवा हइ.<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />जो बुजरुक अच्छो प्रबन्ध करस हइ, विशेष करीखे वे जो वचन सुनानो अरु सिखाना मे मेहनत करस हइ, दो गुना आदर को योग्य समझी जाये. <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />क्युकी पवित्रशास्त्र बोलस हइ, “दावनआला बैल को मुडो नी बाधनू.” क्युकी “मजुर अपनी मजुरी को हक्कदार हइ.” <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />कोय दोष कोय बुजरुक पर लगायो जाये ते बिना दो या तीन गवाह का बिना ओखे स्वीकार नी करणु. <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />पाप करणवाला खे सब का सामने समझ्य दे, ताकि दुसरा दुन्या भी डरे.<verse eid="1TI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 5:21" />परमेश्वर खे अरु मसीह यीशु खे अरु चुन्या हुया स्वर्गदूतहोन कि उपस्थित जानी खे मी तोखे चेतावनी दियुस हइ कि तु मन खोली खे या बात खे मानीखे अरु कोय काम पक्षपात से नी कर्‍हे. <verse eid="1TI 5:21" /><verse number="22" style="v" sid="1TI 5:22" />प्रभू सेवा खातीर कोय पर हात नी रखीखे प्रार्थना करण का लिये झल्दी मत करणू अरु दुसरा का पाप मे भागी नी होनु. अपना आप खे पवित्र बनायो रख.<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />भविष्य मे फक्त पाणी खे पिनवालो नी ऱ्हीहे, पन अपना पेट खे अरु अपनो घडी घडी बिमार होन का कारण थोडो थोडो अंगूर को रस भी लियो कर.<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />कुछ इन्सानहोन को पाप प्रगट हुइ जास हइ, अरु न्याय का लिये पैयले से पोची जास हइ, लेकीन दुसरा को पाप बाद मे दिखय जास हइ. <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />असा कुछ अच्छा काम भी प्रगट होस हइ. अरु जो प्रगट नी होस, वे भी लुकी नी सखे .<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />जेतना दास गुलाम का नीचे हइ, वे अपना अपना स्वामी को बडो सम्मान का योग्य जानस, ताकि परमेश्वर को नाम अरु शिक्षा की नीन्दा नी हुये. <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />अरु जेको स्वामी विश्वासी हइ, उनका वे भैइ अरु बहीन होन कारन कम नी जाने. जब उनकी अरु भी सेवा कर, क्युकी येका से लाभ उठानआला विश्वास अरु प्रेम हइ.</para>
  <para style="s" vid="1TI 6:2">झुटी शिक्षा अरु सच्चो धन</para>
  <para style="p" vid="1TI 6:2">या बात की शिक्षा कऱ्यो कर अरु समझातो ऱ्हेस.<verse eid="1TI 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />अगर कोय अरु ही प्रकार को सिध्दान्त शिकास हइ अरु हमारो प्रभु यीशु मसीह बोलीखे अरु हमारी धर्मीक शिक्षन खे नी मानस, <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />ते उ अभिमानी हइ अरु कुछ नी जानस. जब उ वाद विवाद अरु बोल पर तर्क करण को रोग हइ, जेखे से डाह, अरु वाद विवाद, अरु नीन्दा की बात, अरु बुरो बुरो सन्आंग, <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />अरु वे इन्सानहोन मे व्यर्थ रगडो वाद विवाद परदा होस हइ, जेकी डिमाक बिगडी गय हइ अरु वे सच्ची से दुर हुये गय हइ, जो समझस हइ, कि भक्ति बडी कमय को सादन हइ.<verse eid="1TI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6" />पर सन्तोष सहित भक्ति बडी लाभ हइ. <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />क्युकी नी हम जगत मे कुछ लास हइ अरु नी कुछ ली जय सकस हइ. <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />अरु अगर हमारा पास खानो अरु पेनन को हइ, ते इनका पर सन्तोष करणो चास. <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />पर जो धनी होनु चास हइ, वे असी पेपर खे अरु जाल का फन्दा अरु भोत सा व्यर्थ अरु हानी खे लालसाहोन मे फसस हइ, जो इन्सानहोन, बिगाडी देस हइ अरु विनास का समुदर मे डुबय देस हइ. <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />क्युकी पैसा को लोभ सब प्रकार की बुराइहोन कि जडी हइ, जेखे मील्हे करण को प्रयत्न करस हुये कतना ने विश्वास से भटकी खे अपना आप खे दुसरा प्रकार को दुख से दिल खे तोड्यो हइ.<verse eid="1TI 6:10" /></para>
  <para style="s">व्यक्‍तिगत नीर्देश</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />पर हे परमेश्वर को जन, तू या बात से भाग. अरु न्यायी जिवन, भक्ति, विश्वास, प्रेम, धिरज, अरु नम्रता को पीछो कर. <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />विश्वास की अच्छी कुश्ती खेल. अरु उ आखरी जिवन खे धरी ले जेका लिये तु बुलायो गयो, अरु भोत गवाहोन का सामने अच्छो अंगीकार कर्‍यो थो. <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" />मी तोखे परमेश्वर को जो सब खे जिन्दो रखस हइ, अरु मसीह यीशु की गवइ करीखे जेने पुन्तियुस पिलातुस का सामने अपना विश्वास को अच्छो अंगीकार कऱ्यो, या आज्ञा देस हुये. <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />कि तु हमारो प्रभु यीशु मसीह को प्रगट होना तक या आज्ञा खे नीष्कलंक अरु नीर्दोष रख, <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />जेखे उ अच्छा टेम पर दिख्यो, जो परमध्यन अरु एकमात्र उ अधिकारी अरु राजाहोन को राज अरु प्रभुहोन को प्रभु हइ, <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />अरु अमरता फक्त वोकि हइ, अरु उ अगम्य ज्योति मे र्‍हेस हइ, अरु नी उ कोय इन्सान ने देख्यो अरु नी कभी देखी सकस हइ. ओकी प्रतीष्ठा अरु राज्य जमाना सेज मानो र्‍हिये. आमीन.<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />यो जगत का पैसावाला खे आज्ञा दे कि वे अभिमानी नी हुये अरु अनीश्चित धन पर आस नी रखे, पन परमेश्वर पर जो हमारो सुख का लिये सब कुछ भोतायत से देस हइ. <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />अरु अच्छो करीखे अरु अच्छा काम मे धनी बनीखे अरु उदार अरु सहायता देना मे तत्पर हुये खे <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />अरु आनवाला जिवन का लिये एक अच्छो पय्यो डाल्यो रखीखे कि सच्ची जिवन खे जिती ले.<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />हे तीमुथियुस या धरोहर की रखवाली कर. जो तोखे दी गइ हइ अरु बेवकुब बात से अरु विरोध खे तर्क जो झुठो ज्ञान बोलस हइ, दुर र्‍हेस. <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />केतना यो ज्ञान खे अंगीकार करीखे विश्वास से भटकी गया हइ. तुम पर अनुग्रह होस र्‍हे.<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>