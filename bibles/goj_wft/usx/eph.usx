<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Gowlan</book>
  <para style="h">इपिसियो</para>
  <para style="toc3">इपिसियो</para>
  <para style="toc2">इपिसियो</para>
  <para style="toc1">इपिसिहोन का नाम पौलुस प्रेरित कि चिठ्ठी</para>
  <para style="mt2">इपिसियो खे नाम पौलुस प्रेरित कि चिठ्ठी</para>
  <para style="mt1">इपिसिहोन का नाम पौलुस प्रेरित कि चिठ्ठी</para>
  <para style="imt">पैछान</para>
  <para style="ip">इफिसिहोन को लेखक कोन आय? प्रेरीत पौलुस ने जेल से इफिसय, लिखी. इफिसिय 60 को हासितकर्ता कोन आय? चिठ्ठी सामग्री मे ,फी सामन्य हइ अरु येका पश्चिमी एशिया भाग मे मंन्डली, एक परिचिठ्ठी, रुप मे लिख्यो हइ. <char style="xt"><ref loc="EPH 1:1">1:1</ref></char> मे कुछ पुरानी हस्तलिखेत मे इफिसिय, हासिलकर्ता, संदर्भ मे कमी हइ. इफिसिय, कब्र मे लिख्यो गयो हुये? पौलुस एक कैदी <char style="xt"><ref loc="EPH 3:1-4:1">3:1—4:1</ref>; <ref loc="EPH 6:20">6:20</ref></char> इफिसिय, लिखी गइ चिठ्ठी, कुलुस्सिय चिठ्ठी, संग घनीष्ट सम्बन्ध हइ. येका लिये हम यो मानी सकस हइ कि पौलुस वा जेल मे होतो जब वे कुलुस्सिहोन, चिठ्ठी लिखी हुये. ये का लिये सुरवात रोमन, रावा, दौरान जो आनवाला इफिसिय, लिखी हुये वा या आय. <char style="xt"><ref loc="EPH 6:21-22">6:21-22</ref></char></para>
  <para style="ip">इफिसिय की चिठ्ठी खा लिखी हइ हुये? यहूदीया अरु गैरयहूदिहोन को धर्मान्तरित दुन्याहोन, बीच मे तनाम होतो. <char style="xt"><ref loc="ACT 19:23-31">प्रेरित 19:23-31</ref></char> पौलुस यहूदीयाहोन अरु प्रभु यीशु मे जो गैरयहूदिहोन उनकी एकता, बारे मे लिखी हइ. इफिसिय बूरी शक्तिहोन, मूर्तिपुजा प्रतावहोन अरु तंत्र-मंत्र को खे द्र हइ.</para>
  <para style="ip">पौलुस बूरी अरु अंधारी शक्तिहोन से मसीह मे स्वतंत्रता, बारे मे लिखस हइ. उ विश्वासहोन, मार्गदर्शन करस हइ की मसीह यीशु मे अध्यात्मीक कवच, संग बूरी अध्यात्मीक शक्तिहोन से कसो लइना हइ.</para>
  <para style="iot">रुप रेखा</para>
  <para style="io1">1. सुरुवाती नमस्कार <char style="ior"><ref loc="EPH 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. मसीह मे उध्दार को लिये धन्यवाद <char style="ior"><ref loc="EPH 1:3-3:21">1:3—3:21</ref></char></para>
  <para style="io1">3. यहूदीयाहोन अरु गैरयहूदिहोन दो परमेश्वर से समेट <char style="ior"><ref loc="EPH 4:1-6:20">4:1—6:20</ref></char></para>
  <para style="io1">4. एक आंग मे यहूदीयाहोन अरु गैरयहूदीयाहोन को रहस्य <char style="ior"><ref loc="EPH 6:21-24">6:21-24</ref></char></para>
  <chapter number="1" style="c" sid="EPH 1"/>
  <para style="s">अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1"/>पौलुस का तरप से, जो परमेश्वर की इच्छा से मसीह यीशु को प्रेरित हइ,</para>
  <para style="p" vid="EPH 1:1">वे पवित्र अरु मसीह यीशु मे परमेश्वर का दुन्याहोन जो इफिसुस मे हइ<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="ACT 18:19-21">प्रेरित 18:19-21</ref>; <ref loc="ACT 19:1">19:1</ref></char></note><verse eid="EPH 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2"/>हमारो बाप परमेश्वर अरु प्रभु यीशु मसीह का तरफ से तुमखे अनुग्रह अरु शांती मीलती र्‍हिये.<verse eid="EPH 1:2"/></para>
  <para style="s">मसीह मे आत्मीक आशिर्वाद</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3"/>हमारो प्रभु यीशु मसीह को परमेश्वर अरु बाप को धन्यवाद हुये कि वोने हम खे मसीह मे एक होन का वजेसे सब प्रकार की आत्मीक अरु आशीर्वाद दीयो हइ. <verse eid="EPH 1:3"/><verse number="4" style="v" sid="EPH 1:4"/>जसो वोने हमखे जगत की जगत से पैयले वोमे चुनी लीयो कि हम वोको नजर मे पवित्र अरु नीर्दोष हय. <verse eid="EPH 1:4"/><verse number="5" style="v" sid="EPH 1:5"/>अरु अपनी इच्छा का अच्छो अभिप्राय का जसो हमखे अपना लिये पैयले से रुखायो कि यीशु मसीह,</para>
  <para style="p" vid="EPH 1:5">वजेसे हम वोने दंत्क को बेटो अरु बेटी हइ, <verse eid="EPH 1:5"/><verse number="6" style="v" sid="EPH 1:6"/>कि परमेश्वर की महीमा मे अनुग्रह, लिये ओकी महिमा हुये खे क्युकी ओने ओका हम, जो ओको प्रिय बेटा, खुला दिल से दी दियो. <verse eid="EPH 1:6"/><verse number="7" style="v" sid="EPH 1:7"/>हम खे वोमे वो, खुन, वजेसे छुटकारो, मंनजे गुन्हाहोन कि माफी, वोको वु अनुग्रह, जसो मील्यो हइ,<note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="COL 1:14">कुलुस्सियो 1:14</ref></char></note> <verse eid="EPH 1:7"/><verse number="8" style="v" sid="EPH 1:8"/>जेखे ओकी ज्ञान अरु समज, जसो मे हम पर खुप से कर्‍यो. <verse eid="EPH 1:8"/><verse number="9" style="v" sid="EPH 1:9"/>क्युकि वोने अपनी इच्छा को भेद वु अच्छो अभिप्राय, जसो हमखे बतायो, जेने अपना आप मे मसीह मे स्थापित कऱ्यो <verse eid="EPH 1:9"/><verse number="10" style="v" sid="EPH 1:10"/>कि टेमहोन का पुरो होन को असो प्रबन्ध हये कि जो कुछ स्वर्ग हइ अरु जो कुछ जमीन पर हइ, सब कुछ व्हा मसीह मे एकजगा कर्‍हे. <verse eid="EPH 1:10"/><verse number="11" style="v" sid="EPH 1:11"/>वोमे मी जेमे ओकी मनसा से जो अपनी इच्छा का मत का जसो सब कुछ करस हइ, पैयले से रुखायो जकयखे मीरास बन <verse eid="EPH 1:11"/><verse number="12" style="v" sid="EPH 1:12"/>कि हम,जिनने पैयले से मसीह पर आश रखी थी, वोकी महिमा की महिमा कर.<verse eid="EPH 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 1:13"/>अरु ओमे मी तुम पर भी का जब तुम ने उध्दार को सुसमाचार अरु जेका पर तुम ने सच्ची विश्वास कर्यो का प्रतीज्ञा कर्यो हुयो पवित्र आत्मा कि छाप लगी. <verse eid="EPH 1:13"/><verse number="14" style="v" sid="EPH 1:14"/>व्हा वोको मोल लियो हुयो को छुटकारो का लिये हमारी मीरास को ब्यानो हइ, कि वोकी महिमा की स्तुती हय.<verse eid="EPH 1:14"/></para>
  <para style="s">पौलुस की प्रार्थना</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15"/>यो करण, मी भी वु विश्वास को खबर सुनीखे जो तुम दुन्याहोन मे प्रभु यीशु पर हइ अरु सब पवित्र दुन्याहोन पर तुमारो प्रेम हइ, <verse eid="EPH 1:15"/><verse number="16" style="v" sid="EPH 1:16"/>तुम्हारा लिये धन्यवाद करणो नी छोड्यो थो अरु अपनी प्रार्थनाहोन मे तुमखे याद कर्यो करस हय <verse eid="EPH 1:16"/><verse number="17" style="v" sid="EPH 1:17"/>कि हमारो प्रभु यीशु मसीह को परमेश्वर जो महिमा को बाप हइ, तुमखे अपनी पैछान मे ज्ञान अरु प्रकाशन कि आत्मा दि दिये तु ओका अच्छा से जानी सक्ता <verse eid="EPH 1:17"/><verse number="18" style="v" sid="EPH 1:18"/>अरु तुमारो मन की आख ज्योतिर्मय हय कि तुम समजी ले कि वोकीय बुलाहट कि आस, हइ, अरु पवित्र दुन्या मे वोकि मीरास की महिमा, धन करणु हइ, <verse eid="EPH 1:18"/><verse number="19" style="v" sid="EPH 1:19"/>अरु वोकी सामर्थ्य हम मे जो विश्वास करते हइ,त्तो महान हइ,वोकी शक्ति को प्रभाव को वु काम को जसो <verse eid="EPH 1:19"/><verse number="20" style="v" sid="EPH 1:20"/>जो वोने मसीह मे कर्‍यो की ओको मुर्दा मे से जिन्दो हुय खे स्वर्गीय जगा मे अपनो जवना तरप<note caller="+" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="PSA 110:1">भजन संहिता 110:1</ref></char></note> <verse eid="EPH 1:20"/><verse number="21" style="v" sid="EPH 1:21"/>सब प्रकार को प्रधानता,अरु अधिकार, अरु हर एक नाम, उपर, चाह्ये यो जमाना, यो आन आलो जमाना खे. <verse eid="EPH 1:21"/><verse number="22" style="v" sid="EPH 1:22"/>उनने सब कुछ उनका आधीन करी दियो अरु मंडली, लिये सभ चिजहोन, शिरोमणी रोखी दियो.<note caller="+" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="PSA 8:6">भजन संहिता 8:6</ref></char></note> <verse eid="EPH 1:22"/><verse number="23" style="v" sid="EPH 1:23"/>मंडली, जो उनका आंग, उनकी पुरो हइ, जो सब मे सब कुछ भरी खे करस हइ.<verse eid="EPH 1:23"/></para>
  <chapter eid="EPH 1"/>
  <chapter number="2" style="c" sid="EPH 2"/>
  <para style="s">मरना से जिवन तक</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1"/>तुम अपनो अपराधहोन अरु पाप मे मर्‍या हुया था, <verse eid="EPH 2:1"/><verse number="2" style="v" sid="EPH 2:2"/>जिनमे तुम पैयले यो जगत, बुरी रस्ता पर चलता था अरु बद्दल का अधिकार को शाशक मंनजे उ आत्मा, जसो जी रो ,थो जो आत्मा अब भी आज्ञा नी माननाआला मे काम करी रास हइ <verse eid="EPH 2:2"/><verse number="3" style="v" sid="EPH 2:3"/>ये मे जब हम भी जन पैयले अपना आंग की बुरी सोच मे दिन बितय रा था, अरु आंग अरु मन की अभिलाषाहोन खे पूरी करणे मे लग्यो अरु दुसरा दुन्याहोन का सामने संभव से ही घुस्सा का बच्चाहोन था<verse eid="EPH 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4"/>पन दया मी धनी परमेश्वर ने अपना उपर प्रिय को करण, <verse eid="EPH 2:4"/><verse number="5" style="v" sid="EPH 2:5"/>जब हम अपनो अपराधहोन मी मर्‍यो हुए थो, मसीह मी हम जिन्दो कर्‍यो उध्दार तुमखे अनुग्रह ही से मील्यो हुयो हइ. <verse eid="EPH 2:5"/><verse number="6" style="v" sid="EPH 2:6"/>परमेश्वर ने हम मसीह यीशु मे जिन्दो कर्‍या अरु स्वर्गीय राज्य मी उनका साथ बठ्यो. <verse eid="EPH 2:6"/><verse number="7" style="v" sid="EPH 2:7"/>कि वु आन आलो टेम मेहोन मी अपना अनुग्रह खे अच्छो धन मसीह यीशु मे हमारो लिये करी गइ कृपा ही दिखी सक्ये. <verse eid="EPH 2:7"/><verse number="8" style="v" sid="EPH 2:8"/>क्युकि अनुग्रह ही से, विश्वास का वजेसे तुम उध्दारमील्यो हुयो हइ. येका करण तुम नी, यो परमेश्वर को वर दान हइ <verse eid="EPH 2:8"/><verse number="9" style="v" sid="EPH 2:9"/>अरु यो काम होन को प्रतीफल नी हइ कि कोय घमण्ड कर्‍ये. <verse eid="EPH 2:9"/><verse number="10" style="v" sid="EPH 2:10"/>क्युकि हम परमेश्वर वजेसे पैयले से रोख्यो हुयो अच्छो काम का लिये यीशु मसीह मे रच्यो गयो परमेश्वर की रचना हइ कि हम या अंच्छो काम को स्वभाव कर्‍हे.<verse eid="EPH 2:10"/></para>
  <para style="s">मसीह मे एक</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11"/>येका लिये याद रख कि तुम जो अपनो जन्म से गैरयहूदि जिन खे खतनाआला दुन्या खतनारहित बोलस हइ खतना, जो आंग मे इन्सान वजेसे कर्‍यो जास हइ <verse eid="EPH 2:11"/><verse number="12" style="v" sid="EPH 2:12"/>याद रख तुम वा टेम जगत मे मसीह से अलग, इस्राएल की नागरिकता से नीकल्यो गया, प्रतीज्ञा की वाचाहोन से बिनासमजन नी था, आस हीन अरु परमेश्वर से रहित था. <verse eid="EPH 2:12"/><verse number="13" style="v" sid="EPH 2:13"/>एक टेम थी जब तुम दूर था, पन अब मसीह यीशु मे उनको खुन का वजसे नजीक लायो गयो हय. <verse eid="EPH 2:13"/><verse number="14" style="v" sid="EPH 2:14"/>वु खुद हमारो मीलनो हइ, क्युकि उनने अपना आंग मे दो गटहोन का बीच की दीवाल खे ढय खे दो खे एक करी दियो. <verse eid="EPH 2:14"/><verse number="15" style="v" sid="EPH 2:15"/>वह उनने आदेस की व्यवस्था जिनकी आज्ञाहोन विधीहोन की रीति पर थी मीटकय दी कि इनका वजेसे वु खुद मी वे दो, जगा पर एक ननवो इन्सान खे बन खे कर मीलनो जुलनो की बठाड्यो कर <verse eid="EPH 2:15"/><verse number="16" style="v" sid="EPH 2:16"/>अरु क्रुस का वजेसे एक आंग मे हम दो को परमेश्वर से मीलनो जुलनो करी सक्हे कि दुसमनी खतम करी जय सक्हे. <verse eid="EPH 2:16"/><verse number="17" style="v" sid="EPH 2:17"/>वु आयो अरु उनने, जो दूर था अरु उनने भी, जो नजीक था, शांती की खुसखबर सुनइ. <verse eid="EPH 2:17"/><verse number="18" style="v" sid="EPH 2:18"/>क्युकि उन मे हुयखे एक ही आत्मा मे दो ही की पहुच्यो बाप परमेश्वर तक हइ.<verse eid="EPH 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19"/>येका लिये आब तुम नवाडो अरु मूसा फिर नी पन परमेश्वर, पवित्र दुन्या का साथ सब नागरीक अरु परमेश्वर को परिवार को हय, <verse eid="EPH 2:19"/><verse number="20" style="v" sid="EPH 2:20"/>अरु प्रेरितहोन अरु भविष्यव्दक्ताहोन कि पय्या पर,जो कोना को फत्तर मसीह यीशु खुद ही हइ, बनायो गयो हय. <verse eid="EPH 2:20"/><verse number="21" style="v" sid="EPH 2:21"/>जिनमे सब भवन-रचना एक साथ मीलीखे प्रभु का लिये पवित्र मन्‍दिर होन, लिये बडती जास हइ. <verse eid="EPH 2:21"/><verse number="22" style="v" sid="EPH 2:22"/>जिन मे तुम सब परमेश्वर का र्‍हेन की जगा होन, लिये पवित्रा आत्मा वजेसे संयोजित कर्यो जातो हुये बनायो जय रो हय.<verse eid="EPH 2:22"/></para>
  <chapter eid="EPH 2"/>
  <chapter number="3" style="c" sid="EPH 3"/>
  <para style="s">गैरयहूदीहोन मे पौलुस की सेवा</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1"/>येका लिये मी पौलुस परमेश्वर से प्रार्थना करुस हय,तुम गैरयहूदिहोन, लिये मसीह यीशु को बन्दी हुये. <verse eid="EPH 3:1"/><verse number="2" style="v" sid="EPH 3:2"/>अगर तुम ने परमेश्वर को अनुग्रह को प्रबन्ध का बारे मे सुन्यो हइ, जो तुमारा लिये प्रदान कऱ्यो गयो <verse eid="EPH 3:2"/><verse number="3" style="v" sid="EPH 3:3"/>अगर वो भेद, जो मरा पर प्रकाशन का वजेसे प्रकट कऱ्यो गयो, जेको संक्षेप मे वर्णन मी पैयले करी चुक्यो हुये. <verse eid="EPH 3:3"/><verse number="4" style="v" sid="EPH 3:4"/>जेखे तुम पडतो समजी सकस हुये की मी मसीह मे व्हा को भेद का बारे मे खा समझ सकस हय, <verse eid="EPH 3:4"/><verse number="5" style="v" sid="EPH 3:5"/>जो मानवजात पर अन्य पीडीहोन मे या प्रकार प्रकट नी कऱ्यो गयो थो, जो प्रकार आत्मा अब प्रभु को पवित्र प्रेरितहोन तथा भविष्यव्दक्ताहोन पर पवित्राआत्मा प्रकट कऱ्यो गयो हइ <verse eid="EPH 3:5"/><verse number="6" style="v" sid="EPH 3:6"/>मंनजे ह्या की यीशु मसीह भि सुसमाचार का वजेसे गैरयहूदीहोन मसीह यीशु मे मीरास, साझो, ही शरीर को अरु प्रतीज्ञा को हिस्सेदार हइ.<verse eid="EPH 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7"/>मी परमेश्वर खे अनुग्रह को उ दान मे ओकी सक्रिया जो ओकि सामर्थ्य को प्रभाव का जसो जो मेखे दियो गयो, उ खुसखबर को सेवक बन्यो. <verse eid="EPH 3:7"/><verse number="8" style="v" sid="EPH 3:8"/>मेखे जो पवित्र दुन्या मे छोटा से भी छोटो हय, गैरयहूदिहोन मे मसीह को अगम्य धन को सुसमाचार का लिये यो अनुग्रह प्रदान कऱ्यो गयो <verse eid="EPH 3:8"/><verse number="9" style="v" sid="EPH 3:9"/>अरु सब पर ह्या बात सब, सामे कर्‍हयु कि उ भेद को प्रबन्ध को हइ सब को सृजनहार परमेश्वर मे जामानासे मील्यो थो <verse eid="EPH 3:9"/><verse number="10" style="v" sid="EPH 3:10"/>ताकी अब बय मंडली का वजेसे परमेश्वर को अलग प्रकार को ज्ञान आकाशमण्डल को बडो अरु अधिकारीहोन पर प्रकट कऱ्यो जाये. <verse eid="EPH 3:10"/><verse number="11" style="v" sid="EPH 3:11"/>यो उ सनातन उध्देश्य को जसो हुयो, जो परमेश्वर ने मसीह यीशु हमारो प्रभु मे पुरो कऱ्यो थो, <verse eid="EPH 3:11"/><verse number="12" style="v" sid="EPH 3:12"/>प्रभु मे हम विश्वास, वजेसे आना का लिये हमखे साहस तथा भरोसो मीलस हुयो हइ <verse eid="EPH 3:12"/><verse number="13" style="v" sid="EPH 3:13"/>येका लिये तुमारा से मरी यो प्रार्थना हइ कि तुम उ सतान कारन, जो मी तुमारा लिये रोस हुये खे घुस्सा नी होनु. क्युकी वे तुमारी महिमा हुये.<verse eid="EPH 3:13"/></para>
  <para style="s">पौलुस की प्रार्थना</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14"/>मी यो कारन हइ की मी बाप का सामने टोगर्‍या टेकुस हुये खे <verse eid="EPH 3:14"/><verse number="15" style="v" sid="EPH 3:15"/>जेमे स्वर्ग अरु पृथ्वी पर हर एक कुल को नाम रख्यो जास हइ <verse eid="EPH 3:15"/><verse number="16" style="v" sid="EPH 3:16"/>की वो अपनी महिमा ओकी आत्मा से अपनी महीमा को धन का जसो तुमखे यो दान दी कि तुम ओकि आत्मा से अपना अन्दर इन्सान मे सामर्थ्य मीलीखे शक्तिहुय जाव, <verse eid="EPH 3:16"/><verse number="17" style="v" sid="EPH 3:17"/>कि विश्वास का वजेसे मसीह तुमारो दिल मे वास कर कि प्रेम मे करिखे व्हा पय्या डाली खे, <verse eid="EPH 3:17"/><verse number="18" style="v" sid="EPH 3:18"/>तुम सब पवित्र मसीह को प्रेमकि लम्बाइ, चौडाइ, उचाइ व गहराइ को भली-भाति समझ सक्यो <verse eid="EPH 3:18"/><verse number="19" style="v" sid="EPH 3:19"/>अरु मसीह को उ प्रेम को जान सक्यो, जो ज्ञान से परे हइ की परमेश्वर कि सब भरपुरी तुमने स्थापित हुये जाये<verse eid="EPH 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20"/>अब जो असो सामर्थ्यी हइ कि हमारी प्रार्थना अरु समज से कोय जादा काम करी सकस हइ, उ सामर्थ्य का जसो जो हम मे काम करस हइ, <verse eid="EPH 3:20"/><verse number="21" style="v" sid="EPH 3:21"/>हमारा मे यो टेम सक्रिय सामर्थ्य का वजेसे मंडली अरु मसीह यीशु मे ओकी महिमा बडी से बडी हमेशा-सर्वदा होस ऱ्हेस. आमीन.<verse eid="EPH 3:21"/></para>
  <chapter eid="EPH 3"/>
  <chapter number="4" style="c" sid="EPH 4"/>
  <para style="s">मसीह कि आंग कि एकता</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1"/>येका लिये मी, जो प्रभु का लिये बन्दी हूये खे तरा से अरु प्रार्थना करुस हय कि तुम्हारी जीवन शैली तुम्हारा बुलाना का अनुरुप हइ <verse eid="EPH 4:1"/><verse number="2" style="v" sid="EPH 4:2"/>तुम मे विशुद्ध विनम्रता, सौम्यता अरु धीरज का एक दुसरा मे प्रेम मे सहन को भाव भरी जाए. <verse eid="EPH 4:2"/><verse number="3" style="v" sid="EPH 4:3"/>अरु मेल को बन्धन मे आत्मा कि एक रखन को यत्न कर. <verse eid="EPH 4:3"/><verse number="4" style="v" sid="EPH 4:4"/>एक ही आंग हइ अरु एक ही आत्मा जेमे तुम्ह बुलायो गया था अपना बुलायो जाना से एक ही आस हइ. <verse eid="EPH 4:4"/><verse number="5" style="v" sid="EPH 4:5"/>एक ही प्रभु, एक ही विश्वास, एक ही बपतिस्मा <verse eid="EPH 4:5"/><verse number="6" style="v" sid="EPH 4:6"/>अरु सब मानवजाति, बाप हय, जो सब, उपर, सब का बीच अरु सब मे एक ही परमेश्वर हइ.<verse eid="EPH 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7"/>पन हमने से हर एक खे मसीह को वरदान को परिमाण, जसो अनुग्रह प्रदान कर्‍यो गया हइ, <verse eid="EPH 4:7"/><verse number="8" style="v" sid="EPH 4:8"/>येका लिये व्हा बोलस हइ,</para>
  <para style="q1" vid="EPH 4:8">जब व्हा सबसे उच्चा पर चडी गयो,</para>
  <para style="q2" vid="EPH 4:8">बन्दिहोन खे बन्दी बनय खे ली गया अरु</para>
  <para style="q2" vid="EPH 4:8">उनने इन्सान खे दान दियो.<verse eid="EPH 4:8"/></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9"/>ओका चडना से, अरु का अर्थ मील्यो जास हइ फक्त यो कि व्हा जमीन का नीच्चे कि जगा मे उतार्‍यो भी थो. <verse eid="EPH 4:9"/><verse number="10" style="v" sid="EPH 4:10"/>स्वर्ग से जो नीचे उतर्‍यो, उ हइ, जो उच्ची जगा मे बडो सम्मान का साथ चड्या कि सब सृष्टि को पूरोपूरो करी दे. <verse eid="EPH 4:10"/><verse number="11" style="v" sid="EPH 4:11"/>उनने मंडली खे कुछ प्रेरित, कुछ भविष्यव्दक्ता का कुछ इश्वरी सुसमाचार सुनानवाआलो अरु कुछ मंडली को रखवाली उपदेशक प्रदान कर्‍यो <verse eid="EPH 4:11"/><verse number="12" style="v" sid="EPH 4:12"/>कि पवित्र सेवा, लिये सुसज्जित कर्‍यो जाह्ये का कि मसीह का आंग उन्नती बडती जाये. <verse eid="EPH 4:12"/><verse number="13" style="v" sid="EPH 4:13"/>जब तक हम सब खे विश्वास अरु परमेश्वर को बेटो खुप, भोत ज्ञान की एक उपलब्ध नी हुय जाह्ये सिद्ध इन्सान का जसो जो मसीह को सब डील-डौल हइ. <verse eid="EPH 4:13"/><verse number="14" style="v" sid="EPH 4:14"/>तब हम बच्चा नी र्‍हियेका जो समुद्री लहर जसो इधर-उधर उछले वु फेक्यो जाह्ये अरु इन्सानहोन की ठग विद्या की तुफान अरु इन्सान की हुशारी वजेसे बोहायो जास हइ. <verse eid="EPH 4:14"/><verse number="15" style="v" sid="EPH 4:15"/>पर सच्चय खे प्रेम पूर्वक व्यक्त करते हुयो हर एक तरप मे हमारा उन्नती उनमे होते जायेका जो प्रधान हइ मंनजे मसीह, <verse eid="EPH 4:15"/><verse number="16" style="v" sid="EPH 4:16"/>जिनका वजेसे सब आंग मे उन्नती का वजेसे जमा करीखे अरु एक साथ मीलीखे प्रेम मे काम मे होते जास हइ क्युकि हर एक आंग अपनो तय कर्‍यो गया काम ठीक-ठाक करते जास हइ.<verse eid="EPH 4:16"/></para>
  <para style="s">मसीह मे नवो जिवन</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17"/>येका लिए मी प्रभु का साथ पुष्टि करते हुयो तुमारो विनती का साथ बोलुस हय कि अब तुम्हारो स्वभाव गैरयहूदीहोन का जसो खोकलो मन की रीति से प्रेरित नी हय. <verse eid="EPH 4:17"/><verse number="18" style="v" sid="EPH 4:18"/>उनका मन की कठुरता से अज्ञानता कारन वे परमेश्वर को जिवन से अलग हइ अरु उनकी बुद्धि अंधारो हुय गयो हइ, <verse eid="EPH 4:18"/><verse number="19" style="v" sid="EPH 4:19"/>सुन्न हुयखे उनने खुद खे लोभी से बोहय खे सब रंग की अपवित्र अरु लालुच का अधीन करी दियो हइ.<verse eid="EPH 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20"/>मसीह का बारे मे असी शिक्षा तुमखे नी दी गइ थी. <verse eid="EPH 4:20"/><verse number="21" style="v" sid="EPH 4:21"/>अगर वास्तव मे तुमने उनका विषय मे सुन्यो अरु उनकी शिक्षा को अपनय ली हय, जो मसीह यीशु मे सच्ची को अनुरुप हइ. <verse eid="EPH 4:21"/><verse number="22" style="v" sid="EPH 4:22"/>येकालिये अपनो जुन्नो चाल-चलन से प्रेरित स्वभाव खे छोडी दे, जो छल की लालुच कारन भ्रष्ट होते रर्‍हेस हइ <verse eid="EPH 4:22"/><verse number="23" style="v" sid="EPH 4:23"/>कि तुम्हारा मन को आत्मीक नवो हुय जाये. <verse eid="EPH 4:23"/><verse number="24" style="v" sid="EPH 4:24"/>नवो स्वभाव खे पेनी लियो, जेकी रचना धार्मीकता अरु पवित्रता मे परमेश्वर को स्वरुप मे हुयो हइ.<verse eid="EPH 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25"/>येका लिये झूठ खे छोडी खे, हर एक इन्सान अपना बाजुआला से सच्ची य बोल क्युकि हम एक ही आंग को भाग हइ. <verse eid="EPH 4:25"/><verse number="26" style="v" sid="EPH 4:26"/>घुस्सा तो कर, पन पाप मत कर. सुरज डुबना तक तुम्हारी घुस्सा नी र्‍हेन कि. <verse eid="EPH 4:26"/><verse number="27" style="v" sid="EPH 4:27"/>सैतान के कोय मौको नी दे. <verse eid="EPH 4:27"/><verse number="28" style="v" sid="EPH 4:28"/>व्हा, जो चोरी करते र्‍हियो हइ, अब चोरी नी कर्‍हे पर मेहनत कर्‍हे कि व्हा अपना हात से कर्‍यो गयो अच्छो काम का वजेसे दुसरा दुन्या की भी मदत करी सकस, जेन कोय रंग की जरुरत हइ. <verse eid="EPH 4:28"/><verse number="29" style="v" sid="EPH 4:29"/>तुम्हारो मेडा से कोय अब शब्द नी पन असो वचन निकाले, जो अवसर को अनुकूल, दुसरा का लिये उन्नती को करण अरु सुननेवाला का लिये अच्छो हय. <verse eid="EPH 4:29"/><verse number="30" style="v" sid="EPH 4:30"/>परमेश्वर की पवित्र आत्मा खे दुख नी करणु, जिनका वजेसे तोखे छुटकारो को देना का लिये छाप दी गय हइ. <verse eid="EPH 4:30"/><verse number="31" style="v" sid="EPH 4:31"/>सब रंग की कडवी, रोष, घुस्सा, वाद विवाद, टिंगल, आक्रोश अरु दुजा-भाव खे खुद से अलग करी दे. <verse eid="EPH 4:31"/><verse number="32" style="v" sid="EPH 4:32"/>एक दूसरा, पर दयालु अरु सहृदय बन्यो रह्ये अरु एक-दूसरा खे उ रंग माफ कर जो रंग परमेश्वर ने मसीह मे तुमखे माप कर्‍यो हइ.<verse eid="EPH 4:32"/></para>
  <chapter eid="EPH 4"/>
  <chapter number="5" style="c" sid="EPH 5"/>
  <para style="s">दिव्वा मे होनु</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1"/>परमेश्वर को लाडका बच्चा होन का नाता, तुम परमेश्वर का पीछे चलनआलो बन. <verse eid="EPH 5:1"/><verse number="2" style="v" sid="EPH 5:2"/>तुम्हारो स्वभाव प्रेम से र्‍हेव, जो रंग से मसीह ने तुमसे प्रेम कर्‍यो हइ. व्हा हमारा लिये परमेश्वर का सामने खुद मनमोहन गधानआलो चडयो अरु बलि हुय गयो.<verse eid="EPH 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3"/>जसो कि पवित्र दुन्या का लिये बरोबर हइ, तुम्हारा बीच कोय भी अपवित्र रंग को लोभी को वर्णन तक नी हय. <verse eid="EPH 5:3"/><verse number="4" style="v" sid="EPH 5:4"/>अरु नी हय तुम्हारा बीच बिना लाजवाने अरु मूर्खता भरी बातचीत या असली मजाक हय, जो हमेशा ही व्यर्थ हइ पन तुम्हारा बीच धन्यवाद ही सुनायो जाह्ये <verse eid="EPH 5:4"/><verse number="5" style="v" sid="EPH 5:5"/>क्युकि तुम या अच्छी रीति से समजस हय कि कोय भी व्यभिचारी, मलिन अरु लोभी इन्सान कि जो मूर्तिपूजक ही हइ, मसीह अरु परमेश्वर का राज मे मीरास नी हइ.<verse eid="EPH 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6"/>कोय तुमखे व्यर्थ की बात की जाल मे नी फसी मील्हे क्युकि या सबको करण अनाज्ञाकारी इन्सान परमेश्वर की घुस्सा को भागी होस हइ. <verse eid="EPH 5:6"/><verse number="7" style="v" sid="EPH 5:7"/>येका लिये उनको हिस्सेदार नी बन्यो. <verse eid="EPH 5:7"/><verse number="8" style="v" sid="EPH 5:8"/>येका पयलो तुम अंधारामे था, मगर अब प्रभु मे उजालो हय. येका लिये उजाला का बच्चा का जसा चल. <verse eid="EPH 5:8"/><verse number="9" style="v" sid="EPH 5:9"/>क्युकि उजालो का धार्मीकता को फल सब रंग को अच्छो न्‍यायी, सदाचार अरु सच्ची मे हइ. <verse eid="EPH 5:9"/><verse number="10" style="v" sid="EPH 5:10"/>अरु ह्या देख्यो कि प्रभु खे पसन्द हइ. <verse eid="EPH 5:10"/><verse number="11" style="v" sid="EPH 5:11"/>अंधारा का महिनत काम मे सामील नी हुये क्युकी उन पर उलाहन देस. <verse eid="EPH 5:11"/><verse number="12" style="v" sid="EPH 5:12"/>व्हा उनका गुप्त काम कि चर्चा भि लाज कि बात करस. <verse eid="EPH 5:12"/><verse number="13" style="v" sid="EPH 5:13"/>पर जेत्तो काम पर उलाहन दियो जाये कि वे सब दिव्वो से प्रगट होस हुए क्युकि वे सब कुछ खे प्रगट करस हइ उ दिव्वो हइ. <verse eid="EPH 5:13"/><verse number="14" style="v" sid="EPH 5:14"/>येका लिये की वु बोलस हइ</para>
  <para style="q1" vid="EPH 5:14">हे सोनआला,</para>
  <para style="q2" vid="EPH 5:14">जाग उन मुर्दा मे से जिन्दो उट.</para>
  <para style="q2" vid="EPH 5:14">वे मसीह कि दिवा तरा पर चमकीये.<verse eid="EPH 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15"/>येका लिये ध्यान से देखनु. कि कसी चाल चलास वे बिनाबुध्दी, समान नी पर अक्कलआला, समान चलास. <verse eid="EPH 5:15"/><verse number="16" style="v" sid="EPH 5:16"/>अवसर खे किमती समझे किक्यु दिन बुरा हइ. <verse eid="EPH 5:16"/><verse number="17" style="v" sid="EPH 5:17"/>एका लिये बिनाबुध्दी नी हो पर ध्यान से समजिओ कि प्रभु कि इच्छा का हइ.<verse eid="EPH 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18"/>अंगूर रस से मतवालो नी बनीयो क्युकि असो लुच्चोपना होस हइ, वे पर आत्मा से पुरो होते जास. <verse eid="EPH 5:18"/><verse number="19" style="v" sid="EPH 5:19"/>अरु आसपास मे भक्ती को गिद अरु आत्मीक गिद गयो कर, अरु अपनो अपनो मन मे प्रभु का सामने गातो अरु किर्तन करते र्‍हे. <verse eid="EPH 5:19"/><verse number="20" style="v" sid="EPH 5:20"/>अरु कभी भी सब का लिये हमरो प्रभु यीशु मसीह को नाम से परमेश्वर बाप को धन्यवाद करतो र्‍हेस.<verse eid="EPH 5:20"/></para>
  <para style="s">लोग अरु लुगय</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21"/>मसीह का डर से एक दुसरा का सात र्‍हेनु.<verse eid="EPH 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22"/>हे लुगेनहोन,अपना अपना अदमी को असो अधीन रेस जसो प्रभु को. <verse eid="EPH 5:22"/><verse number="23" style="v" sid="EPH 5:23"/>क्युकी अदमी लुगेन को माथो हइ जसो की मसीह मंडली को माथो हइ अरु स्वयं ही आंग को उद्धारकर्ता हइ. <verse eid="EPH 5:23"/><verse number="24" style="v" sid="EPH 5:24"/>पर जसो मंडली मसीह को अधीन हइ वोसो ही लुगेन भी हर बात मे अपना अपना अदमी, सात मे रेस.<verse eid="EPH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25"/>हे लोगहोन, अपनी अपनी लुगय से प्रेम रख जसो मसीह ने भी मंडली से प्रेम कर अपना आप खे ओका लिये दि दियो. <verse eid="EPH 5:25"/><verse number="26" style="v" sid="EPH 5:26"/>कि वोको वचन का वजेसे पानी से अच्छो करीखे पवित्र बनह्ये, <verse eid="EPH 5:26"/><verse number="27" style="v" sid="EPH 5:27"/>अरु वोखे एक असी तेजस्वी मंडली बनयखे अपना पास खडो कर्‍हे, जमे नीष्कलंक, नी झुरी नी कोय अरु असो चिज हय क्युकी पवित्र अरु नीर्दोस हय. <verse eid="EPH 5:27"/><verse number="28" style="v" sid="EPH 5:28"/>यो रंग अच्छो हइ कि लोग अपनी अपनी लुगय से अपनी आंग का जसो प्रेम रख. जो अपनी लुगय से प्रेम रखस हइ, व्हा अपनो आप से पिरेम रखस हइ. <verse eid="EPH 5:28"/><verse number="29" style="v" sid="EPH 5:29"/>क्युकि कोय ने कभी आंग से फरक नी रख्यो क्युकि ओको पाल्यो पोषण करस हइ, जसो मसीह भी मंडली को करस हइ. <verse eid="EPH 5:29"/><verse number="30" style="v" sid="EPH 5:30"/>येका लिये कि हम ओकी आंग को भाग हइ. <verse eid="EPH 5:30"/><verse number="31" style="v" sid="EPH 5:31"/>यो कारन इन्सान अपना माय बाप खे छोडी खे अपनी लुगय से मील्यो र्‍हियो, अरु वे दो एक जान हुया. <verse eid="EPH 5:31"/><verse number="32" style="v" sid="EPH 5:32"/>यो भेद बडो हइ, पर मी यो मसीह अरु मंडली, बारे मे बोलस हय. <verse eid="EPH 5:32"/><verse number="33" style="v" sid="EPH 5:33"/>पर तुम मे से हर एक अपनी लुगय से अपना सामने प्रेम रख, अरु लुगय भी अपनो लोग को डर माननु.स<verse eid="EPH 5:33"/></para>
  <chapter eid="EPH 5"/>
  <chapter number="6" style="c" sid="EPH 6"/>
  <para style="s">माय बाप अरु बच्चा</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1"/>हे बच्चाहोन प्रभु मे अपना माय बाप का आज्ञाकारी बन किक्यु यो सही हइ. <verse eid="EPH 6:1"/><verse number="2" style="v" sid="EPH 6:2"/>अपना माय अरु बाप को आदर करणु पहिली आज्ञा हइ जेका साथ प्रतीज्ञा भि हइ. <verse eid="EPH 6:2"/><verse number="3" style="v" sid="EPH 6:3"/>कि तरो अच्छो हुये अरु तु जमीन पर भोत दिन जिन्दो रीये.<verse eid="EPH 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4"/>हे बच्चावाला, अपना बच्चा के त्रास नी दिलानु पन प्रभु कि शिक्षा अरु चेतावनी देते हुये उनको पालन पोषण करणु.<verse eid="EPH 6:4"/></para>
  <para style="s">स्वामी अरु दस</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5"/>हे सेवकहोन जो लोगहोन यो जगत मे तुम्हारा स्वामी हइ, अपना मन की सीधाइ से डरस अरु कापते हुयो, जसो मसीह की वसो हि उनकी भी आज्ञा माननु. <verse eid="EPH 6:5"/><verse number="6" style="v" sid="EPH 6:6"/>इन्सान के प्रसन्न करणवालो का समान दिखन का लिये सेवा मत करणु पर मसीह का सेवक का समान मन से परमेश्वर की इच्छा पर चलनु. <verse eid="EPH 6:6"/><verse number="7" style="v" sid="EPH 6:7"/>अरु वा सेवा होन के इन्सान की नी पन प्रभु के जानीके सच्चा दिल से करणु. <verse eid="EPH 6:7"/><verse number="8" style="v" sid="EPH 6:8"/>किक्यु तुम जानता हुये कि जो कोइ जसो अच्छो काम करीये चाह्ये सेवक हुये चाह्ये स्वतंत्रता, प्रभु से वसो ही मील्हे.<verse eid="EPH 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9"/>हे स्वामीहोन, तुम भी धमकिहोन देनो छोडी खे उनका साथ वोसो ही व्यवहार करणु. किक्यु तुम जानता हये कि उन को अरु तुम्हारो दोय को स्वामी स्वर्ग मे हइ अरु वे कोय को भाग नी लिये.<verse eid="EPH 6:9"/></para>
  <para style="s">वाद विवाद को हथियार</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10"/>येका लिये प्रभु मे अरु ओकी शक्ति का प्रभाव मे बलवान बनानु. <verse eid="EPH 6:10"/><verse number="11" style="v" sid="EPH 6:11"/>परमेश्वर का सब हथियार बाधी लेनु कि तुम सैतान कि युक्तिहोन का सामने खडो र्हेनु सिखनु. <verse eid="EPH 6:11"/><verse number="12" style="v" sid="EPH 6:12"/>क्युकि हमारो यो मल्ल वाद विवाद खुन अरु मास से नी पन प्रधानहोन से, अरु अधिकारीहोन से, अरु यो जगत के अंधारा का शासकहोन से, अरु वा बुरी आत्मीक सेनाहोन से हइ जो बद्दल मे हइ. <verse eid="EPH 6:12"/><verse number="13" style="v" sid="EPH 6:13"/>येका लिये परमेश्वर को सब हथियार बाधीकि ले तुम बुरो दिन मे सामने खे सब खे, अरु सब कुछ पुरो करीखे थामी र्‍हिखे सब.<figure style="fig" alt="Roman soldier" file="LB00196C.TIF" size="col" copy="Horace Knowles ©" ref="6:10">रोमन सैनीक</figure><verse eid="EPH 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 6:14"/>येका लिये सच्ची से अपनी कमंर कसीखे, धार्मीकता की झिल पेनी खे, <verse eid="EPH 6:14"/><verse number="15" style="v" sid="EPH 6:15"/>अरु पाय मे मैल को सुसमाचार कि तैयारी कि जुता पेनी खे. <verse eid="EPH 6:15"/><verse number="16" style="v" sid="EPH 6:16"/>अरु या सब का सात लिखे रुख्यो र्‍हे जेम्मे तुम वा बुरो सब जलते हुयो तीरी खे बुझय सक्हे. <verse eid="EPH 6:16"/><verse number="17" style="v" sid="EPH 6:17"/>अरु उध्दार कि टोपी, अरु आत्मा कि तलवार, जो परमेश्वर को वचन हइ, लि ले. <verse eid="EPH 6:17"/><verse number="18" style="v" sid="EPH 6:18"/>हर टेम अरु हर रंग से आत्मा मे प्रार्थना, अरु प्रार्थना करते र्‍हे. <verse eid="EPH 6:18"/><verse number="19" style="v" sid="EPH 6:19"/>अरु मरा लिये भी कि मेखे बोलन का टेम एसो प्रबल वचन दियो जाह्ये कि मी साहास का सात सुसमाचार को भेद बतय सकू, <verse eid="EPH 6:19"/><verse number="20" style="v" sid="EPH 6:20"/>जेका लिये मी साकल से जकडय हुयो राजदूतहय. अरु यो भी कि मी वोको बारे मे जसो मेखे होनु साहासे बोल्हु.<verse eid="EPH 6:20"/></para>
  <para style="s">आखरी अभिवादन</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21"/>तुखिकुस, जो प्रिय भैइ अरु प्रभु मे विश्वासयोग्य सेवक हइ, तुम सब बात बताह्ये कि तुम भी मर दशा जानी कि मी कसो र्‍हियु हइ. <verse eid="EPH 6:21"/><verse number="22" style="v" sid="EPH 6:22"/>उनखे मे ने तुम्हारा पास येका लिये भेज्योस हइ कि तुम मरी दशा खे समजनु, अरु व्हा तुम्हारो मन कि शांती दे.<verse eid="EPH 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23"/>परमेश्वर बाप अरु प्रभु यीशु मसीह की तरप से भैइहोन खे शांती अरु विश्वास सहीत प्रेम मील्हे. <verse eid="EPH 6:23"/><verse number="24" style="v" sid="EPH 6:24"/>जो हमारो प्रभु यीशु मसीह से सच्ची प्रेम रखस हइ, वे सब पर अनुग्रह होतो र्‍हे.<verse eid="EPH 6:24"/></para>
  <chapter eid="EPH 6"/>
</usx>
