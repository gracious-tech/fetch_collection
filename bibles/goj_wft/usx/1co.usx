<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Gowlan</book>
  <para style="h">कुरिन्थियो</para>
  <para style="toc3">1 कुरिन्थिहोन</para>
  <para style="toc2">1 कुरिन्थिहोन</para>
  <para style="toc1">1 कुरिन्थिहोन का नाम पौलुस प्रेरित की पैयली चिठ्ठी</para>
  <para style="mt2">1 कुरिन्थियो खे नाम पौलुस प्रेरित की चिठ्ठी</para>
  <para style="mt1">1 कुरिन्थिहोन का नाम पौलुस प्रेरित की चिठ्ठी</para>
  <para style="imt">पैछान</para>
  <para style="ip">कुरिन्थिहोन का नाम पौलुस प्रेरितने यीशु मसीह को जन्म नजिक पास 55 सा बाद लिख्यो थो 1:1. ह्या हमारा पास मौजूद दो चिठ्ठ मे से पहिली हइ जो पौलुस ने कुरिन्थि मे मंडली खे लिखी थी.भोत बडो उनने या चिठ्ठी मैसेडोनीया आन जान कि रास्ता मे कुरिन्थि की अपनी इच्छित जत्रा से पहिले इफिसुस मे र्हेन का टेम मे लिखी थी <char style="xt"><ref loc="1CO 16:5-9">16:5-9</ref></char></para>
  <para style="ip">या चिठ्ठी वा रिपोर्टों की काम की हइ जो पौलुस कि मंडली खे कुछ सदस्यहोन से मंडली मे भाबाटनो अरु यौन अनैतिकता सात बडा सुदरन का बारे मे मीली थी. कोरिंथ शहर अपनी यौन अनैतिकता का लिये मसुर थो इसलिये यो आश्चर्य की बात नी हइ कि व्हा कि मंडली या मुद्दा का जसो करी रा था. <char style="xt"><ref loc="1CO 13">1 कुरिन्थिहोन 13</ref></char> मे प्रेम पर प्रसिद्ध भी शामील हइ</para>
  <para style="iot">रुप रेखा</para>
  <para style="io1">1. पौलुस कुरिन्थिहोन खे नमस्कार करस हइ अरु उनका लिये प्रभु को धन्यवाद देस हइ <char style="ior"><ref loc="1CO 1:1-9">1:1-9</ref></char>.</para>
  <para style="io1">2. फिर व्हा वे रिपोर्टों को बताया करता हइ जो ओका कोरिंथियन मंडली मे बाटन का लिये का बारे मे मीली थी <char style="ior"><ref loc="1CO 1:10-4:21">1:10—4:21</ref></char>.</para>
  <para style="io1">3. येका बाद व्हा यौन अनैतिकता अरु एक दूसरा खे अदालत मे ले जान को मुद्दा खे मसुर करतो हइ <char style="ior"><ref loc="1CO 5-6">5—6</ref></char>.</para>
  <para style="io1">4. ओका बाद व्हा भ्याव कि मूर्तिहोन की बलिका सार्वजनीक पूजा कि अध्यात्मीक उपहार अरु पुनरुत्थान को मामलो पर नीर्देश देस हइ <char style="ior"><ref loc="1CO 7-15">7—15</ref></char>.</para>
  <para style="io1">5. आखरी मे व्हा कुछ व्यावहारीक अरु व्यक्तिगत बात का साथ अपनी बात खत्म करस हइ <char style="ior"><ref loc="1CO 16">16</ref></char>.</para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />पौलुस का तरफ से जो परमेश्वर की इच्छा से यीशु मसीह का प्रेरित होन का लिये बुलायो गया अरु भैइ सोस्थिनेस का तरफ से. <verse eid="1CO 1:1" /><verse number="2" style="v" sid="1CO 1:2" />परमेश्वर की वा मंडली का नाम जो कुरिन्थुस मे हइ, मनजे उनका नाम जो मसीह यीशु मे पवित्र कर्या गया, अरु पवित्र होन का लिये बुलायो गए हइ; अरु उन सब का नाम भी जो हर जगा हमारा अरु अपना प्रभु यीशु मसीह का नाम से प्रार्थना करस हइ.<verse eid="1CO 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3" />हमारो बाप परमेश्वर अरु प्रभु यीशु मसीह का तरफ से तुमखे अनुग्रह अरु शांती मीलती र्‍हिये.<verse eid="1CO 1:3" /></para>
  <para style="s">पौलुस को परमेश्वर खे धन्यवाद</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />मी तुमारा बारे मे अपना परमेश्वर खे धन्यवाद हमेशा करुस हइ, येकालिये कि परमेश्वर को यो अनुग्रह तुम पर मसीह यीशु मे हुयो. <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />कि ओमे हुइखे तुम हर बात मे मनजे पुरो वचन अरु पुरा ज्ञान मे धनी कर्या गया. <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />कि मसीह की गवइ तुम मे पक्की नीकल्ये.<verse eid="1CO 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 1:7" />ह्या तक कि कोय वरदान मे तुमखे कमी नी , अरु तुम हमारा प्रभु यीशु मसीह को प्रगट होन की प्रतीक्षा करता र्‍हेस हइ. <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />उ तुमखे आखरी तक दृढ भी कर्ये, कि तुम हमारा प्रभु यीशु मसीह का दिन मे नीर्दोष ठैरनु <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />परमेश्वर विश्वासयोग्य हइ. जेने तुम खे अपनो बेटो हमारो प्रभु यीशु मसीह की संगत मे बुलायो हइ. <note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="DEU 7:9">व्यवस्था विवरन 7:9</ref></char></note><verse eid="1CO 1:9" /></para>
  <para style="s">कुरिन्थुस की मंडली मे फुट</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />हे भैइहोन अरु बहीन, मी तुम से यीशु मसीह जो हमारो प्रभु हइ ओका नाम का द्वारा प्रार्थना करुस हइ, कि तुम सब एक ही बात बोलनु अरु तुम मे फूट नी हो, पर एक ही मन अरु एक ही मत हुइखे मील्या र्‍हेनु. <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />क्युकि हे मरा भैइहोन, खलोए का घराना का इन्सानहोन ने मेखे तुमारा बारे मे बतायो हइ, कि तुम मे झगडा हुइ र्‍हा हइ.<verse eid="1CO 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 1:12" />मरो बोलन को मतलब यो हइ, कि तुम मे से कोय तो अपना आप खे “पौलुस को,” कोय “अपुल्लोस को,” कोय “कैफा को,” कोय “मसीह को” बोलस हइ. <verse eid="1CO 1:12" /><verse number="13" style="v" sid="1CO 1:13" />का मसीह बठी गयो? का पौलुस तुमारा लिये क्रुस पर चडायो गयो? या तुमखे पौलुस का नाम पर बपतिस्मा मील्यो?<verse eid="1CO 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 1:14" />मी परमेश्वर को धन्यवाद करुस हइ, कि क्रिस्पुस अरु गयुस खे छोड़, मेने तुम मे से कोय खे भी बपतिस्मा नी दियो. <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />खय असो नी हो, कि कोय बोल्ये कि तुमखे मरा नाम पर बपतिस्मा मील्यो. <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" />अरु मेने स्तिफनास का घराना खे भी बपतिस्मा दियो. इनखे छोडी खे मी नी जानु कि मेने अरु कोय खे बपतिस्मा दियो. <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />क्युकि मसीह ने मेखे बपतिस्मा देन खे नी, क्युकी सुसमाचार सुनान खे भेज्यो हइ, अरु यो भी इन्सानहोन को अवाजहोन को ज्ञान का अनुसार नी असो नी हो कि मसीह को क्रुस बेकार ठैर्ये.<verse eid="1CO 1:17" /></para>
  <para style="s">मसीह की शक्ति अरु परमेश्वर को ज्ञान</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />क्युकि क्रुस की कथा खत्म होनआला का पास बेवकुप हइ, पर हम उध्दारपानआला का पास परमेश्वर की सामर्थ्य हइ. <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" />क्युकि लिख्यो हइ.</para>
  <para style="q1" vid="1CO 1:19">“मी ज्ञानवान को ज्ञान खे खत्म कर्यु,</para>
  <para style="q2" vid="1CO 1:19">अरु समझदारहोन खे समझ खे तुच्छ करी दियु.”<note caller="+" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="ISA 29:14">यशया 29:14</ref></char></note><verse eid="1CO 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 1:20" />खा र्‍हियो ज्ञानवान? खा र्‍हियो शास्त्री? खा र्‍हियो यो संसार को विवादी? का परमेश्वर ने संसार का ज्ञान खे बेवकुप नी ठैइरायो? <note caller="+" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="ROM 1:22">रोमीयो 1:22</ref></char></note> <verse eid="1CO 1:20" /><verse number="21" style="v" sid="1CO 1:21" />क्युकि जब परमेश्वर का ज्ञान खे अनुसार संसार ने ज्ञान से परमेश्वर खे नी जान्यो ते परमेश्वर खे यो अच्छो लग्यो कि यो प्रचार का बेवकुप का द्वारा विश्वास करणआला खे उध्दारदे.<verse eid="1CO 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 1:22" />यहूदी तो चिन्ह चाहस हइ, अरु यूनानी ज्ञान का खोज मे हइ, <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />पर हम तो उ क्रुस पर चडाया हुया मसीह को प्रचार करस हइ जो यहूदीहोन का पास ठोकर का कारण अरु गैरयहूदीहोन का पास बेवकुप हइ. <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />पर जो बुलायो हुया हइ का यहूदी, का यूनानी, उनका पास मसीह परमेश्वर को सामर्थ्य, अरु परमेश्वर को ज्ञान हइ. <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />क्युकि परमेश्वर की बेवकुप इन्सानहोन का ज्ञान से ज्ञानवान हइ. अरु परमेश्वर की बिनाताखत आलो इन्सानहोन का बल से भोत बलवान हइ.<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />हे भैइहोन अरु बहिन, अपना बुलायो जाना खे तो सोचनु कि न आंग का अनुसार भोत ज्ञानवान, अरु नी भोत सामर्थ्यी, अरु नी भोत कुलीन बुलायो गया. <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />पर परमेश्वर ने जगत का बेवकुपहोन खे चुनी लियो हइ कि ज्ञानीहोन खे लज्जित करणु. अरु परमेश्वर ने संसार का नीर्बलहोन खे चुनी लियो हइ, कि बलवानहोन खे लज्जित कर्ये. <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />अरु परमेश्वर ने संसार का नीचहोन अरु तुच्छहोन खे क्युकी जो हइ भी नी उनखे भी चुनी लियो, कि उनने जो हइ, बेकार ठैइराये. <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />ताकि कोय जनवर परमेश्वर का सामने घमण्ड नी करी पाये. <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />पर ओ का तरफ से तुम मसीह यीशु मे हुये, जो परमेश्वर का तरफ से हमारा लिये ज्ञान ठैइराये मनजे धर्मीकता, अरु पवित्रता, अरु छुटकारो. <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />ताकि जसो लिख्यो हइ, ओसो ही हो, “जो घमण्ड कर्ये उ प्रभु मे घमण्ड कर्हे .”<verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s">क्रुश पर टग्यो हुयो मसीह, बारे मे संदेश</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />हे भैइहोन अरु बयहोन, जब मी परमेश्वर को भेद सुनाते हुयो तुमारा पास आयो, ते वचन या ज्ञान कि उत्तमता का साथ नी आयो. <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />क्युकि मेने यो ठानी लियो थो कि तुम्हारा बीच यीशु मसीह, क्युकी क्रुस पर चडाया हुया मसीह खे छोड अरु कोय बात खे नी जान्यू. <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" />अरु मी नीर्बलता अरु डर का साथ अरु भोत थरथरातो हुयो तुमारा साथ र्‍हियो. <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />अरु मरा वचन, अरु मरो प्रचार मे ज्ञान, लुभानआली बातहोन नी. पर आत्मा अरु सामर्थ्य को प्रमाण थो. <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />येका लिये कि तुमारा विश्वास इन्सानहोन खे ज्ञान पर नी, पर परमेश्वर को सामर्थ्य पर नीरभर होनु.<verse eid="1CO 2:5" /></para>
  <para style="s">आत्मीक ज्ञान</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />फिर भी सिद्ध इन्सानहोन मे हम ज्ञान सुनास हइ पर यो जगत को अरु यो जगत को नाश होनआला हाकिमहोन को ज्ञान नी. <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />पर हम परमेश्वर को उ गुप्त ज्ञान खे बतास हइ, जेखे परमेश्वर ने सनातन से हमारी महिमा का लिये ठैइरायो. <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />जेखे यो जगत का हाकिमहोन मे से कोय ने नी जान्यो, क्युकि अगर जानता कि ते तेजोमय प्रभु खे क्रुस पर नी चडाता. <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />पर जसो लिख्यो हइ,</para>
  <para style="q1" vid="1CO 2:9">“जे आख ने नी देखी,</para>
  <para style="q2" vid="1CO 2:9">अरु काम न ने नी सुनी,</para>
  <para style="q2" vid="1CO 2:9">अरु जो बातहोन इन्सान खे चित्ता मे नी चढी वे ही हइ,</para>
  <para style="q" vid="1CO 2:9">जो परमेश्वर ने अपनो प्रेम रखनआला, लिये तैयार करी हइ.” <note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="ISA 64:4">यशया 64:4</ref></char></note><verse eid="1CO 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 2:10" />पर परमेश्वर ने उनका अपनो आत्मा का वजेसे हम पर प्रगट कर्यो. क्युकि आत्मा सब बातहोन, क्युकी परमेश्वर की रहस्यमय बातहोन भी जाचस हइ. <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />इन्सानहोन मे से कोन कोय इन्सान की बातहोन जानस हइ, फक्त इन्सान की आत्मा जो ओमे हइ? ओसो ही परमेश्वर की बातहोन भी कोय नी जाने कि फक्त परमेश्वर को आत्मा. <note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="PRO 20:27">नितिसूत्रे 20:27</ref></char></note> <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />पन हमने जगत की आत्मा नी मील्यो हइ, जो परमेश्‍वर का तरफ से हइ, कि हम उन बातहोन खे जान्येका जो परमेश्वर ने हम खे दी हइ.<verse eid="1CO 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 2:13" />जिन, हम इन्सानहोन कि ज्ञान की सिखइ हुइ बातहोन मे नी, पर पवित्र आत्मा की सिखइ हुइ बातहोन मे, आत्मा बात आत्मीक ज्ञान से आत्मीक बातहोन की व्याख्या करस हइ. <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />पर शारीरिक इन्सान परमेश्वर को आत्मा की बातहोन अपनइ नी कर्‍हे, क्युकि वे ओका नजर मे मूर्खता की बातहोन हइ, अरु नी उ उनका जान सकस हइ क्युकि उनकी परख्ये आत्मीक रीति से होस हइ. <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />आत्मीक जन सब कुछ परख्ये हइ, पर उ आप कोय से परख्ये नी जाय.<verse eid="1CO 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="1CO 2:16" />“क्युकि प्रभु को मन कोय ने जान्यो हइ,</para>
  <para style="q1" vid="1CO 2:16">कि ओखे सिखाये?”</para>
  <para style="q2" vid="1CO 2:16">पर हम मे मसीह को मन हइ.<note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ISA 40:13">यशया 40:13</ref></char></note><verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s">इन्सानहोन को अनुसरन अच्छो नी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />हे भैइहोन अरु बहिन, मी तुम से या रीति से बातहोन नी करी सक्यो, जसो आत्मीक इन्सानहोन से पर जसो आंग इन्सानहोन से, अरु उनसे जो मसीह मे बच्चा हइ. <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" />मेने तुमखे दूध पिलायो, खनो नी खलायो. क्युकि तुम ओखे नी खैइ सक्या था. क्युकी अब तक भी नी खैइ सकस हइ, <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />क्युकि अब तक आंग हुया येकालिये, कि जब तुम मे इर्ष्या अरु वाद विवाद हइ, ते का तुम आंग नी? अरु इन्सान का रीति पर नी चले? <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" />येकालिये कि जब एक बोलस हइ, “मी पौलुस को हइ,” अरु दूसरो, “मी अपुल्लोस को हइ” ते का तुम इन्सान नी?<verse eid="1CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />अपुल्लोस कोन हइ? अरु पौलुस कोन हइ? फक्त सेवक, जिनका वजेसे तुम इन्सान ने विश्वास कर्यो, जसो हर एक खे प्रभु ने दियो. <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />मेने झाड लगायो, अपुल्लोस ने सीच्यो, पर परमेश्वर ने बडायो. <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />येकालिये नी ते लगानआला कुछ हइ, अरु नी वोलनाला पर परमेश्वर जो बडानआला हइ उ सब कुछ हइ. <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />लगानआला अरु सींचनआला दोइ एक हइ. पर हर एक इन्सान अपना ही मेहनत का अनुसार अपनी ही मजदूरी मील्हे. <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />क्युकि हम परमेश्वर का सहकर्मी हइ. तुम परमेश्वर का खेत</para>
  <para style="p" vid="1CO 3:9">अरु परमेश्वर की रचना हइ. <verse eid="1CO 3:9" /><verse number="10" style="v" sid="1CO 3:10" />परमेश्वर का वा अनुग्रह का अनुसार जो मेखे दिया गयो, मेने बुद्धिमान राजमिस्‍त्री का समान पय्या डाल्यो, अरु दूसरो ओका पर रद्दो रखस हइ पर हर एक इन्सान चौकस र्‍हिये, कि उ ओका पर कसो रद्दो रखस हइ. <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />क्युकि उ पाय्या खे छोड जो पडि हइ, अरु उ यीशु मसीह हइ, कोय दूसरो पय्या नी डाली सकतो.<note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="ISA 28:16">यशया 28:16</ref></char></note> <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />अरु अगर कोय यो पय्या पर सोन्नो या चादी या बहुमूल्य पत्थर या काठ या घास या फूस को रद्दो रख्ये, <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />ते हर एक का काम प्रगट हुइ जाये. क्युकि उ दिन ओखे बताये. येकालिये कि अंगार का साथ प्रगट हुये अरु वा अंगार हर एक का काम समज्हे कि कसो हइ. <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />जेको काम ओका पर बन्यो हुयो स्थिर र्‍हिये, उ मजदूरी मील्हे. <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />अरु अगर कोय का काम जली जाये, ते उ नुकसान उठाये. पर उ खुद बची जाये पर जलते-जलते.<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />का तुम नी जाने कि तुम परमेश्वर कि मन्दिर हइ, अरु परमेश्वर कि आत्मा तुम मे वास करस हइ? <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />अगर कोय परमेश्वर का मन्दिर खे नाश कर्ये ते परमेश्वर ओखे नाश कर्ये. क्युकि परमेश्वर को मन्दिर पवित्र हइ, अरु उ तुम हइ.<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />कोय अपना आप खे धोखा नी दे. अगर तुम मे से कोय यो संसार मे अपना आप खे ज्ञानी समझ्ये, ते बेवकुप बन्ये कि ज्ञानी हुइ जाये. <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />क्युकि यो संसार को ज्ञान परमेश्वर का पास बेवकुप हइ, जसो लिख्यो हइ, “उ ज्ञानीहोन खे उनकी हुशारी मे फसय देस हइ,” <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />अरु फिर, “प्रभु ज्ञानीहोन खे बिचारहोन खे जानस हइ, कि बेकार हइ.” <verse eid="1CO 3:20" /><verse number="21" style="v" sid="1CO 3:21" />येकालिये इन्सानहोन पर कोइ घमण्ड नी करणु, क्युकि सब कुछ तुमारो हइ. <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />का पौलुस, का अपुल्लोस, का कैफा, का संसार, का जिवन, का मरण, का वर्तमान, का भविष्य, सब कुछ तुमारो हइ, <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />अरु तुम मसीह का हइ, अरु मसीह परमेश्वर को हइ.<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s">मसीह, विश्वासयोग्य भण्डारी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />इन्सान हम मसीह को सेवक अरु परमेश्‍वर को भेदहोन को भण्डारी समझ्ये. <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />फिर ह्या भण्डारी मे या बात देखी जास हइ, कि विश्वासयोग्य नीकल्ये. <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />पर मरी नजर मे या भोत छोटी बात हइ, कि तुम या इन्सानहोन खे कोय न्यायी मेखे परख्ये का क्युकी मी खुद ही अपना आप खे नी पहीछानु. <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />क्युकि मरो मन मेखे कोय बात मे दोषी नी ठैइराय, पर येका से मी नीर्दोष नी ठैइर्‍ये का क्युकि मरो परखनआलो प्रभु हइ. <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />येका लिये जब तक प्रभु नी आय, टेम से पैयले कोय बात को न्याय नी करणु उ तो अंधारा की लुकी बातहोन उजाला मे दिखाये का अरु मनहोन को उद्देश्यहोन खे प्रगट कर्ये का तब परमेश्‍वर का तरफ से हर एक की प्रशसा हुये.<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />हे भैइहोन अरु बहीन, मेने या बातहोन मे तुमारा लिये अपना तरफ अपुल्लोस की चर्चा दृष्‍टान्‍त कि रीति पर करी हइ, येका लिये कि तुम हमारा द्वारा यो सीखनु कि लिख्या हुया से आगे नी बडनु, अरु एक का पक्ष मे अरु दूसरा का विरुध मे गर्व नी करणु. <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />क्युकि तरा मे अरु दूसरा मे कोन भेद करस हइ? अरु तरा पास का हइ जो तोने दूसरा से नी पायो अरु जब कि तोने दूसरा से पायो हइ, ते असो घमण्ड क्यु करस हइ, कि मान्नु नी पायो?<verse eid="1CO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8" />तुम तो तृप्त हुइ चुक्या. तुम धनी हुइ चुक्या, तुम ने हमारा बिना राज कर्यो. पर भलो होतो कि तुम राज करता कि हम भी तुमारा साथ राज करता. <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />मरा समझ मे परमेश्वर ने हम प्रेरितहोन का सब का बाद उन इन्सानहोन का समान ठैइरायो हइ, जिनको मरन की आज्ञा हुइ चुकी हइ. क्युकि हम जगत अरु स्वर्गदूतहोन अरु इन्सानहोन का लिये एक तमाशो ठैइऱ्यो हइ. <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />हम मसीह का लिये बेवकुप हइ. पर तुम मसीह मे बुद्धिमान हइ. हम नीर्बल हइ पर तुम बलवान हइ तुम आदर पास हइ, पर हम नीरादर होस हइ. <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />हम या घडी तक भूक-प्यासा अरु बीना कपडा, हइ, अरु घुसो खास हइ अरु मारा-मारा फिरस हइ. <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" />अरु अपना ही हाथहोन काम कर्हे का मेहनत करस हइ इन्सान बुरो बोलस हइ, हम आशीष देस हइ. वे सतास हइ, हम सहेस हइ. <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />वे बदनाम करस हइ, हम प्रार्थना करस हइ हम आज तक जगत को कचरा अरु सब चिजहोन की खुर्चन का समान ठैइरा हइ.<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />मी तुम का लज्जित करण का लिये या बातहोन नी लिखतो, पर अपना प्रिय बच्चा जानी खे तुम बतउस हइ. <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />क्युकि अगर मसीह मे तुमारा सिखानआला दस हजार भी होता, ते भी तुमारा बाप भोत सा नी, येका लिये कि मसीह यीशु मे सुसमाचार, द्वारा मी तुमारा बाप हुयो. <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" />येकालिये मी तुम से प्रार्थना करुस हइ, अरु मरी जसी चाल चलनु. <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />येकालिये मेने ती तीमुथियुस खे जो प्रभु मे मरो प्रिय अरु विश्वासयोग्य बेटो हइ, तुमारा पास भेज्यो हइ, अरु उ तुम यीशु मसीह मे मरो चरित्र याद कराये खे जसो कि मी हर जगा हर एक मंडली मे उपदेश करुस हइ.<verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />खे त्ता तो असा फूली गया हइ, मानो मी तुमारा पास आन ही को नी.<verse eid="1CO 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 4:19" />पर प्रभु चाह्ये ते मी तुमारा पास जल्दी ही आयु, अरु उन फूल्या हुया की बातहोन खे नी, पर उनकी सामर्थ्य खे जानी लियु. <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />क्युकि परमेश्वर को राज बातहोन मे नी पर सामर्थ्य मे हइ. <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />तुम का चाहस हइ? मी लकडी लिखे तुमारा पास आयु या प्रेम अरु नम्रता की आत्मा का साथ?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s">मंडली मे अनैतिक सदस्य</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />ह्या तक सुनना मे आयो हइ कि तुम मे व्यभिचार होस हइ, क्युकी असो व्यभिचार जो गैरयहूदीहोन मे भी नी होतो कि एक इन्सान अपना बाप की लुगइ खे रखस हइ.<note caller="+" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="LEV 18:8">लैव्यव्यवस्था 18:8</ref>; <ref loc="DEU 22:30">व्यवस्था विवरन 22:30</ref></char></note> <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />अरु तुम शोक तो नी कर्‍हे, जेका से असो काम कर आला तुमारा बीच मे से नीकल्या जास का पर घमण्ड करस हइ. <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />मी तो आंग को भाव से दूर थो, पर आत्मा को भाव से तुमारा साथ हुये खे मानो उपस्थिति कि दशा मे असो काम करणआला का बारे मे न्याय करी चुक्या हइ. <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />कि जब तुम अरु मरी आत्मा, हमारा प्रभु यीशु की सामर्थ्य, साथ इकठ्ठा हुये खे ते असो इन्सान खे हमारो प्रभु यीशु का नाम से. <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />शरीर को विनाश का लिये सैतान खे दियो जायेका ताकि उसकी आत्मा प्रभु का दिन मे उध्दारपाये.<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />तुमारो घमण्ड करणो अच्छो नी; तुम नी जानता कि थोडो सो खमीर पूरे गुध्या हुया आटा खे खमीर करी देस हइ. <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />पुरानो खमीर नीकाली खे अपना आप खे अच्छो कर्यो कि नवो गूध्या हुया आटो बनी जाये. ताकि तुम अखमीरी हुये खे क्युकि हमारो भी फसह जो मसीह हइ, बलिदान हुयो हइ. <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />येका लिये आनू हम उत्सव मे खुशी मनाये का नी ते पुरानो खमीर से अरु नी बुराइ अरु दुष्टता का खमीर से, पर सिधाइ अरु सच्ची की अखमीरी रोटी से.<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />मेने अपनी चिठ्ठी मे तुम खे लिख्यो हइ, कि व्यभिचारिहोन की सगति नी करणु. <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />यो नी कि तुम बिलकुल या जगत को व्यभिचारिहोन खे या लोभिहोन खे यो अंधारो करणआला काया मूर्तिपूजकहोन को सगत नी करणु; क्युकि या दशा मे ते तुमखे जगत मे से नीकली जानो ही पडस. <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />मरो कहनो यो हइ. कि अगर कोय भैइ अरु बहीन कहलै, व्यभिचारी, या लोभी, या मूर्तिपूजक, या गाली देनआला, या पियक्कड, या अधारो करणआला हुये खे ते ओकी सगत मत करणु. क्युकी असा इन्सान का साथ खानो भी नी खानु.<verse eid="1CO 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12" />क्युकि मेखे बाहेरआला को न्याय करणा से काम, तुम अंदर आला को न्याय नी कर्‍हे? <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />पर भाहेआला को न्याय परमेश्वर करस हइ</para>
  <para style="q" vid="1CO 5:13">येकालिये येखे उ कुकर्मी खे अपना बीच मेसे नीकाली दे.<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s">आपसी झगडाहोन को नीपटारो</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />का तुम मेसे कोय खे यो हिम्मत हइ, कि जब दूसरा का साथ वाद विवाद हुये ते फैसला का लिये अधर्मीहोन का पास जाये. अरु पवित्र इन्सानहोन का पास नी जाये? <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />का तुम नी समजे खे कि पवित्र इन्सान संसार को न्याय कर्ये? अरु जब तुमखे संसार को न्याय करणो हइ, ते का तुम छोटा झगडा को भी फैसलो करण का लायक नी? <note caller="+" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="DAN 7:22">दानिएल 7:22</ref></char></note> <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />का तुम नी समजे कि हम स्वर्गदूतहोन को न्याय कर्ये? ते का सांसारीक बातहोन को फैसलो नी कर्ये? <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />अगर तुमखे सांसारीक बातहोन को फैसलो करणो हुये, ते का उन खे बठाड्ये जो मंडली मे कुछ नी समझे जास हइ? <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />मी तुमखे लज्जित करण का लिये यो बोलनो हइ का सचमुच तुम मे से एक भी बुद्धिमान नी मीले, जो अपना भैइहोन अरु बहीन को फैसलो करी सक्ये? <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />क्युकी भैइ-भैइ अरु बहीन मे मुकद्दमो होस हइ, अरु उ भी अविश्वासिहोन का सामने.<verse eid="1CO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7" />सचमुच तुम मे बडो दोष ते यो हइ, कि आपस मे मुकद्दमो करस हइ क्युकी अन्याय क्यु नी सेहस? अपनो नुकसान क्यु नी सहे? <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />क्युकी अन्याय करस अरु नुकसान पहुचास हइ, अरु उ भी भैइहोन अरु बहीन खे. <verse eid="1CO 6:8" /><verse number="9" style="v" sid="1CO 6:9" />का तुम नी समजे, कि अन्याय इन्सान परमेश्वर का राज्य का वारिस नी हुये? धोखो नी खानु, नी वेश्यागामी, नी मूर्तिपूजक, नी परस्त्रीगामी, नी लुच्चो, नी इन्सानगमन. <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />नी चोरी, नी लोभी, नी पियक्कड, नी गाली देनआला, नी अंधारो करणआला परमेश्वर का राज का वारिस हुये. <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />अरु तुम मे से केत्ता असा ही था, पर तुम प्रभु यीशु मसीह का नाम से अरु हमारा परमेश्वर का आत्मा से धोया गए अरु पवित्र हुया अरु धर्मी ठैर्या.<verse eid="1CO 6:11" /></para>
  <para style="s">आंग अरु आत्मा मे परमेश्वर की महिमा</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />सब चिजहोन मरा लिये अच्छो तो हइ, पर सब चिजहोन लाभ की नी सब चिजहोन मरा लिये अच्छो हइ, पर मी कोय बात का अधीन नी होयु. <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />खानो पेट का लिये, अरु पेट खाना का लिये हइ, पर परमेश्वर खे अरु येखे दोइ खे नाश कर्ये, पर आंग व्यभिचार का लिये नी, क्युकी प्रभु का लिये. अरु प्रभु आंग का लिये हइ. <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />अरु परमेश्वर ने अपना सामर्थ्य से प्रभु खे जिन्दो, अरु हमखे भी जिन्दो.<verse eid="1CO 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15" />का तुम नी समजे कि तुमारो आंग मसीह को आंग हइ? ते का मी मसीह को आंग लिखे उनखे वेश्या का आंग बनायु? कभी भी नी. <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />का तुम नी समजे कि जो कोय वेश्या से संगति करस हइ, उ ओका साथ एक तन हुइ जास हइ क्युकि लिख्यो हइ, “वे दोइ एक तन हुये”<note caller="+" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="MRK 10:8">मरकुस 10:8</ref></char></note> <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />अरु जो प्रभु की संगति मे र्‍हेस हइ, उ ओका साथ एक आत्मा हुइ जास हइ.<verse eid="1CO 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18" />व्यभिचार से बच्या र्‍हेनु जित्ता अरु पाप इन्सान करस हइ, वे आंग का बाहेर हइ, पर व्यभिचार करणआला अपना ही आंग का विरुद्ध पाप करस हइ. <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" />का तुम नी समजे कि तुमारो आंग पवित्र आत्मा को मन्दिर हइ. जो तुम मे बस्यो हुयो हइ अरु तुमखे परमेश्वर का तरफ से मील्यो हइ, अरु तुम अपना नी हइ? <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />क्युकि दाम दिखे मोल लिया गए हइ, येकालिये अपनो आंग का द्वारा परमेश्वर की महिमा करणु.<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s">भ्याव को सिद्धान्त</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />उन बातहोन का बारे मे जो तुम ने लिखी, यो अच्छो हइ, कि इन्सान बय खे नी छीनु. <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />पर व्यभिचार खे डर से हर एक अदमी की लुगइ, अरु हर एक बय को अदमी होनु. <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />अदमी अपनी लुगइ को हक पूरो करनु; अरु ओसो ही लुगइ भी अपना अदमी को. <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />लुगइ, अपना आंग पर अधिकार नी पर ओका अदमी को अधिकार हइ. ओसो ही अदमी खे भी अपना आंग पर अधिकार नी, पर लुगइ खे हइ. <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />तुम एक दूसरा से अलग नी र्‍हेनु; पर फक्त कुछ टेम तक आपस की सम्मति से करी प्रार्थना का लिये अराम मील्ये का अरु फिर एक साथ र्‍हेनु. असो नी हो कि तुमारो असयम करण सैतान तुम खे समझ्ये.<verse eid="1CO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 7:6" />पर मी जो यो बोलुस हइ उ अनुमति हइ नी कि आज्ञा. <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />मी यो चाहुस हइ, कि जसो मी हइ, ओसो ही सब इन्सान हुये पर हर एक को परमेश्‍वर का तरफ से विशेष वरदान मील्यो हइ. कोय को कोय प्रकार को अरु कोय खे अरु प्रकार को.<verse eid="1CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8" />पर मी भ्याव नी हुयाआला अरु विधवाहोन का बारे मे बोलुस हइ, कि उनका लिये असो ही र्‍हेनो अच्छो हइ, जसो मी हइ. <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />पर अगर वे खुद नी करी सक्ता ते भ्याव करणु. क्युकि भ्याव करणो कामातुर र्‍हेना से भलो हइ.<verse eid="1CO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10" />जिनको भ्याव हुइ गयो हइ, उनका मी नी, क्युकी प्रभु आज्ञा देस हइ, कि लुगइ अपना अदमी से अलग नी होनु. <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />अरु अगर अलग भी हुइ जायेका ते बिना दूसरो भ्याव कर्या र्‍हेनु. या अपना अदमी से फिर मेल करी ले अरु नी अदमी अपनी लुगइ खे छोडनु.<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />दूसरहोन से प्रभु नी पर मी ही बोलुस हइ, अगर कोय भैइ की लुगइ विश्वास नी रखस हइ, अरु ओका साथ र्‍हेना से खुश हुये खे ते उ ओखे नी छोडनु. <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />अरु जो लुगइ को अदमी विश्वास नी रखस हइ, अरु ओका साथ र्‍हेना से खुश हुये. उ अदमी खे नी छोडनु. <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />क्युकि असो अदमी जो विश्वास नी रखे हइ, वा लुगइ करण अपवित्र ठैइरस हइ, अरु असी लुगइ जो अविश्वासी नी रखे कि इन्सान करण पवित्र ठैइरस हइ. नी ते तुमारा बाल-बच्चा अशुध्द होस कि पर अब तो पवित्र हइ.<verse eid="1CO 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 7:15" />पर जो इन्सान अविश्वासी नी रखे, अगर उ अलग हुये खे ते अलग होन देनु, असी पाप मे कोय भैइ या बय बन्धन मे नी. पर परमेश्वर ने तो हम खे मेल-मीलाप, लिये बुलायो हइ. <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />क्युकि हे बय, तू का जानस हइ, कि तू अपना अदमी को उध्दारकर्ये लिये? अरु हे इन्सान, तू का जानस हइ कि तू अपनी लुगइ को उध्दारकर्ये लिये?<verse eid="1CO 7:16" /></para>
  <para style="s">परमेश्वर को बुलाहट, जसो चलनु</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />पर जसो प्रभु ने हर एक, बाट्यो हइ, अरु जसो परमेश्वर ने हर एक, बुलायो हइ. ओसो ही उ चल्यो अरु मी सब मंडलीहोन मे असो ही ठैइरस हइ. <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />जो खतना कर्या हुया बुलायो गयो हइ, उ खतनारहित नी बन्नु जो खतनारहित बुलायो गयो हइ, उ खतना नी कराये. <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />नी खतना कुछ हइ, अरु नी खतनारहित पर परमेश्वर की आज्ञाहोन, मान्नु ही सब कुछ हइ. <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />हर एक जन जो दशा मे बुलायो गयो हइ, ओ मे र्‍हिये. <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />अगर तू सेवक की दशा मे बुलायो गयो हइ ते फिकर नी करणु. पर अगर तू स्वतत्रता हुइ सक्येका ते असो ही काम कर. <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />क्युकि जो सेवक की दशा मे प्रभु मे बुलायो गयो हइ, उ प्रभु, स्वतत्रता कर्या हुया हइ अरु ओसो ही जो स्वतत्रता की दशा मे बुलायो गयो हइ, उ मसीह, सेवक हइ. <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />तुम दाम दिखे मोल लिया गया हइ, इन्सानहोन को सेवक नी बन्नु. <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />हे भैइहोन, जो कोय जो दशा मे बुलाया गया हइ, उ ओ मे परमेश्‍वर, साथ र्‍हिये.<verse eid="1CO 7:24" /></para>
  <para style="s">भ्याव सम्बन्धित सवाल को जवाब</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />कुव्वारीहोन का बारे मे प्रभु की कोय आज्ञा मेखे नी मीली, पर विश्वासयोग्य होन का लिये जसी दया प्रभु ने मरा पर करी हइ, ओका जसो सम्मति देउस हइ.<verse eid="1CO 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 7:26" />येका लिये मरी समझ मे यो अच्छो हइ, कि आज कल क्लेश करण इन्सान जसो हइ, ओसो ही र्‍हेनु. <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />अगर तरी लुगइ हइ, ते ओकासे अलग होन कि कोशिश नी करणु अरु अगर तरी लुगइ नी, ते लुगइ की ढुडनु नी करणु <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />पर अगर तू भ्याव भी कर्ये, ते पाप नी. अरु अगर कुव्वारी भ्याव कर्यो जाये ते कोय पाप नी. पर असा को आंग दुःख हुये खे अरु मी बचानो चाहुस हइ.<verse eid="1CO 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29" />हे भैइहोन अरु बहीन, मी यो बोलुस हइ, कि टेम कम करी गय हइ, येका लिये हुनु कि जेकी लुगइ हइ, वे असो हुये मानो उनका लुगइ नी. <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />अरु रोनआला असा हये, मान्नु रोय नी. अरु खुशी करणआला असा हुये, मान्नु खुशी नी कर्‍हे. अरु मोल लेनआला असा हुये, कि मान्नु उनका पास कुछ हइ नी. <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />अरु यो जगत का साथ व्यवहार करणआला असा हो, कि जगत ही, नी. क्युकि यो जगत कि रीति अरु व्यवहार बदलता जास हइ.<verse eid="1CO 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32" />मी यो चाहुस हइ, कि तुम खे फिकर नी हो भ्याव नी हुया इन्सान प्रभु की बातहोन की फिकर मे र्‍हेस हइ, कि प्रभु खे कसो खुश रख्ये. <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />पर भ्यावआलो इन्सान जगत की बातहोन की फिकर मे र्‍हेस हइ, कि अपनी लुगइ खे कोय रीति से खुश रख्ये. <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />भ्यावआलो अरु भ्यावनीआला मे भी भेद हइ भ्यावनीआली प्रभु की फिकर मे र्‍हेस हइ, कि उ आंग अरु आत्मा दोइ मे पवित्र हुये, पर भ्यावआली जगत की फिकर मे र्‍हेस हइ, कि अपना अदमी, खुश रखनु.<verse eid="1CO 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 7:35" />ह्या बात तुम्हारा ही लाभ का लिये बोलुस हइ, नी कि तुमखे फसान का लियेका क्युकी येका लिये कि जसो अच्छो हइ. ताकि तुम एक चित्त हुइ, प्रभु की सेवा मे लग्या र्‍हेनु.<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />अरु अगर कोय यो समझ्ये का कि मी अपनी वा कुव्वारी को हक मारी र्‍हो हइ, जेकी जवानी जय र्‍हि हइ, अरु प्रयोजन भी हुये खे ते जसो चाह्ये, ओसो कर्येका येमे पाप नी, उ ओको भ्याव होन दे. <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />पर अगर उ मन मे फैसलो करस हइ, अरु कोय भोतजरुरत नी हइ, अरु उ अपनी अभिलाषाहोन खे नीयत्रित करी सकस हइ, ते उ भ्याव नी कर्यो अच्छो करस हइ. <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />ते जो अपनी कुव्वारी को भ्याव करी देस हइ, उ अच्छो करस हइ अरु जो भ्याव नी करी देस, उ अरु भी अच्छो करस हइ.<verse eid="1CO 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39" />जब तक कोय लुगइ को अदमी जिन्दो र्‍हेस हइ, तब तक उ ओकासे बधी हुयो हइ, पर जब ओको अदमी मरी जायेका ते जेका से चाह्ये भ्याव करी सकस हइ, पर फक्त प्रभु मे. <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />पर जसी हइ अगर ओसी ही र्‍हियेका ते मरा बिचार मे अरु भी धन्य हइ, अरु मी समझुस हइ, कि परमेश्वर को आत्मा मरा मे भी हइ.<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s">चढावे, भोजन</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />अब मूरती का सामने बलि करी हुइ चिजहोन का बारे मे हम जानस हइ, कि हम सब खे ज्ञान हइ ज्ञान घमण्ड परदा करस हइ, पर प्रेम से उन्नती होस हइ. <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />अगर कोय समझ्ये का कि मी कुछ जानुस हइ, ते जसो जाननो हुनु ओसो अब तक नी जान्यो. <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />पर अगर कोय परमेश्वर से प्रेम रखस हइ, ते ओखे परमेश्वर पैछानस हइ.<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />आखरी मूर्ती का सामने बलि दि हुइ चिजहोन, खान का बारे मे हम जानस हइ, कि मूर्ती जगत मे कोय चिज नी, अरु एक खे छोडी खे अरु कोय परमेश्वर नी. <note caller="+" style="x"><char style="xo" closed="false">8:4 </char><char style="xt" closed="false"><ref loc="DEU 4:39">व्यवस्था विवरन 4:39</ref></char></note> <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />क्युकि आकाश मे अरु पृथ्वी पर भोत सा इश्वर बोलस हइ, जसो कि भोत सा परमेश्वर अरु भोत प्रभु हइ. <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />ते भी हमारा पास तो एक ही परमेश्वर हइ अगर बाप जेका तरफ से सब चिजहोन हइ, अरु हम ओका लिये हइ, अरु एक ही प्रभु हइ, येकोमलब यीशु मसीह जेका वजेसे सब चिजहोन हुइ, अरु हम भी ओका वजेसे हइ.<note caller="+" style="x"><char style="xo" closed="false">8:6 </char><char style="xt" closed="false"><ref loc="JHN 1:3">यहून्ना 1:3</ref>; <ref loc="ROM 11:36">रोमीयो 11:36</ref></char></note><verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />पर सब खे या बात की ज्ञान नी. पर कुछ इन्सान होनखे मेर्ती कि येत्ती लत हुइ गइ कि खे त्ताने ते अब तक मूर्ती खे कुछ समझना कारण मूर्ती का सामने बलि दि हुइ कुछ चिज समझीखे खास हइ, अरु उनको विवेक नीर्बल हुये खे बेकार होस हइ. <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />खानो हमखे परमेश्‍वर का पास नी पहुचे अगर हम नी खायेका ते हमारो कुछ नुकसान नी, अरु अगर खायेका ते कुछ लाभ नी.<verse eid="1CO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9" />पर चतरो र्‍हेनु, असो नी हो, कि तुमारी या स्वतत्रता कही नीर्बलहोन का लिये ठोकर को करण हुइ जाये. <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />क्युकि अगर कोय तोखे ज्ञानी मूर्ती को मन्‍दिर मे खानो खाते देख्यो का अरु उ नीर्बल जन होन, ते का ओका विवेक मे मूर्ती का सामने बलि दि हुइ चिज को खान कि हिम्मत नी हुइ जाये. <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />या रीति से तरा ज्ञान करण उ नीर्बल भैइ जेखे लिये मसीह मर्यो खत्म हुइ जाये. <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />ते भैइहोन अरु बहीन का खिलाप अपराध करण से अरु उनको नीर्बल विवेक, चोट देन से तुम मसीह को अपराध करस हइ. <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />यो करण अगर खानो मरो भैइ अरु बहीन खे ठोकर खलाये का उ पाप मे गिर्येका ते मी कभी कोय रीति से मास नी खायेका नी हो कि मी अपना भैइ अरु बहीन खे ठोकरकरण बन्यु.<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s">प्रेरितहोन को अधिकार अरु काम</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />की मी स्वतंत्रता नी? की मी प्रेरित नी की मे ने यीशु खे जो हमारो प्रभु हइ नी देख्यो? की तु प्रभु ने मरो बनायो आला नी हय? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />अगर मी दूसरा का लिये प्रेरित नी, तेभी तुम्हारा वास्ते ते उ; क्युकी तु प्रभु मी मरो प्रेरिताइ पर चिन्ह्यो हु<verse eid="1CO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3" />जो मेखे परख्ये हइ, वोका लिये यो मरो जवाब हइ. <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />का हम खान-पीन को अधिकार नी हइ? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />का हमखे यो अधिकार नी हइ, की कोय मसीह भैइन का सात भ्याव करीखे साथ लिखे फीरनु, जसो दुसरो प्रेरित अरु प्रभु को भैइ अरु बहीन अरु कैफा करस हइ? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />यो फक्त मेखे अरु बरनबास कोय अधिकार नी की काम करणो छोड. <verse eid="1CO 9:6" /><verse number="7" style="v" sid="1CO 9:7" />कोन कभी अपना खर्चा से खैइखे काम करस हइ? कोन अंगूर की बाडि लगैखे ओको फल नी खाय? कोन मेडाखे पालीखे ओको दुध नी पी?<verse eid="1CO 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8" />का मी या बात इन्सान का रिती पर बोलस हइ? <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" />का व्यवस्था भी ह्या नी करी थी? क्युकी मूसा की व्यवस्था मे लिख्यो हइ, “नांगर का टेम चलाते हुये बैल को मुंडा पर मुचको नी बांधनु.” का परमेश्वर बैलहोन की चिन्ता करस हइ? <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />यो विशेष करीखे हमारा लिये बोलस हइ ह्या, हमारा लिये ही लिख्यो गयो, क्युकि अच्छो हइ कि जोतन आला आस से जोतस का अरु दावन आला हिस्सो होन का आस से दावन करणु. <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" />अगर हमने तुमारा लिये आत्मीक चिजहोन बोइ, ते का या कोय बडि बात हइ, कि तुमारी आंग चिजहोन की फसल काट्ये. <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />जब दुसरा को तुम पर यो अधिकार हइ, ते का हमारो येकासे जादा नी हुये?</para>
  <para style="p" vid="1CO 9:12">पर हम यो अधिकार काम मे नी लाये. पर सब कुछ सेहस हइ, कि हमारा वजेसे मसीह को सुसमाचार की कोय रोक नी हुये. <verse eid="1CO 9:12" /><verse number="13" style="v" sid="1CO 9:13" />का तुम नी जाने कि जो मन्दिर मे सेवा करस हइ, वे मन्दिर मे से खास हइ. अरु जो वेदी की सेवा करस हइ. वे वेदी का साथ हिस्सेदार होस हइ? <note caller="+" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="LEV 6:16-26">लैव्यव्यवस्था 6:16—6:26</ref>; <ref loc="DEU 18:1-3">व्यवस्था विवरन 18:1-3</ref></char></note> <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" />यो रीति से प्रभु ने भी ठैइरायो , कि जो दुन्या सुसमाचार सुनस हइ, उनकी जिवन का सुसमाचार से हुये.<verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />पर मी इनमे से कोय भी बात काम मे नी लाये, अरु मेने तो या बातहोन येकालिये नी लिखी कि मरा लिये असो कर्यो जाये, क्युकि येकासे तो मरो मरनो ही भलो हइ. कि कोय मरो घमण्ड बेकार ठैइराये. <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />अगर मी सुसमाचार सुनायु, ते मरो कुछ घमण्ड नी. क्युकि यो तो मरा लिये जरुरती हइ. अरु अगर मी सुसमाचार नी सुनायु, ते मरा पर हाय! <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />क्युकि अगर अपनी इच्छा से यो करस हइ, ते मजदूरी खे मीलस हइ, अरु अगर अपनी इच्छा से नी कर्ये, ते भी भण्डारीपन मेखे दियो गयो हइ. <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />ते फिर मरी कोन सी मजदूरी हइ? यो कि सुसमाचार सुनाना मे मी मसीह को सुसमाचार सेंत-मेत करी दियु ह्या तक कि सुसमाचार मे जो मरो अधिकार हइ, ओखे मी पूरी रीति से काम मे लायु.<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />क्युकि सब सबसे स्वतंत्रता होना पर भी मेने अपना आप खे सब को सेवक बनैइ दियो हइ. कि जादा इन्सान खे खीची लायु. <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />मी यहूदीहोन का लिये यहूदी बन्यो कि यहूदीहोन खे खीची खे लायु, जो इन्सान व्यवस्था का अधीन हइ उनका लिये मी व्यवस्था का अधीन नी हुये पर भी व्यवस्था का अधीन बन्ये कि उनखे जो व्यवस्था का अधीन हइ, खीची लायु. <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />व्यवस्थाहिहोन का लिये मी जो परमेश्वर की व्यवस्था से हीन नी पर मसीह की व्यवस्था का अधीन हइ व्यवस्थाहीन जसो बन्नु कि व्यवस्थाहीनहोन खे खीची लायु. <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />मी नीर्बलहोन का लिये नीर्बल जसो बन्यो कि नीर्बलहोन खे खीची लायु मी सब इन्सानहोन का लिये सब कुछ बन्यो हइ, कि कोय नी कोय रीति से कोय एक को उध्दार करायु.<verse eid="1CO 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 9:23" />अरु मी सब कुछ सुसमाचार का लिये करुस हइ, कि दुसरा का साथ ओको सात हुइ जाये. <verse eid="1CO 9:23" /><verse number="24" style="v" sid="1CO 9:24" />का तुम नी जाने कि दौड मे तो दौडस सब ही हइ, पर इनाम एक ही ली जास हइ? तुम असो ही दौडन का कि जीतनु. <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />अरु हर एक पइलवान सब प्रकार को उछल कुद करस हइ, वे तो एक मुरझानआला मुकुट खे पान का लिये यो सब करस हइ, पर हम तो उ मुकुट का लिये करस हइ, जो मुरझान को नी. <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />येकालिये मी तो यो रीति से दौडुस हइ, पर बेठिकान नी खे मी भी या रीति से मुक्काहोन से लडुस हइ, पर ओका समान नी जो हवा पीटतो हुयो लडस हइ. <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />पर मी अपना आंग खे मारता कूटतो का अरु कब्जा मे लउस हइ. असो नी हो कि दुसरा को प्रचार करीखे खे मी खुद ही कोय रीति से नीकम्मो ठैइर्यु.<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s">इस्राएल का इतिहास से चेतावनी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />हे भैइहोन अरु बहीन, मी नी चाहु कि तुम या बात से अनजान र्‍हेनु कि हमारा सब बुजरुक बद्दल का नीच्चे था, अरु सब का सब समुंदर का बीच से पार हुइ गया. <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />अरु सब ने बद्दल मे, अरु समुंदर मे, मूसा को बपतिस्मा लियो; <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />अरु सब ने एक ही आत्मीक खानो खायो. <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />अरु सब ने एक ही आत्मीक पानी पीयो, क्युकि वे उ आत्मीक चट्टान से पीता था, जो उनका साथ-साथ चलती थी. अरु उ चट्टान मसीह थो. <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />पर परमेश्वर उनमे से भोत जनसे खुश नी थो, येकालिये वे जंगल मे ढेर हुइ गया.<verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />या बातहोन हमारा लिये उदाहरण ठैइरी, कि जसो उनने लालुच कर्यो, ओसो हम बुरी चिजहोन को लालुच नी करणु. <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />अरु नी तुम मुर्ती पूजनआला बन्नु. जसो कि उनमे से खे त्ता बनी गया था, जसो लिख्यो हइ, “इन्सान खान-पीन बठ्या, अरु खेलन-कूदन उठ्यो.” <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />अरु नी हम गलत काम करणु. जसो उनमे से केत्ता ने कर्यो अरु एक दिन मे तेवीस हजार मरी गा. <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />अरु नी हम प्रभु खे पैछान्यो, जसो उनमे से केत्ता ने कर्यो, अरु सापहोन का वजेसे खत्म कर्या गया.<note caller="+" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="NUM 21:5-6">गिनती 21:5-6</ref></char></note> <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />अरु नी तुम कुडकुडनु, जो रीति से उनमे से केत्ता कुडकुडाया अरु खत्म करणआला का वजेसे खत्म कर्या गया.<verse eid="1CO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11" />पर या सब बातहोन खे जो उन पर पडिखे दृष्‍टान्‍त की रीति पर थी. अरु वे हमारी चेतावनी का लिये जो संसार का आखरी टेम टेम मे र्‍हेस हइ लिखी गइ हइ.<verse eid="1CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 10:12" />येकालिये जो समझस हइ, “मी जगापर हइ,” उ चतरो र्‍हेनु. कि खय गिरी नी पड्ये. <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />तुम कोय असी परीक्षा मे नी पड्ये जो इन्सान का सहन का बाहेर हइ अरु परमेश्वर विश्वासयोग्य हइ उ तुमखे सामर्थ्य से बाहेर सैतान परीक्षा मे नी पडन दिये का परीक्षा का साथ रस्ता भी कर्ये कि तुम सै सक्या.<verse eid="1CO 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />यो कारण, हे मरा प्रिय भैइहोन अरु बहीन मूर्ति पूजा से बच्या र्‍हेनु. <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />मी बुद्धिमान जानीखे तुम से बोलुस हइ जो मी बोलुस हइ, ओखे तुम पैछाननू. <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" />उ धन्यवाद को कटोरो,जेका पर हम धन्यवाद करस हइ, का उ मसीह का खुन को संगत नी? वा रोटी जेखे हम तोडस हइ, का मसीह का आंग को हिस्सेदार नी? <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />येकालिये, कि एक ही रोटी हइ ते हम भी जो भोत हइ, एक हइ क्युकि हम सब वइ एक रोटी मे हिस्सेदार होस हइ.<verse eid="1CO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18" />जो आंग खे भाव से इस्राएलीहोन हइ, उनखे देखनु का बलिदानहोन का खानआला वेदी का हिस्सेदार नी? <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />फिर मी का बोलुस हइ? का यो कि मूर्ति को खानो कुछ हइ, या मूर्ती कुछ हइ? <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />नी, बस यो कि गैरयहूदी जो बलिदान करस हइ, वे परमेश्वर का लिये नी पर बुरीआत्माहोन का लिये बलिदान करस हइ अरु मी नी चउस कि तुम बुरीआत्माहोन का हिस्सेदार हुये.<note caller="+" style="x"><char style="xo" closed="false">10:20 </char><char style="xt" closed="false"><ref loc="DEU 32:17">व्यवस्था विवरन 32:17</ref></char></note> <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />तुम प्रभु का कटोरो अरु बुरीआत्मा का कटोरो दोइ मे से नी पी सक्ये! तुम प्रभु की मेज अरु बुरीआत्माहोन की मेज दोइ का हिस्सेदार नी हुइ सखे.<note caller="+" style="x"><char style="xo" closed="false">10:21 </char><char style="xt" closed="false"><ref loc="MAT 6:24">मत्ती 6:24</ref></char></note> <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />का हम प्रभु खे घुस्सा दिलानो चाहस हइ? का हम ओकासे शक्तिमान हइ?<note caller="+" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="DEU 32:21">व्यवस्था विवरन 32:21</ref></char></note><verse eid="1CO 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />सब चिजहोन मरा लिये अच्छी तो हइ, पर सब लाभ की नी सब चिजहोन मरा लिये अच्छी तो हइ, पर सब चिजहोन से उन्नति नी. <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />कोय अपनी ही भलाइ खे नी ढूडनु क्युकी दुसरा की.<verse eid="1CO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25" />जो कुछ कस्साइहोन का ह्या बिकस हइ, उ खानु अरु विवेक का कारण कुछ नी पूछनु. <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />“क्युकि पृथ्वी अरु ओकी पुरीपुरी प्रभु की हइ”<verse eid="1CO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27" />अरु अगर अविश्वासिहोन मे से कोय तुमखे निवतता दिये, अरु तुम जानो चाह्ये, ते जो कुछ तुमारा सामने रख्यो जाये उ खानु अरु विवेक खे कारण कुछ नी पूछनु. <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />पर अगर कोय तुम से बोल्ये, “यो तो मूर्ती खे बलि करी हुइ चिज हइ,” ते उ बतानआला का कारण, अरु विवेक का कारण नी खानु. <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />मरो मतलब, तरो विवेक नी, पर उ दूसरा को भलो,</para>
  <para style="p" vid="1CO 10:29">मरी स्वतंत्रता दूसरा को बिचार से क्यु परख्ये जाये? <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />अगर मी धन्यवाद करीखे हिस्सेदार होउस हइ, ते जेका पर मी धन्यवाद करुस हइ, ओका कारण मरी बदनामी क्यु होस हइ?<verse eid="1CO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31" />येकालिये तुम चाह्ये खाओ, चाह्ये पीओ, चाह्ये जो कुछ करणु, सब कुछ परमेश्वर का महिमा का लिये करणु. <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />तुम नी यहूदीहोन, नी यूनानीहोन, अरु नी परमेश्वर की मंडली का लिये ठोकर को कारण बन्नु. <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />जसो मी भी सब बातहोन मे सब खे खुश रखुस हइ, अरु अपनो नी पर भोतजन को लाभ ढूढस हइ, कि वे उध्दारपाये.<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />तुम मरा जसी चाल चलनु जसो मी मसीह का जसी चाल चलुस हइ.<verse eid="1CO 11:1" /></para>
  <para style="s">प्रार्थना सभा मे माथो झाकन को लिवाज</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />मी तुमारी बडाइ करुस हइ, कि सब बातहोन मे तुम मेखे याद करस हइ. अरु जो वीधी मेने तुमखे दि दियो हइ, रितीरिवाज खे कठोरता से करस हइ. <verse eid="1CO 11:2" /><verse number="3" style="v" sid="1CO 11:3" />पर मी चाहुस हइ, कि तुम यो जानी ले, कि हर एक इन्सान को माथो मसीह हइ अरु लुगइ को माथो इन्सान हइ अरु मसीह को माथो परमेश्वर हइ. <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />जो इन्सान माथो झाक्या हुया प्रार्थना या भविष्यवाणी करस हइ, उ अपनो माथा को अपमान करस हइ. <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />पर जो बय बिना माथो झाखे प्रार्थना या भविष्यवाणी करस हइ, वा अपना माथा का अपमान करस हइ, क्युकि वा टक्कल होना का बराबर हइ. <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />अगर बय ओडनी नी ओड्ये, ते बाल भी काटी ले. अगर बय का लिये बाल कटानो या टक्कल सरम की बात हइ, तो ओडनी होडनु. <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" />हा इन्सान खे अपनो माथो झाकनो अच्छो नी, क्युकि उ परमेश्वर को रुप अरु महिमा हइ. रुप पर लुगइ अदमी की शोभा हइ. <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />क्युकि अदमी लुगइ से नी हुयो, पर लुगइ इन्सान से हुइ हइ.<verse eid="1CO 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 11:9" />अरु अदमी लुगय का लिये नी परदा कर्यो गयो, पर लुगय अदमी का लिये करी गय हइ. <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />येकालिये स्वर्गदूतहोन का कारण लुगइ को अच्छो हइ, कि अधिकार अपना माथा पर रखनु. <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />ते भी प्रभु मे नी ते लुगइ बिना अदमी अरु नी अदमी बिना लुगइ कि हइ. <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />क्युकि जसो लुगइ अदमी से हइ, ओसो ही अदमी लुगइ का वजेसे हइ. पर सब चिजहोन परमेश्वर से हइ.<verse eid="1CO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13" />तुम खुद ही बिचार करणु, का बय खे बिना माथो झाखे परमेश्वर से प्रार्थना करणो अच्छो हइ? <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />का स्वभाविक रीति से भी तुम नी जाने कि अगर अदमी लम्बा बाल रख्ये, ते ओका लिये अपमान हइ. <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />पर अगर बय लम्बा बाल रखनु. ते ओका लिये शोभा हइ क्युकि बाल ओखे ओडन का खे लिये दिया गया हइ. <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />पर अगर कोय वाद विवाद करणो चाह्ये, ते यो जान्नु कि नी हमारी अरु नी परमेश्वर की मंडलीहोन की असी रीति हइ.<verse eid="1CO 11:16" /></para>
  <para style="s">प्रभु खान का बारे मे</para>
  <para style="r">(<ref loc="MAT 26:16-29">मत्ती 26:16-29</ref>; <ref loc="MRK 14:22-25">मरकुस 14:22-25</ref>; <ref loc="LUK 2:14-20">लूका 2:14-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />पर या आज्ञा देता हुये मी तुमारी नी बडैइ, येकालिये कि तुमारा जमा होना से भलाइ नी, पर नुकसान होस हइ. <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />क्युकि पैयले तो मी यो सुनुस हइ, कि जब तुम मंडली मे जमा होस हइ, ते तुम मे फूट होस हइ अरु मी थोडो-थोडो विश्वास भी करुस हइ. <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />क्युकि गैरयहूदी भी तुम मे जरुरती हुये, येकालिये कि जो इन्सान तुम मे सच्चा नीकल्या हइ, वे प्रकट हुइ जाये. <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />जब तुम एक जगह मे जमा हुये ते तुम प्रभु-भोज खानो खान का लिये नी. <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />क्युकि खान का टेम एक दूसरा से पैयले अपनो खानो खैइ लेस हइ, तब कोय भूखो र्हेस हइ, अरु कोय मतआलो हुइ जास हइ. <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />का खान-पीन का लिये तुमारा घर नी? या परमेश्वर की मंडली खे बेकार जानस हइ, अरु जिनका पास नी हइ उनखे लज्जित करस हइ? मी तुम से का बोलु? का या बात मे तुमारी बडइ कर्यु? मी बडइ नी करु.<verse eid="1CO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23" />क्युकि या बात मेखे प्रभु से पहुची, अरु मेने तुमखे भी पहुचैइ दी. कि प्रभु यीशु ने जो रात पकडायो गयो रोटी ली, <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />अरु धन्यवाद करीखे ओखे तोडि खे अरु बोल्यो, “यो मरो आंग हइ, जो तुमारा लिये हइ मरी याद का लिये यो किर्या करणु.” <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />या रीति से ओने बियारी का बाद कटोरो भी लियो, अरु बोल्यो “यो कटोरो मरा खुन मे नइ वाचा हइ जब कभी पीये, ते मरी याद का लिये यो कर्यो करणु.”<note caller="+" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="LUK 22:20">लूका 22:20</ref></char></note> <figure style="fig" alt="Jesus eating the Passover meal with his disciples" file="LB00320C.TIF" size="span" copy="Horace Knowles ©" ref="11:23">यीशु अपना चेलाहोन का साथ फसह को खानो खाते हुये</figure><verse eid="1CO 11:25" /></para>
  <para style="pi">
    <verse number="26" style="v" sid="1CO 11:26" />क्युकि जब कभी तुम या रोटी खाये, अरु यो कटोरा मे से पीस हइ, ते प्रभु को मरन खे जब तक उ नी आय, प्रचार करस हइ.<verse eid="1CO 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 11:27" />येकालिये जो कोय अच्छा रीति से प्रभु की रोटी खाये या ओका कटोरा मे से पीये, उ प्रभु का आंग अरु खुन को अपराधी ठैइर्ये. <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />येकालिये इन्सान अपना आप खे समज्हे अरु या रीति से या रोटी मे से खाह्ये, अरु यो कटोरा मे से पीये. <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />क्युकि जो खाता-पीता टेम प्रभु का आंग खे नी पइछान्ये, उ यो खाना अरु पीना से अपना उपर दण्ड लास हइ. <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />यो कारण तुम मे भोत सा बिना जोर अरु रोगी हइ, अरु भोत सा सोइ भी गया. <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />अगर हम अपना आप खे पहिछानता था ते दण्ड नी मील्हे. <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />पर प्रभु हमखे दण्ड दिखे हमारी ताडनो करस हइ येकालिये कि हम संसार का साथ दोषी नी ठैइर्ये.<verse eid="1CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33" />येकालिये, हे मरा भैइहोन अरु बहीन, जब तुम खान का लिये जमा होस हइ, ते एक दूसरा का लिये ठैइरा करणु. <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />अगर कोय भूखो हइ, ते अपना घर मे खलइ ले जिका से तुमारो जमा होनो दण्ड को कारण नी हो, अरु बाकी बातहोन खे मी अयखे ठीक करी दियु.<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s">पवित्र आत्मा को वरदान</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />हे भैइहोन अरुबहीन, मी नी चाहु कि तुम आत्मीक वरदानहोन का बारे मे अनजान र्‍हिया. <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />तुम समजस हइ, कि जब तुम गैरयहूदीहोन थो, ते मुक्की मूर्ती का पीछे जसो चलायो जातो थो ओसो चलतो थो. <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />येकालिये मी तुमखे चेतावनी देउस हइ कि जो कोय परमेश्वर की आत्मा की अगुअय से बोलस हइ, उ नी बोलस कि यीशु श्रापित हइ. अरु नी कोय पवित्र आत्मा का बिना बोली सकस हइ कि यीशु प्रभु हइ.<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />वरदान तो कइ प्रकार को हइ, पर आत्मा एक ही हइ. <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />अरु सेवा भी कइ प्रकार की हइ , पर प्रभु एक ही हइ. <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />अरु प्रभावशाली कार्य कइ प्रकार का हइ, पर परमेश्वर एक ही हइ, जो सब मे हर प्रकार को प्रभाव परदा करस हइ. <verse eid="1CO 12:6" /><verse number="7" style="v" sid="1CO 12:7" />पन सब खे लाभ पहुचान का लिये हर एक खे आत्मा का उजालो दियो जास हइ. <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />क्युकि एक खे आत्मा का द्वारा बुद्धि की बातहोन दी जास हइ. अरु दूसरा खे उ आत्मा का अनुसार ज्ञान की बातहोन. <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />अरु कोय खे उ आत्मा से विश्वास. अरु कोय खे उ एक आत्मा से अच्छो करण को वरदान दियो जास हइ. <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />फिर कोय खे सामर्थ्य का काम करण की शक्ति. अरु कोय खे भविष्यवाणी की. अरु कोय खे आत्माहोन खे पैछनन खे अरु कोय खे भोत प्रकार की भाषा. अरु कोय खे भाषाहोन को अर्थ बतानो. <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />पर ये सब प्रभाकुलाली कार्य उ एक आत्मा करवास हइ, अरु जेखे जो चाहस हइ उ बाटी देस हइ.<verse eid="1CO 12:11" /></para>
  <para style="s">कइ हिस्सा का साथ एक आंग</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />क्युकि जो प्रकार आंग तो एक हइ अरु ओका हिस्सा भोत हइ, अरु उ एक आंग का सब हिस्सा, भोत होना पर भी सब मीलीखे एक ही आंग हइ, उ प्रकार मसीह भी हइ. <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />क्युकि हम सब ने का यहूदी हइ, का यूनानी, का सेवक का स्वतंत्रता एक ही आत्मा का वजेसे एक आंग होन का लिये बपतिस्मा लियो, अरु हम सब खे एक ही आत्मा पिलायो गयो.<verse eid="1CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14" />येकालिये कि आंग मे एक ही हिस्सो नी पर भोत सा हइ. <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />अगर पाय बोल्ये कि मी हात नी, येकालिये आंग को नी, ते का उ वो कारण आंग को नी? <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />अरु अगर कान बोल्ये, “मी आख नी, एकालिये आंग को नी,” ते का उ या कारण आंग को नी? <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />अगर पुरो आंग आख ही होतो ते सुन्नो खा से होतो? अगर पुरो आंग कान ही होतो ते सूघनो खा होतो? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />पर सचमुच परमेश्वर ने हिस्साहोन खे अपनी इच्छा का अनुसार एक-एक करीखे आंग मे रख्यो हइ. <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />अगर वे सब एक ही हिस्सा होता, ते आंग खा होतो? <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />पर अब हिस्सा तो भोत सा हइ, पर आंग एक ही हइ.<verse eid="1CO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21" />आख हात से नी बोली सखे, “मेखे तरो प्रयोजन नी,” अरु नी माथो पायहोन से बोली सकस हइ, “मेखे तुमारो प्रयोजन नी” <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />पर आंग का वे हिस्सो जो दुसरा जन से निर्बल देखी पडस हइ, भोत ही जरुरती हइ. <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />अरु आंग खे जिन हिस्साहोन खे हम कम आदरणीय समझस हइ उन्ही खे हम जादा आदर देस हइ. अरु हमारी शोभाहीन हिस्‍सा अरु भी भोत शोभायमान हुइ जास हइ, <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />फिर भी हमारो शोभायमान हिस्साहोन खे येको प्रयोजन नी, पर परमेश्वर ने आंग खे असो बनय दियो हइ कि जो हिस्सा खे घटी थी ओ खे अरु भी भोत आदर होनु. <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />ताकि आंग मे फूट नी पड्ये, पर हिस्सा एक दूसरा की बराबर फिकर कर्ये. <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />येकालिये अगर एक हिस्सो दुख पास हइ, ते सब हिस्सो ओका साथ दुख पास हइ. अरु अगर एक हिस्सा की बडाइ होस हइ, ते ओका साथ सब हिस्सा खुशी मनसा हइ.<verse eid="1CO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27" />यो प्रकार तुम सब मीलीखे मसीह को आंग हइ, अरु अलग-अलग ओका हिस्सा होनु.<verse eid="1CO 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CO 12:28" />अरु परमेश्वर ने मंडली मे अलग-अलग इन्सान नीयुक्त कर्यो हइ. पयलो प्रेरित, दूसरो भविष्यव्दक्ता तीसरो मास्तर फिर सामर्थ्य का काम करणआलो, फिर अच्छो करणआलो, अरु उपकार करणआलो, अरु मुखियो, अरु अलग प्रकार की भाषा बोलनआला. <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />का सब प्रेरित हइ? का सब भविष्यव्दक्ता हइ? का सब उपदेशक हइ? का सब सामर्थ्य का काम करणआला हइ? <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />का सब खे अच्छो करण को वरदान मील्यो हइ? का सब अलग प्रकार की भाषा बोलस हइ? <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />का सब भाषांतर करस हइ? तुम बडा से बडा वरदानहोन की धुन मे र्‍हेनु! पर मी तुमखे</para>
  <para style="p" vid="1CO 12:31">अरु भी सबसे अच्छी रस्ता बतउस हइ.<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s">प्रेम</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />अगर मी इन्सानहोन खे अरु स्वर्गदूतहोन की बोलिहोन बोल्यु, अरु प्रेम नी रख्यु, ते मी तो हुयो पीतल, अरु झझनाती हुइ झाझ हइ. <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" />अरु अगर मी भविष्यद्वाणी करी सक्यु, अरु सब भेदहोन अरु सब प्रकार को ज्ञान खे समझ्यु, अरु मेखे ह्या तक पूरो विश्वास हइ कि मी टेकडी खे हट्ये दियु, पर प्रेम नी रख्यु, ते मी कुछ भी नी. <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />अरु अगर मी अपनी पुरी संपत्ती कगालहोन खलय दियु का या अपनी आंग जलान का लिये दि दियु कि अरु प्रेम नी रख्यु कितना मेखे कुछ भी लाभ नी.<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />प्रेम धीरजवन्त हइ, अरु कृपालु हइ. प्रेम हेवो नी कर्‍हे. प्रेम अपनी बडाइ नी कर्येका अरु फूले नी. <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />नी शोभनआलो व्यवहार नी कर्येका उ अपनी भलाइ नी चाह्ये, झुझलाय नी, बुरा नी माने. <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />बुरोकाम से खुश नी होय, पर सच्ची से खुश होस हइ. <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />उ सब बातहोन सैइ लेस हइ, सब बातहोन पर विश्वास करस हइ, सब बातहोन की आस रखस हइ, सब बातहोन मे धीरज धरस हइ.<verse eid="1CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8" />प्रेम कभी खत्म नी भविष्यद्वानीहोन हुये खे ते खत्म हुइ जाये का भाषाहोन मेको हुइ जाये. ज्ञान हुये ते मीटी जाये. <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />क्युकि हमारो ज्ञान अधूरो हइ, अरु हमारी भविष्यद्वाणी अधूरी. <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />पर जब सर्व सिद्ध अउ का ते अधूरो मीटी जाये.<verse eid="1CO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11" />जब मी बच्चो थो, ते मी बच्चाहोन, जसो बोलतो थो, बच्चाहोन, जसो मन थो बच्चाहोन जसी समझ थी. पर सयानो हुइ गया ते बच्चाहोन की बातहोन छोडी दी. <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />अब हम खे अयना मे धुधला सो दिखइ देस हइ. पर वा टेम्म आमने-सामने देख्ये यो टेम मरो ज्ञान अधूरो हइ. पर वा टेम असी पूरी रीति से पैछान्यु, जसो मी पैछान्यो गयो हइ.<verse eid="1CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13" />पर अब विश्वास कि आस को प्रेम ये तीनी का येमे हइ, पर इनमे सबसे बडो प्रेम हइ.<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s">दुसरी भाषाहोन अरु भविष्यद्वाणी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />प्रेम को अनुकरण करणु, अरु आत्मीक वरदानहोन का भी धुन मे र्‍हेनु खास करी, यो, कि भविष्यद्वाणी करणु. <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />क्युकि जो दुसरी भाषा मे बातहोन करस हइ. उ इन्सानहोन से नी पर परमेश्वर से बातहोन करस हइ. येका लिये कि ओकी बातहोन कोय नी समझ्ये. क्युकि उ भेद की बातहोन आत्मा मे हुये खे बोलस हइ. <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />पर जो भविष्यद्वाणी करस हइ, उ इन्सानहोन से उन्नती अरु उपदेश अरु शांती की बातहोन बोलस हइ. <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />जो दुसरी भाषा मे बातहोन करस हइ, उ अपनी ही उन्नती करस हइ. पर जो भविष्यद्वाणी करस हइ, उ मंडली की उन्नती करस हइ.<verse eid="1CO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5" />मी चाहुस हइ, कि तुम सब दुसरी भाषाहोन मे बातहोन करणु, पर जादा ते यो चाहस हइ कि भविष्यद्वाणी करणु क्युकि अगर दुसरी भाषा बोलनआला मंडली की उन्नती का लिये भाषातर नी कर्ये ते भविष्यद्वाणी करणआला ओकासे बडीखे हइ. <verse eid="1CO 14:5" /><verse number="6" style="v" sid="1CO 14:6" />येका लिये हे भैइहोन अरु बहीन, अगर मी तुमारा पास अयखे दुसरी भाषा मे बातहोन कर्यु, अरु उजालो या ज्ञान, या भविष्यद्वाणी या उपदेश की बातहोन तुम से नी बोल्यु ते मरा मे तुम खे लाभ हुये?<verse eid="1CO 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 14:7" />यो प्रकार अगर नीर्जीव चिज भी जिनसे आवाज नीकलस हइ जसो बासरी या बीन, अगर उनका अवाजहोन मे भेद नी हुये ते जो फूक्यो या बजायो जास हइ, उ क्यु पैछान्यो जाये? <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />अरु अगर पिपडी को आवाज साफ नी हुये ते कोन लडय का लिये तैयारी कर्ये? <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />असो ही तुम भी अगर जीभ से साफ बातहोन नी बोल्ये का ते जो कुछ बोल्यो जास हइ? वोखे समझी जाये? तुम ते हवा से बातहोन करणआला ठैर्ये. <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />जगत मे खे त्ता ही रंग की भाषाहोन क्यु नी हो, पर उनमे से कोय भी बिना मतलब की नी हुये. <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />येका लिये अगर मी कोय भाषा को मतलब नी समझ्यु, ते बोलनआला की नजर मे परदेशी ठैर्ये. अरु बोलनआला मरी नजर मे परदेशी ठैइऱ्ये. <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />येका लिये तुम भी जब आत्मीक वरदानहोन की धुन मे हुये खे ते असी कोशीस करणु, कि तुमारा वरदानहोन की उन्नती से मंडली की उन्नती हुये. <verse eid="1CO 14:12" /><verse number="13" style="v" sid="1CO 14:13" />यो करण जो दुसरी भाषा बोल्येका ते उ प्रार्थना कर्येका कि ओको भाशांतर करी सक्ये. <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />येका लिये अगर मी दुसरी भाषा मे प्रार्थना कर्यु, ते मेरी आत्मा प्रार्थना करस हइ, पर मरी बुद्धि काम नी दे. <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />ते का करण खे हुनु? मी आत्मा से भी प्रार्थना कर्यु, अरु दिमाक से भी प्रार्थना कर्यु. मी आत्मा से गायु, अरु दिमाक से भी गायु. <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />नी ते अगर तू आत्मा ही से धन्यवाद कर्ये, ते फिर अज्ञानी तरो धन्यवाद पर आमीन क्यु बोल्यु? येकालिये कि उ तो नी जाने, कि तूका बोलस हइ? <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />तू तो भली भाति से धन्यवाद करस हइ, पर दूसरा की उन्नती नी होय. <figure style="fig" alt="musical instruments" file="HK00188C.TIF" size="col" copy="Horace Knowles ©" ref="14:7">गीत बजान का चिज</figure><verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />मी अपना परमेश्वर को धन्यवाद करुस हइ, कि मी तुम सबसे जादा दुसरा भाषा मे बोलस हइ. <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />पर मंडली मे दुसरा भाषा मे दस हजार बातहोन बोलना से यो मेखे अरु भी अच्छो जानी पडस हइ, कि दुसरा खे सिखाना का लिये दिमाक से पाच ही बातहोन बोल्यु.<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />हे भैइ अरु बहीन, तुम समझ मे बच्चा नी बन्नु फिर भी बुराइ मे तो बच्चा र्‍हेनु, पर समझ मे सयानो बन्नु. <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />व्यवस्था मे लिख्यो हइ,</para>
  <para style="q1" vid="1CO 14:21">कि प्रभु बोसल हइ,</para>
  <para style="q2" vid="1CO 14:21">“मी दुसरा भाषा बोलनआला का वजेसे, अरु पराया मुडा का वजेसे</para>
  <para style="q1" vid="1CO 14:21">इन इन्सानहोन से बात कर्यु</para>
  <para style="q2" vid="1CO 14:21">ते भी वे मरी नी सुन्ये.”<verse eid="1CO 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22" />येका लिये दुसरी भाषाहोन विश्वासिहोन का लिये नी, पर अविश्वासीहोन का लिये चिन्ह हइ, अरु भविष्यद्वाणी अविश्वासीहोन, लिये नी पर विश्वासीहोन, लिये चिन्ह हइ.<verse eid="1CO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23" />ते अगर मंडली एक जगह जमा हुये खे अरु सब का सब दुसरा भाषा बोल्येका अरु बाहरआला या अविश्वासी इन्सान अंदर अय जाये ते का वे तुम खे पागल नी बोल्ये? <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />पर अगर सब भविष्यद्वाणी करण लग्येका अरु कोय अविश्वासी या बाहरआला इन्सान अंदर अय जायेका ते सब ओखे दोषी ठैइऱ्यो दिये अरु परखी लिये. <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />अरु ओका मन को भेद प्रगट हुइ जाये अरु तब उ मुडा का बल गिरीखे परमेश्वर खे नमस्कार कर्ये, अरु मानी लिये, कि सचमेच परमेश्वर तुमारा बीच मे हइ.<verse eid="1CO 14:25" /></para>
  <para style="s">उपासना मे अनुशासन</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />येका लिये हे भैइहोन अरुबहीन खे करण हुनु? जब तुम इकठ्ठा होस हइ, ते हर एक का मन मे भजन या उपदेश या दुसरी भाषा या प्रकाशन या दुसरी भाषा को अर्थ बतानो र्‍हेस हइ सब कुछ आत्मीक उन्नती का लिये होन खे हुनु. <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />अगर दुसरी भाषा मे बातहोन करणो हइ, ते दो-दो से या भोत हो तो तीन-तीन जन बारी-बारी बोल्येका अरु एक इन्सान भाषातर कर्ये. <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />पर अगर भाषातर करणआला नी हुये, ते दुसरी भाषा बोलनआला मंडली मे शान्त र्‍हिये अरु अपना मन से अरु परमेश्वर से बातहोन कर्ये. <verse eid="1CO 14:28" /><verse number="29" style="v" sid="1CO 14:29" />भविष्यव्दक्ताहोन मे से दो या तीन बोल्ये, अरु कुछ इन्सान उनको वचन खे पैछान्ये. <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />पर अगर दूसरा पर जो बठ्यो हइ, कुछ इश्वरी उजालो हुये ते पयलो चुप हुइ जाये. <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />क्युकि तुम सब एक-एक करी खे भविष्यद्वाणी करी सकस हइ ताकि सब सीख्ये का अरु सब शांती पाये. <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />अरु भविष्यव्दक्ताहोन की आत्मा भविष्यव्दक्ताहोन कि बस मे हइ. <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />क्युकि परमेश्वर गडबड खे नी, पर शांती को कर्ता हइ.</para>
  <para style="p" vid="1CO 14:33">जसो पवित्र इन्सानहोन की सब मंडलीहोन मे हइ. <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />बय मंडली की सभा मे चुप र्‍हियेका क्युकि उनका बातहोन करण की इजाजत नी, पर अधीन र्‍हेन की आज्ञा हइ जसो व्यवस्था मे लिख्यो भी हइ. <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />अरु अगर वे कुछ सीखनो चाह्ये, ते घर मे अपना-अपना अदमी से पूछ्येका क्युकि बय को मंडली मे बातहोन करणो लाज की बात हइ.<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />क्यु परमेश्वर को वचन तुम मे से नीकल्यो? या फक्त तुम ही तक पहुच्यो हइ? <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />अगर कोय इन्सान अपना आप खे भविष्यव्दक्ता या आत्मीक जन समझ्ये का ते यो जानी ले कि जो बातहोन मी तुम खे लिखुस हइ, वे प्रभु की आज्ञाहोन हइ. <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />पर अगर कोय नी मान्ये का ते नी मान्ये.<verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />हे भैइहोन अरु बहीन, भविष्यद्वाणी करण की धुन मे र्‍हिये अरु दुसरी भाषा बोलन से मना नी करणु. <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />पर पुरी बातहोन सभ्यता अरु क्रमा नुसार करी जाये.<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s">पौलुस को सुसमाचार अरु मसीह को फिर से जि उठनो</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />हे भैइहोन अरु बहीन, मी तुमखे उ सुसमाचार बतउस हइ जो पैयले सुन चुक्यो हइ, जेखे तुम ने अंगीकार कर भी कर्यो थो अरु जेमे तुम स्थिर भी हइ. <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />ओका वजेसे तुमारो उध्दारभी होस हइ, अगर उ सुसमाचार खे जो मेने तुमखे सुनायो थो याद रखस हइ. नी ते तुमारो विश्वास करणो बेकार हुयो.<verse eid="1CO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3" />या करण मेने सबसे पैयले तुमखे उ बात पहुचय दी, जो मेखे पहुचैइ थी, कि पवित्रशास्त्र को वचन का जसो यीशु मसीह हमारो पापहोन का लिये मरी गयो. <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" />अरु गाड्यो गयो. अरु पवित्रशास्त्र का जसो तीसरे दिन जिन्दो भी उठ्यो, <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />अरु कैफा खे तब बाराझन खे दिखैइ दियो. <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />फिर पाच सौ से जादा भैइहोन अरु बहीन खे एक साथ दिखैइ दियो, जिनमे से भोत सारा अब तक वर्तमान हइ पर केत्ता सोइ गया. <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />फिर याकूब खे दिखैइ दियो तब सब प्रेरितहोन खे दिखैइ दियो.<verse eid="1CO 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 15:8" />अरु सब का बाद मेखे भी दिखइ दियो, जो मान्नु अधूरा दिन को जन्म्यो हइ. <verse eid="1CO 15:8" /><verse number="9" style="v" sid="1CO 15:9" />क्युकि मी प्रेरितहोन मे सबसे छोटो हइ, क्युकी प्रेरित बोल्यो जाना का योग्य भी नी, क्युकि मेने परमेश्वर की मंडली खे सतायो थो. <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />पर मी जो कुछ भी हइ, परमेश्‍वर को अनुग्रह से हइ, अरु ओको अनुग्रह जो मरा पर हुयो, उ बेकार नी हुयो पर मेने उन सबसे बडी खे मेहनत भी कर्यो ते भी या मरा तरफ से नी हुयो पर परमेश्वर को अनुग्रह से जो मरा पर थो. <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />येका लिये चाह्ये मी हइ, चाह्ये वे हुये, हम योही प्रचार करस हइ, अरु येका पर तुम ने विश्वास भी कर्यो.<verse eid="1CO 15:11" /></para>
  <para style="s">मर्या हुया को फिर से जिन्दो होनु</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />जब कि मसीह को यो प्रचार कर्यो जास हइ, कि उ मर्या हुया मे से जिन्दो उठ्यो, ते तुम मे से केत्ता क्यु बोलस हइ, कि मर्या हुया को फिर से जिन्दो हइ ही नी? <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />अगर मर्या हुया को पुनरुत्थान हइ ही नी, ते मसीह भी नी जिन्दो उठ्यो. <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />अरु अगर मसीह नी जिन्दो उठ्यो, ते हमारो प्रचार करणो भी बेकार हइ. अरु तुमारो विश्वास भी बेकार हइ. <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />क्युकी हम परमेश्‍वर खे झूठा गवाह ठैइऱ्यो. क्युकि हमने परमेश्‍वर का बारे मे या गवइ दी कि ओने मसीह को जिन्दो दियो फिरभी नी जिन्दो दियो अगर मर्या हुया नी जी उठे. <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />अरु अगर मुर्दा नी जिन्दो उठे, ते मसीह भी नी जी उठ्यो. <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />अरु अगर मसीह नी जिन्दो उठ्यो, ते तुमारो विश्वास बेकार हइ. अरु तुम अब तक अपना पापहोन मे फस्या हइ. <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />याने जो मसीह मे सोइ गया हइ, वे भी खत्म हुया. <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />अगर हम फक्त यो जिवन मे मसीह से आस रखस हइ ते हम सब इन्सानहोन से जादा अभागो हइ.<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />पर सचमेच मसीह मुर्दा मे से जिन्दो उठ्यो हइ, अरु जो सोइ गया हइ, उनमे परइलो फल हुयो. <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />क्युकि जब इन्सान, वजेसे मरन आयो. ते इन्सान ही, वजेसे मर्या हुया खे पुनरुत्थान भी आयो. <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />अरु जसो आदम मे सब मरस हइ, ओसो ही मसीह मे सब जिलाया जाये. <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />पर हर एक अपनी-अपनी बारी से. पयलो फल मसीह फिर मसीह का आना पर ओका इन्सान. <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />येका बाद अन्त हुये. उ टेम उ पुरी प्रधानता अरु पुरो अधिकार अरु सामर्थ्य, आखरी तक करी, राज्य को परमेश्वर बाप का हात मे दि दिये. <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />क्युकि जब तक कि उ अपना दुशमनहोन खे अपना पायहोन तल्ले नी ली अउ का तब तक ओको राज्य करणो जरुरती हइ. <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />सबसे आखरी दुशमन जो खत्म कर्या जाये उ मरन हइ. <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />क्युकि “परमेश्वर ने सब कुछ ओका पायहोन का तल्ले करी दियो हइ,” पर जब उ बोलस हइ कि सब कुछ ओका अधीन करी दियो गयो हइ ते सफा हइ, कि जे ने सब कुछ मसीह का अधीन करी दियो, उ खुद अलग र्हियो. <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />अरु जब सब कुछ ओका अधीन हुइ जायेका ते बेटो खुद भी ओका अधीन हुइ जाये जे ने सब कुछ ओका अधीन करी दियो. ताकि सब मे परमेश्वर ही सब कुछ हइ. <verse eid="1CO 15:28" /><verse number="29" style="v" sid="1CO 15:29" />नी ते जो इन्सान मर्या हुया, लिये बपतिस्मा लेस हइ, वे, कर्ये? अगर मुर्दा जिन्दो उठे ही नी ते फिर का उनका लिये बपतिस्मा लेस हइ? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />अरु हम भी का हर घडी जोखिम मे पड्या र्‍हेस हइ? <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />हे भैइहोन अरु बहिन, मेखे उ घमण्ड की कसम जो हमारा प्रभु मसीह यीशु मे मी तुमारा बारे मे करुस हइ, कि मी हरदिन मरुस हइ. <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />अगर मी इन्सान का रीति पर इफिसुस मे जंगल जनवरहोन से लड्यो ते मेखे का लाभ हुयो? अगर मेर्दा जिलाया नी जायेका “ते वे, खाये पीये का क्युकि कल तो मर ही जाये.”<verse eid="1CO 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33" />धोखो नी खानो, “बुरी संगति अच्छा चरित्र खे बिगाडी देस हइ.” <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />जाग बठनु अरु पाप नी करण. क्युकि तुम्हे खे त्ता असा हइ जो परमेश्वर का नी जाने का मी तुम बेसरम का लिये यो बोलुस हइ.<verse eid="1CO 15:34" /></para>
  <para style="s">हम खे कसो आंग मील्ये?</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />अब कोय यो बोल्येका “मुर्दा कोनता रीति से जिन्दो उठस हइ, अरु कोय आंग का साथ आस हइ?” <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />हे नीर्बुद्धि! जो कुछ तू बोस हइ, जब तक उ नी मर्या जिलाय नी जाय. <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />अरु जो तू बोस हइ, यो उ आंग नी जो परदा होनआली हइ, पर उघडो बिज हइ, चाह्ये गहु को चाह्ये कोय अरु अनाज. <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />पर परमेश्वर अपनी इच्छा खे जसो ओखे आंग देस हइ. अरु हर एक बीज का ओको खास आग.<verse eid="1CO 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 15:39" />सब आंग एक समान नी, पर इन्सानहोन को आंग अरु हइ, जनवरहोन को आंग अरु हइ. पंछी को आंग अरु हइ. मच्छीहोन को आंग अरु हइ.<verse eid="1CO 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40" />स्वर्गीय आंग हइ, अरु पार्थिव आंग भी हइ पर स्वर्गीय आंग होन को तेज अरु हइ, अरु पार्थिव को अरु. <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />सूरज को तेज अरु हइ, चाद को तेज अरु हइ, अरु तारागणहोन को तेज अरु हइ, क्युकि एक तारा से दूसरा तारा को तेज मे अन्तर हइ.<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />मेर्दा को जी उठनो भी असो ही हइ आंग नाशवान दशा मे बोयो जास हइ, अरु अविनाशी रुप मे जिन्दो उठस हइ. <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />उ अनादर, साथ बोयो जास हइ, अरु तेज, साथ जिन्दो उठस हइ. बिना ताखत का साथ बोयो जास हइ. अरु सामर्थ्य का साथ जिन्दो उठस हइ. <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />स्वभाविक आंग बोयो जास हइ, अरु आत्मीक आंग जिन्दो उठस हइ जब कि स्वभाविक आंग हइ, ते आत्मीक आंग भी हइ. <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" />असो ही लिख्यो भी हइ, “परइलो इन्सान, मनज्हे आदम जिन्दो जनवर बन्यो” जान अरु आखरी आदम, जीवन दायक आत्मा बन्यो. <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />पर पैयले आत्मीक नी थो, पर स्वभाविक थो, येका बाद आत्मीक हुयो. <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />परइलो इन्सान धरती से मनज्हे मट्टी को थो. दूसरो इन्सान स्वर्गीय हइ. <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />जसो उ मट्टी को थो ओसो ही वे भी हइ जो मट्टी, हइ. अरु जसो उ स्वर्गीय हइ, ओसो ही वे भी स्वर्गीय हइ. <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />अरु जसो हमने ओको रुप जो मट्टी को थो धारण कर्यो ओसो उ स्वर्ग को रुप भी धारण कर्ये.<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />हे भैइहोन अरु बहीन, मी यो बोलुस हइ कि मास अरु खुन परमेश्‍वर को राज्य को अधिकारी नी हुइ सक्येका अरु नी नाशवान अविनाशी को अधिकारी हुइ सकस हइ. <verse eid="1CO 15:50" /><verse number="51" style="v" sid="1CO 15:51" />देखनु, मी तुम से भेद की बात बोलुस हइ कि हम सब तो नी सोये, पर सब बदली जाये.<verse eid="1CO 15:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="1CO 15:52" />अरु यो जरा भर मे, पलक मारते ही आखरी तुतारी फूकते ही हुये क्युकि पिपडी फुकी जाये अरु मुर्दा अविनाशी दशा मे जिन्दो उठाये जाह्ये अरु हम बदली जाये. <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />क्युकि जरुरती हइ, कि उ नाशवान आंग अविनाश खे पेनी ले, अरु यो मरनहार आंग अमरता खे पेनी ले. <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />अरु जब यो नाशवान अविनाश खे पेनी लियेका अरु यो मरनहार अमरता खे पेनी लिये तब उ वचन जो लिख्यो हइ, पूरो हुइ जाये “जय ने मरन के गिरी लिये.<verse eid="1CO 15:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="1CO 15:55" />“हे मरन तरी जय खा हइ?</para>
  <para style="q1" vid="1CO 15:55">हे मरन तरो डक खा र्‍हियो?”<verse eid="1CO 15:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="1CO 15:56" />मरन को डक पाप हइ. अरु पाप को बल व्यवस्था हइ. <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />पर परमेश्वर को धन्यवाद हुये, जो हमारा प्रभु यीशु मसीह का वजेसे हम जयवन्त करस हइ.<verse eid="1CO 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58" />येका लिये हे मरा प्रिय भैइहोन अरु बहीन, ताखत अरु अटल र्‍हेनु, अरु प्रभु को काम मे सर्वदा बडता जानु, क्युकि यो जानस हइ, कि तुमारी मेहनत प्रभु मे बेकार नी हइ.<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s">यरुशलेम की मंडली, लिये दान</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />अब उ चन्दा का बारे मे जो पवित्र इन्सानहोन का लिये कर्यो जास हइ, जसो मेने गलातिया कि मंडलीहोन खे दी, ओसो ही तुम भी करणु. <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />हप्ता का पयलो दिन तुम मे से हर एक अपनी कमय खे जसो कुछ अपना पास रखी छोड बोल्यो, कि मरा आना पर पैसा जमा नी करणु पडन को. <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />अरु जब मी आयु का ते समज्हे जिनको तुम चाह्ये उनका मी चिट्ठिहोन दिखे भेजी दियु कि यरुशलेम पहुचय दे. <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />अरु अगर मरो भी जानो अच्छो हुयो, ते वे मरा साथ जाये.<verse eid="1CO 16:4" /></para>
  <para style="s">जत्रा को कार्यक्रम</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />अरु मी मकिदुनी हुइ, तुमारा पास आयु, क्युकि मेखे मकिदुनी हुइ, जानो ही हइ. <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />पर सम्भव हइ कि तुमारा ह्या ही ठैइरी जाह्यु अरु शरद ऋतु तुमारा ह्या काटी खे तब जो तरफ मरो जानो हुये खे वय तरफ तुम मेखे पहुच्ये दे. <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />क्युकि मी अब रस्ता मे तुम से मीलन करणो नी चाहु. पर मेखे आस हइ, कि अगर प्रभु चाह्ये ते कुछ टेम तक तुमारा साथ र्‍हियु.<verse eid="1CO 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8" />पर मी पिन्तेकुस्त तक इफिसुस मे र्‍हियु. <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />क्युकि मरा लिये एक बडो अरु उपयोगी दरवाजा खुल्या हइ अरु विरोधी भोत सा हइ.<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />अगर तीमुथियुस अय जाये, ते देखनु कि उ तुमारा ह्या हिम्मत से र्हिये. क्युकि उ मरो जसो प्रभु को काम करस हइ. <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />येका लिये कोय ओखे बेकार नी जान्येका पर ओखे कुशल से उ तरफ पहुच्ये देनु कि मरा पास अय जाये. क्युकि मी ओकी रस्ता देखते र्हेस हइ कि उ भैइहोन अरु बहीन का साथ आये.<verse eid="1CO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12" />अरु भैइ अरु बहीन अपुल्लोस से मेने भोत प्रार्थना करी हइ कि तुमारा पास भैइहोन अरु बहीन, साथ जाये. पर ओने वा टेम जानन की कुछ भी इच्छा नी करी, पर जब अवसर पायेका तब अय जाये.<verse eid="1CO 16:12" /></para>
  <para style="s">आखरी आदेश</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />जागते र्‍हेनु, विश्वास मे स्थिर र्‍हेनु, शुर बन्नु, ताकतवर होनु. <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />जो कुछ करस हइ प्रेम से करणु.<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />हे भैइहोन अरु बहीन, तुम स्तिफनास का घराना का जानस हइ, कि वे अखाया को पैयले फल हइ, अरु पवित्र इन्सानहोन की का लिये तैयार र्हेस हइ. <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />येकालिये मी तुम से प्रार्थना करुस हइ कि असा अधीन र्हेनु, क्युकी हर एक का जो यो काम मे मेहनती अरु सहकर्मी हइ.<verse eid="1CO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17" />अरु मी स्तिफनास अरु फूरतूनातुस अरु अखइकुस का आना से खुश हइ, क्युकि उनने तुमारी घटी, पूरी करी हइ. <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />अरु उनने मरी अरु तुम्हारी आत्मा खे चैन दियो हइ येका लिये असा खे मान्नु.<verse eid="1CO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />आसिया की मंडलीहोन का तरफ से तुम खे नमस्कार. अक्विला अरु प्रिस्किल्ला का अरु उनका घर की मंडली खे भी तुम खे प्रभु मे भोत भोत नमस्कार. <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />सब भैइहोन अरु बहीन को तुम खे नमस्कार</para>
  <para style="p" vid="1CO 16:20">पवित्र चुम्मा से आपस मे नमस्कार करणु.<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />मी पौलुस खे अपना हात को लिख्या हुयो नमस्कार अगर कोय प्रभु से प्रेम नी रख्ये ते उ श्रापित हुये.<verse eid="1CO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22" />हमारो प्रभु मे प्रेम नी रखे ते अभिश्राप मील्हे! हे प्रभु से आन आलो हइ.<verse eid="1CO 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23" />प्रभु यीशु मसीह को अनुग्रह तुम पर होतो र्हिये.<verse eid="1CO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24" />मरो प्रेम मसीह यीशु मे तुम सब का साथ र्‍हिये आमीन.<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>