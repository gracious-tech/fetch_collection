<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JUD" style="id">- Gowlan</book>
  <para style="h">यहूदा</para>
  <para style="toc3">यहूदा</para>
  <para style="toc2">यहूदा</para>
  <para style="toc1">यहूदा की चिठ्ठी</para>
  <para style="mt2">यहूदा की चिठ्ठी</para>
  <para style="mt1">यहूदा की चिठ्ठी</para>
  <para style="imt">पैछान</para>
  <para style="ip">तीतुस का पैछान तीतुस की किताब पौलुस से चार अक्षरहोन मे से एक हइ कि एक इन्सान का बजाय 1 चर्च को संबोधित कर र्‍हा हइ. तीन चिठ्ठी हइ अरु फिलेमोन पौलुस तीतुस खे लिखी र्‍हा था, लेकिन उनने ह्या भी लिख्यो थो जसो कि चिठ्ठी सार्वजनीक रुप से जोर से पडी जै सकस हइ. हम ह्या मालुम करी सकस हइ क्युकि वे 1 प्रेरित का रुप मे अपनी योग्यता बतास हइ, कुछ हइ कि तीतुस पैयले से जान्यो जास हइ. पौलुस शायद 60 साल का बीच कुछ टेम मसीह को जन्म का</para>
  <para style="ip">बाद या चिठ्ठी लिखी थी. पौलुस तीतुस का लिये चर्चहोन कि क्रेते का द्वीप पर था नेतृत्व हिदायत दी थी. पौलुस ने या चिठ्ठी लिखी हइ ताकि चर्चित मुखीयाहोन को चयन अरु प्रशिक्षण पर तीतुस नीर्दोश दियो जै सक्ये. उनने तीमुथियुस खे अपनी चिठ्ठीहोन मे यो तरह से नीर्दोश दियो थो. उनका चिठ्ठी को वर्णन कसा चर्च का मुखीयाहोन खे एक उच्च स्तर पर आयोजित कर्यो जान होनु. चर्चहोन अरु मंडली मुखीयाहोन आज को नेतृत्व मे उनका लिये जरुरी इन्सान का प्रती सावधान ध्यान देन.</para>
  <para style="iot">रुप रेखा</para>
  <para style="io1">1. झुड सबसे पैयले अपना पाठकहोन खे संबोधित करस हइ <char style="ior"><ref loc="JUD 1:1-2">1—2</ref></char></para>
  <para style="io1">2. येका बाद उ लिखन को अपनो कारण बतास हइ जो उनखे झुठा शिक्षकहोन का खिलाप चेतावनी देस हइ<char style="ior"><ref loc="JUD 1:3-4">3—4</ref> </char></para>
  <para style="io1">3. ओका बाद उ पुराना नीयम मे दुन्याहोन अरु घटनाहोन को उदाहरन देस हइ <char style="ior"><ref loc="JUD 1:5-16">5—16</ref> </char></para>
  <para style="io1">4. फिर उ ओखे बतास हइ कि चेतावनी पर उनकी प्रतीक्रिया को होनु चास <char style="ior"><ref loc="JUD 1:17-23">17—23</ref> </char></para>
  <para style="io1">5. आखरी मे उ इश्वर कि स्तुती करता हुये चिठ्ठी खे खतम करस हइ <char style="ior"><ref loc="JUD 1:24-25">24—25</ref></char></para>
  <chapter number="1" style="c" sid="JUD 1" />
  <para style="s">अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1" />यहुदा का तरफ से जो यीशु मसीह का सेवक अरु याकूब को भैइ हइ</para>
  <para style="p" vid="JUD 1:1">उनखे बुलायो हुया को नाम जे परमेश्वर बाप मे प्रिय अरु यीशु मसीहा का लिये सुरक्षित हइ.<note caller="+" style="x"><char style="xo" closed="false">1: </char><char style="xt" closed="false"><ref loc="MAT 13:55">मत्ती 13:55</ref>; <ref loc="MRK 6:3">मरकुस 6:3</ref></char></note><verse eid="JUD 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JUD 1:2" />दया अरु शांती, अरु प्रेम तुमखे भोतायत से मील्हे होस र्हिये.<verse eid="JUD 1:2" /></para>
  <para style="s">झुठो मास्तर</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3" />हे प्रिय दोस्तहोन, जब मी तुमखे वा उध्दार का बारे मे लिखना मे भोत मेहनत से कोशीस करी रो थो जेमे हम सब मीलि खे हइ, ते मेने तुम खे लिखनो अरु प्रोत्साहित करण कि जरुरत मैसुस कर्यो कि तुम उ विश्वास का लिये कोशिश करता र्हेनु जेखे परमेश्वर ने अपना दुन्याहोन खे दियो हइ. <verse eid="JUD 1:3" /><verse number="4" style="v" sid="JUD 1:4" />क्युकि कत्ता असो इन्सान चुपचाप से हमारा पंचायत मे अय मील्या हइ, वे दुन्याहोन को दण्ड का बारे मे शास्त्रहोन ने भोत पइले से लिख्यो गयो थो. ये दुन्या भक्तिहीन हइ, अरु हमारो परमेश्वर को अनुग्रह खे दुन्याहोन ने परमेश्वर का अनैतिक रस्ताहोन को बहानो बनइ डाल्यो हइ, तथा असो हमारो प्रभु यीशु मसीह एकमात्र स्वामी अरु प्रभु ओखे इन्कार करस हइ.<verse eid="JUD 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5" />पर मंनजे तुम सब बात एक बार जानी गा हइ, तेभी मी तुमखे या बात की याद दिलानु चाउस हइ कि प्रभु ने इस्राएल खे मीस्र देस से छुडाना का बाद विश्वास नी लान आला खे खतम करी दियो.<note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="EXO 12:51">निर्गमन 12:51</ref>; <ref loc="NUM 14:29">गिनती 14:29</ref>; <ref loc="NUM 30">30</ref></char></note> <verse eid="JUD 1:5" /><verse number="6" style="v" sid="JUD 1:6" />तुम खे यो भी याद दिलानु चाउस हइ जो स्वर्गदूत ने अपनी सत्ता खे बन्य खे नी रखी सक्या पन अपना नीज नीवास खे त्यागी दियो, ओने उनकी भी वा कठीन दिन खे न्याय का लिये अंन्धारा मे जो सदाकाल का लिये हइ, बन्धनहोन मे रख्यो हइ. <verse eid="JUD 1:6" /><verse number="7" style="v" sid="JUD 1:7" />जेका रीति से सदोम अरु गमोरा अरु उनका आस पास का नगर खे जो स्वर्गदूतहोन का जसा व्यभिचारी हुइ गया था अरु अनैतिक बुरा काम का पीछे लगी गया था, अंगार खे अनन्त दण्ड मे पडी खे तुम खे यो भी याद दिलानो चाउस हइ जो दूतहोन ने अपनी सत्ता खे बन्य खे नी रखी सक्ये पन अपनो नीजी नीवास खे त्यागी दियो, ओने उनकी भी वा कठिन दिन को न्याय का लिये अंन्धारा मे जो सदा काल का लिये हइ, बन्धनहोन मे रख्यो हइ चेतावनी ठैर्यो हइ<note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="GEN 19:1-24">उत्पत्ति 19:1-24</ref></char></note>.<verse eid="JUD 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8" />वा रीति से या स्वप्नदर्शी भी अपना-अपना आंग कि अशुध्द करस, अरु प्रभुता खे तुच्छ जानस हइ, अरु उचो पद आला खे बुरा भला बोलस हइ. <verse eid="JUD 1:8" /><verse number="9" style="v" sid="JUD 1:9" />पन प्रधान स्वर्गदूत मीखाइल ने जब सैतान से मूसा खे मर्या आंग का बारे मे वाद-विवाद कर्यो, ते ओखे बुरो-भलो बोली खे मीखाइल ने दोष लगाता हुये अपमान जनक बोलन कि हिम्मंत नी कर्यो लेकिन बोल्यो, “प्रभु तोखे डाट्ये<note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="DAN 10:13">दानिएल 10:13</ref>,<ref loc="DAN 10:21">21</ref>; <ref loc="DAN 12:1">12:1</ref>; <ref loc="REV 12:7">प्रकाशन 12:7</ref></char></note>.” <verse eid="JUD 1:9" /><verse number="10" style="v" sid="JUD 1:10" />पन ये दुन्या वा बातहोन कि आलोचना करस हइ जिनखे यो समझे हि नी ये दुन्या बुध्दि हीन जनवरहोन का जसा जो बातहोन से सरल रीति से परिचीत हइ ये बातहोन या हइ जेका से उनको नाश होन आलो हइ. <verse eid="JUD 1:10" /><verse number="11" style="v" sid="JUD 1:11" />उन पर हाय! क्युकि वे कैन की जसी चाल चल्ये अरु मजुरी का लिये बिलाम का जसा भ्रष्ट हुइ गा हइ, अरु कोरह का, जसा विरोध करीखे खतम हुया हइ<note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="GEN 4:3-8">उत्पत्ति 4:3-8</ref>; <ref loc="NUM 22:1-35">गिनती 22:1-35</ref></char></note>. <verse eid="JUD 1:11" /><verse number="12" style="v" sid="JUD 1:12" />ये दुन्या तुम्हारो सात प्रिती भोज मे घातक हइ वे लुकी हुइ चट्टन का जसा हइ वे सीर्फ अपना मेय स्वार्थी, हि चिन्ता करस हइ. वे बिना पानी का बद्दल का जसा हइ, वे पतझड को असो झाड हइ कि जिन पर फल नी आयो वे दोबार मर्या हुया हइ, उनका जड से उखाडि जै चुक्या हइ. <verse eid="JUD 1:12" /><verse number="13" style="v" sid="JUD 1:13" />उ संमुद्र को भैयानक लाटहोन जसी हइ जो अपना लाज पुरो कार्यहोन खे फेस देखते र्हेस हइ, वे भटकता तारा जसी र्हेस हइ, जिन का लिये परमेश्वर ने पिडमपिडि का लिये घोर अन्धारो रख्यो हइ.<verse eid="JUD 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14" />हनोक ने भी जो आदम से सातवीं पीडी मे थो, इन का बारे मे या भविष्यव्दाणी करी, “देखनु, प्रभु अपना हजारो पवित्र स्वर्गदूतहोन का साथ आयो<note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="GEN 5:18-21">उत्पत्ति 5:18-21-24</ref></char></note> <verse eid="JUD 1:14" /><verse number="15" style="v" sid="JUD 1:15" />कि सब को न्याय कर्ये, अरु सब की भक्तिहीनहोन खे उनकी अभक्ति का सब काम होन का बारे मे जो उनने भक्तिहीन कऱ्यो हुइ, कर्यो हइ, अरु उन सब कठोर बातहोन का बारे मे जो भक्तिहीन पापीहोन ने उनका विरोध मे बोल्यो हइ, दोषी ठैहराए,”<verse eid="JUD 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JUD 1:16" />ये दुन्या चुगल खोर अरु दुसरा पर दोष लगान आला हइ, ये दुन्या अपना मे बुरी लालचहोन पर चलन आला हइ उ अपना बारे मे अहेमर करस हइ, अरु अपना लोभी का लिये दुसरा की चापलुसी करस हइ.<verse eid="JUD 1:16" /></para>
  <para style="s">चेतावनी अरु उपदेश</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17" />पर हे प्रिय दोस्त, तुम वा बातहोन खे याद रखनु जो हमारो प्रभु यीशु मसीह का प्रेरित पइले बोली चुक्या हइ. <verse eid="JUD 1:17" /><verse number="18" style="v" sid="JUD 1:18" />वे तुम से बोल्या करता था अन्त का दिनहोन मे असा दुन्या प्रगट हुये जो करण आला हुये वे दुन्या अपनी अभक्ती की बुरी लालसा का जसो चल्ये<note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="2PE 3:3">2 पतरस 3:3</ref></char></note>. <verse eid="JUD 1:18" /><verse number="19" style="v" sid="JUD 1:19" />ये वे हइ जो फुट डालस हइ. वे उनका आंग कि इच्छाहोन खे नीयत्रन मे हइ, जेका पास आत्मा नी हइ. <verse eid="JUD 1:19" /><verse number="20" style="v" sid="JUD 1:20" />पर हे प्रिय, तुम अपना अति पवित्र विश्वास मे उन्नती करता हुये अरु पवित्र आत्मा मे प्रार्थना करता हुया. <verse eid="JUD 1:20" /><verse number="21" style="v" sid="JUD 1:21" />अपना आप खे परमेश्वर का प्रेम मे बनय खे रखनु. अरु अनन्त जिवन का लिये हमारा प्रभु यीशु मसीह कि दया कि रस्ता देखते र्हेनु.<verse eid="JUD 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22" />उन पर जो शंका मे हइ दया करणु. <verse eid="JUD 1:22" /><verse number="23" style="v" sid="JUD 1:23" />अरु भोतझन खे अंगार मे से झपटी खे नीकालनु. अरु भोतझन पर डर का साथ दया करणु, पर उ कुर्ता से भी घृणा करणु जिन पर पाप पुरा मेत को धब्बा लग्या हुया हइ.<verse eid="JUD 1:23" /></para>
  <para style="s">आशीष वचन</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24" />अब ओका प्रती जो तुमखे गीरना से बचैइ सकस हइ, अरु अपनी महिमा मय उपस्तिथी मे नीर्दोष करीखे खडा करी सकस हइ, <verse eid="JUD 1:24" /><verse number="25" style="v" sid="JUD 1:25" />उ एकमात्र परमेश्वर हमारा उद्धारकर्ता की महिमा अरु गौरव अरु पराक्रम अरु अधिकार खे हमारा प्रभु यीशु मसीह का वजेसे जसो जगत काल से हइ, अब भी हुये अरु पिडमपिडि र्हिये. आमेन.<verse eid="JUD 1:25" /></para>
  <chapter eid="JUD 1" />
</usx>