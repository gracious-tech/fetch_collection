<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TH" style="id">- Gowlan</book>
  <para style="h">2 थिस्‍सलुनीकियों</para>
  <para style="toc3">2 थिस्‍सलुनीकियों</para>
  <para style="toc2">2 थिस्‍सलुनीकियों</para>
  <para style="toc1">2 थिस्सलुनीकिहोन का नाम पौलुस प्रेरित कि चिठ्ठी</para>
  <para style="mt2">2 थिस्सलुनीकियो खे नाम पौलुस प्रेरित कि चिठ्ठी</para>
  <para style="mt1">2 थिस्सलुनीकिहोन का नाम पौलुस प्रेरित कि चिठ्ठी</para>
  <para style="imt">पैछान</para>
  <para style="ip">थिस्सलुनीखे कीहोन की दुसरी चिठ्‌ठी प्रेरीत पौलुस का वजेसे लिखी गइस हइ <char style="xt"><ref loc="2TH 1:1">1:1</ref> </char> उनखे या चिठ्‌ठी पहीली थिस्सलुनीखे कीहोन को थोड टेम का बाद यीशु का जन्म का नजीकपास 51 साल बाद लिखी थी. जब ओने या चिठ्ठी पौलुस कुरिन्थ मे तब भी थो जब ओने थिसलिनीका मे मंडली खे या चिठ्‌ठी लिखी थी, एक मंडली जेने ओने अपनी दुसरी मीशनरी जत्रा पर स्थापित कऱ्यो थो प्रेरितहोन को <char style="xt"><ref loc="ACT 17:1-10">प्रेरित 17:1-10</ref></char> या प्रेरित कि किताब मे बोल्यो गयो हइ कि मंडली कुछ यहूदीयाहोन अरु कोय यूनानीहोन से बनी थी.</para>
  <para style="ip">थेसालोनीयन मंडली को अत का अरु यीशु को दुसरो आना से संबंध ऱ्हेयो हुये खे क्युकी पौलुस ने थिस्सलुनी खे की होन खे लिखी अपनी चिठ्‌ठी मे येका बारे मे भोत कुछ लिख्यो हइ. नजीकपास 2 थिस्सलुनी खे की होन को नजीकपास आधो टेम खतम होस हइ. पौलुस ने आलसी का खिलाब चेतावनी भी दी थी. प्रत्येक इन्सान का अपनो खानो <char style="xt"><ref loc="2TH 3:6-10">3:6-10</ref></char> का लिये करणो चास.</para>
  <para style="iot">रुप रेखा</para>
  <para style="io1">1. पौलुस ने अपनो अरु अपना साथिहोन खे पैछान देतो हुये चिठ्‌ठी कि सुरुवात करी <char style="ior"><ref loc="2TH 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">2. तब उ थिस्सलूनीक मे मंडली का लिये प्रभु को धन्यवाद करस हइ अरु उनका लिये प्रार्थना करस हइ <char style="ior"><ref loc="2TH 1:3-12">1:3-12</ref> </char></para>
  <para style="io1">3. अध्याय मे पौलुस अत टेम का बारे मे बोलस हइ <char style="ior"><ref loc="2TH 2">2</ref></char></para>
  <para style="io1">4. फिर उ आलसी अरु काम करण को आकुल्यकता का खिलाप बोलस हइ<char style="ior"><ref loc="2TH 3:1-15">3:1-15</ref> </char></para>
  <para style="io1">5. पौलुस फिर से मंडली खे नमस्कार करीखे खतम हुइ गयो <char style="ior"><ref loc="2TH 3:16-18">3:16-18</ref> </char></para>
  <chapter number="1" style="c" sid="2TH 1"/>
  <para style="s">अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1"/>पौलुस अरु सिलवानुस अरु तीमुथियुस का तरफ से हमारो परम बाप परमेश्वर अरु प्रभु यीशु मसीह मे बन्या हइ जो हमारो बाप परमेश्वर अरु प्रभु यीशु मसीह मे हइ.<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="ACT 17:1">प्रेरित 17:1</ref></char></note><verse eid="2TH 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2"/>हमारो बाप परमेश्वर अरु प्रभु यीशु मसीह मे तुमखे अनुग्रह अरु शांती मीलती र्‍हे.<verse eid="2TH 1:2"/></para>
  <para style="s">धन्यवाद अरु प्रार्थना</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3"/>हे हमारा विश्वासी साथिहोन, तुम्हारा बारे मे हमखे हर टेम परमेश्वर को धन्यवाद करणो चास हइ, अरु यो उचित भी हइ येका लिये कि तुम्हारो विश्वास भोत बडतो जास हइ, अरु आपस मे तुम सब मे प्रेम भोत ही बढतो जास हइ. <verse eid="2TH 1:3"/><verse number="4" style="v" sid="2TH 1:4"/>ह्या तक कि हम खुद परमेश्वर की मंडली मे तुम्हारा बारे मे गर्व करस हइ, कि जेतनो उपद्रव अरु दुख तुम सहस हइ, वे सब मे तुम्हारो धीरज अरु विश्वास प्रगट होस हइ.<verse eid="2TH 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5"/>यो परमेश्वर को सच्ची न्याय को सपा प्रमाण हइ कि तुम परमेश्वर को राज का योग्य ठैऱ्या जेका लिये तुम सब ओका लिये दुख उठाता ऱ्हेस. <verse eid="2TH 1:5"/><verse number="6" style="v" sid="2TH 1:6"/>परमेश्वर उ कर्हे जो अच्छो हइ अरु जो तुमखे दुख देस हइ, बदला मे उनखे दुख दियो जाये. <verse eid="2TH 1:6"/><verse number="7" style="v" sid="2TH 1:7"/>अरु तुम जो दुख उठ्य रास हुये उनका उ टेम विसराम दियो जाये प्रभु यीशु अपनो सामर्थ्य स्वर्गदूत का सात को स्वर्ग मे भडकती अंगार मे प्रगट हुये. <verse eid="2TH 1:7"/><verse number="8" style="v" sid="2TH 1:8"/>जेने परमेश्वर को नकाऱ्यो अरु हमारा प्रभु यीशु को सुसमाचार को पालन नी कऱ्यो उनका दण्ड दियो जाये. <verse eid="2TH 1:8"/><verse number="9" style="v" sid="2TH 1:9"/>तथा उनका प्रभु अरु ओका महिमा मय शक्ति से बाजु दियो जाये अरु उनका दण्ड दियो जाये.<note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="ISA 2:10">यशया 2:10</ref></char></note> <verse eid="2TH 1:9"/><verse number="10" style="v" sid="2TH 1:10"/>अरु ओमे तुम दुन्या भी शामील हुये क्युकी हमने ओका बारे मे जो गवाही साक्षी दी थी तुम ने ओका पर विश्वास कऱ्यो.<verse eid="2TH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11"/>उ जिवन का लिये योग्य समझ जेखे तुमने जिवन का लिये बुलायो गयो, प्रार्थना अरु अच्छो उ तुमारी हर उतम इच्छा खे पुरी कर अरु हर उ काम की उ सफल बना जो तुम विश्वास को परी नाम हइ, <verse eid="2TH 1:11"/><verse number="12" style="v" sid="2TH 1:12"/>यो प्रकार कि हमारो प्रभु यीशु को नाम महीमा पास अरु तुम ओका वजेसे महीमा पास ये सब कुछ हमारो प्रभु यीशु मसीह को अनुग्रह से हुये.<verse eid="2TH 1:12"/></para>
  <chapter eid="2TH 1"/>
  <chapter number="2" style="c" sid="2TH 2"/>
  <para style="s">बिना नीयम को इन्सान</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1"/>हे विश्वासी साथिहोन, अब हम अपना प्रभु यीशु मसीह का फिर आन की, अरु ओका सात परसपर जमा होन की प्रार्थना करस हइ. <verse eid="2TH 2:1"/><verse number="2" style="v" sid="2TH 2:2"/>कि तुम आसानी से अपना विवेक खे कोय भविष्यवाणी का अलावा कोय असो पत्र खे नी आत्मा जेखे हमारा वजेसे लिख्यो गयो तथा मेजवान रुप से बतायो गयो हइ प्रभु को दिन ए चुक्यो हइ नी होनु. <verse eid="2TH 2:2"/><verse number="3" style="v" sid="2TH 2:3"/>तुम अपना आप खे कोय का भी वजेसे कोय प्रकार से कोय खे भरमाना नी दे, क्युकी वह दिन उ दिन तक नी आये जब तक कि आखरी विद्रह अरु बुरी शक्ति प्रगट नी हुये उ इन्सान की नीयती तो नरक हइ. <verse eid="2TH 2:3"/><verse number="4" style="v" sid="2TH 2:4"/>उ अपना आपखे हर चिज का उपर बोले अरु उनको विरोध कर्हे असा चिज जो परमेश्वर को हइ, जो परमेश्वर कि पुज्जनीय हइ ह्या तक की परमेश्वर कि मन्दिर मे जयखे राजगद्दी पर बठी खे यो दावा करस कि उ परमेश्वर हइ.<verse eid="2TH 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5"/>का तुमखे याद नी की जब मी तुम्हारा ह्या थो, ते तुम से या सब बात बोलतो थो. <verse eid="2TH 2:5"/><verse number="6" style="v" sid="2TH 2:6"/>अरु अब तुम तो जानस हइ, कि ओखे रोकी रास हइ ताकि उ उचित टेम आना पर प्रगट हुइ जाये. <verse eid="2TH 2:6"/><verse number="7" style="v" sid="2TH 2:7"/>क्युकी अन्याय को भेद पैयले से ही हइ पन जो कुछ जब तक नी जब तक रहश्य मय बात कर्हे. <verse eid="2TH 2:7"/><verse number="8" style="v" sid="2TH 2:8"/>जब अधर्मी प्रभु यीशु आये उ ओखे मारी डाले अपना मुडा का फुक से अपनो वैभवी उपस्ती आत्मीक खतम कर्हे. <verse eid="2TH 2:8"/><verse number="9" style="v" sid="2TH 2:9"/>उ दुष्ट को आनो सैतान कि शक्ति से हुये तथा उ भोत बडि शक्ति झुटो सामर्थ्य अरु अर्चाय चिन्ह का काम से गया. <verse eid="2TH 2:9"/><verse number="10" style="v" sid="2TH 2:10"/>अरु नास होनआला का लिये अधर्म सब प्रकार का दुष्ट छल प्रपन्च को इस्तमाल करी खे उ इन को उपयोग ये इन्सान पर करस जेने सत्य से प्रेम नी कऱ्यो जेका से उनको उध्दार नी हुये. <verse eid="2TH 2:10"/><verse number="11" style="v" sid="2TH 2:11"/>अरु येका कारन परमेश्वर उन मे एक भटकान देनआली सामर्थ खे भेज्यो कि वे झुट पर विश्वास कर्‍हे. <verse eid="2TH 2:11"/><verse number="12" style="v" sid="2TH 2:12"/>ताकि जेतना दुन्या सत्य पर विश्वास नी करस, पन झुठ पन खे प्रमानीत करस हइ, वे सब दण्ड मील्हे.<verse eid="2TH 2:12"/></para>
  <para style="s">दृढता से खडा ऱ्हेनु</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13"/>पर हे विश्वासी साथिहोन, प्रभु का प्रिय दुन्या कि तुम्हारो बारे मे हमेसा परमेश्वर को धन्यवाद करस ऱ्हीहे, कि आत्मा का वजेसे पवित्र बनीखे, अरु सत्य पर विश्वास करीखे उध्दार पाये. <verse eid="2TH 2:13"/><verse number="14" style="v" sid="2TH 2:14"/>जेका लिये ओने तुमारो सुसमाचार का प्रचार का वजेसे बुलायो हइ, कि तुम हमारा प्रभु यीशु मसीह कि महिमा धारण करी सखे . <verse eid="2TH 2:14"/><verse number="15" style="v" sid="2TH 2:15"/>येकालिये, हे विश्वासी साथिहोन, स्थिर ऱ्हे. अरु जो परम्पराहोन तुमने हमसे मुख्य रुप से अरु चिठ्टी का वजेसे मील्हे हइ.<verse eid="2TH 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16"/>अब खुद हमारो प्रभु मसीह खुद ही, अरु हमारो बाप परमेश्वर जेने हमारा से प्रेम रख्यो, अरु अनन्त प्रोत्साहित अरु अच्छी आस दी हइ. <verse eid="2TH 2:16"/><verse number="17" style="v" sid="2TH 2:17"/>तुमारो मन मे प्रोत्साहित दे अरु तुमखे हर एक अच्छो काम अरु शब्द मे तुमखे द्दढ कर्हे.<verse eid="2TH 2:17"/></para>
  <chapter eid="2TH 2"/>
  <chapter number="3" style="c" sid="2TH 3"/>
  <para style="s">बिनती, लिये प्रार्थना</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1"/>पन हे मरा विश्वासी साथिहोन हमारा लिये प्रार्थना कर की प्रभु को संदेश ताखत से फैले खे अरु महिमा का सात स्वीकार योग्य हुये खे जसो तुम दुन्याहोन का बिच मे हुयो हइ. <verse eid="2TH 3:1"/><verse number="2" style="v" sid="2TH 3:2"/>प्रार्थना कर कि हम दुष्ट अरु बुरा दुन्याहोन से बच्या र्‍हिहे क्युकी सब दुन्या प्रभु, सन्देश पर विश्वास नी हुये.<verse eid="2TH 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 3:3"/>पन प्रभु विश्वासयोग्य हइ. उ तुमखे पक्को अरु स्तिर कर्हे अरु ओका दुष्ट से बचाये. <verse eid="2TH 3:3"/><verse number="4" style="v" sid="2TH 3:4"/>अरु हम खे प्रभु मे तुम पर आत्मा विश्वास हइ अरु येका लिये हम निश्चित हइ कि जो आज्ञा हम तुम खे देस हइ उनका तुम मानस हइ अरु लगातार मानता ऱ्हीहे.<verse eid="2TH 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 3:5"/>परमेश्वर को प्रेम अरु मसीह को धिरज का तरफ प्रभु तुम्हारा मन कि अगु अय कर्हे.<verse eid="2TH 3:5"/></para>
  <para style="s">आलस्य का खिलाप चेतावनी</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6"/>हे हमारा विश्वासी साथिहोन खे हम तुम खे अपना प्रभु यीशु मसीह को नाम से आज्ञा देस हइ कि हर एक असा विश्वासी दुन्याहोन से दुर र्‍हे का जो आलस जिवन जिस हइ, जो हमने दीयो नीर्देश को पालन नी करतो हुये. <verse eid="2TH 3:6"/><verse number="7" style="v" sid="2TH 3:7"/>क्युकी तुम खुद अच्छी रीति से जानस हइ. कि तुम खे हमारो अनुकरण कसो करणो चास कि क्युकी हम तुमारा बिच मे था आलसी नी कऱ्यो. <verse eid="2TH 3:7"/><verse number="8" style="v" sid="2TH 3:8"/>अरु कोय की रोटि फुकट मे नी खे पर मेहनत अरु काम रात दिन करी रा था क्युकी तुम मे से कोय पर बोझो नी बनु. <verse eid="2TH 3:8"/><verse number="9" style="v" sid="2TH 3:9"/>असो नी कि हम ने तुम से साहयता लेन को अधिकार नी बलकी येका लिये कडी मेहनत करस हइ कि तुम ओको अनुकरण करस हइ. <verse eid="2TH 3:9"/><verse number="10" style="v" sid="2TH 3:10"/>अरु जब हम तुम्हारा ह्या आज्ञा तुमखे देता था, कि जो काम नी करस उ खानो भी नी खाय.<verse eid="2TH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11"/>हम सुनस हइ, कि कतना दुन्या तुमारा बिच मे आलसी जिवन जिस हइ. अरु दुसरा मे कावट करस हइ. <verse eid="2TH 3:11"/><verse number="12" style="v" sid="2TH 3:12"/>असो हम प्रभु यीशु मसीह मे आज्ञा देस अरु प्रार्थना करस हइ, कि शान्ती का साथ अपनी कमाइ की रोटी खाय खे<verse eid="2TH 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 3:13"/>पन तुम विश्वासी साथिहोन कि जहा तक तुमारी बात हइ भलाइ करीखे थखे मत. <verse eid="2TH 3:13"/><verse number="14" style="v" sid="2TH 3:14"/>या चिठ्‌ठी मे लीखी हुइ शिक्षा नी माने कि ते ओका पर नजर रख. अरु ओका संग मे नी ऱ्हेनु कि जेका से उ लज्जित हुये. <verse eid="2TH 3:14"/><verse number="15" style="v" sid="2TH 3:15"/>पन ओका सात मे दुशमन जसो व्यवाहर मत कर बलकी ओका भैइ का जसो समजायो.<verse eid="2TH 3:15"/></para>
  <para style="s">आखरी शुभकाम नाए</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16"/>अब प्रभु जो शांती देनवालो परमेश्वर हइ उ खुद ही तुम खे हमेशा सब प्रकार कि शांती देकी प्रभु तुम सब का सात ऱ्हेस.<verse eid="2TH 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17"/>मी पौलुस खुद अपनी लिखावट मे यो नमस्कार लिखी रोस हइ. मी यो प्रकार हर चिठ्‌ठी पर हस्तक्षर करस हइ मरी लिखन कि शैली यही हइ.<verse eid="2TH 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18"/>हमारो प्रभु यीशु मसीह को अनुग्रह तुम सब पर होतो र्‍हिये.<verse eid="2TH 3:18"/></para>
  <chapter eid="2TH 3"/>
</usx>
