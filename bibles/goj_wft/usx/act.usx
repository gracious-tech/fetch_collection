<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- Gowlan</book>
  <para style="h">प्रेरित</para>
  <para style="toc3">प्रेरित</para>
  <para style="toc2">प्रेरितहोन</para>
  <para style="toc1">प्रेरितहोन को कामहोन को वर्णन</para>
  <para style="mt2">प्रेरितयो का कामो का वर्णन</para>
  <para style="mt1">प्रेरितहोन को कामहोन को वर्णन</para>
  <para style="imt">पैछान</para>
  <para style="ip">प्रेरितहोन कि किताब चर्च कि शुरुवात की खानी हइ अरु या यरुशलेम से सामरिया अरु ओका आगे तक कसा फैलायो गयो, जसो यीशु ने अपना चेलाहोन खे स्वर्ग मे जाना से पैयले बतायो थो <char style="xt"><ref loc="ACT 1:8">1:8</ref></char> येका लुक ने लिखी थी, जेने लुक, जसो सुसमाचार भी लिख्यो थो. एक डाॅकटर थो अरु एक खातो करण का लिये भोत सावधान थो उनने अपनो सुसमाचार अरु अधिनीयमहोन कि किताब थियोफिलीस खे संबोधित कर्यो हइ जो एक ग्रीक अरु यहूदीया दो सामील था <char style="xt"><ref loc="ACT 1:1">1:1</ref></char></para>
  <para style="ip">प्रेरित सभवता यीशु मसीह को जन्म 60-64 साल बिच लिखी गइ थी क्युकि या किताब पौलुस खे जोल से छुटन से पैयले खत्म हुइ गइ थी. लुका ने भी प्रेरित पौलुस का साथ जत्रा, अरु शायद एटि ओखे शहर मे अधिक नीयम लिखी. प्रेरित लुका को सुसमाचार सदा लुका का लिये हइ अरु यीशु को स्वर्ग मे जान का साथ शुरु होस हइ. लिखन मे लुक को उध्देश ओको सुसमाचार का समान ही हइ. उ थियोफिलस चातो थो ख्रिस्थी होन की बडी सख्या से नीश्चित हइ कि ओने ओखे सिखायो गयो थो अरु येका लिये ओने यीशु को जिवन अरु ख्रिस्थी धर्म को प्रसाद को एक सठीक लेख लिख्यो.</para>
  <para style="ip">प्रेरित कि किताब हमारा लिये प्रारभीक चर्च को उधाहरण प्रदान करस हइ अरु यीशु मे विश्वास खे जानन का लिये यो कसो बतातो थो. प्रेरित को उदाहरण हमने बतास हइ कि दुसरा को सुसमाचार संदेश फैलास मे पवित्र आत्मा कि शक्ति पर भरोसो कसो करणो हइ</para>
  <para style="iot">रुप रेखा</para>
  <para style="io1">1. पैयले पवित्र आत्मा चेला पर आस हइ अरु चर्च बडन लगस हइ <char style="ior"><ref loc="ACT 1:1-8:1">1:1—8:1</ref> </char></para>
  <para style="io1">2. येका का बाद चर्च खे सतायो जास हइ अरु यरुशलेम का बाहेर घुमन लग्यो हइ <char style="ior"><ref loc="ACT 8:2-12:23">8:2—12:23</ref></char></para>
  <para style="io1">3. ओका बाद पौलुस अपनी पयली मीशनरी जत्रा पर जास हइ. <char style="ior"><ref loc="ACT 12:24-14:28">12:24—14:28</ref></char></para>
  <para style="io1">4. नवा विश्वासीहोन की जरुरत हइ. <char style="ior"><ref loc="ACT 15:1-35">15:1-35</ref> </char></para>
  <para style="io1">5. पौलुस अपनी दुसरी मीशनरी जत्रा पर जास हइ <char style="ior"><ref loc="ACT 15:36-18:22">15:36—18:22</ref></char></para>
  <para style="io1">6. ओका बाद उ अपनी तिसरी मीशनरी जत्रा पर जास हइ. <char style="ior"><ref loc="ACT 18:23-20:38">18:23—20:38</ref></char></para>
  <para style="io1">7. तब पौलुस खे यरुशलेम मे गिरफ्तार कऱ्यो गयो. <char style="ior"><ref loc="ACT 21-26">21—26</ref></char></para>
  <para style="io1">8. आखरी मे उ रोम मे ली जायो जास हइ. <char style="ior"><ref loc="ACT 27-28">27—28</ref></char></para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="s">पहचान</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />प्रिय थियुफिलुस, मेने पयली किताब वे सब बात का बारे मे लिखी जो यीशु सुरवात से करतो अरु सिखातो र्‍हियो. <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />उ दिन तक जब तक उन प्रेरितहोन खे जेने उनके चुन्यो थो पवित्र आत्मा का वजेसे आज्ञा दि, उपर उठायो नी गयो. <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />ओने दुख उठाना का बाद भोत सा पक्को प्रमाणहोन से अपना आप खे उनने जिन्दो दिखायो, अरु चालीस दिन तक उ उनने दिखायो देता र्‍हियो, अरु परमेश्वर का राज्य की बात करतो र्‍हियो. <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />अरु उनसे मीलिखे उनने आज्ञा दी, “यरुशलेम का नी छोडनु, परम बाप की वा प्रतीज्ञा खे पूरो होन की रस्ता देखतो र्‍हियो, जेकी चर्चा तुम मरा से सुन चुक्या हइ. <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />क्युकि यहून्ना ने ते पानी मे बपतिस्मा दियो हइ पन थोडा दिन का बाद तुम पवित्र आत्मा से बपतिस्मा पाये.”<verse eid="ACT 1:5" /></para>
  <para style="s">यीशु को स्वर्ग रोहन</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />आखरी उनने इखठ्ठा हुइखे ओकासे बोल्यो, “हे प्रभु का तू यो टेम इस्राएल को राज्य फेरी दिये?”<verse eid="ACT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7" />ओने उनसे बोल्यो, उ टेमहोन या कालहोन खे जाननो, जेका बाप ने अपना ही अधिकार मे रख्यो हइ, तुम्हारो काम नी. <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />पन जब पवित्र आत्मा तुम पर आये तब तुम सामर्थ्य पाये. अरु यरुशलेम अरु पुरा यहूदीया अरु सामरिया मे अरु पृथ्वी का आखरी तक मरा गवा हुये. <verse eid="ACT 1:8" /><verse number="9" style="v" sid="ACT 1:9" />यो बोलीखे उ उनका देखते उपर उठै लियो गयो, अरु वु बद्दल ने ओखे उनकी आखहोन से लुकै लियो.<verse eid="ACT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10" />ओका जाते टेम जब उ बद्दल का तरफ ताकी र्‍हो थो, ते देखनु दो अदमी सफेद कपडा पेन्या हुया उनका पास अय खडो हुया. <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />अरु उनसे बोल्यो, “हे गलीली इन्सानहोन, तुम क्यु खडा बद्दल का तरफ देखी रा हइ? योइ यीशु जो तुम्हारा पास से स्वर्ग पर उठै लियो गयो हइ, जो रीति से तुम ने ओखे स्वर्ग, जाता देख्यो हइ वैइ रीति से उ फिर आये.”<verse eid="ACT 1:11" /></para>
  <para style="s">मत्तियाह खे यहूदा को पद मीलनो</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />तब वे जैतुन नाम की टेकडी पर से जो यरुशलेम का पास एक अराम का दिन का दूरी पर हइ यरुशलेम खे लौट्या. <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />जब वे वहा पहुच्या ते वा अटारी पर गया, जहा पतरस अरु यहून्ना अरु याकूब अरु अन्द्रियास अरु फिलिप्पुस अरु थोमा अरु बरतुल्मै अरु मत्ती अरु हलफइस को बेटो याकूब अरु शमौन जोलोतेस अरु याकूब को बेटो यहूदा र्‍हेतो थो. <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />ये सब बयहोन अरु यीशु की माय मरियम अरु ओका भैइहोन का साथ एक चित हुइ खे प्रार्थना मे लग्या र्‍हिया.<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />अरु एय दिनहोन मे पतरस भैइ भैइन का बिच मे जो एक सौ बीस इन्सान का नजिक पास था, खडा हुइ बोलन लग्यो. <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />हे भैइहोन जरुरी थो कि पवित्रशास्त्र को उ लेख पूरो हुये जो पवित्र आत्मा मे दाउद का मुडा से यहूदा का बारे मे जो यीशु खे पकडन आलो को अगुवा था, पैयले से बोल्यो थो. <note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="PSA 41:9">भजन संहिता 41:9</ref> </char></note> <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />क्युकि उ तो हम मे गिन्यो गयो, अरु या सेवा मे हिस्सेदार हुयो.<verse eid="ACT 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18" />ओने अधर्म की कमइ से एक खेत मोल लियो, अरु माथा का बल गिर्यो अरु ओको पेट फटी गयो अरु ओकी सब आतडीहोन नीकली पडी. <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />अरु या बात खे यरुशलेम का सब र्‍हेनआला जानी गया, ह्या तक कि उ खेत को नाम उनकी भाषा मे हकलदमा मंनजे खुन को खेत पडी गयो.<verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />क्युकी भजन संहिता मे लिख्यो हइ,</para>
  <para style="q1" vid="ACT 1:20">ओको घर उजडी जाये अरु ओमे कोय नी बस्ये</para>
  <para style="q2" vid="ACT 1:20">अरु ओको पद कोय दूसरो लि ले. <verse eid="ACT 1:20" /><verse number="21" style="v" sid="ACT 1:21" />येकालिये जोत्ता दिन तक प्रभु यीशु हमारा साथ आता जाता र्‍हिये मंनजे यहून्ना को बपतिस्मा से लिखे ओका हमारा पास से उठायो जाना तक जो दुन्या बराबर हमारा साथ र्‍हिये. <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />यहून्ना अच्छो हइ कि उनमे से एक इन्सान हमारा साथ यीशु खे जिन्दो उठन को गवा हुइ जाये.<verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />तब उनने दोय खे खडा कर्या, एक यूसुफ खे जो बरसब्बास बोलस हइ जोको उपनाम यूसतुस हइ, दूसरो मत्तियाह के. <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />अरु या प्रार्थना करी “हे प्रभु, तु जो सब को मन जानस हइ, यो प्रकट कर कि ये दो मे से तोने को खे चुन्यो हइ. <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />कि उ या सेवक अरु प्रेरिताइ को पद ले जेखे यहूदा छोडीखे अपना जगा खे चली गयो.” <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />तब उनने उनका बारे मे चिट्ठिहोन डालीखे अरु चिट्ठी मत्तियाह का नाम पर नीकली. आखरी उ उन ग्यारा प्रेरितहोन का साथ गिन्यो गयो.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s">पवित्र आत्मा को उतरनो</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />जब पिन्तुकुस्त को दिन आयो, मंनजे ते वे सब एक जगा जमा था. <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />अचानक बद्दल से बडी आधी को जसी संनसनाहट को बोल हुयो, अरु ओका से पूरो घर जहा वे बठ्या था गुजी गयो. <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />अरु उनने अंगार की सी जीभ फुटती हुइ दिखइ दि अरु उनमे से हर एक पर अय ठैरी. <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />वे सब पवित्र आत्मा से भरी गया, अरु जो प्रकार आत्मा ने उनने खे बोलन की सामर्थ्य दी, वे अलग अलग भाषा बोलन लग्या.<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />बद्दल का नीचे की हर एक जात मे से भक्त यहूदीया यरुशलेम मे र्‍हि रा था. <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />जब यो अवाज हुयो ते गर्दी हुय गइ अरु इन्सानहोन चकित हुइ गया क्युकि हर एक खे योइ सुनइ देतो थो कि ये मरा भाषा मे बोली र्‍हा हइ. <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />वे सब चकित अरु अचम्भित हुइ खे बोलन लग्या, देखनु, ये जो बोली र्‍हा हइ सब गलीली नी. <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />ते फिर क्यु हम से हर एक अपनी अपनी जन्म भूय कि भाषा मे उनकी सुनस हइ. <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />हम जो अरु मेदी अरु एलामी अरु मेसोपोटामीया अरु यहूदीया अरु कप्पदुकिया अरु पुन्तुस अरु आसिया, <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />अरु फ्रुगिया अरु पंफूलिया अरु मीस्र अरु लीबिया देश जो कुरेने का आस पास हइ, या सब देशहोन का र्‍हेनआला अरु रोमी प्रवासी. <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />मंनजे यहूदीया अरु यहूदीया मत धारण करणआला, क्रेती अरु भी हइ, पन अपनी अपनी भाषा मे उनसे परमेश्वर का बडा बडा काम होन की चर्चा सुनास हइ. <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />अरु वे सब चकित हुया अरु घबर्ये का एक दूसरा से बोलन लग्या, “यो का हुइ र्‍हो हइ?”<verse eid="ACT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 2:13" />पन दूसराहोन ने मजाक करी खे बोल्यो, वे तो पीखे नशा मे चूर हइ.<verse eid="ACT 2:13" /></para>
  <para style="s">पतरस</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />जब पतरस वे ग्यारा का साथ खडो हुयो अरु उचा अवाज से बोलन लग्यो, हे यहूदीयाहोन अरु हे यरुशलेम का सब र्‍हेनआलाहोन, यो जानी लेकी अरु न लगैइ मरी बातहोन सुननु. <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />जसो तुम समझी र्‍हा हइ, ये दुन्या नशा मे नी हइ, क्युकि अभी तो दुपार ही दिन चड्यो हइ. <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />पन या वा बात हइ, जो योएल भविष्यव्दक्ता का वजेसे बोली गइ हइ.<verse eid="ACT 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17" />परमेश्वर बोलस हइ, कि आखरी का दिनहोन मे असो हुये</para>
  <para style="q2" vid="ACT 2:17">कि मी अपनी आत्मा सब इन्सानहोन पर दिह्यु</para>
  <para style="q1" vid="ACT 2:17">अरु तुम्हारो बेटो अरु तुम्हारी बेटीहोन भविष्यव्दाणी कर्ये</para>
  <para style="q2" vid="ACT 2:17">अरु तुम्हारा जवान दर्शन देख्ये</para>
  <para style="q2" vid="ACT 2:17">अरु तुम्हारा बापदादा दृष्‍टान्‍त देख्ये.<verse eid="ACT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18" />क्युकी मी अपना दासहोन अरु अपनी दासीहोन पर भी उन दिनहोन</para>
  <para style="q2" vid="ACT 2:18">मे अपना आत्मा मे से दिह्यु अरु वे भविष्यव्दाणी कर्ये.<verse eid="ACT 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19" />अरु मी उपर बद्दल मे अ‍दभुत काम</para>
  <para style="q2" vid="ACT 2:19">अरु नीचे धरती पर चिन्ह मंनजे खुन अरु आंग</para>
  <para style="q2" vid="ACT 2:19">अरु धुवा को बद्दल दिखायु.<verse eid="ACT 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ACT 2:20" />प्रभु को महान अरु तेजस्वी दिन का आना से पैयले सुरज अधारो</para>
  <para style="q2" vid="ACT 2:20">अरु चाद खुन सो हुइ जाये.<verse eid="ACT 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21" />अरु जो कोय प्रभु का नाम लिये उ उध्दार पाये.<verse eid="ACT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />हे इस्त्राएलिहोन, या बातहोन सुननु यीशु नासरी एक इन्सान थो जोको परमेश्वर का तरफ से होन को प्रमान उन सामर्थ काम होन अरु आश्चर्य का काम होन अरु चिन्ह से प्रगट हइ, जो परमेश्वर ने तुम्हारा बीच ओका वजेसे कर दिखायो जेखे तुम खुद ही जानस हइ. <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />उ यीशु खे जो परमेश्वर की ठैर्यइ हुइ योझना अरु पूर्व ज्ञान का जसो पकड्यो गयो, तुम ने अधर्मी होन का हाथ से क्रुस पर चड्यै खे मारी डाल्यो. <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />पन ओका परमेश्वर ने मरना को बन्धनहोन से छुड्यखे जिन्दो क्युकि यो अनहोनो थो कि उ ओका कब्जा मे र्‍हेस. <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />क्युकि</para>
  <para style="q1" vid="ACT 2:25">दाउद ओका बारे मे बोलस हइ मी प्रभु,</para>
  <para style="q2" vid="ACT 2:25">सर्वदा अपना सामने देखतो र्‍हियो क्युकि उ मरा जवना तरफ हइ, ताकि मी डगमग नी होयु.<verse eid="ACT 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26" />यो करण मरो मन आनन्दित हुयो,</para>
  <para style="q2" vid="ACT 2:26">अरु मरी जीभ मगन हुइ क्युकी मरो आंग भी आस मे बन्यो र्‍हिये.<verse eid="ACT 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27" />क्युकि तू मरो जानहोन खे अधोलोक मे नी छोड्यु</para>
  <para style="q2" vid="ACT 2:27">अरु नी अपना पवित्र झन, सडन ही दिये.<verse eid="ACT 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28" />तो ने मेखे जिवन को मार्ग बतायो हइ</para>
  <para style="q2" vid="ACT 2:28">तु मेखे अपनो दर्शन का वजेसे आनन्द से भर दिये.<verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />हे भैइहोन, मी हमारा पृर्वज दाउद का बारे मे तुम से हिम्मत का साथ बोली सकुस हइ कि उ तो मरी गयो अरु गाड्यो भी गयो अरु ओकी मरगट आज तक हमारो विध्दमान हइ. <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />उ भविष्यव्दक्ता थो, उ जानतो थो कि परमेश्वर ने मरा से कसम खैइ हइ कि मी तरा बश मे से एक इन्सान का जसी राजगद्दी पर बठाड्यु. <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />ओने होन आली बात खे पैयले ही से देखी खे मसीह का जिन्दो उठना का</para>
  <para style="q1" vid="ACT 2:31">बारे मे भविष्यव्दाणी करी कि नी ते ओको जान अधोलोक</para>
  <para style="q2" vid="ACT 2:31">मे छोड्यो गयो अरु नी ओको आंग पायो. <verse eid="ACT 2:31" /><verse number="32" style="v" sid="ACT 2:32" />यो यीशु, परमेश्वर ने जिन्दो, जेको हम सब गवा हइ. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />यो प्रकार परमेश्वर का जवना हाथ से अच्छो पद परइ खे अरु बाप से उ पवित्र आत्मा मील्हे करी जोकी प्रतीज्ञा करी गइ थी कि ओने यो पलटय दियो हइ जो तुम देखस अरु सुनस हइ. <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />क्युकि दाउद स्वर्ग पर नी चड्यो; पन उ खुद बोलस हइ,</para>
  <para style="q1" vid="ACT 2:34">प्रभु ने मरा प्रभु से बोल्यो,</para>
  <para style="q2" vid="ACT 2:34">मरा जवना बठ.<verse eid="ACT 2:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ACT 2:35" />जब तक कि मी तरा दुशमन होन खे तरा पाय नीचे की चौकी नी कर दियु.<verse eid="ACT 2:35" /></para>
  <para style="pi">
    <verse number="36" style="v" sid="ACT 2:36" />आखरी अब इस्राएल का पुरा घराना नीश्चित रुप से जानी ले कि परमेश्वर ने उ यीशु खे जेखे तुम ने क्रुस पर चडायो प्रभु भी ठैरायो अरु मसीह भी. <verse eid="ACT 2:36" /><verse number="37" style="v" sid="ACT 2:37" />तब सुननआला का दिल मे छेद हुइ गोका अरु वे पतरस अरु कुछ प्रेरितहोन से पुछन लग्या, “हे भैइहोन अरु बहीनहोन हम का करणु?” <verse eid="ACT 2:37" /><verse number="38" style="v" sid="ACT 2:38" />पतरस ने उनसे बोल्यो मन फिरानु, अरु तुम मे से हर एक अपना अपना पापहोन कि माफ का लिये यीशु मसीह का नाम से बपतिस्मा लेनु; ते तुम पवित्र आत्मा को दान पाये. <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />क्युकि यो प्रतीज्ञा तुम, अरु तुम्हारी सन्तानहोन, अरु उन सब दूर का दुन्याहोन का लिये भी हइ जिनको प्रभु हमारो परमेश्वर अपना पास बुलाये.<verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />पतरस ने भोत अरु बातहोन से भी गवइ दि दिखे समझायो कि अपना खुद खे या तेडी जात से बचानु. <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />आखरी जेने ओको वचन ग्रहन कर्यो उनने मन से बपतिस्मा लियो. अरु उ दिन तीन हजार इन्सानहोन का नजीकपास उनमे मीली गया. <verse eid="ACT 2:41" /><verse number="42" style="v" sid="ACT 2:42" />अरु वे प्रेरितहोन से शिक्षा पान अरु संगत रखन को अरु रोटी तोडनो अरु प्रार्थना करणा मे लौलीन र्‍हिया.<verse eid="ACT 2:42" /></para>
  <para style="s">विश्वासीहोन को सगत</para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43" />अरु सब दुन्या का मन पर डर छय गयो, अरु खुब अदभुत काम अरु चिन्ह प्रेरितहोन का वजेसे प्रगट होता था. <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />अरु सब विश्वास करणआला जमा र्‍हेता था, अरु उनकी सब चिजहोन हिस्सा मे थी. <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />वे अपनी अपनी सम्पत्ति अरु सामन बेची खे जसी जोकी जरुरत होती थी बाट दिया करता था. <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />वे हरदिन एक मन हुइखे मन्‍दिर मे जमा होता था, अरु घर घर मे रोटी तोडता हुया आनन्द अरु मन की सीधाइ से भोजन कर्या करता था. <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />अरु परमेश्वर की स्तुती करता था, अरु सब दुन्या उनसे खुश था अरु जो उध्दार पाता था.उनको प्रभु हरदिन उनमे मुल्य देतो थो.<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s">मदिर कि भिकारी को अच्छो होनु</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />एक दिन पतरस अरु यहून्ना तीसरा पार प्रार्थना का टेम मे मन्‍दिर मे जै र्‍हा था. <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />अरु दुन्या एक जन्म का लगडा खे लै र्‍हा था जेखे वे हरदिन मन्‍दिर का उ दरवाजा पर जो सुन्दर बोलस हइ बठै देतो थो कि उ मन्‍दिर मे जानआला से भीक माग्ये. <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />जब ओने पतरस अरु यहून्ना को मन्‍दिर मे जाते देख्यो ते ओने भीक मागी <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />पतरस ने यहून्ना का साथ ओका तरफ ध्यान से देखीखे बोल्यो, हमारा तरफ देख. <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />आखरी उ उनसे कुछ पान की आस रखता हुये उनकी तरफ ताकन लग्या. <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />तब पतरस ने बोल्यो चादी अरु सोन्नो ते मरा पास हइ नीका पन जो मरा पास हइ उ तोखे देस हइ. यीशु मसीह नासरी का नाम से चल फिर. <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />अरु ओने ओको जवनो हाथ पकडी खे ओखे उठायो. अरु जल्दी ओका पायहोन अरु घुटना मे बल अय गयो. <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />उ कुदिखे खडो हुइ गयो अरु चलन फिरन लग्यो अरु चलता, अरु कूदते, अरु परमेश्वर की स्तुती करता हुया उनका साथ मन्‍दिर मे गयो. <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />सब दुन्या ने ओखे चलता फिरता अरु परमेश्वर कि स्तुती करता देखीखे. <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />ओखे पैछान लियो कि यो उ हइ जो मन्‍दिर को सुन्दर फाटक पर बठी खे भीक माग्या करतो थो. अरु वा घटना से जो ओका साथ हुइ थी वे भोत अचम्भित अरु चकित हुया.<verse eid="ACT 3:10" /></para>
  <para style="s">मन्‍दिर मे पतरस को उपदेश</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />जब उ पतरस अरु यहून्ना खे पकड्या हुया था, ते सब दुन्या भोत अच्मबो करता हुया ओका ओसरी मे जो सुलैमान को बोलस हइ ओका पास दौडी आया. <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />यो देखी खे पतरस ने दुन्या से बोल्यो, “हे इस्त्राएलिहोन खे तुम यो इन्सान पर क्यु अच्मबो करस हुइ कि अरु हमारी तरफ क्यु यो प्रकार देखी र्‍हा हइ कि मानो हम ही ने अपना सामर्थ्य या भक्ति से येखे चलना फिरना योग्य बनइ दियो.” <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />अब्राहम अरु इसहाक अरु याकूब को परमेश्वर हमारा बापदादाहोन को परमेश्वर ने अपना सेवक यीशु की महिमा की जेखे तुम ने पकड्यइ दियो, अरु जब पिलातुस ने ओखे छोड देन को बीचार कर्यो, तब तुम ने ओका सामने ओको इनकार कर्यो. <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />तुम ने उ पवित्र अरु धर्मी को इनकार कर्यो, अरु प्रार्थना करी कि एक हत्यारा, तुम्हारा लिये छोड दिया जाये. <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />अरु तुम ने जिवन को कर्ता खे मारी डाल्यो जो परमेश्वर ने मर्या हुया मे से जिन्दो. अरु या बात कि हम गवा हइ.<verse eid="ACT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 3:16" />अरु ओका नाम ने उ विश्वास का वजेसे जो ओका नाम पर हइ, यो इन्सानखे जेखे तुम देखस हइ अरु जानस भी हइ सामर्थ दियो हइ. उ विश्वास ने जो ओका वजेसे हइ, येको तुम सब, सामने बिलकुल भलो अच्छो करी दियो हइ.<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />अब हे भैइहोन अरु बहीनहोन, मी जानुस हइ कि यो काम तुम ने अज्ञानता मे कर्यो, अरु वसो ही तुम्हारा सरदारहोन ने भी कर्यो. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />पन जो बातहोन खे परमेश्वर ने सब भविष्यव्दक्ताहोन क मेडा से पैयले ही बत्यै दियो थो, कि ओको मसीह दुख उठायेका उनखे, ओने या रीति से पूरो कर्यो. <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />येका लियेका मन फिरानु अरु लौट आनू कि जोकासे का सामने से अराम का दिन आये. <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />अरु उ प्रभु यीशु खे भेज्ये जो तुम्हारा लिये पैयले हि से मसीह ठैरायो गयो हइ. <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />जरुरी हइ कि उ स्वर्ग मे उ टेम तक र्‍हिये जब तक कि उ सब बातहोन, सुधार नी करी ले जोकी बातचीत पुराना काल से परमेश्वर ने अपना पवित्र भविष्यव्दक्ताहोन का मेडा से करी हइ. <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />जसो कि मूसा ने बोल्यो, प्रभु परमेश्वर तुम्हारा भैइहोन अरु बहीनहोन मे से तुम्हारा लिये मरा जसो एक भविष्यव्दक्ता उठायेका जो कुछ उ तुम से बोल्येका ओकी सुन्नु. <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />पन हरेक इन्सान जो उ भविष्यव्दक्ता कि नी सुन्ये का दुन्या का मन मे से खत्म कर्यो जाये. <verse eid="ACT 3:23" /><verse number="24" style="v" sid="ACT 3:24" />अरु शमूएल से लिखे ओका बाद आनआलो तक जोत्ता भविष्यव्दक्ता बोल्ये उन सब ने इन दिनहोन को सन्देश दियो हइ. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />तुम भविष्यव्दक्ताहोन की सन्तान अरु वा वाचा को हिस्सेदार हुया, जो परमेश्वर ने तुम्हारा बापदादाहोन से बाधी, जब ओने अब्राहम से बोल्यो, तरा कुल का वजेसे पृथ्वी का पुरा घराना आशिर्वाद मील्ये. <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />परमेश्वर ने अपना सेवक खे उठैखे पैयले तुम्हारा पास भेज्येका कि तुम मे से हर एक खे ओकी बुराइहोन से फेरीखे आशिर्वाद देनु.<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s">महासभा, सामने पतरस अरु यहून्ना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />जब वे दुन्या से यो बोली र्‍हा था, ते याजक अरु मन्‍दिर को सरदार अरु सदूकि उन पर चड आया. <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />क्युकि वे भोत घुस्सा हुया कि वे इन्सानहोन खे सिखाता था अरु यीशु को उदाहरण दि दिखे मर्या हुया खे जिन्दो उठन को प्रचार करता था. <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />उनने उनखे पकडी खे दुसरा दिन तक हआलात मे रख्यो क्युकि संज्जा हुइ गइ थी. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />पन वचन खे सुननआला मे से भोतझन ने विश्वास कर्यो, अरु उनकी गिनती पाच हजार का नजीकपास हुइ गइ.<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />दूसरा दिन असो हुयो कि उनका सरदार अरु बापदादाहोन अरु शास्त्री. <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />अरु महायाजक हन्ना अरु कैफा अरु यहून्ना अरु सिकन्दर अरु जोत्ता महायाजक का घराना का था, सब यरुशलेम मे जमा हुया. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />वे उनका बीच मे खडा करीखे पूछन लग्या कि तुम ने यो काम कोका सामर्थ्य से अरु कोका नाम से कर्यो हइ.<verse eid="ACT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8" />तब पतरस ने पवित्र आत्मा पुरो पुरो हुइ, उनसे बोल्यो. <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />हे दुन्याहोन को सरदारहोन अरु बापदादाहोन को या दुर्बल इन्सान का साथ जो भलाइ करी गइ हइ, अगर आज हम से उनका बारे मे पूछ ताच करी जास हइ, कि उ कसो अच्छो हुयो. <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />ते तुम सब इस्राएल अरु पुरा इस्त्राएली दुन्या जानी ले कि यीशु मसीह नासरी का नाम से जेखे तुम ने क्रुस पर चडायो अरु परमेश्वर ने मर्या हुया मे से जिन्दो कर्यो यो इन्सान तुम्हारा सामने भलो अच्छो हइ. <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />यो उ पत्थर हइ</para>
  <para style="q1" vid="ACT 4:11">जेखे तुमने राजमिस्त्रीहोन ने तुच्छ जान्यो</para>
  <para style="q2" vid="ACT 4:11">अरु उ कोना को सिरा को पत्थर हुइ गयो. <verse eid="ACT 4:11" /><verse number="12" style="v" sid="ACT 4:12" />कोइ दुसरा का वजेसे उध्दार नी. क्युकि स्वर्ग का नीचे इन्सानहोन मे अरु कोइ दुसरो नाम नी दियो गयो जेका वजेसे हम उध्दार पर सक्ये.<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />जब उनने पतरस अरु यहून्ना को हिम्मत देख्यो अरु यो जान्यो कि यो अनाडी अरु साधारन इन्सान हइ ते अच्मबो कर्यो. फिर उनका पैछान्यो कि यो यीशु का साथ र्‍हियो हइ. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />उ इन्सान खे जो अच्छो हुयो थो, उनका साथ खडो देखी खे वे विरोध मे कुछ नी बोली सक्या. <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />पन उनखे सभा का भैहिर जान कि आज्ञा दिखे वे आपस मे बिचार करण लग्या, <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />हम ये इन्सानहोन का साथ का कर्या? क्युकि यरुशलेम का सब र्‍हेनआला पर प्रगट हइ, कि इन का वजेसे एक प्रसिद्ध चिन्ह दिखायो गयो हइ, अरु हम उनको इनकार नी करी सक्ये. <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />पन येका लिये कि या बात दुन्या मे अरु जादा फैली नी जाये, हम उनका धमकाये, कि वे या नाम से फिर कोय इन्सान से बात नी करणु. <verse eid="ACT 4:17" /><verse number="18" style="v" sid="ACT 4:18" />तब उनखे बुलायो अरु चेतावनी दिखे बोल्यो, यीशु का नाम से कुछ भी नी बोलनु अरु नी सिखानी. <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />पन पतरस अरु यहून्ना ने उनका जवाब दियो, तुम हि न्याय करण; का यो परमेश्वर का पास भलो हइ कि हम परमेश्वर कि बात से बडीखे तुम्हारी बात मान्ये. <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />क्युकि यो ते हम से हुइ नी सक्ये कि जो हम ने देख्यो अरु सुन्यो हइ, वे नी बोल्ये. <verse eid="ACT 4:20" /><verse number="21" style="v" sid="ACT 4:21" />तब उनने उनका धमक्यै छोडी दियो, खे क्युकि दुन्या करण उनखे दण्ड देन को दावो नी मील्यो, येका लिये कि जो घटना हुइ थी ओ का कारन सब दुन्या परमेश्वर कि बडैइ करता था <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />उ इन्सान का जेका पर यो अच्छो करण को चिन्ह दिखायो गयो थो, चालीस साल से जादा उम्र को थो.<verse eid="ACT 4:22" /></para>
  <para style="s">विश्वासीहोन, साहस, लिये प्रार्थना</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />वे छुटीखे अपना साथीहोन का पास आया खे अरु जो प्रधान याजकहोन अरु बापदादाहोन ने उनसे बोल्यो थो, उनका सुन्य दियो. <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />यो सुनी, उनने एक चित्त हुइ, उचो बोल से परमेश्वर से बोल्यो हे स्वामी, तू उ हइ जेने स्वर्ग अरु जमीन अरु समुद्र अरु जो कुछ उनमे हइ बनायो. <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />तोने पवित्र आत्मा का वजेसे अपना सेवक हमारो बाप दाउद का मुडा से बोल्यो.</para>
  <para style="q1" vid="ACT 4:25">गैरयहूदिहोन ने हुल्लड क्यु मचायो?</para>
  <para style="q2" vid="ACT 4:25">अरु देश का दुन्या ने बेकार बातहोन सोची<verse eid="ACT 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26" />प्रभु अरु ओका मसीह का</para>
  <para style="q2" vid="ACT 4:26">विरोध मे पृथ्वी को राजाहोन खडा हुया,</para>
  <para style="q2" vid="ACT 4:26">अरु शासक एक साथ जमा हुइ गया. <verse eid="ACT 4:26" /><verse number="27" style="v" sid="ACT 4:27" />क्युकि सच्चीई तरा पवित्र सेवक यीशु का विरोध मे जेको तो ने अभिषेक कर्यो, हेरोदेस अरु पुन्तियुस पिलातुस भी गैरयहूदिहोन अरु इस्त्राएलिहोन का साथ या नगर मे जमा हुया. <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />कि जो कुछ पैयले से तरी सामर्थ्य अरु मती से ठैरायो थो उ करणु. <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />अब हे प्रभु, उनकी धमकिहोन खे देख. अरु अपना सेवकहोन को वरदान देनु कि तरो वचन बडा हिम्मत से सुनाये. <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />अच्छो करण का लिये तू अपनो हाथ बडा कि चिन्ह अरु अदभुत काम तरा पवित्र सेवक यीशु का नाम से कर्यो जाये.<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />जब वे प्रार्थना करी चुक्या, ते उ जगा जहा वे जमा था हली गया अरु वे सब पवित्र आत्मा से परीपूर्ण हुइ गया, अरु परमेश्वर को वचन हिम्मत से सुनाता र्‍हिये.<verse eid="ACT 4:31" /></para>
  <para style="s">विश्वासीहोन को जिवन</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />विश्वास करणआला कि मंडली एक चित्त अरु एक मन कि थी, ह्या तक कि कोइ भी अपनी सम्पत्ती अपनी नी करतो थो, पन सब कुछ हिस्सेदार मे थो. <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />प्रेरित बडो सामर्थ्य से प्रभु यीशु को जिन्दो उठस कि गवा देता र्‍हिये अरु उन सब पर बडो अनुग्रह थो. <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />उनमे कोय भी दरिद्र नी थो क्युकी जिन का पास जमीन या घर था वे उनखे बेची खे बिकी हुइ चिजहोन को दाम लाता, अरु ओका प्रेरितहोन का पायहोन पर रखता था. <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />अरु जसी जोकि जरुरत होती थी, ओका जसो हर एक खे बाटी दिया करता था.<verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />यूसुफ नाम साइप्रस को एक लेवी थो जेको नाम प्रेरितहोन ने बरनबास मंनजे शांती को बेटो रख्यो थो. <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />ओकी कुछ जमीन थी जो खे ओने बेच्यो अरु दाम का रुप्या लिखे प्रेरितहोन को पायहोन पर रखी दियो.<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s">हनन्याह अरु सफीरा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />हनन्याह नाम को एक इन्सान अरु ओकी लुगइ, सफीरा ने कुछ जमीन बेची <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />अरु ओको दाम मे से कुछ रखी छोडो. अरु या बात ओकी लुगइ भी जानती थी, अरु ओको एक भाग लैखे प्रेरितहोन का पायहोन का सामने रखी दियो. <verse eid="ACT 5:2" /><verse number="3" style="v" sid="ACT 5:3" />पतरस ने बोल्यो, हे हनन्याह! सैतान ने तरा मन मे या बात क्यु डाली कि तु पवित्र आत्मा से झुठ बोल्ये, अरु जमीन का दाम मे से कुछ रखी छोड्यो. <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />जब तक उ तरा पास र्‍हिये, का तरी नी थी? अरु जब बिकी गइ ते का तरा कब्जा मे नी थी? तो ने या बात अपना मन मे क्यु बिचारी तू इन्सान से नी, पन परमेश्वर से झुठ बोल्यो हइ. <verse eid="ACT 5:4" /><verse number="5" style="v" sid="ACT 5:5" />या बात सुनते ही हनन्याह गिरी पड्यो अरु जान छुड्यी दिये, अरु सब सुननआला पर बडो डर छै गयो. <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />फिर जवानहोन ने उठै खे ओकी अर्थी बनइ अरु भैइर ली जैखे गाड दियो.<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />नजीकपास तीन घंटा का बाद ओकी लुगइ जो कुछ हुयो थो नी जानीखे अंदर अय गइ. <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />तब पतरस ने ओकासे बोल्यो, मेखे बता तुम ने उ जमीन येत्ता ही मे बेची थी? ओने बोल्यो हा येत्ता ही मे.<verse eid="ACT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9" />पतरस ने ओकासे बोल्यो, या का बात हइ कि तुम दो ने प्रभु का आत्मा की परीक्षा का लिये येका कर्यो? तरा अदमी का गाडनआला दरवाजो ही पर खडा हइ अरु तोखे भी बाहेर लि जाये. <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />तब उ जल्दी ओका पायहोन पर गिरी पडि अरु जान छोडी दियो अरु जवानहोन ने अंदर अयखे ओखे मर्यो पय्यो अरु बाहेर लि जैखे ओका अदमी का पास गाडी दियो. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />पुरी मंडली पर अरु या बातहोन खे सुननआला पर बडो डर छै गयो.<verse eid="ACT 5:11" /></para>
  <para style="s">चिन्ह अरु अदभुत काम</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />प्रेरितहोन का हाथहोन से भोत चिन्ह अरु अदभुत काम दुन्या का बीच मे दिखायो जाता था, अरु वे सब एक चित्त हुइखे सुलैमान का ओसरी मे जमा हुया करता था. <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />पन अरु मे से कोय खे यो हिम्मत नी होती थी कि उनमे जय मीले. तेभी दुन्या उनकी बडाइ करता था. <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />विश्वास करणआला भोत सा इन्सान अरु बय प्रभु की मंडली मे बडि संख्या मे मीलते र्‍हिये. <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />ह्या तक कि दुन्या बिमारहोन खे सडकहोन पर लैइ खे खटियाहोन अरु बिछानाहोन पर सोयो देता था कि जब पतरस आये, ते ओकी छाया ही उनमे से कोइ पर पडि जाये. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />यरुशलेम का आस पास का नगर से भी भोत दुन्या बीमारहोन अरु बुरी आत्मा का सताया हुया खे लैइ लैइखे जमा होता था, अरु सब अच्छो करी दिया जाता था.<verse eid="ACT 5:16" /></para>
  <para style="s">प्रेरितहोन की गिरफ्तारी</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />तब महायाजक अरु ओका सब साथी जो सदूकिहोन का पंथ का था, जलन से भरी उठ्यो. <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />अरु प्रेरितहोन खे पकडिखे बन्दिघर मे बन्द करी दियो. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />पन रात खे प्रभु का एक स्वर्गदूत ने बन्दीगृह का दरवाजा खोली खे उनखे बाहेर लइखे बोल्यो. <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />“जा मन्दिर मे खडा हुइ खे या जिवन की सब बातहोन दुन्या खे सुनानु.” <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />वे यो सुनीखे फजर होते ही मन्दिर मे जैखे उपदेश देन लग्या. तब महायाजक अरु ओका साथिहोन ने अयखे महासभा का</para>
  <para style="p" vid="ACT 5:21">अरु इस्त्राएलिहोन का सब बुजुरुखहोन खे जमा कर्यो, अरु बन्दीघर मे बुलाओ भेज्यो कि उनखे लाह्ये. <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />पन अधिकारीहोन ने वहा पहुची खे उनखे बन्दीगृह मे नी पय्यो, अरु पलटि खे संदेश दियो. <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />हम ने बन्दीघर खे बडि चौकसी से बन्द कर्यो हुयो, अरु राखनआलो खे बाहेर दरवाजाहोन पर खडा हुया पाया. पन जब खोल्यो ते अंदर कोइ नी मील्यो. <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />जब मन्दिर का सरदार अरु मुखियो याजकहोन ने या बातहोन सुनी ते उनका बारे मे भारी चिन्ता मे पडि गया कि उनको का हुयो. <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />इत्ता मे कोय ने अयखे उनखे बतायो कि देखनु जिन खे, “तुम ने बन्दीगृह मे बन्द रख्यो थो का वे मनुष्य मन्दिर मे खडा हुया दुन्या खे उपदेश दि र्‍हा हइ.” <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />जब सरदार प्‍यादाहोन का साथ जैखे उनखे लि आया, पन बलपूर्वक नी क्युकि वे दुन्या से डरता था कि हम पर पथराव नी करणु. <verse eid="ACT 5:26" /><verse number="27" style="v" sid="ACT 5:27" />ओने उनखे लैइखे महासभा का सामने खडा करी दियो. तब महायाजक ने उनसे पूछ्यो. <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />का हम ने तुमखे जत्यै खे आज्ञा नी दी थी कि तुम यो नाम से उपदेश नी करणु? तेभी देखनु, तुम ने पुरा यरुशलेम खे अपना उपदेश से भरी दियो हइ अरु उ इन्सान को खुन हमारा गर्दन पर लानो चाहस हइ.<verse eid="ACT 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29" />तब पतरस अरु दुसरा प्रेरितहोन ने जवाब दियो, इन्सान कि आज्ञा से बडिखे परमेश्वर कि आज्ञा को पालन करणु ही हमारो काम हइ <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />हमारा बापदादाहोन ने परमेश्वर ने यीशु खे जिन्दो, जोखे तुम ने क्रुस पर लटकै खे मारी डाल्यो थो. <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />ओ खे परमेश्वर ने प्रभु अरु उद्धारकर्ता ठैर्यखे , अपना जवना हाथ पर उचो करी दियो, कि उ इस्त्राएलिहोन खे मन फिराव की शक्ति अरु पापहोन की माफ प्रदान करणु. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />हम या बात का गवा हइ अरु ओसो हि पवित्र आत्मा भी, जोखे परमेश्वर ने उनखे दियो हइ जो ओकी आज्ञा मानस हइ.<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />यो सुनीखे वे जली गया, अरु उनखे मारी डालनो चायो. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />पन गमलीएल नाम को एक फरीसी ने जो व्यवस्थापक अरु सब दुन्या मे माननीय थो, कोरट मे खडा हुइखे प्रेरितहोन खे थोडि देर का लिये बाहेर करी देन की आज्ञा दी. <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />तब ओने बोल्यो, हे इस्त्राएलिहोन, तुम जो कुछ ये इन्सानहोन से करणो चाहस हइ सोची समझी खे करणु. <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />क्युकि यो दिनहोन से पैयले थियुदास यो बोलता हुये उठ्यो, कि मी भी कुछ हइ. अरु कोय चार सौ इन्सान ओका साथ हुइ लिया पन उ मार्यो गयो अरु जोत्ता दुन्या ओखे मानता था, सब तितर-बितर हुया अरु मीटि गया. <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />ओका बाद नाम लिखाइ का दिनहोन मे यहुदा गलीली उठ्यो अरु कुछ दुन्या अपना तरफ करी लिया. उ भी खत्म हुइ गया अरु जोत्ता दुन्या ओखे मानता था सब तितर बितर हुइ गया. <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />येकालिये अब मी तुम से बोलुस हइ इन इन्सानहोन से दुर ही र्‍हेनु अरु इन से कुछ काम नी रखनु. क्युकि अगर यो धर्म या काम इन्सानहोन कि तरफ से हुये तब ते मीटी जाये. <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />पन अगर परमेश्वर का तरफ से हइ, ते तुम उनखे कदापि मीटी नी सक्ये.</para>
  <para style="p" vid="ACT 5:39">कही असो नी हुये कि तुम परमेश्वर से भी लडनआला ठैर्ये, <verse eid="ACT 5:39" /><verse number="40" style="v" sid="ACT 5:40" />तब उनने ओकी बात मानी ली. अरु प्रेरितहोन खे बुलैइ खे पिटवायो. अरु यो आदेश दिखे छोड दियो कि यीशु का नाम से फिर कोइ बात नी करणु. <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />वे या बात से खुश हुइखे महासभा का सामने से चली गया, कि हम ओका नाम का लिये अपमान होन का योग्य ठैर्ये. <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />वे हरदिन मन्दिर मे अरु घर मे उपदेश करण, अरु या बात को सुसमाचार सुनाना से कि यीशु हि मसीह हइ नी रुख्या.<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">सात</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />उन दिनहोन मे जब चेलाहोन की गीनती बडन लगी, तब यूनानी भाषा बोलनआला इब्रानी भाषा बोलनआला पर कुरकुर करण लग्या कि हरदिन कि सेवकाइ मे हमारी विधवाहोन कि याद नी ली जाय. <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />तब उन बाराझन ने चेलाहोन की मन्डली खे अपना पास बुलैइ खे “बोल्यो यो ठीक नी कि हम परमेश्वर को वचन छोडी खे खान पिलान कि सेवा मे र्‍हिये. <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />येका लिये हे भैइहोन अरु भैइनहोन अपना मे से सात सुनाम इन्सानहोन, जो पवित्र आत्मा अरु बुध्दि से परिपूर्ण हइ, चुनी ले, कि हम उनका यो काम पर ठैर्य दे. <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />लेकीन हम तो प्रार्थना मे अरु वचन की सेवा मे लग्या र्‍हिये.”<verse eid="ACT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5" />या बात पुरी मंडली खे अच्छी लगी, अरु उनने स्तिफनुस नामको एक इन्सान को जो विश्वास अरु पवित्र आत्मा से परिपूर्ण थो, फिलिप्पुस, अरु पुरखुरुस, अरु नीकानोर अरु तीमोन, अरु परमीनास, अरु अन्ताकियावासी नीकुलास के जो यहूदीया मत मे अय गयो थो, चुनी लियो. <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />इन्हे प्रेरितहोन का सामने खडो कर्यो अरु उनने प्रार्थना करीखे उन पर हाथ रख्यो. <verse eid="ACT 6:6" /><verse number="7" style="v" sid="ACT 6:7" />परमेश्वर को वचन फैलाता गयो अरु यरुशलेम मे चेलाहोन की गिनती भोत बडी गइ. अरु याजकहोन को बडो समाज यो मत खे माननआला हुइ गया.<verse eid="ACT 6:7" /></para>
  <para style="s">स्तिफनुस कि गिरफ्तारी</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />स्तिफनुस अनुग्रह अरु सामर्थ्य से परिपूर्ण हुइ खे दुन्या मे बडा बडा अदभुत काम अरु चिन्ह दिखायो करतो थो. <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />तब उ आराधनालय मे से दासत्व - मुक्त की कैलाती थी, अरु कुरेनी अरु सिकन्दरिया अरु किलिकिया अरु आसिया का दुन्या मे से कइ एक उठैखे स्तिफनुस से वाद विवाद करण लग्या. <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />पन उ ज्ञान अरु उ आत्मा को जोकासे उ बातहोन करतो थो, वे सामना नी करी सक्ये. <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />येका पर उनने कइ दुन्या खे उभार्यो जो बोलन लग्या, “हम ने येके मूसा अरु परमेश्वर का विरोध मे नीन्दा की बातहोन बोलता सुन्यो हइ.” <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />अरु दुन्या अरु बुजरुक अरु शास्त्रियहोन, भडकी खे चडी आया अरु ओके पकडी खे महासभा मे लि आया. <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />अरु झुठा गवा खडा कर्या जेने बोल्यो. “यो इन्सान या,” पवित्र जगा अरु व्यवस्था का विरोध मे “बोलनु नी छोड्यो. <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />क्युकि हम ने ओका यो बोलता सुन्यो हइ कि योइ यीशु नासरी या जगा खे झाकि दियो, अरु वा रीतिहोन खे बदली डाल्यो जो मूसा ने हम खे दि दियोस हइ.” <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />तब सब दुन्या ने जो सभा मे बैठ्या था ओ पर नजर गडाइ ते ओको मुडो स्वर्गदूत को जसो दिख्यो.<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">स्तिफनुस को भाषाण</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />तब महायाजक ने बोल्यो, का या बातहोन सच्ची हइ?<verse eid="ACT 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2" />स्तिफनुस ने बोल्यो हे भैइहोन अरु बापहोन सुन्नु. हमारो बाप अब्राहम हारान मे बसना से पैयले जब मेसोपोटामीया मे थो. तेजमय परमेश्वर ने ओखे दर्शन दियो. <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />अरु ओकसे बोल्यो तू अपना देस अरु अपना कुटुम्ब से नीकलीखे उ देश मे जा, जेखे मेने तोखे दिखायो. <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />तब उ कसदियहोन का देस से नीकलीखे हारान परमेश्वर ने ओखे वहा से या देस मे लैखे बसायो जेमे अब तुम बसस हय. <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />अरु ओखे कुछ मीरास क्युकी पाय रखना भर की भी ओमे जगा नी दी, पन प्रतीज्ञा करी कि मी यो देस तरा अरु बाद तरा वंश का हाथ करी दियु. यध्दपी उ टेम मे ओका कोय बेटो भी नी थो. <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />अरु परमेश्वर ने यो बोल्यो, तरी सन्तान खे दुन्या दुसरा देस मे परदेशी हुये, अरु वे उनका सेवक बनाये अरु चार सौ साल तक दुख दिये. <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />फिर परमेश्वर ने बोल्यो, जो जात का वे दास हुये ओखे नी दण्ड दियु, अरु ओका बाद वे नीकलीखे या जगा मरी सेवा कर्ये. <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />अरु ओने ओकासे खतना कि वाचा बांधी. अरु यो देस मे इसहाक ओकासे पइदा हुयो अरु आठवा दिन ओको खतनो कर्यो गयो. अरु इसहाक से याकूब अरु याकूब से बारा कुलपति पइदा हुयो.<verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />कुल पतिहोन ने यूसुफ से जलन करीखे ओखे मीस्र देस जानआला होन का हाथ बेच्यो. पन परमेश्वर ओका साथ थो. <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />अरु ओखे ओका सब क्लेशहोन से छुड्य खे मीस्र को राजा फिरौन की नजर मे अनुग्रह अरु बुध्दि प्रदान करी, अरु ओने ओखे मीस्र पर अरु अपना पुरा घर पर हाकिम नीयुक्त कर्यो. <verse eid="ACT 7:10" /><verse number="11" style="v" sid="ACT 7:11" />तब मीस्र अरु कनान का पुरा देस मे अकाल पड्यो. जोका से भारी क्लेश हुयो, अरु हमारा बापदादाहोन की अनाज नी मील्यो थो. <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />पन याकूब ने यो सुनीखे खे मीस्र मे अनाज हइ, हमारा बापदादाहोन खे पयली बार भेज्यो. <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />दूसरी बार यूसुफ ने खुद खे अपना भैइहोन पर प्रगट कर्यो अरु यूसुफ की जाति फिरौन खे मालूम हुइ गइ. <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />तब यूसुफ ने अपना बाप याकूब अरु अपना पुरा कुटुम्ब खे जो पचहत्तर इन्सान का मन था, बुलाओ भेज्यो. <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />तब याकूब मीस्र मे गयो. अरु वहा उ अरु हमारा बापदादा मरी गया. <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />उनको शव शकेम मे पहुच्ये जैखे ओखे मरगट मे रख्यो गयो, जेखे अब्राहम ने चादी दिखे हमोर की सन्तान से मोल लियो थो.<verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />पन जब वा प्रतीज्ञा का पुरा होन का टेम मे पास आयो जो परमेश्वर ने अब्राहम से करी थी, ते मीस्र मे वे दुन्या बडि गया अरु भोत हुइ गया. <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />तब मीस्र मे दूसरो राजो हुयो जो यूसुफ खे नी जानतो थो. <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />ओने हमारी जाति से चलाकी करीखे हमारा बापदादाहोन का साथ ह्या तक बुरो व्यवहार कर्यो, कि उनने अपना बच्चाहोन खे फेकी देनो पड्यो कि वे जीन्दा नी र्‍हिया. <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />यो टेम मे मूसा पइदा हुयो. उ परमेश्वर की नजर मे भोत ही सुन्दर थो उ तीन महीना तक अपना बाप का घर मे पाल्यो गयो. <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />जब फेकी दियो गयो ते फिरौन की बेटी ने ओखे उठैइ लियो, अरु अपनो बेटो करीखे पाल्यो. <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />मूसा खे मीस्रिहोन की सब विध्या पडैइ गइ, अरु उ वचन अरु कर्म दो मे सामर्थी थो.<verse eid="ACT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23" />जब उ चालीस साल को हुयो ते ओका मन मे आयो कि मी अपना इस्त्राएली भैइहोन से भेट कर्यु. <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />ओने एक इन्सान पर अन्याय होते देखीखे ओखे बचायो, अरु मीस्रिहोन खे मारी खे सताया हुया खे बदलो लियो. <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />ओने सोच्यो कि ओका भैइहोन समझ्ये कि परमेश्वर ओका हाथहोन से उनको उध्दार कर्ये, पन उनने नी समझ्यो. <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />दूसरा दिन जब वे आपस मे लडि र्‍हा था ते उ वहा अय नीकल्यो. अरु यो बोलीखे उनने मेल करण का लिये समझायो, हे इन्सानहोन, तुम तो भैइहोन हइ, एक दूसरा पर क्यु अन्याय करस हइ? <verse eid="ACT 7:26" /><verse number="27" style="v" sid="ACT 7:27" />पन जो अपना बाजुआला पर अन्याय करी र्‍हा था, ओने उनसे यो बोलीखे बाजुकरी दियो तोखे कोने हम पर डाॅकटर अरु न्याय रख्यो हइ? <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />का जो रीति से तो ने कल मीस्रिहोन खे मारी डाल्यो मेखे भी मारी डालनो चाहस हइ? <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />या बात सुनीखे मूसा भाग्यो अरु मीघान देस मे परदेशी हुइखे र्‍हेन लग्यो, अरु वहा ओका दो बेटा पइदा हुया.<verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />जब पूरा चालीस साल बीती गया ते एक स्वर्गदूत ने सीनै टेकडी का जंगल मे ओखे जलनआली झाडि की अंगार मे दर्शन दियो. <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />मूसा यो दर्शन देखीखे अचंभ हुय गो, अरु जब देखन का लिये उ पास गयो, ते प्रभु को यो बोल हुयो. <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />मी तरा बापदादाहोन, अब्राहम, इसहाक अरु याकूब को परमेश्वर हइ, तब ते मूसा थर थरानो, ह्या तक कि ओखे देखन को हिम्मत नी र्‍हियो. <verse eid="ACT 7:32" /><verse number="33" style="v" sid="ACT 7:33" />तब प्रभु ने ओकासे बोल्यो, अपना पायहोन से जुती उतारी ले, क्युकि जो जगा तु खडो हइ, वा पवित्र जमीन हइ. <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />मे ने सचमुच अपना दुन्या की जो मीस्र मे हय कि दुर्दशा खे देख्यो हइ अरु उनकी आह अरु उनको रोनो सुन्यो हइ. येकालिये उनने छुड्य लिये उतार्यो हइ. अब आ, मी तोखे मीस्र मे भेज्यू<verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />जो मूसा खे उनने यो बोलीखे नाकार्यो थो तोखे कोइ ने हम पर हाकिम अरु न्याय ठैरायो हइ? ओ खे परमेश्वर ने हाकिम अरु छुडानआलो ठैर्यखे , उ स्वर्गदूत का वजेसे जेने ओखे झाडि मे दर्शन दियो थो, भेज्यो. <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />यो इन्सान मीस्र देस अरु लाल समुंदर अरु जंगल मे चालीस साल तक अदभुत काम अरु चिन्ह दिख्य देखीखे उनखे नीकाली लायो. <verse eid="ACT 7:36" /><verse number="37" style="v" sid="ACT 7:37" />यो उ मूसा हइ, जेने इस्त्राएलिहोन से बोल्यो, परमेश्वर तुम्हारा भैइहोन मे से तुम्हारा लिये मरा जसो एक भविष्यव्दक्ता उठाये. <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />यो उ हइ, जेने जंगल मे मंडली का बीच उ स्वर्गदूत का साथ सीनै टेकडा पर ओकासे बातहोन करी अरु हमारा बापदादाहोन का साथ थो, ओ खे जिन्दो वचन मील्यो कि हम तक पहुचायो.<verse eid="ACT 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39" />पन हमारा बापदादाहोन ने ओकी माननो नी चायो, क्युकी ओखे हटैखे अपनो मन मीस्र की तरफ फेर्यो. <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />अरु हारुन से बोल्यो, हमारा लिये असो देवतो बना जो हमारा आगे-आगे चल्ये. क्युकि यो मूसा जो हम खे मीस्र देस से नीकाली लायो, हम नी जाने ओखे का हुयो? <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />उ दिनहोन मे उनने एक बच्चो बनी खे ओकी मुरती का आगे बलि चड्यैइ, अरु अपना हाथहोन का कामहोन मे मगन होन लग्यो. <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />आखरी परमेश्वर ने मुडो मोडिखे उनखे छोडी दियो कि आकाश-गन खे पूज्ये, जसो भविष्य-व्दक्ताहोन की किताब मे लिख्यो हइ,</para>
  <para style="q1" vid="ACT 7:42">हे इस्राएल का घराना,</para>
  <para style="q2" vid="ACT 7:42">का तुम जंसगल मे चालीस साल तक जनवर कि बलि</para>
  <para style="q2" vid="ACT 7:42">अरु अनाज बलि मेखे चडाता र्‍हिये.<verse eid="ACT 7:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43" />तुम मोलेक का झोपडि अरु रिफान देवता का तारा का लिये फिरता था,</para>
  <para style="q2" vid="ACT 7:43">मंनजे उन मूर्तीहोन खे जेने तुम ने प्रणाम करण का लिये बनायो थो.</para>
  <para style="q1" vid="ACT 7:43">आखरी मे तुमखे बेबीलोन का पार ली जैइ खे बसायु.<verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />गवा की झोपडि जंगल मे हमारा बापदादाहोन का बीच मे थी, जसो ओने ठैरायो जेने मूसा से बोल्यो. <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />ओखे झोपडि खे हमारा बापदादाहोन जुन्नो जमाना से परई खे यहोशू का साथ ह्या लि आया जो टेम मे कि उनने उन गैरयहूदीहोन पर अधिकार पायो जेने परमेश्वर ने हमारा बापदादाहोन का सामने से नीकाली दियो, अरु वा झोपडि दाउद का टेम मे तक र्‍हिये. <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />ओका पर परमेश्वर ने अनुग्रह कर्यो. आखरी ओने प्रार्थना करी कि उ याकूब को परमेश्वर का लिये जगा बनानु. <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />पन सुलैमान ने ओका लिये घर बनायो.<verse eid="ACT 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48" />पन परम प्रधान हात का बनाया घरहोन मे नी र्‍हे, जसो कि भविष्यव्दक्ता ने बोल्यो<verse eid="ACT 7:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49" />प्रभु बोलस हइ स्वर्ग मरी राजगद्दी</para>
  <para style="q2" vid="ACT 7:49">अरु पृथ्वी मरा पाय का नीच्चे की पीडि हइ,</para>
  <para style="q1" vid="ACT 7:49">मरा लिये तुम कोइ प्रकार को घर बनाये?</para>
  <para style="q2" vid="ACT 7:49">अरु मरी अराम की कोन सी जगा हुये?<verse eid="ACT 7:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50" />का ये सब चिजहोन मरा हाथ की बनइ नी?<verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />हे हठेला, अरु मन अरु कान का खतनारहित दुन्या खे तुम हमेशा पवित्र आत्मा का विरोध करस हइ. जसो तुम्हारा बापदादाहोन करता था, ओसो ही तुम भी करस हइ. <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />भविष्य-व्दक्ताहोन मे से कोइ खे तुम्हारा बापदादाहोन ने नी सतायो? उनने उ धर्मी का आगमन का जुन्नो जमाना से सन्देश देनआला खे मारी डाल्यो. अरु अब तुम भी ओखे पकडानआला अरु मारी डालनाला हुये. <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />तुम ने स्वर्गदूत का वजेसे ठैराइ हुइ व्यवस्था खे पाइ, पन ओको पालन नी कर्यो.<verse eid="ACT 7:53" /></para>
  <para style="s">स्तिफनुस का उपर पथराव</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />या बात सुनीखे वे जली गया अरु ओका पर दात पीसन लग्या. <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />पन ओने पवित्र आत्मा से परिपूर्ण हुइखे स्वर्ग कि तरफ देख्यो अरु परमेश्वर की महिमा खे अरु यीशु खे परमेश्वर का जवना तरफ खडो हुयो देख्यो . <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />देखनु मी स्वर्ग खे खुल्यो हुयो, अरु इन्सान का बेटा खे परमेश्वर का जवना तरफ खडो हुयो देखुस हइ.<verse eid="ACT 7:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57" />तब उनने बडो बोल से चिल्लय खे कान बन्द करी लिया अरु एक साथ ओ पर झपट्या, <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />अरु उ नगर का बाहेर नीकलीखे ओ पर पथराव करण लग्या. गवा ने अपना कपडा शाउल नामको एक जवान का पायहोन का पास उतारी खे रखी दियो. <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />वे स्तिफनुस पर पथराव करता र्‍हिया, अरु उ यो बोलीखे प्रार्थना करतो र्‍हिये, “हे प्रभु यीशु मरी आत्मा खे अपनइ ले. <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />फिर घुटना टेकिखे उचो बोल से पुकारनु, हे प्रभु यो पाप उन पर मत लगानु.” अरु यो बोलीखे उ सोइ गयो.<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="s">मंडली पर अत्याचार</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />शाउल उ दिन यरुशलेम की मंडली पर बडो उपद्रव सुरवात हुयो अरु प्रेरितहोन खे छोड सब का सब यहूदीया अरु सामरिया देशहोन मे तितर बितर हुइ गा. <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />कुछ भक्तहोन ने स्तिफनुस खे कब्र मे रख्यो अरु ओका लिये बडो विलाप कर्यो.<verse eid="ACT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 8:3" />शाउल मंडली खे उजाडी रो थो. अरु घर घर घुसीखे अदमी अरु बयहोन खे घिसी खे बन्दीगृह मे डालतो थो.<verse eid="ACT 8:3" /></para>
  <para style="s">सामरिया मे फिलिप्पुस को प्रचार</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />जो तितर बितर हुया था, वे सुसमाचार सुनता हुया फिर्या. <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />अरु फिलिप्पुस सामरिया नगर मे जैखे दुन्या मे मसीह को प्रचार करण लग्यो. <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />जो बातहोन फिलिप्पुस ने बोली वे दुन्या ने सुनीखे अरु जो चिन्ह उ दिखातो थो उनके देखी देखी खे एक चित्त हुइ खे मन लगायो. <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />क्युकि खुप मे से बुरी आत्माहोन बडा बोल से चिल्लाते हुयो नीकली गयो, अरु खुप सा लखवा रोगी अरु लगडा भी अच्छो कर्‍यो गयो. <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />अरु उ नगर मे खुशी छै गइ.<verse eid="ACT 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />येका से पैयले उ नगर मे शमौन नाम को एक इन्सान थो, जो जादू टोना करी खे सामरिया का दुन्या खे चकित करतो अरु अपना खुद खे एक बडो इन्सान बतातो थो. <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />छोटा से बडा तक सब ओको सम्मान करणु बोलतो थो, “यो इन्सान परमेश्वर की वा शक्ति हइ ‘जो महान बोल्यो जास हइ.’” <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />ओने भोत दिन से उनका अपना जादू का काम होन से चकित करतो थो. येका लिये वे ओखे भोत मानता था. <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />पन जब उनने फिलिप्पुस को विश्वास कर्यो जो परमेश्वर को राज्य अरु यीशु मसीह का नाम को सुसमाचार सुनातो थो ते दुन्या, का अदमी, का बय, बपतिस्मा लेन लग्या. <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />तब शमौन ने खुद भी विश्वास कर्यो अरु बपतिस्मा लिखे फिलिप्पुस का साथ र्‍हेन लग्यो. उ चिन्ह अरु बडो सामर्थ्य को काम होता देखी खे चकित होतो थो.<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />जब प्रेरितहोन ने जो यरुशलेम मे थो, सुन्यो कि सामरियाहोन ने परमेश्वर को वचन मानी लियो हइ ते पतरस अरु यहून्ना को ओका पास भेज्यो. <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />उनने जयखे उनका लिये प्रार्थना करी कि पवित्र आत्मा पाये. <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />क्युकि उ अब तक उनमे से कोय पर नी उतर्यो थो. उनने ते फक्त प्रभु यीशु का नाम मे बपतिस्मा लियो थो. <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />तब उनने उन पर हाथ रख्यो अरु उनने पवित्र आत्मा पायो.<verse eid="ACT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />जब शमौन ने देख्यो कि प्रेरितहोन का हाथ रखना से पवित्र आत्मा दियो जास हइ ते उनका पास रुप्या लयखे बोल्यो. <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />यो अधिकार मेखे भी दे, कि जो कोय पर हाथ रख्यु उ पवित्र आत्मा पाये.<verse eid="ACT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20" />पतरस ने ओकासे बोल्यो, तरा रुप्या तरा साथ खत्म हुये क्युकि तो ने परमेश्वर को दान रुप्या से मोल लेन को बिचार कर्यो. <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />या बात मे नी तरा हिस्सो हइ नी भाग क्युकि तरो मन परमेश्वर का आगे सीधो नी. <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />येका लिये अपनी या बुराइ से मन फिरानु प्रभु से प्रार्थना करणु ,सम्भव हइ तरो मन को बिचार माफ कर्यो जाये. <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />क्युकि मी देखुस हइ कि तु पित्त की सी कडुपन अरु अधर्म का बन्धन मे पड्यो हइ.<verse eid="ACT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24" />शमौन ने जवाब दियो, “तुम मरा लिये प्रभु से प्रार्थना करणु कि जो बातहोन तुम ने बोली, उनमे से कोय मरा पर नी अय पड्या.”<verse eid="ACT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25" />आखरी वे गवा दियेका अरु प्रभु को वचन सुनीखे यरुशलेम खे लौटी गया अरु सामरीहोन को भोत सा गावहोन मे सुसमाचार सुनाता गया.<verse eid="ACT 8:25" /></para>
  <para style="s">फिलिप्पुस अरु कूश देश को अधिकारी</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />फिर प्रभु को एक स्वर्गदूत ने फिलिप्पुस से बोल्यो “उट अरु दक्षिन दिशा का तरफ उ मार्ग पर जा जो यरुशलेम से गाजा खे जास हइ.” <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />उ उठी खे चली दियो, अरु देखनु कि कूश देश को एक इन्सान अय र्‍हो थो जो खोजा अरु कूशियहोन की रानी कन्दाका, को अधिकारी अरु खजाची थो. उ आराधना करण खे यरुशलेम आयो थो. <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />उ अपना रथ पर बठौ हुयो थो, अरु यशायाह भविष्यव्दक्ता की किताब पडते हुयो वापीस जै रो थो. <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />तब आत्मा ने फिलिप्पुस ने बोल्यो का पास “जैइखे या रथ का साथ हुइ ले.” <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />फिलिप्पुस ओका तरफ दौड्यो अरु ओका यशायाह भविष्यव्दक्ता की किताब पडता हुया सुन्यो, अरु पूछ्यो, “तू जो पडी र्‍हो हइ, ओखे समझय भी हइ?”<verse eid="ACT 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31" />ओने बोल्यो, “जब तक कोय मेखे नी समझाये ते मी कसो समझ्यु?” अरु ओने फिलिप्पुस से प्रार्थना करी कि व्हा चेडी खे ओका पास बठ्यो. <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />पवित्रशास्त्र को जो अध्याय उ पडी र्‍हो थो, उ यो थो</para>
  <para style="q1" vid="ACT 8:32">उ मेडा का जसो खुन होन खे पहुचायो गयो,</para>
  <para style="q2" vid="ACT 8:32">अरु जसो मेडो अपना वे कतरन आला को जसो चुपचाप र्‍हेस हइ,</para>
  <para style="q2" vid="ACT 8:32">वसो ही ओने भी अपना मुडो नी खोल्यो.<verse eid="ACT 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33" />ओका दीनता मे ओको न्याय नी हुइ पायो.</para>
  <para style="q1" vid="ACT 8:33">ओका टेम मे दुन्या को वर्णन कोन कर्ये?</para>
  <para style="q2" vid="ACT 8:33">क्युकि पृथ्वी से ओको जान उठैइ लियो जास हइ.<verse eid="ACT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />ये पर खोजा ने फिलिप्पुस से पुछ्यो, “मी तरा से प्रार्थना करुस हइ यो बता कि भविष्यव्दक्ता यो बारे मे बोलस हइ, अपना या कोय दुसरा का बारे मे?” <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />तब फिलिप्पुस ने अपनो मुडो खोल्यो, अरु या शास्त्र से सुरवात करीखे ओका यीशु को सुसमाचार सुनायो. <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />रस्ता मे चलते चलते वे कोय पाणी का जगा पहुच्या. तब ढुडन बोल्यो, “देख ह्या पाणी हइ, अब मेखे बपतिस्मा लेना मे कान रोखस हइ.” <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />फिलिप्पुस ने बोल्यो, अगर तू पुरा मन से से विश्वास करस हइ ते लि सकस हइ ओने जवाब दियो, “मी विश्वास करुस हइ कि यीशु मसीह परमेश्वर को बेटो हइ.”<verse eid="ACT 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 8:38" />तब ओने रथ खडो करण की आज्ञा दी, अरु फिलिप्पुस अरु खोजा दो पाणी मे उतर गया, अरु ओने खोजा खे बपतिस्मा दियो. <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />जब वे पाणी मे से नीकली खे उपर आया, ते प्रभु कि आत्मा फिलिप्पुस खे उठै लि गयो, अरु खोजा ने ओखे फिर नी देख्यो, अरु उ आनन्द करता हुया अपना रस्ता पर चली गयो. <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />फिलिप्पुस अशदोद मे अय नीकल्यो, अरु जब तक कैसरिया मे नी पउच्यो, तब तक नगर नगर सुसमाचार सुनातो गयो.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">शाउल को मन परिवर्तन</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />शाउल जो अब तक प्रभु का चेलाहोन खे धमकानो अरु घात करण की धुन मे थो, महायाजक का पास गयो. <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />अरु ओकासे दमीश्क का आराधनालयहोन का नाम पर या अभिप्राय की चिटिहोन मागी कि, का अदमी, का बय, जेने उ या पथ पर पाये उनका बाधीखे यरुशलेम ली आया.<verse eid="ACT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3" />पन चलता चलता जब उ दमीश्क का पास पहुच्या, ते एक-एक बद्दल से ओका चारो तरफ ज्योति चमकी. <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />अरु उ जमीन पर गिरी पड्यो अरु यो अवाज सुनी, हे शाउल, हे शाउल, तु मेखे क्यु सतास हइ?<verse eid="ACT 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5" />“ओने पूछ्यो,” हे प्रभु तू कोन हइ?</para>
  <para style="p" vid="ACT 9:5">ओने बोल्यो, “मी यीशु हइ,” जेखे तू सतास हइ. <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />“पन अब उठीखे नगर मे जा, अरु जो तोखे करणो हइ उ तरा से बोल्‍या जाये.”<verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />जो इन्सान ओका साथ थो, वे अवाक्य र्‍हि गयो क्युकि बोल ते सुनता था पन कोय, देखतो नी थो. <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />तब शाउल जमीन पर से उठौ, पन जब आखहोन खोल्या ते ओखे कुछ दिखइ नी दियो, अरु वे ओका हाथ पकडी खे दमीश्क मे लि गया. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />उ तीन दिन तक देखी नी सक्यो, अरु नी खायो अरु नी पीयो.<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />दमीश्क मे हनन्याह नाम को एक चेलो थो का ओकासे प्रभु ने दर्शन मे बोल्यो, हे हनन्याह ओने बोल्यो, का “हा प्रभु.”<verse eid="ACT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11" />तब प्रभु ने ओकासे बोल्यो उठीखे , “वा गल्ली मे जा जो सीधी बोलीजास हइ, अरु यहूदा का घर मे शाउल नाम को एक तरसुस वासी खे पूछ्यो. देख उ प्रार्थना करी र्‍हो हइ. <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />अरु ओने हनन्याह नाम को एक इन्सान का अंदर आते अरु अपना उपर हाथ रखता देख्यो हइ. ताकि फिर से नजर पाये.”<verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />हनन्याह ने जवाब दियो, “ हे प्रभु मे ने यो इन्सान का बारे मे भोत सो सुन्यो हइ कि येने यरुशलेम मे तरा पवित्र दुन्या का साथ बडी बुराइहोन करी हइ. <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />अरु ह्या भी येका प्रधान याजकहोन का तरफ से अधिकार मील्यो हइ कि जो दुन्या तरो नाम लेस हइ, उन सब खे बाधी ले.”<verse eid="ACT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15" />पन प्रभु ने ओकासे बोल्यो, तू चली जा. क्युकि उ ते गैरयहूदिहोन अरु राजाहोन अरु इस्त्राएलिहोन का सामने मरो नाम प्रगट करन का लिये मरो चुन्यो हुयो पात्र हइ. <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />अरु मी ओखे बतायु कि मरा नाम का लिये ओखे कसो कसो दुख उठानु पड्ये.<verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />तब हनन्याह उठीखे उ घर मे गयो, अरु ओका पर अपनो हाथ रखी खे बोल्यो हे भैइ शाउल प्रभु मंनजे यीशु जो उ रस्ता मे जेका से तू आयो तोखे दिखइ दियो थो, ओ ने मेखे भेज्यो हइ कि तू फिर नजर पाये अरु पवित्र आत्मा से परिपूर्ण हुइ जाये. <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />अरु जल्दी ओकी आखहोन से छिलका से गिर्या अरु उ देखन लग्यो, अरु उठीखे बपतिस्मा लियो. <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />फिर भोजन करीखे बल पायो. उ कइ दिन वे चेलाहोन का साथ र्‍हियो जो दमीश्क मे थो.<verse eid="ACT 9:19" /></para>
  <para style="s">दमीश्क मे शाउल का वजेसे प्रचार</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 9:20" />अरु उ जल्दी आराधनालयहोन मे यीशु को प्रचार करण लग्या कि उ परमेश्वर को बेटो हइ.<verse eid="ACT 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 9:21" />सब सुननआला चकित हुइ खे बोलन लग्या, का योही उ इन्सान नी हइ जो यरुशलेम मे उनका जो यो नाम खे लेता था, खत्म करता था. अरु ह्या भी येका लिये आयो थो कि उनका बाधी खे प्रधान याजकहोन का पास लि जाये?<verse eid="ACT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 9:22" />पन शाउल अरु भी सामर्थी होतो गयो, अरु या बात को प्रमाण दि दि, कि मसीह योही हइ, दमीश्क का र्‍हेनआला यहूदीयाहोन को मुडो बन्द करतो र्‍हियो.<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />जब भोत दिन बीती गया ते यहूदीयाहोन ने मीलिखे ओका मारी डालन को षड्यन्त्र रच्यो. <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />पन उनको षड्यन्त्र शाउल खे मालुम हुइ गयो. वे तो ओखे मारी डाल्यो का लिये रात दिन फाटकहोन पर घात मे लग्या र्‍हेता था. <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />पन रात खे ओका चेलाहोन ने ओखे टोपला मे बठाड्यो, अरु शहर दिवाल छेद मे से लटकि खे उतारी दियो.<verse eid="ACT 9:25" /></para>
  <para style="s">यरुशलेम मे शाउल</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />यरुशलेम मे पहुची खे ओने चेलाहोन का साथ मीली जान को कोशिश कर्यो. पन सब ओकासे डरता था, क्युकि उनका विश्वास नी होतो थो, कि उ भी चेलो हइ. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />पन बरनबास ने ओका अपना साथ प्रेरितहोन का पास लि जैइ खे उनखे बतायो कि येने कोय रीति से मार्ग मे प्रभु खे देख्यो, अरु ओने येका से बातहोन करी. फिर दमीश्क मे येने कसो हिम्मत से यीशु का नाम से प्रचार कर्यो. <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />उ प्रभु उनका साथ यरुशलेम मे आता जाते र्‍हियो <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />अरु नी धडक हुइ खे प्रभु का नाम से प्रचार करतो थो. अरु यूनानी भाषा बोलनआला यहूदीयाहोन का साथ बातचित वाद विवाद करतो थो. पन वे ओखे मारी डालन कि कोशिश करण लग्या. <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />यो जानीखे भैइ ओखे कैसरिया लि आयो, अरु तरसुस खे भेजी दियो.<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />यो प्रकार पुरा यहूदीया, अरु गलील, अरु सामरिया मे मंडली खे चैन मील्यो, अरु ओकी उन्नती होती गइ. अरु उ प्रभु को डर अरु पवित्र आत्मा की शांती मे चलती अरु बडती गइ.<verse eid="ACT 9:31" /></para>
  <para style="s">लुद्दा अरु याफा मे पतरस</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />फिर असो हुयो कि पतरस हर जगा फिरतो हुयो, उन पवित्र दुन्या का पास भी पहुच्या जो लुद्दा मे र्‍हेता था. <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />वहा ओका एनीयास नाम को लखवा को रोगी एक इन्सान मील्यो, जो आठ साल से खटिया पर पड्यो थो. <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />पतरस ने ओकासे बोल्यो, “ हे एनीयास! यीशु मसीह तोखे अच्छो करस हइ. उट अपनो बिछानो बिछा.” तब उ जल्दी उठी खडो हुयो. <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />तब लुद्दा अरु शारोन को सब र्‍हेनआला ओका देखी खे प्रभु की तरफ फिर्या.<verse eid="ACT 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />याफा मे तबीता मंनजे दोरकास नाम की एक विश्वासिनी र्‍हेती थी. वाभोत सा अच्छो अच्छो काम अरु दान कर्या करती थी. <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />उ दिनहोन मे वा बीमार हुइ खे मरी गइ. अरु उनने ओको आंग धोलय खे अटारी पर रखी दियो. <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />येका लिये कि लुद्दा याफा का पास थो, चेलाहोन ने यो सुनी खे कि पतरस वहा हइ, दो इन्सान भेजी खे ओका से प्रार्थना करी खे हमारा पास आना मे देर नी करणु. <verse eid="ACT 9:38" /><verse number="39" style="v" sid="ACT 9:39" />तब पतरस उठी खे उनका साथ हय लियो, अरु जब उ पहुच्यो ते वे ओका उ अटारी पर लि गया. सब विधवाहोन रोती हुइ ओका पास अय खडी हुइ अरु जो कुर्ता अरु कपडा दोरकास ने उनका साथ र्‍हेता हुया बनायो थो, दिखान लगी. <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />तब पतरस ने सब खे बाहेर करी दियो, अरु घुटना टेकीखे प्रार्थना करी अरु लास का तरफ देखी, बोल्यो, “ हे तबीता, उट” तब ओने अपनी आखहोन खोली दी. अरु पतरस खे देखीखे उठ बठी. <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />ओने हाथ दिखे ओखे उठाय खे अरु पवित्र दुन्या अरु विधवाहोन खे बुलैइ खे ओखे जिन्दो दिखइ दियो. <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />या बात पुरा याफा मे फैली गइ. अरु भोतझन ने प्रभु पर विश्वास कर्यो. <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />अरु पतरस याफा मे शमौन नामको कोय चामडा को धंदो करणआला का ह्या भोत दिन तक र्‍हियो.<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">कुरनेलियुस को पतरस खे बुलानो</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />कैसरिया मे कुरनेलियुस नाम को एक इन्सान थो, जो इतालियानी नामको पलटन को सुबेदार थो. <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />उ भक्त थो, अरु अपना पुरा घराना समेत परमेश्वर से डरतो थो, अरु यहूदी दुन्या खे भोत दान देतो, अरु बराबर परमेश्वर से प्रार्थना करतो थो. <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />ओने दिन का तीसरा पार का पास दर्शन मे स्पष्ट रुप से देख्यो कि परमेश्वर को एक स्वर्गदूत ओका पास अंदर अयखे बोल्यो हइ “हे कुरनेलियुस”<verse eid="ACT 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4" />ओने ओखे ध्यान से देख्यो अरु डरीखे बोल्यो, “ हे प्रभु का हइ?”</para>
  <para style="p" vid="ACT 10:4">ओने ओकासे बोल्यो, “तरी प्रार्थना अरु तरो दान याद का लिये परमेश्वर का सामने पहुच्यो हइ. <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />अरु सब याफा मे इन्सान भेजी खे शमौन खे जो पतरस कैलातो हइ, बुलय ले. <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />उ शमौन, चामडा को धंदो करणआला का ह्या मीजवान हइ, जोको घर समुंदर का किनारा हइ.” <verse eid="ACT 10:6" /><verse number="7" style="v" sid="ACT 10:7" />जब उ स्वर्गदूत जेने ओकासे बातहोन करी थी चली गयो, ते ओने दो सेवक, अरु जो ओका पास हाजिर र्‍हियो करतो थो उनमे से एक भक्त सिपइ खे बुलायो. <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />अरु उनखे सब बातहोन बतयखे याफा खे भेज्यो.<verse eid="ACT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />दूसरा दिन जब वे चलते चलते नगर का पास पहुच्या, ते धुपार का पास पतरस छपर पर प्रार्थना करण चड्यो. <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />ओखे भुक लगी अरु कुछ खानो चातो थो, पन जब वे तैयारी करी र्‍हा था ते उ बेसुध हुइ गयो. <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />अरु ओने देख्यो, कि बद्दल खुली गयो. अरु एक पात्र बडि चद्दर का जसो चारी कोना से लटकातो हुयो, पृथ्वी की तरफ उतरी र्‍हो हइ. <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />जे मे पृथ्वी का सब प्रकार का चारपाय अरु रेंगनआला जन्तु अरु बद्दल का पक्षि था. <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />ओखे एक असो बोल सुनइ दियो “हे पतरस उठ मार अरु खा,”<verse eid="ACT 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14" />पन पतरस ने बोल्यो, “नी प्रभु कभी भी नी क्युकि मेने कभी कोय अपवित्र या अच्छो चिज नी खे हइ.”<verse eid="ACT 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15" />फिर दूसरी बार ओको बोल सुनइ दियो, जो कुछ परमेश्वर ने अच्छो ठैरायो हइ, ओखे तु अच्छो मत बोल. <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />तीन बार असो ही हुयो. तब जल्दी उ पात्र बद्दल पर उठै लियो गयो.<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />जब पतरस अपना मन मे दुविधा मे थो, कि यो दर्शन जो मे ने देख्यो उ का हुइ सकस हइ, ते देखनु, वे इन्सान जिनखे कुरनेलियुस ने भेज्यो थो, उ शमौन का घर को पतो लगइखे दरवाजा पर अयखे खडा हुया. <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />अरु पुकारी खे पूछन लग्या, का शमौन जो पतरस कैलातो हइ, योही मीजवान हइ?<verse eid="ACT 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19" />पतरस ते उ दर्शन पर सोची ही र्‍हो थो, कि आत्मा ने ओकासे बोल्यो, “देखनु, तीन इन्सान तरी खोज मे हइ. <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />आखरी उठी खे नीचे जा, अरु नी. संकोच उनका साथ ही ले क्युकि मे ने ही उनखे भेज्यो हइ.” <verse eid="ACT 10:20" /><verse number="21" style="v" sid="ACT 10:21" />तब पतरस ने उतरीखे उ इन्सान से बोल्यो, देख्यो, जोकी खोज तुम करी र्‍हो हइ, उ मी ही हइ. तुमारा आना को का कारण हइ?<verse eid="ACT 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22" />उनने बोल्यो, “कुरनेलियुस सुबेदार जो धर्मी अरु परमेश्वर से डरन आलो अरु पुरी यहूदी जात मे सुनाम इन्सान हइ, ओने एक पवित्र स्वर्गदूत से यो नीर्देश पायो हइ कि तोखे अपना घर बुलैइ खे तरा से वचन सुन्ये.” <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />तब ओने उनने अंदर बुलायो उनकी मीजवानी करी.</para>
  <para style="p" vid="ACT 10:23">दूसरा दिन उ उनका साथ गयो, अरु याफा का भैइहोन मे से कुछ ओका साथ गया.<verse eid="ACT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 10:24" />दूसरा दिन वे कैसरिया पहुच्या, अरु कुरनेलियुस उनकी रस्ता दिखी र्‍हो थो. <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />जब पतरस अंदर अय र्‍हो थो, ते कुरनेलियुस ने ओकासे दान करी खे अरु पायहोन पर गिरी खे ओखे प्रणाम कर्यो. <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />पन पतरस ने ओखे उठयखे बोल्यो, “खडो हो, मी भी तो इन्सान हइ.” <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />अरु ओका साथ बातचीत करता हुया अंदर गया, अरु भोत सा दुन्या खे एकजगा देखीखे <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />उनसे बोल्यो, तुम जानस हइ कि गैरयहूदी की संगत करणो या ओका साथ ह्या जानो यहूदीहोन का लिये अधर्म हइ, पन परमेश्वर ने मेखे बतायो हइ कि कोय इन्सान खे अपवित्र या अच्छो नी बोल्यु. <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />येका लिये मी जब बुलायो गयो ते बिना कुछ बोले चली आयो. अब मी पूछुस हइ कि मेखे कोय काम का लिये बुलायो गयो?<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />हे कुरनेलियुस ने बोल्यो, या घडि खे पूरा चार दिन हुया, मी अपना घर मे तीसरा पार प्रार्थना करी र्‍हो थो. ते देख्यो, एक अदमी चमकीलो कपडा पेन्या हुयो, मरा सामने अय खडो हुयो. <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />अरु बोलन लग्या, हे कुरनेलियुस, तरी प्रार्थना सुनी ली गइ हइ अरु तरो दान परमेश्वर का सामने याद कर्यो गयो हइ. <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />येकालिये कोय खे याफा भेजीखे शमौन खे जो पतरस कैलातो हइ , बुला. उ समुंदर का किनारा शमौन, चामडा को धंदो करणआला का घर मे मीजवान हइ. <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />तब मे ने जल्दी तरा पास दुन्या भेज्ये, अरु तो ने भलो कर्यो जो अय गयो. अब हम सब ह्या परमेश्वर का सामने हइ , ताकि जो कुछ परमेश्वर ने तरा से बोल्यो हइ ओखे सुन्ये.<verse eid="ACT 10:33" /></para>
  <para style="s">पतरस को उपदेश</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />तब पतरस ने बोल्यो, “अब मेखे नीश्चय हुयो कि परमेश्वर कोय को पक्ष नी कर्ये. <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />क्युकी हर जात मे जो ओखे डरतो अरु धर्म को काम करस हइ, उ ओखे भास हइ. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />जो वचन ओने इस्त्राएलिहोन का पास भेज्यो, जब ओने यीशु मसीह का वजेसे जो सब को प्रभु हइ शांती को सुसमाचार सुनायो. <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />उ वचन तुम जानस हइ जो यहून्ना को बपतिस्मा को प्रचार का बाद गलील से सुरवात हुइखे पुरा यहूदीया मे फैली गयो. <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />परमेश्वर ने कोय रीति से यीशु नासरी खे पवित्र आत्मा अरु सामर्थ्य से अभिषेक कर्यो, उ भलाइ करस अरु सब खे जो सैतान का सताया हुया था अच्छो करतो फिर्यो,क्युकि परमेश्वर ओका साथ थो. <verse eid="ACT 10:38" /><verse number="39" style="v" sid="ACT 10:39" />हम उन कामहोन को गवा हइ. जो ओने यहूदी को देश अरु यरुशलेम मे भी कर्यो, अरु उनने ओखे काठ पर लटकय खे मारी डाल्यो. <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />ओखे परमेश्वर ने तीसरा दिन जिन्दो, अरु प्रगट भी करी दियो हइ. <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />सब दुन्या पर नी क्युकी उन गवाहोन पर जिन्हे परमेश्वर ने पैयले से चुनी लियो थो, मंनजे हम पर जेने ओका मर्या हुया मे से जिन्दो उठना का बाद ओका साथ खायो पीयो. <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />अरु ओने हमखे आज्ञा दी कि दुन्या मे प्रचार कर अरु गवय दे, कि यो उ हइ जोख परमेश्वर ने जिन्दो अरु मर्या हुयो को न्याय ठैरायो हइ. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />ओका सब भविष्यव्दक्ता गवय देस हइ कि जो कोय ओ पर विश्वास कर्ये, ओखे ओका नाम का वजेसे पापहोन की माफी मील्ये.”<verse eid="ACT 10:43" /></para>
  <para style="s">गैरयहूदीहोन पर पवित्र आत्मा उतरनु</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />पतरस या बातहोन बोली ही र्‍हो थो कि पवित्र आत्मा वचन खे सब सुननआला पर उतरी आयो. <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />अरु जित्ता खतनो कर्या हुया विश्वासी पतरस का साथ आया था, वे सब चकित हुया कि गैरयहूदीहोन पर भी पवित्र आत्मा को दान दियो गयो हइ. <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />क्युकि उनने उनखे भाती भाती कि भाषा बोलता अरु परमेश्वर की बडाइ करता सुन्यो. ये पर पतरस ने बोल्यो. <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />का कोय पाणी की रोक खे सकस हइ कि यो बपतिस्मा नी पाये जेने हमारा समान पवित्र आत्मा पायो हइ? <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />अरु ओने आज्ञा दी कि उनने यीशु मसीह का नाम मे बपतिस्मा दिये जाये. तब उनने ओकासे प्रार्थना करी कि उ कुछ दिन अरु उनका साथ र्‍हिये.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s">पतरस वजेसे अपनो काम को स्पष्टीकरण</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />फिर प्रेरितहोन अरु विश्वासी ने जो जो यहूदीया मे थो सुन्यो कि गैरयहूदिहोन ने भी परमेश्वर को वचन मानी लियो हइ. <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />आखरी जब पतरस यरुशलेम मे आयो, ते खतनो कर्यो हुया दुन्या ओकासे वाद विवाद करण लग्या. <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />“तो ने खतनारहित दुन्याहोन का ह्या जैइखे ओका साथ खायो.” <verse eid="ACT 11:3" /><verse number="4" style="v" sid="ACT 11:4" />तब पतरस ने उनका सुरवात से क्रमा नुसार बोल सुनायो.<verse eid="ACT 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 11:5" />“मी याफा नगर मे प्रार्थना करी र्‍हो थो, अरु बेसुद हुइ खे एक दर्शन देख्यो कि एक बर्तन खे बडी चद्दर का समान चार कोना से लटकायो हुयो, बद्दल से उतरी खे मरा पास आयो. <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />जब मे ने ओ पर ध्यान कर्यो, ते ओमे पृथ्वी कि चारपाय अरु जंगल जनवर अरु रेगनआला जन्तु अरु बद्दल का पक्षि देख्यो. <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />अरु यो बोल भी सुन्यो, हे पतरस उट, मार अरु खा. <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />मे ने बोल्यो, नी प्रभु, नी क्युकि कोय अपवित्र या अशुध्द चिज मरा मुडा मे कभी नी गइ. <verse eid="ACT 11:8" /><verse number="9" style="v" sid="ACT 11:9" />येको जवाब मे बद्दल से दूसरी बार बोल हुयो, जो कुछ परमेश्वर ने अच्छो ठैरायो हइ ओखे अशुध्द मत बोल. <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />तीन बार असो ही हुयो. तब सब कुछ फिर बद्दल पर खीची लियो गयो. <verse eid="ACT 11:10" /><verse number="11" style="v" sid="ACT 11:11" />अरु देखनु, जल्दी तीन इन्सान जो कैसरिया से मरा पास भेज्यो गयो थो, उ घर पर जोमे हम था, उ अय खडा हुया. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />तब आत्मा ने मरा से उनका साथ नी.सकोच होन खे बोल्यो, अरु ये छे. भैइ भी मरा साथ हुइ लिया. अरु हम उ इन्सान का घर गया. <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />ओने हम खे बतायो, कि ओने एक स्वर्गदूत खे अपना घर मे खडो देख्यो, जेने ओकासे बोल्यो, याफा मे इन्सान भेजी खे शमौन खे जो पतरस कैलातो हइ, बुलैइ ले. <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />उ तुम से असी बातहोन बोल्ये जिन का वजेसे तू अरु तरो पुरो घरानो उध्दार पाये. <verse eid="ACT 11:14" /><verse number="15" style="v" sid="ACT 11:15" />जब मी बातहोन करण लग्यो, ते पवित्र आत्मा उन पर उ रीति से उतर्यो जो रीति से सुरवात मे हम पर उतर्यो थो. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />तब मेखे प्रभु को उ वचन याद आयो. जो ओने बोल्यो थो, यहून्ना ने तो पाणी से बपतिस्मा दियो, पन तुम पवित्र आत्मा से बपतिस्मा पाये. <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />आखरी जब परमेश्वर ने उनखे भी उ दान दियो, जो हम खे प्रभु यीशु मसीह पर विश्वास करणा से मील्यो थो. ते मी कोन थो जो परमेश्वर खे रोकी सकतो?”<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />यो सुनीखे वे चुप र्‍हेका अरु परमेश्वर की बडाइ करी खे बोलन लग्या, तब ते परमेश्वर ने गैरयहूदिहोन खे भी जिवन का लिये मन फिराव को दान दियो हइ.<verse eid="ACT 11:18" /></para>
  <para style="s">अन्ताकिया की मंडली</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />जो दुन्या उ क्लेश का माऱ्यो जो स्तिफनुस करण पड्यो थो, तितर बितर हुइ गया था, वे घुमते घुमते फीनीके अरु साइप्रस अरु अन्ताकिया मे पहुच्या. पन यहूदीयाहोन खे छोड कोय दुसरा को वचन नी सुनता था. <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />पन उनमे से कुछ साइप्रस वासी अरु कुरेनी था, जो अन्ताकिया मे अय खे यूनानीहोन खे भी प्रभु यीशु को सुसमाचार कि बातहोन सुनान लग्या. <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />प्रभु को हाथ उन पर थो, अरु भोत दुन्या विश्वास करी खे प्रभु का तरफ फिर्या.<verse eid="ACT 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22" />जब उनकी बातचित यरुशलेम की मंडली खे सुनना मे आयो, ते उनने बरनबास खे अन्ताकिया भेज्यो. <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />उ वहा पहुची खे अरु परमेश्वर को अनुग्रह खे देखी खे खुश हुयो, अरु सब खे उपदेश दियो कि तन मन लगयखे प्रभु से लिपट्यो र्‍हियो. <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />उ एक अच्छो इन्सान थो, अरु पवित्र आत्मा अरु विश्वास से परिपूर्ण थो. अरु दुसरा भोत सा दुन्या प्रभु मे अय मील्या.<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />तब उ शाउल खे ढुडन का लिये तरसुस खे चली गयो. <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />जब उ ओकासे मील्यो ते ओखे अन्ताकिया लायो. अरु असो हुयो कि वे एक साल तक मंडली का साथ मीलतो अरु भोत दुन्या खे उपदेश देतो र्‍हिया. अरु चेला सब से पैयले अन्ताकिया ही मे मसीह कैलाये.<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />उय दो मे कइ भविष्यव्दक्ता यरुशलेम से अन्ताकिया आया. <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />उनमे से अगबुस नाम को एक ने खडो हुइ खे आत्मा कि प्रेरणा से या बतायो कि पुरा जगत मे बडो अकाल पड्ये उ अकाल क्लौदियुस का टेम मे पड्यो. <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />तब सेवक होन ने नीर्णय कर्यो कि हर एक अपनी अपनी पुंजी का जसो यहूदीया मे र्‍हेनआला भैइहोन की मदत का लिये कुछ भेजनु. <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />उनने असो हि कर्यो. अरु बरनबास अरु शाउल का हाथ यरुशलेम का बुजरुक का पास पुंजी भेजी दि.<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s">अरु छल</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />उ टेम हेरोदेस राजा ने मंडली का कइ इन्सानहोन का सतान का लिये उन पर हाथ डाल्यो. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />ओने यहून्ना को भैइ याकूब खे तलवार से मरी डाल्यो. <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />जब ओने देख्यो कि यहूदीया दुन्या येका से आनन्दित होस हइ, ते ओने पतरस खे भी पकडी लियो. वे दिन अखमीरी रोटी को दिन था. <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />ओने ओखे पकडी खे बन्दीगृह मे डाल्यो, अरु चार चार का चार पहरेदारहोन मे रख्यो. या बिचार से कि फसह का बाद ओका दुन्या का सामने लायो. <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />बन्दीगृह मे पतरस बन्द थो. पन मंडली ओका लिये लौ लगैइखे परमेश्वर से प्रार्थना करी र्‍हि थी.<verse eid="ACT 12:5" /></para>
  <para style="s">पतरस को जोल से छुटकारो</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />जब हेरोदेस पतरस खे इन्सानहोन का सामने एक रात पहइले, दो साकल से बध्यो हुयो दो सिपैइहोन का बीच मे र्‍हियो थो. अरु दरवाजा पर बन्दीगृह की रखवाली करी र्‍हा था. <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />ते देखनु, प्रभु को एक स्वर्गदूत अय खडो हुयो अरु उ कोठरी मे ज्योति चमकी, अरु ओने पतरस पर हाथ मारी खे ओका जगायो अरु बोल्यो, उट जल्दी कर. अरु ओका हाथ से साकल खुली खे गिरी पडी. <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />तब स्वर्गदूत ने ओकसे बोल्यो, कम्मर बाध अरु अपना जूता पेनी ले. ओने वसो ही कर्यो. फिर ओने ओकासे बोल्यो, अपना कपडा पेनीखे मरा पीछे अय जा. <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />उ नीकली खे ओका पीछे अयगो. पन यो नी जानतो थो कि जो कुछ स्वर्गदूत करी र्‍हो हइ उ सच हइ, क्युकी यो समझ्यो कि मी दर्शन देखी र्‍हो हइ. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />तब वे पैयला अरु दूसरा दुपेर से नीकली खे उ लोहा का फाटक पर पहुचा, जो नगर का तरफ हइ. उ उनका लिये आप से आप खुली गयो, अरु वे नीकली खे एक गल्ली हुइ खे गया, अरु जल्दी ही स्वर्गदूत ओका छोडी खे चली गयो. <figure style="fig" alt="Chains embedded in prison wall" file="HK00204C.TIF" size="col" copy="Horace Knowles ©" ref="12:7">बन्दिघर की दिवाल पर साकल चिपकी हुइ</figure><verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />तब पतरस ने सचेत हुइ खे बोल्यो, “अब मे ने सच जानी लियो हइ कि प्रभु ने अपनो स्वर्गदूत भेजी खे मेखे हेरोदेस का हाथ से छुड्य लियो, अरु यहूदीया होन की पुरी आस तोडी दि हइ.” <verse eid="ACT 12:11" /><verse number="12" style="v" sid="ACT 12:12" />यो जानी खे उ उस यहून्ना की माय मरियम का घर आयो, जो मरकुस बोल्या जास हइ. वहा भोत सा दुन्या जमा हुइ खे प्रार्थना करी र्‍हा था. <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />जब ओने फाटक की खिडकी ठोकी, ते रुदे नाम की एक दासी देखन अय <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />पतरस को बोल पैछानी खे ओने खुशी का मारे फाटक नी खोल्यो, पन दौडी खे अंदर गइ अरु बतायो कि पतरस दरवाजा पर खडो हइ. <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />उनने ओकासे बोल्यो, तू पागल हइ. पन वा दृढता से बोली कि असो हि हइ. तब उनने बोल्यो कि ओको स्वर्गदूत हुये.<verse eid="ACT 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16" />पन पतरस खटखटातो ही र्‍हियो. आखरी उनने खिडकी खोली अरु ओखे देखी खे चकित र्‍हि गया. <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />तब ओने उनका हाथ से हुशार करीयो कि चुप र्‍हे. अरु उनखे बतायो कि प्रभु कोय रीति से ओखे बन्दीगृह से नीकाली लायो हइ. फिर बोल्यो, “याकूब अरु भैइहोन के या बात बतै देनु.” तब नीकली खे दूसरा जगा चली गयो.<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />फजर का सिपैइहोन मे बडी हलचल मची गइ कि पतरस को का हुयो. <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />जब हेरोदेस ने ओकी खोज की अरु नी पायो, ते पहरुहोन की परख्ये करी खे आज्ञा दि कि वे मारी डाल्यो जाये.</para>
  <para style="p" vid="ACT 12:19">अरु उ यहूदीया खे छोडी खे कैसरिया मे जै खे र्‍हेन लग्यो.<verse eid="ACT 12:19" /></para>
  <para style="s">हेरोदेस को मरनो</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />हेरोदेस सूर अरु सैदा का दुन्या से भोत थो. येका लिये वे एक चित्त हुइ खे ओका पास आया. अरु बलास्तुस को जो राजा को एक कर्मचासरी थो, मानी खे मेल करणो चायो. क्युकि राजा का देश से उनका देश को पालन पोषण होतो थो.<verse eid="ACT 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21" />ठैरायो हुया दिन हेरोदेस राज कपडा परनी खे राजगद्दी पर बठौ, अरु उनको व्याख्यान देन लग्यो. <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />तब दुन्या पुकार उठ्यो, यो ते इन्सान को नी इश्वर को बोल हइ. <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />उ टेम प्रभु को एक स्वर्गदूत ने जल्दी ओखे मार्यो, क्युकि ओने परमेश्वर कि महिमा नी दी. अरु उ किडा लगी खे मरी गयो.<verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />पन परमेश्वर को वचन बडतो अरु फैलतो गयो.<verse eid="ACT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25" />जब बरनबास अरु शाउल अपनी सेवा पूरी करी चुक्या ते यहून्ना को जो मरकुस बोल्या जास हइ, साथ ली खे यरुशलेम से लौट्यो.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">बरनबास अरु शाउल खे चुनी खे भेज्यो जानो</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />अन्ताकिया कि मंडली मे कइ भविष्यव्दक्ता अरु उपदेशक था जसा बरनबास अरु शमौन जो नीगर बोलस हइ. अरु लूकियुस कुरेनी, अरु चौथाइ देश को राजो हेरोदेस को दूधभैइ मनाहेम, अरु शाउल. <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />जब वे उपास सहित प्रभु की उपासना करी र्‍हा था ते पवित्र आत्मा ने बोल्यो “मरा लिये बरनबास अरु शाउल खे उ काम का लिये अलग कर्यो जोका लिये मेने उनका बुलायो हइ”<verse eid="ACT 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 13:3" />जब उनने उपास अरु प्रार्थना करीखे अरु उन पर हाथ रखीखे उनका बिदा दी<verse eid="ACT 13:3" /></para>
  <para style="s">पौलुस की पयली प्रचार-जत्रा</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />अत वे पवित्र आत्मा खे भेजा हुया सिलुकिया खे गया अरु वाहा से डोगापर चडिखे साइप्रस खे चले <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />अरु सलमीस मीस्र मे पहुचीखे परमेश्वर को वचन यहूदीया होन खे आराधनालयो मे सुनायो यहून्ना उनका सेवक थो <figure style="fig" alt="Front view of a synagogue" file="LB00246C.TIF" size="col" copy="Horace Knowles ©" ref="13:5">यहूदी आराधनालय</figure><verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />वे उ सारा टापु मे होते हुया पाफुस तक पहुच्या वहा उनने बारा बार यीशु नाम को एक यहूदीया जादुगर अरु झूठा भविष्यव्दक्ता मील्यो. <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />उ हाकिम सिरगियुस पौलुस का साथ थो, जो बुध्दिमान अदमी थो. ओने बरनबास अरु शाउल खे अपना पास बुल्यै खे परमेश्वर को वचन सुननो चाह्यो. <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />पन इलीमास टोन्हे ने, क्युकि योही ओको नाम को अर्थ हइ, उनको विरोध करी खे हाकिम को विश्वास करणा से रोखनो चाह्यो. <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />तब शाउल ने जेको नाम पौलुस भी हइ, पवित्र आत्मा से परिपूर्ण हो ओका तरफ टकटकी लगैइ, देख्यो अरु बोल्यो. <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />हे पुरा दुशमन अरु सब हुशारी से भर्या हुया सैतान कि सन्तान, सब धर्म का बैरी का तु प्रभु कि सीधी रस्ताहोन खे तेडो करणो नी छोड्ये? <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />अब देख, प्रभु को हाथ तरा पर लग्यो हइ. अरु तू कुछ टेम तक अंधो र्‍हिये अरु सूरज खे नी देख्ये. तब तुरन्त अरु अधारो ओ पर छै गयो</para>
  <para style="p" vid="ACT 13:11">अरु उ इधर उधर टोटलन लग्यो ताकि कोय ओको हाथ पकडी खे ली चल्ये. <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />तब हाकिम ने जो हुयो थो ओखे देखी खे अरु प्रभु को उपदेश से चकित हुइ खे विश्वास कर्यो.<verse eid="ACT 13:12" /></para>
  <para style="s">पिसिदिया को अन्तकिया मे</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />पौलुस अरु ओका साथी पाफुस से डोंगो खोलि खे पंफूलिया का पिरगा मे आया अरु यहून्ना उनखे छोड खे यरुशलेम का लौटी गयो. <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />पिरगा से आगे बडी खे वे पिसिदिया का अन्ताकिया मे पहुच्या अरु अराम का दिन आराधनालय मे जैइ खे बठी गयो. <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />व्यवस्था अरु भविष्यव्दक्ताहोन की किताब से पडन का बाद आराधनालय का सरदारहोन ने उनका पास बुलाओ भेज्यो, हे भैइहोन अगर दुन्या खे उपदेश का लिये तुम्हारो मन मे कोय बात हुइ ते बोलनु. <verse eid="ACT 13:15" /><verse number="16" style="v" sid="ACT 13:16" />तब पौलुस ने खडो हुइ खे अरु हाथ से इसारो करी खे बोल्यो, हे इस्त्राएलिहोन,</para>
  <para style="p" vid="ACT 13:16">अरु परमेश्वर से डरनआला, सुन! <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />ये इस्त्राएली दुन्या का परमेश्वर ने हमारा बापदादाहोन खे चुनी लियो, अरु जब ये दुन्या मीस्र देस मे परदेशी हुइ खे र्‍हेता था, ते उनकी उन्नती करी. अरु बलवन्त भुजा से नीकाली लायो. <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />उ कोय चालीस साल तक जंगल मे उनकी सयतो से र्‍हियो. <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />अरु कनान देश मे सात जातीहोन खे नाश करी खे उनको देस कोय साढे चार सौ साल मे इन का मीरास मे करी दियो. <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" />येका बाद ओने शमूएल भविष्यव्दक्ता</para>
  <para style="p" vid="ACT 13:20">तक उनमे न्याय ठैराये. <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />ओका बाद उनने एक राजो माग्यो. तब परमेश्वर ने चालीस साल का लिये बिन्यामीन का गोत्र मे से एक इन्सान. मंनजे कीश को बेटो शाउल के उन पर राजो ठैरायो. <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />फिर ओखे अलग करी खे दाउद खे उनको राजो बनायो. जेका बारे मे ओने गवइ दी मेखे एक इन्सान खे यिशय को बेटो दाउद, मरा मन का जसो मीली गयो हइ. उ मरी पुरी इच्छा पूरी कर्ये. <verse eid="ACT 13:22" /><verse number="23" style="v" sid="ACT 13:23" />ये को कुल मे से परमेश्वर ने अपनी प्रतीज्ञा का जसो इस्राएल का पास एक उद्धारकर्ता, मंनजे यीशु खे भेज्यो. <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />जेका आना से पैयले यहून्ना ने सब इस्त्राएलिहोन मे मन फिराव को बपतिस्मा को प्रचार कर्यो. <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />जब यहून्ना अपनी सेवा पुरी करणा पर थो, ते ओने बोल्यो, तुम मेखे का समझस हुये? मी उ नी! जब देख कामरा बाद एक आनवालो हइ, जेका पाय का जुता भी मी खोलन का योग्य नी.<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />हे भैइ, तुम जो अब्राहम को बेटो हुये. तुम जो परमेश्वर से डरस हुये, तुमारा पास यो उध्दार को वचन भेज्यो गयो हइ. <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />क्युकी यरुशलेम का ऱ्हेनआला अरु उनका सरदार ने, नी ओखे पैछान्यो अरु नी भविष्यव्दक्ताहोन की बात समझी, जो हर अराम का दिन पडी जास हइ येका लिये ओका दोषी ठैर्येके या बात खे पूरी कऱ्यो. <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />उनने मारी डालन का योग्य कोय दोष ओमे नी पायो, तेभी पिलातुस से प्रार्थना करी कि उ मार्ये डाल्ये जाये. <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />जब उनने ओका बारे मे लिखी हुइ सब बातहोन पूरी करी खे ते ओखे क्रुस पर से उतारी खे कब्र मे रख्यो. <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />पन परमेश्वर ने ओखे मर्या हुया मे से जिन्दो. <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />अरु उ उनने जो ओका साथ गलील से यरुशलेम आया था, भोत दिनहोन तक दिखाइ देतो र्‍हियो. <verse eid="ACT 13:31" /><verse number="32" style="v" sid="ACT 13:32" />हम तुम खे वा प्रतीज्ञ का विषय मे जो बापदादाहोन से करी गइ थी, यो सुसमाचार सुनास हइ. <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />कि परमेश्वर ने यीशु खे जिल्यैइ खे उ प्रतीज्ञा हमारी सन्तान का लिये पूरी करी. जसो दुसरा भजन मे भी लिख्यो हइ,</para>
  <para style="q2" vid="ACT 13:33">आज मी तरो बाप बन्यो,</para>
  <para style="q1" vid="ACT 13:33">तू मरो बेटो हइ.<verse eid="ACT 13:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 13:34" />अरु ओका या रीति से मर्या हुया मे से जिलाना का बारे मे भी कि उ कभी नी सड्ये ओने यो बोल्यो हइ,</para>
  <para style="q1" vid="ACT 13:34">मी दाउद पर करी पवित्र</para>
  <para style="q2" vid="ACT 13:34">अरु अटल कृपा तुम पर कर्यु.<verse eid="ACT 13:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35" />येका लिये ओने एक अरु भजन मे भी बोल्यो हइ तू अपना पवित्र जन खे सडन नी दिये. <verse eid="ACT 13:35" /><verse number="36" style="v" sid="ACT 13:36" />क्युकि दाउद तो परमेश्वर की इच्छा का जसो अपना टेम मे सेवा कर खे सोइ गयो, अरु अपना बापदादाहोन मे जै मील्यो, अरु सडी भी गयो. <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />पन जेखे परमेश्वर ने जिन्दो उ सडी नी पायो. <verse eid="ACT 13:37" /><verse number="38" style="v" sid="ACT 13:38" />येका लिये हे भैइहोन तुम जानी ले कि मूसा का वजेसे पापहोन कि माफी को समाचार तुम खे दियो जास हइ. <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />अरु जो बातहोन मे तुम मूसा की व्यवस्था का वजेसे नीर्दोष नी ठैरी सकतो थो, उन्ही सब मे हर एक विश्वास करणआला ओका वजेसे नीर्दोष ठैरस हइ. <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />येका लिये चौकस र्‍हेनु, असो नी हुये कि जो भविष्यव्दक्ताहोन की किताब मे आयो हइ, तुम पर अय पड्ये.<verse eid="ACT 13:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41" />हे नीन्दा करणआला देखनु,</para>
  <para style="q1" vid="ACT 13:41">अरु चकित होनु अरु मीटी जानु.</para>
  <para style="q2" vid="ACT 13:41">क्युकि मी तुम्हारा दिनहोन मे एक काम करुस हइ,</para>
  <para style="q2" vid="ACT 13:41">असो काम कि अगर कोय तुम से ओकी चर्चा कर्ये, ते तुम कभी विश्वास नी कर्ये.<verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />उनका बाहेर निकलता टेम दुन्या उनसे प्रार्थना करण लग्या कि दुसरा आराम का दिन हमके या बातहोन ओका से फिर सुनाइ जाये. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />जब आराधनालय उठी गइ ते यहूदीया होन अरु यहूदीया मत मे आया हुया भक्तहोन मे से भोत सा पौलुस अरु बरनबास का पीछे हुइ गा अरु उनने उनसे बात करी खे समझायो कि परमेश्वर का अनुग्रह मे बन्या र्‍हेनु.<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />अगलो अराम का दिन नगर का प्राय खे सब दुन्या परमेश्वर को वचन सुनान खे जमा हुइ गया. <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />पन यहूदीया गर्दी खे देखी खे डाह से भरी गया, अरु नीन्दा करते हुये पौलुस की बातहोन को विरोध मे बोलन लग्या. <verse eid="ACT 13:45" /><verse number="46" style="v" sid="ACT 13:46" />तब पौलुस अरु बरनबास ने नीडर हुइ, बोल्ये का जरुरी थो कि परमेश्वर को वचन पैयले तुम खे सुनायो जास पन जब तुम ओखे दूर अलग हइ, अरु अपना खे अनन्त जिवन का योग्य नी ठैरय ते देखनु हम गैरयहूदिहोन का तरफ फिरस हइ.<verse eid="ACT 13:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="ACT 13:47" />क्युकि प्रभु ने हम खे</para>
  <para style="q1" vid="ACT 13:47">या आज्ञा दी हइ मे ने तोखे गैरयहूदिहोन का लिये उजालो ठैरायो हइ,</para>
  <para style="q2" vid="ACT 13:47">ताकि तू पृथ्वी का छोर तक उध्दार का वजेसे हुये.<verse eid="ACT 13:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />यो सुनी खे गैरयहूदिहोन खुश हुया अरु परमेश्वर को वचन की बड्यी करण लग्या. अरु जोत्ता अनन्त जिवन का लिये ठैरायो गयो थो, उनने विश्वास कर्यो.<verse eid="ACT 13:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49" />तब प्रभु को वचन उ पुरा देश मे फैलन लग्यो. <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />पन यहूदीया होन ने भक्त अरु कुलीन बयहोन खे अरु नगर का प्रमुख दुन्या खे उसकायो, अरु पौलुस अरु बरनबास का विरुध्द उपद्रव कर्हे खे उनने अपनी सीमा से नीकाली दियो. <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />तब वे उनका सामने अपना पायहोन की धूल झाडि खे इकुनीयुम खे चली गया. <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />अरु चेला खुशी से अरु पवित्र आत्मा से परिपूर्ण होता गया.<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s">इकुनीयुम मे पौलुस अरु बरनबास</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />इकुनीयुम मे असो हुयो कि वे यहूदीया होन आराधनालय प्रकार बात करी कि यहूदीयाहोन अरु यूनानीहोन दो मे से भोतझन ने विश्वास कर्यो. <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />पन विश्वास नी करणआला यहूदीयाहोन ने गैरयहूदिहोन का मन भैइहोन का विरोध मे उकसायो अरु कटुरता पइदा करी दी. <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />वे भोत दिन तक वहा र्‍हिया अरु प्रभु का भरोसा पर हिम्मत से बात करता था. अरु उ उनका हाथहोन से चिन्ह अरु अदभुत काम करी खे अपनो अनुग्रह को वचन पर गवइ देतो थो. <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />पन नगर का दुन्या मे फुट पडी गइ थी, उकासे कत्ता तो यहूदीयाहोन की तरफ अरु कात्ता प्रेरितहोनक का तरफ हूइ गया.<verse eid="ACT 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5" />पन जब गैरयहूदिहोन अरु यहूदीया उनको अपमान अरु उन पर पथराव करण का लिये अपना सरदारहोन समेत उन पर दौड्या. <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />ते वे या बात जानी गया, अरु लुकाउनीया का लुस्त्रा अरु दिरबे नगरहोन मे अरु आस पास का प्रदेशहोन मे भागी गया. <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />अरु वहा सुसमाचार सुनान लग्या.<verse eid="ACT 14:7" /></para>
  <para style="s">लुस्त्रा अरु दिरबे मे</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />लुस्त्रा मे एक इन्सान बठौ थो, जो पाय को नगडो थो उ जन्म ही से लगडो थो अरु कभी नी चल्यो थो. <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />उ पौलुस खे बात करता सुनी र्‍हो थो. पौलुस ने ओका तरफ टकटकी लगैइ खे देख्यो कि ओखे अच्छो हुइ जान को विश्वास हइ. <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />अरु उचो बोल से बोल्यो, अपना पाय का बल सीधो खडो हो. तब उ उछली खे चलन फिरन लग्यो. <verse eid="ACT 14:10" /><verse number="11" style="v" sid="ACT 14:11" />दुन्या ने पौलुस को यो काम देखी खे लुका उनीया की भाषा मे उचो बोल से बोल्यो देवता इन्सानहोन का रुप मे हुइ खे हमारा पास उतरी आया हइ. <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />उनने बरनबास खे ज्यूस अरु पौलुस खे हिरमेस बोल्यो क्युकि उ बात करणा मे मुख्य थो. <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />ज्यूस खे वा मदिर को पुजारी जो उनका नगर का सामने थो, बैल अरु फूलहोन को हार फाटकहोन पर लैइ खे दुन्या का साथ बलिदान करणो चाहतो थो.<verse eid="ACT 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14" />पन बरनबास अरु पौलुस प्रेरितहोन जब यो सुन्यो ते अपना कपडा फाड्या अरु गर्दी मे लुकी खे अरु पुकारी खे बोलन लग्या. <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />हे दुन्या, तुम का करस हइ? हम भी ते तुम्हारा सामन दुख सुख भोग्या इन्सान हइ, अरु तुम खे सुसमाचार सुनास हइ कि तुम इन बेकार चिजहोन से अलग हुइ खे जीवते परमेश्वर का तरफ फिरनु, जेने स्वर्ग अरु पृथ्वी अरु समुदर अरु जो कुछ उनमे हइ बनायो. <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />ओने बीत्या टेमहोन मे सब जातहोन खे अपना अपना मार्गहोन मे चलन दियो. <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />तेभी ओने अपना आप खे बे गवाह नी छोड्यो. किन्तु उ अच्छो करता र्‍हियो, अरु स्वर्ग से बारीश अरु फलवन्त ऋतु दिके तुम्हारा मन को भोजन अरु खुशी से भरता र्‍हियो. <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />यो बोली खे भी उनने दुन्या खे बडी कठनाइ से रोक्यो कि उनका लिये बलिदान नी कर्ये.<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />पन कुछ यहूदीयाहोन ने अन्ताकिया अरु इकुनीयुम से अय खे दुन्या खे अपनी तरफ करी लियो, अरु पौलुस पर पथराव कर्यो, अरु मर्यो समझी खे ओखे नगर का बाहर घसीटी लि गया, <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />पर जब चेला ओका चारी तरफ अय खडा हुया ते उ उठी खे नगर मे गयो अरु दूसरा दिन बरनबास का साथ दिरबे खे चली गयो.<verse eid="ACT 14:20" /></para>
  <para style="s">सीरिया को अन्ताकिया खे लौटनो</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />वे उ नगर का दुन्या को सुसमाचार सुन्ये का, अरु भोत सा चेला बन्या का लुस्त्रा अरु इकुनीयुम अरु अन्ताकिया खे लौटी आया. <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />अरु चेलाहोन का मन खे स्थिर करता र्‍हेनु अरु यो उपदेश देता था कि विश्वास मे बन्या र्‍हेनु. अरु यो बोलता था हम बडा क्लेश उठैइ खे परमेश्वर का राज्य मे प्रवेश करण खे होनु. <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />अरु उनने हर एक मंडली मे उनका लिये बुजरुक ठैरो, अरु उपास सहित प्रार्थना करी खे उनने प्रभु का हाथ सोप्यो जो पर उनने विश्वास कर्यो थो<verse eid="ACT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />तब पिसिदिया से होता हुये वे पंफूलिया पहुच्या; <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />फिर पिरगा मे वचन सुन्ये का अत्तलिया मे आया. <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />अरु वहा से वे डोंगा पर अन्ताकिया गया, जहा वे उ काम का लिये जो उनने पूरो कर्यो थो परमेश्वर का अनुग्रह मे सौप्या गया था.<verse eid="ACT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 14:27" />वहा पहुची खे उनने मंडली जमा करी अरु बतायो कि परमेश्वर ने उनका साथ हुइ खे कसा बडा बडा काम कर्या अरु गैरयहूदिहोन का लिये विश्वास को दरवाजो खोली दियो. <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />अरु वे चेलाहोन का साथ भोत दिन तक र्‍हिया.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s">यरुशलेम की सभा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />फिर कुछ दुन्या यहूदीया से अयखे विश्वासी सीखान लग्या “अगर मूसा कि व्यवस्था पर तुम्हारो खतनो नी होतो तुम उध्दार नी परई सक्ये.” <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />जब पौलुस अरु बरनबास को उनसे भोत वाद विवाद अरु वाद विवाद हुयो ते यो ठैरायो गयो कि पौलुस अरु बरनबास अरु उनमे से कुछ इन्सान या बात का बारे मे प्रेरितहोन अरु बुजरुक का पास यरुशलेम खे जाये.<verse eid="ACT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3" />आखरी मंडली ने उनका कुछ दुर तक पहुचायो. अरु वे फीनीके अरु सामरिया से होते हुये गैरयहूदिहोन को मन फिराना को समाचार सुनाता गयो, अरु सब भैइ भोत खुश हुयो. <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />जब वे यरुशलेम पहुच्या, ते मंडली अरु प्रेरित अरु बुजरुक उनसे खुशी का साथ मील्या अरु उनने बतायो कि परमेश्वर ने उनका साथ हुइ, कसा-कसा काम कर्या था. <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />पन फरीसीहोन को पंथ मे से जेने विश्वास कर्यो थो उनमे से कुछ ने उठी खे बोल्यो, “उनने खतना करणो अरु मूसा की व्यवस्था खे मानन की आज्ञा देनो चाह्यो.”<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />तब प्रेरित अरु बुजरुक या बात का बारे मे विचार करण का लिये जमा हुया. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />तब पतरस ने भोत वाद विवाद हुइ जान का बाद खडा हुइखे उनसे बोल्यो, “हे भैइहोन अरु बहीनहोन तुम जानस हइ कि भोत दिन हुया परमेश्वर ने तुम मे से मेखे चुनी लियो कि मरा मुडा से गैरयहूदिहोन खे सुसमाचार को वचन सुन्यखे विश्वास करणु. <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />मन खे पैछाननआलो परमेश्वर ने उनका भी हमारा समान पवित्र आत्मा दिखे उनकी गवइ दी. <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />अरु विश्वास का वजेसे उनको मन अच्छो करी खे हम मे अरु उन मे कुछ भेद नी रख्यो <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />ते अब तुम का परमेश्वर की परीक्षा करस हइ कि चेलाहोन की गरदन पर असो रखन जेखे नी हमारा बापदादाहोन उठै सक्या था अरु नी हम उठै सकस हइ? <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />हा, हमारा यो नीश्चय हइ कि जो रीति से वे प्रभु यीशु को अनुग्रह से उध्दार पाये; उ रीति से हम भी पाये.”<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />तब सारी सभा चुपचाप बरनबास अरु पौलुस की सुनन लग्या कि परमेश्वर ने उनका वजेसे गैरयहूदिहोन मे कसा बडा बडा चिन्ह, अरु अदभुत काम दिखाया. <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />जब वे चुप हुया ते याकूब बोलन लग्यो हे भैइहोन अरु बहीनहोन मरी सुनो. <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />शमौन ने बतायो कि परमेश्वर ने पैयले गैरयहूदिहोन पर कसी कृपाद्दष्टी करी कि उनमे से अपना नाम का लिये एक दुन्या बनय ले. <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />येमे से भविष्यव्दक्ताहोन की बात भी मीलस हइ, जसो कि लिख्यो हइ.<verse eid="ACT 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16" />येका बाद मी फिर अयखे</para>
  <para style="q2" vid="ACT 15:16">दाउद को गिर्यो हुयो डेरो उठास,</para>
  <para style="q1" vid="ACT 15:16">अरु ओका खडोरख फिर बनायु अरु</para>
  <para style="q2" vid="ACT 15:16">ओखे खडो कर्यु.<verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17" />येका लिये कि कुछ इन्सान,</para>
  <para style="q2" vid="ACT 15:17">मनजो सब गैरयहूदीहोन जो मरा नाम खे बोलस हइ, प्रभु खे ढूढ्ये.<verse eid="ACT 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 15:18" />यो उ प्रभु बोलस हइ जो जगत की उत्पत्ति से इन बातहोन को समाचार देता आयो हइ.<verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />येका लिये मरो बिचार यो हइ कि गैरयहूदिहोन मे से जो दुन्या परमेश्वर कि तरफ फिरस हइ, हम उनका दुख नी देनु. <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />पन उनखे लिखीखे भेज्यो कि वे मूर्ती की अशुध्दताहोन अरु व्यभिचार अरु गल्यो घोटे हुया को मास से अरु खुन से दूर र्‍हेनु. <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />क्युकि पुरानाजमान से नगर नगर मूसा की व्यवस्था को प्रचार करणआला होता चल्यो आया हइ, अरु उ हर अराम को दिन आराधनालय मे पडै जास हइ.<verse eid="ACT 15:21" /></para>
  <para style="s">गैरयहूदीया विश्वासिहोन कि चिठ्ठी</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />तब पूरी मंडली सहित प्रेरितहोन अरु बुजरुक खे अच्छो लग्यो कि अपना मे से कुछ इन्सानहोन खे चुन्नु, मंनजे यहूदा जो बरसब्बास बोलस हइ, अरु सीलास, जो भैइहोन अरु बहीनहोन मे मुखीयो थो. अरु उनने पौलुस अरु बरनबास का साथ अन्ताकिया भेजनु. <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />उनने उनका हाथ यो लिख भेज्यो. अन्ताकिया अरु सीरिया अरु मंडलीहोन, र्‍हेनआला भैइहोन अरु बहीनहोन खे</para>
  <para style="pi" vid="ACT 15:23">जो गैरयहूदिहोन मे से हइ, प्रेरितहोन अरु बुजरुक भैइहोन बहीनहोन को नमस्कार. <verse eid="ACT 15:23" /><verse number="24" style="v" sid="ACT 15:24" />हमने सुन्यो हइ कि हम मे से कुछ ने वहा जैइखे तुम खे अपनी बातहोन से घबर्‍यै दियो. अरु तुमारा मन उलटी दियो हइ पन हम ने उनका आज्ञा नी दी थी. <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />येका लिये हम ने एक चित्त हुइ, ठीक समझ्यो कि चुन्या हुया इन्सानहोन खे अपना प्रिय बरनबास अरु पौलुस का साथ तुम्हारा पास भेजनु. <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />यो असो इन्सान हइ जिन्हे अपनो जान हमारा प्रभु यीशु मसीह का नाम का लिये जोखिम मे डाल्यो हइ. <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />येका लिये हम ने यहूदा अरु सीलास खे भेज्यो हइ, जो अपना मेडा से भी या बातहोन बोली दिये. <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />पवित्र आत्मा खे अरु हम खे ठीक जानी पड्यो कि या जरुरी बातहोन खे छोड तुम पर अरु बोझ नी डाल्ये. <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />कि तुम मूरतो पर बलि कर्या हुया से अरु खुन से अरु गल्यो घोट्यो हुया को मास से अरु व्यभिचार से दुर र्‍हेनु. येका से दुर र्‍हेनु ते तुम्हारो भलो हुये आगे शुभ.<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />फिर वे बिदा हुइखे अन्ताकिया पहुची खे अरु सभा खे जमा करी का वा चिट्ठी उनखे दी दी. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />वे चिट्ठी पडीखे वा उपदेश की बात से खुब खुश हुया. <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />यहूदा अरु सीलास भैइहोन अरु बहीनहोन खे उपदेश दिखे स्थिर कर्यो. <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />वे कुछ दिन र्‍हिखे भैइहोन अरु बहीन से शांती का साथ बिदा हुया कि अपना भेजनआला का पास जानु. <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />पन सीलास का वहा र्‍हेनो अच्छो लग्यो<verse eid="ACT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 15:35" />पौलुस अरु बरनबास अन्ताकिया मे र्‍हि गया. अरु दुसरा भोत सा दुन्या का साथ प्रभु को वचन को उपदेश करतो अरु सुसमाचार सुनातो र्‍हियो.<verse eid="ACT 15:35" /></para>
  <para style="s">पौलुस की दुसरी प्रचार यात्रा पौलुस अरु बरनबास मे मत भेद</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />कुछ दिन बाद पौलुस ने बरनबास से बोल्यो, जो जो नगरहोन मे हम ने प्रभु को वचन सुनायो थो, आओ फिर उनमे चलीखे अपना भैइहोन अरु बहीन खे देख्यो कि वे कसा हइ. <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />तब बरनबास ने यहून्ना को जो मरकुस बोल्या जास हइ, साथ लेन को बिचार कर्यो. <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />पन पौलुस ने ओखे जो पंफूलिया मे उनसे अलग हुइ गयो थो, अरु काम पर उनका साथ नी गयो, साथ लि जानो अच्छो नी समझ्यो. <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />आखरी असो विवाद उठौ कि वे एक दुसरा से अलग हूइ गया. अरु बरनबास, मरकुस खे लिखे डोंगा पर साइप्रस चली गयो. <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />पन पौलुस ने सीलास खे चुनी लियो, अरु भैइहोन अरु बहीन से परमेश्वर को अनुग्रह मे सौप्यो जैइखे वहा से चली गयो. <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />अरु उ मंडलीहोन खे स्थिर करता हुया सीरिया अरु किलिकिया से होता हुया नीकल्यो.<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">पौलुस को ती तीमुथियुस खे साथ लेनो</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />14 फिर उ दिरबे अरु लुस्त्रा मे भी गयो, वहा ती तीमुथियुस नाम को मसीह विश्वासी थो ओकी माय यहूदीया विश्वासी थी जबकी ओको बाप यूनानी थो. <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />उ लुस्त्रा अरु इकुनीयुम को भैइहोन अरु बहीन मे सुनाम थो. <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />पौलुस की इच्छा थी कि उ ओका साथ चल्ये. अरु जो यहूदी इन्सान उन जगाहोन मे थो उनकारण ओने ओको खतनो कर्यो, क्युकि वे सब जानता था, कि ओको बाप यूनानी थो. <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />अरु नगर नगर जाता हुया वे उन विधीहोन खे जो यरुशलेम का प्रेरितहोन अरु बुजरुकहोन ने ठैराइ थी मानना का लिये उनने पहुचाता जाता था. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />यो प्रकार मंडलीहोन विश्वास मे स्थिर होती गइ अरु गिनती मे हरदिन बडती गइ.<verse eid="ACT 16:5" /></para>
  <para style="s">त्रोआस मे पौलुस को दर्शन</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />वे फ्रुगिया अरु गलातिया प्रदेशहोन मे से हुइखे गया, क्युकि पवित्र आत्मा ने उनका आसिया मे वचन सुनाना से मना कर्यो. <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />उनने मूसिया का पास पहुचीखे बिथुनीया मे जान को चायो. पन यीशु का आत्मा ने उनका जान नी दियो. <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />आखीर मे मूसिया से हुइ, त्रोआस मे आया. <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />वहा पौलुस ने रात खे एक दर्शन देख्यो कि एक मकिदुनी इन्सान खडो हुयो, ओकासे प्रार्थना करीखे बोलस हइ, “पार उतरीखे मकिदुनी मे आ अरु हमारी मद्दत कर.” <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />ओको यो दर्शन देखता ही हमने जल्दी मकिदुनीया जानो चायो, यो समझीखे कि परमेश्वर ने हम खे उनको सुसमाचार सुनान का लिये बुलायो हइ.<verse eid="ACT 16:10" /></para>
  <para style="s">फिलिप्पी मे लिदिया को मन परी वर्तन</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />येका लिये त्रोआस से डोंगा खोलीखे हम सीधा सुमात्रा खे अरु दूसरा दिन नीयापुलीस मे आया. <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />वहा से हम फिलिप्पी मे पहुच्या जो मकिदुनी देस को मेख्य नगर मे कुछ दिन तक र्‍हिया. <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />अराम का दिन हम नगर का फाटक का बाहेर नद्दी का किनारा यो समझी खे गया कि वहा प्रार्थना करण कि जगा हुये. अरु बठीखे वे बयहोन से जो जमा हुइ थी, बात करण लग्या.<verse eid="ACT 16:13" /></para>
  <para style="s">इरोप कि पयली विश्वासी</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 16:14" />अरु लुदिया नाम थुआतीरा नगर का कबरा कपडा बेचनआली एक बय सुनी र्हि थी.अरु प्रभु ने ओको मन खोल्यो कि जब पौलुस कि बातहोन पर मन लगाये. <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />अरु जब लुदिया ने ओने अपना घराना सहित बपतिस्मा लियो, ते ओने प्रार्थना करी, “अगर तुम मेखे प्रभु कि विश्वासिनी समझस हइ, ते चलिखे मरा घर मे र्‍हे,” अरु वा हम खे मन्य खे लि गइ.<verse eid="ACT 16:15" /></para>
  <para style="s">पौलुस अरु सीलास बन्दीगृह मे</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />एक दिन हम जब प्रार्थना करण कि जगा जैइ र्‍हा था ते हम खे एक जवान दासी मीली, जोमे भविष्य बतान आली अशुध्द आत्मा थी अरु भविष्य बताना से अपना का लिये भोत कुछ कमय खे लाती थी. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />वा पौलुस का तरफ हमारा पीछे अयखे चिल्लान लगी, “यो इन्सान अच्छो परमेश्वर को सेवक हइ, जो हम खे उध्दार रस्ता कि कथा सुनास हइ.” <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />वा भोत दिन तक असो हि करती रही, पन पौलुस परेशान हुयो अरु पलटी खे वा आत्मा मी तोखे यीशु मसीह का नाम से आज्ञा देउस हइ, कि ओमे से नीकली जा अरु वा उ टेम मे नीकली गइ. <verse eid="ACT 16:18" /><verse number="19" style="v" sid="ACT 16:19" />जब वा पोर्यइ खे स्वामीहोन ने देख्यो कि हमारी कमइ कि आस जाती र्ही ते पौलुस अरु सीलास खे पकडी खे चौक मे प्रधानहोन का पास खीची खे ली गया. <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />अरु उनखे रोमन अधिकारीहोन का पास लि जैखे बोल्यो, ये दुन्या जो यहूदीया हइ, हमारा नगर मे बडी हलचल मची र्‍हा हइ. <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />अरु असी रीति रीवाज बतैइ र्‍हा हइ, जेखे अपनानो या माननो हम रोमीहोन का लिये ठिक नी. <verse eid="ACT 16:21" /><verse number="22" style="v" sid="ACT 16:22" />तब गर्दी का दुन्या उनका विरोध मे सीलास अरु पौलुस जमा हुइ, चड आया,</para>
  <para style="p" vid="ACT 16:22">तब शासकहोन ने उनका कपडा फाड्या, अरु उनका फटका मारन कि आज्ञा दी. <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />अरु भोत फटका लगैइखे उनने उनका बन्दीगृह मे डाली दियो अरु दरोगा खे आज्ञा दि कि उनका पक्की चैकीदारी मे रख. <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />उनसे असी आज्ञा मीलीखे उनका अंदर कि बन्दीगृह मे रख्यो अरु उनका पाय काटा मे ठोकी दियो.<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />आधी का नजीकपास पौलुस अरु सीलास प्रार्थना करता हुया परमेश्वर को भजन गय र्‍हा था. <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />कि येतना मे अचानक एक भूकम्प हुयो, ह्या तक कि बन्दिघर को पय्यो हली गयो, अरु जल्दी सब दरवाजा खुली गया. अरु सब का बन्धन खुल गया. <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />अरु जेलर जाग उठौ, अरु बन्दीगृह को दरवाजा खुल्या देखीखे समझ्यो कि कैदी भागी गया, आखीर ओने तलवार खीची खे अपना आप खे मारी डालनो चायो. <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />पर पौलुस ने उचो बोल से पुकारी खे बोल्यो, “अपना आप खे कुछ नुकसान मत पहुचा, क्युकि हम सब यही हइ.”<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />तब जेल को जेलर मशाल बनय अरु जल्दी से अंदर गयो अरु डर से कापता हुये पौलुस अरु सीलास जका सामने गिर्यो. <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />अरु उनखे बाहेर लीखे बोल्यो, हे सज्जनहोन को उध्दार मीलन का लिये प्रभु ने बोल्यो मी का करु?<verse eid="ACT 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31" />उनने बोल्यो, प्रभु यीशु पर विश्वास कर, ते तू अरु तरो घरानो उध्दार पाये. <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />अरु उनने ओखे अरु ओका सब घर का दुन्या, प्रभु को वचन सुनायो. <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />अरु रात खे उ टेम जोलर ने उनखे , ली जैइखे उनका पाय धोया, अरु ओने अपना सब दुन्या समेत जल्दी बपतिस्मा लियो. <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />अरु ओने उनखे अपना घर मे लै जैइखे उनका आगे खानो रख्यो अरु पुरा घराना समेत परमेश्वर पर विश्वास करी खे आनन्द कर्यो.<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />जब दिन हुयो तब रोमन अधिकारी का हात बुलाओ भेज्यो कि वे इन्सानहोन खेछोड दे.<verse eid="ACT 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 16:36" />जेलर ने या बात पौलुस से बोली, सुनइ, “शासकहोन ने तुमखे छोडी देन कि आज्ञा भेजी दि हइ, येका लिये नीकलिखे आनन्द से चली जा”<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />पर पौलुस ने अधिकारीहोन से बोल्यो, “उनने अधिकारी जो हम रोमी नागरीत्वआला दुन्या हइ, दोषी ठैराया बिना दुन्या का सामने मार्यो अरु बन्दीगृह मे डाल्यो, अरु अब का चुपचाप से नीकाली देस हइ? असो नी पर वे खुद अयखे हमखे बाहेर लि जाये.”<verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />सैनीकहोन अधिकारीहोन ने या बातहोन कि जानकारी रोमी अधिकारीहोन खे सुचना दि अरु जब उनने सुन्यो कि पौलुस अरु सीलास रोमन नागरीक हइ, ते वे डरी गया. <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />तब रोमन अधिकारीहोन ने अयखे नगर खेछोडी जानखे बोल्यो अरु बाहेर ली जैइखे प्रार्थना करी कि नगर से चली जा. <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />वे बन्दीगृह से नीकलीखे लुदिया का घर गया, अरु विश्वासी भैइहोन अरु बहीन से मीली खे उनखे दिलासा कि बात बोली अरु चली गया.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s">थिस्सलुनीखे का नगर मे</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />फिर वे पौलुस अरु सीलास अपुल्लोनीया हुइ थिस्सलुनीखे मे आया, जहा यहूदीयाहोन को एक आराधनालय थो. <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />अरु पौलुस अपना रीति का जसो आराधनालय मे गयो, अरु तीन अराम का दिन पवित्रशास्त्र से उनका साथ वाद विवाद कर्यो. <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />अरु उनको अर्थ सरल भाषा मे खोली-खोलीखे समझातो थो कि मसीह को दुख उठानो, अरु मर्या हुया मे से जी उठनो, जरुरी थो. अरु यो यीशु जोकी मी तुमखे कथा सुनउस हइ, कि मसीह हइ. <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />उनमे से केत्ता ने, अरु भक्त यूनानीहोन मे से भोतझन ने अरु भोत कुलीन बयहोन ने मानी लियो, अरु पौलुस अरु सीलास का साथ मीली गया.<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />पर यहूदीयाहोन ने गुस्सा से भरीखे बजारु दुन्या मे से कुछ आवारो इन्सानहोन खे अपना साथ मे लियो, अरु गर्दी लगैइखे शहर मे हल्लो मचान लग्या, अरु यासोन का घर पर चढाइ करी खे अरु कोशीस करण लग्या पौलुस अरु सीलास खे दुन्या का सामने लानो चायो. <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />अरु उनखे नी मीलीखे वे यो चिल्लाता हुया यासोन अरु कुछ विश्वासी भैइहोन का नगर का हाकिमहोन का सामने खीची खे लाये अरु बोलन लग्या ये दुन्या जेने जगत का मुसीबत पइदा करी दि हइ, ह्या भी आया हइ. <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />अरु यासोन ने उनने अपना घर मे ठैरायो हइ, अरु कैसर राजा की आज्ञाहोन को विरोध करस हइ. <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />जब गर्दी अरु नगर, शासकहोन ने या बातहोन सुनी खे दुन्याहोन खे भड का यो ते वे परेशान हुइ गया. <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />अरु उनने यासोन अरु बाकी दुन्याहोन खे जमानत पर छोडी दियो.<verse eid="ACT 17:9" /></para>
  <para style="s">बिरीया नगर मे भी यहूदीहोन को विरोध्द</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />विश्वासी भैइहोन ने जल्दी रात हि रात पौलुस अरु सीलास को बिरीया मे भेजी दियो का अरु वे वहा पहुची कि यहूदीयाहोन खे आराधनालय मे गया. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />ये दुन्या तो थिस्सलुनीखे का दुन्या से जादा अच्छा था अरु उनने बडी लालसा से वचन ग्रहन कर्यो, अरु हरदिन शास्त्र को पड्यैइ करता देख्यो कि जो पौलुस कि पुरी बात सही हइ कि नी. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />यको परीनाम स्वरुप भोत सा यहूदीया अरु महत्व पुर्ण गैरयहूदिहोन मे से देख्यो थो भोतझन ने, अरु यूनानी कुलीन बयहोन मे से अरु इन्सानहोन मे से भोतझन ने विश्वास कर्यो. <verse eid="ACT 17:12" /><verse number="13" style="v" sid="ACT 17:13" />पन जब थिस्सलुनीखे का यहूदीया जानी गया कि पौलुस बिरीया मे भी परमेश्वर को वचन सुनास हइ, ते वहा भी अय खे दुन्या खे भडकानो अरु दंगा करवाना मे लग्या. <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />तब विश्वासी भैइहोन ने जल्दी पौलुस कए बिदा कर्यो कि समुद्र का किनार चली जा. पन सीलास अरु तीमुथियुस व्हा र्‍हि गो <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />पौलुस का विश्वासी भैइहोन ने एथेस तक पोचय दियो, अरु सीलास अरु ती तीमुथियुस का लिये यो आज्ञा लिका बिदा हुया कि मरा पास जल्दी भेज्यो.<verse eid="ACT 17:15" /></para>
  <para style="s">अथेने नगर मे पौलुस को धर्म प्रचार</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />जब पौलुस एथेस अरु सीलास अरु तीमुथियुस का लिये इंतजार करी रा था, ते उ भोत परेशान थो जब ओने देख्यो कि शहर मे मूर्तिहोन से भर्यो देखी खे ओकी आत्मा जल उठ्यो. <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />आखरी उ यहूदीया आराधनालय मे यहूदीयाहोन अरु गैरयहूदिहोन जो परमेश्वर कि उपासना करता था, अरु चौक मे जो दुन्या मीलता था उनसे हर दिन वाद विवाद कर्या करतो थो. <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />तब इपिकुरी अरु स्तोइकी मास्‍तर मे से कुछ ओकासे तर्क करण लग्या, अरु कोय ने बोल्यो, यो काय बलवादी का बोलनो चाहस हइ?</para>
  <para style="p" vid="ACT 17:18">पन दुसरा ने बोल्यो का उ दुसरा देवताहोन को प्रचारक मालुम पडस हइ, क्युकि उ यीशु का तरफ पुनरुत्थान को सुसमाचार सुनानो थो. <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />तब वे पौलुस अपना अरियुपगुस नगर का सभा मे लिखे गया अरु पुछ्यो, हम जानी सकस हइ नइ शिक्षा जो बतैइ र्‍हा हइ, का हइ? <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />क्युकि तू अनोखी बातहोन हम खे सुनास हइ, येकालिये हम जाननो चाहस हइ कि इनको मतलब का हइ? <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />येका लिये कि सब एथेस वासी अरु परदेसी जो वहा र्‍हेता था नइ-नइ बातहोन बोलन अरु सुनना का सिवाय अरु कोय काम मे टेम मे नी बिताथा था.<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />तब पौलुस नगर कि सभा का अरियुपगुस का बीच मे खडो हुइ खे बोल्यो का, हे एथेस का दुन्याहोन, मे देखुस हइ कि तुम हर बात मे देवताहोन खे बडा धार्मीक माननआला हुये. <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />क्युकि मी नगर मे फिरते हुये तुम्हारी आराधना करण कि जगा खे देखी र्‍हो थो, ते एक वेदी भी पाइ, जेका पर लिख्यो थो, अनजाना परमेश्वर का लिये येका लिये जेको तुम बिना जाने परमेश्वर कि आराधना करस हइ, <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" />जो परमेश्वर ने जगत अरु ओकी सब चिजहोन खे बनायो, उ स्वर्ग अरु धरती को स्वामी हुइ खे हाथ कि बनाया हुया मन्‍दिर मे नी र्‍हे. <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />नी कोय चिज की जरुरत करण इन्सानहोन का हाथहोन कि सेवा लेस हइ, क्युकि उ तो आप ही सब के जिवन अरु सास अरु सब कुछ देस हइ. <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />ओने एक ही इन्सान का वजेसे पुरा इन्सानहोन कि नीर्मीती करी सारी धरती उनखे र्‍हेन का लिये बनइ. अरु ओने दुन्या को टेम ठैर्यो खे दियो अरु उनका जगाहोन खे जहा वे र्‍हेस हइ ओकि सिमाहोन बाधी हइ. <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />यो येका लिये कर्यो कि दुन्या परमेश्वर खे ढुड्ये, अरु हुइ सकस हइ वे ओका तक पहुची खे पैयले लिखे फिर भी उ कोय से दुर नी हइ. <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />क्युकि हम ओमे जीन्दा र्‍हेस, अरु चलता फिरता, अरु स्थिर र्‍हेस हइ अस्तित्व हइ यो प्रकार खुद तुम्हारा कुछ कविहोन ने भी बोल्यो हइ, हम तो ओका कुल भी हइ.<verse eid="ACT 17:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 17:29" />आखीर परमेश्वर को कुल हुइ खे हम खे यो समझानो अच्छो नी कि परमेश्वर का सोन्नो या चादी या पत्थर का जसा हइ, जो इन्सान कि कारागीर अरु कल्पना से बनायो गयो हइ. <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />येका लिये जब दुन्या परमेश्वर खे नी समझ सक्ये कि टेम मे होन पर ध्यान नी दिये, पर अब हर जगा सब इन्सानहोन खे मन फिरान की आज्ञा देस हइ. <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />क्युकि परमेश्वर ने एक दिन नीश्चित कर्यो हइ अपनो नीयुक्त कर्या गया एक इन्सान का वजेसे धार्मीकता से जगत को न्याय कर्ये, जेखे ओने ठैरायो हइ अरु ओखे मर्या हुया मे से जिलयखे या बात सब पर प्रमाणित करी दी हइ.<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />मर्या हुया खे पुनरुत्थान कि बात सुन्ये का खे त्ता तो मजाक मजाक उखान लग्या, पन अरु पर दुसरा दुन्या से. “बोल्यो कि या बात फिर से सुन्नु चाहस हइ.” <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />येका पर पौलुस उनका बीच मे से चली गयो. <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />पन कुछ इन्सान ओका साथ मीलि गया, अरु विश्वास कर्यो जेमे दियुनुसियुस जो अरियुपगुस को मुखियो थो, अरु दामरीस नाम की एक बय थी, अरु उनका साथ कुछ दुन्या था.<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s">कुरिन्थुस मे पौलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />येका बाद पौलुस एथेस खे छोडी खे कुरिन्थुस मे आयो. <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />अरु वहा अक्विला नाम को एक यहूदीया मील्यो, जेको जन्म पुन्तुस मे हुयो थो. अरु अपनी लुगइ प्रिस्किल्ला का साथ इटली से हाल ही मे आयो थो, क्युकि क्लौदियुस ने सब यहूदीयाहोन खे रोम से नीकली जान की आज्ञा दी थी, येका लिये उ उनका ह्या गयो. <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />अरु एक ही साथ र्‍हेतो थो ओको अरु उनको एक ही व्यापर थो. <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />अरु उ हर येक आराम का दिन आराधनालय मे वाद विवाद करी खे यहूदीयाहोन अरु यूनानीहोन खे भी समझातो थो.<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />जब सीलास अरु तीमुथियुस मकिदुनी से आया, ते पौलुस वचन सुनान कि धुन मे लगी खे यहूदीयाहोन खे गवइ देतो थो कि यीशु हि मसीह हइ. <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />पन जब वे विरोध अरु नीन्दा करण लग्या, ते ओने अपना कपडा झटकी खे ओकासे बोल्यो, “तुम्हारो खुन तुम्हारा माथा पर र्‍हिये? मी नीर्दोष हइ, तुम्हारा मरन को कारन तुम ही हइ अरु अब से मी गैरयहूदिहोन का पास जायु.” <verse eid="ACT 18:6" /><verse number="7" style="v" sid="ACT 18:7" />अरु वहा से चली खे वहा तीतुस यूस्तुस नाम परमेश्वर को एक भक्त का घर मे आया, जोको घर आराधनालय से लग्यो हुयो थो. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />तब आराधनालय को सरदार क्रिस्पुस ने अपना पुरा घराना समेत प्रभु पर विश्वास कर्यो. अरु भोत से कुरिन्थवासी ने संदेश सुनी खे विश्वास कर्यो अरु बपतिस्मा लियो.<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />अरु प्रभु ने रात खे दर्शन का वजेसे पौलुस से बोल्यो, “मत डर, क्युकी बोल्ये जो अरु चुप मत र्‍हेनु. <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />क्युकि मी तरा साथ हइ, अरु कोय तरा पर चडाइ करी खे तरो नुकसान नी कर्ये. क्युकि यो नगर मे मरा भोत सा दुन्या हइ.” <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />येका लिये उ उनमे परमेश्वर को वचन सिखाता हुया देड साल तक र्‍हियो.<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />जब गल्लिहोन अखाया देश को राज्यपाल थो ते यहूदीया दुन्या एक मत करी खे पौलुस पर चडी आया, अरु ओखे न्याय आसन का सामने लायो, अरु बोलन लग्या, <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />“यो इन्सान दुन्या खे समझास हइ, कि परमेश्वर कि उपासना असा रीति से करणु, जो हमारा व्यवस्था को विपरीत हइ.”<verse eid="ACT 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14" />जब पौलुस बोलना पर थो, ते गल्लिहोन ने यहूदीयाहोन से बोल्यो, “हे यहूदीयाहोन अगर यो कुछ अन्याय या दुष्टता कि बात होती ते अच्छो थो कि मी तुम्हारी सुनुस. <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />पन अगर यो वाद विवाद शब्दहोन, अरु नामहोन अरु तुम्हारी खुद की व्यवस्था का बारे ते तुम ही जाननु. क्युकि मी या बातहोन को न्यायी बन्नो नी चाहुस,” <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />अरु ओने उनखे न्याय आसन का सामने से नीकाल दियो. <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />तब सब दुन्या ने आराधनालय का सरदार खे सोस्‍थिनेस को न्याय आसन का सामने मार्यो, पन गल्लिहोन ने या बातहोन खे कुछ भी ध्यान नी दियो.<verse eid="ACT 18:17" /></para>
  <para style="s">अन्ताकिया खे लौटनु</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />आखरी पौलुस भोत दिन तक कुरीन्तु र्‍हियो, फिर भैइहोन से बिदा लिखे डोंगा से सीरिया चल पड्या तब यीशु का साथ प्रिस्किल्ला अरु अक्विला थी पौलुस ने किंख्रिया मे येका लिये माथो मुडायो, क्युकि ओने मन्नत मागी थी. <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />अरु ओने इफिसुस मे पोचिखे उनका वहा छोड्यो, अरु खुद हि आराधनालय मे जैखे यहूदीयाहोन से वाद विवाद करण लग्यो. <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />जब वहा का दुन्या ने ओकासे प्रार्थना करी खे हमारा साथ अरु कुछ दिन र्‍हियो, ते ओने स्वीकार नी कर्यो. <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />पन यो बोलि खे उनसे बिदा हुयो, “अगर परमेश्वर चाह्ये ते मी तुम्हारा पास फिर आयु” तब इफिसुस से डोंगो खो लिखे चली दियो.<verse eid="ACT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22" />तब कैसरिया मे उतरी खे यरुशलेम खे गयो अरु मंडली खे नमस्कार करी खे अन्ताकिया मे आयो. <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />फिर कुछ दिन र्‍हि खे वहा से चली गयो, कुछ टेम मे बितै खे गलातिया क्षेत्र अरु फ्रुगिया मे सब चेलाहोन को विश्वास मे स्थिर करतो फिर्यो.<verse eid="ACT 18:23" /></para>
  <para style="s">अपुल्लोस नामको विद्वान इन्सान</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />अपुल्लोस नामको एक यहूदीया जोको जन्म सिकन्दरिया मे हुयो थो, जो विद्वान इन्सान थो अरु शास्त्रहोन को अच्छी तरह से जानतो थो इफिसुस मे आयो. <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />ओने प्रभु को मार्ग कि शिक्षा पाइ थी, अरु पुरा आत्मा से यीशु का बारे मे अच्छो अच्छो सुनातो अरु सिखातो थो, पन उ फक्त यहून्ना को बपतिस्मा कि बात जानतो थो. <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />उ आराधनालय मे नीडर हुइ खे बडबडान लग्या, पर प्रिस्किल्ला अरु अक्विला उसकी बातहोन सुनी खे ओखे अपना ह्या लि गयो अरु परमेश्वर को रस्ता ओखे अरु भी ठिक रुप से बतायो. <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />येका बाद अपुल्लोस मे आयो, अखाया का पास जान को फैसलो कर्यो, येका लिये इफिसुस का विश्वासीहोन खे लिखी खे उनकी मद्दत करी, जब उ आयो, ते उ वे दुन्या का लिये एक बडो मददतगार थो, जो परमेश्वर कि कृपा से विश्वास करण आला था. <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />अपुल्लोस ने अपनी शक्ति अरु कौशल का साथ यहूदीयाहोन को सार्वजनीक रुप से कर्यो पवित्रशास्त्र से प्रमाण दि दिखे कि यीशु हि मसीह हइ.<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s">इफिसुस मे पौलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />जब अपुल्लोस कुरिन्थुस मे थो, ते पौलुस उपर का पुरा देश से हुइ खे इफिसुस मे आयो अरु वहा कुछ चेला मील्या. <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />ओने उनसे पुच्छो, तुम ने विश्वास करता टेम मे पवित्र आत्मा पायो उनने ओकासे बोल्यो,</para>
  <para style="p" vid="ACT 19:2">“हमने तो पवित्र आत्मा कि बातचित भी नी सुनी.”<verse eid="ACT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3" />ओने उनसे बोल्यो “ते फिर तुम ने कोको बपतिस्मा लियो?”</para>
  <para style="p" vid="ACT 19:3">उनने बोल्यो, “यहून्ना को बपतिस्मा,”<verse eid="ACT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4" />पौलुस ने बोल्यो “यहून्ना ने यो पाप से मन फिराव को बपतिस्मा दियो, कि जो मरा बाद आनआलो हइ, ओ पर मंनजे यीशु पर विश्वास करणु.”<verse eid="ACT 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5" />यो सुनीखे उनने प्रभु यीशु को नाम को बपतिस्मा लियो. <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />अरु जब पौलुस ने उन पर हाथ रख्यो, ते उन पर पवित्र आत्मा उतर्यो, अरु वे अलग अलग भाषा बोलन अरु भविष्यवाणी करण लग्या. <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />ये सब बारा इन्सानहोन था.<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />अरु पौलुस यहूदीया आराधनालय मे जैखे तीन महीना तक नीडर हुइ खे बोलतो र्‍हियो, अरु परमेश्वर का राज्य का बारे मे वाद विवाद करतो अरु उनने समझातो र्‍हियो. <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />पन जब कुछ दुन्या ने कठोर हुइ खे ओकी नी मानी क्युकी दुन्या का सामने या रस्ता को बुरो बोलन लग्या, ते ओने ओखे छोडी खे चेलाहोन खे अलग करी लियो, अरु हरदिन तुरन्नुस कि यो कुल मे वाद विवाद कर्या करतो थो. <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />दो साल तक यो होतो र्‍हियो, ह्या तक कि आसिया का प्रात मे र्‍हेनआला, यहूदीया का यूनानी सब ने प्रभु को वचन सुनी लियो.<verse eid="ACT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />अरु परमेश्वर पौलुस का हाथ से सामर्थ का अद्भुत काम दिखातो थो. <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />ह्या तक कि दस्ती अरु डुप्पट्टो ओका आंग से चिपकी खे बीमारहोन पर डालता था, अरु उनकी बीमारीहोन दुर हुइ जाती थी. अरु बुरीआत्‍माहोन उनमे से नीकली जाया करती थी. <verse eid="ACT 19:12" /><verse number="13" style="v" sid="ACT 19:13" />पन कुछ यहूदीया जो बुरीआत्मा नीकाल न आला फिरता था, यो करण लग्या कि जेका मे बुरीआत्‍मा हुये “उन पर प्रभु यीशु नाम को प्रचार पौलुस करस हइ. कामी तुम खे ओकी कसम देउस हइ.” <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />अरु सिक्का ओका नाम को एक यहूदीया प्रधान याजक को सात बेटा था, वे यइ था.<verse eid="ACT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 19:15" />पर बुरीआत्‍मा ने जवाब दियो, “यीशु खे मी जानुस हइ, अरु पौलुस खे भी पहचानस हइ, पर तुम कोन आय?”<verse eid="ACT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 19:16" />अरु उ इन्सान ने जोमे बुरीआत्‍मा थी. उन पर झपटी खे अरु उनका मे लि खे उन पर असो उपद्रव कर्यो, कि वे नंगा अरु घायल हुइ खे उ घर से नीकली भाग्या. <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />अरु या बात इफिसुस खे र्‍हेनआला यहूदीया अरु यूनानी भी सब जानी गया, अरु उन सब पर डर छै गयो. अरु प्रभु यीशु, का नाम की बडाइ हुइ. <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />अरु जेने विश्वास कर्यो थो, उनमे से भोतजन ने अय खे अपना-अपना बुरा काम हुइखे मानी लियो अरु प्रगट कर्यो. <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />अरु जादु टोना करणआला होन मे से भोतजन ने अपनी अपनी पोथिहोन जमा करी खे सब का सामने जलै दी. अरु जब उनको दाम जोड्यो गयो, जो पचास हजार चादी, का सिक्का होन का बराबर नीकल्यो. <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />यो प्रकार प्रभु को वचन बल पूर्वक फैलतो गयो अरु मजबुत होतो गयो.<verse eid="ACT 19:20" /></para>
  <para style="s">इफिसुस मे दंगो</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />जब या बातहोन हुइ चुकी ते पौलुस ने आत्मा मे ठान्यो कि मकिदुनी अरु अखाया से हुइ खे यरुशलेम का जायु, अरु किधर, “वहा जान का बाद मेखे रोम खे भी देखनु जरुरी हइ.” <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />येका लिये अपनी सेवा करणआला होन मे से तीमुथियुस अरु इरास्तुस खे मकिदुनी मे भेजी खे खुद कुछ दिन आसिया मे र्‍हि गयो.<verse eid="ACT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />उ टेम इफियुस मे प्रभु को रस्ता का बारे मे बडो हंगामो हुयो. <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />उ दिमेत्रियुस नाम को एक सोनार थो जो अरतिमीस चादी को काम करतो थो, अरु कारीगर को भोत फायदो होतो थो. <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />ओने उनका असी चिजहोन का कारीगरहोन खे जमा करीखे बोल्यो, “हे इन्सानहोन खे तुम जानस हइ कि यो काम से खे त्तो धन मीलस हइ. <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />अरु तुम देखस अरु सुनस हइ कि फक्त इफिसुस ही मे नी, क्युकी नजीकपास पुरा आसिया मे यो बोलि बोलिखे पौलुस ने भोत दुन्या खे समझायो अरु भरमायो भी हइ, कि जो हाथ से बनायो गया देवहोन हइ इश्वर नी. <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />अरु अब फक्त योही एक बात को डर नी कि हमारा यो धन्धा कि प्रतीष्ठा जाती र्‍हिये. क्युकी ह्या कि महान देवी अरतिमीस की मन्‍दिर तुच्छ समझे जाये अरु जेखे पुरो आसिया अरु जगत पुजस हइ ओको सम्मान घटतो र्‍हिये.”<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />जब गर्दी ने सुनीखे घुस्सा से भरी गया अरु चिल्य खे बोलन लग्यो, “इफिसिहोन की अरतिमीस की देवी, महान हइ.” <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />अरु पुरा नगर मे बडो हगामो मची गयो अरु दुन्या ने गयुस अरु अरिस्तर्खुस खे मकिदुनी, जो पौलुस का संग यात्री था, पकडी लियो, अरु एक साथ हुइ खे रंगइस्कुल मे दौडी गया. <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />जब पौलुस ने दुन्या का पास अंदर जानो चायो ते चेलाहोन ने ओखे जान नी दियो. <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />आसिया का शासकहोन मे से भी ओको कोय दोस्तहोन ने ओका पास संदेशहोन भेज्यो अरु प्रार्थना करी खे कि रगिस कुल मे जै खे जोखिम नी उठानु. <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />वहा कोय कुछ चिल्लातो थो, अरु कोय कुछ. क्युकि सभा मे बडी गडबडी हुइ र्‍हि थी, अरु भोत सा दुन्या तो यो जानता भी नी था कि वे को, लिये जमा हुया हइ. <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />तब उनने सिकन्दर खे जोख यहूदीयाहोन ने खडो कर्यो थो, गर्दी मे से आगे बडायो, अरु सिकन्दर हाथ से इशारो करी खे दुन्याहोन का सामने जवाब देनो चाहतो थो. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />पन जब उनने जानी लियो कि उ यहूदीया हइ, ते सब एक शब्द से कोय दो घंटा तक चिल्लाते र्‍हियो, इफिसिहोन कि अरतिमीस देवी, महान हइ.<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />हे इफिसिहोन का दुन्या पुरा जगत मे एक असो इन्सान जो नी जानतो थो कि अरु स्वर्ग से अरतिमीस, “गड्यो हुयो पत्थर हइ <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />आखरी जब कि या बातहोन को खण्डन ही नी हुइ सक्येका ते अच्छो हइ, कि तुम शान्त र्‍हिये. अरु बीना सोचे बिचार कुछ नी करणु. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />क्युकि तुम इन इन्सानहोन का लाया हइ, जो न मन्‍दिर खे लुटनआला हइ, अरु न हमारी देवी का नीन्दक हइ. <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />अगर दिमेत्रियुस अरु ओका साथी कारीगरहोन का कोय से वाद विवाद हुये ते कचेरी खुली हइ, अरु शासक भी हइ. वे एक दुसरा पर दोष लगाये. <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />पन अगर तुम कोय अरु बात का बारे मे कुछ पूछनो चाहस हइ, ते कानुन की सभा मे फैसलो किये जाये. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />क्युकि आज का बलवा कारण हम पर दोष लगाया जान, डर से, येका लिये कि येको कोय करण नी, आखरी हम या गर्दी खे जमा होन को कोय उत्तर नी दि सक्ये.” <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />अरु यो बोलि खे ओने सभा खे बिदा कर्यो.<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s">मकिदुनी मे जान खे नीकल्यो</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />जब दंगो थमी गयो ते पौलुस ने विश्वासीहोन खे बुलैइ खे होसलो, बडायो अरु बिदा हुइ खे मकिदुनी का तरफ चली दियो. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />उ पुरा प्रदेश मे से हुइ खे अरु चेलाहोन खे भोत आनन्द करी खे उ अखाया मे आयो. <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />जब तीन महीना र्‍हि खे उ वहा से डोंगा पर सीरिया का तरफ जाना पर थो, ते यहूदीया दुन्या ओकी विरोध मे शाजिस लगैइ र्‍हा था, येका लिये ओने ठानी लियो कि मकिदुनी हुइ खे लौटी जायु. <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />बिरीया को पुरुर्स इन्सान को बेटो सोपत्रुस अरु थिस्सलुनीखे किहोन मे से अरिस्तर्खुस अरु सिकुन्दुस अरु दिरबे को गयुस, अरु आसिया प्रात को तुखिकुस अरु त्रुफिमुस आसिया तक तीमुथियुस ओका साथ हुइ गा. <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />पर वे आगे जैखे त्रोआस मे हमारी प्रतीक्षा करता र्‍हिये. <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />अरु अखमीरी रोटी का दिन बाद फिलिप्पी से डोगा पर चड खे पाच दिन मे त्रोआस मे उनका पास पहुच्या, अरु सात दिन तक व्हापर र्‍हिया.<verse eid="ACT 20:6" /></para>
  <para style="s">त्रौआस मे पौलुस को आश्चर्य काम</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />हप्ता का पैयला दिन जब हम रोटी तोडन का लिये जमा हुया, तो पौलुस ने जो दुसरा दिन चली जाना पर थो, उनसे बातहोन करी खे अरु आधी रात तक शिक्षा देता र्‍हियो. <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />जो उपर की खोली मे हम जमा था, ओमे भोत दिवो जली दिया र्‍हा था. <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />यूतुखुस अरु नाम को खिडकी पर बैठ्यो हुयो गैरी नीद से झुकी र्‍हो थो, अरु जब पौलुस देर तक बातहोन करतो र्‍हियो ते उ नीद का झकोलामे तीसरा माली पर से गिरी पड्यो, अरु मर्यो हुयो उठी गयो. <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />पन पौलुस उतरी खे ओकासे लिपटी गयो, अरु गलो लगी खे बोल्यो, “घबरानु नी. क्युकि ओको जान ओमे हइ.”<verse eid="ACT 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 20:11" />अरु उपर जैखे रोटी तोडी अरु खैइ खे येत्ती देर तक उनसे बातहोन करतो र्‍हियो कि भोर हुइ गइ. फिर उ चली गयो. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />अरु वे उ जवान खे जिन्दो ली आयो, अरु भोत शांती पाइ.<verse eid="ACT 20:12" /></para>
  <para style="s">त्रोआस से मीलेतुस को आनो जानो</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />हम पैयले से डोंगा पर चडी खे अस्सुस को यो बिचार से आगे गया, कि वहा से हम पौलुस खे चड्यै लिये क्युकि ओने यो येकालिए ठैरायो थो, कि खुद ही पइदल जानआला थो. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />जब उ अस्सुस मे हम खे मील्यो ते हम ओखे चड्यै, मीतुलेने मे आया. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />अरु वहा से डोंगा खोली खे हम दूसरा दिन खियुस का सामने पहुच्या, अरु दुसरा दिन सामेस मे जा पहुच्या, फिर दूसरा दिन मीलेतुस मे आया. <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />क्युकि पौलुस ने इफिसुस का पास से हुइ खे जाना की ठान्यो थो, कि कही असो नी हुये कि ओखे आसिया मे देर लग्ये. क्युकि उ जल्दी मे थो, कि अगर हुइ सक्येका ते उ पिन्तेकुस्त का दिन यरुशलेम मे र्‍हियो.<verse eid="ACT 20:16" /></para>
  <para style="s">इफिसुस का बुजुरुखहोन खे पौलुस को उपदेश</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />अरु ओने मीलेतुस से इफिसुस मे बुलाओ भेज्यो, अरु मंडली का बुजरुक खे बुलायो. <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />जब वे ओका पास आया, ते उनसे बोल्यो,</para>
  <para style="p" vid="ACT 20:18">तुम जानस हइ, कि पैयला ही दिन से जब मी आसिया मे पहुच्यो, मी हर टेम मे तुम्हारा साथ कोनता प्रकार र्‍हियो. <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />यानी बडी दीनता से, अरु आसू बह्ये-बह्ये खे अरु उ परीक्षाहोन मे जो यहूदीयाहोन कि साजिस करण जो मरा पर अय पडी. मी प्रभु की सेवा करतो ही र्‍हियो. <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />अरु जो-जो बातहोन तुम्हारा लोभ की थी, उनखे बतानु अरु दुन्या का सामने अरु घर-घर सिखाना से कभी नी झिझकनु. <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />क्युकी यहूदीयाहोन अरु यूनानीहोन खे चेतावनी देतो र्‍हियो कि परमेश्‍वर का तरफ मन फिराव, अरु हमारो प्रभु यीशु मसीह पर विश्वास करणु.<verse eid="ACT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 20:22" />अरु अब, मी आत्मा मे बध्यो हुयो यरुशलेम का जउस हइ, अरु नी जानतो, कि वहा मरा पर का बीत्ये. <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />फक्त यो कि पवित्र आत्मा हर नगर मे गवाही दि-दि खे मरासे बोलस हइ कि बन्धन अरु क्लेश तरा लिये तैयार हइ. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />पन मी अपनो जा खे कुछ नी समझु कि ओखे प्रिय जानू, क्युकी यो कि मी अपनी दौड, अरु वा सेवा खे पूरी कर्यु, जो मेने परमेश्‍वर का अनुग्रह को सुसमाचार पर गवाही देन का लिये प्रभु यीशु से पायो हइ.<verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />अरु अब मी जानुस हइ, कि तुम सब जेमे मी परमेश्‍व का राज्य को प्रचार करतो फिर्यो, मरो मुडो फिर नी देख्ये. <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />येका लिए मी आज का दिन तुम से गवाही दि खे बोलुस हइ, कि मी सब का खुन से नीर्दोष हइ. <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />क्युकि मी परमेश्वर की पुरी योझना खे तुम्ह खे पूरी रीति से बताना से नी झिझक्यो. <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />येका लिए अपनी अरु पूरा झुण्ड की देख-रेख करणु. जेमे पवित्र आत्मा ने तुम्ह खे मुखियो ठैराया हइ कि तुम परमेश्वर की मंडली की रखवाली करणु, जेका से ओने अपना खुन से मोल लियो हइ. <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />मी जानुस हइ, कि मरा जाना का बाद फाडनआला मेढाहोन तुम मे अयखे जो झुण्ड खे नी छोड्ये. <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />तुम्हारा ही बीच मे से भी असा-असा इन्सान उठ्येका जो चेलाहोन के अपना पीछे खीची लेन कि टेडी-मेडी बातहोन बोल्ये. <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />येका लिए जागते र्‍हेनु, अरु याद करणु कि मेने तीन साल तक रात दिन आसू बोह्ये-बोह्ये खे हर एक खे सिखायो.<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />“अरु अब मी तुम्ह खे परमेश्‍वर के अरु ओका अनुग्रह को सोपी देस हइ तुम उन्नती करी सकस हइ अरु तुम परमेश्वर कि दुन्या का साथ पुरी आशिष दिल्ये सकस हइ. <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />मेने कोय खे चादी, सोन्ना या कपडा को लालुच नी कर्यो.<note caller="+" style="x"><char style="xo" closed="false">20:33 </char><char style="xt" closed="false"><ref loc="1SA 12:3">1 शमुवेल 12:3</ref></char></note> <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />तुम खुद ही जानस हइ कि यइ हाथहोन ने मरी अरु मरा साथिहोन की जरुरतहोन पूरी करी. <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />मेने तुम्ह खे सब कुछ करी खे दिखायो, कि या रीति से मेहनत करता हुये नीर्बलहोन खे सम्भालनो, अरु प्रभु यीशु की बातहोन याद रखन जरुरी हइ, कि ओने खुद ही बोल्यो हइ लेना से देनो अच्छो हइ.”<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />यो बोलि ओने घुटना टेक्या अरु उन सब का साथ प्रार्थना करी. <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />तब वे सब भोत अरु पौलुस का गल्लो मिलीखे ओखे चूमन लग्या. <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />वे विशेष करीस या बात को शोक करता था, जो ओने बोली थी कि तुम मरो मुडो फिर नी देख्ये का अरु उनने ओखे डोंगा तक पहुचायो.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s">पौलुस यरुशलेम खे जानो</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />जब हमने उनसे अलग हुइ खे समुद्री जत्रा सुरवात करी खे ते सीधी रस्ता से कोस मे आया, अरु दूसरा दिन रुदुस मे, अरु व्हा से पतरा मे. <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />अरु एक डोंगा मे फीनीके को जातो हुयो मील्यो, अरु हमने ओ पर चडी खे ओखे खोल दियो. <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />जब साइप्रस दिखाइ दियो, ते हमने ओखे डाखोर्यो हाथ छोड्यो, अरु सीरिया खे चलीखे सूर मे उतर्या. क्युकि वहा डोंगा को बोझ उतारनु थो. <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />अरु चेलाहोन खे पयई खे हम वहा सात दिन तक र्‍हियो. उनने आत्मा खे सिखायो पौलुस से बोल्यो कि यरुशलेम मे पाय नी रखनु. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />जब वे दिन पूरा हुइ गया, ते हम वहा से चल दिया. अरु सब बयहोन अरु बच्चाहोन समेत हमखे नगर का बाहेर तक पोचाया अरु हमने किनारा पर घुटना टेकी खे प्रार्थना करी. <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />तब एक दूसरा से बिदा हुइखे, हम तो डोंगा पर चड्या, अरु वे अपना-अपना घर लौटी गया.<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />जब हम सूर से पाणी जत्रा पूरी करीखे पतुलिमयिस मे पहुच्या, अरु भैइ होन खे नमस्कार करीखे उनका साथ एक दिन र्‍हिया. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />दुसरा दिन हम वहा से चलीखे कैसरिया मे आया, अरु फिलिप्पुस सुसमाचार प्रचारक का घर मे जो सातजन मे से एक थो, जैइ खे ओका ह्या ठैइर्या. <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />ओकी चार कुव्वारी बेटीहोन थी. जो भविष्यवाणी करती थी. <verse eid="ACT 21:9" /><verse number="10" style="v" sid="ACT 21:10" />जब हम वहा भोत दिन र्‍हि चुक्या, ते अगबुस नामको एक भविष्यव्दक्ता यहूदीया से आयो. <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />ओने हमारा पास अयखे पौलुस को कमरबन्द लियो, अरु अपना हाथ पाय बांधीखे बोल्यो, “पवित्र आत्मा यो बोलस हइ, कि जो इन्सान को यो कमरबन्द हइ, ओखे यरुशलेम मे यहूदी या रीति से बाध्ये, अरु गैरयहूदीहोन का हाथ मे सोपि दिये.”<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />जब हमने या बातहोन सुनी, ते हम अरु वहा का दुन्याहोन ने ओका से प्रार्थना करी कि यरुशलेम खे नी जानु. <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />पन पौलुस ने जवाब दियो, “तुम का करस हइ, कि रोइ-रोइखे मरो मन तोडस हइ? मी तो प्रभु यीशु का नाम का लिये यरुशलेम मे नी फक्त बाध्यो जान ही का लिये क्युकी मरन का लिये भी तैयार हइ.”<verse eid="ACT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 21:14" />जब ओने नी मान्यो ते हम यो बोलीखे चुप हुइ गया, “प्रभु की इच्छा पूरी हुये.”<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />उ दिनहोन का बाद हमने तैयारी करी अरु यरुशलेम खे चली दिया. <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />कैसरिया का भी कुछ चेला हमारा साथ अयगा, अरु मनासोन नामको साइप्रस का एक पुरानो चेला का साथ ली आया, कि हम ओका ह्या टिक्ये.<verse eid="ACT 21:16" /></para>
  <para style="s">पौलुस याकूब खे मीलस</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />जब हम यरुशलेम मे पहुच्या, ते भैइ बडि खुशी का साथ हम से मील्यो. <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />दूसरा दिन पौलुस हमखे लीखे याकूब का नजीक गयो, झा सब बापदादा एक जगा था. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />तब ओने उन्हसे नमस्कार करीखे जो-जो काम परमेश्वर ने ओकी सेवा का द्वारा गैरयहूदीहोन मे कर्या थो, एक-एक करीखे सब बतायो.<verse eid="ACT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 21:20" />उनने यो सुनीखे परमेश्वर की महिमा करी, फिर ओकासे बोल्यो, “हे पौलुस भैइ, तू देखस हइ, कि यहूदीहोन मे से कइ हजार ने विश्वास कर्यो हइ. अरु सब व्यवस्था का प्रती उत्साही हइ. <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />अरु उनखे तरा बारे मे सिखायो गयो कि तु गैरयहूदीहोन मे र्‍हेनाला यहूदीहोन खे मूसा से फिर जिवन खे सिखास हइ अरु बोलस हइ, कि नी अपना बच्चाहोन को खतनो करणु अरु नी रीतिहोन पर चलनु. <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />ते फिर का कर्यो जाह्ये दुन्या जरुर सुन्ये कि तु ह्या आयो हइ. <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />येकालिये जो तरा से बोलस हइ, उ कर हमारा ह्या चार इन्सान हइ, जेने मन्नत मानी हइ. <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />उनखे लिखे ओका साथ अपना आप खे अच्छो कर. अरु उनका लिये खर्चा दे, कि वे बाल मुन्डाये तब सब जानी लिये कि जो बातहोन उनने तरा बारे मे सिखी गइ, उनकी कुछ जड नी हइ पन तू खुद भी व्यवस्था खे मानीखे ओका अनुसार चलस हय. <note caller="+" style="x"><char style="xo" closed="false">21:24 </char><char style="xt" closed="false"><ref loc="NUM 6:13-21">गिनती 6:13-18—6:21</ref></char></note> <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" />पन उन गैरयहूदीहोन का बरे मे जोन्हे विश्वास कर्यो हइ हमने यो सल्लो करीखे लिखी भेज्यो हइ कि वे मुर्तिहोन का सामने बलि कर्यो हुयो मास से अरु खुन से अरु गलो घोट्यो हुयो को मास से अरु पाप से, बच्या र्‍हेनु.”<verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />तब पौलुस उन इन्सानहोन खे लिखे अरु दुसरा दिन उनका साथ अच्छो हुइखे मन्दिर मे गयो, अरु वहा बतैइ दियो कि अच्छो होन का दिन अगर उनमे से हर एक का लिये चडाओ चडाय जाना तक को दिन कब पुरा हुये.<verse eid="ACT 21:26" /></para>
  <para style="s">मन्दिर मे पौलुस की गिरफ्तारी</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />जब वे सात दिन पूरा होना पर था, ते आसिया का यहूदीहोन ने पौलुस खे मन्दिर मे देखी खे देख सब दुन्याहोन खे भडकायो, अरु यो चिल्लय खे ओखे पकडि लियो. <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />“हे इस्राएलिहोन, मद्दत कर. यो उ इन्सान हइ, जो दुन्या खे , अरु व्यवस्था खे , अरु यो स्थान खे विरोध मे हर जगह सब दुन्या को सिखास है, ह्या तक कि यूनानीहोन को भी मन्दिर मे लयखे ओने यो पवित्र जगत खे अपवित्र कर्यो हइ.” <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />उनने ते येकासे पइले इफिसुस वासी त्रुफिमुस खे ओका साथ नगर मे देख्यो थो, अरु समझतो थो कि पौलुस ओखे मन्दिर मे लि आयो हइ.<verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />तब पुरा नगर मे हल्लो मची गयो अरु दुन्या दौडि खे जमा हुया, अरु पौलुस खे पकडिखे मन्दिर का बाहेर घीसी लायो, अरु जल्दी दरवाजा बन्द करी गयो. <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />जब वे ओखे मारी डालनो चाहाता था, ते सैन्य-दल का सरदार खे सन्देशो पहुचा कि पुरा यरुशलेम मे हल्लो मची र्‍हो हइ. <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />तब उ जल्दी सैनीकहोन अरु सुबेदार होन खे लिखे उनका पास नीच्चे दौडि आयो. अरु उनने सैन्य-दल का सरदार खे अरु सैनीकहोन खे देखीखे पौलुस खे मारनो-पीटनो रोखी दियो. <verse eid="ACT 21:32" /><verse number="33" style="v" sid="ACT 21:33" />तब सैन्य-दल का सरदार ने पास अयखे ओखे पकडि लियो. अरु दो साकलहोन से बाधन की आज्ञा दिखे पूछन लग्यो, “यो कोन हइ, अरु एने का कर्यो हइ?” <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />पन गर्दी मे से कोय कुछ अरु कोय कुछ चिल्लाता र्‍हिया अरु जब हल्ला का मारे ठीक सच्ची नी जानी सक्यो, ते किला मे लि जान की आज्ञा दी. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />जब उ सीडि पर पहुच्यो, ते असो हुयो कि गर्दी का दबाव का मारे सिपाइहोन खे ओखे उठैइ खे लि जानो पड्यो. <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />क्युकि दुन्या कि गर्दी यो चिल्लाता हुये ओका पीछे पड्या, “ओको अन्त करी दे.”<verse eid="ACT 21:36" /></para>
  <para style="s">पौलुस अपनो बचाव करस हइ</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />जब वे पौलुस खे किला मे लि जाना पर था, ते ओने सैनीकहोन का सरदार से बोल्यो,</para>
  <para style="p" vid="ACT 21:37">“का मेखे आज्ञा हइ कि मी तरा से कुछ बोल्यु?” ओने बोल्यो, “का तू यूनानी जानस हइ?” <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />का तू उ मीस्रिहोन नी, जो ये दिनहोन से पइले विद्रोइ बनीखे चार हजार हथियारबंद कि बडैइ करी र्‍हो थो.<verse eid="ACT 21:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39" />पौलुस ने बोल्यो, “मी तो तरसुस को यहूदी इन्सान हइ! किलिकिया को प्रसिद्ध नगर को नीवासी हइ, अरु मी तरासे से प्रार्थना करुस हइ, कि मेखे दुन्या से बातहोन करण दे.”<verse eid="ACT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40" />जब ओने आज्ञा दि, ते पौलुस ने सीडि पर खडो हुइखे दुन्या का हाथ से इशारो कर्यो जब वे चुप हुइ गया, ते उ इब्रानी भाषा मे बोलन लग्यो.<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />“हे मरा यहूदीया भैइहोन अरु मरी बात सुन्नु क्युकि मी तुम्हारा सामने अपनो बचाव करुस हइ.” <verse eid="ACT 22:1" /><verse number="2" style="v" sid="ACT 22:2" />वे यो सुनीखे कि उ उनसे इब्रानी भाषा मे बोलस हइ, ते वे चुप हुइ गया. तब ओने बोल्यो:<verse eid="ACT 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3" />मी तो यहूदीया इन्सान हइ किलिकिया का तरसुस मे जन्म्यो. पन यो यरुशलेम मे पल्यो बड्यो गमलीएल का पाय का पास बठी खे शिक्षा प्राप्त करी खे अरु बुजुरुखहोन की व्यवस्था भी ठीक रीति पर सिखायो गयो. अरु परमेश्वर का प्रती हइ एसी धुन लगायो थो, जसा तुम सब आज हइ. <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />मेने इन्सान अरु बय दोइ खे पकडी खे अरु कैदी बन्य के बन्दीगृह मे डाली खे यो पथ खे ह्या तक सतायो, कि उनखे मारी भी डाल्यो. <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />खुद महा याजक अरु बुजुरुख गवा हइ. कि उनमे से भैइहोन का नाम इन से चिठ्ठी भी लि थी दमीश्क कि जो दुन्या या रस्ता पर चलता उनखे पकडी खे बंदीघर मे ला अरु उनखे दड दिलायु.<verse eid="ACT 22:5" /></para>
  <para style="s">पौलुस अपनो हृदय-परिवर्तन का बारे मे बतास हइ</para>
  <para style="r">(<ref loc="ACT 9:1-19">प्रेरितहोन 9:1-19</ref>; <ref loc="ACT 26:12-28">26:12-28</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />“जब मी जत्रा करी खे दमीश्क का पास पहुच्यो ते असो हुयो कि दुपेर का नजीक पास अचानक एक बडी बिजली बद्दल से मरा चारी तरफ चमकी. <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />अरु मी जमीन पर गिर पड्यो. अरु या वाणी सुनी ‘हे शाउल, हे शाउल, तु मेखे क्यु सतय रो हइ.’ <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />मेने जवाब दियो, ‘हे प्रभु, तु कोन हइ?’ ओने मरासे बोल्यो, ‘मी यीशु नासरी हइ, जेखे तू सतास हइ.’ <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />अरु मरा सोप्तिहोन ने ज्योति तो देखी, पन जो मरासे बोलतो थो ओकी आवाज नी सुनी. <verse eid="ACT 22:9" /><verse number="10" style="v" sid="ACT 22:10" />तब मेने बोल्यो, ‘हे प्रभु, मी का करु?’ प्रभु ने मरासे बोल्यो, ‘उठी खे दमीश्क मे जा, अरु जो कुछ तरा करण का लिये ठैरयो गयो हइ वहा तोखे सब बतैइ दियो जाह्ये.’ <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />जब वा ज्योती का तेज करण मी अंधो हुइ गयो थो, ते मरा सोप्तिहोन को हाथ पकडी हुया दमीश्क मे आया.<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />“तब हनन्याह नाम को व्यवस्था का जसो चलनआलो एक भक्त इन्सान खे जो वहा का र्‍हेनआला सब यहूदीयाहोन को मान रखतो थो, <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />अरु खडो हुइ खे मरासे बोल्यो हे भैइ शाउल, फिर देखन लग्यो, वा घडी मरी आख खुली गइ अरु मेने ओखे देख्यो. <verse eid="ACT 22:13" /><verse number="14" style="v" sid="ACT 22:14" />तब ओने बोल्यो, हमारा बुजरुक को परमेश्वर ने तोखे येका लिये ठैरायो हइ कि तु ओकी इच्छा खे जान्यो, अरु उ धर्मी खे देख्यो, अरु ओका मुडासे बातहोन सुनी. <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />क्युकि तु ओकी तरफ से सब इन्सानहोन का सामने वा बात होन कि गवा हुये खे जो तोने देखी अरु सुनी हइ. <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />अब क्यु देर करस हइ? उट बपतिस्मा ले, अरु ओको नाम लि खे अपना पाप खे धौइ डाल.<verse eid="ACT 22:16" /></para>
  <para style="s">पौलुस खे प्रचार मे बुलायो</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />“जब मी फिर यरुशलेम मे अय खे मन्‍दिर मे प्रार्थना करी र्‍हो थो. मेने दृष्‍टान्‍त देख्यो. <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />अरु प्रभु ने देख्यो कि मरासे बोलस हइ, जल्दी करी खे यरुशलेम से जल्दी नीकली जा. क्युकि वे मरा बारे मे तरी गवइ नी मान्ये. <verse eid="ACT 22:18" /><verse number="19" style="v" sid="ACT 22:19" />मेने बोल्यो, हे प्रभु वे तो तुम जानस हइ, कि मी तरा पर विश्वास करणआला होन खे बंदीघर मे डालतो अरु जगा-जगा आराधनालय मे जैइ के पिटवातो थो. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />अरु जब तरो गवा स्तिफनुस को खुन बोहायो जै ऱ्हो थो तब भी मी वहा खडो थो, अरु या बात मे सहमत थो, अरु ओको हत्याराहोन का कपडा कि रखवाली करतो थो. <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />अरु प्रभु ने मरासे बोल्यो, ‘चली जा : क्युकि मी तोखे गैरयहूदिहोन का पास दुर भेज्यु’.”<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />वे या बात तक पौलुस सुनतो र्‍हियो. तब उचो शब्द से चिल्लायो, “असा इन्सान खे जमीन से मीटय दे. ओको जिन्दो र्‍हेनु अच्छो नी. <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />जब वे चिल्लाता अरु कपडा फाडता अरु हवा मे धुल्लो उडाथो था. <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />तो रोमी टुकडी का सेनादल का सुबेदार ने बोल्यो, येखे किल्ला मे लि जाओ अरु कोडा मारी खे जाचनु, कि मी जान्यु कि यहूदीया दुन्या कोय करण ओका विरोध मे असा चिल्लय र्‍हा हइ,” <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />लेकिन जब उनने ओखे कोडा मारन का लिये बांधी दियो ते पौलुस ने वहा खडो अधिकारी से बोल्यो, तुम्हारा लिये रोमी नागरीक खे कोडा मारनो अच्छो हइ, जो कोय को भी अपराध का लिये भी कोशिश नी करी गइ हइ.<verse eid="ACT 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26" />अधिकारी ने यो सुनी खे सेनापति का सरदार का पास जैइ, बोल्यो “तू ह्या का करस हइ? यो तो रोमी इन्सान हइ.”<verse eid="ACT 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27" />तब सेनादल का सरदान ने पौलुस का पास अय खे बोल्यो,</para>
  <para style="p" vid="ACT 22:27">मेखे बता, तु रोमी हइ? पौलुस ने बोल्यो, “हा.”<verse eid="ACT 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28" />यो सुनी खे सेनादल को सरदार ने बोल्यो, “मेने रोमी होन को पद भोत रुपीया मे दिखे मील्यो हइ.”</para>
  <para style="p" vid="ACT 22:28">पन पौलुस ने बोल्यो, “मी तो जन्म से रोमी हइ.”<verse eid="ACT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29" />तब जो दुन्या ओखे पुछताच करण आला था, वे जल्दी ओका पास से हटी गया. अरु सेनादल को सरदार भी यो जानी खे कि यो रोमी हइ, अरु ओने ओखे बाध्यो हइ, डरी गया.<verse eid="ACT 22:29" /></para>
  <para style="s">महासभा का सामने पौलुस</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />दूसरा दिन रोमी टुकडी को सेना नायक यो ठीक-ठीक जानन की इच्छा से कि यहूदीया ओ पर दोष लगास हइ, येका लिये ओको बन्दन खोली दियो. अरु प्रधान याजकहोन अरु पुरी महासभा खे इकठ्ठा होन कि आज्ञा दी, अरु पौलुस खे नीच्चे लि जैइ खे उनका सामने खडो करी दियो.<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />पौलुस ने महासभा का तरफ टकटकी लगैइ खे देख्यो, अरु बोल्यो, हे इस्त्राएली भैइहोन, मेने आज तक परमेश्वर का लिये बिलकुल सच्चा विवेक से जिवन बितायो हइ. <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />हनन्याह महायाजक ने, उनका जो ओका पास खडो थो, ओका गाल पर थप्पड मारन कि आज्ञा दी. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />तब पौलुस ने ओकासे बोल्यो, “ हे चुन्नो फिरी हुइ दिवाल, परमेश्वर तोखे मार्येका तू मूसा का नीयम का जसो मरो न्याय करण का लिये बठ्यो हइ, अरु फिर व्यवस्था का विरुध्द मेखे मारन कि आज्ञा देस हइ?”<verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />जो दुन्या पौलुस का पास खडा था, “उनने बोल्यो, तू परमेश्वर को महायाजक खे बुरो-भलो बोलस हइ.”<verse eid="ACT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5" />पौलुस ने बोल्यो, “हे इस्त्राएली भैइहोन, मी नी जानतो थो, कि यो महायाजक हइ. क्युकि लिख्यो हइ, अपना दुन्या का प्रधान खे बुरो नी बोलनु.”<verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />तब पौलुस ने यो जानी खे कि एक दल सदूकिहोन अरु दूसरा फिरीसिहोन को हइ, महासभा मे पुकारी खे बोल्यो, “हे भैइहोन मी फरीसी अरु फिरीसीहोन को वंश को हइ, मर्या हुया कि आस अरु पुनरुत्थान का बारे मे मरो मेकदमो हुइ र्‍हो हइ.”<verse eid="ACT 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7" />जब ओने या बात बोली ते फरीसीहोन अरु सदूकिहोन मे वाद विवाद होन लग्यो. अरु सभा मे फुट पडी गइ. <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />क्युकि सदूकि तो यो बोलस हइ, कि नी पुनरुत्थान हइ, नी स्वर्गदूत अरु नी आत्मा हइ. पन फरीसी यो सब खे मानस हइ. <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />तब बडो हल्लो मच्यो अरु कुछ मूसा को नीयम को शिक्षक जो फरीसीहोन को दल को थो, उठी खे यो बोलि खे झगडन लग्या, “हम यो इन्सान मे कुछ बुराइ नी पाय. अरु अगर कोय आत्मा या स्वर्गदूत ओकासे बोल्यो हइ ते फिर का”<verse eid="ACT 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10" />जब भोत वाद विवाद हुयो, ते सेनादल को सरदार ने या डर से कि वे पौलुस का टुकडा टुकडा नी करी नी डाल्येका सेनादल खे आज्ञा दी कि उतरी खे ओखे उनका बय मे से जबरदस्ती नीकलनु, अरु किल्ला मे लि आनू. <verse eid="ACT 23:10" /><verse number="11" style="v" sid="ACT 23:11" />उय रात प्रभु ने ओका पास अयखे खडो हुइ खे बोल्यो, “हे पौलुस हिम्मत रख क्युकि जसो तोने यरुशलेम मे मरी गवइ दी, वसो ही तोखे रोम मे भी गवइ देनु पड्ये.”<verse eid="ACT 23:11" /></para>
  <para style="s">पौलुस कि जिवन का बारे मे</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />जब दिन हुयो, ते यहूदीयाहोन ने इकठ्ठा हुया अरु साजीस रच्यो, अरु कसम खय कि जब तक हम पौलुस खे मारी नी डाल्ये अगर हम खाया या पीया ते हम पर धिक्कर. <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />जेने या कसम खे खाय थी वे चालीस जन से जादा था. <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />उनने प्रधान याजकहोन का पास अय खे बोल्यो, “हमने यो ठान्यो हइ कि जब तक हम पौलुस खे मारी नी डाल्येका तब तक अगर कुछ भी खाये ते हम पर धिकार हइ. <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />अरु फिर यहूदीया समेत सेनादल का सरदार का समझानु, कि ओखे तुम्हारा पास लि अयखे मानु कि तुम ओका बारे मे अरु ओका पहुचना से पइले हि ओखे मारी डालन का लिये तैयार र्‍हिये.”<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />अरु पौलुस की भैइन ने सुन्यो कि वे ओखे मारी डालन कि ताक मे हइ, ते सैनीकहोन किल्ला मे जैइ खे पौलु खे सन्देशो दियो. <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />पौलुस ने सुबेदार मे से एक, “पलटन को सरदार का पास लि जानु का यो जवान ओका से कुछ बोलनु चाहस हइ.” <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />आखरी. ओने ओखे पलटन का सरदार का पास लि जैइ खे बोल्यो, बन्दी पौलुस ने मेखे बुलैइ, प्रार्थना करी खे की यो जवान खे पलटन का सरदार से कुछ बोलनु चाहस हइ. येखे ओखा पास लि जा.<verse eid="ACT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19" />पलटन का सरदार ने ओको हाथ पकडी खे अरु ओखे अलग लि जैइ खे पुच्छो, “तू मरासे का बोलनु चाहस हइ?”<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />.ओने बोल्यो, “यहूदीयाहोन ने साजिस रची हइ, कि तरासे प्रार्थना करी कि कल पौलुस खे महासभा मे लानु, मानो तू अरु ठीक से ओकी जाच करणु चाहस हइ. <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />पन उनकी नी माननु, क्युकि उनमे से चालीस का उपर इन्सान ओको घात मे हइ, जोन्हे यो ठानी लियो हइ कि जब तक वे पौलुस खे मारी नी डाले, तब तक नी खाये अरु पीये अरु अब वे तैयार हइ अरु तरो बोलन कि रस्ता देखी र्‍हा हइ.”<verse eid="ACT 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22" />तब पलटन को सरदार ने जवान खे यो बतैइ खे बिदा कर्यो, “कोय से नी बोलनु कि तोने मेखे या बातहोन बतैइ हइ.”<verse eid="ACT 23:22" /></para>
  <para style="s">पौलुस खे कैसरिया भेझनो</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />फिर ओने तब दो सुबेदार खे बुलैइ खे बोल्यो, “दो सौ सैनीक का सत्तर घोड सवार को अरु दो सौ भालाआला के कैसरिया जान का लिये तैयार करी रख, तू रात खे नउ बजो नीकलनु. <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />अरु पौलुस की सवारी का लिये घोडा तैयार रखनु कि ओखे फेलिक्स राज्यपाल का पास सुरक्षित पहुच्यैइ दे.” <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />सेनापती ने यो प्रकार कि चिठ्ठी भी लिखी.<verse eid="ACT 23:25" /></para>
  <para style="pi">
    <verse number="26" style="v" sid="ACT 23:26" />“महाप्रतापी फेलिक्स राज्यपाल खे क्लौदियुस लूसियास को नमस्कार. <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />यो इन्सान खे यहूदीयाहोन ने पकडी खे मार डालनो चायो, पन जब मेने जान्यो कि उ रोमी हइ, ते पलटन लिखे छुड्य लायो. <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />अरु मी जाननु चाहतो थो, कि वे ओका पर कोपय करण दोष लगास हइ, येका लिये ओखे नीच्चे उनकी महासभा मे लि गयो. <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />तब मेने जानी लियो, उनकी व्यवस्था को झगडाहोन का बारे मे ओ पर दोष लगास हइ, पन मारी डाल्या जाना या बाधी जान को योग्य ओमे कोय दोष नी. <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />अरु जब मेखे बतायो गयो, कि वे यो इन्सान खे मारना मे लग्या हइ ते मेने जल्दी ओखे तरा पास भेजी दियो. अरु दोश लगान आला खे भी आज्ञा दी, उनका लगाया हुया दोष तरा सामने रखन.”<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />आखरी जसो सैनीकहोन खे आज्ञा दी गइ थी, वसो ही पौलुस खे लि खे रातो-रात अन्तिपत्रिस नजीकपास ओका पास पहुचनु. <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />दुसरा दिन घोडसवारहोन पौलुस का साथ आगे जान, लिये परदल चलन आला सैनीकहोन ने किल्ला मे छोडी दियो. <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />उनने कैसरिया मे पहुची, राज्यपाल खे चिठ्ठी दी. अरु पौलुस खे भी ओका सामने खडो कर्यो. <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />ओने पडी खे पूछो, “यो कोनता देश को हइ?” अरु जब जानी गयो कि किलिकिया को हइ. <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />ओने बोल्यो, जब तरा दोष लगान आला भी अयखे ते मी तरो मुकद्दमो कर्यु, अरु ओने उ हेरोदेस का किल्ला मे, पहरा मे रखन कि आज्ञा दी.<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s">पौलुस का विरोध मे इलजाम</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />पाच दिन का बाद हनन्याह महायाजक भोत बुजरुक अरु तिरतुल्लुस नामको कोय वकील खे साथ लिखे कैसरिया आयो. उनने राज्यपाला का सामने पौलुस पर इलजाम लगायो. <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />जब पौलु खे बुलायो गयो ते तिरतुल्लुस पर इलजाम लगैइ खे बोलन लग्यो,</para>
  <para style="p" vid="ACT 24:2">“हे महाप्रतापी, फेलिक्स का साथ मे पेस कर्यो तब थो पुलीस इलजाम लगाता हुये बोल्यो हे महामहिम तुम्हारो अगुवाइ मे काफी टेम से शांती से र्‍हि र्‍हा हइ, अरु तुम्हारा नजर से देश मे भोत जात को अच्छो सुधार हुयो हइ. <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />येके हम हर जगा अरु फेलिक्स हर प्रकार से येको स्वागत करस हइ अरु हम बडी गैराइ से येका लिये धन्यवादीत हइ. <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />पन येका लिये कि तोखे अरु दुख नी देनो चाउ, मी नी चाउ भोत जादा टेम मे तो प्रार्थना करुस हइ कृपया तुम मे हम खे एक दो शब्द मे सुनीले. <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />क्युकि हमने इन्सान खे उपद्रवी अरु जगत का पुरा यहूदीयाहोन मे वाद विवाद पइदा करणआला, अरु नासरीहोन को चालु समे को अध्यक्ष पायो हइ. <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />ओने मन्‍दिर खे अशुध्द करनो चाह्यो, अरु तब हमने ओखे बन्दी बन्ये लियो. <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />पन पलटन का सरदार लूसियास ने अय खे ओखे हिम्मत हमारा हातहोन से छीनी लियो. <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />या सब बातहोन खे जिन का बारे मे हम ओका पर इलजाम लगास हइ, तू खुद ओखे परखी खे जानी लिये.” <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />यहूदीयाहोन ने भी ओको साथ दि खे बोल्या कि यो सब सच्ची थो.<verse eid="ACT 24:9" /></para>
  <para style="s">फेलिक्स का सामने पौलुस को बचाव करनो</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />जब राज्यपाल ने पौलुस कए बोलन का लिये इशारो कर्यो ते ओने जवाब दियो. मी यो जानी खे कि तु भोत साल से यो राष्ट्र को न्याय करस हइ, मी खुशी का साथ अपनो बचाव पक्ष तुम्हारा सामने जात रखनो चाहुस हइ. <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />तूम पतो करी सकस हइ, कि जब से मी यरुशलेम मे आराधना करण खे आयो, मेखे बारा दिन से जादा दिन नी हुया. <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />यहूदीयाहोन ने मेखे नी ते कोय का साथ बहस करता नी पायो, अरु नी दुन्या कि गर्दी लगाता हुये अरु यहूदीया आराधनालयहोन मे गर्दी नी शहर मे दंगो फैलाते हुये पायो. <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />अरु नी ते वे उन बातहोन खे जिनका बारे मे वे अब मरा पर इलजाम लगास हइ, तरा सामने सच साबित करी सकस हइ. <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />पन यो मी तरा सामने मानी लेउस हइ, कि जो रस्ता खे वे झुठो बोलस हइ, ओका रीति पर मी अपना बुजुरुखहोन को परमेश्वर कि आराधना करुस हइ. पन यो भी विश्वास करुस हइ जो बातहोन मूसा कि व्यवस्था अरु भविष्यव्दक्ताहोन की किताबहोन मे लिखी हइ उन सब पर विश्वास करुस हइ. <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />अरु परमेश्वर पर ओसो ही विश्वास रखस हइ कि अच्छा अरु बुरा दो को ही पुनरुत्थान हुये. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />येका से मी खुद भी कोशिश करुस हइ, कि परमेश्वर खे अरु इन्सान का तरफ मरो विवेक सदा नीर्दोष र्‍हिये.<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />भोत साल का बाद यरुशलेम मी अपना गरीब दुन्या खे पहचान, अरु दान चडान आयो थो. <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />जब मी यो करी र्‍हो थो, उनने मेखे मन्‍दिर मे पायो, शुध्दिकरण कि विधी पुरी करी र्‍हो थो नी व्हा गर्दी थी अरु नी सोय. <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />व्हा आसिया प्रांत का कुछ यहूदीया था, यो जरुरी था की अगर मरा विरोध मे उनका पास बात थी ते ह्या तरा सामने अय खे मरा पर इलजाम लगास. <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />ह्या यहूदीया दुन्या खुद ही बोल्या, कि जब मी बडी सभा का सामने खडा थो, ते उनने मरा मे कोन तो अपराध पायो? <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />जब मी उनका बीच मे खडो थो, “ तब मे ने उचो आवाज मे बोल्यो थो मर्या हुया मे से जिन्दो उठान का बारे मे मरा विश्वास करनो मरो न्याय हुइ र्‍हो हइ.”<verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />फेलिक्स ने जो रीति की बातहोन ठीक-ठीक जानतो थो, यन्हे यो बोली खे टाली दियो, “जब पलटन को सरदार लूसियास आह्ये ते तुम्हारी बात को नीर्णय दियु.” <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />अरु सुबेदार खे आज्ञा दी, कि पौलुस खे कुच छुट दि खे रखवाली करणु, अरु ओका दोस्त मे से कोइ खे भी ओकी सेवा करण से नी रोखनु.<verse eid="ACT 24:23" /></para>
  <para style="s">पौलुस की फिलिक्स अरु द्रुसिल्ला से बातचीत</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />कुछ दिन का बाद फेलिक्स अपनी लुगय द्रुसिल्ला जो यहूदीया बय थी, साथ लिखे आयो अरु पौलुस खे बुलैइ खे उ विश्वास का बारे मे जो मसीह यीशु पर हइ, ओने सुन्यो. <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />जब वा अच्छी बातहोन अरु खुद अरु आनआला न्याय का दिन की चर्चा करी र्‍हो थो, ते फेलिक्स ने डरी खे हुइ खे जवाब दियो, “ अभी तो जा. अवसर मीलीखे मी तोखे फिर बुलायू.” <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />ओखे पौलुस से कुछ पैसा मीलन की भी आस थी. येका लिये अरु भी बार-बार बुलैइ खे बातहोन कर्या करतो थो.<verse eid="ACT 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27" />पन जब दो साल बीती गा, ते पुरकियुस फेस्तुस, फेलिक्स का जगा पर राज्यपाल बनी खे आयो, अरु फेलिक्स यहूदीयाहोन खे खुश करण की इच्छा से पौलुस खे बन्दीघर मे छोडी दियो.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">फेस्तुस कआ सामने पौलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />फेस्तुस उ देस मे पहुची खे तीन दिन का बाद कैसरिया से यरुशलेम खे गयो. <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />तब व्हा यहूदीयाहोन का प्रधान याजकहोन का प्रमुख दुन्याहोन ने, ओका सामने पौलुस पर इलजाम लगायो. <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />तब यहूदीया याजक वे फेस्तुस से प्रार्थना करी र्‍हा की उ कृपा पौलुस खे यरुशलेम मे बुलानु ताकी वे ओखे रस्ता मे मारी डाली सक्ये. <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />फेस्तुस ने जवाब दियो, पौलुस कैसरिया मे कैद हइ, अरु मी खुद जल्दी वहा जायु. <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />फिर बोल्यो, तुम मे से नेताहोन खे मरा साथ कैसरिया भेजनु, अरु अगर यो इन्सान ने कुछ बुरा काम कर्यो हइ, ते ओ पर इलजाम लगाये.<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />उनका बीच कोय आठ दस दिन र्‍हिखे उ कैसरिया चली गयो. अरु दुसरा दिन न्याय आसन पर बठी खे पौलुस खे लान की आज्ञा दी. <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />जब पौलुस आयो, ते जो यहूदीया अधिकारी यरुशलेम से आया था, उनने आस-पास खडा हुइ खे ओका पर भोत सा गम्भीर इलजाम लगाया, जिनको सबुत वे नी दि सकता था. <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />पन पौलुस ने खुद का बचाव मे बोल्यो, “मेने नी ते यहूदीयाहोन की व्यवस्था का तरफ नी मन्‍दिर का अरु रोमन शासक कैसर का विरुध्द कोय अपराध नी कर्यो हइ.”<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />तब फेस्तुस ने यहूदीयाहोन खे खुश करण की इच्छा से पौलुस खे जबाब दियो “चाहस हइ कि यरुशलेम का जानु. अरु वहा मरा सामने तरो यो मुकद्दमो तय कर्या जाय?” <verse eid="ACT 25:9" /><verse number="10" style="v" sid="ACT 25:10" />पौलुस ने बोल्यो, मी कैसर का न्याय आसन का सामने खडो हइ. मरो मुकद्दमो को यो फैसलो होन खे होनू, जसो तु अच्छा तरह जानस हइ, यहूदीयाहोन का विरुध्द मे मेने कुछ अपराध नी कर्यो. <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />अगर मी अपराधी हइ अरु मारी डाल नो योग्य कोय काम कर्यो हइ, ते मरन से नी मुकरु. पन जो बातहोन को यो मरा पर इलजाम लगास हइ, अगर उनमे से कोय बात सच्ची नी ठैर्ये ते कोय मेखे उनका हाथ नी सोपी सक्ये, मी कैसर से प्रार्थना करुस हइ.<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />तब फेस्तुस ने मंत्रिहोन की सभा का साथ बिचार करीखे जवाब दियो, “तोने कैसर खे दोहाइ दी हइ, ते कैसर का पास ही जाये.”<verse eid="ACT 25:12" /></para>
  <para style="s">राजो अग्रिप्पा अरु बिरनी का सामने पौलुस</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />कुछ दिन बीतना का बाद अग्रिप्पा राजो अरु बिरनी खे कैसरिया मे अय खे फेस्तुस से दान कर्यो. <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />उनका भोत दिन वहा र्‍हेन का बाद फेस्तुस ने पौलुस का बारे मे राजा खे बतायो, “एक इन्सान हइ जेखे फेलिक्स ने बन्दी घर मे ही छोड्या गयो. <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />जब मी यरुशलेम मे गयो थो, ते प्रधान याजकहोन अरु यहूदीयाहोन का बुजरुकहोन ने मी ओ पर दोषी ठैरार्‍ये सक्यु, कि ओका पर दण्ड की आज्ञा दी जाये. <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />लेकिन मेने उनका जवाब दियो, कि रोमीहोन की या रीति नी, कि कोय इन्सान खे दण्ड का लिये सौपी दे, जब तक दोषी खे अपनो दोष लगान आला का सामने दान अरु आरोप का खिलाप खुद को बचाव करण को मौको दियो. <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />आखरी जब वे मरा साथ ह्या अयखे ते मेने कुछ देर नी करी खे पन दुसरा ही दिन न्याय आसन पर बठी खे उ इन्सान खे कोरट मे लान की आज्ञा दी. <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />जब ओको दोष लगान आला खडा हुया, ते उनने असी बुरी बातहोन को दोष नी लगायो, जसो मी समझतो थो वे मी कर्यु. <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />पन अपना मत खे अरु यीशु नामको कोय इन्सान का बारे मे जो मर्या था, अरु पौलुस ओखे जिन्दो बतातो थो, अरु वाद विवाद करता था. <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />अरु मी उलझन मे थो, कि या बातहोन को पतो कसो लगायु? येका लिये मेने पौलुस से पुछ्यो, तु यरुशलेम जायेका कि वहा या बातहोन को फैसलो हुये? <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />पन जब पौलुस ने बिनती, करी मरो मुकद्दमा को फैसलो कैसर का ह्या हुये ते मेने आज्ञा दि, कि जब तक ओखे कैसर का पास नी भेज्यु, ओखे कैद मे रख्या जाये.”<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />जब अग्रिप्पा ने फेस्तुस से बोल्ये “मी भी उ इन्सान कि सुन्नु चाहुस हइ</para>
  <para style="p" vid="ACT 25:22">“ओने बोल्यो,” तू सुनी लिये.<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />आखरी दुसरा दिन खे अग्रिप्पा अरु बिरनी खे को बडी धुम धाम से अय खे पलटन का सरदारहोन अरु नगर का प्रमुख खे दुन्याहोन का साथ दरबार मे पहुच्या, तब फेस्तुस ने आज्ञा दी कि वे पौलुस खे लिखे आये. <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />फेस्तुस ने बोल्यो, हे राजा अग्रिप्पा, अरु हे इन्सानहोन जो ह्या हमारा साथ हुये खे तुम यो इन्सानहोन खे देखस हइ, जेका बारे मे पुरा यहूदीयाहोन ने यरुशलेम मे अरु ह्या भी चिल्ले-चिल्लय खे मेखे प्रार्थना करी, कि येको जिन्दो र्‍हेनु अच्छो नी. <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />पन मेने जानी लियो कि ओने असो कुछ नी कर्यो कि मारी डाले जाय, अरु जब कि ओने खुद ही कैसर से प्रार्थना करी, ते मेने ओखे रोम भेजन फैसलो कर्यो. <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />पन मेने प्रभु को बचाव काबा बरे मे कोय ठिक बात नी देख्यो कि कैसर खे लिख भेजु, येका लिये मी ओखे तुम्‍हारा सामने अरु विशेष करी, हे राजा अग्रिप्पा तरा सामने लायो हइ, कि परख्ये का बाद मेखे कुछ तो ओखा बारे मे लिखन खे मील्ये. <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />क्युकि बन्दी खे भेझनो अरु जो इलजाम ओका पर लगाया गया, उनने बतायो कि मेखे व्यर्थ समझ पड्यो हइ.<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">अग्रिप्पा का सामने पौलुस को बचाव</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />अग्रिप्पा ने पौलुस से बोल्यो, “ तोखे अपना बारे मे बोलन की आज्ञा हइ” तब पौलुस हाथ बड्यैइ खे जवाब देन लग्यो.<verse eid="ACT 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 26:2" />हे राजा अग्रिप्पा, जोत्ती बातहोन को यहूदीया मरा पर इलजाम लगास हइ, आज तरा सामने उनको जवाब देना मे मी खुद खे धन्य समझुस हइ. <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />विशेष करी खे येका लिये कि यहूदीयाहोन खे सब प्रथाहोन अरु विवादहोन खे जानुस हइ, आखरी मी प्रार्थना करुस हइ, धीरज से मरी सुनी ले.<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />जसो मरो चाल चलन बचपन से अपना जात का बीच अरु यरुशलेम मे जसो थो का यो सब यहूदीया जानस हइ. <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />वे मेखे भोत टेम से जानस हइ अगर वे चाहता ते या बात की गवइ दि सकस हइ की मे ने फरीसी रस्ता खे एक सब से कट्टर जसो एक सदस्य का रुप मे जिवन जीयो. <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />अरु अब वा प्रतीज्ञा कि आसकरण जो परमेश्वर ने हमारा बुर्जुकहोन से करी थी, मरा पर मुकद्दमो चलैइ र्‍हा हइ. <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />वा प्रतीज्ञा को पूरो होना की आस लगाता हुया, हमारा बारा कुल अपना पूरा मन से रात दिन परमेश्वर की सेवा करता आया हइ, हे राजा, या आस का बारे मे यहूदीया मरा पर इलजाम लगास हइ. <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />जब कि परमेश्वर मर्या हुया खे जिन्दो हइ, ते तुम्हारा ह्या या बात क्यु विश्वास का योग्य नी समझी जाय?<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />मेने भी समझो थो कि यीशु नासर का नाम का विरोध मे मी भोत कुछ करु. <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />अरु मेने यरुशलेम मे असो ही कर्यो. अरु प्रधान याजकहोन से अधिकार मीलीखे भोत सा परमेश्वर का दुन्याहोन खे बन्दीगृह मे डाल्यो, अरु जब वे अपनी सम्मती देता था. <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />अरु हर आराधनालय मे मी उनखे सजा दिलै-दिलैइ खे यीशु का विश्वास खे नाकारतो थो, उनका प्रती मरो घुस्सो उनखे नीन्दा का लिये ह्या तक मी विदेशी शहरहोन मे गयो.<verse eid="ACT 26:11" /></para>
  <para style="s">पौलुस को मन परिवर्तन को मे वायनो</para>
  <para style="r">(<ref loc="ACT 9:1-19">प्रेरितहोन 9:1-19</ref>; <ref loc="ACT 22:6-16">22:6-16</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />यो अभिप्राय से मी एक दिन प्रधान याजकहोन से अधिकार अरु आज्ञा-चिठ्ठी लिखे दमीश्क खे जैइ र्‍हो थो. <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />ते हे राजा, रस्ता मे दुपेर का टेम मे मेने स्वर्ग से सुरज को तेज से भी बडी खे एक ज्योत, अपना अरु अपना साथ चलनआला होन का चारी तरफ चमकती हुइ देखी. <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />अरु जब हम जमीन पर गिर पड्या, ते मेने इब्रानी भाषा मे, मरा से बोलता हुये या वाणी सुनी, हे शाउल, हे शाउल का तू मेखे क्यु सतास हइ? पाय पर लाथ मारनो तरा लिये मुस्कील हइ. <verse eid="ACT 26:14" /><verse number="15" style="v" sid="ACT 26:15" />मेने बोल्यो हे प्रभु, तू कोन हइ? प्रभु ने बोल्यो, मी यीशु हइ जेखे तू सतास हइ. <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />पन तू उटी खे अपना पाय पर खडो हो, क्युकि मेने तोखे येका लिये दर्शन दियो हइ कि तोखे उन बातहोन को भी सेवक अरु गवा ठैरायु जो तोने देखी हइ अरु उनको भी जोका लिये मी तोखे दर्शन दियु. <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />अरु मी तोखे तरा अपना दुन्या यहूदीयाहोन अरु गैरयहूदीहोन से छुड्य खे जेका पास मी अब तोखे भेज्यु. <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />कि तु उनका आखहोन खोल कि वे अंधारा से सैतान को अधिकार उजाला का तरफ फिरनु. ताकी उनका विश्वास का वजेसे जो उन पर हइ वे उनका पापहोन की माफी अरु परमेश्वर खे चुन्या हुया दुन्या का साथ जगा पाये.<verse eid="ACT 26:18" /></para>
  <para style="s">पौलुस अपना काम होन का बारे मे बतास हइ</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />“आखरी हे राजा अग्रिप्पा, मेने उ स्वर्गीय दर्शन की आज्ञा नी टाली. <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />पन पैयले दमीश्क का फिर यरुशलेम का र्‍हेनआला का तब यहूदीयाहोन का पुरा देश मे अरु गैरयहूदिहोन का समझातो र्‍हियो, मन पापहोन से फिरनु अरु परमेश्वर का तरफ मन फिरी खे मन फिराव का बरोबर अच्छो काम कर. <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />या बातहोन का कारण यहूदीया मेखे मन्‍दिर मे पकडी खे मारी डालन कि कोशिश करता था. <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />पन परमेश्वर की मद्दत से मी आज बन्यो हइ अरु छोटा बडा सभी का सामने गवाही देस हइ, अरु वे बातहोन खे छोड कुछ नी बोलतो, जो भविष्यव्दक्ताहोन अरु मूसा ने भी बोल्यो कि होनआली हइ. <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />कि मसीह खे दुख उठानु पड्ये का अरु उ सबसे पैयले मर्या हुया मे से जिन्दो उठस अगर खे हमारा दुन्या मे अरु गैरयहूदिहोन मे ज्योती को प्रचार कर्ये.”<verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />जब पौलुस अपना बचाव मे या सब बातहोन खे बोली र्‍हो थो, ते फेस्तुस ने उचो शब्द से बोल्यो, “हे पौलुस,तू पागल हइ, भोत ज्ञान ने तोखे पागल करी दियो हइ.”<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />पौलुस पन ओने बोल्य, “हे महाप्रतापी फेस्तुस, मी पागल नीका सच्ची अरु दिमाक कि बातहोन बोलुस हइ. <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />खुद. राजो अग्रिप्पा इन बातहोन का जानस हइ अरु मी पुरा हिम्मत का साथ या बातहोन उनसे बोली र्‍हो हइ क्युकि मी खुद जानुस ही कि इनमे से कोय भी बात उनखे मालुम नी असो नी हइ असो येका लिये बोली र्‍हो हइ कि या बात कोय कोना मे लुकी नी घटी. <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />हे राजा अग्रिप्पा, तु भविष्यव्दक्ताहोन को विश्वास करुस हइ? हा, मी जानुस हइ, कि तू विश्वास करस हइ.”<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />अब अग्रिप्पा ने पौलुस से बोल्यो “तू यो सोचस हइ की इत्ती सरलता से अरु कम टेम मे तू मेखे मसीह बनी सकस हइ.”<verse eid="ACT 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29" />पौलुस ने बोल्यो, परमेश्वर से मरी प्रार्थना या हइ कि, थोडा मे का भोत मे, फक्त तू ही नी, पन जेत्ता दुन्या आज मरी सुनस हइ, मरा इन बन्धनहोन खे छोड वे मरा जसा हुइ जा.<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />तब राजो अरु राज्यपाल अरु बिरनी खे, अरु उनका साथ बठनआला उठी खे खडा हुया. <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />अरु अलग जैइखे आपस मे बोलन लग्या, “यो इन्सान असो तो कुछ नी कर्येका जो मरन-दण्ड या बन्दीघर मे डाल्यो जान जसो हो.” <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />अग्रिप्पा ने फेस्तुस से बोल्यो, “अगर यो इन्सान कैसर की दोहाइ नी देतो, ते छुटी सकतो थो.”<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">पौलुस खे रोम भेज्यो जान्यो</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />जब यो नीश्चित हुइ गयो कि हम डोंगा का वजेसे इटली जाये ते उनने पौलुस अरु कुछ दुसरा बन्दिहोन खे भी यूलियुस नामको की सेनादल को एक सुबेदार का हाथ सौपी दियो. <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />हम अद्रमुत्तियुस से एक डोंगा पर सवार हुइखे गया, जो आसिया प्रात का बंदरगाहोन का लिये तीमुथियुस रवाना होन का लिये गया, अरिस्तर्खुस नामको थिस्सलुनीखे का शहर को एक मकिदुनी हमारा साथ थो. <verse eid="ACT 27:2" /><verse number="3" style="v" sid="ACT 27:3" />दूसरा दिन हम सैदा मे डोंगा से उतर्या, अरु यूलियुस ने पौलुस पर कृपा करी खे ओखे दोस्तहोन खे ह्या जान दियो ताकी, लगन आला जरुरत कि चिज ओखे दि सक्ये. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />व्हा से हम समुदर रस्ता से फिर चली गया क्युकि हवाहोन हमारा विरुध्द दिशाहोन मे थी हम साइप्रस टापु का आड मे हुइ खे चल्यो. <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />अरु किलिकिया अरु पंफूलिया का पास का समुद्र मे हुइ खे लूसिया मुरा शहर मे उतर्या. <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />वहा सुबेदार खे सिकन्दरिया को एक डोंगा इटली जातो हुयो मील्यो, अरु ओने हम खे ओका पर चड्यै दियो.<verse eid="ACT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7" />जब हम भोत दिन तक धीरे-धीरे चली खे मुसकिल से कनीदुस का सामने पहुच्या, ते येका लिये कि हवा हम खे आगे बडन नी देती थी, हम सलमोने टापु का सामने से हुइ, क्रेते टापु का आड मे चल्यो. <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />अरु ओका किनारा मेसकिल से चली का सुरक्षित हुइ खे हारबोर बंदरगा नामको एक जगा पहुच्या का डोंगा से लसाया नगर पास थो.<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />जब हमने भोत दिन बीती गया, अरु पाणी जत्रा मे जोखिम येका लिये हुइ र्‍हा था, कि उपास का दिन अब बीत चुक्या था, ते पौलुस ने उनखे यो बोलि खे चेतावनी देते हुये यो बोल्यो. <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />“इन्सान, मी देखी र्‍हो हइ कि ह्या से हमारी जत्रा खतरनाक हुये. मालवाहक अरु डोगा खे भोत नुकसान हुये खे अरु साथ ही जान की नुकसान भी हुये.” <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />पन सुबेदार ने कप्तान अरु डोंगा को मालिक की बातहोन खे पौलुस की बातहोन से बडी खे मान्यो. <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />सुरक्षित हारबोर यो बंदरगा ठडी काटन का लिये उ अच्छो नी थो. येका लिये जादा दुन्या ने फीनीक्स पहुचन को ठान्यो अरु फीनीक्स तक पहुचन कि कोशिश करी र्‍हा था, अगर संभव हुये ते क्रेते वहा सर्दिखे बिताना का लिये फीनीक्स दक्षिण-पश्चिम अरु उत्तर-पश्चिम दो का सामने पडस हइ.<verse eid="ACT 27:12" /></para>
  <para style="s">समुद्र मे हवाधुन</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />जब दक्षिणी हवा आन लगी, ते उनने सोच्यो कि उनखे , जेकी जरुरत थी उ उनका पास थी, येका लिये लगर उठायो अरु क्रेते का किनार का डोंगा खे बडान लग्या. <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />पन थोडी देर मे जमीन का तरफ से एक उत्तर पुर्वी आधी कहलाती थी. <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />जब आधी डोंगा से टकर्यीइ डोंगा आधीकरण हम ने कोशिश करणो छोडी दियो, डोंगा हवा का साथ जिधर जानो चाह्यो उधर जान दियो. <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />तब कौदा नामको एक छोटा सा टापू का आड मे बोहा हम मुसकिल से डोंगा खे कब्जा मे करी सक्या. <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />फिर डोंगा चलान आला ओखे उठैइ खे अनेक उपाय करी खे डोगा का नीच्चे से बाध्यो, अरु सुरतिस का रेती पर टिकी जान, डर से पाल अरु सामन उतारी का बोहाते हुया चली गया. <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />जब डोंगा आधी से भोत हिचकी अरु धक्को खायो, ते दूसरा दिन वे डोगा, कुछ माल फेकन लग्या. <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />अरु तीसरा दिन उनने अपना हाथहोन से डोंगा को उपकरण को सामनहोन भी फेकी दियो. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />अरु जब भोत दिन मे सुरज देख्यो नी रात मे तारा दिखइ दिया, अरु बडी हवा आंधी चली र्‍हि थी, ते आखरी मे हमारो बचन की पूरी आस जाती र्‍हि. <figure style="fig" alt="Ship being wrecked in a storm" file="LB00219C.TIF" size="col" copy="Horace Knowles ©" ref="27:18">तुफान मे डोगो नास हुय गयो</figure><verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />जब वे भोत दिन तक भूखा र्‍हि गया, ते पौलुस ने उनका बीच मे खडा हुइ खे बोल्यो, “ हे दुन्या खे अगर क्रेते से रवाना होन कि सला मरी मानी होती अविनाश अरु नुकसान नी होतो. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />लेकिन अब मी तुम खे समझउ हइ कि हिम्मत बाधनु, क्युकि तुम मे से कोय कि जान कि नुकसान नी हुये खे पर फक्त डोंगा की. <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />क्युकि बिती हुइ रात जो परमेश्वर को मी हइ, अरु जेकी आराधना करुस हइ, ओको एक स्वर्गदूत मरा पास आयो. <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />‘हे पौलुस, मत डरनु! तोखे कैसर का सामने खडो होनो जरुरी हइ, अरु देख, परमेश्वर ने सब खे जो तरा साथ जत्रा करी र्‍हो हइ, उनको जिवन तरा साथ दियो हइ.’ <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />येका लियेका हे सज्जनहोन, हिम्मत बाधनु. क्युकि मी परमेश्वर पर विश्वास करुस हइ, कि जसो मरासे बोल्यो गयो हइ, वसो ही हुये. <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />पन हम, कोय टापू पर जैखे टिक्यो नी हुये.”<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />जब चौदहवी रात हुइ, अरु हम भुमध्ये समुदर मे भटकी र्‍हा था, ते आधी रात का पास मल्लाहोन अदाजा से जान्यो कि हम कोय किनारा का पास पहुची र्‍हा हइ. <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />येका लिये उनने येका साथ एक रेखा खे गिर्यय दियो अरु पायो कि पानी चालीस मीटर गैयरो थो. थोडी देर बाद उनने उ कर्यो अरु पायो कि यो तीस मीटर गैयरो थो. <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />तब पत्थरीली जगाहोन पर गीरन का डर से उनने डोंगा की पिछे चार लगर डाल्या, अरु फजर होन की काम ना करता र्‍हिया. <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />पन जब मल्लाह डोगापर से भागनो चाहतो थो, अरु से लगइ से डालन का बहानो डोंगा समुदर मे उतारी दियो. <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />पन पौलुस ने सुबेदार अरु सैनीकहोन से बोल्यो, “अगर यो डोगा पर नी र्‍हियो, ते तुम भी नी बची सक्ये.” <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />तब सैनीकहोन ने दोरीकास काटी खे डोंगा समुदर मे गिर्येइ दी.<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />जब फजर होना पर थी, ते पौलुस ने यो बोली खे सब खे भोजन करण की बिनती करुस हइ “आज चौदाह दिन हुया कि तुम आस देखता-देखता भूखा र्‍हिया, अरु कुछ खानो नी खायो. <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />मी तुम से प्रार्थना करुस हइ, फिर कुछ खानु. जिन्दो र्‍हेन का लिये तुम्ह खे येकी जरुरत हइ, अरु तुम्हारा माथा का बाल भी नी हट्ये.” <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />अरु यो बोलि खे ओने रोटी लि खे सब का सामने परमेश्वर को धन्यवाद कर्यो अरु रोटी तोडी खे खान लग्यो. <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />तब वे सब भी हिम्मत बाधी खे भोजन करण लग्या. <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />हम सब मीलि खे डोंगा मे दो सौ छाहत्तर झन था. <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />जब वे खानो खैइ खे तृप्त हुया, ते गहु खे समुदर मे फेकी खे डोंगा हलको लगन लग्यो.<verse eid="ACT 27:38" /></para>
  <para style="s">डोगा की बरबादी</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />जब दिन नीकल्यो, ते उनने उ देस खे नी पैछान्यो, पन एक खाडी देखी जेको चौरस किनारो थो, अरु बिचार कर्यो कि अगर हुइ सक्ये ते ये पर डोगा खे टेक्ये. <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />तब उनने लंगरहोन खे खोलि खे समुदर मे छोडी दियो अरु उ टेम पतवारहोन को बन्धन खोली दिया, अरु हवा का सामने दुसरो पाल चड्यैइ खे किनार का तरफ चलनु. <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />पर दो समुदर को सगम की जगा पडी खे उनने डोंगा खे टिक्यो अरु डोंगा को अलग हिस्सो ते धक्को खैइ खे गडी गइ, अरु हली नी सकी. पर पिछली लहरहोन का बल से टुटन लगी.<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />तब सैनीकहोन को यो बिचार हुयो कि बन्दिहोन खे मारी डाल. असो नी हो कि कोय तिरी खे नीकली भाग्ये. <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />पन सुबेदार ने पौलुस खे बचन की इच्छा से उनको यो बिचार से रोक्यो, अरु यो बोल्यो, उलट या आज्ञा दी जो तैयारी सकस हइ, ते पैयले कुदि खे तिरी खे किनार पर अरु जमीन पर नीकली जानु. <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />अरु बाकी को पालन करणो थो, तख्तो पर या डोंगा का कुछ टुट्या हुया टुकडा खे पकडी खे अरु येका जसो हम सब खे जमीन पर से मील्यो.<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">माल्टा मे पौलुस को स्वागत</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />जब हम किनारा पर सुरक्षित पहुच्या तब मालुम हुयो की माल्टा टापु हइ. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />अरु वहा का र्‍हेनआलाहोन ने हम पर अनोखी कृपा करी. क्युकि मेंह ओस करण जो बरसी र्‍हियो थो अरु ठडकरण खे उनने अंगार जलैइ खे हम सब खे ठैरायो. <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />जब पौलुस ने लक्कडहोन को गठ्ठो खे अंगार पर रख्यो, ते एक साप ओका पास नीकल्यो अरु ओका हाथ मे गुडय गयो. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />जब वे र्‍हेनआलाहोन ने साप खे ओका हाथ मे लटक्यो हुयो देख्यो, ते आपस मे बोल्या, “सच्ची यो इन्सान खुनी हइ, कि अगर समुंदर से बची गयो, फिर भी न्याय से बची नी पायो.” <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />तब पौलुस साप खे अंगार मे झटकी दियो, अरु ओखे कुछ नुकसान नी पहुच्यो. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />पन वे प्रतीक्षा करी र्‍हा था कि उ सुजी जाये या एको-एक गिरी खे मरी जायेका पन जब वे भोत देर तक देखता र्‍हियो, अरु देख्यो कि असाधारन रुप से ओको कुछ भी नी हुयो, ते उनने बिचार बदली खे बोल्यो, यो तो कोइ “परमेश्वर हइ.”<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />वा जगा का आस-पास पुबलियुस नामको उ टापू को प्रधान कि जमीन थी. ओने हम खे अपना घर ली जैइ खे तीन दिन दोस्ती भाव से स्वागत कर्यो. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />पुबलियुस को बाप तेज बुखार अरु पेचिश से रोगी पड्यो थो, आखरी पौलुस ने ओका पास घर मे जैइ खे प्रार्थना करी खे अरु ओ पर हाथ रखीखे ओखे अच्छो कर्यो. <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />जब असो हुयो, ते उ टापू का बाकी बीमार आया, अरु अच्छो कर्या गया. <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />उनने भोत तरी का से हमारो आदर कर्यो, अरु जब हम चलन लग्या, ते जो कुछ हमारा लिये जरुरी थो, डोगापर रखी दियो.<verse eid="ACT 28:10" /></para>
  <para style="s">माल्टा टापू से रोम का तरफ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />तीन महीना का बाद सिकन्दरिया आया हुया डोगापर चल पड्या अरु यो डोंगा टापू मे ठडी का दिनहोन का कारण रुख्यो हुयो थो उ डोगा को इश्वर बोल्या जातो थो. <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />सुर कूसा शहर मे पहुच्या अरु तीन दिन तक र्‍हिया. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />वहा से हम घुमी खे रेगीयुम मे आया. अरु दुसरा दिन का बाद दक्षिण हवा चली खे तब दूसरा दिन पुतियुली नगर मे आया. <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />वहा हम खे कुछ विश्वासी भैइ मील्या, अरु उनका बोलना से हम उनका ह्या सात दिन तक र्‍हिया. अरु यो रीति से हम रोम खे चल्यो. <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />जब रोमन का र्‍हेनआला भैइहोन खे हमारी सुचना मीली ते वे अप्पियुस को बजार अरु तीन सराय तक हम खे मीलन आया, जिन खे दिखी खे पौलुस ने परमेश्वर को धन्यवाद कर्यो, अरु हिम्मत बाध्यो.<verse eid="ACT 28:15" /></para>
  <para style="s">पौलुस रोम मे</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16" />जब हम रोम मे पहुच्या, ते पौलुस खे एक सैनीक का साथ जो ओकी रखवाली करतो थो, एकलो र्‍हेन की आज्ञा मीली गइ.<figure style="fig" alt="Street scene of The Roman city" file="HK00242C.TIF" size="span" copy="Horace Knowles ©" ref="28:16">रोमन शहर की रस्ता खे देख्यो</figure><verse eid="ACT 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />तीन दिन का बाद ओने यहूदीयाहोन का मुखीयाहो खे बुलायो, अरु जब वे जमा हुया ते उनसे बोल्यो, “हे इस्त्राएली भैइहोन, मेने अपना दुन्या खे या बापदादाहोन की रीतिरीवाजहो का खिलाप मे कुछ भी नी कर्यो, फिर भी मेखे बन्दी बनैइ खे यरुशलेम से रोमीहोन का हात मे दि दिये जाये. <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />उनने मेखे परख्ये खे छोडी देनो चाह्यो, क्युकि मरा मे मरन को योग्य कोय दोष नी थो. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />पन जब यहूदीया येका खिलाप मे बोलन लग्या, फिर मेखे मजबुरी से कैसर से न्याय मागनो पड्यो, येका लिये नी की मे ने अपना दुन्या पर कोय इलजाम लगानु थो. <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />येका लिये मेने तुम खे बुलायो हइ, कि तुम से मील्यु अरु बातचीत कर्यु. क्युकि इस्राएल का दुन्या की आस का लिये मी इन्सान का लिये मी साकल से जकड्यो हुयो हइ.”<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />उनने उनसे बोल्यो, नी हमने तरा बारे मे यहूदीयाहोन से चिठ्ठीहोन पाइ, अरु नी दुन्या ने अय खे तरा बारे मे जानकारी दि, अरु नी बुरो बोल्यो. <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />पन तरो बिचार का हइ? उ हम तरा से सुन्नु चाहस हइ, क्युकि हम जानस हइ<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />तब उनने ओका लिये एक दिन ठैरायो, अरु भोत दुन्या ओका ह्या इकठ्ठा हुया, अरु व्हा परमेश्वर का राज्य की गवइ देते हुये मूसा को नीयम अरु भविष्यव्दक्ताहोन कि किताबहोन से यीशु का बारे मे समझैइ का फजर से संज्जा तक वर्णन करतो र्‍हियो. <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />तब कुछ दुन्या ने वे बातहोन खे मानी लियो, अरु कुछ दुन्या ने विश्वास नी कर्यो. <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />येका लिये वे आपस मे असहमत हुइ गया जब पौलुस ने या बात बोली थी पवित्र आत्मा ने यशायाह भविष्यव्दक्ता का वजेसे पवित्र आत्मा ने बापदादाहोन से कत्ती अच्छी बात बोली थी. <verse eid="ACT 28:25" /><verse number="26" style="v" sid="ACT 28:26" />जइ खे ये दुन्या से बोल</para>
  <para style="q1" vid="ACT 28:26">कि सुनता तो र्‍हियेका पन नी समझ्ये का</para>
  <para style="q1" vid="ACT 28:26">अरु देखता तो र्‍हिये पन तुम खे</para>
  <para style="q2" vid="ACT 28:26">नी दिखैइ दिये,<verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />क्युकि ये दुन्या को मन मोटो,</para>
  <para style="q2" vid="ACT 28:27">अरु उनका भारी हुइ गया हइ,</para>
  <para style="q2" vid="ACT 28:27">अरु उनने अपनी आखहोन बन्द करी हइ,</para>
  <para style="q1" vid="ACT 28:27">असो नी हुये कि वे कभी आखहोन से देख्ये</para>
  <para style="q2" vid="ACT 28:27">अरु कान होन से सुन्या,</para>
  <para style="q2" vid="ACT 28:27">अरु मन से समझ्ये</para>
  <para style="q1" vid="ACT 28:27">अरु मरा तरफ फिर्ये</para>
  <para style="q2" vid="ACT 28:27">अरु मी उनका अच्छो कर्यु.<verse eid="ACT 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28" />अरु पौलुस ने या बात से येको समापन कर्यो “की तुम जानी लेनो हुनू की परमेश्वर को यो उध्दार को संदेश गैरयहूदिहोन का पास भेजी दियो या वे येखे सुन्ये.”<verse eid="ACT 28:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 28:29" />जब ओने यो बोल्यो ते यहूदीया आपस मे भोत वाद विवाद करण लग्या अरु वहा से चली गया.<verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />अरु पौलुस पूरा दो साल अपना किराया का घर मे र्‍हियो अरु जो ओका पास आता था, वे सब को स्वागत करतो थो. <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />अरु पुरा हिम्मत से स्वतत्रता से परमेश्वर को राज्य को प्रचार करतो अरु प्रभु यीशु मसीह का बारे मे सिखातो र्‍हियो.<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>