<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="COL" style="id">cOL - Gowlan</book>
  <para style="h">कुलुस्सियो</para>
  <para style="toc3">कुलुस्सियो</para>
  <para style="toc2">कुलुस्सियो</para>
  <para style="toc1">कुलुस्सियहोन का नाम पौलुस प्रेरित की चिठ्ठी</para>
  <para style="mt2">कुलुस्सियो खे नाम पौलुस प्रेरित की चिठ्ठी</para>
  <para style="mt1">कुलुस्सियहोन का नाम पौलुस प्रेरित की चिठ्ठी</para>
  <para style="imt">पैछान</para>
  <para style="ip">कुलुस्सियहोन का नाम पौलुस चिठ्ठी <char style="xt"><ref loc="COL 1:1">1:1</ref></char> वजेसे लिखी गय थी. जब उ अंदर था तब उने चिठ्ठी लिखी यीशु मसीह को जन्म का नजिकपास 60 साल बाद संभव रोम मे बन्दी. कुलुस्सिहोन, इफिसिहोन का साथ मीलिखे अरु फिलेमोन को बन्दी मे र्हेतो हुये लिख्यो थो. उन ने लिख्यो कुलुस्से शहर का च खे चिठ्ठी. पौलुस ने कुलुस्से मे मंडली कि सुरुवात नी की, जसो कि ओने उल्लख कर्योस हइ <char style="xt"><ref loc="COL 2:1">2:1</ref></char> लेकिन येका लिये कुछ जिम्मेदारी महसुस करी हुये. ह्या संभव हइ कि इपफ्रास ने तब से मंडली कि स्थापना करी हुये व्हा कुलुस्से से थो.</para>
  <para style="ip">पौलुस कुलुस्से कि मंडली मे कुछ झुटी शिक्षाहोन से चिन्ता मे था. उनने चिठ्ठी का अधिकांश भाग खर्चो कर्यो येका बारे मे लिखी रोस हय. हुय सकस हइ कि यहूदी मसीहोन का एक झुंड र्हियो हय जो दोसरा पद दबाव डालन कि कोशिश करी रास मसीहोन को जुन्नो नीयम को यहूदी कानून को पालन करणो चाहस, विशषेकरी खे खतनो. पौलुस लिखस हइ विशेष रुप से मसीहोन खे प्रभु व्दरा स्वीकारी लियो जान का लिये मसीह का बजाय कोय अरु चिज कि जरुरी नी हइ <char style="xt"><ref loc="COL 1:15-20">1:15-20</ref></char> अरु मानविय तर्क पर नीरभर शिक्षाहोन बेकार हइ <char style="xt"><ref loc="COL 2:8">2:8</ref> </char>.</para>
  <para style="iot">रुप रेखा</para>
  <para style="io1">1. पौलुस ने चिठ्ठी कि सुरुर्वात कुलुस्से मे मंडली खे प्रनाम करीखे कि <char style="ior"><ref loc="COL 1:1-2">1:1-2</ref> </char> .</para>
  <para style="io1">2. फिर व्हा विशेष रुप से झूटी शिक्षा को जवाब मे मसीह की बडाइ का बारे मे लिखतो हइ कुलुस्से <char style="ior"><ref loc="COL 1:3-3:4">1:3—3:4</ref> </char> .</para>
  <para style="io1">3. जसो कि पौलुस का कोय चिठ्ठी मे होतो हुये खे व्हा चिठ्ठी को उत्तर कुछ काम की बात बताना मे बितास हइ अच्छो खानोबना वाला को जीवन का लिए नीर्देश <char style="ior"><ref loc="COL 3:5-4:6">3:5—4:6</ref> </char> .</para>
  <para style="io1">4. पौलुस ने चिठ्ठी खे दुसरा मंडली मे जोर से पढन जान का लिए अभिवादन अरु नीर्देशो का साथ खतम कर्यो <char style="ior"><ref loc="COL 4:7-18">4:7-18</ref></char></para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="s">अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />पौलुस का तरप से जो परमेश्वर कि इच्छा से मसीह यीशु को प्रेरित हइ, अरु भैइ ती तीमुथियुस का तरप से, <verse eid="COL 1:1" /><verse number="2" style="v" sid="COL 1:2" />मसीह मे वे पवित्र अरु विश्वासी भैइहोन को नाम जो कुलुस्से मे ऱ्हेस हइ</para>
  <para style="p" vid="COL 1:2">हमारो बाप परमेश्वर का तरप से तुमखे अनुग्रह अरु शांती मीलती होती र्‍हिये.<verse eid="COL 1:2" /></para>
  <para style="s">धन्यवाद की प्रार्थना</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />हम तुम्हारा लिये सदा प्रार्थना करीखे अपनो प्रभु यीशु मसीह को बाप यानी परमेश्वर को धन्यवाद करस हइ, <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />क्युकि हम ने सुन्यो हइ कि मसीह यीशु पर तुमारो विश्वास हइ, अरु सब पवित्र दुन्याहोन से तुम प्रेम रखस हय. <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />वा आस कि चिज को करण जो तुमारा लिये स्वर्ग मे रखी हुयो हइ, जेको वर्णन तुम उ सुसमाचार कि सच्चो वचन मे सुनी चुक्यो हय, <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />जो तुमारा पास पहुच्यो हइ, अरु जसो संसार मे भी फल लास अरु बडते जास हइ, वोसो य जो दिन से तुम ने ओको सुन्यो अरु सच्ची से परमेश्वर को अनुग्रह पहिचाननो हइ, तुम मे भी असो य करस हइ. <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" />ओकि शिक्षा तुम ने हमारा प्रिय सहकर्मी इपफ्रास से मील्यो, जो हमारो लिये मसीह को विश्वासयोग्य सेवक हइ.<note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="COL 4:12">कुलुस्सियो 4:12</ref>; <ref loc="PHM 1:23">फिलेमोन 23</ref> </char></note> <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />ओ ने तुम्हारो प्रेम कि जो आत्मा मे हइ हमारा पर प्रगट कऱ्यो.<verse eid="COL 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9" />येका लिये जो दिन से यो सुन्यो हइ, हम भि तुम्हारा लिये यो प्रार्थना अरु प्रार्थना करणो नी छोडुस कि तुमने सब आत्मीक ज्ञान अरु समझ सहित परमेश्वर कि इच्छा कि पैछान मे परिपुर्ण हुय जाव. <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />ताकि तुम्हारो चल-चलन प्रभु, योग्य हय अरु वे सब प्रकार से प्रसन्न हुये, अरु तुम से हर प्रकार का भला काम का फल लगह्ये, अरु तुम परमेश्वर की पैछान मे बडते जाव. <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />ओकी महीमा की शक्ति का जसो सब प्रकार को सामर्थ्य से ताकत होते जाये, ह्या तक कि आनन्द, साथ हर प्रकार से धीरज अरु सहनशीलता देखी सक्यो. <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />अरु बाप को धन्यवाद करता रिये, जेने हमके यो योग्य बनायो कि दिवो मे पवित्र लोग का साथ मीरास मे शामील हुये. <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />ओ ने हम खे अन्धर का कुल से छुडाये लिखे प्रिय बेटा का राज्य मे प्रवेश करायो. <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" />जे मे हमखे छुटकारो मंनजे पाप कि माफी मीलस हइ.<note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="EPH 1:7">इपिसियो 1:7</ref></char></note><verse eid="COL 1:14" /></para>
  <para style="s">मसीह की श्रेष्ठता</para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15" />व्हा तो अदृश्य परमेश्वर को प्रतीरुप अरु सब सृष्टि मे पयलो हइ. <verse eid="COL 1:15" /><verse number="16" style="v" sid="COL 1:16" />क्युकि ओ मे सब चिजहोन की सृष्टि हुय, स्वर्ग कि हय अथवा पृथ्वी की, देख्यो यो बिनादेख्यो, राजगद्दी, प्रभुताहोन, अधिकार, सब चिजहोन ओका वजेसे अरु ओका लिये सृजी गय हइ, <verse eid="COL 1:16" /><verse number="17" style="v" sid="COL 1:17" />व्हा सब चिजहोन मे पयलो हइ अरु सब चिजहोन वो मे रुख्यो र्‍हेती थी. <verse eid="COL 1:17" /><verse number="18" style="v" sid="COL 1:18" />उ आंग का मंनजे मंडली को माथो हइ. व्हा अगर हइ, अरु मर्‍यो हुयो मे से जिन्दो उठनआला मे पयलो कि सब बात मे व्हा प्रधान रोख्ये.<note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="EPH 1:22-23">इपिसियो 1:22-23</ref> </char></note> <verse eid="COL 1:18" /><verse number="19" style="v" sid="COL 1:19" />क्युकि बाप कि प्रसन्नता ये मे हइ कि ओमे सब परिपूर्णता से वास कऱ्हु, <verse eid="COL 1:19" /><verse number="20" style="v" sid="COL 1:20" />अरु ओका क्रुस पर बोहायो हुयो खुन खे वजेसे मीलिजुलीखे करीखे, सब चिजहोन, ओका वजेसे से अपना सात मीली खे ली, समजो वे पृथ्वी पर की हुये चाह्ये स्वर्ग मे की.<verse eid="COL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 1:21" />तुम जो पैयले बुरा काम करण मन से दुर था. <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />ओने आब ओका शारीरिक आंग मे मरना का वजेसे तुमरो भी मीली लियो जबकी तुमखे अपना समने पवित्र अरु नीष्कलंक, अरु नीर्दोश बनयखे हजीर कर. <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />अगर तुम विश्वास को पय्या पर पक्को बन्यो र्‍हिये अरु उ सुसमाचार कि आस खे जो तुम ने सुन्यो हइ नी छोड, जिनको प्रचार बद्दल का नीच्चे की सब सृष्टि मे कर्‍यो गयो, अरु जेको मी, पौलुस, सेवक बन्यो<verse eid="COL 1:23" /></para>
  <para style="s">पौलुस मंडली को सेवक</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />अब मी वे दुख को करण खुसी करस हय, जो तुम्हारा लिये उठस हय अरु मसीह कि पिडा कि कमी ओका आंग का लिये, मंनजे मंडली का लिये, अपनो आंग मे पुरो करस हय. <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />जिनको मी परमेश्वर को उ प्रबन्ध का जसो सेवक बन जो तुमारा लिये मेखे दियो गयो जबकी मी परमेश्वर को वचन खे पुरो प्रचार कर्‍हु. <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />मंनजे उ भेद खे जो टेमहोन अरु पिडीसे लुकयखे र्‍हियो, पन आब उनको वे पवित्र दुन्या पर प्रगट हुयोस हइ. <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />जिन पर परमेश्वर ने प्रगट करणो चाह्यो कि उनने समज्यो कि गैरयहूदीहोन मे वा भेद कि महिमा को मोल हुये खे हइ, अरु व्हा यो हइ कि मसीह जो महीमा कि आस हइ तुमारा मे र्‍हेस हइ <verse eid="COL 1:27" /><verse number="28" style="v" sid="COL 1:28" />जिनको प्रचार करी खे हम हर एक इन्सान खे सिखास हइ कि हम हर एक इन्सान खे मसीह मी सिध्द करीखे उपस्थित कर्‍हे. <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />येका य लिये मी ओकी वा शक्ति का जसो जो मेखे सामर्थ्य का सात प्रभाव डलतो हइ, तन मन लगयखे अराम भी करस हय.<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />मी चाहुस कि तुम समजी ले कि तुम्हारो अरु उनका लिये जो लौदिकिया मे हइ, अरु वे सब का लिये जिनने मरो आंग मुडो नी देख्यो, मी कसो अराम करस हय, <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />जबकी उनको मन मे शांती हइ अरु वे प्रेम से आपस मे जुडी खे र्‍हिया, अरु वे पुरो समज को सब धन हासील कर्‍ह्ये अरु परमेश्वर बाप को भेद खे मंनजे मसीह खे पहीछानी लिये. <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />जिनमे डिमाक अरु समज को सब धन भण्डार लुक्या हुयो हइ.<verse eid="COL 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="COL 2:4" />यो मी येका लिये बोली रोस हय कि कोय इनसान तुमखे झुटी तरीका कि बात से धोको नी दे. <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />अगर मी आंग का रुप से नी तुमारा से दुर हय, तेभी आत्मीक भाव से तुम्हारा नजिक हय, अरु तुम्हारो बराबर जिवन खे अरु तुम्हारो विश्वास की, जो मसीह मे हइ, दृढता देखीखे खुश होस हय.<verse eid="COL 2:5" /></para>
  <para style="s">मसीह मे जिवन कि भरपुरी</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />आखरी जसो तुम ने मसीह यीशु खे प्रभु करीखे ग्रहण करी लियो हइ, वोसोय वोमे चलास र्‍हेव. <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />अरु ओमे य जडी पकडते अरु बडते जाव. अरु जसौ तुम सिखायो गयो अरु ओसो य विश्वास मे दृढ होते जाव, अरु जादा से जादा धन्यवाद करते र्‍हेव. <verse eid="COL 2:7" /><verse number="8" style="v" sid="COL 2:8" />हुशार र्‍हेव कि कोय तुमखे उ तत्व ज्ञान अरु व्यर्थ धोका वजेसे अपनो अहेर नी बनय ले, जो इन्सान की रितीरिवाज अरु जगत की सब पयली शिक्षा का जसो तो हइ, पर मसीह को जसो नी. <verse eid="COL 2:8" /><verse number="9" style="v" sid="COL 2:9" />क्युकि ओमे परमेश्वर कि सब परिपूर्णता आंग वास करस हइ. <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />अरु तुम ओमे भरपुर हुय गयो हय जो सब प्रधानता अरु अधिकार को शिरोमणी हइ. <verse eid="COL 2:10" /><verse number="11" style="v" sid="COL 2:11" />ओमे तुम्हरो असो खतनो हुयो हइ जो हात से नी होय, मंनजे मसीह को खातनो, आंग उतार दीयो जास हइ, <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" />अरु ओका सात बपतिस्मा मे गाड्यो गयो अरु ओमे य परमेश्वर की सामर्थ्य पर विश्वास करीखे, जिन खे मर्‍यो हुया मे से जिन्दो, ओका सात जिन्दो भी हुयो. <verse eid="COL 2:12" /><verse number="13" style="v" sid="COL 2:13" />ओने तुम्हारो भी, जो अपराधहोन अरु अपना आंग की खतनहित दशा मुर्दो थो, ओका सात जिन्दो, अरु हमरो सब अपराधहोन माफ कऱ्यो, <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" />अरु विधीहोन की जो व्हा लिख्यो जो हमरो नाम पर अरु खिलाप मे थो मीटकय दिया, अरु ओखे क्रुस पर खिल्ला से जडकय सामने से बाजु करी दियो हइ. <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />अरु ओने प्रधानहोन अरु अधिकार का उपर से उतरीखे उनको खुल्लमखूल्ला नाटक बनायो अरु क्रुस का वजेसे उन पर जय जयकार की आवाज सुनी.<verse eid="COL 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16" />येका लिये खान पिन का पैयले यो नवो चाद अरु अराम का बारे मे तुमारो कोय फैसलो नी कर्‍हे. <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />क्युकि ये सब आनआली सब बात कि छाय हइ, पर किमती चिज मसीह कि हइ. <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />कोय इन्सान आत्मा हिनता अरु स्वर्गदूतहोन की पुजा करीखे हुयो दौडी खे प्रतीफल से बाहेर नी करु. इन्सान देख्यो हुयो बात मे लग्यो र्‍हेस हइ अरु अपना शारीरिक समज पर व्यर्थ फुलस हइ, <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" />अरु उये शिरोमणी खे पकडन को नी र्‍हेतो जेकासे सब आंग अरु पट्टा का वजेसे पालन पोसन मीलिखे अरु एक सात मीलीखे, परमेश्वर कि तरप से बडते जास हइ.<verse eid="COL 2:19" /></para>
  <para style="s">मसीह को सात मरनो अरु जिनो</para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />जब कि तुम मसीह का सब जगत कि पयली शिक्षा का तरप से मरी गया हय, ते फिर का उनका सामने जो जगत को हइ जिवन बितस हय? तुम असो विधीहोन का बस मे कायबर ऱ्हेस हय, <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />कि यो नी पकड्यो, ओखे नी चाट्यो, अरु ओखे हात नी लगानु? <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />यो सब चिजहोन काम मे लाते खतम हुय जाह्ये क्युकि ये इन्सान की आज्ञाहोन अरु शिक्षाहोन का जसो हइ. <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />या विधीहोन मे या इच्छा का जसो गडी वालि भक्ति कि रीति, अरु आत्मा हीनता, अरु शारीरीक योगभास को भाव से ज्ञान को नाम तो हइ, पन आंग लालुचहोन खे रोखना मे येका से कुच भी फायदो नी होतो.<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />आखरी मे जब मसीह का सात जिन्दो कर्‍यो गयो, ते स्वर्गीय चिजहोन कि ढुडना मे र्‍हेव जहा मसीह विघमान हइ अरु परमेश्वर का जवना तरप बठ्योस हइ. <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />जमीन पर की नी पन स्वर्गीय चिजहोन पर ध्यान लगाव, <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />क्युकि तुम तो मरी गया अरु तुमारो जिवन मसीह का सात परमेश्वर मे लुक्यो हुयो हइ. <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />जब मसीह जो हमारो जिवन हइ, प्रगट हुये तब तुम भी ओका सात महिमा सहित प्रगट कह्ये जाह्ये.<verse eid="COL 3:4" /></para>
  <para style="s">जुन्नो जिवन अरु नवो जिवन</para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />येकालिये अपनो वे आंग खे मारी डाल्हे जो पृथ्वी पर हइ, मनजे व्यभिचार, अच्छो, दुष्कामना, बुरी लालुच अरु लोभी खे जो मूर्तिपुजा का बराबर हइ. <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />येका कारण परमेश्वर को घुस्सा आज्ञा नी माननवाला पर पडस हइ. <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />अरु तुम भी, जब या बुराय मे जिवन बिताता था ते इनका अनुसार चलस हइ.<verse eid="COL 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 3:8" />पर अब तुम भी या सब खे, मंनजे घुस्सा, रोस, दुजाभाव, टिंगल अरु मुडा से गाली नीकलनो या सब बात छोडी दे. <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" />एक दुसरा से झुटी मत बोलनू, क्युकि तुमने जुन्ना इन्सान खे ओका काम का सात मे उतारी दियोस हइ. <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" />अरु नवो इन्सान खे पेनी लियो हइ, जो अपनो सृजनहार का रुप का अनुसार ज्ञान मील्हे करण का लिये नवो बनायो जास हइ. <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />ओमे नी ते यूनानी मे र्‍हियो नी यहूदी, खतना नी खतनरहित, नी जंगली, नी स्कूती सेवक अरु मसीह सब मे हइ.<verse eid="COL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12" />येकालिये परमेश्वर को चुन्यो हुयो का जसो जो पवित्र अरु प्रिय हइ, जो बडि दया, अरु अच्छो ,अरु दिनता, अरु नम्रता, अरु सहनसीलता खे पेन्या कर, <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" />अरु अगर कोय पर कोय खे दोस देन को कारण हुये, ते एक दुसरा की सहि ले अरु एक दुसरा को अपराध माफ कर. जसो प्रभु ने तुमारो अपराध माफ कर्‍यो, वसो तुम भी कर. <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />यो सब का उपर प्रेम को जो सिध्दन्ता को कटिबन्ध हइ बाधी ले. <verse eid="COL 3:14" /><verse number="15" style="v" sid="COL 3:15" />मसीह की शांती जेका लिये तुम एक आंग हुयखे बुलायो भी हइ, तुमारा प्रेम मे राज कर्‍हे अरु तुम धन्यवादी बन्यो र्‍हेव. <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" />मसीह को वचन को खुद प्रेम मे जादासे से र्‍हेन दे अरु सिध्द ज्ञान सहीत एक दुसरा खे सिकाव अरु बताव, अरु अपना मन मे महिमा का सात परमेश्वर का लिये भजन अरु स्तुतिगिद अरु आत्मीक गिद गा. <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />वचन मे यो काम मे जो कुछ भी कर सब प्रभु यीशु को नाम से कर, अरु ओका वजेसे परमेश्वर बाप को धन्यवाद कर.<verse eid="COL 3:17" /></para>
  <para style="s">नवो जिवन को परिवारि को नीयम</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />हे लुगयहोन,जसो प्रभु मे अच्छी हइ, वसो य अपना अपना अदमी का अधीन र्‍हेव.<verse eid="COL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="COL 3:19" />हे इन्सानहोन, अपनी अपनी लुगय से प्रेम रख, अरु उनसे कठुर मत कर.<verse eid="COL 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 3:20" />हे बच्चाहोन, सब बात मे अपना माय बाप की आज्ञा को पालन कर, क्युकि प्रभु येमे खुस होस हइ.<verse eid="COL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 3:21" />हे बच्चाआला, अपना बच्चाहोन खे तंग नी करणू नी हय कि उनको साहस टुटी जाह्ये.<verse eid="COL 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="COL 3:22" />हे सेवकहोन, जो आंग का अनुसार तुमारो स्वामी हइ, सब बात मे उनकी आज्ञा को पालन कर, इन्सान खे खुस करणआला का जसो दिखान का लिये नी,पन मन की सीधाइ अरु परमेश्वर को डर से. <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />जो कुच तुम करस हय, तन मन से कर, यो समझी खे कि इन्सान का लिये नी पन प्रभु का लिये करस हय. <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />का तुम मलुम हय कि तुमखे येका बदला प्रभु से मीरास मील्हे. तुम प्रभु मसीह कि सेवा करस हय. <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" />क्युकि जो बुरो करस हइ व्हा अपनी बुरोय को फल मील्हे, व्हा कोय को पछतावो नी.<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />हे स्वामीहोन खे अपनो सेवक का सात न्यान अरु ठिक ठीक व्यवहार कर,यो समझी खे कि स्वर्ग मे तुमारो भी एक स्वामी हइ.<verse eid="COL 4:1" /></para>
  <para style="s">कुच व्यवहारकी सला</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />प्रार्थना मे लग्यो र्‍हेव, अरु धन्यवाद, सात ओ मे जागा र्‍हेव. <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />अरु सात ही सात हमारा लिये प्रार्थना सुनन को असो दरवाजो खोली दे, कि परमेश्वर हम मसीह को वु भेद को वर्णन करी सकस जेको कारन मी कैदी मे हय, <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />अरु ओखे असो प्रगट करु, जसो मेखे करणो अच्छो हइ. <verse eid="COL 4:4" /><verse number="5" style="v" sid="COL 4:5" />अवसर खे किमती समजीखे बाहेरवाला, सात दिमाकआला से व्यवहार कर. <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />तुमारो वचन सदा अनुग्रह सहीत अरु सलोनो हय कि तुम हर इन्सान खे अच्छी रीति से उत्तर देनो अय जाह्ये.<verse eid="COL 4:6" /></para>
  <para style="s">आखरी अभिवादन</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />प्रिय भैइ अरु विश्वासयोग्य सेवक, तुखिकुस, जो प्रभु मे मरो सहकर्मी हइ, मरी सब बात तुमखे बतय दिव. <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />ओखे मे ने येका लिये तुमारा पास भेज्यो हइ कि तुमखे हमारी बात मालुम हुय जाह्ये अरु व्हा तुमारा दिल खे शांती दे. <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" />उनका सात मे ने उनेसिमुस खे भी भेज्यो हइ जो विश्वासयोग्य अरु प्रिय भैइ अरु तुम ही मेसे हइ. या तुमखे ह्या की सब बात बतय दिह्ये.<verse eid="COL 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10" />अरिस्तर्खुस, जो मरा सात जेल मे हइ, अरु मरकुस जो बरनबास को भैइलगास हइ जेका बारे मे तुमने आज्ञा मीली थी कि अगर व्हा तुमारा पास आया, ते ओकासे अच्छा से व्यवहार करणु , <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />अरु यीशु जो यूस्तुस बोल्यो जास हइ, तुमखे नमस्कार बोल्योस हइ. खतना कर्‍यो हुयो दुन्या मे से फक्कत यो य परमेश्वर का राज्य का लिये मरो सहकर्मी अरु शांती को करण र्‍हीयो हइ.<verse eid="COL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 4:12" />इपफ्रास, जो तुम परमेश्वर मे से हइ अरु मसीह यीशु को सेवक हइ, <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />मी ओको गवइ हइ कि व्हा तुमारा लिये अरु लौदिकिया अरु हियारापुलिस आलो, लिये बडो काम करतो र्‍हेस हइ. <verse eid="COL 4:13" /><verse number="14" style="v" sid="COL 4:14" />प्रिय डाॅकटर लुका, अरु देमास खे तुमारो नमस्कार.<verse eid="COL 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 4:15" />लौदिकिया का भैइखे, अरु नुम्‍फा अरु उनका घर की मंडली खे नमस्कार बोलनू. <verse eid="COL 4:15" /><verse number="16" style="v" sid="COL 4:16" />जब यो बेटो तुम्हारा ह्या पडी लियो जाह्‍येका अरु व्हा चिट्ठी जो लौदिकिया से आह्ये ओखे तुम भी पडनू <verse eid="COL 4:16" /><verse number="17" style="v" sid="COL 4:17" />अरु अरखिप्पुस से बोलनू कि जो सेवा प्रभु मे तुमखे सौपिदी गय हइ, ओखे सावधानी का सात पुरो करणू.<verse eid="COL 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18" />मेखे पौलुस को अपना हात से लिख्यो हुयो नमस्कार. मरी हतकडी खे याद रखनु.</para>
  <para style="p" vid="COL 4:18">तुमारा पर अनुग्रह होतो र्‍हे.<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>