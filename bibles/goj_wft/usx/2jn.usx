<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Gowlan</book>
  <para style="h">2 यहून्ना</para>
  <para style="toc3">2 यूहन्ना</para>
  <para style="toc2">2 यूहन्ना</para>
  <para style="toc1">2 यूहन्ना की चिठ्ठी पैछान</para>
  <para style="mt2">2 यहून्ना की चिठ्ठी</para>
  <para style="mt1">2 यहून्ना की चिठ्ठी</para>
  <para style="imt">पैछान</para>
  <para style="ip">1 यहून्ना की दूसरी चिठ्ठी मसीह का जन्म का बाद 50 अरु 100 साल का बीच प्रेरित यहून्ना ने लिखी थी. यहून्ना खुद की लेखक का रुप मे पइछान नी हइ येका बजाय उ खुद को बडो बोलस. यहून्ना कि सामग्री जसो दिखस हइ. यो विशेष रुप मे तरह से उ यीशु का आदेश पर जोर देस हइ स्पष्ट हइ एक दूसरा से प्रेम हइ जो तरह अपना आदेश नींमलिखित <char style="xt"><ref loc="2JN 1:5-6">1:5-6</ref></char> <char style="xt"><ref loc="JHN 15:9-10">यहून्ना 15:9-10</ref> </char> का साथ प्रेम यीशु समानता मे असो मान्यो जास हइ कि यहून्ना का जसो सुसमाचार लिख्यो थो यहून्ना अरु तीन चिठ्ठी 1 यहून्ना 2 यहून्ना 3 यहून्ना जबकी इफिसुस मे र्‍हेस हइ.</para>
  <para style="ip">यहून्ना ने या चिठ्ठी, “चुनी हुइ स्री अरु ओका बच्चाहोन.” को संबोधित कर्यो. उ संभावता एक चर्च खे जिक्र कर्यो गया थो. या चिट्ठी का लिखना मे यहून्ना को उद्देश्य चर्च खे प्रोत्साहित करणो अरु उनने झूठा मास्तर की चेतावनी देनो थो. रुपरेखा यहून्ना यो बोलस हइ कि येका लिये हइ अरु ओखे मील्हे कर्ताहोन</para>
  <para style="iot">रुप रेखा</para>
  <para style="io1">1. यहून्ना ने चिठ्ठी कि पैछान यो बोलिखे दियो कि येका लिये हइ अरु येखे मील्हे कर्ता खे अभिवादन करस <char style="ior"><ref loc="2JN 1:1-3">1:1-3</ref> </char></para>
  <para style="io1">2. फिर वा चर्च खे प्रोत्साहित करस हइ अरु उनखे सबसे बडी आज्ञा कि याद दिलास हइ <char style="ior"><ref loc="2JN 1:4-6">1:4-6</ref> </char></para>
  <para style="io1">3. येका बाद उ वे झुठा शिक्षकहोन का बारे मे चेतावनी देस हइ <char style="ior"><ref loc="2JN 1:7-11">1:7-11</ref></char></para>
  <para style="io1">4. यहून्ना जो चर्च मे हइ वहा का विश्वासिहोन खे शुभकामना दिखे अपनी चिठ्ठी खतम करस हइ <char style="ior"><ref loc="2JN 1:12-13">1:12-13</ref></char></para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1"/>मेखे बुजरुक का तरफ से वा चुनी हुइ बय अरु ओका बच्चाहोन को नाम जेका से मी सच्चो प्रेम रखुस,</para>
  <para style="p" vid="2JN 1:1">अरु फक्त मी नी क्युकी वे सब भी प्रेम रखस हइ जो सच्चीखे जानस हइ. <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>वा सच्ची जो हमारा मे स्थिर र्‍हेस हइ अरु हमेशा हमारा साथ र्‍हिये.<verse eid="2JN 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3"/>परमेश्वर बाप अरु बाप को बेटो यीशु मसीह का तरफ से अनुग्रह अरु दया अरु शांती सच्चीचाइ अरु प्रेम सहित हमारा साथ र्‍हिये.<verse eid="2JN 1:3"/></para>
  <para style="s">सच्चीचाइ अरु प्रेम</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>मी भोत खुश हुयो कि मे ने तरा कुछ बच्चाहोन खे वा आज्ञा का जसो हम खे बाप का तरफ से मीली थी सच्चीचाइ पर चलता हुये पायो. <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/>अब हे प्रिय बय, मी तोखे कोय नइ आज्ञा नी पर उ जो पइले से मीली हइ मी तुम खे एक दुसरा से प्रेम करण का लिये हमारा पास हइ, लिखुस हइ. अरु तरा से प्रार्थना करुस हइ कि हम एक दुसरा से प्रेम रखस<note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="JHN 13:34">यहून्ना 13:34</ref>; <ref loc="JHN 15:12">15:12</ref>; <ref loc="JHN 17">17</ref></char></note>. <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>अरु प्रेम यो हइ कि हम ओकि आज्ञाहोन का जसो चलनु. या वा आज्ञा हइ जो तुमने पइले से सुन्यो हइ अरु तुमखे येका पर प्रेम पूर्वक जिवन जीन हुनु.<verse eid="2JN 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7"/>क्युकि भोत सा असो भरमान आला संसार मे नीकली आया हइ कि उ यो नी माने कि यीशु मसीह आंग मे हुइ खे आयो भरमान आलो दुन्या अरु मसीह को विरोधी योही हइ. <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>अपना बारे मे चौकन्या र्‍हिये कि जो परिश्रम हमने कर्यो हइ ओकी तुम गवइ नी देनु, क्युकी ओको पूरो प्रतीफल पानु.<verse eid="2JN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9"/>जो कोय मसीह कि शिक्षा से आगे बडी जास हइ अरु ओमे बन्यो नी र्‍हे, ओका पास परमेश्वर नी जो कोय ओकि सजा मे स्थिर र्हेस हइ ओका पास बाप भी हइ अरु बेटो भी. <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>अगर कोय तुम्हारा पास आह्ये अरु योही सजा नी दे ओखे न ते घर मे आन दे अरु न नमस्कार करणु. <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>क्युकि जो कोय असा झन के अभिवादन करस हइ उ ओका बुरा काम होन मे हिस्सेदार होस हइ.<verse eid="2JN 1:11"/></para>
  <para style="s">आखरी बोल</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>मेखे भोत सी बातहोन तुमखे लिखनु हइ पर कागज अरु सइ से लिखनु नी चाहु पर आस हइ कि मी तुम्हारा पास आयु अरु आमने-सामने बातचीत कर्यू जेका से तुम पूरी तरह से खुश हुये.<verse eid="2JN 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13"/>ओका मंडली कि एक चुनी हुइ बय का बच्चा का तरफ से तोखे नमस्कार करुस हइ.<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
