<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Gowlan</book>
  <para style="h">3यहून्ना</para>
  <para style="toc3">3 यूहन्ना</para>
  <para style="toc2">3 यूहन्ना</para>
  <para style="toc1">3 यूहन्ना की चिठ्ठी</para>
  <para style="mt2">3 यहून्ना की चिठ्ठी</para>
  <para style="mt1">3 यहून्ना की चिठ्ठी</para>
  <para style="imt">पैछान</para>
  <para style="ip">यहून्ना कि चिठ्ठी मसीह को जन्म का बाद ५० अरु १०० साल का बीच प्रेरित यहून्ना ने लिखी थी. यहून्ना खुद का लेखक का रुप मे पैछान नी हइ, लेकिन येका बजाय खुद खे बडो <char style="xt"><ref loc="3JN 1:1">1:1</ref></char> बोलस हइ. उ 2 यहून्ना <char style="xt"><ref loc="3JN 1:1">1:1</ref></char> मे उ करस हइ. असो मान्यो जास हइ कि यहून्ना का जसो सुसमाचार लिखी थी यहून्ना अरु तीन चिठ्ठी 1 यहून्ना, 2 यहून्ना, अरु 3 यहून्ना जबकी इफिसुस मे र्‍हेस हइ.</para>
  <para style="ip">यहून्ना ने गयुस नाम को एक नास्तिक खे या चिठ्ठी लिखी थी. उ एक दोस्त का रुप मे गयुस अरु नीर्दोश ओखे ख्रिस्थी भैइहोन जो देस हइ माध्यम से जत्रा करी र्‍हा हइ मीजवानी हुये.</para>
  <para style="iot">रुप रेखा</para>
  <para style="io1">1. यहून्ना ने अपनी चिठ्ठी किताब करी <char style="ior"><ref loc="3JN 1:1">1:1</ref> </char></para>
  <para style="io1">2. फिर उ गयुस खे प्रोस्ताहिट करस हइ अरु ओखे भइहोन खे आतिथ्य सत्कार करण को नीर्देश देस हइ <char style="ior"><ref loc="3JN 1:2-8">1:2-8</ref> </char></para>
  <para style="io1">3. येका बाद उ दो हर इन्सानहोन खे दियुत्रिफेस अरु डेमेट्रियस का बारे मे बाट करस हइ <char style="ior"><ref loc="3JN 1:9-12">1:9-12</ref></char></para>
  <para style="io1">4. आखरी मे उनने अपनी चिठ्ठी खतम करी <char style="ior"><ref loc="3JN 1:13-14">1:13-14</ref></char></para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />बुजरुक यहून्ना का तरफ से</para>
  <para style="p" vid="3JN 1:1">प्रिय गयुस का नाम जेका से मी सच्चो प्रेम रखुस हइ<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="ACT 19:29">प्रेरित 19:29</ref>; <ref loc="ACT 16:23">16:23</ref>; <ref loc="1CO 1:14">1 कुरिन्थिहोन 1:14</ref></char></note>.<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />हे प्रिय दोस्त, काम मरी या प्रार्थना हइ कि जसो तु आत्मीक मन से उन्नती करी रो हइ, ओसो तु सब बातहोन मे उन्नती कर अरु भलो अच्छो र्‍हे. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />क्युकि जब अपना भैइ ने अय, तरी वा सच्चीचाइ कि गवइ दी जेका पर तु सच्ची मे चलस हइ ते मी भोत खुश हुयो. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />मेखे येका से जादा अरु कोय खुश नी कि मी सुनीखे मरा बच्चा सच्चीचाइ का रस्ता पर चलस हइ.<verse eid="3JN 1:4" /></para>
  <para style="s">गयुस की बड्यी</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />हे प्रिय, दोस्तहोन जो तुम विश्वास योग्यता को कार्य जो मसीह भैइहोन का लिये करस हइ, ओमे विश्वास योग्य हुये जब कि वे तुम्हारा लिये बिना समजे हइ. <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />जो प्रेम तुम ने उनका पर दर्शायो हइ उनने मंडली का सामने तरा प्रेम की गवइ दी हइ. उनकी जत्रा का बनाय रखन का लिये कृपया उनकी या प्रकार इनकी मदत करणु जेका से परमेश्वर प्रसन्न हुये. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />क्युकि वे मसीह की सेवा की जत्रा पर नीकल पड्या हइ तथा गैरयहूदिहोन से कुछ मदत नी ले. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />येका लिये हम मसीहोन ने असो दुन्या कि मदत करी सक्ये हम भी सच्चाइ का काम मे उनका सहकर्मी हुया,<verse eid="3JN 1:8" /></para>
  <para style="s">दियुत्रिफेस अरु दिमेत्रियुस</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />या चिठ्ठी मंडली का भी लिखी थी पर दियुत्रिफेस जो उनमे मुखीया बननो चाहस हइ हम खे ग्रहन नी कर्ये. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />येका लिये जब मी आयु ते ओका काम होन खे जो उ करी रो हइ, याद दिलायु, कि उ हमारा बारे मे बुरी-बुरी बातहोन करस हइ. अरु हमारा बारे मे झुठी बातहोन करस हइ पन येतनो ही ओका लिये काफी नी उ मसीह अपना भैइ खे ग्रहन नी कर्ये जब वे आस हइ अरु उनखे भी रोखस हइ जो स्वीकार करणो चौउस हइ अरु पूरी कोशिश करस हइ कि उनका मंडली से बाहेर नीकाली देस हइ.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />हे प्रिय दोस्तो, बुराइ का नी पर भलाइ का अनुयायी होनु. जो भलाइ करस हइ, उ परमेश्वर का तरफ से हइ. पर जो बुराइ करस हइ, ओने परमेश्वर खे नी देख्यो.<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />दिमेत्रियुस का बारे मे सब ने क्युकी सच्चाइ ने भी आप ही गवइ दी. अरु हम भी गवइ देस हइ अरु तु जानस हइ कि हमारी गवइ सत्य हइ.<verse eid="3JN 1:12" /></para>
  <para style="s">आखरी अभिवादन</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />मेखे तोखे भोत कुछ लिखनो थो पर सइ अरु कलम से लिखनो नी चौउ. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />पर मेखे आस हइ कि तरा से जल्दी मील्यु, तब हम आमने-सामने बातचीत कर्या.<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />तोखे शांती मीलती र्हियेका ह्या, तरा दोस्त तोखे नमस्कार.</para>
  <para style="p" vid="3JN 1:15">वे मरा साथिहोन खे भी नमस्कार बोल देनु<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>