<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MIC" style="id">Mikeasi.TXT (Encoding update 2008) 27/02/2001 CAP C.R, GARIFUNA</book>
  <para style="h">Mikeasi</para>
  <para style="toc3">Mik</para>
  <para style="toc2">Mikeasi</para>
  <para style="toc1">Mikeasi</para>
  <para style="mt2">Liliburun</para>
  <para style="mt1">MIKEASI</para>
  <chapter number="1" style="c" sid="MIC 1" />
  <para style="ms">I. Laguseragüdüni Bungiu Ísüraeli Luma Hudá</para>
  <para style="mr">(<ref loc="MIC 1-3">1—3</ref>)</para>
  <para style="s1">Laguseragüdüni Bungiu Samaria</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1" />Anihán uganu le líchugubei Bungiu lun Mikeasi le Moresétina libügürü Samaria luma Herusalén dan meha lidaani larúeihan Hotamü, Akasi luma Esekíasi Hudá.<verse eid="MIC 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="MIC 1:2" />Sun gürigia, aganba huméi katei le;</para>
  <para style="q" vid="MIC 1:2">lílana sun fulasu, ru humá arigei:</para>
  <para style="q" vid="MIC 1:2">Wabureme, ligíaba gefén kóntüra sun huguya,</para>
  <para style="q" vid="MIC 1:2">lúmagiñe tídangiñe litenpulun to sánduboun.<verse eid="MIC 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 1:3" />Láfuriduba Wabureme le ñéingiñe lubéi laganóua,</para>
  <para style="q" vid="MIC 1:3">ábame liabin éibugeina ligibuagu burí wübü.<verse eid="MIC 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 1:4" />Larürüdaguba burí wübü lábugiñe lugudi</para>
  <para style="q" vid="MIC 1:4">kei lubuña sanudelu wáturugu,</para>
  <para style="q" vid="MIC 1:4">ladaaraguba fulasu wayati lidan bián murusun</para>
  <para style="q" vid="MIC 1:4">kamá hamuga ladüraagun duna héreti.<verse eid="MIC 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 1:5" />Lasusereduba sun le,</para>
  <para style="q" vid="MIC 1:5">ladüga hamaganbadin lumutuniña Hakobu,</para>
  <para style="q" vid="MIC 1:5">ladüga hafigoun Ísüraelina.</para>
  <para style="q" vid="MIC 1:5">Ka gadurunbei luagu lumaganbadin Hakobu?</para>
  <para style="q" vid="MIC 1:5">Mama funagia Samariana?</para>
  <para style="q" vid="MIC 1:5">Ka adüga anuhein tubéi hasanduariun gibe tubungiutegu Hudá?</para>
  <para style="q" vid="MIC 1:5">Mama funagia lílana Herusalén?<verse eid="MIC 1:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="MIC 1:6" />Ligía lariñagunbei Wabureme:</para>
  <para style="q" vid="MIC 1:6">«Nagünrinchagubei Samaria, lárigirugurügüba eredera,</para>
  <para style="q" vid="MIC 1:6">lun tábunawagun beibei ñein.</para>
  <para style="q" vid="MIC 1:6">Nachagaragubei lidübüri uburugu lidoun burí fulasu wayati</para>
  <para style="q" vid="MIC 1:6">ábame nafuranguagüdüni tiderebugu.<verse eid="MIC 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 1:7" />Hagünrinchawaguba sun liguariuan,</para>
  <para style="q" vid="MIC 1:7">gudawa ligíame sun ugudinaü sagüráuti.</para>
  <para style="q" vid="MIC 1:7">Kei lau lubéi haseinsun horu hadügǘwa,</para>
  <para style="q" vid="MIC 1:7">nadügayabaña haseinsunme horu».<verse eid="MIC 1:7" /></para>
  <para style="s1">Layahun Mikeasi</para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 1:8" />Ligía nayahuba lubéi lau saragu íruni;</para>
  <para style="q" vid="MIC 1:8">ligía néibuguba lubéi surusu ani masabadunga,</para>
  <para style="q" vid="MIC 1:8">áwouheina kei ounli áraabuna</para>
  <para style="q" vid="MIC 1:8">agúaraheina kei awesüturusu.<verse eid="MIC 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 1:9" />Ladüga máraninati biti le luágubei Samaria;</para>
  <para style="q" vid="MIC 1:9">ani chülühali darí Hudá,</para>
  <para style="q" vid="MIC 1:9">darí Herusalén uburugu le ñein lubéi haganawa numutuniña.<verse eid="MIC 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 1:10" />Mariñaga huméi katei le houn lílana Gatü;</para>
  <para style="q" vid="MIC 1:10">mayahuaha humá.</para>
  <para style="q" vid="MIC 1:10">Habalabaha lau igarigu múarugu Betü-le-afürá.<verse eid="MIC 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 1:11" />Lílana Safirü, heiba lidoun adaürǘni bóugudin luéi hageira</para>
  <para style="q" vid="MIC 1:11">surusu, buin lau busiganu!</para>
  <para style="q" vid="MIC 1:11">Máfuridunbaña ha aganóubaña Saanán!</para>
  <para style="q" vid="MIC 1:11">Anihein ayahuni Betü-éseli,</para>
  <para style="q" vid="MIC 1:11">huguya herederuba bóugudi luéi lídehan!<verse eid="MIC 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 1:12" />Ha aganóubaña Marotu, agarabahatiña lau gáriti,</para>
  <para style="q" vid="MIC 1:12">busentiña yebeha hasandiragun houngua buidu,</para>
  <para style="q" vid="MIC 1:12">ladüga chülügüda laali Wabureme wuribani</para>
  <para style="q" vid="MIC 1:12">dagá lubenari Herusalén.<verse eid="MIC 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 1:13" />Huguya Lákisina,</para>
  <para style="q" vid="MIC 1:13">ha maganbadibaña kei Ísüraelina,</para>
  <para style="q" vid="MIC 1:13">huguya le lébunabei lifigoun Sión,</para>
  <para style="q" vid="MIC 1:13">gürá humá gabayu tuagu hikarün.<verse eid="MIC 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="MIC 1:14" />Ayouragua humá lun Moresetü-gatü lun sun dan.</para>
  <para style="q" vid="MIC 1:14">Leseriwiduba uburugu Aküsíbü</para>
  <para style="q" vid="MIC 1:14">keisi sádara houn lurúeitegu Ísüraeli.<verse eid="MIC 1:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="MIC 1:15" />Lariñahare Wabureme:</para>
  <para style="q" vid="MIC 1:15">«Nóunahaba aban gagañeirati fulasu huagun</para>
  <para style="q" vid="MIC 1:15">huguya le aganóubei Maresá,</para>
  <para style="q" vid="MIC 1:15">ha íñugutimabaña Ísüraeli,</para>
  <para style="q" vid="MIC 1:15">hóudiba ebelura lidoun burí lagadábugiñe dübü Adulámü.<verse eid="MIC 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="MIC 1:16" />Buguyati, uburugu Sión,</para>
  <para style="q" vid="MIC 1:16">sabei bídiburi arufudei bigarigu</para>
  <para style="q" vid="MIC 1:16">hadüga isaanigu ha wéiribei hínsiñe bun.</para>
  <para style="q" vid="MIC 1:16">Hiyabei bídiburi darí berederun kei aban wadubi,</para>
  <para style="q" vid="MIC 1:16">lugundun hanügǘba birahüñü</para>
  <para style="q" vid="MIC 1:16">keisi adaürǘtiña diseun luéi hageira».<verse eid="MIC 1:16" /></para>
  <chapter eid="MIC 1" />
  <chapter number="2" style="c" sid="MIC 2" />
  <para style="s1">Habafu íchugutiña lidere dan</para>
  <para style="q">
    <verse number="1" style="v" sid="MIC 2:1" />Fugiabugu ha íbinibei lidan hawenedü</para>
  <para style="q" vid="MIC 2:1">haritaguatiña hadügün wuribani,</para>
  <para style="q" vid="MIC 2:1">dan larugadun aba hadügüni haritagun</para>
  <para style="q" vid="MIC 2:1">ladüga anihein lan ubafu háhaburugu!<verse eid="MIC 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 2:2" />Awamadiratiña burí fulasu, aba hanügüni;</para>
  <para style="q" vid="MIC 2:2">awamadiratiña burí muna, aba híweruhanu.</para>
  <para style="q" vid="MIC 2:2">Rútiña lidere dan houn wügüriña</para>
  <para style="q" vid="MIC 2:2">hau sun tílana haban luma hemegen.<verse eid="MIC 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 2:3" />Ligía lariñahare lubéi Wabureme:</para>
  <para style="q" vid="MIC 2:3">«Aransehaadina giñe hubá.</para>
  <para style="q" vid="MIC 2:3">Nóunahaba aban lamiselu huagun,</para>
  <para style="q" vid="MIC 2:3">le ídangiñebei siñabei lan hesefuruni higiina,</para>
  <para style="q" vid="MIC 2:3">siñaalime héibugun lau pantaü</para>
  <para style="q" vid="MIC 2:3">ladüga lidaanihalime günringuaü.<verse eid="MIC 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 2:4" />Lídanme weyu ligía,</para>
  <para style="q" vid="MIC 2:4">leremuhóuba uremu le lánina ayahuni hun.</para>
  <para style="q" vid="MIC 2:4">Lariñagame lidan uremu ligía:</para>
  <para style="q" vid="MIC 2:4">“Günrinwaguaadiwa sunsuinagubei;</para>
  <para style="q" vid="MIC 2:4">wageira, le lumegen Wabureme</para>
  <para style="q" vid="MIC 2:4">sánsiha labureme úouga kaba lan erederei;</para>
  <para style="q" vid="MIC 2:4">fánreinwagua wachari hadan ha agañeirubaliwa” ».<verse eid="MIC 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 2:5" />Ligía mafanranbadün lubéi hadan</para>
  <para style="q" vid="MIC 2:5">lumutuniña Wabureme.<verse eid="MIC 2:5" /></para>
  <para style="s1">Profetagu wuribatiña</para>
  <para style="q">
    <verse number="6" style="v" sid="MIC 2:6" />«Miabin humá woun lau dimurei lúmagiñeti Bungiu! —liña hariñagun—.</para>
  <para style="q" vid="MIC 2:6">Machülübei lamiselu wawagun!»<verse eid="MIC 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 2:7" />Íñarawaguaaña funagia lumutuniña Hakobu?</para>
  <para style="q" vid="MIC 2:7">Féridila funagia Bungiu luguraasun?</para>
  <para style="q" vid="MIC 2:7">Ítara liña funagia luadigimaridun Bungiu?</para>
  <para style="q" vid="MIC 2:7">Mama funagia buiti ladügübei lererun Bungiu lun</para>
  <para style="q" vid="MIC 2:7">le éibugubei lidan lúaragun?<verse eid="MIC 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 2:8" />Huguya iñuraguaadün hungua hawagun numutuniña.</para>
  <para style="q" vid="MIC 2:8">Bayú humutu daüguaü gebegitu hawéi</para>
  <para style="q" vid="MIC 2:8">ha agiribudubaña wuriburugugiñe</para>
  <para style="q" vid="MIC 2:8">asaminaréina séfuhaña lan.<verse eid="MIC 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 2:9" />Bugá humutiña würiña hábiñegiñe,</para>
  <para style="q" vid="MIC 2:9">gidá huméi uéiriguni le níchugubei</para>
  <para style="q" vid="MIC 2:9">houn harahüñü hawéi sunsuinagubei.<verse eid="MIC 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 2:10" />Sará humá! Héibugameme!</para>
  <para style="q" vid="MIC 2:10">Mama fulasu emeraaguagülei le;</para>
  <para style="q" vid="MIC 2:10">ladüga iwiyei le lídanbei,</para>
  <para style="q" vid="MIC 2:10">lagünrinchawaguba le gumuti.<verse eid="MIC 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 2:11" />Anhein eyeeha aban gürigia, lun lariñagun:</para>
  <para style="q" vid="MIC 2:11">«Anuheinboun diwéin»,</para>
  <para style="q" vid="MIC 2:11">ligíaba profeta auti hagundaara.<verse eid="MIC 2:11" /></para>
  <para style="s1">Füramase lan Wabungiute lesefuruniña lánigu</para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 2:12" />Nóundarubaña sun lumutuniña Hakobu;</para>
  <para style="q" vid="MIC 2:12">nabudubaña ha erederubaña hádangiñe Ísüraelina.</para>
  <para style="q" vid="MIC 2:12">Nóundarubaña kei mudún lidan fárüga</para>
  <para style="q" vid="MIC 2:12">kei mudún-agei lidan sagadi,</para>
  <para style="q" vid="MIC 2:12">ábame hareinchun keisi aban guririguaü.<verse eid="MIC 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 2:13" />Adaareina luba Bungiu üma habá,</para>
  <para style="q" vid="MIC 2:13">ábame hafalaruni,</para>
  <para style="q" vid="MIC 2:13">ábame háfuridun luéigiñe lubenari uburugu.</para>
  <para style="q" vid="MIC 2:13">Lídiba harúeite le Aburemei habá habá.<verse eid="MIC 2:13" /></para>
  <chapter eid="MIC 2" />
  <chapter number="3" style="c" sid="MIC 3" />
  <para style="s1">Uganu kóntüra gumadimatiña wuribatiña</para>
  <para style="q">
    <verse number="1" style="v" sid="MIC 3:1" />Lárigiñe aba nariñagun:</para>
  <para style="q" vid="MIC 3:1">«Aganba humá guentó huguya gumadimatiña</para>
  <para style="q" vid="MIC 3:1">hama ábutigu Ísüraeli,</para>
  <para style="q" vid="MIC 3:1">ma funagia yuuti hun lun hasubudiruni</para>
  <para style="q" vid="MIC 3:1">katei lan irichaübei?<verse eid="MIC 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 3:2" />Gama lumoun iyereeguti buiti hun,</para>
  <para style="q" vid="MIC 3:2">línsiñeda wuribati hun;</para>
  <para style="q" vid="MIC 3:2">éleha humuti hara numutuniña</para>
  <para style="q" vid="MIC 3:2">aba hígiruni habu furangu.<verse eid="MIC 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 3:3" />Hou humutiña numutuniña wínwanñu;</para>
  <para style="q" vid="MIC 3:3">éleha humuti hara halagua huméi habu</para>
  <para style="q" vid="MIC 3:3">óusera humutiña kamá hamuga úi lun lábouagun.<verse eid="MIC 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 3:4" />Hagúarubei Wabureme,</para>
  <para style="q" vid="MIC 3:4">gama lumoun móunabun lubadün.</para>
  <para style="q" vid="MIC 3:4">Laramudaguba huéi</para>
  <para style="q" vid="MIC 3:4">ladüga burí wuribani le hadügübei».<verse eid="MIC 3:4" /></para>
  <para style="s1">Uganu hawagu profetagu yéetiña</para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 3:5" />Lagübüri üma hafalarubei numutuniña</para>
  <para style="q" vid="MIC 3:5">hadüga profetagu ha eyeedubaliña,</para>
  <para style="q" vid="MIC 3:5">ha adimurehabaña luagu darangilaü</para>
  <para style="q" vid="MIC 3:5">houn ha íchugubaña éigini houn,</para>
  <para style="q" vid="MIC 3:5">gama lumoun awuribuhatiña hama ha</para>
  <para style="q" vid="MIC 3:5">míchubaña houn.</para>
  <para style="q" vid="MIC 3:5">Lariñahare Bungiu houn profetagu hagía:<verse eid="MIC 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MIC 3:6" />«Mayanuhandigiaadina hun lidan uénedü áriebu,</para>
  <para style="q" vid="MIC 3:6">mariñagun humeime lidan luburiga le lunbei lasuseredun.</para>
  <para style="q" vid="MIC 3:6">Lálüdüba weyu houn profetagu hagía</para>
  <para style="q" vid="MIC 3:6">búriga ligíame wéyuagu.<verse eid="MIC 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 3:7" />Hanügüba profetagu hama</para>
  <para style="q" vid="MIC 3:7">garíaahatiña ha busiganu.</para>
  <para style="q" vid="MIC 3:7">Herederuba sun hagía maniñu</para>
  <para style="q" vid="MIC 3:7">danme móunabun lániña Bungiu».<verse eid="MIC 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 3:8" />Ánheinti au, buíngüda lumutina</para>
  <para style="q" vid="MIC 3:8">lani Bungiu sífiri lau erei,</para>
  <para style="q" vid="MIC 3:8">irichaü luma anigi,</para>
  <para style="q" vid="MIC 3:8">lun nariñaguni lumabuchahan</para>
  <para style="q" vid="MIC 3:8">luma lifigoun Ísüraeli lun ligibuagun.<verse eid="MIC 3:8" /></para>
  <para style="s1">Lagünrinchawagun Ísüraeli</para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 3:9" />Aganba huméi katei le guentó,</para>
  <para style="q" vid="MIC 3:9">huguya gumadimatiña hama ábutigu Ísüraeli,</para>
  <para style="q" vid="MIC 3:9">huguya le iyereehabúbei lun irichaü,</para>
  <para style="q" vid="MIC 3:9">ani segegüda huméi sun le surubei,<verse eid="MIC 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 3:10" />huguya le ábunagubalin Herusalén</para>
  <para style="q" vid="MIC 3:10">ligibuagu áfarahani luma marichaü.<verse eid="MIC 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 3:11" />Aluguraguatiña aguseragüdütiña houngua luagu fáyeiti</para>
  <para style="q" vid="MIC 3:11">arufudahatiña fádirigu luagu seinsu,</para>
  <para style="q" vid="MIC 3:11">aluguraha hamuti giñe profetagu hererun,</para>
  <para style="q" vid="MIC 3:11">asigeneheina luagu hámagiñeñein lan Wabureme hariñaga:</para>
  <para style="q" vid="MIC 3:11">«Anihein Wabureme wama;</para>
  <para style="q" vid="MIC 3:11">masuseredunbei ni kata wuribati woun».<verse eid="MIC 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 3:12" />Ladüga lubeiti hidurun,</para>
  <para style="q" vid="MIC 3:12">lerederuba Herusalén kei aban dübü-agei</para>
  <para style="q" vid="MIC 3:12">lawouchúba Sión kei ichari,</para>
  <para style="q" vid="MIC 3:12">labuinchuba híduru tau ténpulu.<verse eid="MIC 3:12" /></para>
  <chapter eid="MIC 3" />
  <chapter number="4" style="c" sid="MIC 4" />
  <para style="ms">II. Esefuruni Luma Darangilaü</para>
  <para style="mr">(<ref loc="MIC 4-5">4—5</ref>)</para>
  <para style="s1">Larúeihan Aburemei le lánina darangilaü</para>
  <para style="r">(<ref loc="ISA 2:2-4">Isa 2.2-4</ref>)</para>
  <para style="q">
    <verse number="1" style="v" sid="MIC 4:1" />Lídanme lagumuhóun dan,</para>
  <para style="q" vid="MIC 4:1">lederebugüdüwaba wübü le ñein tubéi</para>
  <para style="q" vid="MIC 4:1">litenpulun Wabureme.</para>
  <para style="q" vid="MIC 4:1">Ligíaba wübü íñutima;</para>
  <para style="q" vid="MIC 4:1">íñubei sügǘ lau furumiñeguarügü wübü.</para>
  <para style="q" vid="MIC 4:1">Hayabiba sun néchanigu luagun;<verse eid="MIC 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 4:2" />hayabiba saragu gürigia ariñageina:</para>
  <para style="q" vid="MIC 4:2">«Higougu, wawarira luagun luwübüri Wabureme,</para>
  <para style="q" vid="MIC 4:2">litenpulunrugun Lubungiute Hakobu,</para>
  <para style="q" vid="MIC 4:2">lun larufuduni lémeri woun,</para>
  <para style="q" vid="MIC 4:2">gayara láamuga wéibugun luéigiñe lǘmate».</para>
  <para style="q" vid="MIC 4:2">Ladüga Sióngiñeba liabin larufudahan Wabureme,</para>
  <para style="q" vid="MIC 4:2">Herusaléngiñeba liabin lererun.<verse eid="MIC 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 4:3" />Laguseragüdübaña Wabureme néchanigu,</para>
  <para style="q" vid="MIC 4:3">larihuba lau hawuribun gürigia gíbetiña,</para>
  <para style="q" vid="MIC 4:3">íbini ha dísetimabaña.</para>
  <para style="q" vid="MIC 4:3">Hadaaguba awouhagülei tau hefeinte,</para>
  <para style="q" vid="MIC 4:3">adüga hagíame líbaaha sagadi lau arufun.</para>
  <para style="q" vid="MIC 4:3">Mageindagunhañame gürigia hámagua,</para>
  <para style="q" vid="MIC 4:3">marufudahóun ligíame houn lun wuribu.<verse eid="MIC 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 4:4" />Haganóuba súngubei manufudeuga,</para>
  <para style="q" vid="MIC 4:4">gayaraabei hemeraagun lábugiñe</para>
  <para style="q" vid="MIC 4:4">tamuñadiri hanadürigu.</para>
  <para style="q" vid="MIC 4:4">Lererun Wabureme Suntigabafu le!<verse eid="MIC 4:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="MIC 4:5" />Ha híbiri gürigia,</para>
  <para style="q" vid="MIC 4:5">falá hamutiña ani gaganbaditiña houn habungiutegu,</para>
  <para style="q" vid="MIC 4:5">ánheinti wagía Wabureme le Wabungiute wafalarubei</para>
  <para style="q" vid="MIC 4:5">ani gaganbaditiwa lun súnwandan.<verse eid="MIC 4:5" /></para>
  <para style="s1">Lesefuruniña Wabureme lumutuniña</para>
  <para style="p">
    <verse number="6-7" style="v" sid="MIC 4:6-7" />Lariñahare Wabureme:</para>
  <para style="q" vid="MIC 4:6-7">«Lídanme weyu ligía,</para>
  <para style="q" vid="MIC 4:6-7">nóundarubaña nilügüniña mudún,</para>
  <para style="q" vid="MIC 4:6-7">ha meha nabeichubaña:</para>
  <para style="q" vid="MIC 4:6-7">Ha adamahabaña, ha bucharuaña ani chagagu hagía.</para>
  <para style="q" vid="MIC 4:6-7">Nadügüba aban néchani héreti hau ha erederubaña.</para>
  <para style="q" vid="MIC 4:6-7">Au, le Aburemei, nadundehabaña numutuniña</para>
  <para style="q" vid="MIC 4:6-7">luéigiñe wübü Sión, guentó luma súnwandan.<verse eid="MIC 4:6-7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 4:8" />Buguya, Herusalén, liderebugu Sión,</para>
  <para style="q" vid="MIC 4:8">buguyaba lichügüdina fulasu,</para>
  <para style="q" vid="MIC 4:8">uburugu le wéirigutimabei Ísüraeli».<verse eid="MIC 4:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="MIC 4:9" />Kati uagu bagúaraha ítara guentó,</para>
  <para style="q" vid="MIC 4:9">kei würi agaridutu?</para>
  <para style="q" vid="MIC 4:9">Ladüga funagia marúeite ban?</para>
  <para style="q" vid="MIC 4:9">Odi ladüga hilagua lan eweridihatibu?<verse eid="MIC 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 4:10" />Bagúaraha kei würi agaridutu, uburugu Sión,</para>
  <para style="q" vid="MIC 4:10">ladüga háfuriduba bumutuniña bídangiñe,</para>
  <para style="q" vid="MIC 4:10">ábame haganóun áraabu,</para>
  <para style="q" vid="MIC 4:10">hachülürüba darí Babilónia.</para>
  <para style="q" vid="MIC 4:10">Gama lumoun lesefurubaña Wabureme lumutuniña ñein;</para>
  <para style="q" vid="MIC 4:10">lesefurubaña hawéi háganiñu.<verse eid="MIC 4:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="MIC 4:11" />Guentó, saragu haña néchanigu</para>
  <para style="q" vid="MIC 4:11">óundaraguatiña buagun,</para>
  <para style="q" vid="MIC 4:11">hariñaga: «Wagundaaruba lau</para>
  <para style="q" vid="MIC 4:11">warihin lawiyedun Herusalén!»<verse eid="MIC 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 4:12" />Gama lumoun ibidiñeti lisaminan Wabungiute</para>
  <para style="q" vid="MIC 4:12">houn néchanigu hagía;</para>
  <para style="q" vid="MIC 4:12">ibidiñeti houn luagu lóundarubaña lan</para>
  <para style="q" vid="MIC 4:12">kei lóundaraguagüdüniwa aban fuñein türigu</para>
  <para style="q" vid="MIC 4:12">lun tasagarún türigu tídangiñe.<verse eid="MIC 4:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="MIC 4:13" />Uburugu Sión, saraba, ábürühaba luagun bágani!</para>
  <para style="q" vid="MIC 4:13">Ladüga lariñahare Wabureme:</para>
  <para style="q" vid="MIC 4:13">«Néredagüdübadibu kei aban wügüri bágasu</para>
  <para style="q" vid="MIC 4:13">le gürabu liganchun, buronse lúbara</para>
  <para style="q" vid="MIC 4:13">lun bagünrinchagun saragu gürigia.</para>
  <para style="q" vid="MIC 4:13">Bagidarubei harisin le hibihubei lau marumani hawéi,</para>
  <para style="q" vid="MIC 4:13">ábame bederegeruni nun,</para>
  <para style="q" vid="MIC 4:13">au le Labureme sun ubóu».<verse eid="MIC 4:13" /></para>
  <chapter eid="MIC 4" />
  <chapter number="5" style="c" sid="MIC 5" />
  <para style="s1">Líchuguba Wabureme arúeihatiña Ísüraeli</para>
  <para style="q">
    <verse number="1" style="v" sid="MIC 5:1" />«Gama lumoun guentó Herusalén,</para>
  <para style="q" vid="MIC 5:1">aransebéi bubarieirun,</para>
  <para style="q" vid="MIC 5:1">ladüga geyewaguaadibu</para>
  <para style="q" vid="MIC 5:1">ani labeichúba lábuti Ísüraeli here.<verse eid="MIC 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 5:2" />Buguyati, Belén Éfürata,</para>
  <para style="q" vid="MIC 5:2">buguya uburugu le ñǘraütimabei Hudá,</para>
  <para style="q" vid="MIC 5:2">bídangiñeba láfurida lurúeite Ísüraeli</para>
  <para style="q" vid="MIC 5:2">hadügawagunbei binadu iduheñu».<verse eid="MIC 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 5:3" />Guentó ígira lumutiña Wabureme lánigu,</para>
  <para style="q" vid="MIC 5:3">gama lumoun darí tágurahan würi to agurabahabóun aban irahü.</para>
  <para style="q" vid="MIC 5:3">Lárigiñeme ábame hóundaragun hama Ísüraelina ha hapaisanun</para>
  <para style="q" vid="MIC 5:3">ha asagarúbaña hageiragiñe keisi adaürǘtiña.<verse eid="MIC 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 5:4" />Lásaaruba urúei lun lóunigiruniña lumutuniña</para>
  <para style="q" vid="MIC 5:4">lau lubafu luma lau luéirigun Wabureme le Lubungiute,</para>
  <para style="q" vid="MIC 5:4">ábame habagaridun darangilu</para>
  <para style="q" vid="MIC 5:4">ladüga lichugúba uéiriguni lun Wabureme</para>
  <para style="q" vid="MIC 5:4">darí lumoun lagumuhóun larigei ubóu.<verse eid="MIC 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 5:5" />Ligíaba darangilaü.</para>
  <para style="q" vid="MIC 5:5">Danme hebelurun Asiriana wageiroun lau here,</para>
  <para style="q" vid="MIC 5:5">belú hagíame tidoun wani palasiu,</para>
  <para style="q" vid="MIC 5:5">wóunahaba sedü ábutigu</para>
  <para style="q" vid="MIC 5:5">hama widü wügüriña wéirigutiña hawagun.<verse eid="MIC 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MIC 5:6" />Hagumadihaba tau eféin Asiria, le lageira Nimüródu,</para>
  <para style="q" vid="MIC 5:6">ábame hesefuruniwa hawéi Asiriana ha ánhiñuragunbalin fadaguaü,</para>
  <para style="q" vid="MIC 5:6">belú hagía wageiroun.<verse eid="MIC 5:6" /></para>
  <para style="s1">Hagünrinchawaguniwa áganiñu</para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 5:7" />Ítara habati Ísüraelina hame erederutiña wínwanñu</para>
  <para style="q" vid="MIC 5:7">haganagua saragu gürigia</para>
  <para style="q" vid="MIC 5:7">kei serenu le lóunahan Bungiu,</para>
  <para style="q" vid="MIC 5:7">kei huya le ábürühabei luagun híduru.</para>
  <para style="q" vid="MIC 5:7">Hámabei lídehan Bungiu mama hídehan gürigia.<verse eid="MIC 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 5:8" />Ítara habati Ísüraelina hame erederutiña wínwanñu</para>
  <para style="q" vid="MIC 5:8">haganagua saragu néchanigu</para>
  <para style="q" vid="MIC 5:8">kei aban liñún haganagua animaalugu áraabuna,</para>
  <para style="q" vid="MIC 5:8">kei aban liñún haganagua mudún,</para>
  <para style="q" vid="MIC 5:8">le áfaragubaliña dan le lásügürün,</para>
  <para style="q" vid="MIC 5:8">mígirunga ni aban wínwanñu.<verse eid="MIC 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 5:9" />Ítara luba lagünrinchaguniña</para>
  <para style="q" vid="MIC 5:9">Wabureme sun láganiñu.<verse eid="MIC 5:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="MIC 5:10" />Lariñahare Wabureme:</para>
  <para style="q" vid="MIC 5:10">«Lídanme weyu ligía,</para>
  <para style="q" vid="MIC 5:10">náfaragubaña bilügüniña gabayu,</para>
  <para style="q" vid="MIC 5:10">nagünrinchaguboun burí bikarün to lánina wuribu;<verse eid="MIC 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 5:11" />nagünrinchagubei sun buburugute,</para>
  <para style="q" vid="MIC 5:11">nágurubei sun biderebugu;<verse eid="MIC 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 5:12" />nagumuchuba lau burí babiñarahan</para>
  <para style="q" vid="MIC 5:12">luma hau garíaahatiña;<verse eid="MIC 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 5:13" />nagünrinchagubaña biguariuangu luma burí dübü sagüráuti</para>
  <para style="q" vid="MIC 5:13">lun máhuduragundigia ban houn búngiugu ha badüga lau búhabu.<verse eid="MIC 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="MIC 5:14" />Náhulaagubei tídibu burí buewen le sagüráubei,</para>
  <para style="q" vid="MIC 5:14">nagünrinchagubei burí buburugute sunsuinagubei.<verse eid="MIC 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MIC 5:15" />Lidan nigañi nageindaguba hama néchanigu</para>
  <para style="q" vid="MIC 5:15">ha máhabaña hadügüni le nubeibei».<verse eid="MIC 5:15" /></para>
  <chapter eid="MIC 5" />
  <chapter number="6" style="c" sid="MIC 6" />
  <para style="ms">III. Lagadeirun Ísüraeli Luma Lugudemehabu Bungiu</para>
  <para style="mr">(<ref loc="MIC 6-7">6—7</ref>)</para>
  <para style="s1">Laguseragüdüni Wabureme Ísüraeli</para>
  <para style="q">
    <verse number="1" style="v" sid="MIC 6:1" />Guentoti aganba huméi lariñagun Aburemei:</para>
  <para style="q" vid="MIC 6:1">«Saraba bageindagua luma burí áraabu,</para>
  <para style="q" vid="MIC 6:1">aganbaléi wübü bumalali!»<verse eid="MIC 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 6:2" />Aganba humá,</para>
  <para style="q" vid="MIC 6:2">wübü burí luma burí lebu ubóu le derebugubei:</para>
  <para style="q" vid="MIC 6:2">Laguseragüdübaña Wabureme lumutuniña,</para>
  <para style="q" vid="MIC 6:2">ladügüba aban ageindaguni luma Ísüraeli.<verse eid="MIC 6:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="MIC 6:3" />Lariñahare Wabureme:</para>
  <para style="q" vid="MIC 6:3">«Óunaba humana numutuniña,</para>
  <para style="q" vid="MIC 6:3">Ka san nadügübei hun?<verse eid="MIC 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 6:4" />Sagá numutün Ehiptugiñe</para>
  <para style="q" vid="MIC 6:4">lídangiñe amudirawaguni;</para>
  <para style="q" vid="MIC 6:4">óunaha numuti Moisesi, Aarón tuma María</para>
  <para style="q" vid="MIC 6:4">lun hadundehanün.<verse eid="MIC 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 6:5" />Numutuniña, haritagua humá</para>
  <para style="q" vid="MIC 6:5">luagu bugaha le labusenrubei Balakü,</para>
  <para style="q" vid="MIC 6:5">le lurúeite Moabü ladügün hun,</para>
  <para style="q" vid="MIC 6:5">luma ida liña lan lóunabuni Balaamü, le liráü Beoru.</para>
  <para style="q" vid="MIC 6:5">Haritagua humá luagu dan le</para>
  <para style="q" vid="MIC 6:5">hásügürünbei Sitimügiñe lun Gilügálin,</para>
  <para style="q" vid="MIC 6:5">subudi humaamugei richagua lan Wabureme».<verse eid="MIC 6:5" /></para>
  <para style="s1">Le lagurabubei Wabureme lúmagiñe wügüri</para>
  <para style="q">
    <verse number="6" style="v" sid="MIC 6:6" />Kaba au nidin áhuduragua lun Bungiu le íñubei?</para>
  <para style="q" vid="MIC 6:6">Hauba funa san bágasu wügüriña ha ábanti irumu hau</para>
  <para style="q" vid="MIC 6:6">lun níchuguniña lun kei adagaragüdüni gudawarügüti?<verse eid="MIC 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 6:7" />Lagundaaruba funa san Wabureme ánhana</para>
  <para style="q" vid="MIC 6:7">adagaragüda milu mudún o</para>
  <para style="q" vid="MIC 6:7">diisi-milu budéin garaba lun?</para>
  <para style="q" vid="MIC 6:7">O anhein lan funa níchiga niráü</para>
  <para style="q" vid="MIC 6:7">le íbugañaü lun keisi lafayeiruaha nifigoun?<verse eid="MIC 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 6:8" />Arufuda laali Bungiu le buídubei bun,</para>
  <para style="q" vid="MIC 6:8">luma ka lan lamuriahabei búmagiñe:</para>
  <para style="q" vid="MIC 6:8">Lun badügün irichaü, lun gudemehabu ban</para>
  <para style="q" vid="MIC 6:8">luma lun manaagun ban bungua ligibugiñe Bungiu.<verse eid="MIC 6:8" /></para>
  <para style="s1">Uganu luáguti íweru luma iyeeni</para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 6:9" />Lagúahaña Wabureme houn lílana uburugu,</para>
  <para style="q" vid="MIC 6:9">ani lunti laganbún lau inebesei:</para>
  <para style="q" vid="MIC 6:9">«Aganba humá gürigia hama eweridihatiña uburugu:<verse eid="MIC 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 6:10" />Hábiñe gürigia ha wuribabaña,</para>
  <para style="q" vid="MIC 6:10">anihein burí irisini le habihin mama lidan lubudubu</para>
  <para style="q" vid="MIC 6:10">luma burí amisuraagülei híweruti, le mínsiñebei nun.<verse eid="MIC 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 6:11" />Ida luba feruduna nániña gürigia</para>
  <para style="q" vid="MIC 6:11">ha ayusurubaña balansu múaranti?<verse eid="MIC 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 6:12" />Sun rísitiña ha lídanbaña uburugu le, rútiña lidere dan;</para>
  <para style="q" vid="MIC 6:12">yéetiña sun lílana uburugu le.<verse eid="MIC 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 6:13" />Ligía nabeichadibu lubéi;</para>
  <para style="q" vid="MIC 6:13">nagünrinchaguaadibu ladüga bifigoun.<verse eid="MIC 6:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="MIC 6:14" />Béigiba, gama lumoun makimuledunbadibu,</para>
  <para style="q" vid="MIC 6:14">basufuriramémeba ilamaü;</para>
  <para style="q" vid="MIC 6:14">géiginbadibu gama lumoun mesefubadibu ni kata lídangiñe,</para>
  <para style="q" vid="MIC 6:14">íbini ánhabu esefura lídangiñe,</para>
  <para style="q" vid="MIC 6:14">nadügüba lun lagünrinchaguni wuribu.<verse eid="MIC 6:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MIC 6:15" />Bábunaguba, gama lumoun malubahanbadibu;</para>
  <para style="q" vid="MIC 6:15">báhürühaba oliwu, gama lumoun meseriwínbei garaba bun;</para>
  <para style="q" vid="MIC 6:15">baribichaguba beibei,</para>
  <para style="q" vid="MIC 6:15">gama lumoun mátunbadibu diwéin.<verse eid="MIC 6:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="MIC 6:16" />Ladüga falá baali lugumadin Omurí</para>
  <para style="q" vid="MIC 6:16">luma hagaburi tílana luban Aabü,</para>
  <para style="q" vid="MIC 6:16">óuseraadibu kei hagía.</para>
  <para style="q" vid="MIC 6:16">Ligía nadügüba lubéi lun lébuna ban iyereehabúni</para>
  <para style="q" vid="MIC 6:16">luma bula houn sun ha aganóubaña bidan,</para>
  <para style="q" vid="MIC 6:16">lábürühaba habusigari numutuniña buagun».<verse eid="MIC 6:16" /></para>
  <chapter eid="MIC 6" />
  <chapter number="7" style="c" sid="MIC 7" />
  <para style="s1">Lagadeiragun Ísüraeli</para>
  <para style="q">
    <verse number="1" style="v" sid="MIC 7:1" />Fugiabu au! Ítara niña kei le áluahabei</para>
  <para style="q" vid="MIC 7:1">ígiraguti lárigiñe alubahani,</para>
  <para style="q" vid="MIC 7:1">gama lumoun madariti beibei ni igu</para>
  <para style="q" vid="MIC 7:1">to hamuga labusenruboun leigin.<verse eid="MIC 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 7:2" />Úaaña wügüriña ubouagu ha gúnfulitiña luma Bungiu,</para>
  <para style="q" vid="MIC 7:2">súngubei agurabañu hañalin dan</para>
  <para style="q" vid="MIC 7:2">lun hadügüni katei lau anarimeni;</para>
  <para style="q" vid="MIC 7:2">sétitiña sádara habaruagua.<verse eid="MIC 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 7:3" />Máisturugu hagía lidan ladügǘn wuribati;</para>
  <para style="q" vid="MIC 7:3">aluguraguatiña lánigu urúei</para>
  <para style="q" vid="MIC 7:3">hama aguseragüdütiña houngua luagu fáyeiti;</para>
  <para style="q" vid="MIC 7:3">ha gabafubaña, adüga hamuti le habusenrun,</para>
  <para style="q" vid="MIC 7:3">gadei hamuti uburugu.<verse eid="MIC 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 7:4" />Le buítimabei hadan, ítara liña kei hiiyu;</para>
  <para style="q" vid="MIC 7:4">le harumatimabei, ítara liña kei aban búbugati.</para>
  <para style="q" vid="MIC 7:4">Gama lumoun anitebei weyu lun haguserun,</para>
  <para style="q" vid="MIC 7:4">weyu le buga uágubei lariñaga óunigiruti bun.</para>
  <para style="q" vid="MIC 7:4">Ábameti larúeihan bulíeiguaü haganagua.<verse eid="MIC 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 7:5" />Mafiñerabá luagu lererun amu gürigia,</para>
  <para style="q" vid="MIC 7:5">mafiñerabá luagu ni aban umadaü;</para>
  <para style="q" vid="MIC 7:5">góunigibei íbini le badimurehabei tuma búmari.<verse eid="MIC 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MIC 7:6" />Ladüga óusera hamutiña isaanigu agübürigu lau mebereseni,</para>
  <para style="q" vid="MIC 7:6">añaruduahóutiña isaanigu würiña houn háguchugu,</para>
  <para style="q" vid="MIC 7:6">ídiñu houn ágürü,</para>
  <para style="q" vid="MIC 7:6">liduheñu guánarügü kada gürigia láganiñubaña.<verse eid="MIC 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 7:7" />Anhein au, nagurabahaba lúmagiñe Wabureme,</para>
  <para style="q" vid="MIC 7:7">níchugubei nemenigin luagu Bungiu le nesefuragüle,</para>
  <para style="q" vid="MIC 7:7">ladüga laganbubadina.<verse eid="MIC 7:7" /></para>
  <para style="s1">Lagañeirun Ísüraeli le tímatimaati</para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 7:8" />Néchani nágani, magundaarabá lau nilamiserun,</para>
  <para style="q" vid="MIC 7:8">ladüga íbini heigua nan, násaaruba;</para>
  <para style="q" vid="MIC 7:8">íbini legeyedagun luburiga nau,</para>
  <para style="q" vid="MIC 7:8">Aburemei nilanpunbei.<verse eid="MIC 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 7:9" />Afigouhaadina ligibugiñe Bungiu,</para>
  <para style="q" vid="MIC 7:9">ligía nawandubei lubéi ligañi,</para>
  <para style="q" vid="MIC 7:9">gama lumoun larihuba lau nikesin</para>
  <para style="q" vid="MIC 7:9">ábame líchuguni niricha nun.</para>
  <para style="q" vid="MIC 7:9">Lanügübadina Bungiu lidoun larugounga,</para>
  <para style="q" vid="MIC 7:9">larufudubei lagañeirun nun.<verse eid="MIC 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 7:10" />Tarihubei giñe nágani,</para>
  <para style="q" vid="MIC 7:10">ábame tabuinchun lau busiganu.</para>
  <para style="q" vid="MIC 7:10">Tariñaga meha nun:</para>
  <para style="q" vid="MIC 7:10">«Hagéi Aburemei le Bubungiute?»</para>
  <para style="q" vid="MIC 7:10">Gama lumoun guentó, narihuboun adügürawagúa</para>
  <para style="q" vid="MIC 7:10">kei gubegubeti múarugu.<verse eid="MIC 7:10" /></para>
  <para style="s1">Lararamunya Herusalén</para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 7:11" />Herusalén, aniteeli weyu</para>
  <para style="q" vid="MIC 7:11">lunya lararamawagüdün bubarieirun,</para>
  <para style="q" vid="MIC 7:11">luma lun laweiridúntima bumúan.<verse eid="MIC 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 7:12" />Aniteeli weyu</para>
  <para style="q" vid="MIC 7:12">lun hayabin bumoun lídangiñe sun fulasu;</para>
  <para style="q" vid="MIC 7:12">lúmagiñe Asiria darí Ehiptu;</para>
  <para style="q" vid="MIC 7:12">lúmagiñe duna Nilu darí Éufüratesi,</para>
  <para style="q" vid="MIC 7:12">lúmagiñe aban barana lumoun ábanya,</para>
  <para style="q" vid="MIC 7:12">luma lúmagiñe aban wübü lumoun ábanya.<verse eid="MIC 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 7:13" />Lerederuba múa fulasume mageirawati</para>
  <para style="q" vid="MIC 7:13">hadüga lílana, ladüga hariban.<verse eid="MIC 7:13" /></para>
  <para style="s1">Afurieiduni luagu hawanserun lumutuniña Wabureme</para>
  <para style="q">
    <verse number="14" style="v" sid="MIC 7:14" />Góunigibaña bumutuniña, Wabureme,</para>
  <para style="q" vid="MIC 7:14">góunigibaña bilügüniña mudún,</para>
  <para style="q" vid="MIC 7:14">ha hábuguabaña dabíararugu,</para>
  <para style="q" vid="MIC 7:14">geyegu múa arandarati hau!</para>
  <para style="q" vid="MIC 7:14">Barübaña kei lidan meha dan le sügühalibei</para>
  <para style="q" vid="MIC 7:14">lidoun sagadi-agei Basán luma Galaadü.<verse eid="MIC 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MIC 7:15" />Arihagüdabaña katei garíawaseti,</para>
  <para style="q" vid="MIC 7:15">kei lidan dan le basagarunbaliña Ehiptugiñe.<verse eid="MIC 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="MIC 7:16" />Ariha haméi giñe híbiri néchanigu,</para>
  <para style="q" vid="MIC 7:16">barǘ hamaamuga busiganu lau sun lueirin habafu!</para>
  <para style="q" vid="MIC 7:16">Redei hamá kei mariñagaditiña,</para>
  <para style="q" vid="MIC 7:16">rédeime kei maganbaditiña!<verse eid="MIC 7:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="MIC 7:17" />Héheluhabei kaliki kei hewe</para>
  <para style="q" vid="MIC 7:17">luma kei híbiri animaalugu ha aduruuharügübaña múarugu!</para>
  <para style="q" vid="MIC 7:17">Furí hama adadagareina lídangiñe hamasa,</para>
  <para style="q" vid="MIC 7:17">ñübuin hamá bumoun Aburemei buin lau anufudei!<verse eid="MIC 7:17" /></para>
  <para style="s1">Feruduna lániña Wabungiute lumutuniña</para>
  <para style="q">
    <verse number="18" style="v" sid="MIC 7:18" />Úati amu Bungiu kei buguya,</para>
  <para style="q" vid="MIC 7:18">ladüga feruduna bumuti wuribani,</para>
  <para style="q" vid="MIC 7:18">bulíei bumuti hariban fiuraü</para>
  <para style="q" vid="MIC 7:18">hádangiñe bumutuniña ha.</para>
  <para style="q" vid="MIC 7:18">Arufuda bumuti bínsiñehabu woun,</para>
  <para style="q" vid="MIC 7:18">meredetibu lau igañi lun sun dan.<verse eid="MIC 7:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="MIC 7:19" />Gudemehabuyabá woun,</para>
  <para style="q" vid="MIC 7:19">bunabei wariban,</para>
  <para style="q" vid="MIC 7:19">chübei wafigoun</para>
  <para style="q" vid="MIC 7:19">lidoun lilulin-agei barana.<verse eid="MIC 7:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="MIC 7:20" />Ítaramemeba lau gúnfuli</para>
  <para style="q" vid="MIC 7:20">luma ínsiñehabuni le uágubei meha</para>
  <para style="q" vid="MIC 7:20">bariñaga houn wagüchagu</para>
  <para style="q" vid="MIC 7:20">Abüraámü luma Hakobu!<verse eid="MIC 7:20" /></para>
  <chapter eid="MIC 7" />
</usx>