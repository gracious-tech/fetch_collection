<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">AMOSU.TXT (Encoding update 2008) 27/02/2001 CAP C.R, GARIFUNA</book>
  <para style="h">Amosu</para>
  <para style="toc3">Amos</para>
  <para style="toc2">Amosu</para>
  <para style="toc1">Amosu</para>
  <para style="mt2">Liliburun</para>
  <para style="mt1">AMOSU</para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="ms">I. Labeichún Néchani Burí Le Yarafabei</para>
  <para style="mr">(<ref loc="AMO 1:1-2:5">1.1—2.5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />Anihán uganu le libihubei Amosu, le hóuniri mudún Tekóa, lúmagiñe Wabungiute libügürü Ísüraeli, bián irumu lubaragiñe hárabaganali, lidan lidaani Usíasi le lurúeite Hudá, luma Heroboamü, le liráü Hoasi, lurúeite Ísüraeli.<verse eid="AMO 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="AMO 1:2" />Dan le laganbagüdüni Wabureme lumalali,</para>
  <para style="q" vid="AMO 1:2">le ítarabei kei wayuhuru luéigiñe wübü Sión, uburugu Herusalén,</para>
  <para style="q" vid="AMO 1:2">saüti sagadi, mabei ligía luwübüri Karümélu.<verse eid="AMO 1:2" /></para>
  <para style="s1">Lasiadiruni Bungiu ageiraü le yarafabei lun Ísüraeli</para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 1:3" />Lariñahare Bungiu:</para>
  <para style="q" vid="AMO 1:3">«Gasu nabeichuniña Damasükuna ladüga adügaaña saragu wuribani;</para>
  <para style="q" vid="AMO 1:3">ladüga hamuligiduniña lílana Galaadü lau amuligülei lauti gürabu.<verse eid="AMO 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 1:4" />Ligía náguduboun lubéi lúbaana larúeihan Asaeli,</para>
  <para style="q" vid="AMO 1:4">ani láguduboun watu ligía lani burí Ben-adadü palasiu.<verse eid="AMO 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 1:5" />Nadaarubei burí lubenari Damasüku lau erei;</para>
  <para style="q" vid="AMO 1:5">nagünrinchagubei le arúeihabei Bikatü-awén</para>
  <para style="q" vid="AMO 1:5">luma le agumadihabei Betü-edén,</para>
  <para style="q" vid="AMO 1:5">hanaawaguba Síriana adaürawagúa uburugu Kirü».</para>
  <para style="q" vid="AMO 1:5">Aburemei ariñagubalin.<verse eid="AMO 1:5" /></para>
  <para style="s1">Filistéa</para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 1:6" />Lariñahare Aburemei:</para>
  <para style="q" vid="AMO 1:6">«Gasu nabeichuniña Gásana ladüga adügaaña saragu wuribani,</para>
  <para style="q" vid="AMO 1:6">barǘ hamutiña lílana aban fulasu dayarüti kei adaürǘtiña</para>
  <para style="q" vid="AMO 1:6">aba haluguruniña keisi idamuni uburugu Edomu.<verse eid="AMO 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 1:7" />Ligía nágudubei lubéi burí lubarieirun Gasa,</para>
  <para style="q" vid="AMO 1:7">ani láguduboun watu ligía lani burí palasiu.<verse eid="AMO 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 1:8" />Nagünrinchagubei le arúeihabei Asüdódu</para>
  <para style="q" vid="AMO 1:8">luma le agumadihabei Asükalón.</para>
  <para style="q" vid="AMO 1:8">Nábürühaba luagun Ekürón lau nubafu,</para>
  <para style="q" vid="AMO 1:8">dagá lumoun lagumuhóun Filistéana lóunweba!»</para>
  <para style="q" vid="AMO 1:8">Aburemei ariñagubalin.<verse eid="AMO 1:8" /></para>
  <para style="s1">Tiru</para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 1:9" />Lariñahare Bungiu:</para>
  <para style="q" vid="AMO 1:9">«Gasu nabeichuniña Tíruna ladüga adügaaña saragu wuribani;</para>
  <para style="q" vid="AMO 1:9">ani derege hamutiña lílana aban fulasu dayarüti</para>
  <para style="q" vid="AMO 1:9">ha úmabaña adügaaña lan aban daradu</para>
  <para style="q" vid="AMO 1:9">keisi íbirigu labun lubafu Edomu.<verse eid="AMO 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 1:10" />Ligía nágudubei lubéi burí lubarieirun Tiru,</para>
  <para style="q" vid="AMO 1:10">ábame lágudunu watu ligía lani burí palasiu».<verse eid="AMO 1:10" /></para>
  <para style="s1">Edomu</para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 1:11" />Lariñahare Bungiu:</para>
  <para style="q" vid="AMO 1:11">«Gasu nabeichuniña Edomuna ladüga adügaaña saragu wuribani,</para>
  <para style="q" vid="AMO 1:11">ladüga héibaahaniña Ísüraelina</para>
  <para style="q" vid="AMO 1:11">tau hefeinte háhaburugu lun háfaraguniña hilagubei</para>
  <para style="q" vid="AMO 1:11">ígiraguagüdatiña houngua lun hagañi,</para>
  <para style="q" vid="AMO 1:11">meredehati hayereehabu.<verse eid="AMO 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 1:12" />Ligía nágudubei lubéi Temán,</para>
  <para style="q" vid="AMO 1:12">ábame lágudunu watu ligía lani burí Bosurá palasiu».<verse eid="AMO 1:12" /></para>
  <para style="s1">Amón</para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 1:13" />Lariñahare Bungiu:</para>
  <para style="q" vid="AMO 1:13">«Gasu nabeichuniña Amonna</para>
  <para style="q" vid="AMO 1:13">ladüga adügaaña saragu wuribani;</para>
  <para style="q" vid="AMO 1:13">ladüga habusenrun haweiridagüdüni hamúan,</para>
  <para style="q" vid="AMO 1:13">aba hadarahani haragei würiña dageinatiña lóubawagu Galaadü.<verse eid="AMO 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 1:14" />Ligía nágudubei lubéi burí lubarieirun Rabá,</para>
  <para style="q" vid="AMO 1:14">gudalóunme watu ligía lani burí palasiu labadinagua</para>
  <para style="q" vid="AMO 1:14">agúarahani lánina wuribu luma areinchuni lánina luéyuri luriban dan.<verse eid="AMO 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 1:15" />Ábame lanügǘn lurúeite</para>
  <para style="q" vid="AMO 1:15">hau sun luwügüriñanigu ha wéirigubaña</para>
  <para style="q" vid="AMO 1:15">keisi adaürǘtiña lidoun amu fulasu».</para>
  <para style="q" vid="AMO 1:15">Aburemei ariñagubalin.<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="s1">Moabü</para>
  <para style="q">
    <verse number="1" style="v" sid="AMO 2:1" />Lariñahare Bungiu:</para>
  <para style="q" vid="AMO 2:1">«Gasu nabeichuniña Moábüna ladüga adügaaña saragu wuribani;</para>
  <para style="q" vid="AMO 2:1">gudá hamuti labu lurúeite Edomu darí ladügün baligime.<verse eid="AMO 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 2:2" />Ligía nágudubei lubéi Moabü,</para>
  <para style="q" vid="AMO 2:2">ábame lágudunu watu ligía</para>
  <para style="q" vid="AMO 2:2">lani burí Keriotu palasiu;</para>
  <para style="q" vid="AMO 2:2">ábame hóunwegun Moábüna laganagua</para>
  <para style="q" vid="AMO 2:2">tíñaahan fidu luma agúarahani</para>
  <para style="q" vid="AMO 2:2">le lánina wuribu.<verse eid="AMO 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 2:3" />Nagidarubei urúei hamidanguagiñe lumutuniña;</para>
  <para style="q" vid="AMO 2:3">náfarubei hilagubei hau sun luwügüriñanigu ha wéirigubaña». Aburemei ariñagubalin.<verse eid="AMO 2:3" /></para>
  <para style="s1">Hudá</para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 2:4" />Lariñahare Bungiu:</para>
  <para style="q" vid="AMO 2:4">«Gasu nabeichuniña Hudaana</para>
  <para style="q" vid="AMO 2:4">ladüga adügaaña saragu wuribani;</para>
  <para style="q" vid="AMO 2:4">lugundun máhatiña lun heresibiruni narufudahan,</para>
  <para style="q" vid="AMO 2:4">magunfulirun haméi nilurudun,</para>
  <para style="q" vid="AMO 2:4">huduguarügü hagía hounmeme búngiugu</para>
  <para style="q" vid="AMO 2:4">ha meha únbaña háhuduragua hagübürigu.<verse eid="AMO 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 2:5" />Ligía nágudubei lubéi Hudá,</para>
  <para style="q" vid="AMO 2:5">ábame lágudunu watu lani burí Herusalén palasiu».<verse eid="AMO 2:5" /></para>
  <para style="ms">II. Labeichún Ísüraeli</para>
  <para style="mr">(<ref loc="AMO 2:6-6:14">2.6—6.14</ref>)</para>
  <para style="s1">Lasiadiruni Bungiu Ísüraeli</para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 2:6" />Lariñahare Bungiu:</para>
  <para style="q" vid="AMO 2:6">«Gasu nabeichuniña Ísüraelina</para>
  <para style="q" vid="AMO 2:6">ladüga adügaaña saragu wuribani;</para>
  <para style="q" vid="AMO 2:6">alugura hamuti le madurunbei luagu seinsu,</para>
  <para style="q" vid="AMO 2:6">alugura haméi le gudemebei tuagu aban feru geidi.<verse eid="AMO 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 2:7" />Rútiña lidere dan houn gudemetiña,</para>
  <para style="q" vid="AMO 2:7">máhatiña híchuguni haricha ha ǘnabugububaña houn.</para>
  <para style="q" vid="AMO 2:7">Úguchili luma liráü aganawatiña tuma ábanmeme würi,</para>
  <para style="q" vid="AMO 2:7">awiyedei niri le Sándubei.<verse eid="AMO 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 2:8" />Róuntiña tigibuagu daüguaü to ichugútu houn</para>
  <para style="q" vid="AMO 2:8">lun heigin lidan hiri guáriua;</para>
  <para style="q" vid="AMO 2:8">agañeihatiña diwéin lau seinsu</para>
  <para style="q" vid="AMO 2:8">le haguburahan lau marichaü,</para>
  <para style="q" vid="AMO 2:8">aba hátunu litenpulunrugu habungiute.<verse eid="AMO 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 2:9" />Gama lumoun lau sun lira,</para>
  <para style="q" vid="AMO 2:9">günringua numutiña Amoruna lun gayaraabei lan hásügürün,</para>
  <para style="q" vid="AMO 2:9">günringua numutiña le gumuti lau sun gágubu burí hamá kei hibúari,</para>
  <para style="q" vid="AMO 2:9">here hagía kei róbüle.<verse eid="AMO 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 2:10" />Ánheinti huguya, sagá numutün Ehiptugiñe</para>
  <para style="q" vid="AMO 2:10">aba nadundehanün luagu bián-wein irumu lidan fulasu mageirawati</para>
  <para style="q" vid="AMO 2:10">lun níchuguni hamúan Amoruna hun.<verse eid="AMO 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 2:11" />Ani siñati hasigeneruni huguya Ísüraelina,</para>
  <para style="q" vid="AMO 2:11">luagu ñéinñanu lan hídangiñe nadügün profetagume,</para>
  <para style="q" vid="AMO 2:11">híbiri keisi nasaréugu».</para>
  <para style="q" vid="AMO 2:11">Aburemei ariñagubalin.<verse eid="AMO 2:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="AMO 2:12" />«Gama lumoun huguya,</para>
  <para style="q" vid="AMO 2:12">fosu humutiña nasaréugu lun hatun diwéin,</para>
  <para style="q" vid="AMO 2:12">wéridi humaña profetagu luéi hadimurehan lidan niri.<verse eid="AMO 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 2:13" />Nakünringüdübei múa lábugiñe hugudi,</para>
  <para style="q" vid="AMO 2:13">kei takünrinhan aban kareta buin lau türigu.<verse eid="AMO 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 2:14" />Íbinime héibaagun, mesefubadün;</para>
  <para style="q" vid="AMO 2:14">lalouguaduba lere le héretimabei,</para>
  <para style="q" vid="AMO 2:14">mesefubei ni le ganigitimabei.<verse eid="AMO 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 2:15" />Mawandunbei le achüühabei gimara,</para>
  <para style="q" vid="AMO 2:15">mesefubei ni le óufubei,</para>
  <para style="q" vid="AMO 2:15">ni le gabayuaguti.<verse eid="AMO 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="AMO 2:16" />Lídanme weyu ligía,</para>
  <para style="q" vid="AMO 2:16">íbini le ganigitimabei hádangiñe wuriburuguna,</para>
  <para style="q" vid="AMO 2:16">láguruboun lárumate luáriua lun gayara lan lanurahan».</para>
  <para style="q" vid="AMO 2:16">Aburemei ariñagubalin.<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="s1">Lidasin Profeta</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />Ísüraelina, aganba huméi le lariñagubei Wabureme houn gürigia ha lasagarubaña Ehiptugiñe:<verse eid="AMO 3:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="AMO 3:2" />«Huguyarügüñein nanúadira hádangiñe sun gürigia ubouagu.</para>
  <para style="q" vid="AMO 3:2">Ligía naguseragüdübadün lubéi luagu sun wuribani le adüga humaalibei».<verse eid="AMO 3:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="AMO 3:3" />Ánhaña éibuga bián gürigia úara,</para>
  <para style="q" vid="AMO 3:3">gagundanrügühaña lun ítara luba lan;<verse eid="AMO 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 3:4" />anhein adürürüha liñún áraabu,</para>
  <para style="q" vid="AMO 3:4">gáliruhalirügü liña;</para>
  <para style="q" vid="AMO 3:4">anhein adürüha liraüraü liñún lagadábugiñe dübü,</para>
  <para style="q" vid="AMO 3:4">ragühalirügü liña somu katei;<verse eid="AMO 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 3:5" />anhein ábürüha aban dunuru múarugun,</para>
  <para style="q" vid="AMO 3:5">ñéinñounrügü liña aban sádara,</para>
  <para style="q" vid="AMO 3:5">anhoun achubara sádara múarugugiñe,</para>
  <para style="q" vid="AMO 3:5">ragüharurügü liña somu katei;<verse eid="AMO 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 3:6" />dan le tínwinrun fidu uburugu,</para>
  <para style="q" vid="AMO 3:6">hüchütiña gürigia;</para>
  <para style="q" vid="AMO 3:6">dan le lasuseredun somu katei wuribati uburugu,</para>
  <para style="q" vid="AMO 3:6">Bungiu ígirubei lun lasusereduba lan.<verse eid="AMO 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 3:7" />Madügünti Wabureme ni kata</para>
  <para style="q" vid="AMO 3:7">masubudiragüdüngalei houn lani profetagu.<verse eid="AMO 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 3:8" />Ka madadagarunbei lau anufudei dan le ladürürühan liñún?</para>
  <para style="q" vid="AMO 3:8">Ka madimurehanbei lidan liri</para>
  <para style="q" vid="AMO 3:8">Wabureme anhein ariñaga lun, lun ladügüni?<verse eid="AMO 3:8" /></para>
  <para style="s1">Lagünrinchawagun uburugu Samaria</para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 3:9" />Ariñaga humá tidan burí lani Asüdódu</para>
  <para style="q" vid="AMO 3:9">luma tidan burí lani Ehiptu palasiu:</para>
  <para style="q" vid="AMO 3:9">«Higougu luagun burí luwübüri Samaria;</para>
  <para style="q" vid="AMO 3:9">ariha huméi chagaguaü luma anarimeni le ñeinbei».<verse eid="AMO 3:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="AMO 3:10" />Lariñahare Bungiu:</para>
  <para style="q" vid="AMO 3:10">«Madügüntiña ni kata lau úaraguni;</para>
  <para style="q" vid="AMO 3:10">le katei le híweruhabei lau anarimeni;</para>
  <para style="q" vid="AMO 3:10">areida hamuti tidan hani palasiu».<verse eid="AMO 3:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="AMO 3:11" />Lariñahare lubeiti Bungiu:</para>
  <para style="q" vid="AMO 3:11">«Legeyedagubei aban ágani fulasu</para>
  <para style="q" vid="AMO 3:11">lagünrinchagubei buburugute le derebugutimabei</para>
  <para style="q" vid="AMO 3:11">ábame lasagarahanu burí bani palasiu».<verse eid="AMO 3:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="AMO 3:12" />Lariñahare Wabureme:</para>
  <para style="q" vid="AMO 3:12">«Ítara kei lesefurun hóuniri mudún bián ugudi</para>
  <para style="q" vid="AMO 3:12">o aban lan lígiri arigei liyumulugugiñe liñún,</para>
  <para style="q" vid="AMO 3:12">ítara luba giñe fiúrügübaña lan Ísüraelina</para>
  <para style="q" vid="AMO 3:12">ha aganóubaña Samaria esefura,</para>
  <para style="q" vid="AMO 3:12">ha abalachubaña luagu burí haláü</para>
  <para style="q" vid="AMO 3:12">wéndeburiti le Damasükuna».<verse eid="AMO 3:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="AMO 3:13" />Lariñahare Bungiu Suntigabafu:</para>
  <para style="q" vid="AMO 3:13">«Aganba humá, ru humá hadurun lumutuniña Hakobu,<verse eid="AMO 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 3:14" />ladüga wéyume naguseragüdüni Ísüraeli luagu lifigoun,</para>
  <para style="q" vid="AMO 3:14">nagünrinchagubei lani burí Beteli latarü,</para>
  <para style="q" vid="AMO 3:14">ladürühóuba liganchun latarü</para>
  <para style="q" vid="AMO 3:14">ábame lábürühan múarugun.<verse eid="AMO 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 3:15" />Nagünrinchaguboun burí haban to áraabuboun tuma to áüdübuboun</para>
  <para style="q" vid="AMO 3:15">nagumuchaguagüdübóun burí muna to wéndeburitu,</para>
  <para style="q" vid="AMO 3:15">günringuanóunme tuéinamun palasiu».</para>
  <para style="q" vid="AMO 3:15">Aburemei ariñagubalin.<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="q">
    <verse number="1" style="v" sid="AMO 4:1" />«Aganba huméi katei le würiña wéirigutiña Samaria,</para>
  <para style="q" vid="AMO 4:1">ha dibunebaña kei bágasu Basanna,</para>
  <para style="q" vid="AMO 4:1">huguya le íchugubei lidere dan houn gudemetiña,</para>
  <para style="q" vid="AMO 4:1">óuseragua humaña ha mégeihabubaña,</para>
  <para style="q" vid="AMO 4:1">huguya ha ariñagubaña houn heyeritegu</para>
  <para style="q" vid="AMO 4:1">lun hanügün diwéin hun lun hatun.<verse eid="AMO 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 4:2" />Fiñuti Aburemei luagu liri le sándubei:</para>
  <para style="q" vid="AMO 4:2">Anitebei dan lun haduruuhóun huguya</para>
  <para style="q" vid="AMO 4:2">hama hisaanigu lau günwi bóugudin luéi uburugu,</para>
  <para style="q" vid="AMO 4:2">kamá hamuga úduraü,</para>
  <para style="q" vid="AMO 4:2">mesefubei ni aban hídangiñe.<verse eid="AMO 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 4:3" />Háfuriduba aban lárigi aban,</para>
  <para style="q" vid="AMO 4:3">luéigiñe líhunren baríeiru</para>
  <para style="q" vid="AMO 4:3">ábame hagurún luagun wübü le Erümón».</para>
  <para style="q" vid="AMO 4:3">Aburemei ariñagubalin.<verse eid="AMO 4:3" /></para>
  <para style="s1">Lumahan Ísüraeli lun lasakürihan</para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 4:4" />«Heiba Beteli luma Gilügáli;</para>
  <para style="q" vid="AMO 4:4">hafigouha gánwoungüda huméi huriban!</para>
  <para style="q" vid="AMO 4:4">Barǘ huméi hadagaragüdün binaafin,</para>
  <para style="q" vid="AMO 4:4">Ru humeime diisi murusun lídangiñe le húmati sagü ǘrüwa weyu.<verse eid="AMO 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 4:5" />Hágudaha fein maganatu lébini keisi</para>
  <para style="q" vid="AMO 4:5">idewesei lánina eteingiruni,</para>
  <para style="q" vid="AMO 4:5">lárigiñeme ábame hidin ariñaga</para>
  <para style="q" vid="AMO 4:5">luagu rúhadün lan idewesei lau hugundan,</para>
  <para style="q" vid="AMO 4:5">kei ligía lan aubei hagundaara».</para>
  <para style="q" vid="AMO 4:5">Aburemei ariñagubalin.<verse eid="AMO 4:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="AMO 4:6" />«Áfagagüda numutün ilamaü lidan burí sun huburugute;</para>
  <para style="q" vid="AMO 4:6">adügatina lun lemegeirun éigini lidan sun hageira,</para>
  <para style="q" vid="AMO 4:6">Gama lumoun magiribudúntün nun!»</para>
  <para style="q" vid="AMO 4:6">Aburemei ariñagubalin.<verse eid="AMO 4:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="AMO 4:7" />«Adügatina giñe lun hemegeirun huya</para>
  <para style="q" vid="AMO 4:7">ǘrüwa hati lubaragiñe alubahani.</para>
  <para style="q" vid="AMO 4:7">Áhuyagüdatina huya lidan aban</para>
  <para style="q" vid="AMO 4:7">uburugu máhuyunti lidan le aban;</para>
  <para style="q" vid="AMO 4:7">áhuyati lidan aban áraabu</para>
  <para style="q" vid="AMO 4:7">máhuyunti lidan le aban,</para>
  <para style="q" vid="AMO 4:7">aba lamabeidun ladüga lúan duna;<verse eid="AMO 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 4:8" />éibugatiña gürigia lídangiñe</para>
  <para style="q" vid="AMO 4:8">aban uburugu lidoun burí amu áluaha duna,</para>
  <para style="q" vid="AMO 4:8">madaritiña le buídurügüti lun</para>
  <para style="q" vid="AMO 4:8">lagalumadun hamagürabu,</para>
  <para style="q" vid="AMO 4:8">Gama lumoun huguya magiribudúntün nun!»</para>
  <para style="q" vid="AMO 4:8">Aburemei ariñagubalin.<verse eid="AMO 4:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="AMO 4:9" />«Bei numutün lau garabali süti luma hau igei,</para>
  <para style="q" vid="AMO 4:9">sáügüda numuti hinadürigu,</para>
  <para style="q" vid="AMO 4:9">hou hamuti chagagaru hinadürigu,</para>
  <para style="q" vid="AMO 4:9">Gama lumoun magiribudúntün nun!»</para>
  <para style="q" vid="AMO 4:9">Aburemei ariñagubalin.<verse eid="AMO 4:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="AMO 4:10" />«Óunahatina igei huagun hibe</para>
  <para style="q" vid="AMO 4:10">ha nóunahabaña luagun Ehiptu,</para>
  <para style="q" vid="AMO 4:10">adügatina lun hóunwegun wügüriña nibureintiña wuriburugu,</para>
  <para style="q" vid="AMO 4:10">ígira au lun hanügüniña háganiñu hilügüniña gabayu;</para>
  <para style="q" vid="AMO 4:10">hirimichagüda numuti hingin hilaaña kianpu-ágeirugu hun,</para>
  <para style="q" vid="AMO 4:10">gama lumoun huguya magiribudúntün nun!»</para>
  <para style="q" vid="AMO 4:10">Aburemei ariñagubalin.<verse eid="AMO 4:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="AMO 4:11" />«Günringua numutün lau aban katei</para>
  <para style="q" vid="AMO 4:11">hanarimeti luriban kei le</para>
  <para style="q" vid="AMO 4:11">nóunahabei luagun Sodoma luma Gomora;</para>
  <para style="q" vid="AMO 4:11">ítara liña kei leñegura watu le sun liña</para>
  <para style="q" vid="AMO 4:11">lasagarun wáturugugiñe,</para>
  <para style="q" vid="AMO 4:11">gama lumoun huguya magiribudúntün nun!»</para>
  <para style="q" vid="AMO 4:11">Aburemei ariñagubalin.<verse eid="AMO 4:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="AMO 4:12" />«Ligía lubeiti, Ísüraeli, ligiamémeba giñe nadüga bun.</para>
  <para style="q" vid="AMO 4:12">Ani kei nadügübei lubéi,</para>
  <para style="q" vid="AMO 4:12">aransebá lun bagagibudagun luma Bubungiute!»<verse eid="AMO 4:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="AMO 4:13" />Aburemei, le adügübalin burí áraabu luma garabali,</para>
  <para style="q" vid="AMO 4:13">le asubudiragüdübalin laritagun houn gürigia,</para>
  <para style="q" vid="AMO 4:13">le asansiragubalin larugounga lidoun luburiga,</para>
  <para style="q" vid="AMO 4:13">le éibugubalin liñun-agei múa,</para>
  <para style="q" vid="AMO 4:13">Aburemei Suntigabafu, ligía líribei.<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s1">Agúaruni lun lagiribudúniwa lun Bungiu</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />Aganba huméi nererun, Ísüraelina; aganba huméi uremu híruti le neremuhabei huagu:<verse eid="AMO 5:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="AMO 5:2" />«Ábürüha Ísüraeli le wéndebei ani haruma</para>
  <para style="q" vid="AMO 5:2">kei aban würi to mámarigiru;</para>
  <para style="q" vid="AMO 5:2">ábürüha lun másaarunhali lan,</para>
  <para style="q" vid="AMO 5:2">ábürüha lumúanrugu guánarügü,</para>
  <para style="q" vid="AMO 5:2">ani úati kaba lan ásaaragüdei».<verse eid="AMO 5:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="AMO 5:3" />Ítara liña lariñagun Wabungiute houn Ísüraelina: «Anhein óunaha aban uburugu</para>
  <para style="q" vid="AMO 5:3">milu wügüriña wuriburugun,</para>
  <para style="q" vid="AMO 5:3">sánrügübaña agiribuda wínwanñu;</para>
  <para style="q" vid="AMO 5:3">anhein óunaha san,</para>
  <para style="q" vid="AMO 5:3">díisirügübaña agiribuda».<verse eid="AMO 5:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="AMO 5:4" />Ítara liña lariñagun Wabureme houn Ísüraelina:</para>
  <para style="q" vid="AMO 5:4">«Ñübuin humá numoun, gabagari humaamuga.<verse eid="AMO 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 5:5" />Midin humá Betelin, midin humá Gilügálin</para>
  <para style="q" vid="AMO 5:5">másügürün huguyame Bérüsewagiñe,</para>
  <para style="q" vid="AMO 5:5">ladüga chóuruti lanügǘn Gilügáli adaürǘwa luma lagünrinchawagun Beteli».<verse eid="AMO 5:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="AMO 5:6" />Ñübuin humá lun Wabureme, ábame gabagari humá;</para>
  <para style="q" vid="AMO 5:6">anhein madügün humá ítara,</para>
  <para style="q" vid="AMO 5:6">lóunahaba watu gemeti luagun Ísüraeli,</para>
  <para style="q" vid="AMO 5:6">ani úabei ni aban lun léñeguchuni watu ligía Beteli.<verse eid="AMO 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 5:7" />Fugiabugu huguya ha agifidagüdübalin irichaü,</para>
  <para style="q" vid="AMO 5:7">huguya ha águrubalin irichaü múarugun!<verse eid="AMO 5:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8-9" style="v" sid="AMO 5:8-9" />Wabureme le adügübaliña waruguma ha siélubaña</para>
  <para style="q" vid="AMO 5:8-9">ligía adügübalin áriebu lun wéyuagume,</para>
  <para style="q" vid="AMO 5:8-9">adügaléi wéyuagu lun áriebume le búrigati;</para>
  <para style="q" vid="AMO 5:8-9">ligía agúarubei lun lidunari barana</para>
  <para style="q" vid="AMO 5:8-9">aba láturuni luagun múa;</para>
  <para style="q" vid="AMO 5:8-9">ligía óunahabei günringuaü luagun uburugu derebuguti</para>
  <para style="q" vid="AMO 5:8-9">gumuguagüda laaña gabafutiña.</para>
  <para style="q" vid="AMO 5:8-9">Aburemei, ligía líribei.<verse eid="AMO 5:8-9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="AMO 5:10" />Fugiabugu huguya le iyereehabúbei</para>
  <para style="q" vid="AMO 5:10">lun le adügübei irichaü,</para>
  <para style="q" vid="AMO 5:10">mínsiñe ligía gefenti le úaraguabei hun!<verse eid="AMO 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 5:11" />Kei dügügua hubalin gudemeti,</para>
  <para style="q" vid="AMO 5:11">aguburaha huguya liseinsun lúrudu lúmagiñe tuagu türigu,</para>
  <para style="q" vid="AMO 5:11">maganóunbadün tidan burí muna lautu dübü to hábunaguboun,</para>
  <para style="q" vid="AMO 5:11">matun huguyame diwéin tídangiñe</para>
  <para style="q" vid="AMO 5:11">beibei to hábunaguboun.<verse eid="AMO 5:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="AMO 5:12" />Subudi numuti liibe hifigoun luma huriban:</para>
  <para style="q" vid="AMO 5:12">Rutün lidere dan lun le richaguabei,</para>
  <para style="q" vid="AMO 5:12">resibitün seinsu lun madügün humá irichaü</para>
  <para style="q" vid="AMO 5:12">tidan lúbaana aguseruni,</para>
  <para style="q" vid="AMO 5:12">féridigüda humuti likesin gudemeti lun lidan guséi.<verse eid="AMO 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 5:13" />Ligía lubeiti le chubei aau maniti</para>
  <para style="q" vid="AMO 5:13">ladüga wuribaali dan le ídanbei waganawa.<verse eid="AMO 5:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="AMO 5:14" />Áluaha huméi buiti, mama wuribati,</para>
  <para style="q" vid="AMO 5:14">ábame gabagari humá;</para>
  <para style="q" vid="AMO 5:14">ítara luba inarüni lan le hariñagubei:</para>
  <para style="q" vid="AMO 5:14">Luagu anihein lan Wabureme Suntigabafu huma.<verse eid="AMO 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 5:15" />Iyereegulá wuribani hun! Hínsiñela le buídubei hun!</para>
  <para style="q" vid="AMO 5:15">Chóurugua humá hungua luagu rúa lan</para>
  <para style="q" vid="AMO 5:15">liricha gürigia lun lidan aguseruni;</para>
  <para style="q" vid="AMO 5:15">háfuga ítara luba gudemehabu lan Wabureme</para>
  <para style="q" vid="AMO 5:15">Suntigabafu houn lánigu Ísüraeli ha wínwangiñabaña.<verse eid="AMO 5:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="AMO 5:16" />Ítara liña lariñagun Wabureme Suntigabafu:</para>
  <para style="q" vid="AMO 5:16">«Ñeinbei ayahuni lidan sun burí párüke,</para>
  <para style="q" vid="AMO 5:16">ñeinbei agúarahani lánina igarigu ǘmadarugu.</para>
  <para style="q" vid="AMO 5:16">Laguarúba lun nadagimeinti áraabu lun lamuiserun,</para>
  <para style="q" vid="AMO 5:16">laguarúba houn gayahuahaditiña hilaaña lun hayahun.<verse eid="AMO 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="AMO 5:17" />Hayahuba lidan sun beibei-agei danme niabin abeichaün».</para>
  <para style="q" vid="AMO 5:17">Aburemei ariñagubalin.<verse eid="AMO 5:17" /></para>
  <para style="s1">Luéyuri Wabureme</para>
  <para style="q">
    <verse number="18" style="v" sid="AMO 5:18" />Fugiabugu ha óurabahoubaña lubá lachülürün luéyuri Wabureme!</para>
  <para style="q" vid="AMO 5:18">Subudi humuti ida luba lan weyu ligía hun?</para>
  <para style="q" vid="AMO 5:18">Luéyuribei luburiga, mama larugounga.<verse eid="AMO 5:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="AMO 5:19" />Ítara luba kei dan le léibaagun</para>
  <para style="q" vid="AMO 5:19">gürigia luéi aban liñún aba ladunragun</para>
  <para style="q" vid="AMO 5:19">luma aban osu, o kei lan dan le lebelurun gürigia</para>
  <para style="q" vid="AMO 5:19">lúbiñoun aba labalachun touba muna,</para>
  <para style="q" vid="AMO 5:19">aba tágürüni hewe.<verse eid="AMO 5:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="AMO 5:20" />Ítara luba, búrigabei luéyuri Wabureme,</para>
  <para style="q" vid="AMO 5:20">marugounganbéi, búrigabei sunsuinagubei.<verse eid="AMO 5:20" /></para>
  <para style="s1">Irichaü labusenrubei Bungiu mama adagaragüdüni</para>
  <para style="q">
    <verse number="21" style="v" sid="AMO 5:21" />«Iyereeguti fedu burí le hadügübei nun;</para>
  <para style="q" vid="AMO 5:21">magundantina lau burí hóundaragun.<verse eid="AMO 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="AMO 5:22" />Mabusenrun numuti burí adagaragüdüni</para>
  <para style="q" vid="AMO 5:22">le hadügübei lidan niri, ni hidewese le fulúaruauti;</para>
  <para style="q" vid="AMO 5:22">meresibirun nubaña burí bágasu dibunetiña lánina arandaruni ha hadagaragüdübaña.<verse eid="AMO 5:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="AMO 5:23" />Dise humá nuéi lau lamuri heremuhan!</para>
  <para style="q" vid="AMO 5:23">Mabusenruntina naganbunu hani árüpa!<verse eid="AMO 5:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="AMO 5:24" />Láwiyuha irichaü kei duna,</para>
  <para style="q" vid="AMO 5:24">luma arumani kei lísensen duna madararaditi.<verse eid="AMO 5:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="AMO 5:25" />«Huguya Ísüraelina, rutün funagia adagaragüdüni luma idewesei nun lidan bián-wein irumu le haubei lidan fulasu mageirawati? <verse eid="AMO 5:25" /><verse number="26" style="v" sid="AMO 5:26" />Guentoti gasu hóuyuahani Sikutu le hurúeite tau Kiyún, to luaruguman, guáriuagu ha guánarügü hadügübaña. <verse eid="AMO 5:26" /><verse number="27" style="v" sid="AMO 5:27" />Nígiruba lun hanügǘn keisi adaürǘtiña, yagürounmeme luéi Damasüku». Aburemei ariñagubalin. Bungiu Suntigabafu, ligía líribei.<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s1">Lagünrinchawagun Ísüraeli</para>
  <para style="q">
    <verse number="1" style="v" sid="AMO 6:1" />Fugiabugu ha ménrengubaña ibagari uburugu Sión!</para>
  <para style="q" vid="AMO 6:1">Fugiabugu ha chóuruguabaña houngua uburugu Samaria,</para>
  <para style="q" vid="AMO 6:1">hábutigu néchanigu ha wéirigutimabaña</para>
  <para style="q" vid="AMO 6:1">ha úmounbaña houdin Ísüraelina!<verse eid="AMO 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 6:2" />Heiba Kalüné, harihame;</para>
  <para style="q" vid="AMO 6:2">ñéingiñeme hídinme Amatü le wéiribei,</para>
  <para style="q" vid="AMO 6:2">hararirame uburugun Gatü le hani Filistéana,</para>
  <para style="q" vid="AMO 6:2">buídutimatün funagia luéi burí ageiraü ligía?</para>
  <para style="q" vid="AMO 6:2">Buídutimati funagia hageira sügǘ lau hageira gürigia hagía?<verse eid="AMO 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 6:3" />Máhatün lun hasaminarun luagu dan le wuribabei,</para>
  <para style="q" vid="AMO 6:3">gama lumoun hachawahañein larúeihan anarimeni.<verse eid="AMO 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 6:4" />Luagu burí haláü le lauti</para>
  <para style="q" vid="AMO 6:4">marüfíli habalacha lidan hufedun;</para>
  <para style="q" vid="AMO 6:4">hau mudún ñǘbürigiña hama</para>
  <para style="q" vid="AMO 6:4">bágasu dibunetiña hadinera;<verse eid="AMO 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 6:5" />Win humutu fidu, lagübüri íñaahani;</para>
  <para style="q" vid="AMO 6:5">áyeiha humuti Dawidi adaagua uremu</para>
  <para style="q" vid="AMO 6:5">ani hínsiñeti hun heremuhani áfareina árüpa,<verse eid="AMO 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 6:6" />lidan burí weru wéinamuti hata diwéin,</para>
  <para style="q" vid="AMO 6:6">yusu humuti lifinun-agei ibiñein,</para>
  <para style="q" vid="AMO 6:6">mebereseguntün lau günringuaü le gádanbalin ageiraü!<verse eid="AMO 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 6:7" />Huguyaba furumiñetiña anügǘtiña keisi adaürütiña,</para>
  <para style="q" vid="AMO 6:7">ábame lagumuchagun lachagaragun hadinerun.<verse eid="AMO 6:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8" />Fiñuhali Wabureme luougua guánarügü; Wabungiute le Suntigabafu ariñagubalin:</para>
  <para style="b" vid="AMO 6:8" />
  <para style="q" vid="AMO 6:8">«Iyereeguti hapantan lumutuniña Hakobu nun;</para>
  <para style="q" vid="AMO 6:8">mínsiñetu burí hani palasiu nun;</para>
  <para style="q" vid="AMO 6:8">nederegerubei uburugu houn áganiñu lau sun le lídanbei».<verse eid="AMO 6:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />Ánhañati eredera diisi wügüriña tidan aban muna, hóunweguba díisigubei. <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />Wéiribei lanarimenouga, darime lun danme lan lálugun aban gürigia labuduni aban liduhe le hilaali; lariñaguba lun ábanya liduhe le ñeinti múnada: «Anihein amu gürigia buma ya?» Lariñagame lun, «úati». Lariñagame le furumiñeti: «Maniba, íridadügübiñalin liri Wabureme!» <verse eid="AMO 6:10" /><verse number="11" style="v" sid="AMO 6:11" />Ladüga labeichuboun Wabureme muna burí wéinamutu tuma ñǘbüritu, tagünrinchawaguba sunsuinagubei.<verse eid="AMO 6:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="AMO 6:12" />Gayaraati funagia hawarirun gabayu luéigiñe dübü?</para>
  <para style="q" vid="AMO 6:12">Gayaraati funagia lawouhóun baranaha?</para>
  <para style="q" vid="AMO 6:12">Huguya adüga humaali irichaü péisinime,</para>
  <para style="q" vid="AMO 6:12">gífigüda humaali lin irichaü!<verse eid="AMO 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 6:13" />Huguya, gúndaaguatün le málati hariñaga:</para>
  <para style="q" vid="AMO 6:13">«Ragühadiwa ubafu lau were guánarügü».<verse eid="AMO 6:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 6:14" />Ariha humá san buidu, Ísüraelina,</para>
  <para style="q" vid="AMO 6:14">lariñahare Wabureme Suntigabafu:</para>
  <para style="q" vid="AMO 6:14">«Nóunahaba aban néchani huagun</para>
  <para style="q" vid="AMO 6:14">le lunbei líchugun lidere dan hun le gumuti,</para>
  <para style="q" vid="AMO 6:14">lúmagiñe luéigiñe nórute darí luagun suru».<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="ms">III. Luénedü Burí Amosu</para>
  <para style="mr">(<ref loc="AMO 7-9">7—9</ref>)</para>
  <para style="s1">Furumiñeti uénedü: Chagagaru</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />Anihán katei le larufudubei Wabureme nun. Dan le lagumeserunbei nadü le tárübei láhüchün áhücha, le adügǘbei lárigiñe alubahani le lani urúei, aba narihini Wabureme adaagua chagagaru. <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />Dan le héigiñein lubéi chagagaru lagumuhóun híduru aba nariñagun:</para>
  <para style="p" vid="AMO 7:2">—Bungiu Baba, ferudunabawa! Ida lubagia hawandun bumutuniña Ísüraelina, míbetiñaga?<verse eid="AMO 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3" />Ábati madügün lani Wabureme le yebe laritagubei ladügün, aba lariñagun:</para>
  <para style="p" vid="AMO 7:3">—Masuseredunbei katei le!<verse eid="AMO 7:3" /></para>
  <para style="s1">Libiaman uénedü: Watu gemeti</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />Anihán katei le larufudubei Wabureme nun: Ariha numuti óunaha watu gemeti, aba lamabeidun barana sunsuinagubei, gumuguagüdalei murusun lídangiñe múa. <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />Aba nariñagun:</para>
  <para style="p" vid="AMO 7:5">—Fuleseihabubá, Wabureme, ráramabei búhabu! Ida lubagia hawanduni Ísüraelina ha bumutuniña katei le, míbetiñaga?<verse eid="AMO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6" />Ábati madügün lani Wabureme laritagun, aba lariñagun:</para>
  <para style="p" vid="AMO 7:6">—Masuseredunbei giñe katei le!<verse eid="AMO 7:6" /></para>
  <para style="s1">Lǘrüwan uénedü: Pulomulaini</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />Arufuda lumuti giñe Wabureme katei le nun: Lubaduñein aban baríeiru, lau aban hani gábunaguaditiña muna pulomulaini lúhaburugu. <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />Aba lariñagun nun:</para>
  <para style="p" vid="AMO 7:8">—Ka barihubei, Amosu?</para>
  <para style="p" vid="AMO 7:8">Nariñaga lun:</para>
  <para style="p" vid="AMO 7:8">—Aban hani gábunaguaditiña muna pulomulaini.</para>
  <para style="p" vid="AMO 7:8">Lariñagati nun:</para>
  <para style="p" vid="AMO 7:8">—Lauba pulomulaini le narihei ida liña lan lísurun hagaburi Ísüraelina ha numutuniña. Úadigiaali feruduna nániña. <verse eid="AMO 7:8" /><verse number="9" style="v" sid="AMO 7:9" />Tagünrinchawaguba burí lani Isaakü sanduariu, tárigirugurügüba burí litenpulun Ísüraeli eredera Niñuruboun nefeinte hawagun liduheñu Heroboamü!<verse eid="AMO 7:9" /></para>
  <para style="s1">Lagagibudagun Amosu luma Amasíasi</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />Aba lóunahan Amasíasi le lufadirin Beteli ariñaga lun Heroboamü le lurúeite Ísüraeli:</para>
  <para style="p" vid="AMO 7:10">—Anihein Amosu hadan lumutuniña Ísüraeli eledegua hubá urúei. Buchá hawagu lílana fulasu aganbei ladimurehan, mawandun hamaali. <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />Lugundun lariñahare: «Lafarúba Heroboamü tau eféin, hanügǘba sun Ísüraelina keisi adaürǘtiña».<verse eid="AMO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />Aba lariñagun Amasíasi lun Amosu:</para>
  <para style="p" vid="AMO 7:12">—Beiba yáagiñe, profeta! Anhein busén bubéi buadigimaridun keisi profeta, beiba Hudáun; <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />gama lumoun hebé bayanuhan ya Beteli, lugundun lani urúei sanduariu Beteli, ani anuhán giñe litenpulun arúeihani to wéirigutimaboun.<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />Aba lóunabuni Amosu, lariñaga lun:</para>
  <para style="p" vid="AMO 7:14">—Mama au profeta, máluahantina giñe nanügǘn keisi profeta. Lau nóunigirun mudún luma nabudahan igu áraabuna nagañeiroun neigan fein, <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />gama lumoun aba lagidarunina Wabureme lídangiñe nóunigirun mudún, aba lariñagun nun: «Beiba adimureha houn Ísüraelina ha numutuniña lidan niri». <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />Aganbabéi lubeiti lererun Wabureme. Bariñahare nun: «Madimurehabá ni kata lidan liri Bungiu kóntüra Ísüraelina; mariñagun buguyame ni kata hawagu ladügawagun Isaakü». <verse eid="AMO 7:16" /><verse number="17" style="v" sid="AMO 7:17" />Gama lumoun anihán le lariñagubei Aburemei: «Tahoruhaba búmari uburugu, háfarawaguba giñe birahüñü tau eféin; lafanreinhouba bumúan lau ubunuruni; ánheinti buguya bóunweba hamúanrugu gibe tubungiutegu, hanaawaguba giñe Ísüraelina keisi adaürütiña dise luéi hageira».<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s1">Ligadürün uénedü: Faniñe tau in funaaru</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />Anihán katei le larufudubei Wabureme nun: Ñeinñein aban faniñe tau in funaaru, <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />aba lariñagun nun:</para>
  <para style="p" vid="AMO 8:2">—Ka barihubei Amosu?</para>
  <para style="p" vid="AMO 8:2">Nariñaga lun:</para>
  <para style="p" vid="AMO 8:2">—Aban faniñe tau in funaaru.</para>
  <para style="p" vid="AMO 8:2">Aba lariñagun nun:</para>
  <para style="p" vid="AMO 8:2">—Funaali Ísüraeli; úadigiaali ferudunanani. <verse eid="AMO 8:2" /><verse number="3" style="v" sid="AMO 8:3" />Lídanme weyu ligía, lasansiraguba eremuhani palasiurugu lun ayahunime. Hóunweguba saragu gürigia, ábame hachagarún lidan furumiñeguarügü fulasu. Wabureme ariñagubalin.<verse eid="AMO 8:3" /></para>
  <para style="s1">Layarafadun laguserun Ísüraeli</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 8:4" />Aganba huméi katei le, huguya le íchugubei lidere dan houn ha ǘnabugububaña, ani ñoungua huméi hawaguti lílana fulasu ha gudemebaña, <verse eid="AMO 8:4" /><verse number="5" style="v" sid="AMO 8:5" />huguya le ariñagubei: «Ídaba san lásügüra lufedun iseri hati lun gayara lan waluguruni türigu? Ídaba lásügüra luéyuri emeraaguni lun walugurahan seru, lau amisuraagülei luma balansu le íweruhati luagu wafulesein? <verse eid="AMO 8:5" /><verse number="6" style="v" sid="AMO 8:6" />Wañoundagubei hawaguti gudemetiña darime lun haluguragun houngua woun keisi idamuni, lun hafayeiruni hadúeihan, íbini ábanrügü tan feru geidi hadúeirun! Walugurubei íbini life türigu!»<verse eid="AMO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7" />Fiñuhali Wabureme luagu luéirigun Hakobu: «Mabulieidúndügü nubéi le hadügübei».<verse eid="AMO 8:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="AMO 8:8" />Madadagarunbei san múa ladüga sun katei le?</para>
  <para style="q" vid="AMO 8:8">Mayahuahanbaña san lílana fulasu?</para>
  <para style="q" vid="AMO 8:8">Lamudeiruba múa rarí ligíame</para>
  <para style="q" vid="AMO 8:8">ítara kei lamudeirun ani rarí ligía lidunari Nilu!<verse eid="AMO 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 8:9" />Lariñahare Wabureme: «Lídanme weyu ligía,</para>
  <para style="q" vid="AMO 8:9">nadügüba lun lálüdün weyu amidirugu,</para>
  <para style="q" vid="AMO 8:9">ábame laburigadun wéyuagu ubouagu.<verse eid="AMO 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 8:10" />Nasansirubei burí fedu lun ayahunime hárigi hilaaña,</para>
  <para style="q" vid="AMO 8:10">nasansiragubei eremuhani lun ayahunime luagu óunweni,</para>
  <para style="q" vid="AMO 8:10">nadügüba lun hadaüragun ludu,</para>
  <para style="q" vid="AMO 8:10">luma lun hásaruni hídiburi lun harufuduni higarigu.</para>
  <para style="q" vid="AMO 8:10">Hayahuba kei le ayahubei lárigi liráü le ábanrügüti,</para>
  <para style="q" vid="AMO 8:10">lídanba igifini lagumucha sun katei hun».<verse eid="AMO 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 8:11" />Lariñahare Wabureme:</para>
  <para style="q" vid="AMO 8:11">«Anitebei weyu lun nóunahan ilamaü ubouagun;</para>
  <para style="q" vid="AMO 8:11">mama ilamaü tun fein, ni mágürabu lun duna,</para>
  <para style="q" vid="AMO 8:11">ilamaü lun laganbún nererun.<verse eid="AMO 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 8:12" />Éibugañahadügübaña gürigia áluaha haganbuni lererun Wabureme;</para>
  <para style="q" vid="AMO 8:12">hóudiba lídangiñe barana Hilaali lidoun barana Mediteraniu,</para>
  <para style="q" vid="AMO 8:12">luma luéigiñe nórute darí luagun oubaü le ñéingiñe lubéi laboucha weyu,</para>
  <para style="q" vid="AMO 8:12">gama lumoun madarihabei.<verse eid="AMO 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 8:13" />Lídanme dan ligía würiña nibureintiña ha magadiñetiña</para>
  <para style="q" vid="AMO 8:13">hama wügüriña nibureintiña ganigitiña</para>
  <para style="q" vid="AMO 8:13">hábürühaba lau falalaü ladüga hamagürabu.<verse eid="AMO 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 8:14" />Ha burí áfiñurubaña hawagu liguariuangu Samaria;</para>
  <para style="q" vid="AMO 8:14">hariñaga:</para>
  <para style="q" vid="AMO 8:14">“Luagu libagari lubungiute Dan;</para>
  <para style="q" vid="AMO 8:14">luma luagu habagari lubungiutegu Bérüsewa</para>
  <para style="q" vid="AMO 8:14">hábürühaba lun másaarunhaña lan” ».<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s1">Liseingün uénedü: Tábürühan Sanduariu</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />Ariha numuti Wabureme, lurugabuñein latarü, lariñaga nun:</para>
  <para style="b" vid="AMO 9:1" />
  <para style="q" vid="AMO 9:1">«Áfarahabei kapitéli le tani ténpulu darime ladadagarun tuágaburi;</para>
  <para style="q" vid="AMO 9:1">Ábürühala hawagun gürigia!</para>
  <para style="q" vid="AMO 9:1">Ha erederutiña wínwanñu,</para>
  <para style="q" vid="AMO 9:1">náfaragubaña tau eféin;</para>
  <para style="q" vid="AMO 9:1">íbini hálugun hanurahan,</para>
  <para style="q" vid="AMO 9:1">úabei ni aban esefuruti;<verse eid="AMO 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 9:2" />Íbini haramudagun lábugiñe múa,</para>
  <para style="q" vid="AMO 9:2">nasagarubaña ñéingiñe,</para>
  <para style="q" vid="AMO 9:2">íbini hamudeirun luagun liñun sielu,</para>
  <para style="q" vid="AMO 9:2">narariragüdübaña ñéingiñe.<verse eid="AMO 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 9:3" />Ánhaña aramudagua lábulugu wübü le Karümélu,</para>
  <para style="q" vid="AMO 9:3">íbini ñeinhin nídiba áluahaña;</para>
  <para style="q" vid="AMO 9:3">ánhaña aramudagua baranaha,</para>
  <para style="q" vid="AMO 9:3">nóunahabei mónsturu le</para>
  <para style="q" vid="AMO 9:3">baranahabei lun láfaraguniña;<verse eid="AMO 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 9:4" />ánhaña hanüga háganiñu keisi adaürütiña,</para>
  <para style="q" vid="AMO 9:4">nóunahaboun eféin áfaraguaña.</para>
  <para style="q" vid="AMO 9:4">Ligibugiñebaña nagu súnwandan,</para>
  <para style="q" vid="AMO 9:4">lun wuribati, mama lun buiti!»<verse eid="AMO 9:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="AMO 9:5" />Wabureme le Suntigabafu,</para>
  <para style="q" vid="AMO 9:5">ligía aguurubalin ubóu aba larürüdagun,</para>
  <para style="q" vid="AMO 9:5">aba hayahun sun lílana.</para>
  <para style="q" vid="AMO 9:5">Lamudeiruba ubóu rarí ligíame</para>
  <para style="q" vid="AMO 9:5">kei lamudeirun ani rarí ligía lidunari Nilu.<verse eid="AMO 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 9:6" />Adügaali Wabureme luban sielu,</para>
  <para style="q" vid="AMO 9:6">rulei sielu lóugiñe múa;</para>
  <para style="q" vid="AMO 9:6">wati lun barana, aba láwiyuruni ligibuagun múa.</para>
  <para style="q" vid="AMO 9:6">Aburemei, ligía líribei.<verse eid="AMO 9:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="AMO 9:7" />Lariñahare Wabureme:</para>
  <para style="q" vid="AMO 9:7">«Ísüraelina, aban labu nanügünün</para>
  <para style="q" vid="AMO 9:7">kei nanügüniña Etiopíana.</para>
  <para style="q" vid="AMO 9:7">Ítara kei nanügünün Ehiptugiñe,</para>
  <para style="q" vid="AMO 9:7">ítara liña giñe nanügüniña</para>
  <para style="q" vid="AMO 9:7">Filistéana Küretagiñe hama Aramüna Kírügiñe».<verse eid="AMO 9:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="AMO 9:8" />Ariha lumuti Wabureme arúeihani, gafigounti le, lariñaga:</para>
  <para style="q" vid="AMO 9:8">«Naguludubei ligibuagugiñe ubóu,</para>
  <para style="q" vid="AMO 9:8">gama lumoun magünrinchagun nubóun luban Hakobu sunsuinagubei».</para>
  <para style="q" vid="AMO 9:8">Aburemei ariñagubalin.<verse eid="AMO 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 9:9" />«Níchugubei nererun lun tánhingichun luban Ísüraeli,</para>
  <para style="q" vid="AMO 9:9">kei tewenihóun türigu lidan táseiha,</para>
  <para style="q" vid="AMO 9:9">mábürühanga ni aban lagu múarugun.<verse eid="AMO 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 9:10" />Sun ha gafigounbaña hadan numutuniña,</para>
  <para style="q" vid="AMO 9:10">háfarawaguba tau eféin;</para>
  <para style="q" vid="AMO 9:10">sun ha ariñagubaña:</para>
  <para style="q" vid="AMO 9:10">“Masuseredunbei ni kata lídangiñe le woun,</para>
  <para style="q" vid="AMO 9:10">márügüdün lubadiwa wuribani”.<verse eid="AMO 9:10" /></para>
  <para style="s1">Lararamawagüdünya Ísüraeli</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11" />«Anitebei weyu danme nararamagüdünuya luban Dawidi to héiguaaruboun. Nadouragubei huyu burí le tuágubei, nadügayaboun ítara kei tubei meha lidan dan le sügühalibei, <verse eid="AMO 9:11" /><verse number="12" style="v" sid="AMO 9:12" />lun sun lan le erederubei lídangiñe Edomu luma lídangiñe sun néchani le meha numegenbei, lun liábinya lun lánibei lan Ísüraeli». Ru laali Wabureme lererun, ani lagunfulirubei.<verse eid="AMO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 9:13" />«Anitebei dan lun danme lan anihagua lan lalubahóun türigu, dánhalime lun lawouhóun múa, másugilime taribichawagún beibei, chülühame dan lun lábunawagun türigu. Táwiyuhaba diwéin kei duna luéigiñe burí wübü. <verse eid="AMO 9:13" /><verse number="14" style="v" sid="AMO 9:14" />Ábameti nanügüni Ísüraeli lídangiñe ladaürǘn. Ábame hábunaguniya uburugu burí le günringuaalibei, ábame haganóun lidan; hábunaguba beibei ábame hátunu diwéin, hábunaguba nadü ábame héigini lin. <verse eid="AMO 9:14" /><verse number="15" style="v" sid="AMO 9:15" />Lugundun níchugubaña lidan hamúan guánarügü, masagarunhañame lídangiñe múa le níchugubei houn». Aburemei ariñagubalin.<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>