<usx version="3.0">
  <book code="OBA" style="id">ABDIASI.TXT (Encoding update 2008) 27/02/2001 CAP C.R, GARIFUNA</book>
  <para style="h">Abüdíasi</para>
  <para style="toc3">Abüd</para>
  <para style="toc2">Abüdíasi</para>
  <para style="toc1">Abüdíasi</para>
  <para style="mt2">Liliburun</para>
  <para style="mt1">ABÜDÍASI</para>
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="ms">I. Labeichún Edomu</para>
  <para style="mr">(<ref loc="OBA 1:1-14">1.1-14</ref>)</para>
  <para style="s1">Labeichubei Wabungiute Edomu</para>
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />Anihán uganu le líchugubei Wabureme lun Abüdíasi luagu ageiraü le gíribei Edomu.</para>
  <para style="b" vid="OBA 1:1" />
  <para style="q" vid="OBA 1:1">Aganbaadiwa aban uganu lúmagiñe Aburemei,</para>
  <para style="q" vid="OBA 1:1">Ñǘdünhali aban anügüti uganu hamoun néchanigu ariñaga houn:</para>
  <para style="q" vid="OBA 1:1">«Keimoun wawuribuha luma Edomu!»</para>
  <para style="b" vid="OBA 1:1" />
  <para style="p" vid="OBA 1:1">Lariñahare Wabungiute lun Edomu:<verse eid="OBA 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="OBA 1:2" />«Nañüraüdagüdübadibu hadan néchanigu</para>
  <para style="q" vid="OBA 1:2">ǘnabuguagüda nábume saragu.<verse eid="OBA 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="OBA 1:3" />Yeeda láadibu banaagun bungua.</para>
  <para style="q" vid="OBA 1:3">Lidan burí lawarahan dübü beredera,</para>
  <para style="q" vid="OBA 1:3">lidan fulasu íñuti baganawa,</para>
  <para style="q" vid="OBA 1:3">ligíati baritagunbei luagu ua lan gayaraati lágurunibu.<verse eid="OBA 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="OBA 1:4" />Gama lumoun íbini iñu lan báhamarun kei ágila</para>
  <para style="q" vid="OBA 1:4">ani adügabéime bumasa hawagu waruguma,</para>
  <para style="q" vid="OBA 1:4">nábürügüdübadibu ñéingiñe».</para>
  <para style="b" vid="OBA 1:4" />
  <para style="p" vid="OBA 1:4">Lariñahare Aburemei:<verse eid="OBA 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="OBA 1:5" />«Ánhañadügü hamuga ñübuin híwerutiña íweruhabu áriebu,</para>
  <para style="q" vid="OBA 1:5">manügün hamuti hamuga súngubei;</para>
  <para style="q" vid="OBA 1:5">ánhañadügü hamuga ñübuin abudahatiña beibei,</para>
  <para style="q" vid="OBA 1:5">hígiruba fiu resimu.</para>
  <para style="q" vid="OBA 1:5">Ánhañati báganiñu, günringua hamaadibu sunsuinagubei.<verse eid="OBA 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="OBA 1:6" />Asagarahóuaadibu Esaú!</para>
  <para style="q" vid="OBA 1:6">Íweruhoua darí lumoun lagumuhóun bumegen le aramudañubei!<verse eid="OBA 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="OBA 1:7" />Yéedagua hamutibu sun bánigu;</para>
  <para style="q" vid="OBA 1:7">bugá hamutibu bumúanrugu guánarügügiñe.</para>
  <para style="q" vid="OBA 1:7">Íbini ha guánarügü bumadagu garabaguaaña buagun,</para>
  <para style="q" vid="OBA 1:7">bumadagu ha uágubaña bemenigida,</para>
  <para style="q" vid="OBA 1:7">sétihaña sádara bubá. Hariñaga:</para>
  <para style="q" vid="OBA 1:7">“Ibidiouguati lau Edomu!” »<verse eid="OBA 1:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="OBA 1:8" />Lariñahare Wabureme:</para>
  <para style="q" vid="OBA 1:8">«Danme le nabeichuni Edomu,</para>
  <para style="q" vid="OBA 1:8">nagünrinchagubaña sun chu taugu ha ñéinbaña,</para>
  <para style="q" vid="OBA 1:8">meredebei ni aban gürigia huali tichügü Edomu.<verse eid="OBA 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="OBA 1:9" />Hadadagaruba wuriburuguna ha lílana Temán lau anufudei,</para>
  <para style="q" vid="OBA 1:9">háfarawaguba sun wuriburuguna ha Edomubaña.<verse eid="OBA 1:9" /></para>
  <para style="s1">Lidurun burí Edomu</para>
  <para style="q">
    <verse number="10" style="v" sid="OBA 1:10" />«Banügüba busiganu, bagünrinchawaguba lun súnwandan,</para>
  <para style="q" vid="OBA 1:10">ladüga báfaruni Hakobu le bamulen.<verse eid="OBA 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="OBA 1:11" />Díreirügütibu dan le hasagarahanbalin áganiñu uburugu,</para>
  <para style="q" vid="OBA 1:11">dan le habouchagunbalin súdara terencha lubenari Herusalén.</para>
  <para style="q" vid="OBA 1:11">Dan le harifahanbalin burí katei le hasagarubei Herusaléngiñe,</para>
  <para style="q" vid="OBA 1:11">ítara biña buga giñe kei hagía.<verse eid="OBA 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="OBA 1:12" />Moun lumuti buga bagundaarun lau</para>
  <para style="q" vid="OBA 1:12">barihini bíbiri lidan lilamiserun,</para>
  <para style="q" vid="OBA 1:12">moun lumuti buga bagundaarun</para>
  <para style="q" vid="OBA 1:12">lau barihini Hudá lidan günringuaü,</para>
  <para style="q" vid="OBA 1:12">moun lumuti buga badügün bula hau lidan hadiheri.<verse eid="OBA 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="OBA 1:13" />Moun lumuti buga bebelurun nuburuguterugun</para>
  <para style="q" vid="OBA 1:13">lidan lidaani lasufurirun,</para>
  <para style="q" vid="OBA 1:13">magundaarun buguya hamuga lau lilamiserun,</para>
  <para style="q" vid="OBA 1:13">míweruhan bumuti hamuga giñe lirisin</para>
  <para style="q" vid="OBA 1:13">lidan lidaani lilamiserun.<verse eid="OBA 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="OBA 1:14" />Moun lumuti buga bararamun luagu legeyedun üma</para>
  <para style="q" vid="OBA 1:14">lun báfaraguniña ha anurahabaña,</para>
  <para style="q" vid="OBA 1:14">mederegerun bumutiña hamuga giñe ha anurahabaña</para>
  <para style="q" vid="OBA 1:14">lidan lidaani idiheri.<verse eid="OBA 1:14" /></para>
  <para style="ms">II. Luéyuri Bungiu</para>
  <para style="mr">(<ref loc="OBA 1:15-21">1.15-21</ref>)</para>
  <para style="q">
    <verse number="15" style="v" sid="OBA 1:15" />Kei badüga houn amu,</para>
  <para style="q" vid="OBA 1:15">ítara luba giñe ladügǘn bun,</para>
  <para style="q" vid="OBA 1:15">Beresibirubei le badünabei!</para>
  <para style="s1" vid="OBA 1:15">Hasiadirúniwa néchanigu</para>
  <para style="q" vid="OBA 1:15">«Yarafaali luéyuri Wabureme houn sun néchanigu.<verse eid="OBA 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="OBA 1:16" />Ítara kei ligifi uniñein le hátubei luagu nuwübüri le sándubei,</para>
  <para style="q" vid="OBA 1:16">ítara luba giñe ligifi uniñein le lunbei hátuni híbiri néchanigu murusun murusun;</para>
  <para style="q" vid="OBA 1:16">ábame hagumuchagun sunsuinagubei».<verse eid="OBA 1:16" /></para>
  <para style="s1">Lagañeirun Ísüraeli</para>
  <para style="q">
    <verse number="17" style="v" sid="OBA 1:17" />«Ánheinti wübü Sión,</para>
  <para style="q" vid="OBA 1:17">ábanbei fulasu sánduti</para>
  <para style="q" vid="OBA 1:17">le ñéinhinba lubéi hanuraha fiu gürigia.</para>
  <para style="q" vid="OBA 1:17">Hibihayabei ladügawagun Hakobu hamúan lárigoun;<verse eid="OBA 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="OBA 1:18" />ítara haba ladügawagun Hosé</para>
  <para style="q" vid="OBA 1:18">hama ladügawagun Hakobu kei watu gemeti.</para>
  <para style="q" vid="OBA 1:18">Hagíaba agünrinchaguaña ladügawagun Esaú,</para>
  <para style="q" vid="OBA 1:18">ítara kei láguduni watu gemeti sagadi sáühali.</para>
  <para style="q" vid="OBA 1:18">Mesefubei ni aban hádangiñe lánigu Esaú!</para>
  <para style="q" vid="OBA 1:18">Au le, Aburemei ariñagubalin».<verse eid="OBA 1:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19-20" style="v" sid="OBA 1:19-20" />Hárügüdübei Ísüraelina ha Negebübaña fulasu le durubei le lani Esaú, ha luágubaña fulasu mawübüriti, hárügüdübei hamúan Filistéana. Hárügüdübei giñe lumúan burí Éfürain luma lumúan Samaria, hárügüdeime lánigu Benhamín Galaadü. Hárügüdübei Ísüraelina ha asagarúbaña hageiragiñe keisi adaürǘtiña hamúan Kananna darí Sarepüta, adaürǘtiña Herusalénna ha Sefarádübaña hárügüdübei luburugute burí Négebü. <verse eid="OBA 1:19-20" /><verse number="21" style="v" sid="OBA 1:21" />Hamudeiruba lumutuniña Bungiu luagun luwübüri Sión, ani ñéingiñeba hagumadiraña Edomuna. Aburemei le Bungiu ligíaba Urúei.<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>