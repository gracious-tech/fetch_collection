<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PSA" style="id">SALMU98.TXT (Encoding update 2008) 27/02/2001 CAP C.R, GARIFUNA</book>
  <para style="h">Sálumu</para>
  <para style="toc3">Sal</para>
  <para style="toc2">Sálumu</para>
  <para style="toc1">Sálumu</para>
  <para style="mt2">Liliburun</para>
  <para style="mt1">SÁLUMU</para>
  <chapter number="1" style="c" sid="PSA 1" />
  <para style="ms">FURUMIÑETU LÍBURU</para>
  <para style="mr">(Sálumu <ref loc="PSA 1-41">1—41</ref>)</para>
  <para style="s1">Ugundani le tímatimaati</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 1:1" />Fuleseiwatiña gürigia ha mafalarunbalin hererun ha salufuribaña,</para>
  <para style="q" vid="PSA 1:1">méibugun hagía lidan hémeri ha gafigounbaña,</para>
  <para style="q" vid="PSA 1:1">múaradun hagía hama ha adügübaña bula lau Bungiu.<verse eid="PSA 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 1:2" />Lubaragiñe lira, lídanñein lilurudun Aburemei hínsiñehabu,</para>
  <para style="q" vid="PSA 1:2">luagu lúrudu ligía hasaminara, áriebu wéyuagu.<verse eid="PSA 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 1:3" />Gürigia hagía ítara haña</para>
  <para style="q" vid="PSA 1:3">kei tídibu wewe le abunúti laru duna,</para>
  <para style="q" vid="PSA 1:3">le íchuguti lin lidan lidaani,</para>
  <para style="q" vid="PSA 1:3">ani másaürati giñe lubana.</para>
  <para style="q" vid="PSA 1:3">Buíduti lidin houn lidan sun le hadügübei!<verse eid="PSA 1:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 1:4" />Ánhaña wuribatiña, mítaranti lidin houn;</para>
  <para style="q" vid="PSA 1:4">ítara haña kei sagadi sáühali le lanügübei garabali.<verse eid="PSA 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 1:5" />Ligía hábürühaba lubéi wuribatiña lidan laguseragüdün Bungiu;</para>
  <para style="q" vid="PSA 1:5">mafanran hagíame lidan le lunbei habihini ha buídubaña.<verse eid="PSA 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 1:6" />Góunigi lumuti Bungiu hémeri buítiña;</para>
  <para style="q" vid="PSA 1:6">ánhañati wuribatiña, lidoun féridi lanügaña hémeri.<verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" sid="PSA 2" />
  <para style="s1">Niráü buguya</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 2:1" />Málati hachagaragun néchanigu ha gíbebaña ubungiute</para>
  <para style="q" vid="PSA 2:1">málati hasaminarun hadaagun katei le meseriwínti.<verse eid="PSA 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 2:2" />Awügürihouatiña urúeigu hama gumadimatiña ha lánina ubóu le;</para>
  <para style="q" vid="PSA 2:2">óundaragua hagía lun heledegun lubá Wabureme Bungiu,</para>
  <para style="q" vid="PSA 2:2">luma lubá urúei le lanúadirubei.<verse eid="PSA 2:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 2:3" />Aba hagúarahan, hariñagati:</para>
  <para style="q" vid="PSA 2:3">«Wáhüchüraguaali hagüringürin wawariua!</para>
  <para style="q" vid="PSA 2:3">Wafaragadaali hagüraguniwa!»<verse eid="PSA 2:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 2:4" />Éherahati Aburemei le arúeihabei sielu hau;<verse eid="PSA 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 2:5" />lárigiñe, aba lagañidun, aba lalouchagüdüniña;</para>
  <para style="q" vid="PSA 2:5">aba lébechuniña buin lau igañi, lariñaga:<verse eid="PSA 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 2:6" />«Ru naali nurúeite luagu Sión,</para>
  <para style="q" vid="PSA 2:6">nuwübüri le sándubei».<verse eid="PSA 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 2:7" />Lariñahare urúei: «Nariñagaali ka lan laritagubei Nabureme:</para>
  <para style="q" vid="PSA 2:7">Ariñagaali nun:</para>
  <para style="q" vid="PSA 2:7">“Niráü buguya, uguñe, Búguchihadina.<verse eid="PSA 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 2:8" />Amuriahabá numa lun níchuguni néchani burí bun balaganteme,</para>
  <para style="q" vid="PSA 2:8">amuriahabeime lagumuhóun larigeirugu ubóu, níchugubei bun.<verse eid="PSA 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 2:9" />Bagumadirubaña urúeigu lau úhabu héreti,</para>
  <para style="q" vid="PSA 2:9">babouchagubaña kei sóudieru le adügǘti lau múa!” »<verse eid="PSA 2:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 2:10" />Guentoti aganba humá, huguya urúeigu hama agumadihatiña ubouagu;</para>
  <para style="q" vid="PSA 2:10">furendei huméi arufudahani le buidu!<verse eid="PSA 2:10" /></para>
  <para style="q">
    <verse number="11-12" style="v" sid="PSA 2:11-12" />Ru humá uéiriguni lun Aburemei</para>
  <para style="q" vid="PSA 2:11-12">lau ugundani luma inebesei</para>
  <para style="q" vid="PSA 2:11-12">bulugua humá adadagareina ligibugiñe,</para>
  <para style="q" vid="PSA 2:11-12">gáñidügüliñein, ábameti hóunwegun ǘmada,</para>
  <para style="q" vid="PSA 2:11-12">ladüga ménrengunti lun lagañidun.</para>
  <para style="b" vid="PSA 2:11-12" />
  <para style="q" vid="PSA 2:11-12">Fuleseiwatiña ha afiñebaña luagu!<verse eid="PSA 2:11-12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" sid="PSA 3" />
  <para style="s1">Afurieiduni amuriahei lídehan Aburemei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 3:1" />Nabureme, gíbetiña náganiñu,</para>
  <para style="q" vid="PSA 3:1">gíbetiña íchugutiña hanagan nuagun.<verse eid="PSA 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 3:2" />Saragu haña ariñagutiña nuagu:</para>
  <para style="q" vid="PSA 3:2">«Mesefurun lubéi Bungiu»!<verse eid="PSA 3:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 3:3" />Gama lumoun Nabureme,</para>
  <para style="q" vid="PSA 3:3">buguya óunigirubalina,</para>
  <para style="q" vid="PSA 3:3">buguya íchugubei uéiriguni nun,</para>
  <para style="q" vid="PSA 3:3">buguya íchugubei gurasu nun.<verse eid="PSA 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 3:4" />Wáguatina amuriaha ídemuei luma Aburemei,</para>
  <para style="q" vid="PSA 3:4">óunaba lumutina lídangiñe fulasu le ñein lubéi.<verse eid="PSA 3:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 3:5" />Róuntina, arumuga au, ábaya nagagudún</para>
  <para style="q" vid="PSA 3:5">ladüga ágüdaha lumutina lan Nabureme.<verse eid="PSA 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 3:6" />Manufudedagüdün hamutina saragu súdaragu</para>
  <para style="q" vid="PSA 3:6">ha geyegubaña nau,</para>
  <para style="q" vid="PSA 3:6">aranseñu lun hábürühan nuagun.<verse eid="PSA 3:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 3:7" />Iñuraguabá, Nabureme!</para>
  <para style="q" vid="PSA 3:7">Sefubána, Nubungiute!</para>
  <para style="q" vid="PSA 3:7">Babuleseirubaña náganiñu hagibuagun;</para>
  <para style="q" vid="PSA 3:7">báhalahabei hari ha salufuribaña!<verse eid="PSA 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 3:8" />Nabureme, buguya esefuhabei;</para>
  <para style="q" vid="PSA 3:8">binibaña lubeiti bánigu!<verse eid="PSA 3:8" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" sid="PSA 4" />
  <para style="s1">Emenigini luagu Aburemei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 4:1" />Bungiu le ageindagubei nuéigiñe.</para>
  <para style="q" vid="PSA 4:1">Fuleseibana lau bóunabunina danme nagúarun bun!</para>
  <para style="q" vid="PSA 4:1">Buguya le íchugubei dǘgüdaguaü nun lidan nidiheri,</para>
  <para style="q" vid="PSA 4:1">gudemená bun, aganbabéime nafurieidun bun!<verse eid="PSA 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 4:2" />Huguya le wéirigubei hanaagun hungua,</para>
  <para style="q" vid="PSA 4:2">ídaba san lásura hanabaguni niri?</para>
  <para style="q" vid="PSA 4:2">Ídaba san lásura hayumahan</para>
  <para style="q" vid="PSA 4:2">luma háluahani katei le málabei</para>
  <para style="q" vid="PSA 4:2">luma le mámabei inarüni?<verse eid="PSA 4:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 4:3" />Subudi huméi luagu himei lániña Aburemei</para>
  <para style="q" vid="PSA 4:3">gürigia ha gúnfulibaña luma lun lánigume,</para>
  <para style="q" vid="PSA 4:3">subudi huméi luagu aganba lánina Nabureme</para>
  <para style="q" vid="PSA 4:3">dan le nagúarun lun.<verse eid="PSA 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 4:4" />Adadagara humá, mafigounhadigia huguyame!</para>
  <para style="q" vid="PSA 4:4">Danme róunhadün, lidan límaniga</para>
  <para style="q" vid="PSA 4:4">álügüdagua humá hungua ida hiña lan tidan hanigi;<verse eid="PSA 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 4:5" />ru humá adagaragüdüni lau inarüni lun Aburemei,</para>
  <para style="q" vid="PSA 4:5">afiñe huguyame luagu.<verse eid="PSA 4:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 4:6" />Gíbetiña ariñagutiña:</para>
  <para style="q" vid="PSA 4:6">«Kaba funa san arufudei le buídubei woun?»</para>
  <para style="q" vid="PSA 4:6">Aburemei, arihabá wawagun lau areini!<verse eid="PSA 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 4:7" />Rúhadibu ugundani tidoun nanigi</para>
  <para style="q" vid="PSA 4:7">sügǘ hau ha gíbebei türigu tuma diwéin hama.<verse eid="PSA 4:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 4:8" />Róuntina tidan nigabanan lau darangilaü</para>
  <para style="q" vid="PSA 4:8">lárigiñe aba narumugun,</para>
  <para style="q" vid="PSA 4:8">ladüga rútibu darangilaü luma achoururuni nun, Nabureme.<verse eid="PSA 4:8" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" sid="PSA 5" />
  <para style="s1">Agumesereinei weyu luma Bungiu</para>
  <para style="q">
    <verse number="1-2" style="v" sid="PSA 5:1-2" />Nabureme, Nurúeite Nubungiute,</para>
  <para style="q" vid="PSA 5:1-2">aganbabána, tenibá lun nayumuragun,</para>
  <para style="q" vid="PSA 5:1-2">adügabá gasu lau naünhan, ladüga bun nafurieida.<verse eid="PSA 5:1-2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 5:3" />Aganba bumuti numalali binaafin;</para>
  <para style="q" vid="PSA 5:3">ru numuti nikesin bigibugiñe binaafingiua,</para>
  <para style="q" vid="PSA 5:3">aba nerederun agurabei bóunabun.<verse eid="PSA 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 5:4" />Mama buguya aban Bungiu le gúndaati lau katei wuribati;</para>
  <para style="q" vid="PSA 5:4">siñati haganóun wuribatiña bóubagiñe,<verse eid="PSA 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 5:5" />Mabaratiña giñe ha barüguabaña houngua biñuarü.</para>
  <para style="q" vid="PSA 5:5">Iyereegutiña ha adügübaña wuribati bun,<verse eid="PSA 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 5:6" />günringua bumutiña ha marasualugubaña,</para>
  <para style="q" vid="PSA 5:6">bugabáña gáfarahatiña.<verse eid="PSA 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 5:7" />Ánheinti au, luagu lueirin bínsiñehabu,</para>
  <para style="q" vid="PSA 5:7">gayaraati nebelurun tidoun buban to sánduboun;</para>
  <para style="q" vid="PSA 5:7">gayaraati níchugun uéiriguni bun,</para>
  <para style="q" vid="PSA 5:7">aríagueina aume lau inebesei búbiñoun.<verse eid="PSA 5:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 5:8" />Nabureme, íderaguabana lun nadügüni bugundan,</para>
  <para style="q" vid="PSA 5:8">barübana luéigiñe üma le surubei,</para>
  <para style="q" vid="PSA 5:8">ariha hamaamugei náganiñu luagu abunhein lan numa.<verse eid="PSA 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 5:9" />Hagía, madimurehantiña lau inarüni;</para>
  <para style="q" vid="PSA 5:9">ñalaaña harageirugugiñe!</para>
  <para style="q" vid="PSA 5:9">Ítara liña hagülerugu kei aban umúahaü le hunren umuti;</para>
  <para style="q" vid="PSA 5:9">Marasualugutu hañeñe!<verse eid="PSA 5:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 5:10" />Béiguabaña, Nubungiute!</para>
  <para style="q" vid="PSA 5:10">Adügabá lun masali lan luriban haransehan!</para>
  <para style="q" vid="PSA 5:10">Bugabaña luagu liibe hafigoun,</para>
  <para style="q" vid="PSA 5:10">ladüga hagarabaagun buagun.<verse eid="PSA 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 5:11" />Gunda hamá ha hemenigibaña buagu,</para>
  <para style="q" vid="PSA 5:11">eremuha hamá lau ugundani súnwandan</para>
  <para style="q" vid="PSA 5:11">ladüga buguya ágüdahabaliña.</para>
  <para style="q" vid="PSA 5:11">Badüga gúndaahabei ha hínsiñehabubaña bun,<verse eid="PSA 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 5:12" />ladüga buguya Nabureme</para>
  <para style="q" vid="PSA 5:12">biní bumuti le gúnfulibei buma;</para>
  <para style="q" vid="PSA 5:12">daruguati bareini lau</para>
  <para style="q" vid="PSA 5:12">kei aban idaüdinaü le lauti gürabu.<verse eid="PSA 5:12" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" sid="PSA 6" />
  <para style="s1">Afurieiduni lidan idiheri</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 6:1" />Nabureme,</para>
  <para style="q" vid="PSA 6:1">madeinhabá nun lidan basafaragun,</para>
  <para style="q" vid="PSA 6:1">mabeichabana giñe lau bigañi.<verse eid="PSA 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 6:2" />Nabureme, gudemená bun,</para>
  <para style="q" vid="PSA 6:2">ladüga uánimati nasandiragun nungua.</para>
  <para style="q" vid="PSA 6:2">Nabureme, águyugüdabei lareini nura nun,</para>
  <para style="q" vid="PSA 6:2">ladüga adadagarati sun núgubu le nisandi.<verse eid="PSA 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 6:3" />Nadadagaruña lau anufudei!</para>
  <para style="q" vid="PSA 6:3">Ani buguyati Nabureme, Ídaba san biabin?<verse eid="PSA 6:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 6:4" />Higabu Nabureme, sefubéi nibagari!</para>
  <para style="q" vid="PSA 6:4">Sefubána luagu bínsiñehabu!<verse eid="PSA 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 6:5" />Úati le hilaali lun laritagun buagun;</para>
  <para style="q" vid="PSA 6:5">kagia gayaraabei líchugun uéiriguni bun lídangiñe lumuaha?<verse eid="PSA 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 6:6" />Buchá nuagu ayahua, áriebu lárigi áriebu nayahuña</para>
  <para style="q" vid="PSA 6:6">darí lun tadüdürün nichügübarari lau náguira.<verse eid="PSA 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 6:7" />Búriha narihin ladüga gáriti;</para>
  <para style="q" vid="PSA 6:7">lóuguati narihin hadüga náganiñu.<verse eid="PSA 6:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 6:8" />Dise humá nuéi huguya le adaagubei wuribani!</para>
  <para style="q" vid="PSA 6:8">Aganba laali Nabureme nayahuahan.<verse eid="PSA 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 6:9" />Aganba laali Nabureme nayumuragun;</para>
  <para style="q" vid="PSA 6:9">resibi laali Nabureme nebegirun lun!<verse eid="PSA 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 6:10" />Herederuba náganiñu lidan busiganu,</para>
  <para style="q" vid="PSA 6:10">láfaragubaña anufudei</para>
  <para style="q" vid="PSA 6:10">ítara kei lufuresen léfegechun luma lámurudun agu</para>
  <para style="q" vid="PSA 6:10">ítara luba giñe lufuresen hanurahan lau saragu busiganu!<verse eid="PSA 6:10" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" sid="PSA 7" />
  <para style="s1">Richaguati laguseragüdün Wabureme Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 7:1" />Nabureme, Nubungiute, buma náluaha nóunigiruniwa;</para>
  <para style="q" vid="PSA 7:1">sefubána hawéi sun ha éibaahabalina!<verse eid="PSA 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 7:2" />Sefubána, ladüga ítara liña hagaburi kei liñún,</para>
  <para style="q" vid="PSA 7:2">günringua hañalina úougame kaba lan esefurana hawéi!<verse eid="PSA 7:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 7:3" />Nabureme, Nubungiute,</para>
  <para style="q" vid="PSA 7:3">ka lídangiñe burí katei le ídounbei nábürüha?</para>
  <para style="q" vid="PSA 7:3">Áfarahaadina funagia?<verse eid="PSA 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 7:4" />Fáyeihadina funagia wuribati luagu buiti lun numada?</para>
  <para style="q" vid="PSA 7:4">Bulubudu naali funagia nágani marichaga?<verse eid="PSA 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 7:5" />Anhein ítara liña lubéi,</para>
  <para style="q" vid="PSA 7:5">éibaahalana nágani, ragülana, aduruuha lana múarugu,</para>
  <para style="q" vid="PSA 7:5">abalabaagüdalei lubuidun ladimurehóuniwa nuagu múarugu.<verse eid="PSA 7:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 7:6" />Iñuraguabá lau igañi, Nabureme!</para>
  <para style="q" vid="PSA 7:6">Gagibuguabá luma hagañi náganiñu!</para>
  <para style="q" vid="PSA 7:6">Buguya le adügaalibei irichaü, númagiñeba!<verse eid="PSA 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 7:7" />Geyegua hamá lílana fulasu bau;</para>
  <para style="q" vid="PSA 7:7">Rubei lálana barúeihan hóugiñe.<verse eid="PSA 7:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 7:8" />Nabureme, buguya aguseragüdübaliña sun néchanigu,</para>
  <para style="q" vid="PSA 7:8">aguseragüdabana kei ligaburi niricha;</para>
  <para style="q" vid="PSA 7:8">aguseragüdabana kei ligaburi taruman nanigi.<verse eid="PSA 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 7:9" />Bungiu richaguati,</para>
  <para style="q" vid="PSA 7:9">buguya le aríaahabalin saminaü</para>
  <para style="q" vid="PSA 7:9">luma lilulin-agei tabusenrun wanigi,</para>
  <para style="q" vid="PSA 7:9">gumuguagüdabei hariban salufuritiña,</para>
  <para style="q" vid="PSA 7:9">deregüdaguagüdabei le richaguabei!<verse eid="PSA 7:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 7:10" />Bungiu le íñugubei, ligía óunigirubalina,</para>
  <para style="q" vid="PSA 7:10">le esefurubaliña ha harumabaña anigi.<verse eid="PSA 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 7:11" />Bungiu, aban aguseragüdüti richaguati,</para>
  <para style="q" vid="PSA 7:11">le asiadirubalin wuribani súnwandan.<verse eid="PSA 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 7:12" />Anhein magiribudagun gürigia lun Bungiu,</para>
  <para style="q" vid="PSA 7:12">layarahaboun Bungiu lefeinte,</para>
  <para style="q" vid="PSA 7:12">ani deregüda laaru tebu ligimaran.<verse eid="PSA 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 7:13" />Seti laaru ligimaran to durunguaboun,</para>
  <para style="q" vid="PSA 7:13">aranseru burí lárumate to gáfarahatu!<verse eid="PSA 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 7:14" />Ariha humaña ha salufuribaña:</para>
  <para style="q" vid="PSA 7:14">hagariduña le lánina águrahani,</para>
  <para style="q" vid="PSA 7:14">dageinañanu lau wuribani,</para>
  <para style="q" vid="PSA 7:14">marasualugu ligíaba háguraha.<verse eid="PSA 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 7:15" />Chigaaña aban huyu huliliti,</para>
  <para style="q" vid="PSA 7:15">hábürühaba lidoun guánarügü huyu ligía.<verse eid="PSA 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 7:16" />Lábürühaba hariban luma hanarime hábulugun guánarügü!<verse eid="PSA 7:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 7:17" />Nalawahabei Nabureme ladüga richaguati;</para>
  <para style="q" vid="PSA 7:17">neremuhaba uremu lun liri Nabureme,</para>
  <para style="q" vid="PSA 7:17">lun liri le íñugubei.<verse eid="PSA 7:17" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" sid="PSA 8" />
  <para style="s1">Luéirigun Bungiu luma linebenwa gürigia</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 8:1" />Aburemei, Warúeite sungua luagu,</para>
  <para style="q" vid="PSA 8:1">ma lanarime luéirigun biri lidan sun ubóu!</para>
  <para style="q" vid="PSA 8:1">Chülüti buéirigun yagürounmeme luéi sielu<verse eid="PSA 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 8:2" />ani irahüñü ñǘbürigiña</para>
  <para style="q" vid="PSA 8:2">hama ha machularungiña eremuhabalin.</para>
  <para style="q" vid="PSA 8:2">Adügatibu aban iderebugu hawéi báganiñu,</para>
  <para style="q" vid="PSA 8:2">lun bagumuchun hau ha garabaguaañabaña buagun.<verse eid="PSA 8:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 8:3" />Dan le narihini sielu le badügübei,</para>
  <para style="q" vid="PSA 8:3">luma hati hama waruguma ha bíchugubaña ñein,<verse eid="PSA 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 8:4" />aba nasaminarun núnguarügü:</para>
  <para style="q" vid="PSA 8:4">Kátañanu san wügüriña lun basaminaruba lan hawagun?</para>
  <para style="q" vid="PSA 8:4">Kátañanu san gürigia lun bebereseduba lan hau?<verse eid="PSA 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 8:5" />Adüga bumutiña kei yebe búngiugu,</para>
  <para style="q" vid="PSA 8:5">rútibu uéiriguni luma inebesei geyegua hau,<verse eid="PSA 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 8:6" />rútibu ubafu houn luagu burí katei le badügübei,</para>
  <para style="q" vid="PSA 8:6">ru bumutiña lóugiñe sun katei:<verse eid="PSA 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 8:7" />Hóugiñe mudún hama bágasu;</para>
  <para style="q" vid="PSA 8:7">hóugiñe animaalugu ha áraabuna;<verse eid="PSA 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 8:8" />hóugiñe dunuru ha áhamahabaña sielu;</para>
  <para style="q" vid="PSA 8:8">hóugiñe úduraü ha baranahabaña;</para>
  <para style="q" vid="PSA 8:8">lóugiñe sun le baranahabei!<verse eid="PSA 8:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 8:9" />Bungiu, Wabureme sungua luagu,</para>
  <para style="q" vid="PSA 8:9">ma lanarime luéirigun biri lidan sun ubóu!<verse eid="PSA 8:9" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" sid="PSA 9" />
  <para style="s1">Lalawahóuniwa lúaragun Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 9:1" />Nabureme,</para>
  <para style="q" vid="PSA 9:1">busentina nalawahanibu tau sun nanigi,</para>
  <para style="q" vid="PSA 9:1">abahüdagua aume luagu burí ubuiduni le badügübei.<verse eid="PSA 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 9:2" />Bungiu Íñuguti le ligibuagubei sun katei,</para>
  <para style="q" vid="PSA 9:2">busentina nagúaragun buagu, buin lau ugundani;</para>
  <para style="q" vid="PSA 9:2">busentina neremuhan uremu burí lidan biri!<verse eid="PSA 9:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 9:3" />Anurahatiña náganiñu bigibugiñe,</para>
  <para style="q" vid="PSA 9:3">aba hábürühan darí hóunwegun.<verse eid="PSA 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 9:4" />Aban aguseragüdüti le richaguati buguya:</para>
  <para style="q" vid="PSA 9:4">Ñuruhadibu luagu bala le lánina barúeihan</para>
  <para style="q" vid="PSA 9:4">lun bíchuguni niricha nun.<verse eid="PSA 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 9:5" />Adeinhaadibu houn gibe tubungiutegu</para>
  <para style="q" vid="PSA 9:5">ani günringua baaña salufuritiña;</para>
  <para style="q" vid="PSA 9:5">gidá baali laritawagún hawagun lun súnwandan!<verse eid="PSA 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 9:6" />Hilá ágani,</para>
  <para style="q" vid="PSA 9:6">hilagua giñe luburugute luma;</para>
  <para style="q" vid="PSA 9:6">günringua bumuti burí,</para>
  <para style="q" vid="PSA 9:6">meredeti ni aritaguni lárigi.<verse eid="PSA 9:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 9:7" />Ánheinti Aburemei, aban urúei lun súnwandan,</para>
  <para style="q" vid="PSA 9:7">derebugugüda laali lálana larúeihan lubá laguseragüdün.<verse eid="PSA 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 9:8" />Laguseragüdübei ubóu lau irichaü,</para>
  <para style="q" vid="PSA 9:8">lasiadirubaña gürigia kei lubeibei.<verse eid="PSA 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 9:9" />Góunigi lumutiña Aburemei ha gudemebaña;</para>
  <para style="q" vid="PSA 9:9">góunigi lumutiña lidan lidere dan.<verse eid="PSA 9:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 9:10" />Aburemei,</para>
  <para style="q" vid="PSA 9:10">ha subudihabúbaña bun, hemenigitiña buagu,</para>
  <para style="q" vid="PSA 9:10">ladüga mágurun bumutiña ha áluahabalibu.<verse eid="PSA 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 9:11" />Wa humá uremu lun Aburemei le arúeihabei Sión;</para>
  <para style="q" vid="PSA 9:11">hadimureha luagu sun le ladügübei lidan sun fulasu.<verse eid="PSA 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 9:12" />Haritaguati Bungiu hawagun ha nidiheribaña,</para>
  <para style="q" vid="PSA 9:12">ani mabulieidun lumuti hayahun;</para>
  <para style="q" vid="PSA 9:12">beigua lumutiña ha éibaahabaliña.<verse eid="PSA 9:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 9:13" />Nabureme, gudemená bun;</para>
  <para style="q" vid="PSA 9:13">arihabá hadiheridagüdünina ha iyereehabúbaña nun,</para>
  <para style="q" vid="PSA 9:13">sagabana lídangiñe lubenari óunweni!<verse eid="PSA 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 9:14" />Nariñagame houn sun gürigia lubenari Herusalén,</para>
  <para style="q" vid="PSA 9:14">luagu lunti lan lichugúniwa uéiriguni bun,</para>
  <para style="q" vid="PSA 9:14">luagu giñe gunda nan ladüga besefurunina.<verse eid="PSA 9:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 9:15" />Ábürühatiña gürigia gibe tubungiute tidoun guánarügü hasadaran</para>
  <para style="q" vid="PSA 9:15">hürüguati hagudi tidan guánarügü seni to haramuduboun.<verse eid="PSA 9:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 9:16" />Arufudaguaali Bungiu lungua:</para>
  <para style="q" vid="PSA 9:16">Aguseragüdaali lau ísuruni!</para>
  <para style="q" vid="PSA 9:16">Rédeitiña ha salufuribaña dáüwañu tidan sádara to guánarügü hadügüboun.<verse eid="PSA 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 9:17" />Ha salufuribaña hama gürigia</para>
  <para style="q" vid="PSA 9:17">ha abulieidubalin Bungiu hóudiba máfiougatin;<verse eid="PSA 9:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 9:18" />mabulieidunwabaña gudemetiña,</para>
  <para style="q" vid="PSA 9:18">meferidirun ligíame hemenigin lun súnwandan.<verse eid="PSA 9:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 9:19" />Iñuraguabá Bungiu Nabureme;</para>
  <para style="q" vid="PSA 9:19">mígiraba lun iñu lan lanaagun gürigia lungua;</para>
  <para style="q" vid="PSA 9:19">aguseragüdabaña gürigia gibe tubungiute bigibugiñe!<verse eid="PSA 9:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 9:20" />Nabureme, adügabá lun hasandirun anufudei</para>
  <para style="q" vid="PSA 9:20">subudigüdabei houn luagu gürigiarügüñanu lan.<verse eid="PSA 9:20" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" sid="PSA 10" />
  <para style="s2">Dios ta defendé hende flihí kontra hende malbado</para>
  <para style="s1">Furíeigi amuriahei lídehan Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 10:1" />Aburemei, ka uagu bidisebei?</para>
  <para style="q" vid="PSA 10:1">Ka uagu baramudagua lidan lidere dan?<verse eid="PSA 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 10:2" />Éibaaha hamutiña ha salufuribaña, ha ǘnabugubaña</para>
  <para style="q" vid="PSA 10:2">lau anaaguni unguaü luma lau anarimeni</para>
  <para style="q" vid="PSA 10:2">gama lumoun hábürühaba tidoun guánarügü hasadaran.<verse eid="PSA 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 10:3" />Pántatiña ha salufuribaña lau guánarügü lagübüri hayumahan;</para>
  <para style="q" vid="PSA 10:3">ha igaaduabaña, rútiña mebereseni lun Aburemei.<verse eid="PSA 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 10:4" />Iñura hamuti hagibu, hariñaga:</para>
  <para style="q" vid="PSA 10:4">«Úati Bungiu, úati lunti laguseragüdüniwa».</para>
  <para style="q" vid="PSA 10:4">Ligía sun le haritagubei.<verse eid="PSA 10:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 10:5" />Súnwandan buidu lan lidin houn lidan sun le hadügübei.</para>
  <para style="q" vid="PSA 10:5">Díseti baguseragüdün houn,</para>
  <para style="q" vid="PSA 10:5">wéiriti lidise luéi harihin.</para>
  <para style="q" vid="PSA 10:5">Ábati héherahan hau háganiñu,<verse eid="PSA 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 10:6" />haritaguatiña luagu úabei lan ábürügüdütiña,</para>
  <para style="q" vid="PSA 10:6">luagu miábinbei lan turobuli houn.<verse eid="PSA 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 10:7" />Buin liña hayuma lau íñarawaguni,</para>
  <para style="q" vid="PSA 10:7">lau iyeeni luma anabahani;</para>
  <para style="q" vid="PSA 10:7">luágurügüñein áfarahani luma wuribani hayanuha,<verse eid="PSA 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 10:8" />aba burí haramudagun lidan lirahüñü fulasu</para>
  <para style="q" vid="PSA 10:8">lun háfaruni le madurunbei hilagubei.</para>
  <para style="q" vid="PSA 10:8">Magida hamuti harihin luéigiñe le mérebei.<verse eid="PSA 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 10:9" />Ítara haña kamá hamuga aban liñún tidan luban,</para>
  <para style="q" vid="PSA 10:9">aríaaha hamuti le gudemebei tídangiñe haramudaguagüle,</para>
  <para style="q" vid="PSA 10:9">aguraba kaba lan oura hábürüha luagun;</para>
  <para style="q" vid="PSA 10:9">danti le hárügüdüni, aba haduruguduni tau hasadaran.<verse eid="PSA 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 10:10" />Lemuguatiña, diñugua hagía,</para>
  <para style="q" vid="PSA 10:10">ábati hábürühan ha mérebaña háhaburugun.<verse eid="PSA 10:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 10:11" />Haritaguatiña ha salufuribaña luagu bulíeigua lan Bungiu,</para>
  <para style="q" vid="PSA 10:11">luagu darugua lan lau ligibu,</para>
  <para style="q" vid="PSA 10:11">luagu marihin lan ni kata.<verse eid="PSA 10:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 10:12" />Iñuraguabá Nabureme! Iñurabéi barüna!</para>
  <para style="q" vid="PSA 10:12">Mabulieidabaña ha nidiheribaña!<verse eid="PSA 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 10:13" />Ka san uagu Nubungiute,</para>
  <para style="q" vid="PSA 10:13">héherahaba lubéi ha salufuribaña nau;</para>
  <para style="q" vid="PSA 10:13">haritagueina hagía luagu maguseragüdün bubaña lan?<verse eid="PSA 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 10:14" />Buguya guánarügü ariha baali lanarime hariban;</para>
  <para style="q" vid="PSA 10:14">ariha baali ani bíchugubei le hadünabei houn!</para>
  <para style="q" vid="PSA 10:14">Buagun habalacha ha mérebaña;</para>
  <para style="q" vid="PSA 10:14">buguya hídehabei ha méteñuhañabaña.<verse eid="PSA 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 10:15" />Halaguabei harüna wuribatiña!</para>
  <para style="q" vid="PSA 10:15">Fáyeigüdabaña luagu hariban,</para>
  <para style="q" vid="PSA 10:15">darime lun ua lan ni kata erederuti mafayeirunga!<verse eid="PSA 10:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 10:16" />Aburemei Urúeibei lun súnwandan;</para>
  <para style="q" vid="PSA 10:16">habugawaguba gürigia ha mabungiutebaña hageiragiñe!<verse eid="PSA 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 10:17" />Aburemei, aganba bumuti hafurieidun ha ǘnabugubaña</para>
  <para style="q" vid="PSA 10:17">rútibu gurasu houn, teni buguya houn.<verse eid="PSA 10:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 10:18" />Rubei haricha méteñuhaña houn, hama ha gudemebaña;</para>
  <para style="q" vid="PSA 10:18">lun manufudehandigia hamá gürigia ha adügǘbaña lau múa!<verse eid="PSA 10:18" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" sid="PSA 11" />
  <para style="s1">Emenigini le tímatimaati luagu Aburemei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 11:1" />Lóubawagu Nabureme náluaha naramudagun.</para>
  <para style="q" vid="PSA 11:1">Málati hariñagun nun:</para>
  <para style="q" vid="PSA 11:1">«Banuraha wǘbüwagun keisi dunuru;<verse eid="PSA 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 11:2" />arihabá houn wuribatiña:</para>
  <para style="q" vid="PSA 11:2">Ru hamutu gimara luagu gúrudu,</para>
  <para style="q" vid="PSA 11:2">deregüda hamutu tebu gimara,</para>
  <para style="q" vid="PSA 11:2">aba hachüühan hawagun ha harumabaña</para>
  <para style="q" vid="PSA 11:2">lídangiñe fulasu le aramudaguati,<verse eid="PSA 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 11:3" />ani danti anihein lan chagaguaü lidan sun fulasu,</para>
  <para style="q" vid="PSA 11:3">kábagia gayara hamá gürigia ha richaguabaña adüga?»<verse eid="PSA 11:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 11:4" />Gama lumoun anihein Aburemei tidan luban to sánduboun;</para>
  <para style="q" vid="PSA 11:4">anihein lálana larúeihan Aburemei sielu,</para>
  <para style="q" vid="PSA 11:4">lau lagu fegeñu, aríagu liña houn sun gürigia.<verse eid="PSA 11:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 11:5" />Ariha lumutiña Aburemei buítiña hama salufuritiña,</para>
  <para style="q" vid="PSA 11:5">ani iyereegutiña ha hínsiñehabubaña lun anarimeni lun tau sun luani.<verse eid="PSA 11:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 11:6" />Láhuyagüdüba eñeguraü,</para>
  <para style="q" vid="PSA 11:6">watu gemeti luma súfuru hawagun wuribatiña,</para>
  <para style="q" vid="PSA 11:6">barǘ ligíame aban garabali le águduti sun katei.</para>
  <para style="q" vid="PSA 11:6">Líchugubei Aburemei le hadünabei houn!<verse eid="PSA 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 11:7" />Richaguati Aburemei</para>
  <para style="q" vid="PSA 11:7">ani hínsiñeti katei le richaguabei lun;</para>
  <para style="q" vid="PSA 11:7">ligía harihubei lubéi ha richaguabaña!<verse eid="PSA 11:7" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" sid="PSA 12" />
  <para style="s1">Afurieiduni amuriahei ídemuei lúmagiñe Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 12:1" />Sefubána Nabureme,</para>
  <para style="q" vid="PSA 12:1">ladüga úaaña afiñetiña gúnfulitiña le tímatimaati;</para>
  <para style="q" vid="PSA 12:1">úaaña gürigia buítiña.<verse eid="PSA 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 12:2" />Eyeedaguatiña houngua,</para>
  <para style="q" vid="PSA 12:2">hadimurehan lau bián luwuyeri ani mafurangudunti.<verse eid="PSA 12:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 12:3" />Aburemei, hulabei hálagüle biangua tigibu</para>
  <para style="q" vid="PSA 12:3">hama ha adimuredügübaña,<verse eid="PSA 12:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 12:4" />ha ariñagubaña:</para>
  <para style="q" vid="PSA 12:4">«Buídurügüti wayuma woun;</para>
  <para style="q" vid="PSA 12:4">tageindaguba wañeñe waweigiñe.</para>
  <para style="q" vid="PSA 12:4">Kábagia ariñaga woun: Adügabéi le?»<verse eid="PSA 12:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 12:5" />Anihán le lariñagubei Aburemei:</para>
  <para style="q" vid="PSA 12:5">«Násaara guentó ladüga hamudirawaguña gudemetiña,</para>
  <para style="q" vid="PSA 12:5">agúarahatiña débilitiña lau igarigu.</para>
  <para style="q" vid="PSA 12:5">Níchugubei ídemuei le hemegeirubei houn».<verse eid="PSA 12:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 12:6" />Inarüniti füramasei le líchugubei Wabureme woun;</para>
  <para style="q" vid="PSA 12:6">ítara liña kei pülata le fínutimabei,</para>
  <para style="q" vid="PSA 12:6">le adarúbei sedü wéiyaasu lidoun régigi!<verse eid="PSA 12:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 12:7" />Wabureme, bóunigirubadiwa;</para>
  <para style="q" vid="PSA 12:7">súnwandan baramudubadiwa lan</para>
  <para style="q" vid="PSA 12:7">hawéi hawuyeri gürigia hagía!<verse eid="PSA 12:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 12:8" />Éibugañaha haña wuribatiña lidan sun fulasu,</para>
  <para style="q" vid="PSA 12:8">ani sun gürigia gúndaatiña lau wuribani.<verse eid="PSA 12:8" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" sid="PSA 13" />
  <para style="s1">Afurieiduni amuriaha ídemuei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 13:1" />Nabureme,</para>
  <para style="q" vid="PSA 13:1">ídaba san lásura babulieidunina?</para>
  <para style="q" vid="PSA 13:1">Babulieidaadina san lun súnwandan?</para>
  <para style="q" vid="PSA 13:1">Ídaba san lásura baramudagun nuéi?<verse eid="PSA 13:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 13:2" />Ídaba san lásura tasufurirun nanigi</para>
  <para style="q" vid="PSA 13:2">tabu sun nuani íruni sun weyu?</para>
  <para style="q" vid="PSA 13:2">Ídaba san náfurida lábugiñegiñe lubafu nágani?<verse eid="PSA 13:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 13:3" />Nabureme, Nubungiute,</para>
  <para style="q" vid="PSA 13:3">arihabána, óunababana,</para>
  <para style="q" vid="PSA 13:3">buíngüdabei nagu lau larugounga!</para>
  <para style="q" vid="PSA 13:3">Méiguadun náamuga lidoun arumuguni le lánina óunweni!<verse eid="PSA 13:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 13:4" />Mariñagun láamuga nágani: «Gáñeina»!</para>
  <para style="q" vid="PSA 13:4">Magundaarun láamuga ánhana eferidira!<verse eid="PSA 13:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 13:5" />Hemenigitina luagu bínsiñehabu;</para>
  <para style="q" vid="PSA 13:5">gúndaatu nanigi ladüga besefurunina.<verse eid="PSA 13:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 13:6" />Neremuhaba lun Nabureme</para>
  <para style="q" vid="PSA 13:6">luagu ubuiduni le adüga láalibei nun!<verse eid="PSA 13:6" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" sid="PSA 14" />
  <para style="s1">Hagadeirun gürigia</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 14:1" />Ha ibidiouguabaña aau haritaguatiña luagu ua lan Bungiu;</para>
  <para style="q" vid="PSA 14:1">gádeihaña sun hagía;</para>
  <para style="q" vid="PSA 14:1">adügaaña burí katei hanarimeti luriban;</para>
  <para style="q" vid="PSA 14:1">Úaaña adügütiña buiti!<verse eid="PSA 14:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 14:2" />Ariha lumutiña Aburemei gürigia siélugiñe</para>
  <para style="q" vid="PSA 14:2">lun larihin anhein anihein lubéi aban hádangiñe</para>
  <para style="q" vid="PSA 14:2">le gunfurandati hadan lun láluahani Bungiu.<verse eid="PSA 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 14:3" />Gama lumoun sun hagía, ragǘ hamaali üma le wuribabei;</para>
  <para style="q" vid="PSA 14:3">sun hagía gádeihaña.</para>
  <para style="q" vid="PSA 14:3">Úaaña adügütiña le buídubei!</para>
  <para style="q" vid="PSA 14:3">Úati ni íbini aban!<verse eid="PSA 14:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 14:4" />Úati gunfuranda hamá ha adaagubaña wuribani,</para>
  <para style="q" vid="PSA 14:4">ha éigibaliña numutuniña kei heigin fein,</para>
  <para style="q" vid="PSA 14:4">ha magúarunbalin liri Aburemei.<verse eid="PSA 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 14:5" />Hadadagaruba lau anufudei,</para>
  <para style="q" vid="PSA 14:5">ladüga Bungiu, hámañein ha aganbubalin.<verse eid="PSA 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 14:6" />Éherahatiña lau hayumahan ha gudemebaña,</para>
  <para style="q" vid="PSA 14:6">lau sun lira góunigi lumutiña Aburemei.<verse eid="PSA 14:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 14:7" />Liábindügü hamuga lesefurun Ísüraeli lídangiñe wübü le Sión.</para>
  <para style="q" vid="PSA 14:7">Danme lasansiruni Aburemei habunurun lánigu,</para>
  <para style="q" vid="PSA 14:7">ábame hagundaaragun ladügawagun Hakobu,</para>
  <para style="q" vid="PSA 14:7">sun lumutuniña Ísüraeli.<verse eid="PSA 14:7" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" sid="PSA 15" />
  <para style="s1">Le lagurabubei Bungiu hámagiñe gürigia</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 15:1" />Aburemei,</para>
  <para style="q" vid="PSA 15:1">Ka gayaraabei laganóun biñuarü?</para>
  <para style="q" vid="PSA 15:1">Ka gayaraabei laganóun lidan buwübüri le sándubei?<verse eid="PSA 15:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 15:2" />Hárügüñanu richaguabaña abagaridun,</para>
  <para style="q" vid="PSA 15:2">adüga haméi le buídubei,</para>
  <para style="q" vid="PSA 15:2">ha ariñagubalin inarüni tídangiñe sun hanigi,<verse eid="PSA 15:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 15:3" />ha mayanuhanbaña wuriba ni ka uagu</para>
  <para style="q" vid="PSA 15:3">ha madügünbaña wuribati houn hamadagu,</para>
  <para style="q" vid="PSA 15:3">manabun hamaña habesinanigu,<verse eid="PSA 15:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 15:4" />ha arihibaña lau mabahüdǘni luagun katei le gadünabei</para>
  <para style="q" vid="PSA 15:4">lun larihín luagun lau mabahüdüni,</para>
  <para style="q" vid="PSA 15:4">gama lumoun rútiña inebesei</para>
  <para style="q" vid="PSA 15:4">lun le íchugubei inebesei lun Aburemei;</para>
  <para style="q" vid="PSA 15:4">ha agunfulirubalin le füramase hamaalibei,</para>
  <para style="q" vid="PSA 15:4">íbini dan le wuriba lan lidin houn;<verse eid="PSA 15:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 15:5" />ha afuredeihabalin haseinsun mamuriahanga lanwoun,</para>
  <para style="q" vid="PSA 15:5">ha máhabaña lun hariñagun luagu gadurun lan le madurunbei</para>
  <para style="q" vid="PSA 15:5">lúnrügü heresibirun seinsu.</para>
  <para style="q" vid="PSA 15:5">Ha abagaridutiña ítara, méiguadundügübaña.<verse eid="PSA 15:5" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" sid="PSA 16" />
  <para style="s1">Alagan le buítimabei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 16:1" />Góunigibana Bungiu,</para>
  <para style="q" vid="PSA 16:1">ladüga bóubawagu náluaha naramudagun!<verse eid="PSA 16:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 16:2" />Ariñagaadina bun:</para>
  <para style="q" vid="PSA 16:2">«Buguya Naburemebei, buítibu nun;</para>
  <para style="q" vid="PSA 16:2">úati kei buguya».<verse eid="PSA 16:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 16:3" />Garíawasetiña gürigia sándutiña ha ubouagubaña,</para>
  <para style="q" vid="PSA 16:3">wéiriti nugundan dan le hámañadina lan.<verse eid="PSA 16:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 16:4" />Ha anúadirubaña amu búngiugu</para>
  <para style="q" vid="PSA 16:4">barütiña saragu asufuriruni hóuniwagua.</para>
  <para style="q" vid="PSA 16:4">Múaradundügübadina hama</para>
  <para style="q" vid="PSA 16:4">lidan hadagaragüdün le gaganati hitaü!</para>
  <para style="q" vid="PSA 16:4">Míridun nubéi hiri lau niyuma!<verse eid="PSA 16:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 16:5" />Nabureme, buguyarügüñein nun;</para>
  <para style="q" vid="PSA 16:5">biní bumutina saragu;</para>
  <para style="q" vid="PSA 16:5">búhaburuguñein nibagari.<verse eid="PSA 16:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 16:6" />Buiti ubaraü le ñein lubéi bíchigana;</para>
  <para style="q" vid="PSA 16:6">buiti nalagante buma!<verse eid="PSA 16:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 16:7" />Nalawahabei Nabureme,</para>
  <para style="q" vid="PSA 16:7">ladüga ligía adundehabalina,</para>
  <para style="q" vid="PSA 16:7">íbini áriebu arufudahati nun</para>
  <para style="q" vid="PSA 16:7">tidoun tilulin-agei nanigi.<verse eid="PSA 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 16:8" />Súnwandan anihein lan Nabureme nigibugiñe,</para>
  <para style="q" vid="PSA 16:8">lau Bungiu luéigiñe nóunwenren,</para>
  <para style="q" vid="PSA 16:8">úabei éiguadagüdütina.<verse eid="PSA 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 16:9" />Ligía buin tiña lubéi nanigi lau ugundani.</para>
  <para style="b" vid="PSA 16:9" />
  <para style="q" vid="PSA 16:9">Labagariduba sun núgubu lau emenigini,<verse eid="PSA 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 16:10" />ladüga mígirun bubadina lidan umúahaü,</para>
  <para style="q" vid="PSA 16:10">mígirunbadibu lun tañaladun nuani húyurugu!<verse eid="PSA 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 16:11" />Barufudubei lémeri ibagari nun.</para>
  <para style="q" vid="PSA 16:11">Anihein óunwenbu ugundani biñuarü;</para>
  <para style="q" vid="PSA 16:11">anihein buiduu le magumuchaditi burugabu.<verse eid="PSA 16:11" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" sid="PSA 17" />
  <para style="s1">Lamuriahóun irichaü</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 17:1" />Nabureme, aganbabéi nikesin le richabei,</para>
  <para style="q" vid="PSA 17:1">aganbabéi nagúahan ídemuei,</para>
  <para style="q" vid="PSA 17:1">rubei barigei lun nafurieidun,</para>
  <para style="q" vid="PSA 17:1">ladüga mama lídangiñe iyumaaru le marasualuguti láfurida.<verse eid="PSA 17:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 17:2" />Búmagiñela liabin nasiadirúniwa,</para>
  <para style="q" vid="PSA 17:2">ladüga subudi bumuti katei le richaguabei!<verse eid="PSA 17:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 17:3" />Beluhadibu lidoun nisaminan;</para>
  <para style="q" vid="PSA 17:3">ñǘbuinhadibu aríaahana áriebu;</para>
  <para style="q" vid="PSA 17:3">hóuchagua báadina lau watu gemeti,</para>
  <para style="q" vid="PSA 17:3">madaritibu wuribani nidan.</para>
  <para style="q" vid="PSA 17:3">Mariñagungidina burí katei le moun lumuti<verse eid="PSA 17:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 17:4" />kei hadüga híbiri,</para>
  <para style="q" vid="PSA 17:4">díreihadina luéi émeri le lánina anarimeni,</para>
  <para style="q" vid="PSA 17:4">kei le aubei lariñagei bilurudun.<verse eid="PSA 17:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 17:5" />Deregüdagumemeniña lidan bémeri,</para>
  <para style="q" vid="PSA 17:5">úagili agidarutina ñéingiñe.<verse eid="PSA 17:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 17:6" />Bungiu, iñura numuti numalali bun,</para>
  <para style="q" vid="PSA 17:6">ladüga óunaba bumutina;</para>
  <para style="q" vid="PSA 17:6">tenibá nun, aganbabéi le nariñagubei bun.<verse eid="PSA 17:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 17:7" />Furangulá barufuduni bínsiñehabu;</para>
  <para style="q" vid="PSA 17:7">séfuñuwaña bóubawagu hawéi wáganiñu.<verse eid="PSA 17:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 17:8" />Góunigibana kei lila bagu;</para>
  <para style="q" vid="PSA 17:8">daruguabá nau lau barüna,<verse eid="PSA 17:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 17:9" />hawéi wuribatiña ha álugubaña hábürühan nuagun,</para>
  <para style="q" vid="PSA 17:9">hawéi áganiñu gáfarahatiña ha geyegubaña nau!<verse eid="PSA 17:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 17:10" />Barüguatiña houngua,</para>
  <para style="q" vid="PSA 17:10">íñuguti hadimurehan;<verse eid="PSA 17:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 17:11" />ayarafahóuaña nun,</para>
  <para style="q" vid="PSA 17:11">agurabei dan lun hágurunina múarugun.<verse eid="PSA 17:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 17:12" />Ítara haña kei liñún,</para>
  <para style="q" vid="PSA 17:12">ha aranseñubaña lidan haramudaguagüle</para>
  <para style="q" vid="PSA 17:12">aguraba hachubarun luagun háliru.<verse eid="PSA 17:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 17:13" />Iñuraguabá Nabureme, gagibuguabá hama!</para>
  <para style="q" vid="PSA 17:13">Huduguagüdabaña!</para>
  <para style="q" vid="PSA 17:13">Sefubána luéi le salufuribei tau befeinte;<verse eid="PSA 17:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 17:14" />sefubána hawéi lau bubafu, Nabureme;</para>
  <para style="q" vid="PSA 17:14">sefubána hawéi wügüriña lánina ubóu le,</para>
  <para style="q" vid="PSA 17:14">chagabaña luéi ubóu le,</para>
  <para style="q" vid="PSA 17:14">le halagantebei lidan ibagari le!</para>
  <para style="q" vid="PSA 17:14">Ígiraba lun lagibedagun harisin,</para>
  <para style="q" vid="PSA 17:14">hou hamá hasaanigu darí hafaünchün,</para>
  <para style="q" vid="PSA 17:14">ígiragua ligíame houn habañan.<verse eid="PSA 17:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 17:15" />Ánheinti au,</para>
  <para style="q" vid="PSA 17:15">buídurügübei nun láurügü narihinibu igibu luma igibu;</para>
  <para style="q" vid="PSA 17:15">lau nadariragun nungua bigibugiñe danme le nagagudún!<verse eid="PSA 17:15" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" sid="PSA 18" />
  <para style="s1">Aban uremu lánina agañeiruni</para>
  <para style="r">(<ref loc="2SA 22:1-51">2 Sam 22.1-51</ref>)</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 18:1" />Nabureme, buguya nérebei;</para>
  <para style="q" vid="PSA 18:1">hínsiñetibu nun!<verse eid="PSA 18:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 18:2" />Buguya óunigirubalina,</para>
  <para style="q" vid="PSA 18:2">naramudaguagüle,</para>
  <para style="q" vid="PSA 18:2">nesefuragüle,</para>
  <para style="q" vid="PSA 18:2">Nubungiute,</para>
  <para style="q" vid="PSA 18:2">dübü le gayaraabei naramudagun lanagangiñe,</para>
  <para style="q" vid="PSA 18:2">nidaüdina lauti gürabu,</para>
  <para style="q" vid="PSA 18:2">ubafu le esefurubalina,</para>
  <para style="q" vid="PSA 18:2">liñun-agei naramudaguagüle.<verse eid="PSA 18:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 18:3" />Nabureme, gadünatibu uéiriguni,</para>
  <para style="q" vid="PSA 18:3">dan le nagúarun bun, sefu bumutina hawéi náganiñu.<verse eid="PSA 18:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 18:4" />Dahigua lumutina óunweni lidan lugurudun;</para>
  <para style="q" vid="PSA 18:4">sanditina anufudei ligibugiñe lanarime gagünrinchaguaditi.<verse eid="PSA 18:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 18:5" />Hóuburagua lumutina óunweni lidan lugurudun;</para>
  <para style="q" vid="PSA 18:5">sandiguatina nungua tidan burí sádara lánina óunweni!<verse eid="PSA 18:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 18:6" />Lidan násiñaragun nungua, wátina lun Nabureme;</para>
  <para style="q" vid="PSA 18:6">amuriahatina ídemuei luma Nubungiute,</para>
  <para style="q" vid="PSA 18:6">aba laganbunina lúbiñegiñe;</para>
  <para style="q" vid="PSA 18:6">chülüti nagúaragun larigeirugun!<verse eid="PSA 18:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 18:7" />Ábati ladagarun aban hárabaganali héreti:</para>
  <para style="q" vid="PSA 18:7">Aba lánhingichunga wübü lúmagiñe lugudina;</para>
  <para style="q" vid="PSA 18:7">hingí lumuti burí ligañi Aburemei wübü.<verse eid="PSA 18:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 18:8" />Furiti gumuleli lígirugugiñe,</para>
  <para style="q" vid="PSA 18:8">furiti watu gemeti le gagünrinchaguaditi</para>
  <para style="q" vid="PSA 18:8">luma eñeguraü durunguati liyumulugugiñe.<verse eid="PSA 18:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 18:9" />Dará lumutu likorutinan sielu, aba lararirun.</para>
  <para style="q" vid="PSA 18:9">Ñeinñein burí huánriñu wuriti lábugiñe lugudi!<verse eid="PSA 18:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 18:10" />Aba lawarirun luagu aban katei garünati, aba láhamarun,</para>
  <para style="q" vid="PSA 18:10">aba lidin ligibuagu larüna garabali.<verse eid="PSA 18:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 18:11" />Aba laramudagun lidan lueirin luburiga le geyegubei lau,</para>
  <para style="q" vid="PSA 18:11">luma burí huánriñu wuriti le buinbei lau duna.<verse eid="PSA 18:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 18:12" />Aba láfuridun aban labirihaniga le ñéingiñe lubéi;</para>
  <para style="q" vid="PSA 18:12">aba lábürühan lúbara huya dereguati</para>
  <para style="q" vid="PSA 18:12">luma garubun gemeti dúerirugugiñe.<verse eid="PSA 18:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 18:13" />Aburemei, le Íñugutimabei,</para>
  <para style="q" vid="PSA 18:13">aganbagüda lumuti lumalali le wayuhuru siélugiñe:</para>
  <para style="q" vid="PSA 18:13">Lúbara huya dereguati luma garubun gemeti.<verse eid="PSA 18:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 18:14" />Chü lumuti labirihaniga kei gimara,</para>
  <para style="q" vid="PSA 18:14">aba léibaaguagüdüniña náganiñu lau chagaguaü.<verse eid="PSA 18:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 18:15" />Rédeiti lábugiñe barana furangu,</para>
  <para style="q" vid="PSA 18:15">arihúati burí lebu ubóu,</para>
  <para style="q" vid="PSA 18:15">ladüga lumalali Aburemei le asiadihabei,</para>
  <para style="q" vid="PSA 18:15">ladüga áfuruni héreti le ladügübei.<verse eid="PSA 18:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 18:16" />Tulé lumuti Bungiu lúhabu nun íñugiñe,</para>
  <para style="q" vid="PSA 18:16">aba lasagarunina lídangiñe lueirin barana lau lúhabu.<verse eid="PSA 18:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 18:17" />Sefu lumutina hawéi áganiñu gabafutiña,</para>
  <para style="q" vid="PSA 18:17">ha iyereehabúbaña nun,</para>
  <para style="q" vid="PSA 18:17">ani ha héretiña sügǘ nau.<verse eid="PSA 18:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 18:18" />Ábürühatiña nuagun dan meha le lídanñadina lamiselu,</para>
  <para style="q" vid="PSA 18:18">gama lumoun íderagua lumutina Nabureme:<verse eid="PSA 18:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 18:19" />Sefu lumutina luéi denchaü;</para>
  <para style="q" vid="PSA 18:19">sefu lumutina ladüga nínsiñe lun!<verse eid="PSA 18:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 18:20" />Ru laali Nabureme lafayeiruaha laruman nigaburi nun;<verse eid="PSA 18:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 18:21" />ladüga falá naali lémeri Nabureme;</para>
  <para style="q" vid="PSA 18:21">Meyeedagungidina lau Nubungiute<verse eid="PSA 18:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 18:22" />Subudi numuti sun lilurudun;</para>
  <para style="q" vid="PSA 18:22">mamaharungidina lun nagunfuliruni lugumadin.<verse eid="PSA 18:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 18:23" />Éibugaadina ligibugiñe lidan arumani,</para>
  <para style="q" vid="PSA 18:23">díseedina luéi wuribani.<verse eid="PSA 18:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 18:24" />Rúhali Nabureme nafayeiruaha luagu laruman nigaburi ligibugiñe.<verse eid="PSA 18:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PSA 18:25" />Buguya Aburemei, gúnfulitibu hama ha gúnfulibaña,</para>
  <para style="q" vid="PSA 18:25">úaragua buguya hama ha úaraguabaña.<verse eid="PSA 18:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 18:26" />Harumatibu hama ha harumabaña,</para>
  <para style="q" vid="PSA 18:26">gama lumoun deretibu hama ha salufuribaña.<verse eid="PSA 18:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 18:27" />Sefu bumutiña ha ǘnabubei hanaagun houngua,</para>
  <para style="q" vid="PSA 18:27">gama lumoun ǘnabugüda bumutiña ha barüguabaña houngua.<verse eid="PSA 18:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 18:28" />Buguya Nabureme, rútibu larugounga nun;</para>
  <para style="q" vid="PSA 18:28">harugoungadagüdatibu nau lidan luburiga.<verse eid="PSA 18:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 18:29" />Nageindaguba luma nágani lau bídehan,</para>
  <para style="q" vid="PSA 18:29">násügürüba luéigiñe lubarieirun luburugute.<verse eid="PSA 18:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="PSA 18:30" />Suruti lémeri Bungiu,</para>
  <para style="q" vid="PSA 18:30">gadünati lererun Aburemei lun lemenigidun luagu;</para>
  <para style="q" vid="PSA 18:30">góunigi lumutiña Bungiu sun ha afiñebaña luagu!<verse eid="PSA 18:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 18:31" />Ka Búngiubei bóugudin luéi Wabureme?</para>
  <para style="q" vid="PSA 18:31">Ka amu bungiu gayaraabei lóunigiruniwa?<verse eid="PSA 18:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 18:32" />Bungiu íchugubei erei nun,</para>
  <para style="q" vid="PSA 18:32">ligía adügübei lun haruma lan nigaburi,<verse eid="PSA 18:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 18:33" />furesegüda lumuti néibugun kei usari,</para>
  <para style="q" vid="PSA 18:33">ru ligía iderebugu nun lidan liñun-agei wübü,<verse eid="PSA 18:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 18:34" />ligía aranserubalina lun wuribu,</para>
  <para style="q" vid="PSA 18:34">ligía íchugubei erei nun</para>
  <para style="q" vid="PSA 18:34">lun nederaagüdün tebu gimara to lautu buronse.<verse eid="PSA 18:34" /></para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" sid="PSA 18:35" />Góunigi bumutina ani sefubána.</para>
  <para style="q" vid="PSA 18:35">Ágüdaha bumutina lau búhabu le bóunwenren,</para>
  <para style="q" vid="PSA 18:35">awansegüda láadina bareini.<verse eid="PSA 18:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 18:36" />Mérengugüda bumuti némeri,</para>
  <para style="q" vid="PSA 18:36">sefubéi néibugun lun miriraagun lan nugudi.<verse eid="PSA 18:36" /></para>
  <para style="b" />
  <para style="q">
    <verse number="37" style="v" sid="PSA 18:37" />Éibaaha numutiña náganiñu, ani ragǘ numutiña,</para>
  <para style="q" vid="PSA 18:37">aba nagiribudun lárigiñe náfaraguniña.<verse eid="PSA 18:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 18:38" />Amurusuha numutiña,</para>
  <para style="q" vid="PSA 18:38">aba másaarundigiaaña lan.</para>
  <para style="q" vid="PSA 18:38">Ábürühatiña lábugiñoun nugudi!<verse eid="PSA 18:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 18:39" />Rútibu erei nun wuriburugu;</para>
  <para style="q" vid="PSA 18:39">adügatibu lun habuluchagun wuribatiña nigibugiñe,<verse eid="PSA 18:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 18:40" />Adügatibu lun hanurahan náganiñu nuéi.</para>
  <para style="q" vid="PSA 18:40">Ítara liña nagünrinchaguniña ha iyereehabúbaña nun.<verse eid="PSA 18:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 18:41" />Amuriahatiña ídemuei, ani úati íderagutiña;</para>
  <para style="q" vid="PSA 18:41">agúahatiña lun Aburemei, ani móunabun lumutiña.<verse eid="PSA 18:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 18:42" />Mulili numutiña kei kaliki le lanügün garabali!</para>
  <para style="q" vid="PSA 18:42">Dügügua numutiña kei gubegubeti ǘmada!<verse eid="PSA 18:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 18:43" />Sefu bumutina hawéi gürigia wuribatiña,</para>
  <para style="q" vid="PSA 18:43">adüga bumutina lun hábuti nan néchanigu,</para>
  <para style="q" vid="PSA 18:43">seriwi hamana gürigia ha buga ibidiñetiña nun.<verse eid="PSA 18:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 18:44" />Lidan haganbunina, aba hadügüni le nubeibei;</para>
  <para style="q" vid="PSA 18:44">gúndaatiña gürigia terencha nau.<verse eid="PSA 18:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 18:45" />Hanufudeguatiña gürigia terencha,</para>
  <para style="q" vid="PSA 18:45">aba háfuridun adadagareina lídangiñe haramudaguagüle.<verse eid="PSA 18:45" /></para>
  <para style="b" />
  <para style="q">
    <verse number="46" style="v" sid="PSA 18:46" />Wínwanla Nabureme Bungiu!</para>
  <para style="q" vid="PSA 18:46">Alawahoualá le óunigirubalina!</para>
  <para style="q" vid="PSA 18:46">Iñurualá Bungiu le Nesefuragüle!<verse eid="PSA 18:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 18:47" />Ligía Bungiu le ageindaguaalibei nuéigiñe,</para>
  <para style="q" vid="PSA 18:47">le íchugubaliña gürigia lábugiñoun nere.<verse eid="PSA 18:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 18:48" />Sefu lumutina luéi hagañi náganiñu,</para>
  <para style="q" vid="PSA 18:48">hawéi wuribatiña ha iñuragubaña houngua nuagun.</para>
  <para style="q" vid="PSA 18:48">Nabureme, sefu bumutina hawéi wügüriña hanarimetiña!<verse eid="PSA 18:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 18:49" />Ligía níchugunbei uéiriguni bun haganagua néchanigu,</para>
  <para style="q" vid="PSA 18:49">eremuha au uremu lidan biri.<verse eid="PSA 18:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 18:50" />Rútibu burí agañeiruni wéinamuti lun urúei le banúadirubei,</para>
  <para style="q" vid="PSA 18:50">súnwandan bóuseruni Dawidi lau ínsiñeni hau sun ladügawagun.<verse eid="PSA 18:50" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" sid="PSA 19" />
  <para style="s1">Luéirigun Bungiu lidan sun le ladügübei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 19:1" />Abahüdagua lumuti sielu luéirigun Bungiu,</para>
  <para style="q" vid="PSA 19:1">adimureha ligía woun luagu le ladügübei lau lúhabu.<verse eid="PSA 19:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 19:2" />Abahüdaguati aban weyu lun le aban</para>
  <para style="q" vid="PSA 19:2">luagu uéiriguni ligia;</para>
  <para style="q" vid="PSA 19:2">águyuguagüdalei aban áriebu lun le aban.<verse eid="PSA 19:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 19:3" />Lau sun maganbúniwa lan burí dimurei,</para>
  <para style="q" vid="PSA 19:3">maganbúniwa ligía umalali,<verse eid="PSA 19:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 19:4" />éibuga lumuti dimurei ligía sun ubóu,</para>
  <para style="q" vid="PSA 19:4">chülǘ lumoun lagumuhóun larigeirugu ubóu,</para>
  <para style="q" vid="PSA 19:4">darí lumoun le ñein tubéi luban weyu.<verse eid="PSA 19:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 19:5" />Gumeseti weyu éibugei lémeri</para>
  <para style="q" vid="PSA 19:5">lau ugundani kei aban géibaaguaditi,</para>
  <para style="q" vid="PSA 19:5">kei aban adari le áfuridubei</para>
  <para style="q" vid="PSA 19:5">lídangiñe rumu lánina lamarieidun.<verse eid="PSA 19:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 19:6" />Láfurida weyu luéigiñe aban louba sielu,</para>
  <para style="q" vid="PSA 19:6">aba lagararaagun darí lachülürün luagun le aban oubaü,</para>
  <para style="q" vid="PSA 19:6">úouga ni kata lun lanurahan luéi lisü.<verse eid="PSA 19:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 19:7" />Suruti larufudahan Aburemei,</para>
  <para style="q" vid="PSA 19:7">ladüga ruti ibagari le iseriti.</para>
  <para style="q" vid="PSA 19:7">Úaraguati lugumadin Aburemei</para>
  <para style="q" vid="PSA 19:7">ladüga chúgüdati hau gürigia ha ǘnabugubaña.<verse eid="PSA 19:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 19:8" />Richaguati buriti lilurudun Aburemei,</para>
  <para style="q" vid="PSA 19:8">ladüga barüti ugundani tun anigi.</para>
  <para style="q" vid="PSA 19:8">Harumati lugumadin Aburemei,</para>
  <para style="q" vid="PSA 19:8">ani harugoungadagüda lumuti agu.<verse eid="PSA 19:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 19:9" />Harumati linebenwa Aburemei,</para>
  <para style="q" vid="PSA 19:9">rédeiti lun súnwandan.</para>
  <para style="q" vid="PSA 19:9">Inarüniti burí lererun Aburemei,</para>
  <para style="q" vid="PSA 19:9">ani richati súngubei;<verse eid="PSA 19:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 19:10" />gebegiti sügǘ lau golu le fínuti!</para>
  <para style="q" vid="PSA 19:10">Bime ligía sügǘ lau sírudu le lídangiñeti mábadiga!<verse eid="PSA 19:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 19:11" />Eweridihani giñe burí ligía nun au le bubuein,</para>
  <para style="q" vid="PSA 19:11">ani buiti nun lun nafalaruni.<verse eid="PSA 19:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 19:12" />Ka gefenbei luagu bulíeiguaü le guánarügü ladügübei?</para>
  <para style="q" vid="PSA 19:12">Nabureme, ferudunabana luagu wuribati</para>
  <para style="q" vid="PSA 19:12">le nadügübei ibidiñounga nun!<verse eid="PSA 19:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 19:13" />Gidabei anaaguni unguaü nuéi;</para>
  <para style="q" vid="PSA 19:13">mígiraba lun ladügüni pantaü le labusenrun nau.</para>
  <para style="q" vid="PSA 19:13">Ítara luba aban nan gürigia harumati,</para>
  <para style="q" vid="PSA 19:13">sefu aume giñe luéi óunwenbu figóu.<verse eid="PSA 19:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 19:14" />Buidulá nererun luma nisaminan ligibugiñe bagu,</para>
  <para style="q" vid="PSA 19:14">buguya Nabureme le esefurubalina, le naramudaguagüle.<verse eid="PSA 19:14" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" sid="PSA 20" />
  <para style="s1">Afurieiduni luagu agañeiruni</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 20:1" />Aganba labu Aburemei lidan idiheri;</para>
  <para style="q" vid="PSA 20:1">ageindagualá Lubungiute Hakobu buéigiñe.<verse eid="PSA 20:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 20:2" />Óunahala ídemuei bun tídangiñe lisanduariun Bungiu to Sionboun.<verse eid="PSA 20:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 20:3" />Haritagualá luagu sun bidewese lun,</para>
  <para style="q" vid="PSA 20:3">resibileime sun badagaragüdün</para>
  <para style="q" vid="PSA 20:3">le gudawarügüti luagu latarü lau ugundani.<verse eid="PSA 20:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 20:4" />Gúnfulilei sun bayumahan,</para>
  <para style="q" vid="PSA 20:4">adügaleime sun le baritagubei badügün.<verse eid="PSA 20:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 20:5" />Wefeduhaba ítara luagu bagañeirun,</para>
  <para style="q" vid="PSA 20:5">wiñuruba fanidira lidan liri Wabungiute.</para>
  <para style="q" vid="PSA 20:5">Gúnfulilei Aburemei sun le bamuriahabei!<verse eid="PSA 20:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 20:6" />Chouru naali luagu líchugubei lan Aburemei</para>
  <para style="q" vid="PSA 20:6">agañeiruni lun urúei le lanúadirubei,</para>
  <para style="q" vid="PSA 20:6">luagu lóunabubei lan giñe siélugiñe,</para>
  <para style="q" vid="PSA 20:6">rúina ligíame agañeiruni lun lau lubafu.<verse eid="PSA 20:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 20:7" />Añahein afiñetiña tuagu burí hakarün to lánina wuribu,</para>
  <para style="q" vid="PSA 20:7">híbiri afiñetiña hawagu halügüniña gabayu;</para>
  <para style="q" vid="PSA 20:7">anhein wagía luagu Aburemei le Wabungiute wafiñera.<verse eid="PSA 20:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 20:8" />Hagía, baruguati hagachürügü aba héiguadun,</para>
  <para style="q" vid="PSA 20:8">anhein wagía, derebugumemetiwa raramémewaña giñe.<verse eid="PSA 20:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 20:9" />Aburemei, rubei agañeiruni lun urúei!</para>
  <para style="q" vid="PSA 20:9">Óunababawa dan le wagúarun bun!<verse eid="PSA 20:9" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" sid="PSA 21" />
  <para style="s1">Aban uremu lánina agañeiruni</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 21:1" />Aburemei,</para>
  <para style="q" vid="PSA 21:1">gúndaati urúei ladüga rúhadibu lan erei lun;</para>
  <para style="q" vid="PSA 21:1">wéiriti lugundan</para>
  <para style="q" vid="PSA 21:1">ladüga ru baali lan agañeiruni lun!<verse eid="PSA 21:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 21:2" />Gúnfuli baali labusenrun;</para>
  <para style="q" vid="PSA 21:2">ru baali le lamuriahabei lun.<verse eid="PSA 21:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 21:3" />Resibi bumuti lau óunwenbu abiniruni,</para>
  <para style="q" vid="PSA 21:3">aba bíchugun aban ridi le lauti golu luagu.<verse eid="PSA 21:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 21:4" />Amuriahati ibagari buma, ani ru bumuti lun:</para>
  <para style="q" vid="PSA 21:4">Ibagari migifeti le magumuchaditi.<verse eid="PSA 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 21:5" />Seremei bídehan luéirinbei lubafu;</para>
  <para style="q" vid="PSA 21:5">rúhadibu uéiriguni luma inebesei lun.<verse eid="PSA 21:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 21:6" />Biní baali lun súnwandan;</para>
  <para style="q" vid="PSA 21:6">lau biñuarü buíngüda bumuti lau ugundani.<verse eid="PSA 21:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 21:7" />Buguya urúei, mábürühandügübadibu,</para>
  <para style="q" vid="PSA 21:7">ladüga afiñetibu luagu Aburemei;</para>
  <para style="q" vid="PSA 21:7">hemenigitibu luagu línsiñehabu le Íñugutimabei!<verse eid="PSA 21:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 21:8" />Lárügüdübaña bubafu sun báganiñu;</para>
  <para style="q" vid="PSA 21:8">lárügüdübaña bóunwenren sun ha iyereehabúbaña bun;<verse eid="PSA 21:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 21:9" />bíchugubaña lidoun aban régigi gemeti</para>
  <para style="q" vid="PSA 21:9">danme bachülaagun lun baguseragüdün.</para>
  <para style="q" vid="PSA 21:9">Lagumuchaguagüdübaña Aburemei lau ligañi,</para>
  <para style="q" vid="PSA 21:9">lau watu gemeti le gagumuchaguagüdaditi.<verse eid="PSA 21:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 21:10" />Bagünrinchagubaña harahüñü hama hadügawagun ubouagugiñe</para>
  <para style="q" vid="PSA 21:10">luma hádangiñe gürigia.<verse eid="PSA 21:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 21:11" />Busén hagía yebe hadügün wuribati bun,</para>
  <para style="q" vid="PSA 21:11">eledegua hagía bubá, siñabei hadügün ni kata.<verse eid="PSA 21:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 21:12" />Badügüba lun héibaagun</para>
  <para style="q" vid="PSA 21:12">setibóunme bigimaran hawagun.<verse eid="PSA 21:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 21:13" />Saraba lau bubafu Aburemei!</para>
  <para style="q" vid="PSA 21:13">Wefeduhaba lau uremu luagu bagañeirun!<verse eid="PSA 21:13" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" sid="PSA 22" />
  <para style="s1">Igarigu luma alawahani</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 22:1" />Nubungiute, Nubungiute,</para>
  <para style="q" vid="PSA 22:1">ka san uagu bígirana?</para>
  <para style="q" vid="PSA 22:1">Ka san uagu miábinbubei esefurana?</para>
  <para style="q" vid="PSA 22:1">Ka uagu meteni bubéi lun nayahun?<verse eid="PSA 22:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 22:2" />Nubungiute,</para>
  <para style="q" vid="PSA 22:2">agúahatina bun áriebu wéyuagu, móunabuntibu;</para>
  <para style="q" vid="PSA 22:2">úati emeraaguni nun!<verse eid="PSA 22:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 22:3" />Gama lumoun sándutibu</para>
  <para style="q" vid="PSA 22:3">rútiña Ísüraelina uéiriguni bun lidan barúeihan.<verse eid="PSA 22:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 22:4" />Afiñetiña meha wagübürigu buagu,</para>
  <para style="q" vid="PSA 22:4">hemenigitiña buagu ani aba besefuruniña,<verse eid="PSA 22:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 22:5" />amuriahatiña ídemuei buma, aba besefuruniña;</para>
  <para style="q" vid="PSA 22:5">aba hafiñerun buagu ani meredetibu wuriba hama.<verse eid="PSA 22:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 22:6" />Gama lumoun mama aban wügüri au, aban héweraü au,</para>
  <para style="q" vid="PSA 22:6">héheraagüle gürigia au!<verse eid="PSA 22:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 22:7" />Ha arihitina adaaguatiña bula nau;</para>
  <para style="q" vid="PSA 22:7">asagaha hamutu hañeñe nun,</para>
  <para style="q" vid="PSA 22:7">aba hánhinhani hachügü;<verse eid="PSA 22:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 22:8" />hariñagati:</para>
  <para style="q" vid="PSA 22:8">«Ru laali lafiñen luagu Bungiu,</para>
  <para style="q" vid="PSA 22:8">sefuléiti Aburemei guentó,</para>
  <para style="q" vid="PSA 22:8">anhein inarüni lubéi luagu hínsiñe lan lun, salbaléigia».<verse eid="PSA 22:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 22:9" />Ani ítara liñati:</para>
  <para style="q" vid="PSA 22:9">Furigüda bumutina turageirugugiñe núguchu,</para>
  <para style="q" vid="PSA 22:9">emeraaguagüda bumutina taniguagu.<verse eid="PSA 22:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 22:10" />Lubaragiñebei nágurahoun,</para>
  <para style="q" vid="PSA 22:10">rúatina lábugiñoun baríaahan;</para>
  <para style="q" vid="PSA 22:10">lúmagiñe turageirugugiñe núguchu,</para>
  <para style="q" vid="PSA 22:10">buguya Nubungiutebei.<verse eid="PSA 22:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 22:11" />Madisedabá nuéi,</para>
  <para style="q" vid="PSA 22:11">ladüga madisetina luéi idiheri,</para>
  <para style="q" vid="PSA 22:11">ani úati kaba lan íderaguana.<verse eid="PSA 22:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 22:12" />Geyeguaaña náganiñu nau kamá bágasu,</para>
  <para style="q" vid="PSA 22:12">kamá bágasu gáñitiña ha Basangiñetiña;<verse eid="PSA 22:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 22:13" />adürürühatiña kei liñún gáñitiña,</para>
  <para style="q" vid="PSA 22:13">wagatiña, aba hahunragun houngua nuagun.<verse eid="PSA 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 22:14" />Ítara niña keisi duna le áwiyuruti,</para>
  <para style="q" vid="PSA 22:14">luguguaali súngubei nabu.</para>
  <para style="q" vid="PSA 22:14">Ítara tiña nanigi nidan</para>
  <para style="q" vid="PSA 22:14">kei lubuña sanudelu le arürüdaguti.<verse eid="PSA 22:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 22:15" />Mábeiha nagülerugu kei kaliki;</para>
  <para style="q" vid="PSA 22:15">badüle niñeñe luagu nisielun;</para>
  <para style="q" vid="PSA 22:15">bulugüda báadina chülǘ lumoun óunweni!<verse eid="PSA 22:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 22:16" />Geyegua hamaadina saragu wuribatiña le gumuti, kamá le ounli,</para>
  <para style="q" vid="PSA 22:16">héirigua hamaali núhabu luma nugudi.<verse eid="PSA 22:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 22:17" />Gayaraahali nabahüdüni nabu!</para>
  <para style="q" vid="PSA 22:17">Magida hamuti náganiñu harihin nuéi;<verse eid="PSA 22:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 22:18" />fánreingua hamaaru nadaüragun hádangua,</para>
  <para style="q" vid="PSA 22:18">aba háhurerun ubunuruni tuagu.<verse eid="PSA 22:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 22:19" />Gama lumoun, Nabureme,</para>
  <para style="q" vid="PSA 22:19">buguya le íchugubei erei nun, madisedabá!</para>
  <para style="q" vid="PSA 22:19">Ñǘbuinba íderaguana lau lufuresen!<verse eid="PSA 22:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 22:20" />Sefubána luéi nounwen afarúarügü lau tamana eféin;</para>
  <para style="q" vid="PSA 22:20">mígiraba lun háfarunina óunligu ha hilagubei;<verse eid="PSA 22:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 22:21" />sefubána luéi hayuma burí liñún ha;</para>
  <para style="q" vid="PSA 22:21">aramudabana luéi haganchun burí bágasu ha!<verse eid="PSA 22:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 22:22" />Nadimurehaba buagu houn níbirigu,</para>
  <para style="q" vid="PSA 22:22">nadimurehaba buidu buagu lidan hadamuridagun.<verse eid="PSA 22:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 22:23" />Huguya le inebehabubei lun Aburemei,</para>
  <para style="q" vid="PSA 22:23">alawaha huméi!</para>
  <para style="q" vid="PSA 22:23">Sun ladügawagun Hakobu ru humá uéiriguni lun!</para>
  <para style="q" vid="PSA 22:23">Heremuha sun ladügawagun Ísüraeli lun!<verse eid="PSA 22:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 22:24" />Ladüga Ligía, marihin lumuti</para>
  <para style="q" vid="PSA 22:24">hasufurirun gudemetiña kei ni kata</para>
  <para style="q" vid="PSA 22:24">maramudagun ligía hawéi.</para>
  <para style="q" vid="PSA 22:24">Aganba lumutiña dan le hamuriahan ídemuei luma!<verse eid="PSA 22:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 22:25" />Nalawahabadibu luagu bagunfulirun</para>
  <para style="q" vid="PSA 22:25">lau bererun hagibugiñe saragu bumutuniña;</para>
  <para style="q" vid="PSA 22:25">nagunfulirubei nani füramasei bun hagibugiñe</para>
  <para style="q" vid="PSA 22:25">ha íchugubaña inebesei bun.<verse eid="PSA 22:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PSA 22:26" />Hou humá, huguya nidiheritiña, darí hakimuledun;</para>
  <para style="q" vid="PSA 22:26">halawahei Aburemei, huguya le áluahabalin,</para>
  <para style="q" vid="PSA 22:26">winwan humá luagu saragu irumu.<verse eid="PSA 22:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 22:27" />Sun hawuyerigu gürigia hama sun néchanigu,</para>
  <para style="q" vid="PSA 22:27">sun gürigia ha lídangiñetiña sun larigeirugu ubóu;</para>
  <para style="q" vid="PSA 22:27">haritagua humá luagu Aburemei, ñübuin humá lun;</para>
  <para style="q" vid="PSA 22:27">hudugua huguyame ligibugiñe!<verse eid="PSA 22:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 22:28" />Ladüga Aburemei urúeibei,</para>
  <para style="q" vid="PSA 22:28">ligía agumadirubaliña néchanigu.<verse eid="PSA 22:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 22:29" />Bulugua humá, lúnrügüla háhuduragua,</para>
  <para style="q" vid="PSA 22:29">sun ha rísibaña abagaridun,</para>
  <para style="q" vid="PSA 22:29">sun ha lúnbaña hagiribudun lidoun kaliki,</para>
  <para style="q" vid="PSA 22:29">ladüga mabagaritiña houngua.<verse eid="PSA 22:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="PSA 22:30" />Háhuduraguba sun nadügawagun lun Aburemei,</para>
  <para style="q" vid="PSA 22:30">hadimurehaba luagu lidan sun habagari;<verse eid="PSA 22:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 22:31" />hadimurehaba houn ha águrahoutiña hárigiñe</para>
  <para style="q" vid="PSA 22:31">luagu lúaragun luma luagu burí katei le ladügübei.<verse eid="PSA 22:31" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" sid="PSA 23" />
  <para style="s1">Aburemei núniribei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 23:1" />Nabureme óunigirubalina,</para>
  <para style="q" vid="PSA 23:1">kei lóunigiruniña amainiruti mudún mudún,</para>
  <para style="q" vid="PSA 23:1">ligía ua lubéi nemegeirun.<verse eid="PSA 23:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 23:2" />Emeraaguagüda lumutina lidan sagadi le hilumati,</para>
  <para style="q" vid="PSA 23:2">barǘ lumutina larun burí duna le darangilati,<verse eid="PSA 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 23:3" />ruti iseri erei nun,</para>
  <para style="q" vid="PSA 23:3">adundeha lumutina luéigiñe üma le richabei,</para>
  <para style="q" vid="PSA 23:3">ítara kei füramase lani.<verse eid="PSA 23:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 23:4" />Íbini násügürün lídangiñe fulasu</para>
  <para style="q" vid="PSA 23:4">le búrigatimabei le lánina óunweni,</para>
  <para style="q" vid="PSA 23:4">manufudebadina ni ka uéi,</para>
  <para style="q" vid="PSA 23:4">ladüga buguya, Nabureme, númañadibu;</para>
  <para style="q" vid="PSA 23:4">góunigi bumutina lau buewen luma bubadun.<verse eid="PSA 23:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 23:5" />Aransedibu dábula lau éigini nubá hagibugiñe náganiñu;</para>
  <para style="q" vid="PSA 23:5">séhadibu ibiñein nábulugun lun bíchugun inebesei nun.</para>
  <para style="q" vid="PSA 23:5">Buíngüda baali nikopun darí lun látuhan.<verse eid="PSA 23:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 23:6" />Falá lumutina bareini luma bínsiñehabu</para>
  <para style="q" vid="PSA 23:6">lidan sun nabagaridun,</para>
  <para style="q" vid="PSA 23:6">ani naganóuba tidan buban Nabureme lun súnwandan.<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" sid="PSA 24" />
  <para style="s1">Lurúeite uéiriguni</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 24:1" />Lani Aburemei sun ubóu,</para>
  <para style="q" vid="PSA 24:1">lau sun le lídanbei,</para>
  <para style="q" vid="PSA 24:1">lau sun le wínwanbei lidan.<verse eid="PSA 24:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 24:2" />Ladüga Aburemei lan íchugubalin lebu ubóu,</para>
  <para style="q" vid="PSA 24:2">aba lederebudagüdüni ligibuagu barana luma duna.<verse eid="PSA 24:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 24:3" />Ka gayaraabei lamudeirun luagun luwübüri Aburemei?</para>
  <para style="q" vid="PSA 24:3">Ka gayaraabei lerederun tidan luban to sánduboun?<verse eid="PSA 24:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 24:4" />Lamudeiruba le úabei figóu lidan libagari,</para>
  <para style="q" vid="PSA 24:4">ni lidan lisaminan;</para>
  <para style="q" vid="PSA 24:4">le máhuduragunbei houn guáriua,</para>
  <para style="q" vid="PSA 24:4">máfiñurun ligía lau marasualugu.<verse eid="PSA 24:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 24:5" />Aburemei le Lubungiute gürigia ligía,</para>
  <para style="q" vid="PSA 24:5">labinirubei, ru ligíame irichaü lun.<verse eid="PSA 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 24:6" />Lunti ítara hamá ha áluahabalin Aburemei,</para>
  <para style="q" vid="PSA 24:6">ha áluahabaña lun liñúarü hamá Lubungiute Hakobu.<verse eid="PSA 24:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 24:7" />Daragualá burí bena!</para>
  <para style="q" vid="PSA 24:7">Rédeila burí hunreñu sunsuinagubei,</para>
  <para style="q" vid="PSA 24:7">belu láamuga lurúeite uéiriguni!<verse eid="PSA 24:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 24:8" />Katei san lurúeite uéiriguni le?</para>
  <para style="q" vid="PSA 24:8">Aburemei, le Hérebei, le Manufudebei!</para>
  <para style="q" vid="PSA 24:8">Aburemei le manufudebei lidan wuribu!<verse eid="PSA 24:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 24:9" />Daragualá burí bena!</para>
  <para style="q" vid="PSA 24:9">Rédeila burí hunreñu sunsuinagubei,</para>
  <para style="q" vid="PSA 24:9">belu láamuga lurúeite uéiriguni!<verse eid="PSA 24:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 24:10" />Katei san lurúeite uéiriguni le?</para>
  <para style="q" vid="PSA 24:10">Aburemei, le Súntibeigabafu</para>
  <para style="q" vid="PSA 24:10">ligía lurúeitebei uéiriguni.<verse eid="PSA 24:10" /></para>
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" sid="PSA 25" />
  <para style="s1">Afurieiduni amuriahei ladundehan Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 25:1" />Nabureme, buntia niñuroun nuani;<verse eid="PSA 25:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 25:2" />Nubungiute, buagu nafiñera;</para>
  <para style="q" vid="PSA 25:2">mígiraba lun néiguadun lidoun busiganu.</para>
  <para style="q" vid="PSA 25:2">Lun méherahan hamá náganiñu nau!<verse eid="PSA 25:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 25:3" />Manügalá ni aban hádangiñe ha afiñebaña buagu busiganu!</para>
  <para style="q" vid="PSA 25:3">Barǘ hamá busiganu ha agarabaagubaña buagun.<verse eid="PSA 25:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 25:4" />Nabureme,</para>
  <para style="q" vid="PSA 25:4">arufudabéi bémeri nun,</para>
  <para style="q" vid="PSA 25:4">barübana luéigiñe bǘmate;<verse eid="PSA 25:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 25:5" />adundehabana, íchaahabana lidan binarün,</para>
  <para style="q" vid="PSA 25:5">ladüga buguya Nubungiutebei, Nesefuragüle.</para>
  <para style="q" vid="PSA 25:5">Buagu nemenigida súnwandan!<verse eid="PSA 25:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 25:6" />Nabureme,</para>
  <para style="q" vid="PSA 25:6">haritaguabá luagu ínsiñehabuni luma gudemehabu</para>
  <para style="q" vid="PSA 25:6">le arufuda báalibei woun súnwandan<verse eid="PSA 25:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 25:7" />gama lumoun maritaguabá luagu nifigoun,</para>
  <para style="q" vid="PSA 25:7">ni luagu wuribati le meha nadügübei dan meha nibureingidina.</para>
  <para style="q" vid="PSA 25:7">Haritaguabá nuagun, Bungiu,</para>
  <para style="q" vid="PSA 25:7">luagu lueirin bínsiñehabu luma bareini.<verse eid="PSA 25:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 25:8" />Buidu liña Aburemei, richá ligia;</para>
  <para style="q" vid="PSA 25:8">Arufudahati houn gafigountiña luagu lémeri,<verse eid="PSA 25:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 25:9" />adundeha laña ha ǘnabubei hanaagun houngua lidan lémeri;</para>
  <para style="q" vid="PSA 25:9">arufudahati houn lidan irichaü!<verse eid="PSA 25:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 25:10" />Sun lémeri, lánina ínsiñehabuni luma inarüni</para>
  <para style="q" vid="PSA 25:10">houn ha agunfulirubalin lidaradun luma lugumadin.<verse eid="PSA 25:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 25:11" />Aburemei, wéiriti nuriban;</para>
  <para style="q" vid="PSA 25:11">ferudunabana luagu línsiñehabu biri.<verse eid="PSA 25:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 25:12" />Gürigia ha hínsiñehabubaña lun Aburemei,</para>
  <para style="q" vid="PSA 25:12">arufuda lumuti Aburemei üma le lunbei hafalaruni houn;<verse eid="PSA 25:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 25:13" />awansegüda lumutiña lidan habagari</para>
  <para style="q" vid="PSA 25:13">ru ligía fulasu houn hadügawagun.<verse eid="PSA 25:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 25:14" />Lumadagu Aburemei ha inebehabubaña lun,</para>
  <para style="q" vid="PSA 25:14">subudigüda lumuti giñe lidaradun houn.<verse eid="PSA 25:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 25:15" />Súnwandan níchuguni narihin luagun Nabureme,</para>
  <para style="q" vid="PSA 25:15">ladüga sefu lumutina luéi sun denchaü.<verse eid="PSA 25:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 25:16" />Arihabána, Nabureme, gudemená bun,</para>
  <para style="q" vid="PSA 25:16">ladüga nábuguarügüñadina ani nidiheritina.<verse eid="PSA 25:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 25:17" />Eibu dan, éibutima nidiheri tan nanigi;</para>
  <para style="q" vid="PSA 25:17">sefubána lídangiñe áhüchürüni.<verse eid="PSA 25:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 25:18" />Arihabéi nirun luma burí nasufurirun,</para>
  <para style="q" vid="PSA 25:18">ferudunabéi nifigoun.<verse eid="PSA 25:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 25:19" />Arihabá hiibe náganiñu</para>
  <para style="q" vid="PSA 25:19">ha asandirubaña iyereehabúni lánina óunweni nuagu.<verse eid="PSA 25:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 25:20" />Góunigi bana, sefubéi nibagari!</para>
  <para style="q" vid="PSA 25:20">Mígiraba lun néiguadun lidoun busiganu,</para>
  <para style="q" vid="PSA 25:20">ladüga buma náluaha nóunigiruniwa!<verse eid="PSA 25:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 25:21" />Góunigilana naruman luma madurun nan,</para>
  <para style="q" vid="PSA 25:21">ladüga ru naali nafiñen buagu.<verse eid="PSA 25:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 25:22" />Nubungiute,</para>
  <para style="q" vid="PSA 25:22">Sefubéi Ísüraeli lídangiñe idiheri.<verse eid="PSA 25:22" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" sid="PSA 26" />
  <para style="s1">Achoururuni luagu aban ibagari harumati</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 26:1" />Nabureme ruba irichaü nun,</para>
  <para style="q" vid="PSA 26:1">ladüga harumati nibagari.</para>
  <para style="q" vid="PSA 26:1">Buagu nafiñera le gumuti;<verse eid="PSA 26:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 26:2" />arihabéi ida niña lan,</para>
  <para style="q" vid="PSA 26:2">hóuchaguabana! Hóuchaguabei nisaminan</para>
  <para style="q" vid="PSA 26:2">luma lilulin-agei le nasandirubei tidan nanigi!<verse eid="PSA 26:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 26:3" />Anihein bínsiñehabu nigibugiñe,</para>
  <para style="q" vid="PSA 26:3">ani gúnfulitina buma;<verse eid="PSA 26:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 26:4" />Maganóuntina lidan aban hama yéetiña,</para>
  <para style="q" vid="PSA 26:4">móundaragun nuguya hama biangua tigibu.<verse eid="PSA 26:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 26:5" />Iyereeguti hadamuridagun salufuritiña nun;</para>
  <para style="q" vid="PSA 26:5">meredegidina aganóua lidan aban hama wuribatiña!<verse eid="PSA 26:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 26:6" />Busentina nayarafadun lun bani latarü</para>
  <para style="q" vid="PSA 26:6">harumañu núhabu lídangiñe figóu,<verse eid="PSA 26:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 26:7" />wa nuguyame uremu bun,</para>
  <para style="q" vid="PSA 26:7">adimureha nuguyame luagu buéirigun.<verse eid="PSA 26:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 26:8" />Aburemei hínsiñetu buban to ñein lubéi baganawa nun,</para>
  <para style="q" vid="PSA 26:8">fulasu le ñein lubéi buéirigun.<verse eid="PSA 26:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 26:9" />Magidarabéi nibagari nuéi úara hama gafigountiña;</para>
  <para style="q" vid="PSA 26:9">sefubána luéi abeichúni le heresibirubei gáfarahaditiña,<verse eid="PSA 26:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 26:10" />hádangiñe ha buínlubaña úhabu lau wuribani</para>
  <para style="q" vid="PSA 26:10">ani ragǘ hagía seinsu lun magunfuliruniwa lan lau le richabei.<verse eid="PSA 26:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 26:11" />Anhein nibagari, harumati;</para>
  <para style="q" vid="PSA 26:11">sefubána, gudemená bun!<verse eid="PSA 26:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 26:12" />Lara niña lidan fulasu derebuguti;</para>
  <para style="q" vid="PSA 26:12">nalawahabei Aburemei hañúarü lumutuniña!<verse eid="PSA 26:12" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" sid="PSA 27" />
  <para style="s1">Aburemei Nilanpunbei luma Nesefuragüle</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 27:1" />Nabureme Bungiu, nilanpunbei</para>
  <para style="q" vid="PSA 27:1">ligía giñe nesefuragülebei,</para>
  <para style="q" vid="PSA 27:1">kábagia uei nanufudeda?</para>
  <para style="q" vid="PSA 27:1">Sefu lumuti Aburemei nibagari,</para>
  <para style="q" vid="PSA 27:1">kaba uei nanufudeda?<verse eid="PSA 27:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 27:2" />Óundaraguatiña, náganiñu, wuribatiña,</para>
  <para style="q" vid="PSA 27:2">lun hagayuahan nuagun luma lun hagünrinchagunina,</para>
  <para style="q" vid="PSA 27:2">gama lumoun hagía achugeragubaña aba héiguadun.<verse eid="PSA 27:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 27:3" />Íbini hegeyedagun saragu súdara nau,</para>
  <para style="q" vid="PSA 27:3">manufudedunboun nanigi,</para>
  <para style="q" vid="PSA 27:3">íbini haranserun lun hawuribuhan numa, darangilañunuba.<verse eid="PSA 27:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 27:4" />Ábanrügüñein katei namuriahan luma Nabureme,</para>
  <para style="q" vid="PSA 27:4">ábanrügüñein katei nabusenrun:</para>
  <para style="q" vid="PSA 27:4">Lun tidan nan luban Nabureme lidan sun nibagari</para>
  <para style="q" vid="PSA 27:4">lun náhuduragun lun lúbiñe,</para>
  <para style="q" vid="PSA 27:4">aríaguaneime lanarime lubuidure.<verse eid="PSA 27:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 27:5" />Danme liabin dan le wuribabei,</para>
  <para style="q" vid="PSA 27:5">ladouraguba Nabureme nau;</para>
  <para style="q" vid="PSA 27:5">ladouraguba nau tidan litenpulun</para>
  <para style="q" vid="PSA 27:5">lesefurubadina ligibuagu aban dübü!<verse eid="PSA 27:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 27:6" />Ítara luba gayara lan niñuraguni nichügü hóugiñe náganiñu;</para>
  <para style="q" vid="PSA 27:6">ítara luba gayara lan nadagaragüdün lúbiñe,</para>
  <para style="q" vid="PSA 27:6">eremuha aume lun Nabureme lau agúarahani le lánina ugundani.<verse eid="PSA 27:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 27:7" />Nabureme, buma namuriaha: Aganbabána.</para>
  <para style="q" vid="PSA 27:7">Gudemená bun, óunababana!<verse eid="PSA 27:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 27:8" />Tariñahare nanigi nun:</para>
  <para style="q" vid="PSA 27:8">«Áluahabei liñúarü Aburemei»</para>
  <para style="q" vid="PSA 27:8">náluahañadibu lubeiti Nabureme.<verse eid="PSA 27:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 27:9" />Maramudaguabá nuéi!</para>
  <para style="q" vid="PSA 27:9">Mabugunbáname lau bigañi!</para>
  <para style="q" vid="PSA 27:9">Buguyarügüñein íderaguana!</para>
  <para style="q" vid="PSA 27:9">Mígirabana nábugua,</para>
  <para style="q" vid="PSA 27:9">buguya Nubungiutebei luma Nesefuragüle.<verse eid="PSA 27:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 27:10" />Íbini yebe lágurunina núguchi tuma núguchu,</para>
  <para style="q" vid="PSA 27:10">lau sun lira labudubadina Nabureme.<verse eid="PSA 27:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 27:11" />Nabureme arufudabéi bémeri nun,</para>
  <para style="q" vid="PSA 27:11">alidihabana lidoun üma le surubei hawéi náganiñu;<verse eid="PSA 27:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 27:12" />mederegerabana háhaburugun náganiñu,</para>
  <para style="q" vid="PSA 27:12">ladüga iñuraguaaña gefentiña marasualugutiña</para>
  <para style="q" vid="PSA 27:12">ani hanarimetiña nuagun.<verse eid="PSA 27:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 27:13" />Gama lumoun chóuruguatina nungua</para>
  <para style="q" vid="PSA 27:13">luagu lachülürüba lan dan lun narihini lugundan Nabureme</para>
  <para style="q" vid="PSA 27:13">lidan limigifen ibagari le.<verse eid="PSA 27:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 27:14" />Afiñebá luagu Aburemei!</para>
  <para style="q" vid="PSA 27:14">Ganigibá, mábürühala barüna!</para>
  <para style="q" vid="PSA 27:14">Afiñebá luagu Aburemei!<verse eid="PSA 27:14" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" sid="PSA 28" />
  <para style="s1">Aganba lumuti Aburemei wayumuragun</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 28:1" />Nabureme, le óunigirubalina, bun nagúara,</para>
  <para style="q" vid="PSA 28:1">mamaharabá lun bóunabunina!</para>
  <para style="q" vid="PSA 28:1">Ladüga ánhabu amahara bóunabunina,</para>
  <para style="q" vid="PSA 28:1">gayaraahali níchaagun nungua</para>
  <para style="q" vid="PSA 28:1">kei aban hádangiñe ha hilaañabaña.<verse eid="PSA 28:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 28:2" />Aganbabéi nagúarahan amuriahei bídehan,</para>
  <para style="q" vid="PSA 28:2">dan le narufuduni núhabu tuagun buban to sánduboun.<verse eid="PSA 28:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 28:3" />Madurugudabana úara hama salufuritiña,</para>
  <para style="q" vid="PSA 28:3">mabahüdabana hadan wuribatiña</para>
  <para style="q" vid="PSA 28:3">ha gamadounbaña bóugudigiñe habiti</para>
  <para style="q" vid="PSA 28:3">anhein múnadagiñe habiti wuribani hagía.<verse eid="PSA 28:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 28:4" />Rubei le hadünabei houn</para>
  <para style="q" vid="PSA 28:4">le lafayeiruaha luriban hóuserun;</para>
  <para style="q" vid="PSA 28:4">fáyeibaña lau guánarügü wuribati le hadügübei.<verse eid="PSA 28:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 28:5" />Kei meberesenhaaña lubéi</para>
  <para style="q" vid="PSA 28:5">lau burí katei le ladügübei Aburemei;</para>
  <para style="q" vid="PSA 28:5">günringualaña Aburemei,</para>
  <para style="q" vid="PSA 28:5">lun másaaragüdündigia lániña!<verse eid="PSA 28:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 28:6" />Alawahoualá Aburemei,</para>
  <para style="q" vid="PSA 28:6">le aganbubalin nayumuragun!<verse eid="PSA 28:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 28:7" />Nabureme nérebei, le óunigirubalina;</para>
  <para style="q" vid="PSA 28:7">luagu temenigida nanigi ani íderagua lumutina.</para>
  <para style="q" vid="PSA 28:7">Gúndaatu lubeiti nanigi;</para>
  <para style="q" vid="PSA 28:7">neremuhaba, ru aume seremei lun Nabureme.<verse eid="PSA 28:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 28:8" />Aburemei éreibei houn lumutuniña;</para>
  <para style="q" vid="PSA 28:8">ligía ídemueibei ani aramudaguagülei</para>
  <para style="q" vid="PSA 28:8">lun urúei le lanúadirubei.<verse eid="PSA 28:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 28:9" />Sefubáña bánigu Nabureme,</para>
  <para style="q" vid="PSA 28:9">binibaña ha bánigubaña.</para>
  <para style="q" vid="PSA 28:9">Góunigibaña kei aban hóuniri mudún;</para>
  <para style="q" vid="PSA 28:9">barübaña barünarugu lun súnwandan!<verse eid="PSA 28:9" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" sid="PSA 29" />
  <para style="s1">Lubafu lumalali Aburemei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 29:1" />Ru humá uéiriguni lun Aburemei,</para>
  <para style="q" vid="PSA 29:1">huguya lirahüñü ha siélubaña;</para>
  <para style="q" vid="PSA 29:1">alawaha huméi lubafu luma luéirigun Aburemei;<verse eid="PSA 29:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 29:2" />halawahei luéirigun liri Aburemei;</para>
  <para style="q" vid="PSA 29:2">hudugua humá lun Aburemei tidan lisanduariun.<verse eid="PSA 29:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 29:3" />Aganbúati lumalali Aburemei ligibuagu barana;</para>
  <para style="q" vid="PSA 29:3">dürürügüdati Bungiu le wéirigubei wayuhuru:</para>
  <para style="q" vid="PSA 29:3">Anihein Aburemei lóugiñe lueirin barana!<verse eid="PSA 29:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 29:4" />Dürügüdati lumalali Aburemei lau erei,</para>
  <para style="q" vid="PSA 29:4">aganbúati lumalali Aburemei lau ubafu;<verse eid="PSA 29:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 29:5" />Halaguati lumalali Aburemei tídibu wewe.</para>
  <para style="q" vid="PSA 29:5">Guchagua lumuti Aburemei tídibu hibúari le Líwanuna!<verse eid="PSA 29:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 29:6" />Adadagaragüda lumuti burí áraabu le Líwanu luma Sirión;</para>
  <para style="q" vid="PSA 29:6">achubaagüda lumuti kei bágasu!<verse eid="PSA 29:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 29:7" />Achüühati lumalali Aburemei watu gemeti;<verse eid="PSA 29:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 29:8" />adadagaragüda lumuti lumalali Aburemei fulasu mageirawati,</para>
  <para style="q" vid="PSA 29:8">adadagaragüda lumuti Aburemei fulasu mageirawati le lani Kádesi.<verse eid="PSA 29:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 29:9" />Hingí lumutu lumalali Aburemei tídibu wewe wéinamutu</para>
  <para style="q" vid="PSA 29:9">hulagualóun burí to dabiararuguboun;</para>
  <para style="q" vid="PSA 29:9">rútiña súngubei uéiriguni lun lúbiñe.<verse eid="PSA 29:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 29:10" />Gumadi lumuti Aburemei huya;</para>
  <para style="q" vid="PSA 29:10">agumadihati Aburemei keisi urúei lánina sun dan!<verse eid="PSA 29:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 29:11" />Ruti Aburemei erei houn lánigu;</para>
  <para style="q" vid="PSA 29:11">biní lumutiña Aburemei lumutuniña lau darangilaü.<verse eid="PSA 29:11" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" sid="PSA 30" />
  <para style="s1">Alawahani le lánina eteingiruni lun Aburemei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 30:1" />Nabureme alawaha numutibu,</para>
  <para style="q" vid="PSA 30:1">ladüga sefu bumutina,</para>
  <para style="q" vid="PSA 30:1">lugundun mígiruntibu lun héherahan náganiñu nau.<verse eid="PSA 30:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 30:2" />Nabureme, Nubungiute,</para>
  <para style="q" vid="PSA 30:2">amuriahatina buma lun bíderagunina,</para>
  <para style="q" vid="PSA 30:2">aba bareidaguagüdünina;<verse eid="PSA 30:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 30:3" />sefu bumutina lídangiñe óunweni;</para>
  <para style="q" vid="PSA 30:3">rútibu ibagari nun,</para>
  <para style="q" vid="PSA 30:3">sefu bumutina luéi nounwen.<verse eid="PSA 30:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 30:4" />Huguya le gúnfulibei luma Aburemei,</para>
  <para style="q" vid="PSA 30:4">wa humá uremu lun!</para>
  <para style="q" vid="PSA 30:4">Heremuha lun liri le sándubei!<verse eid="PSA 30:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 30:5" />Ladüga murusunrügüñein dan lau lidan ligañi,</para>
  <para style="q" vid="PSA 30:5">ánheinti lareini durati lun súnwandan.</para>
  <para style="q" vid="PSA 30:5">Ánhawa ayahua guñoun,</para>
  <para style="q" vid="PSA 30:5">gúndaabadiwa larugan binaafin.<verse eid="PSA 30:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 30:6" />Chóuruguati nasandiragun nungua</para>
  <para style="q" vid="PSA 30:6">aba nariñagun núnguarügü:</para>
  <para style="q" vid="PSA 30:6">«Úabei ni kata ábürügüdütina».<verse eid="PSA 30:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 30:7" />Nabureme, derebugugüda bumutina</para>
  <para style="q" vid="PSA 30:7">lidan fulasu chóuruti lau bareini.</para>
  <para style="q" vid="PSA 30:7">Gama lumoun lidan bumahan bíderagunina,</para>
  <para style="q" vid="PSA 30:7">aba labulieidaguagüdünina anufudei.<verse eid="PSA 30:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 30:8" />Bun nagúaraha Nabureme,</para>
  <para style="q" vid="PSA 30:8">bun giñe nebegira:<verse eid="PSA 30:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 30:9" />Nabureme ka san agañeirunibei lau nounwen,</para>
  <para style="q" vid="PSA 30:9">lau nanügǘn abunúa?</para>
  <para style="q" vid="PSA 30:9">Malawahan lubadibu le hilaalibei;</para>
  <para style="q" vid="PSA 30:9">madimurehan ligíame luagu búaragun.<verse eid="PSA 30:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 30:10" />Nabureme, aganbabána,</para>
  <para style="q" vid="PSA 30:10">gudemená bun; Nabureme,</para>
  <para style="q" vid="PSA 30:10">íderaguabana!<verse eid="PSA 30:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 30:11" />Sansi baali nayahun lun abinahanime,</para>
  <para style="q" vid="PSA 30:11">gidaba niludun nuéi,</para>
  <para style="q" vid="PSA 30:11">dáüguagüda báadina daüguaü to lánina fedu.<verse eid="PSA 30:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 30:12" />Ligía siñá lubéi nerederun maniñu Nubungiute,</para>
  <para style="q" vid="PSA 30:12">náwaruba uremu bun, neteingirubadibu súnwandan!<verse eid="PSA 30:12" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" sid="PSA 31" />
  <para style="s1">Emenigini le gumuti luagu Aburemei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 31:1" />Nabureme, bóubawagu náluaha naramudagun,</para>
  <para style="q" vid="PSA 31:1">mígirabana wuriba!</para>
  <para style="q" vid="PSA 31:1">Sefubána ladüga surutibu!<verse eid="PSA 31:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 31:2" />Ruba arigei lun nebegirun;</para>
  <para style="q" vid="PSA 31:2">furesebá besefuraname guentó!</para>
  <para style="q" vid="PSA 31:2">Buguyalá dübü le naramudaguagüle,</para>
  <para style="q" vid="PSA 31:2">abanbá aramudaguagülei nun,</para>
  <para style="q" vid="PSA 31:2">le ñein lumuti chouru nan lun nesefurun.<verse eid="PSA 31:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 31:3" />Buguya dǘbübei le naramudaguagüle.</para>
  <para style="b" vid="PSA 31:3" />
  <para style="q" vid="PSA 31:3">Alidihabana góunigibaname;</para>
  <para style="q" vid="PSA 31:3">ruba inebesei lun biri.<verse eid="PSA 31:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 31:4" />Sagabana tídangiñe sádara to esetirúboun nubá!</para>
  <para style="q" vid="PSA 31:4">Buguya óunigirubalina;<verse eid="PSA 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 31:5" />derege numutu nuani búhaburugu;</para>
  <para style="q" vid="PSA 31:5">sefubána Nabureme, Lubungiute inarüni!<verse eid="PSA 31:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 31:6" />Iyereegutiña ha áhuduragubaña</para>
  <para style="q" vid="PSA 31:6">houn guáriua meseriwíntiña nun;</para>
  <para style="q" vid="PSA 31:6">ru naali nemenigin luagu Nabureme.<verse eid="PSA 31:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 31:7" />Barüti bínsiñehabu ugundani nun.</para>
  <para style="q" vid="PSA 31:7">Ariha baali nirun, subudi bumuti nidiheri.<verse eid="PSA 31:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 31:8" />Mederegerun bumutina lúhaburugun nágani;</para>
  <para style="q" vid="PSA 31:8">láramagüda bumutina lidan aban fulasu le chóuruti.<verse eid="PSA 31:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 31:9" />Nabureme gudemená bun,</para>
  <para style="q" vid="PSA 31:9">ladüga lídanñadina denchaü;</para>
  <para style="q" vid="PSA 31:9">edebilideina liña nagu ladüga igari,</para>
  <para style="q" vid="PSA 31:9">emeredeina liña giñe sun núgubu.<verse eid="PSA 31:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 31:10" />Lagumuchuña igarigu luma ayahuni lau nibagari!</para>
  <para style="q" vid="PSA 31:10">Lagumuchuña íruni lau nere;</para>
  <para style="q" vid="PSA 31:10">emeredeina liña núgubu!<verse eid="PSA 31:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 31:11" />Au héheraagülebei náganiñu,</para>
  <para style="q" vid="PSA 31:11">lébuna habulan nubesinanigu,</para>
  <para style="q" vid="PSA 31:11">katei mínsiñeguti au houn ha subudihabúbaña nun.</para>
  <para style="q" vid="PSA 31:11">Ha arihitina ǘmadarugu, anurahatiña nuéi!<verse eid="PSA 31:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 31:12" />Bulíei hamaadina sunsuinagubei,</para>
  <para style="q" vid="PSA 31:12">kamá le hamuga hilaadina,</para>
  <para style="q" vid="PSA 31:12">bulíei hamaadina kei aban fudu le amurusuhóuaali.<verse eid="PSA 31:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 31:13" />Aganba numuti hagülülühan gürigia:</para>
  <para style="q" vid="PSA 31:13">«Anihein lanarime anufudei lidan sun oubaü».</para>
  <para style="q" vid="PSA 31:13">Eledeguatiña nubá kei ábanrügü gürigia,</para>
  <para style="q" vid="PSA 31:13">aransehatiña lun háfarunina hilagubei.<verse eid="PSA 31:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 31:14" />Gama lumoun au Nabureme, buagu nemenigida,</para>
  <para style="q" vid="PSA 31:14">ariñagaadina: «Buguya Nubungiutebei!»<verse eid="PSA 31:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 31:15" />Búhaburuguñein nibagari;</para>
  <para style="q" vid="PSA 31:15">sefubána hawéi náganiñu ha éibaahabalina!<verse eid="PSA 31:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 31:16" />Arihabá nuagun lau bareini, au le bubuein,</para>
  <para style="q" vid="PSA 31:16">sefubána lau bínsiñehabu.<verse eid="PSA 31:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 31:17" />Bun nagúara, Nabureme;</para>
  <para style="q" vid="PSA 31:17">madügabá lun néiguadun lidoun busiganu!</para>
  <para style="q" vid="PSA 31:17">Héiguagüdabaña ha salufuribaña lidoun busiganu,</para>
  <para style="q" vid="PSA 31:17">héiguagüdabaña lidoun límaniga le lídanbei umúahaü!<verse eid="PSA 31:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 31:18" />Rédeila iyumaaru burí le yeebei maniñu,</para>
  <para style="q" vid="PSA 31:18">le burí adimurehabei lau bula</para>
  <para style="q" vid="PSA 31:18">luma lau luriban dimurei hawagu amu,</para>
  <para style="q" vid="PSA 31:18">ani anabagualaña gürigia ha harumabaña.<verse eid="PSA 31:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 31:19" />Ma lueirin bareini houn ha íchugubaña uéiriguni bun!</para>
  <para style="q" vid="PSA 31:19">Areida bumutiña kei aban katei gebegiti saragu,</para>
  <para style="q" vid="PSA 31:19">afanreinhabei areini ligía,</para>
  <para style="q" vid="PSA 31:19">hagibugiñe gürigia ha hemenigibaña buagu.<verse eid="PSA 31:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 31:20" />Salba bumutiña hawéi gürigia wuribatiña</para>
  <para style="q" vid="PSA 31:20">lau bareiduniña biñuarü;</para>
  <para style="q" vid="PSA 31:20">daruguatibu hau lábugiñe bamuñadagüle</para>
  <para style="q" vid="PSA 31:20">luéi hanabaguniña háganiñu.<verse eid="PSA 31:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 31:21" />Alawahoualá Aburemei le adügübei burí katei wéinamuti</para>
  <para style="q" vid="PSA 31:21">nuagu lidan nidiheri.<verse eid="PSA 31:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 31:22" />Lidan luriban nadariragun nungua,</para>
  <para style="q" vid="PSA 31:22">haritaguatina yebe luagu fuíbaadina lan,</para>
  <para style="q" vid="PSA 31:22">gama lumoun dan le namuriahanbei buma lun bíderagunina,</para>
  <para style="q" vid="PSA 31:22">aganba bumuti nagúaragun.<verse eid="PSA 31:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 31:23" />Hínsiñela Aburemei houn sun ha gúnfulibaña luma,</para>
  <para style="q" vid="PSA 31:23">góunigi lumutiña ha furangubaña,</para>
  <para style="q" vid="PSA 31:23">ánhaña ha íñubei hanaagun houngua</para>
  <para style="q" vid="PSA 31:23">ru lumuti hafayeiruaha houn luagu sun le hadünabei.<verse eid="PSA 31:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 31:24" />Sun huguya ha hemenigibaña luagu Aburemei</para>
  <para style="q" vid="PSA 31:24">here humá gaguraasun huguyame.<verse eid="PSA 31:24" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" sid="PSA 32" />
  <para style="s1">Gufesei luma ferudun</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 32:1" />Fuleseiwatiña gürigia</para>
  <para style="q" vid="PSA 32:1">ha ferudunawaalibei hadurun luma hafigoun.<verse eid="PSA 32:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 32:2" />Fuleseiwatiña gürigia ha buídubaña isaminan,</para>
  <para style="q" vid="PSA 32:2">ha giñe madurunhañabaña ligibugiñe Aburemei luagu ni kata.<verse eid="PSA 32:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 32:3" />Sun meha dan le naubei magufeserunga nifigoun,</para>
  <para style="q" vid="PSA 32:3">aba meha nayahuahan sagü weyu.<verse eid="PSA 32:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 32:4" />Bei bumutina meha áriebu wéyuagu,</para>
  <para style="q" vid="PSA 32:4">ábati agumuchagueina lan nere</para>
  <para style="q" vid="PSA 32:4">kei lamabeidun serenu lau lara weyu.<verse eid="PSA 32:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 32:5" />Gama lumoun aba nagufeseruni nifigoun luma sun nuriban,</para>
  <para style="q" vid="PSA 32:5">maramudunga ni kata;</para>
  <para style="q" vid="PSA 32:5">aba naranserun lun nagufeseruni nifigoun burí bun,</para>
  <para style="q" vid="PSA 32:5">buguyati, Nabureme, aba ferudunabánina.<verse eid="PSA 32:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 32:6" />Ligía háwaruba lubéi gúnfulitiña buagu lidan idiheri,</para>
  <para style="q" vid="PSA 32:6">ani íbini burí labouchagun liyuma duna lau lere,</para>
  <para style="q" vid="PSA 32:6">machülübei hawagun.<verse eid="PSA 32:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 32:7" />Buguya naramudaguagülebei;</para>
  <para style="q" vid="PSA 32:7">areida bumutina luéi wuribani,</para>
  <para style="q" vid="PSA 32:7">efeduha numuti besefuhan lau uremu,</para>
  <para style="q" vid="PSA 32:7">ladüga góunigi bumutina.<verse eid="PSA 32:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 32:8" />Lariñahare Aburemei:</para>
  <para style="q" vid="PSA 32:8">«Buágunñein narihin.</para>
  <para style="q" vid="PSA 32:8">Narufudahaba bun;</para>
  <para style="q" vid="PSA 32:8">níchuguba dimurei buíduti bun;</para>
  <para style="q" vid="PSA 32:8">narufudubei üma le lunbei bafalaruni bun.<verse eid="PSA 32:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 32:9" />Mítaranba kei gabayu ni kei mile,</para>
  <para style="q" vid="PSA 32:9">ha siñabei gunfuranda hamá,</para>
  <para style="q" vid="PSA 32:9">ha gásubei hararamúniwa lau furenu luma agürügaü;</para>
  <para style="q" vid="PSA 32:9">ladüga mayarafadunbaña bun lau amu luwuyeri».<verse eid="PSA 32:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 32:10" />Hasandiruba wuribatiña saragu burí gáriti,</para>
  <para style="q" vid="PSA 32:10">gama lumoun ha hemenigibaña luagun Aburemei hóuburagua lumutiña línsiñehabu.<verse eid="PSA 32:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 32:11" />Gunda humá lidan Aburemei,</para>
  <para style="q" vid="PSA 32:11">gürigia buítiña ha buídubaña aritagun</para>
  <para style="q" vid="PSA 32:11">gunda humá, hagúaraha lau ugundani!<verse eid="PSA 32:11" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" sid="PSA 33" />
  <para style="s1">Lalawahóuniwa luma leteingiruniwa Aburemei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 33:1" />Gunda humá luagu le adüga láalibei Aburemei</para>
  <para style="q" vid="PSA 33:1">huguya gürigia buítiña;</para>
  <para style="q" vid="PSA 33:1">wéndeti eremuhani le lídangiñeti iyumaü harumati.<verse eid="PSA 33:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 33:2" />Ru humá seremei lun Aburemei lau tamuri árüpa,</para>
  <para style="q" vid="PSA 33:2">wa humá uremu lun lau tamuri gidara.<verse eid="PSA 33:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 33:3" />Wa humá iseri uremu lun,</para>
  <para style="q" vid="PSA 33:3">háfara lun buidu buidu lau agúarahani lánina ugundani.<verse eid="PSA 33:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 33:4" />Inarüniti lererun Aburemei;</para>
  <para style="q" vid="PSA 33:4">lau katei le burí ladügübei</para>
  <para style="q" vid="PSA 33:4">arufuda lumuti luagu gúnfuli lan.<verse eid="PSA 33:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 33:5" />Hínsiñeti katei le richabei</para>
  <para style="q" vid="PSA 33:5">luma le úaraguabei lun Aburemei;</para>
  <para style="q" vid="PSA 33:5">buíngüda lumuti sun ubóu lau línsiñehabu!<verse eid="PSA 33:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 33:6" />Lau lererun Aburemei ladügǘwa sielu</para>
  <para style="q" vid="PSA 33:6">lau láfurun liyumulugugiñe ladügǘwa weyu hama waruguma.<verse eid="PSA 33:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 33:7" />Óundaraguagüda lumuti lidunarina lilulin-agei barana</para>
  <para style="q" vid="PSA 33:7">areidalei lidan aban.<verse eid="PSA 33:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 33:8" />Sun gürigia ubouagu ru hamá inebesei lun Aburemei;</para>
  <para style="q" vid="PSA 33:8">sun lílana ubóu ru hamá inebesei lun.<verse eid="PSA 33:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 33:9" />Ladüga adimurehati, aba lasaliragun sun katei;</para>
  <para style="q" vid="PSA 33:9">ru lumuti lererun, aba lederebugudun sun katei.<verse eid="PSA 33:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 33:10" />Günringua lumuti Aburemei</para>
  <para style="q" vid="PSA 33:10">sun le hasaminarubei gibe tubungiutegu hadügün,<verse eid="PSA 33:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 33:11" />ánheinti laransehan Aburemei,</para>
  <para style="q" vid="PSA 33:11">derebuguti súnwandan.<verse eid="PSA 33:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 33:12" />Fuleseiwatiña néchani ha Búngiubei Habungiute,</para>
  <para style="q" vid="PSA 33:12">gürigia ha anúadira láañabaña kei lánigu.<verse eid="PSA 33:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 33:13" />Arihati Aburemei lúmagiñe siélugiñe,</para>
  <para style="q" vid="PSA 33:13">aríaguliña houn sun gürigia;<verse eid="PSA 33:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 33:14" />ariha lumutiña lílana sun fulasu</para>
  <para style="q" vid="PSA 33:14">lídangiñe fulasu le ñein lubéi laganawa;<verse eid="PSA 33:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 33:15" />ligía adügübarun hanigi</para>
  <para style="q" vid="PSA 33:15">ligía giñe aríaahabalin sun le hadügübei.<verse eid="PSA 33:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 33:16" />Úati urúei esefuruti ladüga hiibe lisudaranigu,</para>
  <para style="q" vid="PSA 33:16">mesefuruntiña giñe ha ganigibaña ladüga lanarime here;<verse eid="PSA 33:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 33:17" />meseriwíntiña gabayu lun hesefurun ni aban;</para>
  <para style="q" vid="PSA 33:17">lau sun weiri lan here, siñati hesefuhan.<verse eid="PSA 33:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 33:18" />Ánheinti Aburemei</para>
  <para style="q" vid="PSA 33:18">góunigi lumutiña ha íchugubaña inebesei lun</para>
  <para style="q" vid="PSA 33:18">ani afiñe hagía luagu línsiñehabu súnwandan,<verse eid="PSA 33:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 33:19" />lun lesefuruniña lídangiñe óunweni,</para>
  <para style="q" vid="PSA 33:19">luma lun líchugun ibagari houn lidan lidaani ilamaü.<verse eid="PSA 33:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 33:20" />Wagía hemenigitiwa luagu Aburemei,</para>
  <para style="q" vid="PSA 33:20">íderagua lumutiwa, ani góunigilawa!<verse eid="PSA 33:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 33:21" />Gúndaatu wanigi lidan Aburemei;</para>
  <para style="q" vid="PSA 33:21">hemenigitiwa le gumuti luagu liri le sándubei.<verse eid="PSA 33:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 33:22" />Wamalá bínsiñehabu Aburemei,</para>
  <para style="q" vid="PSA 33:22">ítara kei wagurabuni búmagiñe!<verse eid="PSA 33:22" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" sid="PSA 34" />
  <para style="s1">Eremuhani luagu lareini Aburemei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 34:1" />Nalawahabei Nabureme súnwandan,</para>
  <para style="q" vid="PSA 34:1">leremuhaba niyuma lun súnwandan.<verse eid="PSA 34:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 34:2" />Pántatina lau Aburemei;</para>
  <para style="q" vid="PSA 34:2">aganba huméi,</para>
  <para style="q" vid="PSA 34:2">gunda huguyame huguya wügüriña ǘnabugutiña!<verse eid="PSA 34:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 34:3" />Weremuha úara lau aban umalali,</para>
  <para style="q" vid="PSA 34:3">luagu luéirigun Aburemei.<verse eid="PSA 34:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 34:4" />Agúahatina lun Nabureme,</para>
  <para style="q" vid="PSA 34:4">aba lóunabunina gidaléi sun anufudei nuéi.<verse eid="PSA 34:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 34:5" />Ha arihubaña luagun Aburemei</para>
  <para style="q" vid="PSA 34:5">rédeitiña lau ugundani;</para>
  <para style="q" vid="PSA 34:5">ani merededügübaña lau busiganu.<verse eid="PSA 34:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 34:6" />Fugiabu meha nuguya,</para>
  <para style="q" vid="PSA 34:6">wátina lun Nabureme, aba laganbunina,</para>
  <para style="q" vid="PSA 34:6">aba lesefurunina lídangiñe sun nidiheri.<verse eid="PSA 34:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 34:7" />Góunigi lumutiña lani Aburemei ánheli</para>
  <para style="q" vid="PSA 34:7">ani sefuláña sun ha íchugubaña inebesei lun Aburemei.<verse eid="PSA 34:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 34:8" />Houcha humá, ariha humeime luagu buidu lan Aburemei.</para>
  <para style="q" vid="PSA 34:8">Fuleseiwatiña gürigia ha hemenigibaña luagu Bungiu!<verse eid="PSA 34:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 34:9" />Inebelá Aburemei hun sun huguya</para>
  <para style="q" vid="PSA 34:9">ha deregeguabaña houngua lun,</para>
  <para style="q" vid="PSA 34:9">úabei hemegeirun ha inebehabubaña lun.<verse eid="PSA 34:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 34:10" />Rédeitiña ha rísibaña gudemeñu,</para>
  <para style="q" vid="PSA 34:10">áfaga hagía ilamaü,</para>
  <para style="q" vid="PSA 34:10">ánhaña ha áluahabalin Aburemei,</para>
  <para style="q" vid="PSA 34:10">memegeirúnbaña ni kata.<verse eid="PSA 34:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 34:11" />Higougu nirahüñü, aganba humana:</para>
  <para style="q" vid="PSA 34:11">narufudahaba hun lun inebe lan Aburemei hun.<verse eid="PSA 34:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 34:12" />Busentibu san babagaridun saragu dan?</para>
  <para style="q" vid="PSA 34:12">Busentibu san bíchugun ugundani bungua lidan bibagari?<verse eid="PSA 34:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 34:13" />Rédeiboun biñeñe luéi ladimurehoun wuribati;</para>
  <para style="q" vid="PSA 34:13">mariñagalá biyuma marasualugu.<verse eid="PSA 34:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 34:14" />Disebá luéi wuribani,</para>
  <para style="q" vid="PSA 34:14">adügabéi le buídubei,</para>
  <para style="q" vid="PSA 34:14">áluahabei darangilaü, ábame bafalaruni.<verse eid="PSA 34:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 34:15" />Góunigi lumutiña Aburemei ha harumabaña émeri,</para>
  <para style="q" vid="PSA 34:15">ru lumuti giñe larigei lun laganbuniña.<verse eid="PSA 34:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 34:16" />Magundanti Aburemei hau ha adügübaña wuribani,</para>
  <para style="q" vid="PSA 34:16">aranseñu liña lun lagidaruni laritawagúniwa hawagun ubouagugiñe.<verse eid="PSA 34:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 34:17" />Téniti Aburemei lun hagúarahan ha harumabaña,</para>
  <para style="q" vid="PSA 34:17">sefu lumutiña giñe lídangiñe wuribani.<verse eid="PSA 34:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 34:18" />Yarafati Aburemei lun lesefuruniña</para>
  <para style="q" vid="PSA 34:18">ha gáribei hasandirunu hanigi,</para>
  <para style="q" vid="PSA 34:18">ha féridi hamaalibei hemenigin.<verse eid="PSA 34:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 34:19" />Sügütiña ha harumabaña lídangiñe saragu wuribani,</para>
  <para style="q" vid="PSA 34:19">gama lumoun sefu lumutiña Aburemei lídangiñe súngubei.<verse eid="PSA 34:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 34:20" />Góunigi lumuti Aburemei sun habu,</para>
  <para style="q" vid="PSA 34:20">máhalachawagunbei ni aban lídangiñe.<verse eid="PSA 34:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 34:21" />Ha salufuribaña áfaragua lumutiña hariban guánarügü;</para>
  <para style="q" vid="PSA 34:21">habeichawaguba ha iyereehabúbaña houn ha harumabaña.<verse eid="PSA 34:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 34:22" />Sefu lumuti Aburemei habagari lubúeingu;</para>
  <para style="q" vid="PSA 34:22">mabeichawagunbaña ha afiñebaña luagu!<verse eid="PSA 34:22" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" sid="PSA 35" />
  <para style="s1">Afurieiduni álugei lídehan Aburemei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 35:1" />Nabureme, gagibuguabá hama ha agagibudagubaña numa;</para>
  <para style="q" vid="PSA 35:1">bageindagua hama ha ageindagubaña numa.<verse eid="PSA 35:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 35:2" />Daüboun badaüragun lánina wuribu</para>
  <para style="q" vid="PSA 35:2">barübéime bidaüdina lauti gürabu,</para>
  <para style="q" vid="PSA 35:2">higabu bíderaguana,<verse eid="PSA 35:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 35:3" />barübei barufunte,</para>
  <para style="q" vid="PSA 35:3">ráramabaña ha éibaahabalina;</para>
  <para style="q" vid="PSA 35:3">ariñagabá nun luagu buguya lan nesefuragülebei!<verse eid="PSA 35:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 35:4" />Anuraha hamá lau busiganu ha busenbaña háfarunina;</para>
  <para style="q" vid="PSA 35:4">anuraha hamá lau busiganu ha busenbaña hadügün wuribati nun;<verse eid="PSA 35:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 35:5" />ítara hamá kei ifei le lanügübei garabali,</para>
  <para style="q" vid="PSA 35:5">danme lachagaruniña lani Aburemei ánheli!<verse eid="PSA 35:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 35:6" />Búrigala hémeri, guyé ligíame,</para>
  <para style="q" vid="PSA 35:6">danme léibaahaniña lani Aburemei ánheli!<verse eid="PSA 35:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 35:7" />Sétitiña sádara nubá mébunouga;</para>
  <para style="q" vid="PSA 35:7">chigatiña huyu nubá mébunouga;</para>
  <para style="q" vid="PSA 35:7">lun néiguadun lidoun.<verse eid="PSA 35:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 35:8" />Ábürühala lamiselu hawagun sódinirügü!</para>
  <para style="q" vid="PSA 35:8">Ábürüha hamá tidoun guánarügü hasadaran!</para>
  <para style="q" vid="PSA 35:8">Ábürüha hamá lidoun lamiselu!<verse eid="PSA 35:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 35:9" />Ábameti nagundaarun lidan Nabureme,</para>
  <para style="q" vid="PSA 35:9">ladügame sefu láadina lan.<verse eid="PSA 35:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 35:10" />Nariñagame tau sun nanigi:</para>
  <para style="q" vid="PSA 35:10">«Ka ítarabei kei Nabureme?</para>
  <para style="q" vid="PSA 35:10">Sefu bumutiña ha gudemebaña hama ha mégeihabubaña</para>
  <para style="q" vid="PSA 35:10">hawéi ha héretimabaña sügǘ hau,</para>
  <para style="q" vid="PSA 35:10">ha amudiragubaliña».<verse eid="PSA 35:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 35:11" />Iñuraguatiña gefentiña salufuritiña,</para>
  <para style="q" vid="PSA 35:11">aba hálügüdagunina luagu burí katei le ibidiñeti luáguti nun.<verse eid="PSA 35:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 35:12" />Fáyeihaña buiti nun lau wuribati</para>
  <para style="q" vid="PSA 35:12">ma lueirin íruni nuagu luéigiñe lira!<verse eid="PSA 35:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 35:13" />Lau sun lira, dan le meha sandi hamá,</para>
  <para style="q" vid="PSA 35:13">dáüguatina daüguaü lánina íruni;</para>
  <para style="q" vid="PSA 35:13">rédeitina méiginga ladüga nigarigu,</para>
  <para style="q" vid="PSA 35:13">aba nerederun afurieida nídangua.<verse eid="PSA 35:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 35:14" />Rédeitina lau íruni luma maguraasuni,</para>
  <para style="q" vid="PSA 35:14">kamá hamuga namuiseruña tárigi núguchu,</para>
  <para style="q" vid="PSA 35:14">o lárigi lan aban numada odi aban níbiri.<verse eid="PSA 35:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 35:15" />Gama lumoun dan le nábürühanbei,</para>
  <para style="q" vid="PSA 35:15">sun hagía, aba héherahan nau lidan aban;</para>
  <para style="q" vid="PSA 35:15">óuseragua hamutina saragu</para>
  <para style="q" vid="PSA 35:15">kamá hamuga gürigia terencha hagía, ha ibidiñetina houn.<verse eid="PSA 35:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 35:16" />Buchagüdatiña nuagu, adaaguatiña bula nau,</para>
  <para style="q" vid="PSA 35:16">aríagua hamutina lau arihini le lánina iyereehabúni.<verse eid="PSA 35:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 35:17" />Nabureme, átiribei san dan bau arihei katei le?</para>
  <para style="q" vid="PSA 35:17">Sefubéi nibagari le ábanrügübei,</para>
  <para style="q" vid="PSA 35:17">hawéi liñún ha adürürühabaña nubaroun!<verse eid="PSA 35:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 35:18" />Neteingirubadibu hagibugiñe saragu bumutuniña;</para>
  <para style="q" vid="PSA 35:18">nalawahabadibu hañúarü saragu gürigia!<verse eid="PSA 35:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 35:19" />Magundaaragua hamá náganiñu nau;</para>
  <para style="q" vid="PSA 35:19">mámuruhan hameime ha iyereehabúbaña nun hagu mébunouga.<verse eid="PSA 35:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 35:20" />Hagía máluahan hamuti darangilaü,</para>
  <para style="q" vid="PSA 35:20">aranseharügütiña wuribani</para>
  <para style="q" vid="PSA 35:20">habá gürigia darangilutiña ha lílana fulasu;<verse eid="PSA 35:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 35:21" />ma lueirin háwagachun lun hariñagun nuagu:</para>
  <para style="q" vid="PSA 35:21">«Ariha huméi le ariha wamaalibei!»<verse eid="PSA 35:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 35:22" />Gefentibu luagu lira, Nabureme!</para>
  <para style="q" vid="PSA 35:22">Merederabá maniñu! Madisedabá nuéi!<verse eid="PSA 35:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 35:23" />Saraba, Nabureme Nubungiute,</para>
  <para style="q" vid="PSA 35:23">agaguduabá! Rubei niricha nun, númagiñeba.<verse eid="PSA 35:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 35:24" />Aguseragüdabana Nubungiute</para>
  <para style="q" vid="PSA 35:24">úaragua luma biricha.</para>
  <para style="q" vid="PSA 35:24">Méheraha hamá nau!<verse eid="PSA 35:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 35:25" />Mariñaga hamá masaminarun hagíame:</para>
  <para style="q" vid="PSA 35:25">«Anihán buga le wabusenrubei!</para>
  <para style="q" vid="PSA 35:25">Günringua wamá sunsuinagubei!»<verse eid="PSA 35:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 35:26" />Ha gúndaabaña lau nasufurirun</para>
  <para style="q" vid="PSA 35:26">redei hamá lau busiganu,</para>
  <para style="q" vid="PSA 35:26">redei hamá lau busiganu le gumuti</para>
  <para style="q" vid="PSA 35:26">ha íñugubei hasandiragun houngua nuéi.<verse eid="PSA 35:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PSA 35:27" />Gama lumoun gunda hamá, wagua hagíame lau ugundani</para>
  <para style="q" vid="PSA 35:27">ha busenbaña harihin nagañeirun;</para>
  <para style="q" vid="PSA 35:27">ariñaga hamá súnwandan:</para>
  <para style="q" vid="PSA 35:27">«Wéiriguti Aburemei, ani gúndaati</para>
  <para style="q" vid="PSA 35:27">lau buidu lan lidaani lubúein!»<verse eid="PSA 35:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 35:28" />Nadimurehaba luagu biricha tau niñeñe;</para>
  <para style="q" vid="PSA 35:28">nalawahabadibu sun weyu.<verse eid="PSA 35:28" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" sid="PSA 36" />
  <para style="s1">Hariban gürigia luma lareini Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 36:1" />Adimurehati wuribani houn ha salufuribaña</para>
  <para style="q" vid="PSA 36:1">lidan tilulin-agei hanigi.</para>
  <para style="q" vid="PSA 36:1">Maritaguntiña luagu lunti lan inebewa lan Bungiu.<verse eid="PSA 36:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 36:2" />Haritaguatiña luagu garicha lan</para>
  <para style="q" vid="PSA 36:2">lun ladimurehóuniwa buidu hawagu,</para>
  <para style="q" vid="PSA 36:2">darí lun marihin hamani luagu mabuidun lan le hadügübei.<verse eid="PSA 36:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 36:3" />Wíyeti hayuma, marasualugutiña,</para>
  <para style="q" vid="PSA 36:3">féridi hamaali hachügü ígira hamaali ladügǘn buiti.<verse eid="PSA 36:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 36:4" />Aransehatiña hadügün wuribani</para>
  <para style="q" vid="PSA 36:4">dan le roun haña lan tidan hagabanan;</para>
  <para style="q" vid="PSA 36:4">wéiriti híchaagun houngua lun luriban hémeri,</para>
  <para style="q" vid="PSA 36:4">darí lun maha hamá hígiruni wuribani.<verse eid="PSA 36:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 36:5" />Ánheinti bínsiñehabu, Aburemei,</para>
  <para style="q" vid="PSA 36:5">chülüti dagá sielu;</para>
  <para style="q" vid="PSA 36:5">chülüti búaragun chülǘ lumoun burí lidingun sielu;<verse eid="PSA 36:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 36:6" />ítara liña biricha</para>
  <para style="q" vid="PSA 36:6">kei burí áraabu le wéinamubei,</para>
  <para style="q" vid="PSA 36:6">ítara liña burí bererun</para>
  <para style="q" vid="PSA 36:6">kei lilulin barana le wéiribei,</para>
  <para style="q" vid="PSA 36:6">buguya Aburemei,</para>
  <para style="q" vid="PSA 36:6">góunigi bumutiña gürigia hama animaalugu.<verse eid="PSA 36:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 36:7" />Lubuidun san bínsiñehabu Bungiu!</para>
  <para style="q" vid="PSA 36:7">Aramudaguatiña gürigia lábugiñe barüna!<verse eid="PSA 36:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 36:8" />Gufurumatiña le tímatimaati lau éigini gíbeti,</para>
  <para style="q" vid="PSA 36:8">le tídangiñebei buban;</para>
  <para style="q" vid="PSA 36:8">guragüda bumutiña lídangiñe aban duna semeeti.<verse eid="PSA 36:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 36:9" />Ladüga bídanñein lubuñe ibagari,</para>
  <para style="q" vid="PSA 36:9">gayaraati warihini larugounga lidan bigemeri.<verse eid="PSA 36:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 36:10" />Rubei bínsiñehabu luma biricha súnwandan</para>
  <para style="q" vid="PSA 36:10">houn ha subudihabúbaña bun,</para>
  <para style="q" vid="PSA 36:10">luma houn ha buídubaña isaminan.<verse eid="PSA 36:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 36:11" />Mígiraba lun hadügüragunina ha barüguabaña houngua,</para>
  <para style="q" vid="PSA 36:11">ni lun háfarunina ha salufuribaña.<verse eid="PSA 36:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 36:12" />Ariha humá lun hábürühan wuribatiña!</para>
  <para style="q" vid="PSA 36:12">Ábürühatiña, lun másaarundigiaaña lan!<verse eid="PSA 36:12" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" sid="PSA 37" />
  <para style="s1">Hemenigibá luagu Aburemei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 37:1" />Magañidabá hadüga salufuritiña,</para>
  <para style="q" vid="PSA 37:1">magimugadabá giñe houn ha adügübaña wuribani,<verse eid="PSA 37:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 37:2" />fureseti hásaürün kei ubanaü;</para>
  <para style="q" vid="PSA 37:2">hilatiña kei híduru!<verse eid="PSA 37:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 37:3" />Hemenigibá luagu Aburemei,</para>
  <para style="q" vid="PSA 37:3">adügabéi le buídubei,</para>
  <para style="q" vid="PSA 37:3">babagarida ubouagu,</para>
  <para style="q" vid="PSA 37:3">gúnfuliba súnwandan.<verse eid="PSA 37:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 37:4" />Gundaabá le tímatimaati lidan Aburemei,</para>
  <para style="q" vid="PSA 37:4">ábame lagunfuliruni tayumahan banigi.<verse eid="PSA 37:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 37:5" />Rubei bibagari lúhaburugun Aburemei;</para>
  <para style="q" vid="PSA 37:5">hemenigibá luagu, ábame liabin lun líderagunibu.<verse eid="PSA 37:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 37:6" />Larihagüdübei bísurun luma biricha</para>
  <para style="q" vid="PSA 37:6">kei lasandirúniwa lisü weyu amidirugu.<verse eid="PSA 37:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 37:7" />Maniba liñúarü Aburemei</para>
  <para style="q" vid="PSA 37:7">bagurabahame lau gurasu darí líderagunibu.</para>
  <para style="q" vid="PSA 37:7">Magañidabá hawagu ha buídubaña lidin houn lidan habagari,</para>
  <para style="q" vid="PSA 37:7">ha aransehabaña lun hadügün wuribani.<verse eid="PSA 37:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 37:8" />Ígirabei igañi;</para>
  <para style="q" vid="PSA 37:8">magañidabá ladüga gádeirügü lumutitima agañiduni sun katei.<verse eid="PSA 37:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 37:9" />Lidan linarün katei,</para>
  <para style="q" vid="PSA 37:9">habugúba wuribatiña fulasurugugiñe,</para>
  <para style="q" vid="PSA 37:9">ánhaña ha hemenigibaña luagu Aburemei,</para>
  <para style="q" vid="PSA 37:9">hagíaba laburiña múa.<verse eid="PSA 37:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 37:10" />Málühaña ánhaña ua wuribatiña,</para>
  <para style="q" vid="PSA 37:10">gayaraabei báluahaniña, ani madaribubaña.<verse eid="PSA 37:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 37:11" />Ánhaña ha ǘnabubei hanaagun houngua,</para>
  <para style="q" vid="PSA 37:11">hagíaba laburiña múa,</para>
  <para style="q" vid="PSA 37:11">habagariduba lidan darangilaü le dayarüti.<verse eid="PSA 37:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 37:12" />Áluahatiña ha salufuribaña hadügün wuribani houn ha buídubaña,</para>
  <para style="q" vid="PSA 37:12">aba haríaguni lau arihini le lánina iyereehabúni.<verse eid="PSA 37:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 37:13" />Gama lumoun éheraharügüti Aburemei</para>
  <para style="q" vid="PSA 37:13">ladüga subudi lumuti luagu yarafaali lan hadaani ha salufuribaña.<verse eid="PSA 37:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 37:14" />Sagá hamutu wuribatiña hefeinte,</para>
  <para style="q" vid="PSA 37:14">seti hamóun hagimaran lun hábürügüdüniña ha gudemebaña,</para>
  <para style="q" vid="PSA 37:14">hama ha ǘnabugubaña,</para>
  <para style="q" vid="PSA 37:14">lun giñe háfaraguniña ha buídubaña óuserun!<verse eid="PSA 37:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 37:15" />Gama lumoun tebeluruba hefeinte guánarügü tidoun hanigi,</para>
  <para style="q" vid="PSA 37:15">halagua tuguyame hagimaran.<verse eid="PSA 37:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 37:16" />Murusun katei le hámabei gürigia buítiña,</para>
  <para style="q" vid="PSA 37:16">buítimati sügǘ lau saragu harisin ha wuribabaña.<verse eid="PSA 37:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 37:17" />Ladüga lagumuchaguagüdübaña Aburemei ha salufuribaña,</para>
  <para style="q" vid="PSA 37:17">gama lumoun lágüdahabaña ha buídubaña.<verse eid="PSA 37:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 37:18" />Góunigi lumutiña Aburemei ha harumabaña abagaridun,</para>
  <para style="q" vid="PSA 37:18">ani lerederuba halagante lun súnwandan.<verse eid="PSA 37:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 37:19" />Lídanme luriban dan,</para>
  <para style="q" vid="PSA 37:19">danme ñein lan ilamaü mabusigaridunbaña,</para>
  <para style="q" vid="PSA 37:19">ladüga géiginbaña lan.<verse eid="PSA 37:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 37:20" />Háguduba wuribatiña kei híduru sáühali,</para>
  <para style="q" vid="PSA 37:20">hagumuchaguba láganiñu Bungiu kei gumuleli.<verse eid="PSA 37:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 37:21" />Amuriahatiña ha salufuribaña furedeiti, ani mafayeihantiña,</para>
  <para style="q" vid="PSA 37:21">ánhañati ha buídubaña, gudemehabutiña, areidatiña giñe.<verse eid="PSA 37:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 37:22" />Ha labinirubaña Aburemei, galagantehabei múa,</para>
  <para style="q" vid="PSA 37:22">ánhaña ha líñaragubaña, hagünrinchawaguba.<verse eid="PSA 37:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 37:23" />Adundeha lumuti Aburemei héibugun gürigia,</para>
  <para style="q" vid="PSA 37:23">ru laña lidoun üma le aubei lagundaara;<verse eid="PSA 37:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 37:24" />íbini ánhaña éiguada,</para>
  <para style="q" vid="PSA 37:24">meredebaña ítara héiguañu,</para>
  <para style="q" vid="PSA 37:24">ladüga ragüñuliani Aburemei háhabu.<verse eid="PSA 37:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PSA 37:25" />Nibureintina meha, guentó wéiyaadina,</para>
  <para style="q" vid="PSA 37:25">ani marihingidina láguruniña Bungiu gürigia ha buídubaña,</para>
  <para style="q" vid="PSA 37:25">marihin naña hasaanigu arihadiha.<verse eid="PSA 37:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 37:26" />Gudemehabutiña súnwandan, afuredeiha hagía;</para>
  <para style="q" vid="PSA 37:26">aban abiniruni hasaanigu.<verse eid="PSA 37:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PSA 37:27" />Disebá luéi wuribani,</para>
  <para style="q" vid="PSA 37:27">adügabéi le buídubei,</para>
  <para style="q" vid="PSA 37:27">ítara luba gabara ban súnwandan.<verse eid="PSA 37:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 37:28" />Ladüga hínsiñeti irichaü lun Aburemei,</para>
  <para style="q" vid="PSA 37:28">ani mágurun lumutiña ha gúnfulibaña luma;</para>
  <para style="q" vid="PSA 37:28">gama lumoun günringua lumutiña ha salufuribaña</para>
  <para style="q" vid="PSA 37:28">mígirunti lun gadügawagun hamá.<verse eid="PSA 37:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 37:29" />Galangantehabei gürigia buítiña múa,</para>
  <para style="q" vid="PSA 37:29">haganóuba giñe lidan súnwandan.<verse eid="PSA 37:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="PSA 37:30" />Gürigia ha buídubaña,</para>
  <para style="q" vid="PSA 37:30">adimurehatiña lau lichú aau,</para>
  <para style="q" vid="PSA 37:30">gürigia ha buídubaña,</para>
  <para style="q" vid="PSA 37:30">adimurehatiña lau irichaü.<verse eid="PSA 37:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 37:31" />Barǘ hamuti larufudahan Habungiute tidan hanigi,</para>
  <para style="q" vid="PSA 37:31">ligía miriraagunbei lubéi hagudi!<verse eid="PSA 37:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="PSA 37:32" />Aganariha hamutiña gürigia ha wuribabaña ha buídubaña</para>
  <para style="q" vid="PSA 37:32">lun háfaruniña hilagubei;<verse eid="PSA 37:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 37:33" />gama lumoun mígirunbei Aburemei</para>
  <para style="q" vid="PSA 37:33">lun hábürühan háhaburugun,</para>
  <para style="q" vid="PSA 37:33">mígirunbei giñe lun híchugun hadurun.<verse eid="PSA 37:33" /></para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" sid="PSA 37:34" />Hemenigibá luagu Aburemei, aganbabéi,</para>
  <para style="q" vid="PSA 37:34">liñuragubadibu, ruleime ageiraü bun balaganteme,</para>
  <para style="q" vid="PSA 37:34">barihubei hagünrinchawagun wuribatiña lau bagu!<verse eid="PSA 37:34" /></para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" sid="PSA 37:35" />Ariha naali lanarime líñugun wuribati</para>
  <para style="q" vid="PSA 37:35">ariha naali laweiridagun kei aban tídibu wewe hilumatu;<verse eid="PSA 37:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 37:36" />gama lumoun ñǘdünha, gumugua ligia;</para>
  <para style="q" vid="PSA 37:36">áluaha numuti yebe, siñá numuti adarira.<verse eid="PSA 37:36" /></para>
  <para style="b" />
  <para style="q">
    <verse number="37" style="v" sid="PSA 37:37" />Arihabáña gürigia ha harumabaña:</para>
  <para style="q" vid="PSA 37:37">Darangilaü lunbei liabin houn.<verse eid="PSA 37:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 37:38" />Ánhaña ha wuribabaña hagünrinchawaguba sunsuinagubei;</para>
  <para style="q" vid="PSA 37:38">agünrinchawaguniba ñübuin houn ha wuribabaña.<verse eid="PSA 37:38" /></para>
  <para style="b" />
  <para style="q">
    <verse number="39" style="v" sid="PSA 37:39" />Lúmagiñe Aburemei liabin ídemuei houn gürigia buítiña,</para>
  <para style="q" vid="PSA 37:39">ligía haramudaguagülebei lidan lidere dan.<verse eid="PSA 37:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 37:40" />Íderagua lumutiña Aburemei lun hesefurun.</para>
  <para style="q" vid="PSA 37:40">Sefu lumutiña hawéi wuribatiña,</para>
  <para style="q" vid="PSA 37:40">sefu lumutiña, ladüga lidan háluaha haramudagun.<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" sid="PSA 38" />
  <para style="s1">Ayumuraguni amuriahei lídehan Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 38:1" />Nabureme madeinhabá nun lidan basafaragun,</para>
  <para style="q" vid="PSA 38:1">mabeichunbaname lau bigañi.<verse eid="PSA 38:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 38:2" />Ladüga charuharu burí bigimaran nuagu,</para>
  <para style="q" vid="PSA 38:2">ru baali lihürü búhabu nuagun!<verse eid="PSA 38:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 38:3" />Sánditi sun núgubu lárigi bigañi ladüga nifigoun,</para>
  <para style="q" vid="PSA 38:3">úati ni aban abun buiti látuadi nidan!<verse eid="PSA 38:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 38:4" />Buchagüda nuriban nuagu;</para>
  <para style="q" vid="PSA 38:4">ítara liña nun kei aban anügüni le siñá numuti awanda.<verse eid="PSA 38:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 38:5" />Lañaladuña biti burí le nuágubei,</para>
  <para style="q" vid="PSA 38:5">hingi ligía ladüga numaganbadin.<verse eid="PSA 38:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 38:6" />Barugu niña, maguraasun au;</para>
  <para style="q" vid="PSA 38:6">ayahu niña sun weyu.<verse eid="PSA 38:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 38:7" />Éigaaguati nanagan lau abiruaü,</para>
  <para style="q" vid="PSA 38:7">sun núgubu lauñein sandi!<verse eid="PSA 38:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 38:8" />Ñounti nasandiruni nura ani méreedina,</para>
  <para style="q" vid="PSA 38:8">sun naünhan tídangiñeti nanigi.<verse eid="PSA 38:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 38:9" />Nabureme, subudi bumuti sun nayumahan,</para>
  <para style="q" vid="PSA 38:9">le nabusenrubei mama aban katei aramudaguati bun.<verse eid="PSA 38:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 38:10" />Fureseti tádühan nanigi,</para>
  <para style="q" vid="PSA 38:10">alouguadei naali nere, íbini narihin búriha!<verse eid="PSA 38:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 38:11" />Diñuhaña besi numadagu hama niduheñu nuéi,</para>
  <para style="q" vid="PSA 38:11">ladüga guméi le nuágubei.<verse eid="PSA 38:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 38:12" />Ha busenbaña háfarunina hilagubei,</para>
  <para style="q" vid="PSA 38:12">rútiña sádara nubá;</para>
  <para style="q" vid="PSA 38:12">ha busenbaña hañawarihanina,</para>
  <para style="q" vid="PSA 38:12">ayanuhatiña luagu hagünrinchagunina,</para>
  <para style="q" vid="PSA 38:12">súnwandan haransehaña lun hadügün wuribani.<verse eid="PSA 38:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 38:13" />Gama lumoun aba nadügün kamá le hamuga maganbuntina;</para>
  <para style="q" vid="PSA 38:13">maní au kamá mariñagaditina.<verse eid="PSA 38:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 38:14" />Ítara niña kei le maganbunbei,</para>
  <para style="q" vid="PSA 38:14">siñá lariñagun ni kata luéigiñegua.<verse eid="PSA 38:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 38:15" />Agurabatina búmagiñe Nubungiute,</para>
  <para style="q" vid="PSA 38:15">lun buguya lan óunabaña.<verse eid="PSA 38:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 38:16" />Amuriaharügütina lun méherahan hamá nau;</para>
  <para style="q" vid="PSA 38:16">lun meremuhan hamá uremu lánina agañeiruni danme le nábürühan.<verse eid="PSA 38:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 38:17" />Lidan linarün katei,</para>
  <para style="q" vid="PSA 38:17">madiseedina lun nábürühan;</para>
  <para style="q" vid="PSA 38:17">mígirun lumutina nigarigu ni murusun oura.<verse eid="PSA 38:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 38:18" />Nagufeseraali nifigoun,</para>
  <para style="q" vid="PSA 38:18">ladüga buíngüda lumutina lau íruni.<verse eid="PSA 38:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 38:19" />Gíbeguaaña náganiñu;</para>
  <para style="q" vid="PSA 38:19">gíbetiña iyereegutina houn madurunga.<verse eid="PSA 38:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 38:20" />Fáyeihaña wuribati nun luagu buiti,</para>
  <para style="q" vid="PSA 38:20">kóntürañanu nuguya luéigiñe náluahan nadügüni le buídubei.<verse eid="PSA 38:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 38:21" />Nabureme, mígirabana nábugua!</para>
  <para style="q" vid="PSA 38:21">Nubungiute, madisedabá nuéi!<verse eid="PSA 38:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 38:22" />Bungiu Nesefuragüle,</para>
  <para style="q" vid="PSA 38:22">higabu furese íderaguana!<verse eid="PSA 38:22" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" sid="PSA 39" />
  <para style="s1">Murusunrügüñein ibagari</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 39:1" />Füramasehadina yebe lun nóunigiruni ligaburi nusan,</para>
  <para style="q" vid="PSA 39:1">lun mafigounhan nan tau niñeñe</para>
  <para style="q" vid="PSA 39:1">lun madaarun nubéi lan niyuma</para>
  <para style="q" vid="PSA 39:1">sun añaha lan wuribatiña niñúarü.<verse eid="PSA 39:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 39:2" />Aba nadügün kamá le mariñagaditina,</para>
  <para style="q" vid="PSA 39:2">rédeitina maniñu.</para>
  <para style="q" vid="PSA 39:2">Madimurehantina ni íbini luagu katei le buídubei!</para>
  <para style="q" vid="PSA 39:2">Gama lumoun aweiridagueina ligía nigarigu;<verse eid="PSA 39:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 39:3" />sütu nasandirunu nanigi naniguagu!</para>
  <para style="q" vid="PSA 39:3">Lidan anaha lan asaminara luagu katei le,</para>
  <para style="q" vid="PSA 39:3">aba ladurangun watu nidan,</para>
  <para style="q" vid="PSA 39:3">ábati nariñagun lau umalali héreti:<verse eid="PSA 39:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 39:4" />«Nabureme, subudigüdabei nun kaba lan lébeha niwinwan</para>
  <para style="q" vid="PSA 39:4">luma átiribei lan dan nabagaridun;</para>
  <para style="q" vid="PSA 39:4">busentina nasubudiruni ida liña lan lilouguan nibagari!»<verse eid="PSA 39:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 39:5" />Rúhadibu aban ibagari le murusunrügüti nun;</para>
  <para style="q" vid="PSA 39:5">ni kata nibagari bigibugiñe.</para>
  <para style="q" vid="PSA 39:5">Sun gürigia ítara liña hadurarun ubouagu</para>
  <para style="q" vid="PSA 39:5">kei aban awaraguni!<verse eid="PSA 39:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 39:6" />Sun gürigia sügütiña kei aban amuñani!</para>
  <para style="q" vid="PSA 39:6">Málati hadaagun saragu irisini,</para>
  <para style="q" vid="PSA 39:6">ladüga ibidiñeti houn kaba lan eredera lau.<verse eid="PSA 39:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 39:7" />Ítarati Nabureme,</para>
  <para style="q" vid="PSA 39:7">kábati nagurabaha guentó?</para>
  <para style="q" vid="PSA 39:7">Buagu nemenigida!<verse eid="PSA 39:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 39:8" />Sefubána lídangiñe nifigoun;</para>
  <para style="q" vid="PSA 39:8">mígiraba lun hadügün ha ibidiouguabaña aau bula nau.<verse eid="PSA 39:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 39:9" />Adügatina kei mariñagaditina,</para>
  <para style="q" vid="PSA 39:9">ani máwagachuntina,</para>
  <para style="q" vid="PSA 39:9">ladüga buguya asufuriragüdübalina ítara.<verse eid="PSA 39:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 39:10" />Sunla bagayuahan nuagu;</para>
  <para style="q" vid="PSA 39:10">ladüga buchá nuagu lárigi lagayuahan barüna.<verse eid="PSA 39:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 39:11" />Arufudahatibu houn gürigia,</para>
  <para style="q" vid="PSA 39:11">lau babeichaguniña luéigiñe hafigoun,</para>
  <para style="q" vid="PSA 39:11">adügabéi burí katei le hínsiñetimabei houn lun ni kátame.</para>
  <para style="q" vid="PSA 39:11">Inarüni luagu ni kátañanu lan gürigia!<verse eid="PSA 39:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 39:12" />Nabureme, aganbabéi nafurieidun</para>
  <para style="q" vid="PSA 39:12">ruba arigei lun baganbuni nayahun!</para>
  <para style="q" vid="PSA 39:12">Merederabá maniñu lau náguira!</para>
  <para style="q" vid="PSA 39:12">Aban terencha au bun;</para>
  <para style="q" vid="PSA 39:12">aban dunuru to tásügürarügüña</para>
  <para style="q" vid="PSA 39:12">kei binadu nagübürigu.<verse eid="PSA 39:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 39:13" />Hebé baríagunina,</para>
  <para style="q" vid="PSA 39:13">ruba murusun awaraguni nun,</para>
  <para style="q" vid="PSA 39:13">ragüguaraü náamuga nungua lubaragiñe nounwen.<verse eid="PSA 39:13" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" sid="PSA 40" />
  <para style="s1">Hínsiñeti nun nadügüni lugundan Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 40:1" />Ru numuti nemenigin luagu Nabureme,</para>
  <para style="q" vid="PSA 40:1">aba líchuguni larigei lun laganbuni nagúarahan;<verse eid="PSA 40:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 40:2" />sefu lumutina lídangiñe umúahaü le lánina óunweni,</para>
  <para style="q" vid="PSA 40:2">sefu lumutina luéi nabuluchun lidoun suanpu.</para>
  <para style="q" vid="PSA 40:2">Ráramagüda lumutina derebuguñu luagu aban dübü,</para>
  <para style="q" vid="PSA 40:2">derebugugüdalei néibugun.<verse eid="PSA 40:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 40:3" />Eremaagüda lumutina aban iseri uremu,</para>
  <para style="q" vid="PSA 40:3">aban uremu lánina alawahani lun Wabungiute.</para>
  <para style="q" vid="PSA 40:3">Saraguhaña aweiridagutu hanigi dan harihini katei le;</para>
  <para style="q" vid="PSA 40:3">aba hemenigidun luagu Bungiu!<verse eid="PSA 40:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 40:4" />Fuleseiwatiña gürigia ha hemenigibaña luagu Aburemei,</para>
  <para style="q" vid="PSA 40:4">ha máluahanbaliña ha salufuribaña</para>
  <para style="q" vid="PSA 40:4">ni ha áhuduragubaña houn búngiugu ha ni kátabaña.<verse eid="PSA 40:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 40:5" />Nabureme, Nubungiute,</para>
  <para style="q" vid="PSA 40:5">gíbeti burí katei buíduburiti le adüga báalibei</para>
  <para style="q" vid="PSA 40:5">luma lubuidun aritaguni le burí bídanbei woun.</para>
  <para style="q" vid="PSA 40:5">Úati ni kata bibe!</para>
  <para style="q" vid="PSA 40:5">Busentina hamuga nadimurehan luagu burí katei ligía,</para>
  <para style="q" vid="PSA 40:5">gama lumoun gíbeyati lun niyaraabei lan abahüdagua.<verse eid="PSA 40:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 40:6" />Magundaaruntibu lau adagaragüdüni ni lau idewesei le ílaüauti,</para>
  <para style="q" vid="PSA 40:6">mamuriahantibu giñe adagaragüdüni gudawarügüti ni idewesei luagu figóu.</para>
  <para style="q" vid="PSA 40:6">Lubaragiñe lira dará baali narigeirugu lun naganbuni bererun.<verse eid="PSA 40:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 40:7" />Ligía nariñagunbei:</para>
  <para style="q" vid="PSA 40:7">«Anahán kei tariñaguni biliburun nuagu.<verse eid="PSA 40:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 40:8" />Nubungiute, hínsiñeti nun lun nadügüni bugundan,</para>
  <para style="q" vid="PSA 40:8">barǘ numuti barufudahan tidan nanigi!»<verse eid="PSA 40:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 40:9" />Subudigüda naali le richabei</para>
  <para style="q" vid="PSA 40:9">hagibugiñe bumutuniña ha gíbebaña,</para>
  <para style="q" vid="PSA 40:9">subudi bumuti buidu, Nabureme,</para>
  <para style="q" vid="PSA 40:9">luagu meredetina lan maniñu!<verse eid="PSA 40:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 40:10" />Meredegidina madimurehanga luagu bíchugun irichaü;</para>
  <para style="q" vid="PSA 40:10">adimurehaadina luagu bigunfulin luma besefuhan.</para>
  <para style="q" vid="PSA 40:10">Maramudun numuti bínsiñehabu</para>
  <para style="q" vid="PSA 40:10">luma binarün hagibugiñe bumutuniña ha gíbebaña.<verse eid="PSA 40:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 40:11" />Nabureme, mamaharabá lau bínsiñehabu nun!</para>
  <para style="q" vid="PSA 40:11">Góunigilana bínsiñehabu luma binarün súnwandan!<verse eid="PSA 40:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 40:12" />Susereeli saragu katei wuribati nun</para>
  <para style="q" vid="PSA 40:12">darí lun siñá lan nabahüdaguni</para>
  <para style="q" vid="PSA 40:12">ragǘ laadina burí nuriban guánarügü;</para>
  <para style="q" vid="PSA 40:12">darí lun féridina lan narihin!</para>
  <para style="q" vid="PSA 40:12">Gíbeti sügǘ lau burí lugule ídiburi le nábulugubei,</para>
  <para style="q" vid="PSA 40:12">darí lun maguraasunhadina lan.<verse eid="PSA 40:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 40:13" />Nabureme adügabá fulesei nun,</para>
  <para style="q" vid="PSA 40:13">ñǘbuinba esefurana!</para>
  <para style="q" vid="PSA 40:13">Nabureme, higabu bíderaguana furese.<verse eid="PSA 40:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 40:14" />Ha álugubaña hagumuchun lau nibagari,</para>
  <para style="q" vid="PSA 40:14">rúbaña lidoun busiganu!</para>
  <para style="q" vid="PSA 40:14">Anuraha hamá lau busiganu</para>
  <para style="q" vid="PSA 40:14">ha busenbaña hadügün wuribati nun.<verse eid="PSA 40:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 40:15" />Anuraha hamá lau busiganu,</para>
  <para style="q" vid="PSA 40:15">sun ha adaagubaña bula nau!<verse eid="PSA 40:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 40:16" />Ánhaña sun ha áluahabalibu,</para>
  <para style="q" vid="PSA 40:16">buin hamá lau ugundani;</para>
  <para style="q" vid="PSA 40:16">ha busenbaña besefuruniña</para>
  <para style="q" vid="PSA 40:16">ariñaga hamá súnwandan:</para>
  <para style="q" vid="PSA 40:16">«Wéiriguti Aburemei».<verse eid="PSA 40:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 40:17" />Ánheinti au fugiabu le gudemebei ani nidiheri nuguya,</para>
  <para style="q" vid="PSA 40:17">mabulieidabana, Nabureme.</para>
  <para style="q" vid="PSA 40:17">Buguya íderagubalina buguya esefurana;</para>
  <para style="q" vid="PSA 40:17">madarasahabá Nubungiute!<verse eid="PSA 40:17" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" sid="PSA 41" />
  <para style="s1">Lafurieidun aban gürigia sánditi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 41:1" />Fuleseiwatiña ha haritaguabaña</para>
  <para style="q" vid="PSA 41:1">hawagun ha mérebaña hama ha gudemebaña,</para>
  <para style="q" vid="PSA 41:1">lesefurubaña Aburemei lidan lidere dan.<verse eid="PSA 41:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 41:2" />Lóunigirubaña Aburemei,</para>
  <para style="q" vid="PSA 41:2">líchuguba ibagari luma lubuidun dan houn ubouagu,</para>
  <para style="q" vid="PSA 41:2">mígirun lubaña Bungiu lun hadügüni háganiñu le habusenrun hau.<verse eid="PSA 41:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 41:3" />Danme le gabanarugu hamá lau sandi;</para>
  <para style="q" vid="PSA 41:3">lasansirubei Bungiu hasandi lun átuadime!<verse eid="PSA 41:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 41:4" />Ariñagaadina:</para>
  <para style="q" vid="PSA 41:4">«Nabureme, gudemená bun;</para>
  <para style="q" vid="PSA 41:4">agaranihabá nun lau sun afigouhaadina lan bigibugiñe».<verse eid="PSA 41:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 41:5" />Ayumaha hamuti náganiñu luriban-agei burí katei nun hariñagati:</para>
  <para style="q" vid="PSA 41:5">«Ídaame san lounwe, maritawagún láamuga luagun?»<verse eid="PSA 41:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 41:6" />Ñǘbuintiña arihana,</para>
  <para style="q" vid="PSA 41:6">ani mama lau taruman hanigi;</para>
  <para style="q" vid="PSA 41:6">areida hamuti sun le wuribabei lidan hachügü,</para>
  <para style="q" vid="PSA 41:6">dan le háfuridun ǘmadarugun aba habahüdaguni,<verse eid="PSA 41:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 41:7" />óundaraguatiña ha iyereehabúbaña nun adimureha nuagu;</para>
  <para style="q" vid="PSA 41:7">haritaguatiña luagu nasufuriruña lan ladüga nidurun.<verse eid="PSA 41:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 41:8" />Hariñagati:</para>
  <para style="q" vid="PSA 41:8">«Sandi le luágubei lúmagiñeti Mafia;</para>
  <para style="q" vid="PSA 41:8">ábürühaali gabanarugun ani másaarundigiaali».<verse eid="PSA 41:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 41:9" />Íbini létima meni numada</para>
  <para style="q" vid="PSA 41:9">le meha yebe uágubei nemenigida,</para>
  <para style="q" vid="PSA 41:9">léñaha éigibei numa, garabagua nuagun.<verse eid="PSA 41:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 41:10" />Buguyati Nabureme,</para>
  <para style="q" vid="PSA 41:10">gudemená bun; areidaguagüdabana</para>
  <para style="q" vid="PSA 41:10">fayei náamugaña lau le hadünabei.<verse eid="PSA 41:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 41:11" />Magañeirun habadina náganiñu</para>
  <para style="q" vid="PSA 41:11">lauba katei le nasubudirei</para>
  <para style="q" vid="PSA 41:11">anhein gunda bubéi nau.<verse eid="PSA 41:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 41:12" />Auti, le abagaridaalibei aban ibagari harumati</para>
  <para style="q" vid="PSA 41:12">barübana búhaburugu!</para>
  <para style="q" vid="PSA 41:12">Kipubána biñuarürugu súnwandan!<verse eid="PSA 41:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 41:13" />Alawahoualá Wabureme le Lubungiute Ísüraeli,</para>
  <para style="q" vid="PSA 41:13">guentó luma súnwandan ítarala!<verse eid="PSA 41:13" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" pubnumber="42 (41)" sid="PSA 42" />
  <para style="ms">TIBIAMAN LÍBURU</para>
  <para style="mr">(Sálumu <ref loc="PSA 42-72">42—72</ref>)</para>
  <para style="s1">Lídanñein Bungiu nemenigin</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 42:1" />Ítara kei láluahani usari duna lidan lumagürabu,</para>
  <para style="q" vid="PSA 42:1">ítara liña giñe náluahanibu Nubungiute.<verse eid="PSA 42:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 42:2" />Mágürabutina lun Bungiu le íchugubei ibagari.</para>
  <para style="q" vid="PSA 42:2">Ídaayame funa san narufudagua nungua ligibugiñe Bungiu?<verse eid="PSA 42:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 42:3" />Náguira néiginbei áriebu wéyuagu,</para>
  <para style="q" vid="PSA 42:3">ani súnwandan nálügüdüniwa:</para>
  <para style="q" vid="PSA 42:3">“Hagéi san Bubungiute?”<verse eid="PSA 42:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 42:4" />Dan le nasaminarun luagu burí katei le,</para>
  <para style="q" vid="PSA 42:4">aba nígiraguagüdün nungua lun nigarigu;</para>
  <para style="q" vid="PSA 42:4">haritagua numuti dan meha nidin</para>
  <para style="q" vid="PSA 42:4">adundeheina gürigia lúbiñoun Bungiu</para>
  <para style="q" vid="PSA 42:4">agúaraheina wagía lau ugundani luma eteingiruni.</para>
  <para style="q" vid="PSA 42:4">Ma meha lanarime fedu!<verse eid="PSA 42:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 42:5" />Kaba san uagu lárügüdana maguraasuni?</para>
  <para style="q" vid="PSA 42:5">Kaba san uagu nadiherida?</para>
  <para style="q" vid="PSA 42:5">Ru naali nemenigin luagu Bungiu,</para>
  <para style="q" vid="PSA 42:5">ani nalawahamémebei.</para>
  <para style="q" vid="PSA 42:5">Ligía Nubungiutebei Nesefuragüle!<verse eid="PSA 42:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6-7" style="v" sid="PSA 42:6-7" />Sandí numutu nanigi lau maguraasuni,</para>
  <para style="q" vid="PSA 42:6-7">Ligía lérebei naritagun luagun Bungiu.</para>
  <para style="q" vid="PSA 42:6-7">Ítara kei lararirun duna luéigiñe wübü Erümón luma Misarü,</para>
  <para style="q" vid="PSA 42:6-7">aba lidin lau anarimeni lidoun duna Hordán,</para>
  <para style="q" vid="PSA 42:6-7">ítara liña lueirin íruni le lóunahabei Bungiu nuagun.<verse eid="PSA 42:6-7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 42:8" />Wéyuagu, óunaha lumuti Nabureme línsiñehabu nun,</para>
  <para style="q" vid="PSA 42:8">áriebu, meredeti neremuhan</para>
  <para style="q" vid="PSA 42:8">ni nafurieidun lun Lubungiute nibagari.<verse eid="PSA 42:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 42:9" />Nariñaga lun Bungiu, le óunigirubalina:</para>
  <para style="q" vid="PSA 42:9">“Ka san uagu babulieidana?</para>
  <para style="q" vid="PSA 42:9">Ka san uagu mosu lubéi hasufuriragüdünina náganiñu?”<verse eid="PSA 42:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 42:10" />Íbini burí nabu gáriti lárigi hanabagunina náganiñu,</para>
  <para style="q" vid="PSA 42:10">súnwandan hálügüdüñadina:</para>
  <para style="q" vid="PSA 42:10">“Hagéi san Bubungiute?”<verse eid="PSA 42:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 42:11" />Kaba san uagu lárügüdana maguraasuni?</para>
  <para style="q" vid="PSA 42:11">Kaba san uagu nadiherida?</para>
  <para style="q" vid="PSA 42:11">Ru naali nemenigin luagu Bungiu,</para>
  <para style="q" vid="PSA 42:11">ani nalawahamémebei.</para>
  <para style="q" vid="PSA 42:11">Ligía Nubungiutebei Nesefuragüle!<verse eid="PSA 42:11" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" sid="PSA 43" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 43:1" />Bungiu, rubei niricha nun;</para>
  <para style="q" vid="PSA 43:1">númagiñeba kóntüra gibe tubungiutegu ha!</para>
  <para style="q" vid="PSA 43:1">Sefubána hawéi ha marasualugubaña luma hawéi ha salufuribaña.<verse eid="PSA 43:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 43:2" />Ladüga buguya Nubungiutebei le óunigirubalina!</para>
  <para style="q" vid="PSA 43:2">Ka san uagu badisedagüdana buáriua?</para>
  <para style="q" vid="PSA 43:2">Ka san uagu mosu lubéi hasufuriragüdünina náganiñu?<verse eid="PSA 43:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 43:3" />Óunahabei bigemeri luma binarün</para>
  <para style="q" vid="PSA 43:3">lun larufuduni üma nun</para>
  <para style="q" vid="PSA 43:3">barüya láamugana lun Sión, lidoun buwübüri le sándubei,</para>
  <para style="q" vid="PSA 43:3">tidoun buban, fulasu le ñein lubéi baganóua.<verse eid="PSA 43:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 43:4" />Ábameti niabin luagun bani latarü Nabureme,</para>
  <para style="q" vid="PSA 43:4">ábame neremuhan bun ñein lau tamuri árüpa,</para>
  <para style="q" vid="PSA 43:4">ladüga buguya, Nubungiute,</para>
  <para style="q" vid="PSA 43:4">buíngüda bumuti nibagari lau ugundani.<verse eid="PSA 43:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 43:5" />Kaba san uagu lárügüdana maguraasuni?</para>
  <para style="q" vid="PSA 43:5">Kaba san uagu nadiherida?</para>
  <para style="q" vid="PSA 43:5">Ru naali nemenigin luagu Bungiu,</para>
  <para style="q" vid="PSA 43:5">ani nalawahamémebei.</para>
  <para style="q" vid="PSA 43:5">Ligía Nubungiutebei Nesefuragüle!<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" sid="PSA 44" />
  <para style="s1">Afurieiduni amuriahei lídehan Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 44:1" />Bungiu,</para>
  <para style="q" vid="PSA 44:1">aganba wamaali lau warigei</para>
  <para style="q" vid="PSA 44:1">abahüdagua haméi wagübürigu woun</para>
  <para style="q" vid="PSA 44:1">katei le burí meha badügübei lidan dan le sügühalibei:<verse eid="PSA 44:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 44:2" />Bugagua bumutiña gürigia ha gibe tubungiutegu</para>
  <para style="q" vid="PSA 44:2">lau búhabu guánarügü</para>
  <para style="q" vid="PSA 44:2">beigua bumutiña néchanigu hagía</para>
  <para style="q" vid="PSA 44:2">aba bíchuguniña wagübürigu ñein.<verse eid="PSA 44:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 44:3" />Mama harüna tuma hefeinte agañeiragüdübaliña;</para>
  <para style="q" vid="PSA 44:3">mama hagía agañeirubalin múa.</para>
  <para style="q" vid="PSA 44:3">Lagañeirun bubafu luma bere!</para>
  <para style="q" vid="PSA 44:3">Lagañeirun larugoungadüna biñuarü,</para>
  <para style="q" vid="PSA 44:3">ladüga buga hínsiñe bun!<verse eid="PSA 44:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 44:4" />Nurúeite! Nubungiute!</para>
  <para style="q" vid="PSA 44:4">Buguya agañeiragüdübaliña bumutuniña;<verse eid="PSA 44:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 44:5" />seremei buguya wagañeirubaliña wáganiñu;</para>
  <para style="q" vid="PSA 44:5">lidan biri waburechaguaaña ha ageindagubaña wama!<verse eid="PSA 44:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 44:6" />Memenigidúnbadina hamuga tuagu tebu nigimaran,</para>
  <para style="q" vid="PSA 44:6">magañeiragüdün tubadina hamuga giñe nefeinte.<verse eid="PSA 44:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 44:7" />Buguya agañeiragüdübaliwa hawagu wáganiñu,</para>
  <para style="q" vid="PSA 44:7">buguya íchugubaliña ha iyereehabúbaña woun lidoun busiganu.<verse eid="PSA 44:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 44:8" />Wapantahaba bau súnwandan, Bungiu,</para>
  <para style="q" vid="PSA 44:8">weremuhaba giñe lun biri súnwandan!<verse eid="PSA 44:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 44:9" />Gama lumoun ígira báadiwa;</para>
  <para style="q" vid="PSA 44:9">buíngüda báadiwa lau busiganu.</para>
  <para style="q" vid="PSA 44:9">Máfuridunhadibu ageindagua úara hama wasudaranigu.<verse eid="PSA 44:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 44:10" />Gararaguagüda báadiwa hawéi wáganiñu;</para>
  <para style="q" vid="PSA 44:10">íweruha hamutiwa ha iyereehabúbaña woun,</para>
  <para style="q" vid="PSA 44:10">barǘ haméi le habusenrun.<verse eid="PSA 44:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 44:11" />Derege báadiwa kei mudún ha lúntiña hafarúniwa,</para>
  <para style="q" vid="PSA 44:11">chagagua báadiwa haganagua gibe tubungiutegu;<verse eid="PSA 44:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 44:12" />alugura baaña bánigu maserunga</para>
  <para style="q" vid="PSA 44:12">ani magañeirúntibu ni kata lau baluguruniña.<verse eid="PSA 44:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 44:13" />Adüga báadiwa lébuname anabúni;</para>
  <para style="q" vid="PSA 44:13">anabagua hamutiwa wabesinanigu</para>
  <para style="q" vid="PSA 44:13">ru hamawa lidoun busiganu.<verse eid="PSA 44:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 44:14" />Adügaadibu lun héheraagüle wamá gibe tubungiutegu;</para>
  <para style="q" vid="PSA 44:14">dan harihiniwa aba hánhinhani hachügü éheraha wau.<verse eid="PSA 44:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 44:15" />Súnwandan láuñadina busiganu,</para>
  <para style="q" vid="PSA 44:15">sanditina kamá hamuga léiguada nigibu lau busiganu.<verse eid="PSA 44:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 44:16" />Ladüga lanarime</para>
  <para style="q" vid="PSA 44:16">ladimurehan nágani ásurana anaba.<verse eid="PSA 44:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 44:17" />Mama ladüga wabulieidunibu lasusereda katei le woun.</para>
  <para style="q" vid="PSA 44:17">Mama luéigiñe magunfulirun wamani bidaradun!<verse eid="PSA 44:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 44:18" />Maritaguntiwa wígirunibu,</para>
  <para style="q" vid="PSA 44:18">mígirun waméi bémeri.<verse eid="PSA 44:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 44:19" />Lau sun lira ígira bumutiwa haganagua animaalu áraabuna.</para>
  <para style="q" vid="PSA 44:19">Daruguagüdaadibu lanarime luburiga wau!<verse eid="PSA 44:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 44:20" />Anhein hamuga bulíei wamutibu Bungiu,</para>
  <para style="q" vid="PSA 44:20">lun hamuga huduguatiwa lun aban bungiu terencha lidan bilugaarun,<verse eid="PSA 44:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 44:21" />gefentibu hamuga luagu,</para>
  <para style="q" vid="PSA 44:21">ladüga subudi bumuti sun katei, íbini le aramudaguabei.<verse eid="PSA 44:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 44:22" />Gama lumoun yarafatiwa lun wounwen buéigiñe súnwandan</para>
  <para style="q" vid="PSA 44:22">óusera hamutiwa keisi mudún anügǘtiña lun háfarawagun.<verse eid="PSA 44:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 44:23" />Ka san uagu barumuga, Nabureme?</para>
  <para style="q" vid="PSA 44:23">Agaguduabá, agaguduabá!</para>
  <para style="q" vid="PSA 44:23">Mágurabawa lun sun dan!<verse eid="PSA 44:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 44:24" />Ka san uagu baramudagua wawéi?</para>
  <para style="q" vid="PSA 44:24">Ka uagu babulieidawa wagía le asufurirubei saragu?<verse eid="PSA 44:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 44:25" />Bucharuadiwa, héiguañu waña múarugu,</para>
  <para style="q" vid="PSA 44:25">aduruuheina wágubu múarugu!<verse eid="PSA 44:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 44:26" />Saraba, higabu bíderaguawa,</para>
  <para style="q" vid="PSA 44:26">sefubáwa luagu bínsiñehabu.<verse eid="PSA 44:26" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" sid="PSA 45" />
  <para style="s1">Uremu lubá lamarieidun urúei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 45:1" />Buínguatu nanigi lau dimurei buídumeraüti</para>
  <para style="q" vid="PSA 45:1">dan nariñaguni nani bérusu ligibugiñe urúei;</para>
  <para style="q" vid="PSA 45:1">ítara tiña niñeñe kei labürügüle aban abürühati!<verse eid="PSA 45:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 45:2" />Buguya gürigia létima magadiñebei!</para>
  <para style="q" vid="PSA 45:2">Furiti anichigu biyumulugugiñe!</para>
  <para style="q" vid="PSA 45:2">Ligía labinirunbalibu Bungiu lun súnwandan.<verse eid="PSA 45:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 45:3" />Dahiboun befeinte biranaagua, gürigia ganigiti!</para>
  <para style="q" vid="PSA 45:3">Tuguya buéndenboun!<verse eid="PSA 45:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 45:4" />Bawanserun lidan bagañeirun ligía buéirigunbei,</para>
  <para style="q" vid="PSA 45:4">ageindagueina luagu lóubadina inarüni,</para>
  <para style="q" vid="PSA 45:4">íchigeina haricha ha ǘnabugubaña</para>
  <para style="q" vid="PSA 45:4">adügati búhabu le bóunwenren katei wéinamuburiti!<verse eid="PSA 45:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 45:5" />Ábürühatiña lílana fulasu lubadu bugudi, urúei,</para>
  <para style="q" vid="PSA 45:5">gágiriburitu bigimaran</para>
  <para style="q" vid="PSA 45:5">charutu tuagun hanigi báganiñu.<verse eid="PSA 45:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 45:6" />Bungiu, magumuchaditi barúeihan;</para>
  <para style="q" vid="PSA 45:6">ani aban arúeihani le lánina richaguaü.<verse eid="PSA 45:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 45:7" />Hínsiñeti katei le buídubei bun,</para>
  <para style="q" vid="PSA 45:7">iyereeguti le wuribabei bun.</para>
  <para style="q" vid="PSA 45:7">Ligía lanúadirunbalibu Bungiu le Bubungiute,</para>
  <para style="q" vid="PSA 45:7">aba labuinchagüdünibu lau ugundani,</para>
  <para style="q" vid="PSA 45:7">sügǘ hau bupanaagu.<verse eid="PSA 45:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 45:8" />Hémetu badaüragun lau lubuidun ibiñein;</para>
  <para style="q" vid="PSA 45:8">eremuhatiña bun tau gidara lun bagundaarun</para>
  <para style="q" vid="PSA 45:8">tidan bani palasiu to wéndeboun.<verse eid="PSA 45:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 45:9" />Hadan würiña ha afileihabaña lidan bamarieidun,</para>
  <para style="q" vid="PSA 45:9">añahein harahüñü urúeigu;</para>
  <para style="q" vid="PSA 45:9">luéigiñe bóunwenren ñeinñoun urúei,</para>
  <para style="q" vid="PSA 45:9">wéndeñu lau golu le fínutimabei.<verse eid="PSA 45:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 45:10" />Ladari urúei, aganbabéi le lunbei nariñaguni bun:</para>
  <para style="q" vid="PSA 45:10">«Bulieibáña biduheñu hama bumutuniña.<verse eid="PSA 45:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 45:11" />Magadiñetibu, ligía bínsiñebei lun urúei,</para>
  <para style="q" vid="PSA 45:11">babureme ligía, lunti bidin lau le lubeibei.<verse eid="PSA 45:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 45:12" />Sun lílana uburugu Tiru hanügüba idewesei bun,</para>
  <para style="q" vid="PSA 45:12">háfaaguba lun hagañeirunibu lau edewehani».<verse eid="PSA 45:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 45:13" />Anuhán ladari urúei ebelura lau sun tubuidunmeraü!</para>
  <para style="q" vid="PSA 45:13">Lau filu lauti golu tadügǘwa tadaüragun!<verse eid="PSA 45:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 45:14" />Wéndeñutiña hanügünu ligibugiñoun urúei,</para>
  <para style="q" vid="PSA 45:14">hau tánigu würiña tárigi tárigi hama tumadagu.<verse eid="PSA 45:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 45:15" />Hawanseruña lau óunwenbu ugundani,</para>
  <para style="q" vid="PSA 45:15">ma hagundan hebelurun lúbiñoun urúei.<verse eid="PSA 45:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 45:16" />Hañuuruba birahüñü luagu lálana harúeihan bagüchagu</para>
  <para style="q" vid="PSA 45:16">ábame bagumadiragüdüniña lidan sun fulasu.<verse eid="PSA 45:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 45:17" />Nadügüba lun laritawagún luagun biri hadan iseri inebanfangu,</para>
  <para style="q" vid="PSA 45:17">luma lun halawahanibu lílana fulasu súnwandan.<verse eid="PSA 45:17" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" sid="PSA 46" />
  <para style="s1">Anihein Aburemei wama</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 46:1" />Bungiu waramudaguagülebei, ligía giñe wérebei;</para>
  <para style="q" vid="PSA 46:1">ligía íderagubaliwa lidan nidiheri wamá.<verse eid="PSA 46:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 46:2" />Ligía manufudebadiwa lubéi íbini lagünrinchagun múa,</para>
  <para style="q" vid="PSA 46:2">íbini labuluchun burí áraabu lidoun lilulin barana.<verse eid="PSA 46:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 46:3" />Manufudebadiwa</para>
  <para style="q" vid="PSA 46:3">íbini ladürürühan barana, iñura ligía lugudi,</para>
  <para style="q" vid="PSA 46:3">íbini ladadagarun burí áraabu lau ligañi.<verse eid="PSA 46:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 46:4" />Anihein aban duna éibaaguati</para>
  <para style="q" vid="PSA 46:4">íchuguti ugundani lidan luburugute Bungiu,</para>
  <para style="q" vid="PSA 46:4">le sándutimabei lídangiñe burí luburugute Bungiu.<verse eid="PSA 46:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 46:5" />Anihein Bungiu lamidangua uburugu ligía,</para>
  <para style="q" vid="PSA 46:5">ani lágüdahabei Aburemei,</para>
  <para style="q" vid="PSA 46:5">líderagubei Bungiu dan le lagumeserun arugada.<verse eid="PSA 46:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 46:6" />Áünhatiña néchanigu,</para>
  <para style="q" vid="PSA 46:6">adadagarati burí arúeihani,</para>
  <para style="q" vid="PSA 46:6">günringuati múa dan le laganbagüdüni Bungiu lumalali.<verse eid="PSA 46:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 46:7" />Anihein Aburemei Suntigabafu wama!</para>
  <para style="q" vid="PSA 46:7">Lubungiute Hakobu waramudaguagülebei!<verse eid="PSA 46:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 46:8" />Higougu harihei katei wéinamuti</para>
  <para style="q" vid="PSA 46:8">le burí ladügübei Aburemei ubouagu:<verse eid="PSA 46:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 46:9" />Gumuguagüdalá wuribu</para>
  <para style="q" vid="PSA 46:9">chülǘ lumoun lagumuhóun larigeirugu ubóu;</para>
  <para style="q" vid="PSA 46:9">halagualá burí gimara, günringualá burí eféin,</para>
  <para style="q" vid="PSA 46:9">gudala burí karü to lánina wuribu.<verse eid="PSA 46:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 46:10" />«Deregegua humá hungua!</para>
  <para style="q" vid="PSA 46:10">Subudi huméi luagu au lan Búngiubei!</para>
  <para style="q" vid="PSA 46:10">Hóugiñeñadina sun néchanigu!</para>
  <para style="q" vid="PSA 46:10">Lóugiñeñadina sun ubóu!»<verse eid="PSA 46:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 46:11" />Anihein Aburemei Suntigabafu wama!</para>
  <para style="q" vid="PSA 46:11">Lubungiute Hakobu waramudaguagülebei!<verse eid="PSA 46:11" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" sid="PSA 47" />
  <para style="s1">Bungiu Urúeibei lidan sun ubóu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 47:1" />Sun gürigia pou huméi húhabu!</para>
  <para style="q" vid="PSA 47:1">Hagúaraha lun Bungiu lau ugundani!<verse eid="PSA 47:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 47:2" />Ladüga hanarimeti Aburemei le íñugubei;</para>
  <para style="q" vid="PSA 47:2">ligía lurúeitebei sun ubóu.<verse eid="PSA 47:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 47:3" />Günringuati burí ageiraü hama néchanigu,</para>
  <para style="q" vid="PSA 47:3">aba líchuguniña lábugiñe wabafu.<verse eid="PSA 47:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 47:4" />Anúadaha laali walagante,</para>
  <para style="q" vid="PSA 47:4">le lapantaagüle Hakobu, le meha hínsiñebei lun.<verse eid="PSA 47:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 47:5" />Warihali Aburemei luagun lálana larúeihan</para>
  <para style="q" vid="PSA 47:5">laganagua hagúarahan lánigu lau ugundani luma tumalali fidu!<verse eid="PSA 47:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 47:6" />Heremuha, wa humá uremu lun Bungiu!</para>
  <para style="q" vid="PSA 47:6">Heremuha, wa humá uremu lun warúeite!<verse eid="PSA 47:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 47:7" />Heremuha aban bérusu lun Bungiu,</para>
  <para style="q" vid="PSA 47:7">ladüga ligía Lurúeitebei sun ubóu!<verse eid="PSA 47:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 47:8" />Bungiu Harúeitebei néchanigu!</para>
  <para style="q" vid="PSA 47:8">Ñun liña luagu lálana larúeihan le sándubei!<verse eid="PSA 47:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 47:9" />Óundaraguatiña wügüriña íñugutiña</para>
  <para style="q" vid="PSA 47:9">ha fulasurugubaña hamoun lumutuniña Bungiu</para>
  <para style="q" vid="PSA 47:9">le Lubungiute Abüraámü,<verse eid="PSA 47:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 47:10" />ladüga lani Bungiu sun ubafu le ubouagubei</para>
  <para style="q" vid="PSA 47:10">lóugiñeñein sun katei Bungiu!<verse eid="PSA 47:10" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" sid="PSA 48" />
  <para style="s1">Luéirigun Sión, luburugute Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 48:1" />Wéiriguti Aburemei!</para>
  <para style="q" vid="PSA 48:1">Gadünati Wabungiute lun lichugún uéiriguni lun</para>
  <para style="q" vid="PSA 48:1">lidan luburugute, luma lidan luwübüri le sándubei!<verse eid="PSA 48:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 48:2" />Ma lubuidun liñun wübü Sión, yágüta luéigiñe nórute!</para>
  <para style="q" vid="PSA 48:2">Ligía lagundaaraguagülebei sun ubóu!</para>
  <para style="q" vid="PSA 48:2">Ligía luburugutebei Bungiu le urúei.<verse eid="PSA 48:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 48:3" />Anihein Bungiu tidan palasiu to Herusalénboun;</para>
  <para style="q" vid="PSA 48:3">arufudaguaali lungua kei aban aramudaguagülei le chóuruti.<verse eid="PSA 48:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 48:4" />Óundaraguatiña urúeigu,</para>
  <para style="q" vid="PSA 48:4">aba hawanserun luagun úara;<verse eid="PSA 48:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 48:5" />gama lumoun dan harihini uburugu aba taweiridun hanigi,</para>
  <para style="q" vid="PSA 48:5">aba mederaguagüdün hamá, aba hanurahan.<verse eid="PSA 48:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 48:6" />Aba lárügüdüniña anufudei:</para>
  <para style="q" vid="PSA 48:6">Aba haguribihan lau igarigu kei würi dan le tágurahan;<verse eid="PSA 48:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 48:7" />kei garabali le áfuruti luéigiñe labouchagüle weyu</para>
  <para style="q" vid="PSA 48:7">le burí agünrinchagubarun lugunena Tárüsisi.<verse eid="PSA 48:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 48:8" />Ariha wamaali lau wagu, le meha abahüdawagubei woun</para>
  <para style="q" vid="PSA 48:8">luburuguterugu Wabungiute, Wabureme Suntigabafu.</para>
  <para style="q" vid="PSA 48:8">Lararamagüdübei Aburemei Herusalén buidu lun súnwandan!<verse eid="PSA 48:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 48:9" />Bungiu,</para>
  <para style="q" vid="PSA 48:9">haritaguatiwa luagun lueirin bínsiñehabu búbiñe,<verse eid="PSA 48:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 48:10" />Bungiu,</para>
  <para style="q" vid="PSA 48:10">adimurehóuati buiti buagu lidan sun ubóu,</para>
  <para style="q" vid="PSA 48:10">kei le yuubei lun biri,</para>
  <para style="q" vid="PSA 48:10">rútibu irichaü lau bubafu.<verse eid="PSA 48:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 48:11" />Gundaagualá luwübüri Sión.</para>
  <para style="q" vid="PSA 48:11">Achubaha hamá lílana burí uburugu Hudá lau ugundani,</para>
  <para style="q" vid="PSA 48:11">luagu burí liricha baguseragüdün!<verse eid="PSA 48:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 48:12" />Héibuga geyegua lau Sión</para>
  <para style="q" vid="PSA 48:12">habahüdeime burí wáyelesi le ñeinbei;<verse eid="PSA 48:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 48:13" />ariha huméi burí lubarieirun tuma burí lani palasiu,</para>
  <para style="q" vid="PSA 48:13">gayara láamuga habahüdagun houn iseri inebanfangu,<verse eid="PSA 48:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 48:14" />luagu ítara liña lan Wabungiute, súnwandan.</para>
  <para style="q" vid="PSA 48:14">Ligía adundehabaliwa lun sun dan!<verse eid="PSA 48:14" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" sid="PSA 49" />
  <para style="s1">Mámarügüñein seinsu sun katei lidan ibagari</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 49:1" />Aganba huméi katei le buidu,</para>
  <para style="q" vid="PSA 49:1">huguya lílana sun ubóu;<verse eid="PSA 49:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 49:2" />dandu rísitiña kei gudemetiña,</para>
  <para style="q" vid="PSA 49:2">dandu ha gabafubaña kei ha ǘnabugubaña.<verse eid="PSA 49:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 49:3" />Nadimurehaba lau lichú aau,</para>
  <para style="q" vid="PSA 49:3">ariñaga aume saminaü huliliti;<verse eid="PSA 49:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 49:4" />níchuguba arigei lun ariñawagúni,</para>
  <para style="q" vid="PSA 49:4">nariñagubei lanichigu katei le aramudaguabei,</para>
  <para style="q" vid="PSA 49:4">nariñagubei lau tamuri árüpa.<verse eid="PSA 49:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 49:5" />Kaba san uagu nanufudeda danme liabin lidere dan;</para>
  <para style="q" vid="PSA 49:5">danme nadariragun nungua geyegu lau hariban náganiñu?<verse eid="PSA 49:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 49:6" />Hagía afiñetiña luagu burí harisin,</para>
  <para style="q" vid="PSA 49:6">aba hanaagun houngua luagu liibe hámati;<verse eid="PSA 49:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 49:7" />gama lumoun úati ni aban gayaraati lesefuragun lungua</para>
  <para style="q" vid="PSA 49:7">ni lun lafayeiruni Bungiu lun lesefuruni libagari.<verse eid="PSA 49:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 49:8" />Úati seinsu gayaraati lagañeihani libagari gürigia,<verse eid="PSA 49:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 49:9" />lun labagaridun súnwandan,</para>
  <para style="q" vid="PSA 49:9">lun lesefurun luéi óunweni!<verse eid="PSA 49:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 49:10" />Arihúati luagu hilá lan chu tau</para>
  <para style="q" vid="PSA 49:10">hilá ibidiougua tau,</para>
  <para style="q" vid="PSA 49:10">aba lerederun harisin houn amu.<verse eid="PSA 49:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 49:11" />Lau sun ru hamani burí hiri luagu hamúan,</para>
  <para style="q" vid="PSA 49:11">umúahaü ligíaba haban lun súnwandan;</para>
  <para style="q" vid="PSA 49:11">ñeinba heredera gumugua dan.<verse eid="PSA 49:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 49:12" />Hilati gürigia ka lan yebe lirisinbei,</para>
  <para style="q" vid="PSA 49:12">hilati kéigubeirügü lounwen animaalu.<verse eid="PSA 49:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 49:13" />Ítara liña hagumuchagun ha afiñebaña hawougua;</para>
  <para style="q" vid="PSA 49:13">ítara liña hagumuchagun ha adimurehabaña buiti hawougua.<verse eid="PSA 49:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 49:14" />Siádiwaaña lun hóunwegun kei mudún,</para>
  <para style="q" vid="PSA 49:14">ani óunweniba amainiruti le lunbei lalidihaniña.</para>
  <para style="q" vid="PSA 49:14">Hagañeirubaña ha buídubaña ha wuribabaña binaafin;</para>
  <para style="q" vid="PSA 49:14">agumucheina luba here, umúahaü tuguyaba haban.<verse eid="PSA 49:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 49:15" />Gama lumoun lesefurubadina Bungiu</para>
  <para style="q" vid="PSA 49:15">lídangiñe lubafu óunweni, lanügübadina lúmagua.<verse eid="PSA 49:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 49:16" />Meberesenbá anhein arisida amu gürigia,</para>
  <para style="q" vid="PSA 49:16">anhein íchiga lanwoun tuenden luban,<verse eid="PSA 49:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 49:17" />ladüga danme lounwen,</para>
  <para style="q" vid="PSA 49:17">manügünbei ni kata lúmagua,</para>
  <para style="q" vid="PSA 49:17">mídinbei giñe luéndegun lárigi lidoun lumuaha.<verse eid="PSA 49:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 49:18" />Íbini buidu lan ladariragun lungua lidan libagari,</para>
  <para style="q" vid="PSA 49:18">hínsiñe ligía houn gürigia ladüga lirisin,<verse eid="PSA 49:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 49:19" />lachülürüba weyu lun lounwen,</para>
  <para style="q" vid="PSA 49:19">marihindigia láalime larugounga.<verse eid="PSA 49:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 49:20" />Hilatiña gürigia ka lan yebe harisinbei;</para>
  <para style="q" vid="PSA 49:20">ítara kéigubeirügü lounwen animaalu.<verse eid="PSA 49:20" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" sid="PSA 50" />
  <para style="s1">Aban aguseragüdüti le richati Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 50:1" />Adimurehaali Aburemei le Habungiute búngiugu;</para>
  <para style="q" vid="PSA 50:1">wáhali houn lílana ubóu</para>
  <para style="q" vid="PSA 50:1">luéigiñe oubaü le ñéingiñe lubéi laboucha weyu</para>
  <para style="q" vid="PSA 50:1">lumoun le ñeinhin lubéi lálüda.<verse eid="PSA 50:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 50:2" />Harugoungadagüdati Bungiu lúmagiñe Sióngiñe,</para>
  <para style="q" vid="PSA 50:2">uburugu le buídutimabei ani wende ligía.<verse eid="PSA 50:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 50:3" />Anite Wabungiute,</para>
  <para style="q" vid="PSA 50:3">gama lumoun miábinbei maniñu:</para>
  <para style="q" vid="PSA 50:3">Liábinba aban watu gemeti le gagünrinchaguaditi lubá lubá;</para>
  <para style="q" vid="PSA 50:3">aban guran le héreti lau huya geyegu lau.<verse eid="PSA 50:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 50:4" />Agúahati Bungiu íñugiñe lun sielu luma múa</para>
  <para style="q" vid="PSA 50:4">lun harihini haguseragüdüniwa lumutuniña.<verse eid="PSA 50:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 50:5" />Lariñaga: «Óundaragua humaña ha gúnfulibaña numa,</para>
  <para style="q" vid="PSA 50:5">ha adügaañabaña aban daradu numa lau hadagaragüdün nun».<verse eid="PSA 50:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 50:6" />Arufuda lumuti sielu luagu aguseragüdüti lan</para>
  <para style="q" vid="PSA 50:6">le richati Bungiu.<verse eid="PSA 50:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 50:7" />«Aganba humana Ísüraelina, numutuniña,</para>
  <para style="q" vid="PSA 50:7">nafuranguagüdaali burí katei hun.</para>
  <para style="q" vid="PSA 50:7">Au Búngiubei, au Hubungiutebei!<verse eid="PSA 50:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 50:8" />Madeinhanbadina hun luéigiñe adagaragüdüni,</para>
  <para style="q" vid="PSA 50:8">ni luagu burí idewesei le hanügübei nun súnwandan.<verse eid="PSA 50:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 50:9" />Mamuriahantina bágasu huma hádangiñe hibiñanigu,</para>
  <para style="q" vid="PSA 50:9">ni gábara hádangiñe hilügüniña,<verse eid="PSA 50:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 50:10" />ladüga nani sun animaalugu ha áraabuna</para>
  <para style="q" vid="PSA 50:10">hama burí animaalu ha luágubaña wübü,<verse eid="PSA 50:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 50:11" />nilügüniña dunuru ha dabíararugubaña,</para>
  <para style="q" vid="PSA 50:11">luma sun le ánhingichubei áraabu.<verse eid="PSA 50:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 50:12" />Ánhana hamuga alamacha mariñagun nubéi yebe hun,</para>
  <para style="q" vid="PSA 50:12">ladüga nani ubóu lau sun katei le lídanbei.<verse eid="PSA 50:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 50:13" />Hágürügü funagia bágasu néigibei,</para>
  <para style="q" vid="PSA 50:13">odi guratina hata gábara?<verse eid="PSA 50:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 50:14" />Eteingirunilá hidewese lun Bungiu;</para>
  <para style="q" vid="PSA 50:14">gúnfuli huméi le füramase hubéi lun le Íñugutimabei!<verse eid="PSA 50:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 50:15" />Wa humá nun dan le nidiheri humá;</para>
  <para style="q" vid="PSA 50:15">nesefurubadün, ábame híchugun uéiriguni nun».<verse eid="PSA 50:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 50:16" />Anhein houn gürigia ha salufuribaña,</para>
  <para style="q" vid="PSA 50:16">lariñahare Bungiu:</para>
  <para style="q" vid="PSA 50:16">«Ka hirichabei lun hariñaguni nilurudun</para>
  <para style="q" vid="PSA 50:16">odi lun hayanuhan libügürü nidaradun,<verse eid="PSA 50:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 50:17" />anhein magundan hubéi lau neweridirunün</para>
  <para style="q" vid="PSA 50:17">luéi katei le wuribabei,</para>
  <para style="q" vid="PSA 50:17">meberesen huguya lau nererun?<verse eid="PSA 50:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 50:18" />Resibi humutiña híwerutiña lau harüna tuleñu;</para>
  <para style="q" vid="PSA 50:18">óundaraguatün hama gürigia maríeitiña ha gagabarahatiña.<verse eid="PSA 50:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 50:19" />Huálitu hiñeñe luma hiyuma</para>
  <para style="q" vid="PSA 50:19">lun wuribani luma marasualugu.<verse eid="PSA 50:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 50:20" />Adimurehatün wuriba luagu híbiri;</para>
  <para style="q" vid="PSA 50:20">anabagua humuti híbiri guánarügü!<verse eid="PSA 50:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 50:21" />Adüga humaali sun le, maniñu au,</para>
  <para style="q" vid="PSA 50:21">haritaguatün yebe luagu aban lan nigaburi huma.</para>
  <para style="q" vid="PSA 50:21">Gama lumoun níchigaali hidurun higibugiñe,</para>
  <para style="q" vid="PSA 50:21">hafayeiha nun luagu hadüga!<verse eid="PSA 50:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 50:22" />Gunfuranda huméi katei le buidu</para>
  <para style="q" vid="PSA 50:22">huguya le abulieidagubei luéi Bungiu,</para>
  <para style="q" vid="PSA 50:22">gumeseniñein agünrinchaguaün ani úabei esefurutün<verse eid="PSA 50:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 50:23" />Ha íchugutiña eteingiruni nun, inebetina houn,</para>
  <para style="q" vid="PSA 50:23">Sefu numutiña ha ederaguagüdütiña lidan némeri!»<verse eid="PSA 50:23" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" sid="PSA 51" />
  <para style="s1">Bungiu Baba, gudemená bun</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 51:1" />Gudemená bun Bungiu Baba luagu bínsiñehabu;</para>
  <para style="q" vid="PSA 51:1">luagu lueirin bubuidun, ferudunabéi nidurun.<verse eid="PSA 51:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 51:2" />Chibabana lídangiñe wuribani le gádanbalina!</para>
  <para style="q" vid="PSA 51:2">Harumagüdabana lídangiñe nifigoun!<verse eid="PSA 51:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 51:3" />Subudi numuti luagu mabuchaha nan;</para>
  <para style="q" vid="PSA 51:3">magidati nifigoun lídangiñe nisaminan.<verse eid="PSA 51:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 51:4" />Afigouhaadina bigibugiñe lau</para>
  <para style="q" vid="PSA 51:4">nadügüni katei le aubei magundan ban.</para>
  <para style="q" vid="PSA 51:4">Ligía richá lubéi bisiadin;</para>
  <para style="q" vid="PSA 51:4">richagua ligía baguseragüdün.<verse eid="PSA 51:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 51:5" />Lidan linarün katei,</para>
  <para style="q" vid="PSA 51:5">wuribatina lúmagiñe nágurahouniwa;</para>
  <para style="q" vid="PSA 51:5">gafigountina lúmagiñe turageirugugiñe núguchu.<verse eid="PSA 51:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 51:6" />Lidan linarün katei,</para>
  <para style="q" vid="PSA 51:6">hínsiñetu anigi harumatu bun,</para>
  <para style="q" vid="PSA 51:6">ani rúhadibu lichú aau nun nídangua.<verse eid="PSA 51:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 51:7" />Gidabei nifigoun nuéi ábayame narumadun,</para>
  <para style="q" vid="PSA 51:7">chibabana, ábame lagidarun dáseiti nuéi.<verse eid="PSA 51:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 51:8" />Buíngüdabana lau ugundani;</para>
  <para style="q" vid="PSA 51:8">gundaaguagüdayabana lau sun dürügua baali lan buga nugundan.<verse eid="PSA 51:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 51:9" />Dísegüdabei sun nifigoun luéi barihin,</para>
  <para style="q" vid="PSA 51:9">gidabei sun nuriban.<verse eid="PSA 51:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 51:10" />Adügabá aban anigi to harumatu nidan, Nubungiute!</para>
  <para style="q" vid="PSA 51:10">Ru buguyame aban iseri sífiri le gúnfuliti nidoun!<verse eid="PSA 51:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 51:11" />Magidarabana biñuarürugugiñe,</para>
  <para style="q" vid="PSA 51:11">magidarunbeime bani sífiri le sándubei nuéi.<verse eid="PSA 51:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 51:12" />Sandigüdayabei ugundani le lánina besefuhan nun;</para>
  <para style="q" vid="PSA 51:12">ágüdahabana lau lareini bani sífiri,<verse eid="PSA 51:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 51:13" />gayara láamuga narufuduni bémeri houn ha mabuchahabaña,</para>
  <para style="q" vid="PSA 51:13">áluaha hamaamugabu gafigountiña.<verse eid="PSA 51:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 51:14" />Sefubána luéi áfarahani, Nubungiute,</para>
  <para style="q" vid="PSA 51:14">buguya Bungiu le esefurubalina,</para>
  <para style="q" vid="PSA 51:14">ábame nariñagun lau uremu luagu richá ban.<verse eid="PSA 51:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 51:15" />Nabureme, darabei niyuma,</para>
  <para style="q" vid="PSA 51:15">ábame náwahan uremu bun.<verse eid="PSA 51:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 51:16" />Ladüga mama lau burí idewesei bagundaara;</para>
  <para style="q" vid="PSA 51:16">íbini hamuga nadagaragüdün bun,</para>
  <para style="q" vid="PSA 51:16">mama ligía babusenrubei.<verse eid="PSA 51:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 51:17" />Aban sífiri le gagariguti lárigi figóu,</para>
  <para style="q" vid="PSA 51:17">ligía edewehani aubei lagundaara Bungiu,</para>
  <para style="q" vid="PSA 51:17">Nubungiute, mamahantibu tun aban anigi gagarigutu!<verse eid="PSA 51:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 51:18" />Adügabá buiti lun Sión lau bareini;</para>
  <para style="q" vid="PSA 51:18">ráramagüdayabei lubarieirun Herusalén.<verse eid="PSA 51:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 51:19" />Ábameti bánharun lun beresibiruni</para>
  <para style="q" vid="PSA 51:19">burí adagaragüdüni le yuubei lun ladügǘn,</para>
  <para style="q" vid="PSA 51:19">idewesei le gudawarügüti le gumuti,</para>
  <para style="q" vid="PSA 51:19">ábameti hadagarawagüdüniwa bágasu ligibuagu bani latarü.<verse eid="PSA 51:19" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" sid="PSA 52" />
  <para style="s1">Málati lanaagun wuribati lungua</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 52:1" />Ka san uagu bapantaha lau buriban, buguya gabafuti?</para>
  <para style="q" vid="PSA 52:1">Merederagunti lugudemehabu Bungiu!<verse eid="PSA 52:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 52:2" />Lúnrügüñein badügüni le wuribabei basaminara;</para>
  <para style="q" vid="PSA 52:2">ítara tiña biñeñe kei aban gusiñu hamanatu.<verse eid="PSA 52:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 52:3" />Himei bágili katei le wuribabei luéi le buídubei,</para>
  <para style="q" vid="PSA 52:3">himei bumuti marasualugu luéi inarüni.<verse eid="PSA 52:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 52:4" />Iñeñein marasualugutu,</para>
  <para style="q" vid="PSA 52:4">himei bumuti burí dimurei le gagünrinchaguaditi;<verse eid="PSA 52:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 52:5" />gama lumoun lagünrinchagubadibu giñe Bungiu lun sun dan:</para>
  <para style="q" vid="PSA 52:5">Lanügübadibu ábame labugunibu búbiñegiñe,</para>
  <para style="q" vid="PSA 52:5">ábame lagidaruni bibagari buéi.<verse eid="PSA 52:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 52:6" />Anihán katei le,</para>
  <para style="q" vid="PSA 52:6">harihubei ha ñǘdünbaña lau le lubeibei Bungiu,</para>
  <para style="q" vid="PSA 52:6">ábame hanufudedun,</para>
  <para style="q" vid="PSA 52:6">gama lumoun héherahaba lau gürigia ligía,</para>
  <para style="q" vid="PSA 52:6">hariñagame:<verse eid="PSA 52:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 52:7" />«Ariha huméi le máluahanbalin Bungiu;</para>
  <para style="q" vid="PSA 52:7">le hemenigibei luagu burí liibe lirisin,</para>
  <para style="q" vid="PSA 52:7">aba lasigirun lidan luriban».<verse eid="PSA 52:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 52:8" />Ánheinti au, ítara niña kei oliwu wurigili</para>
  <para style="q" vid="PSA 52:8">tidan luban Bungiu.</para>
  <para style="q" vid="PSA 52:8">Nemenigiduba luagu líñsiñehabu súnwandan!<verse eid="PSA 52:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 52:9" />Bungiu, neteingirubadibu súnwandan</para>
  <para style="q" vid="PSA 52:9">luagu katei le adüga báalibei;</para>
  <para style="q" vid="PSA 52:9">nagurabahaba lidan biri hagibugiñe bánigu,</para>
  <para style="q" vid="PSA 52:9">ladüga wéiriti bubuidun.<verse eid="PSA 52:9" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" sid="PSA 53" />
  <para style="s1">Hariban gürigia</para>
  <para style="r">(<ref loc="PSA 14">Sal 14</ref>)</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 53:1" />Ha ibidiouguabaña aau haritaguatiña luagu ua lan Bungiu;</para>
  <para style="q" vid="PSA 53:1">gádeihaña sun hagía;</para>
  <para style="q" vid="PSA 53:1">adügaaña burí katei hanarimeti luriban;</para>
  <para style="q" vid="PSA 53:1">úaaña adügütiña buiti!<verse eid="PSA 53:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 53:2" />Ariha lumutiña Aburemei gürigia siélugiñe</para>
  <para style="q" vid="PSA 53:2">lun larihin anhein anihein lubéi aban hádangiñe</para>
  <para style="q" vid="PSA 53:2">le gunfurandati lun láluahani Bungiu.<verse eid="PSA 53:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 53:3" />Gama lumoun sun hagía, ragǘ hamaali üma le wuribabei;</para>
  <para style="q" vid="PSA 53:3">sun hagía gádeihaña.</para>
  <para style="q" vid="PSA 53:3">Úaaña adügütiña le buídubei!</para>
  <para style="q" vid="PSA 53:3">Úati ni íbini aban!<verse eid="PSA 53:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 53:4" />Úati gunfuranda hamá ha adaagubaña wuribani,</para>
  <para style="q" vid="PSA 53:4">ha éigibaliña numutuniña kei heigin fein,</para>
  <para style="q" vid="PSA 53:4">ha magúarunbalin liri Aburemei.<verse eid="PSA 53:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 53:5" />Hadadagaruba lau anufudei laume sun mébuna lan</para>
  <para style="q" vid="PSA 53:5">ladüga chagagua lumuti Bungiu habu áganiñu.</para>
  <para style="q" vid="PSA 53:5">Herederuba lau busiganu ladüga maha lan Bungiu houn.<verse eid="PSA 53:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 53:6" />Ñǘbuindügü láamuga lesefurun Ísüraeli</para>
  <para style="q" vid="PSA 53:6">lídangiñe wübü Sión!</para>
  <para style="q" vid="PSA 53:6">Danme lasansiruni Bungiu habunurun lumutuniña,</para>
  <para style="q" vid="PSA 53:6">hagundaaruba ladügawagun Hakobu,</para>
  <para style="q" vid="PSA 53:6">hama sun Ísüraelina.<verse eid="PSA 53:6" /></para>
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" sid="PSA 54" />
  <para style="s1">Afurieiduni amuriahei lídehan Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 54:1" />Sefubána, Nubungiute, luagu biri!</para>
  <para style="q" vid="PSA 54:1">Ageindaguabá náugiñe lau bubafu!<verse eid="PSA 54:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 54:2" />Aganbabéi nafurieidun Nubungiute;</para>
  <para style="q" vid="PSA 54:2">ruba arigei lun nererun;<verse eid="PSA 54:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 54:3" />ladüga añaha gürigia terencha ha hanarimetiña</para>
  <para style="q" vid="PSA 54:3">iñuragua houngua nuagun,</para>
  <para style="q" vid="PSA 54:3">ani busentiña háfarunina hilagubei.</para>
  <para style="q" vid="PSA 54:3">Míchugun hamuti Bungiu ubaraü!<verse eid="PSA 54:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 54:4" />Lau sun lira, íderagua lumutina Bungiu;</para>
  <para style="q" vid="PSA 54:4">areida lumutina Bungiu lau ibagari.<verse eid="PSA 54:4" /></para>
  <para style="q">
    <verse number="5-6" style="v" sid="PSA 54:5-6" />Ladügüba Bungiu lun lagarabaagun</para>
  <para style="q" vid="PSA 54:5-6">hariban guánarügü náganiñu hawagun.</para>
  <para style="b" vid="PSA 54:5-6" />
  <para style="q" vid="PSA 54:5-6">Günringuabaña, Bungiu,</para>
  <para style="q" vid="PSA 54:5-6">ladüga buguya úaraguatibu!</para>
  <para style="q" vid="PSA 54:5-6">Nadagaragüdüba bun lau nugundan,</para>
  <para style="q" vid="PSA 54:5-6">neremuhaba giñe lun biri, ladüga bubuidun,<verse eid="PSA 54:5-6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 54:7" />ladüga sefu báadina lídangiñe sun nidiheri,</para>
  <para style="q" vid="PSA 54:7">ani ariha naali giñe heferidirun náganiñu.<verse eid="PSA 54:7" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" sid="PSA 55" />
  <para style="s1">Lafurieidun aban éibaahouti</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 55:1" />Nubungiute, aganbabéi nafurieidun;</para>
  <para style="q" vid="PSA 55:1">míchigaba mabahüdüni lun nayumuragun:<verse eid="PSA 55:1" /></para>
  <para style="q">
    <verse number="2-3" style="v" sid="PSA 55:2-3" />Beresebá nau, óunababana;</para>
  <para style="q" vid="PSA 55:2-3">wátina buagu lidan nidiheri.</para>
  <para style="q" vid="PSA 55:2-3">Adadagaragüda lumutina lumalali nágani</para>
  <para style="q" vid="PSA 55:2-3">luma hagúaragun wuribatiña.</para>
  <para style="b" vid="PSA 55:2-3" />
  <para style="q" vid="PSA 55:2-3">Buíngüda hamaadina lau idiheri,</para>
  <para style="q" vid="PSA 55:2-3">ábürühatiña nuagun lau anarimeni.<verse eid="PSA 55:2-3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 55:4" />Ádühatu nanigi nidan le nanufude;</para>
  <para style="q" vid="PSA 55:4">ábürüha ligía lanarime anufudei luéi óunweni nuagun.<verse eid="PSA 55:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 55:5" />Beluhali aban lanarime anufudei nidoun;</para>
  <para style="q" vid="PSA 55:5">nadadagaruña lau anufudei!<verse eid="PSA 55:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 55:6" />Nariñagati:</para>
  <para style="q" vid="PSA 55:6">«Garünadügü au hamuga kei unhun;</para>
  <para style="q" vid="PSA 55:6">aba hamuga náhamarun lun nemeraagun.<verse eid="PSA 55:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 55:7" />Nídiña hamuga dise lidan náhamahan;</para>
  <para style="q" vid="PSA 55:7">nerederuña hamuga aganóua lidan fulasu mageirawati.<verse eid="PSA 55:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 55:8" />Néibaaguña hamuga furese</para>
  <para style="q" vid="PSA 55:8">aramudagua luéi lere garabali</para>
  <para style="q" vid="PSA 55:8">luma luriban dan».<verse eid="PSA 55:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 55:9" />Günringuabaña Aburemei,</para>
  <para style="q" vid="PSA 55:9">fánreinguabei hererun,</para>
  <para style="q" vid="PSA 55:9">ladüga marihintina amu katei luéi</para>
  <para style="q" vid="PSA 55:9">anarimeni luma gáganiguaü,<verse eid="PSA 55:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 55:10" />geyeguhaña lau uburugu áriebu wéyuagu.</para>
  <para style="q" vid="PSA 55:10">Anihein wuribani luma gáganiguaü fulasurugu:</para>
  <para style="q" vid="PSA 55:10">Anihein féridiguaü ñein;<verse eid="PSA 55:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 55:11" />buin liña burí lémeri lau</para>
  <para style="q" vid="PSA 55:11">anarimeni luma iyeeni!<verse eid="PSA 55:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 55:12" />Anhein hamuga ábanti ágani anabagubalina,</para>
  <para style="q" vid="PSA 55:12">nawanduñein hamuga lira,</para>
  <para style="q" vid="PSA 55:12">anhein hamuga ábanti le iyereehabúbei nun</para>
  <para style="q" vid="PSA 55:12">iñuragubei lungua nuagun,</para>
  <para style="q" vid="PSA 55:12">naramudaguña hamuga giñe luéi.<verse eid="PSA 55:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 55:13" />Buguya guánarügü adügübalin lira,</para>
  <para style="q" vid="PSA 55:13">buguya le meni numada,</para>
  <para style="q" vid="PSA 55:13">buguya numada le tímatimaati,<verse eid="PSA 55:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 55:14" />le burí meha úmabei nóundaragua lúbiñe Bungiu</para>
  <para style="q" vid="PSA 55:14">lun wayanuhan keisi umadagu,</para>
  <para style="q" vid="PSA 55:14">buguya le meha burí úmabei néibuga hadan saragu gürigia.<verse eid="PSA 55:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 55:15" />Ábürühala óunweni hawagun náganiñu!</para>
  <para style="q" vid="PSA 55:15">Ábürüha hamá wínwanñu lidoun umúahaü,</para>
  <para style="q" vid="PSA 55:15">ladüga anihein wuribani tidan hanigi!<verse eid="PSA 55:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 55:16" />Anhein au náwarubei Bungiu;</para>
  <para style="q" vid="PSA 55:16">lesefurubadina Nabureme.<verse eid="PSA 55:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 55:17" />Namumehaba ayahua aume binaafin,</para>
  <para style="q" vid="PSA 55:17">rábounweyu luma áriebu,</para>
  <para style="q" vid="PSA 55:17">ani laganbubei numalali.<verse eid="PSA 55:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 55:18" />Lesefurubadina wuriburugu;</para>
  <para style="q" vid="PSA 55:18">areidaleime nibagari</para>
  <para style="q" vid="PSA 55:18">íbini anhein gibe habéi náganiñu.<verse eid="PSA 55:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 55:19" />Bungiu le arúeihabei sun dan,</para>
  <para style="q" vid="PSA 55:19">laganbubadina, ani lǘnabudaguagüdübaña;</para>
  <para style="q" vid="PSA 55:19">ladüga masansirun hamuti hagaburi</para>
  <para style="q" vid="PSA 55:19">manufudetiña giñe luéi Bungiu;<verse eid="PSA 55:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 55:20" />Iñura hamuti háhabu kóntüra hamadagu;</para>
  <para style="q" vid="PSA 55:20">magunfuliruntiña lau hadaradun le lánina umadaguaü.<verse eid="PSA 55:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 55:21" />Ñulugüda hamuti burí hererun sügǘ lau beru,</para>
  <para style="q" vid="PSA 55:21">gama lumoun sun hasaminan luagun wuribu;</para>
  <para style="q" vid="PSA 55:21">yúsutiña dimurei burí le ñuluti sügǘ lau garaba,</para>
  <para style="q" vid="PSA 55:21">mama amu katei tuéi eféin hamanatu.<verse eid="PSA 55:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 55:22" />Ígirabei bidiheri lun Aburemei,</para>
  <para style="q" vid="PSA 55:22">ábame líderagunibu;</para>
  <para style="q" vid="PSA 55:22">mígirunbei lun héiguadun gürigia</para>
  <para style="q" vid="PSA 55:22">ha gaganbadibaña lun.<verse eid="PSA 55:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 55:23" />Nubungiute,</para>
  <para style="q" vid="PSA 55:23">ha gáfarahadibaña ye hagía,</para>
  <para style="q" vid="PSA 55:23">mabagaridunhabei ni lamidan habagari;</para>
  <para style="q" vid="PSA 55:23">bábürügüdübaña lidoun umúahaü,</para>
  <para style="q" vid="PSA 55:23">ánheinti au hemenigitina buagu.<verse eid="PSA 55:23" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" sid="PSA 56" />
  <para style="s1">Afurieiduni lánina emenigini</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 56:1" />Gudemená bun Nubungiute,</para>
  <para style="q" vid="PSA 56:1">ladüga añahein gürigia éibaahatina,</para>
  <para style="q" vid="PSA 56:1">súnwandan hábürühaña nuagun aba hasufuriragüdünina.<verse eid="PSA 56:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 56:2" />Súnwandan héibaahañadina náganiñu,</para>
  <para style="q" vid="PSA 56:2">gíbetiña ha ábürühabaña nuagun lau pantaü.<verse eid="PSA 56:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 56:3" />Buagu nemenigida, lidan nanufude.<verse eid="PSA 56:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 56:4" />Hemenigitina luagu Bungiu alawahanei lererun:</para>
  <para style="q" vid="PSA 56:4">Hemenigitina luagu Bungiu ani manufudetina.</para>
  <para style="q" vid="PSA 56:4">Kábagia gayara hamá gürigia adüga nau?<verse eid="PSA 56:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 56:5" />Súnwandan habuleseirunina lau hererun;</para>
  <para style="q" vid="PSA 56:5">luágurügüñein hadügün wuribani nun hasaminara.<verse eid="PSA 56:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 56:6" />Heredera aramudagua lidan sun fulasu</para>
  <para style="q" vid="PSA 56:6">asigirei nugudárigi,</para>
  <para style="q" vid="PSA 56:6">agurabei dan lun háfarunina hilagubei.<verse eid="PSA 56:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 56:7" />Hesefuruba funagia luéi hariban guánarügü?</para>
  <para style="q" vid="PSA 56:7">Bungiu, ǘnabugüdabaña gürigia lau bigañi.<verse eid="PSA 56:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 56:8" />Abahüdeinabiñalin nanurahan;</para>
  <para style="q" vid="PSA 56:8">budá bumuti kada aban lídangiñe náguira.</para>
  <para style="q" vid="PSA 56:8">Odi mabürüdün bumuti funagia tidan biliburun?<verse eid="PSA 56:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 56:9" />Héibaaguba náganiñu</para>
  <para style="q" vid="PSA 56:9">danme le namuriahan ídemuei buma.</para>
  <para style="q" vid="PSA 56:9">Subudi numuti buidu</para>
  <para style="q" vid="PSA 56:9">luagu númagiñeñein lan Bungiu.<verse eid="PSA 56:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 56:10" />Afiñetina luagu Bungiu ani alawahanei lererun,</para>
  <para style="q" vid="PSA 56:10">afiñetina luagu Nabureme ani alawahanei lererun.<verse eid="PSA 56:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 56:11" />Afiñetina luagu Bungiu ani manufudetina,</para>
  <para style="q" vid="PSA 56:11">kábagia gayara hamá gürigia adüga nau?<verse eid="PSA 56:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 56:12" />Füramasei le nadügübei bun, Bungiu,</para>
  <para style="q" vid="PSA 56:12">nagunfulirubei buma lau burí eremuhani.<verse eid="PSA 56:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 56:13" />Ladüga sefu báadina lídangiñe óunweni,</para>
  <para style="q" vid="PSA 56:13">sefu báadina luéi néiguadun,</para>
  <para style="q" vid="PSA 56:13">lun néibugun lidan larugounga ibagari,</para>
  <para style="q" vid="PSA 56:13">lidan liñúarü Bungiu.<verse eid="PSA 56:13" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" sid="PSA 57" />
  <para style="s1">Afurieiduni amuriaheinei lídehan Bungiu</para>
  <para style="r">(<ref loc="PSA 108:1-5">Sal 108.1-5</ref>)</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 57:1" />Gudemená bun, Nubungiute,</para>
  <para style="q" vid="PSA 57:1">gudemená bun,</para>
  <para style="q" vid="PSA 57:1">ladüga bidan náluaha naramudagun.</para>
  <para style="q" vid="PSA 57:1">Busentina naramudagun lábugiñe barüna</para>
  <para style="q" vid="PSA 57:1">darí lásügürün denchaü.<verse eid="PSA 57:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 57:2" />Nagúahabei Bungiu le Íñugutimabei,</para>
  <para style="q" vid="PSA 57:2">ligía Bungiu le íderagubalina lidan sun katei.<verse eid="PSA 57:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 57:3" />Lóunahabei línsiñehabu luma linarün siélugiñe,</para>
  <para style="q" vid="PSA 57:3">ábame lesefurunina hawéi ha éibaahabalina lau igañi.<verse eid="PSA 57:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 57:4" />Geyegu haña áganiñu nau,</para>
  <para style="q" vid="PSA 57:4">busentiña héiginina kei liñún gáñitiña;</para>
  <para style="q" vid="PSA 57:4">ítara liña hari kei arufun tuma gimara;</para>
  <para style="q" vid="PSA 57:4">ítara tiña hañeñe kei aban eféin hamanatu.<verse eid="PSA 57:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 57:5" />Nubungiute, lóugiñeñadibu sielu;</para>
  <para style="q" vid="PSA 57:5">buin liña sun ubóu lau buéirigun!<verse eid="PSA 57:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 57:6" />Sétitiña náganiñu aban sádara nubá lun hábürügüdünina;</para>
  <para style="q" vid="PSA 57:6">chigatiña aban huyu lubá nugudi,</para>
  <para style="q" vid="PSA 57:6">gama lumoun hagía guánarügü éiguadubaña lidoun.<verse eid="PSA 57:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 57:7" />Aranseñutiña nanigi, Nubungiute;</para>
  <para style="q" vid="PSA 57:7">aranseñutiña nanigi lun teremuhan uremu bun.<verse eid="PSA 57:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 57:8" />Agaguduabá nuani;</para>
  <para style="q" vid="PSA 57:8">agagudúa humá, sun tuwuyeri árüpa;</para>
  <para style="q" vid="PSA 57:8">nagaguduba binaafingiua!<verse eid="PSA 57:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 57:9" />Nabureme nalawahabadibu lau uremu,</para>
  <para style="q" vid="PSA 57:9">haganagua gürigia hama burí néchanigu.<verse eid="PSA 57:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 57:10" />Ladüga wéiriti bínsiñehabu chülǘ sielu,</para>
  <para style="q" vid="PSA 57:10">chülüti binarün chülǘ lumoun sielu le díngubei.<verse eid="PSA 57:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 57:11" />Nubungiute lóugiñeñadibu sielu;</para>
  <para style="q" vid="PSA 57:11">buin liña sun ubóu lau buéirigun!<verse eid="PSA 57:11" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" sid="PSA 58" />
  <para style="s1">Laguarahóuniwa luagu irichaü</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 58:1" />Huguya le gabafubei,</para>
  <para style="q" vid="PSA 58:1">richati san hasiadihan,</para>
  <para style="q" vid="PSA 58:1">rutün san irichaü le inarüniti houn gürigia?<verse eid="PSA 58:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 58:2" />Uá, lubaragiñe lira lau luriban aritaguni huádigimarida;</para>
  <para style="q" vid="PSA 58:2">rutün lúgaaru lun anarimeni fulasurugu lau hóuserun.<verse eid="PSA 58:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 58:3" />Gádeitiña wuribatiña</para>
  <para style="q" vid="PSA 58:3">lúmagiñe turageirugugiñe háguchu;</para>
  <para style="q" vid="PSA 58:3">chararatiña marasualugutiña</para>
  <para style="q" vid="PSA 58:3">lúmagiñe lubaragiñe hágurahoun;<verse eid="PSA 58:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 58:4" />péisinitiña kei hewe;</para>
  <para style="q" vid="PSA 58:4">ítara haña kei aban hewe péisinitu</para>
  <para style="q" vid="PSA 58:4">to adügüboun kamá le maganbuntu ni kata,</para>
  <para style="q" vid="PSA 58:4">darutéi tarigei<verse eid="PSA 58:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 58:5" />luéi taganbuni lúyanute chu tau,</para>
  <para style="q" vid="PSA 58:5">le garumaagüdadibei animaalugu gáñitiña.<verse eid="PSA 58:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 58:6" />Nubungiute, áhalahabei hari!</para>
  <para style="q" vid="PSA 58:6">Bungiu, áhalahabei hari liñún ha!<verse eid="PSA 58:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 58:7" />Gumugua hamá kei duna le áwiyurubei;</para>
  <para style="q" vid="PSA 58:7">saü hamá kei híduru le adügürawaguti ǘmadarugu;<verse eid="PSA 58:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 58:8" />gumugua hamá kei wadabu lidan luguyerun,</para>
  <para style="q" vid="PSA 58:8">kei irahü le agüriaawaguti</para>
  <para style="q" vid="PSA 58:8">le marihingubeibalin larugounga!<verse eid="PSA 58:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 58:9" />Gemé hamá kei hiiyu lubaragiñe hasubudiruni;</para>
  <para style="q" vid="PSA 58:9">hulawagua hamá lau igañi kei híduru le wurigili.<note caller="1" style="f"><char style="fr" closed="false">58.9 </char><char style="ft" closed="false">Lóuguati furangu lan lidan Ebüréu.</char></note><verse eid="PSA 58:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 58:10" />Ha gúnfulibaña hagundaaruba lau lageindawagun haweigiñe;</para>
  <para style="q" vid="PSA 58:10">hadüdüragüdübei hagudi lidan hata gürigia salufuritiña!<verse eid="PSA 58:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 58:11" />Ábameti lariñawagún:</para>
  <para style="q" vid="PSA 58:11">«Anihein agañeiruni houn ha gúnfulibaña!</para>
  <para style="q" vid="PSA 58:11">Anihein aban Bungiu le aguseragüdübei ubouagu».<verse eid="PSA 58:11" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" sid="PSA 59" />
  <para style="s1">Aburemei wóuniribei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 59:1" />Nubungiute, sefubána hawéi náganiñu;</para>
  <para style="q" vid="PSA 59:1">sefubána hawéi ha agayuahabaña nuagu;<verse eid="PSA 59:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 59:2" />sefubána hawéi adügütiña wuribani!</para>
  <para style="q" vid="PSA 59:2">Sefubána hawéi gáfarahatiña!<verse eid="PSA 59:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 59:3" />Ladüga añahein gürigia gabafutiña</para>
  <para style="q" vid="PSA 59:3">agurabaha lun gayara lan háfarunina hilagubei.</para>
  <para style="b" vid="PSA 59:3" />
  <para style="q" vid="PSA 59:3">Nabureme, maduruntina houn, madügün au figóu;<verse eid="PSA 59:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 59:4" />madügüntina ni kata wuribati</para>
  <para style="q" vid="PSA 59:4">gama lumoun afuresehatiña lun hachubarun nuagun.</para>
  <para style="q" vid="PSA 59:4">Agaguduabá! Higabu nubaroun ani arihabá!<verse eid="PSA 59:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 59:5" />Buguya, Aburemei Suntigabafu,</para>
  <para style="q" vid="PSA 59:5">Habungiute Ísüraelina,</para>
  <para style="q" vid="PSA 59:5">agaguduabá béiguabaña gibe tubungiutegu;</para>
  <para style="q" vid="PSA 59:5">magudemeda hamá wuribatiña ha bun.<verse eid="PSA 59:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 59:6" />Giributiña áriebu, áwouheina kei ounli,</para>
  <para style="q" vid="PSA 59:6">aba hegeyedaguni uburugu;<verse eid="PSA 59:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 59:7" />hariñaga áfuriheina hakutaü hayumulugugiñe:</para>
  <para style="q" vid="PSA 59:7">«Úati kaba lan aganbawa!»<verse eid="PSA 59:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 59:8" />Gama lumoun buguya, Aburemei, éherahatibu hau;</para>
  <para style="q" vid="PSA 59:8">adügatibu bula hau gibe tubungiutegu ha.<verse eid="PSA 59:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 59:9" />Aramudaguñu nuba bóubawagu, Nubungiute,</para>
  <para style="q" vid="PSA 59:9">ladüga buguya nérebei, le óunigirubalina.<verse eid="PSA 59:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 59:10" />Liábiba Bungiu le hínsiñehabubei nun nubaroun;</para>
  <para style="q" vid="PSA 59:10">larihagüdübei heferidirun náganiñu nun.<verse eid="PSA 59:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 59:11" />Magudemeda hamá bun,</para>
  <para style="q" vid="PSA 59:11">mabulieidagun hamaamuga numutuniña,</para>
  <para style="q" vid="PSA 59:11">chagaguagüdabaña lau bubafu ani ǘnabugüdabañame.</para>
  <para style="q" vid="PSA 59:11">Bungiu óunigirubalina!<verse eid="PSA 59:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 59:12" />Afigouhatiña lidan sun le hariñagun;</para>
  <para style="q" vid="PSA 59:12">ragülaña hapantan guánarügü luma liyeeni háfiñurun!<verse eid="PSA 59:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 59:13" />Gumuguagüdabaña, gumuguagüdabaña lau bigañi!</para>
  <para style="q" vid="PSA 59:13">Gumugua hamá!</para>
  <para style="q" vid="PSA 59:13">Subudiwalá luagu Bungiu lan urúeibei hadan lánigu Hakobu</para>
  <para style="q" vid="PSA 59:13">darí lagumuhóun larigei ubóu!<verse eid="PSA 59:13" /></para>
  <para style="q">
    <verse number="14-15" style="v" sid="PSA 59:14-15" />Danme le hagiribudun áriebu áwouheina kei ounli,</para>
  <para style="q" vid="PSA 59:14-15">éibugeinei fulasu áluaha éigini,</para>
  <para style="q" vid="PSA 59:14-15">hagúarahaba ladüga lilouguan hadarirun.<verse eid="PSA 59:14-15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 59:16" />Ánheinti au, neremuhaba uremu bun binaafin,</para>
  <para style="q" vid="PSA 59:16">nagúarahaba adimureha luagu bubafu luma bínsiñehabu,</para>
  <para style="q" vid="PSA 59:16">ladüga buguya óunigirubalina,</para>
  <para style="q" vid="PSA 59:16">bóubawagu naramudagua lidan nidiheri.<verse eid="PSA 59:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 59:17" />Neremuhaba uremu bun, Nubungiute,</para>
  <para style="q" vid="PSA 59:17">buguya nérebei, buguya óunigirubalina;</para>
  <para style="q" vid="PSA 59:17">buguya Bungiu le hínsiñehabubei nun!<verse eid="PSA 59:17" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" sid="PSA 60" />
  <para style="s1">Afurieiduni amuriaha ídemuei íñugiñeti</para>
  <para style="r">(<ref loc="PSA 108:6-13">Sal 108.6-13</ref>)</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 60:1" />Fui baadiwa lidan bigañi, Bungiu, günringua báadiwa.</para>
  <para style="q" vid="PSA 60:1">Águyugüdabei were woun!<verse eid="PSA 60:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 60:2" />Adügatibu lun ladadagarun múa, daragua ligia;</para>
  <para style="q" vid="PSA 60:2">guentó darubei líhunren, luéi lagululudun.<verse eid="PSA 60:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 60:3" />Áfagagüdabaaña bumutuniña lidere burí óuchawaguni;</para>
  <para style="q" vid="PSA 60:3">rúhadibu aban diwéin to lǘlügüdatu aau woun;<verse eid="PSA 60:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 60:4" />guentó ruba aban seini houn ha inebehabubaña bun,</para>
  <para style="q" vid="PSA 60:4">lun hesefurun tuéi gimara!<verse eid="PSA 60:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 60:5" />Óunababawa, sefubáwa lau bubafu!</para>
  <para style="q" vid="PSA 60:5">Sefubáña ha hínsiñebaña bun!<verse eid="PSA 60:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 60:6" />Ariñagaali Bungiu tidan litenpulun:</para>
  <para style="q" vid="PSA 60:6">«Lauba nugundan nafanreinraguei Sikemü,</para>
  <para style="q" vid="PSA 60:6">afanreinhaneime Sukotu!<verse eid="PSA 60:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 60:7" />Nani Galaadü luma Manasési;</para>
  <para style="q" vid="PSA 60:7">Éfürain ligía bunidi le adouragubei lau nichügü;</para>
  <para style="q" vid="PSA 60:7">Hudá ligía nubadunbei le aubei nagumadiha;<verse eid="PSA 60:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 60:8" />Moabü ligía dabarasi le ídanbei nachibagua nungua;</para>
  <para style="q" vid="PSA 60:8">níchuguboun nigeidin luagu Edomu;</para>
  <para style="q" vid="PSA 60:8">nagúarahaba luagu nagañeiruniña Filistéana!»<verse eid="PSA 60:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 60:9" />Kaba san anügana lidoun uburugu le baríeiruabei?</para>
  <para style="q" vid="PSA 60:9">Kaba san alidihana chülǘ Edomu?<verse eid="PSA 60:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 60:10" />Ladüga buguya Bungiu, fui baadiwa,</para>
  <para style="q" vid="PSA 60:10">máfuridunhadibu hama wasudaranigu!<verse eid="PSA 60:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 60:11" />Íderaguabawa hawagu wáganiñu,</para>
  <para style="q" vid="PSA 60:11">ladüga mebegiti lídehan gürigia.<verse eid="PSA 60:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 60:12" />Lau lídehan Bungiu,</para>
  <para style="q" vid="PSA 60:12">wadügüba burí katei wéinamuti</para>
  <para style="q" vid="PSA 60:12">laburechagubaña Bungiu wáganiñu!<verse eid="PSA 60:12" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" sid="PSA 61" />
  <para style="s1">Afiñeni luagu lóunigihan Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 61:1" />Nubungiute, aganbabéi nagúarahan lau igarigu,</para>
  <para style="q" vid="PSA 61:1">tenibá lun nafurieidun!<verse eid="PSA 61:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 61:2" />Wátina buagu lúmagiñe</para>
  <para style="q" vid="PSA 61:2">lagumuhóun larigeirugu ubóu,</para>
  <para style="q" vid="PSA 61:2">ladüga edebilideinatiña nanigi</para>
  <para style="q" vid="PSA 61:2">sefubána lau bíchugunina ligibuagu aban liñun-agei dübü,<verse eid="PSA 61:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 61:3" />buguya naramudaguagülebei.</para>
  <para style="q" vid="PSA 61:3">Ítara biña kei aban wáyelesi le héreti</para>
  <para style="q" vid="PSA 61:3">le esefurubalina hawéi náganiñu!<verse eid="PSA 61:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 61:4" />Busentina naganóun búbiñe lun sun dan,</para>
  <para style="q" vid="PSA 61:4">daruguañu nau lábugiñe barüna.<verse eid="PSA 61:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 61:5" />Ladüga buguya, Nubungiute, aganba baali nani füramasei,</para>
  <para style="q" vid="PSA 61:5">ru baali giñe halagante gürigia ha inebehabubaña lun biri.<verse eid="PSA 61:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 61:6" />Ruba ibagari le migifeti lun urúei;</para>
  <para style="q" vid="PSA 61:6">lun gabagari lan saragu irumu,<verse eid="PSA 61:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 61:7" />larúeihame súnwandan lau babinirun.</para>
  <para style="q" vid="PSA 61:7">Góunigibei lau bínsiñehabu luma búaragun;<verse eid="PSA 61:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 61:8" />ítara luba nalawahani biri lun súnwandan,</para>
  <para style="q" vid="PSA 61:8">gúnfulineime nidaradun sagü weyu.<verse eid="PSA 61:8" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" sid="PSA 62" />
  <para style="s1">Búngiurügüñein aramudaguagülei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 62:1" />Lídanrügüñein Bungiu nadarira darangilaü;</para>
  <para style="q" vid="PSA 62:1">lúmagiñerügüñein liabin nesefurun.<verse eid="PSA 62:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 62:2" />Ligíarügüñein esefurana aramudalana giñe;</para>
  <para style="q" vid="PSA 62:2">méiguadunbadina lubeiti</para>
  <para style="q" vid="PSA 62:2">ladüga Bungiu lan naramudaguagülebei.<verse eid="PSA 62:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 62:3" />Ídaame san hígirei hañawarihan nun</para>
  <para style="q" vid="PSA 62:3">áluaha hágurunina ǘnabun</para>
  <para style="q" vid="PSA 62:3">kamá hamuga aban touba muna le ábürühati</para>
  <para style="q" vid="PSA 62:3">odi aban lan baríeiru le héiguamemeeli múarugun?<verse eid="PSA 62:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 62:4" />Luágurügüñein hábürügüdünina haritagua;</para>
  <para style="q" vid="PSA 62:4">iyeeni ligía lueirin-ágeibei hagundan:</para>
  <para style="q" vid="PSA 62:4">Buiti hadimurehan nuagu lau hayuma,</para>
  <para style="q" vid="PSA 62:4">gama lumoun íñaragua hamutina lau haritagun.<verse eid="PSA 62:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 62:5" />Lúmarügüñein Bungiu nadarira darangilaü;</para>
  <para style="q" vid="PSA 62:5">ani lúmagiñe liabin nemenigin.<verse eid="PSA 62:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 62:6" />Ligíarügüñein esefurana ani góunigilana;</para>
  <para style="q" vid="PSA 62:6">méiguadunbadina, ladüga ligía naramudaguagülebei.<verse eid="PSA 62:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 62:7" />Lúmagiñe Bungiu liabin nesefurun luma ninebese;</para>
  <para style="q" vid="PSA 62:7">ligía óunigirubalina aramudalana.<verse eid="PSA 62:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 62:8" />Numutuniña, afiñe humá luagu Bungiu súnwandan!</para>
  <para style="q" vid="PSA 62:8">Hadimureha lidan furíeigi lau sun hemenigin!</para>
  <para style="q" vid="PSA 62:8">Bungiu waramudaguagülebei!<verse eid="PSA 62:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 62:9" />Ni kata gürigia,</para>
  <para style="q" vid="PSA 62:9">dandu ha gudemebaña kei ha rísibaña ni kátañanu;</para>
  <para style="q" vid="PSA 62:9">ánhaña amisurahóua biángubei hagía lidan aban balansu úara,</para>
  <para style="q" vid="PSA 62:9">huálibaña sügǘ lau ni kata.<verse eid="PSA 62:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 62:10" />Míchiga huméi hafiñen luagu anarimeni;</para>
  <para style="q" vid="PSA 62:10">manaagua humá hungua lau íweruhani!</para>
  <para style="q" vid="PSA 62:10">Anhaün arisida, míchiga huméi hemenigin luagun seinsu.<verse eid="PSA 62:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11-12" style="v" sid="PSA 62:11-12" />Aganba naali katei le ariñaga láalibei Bungiu</para>
  <para style="q" vid="PSA 62:11-12">sügǘ lau aban wéiyaasu:</para>
  <para style="q" vid="PSA 62:11-12">Luagu lani lan Bungiu ubafu luma ínsiñeni,</para>
  <para style="q" vid="PSA 62:11-12">ani fayei lániña sun gürigia úaragua luma katei le hadügübei.<verse eid="PSA 62:11-12" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" sid="PSA 63" />
  <para style="s1">Bungiu tugundanbei uani</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 63:1" />Nabureme, buguya Nubungiutebei,</para>
  <para style="q" vid="PSA 63:1">wéiriti lanarime náluahanibu.</para>
  <para style="q" vid="PSA 63:1">Mágürabutu nuani bun,</para>
  <para style="q" vid="PSA 63:1">sun núgubu megei lumutibu,</para>
  <para style="q" vid="PSA 63:1">ítara kei lemegeiruni múa mábeiti duna.<verse eid="PSA 63:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 63:2" />Busentina narihinibu búbiñe,</para>
  <para style="q" vid="PSA 63:2">lun naríaguni bubafu luma buéirigun,<verse eid="PSA 63:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 63:3" />gebegiti bínsiñehabu sügǘ lau ibagari!</para>
  <para style="q" vid="PSA 63:3">Neremuhaba bun lau niyuma;<verse eid="PSA 63:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 63:4" />nalawahabadibu lidan sun nibagari,</para>
  <para style="q" vid="PSA 63:4">ani niñurubei núhabu afurieida bun.<verse eid="PSA 63:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 63:5" />Nerederuba gufurumañu kei aban le gadan lumuti,</para>
  <para style="q" vid="PSA 63:5">aban fedu le ñein lumuti éigini semeeti,</para>
  <para style="q" vid="PSA 63:5">leremuhame niyuma bun lau saragu ugundani.<verse eid="PSA 63:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 63:6" />Dan le róunhadina áriebu</para>
  <para style="q" vid="PSA 63:6">aba naritagun samina au buagun;<verse eid="PSA 63:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 63:7" />ladüga buguya íderagubalina.</para>
  <para style="q" vid="PSA 63:7">Gúndaatina lábugiñe barüna!<verse eid="PSA 63:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 63:8" />Lídanñein aban sun nibagari buma;</para>
  <para style="q" vid="PSA 63:8">mígiragüdün lumutina búhabu le bóunwenren.<verse eid="PSA 63:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 63:9" />Ha áluahabaña háfarunina,</para>
  <para style="q" vid="PSA 63:9">hábürühaba lurageirugun umúahaü;<verse eid="PSA 63:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 63:10" />háfarawaguba tau eféin,</para>
  <para style="q" vid="PSA 63:10">ábame héigaguniña ounli áraabuna!<verse eid="PSA 63:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 63:11" />Ánheinti urúei lagundaaruba lidan Bungiu,</para>
  <para style="q" vid="PSA 63:11">heremuhaba sun ha áfiñurubaña luagu,</para>
  <para style="q" vid="PSA 63:11">ánhañati ha eyeehabaña, ladouruba hayuma.<verse eid="PSA 63:11" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" sid="PSA 64" />
  <para style="s1">Afurieiduni amuriaha ounigirúni hawéi áganiñu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 64:1" />Nubungiute, aganbabéi numalali lidan nafurieidun;</para>
  <para style="q" vid="PSA 64:1">aramudabéi nibagari hawéi hanarime áganiñu.<verse eid="PSA 64:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 64:2" />Aramudabana hawéi wuribatiña</para>
  <para style="q" vid="PSA 64:2">luma luéi haransehan le aramudaguabei;</para>
  <para style="q" vid="PSA 64:2">sefubána luéi heledegun wuribatiña;<verse eid="PSA 64:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 64:3" />ha ayaraahabarun hañeñe kei eféin</para>
  <para style="q" vid="PSA 64:3">ígiragüda hagía dimurei péisiniti kei gimara.<verse eid="PSA 64:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 64:4" />Chǘguatiña luagun le madurunbei</para>
  <para style="q" vid="PSA 64:4">lídangiñe haramudaguagüle;</para>
  <para style="q" vid="PSA 64:4">chǘguatiña le sódiniti manufudeuga.<verse eid="PSA 64:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 64:5" />Rútiña gurasu hóuniwagua lun hadügüni le wuribabei;</para>
  <para style="q" vid="PSA 64:5">aransehatiña lun hesetirun sádara aramudaguatu</para>
  <para style="q" vid="PSA 64:5">ani haritaguatiñati luagu úabei lan arihitiña.<verse eid="PSA 64:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 64:6" />Luagu úabei lan álügüdahati libügürü</para>
  <para style="q" vid="PSA 64:6">wuribani burí le hadügübei.</para>
  <para style="q" vid="PSA 64:6">Gama lumoun le subudihabúbei</para>
  <para style="q" vid="PSA 64:6">lun lilulin-agei lisaminan gürigia,</para>
  <para style="q" vid="PSA 64:6">lálügüdahaba libügürü.<verse eid="PSA 64:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 64:7" />Límiragubaña Bungiu tau ligimaran,</para>
  <para style="q" vid="PSA 64:7">líbaagubaña sódinirügü;<verse eid="PSA 64:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 64:8" />hábürühaba luagu hererun guánarügü,</para>
  <para style="q" vid="PSA 64:8">ábame hadügün sun ha arihitiña bula hau.<verse eid="PSA 64:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 64:9" />Ábameti inebe lan Bungiu houn sun gürigia,</para>
  <para style="q" vid="PSA 64:9">ábame hadimurehan luagu burí katei le ladügübei;</para>
  <para style="q" vid="PSA 64:9">ábame gunfuranda hamani katei le burí ladügübei Bungiu.<verse eid="PSA 64:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 64:10" />Hagundaaruba gürigia ha buídubaña lidan Aburemei</para>
  <para style="q" vid="PSA 64:10">háluahaba giñe haramudagun lóubawagu,</para>
  <para style="q" vid="PSA 64:10">gufurumabaña sun ha harumabaña aritagun.<verse eid="PSA 64:10" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" sid="PSA 65" />
  <para style="s1">Gadünati Bungiu lalawahóuniwa</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 65:1" />Lubungiute Sión,</para>
  <para style="q" vid="PSA 65:1">gadünatibu balawahóuniwa!</para>
  <para style="q" vid="PSA 65:1">Yuuti lun lagunfulirúniwa füramasei bun<verse eid="PSA 65:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 65:2" />ladüga aganba bumuti afurieiduni!</para>
  <para style="b" vid="PSA 65:2" />
  <para style="q" vid="PSA 65:2">Ñǘbuintiña sun gürigia bumoun.<verse eid="PSA 65:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 65:3" />Héreti wariban sügǘ wau,</para>
  <para style="q" vid="PSA 65:3">gama lumoun feruduna bumuti wafigoun.<verse eid="PSA 65:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 65:4" />Fuleseiwatiña gürigia ha banúadirubaña</para>
  <para style="q" vid="PSA 65:4">aba banügüniña aganóua bubadu,</para>
  <para style="q" vid="PSA 65:4">tidan burí rumu to búbiñeboun.</para>
  <para style="q" vid="PSA 65:4">Buíngüdabawa lau burí lubuidun-agei katei le búbiñebei,</para>
  <para style="q" vid="PSA 65:4">lau burí abiniruni le tídanbei buban to sánduboun!<verse eid="PSA 65:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 65:5" />Bungiu wesefuragüle,</para>
  <para style="q" vid="PSA 65:5">óunaba bumutiwa lau burí katei richati le badügübei;</para>
  <para style="q" vid="PSA 65:5">hemenigitiña sun lílana ubóu buagu;</para>
  <para style="q" vid="PSA 65:5">labu giñe barana le dísebei;<verse eid="PSA 65:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 65:6" />ágüdaha bumuti burí áraabu deregüdagu</para>
  <para style="q" vid="PSA 65:6">lau bubafu luma bere.<verse eid="PSA 65:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 65:7" />Gáluma bumuti lahuuhan lugudi barana</para>
  <para style="q" vid="PSA 65:7">luma hachagaragun gürigia;<verse eid="PSA 65:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 65:8" />íbini ha aganóubaña lidan fulasu díseti libiti ubóu,</para>
  <para style="q" vid="PSA 65:8">adadagaratiña dan le harihini katei buíduburiti le badügübei;</para>
  <para style="q" vid="PSA 65:8">wáguawati lau ugundani buagu</para>
  <para style="q" vid="PSA 65:8">lúmagiñe aban louba ubóu lun luagun le aban.<verse eid="PSA 65:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 65:9" />Góunigi bumuti múa lau báhuyagüdün luagun;</para>
  <para style="q" vid="PSA 65:9">aba babuiduragüdüni lun ábunaguni;</para>
  <para style="q" vid="PSA 65:9">wéinamugüda bumuti lídibu türigu lau báturaguni.</para>
  <para style="q" vid="PSA 65:9">Ítara liña baranseruni ichari!<verse eid="PSA 65:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 65:10" />Dǘdügüda bumuti múa,</para>
  <para style="q" vid="PSA 65:10">buíngüdabei burí múa awouhóuaali lau duna;</para>
  <para style="q" vid="PSA 65:10">ñulugüda bumuti lau huya gíbeti</para>
  <para style="q" vid="PSA 65:10">biní bumuti burí le alubahóubei lídangiñe.<verse eid="PSA 65:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 65:11" />Buíngüda bumuti irumu lau abiniruni</para>
  <para style="q" vid="PSA 65:11">gíbeti alubahani le líchugubei bareini;<verse eid="PSA 65:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 65:12" />íbini sagadi le lídanbei fulasu mageirawati hilumati</para>
  <para style="q" vid="PSA 65:12">wende burí áraabu,<verse eid="PSA 65:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 65:13" />buin liña áraabu hau ibiñanigu,</para>
  <para style="q" vid="PSA 65:13">anihein saragu türigu lidan fulasu wayati,</para>
  <para style="q" vid="PSA 65:13">eremuhatiña súngubei agúaraha hagía lau ugundani!<verse eid="PSA 65:13" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" sid="PSA 66" />
  <para style="s1">Ma lubuidun sun le badügübei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 66:1" />Sun lílana fulasu alawaha huméi Bungiu lau ugundani;<verse eid="PSA 66:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 66:2" />wa humá uremu lun Bungiu le wéirigubei;</para>
  <para style="q" vid="PSA 66:2">heremuha uremu burí wéiriguti lun;<verse eid="PSA 66:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 66:3" />ariñaga humá lun Bungiu:</para>
  <para style="q" vid="PSA 66:3">«Buíduburiti katei le badügübei.</para>
  <para style="q" vid="PSA 66:3">Lau lueirin bubafu,</para>
  <para style="q" vid="PSA 66:3">ábürühatiña báganiñu lau anufudei bigibugiñe;<verse eid="PSA 66:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 66:4" />huduguatiña sun gürigia bun,</para>
  <para style="q" vid="PSA 66:4">eremuha hagía burí uremu bun».<verse eid="PSA 66:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 66:5" />Higougu harihei le ladügübei Bungiu,</para>
  <para style="q" vid="PSA 66:5">lubuidun burí katei le ladügübei hawagu wügüriña.<verse eid="PSA 66:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 66:6" />Saliguagüda lumuti barana lun múame le mábeiti,</para>
  <para style="q" vid="PSA 66:6">aba hánhiñuraguni wagüchagu duna éibugeina;</para>
  <para style="q" vid="PSA 66:6">gunda wamá lidan Bungiu!<verse eid="PSA 66:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 66:7" />Arúeihati súnwandan lau lubafu;</para>
  <para style="q" vid="PSA 66:7">aríaaha lumutiña sun gürigia lidan sun fulasu</para>
  <para style="q" vid="PSA 66:7">luéi hiñuragun wuribatiña houngua hawagun.<verse eid="PSA 66:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 66:8" />Néchanigu, alawaha huméi Wabungiute!</para>
  <para style="q" vid="PSA 66:8">Aganbagüda huméi heremuhan lun!<verse eid="PSA 66:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 66:9" />Ladüga ágüdaha láadiwa lau ibagari;</para>
  <para style="q" vid="PSA 66:9">mígirun lágidiwa lun wábürühan.<verse eid="PSA 66:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 66:10" />Wabungiute, hóuchagua báadiwa,</para>
  <para style="q" vid="PSA 66:10">aranse báadiwa kei pülata!<verse eid="PSA 66:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 66:11" />Ábürügüda báadiwa tidoun sádara;</para>
  <para style="q" vid="PSA 66:11">barügüdaadibu óunwenbu ihürügu woun;<verse eid="PSA 66:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 66:12" />ígiratibu lun ladügüraguniwa aban furumiñeguarügü;</para>
  <para style="q" vid="PSA 66:12">sügühadiwa lídangiñe duna luma watu gemeti,</para>
  <para style="q" vid="PSA 66:12">gama lumoun rúhadibu awaraguni woun guentó.<verse eid="PSA 66:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 66:13" />Nebeluruba búbiñoun</para>
  <para style="q" vid="PSA 66:13">ábame nágudahan idewesei bigibugiñe,</para>
  <para style="q" vid="PSA 66:13">ítara luba nagunfuliruni nani füramasei,<verse eid="PSA 66:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 66:14" />füramasei le nadügübei bun</para>
  <para style="q" vid="PSA 66:14">dan meha lídanñadina lubéi denchaü.<verse eid="PSA 66:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 66:15" />Nágudahaba animaalu dibunetiña ligibuagu bani latarü;</para>
  <para style="q" vid="PSA 66:15">nedewehaba bágasu hama gábara wügüriña bun,</para>
  <para style="q" vid="PSA 66:15">luma adagaragüdüni le hauti gábara.<verse eid="PSA 66:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 66:16" />Higougu sun huguya ha inebebei Bungiu hun!</para>
  <para style="q" vid="PSA 66:16">Aganba humana,</para>
  <para style="q" vid="PSA 66:16">nabahüdagua hun luagu le ladügübei Bungiu nuagu!<verse eid="PSA 66:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 66:17" />Wátina lun lau niyuma</para>
  <para style="q" vid="PSA 66:17">luma tau niñeñe aba nalawahani.<verse eid="PSA 66:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 66:18" />Lun hamuga wuriba lan naritagun,</para>
  <para style="q" vid="PSA 66:18">maganbun lumutina hamuga Nabureme;<verse eid="PSA 66:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 66:19" />gama lumoun aganba lumutina</para>
  <para style="q" vid="PSA 66:19">teni ligía lun nafurieidun!<verse eid="PSA 66:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 66:20" />Alawahoualá Bungiu,</para>
  <para style="q" vid="PSA 66:20">aganba lumuti nafurieidun,</para>
  <para style="q" vid="PSA 66:20">mamahan ligía nun lau línsiñehabu.<verse eid="PSA 66:20" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" sid="PSA 67" />
  <para style="s1">Alawahalabu sun ageiraü!</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 67:1" />Aburemei, gudeme wamá bun, biní báwame;</para>
  <para style="q" vid="PSA 67:1">arihabáwa lau agu buiti,<verse eid="PSA 67:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 67:2" />subudi hamaamugei sun lílana fulasu ubouagu</para>
  <para style="q" vid="PSA 67:2">bugundan luma besefuhan.<verse eid="PSA 67:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 67:3" />Bungiu,</para>
  <para style="q" vid="PSA 67:3">alawaha hamabu sun lílana fulasu;</para>
  <para style="q" vid="PSA 67:3">sun lílana fulasu alawaha hamabu!<verse eid="PSA 67:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 67:4" />Wagua hamá néchanigu lau ugundani,</para>
  <para style="q" vid="PSA 67:4">ladüga agumadihatibu fulasurugu lau irichaü;</para>
  <para style="q" vid="PSA 67:4">alidiha bumutiña lílana fulasu ubouagu!<verse eid="PSA 67:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 67:5" />Bungiu,</para>
  <para style="q" vid="PSA 67:5">alawaha hamabu sun lílana fulasu;</para>
  <para style="q" vid="PSA 67:5">sun lílana fulasu alawaha hamabu!<verse eid="PSA 67:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 67:6" />Ru laali múa lin;</para>
  <para style="q" vid="PSA 67:6">biní láadiwa Wabungiute!<verse eid="PSA 67:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 67:7" />Biní láadiwa Bungiu!</para>
  <para style="q" vid="PSA 67:7">Rula sun ubóu uéiriguni lun!<verse eid="PSA 67:7" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" sid="PSA 68" />
  <para style="s1">Bungiu íchugubalin agañeiruni</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 68:1" />Dan le larufudagun Bungiu lungua,</para>
  <para style="q" vid="PSA 68:1">aba hachagaragun láganiñu;</para>
  <para style="q" vid="PSA 68:1">ha iyereehabúbaña lun,</para>
  <para style="q" vid="PSA 68:1">aba hanurahan luéi;<verse eid="PSA 68:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 68:2" />gumuguatiña kei gumuleli garabalirugu,</para>
  <para style="q" vid="PSA 68:2">rǘrüguatiña kei lubuña sanudelu wáturugu;</para>
  <para style="q" vid="PSA 68:2">féridiñuhaña wuribatiña ligibugiñe Bungiu!<verse eid="PSA 68:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 68:3" />Ánhaña ha buídubaña, gúndaatiña,</para>
  <para style="q" vid="PSA 68:3">buinñu haña lau ugundani ligibugiñe Bungiu,</para>
  <para style="q" vid="PSA 68:3">achubahatiña lau ugundani!<verse eid="PSA 68:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 68:4" />Heremuha lun Bungiu,</para>
  <para style="q" vid="PSA 68:4">heremuha uremu lun Aburemei;</para>
  <para style="q" vid="PSA 68:4">alawaha huméi le agalufehabei ligibuagu dúeri,</para>
  <para style="q" vid="PSA 68:4">gunda humá lidan Aburemei!</para>
  <para style="q" vid="PSA 68:4">Gunda humá liñúarü!<verse eid="PSA 68:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 68:5" />Bungiu le aganóubei tidan luban to sánduboun,</para>
  <para style="q" vid="PSA 68:5">ligía háguchibei méteñuhaña,</para>
  <para style="q" vid="PSA 68:5">ligía ágüdahabaliña würiña ha hilaguaaña hámari;<verse eid="PSA 68:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 68:6" />ruti Bungiu fulasu houn ha</para>
  <para style="q" vid="PSA 68:6">hábuguarügübaña lun haganóun ñein;</para>
  <para style="q" vid="PSA 68:6">sagá lumutiña adaürǘtiña awansegüdalaña;</para>
  <para style="q" vid="PSA 68:6">ánhañati ha salufuribaña haganóuba lidan múa máluleti.<verse eid="PSA 68:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 68:7" />Bungiu,</para>
  <para style="q" vid="PSA 68:7">dan le báfuridunbei habá habá bumutuniña</para>
  <para style="q" vid="PSA 68:7">éibugeina lidan fulasu mageirawati,<verse eid="PSA 68:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 68:8" />adadagarati múa,</para>
  <para style="q" vid="PSA 68:8">áhuyati huya siélugiñe,</para>
  <para style="q" vid="PSA 68:8">adadagarati Sinaí ligibugiñe Bungiu,</para>
  <para style="q" vid="PSA 68:8">ligibugiñe Habungiute lánigu Ísüraeli.<verse eid="PSA 68:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 68:9" />Bungiu, áhuyagüdatibu saragu huya,</para>
  <para style="q" vid="PSA 68:9">buchaali yebe hawagu bánigu,</para>
  <para style="q" vid="PSA 68:9">aba bíchugun gurasu houn.<verse eid="PSA 68:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 68:10" />Rédeitiña bumutuniña ñein,</para>
  <para style="q" vid="PSA 68:10">ánheinti buguya Bungiu, lau bareini,</para>
  <para style="q" vid="PSA 68:10">ru bumuti le hemegeirubei gudemetiña houn.<verse eid="PSA 68:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 68:11" />Ruti Bungiu aban uganu;</para>
  <para style="q" vid="PSA 68:11">saragu haña würiña ariñaguti:<verse eid="PSA 68:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 68:12" />«Hanurahaña urúeigu hau sun hasudaranigu!»</para>
  <para style="q" vid="PSA 68:12">Múnada, fánreingua hamuti burí würiña katei</para>
  <para style="q" vid="PSA 68:12">le agidarúbei hawéi áganiñu,<verse eid="PSA 68:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 68:13" />lenegerügaaña tarüna wagugua hóuburagu lau pülata!</para>
  <para style="q" vid="PSA 68:13">Lau tiyu miriñu kei golu fínuti!</para>
  <para style="q" vid="PSA 68:13">Ánheinti huguya rédeitün lidan fárüga.<verse eid="PSA 68:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 68:14" />Dan le ladügünbei Suntigabafu lun hanurahan urúeigu,</para>
  <para style="q" vid="PSA 68:14">lábürühañaha niewe luagun wübü Salümón.<verse eid="PSA 68:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 68:15" />Wéiriti liñun burí láraabute Basán!</para>
  <para style="q" vid="PSA 68:15">Wéiriti liñun burí luwübüri.<verse eid="PSA 68:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 68:16" />Huguya burí le aganóubei lidan wübü íñuti;</para>
  <para style="q" vid="PSA 68:16">ariha humuti wübü le ñein lubéi líchigoun</para>
  <para style="q" vid="PSA 68:16">Bungiu luban lau gimugaü.</para>
  <para style="q" vid="PSA 68:16">Laganóuba Aburemei ñein súnwandan!<verse eid="PSA 68:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 68:17" />Luagu míñunu labahüdoun Bungiu</para>
  <para style="q" vid="PSA 68:17">likarün hama ligabayun ha lánina wuribu;</para>
  <para style="q" vid="PSA 68:17">tidan liabin Sinaígiñe lun lúbiñoun.<verse eid="PSA 68:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 68:18" />Bungiu, múdeitibu iñun, barüina adaürǘtiña;</para>
  <para style="q" vid="PSA 68:18">ibihatibu fáyeiti hámagiñe wügüriña</para>
  <para style="q" vid="PSA 68:18">íbini ha maganbadibaña</para>
  <para style="q" vid="PSA 68:18">deregeguatiña houngua bun, Aburemei.<verse eid="PSA 68:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 68:19" />Alawahoualá Bungiu,</para>
  <para style="q" vid="PSA 68:19">Wabungiute Wesefuragüle,</para>
  <para style="q" vid="PSA 68:19">barǘ lumuti wahürügü sagü weyu!<verse eid="PSA 68:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 68:20" />Wabungiute aban Bungiu le esefuhati ligía,</para>
  <para style="q" vid="PSA 68:20">le giñe gayaraabei lesefuruniwa luéi óunweni.<verse eid="PSA 68:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 68:21" />Labouchagubei Bungiu hachügü láganiñu</para>
  <para style="q" vid="PSA 68:21">hachügü ha lidanmémebaña figóu.<verse eid="PSA 68:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 68:22" />Ariñagaali Aburemei:</para>
  <para style="q" vid="PSA 68:22">«Nagiribudagüdübadibu Basangiñe;</para>
  <para style="q" vid="PSA 68:22">nagiribudagüdübadibu lídangiñe barana huliliti;<verse eid="PSA 68:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 68:23" />lun bágawagüdüni bugudi lidan hata báganiñu</para>
  <para style="q" vid="PSA 68:23">gurá hameime giñe bilügüniña ounli».<verse eid="PSA 68:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PSA 68:24" />Bungiu, Nubungiute Nurúeite,</para>
  <para style="q" vid="PSA 68:24">arihúati burí asariñaagüdüni búbiñe</para>
  <para style="q" vid="PSA 68:24">le adügǘbei lau inebesei bun.<verse eid="PSA 68:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 68:25" />Ha eremuhabaña ubá ubaañanu;</para>
  <para style="q" vid="PSA 68:25">ánhañati áfarutiña árigi,</para>
  <para style="q" vid="PSA 68:25">würiña irahüñü amidanguonñanu áfareina panderu.<verse eid="PSA 68:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 68:26" />Alawaha huméi Bungiu!</para>
  <para style="q" vid="PSA 68:26">Alawaha haméi sun lumutuniña Ísüraeli óundaragu!<verse eid="PSA 68:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 68:27" />Benhamín le amuleñein habá habá,</para>
  <para style="q" vid="PSA 68:27">hau saragu ábutigu lani Hudá, Sabulón luma Nefütalí.<verse eid="PSA 68:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PSA 68:28" />Nubungiute, arufudabéi bubafu;</para>
  <para style="q" vid="PSA 68:28">derebugugüdabei le adüga báalibei wawagu!<verse eid="PSA 68:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 68:29" />Lúmagiñe tídangiñe tiñun buban to Herusalénboun,</para>
  <para style="q" vid="PSA 68:29">le ñeinhin lubéi hanüga urúeigu idewesei bun,<verse eid="PSA 68:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 68:30" />badeinha lun Ehiptu,</para>
  <para style="q" vid="PSA 68:30">animaalu le lídanbei maburu-agei,</para>
  <para style="q" vid="PSA 68:30">badeinha houn bágasu gáñitiña,</para>
  <para style="q" vid="PSA 68:30">ha ígirubaliña lílana fulasu ǘnabuguñu</para>
  <para style="q" vid="PSA 68:30">lau hafuudun lun harisidun;</para>
  <para style="q" vid="PSA 68:30">chagaguagüdabaña gürigia ha hínsiñehabubaña lun wuribu!<verse eid="PSA 68:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 68:31" />Hayabinba ounahóutiña Ehiptugiñe,</para>
  <para style="q" vid="PSA 68:31">hiñurubei Etiopíana háhabu lun Bungiu.<verse eid="PSA 68:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="PSA 68:32" />Heremuha lun Bungiu, arúeihani ubouaguna;</para>
  <para style="q" vid="PSA 68:32">heremuha uremu lun Aburemei!<verse eid="PSA 68:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 68:33" />Lun le agalufehabei siélurugu,</para>
  <para style="q" vid="PSA 68:33">lidan sielu le magumuchadibei!</para>
  <para style="q" vid="PSA 68:33">Aganba huméi liréin lumalali, umalali gabafuti.<verse eid="PSA 68:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 68:34" />Subudi huméi lubafu Bungiu;</para>
  <para style="q" vid="PSA 68:34">anihein luéirigun luagu Ísüraeli,</para>
  <para style="q" vid="PSA 68:34">anihein lubafu lidan sielu le díngubei.<verse eid="PSA 68:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 68:35" />Hanarimeguti Bungiu lúbiñe,</para>
  <para style="q" vid="PSA 68:35">ruti Habungiute lánigu Ísüraeli</para>
  <para style="q" vid="PSA 68:35">ubafu luma erei houn lánigu.</para>
  <para style="b" vid="PSA 68:35" />
  <para style="q" vid="PSA 68:35">Alawahoualá Bungiu!<verse eid="PSA 68:35" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" sid="PSA 69" />
  <para style="s1">Agúaraguni lánina igarigu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 69:1" />Sefubána Nubungiute,</para>
  <para style="q" vid="PSA 69:1">ladüga yarafaadina lun nañaradagun;<verse eid="PSA 69:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 69:2" />nabuluchuña lidoun aban suanpu huliliti,</para>
  <para style="q" vid="PSA 69:2">ani madaritina halíaba lan nadagaragüdei nugudi.</para>
  <para style="q" vid="PSA 69:2">Chülühadina lidoun lilulin-agei duna</para>
  <para style="q" vid="PSA 69:2">ani laduruguduñadina ébeini.<verse eid="PSA 69:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 69:3" />Ñalá nagülerugu lárigi lere nagúarahan;</para>
  <para style="q" vid="PSA 69:3">gáriha sun nagülerugu;</para>
  <para style="q" vid="PSA 69:3">Buchá luagu nagu lárigi nilü agurabahei Nubungiute!<verse eid="PSA 69:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 69:4" />Gíbetimatiña náganiñu mébunouga</para>
  <para style="q" vid="PSA 69:4">sügǘ lau ídiburi le nábulugubei;</para>
  <para style="q" vid="PSA 69:4">gíbetimahaña ha iyereehabúbaña nun,</para>
  <para style="q" vid="PSA 69:4">ha agünrinchagubalina mébunouga.</para>
  <para style="q" vid="PSA 69:4">Fosu hamutina lun náguyugüdüni le míweruhan nubéi.<verse eid="PSA 69:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 69:5" />Nubungiute,</para>
  <para style="q" vid="PSA 69:5">subudi bumuti ida liña lan buga lueirin numaganbadin;</para>
  <para style="q" vid="PSA 69:5">siñati naramuduni nifigoun buéi.<verse eid="PSA 69:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 69:6" />Nabureme, Bungiu Suntigabafu,</para>
  <para style="q" vid="PSA 69:6">manüga hamá ha afiñebaña buagu busiganu luagu nidurun!</para>
  <para style="q" vid="PSA 69:6">Habungiute Ísüraelina,</para>
  <para style="q" vid="PSA 69:6">méiguadala harüna ha áluahabalibu, nuéigiñe!<verse eid="PSA 69:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 69:7" />Awandaadina anabawaguni buéigiñe;</para>
  <para style="q" vid="PSA 69:7">buinha nigibu lau busiganu.<verse eid="PSA 69:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 69:8" />Ítara niña kei aban terencha</para>
  <para style="q" vid="PSA 69:8">houn níbirigu guánarügü!<verse eid="PSA 69:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 69:9" />Lagumuchaguagüdüñadina nemeidin tau buban;</para>
  <para style="q" vid="PSA 69:9">nuagun lábürüha hanabahan ha anabubalibu;<verse eid="PSA 69:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 69:10" />adügatiña bula nau dan le nayahun luma nayunarun;<verse eid="PSA 69:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 69:11" />au héheraagülebei sun hagía</para>
  <para style="q" vid="PSA 69:11">dan le nadaürün daüguaü lánina ludu.<verse eid="PSA 69:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 69:12" />Hayumuluguñadina sun hagía,</para>
  <para style="q" vid="PSA 69:12">eremaagua hamana bacharuatiña.<verse eid="PSA 69:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 69:13" />Gama lumoun au, Nabureme, wa numutibu,</para>
  <para style="q" vid="PSA 69:13">Nubungiute; íderaguabana guentó!</para>
  <para style="q" vid="PSA 69:13">Luagu lueirin bínsiñehabu; óunababana!</para>
  <para style="q" vid="PSA 69:13">Luagu merederadi lan bídehan, sefubána!<verse eid="PSA 69:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 69:14" />Mígiraba lun nabuluchun lidan suanpu!</para>
  <para style="q" vid="PSA 69:14">Sefubána hawéi ha iyereehabúbaña nun</para>
  <para style="q" vid="PSA 69:14">luma lídangiñe lilulin duna.<verse eid="PSA 69:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 69:15" />Mígiraba lun laduruhanina ébeini!</para>
  <para style="q" vid="PSA 69:15">Mígiraba lun láhuluchunina fuludu,</para>
  <para style="q" vid="PSA 69:15">ñéingiñeme ladouragua nau!<verse eid="PSA 69:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 69:16" />Nabureme, óunababana;</para>
  <para style="q" vid="PSA 69:16">buítibu, hínsiñehabu buguya!</para>
  <para style="q" vid="PSA 69:16">Luagu lueirin bugudemehabu, arihabána;<verse eid="PSA 69:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 69:17" />mágurabana au le bubuein!</para>
  <para style="q" vid="PSA 69:17">Óunababana furese ladüga lídanñadina denchaü!<verse eid="PSA 69:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 69:18" />Yarafabá nun, sefubána;</para>
  <para style="q" vid="PSA 69:18">sefubána hawéi náganiñu!<verse eid="PSA 69:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 69:19" />Subudi bumuti anabawaguni,</para>
  <para style="q" vid="PSA 69:19">luma busiganu le awanda náalibei;</para>
  <para style="q" vid="PSA 69:19">subudi bumuti kátaña lan náganiñubaña.<verse eid="PSA 69:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 69:20" />Bóuguala anabawaguni nanigi;</para>
  <para style="q" vid="PSA 69:20">maguraasunhadina, mere nuguya!</para>
  <para style="q" vid="PSA 69:20">Áluahaadina kaba lan íchiga gurasu nun,</para>
  <para style="q" vid="PSA 69:20">luma kaba lan gudemehabu nun.<verse eid="PSA 69:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 69:21" />Rútiña abiñaragülei lidoun neigin,</para>
  <para style="q" vid="PSA 69:21">dan le namagürabudun aba híchugun binigá nun.<verse eid="PSA 69:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 69:22" />Garabagualá hadabulan</para>
  <para style="q" vid="PSA 69:22">luma burí heigin le lánina umadaguaü lun sádarame houn!<verse eid="PSA 69:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 69:23" />Adügabá lun herederun marihinga</para>
  <para style="q" vid="PSA 69:23">luma lun ladadagarun hayada súnwandan!<verse eid="PSA 69:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 69:24" />Rariguagüdabei bigañi hawagun;</para>
  <para style="q" vid="PSA 69:24">ragülaña ligeme bigañi!<verse eid="PSA 69:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 69:25" />Günrinwaguatá hakianpun-agei</para>
  <para style="q" vid="PSA 69:25">merederalá ni aban tidan burí hakianpun;<verse eid="PSA 69:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 69:26" />ladüga éibaaha hamuti le nidiheribei</para>
  <para style="q" vid="PSA 69:26">adüga hagía bula lau ligarigu le babeichubei.<verse eid="PSA 69:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 69:27" />Águyugüdaba wuribani luagu wuribani houn;</para>
  <para style="q" vid="PSA 69:27">ualá feruduna bániña!<verse eid="PSA 69:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 69:28" />Gidabaña tídangiñe liliburuna ibagari</para>
  <para style="q" vid="PSA 69:28">míchigabei hiri tidoun gárada to</para>
  <para style="q" vid="PSA 69:28">ñein lubéi hiri ha richaguabaña!<verse eid="PSA 69:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 69:29" />Ánheinti au, le sándibei ani nidiheri nuguya,</para>
  <para style="q" vid="PSA 69:29">iñuraguabana, Nubungiute, sefubána.<verse eid="PSA 69:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="PSA 69:30" />Nalawahabei liri Bungiu lau uremu;</para>
  <para style="q" vid="PSA 69:30">nalawahabei lau eteingiruni.<verse eid="PSA 69:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 69:31" />Gúndaatimabei Bungiu lau lira</para>
  <para style="q" vid="PSA 69:31">sügǘ lau nadagaragüdün aban bágasu lun</para>
  <para style="q" vid="PSA 69:31">odi aban lan bágasu lau ganchu luma lúbara ugudi.<verse eid="PSA 69:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 69:32" />Ha nidiheribaña,</para>
  <para style="q" vid="PSA 69:32">hagundaaruba lau harihini katei le,</para>
  <para style="q" vid="PSA 69:32">ábame tárügüdün hanigi ha áluahabalin Bungiu gurasu;<verse eid="PSA 69:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 69:33" />ladüga aganba lumutiña Aburemei gudemetiña</para>
  <para style="q" vid="PSA 69:33">ani mágurun lumutiña lánigu ha adaürǘbaña.<verse eid="PSA 69:33" /></para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" sid="PSA 69:34" />Alawahalei sielu, múa luma barana Aburemei,</para>
  <para style="q" vid="PSA 69:34">luma sun le burí aganóubei lidan!<verse eid="PSA 69:34" /></para>
  <para style="q">
    <verse number="35-36" style="v" sid="PSA 69:35-36" />Lesefurubei Bungiu Sión</para>
  <para style="q" vid="PSA 69:35-36">ani lararamagüdayabei burí luburugute Hudá.</para>
  <para style="q" vid="PSA 69:35-36">Halagantebei hasaanigu lubúeingu Bungiu uburugu;</para>
  <para style="q" vid="PSA 69:35-36">ñeinba haganóua ábame hagíaaña lan laburiña;</para>
  <para style="q" vid="PSA 69:35-36">haganóuba ha hínsiñehabubaña lun Bungiu ñein!<verse eid="PSA 69:35-36" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" sid="PSA 70" />
  <para style="s1">Ñǘbuinba furese íderaguana</para>
  <para style="r">(<ref loc="PSA 40:13-17">Sal 40.13-17</ref>)</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 70:1" />Nubungiute, higabu besefurana!</para>
  <para style="q" vid="PSA 70:1">Nabureme, higabu bíderaguana furese!<verse eid="PSA 70:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 70:2" />Barǘ hamá ha álugubaña háfarunina busiganu!</para>
  <para style="q" vid="PSA 70:2">Ha álugubaña hadügün wuribati nun,</para>
  <para style="q" vid="PSA 70:2">anuraha hamá lau busiganu!<verse eid="PSA 70:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 70:3" />Ha adügübaña bula nau,</para>
  <para style="q" vid="PSA 70:3">anuraha hamá lau busiganu!<verse eid="PSA 70:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 70:4" />Gama lumoun sun ha alawahabalibu,</para>
  <para style="q" vid="PSA 70:4">buin hamá lau ugundani;</para>
  <para style="q" vid="PSA 70:4">ha ayumahabaña lun besefuruniña,</para>
  <para style="q" vid="PSA 70:4">ariñaga hamá súnwandan:</para>
  <para style="q" vid="PSA 70:4">«Wéiriguti Wabungiute!»<verse eid="PSA 70:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 70:5" />Auti, le gudemebei nidiheri nuguya,</para>
  <para style="q" vid="PSA 70:5">Nubungiute, higabu bíderaguana furese!</para>
  <para style="q" vid="PSA 70:5">Buguya íderagubalina ani sefubána;</para>
  <para style="q" vid="PSA 70:5">madarasahabá, Nabureme!<verse eid="PSA 70:5" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" sid="PSA 71" />
  <para style="s1">Lafurieidun aban weiriei mutu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 71:1" />Nabureme, bóubawagu náluaha ounigirúni;</para>
  <para style="q" vid="PSA 71:1">mígirabana wuriba!<verse eid="PSA 71:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 71:2" />Sefubána, salba bana buguya le richabei!</para>
  <para style="q" vid="PSA 71:2">Ruba arigei lun baganbunina, sefubána.<verse eid="PSA 71:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 71:3" />Buguyalá dübü wéiriti le ágüdahabalina,</para>
  <para style="q" vid="PSA 71:3">ítaraba nun kei aban dübü le aramudaguagülei!</para>
  <para style="q" vid="PSA 71:3">Buguya ageindagubei náugiñe ani góunigibana!<verse eid="PSA 71:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 71:4" />Nubungiute,</para>
  <para style="q" vid="PSA 71:4">sefubána lúhaburugugiñe le wuribabei;</para>
  <para style="q" vid="PSA 71:4">lúhaburugugiñe le gáfarahadibei luma le hanarimebei;<verse eid="PSA 71:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 71:5" />ladüga buguya, Nabureme nemeniginbei</para>
  <para style="q" vid="PSA 71:5">luma le uágubei nachourura lúmagiñe nibureingidina.<verse eid="PSA 71:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 71:6" />Lúmagiñe meha turageirugugidina núguchu nabalachun buagun;</para>
  <para style="q" vid="PSA 71:6">adügatibu lun nágurahouniwa!</para>
  <para style="q" vid="PSA 71:6">Neremuhaba bun súnwandan!<verse eid="PSA 71:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 71:7" />Ñǘbuinhadina lun lébunabadina lan</para>
  <para style="q" vid="PSA 71:7">taweiridun anigi houn saragu,</para>
  <para style="q" vid="PSA 71:7">gama lumoun buguya naramudaguagülebei.<verse eid="PSA 71:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 71:8" />Sun weyu buin liña niyuma lau uremu lun buéirigun;<verse eid="PSA 71:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 71:9" />mágurabana danme le wéiyaadina;</para>
  <para style="q" vid="PSA 71:9">mígirun báname danme le méreedina!<verse eid="PSA 71:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 71:10" />Busentiña náganiñu háfarunina,</para>
  <para style="q" vid="PSA 71:10">ayanuhatiña wuriba nuagu eledegua hagía nubá.<verse eid="PSA 71:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 71:11" />Hariñaga: «Éibaaha huméi, ragǘ huméi,</para>
  <para style="q" vid="PSA 71:11">ladüga meberesenhali Bungiu lau,</para>
  <para style="q" vid="PSA 71:11">úati kaba lan esefurei!»<verse eid="PSA 71:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 71:12" />Madisedabá nuéi Nubungiute;</para>
  <para style="q" vid="PSA 71:12">higabu bíderaguana furese!<verse eid="PSA 71:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 71:13" />Rúbaña náganiñu lidoun busiganu!</para>
  <para style="q" vid="PSA 71:13">Rúbaña ha abusenrubaña lamiselu nun lidoun busiganu!<verse eid="PSA 71:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 71:14" />Ánheinti au,</para>
  <para style="q" vid="PSA 71:14">nagurabahaba súnwandan,</para>
  <para style="q" vid="PSA 71:14">ani neremuhatimaba bun.<verse eid="PSA 71:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 71:15" />Sun weyu nadimurehaba luagu sefu báadiwa lan</para>
  <para style="q" vid="PSA 71:15">adüga buguya irichaü woun.</para>
  <para style="q" vid="PSA 71:15">Úati gunfurandanani buéirigun!<verse eid="PSA 71:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 71:16" />Nabureme, nabahüdaguba luagu burí katei wéinamuti le adüga báalibei,</para>
  <para style="q" vid="PSA 71:16">nadimurehaba luagu buguyarügüñein lan richagua!<verse eid="PSA 71:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 71:17" />Nubungiute,</para>
  <para style="q" vid="PSA 71:17">arufudahaadibu nun lúmagiñe nibureingidina,</para>
  <para style="q" vid="PSA 71:17">ani anahagua adimureha</para>
  <para style="q" vid="PSA 71:17">luagu burí katei wéiriguti le badügübei.<verse eid="PSA 71:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 71:18" />Nubungiute, mígirabana,</para>
  <para style="q" vid="PSA 71:18">íbini danme le wéiyaadina, garuba nuguya.</para>
  <para style="q" vid="PSA 71:18">Ladüga mosu nadimurehan houn lirahüñüna dan le,</para>
  <para style="q" vid="PSA 71:18">hama ha lúnbaña hayabin hárigiñe luagu lueirin bubafu.<verse eid="PSA 71:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 71:19" />Wéiriti biricha, Bungiu;</para>
  <para style="q" vid="PSA 71:19">adügaadibu óunwenbu burí katei;</para>
  <para style="q" vid="PSA 71:19">úati ni aban kei buguya!<verse eid="PSA 71:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 71:20" />Lau sun arihagüdaadibu lan</para>
  <para style="q" vid="PSA 71:20">saragu mabunuruni luma idiheri nun,</para>
  <para style="q" vid="PSA 71:20">bíchigayaba ibagari nun;</para>
  <para style="q" vid="PSA 71:20">biñuraguagüdübadina lídangiñe lilulin múa,<verse eid="PSA 71:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 71:21" />baganwoundagüdübei nuéirigun ámalihaya báname.<verse eid="PSA 71:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 71:22" />Au luagu nóubadina,</para>
  <para style="q" vid="PSA 71:22">neremuhaba uremu bun,</para>
  <para style="q" vid="PSA 71:22">ru aume eteingiruni bun tau sun tuwuyeri árüpa</para>
  <para style="q" vid="PSA 71:22">Nubungiute lisandun Ísüraeli.<verse eid="PSA 71:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 71:23" />Lagundaaruba niyuma lau leremuhan bun,</para>
  <para style="q" vid="PSA 71:23">lagundaaruba giñe sun núgubu, le besefurubei.<verse eid="PSA 71:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 71:24" />Tariñaguba giñe niñeñe súnwandan luagu richá ban,</para>
  <para style="q" vid="PSA 71:24">ladüga ha yebe áluahabaña wuribani nun,</para>
  <para style="q" vid="PSA 71:24">rédeihaña lau busiganu.<verse eid="PSA 71:24" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" sid="PSA 72" />
  <para style="s1">Afurieiduni luagu aban urúei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 72:1" />Bungiu, rubei biricha luma búaragun lun urúei,<verse eid="PSA 72:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 72:2" />lun gayara lan lalidihaniña bumutuniña,</para>
  <para style="q" vid="PSA 72:2">hama gudemetiña lau irichaü.<verse eid="PSA 72:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 72:3" />Lun íbini lan áraabu luma wübü</para>
  <para style="q" vid="PSA 72:3">lun líchugun darangilaü houn bumutuniña.<verse eid="PSA 72:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 72:4" />Rulei urúei haricha gudemetiña houn!</para>
  <para style="q" vid="PSA 72:4">Sefuláña hasaanigu ha mégeihabubaña,</para>
  <para style="q" vid="PSA 72:4">günringua láñame ha asufuriragüdübaliña gürigia!<verse eid="PSA 72:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 72:5" />Hanufudelá urúei buéi lun súnwandan,</para>
  <para style="q" vid="PSA 72:5">sun anihagua lan weyu luma hati!<verse eid="PSA 72:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 72:6" />Ítarala kei huya luma serenu</para>
  <para style="q" vid="PSA 72:6">le áturagubalin múa luma sagadi!<verse eid="PSA 72:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 72:7" />Ñeinlá saragu darangilaü</para>
  <para style="q" vid="PSA 72:7">luma úaraguni lidan lidaani larúeihan,</para>
  <para style="q" vid="PSA 72:7">darí lachülürün dan lun lúadun hati!<verse eid="PSA 72:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 72:8" />Lagumadiha lúmagiñe aban barana lumoun le aban,</para>
  <para style="q" vid="PSA 72:8">lúmagiñe duna le wéiribei</para>
  <para style="q" vid="PSA 72:8">darí lumoun lagumuhóun larigeirugu ubóu!<verse eid="PSA 72:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 72:9" />Deregegua hamá láganiñu</para>
  <para style="q" vid="PSA 72:9">ha lílana fulasu mageirawati houngua lun!<verse eid="PSA 72:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 72:10" />Fayei hamá urúeigu ha Esüpáñabaña,</para>
  <para style="q" vid="PSA 72:10">hama ha luágubaña ubouhu liseinsuna gumadi lun,</para>
  <para style="q" vid="PSA 72:10">barǘ hagíame lurúeitegu Arawia luma Etiopía edewehani lun.<verse eid="PSA 72:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 72:11" />Hudugua hamá sun urúeigu ligibugiñe!</para>
  <para style="q" vid="PSA 72:11">Seriwi haméi sun néchanigu!<verse eid="PSA 72:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 72:12" />Lesefurubaña gudemetiña ha ayumuragubaña,</para>
  <para style="q" vid="PSA 72:12">hama giñe ha míderawagunbaña.<verse eid="PSA 72:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 72:13" />Gudemehabubei houn ha gudemebaña,</para>
  <para style="q" vid="PSA 72:13">lesefurubei habagari gudemetiña.<verse eid="PSA 72:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 72:14" />Lesefurubaña hawéi ha óuseragubaliña,</para>
  <para style="q" vid="PSA 72:14">ladüga barǘ lumuti habagari kei katei gebegiti.<verse eid="PSA 72:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 72:15" />Gabagarilá urúei!</para>
  <para style="q" vid="PSA 72:15">Rualá golu le Arawiabei lun!</para>
  <para style="q" vid="PSA 72:15">Amuriahoualá luma Bungiu luagu súnwandan!</para>
  <para style="q" vid="PSA 72:15">Alawahoualá súnwandan!<verse eid="PSA 72:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 72:16" />Ñeinlá saragu türigu fulasurugu,</para>
  <para style="q" vid="PSA 72:16">gibelá türigu lábulugu burí wübü!</para>
  <para style="q" vid="PSA 72:16">Ñeinlá saragu alubahani kei Líwanu,</para>
  <para style="q" vid="PSA 72:16">ñeinlá giñe lugule türigu kei híduru áraabu!<verse eid="PSA 72:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 72:17" />Mabulieidawalá liri urúei lun súnwandan;</para>
  <para style="q" vid="PSA 72:17">ani adimurehoualá luagu sun anihagua lan weyu!</para>
  <para style="q" vid="PSA 72:17">Ibiha hamá sun gürigia ubouagu abiniruni lídangiñe!</para>
  <para style="q" vid="PSA 72:17">Ariñaga hamá sun gürigia lun, fuleseiwati!<verse eid="PSA 72:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 72:18" />Alawahoualá Bungiu, Aburemei,</para>
  <para style="q" vid="PSA 72:18">le Habungiute Ísüraelina,</para>
  <para style="q" vid="PSA 72:18">le ligíarügübei adüga burí katei wéinamuti;<verse eid="PSA 72:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 72:19" />biniwalá luéirigun liri súnwandan.</para>
  <para style="q" vid="PSA 72:19">Buinla sun ubóu lau luéirigun!</para>
  <para style="q" vid="PSA 72:19">Ítarala!<verse eid="PSA 72:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 72:20" />Ya lagumucha burí lafurieidun Dawidi le liráü Hesé.<verse eid="PSA 72:20" /></para>
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" sid="PSA 73" />
  <para style="ms">TǗRÜWAN LÍBURU</para>
  <para style="mr">(Sálumu <ref loc="PSA 73-89">73—89</ref>)</para>
  <para style="s1">Lareini Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 73:1" />Buiti Bungiu hama Ísüraelina ha lánigu,</para>
  <para style="q" vid="PSA 73:1">hama ha harumabaña anigi.<verse eid="PSA 73:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 73:2" />Ánheinti au murusunrügaali yebe lun néiguadun;</para>
  <para style="q" vid="PSA 73:2">ítagaraü yebe liriraagun nugudi.<verse eid="PSA 73:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 73:3" />Ladüga aba nagimugadun</para>
  <para style="q" vid="PSA 73:3">lau narihin hawanserun ha salufuribaña</para>
  <para style="q" vid="PSA 73:3">hama ha barüguabaña houngua.<verse eid="PSA 73:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 73:4" />Hagía madiheriduntiña luagu óunweni,</para>
  <para style="q" vid="PSA 73:4">ladüga buinñu haña lau lubuidun átuadi;<verse eid="PSA 73:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 73:5" />masufurirungiña kei híbiri gürigia,</para>
  <para style="q" vid="PSA 73:5">madiheri hagía kei ha híbiri.<verse eid="PSA 73:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 73:6" />Ligía hanügünbalin pantaü kei hañari,</para>
  <para style="q" vid="PSA 73:6">luma anarimeni kei hadaüragun;<verse eid="PSA 73:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 73:7" />hanarimeti hadibunen</para>
  <para style="q" vid="PSA 73:7">darí lun kamá lan lachubara lila hagu,</para>
  <para style="q" vid="PSA 73:7">ani gíbeeliti luriban haritagun.<verse eid="PSA 73:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 73:8" />Asiadihatiña hadügün wuribani luma anarimeni,</para>
  <para style="q" vid="PSA 73:8">lau bula, anaaguni unguaü luma mabusigari;<verse eid="PSA 73:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 73:9" />adimurehatiña wuriba luagu Bungiu le siélubei,</para>
  <para style="q" vid="PSA 73:9">rútiña lúrudu houn sun gürigia lau pantaü ligibuagu ubóu le.<verse eid="PSA 73:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 73:10" />Ligía hadimurehanbei gürigia buidu hawagu</para>
  <para style="q" vid="PSA 73:10">madarirun hagía hadurun.<verse eid="PSA 73:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 73:11" />Hariñaga: «Lasubudirubei funagia Bungiu?</para>
  <para style="q" vid="PSA 73:11">Gefenbei funagia le Íñugubei?»<verse eid="PSA 73:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 73:12" />Ariha humaña wuribatiña ha!</para>
  <para style="q" vid="PSA 73:12">Gánwoungüda hamuti harisin lau darangilaü.<verse eid="PSA 73:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 73:13" />Málati haruma tan nanigi,</para>
  <para style="q" vid="PSA 73:13">ani haruma ligía núhabu lídangiñe sun wuribani!<verse eid="PSA 73:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 73:14" />Ladüga sun oura nibihiña buleseiti,</para>
  <para style="q" vid="PSA 73:14">ani beiwa au sagü binaafin.<verse eid="PSA 73:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 73:15" />Lun hamuga meha nasaminarun kei hagía,</para>
  <para style="q" vid="PSA 73:15">garabaguatina hamugaha hawagun birahüñü.<verse eid="PSA 73:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 73:16" />Hóuchatina yebe gunfuranda nani katei le,</para>
  <para style="q" vid="PSA 73:16">gama lumoun hénrenguti nun.<verse eid="PSA 73:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 73:17" />Láuhali nebelurun lúbiñoun Bungiu,</para>
  <para style="q" vid="PSA 73:17">ligíaali gunfurandanani haliñounba lan houdin adagara:<verse eid="PSA 73:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 73:18" />rúbaña lidan fulasu guyeti</para>
  <para style="q" vid="PSA 73:18">lun bádaruniña lidoun günringuaü.<verse eid="PSA 73:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 73:19" />Günrinwaguatiña lidan murusun oura!</para>
  <para style="q" vid="PSA 73:19">Áfaragua lumutiña óunweni gumuguagüdalaña!<verse eid="PSA 73:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 73:20" />Ítara kei dan le labulieiduni gürigia</para>
  <para style="q" vid="PSA 73:20">luénedü lidan lagagudun binaafin,</para>
  <para style="q" vid="PSA 73:20">ítara liña babulieidagun hawéi, Nabureme.<verse eid="PSA 73:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 73:21" />Buin niña buga lau íruni</para>
  <para style="q" vid="PSA 73:21">sandí au igarigu tidan nanigi,<verse eid="PSA 73:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 73:22" />ladüga buga numaganbadin</para>
  <para style="q" vid="PSA 73:22">úati yebe gunfuranda nan;</para>
  <para style="q" vid="PSA 73:22">ítara niña buga bigibugiñe kei aban animaalugu!<verse eid="PSA 73:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 73:23" />Lau sun lira, búmañadina súnwandan.</para>
  <para style="q" vid="PSA 73:23">Ragǘ baali núhabu le nóunwenren,<verse eid="PSA 73:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 73:24" />alidiha báadina lau barufudahan nun,</para>
  <para style="q" vid="PSA 73:24">lídanme lagumuhóun, beresibirubadina lau burí ubuiduni.<verse eid="PSA 73:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 73:25" />Kagia nánibei sielu?</para>
  <para style="q" vid="PSA 73:25">Buguyarügüñein!</para>
  <para style="q" vid="PSA 73:25">Dan le búmañadina lan,</para>
  <para style="q" vid="PSA 73:25">úati ni kata nabusenrun ubouagu.<verse eid="PSA 73:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 73:26" />Lagumuchaguba sun núgubu</para>
  <para style="q" vid="PSA 73:26">gama lumoun Bungiu, ligía nalagantebei le magumuchaditi</para>
  <para style="q" vid="PSA 73:26">ligía ágüdahabarun nanigi.<verse eid="PSA 73:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PSA 73:27" />Ha adisedutiña buéi, hóunweguba;</para>
  <para style="q" vid="PSA 73:27">bagünrinchagubei le magunfulirunti buma.<verse eid="PSA 73:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 73:28" />Ánheinti au, nayarafahóuba lun Bungiu,</para>
  <para style="q" vid="PSA 73:28">ladüga anihán lubuidun-ágeibei katei nun.</para>
  <para style="q" vid="PSA 73:28">Buguya, Nabureme, buguya naramudaguagülebei,</para>
  <para style="q" vid="PSA 73:28">nadimurehaba luagu sun katei le badügübei.<verse eid="PSA 73:28" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" sid="PSA 74" />
  <para style="s1">Afurieiduni amuriahei lesefurun ageiraü</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 74:1" />Bungiu,</para>
  <para style="q" vid="PSA 74:1">ka san uagu bágurawa gumugua dan?</para>
  <para style="q" vid="PSA 74:1">Ka uagu bagañida houn bilügüniña mudún?<verse eid="PSA 74:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 74:2" />Haritaguabá hawagu bumutuniña,</para>
  <para style="q" vid="PSA 74:2">ha bibihubaña lúmagiñebei furumiñeti dan,</para>
  <para style="q" vid="PSA 74:2">ha besefurubaña lun bánigubaña lan;</para>
  <para style="q" vid="PSA 74:2">haritaguabá luagu wübü Sión,</para>
  <para style="q" vid="PSA 74:2">le meha ñein lubéi baganawa.<verse eid="PSA 74:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 74:3" />Higabu barihei günringuaü mébehati le;</para>
  <para style="q" vid="PSA 74:3">günringua laali ágani sun katei sanduariurugu!<verse eid="PSA 74:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 74:4" />Eremuha hamuti báganiñu hagañeirun bisanduariunrugu</para>
  <para style="q" vid="PSA 74:4">iñura hamaali hafanidiran kei terencha<verse eid="PSA 74:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 74:5" />luagu tubenari!</para>
  <para style="q" vid="PSA 74:5">Kamá hamuga áhinutiña dabíararugu.<verse eid="PSA 74:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 74:6" />Günringua hamuti tuenden le lauti fulansu</para>
  <para style="q" vid="PSA 74:6">tau harawa luma lau marüdiyu,<verse eid="PSA 74:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 74:7" />gudá hamutu buban;</para>
  <para style="q" vid="PSA 74:7">wíyeda hamutu buban guánarügü lau hágurunu múarugun!<verse eid="PSA 74:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 74:8" />Deregeguatiña houngua lun hagünrinchaguniwa sunsuinagubei;</para>
  <para style="q" vid="PSA 74:8">gudá hamuti sun fulasu le ñein lubéi meha</para>
  <para style="q" vid="PSA 74:8">wóundaragua lun wáhuduragun bun!<verse eid="PSA 74:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 74:9" />Marihin wamaali burí umegeni le sagüráubei;</para>
  <para style="q" vid="PSA 74:9">úaali ni aban profeta;</para>
  <para style="q" vid="PSA 74:9">ani ibidiñeti woun átiribei lan dan lau katei le.<verse eid="PSA 74:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 74:10" />Bungiu,</para>
  <para style="q" vid="PSA 74:10">ídaba san lásura lanabaguniwa wágani?</para>
  <para style="q" vid="PSA 74:10">Ídaba san lásura ladimurehan wuriba buagu?<verse eid="PSA 74:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 74:11" />Ka san uagu baramudei búhabu le gabafubei?</para>
  <para style="q" vid="PSA 74:11">Ka san uagu beredera chagu barüna?<verse eid="PSA 74:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 74:12" />Buguya Nurúeitebei lúmagiñe binadu dan;</para>
  <para style="q" vid="PSA 74:12">buguya, Bungiu ibihatibu saragu agañeiruni ubouagu:<verse eid="PSA 74:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 74:13" />Fánreingua bumuti barana lau bubafu;</para>
  <para style="q" vid="PSA 74:13">bougua bumuti hábulugu udu baranahana.<verse eid="PSA 74:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 74:14" />Buregua bumuti lábulugu Lewiatán</para>
  <para style="q" vid="PSA 74:14">lárigiñe aba bíchuguni houn animaalu hanarimetiña</para>
  <para style="q" vid="PSA 74:14">ha lídanbaña fulasu mageirawati lun héiginiña.<verse eid="PSA 74:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 74:15" />Saliguagüdatibu lísensen duna luma duna éibaaguati;</para>
  <para style="q" vid="PSA 74:15">mábeigüdabei sun burí duna le gésensenti;<verse eid="PSA 74:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 74:16" />bani áriebu luma wéyuagu,</para>
  <para style="q" vid="PSA 74:16">buguya adügübalin hati luma weyu;<verse eid="PSA 74:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 74:17" />buguya amakürübalin lébeha ubóu,</para>
  <para style="q" vid="PSA 74:17">buguya adügübalin lubachouga luma luribouga.<verse eid="PSA 74:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 74:18" />Haritaguabatia Aburemei,</para>
  <para style="q" vid="PSA 74:18">luagu anabagua lánibu bágani,</para>
  <para style="q" vid="PSA 74:18">luagu giñe adimureha hamá gürigia</para>
  <para style="q" vid="PSA 74:18">ha deré taganbun wuriba buagu.<verse eid="PSA 74:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 74:19" />Mabulieidabawa saragu!</para>
  <para style="q" vid="PSA 74:19">Débilitina kei dunuru;</para>
  <para style="q" vid="PSA 74:19">mederegerabawa houn animaalugu hanarimetiña!<verse eid="PSA 74:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 74:20" />Haritaguabá luagu bidaradun,</para>
  <para style="q" vid="PSA 74:20">ladüga buin liña fulasu lau anarimeni</para>
  <para style="q" vid="PSA 74:20">darí lumoun lagumuhóun larigeirugu!<verse eid="PSA 74:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 74:21" />Mígiraba lun háünabudagüdüniwa ha gudemebaña;</para>
  <para style="q" vid="PSA 74:21">adügabá lun heremuhan gudemetiña hama ǘnabugutiña bun!<verse eid="PSA 74:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 74:22" />Iñuraguabá Bungiu!</para>
  <para style="q" vid="PSA 74:22">Bageindagua buéigiñegua!</para>
  <para style="q" vid="PSA 74:22">Haritaguabá luagu merede lan hanabagunibu deré taganbun!<verse eid="PSA 74:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 74:23" />Mabulieidabei hagúaragun báganiñu,</para>
  <para style="q" vid="PSA 74:23">luma lawanserun hagúarahan ha mabuchahabaña bun.<verse eid="PSA 74:23" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" sid="PSA 75" />
  <para style="s1">Bungiu le aguseragüdübei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 75:1" />Seremei wamutibu, Bungiu,</para>
  <para style="q" vid="PSA 75:1">teinki wamutibu;</para>
  <para style="q" vid="PSA 75:1">wa wamuti biri,</para>
  <para style="q" vid="PSA 75:1">eremuha wagía luagu burí katei le badügübei.<verse eid="PSA 75:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 75:2" />Lariñahare Aburemei:</para>
  <para style="q" vid="PSA 75:2">«Danme lachülürün dan le nabusenrun,</para>
  <para style="q" vid="PSA 75:2">naguseragüdüba lau ísuruni.<verse eid="PSA 75:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 75:3" />Dan lánhingichun ubóu hau sun lílana,</para>
  <para style="q" vid="PSA 75:3">au ágüdahabalin lebu deregüdagu».<verse eid="PSA 75:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 75:4" />Nariñahare houn pántatiña hama wuribatiña:</para>
  <para style="q" vid="PSA 75:4">«Miñun lan hanaagun hungua mapantan huguyame;<verse eid="PSA 75:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 75:5" />maweirinlá hanaagun hungua luagu hubafu</para>
  <para style="q" vid="PSA 75:5">maweirigun ligíame haritagun huouguoun dan le hadimurehan».<verse eid="PSA 75:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 75:6" />Mama luéigiñe oubaü le labouchagüle weyu</para>
  <para style="q" vid="PSA 75:6">ni luéigiñe le lálüdagüle liabin aguseruni,</para>
  <para style="q" vid="PSA 75:6">ni luéigiñe nórute, ni luéigiñe suru;<verse eid="PSA 75:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 75:7" />Bungiu ligía aguseragüdübei;</para>
  <para style="q" vid="PSA 75:7">ǘnabugüda lumutiña híbiri, iñuragualaña híbiri.<verse eid="PSA 75:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 75:8" />Anihein aban kopu lúhaburugu Bungiu,</para>
  <para style="q" vid="PSA 75:8">buin tau diwéin héretu to lánina ligañi Bungiu,</para>
  <para style="q" vid="PSA 75:8">danme le léserunu diwéin,</para>
  <para style="q" vid="PSA 75:8">hátuboun wuribatiña ha ubouagubaña</para>
  <para style="q" vid="PSA 75:8">darí lagumuhóun tédederun.<verse eid="PSA 75:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 75:9" />Au nadimurehaba luagu Lubungiute Hakobu súnwandan,</para>
  <para style="q" vid="PSA 75:9">neremuhaba giñe lun,<verse eid="PSA 75:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 75:10" />ladüga lagünrinchagubei hapantan wuribatiña,</para>
  <para style="q" vid="PSA 75:10">gama lumoun laganwoundagüdübei habafu gürigia ha buídubaña.<verse eid="PSA 75:10" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" sid="PSA 76" />
  <para style="s1">Bungiu le gagañeiradibei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 76:1" />Subudiwati Bungiu Hudá;</para>
  <para style="q" vid="PSA 76:1">buiti ladimurehoun luagu liri hadan lánigu Ísüraeli.<verse eid="PSA 76:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 76:2" />Luáguñoun wübü le Sión litenpulun,</para>
  <para style="q" vid="PSA 76:2">uburugu Herusalén;<verse eid="PSA 76:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 76:3" />ñein láhalachaguoun burí lárumatena wuribu:</para>
  <para style="q" vid="PSA 76:3">Idaüdinaü, eféin tuma gimara.<verse eid="PSA 76:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 76:4" />Wéirigutibu Bungiu!</para>
  <para style="q" vid="PSA 76:4">Wéirigutibu sügǘ lau burí áraabu le magumuchadibei!<verse eid="PSA 76:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 76:5" />Ha ganigitimabaña aba lagidarúniwa sun hámati;</para>
  <para style="q" vid="PSA 76:5">ha héretimabaña, aba lásiñarun hadügün ni kata;</para>
  <para style="q" vid="PSA 76:5">arumuga hamuti lagumuhóun hadabagu!<verse eid="PSA 76:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 76:6" />Dan le bíchugun lúrudu,</para>
  <para style="q" vid="PSA 76:6">buguya Lubungiute Hakobu,</para>
  <para style="q" vid="PSA 76:6">siñati tánhingichun karü ni gabayu.<verse eid="PSA 76:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 76:7" />Hanarimetibu!</para>
  <para style="q" vid="PSA 76:7">Kaba san gayara lerederun lara bigibugiñe</para>
  <para style="q" vid="PSA 76:7">dan le bagañidun?<verse eid="PSA 76:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 76:8" />Lúmagiñe siélugiñe subudigüda bumuti baguseragüdün;</para>
  <para style="q" vid="PSA 76:8">aba lederaguagüdün múa ladüga lanufude,<verse eid="PSA 76:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 76:9" />dan le básaarun lun bíchugun irichaü, Bungiu,</para>
  <para style="q" vid="PSA 76:9">luma lun besefuruniña sun ha asufurirubaña ya ubouagu.<verse eid="PSA 76:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 76:10" />Sánsiguati ligañi gürigia lun alawahanime bun,</para>
  <para style="q" vid="PSA 76:10">lérügü murusun ligañi, ñǘbuinti lun biridinme!<verse eid="PSA 76:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 76:11" />Adüga humá füramasei lun Habureme le Hubungiute,</para>
  <para style="q" vid="PSA 76:11">gama lumoun gúnfuli humá luma;</para>
  <para style="q" vid="PSA 76:11">huguya le geyegubei lau le gadünabei lun inebewalá</para>
  <para style="q" vid="PSA 76:11">barǘ humá idewesei lun!<verse eid="PSA 76:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 76:12" />Gidá lumuti habagari gumadimatiña,</para>
  <para style="q" vid="PSA 76:12">hanufudegüdalaña lurúeitegu ubóu.<verse eid="PSA 76:12" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" sid="PSA 77" />
  <para style="s1">Saminaü luagu le ladügübei Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 77:1" />Agúahatina lun Bungiu</para>
  <para style="q" vid="PSA 77:1">lau umalali héreti lun laganbunina.<verse eid="PSA 77:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 77:2" />Weyu le hiru nan, áluaha numuti Nabureme,</para>
  <para style="q" vid="PSA 77:2">memeraaguntina luéi niñuruni núhabu</para>
  <para style="q" vid="PSA 77:2">afurieida lun sagü áriebu.</para>
  <para style="q" vid="PSA 77:2">Madaritu nuani gurasu.<verse eid="PSA 77:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 77:3" />Haritaguatina luagun Bungiu, aba nayahun;</para>
  <para style="q" vid="PSA 77:3">rédeitina asaminara, aba lábürühan narüna.<verse eid="PSA 77:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 77:4" />Nabureme, mígiruntibu lun nadouruni nagu;</para>
  <para style="q" vid="PSA 77:4">wéiriti nidiheri, darí lun siñá lan nadimurehan!<verse eid="PSA 77:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 77:5" />Saminatina luagun dan le sügühalibei;<verse eid="PSA 77:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 77:6" />haritaguatina luagu dan meha burí neremuhan áriebu.</para>
  <para style="q" vid="PSA 77:6">Saminatina nídangua, nariñaga:<verse eid="PSA 77:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 77:7" />«Lerederuba funagia Aburemei gáñiñu súnwandan?</para>
  <para style="q" vid="PSA 77:7">Marufudunya lubéi funagia lareini woun?<verse eid="PSA 77:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 77:8" />Gumuha funagia línsiñehabu?</para>
  <para style="q" vid="PSA 77:8">Gumuha funagia lidaradun wama?<verse eid="PSA 77:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 77:9" />Bulíeigua funagia Bungiu luéi lareini?</para>
  <para style="q" vid="PSA 77:9">Wéiriti funagia ligañi darí lun magudemehabuhaali lan?»<verse eid="PSA 77:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 77:10" />Létima gáribei nun,</para>
  <para style="q" vid="PSA 77:10">naritagun luagu mítaranhaali lan le Íñugutimabei wama</para>
  <para style="q" vid="PSA 77:10">kei meha lubaramegiua.<verse eid="PSA 77:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 77:11" />Naritagubei burí katei buiti</para>
  <para style="q" vid="PSA 77:11">le meha ladügübei Nabureme lidan dan lügüra,<verse eid="PSA 77:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 77:12" />nasaminaruba luagu sun le ladügübei.<verse eid="PSA 77:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 77:13" />Bungiu, sánduti burí bémeri;</para>
  <para style="q" vid="PSA 77:13">ka bungiu wéiribei kei buguya?<verse eid="PSA 77:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 77:14" />Buguya Búngiubei le adügübei katei wéinamuti!</para>
  <para style="q" vid="PSA 77:14">Arufuda bumuti bubafu houn néchanigu!<verse eid="PSA 77:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 77:15" />Sefu bumutiña bánigu lau bubafu,</para>
  <para style="q" vid="PSA 77:15">ha lirahüñü Hakobu hama lirahüñü Hosé.<verse eid="PSA 77:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 77:16" />Bungiu,</para>
  <para style="q" vid="PSA 77:16">dan le larihinbalibu barana, hanufudeguati;</para>
  <para style="q" vid="PSA 77:16">aba burí ladadagarun lilulin-agei lidunari;<verse eid="PSA 77:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 77:17" />ígiragüda lumuti burí dúeri huya,</para>
  <para style="q" vid="PSA 77:17">adürühati wayuhuru siélurugu,</para>
  <para style="q" vid="PSA 77:17">luma labirihaniga lidan sun fulasu.<verse eid="PSA 77:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 77:18" />Aganbúati bani wayuhuru lidan garabali héreti;</para>
  <para style="q" vid="PSA 77:18">harugoungati ubóu lau labirihaniga;</para>
  <para style="q" vid="PSA 77:18">aba lánhingichuni hárabaganali múa.<verse eid="PSA 77:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 77:19" />Sügütibu labadinaguagiñe barana;</para>
  <para style="q" vid="PSA 77:19">hiñuguatibu saragu duna,</para>
  <para style="q" vid="PSA 77:19">gama lumoun úati ni aban adariruti bugudárigi.<verse eid="PSA 77:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 77:20" />Alidihagüda bumutiña bumutuniña</para>
  <para style="q" vid="PSA 77:20">lun Moisesi luma Aarón keisi Mudún.<verse eid="PSA 77:20" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" sid="PSA 78" />
  <para style="s1">Bungiu hama lánigu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 78:1" />Nánigu, teni humá lun narufudahan;</para>
  <para style="q" vid="PSA 78:1">aganba huméi le nariñagubei hun!<verse eid="PSA 78:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 78:2" />Nadimureha lau hénpulu;</para>
  <para style="q" vid="PSA 78:2">nadimureha luagu burí katei</para>
  <para style="q" vid="PSA 78:2">le meha aramudaguati lúmagiñe binadu dan.<verse eid="PSA 78:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 78:3" />Le aganba wamaalibei subudi waméi,</para>
  <para style="q" vid="PSA 78:3">le habahüdagubei meha wagübürigu woun;<verse eid="PSA 78:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 78:4" />maramudun wabéi hawéi wasaanigu.</para>
  <para style="q" vid="PSA 78:4">Walawahabei Aburemei hama</para>
  <para style="q" vid="PSA 78:4">iseri gürigia ha lúnbaña hayabin,</para>
  <para style="q" vid="PSA 78:4">wadimurehaba luagu lubafu</para>
  <para style="q" vid="PSA 78:4">luma burí luagu katei buiti le ladügübei.<verse eid="PSA 78:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 78:5" />Adügati Bungiu aban lúrudu lun Hakobu;</para>
  <para style="q" vid="PSA 78:5">ariñagati houn lánigu Ísüraeli,</para>
  <para style="q" vid="PSA 78:5">ida luba lan hóuserun</para>
  <para style="q" vid="PSA 78:5">ariñaga ligía houn wagüchagu</para>
  <para style="q" vid="PSA 78:5">lun harufudahani houn hadügawagun,<verse eid="PSA 78:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 78:6" />subudi hamaamugei iseri gürigia ha lúnbaña hayabin ubouagun,</para>
  <para style="q" vid="PSA 78:6">isaanigu ha lúnbaña hágurahoun,</para>
  <para style="q" vid="PSA 78:6">arufudaha hameime isaanigu hagía houn hasaanigu;<verse eid="PSA 78:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 78:7" />lun hafiñerun luagu Bungiu,</para>
  <para style="q" vid="PSA 78:7">mabulieidun hameime le ladügübei;</para>
  <para style="q" vid="PSA 78:7">lun hagunfulirun luma lugumadin<verse eid="PSA 78:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 78:8" />lun mamaganbadi hamá</para>
  <para style="q" vid="PSA 78:8">kei hagüchagu ha meha úabei deregüdaü</para>
  <para style="q" vid="PSA 78:8">tidan hanigi luma lidan hani sífiri;</para>
  <para style="q" vid="PSA 78:8">ha meha magunfulirunbaña luma Bungiu!<verse eid="PSA 78:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 78:9" />Ha lani Éfürain türibu,</para>
  <para style="q" vid="PSA 78:9">ha meha táubaña gimara,</para>
  <para style="q" vid="PSA 78:9">ru hamuti hanagan lidan luéyuri wuribu;<verse eid="PSA 78:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 78:10" />minebenti hadaradun luma Bungiu houn,</para>
  <para style="q" vid="PSA 78:10">maha hagía lun hagunfulirun luma larufudahan.<verse eid="PSA 78:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 78:11" />Bulíei hamuti le buga ladügübei,</para>
  <para style="q" vid="PSA 78:11">katei buíduburiti le larufudubei houn.<verse eid="PSA 78:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 78:12" />Adügati buga Bungiu saragu katei buiti hagibugiñe hagübürigu</para>
  <para style="q" vid="PSA 78:12">lóubawagu Soán le uburugubei Ehiptu:<verse eid="PSA 78:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 78:13" />fánreingua lumuti barana,</para>
  <para style="q" vid="PSA 78:13">aba hásügürün Ísüraelina labadinaguagiñe</para>
  <para style="q" vid="PSA 78:13">liñuraguati barana hóubawagugiñe kei baríeiru.<verse eid="PSA 78:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 78:14" />Adundeha lumutiña wéyuagu lábugiñe aban dúeri,</para>
  <para style="q" vid="PSA 78:14">áriebu lábugiñe aban larugounga lauti watu gemeti.<verse eid="PSA 78:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 78:15" />Fánreingua lumuti dübü lidan fulasu mageirawati</para>
  <para style="q" vid="PSA 78:15">aba hatun duna darí lagidarun hamagürabu.<verse eid="PSA 78:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 78:16" />Adügati Bungiu lun láwiyurun</para>
  <para style="q" vid="PSA 78:16">duna le éibaaguati lídangiñe dübü!<verse eid="PSA 78:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 78:17" />Gama lumoun afigouhamémetiña ligibugiñe Bungiu;</para>
  <para style="q" vid="PSA 78:17">iñuraguatiña houngua luagun Bungiu</para>
  <para style="q" vid="PSA 78:17">lidan fulasu mageirawati.<verse eid="PSA 78:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 78:18" />Álugatiña hóuchaguni lau hamuriahan éigini kei habusenrun.<verse eid="PSA 78:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 78:19" />Adimurehatiña wuriba luagu, hariñagati:</para>
  <para style="q" vid="PSA 78:19">«Gayaraabei funagia léheraagun woun</para>
  <para style="q" vid="PSA 78:19">lidan fulasu mageirawati?<verse eid="PSA 78:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 78:20" />Inarüni luagu bougua lani Bungiu dübü;</para>
  <para style="q" vid="PSA 78:20">ani áwiyuha lan giñe duna lídangiñe dübü ligía</para>
  <para style="q" vid="PSA 78:20">kei aban duna éibaaguati,</para>
  <para style="q" vid="PSA 78:20">aba labuinchun múa, gama lumoun,</para>
  <para style="q" vid="PSA 78:20">gayaraabei funa san giñe líchugun fein</para>
  <para style="q" vid="PSA 78:20">luma úi houn lumutuniña?»<verse eid="PSA 78:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 78:21" />Dan laganbunbalin Aburemei katei le, aba lagañidun;</para>
  <para style="q" vid="PSA 78:21">aba ladurangun ligañi kei watu gemeti hawagun lánigu Hakobu!<verse eid="PSA 78:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 78:22" />Ladüga mafiñerun hamá luagu Bungiu</para>
  <para style="q" vid="PSA 78:22">mafiñen hagía luagu lídehan.<verse eid="PSA 78:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 78:23" />Lau sun lira, aba líchugun Bungiu dimurei lun dúeri</para>
  <para style="q" vid="PSA 78:23">aba ladaaruni lubenari sielu;<verse eid="PSA 78:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 78:24" />aba láhuyagüdün maná,</para>
  <para style="q" vid="PSA 78:24">türigu siélugiñeti houn lumutuniña lun heigin!<verse eid="PSA 78:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 78:25" />Hóutiña lubeiti gürigia heigan ánheligu fein!</para>
  <para style="q" vid="PSA 78:25">Hóugüda lumutiña Bungiu darí hakimuledun!<verse eid="PSA 78:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 78:26" />Aba láfurun ligarabalin labouchagüle weyu</para>
  <para style="q" vid="PSA 78:26">luma áraabugiñeti siélugiñe;</para>
  <para style="q" vid="PSA 78:26">lanügün Bungiu lau lubafu!<verse eid="PSA 78:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 78:27" />Áhuyagüdati úi houn lumutuniña;</para>
  <para style="q" vid="PSA 78:27">ábürühatiña dunuru houn kei sagoun baranahana!<verse eid="PSA 78:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 78:28" />Ábürügüda lumutiña Bungiu</para>
  <para style="q" vid="PSA 78:28">tamidoun hakianpun luma geyegua tau.<verse eid="PSA 78:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 78:29" />Aba heigin darí hakimuledun,</para>
  <para style="q" vid="PSA 78:29">ítara liña lubeiti líchuguni Bungiu le habusenrubei houn.<verse eid="PSA 78:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 78:30" />Gama lumoun másugili yebe heigin,</para>
  <para style="q" vid="PSA 78:30">aniheingua yebe éigini hayumulugu,<verse eid="PSA 78:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 78:31" />danbei lábürühan ligañi Bungiu hawagun</para>
  <para style="q" vid="PSA 78:31">aba láfaraguniña wügüriña ha héretimabaña.</para>
  <para style="q" vid="PSA 78:31">Hilagüda lumutiña habuidun-agei nibureintiña</para>
  <para style="q" vid="PSA 78:31">hádangiñe lánigu Ísüraeli!<verse eid="PSA 78:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="PSA 78:32" />Lau sun lira ábaya hafigouhan;</para>
  <para style="q" vid="PSA 78:32">mafiñeruntiña luagu burí lubuidun katei le ladügübei Bungiu.<verse eid="PSA 78:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 78:33" />Ligía lagumuchaguagüdünbaliña Bungiu</para>
  <para style="q" vid="PSA 78:33">kamá hamuga aban awaraguni,</para>
  <para style="q" vid="PSA 78:33">labadinagua aban katei lánina anufudei.<verse eid="PSA 78:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 78:34" />Danha le láfaragun Bungiu hádangiñe,</para>
  <para style="q" vid="PSA 78:34">ligíaha háluahani ha híbiri,</para>
  <para style="q" vid="PSA 78:34">ábaha hagiribudun lun,</para>
  <para style="q" vid="PSA 78:34">aba háluahani memeraagunga;<verse eid="PSA 78:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 78:35" />ligíaha haritagun luagun Bungiu</para>
  <para style="q" vid="PSA 78:35">lun lóunigiruniña luma lun lesefuruniña.<verse eid="PSA 78:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 78:36" />Gama lumoun hariñagaha iyeeni buíduburiti lun</para>
  <para style="q" vid="PSA 78:36">lau hayuma tuma hañeñe,<verse eid="PSA 78:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 78:37" />ladüga magunfulirun hamá lau hadaradun luma</para>
  <para style="q" vid="PSA 78:37">ni aban wéiyaasu.<verse eid="PSA 78:37" /></para>
  <para style="b" />
  <para style="q">
    <verse number="38" style="v" sid="PSA 78:38" />Gama lumoun gudemeheitiña lun Bungiu,</para>
  <para style="q" vid="PSA 78:38">ábaha feruduna lániña magünrinchagun lumutiñaha;</para>
  <para style="q" vid="PSA 78:38">saraguha wéiyaasu, ígira lumuti agañiduni</para>
  <para style="q" vid="PSA 78:38">aba mígiraguagüdün lan lungua lun igañi.<verse eid="PSA 78:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 78:39" />Haritagua lumuti Bungiu luagu wügüriña lan hagía,</para>
  <para style="q" vid="PSA 78:39">luagu ítara haña lan kei garabali le ñǘdünbei</para>
  <para style="q" vid="PSA 78:39">ani magiribudúnhali.<verse eid="PSA 78:39" /></para>
  <para style="b" />
  <para style="q">
    <verse number="40" style="v" sid="PSA 78:40" />Gíbeti wéiyaasu híchugun mebereseni lau le lubeibei Bungiu</para>
  <para style="q" vid="PSA 78:40">gáñigüda haméi lidan fulasu mageirawati!<verse eid="PSA 78:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 78:41" />Ábayaha hóuchaguni,</para>
  <para style="q" vid="PSA 78:41">híruguagüda hamutiha Lubungiute Ísüraeli!<verse eid="PSA 78:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 78:42" />Maritaguntiña luagun weyu lügüra</para>
  <para style="q" vid="PSA 78:42">dan le lesefurunbaliña Bungiu</para>
  <para style="q" vid="PSA 78:42">lau lubafu hawéi háganiñu;<verse eid="PSA 78:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 78:43" />dan le ladügünbei burí katei wéinamuti</para>
  <para style="q" vid="PSA 78:43">le garíawaseti yágüta lóubawagu Ehiptu;<verse eid="PSA 78:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 78:44" />dan le lasaliraguagüdünbalin burí lidunari Ehiptu hítaüme,</para>
  <para style="q" vid="PSA 78:44">darí lun siñá lan hátuni Ehiptuna.<verse eid="PSA 78:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 78:45" />Óunahati gunga hawagun hama húa,</para>
  <para style="q" vid="PSA 78:45">lun hagünrinchaguni sun katei;<verse eid="PSA 78:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 78:46" />derege lumuti le halubahabei lídangiñe hachari</para>
  <para style="q" vid="PSA 78:46">le hawadigimaribei houn chagagaru.<verse eid="PSA 78:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 78:47" />Günringua lumuti hanadürigu</para>
  <para style="q" vid="PSA 78:47">lau lúbara huya dereguati luma dübü.<verse eid="PSA 78:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 78:48" />Hilaguatiña halügüniña bágasu hama mudún</para>
  <para style="q" vid="PSA 78:48">lábugiñe lúbara huya dereguati luma labirihaniga;<verse eid="PSA 78:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 78:49" />óunaha lumuti Bungiu ligañi hawagun:</para>
  <para style="q" vid="PSA 78:49">Igañi, asiadirúni luma idiheri,</para>
  <para style="q" vid="PSA 78:49">kei óunagüleigu lánina wuribani.<verse eid="PSA 78:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 78:50" />Aba lígiraguagüdün lungua lun ligañi!</para>
  <para style="q" vid="PSA 78:50">Úati feruduna lani habagari,</para>
  <para style="q" vid="PSA 78:50">deregerügü lumutiña lun óunweni;<verse eid="PSA 78:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 78:51" />áfaragua lumutiña furumiñetiña</para>
  <para style="q" vid="PSA 78:51">hasaanigu sun tílana muna Ehiptuna!<verse eid="PSA 78:51" /></para>
  <para style="b" />
  <para style="q">
    <verse number="52" style="v" sid="PSA 78:52" />Sagá lumutiña Ísüraelina ñéingiñe kei mudún;</para>
  <para style="q" vid="PSA 78:52">alidiha lumutiña lumutuniña labadinagua fulasu mageirawati;<verse eid="PSA 78:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 78:53" />barǘ lumutiña luéigiñe üma chóuruti</para>
  <para style="q" vid="PSA 78:53">lun manufudebaña lan;</para>
  <para style="q" vid="PSA 78:53">ánhaña háganiñu, daruguati barana hau.<verse eid="PSA 78:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 78:54" />Barǘ lumutiña Bungiu lánigu lidoun fulasu le sándubei;</para>
  <para style="q" vid="PSA 78:54">lidoun áraabu le guánarügü lagañeirubei!<verse eid="PSA 78:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 78:55" />Gidá lumutiña gibe tubungiutegu hagibugiñe Ísüraelina,</para>
  <para style="q" vid="PSA 78:55">fánreingualei múa houn lánigu hadan hani türibu,</para>
  <para style="q" vid="PSA 78:55">aganawagüdalaña tidan kianpu-agei.<verse eid="PSA 78:55" /></para>
  <para style="b" />
  <para style="q">
    <verse number="56" style="v" sid="PSA 78:56" />Gama lumoun aba hóuchaguni Bungiu le Íñugutimabei</para>
  <para style="q" vid="PSA 78:56">lau hiñuragun houngua luagun,</para>
  <para style="q" vid="PSA 78:56">ani magunfulirun haméi lugumadin;<verse eid="PSA 78:56" /></para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 78:57" />aba hígiruni Bungiu,</para>
  <para style="q" vid="PSA 78:57">magunfuliruntiña ítara kei meha hadüga hagübürigu,</para>
  <para style="q" vid="PSA 78:57">guribiguatiña kei tebu gimara le mederebuguti!<verse eid="PSA 78:57" /></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 78:58" />Gáñigüda hamuti lau burí hani latarü houn habungiutegu</para>
  <para style="q" vid="PSA 78:58">huduguatiña houn guáriua, emeidigüda hamuti.<verse eid="PSA 78:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 78:59" />Gáñiti Bungiu dan larihinbalin katei le</para>
  <para style="q" vid="PSA 78:59">aba labuguniña Ísüraelina luáriua;<verse eid="PSA 78:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 78:60" />aba lígirunu lisanduariun to Siloboun,</para>
  <para style="q" vid="PSA 78:60">to meha lúbanboun hadan gürigia.<verse eid="PSA 78:60" /></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 78:61" />Ígirati lun hanügünu láganiñu bágüsi lánina daradu</para>
  <para style="q" vid="PSA 78:61">to arufudubalin luéirigun luma lubafu.<verse eid="PSA 78:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 78:62" />Wéiriti lagañidun hama lánigu,</para>
  <para style="q" vid="PSA 78:62">darí lun lederegeruniña tun hefeinte háganiñu.<verse eid="PSA 78:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 78:63" />Aba hóunwegun nibureintiña gudawarügü;</para>
  <para style="q" vid="PSA 78:63">aba lúadun uremu lánina maríei houn adarigu!<verse eid="PSA 78:63" /></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 78:64" />Áfarawaguatiña fádirigu tau eféin,</para>
  <para style="q" vid="PSA 78:64">ani mayahuahantiña hámarigu hárigi.<verse eid="PSA 78:64" /></para>
  <para style="b" />
  <para style="q">
    <verse number="65" style="v" sid="PSA 78:65" />Gama lumoun aba lagagudun Bungiu</para>
  <para style="q" vid="PSA 78:65">kamá lídangiñe aban idabagu,</para>
  <para style="q" vid="PSA 78:65">kei aban wuriburuguna le agiribudaguti</para>
  <para style="q" vid="PSA 78:65">lárigoun tídangiñe diwéin,<verse eid="PSA 78:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 78:66" />aba láfaraguniña láganiñu, aba hanurahan luéi;</para>
  <para style="q" vid="PSA 78:66">ru lumutiña lidan busiganu lun súnwandan!<verse eid="PSA 78:66" /></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 78:67" />Bugá lumutiña giñe tílana luban Hosé luáriua;</para>
  <para style="q" vid="PSA 78:67">manúadirun lumutiña lani Éfürain türibu;<verse eid="PSA 78:67" /></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 78:68" />lubaragiñe lira aba lanúadiruniña lani Hudá türibu;</para>
  <para style="q" vid="PSA 78:68">luma wübü Sión le hínsiñebei lun.<verse eid="PSA 78:68" /></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 78:69" />Aba lábunagunu lisanduariun, íñutu kei sielu,</para>
  <para style="q" vid="PSA 78:69">derebugugüdaloun lun súnwandan kei múa le ladügübei.<verse eid="PSA 78:69" /></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 78:70" />Anúadira lumuti Dawidi,</para>
  <para style="q" vid="PSA 78:70">le meha amainihabei mudún,<verse eid="PSA 78:70" /></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 78:71" />aba lagidaruni luéi lerederun hárigi hárigi mudún,</para>
  <para style="q" vid="PSA 78:71">lun lóunigiruniña lumutuniña Bungiu,</para>
  <para style="q" vid="PSA 78:71">lun ligíaba lan amainiraña Ísüraelina.<verse eid="PSA 78:71" /></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 78:72" />Aba lóunigiruniña Dawidi lumutuniña Bungiu;</para>
  <para style="q" vid="PSA 78:72">góunigilaña ani alidiha lau úhabu benefati</para>
  <para style="q" vid="PSA 78:72">tuma anigi harumatu.<verse eid="PSA 78:72" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" sid="PSA 79" />
  <para style="s1">Igarigu luagu lagünrinchawaguniwa Herusalén</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 79:1" />Bungiu,</para>
  <para style="q" vid="PSA 79:1">beluhaña gibe tubungiutegu lidoun bibürürün,</para>
  <para style="q" vid="PSA 79:1">adügaaña iwiyei tidan buban to sánduboun,</para>
  <para style="q" vid="PSA 79:1">ru hamaali Herusalén lidoun günringuaü!<verse eid="PSA 79:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 79:2" />Ru hamaali hágubu bubueingu,</para>
  <para style="q" vid="PSA 79:2">ha meha gúnfulibaña buma,</para>
  <para style="q" vid="PSA 79:2">lun héiginiña wadubi, hama animaalu áraabuna!<verse eid="PSA 79:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 79:3" />Áwiyugüda hamaali</para>
  <para style="q" vid="PSA 79:3">hata kei duna lidan sun Herusalén,</para>
  <para style="q" vid="PSA 79:3">ani úatiña kaba lan ábunaña!<verse eid="PSA 79:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 79:4" />Héheraagüleñadiwa wabesinanigu;</para>
  <para style="q" vid="PSA 79:4">héheraagüle sun ha geyegubaña wau.<verse eid="PSA 79:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 79:5" />Aburemei,</para>
  <para style="q" vid="PSA 79:5">ídaba san lagumucha bigañi?</para>
  <para style="q" vid="PSA 79:5">Legemechuba san bigañi kei watu gemeti súnwandan?<verse eid="PSA 79:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 79:6" />Rariguagüdabei bigañi</para>
  <para style="q" vid="PSA 79:6">hawagun gibe tubungiutegu</para>
  <para style="q" vid="PSA 79:6">ha ibidiñehabubaña bun, magúahan hamabu!<verse eid="PSA 79:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 79:7" />Ladüga hagía, günringua hamuti Hakobu</para>
  <para style="q" vid="PSA 79:7">ígira haméi fulasu lidan günringuaü.<verse eid="PSA 79:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 79:8" />Mafayeiragüdabawa luagu hariban wagüchagu.</para>
  <para style="q" vid="PSA 79:8">Ñǘbuinla bugudemehabu wabaroun furese,</para>
  <para style="q" vid="PSA 79:8">ladüga buchá wawagu!<verse eid="PSA 79:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 79:9" />Bungiu, wesefuragüle,</para>
  <para style="q" vid="PSA 79:9">íderaguabawa, sefubáwa ferudunabáwame,</para>
  <para style="q" vid="PSA 79:9">luagu luéirigun biri!<verse eid="PSA 79:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 79:10" />Mariñagun hamaamuga gibe tubungiutegu wawagu:</para>
  <para style="q" vid="PSA 79:10">«Hagéi san Habungiute?»</para>
  <para style="q" vid="PSA 79:10">Ígiraba lun warihini hafayeirun</para>
  <para style="q" vid="PSA 79:10">luagu háfarawagun eseriwidutiña bun!</para>
  <para style="q" vid="PSA 79:10">Subudi haméi giñe gibe tubungiutegu!<verse eid="PSA 79:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 79:11" />Tenibá lun hafuledein adaürǘtiña,</para>
  <para style="q" vid="PSA 79:11">sefubáña lau bubafu ha siádiwaañabaña lun hounwen.<verse eid="PSA 79:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 79:12" />Aburemei,</para>
  <para style="q" vid="PSA 79:12">fáyeigüdabaña wabesinanigu</para>
  <para style="q" vid="PSA 79:12">sedü wéiyaasu luagu hanabagunibu;<verse eid="PSA 79:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 79:13" />wagíameti ha bánigu,</para>
  <para style="q" vid="PSA 79:13">wagía ha bilügüniña mudún,</para>
  <para style="q" vid="PSA 79:13">seremei wabadibu súnwandan;</para>
  <para style="q" vid="PSA 79:13">weremuhaba bun gumugua dan.<verse eid="PSA 79:13" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" sid="PSA 80" />
  <para style="s1">Buidulá barihin wawagun!</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 80:1" />Lúniri Ísüraeli,</para>
  <para style="q" vid="PSA 80:1">buguya le adundehabalin Hosé kei mudún,</para>
  <para style="q" vid="PSA 80:1">buguya le aniheinbei lálana barúeihan hóugiñe kátaña garünatiña,</para>
  <para style="q" vid="PSA 80:1">aganbabá! Arihabéi Éfürain,<verse eid="PSA 80:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 80:2" />Benhamín luma Manasési lau agu buiti!</para>
  <para style="q" vid="PSA 80:2">Agaguduabá, higabu besefurawa lau bubafu!<verse eid="PSA 80:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 80:3" />Bungiu,</para>
  <para style="q" vid="PSA 80:3">adügabá lun wayabin lun ítara wamá kei wabéi meha!</para>
  <para style="q" vid="PSA 80:3">Arihabáwa lau agu buiti ábame wesefurun!<verse eid="PSA 80:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 80:4" />Aburemei, Bungiu Suntigabafu,</para>
  <para style="q" vid="PSA 80:4">ídaba san lagumucha bagañidun lun hafurieidun bánigu?<verse eid="PSA 80:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 80:5" />Rúhadibu águiraü woun leweñegua éigini,</para>
  <para style="q" vid="PSA 80:5">saragu águiraü leweñegua uniñein.<verse eid="PSA 80:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 80:6" />Adüga báadiwa héheraagüleme néchanigu ha wabesinan,</para>
  <para style="q" vid="PSA 80:6">éherahatiña wáganiñu wau.<verse eid="PSA 80:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 80:7" />Bungiu Suntigabafu,</para>
  <para style="q" vid="PSA 80:7">adügabá lun wayabin lun ítara wamá kei wabéi meha!</para>
  <para style="q" vid="PSA 80:7">Arihabáwa lau lubuidun agu,</para>
  <para style="q" vid="PSA 80:7">ábame wesefurun!<verse eid="PSA 80:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 80:8" />Sagatibu aban lídibu beibei Ehiptugiñe,</para>
  <para style="q" vid="PSA 80:8">bugá bumutiña gibe tubungiutegu, aba bábununi.<verse eid="PSA 80:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 80:9" />Harumagüdatibu lau,</para>
  <para style="q" vid="PSA 80:9">aba líchugun lídibu beibei ílagülei,</para>
  <para style="q" vid="PSA 80:9">aba labuinchun fulasu lau.<verse eid="PSA 80:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 80:10" />Daruguati lau burí áraabu lau lamuñoungadüna,</para>
  <para style="q" vid="PSA 80:10">darugua ligía lau burí lídibu wewe le íñutimabei lau lilimun.<verse eid="PSA 80:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 80:11" />Chülüti lilimun chülǘ baranahoun,</para>
  <para style="q" vid="PSA 80:11">chülǘ láhüchagun dagá lidoun duna le Éufüratesi.<verse eid="PSA 80:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 80:12" />Ka san uagu bágurei baríeiru le geyegubei lau?</para>
  <para style="q" vid="PSA 80:12">Guentoti ha ásügürütiña ǘmadarugugiñe</para>
  <para style="q" vid="PSA 80:12">gayaraati híweruhani beibei.<verse eid="PSA 80:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 80:13" />Günringua hamutu buíruhu áraabuna;</para>
  <para style="q" vid="PSA 80:13">günringua hamutu animaalugu áraabuna!<verse eid="PSA 80:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 80:14" />Bungiu Suntigabafu, giribubá arihabá siélugiñe,</para>
  <para style="q" vid="PSA 80:14">gudemelá lídibu beibei le bun,<verse eid="PSA 80:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 80:15" />lídibu beibei le bábunubei,</para>
  <para style="q" vid="PSA 80:15">láhüchagun le bederebudagüdübei.<verse eid="PSA 80:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 80:16" />Ha átühabarun gudá hamóun,</para>
  <para style="q" vid="PSA 80:16">günringuabaña lau bigañi;<verse eid="PSA 80:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 80:17" />gama lumoun íderaguabei gürigia le banúadirubei,</para>
  <para style="q" vid="PSA 80:17">láhüchagun wügüri le bederebudagüdübei,<verse eid="PSA 80:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 80:18" />ábame madisedundigiaadiwa lan buéi.</para>
  <para style="q" vid="PSA 80:18">Ruba ibagari woun, ábame bírirügü lan waguaha.<verse eid="PSA 80:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 80:19" />Aburemei, Bungiu Suntigabafu,</para>
  <para style="q" vid="PSA 80:19">adügabá lun wayabin lun ítara wamá kei wabéi meha!</para>
  <para style="q" vid="PSA 80:19">Arufudabéi bínsiñehabu woun, ábame wesefurun!<verse eid="PSA 80:19" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" sid="PSA 81" />
  <para style="s1">Luriban Ísüraeli luma lareini Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 81:1" />Heremuha lau ugundani lun Bungiu,</para>
  <para style="q" vid="PSA 81:1">ladüga ligía lan wérebei!</para>
  <para style="q" vid="PSA 81:1">Heremuha lau agúarahani lánina ugundani</para>
  <para style="q" vid="PSA 81:1">lun Lubungiute Hakobu!<verse eid="PSA 81:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 81:2" />Heremuha áfareina panderu,</para>
  <para style="q" vid="PSA 81:2">luma libimen tamuri sun tuwuyeri árüpa.<verse eid="PSA 81:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 81:3" />Win humóun fidu lídanme lachülürün iseri hati,</para>
  <para style="q" vid="PSA 81:3">ítarameme giñe lídanme lachülürün fulenu,</para>
  <para style="q" vid="PSA 81:3">ligía luéyuribei óunwenbu wafedun.<verse eid="PSA 81:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 81:4" />Ladüga anihán gumadi le líchugubei</para>
  <para style="q" vid="PSA 81:4">Lubungiute Hakobu lun Ísüraeli;<verse eid="PSA 81:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 81:5" />ligía gumadi le ichugúbei lun Hosé</para>
  <para style="q" vid="PSA 81:5">dan le láfuridunbei Bungiu ageindagua kóntüra Ehiptu.</para>
  <para style="b" vid="PSA 81:5" />
  <para style="q" vid="PSA 81:5">Aganbatina lariñagun aban umalali le ibidiñeti meha nun:<verse eid="PSA 81:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 81:6" />«Gidá naali banügün bégewagugiñe,</para>
  <para style="q" vid="PSA 81:6">gidá naali wadagimanu dereti buéi.<verse eid="PSA 81:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 81:7" />Wátibu nuagu lidan bidiheri, aba nesefurunibu;</para>
  <para style="q" vid="PSA 81:7">óunaba numutibu lídangiñe dúeri le adürühabei,</para>
  <para style="q" vid="PSA 81:7">hóuchagua numutibu laru duna le Meribá.<verse eid="PSA 81:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 81:8" />Aganba huméi neweridihan nánigu,</para>
  <para style="q" vid="PSA 81:8">baganbana hamugadügü Ísüraeli!<verse eid="PSA 81:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 81:9" />Mabungiutebá búngiugu terencha;</para>
  <para style="q" vid="PSA 81:9">máhuduraguaba houn búngiugu terencha.<verse eid="PSA 81:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 81:10" />Au Bubungiutebei;</para>
  <para style="q" vid="PSA 81:10">le asagarubadibu Ehiptugiñe;</para>
  <para style="q" vid="PSA 81:10">wagaba ábame nakimuledagüdünibu.<verse eid="PSA 81:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 81:11" />Gama lumoun máhatiña nánigu haganbunina;</para>
  <para style="q" vid="PSA 81:11">máhati Ísüraeli ladügüni le nubeibei!<verse eid="PSA 81:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 81:12" />Ligía nígirunbaliña lun hasigirun adügei le habusenrubei,</para>
  <para style="q" vid="PSA 81:12">aba habagaridun keisi hagundan.<verse eid="PSA 81:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 81:13" />Lun hamuga buga aganba hamanina nánigu!</para>
  <para style="q" vid="PSA 81:13">Lun hamuga falá hamani Ísüraelina némeri,<verse eid="PSA 81:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 81:14" />nǘnabudagüdüñanu hamuga háganiñu lidan murusun dan,</para>
  <para style="q" vid="PSA 81:14">áfaraguanaña hamuga ha ageindagubaña hama!<verse eid="PSA 81:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 81:15" />Hábürühaña hamuga ha iyereehabúbaña lun Bungiu ligibugiñe</para>
  <para style="q" vid="PSA 81:15">aba hamuga hasiadirúniwa lun súnwandan.<verse eid="PSA 81:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 81:16" />Léigagüdüñein hamuga Bungiu lubuidun-agei türigu houn lánigu,</para>
  <para style="q" vid="PSA 81:16">gidaléi hamuga hamagürabu lau sírudu áraabuna».<verse eid="PSA 81:16" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" sid="PSA 82" />
  <para style="s1">Bungiu, aguseragüdüti le Íñugutimabei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 82:1" />Bungiu aguseragüdübei lidan hóundaragun búngiugu</para>
  <para style="q" vid="PSA 82:1">ani líchuguni lasiadirun haganagua ítara:<verse eid="PSA 82:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 82:2" />«Ídaba san lásura hadügün aguseragüdüni le marichati,</para>
  <para style="q" vid="PSA 82:2">lun híchaagun hungua luéigiñe hafulesein wuribatiña?<verse eid="PSA 82:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 82:3" />Ru huméi haricha débilitiña hama méteñuhaña houn!</para>
  <para style="q" vid="PSA 82:3">Ru huméi haricha ha gudemebaña houn hama ha mégeihabubaña!<verse eid="PSA 82:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 82:4" />Sefu humaña ha mérebaña hama ha gudemebaña</para>
  <para style="q" vid="PSA 82:4">sefu humaña hawéi wuribatiña!»<verse eid="PSA 82:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 82:5" />«Anhein huguya, ibidiñeti ni kata hun,</para>
  <para style="q" vid="PSA 82:5">úati gunfuranda humá;</para>
  <para style="q" vid="PSA 82:5">lidan luburiga haganawa.</para>
  <para style="q" vid="PSA 82:5">Adadagaragüda humuti lebu ubóu.<verse eid="PSA 82:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 82:6" />Ariñagatina luagu búngiugu humá;</para>
  <para style="q" vid="PSA 82:6">luagu lirahüñü humá Bungiu le Íñugutimabei.<verse eid="PSA 82:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 82:7" />Lau sun lira, hóunweguba kei furumiñeguarügü gürigia,</para>
  <para style="q" vid="PSA 82:7">hábürühaba kei furumiñeguarügü urúei le wuribati!»<verse eid="PSA 82:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 82:8" />Bungiu, aransebá lun baguseragüdüniña lílana ubóu,</para>
  <para style="q" vid="PSA 82:8">ladüga buguya laburemebei sun néchani!<verse eid="PSA 82:8" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" sid="PSA 83" />
  <para style="s1">Afurieiduni amuriahei lídehan Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 83:1" />Bungiu, merederabá maniñu!</para>
  <para style="q" vid="PSA 83:1">Merederabá deregüdagu mariñagunga ni kata!<verse eid="PSA 83:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 83:2" />Arihabáña báganiñu, ha iyereehabúbaña bun:</para>
  <para style="q" vid="PSA 83:2">Chagaguatiña iñuragua hagía houngua buagun.<verse eid="PSA 83:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 83:3" />Eledeguatiña lun hadügün wuribati houn bánigu,</para>
  <para style="q" vid="PSA 83:3">lun hadügün wuribati houn ha bóunigirubaña!<verse eid="PSA 83:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 83:4" />Haritaguaaña hayabin agünrinchaguawa</para>
  <para style="q" vid="PSA 83:4">lun wagumuchagun ligibuagugiñe ubóu keisi néchani,</para>
  <para style="q" vid="PSA 83:4">lun maritawagúnwaali lan liri Ísüraeli.<verse eid="PSA 83:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 83:5" />Adügaaña aban daradu kóntüra buguya,</para>
  <para style="q" vid="PSA 83:5">eledeguaaña kei ábanrügü gürigia,<verse eid="PSA 83:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 83:6" />añahán burí áganiñu hagía:</para>
  <para style="q" vid="PSA 83:6">Ha tílana likianpun-agei Edomu ha ladügawagun Ísümaeli,</para>
  <para style="q" vid="PSA 83:6">tadügawagun Agarü ha aganóubaña Moabü,<verse eid="PSA 83:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 83:7" />Gebalina, Amonna, Amaléküna,</para>
  <para style="q" vid="PSA 83:7">hama Filistéana ha aganóubaña Tiru;<verse eid="PSA 83:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 83:8" />óundaraaña giñe Asiriana hama,</para>
  <para style="q" vid="PSA 83:8">ani hagía arünaübaña héreti houn lirahüñü Lotu.<verse eid="PSA 83:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 83:9" />Adügabá houn kei badüga houn Madianna,</para>
  <para style="q" vid="PSA 83:9">kei badüga lun Sísara luma Habín</para>
  <para style="q" vid="PSA 83:9">lidan duna le gíribei Kisón,<verse eid="PSA 83:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 83:10" />ha agünrinchawagubaña Endoru;</para>
  <para style="q" vid="PSA 83:10">ha adügǘbaña lun hádigame animaalu múarugu!<verse eid="PSA 83:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 83:11" />Adügabá houn gürigia ha wéirigubaña ñein</para>
  <para style="q" vid="PSA 83:11">kei badüga lun Orebü luma lun Seebü;</para>
  <para style="q" vid="PSA 83:11">adügabá houn sun hábutigu</para>
  <para style="q" vid="PSA 83:11">kei badüga lun Seba luma lun Salümuná,<verse eid="PSA 83:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 83:12" />ha yebe abusenrubaña hóuyedun lau lumúan Bungiu.<verse eid="PSA 83:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 83:13" />Nubungiute, adügabá lun habalabahan kei ubanaü,</para>
  <para style="q" vid="PSA 83:13">kei sagadi sáühali le lanügün garabali;<verse eid="PSA 83:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 83:14" />ani ítara kei láguduni watu gemeti dabíara</para>
  <para style="q" vid="PSA 83:14">gumuguagüdalei wübü lau ligeme,<verse eid="PSA 83:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 83:15" />ítarala béibaahaniña lau luriban dan</para>
  <para style="q" vid="PSA 83:15">adüga buguyame lun hanufudedun lau herigini.<verse eid="PSA 83:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 83:16" />Rúbaña lidoun busiganu, Aburemei,</para>
  <para style="q" vid="PSA 83:16">áluaha hamaamugabu;<verse eid="PSA 83:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 83:17" />nibusigarigüdawa hamá lun súnwandan,</para>
  <para style="q" vid="PSA 83:17">hilagua hagíame lau busiganu!<verse eid="PSA 83:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 83:18" />Subudi haméi luagu buguyarügüñein lan Aburemei,</para>
  <para style="q" vid="PSA 83:18">buguyarügüñein lan le Íñugutimabei ligibuagu sun ubóu!<verse eid="PSA 83:18" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" sid="PSA 84" />
  <para style="s1">Tabusenruniwa luban Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 84:1" />Lanarime san tubuidun bani sanduariu,</para>
  <para style="q" vid="PSA 84:1">Nabureme Suntigabafu!<verse eid="PSA 84:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 84:2" />Óunwenbu nayumahan</para>
  <para style="q" vid="PSA 84:2">lun ñéinbadina lan lidan tibürürün!</para>
  <para style="q" vid="PSA 84:2">Eremuhatina lun Lubungiutena ibagari</para>
  <para style="q" vid="PSA 84:2">lau ugundani tídangiñe sun nanigi!<verse eid="PSA 84:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 84:3" />Íbini dunuru ha ñǘbüritimabaña</para>
  <para style="q" vid="PSA 84:3">daritiña habara luagu bani latarü,</para>
  <para style="q" vid="PSA 84:3">lun hadügün hamasa harahüñü.</para>
  <para style="q" vid="PSA 84:3">Bungiu Suntigabafu, Nurúeite Nabureme.<verse eid="PSA 84:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 84:4" />Fuleseiwatiña ha aganóubaña búbiñe,</para>
  <para style="q" vid="PSA 84:4">ha alawahabalibu memeraagunga,<verse eid="PSA 84:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 84:5" />fuleseiwatiña ha adarirubaña híderawagun buma,</para>
  <para style="q" vid="PSA 84:5">ha ayumahabaña houdin alawahei Bungiu luagu luwübüri Sión!<verse eid="PSA 84:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 84:6" />Danme hásügürün luéigiñe fulasu wayati le mábeibei,</para>
  <para style="q" vid="PSA 84:6">hasaliraguagüdübei lísensenme duna,</para>
  <para style="q" vid="PSA 84:6">íbinime huya labuinchagüdübei lau abiniruni.<verse eid="PSA 84:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 84:7" />Aganwoundeina luba here,</para>
  <para style="q" vid="PSA 84:7">harihubei Bungiu le Íñugutimabei Sión.<verse eid="PSA 84:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 84:8" />Nabureme, Bungiu Suntigabafu, Lubungiute Hakobu,</para>
  <para style="q" vid="PSA 84:8">aganbabéi nafurieidun!<verse eid="PSA 84:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 84:9" />Bungiu, binibei le óunigirubaliwa</para>
  <para style="q" vid="PSA 84:9">arihabéi urúei le banúadirubei,</para>
  <para style="q" vid="PSA 84:9">lau arihini buiti.<verse eid="PSA 84:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 84:10" />Buítimati lerederúniwa aban weyu lidan bibürürün</para>
  <para style="q" vid="PSA 84:10">sügǘ lau milu bóugudi luéi!</para>
  <para style="q" vid="PSA 84:10">Himei nágili nawadigimaridun tubenari luban Nubungiute</para>
  <para style="q" vid="PSA 84:10">sügǘ lau naganóun hábiñe wuribatiña.<verse eid="PSA 84:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 84:11" />Ladüga harugoungadagüdati</para>
  <para style="q" vid="PSA 84:11">Bungiu le Aburemei wau, ani góunigilawa,</para>
  <para style="q" vid="PSA 84:11">hínsiñetiña ha harumabaña abagaridun lun Aburemei,</para>
  <para style="q" vid="PSA 84:11">rulei le buídubei houn.<verse eid="PSA 84:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 84:12" />Aburemei Suntigabafu</para>
  <para style="q" vid="PSA 84:12">fuleseiwatiña ha hemenigibaña buagun!<verse eid="PSA 84:12" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" sid="PSA 85" />
  <para style="s1">Séfuyabawa!</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 85:1" />Aburemei,</para>
  <para style="q" vid="PSA 85:1">arufuda baali bubuidun houn lílana bageira le,</para>
  <para style="q" vid="PSA 85:1">sansi baali lubunurun Hakobu;<verse eid="PSA 85:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 85:2" />feruduna baali hariban bánigu</para>
  <para style="q" vid="PSA 85:2">luma sun hafigoun;<verse eid="PSA 85:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 85:3" />gáluma baali bigañi sunsuinagubei.<verse eid="PSA 85:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 85:4" />Wabungiute, Wesefuragüle,</para>
  <para style="q" vid="PSA 85:4">salbabáwa giñe guentó,</para>
  <para style="q" vid="PSA 85:4">hebé bagañidun wama!<verse eid="PSA 85:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 85:5" />Bagañiduba funagia wama lun súnwandan?<verse eid="PSA 85:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 85:6" />Míchugunyaadibu san ibagari</para>
  <para style="q" vid="PSA 85:6">woun lun wagundaarun bidan?<verse eid="PSA 85:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 85:7" />Aburemei,</para>
  <para style="q" vid="PSA 85:7">arufudabéi bínsiñehabu woun, sefubáwa!<verse eid="PSA 85:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 85:8" />Naganbubei le lunbei lariñaguni Nabureme,</para>
  <para style="q" vid="PSA 85:8">ladüga ladimureha luagu darangilaü houn lánigu,</para>
  <para style="q" vid="PSA 85:8">houn ha gúnfulibaña luma,</para>
  <para style="q" vid="PSA 85:8">lun madügünhaña lan lílülün aau.<verse eid="PSA 85:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 85:9" />Lidan linarün katei, yarafati Bungiu,</para>
  <para style="q" vid="PSA 85:9">lun lesefuruniña ha hínsiñehabubaña lun;</para>
  <para style="q" vid="PSA 85:9">laganóuba luéirigun lidan wageira.<verse eid="PSA 85:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 85:10" />Ladunraguba ínsiñeni luma inarüni,</para>
  <para style="q" vid="PSA 85:10">lachurubei darangilaü liyuma richaguaü;<verse eid="PSA 85:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 85:11" />láhüchüba inarüni múarugugiñe,</para>
  <para style="q" vid="PSA 85:11">ariha ligíame richaguaü siélugiñe.<verse eid="PSA 85:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 85:12" />Aburemei guánarügü láhuyagüdübei huya,</para>
  <para style="q" vid="PSA 85:12">ruleime wamúan lin.<verse eid="PSA 85:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 85:13" />Lídiba irichaü lubá lubá Bungiu,</para>
  <para style="q" vid="PSA 85:13">ani laranserubei üma lubá.<verse eid="PSA 85:13" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" sid="PSA 86" />
  <para style="s1">Buguyarügüñein Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 86:1" />Nabureme, aganbabána,</para>
  <para style="q" vid="PSA 86:1">ladüga wéiriti nirun luma nugudemen;<verse eid="PSA 86:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 86:2" />góunigibana, ladüga gúnfulitina buma.</para>
  <para style="q" vid="PSA 86:2">Buguya Nubungiutebei,</para>
  <para style="q" vid="PSA 86:2">sefubéi bubuein le, le afiñebei buagu!<verse eid="PSA 86:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 86:3" />Nabureme, gudemená bun,</para>
  <para style="q" vid="PSA 86:3">au le ayumuragubei bun súnwandan.<verse eid="PSA 86:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 86:4" />Nabureme, gúndaaguagüdaboun nanigi,</para>
  <para style="q" vid="PSA 86:4">ladüga búmounñein nayumuragun.<verse eid="PSA 86:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 86:5" />Ladüga, buguya Nabureme,</para>
  <para style="q" vid="PSA 86:5">buítibu ani gíchigadi buguya ferudun;</para>
  <para style="q" vid="PSA 86:5">buítibu hama sun ha ayumuragubaña bun.<verse eid="PSA 86:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 86:6" />Nabureme, aganbabéi nafurieidun,</para>
  <para style="q" vid="PSA 86:6">tenibá lun nayumuragun!<verse eid="PSA 86:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 86:7" />Wátina buagu lidan nidiheri,</para>
  <para style="q" vid="PSA 86:7">ladüga óunaba bumutina.<verse eid="PSA 86:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 86:8" />Úati Bungiu bibe, Aburemei!</para>
  <para style="q" vid="PSA 86:8">Úati ni aban adügüti katei burí le badügübei.<verse eid="PSA 86:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 86:9" />Nabureme,</para>
  <para style="q" vid="PSA 86:9">adüga baaña sun néchanigu,</para>
  <para style="q" vid="PSA 86:9">hayabinba lun heremuhan bun</para>
  <para style="q" vid="PSA 86:9">luma lun híchugun uéiriguni lun biri.<verse eid="PSA 86:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 86:10" />Ladüga buguyarügüñein Bungiu,</para>
  <para style="q" vid="PSA 86:10">wéirigutibu adügatibu giñe katei buíduburiti!<verse eid="PSA 86:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 86:11" />Nabureme, arufudabéi bémeri nun,</para>
  <para style="q" vid="PSA 86:11">lun nafalaruni lau gúnfuli.</para>
  <para style="q" vid="PSA 86:11">Adügabá lun inebe lan biri tun nanigi.<verse eid="PSA 86:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 86:12" />Nabureme, Nubungiute,</para>
  <para style="q" vid="PSA 86:12">neremuhaba bun tau sun nanigi,</para>
  <para style="q" vid="PSA 86:12">níchuguba uéiriguni lun biri lun súnwandan.<verse eid="PSA 86:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 86:13" />Wéiriti bínsiñehabu nun!</para>
  <para style="q" vid="PSA 86:13">Sefubáadina luéi nábürühan lidoun umúahaü!<verse eid="PSA 86:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 86:14" />Bungiu,</para>
  <para style="q" vid="PSA 86:14">añahein saragu wuribatiña, hanarimetiña,</para>
  <para style="q" vid="PSA 86:14">ha meberesenbaña bau, garabaguaaña nuagun,</para>
  <para style="q" vid="PSA 86:14">ani busentiña háfarunina hilagubei.<verse eid="PSA 86:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 86:15" />Gama lumoun buguya, Aburemei,</para>
  <para style="q" vid="PSA 86:15">Bungiu, gudemehabutibu,</para>
  <para style="q" vid="PSA 86:15">gaguraasuntibu, ínsiñeni luma inarüni buguya.<verse eid="PSA 86:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 86:16" />Arihabána, gudemená bun!</para>
  <para style="q" vid="PSA 86:16">Sefubéi bubuein le rubei bere lun!<verse eid="PSA 86:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 86:17" />Arufudabéi bareini nun furangu,</para>
  <para style="q" vid="PSA 86:17">lun danme lan harihini ha iyereehabúbaña nun</para>
  <para style="q" vid="PSA 86:17">lun hanügün busiganu.</para>
  <para style="q" vid="PSA 86:17">Buguya Bungiu, rútibu ídemuei luma gurasu nun.<verse eid="PSA 86:17" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" sid="PSA 87" />
  <para style="s1">Alawahani lun lageira Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 87:1" />Luáguñein burí wübü sánduti,</para>
  <para style="q" vid="PSA 87:1">lebu luburugute Bungiu.<verse eid="PSA 87:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 87:2" />Hínsiñeti lubenari Sión lun Aburemei</para>
  <para style="q" vid="PSA 87:2">sügǘ tau sun burí luban Hakobu.<verse eid="PSA 87:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 87:3" />Luburugute Bungiu,</para>
  <para style="q" vid="PSA 87:3">buíduburiti katei ariñawagúti buagu:<verse eid="PSA 87:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 87:4" />«Lidan burí fulasu le subudibalina</para>
  <para style="q" vid="PSA 87:4">gayaraati níriduni Ehiptu luma Babilónia,</para>
  <para style="q" vid="PSA 87:4">Filistéa, Tiru luma Etiopía;</para>
  <para style="q" vid="PSA 87:4">sun hagía bídangiñe hayabin».<verse eid="PSA 87:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 87:5" />Hariñaguba luagu uburugu Sión:</para>
  <para style="q" vid="PSA 87:5">«Le luma lígita, ñéingiñe hayabin».</para>
  <para style="q" vid="PSA 87:5">Bungiu guánarügü ederebudagüdübalin.<verse eid="PSA 87:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 87:6" />Bürǘ lumuti Aburemei tidan garudia</para>
  <para style="q" vid="PSA 87:6">to ñein lubéi labürühóua liri burí fulasu:</para>
  <para style="q" vid="PSA 87:6">«Ñéingiñe liabin le».<verse eid="PSA 87:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 87:7" />Ha eremuhabaña hama ha abinahabaña</para>
  <para style="q" vid="PSA 87:7">hariñaga: «Bídanñoun nuban».<verse eid="PSA 87:7" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" sid="PSA 88" />
  <para style="s1">Lafurieidun aban súfuriti</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 88:1" />Nabureme, Nubungiute Nesefuragüle,</para>
  <para style="q" vid="PSA 88:1">amuriahatina ídemuei buma áriebu wéyuagu,<verse eid="PSA 88:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 88:2" />resibibéi nafurieidun!</para>
  <para style="q" vid="PSA 88:2">Tenibá lun nayumuragun!<verse eid="PSA 88:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 88:3" />Wéiriti wuribati le ábürühabei nuagun</para>
  <para style="q" vid="PSA 88:3">darí lun nasandiragun nungua luagu nounwe lan;<verse eid="PSA 88:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 88:4" />darí lun gayaraahali lan nabahüdǘniwa hadan hilaaña,</para>
  <para style="q" vid="PSA 88:4">ladüga rédeihadina méreuga,<verse eid="PSA 88:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 88:5" />Igirúaadina haganagua hilaguaaña;</para>
  <para style="q" vid="PSA 88:5">ítara niña kei ha óunwegubaña lidan wuribu,</para>
  <para style="q" vid="PSA 88:5">ha bunawaañabaña;</para>
  <para style="q" vid="PSA 88:5">kei ha féridi hamaalibei bóunigirun,</para>
  <para style="q" vid="PSA 88:5">ha bulíeibaañabaña!<verse eid="PSA 88:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 88:6" />Fuíbaadina lidoun lilulin-agei huyu,</para>
  <para style="q" vid="PSA 88:6">lidoun burí fulasu búrigati ani hulili ligía.<verse eid="PSA 88:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 88:7" />Ígiragüda baali bigañi nuagun,</para>
  <para style="q" vid="PSA 88:7">bulugüda báadina lábugiñe lihürü lugudi barana!<verse eid="PSA 88:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 88:8" />Adügaadibu lun hígirunina numadagu;</para>
  <para style="q" vid="PSA 88:8">adügaadibu lun hásiñarunina awanda.</para>
  <para style="q" vid="PSA 88:8">Ítara niña kei aban adaürǘti le siñati lesefurun.<verse eid="PSA 88:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 88:9" />Nerederuña marihinga lárigi saragu ayahuni;</para>
  <para style="q" vid="PSA 88:9">Sagü weyu nayumuragun bun, Nabureme,</para>
  <para style="q" vid="PSA 88:9">ani iñura numuti núhabu bun!<verse eid="PSA 88:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 88:10" />Badügübei funagia uéiriguni hádangiñe hilaaña?</para>
  <para style="q" vid="PSA 88:10">Gayaraabei funagia seremei hamanibu hilaaña?<verse eid="PSA 88:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 88:11" />Ladimurehóuba funagia luagu binarün</para>
  <para style="q" vid="PSA 88:11">luma bínsiñehabu lidan umúahaü,</para>
  <para style="q" vid="PSA 88:11">lidan larúeihan óunweni,<verse eid="PSA 88:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 88:12" />lidan lamuñan óunweni,</para>
  <para style="q" vid="PSA 88:12">le ñein lubéi labulieidúa sun katei?</para>
  <para style="q" vid="PSA 88:12">Ñeinbei funagia aritaguti luagun biricha</para>
  <para style="q" vid="PSA 88:12">luma burí katei wéiriguti le badügübei?<verse eid="PSA 88:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 88:13" />Ánheinti au, Nabureme, wátina buagu;</para>
  <para style="q" vid="PSA 88:13">iñura numuti nafurieidun bun binaafin.<verse eid="PSA 88:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 88:14" />Ka san uagu mabahüdün bubadina, Nabureme?</para>
  <para style="q" vid="PSA 88:14">Ka uagu baramudagua nuéi?<verse eid="PSA 88:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 88:15" />Lúmagiñe meha nibureingidina nidiheri nan</para>
  <para style="q" vid="PSA 88:15">ani yarafa au lun óunweni;</para>
  <para style="q" vid="PSA 88:15">áfagaadina katei hanarimeburiti búmagiñe,</para>
  <para style="q" vid="PSA 88:15">ani siñá nun!<verse eid="PSA 88:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 88:16" />Sügühali lanarime bigañi nuéigiñe,</para>
  <para style="q" vid="PSA 88:16">ani áfaraha láadina;<verse eid="PSA 88:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 88:17" />geyeguati nau sunsuinagubei súnwandan</para>
  <para style="q" vid="PSA 88:17">kamá dan le labuinchun duna fulasurugu.<verse eid="PSA 88:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 88:18" />Dísegüda baaña numadagu nuéi,</para>
  <para style="q" vid="PSA 88:18">guentó lúmarügüñein luburiga gamadagua nan!<verse eid="PSA 88:18" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" sid="PSA 89" />
  <para style="s1">Lidaradun Bungiu luma Dawidi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 89:1" />Nadiremuhaba luagu gareini ban súnwandan lidan neremuhan,</para>
  <para style="q" vid="PSA 89:1">Nabureme nabahüdaguba súnwandan luagu gúnfuli ban.<verse eid="PSA 89:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 89:2" />Nadimurehaba luagu magumuchadi lan bínsiñehabu;</para>
  <para style="q" vid="PSA 89:2">luagu masansiragun lan bigunfulin,</para>
  <para style="q" vid="PSA 89:2">ítara kei masansiraguadi lan sielu.<verse eid="PSA 89:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 89:3" />Adügatibu aban daradu luma Dawidi;</para>
  <para style="q" vid="PSA 89:3">füramasetibu lun bubuein le banúadirubei:<verse eid="PSA 89:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 89:4" />«Narúeihagüdübaña badügawagun beweñegua».<verse eid="PSA 89:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 89:5" />Aburemei,</para>
  <para style="q" vid="PSA 89:5">sun ánheligu ha siélubaña alawaha hamuti bigunfulin</para>
  <para style="q" vid="PSA 89:5">luma burí katei buiti le badügübei.<verse eid="PSA 89:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 89:6" />Úati ni aban bungiu, ni kata sielu ítarati kei buguya, Aburemei!<verse eid="PSA 89:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 89:7" />Bungiu wéiriti ani hanarimeti,</para>
  <para style="q" vid="PSA 89:7">geyegu hau kátaña siéluna.<verse eid="PSA 89:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 89:8" />Aburemei, Bungiu, Suntigabafu,</para>
  <para style="q" vid="PSA 89:8">bani sun ubafu ani geyeguati inarüni bau;</para>
  <para style="q" vid="PSA 89:8">úati ni aban kei buguya!<verse eid="PSA 89:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 89:9" />Gabafutibu luagu lérouga baranaha</para>
  <para style="q" vid="PSA 89:9">gáluma bumuti lanarime burí lugudi barana.<verse eid="PSA 89:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 89:10" />Dügügua bumuti animaalu hanarimeti le baranahana</para>
  <para style="q" vid="PSA 89:10">kamá hamuga aban úgubu hilaali;</para>
  <para style="q" vid="PSA 89:10">chagagua bumutiña báganiñu lau lere barüna.<verse eid="PSA 89:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 89:11" />Bani sielu luma múa;</para>
  <para style="q" vid="PSA 89:11">buguya adügübalin ubóu luma sun katei le lídanbei.<verse eid="PSA 89:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 89:12" />Buguya adügübalin nórute luma suru;</para>
  <para style="q" vid="PSA 89:12">eremuhati wübü Taworu luma Erümón lau ugundani lun biri.<verse eid="PSA 89:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 89:13" />Gabafuti barüna,</para>
  <para style="q" vid="PSA 89:13">héreti búhabu le bóunwenren ani gagañeiraditi.<verse eid="PSA 89:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 89:14" />Derebuguñu liña lálana barúeihan luagu irichaü;</para>
  <para style="q" vid="PSA 89:14">ñǘbuinti ínsiñehabuni luma inarüni bubaroun.<verse eid="PSA 89:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 89:15" />Aburemei,</para>
  <para style="q" vid="PSA 89:15">fuleseiwatiña gürigia ha galawahadibaña bun lau ugundani</para>
  <para style="q" vid="PSA 89:15">ani harugoungadagüdabei hémeri lau bigemeri,<verse eid="PSA 89:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 89:16" />ha gúndaabaña lidan biri sun dan</para>
  <para style="q" vid="PSA 89:16">gunda hagía lau búaragun.<verse eid="PSA 89:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 89:17" />Le linarün katei buguya hérebei gürigia hagía,</para>
  <para style="q" vid="PSA 89:17">buguya habuidunmeraü;</para>
  <para style="q" vid="PSA 89:17">gánwounti wabafu lau lubuidun bareini.<verse eid="PSA 89:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 89:18" />Aburemei, ligía óunigirubaliwa!</para>
  <para style="q" vid="PSA 89:18">Lubungiute Ísüraeli, ligía Warúeitebei!<verse eid="PSA 89:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 89:19" />Lidan meha amu dan, adimurehatibu meha lau uénedü</para>
  <para style="q" vid="PSA 89:19">aba bariñagun houn bubueingu ha gúnfulibaña:</para>
  <para style="q" vid="PSA 89:19">«Anúadahaadina aban ganigiti hádangiñe nánigu,</para>
  <para style="q" vid="PSA 89:19">ru naali iñu, íderagua naali giñe.<verse eid="PSA 89:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 89:20" />Darí naali Dawidi le nubúein!</para>
  <para style="q" vid="PSA 89:20">Hurugua naali lau garaba lun urúeime,<verse eid="PSA 89:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 89:21" />níderagubei súnwandan;</para>
  <para style="q" vid="PSA 89:21">níchuguba erei lun lau nubafu!<verse eid="PSA 89:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 89:22" />Magayuahanbaña láganiñu luagu;</para>
  <para style="q" vid="PSA 89:22">magañeirun hameime wuribatiña.<verse eid="PSA 89:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 89:23" />Naburechagubaña láganiñu;</para>
  <para style="q" vid="PSA 89:23">nagidarubaña ligibugiñegiñe larihin!</para>
  <para style="q" vid="PSA 89:23">Nagünrinchagubaña ha iyereehabúbaña lun!<verse eid="PSA 89:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 89:24" />Aniheinbei nínsiñehabu labu nugunfulin luma,</para>
  <para style="q" vid="PSA 89:24">laganwounduba lubafu nuéigiñe;<verse eid="PSA 89:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 89:25" />nederebudagüdübei lubafu luma lugumadin</para>
  <para style="q" vid="PSA 89:25">lúmagiñe barana Mediteraniu darí duna Éufüratesi.<verse eid="PSA 89:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 89:26" />Lariñaguba nun:</para>
  <para style="q" vid="PSA 89:26">“Núguchi, buguya Nubungiutebei</para>
  <para style="q" vid="PSA 89:26">le esefurubalina ágüdahalana”.<verse eid="PSA 89:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 89:27" />Níchugubei liricha isaani le íbugañaü lun,</para>
  <para style="q" vid="PSA 89:27">hóugiñe lurúeitegu ubóu.<verse eid="PSA 89:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 89:28" />Merederadibei línsiñe nun,</para>
  <para style="q" vid="PSA 89:28">masansiraguadibei nidaradun luma.<verse eid="PSA 89:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 89:29" />Harúeihaba ladügawagun leweñegua</para>
  <para style="q" vid="PSA 89:29">sun magumuchagungili lanme sielu.<verse eid="PSA 89:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="PSA 89:30" />«Gama lumoun anhein hígira narufudahan</para>
  <para style="q" vid="PSA 89:30">mawinwandun hagíame richagu luma nugumadin,<verse eid="PSA 89:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 89:31" />anhein hadüraagua nilurudun</para>
  <para style="q" vid="PSA 89:31">meberesen hagíame lau nugumadin;<verse eid="PSA 89:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 89:32" />nabeichubaña lau wewe luagu hariban;<verse eid="PSA 89:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 89:33" />gama lumoun mígirun nubéi línsiñe Dawidi nun,</para>
  <para style="q" vid="PSA 89:33">madüraagun neime nidaradun luma.<verse eid="PSA 89:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 89:34" />Madüraagun nubéi nidaradun,</para>
  <para style="q" vid="PSA 89:34">madüraaguneime nererun.<verse eid="PSA 89:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 89:35" />Fiñuhadina aban wéiyaasu luagu niri le sándubei,</para>
  <para style="q" vid="PSA 89:35">ani meyeedun nubéi:<verse eid="PSA 89:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 89:36" />Harúeihaba ladügawagun leweñegua</para>
  <para style="q" vid="PSA 89:36">sun anihagua lanme weyu.<verse eid="PSA 89:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 89:37" />Deregüdagu súnwandan kei hati!</para>
  <para style="q" vid="PSA 89:37">Deregüdagu súnwandan sun anihagua lanme sielu!»<verse eid="PSA 89:37" /></para>
  <para style="s1">Leferidirun urúei</para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 89:38" />Gama lumoun Bungiu, fui baali urúei le banúadirubei;</para>
  <para style="q" vid="PSA 89:38">gáñihadibu luma!<verse eid="PSA 89:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 89:39" />Dürüguabá bidaradun luma;</para>
  <para style="q" vid="PSA 89:39">fuiba liridin múarugun.<verse eid="PSA 89:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 89:40" />Daratibu üma lidan sun lubarieirun;</para>
  <para style="q" vid="PSA 89:40">günringuabá sun luburugute!<verse eid="PSA 89:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 89:41" />Sun ásügürütiña híweruhani le habusenrun;</para>
  <para style="q" vid="PSA 89:41">adaaguatiña lubesinanigu bula lau.<verse eid="PSA 89:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 89:42" />Adügaadibu lun hiñuruni láganiñu háhabu</para>
  <para style="q" vid="PSA 89:42">gúndaañu lau agañeiruni;<verse eid="PSA 89:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 89:43" />gidá bumuti tamana lefeinte</para>
  <para style="q" vid="PSA 89:43">ani mágüdahan bumuti wuriburugu.<verse eid="PSA 89:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 89:44" />Gidaba luéirigun;</para>
  <para style="q" vid="PSA 89:44">fuiba lálana larúeihan múarugun;<verse eid="PSA 89:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 89:45" />gidaadibu lídangiñe limigifen libagari,</para>
  <para style="q" vid="PSA 89:45">buíngüda baali lau busiganu.<verse eid="PSA 89:45" /></para>
  <para style="s1">Lamuriahóun esefuruni</para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 89:46" />Nabureme,</para>
  <para style="q" vid="PSA 89:46">ídaba san lásura baramudagun?</para>
  <para style="q" vid="PSA 89:46">Gemeñu luba san bigañi súnwandan kei watu gemeti?<verse eid="PSA 89:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 89:47" />Nabureme, haritaguabatia luagu murusunrügüñein lan nibagari;</para>
  <para style="q" vid="PSA 89:47">luagu murusunrügüñein lan habagaridun gürigia ha badügübaña.<verse eid="PSA 89:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 89:48" />Úati ni aban gayaraati labagaridun lun móunwenbei lan!</para>
  <para style="q" vid="PSA 89:48">Úati ni aban lun gayara lan lesefurun luéi lubafu óunweni!<verse eid="PSA 89:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 89:49" />Aburemei,</para>
  <para style="q" vid="PSA 89:49">hagéi san furumiñeti bínsiñehabu</para>
  <para style="q" vid="PSA 89:49">le füramase bubéi lun Dawidi lidan bigunfulin?<verse eid="PSA 89:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 89:50" />Aburemei,</para>
  <para style="q" vid="PSA 89:50">haritaguabatia luagu anabagua hamaniña saragu</para>
  <para style="q" vid="PSA 89:50">gürigia bubueingu;</para>
  <para style="q" vid="PSA 89:50">luagu barǘ nani anabawaguni ligía naniguagu.<verse eid="PSA 89:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 89:51" />Aburemei,</para>
  <para style="q" vid="PSA 89:51">ítara liña hanabaguniwa báganiñu!</para>
  <para style="q" vid="PSA 89:51">Ítara liña hanabaguni le banúadirubei le ñein lumuti lidin!<verse eid="PSA 89:51" /></para>
  <para style="b" />
  <para style="q">
    <verse number="52" style="v" sid="PSA 89:52" />Alawahoualá Aburemei súnwandan!</para>
  <para style="q" vid="PSA 89:52">Ítarala!<verse eid="PSA 89:52" /></para>
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" sid="PSA 90" />
  <para style="ms">TIGADÜRÜN LÍBURU</para>
  <para style="mr">(Sálumu <ref loc="PSA 90-106">90—106</ref>)</para>
  <para style="s1">Bungiu hama gürigia</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 90:1" />Aburemei, buguya waramudaguagülebei súnwandan.<verse eid="PSA 90:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 90:2" />Lúmagiñe meha lubaragiñe ladügǘn burí wübü,</para>
  <para style="q" vid="PSA 90:2">lubaragiñe buga anihein lan múa luma ubóu,</para>
  <para style="q" vid="PSA 90:2">lúmagiñe binadu dan lumoun lébeha dan, Bungiu buguya.<verse eid="PSA 90:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 90:3" />Adügatibu lun háguyugun gürigia</para>
  <para style="q" vid="PSA 90:3">múame dan le bariñagun:</para>
  <para style="q" vid="PSA 90:3">«Águyugua humá hárigoun lidoun múa gürigia».<verse eid="PSA 90:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 90:4" />Milu irumu bun ítara liña kei weyu wurinouga, le ásügürübei;</para>
  <para style="q" vid="PSA 90:4">ítara liña kei átiri oura áriebu!<verse eid="PSA 90:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 90:5" />Aduruuha bumutiña gürigia lau anarimeni</para>
  <para style="q" vid="PSA 90:5">kamá hamuga aban idabagu;<verse eid="PSA 90:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 90:6" />ítara haña kei híduru le áhüchübei</para>
  <para style="q" vid="PSA 90:6">aba legelewehan binaafin,</para>
  <para style="q" vid="PSA 90:6">gama lumoun rábounweyu aba lásaürün aba lounwen.<verse eid="PSA 90:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 90:7" />Gumuguagüda lumutiwa bigañi,</para>
  <para style="q" vid="PSA 90:7">bulíeiguagüda lumutiwa!<verse eid="PSA 90:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 90:8" />Rédeiti wafigoun luma wariban bigibugiñe.<verse eid="PSA 90:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 90:9" />Sun wabagari gumuguati ladüga bigañi;</para>
  <para style="q" vid="PSA 90:9">ñǘdünti warumudiri kei aban awaraguni.<verse eid="PSA 90:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 90:10" />Ǘrüwa wein diisi irumu ligía wabagaridubei;</para>
  <para style="q" vid="PSA 90:10">ha héretimabaña chülütiña darí gádürü-wein;</para>
  <para style="q" vid="PSA 90:10">gama lumoun igarigu luma wadagimanu</para>
  <para style="q" vid="PSA 90:10">líchugubei limigifen ibagari.</para>
  <para style="q" vid="PSA 90:10">Sügüti burí irumu furese kéisigubeirügü wagía!<verse eid="PSA 90:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 90:11" />Kagia subudihabúbei lun lanarime bigañi?</para>
  <para style="q" vid="PSA 90:11">Kagia subudihabúbei lun basafaragun?<verse eid="PSA 90:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 90:12" />Arufudahabá woun lun wabahüdüni waweyuri buidu,</para>
  <para style="q" vid="PSA 90:12">ragǘ láamuga wachügü lichú aau.<verse eid="PSA 90:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 90:13" />Aburemei, gararaguabá wawagun!</para>
  <para style="q" vid="PSA 90:13">Átiribei san dan bau lubá bagiribudun?</para>
  <para style="q" vid="PSA 90:13">Gudeme hamá bubueingu ha bun!<verse eid="PSA 90:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 90:14" />Buíngüdabawa lau bínsiñehabu dan le lagumeserun weyu,</para>
  <para style="q" vid="PSA 90:14">eremuha wamaamuga lau ugundani lidan sun wabagari.<verse eid="PSA 90:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 90:15" />Ruba saragu irumu lau ugundani woun,</para>
  <para style="q" vid="PSA 90:15">kei burí líbehabu irumu le sügǘ wamaalibei lau idiheri.<verse eid="PSA 90:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 90:16" />Adügabá lun gayara lan harihini bubueingu</para>
  <para style="q" vid="PSA 90:16">hama hadügawagun katei le burí badügübei luma buéirigun!<verse eid="PSA 90:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 90:17" />Ñeinlá lareini Aburemei le Wabungiute wawagu.</para>
  <para style="q" vid="PSA 90:17">Bungiu adügabá lun derebugu lan buadigimari wadan! Anha Bungiu, derebugugüdabei buadigimari wadan!<verse eid="PSA 90:17" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" sid="PSA 91" />
  <para style="s1">Bungiu waramudaguagülebei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 91:1" />Ha áluahabaña haramudagun lidan Wabureme</para>
  <para style="q" vid="PSA 91:1">aganóua hagía lábugiñe lamuñadina Bungiu Suntigabafu,<verse eid="PSA 91:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 91:2" />gayaraati hariñagun lun Bungiu:</para>
  <para style="q" vid="PSA 91:2">«Buguya naramudaguagülebei, le óunigirubalina,</para>
  <para style="q" vid="PSA 91:2">Buguya Nubungiutebei, le uágubei nemenigida!»<verse eid="PSA 91:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 91:3" />Ligíarügübei gayara lesefurunibu tuéi sádara aramudaguatu,</para>
  <para style="q" vid="PSA 91:3">luma hawéi igei gáfarahatiña,<verse eid="PSA 91:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 91:4" />ladüga ladouraguba bau lau larüna,</para>
  <para style="q" vid="PSA 91:4">areidañububa buidu lábugiñe larüna,</para>
  <para style="q" vid="PSA 91:4">Lóunigirubadibu ligunfulin Bungiu</para>
  <para style="q" vid="PSA 91:4">ageindagua ligíame báugiñe.<verse eid="PSA 91:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 91:5" />Manufudedabá luéi denchaü áriebuna,</para>
  <para style="q" vid="PSA 91:5">ni tuéi gimara to achüürǘtu wéyuagu,<verse eid="PSA 91:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 91:6" />ni hawéi igei ha ñǘbuintiña úara luma luburiga,</para>
  <para style="q" vid="PSA 91:6">ni luéi wuribani le áfarahati amidirugu.<verse eid="PSA 91:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 91:7" />Hábürühaba milu hilaaña luéigiñe bubaünan,</para>
  <para style="q" vid="PSA 91:7">diisi milu luéigiñe bóunwenren,</para>
  <para style="q" vid="PSA 91:7">gama lumoun masuseredunbei ni kata bun.<verse eid="PSA 91:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 91:8" />Ariharügü bubéi:</para>
  <para style="q" vid="PSA 91:8">Barihubei hafayeiruaha wuribatiña luagu hadüga.<verse eid="PSA 91:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 91:9" />Barǘ baali lubeigia Bungiu lun baramudaguagüleme,</para>
  <para style="q" vid="PSA 91:9">le Íñugubei lun lóunigirunibu<verse eid="PSA 91:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 91:10" />ligía miábinbei lubéi ni aban wuribani buagun,</para>
  <para style="q" vid="PSA 91:10">machülübei giñe sandi búbiñoun.<verse eid="PSA 91:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 91:11" />Lóunahabaña lani ánheligu</para>
  <para style="q" vid="PSA 91:11">lun hóunigirunibu le ñein lumuti bidin.<verse eid="PSA 91:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 91:12" />Hanügübadibu háhaburugu</para>
  <para style="q" vid="PSA 91:12">luéi lachugeragun bugudi luagu dübü.<verse eid="PSA 91:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 91:13" />Gayaraabei béibugun haganagua liñún hama hewe</para>
  <para style="q" vid="PSA 91:13">liñún gáñitiña hama hewe péisinitiña.<verse eid="PSA 91:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 91:14" />«Níchugubei iñun le ñein lumuti</para>
  <para style="q" vid="PSA 91:14">siñá lan lachülürǘniwa lumoun,</para>
  <para style="q" vid="PSA 91:14">ladüga hínsiñetina lun ani subudilána.<verse eid="PSA 91:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 91:15" />Nóunabubei danme le láwarun nun; lúmabadina!</para>
  <para style="q" vid="PSA 91:15">Nesefurubei luéi idiheri,</para>
  <para style="q" vid="PSA 91:15">níchuguba uéiriguni lun.<verse eid="PSA 91:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 91:16" />Níchuguba ibagari migifeti lun,</para>
  <para style="q" vid="PSA 91:16">nadügüba lun lagundaarun lau nasalbahan!»<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" sid="PSA 92" />
  <para style="s1">Aban uremu lánina alawahani</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 92:1" />Nabureme Íñuguti,</para>
  <para style="q" vid="PSA 92:1">buiti lichugúniwa seremei bun</para>
  <para style="q" vid="PSA 92:1">luma leremuhóuniwa luagu buéirigun!<verse eid="PSA 92:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 92:2" />Ladimurehóun luagu lueirin bínsiñehabu binaafin,</para>
  <para style="q" vid="PSA 92:2">luma luagu bigunfulin guñoun,<verse eid="PSA 92:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 92:3" />lau tamuri gidara,</para>
  <para style="q" vid="PSA 92:3">luma lau tamuri sun tuwuyeri árüpa.<verse eid="PSA 92:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 92:4" />Nabureme,</para>
  <para style="q" vid="PSA 92:4">gúndaaguagüda báadina lau burí katei le badügübei!</para>
  <para style="q" vid="PSA 92:4">Buíngüda lumutina burí katei ligía lau ugundani.<verse eid="PSA 92:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 92:5" />Aburemei,</para>
  <para style="q" vid="PSA 92:5">wéinamuburiti katei le badügübei!</para>
  <para style="q" vid="PSA 92:5">Hénrenguti gunfurandawa lan bisaminan!<verse eid="PSA 92:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 92:6" />Ha derebaña aganbun</para>
  <para style="q" vid="PSA 92:6">hagíarügüñanu siñá gunfuranda hamani!<verse eid="PSA 92:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 92:7" />Anhein weiri habéi wuribatiña kei híduru, awanse hagía,</para>
  <para style="q" vid="PSA 92:7">lúnrügü hagünrinchawaguniwa lun sun dan lasusereda.<verse eid="PSA 92:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 92:8" />Ánheinti buguya Aburemei,</para>
  <para style="q" vid="PSA 92:8">íñuñadibu súnwandan.<verse eid="PSA 92:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 92:9" />Bungiu, anihein aban katei inarüniti:</para>
  <para style="q" vid="PSA 92:9">hagünrinchawaguba lan báganiñu;</para>
  <para style="q" vid="PSA 92:9">hachagarawaguba sun ha adügütiña wuribati!<verse eid="PSA 92:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 92:10" />Gánwoungüda bumuti nere</para>
  <para style="q" vid="PSA 92:10">kei lere aban bulu bágasu,</para>
  <para style="q" vid="PSA 92:10">huruguabéi nichügü lau ibiñein</para>
  <para style="q" vid="PSA 92:10">lun bíchugun inebesei nun.<verse eid="PSA 92:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 92:11" />Narihubei hábürühan náganiñu;</para>
  <para style="q" vid="PSA 92:11">naganbubei hagúarahan wuribatiña hagía!<verse eid="PSA 92:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 92:12" />Egelewehatiña ha richaguabaña kei fáluma,</para>
  <para style="q" vid="PSA 92:12">wéinamu hagía kei hibúari Líwanuna.<verse eid="PSA 92:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 92:13" />Bunawaguñuhaña tidan luban Aburemei;</para>
  <para style="q" vid="PSA 92:13">egelewehatiña lidan libürürün Bungiu.<verse eid="PSA 92:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 92:14" />Haginduba íbini danme le wéiyaaña;</para>
  <para style="q" vid="PSA 92:14">hérebaña súnwandan ani buin haba lau ibagari<verse eid="PSA 92:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 92:15" />aranseñu lun hadimurehan</para>
  <para style="q" vid="PSA 92:15">luagu úaragua lan Aburemei.</para>
  <para style="q" vid="PSA 92:15">Bungiu óunigirubalina</para>
  <para style="q" vid="PSA 92:15">ani úati marichaü lidan.<verse eid="PSA 92:15" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" sid="PSA 93" />
  <para style="s1">Aburemei Urúeibei!</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 93:1" />Aburemei arúeihabei!</para>
  <para style="q" vid="PSA 93:1">Dáüguaali Bungiu lau uéiriguni,</para>
  <para style="q" vid="PSA 93:1">geyeguagüda ligía ubafu laugua!</para>
  <para style="q" vid="PSA 93:1">Derebugugüda lumuti Bungiu ubóu lun mánhingichun lan.<verse eid="PSA 93:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 93:2" />Lúmagiñe dan ligía, Aburemei,</para>
  <para style="q" vid="PSA 93:2">derebuguñu liña lálana barúeihan.</para>
  <para style="q" vid="PSA 93:2">Abunheingubeiñadibu lúmagiñe furumiñeti dan!<verse eid="PSA 93:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 93:3" />Aburemei,</para>
  <para style="q" vid="PSA 93:3">ahuuhati burí duna le éibaaguati,</para>
  <para style="q" vid="PSA 93:3">ma luéinamun labounhan;<verse eid="PSA 93:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 93:4" />arúeihati Bungiu sielu lau ubafu.</para>
  <para style="q" vid="PSA 93:4">Héreti luéi lugudi barana,</para>
  <para style="q" vid="PSA 93:4">gabafu ligía luéi lahuuhan barana.<verse eid="PSA 93:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 93:5" />Aburemei deregüdati bugumadin.</para>
  <para style="q" vid="PSA 93:5">Sándutu buban lun sun dan!<verse eid="PSA 93:5" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" sid="PSA 94" />
  <para style="s1">Aburemei laguseragülebei ubóu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 94:1" />Aburemei, buguya Bungiu le abeihabei,</para>
  <para style="q" vid="PSA 94:1">arufudabéi bigañi!<verse eid="PSA 94:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 94:2" />Buguya aguseragüdütibei ubouagu!</para>
  <para style="q" vid="PSA 94:2">Iñuraguabá bungua hawagun ha barüguabaña houngua,</para>
  <para style="q" vid="PSA 94:2">fáyeigüdabaña luagu hadüga!<verse eid="PSA 94:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 94:3" />Ídaba san Aburemei,</para>
  <para style="q" vid="PSA 94:3">ídaba san lásura hagundaarun wuribatiña?<verse eid="PSA 94:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 94:4" />Sun adügütiña wuribani héregutiña,</para>
  <para style="q" vid="PSA 94:4">iñu buriti hanaagun houngua;</para>
  <para style="q" vid="PSA 94:4">pántatiña lau le mámagubei!<verse eid="PSA 94:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 94:5" />Aburemei,</para>
  <para style="q" vid="PSA 94:5">günringua hamutiña bumutuniña;</para>
  <para style="q" vid="PSA 94:5">ru hamutiña bánigu lidoun ǘnabuguni!<verse eid="PSA 94:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 94:6" />Áfaragua hamutiña würiña</para>
  <para style="q" vid="PSA 94:6">ha burí hilaguaañabaña úmarigu hama terencha,</para>
  <para style="q" vid="PSA 94:6">áfaraha hagía méteñuhaña hilagubei.<verse eid="PSA 94:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 94:7" />Hariñagati luagu marihin lan Bungiu,</para>
  <para style="q" vid="PSA 94:7">luagu mefén lan Lubungiute Hakobu luagu lira.<verse eid="PSA 94:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 94:8" />Gunfuranda humá, gürigia deré taganbun!</para>
  <para style="q" vid="PSA 94:8">Ídaba san gayara lan gunfuranda humá?<verse eid="PSA 94:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 94:9" />Ida lubagia maganbun lan le adügübalin arigeirugu?</para>
  <para style="q" vid="PSA 94:9">Ida lubagia marihin lan le adügübalin agu?<verse eid="PSA 94:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 94:10" />Bungiu óunigirubaliña néchanigu</para>
  <para style="q" vid="PSA 94:10">ida lubagia mabeichun lániña?</para>
  <para style="q" vid="PSA 94:10">Ida lubagia machú lan lau le arufudahabei houn gürigia?<verse eid="PSA 94:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 94:11" />Subudi lumuti Aburemei</para>
  <para style="q" vid="PSA 94:11">luágurügüñein lan libidiounigan aau hasaminara gürigia.<verse eid="PSA 94:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 94:12" />Aburemei,</para>
  <para style="q" vid="PSA 94:12">fuleseiwatiña gürigia ha beweridihabaña</para>
  <para style="q" vid="PSA 94:12">arufudaha buguya houn,<verse eid="PSA 94:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 94:13" />darangilu hamaamuga danme le liabin luriban dan,</para>
  <para style="q" vid="PSA 94:13">ánhañati ha salufuribaña, lachiahóuña fusu habá.<verse eid="PSA 94:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 94:14" />Mágurun lubaña Aburemei lumutuniña,</para>
  <para style="q" vid="PSA 94:14">mígirun lubaña giñe lánigu hábugua.<verse eid="PSA 94:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 94:15" />Lagiribudayaba irichaü tidoun lúbaana aguseruni,</para>
  <para style="q" vid="PSA 94:15">ábame hafalaruni gürigia ha harumabaña.<verse eid="PSA 94:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 94:16" />Kaba san ásaara lun lesefurunina</para>
  <para style="q" vid="PSA 94:16">hawéi wuribatiña luma hawéi adügütiña wuribani?<verse eid="PSA 94:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 94:17" />Lun hamuga buga míderagun lánina Nabureme,</para>
  <para style="q" vid="PSA 94:17">hilaadina hamuga.<verse eid="PSA 94:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 94:18" />Lidan yebe nariñagun: «Liriraaguatia nugudi»,</para>
  <para style="q" vid="PSA 94:18">aba biabin Nabureme lau bínsiñehabu, íderaguana.<verse eid="PSA 94:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 94:19" />Labadinagua idiheri le agibedagubei nisaminanrugu,</para>
  <para style="q" vid="PSA 94:19">rútibu dǘgüdaguaü nun luma ugundani.<verse eid="PSA 94:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 94:20" />Siñati gamada hamanibu aguseragüdütiña ha múaranbaña,</para>
  <para style="q" vid="PSA 94:20">ha múaragunbei haguseragüdün luma lúrudu.<verse eid="PSA 94:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 94:21" />Ha eledegubaña lubá le madurunbei ani haruma ligía</para>
  <para style="q" vid="PSA 94:21">aba hasiadiruni lun óunweni.<verse eid="PSA 94:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 94:22" />Gama lumoun, Nabureme naramudaguagülebei;</para>
  <para style="q" vid="PSA 94:22">Nubungiute, ligía dübü le aramudubalina.<verse eid="PSA 94:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 94:23" />Ladügüba Aburemei lun lagünrinchaguniña</para>
  <para style="q" vid="PSA 94:23">hariban guánarügü wuribatiña.</para>
  <para style="q" vid="PSA 94:23">Lagünrinchagubaña Wabungiute!<verse eid="PSA 94:23" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" sid="PSA 95" />
  <para style="s1">Weremuha lun Aburemei lau ugundani</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 95:1" />Higougu, weremuha lun Aburemei lau ugundani</para>
  <para style="q" vid="PSA 95:1">weremuha lun le óunigirubaliwa ani sefuláwa.<verse eid="PSA 95:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 95:2" />Belú wamá ligibugiñoun lau eteingiruni,</para>
  <para style="q" vid="PSA 95:2">weremuha lun luéirigun.<verse eid="PSA 95:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 95:3" />Ladüga Aburemei Búngiubei wéiriguti,</para>
  <para style="q" vid="PSA 95:3">Harúeite sun búngiugu.<verse eid="PSA 95:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 95:4" />Lúhaburuguñein lilulin-agei burí fulasu ligibuagu múa,</para>
  <para style="q" vid="PSA 95:4">lani sun liñun-agei burí wübü.<verse eid="PSA 95:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 95:5" />Lani barana, ladüga ligía adügübalin,</para>
  <para style="q" vid="PSA 95:5">ligía adügübalin múa mábeiti lau lúhabu guánarügü!<verse eid="PSA 95:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 95:6" />Higougu, hudugua wamá lun;</para>
  <para style="q" vid="PSA 95:6">hudugua wamá ligibugiñe Aburemei,</para>
  <para style="q" vid="PSA 95:6">ladüga ligía adügübaliwa.<verse eid="PSA 95:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 95:7" />Ligía Wabungiutebei,</para>
  <para style="q" vid="PSA 95:7">wagía lumutuniña;</para>
  <para style="q" vid="PSA 95:7">lilügüniña mudún wagía.</para>
  <para style="b" vid="PSA 95:7" />
  <para style="q" vid="PSA 95:7">Aganba huméi le lariñagubei hun uguñe:<verse eid="PSA 95:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 95:8" />«Medereragüda humóun hanigi kei yágüta Meribá;</para>
  <para style="q" vid="PSA 95:8">kei meha weyu lügüra yágüta Masá,</para>
  <para style="q" vid="PSA 95:8">lidan fulasu mageirawati,<verse eid="PSA 95:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 95:9" />dan le hóuchagunbalina hagüchagu,</para>
  <para style="q" vid="PSA 95:9">lau sun meha ariha hamaali lan katei le nadügübei.<verse eid="PSA 95:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 95:10" />Rédeitina gáñiñu hama gürigia hagía</para>
  <para style="q" vid="PSA 95:10">luagu bián-wein irumu, aba nariñagun:</para>
  <para style="q" vid="PSA 95:10">“Bóugudiñanu gürigia ha luéi üma le buídubei;</para>
  <para style="q" vid="PSA 95:10">midin hagía lau nugumadin!”<verse eid="PSA 95:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 95:11" />Ligía náfiñurunbei lidan nigañi</para>
  <para style="q" vid="PSA 95:11">luagu mebelubaña lan lidoun fulasu le emeraaguagülei».<verse eid="PSA 95:11" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" sid="PSA 96" />
  <para style="s1">Aban uremu iseri lun Aburemei</para>
  <para style="r">(<ref loc="1CH 16:23-33">1 Kro 16.23-33</ref>)</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 96:1" />Heremuha aban iseri uremu lun Aburemei;</para>
  <para style="q" vid="PSA 96:1">heremuha lun Aburemei, lílana sun ubóu;<verse eid="PSA 96:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 96:2" />heremuha lun Aburemei, alawaha huméi liri;</para>
  <para style="q" vid="PSA 96:2">hadimureha sagü weyu luagu lesefuhan.<verse eid="PSA 96:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 96:3" />Hadimureha luagu luéirigun</para>
  <para style="q" vid="PSA 96:3">luma burí katei buiti le ladügübei</para>
  <para style="q" vid="PSA 96:3">hadimureha luagu hagibugiñe sun néchanigu.<verse eid="PSA 96:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 96:4" />Wéiriguti Aburemei,</para>
  <para style="q" vid="PSA 96:4">ani gadünati lun leremuhóuniwa lun:</para>
  <para style="q" vid="PSA 96:4">Hanufunati hawéi sun búngiugu!<verse eid="PSA 96:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 96:5" />Ladüga ha burí lubungiutegu líbiri fulasu, ni kata hagía,</para>
  <para style="q" vid="PSA 96:5">ánheinti Aburemei, ligía adügübalin sielu.<verse eid="PSA 96:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 96:6" />Anihein óunwenbu uéiriguni ligibugiñe!</para>
  <para style="q" vid="PSA 96:6">Anihein ubafu luma uéndeni tidan lisanduariun!<verse eid="PSA 96:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 96:7" />Lílana sun fulasu,</para>
  <para style="q" vid="PSA 96:7">ru huméi ubafu luma uéiriguni lun Aburemei;<verse eid="PSA 96:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 96:8" />ru huméi uéiriguni le ladünabei Aburemei lun;</para>
  <para style="q" vid="PSA 96:8">belú humá lidoun libürürün lau idewesei,<verse eid="PSA 96:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 96:9" />hudugua humá lun Aburemei tidan tubuidunmeraü luban.</para>
  <para style="q" vid="PSA 96:9">Adadagara hamá súngubei ligibugiñe!<verse eid="PSA 96:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 96:10" />Ariñaga humá houn gürigia:</para>
  <para style="q" vid="PSA 96:10">«Urúei Aburemei!»</para>
  <para style="q" vid="PSA 96:10">Ligía íchugubei iderebugu lun ubóu lun mánhingichun lan;</para>
  <para style="q" vid="PSA 96:10">ligía agumadirubalin sun burí fulasu lau irichaü.<verse eid="PSA 96:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 96:11" />Gúndaaguala sielu luma múa!</para>
  <para style="q" vid="PSA 96:11">Lahuuha barana lau sun le lídanbei!<verse eid="PSA 96:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 96:12" />Gúndaaguala áraabu lau sun le lídanbei!</para>
  <para style="q" vid="PSA 96:12">Wáguala burí tídibu wewe le áraabubei lau ugundani,<verse eid="PSA 96:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 96:13" />ligibugiñe Aburemei le anitebei!</para>
  <para style="q" vid="PSA 96:13">Liábinba aguseragüda lidan múa!</para>
  <para style="q" vid="PSA 96:13">Laguseragüdübaña gürigia ubouagu</para>
  <para style="q" vid="PSA 96:13">lau irichaü luma ísuruni.<verse eid="PSA 96:13" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" sid="PSA 97" />
  <para style="s1">Aburemei Urúeibei!</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 97:1" />Gúndaaguala sun múa!</para>
  <para style="q" vid="PSA 97:1">Gúndaaguala burí ubouhu le gíbebei lamidangua barana!</para>
  <para style="q" vid="PSA 97:1">Aburemei urúeibei!<verse eid="PSA 97:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 97:2" />Geyeguliña dúeri luma luburiga lau;</para>
  <para style="q" vid="PSA 97:2">ísuruni luma irichaü</para>
  <para style="q" vid="PSA 97:2">ligía ágüdahabalin lálana larúeihan;<verse eid="PSA 97:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 97:3" />anihein watu gemeti lubá lubá</para>
  <para style="q" vid="PSA 97:3">ani gudá lumutiña áganiñu ha geyegubaña lau.<verse eid="PSA 97:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 97:4" />Harugoungadagüda lumuti burí lani labirihaniga ubóu;</para>
  <para style="q" vid="PSA 97:4">adadagarati múa dan le larihiniña!<verse eid="PSA 97:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 97:5" />Rǘrüguati burí áraabu kei lubuñe sanudelu</para>
  <para style="q" vid="PSA 97:5">ligibugiñe Aburemei le labureme sun ubóu.<verse eid="PSA 97:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 97:6" />Adimureha lumuti burí sielu liricha Bungiu;</para>
  <para style="q" vid="PSA 97:6">ariha hamuti sun gürigia luéirigun.<verse eid="PSA 97:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 97:7" />Ha áhuduragubaña houn guáriua,</para>
  <para style="q" vid="PSA 97:7">ha apantahabaña hau, rédeitiña ǘnabugu;</para>
  <para style="q" vid="PSA 97:7">sun búngiugu buluguatiña ligibugiñe!<verse eid="PSA 97:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 97:8" />Aburemei gúndaati Sión,</para>
  <para style="q" vid="PSA 97:8">luma burí uburugu le lani Hudá</para>
  <para style="q" vid="PSA 97:8">saraguhaña gúndaatiña lau bilurudun;<verse eid="PSA 97:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 97:9" />ladüga buguya, Aburemei Íñuguti,</para>
  <para style="q" vid="PSA 97:9">lóugiñeñadibu sun múa,</para>
  <para style="q" vid="PSA 97:9">ani íñugutimatibu hawéi sun búngiugu.<verse eid="PSA 97:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 97:10" />Hínsiñehabuti Aburemei houn ha iyereehabúbaña lun wuribati;</para>
  <para style="q" vid="PSA 97:10">góunigi lumuti habagari ha gúnfulibaña luma;</para>
  <para style="q" vid="PSA 97:10">sefu lumutiña luéi hábürühan</para>
  <para style="q" vid="PSA 97:10">háhaburugun gürigia wuribatiña.<verse eid="PSA 97:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 97:11" />Durunguati lanpu lun wügüri buiti;</para>
  <para style="q" vid="PSA 97:11">hounti gürigia ha harumabaña ugundani.<verse eid="PSA 97:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 97:12" />Gunda humá lidan Aburemei,</para>
  <para style="q" vid="PSA 97:12">gürigia buítiña, alawaha huméi liri le sándubei.<verse eid="PSA 97:12" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" sid="PSA 98" />
  <para style="s1">Darí laali Aburemei agañeiruni!</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 98:1" />Heremuha iseri uremu lun Aburemei,</para>
  <para style="q" vid="PSA 98:1">ladüga adügaali burí katei wéiriguti!</para>
  <para style="q" vid="PSA 98:1">Ibiha laali agañeiruni lau lueirin lubafu,</para>
  <para style="q" vid="PSA 98:1">lau larüna le sándubei!<verse eid="PSA 98:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 98:2" />Adimureha laali Aburemei lagañeirun;</para>
  <para style="q" vid="PSA 98:2">arufuda laali liricha hagibugiñe néchanigu;<verse eid="PSA 98:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 98:3" />Mabulieidun lumuti línsiñehabu</para>
  <para style="q" vid="PSA 98:3">luma ligunfulin houn Ísüraelina.</para>
  <para style="q" vid="PSA 98:3">Arihúaali lagañeirun Wabungiute</para>
  <para style="q" vid="PSA 98:3">chülǘ lumoun lagumuhóun larigeirugu ubóu!<verse eid="PSA 98:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 98:4" />Heremuha lun Bungiu lau ugundani</para>
  <para style="q" vid="PSA 98:4">huguya lílana sun fulasu;</para>
  <para style="q" vid="PSA 98:4">iñura huméi humalali lau ugundani,</para>
  <para style="q" vid="PSA 98:4">wa humá uremu lun.<verse eid="PSA 98:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 98:5" />Heremuha lun Aburemei</para>
  <para style="q" vid="PSA 98:5">lau tamuri árüpa tuma gidara.<verse eid="PSA 98:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 98:6" />Heremuha lau ugundani ligibugiñe</para>
  <para style="q" vid="PSA 98:6">Aburemei le urúei lau tamuri fidu.<verse eid="PSA 98:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 98:7" />Adürühalá barana lau sun le lídanbei;</para>
  <para style="q" vid="PSA 98:7">ubóu hau sun lílana;<verse eid="PSA 98:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 98:8" />apouhalei duna éibaaguati lúhabu;</para>
  <para style="q" vid="PSA 98:8">óundaraguala burí wübü</para>
  <para style="q" vid="PSA 98:8">lidan aban lun lagúaragun lau ugundani<verse eid="PSA 98:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 98:9" />ligibugiñe Aburemei,</para>
  <para style="q" vid="PSA 98:9">le anitebei lun lagumadihan ya múarugu.</para>
  <para style="q" vid="PSA 98:9">Lagumadihaba hadan lílana ubóu</para>
  <para style="q" vid="PSA 98:9">lau ísuruni luma irichaü.<verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" sid="PSA 99" />
  <para style="s1">Aburemei ligía Urúei le Íñugutimabei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 99:1" />Aburemei urúeibei!</para>
  <para style="q" vid="PSA 99:1">Anihein lálana larúeihan hóugiñe kátaña garünatiña!</para>
  <para style="q" vid="PSA 99:1">Adadagara hamá néchanigu lau sun múa dayarügü.<verse eid="PSA 99:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 99:2" />Wéiriguti Aburemei lidan wübü Sión;</para>
  <para style="q" vid="PSA 99:2">hóugiñeñein sun gürigia Aburemei.<verse eid="PSA 99:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 99:3" />Alawahoualá liri, wéiriti ani hanarimeti.</para>
  <para style="b" vid="PSA 99:3" />
  <para style="q" vid="PSA 99:3">Sánduti Bungiu!<verse eid="PSA 99:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 99:4" />Aban urúei le gabafuti buguya,</para>
  <para style="q" vid="PSA 99:4">le hínsiñehabubei lun irichaü;</para>
  <para style="q" vid="PSA 99:4">buguya guánarügü íchugubalin úarani.</para>
  <para style="q" vid="PSA 99:4">Óusera baaña lirahüñü Hakobu lau irichaü luma úarani.<verse eid="PSA 99:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 99:5" />Alawaha huméi Aburemei, le Wabungiute,</para>
  <para style="q" vid="PSA 99:5">hudugua humá ligibugiñe lugudi!</para>
  <para style="b" vid="PSA 99:5" />
  <para style="q" vid="PSA 99:5">Sánduti Bungiu!<verse eid="PSA 99:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 99:6" />Anihein Moisesi luma Aarón hadan lufadirinigu;</para>
  <para style="q" vid="PSA 99:6">anihein Samueli hadan ha meha eremuhabaña lun liri.</para>
  <para style="q" vid="PSA 99:6">Óunaba lumutiña meha Aburemei</para>
  <para style="q" vid="PSA 99:6">dan le hamuriahani lídehan.<verse eid="PSA 99:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 99:7" />Adimurehati Bungiu hama lídangiñe huánriñu,</para>
  <para style="q" vid="PSA 99:7">gúnfuli hamuti lugumadin</para>
  <para style="q" vid="PSA 99:7">luma lúrudu le líchugubei houn.<verse eid="PSA 99:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 99:8" />Aburemei, Wabungiute,</para>
  <para style="q" vid="PSA 99:8">óunaba bumutiñaha!</para>
  <para style="q" vid="PSA 99:8">Aban meha Bungiu le geferudunahaditi buguya houn,</para>
  <para style="q" vid="PSA 99:8">gama lumoun beigua bumutiña giñe luéigiñe hariban.<verse eid="PSA 99:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 99:9" />Alawaha huméi Aburemei Wabungiute,</para>
  <para style="q" vid="PSA 99:9">hudugua humá ligibugiñe luwübüri le sándubei!</para>
  <para style="b" vid="PSA 99:9" />
  <para style="q" vid="PSA 99:9">Sánduti Wabungiute le Aburemei!<verse eid="PSA 99:9" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" sid="PSA 100" />
  <para style="s1">Urúei gabafuti</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 100:1" />Heremuha lau ugundani lun</para>
  <para style="q" vid="PSA 100:1">Aburemei lílana sun fulasu!<verse eid="PSA 100:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 100:2" />Hudugua humá lun Aburemei lau ugundani;</para>
  <para style="q" vid="PSA 100:2">ñübuin humá ligibugiñoun agúaragueina lau ugundani!<verse eid="PSA 100:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 100:3" />Subudi huméi luagu Aburemei lan Búngiubei;</para>
  <para style="q" vid="PSA 100:3">ligía adügübaliwa, lani wagía;</para>
  <para style="q" vid="PSA 100:3">lumutuniña wagía, lilügüniña mudún!<verse eid="PSA 100:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 100:4" />Higougu luagun lubenari,</para>
  <para style="q" vid="PSA 100:4">belú humá lúbiñoun Bungiu</para>
  <para style="q" vid="PSA 100:4">eremuheina uremu lánina eteingiruni.</para>
  <para style="q" vid="PSA 100:4">Ru humá eteingiruni lun, alawaha huméi Bungiu!<verse eid="PSA 100:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 100:5" />Ladüga buiti Aburemei;</para>
  <para style="q" vid="PSA 100:5">ani magumuchaditi línsiñehabu,</para>
  <para style="q" vid="PSA 100:5">liabin ligunfulin, mébehati.<verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" sid="PSA 101" />
  <para style="s1">Le füramase lubéi urúei lun Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 101:1" />Busentina neremuhan lun ínsiñeni luma irichaü;</para>
  <para style="q" vid="PSA 101:1">Nabureme, busentina náwarun uremu bun;<verse eid="PSA 101:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 101:2" />busentina nabagaridun lau ísuruni.</para>
  <para style="q" vid="PSA 101:2">Ídaame san biabin nun?</para>
  <para style="b" vid="PSA 101:2" />
  <para style="q" vid="PSA 101:2">Úabei danaguati lidan nóuserun íbini núbiñe;<verse eid="PSA 101:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 101:3" />míchugun nubéi narihin luagun katei le mabuidunti.</para>
  <para style="b" vid="PSA 101:3" />
  <para style="q" vid="PSA 101:3">Bungiu iyereegutiña ha magunfulirunbaña buma nun;</para>
  <para style="q" vid="PSA 101:3">mígirunbadina lun hayarafadun nun!<verse eid="PSA 101:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 101:4" />Nadisedagüdübei lagübüri saminaü nuáriua;</para>
  <para style="q" vid="PSA 101:4">mabusenruntina nadügün ni kata wuribati!<verse eid="PSA 101:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 101:5" />Námanichagüdübaña ha adimurehabaña</para>
  <para style="q" vid="PSA 101:5">wuriba hawagu habesinanigu aramudaguarügü;</para>
  <para style="q" vid="PSA 101:5">mawandun numutiña ha barüguabaña houngua</para>
  <para style="q" vid="PSA 101:5">ha wéiribei liñun hanaagun houngua!<verse eid="PSA 101:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 101:6" />Níchugubei narihin hawagun gürigia gúnfulitiña</para>
  <para style="q" vid="PSA 101:6">lun haganóun nóubawagu,</para>
  <para style="q" vid="PSA 101:6">hárügübaña abagaridutiña aban ibagari suruti</para>
  <para style="q" vid="PSA 101:6">eredera nurugabu eseriwida nun.<verse eid="PSA 101:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 101:7" />Mabagaridunbei ni aban marasualuguti núbiñe!</para>
  <para style="q" vid="PSA 101:7">Meredebei ni aban biangua tigibu niñúarü!<verse eid="PSA 101:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 101:8" />Nagünrinchagubaña wuribatiña fulasurugu sagü weyu,</para>
  <para style="q" vid="PSA 101:8">nachagarubaña sun wuribatiña luburuguterugugiñe Aburemei!<verse eid="PSA 101:8" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" sid="PSA 102" />
  <para style="s1">Lafurieidun aban nidiheriti</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 102:1" />Nabureme, aganbabéi nafurieidun;</para>
  <para style="q" vid="PSA 102:1">chülüla nagúaragun bumoun!<verse eid="PSA 102:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 102:2" />Maramudabei bigibu nuéi dan le nidiheri nan; aganbabána!</para>
  <para style="q" vid="PSA 102:2">Óunababana furese dan le nagúarun bun!<verse eid="PSA 102:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 102:3" />Ladüga lagumuchaguña nibagari</para>
  <para style="q" vid="PSA 102:3">kei lagumuchagun gumuleli;</para>
  <para style="q" vid="PSA 102:3">gemeti nabu kamá leñegura watu;<verse eid="PSA 102:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 102:4" />ábürühatu nanigi kei híduru sáühali;</para>
  <para style="q" vid="PSA 102:4">mabusenrungubeitina ni lun neigin!<verse eid="PSA 102:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 102:5" />Badületi nura luagun nabu lárigi namumehan.<verse eid="PSA 102:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 102:6" />Ítara niña kei duguyu le lídanbei fulasu mageirawati,</para>
  <para style="q" vid="PSA 102:6">kei aban garún lidan günringuaü.<verse eid="PSA 102:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 102:7" />Marumuguntina.</para>
  <para style="q" vid="PSA 102:7">Ítara niña kei aban dunuru lábugua tábulugu muna.<verse eid="PSA 102:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 102:8" />Meredeti hanabagunina náganiñu,</para>
  <para style="q" vid="PSA 102:8">yusu haméi niri kei íñarawaguni.<verse eid="PSA 102:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 102:9" />Hóutina baligi teweñegua fein;</para>
  <para style="q" vid="PSA 102:9">gubuguati náguira tidan nuniñe,<verse eid="PSA 102:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 102:10" />ladüga basafaragun luma bagañidun numa,</para>
  <para style="q" vid="PSA 102:10">iñura bumutina lun báhuchurunina lárigiñe.<verse eid="PSA 102:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 102:11" />Sügüti burí nuéyuri kei lamuñounga;</para>
  <para style="q" vid="PSA 102:11">ásaüreinaniña kei híduru.<verse eid="PSA 102:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 102:12" />Gama lumoun buguya Aburemei, barúeihaba súnwandan;</para>
  <para style="q" vid="PSA 102:12">laritawaguba luagun biri súnwandan!<verse eid="PSA 102:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 102:13" />Iñuraguabá, gudemelá Sión bun,</para>
  <para style="q" vid="PSA 102:13">ladüga gúnfuliha dan;</para>
  <para style="q" vid="PSA 102:13">óuraali lun feruduna bani!<verse eid="PSA 102:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 102:14" />Hínsiñe buriti hadübüri bánigu houn;</para>
  <para style="q" vid="PSA 102:14">gagarigutiña luagu lagünrinchawagun!<verse eid="PSA 102:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 102:15" />Sun gürigia hama sun urúeigu ubouagu</para>
  <para style="q" vid="PSA 102:15">híchuguba uéiriguni lun liri Aburemei<verse eid="PSA 102:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 102:16" />danme le lararamagüdüni Sión lárigoun</para>
  <para style="q" vid="PSA 102:16">danme lachülaagun lidan luéirigun;<verse eid="PSA 102:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 102:17" />danme letenirun lun lafurieidun le igirúaalibei,</para>
  <para style="q" vid="PSA 102:17">mígirun ligíame laganbuni layumuragun.<verse eid="PSA 102:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 102:18" />Bürüwalá katei le habá iseri inebanfangu</para>
  <para style="q" vid="PSA 102:18">lun híchugun ha mágurahoungiñabaña uéiriguni</para>
  <para style="q" vid="PSA 102:18">lun Aburemei danme hayabin ubouagun.<verse eid="PSA 102:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 102:19" />Ariha lumuti Aburemei múa siélugiñe;<verse eid="PSA 102:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 102:20" />lun letenirun lun hayahun adaürǘtiña,</para>
  <para style="q" vid="PSA 102:20">lun lesefuruniña ha siádiwaañabaña lun óunweni;<verse eid="PSA 102:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 102:21" />lun laguarahóun luma lun leremuhóun</para>
  <para style="q" vid="PSA 102:21">liri Aburemei Sión luma Herusalén.<verse eid="PSA 102:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 102:22" />Danme hóundaragun sun hawuyeri</para>
  <para style="q" vid="PSA 102:22">gürigia lun háhuduragun lun.<verse eid="PSA 102:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 102:23" />Gidaali lídangiñe nere lidan yebe nibureingidina,</para>
  <para style="q" vid="PSA 102:23">chátigüdatima laali nibagari.<verse eid="PSA 102:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 102:24" />Ariñagatina lun:</para>
  <para style="q" vid="PSA 102:24">«Nabureme, manügabána lamidangua nibagari».</para>
  <para style="b" vid="PSA 102:24" />
  <para style="q" vid="PSA 102:24">Mébehaburiti birumudiri!<verse eid="PSA 102:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 102:25" />Derebugugüda bumuti múa lúmagiñe furumiñeti dan;</para>
  <para style="q" vid="PSA 102:25">buguya guánarügü adügübalin sielu.<verse eid="PSA 102:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 102:26" />Sun ligía lagumuchaguba,</para>
  <para style="q" vid="PSA 102:26">anhein buguya ñeinmemebadibu;</para>
  <para style="q" vid="PSA 102:26">sun ligía lawesiruba kei daüguaü;</para>
  <para style="q" vid="PSA 102:26">basansirubaña ábame herederun sánsiguañu</para>
  <para style="q" vid="PSA 102:26">kei gürigia ha asansirutiña hadaüragun!<verse eid="PSA 102:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 102:27" />Ánheinti buguya, buguyamémegidibu</para>
  <para style="q" vid="PSA 102:27">magumuchadibei birumudiri.<verse eid="PSA 102:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 102:28" />Bíchuguba achoururuni houn hadügawagun bubueingu;</para>
  <para style="q" vid="PSA 102:28">bíchuguba ubaraü houn biñuarü.<verse eid="PSA 102:28" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" sid="PSA 103" />
  <para style="s1">Nalawahabei Nabureme</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 103:1" />Nalawahabei Nabureme tau sun nuani;</para>
  <para style="q" vid="PSA 103:1">nalawahabei liri Bungiu le sándubei lau sun núgubu.<verse eid="PSA 103:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 103:2" />Nalawahabei Nabureme tau sun nuani;</para>
  <para style="q" vid="PSA 103:2">mabulieidúnbadina ni aban</para>
  <para style="q" vid="PSA 103:2">lídangiñe sun ubuiduni le ladügübei nun.<verse eid="PSA 103:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 103:3" />Ligía ferudunabalin sun nuriban;</para>
  <para style="q" vid="PSA 103:3">ligía areidaguagüdübalin sun nisandi;<verse eid="PSA 103:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 103:4" />ligía esefurubalin nibagari lídangiñe umúahaü;</para>
  <para style="q" vid="PSA 103:4">ligía abuinchagüdübalina lau ínsiñeni luma areiduni;<verse eid="PSA 103:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 103:5" />ligía agufurumadagüdübalina lau sun le buítimabei,</para>
  <para style="q" vid="PSA 103:5">adüga ligía lun nibureinmémebadina lan</para>
  <para style="q" vid="PSA 103:5">ani here kei aban ágila.<verse eid="PSA 103:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 103:6" />Ha asufurirubaña anarimeni,</para>
  <para style="q" vid="PSA 103:6">aguseragüda lumutiña Aburemei</para>
  <para style="q" vid="PSA 103:6">lau irichaü le tímatimaati.<verse eid="PSA 103:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 103:7" />Subudigüda lumuti lémeri luma</para>
  <para style="q" vid="PSA 103:7">burí katei le ladügübei lun Moisesi</para>
  <para style="q" vid="PSA 103:7">luma houn Ísüraelina.<verse eid="PSA 103:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 103:8" />Areidati Aburemei, gudemehabu ligia;</para>
  <para style="q" vid="PSA 103:8">gaguraasunti giñe hínsiñehabu ligía.<verse eid="PSA 103:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 103:9" />Madeinhanti woun sagü dan,</para>
  <para style="q" vid="PSA 103:9">madurati giñe ligañi lun súnwandan;<verse eid="PSA 103:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 103:10" />mabeichun lumutiwa Bungiu keisi le wadünabei</para>
  <para style="q" vid="PSA 103:10">mafayeihángüdalawa luagu wariban luma wafigoun;<verse eid="PSA 103:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 103:11" />wéiriti línsiñehabu houn ha inebehabubaña</para>
  <para style="q" vid="PSA 103:11">ítara kéisigubeirügü lueirin sielu lóugiñe múa.<verse eid="PSA 103:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 103:12" />Dísegüda laali wafigoun wawéi,</para>
  <para style="q" vid="PSA 103:12">kei ladisedagüdüni labouchagüle weyu luéi lálüdagüle.<verse eid="PSA 103:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 103:13" />Areidati Aburemei houn ha inebehabubaña lun</para>
  <para style="q" vid="PSA 103:13">kei ligaburi aban úguchili hama lirahüñü;<verse eid="PSA 103:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 103:14" />subudi lumuti ka lan wabuñabei</para>
  <para style="q" vid="PSA 103:14">káteitimañadiwa lan:</para>
  <para style="q" vid="PSA 103:14">Subudi lumuti buidu, luagu múa lan wabuñabei.<verse eid="PSA 103:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 103:15" />Ítara liña habagari gürigia kei híduru,</para>
  <para style="q" vid="PSA 103:15">hüchati kei aban fuluri áraabuna:<verse eid="PSA 103:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 103:16" />Ítara kei láfuragun garabali luagun,</para>
  <para style="q" vid="PSA 103:16">aba lagumuchagun,</para>
  <para style="q" vid="PSA 103:16">ani ibidiñedigiaali luáguti ni ka un.<verse eid="PSA 103:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 103:17" />Ánheinti línsiñehabu Aburemei houn</para>
  <para style="q" vid="PSA 103:17">ha íchugubaña inebesei lun, magumuchaditi;</para>
  <para style="q" vid="PSA 103:17">mébehati lirichadüna hadan sun hadügawagun,<verse eid="PSA 103:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 103:18" />ha agunfulirubalin lidaradun,</para>
  <para style="q" vid="PSA 103:18">mabulieidagun hagía luéi houdin</para>
  <para style="q" vid="PSA 103:18">lau le lubeibei lugumadin.<verse eid="PSA 103:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 103:19" />Ru laali Aburemei lálana larúeihan sielu,</para>
  <para style="q" vid="PSA 103:19">gabafuti larúeihan luagu sun katei.<verse eid="PSA 103:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 103:20" />Alawaha huméi Aburemei, ánheligu gabafutiña!</para>
  <para style="q" vid="PSA 103:20">Huguya le agunfulirubalin lererun,</para>
  <para style="q" vid="PSA 103:20">huguya le aranseñubei lun hidin lau le lubeibei.<verse eid="PSA 103:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 103:21" />Alawaha huméi Aburemei sun huguya lisudaranigu,</para>
  <para style="q" vid="PSA 103:21">ha eseriwidubalin, adüga huméi lugundan!<verse eid="PSA 103:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 103:22" />Alawaha huméi Aburemei sun huguya ha ladügübaña,</para>
  <para style="q" vid="PSA 103:22">lidan sun fulasu le lánina larúeihan!</para>
  <para style="b" vid="PSA 103:22" />
  <para style="q" vid="PSA 103:22">Nalawahabei Nabureme tau sun nuani!<verse eid="PSA 103:22" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" sid="PSA 104" />
  <para style="s1">Alawahani lun le adügübalin sun katei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 104:1" />Nalawahabei Nabureme tau sun nuani!</para>
  <para style="q" vid="PSA 104:1">Ma lanarime bueirin, Nabureme, Bungiu!</para>
  <para style="q" vid="PSA 104:1">Dáüguaadibu lau uéiriguni luma arugoungani;<verse eid="PSA 104:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 104:2" />daruguaadibu baugua tau aban manda lautu larugounga.</para>
  <para style="q" vid="PSA 104:2">Tulegua bumuti sielu kei aban belu!<verse eid="PSA 104:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 104:3" />Derebugugüda bumuti tuágaburi</para>
  <para style="q" vid="PSA 104:3">buban lóugiñe duna, yágüta iñun!</para>
  <para style="q" vid="PSA 104:3">Adüga bumuti dúeri lun bikarünme;</para>
  <para style="q" vid="PSA 104:3">áhamahatibu lidan larüna garabali!<verse eid="PSA 104:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 104:4" />Adüga bumuti garabali lun bóunagüleme,</para>
  <para style="q" vid="PSA 104:4">adügabéi ligemeri watu lun leseriwidunibu.<verse eid="PSA 104:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 104:5" />Ru bumuti múa luagu lebu,</para>
  <para style="q" vid="PSA 104:5">lun mánhingichun lan lídangiñe lubara.<verse eid="PSA 104:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 104:6" />Daruguati buga barana huliliti lau múa</para>
  <para style="q" vid="PSA 104:6">kamá hamuga aban daüguaü</para>
  <para style="q" vid="PSA 104:6">darugua ligía duna lau wübü.<verse eid="PSA 104:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 104:7" />Gama lumoun aba badeinhan lun, aba lidin;</para>
  <para style="q" vid="PSA 104:7">aba léibaagun dan le laganbuni bumalali</para>
  <para style="q" vid="PSA 104:7">libe lumalali wayuhuru.<verse eid="PSA 104:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 104:8" />Amudeireina luagun wübü,</para>
  <para style="q" vid="PSA 104:8">ararireina lidoun fulasu wayati,</para>
  <para style="q" vid="PSA 104:8">aba lidin le ñeinhin lubéi bóunahei,<verse eid="PSA 104:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 104:9" />lidoun leben le uágubei bariñaga lun mánhiñuragunlani,</para>
  <para style="q" vid="PSA 104:9">lueiya ladouragun lau múa.<verse eid="PSA 104:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 104:10" />Óunaha bumuti burí duna ñéingiñe lubéi láhücha</para>
  <para style="q" vid="PSA 104:10">lidoun burí lirahüñü duna le éibaagubei wǘbüwagu.<verse eid="PSA 104:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 104:11" />Lídangiñe duna ligía hata animaalugu áraabuna;</para>
  <para style="q" vid="PSA 104:11">lau hagidarei burigü áraabuna hamagürabu.<verse eid="PSA 104:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 104:12" />Adaaguatiña dunuru hádibu laru duna,</para>
  <para style="q" vid="PSA 104:12">eremuhatiña ñein, labadinagua tilimun wewe!<verse eid="PSA 104:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 104:13" />Buguya áturagubalin sagadi,</para>
  <para style="q" vid="PSA 104:13">tídangiñe buban yágüta iñun;</para>
  <para style="q" vid="PSA 104:13">gufurumagüda bumuti múa lau duna siélugiñe.<verse eid="PSA 104:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 104:14" />Wéinamugüda bumuti sagadi lun heigin animaalugu,</para>
  <para style="q" vid="PSA 104:14">luma nadü le lábunagubei gürigia</para>
  <para style="q" vid="PSA 104:14">lun libihini leigin lídangiñe múa,<verse eid="PSA 104:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 104:15" />éigini le íchugubei erei lun;</para>
  <para style="q" vid="PSA 104:15">diwéin to agundaaragüdübalin libagari,</para>
  <para style="q" vid="PSA 104:15">mirigüdatei ligibu sügǘ lau garaba.<verse eid="PSA 104:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 104:16" />Áfara tumuti burí tídibu wewe tumagürabu,</para>
  <para style="q" vid="PSA 104:16">hibúari Líwanuna to lábunaguboun Aburemei.<verse eid="PSA 104:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 104:17" />Adügatiña hañübürin-agei dunuru hádibu tuagu;</para>
  <para style="q" vid="PSA 104:17">luagu burí lídibu gudi haganóua yábura.<verse eid="PSA 104:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 104:18" />Lidan burí áraabu le íñuti,</para>
  <para style="q" vid="PSA 104:18">ñéinñanu gábara,</para>
  <para style="q" vid="PSA 104:18">labadinagua burí dübü,</para>
  <para style="q" vid="PSA 104:18">ñein haramudagua másaraga.<verse eid="PSA 104:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 104:19" />Adüga bumuti hati lun lamisurahani dan;</para>
  <para style="q" vid="PSA 104:19">subuditi lidaani lálüdün weyu lun.<verse eid="PSA 104:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 104:20" />Tulé bumutu manda búrigatu to lánina áriebu,</para>
  <para style="q" vid="PSA 104:20">ligíati háfuridun animaalu áraabuna.<verse eid="PSA 104:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 104:21" />Adürürühatiña liñún hárigi háliru;</para>
  <para style="q" vid="PSA 104:21">amuriahatiña luma Aburemei lun líchuguni heigin houn.<verse eid="PSA 104:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 104:22" />Gama lumoun dan le láfuridun weyu,</para>
  <para style="q" vid="PSA 104:22">aba houdin arounra lidan hamasa.<verse eid="PSA 104:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 104:23" />Ligíati láfuridun gürigia adügei luadigimari,</para>
  <para style="q" vid="PSA 104:23">aba luadigimaridun darí laguñeedun.<verse eid="PSA 104:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PSA 104:24" />Gíbeti burí katei le adüga báalibei Aburemei!</para>
  <para style="q" vid="PSA 104:24">Lau lichú aau badügei súngubei;</para>
  <para style="q" vid="PSA 104:24">arihúati sun katei le badügübei lidan sun fulasu!<verse eid="PSA 104:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 104:25" />Anihán barana, dabubere liña ani migife ligía,</para>
  <para style="q" vid="PSA 104:25">añahein saragu animaalugu lidan</para>
  <para style="q" vid="PSA 104:25">darí lun siñá lan habahüdǘniwa,</para>
  <para style="q" vid="PSA 104:25">wéinamutiña hama ñǘbüritiña.<verse eid="PSA 104:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 104:26" />Áfayahatu burí waporu ñein,</para>
  <para style="q" vid="PSA 104:26">anihein Lewiatán ñein,</para>
  <para style="q" vid="PSA 104:26">animaalu baranahana le badügübei lun láhurerun lidan.<verse eid="PSA 104:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 104:27" />Sun hagía agurabahatiña</para>
  <para style="q" vid="PSA 104:27">lun bíchuguni heigin houn lidan lidaani.<verse eid="PSA 104:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 104:28" />Rútibu houn, aba habudahan;</para>
  <para style="q" vid="PSA 104:28">dará bumuti búhabu,</para>
  <para style="q" vid="PSA 104:28">aba habuinchun lau lubuidun-agei;<verse eid="PSA 104:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 104:29" />anhein baramuda bigibu, aba hanufudedun,</para>
  <para style="q" vid="PSA 104:29">ánhabu míchugun awaraguni houn,</para>
  <para style="q" vid="PSA 104:29">aba hóunwegun ábaya hasaliragun kalikime.<verse eid="PSA 104:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 104:30" />Gama lumoun anhein bóunaha báfurun le lánina ibagari,</para>
  <para style="q" vid="PSA 104:30">aba hagibedagun aba iserigua lan larihíniwa múa.<verse eid="PSA 104:30" /></para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" sid="PSA 104:31" />Magumuchaditi luéirigun Aburemei!</para>
  <para style="q" vid="PSA 104:31">Gúndaati Aburemei lau burí katei le ladügübei!<verse eid="PSA 104:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 104:32" />Adadagarati múa dan le larihin Bungiu luagun;</para>
  <para style="q" vid="PSA 104:32">ígiragüdati burí wübü gumuleli dan le laguuruni!<verse eid="PSA 104:32" /></para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" sid="PSA 104:33" />Neremuhaba lun Nabureme sun wínwangidina lan,</para>
  <para style="q" vid="PSA 104:33">neremuhaba lun Nubungiute lidan sun nibagari.<verse eid="PSA 104:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 104:34" />Labusenradügü hamuga Nabureme lagundaarun lau nisaminan</para>
  <para style="q" vid="PSA 104:34">ladüga lídanrügüñein nadarirei nugundan.<verse eid="PSA 104:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 104:35" />Gumugua hamá gafigountiña ligibuagugiñe ubóu!</para>
  <para style="q" vid="PSA 104:35">Gumugua hamá salufuritiña!</para>
  <para style="b" vid="PSA 104:35" />
  <para style="q" vid="PSA 104:35">Nalawahabei Nabureme tau sun nuani!</para>
  <para style="q" vid="PSA 104:35">Alawahoualá Aburemei!<verse eid="PSA 104:35" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" sid="PSA 105" />
  <para style="s1">Le ladügübei Bungiu luagu Ísüraeli</para>
  <para style="r">(<ref loc="1CH 16:8-22">1 Kro 16.8-22</ref>)</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 105:1" />Ru humá eteingiruni lun Aburemei!</para>
  <para style="q" vid="PSA 105:1">Hadimureha luagu liri!</para>
  <para style="q" vid="PSA 105:1">Abahüdagua humá houn burí lílana fulasu</para>
  <para style="q" vid="PSA 105:1">luagu katei burí le ladügübei.<verse eid="PSA 105:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 105:2" />Heremuha uremu luagu luéirigun.</para>
  <para style="q" vid="PSA 105:2">Hadimureha luagu burí katei wéinamuti le ladügübei!<verse eid="PSA 105:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 105:3" />Hapantaha lau liri le sándubei.</para>
  <para style="q" vid="PSA 105:3">Gúndaata hanigi ha áluahabalin Aburemei!<verse eid="PSA 105:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 105:4" />Ñübuin humá lun Aburemei,</para>
  <para style="q" vid="PSA 105:4">áluaha huméi lubafu;</para>
  <para style="q" vid="PSA 105:4">áluaha huméi súnwandan.<verse eid="PSA 105:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 105:5" />Haritagua huméi luéinamun</para>
  <para style="q" vid="PSA 105:5">luma lubuidun burí katei le ladügübei,</para>
  <para style="q" vid="PSA 105:5">luma burí dimurei le ariñaga láalibei;<verse eid="PSA 105:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 105:6" />huguya le ladügawagun Abüraámü;</para>
  <para style="q" vid="PSA 105:6">huguya le lirahüñü Hakobu, ha lanúadirubaña.<verse eid="PSA 105:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 105:7" />Ligía Aburemeibei, Wabungiute;</para>
  <para style="q" vid="PSA 105:7">ligía agumadihabei lidan sun fulasu!<verse eid="PSA 105:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 105:8" />Ni anhein ásügüra milu inebanfangu,</para>
  <para style="q" vid="PSA 105:8">mabulieidagunbei luéi lidaradun,<verse eid="PSA 105:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 105:9" />daradu le ladügübei luma Abüraámü,</para>
  <para style="q" vid="PSA 105:9">fiñún le ladügübei lun Isaakü,<verse eid="PSA 105:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 105:10" />ani gufirümalei keisi lúrudu lun Hakobu,</para>
  <para style="q" vid="PSA 105:10">keisi daradu magumuchaditi lun Ísüraeli,<verse eid="PSA 105:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 105:11" />dan le lariñagunbei:</para>
  <para style="q" vid="PSA 105:11">«Níchugubei lumúan Kanán bun keisi alagan».<verse eid="PSA 105:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 105:12" />Lau sun meha mibe hamá,</para>
  <para style="q" vid="PSA 105:12">fiuraü meha terencha fulasurugu,<verse eid="PSA 105:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 105:13" />éibugatiña lídangiñe aban néchani lun lidoun aban</para>
  <para style="q" vid="PSA 105:13">lídangiñe aban arúeihani lun lidoun aban,<verse eid="PSA 105:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 105:14" />mígirunti Bungiu lun hóuserawagun;</para>
  <para style="q" vid="PSA 105:14">ariñagagubeiti houn urúeigu.<verse eid="PSA 105:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 105:15" />«Maguura humatia hawagu nanúadirun,</para>
  <para style="q" vid="PSA 105:15">móuseragun humañame nani profetagu».<verse eid="PSA 105:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 105:16" />Ñǘbuingüdati ilamaü lidoun fulasu ligía,</para>
  <para style="q" vid="PSA 105:16">gidá lumuti sun éigini hawéi.<verse eid="PSA 105:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 105:17" />Gama lumoun aba lóunahani Hosé habá habá,</para>
  <para style="q" vid="PSA 105:17">le meha halugurubei lun idamunime.<verse eid="PSA 105:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 105:18" />Güragua hamuti lugudi lau güringüri,</para>
  <para style="q" vid="PSA 105:18">murú hamuti lau gürabu!<verse eid="PSA 105:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 105:19" />Hóuchagua lumuti lererun Aburemei Hosé,</para>
  <para style="q" vid="PSA 105:19">darí lagunfulirun le buga uágubei</para>
  <para style="q" vid="PSA 105:19">lariñaga Hosé lasusereduba lan.<verse eid="PSA 105:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 105:20" />Urúei, le buga agumadirubei saragu gürigia,</para>
  <para style="q" vid="PSA 105:20">aba lariñagun lun lígirawagüdüniwa;<verse eid="PSA 105:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 105:21" />aba líchuguni keisi aburemei</para>
  <para style="q" vid="PSA 105:21">tidan luban lau sun le lúmabei,<verse eid="PSA 105:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 105:22" />lun larufudahan chúgüda ligíame hau</para>
  <para style="q" vid="PSA 105:22">ábutigu habu wéiyaaña mutu.<verse eid="PSA 105:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 105:23" />Lárigiñe aba liabin Ísüraeli, le Hakobu,</para>
  <para style="q" vid="PSA 105:23">aba laganóun keisi terencha Ehiptu lumúanrugu Kamü.<verse eid="PSA 105:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 105:24" />Aba lagibedaguagüdüniña Bungiu lánigu</para>
  <para style="q" vid="PSA 105:24">ani héretima hagía hawéi Ehiptuna.<verse eid="PSA 105:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 105:25" />Gama lumoun adügati lun hiñuragun</para>
  <para style="q" vid="PSA 105:25">Ehiptuna houngua hawagun lánigu,</para>
  <para style="q" vid="PSA 105:25">luma lun heyeeduniña eseriwidutiña lun Bungiu.<verse eid="PSA 105:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PSA 105:26" />Ábati lóunahani Bungiu Moisesi luma Aarón,</para>
  <para style="q" vid="PSA 105:26">le buga lanúadirubei,<verse eid="PSA 105:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 105:27" />aba hadaagun liseinin Bungiu lidan fulasu mageirawati:</para>
  <para style="q" vid="PSA 105:27">Katei wéinamuti luma buíduburiti lidan lumúan Kamü!<verse eid="PSA 105:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 105:28" />Óunahati Bungiu aban luburiga</para>
  <para style="q" vid="PSA 105:28">le adouragubei lau sun katei,</para>
  <para style="q" vid="PSA 105:28">gama lumoun madügüntiña Ehiptuna gasu lau lererun.<verse eid="PSA 105:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 105:29" />Saliguagüda lumuti hadunari hítaüme,</para>
  <para style="q" vid="PSA 105:29">aba láfaraguniña úduraü;<verse eid="PSA 105:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 105:30" />Buíngüda lumuti fulasu hau húa</para>
  <para style="q" vid="PSA 105:30">chülǘ tidoun lubarari urúei.<verse eid="PSA 105:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 105:31" />Aba ladimurehan Bungiu,</para>
  <para style="q" vid="PSA 105:31">aba hayabingua saragu mabarawa</para>
  <para style="q" vid="PSA 105:31">hama íñenaü lidan sun hageira Ehiptuna.<verse eid="PSA 105:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 105:32" />Óunahati lúbara huya dereguati leweñegua huya</para>
  <para style="q" vid="PSA 105:32">luma ligemeri watu luagun fulasu.<verse eid="PSA 105:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 105:33" />Günringua lumuti burí tídibu beibei luma tídibu igu;</para>
  <para style="q" vid="PSA 105:33">günringua lumuti burí tídibu wewe Ehiptu!<verse eid="PSA 105:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 105:34" />Aba ladimurehan Bungiu, aba hayabin chigangaru:</para>
  <para style="q" vid="PSA 105:34">Gíbetiña, darí lun siñá lan habahüdǘniwa!<verse eid="PSA 105:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 105:35" />Aba héigini híduru le áraabubei</para>
  <para style="q" vid="PSA 105:35">luma sun nadü le áhüchübei yebe ligibuagu múa!<verse eid="PSA 105:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 105:36" />Áfara lumutiña ígiramaü tidan sun muna Ehiptuna!<verse eid="PSA 105:36" /></para>
  <para style="b" />
  <para style="q">
    <verse number="37" style="v" sid="PSA 105:37" />Lárigiñe aba láfuridagüdüniña Bungiu lánigu</para>
  <para style="q" vid="PSA 105:37">buin lau golu luma pülata Ehiptugiñe,</para>
  <para style="q" vid="PSA 105:37">ani úati ni aban hádangiñe hani türibu achugeraguti.<verse eid="PSA 105:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 105:38" />Aba hagundaaragun Ehiptuna dan le harihini houdin,</para>
  <para style="q" vid="PSA 105:38">ladüga hanufude hawéi.<verse eid="PSA 105:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 105:39" />Óunahati Bungiu aban dúeri</para>
  <para style="q" vid="PSA 105:39">lun ladouragun hau wéyuagu,</para>
  <para style="q" vid="PSA 105:39">luma aban ligemeri watu</para>
  <para style="q" vid="PSA 105:39">lun larugoungadagüdün hau áriebu.<verse eid="PSA 105:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 105:40" />Amuriahatiña éigini luma,</para>
  <para style="q" vid="PSA 105:40">aba lóunahan dunuru houn,</para>
  <para style="q" vid="PSA 105:40">aba lakimuledagüdüniña tau fein siélugiñetu.<verse eid="PSA 105:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 105:41" />Bougua lumuti dübü aba láfuridun duna lídangiñe,</para>
  <para style="q" vid="PSA 105:41">aba léibaagun duna ligía lidan</para>
  <para style="q" vid="PSA 105:41">fulasu mageirawati kamá aban óunwenbu duna.<verse eid="PSA 105:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 105:42" />Ladüga haritaguati luagun füramasei sánduti</para>
  <para style="q" vid="PSA 105:42">le líchugubei lun Abüraámü.<verse eid="PSA 105:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 105:43" />Ítara liña lubeiti láfuridagüdüniña Bungiu lánigu</para>
  <para style="q" vid="PSA 105:43">ha lanúadirubaña agúaraheina lau ugundani,<verse eid="PSA 105:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 105:44" />aba líchuguni hageira amu néchani houn</para>
  <para style="q" vid="PSA 105:44">luma halubahan amu gürigia lídangiñe hawadigimari.<verse eid="PSA 105:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 105:45" />Gama lumoun lun buga linebeduba lan houn,</para>
  <para style="q" vid="PSA 105:45">teni hagíame lun lilurudun luma larufudahan Aburemei.</para>
  <para style="b" vid="PSA 105:45" />
  <para style="q" vid="PSA 105:45">Alawahoualá Aburemei!<verse eid="PSA 105:45" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" sid="PSA 106" />
  <para style="s1">Hamabuchahan Ísüraelina</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 106:1" />Alawahoualá Aburemei!</para>
  <para style="b" vid="PSA 106:1" />
  <para style="q" vid="PSA 106:1">Ru humá eteingiruni lun Aburemei,</para>
  <para style="q" vid="PSA 106:1">ladüga buiti Bungiu,</para>
  <para style="q" vid="PSA 106:1">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 106:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 106:2" />Ka gayaraabei labahüdaguni sun lagañeirun Aburemei?</para>
  <para style="q" vid="PSA 106:2">Ka gayaraabei lalawahani keisi aubei ladüna?<verse eid="PSA 106:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 106:3" />Fuleseiwatiña ha éibugubaña lidan irichaü</para>
  <para style="q" vid="PSA 106:3">adüga haméi le richaguabei súnwandan.<verse eid="PSA 106:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 106:4" />Baritaguame nuagun, Nabureme,</para>
  <para style="q" vid="PSA 106:4">danme le badügün buiti houn bumutuniña;</para>
  <para style="q" vid="PSA 106:4">mabulieidunbáname danme le biabin esefuha,<verse eid="PSA 106:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 106:5" />ariha náamugei hagundan ha banúadirubaña,</para>
  <para style="q" vid="PSA 106:5">lun nagundaarun apantaha aume</para>
  <para style="q" vid="PSA 106:5">úara hama gürigia ha bánigu.<verse eid="PSA 106:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 106:6" />Afigouhaadiwa kéisigubeirügü wagübürigu;</para>
  <para style="q" vid="PSA 106:6">adüga wamaali le wuribabei.<verse eid="PSA 106:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 106:7" />Rútiña meha wagübürigu mebereseni</para>
  <para style="q" vid="PSA 106:7">luagu burí luéinamun katei le badügübei yágüta Ehiptu,</para>
  <para style="q" vid="PSA 106:7">bulíei hamuti lueirin bínsiñehabu,</para>
  <para style="q" vid="PSA 106:7">iñuraguatiña houngua buagun laru Barana Funati.<verse eid="PSA 106:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 106:8" />Lau sun lira sefu lumutiña Bungiu luagu liri,</para>
  <para style="q" vid="PSA 106:8">luma lun larufuduni lubafu.<verse eid="PSA 106:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 106:9" />Ébecha lumuti Barana Funati darí lamabeidagüdüni;</para>
  <para style="q" vid="PSA 106:9">sügügüda lumutiña lamidanguagiñe barana</para>
  <para style="q" vid="PSA 106:9">mábeiñu kei aban fulasu mageirawati.<verse eid="PSA 106:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 106:10" />Ítara liña lesefuruniña hawéi háganiñu,</para>
  <para style="q" vid="PSA 106:10">lídangiñe habafu ha iyereehabúbaña houn.<verse eid="PSA 106:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 106:11" />Daruguati duna hau háganiñu,</para>
  <para style="q" vid="PSA 106:11">mesefuti ni aban hádangiñe.<verse eid="PSA 106:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 106:12" />Ábati hafiñerun luagu le lariñagubei Bungiu,</para>
  <para style="q" vid="PSA 106:12">aba heremuhan lun.<verse eid="PSA 106:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 106:13" />Gama lumoun málüti lúmagiñe,</para>
  <para style="q" vid="PSA 106:13">ábaya habulieidagun luéi le buga ladügübei Bungiu,</para>
  <para style="q" vid="PSA 106:13">magurabuntiña hasubudiruni laransehan;<verse eid="PSA 106:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 106:14" />aba hóuchaguni Bungiu lidan fulasu mageirawati,</para>
  <para style="q" vid="PSA 106:14">éreda luagu lun líchuguni le habusenrubei houn.<verse eid="PSA 106:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 106:15" />Aba líchuguni Bungiu le hamuriahabei houn,</para>
  <para style="q" vid="PSA 106:15">gama lumoun óunahati aban sandi gáfarahati hawagun.<verse eid="PSA 106:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 106:16" />Gimugatiñaha lun Moisesi, kianpu-ágeirugu</para>
  <para style="q" vid="PSA 106:16">luma lun Aarón, le deregeguabei lungua lun Aburemei.<verse eid="PSA 106:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 106:17" />Ábati ladaaragun múa,</para>
  <para style="q" vid="PSA 106:17">aba láhuluchuni Datán hau sun lánigu Abirámü;<verse eid="PSA 106:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 106:18" />aba ladurangun watu hawagun sun hagía!</para>
  <para style="q" vid="PSA 106:18">Aba láguduniña watu gemeti sun ha adaagubaña wuribati!<verse eid="PSA 106:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 106:19" />Adügatiña aban bágasu lidan wübü le Orebü,</para>
  <para style="q" vid="PSA 106:19">aban guáriua lauti golu rǘrüguati, aba háhuduragun lun:<verse eid="PSA 106:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 106:20" />Sansi hamuti Bungiu le inarüniti</para>
  <para style="q" vid="PSA 106:20">tuagu liyawa aban bágasu le éigiti híduru!<verse eid="PSA 106:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 106:21" />Bulíei hamuti Bungiu, le hesefuragüle,</para>
  <para style="q" vid="PSA 106:21">le buga adügübei katei wéinamuti Ehiptu;<verse eid="PSA 106:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 106:22" />le buga adügübei lubuidun burí katei lidan lageira Kamü,</para>
  <para style="q" vid="PSA 106:22">luma burí katei le aweiridagüdüti anigi lidan Barana Funati.<verse eid="PSA 106:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 106:23" />Álugati yebe Bungiu lagünrinchaguniña,</para>
  <para style="q" vid="PSA 106:23">gama lumoun aba ladimurehan Moisesi luagu hafulesein,</para>
  <para style="q" vid="PSA 106:23">aba ladilirun ligañi Bungiu,</para>
  <para style="q" vid="PSA 106:23">aba magünrinchagun lániña.<verse eid="PSA 106:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PSA 106:24" />Lárigiñe, aba hanügün aban fulasu buídumeraüti kei ni kata,</para>
  <para style="q" vid="PSA 106:24">mafiñeruntiña luagu lani Bungiu füramasei;<verse eid="PSA 106:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 106:25" />adimurehatiña wuriba luagu Aburemei tidan hakianpun,</para>
  <para style="q" vid="PSA 106:25">ani mídintiña lau lugumadin.<verse eid="PSA 106:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 106:26" />Ábati liñuruni lúhabu aba láfiñurun houn</para>
  <para style="q" vid="PSA 106:26">luagu ladügüba lan lun hóunwegun lidan fulasu mageirawati,<verse eid="PSA 106:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 106:27" />luagu ladügüba lan lun hóunwegun hadügawagun</para>
  <para style="q" vid="PSA 106:27">chagagua láñame haganagua néchanigu ha gibe tubungiutegu.<verse eid="PSA 106:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PSA 106:28" />Rúguatiña houngua lidamunme Baali-peoru,</para>
  <para style="q" vid="PSA 106:28">hou hagía lídangiñe adagarawagüdüti</para>
  <para style="q" vid="PSA 106:28">houn búngiugu ha mabagaritiña.<verse eid="PSA 106:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 106:29" />Gáñigüda hamuti Bungiu lau wuribati le hadügübei,</para>
  <para style="q" vid="PSA 106:29">aba lubéi ladagarun aban igei haganagua.<verse eid="PSA 106:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 106:30" />Gama lumoun aba lásaarun Finesi,</para>
  <para style="q" vid="PSA 106:30">aba láfaruni le gadurunbei, aba hagidarun igei.<verse eid="PSA 106:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 106:31" />Aba líchuguni Bungiu katei le ladügübei Finesi</para>
  <para style="q" vid="PSA 106:31">ligibugiñe lun súnwandan</para>
  <para style="q" vid="PSA 106:31">hámagiñe agübürigu hamoun isaanigu.<verse eid="PSA 106:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="PSA 106:32" />Gáñigüda hamuti giñe Bungiu laru duna Meribá,</para>
  <para style="q" vid="PSA 106:32">ábati lidin wuriba lun Moisesi ladüga sun lira,<verse eid="PSA 106:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 106:33" />gífigüda hamuti luguraasun,</para>
  <para style="q" vid="PSA 106:33">aba ladimurehan masaminarunga ka lan lariñagubei.<verse eid="PSA 106:33" /></para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" sid="PSA 106:34" />Magünrinchagun hamuti fulasu burí</para>
  <para style="q" vid="PSA 106:34">le uágubei lariñaga Aburemei houn lun hagünrinchaguni.<verse eid="PSA 106:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 106:35" />Lubaragiñe lira,</para>
  <para style="q" vid="PSA 106:35">ábarüga hádaragun houngua hadoun ha gíbebaña ubungiute</para>
  <para style="q" vid="PSA 106:35">aba hafurendeiruni hagaburi:<verse eid="PSA 106:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 106:36" />Aba háhuduragun houn haguariuan gibe tubungiutegu,</para>
  <para style="q" vid="PSA 106:36">ha lébunabaña hagadeirun,<verse eid="PSA 106:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 106:37" />barǘ humutiña harahüñü kei adagaragüdüni</para>
  <para style="q" vid="PSA 106:37">hagibugiñoun máfianu hagía.<verse eid="PSA 106:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 106:38" />Wiyugüdatiña hata maduruntiña,</para>
  <para style="q" vid="PSA 106:38">hata hasaanigu ha hanügübaña keisi adagaragüdüni</para>
  <para style="q" vid="PSA 106:38">houn lubungiutegu Kanán.</para>
  <para style="q" vid="PSA 106:38">Aba ladaseirun múa lau hata,<verse eid="PSA 106:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 106:39" />hagía aba hadaseirun wiye hagía</para>
  <para style="q" vid="PSA 106:39">lau sun wuribati le hadügübei.<verse eid="PSA 106:39" /></para>
  <para style="b" />
  <para style="q">
    <verse number="40" style="v" sid="PSA 106:40" />Aba lagañidun Aburemei hama lánigu,</para>
  <para style="q" vid="PSA 106:40">aba heyereegudún ha buga lánigubaña lun,<verse eid="PSA 106:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 106:41" />aba lígiruniña háhaburugu gibe tubungiutegu,</para>
  <para style="q" vid="PSA 106:41">aba herederun lábugiñe hagumadihan háganiñu;<verse eid="PSA 106:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 106:42" />aba haburechaguniña háganiñu,</para>
  <para style="q" vid="PSA 106:42">aba híchuguniña ǘnabu lábugiñe habafu.<verse eid="PSA 106:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 106:43" />Saraguñein wéiyaasu lesefuruniña Bungiu,</para>
  <para style="q" vid="PSA 106:43">gama lumoun ábayaha hiñuragun houngua lun</para>
  <para style="q" vid="PSA 106:43">aba habuluchun lidan hariban guánarügü.<verse eid="PSA 106:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 106:44" />Gama lumoun,</para>
  <para style="q" vid="PSA 106:44">lídanbei larihiniña lau idiheri,</para>
  <para style="q" vid="PSA 106:44">luma dan le laganbuni hayahun,<verse eid="PSA 106:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 106:45" />aba laritagun luagu lidaradun hama,</para>
  <para style="q" vid="PSA 106:45">aba lasansiruni laritagun,</para>
  <para style="q" vid="PSA 106:45">ladüga wéiriti línsiñehabu:<verse eid="PSA 106:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 106:46" />Adügati lun mariban lan hóuseruniña</para>
  <para style="q" vid="PSA 106:46">ha erederubaña kei haburiña!<verse eid="PSA 106:46" /></para>
  <para style="b" />
  <para style="q">
    <verse number="47" style="v" sid="PSA 106:47" />Sefubáwa, Aburemei, Wabungiute!</para>
  <para style="q" vid="PSA 106:47">Óundaraguagüdabawa haganaguagiñe néchanigu,</para>
  <para style="q" vid="PSA 106:47">eremuha wamaamuga lun biri le sándubei!</para>
  <para style="q" vid="PSA 106:47">Eremuha wamaamuga bun lau ugundani!<verse eid="PSA 106:47" /></para>
  <para style="b" />
  <para style="q">
    <verse number="48" style="v" sid="PSA 106:48" />Alawahoualá Aburemei,</para>
  <para style="q" vid="PSA 106:48">Lubungiute Ísüraeli, lun súnwandan!</para>
  <para style="q" vid="PSA 106:48">Ariñaga hamá súngubei: «Ítarala!»</para>
  <para style="b" vid="PSA 106:48" />
  <para style="q" vid="PSA 106:48">Alawaha waméi Aburemei!<verse eid="PSA 106:48" /></para>
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" sid="PSA 107" />
  <para style="ms">TISEINGÜN LÍBURU</para>
  <para style="mr">(Sálumu <ref loc="PSA 107-150">107—150</ref>)</para>
  <para style="s1">Magumuchadi lan línsiñehabu Aburemei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 107:1" />Ru humá seremei lun Aburemei ladüga buiti,</para>
  <para style="q" vid="PSA 107:1">ani magumuchaditi línsiñehabu.<verse eid="PSA 107:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 107:2" />Ariñaga haméi ha sefu láañabaña Aburemei,</para>
  <para style="q" vid="PSA 107:2">ha lasalbarubaña luéi lubafu ágani,<verse eid="PSA 107:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 107:3" />ha lóundarubaña lídangiñe burí ageiraü terencha,</para>
  <para style="q" vid="PSA 107:3">nóruterugugiñe, súrurugugiñe</para>
  <para style="q" vid="PSA 107:3">luéigiñe labouchagüle weyu luma lálüdagüle.<verse eid="PSA 107:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 107:4" />Féridiñuhaña meha</para>
  <para style="q" vid="PSA 107:4">lidan fulasu mageirawati le gasagounteti,</para>
  <para style="q" vid="PSA 107:4">madariga haméi üma</para>
  <para style="q" vid="PSA 107:4">lidoun aban uburugu lun haganóun ñein;<verse eid="PSA 107:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 107:5" />lamatiña mágürabu hagía,</para>
  <para style="q" vid="PSA 107:5">hóunwegua yebe<verse eid="PSA 107:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 107:6" />gama lumoun aba hayumuragun lun Aburemei,</para>
  <para style="q" vid="PSA 107:6">aba lesefuruniña lídangiñe idiheri.<verse eid="PSA 107:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 107:7" />Lárigiñe aba líchuguniña luagun üma suruti</para>
  <para style="q" vid="PSA 107:7">lidoun aban uburugu lun haganóun ñein.<verse eid="PSA 107:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 107:8" />Ru humá eteingiruni lun Aburemei luagu línsiñehabu,</para>
  <para style="q" vid="PSA 107:8">luagu le ladügübei luagu hafulesein gürigia!<verse eid="PSA 107:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 107:9" />Áfara lumuti hamagürabu mágürabutiña</para>
  <para style="q" vid="PSA 107:9">ru ligía saragu éigini houn ha lamabaña.<verse eid="PSA 107:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 107:10" />Lidan meha lueirin luburiga haganóua,</para>
  <para style="q" vid="PSA 107:10">dáüwañu lau íruni luma güringüri.<verse eid="PSA 107:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 107:11" />Ladüga hiñuragun houngua luagun lugumadin Aburemei,</para>
  <para style="q" vid="PSA 107:11">ladüga híchugun mebereseni lau laransehan Bungiu.<verse eid="PSA 107:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 107:12" />Aba líchuguniña Bungiu lábugiñe lidere wadagimanu;</para>
  <para style="q" vid="PSA 107:12">dan le hachugeragun, úati íderagutiña.<verse eid="PSA 107:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 107:13" />Gama lumoun aba hayumuragun lun Aburemei,</para>
  <para style="q" vid="PSA 107:13">aba lesefuruniña lídangiñe idiheri;<verse eid="PSA 107:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 107:14" />aba lasagaruniña lídangiñe lueirin luburiga,</para>
  <para style="q" vid="PSA 107:14">aba lesefuruniña luéi güringüri.<verse eid="PSA 107:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 107:15" />Ru humá eteingiruni lun Aburemei luagu línsiñehabu;</para>
  <para style="q" vid="PSA 107:15">luagu le ladügübei luagu hafulesein gürigia!<verse eid="PSA 107:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 107:16" />Bougua lumuti burí bena le lauti buronse!</para>
  <para style="q" vid="PSA 107:16">Günringua lumuti burí lidaünda bena lauti gürabu!<verse eid="PSA 107:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 107:17" />Sánditiña ani nidiheri hagía,</para>
  <para style="q" vid="PSA 107:17">ladüga hariban guánarügü luma hafigoun,<verse eid="PSA 107:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 107:18" />siñá heigin ni aban luwuyeri éigini;</para>
  <para style="q" vid="PSA 107:18">hilamémeeña yebe!<verse eid="PSA 107:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 107:19" />Gama lumoun aba hayumuragun lun Aburemei lau áhüchürüni,</para>
  <para style="q" vid="PSA 107:19">aba lesefuruniña lídangiñe hadiheri;<verse eid="PSA 107:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 107:20" />óunaha lumuti lererun, aba lareidaguagüdüniña.</para>
  <para style="q" vid="PSA 107:20">Sefu lumutiña luéi umúahaü!<verse eid="PSA 107:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 107:21" />Ru humá eteingiruni lun Aburemei luagu línsiñehabu,</para>
  <para style="q" vid="PSA 107:21">luagu le ladügübei luagu hafulesein gürigia!<verse eid="PSA 107:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 107:22" />Ru humá adagaragüdüni lánina eteingiruni lun,</para>
  <para style="q" vid="PSA 107:22">hadimureha lau ugundani luagu burí katei le ladügübei.<verse eid="PSA 107:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 107:23" />Fayatiña alugurahatiña baranahoun,</para>
  <para style="q" vid="PSA 107:23">ñǘdüntiña dúnarugun tidan burí hagune,<verse eid="PSA 107:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 107:24" />ñein lidan lilulin barana</para>
  <para style="q" vid="PSA 107:24">ariha hamuti katei buíduburiti le ladügübei Aburemei.<verse eid="PSA 107:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 107:25" />Lau lumalali Aburemei,</para>
  <para style="q" vid="PSA 107:25">aba liabin aban luriban dan,</para>
  <para style="q" vid="PSA 107:25">aba laweinamudun lugudi barana;<verse eid="PSA 107:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 107:26" />iñura lumutiña chülǘ sielun,</para>
  <para style="q" vid="PSA 107:26">rarigüda lumutiña chülǘ lábugiñoun barana;</para>
  <para style="q" vid="PSA 107:26">wéiriti hanufude luéi denchaü!<verse eid="PSA 107:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 107:27" />Atuituihatiña kei bacharuatiña;</para>
  <para style="q" vid="PSA 107:27">meseriwínti hasubudin houn!<verse eid="PSA 107:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 107:28" />Gama lumoun aba hayumuragun lun Aburemei,</para>
  <para style="q" vid="PSA 107:28">aba lasagaruniña lídangiñe idiheri;<verse eid="PSA 107:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 107:29" />aba lásügürün luriban dan,</para>
  <para style="q" vid="PSA 107:29">aba lagalumadun lugudi barana.<verse eid="PSA 107:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 107:30" />Dan harihinbei lagalumadun lugudi barana,</para>
  <para style="q" vid="PSA 107:30">aba hagundaarun aba lanügüniña Bungiu</para>
  <para style="q" vid="PSA 107:30">lidoun fulasu le buga ñéinhinbaña lubéi.<verse eid="PSA 107:30" /></para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" sid="PSA 107:31" />Ru humá eteingiruni lun Aburemei,</para>
  <para style="q" vid="PSA 107:31">luagu línsiñehabu,</para>
  <para style="q" vid="PSA 107:31">luagu le ladügübei luagu hafulesein gürigia!<verse eid="PSA 107:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 107:32" />Wa humá luagu dan le hóundaragun!</para>
  <para style="q" vid="PSA 107:32">Heremuha lun lidan hóundarun wéiyaaña mutu!<verse eid="PSA 107:32" /></para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" sid="PSA 107:33" />Adüga lumuti Aburemei duna</para>
  <para style="q" vid="PSA 107:33">luma lísensen duna fulasume mábeiti;<verse eid="PSA 107:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 107:34" />Adüga lumuti múa le gáluleti lun málule lan</para>
  <para style="q" vid="PSA 107:34">ladüga hariban lílana fulasu;<verse eid="PSA 107:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 107:35" />adüga lumuti fulasu mageirawati lagunume,</para>
  <para style="q" vid="PSA 107:35">adügaléi múa mábeiti dúname;<verse eid="PSA 107:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 107:36" />ru lumutiña ha lamabaña ñein,</para>
  <para style="q" vid="PSA 107:36">aba hábunaguni haburugute ñein.<verse eid="PSA 107:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 107:37" />Bunaguatiña hachari, bunagua beibei,</para>
  <para style="q" vid="PSA 107:37">alubaha hagía le gíbeti.<verse eid="PSA 107:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 107:38" />Biní lumutiña, gíbeguagüdalaña,</para>
  <para style="q" vid="PSA 107:38">wéinamugüdalaña halügüniña bágasu.<verse eid="PSA 107:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 107:39" />Gama lumoun ánhaña óunwegua,</para>
  <para style="q" vid="PSA 107:39">lau hamibedun ladüga asufuriruni,</para>
  <para style="q" vid="PSA 107:39">ladüga lamiselu luma igarigu,<verse eid="PSA 107:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 107:40" />aba heyereegudún ha asufuriragüdübaliña lun Bungiu,</para>
  <para style="q" vid="PSA 107:40">aba layuridaguagüdüniña lidan fulasu mageirawati.<verse eid="PSA 107:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 107:41" />Sagá lumutiña gudemetiña lídangiñe íruni;</para>
  <para style="q" vid="PSA 107:41">gíbegüda lumutiña tílana haban kei mudún!<verse eid="PSA 107:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 107:42" />Dan harihini gürigia richaguatiña lira,</para>
  <para style="q" vid="PSA 107:42">aba hagundaarun,</para>
  <para style="q" vid="PSA 107:42">ánhaña wuribatiña, aba hámanichun.<verse eid="PSA 107:42" /></para>
  <para style="b" />
  <para style="q">
    <verse number="43" style="v" sid="PSA 107:43" />Ha chúbaña aau, haritagua hamá luagu katei le,</para>
  <para style="q" vid="PSA 107:43">ani gunfuranda hameime línsiñehabu Aburemei.<verse eid="PSA 107:43" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" sid="PSA 108" />
  <para style="s1">Aranseñutiña nanigi</para>
  <para style="r">(<ref loc="PSA 57:7-11">Sal 57.7-11</ref>; <ref loc="PSA 60:5-12">60.5-12</ref>)</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 108:1" />Aranseñutiña nanigi, Nubungiute,</para>
  <para style="q" vid="PSA 108:1">aranseñu lun teremuhan uremu bun!</para>
  <para style="q" vid="PSA 108:1">Agaguduabá, nuani;<verse eid="PSA 108:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 108:2" />agaguduabá sun tuwuyeri árüpa,</para>
  <para style="q" vid="PSA 108:2">nagaguduba lubá larugan!<verse eid="PSA 108:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 108:3" />Nalawahabadibu lau uremu hadan néchanigu,</para>
  <para style="q" vid="PSA 108:3">Nabureme, nalawahabadibu haganagua amu gürigia.<verse eid="PSA 108:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 108:4" />Wéiriti bínsiñehabu sügǘ lau sielu.</para>
  <para style="q" vid="PSA 108:4">Chülüti bigunfulin dagá lumoun lidingun sielu!<verse eid="PSA 108:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 108:5" />Nubungiute, lóugiñeñadibu sielu;</para>
  <para style="q" vid="PSA 108:5">buin liña múa lau buéirigun!<verse eid="PSA 108:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 108:6" />Sefubáwa lau bubafu,</para>
  <para style="q" vid="PSA 108:6">sefu hamaamuga ha hínsiñebaña bun;</para>
  <para style="q" vid="PSA 108:6">óunababawa!<verse eid="PSA 108:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 108:7" />Adimurehati Bungiu tídangiñe luban sándutu ítara:</para>
  <para style="q" vid="PSA 108:7">«Nafanreinragubei uburugu Sikemü lau ugundani,</para>
  <para style="q" vid="PSA 108:7">fánreinguaneime fulasu wayati le lani Sukotu!<verse eid="PSA 108:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 108:8" />Nani Galaadü luma Manasési;</para>
  <para style="q" vid="PSA 108:8">Éfürain ligía bunidi héreti le adouragubei lau nichügü,</para>
  <para style="q" vid="PSA 108:8">Hudá ligía nubadunbei le aubei nagumadiha,<verse eid="PSA 108:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 108:9" />Moabü, ligía nágeidinabei lun nachibagun nungua;</para>
  <para style="q" vid="PSA 108:9">níchuguboun nigeidin luagun Edomu;</para>
  <para style="q" vid="PSA 108:9">nagúaruba agañeiruni hawagu Filistéana!»<verse eid="PSA 108:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 108:10" />Kaba san anügana lidoun uburugu baríeiruati?</para>
  <para style="q" vid="PSA 108:10">Kaba san alidihana chülǘ Edomu?<verse eid="PSA 108:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 108:11" />Ladüga Buguya, Bungiu, fui baadiwa;</para>
  <para style="q" vid="PSA 108:11">máfuridunhadibu wama ageindagua!<verse eid="PSA 108:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 108:12" />Íderaguabawa hawagu wáganiñu,</para>
  <para style="q" vid="PSA 108:12">ladüga ni kata hídehan gürigia.<verse eid="PSA 108:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 108:13" />Lau lídehan Bungiu,</para>
  <para style="q" vid="PSA 108:13">wadügüba katei wéinamuburiti;</para>
  <para style="q" vid="PSA 108:13">laburechagubaña wáganiñu!<verse eid="PSA 108:13" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" sid="PSA 109" />
  <para style="s1">Lafurieidun aban gürigia éibaahouti</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 109:1" />Bungiu,</para>
  <para style="q" vid="PSA 109:1">merederabá maniñu lun nafurieidun,<verse eid="PSA 109:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 109:2" />adimurehati iyumaü yeeti wuriba nuagu,</para>
  <para style="q" vid="PSA 109:2">ani iyeeni le lariñagubei.<verse eid="PSA 109:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 109:3" />Geyeguliña hererun lánina iyereehabúni nau;</para>
  <para style="q" vid="PSA 109:3">ábürühatiña nuagun mébunouga!<verse eid="PSA 109:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 109:4" />Leweñegua nínsiñehabu, ábürühatiña nuagun;</para>
  <para style="q" vid="PSA 109:4">gama lumoun aba nafurieidun.<verse eid="PSA 109:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 109:5" />Fáyeihaña wuribati nun luagu buiti,</para>
  <para style="q" vid="PSA 109:5">iyereehabúni híchugubei nun leweñegua nínsiñehabu.<verse eid="PSA 109:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 109:6" />Ruba aban wuribati lun laguseragüdüni nágani,</para>
  <para style="q" vid="PSA 109:6">ani lubuyein guánarügüla asiadirei;<verse eid="PSA 109:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 109:7" />rualá kei gadurunti lidan aguseruni;</para>
  <para style="q" vid="PSA 109:7">siadiléi le lúmagiñe guánarügübei.<verse eid="PSA 109:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 109:8" />Murusunrügülá dan labagaridun,</para>
  <para style="q" vid="PSA 109:8">rédeila amu lau lumegen!<verse eid="PSA 109:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 109:9" />Redei hamá lirahüñü magübürigunga,</para>
  <para style="q" vid="PSA 109:9">rédeime lúmari mámariga!<verse eid="PSA 109:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 109:10" />Redei hamá lirahüñü éibugañahadügü amuriaha ídemuei!</para>
  <para style="q" vid="PSA 109:10">Bugá hamaña lídangiñe tárigirugu haban!<verse eid="PSA 109:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 109:11" />Barülei le afuredeihabei lun sun le lánibei.</para>
  <para style="q" vid="PSA 109:11">Bayú haméi gürigia terencha le libihubei</para>
  <para style="q" vid="PSA 109:11">lídangiñe luadigimari luéi.<verse eid="PSA 109:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 109:12" />Ualá gudemehabuti lun,</para>
  <para style="q" vid="PSA 109:12">ni houn lirahüñü ha méteñuhaña.<verse eid="PSA 109:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 109:13" />Gumú hamá ladügawagun,</para>
  <para style="q" vid="PSA 109:13">gumugualá lúgubu liri lun súnwandan.<verse eid="PSA 109:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 109:14" />Haritagualá Aburemei luagu luriban lúguchi,</para>
  <para style="q" vid="PSA 109:14">maguludaléi tifigoun lúguchu lun súnwandan;<verse eid="PSA 109:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 109:15" />haritagualá Aburemei luagun súnwandan,</para>
  <para style="q" vid="PSA 109:15">gidalei laritawagún luagun fulasurugugiñe.<verse eid="PSA 109:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 109:16" />Maritagunti ni aban wéiyaasu lun gudemehabu lan,</para>
  <para style="q" vid="PSA 109:16">éibaaha lumutiña ha gudemebaña, ha ǘnabugubaña,</para>
  <para style="q" vid="PSA 109:16">hama ha nidiheribaña darí láfaraguniña hilagubei.<verse eid="PSA 109:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 109:17" />Kei himei lubalin íñarawaguni,</para>
  <para style="q" vid="PSA 109:17">íñarawaguala!</para>
  <para style="q" vid="PSA 109:17">Kei maha lubéi lun abiniruni,</para>
  <para style="q" vid="PSA 109:17">mabinirualá!<verse eid="PSA 109:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 109:18" />Darugualá íñarawaguni lau kei aban daüguaü;</para>
  <para style="q" vid="PSA 109:18">belula lurageirugun luma lidoun labu</para>
  <para style="q" vid="PSA 109:18">kamá hamuga duna odi garaba;<verse eid="PSA 109:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 109:19" />darugualá lau kei aban daüguaü,</para>
  <para style="q" vid="PSA 109:19">muruléime kei aban béliti!<verse eid="PSA 109:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 109:20" />Ítarala lafayeiruniña Nabureme náganiñu</para>
  <para style="q" vid="PSA 109:20">hama ha adimurehabaña wuriba nuagu!<verse eid="PSA 109:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 109:21" />Ánheinti buguya Aburemei,</para>
  <para style="q" vid="PSA 109:21">ruba inebesei lun biri, óuserabana buidu;</para>
  <para style="q" vid="PSA 109:21">sefubána luagu lareini bínsiñehabu!<verse eid="PSA 109:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 109:22" />Wéiriti nugudemen luma nidiheri,</para>
  <para style="q" vid="PSA 109:22">anihein biti tuagu nanigi;<verse eid="PSA 109:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 109:23" />agumuchagueinaniña kei lamuñounga;</para>
  <para style="q" vid="PSA 109:23">aduruuha lumutina garabali kei aban chigangaru!<verse eid="PSA 109:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 109:24" />Adadagarati nigachürügü ladüga meigin nan</para>
  <para style="q" vid="PSA 109:24">nadureiduña ladüga méigini;<verse eid="PSA 109:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 109:25" />au héheraagülebei gürigia!</para>
  <para style="q" vid="PSA 109:25">Dan harihinina aba hánhinhani hachügü adaagua bula nau!<verse eid="PSA 109:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PSA 109:26" />Íderaguabana, Nabureme, Nubungiute;</para>
  <para style="q" vid="PSA 109:26">sefubána luagu bínsiñehabu!<verse eid="PSA 109:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 109:27" />Subudi hamaamugei luagu</para>
  <para style="q" vid="PSA 109:27">badüga lan katei le lau búhabu.<verse eid="PSA 109:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 109:28" />Meberesegúntina ánhana híñaragua,</para>
  <para style="q" vid="PSA 109:28">binirügü báadina ligía.</para>
  <para style="q" vid="PSA 109:28">Ragǘ hamá busiganu aume agundaara;<verse eid="PSA 109:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 109:29" />buin hamá náganiñu lau busiganu!</para>
  <para style="q" vid="PSA 109:29">Darugualá busiganu hau kei aban idaüdinaü!<verse eid="PSA 109:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="PSA 109:30" />Níchuguba eteingiruni magumuchaditi</para>
  <para style="q" vid="PSA 109:30">lun Nabureme lau niyuma,</para>
  <para style="q" vid="PSA 109:30">neremuhaba lun hadan saragu gürigia!<verse eid="PSA 109:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 109:31" />Ladüga ligía ageindagubei háugiñe gudemetiña,</para>
  <para style="q" vid="PSA 109:31">sefuláña hawéi ha asiadirubaliña lun óunweni.<verse eid="PSA 109:31" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" sid="PSA 110" />
  <para style="s1">Ruti Aburemei ubafu lun Urúei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 110:1" />Lariñahare Bungiu lun Nabureme:</para>
  <para style="q" vid="PSA 110:1">«Ñuruba luéigiñe nóunwenren</para>
  <para style="q" vid="PSA 110:1">darí níchuguniña báganiñu lábugiñoun bugudi».<verse eid="PSA 110:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 110:2" />Lúmagiñe Sióngiñe derege lumuti Aburemei badun lánina agumadihani bun,</para>
  <para style="q" vid="PSA 110:2">le arufudubalin bubafu;</para>
  <para style="q" vid="PSA 110:2">gumadibaña lubeiti báganiñu!<verse eid="PSA 110:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 110:3" />Deregeguatiña bánigu houngua bun</para>
  <para style="q" vid="PSA 110:3">lidan luéyuri bagañeirun.</para>
  <para style="q" vid="PSA 110:3">Luagu burí wübü sánduti,</para>
  <para style="q" vid="PSA 110:3">ani ítara kei lábürühan serenu lubá larugan,</para>
  <para style="q" vid="PSA 110:3">ítara luba giñe nibureinguaya ban weyu luagun weyu.<verse eid="PSA 110:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 110:4" />Adügaali Aburemei aban áfiñuruni,</para>
  <para style="q" vid="PSA 110:4">ani madüraagun lubéi:</para>
  <para style="q" vid="PSA 110:4">«Fádiri buguya lun súnwandan,</para>
  <para style="q" vid="PSA 110:4">ítara kei Melükisedekü».<verse eid="PSA 110:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 110:5" />Anihein Aburemei luéigiñe bóunwenren;</para>
  <para style="q" vid="PSA 110:5">lagünrinchaguba urúeigu lidan luéyuri ligañi;<verse eid="PSA 110:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 110:6" />lasiadirubaña néchanigu,</para>
  <para style="q" vid="PSA 110:6">lóundaraguagüdüba saragu hágubu hilaaña,</para>
  <para style="q" vid="PSA 110:6">labouhaba ichügü lidan sun ubóu!<verse eid="PSA 110:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 110:7" />Látuba duna ǘmada lídangiñe aban liraüraü duna,</para>
  <para style="q" vid="PSA 110:7">ábame líchugun duna iseri erei lun.<verse eid="PSA 110:7" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" sid="PSA 111" />
  <para style="s1">Alawahani luagu le ladügübei Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 111:1" />Alawahoualá Aburemei!</para>
  <para style="b" vid="PSA 111:1" />
  <para style="q" vid="PSA 111:1">Neremuhaba lun Aburemei tau sun nanigi</para>
  <para style="q" vid="PSA 111:1">lidan hadamurin wügüriña harumatiña,</para>
  <para style="q" vid="PSA 111:1">hadan sun lílana fulasu.<verse eid="PSA 111:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 111:2" />Wéinamuburiti katei le ladügübei Aburemei,</para>
  <para style="q" vid="PSA 111:2">ani aturiaha hamuti ha hínsiñehabubaña lun katei burí ligía.<verse eid="PSA 111:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 111:3" />Katei le ladügübei buídumeraüti ani wéirigu ligía,</para>
  <para style="q" vid="PSA 111:3">ani rédeiti liricha lun súnwandan.<verse eid="PSA 111:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 111:4" />Adügaali lun mabulieidadiwa lan luadigimari.</para>
  <para style="b" vid="PSA 111:4" />
  <para style="q" vid="PSA 111:4">Areidati Aburemei, gudemehabu ligia;<verse eid="PSA 111:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 111:5" />ruti éigini houn ha inebehabubaña lun,</para>
  <para style="q" vid="PSA 111:5">haritaguati luagu lidaradun súnwandan!<verse eid="PSA 111:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 111:6" />Arufuda lumuti lubafu luadigimari houn lánigu</para>
  <para style="q" vid="PSA 111:6">lau líchuguni hafulasun gibe tubungiutegu houn.<verse eid="PSA 111:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 111:7" />Le ladügübei richati ani inarüniti;</para>
  <para style="q" vid="PSA 111:7">gayaraati lemenigidúniwa luagu lugumadin,<verse eid="PSA 111:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 111:8" />ladüga derebuguti lugumadin</para>
  <para style="q" vid="PSA 111:8">darí lumoun leben dan,</para>
  <para style="q" vid="PSA 111:8">ani lau inarüni luma úarani ladügǘwa.<verse eid="PSA 111:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 111:9" />Sefu lumutiña lánigu,</para>
  <para style="q" vid="PSA 111:9">derebugugüdalei lidaradun lun súnwandan.</para>
  <para style="q" vid="PSA 111:9">Sánduti Bungiu ani gabafu ligía.<verse eid="PSA 111:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 111:10" />Linebenwa Aburemei ligía lueirin-ágeibei lichú aau;</para>
  <para style="q" vid="PSA 111:10">chuti hau ha inebehabubaña lun.</para>
  <para style="q" vid="PSA 111:10">Lalawahóuba Bungiu súnwandan!<verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" sid="PSA 112" />
  <para style="s1">Hagundan gürigia ha úaraguabaña</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 112:1" />Alawahoualá Aburemei!</para>
  <para style="b" vid="PSA 112:1" />
  <para style="q" vid="PSA 112:1">Fuleseiwatiña gürigia ha inebehabubaña lun Aburemei</para>
  <para style="q" vid="PSA 112:1">gunda hagía lau hagunfuliruni lugumadin.<verse eid="PSA 112:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 112:2" />Habinirúba hadügawagun gürigia ha harumabaña,</para>
  <para style="q" vid="PSA 112:2">ani gabafubaña giñe ubouagu.<verse eid="PSA 112:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 112:3" />Anihein saragu irisini lúbiñe,</para>
  <para style="q" vid="PSA 112:3">ani magumuchaditi lareini.<verse eid="PSA 112:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 112:4" />Durunguati lanpu lidan luburiga,</para>
  <para style="q" vid="PSA 112:4">houn gürigia harumatiña,</para>
  <para style="q" vid="PSA 112:4">gudemehabutiña, areida ani richá hagía;<verse eid="PSA 112:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 112:5" />gürigia ha buídubaña,</para>
  <para style="q" vid="PSA 112:5">rútiña furedeiti lau areini,</para>
  <para style="q" vid="PSA 112:5">adüga hamuti hamarasun lau arumani;<verse eid="PSA 112:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 112:6" />ligía méiguadadi habéi.</para>
  <para style="q" vid="PSA 112:6">Laritawaguba hawagun gürigia úaraguatiña súnwandan!<verse eid="PSA 112:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 112:7" />Manufudetiña luéi uganu le wuribati,</para>
  <para style="q" vid="PSA 112:7">deregüdagutiña hanigi afiñeñu luagu Aburemei.<verse eid="PSA 112:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 112:8" />Deregüdagutiña hanigi, manufudetiña,</para>
  <para style="q" vid="PSA 112:8">ariharügütiña hawagun háganiñu lau bula.<verse eid="PSA 112:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 112:9" />Edewehatiña houn gudemetiña,</para>
  <para style="q" vid="PSA 112:9">areidatiña súnwandan,</para>
  <para style="q" vid="PSA 112:9">iñura hamuti hagibu lau uéiriguni.<verse eid="PSA 112:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 112:10" />Gáñitiña ha salufuribaña dan le harihini;</para>
  <para style="q" vid="PSA 112:10">akünrinhati hari le hásiñaragun houngua.</para>
  <para style="q" vid="PSA 112:10">Rédeiti hayumahan wuribatiña lidan ni kata.<verse eid="PSA 112:10" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" sid="PSA 113" />
  <para style="s1">Uremu lun lareini Aburemei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 113:1" />Alawaha huméi Bungiu!</para>
  <para style="q" vid="PSA 113:1">Eseriwidutiña lun Aburemei, alawaha huméi Aburemei!<verse eid="PSA 113:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 113:2" />Alawahoualá liri Aburemei</para>
  <para style="q" vid="PSA 113:2">guentó luma súnwandan!<verse eid="PSA 113:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 113:3" />Alawahoualá liri Aburemei</para>
  <para style="q" vid="PSA 113:3">lúmagiñe láfuachagüle weyu darí lumoun lálüdagüle.<verse eid="PSA 113:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 113:4" />Hóugiñeñein sun néchanigu Aburemei;</para>
  <para style="q" vid="PSA 113:4">lóugiñeñein sielu luéirigun!<verse eid="PSA 113:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 113:5" />Úati kei Aburemei le Wabungiute,</para>
  <para style="q" vid="PSA 113:5">le arúeihabei yágüta iñu;<verse eid="PSA 113:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 113:6" />ani lau sun lira lemuti</para>
  <para style="q" vid="PSA 113:6">lun larihini sielu luma múa.<verse eid="PSA 113:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 113:7" />Iñuragua lumutiña Aburemei gudemetiña múarugugiñe,</para>
  <para style="q" vid="PSA 113:7">sagaláña ha mégeihabubaña lídangiñe fulasu le ǘnabutimabei;<verse eid="PSA 113:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 113:8" />lun lañuuragüdüniña hadan gürigia wéirigutiña,</para>
  <para style="q" vid="PSA 113:8">hadan harahüñü urúei ha lídanbaña lageira.<verse eid="PSA 113:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 113:9" />Tun würi to buga maraütu</para>
  <para style="q" vid="PSA 113:9">ruti ugundani lau tagaraüdün,</para>
  <para style="q" vid="PSA 113:9">lun giñe tagabandun tungua.</para>
  <para style="b" vid="PSA 113:9" />
  <para style="q" vid="PSA 113:9">Alawaha huméi Bungiu!<verse eid="PSA 113:9" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" sid="PSA 114" />
  <para style="s1">Laritawagúniwa áfuriduni Ehiptugiñe</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 114:1" />Dan le háfuridunbei Ísüraelina,</para>
  <para style="q" vid="PSA 114:1">ha lumutuniña Hakobu Ehiptugiñe,</para>
  <para style="q" vid="PSA 114:1">lídangiñe ageiraü terenchati,<verse eid="PSA 114:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 114:2" />chülüti Hudá lun lánime Aburemei sanduariu;</para>
  <para style="q" vid="PSA 114:2">ánheinti Ísüraeli lun ábanbei lan arúeihani lun.<verse eid="PSA 114:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 114:3" />Dan le larihinbalin barana Ísüraeli aba lanurahan,</para>
  <para style="q" vid="PSA 114:3">aba lagiribudun duna Hordán lárigoun.<verse eid="PSA 114:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 114:4" />Achubahati burí dabíara kei mudún</para>
  <para style="q" vid="PSA 114:4">achubaha ligía wübü kei liraüraü mudún!<verse eid="PSA 114:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 114:5" />Kagia suserebei bun, barana, banurahanbei?</para>
  <para style="q" vid="PSA 114:5">Kagia suserebei bun Hordán, bídinbei bárigoun?<verse eid="PSA 114:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 114:6" />Kagia suserebei hun dabíara hachubahanbei kei mudún?</para>
  <para style="q" vid="PSA 114:6">Kagia suserebei hun wübü hachubahanbei kei harahüñü mudún?<verse eid="PSA 114:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 114:7" />Badadagara, múa,</para>
  <para style="q" vid="PSA 114:7">ligibugiñe Aburemei, le Lubungiute Hakobu!<verse eid="PSA 114:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 114:8" />Adüga lumuti burí dübü wéinamuti dúname!</para>
  <para style="q" vid="PSA 114:8">Saliguagüda lumuti lirahüñü dübü lísensenme duna!<verse eid="PSA 114:8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" sid="PSA 115" />
  <para style="s1">Anihein Wabungiute sielu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 115:1" />Aburemei,</para>
  <para style="q" vid="PSA 115:1">ruba uéiriguni búniwagua, mama woun;</para>
  <para style="q" vid="PSA 115:1">ruba uéiriguni búniwagua</para>
  <para style="q" vid="PSA 115:1">luagu bínsiñehabu luma binarün!<verse eid="PSA 115:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 115:2" />Ka san uagu hálügüdaha gibe tubungiutegu</para>
  <para style="q" vid="PSA 115:2">hagéi lan Wabungiute?<verse eid="PSA 115:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 115:3" />Anihein Wabungiute sielu;</para>
  <para style="q" vid="PSA 115:3">adüga laali sun le labusenrubei.<verse eid="PSA 115:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 115:4" />Golu luma pülata haguariuanbei gibe tubungiutegu,</para>
  <para style="q" vid="PSA 115:4">katei burí hadügün wügüriña lau háhabu:<verse eid="PSA 115:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 115:5" />Gayumatiña, gama lumoun siñati hadimurehan;</para>
  <para style="q" vid="PSA 115:5">gágutiña, gama lumoun siñati harihin;<verse eid="PSA 115:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 115:6" />garigeitiña, gama lumoun siñati haganbun;</para>
  <para style="q" vid="PSA 115:6">gágirugutiña, gama lumoun siñati hímichun;<verse eid="PSA 115:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 115:7" />gáhabutiña, gama lumoun siñati haguurun;</para>
  <para style="q" vid="PSA 115:7">gaguditiña, gama lumoun siñati héibugun;</para>
  <para style="q" vid="PSA 115:7">máfuridunti ni murusun umalali hagülerugugiñe,<verse eid="PSA 115:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 115:8" />kei guáriua hagía,</para>
  <para style="q" vid="PSA 115:8">ítarameme haña giñe ha adügübaliña</para>
  <para style="q" vid="PSA 115:8">hama ha afiñebaña hawagu.<verse eid="PSA 115:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 115:9" />Ísüraelina, afiñe humá luagu Aburemei!</para>
  <para style="q" vid="PSA 115:9">Íderagua lumutiwa, góunigi lawa.<verse eid="PSA 115:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 115:10" />Fádirigu, afiñe humá luagu Aburemei!</para>
  <para style="q" vid="PSA 115:10">Íderagua lumutiwa, góunigi lawa.<verse eid="PSA 115:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 115:11" />Huguya le inebehabubei lun Aburemei,</para>
  <para style="q" vid="PSA 115:11">afiñe humá luagu!</para>
  <para style="q" vid="PSA 115:11">Íderagua lumutiwa, góunigilawa.<verse eid="PSA 115:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 115:12" />Haritaguaali Aburemei wawagun, labinirubadiwa!</para>
  <para style="q" vid="PSA 115:12">Labinirubaña Ísüraelina,</para>
  <para style="q" vid="PSA 115:12">labinirubaña fádirigu,<verse eid="PSA 115:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 115:13" />labinirubaña ha inebehabubalin,</para>
  <para style="q" vid="PSA 115:13">wéinamuhaña hama ñǘbürigiña.<verse eid="PSA 115:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 115:14" />Gánwoungüdalaña Aburemei hadügawagun</para>
  <para style="q" vid="PSA 115:14">hama hadügawagun hirahüñü!<verse eid="PSA 115:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 115:15" />Rulei Aburemei</para>
  <para style="q" vid="PSA 115:15">le adügübalin sielu luma múa labiniragüle huagun!<verse eid="PSA 115:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 115:16" />Lani Aburemei sielu,</para>
  <para style="q" vid="PSA 115:16">ánheinti houn gürigia ru lumuti múa.<verse eid="PSA 115:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 115:17" />Ha hilaguaañabaña,</para>
  <para style="q" vid="PSA 115:17">siñaali heremuhan lun Aburemei;<verse eid="PSA 115:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 115:18" />ánheinti wagía,</para>
  <para style="q" vid="PSA 115:18">weremuhaba lun guentó luma súnwandan.</para>
  <para style="b" vid="PSA 115:18" />
  <para style="q" vid="PSA 115:18">Alawahoualá Bungiu!<verse eid="PSA 115:18" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" sid="PSA 116" />
  <para style="s1">Afurieiduni lánina eteingiruni</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 116:1" />Hínsiñeti Nabureme nun,</para>
  <para style="q" vid="PSA 116:1">ladüga aganba laali lan nayumuragun;<verse eid="PSA 116:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 116:2" />ladüga ténihali lan nun.</para>
  <para style="q" vid="PSA 116:2">Nagúahabei súnwandan!<verse eid="PSA 116:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 116:3" />Dahigua lumutina óunweni lidan lugurudun,</para>
  <para style="q" vid="PSA 116:3">ragǘ lumutina ligarigu umúahaü,</para>
  <para style="q" vid="PSA 116:3">sandiguatina nungua dáüwañu ladüga anufudei labu igarigu.<verse eid="PSA 116:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 116:4" />Ábati nagúaruni liri Nabureme,</para>
  <para style="q" vid="PSA 116:4">aba nayumuragun lun, lun lesefuruni nibagari.<verse eid="PSA 116:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 116:5" />Richati Nabureme, gudemehabu ligia;</para>
  <para style="q" vid="PSA 116:5">areidati Wabungiute.<verse eid="PSA 116:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 116:6" />Góunigi lumutiña Aburemei ha mégeihabubaña.</para>
  <para style="q" vid="PSA 116:6">Dan meha le mere nubéi, sefu lumutina.<verse eid="PSA 116:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 116:7" />Anati guentó, gayaraayaali nasandiragun nungua darangilu,</para>
  <para style="q" vid="PSA 116:7">ladüga buiti Nabureme numa;<verse eid="PSA 116:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 116:8" />ladüga sefu láadina lídangiñe óunweni,</para>
  <para style="q" vid="PSA 116:8">ladüga sefu láadina luéi ayahuni luma luéi éiguaduni.<verse eid="PSA 116:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 116:9" />Gaganbadibadina lun Nabureme ya ubouagu.<verse eid="PSA 116:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 116:10" />Afiñetina meha,</para>
  <para style="q" vid="PSA 116:10">lau súnñaha ariñaga nan luagu weiri lan nidiheri.<verse eid="PSA 116:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 116:11" />Buin lau anufudei aba nariñagun:</para>
  <para style="q" vid="PSA 116:11">«Marasualugutiña sun wügüriña»</para>
  <para style="q" vid="PSA 116:11">gama lumoun ni ítara meferidirun numuti nafiñen.<verse eid="PSA 116:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 116:12" />Ida lubá san nafayeiruni Nabureme</para>
  <para style="q" vid="PSA 116:12">luagu sun buiti le adüga láalibei nun?<verse eid="PSA 116:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 116:13" />Niñurubei likopuna esefuruni</para>
  <para style="q" vid="PSA 116:13">ábame nagúaruni liri!<verse eid="PSA 116:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 116:14" />Nagunfulirubei nani füramasei lun Nabureme</para>
  <para style="q" vid="PSA 116:14">hañúarü sun lumutuniña!<verse eid="PSA 116:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 116:15" />Dereti lun Aburemei,</para>
  <para style="q" vid="PSA 116:15">larihini hóunwegun ha hínsiñehabubaña lun.<verse eid="PSA 116:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 116:16" />Nabureme, bubuein nuguya!</para>
  <para style="q" vid="PSA 116:16">Tiráü bubuein nuguya!</para>
  <para style="q" vid="PSA 116:16">Hüchügua baali gúrudu le meha agüragubalina.<verse eid="PSA 116:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 116:17" />Le neteingirunibu nadagaragüdüba bun,</para>
  <para style="q" vid="PSA 116:17">ábame nagúahani biri, Nabureme.<verse eid="PSA 116:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 116:18" />Nagunfulirubei nani füramasei lun Nabureme</para>
  <para style="q" vid="PSA 116:18">hañúarü sun lumutuniña!<verse eid="PSA 116:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 116:19" />Lidan tibürürün buban Aburemei, to Herusalénboun!</para>
  <para style="b" vid="PSA 116:19" />
  <para style="q" vid="PSA 116:19">Alawaha huméi Bungiu!<verse eid="PSA 116:19" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" sid="PSA 117" />
  <para style="s1">Alawahani lun Aburemei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 117:1" />Sun néchanigu, sun fulasu,</para>
  <para style="q" vid="PSA 117:1">alawaha huméi Aburemei!<verse eid="PSA 117:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 117:2" />Ladüga le, wéiriti wínsiñe lun;</para>
  <para style="q" vid="PSA 117:2">magumuchaditi ligunfulin Aburemei!</para>
  <para style="b" vid="PSA 117:2" />
  <para style="q" vid="PSA 117:2">Alawaha huméi Bungiu!<verse eid="PSA 117:2" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" sid="PSA 118" />
  <para style="s1">Wéiriti lubafu Aburemei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 118:1" />Ru humá eteingiruni lun Aburemei luagu lareini</para>
  <para style="q" vid="PSA 118:1">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 118:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 118:2" />Ariñaga hamá Ísüraelina:</para>
  <para style="q" vid="PSA 118:2">«Magumuchaditi línsiñehabu Aburemei»<verse eid="PSA 118:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 118:3" />Ariñaga hamá fádirigu:</para>
  <para style="q" vid="PSA 118:3">«Magumuchaditi lugudemenihabu Aburemei».<verse eid="PSA 118:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 118:4" />Ariñaga hamá ha inebehabubaña lun Aburemei:</para>
  <para style="q" vid="PSA 118:4">«Magumuchaditi lugudemenihabu Aburemei».<verse eid="PSA 118:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 118:5" />Wátina lun Aburemei lidan nidiheri,</para>
  <para style="q" vid="PSA 118:5">aganba lumutina aba lesefurunina.<verse eid="PSA 118:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 118:6" />Anihein Nabureme numa, manufudetina.</para>
  <para style="q" vid="PSA 118:6">Kaba gayara lan gürigia adüga nau?<verse eid="PSA 118:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 118:7" />Anihein Nabureme numa, íderagua lumutina.</para>
  <para style="q" vid="PSA 118:7">Narihibei hagañeirúniwa ha iyereehabúbaña nun!<verse eid="PSA 118:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 118:8" />Buítimati lemenigidun luagu Aburemei</para>
  <para style="q" vid="PSA 118:8">sügǘ lau lemenigidúniwa luagu gürigia.<verse eid="PSA 118:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 118:9" />Buítimati lemenigidúniwa luagu Aburemei</para>
  <para style="q" vid="PSA 118:9">sügǘ lau lemenigidúniwa hawagu gürigia wéirigutiña.<verse eid="PSA 118:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 118:10" />Geyegua hamutina yebe sun néchanigu,</para>
  <para style="q" vid="PSA 118:10">gama lumoun gañei numutiña lidan liri Aburemei.<verse eid="PSA 118:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 118:11" />Geyegua hamutina luéigiñe sun oubaü,</para>
  <para style="q" vid="PSA 118:11">gama lumoun gañei numutiña lidan liri Nabureme.<verse eid="PSA 118:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 118:12" />Geyegua hamutina kei hulahüñü,</para>
  <para style="q" vid="PSA 118:12">gama lumoun aba léñeguchun lanarime hagañi</para>
  <para style="q" vid="PSA 118:12">kei ligemeri hiiyu;</para>
  <para style="q" vid="PSA 118:12">gañei numutiña lidan liri Aburemei!<verse eid="PSA 118:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 118:13" />Da hamutina here lun yebe néiguadun,</para>
  <para style="q" vid="PSA 118:13">gama lumoun ñǘbuinti Nabureme íderaguana.<verse eid="PSA 118:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 118:14" />Eremuhatina lun Nabureme le íchugubei erei nun;</para>
  <para style="q" vid="PSA 118:14">ligía nesefuragülebei!<verse eid="PSA 118:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 118:15" />Tidan haban wügüriña gúnfulitiña,</para>
  <para style="q" vid="PSA 118:15">anihein burí uremu gúndaati le lánina agañeiruni:</para>
  <para style="q" vid="PSA 118:15">«Darí lumuti lubafu Aburemei agañeiruni!<verse eid="PSA 118:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 118:16" />Hanarimeguti lubafu Aburemei!</para>
  <para style="q" vid="PSA 118:16">Darí lumuti lubafu Aburemei agañeiruni!»<verse eid="PSA 118:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 118:17" />Móunwenbadina, nabagariduba</para>
  <para style="q" vid="PSA 118:17">lun nabahüdaguni le ladügübei Nabureme!<verse eid="PSA 118:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 118:18" />Bei láadina Aburemei here,</para>
  <para style="q" vid="PSA 118:18">gama lumoun mígirun lumutina lun nounwen.<verse eid="PSA 118:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 118:19" />Daragua huméi tubenari luban Bungiu,</para>
  <para style="q" vid="PSA 118:19">busentina nebelurun íchiga seremei lun!<verse eid="PSA 118:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 118:20" />Anihán lubenaribei Aburemei,</para>
  <para style="q" vid="PSA 118:20">ani ñéingiñeba hebelura ha gúnfulibaña luma.<verse eid="PSA 118:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 118:21" />Seremei numutibu, Nabureme, luagu bóunabunina,</para>
  <para style="q" vid="PSA 118:21">ladüga buguya lan nesefuragülebei.<verse eid="PSA 118:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 118:22" />Dübü le meha aubei meberesen hamá ábunagutiña,</para>
  <para style="q" vid="PSA 118:22">ligíaali dübü le tímatimaati.<verse eid="PSA 118:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 118:23" />Aburemei adügübalin le,</para>
  <para style="q" vid="PSA 118:23">wéiritu wanigi lau katei le.<verse eid="PSA 118:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 118:24" />Anihán weyu le ídanbei luadigimarida Aburemei:</para>
  <para style="q" vid="PSA 118:24">Gunda wamá uguñe!<verse eid="PSA 118:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PSA 118:25" />Adügabá fulesei woun Aburemei, sefubáwa!</para>
  <para style="q" vid="PSA 118:25">Fuleseibawa Aburemei,</para>
  <para style="q" vid="PSA 118:25">adügabá lun buidu lan lidin woun!<verse eid="PSA 118:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PSA 118:26" />Biniwati le ñǘbuinbei lidan liri Aburemei!</para>
  <para style="q" vid="PSA 118:26">Biní wamutün tídangiñe luban Aburemei.<verse eid="PSA 118:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 118:27" />Bungiu Aburemeibei; harugoungadagüdati wau!</para>
  <para style="q" vid="PSA 118:27">Gumese huméi fedu,</para>
  <para style="q" vid="PSA 118:27">barǘ humá burí limu luagun larigei latarü.<verse eid="PSA 118:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PSA 118:28" />Seremei numutibu alawahanei buéirigun</para>
  <para style="q" vid="PSA 118:28">ladüga Nubungiute lan buguya.<verse eid="PSA 118:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 118:29" />Ru humá seremei lun Aburemei ladüga buiti;</para>
  <para style="q" vid="PSA 118:29">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" sid="PSA 119" />
  <para style="s1">Alawahani lun lilurudun Bungiu</para>
  <para style="qa">Álef</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 119:1" />Fuleseiwatiña ha harumabei hóuseragun houngua,</para>
  <para style="q" vid="PSA 119:1">falá haméi larufudahan Aburemei.<verse eid="PSA 119:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 119:2" />Fuleseiwatiña ha etenirubaña lun lugumadin</para>
  <para style="q" vid="PSA 119:2">áluaha haméi tau sun hanigi;<verse eid="PSA 119:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 119:3" />ha madügünbaña ni kata wuribati,</para>
  <para style="q" vid="PSA 119:3">ha afalarubalin lémeri Aburemei.<verse eid="PSA 119:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 119:4" />Ariñagaadibu lun lagunfulirúniwa</para>
  <para style="q" vid="PSA 119:4">bugumadin lidan lubudubu.<verse eid="PSA 119:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 119:5" />Nederaguagüda hamuga lidan lagunfulirúniwa bilurudun!<verse eid="PSA 119:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 119:6" />Manügünbadina busiganu danme netenirun lun bugumadin.<verse eid="PSA 119:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 119:7" />Nalawahabadibu tau taruman anigi</para>
  <para style="q" vid="PSA 119:7">danme furendei naali bererun le richabei.<verse eid="PSA 119:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 119:8" />Busentina nagunfuliruni bilurudun!</para>
  <para style="q" vid="PSA 119:8">Mágurabana!<verse eid="PSA 119:8" /></para>
  <para style="qa">Bet</para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 119:9" />Ida lubagia gayara lan labagaridun nibureinti</para>
  <para style="q" vid="PSA 119:9">aban ibagari harumati?</para>
  <para style="q" vid="PSA 119:9">Lau lagunfulirun lau bererun!<verse eid="PSA 119:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 119:10" />Áluaha numutibu tau sun nanigi,</para>
  <para style="q" vid="PSA 119:10">mígiraba lun nadireirun luéi bugumadin.<verse eid="PSA 119:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 119:11" />Areida naali bererun tidan nanigi</para>
  <para style="q" vid="PSA 119:11">lun mafigounhan nan bigibugiñe.<verse eid="PSA 119:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 119:12" />Alawahóuatibu Aburemei!</para>
  <para style="q" vid="PSA 119:12">Arufudahabei bilurudun nun!<verse eid="PSA 119:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 119:13" />Abahüdagua numuti sun lúrudu le bíchugubei</para>
  <para style="q" vid="PSA 119:13">lau umalali héreti.<verse eid="PSA 119:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 119:14" />Nagundaaruba lidan lémeri bugumadin,</para>
  <para style="q" vid="PSA 119:14">sügǘ lau lidan sun irisini.<verse eid="PSA 119:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 119:15" />Nasaminaruba luagu bugumadin,</para>
  <para style="q" vid="PSA 119:15">teni aume lun bémeri.<verse eid="PSA 119:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 119:16" />Nagundaaruba lau bilurudun,</para>
  <para style="q" vid="PSA 119:16">mabulieidagunbadina luéi bererun.<verse eid="PSA 119:16" /></para>
  <para style="qa">Guímel</para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 119:17" />Ruba ibagari lun bubuein le!</para>
  <para style="q" vid="PSA 119:17">Ábame nidin lau le bubeibei!<verse eid="PSA 119:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 119:18" />Darabei nagu,</para>
  <para style="q" vid="PSA 119:18">ariha náamugei lubuidun barufudahan.<verse eid="PSA 119:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 119:19" />Terencha au lidan múa le,</para>
  <para style="q" vid="PSA 119:19">maramudabei bugumadin nuéi.<verse eid="PSA 119:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 119:20" />Súnwandan nasandirun idiheri tidan nanigi</para>
  <para style="q" vid="PSA 119:20">le nabusenrun nasubudiruni bererun.<verse eid="PSA 119:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 119:21" />Adeinhatibu houn wuribatiña hama mabuchahatiña</para>
  <para style="q" vid="PSA 119:21">ha ígirubalin bugumadin.<verse eid="PSA 119:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 119:22" />Dísegüdabana luéi burí anabawaguni</para>
  <para style="q" vid="PSA 119:22">luma mebereseni le hadügübei,</para>
  <para style="q" vid="PSA 119:22">ladüga ténihadina lun bugumadin.<verse eid="PSA 119:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 119:23" />Íbini habusenrun gürigia gabafutiña hadügün wuribani nun,</para>
  <para style="q" vid="PSA 119:23">nasaminaruba luagun bilurudun.<verse eid="PSA 119:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 119:24" />Gúndaatina lau bugumadin</para>
  <para style="q" vid="PSA 119:24">ligía eweridihabalina.<verse eid="PSA 119:24" /></para>
  <para style="qa">Dálet</para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 119:25" />Yarafaadina lun nounwen;</para>
  <para style="q" vid="PSA 119:25">ruba ibagari nun kei füramase bani!<verse eid="PSA 119:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 119:26" />Ariñaga naali nigaburi bun,</para>
  <para style="q" vid="PSA 119:26">ani óunaba báadina.</para>
  <para style="q" vid="PSA 119:26">Arufudahabei bilurudun nun!<verse eid="PSA 119:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 119:27" />Ruba gunfurandaü nun lun nafalaruni bugumadin,</para>
  <para style="q" vid="PSA 119:27">ladüga busentina nasaminarun luagu lubuidun barufudahan.<verse eid="PSA 119:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 119:28" />Ñaraguniña lidan láguirana igarigu;</para>
  <para style="q" vid="PSA 119:28">íderaguabana deregüdagu náamuga,</para>
  <para style="q" vid="PSA 119:28">kei füramase bani!<verse eid="PSA 119:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 119:29" />Dísegüdabana luéi lémeri iyeeni,</para>
  <para style="q" vid="PSA 119:29">fuleseibana lau barufudahan.<verse eid="PSA 119:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 119:30" />Anúadira naali lémeri ibagari</para>
  <para style="q" vid="PSA 119:30">ani busén numuti bererun.<verse eid="PSA 119:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 119:31" />Nabureme, badüleedina luagu bugumadin;</para>
  <para style="q" vid="PSA 119:31">mabuinchagüdabana lau busiganu!<verse eid="PSA 119:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 119:32" />Deregeguatina nungua le gumuti lun bugumadin,</para>
  <para style="q" vid="PSA 119:32">ladüga rútibu gunfurandaü nun.<verse eid="PSA 119:32" /></para>
  <para style="qa">He</para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 119:33" />Nabureme, arufudabéi lémeri bilurudun nun,</para>
  <para style="q" vid="PSA 119:33">busentina nafalaruni darí lumoun lagumuhóun dan.<verse eid="PSA 119:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 119:34" />Ruba gunfurandaü nun lun nadügüni le barufudahabei;</para>
  <para style="q" vid="PSA 119:34">busentina nafalaruni tau sun nanigi!<verse eid="PSA 119:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 119:35" />Barübana lidan lémeri bugumadin,</para>
  <para style="q" vid="PSA 119:35">ladüga lídanñein nugundan.<verse eid="PSA 119:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 119:36" />Adügabá lun himei tani nanigi bugumadin,</para>
  <para style="q" vid="PSA 119:36">luéi agañeiruni le wíyeti.<verse eid="PSA 119:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 119:37" />Mígiraba lun narihin hawagun búngiugu ha ni kátabaña,</para>
  <para style="q" vid="PSA 119:37">ruba ibagari nun lun nafalaruni bémeri!<verse eid="PSA 119:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 119:38" />Gúnfulibei füramasei le badügübei nun</para>
  <para style="q" vid="PSA 119:38">füramasei le bíchugubei houn ha inebehabubaña bun.<verse eid="PSA 119:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 119:39" />Dísegüdabei anabawaguni le ueibei nanufudeda nuéi,</para>
  <para style="q" vid="PSA 119:39">ladüga buiti burí bererun.<verse eid="PSA 119:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 119:40" />Ayumaha naali bugumadin;</para>
  <para style="q" vid="PSA 119:40">ruba ibagari nun, ladüga richatibu!<verse eid="PSA 119:40" /></para>
  <para style="qa">Vav</para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 119:41" />Nabureme, arufudabéi bínsiñehabu luma besefuhan nun,</para>
  <para style="q" vid="PSA 119:41">ítara kei füramase bani.<verse eid="PSA 119:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 119:42" />Ítara luba gayara lan nóunabuniña ha anabagutina,</para>
  <para style="q" vid="PSA 119:42">ladüga hemenigitina luagu bererun.<verse eid="PSA 119:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 119:43" />Magidarabéi dimurei lánina inarüni niyumulugugiñe,</para>
  <para style="q" vid="PSA 119:43">ladüga ru naali nemenigin luagu bererun.<verse eid="PSA 119:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 119:44" />Busentina nadügüni le barufudahabei súnwandan!<verse eid="PSA 119:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 119:45" />Ítara luba gayara lan nabagaridun séfuñu,</para>
  <para style="q" vid="PSA 119:45">ladüga falá naali bugumadin.<verse eid="PSA 119:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 119:46" />Nadimurehaba luagu bugumadin hagibugiñe urúeigu,</para>
  <para style="q" vid="PSA 119:46">ani úabei nibusigari nan.<verse eid="PSA 119:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 119:47" />Ladüga hínsiñeti bugumadin nun</para>
  <para style="q" vid="PSA 119:47">ani gúndaatina lau.<verse eid="PSA 119:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 119:48" />Hínsiñeti bugumadin nun ani ayumaha numuti,</para>
  <para style="q" vid="PSA 119:48">saminatina saragu luagu bilurudun.<verse eid="PSA 119:48" /></para>
  <para style="qa">Zayin</para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 119:49" />Haritaguabei dimurei le meha bariñagubei nun,</para>
  <para style="q" vid="PSA 119:49">le uágubei bíchigagüdei nemenigin nun.<verse eid="PSA 119:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 119:50" />Anihán nuguraasunbei lidan íruni:</para>
  <para style="q" vid="PSA 119:50">Luagu rútibu lan ibagari nun lau bani füramasei.<verse eid="PSA 119:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 119:51" />Meredeti hanabagunina wuribatiña,</para>
  <para style="q" vid="PSA 119:51">gama lumoun madiñutina luéi barufudahan.<verse eid="PSA 119:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 119:52" />Haritagua numuti binadu bererun,</para>
  <para style="q" vid="PSA 119:52">aba nadarirun dǘgüdaguaü lidan.<verse eid="PSA 119:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 119:53" />Ha wuribatiña ha ígirubalin barufudahan,</para>
  <para style="q" vid="PSA 119:53">gáñigüda hamutina.<verse eid="PSA 119:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 119:54" />Bilurudun neremunbei ya lidan fulasu le,</para>
  <para style="q" vid="PSA 119:54">le ñein lubéi terencha nan.<verse eid="PSA 119:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 119:55" />Nabureme, áriebu, haritaguatina buagun;</para>
  <para style="q" vid="PSA 119:55">busentina nadügüni le barufudahabei!<verse eid="PSA 119:55" /></para>
  <para style="q">
    <verse number="56" style="v" sid="PSA 119:56" />Anihán le yuubei nun:</para>
  <para style="q" vid="PSA 119:56">Lun nidin lau le bubeibei.<verse eid="PSA 119:56" /></para>
  <para style="qa">Jet</para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 119:57" />Buguya Nabureme, buguya sun le númabei;</para>
  <para style="q" vid="PSA 119:57">füramasehadina luagu nadügübei lan le bubeibei.<verse eid="PSA 119:57" /></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 119:58" />Hóuchaadina tau sun nanigi lun nagundaaragüdünibu;</para>
  <para style="q" vid="PSA 119:58">óuserabana buidu, kei füramase bani.<verse eid="PSA 119:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 119:59" />Rédeitina asaminara luagu nusan</para>
  <para style="q" vid="PSA 119:59">ábaya niabin lun nafalaruni bugumadin.<verse eid="PSA 119:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 119:60" />Óufudahaadina lun nadügüni</para>
  <para style="q" vid="PSA 119:60">le lubeibei bugumadin.<verse eid="PSA 119:60" /></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 119:61" />Geyegua táadina hasadaran salufuritiña,</para>
  <para style="q" vid="PSA 119:61">gama lumoun mabulieidun numuti barufudahan.<verse eid="PSA 119:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 119:62" />Saratina amidi áriebu eteingirabu</para>
  <para style="q" vid="PSA 119:62">luagu bererun le richabei.<verse eid="PSA 119:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 119:63" />Hamadañadina ha inebehabubaña bun</para>
  <para style="q" vid="PSA 119:63">hama ha agunfulirubalin bugumadin.<verse eid="PSA 119:63" /></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 119:64" />Nabureme, buin liña múa lau bínsiñehabu,</para>
  <para style="q" vid="PSA 119:64">arufudabéi bilurudun nun!<verse eid="PSA 119:64" /></para>
  <para style="qa">Tet</para>
  <para style="q">
    <verse number="65" style="v" sid="PSA 119:65" />Nabureme, óusera baali bubuein le buidu</para>
  <para style="q" vid="PSA 119:65">kei füramase bani.<verse eid="PSA 119:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 119:66" />Ruba lichú aau nun luma subudi,</para>
  <para style="q" vid="PSA 119:66">ladüga hemenigitina luagu bugumadin.<verse eid="PSA 119:66" /></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 119:67" />Lubaragiñe buga nǘnabudagüdüniwa,</para>
  <para style="q" vid="PSA 119:67">adügatina saragu wuribati,</para>
  <para style="q" vid="PSA 119:67">gama lumoun guentó ñǘdüntina lau le bubeibei.<verse eid="PSA 119:67" /></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 119:68" />Buítibu ani adüga bumuti giñe buiti;</para>
  <para style="q" vid="PSA 119:68">arufudahabei bilurudun nun!<verse eid="PSA 119:68" /></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 119:69" />Rútiña wuribatiña nidurun madurunga au houn,</para>
  <para style="q" vid="PSA 119:69">gama lumoun gúnfuli numuti bugumadin tau sun nanigi.<verse eid="PSA 119:69" /></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 119:70" />Darugu liña hasaminan,</para>
  <para style="q" vid="PSA 119:70">anhein au, gúndaatina lau barufudahan.<verse eid="PSA 119:70" /></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 119:71" />Buiti ladüga nǘnabudawagüdüniwa nun,</para>
  <para style="q" vid="PSA 119:71">ladüga ítara furendei numuti bilurudun.<verse eid="PSA 119:71" /></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 119:72" />Gebegitimati barufudahan nun</para>
  <para style="q" vid="PSA 119:72">sügǘ lau milu seinsu le golu luma pülata.<verse eid="PSA 119:72" /></para>
  <para style="qa">Yod</para>
  <para style="q">
    <verse number="73" style="v" sid="PSA 119:73" />Buguya guánarügü adügübalina,</para>
  <para style="q" vid="PSA 119:73">ruba lichú aau nun lun gunfuranda nani bugumadin!<verse eid="PSA 119:73" /></para>
  <para style="q">
    <verse number="74" style="v" sid="PSA 119:74" />Hagundaaruba ha hínsiñehabubaña bun lau harihinina,</para>
  <para style="q" vid="PSA 119:74">ladüga ru naali nemenigin luagu bererun.<verse eid="PSA 119:74" /></para>
  <para style="q">
    <verse number="75" style="v" sid="PSA 119:75" />Nabureme, subudi numuti luagu richá lan bererun,</para>
  <para style="q" vid="PSA 119:75">ani luagu giñe richá ban dan le nidiherigüdabánina.<verse eid="PSA 119:75" /></para>
  <para style="q">
    <verse number="76" style="v" sid="PSA 119:76" />Seriwilá bínsiñehabu nun kei gurasu,</para>
  <para style="q" vid="PSA 119:76">kei le aubei füramase bani nun!<verse eid="PSA 119:76" /></para>
  <para style="q">
    <verse number="77" style="v" sid="PSA 119:77" />Arufudabéi bareini nun, ani gabagarigüdabana,</para>
  <para style="q" vid="PSA 119:77">ladüga gúndaati nasandiragun nungua lau barufudahan.<verse eid="PSA 119:77" /></para>
  <para style="q">
    <verse number="78" style="v" sid="PSA 119:78" />Barǘ hamá wuribatiña busiganu,</para>
  <para style="q" vid="PSA 119:78">ladüga rútiña nidurun mébunouga,</para>
  <para style="q" vid="PSA 119:78">busentina nasaminarun luagu barufudahan.<verse eid="PSA 119:78" /></para>
  <para style="q">
    <verse number="79" style="v" sid="PSA 119:79" />Ñübuin hamá ha hínsiñehabubaña bun numoun,</para>
  <para style="q" vid="PSA 119:79">ha subudihabúbaña lun bugumadin.<verse eid="PSA 119:79" /></para>
  <para style="q">
    <verse number="80" style="v" sid="PSA 119:80" />Harumatá nanigi le gumuti lidan bilurudun,</para>
  <para style="q" vid="PSA 119:80">ua láamuga ni kata uáguti nanüga busiganu.<verse eid="PSA 119:80" /></para>
  <para style="qa">Caf</para>
  <para style="q">
    <verse number="81" style="v" sid="PSA 119:81" />Agurabatina lau mágüdahaü lun besefurunina;</para>
  <para style="q" vid="PSA 119:81">ru naali nemenigin luagu bererun!<verse eid="PSA 119:81" /></para>
  <para style="q">
    <verse number="82" style="v" sid="PSA 119:82" />Buchá luagu nagu ayahua, agurabahei le füramase bubéi,</para>
  <para style="q" vid="PSA 119:82">nálügüdaguati nungua: «Ídaba san biabin ámalihana?»<verse eid="PSA 119:82" /></para>
  <para style="q">
    <verse number="83" style="v" sid="PSA 119:83" />Lau sun aban lan weiriei mutu móuniti au ani bulíeiwaali,</para>
  <para style="q" vid="PSA 119:83">mabulieidagungidina luéi bilurudun.<verse eid="PSA 119:83" /></para>
  <para style="q">
    <verse number="84" style="v" sid="PSA 119:84" />Átiribei san dan nagurabahan lanwoun le?</para>
  <para style="q" vid="PSA 119:84">Ídaame san baguseragüdaña ha éibaahabalina?<verse eid="PSA 119:84" /></para>
  <para style="q">
    <verse number="85" style="v" sid="PSA 119:85" />Gürigia wuribatiña ha mafalarunbalin barufudahan,</para>
  <para style="q" vid="PSA 119:85">achíahaaña huyu lidan némeri.<verse eid="PSA 119:85" /></para>
  <para style="q">
    <verse number="86" style="v" sid="PSA 119:86" />Íderaguabana, ladüga éibaahouatina mébunouga.</para>
  <para style="q" vid="PSA 119:86">Richati sun bugumadin!<verse eid="PSA 119:86" /></para>
  <para style="q">
    <verse number="87" style="v" sid="PSA 119:87" />Ítagaraü yebe nafarúniwa hilagubei,</para>
  <para style="q" vid="PSA 119:87">gama lumoun mígirun nágili barufudahan.<verse eid="PSA 119:87" /></para>
  <para style="q">
    <verse number="88" style="v" sid="PSA 119:88" />Ruba ibagari nun le úaraguati luma bínsiñehabu,</para>
  <para style="q" vid="PSA 119:88">ábame nagunfuliruni bugumadin.<verse eid="PSA 119:88" /></para>
  <para style="qa">Lámed</para>
  <para style="q">
    <verse number="89" style="v" sid="PSA 119:89" />Nabureme, magumuchaditi bererun;</para>
  <para style="q" vid="PSA 119:89">derebuguhali bererun sielu!<verse eid="PSA 119:89" /></para>
  <para style="q">
    <verse number="90" style="v" sid="PSA 119:90" />Magumuchaditi bigunfulin</para>
  <para style="q" vid="PSA 119:90">derebugugüda bumuti múa,</para>
  <para style="q" vid="PSA 119:90">aba lerederun lara.<verse eid="PSA 119:90" /></para>
  <para style="q">
    <verse number="91" style="v" sid="PSA 119:91" />Sun katei laramémegili kei bariñaguni,</para>
  <para style="q" vid="PSA 119:91">ladüga sun ligía leseriwiduña bun.<verse eid="PSA 119:91" /></para>
  <para style="q">
    <verse number="92" style="v" sid="PSA 119:92" />Lun hamuga manügün lan barufudahan ugundani nun,</para>
  <para style="q" vid="PSA 119:92">gumuhali hamuga íruni nau.<verse eid="PSA 119:92" /></para>
  <para style="q">
    <verse number="93" style="v" sid="PSA 119:93" />Mabulieidúndügü nubéi barufudahan,</para>
  <para style="q" vid="PSA 119:93">ladüga luéigiñe bíchiga ibagari nun.<verse eid="PSA 119:93" /></para>
  <para style="q">
    <verse number="94" style="v" sid="PSA 119:94" />Sefubána, ladüga bani au</para>
  <para style="q" vid="PSA 119:94">ani falá naali bugumadin!<verse eid="PSA 119:94" /></para>
  <para style="q">
    <verse number="95" style="v" sid="PSA 119:95" />Hagurabahañein wuribatiña oura lun hagünrinchagunina,</para>
  <para style="q" vid="PSA 119:95">gama lumoun téniñuniña lun bugumadin.<verse eid="PSA 119:95" /></para>
  <para style="q">
    <verse number="96" style="v" sid="PSA 119:96" />Ariha naali luagu gébeha lan sun katei,</para>
  <para style="q" vid="PSA 119:96">ánheinti bugumadin mébehati.<verse eid="PSA 119:96" /></para>
  <para style="qa">Mem</para>
  <para style="q">
    <verse number="97" style="v" sid="PSA 119:97" />Wéiriti línsiñe barufudahan nun!</para>
  <para style="q" vid="PSA 119:97">Sun weyu nau asaminara luagun!<verse eid="PSA 119:97" /></para>
  <para style="q">
    <verse number="98" style="v" sid="PSA 119:98" />Nani bugumadin lun súnwandan;</para>
  <para style="q" vid="PSA 119:98">chúgüdaali nau hawéi náganiñu.<verse eid="PSA 119:98" /></para>
  <para style="q">
    <verse number="99" style="v" sid="PSA 119:99" />Gunfurandatina sügǘ hau sun numaisturungu</para>
  <para style="q" vid="PSA 119:99">ladüga saminatina saragu luagu bugumadin.<verse eid="PSA 119:99" /></para>
  <para style="q">
    <verse number="100" style="v" sid="PSA 119:100" />Gunfurandatina sügǘ hau wéiyaaña mutu</para>
  <para style="q" vid="PSA 119:100">ladüga ñǘdüntina lau barufudahan.<verse eid="PSA 119:100" /></para>
  <para style="q">
    <verse number="101" style="v" sid="PSA 119:101" />Dísegüda naali nugudi luéi sun luriban üma</para>
  <para style="q" vid="PSA 119:101">lun nagunfuliruni bererun.<verse eid="PSA 119:101" /></para>
  <para style="q">
    <verse number="102" style="v" sid="PSA 119:102" />Madireirúngidina luéi bererun,</para>
  <para style="q" vid="PSA 119:102">ladüga buguya arufudahabei nun.<verse eid="PSA 119:102" /></para>
  <para style="q">
    <verse number="103" style="v" sid="PSA 119:103" />Bímetimati füramase ban lun nagülerugu</para>
  <para style="q" vid="PSA 119:103">sügǘ lau sírudu niyumulugu.<verse eid="PSA 119:103" /></para>
  <para style="q">
    <verse number="104" style="v" sid="PSA 119:104" />Daritina gunfurandaü lidan bugumadin;</para>
  <para style="q" vid="PSA 119:104">ligía liyereegunbei sun luriban usa nun.<verse eid="PSA 119:104" /></para>
  <para style="qa">Nun</para>
  <para style="q">
    <verse number="105" style="v" sid="PSA 119:105" />Igemeri bererun lun nugudi,</para>
  <para style="q" vid="PSA 119:105">larugounga ligía lun némeri.<verse eid="PSA 119:105" /></para>
  <para style="q">
    <verse number="106" style="v" sid="PSA 119:106" />Adügatina aban áfiñuruni ani nagunfulirubei:</para>
  <para style="q" vid="PSA 119:106">Nadügübei le bubeibei!<verse eid="PSA 119:106" /></para>
  <para style="q">
    <verse number="107" style="v" sid="PSA 119:107" />Nabureme, nidiheriti nasandiragun nungua;</para>
  <para style="q" vid="PSA 119:107">ruba ibagari nun kei füramasebani!<verse eid="PSA 119:107" /></para>
  <para style="q">
    <verse number="108" style="v" sid="PSA 119:108" />Resibibéi lidewese niyuma Nabureme,</para>
  <para style="q" vid="PSA 119:108">arufudahabei bererun nun.<verse eid="PSA 119:108" /></para>
  <para style="q">
    <verse number="109" style="v" sid="PSA 119:109" />Súnwandan lídanñadina lan denchaü lánina óunweni,</para>
  <para style="q" vid="PSA 119:109">gama lumoun mabulieidaguntina luéi barufudahan.<verse eid="PSA 119:109" /></para>
  <para style="q">
    <verse number="110" style="v" sid="PSA 119:110" />Sétitiña salufuritiña sádara nubá,</para>
  <para style="q" vid="PSA 119:110">gama lumoun madiñutina luéi bugumadin.<verse eid="PSA 119:110" /></para>
  <para style="q">
    <verse number="111" style="v" sid="PSA 119:111" />Bugumadin nalagantebei lun súnwandan,</para>
  <para style="q" vid="PSA 119:111">ladüga ligía agundaaragüdübarun nanigi.<verse eid="PSA 119:111" /></para>
  <para style="q">
    <verse number="112" style="v" sid="PSA 119:112" />Rúguaadina nungua tau sun nanigi</para>
  <para style="q" vid="PSA 119:112">lun nagunfuliruni bilurudun,</para>
  <para style="q" vid="PSA 119:112">lun súnwandan darí lumoun lagumuhóun.<verse eid="PSA 119:112" /></para>
  <para style="qa">Sámej</para>
  <para style="q">
    <verse number="113" style="v" sid="PSA 119:113" />Iyereegutiña gürigia biangua tigibu nun,</para>
  <para style="q" vid="PSA 119:113">gama lumoun hínsiñeti barufudahan nun.<verse eid="PSA 119:113" /></para>
  <para style="q">
    <verse number="114" style="v" sid="PSA 119:114" />Buguya naramudaguagülebei ani góunigibana;</para>
  <para style="q" vid="PSA 119:114">ru naali nemenigin luagu bererun.<verse eid="PSA 119:114" /></para>
  <para style="q">
    <verse number="115" style="v" sid="PSA 119:115" />Dise humá nuéi salufuritiña huguya le,</para>
  <para style="q" vid="PSA 119:115">ladüga busentina nagunfuliruni lugumadin Nubungiute!<verse eid="PSA 119:115" /></para>
  <para style="q">
    <verse number="116" style="v" sid="PSA 119:116" />Ruba erei nun kei füramase bani, gabagari náamuga;</para>
  <para style="q" vid="PSA 119:116">magidarabéi nemenigin nuéi!<verse eid="PSA 119:116" /></para>
  <para style="q">
    <verse number="117" style="v" sid="PSA 119:117" />Íderaguabana ábame gayara lan nesefurun;</para>
  <para style="q" vid="PSA 119:117">ítara luba nagunfuliruni bilurudun súnwandan.<verse eid="PSA 119:117" /></para>
  <para style="q">
    <verse number="118" style="v" sid="PSA 119:118" />Mabahüdün bumutiña ha adiñurubaña luéi bilurudun,</para>
  <para style="q" vid="PSA 119:118">ladüga málati hasaminan.<verse eid="PSA 119:118" /></para>
  <para style="q">
    <verse number="119" style="v" sid="PSA 119:119" />Sun wuribatiña ha ubouagubaña,</para>
  <para style="q" vid="PSA 119:119">ítara haña bun kei ifei;</para>
  <para style="q" vid="PSA 119:119">ligía línsiñebei bugumadin nun.<verse eid="PSA 119:119" /></para>
  <para style="q">
    <verse number="120" style="v" sid="PSA 119:120" />Adadagarati núgubu lau anufudei bigibugiñe;</para>
  <para style="q" vid="PSA 119:120">inebeti bererun nun!<verse eid="PSA 119:120" /></para>
  <para style="qa">Ayin</para>
  <para style="q">
    <verse number="121" style="v" sid="PSA 119:121" />Mígirunñaha nágili nadügüni le richabei;</para>
  <para style="q" vid="PSA 119:121">mígirabana háhaburugu ha adiheridagüdübadina.<verse eid="PSA 119:121" /></para>
  <para style="q">
    <verse number="122" style="v" sid="PSA 119:122" />Füramasebá nun bíderagubadina lan,</para>
  <para style="q" vid="PSA 119:122">móuseragua hamana wuribatiña.<verse eid="PSA 119:122" /></para>
  <para style="q">
    <verse number="123" style="v" sid="PSA 119:123" />Buchá luagu nagu ayahua aguraba besefurunina,</para>
  <para style="q" vid="PSA 119:123">aguraba basalbarunina kei füramase bani.<verse eid="PSA 119:123" /></para>
  <para style="q">
    <verse number="124" style="v" sid="PSA 119:124" />Óuserabana lau ligaburi bínsiñehabu,</para>
  <para style="q" vid="PSA 119:124">arufudahabei bilurudun nun!<verse eid="PSA 119:124" /></para>
  <para style="q">
    <verse number="125" style="v" sid="PSA 119:125" />Bubuein au.</para>
  <para style="q" vid="PSA 119:125">Ruba gunfurandaü nun,</para>
  <para style="q" vid="PSA 119:125">ladüga busentina nasubudiruni bugumadin.<verse eid="PSA 119:125" /></para>
  <para style="q">
    <verse number="126" style="v" sid="PSA 119:126" />Aburemei, chülüha dan lun badügün somu katei,</para>
  <para style="q" vid="PSA 119:126">ladüga rúhaña mebereseni lun bugumadin.<verse eid="PSA 119:126" /></para>
  <para style="q">
    <verse number="127" style="v" sid="PSA 119:127" />Ligía línsiñebei bugumadin nun</para>
  <para style="q" vid="PSA 119:127">sügǘ lau golu fínuti.<verse eid="PSA 119:127" /></para>
  <para style="q">
    <verse number="128" style="v" sid="PSA 119:128" />Ligía nafalarunbalin bugumadin,</para>
  <para style="q" vid="PSA 119:128">iyereegu ligía sun luriban óuseruni nun.<verse eid="PSA 119:128" /></para>
  <para style="qa">Pe</para>
  <para style="q">
    <verse number="129" style="v" sid="PSA 119:129" />Buíduburiti bugumadin;</para>
  <para style="q" vid="PSA 119:129">ligía nagunfulirunbalin.<verse eid="PSA 119:129" /></para>
  <para style="q">
    <verse number="130" style="v" sid="PSA 119:130" />Harugoungadagüdati lanichigu bererun,</para>
  <para style="q" vid="PSA 119:130">arufudaha ligía houn gürigia ha lóuguati hanichigu.<verse eid="PSA 119:130" /></para>
  <para style="q">
    <verse number="131" style="v" sid="PSA 119:131" />Wagatina lau óunwenbu ayumahani,</para>
  <para style="q" vid="PSA 119:131">ladüga ayumaha numuti bugumadin.<verse eid="PSA 119:131" /></para>
  <para style="q">
    <verse number="132" style="v" sid="PSA 119:132" />Arihabána, gudeme nan bun,</para>
  <para style="q" vid="PSA 119:132">kei badüga houn ha hínsiñehabubaña bun.<verse eid="PSA 119:132" /></para>
  <para style="q">
    <verse number="133" style="v" sid="PSA 119:133" />Éibugagüdabana ítara kei füramase bani;</para>
  <para style="q" vid="PSA 119:133">mígiraba lun lagumadirunina wuribani.<verse eid="PSA 119:133" /></para>
  <para style="q">
    <verse number="134" style="v" sid="PSA 119:134" />Sefubána luéi hanarime gürigia,</para>
  <para style="q" vid="PSA 119:134">ladüga busentina nagunfuliruni bugumadin.<verse eid="PSA 119:134" /></para>
  <para style="q">
    <verse number="135" style="v" sid="PSA 119:135" />Arihabána lau lubuidun agu,</para>
  <para style="q" vid="PSA 119:135">ani arufudahabéime bilurudun nun.<verse eid="PSA 119:135" /></para>
  <para style="q">
    <verse number="136" style="v" sid="PSA 119:136" />Furiti águiraü nágurugugiñe kei duna,</para>
  <para style="q" vid="PSA 119:136">ladüga minebenwa lan barufudahan.<verse eid="PSA 119:136" /></para>
  <para style="qa">Tsade</para>
  <para style="q">
    <verse number="137" style="v" sid="PSA 119:137" />Aburemei, richatibu;</para>
  <para style="q" vid="PSA 119:137">úaraguati bererun.<verse eid="PSA 119:137" /></para>
  <para style="q">
    <verse number="138" style="v" sid="PSA 119:138" />Sun bugumadin richati,</para>
  <para style="q" vid="PSA 119:138">ani inarüniti giñe.<verse eid="PSA 119:138" /></para>
  <para style="q">
    <verse number="139" style="v" sid="PSA 119:139" />Lagumuchaguagüdüñadina emeidini</para>
  <para style="q" vid="PSA 119:139">le nasandirubei luagu bererun,</para>
  <para style="q" vid="PSA 119:139">ladüga bulíeiguaaña náganiñu luéi.<verse eid="PSA 119:139" /></para>
  <para style="q">
    <verse number="140" style="v" sid="PSA 119:140" />Chóuruti liderebugu bani füramasei,</para>
  <para style="q" vid="PSA 119:140">ligía línsiñebei nun.<verse eid="PSA 119:140" /></para>
  <para style="q">
    <verse number="141" style="v" sid="PSA 119:141" />Ni kátañadina, mabahüdǘn au,</para>
  <para style="q" vid="PSA 119:141">gama lumoun mabulieidaguntina luéi bugumadin.<verse eid="PSA 119:141" /></para>
  <para style="q">
    <verse number="142" style="v" sid="PSA 119:142" />Súnwandan úaragua lan baguseragüdün,</para>
  <para style="q" vid="PSA 119:142">ani inarüniti barufudahan.<verse eid="PSA 119:142" /></para>
  <para style="q">
    <verse number="143" style="v" sid="PSA 119:143" />Dariguaadina nungua lidan lidere dan luma idiheri,</para>
  <para style="q" vid="PSA 119:143">gama lumoun gúndaaguagüda lumutina bugumadin.<verse eid="PSA 119:143" /></para>
  <para style="q">
    <verse number="144" style="v" sid="PSA 119:144" />Richati bugumadin súnwandan;</para>
  <para style="q" vid="PSA 119:144">ruba gunfurandaü nun gayara láamuga nabagaridun!<verse eid="PSA 119:144" /></para>
  <para style="qa">Qof</para>
  <para style="q">
    <verse number="145" style="v" sid="PSA 119:145" />Nabureme, wátina bun tau sun nanigi;</para>
  <para style="q" vid="PSA 119:145">óunababana, ladüga busentina nagunfuliruni bilurudun!<verse eid="PSA 119:145" /></para>
  <para style="q">
    <verse number="146" style="v" sid="PSA 119:146" />Buguya náwarubei;</para>
  <para style="q" vid="PSA 119:146">íderaguabana, gúnfuli náamugei bugumadin.<verse eid="PSA 119:146" /></para>
  <para style="q">
    <verse number="147" style="v" sid="PSA 119:147" />Lubaragiñe larugadun,</para>
  <para style="q" vid="PSA 119:147">saratina amuriahei bídehan;</para>
  <para style="q" vid="PSA 119:147">ru naali nemenigin luagu bani füramasei.<verse eid="PSA 119:147" /></para>
  <para style="q">
    <verse number="148" style="v" sid="PSA 119:148" />Rédeitina marumugunga sun áriebu</para>
  <para style="q" vid="PSA 119:148">lun nasaminarun luagu bererun.<verse eid="PSA 119:148" /></para>
  <para style="q">
    <verse number="149" style="v" sid="PSA 119:149" />Nabureme, aganbabéi numalali luagu bínsiñehabu;</para>
  <para style="q" vid="PSA 119:149">ruba ibagari nun según biricha.<verse eid="PSA 119:149" /></para>
  <para style="q">
    <verse number="150" style="v" sid="PSA 119:150" />Yarafatiña ha éibaahabalina nun,</para>
  <para style="q" vid="PSA 119:150">ani dísetiña luéi barufudahan.<verse eid="PSA 119:150" /></para>
  <para style="q">
    <verse number="151" style="v" sid="PSA 119:151" />Buguya Aburemei, yarafañubiña,</para>
  <para style="q" vid="PSA 119:151">ani sun bugumadin inarüniti.<verse eid="PSA 119:151" /></para>
  <para style="q">
    <verse number="152" style="v" sid="PSA 119:152" />Lúmagiñe binarü nasubudirei bugumadin,</para>
  <para style="q" vid="PSA 119:152">le bíchugubei lun súnwandan.<verse eid="PSA 119:152" /></para>
  <para style="qa">Resh</para>
  <para style="q">
    <verse number="153" style="v" sid="PSA 119:153" />Arihabéi nidiheri ani sefubána,</para>
  <para style="q" vid="PSA 119:153">mabulieidagungidina luéi barufudahan.<verse eid="PSA 119:153" /></para>
  <para style="q">
    <verse number="154" style="v" sid="PSA 119:154" />Ageindaguabei nikesin, sefu báname;</para>
  <para style="q" vid="PSA 119:154">ruba ibagari nun ítara kei füramase bani!<verse eid="PSA 119:154" /></para>
  <para style="q">
    <verse number="155" style="v" sid="PSA 119:155" />Díseti bídehan hawéi wuribatiña,</para>
  <para style="q" vid="PSA 119:155">ladüga mafala hamani bilurudun.<verse eid="PSA 119:155" /></para>
  <para style="q">
    <verse number="156" style="v" sid="PSA 119:156" />Nabureme, wéiriti bareidun;</para>
  <para style="q" vid="PSA 119:156">ruba ibagari nun según biricha.<verse eid="PSA 119:156" /></para>
  <para style="q">
    <verse number="157" style="v" sid="PSA 119:157" />Gíbetiña náganiñu hama éibaahatina,</para>
  <para style="q" vid="PSA 119:157">gama lumoun madiseduntina luéi bugumadin.<verse eid="PSA 119:157" /></para>
  <para style="q">
    <verse number="158" style="v" sid="PSA 119:158" />Manaaguntina nungua hama ha gagarabaaguadibaña houn amu,</para>
  <para style="q" vid="PSA 119:158">ha mídinbaña lau le lubeibei bugumadin.<verse eid="PSA 119:158" /></para>
  <para style="q">
    <verse number="159" style="v" sid="PSA 119:159" />Nabureme, arihabá lueirin línsiñe bugumadin nun,</para>
  <para style="q" vid="PSA 119:159">ruba ibagari nun, luagu bínsiñehabu!<verse eid="PSA 119:159" /></para>
  <para style="q">
    <verse number="160" style="v" sid="PSA 119:160" />Lídanñein bererun inarüni;</para>
  <para style="q" vid="PSA 119:160">magumuchaditi sun lúaran bererun.<verse eid="PSA 119:160" /></para>
  <para style="qa">Shin</para>
  <para style="q">
    <verse number="161" style="v" sid="PSA 119:161" />Éibaaha hamutina wügüriña gabafutiña mébunouga;</para>
  <para style="q" vid="PSA 119:161">gama lumoun inebeti bererun tun nanigi.<verse eid="PSA 119:161" /></para>
  <para style="q">
    <verse number="162" style="v" sid="PSA 119:162" />Gúndaatina lau le füramase bubéi,</para>
  <para style="q" vid="PSA 119:162">kei le adariruti aban óunwenbu irisini.<verse eid="PSA 119:162" /></para>
  <para style="q">
    <verse number="163" style="v" sid="PSA 119:163" />Iyereeguti marasualugu nun, mawandun numuti;</para>
  <para style="q" vid="PSA 119:163">gama lumoun hínsiñeti barufudahan nun.<verse eid="PSA 119:163" /></para>
  <para style="q">
    <verse number="164" style="v" sid="PSA 119:164" />Eremuhatina bun súnwandan,</para>
  <para style="q" vid="PSA 119:164">luagu lúaragun bererun.<verse eid="PSA 119:164" /></para>
  <para style="q">
    <verse number="165" style="v" sid="PSA 119:165" />Wéiriti darangila hamá ha hínsiñehabubaña lun barufudahan,</para>
  <para style="q" vid="PSA 119:165">ani úati lunti léiguadagüdüniña.<verse eid="PSA 119:165" /></para>
  <para style="q">
    <verse number="166" style="v" sid="PSA 119:166" />Nabureme, agurabatina besefurunina,</para>
  <para style="q" vid="PSA 119:166">ladüga adüga naali bugumadin.<verse eid="PSA 119:166" /></para>
  <para style="q">
    <verse number="167" style="v" sid="PSA 119:167" />Ñǘdüntina lau le bubeibei,</para>
  <para style="q" vid="PSA 119:167">ani hínsiñeti bugumadin nun tau sun nanigi.<verse eid="PSA 119:167" /></para>
  <para style="q">
    <verse number="168" style="v" sid="PSA 119:168" />Gúnfuli numuti barufudahan luma bugumadin;</para>
  <para style="q" vid="PSA 119:168">subudi bumuti sun nóuserun!<verse eid="PSA 119:168" /></para>
  <para style="qa">Tav</para>
  <para style="q">
    <verse number="169" style="v" sid="PSA 119:169" />Chülüla nagúaragun biñuarün Nabureme,</para>
  <para style="q" vid="PSA 119:169">ruba gunfurandaü nun ítara kei füramase bani!<verse eid="PSA 119:169" /></para>
  <para style="q">
    <verse number="170" style="v" sid="PSA 119:170" />Chülüla nafurieidun biñuarün;</para>
  <para style="q" vid="PSA 119:170">sefubána kei le aubei füramase bani!<verse eid="PSA 119:170" /></para>
  <para style="q">
    <verse number="171" style="v" sid="PSA 119:171" />Furila eremuhani niyumulugugiñe,</para>
  <para style="q" vid="PSA 119:171">ladüga arufudaha baali bilurudun nun.<verse eid="PSA 119:171" /></para>
  <para style="q">
    <verse number="172" style="v" sid="PSA 119:172" />Wala niyuma aban uremu luáguti füramasei,</para>
  <para style="q" vid="PSA 119:172">ladüga richati sun bugumadin.<verse eid="PSA 119:172" /></para>
  <para style="q">
    <verse number="173" style="v" sid="PSA 119:173" />Aranseñulá búhabu lun líderagunina</para>
  <para style="q" vid="PSA 119:173">ladüga himei naali bugumadin.<verse eid="PSA 119:173" /></para>
  <para style="q">
    <verse number="174" style="v" sid="PSA 119:174" />Nabureme,</para>
  <para style="q" vid="PSA 119:174">busentina lun besefurunina!</para>
  <para style="q" vid="PSA 119:174">Gúndaati nasandiragun nungua lau barufudahan!<verse eid="PSA 119:174" /></para>
  <para style="q">
    <verse number="175" style="v" sid="PSA 119:175" />Busentina nabagaridun lun nalawahanibu;</para>
  <para style="q" vid="PSA 119:175">íderagualana biricha.<verse eid="PSA 119:175" /></para>
  <para style="q">
    <verse number="176" style="v" sid="PSA 119:176" />Yuriguaadina keisi aban mudún;</para>
  <para style="q" vid="PSA 119:176">higabu báluahana,</para>
  <para style="q" vid="PSA 119:176">ladüga mabulieidagungidina luéi bugumadin!<verse eid="PSA 119:176" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" sid="PSA 120" />
  <para style="s1">Lamuriahóun ídemuei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 120:1" />Dan le nidiheri nan wátina lun Nabureme,</para>
  <para style="q" vid="PSA 120:1">ani aba lóunabunina.<verse eid="PSA 120:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 120:2" />Nabureme, sefubána luéi iyumaü yeeti</para>
  <para style="q" vid="PSA 120:2">luma tuéi iñeñein to hanarimeti tayeehan.<verse eid="PSA 120:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 120:3" />Ka amu katei gayaraabei beresibiruni,</para>
  <para style="q" vid="PSA 120:3">iñeñein marasualugutu?<verse eid="PSA 120:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 120:4" />Háfudurawaguba tau hagimaran súdara to gágiritu!</para>
  <para style="q" vid="PSA 120:4">Gudawa hagíame lau watu gemeti!<verse eid="PSA 120:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 120:5" />Fugiabu au, le aganóubei kei terencha Mesekü,</para>
  <para style="q" vid="PSA 120:5">redei au hadan gürigia Kedarüna!<verse eid="PSA 120:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 120:6" />Gíbeyaali naganóun hadan ha</para>
  <para style="q" vid="PSA 120:6">iyereehabúbaña lun darangilaü;<verse eid="PSA 120:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 120:7" />dan le nadimurehan luagu darangilaü,</para>
  <para style="q" vid="PSA 120:7">aba hadimurehan luagu wuribu!<verse eid="PSA 120:7" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" sid="PSA 121" />
  <para style="s1">Aburemei óunigirubaliwa</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 121:1" />Dan le burí nerederagun aríaguei áraabu,</para>
  <para style="q" vid="PSA 121:1">aba nálügüdagun nungua, nariñaga:</para>
  <para style="q" vid="PSA 121:1">«Halíagiñeba san liabin níderawagun?»?<verse eid="PSA 121:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 121:2" />Lúmagiñeba Nabureme liabin níderawagun,</para>
  <para style="q" vid="PSA 121:2">Aburemei le adügübalin sielu luma múa.<verse eid="PSA 121:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 121:3" />Mígirun lubadibu lun baguyedagun!</para>
  <para style="q" vid="PSA 121:3">Marumugun ligíame le óunigirubalibu!<verse eid="PSA 121:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 121:4" />Uá, marumugunheiti;</para>
  <para style="q" vid="PSA 121:4">marumugunheiti le óunigirubalin Ísüraeli.<verse eid="PSA 121:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 121:5" />Aburemei óunigirubalibu,</para>
  <para style="q" vid="PSA 121:5">Aburemei aramudubalibu,</para>
  <para style="q" vid="PSA 121:5">le burugabubei lun líderagunibu.<verse eid="PSA 121:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 121:6" />Madügünbei weyu damichi bun wéyuagu,</para>
  <para style="q" vid="PSA 121:6">ni hati áriebu.<verse eid="PSA 121:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 121:7" />Areida lumutibu Aburemei luéi sun luwuyeri denchaü;</para>
  <para style="q" vid="PSA 121:7">areida lumuti bibagari.<verse eid="PSA 121:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 121:8" />Areida lumutibu Aburemei lidan sun béibugun,</para>
  <para style="q" vid="PSA 121:8">guentó luma súnwandan.<verse eid="PSA 121:8" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" sid="PSA 122" />
  <para style="s1">Alawahani lun Herusalén</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 122:1" />Wéiriti nugundan dan le hariñagun nun:</para>
  <para style="q" vid="PSA 122:1">«Keima lúbiñe Aburemei!»<verse eid="PSA 122:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 122:2" />Herusalén,</para>
  <para style="q" vid="PSA 122:2">awanheinhadiwa múnada libiti bubenari!<verse eid="PSA 122:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 122:3" />Herusalén, uburugu adügǘti</para>
  <para style="q" vid="PSA 122:3">lun hóundaragun lílana fulasu ñein.<verse eid="PSA 122:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 122:4" />Ñeinhin hayabin lani Aburemei türibu</para>
  <para style="q" vid="PSA 122:4">lun halawahani liri,</para>
  <para style="q" vid="PSA 122:4">kei lariñawagún lun Ísüraeli.<verse eid="PSA 122:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 122:5" />Ñeinñoun burí lúbaana aguseruni,</para>
  <para style="q" vid="PSA 122:5">tani lúbaana larúeihan Dawidi aguseragülei.<verse eid="PSA 122:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 122:6" />Ariñaga humá tau hanigi:</para>
  <para style="q" vid="PSA 122:6">«Ñeinlá darangilaü bidan, Herusalén;</para>
  <para style="q" vid="PSA 122:6">darangilañu lan hawinwandun ha hínsiñehabubaña bun.<verse eid="PSA 122:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 122:7" />Ñeinlá darangilaü lidan bubarieirun,</para>
  <para style="q" vid="PSA 122:7">ñeinlá achoururuni tidan bani palasiu».<verse eid="PSA 122:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 122:8" />Guentó nariñaguba hawagu níbirigu hama numadagu:</para>
  <para style="q" vid="PSA 122:8">«Ñeinlá darangilaü bidan.<verse eid="PSA 122:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 122:9" />Náfaaguba luagu buiti bun,</para>
  <para style="q" vid="PSA 122:9">tuagu luban Aburemei le Wabungiute».<verse eid="PSA 122:9" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" sid="PSA 123" />
  <para style="s1">Afurieiduni lánina emenigini luagu Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 123:1" />Nabureme, bun niñurei narihin lau ayumuruni,</para>
  <para style="q" vid="PSA 123:1">buagun, buguya le arúeihabei sielu.<verse eid="PSA 123:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 123:2" />Ayumuraguatiwa iñureina waméi warihin</para>
  <para style="q" vid="PSA 123:2">luagun Wabureme Bungiu,</para>
  <para style="q" vid="PSA 123:2">kei larihin musu luagun lúhabu labureme,</para>
  <para style="q" vid="PSA 123:2">kei tarihin musu luagun túhabu tabureme,</para>
  <para style="q" vid="PSA 123:2">aguraba gudemehabu lan woun.<verse eid="PSA 123:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 123:3" />Gudeme wamá bun, Wabureme;</para>
  <para style="q" vid="PSA 123:3">gudeme wamá bun,</para>
  <para style="q" vid="PSA 123:3">ladüga mawandun wamaali hanabaguniwa;<verse eid="PSA 123:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 123:4" />gíbeeli wasufuriruni habulan rísitiña</para>
  <para style="q" vid="PSA 123:4">luma mebereseni hámagiñe barügua tungua!<verse eid="PSA 123:4" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" sid="PSA 124" />
  <para style="s1">Bungiu, lesefuragülebei Ísüraeli</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 124:1" />Lun hamuga buga mámañein lan wámagiñe Aburemei</para>
  <para style="q" vid="PSA 124:1">—ariñagaléi Ísüraeli guentó—<verse eid="PSA 124:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 124:2" />Lun hamuga buga mámañein lan wámagiñe Aburemei</para>
  <para style="q" vid="PSA 124:2">dan le hayabinbei wügüriña lun hageindagun wama,<verse eid="PSA 124:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 124:3" />háhuluchuñadiwa hamuga wínwanñu</para>
  <para style="q" vid="PSA 124:3">dan le laweiridagun hagañi kóntüra wagía.<verse eid="PSA 124:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 124:4" />Aba hamugati meha laduruguduniwa duna;</para>
  <para style="q" vid="PSA 124:4">lásügürüña hamuga meha aban duna waweigiñe!<verse eid="PSA 124:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 124:5" />Lásügürüña hamuga lafuludurun duna waweigiñe!<verse eid="PSA 124:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 124:6" />Alawahoualá Aburemei,</para>
  <para style="q" vid="PSA 124:6">ladüga mígirunti lun hamurusuhaniwa lau hari!<verse eid="PSA 124:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 124:7" />Séfuhadiwa tídangiñe sádara</para>
  <para style="q" vid="PSA 124:7">kei tesefurun dunuru luéi éibaahati,</para>
  <para style="q" vid="PSA 124:7">héiriguatu sádara ani aba wáfuridun.<verse eid="PSA 124:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 124:8" />Lúmagiñe Aburemei liabin wíderawagun</para>
  <para style="q" vid="PSA 124:8">Bungiu le adügübalin sielu luma ubóu.<verse eid="PSA 124:8" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" sid="PSA 125" />
  <para style="s1">Areida lumutiña Bungiu lánigu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 125:1" />Ha hemenigibaña luagu Aburemei, mánhingichuatiña;</para>
  <para style="q" vid="PSA 125:1">ítara haña kei wübü Sión,</para>
  <para style="q" vid="PSA 125:1">derebuguluhaña lun súnwandan.<verse eid="PSA 125:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 125:2" />Ítara kei legeyedagun wübü lau Herusalén,</para>
  <para style="q" vid="PSA 125:2">ítara liña geyegu lan Aburemei hau lánigu</para>
  <para style="q" vid="PSA 125:2">guentó luma súnwandan.<verse eid="PSA 125:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 125:3" />Mabafubei luriban agumadihani súnwandan lidan múa</para>
  <para style="q" vid="PSA 125:3">le líchugubei Bungiu houn lánigu,</para>
  <para style="q" vid="PSA 125:3">gumesehañein lánigu afalarei wuribani.<verse eid="PSA 125:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 125:4" />Aburemei, adügabá buiti houn ha buídubaña;</para>
  <para style="q" vid="PSA 125:4">houn gürigia ha harumabaña anigi;<verse eid="PSA 125:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 125:5" />anhein houn ha luéigiñebaña üma wuribati,</para>
  <para style="q" vid="PSA 125:5">adügabá lun lidin houn kei lidin houn wuribatiña.</para>
  <para style="b" vid="PSA 125:5" />
  <para style="q" vid="PSA 125:5">Ñeinlá darangilaü Ísüraeli!<verse eid="PSA 125:5" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" sid="PSA 126" />
  <para style="s1">Adügabá lun lasansirun wabunurun!</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 126:1" />Dan le lasansirunbalin Aburemei lubunurun Sión,</para>
  <para style="q" vid="PSA 126:1">laganóun woun kamá uénedü.<verse eid="PSA 126:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 126:2" />Ábati labuinchun wayuma lau éherahani</para>
  <para style="q" vid="PSA 126:2">luma agúarahani le lánina ugundani;</para>
  <para style="q" vid="PSA 126:2">hariñagati gibe tubungiutegu:</para>
  <para style="q" vid="PSA 126:2">«Adügaali Aburemei katei wéinamuti hawagu!»<verse eid="PSA 126:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 126:3" />Inarüni, adügaali buga Aburemei katei wéinamuti wawagu,</para>
  <para style="q" vid="PSA 126:3">ani gúndaatiwa buga luagu.<verse eid="PSA 126:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 126:4" />Aburemei, adügabá lunya lasansiragun wabunurun,</para>
  <para style="q" vid="PSA 126:4">kei lasansiragun fulasu mageirawati lau láhuyun huya!<verse eid="PSA 126:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 126:5" />Ha ábunagubaña lau águiraü,</para>
  <para style="q" vid="PSA 126:5">halubahaba lau ugundani.<verse eid="PSA 126:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 126:6" />Íbini hayahun dan houdin tau sagü lautu ilaü,</para>
  <para style="q" vid="PSA 126:6">hagiribuduba eremuheina lau ugundani,</para>
  <para style="q" vid="PSA 126:6">lau burí güraguati türigu harünarugu.<verse eid="PSA 126:6" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" sid="PSA 127" />
  <para style="s1">Sun katei lúmagiñe Aburemei liabin</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 127:1" />Anhoun mábunagun lan Aburemei muna,</para>
  <para style="q" vid="PSA 127:1">málati hawadigimaridun ábunagutiña.</para>
  <para style="q" vid="PSA 127:1">Anhein móunigirun lan Aburemei uburugu,</para>
  <para style="q" vid="PSA 127:1">málati hóunigiruni óunigirutiña.<verse eid="PSA 127:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 127:2" />Málati luadigimariniwa sun weyu</para>
  <para style="q" vid="PSA 127:2">luma teigín aban fein agañeirútu lau igarigu;</para>
  <para style="q" vid="PSA 127:2">dan le ru lanu Bungiu houn lumadagu sun añaha lan arumuga.<verse eid="PSA 127:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 127:3" />Wasaanigu ha wágurahabaña,</para>
  <para style="q" vid="PSA 127:3">aban abiniruni rísiti hagía lun Aburemei.<verse eid="PSA 127:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 127:4" />Wasaanigu ha wágurahabaña dan le nibureingidiwa,</para>
  <para style="q" vid="PSA 127:4">ítara haña kei gimara lúhaburugu aban wuriburuguna.<verse eid="PSA 127:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 127:5" />Fuleseiwatiña gürigia ha gagimaranbaña ítara!</para>
  <para style="q" vid="PSA 127:5">Manügünbaña busiganu hagibugiñe háganiñu</para>
  <para style="q" vid="PSA 127:5">danme le hageindaguni hakesin hagibugiñe aguseragüdütiña.<verse eid="PSA 127:5" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" sid="PSA 128" />
  <para style="s1">Labinihan Aburemei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 128:1" />fuleseiwatibu, buguya le inebehabubei lun Aburemei</para>
  <para style="q" vid="PSA 128:1">gaganbadi buguya lun.<verse eid="PSA 128:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 128:2" />Béigiba lídangiñe buadigimari,</para>
  <para style="q" vid="PSA 128:2">gúndaabadibu, buídubei giñe lidin bun.<verse eid="PSA 128:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 128:3" />Ítara tuba búmari kei tídibu beibei to gíbetu tin;</para>
  <para style="q" vid="PSA 128:3">ítara haba birahüñü geyegu lau bidabulan</para>
  <para style="q" vid="PSA 128:3">kamá láhüchagun oliwu.<verse eid="PSA 128:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 128:4" />Ítara luba labiniruniña Aburemei</para>
  <para style="q" vid="PSA 128:4">gürigia ha inebehabubaña lun.<verse eid="PSA 128:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 128:5" />Binilabu Aburemei lídangiñe wübü le Sión!</para>
  <para style="q" vid="PSA 128:5">Ariha báamugei lubuidun dan lun Herusalén</para>
  <para style="q" vid="PSA 128:5">sun weyu lidan bibagari!<verse eid="PSA 128:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 128:6" />Ariha báamugaña bibañan!</para>
  <para style="b" vid="PSA 128:6" />
  <para style="q" vid="PSA 128:6">Ñeinlá darangilaü Ísüraeli!<verse eid="PSA 128:6" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" sid="PSA 129" />
  <para style="s1">Ruti Aburemei esefuruni</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 129:1" />Gíbeeli idiheri násügürün</para>
  <para style="q" vid="PSA 129:1">lúmagiñe nibureingidina</para>
  <para style="q" vid="PSA 129:1">—ariñagaléi Ísüraeli guentó—.<verse eid="PSA 129:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 129:2" />Gíbeeli idiheri násügürün</para>
  <para style="q" vid="PSA 129:2">lúmagiñe nibureingidina;</para>
  <para style="q" vid="PSA 129:2">gama lumoun magañeirun lumutina.<verse eid="PSA 129:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 129:3" />Bigua hamaali nanagan lau beiti,</para>
  <para style="q" vid="PSA 129:3">ígiratiña wéinamuti biti nuagu.<verse eid="PSA 129:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 129:4" />Gama lumoun Aburemei, le richabei,</para>
  <para style="q" vid="PSA 129:4">sefu láadina luéi habafu wuribatiña.<verse eid="PSA 129:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 129:5" />Barǘ hamá láganiñu Sión busiganu,</para>
  <para style="q" vid="PSA 129:5">anuraha hagíame!<verse eid="PSA 129:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 129:6" />Ítara hamá kei híduru le áhüchübei tábulugu muna,</para>
  <para style="q" vid="PSA 129:6">lubaragiñe lahulúniwa aba lásaürün!<verse eid="PSA 129:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 129:7" />Híduru le mabuinchunbei lúhaburugu</para>
  <para style="q" vid="PSA 129:7">le alubahabalin türigu aba lagürahani;<verse eid="PSA 129:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 129:8" />le giñe úabei ni aban ariñaguti luagu</para>
  <para style="q" vid="PSA 129:8">dan lásügürün lubadugiñe ichari:</para>
  <para style="q" vid="PSA 129:8">«Biní laali Aburemei!»</para>
  <para style="b" vid="PSA 129:8" />
  <para style="q" vid="PSA 129:8">Biní wamutün lidan liri Aburemei.<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" sid="PSA 130" />
  <para style="s1">Afiñeni luagu Aburemei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 130:1" />Nabureme, agúahatina bun lídangiñe</para>
  <para style="q" vid="PSA 130:1">lilulin-agei huyu.<verse eid="PSA 130:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 130:2" />Aganbabéi numalali Aburemei!</para>
  <para style="q" vid="PSA 130:2">Tenilá barigeirugu lun nagúaragun ayumuragua!<verse eid="PSA 130:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 130:3" />Aburemei, Aburemei,</para>
  <para style="q" vid="PSA 130:3">lun hamuga babahüdüni wafigoun,</para>
  <para style="q" vid="PSA 130:3">ka hamuga san gayaraabei lerederun lara?<verse eid="PSA 130:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 130:4" />Gama lumoun daritiwa ferudun bidan</para>
  <para style="q" vid="PSA 130:4">ligía gadüna bubéi lun wíchugun uéiriguni bun.<verse eid="PSA 130:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 130:5" />Aguraba numuti lídemue Nabureme tau sun nuani;</para>
  <para style="q" vid="PSA 130:5">ani afiñe au luagu lererun.<verse eid="PSA 130:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 130:6" />Aguraba numuti Nabureme tau sun nanigi</para>
  <para style="q" vid="PSA 130:6">sügǘ lau hagurabuni ha óunigirubaña áriebu larugadun.</para>
  <para style="q" vid="PSA 130:6">Ítara kei hagurabuni óunigirutiña larugadun,<verse eid="PSA 130:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 130:7" />ítarala giñe bagurabuni Aburemei, Ísüraeli,</para>
  <para style="q" vid="PSA 130:7">ladüga anihein ínsiñeni</para>
  <para style="q" vid="PSA 130:7">luma esefuruni le tímatimaati luma Bungiu.<verse eid="PSA 130:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 130:8" />Lesefurubei Bungiu Ísüraeli lídangiñe sun luriban!<verse eid="PSA 130:8" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" sid="PSA 131" />
  <para style="s1">Afurieiduni lánina afiñeni</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 131:1" />Nabureme, mapantantu nanigi,</para>
  <para style="q" vid="PSA 131:1">manaagun ligía nagu lungua,</para>
  <para style="q" vid="PSA 131:1">mídintina lárigi katei wéinamugubuti</para>
  <para style="q" vid="PSA 131:1">le díseti luéi niyara.<verse eid="PSA 131:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 131:2" />Lubaragiñe lira maní niña, darangilañu,</para>
  <para style="q" vid="PSA 131:2">ítara kei lerederun irahü deregüdagu túhaburugu lúguchu,</para>
  <para style="q" vid="PSA 131:2">ítara liña darangilañu tan nanigi nidan.<verse eid="PSA 131:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 131:3" />Ísüraeli, agurabahabá lidan Aburemei,</para>
  <para style="q" vid="PSA 131:3">guentó luma súnwandan.<verse eid="PSA 131:3" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" sid="PSA 132" />
  <para style="s1">Le füramase lubéi Bungiu lun Dawidi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 132:1" />Aburemei, haritaguabá luagun Dawidi</para>
  <para style="q" vid="PSA 132:1">luma luagun burí sun lidiheri;<verse eid="PSA 132:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 132:2" />haritaguabá luagu áfiñuruni le ladügübei bun,</para>
  <para style="q" vid="PSA 132:2">Lubungiute Hakobu:<verse eid="PSA 132:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 132:3" />«Mebelubadina tidoun muna,</para>
  <para style="q" vid="PSA 132:3">marounrunbadina emeraagua;<verse eid="PSA 132:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 132:4" />mámurudun nubéi nagu,</para>
  <para style="q" vid="PSA 132:4">marumugunbadina ni murusun,<verse eid="PSA 132:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 132:5" />darí nadarirun muna lun Aburemei gabafuti;</para>
  <para style="q" vid="PSA 132:5">Le Lubungiute Hakobu».<verse eid="PSA 132:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 132:6" />Belén waganba ladimurehoun</para>
  <para style="q" vid="PSA 132:6">tuagu bágüsi lánina daradu,</para>
  <para style="q" vid="PSA 132:6">darí wamutu áraabu Haarü.<verse eid="PSA 132:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 132:7" />Keimoun tidan lisanduariun Aburemei!</para>
  <para style="q" vid="PSA 132:7">Hudugua wamá ligibugiñe lebu lugudi!<verse eid="PSA 132:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 132:8" />Saraba Aburemei tau bubagüsin to gabafuboun,</para>
  <para style="q" vid="PSA 132:8">ñǘbuinba lidoun wübü le ñeinba lubéi bemeraagua.<verse eid="PSA 132:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 132:9" />Daügua hamá bufadirinigu lau irichaü;</para>
  <para style="q" vid="PSA 132:9">wagua hamá ha gúnfulibaña buma lau ugundani.<verse eid="PSA 132:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 132:10" />Luagu lugudemen Dawidi bun;</para>
  <para style="q" vid="PSA 132:10">mágurabei urúei le banúadirubei.<verse eid="PSA 132:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 132:11" />Adügati Aburemei aban áfiñuruni deregüdati lun Dawidi,</para>
  <para style="q" vid="PSA 132:11">aban áfiñuruni le lunbei lagunfulirubei lan:<verse eid="PSA 132:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 132:12" />«Nañuuragüdüba aban hádangiñe badügawagun</para>
  <para style="q" vid="PSA 132:12">luagu lálana barúeihan,</para>
  <para style="q" vid="PSA 132:12">ánhaña agunfulira birahüñü lau nidaradun,</para>
  <para style="q" vid="PSA 132:12">luma lau gumadi le lunbei narufudahani houn,</para>
  <para style="q" vid="PSA 132:12">hañuuruba giñe hasaanigu</para>
  <para style="q" vid="PSA 132:12">luagu lálana barúeihan lun súnwandan».<verse eid="PSA 132:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 132:13" />Anúadira laali Aburemei wübü Sión!</para>
  <para style="q" vid="PSA 132:13">Anúadira laali lun laganóun ñein!<verse eid="PSA 132:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 132:14" />Anihán wübü le ñein lubéi nabusenra nerederun súnwandan,</para>
  <para style="q" vid="PSA 132:14">ñeinba naganóua, ladüga ítara liña nabusenruni.<verse eid="PSA 132:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 132:15" />Nabinirubei éigini le ñeinbei saragu,</para>
  <para style="q" vid="PSA 132:15">nagidarubei halama gudemetiña ha ñéinbaña.<verse eid="PSA 132:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 132:16" />Nadaüraguagüdübaña lufadirinigu lau esefuruni,</para>
  <para style="q" vid="PSA 132:16">nagúaraguagüdübaña ha gúnfulibaña luma lau ugundani.<verse eid="PSA 132:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 132:17" />Neseridaguagüdübei lubafu Dawidi ñein;</para>
  <para style="q" vid="PSA 132:17">aransedina aban igemeri lun urúei le nanúadirubei.<verse eid="PSA 132:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 132:18" />Nabuinchagüdübaña láganiñu lau busiganu,</para>
  <para style="q" vid="PSA 132:18">ánheinti ligía, nadouragubei lau arugoungani.<verse eid="PSA 132:18" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" sid="PSA 133" />
  <para style="s1">Óundaruni luma darangilaü</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 133:1" />Ariha humá ida liña lan lubuidun</para>
  <para style="q" vid="PSA 133:1">lun haganóun íbirigu lidan aban hámagua!<verse eid="PSA 133:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 133:2" />Ítara liña kei líhemen ibiñein buiti</para>
  <para style="q" vid="PSA 133:2">le áwiyurubei hábulugugiñe fádirigu,</para>
  <para style="q" vid="PSA 133:2">ararireina ligía luéigiñe hádiuma</para>
  <para style="q" vid="PSA 133:2">darí luagun tigiina hadaüragun.<verse eid="PSA 133:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 133:3" />Ítara liña kei liserenun wübü Erümón,</para>
  <para style="q" vid="PSA 133:3">le ábürühabei luagun burí luwübüri Sión.</para>
  <para style="q" vid="PSA 133:3">Ladüga lidoun wübü Sión lóunahei Aburemei abiniruni</para>
  <para style="q" vid="PSA 133:3">le lánina aban ibagari magumuchaditi.<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" sid="PSA 134" />
  <para style="s1">Binilabu Aburemei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 134:1" />Lubúeingu Aburemei,</para>
  <para style="q" vid="PSA 134:1">alawaha huméi Bungiu sun huguya,</para>
  <para style="q" vid="PSA 134:1">le erederubei áriebu tidan litenpulun!<verse eid="PSA 134:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 134:2" />Iñura huméi húhabu tuagun lisanduariun,</para>
  <para style="q" vid="PSA 134:2">alawaha humeime Aburemei!<verse eid="PSA 134:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 134:3" />Binilabu Aburemei,</para>
  <para style="q" vid="PSA 134:3">le adügübalin sielu luma múa,</para>
  <para style="q" vid="PSA 134:3">lúmagiñe Sióngiñe!<verse eid="PSA 134:3" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" sid="PSA 135" />
  <para style="s1">Katei burí wéinamuti le ladügübei Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 135:1" />Alawaha huméi Aburemei!</para>
  <para style="q" vid="PSA 135:1">Alawaha huméi liri Aburemei,</para>
  <para style="q" vid="PSA 135:1">alawaha huméi huguya le lubúeingu,<verse eid="PSA 135:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 135:2" />ha tídanbaña luban Aburemei,</para>
  <para style="q" vid="PSA 135:2">lidan tibürürün luban Wabungiute.<verse eid="PSA 135:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 135:3" />Alawaha huméi Bungiu, ladüga buiti;</para>
  <para style="q" vid="PSA 135:3">eremuha humá uremu lun liri ladüga areidati.<verse eid="PSA 135:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 135:4" />Ladüga anúadira lumuti Hakobu lun lánime,</para>
  <para style="q" vid="PSA 135:4">anúadira lumuti Ísüraeli lun ligíaba lan lirisin.<verse eid="PSA 135:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 135:5" />Subudi numuti buidu luagu weiri lan Wabungiute</para>
  <para style="q" vid="PSA 135:5">hawéi sun búngiugu.<verse eid="PSA 135:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 135:6" />Adüga lumuti Aburemei sun le labusenrun</para>
  <para style="q" vid="PSA 135:6">dandu sielu kei ubouagu,</para>
  <para style="q" vid="PSA 135:6">dandu baranaha kei lábugiñe barana.<verse eid="PSA 135:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 135:7" />Iñuraguati Bungiu dúeri luéigiñe lébeha ubóu,</para>
  <para style="q" vid="PSA 135:7">aranseti wayuhuru lubá luriban dan,</para>
  <para style="q" vid="PSA 135:7">ani furigüdati garabali lídangiñe lagei.<verse eid="PSA 135:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 135:8" />Ligía áfaragubaliña ígiramaü</para>
  <para style="q" vid="PSA 135:8">hadan kada tílana muna Ehiptuna</para>
  <para style="q" vid="PSA 135:8">hama furumiñetiña harahüñü animaalugu.<verse eid="PSA 135:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 135:9" />Óunaha lumuti liseinin lamidangua uburugu Ehiptu,</para>
  <para style="q" vid="PSA 135:9">luagun urúei Ehiptuna hama lánigu.<verse eid="PSA 135:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 135:10" />Áfarati saragu néchanigu,</para>
  <para style="q" vid="PSA 135:10">ani gidalei habagari urúeigu gabafutiña.<verse eid="PSA 135:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 135:11" />Sihón le urúei Amoruna;</para>
  <para style="q" vid="PSA 135:11">Ogu, lurúeite Basán,</para>
  <para style="q" vid="PSA 135:11">hama sun urúeigu Kanán;<verse eid="PSA 135:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 135:12" />aba líchuguni burí hamúan urúeigu hagía</para>
  <para style="q" vid="PSA 135:12">houn Ísüraelina ha lánigu, kei halagante.<verse eid="PSA 135:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 135:13" />Aburemei, magumuchaditi biri;</para>
  <para style="q" vid="PSA 135:13">laritawaguba buagun súnwandan.<verse eid="PSA 135:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 135:14" />Adügati Aburemei irichaü houn lumutuniña;</para>
  <para style="q" vid="PSA 135:14">gudemehabuti houn eseriwidutiña lun.<verse eid="PSA 135:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 135:15" />Golu luma pülata haguariuanbei gibe tubungiutegu,</para>
  <para style="q" vid="PSA 135:15">katei burí le hadüga gürigia lau háhabu.<verse eid="PSA 135:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 135:16" />Gayumatiña, gama lumoun siñati hadimurehan;</para>
  <para style="q" vid="PSA 135:16">gágutiña, gama lumoun siñati harihin;<verse eid="PSA 135:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 135:17" />garigeirugutiña, gama lumoun siñati haganbun;</para>
  <para style="q" vid="PSA 135:17">mabagarigubeitiña!<verse eid="PSA 135:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 135:18" />Ítara kei guáriua hagía,</para>
  <para style="q" vid="PSA 135:18">ítara haña giñe ha adügübaliña</para>
  <para style="q" vid="PSA 135:18">hama ha afiñerubaña hawagu.<verse eid="PSA 135:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 135:19" />Ísüraelina, alawaha huméi Aburemei,</para>
  <para style="q" vid="PSA 135:19">fádirigu, alawaha huméi Aburemei;<verse eid="PSA 135:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 135:20" />Lewitagu, alawaha huméi Aburemei,</para>
  <para style="q" vid="PSA 135:20">huguya le hínsiñehabubei lun Aburemei, alawaha huméi.<verse eid="PSA 135:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 135:21" />Alawahoualá Aburemei,</para>
  <para style="q" vid="PSA 135:21">le aganóubei Herusalén, yágüta Sión!</para>
  <para style="b" vid="PSA 135:21" />
  <para style="q" vid="PSA 135:21">Alawaha huméi Aburemei!<verse eid="PSA 135:21" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" sid="PSA 136" />
  <para style="s1">Uremu lánina seremei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 136:1" />Ru humá seremei lun Aburemei ladüga buiti,</para>
  <para style="q" vid="PSA 136:1">magumuchaditi línsiñehabu.<verse eid="PSA 136:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 136:2" />Seremei huméi Habungiute búngiugu</para>
  <para style="q" vid="PSA 136:2">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 136:3" />Seremei huméi Habureme aburemeigu,</para>
  <para style="q" vid="PSA 136:3">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 136:4" />Lun le ligíarügüñeibei adüga katei wéiriguti,</para>
  <para style="q" vid="PSA 136:4">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 136:5" />Lun le adügübalin sielu lau lichú aau,</para>
  <para style="q" vid="PSA 136:5">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 136:6" />Lun le átulerubalin múa ligibuagu duna,</para>
  <para style="q" vid="PSA 136:6">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 136:7" />Lun le adügübalin weyu luma hati,</para>
  <para style="q" vid="PSA 136:7">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 136:8" />Weyu lun líchugun larugounga wéyuagu,</para>
  <para style="q" vid="PSA 136:8">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 136:9" />Hati hama waruguma, lun híchugun larugounga áriebu,</para>
  <para style="q" vid="PSA 136:9">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 136:10" />Lun le áfaragubaliña hágiramagu</para>
  <para style="q" vid="PSA 136:10">sun tílana muna Ehiptuna,</para>
  <para style="q" vid="PSA 136:10">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 136:11" />Lun le asagarubaliña Ísüraelina Ehiptugiñe,</para>
  <para style="q" vid="PSA 136:11">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 136:12" />Iñura lumuti larüna lau óunwenbu ubafu,</para>
  <para style="q" vid="PSA 136:12">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 136:13" />Lun le adaaragubalin Barana Funati,</para>
  <para style="q" vid="PSA 136:13">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 136:14" />Lun le ásügüragüdübaliña Ísüraelina lamidanguagiñe barana,</para>
  <para style="q" vid="PSA 136:14">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 136:15" />Lun le añaradaguagüdübalin urúei Ehiptuna hau sun</para>
  <para style="q" vid="PSA 136:15">lisudaranigu lidan Barana Funati,</para>
  <para style="q" vid="PSA 136:15">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 136:16" />Lun le anügübaliña lánigu luéigiñe fulasu mageirawati,</para>
  <para style="q" vid="PSA 136:16">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 136:17" />Lun le áfaragubaliña urúeigu wéinamutiña,</para>
  <para style="q" vid="PSA 136:17">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 136:18" />Lun le agidarubalin habagari urúeigu gabafutiña,</para>
  <para style="q" vid="PSA 136:18">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 136:19" />Gidá lumuti libagari Sihón, le harúeite Amoruna,</para>
  <para style="q" vid="PSA 136:19">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 136:20" />Luma Ogu le lurúeite Basán,</para>
  <para style="q" vid="PSA 136:20">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 136:21" />Lun le afanreinhabalin hamúan urúeigu hagía,</para>
  <para style="q" vid="PSA 136:21">ladüga magumuchaditi línsiñehabu,<verse eid="PSA 136:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 136:22" />aba líchuguni kei alagan houn Ísüraelina ha lubúeingu,</para>
  <para style="q" vid="PSA 136:22">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 136:23" />Lun le aritagubei wawagun dan le méreediwa,</para>
  <para style="q" vid="PSA 136:23">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 136:24" />Lun le esefurubaliwa hawéi wáganiñu,</para>
  <para style="q" vid="PSA 136:24">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 136:25" />Lun le éigagüdübei gürigia hóugüda animaalu,</para>
  <para style="q" vid="PSA 136:25">ladüga magumuchaditi línsiñehabu.<verse eid="PSA 136:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 136:26" />Ru humá seremei lun Bungiu le siélubei,</para>
  <para style="q" vid="PSA 136:26">ladüga magumuchaditi línsiñehabu!<verse eid="PSA 136:26" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" sid="PSA 137" />
  <para style="s1">Laru lidunari Babilónia</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 137:1" />Dan le meha ñun wamá laru duna Babilónia,</para>
  <para style="q" vid="PSA 137:1">ayahuatiwa dan le waritagun luagun Sión.<verse eid="PSA 137:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 137:2" />Dahí wamutu wani árüpa</para>
  <para style="q" vid="PSA 137:2">luagu burí tídibu wewe to ñeinboun uburugu.<verse eid="PSA 137:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 137:3" />Ha anügübaliwa keisi adaürǘtiña,</para>
  <para style="q" vid="PSA 137:3">ha anügübalin sun wámati wawéi,</para>
  <para style="q" vid="PSA 137:3">amuriahatiña meha wama lun weremuhan lau ugundani;</para>
  <para style="q" vid="PSA 137:3">lun weremuhan leremuna Sión houn!<verse eid="PSA 137:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 137:4" />Ida lubagia weremuhan leremun Aburemei</para>
  <para style="q" vid="PSA 137:4">lidan fulasu terencha?<verse eid="PSA 137:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 137:5" />Ánhabu nabulieida, Herusalén,</para>
  <para style="q" vid="PSA 137:5">saüla núhabu le nóunwenren!<verse eid="PSA 137:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 137:6" />Badületá niñeñe luagu nisielun</para>
  <para style="q" vid="PSA 137:6">ánhana maritagun buagun;</para>
  <para style="q" vid="PSA 137:6">anhein míchugun nan Herusalén lóugiñe nugundan guánarügü!<verse eid="PSA 137:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 137:7" />Aburemei, haritaguabá hawagun Edomuna,</para>
  <para style="q" vid="PSA 137:7">ha ariñagubaña dan le lábürühanbei Herusalén:</para>
  <para style="q" vid="PSA 137:7">«Günringua huméi, günringua huméi darí lumoun lebu!»<verse eid="PSA 137:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 137:8" />Buguya, Babilónia, bagünrinchawaguba!</para>
  <para style="q" vid="PSA 137:8">Fuleseiwatiña ha lúnbaña hafayeiragüdünibu</para>
  <para style="q" vid="PSA 137:8">luagu bidurun, luagu le badügübei woun!<verse eid="PSA 137:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 137:9" />Fuleseiwatiña ha árügüdütiña birahüñü</para>
  <para style="q" vid="PSA 137:9">lun hachüüraguniña luagun dübü!<verse eid="PSA 137:9" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" sid="PSA 138" />
  <para style="s1">Afurieiduni lánina seremei lun Aburemei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 138:1" />Neteingirubadibu tau sun nanigi, Nabureme;</para>
  <para style="q" vid="PSA 138:1">neremuhaba uremu bun hagibugiñe búngiugu.<verse eid="PSA 138:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 138:2" />Náhuduraguba lau nigibu tuagun buban to sánduboun,</para>
  <para style="q" vid="PSA 138:2">lun neteingirunibu luagu bínsiñehabu luma binarün,</para>
  <para style="q" vid="PSA 138:2">ladüga ru baali biri luma bererun lóugiñe sun katei.<verse eid="PSA 138:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 138:3" />Dan le nagúarunbei bun, óunaba bumutina,</para>
  <para style="q" vid="PSA 138:3">aba bíchugun lanwoun nere.<verse eid="PSA 138:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 138:4" />Sun urúeigu ubouaguna,</para>
  <para style="q" vid="PSA 138:4">halawahabadibu danme haganbuni le füramase bubéi.<verse eid="PSA 138:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 138:5" />Halawahabei Aburemei luagu le lariñagubei,</para>
  <para style="q" vid="PSA 138:5">ladüga wéiriti luéirigun Aburemei.<verse eid="PSA 138:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 138:6" />Lau sun íñuñein lan Aburemei,</para>
  <para style="q" vid="PSA 138:6">arihati hawagun gürigia ha gudemebaña,</para>
  <para style="q" vid="PSA 138:6">ani dísegiñe subudi lumutiña giñe ha pántabaña.<verse eid="PSA 138:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 138:7" />Dan le nadariragun nungua lidan denchaü,</para>
  <para style="q" vid="PSA 138:7">rútibu ibagari nun;</para>
  <para style="q" vid="PSA 138:7">sagá bumuti bubafu aba besefurunina</para>
  <para style="q" vid="PSA 138:7">luéi hagañi náganiñu.<verse eid="PSA 138:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 138:8" />Lagumuchubei Nabureme le ladügübei</para>
  <para style="q" vid="PSA 138:8">luagu nufulesein lau lubuidun!</para>
  <para style="q" vid="PSA 138:8">Bungiu, magumuchaditi bínsiñehabu;</para>
  <para style="q" vid="PSA 138:8">mígirabei wadagimanu le gumese báalibei magumuga!<verse eid="PSA 138:8" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" sid="PSA 139" />
  <para style="s1">Subudi lumuti Bungiu sun katei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 139:1" />Nabureme, ariha báadina buidu</para>
  <para style="q" vid="PSA 139:1">ani subudi bumutina;<verse eid="PSA 139:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 139:2" />subudi bumuti sun namufurun;</para>
  <para style="q" vid="PSA 139:2">íbini dísegiñe,</para>
  <para style="q" vid="PSA 139:2">gefentibu luagu le nasaminarubei.<verse eid="PSA 139:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 139:3" />Subudi bumuti sun némeri,</para>
  <para style="q" vid="PSA 139:3">subudi bumuti sun le nadügübei!<verse eid="PSA 139:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 139:4" />Úagi yebe dimurei tuagu niñeñe,</para>
  <para style="q" vid="PSA 139:4">ani subudi baali, Nabureme.<verse eid="PSA 139:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 139:5" />Geyegua báadina luéigiñe sun oubaü;</para>
  <para style="q" vid="PSA 139:5">ani góunigibana lau bubafu.<verse eid="PSA 139:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 139:6" />Díseti lueirin lichú bau nuéi;</para>
  <para style="q" vid="PSA 139:6">wéiriti liñun, darí lun siñá nani gunfuranda!<verse eid="PSA 139:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 139:7" />Haliñounba hamuga san gayara lan nidin</para>
  <para style="q" vid="PSA 139:7">dise luéi bani sífiri?</para>
  <para style="q" vid="PSA 139:7">Haliñounba hamuga san nanuraha dise luéi barihin?<verse eid="PSA 139:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 139:8" />Ánhana amudeira iñun sielun, abunhein ñein;</para>
  <para style="q" vid="PSA 139:8">ánhana ararira lábugiñoun múa, abunhein giñe ñein;<verse eid="PSA 139:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 139:9" />ánhana hamuga áhamara luagun labouchagüle weyu,</para>
  <para style="q" vid="PSA 139:9">odi ánhana lan aganóua lidan lébeha barana</para>
  <para style="q" vid="PSA 139:9">le ñeinhin lubéi lálüda weyu,<verse eid="PSA 139:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 139:10" />íbini ñein ladundehañadina hamuga búhabu;</para>
  <para style="q" vid="PSA 139:10">íbini ñein lágüdahañadina hamuga búhabu le bóunwenren!<verse eid="PSA 139:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 139:11" />Ánhanadügü hamuga aritagua naramudagun lidan luburiga,</para>
  <para style="q" vid="PSA 139:11">odi aba hamuga lasaliragun larugounga le geyegubei nau luburigame,<verse eid="PSA 139:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 139:12" />maramudun lubadina yebe luburiga buéi;</para>
  <para style="q" vid="PSA 139:12">harugoungati hamuga áriebu kei larugounga wéyuagu;</para>
  <para style="q" vid="PSA 139:12">ligiaméme luburiga bun kei larugounga!<verse eid="PSA 139:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 139:13" />Buguya adügübalin sun núgubu;</para>
  <para style="q" vid="PSA 139:13">buguya adügübalina turageirugu núguchu.<verse eid="PSA 139:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 139:14" />Alawaha numutibu, ladüga wéiritu nanigi,</para>
  <para style="q" vid="PSA 139:14">ladüga wéiriguti katei le badügübei.</para>
  <para style="q" vid="PSA 139:14">Chouru numuti lira!<verse eid="PSA 139:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 139:15" />Maramudagunti lafaragadagun núgubu buéi</para>
  <para style="q" vid="PSA 139:15">sun meha nadügǘnbei aramudaguarügü,</para>
  <para style="q" vid="PSA 139:15">sun meha nadügǘnbei lidan lilulin-agei múa.<verse eid="PSA 139:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 139:16" />Ariha lumuti bagu ladügǘn núgubu;</para>
  <para style="q" vid="PSA 139:16">bürüwañu liña meha sun le tidan biliburun.</para>
  <para style="q" vid="PSA 139:16">Arufuda baali meha átiribei lan dan nabagaridun</para>
  <para style="q" vid="PSA 139:16">dan meha le miábingubeigidina ubouagun.<verse eid="PSA 139:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 139:17" />Bungiu, huliliti bisaminan nun;</para>
  <para style="q" vid="PSA 139:17">mébehati súngubei!<verse eid="PSA 139:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 139:18" />Ánhana hamuga abusenra nabahüdüni,</para>
  <para style="q" vid="PSA 139:18">gíbeti hamuga sügǘ lau sagoun;</para>
  <para style="q" vid="PSA 139:18">ani ánheindügü hamuga ásura nabahüdüni,</para>
  <para style="q" vid="PSA 139:18">anahamémegua hamuga buma.<verse eid="PSA 139:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 139:19" />Bungiu,</para>
  <para style="q" vid="PSA 139:19">gidabei habagari wuribatiña,</para>
  <para style="q" vid="PSA 139:19">dísegüdabaña gáfarahatiña nuéi,<verse eid="PSA 139:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 139:20" />ha adimurehabaña wuriba buagu,</para>
  <para style="q" vid="PSA 139:20">iñuragua hagía houngua buagun.<verse eid="PSA 139:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 139:21" />Nabureme,</para>
  <para style="q" vid="PSA 139:21">ma funagia iyereegutiña ha iyereehabúbaña bun nun,</para>
  <para style="q" vid="PSA 139:21">mínsiñe ha iñuragubaña houngua buagun nun?<verse eid="PSA 139:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 139:22" />Iyereegutiña nun tau sun nuani!</para>
  <para style="q" vid="PSA 139:22">Barǘ numutiña kei náganiñu!<verse eid="PSA 139:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 139:23" />Bungiu, arihabána, arihabóun nanigi;</para>
  <para style="q" vid="PSA 139:23">hóuchaguabana, subudibéi nisaminan;<verse eid="PSA 139:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 139:24" />arihabá anhein luáguñadina lubéi lémeri wuribani,</para>
  <para style="q" vid="PSA 139:24">alidihabana luéigiñe üma magumuchaditi.<verse eid="PSA 139:24" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" sid="PSA 140" />
  <para style="s1">Afurieiduni amuriahei lóunigihan Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 140:1" />Nabureme, sefubána hawéi salufuritiña,</para>
  <para style="q" vid="PSA 140:1">gama lumoun góunigitimabana hawéi gürigia hanarimetiña,<verse eid="PSA 140:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 140:2" />hawéi ha aritagubaña wuribani,</para>
  <para style="q" vid="PSA 140:2">agubuha hagía wuribu súnwandan.<verse eid="PSA 140:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 140:3" />Gágiritu hañeñe kei tiñeñe hewe;</para>
  <para style="q" vid="PSA 140:3">ítara liña burí hererun kei tupeisinin hewe.<verse eid="PSA 140:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 140:4" />Nabureme, góunigibana luéi habafu wuribatiña,</para>
  <para style="q" vid="PSA 140:4">gama lumoun góunigitimabana hawéi gürigia hanarimetiña,</para>
  <para style="q" vid="PSA 140:4">hawéi ha aransehabaña lun héiguadagüdünina.<verse eid="PSA 140:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 140:5" />Sétihaña pántatiña hagía sádara nubá;</para>
  <para style="q" vid="PSA 140:5">rúhaña seni luma gúrudu nubá;</para>
  <para style="q" vid="PSA 140:5">rúhaña sádara nubá laru üma.<verse eid="PSA 140:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 140:6" />Ariñagaadina lun Nabureme:</para>
  <para style="q" vid="PSA 140:6">«Nubungiute buguya;</para>
  <para style="q" vid="PSA 140:6">aganbabéi lubeiti, nagúaragun ayumuragua!<verse eid="PSA 140:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 140:7" />Nabureme, Nabureme, nesefuragüle gabafuti,</para>
  <para style="q" vid="PSA 140:7">góunigi bumutina wuriburugu».<verse eid="PSA 140:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8-9" style="v" sid="PSA 140:8-9" />Nabureme, míchigabei layumahan salufuriti lun;</para>
  <para style="q" vid="PSA 140:8-9">mígiraba lun lawanserun laransehan.</para>
  <para style="q" vid="PSA 140:8-9">Mígiraba lun hagañeiruba lan náganiñu,</para>
  <para style="q" vid="PSA 140:8-9">adügabá lun lábürühan híñaragun guánarügü hawagun!<verse eid="PSA 140:8-9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 140:10" />Ábürühala garubun gemeti hawagun;</para>
  <para style="q" vid="PSA 140:10">fui hamaña lidoun fusu</para>
  <para style="q" vid="PSA 140:10">le ñéingiñe lubéi máfuridundigiaaña lan.<verse eid="PSA 140:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 140:11" />Merederalá le wíyebei ererun ubouagu;</para>
  <para style="q" vid="PSA 140:11">éibaahalei wuribani le hanarimebei lun lagünrinchaguni.<verse eid="PSA 140:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 140:12" />Subudi numuti luagu adüga lan Aburemei</para>
  <para style="q" vid="PSA 140:12">irichaü houn gudemetiña</para>
  <para style="q" vid="PSA 140:12">abuyeiha ligía luagu le yuubei houn ha nidiheribaña.<verse eid="PSA 140:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 140:13" />Halawahabei gürigia harumatiña biri;</para>
  <para style="q" vid="PSA 140:13">haganóuba gürigia úaraguatiña biñuarü!<verse eid="PSA 140:13" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" sid="PSA 141" />
  <para style="s1">Buágurügüñein níchigei narihin</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 141:1" />Agúahatina bun, Nabureme higabu furese!</para>
  <para style="q" vid="PSA 141:1">Aganbabéi numalali dan nagúahanibu!<verse eid="PSA 141:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 141:2" />Ítarala nafurieidun kei kupali bigibugiñe,</para>
  <para style="q" vid="PSA 141:2">ítara ligíame núhabu iñurañu,</para>
  <para style="q" vid="PSA 141:2">kei idewesei le lánina rábounweyu.<verse eid="PSA 141:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 141:3" />Nabureme, ruba aban óunigiruti luagu niyuma,</para>
  <para style="q" vid="PSA 141:3">góunigibana danme le náwagachun.<verse eid="PSA 141:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 141:4" />Dísegüdabei nisaminan luéi wuribani,</para>
  <para style="q" vid="PSA 141:4">mígirabana lun néibugun lidan katei wuribati,</para>
  <para style="q" vid="PSA 141:4">ni lun neigin hama adügütiña wuribani.<verse eid="PSA 141:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 141:5" />Aban fulesei labeichunina aban gürigia harumati,</para>
  <para style="q" vid="PSA 141:5">ibiñein fínuti lererehan.</para>
  <para style="q" vid="PSA 141:5">Mamahanbadina lun libe burí katei ligia;</para>
  <para style="q" vid="PSA 141:5">lau sun lagayuahan nuagu, nafurieidamemeba.<verse eid="PSA 141:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 141:6" />Hachagarúba hábutigu wuribatiña,</para>
  <para style="q" vid="PSA 141:6">harihubeiti luagu inarüni lan buga nererun.<verse eid="PSA 141:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 141:7" />Ítara kei labouhóuniwa watu,</para>
  <para style="q" vid="PSA 141:7">ítara luba lachagarawagun habu lubadu umúahaü.<verse eid="PSA 141:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 141:8" />Nabureme, Nabureme, buagu níchigei narihin;</para>
  <para style="q" vid="PSA 141:8">buma náluaha nóunigiruniwa, mágurabana.<verse eid="PSA 141:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 141:9" />Sefubána tuéi sádara to esetirúboun nubá;</para>
  <para style="q" vid="PSA 141:9">sefubána tuéi hasadaran wuribatiña.<verse eid="PSA 141:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 141:10" />Ábürüha hamá wuribatiña tidoun hasadaran guánarügü</para>
  <para style="q" vid="PSA 141:10">sunme anaha lan ñüdün nubaruaguóun.<verse eid="PSA 141:10" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" sid="PSA 142" />
  <para style="s1">Buguya naramudaguagülebei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 142:1" />Agúahatina luagu Nabureme lau umalali héreti</para>
  <para style="q" vid="PSA 142:1">amuriaha numuti lugudemehabu lau umalali reinti.<verse eid="PSA 142:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 142:2" />Ru numuti nufuledein ligibugiñe,</para>
  <para style="q" vid="PSA 142:2">subudigüda numuti nidiheri liñúarü,<verse eid="PSA 142:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 142:3" />dan le nasandiragun nungua lau maguraasuni.</para>
  <para style="b" vid="PSA 142:3" />
  <para style="q" vid="PSA 142:3">Nabureme, subudi bumuti némeri:</para>
  <para style="q" vid="PSA 142:3">Lidan üma le uéigiñebei nidin,</para>
  <para style="q" vid="PSA 142:3">rúhaña aban sádara nubá.<verse eid="PSA 142:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 142:4" />Digiguatina luagun nóunwenren,</para>
  <para style="q" vid="PSA 142:4">ani úati ñǘbuinti íderaguana.</para>
  <para style="q" vid="PSA 142:4">Úati ni aban lun númagiñe lan!</para>
  <para style="q" vid="PSA 142:4">Úati ni aban bereseti nau!<verse eid="PSA 142:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 142:5" />Bun nagúaha, Nabureme, nariñaga bun:</para>
  <para style="q" vid="PSA 142:5">«Buguya naramudaguagülebei;</para>
  <para style="q" vid="PSA 142:5">buguya sun le númabei lidan ibagari le».<verse eid="PSA 142:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 142:6" />Tenibá lun nagúarahan</para>
  <para style="q" vid="PSA 142:6">ladüga débiliti nasandiragun nungua.</para>
  <para style="q" vid="PSA 142:6">Sefubána hawéi ha éibaahabalina</para>
  <para style="q" vid="PSA 142:6">ladüga héretiña nuéi.<verse eid="PSA 142:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 142:7" />Sagabana tídangiñe nufurisun</para>
  <para style="q" vid="PSA 142:7">lun gayara lan neremuhan bun.</para>
  <para style="q" vid="PSA 142:7">Hageyedaguba gürigia harumatiña nau</para>
  <para style="q" vid="PSA 142:7">danme le óusera báadina buidu.<verse eid="PSA 142:7" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" sid="PSA 143" />
  <para style="s1">Buagu níchigei nafiñen</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 143:1" />Nabureme, aganbabéi nafurieidun;</para>
  <para style="q" vid="PSA 143:1">tenibá lun nayumuragun.</para>
  <para style="q" vid="PSA 143:1">Óunababana, ladüga richatibu ani gúnfulitibu!<verse eid="PSA 143:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 143:2" />Mabahüdabei nifigoun,</para>
  <para style="q" vid="PSA 143:2">úati madurunti bigibugiñe.<verse eid="PSA 143:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 143:3" />Éibaaha hamutina náganiñu,</para>
  <para style="q" vid="PSA 143:3">buregua hamaadina múarugu</para>
  <para style="q" vid="PSA 143:3">fosu hamutina lun naganóun lidan luburiga</para>
  <para style="q" vid="PSA 143:3">kei ha hilaguaañabaña lúmagiñe binarü.<verse eid="PSA 143:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 143:4" />Sandiguatina nungua lau óunwenbu maguraasuni,</para>
  <para style="q" vid="PSA 143:4">ani ragüla márügüdaguni unguaü nanigi.<verse eid="PSA 143:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 143:5" />Haritaguatina luagun meha binadu dan,</para>
  <para style="q" vid="PSA 143:5">ani saminatina luagun sun le adüga báalibei.<verse eid="PSA 143:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 143:6" />Bun nátulerei núhabu,</para>
  <para style="q" vid="PSA 143:6">lau mágürabu bun, kei múa mábeiti.<verse eid="PSA 143:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 143:7" />Nabureme, óunababana furese,</para>
  <para style="q" vid="PSA 143:7">ladüga agumuchagueina liña nuguraasun!</para>
  <para style="q" vid="PSA 143:7">Mamaharabá bíderagunina,</para>
  <para style="q" vid="PSA 143:7">ladüga nítaraduba kei hilaaña.<verse eid="PSA 143:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 143:8" />Subudigüdabana libügürü bínsiñehabu binaafin,</para>
  <para style="q" vid="PSA 143:8">ladüga ru naali nemenigin buagun.</para>
  <para style="q" vid="PSA 143:8">Subudigüdabei nun ida luba lan nóuserun,</para>
  <para style="q" vid="PSA 143:8">ladüga buma nálugei le nayumahabei.<verse eid="PSA 143:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 143:9" />Sefubána hawéi náganiñu, Nabureme,</para>
  <para style="q" vid="PSA 143:9">ladüga bóubawagu náluaha naramudagun.<verse eid="PSA 143:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 143:10" />Arufudahabá nun lun nadügüni bugundan,</para>
  <para style="q" vid="PSA 143:10">ladüga buguya Nubungiutebei.</para>
  <para style="q" vid="PSA 143:10">Barülana bani Sífiri le buídubei</para>
  <para style="q" vid="PSA 143:10">luéigiñe aban üma suruti!<verse eid="PSA 143:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 143:11" />Luagu biri, Nabureme, gabagarigüdabana!</para>
  <para style="q" vid="PSA 143:11">Ladüga richatibu, sagabana lídangiñe idiheri!<verse eid="PSA 143:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 143:12" />Ladüga bigunfulin, günringuabaña náganiñu!</para>
  <para style="q" vid="PSA 143:12">Günringuabaña sun náganiñu,</para>
  <para style="q" vid="PSA 143:12">ladüga bubuein au!<verse eid="PSA 143:12" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" sid="PSA 144" />
  <para style="s1">Leteingiruni aban urúei Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 144:1" />Alawahoualá Aburemei, le óunigirubalina!</para>
  <para style="q" vid="PSA 144:1">Ligía aranserubalina lun nageindagun wuriburugu;<verse eid="PSA 144:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 144:2" />ligía numadabei le gúnfulibei,</para>
  <para style="q" vid="PSA 144:2">ligía óunigirubalina,</para>
  <para style="q" vid="PSA 144:2">ligía liñun-ágeibei naramudaguagüle,</para>
  <para style="q" vid="PSA 144:2">ligía nesefuragülebei;</para>
  <para style="q" vid="PSA 144:2">ligía nidaüdinabei le lauti gürabu,</para>
  <para style="q" vid="PSA 144:2">lau nadouragua naugua;</para>
  <para style="q" vid="PSA 144:2">ligía íchugubaliña lílana fulasu lábugiñoun nugumadin.<verse eid="PSA 144:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 144:3" />Aburemei,</para>
  <para style="q" vid="PSA 144:3">Kátañanu san wügüriña, basaminarunbei hawagun?</para>
  <para style="q" vid="PSA 144:3">Kátañanu san gürigia, lanarimebei hínsiñe bun?<verse eid="PSA 144:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 144:4" />Ítara haña gürigia kei aban awaraguni;</para>
  <para style="q" vid="PSA 144:4">ítara liña habagari kei lásügürün lamuñounga.<verse eid="PSA 144:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 144:5" />Aburemei, daraguabei sielu, rariba,</para>
  <para style="q" vid="PSA 144:5">guruba luagu burí wübü lun lígiragüdün gumuleli;<verse eid="PSA 144:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 144:6" />chüboun bigimaran to labirihaniga,</para>
  <para style="q" vid="PSA 144:6">ani anuraagüdabaña báganiñu lau chagaguaü.<verse eid="PSA 144:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 144:7" />Tulebei búhabu lúmagiñe íñugiñe,</para>
  <para style="q" vid="PSA 144:7">sefubána luéi lueirin barana;</para>
  <para style="q" vid="PSA 144:7">sefubána luéi habafu gürigia terencha,<verse eid="PSA 144:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 144:8" />hawéi ha ariñagubaña iyeeni</para>
  <para style="q" vid="PSA 144:8">iñura haméi hóunwenren lun háfiñurun marasualugu.<verse eid="PSA 144:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 144:9" />Nabureme,</para>
  <para style="q" vid="PSA 144:9">neremuhaba aban iseri uremu bun;</para>
  <para style="q" vid="PSA 144:9">neremuhaba uremu bun tau sun tuwuyeri árüpa.<verse eid="PSA 144:9" /></para>
  <para style="q">
    <verse number="10-11" style="v" sid="PSA 144:10-11" />Buguya, le agañeiragüdübaliña urúeigu,</para>
  <para style="q" vid="PSA 144:10-11">buguya, le esefurubalin Dawidi,</para>
  <para style="q" vid="PSA 144:10-11">sefubána tuéi eféin gáfarahatu;</para>
  <para style="q" vid="PSA 144:10-11">sefubána luéi habafu gürigia terencha,</para>
  <para style="q" vid="PSA 144:10-11">hawéi ha ariñagubaña iyeeni</para>
  <para style="q" vid="PSA 144:10-11">iñura haméi hóunwenren lun háfiñurun marasualugu.<verse eid="PSA 144:10-11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 144:12" />Wéinamutiña warahüñü kei nadü lidan fuluri-agei;</para>
  <para style="q" vid="PSA 144:12">ítara haña warahüñü würiña kei wagabu,</para>
  <para style="q" vid="PSA 144:12">le ágüdahabalin túgubu luban Bungiu.<verse eid="PSA 144:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 144:13" />Buin liña burí lagei ilaü,</para>
  <para style="q" vid="PSA 144:13">buin liña lau sun luwuyeri éigini.</para>
  <para style="q" vid="PSA 144:13">Gánwounguatiña wabiñanigu saragu,</para>
  <para style="q" vid="PSA 144:13">milu míluñanu wacharirugu.<verse eid="PSA 144:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 144:14" />Dageinatiña walügüniña bágasu,</para>
  <para style="q" vid="PSA 144:14">ani mameilihantiña lubaragiñe hadaani.</para>
  <para style="q" vid="PSA 144:14">Úati agúaraguni lánina idiheri lidan burí wémeri.<verse eid="PSA 144:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 144:15" />Fuleseiwatiña lílana fulasu ha abagaridubaña ítara!</para>
  <para style="q" vid="PSA 144:15">Fuleseiwatiña lílana fulasu ha Búngiubei Habungiute!<verse eid="PSA 144:15" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" sid="PSA 145" />
  <para style="s1">Sun gürigia alawaha haméi Aburemei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 145:1" />Nadimurehaba luagu buéirigun, Nubungiute Nurúeite</para>
  <para style="q" vid="PSA 145:1">nalawahabei biri lun súnwandan.<verse eid="PSA 145:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 145:2" />Seremei nubadibu sagü weyu;</para>
  <para style="q" vid="PSA 145:2">nalawahabei biri lun súnwandan.<verse eid="PSA 145:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 145:3" />Wéiriguti Aburemei ani gadünati lun lalawahóuniwa;</para>
  <para style="q" vid="PSA 145:3">siñá wamuti luéirigun gunfuranda.<verse eid="PSA 145:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 145:4" />Lalawahóuba le badügübei</para>
  <para style="q" vid="PSA 145:4">hámagiñe agübürigu hamoun isaanigu;</para>
  <para style="q" vid="PSA 145:4">ladimurehóuba luagu burí katei gabafuti le badügübei.<verse eid="PSA 145:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 145:5" />Ladimurehóuba luagu bubafu le wéirigubei,</para>
  <para style="q" vid="PSA 145:5">auti, nasaminaruba luagun burí</para>
  <para style="q" vid="PSA 145:5">katei wéiriguti le badügübei.<verse eid="PSA 145:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 145:6" />Ladimurehóuba luagu burí</para>
  <para style="q" vid="PSA 145:6">badüga le gabafubei ani hanarime,</para>
  <para style="q" vid="PSA 145:6">auti, nadimurehaba luagu buéirigun.<verse eid="PSA 145:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 145:7" />Ladimurehóuba luagu lueirin bareidun,</para>
  <para style="q" vid="PSA 145:7">laguarahóuba luagu richá ban.<verse eid="PSA 145:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 145:8" />Areidati Aburemei gudemehabu ligia;</para>
  <para style="q" vid="PSA 145:8">gaguraasunti hínsiñehabu ligía.<verse eid="PSA 145:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 145:9" />Buiti Aburemei hama sun gürigia,</para>
  <para style="q" vid="PSA 145:9">ani góunigi lumuti giñe le ladügübei lau areiduni.<verse eid="PSA 145:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 145:10" />Aburemei, alawahalabu sun le badügübei!</para>
  <para style="q" vid="PSA 145:10">Seremei hamabu ha gúnfulibaña buma!<verse eid="PSA 145:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 145:11" />Hadimureha luagu luéirigun barúeihan!</para>
  <para style="q" vid="PSA 145:11">Hadimureha luagu burí katei gabafuti le badügübei!<verse eid="PSA 145:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 145:12" />Subudigüdawalá bubafu houn gürigia</para>
  <para style="q" vid="PSA 145:12">luma luéirigun barúeihan!<verse eid="PSA 145:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 145:13" />Aban arúeihani magumuchaditi barúeihan;</para>
  <para style="q" vid="PSA 145:13">lunti súnwandan bagumadihan.<verse eid="PSA 145:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 145:14" />Góunigi lumutiña Aburemei ha éiguadubaña,</para>
  <para style="q" vid="PSA 145:14">saragüda laña ha méreeñabaña.<verse eid="PSA 145:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 145:15" />Buagun hariha súngubei</para>
  <para style="q" vid="PSA 145:15">agurabaha lun bíchuguni heigin houn lidan lidaani.<verse eid="PSA 145:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 145:16" />Tulé bumuti búhabu, aba bíchugun lau bugundan</para>
  <para style="q" vid="PSA 145:16">houn sun gürigia luma houn animaalugu.<verse eid="PSA 145:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 145:17" />Richati Aburemei lidan sun lémeri,</para>
  <para style="q" vid="PSA 145:17">areidati lidan sun ladüga.<verse eid="PSA 145:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 145:18" />Yarafati Aburemei houn ha agúahabaña luagu,</para>
  <para style="q" vid="PSA 145:18">houn ha agúahatiña luagu lau hanarün.<verse eid="PSA 145:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 145:19" />Gúnfuli lumuti hayumahan ha inebehabubaña lun;</para>
  <para style="q" vid="PSA 145:19">dan hamuriahan luma lun líderaguniña,</para>
  <para style="q" vid="PSA 145:19">aganba lumutiña, sefuláña.<verse eid="PSA 145:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 145:20" />Góunigi lumutiña Aburemei ha hínsiñehabubaña lun,</para>
  <para style="q" vid="PSA 145:20">ánhaña ha salufuribaña, günringua lumutiña.<verse eid="PSA 145:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 145:21" />Alawahalei niyumaaru Nabureme!</para>
  <para style="q" vid="PSA 145:21">Alawaha huméi súngubei liri le sándubei,</para>
  <para style="q" vid="PSA 145:21">guentó luma súnwandan!<verse eid="PSA 145:21" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" sid="PSA 146" />
  <para style="s1">Lalawahóuniwa le ladügübei Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 146:1" />Alawaha huméi Aburemei!</para>
  <para style="b" vid="PSA 146:1" />
  <para style="q" vid="PSA 146:1">Nalawahabei Nabureme tau sun nuani.<verse eid="PSA 146:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 146:2" />Nalawahabei Nabureme sunme gabagari nan;</para>
  <para style="q" vid="PSA 146:2">neremuhaba uremu lun Nubungiute sunme wínwangidina lan.<verse eid="PSA 146:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 146:3" />Míchiga huméi hafiñen hawagun gürigia wéirigutiña,</para>
  <para style="q" vid="PSA 146:3">wügüriña ha siñati hesefuhan,<verse eid="PSA 146:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 146:4" />ladüga dan le hounwen, aba hasaliragun kalikime,</para>
  <para style="q" vid="PSA 146:4">ani lídanmeme weyu ligía</para>
  <para style="q" vid="PSA 146:4">lagumucha le hasaminarubei hadügün.<verse eid="PSA 146:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 146:5" />Fuleseiwatiña ha líderagubaña lurúeite Hakobu,</para>
  <para style="q" vid="PSA 146:5">ha íchugubalin hemenigin</para>
  <para style="q" vid="PSA 146:5">luagu Bungiu le Lubungiute Hakobu.<verse eid="PSA 146:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 146:6" />Ligía adügübalin sielu, múa, barana</para>
  <para style="q" vid="PSA 146:6">luma sun katei burí le lídanbei.</para>
  <para style="q" vid="PSA 146:6">Ágüdaha lumuti lererun súnwandan.<verse eid="PSA 146:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 146:7" />Ru lumuti haricha ha asufurirubaña houn,</para>
  <para style="q" vid="PSA 146:7">ru ligía éigini houn lamatiña.</para>
  <para style="b" vid="PSA 146:7" />
  <para style="q" vid="PSA 146:7">Furigüda lumutiña adaürǘtiña furisunrugúgiñe;<verse eid="PSA 146:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 146:8" />águyugüda lumuti Aburemei harihin marihintiña houn;</para>
  <para style="q" vid="PSA 146:8">saragüda lumutiña éiguadutiña;</para>
  <para style="q" vid="PSA 146:8">hínsiñetiña gürigia harumatiña lun;<verse eid="PSA 146:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 146:9" />Areida lumutiña Aburemei terencha,</para>
  <para style="q" vid="PSA 146:9">ágüdahalaña méteñuhaña hama würiña hilaguaaña úmari,</para>
  <para style="q" vid="PSA 146:9">gama lumoun féridigüda lumuti hémeri wuribatiña houn.<verse eid="PSA 146:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 146:10" />Sión, larúeihaba Aburemei lun súnwandan;</para>
  <para style="q" vid="PSA 146:10">larúeihaba Bubungiute gumugua dan.</para>
  <para style="b" vid="PSA 146:10" />
  <para style="q" vid="PSA 146:10">Alawaha huméi Bungiu!<verse eid="PSA 146:10" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" sid="PSA 147" />
  <para style="s1">Alawahani lun Suntigabafu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 147:1" />Alawaha huméi Aburemei!</para>
  <para style="b" vid="PSA 147:1" />
  <para style="q" vid="PSA 147:1">Buiti lawarúniwa uremu lun Wabungiute!</para>
  <para style="q" vid="PSA 147:1">Lunti leremuhóun uremu bímeti lun!<verse eid="PSA 147:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 147:2" />Bunaguaya lumuti Aburemei Herusalén</para>
  <para style="q" vid="PSA 147:2">óundaragualaña lánigu Ísüraeli ha chagagubaña.<verse eid="PSA 147:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 147:3" />Agaranihati houn ha sándibaña anigi,</para>
  <para style="q" vid="PSA 147:3">güragualei biti le hawagubei.<verse eid="PSA 147:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 147:4" />Ligía ariñagubei átiribaña lan meha waruguma</para>
  <para style="q" vid="PSA 147:4">ru ligía tiri kada aban.<verse eid="PSA 147:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 147:5" />Wéiriti Wabungiute, weiri ligía lubafu;</para>
  <para style="q" vid="PSA 147:5">mébehati lualin lichügü.<verse eid="PSA 147:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 147:6" />Iñuragua lumutiña Aburemei ha gudemebaña,</para>
  <para style="q" vid="PSA 147:6">gama lumoun ǘnabugüda lumutiña ha salufuribaña.<verse eid="PSA 147:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 147:7" />Heremuha lun Aburemei lau eteingiruni;</para>
  <para style="q" vid="PSA 147:7">heremuha uremu lun Wabungiute lau tamuri árüpa.<verse eid="PSA 147:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 147:8" />Darugua lumuti sielu lau dúeri,</para>
  <para style="q" vid="PSA 147:8">adüga lumuti huya lun láhuyuni múa,</para>
  <para style="q" vid="PSA 147:8">hüchagüda lumuti híduru luagu wübü,<verse eid="PSA 147:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 147:9" />hóugüda lumutiña animaalugu</para>
  <para style="q" vid="PSA 147:9">hóugüdalaña harahüñü sanadi dan le hayahun.<verse eid="PSA 147:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 147:10" />Mama lere gabayu ni lere wügüri</para>
  <para style="q" vid="PSA 147:10">hínsiñetimabei lun Aburemei;<verse eid="PSA 147:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 147:11" />ha inebehabubaña lun,</para>
  <para style="q" vid="PSA 147:11">hagía áubaña lagundaara,</para>
  <para style="q" vid="PSA 147:11">ha hemenigibaña luagu línsiñehabu.<verse eid="PSA 147:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 147:12" />Herusalén, balawahei Aburemei,</para>
  <para style="q" vid="PSA 147:12">Sión, balawahei Bubungiute.<verse eid="PSA 147:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 147:13" />Ligía ámurudubalin lidaünda bubenari</para>
  <para style="q" vid="PSA 147:13">biniláña sun birahüñü lurageirugu uburugu.<verse eid="PSA 147:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 147:14" />Ligía anügübalin darangilaü buburuguterugun,</para>
  <para style="q" vid="PSA 147:14">gufurumagüdalabu lau lubuidun-agei türigu.<verse eid="PSA 147:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 147:15" />Óunaha lumuti lererun lidoun múa,</para>
  <para style="q" vid="PSA 147:15">ani éibaaguati lererun furese.<verse eid="PSA 147:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 147:16" />Adüga lumuti niewe kamá hamuga tura mudún,</para>
  <para style="q" vid="PSA 147:16">afuruha lumuti serenu kamá hamuga kaliki.<verse eid="PSA 147:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 147:17" />Óunaha lumuti yelu kei lúbara huya dereguati;</para>
  <para style="q" vid="PSA 147:17">lau lidiliga le lóunahabei dereguagüda lumuti duna.<verse eid="PSA 147:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 147:18" />Gama lumoun óunaha lumuti lererun,</para>
  <para style="q" vid="PSA 147:18">aba larürüdaguagüdüni;</para>
  <para style="q" vid="PSA 147:18">fúgüda lumuti garabali, aba léibaagun duna.<verse eid="PSA 147:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 147:19" />Subudigüda lumuti lererun lun Ísüraeli,</para>
  <para style="q" vid="PSA 147:19">rulei lugumadin luma lilurudun lun Hakobu.<verse eid="PSA 147:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 147:20" />Madügün lumuti ítara houn híbiri néchanigu</para>
  <para style="q" vid="PSA 147:20">ha masubudirunbalin lilurudun.</para>
  <para style="b" vid="PSA 147:20" />
  <para style="q" vid="PSA 147:20">Alawaha huméi Aburemei!<verse eid="PSA 147:20" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" sid="PSA 148" />
  <para style="s1">Sun ubóu alawahalei Aburemei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 148:1" />Alawaha huméi Aburemei!</para>
  <para style="b" vid="PSA 148:1" />
  <para style="q" vid="PSA 148:1">Alawaha huméi Aburemei lúmagiñe siélugiñe!</para>
  <para style="q" vid="PSA 148:1">Alawaha huméi Aburemei íñugiñe!<verse eid="PSA 148:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 148:2" />Alawaha huméi, sun huguya lánigu ánheligu!</para>
  <para style="q" vid="PSA 148:2">Alawaha huméi huguya súdaragu siéluna!<verse eid="PSA 148:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 148:3" />Alawaha huméi, weyu luma hati!</para>
  <para style="q" vid="PSA 148:3">Alawaha huméi, huguya waruguma!<verse eid="PSA 148:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 148:4" />Alawahabei, buguya sielu íñuti,</para>
  <para style="q" vid="PSA 148:4">buguya duna le lóugiñebei sielu!<note caller="2" style="f"><char style="fr" closed="false">148.4 </char><char style="ft" closed="false">Anihein duna lóugiñe sielu, según ligaburi harihini huríu ubóu.</char></note><verse eid="PSA 148:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 148:5" />Alawaha huméi liri Aburemei</para>
  <para style="q" vid="PSA 148:5">ru lumuti dimurei, aba lasaliragun sun katei;<verse eid="PSA 148:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 148:6" />adüga lumuti sun katei lun súnwandan;</para>
  <para style="q" vid="PSA 148:6">aba líchugun aban lúrudu lun madüraawagun lan.<verse eid="PSA 148:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 148:7" />Alawaha huméi Aburemei múarugugiñe,</para>
  <para style="q" vid="PSA 148:7">animaalugu baranahana ha wéinamutiña ani hanarime,</para>
  <para style="q" vid="PSA 148:7">luma barana huliliti!<verse eid="PSA 148:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 148:8" />Alawaha huméi, labirihaniga luma lúbara huya dereguati,</para>
  <para style="q" vid="PSA 148:8">niewe luma hemereedu!</para>
  <para style="q" vid="PSA 148:8">Garabali héreti le agunfulirubalin lugumadin!<verse eid="PSA 148:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 148:9" />Alawaha huméi, áraabu luma wübü!</para>
  <para style="q" vid="PSA 148:9">Sun burí hibúari luma tídibu wewe to gagindaditu!<verse eid="PSA 148:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 148:10" />Alawaha huméi, animaalugu áraabuna hama áüdübüna!</para>
  <para style="q" vid="PSA 148:10">Alawaha huméi, dunuru hama animaalugu ha aduruuharügütiña múarugu!<verse eid="PSA 148:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 148:11" />Alawaha huméi, lurúeitegu ubóu hama lílana sun fulasu!</para>
  <para style="q" vid="PSA 148:11">Sun ábutigu hama gumadimatiña ubouagu!<verse eid="PSA 148:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 148:12" />Alawaha huméi, wügüriña hama würiña,</para>
  <para style="q" vid="PSA 148:12">nibureintiña hama wéiyaaña mutu!<verse eid="PSA 148:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 148:13" />Sun huguya alawaha huméi liri Aburemei,</para>
  <para style="q" vid="PSA 148:13">ladüga lírirügüñein íñutima.</para>
  <para style="q" vid="PSA 148:13">Lóugiñeñein sielu luma múa linebese!<verse eid="PSA 148:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 148:14" />Rúhali ubafu houn lánigu!</para>
  <para style="b" vid="PSA 148:14" />
  <para style="q" vid="PSA 148:14">Alawahani hámagiñe sun ha gúnfulibaña luma,</para>
  <para style="q" vid="PSA 148:14">hámagiñe Ísüraelina, lánigu ha yarafabaña!</para>
  <para style="b" vid="PSA 148:14" />
  <para style="q" vid="PSA 148:14">Alawaha huméi Aburemei!<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" sid="PSA 149" />
  <para style="s1">Bungiu, adügüti sun katei ani Urúei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 149:1" />Alawaha huméi Aburemei!</para>
  <para style="b" vid="PSA 149:1" />
  <para style="q" vid="PSA 149:1">Heremuha aban uremu iseri lun Aburemei</para>
  <para style="q" vid="PSA 149:1">alawaha huméi lidan hadamurin gúnfulitiña!<verse eid="PSA 149:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 149:2" />Gunda humá Ísüraelina, lílana Sión,</para>
  <para style="q" vid="PSA 149:2">ladüga Bungiu adügübalün, ligía giñe Hurúeitebei.<verse eid="PSA 149:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 149:3" />Alawaha huméi liri lau abinahani,</para>
  <para style="q" vid="PSA 149:3">heremuha uremu lun tau árüpa luma panderu.<verse eid="PSA 149:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 149:4" />Ladüga gúndaati Aburemei hau lumutuniña;</para>
  <para style="q" vid="PSA 149:4">ru lumuti agañeiruni houn ha ǘnabugubaña.<verse eid="PSA 149:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 149:5" />Gunda hamá gúnfulitiña lau hagañeirun,</para>
  <para style="q" vid="PSA 149:5">ani íbini dan le harumuguña lan heremuha lau ugundani.<verse eid="PSA 149:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 149:6" />Ñeinlá alawahani lun Bungiu lidan hiyumaaru,</para>
  <para style="q" vid="PSA 149:6">tuma aban eféin to biámagua tamana húhaburugu<verse eid="PSA 149:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 149:7" />lun hageindagun hama gibe tubungiutegu,</para>
  <para style="q" vid="PSA 149:7">lun habeichaguniña néchanigu,<verse eid="PSA 149:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 149:8" />lun hagüraguniña urúeigu hama gürigia gabafutiña</para>
  <para style="q" vid="PSA 149:8">lau güringüri hǘrüti le lauti gürabu;<verse eid="PSA 149:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 149:9" />lun hagunfuliruni siadi le bürüwaalibei hawagu.</para>
  <para style="q" vid="PSA 149:9">Ábanba inebesei lira houn sun ha gúnfulibaña.</para>
  <para style="b" vid="PSA 149:9" />
  <para style="q" vid="PSA 149:9">Alawaha huméi Aburemei!<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" sid="PSA 150" />
  <para style="s1">Alawahalei sun ubóu Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 150:1" />Alawaha huméi Bungiu!</para>
  <para style="b" vid="PSA 150:1" />
  <para style="q" vid="PSA 150:1">Alawaha huméi Aburemei tidan lisanduariun!</para>
  <para style="q" vid="PSA 150:1">Alawaha huméi lidan lubara le siélubei!<verse eid="PSA 150:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 150:2" />Alawaha huméi luagu burí katei gabafuti le ladügübei!</para>
  <para style="q" vid="PSA 150:2">Alawaha huméi luagu luéirigun le mébehabei!<verse eid="PSA 150:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 150:3" />Alawaha huméi lau tamuri fidu!</para>
  <para style="q" vid="PSA 150:3">Alawaha huméi tau sun tuwuyerigu árüpa!<verse eid="PSA 150:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 150:4" />Alawaha huméi abinaheina lau panderu!</para>
  <para style="q" vid="PSA 150:4">Alawaha huméi tau fülauta tuma gidara!<verse eid="PSA 150:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 150:5" />Alawaha huméi lau lamuri garanwoun!</para>
  <para style="q" vid="PSA 150:5">Alawaha huméi lau pülatíyu gamuriti!<verse eid="PSA 150:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 150:6" />Sun katei le awaraguabei, alawahalei Aburemei!</para>
  <para style="b" vid="PSA 150:6" />
  <para style="q" vid="PSA 150:6">Alawaha huméi Aburemei!<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
</usx>