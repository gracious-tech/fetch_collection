<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CH" style="id">1AKRONI.TXT (Encoding update 2008) 27/02/2001 CAP C.R, GARIFUNA</book>
  <para style="h">1 Krónikasi</para>
  <para style="toc3">1 Kro</para>
  <para style="toc2">1 Krónikasi</para>
  <para style="toc1">1 Krónikasi</para>
  <para style="mt2">Furumiñetu Liliburun</para>
  <para style="mt1">Krónikasi</para>
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="ms">I. Lúmagiñe Adán Dagá Lumóun Dawidi</para>
  <para style="mr">(<ref loc="1CH 1-9">1—9</ref>)</para>
  <para style="s1">Ladügawagun Adán</para>
  <para style="r">(<ref loc="GEN 5:1-32">Agu 5.1-32</ref>)</para>
  <para style="p">
    <verse number="1-4" style="v" sid="1CH 1:1-4" />Adán meha lúguchibei Setü, ani añahán ladügawagun: Enosu, Kainán, Maalaléli, Héredi, Enoku, Matusalén, Lamekü, luma Noé.</para>
  <para style="p" vid="1CH 1:1-4">Ǘrüwañanu meha lirahüñü Noé: Semü, Kamü luma Hafeti.<verse eid="1CH 1:1-4" /></para>
  <para style="r">(<ref loc="GEN 10:1-32">Agu 10.1-32</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 1:5" />Ánheinmetiha Hafeti sédüñanu lirahüñü: Gómerü, Magogu, Madái, Hawán, Tubali, Mesekü luma Tirasi. <verse eid="1CH 1:5" /><verse number="6" style="v" sid="1CH 1:6" />Hati lirahüñü Gómerü: Ásükenasü, Rifatü luma Togarüma. <verse eid="1CH 1:6" /><verse number="7" style="v" sid="1CH 1:7" />Lirahüñüti Hawán: Elisa, Tárüsisi, Kitimü luma Rodanímü.<verse eid="1CH 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 1:8" />Ha métiha lirahüñü Kamü: Kusu, Misüraímü, Futu luma Kanán. <verse eid="1CH 1:8" /><verse number="9" style="v" sid="1CH 1:9" />Añaha meha lirahüñü Kusu: Sebá, Awilá, Sabütá, Raamá luma Sabüteká. Lirahüñüti Raamá: Sebá luma Dedán. <verse eid="1CH 1:9" /><verse number="10" style="v" sid="1CH 1:10" />Kusu ligía lúguchibei Nimüródu, furumiñeti wügüri gabafuti ubouagu.<verse eid="1CH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 1:11" />Lídangiñe Misüraímü hayabin Lúduna, Anamüna, Leábüna, Nafütuína, <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" />Paturúsuna, Kalüsuína hama Kafütóriana, ha ídangiñebaña hayabin Filistéana.<verse eid="1CH 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 1:13" />Kanán lúguchibei Sidón, ligía furumiñetibei liráü, luma Etü. <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />Lídangiñe Kanán hayabin Hebusuna, Amoruna, Hérühesina, <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" />Eweuna, Araséuna, Sineuna, <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" />Arüwadüna, Semarüna hama Amatüna.<verse eid="1CH 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 1:17" />Anihán hiri lirahüñü Semü: Elamü, Asuru, Arüfasádü, Ludu luma Aramü. Anihán hiri lirahüñü Aramü, Usu, Ulu, Géterü, luma Masi. <verse eid="1CH 1:17" /><verse number="18" style="v" sid="1CH 1:18" />Arüfasádü lúguchibei Sela, Sela lúguchi Éberü. <verse eid="1CH 1:18" /><verse number="19" style="v" sid="1CH 1:19" />Biámanañu lirahüñü Éberü: Pelegü líribei le furumiñeti ladüga hafanreinragun gürigia lidan lidaani. Hokután líribei lamulen Pelegü. <verse eid="1CH 1:19" /><verse number="20" style="v" sid="1CH 1:20" />Hokután lúguchibei Alümodádü, Sélefü, Asarü-máweti, Hera, <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" />Adorámü, Usali, Dikülá, <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" />Obali, Abimaéli, Sebá, <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" />Ofirü, Awilá luma Hobabü. Lirahüñü Hokután sun ha.<verse eid="1CH 1:23" /></para>
  <para style="s1">Ladügawagun Semü</para>
  <para style="r">(<ref loc="GEN 11:10-26">Agu 11.10-26</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 1:24" />Semü, Arüfasádü, Sela, <verse eid="1CH 1:24" /><verse number="25" style="v" sid="1CH 1:25" />Éberü, Pelegü, Reú, <verse eid="1CH 1:25" /><verse number="26" style="v" sid="1CH 1:26" />Serugu, Naoru, Téra <verse eid="1CH 1:26" /><verse number="27" style="v" sid="1CH 1:27" />luma Abürámü le Abüraámü.<verse eid="1CH 1:27" /></para>
  <para style="s1">Ladügawagun Ísümaeli tuma Keturá</para>
  <para style="r">(<ref loc="GEN 25:1-6">Agu 25.1-6</ref>,<ref loc="GEN 25:12-18">12-18</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 1:28" />Anihán hiri lirahüñü Abüraámü: Isaakü luma Ísümaeli. <verse eid="1CH 1:28" /><verse number="29" style="v" sid="1CH 1:29" />Anihán burí hiri hadügawagun: Nebaiotu le lígirama Ísümaeli, Kedarü, Abüdéli, Mibüsámü, <verse eid="1CH 1:29" /><verse number="30" style="v" sid="1CH 1:30" />Misümá, Dumá, Masá, Adadü, Temá, <verse eid="1CH 1:30" /><verse number="31" style="v" sid="1CH 1:31" />Heturu, Nafisi luma Kedümá. Hagía lirahüñübaña Ísümaeli.<verse eid="1CH 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 1:32" />Tirahüñü Keturá to lubúali Abüraámü: Simürámü, Hokusán, Medán, Madián, Isübákü luma Sua. Ha lirahüñü Hokusán: Sebá luma Dedán. <verse eid="1CH 1:32" /><verse number="33" style="v" sid="1CH 1:33" />Lirahüñü Madián: Efá, Éferü, Anoku, Abidá luma Elidá. Tadügawagun Keturá sun ha.<verse eid="1CH 1:33" /></para>
  <para style="s1">Ladügawagun Esaú</para>
  <para style="r">(<ref loc="GEN 36:1-43">Agu 36.1-43</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 1:34" />Abüraámü lúguchibei Isaakü. Ha lirahüñü Isaakü: Esaú luma Hakobu. <verse eid="1CH 1:34" /><verse number="35" style="v" sid="1CH 1:35" />Lirahüñü Esaú: Elifási, Reueli, Heusu, Haalamü, luma Koré. <verse eid="1CH 1:35" /><verse number="36" style="v" sid="1CH 1:36" />Lirahüñü Elifási: Temán, Omarü, Sefó, Gatamü luma Kenasi: Garáü lumuti giñe Amalékü tau Timüná. <verse eid="1CH 1:36" /><verse number="37" style="v" sid="1CH 1:37" />Lirahüñü Reueli: Naatü, Sera, Samá luma Misá.<verse eid="1CH 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 1:38" />Lirahüñü Seirü: Lotán, Sobali, Sibón, Aná, Disón, Éserü luma Disán. <verse eid="1CH 1:38" /><verse number="39" style="v" sid="1CH 1:39" />Lirahüñü Lotán: Orí, Emamü. Litu meha Lotán Timüná. <verse eid="1CH 1:39" /><verse number="40" style="v" sid="1CH 1:40" />Lirahüñü Sobali: Alübán, Manaatü, Ebali, Sefó luma Onamü. Lirahüñü Sibón: Ayá luma Aná. <verse eid="1CH 1:40" /><verse number="41" style="v" sid="1CH 1:41" />Aná lúguchibei Disón. Lirahüñü Disón: Emüdán, Esübán, Itürán, Kerán. <verse eid="1CH 1:41" /><verse number="42" style="v" sid="1CH 1:42" />Lirahüñü Éserü: Bilán, Saawán luma Hakán. Lirahüñü Disán: Usu luma Arán.<verse eid="1CH 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 1:43" />Añahán urúeigu ha meha arúeihabaña Edomu lubaragiñe meha garúeite hamá Ísüraelina: Bela le liráü Beoru: Dinaba meha líribei luburugute. <verse eid="1CH 1:43" /><verse number="44" style="v" sid="1CH 1:44" />Dan lóunwenbei Bela, aba larúeihan Hobabü le liráü Sera le Bosuráana leweñegua. <verse eid="1CH 1:44" /><verse number="45" style="v" sid="1CH 1:45" />Lárigiñe lounwen Hobabü, aba larúeihan Usamü le lóubawaguna Temán leweñegua. <verse eid="1CH 1:45" /><verse number="46" style="v" sid="1CH 1:46" />Lárigiñe lounwen Usamü, aba larúeihan Adadü le liráü Bedadü leweñegua, le áfarahabaliña Madianna lidan láraabute Moabü: Awitü meha líribei luburugute. <verse eid="1CH 1:46" /><verse number="47" style="v" sid="1CH 1:47" />Lárigiñe lounwen Adadü, aba larúeihan Samülá le lílana Masüreká leweñegua. <verse eid="1CH 1:47" /><verse number="48" style="v" sid="1CH 1:48" />Lárigiñe lounwen Samülá, aba larúeihan Saulu leweñegua, le Reobotuna, fulasu le lubadubei duna Éufüratesi. <verse eid="1CH 1:48" /><verse number="49" style="v" sid="1CH 1:49" />Lárigiñe lounwen Saulu, aba larúeihan Baali-anán le liráü Akübóru leweñegua. <verse eid="1CH 1:49" /><verse number="50" style="v" sid="1CH 1:50" />Lárigiñe lounwen Baali-anán, aba larúeihan Adadü leweñegua; Pau líribei luburugute, Meetawéli meha tíribei lúmari Adadü, liráü Matürédi, libari Mesaabü.<verse eid="1CH 1:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1CH 1:51" />Lárigiñe lounwen Adadü, añahán lábutigubaña Edomu: Timüná, Aliwá, Hetetü. <verse eid="1CH 1:51" /><verse number="52" style="v" sid="1CH 1:52" />Olibamá, Elá, Pinón, <verse eid="1CH 1:52" /><verse number="53" style="v" sid="1CH 1:53" />Kenasi, Temán, Mibüsárü, <verse eid="1CH 1:53" /><verse number="54" style="v" sid="1CH 1:54" />Magüdiéli luma Iramü. Hagía ha lábutigubaña Edomu.<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="s1">Lirahüñü Hakobu</para>
  <para style="r">(<ref loc="GEN 35:22-26">Agu 35.22-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 2:1" />Anihán hiri lirahüñü Hakobu: Rubén, Simeón, Lewí, Hudá, Isakárü, Sabulón, <verse eid="1CH 2:1" /><verse number="2" style="v" sid="1CH 2:2" />Dan, Hosé, Benhamín, Nefütalí, Gadü luma Aserü.<verse eid="1CH 2:2" /></para>
  <para style="s1">Ladügawagun Hudá</para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 2:3" />Lirahüñü Hudá: Erü, Onán luma Selá. Liráü Sua to Kananna háguchuboun ǘrüwa ha. Gama lumoun wéiriti meha luriban Erü, le lígirama Hudá, aba lagidaruni Bungiu libagari. <verse eid="1CH 2:3" /><verse number="4" style="v" sid="1CH 2:4" />Garaütu meha Tamarü to lídiñu Hudá bián irahüñü lau: Fáresi luma Sera, séingüñanu lubeiti lirahüñü Hudá.<verse eid="1CH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 2:5" />Lirahüñü Fáresi: Esürón luma Amulu. <verse eid="1CH 2:5" /><verse number="6" style="v" sid="1CH 2:6" />Lirahüñü Sera: Simürí, Etán, Emán, Kalikólu luma Darüdá, seingü irahüñü.<verse eid="1CH 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 2:7" />Liráü Karümí, Akán, le anügübalin ligañi Bungiu hawagun Ísüraelina ladüga lanügüni le uágubei lariñaga Bungiu lun lagünrinchawagun sunsuinagubei. <verse eid="1CH 2:7" /><verse number="8" style="v" sid="1CH 2:8" />Liráü Etán: Asaríasi.<verse eid="1CH 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 2:9" />Lirahüñü Esürón: Heraméeli, Ramü luma Kelubái.<verse eid="1CH 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 2:10" />Ramü lúguchibei Aminadábü, Aminadábü lúguchi Naasón, hábuti ladügawagun Hudá. <verse eid="1CH 2:10" /><verse number="11" style="v" sid="1CH 2:11" />Naasón ligía meha lúguchibei Salümá, Salümá lúguchi Boosu, <verse eid="1CH 2:11" /><verse number="12" style="v" sid="1CH 2:12" />Boosu lúguchi Owedi, Owedi lúguchi Hesé, <verse eid="1CH 2:12" /><verse number="13" style="v" sid="1CH 2:13" />Hesé lúguchi Eliabü le lígirama, Aminadábü habiaman, Simá háürüwan; <verse eid="1CH 2:13" /><verse number="14" style="v" sid="1CH 2:14" />Natanaéli hagadürün, Radái haseingün. <verse eid="1CH 2:14" /><verse number="15" style="v" sid="1CH 2:15" />Ósemü hasisin, Dawidi hasedün. <verse eid="1CH 2:15" /><verse number="16" style="v" sid="1CH 2:16" />Seruiá tuma Awigaili hagía hátunubaña. Ǘrüwañanu meha tirahüñü Seruiá: Awisái, Hoabü luma Asaeli. <verse eid="1CH 2:16" /><verse number="17" style="v" sid="1CH 2:17" />Ábanrügüñein tiráü Awigaili: Amasá, Héterü le Ísümaelina lúguchibei.<verse eid="1CH 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 2:18" />Garaüti meha Kalebü le liráü Esürón tau Asubá to lúmari: Heriotu líribei irahü ligía. Ha híbiri lirahüñü: Heserü, Sobabü luma Arüdón. <verse eid="1CH 2:18" /><verse number="19" style="v" sid="1CH 2:19" />Dan tóunwenbei Asubá, aba lamarieidun Kalebü tuma Éfürata, aba tagaraüdüni Uru lau. <verse eid="1CH 2:19" /><verse number="20" style="v" sid="1CH 2:20" />Uru meha lúguchibei Urí, Urí lúguchi Besaléli.<verse eid="1CH 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 2:21" />Luagu ǘrüwa-wein irumu lau Esürón, ligía lamarieidun tuma liráü Makirü, le lúguchi Galaadü, aba tagaraüdüni Segubu lau. <verse eid="1CH 2:21" /><verse number="22" style="v" sid="1CH 2:22" />Segubu meha lúguchibei Hairü, le meha gaburugutebei wein-ǘrüwa uburugu lidan fulasu le gíribei Galaadü. <verse eid="1CH 2:22" /><verse number="23" style="v" sid="1CH 2:23" />Gama lumoun aba lanügünu Gesuru luma Aramü likianpun Hairü, luma burí luburugute Kenatü: Ǘrüwa-wein uburugu lidan súngubei. Sun ha, ladügawagun meha Makirü le lúguchi Galaadü.<verse eid="1CH 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 2:24" />Lárigiñe lounwen Esürón, aba lamarieidun Kalebü tuma Éfürata to meha lúmari Esürón le lúguchi, aba tagaraüdüni Asuru le lúguchi Tekóa tau.<verse eid="1CH 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 2:25" />Lirahüñü Heraméeli, le lígirama Esürón: Ramü, le íbugañaü, Buná, Orén, Ósemü luma Aíasi. <verse eid="1CH 2:25" /><verse number="26" style="v" sid="1CH 2:26" />Gámariti meha giñe Heraméeli ábaya würi gíritu Atará, tuguya lúguchuboun Onamü.<verse eid="1CH 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 2:27" />Lirahüñü Ramü le lígirama Heraméeli: Masi, Hamín luma Ékerü. <verse eid="1CH 2:27" /><verse number="28" style="v" sid="1CH 2:28" />Lirahüñü Onamü: Samái luma Hadá.</para>
  <para style="p" vid="1CH 2:28">Lirahüñü Samái: Nadabü luma Awisúru. <verse eid="1CH 2:28" /><verse number="29" style="v" sid="1CH 2:29" />Abiaili meha tíribei lúmari Awisúru, tuguya lúguchuboun Abán luma Molidi.<verse eid="1CH 2:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 2:30" />Lirahüñü Nadabü: Séledi luma Apaimü. Aba lounwen Séledi marahüñüga. <verse eid="1CH 2:30" /><verse number="31" style="v" sid="1CH 2:31" />Apaimü lúguchibei Isí, Isí lúguchi Sesán, Sesán lúguchi Alai.<verse eid="1CH 2:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 2:32" />Lirahüñü Hadá le lamulen Samái: Héterü luma Yónatan. Aba lounwen Héterü marahüñüga. <verse eid="1CH 2:32" /><verse number="33" style="v" sid="1CH 2:33" />Lirahüñü Yónatan: Péletü luma Sasá. Sun ha ladügawagun Heraméeli.<verse eid="1CH 2:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 2:34" />Marahüñüti meha Sesán wügüriña haweidigia würiña. Gama lumoun ñeinñein aban lidamun Ehiptuna, gíriti Hará <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" />Aba líchugun aban hádangiñe lirahüñü lun lun lúmarime, aba tagaraüdüni Atái lau. <verse eid="1CH 2:35" /><verse number="36" style="v" sid="1CH 2:36" />Atái lúguchibei Natán, Natán lúguchi Sawadü, <verse eid="1CH 2:36" /><verse number="37" style="v" sid="1CH 2:37" />Sawadü lúguchi Efüláli, Efüláli, lúguchi Owedi, <verse eid="1CH 2:37" /><verse number="38" style="v" sid="1CH 2:38" />Owedi lúguchi Heú, Heú lúguchi Asaríasi, <verse eid="1CH 2:38" /><verse number="39" style="v" sid="1CH 2:39" />Asaríasi lúguchi Elesi, Elesi lúguchi Elasá, <verse eid="1CH 2:39" /><verse number="40" style="v" sid="1CH 2:40" />Elasá lúguchi Sisümái, Sisümái lúguchi Salumu, <verse eid="1CH 2:40" /><verse number="41" style="v" sid="1CH 2:41" />Salumu lúguchi Hekamíasi, Hekamíasi lúguchi Elisamá.<verse eid="1CH 2:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CH 2:42" />Lirahüñü Kalebü le lamulen Heraméeli: Mesá íbugañaünbei le lúguchi Sifu, luma Maresá le habiaman, le lúguchi Ebürón. <verse eid="1CH 2:42" /><verse number="43" style="v" sid="1CH 2:43" />Lirahüñü Ebürón: Koré, Tapúa, Rékemü luma Sema. <verse eid="1CH 2:43" /><verse number="44" style="v" sid="1CH 2:44" />Sema meha lúguchibei Raamü, le lúguchibei Horukoámü, Rékemü lúguchibei Samái, <verse eid="1CH 2:44" /><verse number="45" style="v" sid="1CH 2:45" />Liráü Samái Maón, le lúguchi Betü-suru.<verse eid="1CH 2:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="1CH 2:46" />Efá, to meha ábanya lubúali Kalebü lúguchuboun Arán, Mosá luma Gasesi. Arán lúguchibei Gasesi.<verse eid="1CH 2:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="1CH 2:47" />Lirahüñü Hadái: Régemü, Hotamü, Gesán, Péletü, Efá, luma Safü.<verse eid="1CH 2:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1CH 2:48" />Maaká to ábanya lubúali Kalebü, tuguya meha lúguchuboun Séwerü luma Tirühaná. <verse eid="1CH 2:48" /><verse number="49" style="v" sid="1CH 2:49" />Tuguya giñe lúguchuboun Safü le lúguchi Madümaná, luma Sewá, le lúguchi Makübená luma Gibeá. Garaüti giñe Kalebü aban würi gíritu Áküsa.<verse eid="1CH 2:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CH 2:50" />Sun ha, hagía ladügawagunbaña Kalebü. Lirahüñü Uru, le tígirama Éfürata: Sobali, le lúguchi Kiriatü-hearimü; <verse eid="1CH 2:50" /><verse number="51" style="v" sid="1CH 2:51" />Salümá, le lúguchi Belén; luma Arefü le lúguchi Betü-gaderü.<verse eid="1CH 2:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="1CH 2:52" />Lirahüñü Sobali, le lúguchi Kiriatü-hearimü: Reaíasi, hamidan Manaetüna, <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" />liduheñuti Kiriatü-hearimü: Itüritana, Futitana Sumatüna hama Misüraítana, ha ídangiñebaña hayabin Soraana hama Ésütaoluna.<verse eid="1CH 2:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="1CH 2:54" />Lirahüñü Salümá: Belén, ha Netofána, Atürótu-betü-hoabü, ha aban hamidan Manaetüna, Soreína, <verse eid="1CH 2:54" /><verse number="55" style="v" sid="1CH 2:55" />Añahán haduheñu Soferina ha meha aganóubaña Habesi: Tiratüna, Simatüna hama Sukatüna. Añaha Kenitana, ha ladügawagunbaña Amatü, le lúguchi Betü-rekabü.<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s1">Lirahüñü Dawidi</para>
  <para style="r">(<ref loc="2SA 3:2-5">2 Sam 3.2-5</ref>; <ref loc="2SA 5:13-16">5.13-16</ref>; <ref loc="1CH 14:3-7">1 Kro 14.3-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 3:1" />Añahán lirahüñü Dawidi ha águrahoubaña Ebürón: Amünón le íbugañaü, tiráü Ainoamü to Hesüreelina; Danieli le habiaman, tiráü Awigaili to Karümélina; <verse eid="1CH 3:1" /><verse number="2" style="v" sid="1CH 3:2" />Abüsalón le háürüwan, tiráü Maaká, to liráü Talümái, le lurúeite Gesuru; hagadürün, Adoníasi, liráü Aguiti; <verse eid="1CH 3:2" /><verse number="3" style="v" sid="1CH 3:3" />haseingün, Sefatíasi, liráü Awitali, hasisin Itüreámü, tiráü Egülá to ábanya lúmari Dawidi. <verse eid="1CH 3:3" /><verse number="4" style="v" sid="1CH 3:4" />Sisi lirahüñü Dawidi ha, Ebürón hágurahoua, le ñein lubéi larúeiha luagu sedü irumu sisi hati. Lárigiñe aba larúeihan darandi-ǘrüwa irumu Herusalén, <verse eid="1CH 3:4" /><verse number="5" style="v" sid="1CH 3:5" />le ñein lubéi garaüya lan gádürü irahüñü: Simá, Sobabü, Natán luma Salomón, sun hagía tirahüñü Betüsawé to liráü Amieli. <verse eid="1CH 3:5" /><verse number="6" style="v" sid="1CH 3:6" />Garahüñüti giñe nefu irahüñü: Ibarü, Elisamá, Eliféletü, <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" />Noga, Néfegü, Hafia, <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" />Elisamá, Eliadá luma Eliféletü. <verse eid="1CH 3:8" /><verse number="9" style="v" sid="1CH 3:9" />Sun ha, lirahüñü Dawidi bóugudin hawéi lirahüñü hau amu burí lubúaligu. Ñeinñoun giñe aban hatu gíritu Tamarü.<verse eid="1CH 3:9" /></para>
  <para style="s1">Ladügawagun Salomón</para>
  <para style="p">
    <verse number="10-14" style="v" sid="1CH 3:10-14" />Ladügawagun Salomón: Roboamü, Awíasi, Asá, Hosafátü, Horamü, Okosíasi, Hoasi, Amasíasi, Asaríasi, Hotamü, Aasi, Esekíasi, Manasési Amón luma Hosíasi.<verse eid="1CH 3:10-14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 3:15" />Lirahüñü Hosíasi: Hoanán íbugañaünbei, Hoakimü habiaman; Sedekíasi háürüwan, lumoun Salumu hagadürün.<verse eid="1CH 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 3:16" />Lirahüñü Hoakimü: Hekoníasi luma Sedekíasi.<verse eid="1CH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 3:17" />Ladügawagun Hekoníasi le abugúbei lageiragiñe: Salatiéli le lígirama,<verse eid="1CH 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 3:18" />Malükirámü, Pedaíasi, Senasárü, Hekamíasi, Osamá luma Nedawíasi.<verse eid="1CH 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 3:19" />Lirahüñü Pedaíasi: Sorobaweli luma Simí. Lirahüñü Sorobaweli: Mesulámü Ananíasi, tuma Selomitü to hatu, <verse eid="1CH 3:19" /><verse number="20" style="v" sid="1CH 3:20" />hámaya seingü irahüñü: Asubá, Óheli, Berekíasi, Asadíasi luma Husabü-ésedi.<verse eid="1CH 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 3:21" />Lirahüñü Ananíasi: Pelatíasi luma Isaíasi. Ladügawagun Isaíasi: Refaíasi, Arünán, Abüdíasi luma Sekaníasi.<verse eid="1CH 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 3:22" />Sísiñanu lirahüñü Sekaníasi: Semaíasi, Atusu, Igali, Baría, Neariasi luma Safatü.<verse eid="1CH 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 3:23" />Ǘrüwañanu lirahüñü Neariasi: Elioenái, Esekíasi, luma Asürikámü:<verse eid="1CH 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 3:24" />Sédüñanu lirahüñü Elioenái: Odawíasi, Eliasíbü, Pelaíasi, Akubu, Hoanán, Delaíasi luma Ananí.<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s1">Ladügawagun Hudá</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 4:1" />Anihán burí hiri lirahüñü Hudá: Fáresi, Esürón, Karümí, Uru luma Sobali. <verse eid="1CH 4:1" /><verse number="2" style="v" sid="1CH 4:2" />Reaíasi le liráü Sobali, ligía lúguchibei Háatü, Háatü lúguchi Aumái, luma Laadü. Hagía haduheñubaña Soraana.<verse eid="1CH 4:2" /></para>
  <para style="p">
    <verse number="3-4" style="v" sid="1CH 4:3-4" />Lirahüñü Uru: Etamü, Hesüreeli, Isümá, Idübási, Penueli le lúguchi Gedoru luma Éserü, le lúguchi Usá, Ñeinñoun aban hatu gíritu Asülelipóni. Hagía lirahüñübaña Uru, le tígirama Éfürata, binadu ladügawagun Belén.<verse eid="1CH 4:3-4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 4:5" />Biámañanu meha lúmarigu Asuru, le lúguchi Tekóa: Elá tuma Naará. <verse eid="1CH 4:5" /><verse number="6" style="v" sid="1CH 4:6" />Naará lúguchuboun Ausamü, Éferü, Temení luma Aasütarí. Hagía tirahüñübaña Naará. <verse eid="1CH 4:6" /><verse number="7" style="v" sid="1CH 4:7" />Tirahüñü Elá: Séretü, Hesoarü luma Etünán.<verse eid="1CH 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 4:8" />Kosu meha lúguchibei Anubu luma Sobebá, le hagücha lánigu Aareli le liráü Arumu.<verse eid="1CH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9" />Dísetimati laganbun luagu liri Habesi hawéi líbirigu, ligía tíchugunbei lúguchu Habesi lírime, ladüga tariñagun: «Lau igarigu nagaraüdei». <verse eid="1CH 4:9" /><verse number="10" style="v" sid="1CH 4:10" />Aba lafurieidun Habesi lun Bungiu le Lubungiute Ísüraeli, lariñaga: «Ayumuraguatina bun lun babinirunina, ru buguyame aban fulasu wéiriti nun, íderaguabaname, sefubáname luéi wuribani, masufurirun náamuga». Aba líchuguni Bungiu le lamuriahabei luma lun.<verse eid="1CH 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 4:11" />Kelubu, le lamulen Suá, ligía lúguchibei Meirü; Meirü ligía lúguchi Esütón; <verse eid="1CH 4:11" /><verse number="12" style="v" sid="1CH 4:12" />Esütón lúguchibei Betü-rafá, Paséa luma Teiná le adügübalin uburugu Naasü. Hagía meha aganóubaña Reká.<verse eid="1CH 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 4:13" />Lirahüñü Kenasi: Otoniéli, luma Seraíasi. Lirahüñü Otoniéli: Atatü <verse eid="1CH 4:13" /><verse number="14" style="v" sid="1CH 4:14" />luma Meonotái, le lúguchi Ofürá. Seraíasi lúguchibei Hoabü le hagücha lílana fulasu wayati le Arasímü, ha meha gadiñeburibaña.<verse eid="1CH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 4:15" />Lirahüñü Kalebü, le liráü Hefuné: Irü, Elá, luma Naamü. Elá lúguchibei Kenasi.<verse eid="1CH 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 4:16" />Lirahüñü Haleeli: Sifu, Sifá, Tiríasi luma Asaréli.<verse eid="1CH 4:16" /></para>
  <para style="p">
    <verse number="17-18" style="v" sid="1CH 4:17-18" />Lirahüñü Ésüdürasi: Héterü, Méredi, Éferü luma Halón. Aba lamarieidun Méredi tuma Bitiá to liráü lurúeite Ehiptu, aba hagaraüdüniña María, Samái luma Isüwá, le lúguchi Ésütemoa. Gámariti meha giñe Méredi aban würi hádangiñe lani Hudá türibu, tuguya lúguchuboun Héredi le lúguchi Gedoru, Éberü, lúguchi Sokó luma Hekutiéli le lúguchi Sanóa.<verse eid="1CH 4:17-18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 4:19" />Tirahüñü lúmari Odíasi, to litu Naamü le lúguchi Keilá: Daliá le Garümita luma Ésütemoa le Maakatüna.<verse eid="1CH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 4:20" />Lirahüñü Simón: Amünón, Riná, Ben-anán luma Tilón. Lirahüñü Isí: Soetü luma Ben-Soetü.<verse eid="1CH 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 4:21" />Ladügawagun Selá le liráü Hudá: Erü, le lúguchi Leká, Ladá le lúguchi Maresá, haduhe ha meha nadagimeinbaña linu uburugu Betü-asübéa, <verse eid="1CH 4:21" /><verse number="22" style="v" sid="1CH 4:22" />Hoakimü, lílana Kosebá, Hoasi luma Sarafü, ha ñǘdünbaña amarieida hama würiña Moábüna, aba hagiribudun uburugun Belén, según tariñaguni líburu to ñein lubéi labürühóua sun meha le asuseredubei. <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />Wügüriña meha ha adaagutiña katei burí lau múa hagía, Netaimü luma Gederá meha haganawa, ani seriwitiña meha lun urúei.<verse eid="1CH 4:23" /></para>
  <para style="s1">Ladügawagun Simeón</para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 4:24" />Lirahüñü Simeón: Nemueli, Hamín, Haribü, Sera luma Saulu. <verse eid="1CH 4:24" /><verse number="25" style="v" sid="1CH 4:25" />Saulu lúguchibei Salumu; Salumu lúguchi Mibüsámü, Mibüsámü lúguchi Misümá.<verse eid="1CH 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 4:26" />Misümá lúguchi Amueli: Amueli lúguchi Sakuru, Sakuru lúguchi Simí. <verse eid="1CH 4:26" /><verse number="27" style="v" sid="1CH 4:27" />Disisiñanu meha lirahüñü Simí wügüriña hama sisi würiña ánhañati líbirigu míbetiña harahüñü, magibedaguntiña lubeiti liduheñu kei ladügawagun Hudá. <verse eid="1CH 4:27" /><verse number="28" style="v" sid="1CH 4:28" />Bérüsewa meha haganawa, Moladá, Asarü-suali, <verse eid="1CH 4:28" /><verse number="29" style="v" sid="1CH 4:29" />Bilá, Ésemü, Toladü, <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" />Betueli, Orumá, Sikülágü, <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" />Betü-marükawótu, Asarü-susimü, Betü-birái luma Saraimü. Ligía burí haburugutebei darí lumoun larúeihan Dawidi. <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />Bóugudin luéi lira ñeinñein seingü fulasu hama: Etamü, Ain, Rimón, Token luma Asán, <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />lau sun burí lirahüñü fulasu le geyegubei lau burí uburugu le, darí Baalatü. Ligía burí fulasu le meha ñein lubéi haganawa luma burí le ñein lubéi haganawa haduheñu.<verse eid="1CH 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 4:34" />Mesobábü, Hamülékü, Hosíasi, le liráü Amasíasi, <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" />Hoeli, Heú, le liráü Hosiwíasi, Hosiwíasi liráü Seraíasi, Seraíasi liráü Asieli; <verse eid="1CH 4:35" /><verse number="36" style="v" sid="1CH 4:36" />Elioenái, Hakobá, Hesoyaíasi, Asaíasi, Adieli, Hesimiéli, Benaíasi, <verse eid="1CH 4:36" /><verse number="37" style="v" sid="1CH 4:37" />Sisá le liráü Sifi, Sifi liráü Alón, Alón liráü Hedaíasi, Hedaíasi liráü Simürí, Simürí liráü Semaíasi. <verse eid="1CH 4:37" /><verse number="38" style="v" sid="1CH 4:38" />Sun ha iridúbaña, hábutigu iduheñu. Kei haganwoundagun liduheñu darí lun hagibedagun, <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />aba hachülürün lubenarin Gerarü áluaha sagadi houn habiñanigu, luéigiñe oubaü le ñéingiñe lubéi laboucha weyu libiti fulasu wayati, <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />aba hadarirun sagadi buiti luma óunwenbu fulasu darangilati ani chóuruti. Ñein meha haganawa ladügawagun Kan furumiñe, <verse eid="1CH 4:40" /><verse number="41" style="v" sid="1CH 4:41" />gama lumoun lidan lidaani larúeihan Esekíasi Hudá, aba hayabin ladügawagun Simeón aba hagünrinchaguniña lun sun dan tau sun hakianpun-agei tuma burí muna to hadariruboun ñein, aba herederun aganawa ñein heweñegua, kei ñeinñein lubéi sagadi lun heigin habiñanigu. <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" />Ñǘdüntiña giñe seingü-san wügüriña hádangiñe ladügawagun Simeón luagun wübü Seirü lábugiñe hagumadin Pelatíasi, Neariasi, Refaíasi luma Usieli ha lirahüñü Isí, <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" />aba hagünrinchaguniña hagumuhóun Amaléküna. Lúmagiñe dan ligía aba herederun aganawa ñein chülǘ lumoun dan le.<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s1">Ladügawagun Rubén</para>
  <para style="p">
    <verse number="1-3" style="v" sid="1CH 5:1-3" />Añahán lirahüñübaña Rubén le lígirama Hakobu: Anoku, Falú, Esürón luma Karümí. Rubén meha ígiramaübei le tímatimaati, gama lumoun féridi lumuti liricha keisi ígiramaü, ladüga lagamaridunu aban hádangiñe lubúaligu lúguchi, aba lásügürün irichaü ligía houn lirahüñü Hosé, le ábanya liráü Hakobu. Gama lumoun ñǘbuinti Hudá lun gabafubei lan hawéi líbirigu, aba láfuridun aban ábuti lídangiñe, gama lumoun lani meha Hosé irichaü keisi ígiramaü.<verse eid="1CH 5:1-3" /></para>
  <para style="p">
    <verse number="4-6" style="v" sid="1CH 5:4-6" />Ladügawagun Hoeli: Semaíasi, Gogu, Simí, Mikaíasi, Reaíasi, Baali, luma Beerá, le hábuti lánigu Rubén, le lanügübei Tigülátü-Pileserü le lurúeite Asiria adaürǘwa.<verse eid="1CH 5:4-6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 5:7" />Líbirigu Beerá, según habürüdün liduheñu: Heieli, le furumiñeti, Sakaríasi <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" />luma Bela le liráü Asasi, libari Sema le liráü Hoeli. Aba laganóun Bela Aroerü, aba lachawaragun lumúan darí Nebu luma Baali-meón. <verse eid="1CH 5:8" /><verse number="9" style="v" sid="1CH 5:9" />Aba lerederun luéigiñe oubaü le ñéingiñe lubéi laboucha weyu, chülüti lumúan darí laru fulasu mageirawati, le agumeserubei lúmagiñe luéigiñe duna Éufüratesi, ladüga aba lan hagibedagun libiñanigu lóubawagu Galaadü.<verse eid="1CH 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 5:10" />Lidan lidaani larúeihan Saulu, awuribuhatiña lánigu Rubén hama tadügawagun Agarü, gama lumoun aba hagañeiruni lánigu Rubén wuribu aba herederun aganawa luéigiñe oubaü le ñéingiñe lubéi laboucha weyu libiti Galaadü.<verse eid="1CH 5:10" /></para>
  <para style="s1">Ladügawagun Gadü</para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 5:11" />Añahán ladügawagun Gadü ha meha aganóubaña hagibugiñe lánigu Rubén lubadu Basán, darí uburugu Salüká: <verse eid="1CH 5:11" /><verse number="12" style="v" sid="1CH 5:12" />Hoeli, le furumiñeti, lárigiñe Hoeli, Safán, ñéingiñe Haanái, ñéingiñe Safatü. <verse eid="1CH 5:12" /><verse number="13" style="v" sid="1CH 5:13" />Anihán hiri haduheñu: Mikaeli, Mesulámü, Sebá, Horái, Hakán, Sia, luma Éberü, sédüñanu. <verse eid="1CH 5:13" /><verse number="14" style="v" sid="1CH 5:14" />Lirahüñü meha Abiaili sun ha, le liráü Urí, Uri liráü Haróa, Haróa liráü Galaadü, Galaadü liráü Mikaeli, Mikaeli liráü Hesisái, Hesisái liráü Hadó, Hadó liráü Busu. <verse eid="1CH 5:14" /><verse number="15" style="v" sid="1CH 5:15" />Aí le liráü Abüdiéli libari Guní, ligía meha hábutibei liduheñu. <verse eid="1CH 5:15" /><verse number="16" style="v" sid="1CH 5:16" />Aganawatiña meha sun hagía Galaadü, Basán, luma lidan burí lirahüñü aüdü, luma burí áraabu Sarón darí lumoun láfadaragun. <verse eid="1CH 5:16" /><verse number="17" style="v" sid="1CH 5:17" />Sun hagía bürüwatiña lidan lidaaniwagu Hotamü, le lurúeite Hudá luma lidan lidaaniwagu Heroboamü le lurúeite Ísüraeli.<verse eid="1CH 5:17" /></para>
  <para style="s1">Hawaguti bián türibu dimí</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18" />Ladügawagun meha Rubén luma Gadü hama hamidan lani Manasési türibu, súdara meha ganigitiña hagía, anuhein sun tuwuyeri áruma hama ani aranserúatiña buidu lubá wuribu. Bián-wein-gádürü-milu-sedü-san-ǘrüwa-wein wügüriña ha aransetiña lubá wuribu. <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />Aba hageindagun hama tadügawagun Agarü, luma Heturu, Nafisi luma Nodabü; <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />gama lumoun aba líderaguniña Bungiu, aba hábürühan tadügawagun Agarü hama hapanaagu háhaburugun, ladüga hamuriahan luma Bungiu lamidangua wuribu lun líderaguniña. Aba líderaguniña Bungiu ladüga hemenigidun luagu. <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />Lárigiñe aba hanügüniña habiñanigu háganiñu, dimí-san-milu kameyu, bián-san-dimí-milu mudún hama bián-milu burigü. Barütiña giñe san-milu gürigia keisi adaürǘtiña. <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />Saragu haña áganiñu óunwegutiña, lugundun wuribu ligía luéigiñeti lóubadina Bungiu. Ábati herederun aganawa lidan burí fulasu ligía darí lumoun lidaani hasagarawagun hageiragiñe.<verse eid="1CH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />Aganawatiña ladügawagun lamidan lani Manasési türibu lidan fulasu le lúmagiñebei Basán darí Baali-erümón, Senirü luma wübü Erümón, lugundun gíbetiña meha. <verse eid="1CH 5:23" /><verse number="24" style="v" sid="1CH 5:24" />Añahán hábutigu haduheñu: Éferü, Isí, Elieli, Asüriéli, Heremíasi, Odawíasi luma Hadieli, sun hagía, súdaragu ganigitiña, wügüriña díseti laganbahoun hawagu ani hábutigu haduheñu. <verse eid="1CH 5:24" /><verse number="25" style="v" sid="1CH 5:25" />Gama lumoun aba hiñuragun houngua luagun Habungiute hagüchagu, aba háhuduragun houn habungiutegu gürigia ha meha lagünrinchagubaña Bungiu, áfaragualaña hagibugiñe. <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />Ligía línchahanbalin Lubungiute Ísüraeli Pulu, le lurúeite Asiria, lememe Tigülátü-pileserübei, aba lasagaruniña lánigu Rubén, lánigu Gadü hama hamidan lani Manasési türibu hageiragiñe: Aba lanügüniña uburugun, Ala, Aworu, Ará luma duna Gosán le ñein habéi dagá lumoun dan le.<verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s1">Hiri burí fádirigu lirahüñü Lewí</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 6:1" />Añahán lirahüñübaña Lewí: Gerüsón, Keatü luma Merarí.<verse eid="1CH 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 6:2" />Lirahüñü Keatü: Amürámü, Isarü, Ebürón luma Usieli. <verse eid="1CH 6:2" /><verse number="3" style="v" sid="1CH 6:3" />Lirahüñü Amürámü: Aarón, Moisesi tuma María. Lirahüñü Aarón: Nadabü, Abiú, Eleasárü luma Itamárü. <verse eid="1CH 6:3" /><verse number="4" style="v" sid="1CH 6:4" />Eleasárü meha lúguchibei Finesi, Finesi lúguchi Awisúa, <verse eid="1CH 6:4" /><verse number="5" style="v" sid="1CH 6:5" />Awisúa lúguchibei Bukí, Bukí lúguchi Usí. <verse eid="1CH 6:5" /><verse number="6" style="v" sid="1CH 6:6" />Usí meha lúguchibei Seraíasi, Seraíasi lúguchi Meraiotu, <verse eid="1CH 6:6" /><verse number="7" style="v" sid="1CH 6:7" />Meraiotu lúguchi Amaríasi, Amaríasi lúguchi Aitubu, <verse eid="1CH 6:7" /><verse number="8" style="v" sid="1CH 6:8" />Aitubu lúguchi Sadoku, Sadoku lúguchi Aimaasi, <verse eid="1CH 6:8" /><verse number="9" style="v" sid="1CH 6:9" />Aimaasi lúguchi Asaríasi, Asaríasi lúguchi Hoanán. <verse eid="1CH 6:9" /><verse number="10" style="v" sid="1CH 6:10" />Hoanán lúguchi Asaríasi, le meha fádiri tidan ténpulu to lábunaguboun Salomón uburugu Herusalén. <verse eid="1CH 6:10" /><verse number="11" style="v" sid="1CH 6:11" />Asaríasi meha lúguchibei Amaríasi, Amaríasi lúguchi Aitubu. <verse eid="1CH 6:11" /><verse number="12" style="v" sid="1CH 6:12" />Aitubu lúguchi Sadoku, Sadoku lúguchi Salumu, <verse eid="1CH 6:12" /><verse number="13" style="v" sid="1CH 6:13" />Salumu lúguchi Ilükíasi, Ilükíasi lúguchi Asaríasi, <verse eid="1CH 6:13" /><verse number="14" style="v" sid="1CH 6:14" />Asaríasi lúguchi Seraíasi, Seraíasi lúguchi Hosadákü. <verse eid="1CH 6:14" /><verse number="15" style="v" sid="1CH 6:15" />Barüwati meha Hosadákü Babilónioun dan le lasagaragüdünbaliña Bungiu Hudaana hama Herusalénna lun Nabukodonosoru hageiragiñe.<verse eid="1CH 6:15" /></para>
  <para style="s1">Ladügawagun Lewí</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 6:16" />Añahán meha lirahüñübaña Lewí: Gerüsón, Keatü luma Merarí.<verse eid="1CH 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 6:17" />Lirahüñü Gerüsón: Libüní luma Simí.<verse eid="1CH 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 6:18" />Lirahüñü Keatü: Amürámü, Isarü, Ebürón luma Usieli.<verse eid="1CH 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 6:19" />Lirahüñü Merarí: Malí luma Musí: Hagía meha lirahüñübaña Lewí.<verse eid="1CH 6:19" /></para>
  <para style="p">
    <verse number="20-21" style="v" sid="1CH 6:20-21" />Ladügawagun Gerüsón: Libüní, Háatü, Simá, Hoá, Idó, Sera luma Heatürái.<verse eid="1CH 6:20-21" /></para>
  <para style="p">
    <verse number="22-24" style="v" sid="1CH 6:22-24" />Ladügawagun Keatü: Aminadábü, Koré, Asirü, Elikaná, Ebiasáfü, Asirü, Táatü, Urieli, Osiasi luma Saulu.<verse eid="1CH 6:22-24" /></para>
  <para style="p">
    <verse number="25-27" style="v" sid="1CH 6:25-27" />Lirahüñü Elikaná: Amasái luma Aimotu. Ladügawagun Aimotu: Elikaná, Sofái, Naatü, Eliabü, Heroamü luma Elikaná<verse eid="1CH 6:25-27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 6:28" />Lirahüñü Samueli: Wasüní le íbugañaü luma Awíasi.<verse eid="1CH 6:28" /></para>
  <para style="p">
    <verse number="29-30" style="v" sid="1CH 6:29-30" />Ladügawagun Merarí: Malí, Libüní, Simí, Usá, Simá Agiasi luma Asaíasi.<verse eid="1CH 6:29-30" /></para>
  <para style="s1">Eremuhatiña ha lanúadirubaña Dawidi tun ténpulu</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />Añahán eremuhatiña ha líchugubaña Dawidi lun harihin lau uremu litenpulunrugu Bungiu lúmagiñe tichugún lubagüsina daradu ñeinhin. <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />Eremuhatiña meha tigibugiñe kianpu lánina óundaruni luma Bungiu darí lábunagunu Salomón ténpulu lun Bungiu uburugu Herusalén, lárigiñe aba hasigirun eseriwida ñein kei súnwandan.<verse eid="1CH 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 6:33" />Ha meha ñéinbaña hau hasaanigu: Hádangiñe ladügawagun Keatü: Emán, le meha liráü Hoeli, le liráü Samueli, <verse eid="1CH 6:33" /><verse number="34" style="v" sid="1CH 6:34" />le liráü Heroamü, le liráü Elieli, le liráü Toa, <verse eid="1CH 6:34" /><verse number="35" style="v" sid="1CH 6:35" />le liráü Sufu, le liráü Elikaná, le liráü Maatü, le liráü Amasái, <verse eid="1CH 6:35" /><verse number="36" style="v" sid="1CH 6:36" />le liráü Elikaná, le liráü Hoeli, le liráü Asaríasi, le liráü Sofoníasi, <verse eid="1CH 6:36" /><verse number="37" style="v" sid="1CH 6:37" />le liráü Táatü, le liráü Asirü, le liráü Ebiasáfü, le liráü Koré, <verse eid="1CH 6:37" /><verse number="38" style="v" sid="1CH 6:38" />le liráü Isarü, le liráü Keatü, le liráü Lewí le liráü Hakobu.<verse eid="1CH 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 6:39" />Luéigiñeñein meha lóunwenren Enán Asafü le liduhe, le liráü Berekíasi, le liráü Simá, <verse eid="1CH 6:39" /><verse number="40" style="v" sid="1CH 6:40" />le liráü Mikaeli, le liráü Baseíasi, le liráü Malükíasi, <verse eid="1CH 6:40" /><verse number="41" style="v" sid="1CH 6:41" />le liráü Etüní, le liráü Sera, le liráü Adaíasi, <verse eid="1CH 6:41" /><verse number="42" style="v" sid="1CH 6:42" />le liráü Etán, le liráü Simá, le liráü Simí <verse eid="1CH 6:42" /><verse number="43" style="v" sid="1CH 6:43" />le liráü Háatü, le liráü Gerüsón, le liráü Lewí.<verse eid="1CH 6:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="1CH 6:44" />Luéigiñe lubaünan Emán, ñeinñein meha liduhe le hádangiñebei ladügawagun Merarí, le Etán, le liráü Kisí, le liráü Abüdí, le liráü Maluku, <verse eid="1CH 6:44" /><verse number="45" style="v" sid="1CH 6:45" />le liráü Asawíasi, le liráü Amasíasi, le liráü Ilükíasi, <verse eid="1CH 6:45" /><verse number="46" style="v" sid="1CH 6:46" />le liráü Amüsí, le liráü Baní, le liráü Sémerü, <verse eid="1CH 6:46" /><verse number="47" style="v" sid="1CH 6:47" />le liráü Malí, le liráü Musí, le liráü Merarí, le liráü Lewí.<verse eid="1CH 6:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48" />Ha híbiri haduheñu, ha ladügawagun Lewí, hagía erederubaña ariha lau sun le lunbei ladügǘn tidan litenpulun Bungiu. <verse eid="1CH 6:48" /><verse number="49" style="v" sid="1CH 6:49" />Aarón hama ladügawagun hagía meha águdahabalin idewesei ligibuagu latarü le lánina adagaragüdüni gudawarügüti luma le lánina kupali. Hagía giñe arihubaña lau sun eseriwiduni le adügǘbei lidan fulasu le sándutimabei ténpulurugu, luma lun hibihini ferudun luagu burí hafigoun lílana Ísüraeli, kei meha lariñaguni Moisesi le lubúein Bungiu.<verse eid="1CH 6:49" /></para>
  <para style="s1">Ladügawagun Aarón</para>
  <para style="p">
    <verse number="50-53" style="v" sid="1CH 6:50-53" />Añahán ladügawagun Aarón: Eleasárü, Finesi, Awisúa, Bukí, Usí, Seraíasi, Meraiotu, Amaríasi, Aitubu, Sadoku luma Aimaasi.<verse eid="1CH 6:50-53" /></para>
  <para style="s1">Haburugute Lewitagu</para>
  <para style="r">(<ref loc="JOS 21:1-42">Hos 21.1-42</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="1CH 6:54" />Anihán burí fulasu le ñein lubéi haganawa ladügawagun Aarón. Houn Keátüna latokara ubunuruni: <verse eid="1CH 6:54" /><verse number="55" style="v" sid="1CH 6:55" />Ebürón lóubawagu Hudá lau sun láraabute lun hagüriahóuniwa ibiñanigu. <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" />Lun Kalebü le liráü Hefuné lichugúa láraabute uburugu lau sun lirahüñü aüdü le ñeinbei. <verse eid="1CH 6:56" /><verse number="57" style="v" sid="1CH 6:57" />Houn ladügawagun Aarón lichugúa Ebürón, uburugu aramudaguagülei luma burí lirahüñü aüdü le lani Libüná, Hatirü, Ésütemoa, <verse eid="1CH 6:57" /><verse number="58-59" style="v" sid="1CH 6:58-59" />Ilén, Debirü, Asán, luma Betü-sémesi, súngubei lau fulasu lun hagüriahóuniwa ibiñanigu. <verse eid="1CH 6:58-59" /><verse number="60" style="v" sid="1CH 6:60" />Rútiña giñe burí uburugu le hani lani Benhamín türibu houn: Geba, Alemetü luma Anatótu súngubei lau fulasu lun hagüriahóuniwa ibiñanigu. Tareisiñein lubeiti uburugu atokaruti houn liduheñu Aarón.<verse eid="1CH 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="1CH 6:61" />Houn ha híbiri liduheñu Keatü, tokati diisi uburugu le hani hamidan lani Manasési türibu, <verse eid="1CH 6:61" /><verse number="62" style="v" sid="1CH 6:62" />houn ladügawagun Gerüsón según hibe haduheñu rúati tareisi uburugu le hani lani Isakárü türibu, Aserü, luma Nefütalí luma lídangiñe lani Manasési türibu ha buga aganóubaña Basán.<verse eid="1CH 6:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="1CH 6:63" />Houn ladügawagun Merarí según hibe haduheñu, tokati duusu uburugu houn lídangiñe türibu ha lani Rubén, Gadü luma Sabulón.<verse eid="1CH 6:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="1CH 6:64" />Ru hamuti Ísüraelina uburugu burí le lau burí fulasu lun hagüriahóuniwa ibiñanigu houn ladügawagun Lewí. <verse eid="1CH 6:64" /><verse number="65" style="v" sid="1CH 6:65" />Hádangiñe türibugu ha lani Hudá, Simeón luma Benhamín, rúati burí uburugu le iridúaalibei. <verse eid="1CH 6:65" /><verse number="66" style="v" sid="1CH 6:66" />Houn hádangiñe haduheñu Keátüna, rúati burí uburugu houn lídangiñe haburugute lani Éfürain türibu. <verse eid="1CH 6:66" /><verse number="67" style="v" sid="1CH 6:67" />Rúati giñe Sikemü, uburugu aramudaguagülei le luágubei burí luwübüri Éfürain houn lau sun lufulasuna lun hagüriahóuniwa ibiñanigu, lumagiñe Géserü, <verse eid="1CH 6:67" /><verse number="68-69" style="v" sid="1CH 6:68-69" />Hokumeámü, Betü-orón, Ayalón luma Gatü-rimón súngubei lau lufulasuna lun hagüriahóuniwa ibiñanigu.<verse eid="1CH 6:68-69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="1CH 6:70" />Houn ha híbiri Keátüna, rúati uburugu Anerü luma Bileamü, le meha hani hamidan lani Manasési türibu lau lufulasuna lun hagüriahóuniwa ibiñanigu.<verse eid="1CH 6:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="1CH 6:71" />Houn ladügawagun Gerüsón según hibe haduheñu, rúati uburugu Golán le Basanbei luma luburugute Asütarótu, le meha hani hamidan lani Manasési türibu lau lufulasuna lun hagüriahóuniwa ibiñanigu. <verse eid="1CH 6:71" /><verse number="72-73" style="v" sid="1CH 6:72-73" />Rúati giñe hádangiñe lani Isakárü türibu, Kedesi, Dawerátü, Ramotu luma Anemü houn, kada aban lau lufulasuna lun hagüriahóuniwa ibiñanigu. <verse eid="1CH 6:72-73" /><verse number="74-75" style="v" sid="1CH 6:74-75" />Lídangiñe haburugute lani Aserü türibu, rúati Masali houn, Abüdón, Ukoku luma Reobu, kada aban lau lufulasuna lun hagüriahóuniwa ibiñanigu. <verse eid="1CH 6:74-75" /><verse number="76" style="v" sid="1CH 6:76" />Lídangiñe lani Nefütalí türibu, rúati Kedesi le lani Galiléa houn, Amón luma Kiriataimü, kada aban lau lufulasuna lun hagüriahóuniwa ibiñanigu.<verse eid="1CH 6:76" /></para>
  <para style="p">
    <verse number="77" style="v" sid="1CH 6:77" />Houn híbiri ladügawagun Merarí, rúati Houn lídangiñe haburugute lani Sabulón Türibu: Rimón luma Taworu, kada aban lau lufulasuna lun hagüriahóuniwa ibiñanigu; <verse eid="1CH 6:77" /><verse number="78-79" style="v" sid="1CH 6:78-79" />houn lani Rubén türibu, luéigiñe oubaü le ñéingiñe lubéi laboucha weyu libiti Hordán ligibugiñe Herikó, rúati Béserü, le lídanbei fulasu mageirawati, Haasü, Kademótu luma Mefatü, kada aban lau lufulasuna lun hagüriahóuniwa ibiñanigu; <verse eid="1CH 6:78-79" /><verse number="80-81" style="v" sid="1CH 6:80-81" />lídangiñe lani Gadü türibu, rúati Ramotu le lani Galaadü houn, Manaímü, Esübón, luma Aserü.<verse eid="1CH 6:80-81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="s1">Ladügawagun Isakárü</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 7:1" />Gádürüñanu lirahüñü Isakárü: Tolá, Puá, Hasubu luma Simürómu.<verse eid="1CH 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 7:2" />Lirahüñü Tolá: Usí, Refaíasi, Herieli, Hamái, Ibüsámü luma Samueli, hábutigu liduheñu Tolá, wügüriña wuriburuguna ganigitiña, le hanügün haweigiñe haduheñu. Lidan meha lidaaniwagu Dawidi, chülütiña hadügawagun lumoun wein-bián-milu-sisi-san.<verse eid="1CH 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 7:3" />Liráü Usí: Isüraíasi. Lirahüñü Isüraíasi: Mikaeli, Abüdíasi, Hoeli luma Isíasi. Seingü ábutigu hadan súngubei. <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />Kei meha gibe habéi hámarigu, gibe hasaanigu, aba hagibedagun hadügawagun hau wügüriña ha lúntiña wuribu, ha burí achülürübaña lumoun darandi-sisi-milu.<verse eid="1CH 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 7:5" />Dan habahüdün lánigu Isakárü, según ha abürüdǘwabaña, chülütiña lumoun gádürü-wein-sedü-milu wügüriña, sun hagía, wuriburuguna ha ganigitiña.<verse eid="1CH 7:5" /></para>
  <para style="s1">Ladügawagun Benhamín</para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 7:6" />Ǘrüwañanu meha lirahüñü Benhamín: Bela, Békerü luma Hediaeli.<verse eid="1CH 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 7:7" />Séingüñanu meha lirahüñü Bela: Esübón, Usí, Usieli, Herimótu luma Irí, sun hagía, hábutigu iduheñu, ani wuriburuguna ganigitiña, chülütiña hadügawagun darí wein-bián-milu-darandi-gádürü gürigia.<verse eid="1CH 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 7:8" />Lirahüñü Békerü: Semirá, Hoasi, Elieserü, Elioenái, Omurí, Herimótu, Abüdíasi, Anatótu, luma Alemetü, lirahüñü meha Békerü sun ha, <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />ani según habürüdǘn ladügawagun hama hábutigu iduheñu, wein-milu-bián-sánñanu meha wügüriña ganigitiña.<verse eid="1CH 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 7:10" />Liráü Hediaeli: Bilán. Lirahüñü Bilán: Heusu, Benhamín, Eudu, Kenaaná, Setán, Tárüsisi, luma Aisarü. <verse eid="1CH 7:10" /><verse number="11" style="v" sid="1CH 7:11" />Sun ha ladügawagun meha Hediaeli, hábutigu iduheñu, wügüriña ganigitiña ha lánina wuribu. Chülütiña lumoun disedü-milu bián-san wügüriña.<verse eid="1CH 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 7:12" />Lirahüñü Irü: Sufamü luma Ufamü. Liráü Aerü: Usimü.<verse eid="1CH 7:12" /></para>
  <para style="s1">Ladügawagun Nefütalí</para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 7:13" />Lirahüñü Nefütalí: Haseeli, Guní, Heserü luma Salumu. Hagía ladügawagunbaña Bilá.<verse eid="1CH 7:13" /></para>
  <para style="s1">Ladügawagun Manasési</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 7:14" />Lirahüñü Manasési tau lubúali to Síriana: Asüriéli luma Makirü, le lúguchi Galaadü. <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" />Aba lamarieidun Makirü tuma Maaká, aban würi hádangiñetu liduheñu Ufamü luma Sufamü. Le habiaman lirahüñü Makirü Selofádü meha líribei, Selofádü ligía, würiñarügüñanu lirahüñü. <verse eid="1CH 7:15" /><verse number="16" style="v" sid="1CH 7:16" />Garaütu meha Maaká to lúmari Makirü aban irahü le uágubei tíchiga Péresi. Lamulen Péresi, Séresi; Ulamü luma Rékemü híribei lirahüñü. <verse eid="1CH 7:16" /><verse number="17" style="v" sid="1CH 7:17" />Bedán, liráü Ulamü. Hagía meha lirahüñübaña Galaadü le liráü Makirü le liráü Manasési.<verse eid="1CH 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 7:18" />Amuléketü to litu Makirü tuguya meha lúguchuboun Isodu, Abieserü luma Malá.<verse eid="1CH 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 7:19" />Lirahüñü Semidá: Ayán, Sikemü, Likeí luma Aniamü.<verse eid="1CH 7:19" /></para>
  <para style="s1">Ladügawagun Éfürain</para>
  <para style="p">
    <verse number="20-21" style="v" sid="1CH 7:20-21" />Ladügawagun Éfürain: Sutela, Béredi, Táatü, Eladá, Táatü, Sawadü, Sutela. Éserü luma Eladü ha híbiri lirahüñü Éfürain, áfaragua hamutiña lóubawaguna Gatü, ladüga haragachun agidaraña halügüniña bágasu hawéi. <verse eid="1CH 7:20-21" /><verse number="22" style="v" sid="1CH 7:22" />Amuiserati Éfürain hárigi saragu dan, aba hayabin liduheñu ámalihei. <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />Lárigiñe aba larounrun tuma lúmari, aba tadageinadun, aba tagaraüdün aban irahü aba líchuguni Beriá lírime ladüga anihein lan buga lamiselu lúbiñe.<verse eid="1CH 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 7:24" />Aba tábunaguni Seerá to liráü Beriá Betü-orón le ǘnabugiñebei luma Betü-orón le íñugiñebei, luma giñe Usén-seerá.<verse eid="1CH 7:24" /></para>
  <para style="p">
    <verse number="25-27" style="v" sid="1CH 7:25-27" />Ladügawagun Beriá: Refa, Résefü, Tela, Taán, Ladán, Amiudu, Elisamá, Nun luma Hosué. <verse eid="1CH 7:25-27" /><verse number="28" style="v" sid="1CH 7:28" />Beteli meha hageirabei; Naarán luéigiñe oubaü le ñéingiñe lubéi laboucha weyu; Géserü, luéigiñe oubaü le ñeinhin lubéi lálüda weyu; luma Sikemü, darí Aya; sun burí uburugu le lau burí lirahüñü aüdü le geyegubei lau. <verse eid="1CH 7:28" /><verse number="29" style="v" sid="1CH 7:29" />Lábugiñeñein meha habafu ladügawagun Manasési Betü-seán, Taanakü, Megidu luma Doru lau sun burí lirahüñü aüdü le geyegubei lau. Lidan burí meha fulasu ligía haganawa ladügawagun Hosé le liráü Hakobu.<verse eid="1CH 7:29" /></para>
  <para style="s1">Ladügawagun Aserü</para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 7:30" />Lirahüñü Aserü: Imüná, Isüwá, Isüwí, Beriá tuma Sera to hatu.<verse eid="1CH 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 7:31" />Lirahüñü Beriá: Éberü luma Malükiéli, le lúguchi Birüsáwitü. <verse eid="1CH 7:31" /><verse number="32" style="v" sid="1CH 7:32" />Éberü meha lúguchibei Hafüléti, Sémerü, Otamü tuma Suá to hatu.<verse eid="1CH 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 7:33" />Lirahüñü Hafüléti: Pasakü, Bimali, luma Asüwátü.<verse eid="1CH 7:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 7:34" />Lirahüñü Sémerü le líbiri: Rogá, Heubá luma Aramü.<verse eid="1CH 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 7:35" />Lirahüñü Otamü le líbiri: Sofa, Imüná, Selesi luma Amali. <verse eid="1CH 7:35" /><verse number="36" style="v" sid="1CH 7:36" />Lirahüñü Sofa: Sua, Arünéferü, Suali, Berí, Imürá, <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" />Béserü, Odu, Samá, Silüsá Itürán luma Beerá.<verse eid="1CH 7:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 7:38" />Lirahüñü Héterü: Hefuné, Pisüpá luma Ará. <verse eid="1CH 7:38" /><verse number="39" style="v" sid="1CH 7:39" />Lirahüñü Ulá: Ara, Anieli luma Risiá.<verse eid="1CH 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CH 7:40" />Sun ha, ladügawagun meha Aserü. Hábutigu iduheñu, hádangiñe habuidun-agei súdaragu ganigitiña, wügüriña íñugutiña. Según ha bürüwañubaña wein-sisi-míluñanu meha wügüriña hagía ha gayaraati houdin wuriburugu.<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s1">Ladügawagun Benhamín</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 8:1" />Benhamín meha lúguchibei Bela, le furumiñeti liráü: Asübéli, le habiaman; Aara, le háürüwan; <verse eid="1CH 8:1" /><verse number="2" style="v" sid="1CH 8:2" />Noá, le hagadürün, luma Rafá le haseingün. <verse eid="1CH 8:2" /><verse number="3" style="v" sid="1CH 8:3" />Lirahüñü Bela: Adarü, Gerá, Abiudu, <verse eid="1CH 8:3" /><verse number="4" style="v" sid="1CH 8:4" />Awisúa, Naamán, Ahóa, <verse eid="1CH 8:4" /><verse number="5" style="v" sid="1CH 8:5" />Gerá, Sefufán luma Iramü.<verse eid="1CH 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 8:6" />Lirahüñü Eudu, hábutigu iduheñu ha meha aganóubaña Geba, aba hasagarun ñéingiñe lun hanügǘn lun Manaatün keisi adaürǘtiña: <verse eid="1CH 8:6" /><verse number="7" style="v" sid="1CH 8:7" />Naamán, Aíasi, Gerá, le lúguchi Usá luma Aiudu le anügübaliña.<verse eid="1CH 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 8:8" />Garahüñüyati meha Saraimü ámuya irahüñü Moabü lárigiñe lígiragun tuma Usimü tabu Baará ha meha lánigu weiriou. <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />Anihán hiri lirahüñü tau Odesi to iseri lani weiriou: Hobabü, Siwiá, Mesá, Malükámü, <verse eid="1CH 8:9" /><verse number="10" style="v" sid="1CH 8:10" />Heusu, Sakíasi luma Mirümá. Hagía lirahüñübaña, sun hagía hábutigu iduheñu.<verse eid="1CH 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 8:11" />Tau Usimü to lani weiriou garahüñülaña meha Awitúbu luma Elipáli. <verse eid="1CH 8:11" /><verse number="12" style="v" sid="1CH 8:12" />Lirahüñü Elipáli: Éberü, Misamü, luma Sémedi, le ábunagubalin uburugu Onó luma Lodu, lau burí lirahüñü aüdü le geyegubei lau; <verse eid="1CH 8:12" /><verse number="13" style="v" sid="1CH 8:13" />Beriá luma Semá, hábutigu iduheñu ha meha aganóubaña Ayalón, ha abugubaliña binadu lílana Gatü; <verse eid="1CH 8:13" /><verse number="14" style="v" sid="1CH 8:14" />luma Sasakü labu Heroamü ha hamulenu.<verse eid="1CH 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 8:15" />Sewadíasi, Aradü, Aderü, <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" />Mikaeli, Isüpá, luma Hoá lirahüñü meha Beriá. <verse eid="1CH 8:16" /><verse number="17" style="v" sid="1CH 8:17" />Sewadíasi, Mesulámü, Isükí, Éberü, <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" />Isümerái, Isülíasi luma Hobabü, lirahüñü meha Elipáli. <verse eid="1CH 8:18" /><verse number="19" style="v" sid="1CH 8:19" />Hakimü, Sikürí, Sabüdí, <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" />Elienái, Siletái, Elieli, <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" />Adaíasi, Beraíasi luma Simürátü, lirahüñü meha Simí. <verse eid="1CH 8:21" /><verse number="22" style="v" sid="1CH 8:22" />Isüpán, Éberü, Elieli, <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" />Abüdón, Sikürí, Anán, <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" />Ananíasi, Elamü, Anatotíasi, <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" />Ifüdaíasi luma Penieli, lirahüñü meha Sasakü. <verse eid="1CH 8:25" /><verse number="26" style="v" sid="1CH 8:26" />Samüserái, Searíasi, Atalíasi, <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" />Haresíasi, Elíasi luma Sikürí, lirahüñü meha Heroamü. <verse eid="1CH 8:27" /><verse number="28" style="v" sid="1CH 8:28" />Hagía hábutigu iduheñu wéirigutiña hani kada inebanfani ha meha aganóubaña Herusalén.<verse eid="1CH 8:28" /></para>
  <para style="s1">Liduheñu Saulu</para>
  <para style="r">(<ref loc="1CH 9:35-44">1 Kro 9.35-44</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 8:29" />Uburugu meha Gabaón laganawa Heieli, le lúguchi Gabaón. Maaká meha tíribei lúmari. <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />Añahán lirahüñübaña: Abüdón, le íbugañaü, Suru, Kisü, Baali, Nerü, Nadabü, <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" />Gedoru, Ayó, Sékerü <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" />luma Mikülótu, le meha lúguchi Simí. Sun giñe ha, falá hamuti hani hábirigu hénpulu aba haganóun hama Herusalén.<verse eid="1CH 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 8:33" />Nerü meha lúguchibei Kisü, Kisü lúguchi Saulu, Saulu lúguchi Yónatan, Malükisúa, Abinadábü luma Esü-baali. <verse eid="1CH 8:33" /><verse number="34" style="v" sid="1CH 8:34" />Liráü Yónatan: Meribü-baali, le meha lúguchi Mikaíasi. <verse eid="1CH 8:34" /><verse number="35" style="v" sid="1CH 8:35" />Lirahüñü Mikaíasi: Pitón, Mélekü, Tareá luma Aasi. <verse eid="1CH 8:35" /><verse number="36" style="v" sid="1CH 8:36" />Aasi meha lúguchibei Hoadá, Hoadá lúguchi Alemetü, Asümáweti luma Simürí, Simürí lúguchi Mosá, <verse eid="1CH 8:36" /><verse number="37" style="v" sid="1CH 8:37" />Mosá lúguchi Biná, Biná lúguchi Rafá, Rafá lúguchi Elasá, Elasá lúguchi Aseli.<verse eid="1CH 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 8:38" />Sísiñanu meha lirahüñü Aseli: Asürikámü, Bokurú, Ísümaeli, Searíasi, Abüdíasi luma Anán. Añahán meha lirahüñübaña Aseli.<verse eid="1CH 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 8:39" />Lirahüñü Ésekü, le lamulen: Ulamü, le íbugañaü; Heusu, le habiaman; luma Eliféletü le háürüwan. <verse eid="1CH 8:39" /><verse number="40" style="v" sid="1CH 8:40" />Lirahüñü Ulamü, súdaragu meha ganigitiña, buítiña lidan tachüühóun gimara. Gíbetiña meha harahüñü hama habañan, san-dimí hadan súngubei, sun hagía ladügawagun Benhamín.<verse eid="1CH 8:40" /></para>
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />Ítara liña herederun sun lílana Ísüraeli bürüwañu tidan haliburun lurúeitegu Ísüraeli.</para>
  <para style="s1" vid="1CH 9:1">Ha Agiribudubaña Babilóniagiñe</para>
  <para style="r" vid="1CH 9:1">(<ref loc="NEH 11:1-24">Nee 11.1-24</ref>)</para>
  <para style="p" vid="1CH 9:1">Gama lumoun barüwaguatiña meha lílana Hudá Babilónioun ladüga hariban.<verse eid="1CH 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 9:2" />Ísüraelina, fádirigu, Lewitagu hama eseriwidutiña ténpulurugu agiribudubaña furumiñe aganawa hamúanrugu luma haburuguterugun. <verse eid="1CH 9:2" /><verse number="3" style="v" sid="1CH 9:3" />Rédeitiña ladügawagun Hudá, Benhamín, Éfürain luma Manasési aganawa Herusalén.<verse eid="1CH 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 9:4" />Hádangiñe ladügawagun Hudá; Utái, le liráü Amiudu, le liráü Omurí, le liráü Imürí, le liráü Baní, hádangiñe ladügawagun Fáresi le liráü Hudá. <verse eid="1CH 9:4" /><verse number="5" style="v" sid="1CH 9:5" />Silona: Asaíasi, le íbugañaü hádangiñe harahüñü. <verse eid="1CH 9:5" /><verse number="6" style="v" sid="1CH 9:6" />Hádangiñe ladügawagun Sera: Heueli hama liduheñu, sisi-san-gádürü-wein-diisi gürigia.<verse eid="1CH 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 9:7" />Hádangiñe ladügawagun Benhamín: Salú le liráü Mesulámü, le liráü Odawíasi, le liráü Senúa; <verse eid="1CH 9:7" /><verse number="8" style="v" sid="1CH 9:8" />Ibüneíasi, le liráü Heroamü; Elá le liráü Usí, le liráü Mikürí; Mesulámü, le liráü Sefatíasi, le liráü Reueli, le liráü Ibüníasi. <verse eid="1CH 9:8" /><verse number="9" style="v" sid="1CH 9:9" />Néfuñanu-san-dimí-san-sisi, según hibe haduheñu lidan saragu inebanfani, sun hagía hábutigu iduheñu.<verse eid="1CH 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 9:10" />Hádangiñe fádirigu: Hedaíasi, Hoyaríbü, Hakimü, <verse eid="1CH 9:10" /><verse number="11" style="v" sid="1CH 9:11" />Asaríasi le liráü Ilükíasi, le liráü Mesulámü, le liráü Sadoku, le liráü Meraiotu, le liráü Aitubu, meni ábuti tidan luban Bungiu: <verse eid="1CH 9:11" /><verse number="12" style="v" sid="1CH 9:12" />Adaíasi le liráü Heroamü, le liráü Pasuru, le liráü Malükíasi; Masái, le liráü Adieli, le liráü Hasera, le liráü Mesulámü, le liráü Mesilemítü, le liráü Imerü; <verse eid="1CH 9:12" /><verse number="13" style="v" sid="1CH 9:13" />hama liduheñu: Milu-sedü-san-ǘrüwa-wein hábutigu iduheñu, wügüriña ha subuditiña luáguna eseriwiduni tidan luban Bungiu.<verse eid="1CH 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 9:14" />Hádangiñe Lewitagu: Semaíasi, le liráü Asubu, le liráü Asürikámü, le liráü Asawíasi, hádangiñeti liduheñu Merarí; <verse eid="1CH 9:14" /><verse number="15" style="v" sid="1CH 9:15" />Bakübakárü, Éresi, Galalü luma Mataníasi, lirahüñü Mikaíasi, le liráü Sikürí; le liráü Asafü; <verse eid="1CH 9:15" /><verse number="16" style="v" sid="1CH 9:16" />Abüdíasi, le liráü Semaíasi, le liráü Galalü, le liráü Hedutún: Berekíasi le liráü Asá, le liráü Elikaná le meha aganóubei lidan burí lirahüñü aüdü le geyegubei lau uburugu Netofá.<verse eid="1CH 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 9:17" />Lúnirigu bena: Salumu, Akubu, Talümón, Aimán, Salumu le hábiri ligía meha hábutibei. <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />Ani chülǘ lumoun dan le, ligía lúniribei tubenari luban urúei, bena le luéigiñebei oubaü le ñéingiñe lubéi laboucha weyu. Hagía meha ha lúniribaña bena tidan hakianpun Lewitagu.<verse eid="1CH 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 9:19" />Salumu, le liráü Koré, le liráü Ebiasáfü, le liráü Koré, hama ladügawagun Koré ha haduheñu hagía meha óunigirubalin tubenari sanduariu, ítara liña kei meha hóunigiruni hagüchagu tubenari likianpun-agei Aburemei.<verse eid="1CH 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 9:20" />Lubaragiñe meha lira, Finesi le liráü Eleasárü, ligía meha hábutibei. Aniheinlá Bungiu luma!<verse eid="1CH 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 9:21" />Sakaríasi, le liráü Meselemíasi, ligía meha lúniribei tubenari kianpu lánina óundaruni luma Bungiu.<verse eid="1CH 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 9:22" />Hadan súngubei, biánñanu-san-duusu lúniri bena anuadirútiña, según ha abürüdǘwabaña tidan haliburun iduheñu to lani fulasu burí le meha ñein lubéi haganawa. Dawidi luma Samueli le profeta, hagía íchugubalin wadagimanu le houn, lugundun hemenigiwati hawagu. <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />Dandu hagía kei harahüñü góunigi hamuti meha tubenari luban Bungiu, tomeme sanduariu. <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />Ñéinñanu meha lúniri bena luéigiñe gádürügubei oubaü: Luéigiñe oubaü le ñéingiñe lubéi laboucha weyu luma luéigiñe le ñeinhin lubéi lálüda, luéigiñe nórute luma luéigiñe suru. <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />Ábaha hayabin haduheñu ha aganóubaña hageira íderaguaña luagu sedü weyu: <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" />Gama lumoun gádürü lúniri bena ha tímatimaabaña ha Lewitagu, hóunigiruña súnwandan, hóunigiruñoun burí rumu luma golu-agei le tídanbei luban Bungiu. <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />Sügǘ hamutiha sun áriebu geyegu tau ténpulu, lugundun gasu hóunigirunu luma hadaaruni tubenari sagü binaafin. <verse eid="1CH 9:27" /><verse number="28" style="v" sid="1CH 9:28" />Añahein hádangiñe, hagía arihubaña lau ílagu le ayusurubei lidan kultu, gásutiha háluguchuni luma habuachuni lárigoun lárigiñe habahüdüni. <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />Híbiri hádangiñe arihubaña lau líbiri ílagu le burí sagüráubei, bóugudin tuéi fulúaru, diwéin, garaba, kupali luma ibiñein: <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" />Añahein hádangiñe fádirigu, hagía aranserubalin ibiñein; <verse eid="1CH 9:30" /><verse number="31" style="v" sid="1CH 9:31" />aban lewita gíriti Matatíasi le lígirama Salumu, le ladügawagun Koré, ligía adügübarun durudia lun idewesei súnwandan. <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" />Fiu hádangiñe haduheñu, ha ladügawagun Keatü, hagía adügübarun fein anuadirúatu to esetirúboun aban tárigi aban sagü samudi. <verse eid="1CH 9:32" /><verse number="33" style="v" sid="1CH 9:33" />Ñéinñanu giñe eremuhatiña, hábutigu iduheñu Lewitagu ha aganóubaña tidan burí rumu to ténpuluruguboun, madügüntiña amu luwuyeri wadagimanu lugundun bereseguñanu lidan heseriwidun wéyuagu áriebu.<verse eid="1CH 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34" />Hagía meha ha hábutigubaña iduheñu Lewitagu según inebanfani ha aganóubaña Herusalén.<verse eid="1CH 9:34" /></para>
  <para style="s1">Lagüchagu hama ladügawagun urúei Saulu</para>
  <para style="r">(<ref loc="1CH 8:29-40">1 Kro 8.29-40</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 9:35" />Uburugu meha Gabaón laganawa Heieli, le lúguchi Gabaón. Maaká meha tíribei lúmari. <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />Anihán burí hiri harahüñü: Abüdón, le íbugañaü; Suru, Kisü, Baali, Nerü, Nadabü, <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" />Gedoru, Ayó, Sakaríasi luma Mikülótu, <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" />le meha lúguchibei Simamü. Falá hamuti giñe hani hábirigu hénpulu, aba houdin aganawa hama Herusalén.<verse eid="1CH 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 9:39" />Nerü meha lúguchibei Kisü, Kisü lúguchi Saulu, Saulu lúguchi Yónatan, Malükisúa, Abinadábü luma Esi-baali. <verse eid="1CH 9:39" /><verse number="40" style="v" sid="1CH 9:40" />Liráü Yónatan: Meribü-baali, le lúguchi Mikaíasi. <verse eid="1CH 9:40" /><verse number="41" style="v" sid="1CH 9:41" />Lirahüñü Mikaíasi: Pitón, Mélekü, Tareá luma Aasi. <verse eid="1CH 9:41" /><verse number="42" style="v" sid="1CH 9:42" />Aasi meha lúguchibei Hará, Hará lúguchi Alemetü, Asümáweti luma Simürí; Simürí lúguchi Mosá, <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" />Mosá lúguchi Biná, Biná lúguchi Refaíasi, Refaíasi lúguchi Elasá, Elasá lúguchi Aseli.<verse eid="1CH 9:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="1CH 9:44" />Sísiñanu meha lirahüñü Aseli: Asürikámü, Bokurú, Ísümaeli, Searíasi, Abüdíasi luma Anán. Añahán lirahüñübaña Aseli.<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="ms">II. Larúeihan Dawidi</para>
  <para style="mr">(<ref loc="1CH 10-29">10—29</ref>)</para>
  <para style="s1">Lounwen Saulu hama lirahüñü lidan wuribu</para>
  <para style="r">(<ref loc="1SA 31:1-13">1 Sam 31.1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />Aba hageindagun Filistéana hama Ísüraelina, aba héibaagun Ísüraelina hawéi, ladüga gíbetiña hádangiñe óunwegutiña luagu wübü Gilübóa. <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" />Aba héibaahani Filistéana Saulu hama lirahüñü, aba háfaruni Yónatan, Abinadábü luma Malükisúa. <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" />Lárigiñe aba hageindagun lúmarügü Saulu, aba hímiruni, chügua hagía gimara luagun. <verse eid="1CH 10:3" /><verse number="4" style="v" sid="1CH 10:4" />Ábati lariñagun lun le anaahabarun lárumate:</para>
  <para style="p" vid="1CH 10:4">—Sagaboun befeinte, miraguabána tau, miabin hamaamuga gibe tubungiutegu ha áhurera nau.</para>
  <para style="p" vid="1CH 10:4">Gama lumoun máhati láfaruni ladüga lanufude. Ábati lárügüdünu Saulu lefeinte, aba lígiraguagüdün lungua tuagun. <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />Dan larihinbei le íderagubalin Saulu luagu hilá lan, aba giñe lígiraguagüdün lungua tuagun lefeinte, aba lounwen. <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />Ítara liña lounwen Saulu weyu ligía, ǘrüwa lirahüñü hama sun liduheñu. <verse eid="1CH 10:6" /><verse number="7" style="v" sid="1CH 10:7" />Danti harihinbei sun Ísüraelina ha meha aganóubaña lidan fulasu wayati luagu anuraha lan, ani hilá lan Saulu hau lirahüñü aba hígiruni uburugu aba giñe hanurahan. Ábati hayabin Filistéana aba herederun aganóua haburuguterugu Ísüraelina hagía.<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8" />Larugan, dan le houdin Filistéana asagarahaña hilaguaaña, aba hadariruni Saulu hama lirahüñü riwagu luagu wübü Gilübóa. <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />Ábati haragachunu ladaüragun luéi, aba hanügüni lichügü tuma lárumate, aba hóunahan láutiña uganu lidoun sun lumúan Filistéa lun hasubudiragüdüni houn sun lílana fulasu luma houn habungiutegu. <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />Lárigiñe aba híchugunu lárumate Saulu hatenpulunrugun habungiutegu, aba hadibiragüdüni lichügü litenpulunrugu Dagón.<verse eid="1CH 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11" />Dan le haganbunbei lílana Habesi le lani Galaadü luagu le hadügübei Filistéana lun Saulu, <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />aba húaradun sun wügüriña ha ganigibaña, aba hanügüni lúgubu Saulu luma hágubu lirahüñü uburugun Habesi. Aba hábununiña ñein tábugiñe aban tídibu wewe. Lárigiñe aba hayunarun sedü weyu.<verse eid="1CH 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13" />Ítara liña lounwen Saulu ladüga lisalufurin, lugundun afigouhati lau ladüraaguni le lubeibei Bungiu, luma lau lálügüdahan tuma aban garíaahatu <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />lubaragiñe hamuga lálügüdahan luma Bungiu. Ligía lébubei lagidaruni Bungiu libagari, aba líchuguni arúeihani lun Dawidi le liráü Hesé.<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s1">Dawidi lurúeite Ísüraeli luma Hudá</para>
  <para style="r">(<ref loc="2SA 5:1-5">2 Sam 5.1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />Aba hóundaragun sun Ísüraelina aba houdin Ebürón adimureha luma Dawidi. Hariñaga lun:</para>
  <para style="p" vid="1CH 11:1">—Ábanmeme gürigia wagía buma, <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />lau sun Saulu lan meha urúeibei, buguyaha adundehabalin Ísüraeli dan le láfuridun ageindagua. Ani ariñagaali giñe Bungiu le Bubungiute bun luagu buguyaba lan alidihaña lílana Ísüraeli le lageira.<verse eid="1CH 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3" />Ñǘbuintiña sun wéiyaaña mutu ha lílana Ísüraeli adimureha luma Dawidi Ebürón, aba ladügün aban daradu hama, líchigei Bungiu keisi gefenti. Ábati hanúadiruni Dawidi keisi lurúeite Ísüraeli, kei meha füramasegüdalani Bungiu lun Samueli.<verse eid="1CH 11:3" /></para>
  <para style="s1">Lárügüdüni Dawidi uburugu gabarieirunti le Sionbei</para>
  <para style="r">(<ref loc="2SA 5:6-10">2 Sam 5.6-10</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />Aba lidin Dawidi hau sun Ísüraelina Herusalén lememe Hebusu. Lidan meha fulasu ligía haganawa Hebusuna, <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" />ábati hariñagun lun Dawidi:</para>
  <para style="p" vid="1CH 11:5">—Mebelubadibu ñahoun.</para>
  <para style="p" vid="1CH 11:5">Gama lumoun aba lárügüdüni Dawidi uburugu gabarieirunti le Sionbei, le gíribei luburugute Dawidi guentó. <verse eid="1CH 11:5" /><verse number="6" style="v" sid="1CH 11:6" />Ariñagaali méhati Dawidi:</para>
  <para style="p" vid="1CH 11:6">—Le ábürühati furumiñe hawagun Hebusuna, níchugubei lun ligía lan furumiñeti ábuti.</para>
  <para style="p" vid="1CH 11:6">Hoabü le liráü Seruiá, ligía ábürühabei hawagun furumiñe aba lichugún ábutime. <verse eid="1CH 11:6" /><verse number="7" style="v" sid="1CH 11:7" />Lárigiñe aba laranseragun Dawidi lungua lidan uburugu gabarieirunti; ligía hariñagunbei lun luburugute Dawidi. <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" />Aba lachawaraguni Dawidi uburugu bóugudin geyegua lau baríeiru, ánheinti Hoabü ábaya lararamagüdüni le líbiri uburugu. <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" />Aba aganwoundeina lan lubafu Dawidi ani ñeinñein meha Aburemei Suntigabafu luma.<verse eid="1CH 11:9" /></para>
  <para style="s1">Habuidun-agei lisudaranigu Dawidi</para>
  <para style="r">(<ref loc="2SA 23:8-39">2 Sam 23.8-39</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />Añahán habuidun-agei lisudaranigu Dawidi, ha lúmagiñebaña lidan larúeihan, ha úaradubaña hama sun Ísüraelina lun híchuguni urúeime, kei meha lasubudiragüdüni Bungiu houn Ísüraelina.<verse eid="1CH 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 11:11" />Anihán hiri habuidun-agei lisudaranigu Dawidi: Hasobeámü, le liráü Akümoní, hábuti ǘrüwa ha ganigitimabaña, le áfarubei ǘrüwa-san wügüriña luagu aban dan lau larufunte. <verse eid="1CH 11:11" /><verse number="12" style="v" sid="1CH 11:12" />Lárigiñe Hasobeámü, Eleasárü, le liráü Dodó, le Aoita, le ábanbei hádangiñe ǘrüwa ha ganigitimabaña. <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />Ñeinñein meha luma Dawidi Pasü-damimü, dan le hóundaragunbei Filistéana ñein lun wuribu. Ñeinñein meha aban ichari bunawaguati lau sebada, danti le héibaagunbei súdaragu Ísüraelina hawéi Filistéana, <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />aba lararamun lamidangua ichari ligía, aba lageindagun hámagiñe Ísüraelina, aba láfaraguniña Filistéana. Ítara liña lagañeiragüdüni Bungiu wuribu houn.<verse eid="1CH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15" />Luagu aban weyu, aba houdin ǘrüwa hádangiñe darandi ganigitiña luagu dübü adunragua luma Dawidi lidan lagadábugiñe dübü le Adulámü. Ñeinñoun hakianpun-agei súdaragu Filistéana luagu fulasu wayati le gíribei Refaímü. <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />Ñéinñeinti Dawidi lidan uburugu gabarieirunti, sun añaha lan fiu súdaragu Filistéana Belén. <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" />Lariñagati Dawidi:</para>
  <para style="p" vid="1CH 11:17">—Nadariradügü hamuga kaba lan íchiga duna le lídangiñeti fusu le Belenbei nun lun natun!<verse eid="1CH 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 11:18" />Ábati hebelurun ǘrüwa ganigitiña hagía tidoun hakianpun-agei Filistéana, aba hadaburun duna lídangiñe fusu le lubenaribei Belén, aba hanügüni lun Dawidi. Gama lumoun máhati Dawidi látuni, ábarüga láwiyuruni keisi idewesei lun Aburemei, <verse eid="1CH 11:18" /><verse number="19" style="v" sid="1CH 11:19" />lariñaga:</para>
  <para style="p" vid="1CH 11:19">—Sefulána Bungiu luéi nátuni duna le! Kéigubeirügü hamuga nátuñein lan hata wügüriña ha, lugundun ru hamuti habagari lidoun denchaü lun houdin adaburei!</para>
  <para style="p" vid="1CH 11:19">Máhati lun látuni.</para>
  <para style="p" vid="1CH 11:19">Anihán asusereduti le, ǘrüwa ganigitiña adügübalin.<verse eid="1CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20" />Awisái, le líbugaña Hoabü, ligía meha hábutibei darandi ganigitiña hagía. Luagu aban dan, aba lageindagun hama ǘrüwa-san wügüriña tau lefeinte, aba láfaraguniña. Ítara liña laganbahoun luagu hadan darandi ganigitiña. <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />Ani ibihati saragutima uéiriguni sügǘ hau sun hagía, ñǘbuinti lun hábutibei lan. Gama lumoun machülüti lun ítarabei lan kei ha furumiñetiña ǘrüwa.<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22" />Benaíasi, le liráü Hoyadá, le Kabüséelina, aban meha wügüri ganigiti, áfarati bián hígandei Moábüna, hanarimeti laganbahóuniwa hawagu. Luagu aban weyu dan le lábürühaña lubéi niewe, aba laragachun lidoun aban fusu mábeiti, aba láfarun aban liñún ñein. <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />Áfarati giñe aban Ehiptuna gágubuti, yarafa lun bián méturu dimí liñun, ñeinñoun aban eféin luma kamá hamuga agouhagülei. Aba lidin Benaíasi luagun lau aban wewe, aba lagidarunu lefeinte luéi, aba láfaruni tau guánarügü. <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />Lau ladügüni Benaíasi katei le, aban laganbahóuntima luagu hadan darandi ganigitiña; <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />ani ibihatimati uéiriguni sügǘ hau, gama lumoun machülüti ítarada kei ha furumiñetiña ǘrüwa. Aba líchuguni Dawidi lun ligía lan hábuti súdara ha óunigirubalin.<verse eid="1CH 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 11:26" />Anihán hiri ha ganigibaña: Asaeli, le lamulen Hoabü; Elanán, le liráü Dodó le Belenna; <verse eid="1CH 11:26" /><verse number="27" style="v" sid="1CH 11:27" />Samotu, le Aroduna; Elesi, le Palütíta; <verse eid="1CH 11:27" /><verse number="28" style="v" sid="1CH 11:28" />Irá, le liráü Ikesi, le Tekoana; Abieserü, le Anatótuna; <verse eid="1CH 11:28" /><verse number="29" style="v" sid="1CH 11:29" />Siwekái, le Usaana; Ilái, le Aoita; <verse eid="1CH 11:29" /><verse number="30" style="v" sid="1CH 11:30" />Maarai, le Netofána; Éledi, le liráü Baaná, Netofána giñe; <verse eid="1CH 11:30" /><verse number="31" style="v" sid="1CH 11:31" />Itái, le liráü Ribái, le Gibeana, le lumúanrugubei Benhamín, Benaíasi, le Piratónna; <verse eid="1CH 11:31" /><verse number="32" style="v" sid="1CH 11:32" />Idái, le Gáasüna; Awieli, le Arübátüna; <verse eid="1CH 11:32" /><verse number="33" style="v" sid="1CH 11:33" />Asümáweti, le Baurimüna; Eliabá, le Saalübónna; <verse eid="1CH 11:33" /><verse number="34" style="v" sid="1CH 11:34" />lirahüñü Hasén, le Gisonna; Yónatan, le liráü Sagé, le Ararátüna, <verse eid="1CH 11:34" /><verse number="35" style="v" sid="1CH 11:35" />Ayamü, le liráü Sakarü, Ararátüna giñe, Elifáli, le liráü Uru; <verse eid="1CH 11:35" /><verse number="36" style="v" sid="1CH 11:36" />Éferü, le Mekerátüna; Aíasi, le Pelonna; <verse eid="1CH 11:36" /><verse number="37" style="v" sid="1CH 11:37" />Esürái, le Karümélina, Naarái, le liráü Esübái; <verse eid="1CH 11:37" /><verse number="38" style="v" sid="1CH 11:38" />Hoeli, le lamulen Natán; Mibarü, le liráü Agürái; <verse eid="1CH 11:38" /><verse number="39" style="v" sid="1CH 11:39" />Sélekü, le Amonna, Naarái, le Beerotuna, le anaahabarun lárumate Hoabü, le liráü Seruiá; <verse eid="1CH 11:39" /><verse number="40" style="v" sid="1CH 11:40" />Irá, le Hatirüna, Garebü, le giñe Hatirüna; <verse eid="1CH 11:40" /><verse number="41" style="v" sid="1CH 11:41" />Uríasi, le Étüna; Sawadü, le liráü Alai; <verse eid="1CH 11:41" /><verse number="42" style="v" sid="1CH 11:42" />Adiná, le liráü Sisá, le ladügawagun Rubén, le hábuti ladügawagun Rubén, hama darandi wügüriña luma; <verse eid="1CH 11:42" /><verse number="43" style="v" sid="1CH 11:43" />Anán, le liráü Maaká; Hosafátü, le Mitüníta; <verse eid="1CH 11:43" /><verse number="44" style="v" sid="1CH 11:44" />Usíasi, le Asütarótuna; Samá luma Heieli, ha lirahüñü Otamü, le Aroerüna. <verse eid="1CH 11:44" /><verse number="45" style="v" sid="1CH 11:45" />Hediaeli, le liráü Simürí, luma Hoá le lamulen, le Tisita; <verse eid="1CH 11:45" /><verse number="46" style="v" sid="1CH 11:46" />Elieli, le Manaímüna; Herebái, luma Hosawía, lirahüñü Elináamü, Itümá le Moábüna; <verse eid="1CH 11:46" /><verse number="47" style="v" sid="1CH 11:47" />Elieli, Owedi luma Haasieli Sobana.<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s1">Súdaragu ha luéigiñebaña lóubadina Dawidi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 12:1" />Dan meha le anihagua lubéi Dawidi aramudagu luéi Saulu le liráü Kisü, aba houdin fiu wügüriña ganigitiña ha lúnbaña lánigubaña lan óundaragua luma yágüta Sikülágü. <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />Wügüriña wuriburuguna hagía, aranseñu haña tau hagimaran, gachüühadi haña dübü tau chilinchádi,<note caller="1" style="f"><char style="fr" closed="false">12.2 </char><char style="ft" closed="false">Chilinchádi: Mítarantu kei to warihiboun uguñe weyu, yübu meha cháwarügüti dübü tidoun lárigiñe aba tagarahóuniwa danti ragüharu hedi aba lígirawagüdüniwa dübü.</char></note> gachüühadi gimara, dandu lau hóunwenren kei lau habaünan. Anihán hiri:</para>
  <para style="p" vid="1CH 12:2">Liduheñu Saulu, hádangiñe lani Benhamín türibu: <verse eid="1CH 12:2" /><verse number="3" style="v" sid="1CH 12:3" />Aieserü, le ábuti luma Hoasi, ha lirahüñü Semaá le lílana Gibeá; Hesieli luma Péletü, lirahüñü Asümáweti; Beraká luma Heú le Anatótuna; <verse eid="1CH 12:3" /><verse number="4" style="v" sid="1CH 12:4" />Isümaíasi, le Gabaónna, aban hádangiñe darandi ganigitiña ani le giñe hábuti; Heremíasi, Haasieli, Hoanán; Hosabádü, le Gederáana, <verse eid="1CH 12:4" /><verse number="5" style="v" sid="1CH 12:5" />Elusái, Herimótu, Bealíasi, Semaríasi; Sefatíasi, le Arufíta; <verse eid="1CH 12:5" /><verse number="6" style="v" sid="1CH 12:6" />Elikaná, Isíasi, Asaréli, Hoéserü luma Hasobeámü ha ladügawagun Koré; <verse eid="1CH 12:6" /><verse number="7" style="v" sid="1CH 12:7" />Hoelá luma Sewadíasi, ha lirahüñü Heroamü le Gedoruna.<verse eid="1CH 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8" />Sügütiña giñe fiu hádangiñe lani Gadü türibu lumoun Dawidi dan meha le lidan lan uburugu gabarieirunti le lídanbei fulasu mageirawati. Wügüriña meha wuriburuguna hagía, ha ganigitiña, aranserúatiña lubá wuribu, lau hadaüdina tuma hefeinte. Haganóun kamá liñún, furesetiña áraabu kei usari. <verse eid="1CH 12:8" /><verse number="9" style="v" sid="1CH 12:9" />Anihán hiri: Éserü, furumiñeti; Abüdíasi habiaman; Eliabü, háürüwan; <verse eid="1CH 12:9" /><verse number="10" style="v" sid="1CH 12:10" />Misümaná hagadürün; Heremíasi haseingün; <verse eid="1CH 12:10" /><verse number="11" style="v" sid="1CH 12:11" />Atái hasisin; Elieli hasedün; <verse eid="1CH 12:11" /><verse number="12" style="v" sid="1CH 12:12" />Hoanán hawidün; Elisabádü hanefun. <verse eid="1CH 12:12" /><verse number="13" style="v" sid="1CH 12:13" />Heremíasi hadiisin; Makübanái haunsun. <verse eid="1CH 12:13" /><verse number="14" style="v" sid="1CH 12:14" />Ladügawagun meha Gadü ha, hábutigu meha súdaragu. Lérügü amuleñein hadan gebegiti kei hebegi san wügüriña, le íbugañaü gebegiti kei hebegi milu. <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" />Hagía ánhiñuragunbalin Hordán lidan furumiñeti lihatiri irumu, dan le buin liña lubéi duna, aba hanuraagüdüniña sun ha lídanbaña fulasu wayati luagun oubaü le ñéingiñe lubéi laboucha weyu luma luagun le ñeinhin lubéi lálüda.<verse eid="1CH 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16" />Ñǘdüntiña giñe fiu wügüriña hádangiñe lani Benhamín luma hádangiñe lani Hudá türibu lumoun Dawidi lidoun uburugu gabarieirunti. <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" />Aba láfuridun Dawidi habaroun, lariñaga houn:</para>
  <para style="p" vid="1CH 12:17">—Anhein hiábiña lubéi lau darangilaü lun híderagunina, gúndaatina tau sun nanigi lun hóundarun numoun; gama lumoun anhein hiábiña lubéi lun heyeedunina, lun hederegerunina houn náganiñu, lau sun madügüngidina lan wuribati, arihaléi Aburemei le Habungiute wagüchagu ani beilaün!<verse eid="1CH 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18" />Ábati lebelurun Sífiri lidoun Amasái, le hábuti darandi, aba lariñagun:</para>
  <para style="b" vid="1CH 12:18" />
  <para style="q" vid="1CH 12:18">«Darangilaü bun, Dawidi, liráü Hesé!</para>
  <para style="q" vid="1CH 12:18">Bumalá darangilaü!</para>
  <para style="q" vid="1CH 12:18">Darangilaü bun luma houn ha íderagutibu,</para>
  <para style="q" vid="1CH 12:18">lugundun íderagua láadibu Bubungiute!»</para>
  <para style="b" vid="1CH 12:18" />
  <para style="p" vid="1CH 12:18">Aba leresibiruniña Dawidi, aba líchugun ubaraü houn hadan hábutigu súdaragu.<verse eid="1CH 12:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19" />Ñéinñanu giñe fiu hádangiñe lani Manasési türibu ásügürütiña lumoun Dawidi dan le lídinbei aganawa hama Filistéana lun lageindagun luma Saulu, lau sun siñá lan meha líderaguniña Dawidi Filistéana, ladüga lárigi hóundaragun ábutigu Filistéana aba habuguni Dawidi hawariua, hariñaga: «Lásügürüba le wawéi lumoun Saulu le labureme!» <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" />Añahán hádangiñe lani Manasési türibu ha ásügürübaña lumoun Dawidi dan le lídinbei Sikülágü: Adüná, Hosabádü, Hediaeli, Mikaeli, Hosabádü, Eliú, Siletái hábutigu lisudaranigu Manasési. <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" />Hagía ha íderagubalin Dawidi wuriburugu lugundun wuriburuguna ganigitiña sun hagía, chülütiña hábutigume súdaragu. <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />Sagü weyu haganwoundun lánigu Dawidi darí lun hagibedagun.<verse eid="1CH 12:22" /></para>
  <para style="s1">Lisudaranigu Dawidi</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 12:23" />Añahán sun ha óundarubaña lumoun Dawidi Ebürón lun hawuribuhan luéigiñe lóubadina, lun hásügüragüdüni larúeihan Saulu lun, según lilurudun Aburemei: <verse eid="1CH 12:23" /><verse number="24" style="v" sid="1CH 12:24" />Hádangiñe lani Hudá türibu, sisi-milu-widü-san wügüriña lau burí idaüdinaü tuma eféin, aranseñu lun wuribu. <verse eid="1CH 12:24" /><verse number="25" style="v" sid="1CH 12:25" />Hádangiñe lani Simeón türibu: Sedü-milu-san wuriburuguna ganigitiña aranseñu lun wuribu. <verse eid="1CH 12:25" /><verse number="26" style="v" sid="1CH 12:26" />Hádangiñe lani Lewí türibu: Gádürü-milu-sisi-san, <verse eid="1CH 12:26" /><verse number="27" style="v" sid="1CH 12:27" />hámaya ǘrüwa-milu-sedü-san hádangiñe liduheñu Aarón, Hoyadá hábuti; <verse eid="1CH 12:27" /><verse number="28" style="v" sid="1CH 12:28" />luma Sadoku, wügüri nibureingili, ani wuriburuguna ganigiti, hama wein-biama hábutigu liduheñu. <verse eid="1CH 12:28" /><verse number="29" style="v" sid="1CH 12:29" />Hádangiñe lani Benhamín türibu, hameme lani Saulu türibu, ǘrüwa-milu wügüriña, lugundun lidan oura ligía lúmagiñeñanu Saulu ha hiibe-agei. <verse eid="1CH 12:29" /><verse number="30" style="v" sid="1CH 12:30" />Hádangiñe lani Éfürain türibu, wein-milu-widü-san wuriburuguna ganigitiña, díseti laganbahoun hawagu. <verse eid="1CH 12:30" /><verse number="31" style="v" sid="1CH 12:31" />Hádangiñe hamidan lani Manasési türibu, disiwídü-milu wügüriña, ha iridúbaña lun houdin lun híchuguni Dawidi urúeime. <verse eid="1CH 12:31" /><verse number="32" style="v" sid="1CH 12:32" />Hádangiñe lani Isakárü türibu, bián-san ábutigu hau sun wügüriña ha lílana hani türibu lábugiñe hagumadin, ábutigu hagía, subudi hamutiha ka lan lunbei hadügüni Ísüraelina luma dan le ídanba lubéi ladügǘwa. <verse eid="1CH 12:32" /><verse number="33" style="v" sid="1CH 12:33" />Hádangiñe lani Sabulón türibu, dimí-san-milu súdaragu aranseñu lun wuribu, tau sun tuwuyeri áruma, deregeguñu houngua lun híderaguni Dawidi. <verse eid="1CH 12:33" /><verse number="34" style="v" sid="1CH 12:34" />Hádangiñe lani Nefütalí türibu, milu ábutigu hau darandi-sedü-milu wügüriña lau arufun tuma idaüdinaü. <verse eid="1CH 12:34" /><verse number="35" style="v" sid="1CH 12:35" />Hádangiñe lani Dan türibu, wein-widü-milu-sisi-san súdaragu. <verse eid="1CH 12:35" /><verse number="36" style="v" sid="1CH 12:36" />Hádangiñe lani Aserü türibu, bián-wein-milu súdaragu aranseñu lun wuribu. <verse eid="1CH 12:36" /><verse number="37" style="v" sid="1CH 12:37" />Loubafurugugiñe Hordán, san-wein-milu wügüriña hádangiñe türibu ha lani Rubén luma Gadü, hama hádangiñe hamidan lani Manasési türibu, tau sun tuwuyeri áruma.<verse eid="1CH 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 12:38" />Sun wuriburuguna ha, aba houdin Ebürón aranseñu lun híchuguni Dawidi lurúeiteme sun Ísüraeli; sunti ha híbiri Ísüraelina aranseñu haña giñe lun hadügüni ítara. <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />Rédeitiña ǘrüwa weyu luma Dawidi ñein, eiga gurá hagía, kei buga aranseña lubéi hapaisanun habá. <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />Bóugudin luéi lira, barütiña habesinanigu, hama ha lánigu Isakárü, Sabulón luma Nefütalí éigini houn hanagawagu burigü, kameyu, mile hama bágasu wügüriña. Barütiña saragu éigini houn: Fulúaru, durudia tautu igu, beibei sáüharu, diwéin, bágasu hama mudún, gíbeti hanügün houn ladüga ñeinñein saragu ugundani Ísüraeli.<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s1">Lasaminarun Dawidi lanügünu bágüsi lun Herusaléun</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />Fiu dan lárigiñe aba lálügüdagun Dawidi lungua hama sun ábutigu, <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />lárigiñe aba lariñagun houn sun lílana Ísüraeli:</para>
  <para style="p" vid="1CH 13:2">—Anhein mariban lubéi larihín hun, anhein busén Wabureme le Wabungiute, óunaha wamá awisaraña wapaisanun ha añaheinguabaña lidan líbiri fulasu Ísüraeli, hama giñe fádirigu hama Lewitagu ha haburuguterugubaña luma lidan múa le ñein lubéi hameiliha animaalugu, amisurahaña lun hóundarun wamoun. <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />Lun wanügünu lubagüsin Wabungiute, lugundun bulíeiguaadiwa tuéi lúmagiñe lidaani Saulu.<verse eid="1CH 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 13:4" />Aba hánharun sun lílana fulasu lun ladügǘniwa ítara, ani maribanti lábürühan saminaü le houn súngubei.<verse eid="1CH 13:4" /></para>
  <para style="s1">Lóuchagun Dawidi lanügünu lubagüsin Aburemei</para>
  <para style="r">(<ref loc="2SA 6:1-11">2 Sam 6.1-11</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5" />Aba lóundaruniña Dawidi sun Ísüraelina lúmagiñe Sioru lidan fadaguaü luma Ehiptu darí lubenari Amatü, lun tanügün lubagüsin Aburemei Kiriatü-hearimügiñe lun Herusaléun. <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" />Lárigiñe, hau sun Ísüraelina úara luma, aba houdin Kiriatü-hearimü, lememe Baalá lóubawagu Hudá, lun hanügünu lubagüsin Aburemei ñéingiñe to uáguboun laguarúa liri Wabureme le gámabalin lálana larúeihan hagibuagu kátaña garünatiña. <verse eid="1CH 13:6" /><verse number="7" style="v" sid="1CH 13:7" />Aba híchugunu bágüsi tidoun aban kareta iseri, aba hanügünu lúbiñegiñe Aminadábü. Usá luma Ayó hagía abugurubarun kareta. <verse eid="1CH 13:7" /><verse number="8" style="v" sid="1CH 13:8" />Sunti dan le, aningirán bugati Dawidi hau sun Ísüraelina eremuheina luma abinaheina lau sun here ligibugiñe Aburemei, áfareina híbiri árüpa, panderu, pülatíyu luma íñaaheina fidu. <verse eid="1CH 13:8" /><verse number="9" style="v" sid="1CH 13:9" />Dan hachülürünbei lidan fulasu le asubudirúabei kei léfereegüle Kidón türigu, aba línchuni Usá lúhabu lun lágüdahanu bágüsi ladüga hachugeragun bágasu ha achawahabarun karü. <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" />Gama lumoun aba lagañidun Aburemei luma Usá luéigiñe línchuni lúhabu tuagun bágüsi, aba lagidaruni libagari ñein guánarügü.<verse eid="1CH 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11" />Ábati lagañidun Dawidi saragu luéigiñe lagidaruni Aburemei libagari Usá, ligía líchugunbei Péresi-usá lírime fulasu ligía, ligía líribei chülǘ lumoun dan le. <verse eid="1CH 13:11" /><verse number="12" style="v" sid="1CH 13:12" />Gama lumoun weyuméme ligía, aba lanufudedun Dawidi saragu ligibugiñe Aburemei aba lagúaragun ariñaga:</para>
  <para style="p" vid="1CH 13:12">—Kaba numegen anügoun lubagüsin Aburemei núbiñoun!<verse eid="1CH 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 13:13" />Manügǘntu lubeiti bágüsi luburuguterugun Dawidi, aba lariñagun lun tanügün lúbiñoun Owedi-edomu, aban wügüri le uburuguna Gatü. <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />Rédeitu lubagüsin Bungiu ǘrüwa hati lúbiñe Owedi-edomu. Aba labiniruniña Aburemei liduheñu Owedi-edomu lau sun le lánibei.<verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s1">Lóunahan Iramü wügüriña lau uganu lun Dawidi</para>
  <para style="r">(<ref loc="2SA 5:11-12">2 Sam 5.11-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />Aba lóunahan Iramü le lurúeite Tiru wügüriña lau uganu lun Dawidi, bóugudin hawéi ábunagutiña muna, hama sarafangei lau wewe le hibúari lun hábunagunu palasiu lun. <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" />Ábati gunfuranda lani Dawidi luagu ru laali lan Aburemei lurúeiteme Ísüraeli, ladüga awansegüda laali larúeihan saragu hadan Ísüraelina ha lumutuniña.<verse eid="1CH 14:2" /></para>
  <para style="s1">Lirahüñü Dawidi ha águrahoubaña Herusalén</para>
  <para style="r">(<ref loc="2SA 5:13-16">2 Sam 5.13-16</ref>; <ref loc="1CH 3:5-9">1 Kro 3.5-9</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3" />Aba lamarieidun Dawidi hama amu würiña Herusalén, aba haganwoundun lirahüñü. <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />Lirahüñü ha águrahoubaña Herusalén: Samúa, Sobabü, Natán, Salomón, <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" />Ibarü, Elisúa, Elipéleti, <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" />Noga, Néfegü, Hafía, <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" />Elisamá, Eliadá luma Eliféletü.<verse eid="1CH 14:7" /></para>
  <para style="s1">Lagañeiruniña Dawidi Filistéana</para>
  <para style="r">(<ref loc="2SA 5:17-25">2 Sam 5.17-25</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />Dan hasubudirunbalin Filistéana luagu lurúeitehali lan sun Ísüraeli Dawidi, aba houdin sun hagía áluahei; gama lumoun aba lasubudiruni Dawidi, aba láfuridun habaroun. <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" />Ábati hawanserun Filistéana aba hebelurun luéigiñe fulasu wayati le lani Refaímü. <verse eid="1CH 14:9" /><verse number="10" style="v" sid="1CH 14:10" />Ligía lébubei lálügüdahan Dawidi luma Aburemei, lariñaga lun:</para>
  <para style="p" vid="1CH 14:10">—Gayaraati san nageindagun hama Filistéana? Bagañeiragüdübei san wuribu nun?</para>
  <para style="p" vid="1CH 14:10">Lariñaga Aburemei lun:</para>
  <para style="p" vid="1CH 14:10">—Bageindagua hama, nagañeiragüdübei wuribu bun.<verse eid="1CH 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11" />Aba lamudeirun Dawidi Baali-perasímü, ageindagua hama, aba lagañeiruni wuribu. Ligía lébubei lariñagun:</para>
  <para style="p" vid="1CH 14:11">—Daraali Aburemei üma nun habadinaguagiñe náganiñu kei lásügürün duna héreti.</para>
  <para style="p" vid="1CH 14:11">Aba hagúaruni fulasu ligía Baali-perasímü. <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" />Ígira hamutiña giñe Filistéana habungiutegu, aba lóunahan Dawidi águdaña.<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13" />Gama lumoun ábaya hebelurun Filistéana luéigiñe fulasu wayati le lani Refaímü, <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" />ábayati lálügüdahan Dawidi luma Aburemei, lariñaga Aburemei lun:</para>
  <para style="p" vid="1CH 14:14">—Mageindaguabá hama hagibugiñegiñe, geyeguabaña, ábame bábürühan hawagun hanagangiñe danme bachülürün lumoun burí tídibu bálüsamu. <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />Danme baganbun areinchuni lóugiñe tídibu wewe, gumesebá ageindagua, lugundun larufuduñein lira luagu anangüra lan bubá bubá lun náfaraguniña súdaragu Filistéana.<verse eid="1CH 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 14:16" />Aba ladügüni Dawidi le lariñagubei Aburemei lun, aba láfaraguniña Filistéana lúmagiñe Gabaóngiñe darí Géserü. <verse eid="1CH 14:16" /><verse number="17" style="v" sid="1CH 14:17" />Ábati laganbahoun luagu Dawidi lidan sun burí fulasu, aba ladügün Aburemei lun hanufudedun sun néchanigu luéi.<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s1">Lanügünu Dawidi lubagüsin Aburemei Herusaléun</para>
  <para style="r">(<ref loc="2SA 6:12-23">2 Sam 6.12-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />Aba lábunaguagüdün Dawidi muna burí lungua lidan uburugu le gíribei Dawidi, aranse ligía aban ubaraü tun lubagüsin Aburemei tidan aban kianpu to lararamagüdüboun. <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />Ábati lariñagun:</para>
  <para style="p" vid="1CH 15:2">—Ua hamá amu lun hanaahanu lubagüsin Aburemei haweidigia Lewitagu, lugundun anúadira laaña Aburemei lun hanaahanu lubagüsina daradu luma lun heseriwidun lun súnwandan.<verse eid="1CH 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3" />Lárigiñe aba lóundaruniña sun Ísüraelina uburugu Herusalén lun hanügünu lubagüsin Aburemei lidoun fulasu le laranserubei tubá. <verse eid="1CH 15:3" /><verse number="4" style="v" sid="1CH 15:4" />Óundara lumutiña giñe ladügawagun Aarón hama Lewitagu. <verse eid="1CH 15:4" /><verse number="5" style="v" sid="1CH 15:5" />Hádangiñe ladügawagun Keatü, óundaraguatiña san-wein: Urieli, le ábuti hama liduheñu. <verse eid="1CH 15:5" /><verse number="6" style="v" sid="1CH 15:6" />Hádangiñe ladügawagun Merarí, bián-san-wein: Asaíasi le ábuti hama liduheñu. <verse eid="1CH 15:6" /><verse number="7" style="v" sid="1CH 15:7" />Hádangiñe ladügawagun Gerüsón, san-darandi: Hoeli le ábuti hama liduheñu. <verse eid="1CH 15:7" /><verse number="8" style="v" sid="1CH 15:8" />Hádangiñe ladügawagun Elisafán, bián-san: Semaíasi le ábuti hama liduheñu. <verse eid="1CH 15:8" /><verse number="9" style="v" sid="1CH 15:9" />Hádangiñe ladügawagun Ebürón, gádürü-wein: Elieli le ábuti hama liduheñu. <verse eid="1CH 15:9" /><verse number="10" style="v" sid="1CH 15:10" />Hádangiñe ladügawagun Usieli, san-duusu: Aminadábü le ábuti hama liduheñu.<verse eid="1CH 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11" />Lárigiñe aba lagúarun Dawidi lun Sadoku luma Abiatárü ha fádirigu, lun Urieli, Asaíasi, Hoeli, Elieli luma Aminadábü ha Lewitagu, <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />lariñaga houn:</para>
  <para style="p" vid="1CH 15:12">—Huguya le hábutigubei haduheñu Lewitagu, harumaguagüda humá hungua según igaburi huguya hau sun hiduheñu, lun gayaraabei lan hanügünu lubagüsin Aburemei, le Lubungiute Ísüraeli lidoun fulasu le naranserubei tubá; <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />lugundun kei madügün hubalin lidan furumiñeti wéiyaasu, aba lagidaruni Aburemei le Wabungiute habagari fiu wádangiñe, lugundun málügüdahan wamá luma lidan lubudubu.<verse eid="1CH 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 15:14" />Ábati harumadaguagüdün fádirigu hama Lewitagu houngua keisi igaburi lun gayara lan hanügünu lubagüsin Aburemei le Lubungiute Ísüraeli. <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" />Aba hanügünu ligibuagu bián wewe hégewagu, kei meha ligaburi lariñagagüdüni Aburemei lun Moisesi.<verse eid="1CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16" />Ariñagati giñe Dawidi houn hábutigu Lewitagu lun híchugun eremuhatiña ha áfarutiña sun tuwuyeri árüpa luma pülatíyu hádangiñe hani türibu, lun eremuheina hamá áfareina hagíame, lun harufuduni hagundan. <verse eid="1CH 15:16" /><verse number="17" style="v" sid="1CH 15:17" />Aba híriduni Lewitagu Emán, le liráü Hoeli, luma giñe Asafü, le liráü Berekíasi le liduhe Emán; hádangiñe ladügawagun Merarí, hama haduheñu ha furumiñebaña, lun Etán, liráü Kusaíasi; <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />iridúatiña giñe ámuya haduheñu ha furumiñebaña ha lánina libiaman gumadi hani eseriwidutiña: Sakaríasi, Haasieli, Semiramótu, Heieli, Uní, Eliabü, Benaíasi, Maseíasi, Matatíasi, Elifeléu, Meküneíasi, luma Owedi-edomu labu Heieli, ha óunigirubaña bénabu.<verse eid="1CH 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19" />Emán, Asafü luma Etán ha eremuhabaña, hagía etenirubaña lun háfaruni pülatíyu le lauti buronse. <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" />Sakaríasi, Asieli, Semiramótu, Heieli, Uní, Eliabü, Maseíasi luma Benaíasi, hagía áfarubaña sun tuwuyerigu árüpa kei háfarun ladügawagun Elamü. <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" />Ánheinti Matatíasi, Elifeléu, Meküneíasi, Owedi-edomu, Heieli luma Asasíasi, hagía áfarubaña árüpa kei ladügawagun Semü, agumeserei uremu. <verse eid="1CH 15:21" /><verse number="22" style="v" sid="1CH 15:22" />Kenaníasi, le hábuti Lewitagu, ligía arihubei lau uremu ladüga geremuhaditi wügüri ligía. <verse eid="1CH 15:22" /><verse number="23" style="v" sid="1CH 15:23" />Berekíasi luma Elikaná, hagía óunigirubarun bágüsi. <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" />Sewaníasi, Hosafátü, Natanaéli, Amasái, Sakaríasi, Benaíasi luma Elieserü ha fádirigu, hagía íñaahabarun fidu tigibugiñe lubagüsin Aburemei. Túniri giñe bágüsi Owedi-edomu luma Heiasi.<verse eid="1CH 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25" />Ábati lidin Dawidi, ábutigu Ísüraelina hama hábutigu súdaragu lau ugundani anügoun lubagüsina lidaradun Aburemei lúbiñegiñe Owedi-edomu. <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />Keiti íderagua lániña Aburemei Lewitagu ha anaahabarun bágüsi, aba háfarun sedü bágasu ñǘbürigiña hama sedü harahüñü mudún. <verse eid="1CH 15:26" /><verse number="27" style="v" sid="1CH 15:27" />Aban tidáü daüguaü to tautu linu fínutu luáguboun Dawidi, ítara giñe hadaüragun sun Lewitagu ha anügübarun bágüsi, eremuhatiña, luma Kenaníasi le abugurubalin uremu; ñeinñoun giñe aban Tidáü Dúnigu to tautu linu luagu Dawidi. <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />Ítara liña hanügünu sun Ísüraelina lubagüsina lidaradun Aburemei, agúaraheina, eremuheina, luma áfareina lau ugundani.<verse eid="1CH 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29" />Dan tachülürünbei lubagüsina lidaradun Aburemei luburuguterugun Dawidi, aba taganaridun Mikali, to liráü Saulu funederarugugiñe; dan tarihinbalin Dawidi abinaha lau ugundani, aba liyereegudun tun.<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1" />Aba tanügǘn lubagüsin Aburemei tidoun kianpu to lábunaguboun Dawidi tubá. Lárigiñe aba lichugúniwa adagaragüdüni gudawarügüti luma adagaragüdüni lánina arandaruni ligibugiñe Aburemei, <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" />lásurun ladagaragüdüni Dawidi, aba labiniruniña gürigia lidan liri Aburemei, <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />aba líchugun aban fein, aban durudia tautu lin yaraüwa tuma aban tautu pasa lun kada Ísüraelina, wügüriña würiña.<verse eid="1CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4" />Írida lumutiña Dawidi Lewitagu ha lúnbaña heseriwidun tigibugiñe lubagüsin Aburemei lun hagíaba lan íchiga eteingiruni luma eremuhani lun Aburemei le Lubungiute Ísüraeli. <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />Asafü, ligía ábutibei, lárigiñe, Sakaríasi, lárigiñe Heieli, Semiramótu, Heieli, Matatíasi, Eliabü, Benaíasi, Owedi-edomu luma Heieli, ha táubaña sun tuwuyerigu árüpa. Asafü áfarubalin pülatíyu. <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" />Benaíasi luma Haasieli ha fádirigu, hagía íñaahabaña fidu tigibugiñe lubagüsina lidaradun Aburemei.<verse eid="1CH 16:6" /></para>
  <para style="s1">Leremun Dawidi le lánina eteingiruni</para>
  <para style="r">(<ref loc="PSA 105:1-5">Sal 105.1-5</ref>; <ref loc="PSA 96:1-13">96.1-13</ref>; <ref loc="PSA 106:47-48">106.47-48</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7" />Lídanmeme weyu ligía lariñaga Dawidi luagu furumiñeti wéiyaasu lun líchugun Asafü hama lánigu eteingiruni lun Aburemei ítara.<verse eid="1CH 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="1CH 16:8" />«Ru humá eteingiruni lun Aburemei!</para>
  <para style="q" vid="1CH 16:8">Hadimureha luagu liri!</para>
  <para style="q" vid="1CH 16:8">Habahüdagua houn gürigia luagu sun le ladügübei.<verse eid="1CH 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="1CH 16:9" />Heremuha lidan liri.</para>
  <para style="q" vid="1CH 16:9">Hadimureha luagu burí luéinamun</para>
  <para style="q" vid="1CH 16:9">katei le ladügübei!<verse eid="1CH 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="1CH 16:10" />Hapantaha lau liri</para>
  <para style="q" vid="1CH 16:10">Gúndaata hanigi ha áluahabalin Aburemei!<verse eid="1CH 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="1CH 16:11" />Ñübuin humá lumoun Aburemei,</para>
  <para style="q" vid="1CH 16:11">áluaha huméi lubafu;</para>
  <para style="q" vid="1CH 16:11">ñübuin humá lumoun Aburemei súnwandan.<verse eid="1CH 16:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="1CH 16:12" />Haritagua humá luagun luéinamun</para>
  <para style="q" vid="1CH 16:12">luma lanarime burí katei le ladügübei</para>
  <para style="q" vid="1CH 16:12">luma burí le lariñagubei:<verse eid="1CH 16:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="1CH 16:13" />Huguya, ha ladügawagun Ísüraeli le lubúein Aburemei,</para>
  <para style="q" vid="1CH 16:13">huguya ha lirahüñü Hakobu,</para>
  <para style="q" vid="1CH 16:13">huguya ha lanúadirubaña.<verse eid="1CH 16:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="1CH 16:14" />Ligía Waburemebei le Wabungiute;</para>
  <para style="q" vid="1CH 16:14">ligía agumadihabei lidan sun ubóu!<verse eid="1CH 16:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="1CH 16:15" />Ni anhein ásügüra milu inebanfangu</para>
  <para style="q" vid="1CH 16:15">mabulieidun lubéi lidaradun,<verse eid="1CH 16:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="1CH 16:16" />daradu le buga ladügübei luma Abüraámü,</para>
  <para style="q" vid="1CH 16:16">fiñún le buga ladügübei lun Isaakü.<verse eid="1CH 16:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="1CH 16:17" />Ani gufirümalei keisi lúrudu lun Hakobu,</para>
  <para style="q" vid="1CH 16:17">keisi daradu magumuchaditi lun Ísüraeli,<verse eid="1CH 16:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="1CH 16:18" />dan le lariñagunbei:</para>
  <para style="q" vid="1CH 16:18">“Níchugubei Kanán bun keisi balagante”.<verse eid="1CH 16:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="1CH 16:19" />Lau sun meha mibe hamá,</para>
  <para style="q" vid="1CH 16:19">fiuraü terencha fulasurugu,<verse eid="1CH 16:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="1CH 16:20" />ha éibudügütiña lídangiñe aban néchani lidoun aban,</para>
  <para style="q" vid="1CH 16:20">lídangiñe aban arúeihani lidoun aban,<verse eid="1CH 16:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="1CH 16:21" />mígirunti Aburemei lun hamudirawagun;</para>
  <para style="q" vid="1CH 16:21">ariñagati houn urúeigu:<verse eid="1CH 16:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="1CH 16:22" />“Maguura humá hawagu ha anúadira náañabaña,</para>
  <para style="q" vid="1CH 16:22">móuseragun humañame nani profetagu”.<verse eid="1CH 16:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="1CH 16:23" />Heremuha lun Aburemei sun huguya lílana ubóu,</para>
  <para style="q" vid="1CH 16:23">hadimureha sagü weyu luagu lesefuhan.<verse eid="1CH 16:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="1CH 16:24" />Hadimureha luagu luéirigun</para>
  <para style="q" vid="1CH 16:24">hagibugiñe sun néchanigu,</para>
  <para style="q" vid="1CH 16:24">luma luagu katei buiti le ladügübei</para>
  <para style="q" vid="1CH 16:24">hagibugiñe sun gürigia.<verse eid="1CH 16:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="1CH 16:25" />Lugundun wéiriguti Aburemei</para>
  <para style="q" vid="1CH 16:25">ani garichati lun leremuhóun lun,</para>
  <para style="q" vid="1CH 16:25">hanarimeti hawéi sun búngiugu.<verse eid="1CH 16:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="1CH 16:26" />Ni kata búngiugu ha habungiutegu híbiri gürigia,</para>
  <para style="q" vid="1CH 16:26">ánheinti Wabureme, ligía adügübalin sielu.<verse eid="1CH 16:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="1CH 16:27" />Anihein óunwenbu larugounga liñúarü!</para>
  <para style="q" vid="1CH 16:27">Anihein ubafu luma ugundani lúbiñe.<verse eid="1CH 16:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="1CH 16:28" />Ru huméi liseinsuna gumadi lun Aburemei</para>
  <para style="q" vid="1CH 16:28">ru huméi ubafu luma uéiriguni lun Bungiu;<verse eid="1CH 16:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="1CH 16:29" />ru huméi uéiriguni le ladünabei Aburemei lun</para>
  <para style="q" vid="1CH 16:29">chülǘ humá lumoun lau idewesei,</para>
  <para style="q" vid="1CH 16:29">hudugua humá lun Aburemei tidan tuenden lisanduariun.<verse eid="1CH 16:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="1CH 16:30" />Adadagaralá sun ubóu ligibugiñe!</para>
  <para style="q" vid="1CH 16:30">Ligía ederebudagüdübalin ubóu lun mánhingichun lan.<verse eid="1CH 16:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="1CH 16:31" />Gundaagualá sielu luma ubóu!</para>
  <para style="q" vid="1CH 16:31">Ariñaga hamá néchanigu:</para>
  <para style="q" vid="1CH 16:31">Aburemei urúeibei!<verse eid="1CH 16:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="1CH 16:32" />Ladürürüha barana lau sun le lídanbei!</para>
  <para style="q" vid="1CH 16:32">Gundaagualá áraabu lau sun le lídanbei!<verse eid="1CH 16:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="1CH 16:33" />Wáguala burí tídibu wewe le dabíararugubei lau ugundani</para>
  <para style="q" vid="1CH 16:33">ligibugiñe Aburemei,</para>
  <para style="q" vid="1CH 16:33">le anitebei lun lagumadihan ubouagu.<verse eid="1CH 16:33" /></para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" sid="1CH 16:34" />Ru humá eteingiruni lun Aburemei,</para>
  <para style="q" vid="1CH 16:34">ladüga buiti Bungiu,</para>
  <para style="q" vid="1CH 16:34">ladüga magumuchaditi línsiñehabu.<verse eid="1CH 16:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="1CH 16:35" />Ariñaga humá lun:</para>
  <para style="q" vid="1CH 16:35">“Sefubáwa Aburemei Wabungiute le wasalbaragüle!</para>
  <para style="q" vid="1CH 16:35">Budabawa, sefubáwa hádangiñe néchanigu</para>
  <para style="q" vid="1CH 16:35">eremuha wamaamuga lun biri le Sándubei,</para>
  <para style="q" vid="1CH 16:35">alawaha wamaamugabu lau ugundani!”<verse eid="1CH 16:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="1CH 16:36" />Biniwalá Aburemei le Lubungiute Ísüraeli,</para>
  <para style="q" vid="1CH 16:36">lun súnwandan!»</para>
  <para style="b" vid="1CH 16:36" />
  <para style="p" vid="1CH 16:36">Aba hóunabun sun lílana fulasu ariñaga: «Ítarala!» Aba halawahani Aburemei.<verse eid="1CH 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37" />Ábati líchuguni Dawidi Asafü hau lánigu tigibugiñe lubagüsina lidaradun Aburemei lun heseriwidun ñein mararamagunga, según le emegeiruti sagü weyu. <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />Ru lumuti giñe Owedi-edomu hau lánigu, ǘrüwa-wein-widü gürigia, luma Owedi-edomu le liráü Hedutún, labu Osá, óunigira bénabu. <verse eid="1CH 16:38" /><verse number="39" style="v" sid="1CH 16:39" />Ru lumuti Sadoku hau lánigu ha fádirigu tigibugiñe likianpun Aburemei tidan ténpulu to Gabaónboun, <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />lun híchugun adagaragüdüni gudawarügüti merederagunga lun Aburemei luagu latarü le lánina adagaragüdüni gudawarügüti, binaafin luma rábounweyu, ítara kei bürüwañu lan lidan lilurudun Aburemei, le líchugubei lun Ísüraeli keisi gumadi. <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />Ígira lumuti giñe Emán hama, Hedutún, hama ha híbiri anuadirútiña lun heremuhan ítara: «Ru humá eteingiruni lun Aburemei, ladüga magumuchaditi línsiñehabu». <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" />Ábaha híñaahan fidu áfara hagía pülatíyu lun leremuhóun lun Aburemei. Lirahüñü Hedutún arihubaña lau bena.<verse eid="1CH 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43" />Lárigiñe aba hagiribudunga hábiñoun, aba giñe lagiribudun Dawidi lúbiñoun lun labiniruniña liduheñu.<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s1">Lidaradun Bungiu luma Dawidi</para>
  <para style="r">(<ref loc="2SA 7:1-29">2 Sam 7.1-29</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />Dan le aranseguaali Dawidi lungua tidan lani palasiu, aba lariñagun lun profeta Natán:</para>
  <para style="p" vid="1CH 17:1">—Arihabá san, au, tidan palasiu lautu hibúari naganawa, anhoun lubagüsina lidaradun Bungiu tidanñoun aban kianpu.<verse eid="1CH 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2" />Aba lóunabuni Natán lariñaga lun:</para>
  <para style="p" vid="1CH 17:2">—Adügabéi le baritagubei, lugundun anihein Bungiu buma.<verse eid="1CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3" />Gama lumoun áriebumeme ligía, aba ladimurehan Bungiu lun Natán, lariñaga lun:<verse eid="1CH 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 17:4" />—Beiba, bariñagame lun Dawidi le nubúein luagu nariñahare lan au, le Aburemei: “Mámaba buguya ábunagua ténpulu nun lun naganóun tidan. <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />Lúmagiñe weyu le nasagarunbaliña Ísüraelina chülǘ lumoun weyu le uguñe, maganóungidina ténpulurugu luéidigia kiánpurugu luma lídangiñe aban fulasu lidoun amu. <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />Lidan sun dan le hama nubéi, mariñaguntina lun ni aban hádangiñe hábutigu ha níchugubaña lun hagumadiruniña numutuniña lun hábunagun aban ténpulu lautu hibúari nun. <verse eid="1CH 17:6" /><verse number="7" style="v" sid="1CH 17:7" />Ariñagabá lubeiti lun Dawidi le nubúein, luagu nariñahare lan lun, au, le Bungiu Suntigabafu: “Au asagarubalibu lídangiñe hafarügan mudún, aba nagidarunibu luéi berederun éibugañaha hárigi mudún, lun hábutibadibu lan Ísüraelina; <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />éibugaadina buma sun le ñein lumuti bidin, gumuguagüda naaña sun báganiñu ha ageindagubaña buma, dísegüda naali laganbahóuniwa luagu biri kei laganbahóuniwa hawagu wügüriña wéirigutiña ya ubouagu. <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />Bóugudin luéi lira, aransedina aban ubaraü habá Ísüraelina ha numutuniña, ru naaña ñein lun haganóun lidan hafulasun, le ñein lumuti mananihóunbei lan houn, úame amudiragutiña kei meha furumiñe, <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />dan le níchugunbei meha ábutigu lun hagumadiruniña numutuniña ha Ísüraelina. Nǘnabudagüdübaña sun báganiñu. Nasubudiragüdüñein bun luagu níchuguba lan adügawaguni bun, <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />ani danme lan lachülürün oura lun bounwen, níchuguba aban hádangiñe badügawagun lun larúeihan beweñegua. <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />Ligíaba ábunagua ténpulu nun, nederebudagüdübei lálana larúeihan lun sun dan. <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />Ábanbadina úguchili lun, ligíame aban isaani nun. Magida nubéi nareini luéi kei nadüga lun le meha bubaabei, <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />derebugugüdarügü nubéi lun sun dan tidan nuban luma lidan narúeihan. Derebuguñu luba lálana larúeihan lun sun dan”.<verse eid="1CH 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15" />Aba labahüdaguni Natán sun katei le lun Dawidi, ítara kei larihini luma laganbuni. <verse eid="1CH 17:15" /><verse number="16" style="v" sid="1CH 17:16" />Ábati lebelurun urúei Dawidi adimureha ligibugiñe Aburemei, lariñaga:</para>
  <para style="p" vid="1CH 17:16">—Bungiu Baba, kátañañadina san, ani kátañanu niduheñu banügünbalina chülǘ ya? <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />Ani lóuguamemegili san le bun Nabureme, adimurehaadibu lubéi giñe hawagu ladügawagun bubuein lubá dan le lunbei liabin ani arihabána kei aban wügüri íñuguti! <verse eid="1CH 17:17" /><verse number="18" style="v" sid="1CH 17:18" />Kábagia amu nariñaga bun luagu buiti le badügübei nun subudi bumutinagu? <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />Nabureme, adüga baali sun ubuiduni le, kei füramase bani luma kei babusenruni, lun nasubudirubei lan. <verse eid="1CH 17:19" /><verse number="20" style="v" sid="1CH 17:20" />Nabureme, úati ni aban kei buguya, úati giñe amu Bungiu buéidigia, según sun le aganba wamaalibei. <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />Úatiña amu kei Ísüraelina ha bumutuniña, ladüga hagía banúadirubaña lun bánigume. Sefu bumutiña lun bumutuniñabaña lan, aba laganbahóun buagu lidan sun ubóu lau lubuidun luma lanarime burí katei le badügübei. Sagá bumutiña híbiri néchanigu hagibugiñegiñe bumutuniña ha basagarubaña Ehiptugiñe. <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />Lugundun ragǘ baaña Ísüraelina keisi bumutuniña lun sun dan, ani Aburemei, buguyaba Habungiute.<verse eid="1CH 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 17:23" />—Ítara liña lubeiti Aburemei, derebugugüdabei füramasei le badügübei nun luma houn tílana nuban, gúnfulibei le bariñagubei. <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />Gúnfulila bani füramasei lidan lubudubu, weirilá lanügǘniwa biri súnwandan, ani ariñawagualá luagu Aburemei lan le Suntigabafu Lubungiutebei Ísüraeli, luagu ligía lan Búngiubei lun Ísüraeli! Derebuguñu hamá ladügawagun Dawidi le bubuein, lábugiñe baríaahan: <verse eid="1CH 17:24" /><verse number="25" style="v" sid="1CH 17:25" />Bungiu Baba, subudigüda baali nun luagu barúeigüdübaña lan nadügawagun; ligía lau sun lubéi bubuein nan, nadüga aban ayumuraguni bun. <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />Buguya, Aburemei, Bungiu buguya, ani füramasehadibu saragu areini nun, au le bubuein; <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />guentoti amuriahatina buma lun babiniruniña nadügawagun lun lábugiñebaña lan bóunigirun súnwandan. Buguya Aburemei, biní baaña, ani biniwañu haba lun súnwandan.<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s1">Wuribu burí le lagañeirubei Dawidi</para>
  <para style="r">(<ref loc="2SA 8:1-14">2 Sam 8.1-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />Lárigiñe sun le, aba lagañeiruni Dawidi wuribu hama Filistéana, aba lanügüni uburugu Gatü lau sun burí lirahüñü aüdü le geyegubei lau hawéi. <verse eid="1CH 18:1" /><verse number="2" style="v" sid="1CH 18:2" />Gañei lumuti giñe wuribu hama Moábüna, aba herederun lábugiñe lubafu Dawidi, aba hafayeihan liseinsuna gumadi lun.<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3" />Gañei lumuti giñe Dawidi wuribu luma Adadü-éserü, le lurúeite Sobá, le luágunbei Amatü, lasuseredunbei sun le, lídanbei yebe louchun Adadü-éserü lárügüdüni sun lóubawagu duna Éufüratesi. <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" />Ragüti Dawidi milu karü hawéi to lánina wuribu, daügua laña sedü-milu súdaragu ha gabayuagutiña hama wein-milu ha éibutiña; halagualéi hagudi sun gabayu ha achawahabarun karü to lánina wuribu, ígira san gabayu tun san karü.<verse eid="1CH 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5" />Lárigiñe aba hayabin Síriana Damasükugiñe lun híderaguni Adadü-éserü le lurúeite Sobá, gama lumoun aba lagañeiruni Dawidi wuribu kóntüra Síriana, aba láfaragun wein-bián-milu hádangiñe. <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" />Lárigiñe aba líchugun Dawidi súdaragu Siria le lani Damasüku, aba herederun Síriana lábugiñe lugumadin, aba hafayeihan liseinsun gumadi lun. Ítara liña lubeiti, sun le ñein lumuti lidin Dawidi, lagañeiragüdüni Aburemei.<verse eid="1CH 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7" />Lárigiñe aba lagidaruni Dawidi idaüdinaü burí lauti golu le hayusurubei lani Adadü-éserü úfisigu hawéi, aba lanügüni Herusaléun. <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" />Barüti giñe saragu buronse uburugugiñe Tibatü luma Kun le burí luburugute Adadü-éserü. Lau buronse ligía ladügei Salomón óunwenbu lagei duna, wagabu luma burí ílagu lauti buronse lun layusurun ténpulurugu.<verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9" />Dan laganbunbei Toi le lurúeite Amatü luagu gáñeila lan Dawidi wuribu kóntüra sun lánigu Adadü-éserü le lurúeite Sobá, <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />aba lóunahani Adorámü le liráü lau sun luwuyeri ílagu golu, pülata luma buronse lun labusurun lun urúei Dawidi luagu lagañeiruni wuribu kóntüra Adadü-éserü, lugundun lageindaguañahaña giñe Toi luma Adadü-éserü. <verse eid="1CH 18:10" /><verse number="11" style="v" sid="1CH 18:11" />Aba lederegeruni Dawidi sun ílagu ligía lun Bungiu, úara luma golu luma pülata le buga lanügübei hawéi Edomuna, Moábüna, Amonna, Filistéana hama Amaléküna.<verse eid="1CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12" />Gañei lumuti giñe Awisái le liráü Seruiá wuribu kóntüra disiwídü-milu Edomuna lidan fulasu wayati le lani Salu. <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" />Lárigiñe aba líchugun Dawidi súdaragu Edomu, aba herederun sun Edomuna lábugiñe lubafu; ábaha lagañeiragüdüni Aburemei Dawidi le ñein lumuti lidin.<verse eid="1CH 18:13" /></para>
  <para style="s1">Lani Dawidi úfisigu</para>
  <para style="r">(<ref loc="2SA 8:15-18">2 Sam 8.15-18</ref>; <ref loc="2SA 20:23-26">20.23-26</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14" />Arúeihati Dawidi hawagu sun Ísüraelina, adügeina sun katei lidan lúaran houn sun lumutuniña. <verse eid="1CH 18:14" /><verse number="15" style="v" sid="1CH 18:15" />Hoabü meha le liráü Seruiá hábutibei súdaragu; Hosafátü le liráü Ailudu ligía lánibei urúei abürühati. <verse eid="1CH 18:15" /><verse number="16" style="v" sid="1CH 18:16" />Sadoku le liráü Aitubu luma Aimelekü le liráü Abiatárü, fádirigu; Sabüsá ligía meha abürühabalin sun asusereduti. <verse eid="1CH 18:16" /><verse number="17" style="v" sid="1CH 18:17" />Benaíasi le liráü Hoyadá, ligía hábutibei óunigirutiña ha Keretüna hama Peletüna. Lirahüñü meha Dawidi íderagubalin.<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s1">Lagañeiruniña Dawidi Síriana hama Amonna</para>
  <para style="r">(<ref loc="2SA 10:1-19">2 Sam 10.1-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />Átiri dan lárigiñe aba lounwen Naasü le harúeite Amonna, aba larúeihan liráü leweñegua. <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" />Ábati laritagun Dawidi luagu lunti lan lóuseruni Anún le liráü Naasü lau areini, ladüga areidati meha lúguchi Anún lun Dawidi, ábati lóunahan Dawidi fiu wügüriña lumoun Anún lun híchuguni ligarigu lun luagu lounwen lúguchi. Gama lumoun dan hachülürünbei lánigu Dawidi úfisigu hageiroun Amonna. <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />Aba hariñagun ábutigu Amonna lun Anún:</para>
  <para style="p" vid="1CH 19:3">—Haritaguatibu san luagu lóunahañanu lan Dawidi wügüriña ha íchigei ligarigu bun? Lúnrügü lariñagun luagu gagarigu lan luagu lounwen búguchi, hayabiña ha aríaahei fulasu!<verse eid="1CH 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 19:4" />Ábati líchugun Anún dimurei lun hadaürawagun lani Dawidi úfisigu, sáwagua hagíame. Héiriwaguame hadaüragun chülǘ lumoun hañuuragüle. Lárigiñe aba lóunahaniña. <verse eid="1CH 19:4" /><verse number="5" style="v" sid="1CH 19:5" />Dan le lariñawagúnbei le asuseredubei houn wügüriña hagía lun Dawidi, aba lóunahan gürigia habaroun, lugundun buin haña lau busiganu, lun lan hariñagun houn lun herederun Herikó, darimeya labouchun hádiuma lubá hagiribudun.<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6" />Aba hasubudiruni Amonna luagu iyereeguhaaña lan lun Dawidi ladüga katei le ladügübei Anún, aba lubeiti lóunahan Anún hama Amonna sügǘ lau ǘrüwa-wein-katorusu-milu-widü-san líburu pülata lun háhayahan karü lánina wuribu hama súdaragu gabayuagutiña Mesopotamia, Siria, Maaká luma Sobá, <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />aba háhayahan darandi-bián-milu karü lánina wuribu, fayei haméi lurúeite Maaká hau luwügüriñanigu lun houdin hama. Aba hayabin, aba híchugunu hakianpun ligibugiñe Medebá. Aba giñe háfuridunga Amonna haburuguterugugiñe lun hageindagun lidan wuribu. <verse eid="1CH 19:7" /><verse number="8" style="v" sid="1CH 19:8" />Gama lumoun aba lasubudiruni Dawidi, aba lóunahani Hoabü hau sun lisudaranigu. <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" />Aba hawanserun Amonna, aba hesetirun lun wuribu lubenari guánarügü uburugu. Urúeigu ha ñǘbuinbaña aba herederun áraabu. <verse eid="1CH 19:9" /><verse number="10" style="v" sid="1CH 19:10" />Dan larihinbei Hoabü luagu añate lan luagun ligibugiñegiñe luma lanagangiñe, aba lanúadiruniña habuidun-agei súdaragu Ísüraelina, aba laranserun lun lageindagun hama Síriana. <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />Lárigiñe aba líchuguniña híbiri lánigu lun Awisái le líbiri lun hageindagun hama Amonna. <verse eid="1CH 19:11" /><verse number="12" style="v" sid="1CH 19:12" />Lariñaga lun:</para>
  <para style="p" vid="1CH 19:12">—Ánhaña gabafu Síriana nuéi, biábinme íderaguana, ánhaña gabafu Amonna buéi, nídiba íderaguabu. <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />Gaguraasunbá, wageindagua lau anigi luagu wanechanin luma luagu burí luburugute Wabungiute adügaléi Aburemei le buítimabei lidan laritagun!<verse eid="1CH 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14" />Aba lawanserun Hoabü hau luwügüriñanigu lun hageindagun hama Síriana, gama lumoun aba héibaagun luéi. <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" />Dan harihinbei Amonna héibaagun Síriana, aba giñe héibaagun luéi Awisái le líbiri Hoabü, aba hebelurun uburugun. Ábati lagiribudun Hoabü Herusaléun.<verse eid="1CH 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16" />Dan hasubudirunbalin Síriana luagu gañei laali lan Ísüraeli wuribu hama, aba hóunahan hawagu Síriana ha loubafurugubaña duna Éufüratesi. Sofakü, le hábuti luwügüriñanigu Adadü-éserü haubei. <verse eid="1CH 19:16" /><verse number="17" style="v" sid="1CH 19:17" />Gama lumoun aba labahüdawagún katei le lun Dawidi, aba lidin hawagu hau sun Ísüraelina, aba lánhiñuraguni duna, aba houdin hawagun. Aba lafileiruniña Dawidi lánigu lun hageindagun hama Síriana, aba lagumeserun wuribu, <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" />gama lumoun lagumuhóun oura, aba héibaagun Síriana ladüga áfaraali buga Dawidi bián-wein-milu súdaragu ha eibu-umutiña hama sedü-milu tídangiñe karü lánina wuribu, áfara lumuti giñe Dawidi Sofakü le hábuti súdaragu Síriana. <verse eid="1CH 19:18" /><verse number="19" style="v" sid="1CH 19:19" />Dan harihinbei lánigu Adadü-éserü luagu gañei hamaaña lan Ísüraelina, aba hederegeragun houngua lun Dawidi. Lúmagiñeti dan ligía, máhaaña Síriana híderaguniña Amonna.<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s1">Lagañeiruni Dawidi uburugu Rabá</para>
  <para style="r">(<ref loc="2SA 12:26-31">2 Sam 12.26-31</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />Luagu aban dan, lidan lidaani háfuridun urúeigu awuribuha, aba liabin Hoabü hau lánigu aba lárügüdüni hageira Amonna. Aba lidin luagun, aba legeyedaguni Rabá aba lábürühan luagun darí lagünrinchaguni. Sunti dan le anihein buga Dawidi Herusalén. <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" />Lárigiñe aba lagidaruni Dawidi ridi golu le gawaguti dübü buíduburiti lábulugugiñe harúeite Amonna, ǘrüwa-wein-duusu líburu lihürü, aba hadaürüni luagu Dawidi. Sagati giñe Dawidi saragu katei gebegiti uburugugiñe, <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />sagaláña gürigia ha erederubaña uburugu, aba líchuguniña nadagimein lau siyara, reeka le lauti gürabu tuma harawa. Ligiaméme ladügübei Dawidi lau sun burí haburugute Amonna, lárigiñe aba lagiribudun hau luwügüriñanigu uburugun Herusalén.<verse eid="1CH 20:3" /></para>
  <para style="s1">Wuribu hama hígandei</para>
  <para style="r">(<ref loc="2SA 21:18-20">2 Sam 21.18-20</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />Lárigiñe ñeinñein aban wuribu hama Filistéana Géserü. Lidan dan ligía, aba láfaruni Siwekái le lílana Usá Sipái le hadügawagun hígandei. <verse eid="1CH 20:4" /><verse number="5" style="v" sid="1CH 20:5" />Lidan ábanya wuribu hama Filistéana, aba láfaruni Elanán le liráü Hairü, Lamí le lamulen Goliadi le lílana Gatü. Wéiriti tihürü luma tigaranan tebu lefeinte.<verse eid="1CH 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6" />Ñéinñeinya aban wuribu Gatü. Ñeinñein aban wügüri gágubuti, dúusuñein lirahüñü lúhabu, duusu lirahüñü lugudi, sisi luagu kada aban. Hadügawagun giñe hígandei, <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />gama lumoun aba láluahan wuribu hama Ísüraelina, aba láfaruni Yónatan, le liráü Simá le líbugaña Dawidi. <verse eid="1CH 20:7" /><verse number="8" style="v" sid="1CH 20:8" />Hígandei burí ha, ladügawagun Refa le lílana Gatü, gama lumoun áfaragua lumutiña Dawidi hau lani úfisigu.<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s1">Labahüdüniña Dawidi gürigia</para>
  <para style="r">(<ref loc="2SA 24:1-17">2 Sam 24.1-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />Aba labusenrun Mafia líchugun turobuli houn Ísüraelina aba línchahani Dawidi lun labahüdüniña Ísüraelina. <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" />Ábati lariñagun Dawidi lun Hoabü luma houn ábutigu fulasurugu:</para>
  <para style="p" vid="1CH 21:2">—Heiba, ábame habahüdüniña Ísüraelina lúmagiñe Bérüsewagiñe darí Dan, ábame hiabin subudi náamugei átiriñanu lan.<verse eid="1CH 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3" />Gama lumoun lariñaga Hoabü lun:</para>
  <para style="p" vid="1CH 21:3">—Gánwoungüdalaña Bungiu lumutuniña san wéiyaasu. Nurúeite, ma funagia hubúeingu sun ha? Kámegia labusenrei urúei katei le, le lunbei lañawarihani Ísüraeli?<verse eid="1CH 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4" />Lau sun lira, héretimati lererun urúei luéi Hoabü, aba lidin Hoabü abahüdaña Ísüraelina, lárigiñe aba lagiribudun Herusaléun. <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" />Aba líchugun Hoabü dimurei lun Dawidi luagu átiriñanu lan Ísüraelina. Hadan sun Ísüraelina ñéinñanu aban-míñunu-san-milu wügüriña ha gayaraahali houdin wuriburugu, hama gádürü-san-ǘrüwa-wein-diisi-milu Hudá. <verse eid="1CH 21:5" /><verse number="6" style="v" sid="1CH 21:6" />Gama lumoun mabahüdǘntiña lani Lewí hama lani Benhamín türibu hadan, ladüga magundanti Hoabü lau le lariñagubei urúei.<verse eid="1CH 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 21:7" />Wuribati larihín sun katei le lun Bungiu, aba lóunahan aban abeichúni luagun Ísüraeli. <verse eid="1CH 21:7" /><verse number="8" style="v" sid="1CH 21:8" />Gama lumoun aba lagufeserun Dawidi lun Bungiu, lariñaga:</para>
  <para style="p" vid="1CH 21:8">—Adügaadina aban óunwenbu figóu. Gama lumoun ayumuraguatina bun lun ferudunabani nifigoun, lugundun nadügüni le nadügübei kei aban ibidiougua tau.<verse eid="1CH 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9" />Ábati lariñagun Bungiu lun Gadü, profeta le eseriwidubei lun Dawidi:<verse eid="1CH 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 21:10" />—Beiba lumoun Dawidi nun, bariñagame lun luagu anihein lan ǘrüwa katei níchugun ligibugiñe, lun lan lanúadirun ka lan lídangiñe labusenrubei nadügün.<verse eid="1CH 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11" />Aba lidin Gadü lumoun Dawidi, lariñaga lun:</para>
  <para style="p" vid="1CH 21:11">—Anuadahabá aban <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />lídangiñe ǘrüwa katei le: Ǘrüwa irumu ilamaü, ǘrüwa hati hau báganiñu éibaahabu, ǘrüwa weyu lau sandi fulasurugu, lau lani Bungiu ánheli adaagua wuribani hadan lílana Ísüraeli. Ariñagabéi lubeiti nun ka lan bóunabagülebei, ariñaga náamugei lun le óunahabalina.<verse eid="1CH 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13" />Lariñaga Dawidi lun Gadü:</para>
  <para style="p" vid="1CH 21:13">—Wéiriti igarigu le gádanbalina. Gama lumoun himei numuti lun nábürühan lúhaburugun Bungiu, lugundun wéiriti lareini, mama lun nábürühan háhaburugun wügüriña.<verse eid="1CH 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14" />Ábati lóunahan Bungiu aban sandi hawagun Ísüraelina, aba hóunwegun ǘrüwa-wein-diisi-milu hádangiñe Ísüraelina, <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" />Aba lóunahan Bungiu aban ánheli lun lagünrinchaguni uburugu Herusalén. Gama lumoun dan le ñeinñein lubéi ánheli ligía agünrinchaguei, aba larihini Bungiu, aba lasakürihan, aba lariñagun lun ánheli ligía:</para>
  <para style="p" vid="1CH 21:15">—Buídurügaali, rédeibei búhabu!</para>
  <para style="p" vid="1CH 21:15">Lidan oura ligía lubaduñein fulasu le ñein lubéi léfereha Orunán le Hebusuna türigu lani Bungiu ánheli ligía. <verse eid="1CH 21:15" /><verse number="16" style="v" sid="1CH 21:16" />Dan liñurunbalin Dawidi larihin, aba larihini lani Bungiu ánheli labadinagua sielu luma múa tau aban eféin lúhaburugu, larufudun luagun uburugu Herusalén. Ábati labuluchagun Dawidi hama ábutigu dagá herebe múarugu tau hadaüragun to súsutu.<note caller="2" style="f"><char style="fr" closed="false">21.16 </char><char style="ft" closed="false">Hadaüragunbei meha tau daüguaü súsutu, lun gayarabei lan harufuduni hagarigu.</char></note> <verse eid="1CH 21:16" /><verse number="17" style="v" sid="1CH 21:17" />Aba lariñagun Dawidi lun Bungiu:</para>
  <para style="p" vid="1CH 21:17">—Au óunahabei abahüdaña Ísüraelina! Au afigouhabei! Kagia wuribati hadügübei fugiabu gürigia ha? Bungiu Baba, ayumuraguatina bun lun au lan babeicha hama niduheñu, gama lumoun hebé báfaraguniña bumutuniña.<verse eid="1CH 21:17" /></para>
  <para style="s1">Liñuragun Dawidi aban latarü</para>
  <para style="r">(<ref loc="2SA 24:18-25">2 Sam 24.18-25</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />Ábati lariñagun lani Bungiu ánheli lun Gadü lun lariñagun lun Dawidi lun ladügün aban latarü lun Bungiu lidan fulasu le ñein lubéi buga léfereha Orunán le Hebusuna türigu. <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" />Ábati lidin Dawidi adügei le lariñagubei Bungiu lun liyumulugugiñe Gadü. <verse eid="1CH 21:19" /><verse number="20" style="v" sid="1CH 21:20" />Kei ñeinñein lubéi Orunán éfereha türigu, dan le ladigiragunbei ariha laali ánheli, ánhañati gádürü lisaanigu ha lúmabaña ñein, ñǘdünha buga aramudagua. <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" />Dan le layarafadunbei Dawidi ñeinhin lubéi Orunán, aba larihini Orunán Dawidi, aba láfuridun ñéingiñe lubéi léfereha türigu, aba labuluchagun ligibugiñe Dawidi. <verse eid="1CH 21:21" /><verse number="22" style="v" sid="1CH 21:22" />Ábati lariñagun Dawidi lun Orunán:</para>
  <para style="p" vid="1CH 21:22">—Rubei fulasu le ñein lubéi béfereha türigu nun, lun nadügün aban latarü lun Bungiu ñein, alugurabéi nun luagu lebegi, gidá láamuga sandi fulasurugugiñe.<verse eid="1CH 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23" />Lariñaga Orunán lun:</para>
  <para style="p" vid="1CH 21:23">—Barǘ huméi fulasu nurúeite, adüga huméi le habusenrun lau. Níchugubaña bágasu wügüriña hun lun adagaragüdüni gudawarügüti, fulansu lun watu tuma türigu lun idewesei. Níchugubei sun le hun, nurúeite.<verse eid="1CH 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24" />Gama lumoun lariñaga Dawidi lun:</para>
  <para style="p" vid="1CH 21:24">—Seremei numutibu, gama lumoun gasu nagañeihani sun le luagu lebegi, magida nubéi le bani buéi lun níchuguni lun Bungiu keisi adagaragüdüni gudawarügüti le mafayeihantina ni kata luagu.<verse eid="1CH 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25" />Aba lubeiti lafayeiruni Dawidi lebegi fulasu ligía lun Orunán, keinsi líburu golu, <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" />ábati ladügün Dawidi aban latarü lun Bungiu aba líchugun adagaragüdüni gudawarügüti luma adagaragüdüni le lánina arandaruni. Lárigiñe aba lamuriahan ídemuei luma Bungiu, lóunabeiti Bungiu lau watu gemeti le siélugiñeti ligibuagun latarü le ñein lubéi adagaragüdüni. <verse eid="1CH 21:26" /><verse number="27" style="v" sid="1CH 21:27" />Ábati lariñagun Bungiu lun ánheli lun lareidunu lefeinte.<verse eid="1CH 21:27" /></para>
  <para style="s1">Fulasu tun ténpulu</para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 21:28" />Lidan oura ligía, dan larihinbei Dawidi luagu óunaba laali lan Bungiu lidan fulasu le ñein lubéi léfereha Orunán türigu, aba ladagaragüdün ñein. <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" />Lau sun anuhein lan buga muna to ladügüboun Moisesi lun Bungiu lidan fulasu mageirawati, liabin latarü le lebu adagaragüdüni gudawarügüti tídanñein sanduariu to Gabaónboun, <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />Siñati lidin Dawidi ñein lun lálügüdahan luma Bungiu, lugundun buinha buga lau anufudei lau larihinu lefeinte lani Bungiu ánheli.<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1" />Ligía lariñagunbei Dawidi:</para>
  <para style="p" vid="1CH 22:1">—Yaaboun litenpulun Bungiu, luma latarü lun adagaragüdüni gudawarügüti lun Ísüraeli.<verse eid="1CH 22:1" /></para>
  <para style="s1">Laransehóuniwa tubá ténpulu</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />Lárigiñe aba lóundaraguagüdüniña Dawidi terencha ha aganóubaña Ísüraeli, aba líchugun nadagimeintiña dübü lun habouhan dübü lun tábunawagun litenpulun Bungiu. <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" />Aranseti giñe Dawidi saragu gürabu lun lügürabuna bena luma gürapa; luma giñe saragu buronse, <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />luma wewe le hibúari gíbeti ladüga barütiña meha lílana Sidón luma Tiru saragu wewe le hibúari lun.<verse eid="1CH 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5" />Lariñaga Dawidi lúnguarügü: «Salomón le niráü, ñǘraügili ani ténpulu to lunboun tábunawagun lun Bungiu, gasu tuguyaba lan wéiritima, díseme laganbahoun luagu tiri ani wéndetima ubouagu; naranseraali lubeiti sun katei lubá».</para>
  <para style="p" vid="1CH 22:5">Ligía lébubei laransehan Dawidi tubá ténpulu lubaragiñe lounwen. <verse eid="1CH 22:5" /><verse number="6" style="v" sid="1CH 22:6" />Lárigiñe aba lagúarun lun Salomón le liráü, aba líchugun dimurei lun, lun lábunaguboun tan litenpulun Bungiu le Lubungiute Ísüraeli, <verse eid="1CH 22:6" /><verse number="7" style="v" sid="1CH 22:7" />lariñaga lun:</para>
  <para style="p" vid="1CH 22:7">—Niráü, anihein yebe buga naritagunrugu lun nábunagun aban ténpulu lun Bungiu le Nubungiute. <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />Gama lumoun ariñagaali Bungiu nun: “Arihaadina luagu wiyuhadibu lan saragu hitaü, ani awuribuhaadibu lan saragu; ligía mámaba lubéi buguya ábunagua ténpulu nun. <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />Gama lumoun garaübadibu aban wügüri irahü, le lunbei ábanbei lan wügüri darangilati; ani nadügüba giñe lun mañawarihan hamá láganiñu lun lidan ni aban fulasu. Ligía Salomónba lubéi liri, níchuguba ñuruguaü luma darangilaü lun Ísüraeli lidaaniwagu. <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />Ligíaba ábunagua ténpulu nun. Ábanbei isaani nun, aume aban úguchili lun, nederebudagüdübei larúeihan lun súnwandan Ísüraeli”.<verse eid="1CH 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11" />—Guentoti niráü, bumalá Bungiu lun bábunaguboun lan litenpulun Aburemei le Bubungiute kei füramaselani badügübei lan. <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" />Rula Bungiu lualin ichügü luma lichú aau bun lun danme lan líchugunibu lun barúeihan Ísüraeli, gúnfuli báamugei lilurudun Aburemei le Bubungiute. <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />Buídubei lasalirun sun katei bun, ánhabu áfaagua bagunfuliruni lúrudu le líchugubei Bungiu lun Moisesi lun Ísüraeli. Áfaaguaba, ganigi buguyame; gaguraasunbá manufude buguyame! <verse eid="1CH 22:13" /><verse number="14" style="v" sid="1CH 22:14" />Lau saragu áfaaguni óundaraadina lubá tábunawagun litenpulun Bungiu: Ǘrüwa-milu-ǘrüwa-san tonelada golu, darandi-ǘrüwa-milu tonelada pülata, luma saragu gürabu luma buronse darí lun siñá lan lamisurahóun. Óundaraadina giñe wewe luma dübü, bíchigame lanwoun. <verse eid="1CH 22:14" /><verse number="15-16" style="v" sid="1CH 22:15-16" />Bóugudin luéi lira, añahein saragu nadagimeintiña buma, nadagimeintiña dübü, ábunagutiña muna, sarafangei hama saragu wügüriña ha buítiña lidan sun luwuyeri wadagimanu lauti golu, pülata, buronse luma gürabu, buadigimarida lubeiti ani íderagualabu Bungiu!<verse eid="1CH 22:15-16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17" />Lárigiñe aba lariñagun Dawidi houn sun ábutigu Ísüraeli lun híderaguni Salomón le liráü, lariñaga houn:<verse eid="1CH 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 22:18" />—Húmañahañein Aburemei le Hubungiute, rúhali ñuruguaü hun lidan sun fulasu, lugundun ru laaña lílana ageiraü labun nubafu, ani rédeiha lábugiñe lererehan Bungiu hama lumutuniña. <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />Rugua humá lubeiti hungua lun háluahani Aburemei le Hubungiute. Aranse humá lubeiti lun hábunagunu lisanduariun Bungiu, lun hanügünu lubagüsina lidaradun luma umegeni sagüráuti le lani Bungiu tidoun litenpulun to lunboun tábunawagun lun.<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="s1">Hawadigimari Lewitagu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />Dan le wéiyaali Dawidi saragu, aba líchuguni liráü le Salomón lurúeiteme Ísüraeli, <verse eid="1CH 23:1" /><verse number="2" style="v" sid="1CH 23:2" />aba lóundaruniña sun ábutigu Ísüraelina, fádirigu hama Lewitagu. <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />Ábati habahüdǘn Lewitagu ha daranditi irumu hau lun iñun, darandi-widü-míluñanu wügüriña. <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />Aba híchugun wein-gádürü-milu hádangiñe lun hagíaba la ábutigu lidan tábunawagun ténpulu, sisi-milu lun hagíaba lan úfisigu hama aguseragüdütiña, <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />gádürü-milu lúniri bena, hámaya gádürü-milu ha lúnbaña háfarun lidan leremuhóun lun Bungiu tau burí tuwuyerigu árüpa luma pülatíyu le ladügagüdübei Dawidi lun katei ligía. <verse eid="1CH 23:5" /><verse number="6" style="v" sid="1CH 23:6" />Aba lafanreinhaniña Dawidi lidan sétanu según hibe lirahüñü Lewí: Gerüsón, Keatü luma Merarí.<verse eid="1CH 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 23:7" />Lirahüñü Gerüsón: Ladán luma Simí. <verse eid="1CH 23:7" /><verse number="8" style="v" sid="1CH 23:8" />Ǘrüwañanu lirahüñü Ladán: Heieli le íbugañaü, Setamü luma Hoeli. <verse eid="1CH 23:8" /><verse number="9" style="v" sid="1CH 23:9" />Ǘrüwañanu giñe lirahüñü Simí; Selomitü, Asieli luma Arán. Hagía hábutigubaña iduheñu hádangiñe ladügawagun Ladán. <verse eid="1CH 23:9" /><verse number="10" style="v" sid="1CH 23:10" />Gádürüñanu lirahüñü Simí: Háatü, Sisá, Heusu luma Beriá. <verse eid="1CH 23:10" /><verse number="11" style="v" sid="1CH 23:11" />Háatü meha íbugañaünbei, Sisá lárigili; gama lumoun kei mibe habéi harahüñü Heusu luma Beriá, lun heseriwidun, aba habahüdǘn kei ábanrügü iduheñu.<verse eid="1CH 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 23:12" />Gádürüñanu lirahüñü Keatü: Amürámü, Isarü, Ebürón luma Usieli. <verse eid="1CH 23:12" /><verse number="13" style="v" sid="1CH 23:13" />Lirahüñü Amürámü: Aarón luma Moisesi. Aarón lanúadirubei Bungiu lun líchuguni idewesei le sagüráutimabei, lun lágudahan kupali ligibugiñe Bungiu, lun leseriwidun luma lun lariñaguni abiniruni súnwandan, wadagimanu le, yuubei lun Aarón hama lirahüñü súnwandan. <verse eid="1CH 23:13" /><verse number="14" style="v" sid="1CH 23:14" />Moisesi, le luwügürin Bungiu, abahüdǘwati giñe hadan lani Lewí türibu hau sun ladügawagun.<verse eid="1CH 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 23:15" />Lirahüñü Moisesi: Gerüsón luma Elieserü. <verse eid="1CH 23:15" /><verse number="16" style="v" sid="1CH 23:16" />Sebueli, ligía furumiñetibei hadan lirahüñü Gerüsón. <verse eid="1CH 23:16" /><verse number="17" style="v" sid="1CH 23:17" />Furumiñeti liráü Elieserü, Reawíasi, ligíarügüñein liráü, gama lumoun gíbetiña lirahüñü Reawíasi. <verse eid="1CH 23:17" /><verse number="18" style="v" sid="1CH 23:18" />Furumiñeti liráü Isarü, Selomitü. <verse eid="1CH 23:18" /><verse number="19" style="v" sid="1CH 23:19" />Lirahüñü Ebürón: Heraíasi, le furumiñeti; Amaríasi, habiaman; Haasieli, háürüwan; Hekamán, hagadürün. <verse eid="1CH 23:19" /><verse number="20" style="v" sid="1CH 23:20" />Lirahüñü Usieli: Mikaíasi, le furumiñeti, Isíasi le habiaman.<verse eid="1CH 23:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 23:21" />Lirahüñü Merarí: Malí luma Musí. Lirahüñü Malí: Eleasárü luma Kisü. <verse eid="1CH 23:21" /><verse number="22" style="v" sid="1CH 23:22" />Hilati Eleasárü marahüñüga wügüriña, würiñarügüñanu lirahüñü, aba hamarieidun hama lirahüñü Kisü le hayawürite. <verse eid="1CH 23:22" /><verse number="23" style="v" sid="1CH 23:23" />Ǘrüwañanu lirahüñü Musí: Malí, Éderü luma Herimótu.<verse eid="1CH 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 23:24" />Hagía ha ladügawagunbaña Lewí según haduheñu ha bürüwañubaña keisi hábutigu haduheñu ha weinti irumu hau lun iñun, ha gafisiutebaña ténpulurugu.<verse eid="1CH 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 23:25" />Ariñagaali meha Dawidi:</para>
  <para style="p" vid="1CH 23:25">—Rúhali Aburemei le Lubungiute Ísüraeli darangilaü houn lumutuniña, rulei Herusalén lun ligíaba lan hábiñe lun sun dan. <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" />Ligía moun laali lubéi hanaahanu Lewitagu lani Bungiu kianpu ni burí katei le ayusurúbei tidan lun kultu.<verse eid="1CH 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 23:27" />Aba lubeiti habahüdǘn ladügawagun Lewí keisi lagumuhóun laritagun Dawidi ha weinti irumu hau lun iñun, <verse eid="1CH 23:27" /><verse number="28" style="v" sid="1CH 23:28" />aba herederun lábugiñe hagumadin fádirigu ha ladügawagun Aarón, lun heseriwidun ténpulurugu, lun harihin lau bürürü, tau burí rumu luma lau larumadun burí ílagu sagüráuti, luma burí líbiri fisiu ténpulurugu. <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />Hagía arihubaña tau fein sagüráutu to ichugúboun aban tárigi aban, tau fulúaru to luntu idewesei fulúaruautu, tau furidasi to tautu fein maganatu lébini, lau burí idewesei le furidu, tau masa luma sun ihürü luma amisuraagülei. <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />Gasu giñe ñéinbaña lan ténpulurugu sagü binaafin luma rábounweyu lun heteingiruni Bungiu luma lun heremuhan lun, <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />luma dan le lichugúniwa sun adagaragüdüni le gudawarügüti lun Bungiu lidan luéyuri emeraaguni, lidan fedu lánina iseri hati luma lidan burí fedu le buíduburiti, eseriwida lun Bungiu súnwandan, según ha iridútiña. <verse eid="1CH 23:31" /><verse number="32" style="v" sid="1CH 23:32" />Hagía giñe óunigirubarun kianpu lánina óundaruni luma Bungiu tuma sanduariu, eseriwida ténpulurugu hama hábirigu ha ladügawagun Aarón.<verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />Fánreinwaguatiña meha giñe lirahüñü Aarón lidan burí sétanu. Añahán lirahüñübaña Aarón: Nadabü, Abiu, Eleasárü luma Itamárü. <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" />Gama lumoun kei Nadabü lan luma Abiu hilagiabaña lubaragiñe háguchi marahüñüga, aba lerederun Eleasárü luma Itamárü ariha lau afadirihani.<verse eid="1CH 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 24:3" />Aba híderaguni Sadoku, le ladügawagun Eleasárü luma Aimelekü le ladügawagun Itamárü Dawidi lun lafanreinhaniña según hafisiute. <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />Gama lumoun kei harihinbei luagu gíbetima hamá wügüriña ha ladügawagun Eleasárü, aba hafanreinrawagun lun herederuba lan disisi ábutigu hádangiñe ladügawagun Eleasárü, widü hádangiñe ladügawagun Itamárü. <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />Aba hafanreinhóuniwa súngubei luagu ubunuruni, lugundun dandu hadan ladügawagun Eleasárü kei hadan ladügawagun Itamárü, ñéinñanu eseriwidutiña sagüráutiña, ha eseriwidutiña lun Bungiu.<verse eid="1CH 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6" />Lárigiñe aba labürühani Semaíasi le abürühabei le liráü Natanaéli luma aban hádangiñe Lewitagu hiri liñúarü urúei, ábutigu, Sadoku le fádiri, Aimelekü le liráü Abiatárü, luma hañúarü hábutigu haduheñu fádirigu hama Lewitagu. Luáguha ubunuruni lasagahóua lidaani eseriwiduni, bián houn ladügawagun Eleasárü aban houn ladügawagun Itamárü.<verse eid="1CH 24:6" /></para>
  <para style="p">
    <verse number="7-18" style="v" sid="1CH 24:7-18" />Ítara liña ligaburi lerederun lidaani eseriwiduni lárigiñe lasagahóun ubunuruni, lúmagiñe aban lumoun wein-gádürü:</para>
  <para style="p" vid="1CH 24:7-18">Hoyaríbü,</para>
  <para style="p" vid="1CH 24:7-18">Hedaíasi,</para>
  <para style="p" vid="1CH 24:7-18">Arimü,</para>
  <para style="p" vid="1CH 24:7-18">Seorimü,</para>
  <para style="p" vid="1CH 24:7-18">Malükíasi,</para>
  <para style="p" vid="1CH 24:7-18">Mihamín,</para>
  <para style="p" vid="1CH 24:7-18">Kosu,</para>
  <para style="p" vid="1CH 24:7-18">Awíasi,</para>
  <para style="p" vid="1CH 24:7-18">Hesusu,</para>
  <para style="p" vid="1CH 24:7-18">Sekaníasi,</para>
  <para style="p" vid="1CH 24:7-18">Eliasíbü,</para>
  <para style="p" vid="1CH 24:7-18">Hakimü,</para>
  <para style="p" vid="1CH 24:7-18">Upá,</para>
  <para style="p" vid="1CH 24:7-18">Hesebábü,</para>
  <para style="p" vid="1CH 24:7-18">Bilügá,</para>
  <para style="p" vid="1CH 24:7-18">Imerü,</para>
  <para style="p" vid="1CH 24:7-18">Esirü,</para>
  <para style="p" vid="1CH 24:7-18">Pisesi,</para>
  <para style="p" vid="1CH 24:7-18">Petaíasi,</para>
  <para style="p" vid="1CH 24:7-18">Esekiéli</para>
  <para style="p" vid="1CH 24:7-18">Hakín,</para>
  <para style="p" vid="1CH 24:7-18">Gamulu</para>
  <para style="p" vid="1CH 24:7-18">Delaíasi,</para>
  <para style="p" vid="1CH 24:7-18">Masíasi.<verse eid="1CH 24:7-18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19" />Ítara liña lubeiti aba lafanreinhóuniwa lidaani eseriwiduni tidan ténpulu, según lariñagagüdüni Aburemei le Lubungiute Ísüraeli lun Aarón, le hagücha.<verse eid="1CH 24:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 24:20" />Añahán Lewitagu ha erederubaña: Suwaeli, hádangiñe ladügawagun Amürámü; Hedíasi hádangiñe ladügawagun Suwaeli; <verse eid="1CH 24:20" /><verse number="21" style="v" sid="1CH 24:21" />Isíasi ligía íbugañaünbei, hadan lirahüñü Reawíasi; <verse eid="1CH 24:21" /><verse number="22" style="v" sid="1CH 24:22" />Selomótu, hadan lirahüñü Isarü, Háatü hadan lirahüñü Selomótu; <verse eid="1CH 24:22" /><verse number="23" style="v" sid="1CH 24:23" />hádangiñe ladügawagun Ebürón: Heríasi furumiñeti; Amaríasi habiaman; Haasieli háürüwan; luma Hekamán hagadürün. <verse eid="1CH 24:23" /><verse number="24" style="v" sid="1CH 24:24" />Ñéinñanu giñe: Mikaíasi le liráü Usieli; Samirü liráü Mikaíasi; <verse eid="1CH 24:24" /><verse number="25" style="v" sid="1CH 24:25" />Isíasi líbiri Mikaiasi; Sakaríasi, liráü Isíasi; <verse eid="1CH 24:25" /><verse number="26" style="v" sid="1CH 24:26" />Malí, Musí luma Haasíasi lirahüñü Merarí; <verse eid="1CH 24:26" /><verse number="27" style="v" sid="1CH 24:27" />Añahán ladügawagun Merarí luéigiñe Haasíasi le liráü: Sóamü, Sakuru luma Ibürí; <verse eid="1CH 24:27" /><verse number="28-29" style="v" sid="1CH 24:28-29" />Biámañanu lirahüñü Malí, Eleasárü luma Kisü. Eleasárü maraüti, anhein Kisü garaüti aban le gíribei Heraméeli. <verse eid="1CH 24:28-29" /><verse number="30" style="v" sid="1CH 24:30" />Añahán lirahüñü Musí: Malí, Éderü, luma Herimótu.</para>
  <para style="p" vid="1CH 24:30">Añahán meha haduheñu Lewitagu. <verse eid="1CH 24:30" /><verse number="31" style="v" sid="1CH 24:31" />Fánreinwaguatiña giñe luagu ubunuruni, dandu liduheñu ábuti kei liduheñu amuleñein, kéigubeirügü giñe haduheñu ha burí ladügawagun Aarón, liñúarü urúei Dawidi, Sadoku, Aimelekü hama hábuti haduheñu fádirigu hama Lewitagu.<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s1">Eremuhatiña hama áfarutiña ténpulurugu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />Lárigiñe aba líchugun Dawidi hama lábutigu eseriwiduni lidan kultu barasegu houn lirahüñü Asafü, Emán, luma Hedutún, ha me asubudiragüdübaña uganu lúmagiñeti Bungiu áfareina sun tuwuyerigu árüpa, luma pülatíyu gamuriti. Anihán hiri ha adügübalin barasegu le.<verse eid="1CH 25:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 25:2" />Hádangiñe lirahüñü Asafü: Hakuru, Hosé, Netaníasi luma Asaréla. Asafü le háguchi ligía hábutibei, ligíaha asubudiragüdübalin uganu lúmagiñeti Bungiu lábugiñe lererehan urúei.<verse eid="1CH 25:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 25:3" />Sisi lirahüñü Hedutún: Gedalíasi, Serí, Isaíasi, Simí, Asawíasi luma Matatíasi. Hedutún le háguchi, ligía hábutibei, ligíaha asubudiragüdübei uganu lúmagiñeti Bungiu, áfareina árüpa lun leteingiruni Bungiu luma lun lalawahani.<verse eid="1CH 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 25:4" />Lirahüñü Emán: Bukíasi, Mataníasi, Usieli, Sebueli, Heremótu, Ananíasi; Ananí, Eliatá, Gidalüti, Romamüti-éserü, Hosubekása, Malotí, Otirü luma Masiotu. <verse eid="1CH 25:4" /><verse number="5" style="v" sid="1CH 25:5" />Sun ha, lirahüñü Emán, profeta le eseriwidubei lun urúei según meha füramasei le ladügübei Bungiu lun luagu líchuguba lan erei lun luma lubuidun igaburi; katorusuñanu isaanigu wügüriña líchugun Bungiu lun Emán hama ǘrüwa isaanigu würiña. <verse eid="1CH 25:5" /><verse number="6" style="v" sid="1CH 25:6" />Háguchi hábutibei sun hagía dan le heremuhan ténpulurugu áfareina pülatíyu gamuriti árüpa tuma gidara.</para>
  <para style="p" vid="1CH 25:6">Asafü, Hedutún luma Emán, lábugiñeñanu meha lugumadin urúei. <verse eid="1CH 25:6" /><verse number="7" style="v" sid="1CH 25:7" />Hadan sun áfarutiña hau sun hábirigu ha geremuhadibaña lun Bungiu, bián-sánñanu-bián-wein-widü.<verse eid="1CH 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 25:8" />Ábati lafanreinhóun lidaani eseriwiduni luagu ubunuruni hadan súngubei, dandu wéinamuhaña kei ñǘbürigiña, máisturugu hamá yebe o afurendeirutiña lan.<verse eid="1CH 25:8" /></para>
  <para style="p">
    <verse number="9-31" style="v" sid="1CH 25:9-31" />Lárigiñe lasagarún ubunuruni, ítara liña ligaburi herederun lúmagiñe aban lumoun wein-gádürü:</para>
  <para style="p" vid="1CH 25:9-31">Hosé,</para>
  <para style="p" vid="1CH 25:9-31">Gedalíasi,</para>
  <para style="p" vid="1CH 25:9-31">Sakuru,</para>
  <para style="p" vid="1CH 25:9-31">Isürí,</para>
  <para style="p" vid="1CH 25:9-31">Netaníasi,</para>
  <para style="p" vid="1CH 25:9-31">Bukíasi,</para>
  <para style="p" vid="1CH 25:9-31">Hesaréla,</para>
  <para style="p" vid="1CH 25:9-31">Isaíasi,</para>
  <para style="p" vid="1CH 25:9-31">Mataníasi,</para>
  <para style="p" vid="1CH 25:9-31">Simí,</para>
  <para style="p" vid="1CH 25:9-31">Asaréli,</para>
  <para style="p" vid="1CH 25:9-31">Asawíasi,</para>
  <para style="p" vid="1CH 25:9-31">Suwaeli,</para>
  <para style="p" vid="1CH 25:9-31">Matatíasi,</para>
  <para style="p" vid="1CH 25:9-31">Heremótu,</para>
  <para style="p" vid="1CH 25:9-31">Ananíasi,</para>
  <para style="p" vid="1CH 25:9-31">Hosubekása,</para>
  <para style="p" vid="1CH 25:9-31">Ananí,</para>
  <para style="p" vid="1CH 25:9-31">Malotí,</para>
  <para style="p" vid="1CH 25:9-31">Eliatá,</para>
  <para style="p" vid="1CH 25:9-31">Otirü,</para>
  <para style="p" vid="1CH 25:9-31">Gidalüti,</para>
  <para style="p" vid="1CH 25:9-31">Masiotu,</para>
  <para style="p" vid="1CH 25:9-31">Romamüti-éserü.</para>
  <para style="p" vid="1CH 25:9-31">Kada aban hádangiñe hau líbirigu hama lisaanigu, dúusuñanu.<verse eid="1CH 25:9-31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" sid="1CH 26" />
  <para style="s1">Óunigirutiña bena ténpulurugu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 26:1" />Dan lafanreinhóunbei lidaani eseriwiduni hadan óunigirutiña bena, ítara liña ligaburi herederun:</para>
  <para style="p" vid="1CH 26:1">Hádangiñe ladügawagun Koré, Meselemíasi le liráü Koré, le liráü Ebiasáfü. <verse eid="1CH 26:1" /><verse number="2" style="v" sid="1CH 26:2" />Lirahüñü Meselemíasi: Sakaríasi le íbugañaü, Hediaeli le habiaman; Sewadíasi háürüwan; Hatüniéli hagadürün; <verse eid="1CH 26:2" /><verse number="3" style="v" sid="1CH 26:3" />Elamü haseingün; Hoanán hasisin, Elioenái hasedün.<verse eid="1CH 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 26:4" />Lirahüñü Owedi-edomu: Semaíasi furumiñeti; Hosabádü habiaman; Hoá háürüwan; Sakarü hagadürün; Natanaéli haseingün; <verse eid="1CH 26:4" /><verse number="5" style="v" sid="1CH 26:5" />Amieli hasisin; Isakárü hasedün; Peulutái hawidün. Lugundun biní lumuti Bungiu Owedi-edomu lau líchugun saragu isaanigu lun.<verse eid="1CH 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 26:6" />Garahüñüti meha Semaíasi bián wügüriña irahüñü ha agumadihabaña hadan haduheñu lugundun ganigitiña. <verse eid="1CH 26:6" /><verse number="7" style="v" sid="1CH 26:7" />Lirahüñü Semaíasi: Otuní, Rafaili, Owedi, Elisabádü, Eliú, Samakíasi, wügüriña ganigitiña súngubei. <verse eid="1CH 26:7" /><verse number="8" style="v" sid="1CH 26:8" />Sun ha, ladügawagun Owedi-edomu hama lirahüñü hama líbirigu, sun hagía wügüriña ganigitiña según benefaü le aubei heseriwida. Hadan súngubei, ǘrüwa-wein-biámañanu ladügawagun Owedi-edomu.<verse eid="1CH 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 26:9" />Lirahüñü Meselemíasi hama líbirigu: Disiwídüñanu, sun hagía wügüriña ganigitiña.<verse eid="1CH 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 26:10" />Lirahüñü Osá, ladügawagun Merarí: Simürí le ábuti, lau sun mama lan ligía íbugañaünbei, aba líchuguni lúguchi ábutime; <verse eid="1CH 26:10" /><verse number="11" style="v" sid="1CH 26:11" />Ilükíasi habiaman, Tewalíasi háürüwan; Sakaríasi hagadürün. Lirahüñü Osá hama líbirigu, tareisiñanu hadan súngubei.<verse eid="1CH 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 26:12" />Afanreinhóuatiña óunigirutiña bena lidan sétanu. Dandu hagía keisi hábutigu hama hapanaagu, yuuti eseriwiduni ténpulurugu houn. <verse eid="1CH 26:12" /><verse number="13" style="v" sid="1CH 26:13" />Adüga hamuti ubunuruni luagu kada bena hadan iduheñu, lidan ubunuruni ñéinñanu dandu íbugañanu kei amulenugu.<verse eid="1CH 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 26:14" />Lun Semaíasi latokara bena le luéigiñebei oubaü le ñéingiñe lubéi laboucha weyu, lun Sakaríasi le liráü latokara le luéigiñebei nórute. <verse eid="1CH 26:14" /><verse number="15" style="v" sid="1CH 26:15" />Lun Owedi-edomu latokara le luéigiñebei suru, houn lirahüñü latokara lun hóunigirunu rumu to lagei éigini tidan ténpulu. <verse eid="1CH 26:15" /><verse number="16" style="v" sid="1CH 26:16" />Lun Supimü luma Osá latokara oubaü le ñeinhin lubéi lálüda weyu, le ñéingiñe lubéi bena Saleketü, luagun lémeri amudeiruni.</para>
  <para style="p" vid="1CH 26:16">Ítara liña ligaburi lafanreinhóun eseriwiduni: <verse eid="1CH 26:16" /><verse number="17" style="v" sid="1CH 26:17" />Sagü weyu ñéinñanu sisi óunigirutiña bena luéigiñe oubaü le ñéingiñe lubéi laboucha weyu, gádürü luéigiñe nórute, gádürü luéigiñe suru hama biama lun kada rumu lagei éigini. <verse eid="1CH 26:17" /><verse number="18" style="v" sid="1CH 26:18" />Lidan bürürü, luéigiñe oubaü le ñeinhin lubéi lálüda weyu, ñéinñanu gádürü luéigiñe ebeluruni hama biama lun guánarügü bürürü. <verse eid="1CH 26:18" /><verse number="19" style="v" sid="1CH 26:19" />Ítara liña ligaburi lafanreinhóun hafisiute óunigirutiña bena ha ladügawagun Koré luma Merarí.<verse eid="1CH 26:19" /></para>
  <para style="s1">Amu eseriwidutiña ténpulurugu</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20" />Amu Lewitagu arihubaña lau lóunigirun tirisin ténpulu luma lagei idewesei le sagüráubei. <verse eid="1CH 26:20" /><verse number="21" style="v" sid="1CH 26:21" />Hádangiñe lirahüñü Ladán, ha ladügawagun Gerüsón luma Heieli, <verse eid="1CH 26:21" /><verse number="22" style="v" sid="1CH 26:22" />lirahüñü Heieli, Setamü luma Hoeli ha lamulenu, hagía arihubaña lau tirisin ténpulu.<verse eid="1CH 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 26:23" />Hádangiñe ladügawagun Amürámü, Isarü, Ebürón luma Usieli, <verse eid="1CH 26:23" /><verse number="24" style="v" sid="1CH 26:24" />Sebueli le ladügawagun Gerüsón luma Moisesi ligíatima arihubei lau tirisin ténpulu.<verse eid="1CH 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 26:25" />Ha liduheñu luéigiñe lóubadina Elieserü: Reawíasi le liráü Elieserü; Isaíasi le liráü Reawíasi; Horamü le liráü Isaíasi; Sikürí le liráü Horamü luma Selomitü le liráü Sikürí.<verse eid="1CH 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 26:26" />Selomitü hau lamulenu, hagía arihubaña lau burí lagei ílagu sagüráuti le lanúadirubei Dawidi, hábutigu iduheñu hama hábutigu súdaragu lun Bungiu. <verse eid="1CH 26:26" /><verse number="27" style="v" sid="1CH 26:27" />Katei le burí hárügüdün wuriburugu ani aba hadireiruni lun layusurún tidan litenpulun Bungiu. <verse eid="1CH 26:27" /><verse number="28" style="v" sid="1CH 26:28" />Ñeinñein giñe burí ílagu sagüráuti le lanúadirubei Samueli, Saulu le liráü Kisü, Ábünerü le liráü Nerü luma Hoabü le liráü Seruiá. Sun katei sagüráuti le anuadirúaalibei le, lábugiñeñein laríaahan Selomitü hama lamulenu.<verse eid="1CH 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 26:29" />Hádangiñe ladügawagun Isarü, ha arihubaña lau burí katei bóugudi umuti le lani Ísüraeli kei úfisigu luma kei aguseragüdütiña: Kenaníasi hama lirahüñü.<verse eid="1CH 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 26:30" />Hádangiñe ladügawagun Ebürón, ha etenirubaña lun haríaahaniña Ísüraelina luéigiñe oubaü le ñéingiñe lubéi lálüda weyu libiti Hordán, dandu lidan burí katei luáguti Bungiu kei lidan leseriwidun lun urúei: Asawíasi hama liduheñu, milu-sedü-san wügüriña ganigitiña.<verse eid="1CH 26:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 26:31" />Lidan irumu bián-wein lidan larúeihan Dawidi, aba lariaahóun tidan líburu to ñein lubéi habürüdǘwa ladügawagun Ebürón, aba ladarirún luagu añahein lan wügüriña ganigitiña hadan uburugu Haserü le Galaadüna. Heríasi, ligía meha hábutibei ladügawagun Ebürón; <verse eid="1CH 26:31" /><verse number="32" style="v" sid="1CH 26:32" />bián-míluñanu-sedü-san hábutigu iduheñu, ligía hama liduheñu. Aba líchuguniña urúei Dawidi lun harihin hau türibu ha lani Rubén, ha lani Gadü hama hamidan türibu ha lani Manasési, lun sun katei le luáguti Bungiu o luáguti lan urúei.<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" sid="1CH 27" />
  <para style="s1">Amu burí úfisigu lani Dawidi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 27:1" />Anihán hiri Ísüraelina según hábutigu iduheñu, hábutigu súdaragu hama úfisigu ha eseriwidubaña lun urúei lidan sun katei le luáguti asudarahani, ha eseriwidubaña según dan luagu hati lidan sun irumu. Wein-gádürüñanu-milu wügüriña lidan kada sétanu.<verse eid="1CH 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 27:2" />Furumiñeti óunigiruti lidan furumiñeti hati: Hasobeámü le liráü Sabüdiéli hábutibei, <verse eid="1CH 27:2" /><verse number="3" style="v" sid="1CH 27:3" />ladügawagun Fáresi gumadan houn sun hábutigu súdaragu ha eseriwidubaña lidan furumiñeti hati.<verse eid="1CH 27:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 27:4" />Óunigiruti lidan libiaman hati: Dodái le Aoita hábutibei.<verse eid="1CH 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 27:5" />Óunigiruti lidan lǘrüwan hati: Benaíasi le liráü Hoyadá fádiri le íñugutimabei hábutibei, <verse eid="1CH 27:5" /><verse number="6" style="v" sid="1CH 27:6" />le meha ábanbei hádangiñe darandi ganigitiña luma hábuti. Gama lumoun Amisabádü le liráü agumadirubalin fánreinguaü ligía.<verse eid="1CH 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 27:7" />Óunigiruti lidan ligadürün hati: Asaeli le lamulen Hoabü hábutibei. Sewadíasi le liráü leweñeguabei.<verse eid="1CH 27:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 27:8" />Óunigiruti lidan liseingün hati: Samutu le Ísüraita hábutibei.<verse eid="1CH 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 27:9" />Óunigiruti lidan lisisin hati: Irá le liráü Ikesi le Tekoana hábutibei.<verse eid="1CH 27:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 27:10" />Óunigiruti lidan lisedün hati: Elesi le Palütíta, le ladügawagun Éfürain hábutibei.<verse eid="1CH 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 27:11" />Óunigiruti lidan liwidün hati: Siwekái le lílana Usá, ladügawagun Sera.<verse eid="1CH 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 27:12" />Óunigiruti lidan linefun hati: Ebieserü le Anatótuna, le ladügawagun Benhamín hábutibei.<verse eid="1CH 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 27:13" />Óunigiruti lidan lidiisin hati: Maarai le Netofána, le ladügawagun Sera hábutibei.<verse eid="1CH 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 27:14" />Óunigiruti lidan liunsun hati: Benaíasi le Piratónna, le ladügawagun Éfürain hábutibei.<verse eid="1CH 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 27:15" />Óunigiruti lidan liduusun hati: Elüdái le Netofána, le ladügawagun Otoniéli hábutibei.<verse eid="1CH 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 27:16" />Lábutigu lani Ísüraeli türibu: Hábuti lánigu Rubén, Elieserü le liráü Sikürí, hábuti lánigu Simeón, Sefatíasi le liráü Maaká; <verse eid="1CH 27:16" /><verse number="17" style="v" sid="1CH 27:17" />hábuti lánigu Lewí, Asawíasi le liráü Kemueli; hábuti ladügawagun Aarón, Sadoku; <verse eid="1CH 27:17" /><verse number="18" style="v" sid="1CH 27:18" />hábuti lánigu Hudá, Eliú, aban hádangiñe líbugañanu Dawidi; hábuti lánigu Isakárü, Omurí le liráü Mikaeli; <verse eid="1CH 27:18" /><verse number="19" style="v" sid="1CH 27:19" />Hábuti lánigu Sabulón, Isümaíasi le liráü Abüdíasi; hábuti lánigu Nefütalí, Herimótu le liráü Asüriéli; <verse eid="1CH 27:19" /><verse number="20" style="v" sid="1CH 27:20" />hábuti lánigu Éfürain, Oseasi le liráü Asasíasi, hábuti hamidan lani Manasési türibu, Hoeli, le liráü Pedaíasi; <verse eid="1CH 27:20" /><verse number="21" style="v" sid="1CH 27:21" />hábuti le aban hamidan türibu ha Galaadübaña, Idó le liráü Sakaríasi; hábuti lánigu Benhamín, Haasieli le liráü Ábünerü, <verse eid="1CH 27:21" /><verse number="22" style="v" sid="1CH 27:22" />hábuti lánigu Dan, Asaréli le liráü Heroamü. Hagía meha ha hábutigubaña lani Ísüraeli türibu.<verse eid="1CH 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23" />Mabahüdün lumutiña Dawidi ha ǘnabugiñabaña luéi wein irumu, ladüga ariñagaali lan meha Bungiu luagu ladügüba lan lun hagibedagun Ísüraelina kei waruguma ha siélubaña. <verse eid="1CH 27:23" /><verse number="24" style="v" sid="1CH 27:24" />Gumese lumuti Hoabü habahüdün gürigia gama lumoun magumu lumuti, lugundun barüti katei ligía abeichúni luagun Ísüraeli. Ligía mabürüdǘn lubéi átiriñanu lan tidan líburu to lánina asusereduti luáguti urúei Dawidi.<verse eid="1CH 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 27:25" />Asümáweti le liráü Adieli, ligía meha lúniribei lirisin urúei, gama lumoun Yónatan le liráü Usíasi ligía arihubei tau burí lagei éigini to áraabuboun, to uburuguboun, to burí fulasuruguboun tuma to burí lídanboun fadaguaü.<verse eid="1CH 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 27:26" />Esürí le liráü Kelubu, ligía arihubei hau nadagimeintiña ha ábunagubaña nadü. <verse eid="1CH 27:26" /><verse number="27" style="v" sid="1CH 27:27" />Simí le liráü Ramatü, ligía arihubei tau beibei-agei, Sabüdí le liráü Sefamü, ligía arihubei lau tádarawagun diwéin budigürugun. <verse eid="1CH 27:27" /><verse number="28" style="v" sid="1CH 27:28" />Baali-anán, ligía arihubei lau oliwu-agei luma burí dabíara le ñein tubéi igu áraabuna to luáguboun fulasu mawübüriti, Hoasi ariha lau fulasu le ñein lubéi lareidúa garaba. <verse eid="1CH 27:28" /><verse number="29" style="v" sid="1CH 27:29" />Sitürái le Saronna, ligía arihubei hau bágasu ha Saronbaña, Safatü le liráü Adülái, ligía ariha hau bágasu ha luágubaña fulasu wayati. <verse eid="1CH 27:29" /><verse number="30" style="v" sid="1CH 27:30" />Owili le Ísümaelina, ligía arihubei hau kameyu; Hedíasi le Meronótuna ariha hau burigü; <verse eid="1CH 27:30" /><verse number="31" style="v" sid="1CH 27:31" />Hasisü, le tadügawagun Agarü ariha hau mudún. Sun ha, hagía óunigirubalin lumegen urúei Dawidi.<verse eid="1CH 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 27:32" />Yónatan le liyaurite Dawidi, wügüri chu tau, ligía eweridihabei, Heieli le liráü Akümoní, ligía éibugubei hama lirahüñü urúei. <verse eid="1CH 27:32" /><verse number="33" style="v" sid="1CH 27:33" />Eweridihati meha giñe lani urúei Aitoféli, Usaí le Arükíta, ligía wügüri lemeniginbei urúei. <verse eid="1CH 27:33" /><verse number="34" style="v" sid="1CH 27:34" />Hoyadá le liráü Benaíasi luma Abiatárü, hagía leweñeguabaña Aitoféli lidan lubara, Hoabü ligía meha hábutibei súdaragu.<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" sid="1CH 28" />
  <para style="s1">Larúeihan Salomón leweñegua Dawidi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1" />Aba lóundaruniña Dawidi sun gumadimatiña Ísüraelina uburugu Herusalén, hábutigu türibu, hábutigu súdaragu ha eseriwidubaña lun urúei, gumadangu, úfisigu, ha óunigirubalin lumúan hama libiñanigu urúei hama lirahüñü, gürigia burí ha íñugutimabaña hama sun súdaragu íñugutiña.<verse eid="1CH 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2" />Ábati lararamun Dawidi, aba lariñagun:</para>
  <para style="p" vid="1CH 28:2">—Aganba humana níbirigu: Anihein yebe meha lidan naritagun lun nábunagun aban muna lun hamuga ñeinboun lan lubagüsina lidaradun Bungiu súnwandan, lun hamuga giñe ñeinba lan líchigei Wabungiute lálana larúeihan, ani aransedina yebe lun nábunagunu muna tuguya. <verse eid="1CH 28:2" /><verse number="3" style="v" sid="1CH 28:3" />Gama lumoun aba lariñagun Bungiu nun: “Mámaba buguya ábunagua ténpulu nun, lugundun wuriburuguna buguya ani gíbeeña gürigia báfarun. <verse eid="1CH 28:3" /><verse number="4" style="v" sid="1CH 28:4" />Gama lumoun, anúadira lumutina Bungiu le Lubungiute Ísüraeli hádangiñe niduheñu lun líchuguniña lurúeiteme Ísüraeli lun súnwandan. Anúadira lumuti lani Hudá türibu keisi türibu agumadihati; hádangiñe lani Hudá türibu anúadira lumutiña niduheñu; hádangiñe níbirigu, anúadira lumutina lun urúeibadina lan lidan sun Ísüraeli. <verse eid="1CH 28:4" /><verse number="5" style="v" sid="1CH 28:5" />Guentoti, hádangiñe sun nisaanigu kei híbebei líchugun Bungiu nun, anúadira laali Bungiu niráü le Salomón lun larúeihan Ísüraeli”.<verse eid="1CH 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 28:6" />—Ariñagati giñe Bungiu nun: “Salomón le biráü, ligíaba ábunaguoun nitenpulun luma nibürürün, lugundun anúadira naali keisi niráü, ani ábanbadina úguchili lun, <verse eid="1CH 28:6" /><verse number="7" style="v" sid="1CH 28:7" />nederebudagüdübei larúeihan lun súnwandan. Anhein ítarameme luba lubéi agunfulirei nugumadin kei ladügüni chülǘ lumoun weyu le uguñe”.<verse eid="1CH 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8" />—Guentó lubeiti, ligibugiñe sun Ísüraeli, hagibugiñe lidamurin Bungiu ha luma ligibugiñe Bungiu le aganbagubei woun, gúnfuli huméi sun lugumadin Bungiu tau sun hanigi, lun hanimémebei lan ageiraü wéndeti le, lárigiñe ábame hígiruni houn hirahüñü halaganteme. <verse eid="1CH 28:8" /><verse number="9" style="v" sid="1CH 28:9" />Buguyati Salomón, niráü. Subudibéi Bungiu le Habungiute bagübürigu, seriwibéi tau sun banigi luma lau ugundani, lugundun ariha lumuti Bungiu sun aritaguni, subudi lumuti sun le lídanbei wasaminan. Anhein lubeiti báluaha Bungiu, badarirubei; gama lumoun ánhabu adireira luéi, lígirubadibu lun súnwandan. <verse eid="1CH 28:9" /><verse number="10" style="v" sid="1CH 28:10" />Subudibéiti guentó luagu anúadira láadibu lan Bungiu lun bábunagun aban muna lun lun lúbanme. Gaguraasunbá lubeiti, adügabéi wadagimanu!<verse eid="1CH 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11" />Ábati lederegerunu Dawidi pülanu lun Salomón to lani tibürürün ténpulu, muna to lareidaagüle éigini, sun lasali luma Fulasu le Sándutimabei, le ñein lubéi ferudunawa lan figóu. <verse eid="1CH 28:11" /><verse number="12" style="v" sid="1CH 28:12" />Ru lumuti giñe wadagimanu lun luagu sun le laritagubei lun tibürürün ténpulu, luma burí rumu le lunbei geyegubei lan lau, irisini luma lagei idewesei le sagüráubei, <verse eid="1CH 28:12" /><verse number="13" style="v" sid="1CH 28:13" />tuma giñe burí rumu lun lidaani heseriwidun fádirigu Lewitagu luma sun eseriwiduni ténpulurugu, luma giñe lun sun ílagu le lánina kultu ténpulurugu.<verse eid="1CH 28:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 28:14" />Ruti giñe saragu golu luma pülata lun, lun sun ílagu golu luma pülata le lunbei layusurúniwa lidan kultu; <verse eid="1CH 28:14" /><verse number="15" style="v" sid="1CH 28:15" />lun burí lebu sanudelu lau sun lilanpun, dandu le golu kei le pülata, ru lumuti lun según lihürü kada aban; <verse eid="1CH 28:15" /><verse number="16" style="v" sid="1CH 28:16" />Ligiaméme giñe ladüga lun kada aban lídangiñe dábula, dandu le golu kei le pülata le lunbei ñeinba lan tichugúa fein anuadirúatu aban tárigi aban. <verse eid="1CH 28:16" /><verse number="17" style="v" sid="1CH 28:17" />Ruti giñe golu lun lun lubuñame burí fígiedu, bésini luma fudu, luma saragu golu, lubuñame burí weru luma pülata le lauti golu luma le lauti pülata según lihürü kada aban. <verse eid="1CH 28:17" /><verse number="18" style="v" sid="1CH 28:18" />Ruti giñe saragu golu afinuhóuaali lun lubuñame latarü le lebu kupali; ru ligía golu lun lun tubuñame karü, hameme kátaña garünatiña ha adouragubaña tau lubagüsina lidaradun Bungiu lau harüna.<verse eid="1CH 28:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 28:19" />Sun le, bürüwañu liña meha kei lariñaguni Bungiu lun Dawidi lidan luénedü, ñein lubéi lariñawagúa sun burí wadagimanu le lunbei ladügǘn según tarufuduni pülanu.<verse eid="1CH 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20" />Ábati lariñagun Dawidi lun Salomón:</para>
  <para style="p" vid="1CH 28:20">—Ganigibá deregüda buguyame, adügabéi wadagimanu! Mábürühala barüna manufude buguyame, lugundun búmabei Bungiu le Nubungiute! Mígirun lubadibu bábugua darí lagumuchun sun wadagimanu lun eseriwiduni le tani ténpulu. <verse eid="1CH 28:20" /><verse number="21" style="v" sid="1CH 28:21" />Aranseñu liña lidaani heseriwidun fádirigu hama Lewitagu ténpulurugu. Híderagubadibu giñe sun hawuyeri lau hagundan lidan sun wadagimanu, subudihabútiña lun sun luwuyeri eseriwiduni, ábutigu hama sun lílana fulasu.<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" sid="1CH 29" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1" />Lárigiñe aba lariñagun urúei Dawidi lun sun damuriguaü:</para>
  <para style="p" vid="1CH 29:1">—Salomón le niráü, le lanúadirubei Bungiu, aban nibureinti ñǘraügili ligía, ani wadagimanu le, wéiriti, lugundun mámaba luban urúei ábunawagua, litenpulunba Bungiu ábunawagua. <verse eid="1CH 29:1" /><verse number="2" style="v" sid="1CH 29:2" />Au lau saragu áfaaguni, aranse naali le mégeibei tun litenpulun Aburemei le Wabungiute: Golu, pülata, buronse, gürabu, fulansu, dübü lun ladügǘn bídiriu, dübü buíduburiti, dübü le ámuñegueinarügüti likolorun lun turageirugu ténpulu, luma saragu márümolu. <verse eid="1CH 29:2" /><verse number="3" style="v" sid="1CH 29:3" />Gama lumoun bóugudin luéi sun le aranse náalibei tubá ténpulu, luma luagu ínsiñehabuni le nuágubei tun litenpulun Wabungiute, derege numuti golu luma pülata le nani tun ténpulu: <verse eid="1CH 29:3" /><verse number="4" style="v" sid="1CH 29:4" />Bián-san-wein-milu líburu lídangiñe lubuidun-agei golu, seingü-san-wein-widü-milu líburu pülata fínuti lun lafurarún burí touba muna. <verse eid="1CH 29:4" /><verse number="5" style="v" sid="1CH 29:5" />Sun golu luma pülata lun ladügün le lunbei ladügün lau, luma lun sun wadagimanu le lunti hadügüni nadagimeintiña. Guentoti, ka busenbei líchuguni lufanran lau ugundani, lau ledewehan somu katei lun Bungiu?<verse eid="1CH 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6" />Sunti ábutigu, hábutigu iduheñu, hábutigu lani Ísüraeli türibu, hábutigu súdaragu hama hábutigu ha nadagimeinbaña luma urúei, aba hedewehan saragu katei. <verse eid="1CH 29:6" /><verse number="7" style="v" sid="1CH 29:7" />Rútiña ǘrüwa-san-ǘrüwa-wein-ǘrüwa-milu líburu luma diisi-milu murusun golu, sedü-san-wein-sisi-milu líburu pülata, luma yarafa lun aban-míñunu-ǘrüwa-san-wein-milu líburu buronse, luma sedü-míñunu-bián-san-ǘrüwa-wein-milu líburu gürabu.<verse eid="1CH 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 29:8" />Ha gámabaña burí dübü buíduburiti, derege hamuti lidoun tirisin ténpulu le lábugiñebei laríaahan Heieli le liráü Gerüsón.<verse eid="1CH 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 29:9" />Aba hagundaarun gürigia luagu idewesei ligía, lugundun tau sun hanigi hedeweha lun Bungiu. Wéiriti giñe lagundaarun urúei Dawidi.<verse eid="1CH 29:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10" />Ábati labiniruni Dawidi Bungiu ligibugiñe damuriguaü, lariñaga:</para>
  <para style="p" vid="1CH 29:10">—Biniwabá lun súnwandan, Bungiu, Lubungiute Wáguchi Ísüraeli! <verse eid="1CH 29:10" /><verse number="11" style="v" sid="1CH 29:11" />Bungiu Baba, wéirigutibu ani gabafutibu, íñugutibu ani úaraguatibu! Lugundun bani sun katei le siélubei luma le ubouagubei. Buguya urúeibei, buguya agumadihati le tímatimaati. <verse eid="1CH 29:11" /><verse number="12" style="v" sid="1CH 29:12" />Búmagiñe liabin irisini luma inebesei. Buguya abugurubalin sun katei. Búhaburuguñein erei luma ubafu, buguya giñe íchugubei uéiriguni luma ubafu houn súngubei. <verse eid="1CH 29:12" /><verse number="13" style="v" sid="1CH 29:13" />Ligía lébubei weteingiruñadibu lubéi guentó Bungiu Baba, eremuha wagía lun biri le íñugubei; <verse eid="1CH 29:13" /><verse number="14" style="v" sid="1CH 29:14" />lugundun, kátañadinagia ani kátañanu numutuniña lun wíchuguba lan katei gíbeti bun? Lidan linarün katei, búmagiñe liabin sun katei, le wibihibei búmagiñe ligía wíchugubei bun. <verse eid="1CH 29:14" /><verse number="15" style="v" sid="1CH 29:15" />Ítara waña bigibugiñe kei terencha ha ásügürütiña kei habéi meha sun wagüchagu, ani ítara liña wabagari ligibuagu ubóu le kei aban lamuñounga, úati ni murusun emenigini luagu.<verse eid="1CH 29:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 29:16" />—Aburemei, le Wabungiute, bani ani búmagiñe liabin sun irisini le, le waranserubei lun wábunagun aban ténpulu lun biri le sándubei! <verse eid="1CH 29:16" /><verse number="17" style="v" sid="1CH 29:17" />Subudi numuti Bungiu Baba, luagu aríaahabani saminaü luma luagu hínsiñe lan úaraguni bun. Ligía lau lubéi lúaragun aritaguni níchigei sun le bun. Ani guentó, ariha naali lau ugundani luagu lau lan ugundani híchigei bánigu ha óundaragubaña ya hadewese bun. <verse eid="1CH 29:17" /><verse number="18" style="v" sid="1CH 29:18" />Bungiu, Lubungiute Abüraámü, Isaakü luma Hakobu, ha wagüchagu, adügabá lun ñein lan erei le hadan bumutuniña súnwandan, adundehabóun hanigi lun hafalarunibu. <verse eid="1CH 29:18" /><verse number="19" style="v" sid="1CH 29:19" />Ruba giñe aban anigi dayarütu lun Salomón lun gayaraabei lan lagunfuliruni bugumadin luma bilurudun, luma lun gayaraabei lan lábunagunu ténpulu to ubaaboun naranseha.<verse eid="1CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20" />Lárigiñe aba lariñagun Dawidi lun damuriguaü:</para>
  <para style="p" vid="1CH 29:20">—Guentó, heremuha lun Aburemei le Wabungiute.</para>
  <para style="p" vid="1CH 29:20">Ábati lagumeserun sun damuriguaü eremuha lun Bungiu, le Habungiute hagüchagu, aba háhuduragun bulugua hagía ligibugiñe Bungiu luma ligibugiñe urúei. <verse eid="1CH 29:20" /><verse number="21" style="v" sid="1CH 29:21" />Larugan aba híchugun adagaragüdüni luma adagaragüdüni gudawarügüti lun Bungiu: Milu bágasu wügüriña ha ñǘbürigiña, milu mudún hama milu harahüñü mudún, lau hadewese to diwéin luma saragu adagaragüdüni luagu sun Ísüraeli. <verse eid="1CH 29:21" /><verse number="22" style="v" sid="1CH 29:22" />Weyu ligía, hóutiña, gurá hagía lau saragu ugundani ligibugiñe Bungiu. Lárigiñe ábaya hagúarahani Salomón luagu libiaman wéiyaasu keisi urúei. Aba hanúadiruni ligibugiñe Bungiu keisi urúei, Sadoku keisi fádiri. <verse eid="1CH 29:22" /><verse number="23" style="v" sid="1CH 29:23" />Aba lubeiti lañuurun Salomón keisi urúei leweñegua Dawidi le lúguchi, aba lawanserun saragu. Adüga hamuti sun Ísüraelina le lubeibei. <verse eid="1CH 29:23" /><verse number="24" style="v" sid="1CH 29:24" />Sun ábutigu ha wuriburuguna hau sun lirahüñü urúei Dawidi, luéigiñeñanu lufulesein Salomón. <verse eid="1CH 29:24" /><verse number="25" style="v" sid="1CH 29:25" />Adügati Bungiu lun wéirigu lan hanügüni sun lílana Ísüraeli Salomón, ani wéirigüda lumuti Bungiu sügǘ hau sun ha arúeihabaña lubaragiñe Ísüraeli.<verse eid="1CH 29:25" /></para>
  <para style="s1">Lounwen Dawidi</para>
  <para style="r">(<ref loc="1KI 2:10-12">1 Uru 2.10-12</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26" />Arúeihati lubeiti Dawidi le liráü Hesé lidan sun Ísüraeli. <verse eid="1CH 29:26" /><verse number="27" style="v" sid="1CH 29:27" />Ligía meha lurúeitebei Ísüraeli luagu bián-wein-irumu, sedü irumu larúeihan Ebürón, darandi-ǘrüwa irumu Herusalén. <verse eid="1CH 29:27" /><verse number="28" style="v" sid="1CH 29:28" />Lau uéiyani darangilati lounwe, lau saragu irisini luma uéiriguni. Aba larúeihan Salomón le liráü leweñegua.<verse eid="1CH 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 29:29" />Sun asusereduti luáguti Dawidi, lúmagiñe lagumeseha lumoun lagumuhóun, anihein bürüwañu tidan liliburun profeta Samueli tidan liliburun profeta Natán luma tidan liliburun profeta Gadü <verse eid="1CH 29:29" /><verse number="30" style="v" sid="1CH 29:30" />labu sun luáguti larúeihan, lubafu luma burí sun katei le asuseredubei lun, lun Ísüraeli luma lun burí líbiri ageiraü.<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>