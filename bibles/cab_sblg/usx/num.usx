<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NUM" style="id">NUMERU.TXT (Encoding update 2008) 27/02/2001 CAP C.R, GARIFUNA</book>
  <para style="h">1 Lúrudu</para>
  <para style="toc3">1 Lur</para>
  <para style="toc2">1 Lúrudu</para>
  <para style="toc1">1 Lúrudu</para>
  <para style="mt2">Furumiñetu Liliburun</para>
  <para style="mt1">LÚRUDU</para>
  <chapter number="1" style="c" sid="NUM 1" />
  <para style="ms">I. Disinéfu Weyu Sinaí</para>
  <para style="mr">(<ref loc="NUM 1:1-10:10">1.1—10.10</ref>)</para>
  <para style="s1">Habahüdǘniwa Ísüraelina Sinaí</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 1:1" />Lidan libiaman irumu lúmagiñe háfuridun Ísüraelina Ehiptugiñe, weyu furumiñe lidan libiaman hati, aba ladimurehan Wabureme lun Moisesi lidan fulasu mageirawati le gíribei Sinaí, tidan kianpu lánina óundaruni luma Wabungiute, lariñaga lun:<verse eid="NUM 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 1:2" />—Abahüdǘwa hamá sun Ísüraelina, hawagu hani türibu luma luagu iduheñuguaü, lun lasubudirúniwa hiri ani lun larihín átiriñanu lan wügüriña <verse eid="NUM 1:2" /><verse number="3" style="v" sid="NUM 1:3" />ha weinti irumu hau lun iñun, ha gayaraahali houdin awuribuha. Abürüha humaña kei habürühóuniwa milidaru, lau lídehan Aarón <verse eid="NUM 1:3" /><verse number="4" style="v" sid="NUM 1:4" />luma aban hábuti iduheñu luagu kada türibu. <verse eid="NUM 1:4" /><verse number="5" style="v" sid="NUM 1:5" />Anihán burí hiri ábutigu ha lúnbaña híderagunün:</para>
  <para style="p" vid="NUM 1:5">—Lídangiñe lani Rubén türibu: Elisúru le liráü Sedeuru.<verse eid="NUM 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 1:6" />—Lídangiñe lani Simeón türibu: Selumiéli, le liráü Surisadái.<verse eid="NUM 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 1:7" />—Lídangiñe lani Hudá türibu: Naasón, le liráü Aminadábü.<verse eid="NUM 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 1:8" />—Lídangiñe lani Isakárü türibu: Natanaéli, le liráü Suarü.<verse eid="NUM 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 1:9" />—Lídangiñe lani Sabulón türibu: Eliabü, le liráü Elón.<verse eid="NUM 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 1:10" />—Lídangiñe hani lirahüñü Hosé türibu: Elisamá, le liráü Amiudu, lídangiñe lani Éfürain türibu; luma Gamalieli, le liráü Pedasúru, lídangiñe lani Manasési türibu.<verse eid="NUM 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 1:11" />—Lídangiñe lani Benhamín türibu: Abidán, le liráü Gidoní.<verse eid="NUM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 1:12" />—Lídangiñe lani Dan türibu: Aieserü, le liráü Amisadái.<verse eid="NUM 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 1:13" />—Lídangiñe lani Aserü türibu: Pagieli, le liráü Okürán.<verse eid="NUM 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 1:14" />—Lídangiñe lani Gadü türibu: Eliasáfü, le liráü Reueli.<verse eid="NUM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 1:15" />—Lídangiñe lani Nefütalí türibu: Airá, le liráü Enán.<verse eid="NUM 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 1:16" />Hagía burí hábutibaña türibugu ha anúadirubaña hadan Ísüraelina lun hagíaba lan ararama habá habá hani türibu. <verse eid="NUM 1:16" /><verse number="17-18" style="v" sid="NUM 1:17-18" />Weyu furumiñe lidan libiaman hati lidan irumu ligía, aba lóundaruniña Moisesi luma Aarón wügüriña ha líridubaña Bungiu, hama sun lílana fulasu, aba habahüdüniña sun Ísüraelina, abürüheina haméi hani türibu, haduheñu, liri kada aban luma átiriñanu lan wügüriña ha weinti irumu hau lun iñun hadan súngubei, <verse eid="NUM 1:17-18" /><verse number="19" style="v" sid="NUM 1:19" />ítara kei lariñaguni Wabureme lun Moisesi. Lidan fulasu mageirawati le gíribei Sinaí ladügǘwa abahüdǘni le.<verse eid="NUM 1:19" /></para>
  <para style="p">
    <verse number="20-21" style="v" sid="NUM 1:20-21" />Dan lásurunbei habahüdǘn gürigia luagu hani türibu, luma luagu iduheñuguaü, bürüwa ligía liri kada aban luma átiriñanu lan wügüriña ha lóugiñebaña wein irumu, ítara liña herederun: Hádangiñe lani Rubén türibu, le liráü Ísüraeli le íbugañaü, abahüdǘwatiña bián-wein-sisi-milu-seingü-san wügüriña ha gayaraahali houdin awuribuha.<verse eid="NUM 1:20-21" /></para>
  <para style="p">
    <verse number="22-23" style="v" sid="NUM 1:22-23" />Dimí-san-nefu-milu-ǘrüwa-san abahüdǘtiña lídangiñe lani Simeón türibu.<verse eid="NUM 1:22-23" /></para>
  <para style="p">
    <verse number="24-25" style="v" sid="NUM 1:24-25" />Bián-wein-seingü-milu-sisi-san-dimí lídangiñe lani Gadü türibu.<verse eid="NUM 1:24-25" /></para>
  <para style="p">
    <verse number="26-27" style="v" sid="NUM 1:26-27" />Ǘrüwa-wein-katorusu-milu-sisi-san lídangiñe lani Hudá türibu.<verse eid="NUM 1:26-27" /></para>
  <para style="p">
    <verse number="28-29" style="v" sid="NUM 1:28-29" />Dimí-san-gádürü-milu-gádürü-san lídangiñe lani Isakárü türibu.<verse eid="NUM 1:28-29" /></para>
  <para style="p">
    <verse number="30-31" style="v" sid="NUM 1:30-31" />Dimí-san-sedü-milu-gádürü-san lídangiñe lani Sabulón türibu.<verse eid="NUM 1:30-31" /></para>
  <para style="p">
    <verse number="32-35" style="v" sid="NUM 1:32-35" />Hádangiñe ladügawagun Hosé abahüdǘwatiña bián-wein-milu-seingü-san lídangiñe lani Éfürain türibu, darandi-bián-milu-bián-san lídangiñe lani Manasési türibu.<verse eid="NUM 1:32-35" /></para>
  <para style="p">
    <verse number="36-37" style="v" sid="NUM 1:36-37" />Lídangiñe lani Benhamín türibu abahüdǘwatiña darandi-seingü-milu-gádürü-san.<verse eid="NUM 1:36-37" /></para>
  <para style="p">
    <verse number="38-39" style="v" sid="NUM 1:38-39" />Ǘrüwa-wein-bián-milu-sedü-san lídangiñe lani Dan türibu.<verse eid="NUM 1:38-39" /></para>
  <para style="p">
    <verse number="40-41" style="v" sid="NUM 1:40-41" />Bián-wein-aban-milu-seingü-san lídangiñe lani Aserü türibu.<verse eid="NUM 1:40-41" /></para>
  <para style="p">
    <verse number="42-43" style="v" sid="NUM 1:42-43" />Dimí-san-ǘrüwa-milu-gádürü-san lídangiñe lani Nefütalí türibu.<verse eid="NUM 1:42-43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 1:44" />Hadan sun gürigia Ísüraelina ha labahüdübaña Moisesi, Aarón hama duusu ábutigu Ísüraelina ha hábutigubaña hani türibu hama haduheñu: <verse eid="NUM 1:44" /><verse number="45-46" style="v" sid="NUM 1:45-46" />Sisi-sánñanu-ǘrüwa-milu-seingü-san-dimí Ísüraelina ha weinti irumu hau lun iñun ha gayaraahali houdin awuribuha.<verse eid="NUM 1:45-46" /></para>
  <para style="s1">Habügürü Lewitagu</para>
  <para style="p">
    <verse number="47" style="v" sid="NUM 1:47" />Mabahüdǘntiña Lewitagu hadan hatüribun hagüchagu, <verse eid="NUM 1:47" /><verse number="48" style="v" sid="NUM 1:48" />ladüga ariñagaali lan buga Wabureme lun Moisesi:<verse eid="NUM 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="NUM 1:49" />—Danme babahüdüniña Ísüraelina, mabahüdabei lani Lewí türibu hadan. <verse eid="NUM 1:49" /><verse number="50" style="v" sid="NUM 1:50" />Lunti bíchuguniña Lewitagu lun heseriwidun tidan sanduariu to lánina daradu, lun harihin lau umegeni luma sun le yuubei tun sanduariu. Hagíaba anaahoun sanduariu luma tumegegu, hadügübei giñe eseriwiduni ñein. Lunti giñe geyeguba lan tau sanduariu hararamagüdoun hakianpun-agei, <verse eid="NUM 1:50" /><verse number="51" style="v" sid="NUM 1:51" />ani danme lunti lan tanügǘn lidoun amu fulasu, hagíaba aragachaguoun ráramagüda hamounme tárigoun dánmeya lunti lan hararamagun lidan somu fulasu. Furumiñeguarügü gürigia le ayarafaduti tun sanduariu bóugudin hawéi Lewitagu, lasiadirúba lun lounwen. <verse eid="NUM 1:51" /><verse number="52" style="v" sid="NUM 1:52" />Ha híbiri Ísüraelina hesetiraguame houngua kei milidaru, kada aban tidan likianpun-agei, lábugiñe lufanidiran. <verse eid="NUM 1:52" /><verse number="53" style="v" sid="NUM 1:53" />Ha Lewitagu, herederuba geyegua tau lisanduariuna daradu lun hóunigirunu luéi lagañidun Wabureme houn Ísüraelina.<verse eid="NUM 1:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="NUM 1:54" />Aba hadügüni Ísüraelina sun katei ítara kei lariñaguni Wabureme lun Moisesi.<verse eid="NUM 1:54" /></para>
  <chapter eid="NUM 1" />
  <chapter number="2" style="c" sid="NUM 2" />
  <para style="s1">Tesetirúniwa burí kianpu-agei</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 2:1" />Aba ladimurehan Wabureme lun Moisesi luma Aarón, lariñaga houn:<verse eid="NUM 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 2:2" />—Lunti hesetirunu Ísüraelina hakianpun-agei díseraü, geyegu tau kianpu lánina óundaruni, kada aban lábugiñe lufanidiran luma lau haseinin liduheñu.<verse eid="NUM 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 2:3" />—Luéigiñeba oubaü le ñéingiñe lubéi laboucha weyu heredera ha lábugiñebaña lufanidiran Hudá. Naasón le liráü Aminadábü hábutibei milidaru ha lídangiñebaña lani Hudá türibu, <verse eid="NUM 2:3" /><verse number="4" style="v" sid="NUM 2:4" />según abahüdǘni ǘrüwa-wein-katorusu-milu sisi-sánñanu wügüriña. <verse eid="NUM 2:4" /><verse number="5" style="v" sid="NUM 2:5" />Hóubagiñeba ha, heredera milidaru ha lídangiñebaña lani Isakárü türibu, Natanaéli le liráü Suarü hábutibei, <verse eid="NUM 2:5" /><verse number="6" style="v" sid="NUM 2:6" />ani dimí-san-gádürü-míluñanu-gádürü-san wügüriña. <verse eid="NUM 2:6" /><verse number="7" style="v" sid="NUM 2:7" />Herederuba giñe milidaru ha lídangiñebaña lani Sabulón türibu ñein hama, Eliabü le liráü Elón hábutibei, <verse eid="NUM 2:7" /><verse number="8" style="v" sid="NUM 2:8" />ani dimí-san-sedü-milu-gádürü-sánñanu wügüriña. <verse eid="NUM 2:8" /><verse number="9" style="v" sid="NUM 2:9" />Ítara liña lubeiti ñéinñanu ǘrüwa sétanu súdaragu tidan lani Hudá kianpu-agei, lidan ǘrüwa sétanu ligía san-gádürü-wein-sisi-milu-gádürü-sánñanu wügüriña, ha lúnbaña hamudeirun habá habá Ísüraelina.<verse eid="NUM 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 2:10" />—Luéigiñeba suru heredera milidaru ha awanserubaña lábugiñe lufanidiran Rubén, Elisúru le liráü Sedeuru hábutibei, <verse eid="NUM 2:10" /><verse number="11" style="v" sid="NUM 2:11" />según habahüdüniña, bián-wein-sisi-milu-seingü-sánñanu wügüriña. <verse eid="NUM 2:11" /><verse number="12" style="v" sid="NUM 2:12" />Harugabuba heredera milidaru ha lídangiñebaña lani Simeón türibu, Selumiéli le liráü Surisadái hábutibei, <verse eid="NUM 2:12" /><verse number="13" style="v" sid="NUM 2:13" />ani lídanbei habahüdǘniwa dimí-san-nefu-milu-ǘrüwa-sánñanu wügüriña. <verse eid="NUM 2:13" /><verse number="14" style="v" sid="NUM 2:14" />Ñéinbaña giñe milidaru ha lídangiñebaña lani Gadü türibu hama, Eliasáfü le liráü Reueli hábutibei, <verse eid="NUM 2:14" /><verse number="15" style="v" sid="NUM 2:15" />ani lídanbei habahüdǘn bián-wein-seingü-milu-sisi-san-dimiñanu wügüriña. <verse eid="NUM 2:15" /><verse number="16" style="v" sid="NUM 2:16" />Ítara liña lubeiti ñéinbaña ǘrüwa sétanu súdaragu tidan lani Rubén kianpu-agei hadan ǘrüwa sétanu hagía san-dimí-aban-milu-gádürü-san-dimiñanu wügüriña ha lúnbaña hamudeirun lidan libiaman ubaraü.<verse eid="NUM 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 2:17" />—Hamudeiruba Lewitagu tamidangua gádürügubei kianpu-agei, barüina hamounme kianpu lánina óundaruni hámagua. Gádürügubei kianpu-agei tamudeiruba aban tárigi aban, según buga igaburi le aubei herederagua, kada aban lábugiñe tufanidiran.<verse eid="NUM 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 2:18" />—Luéigiñeba oubaü le ñéingiñe lubéi lálüda weyu herederagua milidaru ha amudeirubaña lábugiñe lufanidiran Éfürain, Elisamá le liráü Amiudu hábutibei, <verse eid="NUM 2:18" /><verse number="19" style="v" sid="NUM 2:19" />ani lídanbei habahüdǘniwa bián-wein-milu-seingü-sánñanu wügüriña hadan. <verse eid="NUM 2:19" /><verse number="20" style="v" sid="NUM 2:20" />Hóubagiñeba ha leredera sétanu súdaragu ha lánigu Manasési, Gamalieli le liráü Pedasúru hábutibei, <verse eid="NUM 2:20" /><verse number="21" style="v" sid="NUM 2:21" />ani darandi-bián-milu-bián-sánñanu wügüriña lídanbei habahüdǘniwa. <verse eid="NUM 2:21" /><verse number="22" style="v" sid="NUM 2:22" />Hóubagiñeba ha heredera milidaru ha lídangiñebaña lani Benhamín türibu, Abidán le liráü Gidoní hábutibei, <verse eid="NUM 2:22" /><verse number="23" style="v" sid="NUM 2:23" />ani darandi-seingü-milu-gádürü-sánñanu wügüriña lídanbei habahüdǘniwa. <verse eid="NUM 2:23" /><verse number="24" style="v" sid="NUM 2:24" />Ítara liña lubeiti ñéinbaña ǘrüwa sétanu súdaragu tidan kianpu-agei to lani Éfürain, san-widü-milu-sánñanu wügüriña ha amudeirubaña lidan lǘrüwan ubaraü.<verse eid="NUM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 2:25" />—Luéigiñe nórute, ñéingiñebaña súdaragu ha amudeirubaña lábugiñe lufanidiran Dan. Aieserü le liráü Amisadái hábutibei, <verse eid="NUM 2:25" /><verse number="26" style="v" sid="NUM 2:26" />ǘrüwa-wein-bián-milu-sedü-sánñanu wügüriña. <verse eid="NUM 2:26" /><verse number="27" style="v" sid="NUM 2:27" />Hóubagiñeba ha heredera súdaragu ha lánigu Aserü, Pagieli le liráü Okürán hábutibei, <verse eid="NUM 2:27" /><verse number="28" style="v" sid="NUM 2:28" />bián-wein-aban-milu-seingü-sánñanu wügüriña lídanbei habahüdǘn. <verse eid="NUM 2:28" /><verse number="29" style="v" sid="NUM 2:29" />Hóubagiñeba ha, heredera súdaragu ha lánigu Nefütalí, Airá le liráü Enán hábutibei, <verse eid="NUM 2:29" /><verse number="30" style="v" sid="NUM 2:30" />Dimí-san-ǘrüwa-milu-gádürü-sánñanu wügüriña lídanbei habahüdǘniwa. <verse eid="NUM 2:30" /><verse number="31" style="v" sid="NUM 2:31" />Ítara liña lubeiti ñéinbaña lan ǘrüwa sétanu súdaragu tidan lani Dan kianpu-agei, san-dimí-san-sedü-milu-sisi-sánñanu wügüriña ha lúnbaña agumuhóuni hamá lárigi hafanidiran.<verse eid="NUM 2:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 2:32" />Lídanbei habahüdǘniwa iduheñu Ísüraelina rútiña aban sétanu súdaragu hau sisi-san-ǘrüwa-milu-seingü-san-dimí wügüriña. <verse eid="NUM 2:32" /><verse number="33" style="v" sid="NUM 2:33" />Gama lumoun kei lariñagun Wabureme lun Moisesi, mabahüdǘntiña Lewitagu hadan híbiri Ísüraelina.<verse eid="NUM 2:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 2:34" />Adüga hamuti Ísüraelina sun katei ítara kei lariñaguni Wabureme lun Moisesi: Kada aban lábugiñe lufanidiran ani múdeiti hama lani türibu ani hama liduheñu.<verse eid="NUM 2:34" /></para>
  <chapter eid="NUM 2" />
  <chapter number="3" style="c" sid="NUM 3" />
  <para style="s1">Le lunbei hadügüni Lewitagu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 3:1" />Añahán meha ladügawagunbaña Aarón luma Moisesi lidan meha dan le ladimurehanbei Moisesi luma Wabureme luagu wübü Sinaí: <verse eid="NUM 3:1" /><verse number="2" style="v" sid="NUM 3:2" />Lirahüñü Aarón: Nadabü le íbugañaü, Abiu, Eleasárü luma Itamárü. <verse eid="NUM 3:2" /><verse number="3" style="v" sid="NUM 3:3" />Gádürügubei hagía deregeguatiña houngua lun hafadirihan, <verse eid="NUM 3:3" /><verse number="4" style="v" sid="NUM 3:4" />gama lumoun hilati Nadabü luma Abiú ligibugiñe Wabureme ladüga hágudahan katei le terenchati lun lidan fulasu mageirawati Sinaí. Hagía marahüñütiña buga. Ábati hafadirihan Eleasárü luma Itamárü lábugiñe laríaahan Aarón le háguchi.<verse eid="NUM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 3:5" />Aba ladimurehan Wabureme lun Moisesi, lariñaga lun:<verse eid="NUM 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 3:6" />—Waba houn lílana lani Lewí türibu, lun híchaagun houngua labun lugumadin fádiri Aarón lun heseriwidun lun. <verse eid="NUM 3:6" /><verse number="7" style="v" sid="NUM 3:7" />Heseriwiduba lun Aarón luma houn lílana fulasu tigibugiñe kianpu lánina óundaruni, hagíaba ariha lau eseriwiduni tidan sanduariu. <verse eid="NUM 3:7" /><verse number="8" style="v" sid="NUM 3:8" />Hóunigirubei giñe tumegegun kianpu lánina óundaruni, seriwi hagíame houn Ísüraelina lidan sun le adügǘbei tidan sanduariu. <verse eid="NUM 3:8" /><verse number="9" style="v" sid="NUM 3:9" />Díreibaña Lewitagu hádangiñe híbiri Ísüraelina, lun híchaagun houngua lúnrügü heseriwidun lun Aarón luma houn ladügawagun, <verse eid="NUM 3:9" /><verse number="10" style="v" sid="NUM 3:10" />ígirabei hafisiute fádirigu lúhaburugu Aarón hama ladügawagun. Le adügüti lifisiute fádiri mámouga ligía fádiri, lasiadirúba lun lounwen.<verse eid="NUM 3:10" /></para>
  <para style="s1">Yúutiña Lewitagu lun Wabureme</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 3:11" />Aba ladimurehan Wabureme luma Moisesi, lariñaga lun:<verse eid="NUM 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 3:12" />—Anúadira naaña Lewitagu hádangiñe Ísüraelina leweñegua furumiñeti haráü kada iduheñu. Yúutiña nun, <verse eid="NUM 3:12" /><verse number="13" style="v" sid="NUM 3:13" />ladüga yuuti sun furumiñeti isaani nun. Dan le náfaraguagüdünbaliña hágiramagu Ehiptuna, aba nareiduniña hasaanigu Ísüraelina ha íbugañanu hama furumiñetiña harahüñü animaalugu nungua. Yúutiña lubeiti nun. Au Aburemeibei. Abahüdabaña Lewitagu hawagu haduheñu hama hani türibu, ábame babürüdüniña wügüriña ha ábanti hati hau lun iñun.<verse eid="NUM 3:13" /></para>
  <para style="s1">Habahüdǘn Lewitagu</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 3:14" />Aba ladimurehan Wabureme lun Moisesi lidan fulasu mageirawati Sinaí, lariñaga lun: <verse eid="NUM 3:14" /><verse number="15" style="v" sid="NUM 3:15" />«Abahüdabaña Lewitagu según iduheñuguaü luma según hani külán, ábame babürüdüniña sun wügüriña Lewitagu ha ábanti hati hau lun iñun». <verse eid="NUM 3:15" /><verse number="16" style="v" sid="NUM 3:16" />Aba ladügüni Moisesi, ítara kei lariñaguni Wabureme lun.<verse eid="NUM 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 3:17" />Ǘrüwañanu meha lirahüñü Lewí: Gerüsón, Keatü luma Merarí. <verse eid="NUM 3:17" /><verse number="18-20" style="v" sid="NUM 3:18-20" />Hagía burí lagüchagubaña külán le anügübalin hiri. Biámañanu meha lirahüñü Gerüsón: Libüní luma Simí. Gádürüñanu meha lirahüñü Keatü: Amürámü, Isarü, Ebürón luma Usieli. Ánheinti Merarí biámañanu lirahüñü: Malí luma Musí. Hagía meha hagüchagubaña hani Lewitagu külán ha gíribaña ítara.<verse eid="NUM 3:18-20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 3:21" />Ha lani Libüní luma Simí külán, hagía lánibaña Gerüsón. <verse eid="NUM 3:21" /><verse number="22" style="v" sid="NUM 3:22" />Hadan sun ha abahüdǘbaña ha ábanti hati hau lun iñun, bürüwatiña sedü-milu-seingü-san. <verse eid="NUM 3:22" /><verse number="23" style="v" sid="NUM 3:23" />Sun ha, tanagangiñeñoun sanduariu hani kianpu-agei luéigiñe oubaü le ñéingiñe lubéi lálüda weyu. <verse eid="NUM 3:23" /><verse number="24" style="v" sid="NUM 3:24" />Eliasáfü le liráü Laeli, ligía hábutibei ladügawagun Gerüsón. <verse eid="NUM 3:24" /><verse number="25" style="v" sid="NUM 3:25" />Tidan kianpu lánina óundaruni, hagía arihubaña tau sanduariu, kianpu, idáü le lauti uraü, korutína to tubenariboun kianpu, <verse eid="NUM 3:25" /><verse number="26" style="v" sid="NUM 3:26" />korutína burí to lídanboun bürürü, korutína to luáguboun lubenari bürürü to geyeguboun tau sanduariu luma latarü luma burí tagürüga.<verse eid="NUM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 3:27" />Lani Keatü külán, hagiamémeha lani Amürámü, Isarü, Ebürón luma Usieli, <verse eid="NUM 3:27" /><verse number="28" style="v" sid="NUM 3:28" />wügüriña ha abürüdǘbaña hádangiñe, ha ábanti hati hau lun iñun, wídüñanu-milu-ǘrüwa-san. Hagía óunigirubarun sanduariu, <verse eid="NUM 3:28" /><verse number="29" style="v" sid="NUM 3:29" />ani luéigiñeñanu suru tibiti sanduariu külán burí le. <verse eid="NUM 3:29" /><verse number="30" style="v" sid="NUM 3:30" />Elisafán le liráü Usieli hábutibei külán ha. <verse eid="NUM 3:30" /><verse number="31" style="v" sid="NUM 3:31" />Lábugiñeñoun haríaahan külán ha, lubagüsina daradu, dábula, lebu sanudelu, latarü, ílagu burí sagüráuti le ayusurúbei lidan kultu, belu luma sun tumegegu.<verse eid="NUM 3:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 3:32" />Eleasárü le liráü fádiri Aarón, ligía furumiñetibei hábuti Lewitagu, ligía aríaahabaliña ha óunigirubarun sanduariu.<verse eid="NUM 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 3:33" />Ha lani Malí luma Musí külán, hagiaméme lánibaña Merarí. <verse eid="NUM 3:33" /><verse number="34" style="v" sid="NUM 3:34" />Hadan sun ha abürüdǘbaña hádangiñe ha ábanti hati hau lun iñun, sisi-milu-bián-sánñanu. <verse eid="NUM 3:34" /><verse number="35" style="v" sid="NUM 3:35" />Surieli le liráü Abiaili hábutibei ani luéigiñeñanu nórute tibiti sanduariu. <verse eid="NUM 3:35" /><verse number="36" style="v" sid="NUM 3:36" />Ladügawagun Merarí anügübaña kárugu lau tufulansun sanduariu, tíndanute, tuágaburi, tebu luma sun le ayusurubei tidan, <verse eid="NUM 3:36" /><verse number="37" style="v" sid="NUM 3:37" />luma giñe lau burí wagabu le geyegubei lau bürürü, tebu, tuewen luma tuguruduna.<verse eid="NUM 3:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 3:38" />Luéigiñe oubaü le ñéingiñe lubéi laboucha weyu, tigibugiñe sanduariu tuma kianpu lánina óundaruni ñeinñein Moisesi, Aarón hama lirahüñü Aarón, ha óunigirubarun sanduariu lidan hiri ha híbiri Ísüraelina. Leha adügüti lifisiute fádiri mámouga ligía fádiri, ábaha lasiadirúniwa lun lounwen.<verse eid="NUM 3:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 3:39" />Dan le labahüdünbaliña Moisesi luma Aarón Lewitagu keisi lariñagun Wabureme lun, wügüriña ha ábanti hati hau lun iñun, wein-bián-míluñanu hadan súngubei.<verse eid="NUM 3:39" /></para>
  <para style="s1">Hesefurun ígiramaügu</para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 3:40" />Aba lariñagun Wabureme lun Moisesi:</para>
  <para style="p" vid="NUM 3:40">—Abahüdabaña hágiramagu Ísüraelina wügüriña ha ábanti hati hau lun iñun, ábame babürüdüni hiri. <verse eid="NUM 3:40" /><verse number="41" style="v" sid="NUM 3:41" />Bígirañame Lewitagu nun heweñegua hágiramagu Ísüraelina. Au Aburemeibei. Ígirabañame giñe habiñanigu Lewitagu nun heweñegua furumiñetiña harahüñü habiñanigu Ísüraelina.<verse eid="NUM 3:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 3:42" />Aba labahüdüniña Moisesi hasaanigu Ísüraelina ha íbugañanu ítara kei lariñaguni Wabureme lun, <verse eid="NUM 3:42" /><verse number="43" style="v" sid="NUM 3:43" />wein-biámañanu-milu-bián-san-ǘrüwa-wein-tareisi wügüriña ha ábanti hati hau lun iñun abürüdǘtiña.<verse eid="NUM 3:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 3:44" />Aba ladimurehan Wabureme lun Moisesi, lariñaga lun:<verse eid="NUM 3:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="NUM 3:45" />—Barübaña Lewitagu heweñegua hágiramagu Ísüraelina hama habiñanigu Lewitagu heweñegua habiñanigu Ísüraelina ladüga yúutiña Lewitagu nun. Au Aburemeibei. <verse eid="NUM 3:45" /><verse number="46" style="v" sid="NUM 3:46" />Gama lumoun gíbetimatiña hágirama Ísüraelina wügüriña sügǘ hau Lewitagu; lun lubeiti hesefurun bián-san-ǘrüwa-wein tareisi íbugañanu Ísüraelina ha hóugiñebaña, <verse eid="NUM 3:46" /><verse number="47" style="v" sid="NUM 3:47" />bamuriaha aban ídemuei le seingü murusun pülata luma kada gürigia, según lihürü tiseinsuna Sanduariu, le ábanbei murusun pülata le únsuti güramu, <verse eid="NUM 3:47" /><verse number="48" style="v" sid="NUM 3:48" />bíchigeime lun Aarón luma houn lirahüñü keisi lebegi hesefurun.<verse eid="NUM 3:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="NUM 3:49" />Aba lóundaruni Moisesi seinsu le lebegi hesefurun hágiramagu Ísüraelina ha ígiragubaña, <verse eid="NUM 3:49" /><verse number="50" style="v" sid="NUM 3:50" />aba lóundarun milu-ǘrüwa-san-ǘrüwa-wein murusun pülata, según lihürü tiseinsuna sanduariu. <verse eid="NUM 3:50" /><verse number="51" style="v" sid="NUM 3:51" />Lárigiñe aba lederegeruni seinsu ligía lun Aarón hama lirahüñü, ítara kei lariñaguni Wabureme lun.<verse eid="NUM 3:51" /></para>
  <chapter eid="NUM 3" />
  <chapter number="4" style="c" sid="NUM 4" />
  <para style="s1">Hafisiute Lewitagu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 4:1" />Aba ladimurehan Wabureme lun Moisesi luma Aarón, lariñaga houn:<verse eid="NUM 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 4:2" />—Abahüdabaña Lewitagu ha ladügawagun Keatü, hawagu hani külán luma luagu iduheñuguaü <verse eid="NUM 4:2" /><verse number="3" style="v" sid="NUM 4:3" />ha daranditi irumu hau lumoun dimí-san, ha gayaraati heseriwidun tidan kianpu lánina óundaruni. <verse eid="NUM 4:3" /><verse number="4" style="v" sid="NUM 4:4" />Sagüráuti hawadigimari ladügawagun Keatü, anihán wadagimanu le lunbei hadügüni: <verse eid="NUM 4:4" /><verse number="5" style="v" sid="NUM 4:5" />Danme le hamufurun súngubei lun hadüga lan wéiyaasu, lunti lagidarunu Aarón hama lirahüñü belu to lubenariboun fulasu le sándutimabei ábame hadouragunu tuagun bágüsi to lánina daradu. <verse eid="NUM 4:5" /><verse number="6" style="v" sid="NUM 4:6" />Híchigame aban idáü to lautu uraü fínuti tigibuagu, ani tigibuagu tura ábame hátulerun aban gamisa koloru guchu to ábanrügütu fiesu, ábame híchuguni tebu tuagu lun hanügünu. <verse eid="NUM 4:6" /><verse number="7" style="v" sid="NUM 4:7" />Hátuleruba giñe aban gamisa guchu ligibuagu dábula lánina adagaragüdüni lun Bungiu, tigibuaguba hadagaragüdei asiedu, guliyeru, kopu, weru, luma burí fudu tun diwéin to idewesei, tuma fein to adagarawagüdüboun súnwandan. <verse eid="NUM 4:7" /><verse number="8" style="v" sid="NUM 4:8" />Ligibuagu sun le, hátuleruba aban gamisa funatu, ábame hadouragunu tau aban idáü to lautu uraü fínuti, ábame híchuguni wewe le lebu luagu lun hanügüni. <verse eid="NUM 4:8" /><verse number="9" style="v" sid="NUM 4:9" />Lárigiñe ábame hanügün aban gamisa guchu, ábame hadouragun lau lebu sanudelu tau, lanpu, labudaha leñegura watu, lirahüñü asiedu luma sun weru le ayusurubei lun lágeime garaba. <verse eid="NUM 4:9" /><verse number="10" style="v" sid="NUM 4:10" />Ábame hóuburaguni sun le tau aban idáü lautu uraü fínuti, ábame híchuguni ligibuagu fiu wewe lun hanügüni.<verse eid="NUM 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 4:11" />—Hátuleruba giñe aban gamisa guchu ligibuagu latarü le láutibei golu, ábame hóuburaguni tau aban idáü lautu uraü fínuti, ábame híchuguni wewe le lebu luagu lun lanügǘn. <verse eid="NUM 4:11" /><verse number="12" style="v" sid="NUM 4:12" />Lárigiñe ábame habudahani umegeni le ayusurúbei tidan sanduariu, ábame híchuguni tidoun aban gamisa guchu, ábame hóuburaguni tidan aban idáü to lautu uraü fínuti, ábame hanügüni ligibuagu wewe. <verse eid="NUM 4:12" /><verse number="13" style="v" sid="NUM 4:13" />Gasu hagidaruni agülei luma baligi luéigiñe latarü, lárigiñe ábame hadouragun lau tau aban gamisa funafunagutu. <verse eid="NUM 4:13" /><verse number="14" style="v" sid="NUM 4:14" />Ábame híchuguni sun le ayusurúbei lidan lemesi luagu latarü: Lagei burí leñegura watu, fígiedu, chóbuli, kopu wéinamuti, sun burí ílagu le ayusurúbei luagu latarü. Ábame ladourawagun lau sun le tau aban idáü lautu uraü fínuti ani rúa ligíame luéwena lun lanaahóuniwa. <verse eid="NUM 4:14" /><verse number="15" style="v" sid="NUM 4:15" />Danme súnhali lóuburaguni Aarón hama lirahüñü ílagu le burí sagüráubei, danme aranseña lun hiñurahan wéiyaasu, gayaraabei hayabin ladügawagun Keatü lun hagía lan anügei sun ílagu le. Gama lumoun moun lumuti haguurun ni kata le sagüráuti lau háhabu, luéi hóunwegun. Sun burí tila kianpu lánina óundaruni le, ligía lunbei hanügüni ladügawagun Keatü. <verse eid="NUM 4:15" /><verse number="16" style="v" sid="NUM 4:16" />Eleasárü, le liráü fádiri Aarón, ligíaba ariha lau gasi lun lanpu, kupali hémeti, idewesei le fulúaruauti, sun idewesei le lunbei hadagaragüdüni nun súnwandan, luma lau garaba le lánina ederegeruni. Gasu giñe hóunigirunu sanduariu luma sun le tídanbei, luma giñe burí ílagu sagüráuti.<verse eid="NUM 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 4:17" />Aba ladimurehan Wabureme lun Moisesi luma Aarón, lariñaga houn:<verse eid="NUM 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 4:18" />—Mígira humá lun hagumuchagun liduheñu Keatü haganaguagiñe Lewitagu. <verse eid="NUM 4:18" /><verse number="19" style="v" sid="NUM 4:19" />Anihán katei le lunbei hadügüni lun máfarawagun hamá luéigiñe haguurun burí katei le sagüráuti: Lariñagubei Aarón hama lirahüñü lun kada aban hádangiñe kaba lan ladüga luma kaba lan lanüga. <verse eid="NUM 4:19" /><verse number="20" style="v" sid="NUM 4:20" />Ítara luba mebelurun hamá ni murusun oura arihei burí katei sagüráuti, lun móunwegun hamá.<verse eid="NUM 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 4:21" />Aba ladimurehan Wabureme lun Moisesi, lariñaga lun:<verse eid="NUM 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 4:22" />—Abahüdabaña giñe ladügawagun Gerüsón según hani külán luma luagu iduheñuguaü. <verse eid="NUM 4:22" /><verse number="23" style="v" sid="NUM 4:23" />Abahüdabaña ha daranditi irumu hau lumoun dimí-san, ha gayaraati heseriwidun tidan kianpu lánina óundaruni.<verse eid="NUM 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 4:24" />—Anihánba hawadigimari ladügawagun Gerüsón: <verse eid="NUM 4:24" /><verse number="25" style="v" sid="NUM 4:25" />Hagíaba anaahoun tikorutinan burí sanduariu, kianpu lánina óundaruni, idáü lautu uraü fínuti to adourúboun tigibuagu, korutína to luáguboun tubenari kianpu lánina óundaruni, <verse eid="NUM 4:25" /><verse number="26" style="v" sid="NUM 4:26" />likorutinan burí yadü; korutína lánina ebeluruni lidoun yadü to egeyedagubarun sanduariu luma latarü, agürügaü luma sun ílagu le emegeirubei lun hafisiute luma lun hawadigimari. <verse eid="NUM 4:26" /><verse number="27" style="v" sid="NUM 4:27" />Aarón hama lirahüñü hagíaba asubudiragüdei houn ladügawagun Gerüsón kaba lan hadüga luma burí katei le lunbei hagíaba lan anügei. Huguyaba ariha hau lun buídubei lan hadügüni hawadigimari. <verse eid="NUM 4:27" /><verse number="28" style="v" sid="NUM 4:28" />Anihán eseriwiduni le lunbei hadügüni haduheñu ladügawagun Gerüsón tidan kianpu lánina óundaruni lábugiñe laríaahan Itamárü le liráü fádiri Aarón.<verse eid="NUM 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 4:29" />—Abahüdabaña giñe ladügawagun Merarí, según hani külán luma luagu iduheñuguaü <verse eid="NUM 4:29" /><verse number="30" style="v" sid="NUM 4:30" />bürübaña sun ha daranditi irumu hau lumoun dimí-san, ha gayaraati heseriwidun tidan kianpu lánina óundaruni. <verse eid="NUM 4:30" /><verse number="31" style="v" sid="NUM 4:31" />Wadagimanu le lunbei hadügüni tidan kianpu lánina óundaruni, lun hanaahani tufulansuna sanduariu, tíndanute, tuágaburi, tisilinin, <verse eid="NUM 4:31" /><verse number="32" style="v" sid="NUM 4:32" />luagaburi yadü le geyegubei tau sanduariu, lau lisilinin, wewe le ácharuhoubei luma agürügaü luma sun le emegeirubei lun hawadigimari. Buguyaba ariñaga lun kada aban hádangiñe kaba lan katei lanüga. <verse eid="NUM 4:32" /><verse number="33" style="v" sid="NUM 4:33" />Ligía wadagimanu le lunbei hadügüni ladügawagun Merarí tidan kianpu lánina óundaruni lábugiñe ladundehan Itamárü le liráü fádiri Aarón.<verse eid="NUM 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 4:34" />Aba labahüdüniña Moisesi luma Aarón hama ábutigu fulasurugu ladügawagun Keatü según hani külán luma luagu iduheñuguaü, <verse eid="NUM 4:34" /><verse number="35" style="v" sid="NUM 4:35" />ha gúnfulihañabaña darandi lumoun dimí-san irumu, ha gayaraati heseriwidun tidan kianpu lánina óundaruni, <verse eid="NUM 4:35" /><verse number="36" style="v" sid="NUM 4:36" />bián-milu-sedü-san-dimiñanu wügüriña ha abahüdǘbaña. <verse eid="NUM 4:36" /><verse number="37" style="v" sid="NUM 4:37" />Hagía abahüdǘbaña hádangiñe ladügawagun Keatü ha gayaraabei heseriwidun tidan kianpu lánina óundaruni, según abahüdǘni le ladügübei Moisesi luma Aarón keisi lariñaguni Wabureme lun.<verse eid="NUM 4:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 4:38" />Ha ladügawagun Gerüsón, según hani külán luma luagu iduheñuguaü <verse eid="NUM 4:38" /><verse number="39" style="v" sid="NUM 4:39" />ha lídantiña darandi lumoun dimí-san irumu, ha gayaraati heseriwidun tidan kianpu lánina óundaruni, <verse eid="NUM 4:39" /><verse number="40" style="v" sid="NUM 4:40" />bián-milu-sisi-san-darandiñanu. <verse eid="NUM 4:40" /><verse number="41" style="v" sid="NUM 4:41" />Sun ha, hagía ladügawagunbaña Gerüsón ha gayaraabei heseriwidun tidan kianpu lánina óundaruni, según labahüdüniña Moisesi luma Aarón keisi lariñaguni Wabureme houn.<verse eid="NUM 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 4:42" />Ladügawagun Merarí según hani külán luma luagu iduheñuguaü, <verse eid="NUM 4:42" /><verse number="43" style="v" sid="NUM 4:43" />ha lídantiña darandi lumoun dimí-san irumu, ha gayaraati heseriwidun tidan kianpu lánina óundaruni, <verse eid="NUM 4:43" /><verse number="44" style="v" sid="NUM 4:44" />ǘrüwa-míluñanu-bián-san. <verse eid="NUM 4:44" /><verse number="45" style="v" sid="NUM 4:45" />Sun ha, hagía ladügawagunbaña Merarí ha gayaraabei heseriwidun tidan kianpu lánina óundaruni, según labahüdüniña Moisesi luma Aarón keisi buga lariñaguni Wabureme lun.<verse eid="NUM 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 4:46" />Hadan sun Lewitagu ha labahüdübaña Moisesi luma Aarón hama ábutigu Ísüraelina, hawagu hani külán luma iduheñuguaü, <verse eid="NUM 4:46" /><verse number="47" style="v" sid="NUM 4:47" />ha lídantiña darandi dagá lumoun dimí-san irumu, ha gayaraahaña heseriwidun tidan kianpu lánina óundaruni, <verse eid="NUM 4:47" /><verse number="48" style="v" sid="NUM 4:48" />widü-milu-seingü-san-gádürü-wéinñanu. <verse eid="NUM 4:48" /><verse number="49" style="v" sid="NUM 4:49" />Adügǘwati abahüdǘni le, según lariñaguni Wabureme lun Moisesi, ariñawagúa lun kada aban kaba lan ladüga luma kaba lan lanüga, ítara kei lariñaguni Wabureme lun Moisesi.<verse eid="NUM 4:49" /></para>
  <chapter eid="NUM 4" />
  <chapter number="5" style="c" sid="NUM 5" />
  <para style="s1">Háfuridagüdüniwa ha wíyebaña ligibugiñe Bungiu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 5:1" />Aba líchuguni Wabureme uganu le lun Moisesi lun lariñaguni houn Ísüraelina:<verse eid="NUM 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 5:2" />—Sagá humaña sun ha gawagutiña lépüra tídangiñe kianpu-agei, o ha lan gasanditiña ésedügüni, o ha lan wíyetiña lárigi haguurun hilaali. <verse eid="NUM 5:2" /><verse number="3" style="v" sid="NUM 5:3" />Lun hasagaruniña bóugudin tuéi kianpu-agei, wügüriña yebe, würiña yebe. Ítara luba mawiyedun hamanu kianpu-agei, to ñein lubéi naganawa haganagua.<verse eid="NUM 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 5:4" />Aba hadügüni Ísüraelina le lubeibei Wabureme lun Moisesi, aba hasagaruniña gürigia hagía tídangiñe kianpu-agei.<verse eid="NUM 5:4" /></para>
  <para style="s1">Afayeirúni luagu wuribati</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 5:5" />Aba ladimurehan Wabureme lun Moisesi, lariñaga lun:<verse eid="NUM 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 5:6" />—Ariñagabéi katei le houn Ísüraelina: Dan le magunfulirun lan aban wügüri o aban lan würi luma Wabureme, aba hadügün wuribati lun somu gürigia lau lira hadügüña figóu, <verse eid="NUM 5:6" /><verse number="7" style="v" sid="NUM 5:7" />ani mosu hasubudiruni luagu afigouhaaña lan. Gasu giñe lafayeiruni lebegi damichi le ladügübei ani rúraüya ligíame wein lídangiñe san ligibuagun lun gürigia le unbei ladügǘwa damichi. <verse eid="NUM 5:7" /><verse number="8" style="v" sid="NUM 5:8" />Anhein hilá lubéi gürigia le unbei ladügǘwa damichi ligía, ani maduheñuti ha úntiña gayara lan lichugún fáyeiti, ábame lerederun lun Wabureme lun lufulesein fádiri, lumoun mudún le lunbei ladagaragüdüni fádiri lun libihini ferudun luagu lifigoun gürigia ligía.<verse eid="NUM 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 5:9" />—Sun ídehani luma idewesei le hederegerun Ísüraelina lun Wabureme, le hanügün ligibugiñoun fádiri, lánibei fádiri. <verse eid="NUM 5:9" /><verse number="10" style="v" sid="NUM 5:10" />Sun le anügǘti ligibugiñoun fádiri lun lederegerun lun Wabureme, lánibei giñe fádiri.<verse eid="NUM 5:10" /></para>
  <para style="s1">Lúrudu lidan ñein lan emeidini</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 5:11" />Aba ladimurehan Wabureme lun Moisesi, lariñaga lun:<verse eid="NUM 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 5:12" />—Ariñagabéi katei le houn Ísüraelina: Lun hamuga magunfulirun tan aban würi luma túmari, <verse eid="NUM 5:12" /><verse number="13" style="v" sid="NUM 5:13" />aba tarounrun luma amu wügüri ibidiñounga lun túmari, ani íbini adüga tani iwiyei ligía gama lumoun aba lerederun katei ligía mafunrangunga ladüga machoururuniwa lan ani madarirawaguntu luma amu wügüri. <verse eid="NUM 5:13" /><verse number="14" style="v" sid="NUM 5:14" />Lidan kesi ligía, gayaraati hamuga lemeidihan wügüri tau lúmari. Gama lumoun gayaraati hamuga giñe lasuseredun lun lemeidihan wügüri tau lúmari íbini madurun tan. <verse eid="NUM 5:14" /><verse number="15" style="v" sid="NUM 5:15" />Lidan biángubei kesi le, ábame lanügünu wügüri lúmari ligibugiñoun fádiri, ábame líchugun gádürü líburu fulúaru lautu sebada keisi idewesei tuagu, gama lumoun máwiyurunbei garaba ni kupali tuagun fulúaru, ladüga aban lan idewesei luagu emeidini lira, aban idewesei lun lafuranguagüdüniwa aban figóu.<verse eid="NUM 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 5:16" />—Ábame lanügünu fádiri würi tuguya lurugabun, ábame líchugunu ligibugiñe Wabureme. <verse eid="NUM 5:16" /><verse number="17" style="v" sid="NUM 5:17" />Lárigiñe ábame lanügün murusun dibinísi lidan aban ágeidinaü le lauti múa, ábame lamigisiruni lau murusun kaliki le turageirugugiñeti sanduariu. <verse eid="NUM 5:17" /><verse number="18" style="v" sid="NUM 5:18" />Ábame lararamagüdünu würi tuguya ligibugiñe Wabureme, ábame lafaragaduni tídiburi, ábame líchuguni idewesei luagu emeidini, túhaburugun lun lafunranwaguagüdün figóu ligía, ábame lanügüni duna gífiti le anügübei íñarawaguni lúhaburugu. <verse eid="NUM 5:18" /><verse number="19" style="v" sid="NUM 5:19" />Ábameti láfiñuragüdünu würi tuguya, lariñagame tun: Anhein marounrungidibu lubéi luma amu wügüri luéi búmari, ani gúnfuli buguya luma búmari, madügün buguya ni kata le lunti lawiyedagüdünibu luma amu wügüri, masuseredalá ni kata bun danme bátuni duna gífiti le, le anügübei íñarawaguni, <verse eid="NUM 5:19" /><verse number="20" style="v" sid="NUM 5:20" />gama lumoun anhein magunfulirun bubéi luma búmari, anhein róunhadibu lubéi luma amu wügüri ani adüga buguya aban katei le lunti lawiyedagüdünibu; <verse eid="NUM 5:20" /><verse number="21" style="v" sid="NUM 5:21" />adügalábu Wabureme hénpulume lánina íñarawaguni hagibugiñe gürigia, lúgüdalounme bagei, ábame bagüriagun. <verse eid="NUM 5:21" /><verse number="22" style="v" sid="NUM 5:22" />Ligíaba abeichúni bibiha danme bátuni duna le, le anügübei íñarawaguni. Ábame tóunabun würi tuguya, tariñagame: Ítarala.<verse eid="NUM 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 5:23" />—Ábameti labürüdüni fádiri íñarawaguni le, ábame lachibuni lau duna le gífibei. <verse eid="NUM 5:23" /><verse number="24" style="v" sid="NUM 5:24" />Lárigiñe ábame látagüdüni duna ligía tun würi tuguya lun lagifidagüdüni turageirugu, <verse eid="NUM 5:24" /><verse number="25" style="v" sid="NUM 5:25" />ábame leresibiruni idewesei luéigiñe emeidini túhaburugugiñe lun ladagaragüdüni ligibugiñe Wabureme lárigiñe ábame líchuguni idewesei ligibuagu latarü, <verse eid="NUM 5:25" /><verse number="26" style="v" sid="NUM 5:26" />lárigiñe ábame lanügün murusun lídangiñe idewesei fulúaruauti le ñéingiñe lubéi tasagarúa fulúaru ábame láguduni luagu latarü keisi idewesei lánina aritaguni.</para>
  <para style="p" vid="NUM 5:26">—Lárigiñeme látagüdüni fádiri duna gífiti tun würi tuguya, <verse eid="NUM 5:26" /><verse number="27" style="v" sid="NUM 5:27" />anhein magunfulirun tubéi lun túmari, lagifidagüdübei duna le anügübei íñarawaguni turageirugu, ábame láludagüdüni turagei ábame tagüriaagun, ábame terederun würi tuguya kei hénpulu lánina íñarawaguni hadan gürigia. <verse eid="NUM 5:27" /><verse number="28" style="v" sid="NUM 5:28" />Gama lumoun anhein madurun tubéi, masuseredunbei ni kata tun ani gayaraabei garahüñü tan.<verse eid="NUM 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 5:29" />—Anihán lúrudubei lun burí kesi dan le magunfulirun tan würi lun túmari, ani aba lemeidihan, <verse eid="NUM 5:29" /><verse number="30" style="v" sid="NUM 5:30" />o dánrügü lan lemeidihan wügüri tau lúmari. Gasu lanügünu wügüri ligía lúmari ligibugiñoun Wabureme, ábame ladügüni fádiri le lariñagubei lúrudu le tau. <verse eid="NUM 5:30" /><verse number="31" style="v" sid="NUM 5:31" />Manügǘnbei úmari keisi gadurunti, gama lumoun anhein gadurun tubéi würi, tasufurirubei abeichúni le.<verse eid="NUM 5:31" /></para>
  <chapter eid="NUM 5" />
  <chapter number="6" style="c" sid="NUM 6" />
  <para style="s1">Hani nasaréu füramasei</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 6:1" />Aba líchuguni Wabureme uganu le lun Moisesi lun lariñaguni houn Ísüraelina:<verse eid="NUM 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 6:2" />—Anhein adüga aban gürigia füramasei lun lederegeragun lungua lun leseriwidun lun Wabureme, <verse eid="NUM 6:2" /><verse number="3" style="v" sid="NUM 6:3" />siñabei latun diwéin ni amu luwuyeri uniñein le achouhaali, ni binigá tauti diwéin o lauti lan uniñein achouhaali, ni tira beibei; siñabei giñe leigin beibei, ni in to gíriboun pasa. <verse eid="NUM 6:3" /><verse number="4" style="v" sid="NUM 6:4" />Siñabei latun ni kata le adügǘti lídangiñe beibei laganagua sun lani füramasei. <verse eid="NUM 6:4" /><verse number="5" style="v" sid="NUM 6:5" />Siñabei giñe lásaruni lídiburi lidan sun dan ligía, lubaragiñe lira mosu lígiruni darí lachülürün dan lun lásurun lani füramasei luma Wabureme. <verse eid="NUM 6:5" /><verse number="6" style="v" sid="NUM 6:6" />Lidan sun dan ligía, siñabei giñe layarafadun lun aban hilaali, <verse eid="NUM 6:6" /><verse number="7" style="v" sid="NUM 6:7" />ni íbini anhein ounwe lúguchi, o lúguchu, o líbugaña o lamulen o litu, luéi lerederun wíyeñu, lugundun lunti lerederun deregeguañu lungua lun Wabureme. <verse eid="NUM 6:7" /><verse number="8" style="v" sid="NUM 6:8" />Deregeguñu luba lungua lun Wabureme sun dan le ladurarun lani füramasei.<verse eid="NUM 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 6:9" />—Anhein ounwe aban gürigia sódini lurugabu, aba lawiyedun lídiburi le buga lederegerubei lun Wabureme ladüga óunweni le yarafa lun, gasu lásaruni lídiburi sedü weyu lárigiñe, lememe weyu le arufudúbei lun larumadun. <verse eid="NUM 6:9" /><verse number="10" style="v" sid="NUM 6:10" />Luágume liwidün weyu ábame lanügün bián wagugua o bián lan harahüñü unhun lun fádiri tubenarin kianpu lánina óundaruni. <verse eid="NUM 6:10" /><verse number="11" style="v" sid="NUM 6:11" />Ábame ladagaragüdün fádiri aban hádangiñe keisi adagaragüdüni luagu figóu, aban keisi adagaragüdüni gudawarügüti, ábame hadügüni échuni lun libihini ferudun luagu figóu le ladügübei lau laguurun hilaali. Wéyume ligía ábayame lederegeruni lídiburi lun Wabureme, <verse eid="NUM 6:11" /><verse number="12" style="v" sid="NUM 6:12" />ábayame lagumeserun ábanya iseri lidaani lederegeragun lungua lun Wabureme. Mabahüdǘnbei le furumiñeti dan, ladüga lawiyedun ídiburi le buga lederegerubei furumiñe. Gasu giñe lanügün aban liraüraü mudún le ábanti irumu lau lun Wabureme keisi adagaragüdüni luagu duru.<verse eid="NUM 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 6:13" />—Danme lagumuchun lidaani lederegeragun lungua, ábame lidin tubenarin kianpu lánina óundaruni <verse eid="NUM 6:13" /><verse number="14" style="v" sid="NUM 6:14" />adagaragüda aban liraüraü mudún le ábanti irumu lau le úati mégeiti luagu lun Wabureme keisi adagaragüdüni gudawarügüti, aban mudún würi to ábanti irumu tau, to úati, mégeiti tuagu keisi adagaragüdüni luagu figóu, luma aban mudún wügüri le úati mégeiti luagu keisi adagaragüdüni lánina arandaruni. <verse eid="NUM 6:14" /><verse number="15" style="v" sid="NUM 6:15" />Gasu giñe ladagaragüdün aban liraüraü faniñe tau fein to tautu fulúaru to buídutimaboun, furidasi to maganatu lébini to añoundawagutu lau garaba; úara luma burí idewesei le fulúaruauti tuma diwéin. <verse eid="NUM 6:15" /><verse number="16" style="v" sid="NUM 6:16" />Ábame ladügüni fádiri adagaragüdüni luagu figóu luma adagaragüdüni gudawarügüti ligibugiñe Wabureme, <verse eid="NUM 6:16" /><verse number="17" style="v" sid="NUM 6:17" />dagagüda mudún wügüri keisi adagaragüdüni lánina arandaruni, úara luma faniñe fein maganatu lébini, adügaleime idewesei fulúaruauti tuma diwéin. <verse eid="NUM 6:17" /><verse number="18" style="v" sid="NUM 6:18" />Ábame lélechuni wügüri le adügübalin füramasei lábulugu tubenari kianpu lánina óundaruni, ábame lanügüni ídiburi le buga lederegerubei lun Wabureme, ábame lachagaruni lidoun watu gemeti le lábugiñebei adagaragüdüni le lánina arandaruni. <verse eid="NUM 6:18" /><verse number="19" style="v" sid="NUM 6:19" />Lanügeime fádiri lanagan mudún héfeeli, aban fein to maganatu lébini lídangiñe faniñe tuma aban furidasi maganatu lébini, ábame líchuguni sun le lúhaburugun wügüri ligía, lárigiñe lásaruni lídiburi. <verse eid="NUM 6:19" /><verse number="20" style="v" sid="NUM 6:20" />Ábameti ladügüni fádiri igaburi le lánina arufudúni ligibugiñe Wabureme. Laniguagu animaalu le aubei ladügǘwa arufudúni luma liyada le ichugúbei keisi ídemuei lun Wabureme, sagüráuti ani areidúati lun fádiri. Lárigiñeme sun le, gayaraahalime latun wügüri ligía diwéin.<verse eid="NUM 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 6:21" />—Ligía lúrudubei lun le adügüti füramasei lun lederegeragun lungua lun Wabureme lun leseriwiduba lan lun, anihán burí giñe idewesei le lunbei ladagaragüdüni lun, bóugudin luéi furumiñeguarügü amu katei le gayaraati líchuguni. Gasu lagunfulirun lau le füramase lubéi keisi labürüdǘniwa lidan burí kesi le.<verse eid="NUM 6:21" /></para>
  <para style="s1">Habinihan fádirigu</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 6:22" />Aba ladimurehan Wabureme lun Moisesi, lariñaga lun:<verse eid="NUM 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 6:23" />—Ariñagabá lun Aarón luma houn lirahüñü lun danme lan habiniruniña Ísüraelina, lun ítara lan hadügüni:<verse eid="NUM 6:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="NUM 6:24" />«Binilabu Wabureme, góunigi lábume;<verse eid="NUM 6:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="NUM 6:25" />gundaalá Wabureme bau, arufudaléime lareini bun;<verse eid="NUM 6:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="NUM 6:26" />hínsiñehabula Wabureme bun, ru ligíame darangilaü bun».<verse eid="NUM 6:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="NUM 6:27" />—Ítara luba híriduni niri hawagu Ísüraelina, ábame nabiniruniña.<verse eid="NUM 6:27" /></para>
  <chapter eid="NUM 6" />
  <chapter number="7" style="c" sid="NUM 7" />
  <para style="s1">Idewesei lun tederegerún sanduariu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 7:1" />Weyu le lagumuchunbei ladügünu Moisesi sanduariu, aba lederegerunu lau garaba úara luma sun ílagu le ayusurúbei tidan luma le ayusurúbei luagu latarü. <verse eid="NUM 7:1" /><verse number="2" style="v" sid="NUM 7:2" />Lárigiñe aba houdin hábutigu türibu, hama ha ídehabaña lidan habahüdün gürigia. <verse eid="NUM 7:2" /><verse number="3" style="v" sid="NUM 7:3" />Aba híchugun keisi idewesei lun Wabureme sisi kareta daruguatu hama duusu bulu bágasu, aban kareta hawagu kada bián ábutigu luma aban bágasu luagu kada aban. Aba híchuguni sun katei le tigibugiñe sanduariu.<verse eid="NUM 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 7:4" />Ábati lariñagun Wabureme lun Moisesi:<verse eid="NUM 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 7:5" />—Resibibóun kareta hama bulu bágasu hámagiñe, bíchigañame houn Lewitagu lun hayusuruniña lidan wadagimanu le tánina kianpu lánina óundaruni, según wadagimanu le lunbei ladügüni kada aban.<verse eid="NUM 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 7:6" />Aba leresibirunu Moisesi kareta hama bágasu, aba lafanreinhaniña hadan Lewitagu. <verse eid="NUM 7:6" /><verse number="7" style="v" sid="NUM 7:7" />Ruti bián kareta hama gádürü bágasu houn ladügawagun Gerüsón, ha hemegeirubaña lun hawadigimari. <verse eid="NUM 7:7" /><verse number="8" style="v" sid="NUM 7:8" />Houn ladügawagun Merarí, ruti gádürü kareta hama widü bágasu lun hadügüni hawadigimari lábugiñe laríaahan Itamárü le liráü fádiri Aarón. <verse eid="NUM 7:8" /><verse number="9" style="v" sid="NUM 7:9" />Ánheinti houn ladügawagun Keatü, michugúntu kareta ni bágasu, lugundun sun katei sagüráuti le lunbei hanügüni gasu hégewaguba lan hanügei.<verse eid="NUM 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 7:10" />Dan le lederegerúnbei latarü aba hanügüni hábutigu türibu hadewese, aba híchuguni ligibugiñe latarü. <verse eid="NUM 7:10" /><verse number="11" style="v" sid="NUM 7:11" />Ábati ladimurehan Wabureme lun Moisesi, lariñaga lun:</para>
  <para style="p" vid="NUM 7:11">—Ámuba hábuti türibu anügei lidewese sagü weyu lun lederegerun latarü.<verse eid="NUM 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 7:12" />Furumiñeti weyu aba lanügüni Naasón le liráü Aminadábü lidewese, lídangiñe lani Hudá türibu. <verse eid="NUM 7:12" /><verse number="13" style="v" sid="NUM 7:13" />Aban boulu lautu pülata lideweseboun, milu-gádürü-san-darandi güramu tihürü, luma aban óunwenbu kopu lauti pülata sedü-san-ǘrüwa-wein-diisi güramu lihürü según tubalansun sanduariu, biángubei buin tau fulúaru to buídutimaboun añoundawagutu lau garaba keisi idewesei fulúaruauti; <verse eid="NUM 7:13" /><verse number="14" style="v" sid="NUM 7:14" />luma aban guliyeru golu le hǘrüti san-diisi güramu buin lau kupali; <verse eid="NUM 7:14" /><verse number="15" style="v" sid="NUM 7:15" />aban bágasu ñǘraügili, aban mudún wéiriyaali lúmaya aban le ábanti irumu lau lun ladagaragüdüni keisi adagaragüdüni gudawarügüti, <verse eid="NUM 7:15" /><verse number="16" style="v" sid="NUM 7:16" />aban liraüraü gábara lun adagaragüdüni luagu figóu, <verse eid="NUM 7:16" /><verse number="17" style="v" sid="NUM 7:17" />bián bágasu wügüriña, seingü mudún wéinamuhaña, seingü harahüñü gábara hama seingü harahüñü mudún ha ábanti irumu hau lun adagaragüdüni lánina arandaruni. Ligía lidewesebei Naasón le liráü Aminadábü.<verse eid="NUM 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 7:18" />Libiaman weyu aba lanügüni Natanaéli le liráü Suarü lidewese, le hábuti lani Isakárü türibu, <verse eid="NUM 7:18" /><verse number="19-23" style="v" sid="NUM 7:19-23" />ani idewesei le líchugubei libeméme le híchugubei ha lubaabaña.<verse eid="NUM 7:19-23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 7:24" />Lǘrüwan weyu aba lanügüni Eliabü le liráü Elón, le hábuti lani Sabulón türibu. <verse eid="NUM 7:24" /><verse number="25-29" style="v" sid="NUM 7:25-29" />Ani idewesei le líchugubei libeméme le híchugubei ha lubaabaña.<verse eid="NUM 7:25-29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 7:30" />Ligadürün weyu aba líchuguni Elisúru le liráü Sedeuru le hábuti lani Rubén türibu lidewese, <verse eid="NUM 7:30" /><verse number="31-35" style="v" sid="NUM 7:31-35" />lememe giñe híchugubei ha lubaragiñebaña, ligía giñe líchugubei.<verse eid="NUM 7:31-35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 7:36" />Liseingün weyu aba líchuguni Selumiéli le liráü Surisadái, le hábuti lani Simeón türibu lidewese, <verse eid="NUM 7:36" /><verse number="37-41" style="v" sid="NUM 7:37-41" />ani lememe giñe híchugubei ha lubaragiñebaña, ligía giñe líchugubei.<verse eid="NUM 7:37-41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 7:42" />Lisisin weyu aba líchuguni Eliasáfü le liráü Reueli le hábuti lani Gadü türibu lidewese, <verse eid="NUM 7:42" /><verse number="43-47" style="v" sid="NUM 7:43-47" />ani idewesei le líchugubei libeméme le híchugubei ha lubaabaña.<verse eid="NUM 7:43-47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 7:48" />Lisedün weyu aba líchuguni Elisamá le liráü Amiudu, le hábuti lani Éfürain türibu lidewese, <verse eid="NUM 7:48" /><verse number="49-53" style="v" sid="NUM 7:49-53" />ani idewesei le líchugubei libeméme le híchugubei ha lubaabaña.<verse eid="NUM 7:49-53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="NUM 7:54" />Liwidün weyu aba líchuguni Gamalieli le liráü Pedasúru, le hábuti lani Manasési türibu lidewese, <verse eid="NUM 7:54" /><verse number="55-59" style="v" sid="NUM 7:55-59" />ani idewesei le líchugubei libeméme le híchugubei ha lubaabaña.<verse eid="NUM 7:55-59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="NUM 7:60" />Linefun weyu aba líchuguni Abidán le liráü Gidoní, le hábuti lani Benhamín türibu lidewese, <verse eid="NUM 7:60" /><verse number="61-65" style="v" sid="NUM 7:61-65" />ani idewesei le líchugubei libeméme le híchugubei ha lubaabaña.<verse eid="NUM 7:61-65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="NUM 7:66" />Lidiisin weyu aba líchuguni Aieserü le liráü Amisadái, le hábuti lani Dan türibu, lidewese, <verse eid="NUM 7:66" /><verse number="67-71" style="v" sid="NUM 7:67-71" />ani idewesei le líchugubei libeméme le híchugubei ha lubaabaña.<verse eid="NUM 7:67-71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="NUM 7:72" />Liunsun weyu aba líchuguni Pagieli le liráü Okürán, le hábuti lani Aserü türibu lidewese, <verse eid="NUM 7:72" /><verse number="73-77" style="v" sid="NUM 7:73-77" />ani idewesei le líchugubei libeméme le híchugubei ha lubaabaña.<verse eid="NUM 7:73-77" /></para>
  <para style="p">
    <verse number="78" style="v" sid="NUM 7:78" />Liduusun weyu aba líchuguni Airá le liráü Enán, le hábuti lani Nefütalí türibu lidewese, <verse eid="NUM 7:78" /><verse number="79-83" style="v" sid="NUM 7:79-83" />ani idewesei le líchugubei libeméme le híchugubei ha lubaabaña.<verse eid="NUM 7:79-83" /></para>
  <para style="p">
    <verse number="84" style="v" sid="NUM 7:84" />Ítara liña lubeiti lídanbei le lederegerúnwabei latarü lun Wabureme, rútiña hábutigu lani Ísüraeli türibu duusu boulu to lautu pülata, duusu kopu wéinamuti le lauti pülata luma duusu guliyeru wéinamuti le lauti golu. <verse eid="NUM 7:84" /><verse number="85" style="v" sid="NUM 7:85" />Milu-gádürü-san-darandi güramu tihürü kada boulu to lautu pülata, sedü-san-ǘrüwa-wein-diisi güramu kada kopu. Wein-sisi-milu-gádürü-san güramu lihürü pülata le tubuñe sun boulu luma sun kopu ligía, según habalansun tábutigu sanduariu. <verse eid="NUM 7:85" /><verse number="86" style="v" sid="NUM 7:86" />Ñeinñein giñe duusu guliyeru wéinamuti lauti golu buin lau kupali, san-diisi güramu lihürü kada aban. Según habalansun tábutigu sanduariu. Milu-ǘrüwa-san-wein güramu lihürü golu le lubuñena sun guliyeru.<verse eid="NUM 7:86" /></para>
  <para style="p">
    <verse number="87" style="v" sid="NUM 7:87" />Hadan sun animaalugu ha ichugúbaña lun adagaragüdüni gudawarügüti dúusuñanu bágasu ñǘbürigiña ha wügüriña, duusu mudún wéinamuhaña, duusu harahüñü mudún ha ábanti irumu hau lau hadewese fulúaruauti hama duusu gábara lun adagaragüdüni luagu figóu. <verse eid="NUM 7:87" /><verse number="88" style="v" sid="NUM 7:88" />Hadan sun animaalugu ha ichugúbaña lun adagaragüdüni le lánina arandaruni, wein-gádürü bágasu ñǘbürigiña ha wügüriña, ǘrüwa-wein gábara ñǘbürigiña, ǘrüwa-wein mudún wéinamuhaña hama ǘrüwa-wein mudún ha ábanti irumu hau. Hagía sun animaalugu ha ideweseibaña dan le lanuadirún latarü lárigiñe lederegerúniwa lun Wabureme.<verse eid="NUM 7:88" /></para>
  <para style="p">
    <verse number="89" style="v" sid="NUM 7:89" />Dan lebelurunbei Moisesi tidoun kianpu lánina óundaruni lun ladimurehan luma Wabureme, aba laganbun ladimurehan Wabureme lun tigibuagugiñe tidáü lubagüsina daradu habadinaguagiñe bián kátaña garünatiña.<verse eid="NUM 7:89" /></para>
  <chapter eid="NUM 7" />
  <chapter number="8" style="c" sid="NUM 8" />
  <para style="s1">Arufudahani burí lun lebedúniwa lanpu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 8:1" />Aba líchuguni Wabureme uganu le lun Moisesi lun lariñaguni lun Aarón:<verse eid="NUM 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 8:2" />—Danme besetiruni lanpu, adügabá lun larugoungadágüdün ligibugiñoun lebu sanudelu.<verse eid="NUM 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 8:3" />Gúnfuli lumuti Aarón le lariñagubei Wabureme lun Moisesi lun lariñaguni lun, aba lesetiruni lanpu lun ligibugiñounba lan lebu sanudelu lidin larugounga. <verse eid="NUM 8:3" /><verse number="4" style="v" sid="NUM 8:4" />Lebu sanudelu ligía, lauti golu, lau marüdiyu ladügǘwa lúmagiñe lugudina darí lumoun lígirugu. Ítara liña ladügüni Moisesi lebu sanudelu ligía kei le larufudubei Wabureme lun.<verse eid="NUM 8:4" /></para>
  <para style="s1">Hederegerúniwa Lewitagu</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 8:5" />Aba lariñagun Wabureme lun Moisesi:<verse eid="NUM 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 8:6" />—Díreibaña Lewitagu hádangiñe híbiri Ísüraelina, ábame barumadagüdüniña. <verse eid="NUM 8:6" /><verse number="7" style="v" sid="NUM 8:7" />Anihánba échuni le lánina arumaduni: Ábame babahichaguniña lau duna le lánina arumaduni, lárigiñe ábame hásaraguni sun hágubu, chibá hamounme hadaüragun; ítara luba harumadun. <verse eid="NUM 8:7" /><verse number="8" style="v" sid="NUM 8:8" />Lárigiñe ábame hanügün aban bágasu wügüri le ñǘraügili tuma murusun tídangiñe tubuidun-agei fulúaru to añoundawagutu lau garaba, lun hadügüni idewesei fulúaruauti le yuubei lun hadügüni, lúmaya ábanya bágasu wügüri le ñǘraügili lun adagaragüdüni luagu figóu. <verse eid="NUM 8:8" /><verse number="9" style="v" sid="NUM 8:9" />Bayarafadagüdañame Lewitagu turugabun kianpu lánina óundaruni, óundaragua hagíame sun Ísüraelina. <verse eid="NUM 8:9" /><verse number="10" style="v" sid="NUM 8:10" />Lárigiñe ábame badügün lun hayabin Lewitagu nigibugiñoun, ábame íchaaheina hamani Ísüraelina háhabu hábulugu Lewitagu. <verse eid="NUM 8:10" /><verse number="11" style="v" sid="NUM 8:11" />Ladügübei Aarón échuni le lánina harufudagun Lewitagu houngua luéigiñe hóubadina Ísüraelina, ítara luba herederun Lewitagu deregewañu lun heseriwidun nun. <verse eid="NUM 8:11" /><verse number="12" style="v" sid="NUM 8:12" />Lárigiñe ábame híchuguni Lewitagu háhabu hábulugu bágasu wügüriña ha ñǘbürigiña, ábame hadagaragüdün aban keisi adagaragüdüni luagu figóu, le aban keisi adagaragüdüni gudawarügüti lun harumadun Lewitagu. <verse eid="NUM 8:12" /><verse number="13" style="v" sid="NUM 8:13" />Lárigiñe ábame bíchuguniña ligibugiñe Aarón hama lirahüñü, ábame badügüni échuni le lánina arufudúni lun bíchuguniña lun heseriwidun nun; <verse eid="NUM 8:13" /><verse number="14" style="v" sid="NUM 8:14" />ítara luba bafanreinruniña Lewitagu hádangiñe ha híbiri Ísüraelina lun nánibaña lan. <verse eid="NUM 8:14" /><verse number="15" style="v" sid="NUM 8:15" />Lárigiñe ábame houdin eseriwida tidan kianpu lánina óundaruni. Gasu barumadagüdüniña, ábame barufuduniña keisi aban idewesei le lúnrügüti Wabureme, <verse eid="NUM 8:15" /><verse number="16" style="v" sid="NUM 8:16" />lugundun hádangiñe sun Ísüraelina yúutiña Lewitagu nun. Aba nánharun houn heweñegua hágiramagu Ísüraelina, <verse eid="NUM 8:16" /><verse number="17" style="v" sid="NUM 8:17" />lugundun yúutiña sun hágiramagu Ísüraelina nun, kéisigubeirügü furumiñetiña harahüñü habiñanigu. Dan le náfaragunbaliña sun hágiramagu Ehiptuna, ígira numutiña hágiramagu Ísüraelina nubarua lun nánime. <verse eid="NUM 8:17" /><verse number="18" style="v" sid="NUM 8:18" />Gama lumoun aba nánharun houn Lewitagu heweñegua. <verse eid="NUM 8:18" /><verse number="19" style="v" sid="NUM 8:19" />Anúadira numutiña Lewitagu haganaguagiñe Ísüraelina, aba nederegeruniña lun Aarón luma houn lirahüñü, lun heseriwidun tidan kianpu lánina óundaruni lau hiri sun Ísüraelina lun hibihini ferudun lúmagiñe Wabureme luagu hafigoun Ísüraelina. Ítara luba mayarafadun hamá Ísüraelina tun sanduariu lun másügürün lan ni kata wuribati houn.<verse eid="NUM 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 8:20" />Gúnfuli lumuti Moisesi, Aarón hama sun lílana fulasu le lariñagubei Wabureme lun Moisesi habügürü Lewitagu. <verse eid="NUM 8:20" /><verse number="21" style="v" sid="NUM 8:21" />Aba harumadun Lewitagu chibá hamóun hadaüragun, aba larufuduni Aarón keisi idewesei le anuadahóuarügüti lun Wabureme, aba ladügüni échuni le lánina arumaduni hawagu. <verse eid="NUM 8:21" /><verse number="22" style="v" sid="NUM 8:22" />Lárigiñe sun katei le, aba houdin Lewitagu adügei hawadigimari tidan kianpu lánina óundaruni, lábugiñe laríaahan Aarón hama lirahüñü. Ítara kei lariñaguni Wabureme lun Moisesi, ítara liña ladügün hau Lewitagu.<verse eid="NUM 8:22" /></para>
  <para style="s1">Lidaani heseriwidun Lewitagu</para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 8:23" />Aba líchuguni Wabureme uganu le lun Moisesi lun lariñaguni houn Lewitagu:<verse eid="NUM 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 8:24" />—Lunti hagumeserun Lewitagu eseriwida tidan kianpu lánina óundaruni lídanme hagunfulirun wein-seingü irumu, <verse eid="NUM 8:24" /><verse number="25" style="v" sid="NUM 8:25" />lásurame heseriwidun lidan hagunfulirun dimí-san irumu. <verse eid="NUM 8:25" /><verse number="26" style="v" sid="NUM 8:26" />Lárigiñe dimí-san irumu ligía, gayaraabei híderaguniña hupanaagu lidan hafisiute tidan kianpu lánina óundaruni, gama lumoun mama lun heseriwidun kei bugaha hadügüni lubaramegiua. Ítara luba baranseruni heseriwidun Lewitagu.<verse eid="NUM 8:26" /></para>
  <chapter eid="NUM 8" />
  <chapter number="9" style="c" sid="NUM 9" />
  <para style="s1">Lefeduhóun Luéyuri Esefuruni</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 9:1" />Aban irumu lárigiñe háfuridun Ísüraelina Ehiptugiñe, lidan furumiñeti lihatiri irumu, aba ladimurehan Wabureme lun Moisesi lidan fulasu mageirawati Sinaí, lariñaga lun:<verse eid="NUM 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 9:2" />—Lunti hefeduhani Ísüraelina Luéyuri Esefuruni lidan dan le arufudúbei, <verse eid="NUM 9:2" /><verse number="3" style="v" sid="NUM 9:3" />weyu katorusu rábounweyu lidan hati ligía, adügeina hameime sun katei le narufudahabei houn ida luba lan hefeduhani Luéyuri Esefuruni.<verse eid="NUM 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 9:4" />Ábati lariñagun Moisesi houn Ísüraelina lun hefeduhani Luéyuri Esefuruni, <verse eid="NUM 9:4" /><verse number="5" style="v" sid="NUM 9:5" />aba hadügüni ítara weyu katorusu rábounweyu lidan hati ligía, lidan fulasu mageirawati Sinaí, adügeina haméi sun katei ítara kei lariñaguni Wabureme lun Moisesi.<verse eid="NUM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 9:6" />Gama lumoun ñéinñanu fiu wügüriña wíyeeña lárigi haguurun hilaali, ligía lébubei lásiñarun hefeduhani Luéyuri Esefuruni weyu ligía. Aba houdin wügüriña hagía lumoun Moisesi luma Aarón weyuméme ligía, <verse eid="NUM 9:6" /><verse number="7" style="v" sid="NUM 9:7" />hariñaga lun Moisesi:</para>
  <para style="p" vid="NUM 9:7">—Guruhadiwa aban hilaali, wíyeñadiwa. Mígirunbadiwa lubeiti lun wíchuguni idewesei lun Wabureme lidan dan le lunbei lichugún úara hama híbiri Ísüraelina.<verse eid="NUM 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 9:8" />Lariñaga Moisesi houn:</para>
  <para style="p" vid="NUM 9:8">—Aguraba humá kaba lan lariñaga Wabureme nun hibügürü.<verse eid="NUM 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 9:9" />Aba líchuguni Wabureme uganu le lun Moisesi lun lariñaguni houn Ísüraelina:<verse eid="NUM 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 9:10" />—Sun huguya hau sun hadügawagun, lunti hefeduhani Luéyuri Esefuruni lun nuéirigun. Ha wíyebaña ladüga haguurun hilaali, ha dísebaña, ha lídanbaña wéiyaasu, <verse eid="NUM 9:10" /><verse number="11" style="v" sid="NUM 9:11" />hefeduhabei weyu katorusu rábounweyu lidan libiaman hati. Lunti héigini mudún ñǘraügili lau híduru gífiti tuma fein maganatu lébini, <verse eid="NUM 9:11" /><verse number="12" style="v" sid="NUM 9:12" />mígirunga lídangiñe luba le aban weyu, máhalachun hagíame ni aban abun luagu. Efeduha huméi Luéyuri Esefuruni afalareinei sun arufudahani le níchugubei hun ida lubá lan hadügüni. <verse eid="NUM 9:12" /><verse number="13" style="v" sid="NUM 9:13" />Gama lumoun le mefeduhan lumuti Luéyuri Esefuruni lau sun harumañu lan, ani mama lídanñein wéiyaasu, lagidarúba hádangiñe gürigia. Ladüga michuláni idewesei lun Wabureme lidan lidaani, leresibirubei abeichúni luagu lifigoun.<verse eid="NUM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 9:14" />—Terencha ha aganóubaña haganagua gasu hefeduhani Luéyuri Esefuruni luagu nuéirigun úaragua luma arufudahani le ru naalibei. Ligiamémeba lúrudu houn terencha kei houn lílana fulasu.<verse eid="NUM 9:14" /></para>
  <para style="s1">Dúeri tigibuagu lúbaana daradu</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 9:15" />Weyu le tararamunbei sanduariu, tomeme lúbaana daradu, aba ladouragun dúeri tau. Lúmagiñeha rábounweyu ábaha lasaliragun aban katei kamá watu gemeti tigibuagugiñe le adurarubei darí lumoun larugadun. <verse eid="NUM 9:15" /><verse number="16" style="v" sid="NUM 9:16" />Ítara liña meha lasuseredun súnwandan: Wéyuagu aba ladouragun aban dúeri tau sanduariu, gúñounha aba larihín aban katei kamá watu gemeti. <verse eid="NUM 9:16" /><verse number="17" style="v" sid="NUM 9:17" />Danha le liñuragun dúeri ligía tigibuagugiñe kianpu, ábaha hagumeserun Ísüraelina awansera, létiha ñein lumuti lararamagua dúeri ligía, ñein hararamagua. <verse eid="NUM 9:17" /><verse number="18" style="v" sid="NUM 9:18" />Lídanha líchugun Wabureme lúrudu houn Ísüraelina lun hawanserun, ábaha hawanserun o lun hararamagun, ábaha hararamagun, ábatiha herederun ñein sun dan le lerederun dúeri tóugiñe sanduariu. <verse eid="NUM 9:18" /><verse number="19" style="v" sid="NUM 9:19" />Ánheinha eredera dúeri tóugiñe sanduariu lüti dan, ábaha hararamuni Ísüraelina héibugun lun hetenirun lun heseriwidun lun Wabureme. <verse eid="NUM 9:19" /><verse number="20" style="v" sid="NUM 9:20" />Ánheinha eredera dúeri tóugiñe sanduariu luágurügü fiu weyu, lariñagunha Wabureme houn lun hawanserun, hawanserun, lariñagun houn lun hararamagun, hararamagun. <verse eid="NUM 9:20" /><verse number="21" style="v" sid="NUM 9:21" />Aniheinha dan árieburügüñein leredera dúeri, larugan binaafin aba liñuragun lungua; ábatiha hagumeserun éibuga. Wéyuagu kéigubeirügü áriebu, sagü liñuragun dúeri lungua, hagumeserun éibuga. <verse eid="NUM 9:21" /><verse number="22" style="v" sid="NUM 9:22" />Ánheinha erederagua dúeri bián weyu, o aban hati o aban irumu tóugiñe sanduariu, ábaha hararamagun Ísüraelina, masigihaña habaruaguóun. Gama lumoun keiha liñuragun dúeri lungua ítara hasigiruni haweiyasun. <verse eid="NUM 9:22" /><verse number="23" style="v" sid="NUM 9:23" />Lídanha lagumadiruniña Wabureme lun hemeraagun, hemeraagun, lidan lagumadiruniña lun héibugun, héibugun. Añahalu eseriwidei Wabureme, ítara kei lariñaguni Moisesi ida luba lan hadügüni.<verse eid="NUM 9:23" /></para>
  <chapter eid="NUM 9" />
  <chapter number="10" style="c" sid="NUM 10" />
  <para style="s1">Fidu burí to lautu pülata</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 10:1" />Aba lariñagun Bungiu lun Moisesi:<verse eid="NUM 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 10:2" />—Adügabá bián fidu lautu pülata, nadagimeinwatu lau marüdiyu lun teseriwidun bun lun bagúarun houn gürigia lun hóundaragun, luma lun bíchuguni seini lánina awanseruni. <verse eid="NUM 10:2" /><verse number="3" style="v" sid="NUM 10:3" />Danme tinwinrún biángubei fidu, ábame hóundaragun gürigia bigibugiñe tubenari kianpu lánina óundaruni. <verse eid="NUM 10:3" /><verse number="4" style="v" sid="NUM 10:4" />Danme tinwinrún ábanrügü, hábutirügübaña türibu ha wéirigubaña óundaragua. <verse eid="NUM 10:4" /><verse number="5" style="v" sid="NUM 10:5" />Danme lúaradun tínwinrun fidu luma agúarahani héreti, ábame hagumeserun ha luéigiñebaña oubaü le ñéingiñe lubéi laboucha weyu awansera, <verse eid="NUM 10:5" /><verse number="6" style="v" sid="NUM 10:6" />danme labiamadun tínwinrun ábame hagumeserun ha luéigiñebaña suru awansera. Tinwinrúniwa fidu le úarati luma agúarahani héreti ligíaba liseinin amufuruni. <verse eid="NUM 10:6" /><verse number="7" style="v" sid="NUM 10:7" />Tinwinrún fidu lábuguarügü ligíaba seini lun hóundaragun gürigia. <verse eid="NUM 10:7" /><verse number="8" style="v" sid="NUM 10:8" />Fádirigu, ha ladügawagun Aarón, hagíaba íñaaha fidu. Ábanbei lúrudu le lunti súnwandan le hun.<verse eid="NUM 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 10:9" />—Danme lábürühan ágani huagun humúanrugu, ani lunti háfuridun ageindagua, hínwinrounme biángubei fidu ábame hagúaragun here. Ítara luba naritagun huagun au le Aburemei le Hubungiute, ábame nesefurunün hawéi háganiñu. <verse eid="NUM 10:9" /><verse number="10" style="v" sid="NUM 10:10" />Win humóun giñe fidu lidan burí weyu lánina ugundani, lidan burí luéyuri fedu o iseri hati, danme híchugun adagaragüdüni gudawarügüti luma adagaragüdüni lánina arandaruni. Ítara luba naritagun huagun. Au Aburemeibei le Hubungiute.<verse eid="NUM 10:10" /></para>
  <para style="ms">II. Darandi-widü irumu éibuguni luma lerederúniwa lidan fulasu mageirawati le gíribei Kadesi</para>
  <para style="mr">(<ref loc="NUM 10:11-21:35">10.11—21.35</ref>)</para>
  <para style="s1">Háfuridun Ísüraelina Sinaígiñe</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 10:11" />Lidan libiaman irumu lúmagiñe háfuridun Ísüraelina Ehiptugiñe, weyu wein lidan libiaman hati, aba liñuragun dúeri lungua tigibuagugiñe sanduariu to lánina daradu, <verse eid="NUM 10:11" /><verse number="12" style="v" sid="NUM 10:12" />aba hagumeserun Ísüraelina éibuga, háfurida lídangiñe fulasu mageirawati Sinaí. Aba lararamagun dúeri lidan fulasu mageirawati Parán. <verse eid="NUM 10:12" /><verse number="13" style="v" sid="NUM 10:13" />Ítara kei lariñagagüdüni Wabureme lun Moisesi, <verse eid="NUM 10:13" /><verse number="14" style="v" sid="NUM 10:14" />lisudaranigu Hudá lídanbei furumiñeti ubaraü lábugiñe lufanidiran Hudá, Naasón le liráü Aminadábü ligía hábutibei. <verse eid="NUM 10:14" /><verse number="15" style="v" sid="NUM 10:15" />Natanaéli le liráü Suarü habá habaabei lisudaranigu lani Isakárü türibu. <verse eid="NUM 10:15" /><verse number="16" style="v" sid="NUM 10:16" />Eliabü le liráü Elón habá habaabei lisudaranigu lani Sabulón türibu. <verse eid="NUM 10:16" /><verse number="17" style="v" sid="NUM 10:17" />Ábati haragachagunu sanduariu, aba hagumeserun ladügawagun Gerüsón luma Merarí ha anaahabarun sanduariu awansera.<verse eid="NUM 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 10:18" />Lárigiñe aba hawanserun súdaragu ha lábugiñe lufanidiran Rubén, Elisúru le liráü Sedeuru hábutibei. <verse eid="NUM 10:18" /><verse number="19" style="v" sid="NUM 10:19" />Selumiéli le liráü Surisadái ligía habá habaabei lisudaranigu lani Simeón türibu. <verse eid="NUM 10:19" /><verse number="20" style="v" sid="NUM 10:20" />Eliasáfü le liráü Reueli habá habaabei lisudaranigu lani Gadü türibu. <verse eid="NUM 10:20" /><verse number="21" style="v" sid="NUM 10:21" />Lárigiñe aba hawanserun ladügawagun Keatü, ha anügübalin ílagu le sagüráubei. Danha le hachülürün, láramaaruha sanduariu.<verse eid="NUM 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 10:22" />Lárigiñe hasigira súdara ha awanserubaña lábugiñe lufanidiran Éfürain, Elisamá le liráü Amiudu hábutibei. <verse eid="NUM 10:22" /><verse number="23" style="v" sid="NUM 10:23" />Gamalieli le liráü Pedasúru habá habaabei lisudaranigu lani Manasési türibu. <verse eid="NUM 10:23" /><verse number="24" style="v" sid="NUM 10:24" />Abidán le liráü Gidoní habá habaabei lisudaranigu lani Benhamín türibu.<verse eid="NUM 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 10:25" />Agumuhóuni, hárigi hárigi súdaragu houdin ha awanserubaña lábugiñe lufanidiran Dan, Aieserü le liráü Amisadái hábutibei. <verse eid="NUM 10:25" /><verse number="26" style="v" sid="NUM 10:26" />Pagieli le liráü Okürán, ligía habá habaabei lisudaranigu lani Aserü türibu. <verse eid="NUM 10:26" /><verse number="27" style="v" sid="NUM 10:27" />Airá le liráü Enán, ligía habá habaabei lisudaranigu lani Nefütalí türibu.<verse eid="NUM 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 10:28" />Ítara liña ligaburi hawanserun Ísüraelina lidan hadiñurun lídangiñe aban fulasu lidoun aban.<verse eid="NUM 10:28" /></para>
  <para style="s1">Lagunbirahani Moisesi libamu lun hapanaame</para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 10:29" />Luagu aban weyu aba lariñagun Moisesi lun libamu le Obabü le liráü Reueli le Madianna:</para>
  <para style="p" vid="NUM 10:29">—Wagía wéibuga lidoun ageiraü le füramase lubéi Wabureme luagu líchugubei lan woun. Keimoun wama, wóuserubadibu buidu, lugundun füramasehali Wabureme lóuseruni Ísüraeli lau areini.<verse eid="NUM 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 10:30" />Lariñaga Obabü:</para>
  <para style="p" vid="NUM 10:30">—Uá, himei numuti nagiribudun nageiroun, le ñein habéi niduheñu.<verse eid="NUM 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 10:31" />—Mídinba —ligíaya Moisesi lun—. Subuditi fulasu burí le ñein lubéi gayara lan lemeraawagun lidan fulasu mageirawati bun buidu buidu, gayaraabei beseriwidun woun lun badundehaniwa. <verse eid="NUM 10:31" /><verse number="32" style="v" sid="NUM 10:32" />Ánhabu ñüdün wama, wafanreinhabei sun buiti le líchugun Wabureme woun buma.<verse eid="NUM 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 10:33" />Ítara liñati, aba houdin luéigiñe luwübüri Wabureme, aba héibugun luagu ǘrüwa weyu. Habá habaañoun lubagüsina lidaradun Wabureme áluaheina aban fulasu lun hemeraagun. <verse eid="NUM 10:33" /><verse number="34" style="v" sid="NUM 10:34" />Wéyuaguha, ítara kei hagumeserun awansera aban giñeha lamufurun dúeri le lani Wabureme hóugiñe. <verse eid="NUM 10:34" /><verse number="35" style="v" sid="NUM 10:35" />Dántiha le hagumeserun awansera tabu bágüsi, ábaha lariñagun Moisesi:</para>
  <para style="b" vid="NUM 10:35" />
  <para style="q" vid="NUM 10:35">«Saraba, Wabureme!</para>
  <para style="q" vid="NUM 10:35">Waraügua hamá báganiñu!</para>
  <para style="q" vid="NUM 10:35">Lun lidan lanme harihinibu ha iyereehabúbaña bun lun héibaagun!»<verse eid="NUM 10:35" /></para>
  <para style="b" />
  <para style="p">
    <verse number="36" style="v" sid="NUM 10:36" />Gama lumoun danha le tararamagun bágüsi, ábaha lariñagun Moisesi:</para>
  <para style="b" vid="NUM 10:36" />
  <para style="q" vid="NUM 10:36">«Giribubá guentó, Wabureme,</para>
  <para style="q" vid="NUM 10:36">houn lisudaranigu Ísüraeli</para>
  <para style="q" vid="NUM 10:36">ha gíbebaña darí lun siñá lan habahüdǘn!»<verse eid="NUM 10:36" /></para>
  <chapter eid="NUM 10" />
  <chapter number="11" style="c" sid="NUM 11" />
  <para style="s1">Füramase lan Wabureme úi houn Ísüraelina</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 11:1" />Luagu aban weyu aba hagumeserun Ísüraelina agülülüha luagu Wabureme luagu lénrengunga le gádanbaliña. Dan laganbunbaliña Wabureme, aba lagañidun saragu, aba lóunahan aban watu gemeti aba láguduni geyegua tau kianpu-agei. <verse eid="NUM 11:1" /><verse number="2" style="v" sid="NUM 11:2" />Aba hagúarahan gürigia amuriaha luma Moisesi lun líderaguniña, aba layumuragun Moisesi lun Wabureme hawagu. Ábati léñeguchun watu gemeti. <verse eid="NUM 11:2" /><verse number="3" style="v" sid="NUM 11:3" />Ligía Taberá lubéi buga líribei fulasu ligía, ladüga leheleledagun lara líleme Wabureme hawagun ñein.<verse eid="NUM 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 11:4" />Mígisihañati buga sun hawuyeri gürigia hadoun Ísüraelina, ani gürigia hagía, luágunrügüñein éigini haritagua. Ábati hafalaruniña Ísüraelina, aba hayahun ani ariñageina hagía:</para>
  <para style="p" vid="NUM 11:4">—Anihadügü hamuga úi lun weigin! <verse eid="NUM 11:4" /><verse number="5" style="v" sid="NUM 11:5" />Lanarime waritagun hawagun úduraü ha meha wéigibaña Ehiptu mafayeihanga wagía hawagu. Hóutiwa meha giñe melón ñein, pepinu, sebuya luma lai. <verse eid="NUM 11:5" /><verse number="6" style="v" sid="NUM 11:6" />Ánheinti guentó wóunweguña walama, ani marihintiwa amu katei tuéidigia maná.<verse eid="NUM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 11:7" />(Maná tugía ítara tiña meha kei lila bariñe; dumariyumati meha tarihíniwa, ítara kei tühü wewe, <verse eid="NUM 11:7" /><verse number="8" style="v" sid="NUM 11:8" />Lidan bóuchunu ítara liña tisemen kei durudia tautu fulúaru lau garaba. Ábaha háfuridun gürigia abudahoun, lárigiñe aba hamuligidunu lun hábougunu o hadügünu kei fein. <verse eid="NUM 11:8" /><verse number="9" style="v" sid="NUM 11:9" />Áriebuha, danha le lábürühan serenu tuagun kianpu-agei, aba giñeha tábürühan maná.)<verse eid="NUM 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 11:10" />Aba laganbuni Moisesi hayahuahan Ísüraelina hama haduheñu tubenari hakianpun. Ladüga wéirihali buga ligañi Wabureme hama. Ítara giñe Moisesi, magundanti giñe. <verse eid="NUM 11:10" /><verse number="11" style="v" sid="NUM 11:11" />Aba lariñagun lun Wabureme:</para>
  <para style="p" vid="NUM 11:11">—Ka san uagu bóuserana wuriba ítara, au le bubuein? Ka san wuribati nadügübei, bíchugunbalina lun náfaguniña gürigia ha? <verse eid="NUM 11:11" /><verse number="12" style="v" sid="NUM 11:12" />Au funagia háguchibei o háguchu lan bamuriahanbei numa lun nanügüniña narünarugu kei irahüñü guragiña darí lidoun fulasu le füramase bubéi houn hagüchagu? <verse eid="NUM 11:12" /><verse number="13" style="v" sid="NUM 11:13" />Halíagiñebagia nasagara úi lun néigagüdüniña sun gürigia ha? Ñǘbuintiña ayahuaheina ariñaga nun: “Ruba úi woun lun weigin”. <verse eid="NUM 11:13" /><verse number="14" style="v" sid="NUM 11:14" />Au nábugua, siñá nun hau gürigia ha, wéiriyati ihürü le nun. <verse eid="NUM 11:14" /><verse number="15" style="v" sid="NUM 11:15" />Anhein ítarameme luba lubéi bóuserunina, gidagubeibei nibagari, anhein inarüni lubéi luagu hínsiñe nan bun. Ítara luba madariragun nan nungua lidan saragu lénrengunga.<verse eid="NUM 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 11:16" />Gama lumoun aba lóunabuni Wabureme:</para>
  <para style="p" vid="NUM 11:16">—Óundaraba ǘrüwa-wein-diisi wéiyaaña mutu Ísüraelina nun, hádangiñe ha basubudirun luagu agumadiha hamá fulasurugu, banügañame tidoun kianpu lánina óundaruni, ábame hagurabahanina ñein buma. <verse eid="NUM 11:16" /><verse number="17" style="v" sid="NUM 11:17" />Naragachuba adimureha buma, ábame nanügün lídangiñe sífiri le búmabei, ábame níchuguni houn lun híderagunibu hau gürigia ha. Ítara luba mámarügübadibu lan bábugua. <verse eid="NUM 11:17" /><verse number="18" style="v" sid="NUM 11:18" />Lárigiñe ábame bóunahaniña gürigia arumada lubá haruga, ábame heigin úi. Aganba naali hayahun ariñaga: “Gáidügü wagía hamuga lun weigin! Buítimati meha lidin woun Ehiptu!” Keiti ítara liña lubéi, níchiga úi houn lun heigin, <verse eid="NUM 11:18" /><verse number="19" style="v" sid="NUM 11:19" />mámarügü aban weyu, ni biama, ni seingü o diisi, ni wein. <verse eid="NUM 11:19" /><verse number="20" style="v" sid="NUM 11:20" />Héigiba úi luagu aban hati darime lun láfurihan hágirugugiñe lun hahahünedun lun, lugundun fui hamaadina, au le Aburemei, au le haganaguabei, ayahuahaaña ariñaga nigibugiñe: “Ka san uagu wáfurida Ehiptugiñe?”<verse eid="NUM 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 11:21" />Ábati lóunabun Moisesi, lariñaga:</para>
  <para style="p" vid="NUM 11:21">—Sisi-san-míluñanu wügüriña eibu-umutiña ha númabaña, ani ariñagatibu luagu bíchuguba lan úi woun lun weigin aban hati dayarüti? <verse eid="NUM 11:21" /><verse number="22" style="v" sid="NUM 11:22" />Halíañanugia saragu mudún hama bágasu lun hafarún lun buídurügübaña lan houn sun gürigia ha? Ni íbini ánhaña wíchiga sun úduraü ha baranahabaña houn, lóuguabaña.<verse eid="NUM 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 11:23" />Aba lóunabuni Wabureme, lariñaga lun:</para>
  <para style="p" vid="NUM 11:23">—Haritaguatibu san luagu ñǘraüraü lan nubafu? Barihaaliti guentó anhein lagunfuliruba lubéi le nariñagubei lumoun magunfulirunbei lan.<verse eid="NUM 11:23" /></para>
  <para style="s1">Hadimurehan ǘrüwa-wein-diisi ábutigu keisi profetagu</para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 11:24" />Aba liabin Moisesi aba labahüdaguni le lariñagubei Wabureme lun houn lílana fulasu, aba lóundarun ǘrüwa-wein-diisi ábutigu Ísüraelina, aba líchuguniña geyegua tau kianpu. <verse eid="NUM 11:24" /><verse number="25" style="v" sid="NUM 11:25" />Ábati lararirun Wabureme lidan dúeri aba ladimurehan luma Moisesi, lárigiñe aba lanügün lídangiñe sífiri le luágubei Moisesi aba líchuguni hawagun ǘrüwa-wein-diisi ábutigu hagía. Ítara kei ladagarun sífiri ligía hawagun ítara hagumeserun adimureha kei profetagu; gama lumoun masuseredúnyati katei le.<verse eid="NUM 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 11:26" />Ñéinñanu bián wügüriña, aban gíriti Elidádü le aban Medadü, biángubei hagía anuadirúatiña hadan ǘrüwa-wein-diisi hagía, gama lumoun mídintiña sanduariurugun, aba herederun kianpu-ágeirugu. Gama lumoun dagati sífiri hawagun, aba hagumeserun adimureha kei profetagu kianpu-ágeirugu. <verse eid="NUM 11:26" /><verse number="27" style="v" sid="NUM 11:27" />Ábati lidin aban irahü éibaagueina, lariñaga lun Moisesi:</para>
  <para style="p" vid="NUM 11:27">—Anihein Elidádü luma Medadü adimureha kei profetagu tidan kianpu-agei!<verse eid="NUM 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 11:28" />Ábati lariñagun Hosué le liráü Nun, aban hádangiñe lubúeingu Moisesi:</para>
  <para style="p" vid="NUM 11:28">—Moisesi, nabureme, rédeibaña luéi hadügüni katei le!<verse eid="NUM 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 11:29" />Lariñaga Moisesi lun:</para>
  <para style="p" vid="NUM 11:29">—Bemeidihaña san nau? Líchigeidügü hamuga Wabureme lani sífiri houn sun lumutuniña, lun profetagu hamá sun hagía.<verse eid="NUM 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 11:30" />Ábati lagiribudun Moisesi hama ábutigu Ísüraelina tidoun kianpu-agei.<verse eid="NUM 11:30" /></para>
  <para style="s1">Lóunahan Wabureme aban hawuyeri dunuru</para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 11:31" />Aba láfuragüdün Wabureme aban garabali baranahagiñe le anügübei aban hawuyeri dunuru ha geigúaditiña, aba hábürühan tuagun kianpu-agei luma geyegua tau, daruguatiña aban fulasu kei burí aban weyu éibuguni geyegua tau kianpu-agei, háhabuchagua luéi múa yarafa lun aban méturu. <verse eid="NUM 11:31" /><verse number="32" style="v" sid="NUM 11:32" />Aba habudahan gürigia dunuru sun weyu ligía, sun áriebu luma sun weyu larugan. Le míbetimabei abudun, budati diisi háhabuchagun hádangiñe dunuru hagía, aba hasaleihaniña, hadibiragüdaña geyegua tau kianpu-agei. <verse eid="NUM 11:32" /><verse number="33" style="v" sid="NUM 11:33" />Gama lumoun kei hagumeserun Ísüraelina achaguhaña hai dunuru, aba lagañidun Wabureme houn aba labeichaguniña, lau láfaragun saragu gürigia. <verse eid="NUM 11:33" /><verse number="34" style="v" sid="NUM 11:34" />Ligía híchugunbalin Kibürótu-atawá lírime fulasu ligía, ladüga ñein hábunaña ha luágurügübei éigini haritagua.<verse eid="NUM 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 11:35" />Aba hasigiruni Ísüraelina héibugun Kibürótu-Atawágiñe darí Aserótu, ñein heredera.<verse eid="NUM 11:35" /></para>
  <chapter eid="NUM 11" />
  <chapter number="12" style="c" sid="NUM 12" />
  <para style="s1">Tabeichún María</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 12:1" />Aba tagumeserun María luma Aarón adimureha wuriba luagu Moisesi, ladüga lamarieidun tuma aban würi Etiopíana. <verse eid="NUM 12:1" /><verse number="2" style="v" sid="NUM 12:2" />Ariñagatiña giñe:</para>
  <para style="p" vid="NUM 12:2">—Mámarügüñein lun Moisesi ladimureha Wabureme adimurehaali giñe woun.</para>
  <para style="p" vid="NUM 12:2">Aba laganbuniña Wabureme.<verse eid="NUM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 12:3" />Le linarün katei, Moisesi bugaha wügüri le manaaguntimabei lungua ubouagu. <verse eid="NUM 12:3" /><verse number="4" style="v" sid="NUM 12:4" />Ligía lariñagunbei Wabureme lun Moisesi, Aarón tuma María:</para>
  <para style="p" vid="NUM 12:4">—Heiba ǘrüwagubei huguya tidoun kianpu lánina óundaruni.</para>
  <para style="p" vid="NUM 12:4">Aba houdin ǘrüwagubei hagía. <verse eid="NUM 12:4" /><verse number="5" style="v" sid="NUM 12:5" />Ábati lararirun Wabureme lidan aban dúeri dereguati aba lararamun tigibugiñe kianpu; aba lagúarun lun Aarón tuma María, danbei hachülürün <verse eid="NUM 12:5" /><verse number="6" style="v" sid="NUM 12:6" />aba lariñagun houn:</para>
  <para style="p" vid="NUM 12:6">—Aganba huméi le lunbei nariñaguni hun: Lidan anihein lan aban profeta haganagua le nani, adimurehatina lau narufudun burí katei lun luma lidan uénedü; <verse eid="NUM 12:6" /><verse number="7" style="v" sid="NUM 12:7" />ánheinti luma Moisesi le nubúein, mama liña nadügüni. Ligía le richaguatimabei hádangiñe sun nubúeingu, <verse eid="NUM 12:7" /><verse number="8" style="v" sid="NUM 12:8" />adimurehatina lun gagibugu wagía, lidan aban luwuyeri dimurei le furanguti. Ánheinti ariha lubalina gagibugu wagía, kagia uagu hadimureha wuriba luagu?<verse eid="NUM 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 12:9" />Aba lagañidun Wabureme saragu hama, aba lidin. <verse eid="NUM 12:9" /><verse number="10" style="v" sid="NUM 12:10" />Ladisedunbei dúeri tuéi kianpu, aba ladagarun lépüra tuagu María, aba láharudun sun tura. Dan ladigiragunbei Aarón ariha tuagun María, kei larihini luagu anihein lan lépüra tuagu, <verse eid="NUM 12:10" /><verse number="11" style="v" sid="NUM 12:11" />aba lariñagun lun Moisesi:</para>
  <para style="p" vid="NUM 12:11">—Fuleseihabubá nun nabureme, mabeichabawa luéigiñe figóu le wadügübei lau libidiounigan wau. <verse eid="NUM 12:11" /><verse number="12" style="v" sid="NUM 12:12" />Mígiraba lun terederun María kei aban irahü to óunwetu lubaragiñe tágurahoun, to áfuriduboun héiriguañu tura.<verse eid="NUM 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 12:13" />Ábati layumuragun Moisesi lun Wabureme, lariñaga lun:</para>
  <para style="p" vid="NUM 12:13">—Fuleseihabubá nun Wabungiute, ayumuraguatina bun lun bareidaguagüdünu.<verse eid="NUM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 12:14" />Aba lóunabuni Wabureme lariñaga lun:</para>
  <para style="p" vid="NUM 12:14">—Anhein hamuga ásuera túguchi tigibuagun terederuña hamuga lau busiganu luagu sedü weyu. Sagá humóun lubeiti bóugudin tuéi kianpu-agei luagu sedü weyu, lárigiñe gayaraahalime tagiribudun.<verse eid="NUM 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 12:15" />Ítara liña tasagarúniwa María tídangiñe kianpu-agei luagu sedü weyu. Sunti dan ligía, mamufutiña lílana fulasu ñéingiñe. <verse eid="NUM 12:15" /><verse number="16" style="v" sid="NUM 12:16" />Tiábinbei María hamoun, aba hiñurahan wéiyaasu lúmagiñe Aserótugiñe, aba hemeraagun lidan fulasu mageirawati Parán.<verse eid="NUM 12:16" /></para>
  <chapter eid="NUM 12" />
  <chapter number="13" style="c" sid="NUM 13" />
  <para style="s1">Lóunahan Moisesi aríaahatiña Kanán</para>
  <para style="r">(<ref loc="DEU 1:19-25">2 Lur 1.19-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 13:1" />Aba ladimurehan Wabureme lun Moisesi, lariñaga lun:<verse eid="NUM 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 13:2" />—Óunahaba fiu wügüriña lun houdin ariha ida liña lan lumúan Kanán aramudaguarügü, le lunbei níchuguni houn Ísüraelina. Óunahaba aban lídangiñe kada türibu, wügüriña ha gagumadihaditiña.<verse eid="NUM 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 13:3" />Ítara kei lariñaguni Wabureme lun Moisesi, aba lóunahaniña lúmagiñe fulasu mageirawati Parán. Sun hagía, wügüriña lánina gumadi hadan Ísüraelina, <verse eid="NUM 13:3" /><verse number="4" style="v" sid="NUM 13:4" />anihán burí híribei: Hádangiñe lani Rubén türibu, Samúa le liráü Sakuru; <verse eid="NUM 13:4" /><verse number="5" style="v" sid="NUM 13:5" />lídangiñe lani Simeón türibu, Safatü, le liráü Orí, <verse eid="NUM 13:5" /><verse number="6" style="v" sid="NUM 13:6" />lídangiñe lani Hudá türibu, Kalebü le liráü Hefuné, <verse eid="NUM 13:6" /><verse number="7" style="v" sid="NUM 13:7" />lídangiñe lani Isakárü türibu, Igali le liráü Hosé, <verse eid="NUM 13:7" /><verse number="8" style="v" sid="NUM 13:8" />lídangiñe lani Éfürain türibu, Oseasi, le liráü Nun, <verse eid="NUM 13:8" /><verse number="9" style="v" sid="NUM 13:9" />lídangiñe lani Benhamín türibu, Palütí, le liráü Rafú; <verse eid="NUM 13:9" /><verse number="10" style="v" sid="NUM 13:10" />lídangiñe lani Sabulón türibu, Gadieli, le liráü Sodí, <verse eid="NUM 13:10" /><verse number="11" style="v" sid="NUM 13:11" />lídangiñe lani Hosé türibu, Gadi, le liráü Susí, (hameme lani Manasési türibu); <verse eid="NUM 13:11" /><verse number="12" style="v" sid="NUM 13:12" />lídangiñe lani Dan türibu, Amieli le liráü Gemalí, <verse eid="NUM 13:12" /><verse number="13" style="v" sid="NUM 13:13" />lídangiñe lani Aserü türibu, Seturu, le liráü Mikaeli, <verse eid="NUM 13:13" /><verse number="14" style="v" sid="NUM 13:14" />lídangiñe lani Nefütalí türibu, Nabí, le liráü Wápüsi, <verse eid="NUM 13:14" /><verse number="15" style="v" sid="NUM 13:15" />lídangiñe lani Gadü türibu, Geueli, le liráü Makí.<verse eid="NUM 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 13:16" />Ligía burí híribei wügüriña ha lóunahabaña Moisesi aríaahei ageiraü. Aba lasansiruni liri Oseasi le liráü Nun, aba líchugun Hosué luagu.<verse eid="NUM 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 13:17" />Aba lubeiti lóunahaniña Moisesi aríaahei lumúan Kanán, lariñaga houn:</para>
  <para style="p" vid="NUM 13:17">—Heiba luéigiñe Négebü, ábame hamudeirun luagun wübü. <verse eid="NUM 13:17" /><verse number="18" style="v" sid="NUM 13:18" />Ariha huméi ida liña lan ligaburi fulasu, anhein here habéi gürigia ha aganóubaña ñein lumoun mere hamá, anhein gibe habéi lumoun mibe hamá. <verse eid="NUM 13:18" /><verse number="19" style="v" sid="NUM 13:19" />Ariha huméi anhein kianpu-agei lubéi haburugutebei o anhein gabarieirun lubéi, anhein buidu lubéi múa le ñein lubéi haganawa lumoun wuriba lan, <verse eid="NUM 13:19" /><verse number="20" style="v" sid="NUM 13:20" />anhein arandara lubéi lumoun marandarun lan. Manufudeda humá, hanügame fiu in ñéingiñe danme hiabin.</para>
  <para style="p" vid="NUM 13:20">Lidan lidaani talubahóun furumiñetu beibei lasusereda katei le. <verse eid="NUM 13:20" /><verse number="21" style="v" sid="NUM 13:21" />Aba houdin wügüriña hagía, aba haríaahani fulasu lúmagiñe luéigiñe fulasu mageirawati Sin, luéigiñe suru, darí Reobu, luéigiñe nórute, lurugabu lubenari Amatü. <verse eid="NUM 13:21" /><verse number="22" style="v" sid="NUM 13:22" />Hebelura luéigiñe Négebü aba hachülürün darí Ebürón. Ñein meha haganawa Aimán, Sesai luma Talümái, ha ladügawagun Anakü. Sedü irumu lubaragiñe lábunawagun Soán Ehiptu ligía lábunawagun Ebürón. <verse eid="NUM 13:22" /><verse number="23" style="v" sid="NUM 13:23" />Aba hachülürün chülǘ liraüraü lidunari Esükólu, ñein háchuga aban lilimun beibei lau aban resimu beibei luagu; aba hanügünu biangua dibiñu luagu aban wewe. Abudahatiña giñe güranáda tuma igu. <verse eid="NUM 13:23" /><verse number="24" style="v" sid="NUM 13:24" />Aba híchugun Esükólu lírime liraüraü duna ligía ladüga resimu le hátügürübei Ísüraelina ñein.<verse eid="NUM 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 13:25" />Lárigiñe haríaahani fulasu luagu bián-wein weyu, aba hagiribudun <verse eid="NUM 13:25" /><verse number="26" style="v" sid="NUM 13:26" />lun Kadesin lidan fulasu mageirawati Parán. Ñeinñein Moisesi, Aarón hama sun híbiri Ísüraelina. Aba habahüdaguni sun le harihubei houn, arufuda hamóun in to hanügüboun lídangiñe fulasu ligía houn. <verse eid="NUM 13:26" /><verse number="27" style="v" sid="NUM 13:27" />Aba hariñagun lun Moisesi:</para>
  <para style="p" vid="NUM 13:27">—Ñǘdüntiwa lidan fulasu le ñein lubéi bóunahawa, le linarün katei rísiti fulasu ligía, múa le ñeinbei buiti lun ábunaguni ani anuhán burí in to wanügüboun ñéingiñe. <verse eid="NUM 13:27" /><verse number="28" style="v" sid="NUM 13:28" />Gama lumoun héretiña gürigia ha aganóubaña ñein, wéinamuti giñe luburugute ani ayarawaguati lau dübü. Bóugudin luéi lira, arihatiwa ladügawagun hígandei Anakü ñein. <verse eid="NUM 13:28" /><verse number="29" style="v" sid="NUM 13:29" />Lóubawagu Négebü haganawa Amaléküna, lóubawagu dabíara haganawa Étüna, Hebusuna hama Amoruna, luéigiñe louba barana lurugabu duna Hordán ñein haganawa Kananna.<verse eid="NUM 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 13:30" />Ábati lámanichagüdüniña Kalebü gürigia ha ligibugiñebaña Moisesi, aba lariñagun:</para>
  <para style="p" vid="NUM 13:30">—Wagañeiraali múa ligía, gayaraati wagañeiruni!<verse eid="NUM 13:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 13:31" />Aba hóunabun ha ñǘdünbaña luma, hariñaga:</para>
  <para style="p" vid="NUM 13:31">—Siñabei wageindagun hama gürigia hara! Héretiña wawéi.<verse eid="NUM 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 13:32" />Aba buriti habahüdagun iyeeni houn Ísüraelina luagu fulasu le hóudinbei aríaaha. Hariñaga:</para>
  <para style="p" vid="NUM 13:32">—Wuribati múa le ñeinbei lun ábunaguni, ani wéinamutiña sun wügüriña ha aganóubaña ñein. <verse eid="NUM 13:32" /><verse number="33" style="v" sid="NUM 13:33" />Ariha wamutiña giñe hígandei ha ladügawagun Anakü. Ñǘbüriti wasandiragun woungua hóubagiñe kamá chigangaru, ítara liña giñe ligaburi hanügüniwa.<verse eid="NUM 13:33" /></para>
  <chapter eid="NUM 13" />
  <chapter number="14" style="c" sid="NUM 14" />
  <para style="s1">Hiñuragun Ísüraelina houngua luagun Wabureme</para>
  <para style="r">(<ref loc="DEU 1:26-33">2 Lur 1.26-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 14:1" />Ábati hagumeserun Ísüraelina agúaraha, aba hásügürüni sun áriebu ligía ayahuaha. <verse eid="NUM 14:1" /><verse number="2" style="v" sid="NUM 14:2" />Sun hagía aba hadimurehan wuriba luagu Moisesi luma Aarón. Hariñaga:</para>
  <para style="p" vid="NUM 14:2">—Hilagubeihaadiwa hamuga meha Ehiptu, o ya lan lidan fulasu mageirawati! <verse eid="NUM 14:2" /><verse number="3" style="v" sid="NUM 14:3" />Kame san lanügawa Wabureme lidoun ageiraü le? Lun san wóunwegun wuriburugu luma lun hábürühan wámarigu hama warahüñü háhaburugun áganiñu? Buítimati hamuga woun lun wagiribudun Ehiptun.<verse eid="NUM 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 14:4" />Aba hagumeserun ariñaga hámagua:</para>
  <para style="p" vid="NUM 14:4">—Ru wamá aban wábuti ábame wagiribudun Ehiptun!<verse eid="NUM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 14:5" />Aba labuluchagun Moisesi luma Aarón darí ladagarun herebe múarugu hagibugiñe sun Ísüraelina, <verse eid="NUM 14:5" /><verse number="6" style="v" sid="NUM 14:6" />aba laheiridagunu Hosué luma Kalebü ha giñe buga aríaahabalin fulasu hadaüragun le liseinin igarigu, <verse eid="NUM 14:6" /><verse number="7" style="v" sid="NUM 14:7" />aba hariñagun houn sun Ísüraelina:</para>
  <para style="p" vid="NUM 14:7">—Buiti fulasu le wóudinbei aríaaha! <verse eid="NUM 14:7" /><verse number="8" style="v" sid="NUM 14:8" />Anhein fuleseihabu Wabureme woun, líderagubadiwa lun webelurun lidoun fulasu ligía, ábame líchuguni woun. Rísiti fulasu ligía, múa le ñeinbei buiti lun ábunaguni. <verse eid="NUM 14:8" /><verse number="9" style="v" sid="NUM 14:9" />Gama lumoun miñuragua humá hungua luagun Wabureme, manufudedun huguyame hawéi lílana fulasu ligía, lugundun wagañeirubaña; hagía máugiñetiña, ánheinti wagía, anihein Wabureme wámagiñe. Manufudeda humá!<verse eid="NUM 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 14:10" />Lau sun lira, busentiña yebe gürigia hachamuragun dübü hawagu. Ábati lasaliragun luéirigun Wabureme tidan kianpu lánina óundaruni, aríagu sun Ísüraelina lun, <verse eid="NUM 14:10" /><verse number="11" style="v" sid="NUM 14:11" />ábati lariñagun Wabureme lun Moisesi:</para>
  <para style="p" vid="NUM 14:11">—Ídaba san lagumucha mabahüdün hamanina gürigia ha? Ídaba san lagumucha lilouguan hafiñen nuagu lau sun ariha hamani burí milaguru le nadügübei haganagua? <verse eid="NUM 14:11" /><verse number="12" style="v" sid="NUM 14:12" />Nóunaha aban sandi gáfarahati hawagun le lunbei lerederuniña luéi hárügüdüni múa ligía, gama lumoun bídangiñe nadügüba aban ageiraü wéiritimati ani héretima sügǘ hau.<verse eid="NUM 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 14:13" />Gama lumoun aba lóunabuni Moisesi Wabureme, lariñaga lun:</para>
  <para style="p" vid="NUM 14:13">—Buguya asagarubaliña gürigia ha Ehiptugiñe lau bubafu. Danme haganbun Ehiptuna luagu katei le lunbei badügüni, <verse eid="NUM 14:13" /><verse number="14" style="v" sid="NUM 14:14" />ábame habahüdaguni houn lílana Kanán. Hagía aganbaaña giñe lariñawagún luagu abunhein lan haganagua gürigia ha, luagu arufudagua ban bungua houn, luagu anihein lan bani dúeri hóugiñe, luagu habá habaañadibu lan wéyuagu lidan aban dúeri, áriebu lidan aban watu gemeti. <verse eid="NUM 14:14" /><verse number="15" style="v" sid="NUM 14:15" />Ánhaña báfaragua gürigia ha lidan aban, hariñaguba híbiri néchanigu ha subudihabúbaña lun buéirigun, <verse eid="NUM 14:15" /><verse number="16" style="v" sid="NUM 14:16" />“luagu siñagua ban bungua lun bebelaagüdüniña lidoun fulasu le füramase bubéi houn, ligía lan báfaragunbaliña hilagubei lidan fulasu mageirawati”. <verse eid="NUM 14:16" /><verse number="17" style="v" sid="NUM 14:17" />Ligía lubeiti Wabureme, arufudabéi lueirin bubafu ítara kei füramase bani. Buguya guánarügü ariñagubei <verse eid="NUM 14:17" /><verse number="18" style="v" sid="NUM 14:18" />luagu magañidun ban ítara umenrengun, luagu weiri lan bínsiñehabu, luagu ferudunabani wuribani luma mabuchahaü lau sun mígirunbani le gadurunbei mabeichúnga, ábürügüda bumuti hariban agübürigu hawagun isaanigu, ibañani, adügawaguni hama aguraü. <verse eid="NUM 14:18" /><verse number="19" style="v" sid="NUM 14:19" />Keiti weiri lubéi bínsiñehabu, ferudunabéi hariban gürigia ha, kei gaguraasunhadibu lubéi habá lúmagiñe Ehiptugiñe dagá ya.<verse eid="NUM 14:19" /></para>
  <para style="s1">Labeichuniña Wabureme Ísüraelina</para>
  <para style="r">(<ref loc="DEU 1:34-40">2 Lur 1.34-40</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 14:20" />Lóunabati Wabureme:</para>
  <para style="p" vid="NUM 14:20">—Feruduna numutiña kei bamuriahani numa. <verse eid="NUM 14:20" /><verse number="21" style="v" sid="NUM 14:21" />Ani ítara kei inarüni lan luagu winwan nan, luma luagu buin lan ubóu lau nuéirigun, fiñutina <verse eid="NUM 14:21" /><verse number="22" style="v" sid="NUM 14:22" />luagu úabei lan ni aban hádangiñe gürigia ha ebeluruti lidoun fulasu le füramase nubéi. Ariha hamuti nuéirigun luma burí milaguru le nadügübei Ehiptu luma lidan fulasu mageirawati. Lau sun lira, óuchagua hamutina saragu wéiyaasu lidan fulasu mageirawati ani máhatiña hadügüni le nubeibei, <verse eid="NUM 14:22" /><verse number="23" style="v" sid="NUM 14:23" />úabei ni aban hádangiñe arihiti fulasu le füramase nubéi houn hagüchagu. Úabei ni aban hádangiñe ha mabahüdünbalina arihiti fulasu ligía. <verse eid="NUM 14:23" /><verse number="24" style="v" sid="NUM 14:24" />Kalebürügüñein le nubúein, gani aban sífiri amu luéi le hani híbiri ani adüga lumuti le nubeibei lidan lubudubu. Anati ligía nebelaagüdübei lidoun fulasu le lídinbei aríaaha, ábame haganóun ladügawagun ñein. <verse eid="NUM 14:24" /><verse number="25" style="v" sid="NUM 14:25" />Lidan fulasu mawübüriti haganawa Amaléküna hama Kananna. Huguyati, giribugubei humá haruga, ábame hasigirun lídangiñe fulasu mageirawati luagun barana funati.<verse eid="NUM 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 14:26" />Aba líchuguni Wabureme uganu le lun Moisesi luma Aarón lun hariñaguni houn Ísüraelina:<verse eid="NUM 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 14:27" />—Ídaba san lásura nawanduni hadimurehan nuagu hagübüri Ísüraelina huguya le? Aganba naali hadimurehan wuriba nuagu: <verse eid="NUM 14:27" /><verse number="28" style="v" sid="NUM 14:28" />“Au, le Aburemei, fiñutina luagu nibagari luagu nasuseredagüdaali lan hun keimeme le naganbubei hariñagun. <verse eid="NUM 14:28" /><verse number="29" style="v" sid="NUM 14:29" />Sun ha weinbei irumu hau lun iñun ha abürüdǘbaña lidan habahüdǘn gürigia ani adimurehaaña wuriba nuagu, hóunweguba ábame lerederun hágubu chagagu lidan fulasu mageirawati le. <verse eid="NUM 14:29" /><verse number="30" style="v" sid="NUM 14:30" />Úabei ni aban hídangiñe ebeluruti lidoun fulasu le füramase nubéi hun, luéidigia Kalebü luma Hosué. <verse eid="NUM 14:30" /><verse number="31" style="v" sid="NUM 14:31" />Hisaaniguti ha buga uágubaña hariñaga luagu hábürühaba lan háhaburugun áganiñu, nanügübaña lidoun fulasu le unbei maha humá, lun haganóun ñein. <verse eid="NUM 14:31" /><verse number="32" style="v" sid="NUM 14:32" />Lerederuba húgubu chagagu lidan fulasu mageirawati <verse eid="NUM 14:32" /><verse number="33" style="v" sid="NUM 14:33" />le ñeinba lubéi haganawa hisaanigu keisi hóuniri mudún luagu bián-wein irumu. Ítara luba hafayeihan hisaanigu luagu magunfulirun humá, darime hóunwegun sun huguya ya lidan fulasu mageirawati. <verse eid="NUM 14:33" /><verse number="34" style="v" sid="NUM 14:34" />Bianñein-wein weyu hau aríaahei fulasu; bianbei giñeti wein irumu hau afayeiha luagu hidurun: Aban irumu luagu kada weyu. Ítara luba hasubudiruni ka lan líchugubei hiñuragun hungua nuagun”. <verse eid="NUM 14:34" /><verse number="35" style="v" sid="NUM 14:35" />Au, le Aburemei ariñagubalin. Ítara luba nóuseruniña gürigia wuribatiña ha, ha agarabaagubaña nuagun. Lídanba fulasu mageirawati le hagumuchagua; yaaba hóunwegua.<verse eid="NUM 14:35" /></para>
  <para style="s1">Hóunwegun diisi aríaahatiña ha salufuribaña</para>
  <para style="p">
    <verse number="36-37" style="v" sid="NUM 14:36-37" />Dan hayabin wügüriña ha lóunahabaña Moisesi aríaahei fulasu, aba hariñagun luagu mabuidun lan, agülülügüdaña gürigia, aba lábürügüdüniña Wabureme lau óunweni. <verse eid="NUM 14:36-37" /><verse number="38" style="v" sid="NUM 14:38" />Hádangiñe sun hagía Hosuérügüñein luma Kalebü móunwegun.<verse eid="NUM 14:38" /></para>
  <para style="s1">Heferidirun Ísüraelina Orumá</para>
  <para style="r">(<ref loc="DEU 1:41-46">2 Lur 1.41-46</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 14:39" />Dan labahüdagunbalin Moisesi le lariñagubei Wabureme houn Ísüraelina, aba hírudagun sun hagía. <verse eid="NUM 14:39" /><verse number="40" style="v" sid="NUM 14:40" />Larugan binaafin aba saragia hamá, aba hamudeirun luagun liñun-agei áraabu, aba hariñagun:</para>
  <para style="p" vid="NUM 14:40">—Awanheinhadiwa ya! Keimoun lidoun fulasu le füramase lubéi Wabureme woun, lugundun inarüni luagu afigouhaadiwa lan.<verse eid="NUM 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 14:41" />Gama lumoun aba lariñagun Moisesi:</para>
  <para style="p" vid="NUM 14:41">—Ka san uagu madügün hubalin le lubeibei Wabureme? Manügünbei le buiti hun! <verse eid="NUM 14:41" /><verse number="42" style="v" sid="NUM 14:42" />Masigira humá hubaruaguóun, lugundun úati Wabureme huma. Háfaragubadün háganiñu. <verse eid="NUM 14:42" /><verse number="43" style="v" sid="NUM 14:43" />Hagurabuñadün Amaléküna hama Kananna lun hageindagun huma luma lun háfaragunün. Ani keiti ígira humaali lubéi Wabureme, úaali Wabungiute huma.<verse eid="NUM 14:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 14:44" />Gama lumoun lau sun lira múdeimemetiña lábulugun wübü; gama lumoun ni lubagüsina daradu, ni Moisesi mamufutiña tídangiñe kianpu-agei. <verse eid="NUM 14:44" /><verse number="45" style="v" sid="NUM 14:45" />Ábati háfuridun Amaléküna hama Kananna ha aganóubaña ñein, aba héibaahaniña Ísüraelina darí Orumá, aba hagañeiruniña sunsuinagubei.<verse eid="NUM 14:45" /></para>
  <chapter eid="NUM 14" />
  <chapter number="15" style="c" sid="NUM 15" />
  <para style="s1">Lúrudu luáguti adagaragüdüni</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 15:1" />Aba líchuguni Wabureme uganu le lun Moisesi lun lariñaguni houn Ísüraelina:<verse eid="NUM 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 15:2" />—Danme hebelurun lidoun fulasu le lunbei níchuguni hun lun haganóun ñein, <verse eid="NUM 15:2" /><verse number="3" style="v" sid="NUM 15:3" />danme hadagaragüdün aban bágasu wügüri o aban lan mudún nun lun háguduni keisi adagaragüdüni o keisi lan adagaragüdüni gudawarügüti le buiti líhemen, lun hagunfulirun aban füramasei o keisi lan idewesei le hedewehan o ladüga lan somu fedu, <verse eid="NUM 15:3" /><verse number="4" style="v" sid="NUM 15:4" />le íchugubalin idewesei gasu giñe líchugun gádürü líburu fulúaru fínutu to añoundawagutu lau aban líturu garaba. <verse eid="NUM 15:4" /><verse number="5" style="v" sid="NUM 15:5" />Bóugudin luéi lira, gasu hedewehan aban líturu diwéin luagu kada liraüraü mudún lanwoun adagaragüdüni. <verse eid="NUM 15:5" /><verse number="6" style="v" sid="NUM 15:6" />Anhein aban lubéi mudún adagaragüdünibei, gasu tichugún kei burí nefu líburu fulúaru lanwoun to añoundawagutu lau aban líturu luma murusunraüya garaba, <verse eid="NUM 15:6" /><verse number="7" style="v" sid="NUM 15:7" />tuma aban líturu diwéin tuma murusunraüya keisi idewesei le buiti líhemen nun. <verse eid="NUM 15:7" /><verse number="8" style="v" sid="NUM 15:8" />Anhein aban lubéi bágasu ñǘraügili adagaragüdünibei, lun ladagarun keisi adagaragüdüni gudawarügüti o keisi lan adagaragüdüni lánina arandaruni, o lun lan lagunfulirun aban füramasei, <verse eid="NUM 15:8" /><verse number="9" style="v" sid="NUM 15:9" />tichugúba duusu líburu fulúaru ñóunwaguatu lau bián líturu garaba lanwoun, <verse eid="NUM 15:9" /><verse number="10" style="v" sid="NUM 15:10" />túmaya bián líturu diwéin keisi idewesei gudawarügüti le buiti líhemen nun. <verse eid="NUM 15:10" /><verse number="11" style="v" sid="NUM 15:11" />Ligía le lunbei ladügün luagu kada bágasu wügüri, kada mudún wéiriyaali, kada liraüraü mudún o kada lan liraüraü gábara le adagarawagüdüti. <verse eid="NUM 15:11" /><verse number="12" style="v" sid="NUM 15:12" />Luagu kada animaalu adagarawagüdüti, lichugúba aban idewesei. <verse eid="NUM 15:12" /><verse number="13" style="v" sid="NUM 15:13" />Sun Ísüraelina le íchuguti aban idewesei gudawarügüti nun, le buiti líhemen, gasu lagunfulirun lau igaburi le.<verse eid="NUM 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 15:14" />—Anhein abusenra aban terencha, le sügüina umuti o le lan aganóuti haganagua líchugun aban idewesei le gudawarügüti le buiti líhemen nun, gasu lagunfuliruni igaburimeme le higaburibei. <verse eid="NUM 15:14" /><verse number="15" style="v" sid="NUM 15:15" />Ábanmemebei igaburi le dandu hun, kei houn terencha: Ábanbei lúrudu le magumuchaditi, le lunbei hígiruni agübürigu houn isaanigu. <verse eid="NUM 15:15" /><verse number="16" style="v" sid="NUM 15:16" />Ábanmeme lúrudu ábanmeme igaburi hun luma houn terencha.<verse eid="NUM 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 15:17" />Aba líchuguni Wabureme uganu le lun Moisesi lun lariñaguni houn Ísüraelina:<verse eid="NUM 15:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 15:18" />—Danme beluhadün lidoun ageiraü le ñéinhinba lubéi nanügaün, <verse eid="NUM 15:18" /><verse number="19" style="v" sid="NUM 15:19" />danme hagumeserun eiga lídangiñe türigu le ñeinbei, gasu hafanreinrun aban fánreinti lun hadagaragüdüni nun. <verse eid="NUM 15:19" /><verse number="20" style="v" sid="NUM 15:20" />Ani ítarameme kei hadagaragüdüni furumiñeti fánreinti lídangiñe türigu éferehouaali nun, lunti giñe hadügün aban idewesei nun tau furumiñetu fulúaru to hañoundagun, gasu hadügün aban idewesei tau fein nun. <verse eid="NUM 15:20" /><verse number="21" style="v" sid="NUM 15:21" />Gasu hadügüni idewesei le súnwandan.<verse eid="NUM 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 15:22" />—Anhaün ígira hadügün aban lídangiñe katei le uágubei nariñaga lun Moisesi mabusenrunga huguya, <verse eid="NUM 15:22" /><verse number="23" style="v" sid="NUM 15:23" />lúmagiñe furumiñeti weyu lun hagunfuliruni huguya habu hadügawagun, lunti hadügüni katei le:<verse eid="NUM 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 15:24" />—Anhein mabusenrunga lubéi ladügǘwa duru ligía, ani sun lílana fulasu adügübalin, ábame hadagaragüdün aban bágasu ñǘraügili nun keisi adagaragüdüni gudawarügüti le buiti líhemen, lau lidewese le fulúaruauti tuma diwéin kei lariñaguni Wabungiute, dagagüda hagíame aban liraüraü gábara nun keisi adagaragüdüni luagu figóu. <verse eid="NUM 15:24" /><verse number="25" style="v" sid="NUM 15:25" />Lárigiñe ábame ladügüni fádiri échuni lun libihini ferudun luagu hafulesein sun lílana Ísüraeli, ábame feruduna nániña, lugundun aban lan duru le mabusenrúntiña yebe hadügüni hadügübei, ani ru hamuti hadewese luma hadagaragüdün luagu figóu. <verse eid="NUM 15:25" /><verse number="26" style="v" sid="NUM 15:26" />Feruduna nubaña sun lílana Ísüraeli hama sun terencha ha aganóubaña haganagua, anhein mabusenrunga lubéi hadügei duru ligía.<verse eid="NUM 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 15:27" />—Anhein aban lubéi gürigia adügübalin duru mabusenrunga ligía, ábame ladagaragüdün gürigia ligía aban liraüraü gábara le ábanti irumu lau keisi adagaragüdüni luagu figóu. <verse eid="NUM 15:27" /><verse number="28" style="v" sid="NUM 15:28" />Ábame ladügüni fádiri échuni nigibugiñe lun libihíniwa ferudun luagu figóu le ladügübei gürigia ligía mabusenrunga, ábame ferudunanani. <verse eid="NUM 15:28" /><verse number="29" style="v" sid="NUM 15:29" />Ligiamémeba igaburi dandu houn Ísüraelina kei houn terencha ha aganóubaña haganagua, anhein mabusenrunga lubéi ladügǘwa duru ligía.<verse eid="NUM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 15:30" />—Gama lumoun anhein afigouha aban gürigia subudiñu lun, gayaraati Ísüraelina lan o terencha lan, lanabaguñadina. Lagidarúba lubeiti gürigia ligía hádangiñe líbirigu; <verse eid="NUM 15:30" /><verse number="31" style="v" sid="NUM 15:31" />ladüga lanügüni nererun kei ni kata ani magunfulirunti lau le nubeibei, ligía guánarügüba gadurun luagu lounwen.<verse eid="NUM 15:31" /></para>
  <para style="s1">Abeichúni luagu ladüraawaguniwa luéyuri emeraaguni</para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 15:32" />Dan meha lídanñanu lubéi fulasu mageirawati Ísüraelina, aba hadunragun luma aban wügüri abudaha watu lidan luéyuri emeraaguni. <verse eid="NUM 15:32" /><verse number="33" style="v" sid="NUM 15:33" />Aba hanügüni ha adunragubaña luma lun Moisesi luma lun Aarón hama sun lílana fulasu, <verse eid="NUM 15:33" /><verse number="34" style="v" sid="NUM 15:34" />aba hóunigiruni ladüga mariñawagungili lan kaba lan adügǘwa lau. <verse eid="NUM 15:34" /><verse number="35" style="v" sid="NUM 15:35" />Ábati lariñagun Wabureme lun Moisesi:</para>
  <para style="p" vid="NUM 15:35">—Lunti lafarún gürigia le, lunti hachamuragun sun Ísüraelina dübü luagu bóugudi tuéi kianpu-agei.<verse eid="NUM 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 15:36" />Ábati hasagaruni Ísüraelina bóugudin tuéi kianpu-agei, aba hachamuragun dübü luagun darí lounwen, ítara kei lariñaguni Wabureme lun Moisesi.<verse eid="NUM 15:36" /></para>
  <para style="s1">Riban luagu taru daüguaü</para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 15:37" />Aba líchuguni Wabureme uganu le lun Moisesi lun lariñaguni houn Ísüraelina:<verse eid="NUM 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 15:38" />—Huguya hama hadügawagun gasu hanügün riban luagu taru hadaüragun. Riban ligía, láutibei filu koloru guchu. <verse eid="NUM 15:38" /><verse number="39" style="v" sid="NUM 15:39" />Ítara, danme harihini riban ligía, haritaguba luagu sun gumadi le ru naalibei hun, ábame hagunfuliruni, mígiraguagüdünbadün hungua lun lagumadirunün lagübüri haritagun, le burí lébubei múaradun humá numa. <verse eid="NUM 15:39" /><verse number="40" style="v" sid="NUM 15:40" />Ítara luba haritagun luagu sun nugumadin, ábame hagunfuliruni ábame deregeguñu humá hungua nun, au le Hubungiute. <verse eid="NUM 15:40" /><verse number="41" style="v" sid="NUM 15:41" />Au Aburemeibei, le Hubungiute, le asagarubalün Ehiptugiñe lun Hubungiute nan. Au Aburemeibei le Hubungiute.<verse eid="NUM 15:41" /></para>
  <chapter eid="NUM 15" />
  <chapter number="16" style="c" sid="NUM 16" />
  <para style="s1">Liñuragun Koré lungua luagun Moisesi luma Aarón</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 16:1" />Ñeinñein aban Lewita ladügawagun Keatü gíriti Koré, le liráü Isarü, hámaya ǘrüwa wügüriña hádangiñe lani Rubén türibu, gíritiña Datán, Abirán, ha lirahüñü Eliabü, luma On le liráü Péletü, <verse eid="NUM 16:1" /><verse number="2" style="v" sid="NUM 16:2" />aba hiñuragun houngua luagun Moisesi. Aba hóundarun bián-san-dimí Ísüraelina hamoun, wügüriña ha agumadihatiña fulasurugu, hádangiñetiña ha eweridihabaña ani buiti ladimurehoun hawagu. <verse eid="NUM 16:2" /><verse number="3" style="v" sid="NUM 16:3" />Aba hóundaragun sun hagía, aba hagagibudagun luma Moisesi luma Aarón, aba hariñagun houn:</para>
  <para style="p" vid="NUM 16:3">—Hebé hagumadiruniwa! Sun wagía anúadira láadiwa Wabungiute ani anihein Wabureme wama. Ka san uagu habusenra lun huguyaba lan hábutigu lumutuniña Wabureme?<verse eid="NUM 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 16:4" />Dan laganbunbalin Moisesi katei le, aba labuluchagun darí ladagarun lerebe múarugu, <verse eid="NUM 16:4" /><verse number="5" style="v" sid="NUM 16:5" />aba lariñagun lun Koré luma houn ha úaradubaña luma:</para>
  <para style="p" vid="NUM 16:5">—Haruga binaafin lasubudirágüdübei Wabureme ka lan lánigubei luma ka lan anuadirúañubei lun, ábame líchuguni idewesei lun. Lérügübei lanúadirun Wabureme gayara lanügün idewesei lun. <verse eid="NUM 16:5" /><verse number="6" style="v" sid="NUM 16:6" />Anihán le lunbei hadügüni: Barǘ huméi lagei kupali le lani Koré luma le hani lupaanágu, <verse eid="NUM 16:6" /><verse number="7" style="v" sid="NUM 16:7" />híchigame leñegura watu luma kupali lidoun, ábame hadagaragüdüni ligibugiñe Wabureme haruga. Wügürimeti le lasuesirun Wabureme, ligía anuadirúañubei lun. Ani redei huméi katei le, Lewitagu!<verse eid="NUM 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 16:8" />Lárigiñe aba lariñagun Moisesi lun Koré:</para>
  <para style="p" vid="NUM 16:8">—Aganba humana Lewitagu: <verse eid="NUM 16:8" /><verse number="9" style="v" sid="NUM 16:9" />Ni kata san katei le hun, lanúadirunün Wabungiute hádangiñe lílana Ísüraeli luma lun lurugabubadün lan, adaagua humeime kultu lisanduariunrugu Wabureme, ani seriwi huguya houn lílana fulasu? <verse eid="NUM 16:9" /><verse number="10" style="v" sid="NUM 16:10" />Ánhaali Wabureme lun lurugabubadün lan buguya hama ha híbiri lílana bani türibu, ani guentó busentün giñe san lun fádirigu humá? <verse eid="NUM 16:10" /><verse number="11" style="v" sid="NUM 16:11" />Lidan linarün katei ni kata Aarón lun hadimurehaba lan wuriba luagu; luagun Wabureme biñuragua bungua buguya hama bánigu.<verse eid="NUM 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 16:12" />Lárigiñe aba lóunahan Moisesi luagu Datán luma Abirán ha lirahüñü Eliabü, aba hóunahan ariñaga lun:</para>
  <para style="p" vid="NUM 16:12">—Mabusenruntiwa lun woudin. <verse eid="NUM 16:12" /><verse number="13" style="v" sid="NUM 16:13" />Lóuguagili san basagaruniwa lídangiñe aban fulasu le rísibei ani buidu ligía lun ábunaguni, lun wóunwegun lidan fulasu mageirawati, ani bóugudin luéi lira busentibu wábutibadibu lan? <verse eid="NUM 16:13" /><verse number="14" style="v" sid="NUM 16:14" />Buguya manügün bumutiwa lidoun ni aban fulasu le rísiti ani buidu ligía lun ábunaguni, míchugun buguya ichari ni inadürigu woun. Busentibu san lun wígiraguagüdün woungua bun lun badundehaniwa kamá hamuga marihintiwa? Uá, mídinbadiwa arihabu.<verse eid="NUM 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 16:15" />Ábati lagañidun Moisesi saragu, aba lariñagun lun Wabureme:</para>
  <para style="p" vid="NUM 16:15">—Meresibirabéi hadewese! Au magidarungidina ni aban burigü luéi ni aban hádangiñe, madügün au wuribati lun ni aban hádangiñe.<verse eid="NUM 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 16:16" />Lárigiñe aba lariñagun Moisesi lun Koré:</para>
  <para style="p" vid="NUM 16:16">—Harufudaguame hungua nun, haruga, ligibugiñe Wabureme, buguya habu bupanaagu. Ñeinbei giñe Aarón. <verse eid="NUM 16:16" /><verse number="17" style="v" sid="NUM 16:17" />Lanügeime kada aban lagei lani kupali ábame líchugun kupali lidoun. Buguya luma Aarón, hanügübei giñe lagei hani kupali, ábame híchuguni lumoun le líbiri bián-san-dimí, ligibugiñe Wabureme.<verse eid="NUM 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 16:18" />Ábati lanügüni kada aban lagei lani kupali, aba líchugun leñegura watu luma kupali lidoun, aba lidin lurugabun Moisesi luma Aarón tigibugiñe kianpu lánina óundaruni. <verse eid="NUM 16:18" /><verse number="19" style="v" sid="NUM 16:19" />Óundaragua láañati buga Koré sun lílana fulasu kóntüra hagía tigibugiñe kianpu lánina óundaruni. Ábati lasaliragun luéirigun Wabureme hagibugiñe sun lílana fulasu, <verse eid="NUM 16:19" /><verse number="20" style="v" sid="NUM 16:20" />ábati lariñagun Wabureme lun Moisesi luma Aarón:<verse eid="NUM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 16:21" />—Direi humá hawéi gürigia ha, lugundun nagünrinchaguaaña!<verse eid="NUM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 16:22" />Gama lumoun hagía, aba habuluchagun darí ladagarun herebe múarugu, aba hariñagun:</para>
  <para style="p" vid="NUM 16:22">—Bungiu Baba, buguya le íchugubalin ibagari houn sun gürigia, bagañida san houn sun lílana fulasu ladüga lifigoun aban wügüri?<verse eid="NUM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 16:23" />Aba lariñagun Wabureme lun Moisesi:<verse eid="NUM 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 16:24" />—Ariñagabá houn sun Ísüraelina lun hadisedun tuéi muna to ñein habéi Koré, Datán luma Abirámü.<verse eid="NUM 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 16:25" />Aba lásaarun Moisesi hama ábutigu Ísüraelina lárigiñe aba houdin le ñein habéi Datán luma Abirán. <verse eid="NUM 16:25" /><verse number="26" style="v" sid="NUM 16:26" />Ábati lariñagun houn lílana fulasu:</para>
  <para style="p" vid="NUM 16:26">—Dise humá tuéi haban wügüriña wuribatiña ha, maguura humá luagu ni kata le hemegen luéi giñe hóunwegun luéigiñe hafigoun.<verse eid="NUM 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 16:27" />Aba hadireirun gürigia le ñéingiñe habéi Koré, Datán luma Abirán. Datán luma Abirán tubenariñanu haban hau hámarigu hama hasaanigu. <verse eid="NUM 16:27" /><verse number="28" style="v" sid="NUM 16:28" />Aba lasigirun Moisesi, lariñaga:</para>
  <para style="p" vid="NUM 16:28">—Lauba katei le narufudei hun luagu Wabureme lan óunahabalina adügei sun le nadügübei, luagu mama lan lau nani nungua nadügei. <verse eid="NUM 16:28" /><verse number="29" style="v" sid="NUM 16:29" />Ánhaña óunwegua wügüriña ha kei hóunwegun sun wügüriña, mámarügüliña Wabureme óunahabalina; <verse eid="NUM 16:29" /><verse number="30" style="v" sid="NUM 16:30" />gama lumoun anhein adüga Wabureme somu katei le iseri; lun lánhunrenchun múa lun láhuluchuniña lau sun hamegen, hadagarame guribini libiti múa wínwanñu, hasubudirubei luagu wügüriña lan hagía íchugubaña mebereseni luagu Wabureme.<verse eid="NUM 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 16:31" />Dan lásurunbei ladimurehan Moisesi, aba ladaaragun múa hábugiñe, <verse eid="NUM 16:31" /><verse number="32" style="v" sid="NUM 16:32" />aba láhuluchuniña sun wügüriña ha óundaragubaña lumoun Koré hau sun haduheñu luma sun hamegen. <verse eid="NUM 16:32" /><verse number="33" style="v" sid="NUM 16:33" />Aba hábürühan wínwanñu guribinin libiti múa lau sun hálagu, lárigiñe ábaya ladouragun múa. Ítara liña hagumuchagun hádangiñe Ísüraelina. <verse eid="NUM 16:33" /><verse number="34" style="v" sid="NUM 16:34" />Dan le haganbunbalin sun Ísüraelina ha guririgubaña ñein hagúaragun, aba héibaagun ariñageina:</para>
  <para style="p" vid="NUM 16:34">—Máhulucha láamugawa giñe múa!<verse eid="NUM 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 16:35" />Óunahati giñe Wabureme aban watu gemeti le áfaragubaliña bián-san-dimí ha águdahabaña kupali.<verse eid="NUM 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 16:36" />Aba líchuguni Wabureme uganu le lun Moisesi lun lariñaguni lun Eleasárü le liráü Aarón:<verse eid="NUM 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 16:37" />—Sagabei lagei burí kupali lídangiñe lárigirugu gudáü, ábame lachagaruni leñegura watu le erederubei lidan diseun. <verse eid="NUM 16:37" /><verse number="38" style="v" sid="NUM 16:38" />Lagei burí kupali le hani wügüriña ha, ha óunwegubaña ladüga hafigouhan, rédeiti anuadirúañu ladüga yúsuati lun lágudahoun kupali nigibugiñe. Adüga humá singi lau lagei kupali ligía lun lafurarúniwa latarü, luma lun leseriwidun keisi eweridihani houn Ísüraelina.<verse eid="NUM 16:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 16:39" />Aba labudahani fádiri Eleasárü lagei kupali lauti buronse le buga hámabei wügüriña ha óunwegubaña lidan gudáü, aba lariñagun lun ladügǘn singi lau lun lafurarúniwa latarü. <verse eid="NUM 16:39" /><verse number="40" style="v" sid="NUM 16:40" />Aban bugaha eweridihani le houn Ísüraelina luagu ua lan ni aban haweidigia ladügawagun Aarón, lun gayara lan layarafadun luagun latarü lun lágudahan kupali lun Wabureme, luéi lasuseredun libe le asuseredubei lun Koré hama lupaanágu lun. Aba ladügǘn súngubei ítara kei buga lariñaguni Wabureme lun Eleasárü lídangiñe Moisesi.<verse eid="NUM 16:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 16:41" />Larugan, aba hadimurehan sun lílana Ísüraeli wuriba luagu Moisesi luma Aarón. Hariñaga:</para>
  <para style="p" vid="NUM 16:41">—Huguya háfaraguñanu lumutuniña Wabureme hilagubei!<verse eid="NUM 16:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 16:42" />Aba haguriridágun sun hagía geyegua lau Moisesi luma Aarón; gama lumoun hagía aba houdin tidoun kianpu lánina óundaruni. Lidan oura ligía, aba ladouragun dúeri tau, aba lasaliragun luéirigun Wabureme. <verse eid="NUM 16:42" /><verse number="43" style="v" sid="NUM 16:43" />Ábati lidin Moisesi luma Aarón tigibugiñoun kianpu lánina óundaruni, <verse eid="NUM 16:43" /><verse number="44" style="v" sid="NUM 16:44" />aba lariñagun Wabureme lun Moisesi:<verse eid="NUM 16:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="NUM 16:45" />—Direi humá hawéi sun gürigia ha, lugundun nagünrinchaguaaña!</para>
  <para style="p" vid="NUM 16:45">Aba labuluchagun Moisesi luma Aarón darí ladagarun herebe múarugu, <verse eid="NUM 16:45" /><verse number="46" style="v" sid="NUM 16:46" />aba lariñagun Moisesi lun Aarón:</para>
  <para style="p" vid="NUM 16:46">—Barübei lagei bani kupali, ruba leñegura watu luéigiñe latarü lidoun luma kupali; ábame bidin le ñein habéi lílana fulasu, ábame bamuriahan ferudun luma Wabungiute hawagu, lugundun durungua ligañi Wabureme ani gumeseeli igei.<verse eid="NUM 16:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="NUM 16:47" />Aba ladügüni Aarón le lubeibei Moisesi lun, aba lidin éibaagueina le ñein habéi lílana fulasu óundaragu. Oura ligía gumeseeli igei le lóunahabei Wabungiute adüga damichi fulasurugu. Ábati ladagaragüdün Aarón kupali, aba lamuriahan ferudun luma Wabungiute luagu hafigoun lílana fulasu. <verse eid="NUM 16:47" /><verse number="48" style="v" sid="NUM 16:48" />Lárigiñe aba lararamun hamidangua ha hilaguaañabaña hama ha wínwangiñabaña, aba lerederun igei, <verse eid="NUM 16:48" /><verse number="49" style="v" sid="NUM 16:49" />lau sun lumoun lan oura ligía hilaguaaña katorusu-milu-sedü-san gürigia, mabahüdünga ha óunwegubaña furumiñe lidan lawügürihóun Koré. <verse eid="NUM 16:49" /><verse number="50" style="v" sid="NUM 16:50" />Dan lagumuchunbei igei, aba lagiribudun Aarón tubenarin kianpu lánina óundaruni lun lóundarun lumoun Moisesi.<verse eid="NUM 16:50" /></para>
  <chapter eid="NUM 16" />
  <chapter number="17" style="c" sid="NUM 17" />
  <para style="s1">Láhüchagun lubadun Aarón</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 17:1" />Aba lariñagun Wabureme lun Moisesi:<verse eid="NUM 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 17:2" />—Ariñagabá houn Ísüraelina lun lanügün kada aban hádangiñe hábutigu türibu aban badun, so dúusubei badun hadan súngubei. Ábame babürüdüni liri kada aban luagu lubadun, <verse eid="NUM 17:2" /><verse number="3" style="v" sid="NUM 17:3" />babürüdeime liri Aarón luagu habadun lani Lewí türibu, gasu ñeinbei lan aban badun luagu kada hábuti türibu. <verse eid="NUM 17:3" /><verse number="4" style="v" sid="NUM 17:4" />Ábame badagaragüdüni tidan kianpu lánina óundaruni, tigibugiñe lubagüsina daradu, le ñein lubéi nóundaragua huma. <verse eid="NUM 17:4" /><verse number="5" style="v" sid="NUM 17:5" />Nadügüba lun láhüchagun lubadun le nanúadirubei, ítara luba masigirun hamá Ísüraelina adimureha wuriba huagu nigibugiñe.<verse eid="NUM 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 17:6" />Aba lariñaguni Moisesi káteimeme le houn Ísüraelina, aba líchuguni kada aban hádangiñe hábutigu türibu lubadun lun, aba lóundarun duusu badun. Ñeinñein giñe lubadun Aarón laganagua. <verse eid="NUM 17:6" /><verse number="7" style="v" sid="NUM 17:7" />Aba ladagaragüdüni Moisesi badun burí ligía ligibugiñe Wabureme tidan kianpu lánina daradu, <verse eid="NUM 17:7" /><verse number="8" style="v" sid="NUM 17:8" />larugan dan le lidin ñein, aba larihin luagu hüchaguaali lan lubadun Aarón, le hani lani Lewí türibu, egelewehaali, ani gínhali alüméndüra to funaaru. <verse eid="NUM 17:8" /><verse number="9" style="v" sid="NUM 17:9" />Ábati lasagaruni Moisesi sun badun liñúarürugugiñe Wabureme, aba larufuduni houn Ísüraelina. Lárigiñe harihini, aba lanügüni kada aban lubadun.<verse eid="NUM 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 17:10" />Ábati lariñagun Wabureme lun Moisesi:</para>
  <para style="p" vid="NUM 17:10">—Ruyabéi lubadun Aarón tigibugiñoun lubagüsina daradu, ábame bareiduni ñein keisi aban eweridiruni houn gürigia mabuchahatiña ha. Ítara luba madimurehanhaña lanme wuriba nigibugiñe móunwegun hamaamuga.<verse eid="NUM 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 17:11" />Aba ladügüni Moisesi sun le, ítara kei lariñaguni Wabureme lun, <verse eid="NUM 17:11" /><verse number="12" style="v" sid="NUM 17:12" />gama lumoun aba hariñagun Ísüraelina lun Moisesi:</para>
  <para style="p" vid="NUM 17:12">—Féridiguaadiwa! Wóunwegua sun wagía! <verse eid="NUM 17:12" /><verse number="13" style="v" sid="NUM 17:13" />Ladüga sun ha ayarafadutiña tun lani Wabureme sanduariu, hóunwegun. Wóunweguba funagia sun wagía?<verse eid="NUM 17:13" /></para>
  <chapter eid="NUM 17" />
  <chapter number="18" style="c" sid="NUM 18" />
  <para style="s1">Hawadigimari fádirigu hama Lewitagu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 18:1" />Aba lariñagun Wabureme lun Aarón:</para>
  <para style="p" vid="NUM 18:1">—Buguya hama birahüñü úara hama sun ha híbiri lani Lewí türibu ha bánigu, huguyaba ariha luagu burí figóu le adügǘbei kóntüra sanduariu, gama lumoun figóu le badügübei buguya hama birahüñü lidan huádigimari keisi fádirigu, huguyarügübadün ariha lau. <verse eid="NUM 18:1" /><verse number="2" style="v" sid="NUM 18:2" />Gama lumoun mosu báluahan lun híderagunün ha híbiri lílana lani Lewí türibu lidan eseriwiduni tigibugiñe kianpu to lúbaana daradu. <verse eid="NUM 18:2" /><verse number="3" style="v" sid="NUM 18:3" />Heseriwiduba bun seriwi hagíame tidan kianpu, gama lumoun moun lumuti hayarafadun lun burí tumegegu sanduariu ni luagun latarü; ánhaña ayarafada, hóunweguba, ani huguya sun hóunweguba giñe. <verse eid="NUM 18:3" /><verse number="4" style="v" sid="NUM 18:4" />Mosu búmabaña lan lidan sun eseriwiduni tidan kianpu lánina óundaruni luma lidan sun le lunbei hadügüni. Gama lumoun moun lumuti layarafadun ni aban gürigia terencha hun; <verse eid="NUM 18:4" /><verse number="5" style="v" sid="NUM 18:5" />huguya lunbei harihin lau eseriwiduni le tani sanduariu luma latarü. Ítara luba magañidunhaadina lanme houn Ísüraelina. <verse eid="NUM 18:5" /><verse number="6" style="v" sid="NUM 18:6" />Nadiñurubaña bíbirigu ha Lewitagu hádangiñe Ísüraelina lun níchuguniña hun, lun heseriwidun lidan burí barasegu le tídanbei kianpu lánina óundaruni; <verse eid="NUM 18:6" /><verse number="7" style="v" sid="NUM 18:7" />gama lumoun buguyarügüba hama birahüñü gayara hadügüni hawadigimari fádirigu le adügǘbei luagu latarü o tanagangiñe belu. Huguya lunbei hadügüni barasegu lira, ladüga ru naali irichaü hun lun hadügüni hawadigimari fádirigu. Furumiñeguarügü le adügüti luadigimari fádiri mámouga ligía fádiri, lasiadirúba lun lounwen.<verse eid="NUM 18:7" /></para>
  <para style="s1">Lebuina habagaridun fádirigu hama Lewitagu</para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 18:8" />Lariñaga Wabureme lun Aarón:</para>
  <para style="p" vid="NUM 18:8">—Ru naali idewesei le íchaahoubei nun labun baríaahan. Sun idewesei sagüráuti le hadügübei Ísüraelina nun, ru numuti bun luma houn birahüñü keisi hufanran; ítara luba súnwandan. <verse eid="NUM 18:8" /><verse number="9" style="v" sid="NUM 18:9" />Lídangiñe sun adagaragüdüni le lunti lagudúniwa, bánibei sun idewesei fulúaruauti luma burí adagaragüdüni luagu figóu, le hadagaragüdübei Ísüraelina nun; sun burí idewesei sagüráuti le, bánibei hama birahüñü. <verse eid="NUM 18:9" /><verse number="10" style="v" sid="NUM 18:10" />Furumiñeguarügü wügüri hídangiñe gayaraabei leigin lídangiñe idewesei ligía, gama lumoun gasu léigini lidan aban fulasu le anuadirúati, lugundun anuadirúati idewesei ligía.<verse eid="NUM 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 18:11" />—Idewesei burí giñe le ayudeihóuarügüti le híchugun Ísüraelina nun, ru numuti bun luma houn birahüñü würiña o wügüriña ha búmagiña múnada. Aban lúrudu le lunti sun dan lira. Furumiñeguarügü hádangiñe biduheñu le harumati según échuni, gayaraabei leigin lídangiñe. <verse eid="NUM 18:11" /><verse number="12" style="v" sid="NUM 18:12" />Ru numuti giñe furumiñeti tin nadü le hanügübei Ísüraelina nun sagü irumu: Lubuidun-agei garaba, tubuidun-agei diwéin luma lubuidun-agei türigu. <verse eid="NUM 18:12" /><verse number="13" style="v" sid="NUM 18:13" />Ítarameme giñe, furumiñeti halubahan le hadagaragüdübei nun, bánibei. Furumiñeguarügü hádangiñe biduheñu le harumati según échuni, gayaraabei léigini. <verse eid="NUM 18:13" /><verse number="14" style="v" sid="NUM 18:14" />Sun idewesei le hanuadirún Ísüraelina nun, bánibei.<verse eid="NUM 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 18:15" />—Sun hágiramagu Ísüraelina o furumiñetiña lan harahüñü habiñanigu, ha híchugun nun, bánibaña. Gama lumoun gasu bamuriahan aban fáyeiti hawagu hágiramagu gürigia hama furumiñetiña harahüñü animaalugu ha wíyetiña. <verse eid="NUM 18:15" /><verse number="16" style="v" sid="NUM 18:16" />Gasu lafayeirúniwa hawagu aban hati lárigiñe hágurahoun o hemeilihóun, séingübei murusun pülata según seinsu le ayusurúbei sanduariurugu, le únsubei güramu lihürü. <verse eid="NUM 18:16" /><verse number="17" style="v" sid="NUM 18:17" />Gama lumoun mígirun bubaña lun hafayeirun hawagu furumiñetiña harahüñü bágasu, mudún o gábara. Núntiña animaalugu hara, lunti báfarahaniña; babahichagueime hata luagun latarü, le hagüle bágudagueime keisi idewesei le buiti líhemen nun. <verse eid="NUM 18:17" /><verse number="18" style="v" sid="NUM 18:18" />Gayaraabei berederun labu lǘgürügü luma laniguagu animaalu ligía, aban idewesei núnrügüti lira, gayaraabei giñe berederun labu liyada le luéigiñebei lóunwenren. <verse eid="NUM 18:18" /><verse number="19" style="v" sid="NUM 18:19" />Sun ídemuei le hafanreinrun Ísüraelina nun, ru numuti bun luma houn birahüñü ha búmagiña múnada. Aban lúrudu le lunti súnwandan le. Aban daradu le masansiraguaditi, le lunti sun dan, le nadügübei buma luma hama badügawagun.<verse eid="NUM 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 18:20" />Aba lariñagun Wabureme lun Aarón:</para>
  <para style="p" vid="NUM 18:20">—Mamúanbadibu memegen bugíame Ísüraeli, kei híbiri Ísüraelina.</para>
  <para style="p" vid="NUM 18:20">Auba bumegen, auba giñe balagante lumúanrugu Ísüraeli. <verse eid="NUM 18:20" /><verse number="21" style="v" sid="NUM 18:21" />Diisi lídangiñe san le gásubei híchuguni Ísüraelina lídangiñe sun le ebelurubei houn, ru numuti houn Lewitagu keisi hafayeiruaha luagu heseriwidun tidan kianpu lánina óundaruni. <verse eid="NUM 18:21" /><verse number="22" style="v" sid="NUM 18:22" />Ha híbiri Ísüraelina moun lumuti hayarafadun tun kianpu lánina óundaruni, lugundun anhein hadüga ítara hafigouhaba, ani lanügüba óunweni houn. <verse eid="NUM 18:22" /><verse number="23" style="v" sid="NUM 18:23" />Lewitagurügübaña eseriwida tidan kianpu lánina óundaruni, hagíaba giñe afayeiha luagu hadurun. Ábanbei lúrudu magumuchaditi le, le lunbei hígiruni agübürigu houn isaanigu, mafulasunbaña Lewitagu lumúanrugu Ísüraeli. <verse eid="NUM 18:23" /><verse number="24" style="v" sid="NUM 18:24" />Diisi lídangiñe san le híchugubei Ísüraelina nun lídangiñe le ebelurubei houn, ligía níchugubei houn Lewitagu lun hamegenbei lan. Ligía nariñagunbei houn luagu mafulasunbaña lan lumúanrugu Ísüraeli.<verse eid="NUM 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 18:25" />Aba líchuguni Wabureme uganu le lun Moisesi lun lariñaguni houn Lewitagu:<verse eid="NUM 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 18:26" />—Lun danme lan heresibiruni diisi lídangiñe san lídangiñe sun le níchugubei houn Ísüraelina, le heresibirubei Lewitagu keisi hemegen, mosu giñe hasagaruni diisi lídangiñe san lídangiñe lun híchuguni nun. <verse eid="NUM 18:26" /><verse number="27" style="v" sid="NUM 18:27" />Ligíaba ídemuei le lunbei híchuguni nun, kéisigubeirügü ídemuei le híchugubei Ísüraelina nun tídangiñe hatürigun luma tídangiñe haniñe diwéin. <verse eid="NUM 18:27" /><verse number="28" style="v" sid="NUM 18:28" />Ítara, lídangiñemeti diisi lídangiñe san le híchugubei Ísüraelina houn Lewitagu, hasagarubei le lunbei hafanreinhani luma Wabureme ábame híchuguni lun fádiri Aarón. <verse eid="NUM 18:28" /><verse number="29" style="v" sid="NUM 18:29" />Lídangiñe sun le ichugúbei houn, gasu hadiñurun aban fánreinti keisi ídemuei nun; ani le fánreinti le hederegerun nun, gasu leeba lan buídutimabei.<verse eid="NUM 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 18:30" />—Ariñagabá giñe houn: “Lárigiñeme hadiñuruni fánreinti le buídutimabei nun, le líbiri gayaraahalime hariñagun luagu hani lan, <verse eid="NUM 18:30" /><verse number="31" style="v" sid="NUM 18:31" />ani gayaraabei héigini huguya hama hiduheñu lidan furumiñeguarügü fulasu. Ligía hafayeiruahabei luagu heseriwidun tidan kianpu lánina óundaruni. <verse eid="NUM 18:31" /><verse number="32" style="v" sid="NUM 18:32" />Lárigiñeme hadiñuruni fánreinti le buídutimabei nun, gayaraahalime héigini le líbiri ani mama figóu; ítara luba mawiyedagüdün humani hadewese Ísüraelina le sagüráubei, ani ítara luba móunwegun humá”.<verse eid="NUM 18:32" /></para>
  <chapter eid="NUM 18" />
  <chapter number="19" style="c" sid="NUM 19" />
  <para style="s1">Igaburi lun arumaduni según échuni</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 19:1" />Aba lariñagun Wabureme lun Moisesi luma Aarón:<verse eid="NUM 19:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 19:2" />—Au le Aburemei íchugubalin gumadi le: Ariñagabá houn Ísüraelina lun hanügün aban bágasu to funayumati tura bun, to úati mégeiti tuagu, to michugúngili yugu tuagu ni aban wéiyaasu. <verse eid="NUM 19:2" /><verse number="3" style="v" sid="NUM 19:3" />Ábame hederegerunu lun fádiri Eleasárü, ábame lasagarunu bóugudin tuéi kianpu-agei, ábame lariñagun lun tafarún liñúarü. <verse eid="NUM 19:3" /><verse number="4" style="v" sid="NUM 19:4" />Ábame lanügün fádiri Eleasárü murusun hitaü luagu lifinga, ábame labahichaguni sedü wéiyaasu tuagun kianpu lánina óundaruni. <verse eid="NUM 19:4" /><verse number="5" style="v" sid="NUM 19:5" />Lárigiñeme ábame hágudunu bágasu tuguya liñúarü, gudá hameime tura, tǘgürügü, tita luma tídiga. <verse eid="NUM 19:5" /><verse number="6" style="v" sid="NUM 19:6" />Lárigiñe ábame lanügüni fádiri wewe le hibúari, aban liraüraü limu isopu tuma gamisa funatu, ábame lachagaruni sun le lidoun watu gemeti le ñein lubéi tagudúa bágasu. <verse eid="NUM 19:6" /><verse number="7" style="v" sid="NUM 19:7" />Lárigiñe ábame lachibunu ladaüragun chibagua ligíame lungua lau duna, lárigiñeme gayaraahalime lebelurun tidoun kianpu-agei, lau sun lerederuba lan wíyeñu según échuni darí lumoun rábounweyu. <verse eid="NUM 19:7" /><verse number="8" style="v" sid="NUM 19:8" />Luáguti wügüri le águdubarun bágasu, lachibuboun ladaüragun chibagua ligíame lungua lau duna, ábame lerederun wíyeñu dagá rábounweyu. <verse eid="NUM 19:8" /><verse number="9" style="v" sid="NUM 19:9" />Ámuba wügüri le harumati según échuni abudahei tubaligiñen bágasu ábame líchuguni lidan aban fulasu harumati según échuni bóugudi tuéi kianpu-agei. Leseriwiduba baligi ligía houn lílana Ísüraeli lun hesetiruni lidunarina arumaduni. Adagaragüdüni luagu figóu sun le. <verse eid="NUM 19:9" /><verse number="10" style="v" sid="NUM 19:10" />Le buga wügüri le abudahabalin baligi, lunti lachibunu ladaüragun, ábame lerederun wíyeñu darí lumoun rábounweyu según échuni. Aban lúrudu lunti sun dan le, dandu hun huguya Ísüraelina kei houn terencha ha aganóutiña haganagua.<verse eid="NUM 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 19:11" />—Le aguuruti aban gürigia hilaali, lerederuba wíyeñu luagu sedü weyu. <verse eid="NUM 19:11" /><verse number="12" style="v" sid="NUM 19:12" />Luagu lǘrüwan luma lisedün weyu gasu larumadaguagüdün lungua lau lidunarina arumaduni, ábame larumadun. Anhein marumadaguagüdün lungua luagu lǘrüwan luma lisedün weyu, marumadunbei. <verse eid="NUM 19:12" /><verse number="13" style="v" sid="NUM 19:13" />Anhein aguura aban gürigia aban hilaali ani marumadaguagüdünti lungua, lawiyeduñoun lani Wabureme sanduariu lau lira, gasu lubeiti lagidarún hádangiñe lílana Ísüraeli. Ladüga kei mabahichawagun lubéi lau lidunarina arumaduni, lídanñein iwiyei según échuni.<verse eid="NUM 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 19:14" />—Dan le lounwen somu gürigia tidan aban kianpu, anihán katei le lunbei ladügǘn: Sun ha tídanbaña o ha lan ebelurutiña tidoun, herederuba wíyeñu luagu sedü weyu. <verse eid="NUM 19:14" /><verse number="15" style="v" sid="NUM 19:15" />Sun dabarasi le madourúnti lau o wuriba lan ladourún lau, lerederuba giñe wíyeñu.<verse eid="NUM 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 19:16" />—Ánheinti bóugudi tuéi kianpu, le aguuruti aban gürigia hilaali le afarúarügüti o hilarügüti, o habu gürigia hilaaña o aban lan umúahaü, lerederuba wíyeñu luagu sedü weyu.<verse eid="NUM 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 19:17" />—Lidan burí kesi lánina awiyeduni ligía, lunti lanügǘn murusun lídangiñe tubaligiñen bágasu to adagarawagüdüboun luagu figóu, ábame lichugún lidoun aban ágeidinaü lun leserún duna lídangiñeti lísensen duna lanwoun. <verse eid="NUM 19:17" /><verse number="18" style="v" sid="NUM 19:18" />Lárigiñe ábame lanügün aban wügüri le harumati aban lilimun isopu, ábame ladüdüragüdüni lidan duna, ábame labahichagunu kianpu lau, ágeidinaü, gürigia ha buga ñéinbaña luma giñe le buga aguurubei labu hilaali o lúgubu gürigia le afarúarügübei o le lan óunwebei lau furumiñeguarügü óunweni o aguuruti lan umúahaü. <verse eid="NUM 19:18" /><verse number="19" style="v" sid="NUM 19:19" />Wügüri le harumabei según échuni, gasu labahichaguni le wíyebei lidan lǘrüwan luma lisedün weyu. Luágume lisedün weyu, harumagüda láalime. Ábameti lachibunu gürigia le buga wíyebei ladaüragun chibagua ligíame lungua lau duna, gama lumoun lerederamémeba wíyeñu darí lumoun rábounweyu. <verse eid="NUM 19:19" /><verse number="20" style="v" sid="NUM 19:20" />Anhein marumadun aban gürigia le wíyeti según échuni, gasu lagidarún hádangiñe líbirigu lugundun ruti minebeni tun lisanduariun Wabureme. Lugundun kei mabahichawagun lubéi lau lidunarina arumaduni, wiyemémeti. <verse eid="NUM 19:20" /><verse number="21" style="v" sid="NUM 19:21" />Aban lúrudu le, le lunti sun dan. Le abahichaguti amu lau lidunarina arumaduni, gasu lachibunu ladaüragun. Le aguuruti lidunarina arumaduni, lerederuba wíyeñu darí rábounweyu. <verse eid="NUM 19:21" /><verse number="22" style="v" sid="NUM 19:22" />Sun katei le laguurun aban gürigia wíyeti, lerederuba wíyeñu; le giñe aguuruti aban gürigia wíyeti, lerederuba giñe wíyeñu darí rábounweyu.<verse eid="NUM 19:22" /></para>
  <chapter eid="NUM 19" />
  <chapter number="20" style="c" sid="NUM 20" />
  <para style="s1">Duna lídangiñe dübü</para>
  <para style="r">(<ref loc="EXO 17:1-7">Afu 17.1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 20:1" />Lidan furumiñeti hati lidan irumu, ligía hachülürün Ísüraelina lidoun fulasu mageirawati Sin, aba herederun Kadesi luagu saragu dan. Ñein tounwe María, ñein giñe tabunúa.<verse eid="NUM 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 20:2" />Keiti maniñe habéi Ísüraelina duna, aba hóundaragun lun hadimurehan wuriba luagu Moisesi luma Aarón, <verse eid="NUM 20:2" /><verse number="3" style="v" sid="NUM 20:3" />aba hariñagun lun Moisesi:</para>
  <para style="p" vid="NUM 20:3">—Hilagubeihaadiwa hamuga meha úara hama híbiri Ísüraelina ha láfaragubaña Wabureme! <verse eid="NUM 20:3" /><verse number="4" style="v" sid="NUM 20:4" />Kame san hanügaña lumutuniña Wabureme lidoun fulasu mageirawati le? Busentün funagia lun wóunwegun hau sun wabiñanigu? <verse eid="NUM 20:4" /><verse number="5" style="v" sid="NUM 20:5" />Kame san hasagarawa Ehiptugiñe lun hanügüniwa lidoun lagübüri fulasu le? Siñati lábunawagun ni kata ya; úati tídibu igu ya ni tídibu beibei, ni güranáda; úagubeiti ni duna lun watun!<verse eid="NUM 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 20:6" />Aba ladisedun Moisesi luma Aarón hawéi lílana fulasu, aba houdin tubenarin kianpu lánina óundaruni, aba habuluchagun ñein darí ladagarun herebe múarugu. Ábati lasaliragun luéirigun Wabureme houn, <verse eid="NUM 20:6" /><verse number="7" style="v" sid="NUM 20:7" />aba lariñagun Wabureme lun Moisesi:<verse eid="NUM 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 20:8" />—Barübei badun ábame líderagunibu bíbiri Aarón lun bóundaraguniña gürigia. Lárigiñe ábame bariñagun lun dübü hagibugiñe sun hagía lun líchugun duna houn, barihuba luagu lésehaba lan duna lídangiñe dübü lun hatun hau sun habiñanigu.<verse eid="NUM 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 20:9" />Aba lanügüni Moisesi badun le ligibugiñebei Wabureme, ítara kei lariñaguni Wabureme lun; <verse eid="NUM 20:9" /><verse number="10" style="v" sid="NUM 20:10" />lárigiñe aba lóundaruniña Moisesi luma Aarón gürigia ligibugiñe dübü, aba lariñagun Moisesi houn:</para>
  <para style="p" vid="NUM 20:10">—Aganba humá, maganbaditiña huguya le: Wasagaruba funagia duna lídangiñe dübü le lun hatun?<verse eid="NUM 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 20:11" />Ítara kei lariñaguni Moisesi katei le, ítara liñuruni lúhabu aba lagayuahan luagu dübü lau badun bián wéiyaasu, aba lésehan saragu duna lídangiñe. Aba hatun gürigia hau sun habiñanigu. <verse eid="NUM 20:11" /><verse number="12" style="v" sid="NUM 20:12" />Gama lumoun aba lariñagun Wabureme lun Moisesi luma Aarón:</para>
  <para style="p" vid="NUM 20:12">—Kei míchugun hubalin buga hemenigin nuagu, míchugun huguya uéiriguni lun niri hagibugiñe Ísüraelina, mebelubadün hama gürigia ha lidoun ageiraü le níchugubei houn.<verse eid="NUM 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 20:13" />Lísensen duna le gíribei Meribá ligía le ñein lubéi hekehara Ísüraelina lun Wabureme, aba larufuduni lubafu le sándubei houn.<verse eid="NUM 20:13" /></para>
  <para style="s1">Lamaharun Edomu lun lásügüragüdüniña Ísüraelina</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 20:14" />Aba lóunahan Moisesi wügüriña lúmagiñe Kadesigiñe lun hariñagun lun lurúeite Edomu:</para>
  <para style="p" vid="NUM 20:14">—Hóunahaña bíbirigu Ísüraelina ariñaga bun: “Subuditi bun buidu luagu lénrengunga le sügǘ wamaalibei. <verse eid="NUM 20:14" /><verse number="15" style="v" sid="NUM 20:15" />Aba bugaha houdin wagüchagu Ehiptun aba herederun saragu dan ñein, gama lumoun rútiña Ehiptuna lidere dan woun kei meha hadüga houn wagüchagu; <verse eid="NUM 20:15" /><verse number="16" style="v" sid="NUM 20:16" />ábati wamuriahan luma Wabureme lun líderaguniwa ani aganba lumuti wagúarahan, aba lóunahan aban ánheli aba lasagaruniwa Ehiptugiñe. Awahánti ya guentó uburugu Kadesi yarafa lun láfadaragun bageira. <verse eid="NUM 20:16" /><verse number="17" style="v" sid="NUM 20:17" />Wamuriahaña buma lun bíchugun üma woun lun wásügürün bumúanrugugiñe. Másügürünbadiwa lídangiñe bichari le bunawaguaali, ni tídangiñe beibei-agei, matun wagíame duna lídangiñe bifusun, luéigiñebadiwa üma le ñéingiñe lubéi leibugúa, madiñurunbadiwa luéi darime hiñugua wamaali bumúan”.<verse eid="NUM 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 20:18" />Lariñaga lurúeite Edomu houn:</para>
  <para style="p" vid="NUM 20:18">—Másügüra humá numúanrugugiñe, anhaün áluga hásügürün, náfuriduba hubaroun hau nisudaranigu!<verse eid="NUM 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 20:19" />Hariñaga Ísüraelina lun:</para>
  <para style="p" vid="NUM 20:19">—Sügürügübadiwa ǘmadarugugiñe, ánhawadügü hamuga ata duna o wabiñanigu lan lídangiñe bifusun, wafayeirubei bun. Busenrügütiwa wásügürün eibu bumúanrugugiñe.<verse eid="NUM 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 20:20" />Aba lóunabuniña lurúeite Edomu:</para>
  <para style="p" vid="NUM 20:20">—Másügürünbadün!</para>
  <para style="p" vid="NUM 20:20">Aba lidin habaroun Ísüraelina hau súdara héretiña ha aransetiña, <verse eid="NUM 20:20" /><verse number="21" style="v" sid="NUM 20:21" />lun mígirunhabaña lan lun hásügürün lumúanrugugiñe. Ábati hárügüdün Ísüraelina amu üma.<verse eid="NUM 20:21" /></para>
  <para style="s1">Lounwen Aarón</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 20:22" />Aba háfuridun Ísüraelina Kadesigiñe lun luagun wübü Oru. <verse eid="NUM 20:22" /><verse number="23" style="v" sid="NUM 20:23" />Aba lariñagun Wabureme lun Moisesi luma Aarón ñein lurugabu láfadaragun Edomu:<verse eid="NUM 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 20:24" />—Lounwe Aarón, mebelubei lidoun fulasu le lunbei níchuguni houn Ísüraelina lugundun hadüraaguni le nubeibei lurugabu lísensen duna Meribá. <verse eid="NUM 20:24" /><verse number="25" style="v" sid="NUM 20:25" />Buguya Moisesi, barübei Aarón luma Eleasárü le liráü lábulugun wübü Oru; <verse eid="NUM 20:25" /><verse number="26" style="v" sid="NUM 20:26" />ábame baragachunu ladaüragun Aarón to lánina lafadirihan luéi ñein, ábame badaürünu luagu Eleasárü. Ñeinba lounwe Aarón.<verse eid="NUM 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 20:27" />Aba ladügüni Moisesi le lariñagubei Wabureme lun. Aba hamudeirun luagun wübü Oru aríagu sun Ísüraelina lun, <verse eid="NUM 20:27" /><verse number="28" style="v" sid="NUM 20:28" />aba laragachunu Moisesi daüguaü to lánina afadirihani luéi Aarón ñein, aba ladaürünu luagu Eleasárü. Ñeinmeme lounwe Aarón lábulugu wübü. <verse eid="NUM 20:28" /><verse number="29" style="v" sid="NUM 20:29" />Dan harihinbei Ísüraelina luagu hilá lan Aarón, aba hayahuahani luagu darandi weyu.<verse eid="NUM 20:29" /></para>
  <chapter eid="NUM 20" />
  <chapter number="21" style="c" sid="NUM 21" />
  <para style="s1">Lagañeirúniwa Orumá</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 21:1" />Dan laganbunbei urúei Kananna le uburuguna Aradü, le aganóubei Négebü luagu añate lan Ísüraelina luéigiñe üma Atarímü, aba láfuridun ageindagua hama, aba lárügüdün fiu hádangiñe. <verse eid="NUM 21:1" /><verse number="2" style="v" sid="NUM 21:2" />Ábati füramase hamá Ísüraelina lun Wabureme luagu ánhaña lan líderagua agañeirei ageiraü ligía, luagu hagünrinchagubei lan sun luburugute sunsuinagubei. <verse eid="NUM 21:2" /><verse number="3" style="v" sid="NUM 21:3" />Aba líchuguni Wabureme le hamuriahabei Ísüraelina luma houn, aba líderaguniña áfaraguaña Kananna, aba hagünrinchaguniña Ísüraelina Kananna sunsuinagubei, lau sun burí haburugute, ligía híchugunbei Orumá<note caller="1" style="f"><char style="fr" closed="false">21.3 </char><char style="ft" closed="false">Orumá, mini lan iri le lidan Ebüréu «fulasu günrinwaguaali».</char></note> lírime fulasu ligía.<verse eid="NUM 21:3" /></para>
  <para style="s1">Hewe to lautu buronse</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 21:4" />Aba háfuridun Ísüraelina lídangiñe wübü Oru, luéigiñe üma luagun Barana Funati, geyegueina hagía luéi hásügürün lumúanrugugiñe Edomu. Aba heferidiruni Ísüraelina haguraasun luagu héibugun, <verse eid="NUM 21:4" /><verse number="5" style="v" sid="NUM 21:5" />aba hagumeserun adimureha wuriba luagu Wabungiute luma luagu Moisesi. Hariñaga:</para>
  <para style="p" vid="NUM 21:5">—Kame san hasagarawa Ehiptugiñe? Lun san wóunwegun lidan fulasu mageirawati? Maniñetiwa duna, meigin wagía. Buchá wawagu lubá lagübüri éigini le!<verse eid="NUM 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 21:6" />Aba lóunahan Wabureme hewe péisinitiña hawagun lun hágüraguniña, aba hóunwegun saragu Ísüraelina. <verse eid="NUM 21:6" /><verse number="7" style="v" sid="NUM 21:7" />Ábati houdin lumoun Moisesi, aba hariñagun lun:</para>
  <para style="p" vid="NUM 21:7">—Afigouhaadiwa lau wadimurehan wuriba luagu Wabureme luma buagu! Bamuriaha luma Wabureme lun lagidaruniña hewe ha wawéi.</para>
  <para style="p" vid="NUM 21:7">Aba lamuriahan Moisesi luma Wabureme lun feruduna lániña Ísüraelina, <verse eid="NUM 21:7" /><verse number="8" style="v" sid="NUM 21:8" />aba lariñagun Wabureme lun:</para>
  <para style="p" vid="NUM 21:8">—Adügabá aban hewe kei ha, ábame bíchugunu luagu aban lebu fanidira. Danme tágürün hewe aban gürigia, lunti larihin tuagun hewe to luáguboun lebu fanidira, ábame lasalbarun.<verse eid="NUM 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 21:9" />Aba ladügün Moisesi aban hewe lautu buronse, aba líchugunu luagu aban lebu fanidira, dántiha le tágürün hewe aban gürigia, ábaha larihin tuagun hewe lautu buronse, aba lasalbarun.<verse eid="NUM 21:9" /></para>
  <para style="s1">Ámuya burí araramaguni</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 21:10" />Aba hasigiruni Ísüraelina haweiyasun, aba herederagun Obotu. <verse eid="NUM 21:10" /><verse number="11" style="v" sid="NUM 21:11" />Hígiragüda Obotugiñe herederagua Abarímü, lidan fulasu mageirawati, luéigiñe oubaü le ñéingiñe lubéi laboucha weyu libiti lumúan Moabü. <verse eid="NUM 21:11" /><verse number="12" style="v" sid="NUM 21:12" />Hígiragüda ñéingiñe, aba herederagun Séredü. <verse eid="NUM 21:12" /><verse number="13" style="v" sid="NUM 21:13" />Ñéingiñe hígiragüda, herederagua loubafurugu duna Arünón. Duna le, lídanñein fulasu mageirawati le agumeserubei lúmagiñe hamúanrugugiñe Amoruna, ligía láfadaragunbei lumúan Moabü luma hamúan Amoruna. <verse eid="NUM 21:13" /><verse number="14" style="v" sid="NUM 21:14" />Ligía ariñawagúbei tidan líburu to lani luwuribun Wabureme:</para>
  <para style="b" vid="NUM 21:14" />
  <para style="q" vid="NUM 21:14">«Sügütiwa Waebügiñe, lóubawagu Sufá,</para>
  <para style="q" vid="NUM 21:14">luéigiñe burí lirahüñü duna luma luéigiñe Arünón,<verse eid="NUM 21:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="NUM 21:15" />luma lárurugugiñe burí lirahüñü duna</para>
  <para style="q" vid="NUM 21:15">le achülürübei darí lóubawagu Arü,</para>
  <para style="q" vid="NUM 21:15">chülǘ lumoun láfadaragun Moabü».<verse eid="NUM 21:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="NUM 21:16" />Aba hasigirun luéigiñe duna Arünón darí Beerü. Ñeinñein fusu le ñein lubéi lariñaga Wabureme lun Moisesi:</para>
  <para style="p" vid="NUM 21:16">—Óundaraguabaña gürigia, ru náamuga duna houn.<verse eid="NUM 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 21:17" />Ligía dan ligía heremuhan Ísüraelina, hariñaga:</para>
  <para style="b" vid="NUM 21:17" />
  <para style="q" vid="NUM 21:17">«Iñuraguagüdabéi bidunari, fusu!</para>
  <para style="q" vid="NUM 21:17">Heremuha lun fusu!<verse eid="NUM 21:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="NUM 21:18" />Hachigin ábutigu lau hawewen le hagumadigüle,</para>
  <para style="q" vid="NUM 21:18">hadaarun wéirigutiña fulasurugu lau habadun!»</para>
  <para style="b" vid="NUM 21:18" />
  <para style="p" vid="NUM 21:18">Aba hasigirun Ísüraelina lídangiñe fulasu mageirawati darí Mataná; <verse eid="NUM 21:18" /><verse number="19" style="v" sid="NUM 21:19" />Matanágiñe lun Naalielin, Naalieligiñe lun Bamotün, <verse eid="NUM 21:19" /><verse number="20" style="v" sid="NUM 21:20" />Bamotügiñe lun luagun fulasu wayati le lumúanrugubei Moabü, iñun libiti Pisügá, le ñéingiñe lubéi larihúa fulasu mageirawati.<verse eid="NUM 21:20" /></para>
  <para style="s1">Hagañeiruni Ísüraelina urúei Sihón</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 21:21" />Aba hóunahan Ísüraelina fiu wügüriña ariñaga lun Sihón le harúeite Amoruna:<verse eid="NUM 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 21:22" />—Busentiwa hamuga wásügürün bumúanrugugiñe. Mebelubadiwa lidoun ichari le bunawaguaalibei, ni le ñein tumuti beibei-agei, matun wagíame duna lídangiñe bifusun, wánhiñuragubei bumúan luéigiñe üma le ñéingiñe lubéi leibugúa.<verse eid="NUM 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 21:23" />Gama lumoun máhati Sihón lun hásügürün Ísüraelina lumúanrugugiñe, aba lóundaruniña sun lumutuniña, aba láfuridun habaroun Ísüraelina lidan fulasu mageirawati, dan hachülürünbei Haasü aba lábürühan hawagun. <verse eid="NUM 21:23" /><verse number="24" style="v" sid="NUM 21:24" />Gama lumoun aba hageindagun Ísüraelina luma aba hagañeiruni wuribu, aba hárügüdüni hamúan lúmagiñe duna Arünón darí lumoun duna Haboku, lememe fadaguaü luma hamúan Amonna, le baríeiruabei lau dübü. <verse eid="NUM 21:24" /><verse number="25" style="v" sid="NUM 21:25" />Aba lubeiti hárügüdüni Ísüraelina sun haburugute Amoruna ligía, lememe Esübón lau sun burí fulasu le lani, aba herederun aganawa ñein. <verse eid="NUM 21:25" /><verse number="26" style="v" sid="NUM 21:26" />Esübón, ligía bugaha uburugu le ñein lubéi laganawa Sihón le harúeite Amoruna. Lageindaguañahañati Sihón luma binadu lurúeite Moabü, aba lagidaruni sun fulasu ligía luéi darí lumoun duna Arünón. <verse eid="NUM 21:26" /><verse number="27" style="v" sid="NUM 21:27" />Ligía hariñagunbei poetagu:</para>
  <para style="b" vid="NUM 21:27" />
  <para style="q" vid="NUM 21:27">«Higougu lun Esübón,</para>
  <para style="q" vid="NUM 21:27">uburugu le ñéingiñe lubéi lagumadiha urúei Sihón!</para>
  <para style="q" vid="NUM 21:27">Bunaguaya huméi, héregüdaya huméi!<verse eid="NUM 21:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="NUM 21:28" />Lúmagiñe Esübóngiñe, le luburugute Sihón,</para>
  <para style="q" vid="NUM 21:28">furiti watu lídangiñe aban gudáü,</para>
  <para style="q" vid="NUM 21:28">le agünrinchagubalin Arü le lani Moabü</para>
  <para style="q" vid="NUM 21:28">luma burí fulasu íñuti le lani Arünón.<verse eid="NUM 21:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="NUM 21:29" />Fugiabu buguya, Moabü!</para>
  <para style="q" vid="NUM 21:29">Féridihadibu, buguya le lánigu bungiu le Kemosu!</para>
  <para style="q" vid="NUM 21:29">Ígira laaña buwügüriñanigu lun hanurahan,</para>
  <para style="q" vid="NUM 21:29">luma lun hábürühan würiña labun lubafu urúei Sihón.<verse eid="NUM 21:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="NUM 21:30" />Günrinwagua lubafu Esübón;</para>
  <para style="q" vid="NUM 21:30">günrinwaguati lúmagiñe Diboungiñe darí Nofa,</para>
  <para style="q" vid="NUM 21:30">chülüti gudáü darí Medebá».<verse eid="NUM 21:30" /></para>
  <para style="s1">Hagañeiruni Ísüraelina Ogu, le lurúeite Basán</para>
  <para style="r">(<ref loc="DEU 3:1-11">2 Lur 3.1-11</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 21:31" />Ítara liña lubeiti, aba hárügüdüni Ísüraelina hamúan Amoruna. <verse eid="NUM 21:31" /><verse number="32" style="v" sid="NUM 21:32" />Óunahati giñe Moisesi fiu wügüriña aríaahei ida liña lan ligaburi fulasu le Haserü, aba hárügüdüni Ísüraelina uburugu burí le yarafabei, bugá hamaña Amoruna ha aganóubaña ñein. <verse eid="NUM 21:32" /><verse number="33" style="v" sid="NUM 21:33" />Lárigiñe aba hagiribudun luagun Basán, gama lumoun aba láfuridun Ogu le lurúeite Basán hau sun lumutuniña ageindagua hama uburugu Edüréi. <verse eid="NUM 21:33" /><verse number="34" style="v" sid="NUM 21:34" />Ábati lariñagun Wabureme lun Moisesi:</para>
  <para style="p" vid="NUM 21:34">—Manufudedabá luéi, níchugubei búhaburugun hau sun lumutuniña luma lageira, ábame badügün lun kei badüga lun Sihón le urúei Amoruna le buga aganóubei Esübón.<verse eid="NUM 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 21:35" />Ítara liña háfaruni Ísüraelina Ogu hilagubei hau sun lirahüñü hama lumutuniña. Mígiruntiña ni aban wínwanñu, aba herederun lau hamúan.<verse eid="NUM 21:35" /></para>
  <chapter eid="NUM 21" />
  <chapter number="22" style="c" sid="NUM 22" />
  <para style="ms">III. Unsu Hati Moabü, Luéigiñe Nodisi Libiti Barana Hilaali</para>
  <para style="mr">(<ref loc="NUM 22:1-36:13">22.1—36.13</ref>)</para>
  <para style="s1">Lóunahan Balakü agúara lun Balaamü</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 22:1" />Aba hasigiruni Ísüraelina haweiyasun aba herederagun lidan fulasu mawübüriti le gíribei Moabü, luéigiñe oubaü le ñéingiñe lubéi laboucha weyu libiti duna Hordán, ligibugiñe Herikó.<verse eid="NUM 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 22:2" />Ariha lumuti Balakü le liráü Siporu le hadügübei Ísüraelina houn Amoruna. <verse eid="NUM 22:2" /><verse number="3" style="v" sid="NUM 22:3" />Aba giñe hanufudedun lílana Moabü lau harihini hiibe Ísüraelina. <verse eid="NUM 22:3" /><verse number="4" style="v" sid="NUM 22:4" />Ábati hariñagun lílana Moabü houn ábutigu ha Madianbaña:</para>
  <para style="p" vid="NUM 22:4">—Hagumuchubei sun gürigia ha wamúan kei hagumuchuni bágasu sagadi áraabu.</para>
  <para style="p" vid="NUM 22:4">Lidoun dan ligía, Balakü lurúeitebei Moabü, <verse eid="NUM 22:4" /><verse number="5" style="v" sid="NUM 22:5" />aba lóunahan luagu Balaamü le liráü Beoru dan le Petoruñein lubéi lurugabu duna Éufüratesi lageira Amabü. Aba lariñagun Balakü houn lóunagülegu lun hariñagun lun Balaamü: «Añahein bürübünu gürigia ñǘbuintiña Ehiptugiñe, añahein ya lidan sun ageiraü, guentó, nigibugiñe haganawa. <verse eid="NUM 22:5" /><verse number="6" style="v" sid="NUM 22:6" />Ñǘbuinba furese íñaragua báamugaña nun, lugundun héretiña wawéi. Fagua ítara luba gayara lan nasagaruniña fulasurugugiñe. Subudi numuti luagu súnwandan lan lagunfulirun babinihan luma bíñaragun».<verse eid="NUM 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 22:7" />Aba houdin ábutigu lílana Moabü hama lílana Madián lau seinsu háhaburugu lun hafayeiruni lebegi íñarawaguni, dan hachülürün le ñein lubéi Balaamü, aba híchuguni luganute Balakü lun. <verse eid="NUM 22:7" /><verse number="8" style="v" sid="NUM 22:8" />Lariñaga Balaamü houn:</para>
  <para style="p" vid="NUM 22:8">—Redei humá ya áriebu to, nóunabubadün según le lariñagun Wabureme nun.</para>
  <para style="p" vid="NUM 22:8">Aba herederun ábutigu hagía luma áriebu ligía. <verse eid="NUM 22:8" /><verse number="9" style="v" sid="NUM 22:9" />Gama lumoun aba lasaliragun Wabungiute lun Balaamü, aba lálügüdüni, lariñaga lun:</para>
  <para style="p" vid="NUM 22:9">—Kátaña san wügüriña ha, ha búmabaña?<verse eid="NUM 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 22:10" />Lariñaga Balaamü lun:</para>
  <para style="p" vid="NUM 22:10">—Lóunahan Balakü le liráü Siporu, le lurúeite Moabü lun nege hariñagun nun <verse eid="NUM 22:10" /><verse number="11" style="v" sid="NUM 22:11" />luagu añahein lan bürübünu gürigia áfuridutiña Ehiptugiñe, luagu añahein lan lidan sun lageira. Busentiti Balakü lun nege nidin lun níñaraguniña gürigia hagía, fagua nege gayara lan lasagaruniña lumúanrugugiñe.<verse eid="NUM 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 22:12" />Ábati lariñagun Wabungiute lun Balaamü:</para>
  <para style="p" vid="NUM 22:12">—Mídinba hama, míñaraguabaña giñe gürigia hagía, lugundun biní naaña gürigia hagía.<verse eid="NUM 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 22:13" />Larugan aba lásaarun Balaamü, aba lariñagun houn lóunagülegu Balakü:</para>
  <para style="p" vid="NUM 22:13">—Giribu humá hageiroun. Máhati Wabureme lun nidin huma.<verse eid="NUM 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 22:14" />Aba hagiribudun ábutigu Moábüna le ñeinhin lubéi Balakü, aba hariñagun lun:</para>
  <para style="p" vid="NUM 22:14">—Máhati Balaamü liabin wama.<verse eid="NUM 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 22:15" />Ábaya lóunahan Balakü amu ábutigu, gíbetimatiña ani íñugutimatiña sügǘ hau ha lóunahabaña furumiñe. <verse eid="NUM 22:15" /><verse number="16" style="v" sid="NUM 22:16" />Aba houdin lumoun Balaamü, aba hariñagun lun:</para>
  <para style="p" vid="NUM 22:16">—Lóunahaña Balakü le liráü Siporu ariñaga bun: “Mamaharabá biabin nun. <verse eid="NUM 22:16" /><verse number="17" style="v" sid="NUM 22:17" />Níchugubei luéirin-agei uéiriguni bun, nadügübei sun le bamuriahan numa bun, gama lumoun adügabá fulesei nun, ñǘbuinba íñaraguaña gürigia ha nun”.<verse eid="NUM 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 22:18" />Gama lumoun lariñaga Balaamü houn:</para>
  <para style="p" vid="NUM 22:18">—Ni anhein líchiga Balakü sun golu luma pülata le gabarabei tidan lani palasiu, siñabei nadüraaguni le lubeibei Wabureme le Nubungiute ni lidan katei wéiriti ni lidan ñǘraüti. <verse eid="NUM 22:18" /><verse number="19" style="v" sid="NUM 22:19" />Gama lumoun rédeiya humá ya áriebu to, ariha náamugei kaba lan lariñaga Wabureme nun.<verse eid="NUM 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 22:20" />Áriebu, aba lasaliragun Wabungiute lun Balaamü, lariñaga lun:</para>
  <para style="p" vid="NUM 22:20">—Anhein hayabiña lubéi wügüriña ha buagu, saraba, beiba hama, gama lumoun lérügüba nariñagun bun badüga.<verse eid="NUM 22:20" /></para>
  <para style="s1">Ladunragun Balaamü luma lani Wabureme ánheli</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 22:21" />Larugan, aba lásaarun Balaamü, aba laranserunu lilügün burigü aba lidin hama ábutigu Moábüna. <verse eid="NUM 22:21" /><verse number="22" style="v" sid="NUM 22:22" />Wariñu liña lidin Balaamü tuagu lilügün burigü hau bián lumusun úara luma.</para>
  <para style="p" vid="NUM 22:22">Gama lumoun aba lagañidun Wabungiute luma ladüga lidin, aba leberesehan lani Wabureme ánheli lémerirugu lun ladouruni üma luéi. <verse eid="NUM 22:22" /><verse number="23" style="v" sid="NUM 22:23" />Dan tarihinbei burigü luagu aniha lan lani Wabureme ánheli lamidangua üma tau aban eféin lúhaburugu, aba tegeyedun, aba tárügüdün amu üma; aba labeichunu Balaamü lun tagiribudun luagun üma. <verse eid="NUM 22:23" /><verse number="24" style="v" sid="NUM 22:24" />Lárigiñe aba lararamun lani Wabureme ánheli lidan aban üma bürüraüti tabadinagua beibei-agei lau baríeiru lauti dübü luéigiñe biángubei louba. <verse eid="NUM 22:24" /><verse number="25" style="v" sid="NUM 22:25" />Dan tarihinbalin burigü lani Wabureme ánheli, aba tabalachun luagu aban lídangiñe louba üma, aba lámurudun lúruna Balaamü. Ábayati lagayuahan Balaamü tuagu. <verse eid="NUM 22:25" /><verse number="26" style="v" sid="NUM 22:26" />Gama lumoun aba lidin lani Wabureme ánheli habá, aba lararamun lidan aban üma bürüraütimati le ñein lubéi siñá lan legeyedun luagun ni aban oubaü. <verse eid="NUM 22:26" /><verse number="27" style="v" sid="NUM 22:27" />Dan tarihinbalin burigü lani Wabureme ánheli, aba tarounrun múarugu. Ábati lagañidun Balaamü, aba labeichunu lau aban wewe. <verse eid="NUM 22:27" /><verse number="28" style="v" sid="NUM 22:28" />Lidan oura ligía aba ladimuregüdünu Wabureme burigü, aba tariñagun lun Balaamü:</para>
  <para style="p" vid="NUM 22:28">—Ka san nadügübei bun? Anihántia lǘrüwan babeichunina.<verse eid="NUM 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 22:29" />Lariñaga Balaamü tun:</para>
  <para style="p" vid="NUM 22:29">—Badügüña bula nau. Lun hamuga anuhein lan aban gusiñu numa guentó, náfaraadibu yebe hilagubei.<verse eid="NUM 22:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 22:30" />Tariñaga burigü lun:</para>
  <para style="p" vid="NUM 22:30">—Nuguya bilügünboun burigü to baweiruboun súnwandan, ani subudi bumuti luagu madügünñaha nágili lan le bun.</para>
  <para style="p" vid="NUM 22:30">—Lariñaga Balaamü tun: Binarün.<verse eid="NUM 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 22:31" />Ábati larufudagun lani Wabureme ánheli lungua lun Balaamü rara luagu üma tau aban eféin lúhaburugu. Aba labuluchagun Balaamü darí ladagarun lerebe múarugu. <verse eid="NUM 22:31" /><verse number="32" style="v" sid="NUM 22:32" />Gama lumoun aba lariñagun lani Wabureme ánheli lun:</para>
  <para style="p" vid="NUM 22:32">—Ka san uagu babeichoun bilügün burigü ǘrüwa wéiyaasu? Au mígirunbei lun básügürün ladüga magundantina lau buéiyasun. <verse eid="NUM 22:32" /><verse number="33" style="v" sid="NUM 22:33" />Aba tarihinina burigü, aba tegeyedun nuéi ǘrüwagubei wéiyaasu. Lun hamuga megeyetu nuéi áfara náadibu hamuga hilagubei ígira tuguya wínwanñu.<verse eid="NUM 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 22:34" />Aba lariñagun Balaamü lun lani Wabureme ánheli:</para>
  <para style="p" vid="NUM 22:34">—Afigouhaadina, ladüga ibidiñeti yebe nun luagu buguya lan eredehabalin némeri. Anhein mabusenrun bubéi nidin, nagiribudagubei.<verse eid="NUM 22:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 22:35" />Lariñaga lani Wabureme ánheli lun:</para>
  <para style="p" vid="NUM 22:35">—Gayaraati bidin hama wügüriña ha, gama lumoun lérügüba nariñagun bun, bariñaga.</para>
  <para style="s1" vid="NUM 22:35">Leresibiruni Balakü Balaamü</para>
  <para style="p" vid="NUM 22:35">Aba lidin Balaamü hama ábutigu ha lóunahabaña Balakü, <verse eid="NUM 22:35" /><verse number="36" style="v" sid="NUM 22:36" />dan lasubudirunbalin Balakü luagu anite lan Balaamü, aba lidin eresibirei lidan aban luburugute Moabü, lurugabu duna Arünón lidan láfadaragun fulasu, <verse eid="NUM 22:36" /><verse number="37" style="v" sid="NUM 22:37" />aba lariñagun lun:</para>
  <para style="p" vid="NUM 22:37">—Gíbeeli nóunahan buagu; ka yebe san uagu miábinbubei? Haritaguatibu yebe san luagu mafayeirun nubadibu lan buidu?<verse eid="NUM 22:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 22:38" />Aba lóunabun Balaamü:</para>
  <para style="p" vid="NUM 22:38">—Anahán, ñǘbuinhadina arihabu. Gama lumoun mabafutina lun nadimurehan luagu nani nungua; lérügübei lasubudiragüdün Wabungiute nun gayara nariñagun.<verse eid="NUM 22:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 22:39" />Ábati lidin Balaamü luma Balakü Usotün, <verse eid="NUM 22:39" /><verse number="40" style="v" sid="NUM 22:40" />ñein lubéi láfaragüda Balakü fiu bágasu hama mudún, lun hanügüniña lun Balaamü luma houn ábutigu ha ñǘbuinbaña luma.<verse eid="NUM 22:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 22:41" />Larugan binaafin aba láluahani Balakü Balaamü, aba lamudeiragüdüni uburugun Bamotü, le ñéingiñe lubéi lariha geyegua tau hakianpun-agei Ísüraelina.<verse eid="NUM 22:41" /></para>
  <chapter eid="NUM 22" />
  <chapter number="23" style="c" sid="NUM 23" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 23:1" />Ábati lariñagun Balaamü lun Balakü:</para>
  <para style="p" vid="NUM 23:1">—Adügabá sedü latarü nun ya, aranse buguyame sedü bágasu ñǘbürigiña ha wügüriña hama sedü mudún.<verse eid="NUM 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 23:2" />Aba ladügüni Balakü le lubeibei Balaamü lun, aba ladagaragüdün aban bágasu luma aban mudún luagu kada latarü. <verse eid="NUM 23:2" /><verse number="3" style="v" sid="NUM 23:3" />Lárigiñe aba lariñagun Balaamü lun Balakü:</para>
  <para style="p" vid="NUM 23:3">—Rédeiba lurugabu adagaragüdüni lubarügü nidin ariha anhein ñübuin Wabureme adunragua numa. Ábame nasubudiragüdüni bun ka lan lariñagubei nun.</para>
  <para style="s1" vid="NUM 23:3">Labiniruniña Balaamü Ísüraelina</para>
  <para style="p" vid="NUM 23:3">Aba lidin Balaamü luagun aban wübü le ñein lubéi málouga lan, <verse eid="NUM 23:3" /><verse number="4" style="v" sid="NUM 23:4" />le ñein lubéi larufudagua Wabungiute lungua lun. Aba lariñagun Balaamü lun:</para>
  <para style="p" vid="NUM 23:4">—Aransedina sedü latarü, dagagüda au aban bágasu wügüri le ñǘraügili luma aban mudún luagu kada aban.<verse eid="NUM 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 23:5" />Ábati líchuguni Wabureme le lunbei lariñaguni Balaamü liyumulugun, lariñaga lun:</para>
  <para style="p" vid="NUM 23:5">—Giribubá le ñeinhin lubéi Balakü, bariñageime lememe nariñagubei bun lun.<verse eid="NUM 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 23:6" />Aba lagiribudun Balaamü, aba ladariruni Balakü rara lurugabu adagaragüdüni hama sun ábutigu Moábüna. <verse eid="NUM 23:6" /><verse number="7" style="v" sid="NUM 23:7" />Ábati lariñaguni Balaamü profesía le:</para>
  <para style="b" vid="NUM 23:7" />
  <para style="q" vid="NUM 23:7">«Lúmagiñe burí áraabu</para>
  <para style="q" vid="NUM 23:7">le luéigiñebei oubaü le ñéingiñe lubéi laboucha weyu,</para>
  <para style="q" vid="NUM 23:7">lúmagiñe Aramügiñe liábingüdana urúei Balakü, lurúeite Moabü.</para>
  <para style="q" vid="NUM 23:7">“Higabu —liña lariñagun nun—, íñaraguabaña Ísüraelina nun,</para>
  <para style="q" vid="NUM 23:7">bayumaha wuribati houn lumutuniña Hakobu”.<verse eid="NUM 23:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NUM 23:8" />Gama lumoun, ida lubagia níñaraguniña ha míñaragun lubaña Wabungiute?</para>
  <para style="q" vid="NUM 23:8">Ida luba nabusenrun wuribati houn anhein madügün lubalin Wabureme?<verse eid="NUM 23:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NUM 23:9" />Aríagu niña houn luéigiñe liñun burí wübü le,</para>
  <para style="q" vid="NUM 23:9">luéigiñe burí wübü le narihaña:</para>
  <para style="q" vid="NUM 23:9">Hóunguañanu gürigia ha,</para>
  <para style="q" vid="NUM 23:9">mítarantiña kei ha híbiri gürigia.<verse eid="NUM 23:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="NUM 23:10" />Gíbetiña kei kaliki;</para>
  <para style="q" vid="NUM 23:10">saragu haña darí lun siñá lan habahüdǘniwa.</para>
  <para style="q" vid="NUM 23:10">Gúndaatina hamuga lun nounwen kei lirahüñü Bungiu,</para>
  <para style="q" vid="NUM 23:10">lun hamuga ítara lan nagumuchun kei gürigia richaguatiña!»<verse eid="NUM 23:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="NUM 23:11" />Ábati lariñagun Balakü lun Balaamü:</para>
  <para style="p" vid="NUM 23:11">—Ka san badügübei? Luntia bíñaraguniña náganiñu nanügabu, abunha lubéi abiniraña!<verse eid="NUM 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 23:12" />Aba lóunabun Balaamü:</para>
  <para style="p" vid="NUM 23:12">—Ariñagatinatia bun luagu lérügüba lan líchugun Wabureme niyumulugun lun nariñaguni nariñaga.<verse eid="NUM 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 23:13" />Gama lumoun aba lariñagun Balakü lun:</para>
  <para style="p" vid="NUM 23:13">—Keimoun numa lidoun amu fulasu, le ñéingiñe lubéi marihin bubóun lan kianpu-agei luéidigia tibürürün. Bíñaraguañame nun ñéingiñe.<verse eid="NUM 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 23:14" />Aba lanügüni Balakü Balaamü áraabun Sofimü, lábulugu wübü Pisügá, le ñein lubéi ladüga sedü latarü aba ladagaragüdün aban bágasu wügüri le ñǘraügili luma aban mudún luagu kada latarü. <verse eid="NUM 23:14" /><verse number="15" style="v" sid="NUM 23:15" />Aba lariñagun Balaamü lun Balakü ñein:</para>
  <para style="p" vid="NUM 23:15">—Rédeiba ya lubadu adagaragüdüni, néibuga adunragua luma Bungiu.<verse eid="NUM 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 23:16" />Aba liabin Wabureme lubaroun Balaamü, aba líchuguni le lunbei lariñaguni liyumulugun. Aba giñe lariñagun lun:</para>
  <para style="p" vid="NUM 23:16">—Giribubá le ñeinhin lubéi Balakü, bariñageime lememe nariñagubei bun lun.<verse eid="NUM 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 23:17" />Aba lagiribudun Balaamü aba ladariruni Balakü rara lubadu adagaragüdüni, hau sun ábutigu Moábüna. Aba lálügüdüni Balakü, lariñaga lun:</para>
  <para style="p" vid="NUM 23:17">—Kagia lariñagubei Bungiu bun?<verse eid="NUM 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 23:18" />Ábati lariñaguni Balaamü profesía le:</para>
  <para style="b" vid="NUM 23:18" />
  <para style="q" vid="NUM 23:18">«Balakü, liráü Siporu, aganbabána buidu.<verse eid="NUM 23:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="NUM 23:19" />Mítaranti Bungiu kei ha góunwedadibaña:</para>
  <para style="q" vid="NUM 23:19">Meyeehan liña masansiragun laritagun.</para>
  <para style="q" vid="NUM 23:19">Dan le lariñagun aban katei, adüga lumuti.</para>
  <para style="q" vid="NUM 23:19">Dan le ladügün aban füramasei, gúnfuli lumuti.<verse eid="NUM 23:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="NUM 23:20" />Ariñagaali Bungiu nun lun nabinihan;</para>
  <para style="q" vid="NUM 23:20">anhein abiniha Wabureme siñati nadüraaguni.<verse eid="NUM 23:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="NUM 23:21" />Úagili ni aban arihiti marasualugu ni wuribani</para>
  <para style="q" vid="NUM 23:21">hadan Ísüraelina lumutuniña Hakobu.</para>
  <para style="q" vid="NUM 23:21">Anihein Aburemei le Habungiute hama,</para>
  <para style="q" vid="NUM 23:21">ani agúarahatiña luagu keisi urúei.<verse eid="NUM 23:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="NUM 23:22" />Habungiute le asagarubaliña Ehiptugiñe,</para>
  <para style="q" vid="NUM 23:22">ítara liña houn kéisigubeirügü liganchun bulu bágasu lun lúgubu.<verse eid="NUM 23:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="NUM 23:23" />Mabaleti abiñarawaguni luagu Hakobu,</para>
  <para style="q" vid="NUM 23:23">meseriwínti abiñarahani luagu Ísüraeli.</para>
  <para style="q" vid="NUM 23:23">Guentoti lunti wariñagun houn Ísüraelina:</para>
  <para style="q" vid="NUM 23:23">“Saraguhali katei buíduburiti ladügün Wabungiute hau!”<verse eid="NUM 23:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="NUM 23:24" />Liñuraguña ageiraü le lungua keisi aban liñun gáñiti,</para>
  <para style="q" vid="NUM 23:24">ani memeraagunbei darime lagünrinchaguni líliru</para>
  <para style="q" vid="NUM 23:24">guraléime hata ha láfaragun».<verse eid="NUM 23:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="NUM 23:25" />Ábati lariñagun Balakü lun Balaamü:</para>
  <para style="p" vid="NUM 23:25">—Kei siñá lubéi bíñaraguniña gürigia ha, mabinirabaña giñe!<verse eid="NUM 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 23:26" />Lariñaga Balaamü lun:</para>
  <para style="p" vid="NUM 23:26">—Ma san ariñagaadina buga bun, luagu lérügüba lan líchugun Wabureme niyumulugu nariñaga?<verse eid="NUM 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 23:27" />Ábati lariñagun Balakü lun:</para>
  <para style="p" vid="NUM 23:27">—Higabu, nanügaadibu lidoun amu fulasu. Háfuga gúndaabei Wabungiute lun bíñaraguniña Ísüraelina lúmagiñe ñéingiñe.<verse eid="NUM 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 23:28" />Ábati lanügüni Balakü Balaamü lábulugun wübü Peoru, le ñéingiñe lubéi larihúa sun fulasu mageirawati. <verse eid="NUM 23:28" /><verse number="29" style="v" sid="NUM 23:29" />Ñein lariñaga Balaamü lun Balakü:</para>
  <para style="p" vid="NUM 23:29">—Adügabá sedü latarü nun ya, aranse buguyame sedü bágasu wügüriña ha ñǘbürigiña hama sedü mudún.<verse eid="NUM 23:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 23:30" />Aba ladügüni Balakü le lubeibei Balaamü lun, aba ladagaragüdün aban bágasu luma aban mudún luagu kada latarü.<verse eid="NUM 23:30" /></para>
  <chapter eid="NUM 23" />
  <chapter number="24" style="c" sid="NUM 24" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 24:1" />Gama lumoun kei larihin Balaamü luagu gunda lan Wabureme lau labiniruniña Ísüraelina, mídinhali buga aganba kaba lan lariñaga Wabureme lun kei ladüga furumiñe, digiguarügüti ariha lidoun fulasu mageirawati. <verse eid="NUM 24:1" /><verse number="2" style="v" sid="NUM 24:2" />Ani lídanbei larihiniña Balaamü Ísüraelina kada türibu tidan hakianpun-agei, aba lebelurun lani Wabungiute sífiri lidoun, <verse eid="NUM 24:2" /><verse number="3" style="v" sid="NUM 24:3" />ábati lariñagun Balaamü:</para>
  <para style="b" vid="NUM 24:3" />
  <para style="q" vid="NUM 24:3">«Uganu lúmagiñeti Balaamü, liráü Beoru,</para>
  <para style="q" vid="NUM 24:3">wügüri le hulilibei arihin,<verse eid="NUM 24:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NUM 24:4" />lidan larihin aban katei tau luani küleritimati larihini,</para>
  <para style="q" vid="NUM 24:4">le ibihubei uganu luma burí arihini</para>
  <para style="q" vid="NUM 24:4">lúmagiñe Wabungiute le Suntigabafu.<verse eid="NUM 24:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="NUM 24:5" />Hakobu, tuenden burí bikianpun!</para>
  <para style="q" vid="NUM 24:5">Ísüraeli, tuenden burí sun bikianpun-agei!<verse eid="NUM 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="NUM 24:6" />Ítara tiña kei tafileihan tídibu yaraüwa,</para>
  <para style="q" vid="NUM 24:6">kei fuluri-agei laru duna,</para>
  <para style="q" vid="NUM 24:6">kei tídibu burí wewe hémetu to lábunagun Wabureme,</para>
  <para style="q" vid="NUM 24:6">odi kei hibúari burí laru duna.<verse eid="NUM 24:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="NUM 24:7" />Gadunaribaña Ísüraelina saragu lun hatun</para>
  <para style="q" vid="NUM 24:7">luma lun háturaguni hanadürigu.</para>
  <para style="q" vid="NUM 24:7">Gabafutimabei harúeite sügǘ lau urúei Agagü;</para>
  <para style="q" vid="NUM 24:7">ani laganbahóuba luagu larúeihan.<verse eid="NUM 24:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NUM 24:8" />Wabungiute le asagarubaliña Ehiptugiñe,</para>
  <para style="q" vid="NUM 24:8">ítara liña houn kéisigubeirügü liganchun bulu bágasu lun.</para>
  <para style="q" vid="NUM 24:8">Hagünrinchagubaña Ísüraelina néchanigu ha háganiñu;</para>
  <para style="q" vid="NUM 24:8">háhalahabei habu, ímiraha hamañame tau hagimaran.<verse eid="NUM 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 24:9" />Lidan le larounrun emeraagua,</para>
  <para style="q" vid="NUM 24:9">ítara liña kei aban liñún:</para>
  <para style="q" vid="NUM 24:9">Úati ni aban agagudahati.</para>
  <para style="q" vid="NUM 24:9">Biniwalá le abinirutibu,</para>
  <para style="q" vid="NUM 24:9">íñarawaguala le íñaragutibu!»<verse eid="NUM 24:9" /></para>
  <para style="s1">Lani Balaamü profesía</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 24:10" />Dan laganbunbalin Balakü katei le, aba lagañidun saragu lun Balaamü, aba láfarahani lúhabu luougua, lariñaga:</para>
  <para style="p" vid="NUM 24:10">—Lun bíñaraguniña náganiñu nagúaragüda buagu, gama lumoun ǘrüwaali wéiyaasu babiniruniña. <verse eid="NUM 24:10" /><verse number="11" style="v" sid="NUM 24:11" />Buítimati bun lun bagiribudun búbiñoun! Ariñagatina yebe luagu nafayeirubadibu lan buidu, gama lumoun máhati Bungiu lun ítara luba lan.<verse eid="NUM 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 24:12" />Lariñaga Balaamü lun:</para>
  <para style="p" vid="NUM 24:12">—Ariñaga numutitia houn bóunagülegu <verse eid="NUM 24:12" /><verse number="13" style="v" sid="NUM 24:13" />luagu ni lan anhein bíchiga sun golu luma sun pülata le gabarabei tidan bani palasiu nun, siñabei lan nadüraaguni le lariñagubei Aburemei ni lun nadügün katei buiti ni wuribati lau nani nungua, luagu lérügüba lan lariñagun Aburemei nun lun nariñaguni nariñaga. <verse eid="NUM 24:13" /><verse number="14" style="v" sid="NUM 24:14" />Keiti ítara liña lubéi, nagiribuda nageiroun; gama lumoun lubaragiñe lira, nariñagaali bun le lunbei hadügüni gürigia ha hau bumutuniña.<verse eid="NUM 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 24:15" />Ábati lariñaguni Balaamü profesía le:</para>
  <para style="b" vid="NUM 24:15" />
  <para style="q" vid="NUM 24:15">«Uganu lúmagiñeti Balaamü, liráü Beoru,</para>
  <para style="q" vid="NUM 24:15">wügüri le hulilibei arihin,<verse eid="NUM 24:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="NUM 24:16" />lidan larihin aban katei tau luani küleritimati larihini,</para>
  <para style="q" vid="NUM 24:16">le subudihabúbei lun le lasubudirubei Wabungiute le íñutimabei,</para>
  <para style="q" vid="NUM 24:16">le eresibirubei uganu</para>
  <para style="q" vid="NUM 24:16">luma burí arihini lúmagiñe Bungiu le Suntigabafu.<verse eid="NUM 24:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="NUM 24:17" />Arihatina somu katei lidan dan le machülügilibei,</para>
  <para style="q" vid="NUM 24:17">arihatina somu katei dise yágüta:</para>
  <para style="q" vid="NUM 24:17">Aban waruguma áfurida Hakobugiñe,</para>
  <para style="q" vid="NUM 24:17">aban urúei iñuraguti lungua Ísüraeli.</para>
  <para style="q" vid="NUM 24:17">Lachuinrubei lábulugu Moabü,</para>
  <para style="q" vid="NUM 24:17">laburechagubaña sun ladügawagun Setü.<verse eid="NUM 24:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="NUM 24:18" />Lagañeirubei Edomu,</para>
  <para style="q" vid="NUM 24:18">lárügüdübei Seirü, le láganibei.</para>
  <para style="q" vid="NUM 24:18">Ladügüba Ísüraeli katei le burí wéiriguti.<verse eid="NUM 24:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="NUM 24:19" />Láfuriduba aban agañeiruti Hakobugiñe,</para>
  <para style="q" vid="NUM 24:19">ábame lagünrinchaguniña ha erederutiña uburugu».<verse eid="NUM 24:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="NUM 24:20" />Lárigiñe aba larihini Balaamü Amalékü, aba lariñaguni burí profesía le:</para>
  <para style="b" vid="NUM 24:20" />
  <para style="q" vid="NUM 24:20">«Aban néchani wéiriguti Amalékü,</para>
  <para style="q" vid="NUM 24:20">gama lumoun lagünrinchawaguba sunsuinagubei».<verse eid="NUM 24:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21-22" style="v" sid="NUM 24:21-22" />Aba giñe larihiniña ladügawagun Kaín, aba lariñagun:</para>
  <para style="b" vid="NUM 24:21-22" />
  <para style="q" vid="NUM 24:21-22">«Ladügawagun Kaín:</para>
  <para style="q" vid="NUM 24:21-22">Íbini derebugu lan haramudaguagüle,</para>
  <para style="q" vid="NUM 24:21-22">lau sun híchuguni humasa labadinagua dübü,</para>
  <para style="q" vid="NUM 24:21-22">lágudubei watu gemeti umasaü ligía,</para>
  <para style="q" vid="NUM 24:21-22">danme lanügünün Asiria adaüra».<verse eid="NUM 24:21-22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="NUM 24:23" />Lárigiñe aba lariñaguni burí profesía le:</para>
  <para style="b" vid="NUM 24:23" />
  <para style="q" vid="NUM 24:23">«Fugiabugume ha lúnbaña hawinwandun</para>
  <para style="q" vid="NUM 24:23">danme ladügüni Wabungiute katei le.<verse eid="NUM 24:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="NUM 24:24" />Anute ugunei lóubawagugiñe Chípüre,</para>
  <para style="q" vid="NUM 24:24">hagünrinchaguaali Asiria luma Éberü,</para>
  <para style="q" vid="NUM 24:24">ladüga lagünrinchawaguba giñe Éberü».<verse eid="NUM 24:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="NUM 24:25" />Lárigiñe lira, aba lagiribudun Balaamü lúbiñoun. Aba giñe lidin Balakü.<verse eid="NUM 24:25" /></para>
  <chapter eid="NUM 24" />
  <chapter number="25" style="c" sid="NUM 25" />
  <para style="s1">Háhuduragun Ísüraelina lun Baali-peoru</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 25:1" />Lárigiñe hadügün Ísüraelina hábiñe Sitimü, aba hagumeserun wügüriña agadeiragua lau hádaragun houngua hamoun würiña Moábüna, <verse eid="NUM 25:1" /><verse number="2" style="v" sid="NUM 25:2" />ábaha hagunbirahaniña würiña hagía lun houdin hama lidan hadagaragüdün houn habungiutegu. Aba burí heigin Ísüraelina lídangiñe hadagaragüdün Moábüna, hudugua hagía houn habungiutegu, <verse eid="NUM 25:2" /><verse number="3" style="v" sid="NUM 25:3" />ítara liña hígiraguagüdün houngua lun háhuduragun lun Baali-peoru. Ábati lagañidun Wabureme houn Ísüraelina, <verse eid="NUM 25:3" /><verse number="4" style="v" sid="NUM 25:4" />aba lariñagun lun Moisesi:</para>
  <para style="p" vid="NUM 25:4">—Óundaraguabaña sun ábutigu fulasurugu, ábame báfaraguniña niñúarü wéyuagu. Ítara luba lagalumadun nigañi houn Ísüraelina.<verse eid="NUM 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 25:5" />Ábati lariñagun Moisesi houn aguseragüdütiña Ísüraelina:</para>
  <para style="p" vid="NUM 25:5">—Kada aban hídangiñe gasu láfaraguniña lílana lani türibu ha áhuduragubaña lun Baali-peoru.<verse eid="NUM 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 25:6" />Gama lumoun aba lanügün aban Ísüraelina aban würi Madianna lúbiñoun, aríagu Moisesi hama sun Ísüraelina ha óundaragubaña ñein lun, lídanbei añaha lan ayahua tigibugiñe kianpu lánina óundaruni. <verse eid="NUM 25:6" /><verse number="7" style="v" sid="NUM 25:7" />Dan larihini Finesi le liráü Eleasárü, le libari fádiri Aarón katei le, aba ladireirun hawéi Ísüraelina ha óundaragubaña, aba lárügüdün aban arufun, <verse eid="NUM 25:7" /><verse number="8" style="v" sid="NUM 25:8" />aba lidin lárigi Ísüraelina ligía dagá lisounburunrugun, ñein aba límiraguni Ísüraelina ligía tau sun würi tuguya. Ítara liña lagumuchun igei le áfaragubaliña Ísüraelina, <verse eid="NUM 25:8" /><verse number="9" style="v" sid="NUM 25:9" />lau sun lira hilaguatiña wein-gádürü-milu hádangiñe.<verse eid="NUM 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 25:10" />Ábati ladimurehan Wabureme lun Moisesi, lariñaga lun:<verse eid="NUM 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 25:11" />—Gálumagüdala Finesi nigañi houn Ísüraelina, lugundun emeiditi hau kéigubeirügü giñe nemeidin hau. Ligía mígirun lubéi lun nagumuchun hau ladüga nemeidin. <verse eid="NUM 25:11" /><verse number="12" style="v" sid="NUM 25:12" />Ariñagabá lubeiti lun luagu nadüga lan aban daradu luma le lánina darangilaü, <verse eid="NUM 25:12" /><verse number="13" style="v" sid="NUM 25:13" />derege numuti afadirihani lun luma houn ladügawagun lun sun dan, ladüga emeidihati nau, aba libihini ferudun houn Ísüraelina lau katei le ladügübei.<verse eid="NUM 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 25:14" />Ísüraelina le ímirawagubei úara tuma Madianna, Simürí líribei, liráü Salú le hábuti aban iduheñu hádangiñe lani Simeón türibu. <verse eid="NUM 25:14" /><verse number="15" style="v" sid="NUM 25:15" />Würi Madianna tuguya, Kosubí tíribei, liráü Suru, hábuti aban külán Madianna.<verse eid="NUM 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 25:16" />Aba ladimurehan Wabureme lun Moisesi, lariñaga lun:<verse eid="NUM 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 25:17" />—Hageindagua hama Madianna, háfaraguañame, <verse eid="NUM 25:17" /><verse number="18" style="v" sid="NUM 25:18" />ítara kei hadüga hun lau luriban hagaburi áhuduraguagüdaün lun Baali-peoru, kei le tadügübei Kosubí to liráü ábuti Madianna to ímirawaguboun lau aban arufun dan le nóunahanbei aban igei huagun ladüga háhuduragun lun Baali-peoru.<verse eid="NUM 25:18" /></para>
  <chapter eid="NUM 25" />
  <chapter number="26" style="c" sid="NUM 26" />
  <para style="s1">Habahüdǘnya Ísüraelina</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 26:1" />Lárigiñe igei gáfarahati ligía, aba lariñagun Wabureme lun Moisesi luma lun Eleasárü, le liráü fádiri Aarón:<verse eid="NUM 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 26:2" />—Abahüda humaña sun Ísüraelina hawagu haduheñu, sun ha weinti irumu hau lun iñun, ha gayaraati houdin wuriburugu.<verse eid="NUM 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 26:3" />Ábati líchugun Moisesi luma Eleasárü lúrudu houn Ísüraelina lidan fulasu mawübüriti le gíribei Moabü, lurugabu duna Hordán, ligibugiñe Herikó, <verse eid="NUM 26:3" /><verse number="4" style="v" sid="NUM 26:4" />lun habürüdǘn sun ha weinti irumu hau lun iñun kei lariñaguni Wabureme lun Moisesi.</para>
  <para style="p" vid="NUM 26:4">Añahán buga Ísüraelina ha áfuridubaña Ehiptugiñe.<verse eid="NUM 26:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 26:5" />Külán burí le ladügawagun Rubén, le furumiñeti liráü Ísüraeli, Enoku, Falú. <verse eid="NUM 26:5" /><verse number="6" style="v" sid="NUM 26:6" />Esürón luma Karümí; <verse eid="NUM 26:6" /><verse number="7" style="v" sid="NUM 26:7" />según habahüdün ladügawagun Rubén bián-wein-ǘrüwa-milu-sedü-san-darandiñanu wügüriña. <verse eid="NUM 26:7" /><verse number="8" style="v" sid="NUM 26:8" />Liráü Falú: Eliabü, <verse eid="NUM 26:8" /><verse number="9" style="v" sid="NUM 26:9" />Lirahüñü Eliabü: Nemueli, Datán luma Abirámü. Datán luma Abirámü, hádanñanu meha ha úaradubaña luma Koré lun hiñuragun houngua luagun Wabureme luma luagun Moisesi luma Aarón, <verse eid="NUM 26:9" /><verse number="10" style="v" sid="NUM 26:10" />gama lumoun aba lánhunrenchun múa aba láhuluchuniña biángubei hagía luma Koré hau sun ha afalarubalin. Bián-sánñanu-dimí wügüriña óunwegutiña lidan watu gemeti. Seriwiti lira kei hénpulu houn ha híbiri. <verse eid="NUM 26:10" /><verse number="11" style="v" sid="NUM 26:11" />Ánhañati lirahüñü Koré móunweguntiña:<verse eid="NUM 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 26:12" />Külán burí le ladügawagun Simeón, ha lánigu Nemueli, Hamín, Hakín <verse eid="NUM 26:12" /><verse number="13" style="v" sid="NUM 26:13" />Sera luma Saulu; <verse eid="NUM 26:13" /><verse number="14" style="v" sid="NUM 26:14" />según abahüdǘni, wein-bián-míluñanu-bián-san wügüriña ladügawagun Simeón.<verse eid="NUM 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 26:15" />Külán burí le ladügawagun Gadü: Sefón, Agí, Suní, <verse eid="NUM 26:15" /><verse number="16" style="v" sid="NUM 26:16" />Osuní, Erí, <verse eid="NUM 26:16" /><verse number="17" style="v" sid="NUM 26:17" />Arodu luma Arelí; <verse eid="NUM 26:17" /><verse number="18" style="v" sid="NUM 26:18" />Según abahüdǘni bián-wein-milu-seingü-sánñanu wügüriña ladügawagun Gadü.<verse eid="NUM 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 26:19" />Hádangiñe lirahüñü Hudá, hilati Erü luma Onán lidan fulasu le gíribei Kanán, <verse eid="NUM 26:19" /><verse number="20" style="v" sid="NUM 26:20" />külán lubeiti ha ladügawagun Hudá: Selá, Fáresi luma Sera. <verse eid="NUM 26:20" /><verse number="21" style="v" sid="NUM 26:21" />Külán le ladügawagun Fáresi: Esürón luma Amulu; <verse eid="NUM 26:21" /><verse number="22" style="v" sid="NUM 26:22" />según abahüdǘni, ǘrüwa-wein-disisi-míluñanu-seingü-san wügüriña ladügawagun Hudá.<verse eid="NUM 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 26:23" />Añahán meha külán ha ladügawagun Isakárü: Tolá, Puá, <verse eid="NUM 26:23" /><verse number="24" style="v" sid="NUM 26:24" />Hasubu, luma Simürón; <verse eid="NUM 26:24" /><verse number="25" style="v" sid="NUM 26:25" />ǘrüwa-wein-gádürü-míluñanu wügüriña abahüdǘtiña hadan ladügawagun Isakárü.<verse eid="NUM 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 26:26" />Añahán meha külán ha ladügawagun Sabulón: Séredü, Elón luma Haleeli; <verse eid="NUM 26:26" /><verse number="27" style="v" sid="NUM 26:27" />ǘrüwa-wein-míluñanu seingü-san wügüriña abahüdǘtiña hadan ladügawagun Sabulón.<verse eid="NUM 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 26:28" />Añahán meha külán ha ladügawagun Hosé, ha hádangiñetiña lani Manasési luma Éfürain türibu. <verse eid="NUM 26:28" /><verse number="29" style="v" sid="NUM 26:29" />Hádangiñe lánigu Manasési, lani Makirü külán; hádangiñe lánigu Makirü, lani Galaadü külán; <verse eid="NUM 26:29" /><verse number="30" style="v" sid="NUM 26:30" />hádangiñe lánigu Galaadü, lani Iéserü, lani Élekü, <verse eid="NUM 26:30" /><verse number="31" style="v" sid="NUM 26:31" />lani Asüriéli, lani Sikemü, <verse eid="NUM 26:31" /><verse number="32" style="v" sid="NUM 26:32" />lani Semidá hama lani Éferü külán. <verse eid="NUM 26:32" /><verse number="33" style="v" sid="NUM 26:33" />Selofádü, le liráü Éferü, marahüñüti wügüriña haweidigia würiña, ha burí gíribaña Malá, Noá, Ogulá, Milüká tuma Tirüsá. <verse eid="NUM 26:33" /><verse number="34" style="v" sid="NUM 26:34" />Según abahüdǘni dimí-san-bián-míluñanu-sedü-san wügüriña ladügawagun Manasési. <verse eid="NUM 26:34" /><verse number="35" style="v" sid="NUM 26:35" />Añahán meha türibu ha hádangiñetiña ladügawagun Éfürain, ha hádangiñetiña lani Sutela, Békerü luma Taán külán. <verse eid="NUM 26:35" /><verse number="36" style="v" sid="NUM 26:36" />Ladügawagun Sutela, ha lani Erán külán. <verse eid="NUM 26:36" /><verse number="37" style="v" sid="NUM 26:37" />Según abahüdǘni, darandi-bián-míluñanu-seingü-san wügüriña ladügawagun Éfürain. Hagía ladügawagunbaña Hosé.<verse eid="NUM 26:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 26:38" />Külán ha ladügawagun Benhamín: Ha lani Bela külán, lani Asübéli, ha lani Airamü, <verse eid="NUM 26:38" /><verse number="39" style="v" sid="NUM 26:39" />ha lani Sufamü, hama lani Ufamü külán. <verse eid="NUM 26:39" /><verse number="40" style="v" sid="NUM 26:40" />Külán ha ladügawagun Bela: Ha lánigu Árüdi luma Naamán, ha lirahüñü Bela. <verse eid="NUM 26:40" /><verse number="41" style="v" sid="NUM 26:41" />Según abahüdǘni bián-wein-seingü-míluñanu-sisi-san wügüriña ladügawagun Benhamín.<verse eid="NUM 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 26:42" />Ha lánigu Suamü ladügawagunbaña Dan. <verse eid="NUM 26:42" /><verse number="43" style="v" sid="NUM 26:43" />Según abahüdǘni, bián-wein-gádürü-míluñanu-gádürü-san wügüriña ladügawagun Suamü.<verse eid="NUM 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 26:44" />Külán ha ladügawagun Aserü: Ha hánigu Imüná, Isüwí luma Beriá. <verse eid="NUM 26:44" /><verse number="45" style="v" sid="NUM 26:45" />Külán ha ladügawagunbaña Beriá, ha lánigu Éberü luma Malükiéli. <verse eid="NUM 26:45" /><verse number="46" style="v" sid="NUM 26:46" />Garaüti bugaha Aserü aban würi gíritu Sera. <verse eid="NUM 26:46" /><verse number="47" style="v" sid="NUM 26:47" />Según abahüdǘni, dimí-san-ǘrüwa míluñanu-gádürü-san wügüriña ladügawagun Aserü.<verse eid="NUM 26:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 26:48" />Külán ha ladügawagun Nefütalí, ha hánigu Haseeli, Guní, <verse eid="NUM 26:48" /><verse number="49" style="v" sid="NUM 26:49" />Heserü, luma Silemü. <verse eid="NUM 26:49" /><verse number="50" style="v" sid="NUM 26:50" />Según abahüdǘni, bián-wein-seingü-míluñanu-gádürü-san wügüriña ladügawagun Nefütalí.<verse eid="NUM 26:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 26:51" />Sun Ísüraelina ha abahüdǘbaña, sisi-sánñanu-aban-milu-sedü-san-darandi wügüriña.<verse eid="NUM 26:51" /></para>
  <para style="s1">Igaburi lun lafanreinhóun múa</para>
  <para style="p">
    <verse number="52" style="v" sid="NUM 26:52" />Aba lariñagun Wabureme lun Moisesi:<verse eid="NUM 26:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="NUM 26:53" />—Hádanba gürigia ha lafanreinhóua múa, según átiriñanu lan abürüdǘtiña. <verse eid="NUM 26:53" /><verse number="54" style="v" sid="NUM 26:54" />Türibu le wéiritimabei, wéiritimabei lufanran, le ñǘraütimabei, ñǘraütimabei lufanran. Lichugúba lufanran kada türibu lun según abahüdǘni. <verse eid="NUM 26:54" /><verse number="55" style="v" sid="NUM 26:55" />Luáguba ubunuruni lafanreinhóua múa. Leresibirubei kada aban lufanran según türibu le ñéingiñe lubéi luéigiñe lúguchi. <verse eid="NUM 26:55" /><verse number="56" style="v" sid="NUM 26:56" />Luáguba ubunuruni lafanreinhóua múa dandu hadan ha gíbebaña kei hadan ha míbebaña.<verse eid="NUM 26:56" /></para>
  <para style="s1">Habahüdǘn Lewitagu</para>
  <para style="p">
    <verse number="57" style="v" sid="NUM 26:57" />Külán ha lani Lewí ha abahüdǘbaña lidan habahüdün Lewitagu: Ha lani Gerüsón, lani Keatü hama lani Merarí külán. <verse eid="NUM 26:57" /><verse number="58" style="v" sid="NUM 26:58" />Külán ha hani Libünáana, hani Ebürónna, hani ladügawagun Malí, hani ladügawagun Musí hama hani ladügawagun Koré, sun hara hani Lewitagu külán.</para>
  <para style="p" vid="NUM 26:58">Keatü lúguchibei Amürámü. <verse eid="NUM 26:58" /><verse number="59" style="v" sid="NUM 26:59" />Aba lamarieidun Amürámü tuma aban liráü Lewí gíritu Hokawédi, to águrahouboun dan meha le anihagua Lewí Ehiptu. Amürámü tuma Hokawédi, hagía hagübürigubaña Aarón, Moisesi tuma María. <verse eid="NUM 26:59" /><verse number="60" style="v" sid="NUM 26:60" />Lirahüñü Aarón: Nadabü, Abiú, Eleasárü luma Itamárü. <verse eid="NUM 26:60" /><verse number="61" style="v" sid="NUM 26:61" />Hilaguatiña Nadabü luma Abiú dan le hágudahanbei katei terenchati ligibugiñe Wabureme.<verse eid="NUM 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="NUM 26:62" />Hadan sun ladügawagun Lewí wügüriña ha ábanti hati hau lun iñun: Wein-ǘrüwañanu-milu. Hagía mabürüdǘntiña hama ha híbiri Ísüraelina lugundun michugúnti alagan houn.<verse eid="NUM 26:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="NUM 26:63" />Hagía sun ha labahüdübaña Moisesi luma fádiri Eleasárü lidan fulasu mawübüriti Moabü, lubadu duna Hordán ligibugiñe Herikó. <verse eid="NUM 26:63" /><verse number="64" style="v" sid="NUM 26:64" />Hadan sun hagía úati ni aban hádangiñe ha ñéinbaña dan le labahüdünbaliña Moisesi luma Aarón gürigia lidan fulasu mageirawati Sinaí, <verse eid="NUM 26:64" /><verse number="65" style="v" sid="NUM 26:65" />ladüga ariñagaali buga Wabureme luagu hóunweguba lan lidan fulasu mageirawati. Meredeti ni aban hádangiñe luéidigia Kalebü le liráü Hefuné luma Hosué le liráü Nun.<verse eid="NUM 26:65" /></para>
  <chapter eid="NUM 26" />
  <chapter number="27" style="c" sid="NUM 27" />
  <para style="s1">Halagante isaanigu würiña</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 27:1" />Hadan lani Manasési türibu, ñéinñanu seingü würiña gamulenuguátiña gíritiña Malá, Noá, Ogulá, Milüká tuma Tirüsá. Lirahüñü Selofádü, ladügawagun Éferü, Galaadü, Makirü, Manasési luma Hosé. <verse eid="NUM 27:1" /><verse number="2" style="v" sid="NUM 27:2" />Aba houdin seingü würiña gamulenuguátiña ha tigibugiñoun kianpu lánina óundaruni adimureha luma Moisesi labu luma fádiri Eleasárü luma hama ábutigu fulasurugu, aba hariñagun houn:<verse eid="NUM 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 27:3" />—Hilati wáguchi lidan fulasu mageirawati, gama lumoun mama meha hádanñein lánigu Koré ha awügürihóubaña lun Wabureme. Ladüga lifigoun guánarügü lounwe, ani marahüñüti eyeriñu. <verse eid="NUM 27:3" /><verse number="4" style="v" sid="NUM 27:4" />Gama lumoun marichati lun lagumuchagun liri wáguchi lídangiñe lani türibu ladügarügü maráü lan aban eyeri irahü. Ruba murusun múa woun lidan hafulasun líbirigu wáguchi.<verse eid="NUM 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 27:5" />Aba líchuguni Moisesi hakesin würiña ha ligibugiñoun Wabureme, <verse eid="NUM 27:5" /><verse number="6" style="v" sid="NUM 27:6" />aba lóunabuni Wabureme:<verse eid="NUM 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 27:7" />—Garichatiña lirahüñü Selofádü. Ruba murusun múa houn lidan hafulasun líbirigu háguchi, sügüla lalagante háguchi houn. <verse eid="NUM 27:7" /><verse number="8" style="v" sid="NUM 27:8" />Ariñagabá giñe houn híbiri Ísüraelina luagu anhein lan ounwe aban hádangiñe marahüñüga wügüriña, lásügürüba lan lalagante tun liráü; <verse eid="NUM 27:8" /><verse number="9" style="v" sid="NUM 27:9" />gama lumoun anhein maráü lubéi ni würi, lerederuba lalagante houn líbirigu, <verse eid="NUM 27:9" /><verse number="10" style="v" sid="NUM 27:10" />anhein mábirigu lubéi, lerederuba lalagante houn líbirigu lúguchi. <verse eid="NUM 27:10" /><verse number="11" style="v" sid="NUM 27:11" />Ánheinti mábirigu lubéi lúguchi, lerederuba lalagante lun liduhe le yarafaguatimagilibei luma. Ábanbei lúrudu le houn Ísüraelina ítara kei nariñaguni bun.<verse eid="NUM 27:11" /></para>
  <para style="s1">Lichugúniwa Hosué leweñeguame Moisesi</para>
  <para style="r">(<ref loc="DEU 31:1-8">2 Lur 31.1-8</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 27:12" />Aba lariñagun Wabureme lun Moisesi:</para>
  <para style="p" vid="NUM 27:12">—Wariba luagun wübü Abarímü, arihabéi múa le níchugubei houn Ísüraelina. <verse eid="NUM 27:12" /><verse number="13" style="v" sid="NUM 27:13" />Lárigiñeme barihini, ligíaba bounwen, ábame bóundarun hamoun bagüchagu, kei Aarón le bíbugaña, <verse eid="NUM 27:13" /><verse number="14" style="v" sid="NUM 27:14" />ladüga biángubei huguya, dürügua humuti nilurudun, lidan fulasu mageirawati Sin, dan le hekeharunbei Ísüraelina nun, ani míchutün uéiriguni nun hagibugiñe dan le hamuriahanbei duna.</para>
  <para style="p" vid="NUM 27:14">(Luagu le asuseredubei lidan lísensen duna le Meribá, uburugu Kadesi, lidan fulasu mageirawati yágüta Sin.)<verse eid="NUM 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 27:15" />Aba lariñagun Moisesi lun Wabureme:<verse eid="NUM 27:15" /></para>
  <para style="p">
    <verse number="16-17" style="v" sid="NUM 27:16-17" />—Wabungiute le Wabureme, buguya le íchugubei ibagari houn sun gürigia íridaba aban ábuti lun ligíaba lan adundehei bageira le ñeinhin lumuti houdin, meredera hamaamuga kei mudún móuniritiña.<verse eid="NUM 27:16-17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 27:18" />Lariñaga Wabureme lun Moisesi:</para>
  <para style="p" vid="NUM 27:18">—Hosué, le liráü Nun, aban wügüri lauti sífiri. Barübei, rubei búhabu lábulugu. <verse eid="NUM 27:18" /><verse number="19" style="v" sid="NUM 27:19" />Ábame banügüni ligibugiñoun Eleasárü le fádiri luma hagibugiñoun lílana fulasu, ábame bíchuguni agumadihani lun hagibugiñe sun hagía; <verse eid="NUM 27:19" /><verse number="20" style="v" sid="NUM 27:20" />ruba lídangiñe bubafu luagu lun haganbubei lan sun Ísüraelina le lubeibei. <verse eid="NUM 27:20" /><verse number="21" style="v" sid="NUM 27:21" />Gama lumoun gasu larufudagun Hosué lungua ligibugiñe fádiri Eleasárü, ábame lálügüdahan Eleasárü numa lau liri, lau Urimü le tuágubei ladaüragun. Hosué ligíaba ariñagei sun le lunbei hadügüni Ísüraelina houn.<verse eid="NUM 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 27:22" />Aba ladügüni Moisesi sun le lariñagubei Wabureme lun kei lubudubu. Aba lanügüni Hosué ligibugiñoun fádiri Eleasárü luma hagibugiñoun sun lílana fulasu. <verse eid="NUM 27:22" /><verse number="23" style="v" sid="NUM 27:23" />Aba líchuguni lúhabu lábulugu, aba líchuguni gumadi lun, ítara kei buga lariñagagüdüni Wabureme lun Moisesi.<verse eid="NUM 27:23" /></para>
  <chapter eid="NUM 27" />
  <chapter number="28" style="c" sid="NUM 28" />
  <para style="s1">Idewesei le ságüti weyu</para>
  <para style="r">(<ref loc="EXO 29:38-46">Afu 29.38-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 28:1" />Aba líchuguni Wabureme uganu le lun Moisesi, lun lariñaguni houn Ísüraelina:<verse eid="NUM 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 28:2" />—Merederalá hadagaragüdün fein luma idewesei gudawarügüti nun lidan burí fedu le nunti keisi idewesei le buíduti líhemen nun.<verse eid="NUM 28:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 28:3" />—Ariñagabá houn anihánba lan idewesei burí le lunbei hágudahani lidan niri: Sagü weyu ani lun ítara luba lan, bián harahüñü mudún ha ábanti irumu hau, ha úati mégeiti hawagu. <verse eid="NUM 28:3" /><verse number="4" style="v" sid="NUM 28:4" />Ladagarawagüdüba aban binaafin aban rábounweyu. <verse eid="NUM 28:4" /><verse number="5" style="v" sid="NUM 28:5" />Idewesei fulúaruauti: Gádürü líburu tídangiñe tubuidun-agei fulúaru to añoundawagutu lau aban líturu lagüle oliwu. <verse eid="NUM 28:5" /><verse number="6" style="v" sid="NUM 28:6" />(Ligía bugaha adagaragüdüni le águdahoubei sun dan luagu wübü Sinaí, keisi idewesei le buíduti líhemen lun Wabureme.) <verse eid="NUM 28:6" /><verse number="7" style="v" sid="NUM 28:7" />Idewesei tauti diwéin, ábanbei líturu luagu kada aban liraüraü mudún. Gasu táturawagun diwéin tuguya sanduariurugu lidan liri Wabureme. <verse eid="NUM 28:7" /><verse number="8" style="v" sid="NUM 28:8" />Le libiaman liraüraü mudún rábounweyuba ladagara, líchuguba aban idewesei fulúaruauti lanwoun luma aban idewesei tauti diwéin ítara kei idewesei le lánina binaafin. Aban idewesei buiti líhemen lira, le águdahoubei lun Wabureme.<verse eid="NUM 28:8" /></para>
  <para style="s1">Idewesei lánina luéyuri emeraaguni</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 28:9" />—Lidan burí luéyuri emeraaguni, gasu hadagaragüdün bián harahüñü mudún ha ábanti irumu hau, ha úati mégeiti hawagu, luma widü líburu tídangiñe tubuidun-agei fulúaru añoundawagutu lau garaba keisi idewesei fulúaruauti, lau giñe idewesei tauti diwéin. <verse eid="NUM 28:9" /><verse number="10" style="v" sid="NUM 28:10" />Lídanba luéyuri emeraaguni ladügǘwa adagaragüdüni gudawarügüti le, lau idewesei tauti diwéin, lumoun adagaragüdüni gudawarügüti le lánina sagü weyu.<verse eid="NUM 28:10" /></para>
  <para style="s1">Idewesei hatiauti</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 28:11" />—Furumiñeti weyu lidan kada hati, hadagaragüdüba keisi adagaragüdüni gudawarügüti lun Wabureme, bián bágasu wügüriña ha ñǘbürigiña, aban mudún wéiriyaali hama sedü harahüñü mudún ha ábanti irumu hau, ha úati mégeiti hawagu. <verse eid="NUM 28:11" /><verse number="12" style="v" sid="NUM 28:12" />Luagu kada bágasu hadagaragüdüba duusu líburu tídangiñe tubuidun-agei fulúaru ñóunwaguatu lau garaba; luagu kada mudún, widü líburu fulúaru to añoundawagutu lau garaba, <verse eid="NUM 28:12" /><verse number="13" style="v" sid="NUM 28:13" />luagu kada liraüraü mudún gádürü líburu fulúaru to añoundawagutu lau garaba. Aban adagaragüdüni gudawarügüti le buiti líhemen lira le agudúti lun Wabureme. <verse eid="NUM 28:13" /><verse number="14" style="v" sid="NUM 28:14" />Biámaboun líturu diwéin idewesei luagu kada bágasu wügüri le ñǘraügili, aban líturu dimí luagu kada mudún wéiriyaali luma aban líturu luagu kada liraüraü mudún. Ligía adagaragüdüni gudawarügüti le lunbei hadagaragüdüni sagü hati lidan kada irumu. <verse eid="NUM 28:14" /><verse number="15" style="v" sid="NUM 28:15" />Lumoun adagaragüdüni gudawarügüti le ságübei weyu, gasu hadagaragüdün aban liraüraü gábara lun Wabureme keisi adagaragüdüni luagu figóu lau idewesei tauti diwéin.<verse eid="NUM 28:15" /></para>
  <para style="s1">Idewesei lánina Luéyuri Esefuruni</para>
  <para style="r">(<ref loc="LEV 23:5-8">Fad 23.5-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 28:16" />—Weyu katorusu lidan furumiñeti hati lidan irumu, ligíaba Luéyuri Esefuruni luagu luéirigun Wabureme, <verse eid="NUM 28:16" /><verse number="17" style="v" sid="NUM 28:17" />weyu keinsi, luéyuribei fedu. Teigiba fein maganatu lébini luagu sedü weyu. <verse eid="NUM 28:17" /><verse number="18" style="v" sid="NUM 28:18" />Furumiñetime weyu lídangiñe sedü weyu ligía, ladügǘba aban óundaraguni sánduti. Madügünbadün ni murusun wadagimanu lidan weyu ligía. <verse eid="NUM 28:18" /><verse number="19" style="v" sid="NUM 28:19" />Hadagaragüdüba bián bágasu ñǘbürigiña ha wügüriña, aban mudún wéiriyaali hama sedü harahüñü mudún ha ábanti irumu hau, ha úati mégeiti hawagu lun Wabureme keisi adagaragüdüni gudawarügüti. <verse eid="NUM 28:19" /><verse number="20" style="v" sid="NUM 28:20" />Úara luma adagaragüdüni le, híchugubei giñe idewesei le tauti fulúaru to añoundawagutu lau garaba ítara: Duusu líburu fulúaru luagu kada liraüraü bágasu; widü líburu luagu kada mudún wéiriyaali <verse eid="NUM 28:20" /><verse number="21" style="v" sid="NUM 28:21" />tuma gádürü líburu luagu kada liraüraü mudún. <verse eid="NUM 28:21" /><verse number="22" style="v" sid="NUM 28:22" />Hadagaragüdüba giñe aban gábara keisi adagaragüdüni lun hibihini ferudun luagu hifigoun. <verse eid="NUM 28:22" /><verse number="23" style="v" sid="NUM 28:23" />Hadagaragüdübei sun le, lumoun adagaragüdüni gudawarügüti le adügǘbei sagü binaafin. <verse eid="NUM 28:23" /><verse number="24" style="v" sid="NUM 28:24" />Ítara luba hadügüni kada aban lídangiñe sedü weyu le lidaani fedu, keisi idewesei le buiti líhemen, le águdahouti lun luéirigun Wabureme. Ladagaruba le, úara luma idewesei tauti diwéin, lumoun adagaragüdüni gudawarügüti le lánina sagü weyu. <verse eid="NUM 28:24" /><verse number="25" style="v" sid="NUM 28:25" />Luagu lisedün weyu, hadügüba giñe aban óundaraguni sánduti. Madügünbadün ni aban wadagimanu lidan weyu ligía.<verse eid="NUM 28:25" /></para>
  <para style="s1">Idewesei luáguti furumiñeti lin nadü</para>
  <para style="r">(<ref loc="LEV 23:9-22">Fad 23.9-22</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 28:26" />—Lidan lufedun furumiñeti lin nadü, dan le hadagaragüdün le fulúaruauti lun Wabureme luagu iseri alubahani, hadügüba giñe aban óundaraguni sánduti. Madügünbadün ni aban luwuyeri wadagimanu lidan weyu ligía. <verse eid="NUM 28:26" /><verse number="27" style="v" sid="NUM 28:27" />Hadagaragüdüba bián bágasu wügüriña ha ñǘbürigiña lun Wabureme keisi adagaragüdüni gudawarügüti le buiti líhemen, aban mudún wéiriyaali hama sedü harahüñü mudún, ha ábanti irumu hau. <verse eid="NUM 28:27" /><verse number="28" style="v" sid="NUM 28:28" />Idewesei fulúaru to añoundawagutu lau garaba, dúusuboun líburu luagu kada bágasu, widü líburu luagu mudún wéiriyaali, <verse eid="NUM 28:28" /><verse number="29" style="v" sid="NUM 28:29" />tuma gádürü líburu luagu kada liraüraü mudún. <verse eid="NUM 28:29" /><verse number="30" style="v" sid="NUM 28:30" />Hadagaragüdüba giñe aban gábara keisi adagaragüdüni lun hibihini ferudun luagu hifigoun. <verse eid="NUM 28:30" /><verse number="31" style="v" sid="NUM 28:31" />Adagaragüdüni gudawarügüti le luma idewesei tauti diwéin luma fulúaruauti, hadagaragüdübei lanwoun adagaragüdüni gudawarügüti le lánina sagü weyu. Gasu úabei lan mégeiti hawagu animaalugu hagía.<verse eid="NUM 28:31" /></para>
  <chapter eid="NUM 28" />
  <chapter number="29" style="c" sid="NUM 29" />
  <para style="s1">Tufedun fidu</para>
  <para style="r">(<ref loc="LEV 23:23-25">Fad 23.23-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 29:1" />—Hadügüba óundaraguni sánduti weyu furumiñe lidan lisedün hati. Madügünbadün ni aban luwuyeri wadagimanu lidan weyu ligía, hagidenehabei weyu ligía lau tinwinrúniwa fidu. <verse eid="NUM 29:1" /><verse number="2" style="v" sid="NUM 29:2" />Hadagaragüdüba aban bágasu wügüri le ñǘraügili, aban mudún wéiriyaali hama sedü harahüñü mudún ha ábanti irumu hau, ha úati mégeiti hawagu, keisi adagaragüdüni gudawarügüti le buiti líhemen lun Wabureme. <verse eid="NUM 29:2" /><verse number="3" style="v" sid="NUM 29:3" />Idewesei tauti fulúaru to añoundawagutu lau garaba to lunboun tadagarun úara hama animaalugu ha, dúusuboun líburu luagu bágasu, widü líburu luagu mudún wéiriaali <verse eid="NUM 29:3" /><verse number="4" style="v" sid="NUM 29:4" />luma gádürü líburu luagu kada liraüraü mudún. <verse eid="NUM 29:4" /><verse number="5" style="v" sid="NUM 29:5" />Hadagaragüdüba giñe aban gábara lun ferudunawa lan hifigoun, <verse eid="NUM 29:5" /><verse number="6" style="v" sid="NUM 29:6" />luma adagaragüdüni gudawarügüti le lánina sagü hati, luma adagaragüdüni gudawarügüti le lánina sagü weyu, lau idewesei fulúaruauti, luma idewesei tauti diwéin, kei lariñaguni Wabungiute. Ábanbei idewesei buíduti líhemen lira le águdahouti lun luéirigun Wabureme.<verse eid="NUM 29:6" /></para>
  <para style="s1">Idewesei le lánina luéyuri ferudun</para>
  <para style="r">(<ref loc="LEV 23:26-32">Fad 23.26-32</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 29:7" />—Hadügüba giñe óundaraguni sánduti weyu diisi lídanmeme lisedün hati ligía. Hayunaruba ani madügünbadün ni aban luwuyeri wadagimanu weyu ligía. <verse eid="NUM 29:7" /><verse number="8" style="v" sid="NUM 29:8" />Hadagaragüdüba aban bágasu ñǘraügili, aban mudún wéiriyaali hama sedü harahüñü mudún ha ábanti irumu hau, ha úati mégeiti hawagu keisi adagaragüdüni gudawarügüti le buiti líhemen lun Wabureme. <verse eid="NUM 29:8" /><verse number="9" style="v" sid="NUM 29:9" />Idewesei tauti fulúaru to añoundawagutu lau garaba to lunboun híchugunu, dúusuboun líburu luagu kada bágasu, widü líburu luagu mudún wéiriyaali <verse eid="NUM 29:9" /><verse number="10" style="v" sid="NUM 29:10" />tuma gádürü líburu luagu kada liraüraü mudún. <verse eid="NUM 29:10" /><verse number="11" style="v" sid="NUM 29:11" />Hadagaragüdüba giñe aban gábara keisi adagaragüdüni luagu figóu, lumoun adagaragüdüni luagu figóu le adügǘbei lidan luéyuri ferudun, luma adagaragüdüni gudawarügüti le lánina sagü weyu, lau idewesei fulúaruauti luma idewesei tauti diwéin.<verse eid="NUM 29:11" /></para>
  <para style="s1">Idewesei laganagua tufedun dibasein</para>
  <para style="r">(<ref loc="LEV 23:33-44">Fad 23.33-44</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 29:12" />—Hadügüba óundaraguni sánduti weyu keinsi lidan lisedün hati. Madügünbadün ni aban luwuyeri wadagimanu weyu ligía. Hefeduhaba sedü weyu luagu luéirigun Wabureme. <verse eid="NUM 29:12" /><verse number="13" style="v" sid="NUM 29:13" />Furumiñeti weyu, hadagaragüdüba tareisi bágasu ñǘbürigiña ha wügüriña, bián mudún wéinamuhaña hama katorusu harahüñü mudún ha ábanti irumu hau, ha úati mégeiti hawagu, keisi adagaragüdüni gudawarügüti le buiti líhemen lun Wabureme. <verse eid="NUM 29:13" /><verse number="14" style="v" sid="NUM 29:14" />Idewesei tauti fulúaru to ñóunwaguatu lau garaba to lunboun híchugunu, dúusuboun líburu luagu kada bágasu, widü líburu luagu kada mudún <verse eid="NUM 29:14" /><verse number="15" style="v" sid="NUM 29:15" />tuma gádürü líburu luagu kada liraüraü mudún. <verse eid="NUM 29:15" /><verse number="16" style="v" sid="NUM 29:16" />Hadagaragüdüba giñe aban gábara keisi adagaragüdüni luagu figóu, lumoun adagaragüdüni gudawarügüti le lánina sagü weyu lau idewesei fulúaruauti luma idewesei tauti diwéin.<verse eid="NUM 29:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 29:17" />—Libiaman weyu, hadagaragüdüba duusu bágasu ñǘbürigiña ha wügüriña, bián mudún wéinamuhaña hama katorusu harahüñü mudún ha ábanti irumu hau, ha úati mégeiti hawagu. <verse eid="NUM 29:17" /><verse number="18" style="v" sid="NUM 29:18" />Bóugudin luéi lira lichugúba giñe idewesei fulúaruauti luma idewesei tauti diwéin úaragua luma hiibe animaalugu adagarutiña, kei lariñaguni Wabungiute. <verse eid="NUM 29:18" /><verse number="19" style="v" sid="NUM 29:19" />Ladagaruba giñe aban liraüraü gábara keisi adagaragüdüni luagu figóu, bóugudin luéi adagaragüdüni gudawarügüti le lánina sagü weyu lau lidewese fulúaruauti luma idewesei tauti diwéin.<verse eid="NUM 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 29:20" />—Lǘrüwan weyu, hadagaruba unsu bágasu ñǘbürigiña ha wügüriña, bián gábara hama katorusu harahüñü mudún ha ábanti irumu hau, ha úati mégeiti hawagu. <verse eid="NUM 29:20" /><verse number="21" style="v" sid="NUM 29:21" />Lichugúba giñe idewesei fulúaruauti luma idewesei tauti diwéin ítara kei hiibe animaalugu adagarawagüdütiña, kei lariñaguni Wabungiute. <verse eid="NUM 29:21" /><verse number="22" style="v" sid="NUM 29:22" />Ladagaruba giñe aban gábara keisi adagaragüdüni luagu figóu, lúmounya adagaragüdüni gudawarügüti le lánina sagü weyu, lau idewesei fulúaruauti tuma diwéin.<verse eid="NUM 29:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 29:23" />—Ligadürün weyu, hadagaruba diisi bágasu ñǘbürigiña ha wügüriña, bián mudún wéinamuhaña hama katorusu harahüñü mudún ha ábanti irumu hau, ha úati mégeiti hawagu. <verse eid="NUM 29:23" /><verse number="24" style="v" sid="NUM 29:24" />Lichugúba giñe idewesei fulúaruauti luma idewesei tauti diwéin según hiibe animaalugu adagarutiña, kei lariñaguni Wabungiute. <verse eid="NUM 29:24" /><verse number="25" style="v" sid="NUM 29:25" />Ladagaruba giñe aban gábara keisi adagaragüdüni luagu figóu, lúmounya adagaragüdüni gudawarügüti le lánina sagü weyu lau lidewese fulúaruauti luma idewesei tauti diwéin.<verse eid="NUM 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 29:26" />—Liseingün weyu, hadagarawagüdüba nefu bágasu wügüriña ha ñǘbürigiña, bián mudún wéinamuhaña hama katorusu harahüñü mudún ha ábanti irumu hau, ha úati mégeiti hawagu. <verse eid="NUM 29:26" /><verse number="27" style="v" sid="NUM 29:27" />Lichugúba giñe idewesei fulúaruauti luma idewesei tauti diwéin, según hiibe animaalugu adagarutiña kei lariñaguni Wabungiute. <verse eid="NUM 29:27" /><verse number="28" style="v" sid="NUM 29:28" />Ladagaruba giñe aban liraüraü gábara keisi adagaragüdüni luagu figóu lúmounya adagaragüdüni gudawarügüti le lánina sagü weyu lau lidewesena le fulúaruauti luma idewesei tauti diwéin.<verse eid="NUM 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 29:29" />—Lisisin weyu, hadagaruba widü bágasu ñǘbürigiña ha wügüriña, bián mudún wéinamuhaña hama katorusu harahüñü mudún ha ábanti irumu hau, ha úati mégeiti hawagu. <verse eid="NUM 29:29" /><verse number="30" style="v" sid="NUM 29:30" />Lichugúba giñe idewesei fulúaruauti luma idewesei tauti diwéin según hiibe animaalugu adagarutiña, kei lariñaguni Wabungiute. <verse eid="NUM 29:30" /><verse number="31" style="v" sid="NUM 29:31" />Ladagaruba giñe aban gábara keisi adagaragüdüni luagu figóu, lúmounya adagaragüdüni gudawarügüti le lánina sagü weyu lau lidewese fulúaruauti luma idewesei tauti diwéin.<verse eid="NUM 29:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 29:32" />—Lisedün weyu, hadagaruba sedü bágasu ñǘbürigiña ha wügüriña, bián mudún wéinamuhaña hama katorusu harahüñü mudún ha ábanti irumu hau, ha úati mégeiti hawagu. <verse eid="NUM 29:32" /><verse number="33" style="v" sid="NUM 29:33" />Lichugúba giñe idewesei fulúaruauti luma idewesei tauti diwéin según hiibe animaalugu adagarutiña kei lariñaguni Wabungiute. <verse eid="NUM 29:33" /><verse number="34" style="v" sid="NUM 29:34" />Ladagaruba giñe aban gábara keisi adagaragüdüni luagu figóu, bóugudin luéi adagaragüdüni gudawarügüti le lánina sagü weyu lau lidewesena le fulúaruauti luma idewesei tauti diwéin.<verse eid="NUM 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 29:35" />—Liwidün weyu, hefeduhabei lau aban óundaraguni wéiriguti, madügünbadün ni aban luwuyeri wadagimanu weyu ligía. <verse eid="NUM 29:35" /><verse number="36" style="v" sid="NUM 29:36" />Hadagaragüdüba keisi adagaragüdüni gudawarügüti le buiti líhemen lun Wabureme aban bágasu ñǘraügili, aban mudún wéiriyaali hama sedü harahüñü mudún ha ábanti irumu hau, ha úati mégeiti hawagu. <verse eid="NUM 29:36" /><verse number="37" style="v" sid="NUM 29:37" />Lichugúba giñe idewesei fulúaruauti luma idewesei tauti diwéin hawagu animaalugu ha adagarawagüdübaña. <verse eid="NUM 29:37" /><verse number="38" style="v" sid="NUM 29:38" />Ladagarawagüdüba giñe aban gábara keisi adagaragüdüni luagu figóu, bóugudin luéi adagaragüdüni gudawarügüti le lánina sagü weyu lau idewesei fulúaruauti luma idewesei tauti diwéin.<verse eid="NUM 29:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 29:39" />—Ligía burí adagaragüdüni le lunbei hadagaragüdüni lun Wabureme lidan lidaani, lúmounya idewesei le lánina lagunfulirun aban füramasei, o kei lan idewesei le líchugun gürigia lau lugundan, gayaraati idewesei lan o adagaragüdüni gudawarügüti, fulúaruauti luma idewesei lautu diwéin o adagaragüdüni lan le lánina arandaruni.<verse eid="NUM 29:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 29:40" />Aba lariñaguni Moisesi sun le lariñagubei Wabureme lun houn Ísüraelina.<verse eid="NUM 29:40" /></para>
  <chapter eid="NUM 29" />
  <chapter number="30" style="c" sid="NUM 30" />
  <para style="s1">Lúrudu luáguti füramasei</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 30:1" />Aba lariñagun Moisesi houn hábutigu türibu Ísüraelina:</para>
  <para style="p" vid="NUM 30:1">—Rúhali Wabureme lúrudu <verse eid="NUM 30:1" /><verse number="2" style="v" sid="NUM 30:2" />luagu danme lan ladügün aban gürigia aban füramasei lun o anhein lan áfiñura luagu somu katei, lunti lan lagunfuliruni lererun adügaleime sun le füramase lubéi.<verse eid="NUM 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 30:3" />—Anhoun adüga aban würi nibureingiru, to lábugiñegiru lagumadihan túguchi, aban füramasei lun Wabureme o tadügün lan daradu luagu somu katei, <verse eid="NUM 30:3" /><verse number="4" style="v" sid="NUM 30:4" />anhein mariñagun túguchi ni kata le gayaraati ladüraaguni tuéi dan le lasubudiruni, gasu tagunfuliruni tani füramasei o tidaradun lan. <verse eid="NUM 30:4" /><verse number="5" style="v" sid="NUM 30:5" />Gama lumoun, anhein máharun lubéi túguchi danbei lasubudiruni, mafosurun lubóun giñe Wabureme lun tagunfuliruni.<verse eid="NUM 30:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 30:6" />—Dan le tadügün aban würi aban füramasei lun Wabureme o tadügün lan aban daradu masaminarunga tuguya buidu lubá tadügüni, lárigiñe aba tamarieidun, <verse eid="NUM 30:6" /><verse number="7" style="v" sid="NUM 30:7" />ani dan le lasubudiruni túmari, mariñagunti ni kata tun libügürü, gasu tagunfuliruni tani füramasei luma tidaradun. <verse eid="NUM 30:7" /><verse number="8" style="v" sid="NUM 30:8" />Gama lumoun anhein danbei lubéi lasubudiruni túmari, múaradunti lau, mámaali mosu tagunfuliruni tani füramasei luma daradu le tadügübei masaminarunga tuguya buidu lubá tadügüni. Mafosurun lubóun giñe Wabureme lun tagunfuliruni.<verse eid="NUM 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 30:9" />—To adügüboun aban füramasei, anhein aban lubéi würi to hilaali túmari o aban lan würi to ígiraguaaru luma túmari, lunti tagunfuliruni sun daradu le tadügübei.<verse eid="NUM 30:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 30:10" />—Dan le tadügün aban würi maríeitu aban füramasei o táfiñurun lan anuhalu lúbiñe túmari luagu tadügüba lan aban daradu, <verse eid="NUM 30:10" /><verse number="11" style="v" sid="NUM 30:11" />anhein mariñagun túmari ni kata tun libügürü dan le lasubudiruni, ani anha ligíame lun le tadügübei, gasu tagunfuliruni tani füramasei luma tidaradun. <verse eid="NUM 30:11" /><verse number="12" style="v" sid="NUM 30:12" />Gama lumoun anhein dan le lubéi lasubudiruni túmari aba lamahadun, mámaali mosu tagunfuliruni, ladüga lamaharun túmari. Mafosurun lubóun giñe Wabureme lun tagunfuliruni.<verse eid="NUM 30:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 30:13" />—Gayaraati lánharun o lamaharun úmari lun furumiñeguarügü füramasei o fiñún le tadüga lúmari, füramasei o fiñún le afosurutu lun tayunarun. <verse eid="NUM 30:13" /><verse number="14" style="v" sid="NUM 30:14" />Anhein mariñagun ni kata tun libügürü, aba lásügürün átiri weyu ítara, lau mariñagun lan ni kata, ánhati lun füramasei o daradu le tadügübei. <verse eid="NUM 30:14" /><verse number="15" style="v" sid="NUM 30:15" />Anhein amahada átiri dan lárigiñe lasubudiruni, ligíaba ariha lau magunfulirun tan lúmari.<verse eid="NUM 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 30:16" />Anihán burí lúrudu le líchugubei Wabureme lun Moisesi, libügürü hanaagun úmarigu hámagua, luma hanaagun agübürigu houngua hama harahüñü hiñaruñu ha nibureinhaña lidan le lábugiñegiña lan lagumadihan háguchi.<verse eid="NUM 30:16" /></para>
  <chapter eid="NUM 30" />
  <chapter number="31" style="c" sid="NUM 31" />
  <para style="s1">Lagünrinchawagun Madián</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 31:1" />Aba lariñagun Wabureme lun Moisesi:<verse eid="NUM 31:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 31:2" />—Fáyeigüdabaña Madianna lidan hiri Ísüraelina luagu wuribati le hadügübei, lárigiñeme lira ligíaba bounwen.<verse eid="NUM 31:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 31:3" />Ábati lariñagun Moisesi houn Ísüraelina:</para>
  <para style="p" vid="NUM 31:3">—Aranse hamá fiu hídangiñe lun wuribu, belú humá Madiaun lun hafayeiragüdüniña luagu hadüga lidan liri Wabureme. <verse eid="NUM 31:3" /><verse number="4" style="v" sid="NUM 31:4" />Kada türibu gasu hóunahan milu wügüriña wuriburugun.<verse eid="NUM 31:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 31:5" />Aba lubeiti hanúadirun milu wügüriña lídangiñe kada türibu, hadan súngubei duusu-míluñanu wügüriña aranseñu lun wuribu. <verse eid="NUM 31:5" /><verse number="6" style="v" sid="NUM 31:6" />Aba lóunahaniña Moisesi ageindagua úara luma Finesi, le liráü fádiri Eleasárü, ligía anügübarun ílagu sagüráuti tuma burí fidu to lunboun tinwinrúniwa awisaha lun lagumeserun wuribu. <verse eid="NUM 31:6" /><verse number="7" style="v" sid="NUM 31:7" />Aba hageindagun hama Madianna, áfaragua hamutiña súngubei hilagubei kei lariñaguni Wabureme lun Moisesi. <verse eid="NUM 31:7" /><verse number="8" style="v" sid="NUM 31:8" />Áfara hamuti Ewí, Rékemü, Suru, Uru luma Reba, seingü urúeigu Madianna, áfara hamuti giñe Balaamü le liráü Beoru. <verse eid="NUM 31:8" /><verse number="9" style="v" sid="NUM 31:9" />Aba hanügüniña Ísüraelina würiña Madianna adaürǘwa hama sun hasaanigu ha ñǘbürigiña, gidá hamaña habiñanigu hawéi, luma burí katei le gebegibei hama, <verse eid="NUM 31:9" /><verse number="10" style="v" sid="NUM 31:10" />gudá haméi sun haburugute tuma burí hakianpun-agei. <verse eid="NUM 31:10" /><verse number="11" style="v" sid="NUM 31:11" />Sun le hagidarubei hawéi, dandu gürigia kei animaalugu, <verse eid="NUM 31:11" /><verse number="12" style="v" sid="NUM 31:12" />aba hanügüniña lun Moisesi luma lun fádiri Eleasárü, luma houn lílana Ísüraeli, ha agurabahabaliña luagu fulasu mawübüriti Moabü, lubadu Hordán ligibugiñe Herikó.<verse eid="NUM 31:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 31:13" />Aba láfuridun Moisesi, fádiri Eleasárü hama ábutigu fulasurugu eresibiraña bóugudi tuéi kianpu-agei. <verse eid="NUM 31:13" /><verse number="14" style="v" sid="NUM 31:14" />Gama lumoun aba lagañidun Moisesi hama hábutigu súdaragu ha ñǘbuinbaña wuriburugugiñe, <verse eid="NUM 31:14" /><verse number="15" style="v" sid="NUM 31:15" />aba lariñagun houn:</para>
  <para style="p" vid="NUM 31:15">—Ka san uagu máfaragun hubaliña würiña? <verse eid="NUM 31:15" /><verse number="16" style="v" sid="NUM 31:16" />Hagía ínchahabaliña Ísüraelina lun hawügürihóun lun Wabureme luma lun háhuduragun lun Baali-peoru lidan lidaani Balaamü, ligía lébubei labeichaguniña Wabureme lau aban igei. <verse eid="NUM 31:16" /><verse number="17" style="v" sid="NUM 31:17" />Reiti guentó áfaragua humaña sun wügüriña irahüñü hama sun würiña ha furihaña. <verse eid="NUM 31:17" /><verse number="18" style="v" sid="NUM 31:18" />Würiña ha máfuridungiñabaña, ígira humaña wínwanñu lun herederun habu. <verse eid="NUM 31:18" /><verse number="19" style="v" sid="NUM 31:19" />Sun ha áfarubaña somu gürigia o ha guruhañabaña hilaali, redei hamá bóugudi tuéi kianpu-agei luagu sedü weyu. Dandu huguya keisi ha adaürǘbaña gasu hachibagun hungua luagu lǘrüwan luma lisedün weyu. <verse eid="NUM 31:19" /><verse number="20" style="v" sid="NUM 31:20" />Harumagüda humóun giñe sun hadaüragun luma sun ílagu le lauti gueru, le lauti tiyu gábara o le lauti wewe.<verse eid="NUM 31:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 31:21" />Aba lariñagun fádiri Eleasárü houn sun súdara ha ñǘdünbaña wuriburugu:</para>
  <para style="p" vid="NUM 31:21">—Aban lúrudu le, le líchugubei Wabureme lun Moisesi: <verse eid="NUM 31:21" /><verse number="22" style="v" sid="NUM 31:22" />Ílagu burí le golu, pülata, buronse, gürabu, esütáñu o balu. <verse eid="NUM 31:22" /><verse number="23" style="v" sid="NUM 31:23" />—Sun katei le mágudaditi gasu híchuguni lidoun watu gemeti—, ábame hachibuni lau duna le lánina arumaduni lun larumadun. Katei le burí gágudaditi, gasu harumadagüdüni láurügü duna. <verse eid="NUM 31:23" /><verse number="24" style="v" sid="NUM 31:24" />Lidan lisedün weyu gasu hachibunu hadaüragun, ábame harumadun lárigiñe gayaraahalime hebelurun tidoun kianpu-agei.<verse eid="NUM 31:24" /></para>
  <para style="s1">Lafanreinhóuniwa ílagu</para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 31:25" />Aba lariñagun Wabureme lun Moisesi:<verse eid="NUM 31:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 31:26" />—Lau lídehan fádiri Eleasárü hama hábutigu iduheñu, abahüda humaña gürigia hama animaalugu ha hagidarubaña hawéi Madianna, <verse eid="NUM 31:26" /><verse number="27" style="v" sid="NUM 31:27" />adügabá bián fánreinti hau, bíchigame aban fánreinti houn ha ñǘdünbaña ageindagua, aban houn híbiri gürigia. <verse eid="NUM 31:27" /><verse number="28" style="v" sid="NUM 31:28" />Adügabá giñe aban fánreinti nun: Lídangiñe le hafanran súdara, dandu gürigia kei bágasu wügüriña, burigü hama mudún, banügame aban hádangiñe kada seingü-san, <verse eid="NUM 31:28" /><verse number="29" style="v" sid="NUM 31:29" />bíchigeime lun fádiri Eleasárü keisi ídemuei nun. <verse eid="NUM 31:29" /><verse number="30" style="v" sid="NUM 31:30" />Lídangiñe hamidan ha yúubaña houn híbiri Ísüraelina, dandu gürigia kei bágasu wügüriña, burigü, hama mudún, banügame aban hádangiñe kada dimí-san, bíchigeime houn Lewitagu ha nadagimeinbaña nisanduariunrugu.<verse eid="NUM 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 31:31" />Aba ladügüni Moisesi luma Eleasárü ítara kei lariñaguni Wabureme lun. <verse eid="NUM 31:31" /><verse number="32" style="v" sid="NUM 31:32" />Sun le agidarúbei hawéi áganiñu mabahüdünga le hárügüdübei súdara houngua: Sisi-san-ǘrüwa-wein-keinsi-míluñanu mudún, <verse eid="NUM 31:32" /><verse number="33" style="v" sid="NUM 31:33" />ǘrüwa-wein-duusu-milu bágasu wügüriña, <verse eid="NUM 31:33" /><verse number="34" style="v" sid="NUM 31:34" />ǘrüwa-wein-aban-milu burigü, <verse eid="NUM 31:34" /><verse number="35" style="v" sid="NUM 31:35" />hama darandi-bián-milu würiña irahüñü ha máfuridungiña. <verse eid="NUM 31:35" /><verse number="36" style="v" sid="NUM 31:36" />Lamidan lubeiti le atokarubei houn súdaragu: Ǘrüwa-san-darandi-sedü-milu-seingü-sánñanu mudún, <verse eid="NUM 31:36" /><verse number="37" style="v" sid="NUM 31:37" />ha ídangiñebaña hichugúa sisi-san-ǘrüwa-wein-keinsi lun Wabureme keisi ídemuei; <verse eid="NUM 31:37" /><verse number="38" style="v" sid="NUM 31:38" />hádangiñe darandi-sisi-milu bágasu wügüriña, rúatiña ǘrüwa-wein-biama keisi ídemuei lun Wabureme, <verse eid="NUM 31:38" /><verse number="39" style="v" sid="NUM 31:39" />hádangiñe darandi-milu-seingü-san burigü, rúatiña ǘrüwa-wein-aban keisi ídemuei lun Wabureme; <verse eid="NUM 31:39" /><verse number="40" style="v" sid="NUM 31:40" />hádangiñe disisi-milu würiña irahüñü, rúatiña darandi-biama keisi ídemuei lun Wabureme. <verse eid="NUM 31:40" /><verse number="41" style="v" sid="NUM 31:41" />Aba lederegeruni Moisesi ídemuei le yuubei lun Wabureme lun fádiri Eleasárü, ítara kei lariñaguni Wabureme lun.<verse eid="NUM 31:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 31:42" />Le aban amidani, le fánreinti le yuubei houn ha híbiri Ísüraelina, le ladireirubei Moisesi lídangiñe hafanreintin súdaragu; <verse eid="NUM 31:42" /><verse number="43" style="v" sid="NUM 31:43" />ligiaméme hiibe, ǘrüwa-san-darandi-sedü-milu-seingü-sánñanu mudún, <verse eid="NUM 31:43" /><verse number="44" style="v" sid="NUM 31:44" />darandi-sisi-milu bágasu wügüriña, <verse eid="NUM 31:44" /><verse number="45" style="v" sid="NUM 31:45" />darandi-milu-seingü-san burigü, <verse eid="NUM 31:45" /><verse number="46" style="v" sid="NUM 31:46" />hama disisi-milu würiña irahüñü. <verse eid="NUM 31:46" /><verse number="47" style="v" sid="NUM 31:47" />Lídangiñe amidani ligía lasagara Moisesi aban hádangiñe kada dimí-san, dandu gürigia kei animaalugu, aba líchuguniña houn Lewitagu ha eseriwidubaña lisanduariunrugu Wabureme, ítara kei lariñaguni Wabureme lun.<verse eid="NUM 31:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 31:48" />Ábati hayabin ábutigu ha buga háubaña súdaragu lumoun Moisesi, <verse eid="NUM 31:48" /><verse number="49" style="v" sid="NUM 31:49" />aba hariñagun lun:</para>
  <para style="p" vid="NUM 31:49">—Abahüda wamaaña súdaragu ha buga lábugiñebaña waríaahan, úati ni aban mégeiti. <verse eid="NUM 31:49" /><verse number="50" style="v" sid="NUM 31:50" />Anihán burí katei lauti golu le ladarirubei kada aban: Bángüli, bagü, arigeilaü luma burí amu uéndeni, lun wíchuguni lun Wabureme keisi esefuruni wawagu guánarügü.<verse eid="NUM 31:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 31:51" />Aba heresibiruni Moisesi luma Eleasárü sun katei golu ligía hámagiñe. <verse eid="NUM 31:51" /><verse number="52" style="v" sid="NUM 31:52" />Hǘrüti sun golu ligía lóugiñe ǘrüwa-san-ǘrüwa-wein-gádürü líburu, <verse eid="NUM 31:52" /><verse number="53" style="v" sid="NUM 31:53" />lugundun kada súdara barüti somu katei lídangiñe le agidarúbei hawéi áganiñu. <verse eid="NUM 31:53" /><verse number="54" style="v" sid="NUM 31:54" />Aba lubeiti heresibiruni Moisesi luma Eleasárü golu le hanügübei ábutigu, aba hanügüni tidoun kianpu lánina óundaruni lun laritaguba lan Wabureme hawagun Ísüraelina.<verse eid="NUM 31:54" /></para>
  <chapter eid="NUM 31" />
  <chapter number="32" style="c" sid="NUM 32" />
  <para style="s1">Türibu ha erederubaña luéigiñe labouchagüle weyu libiti Hordán</para>
  <para style="r">(<ref loc="DEU 3:12-22">2 Lur 3.12-22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 32:1" />Gíbetiña bugaha habiñanigu lani Rubén hama lani Gadü türibu. Dan harihinbei luagu buidu lan lumúan Haserü luma Galaadü lun hagüriahóun ibiñanigu, <verse eid="NUM 32:1" /><verse number="2" style="v" sid="NUM 32:2" />aba houdin lumoun Moisesi, lumoun fádiri Eleasárü luma hamoun ábutigu fulasurugu, aba hariñagun houn:<verse eid="NUM 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 32:3" />—Ariha huméi: Lóubawagu Atarótu, Dibón, Haserü, Nimürá, Esübón, Elalé, Sebamü, Nebu luma Beón <verse eid="NUM 32:3" /><verse number="4" style="v" sid="NUM 32:4" />fulasu burí le lagañeirubei Wabureme houn Ísüraelina, anihein saragu sagadi buiti ñein houn ibiñanigu, ani wagía, gíbetiña wabiñanigu. <verse eid="NUM 32:4" /><verse number="5" style="v" sid="NUM 32:5" />Anhein mariban larihín bun, rubei fulasu le woun, mánhiñuraguagüdabei duna Hordán woun.<verse eid="NUM 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 32:6" />Aba lóunabuniña Moisesi:</para>
  <para style="p" vid="NUM 32:6">—Busentün san herederun ya, sun añangüra lan hupaisanun wuriburugu? <verse eid="NUM 32:6" /><verse number="7" style="v" sid="NUM 32:7" />Ka san uagu habusenra lun heferidiruni Ísüraelina haguraasun lun másügürün hamá lidoun ageiraü le líchugubei Wabureme houn? <verse eid="NUM 32:7" /><verse number="8" style="v" sid="NUM 32:8" />Ligiaméme meha hadügübei hagübürigu dan le nóunahanbaliña Kadesi-barünéagiñe aríaahei fulasu ligía. <verse eid="NUM 32:8" /><verse number="9" style="v" sid="NUM 32:9" />Chülütiña chülǘ liraüraü duna le Esükólubei aba haríaahani fulasu, lárigiñe aban heferidiragüdüni haguraasun Ísüraelina lun mebelurun hamá lidoun múa le ru laalibei Wabureme Houn. <verse eid="NUM 32:9" /><verse number="10" style="v" sid="NUM 32:10" />Ligía lubeiti lagañidunbei Wabureme weyu ligía, aba láfiñurun <verse eid="NUM 32:10" /><verse number="11" style="v" sid="NUM 32:11" />luagu gürigia lan ha áfuridubaña Ehiptugiñe, ha weinti irumu hau lun iñun, marihin habéi lan fulasu le füramase lubéi Wabureme lun Abüraámü, Isaakü luma Hakobu, ladüga mafalarun hamani lau úarani. <verse eid="NUM 32:11" /><verse number="12" style="v" sid="NUM 32:12" />Kalebürügüñein, le liráü Hefuné le Keneséu, luma Hosué, liráü Nun afalarei Wabureme lau úaraguni. <verse eid="NUM 32:12" /><verse number="13" style="v" sid="NUM 32:13" />Aba lagañidun Wabureme houn Ísüraelina aba léibugagüdüniña lidan fulasu mageirawati luagu bián-wein irumu, darí lun hóunwegun sun ha anabagubalin lau luriban hóuserun. <verse eid="NUM 32:13" /><verse number="14" style="v" sid="NUM 32:14" />Guentoti, huguya harahüñü agübürigu gafigountiña, busentün hasigiruni hani hagübürigu hénpulu, áluahaya hagañidagüdüni Wabureme luma Ísüraeli. <verse eid="NUM 32:14" /><verse number="15" style="v" sid="NUM 32:15" />Anhein mabusenrun hubéi hafalaruni Wabureme, lerederagüdübaña Ísüraelina gíbetima dan lidan fulasu mageirawati, ani huguyaba gadurun luagu hagumuchaguagüdüniwa.<verse eid="NUM 32:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 32:16" />Ábati hayarafadun lun Moisesi aba hariñagun lun:</para>
  <para style="p" vid="NUM 32:16">—Le wabusenrubei lun wayaraagun ya houn walügüniña mudún hama bágasu, luma burí wábunagun uburugu houn waduheñu. <verse eid="NUM 32:16" /><verse number="17" style="v" sid="NUM 32:17" />Lárigiñe ábame wárügüdünu wárumate lau lóufudagun ábame woudin habá habá híbiri Ísüraelina, darí wanügüniña hamúanrugun. Súnmeti dan le añahame waduheñu uburugu séfuñu hawéi ha aganóubaña lidan fulasu le. <verse eid="NUM 32:17" /><verse number="18" style="v" sid="NUM 32:18" />Magiribudúnbadiwa wábiñoun darime aranseguaaña sun Ísüraelina houngua hamúanrugu. <verse eid="NUM 32:18" /><verse number="19" style="v" sid="NUM 32:19" />Keiti le luéigiñebei lubéi oubaü le ñéingiñe lubéi laboucha libiti duna Hordán le lunbei wamúanbei lan, mamuriahanbadiwa múa loubafurugugiñe Hordán, ni yagürounmémeraü.<verse eid="NUM 32:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 32:20" />Lariñaga Moisesi houn:</para>
  <para style="p" vid="NUM 32:20">—Anhein hagunfulira hererun lun hárügüdünu hárumate lun hageindagun lábugiñe lilurudun Wabureme, <verse eid="NUM 32:20" /><verse number="21" style="v" sid="NUM 32:21" />anhein hánhiñuragua sun huguya duna Hordán tau hárumate lábugiñe lilurudun Wabureme, ani redei huguyame ñein darí labugaguniña Wabureme sun háganiñu <verse eid="NUM 32:21" /><verse number="22" style="v" sid="NUM 32:22" />ani gáñeileime ubóu ligía, so gayaraahalime hagiribudun, súnhalime hidaradun luma Wabureme labu hama Ísüraelina. Hánibei múa le lau lugundan Wabureme. <verse eid="NUM 32:22" /><verse number="23" style="v" sid="NUM 32:23" />Gama lumoun anhein madügün humá ítara, subudi huméi luagu hadügüña lan figóu ligibugiñe Wabureme, ani lachülürüba lan weyu lun habeichún luéigiñe figóu ligía. <verse eid="NUM 32:23" /><verse number="24" style="v" sid="NUM 32:24" />Bunagua humá lubeiti uburugu habá hiduheñu luma ayarawaguni habá hilügüniña mudún, gama lumoun gúnfuli huméi hererun.<verse eid="NUM 32:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 32:25" />Aba hóunabuni:</para>
  <para style="p" vid="NUM 32:25">—Wadügübei le bubeibei woun. <verse eid="NUM 32:25" /><verse number="26" style="v" sid="NUM 32:26" />Herederuba wámarigu, wasaanigu ha ñǘbürigiña hama sun wabiñanigu ya lidan burí luburugute Galaadü, <verse eid="NUM 32:26" /><verse number="27" style="v" sid="NUM 32:27" />wagíati, wárügüdaaru wárumate lun woudin wuriburugu lábugiñe lilurudun Wabureme, ítara kei bariñaguni woun.<verse eid="NUM 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 32:28" />Ábati lariñagun Moisesi lun fádiri Eleasárü, lun Hosué luma houn hábutigu haduheñu türibugu Ísüraelina:<verse eid="NUM 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 32:29" />—Anhein hánhiñuragua sun wügüriña ha lílana lani Gadü luma Rubén türibu duna Hordán huma, kada aban tau hárumate lánina wuribu lun hageindagun lábugiñe lilurudun Wabureme. Danme hagañeiruni fulasu, ábame híchuguni Galaadü houn hamúanme. <verse eid="NUM 32:29" /><verse number="30" style="v" sid="NUM 32:30" />Gama lumoun ánhaña mánhiñuragun aranseñu, latokaruba aban fulasu houn haganagua, lidan hageira Kananna.<verse eid="NUM 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 32:31" />Aba hóunabun ladügawagun Gadü luma Rubén aba hariñagun:</para>
  <para style="p" vid="NUM 32:31">—Wadügübei le lariñagubei Wabureme woun. <verse eid="NUM 32:31" /><verse number="32" style="v" sid="NUM 32:32" />Wásügürüba aranseñu tau wárumate uburugun Kanán kei lariñaguni Wabureme woun, gama lumoun werederuba lau fulasu le luéigiñebei oubaü le ñéingiñe lubéi laboucha weyu libiti Hordán keisi wani.<verse eid="NUM 32:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 32:33" />Ítara liñati líchuguni Moisesi lumúan Sihón, urúei Amoruna, luma Ogu, le lurúeite Basán lau burí luburugute luma burí ichari le geyegubei lau houn lani Gadü luma lani Rubén türibu hama hamidan türibu ha lani Manasési. <verse eid="NUM 32:33" /><verse number="34" style="v" sid="NUM 32:34" />Aba hararamagüdüni lánigu Gadü uburugu Dibón, Atarótu, Aroerü, <verse eid="NUM 32:34" /><verse number="35" style="v" sid="NUM 32:35" />Atarótu-sofán, Haserü, Hogübeá, <verse eid="NUM 32:35" /><verse number="36" style="v" sid="NUM 32:36" />Betü-nimürá luma Betü-arán aba habarieiruni hawéi áganiñu, adüga hagía burí ayarawaguni houn halügüniña mudún. <verse eid="NUM 32:36" /><verse number="37" style="v" sid="NUM 32:37" />Ha lánigu Rubén, ábaya hararamagüdüni uburugu Esübón, Elalé, Kiriataimü, <verse eid="NUM 32:37" /><verse number="38" style="v" sid="NUM 32:38" />Nebu, Baali-meón luma Sibümá, aba burí hasansiruni liri líbiri uburugu aba híchuguni hiri luagu le hararamagüdayabei.<verse eid="NUM 32:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 32:39" />Aba hebelurun ladügawagun Makirü le liráü Manasési fulasurugún Galaadü lau here, aba hanügüni fulasu, bugá hamaña Amoruna ha ñéinbaña. <verse eid="NUM 32:39" /><verse number="40" style="v" sid="NUM 32:40" />Ábati líchuguni Moisesi lóubawagu Galaadü houn ladügawagun Makirü, aba hadügün hábiñe ñein. <verse eid="NUM 32:40" /><verse number="41" style="v" sid="NUM 32:41" />Aba lanügünu Hairü le ladügawagun Manasési fiu hakianpun-agei Amoruna aba líchugun Awotu-hairü tírime. <verse eid="NUM 32:41" /><verse number="42" style="v" sid="NUM 32:42" />Aba hárügüdüni lánigu Noba uburugu Kenatü luma sun burí fulasu le lábugiñebei laríaahan, aba líchugun Noba luagu, lememe liri guánarügü.<verse eid="NUM 32:42" /></para>
  <chapter eid="NUM 32" />
  <chapter number="33" style="c" sid="NUM 33" />
  <para style="s1">Hémeri Ísüraelina</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 33:1" />Anihán burí fulasu le ñein lubéi herederagua Ísüraelina dan le háfuridunbei Ehiptugiñe afileiheina kei súdaragu lábugiñe lugumadin Moisesi luma Aarón. <verse eid="NUM 33:1" /><verse number="2" style="v" sid="NUM 33:2" />Abürüheinaliñalin Moisesi liri sun fulasu le burí ñéingiñe lubéi háfurida aban aban ítara kei lariñaguni meha Wabureme lun. Anihán burí liri fulasu le ñein lubéi herederagua luma le ñéingiñe lubéi háfurida.<verse eid="NUM 33:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 33:3" />Weyu keinsi lidan furumiñeti hati lidan irumu, larugan lúmagiñe lefeduhóun Luéyuri Esefuruni, ligía háfuridun Ísüraelina Ramüsésigiñe. Aba háfuridun lau óunwenbu ubafu aríagu sun Ehiptuna lun, <verse eid="NUM 33:3" /><verse number="4" style="v" sid="NUM 33:4" />laganagua añaha lan Ehiptuna ábunahaña hágiramagu ha láfaragubaña Wabureme. Lau lira lasiadiruñanu luagu lagünrinchagubaña lan buga habungiutegu.<verse eid="NUM 33:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 33:5" />Aba háfuridun Ísüraelina Ramüsésigiñe aba herederagun Sukotu.<verse eid="NUM 33:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 33:6" />Háfurida Sukotugiñe aba herederagun Etamü, le ñein lubéi lébeda fulasu mageirawati.<verse eid="NUM 33:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 33:7" />Háfurida Etamügiñe aba hagiribudun luagun Pi-airotu, le luéigiñebei oubaü le ñéingiñe lubéi laboucha weyu libiti Baali-sefón, aba herederagun ligibugiñe Migüdólu.<verse eid="NUM 33:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 33:8" />Háfurida Pi-airotugiñe, aba hánhiñuraguni barana aba hachülürün lidan fulasu mageirawati. Aba héibugun ǘrüwa weyu lidan fulasu mageirawati Etamü, aba herederagun Mará.<verse eid="NUM 33:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 33:9" />Háfurida Maragiñe, aba hachülürün Elimü le ñein lubéi duusu lísensen duna tuma ǘrüwa-wein-diisi tídibu yaraüwa, aba herederagun ñein.<verse eid="NUM 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 33:10" />Háfurida Elimügiñe aba herederagun lubadu Barana Funati.<verse eid="NUM 33:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 33:11" />Háfurida Barana Funatigiñe aba herederagun lidan fulasu mageirawati Sin.<verse eid="NUM 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 33:12" />Háfurida Síngiñe aba herederagun Dofuká.<verse eid="NUM 33:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 33:13" />Háfurida Dofukágiñe aba herederagun Alusu.<verse eid="NUM 33:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 33:14" />Háfurida Alusugiñe aba herederagun Refidímü, le ñein lubéi lagumucha haniñe gürigia duna.<verse eid="NUM 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 33:15" />Háfurida Refidímügiñe aba herederagun lidan fulasu mageirawati Sinaí.<verse eid="NUM 33:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 33:16" />Háfurida lídangiñe fulasu mageirawati Sinaí aba herederagun Kibürótu-atawá.<verse eid="NUM 33:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 33:17" />Háfurida Kibürótu-atawágiñe aba herederagun Aserótu.<verse eid="NUM 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 33:18" />Háfurida Aserótugiñe aba herederagun Ritümá.<verse eid="NUM 33:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 33:19" />Háfurida Ritümágiñe aba herederagun Rimón-péresi.<verse eid="NUM 33:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 33:20" />Háfurida Rimón-péresigiñe aba herederagun Libüná.<verse eid="NUM 33:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 33:21" />Háfurida Libünágiñe aba herederagun Risá.<verse eid="NUM 33:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 33:22" />Háfurida Risagiñe aba herederagun Keheláta.<verse eid="NUM 33:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 33:23" />Háfurida Kehelátagiñe aba herederagun luagu wübü Séferü.<verse eid="NUM 33:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 33:24" />Háfurida luéigiñe wübü Séferü aba herederagun Aradá.<verse eid="NUM 33:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 33:25" />Háfurida Aradágiñe aba herederagun Makelótu.<verse eid="NUM 33:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 33:26" />Háfurida Makelótugiñe aba herederagun Táatü.<verse eid="NUM 33:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 33:27" />Háfurida Táatügiñe aba herederagun Tera.<verse eid="NUM 33:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 33:28" />Háfurida Téragiñe aba herederagun Mitüká.<verse eid="NUM 33:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 33:29" />Háfurida Mitükágiñe aba herederagun Asümoná.<verse eid="NUM 33:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 33:30" />Háfurida Asümonágiñe aba herederagun Moserótu.<verse eid="NUM 33:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 33:31" />Háfurida Moserótugiñe aba herederagun Bené-haakán.<verse eid="NUM 33:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 33:32" />Háfurida Bené-haakangiñe aba herederagun Oru le lani Gidügádü.<verse eid="NUM 33:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 33:33" />Háfurida Órugiñe le lani Gidügádü aba herederagun Hotubáta.<verse eid="NUM 33:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 33:34" />Háfurida Hotubátagiñe aba herederagun Abüroná.<verse eid="NUM 33:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 33:35" />Háfurida Abüronágiñe aba herederagun Esión-géberü.<verse eid="NUM 33:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 33:36" />Háfurida Esión-géberügiñe aba herederagun lidan fulasu mageirawati Sin, lememe Kadesi.<verse eid="NUM 33:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 33:37" />Háfurida Kadesigiñe aba herederagun luagu wübü Oru, lidan fadaguaü luma Edomu. <verse eid="NUM 33:37" /><verse number="38" style="v" sid="NUM 33:38" />Lau lilurudun Wabureme, aba lamudeirun fádiri Aarón luagun wübü Oru, aba lounwen ñein weyu furumiñe lidan liseingün hati, lidan irumu bián-wein, lúmagiñe háfuridun Ísüraelina Ehiptugiñe. <verse eid="NUM 33:38" /><verse number="39" style="v" sid="NUM 33:39" />San-wein-ǘrüwa irumu lau Aarón dan le lóunwenbei luagu wübü Oru.<verse eid="NUM 33:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 33:40" />Aba laganbun urúei Kananna le lani Aradü le aganóubei Négebü le lani Kanán luagu hachülürün Ísüraelina ñeinhin.<verse eid="NUM 33:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 33:41" />Háfurida luéigiñe wübü Oru aba herederagun Salümuná.<verse eid="NUM 33:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 33:42" />Háfurida Salümunágiñe aba herederagun Punón.<verse eid="NUM 33:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="NUM 33:43" />Háfurida Punongiñe aba herederagun Obotu.<verse eid="NUM 33:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 33:44" />Háfurida Obotugiñe aba herederagun Iyé-abarímü fadagu luma Moabü.<verse eid="NUM 33:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="NUM 33:45" />Háfurida Iyé-abarímügiñe aba herederagun Dibón-gadü.<verse eid="NUM 33:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 33:46" />Háfurida Dibón-gádügiñe aba herederagun Alümón-dibülataimü.<verse eid="NUM 33:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="NUM 33:47" />Háfurida Alümón-dibülataimügiñe aba herederagun luagu luwübüri Abarímü, luéigiñe oubaü le ñéingiñe lubéi laboucha weyu libiti Nebu.<verse eid="NUM 33:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 33:48" />Háfurida ñéingiñe aba herederagun lidan fulasu mawübüriti Moabü, lubadu Hordán, ligibugiñe Herikó. <verse eid="NUM 33:48" /><verse number="49" style="v" sid="NUM 33:49" />Tatatira kianpu-agei Hordán lúmagiñe Betü-hesimótugiñe darí Aweli-sitimü lidan fulasu mawübüriti le lani Moabü.<verse eid="NUM 33:49" /></para>
  <para style="s1">Lúrudu luáguti lafanreinhóun lumúan Kanán</para>
  <para style="p">
    <verse number="50" style="v" sid="NUM 33:50" />Aba ladimurehan Wabureme lun Moisesi lidan fulasu mawübüriti Moabü, lubadu Hordán, ligibugiñe Herikó, lariñaga lun:<verse eid="NUM 33:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 33:51" />—Ariñagabá houn Ísüraelina: Danme hánhiñuraguni Hordán belú huguyame fulasurugún Kanán, <verse eid="NUM 33:51" /><verse number="52" style="v" sid="NUM 33:52" />habugañame sun lílana fulasu, günringua hamañame sun haguariuan láutiña dübü o lautiña lan gürabu, günringua humeime sun fulasu le ñein lubéi háhuduragua houn. <verse eid="NUM 33:52" /><verse number="53" style="v" sid="NUM 33:53" />Ragǘ huméi fulasu, haganawa ñein lugundun derege numuti hun lun hayusuruni. <verse eid="NUM 33:53" /><verse number="54" style="v" sid="NUM 33:54" />Gama lumoun gasu hafanreinhani lau ubunuruni hadan hani sun türibu külán; külán le wéiriti, lichugúba fulasu wéiriti houn, le ñǘraübei, ñǘraübei hafulasun; hibihubei kada külán le líchugun habunurun houn. <verse eid="NUM 33:54" /><verse number="55" style="v" sid="NUM 33:55" />Ánhaña masagarun humá lílana fulasu fulasurugugiñe, ha erederutiña ñein, heberesehaba hun kei ifei lidan agu, kei hiiyu charuñu huagu, danme haganóun fulasurugu; <verse eid="NUM 33:55" /><verse number="56" style="v" sid="NUM 33:56" />ábameti nadügüni le yebe naritagubei nadügün houn hun.<verse eid="NUM 33:56" /></para>
  <chapter eid="NUM 33" />
  <chapter number="34" style="c" sid="NUM 34" />
  <para style="s1">Láfadaragun fulasu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 34:1" />Aba líchuguni Wabureme uganu le lun Moisesi, lun lariñaguni houn Ísüraelina:<verse eid="NUM 34:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 34:2" />—Málühadün anhaün belú lidoun ageiraü le Kanán. Anihán ageiraü le lunbei hageirabei lan, anihán burí láfadaragun. <verse eid="NUM 34:2" /><verse number="3" style="v" sid="NUM 34:3" />Fadaguaü le luéigiñebei suru, láfadaraguba luma fulasu mageirawati le Sin luma lumúan Edomu. Luéigiñe oubaü le ñéingiñe lubéi laboucha weyu, lagumeseruba fadaguaü luéigiñe suru libiti Barana Hilaali, <verse eid="NUM 34:3" /><verse number="4" style="v" sid="NUM 34:4" />lasigirame luagun suru darí luagun luwübüri Akürabímü, lásügürame Síngiñe, lachülürame darí Kadesi-barünéa. Lasigirame Asarü-adarügiñe darí Asümón, <verse eid="NUM 34:4" /><verse number="5" style="v" sid="NUM 34:5" />lasigirame Asümóngiñe darí luagun liraüraü duna le fadagubei luma Ehiptu, lagumuchame luagu Barana Mediteraniu.<verse eid="NUM 34:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 34:6" />—Fadaguaü le luéigiñebei oubaü le ñéingiñe lubéi lálüda weyu, láfadaraguba luma laru Barana Mediteraniu.<verse eid="NUM 34:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 34:7" />—Lun fadaguaü le luéigiñebei nórute, chü humá aban laini lúmagiñe luéigiñe barana Mediteraniu darí luagun wübü Oru, <verse eid="NUM 34:7" /><verse number="8" style="v" sid="NUM 34:8" />luma lúmagiñe wübü Oru darí luagun lebelaagüle Amatü, lárigiñe darí Sedadü. <verse eid="NUM 34:8" /><verse number="9" style="v" sid="NUM 34:9" />Lúmagiñe Sedadügiñe, lasigiruba igibu nórute le darí Sifürón lagumuchame luagu Asarü-enán.<verse eid="NUM 34:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 34:10" />—Lun fadaguaü le luéigiñebei oubaü le ñéingiñe lubéi laboucha weyu, hadügüba aban laini lúmagiñe Asarü-enangiñe darí Sefamü, <verse eid="NUM 34:10" /><verse number="11" style="v" sid="NUM 34:11" />Sefamügiñe lun luagun Ribülá, luéigiñe oubaü le ñéingiñe lubéi laboucha weyu libiti Ain; laragachame fadaguaü ligía ñéingiñe, lun luagun oubaü le ñéingiñe lubéi laboucha weyu libiti lagunu le Kineretü, <verse eid="NUM 34:11" /><verse number="12" style="v" sid="NUM 34:12" />lasigirame luéigiñe duna Hordán lagumuchame luagu Barana Hilaali.</para>
  <para style="p" vid="NUM 34:12">—Anihánba burí le, láfadaragun hageira.<verse eid="NUM 34:12" /></para>
  <para style="s1">Lafanreinhóun múa hadan Ísüraelina</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 34:13" />Aba líchuguni Moisesi arufudahani burí le houn Ísüraelina:</para>
  <para style="p" vid="NUM 34:13">—Anihán ageiraü le lunbei hafanreinhani hídangua lau ubunuruni; ligía ageiraü le uágubei lariñaga Wabureme lun lichugún houn nefu türibu dimí ha erederubaña, <verse eid="NUM 34:13" /><verse number="14-15" style="v" sid="NUM 34:14-15" />kei ibiha hamaali lubéi lánigu Rubén, lánigu Gadü hama hamidan lánigu Manasési le yuubei houn luéigiñe oubaü le ñéingiñe lubéi laboucha weyu libiti duna Hordán ligibugiñe Herikó.<verse eid="NUM 34:14-15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 34:16" />Aba ladimurehan Wabureme lun Moisesi, lariñaga lun:<verse eid="NUM 34:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 34:17" />—Fádiriba Eleasárü luma Hosué le liráü Nun, afanreinhei fulasu hidan. <verse eid="NUM 34:17" /><verse number="18" style="v" sid="NUM 34:18" />Gama lumoun wa humá giñe lun aban ábuti hawagu kada türibu lun hafanreinhani fulasu. <verse eid="NUM 34:18" /><verse number="19" style="v" sid="NUM 34:19" />Añahán wügüriña ha lúnbaña hagúarun hawagu:</para>
  <para style="p" vid="NUM 34:19">«Hawagu lánigu Hudá: Kalebü, le liráü Hefuné.<verse eid="NUM 34:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 34:20" />Hawagu lánigu Simeón: Samueli le liráü Amiudu.<verse eid="NUM 34:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 34:21" />Hawagu lánigu Benhamín: Elidádü le liráü Kisülón.<verse eid="NUM 34:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 34:22" />Hawagu lánigu Dan: Bukí le liráü Hogülí.<verse eid="NUM 34:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 34:23" />Hawagu hánigu lirahüñü Hosé: Anieli le liráü Efodu haweigiñe lánigu Manasési, <verse eid="NUM 34:23" /><verse number="24" style="v" sid="NUM 34:24" />Kemueli le liráü Sifütán haweigiñe lánigu Éfürain.<verse eid="NUM 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 34:25" />Hawagu lánigu Sabulón: Elisafán le liráü Parünákü.<verse eid="NUM 34:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 34:26" />Hawagu lánigu Isakárü: Palütiéli le liráü Asán.<verse eid="NUM 34:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 34:27" />Hawagu lánigu Aserü: Aiudu le liráü Selomí.<verse eid="NUM 34:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 34:28" />Hawagu lánigu Nefütalí: Pedaeli, le liráü Amiudu».<verse eid="NUM 34:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 34:29" />Hagía wügüriña ha líchugubaña Wabureme lun hafanreinhani Kanán hadan Ísüraelina.<verse eid="NUM 34:29" /></para>
  <chapter eid="NUM 34" />
  <chapter number="35" style="c" sid="NUM 35" />
  <para style="s1">Halagante Lewitagu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 35:1" />Aba ladimurehan Wabureme lun Moisesi lidan fulasu mawübüriti le lani Moabü, lubadu Hordán, ligibugiñe Herikó, lariñaga lun:<verse eid="NUM 35:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 35:2" />—Ruba lúrudu houn Ísüraelina luagu lídangiñe lan ageiraü le yuubei houn lun híchugun uburugu burí houn Lewitagu lun haganóun ñein, ru hameime giñe fulasu le geyegubei lau uburugu houn lun hagüriahan animaalugu. <verse eid="NUM 35:2" /><verse number="3" style="v" sid="NUM 35:3" />Haganóuba Lewitagu lidan burí uburugu ligía, herederame habiñanigu áraabu. <verse eid="NUM 35:3" /><verse number="4" style="v" sid="NUM 35:4" />Fulasu burí le lunbei híchuguni houn lun hábiñeme halügüniña, geyegu luba lau uburugu, gádürü-san-dimí méturu bóugudin libiti ayarawaguni. <verse eid="NUM 35:4" /><verse number="5" style="v" sid="NUM 35:5" />Gádürübei larigei fulasu ligía, nefu-san méturu luagu kada louba, lememe limigifen luéigiñe oubaü le ñéingiñe lubéi laboucha weyu ligiamémeba limigifen luéigiñe oubaü le ñeinhin lubéi lálüda weyu, luéigiñe nórute luma luéigiñe suru. Lerederuba uburugu lamidangua, geyegu fulasu le ñeinba lubéi heredera animaalu lau.<verse eid="NUM 35:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 35:6" />—Lídangiñe uburugu burí le lunbei híchuguni houn Lewitagu, ñeinbei sisi uburugu le aramudaguagülei, le ñeinba lubéi haramudagua gürigia ha áfarahatiña. Bóugudin luéi burí uburugu ligía, híchigayaba bián-wein-biama uburugu houn; <verse eid="NUM 35:6" /><verse number="7" style="v" sid="NUM 35:7" />lidan súngubei, gasu híchugun bián-wein-widü uburugu houn Lewitagu lau fulasu houn halügüniña geyegu lau. <verse eid="NUM 35:7" /><verse number="8" style="v" sid="NUM 35:8" />Danme híchugun uburugu houn Lewitagu lídangiñe hafulasun Ísüraelina, gasu híchugun kada türibu según lueirin hafulasun: Gíbetimabei híchugun türibu ha wéinamutimati hafulasun, míbebei uburugu híchugun türibu ha ñǘraütimatiña ufulasun.<verse eid="NUM 35:8" /></para>
  <para style="s1">Uburugu burí lun aramudaguni</para>
  <para style="r">(<ref loc="DEU 19:1-13">2 Lur 19.1-13</ref>; <ref loc="JOS 20:1-9">Hos 20.1-9</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 35:9" />Aba líchuguni Wabureme uganu le lun Moisesi lun lariñaguni houn Ísüraelina:<verse eid="NUM 35:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 35:10" />—Danme hánhiñuraguni duna Hordán lun hebelurun fulasurugún Kanán, <verse eid="NUM 35:10" /><verse number="11" style="v" sid="NUM 35:11" />gasu hanúadirun fiu uburugu lun aramudaguagüleime, le lunbei ñeinba lan haramudagua gürigia ha áfarahatiña mabusenrunga hagía. <verse eid="NUM 35:11" /><verse number="12" style="v" sid="NUM 35:12" />Séfuñu haba ñein luéi liduhe gürigia le háfarubei, ani móunwenbaña darime hederegeragun houngua houn lílana fulasu lun haguserun. <verse eid="NUM 35:12" /><verse number="13" style="v" sid="NUM 35:13" />Sísibei uburugu le aramudaguagülei: <verse eid="NUM 35:13" /><verse number="14" style="v" sid="NUM 35:14" />Ǘrüwa luéigiñe oubaü le ñéingiñe lubéi laboucha weyu libiti duna Hordán, ǘrüwa Kanán. <verse eid="NUM 35:14" /><verse number="15" style="v" sid="NUM 35:15" />Sisi uburugu aramudaguagülei le leseriwiduba dandu houn Ísüraelina kei houn terencha ha aganóutiña haganagua o ha lan ebeluhatiña hamoun. Gayaraabei laramudagun furumiñeguarügü le áfarahati mabusenrunga ñein.<verse eid="NUM 35:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 35:16" />—Anhein íbaagua o ímiragua aban gürigia amu tau furumiñeguarügü katoun lautu gürabu, aba lounwen le ímirawagubei, áfarahani lira, ani mosu lasiadirúniwa le áfarahabei lun lounwen.<verse eid="NUM 35:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 35:17" />—Anhein abuleseira aban gürigia amu lau dübü, aba lounwen le abuleseirúbei, áfarahani lira, ani mosu lasiadirúniwa le áfarahabei lun lounwen.<verse eid="NUM 35:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 35:18" />—Anhein abuleseira aban gürigia amu lau wewe, aba lounwen le abuleseirúbei, áfarahani lira, ani mosu lasiadirúniwa le áfarahabei lun lounwen. <verse eid="NUM 35:18" /><verse number="19" style="v" sid="NUM 35:19" />Le liduhe le afarúbei le yarafatimagilibei liduhegua luma, ligíaba áfarei le áfarubalin liduhe danme ladariruni.<verse eid="NUM 35:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 35:20" />—Anhein ádara aban gürigia amu ladüga liyereegun lun, o lachamurun lan somu katei luagu lau luriban aritaguni, <verse eid="NUM 35:20" /><verse number="21" style="v" sid="NUM 35:21" />o ladüga lan gáganiguaü lagayuaha luagu lau lúhabu, aba lounwen le uágubei lagayuaha, lasiadirúba le áfarahabei lun lounwen, lugundun áfarahani lira. Iduhei le yarafatimagilibei liduhegua luma le óunwebei, ligíaba áfarei le áfarahabei danme ladariruni.<verse eid="NUM 35:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 35:22" />—Anhein ládara aban gürigia amu gürigia mabusenrunga ligía yebe, ani mama luagu gáganiguaü, o anhein lan achamura somu katei luagun mama lau luriban aritaguni, <verse eid="NUM 35:22" /><verse number="23" style="v" sid="NUM 35:23" />o marihinga aba lachüürün aban dübü le gayaraati láfaruni lau, ani lahitirei dübü ligía ani aba láfaruni, máganigua hagía, mabusenrun ligía ladügün wuribati lun, <verse eid="NUM 35:23" /><verse number="24" style="v" sid="NUM 35:24" />lidan katei libe lira, lílanaba fulasu eseriwida keisi aguseragüdütiña lun le áfarahabei luma liduhe le óunwebei, le abusenrubei lafayeirun le áfarahabei luagu ladüga, según lúrudu burí le. <verse eid="NUM 35:24" /><verse number="25" style="v" sid="NUM 35:25" />Gasu hóunigiruni lílana fulasu le áfarahabei luéi liduhe le afarúbei, gasu hagiribudagüdüni le áfarahabei lárigoun lidoun uburugu aramudaguagülei le ñein lubéi buga laramudagua. Gasu lerederun le áfarahabei ñein darí lounwen fádiri le íñutimabei. <verse eid="NUM 35:25" /><verse number="26" style="v" sid="NUM 35:26" />Gama lumoun anhein áfurida bóugudin luéi uburugu aramudaguagülei, <verse eid="NUM 35:26" /><verse number="27" style="v" sid="NUM 35:27" />aba ladariruni liduhe gürigia le láfarubei bóugudi luéi uburugu aramudaguagülei, ani aba láfaruni, madurunbei le áfarubalin. <verse eid="NUM 35:27" /><verse number="28" style="v" sid="NUM 35:28" />Gasu lerederun le áfarahabei lidan uburugu le aramudaguagülei darí lounwen fádiri le íñutimabei. Lárigiñe gayaraahalime lagiribudun lageiroun.<verse eid="NUM 35:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 35:29" />—Ábanbei lúrudu le hun le lunbei lásügürün hámagiñe agübürigu hamoun isaanigu le ñein lumuti haganawa.<verse eid="NUM 35:29" /></para>
  <para style="s1">Lúrudu luáguti lagufeserúniwa lidurun gürigia luma esefuruni</para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 35:30" />—Láurügübei hagufeserun saragu gefentiña gayara lan lasiadirúniwa aban áfarahati lun óunweni. Lóuguati lagufeserun ábanrügü gefenti lun lasiadirúniwa aban gürigia lun óunweni.<verse eid="NUM 35:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 35:31" />—Siñabei leresibirúniwa seinsu luagu lesefurun aban áfarahati le siádiwaali lun lounwen; gasu lounwen wügüri ligía.<verse eid="NUM 35:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 35:32" />—Siñabei leresibirúniwa seinsu lun gayaraabei lan lagiribudun aban áfarahati lageiroun, le aramudaguti lidan aban uburugu le aramudaguagülei lubaragiñe lounwen fádiri íñugutimati.<verse eid="NUM 35:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 35:33" />—Madaseira huméi ageiraü le ñeinba lubéi haganawa lau áfarahani, lugundun dasei lumuti áfarahani ubóu, ani úati amu esefuruni luagu áfarahani luéidigia lounwen le áfarahabei.<verse eid="NUM 35:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 35:34" />—Madaseira huméi múa le ñeinba lubéi haganawa, le giñe ñeinba lubéi naganawa, lugundun au, le Aburemei, haganagua Ísüraelina naganawa.<verse eid="NUM 35:34" /></para>
  <chapter eid="NUM 35" />
  <chapter number="36" style="c" sid="NUM 36" />
  <para style="s1">Halagante würiña</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 36:1" />Aba houdin hábutigu haduheñu lani Galaadü külán ha ladügawagun Makirü, Manasési luma Hosé lumoun Moisesi, aba hariñagun hábutigu Ísüraelina lun:<verse eid="NUM 36:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 36:2" />—Ariñagati bugaha Wabureme bun lun bafanreinhani le lunbei latokarun lun kada Ísüraelina lau ubunuruni, ariñagati giñe bun lun bíchuguni lufanran Selofádü le meha hádangiñebei waduheñu houn lirahüñü würiña. <verse eid="NUM 36:2" /><verse number="3" style="v" sid="NUM 36:3" />Gama lumoun ánhaña amarieida würiña hagía hama wügüriña ha lídangiñetiña amu türibu Ísüraelina, mámaalime lani wani türibu múa le yuubei houn, hánihalime türibu ha ídangiñebaña wügüriña ha úmabaña hamarieida. Ítarati agidarúeina luba lídangiñe le atokarubei woun wawéi. <verse eid="NUM 36:3" /><verse number="4" style="v" sid="NUM 36:4" />Dánmeti lachülürün lidaani esefuruni Ísüraeli, ábame lásügürün hamúan sunsuinagubei hánime türibu hagía, mámaalime lani wani türibu.<verse eid="NUM 36:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 36:5" />Ábati lariñaguni Moisesi katei le houn Ísüraelina según arufudahani le líchugubei Wabureme lun:</para>
  <para style="p" vid="NUM 36:5">—Garichatiña wügüriña ha lídangiñebaña lani Hosé türibu. <verse eid="NUM 36:5" /><verse number="6" style="v" sid="NUM 36:6" />Lánharuba Wabureme lun hamarieidun lirahüñü Selofádü luma le úmati habusenra, lídangiñetirügaali ligía aban külán le lídangiñeti hani türibu luéigiñe háguchi. <verse eid="NUM 36:6" /><verse number="7" style="v" sid="NUM 36:7" />Múa le atokarubei lun kada aban lumúanrugu Ísüraeli, moun lumuti lásügürün lúmagiñe aban türibu lumoun amu; sun Ísüraelina gasu lakipuruni lalagante lidan lani türibu. <verse eid="NUM 36:7" /><verse number="8" style="v" sid="NUM 36:8" />Anhoun galagante aban würi lídangiñetu furumiñeguarügü türibu múa, gasu tamarieidun luma aban wügüri le lídangiñeti tani türibu. Ítara luba lakipuruni kada Ísüraelina lalagante hámagiñe lagübürigu. <verse eid="NUM 36:8" /><verse number="9" style="v" sid="NUM 36:9" />Moun lumuti lásügürün aban alagan lídangiñe aban türibu lidoun amu. Kada lani Ísüraeli türibu, gasu lakipuruni múa le atokarubei lun.<verse eid="NUM 36:9" /></para>
  <para style="p">
    <verse number="10-11" style="v" sid="NUM 36:10-11" />Ábati tadügüni Malá, Tirüsá, Ogulá, Milüká tuma Noá, ha lirahüñü Selofádü le lubeibei Wabureme lun Moisesi, aba hamarieidun hama hasaanigu hayawüritegu luéigiñe háguchi, <verse eid="NUM 36:10-11" /><verse number="12" style="v" sid="NUM 36:12" />ha ladügawagun Manasési le liráü Hosé. Ábati lerederun halagante lidan lani háguchi türibu.<verse eid="NUM 36:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 36:13" />Anihán burí gumadi luma lúrudu le líchugubei Wabureme houn Ísüraelina luéigiñe Moisesi lidan fulasu mawübüriti Moabü, lubadu duna Hordán, ligibugiñe Herikó.<verse eid="NUM 36:13" /></para>
  <chapter eid="NUM 36" />
</usx>