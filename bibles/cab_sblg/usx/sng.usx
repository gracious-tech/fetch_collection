<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="SNG" style="id">CANTARES.TXT (Encoding update 2008) 27/02/2001 CAP C.R, GARIFUNA</book>
  <para style="h">Uremu</para>
  <para style="toc3">Ure</para>
  <para style="toc2">Uremu</para>
  <para style="toc1">Uremu</para>
  <para style="mt2">Liliburun</para>
  <para style="mt1">UREMU</para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="s1">Furumiñeti uremu</para>
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />Lubuidun-agei lani Salomón poema.<verse eid="SNG 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 1:2" />Chubei niyuma lau biyumaaru!</para>
  <para style="q" vid="SNG 1:2">Bímetimati basupahan sügǘ tau diwéin.<verse eid="SNG 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 1:3" />Buiti líhemen bibiñe, ibiñein áwiyuruti bíribei.</para>
  <para style="q" vid="SNG 1:3">Ligía bínsiñebei houn hiñaruñu!<verse eid="SNG 1:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="SNG 1:4" />Barübana búmagua furese!</para>
  <para style="q" vid="SNG 1:4">Barübana birumunrugun urúei!</para>
  <para style="sp" vid="SNG 1:4">Koru:</para>
  <para style="q" vid="SNG 1:4">Wéiribei wagundan buma;</para>
  <para style="q" vid="SNG 1:4">busenwabei basupahan sügǘ tau diwéin</para>
  <para style="q" vid="SNG 1:4">ligía bínsiñebei houn hiñaruñu!<verse eid="SNG 1:4" /></para>
  <para style="sp">Tuguya:</para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 1:5" />Hiñaruñu Herusalénna,</para>
  <para style="q" vid="SNG 1:5">wuriyumatina ani magadiñetina;</para>
  <para style="q" vid="SNG 1:5">wuriyumatina kei likianpun Kedarü</para>
  <para style="q" vid="SNG 1:5">wéndetina kei likorutinan Salomón.<verse eid="SNG 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 1:6" />Meberesen humá lau wuriyuma nan,</para>
  <para style="q" vid="SNG 1:6">ni lau churá laali lan weyu nura.</para>
  <para style="q" vid="SNG 1:6">Gáñirügühaña meha níbirigu numa</para>
  <para style="q" vid="SNG 1:6">aba híchugunina óunigira beibei-agei,</para>
  <para style="q" vid="SNG 1:6">aba madaani nan lun nóunigiruni nubeibein-agei guánarügü.<verse eid="SNG 1:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="SNG 1:7" />Ariñagabéi nun eyeri hínsiñeti nun,</para>
  <para style="q" vid="SNG 1:7">halía san bóunigiraña bilügüniña mudún?</para>
  <para style="q" vid="SNG 1:7">Halía banügaña emeraagua amidirugu?</para>
  <para style="q" vid="SNG 1:7">Ka uagu mosu lubéi néibugun kei aban éibugañahadügütu</para>
  <para style="q" vid="SNG 1:7">harugabu halügüniña bíbirigu?<verse eid="SNG 1:7" /></para>
  <para style="sp">Ligía:</para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 1:8" />Anhein ibidiñe lubéi bun,</para>
  <para style="q" vid="SNG 1:8">buguya to magadiñeboun hadan magadiñetiña,</para>
  <para style="q" vid="SNG 1:8">falabei hagudárigi bilügüniña mudún,</para>
  <para style="q" vid="SNG 1:8">adundehabaña bilügüniña gábara turugabun haban amainirutiña mudún.<verse eid="SNG 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 1:9" />Ítara biña nun kei gabayu fínutu to tuáguboun likarün urúei Ehiptuna.<verse eid="SNG 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 1:10" />Wéndeti bubuyubu tabadinagua barigeila!</para>
  <para style="q" vid="SNG 1:10">Wéndeti bigiina labadinagua biñari!<verse eid="SNG 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 1:11" />Wadügüba barigeila lau golu,</para>
  <para style="q" vid="SNG 1:11">ábame wewendedagüdünu lau pülata.<verse eid="SNG 1:11" /></para>
  <para style="sp">Tuguya:</para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 1:12" />Sun aniha lan urúei balañu,</para>
  <para style="q" vid="SNG 1:12">aba lígiragüdüni nufulurin líhemen.<verse eid="SNG 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 1:13" />Ítara liña númari nun kei aban tiraüraü sagü mira</para>
  <para style="q" vid="SNG 1:13">to naniguaguboun súnwandan.<verse eid="SNG 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 1:14" />Ítara liña númari nun kei lufulurin alühéña</para>
  <para style="q" vid="SNG 1:14">tidan beibei-agei to En-gadüboun.<verse eid="SNG 1:14" /></para>
  <para style="sp">Ligía:</para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 1:15" />Magadiñetibu númari,</para>
  <para style="q" vid="SNG 1:15">úatu magadiñetu kei buguya!</para>
  <para style="q" vid="SNG 1:15">Ámirihati bagu lau ínsiñeni!<verse eid="SNG 1:15" /></para>
  <para style="sp">Tuguya:</para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 1:16" />Magadiñetibu númari!</para>
  <para style="q" vid="SNG 1:16">Úati magadiñeti kei buguya!</para>
  <para style="sp" vid="SNG 1:16">Ligía:</para>
  <para style="q" vid="SNG 1:16">Sagadi hilumati wabararibei!<verse eid="SNG 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="SNG 1:17" />Hibúari tíndaanutebei waban,</para>
  <para style="q" vid="SNG 1:17">sipürési ligía tábulugubei le adouragubei wau.<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="sp">Tuguya:</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 2:1" />Nuguya lufulurinbei áraabu le Sarón,</para>
  <para style="q" vid="SNG 2:1">nuguya lufulurinbei fulasu wayati.<verse eid="SNG 2:1" /></para>
  <para style="sp">Ligía:</para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 2:2" />Ítara tiña númari hadan würiña</para>
  <para style="q" vid="SNG 2:2">kei fuluri labadinagua hiiyu.<verse eid="SNG 2:2" /></para>
  <para style="sp">Tuguya:</para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 2:3" />Ítara liña númari hadan eyeriñu</para>
  <para style="q" vid="SNG 2:3">kei aban mansanu tidan sun tídibu wewe to dabíararuguboun.</para>
  <para style="b" vid="SNG 2:3" />
  <para style="q" vid="SNG 2:3">Wéiriti línsiñen nun nañuurun lábugiñe bamuñan!</para>
  <para style="q" vid="SNG 2:3">Bímetu bin nun!<verse eid="SNG 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 2:4" />Barǘ lumutina tidoun rumu to ñein lubéi ladinerúa,</para>
  <para style="q" vid="SNG 2:4">lau ínsiñeni laríaguana.<verse eid="SNG 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 2:5" />Ragüguagüda humana nungua tau pasa,</para>
  <para style="q" vid="SNG 2:5">hóugüda humana mansana,</para>
  <para style="q" vid="SNG 2:5">ladüga láfaraadina ínsiñeni.<verse eid="SNG 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 2:6" />Rulei lúhabu le lubaünan lábugiñe nichügü,</para>
  <para style="q" vid="SNG 2:6">lóuburaname lau lóunwenren.<verse eid="SNG 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 2:7" />Füramase humá nun, hiñaruñu Herusalénna</para>
  <para style="q" vid="SNG 2:7">hawagu usari ha dabíararugubaña,</para>
  <para style="q" vid="SNG 2:7">luagu madüraagun hubéi lan lidabagu númari.</para>
  <para style="q" vid="SNG 2:7">Ígira huméi lun larumugun darí lásaarun!<verse eid="SNG 2:7" /></para>
  <para style="s1">Libiaman uremu</para>
  <para style="sp">Tuguya:</para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 2:8" />Anitén númari!</para>
  <para style="q" vid="SNG 2:8">Aganba naali lumalali</para>
  <para style="q" vid="SNG 2:8">achubaheina liña ligibuagu wübü,</para>
  <para style="q" vid="SNG 2:8">éibaagueina liña ligibuagu dabíara.<verse eid="SNG 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 2:9" />Ítara liña númari kei aban usari,</para>
  <para style="q" vid="SNG 2:9">kei aban usari nibureingili.</para>
  <para style="q" vid="SNG 2:9">Aniheinhali ya, lanagangiñe bena,</para>
  <para style="q" vid="SNG 2:9">layarafaduña luagun funedera,</para>
  <para style="q" vid="SNG 2:9">laganarihaña labadinaguagiñe chalachi.<verse eid="SNG 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 2:10" />Lariñahare númari nun:</para>
  <para style="q" vid="SNG 2:10">«Saraba númari, keimoun.<verse eid="SNG 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 2:11" />Arihabá!</para>
  <para style="q" vid="SNG 2:11">Sügüha gunuburugu,</para>
  <para style="q" vid="SNG 2:11">sügüha giñe huya.<verse eid="SNG 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 2:12" />Bouha fuluri áraabu,</para>
  <para style="q" vid="SNG 2:12">chülühali lidaani eremuhani,</para>
  <para style="q" vid="SNG 2:12">aganbúaali heremuhan dunuru wamúanrugu.<verse eid="SNG 2:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="SNG 2:13" />Gínharu igu</para>
  <para style="q" vid="SNG 2:13">hirimichawaali líhemen beibei.</para>
  <para style="q" vid="SNG 2:13">Saraba númari, keimoun.<verse eid="SNG 2:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="SNG 2:14" />Nilügün unhun to aramudaguboun labadinagua dübü,</para>
  <para style="q" vid="SNG 2:14">arufudabéi bigibu nun,</para>
  <para style="q" vid="SNG 2:14">aganbanei bumalali.</para>
  <para style="q" vid="SNG 2:14">Gúndaatina lau narihinibu!</para>
  <para style="q" vid="SNG 2:14">Gúndaatina lau naganbuni bumalali».<verse eid="SNG 2:14" /></para>
  <para style="sp">Biángubei hagía:</para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 2:15" />Ragǘ humaña animaalugu, harahüñü animaalugu</para>
  <para style="q" vid="SNG 2:15">ha éigibarun wanadürigu beibei to egelewehaboun.<verse eid="SNG 2:15" /></para>
  <para style="sp">Tuguya:</para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 2:16" />Nani númari, ani lani giñe númari nuguya.</para>
  <para style="q" vid="SNG 2:16">Góunigi lumutiña lilügüniña mudún labadinagua fuluri,<verse eid="SNG 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="SNG 2:17" />lidan arugadeina lan,</para>
  <para style="q" vid="SNG 2:17">luma lidan agumuchagueina lan luburiga.</para>
  <para style="q" vid="SNG 2:17">Giribubá númari,</para>
  <para style="q" vid="SNG 2:17">éibaagueina kei aban usari,</para>
  <para style="q" vid="SNG 2:17">kei aban usari nibureingili ligibuagu wübü.<verse eid="SNG 2:17" /></para>
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="q">
    <verse number="1" style="v" sid="SNG 3:1" />Áluaha numuti le bímebei tun nanigi nigabananrugu áriebu,</para>
  <para style="q" vid="SNG 3:1">áluaha numuti ani madari numuti.<verse eid="SNG 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 3:2" />Ábati násaarun,</para>
  <para style="q" vid="SNG 3:2">aba néibuguni uburugu áluahei le bímebei tun nanigi,</para>
  <para style="q" vid="SNG 3:2">ǘmada luma mágidurugu.</para>
  <para style="q" vid="SNG 3:2">Áluaha numuti, ani madari numuti.<verse eid="SNG 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 3:3" />Aba nálügüdüniña ha óunigirubaña áriebu uburugu,</para>
  <para style="q" vid="SNG 3:3">marihin humagili san númari?<verse eid="SNG 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 3:4" />Málügili lúmagiñe nígiruniña,</para>
  <para style="q" vid="SNG 3:4">ligía nadunragun luma númari.</para>
  <para style="q" vid="SNG 3:4">Aba nárügüdüni lúhabu, mígiragüdünganei,</para>
  <para style="q" vid="SNG 3:4">aba nanügüni tirumunrugun núguchu.<verse eid="SNG 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 3:5" />Füramase humá nun hiñaruñu Herusalénna,</para>
  <para style="q" vid="SNG 3:5">hawagu usari ha dabíararugubaña,</para>
  <para style="q" vid="SNG 3:5">madüraagun hubéi lan lidabagu númari.</para>
  <para style="q" vid="SNG 3:5">Ígira huméi lun larumugun darí lásaarun!<verse eid="SNG 3:5" /></para>
  <para style="s1">Lǘrüwan uremu</para>
  <para style="sp">Koru:</para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 3:6" />Ka san le ñǘbuinbei lídangiñe fulasu mageirawati</para>
  <para style="q" vid="SNG 3:6">labadinagua lugumulelin mira luma kupali,</para>
  <para style="q" vid="SNG 3:6">luma sun luwuyeri ibiñein?<verse eid="SNG 3:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="SNG 3:7" />Ariha humá, lagei Salomón!</para>
  <para style="q" vid="SNG 3:7">Añate ǘrüwa wein súdara</para>
  <para style="q" vid="SNG 3:7">hádangiñe ha ganigitimabaña Ísüraeli geyegu lau;<verse eid="SNG 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 3:8" />sun hagía gageindaguaditiña buidu tau eféin,</para>
  <para style="q" vid="SNG 3:8">ani wuriburuguna buítiña hagía;</para>
  <para style="q" vid="SNG 3:8">anuhein lefeinte kada aban lóubawagu,</para>
  <para style="q" vid="SNG 3:8">aranseñu lubá furumiñeguarügü denchaü áriebu.<verse eid="SNG 3:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="SNG 3:9" />Adügagüdaali urúei aban lagei lautu</para>
  <para style="q" vid="SNG 3:9">wewe fínuti le Líwanuna.<verse eid="SNG 3:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="SNG 3:10" />Lauti pülata tebu,</para>
  <para style="q" vid="SNG 3:10">lauti golu tabalachagüle;</para>
  <para style="q" vid="SNG 3:10">tau gamisa funatu lafurarúa tálana;</para>
  <para style="q" vid="SNG 3:10">würiña Herusalénna adügübalin tuenden múnadagiñe lau ínsiñeni.<verse eid="SNG 3:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="SNG 3:11" />Würiña lílana Sión,</para>
  <para style="q" vid="SNG 3:11">furí humá arihei urúei Salomón!</para>
  <para style="q" vid="SNG 3:11">Lauñein liridin le tadügübei lúguchu</para>
  <para style="q" vid="SNG 3:11">lun lubá lamarieidun,</para>
  <para style="q" vid="SNG 3:11">lubá weyu le gúndaatimabei lidan libagari.<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="sp">Ligía:</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 4:1" />Magadiñetibu númari,</para>
  <para style="q" vid="SNG 4:1">wéiriti bumagadiñen!</para>
  <para style="q" vid="SNG 4:1">Ámirihati bagu lau ínsiñeni aramudañu tábugiñe belu</para>
  <para style="q" vid="SNG 4:1">ítara liña bídiburi kei harahüñü gábara</para>
  <para style="q" vid="SNG 4:1">dan le háhurerun hámagua luagu luwübüri Galaadü.<verse eid="SNG 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 4:2" />Wéndeburiti sun bari,</para>
  <para style="q" vid="SNG 4:2">ítara liña kei mudún ha sun liña hagoun,</para>
  <para style="q" vid="SNG 4:2">ha aranseñabaña lun hasarúniwa.<verse eid="SNG 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 4:3" />Funati biyumaaru kei fuluri funati,</para>
  <para style="q" vid="SNG 4:3">ani bímeburiti bererun.</para>
  <para style="q" vid="SNG 4:3">Ítara liña bubuyubu kei bián tagu güranáda tábugiñe bubelun.<verse eid="SNG 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 4:4" />Ítara liña bigiina kei luayelesin Dawidi.</para>
  <para style="q" vid="SNG 4:4">Anihein milu idaüdinaü lauti gürabu dibiñu luagu,</para>
  <para style="q" vid="SNG 4:4">idaüdinaü le hani ganigitiña.<verse eid="SNG 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 4:5" />Ítara liña baniguagu kei bián usari mádounu</para>
  <para style="q" vid="SNG 4:5">ha éigitiña sagadi labadinagua fuluri.<verse eid="SNG 4:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="SNG 4:6" />Sun arugadeina lan agumuchagueina ligía luburiga,</para>
  <para style="q" vid="SNG 4:6">nídiba luagun luwübüri mira,</para>
  <para style="q" vid="SNG 4:6">luagun luwübüri kupali.<verse eid="SNG 4:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="SNG 4:7" />Mama lanarime bumagadiñen númari,</para>
  <para style="q" vid="SNG 4:7">lúmagiñe bugudi darí bábulugu!</para>
  <para style="q" vid="SNG 4:7">Úati mégeiti buagu.<verse eid="SNG 4:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="SNG 4:8" />Rariba numa Líwanurugugiñe, nadari;</para>
  <para style="q" vid="SNG 4:8">rariba numa Líwanurugugiñe.</para>
  <para style="q" vid="SNG 4:8">Ariaguabéi fulasu wayati lábulugugiñe Amaná,</para>
  <para style="q" vid="SNG 4:8">lábulugugiñe Senirü luma Erümón;</para>
  <para style="q" vid="SNG 4:8">lúmagiñe hábiñegiñe liñún,</para>
  <para style="q" vid="SNG 4:8">luéigiñe hawübüri leoparüdu.<verse eid="SNG 4:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="SNG 4:9" />Íweruhaba nanigi, nitu, nadari;</para>
  <para style="q" vid="SNG 4:9">íweruhaba nanigi láurügü barihin nuagun,</para>
  <para style="q" vid="SNG 4:9">lau aban lídangiñe lifilun biñari.<verse eid="SNG 4:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="SNG 4:10" />Lisemén san basupahan, nitu, nadari!</para>
  <para style="q" vid="SNG 4:10">Bímeti sügǘ tau diwéin,</para>
  <para style="q" vid="SNG 4:10">semeetima ligía bibiñe sügǘ lau sun luwuyeri ibiñein.<verse eid="SNG 4:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="SNG 4:11" />Ítara liña lisemén biyumaaru kei sírudu.</para>
  <para style="q" vid="SNG 4:11">Anihein sírudu luma míligi tábugiñe biñeñe!</para>
  <para style="q" vid="SNG 4:11">Ítara liña tíhemen badaüragun kei líhemen wübü Líwanu.<verse eid="SNG 4:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="SNG 4:12" />Buguya, nitu, nadari,</para>
  <para style="q" vid="SNG 4:12">fuluri-agei baríeiruati buguya,</para>
  <para style="q" vid="SNG 4:12">lagei duna daruguti,</para>
  <para style="q" vid="SNG 4:12">lísensen duna daruguti;<verse eid="SNG 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 4:13" />fuluri-agei le ñein lubéi táhücha güranáda to semeeboun in;</para>
  <para style="q" vid="SNG 4:13">fuluri-agei le ñein lumuti fuluri le alühéña,<verse eid="SNG 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 4:14" />nárüdosu luma asafürán,</para>
  <para style="q" vid="SNG 4:14">maburu le buiti líhemen luma kanela,</para>
  <para style="q" vid="SNG 4:14">luma sun luwuyeri lídibu kupali, mira luma áloe;</para>
  <para style="q" vid="SNG 4:14">Sun lubuidun-agei katei le buiti líhemen!<verse eid="SNG 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 4:15" />Buguya lísensenbei lidunari nufulurin-agei,</para>
  <para style="q" vid="SNG 4:15">le ñéingiñe lubéi léseha duna bímeti,</para>
  <para style="q" vid="SNG 4:15">duna le ararirubei luéigiñe wübü Líwanu.<verse eid="SNG 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 4:16" />Garabali luéigiñeti nórute iñuraguabá!</para>
  <para style="q" vid="SNG 4:16">Garabali luéigiñeti suru higabu nun!</para>
  <para style="q" vid="SNG 4:16">Háfuha luagun nufulurin-agei lun lehemougadun.</para>
  <para style="sp" vid="SNG 4:16">Tuguya:</para>
  <para style="q" vid="SNG 4:16">Higabu lidoun bufulurin-agei númari</para>
  <para style="q" vid="SNG 4:16">lun beigin lídangiñe lin le semeebei.<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="sp">Ligía:</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 5:1" />Beluhadina nufulurin-ágeirugun, nitu, nadari.</para>
  <para style="q" vid="SNG 5:1">Ragǘ naaru nani mira luma nibiñe,</para>
  <para style="q" vid="SNG 5:1">houcha naali nisirudun,</para>
  <para style="q" vid="SNG 5:1">gurá naali nuniñe míligi tuma nuniñe diwéin.</para>
  <para style="sp" vid="SNG 5:1">Koru:</para>
  <para style="q" vid="SNG 5:1">Numadagu hínsiñetiña nun,</para>
  <para style="q" vid="SNG 5:1">hou humá gurá huguyame,</para>
  <para style="q" vid="SNG 5:1">gurá huméi sun le habusenrun.<verse eid="SNG 5:1" /></para>
  <para style="s1">Ligadürün uremu</para>
  <para style="sp">Tuguya:</para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 5:2" />Arumugatina, gama lumoun marumuguntu nanigi.</para>
  <para style="q" vid="SNG 5:2">Aba naganbuni lagúahan le bímebei tun nanigi luagu bena,</para>
  <para style="q" vid="SNG 5:2">lariñaga: «Daraba bena nubá, númari;</para>
  <para style="q" vid="SNG 5:2">nitu, unhun to úati mégeiti tuagu!</para>
  <para style="q" vid="SNG 5:2">Dǘdüha nábulugu lau serenu!</para>
  <para style="q" vid="SNG 5:2">Anihein serenu áriebuna nídiburirugu!»<verse eid="SNG 5:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="SNG 5:3" />«Ragaguaadina; gásuyameti nadaüragun!</para>
  <para style="q" vid="SNG 5:3">Chibá naali nugudi; ani lawiyedayaba!»<verse eid="SNG 5:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="SNG 5:4" />Aba ládaruni le bímebei tun nanigi lúhabu lídangiñe luhuyun bena,</para>
  <para style="q" vid="SNG 5:4">aba furesetima lan tádühan nanigi.<verse eid="SNG 5:4" /></para>
  <para style="q">
    <verse number="5-6" style="v" sid="SNG 5:5-6" />Ábati násaarun adaara bena lubá.</para>
  <para style="q" vid="SNG 5:5-6">Aba lédedehan mira luéigiñe núhabu luagun lidaünda bena.</para>
  <para style="q" vid="SNG 5:5-6">Dan naganbunbei ladimurehan aba nasandirun kamá hamuga nounwe!</para>
  <para style="q" vid="SNG 5:5-6">Aba nadaaruni bena lubá númari,</para>
  <para style="q" vid="SNG 5:5-6">gama lumoun úaali ñein.</para>
  <para style="b" vid="SNG 5:5-6" />
  <para style="q" vid="SNG 5:5-6">Áluaha numuti gama lumoun madari numuti,</para>
  <para style="q" vid="SNG 5:5-6">agúahatina lun ani móunabun lumutina.<verse eid="SNG 5:5-6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 5:7" />Aba hadunragun ha óunigirubaña uburugu numa;</para>
  <para style="q" vid="SNG 5:7">bulesei hamutina bigua hamana;</para>
  <para style="q" vid="SNG 5:7">ha óunigirubaña lubenari uburugu</para>
  <para style="q" vid="SNG 5:7">aba hachawaragunu nubelun lau anarimeni!<verse eid="SNG 5:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="SNG 5:8" />Hiñaruñu Herusalénna, anhein hariha númari,</para>
  <para style="q" vid="SNG 5:8">füramase humá nun luagu hariñaguba lan</para>
  <para style="q" vid="SNG 5:8">lun luagu láfaruñadina lan ínsiñeni.<verse eid="SNG 5:8" /></para>
  <para style="sp">Koru:</para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 5:9" />Káteigia katei buídubei luagu búmari,</para>
  <para style="q" vid="SNG 5:9">magadiñetu hadan magadiñetiña?</para>
  <para style="q" vid="SNG 5:9">Ka katei buiti luágubei búmari bálugunbei</para>
  <para style="q" vid="SNG 5:9">wama lun wadügüni füramasei le bun?<verse eid="SNG 5:9" /></para>
  <para style="sp">Tuguya:</para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 5:10" />Magadiñeti númari ani here ligía,</para>
  <para style="q" vid="SNG 5:10">úati libe hadan diisi milu eyeriñu.<verse eid="SNG 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 5:11" />Ítara liña ligibebu kei golu fínuti,</para>
  <para style="q" vid="SNG 5:11">güraguati lídiburi,</para>
  <para style="q" vid="SNG 5:11">wuriti lídiburi kei aban sanadi;<verse eid="SNG 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 5:12" />ítara liña lagu kei unhun,</para>
  <para style="q" vid="SNG 5:12">unhun harutiña kei míligi,</para>
  <para style="q" vid="SNG 5:12">rara lubadu aban lagei duna;<verse eid="SNG 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 5:13" />ítara liña lubuyubu kei</para>
  <para style="q" vid="SNG 5:13">fuluri-agei wéiriti le ñein lumuti</para>
  <para style="q" vid="SNG 5:13">fuluri le buiti líhemen.</para>
  <para style="q" vid="SNG 5:13">Ítara liña liyumaaru kei fuluri</para>
  <para style="q" vid="SNG 5:13">le uéigiñeti lédedeha mira;<verse eid="SNG 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 5:14" />Ítara liña lúhabu kei bángüli le lauti Topasiu;</para>
  <para style="q" vid="SNG 5:14">ítara liña lúgubu kei marüfíli le írichawaguaali</para>
  <para style="q" vid="SNG 5:14">le afurarúati lau Safiru;<verse eid="SNG 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 5:15" />Ítara liña lúruna kei wagabu le lauti márümolu</para>
  <para style="q" vid="SNG 5:15">ligibuagu ebu le golu;</para>
  <para style="q" vid="SNG 5:15">ítara liña laríawagun kei hibúari Líwanuna;<verse eid="SNG 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 5:16" />bímeti liyumulugu,</para>
  <para style="q" vid="SNG 5:16">Uámaati sun le luágubei nun!</para>
  <para style="b" vid="SNG 5:16" />
  <para style="q" vid="SNG 5:16">Ítara liña númari, ítara liña numada</para>
  <para style="q" vid="SNG 5:16">hiñaruñu Herusalénna.<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="sp">Koru:</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 6:1" />Haliñoun san lidin búmari,</para>
  <para style="q" vid="SNG 6:1">magadiñetu hadan magadiñetiña?</para>
  <para style="q" vid="SNG 6:1">Haliñoun lárügüda?</para>
  <para style="q" vid="SNG 6:1">Wéibuga buma áluahei!<verse eid="SNG 6:1" /></para>
  <para style="sp">Tuguya:</para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 6:2" />Lufulurin-ágeirugun númari lidin,</para>
  <para style="q" vid="SNG 6:2">lidoun lufulurin-agei le buídubei íhemen</para>
  <para style="q" vid="SNG 6:2">óunigiraña lilügüniña mudún,</para>
  <para style="q" vid="SNG 6:2">luma átüha fuluri.<verse eid="SNG 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 6:3" />Lani númari nuguya nani giñe ligía.</para>
  <para style="q" vid="SNG 6:3">Góunigi lumutiña libiñanigu labadinagua fuluri.<verse eid="SNG 6:3" /></para>
  <para style="s1">Liseingün uremu</para>
  <para style="sp">Ligía:</para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 6:4" />Buguya, númari,</para>
  <para style="q" vid="SNG 6:4">magadiñetibu kei uburugu Tirüsá luma Herusalén;</para>
  <para style="q" vid="SNG 6:4">wéirigutibu kei súdaragu ha eibu umutiña.<verse eid="SNG 6:4" /></para>
  <para style="s1">Lisisin uremu</para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 6:5" />Hebé baríagunina,</para>
  <para style="q" vid="SNG 6:5">áfaraha láadina bagu!</para>
  <para style="b" vid="SNG 6:5" />
  <para style="q" vid="SNG 6:5">Ítara liña bídiburi kei harahüñü gábara</para>
  <para style="q" vid="SNG 6:5">áhurerutiña hámagua luagu luwübüri Galaadü.<verse eid="SNG 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 6:6" />Ítara liña bari kei mudún ha sun liña hagoun,</para>
  <para style="q" vid="SNG 6:6">ha aranseña lun hasarúniwa.<verse eid="SNG 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 6:7" />Ítara liña bubuyubu kei bián tagu güranáda</para>
  <para style="q" vid="SNG 6:7">aramudagu tábugiñe bubelun.<verse eid="SNG 6:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="SNG 6:8" />Ǘrüwa wéinñanu urúeigu würiña,</para>
  <para style="q" vid="SNG 6:8">gádürü wein nubúalinigu</para>
  <para style="q" vid="SNG 6:8">hama saragu nibureingiña,<verse eid="SNG 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 6:9" />gama lumoun ábanrügüñoun nilügün unhun to úaboun mégeiti tuagu;</para>
  <para style="q" vid="SNG 6:9">ábanrügüñoun isaani to úati mégeiti tuagu</para>
  <para style="q" vid="SNG 6:9">to tagaraüdüboun túguchu.</para>
  <para style="q" vid="SNG 6:9">Dan harihinu würiña nibureingiña gúndaatiña tau;</para>
  <para style="q" vid="SNG 6:9">buiti hadimurehan urúeigu würiña hama ubúaligu tuagu.<verse eid="SNG 6:9" /></para>
  <para style="sp">Koru:</para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 6:10" />Katoun san to, to áfuriduboun kei weyu binaafin?</para>
  <para style="q" vid="SNG 6:10">Wéndetu kei hati, ámiriha tuguya kei weyu,</para>
  <para style="q" vid="SNG 6:10">wéirigutu kei súdaragu ha eibu umutiña!<verse eid="SNG 6:10" /></para>
  <para style="sp">Tuguya:</para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 6:11" />Ñǘdüntina dabíararugu le lani nogalesi</para>
  <para style="q" vid="SNG 6:11">aríaguei lin fulasu wayati;</para>
  <para style="q" vid="SNG 6:11">lun narihubei lan táhüchün beibei</para>
  <para style="q" vid="SNG 6:11">luma tílewe güranáda.<verse eid="SNG 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 6:12" />Lárigiñe, ibidiñehali nun ka lan asuseredubei</para>
  <para style="q" vid="SNG 6:12">nasubudiragunbei nungua tídanñadina aban karü lóubagiñe númari.<verse eid="SNG 6:12" /></para>
  <para style="sp">Koru:</para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 6:13" />Giribubá Sulamita, giribubá!</para>
  <para style="q" vid="SNG 6:13">Giribubá busentiwa warihinibu!</para>
  <para style="sp" vid="SNG 6:13">Tuguya:</para>
  <para style="q" vid="SNG 6:13">Kati habusenrubei harihin tuagu Sulamita?</para>
  <para style="sp" vid="SNG 6:13">Koru:</para>
  <para style="q" vid="SNG 6:13">Busentiwa warihini tabinahan kei kianpu-ágeirugu!<verse eid="SNG 6:13" /></para>
  <para style="b" />
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="sp">Ligía:</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 7:1" />Ma lubuidun burí bugudi tídangiñe bigeidin, liráü urúei!</para>
  <para style="q" vid="SNG 7:1">Wende buriti biyada kei luadigimari aban gadiñeti.<verse eid="SNG 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 7:2" />Ítara tiña bari kei aban weru róunuti</para>
  <para style="q" vid="SNG 7:2">le ñein tumuti diwéin súnwandan;</para>
  <para style="q" vid="SNG 7:2">ítara liña biranaagua kei láhabuchagun türigu geyegu fuluri lau.<verse eid="SNG 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 7:3" />Ítara liña baniguagu kei bián usari mádounu.<verse eid="SNG 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 7:4" />Ítara liña bigiina kei aban wáyelesi lauti marüfíli;</para>
  <para style="q" vid="SNG 7:4">ítara liña bagu kei bián lagei duna uburuguna Esübón</para>
  <para style="q" vid="SNG 7:4">lubadu lubenari Batü-rabimü;</para>
  <para style="q" vid="SNG 7:4">ítara liña bígiri kei luayelesin Líwanu</para>
  <para style="q" vid="SNG 7:4">le luágunbei uburugu Damasüku.<verse eid="SNG 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 7:5" />Ítara liña bichügü luagu búgubu kei luwübüri Karümélu.</para>
  <para style="q" vid="SNG 7:5">Ítara liña bídiburi kei tifilun gamisa funatu:</para>
  <para style="q" vid="SNG 7:5">Anihein aban urúei adaürǘwa labadinagua bídiburi!<verse eid="SNG 7:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="SNG 7:6" />Númari, würi bímetu,</para>
  <para style="q" vid="SNG 7:6">ma bumagadiñen!<verse eid="SNG 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 7:7" />Ítara liña besetirun kei aban tídibu yawara;</para>
  <para style="q" vid="SNG 7:7">ítara liña baniguagu kei tiresimun.<verse eid="SNG 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 7:8" />Busentina lun nawariruni tídibu yawara lun nárügüdüni tiresimun.</para>
  <para style="q" vid="SNG 7:8">Ítara lubati burí kei tiresimun beibei;</para>
  <para style="q" vid="SNG 7:8">ítara luba líhemen bawaragun kei tíhemen mansana;<verse eid="SNG 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 7:9" />ítara luba biyumulugu kei diwéin buitu</para>
  <para style="q" vid="SNG 7:9">to irirahaboun lau lámarun luéigiñe iyumaaru</para>
  <para style="q" vid="SNG 7:9">luma luéigiñe ari.<verse eid="SNG 7:9" /></para>
  <para style="sp">Tuguya:</para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 7:10" />Lani númari nuguya:</para>
  <para style="q" vid="SNG 7:10">Ani hínsiñetina lun.<verse eid="SNG 7:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="SNG 7:11" />Higabu númari, keimoun áraabu!</para>
  <para style="q" vid="SNG 7:11">Wásügürübei áriebu labadinagua fuluri le alühéña.<verse eid="SNG 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 7:12" />Wóudiba beibei-ágeirugu binaafin,</para>
  <para style="q" vid="SNG 7:12">ariha anhein egelewehaaru lubéi,</para>
  <para style="q" vid="SNG 7:12">anhein gínharu lubéi,</para>
  <para style="q" vid="SNG 7:12">anhein egelewehaaru lubéi güranáda.</para>
  <para style="q" vid="SNG 7:12">Ñeinba níchigei nínsiñe bun!<verse eid="SNG 7:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="SNG 7:13" />Ígiragüda tumuti mandürágora tíhemen.</para>
  <para style="q" vid="SNG 7:13">Anuhein sun tuwuyeri in webenari:</para>
  <para style="q" vid="SNG 7:13">To sáüharu tuma to sun liña tátügürüniwa</para>
  <para style="q" vid="SNG 7:13">to nadireiruboun areida bubá númari.<verse eid="SNG 7:13" /></para>
  <para style="b" />
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="q">
    <verse number="1" style="v" sid="SNG 8:1" />Nátidügü hamuga buguya,</para>
  <para style="q" vid="SNG 8:1">le tátagüdün núguchu!</para>
  <para style="q" vid="SNG 8:1">Lun hamuga dan lan le nadunragun buma ǘmada,</para>
  <para style="q" vid="SNG 8:1">aba hamuga nachuurunibu úouga kaba lan adüga bula nau;<verse eid="SNG 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 8:2" />nanügüñadibu hamuga túbiñoun núguchu,</para>
  <para style="q" vid="SNG 8:2">aba hamuga nebelaagüdünibu,</para>
  <para style="q" vid="SNG 8:2">buguya hamugati arufudaha nun.</para>
  <para style="q" vid="SNG 8:2">Nátagüdüña hamuga tubuidun-agei diwéin bun</para>
  <para style="q" vid="SNG 8:2">luma tira tin ninadüri güranáda.<verse eid="SNG 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 8:3" />Rulei lubaünan lábugiñe nichügü,</para>
  <para style="q" vid="SNG 8:3">lóuburaname lau lóunwenren!<verse eid="SNG 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 8:4" />Füramase humá nun hiñaruñu Herusalénna,</para>
  <para style="q" vid="SNG 8:4">luagu madüraagun hubéi lan lidabagu númari.</para>
  <para style="q" vid="SNG 8:4">Ígira huméi lun larumugun darí lásaarun.<verse eid="SNG 8:4" /></para>
  <para style="sp">Koru:</para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 8:5" />Katoun san to,</para>
  <para style="q" vid="SNG 8:5">to ñǘbuinboun lídangiñe fulasu mageirawati,</para>
  <para style="q" vid="SNG 8:5">balañu légewagu túmari?</para>
  <para style="sp" vid="SNG 8:5">Ligía:</para>
  <para style="q" vid="SNG 8:5">Agagudaha numuti lábugiñe aban tídibu mansana:</para>
  <para style="q" vid="SNG 8:5">Le ñein lubéi tagaridabu búguchu;</para>
  <para style="q" vid="SNG 8:5">le ñein lubéi tágurahabu búguchu.<verse eid="SNG 8:5" /></para>
  <para style="sp">Tuguya:</para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 8:6" />Barübana bürüñu tidan banigi,</para>
  <para style="q" vid="SNG 8:6">barübana bürüñu luagu barüna!</para>
  <para style="q" vid="SNG 8:6">Héreti ínsiñeni kei óunweni;</para>
  <para style="q" vid="SNG 8:6">dereti emeidini kei umúahaü.</para>
  <para style="q" vid="SNG 8:6">Ítara liña lisü ínsiñeni kei watu gemeti!<verse eid="SNG 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 8:7" />Ni lidunari sun barana,</para>
  <para style="q" vid="SNG 8:7">lásiñarubei ínsiñeni éñegucha;</para>
  <para style="q" vid="SNG 8:7">ni duna éibaaguati lásiñarubei giñe éñegucha.</para>
  <para style="q" vid="SNG 8:7">Anhein hamuga abusenra aban gürigia</para>
  <para style="q" vid="SNG 8:7">lasansiruni sun lirisin luagu ínsiñeni,</para>
  <para style="q" vid="SNG 8:7">adügǘwarügübei bula lau.<verse eid="SNG 8:7" /></para>
  <para style="sp">Koru:</para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 8:8" />Madagagili taniguagu wamulelua,</para>
  <para style="q" vid="SNG 8:8">kaba san wadüga tau danme hayabin amuriahoun?<verse eid="SNG 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 8:9" />Lun hamuga aban lan baríeiru tuguya,</para>
  <para style="q" vid="SNG 8:9">wábunaguña hamuga aban wáyelesi lauti pülata tóugiñe;</para>
  <para style="q" vid="SNG 8:9">lun hamuga aban lan bena tuguya,</para>
  <para style="q" vid="SNG 8:9">wafuraruñoun hamuga lau fulansu le hibúari.<verse eid="SNG 8:9" /></para>
  <para style="sp">Tuguya:</para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 8:10" />Ítara niña kei aban baríeiru,</para>
  <para style="q" vid="SNG 8:10">ítara liña nuri kei wáyelesi.</para>
  <para style="q" vid="SNG 8:10">Ligía darí naali lubéi ugundani ligibugiñe lagu.<verse eid="SNG 8:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="SNG 8:11" />Ñeinñein bugaha aban beibei-agei lani Salomón Baali-amón.</para>
  <para style="q" vid="SNG 8:11">Aba lígiruni lábugiñe haríaahan óunigirutiña,</para>
  <para style="q" vid="SNG 8:11">dan le lidaanihali alubahani</para>
  <para style="q" vid="SNG 8:11">ábaha lederegerun kada aban milu seinsu le pülata lun.<verse eid="SNG 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 8:12" />Mílugubei seinsu ligía, bani, Salomón,</para>
  <para style="q" vid="SNG 8:12">bián san houn óunigirutiña,</para>
  <para style="q" vid="SNG 8:12">nuguya óunigirubarun nubeibei-agei!<verse eid="SNG 8:12" /></para>
  <para style="sp">Ligía:</para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 8:13" />Ígiraba lun naganbuni bumalali lurúeite fuluri-agei!</para>
  <para style="q" vid="SNG 8:13">Agurabahatiña wamadagu haganbuni.<verse eid="SNG 8:13" /></para>
  <para style="sp">Tuguya:</para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 8:14" />Éibaaguaba númari, éibaaguaba kei aban usari,</para>
  <para style="q" vid="SNG 8:14">kei usari niburengili ligibuagu wübü buin lau íhemeni!<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>