<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HAB" style="id">ABAKUK.TXT (Encoding update 2008) 27/02/2001 CAP C.R, GARIFUNA</book>
  <para style="h">Abakúku</para>
  <para style="toc3">Abak</para>
  <para style="toc2">Abakúku</para>
  <para style="toc1">Abakúku</para>
  <para style="mt2">Liliburun</para>
  <para style="mt1">ABAKÚKU</para>
  <chapter number="1" style="c" sid="HAB 1" />
  <para style="ms">I. Ebelaagülei</para>
  <para style="mr">(<ref loc="HAB 1:1">1.1</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1" />Anihán uganu le larufudubei Wabureme lun Abakúku lidan aban uénedü.<verse eid="HAB 1:1" /></para>
  <para style="ms">II. Layanuhan Abakúku Luma Bungiu</para>
  <para style="mr">(<ref loc="HAB 1:2-2:4">1.2—2.4</ref>)</para>
  <para style="s1">Lekeharun Abakúku</para>
  <para style="q">
    <verse number="2" style="v" sid="HAB 1:2" />Bungiu Baba,</para>
  <para style="q" vid="HAB 1:2">ídaba san lásura nagúarahan amuriahei bídehan, móunabungabana?</para>
  <para style="q" vid="HAB 1:2">Ídaba san lásura nagúarahan ladüga anarimeni miábinga buguya esefurana?<verse eid="HAB 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HAB 1:3" />Ka san uagu barihagüdana saragu idiheri luma wuribani?</para>
  <para style="q" vid="HAB 1:3">Geyeguniña lau anarimeni luma günringuaü;</para>
  <para style="q" vid="HAB 1:3">anihein wuribu lidan sun fulasu.<verse eid="HAB 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HAB 1:4" />Magunfulirunti lúrudu, dügüwaguati irichaü,</para>
  <para style="q" vid="HAB 1:4">éibaaha hamutiña ha wuribabaña ha buídubaña,</para>
  <para style="q" vid="HAB 1:4">ligía madügǘniwa lubéi irichaü.<verse eid="HAB 1:4" /></para>
  <para style="s1">Lóunabagüle Wabureme</para>
  <para style="q">
    <verse number="5" style="v" sid="HAB 1:5" />Lariñahare Wabureme houn Ísüraelina:</para>
  <para style="q" vid="HAB 1:5">«Ariha humá houn néchanigu ha geyegubaña hau;</para>
  <para style="q" vid="HAB 1:5">ariha humá houn hanufudegua humaamuga.</para>
  <para style="q" vid="HAB 1:5">Ánhaadina lun nadügün katei le burí mafiñenbadün hamuga luagu</para>
  <para style="q" vid="HAB 1:5">anhein abahüdawagúa hun.<verse eid="HAB 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HAB 1:6" />Le lunbei nadügüni,</para>
  <para style="q" vid="HAB 1:6">nawuribuhagüdaaña Babilóniana, gürigia fásitiña,</para>
  <para style="q" vid="HAB 1:6">ha aransebaña súnwandan lun héibuguni ubóu,</para>
  <para style="q" vid="HAB 1:6">lúmagiñe luéigiñe aban oubaü lun luagun le aban,</para>
  <para style="q" vid="HAB 1:6">lun hóuyedun lau múa le mama hani.<verse eid="HAB 1:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="HAB 1:7" />«Hanufudewati hawéi, hanarime hagía,</para>
  <para style="q" vid="HAB 1:7">lúnrügüñein halurudun hánhara.<verse eid="HAB 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HAB 1:8" />Óufutiña hagabayun sügǘ hau leoparüdu,</para>
  <para style="q" vid="HAB 1:8">gáñitiña sügǘ hau ounli áraabuna</para>
  <para style="q" vid="HAB 1:8">ha lídanbaña fulasu mageirawati.</para>
  <para style="q" vid="HAB 1:8">Gíbetiña hánigu ha gagalufehatiña,</para>
  <para style="q" vid="HAB 1:8">ani fureseti hagalufehan,</para>
  <para style="q" vid="HAB 1:8">dísegiñe hayabin, aba hábürühan luagun hágani,</para>
  <para style="q" vid="HAB 1:8">kei tábürühan ágila luagun tíliru.<verse eid="HAB 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HAB 1:9" />Dan le hásügürün günringua hamuti sun le hadarirun habarua,</para>
  <para style="q" vid="HAB 1:9">Dan le hawanserun hanufudewati hawéi,</para>
  <para style="q" vid="HAB 1:9">gíbetimatiña hadaürün</para>
  <para style="q" vid="HAB 1:9">sügǘ lau sagoun le lárubei beya.<verse eid="HAB 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HAB 1:10" />Adügatiña bula hau urúeigu</para>
  <para style="q" vid="HAB 1:10">luma hau gürigia íñugutiña.</para>
  <para style="q" vid="HAB 1:10">Éherahatiña lau burí uburugu le ayarawaguati lau dübü,</para>
  <para style="q" vid="HAB 1:10">adügatiña burichi ligibugiñe aba hárügüdüni.<verse eid="HAB 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HAB 1:11" />Lárigiñe aba hásügürün kei aban hiriri;</para>
  <para style="q" vid="HAB 1:11">mabungiutetiña amu luéidigia here guánarügü».<verse eid="HAB 1:11" /></para>
  <para style="s1">Lekeharunya Abakúku</para>
  <para style="q">
    <verse number="12" style="v" sid="HAB 1:12" />Nabureme, ma funagia abunhein gumugua dan,</para>
  <para style="q" vid="HAB 1:12">Nubungiute le sándubei le móunwedadibei?</para>
  <para style="q" vid="HAB 1:12">Nubungiute le ágüdahabalina,</para>
  <para style="q" vid="HAB 1:12">rúhadibu erei houn Babilóniana lun hagíaba lan abeichawa.<verse eid="HAB 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HAB 1:13" />Wéiriti baruman,</para>
  <para style="q" vid="HAB 1:13">siñati bánharun lun wuribani,</para>
  <para style="q" vid="HAB 1:13">siñati bagundaarun lau barihini wuribani;</para>
  <para style="q" vid="HAB 1:13">ida liñati maní bubéi dan barihiniña gáfarahatiña,</para>
  <para style="q" vid="HAB 1:13">maní buguya sun añaha lan ha wuribabaña</para>
  <para style="q" vid="HAB 1:13">agünrinchaguaña ha buítimabaña hawéi?<verse eid="HAB 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HAB 1:14" />Ka san uagu bóuseraña gürigia</para>
  <para style="q" vid="HAB 1:14">kamá hamuga úduraü baranahana,</para>
  <para style="q" vid="HAB 1:14">kamá animaalugu magumadirúntiña?<verse eid="HAB 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HAB 1:15" />Barǘ hamutiña Babilóniana híbiri néchanigu</para>
  <para style="q" vid="HAB 1:15">kei lanügüniña óuchahati úduraü.</para>
  <para style="q" vid="HAB 1:15">Ragǘ lumutiña tau seni luma lau günwi,</para>
  <para style="q" vid="HAB 1:15">lárigiñe, dan larihiniña súngubei lidan aban,</para>
  <para style="q" vid="HAB 1:15">aba lagundaarun.<verse eid="HAB 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HAB 1:16" />Ligía tínsiñebei lisenin óuchahati lun tuma lirünhüre,</para>
  <para style="q" vid="HAB 1:16">adügati adagaragüdüni,</para>
  <para style="q" vid="HAB 1:16">águdaha ligía kupali lidan hiri,</para>
  <para style="q" vid="HAB 1:16">ladüga hagía íchugubaña éigini buiti ani gíbeti lun.<verse eid="HAB 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HAB 1:17" />Ítarameme haba san Babilóniana añugawa tau hasenin?</para>
  <para style="q" vid="HAB 1:17">Ítarameme haba áfaragua gürigia magudemehabuga?<verse eid="HAB 1:17" /></para>
  <chapter eid="HAB 1" />
  <chapter number="2" style="c" sid="HAB 2" />
  <para style="s1">Lóunabuniya Wabureme Abakúku</para>
  <para style="q">
    <verse number="1" style="v" sid="HAB 2:1" />Agagudúañu nuba ítara keisi óunigihati lidan lubara,</para>
  <para style="q" vid="HAB 2:1">ariha kaba lan lariñaga Wabureme nun,</para>
  <para style="q" vid="HAB 2:1">kaba lan lóunabagüle lun nekeharun.<verse eid="HAB 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HAB 2:2" />Aba lóunabunina Bungiu, lariñaga nun:</para>
  <para style="b" vid="HAB 2:2" />
  <para style="q" vid="HAB 2:2">«Abürühabei le lunbei narufuduni bun,</para>
  <para style="q" vid="HAB 2:2">lun gayaraabei lan laliirúniwa buidu.<verse eid="HAB 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HAB 2:3" />Machülügili dan lun lagunfulirun uénedü le;</para>
  <para style="q" vid="HAB 2:3">gama lumoun lagunfuliruba.</para>
  <para style="q" vid="HAB 2:3">Agurababéi, íbini genege lan ladarasarun,</para>
  <para style="q" vid="HAB 2:3">lachülürüba lidan dan.<verse eid="HAB 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HAB 2:4" />Anihán uganubei:</para>
  <para style="q" vid="HAB 2:4">Máhatina houn ha barüguabaña houngua,</para>
  <para style="q" vid="HAB 2:4">ánhañati gürigia ha richaguabaña habagariduba luagu hafiñen».<verse eid="HAB 2:4" /></para>
  <para style="ms">III. Hasinun Babilóniana</para>
  <para style="mr">(<ref loc="HAB 2:5-20">2.5-20</ref>)</para>
  <para style="s1">Habeichún láganiñu Abakúku</para>
  <para style="q">
    <verse number="5" style="v" sid="HAB 2:5" />Lau sun gagarabaaguadi tan diwéin hawagun gürigia barügua tungua,</para>
  <para style="q" vid="HAB 2:5">lun meredebaña lan múnada.</para>
  <para style="q" vid="HAB 2:5">Ladüga wéirigüda tumuti hagülerugu kei umúahaü,</para>
  <para style="q" vid="HAB 2:5">ani makimuledaditiña kei óunweni,</para>
  <para style="q" vid="HAB 2:5">íbini hóundaraguni sun néchani houngua,</para>
  <para style="q" vid="HAB 2:5">óuyeda hagía lau sun ageiraü.<verse eid="HAB 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HAB 2:6" />Gama lumoun sun néchanigu ha agañeirúbaña</para>
  <para style="q" vid="HAB 2:6">hadügüba bula lau Babilónia,</para>
  <para style="q" vid="HAB 2:6">lau heremuhan lun ítara:</para>
  <para style="q" vid="HAB 2:6">«Fugiabu buguya le arisidubei lau le mama bani!</para>
  <para style="q" vid="HAB 2:6">Ídaba san lásura bóundaraguagüdüni irisini le bibihubei furedeirügü?»<verse eid="HAB 2:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="HAB 2:7" />Hachülürüba aguburahatiña bumoun danme magurabunbani,</para>
  <para style="q" vid="HAB 2:7">hagagudúba ha lúnbaña hagidarunibu lídangiñe bubara</para>
  <para style="q" vid="HAB 2:7">ábame hígirunibu surusu.<verse eid="HAB 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HAB 2:8" />Hóundaraguba néchanigu bubá,</para>
  <para style="q" vid="HAB 2:8">hasagarahabadibu kei basagarahaniña.</para>
  <para style="q" vid="HAB 2:8">Hafayeiragüdübadibu luagu sun áfarahani le badügübei,</para>
  <para style="q" vid="HAB 2:8">anarimeni léñaha badügübei fulasurugu</para>
  <para style="q" vid="HAB 2:8">lun burí uburugu hau sun lílana.<verse eid="HAB 2:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="HAB 2:9" />Fugiabu buguya le buíngüda báaruboun buban lau bíweru,</para>
  <para style="q" vid="HAB 2:9">lun besefurun luéi sun denchaü!<verse eid="HAB 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HAB 2:10" />Lau igaburi le babuinchagüdoun buban lau busiganu,</para>
  <para style="q" vid="HAB 2:10">ani günringuaadibu búniwagua lau bagünrinchagun saragu néchanigu.<verse eid="HAB 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HAB 2:11" />Íbini dübü luma fulansu le aubei tadügǘwa buban,</para>
  <para style="q" vid="HAB 2:11">lagúarahaba kóntüra buguya.<verse eid="HAB 2:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="HAB 2:12" />Fugiabu buguya le ábunagubalin buburugute</para>
  <para style="q" vid="HAB 2:12">ligibuagu áfarahani luma múarani!<verse eid="HAB 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HAB 2:13" />Buguya Babilónia, ladügüba Wabureme Suntigabafu</para>
  <para style="q" vid="HAB 2:13">lun mahuudun lan buadigimari luma lubucha buagu,</para>
  <para style="q" vid="HAB 2:13">sun buadigimari láguduba.<verse eid="HAB 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HAB 2:14" />Ladüga labuinchun sun ubóu lau</para>
  <para style="q" vid="HAB 2:14">lisubudinwa luéirigun Wabureme,</para>
  <para style="q" vid="HAB 2:14">ítara kei labuinchagüdüni duna barana.<verse eid="HAB 2:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="HAB 2:15" />Fugiabu buguya,</para>
  <para style="q" vid="HAB 2:15">le abacharuadagüdübaliña bubesinanigu</para>
  <para style="q" vid="HAB 2:15">lau bíchugun diwéin houn lun baríaguniña surusu!<verse eid="HAB 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HAB 2:16" />Leweñegua uéiriguni babuinchuba lau busiganu,</para>
  <para style="q" vid="HAB 2:16">lugundun látagüdübei Wabureme uniñein le lánina ligañi bun,</para>
  <para style="q" vid="HAB 2:16">ani ábame babacharuadun,</para>
  <para style="q" vid="HAB 2:16">ábameti lasansiragun buéirigun lun ǘnabugunime.<verse eid="HAB 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HAB 2:17" />Buguya áchuahabalin áraabu Líwanu,</para>
  <para style="q" vid="HAB 2:17">guentoti buguyaba agünrinchawagúa,</para>
  <para style="q" vid="HAB 2:17">buguya áfaragubaliña animaalugu,</para>
  <para style="q" vid="HAB 2:17">guentoti láfaraadibu anufudei hawéi.</para>
  <para style="q" vid="HAB 2:17">Lasusereduba le bun ladüga burí báfarahan</para>
  <para style="q" vid="HAB 2:17">luma burí anarimeni le badügübei ubouagu kóntüra burí</para>
  <para style="q" vid="HAB 2:17">uburugu hau sun lílana.<verse eid="HAB 2:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="HAB 2:18" />Ka san un hu lan aban guáriua?</para>
  <para style="q" vid="HAB 2:18">Ka san un hu tan aban iyawaü</para>
  <para style="q" vid="HAB 2:18">to anügübaliña gürigia lidoun iyeeni?</para>
  <para style="q" vid="HAB 2:18">Siñati hadimurehan guáriuagu;</para>
  <para style="q" vid="HAB 2:18">ida lubati gayara lan lemenigidun le adügübaliña hawagu?<verse eid="HAB 2:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="HAB 2:19" />Fugiabu buguya, le ariñagubei lun</para>
  <para style="q" vid="HAB 2:19">aban guáriua lauti wewe lun lagagudun,</para>
  <para style="q" vid="HAB 2:19">ariñaga buguya lun aban dübü mariñagaditi lun lararamun!</para>
  <para style="q" vid="HAB 2:19">Gayaraati funagia híchugun uganu?</para>
  <para style="q" vid="HAB 2:19">Siñati, ladüga mabagaritiña</para>
  <para style="q" vid="HAB 2:19">lau sun afurarúa hamá lau golu luma pülata!<verse eid="HAB 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="HAB 2:20" />Gama lumoun anihein Wabureme tidan litenpulun to sánduboun:</para>
  <para style="q" vid="HAB 2:20">Manila sun ubóu ligibugiñe!<verse eid="HAB 2:20" /></para>
  <chapter eid="HAB 2" />
  <chapter number="3" style="c" sid="HAB 3" />
  <para style="ms">IV. Leremun Abakúku</para>
  <para style="mr">(<ref loc="HAB 3:1-19">3.1-19</ref>)</para>
  <para style="s1">Lafurieidun Abakúku</para>
  <para style="q">
    <verse number="1" style="v" sid="HAB 3:1" />Aba lafurieidun profeta Abakúku.<verse eid="HAB 3:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="HAB 3:2" />Le naganbubei bibügürü, Bungiu,</para>
  <para style="q" vid="HAB 3:2">luma luagu sun le adüga báalibei,</para>
  <para style="q" vid="HAB 3:2">buíngüda lumutina lau óunwenbu inebesei bun.</para>
  <para style="q" vid="HAB 3:2">Adügabéi luéinamun burí katei le meha badügübei lidan amu dan</para>
  <para style="q" vid="HAB 3:2">lidan wabagari guentó,</para>
  <para style="q" vid="HAB 3:2">subudi wamaamugei giñe.</para>
  <para style="q" vid="HAB 3:2">Arufudabéi bugudemehabu woun íbini labadinagua bigañi.<verse eid="HAB 3:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="HAB 3:3" />Anite Bungiu lóubawagugiñe Temán;</para>
  <para style="q" vid="HAB 3:3">luéigiñe wübü Parán liabin Bungiu le sándubei.</para>
  <para style="q" vid="HAB 3:3">Anihein luéirigun lidan sun sielu,</para>
  <para style="q" vid="HAB 3:3">buinti sun ubóu lau uremu lun.<verse eid="HAB 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HAB 3:4" />Anite hóuburagu larugounga miriti lau,</para>
  <para style="q" vid="HAB 3:4">áfurihati labirihaniga lúhaburugugiñe</para>
  <para style="q" vid="HAB 3:4">le ñein lubéi laramudagua ubafu le lídanbei.<verse eid="HAB 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HAB 3:5" />Ñǘdünti igei hanufunati lubá lubá,</para>
  <para style="q" vid="HAB 3:5">sandi gáfarahati lárigi lárigi.<verse eid="HAB 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HAB 3:6" />Adadagarati múa dan le lararamagun Bungiu,</para>
  <para style="q" vid="HAB 3:6">adadagaratiña gürigia dan le lariaguniña;</para>
  <para style="q" vid="HAB 3:6">héiguati burí binadu áraabu,</para>
  <para style="q" vid="HAB 3:6">gumugua ligía burí binadu wübü,</para>
  <para style="q" vid="HAB 3:6">gama lumoun lémeri Bungiu, magumuchaditi.<verse eid="HAB 3:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="HAB 3:7" />Ariha naaña lílana Kusán lidan lamiselu,</para>
  <para style="q" vid="HAB 3:7">lílana Madián muñugu lau anufudei.<verse eid="HAB 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HAB 3:8" />Wabureme, gáñihadibu san luma duna éibaaguati?</para>
  <para style="q" vid="HAB 3:8">Gáñihadibu san luma barana?</para>
  <para style="q" vid="HAB 3:8">Ligía san bawarirunbei hawagun bigabayun,</para>
  <para style="q" vid="HAB 3:8">diná buguya tidoun bikarün?<verse eid="HAB 3:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="HAB 3:9" />Aranse baali tebu bigimaran</para>
  <para style="q" vid="HAB 3:9">ani setibóun sun bigimaran.</para>
  <para style="q" vid="HAB 3:9">Abouha baali múa lau duna éibaaguati.<verse eid="HAB 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HAB 3:10" />Adadagarati áraabu dan larihinibu;</para>
  <para style="q" vid="HAB 3:10">ábürühati huya gárati siélugiñe,</para>
  <para style="q" vid="HAB 3:10">ahuuhati barana, iñuraha ligía luéinamun lugudi.<verse eid="HAB 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HAB 3:11" />Máfuridunti weyu luma hati lídangiñe haramudaguagüle</para>
  <para style="q" vid="HAB 3:11">ladüga támirihan bigimaran luma laduranhan barufunte.<verse eid="HAB 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HAB 3:12" />Éibuga bumuti sun ubóu lidan basafaragun,</para>
  <para style="q" vid="HAB 3:12">dügügua bumutiña néchanigu lidan bigañi.<verse eid="HAB 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HAB 3:13" />Furihadibu íderaguaña bumutuniña luma</para>
  <para style="q" vid="HAB 3:13">íderaguei urúei le banúadirubei.</para>
  <para style="q" vid="HAB 3:13">Günringua baaru luban le salufuribei,</para>
  <para style="q" vid="HAB 3:13">lúmagiñe tugudina chülǘ tábulugun.<verse eid="HAB 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HAB 3:14" />Áfara bumuti hábuti súdara tau ligimaran guánarügü,</para>
  <para style="q" vid="HAB 3:14">dan le hawanserun lánigu kei aban lanarime lere dan</para>
  <para style="q" vid="HAB 3:14">lun hábürühan wawagun,</para>
  <para style="q" vid="HAB 3:14">ñǘbuintiña lau pantaü abusenra hagünrinchaguniwa,</para>
  <para style="q" vid="HAB 3:14">kei dan le lafarún aban gudemeti.<verse eid="HAB 3:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="HAB 3:15" />Agalufehatibu baranaha hau bigabayun,</para>
  <para style="q" vid="HAB 3:15">hakutagüda bumuti barana dan le básügürün.<verse eid="HAB 3:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="HAB 3:16" />Dan naganbuni sun le aba nanufudedagun.</para>
  <para style="q" vid="HAB 3:16">Aba ladadagarun niyumaaru,</para>
  <para style="q" vid="HAB 3:16">siñá lágüdahanina núruna,</para>
  <para style="q" vid="HAB 3:16">aba leferidiruni sun núgubu lere.</para>
  <para style="q" vid="HAB 3:16">Lau sun lira,</para>
  <para style="q" vid="HAB 3:16">nagurabahaba darangilu darime lachülürün weyu</para>
  <para style="q" vid="HAB 3:16">lun ladiheridagüdüniña Wabureme</para>
  <para style="q" vid="HAB 3:16">hasudaranigu ha íchugubaña lidere dan woun.<verse eid="HAB 3:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17-18" style="v" sid="HAB 3:17-18" />Ábameti nabuinchun lau ugundani</para>
  <para style="q" vid="HAB 3:17-18">ladüga Nabureme le nesefuragüle.</para>
  <para style="q" vid="HAB 3:17-18">Nalawahabei íbini megelewehan tan tídibu igu,</para>
  <para style="q" vid="HAB 3:17-18">magindun tuguya beibei luma tídibu oliwu;</para>
  <para style="q" vid="HAB 3:17-18">íbini malubahóun lan ichari;</para>
  <para style="q" vid="HAB 3:17-18">íbini hagumuchun mudún hama bágasu.<verse eid="HAB 3:17-18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="HAB 3:19" />Ladüga ruti Wabureme erei nun,</para>
  <para style="q" vid="HAB 3:19">óufugüda lumuti núruna kei aban usari,</para>
  <para style="q" vid="HAB 3:19">ani barǘ lumutina lidoun fulasu</para>
  <para style="q" vid="HAB 3:19">le ñein lubéi séfuñunuba lan.<verse eid="HAB 3:19" /></para>
  <chapter eid="HAB 3" />
</usx>