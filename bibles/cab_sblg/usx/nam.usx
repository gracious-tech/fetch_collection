<usx version="3.0">
  <book code="NAM" style="id">NAUM.TXT (Encoding update 2008) 27/02/2001 CAP C.R, GARIFUNA</book>
  <para style="h">Naún</para>
  <para style="toc3">Naún</para>
  <para style="toc2">Naún</para>
  <para style="toc1">Naún</para>
  <para style="mt2">Liliburun</para>
  <para style="mt1">NAÚN</para>
  <chapter number="1" style="c" sid="NAM 1" />
  <para style="ms">I. Laguseragüdüni Bungiu Níniwe</para>
  <para style="mr">(<ref loc="NAM 1:1-15">1.1-15</ref>)</para>
  <para style="s1">Ligañi Wabureme lun Níniwe</para>
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1" />Anihán uganu luáguti Níniwe le larufudubei Wabureme lun Naún le Elikósuna lidan aban uénedü.<verse eid="NAM 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="NAM 1:2" />Magundanti Wabureme hau amu búngiugu,</para>
  <para style="q" vid="NAM 1:2">adügati wuribani houn ha awügürihóutiña lun,</para>
  <para style="q" vid="NAM 1:2">hanarime ligía ligañi hama láganiñu.<verse eid="NAM 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="NAM 1:3" />Gaguraasunti Wabureme lau sun lira gabafuti,</para>
  <para style="q" vid="NAM 1:3">ani mígirun lubéi le gadurunbei mabeichúnga.</para>
  <para style="b" vid="NAM 1:3" />
  <para style="q" vid="NAM 1:3">Éibugati Wabureme ligibuagu luriban dan,</para>
  <para style="q" vid="NAM 1:3">ani dúeri kaliki le liñurahabei lugudi.<verse eid="NAM 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NAM 1:4" />Ébecha lumuti barana, aba lamabeidagüdüni.</para>
  <para style="q" vid="NAM 1:4">Mábeigüda lumuti sun duna éibaaguati.</para>
  <para style="q" vid="NAM 1:4">Saüti burí lisagadin Basán luma wübü Karümélu,</para>
  <para style="q" vid="NAM 1:4">saüti giñe burí lufulurin Líwanu.<verse eid="NAM 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="NAM 1:5" />Adadagarati burí áraabu ligibugiñe Wabureme;</para>
  <para style="q" vid="NAM 1:5">rǘrüguati burí wübü liñúarü.</para>
  <para style="q" vid="NAM 1:5">Ánhinhati múa dan le larihini;</para>
  <para style="q" vid="NAM 1:5">sun ubóu hau sun ha lídanbaña.<verse eid="NAM 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="NAM 1:6" />Kábati gayara lerederun rara ligibugiñe ligañi Wabureme?</para>
  <para style="q" vid="NAM 1:6">Kaba gayara lawanduni ligañi?</para>
  <para style="q" vid="NAM 1:6">Ítara liña ligañi kei watu gemeti,</para>
  <para style="q" vid="NAM 1:6">fánreinguati burí dübü wéinamuti ligibugiñe lidan bián murusun.<verse eid="NAM 1:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="NAM 1:7" />Buiti Wabureme;</para>
  <para style="q" vid="NAM 1:7">aramudaguagülei ligía lidan lidaani idiheri,</para>
  <para style="q" vid="NAM 1:7">góunigi lumutiña ha afiñebaña luagu.<verse eid="NAM 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NAM 1:8" />Gama lumoun günringua lumutiña ha awügürihóutiña lun</para>
  <para style="q" vid="NAM 1:8">ítara kei lanügüni lere duna sun le ladarirun lubarua;</para>
  <para style="q" vid="NAM 1:8">ítara luba giñe lárügüdüniña luburiga láganiñu.<verse eid="NAM 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NAM 1:9" />Ka wuribati hasaminarubei hadügün lun Wabureme?</para>
  <para style="q" vid="NAM 1:9">Lagünrinchagubadün sunsuinagubei!</para>
  <para style="q" vid="NAM 1:9">Úati ni aban gayaraati lawügürihóun lun bián wéiyaasu!<verse eid="NAM 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="NAM 1:10" />Ladüga háguduba sunsuinagubei</para>
  <para style="q" vid="NAM 1:10">kei hiiyu le gürawaguati, kei sagadi sáühali.<verse eid="NAM 1:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="NAM 1:11" />Níniwe, bídangiñe láfurida</para>
  <para style="q" vid="NAM 1:11">le aritagubei ladügün wuribati lun Wabureme.</para>
  <para style="q" vid="NAM 1:11">Aban eweridihati wuribati.<verse eid="NAM 1:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="NAM 1:12" />Ligía lariñagunbei Wabureme houn lumutuniña:</para>
  <para style="q" vid="NAM 1:12">«Lau sun here hamá Asiriana ani gibe hagía,</para>
  <para style="q" vid="NAM 1:12">hagünrinchawaguba ani hagumuchaguba.</para>
  <para style="q" vid="NAM 1:12">Súfurigüda náadibu,</para>
  <para style="q" vid="NAM 1:12">gama lumoun masufuriragüdündigia náadibu.<verse eid="NAM 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="NAM 1:13" />Nagünrinchagubei anügüni le buágubei</para>
  <para style="q" vid="NAM 1:13">tumuguanéime güringüri le aubei bagürawagua».<verse eid="NAM 1:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="NAM 1:14" />Ariñagati Wabureme bibügürü,</para>
  <para style="q" vid="NAM 1:14">buguya lurúeite Níniwe:</para>
  <para style="q" vid="NAM 1:14">«Madügawagunbadibu lun laritawagún luagun biri,</para>
  <para style="q" vid="NAM 1:14">nagünrinchagubaña guáriuagu hama burí iyawaü</para>
  <para style="q" vid="NAM 1:14">ha tídanbaña litenpulun bubungiute,</para>
  <para style="q" vid="NAM 1:14">ani ñeinba nábunabu ladüga mebegitibu ni kata».<verse eid="NAM 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="NAM 1:15" />Ariha humá!</para>
  <para style="q" vid="NAM 1:15">Anitén le anügübei uganu libügürü darangilaü,</para>
  <para style="q" vid="NAM 1:15">éibugeina ligibuagu wübü!</para>
  <para style="q" vid="NAM 1:15">Efeduhabéi bufedun, Hudá;</para>
  <para style="q" vid="NAM 1:15">gúnfulibei le füramase bubéi.</para>
  <para style="q" vid="NAM 1:15">Madügündigiaaña wuribatiña ni kata bau;</para>
  <para style="q" vid="NAM 1:15">günrinwaguaaña sunsuinagubei.<verse eid="NAM 1:15" /></para>
  <chapter eid="NAM 1" />
  <chapter number="2" style="c" sid="NAM 2" />
  <para style="ms">II. Lábürühan Níniwe</para>
  <para style="mr">(<ref loc="NAM 2-3">2—3</ref>)</para>
  <para style="q">
    <verse number="1" style="v" sid="NAM 2:1" />Níniwe, anite aban agünrinchaguti buagun.</para>
  <para style="q" vid="NAM 2:1">Warigüdabaña óunigirutiña luagun biderebugu!</para>
  <para style="q" vid="NAM 2:1">Ruba aríaahati ǘmadarugu!</para>
  <para style="q" vid="NAM 2:1">Güraboun befeinte!</para>
  <para style="q" vid="NAM 2:1">Óundarabei bere!<verse eid="NAM 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="NAM 2:2" />Lugundun lagiribudagüdübei Wabureme luéirigun Hakobu,</para>
  <para style="q" vid="NAM 2:2">luéirigun Ísüraeli,</para>
  <para style="q" vid="NAM 2:2">kei lubéi meha lubaragiñebei lasagarahóun</para>
  <para style="q" vid="NAM 2:2">aba ligirún kei lídibu beibei le malimunti.<verse eid="NAM 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="NAM 2:3" />Funati idaüdinaü le hanügübei báganiñu,</para>
  <para style="q" vid="NAM 2:3">funatu giñe hadaüragun hasudaranigu.</para>
  <para style="q" vid="NAM 2:3">Aranseña lun wuribu!</para>
  <para style="q" vid="NAM 2:3">Ítara tiña hakarün kamá hamuga lautu watu gemeti;</para>
  <para style="q" vid="NAM 2:3">mederaguagüdünhaña hagabayun.<verse eid="NAM 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NAM 2:4" />Éibaaguañahatiña karü ǘmada</para>
  <para style="q" vid="NAM 2:4">luéigiñe aban oubaü lun luagun aban párükerugu,</para>
  <para style="q" vid="NAM 2:4">ítara tiña burí kei tochi durunguti,</para>
  <para style="q" vid="NAM 2:4">awireihatu kei labirihaniga.<verse eid="NAM 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="NAM 2:5" />Wati urúei houn lani úfisigu,</para>
  <para style="q" vid="NAM 2:5">aba habuguchagun hawougua</para>
  <para style="q" vid="NAM 2:5">dan le héibaagun luagun baríeiru,</para>
  <para style="q" vid="NAM 2:5">lidoun aramudaguagülei le aranselibei.<verse eid="NAM 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="NAM 2:6" />Darati burí lubenari duna éibaaguati</para>
  <para style="q" vid="NAM 2:6">aba tábürühan palasiu.<verse eid="NAM 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="NAM 2:7" />Barüwatu urúei tageiragiñe lun tadaürǘniwa;</para>
  <para style="q" vid="NAM 2:7">ñǘdüntiña tumusuniña tuma,</para>
  <para style="q" vid="NAM 2:7">áünheina kei unhun,</para>
  <para style="q" vid="NAM 2:7">ayahua hagía áfaraheinei haniguagu.<verse eid="NAM 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NAM 2:8" />Kei lésehan duna tídangiñe aban püresa to fuduharu,</para>
  <para style="q" vid="NAM 2:8">ítara liña hanurahan lílana Níniwe.</para>
  <para style="q" vid="NAM 2:8">«Ráramagua humá! Giribu humá!»</para>
  <para style="q" vid="NAM 2:8">Ítara liña laguarahóun houn,</para>
  <para style="q" vid="NAM 2:8">gama lumoun úati ni aban agiribuduti.<verse eid="NAM 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NAM 2:9" />Íweruha huméi pülata! Íweruha huméi golu!</para>
  <para style="q" vid="NAM 2:9">Mébehati lirisin Níniwe!<verse eid="NAM 2:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="NAM 2:10" />Günrinwagua Níniwe, málougaali ñein.</para>
  <para style="q" vid="NAM 2:10">Günringuatu burí anigi lau anufudei,</para>
  <para style="q" vid="NAM 2:10">adadagarati igachürügü,</para>
  <para style="q" vid="NAM 2:10">féridi hamuti sun gürigia here,</para>
  <para style="q" vid="NAM 2:10">aba lasansiragun hagibu le hanufude.<verse eid="NAM 2:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="NAM 2:11" />Ka erederubei lídangiñe uburugu</para>
  <para style="q" vid="NAM 2:11">le meha ítarabei kei haban liñún?</para>
  <para style="q" vid="NAM 2:11">Chóuruguatiña meha liñún hau harahüñü houngua ñein;</para>
  <para style="q" vid="NAM 2:11">úati meha ni kata anufudedaguagüdütiña.<verse eid="NAM 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="NAM 2:12" />Ragǘ lumutiñaha liñún líliru,</para>
  <para style="q" vid="NAM 2:12">aba lafanreinhaniña tun liñún würi hau tirahüñü,</para>
  <para style="q" vid="NAM 2:12">buíngüda lumutuha luban hau íliru.<verse eid="NAM 2:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="NAM 2:13" />Lariñahare Wabureme Suntigabafu:</para>
  <para style="q" vid="NAM 2:13">«Anahán ya bibügürü:</para>
  <para style="q" vid="NAM 2:13">Nágudaaru burí bikarün to lánina wuribu,</para>
  <para style="q" vid="NAM 2:13">ábame nadügünu gumulelime;</para>
  <para style="q" vid="NAM 2:13">náfaraguaaña birahüñü;</para>
  <para style="q" vid="NAM 2:13">nagumuchuba lau íweru le bufulasunrugubei,</para>
  <para style="q" vid="NAM 2:13">maganbúndigiaalime hamalali anügütiña uganu bun».<verse eid="NAM 2:13" /></para>
  <chapter eid="NAM 2" />
  <chapter number="3" style="c" sid="NAM 3" />
  <para style="s1">Ayahuni luagu Níniwe</para>
  <para style="q">
    <verse number="1" style="v" sid="NAM 3:1" />Fugiabu buguya uburugu ñein lumuti</para>
  <para style="q" vid="NAM 3:1">hagundaara lau háwiyuragüdün hitaü,</para>
  <para style="q" vid="NAM 3:1">buin biña lau iyeeni luma anarimeni;</para>
  <para style="q" vid="NAM 3:1">ñein lubéi memegeirun lan áfarahani!<verse eid="NAM 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="NAM 3:2" />Aganba huméi lamuri abeihagülei,</para>
  <para style="q" vid="NAM 3:2">luma lumalali ubalabaü!</para>
  <para style="q" vid="NAM 3:2">Añatén gabayu tuma karü lánina wuribu éibaagueina!<verse eid="NAM 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="NAM 3:3" />Hageindaguña agalufehatiña tau eféin</para>
  <para style="q" vid="NAM 3:3">luma arufun miriti!</para>
  <para style="q" vid="NAM 3:3">Saragu haña óunwegutiña</para>
  <para style="q" vid="NAM 3:3">bürübünu úgubu hilaali!</para>
  <para style="q" vid="NAM 3:3">Chugeguatiña burí súdaragu hawagu!<verse eid="NAM 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NAM 3:4" />Sun le, ladügatimárügü tahoruhan horu magadiñetu to,</para>
  <para style="q" vid="NAM 3:4">méistara lidan abiñarahani,</para>
  <para style="q" vid="NAM 3:4">to eyeedaguboun gürigia luma burí néchani</para>
  <para style="q" vid="NAM 3:4">lau tahoruhan luma tabiñarahan.<verse eid="NAM 3:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="NAM 3:5" />Lariñahare Wabureme Suntigabafu:</para>
  <para style="q" vid="NAM 3:5">«Anahán bibügürü:</para>
  <para style="q" vid="NAM 3:5">Nárouchaguaaru bidunigun chülǘ bigibuagun</para>
  <para style="q" vid="NAM 3:5">ariha hamaamugabu néchanigu surusu,</para>
  <para style="q" vid="NAM 3:5">ariha láamugei burí arúeihani bibusigari.<verse eid="NAM 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="NAM 3:6" />Níchuguba iwiyei buagun</para>
  <para style="q" vid="NAM 3:6">nabuinchagüdübadibu lau busiganu,</para>
  <para style="q" vid="NAM 3:6">nadügüba lun baríawagun.<verse eid="NAM 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="NAM 3:7" />Sunme ha arihitibu,</para>
  <para style="q" vid="NAM 3:7">héibaaguba buéi ariñageina:</para>
  <para style="q" vid="NAM 3:7">“Günrinwagua Níniwe!”</para>
  <para style="q" vid="NAM 3:7">Kaba san gudemehabu lun?</para>
  <para style="q" vid="NAM 3:7">Halíaba san ladarira íchiguti dǘgüdaguaü lun?»<verse eid="NAM 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NAM 3:8" />Buídutimatibu funagia luéi Tébasi,</para>
  <para style="q" vid="NAM 3:8">uburugu le lubadubei duna Nilu,</para>
  <para style="q" vid="NAM 3:8">le aubei geyegu lan saragu duna</para>
  <para style="q" vid="NAM 3:8">ani ligía liderebugubei?<verse eid="NAM 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NAM 3:9" />Etiopía luma Ehiptu hagía meha lérebaña le mébehati;</para>
  <para style="q" vid="NAM 3:9">lílana Futu, ha Líwiana hagía meha lumadagubaña.<verse eid="NAM 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="NAM 3:10" />Lau sun lira, sagawati Tébasi lageiragiñe keisi adaürǘti;</para>
  <para style="q" vid="NAM 3:10">burewaguatiña lirahüñü luagu burí larigei üma;</para>
  <para style="q" vid="NAM 3:10">áhureratiña ubunuruni hawagu burí luwügüriñan ha íñugutiña,</para>
  <para style="q" vid="NAM 3:10">gürawaguatiña lábutigu lau güringüri.<verse eid="NAM 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="NAM 3:11" />Buguya, habacharuadagüdübadibu giñe,</para>
  <para style="q" vid="NAM 3:11">lálülüdüba bau áluaha baramudagun hawéi báganiñu.<verse eid="NAM 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="NAM 3:12" />Ítara liña sun biderebugu kei tídibu igu</para>
  <para style="q" vid="NAM 3:12">buin tau igu ñǘbürigiru,</para>
  <para style="q" vid="NAM 3:12">anhoun ánhingichua, tábürühan liyumulugun le éigitu.<verse eid="NAM 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="NAM 3:13" />Kamá hamuga würiña bisudaranigu;</para>
  <para style="q" vid="NAM 3:13">hunren liña lubenari uburugu lubá ágani;</para>
  <para style="q" vid="NAM 3:13">günringualá watu gemeti bidaünda.<verse eid="NAM 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="NAM 3:14" />Aransebá duna,</para>
  <para style="q" vid="NAM 3:14">gayara láamuga bawandun danme begeyedawagun;</para>
  <para style="q" vid="NAM 3:14">héregüdabeitima biderebugu.</para>
  <para style="q" vid="NAM 3:14">Beluba lidoun baribarabu,</para>
  <para style="q" vid="NAM 3:14">dügüguabéi gubegubeti,</para>
  <para style="q" vid="NAM 3:14">ragübei ladaaha ladiríyu.<verse eid="NAM 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="NAM 3:15" />Adügabéi yebe le badüga,</para>
  <para style="q" vid="NAM 3:15">lágudubadibu watu gemeti ñein,</para>
  <para style="q" vid="NAM 3:15">lagumuchaguagüdübadibu ágani sunsuinagubei</para>
  <para style="q" vid="NAM 3:15">kei lagumuchaguagüdüni chagagaru alubahani.</para>
  <para style="q" vid="NAM 3:15">Gánwounguaba kei chagagaru.<verse eid="NAM 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="NAM 3:16" />Gíbeguatiña meha adaagutiña marasun ha aganóubaña bidan</para>
  <para style="q" vid="NAM 3:16">sügǘ hau waruguma ha siélubaña.</para>
  <para style="q" vid="NAM 3:16">Guentó úaaña, ñǘdünguouga kei chagagaru.<verse eid="NAM 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="NAM 3:17" />Ítara haña búniri kei chagagaru;</para>
  <para style="q" vid="NAM 3:17">gíbetiña ha abudahabaña súdara bun</para>
  <para style="q" vid="NAM 3:17">ítara haña kei animaalugu mábutiña:</para>
  <para style="q" vid="NAM 3:17">Dan le diliga lan aba herederun badüleñu touba muna;</para>
  <para style="q" vid="NAM 3:17">dan le láfuridun weyu aba houdin;</para>
  <para style="q" vid="NAM 3:17">ani ibidiñewati haliñoun lan houdin.<verse eid="NAM 3:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="NAM 3:18" />«Lanarime san harumugun hóuniri bilügüniña mudún, lurúeite Asiria!</para>
  <para style="q" vid="NAM 3:18">Emeraaguatiña bani úfisigu,</para>
  <para style="q" vid="NAM 3:18">chagagu haña bisudaran áraabu,</para>
  <para style="q" vid="NAM 3:18">úati kaba lan óundaraguaña.<verse eid="NAM 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="NAM 3:19" />Máraninati biwounun;</para>
  <para style="q" vid="NAM 3:19">mareidaguati bugumein!</para>
  <para style="q" vid="NAM 3:19">Sun ha aganbubaña luagu bilamiserun</para>
  <para style="q" vid="NAM 3:19">apouhatiña háhabu lau ugundani,</para>
  <para style="q" vid="NAM 3:19">ladüga Kagia masufurirunbalin buriban le mébehabei?»<verse eid="NAM 3:19" /></para>
  <chapter eid="NAM 3" />
</usx>