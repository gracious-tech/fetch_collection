<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id">HENESISI.TXT (Encoding update 2008) 27/02/2001 CAP C.R, GARIFUNA</book>
  <para style="h">Agumesehani</para>
  <para style="toc3">Agu</para>
  <para style="toc2">Agumeseruni</para>
  <para style="toc1">Agumeseruni</para>
  <para style="mt2">Liliburun</para>
  <para style="mt1">AGUMESEHANI</para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="ms">I. Lagumeserun Sun Katei</para>
  <para style="mr">(<ref loc="GEN 1-11">1—11</ref>)</para>
  <para style="s1">Ladügüni Bungiu ubóu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1" />Dan le lagumeserunbei sun katei, aba ladügüni Bungiu sielu luma ubóu. <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />Magaburigili meha ubóu; larihín meha keisi aban barana huliliti daruguñu luburiga lau, anihánti buga lani Bungiu Sífiri ánhinha ligibuagu duna.<verse eid="GEN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 1:3" />Ábati lariñagun Bungiu:</para>
  <para style="p" vid="GEN 1:3">—Harugoungalá!</para>
  <para style="p" vid="GEN 1:3">Ábati larugoungadun. <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />Lídanbei larihini Bungiu luagu buidu lan larugounga, aba lafanreinraguni larugounga luéi luburiga, <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />aba líchugun liri larugounga «wéyuagu», líchiga liri luburiga «guñoun». Ítara liñati buga lagunfulirun furumiñeti weyu.<verse eid="GEN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 1:6" />Lárigiñe lira, lariñaga Bungiu:</para>
  <para style="p" vid="GEN 1:6">—Ñeinlá aban fánreinguaü labadinagua duna, lerederame líbiri duna ǘnabu líbiri iñu. Aba lasuseredun ítara.<verse eid="GEN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 1:7" />Aba lubeiti lafanreinraguni Bungiu duna, leredera líbiri ǘnabu líbiri iñu. <verse eid="GEN 1:7" /><verse number="8" style="v" sid="GEN 1:8" />Ábati líchugun liri fánreinguaü, lagúara lun «sielu». Ítara liñati buga lagunfulirun libiaman weyu.<verse eid="GEN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 1:9" />Ábayati lariñagun Bungiu:</para>
  <para style="p" vid="GEN 1:9">—Óundaraguala duna le lábugiñebei sielu lidan aban, ñein láamuga giñe fulasu mábeiti.</para>
  <para style="p" vid="GEN 1:9">Aba lasuseredun ítara. <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />«Múa» lubeiti iri le líchugubei Bungiu luagu fulasu le mábeibei, lagúareiti liri sun duna le óundarubei, «barana». Dan le larihini Bungiu buidu lan katei lira, <verse eid="GEN 1:10" /><verse number="11" style="v" sid="GEN 1:11" />aba lariñagun:</para>
  <para style="p" vid="GEN 1:11">—Hüchala sun luwuyeri nadü múarugu: Híduru le burí íchuguti ilaü luma burí tídibu wewe le gagindaditi.</para>
  <para style="p" vid="GEN 1:11">Ani ítara liña lasuseredun. <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />Aba labouchun sun luwuyeri nadü ligibuagu múa: Híduru le íchuguti ilaü luma burí tídibu wewe gagindaditi. Aba larihin Bungiu luagu buidu lan sun le. <verse eid="GEN 1:12" /><verse number="13" style="v" sid="GEN 1:13" />Ítara liñati buga lagunfulirun lǘrüwan weyu.<verse eid="GEN 1:13" /></para>
  <para style="p">
    <verse number="14-15" style="v" sid="GEN 1:14-15" />Ábayati lariñagun Bungiu:</para>
  <para style="p" vid="GEN 1:14-15">—Ñeinlá burí leiti sielu lun líchugun larugounga lidoun ubóu, fánreingua láamugei wéyuagu luéi guñoun, seriwi láamuga giñe lun larufuduni burí weyu, irumu luma burí uéyuri.</para>
  <para style="p" vid="GEN 1:14-15">Ani ítara liña lasuseredun. <verse eid="GEN 1:14-15" /><verse number="16" style="v" sid="GEN 1:16" />Adüga lumuti lubeiti Bungiu biángubei leiti. Le wéiritimabei lun líchugun larugounga wéyuagu, le ñǘraübei lun líchugun larugounga guñoun. Adüga lumutiña giñe waruguma. <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />Ru lumuti Bungiu leiti burí ligía siélurugu lun líchugun larugounga lun ubóu <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />wéyuagu kéisigubeirügü guñoun luma lun lafanreinraguni larugounga luéi luburiga, aba larihin luagu buidu lan lira. <verse eid="GEN 1:18" /><verse number="19" style="v" sid="GEN 1:19" />Ítara liñati buga lagunfulirun ligadürün weyu.<verse eid="GEN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 1:20" />Lárigiñe le aba lariñagun Bungiu:</para>
  <para style="p" vid="GEN 1:20">—Güriagualá duna sun hawuyeri animaalu ha abagaridubaña lidan, ñein hamá giñe dunuru lun háhamahan garabalirugu.</para>
  <para style="p" vid="GEN 1:20">Ani ítara liña lasuseredun.<verse eid="GEN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 1:21" />Aba ladügüniña Bungiu hanarime burí udu ha baranahabaña, hama sun hawuyeri animaalugu ha líchugubaña duna hama ha aganóubaña lidan, ani hama sun hawuyeri dunuru. Dan larihini Bungiu luagu buidu lan sun lira, <verse eid="GEN 1:21" /><verse number="22" style="v" sid="GEN 1:22" />aba labiniruniña animaalugu ha ladügübaña, lariñaga lau dimurei le:</para>
  <para style="p" vid="GEN 1:22">—Garahüñügua humá buíngüda huméi barana hau hirahüñü, ñein hamá giñe saragu dunuru ubouagu.<verse eid="GEN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 1:23" />Ítara liñati buga lagunfulirun liseingün weyu.<verse eid="GEN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 1:24" />Ábati lariñagun Bungiu:</para>
  <para style="p" vid="GEN 1:24">—Ñein hamá sun hawuyeri animaalugu ubouagu dandu ha ibiñanigu kéisigubeirügü ha áraabuna hama ha aduruuharügübaña múarugu.</para>
  <para style="p" vid="GEN 1:24">Aba lasuseredun ítara. <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />Adüga lumutiña Bungiu sun animaalugu ha, aba larihin luagu buidu lan le ladügübei. <verse eid="GEN 1:25" /><verse number="26" style="v" sid="GEN 1:26" />Aba lubeiti lariñagun:</para>
  <para style="p" vid="GEN 1:26">—Guentoti adüga waméi wügüri. Wenegebei, gabafubei hawagu úduraü, dunuru, ibiñanigu, animaalugu áraabuna hama sun ha aduruuharügübaña múarugu.<verse eid="GEN 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 1:27" />Dan le ladügünbalin Bungiu wügüri, lenege guánarügü ladügei, adüga lumuti wügüri adüga würi, <verse eid="GEN 1:27" /><verse number="28" style="v" sid="GEN 1:28" />aba labiniruniña lau dimurei le:</para>
  <para style="p" vid="GEN 1:28">—Garahüñügua humá saragu, buíngüda huméi ubóu hau hirahüñü ani gumadi huméi, gumadi humañame úduraü hama dunuru hama sun animaalugu ha aduruuharügübaña múarugu.<verse eid="GEN 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 1:29" />Lárigiñe aba lariñagun houn:</para>
  <para style="p" vid="GEN 1:29">—Ru numutu sun nadü to ubouaguboun hun to íchuguboun ilaü luma sun tídibu wewe to gagindadiboun. Leseriwiduba sun le hun lun heigin. <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />Ánheinti houn animaalu ha áraabuna hama ha aduruuharügübaña múarugu hama burí dunuru, híduru níchugubei houn lun ligíaba lan heiga.</para>
  <para style="p" vid="GEN 1:30">Ítara liña lubeiti lasuseredun. <verse eid="GEN 1:30" /><verse number="31" style="v" sid="GEN 1:31" />Aba larihin Bungiu luagu buidu lan sun le ladügübei. Ítara liñati buga lagunfulirun lisisin weyu.<verse eid="GEN 1:31" /></para>
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1" />Aba lagumuchun ladügǘn sielu luma ubóu, luma sun burí katei le lídanbei. <verse eid="GEN 2:1" /><verse number="2" style="v" sid="GEN 2:2" />Luagu lisedün weyu ligía lagumuchuni Bungiu sun katei le ladügübei, aba lemeraagun. <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />Ábati labiniruni lisedün weyu, aba lariñagun lun lareidúniwa, ladüga ligía lan weyu le ídanbei lemeraagua lárigiñe sun le ladügübei. <verse eid="GEN 2:3" /><verse number="4" style="v" sid="GEN 2:4" />Anihán asuseredubei lidan ladügǘn sielu luma ubóu.</para>
  <para style="s1" vid="GEN 2:4">Wügüri lidan Edén</para>
  <para style="p" vid="GEN 2:4">Lídanbei ladügüni Bungiu sielu luma ubóu, <verse eid="GEN 2:4" /><verse number="5" style="v" sid="GEN 2:5" />úagiru meha ni aban nadü, máhüchüngili giñe meha ni murusun híduru, ladüga máhuyagüdüngili lan meha Wabureme Bungiu huya ligibuagun múa, úa ligía meha kaba lan nadagimein múa ligía. <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />Lau sun lira furiti meha duna lábugiñegiñe múa lun láturaguni sun fulasu. <verse eid="GEN 2:6" /><verse number="7" style="v" sid="GEN 2:7" />Ábati ladügüni Wabureme Bungiu wügüri lídangiñe múa, aba líchugun ibagari lun, lau láfurun lígirugun. Ítara liña liabin wügüri lun gabagari lan.<verse eid="GEN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 2:8" />Lárigiñe aba lábunagun Wabureme Bungiu aban fuluri-agei luéigiñe oubaü le ñéingiñe lubéi laboucha weyu libiti Edén, aba líchuguni wügüri le buga ladügübei ñein. <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" />Aba giñe labouchagüdün sun tuwuyeri tídibu wewe to buíduburitu lun teigín. Lamidanguati fuluri-agei, aba giñe lábununu wewe to lánina ibagari, tuma wewe to lánina lasubudirúniwa buiti lumoun wuribati.<verse eid="GEN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 2:10" />Lurageirugu Edén, láhücha aban duna, le áturagubalin múa ligía, ñeinmeme lafanreinragúa lidan gádürü arünaü. <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />Le furumiñeti, Pisón meha líribei ligía egeyedagubei lau fulasu le gíribei Awilá, le ñein lubéi golu. <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />Fínuti golu le lídanbei fulasu ligía, anihein giñe tühü wewe fínuti ñein, luma dübü le ónise. <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />Le libiaman duna Gión meha líribei, ligía egeyedagubei lau fulasu le gíribei Kusu. <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />Le lǘrüwan duna Tígürisi meha líribei, ligía ásügürübei luéigiñe oubaü le ñéingiñe lubéi laboucha weyu libiti Asiria. Le ligadürün duna, Éufüratesi meha líribei.<verse eid="GEN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15" />Dan le líchugunbalin Wabureme Bungiu wügüri lidoun Edén, lun lábunaguni, luma lun lóunigiruni, <verse eid="GEN 2:15" /><verse number="16" style="v" sid="GEN 2:16" />aba líchuguni lúrudu le lun:</para>
  <para style="p" vid="GEN 2:16">—Gayaraati beigin tídangiñe tin sun wewe to yaaboun, <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />gama lumoun meigabóun tin wewe to lánina lasubudirúniwa le buídubei lumoun le wuribabei. Meigabóun tin wewe tuguya, ladüga anhoun beiga ninarün bau bóunweba.<verse eid="GEN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18" />Lárigiñe, lariñaga Wabureme Bungiu:</para>
  <para style="p" vid="GEN 2:18">—Mabuidunti lun lábuguarügü lan wügüri. Nadüga aban ídemuei lun lidan sun katei.<verse eid="GEN 2:18" /></para>
  <para style="p">
    <verse number="19-20" style="v" sid="GEN 2:19-20" />Ábati ladügüniña Wabureme Bungiu sun animaalugu hama sun dunuru lídangiñe múa, aba lanügüniña lun wügüri lun líchugun hiri. Aba líchugun wügüri hiri sun animaalugu ha áüdübüna, sun dunuru hama sun animaalugu ha áraabuna, íriti le líchugubei hawagu, ligía híribei dagá guentó. Lau sun lira úati ni aban hádangiñe eseriwiduti ídemueime lun lidan sun katei.<verse eid="GEN 2:19-20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 2:21" />Ábati lábürügüdüni Bungiu wügüri lidoun aban idabagu huliliti, danti aniha lan arumuga, aba lasagarun aban lídangiñe luruhure ábaya ladouraguni lǘgürügü lárigoun. <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />Aba ladügünu Wabureme Bungiu würi lídangiñe uruhurei ligía, aba larufudunu lun wügüri. <verse eid="GEN 2:22" /><verse number="23" style="v" sid="GEN 2:23" />Dan le larihinbarun wügüri, aba lariñagun:</para>
  <para style="b" vid="GEN 2:23" />
  <para style="q" vid="GEN 2:23">«Anati to, lídangiñetu nǘgürügü<optbreak /> luma nabu!</para>
  <para style="q" vid="GEN 2:23">“Würi” ligíaba tiri,</para>
  <para style="q" vid="GEN 2:23">ladüga lídangiñe wügüri<optbreak /> lasagaroun Bungiu».<verse eid="GEN 2:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="GEN 2:24" />Ligía lígirubei lubéi wügüri lúguchi tuma lúguchu, lun laganóun tuma lúmari, ábame hayabin lun ítara haba lan kei ábanrügü gürigia.<verse eid="GEN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 2:25" />Dandu wügüri keisi lúmari, surusu haña meha, ani úati nibusigari hamá.<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s1">Ladüraaguni wügüri lilurudun Bungiu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />Wéiriti tisumadin hewe hádangiñe sun animaalugu áraabuna ha ladügübaña Wabureme Bungiu, aba tariñagun tun würi:</para>
  <para style="p" vid="GEN 3:1">—Lariñahare lubeiti Bungiu hun lun meigin humá tídangiñe tin ni aban tídangiñe tídibu wewe ya fuluri-ágeirugu?<verse eid="GEN 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 3:2" />Aba tóunabunu würi:</para>
  <para style="p" vid="GEN 3:2">—Gayaraati weigin tídangiñe tin furumiñeguarügü tídibu wewe, <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />ánheinti tídangiñe tídibu wewe to lamidanguaboun fuluri-agei ariñagati Bungiu woun lun meigin wamá ni lun waguurun tuagu tin wewe tugía, ladüga ánhawa lan eiga tídangiñe wóunweguba.<verse eid="GEN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 3:4" />Gama lumoun aba tariñagun hewe tun würi:</para>
  <para style="p" vid="GEN 3:4">—Iyeeni lira. Móunwegunbadün. <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />Subudi lumuti Bungiu luagu danme lan heigin tídangiñe tin tídibu wewe tuguya, léfegechuba lan hagu lun hasubudiruni le buídubei luma le wuribabei, ábameti ítara humá kei Bungiu.<verse eid="GEN 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 3:6" />Kei tarihin würi luagu wende tan tin wewe tuguya, aba tawamadun tun lun téiginu luma lun tiabin lun léfegechun tagu lun tasubudiruni le buídubei luma le wuribabei. Aba lubeiti tátügürün aban tídangiñe, aba téiginu. Ñéingiñe aba tíchugun lun túmari, aba giñe leigin. <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />Lidan oura ligía, aba léfegechun hagu, aba hasubudiruni biángubei hagía luagu surusu haña lan. Ábati háfadaguagüdün tubana igu lun hadouragun haugua tau.<verse eid="GEN 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 3:8" />Dan le haganbunbalin éibugañaha lan Wabureme Bungiu ñein lidan fuluri-agei luagu láfuhan lidili garabali rábounweyu, aba héibaagun aramudagua luéi tabadinagua wewe fuluri-ágeirugu. <verse eid="GEN 3:8" /><verse number="9" style="v" sid="GEN 3:9" />Aba lagúarun Wabureme Bungiu lun wügüri, aba lálügüdüni:</para>
  <para style="p" vid="GEN 3:9">—Halíañadibu san?<verse eid="GEN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 3:10" />Aba lóunabun wügüri:</para>
  <para style="p" vid="GEN 3:10">—Aganbarügütina luagu abunhein lan éibugañaha fuluri-ágeirugu, aba nanufudedun, ladüga surusu niña lan; ligía naramudagunbei.<verse eid="GEN 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 3:11" />Ábati lálügüdüni Bungiu:</para>
  <para style="p" vid="GEN 3:11">—Kagia ariñagubei bun luagu surusu biña lan? Háfuga hóuhadibu tídangiñe tin wewe to ueiboun neweridirabu lun meigin banu?<verse eid="GEN 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 3:12" />Aba lóunabun wügüri:</para>
  <para style="p" vid="GEN 3:12">—Würi to bíchuguboun nun lun númarime, tuguya íchuguboun tídangiñe tin wewe tuguya nun, aba néiginu. <verse eid="GEN 3:12" /><verse number="13" style="v" sid="GEN 3:13" />Ábati lálügüdünu Wabureme Bungiu würi, lariñaga tun:</para>
  <para style="p" vid="GEN 3:13">—Ka uagu badügei?</para>
  <para style="p" vid="GEN 3:13">Aba tariñagun lun:</para>
  <para style="p" vid="GEN 3:13">—Hewe eyeedubalina ligía néiginbei tídangiñe tin wewe tuguya.<verse eid="GEN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />Ábati lariñagun Wabureme Bungiu tun hewe:</para>
  <para style="p" vid="GEN 3:14">—Íñarawaguañu buba hadan sun híbiri animaalugu luéigiñe le badügübei. Lúmagiñe uguñe lun lubaruaguóun aduruuharügüba múarugu béibuga, múaba giñe beiga. <verse eid="GEN 3:14" /><verse number="15" style="v" sid="GEN 3:15" />Níchuguba gáganiguaü bidoun tuma würi, hadoun badügawagun hama tadügawagun. Hachuinrubei tadügawagun bábulugu, bágüreime lihilin hagudi.<verse eid="GEN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 3:16" />Lariñaga tun würi:</para>
  <para style="p" vid="GEN 3:16">—Naganwoundagüdübei bigarigu danme bagaraüdün, ani lauba igarigu bágurahaña birahüñü. Lau sun lira busenmeme bubéi búmari súnwandan, ani lagumadirubadibu giñe.<verse eid="GEN 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 3:17" />Lariñaga lun wügüri:</para>
  <para style="p" vid="GEN 3:17">—Kei badügün gasu tau búmari, aba beigin tídangiñe tin wewe to ueiboun neweridirabu, guentó lábugiñebei íñarawaguni múa, badüga. Gasu buadigimarini múa lau áfaaguni darí líchuguni beigin bun lidan sun bibagari. <verse eid="GEN 3:17" /><verse number="18" style="v" sid="GEN 3:18" />Láhüchüba hiiyu bun, háfume beigin híduru áraabuna. <verse eid="GEN 3:18" /><verse number="19" style="v" sid="GEN 3:19" />Bagañeiruboun beigan fein lau lárouga bun, darime bagiribudun bárigoun lidoun múa le aubei badügǘwa, lídangiñe múa badügǘwa basaliraguayaba múame.<verse eid="GEN 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 3:20" />Aba líchugun wügüri tiri lúmari: Ewa, tuguya háguchuboun sun gürigia ubouagu. <verse eid="GEN 3:20" /><verse number="21" style="v" sid="GEN 3:21" />Aba ladügün Wabureme Bungiu hadaüragun lau hara animaalu lun ladouragun wügüri tau sun lúmari.<verse eid="GEN 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 3:22" />Aba lariñagun:</para>
  <para style="p" vid="GEN 3:22">—Guentoti, ítarahali wügüri kei aban wádangiñe, subudi laali le buídubei luma le wuribabei. Moun lumuti leigin tídangiñe wewe to lánina ibagari, ábame labagaridun lun sun dan.<verse eid="GEN 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 3:23" />Ligía lasagarunbalin Wabureme Bungiu wügüri lídangiñe Edén, aba líchuguni awadigimaridei múa le buga ídangiñebei ladügǘwa. <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />Lárigiñe lasagaruni wügüri aba líchugun átiri kátaña garünatiña luéigiñe oubaü le ñéingiñe lubéi laboucha weyu libiti Edén, tuma aban eféin durungu kei watu, agararahatu luagun sun oubaü lun ua lan ni aban achülürüti luagun tídibu wewe to lánina ibagari.<verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s1">Kaín luma Aweli</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />Aba lóundarun wügüri tumoun lúmari Ewa, aba tadageinadun, aba tagaraüdüni Kaín, aba tariñagun:</para>
  <para style="p" vid="GEN 4:1">—Garaühadina aban eyeri, líchugun Bungiu nun.</para>
  <para style="p" vid="GEN 4:1">Aba tíchugun Kaín luagu. <verse eid="GEN 4:1" /><verse number="2" style="v" sid="GEN 4:2" />Lárigiñe aba tagaraüdüni Aweli le lamulen Kaín. Aba líchaagun Aweli lungua lun hagüriahóun mudún, Kaín lun lábunaguni múa.<verse eid="GEN 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 4:3" />Ábati lásügürün dan. Luagu aban weyu aba lanügüni Kaín lidewese lun Bungiu lídangiñe lalubahan. <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />Aba giñe lanügün Aweli lun Bungiu, aban hádangiñe furumiñetiña hama habuidun-agei harahüñü lilügüniña mudún aba larihin Bungiu lau saragu ugundani luagun Aweli labu lidewese, <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />gama lumoun mítaranti larihin luagun Kaín lau lidewese. Ítara liña lubeiti aba lan lagañidun Kaín saragu, aba larufudun luriban igibu. <verse eid="GEN 4:5" /><verse number="6" style="v" sid="GEN 4:6" />Ábati lariñagun Bungiu lun:</para>
  <para style="p" vid="GEN 4:6">—Ka uagu bagañida, ani arufuda buguya luriban igibu? <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />Lun hamuga badügüni le buídubei, gayaraabei yebe biñuruni bigibu; gama lumoun kei madügün bani, lagurabahaña figóu lun lagumadirunibu. Lau sun lira gayaraati buguya lan agumadirei.<verse eid="GEN 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 4:8" />Luagu aban weyu, aba lagunbirahani Kaín Aweli le lamulen lun houdin asariñaha. Lidan áraabuhaña biángubei, aba lachubarun Kaín luagun lamulen, aba láfaruni hilagubei.<verse eid="GEN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 4:9" />Ábati lálügüdüni Bungiu Kaín:</para>
  <para style="p" vid="GEN 4:9">—Hagéi san Aweli le bamulen?</para>
  <para style="p" vid="GEN 4:9">Aba lóunabun Kaín:</para>
  <para style="p" vid="GEN 4:9">—Ibidiñeti nun. Au funagia lunbei nóunigiruni namulen?<verse eid="GEN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 4:10" />Lariñaga Bungiu lun:</para>
  <para style="p" vid="GEN 4:10">—Ka uagu badügei le? Lita bamulen le báwiyurubei múarugun lagúarahaña nun lun naguseragüdünibu. <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />Ligía íñarawaguañu buba lubéi, bugawa buguyame lídangiñe múa le átubalin lita bamulen le báfarubei hilagubei. <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />Íbini buadigimariduni múa, michu laali lin bun. Beredera éibugei ubóu memeraagunga lun sun dan.<verse eid="GEN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 4:13" />Ábati lóunabuni Kaín Wabureme:</para>
  <para style="p" vid="GEN 4:13">—Siñabei nawandun aban abeichúni wéiriti ítara. <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />Bugá baadina lídangiñe múa le uguñe weyu, gásuti nerederun éibugei ubóu dise buéi memeraagunga, ítarati, furumiñeguarügüme adunraguti numa láfarubadina hilagubei.<verse eid="GEN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 4:15" />Gama lumoun aba lóunabuni Bungiu:</para>
  <para style="p" vid="GEN 4:15">—Furumiñeguarügü le áfarutibu hilagubei labeichúba sedü wéiyaasu. Ábati líchugun Bungiu lumakün Kaín lun máfarun lani le adunraguti luma. <verse eid="GEN 4:15" /><verse number="16" style="v" sid="GEN 4:16" />Aba lidin Kaín lídangiñe fulasu le ñein lubéi buga ladimureha luma Bungiu, aba lerederun aganóua lidan fulasu le gíribei Nodu, le luéigiñebei oubaü le ñéingiñe lubéi laboucha weyu libiti Edén.<verse eid="GEN 4:16" /></para>
  <para style="s1">Ladügawagun Kaín</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />Aba lóundarun Kaín tumoun lúmari, aba tadageinadun, aba tagaraüdüni Enoku. Aba ladügün Kaín aban uburugu, aba líchuguni liri liráü le Enoku luagu uburugu ligía. <verse eid="GEN 4:17" /><verse number="18" style="v" sid="GEN 4:18" />Enoku ligía meha lúguchibei Iradü, Iradü ligía meha lúguchibei Meuhaéli, Meuhaéli ligía meha lúguchibei Metusaéli, Metusaéli ligía meha lúguchibei Lamekü.<verse eid="GEN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 4:19" />Biámaguañanu buga lúmarigu Lamekü. Adá tiri aban, Silá tiri to aban. <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />Aba tagaraüdüni, Adá Habali, le ídangiñebei hayabin ha agüriahabaña bágasu aganóua hagía tidan burí kianpu. <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />Anihein bugaha aban lamulen Habali gíriti Hubali, ñéingiñe lubéi hayabin sun ha áfarubaña árüpa íñaaha hagía fidu. <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />Ánhounti Silá, aba tagaraüdüni Tubali-Kaín, le nadagimeinbei gürabu adaaguati burí katei lauti buronse luma lauti gürabu. Ñeinñoun aban litu gíritu Naamá.<verse eid="GEN 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 4:23" />Luagu aban weyu, aba lariñagun Lamekü houn lúmarigu, Adá tuma Silá:</para>
  <para style="b" vid="GEN 4:23" />
  <para style="q" vid="GEN 4:23">«Númarigu, aganba huméi buidu le nariñagubei hun:</para>
  <para style="q" vid="GEN 4:23">Áfaraadina aban wügüri hilagubei ladüga líbaagunina;</para>
  <para style="q" vid="GEN 4:23">áfaraadina aban nibureinti<optbreak /> ladüga labuleseirunina,<verse eid="GEN 4:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="GEN 4:24" />anhein lubeiti lageindawaguba lubéi luéigiñe Kaín sedü wéiyaasu,</para>
  <para style="q" vid="GEN 4:24">hageindaguba nuéigiñe ǘrüwa-wein-disedü wéiyaasu».<verse eid="GEN 4:24" /></para>
  <para style="s1">Lǘrüwan liráü Adán tuma Ewa</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />Ábaya lóundarun Adán tumoun lúmari, aba tagaraüdün aban irahü aba tíchugun liri Setü,<note caller="1" style="f"><char style="fr" closed="false">4.25 </char><char style="ft" closed="false">Anihán iri le Setü, ítarayuma liña laganbún kei “rúhali” lidan Ebüréu.</char></note> tariñaga:</para>
  <para style="p" vid="GEN 4:25">—Ruha Bungiu aban irahü nun leweñegua Aweli le láfarubei Kaín hilagubei.<verse eid="GEN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 4:26" />Aba giñe garáü lan Setü aban irahü, aba líchugun liri Enosu. Lúmagiñe dan ligía aba lagumeserun liri Bungiu aguahóua lidan afurieiduni.<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s1">Ladügawagun Adán</para>
  <para style="r">(<ref loc="1CH 1:1-14">1 Kro 1.1-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />Anihán hiri ladügawagun Adán. Dan le ladügünbalin Bungiu wügüri lenege guánarügü ladügei. <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />Adüga lumuti Bungiu wügüri tuma würi, aba labiniruniña. Weyu le ladügünbaliña, aba líchugun hiri: «Wügüriña».<verse eid="GEN 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 5:3" />San-darandi meha irumu lau Adán, dan le lágurahounbei liráü le gíribei Setü, le lenegebei. <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />Lárigiñe le, aba labagaridun Adán widü-san irumu, garahüñüguayati lidan sun dan ligía. <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />Nefu-san-darandi irumu lau ligía lounwen.<verse eid="GEN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 5:6" />San-seingü meha irumu lau Setü dan le lágurahounbei liráü le gíribei Enosu. <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />Ábaya labagaridun Setü widü-san-sedü irumu lárigiñe, ábaya garahüñügua lan, <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />nefu-san-duusu irumu lau ligía lounwen.<verse eid="GEN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 5:9" />Gádürü-wein-diisi irumu lau Enosu, ligía lágurahoun liráü le gíribei Kainán. <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />Ábaya labagaridun Enosu widü-san-keinsi irumu lárigiñe, ábaya garahüñügua lan. <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />Nefu-san-seingü irumu lau Enosu ligía lounwen.<verse eid="GEN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 5:12" />Ǘrüwa-wein-diisi irumu lau Kainán dan le lágurahounbei liráü le gíribei Maalaléli. <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />Aba labagaridun Kainán widü-san-bián-wein irumu lárigiñe, ábaya garahüñügua lan; <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />Nefu-san-diisi irumu lau Kainán ligía lounwen.<verse eid="GEN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 5:15" />Ǘrüwa-wein-seingü irumu lau Maalaléli, ligía garaüwa lan liráü le gíribei Héredi. <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />Aba labagaridun Maalaléli widü-san-darandi irumu, lárigiñe ábaya garahüñügua lan. <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />Widü-san-gádürü-wein-keinsi irumu lau Maalaléli ligía lounwen.<verse eid="GEN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 5:18" />San-ǘrüwa-wein-biama irumu lau Héredi, ligía garaüwa lan liráü le gíribei Enoku. <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />Aba labagaridun Héredi widü-san irumu, lárigiñe, ábaya garahüñügua lan. <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />Nefu-san ǘrüwa-wein-biama irumu lau ligía lounwen <verse eid="GEN 5:20" /><verse number="21" style="v" sid="GEN 5:21" />ǘrüwa-wein-seingü irumu lau Enoku, ligía garaüwa lan liráü le gíribei Matusalén. <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />Winwan lumuti Enoku sun libagari lábugiñe lugundan Bungiu. Aba labagaridun Enoku ǘrüwa-san irumu lárigiñe, ábaya garahüñügua lan. <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />Ǘrüwa-san-ǘrüwa-wein-seingü irumu lau Enoku abagarida. <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />Keiti winwan lani Enoku sun libagari lábugiñe lugundan Bungiu, aban weyu aba lanügüni Bungiu móunwenga.<verse eid="GEN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 5:25" />San-gádürü-wein-sedü irumu lau Matusalén, ligía garaüwa lan liráü le gíribei Lamekü. <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />Aba labagaridun Matusalén sedü-san-gádürü-wein-biama irumu lárigiñe, ábaya garahüñügua lan. <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />Nefu-san-ǘrüwa-wein-nefu irumu lau Matusalén, ligía lounwen.<verse eid="GEN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 5:28" />San-gádürü-wein-biama irumu lau Lamekü, ligía garaüwa lan aban liráü, <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />aba líchugun liri Noé, ladüga lariñagun:</para>
  <para style="p" vid="GEN 5:29">—Íñaragua lumuti Bungiu múa, mósuti wawadigimaridun here lun wábunaguni; gama lumoun irahü le, lemeraaguagüdübadiwa.<verse eid="GEN 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 5:30" />Lárigiñe garaüwa lan Noé, aba labagaridun Lamekü seingü-san-gádürü-wein-keinsi irumu, aba garahüñügua lan. <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />Sedü-san-ǘrüwa-wein-disedü irumu lau Lamekü ligía lounwen.<verse eid="GEN 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 5:32" />Seingü-san-irumu lau Noé, ligía garaüwa hamá lirahüñü ha gíribaña Semü, Kamü luma Hafeti.<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s1">Hariban gürigia</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />Dan le hagumeserunbei wügüriña agibedagua, ani garahüñügua hagía würiña irahüñü. <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />Aba harihin lirahüñü Bungiu luagu buidu burí hamá würiña hagía, aba burí hanúadahan hádangiñe, lun hamarieidun hama. <verse eid="GEN 6:2" /><verse number="3" style="v" sid="GEN 6:3" />Aba lariñagun Bungiu:</para>
  <para style="p" vid="GEN 6:3">—Mígirunbadina lun habagaridun gürigia sun dan, ladüga débiliti ǘgürügü. Ligía san-wéinrügübei lubéi irumu labagaridun wügüri.<verse eid="GEN 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 6:4" />Aba hayabingua hígandei fulasurugún dan le hagumeserunbei lirahüñü Bungiu agamaridaña würiña ha harahüñü wügüriña lun hagaraüdün hau. Hagía buga ha uágubaña laganbahóua lidan dan lügüra.<verse eid="GEN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5" />Dan le larihinbei Bungiu luagu hanarime lan hariban gürigia ha ubouagubaña, luma giñe sun lan dan hasaminaruña hadügün katei wuribati, <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />aba lírudun luagu ladügüniña gürigia. <verse eid="GEN 6:6" /><verse number="7" style="v" sid="GEN 6:7" />Lau saragu igarigu lariñaga:</para>
  <para style="p" vid="GEN 6:7">—Nagumuchaguagüdaaña gürigia ha nadügübaña ligibuagugiñe ubóu, nagumuchaguagüdaaña giñe sun animaalu ha áüdübüna, sun animaalu ha aduruuharügübaña múarugu hama dunuru. Wéiriti íruni le nuágubei luagu nadügüniña!<verse eid="GEN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 6:8" />Gama lumoun gúndaati Bungiu lau Noé.<verse eid="GEN 6:8" /></para>
  <para style="s1">Ugunei to ladügüboun Noé</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />Anihán asusereduti luáguti Noé. Aban buga wügüri buiti Noé, súnwandan ladügüni le lubeibei Bungiu. Lidan buga lidaani, ligíarügüñein abagarida lau lugundan Bungiu. <verse eid="GEN 6:9" /><verse number="10" style="v" sid="GEN 6:10" />Ǘrüwañanu lirahüñü Noé: Semü, Kamü luma Hafeti. <verse eid="GEN 6:10" /><verse number="11" style="v" sid="GEN 6:11" />Lun Bungiu, buin liña bugaha ubóu lau wuribani luma anarimeni, <verse eid="GEN 6:11" /><verse number="12" style="v" sid="GEN 6:12" />sun gürigia aba híchaagun houngua lun wuribani. Kei larihin Bungiu luagu buin liña lan ubóu lau wuribati. <verse eid="GEN 6:12" /><verse number="13" style="v" sid="GEN 6:13" />Aba lariñagun lun Noé:</para>
  <para style="p" vid="GEN 6:13">—Nagumuchaguagüdaaña sun gürigia, gíbeti anarimeni ubouagu hádangiñeti, nagumuchaguagüdaaña lubeiti labu sun ubóu. <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />Dáguaba aban ugunei lautu fulansu buiti, badaagua burime rumu tidan, baputiheime sun láfadaragun fulansu le tuágubei lau barama dandu múnadagiñe keisi bóugudigiñe mebelura láamuga duna tidoun. <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />Ítara luba tueirin ugunei tuguya: San-darandi-seingü méturu timigifen, wein-biama méturu dimí tidabuberen, tareisi méturu dimí tiñun. <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />Ǘrüwabei fuló tidan, bíchigame aban funedera kei burí dimí méturu ǘnabu luéi tábulugu, luma aban bena luéigiñe aban touba. <verse eid="GEN 6:16" /><verse number="17" style="v" sid="GEN 6:17" />Nóunaha aban guran le lunbei labuluchuni ubóu, lun lagumuchun lau sun le gabagaribei ligibuagu ubóu. Lóunweba sun le ubouagubei. <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />Ánheinti buma nadügüba aban daradu. Tidoun ugunei tuguya, hebeluruba birahüñü, búmari, bídiñugu, buguya. <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />Belugüda buguyame bián animaalugu hádangiñe sun hawuyeri animaalu ha ubouagubaña, aban wügüri aban würi, lun gayara lan gabagari hamá kei buguya. <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />Hebeluruba aban feru animaalugu hádangiñe kada hawuyeri buma tidoun ugunei, dandu dunuru, kei animaalugu áüdübüna, keisi ha aduruuharügübaña múarugu, lun habagaridun. <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />Óundaraguaba giñe sun luwuyeri éigini, ábame bareiduni, hou báamuga habu sun animaalu.<verse eid="GEN 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 6:22" />Aba ladügüni Noé sun katei kei lariñaguni Bungiu lun.<verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="s1">Labuluchun ubóu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />Lárigiñe aba lariñagun Bungiu lun Noé:</para>
  <para style="p" vid="GEN 7:1">—Dinaba tidoun ugunei hau sun biduheñu, ladüga hádangiñe sun gürigia báurügüñein nagundaara. <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" />Barüba sedü feru hádangiñe sun animaalugu harumatiña, ha geigúadibaña, ánhaña ha meigúadibaña, ábanrügüla wügüri tuma aban würi. <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />Barüba giñe sedü feru hádangiñe sun hawuyeri dunuru, lun magumuchagun hamá ubouagugiñe. <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />Ladüga sedü weyu lárigiñe le, náhuyagüdüba huya luagu bián-wein weyu luma bián-wein áriebu. Nagidaraali sun nibagariti le nadügübei ligibuagugiñe ubóu!<verse eid="GEN 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 7:5" />Adüga lumuti Noé súngubei kei le aubei lariñagei Bungiu lun. <verse eid="GEN 7:5" /><verse number="6" style="v" sid="GEN 7:6" />Sisi-san meha irumu lau Noé dan le ladibirunbei ubóu. <verse eid="GEN 7:6" /><verse number="7" style="v" sid="GEN 7:7" />Aba ládinun tidoun ugunei hau lirahüñü, lúmari hama lídiñugu, lun hesefurun. <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />Animaalugu ha geigúadibaña hama ha meigúadibaña, ha áhamahabaña hama ha aduruuhabaña, aba lebelaagüdün biama hádangiñe sun hawuyeri animaalugu würiña hama wügüriña, ha geigúadibaña hama ha meigúadibaña, ha áhamaharügübaña hama ha aduruuharügübaña múarugu <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />aba hebelurun luma Noé tidoun ugunei, biámagueina, wügüri animaalu tuma würi animaalu, kei lariñaguni Bungiu lun. <verse eid="GEN 7:9" /><verse number="10" style="v" sid="GEN 7:10" />Sedü weyu lárigiñe, aba lagumeserun guran abuinchagüdei ubóu.<verse eid="GEN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 7:11" />Weyu disedü lidan libiaman hati, sisi-san meha irumu lau Noé. Weyuméme ligía aba ladaarun lísensen-agei lagütü barana guribinigiñe, aba ladaarun lubenari sielu íñugiñe. <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />Bián-wein weyu luma bián-wein áriebu lau huya áhuya. <verse eid="GEN 7:12" /><verse number="13" style="v" sid="GEN 7:13" />Lídanmeme weyu ligía aba lebelurun Noé tidoun ugunei habu lirahüñü, Semü, Kamü luma Hafeti, tuma giñe lúmari hama ǘrüwa lídiñugu. <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />Belutiña sun hawuyeri animaalugu hama, dandu ha áraabuna, hama ha ibiñanigu, ha aduruuharügübaña múarugu hama sun hawuyeri dunuru. <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />Belutiña sun animaalugu hagía luma Noé bián bián. <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />Aban wügüri tuma aban würi hádangiñe sun hawuyeri animaalu, ítara kei lariñaguni Bungiu lun Noé, lárigiñe aba ladouruni Bungiu tubenari ugunei.<verse eid="GEN 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 7:17" />Bián-weinñein weyu lau guran. Dan le liñurunbei duna, aba liñurunu ugunei múarugugiñe aba táfayarun. <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />Iñureina ligíatima duna áfayareinatima ugunei. <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />Le lueirin liñurun duna aba ladouragun lau burí wübü le íñutimabei ubouagu, <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />lárigiñe ladouragun lau burí wübü, iñuramémegili kei burí sedü méturu lanwoun. <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />Ítara liña hóunwegun sun gürigia ha ubouagubaña, hama dunuru, animaalu ha ibiñanigu hama áraabuna hama ha aduruuharügübaña múarugu. <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />Sun le gabagaribei, gayara lawaragun ligibuagu ubóu, hilati. <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />Noérügüñein hama ha ebelurubaña luma tidoun ugunei eredera nibagariñu; ha híbiri gumuguagüdawatiña: Gürigia, ibiñanigu, dunuru hama animaalugu ha aduruuharügübaña múarugu, <verse eid="GEN 7:23" /><verse number="24" style="v" sid="GEN 7:24" />san-dimiñein lubeiti weyu lau múa buluñu.<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="s1">Lagumuchun guran</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />Ábati laritagun Bungiu luagun Noé hama animaalugu ha lúmabaña tidan ugunei. Aba láfuragüdün garabali ligibuagun múa; aba lagumeserun duna ararira; <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />aba ladourun lísensen-agei lilulin barana luma lubenari sielu. Aba lásügürün huya, <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />aba lagumeserun duna ararira murusun murusun. Luágubei san-dimí weyu ararireinatimahaali duna, <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />wéyubei disedü lidan lisedün hati ligía tadagarun ugunei luagu wübü le gíribei Ararátü. <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />Aba lasigirun duna ararira, furumiñetibei weyu lidan lidiisin hati, gayaraahali burí larihín lábulugu wübü.<verse eid="GEN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 8:6" />Lárigiñe bián wein weyu, aba ladaaruni Noé tufunederan ugunei to buga ladügüboun, <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />Ábati lígiragüdün aban dunuru wuriti, aba lerederun dunuru ligía áhamaha yaroun yagüroun agurabahei lamabeidun múa. <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />Lárigiñeti buga lira ábanya lígiragüdün Noé aban unhun lun larihin anhein mábeihali lubéi múa; <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />ábayati tagiribudun unhun tugía tidoun ugunei ladüga madari tan halíaba lan temeraagua lugundun wéirigili lan buga lubuinga ubouagu. Ábati línchuni Noé lúhabu, aba lárügüdünu unhun tugía aba lebelaagüdünu tidoun ugunei.<verse eid="GEN 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 8:10" />Sedü weyu lárigiñe, ábaya lóunahanu Noé unhun. <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />Aguñedeinaali tagiribudunbei unhun. Barüina tuguyati murusun tilimun wewe oliwu tiyumulugu, ítara liña lubeiti lasubudiruni Noé luagu amabeideinaali lan buga ubóu. <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />Sédüya weyu lárigiñe, ábaya lóunahanu unhun tuguya, gama lumoun magiribudúnharu.<verse eid="GEN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 8:13" />Dan le sisi-san-ábanhali irumu lau Noé ligía lamabeidun múa. Furumiñe weyu lidan furumiñeti hati, aba lagidaruni Noé tábulugu ugunei, aba larihin luagu mábeihali lan múa. <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />Lubaabei weyu wein-sedü lidan libiaman hati, mábeitimahali múa. <verse eid="GEN 8:14" /><verse number="15" style="v" sid="GEN 8:15" />Ábati lariñagun Bungiu lun Noé:<verse eid="GEN 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 8:16" />—Furiba tídangiñe ugunei tau búmari, birahüñü hama bídiñugu. <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />Sagabaña giñe sun animaalugu ha búmabaña ñein: Dunuru, animaalu áüdübüna hama ha aduruuharügübaña múarugu, ñüdün hamaamuga, garahüñügua hamaamuga, buíngüda hamaamugei ubóu.<verse eid="GEN 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 8:18" />Ábati láfuridun Noé tau lúmari, lirahüñü hama lídiñugu tídangiñe ugunei. <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />Furitiña giñe sun animaalu ha áüdübüna, ha aduruuharügübaña múarugu, hama ha áhamahabaña. <verse eid="GEN 8:19" /><verse number="20" style="v" sid="GEN 8:20" />Lárigiñe aba ladügün Noé aban latarü lun Bungiu, aba lanügün aban hádangiñe kada hawuyeri animaalugu hama dunuru geigúaditiña aba láguduniña keisi adagaragüdüni gudawarügüti lun Bungiu. <verse eid="GEN 8:20" /><verse number="21" style="v" sid="GEN 8:21" />Dan le lirimichunbalin Bungiu lubuidun íhemeni ligía aba lariñagun: «Míñaragundigianaali múa luagu hadurun gürigia, ladüga lúmagiñe hañüraü gürigia luágugubeirügü wuribani lasaminara. Magumuchaguagüdün naaña giñe sun animaalugu kei nadügüni guentó.<verse eid="GEN 8:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="GEN 8:22" />“Anihaguarügaali ligíame ubóu,</para>
  <para style="q" vid="GEN 8:22">ñeinbei ábunaguni luma alubahani;</para>
  <para style="q" vid="GEN 8:22">ñeinbei lárouga luma lidiliga,</para>
  <para style="q" vid="GEN 8:22">ñeinbei luribouga luma lubachouga,</para>
  <para style="q" vid="GEN 8:22">ñeinbei giñe wéyuagu luma áriebu” ».<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s1">Lidaradun Bungiu luma Noé</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />Aba labiniruni Bungiu Noé hau sun lirahüñü, lau dimurei le:</para>
  <para style="p" vid="GEN 9:1">—Gibe hamá hirahüñü, buíngüda huméi ubóu. <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />Sun animaalugu ha ubouagubaña hadadagaruba lau anufudei huéi. Lábugiñeñanu hubafu sun animaalugu ha garabalirugubaña, ha múarugubaña hama ha baranahabaña. <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />Gayaraati héiginiña sun hawuyeri animaalugu tuma in to habusenrun. Ru numuti sun lira hun. <verse eid="GEN 9:3" /><verse number="4" style="v" sid="GEN 9:4" />Gama lumoun anihein aban katei moun lumuti héigini: Moun lumuti héigini animaalu lau lita, ladüga lídanñein lita libagari. <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />Naguseragüdübei kada wügüri luma kada animaalu luagu lita kada aban hídangiñe. Naguseragüdübei kada wügüri luagu libagari gürigia líledi.<verse eid="GEN 9:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="GEN 9:6" />«Le áfaruti aban gürigia<optbreak /> líledi hilagubei,</para>
  <para style="q" vid="GEN 9:6">láfarayabei giñe amu gürigia,</para>
  <para style="q" vid="GEN 9:6">ladüga lenege lan Bungiu<optbreak /> ladügüniña gürigia.<verse eid="GEN 9:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="GEN 9:7" />Gama lumoun gíbegua hamá hirahüñü,</para>
  <para style="q" vid="GEN 9:7">buíngüda humaamugei ubóu hau».<verse eid="GEN 9:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8" />Ariñagati giñe Bungiu lun Noé hau sun lirahüñü:<verse eid="GEN 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 9:9" />—Ariha humá, nadügaali nidaradun huma luma hama hadügawagun, <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />luma hama sun animaalugu ha húmabaña, ha áfuridubaña tídangiñe ugunei: Dunuru, animaalugu ha ibiñani hama ha áraabuna, luma hama sun animaalugu ha ubouagubaña. <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />Masansiragunbei nidaradun huma: Magumuchaguagüdün naaña gürigia hama animaalugu lau ladibirun ubóu. Mabuluchagüdündigia naali ubóu luéi náfaraguniña lílana. <verse eid="GEN 9:11" /><verse number="12" style="v" sid="GEN 9:12" />Anihán liseinin daradu le nadügübei huma luma hama sun animaalugu lun súnwandan: <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />Ru naaru nani heremuru dúerirugu, teseriwiduba liseininme daradu le nadügübei hama lílana múa. <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />Danme le nóunahan dúeri ligibuagun múa, tasaliraguba nani heremuru labadinagua dúeri. <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />Ábameti naritagun luagun daradu le nadügübei huma luma hama sun animaalugu, ábameti madibiragüdün naali lan ubóu luéi lagumuchaguagüdünün. <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />Danme anuhán lan heremuru dúerirugu, narihuboun, ábame naritagun luagun daradu le nadügübei hama sun gürigia luma hama sun animaalugu ha ubouagubaña lun súnwandan. <verse eid="GEN 9:16" /><verse number="17" style="v" sid="GEN 9:17" />Anihán liseinin daradu le nadügübei hama sun gürigia luma hama sun animaalugu ha ubouagubaña.</para>
  <para style="p" vid="GEN 9:17">Ítara liña ladimurehan Bungiu luma Noé.<verse eid="GEN 9:17" /></para>
  <para style="s1">Noé hama lirahüñü</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />Semü, Kamü luma Hafeti, hagía lirahüñü Noé ha áfuridubaña tídangiñe ugunei. Kamü ligía lúguchibei Kanán. <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />Añahán meha ǘrüwa ha lirahüñübaña Noé, ani hau hadügawagun hagibedaguaya gürigia ubouagu.<verse eid="GEN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 9:20" />Ábunaguni buga lifisiutebei Noé, ábati lagumeserun Noé ábunagua, aba lábunun aban lichari lau beibei, ligía furumiñeti wügüri ábunagubei beibei. <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />Luáguti aban weyu, aba latun Noé diwéin tauti beibei aba labacharuadun, aba larounrun surusu tidan likianpun. <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />Dan le larihinbalin Kamü le lúguchi Kanán lúguchi surusu, aba lidin abahüdaguei houn bián líbirigu. <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />Ábati lanügün Semü luma Hafeti aban gamisa, aba héibugun hanagangiñoun ariheina luagun amu oubaü luéi harihini háguchi surusu, aba hadouragun lau. <verse eid="GEN 9:23" /><verse number="24" style="v" sid="GEN 9:24" />Dan le lásaarunbei Noé lídangiñe liwidinun, dan lasubudirunbalin le ladügübei ladarahóun lun, <verse eid="GEN 9:24" /><verse number="25" style="v" sid="GEN 9:25" />aba lariñagun lun:</para>
  <para style="b" vid="GEN 9:25" />
  <para style="q" vid="GEN 9:25">«Íñaragua numuti Kanán!</para>
  <para style="q" vid="GEN 9:25">Ligíaba idamuni le ǘnabutimabei houn bián líbirigu!»<verse eid="GEN 9:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="GEN 9:26" />Aba lasigirun ariñaga:</para>
  <para style="b" vid="GEN 9:26" />
  <para style="q" vid="GEN 9:26">«Binilei Nabureme Bungiu Semü,</para>
  <para style="q" vid="GEN 9:26">lidamun lan Semü Kanán.<verse eid="GEN 9:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="GEN 9:27" />Anhalá Bungiu lun<optbreak /> laweiridagun Hafeti;</para>
  <para style="q" vid="GEN 9:27">aganoualá tidan burí<optbreak /> likianpun-agei Semü,</para>
  <para style="q" vid="GEN 9:27">ani lun lidamunbei lan Hafeti Kanán».<verse eid="GEN 9:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GEN 9:28" />Wínwanti Noé ǘrüwa-san-dimí irumu lárigiñe ladibirun ubóu, <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />nefu-san-dimí lubeiti irumu lau dan le lóunwenbei.<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s1">Ladügawagun Noé</para>
  <para style="r">(<ref loc="1CH 1:5-23">1 Kro 1.5-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />Añahán hadügawagunbaña Semü, Kamü luma Hafeti ha lirahüñü Noé ha agaraüdagubaña lárigiñe ladibirun ubóu.<verse eid="GEN 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 10:2" />Añahán buga lirahüñübaña Hafeti: Gómerü, Magogu, Madái, Hawán, Tubali, Mesekü luma Tirasi. <verse eid="GEN 10:2" /><verse number="3" style="v" sid="GEN 10:3" />Lirahüñüti buga Gómerü: Ásükenasü, Rifatü, luma Togarüma. <verse eid="GEN 10:3" /><verse number="4" style="v" sid="GEN 10:4" />Lirahüñüti Hawán: Elisa, Tárüsisi, Kitimü luma Rodanímü. <verse eid="GEN 10:4" /><verse number="5" style="v" sid="GEN 10:5" />Añahán ladügawagunbaña Hafeti ha agibedagubaña laru láruina beya, kada aban hau haduheñu lidan hageira lau giñe hererun houngua.<verse eid="GEN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 10:6" />Añahán bugati lirahüñübaña Kamü: Kusu, Misüraímü, Futu luma Kanán. <verse eid="GEN 10:6" /><verse number="7" style="v" sid="GEN 10:7" />Ha meha lirahüñü Kusu: Sebá, Awilá, Sabütá, Raamá tuma Sabüteká. Lirahüñü Raamá: Sebá luma Dedán. <verse eid="GEN 10:7" /><verse number="8" style="v" sid="GEN 10:8" />Kusu ligía meha lúguchibei Nimüródu le furumiñetibei wügüri gabafuti ubouagu. <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />Nimüródu, aban bugaha óunwenbu géibaahati, lau lubafu Bungiu. Ñéingiñe liabin dimurei le: Ítara kei Nimüródu, le buga ábanbei óunwenbu géibaahati lau lubafu Bungiu. <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />Anihán burí luéinamun-agei uburugu le lábugiñebei larúeihan: Babeli, Érekü, Akadü luma Kalüné, lóubawagu Sinarü. <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />Lídangiñe fulasu ligía láfurida Asuru aba lábunaguni fulasu burí le Níniwe, Reobotu-irü, Kela <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />luma óunwenbu uburugu le gíribei Resén, le labadinaguabei Níniwe luma Kela.<verse eid="GEN 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 10:13" />Lídangiñe Misüraímü hayabin Lúduna, Anamüna, Leábüna, Nafütuína, <verse eid="GEN 10:13" /><verse number="14" style="v" sid="GEN 10:14" />Paturúsuna, Kásüluna hama Küretana ha ídangiñebaña hayabin Filistéana.<verse eid="GEN 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 10:15" />Kanán ligía meha lúguchibei Sidón, le furumiñeti liráü, lárigiñe Etü. <verse eid="GEN 10:15" /><verse number="16" style="v" sid="GEN 10:16" />Lídangiñe Kanán hayabin Hebusuna, Amoruna, Hérühesina, <verse eid="GEN 10:16" /><verse number="17" style="v" sid="GEN 10:17" />Eweuna, Araséuna, Sineuna, <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />Arüwadüna, Semarüna hama Amatüna. Lárigiñe aba hafanreinragun sun türibu Kananna. <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />Aba lachawaragun hamúan Kananna luagun louba Gerarü, lúmagiñe uburugu Sidón darí lumoun fulasu le Gasa, luágunti uburugu burí le Sodoma luma Gomora, Adümá luma Seboimü, darí lumoun Lesa. <verse eid="GEN 10:19" /><verse number="20" style="v" sid="GEN 10:20" />Añahán ladügawagunbaña Kamü, kada néchani hama haduheñu lidan hamúan lau hererun houngua.<verse eid="GEN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 10:21" />Semü le íbugañaü lun Hafeti, garahüñüti giñe. Sun lirahüñü Éberü hagía ladügawagunbaña Semü. <verse eid="GEN 10:21" /><verse number="22" style="v" sid="GEN 10:22" />Lirahüñü meha Semü: Elamü, Asuru, Arüfasádü, Ludu luma Aramü. <verse eid="GEN 10:22" /><verse number="23" style="v" sid="GEN 10:23" />Lirahüñü Aramü: Usu, Ulu, Géterü luma Masi. <verse eid="GEN 10:23" /><verse number="24" style="v" sid="GEN 10:24" />Arüfasádü, ligía lúguchibei Sala, Sala lúguchi Éberü. <verse eid="GEN 10:24" /><verse number="25" style="v" sid="GEN 10:25" />Lárigiñe aba garahüñü lan Éberü bián irahüñü. Pelegü líribei aban hádangiñe, ladüga lidan lidaani ligía hafanreinragun gürigia ubouaguna; le lamulen Pelegü Hokután líribei. <verse eid="GEN 10:25" /><verse number="26" style="v" sid="GEN 10:26" />Hokután ligía lúguchibei Alümodádü, Sélefü, Asarü-máweti, Hera, <verse eid="GEN 10:26" /><verse number="27" style="v" sid="GEN 10:27" />Adorámü Usali, Dikülá, <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />Obali, Abimaéli, Sebá, <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />Ofirü, Awilá luma Hobabü. Sun ha lirahüñü Hokután, <verse eid="GEN 10:29" /><verse number="30" style="v" sid="GEN 10:30" />aba haganóun lidan burí múa le lúmagiñebei lóubawagu Mesa darí Sefarü, o le lan oubaü le áraabubei ñéingiñe lubéi laboucha weyu. <verse eid="GEN 10:30" /><verse number="31" style="v" sid="GEN 10:31" />Añahán ladügawagunbaña Semü, kada fulasu hau haduheñu lidan hamúan lau giñe hererun houngua.<verse eid="GEN 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 10:32" />Añahán haduheñu lirahüñü Noé, hawagu hadügawagun luma hafulasun. Lárigiñe ladibirun ubóu, aba hafanreinragun lidoun sun oubaü lun hadügün ámuñegueinarügü néchani ubouagu.<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s1">Luayelesin Babeli</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />Lidan buga dan ligía, ábanmeme iñeñein hadimurehabei sun gürigia. <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />Dan le háfuridunbei lídangiñe oubaü le ñéingiñe lubéi laboucha weyu, aba hadarirun aban fulasu mawübüriti lóubawagu Sinarü, aba herederun aganóua ñein. <verse eid="GEN 11:2" /><verse number="3" style="v" sid="GEN 11:3" />Luagu aban weyu aba hariñagun hámagua:</para>
  <para style="p" vid="GEN 11:3">—Wadaagua ladiríyu, ábame wábouguni lau watu gemeti.</para>
  <para style="p" vid="GEN 11:3">Ítara liña hayusurunbei ladiríyu leweñegua dübü, aba hóuserun barama lun háfadahani ladiríyu. <verse eid="GEN 11:3" /><verse number="4" style="v" sid="GEN 11:4" />Lárigiñe aba hariñagun:</para>
  <para style="p" vid="GEN 11:4">—Wábunagua aban uburugu luma aban wáyelesi le achülürüti sielu, aganbahóua láamuga wawagu, merederun wamaamuga giñe chagagu ubouagu.<verse eid="GEN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 11:5" />Gama lumoun aba lararirun Bungiu arihei uburugu luma wáyelesi le uágubei hawadigimarida. <verse eid="GEN 11:5" /><verse number="6" style="v" sid="GEN 11:6" />Aba lasaminarun:</para>
  <para style="p" vid="GEN 11:6">—Kei ábanmeme lubéi ageiraü hagía, ábanmeme luwuyeri iñeñein hariñagubei; ani gumese hamaali wadagimanu, úaali ni kata ubouaguna lunti lararamuniña. <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />Buítimabei lun wararirun, ábame wadügün lun ua lan gunfurandagua hamá hámagua.<verse eid="GEN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 11:8" />Ítara liña lubeiti lafanreinraguniña Bungiu ubouagu, aba lerederun hábunaguni uburugu ligía. <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />Aba lámuñedaguagüdüni Bungiu hererun lílana fulasu ligía hawariuagua, aba lachagaraguniña lidoun sun ubóu, ligía Babeli lubéi líribei uburugu ligía.<verse eid="GEN 11:9" /></para>
  <para style="s1">Ladügawagun Semü</para>
  <para style="r">(<ref loc="1CH 1:24-27">1 Kro 1.24-27</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />Añahán meha ladügawagun Semü. Bián irumu lárigiñe labuinchun ubóu lau duna, dan le san lubéi irumu lau Semü, ligía lágurahoun liráü le gíribei Arüfasádü. <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />Aba labagaridun Semü seingü-san irumu lárigiñe, ábaya garahüñü lan.<verse eid="GEN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 11:12" />Darandi-seingü irumu lau Arüfasádü, ligía lágurahoun liráü le gíribei Sela. <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />Aba labagaridun Arüfasádü gádürü-wein-ǘrüwa irumu lárigiñe, ábaya garahüñü lan.<verse eid="GEN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 11:14" />Darandi irumu lau Sela ligía lágurahoun liráü le gíribei Éberü. <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />Aba labagaridun Sela gádürü-san-ǘrüwa irumu lárigiñe, ábaya garahüñü lan.<verse eid="GEN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 11:16" />Darandi-gádürü irumu lau Éberü ligía lágurahoun liráü le gíribei Pelegü. <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />Lárigiñe aba labagaridun Éberü gádürü-san-darandi irumu, ábaya garahüñü lan.<verse eid="GEN 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 11:18" />Darandi irumu lau Pelegü ligía lágurahoun liráü le gíribei Reú. <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />Lárigiñe aba labagaridun Pelegü bián-san-nefu irumu, ábaya garahüñü lan.<verse eid="GEN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 11:20" />Darandi-biama irumu lau Reú, ligía lágurahoun liráü le gíribei Serugu. <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />Lárigiñe aba labagaridun Reú bián-san-sedü irumu, ábaya garahüñü lan.<verse eid="GEN 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 11:22" />Darandi irumu lau Serugu, ligía lágurahoun liráü le gíribei Naoru. <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />Lárigiñe aba labagaridun Serugu bián-san irumu, ábaya garahüñü lan.<verse eid="GEN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 11:24" />Wein-nefu irumu lau Naoru, ligía lágurahoun liráü le gíribei Tera. <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />Lárigiñe aba labagaridun Naoru san-disinéfu irumu, ábaya garahüñü lan.<verse eid="GEN 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 11:26" />Ǘrüwa-wein-diisi meha irumu lau Tera, ligía hágurahoun lirahüñü ha gíribaña Abürámü, Naoru luma Arán.<verse eid="GEN 11:26" /></para>
  <para style="s1">Ladügawagun Tera</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />Añahán ladügawagun Tera, le meha lúguchi Abürámü, Naoru luma Arán. Arán le lúguchi Lotu. <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />Aba lounwen Arán lubaragiñe lúguchi lidan uburugu Uru lídanmeme fulasu le ñein lubéi lágurahoua. <verse eid="GEN 11:28" /><verse number="29" style="v" sid="GEN 11:29" />Aba lamarieidun Abürámü tuma Saraí, Naoru tuma Milüká. Milükáti tuma Isüká lirahüñü Arán. <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />Siñatiti tagaraüdün Saraí ladüga maraüheitu.<verse eid="GEN 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 11:31" />Aba lidin Tera Úrugiñe lun uburugun Kanán lau Abürámü le liráü, Lotu le libari tuma Saraí to lídiñu. Gama lumoun dan le hachülürünbei lidoun fulasu le gíribei Arán, aba herederun aganawa ñein. <verse eid="GEN 11:31" /><verse number="32" style="v" sid="GEN 11:32" />Aba lounwen Tera ñein uburugu Arán lídanbei bián-san lan irumu lau.<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="ms">II. Hawaguti Hagüchagu Ebüréu</para>
  <para style="mr">(<ref loc="GEN 12-50">12—50</ref>)</para>
  <para style="s1">Lagúarun Bungiu lun Abürámü</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />Luagu aban weyu, aba lariñagun Bungiu lun Abürámü:</para>
  <para style="p" vid="GEN 12:1">—Ígirabei bufulasun, biduheñu tuma luban búguchi, ñüdün báamuga lidoun fulasu le lunbei narufuduni bun. <verse eid="GEN 12:1" /><verse number="2" style="v" sid="GEN 12:2" />Nadügüba aban óunwenbu néchani hau badügawagun; nabinirubadibu, naganbahagüdüba buagu, ábanbadibu abinirúni houn amu gürigia. <verse eid="GEN 12:2" /><verse number="3" style="v" sid="GEN 12:3" />Nabinirubaña ha abinirutibu, íñaraguanañame ha íñaragutibu, habinirúba gürigia ubouagu bídangiñe.<verse eid="GEN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4" />Aba láfuridun Abürámü Arangiñe kei lariñaguni Bungiu lun. Ǘrüwa-wein-keinsi irumu lau dan le láfuridunbei ñéingiñe lun lidin Kanán. <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />Barǘ lumutu Saraí to lúmari lúmagua lau sun Lotu le liraühaña lau sun katei le hámabei hau sun gürigia ha lúmabaña uburugu Arán. Dan le hachülürünbei Kanán, <verse eid="GEN 12:5" /><verse number="6" style="v" sid="GEN 12:6" />aba lásügürün Abürámü lamidanguagiñe fulasu ligía darí lachülürün Sikemü, le ñein tubéi tídibu ensina to sagüráuboun Moré. Ñein méhati haganawa Kananna lidan fulasu ligía. <verse eid="GEN 12:6" /><verse number="7" style="v" sid="GEN 12:7" />Ñein larufudagua Bungiu lungua lun, aba lariñagun lun:</para>
  <para style="p" vid="GEN 12:7">—Níchugubei múa le houn badügawagun.</para>
  <para style="p" vid="GEN 12:7">Ábati ladügün Abürámü aban latarü lun Bungiu ñein, ladüga larufudagun lungua lun ñein. <verse eid="GEN 12:7" /><verse number="8" style="v" sid="GEN 12:8" />Lárigiñe aba lidin luagun wübü le luéigiñebei oubaü le ñéingiñe lubéi laboucha weyu libiti uburugu Beteli, ñein líchigoun likianpun. Luéigiñe oubaü le ñéingiñe lubéi lálüda weyu lun fulasu le ñein lubéi líchigoun likianpun leredera uburugu Beteli, anhein uburugu Ai luéigiñeñein oubaü le ñéingiñe lubéi laboucha weyu. Adügayati giñe Abürámü aban latarü lidan fulasu ligía ani aba lagúaruni liri Bungiu. <verse eid="GEN 12:8" /><verse number="9" style="v" sid="GEN 12:9" />Lárigiñe aba lasigiruni lémeri, murusun murusun, lóubawagun Négebü.<verse eid="GEN 12:9" /></para>
  <para style="s1">Abürámü uburugu Ehiptu</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />Lidan dan ligía, aba ladagarun aban óunwenbu ümi fulasurugu, aba lidin Abürámü aganawa Ehiptu luagu átiri dan, ladüga lúan éigini lidan fulasu le ñein lubéi laganawa. <verse eid="GEN 12:10" /><verse number="11" style="v" sid="GEN 12:11" />Dan le achülüreinaaña Ehiptu, aba lariñagun Abürámü tun Saraí to lúmari:</para>
  <para style="p" vid="GEN 12:11">—Subudi numuti luagu magadiñe ban, <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />danme le harihinibu Ehiptuna hariñaguba: «Lúmari wügüri le würi to». Ábameti háfarunina hilagubei, ábame hígirunibu lau ibagari lun herederun bau. <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />Bariñagame lubeiti houn luagu nitu ban, buidu láamuga lidin nun, máfarun hamaamugana hilagubei buéigiñe.<verse eid="GEN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 12:14" />Dan lachülürün Abürámü Ehiptu, aba harihin Ehiptuna luagu weiri lan tumagadiñen Saraí. <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />Aba giñe harihinu lánigu urúei, le lurúeite Ehiptu, aba houdin abahüdagua lun luagu lueirin tumagadiñen würi to. Aba lubeiti hanügünu tidoun luban urúei.<verse eid="GEN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 12:16" />Aba lóuseruni urúei Abürámü buidu luéigiñe tóubadina Saraí, aba ledewehan mudún lun, bágasu, idamuni, burigü hama kameyu. <verse eid="GEN 12:16" /><verse number="17" style="v" sid="GEN 12:17" />Gama lumoun bei lumuti giñe Bungiu urúei hau sun liduheñu hau saragu igei tuéigiñe Saraí. <verse eid="GEN 12:17" /><verse number="18" style="v" sid="GEN 12:18" />Ligía lébubei lóunahan urúei luagu Abürámü, aba lariñagun lun:</para>
  <para style="p" vid="GEN 12:18">—Kame badügei le nun ítara? Ka uagu mariñagun bubalin nun luagu búmari lan würi to? <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />Ariñagatibu luagu bitu lan, ítagaraü yebe nanügünu númarime, badüga. Anuhán búmari, barüboun, beiba!<verse eid="GEN 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 12:20" />Ábati lariñagun urúei houn luwügüriñanigu lun hasagaruni Abürámü tau sun lúmari, lau sun le lúmabei.<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s1">Hafanreinragun Abürámü luma Lotu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />Dan le láfuridunbei Abürámü Ehiptugiñe tau lúmari luma lau sun le lúmabei, aba lagiribudun lóubawagun Négebü. Aba lidin Lotu le liraühaña hama. <verse eid="GEN 13:1" /><verse number="2" style="v" sid="GEN 13:2" />Rísiti méhati Abürámü, ñeinñein golu luma, pülata, hama saragu animaalugu. <verse eid="GEN 13:2" /><verse number="3" style="v" sid="GEN 13:3" />Aba lagiribudun Négebügiñe murusun murusun darí lachülürün Beteli, ñéingiñe aba lidin lidoun fulasu le buga ñein lubéi líchigoun likianpun furumiñe labadinagua Beteli luma Ai. <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />Lidan buga fulasu ligía ladüga aban latarü, aba lafurieidun lun Bungiu ñein.<verse eid="GEN 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 13:5" />Rísiti giñe buga Lotu, kéisigubeirügü Abürámü le liyaurite, ñéinñanu saragu mudún luma, bágasu hama gürigia ha erederubaña luma; <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />gama lumoun lóuguatiti fulasu le ñein habéi lun héigagüdün saragu animaalugu. Siñaaliti buga herederun lidan aban, <verse eid="GEN 13:6" /><verse number="7" style="v" sid="GEN 13:7" />heredera buriti ha óunigirubaliña libiñanigu Abürámü ageindagua hama ha óunigirubaliña libiñanigu Lotu. Ani bóugudin luéi lira ñéingili meha haganawa Kananna hama Féresüna. <verse eid="GEN 13:7" /><verse number="8" style="v" sid="GEN 13:8" />Luagu aban weyu aba lariñagun Abürámü lun Lotu:</para>
  <para style="p" vid="GEN 13:8">—Au buma gaduheñuguatiwa, mabuiduntiti lun ñein lan wuribu wádangua, ni hadan hóuniri bibiñanigu hama hóuniri nibiñanigu. <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />Anihán sun múa, lun banúadahan. Fánreingua wamá. Ánhabu ñüdün luagun nórute, nídiba luagun suru; ánhabu ñüdün luagun suru, nídiba luagun nórute.<verse eid="GEN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 13:10" />Aba larihin Lotu luagun fulasu le lóubagiñebei duna le gíribei Hordán, anihein saragu duna ñein chülǘ lumoun liraüraü fulasu le Sóarü, ítara liña kei aban óunwenbu fuluri-agei. Lenege lumúan Ehiptu. Sun lira lubaragiñe meha lagumuchaguagüdüni Bungiu uburugu burí Sodoma luma Gomora. <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />Ábati lanúadahani Lotu fulasu le lubadubei duna le gíribei Hordán, aba lidin ñeinhin, luagun oubaü le ñéingiñe lubéi laboucha weyu libiti fulasu le ñein habéi buga. Ítara liña lubeiti lafanreinragun Abürámü luma Lotu. <verse eid="GEN 13:11" /><verse number="12" style="v" sid="GEN 13:12" />Aba lerederun Abürámü lóubawagu Kanán, aba lidin Lotu aganawa lidan fulasu le lubadubei uburugu Sodoma, <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />le ñein lubéi wuriba hamá sun lan gürigia, adaaguatiña burí lanarime figóu ligibugiñe Bungiu.<verse eid="GEN 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />Lárigiñe lidin Lotu, aba lariñagun Bungiu lun Abürámü:</para>
  <para style="p" vid="GEN 13:14">—Arihabá lídangiñe fulasu le ñein bubéi luagun nórute luma luagun suru, luagun oubaü le ñéingiñe lubéi laboucha weyu luma le ñeinhin lubéi lálüda; <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />níchugubei sun múa le barihubei bun, bánibei hau sun badügawagun lun sun dan. <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />Nagibedaguagüdübaña kei sagoun le múarugubei. Ítara kei siñá lan labahüdǘn lagu sagoun, ítara luba giñe siñá lan habahüdǘn badügawagun. <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />Saraba éibugabei múa le luagu limigifen luma luagu lidabuberen, ladüga níchigaali bun!<verse eid="GEN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 13:18" />Ítara liña liñuragunu Abürámü likianpun, aba lidin aganawa lidan áraabu le ñein tubei burí tídibu ensina lani aban wügüri gíriti Mamüré, yarafa lun uburugu Ebürón. Aba ladügün aban latarü lun Bungiu ñein.<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s1">Lesefuruni Abürámü Lotu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />Lidan meha dan ligía Amüraféli ligía meha lurúeitebei Sinarü, Arioku lurúeite meha Elasárü, Kedorulaomerü lurúeite meha Elamü, Tidali lurúeite meha Goimü. <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />Aba hawuribuhan hama Bera, lurúeite Sodoma, awuribuha luma Birüsá lurúeite Gomora, awuribuha luma Sinabü lurúeite Adümá, awuribuha luma Semeberü lurúeite Seboimü, awuribuha ligía giñe luma lurúeite Bela, fulasu le gíribei Sóarü. <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />Aba hóundaraguniña seingü urúeigu ha hawügüriñanigu luagu fulasu wayati le gíribei Sidimü, le ñein lubéi Barana Hilaali. <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />Lábugiñeñahañanu lubafu urúei Kedorulaomerü luagu duusu irumu, gama lumoun luagu litareisin irumu, aba hóundaragun seingü urúeigu ha lun hageindagun luma. <verse eid="GEN 14:4" /><verse number="5" style="v" sid="GEN 14:5" />Leweñegua irumu aba lidin Kedorulaomerü hau urúeigu ha lúmagiñebaña aba houdin lóubawagun Ásütarotu-Karünaimü aba háfaraguniña Refaímüna ñein lárigiñe aba háfaraguniña Susitana lidan fulasu le gíribei Amü, áfaragua hamaña giñe Émüna Sawé-kiriataímü, <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />áfaragua hamaña Óruna luagu burí luwübüri Seirü, aba héibaahaniña darí Parán, le yarafabei lun fulasu mageirawati. <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />Dan le lagiribudun Kedorulaomerü hau ha úarabaña luma, aba hachülürün En-misüpátü, lememe giñe gíribei Kadesi. Ñein hagünrinchaguei sun le hadarirubei habarua hageira Amaléküna, ítarameme giñe hadüga houn Amoruna ha lóubawagubaña Asesón-tamarü. <verse eid="GEN 14:7" /><verse number="8-9" style="v" sid="GEN 14:8-9" />Ábati houdin lurúeite Sodoma, lurúeite Gomora lurúeite Adümá, lurúeite Seboimü luma lurúeite Bela luagun fulasu wayati le Sidimü. Aba hageindagun séingügubei hagía ñein hama Kedorulaomerü, Tidali, Amüraféli luma Arioku, gádürü lurúeitegu Elamü, Goimü, Sinarü luma Elasárü. <verse eid="GEN 14:8-9" /><verse number="10" style="v" sid="GEN 14:10" />Lidan sun fulasu lani Sidimü ñeinñein burí huyu buin lau baama le ñéingubeiti, danti le habusenrubei yebe lurúeite Sodoma luma lurúeite Gomora hanurahan, lídangiñe wuribu, aba houdin éiguada lidoun burí huyu ligía. Ha híbiri urúeigu aba houdin luagun burí wübü. <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />Hati agañeirubaña, aba hanügüni sun burí éigini luma burí katei gebegiti le Sodomabei luma Gomora aba houdin ñéingiñe. <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />Keiti Sodoma lan laganawa Lotu le liraühaña Abürámü, aba hanügüni adaürǘwa lau sun le lúmati.<verse eid="GEN 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 14:13" />Gama lumoun ñeinñein aban wügüri esefuruti lau ibagari, aba liabin abahüdaguei le asuseredubei lun Abürámü le ebüréu le aganóubei lidan áraabu lani ensina le lani Mamüré le Amoruna. Mamüré libiri Esükólu luma Anerü, hagía lúmagiñeñanu Abürámü. <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />Dan le laganbunbei Abürámü luagu ladaürǘña lan liraühaña, aba lóundaraguniña sun lumusun ha uágubaña lafiñera, ha agaraüdǘwabaña lúbiñe, ǘrüwa-san-disiwídü wügüriña, aba houdin sun hagía hárigi urúeigu hagía darí ageiraü le gíribei Dan. <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />Aba lábürühan Abürámü hau lánigu sódini hawagun urúeigu hagía áriebu, aba héibaahaniña darí Obá, le luéigiñebei nórute libiti uburugu Damasüku, <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />aba hagidaruni sun buga katei le hanügübei hawéi. Ítara liña lesefuruni Abürámü Lotu le liraühaña, lau sun lúmati. Sefu lumutiña giñe würiña hama híbiri gürigia.<verse eid="GEN 14:16" /></para>
  <para style="s1">Labiniruni Melükisedekü Abürámü</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />Dan le lagiribudunbei Abürámü lárigiñe lagañeiruni Kedorulaomerü hama sun híbiri urúeigu ha lúmagiñebaña, aba liabin lurúeite Sodoma lubaroun luagun fulasu wayati le gíribei Sawé, lememe unbei hariñaga Lufulasun Urúei. <verse eid="GEN 14:17" /><verse number="18" style="v" sid="GEN 14:18" />Aba giñe lasagarun Melükisedekü le lurúeite Sálemü lufadirin giñe Bungiu le íñutimabei fein tuma diwéin, <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />aba labiniruni Melükisedekü Abürámü, lau burí dimurei le:</para>
  <para style="b" vid="GEN 14:19" />
  <para style="q" vid="GEN 14:19">«Binilabu Bungiu le íñutimabei,</para>
  <para style="q" vid="GEN 14:19">le adügübalin sielu luma ubóu;<verse eid="GEN 14:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="GEN 14:20" />Ani rualá giñe uéiriguni lun Bungiu<optbreak /> le íñutimabei</para>
  <para style="q" vid="GEN 14:20">le adügübei lun bagañeiruniña báganiñu».</para>
  <para style="b" vid="GEN 14:20" />
  <para style="p" vid="GEN 14:20">Ábati líchuguni Abürámü diisi lídangiñe san lídangiñe sun le lesefurubei lun Melükisedekü.<verse eid="GEN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 14:21" />Aba lariñagun lurúeite Sodoma lun Abürámü:</para>
  <para style="p" vid="GEN 14:21">—Giribugüdabaña gürigia nun, berederame lau umegeni.<verse eid="GEN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 14:22" />Aba lóunabuni Abürámü:</para>
  <para style="p" vid="GEN 14:22">—Fiñuhadina lun Nabureme, Bungiu le íñutimabei, le adügübalin sielu luma ubóu, <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />luagu márügüdünbadina lan ni kata le bani, ni íbini murusun filu o aban lan tagürüga sabadu lun nagüürünu nisabadun, mariñagun báamuga lachülürün somu weyu luagu buguya lan arisidagüdübalina. <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />Mabusenruntina ni kata nungua, luéidigia le hou hamaalibei numusuniña. Ánhañati wügüriña ha ñǘbuinbaña numa, Anerü, Esükólu luma Mamüré, hanügübei le yuubei houn.<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s1">Ladügün Bungiu aban daradu luma Abürámü</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />Lárigiñe sun katei le, aba ladimurehan Bungiu luma Abürámü lidan uénedü le, lariñaga lun:</para>
  <para style="p" vid="GEN 15:1">—Manufudedabatia Abürámü, au óunigirubalibu. Wéiribei bafayeiruaha.<verse eid="GEN 15:1" /></para>
  <para style="p">
    <verse number="2-3" style="v" sid="GEN 15:2-3" />Aba lóunabuni Abürámü:</para>
  <para style="p" vid="GEN 15:2-3">—Nabureme Bungiu, kagia hu lan nun lun bíchugun afayeiruahaü nun, subudigabei luagu marahüñü nan? Kei míchugun bubéi isaani nun, Elieserü le Damasükuna le aban hádangiñe numusuniña ligíaba galagantei sun le númabei.<verse eid="GEN 15:2-3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 15:4" />Aba lóunabuni Bungiu:</para>
  <para style="p" vid="GEN 15:4">—Biráü guánarüba galagante bárigi, mama aban terencha.<verse eid="GEN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 15:5" />Aba lanügüni Bungiu Abürámü bóugudin, aba lariñagun lun:</para>
  <para style="p" vid="GEN 15:5">—Arihabéi sielu buidu, babahüdañame waruguma ánhaña gayara ban. Ítara luba hiibe badügawagun.<verse eid="GEN 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 15:6" />Afiñeti buga Abürámü luagu Bungiu, ligía leresibirunbalin Bungiu Abürámü keisi gürigia richaguati. <verse eid="GEN 15:6" /><verse number="7" style="v" sid="GEN 15:7" />Ábati lariñagun lun:</para>
  <para style="p" vid="GEN 15:7">—Au Búngiubei, au asagarubalibu uburugugiñe Uru, lun níchuguni múa le bun balaganteme.<verse eid="GEN 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 15:8" />—Gama lumoun Nabureme Bungiu, ida luba san nachoururuni luagu nalagantebei lan múa le? —Liña lóunabun Abürámü.<verse eid="GEN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 15:9" />Aba lariñagun Bungiu lun:</para>
  <para style="p" vid="GEN 15:9">—Barüba aban tiraüraü bágasu nun, aban gábara luma aban mudún ha ǘrüwaali irumu lau kada aban, barǘ buguyame aban unhun, tuma aban tiraüraü wagugua.<verse eid="GEN 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 15:10" />Aba lanügüniña Abürámü sun animaalu ha lun Bungiu, aba líbaahaniña hamidan hámagua, aba líchuguniña gagibugu, gama lumoun míbaagun lumutiña dunuru. <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />Aba buriti hararihan wadubi áluaha héiginiña animaalu hilaguaaña ha, aba labugaguniña Abürámü. <verse eid="GEN 15:11" /><verse number="12" style="v" sid="GEN 15:12" />Dan le lagumeserunbei aguñeda, aba larumugun Abürámü. Sódini aba laburigadun lau, aba lanufudedagun. <verse eid="GEN 15:12" /><verse number="13" style="v" sid="GEN 15:13" />Ábati lariñagun Bungiu lun:</para>
  <para style="p" vid="GEN 15:13">—Lunti basubudiruni luagu haganóuba lan badügawagun lidan aban ageiraü le mama hageira, luagu giñe idamunibaña lan ñein, houserúba wuriba luagu gádürü-san-irumu. <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />Gama lumoun nasufuriragüdübei giñe ageiraü le lunbei lanügüniña kei idamuni, lárigiñeme, ábame háfuridun badügawagun ñéingiñe lau saragu irisini. <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />Buguyati bóunweba lidan darangilaü danme wéiyaadibu, ábame bóundarun hamoun bagüchagu. <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />Lárigiñeme ligadürün háguyugun badügawagun, hagiribuduba lidoun fulasu le, ladüga machülügili lanme hariban Amoruna lumoun lébeha.<verse eid="GEN 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 15:17" />Dan le gúñeeli, aba lasaliragun aban régigi ígiragüdati gumuleli, luma aban gudi durungu ásügüreina hamidanguagiñe animaalu ha buga bíwaguañabaña. <verse eid="GEN 15:17" /><verse number="18" style="v" sid="GEN 15:18" />Weyuméme ligía, aba ladügün Bungiu aban daradu luma Abürámü, lariñaga lun:</para>
  <para style="p" vid="GEN 15:18">—Níchugubei múa le houn badügawagun, lúmagiñe lidunari Ehiptu darí lumoun duna wéiriti le Éufüratesi. <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />Le hamúan Seneuna, Seneseuna, Kadümónna, <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />Étüna, Féresüna, Refaímüna, <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />Amoruna, Kananna, Hérühesina hama Hebusuna.<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s1">Agarü luma Ísümaeli le tiráü</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />Siñati meha tagaraüdün Saraí, gama lumoun ñeinñoun aban tidamun Ehiptuna gíritu Agarü. <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />Ábati tariñagun Saraí lun Abürámü:</para>
  <para style="p" vid="GEN 16:2">—Mígirungili Bungiu lun garáü nan, gama lumoun amuriahatina buma lun bagamaridunu Agarü to nidamun, fagua gayaraabei garahüñü nan tídangiñe.</para>
  <para style="p" vid="GEN 16:2">Aba lánharun Abürámü lun le tamuriahabei Saraí luma, <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />ábati tanügünu Saraí Agarü to Ehiptuna, aba tíchugunu lun Abürámü lun lagamaridunu, dan meha le díisihali irumu hau aganawa Kanán. <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />Aba lagamaridunu Abürámü Agarü, aba tadageinadun; dan le tasubudirunbalin Agarü luagu dageinañoun lan, aba tagumeserun óuseroun Saraí lau mebereseni. <verse eid="GEN 16:4" /><verse number="5" style="v" sid="GEN 16:5" />Ábati tariñagun Saraí lun Abürámü:</para>
  <para style="p" vid="GEN 16:5">—Bídangiñeti tanügünbalina Agarü kei ni kata! Nuguya guánarügü íchugubarun bun lun bagamaridunu, gama lumoun guenlé lau tasubudiruni luagu tagaraüda lan wéiriti tanaagun tungua nuéi. Ariñagaléi Bungiu ka lan wádangiñe gadurunbei, anhein buguya lubéi o nuguya lan.<verse eid="GEN 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 16:6" />Aba lóunabunu Abürámü:</para>
  <para style="p" vid="GEN 16:6">—Búhaburuguñoun bidamun, adügabéi le babusenrun tau.</para>
  <para style="p" vid="GEN 16:6">Ábati tagumeserun Saraí óuseroun wuriba, darí lun tanurun Agarü. <verse eid="GEN 16:6" /><verse number="7" style="v" sid="GEN 16:7" />Aba ladarirunu aban lani Bungiu ánheli lidan fulasu mageirawati laru duna le luágubei lémeri Suru, <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />aba lálügüdünu:</para>
  <para style="p" vid="GEN 16:8">—Agarü, tidamun Saraí, halíagiñedibu san, haliñounbadibu san?</para>
  <para style="p" vid="GEN 16:8">Tariñaga lun:</para>
  <para style="p" vid="GEN 16:8">—Nanurahaña tuéi Saraí to niyubudiri.<verse eid="GEN 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 16:9" />Lariñaga lani Bungiu ánheli ligía tun:</para>
  <para style="p" vid="GEN 16:9">—Giribubá tumoun babureme, badügeime sun le tubeibei.<verse eid="GEN 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 16:10" />Ariñagati giñe lani Bungiu ánheli ligía tun:</para>
  <para style="b" vid="GEN 16:10" />
  <para style="q" vid="GEN 16:10">«Nadügüba lun gibe hamá badügawagun</para>
  <para style="q" vid="GEN 16:10">darime lun siñá lan habahüdǘn.<verse eid="GEN 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="GEN 16:11" />Dageinañadibu, bagaraüdüba<optbreak /> aban irahü</para>
  <para style="q" vid="GEN 16:11">ábame bíchugun Ísümaeli<optbreak /> luagu lírime,</para>
  <para style="q" vid="GEN 16:11">ladüga aganba laali Bungiu bidiheri.<verse eid="GEN 16:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="GEN 16:12" />Derenabei kei aban gabayu áraabuna</para>
  <para style="q" vid="GEN 16:12">lageindaguba hama súngubei,</para>
  <para style="q" vid="GEN 16:12">ageindagua hagíame súngubei luma;</para>
  <para style="q" vid="GEN 16:12">gama lumoun lederebudagüdüboun luban</para>
  <para style="q" vid="GEN 16:12">íbini ánhaña maha líbirigu».<verse eid="GEN 16:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="GEN 16:13" />Kei buga adimurehaaru lan Agarü luma Bungiu aba tíchugun liri: «Bungiu le arihubalina», ladüga tariñagun tungua: «Ariha naali Bungiu ani wínwangidina lun nabahüdaguni». <verse eid="GEN 16:13" /><verse number="14" style="v" sid="GEN 16:14" />Ligía giñe «Lifusun Wínwanti le arihubalina» lubéi líribei fusu ligía. Labadinaguañein Kádesi luma Béredi fusu ligía.<verse eid="GEN 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 16:15" />Aba tíchugun Agarü aban irahü lun Abürámü, aba líchugun Ísümaeli luagu. <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />Gádürü-wein-sisi irumu lau Abürámü dan le garaüwa lubéi Ísümaeli.<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s1">Lichugúniwa seini tuagu lóustarun Abürámü</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />Dan le gádürü-wéinhali-disinéfu irumu lau Abürámü, aba lasaliragun Bungiu lun, lariñaga lun:</para>
  <para style="p" vid="GEN 17:1">—Au Búngiubei le Suntigabafu; winwanbá aban ibagari harumati nigibugiñe, <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />ábame nadügün aban daradu buma. Nadügüba lun gibe hamá badügawagun.<verse eid="GEN 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 17:3" />Ábati labuluchagun Abürámü darí lun ladagarun lerebe múarugu, sun anihán lan Bungiu ariñaga lun:<verse eid="GEN 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 17:4" />—Anihán daradu le lunbei nadügüni buma: Háguchibadibu saragu néchanigu, <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />mámaalime giñe Abürámü biri. Lúmagiñe guentó Abüraámü ligíaba biri, ladüga nadügaadibu lun háguchi ban saragu néchanigu. <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />Nadügüba lun gibe hamá badügawagun; háfuriduba urúeigu hama saragu néchanigu bídangiñe. <verse eid="GEN 17:6" /><verse number="7" style="v" sid="GEN 17:7" />Daradu le nadügübei buma, ani le lunbei giñe nadügüni hama sun badügawagun líteme, luáguti auba lan Bubungiute luma Habungiute lun sun dan. <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />Níchugubei Kanán le ñein lubéi baganawa guentó hun kei halagante lun sun dan, ani auba Hubungiute.<verse eid="GEN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 17:9" />Ariñagati giñe Bungiu lun Abüraámü:</para>
  <para style="p" vid="GEN 17:9">—Gama lumoun buguya gúnfuliba lau nidaradun; buguya hama sun badügawagun. <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />Anihán daradu le nadügübei huma, le lunbei giñe hagunfuliruni sun badügawagun:</para>
  <para style="p" vid="GEN 17:10">Sun wügüriña hidan, gasu lichugúniwa seini tuagu hóustarun. <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />Mosu lubeiti lichugúniwa seini tuagu hóustarun, ligíaba liseinin nidaradun huma. <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />Lúmagiñe uguñe lun lubaruaguóun, sun wügüri irahü águrahouti húbiñe, gasu lichugúniwa seini tuagu lóustarun luagu widü weyu luéigiñe lágurahoun, dandu idamuni le agañeihóuarügüti lau seinsu luma giñe furumiñeguarügü terencha. <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />Dandu aban kei le aban, gasu lichugúniwa seini tuagu lóustarun. Ítara luba lerederun liseinin nidaradun luagu húgubu keisi aban daradu lun sun ibagari. <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />Le michugúnti seini tuagu lóustarun siñabei laganóun haganagua ladüga mineben lan nidaradun lun.<verse eid="GEN 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15" />Ariñagati giñe Bungiu lun Abüraámü:</para>
  <para style="p" vid="GEN 17:15">—Mámaalime Saraí tiri búmari Sara ligíaba tiri guentó. <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />Nabiniruboun, ábame níchugun aban irahü bun tídangiñe. Ayé, nabiniruboun. Háguchuboun saragu néchanigu, ani lurúeitebaña burí ageiraü tadügawagun.<verse eid="GEN 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 17:17" />Aba labuluchagun Abüraámü darí ladagarun lerebe múarugu, aba léherahan sun anihán lan asaminara lúnguarügü: «Gayaraabei funagia lagaraüdün aban wügüri le sánhali irumu lau? Tagaraüdüba funagia Sara luagu gádürü-wein-diisi irumu tau?» <verse eid="GEN 17:17" /><verse number="18" style="v" sid="GEN 17:18" />Ábati lariñagun lun Bungiu:</para>
  <para style="p" vid="GEN 17:18">—Gayaraadügü láamuga lawinwandun Ísümaeli lau babinihan!<verse eid="GEN 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 17:19" />Aba lóunabuni Bungiu:</para>
  <para style="p" vid="GEN 17:19">—Le nariñagubei luagu tagaraüdüba lan Sara to búmari aban irahü, ábame bíchugun Isaakü luagu. Lauba irahü ligía nederagüdei nidaradun, ábame nágüdahani nidaradun hama ladügawagun lun sun dan. <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />Ánheinti luagu Ísümaeli, aganba náadibu giñe ani nabinirubei giñe; nadügüba lun gibe hamá lirahüñü, luma lun haganwoundun ladügawagun. Háguchibei duusu ábutigu wéirigutiña Ísümaeli, nadügüba aban ageiraü wéiriti lídangiñe. <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />Gama lumoun nágüdahabei nidaradun luma Isaakü, le lunbei tagaraüdüni Sara bau aban irumu lárigiñe le.<verse eid="GEN 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 17:22" />Dan le lásurun ladimurehan Bungiu luma Abüraámü, aba lidin ñéingiñe. <verse eid="GEN 17:22" /><verse number="23" style="v" sid="GEN 17:23" />Lidan weyu ligía aba líchugun Abüraámü seini tuagu lóustarun Ísümaeli, ru ligía seini tuagu hóustarun sun idamuni ha águrahoubaña lúbiñe hama ha lagañeihabaña lau liseinsun. Ruti Abüraámü seini tuagu hóustarun sun wügüriña ha aganóubaña lúbiñe, kei lariñaguni Bungiu lun. <verse eid="GEN 17:23" /><verse number="24-25" style="v" sid="GEN 17:24-25" />Gádürü-wein meha disinéfu irumu lau Abüraámü, tareisi irumu lau Ísümaeli le liráü dan le líchugunbei seini tuagu lóustarun. <verse eid="GEN 17:24-25" /><verse number="26" style="v" sid="GEN 17:26" />Lídanmeme weyu ligía lichugúa seini tuagu lóustarun Abüraámü lau sun Ísümaeli le liráü, <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />úara hama sun wügüriña ha lúbiñebaña, dandu idamuni ha águrahoubaña lúbiñe, kei ha agañeiharügü lubaña hámagiñe terencha luagu seinsu.<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s1">Füramase lan Bungiu aban irahü lun Abüraámü</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />Luagu aban amidirugu, dan anihán lan Abüraámü ñun tigibugiñe likianpun lidan áraabu le tani ensina le lani Mamüré, aba lasaliragun Bungiu lun. <verse eid="GEN 18:1" /><verse number="2" style="v" sid="GEN 18:2" />Dan le liñuraguni Abüraámü larihin, ñéinñanu ǘrüwa wügüriña rara ligibugiñe. Aba lásaarun furese lun leresibiruniña, aba labuluchagun darí ladagarun lerebe múarugu, <verse eid="GEN 18:2" /><verse number="3" style="v" sid="GEN 18:3" />lariñaga:</para>
  <para style="p" vid="GEN 18:3">—Naburemegu, adüga humá fulesei nun, midin humá yebe. <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />Anhein buidu larihín hun, namuriaha murusun duna lun lachibún hugudi, lárigiñeme ábame hemeraagun murusun lábugiñe lamuña tídibu wewe to. <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />Kei sügühadün lubéi ligibugiñe ñein lubéi naganawa, nanüga somu katei hun lun heigin lun héreme lubá hasigiruni héibugun.</para>
  <para style="p" vid="GEN 18:5">Aba hóunabuni:</para>
  <para style="p" vid="GEN 18:5">—Buiti, adügabéi.<verse eid="GEN 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 18:6" />Aba lebelurun Abüraámü lúbiñoun, aba lariñagun tun Sara:</para>
  <para style="p" vid="GEN 18:6">—Furesebá! Barüba bián-wein líburu tídangiñe tubuidun-agei fulúaru ábame badügün fein.<verse eid="GEN 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 18:7" />Aba léibaagun Abüraámü le ñeinhin habéi lilügüniña bágasu, aba lanúadahani lubuidun-agei liraüraü bágasu le ñeinbei, aba líchuguni lun aban hádangiñe lumusuniña, aba laranseruni furese lun éigini. <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />Bóugudin luéi liraüraü bágasu ligía, ruti Abüraámü furumasu houn luma míligi, aranseñu ligía lun leseriwiduniña sun añaha lan eiga, lábugiñe tídibu wewe. <verse eid="GEN 18:8" /><verse number="9" style="v" sid="GEN 18:9" />Dan le lásurun heigin, aba hálügüdüni bisidatiña hagía Abüraámü:</para>
  <para style="p" vid="GEN 18:9">—Hagóun Sara to búmari?</para>
  <para style="p" vid="GEN 18:9">Lariñaga houn:</para>
  <para style="p" vid="GEN 18:9">—Anuhán ñein tidan kianpu.<verse eid="GEN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 18:10" />Aba lariñagun aban hádangiñe:</para>
  <para style="p" vid="GEN 18:10">—Niábiyaba arihabu leweñegua irumu, lúmounme dan ligía garaüharume Sara aban wügüri irahü.</para>
  <para style="p" vid="GEN 18:10">Sun bugati dan le, anuhán buga Sara aganbahei sun le hariñagubei lun Abüraámü, lubadugiñe tubenari kianpu, ibidiñounga lun Abüraámü. <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />Abüraámü tuma Sara wéiyougaaña, miábinhaliha tidaani Sara tun. <verse eid="GEN 18:11" /><verse number="12" style="v" sid="GEN 18:12" />Ligía tásiñarunbalin Sara éherahani ligía awanda, aba tasaminarun túnguarügü:</para>
  <para style="p" vid="GEN 18:12">—Ida luba san lasuseredun katei le, guenlé dan le wéiyougaadiwa nuguya lau sun númari?<verse eid="GEN 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 18:13" />Aba lariñagun Bungiu lun Abüraámü:</para>
  <para style="p" vid="GEN 18:13">—Ka uagu téheraha Sara? Mafiñetu luagu gayara lan tagaraüdün lau sun wéiyaaru lan? <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />Anihein funagia katei wéiriti lénrengun lun lásiñaruni Bungiu adüga? Niábiyaba arihabu leweñegua irumu, lúmounme dan ligía garaüharume Sara aban wügüri irahü.<verse eid="GEN 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 18:15" />Dan le taganbuni Sara katei le, aba tanufudedun, aba tabusenrun yebe teyeedagun. Tariñaga:</para>
  <para style="p" vid="GEN 18:15">—Méherahantina.</para>
  <para style="p" vid="GEN 18:15">Lariñaga Bungiu tun:</para>
  <para style="p" vid="GEN 18:15">—Subuseti nun luagu éheraha ban.<verse eid="GEN 18:15" /></para>
  <para style="s1">Lamuriahan Abüraámü luma Bungiu luagu Sodoma</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />Lárigiñe aba hásaarun bisidatiña hagía, aba hagumeserun éibuga uburugun Sodoma. Aba lidin Abüraámü úara hama lun layouragun houn. <verse eid="GEN 18:16" /><verse number="17" style="v" sid="GEN 18:17" />Aba lasaminarun Bungiu: «Mosu nariñaguni lun Abüraámü kaba lan nadüga, <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />ladüga lúguchibei aban néchani wéiriti ani héreti. Füramasetina lun luagu nabinirubaña lan sun néchanigu ha ubouagubaña lídangiñe. <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />Anúadira naali lun lagumadiruniña lirahüñü hama ladügawagun lun hadügüni le narufudahabei houn, adüga hameime sun le buídubei luma le úaraguabei, lun gayara lan nagunfulirun lau sun le füramase náalibei lun».<verse eid="GEN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 18:20" />Aba lubeiti lariñagun Bungiu:</para>
  <para style="p" vid="GEN 18:20">—Wuribati ladimurehoun hawagu gürigia ha Sodomana hama Gomorana, hanarimeti giñe hafigoun, <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />néibuga lubeiti ñein guentó arihei anhein inarüni lubéi luagu weiri lan hariban kei lariñawagúniwa nun. Ítara luba nasubudiruni.<verse eid="GEN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 18:22" />Aba houdin biama hádangiñe bisidatiña hagía ñéingiñe lun uburugun Sodoma, anhein Abüraámü ábameme lerederun ligibugiñe Bungiu. <verse eid="GEN 18:22" /><verse number="23" style="v" sid="GEN 18:23" />Aba layarafadunmémeraü luagun, aba lariñagun lun:</para>
  <para style="p" vid="GEN 18:23">—Bagumuchaguagüdübaña san giñe ha madurunbaña úara hama ha gadurunbaña? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />Háfuga añahein dimí-san gürigia maduruntiña, bagünrinchaguamemebei uburugu ligía, úabei ferudunabani hawagu dimí-san hagía? <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />Mafiñentina anhein bagünrinchagubei lubéi le madurunbei úara luma le gadurunbei, kamá hamuga ábanmeme hafigoun biángubei hagía! Madügabéi lira! Buguya le aguseragüdüti íñugutimati lidan sun ubóu, Maguseragüdünbadibu san lau irichaü?<verse eid="GEN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 18:26" />Ábati lóunabuni Bungiu:</para>
  <para style="p" vid="GEN 18:26">—Ánhana adarira dimí-san gürigia maduruntiña Sodoma, hadüga dimí-san hagía feruduna nubaña sun ha ñéinbaña.<verse eid="GEN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 18:27" />Ábaya lariñagun Abüraámü:</para>
  <para style="p" vid="GEN 18:27">—Ferudunabana luagu nadimurehan bun ítara, ladüga Bungiu buguya, anhein au wügürirügüñadina, <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />fagua mégeibaña seingü lun hóustarun dimí-san maduruntiña. Hawagurügü seingü hagía bagünrinchagubei san uburugu?</para>
  <para style="p" vid="GEN 18:28">Aba lóunabuni Bungiu:</para>
  <para style="p" vid="GEN 18:28">—Ánhana adarira bián-wein-seingü maduruntiña, magünrinchagun nubéi.<verse eid="GEN 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 18:29" />Ábaya lariñagun Abüraámü:</para>
  <para style="p" vid="GEN 18:29">—Angia hamuga lun bián wéinrügüñanu lan maduruntiña ñein.</para>
  <para style="p" vid="GEN 18:29">Lariñaga Bungiu:</para>
  <para style="p" vid="GEN 18:29">—Magünrinchagun nubéi uburugu ligía hawagurügü bián wein hagía.<verse eid="GEN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 18:30" />Ábaya layumuragun Abüraámü, lariñaga:</para>
  <para style="p" vid="GEN 18:30">—Magañidabátia numa luagu nagiribuhan saragu luagu ábanmeme katei, fagua badarirun darandirügü maduruntiña.</para>
  <para style="p" vid="GEN 18:30">Ábaya lóunabuni Bungiu:</para>
  <para style="p" vid="GEN 18:30">—Feruduna nubéi uburugu ligía hawagurügü darandi hagía.<verse eid="GEN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 18:31" />Ábameme lagiribuhan Abüraámü, lariñaga:</para>
  <para style="p" vid="GEN 18:31">—Nabureme, afiñetina gíbeyaali lan namuriahan, gama lumoun kaba san asusereda ánhabu adarira wéinrügü maduruntiña?</para>
  <para style="p" vid="GEN 18:31">Aba lóunabuni Bungiu:</para>
  <para style="p" vid="GEN 18:31">—Magünrinchagun nubéi uburugu hawagurügü wein hagía.<verse eid="GEN 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 18:32" />Agiribuhamémegili Abüraámü, lariñaga:</para>
  <para style="p" vid="GEN 18:32">—Magañidabatia numa Nabureme, lagumuhóun namuriahan le, mananihanhadiname bun. Kaba san badüga ánhabu adarira díisirügü?</para>
  <para style="p" vid="GEN 18:32">Lariñaga Bungiu lun:</para>
  <para style="p" vid="GEN 18:32">—Magünrinchagun nubéi uburugu hawagurügü diisi hagía.<verse eid="GEN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 18:33" />Dan lásurun ladimurehan Bungiu luma Abüraámü, aba lidin ñéingiñe, aba lagiribudun Abüraámü tidoun likianpun.<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s1">Lagünrinchaguni Bungiu Sodoma luma Gomora</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />Lagumeseruña aguñeda dan le hachülürünbei bián lani Bungiu ánheli hagía Sodoma. Ñun liña Lotu bénabu libiti uburugu, ñein lubeiha hóundaragua gürigia. Dan le larihinbaliña, aba lásaarun eresibiraña, aba labuluchagun darí ladagarun lerebe múarugu, <verse eid="GEN 19:1" /><verse number="2" style="v" sid="GEN 19:2" />lariñaga houn:</para>
  <para style="p" vid="GEN 19:2">—Amuriahatina huma lun hásügürüni áriebu núbiñe. Gayaraabei hachibuni hugudi ñein, ábame hasigiruni héibugun haruga binaafin.</para>
  <para style="p" vid="GEN 19:2">Hariñaga lun:</para>
  <para style="p" vid="GEN 19:2">—Uá, teinki waña bun. Wásügürübei, áriebu ǘmadarugu ya uburugu.<verse eid="GEN 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 19:3" />Ábaya lagiribuhan Lotu saragu, aba hánharun lun houdin luma lúbiñoun. Dan le hachülürünbei, aba laranserun Lotu éigini houn, aba hadügün fein to maganatu lébini, aba heigin. <verse eid="GEN 19:3" /><verse number="4" style="v" sid="GEN 19:4" />Marounrungiña yebe ligía hegeyedagunu sun wügüriña Sodomana luban Lotu, lúmagiñe le ñǘraütimagilibei dagá lumoun le wéiyatimahalibei, <verse eid="GEN 19:4" /><verse number="5" style="v" sid="GEN 19:5" />aba hagumeserun agúaraha lun Lotu:</para>
  <para style="p" vid="GEN 19:5">—Hagaña wügüriña ha ñǘbuinbaña búbiñoun guñoun to? Sagabaña! Busentiwa wagamariduniña!<verse eid="GEN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 19:6" />Ábati láfuridun Lotu adimureha hama, gama lumoun aba ladouruni bena buidu dan le láfuridun, <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />lariñaga houn:</para>
  <para style="p" vid="GEN 19:7">—Adüga humá fulesei nun numadagu, madüga huméi katei wíyeti le. <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />Añahán bián nirahüñü würiña mámarigiña, nasagaraaña hun lun hadügüni le habusenrun hau, gama lumoun madüga humá ni kata hau wügüriña ha ladüga nagunbirahan núbiñoun ani mosu nóunigiruniña.<verse eid="GEN 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 19:9" />Aba hariñagun lun:</para>
  <para style="p" vid="GEN 19:9">—Gidaba ñéingiñe! Lúnrügaali buga liabin aban terencha kei buguya agumadirawa. Wuribatimabei wadüga bun sügǘ hau guentó.</para>
  <para style="p" vid="GEN 19:9">Aba hagumeserun Sodomana óuserei Lotu wuriba, aba houdin luagun bena lun háguruni, <verse eid="GEN 19:9" /><verse number="10" style="v" sid="GEN 19:10" />aba hínchuni bisidatiña ha lúbiñebaña Lotu háhabu, aba hebelaagüdüni Lotu, aba hadouruni bena, <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />aba marihingüda hamaniña bisidatiña ha lúbiñebaña Lotu wügüriña ha bóugudibaña. Sun hagía lúmagiñe le ñǘraütimagilibei dagá lumoun le wéiyatimahalibei, aba labuchadun hawagu áluahei bena.<verse eid="GEN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12" />Ábati hariñagun bisidatiña hagía lun Lotu:</para>
  <para style="p" vid="GEN 19:12">—Añaheingua amu biduheñu ya? Barübaña birahüñü, bibarimugu, luma sun le bánibei lidan uburugu le, sagabaña, beiba hau dise yáagiñe, <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />ladüga wagünrinchaguaali fulasu le. Gíbeeli laganbahoun hawagu lílana uburugu le, ligía lóunahanbaliwa Bungiu agünrinchaguei.<verse eid="GEN 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 19:14" />Ábati lidin Lotu hamoun libarimugu ha hadarigu lirahüñü, aba lariñagun houn:</para>
  <para style="p" vid="GEN 19:14">—Sará humá furí humá lídangiñe fulasu le, ladüga lagünrinchaguaali Bungiu!</para>
  <para style="p" vid="GEN 19:14">Gama lumoun mafiñeruntiña lun le lariñagubei Lotu houn.<verse eid="GEN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 19:15" />Keiti, arugadeina liña lubéi, aba hariñagun lani Bungiu ánheligu lun Lotu:</para>
  <para style="p" vid="GEN 19:15">—Furesebá! Saraba, barüboun búmari hau bián birahüñü würiña yáagiñe, anhein mabusenrun bubéi bounwen danme le wagünrinchaguni uburugu le.<verse eid="GEN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 19:16" />Keiti ladarasahan Lotu, aba hárügüdüni lani Bungiu ánheligu lúhabu, ladüga lagudemedagun lun Bungiu. Barǘ hamutu giñe lúmari hama lirahüñü würiña aba hasagaruniña uburugugiñe lun hesefurun. <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />Dan le furihaña lubéi uburugugiñe, aba lariñagun aban hádangiñe lani Bungiu ánheligu:</para>
  <para style="p" vid="GEN 19:17">—Éibaaguaba, sefubá! Madigiraguabatia bárigoun, mararamagun buguyame luagu ni kata lidan fulasu wayati. Beiba luagun burí wübü anhein busén bubéi besefuruni bibagari.<verse eid="GEN 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 19:18" />Lariñaga Lotu houn:</para>
  <para style="p" vid="GEN 19:18">—Uá naburemegu, fulesei humana! <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />Gíbeeli fulesei hadüga nun ani buitün numa lau hesefuruni nibagari, gama lumoun siñati nidin luagun wübü ragüliñelina lagünrinchawagun fulasu ǘmadarugu ábame nounwen. <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />Yarafa yáagiñe anihein aban liraüraü uburugu! Ígira humana lun nidin ñeinhin lun nesefuruni nibagari! Lidan linarün katei ñǘraüraüti uburugu ligía!<verse eid="GEN 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 19:21" />Aba lariñagun aban hádangiñe:</para>
  <para style="p" vid="GEN 19:21">—Aganba náadibu, nadügaali le bamuriahabei. Magünrinchagun nubéi fulasu le uágubei badimureha nun. <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />Gama lumoun óufudaba! Beiba ñeinhin ladüga siñabei nadügün ni kata ánhabu machülü lidoun fulasu ligía.</para>
  <para style="p" vid="GEN 19:22">Ligía Sóarü lubéi líribei fulasu ligía.<verse eid="GEN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23" />Dan le harugaali, lárigiñe lachülürün Lotu lidoun fulasu ligía le gíribei Sóarü, <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" />aba láhuyagüdün Bungiu watu gemeti luma súfuru luagun Sodoma luma Gomora, <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />aba lagünrinchaguni hau sun ha aganóubaña ñein, gumuguagüdalei sun le áhüchübei ñein lidan fulasu wayati ligía. <verse eid="GEN 19:25" /><verse number="26" style="v" sid="GEN 19:26" />Ánhounti lúmari Lotu, aba tiabin lárigi lárigi, gama lumoun aba tadigiragun tárigoun, aba tasaliragun ábanme guáriua lautu salu reiti ñein.<verse eid="GEN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 19:27" />Larugan binaafin, aba lidin Abüraámü lidoun fulasu le ñein lubéi buga ladimureha luma Bungiu; <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />aba larihin uburugun Sodoma luma Gomora luma luagun fulasu wayati, aba larihin láfurihan gumuleli lídangiñe sun fulasu ligía kamá hamuga aban régigi. <verse eid="GEN 19:28" /><verse number="29" style="v" sid="GEN 19:29" />Ítara liña lagünrinchaguni Bungiu uburugu burí le lídanbei fulasu wayati le ñein lubéi buga laganawa Lotu. Gama lumoun haritaguati luagun Abüraámü, aba lasagaruni Lotu lídangiñe fulasu le agünrinchawagubei.<verse eid="GEN 19:29" /></para>
  <para style="s1">Hagücha Moábüna hama Amonna</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />Lárigiñe aba lanufudedun Lotu lun lerederun aganawa Sóarü, aba lidin aganawa dabíararugu, aba lanügüniña bián lirahüñü würiña lúmagua. Aba haganóun ǘrüwagubei hagía ñein lagadábugiñe dübü. <verse eid="GEN 19:30" /><verse number="31" style="v" sid="GEN 19:31" />Luagu aban weyu, aba tariñagun íbugañaü tun amuleluaü:</para>
  <para style="p" vid="GEN 19:31">—Wéiyaali wáguchi, ani úati ni aban eyeri ya lidan fulasu le lun lamarieidun wama keisi échuni; <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />wabacharuadagüdaali wáguchi, ábame warounrun luma garahüñü wamaamuga lau.<verse eid="GEN 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 19:33" />Gúñounmeme ligía aba híchugun diwéin lun háguchi, aba tarounrun to íbugañaü luma; gama lumoun mefenti háguchi luagu tarounrun luma, ni dan le tásaarun. <verse eid="GEN 19:33" /><verse number="34" style="v" sid="GEN 19:34" />Larugan, aba tariñagun íbugañaü tun amuleluaü:</para>
  <para style="p" vid="GEN 19:34">—Róuntinatia luma wáguchi áriebu, wabacharuadagüdayaali guñoun le roun báamuga luma, garahüñü wamaamuga wagía biángubei lau.<verse eid="GEN 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 19:35" />Guñoun ligía ábaya híchugun diwéin lun háguchi, aba tidin amuleluaü arounra luma, gama lumoun mefenti giñe Lotu luagu tarounrun luma ni luagu tásaarun. <verse eid="GEN 19:35" /><verse number="36" style="v" sid="GEN 19:36" />Ábati hadageinadun biángubei lirahüñü Lotu lau. <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />Aba tagaraüdün íbugañaü aban wügüri irahü aba tíchugun Moabü luagu, ligía háguchibei Moábüna guentó. <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />Aba giñe tagaraüdün amuleluaü, aba tíchugun Ben-amí luagu, ligía háguchibei Amonna guentó.<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s1">Abüraámü luma Abimélekü</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />Aba láfuridun Abüraámü lídangiñe fulasu le ñein lubéi buga, aba lidin lóubawagun Négebü, aba lerederun aganawa uburugu Gerarü, labadinagua Kádesi luma Suru. <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />Sun anihán lan ñein, aba lariñagun luagu litu lan Sara to lúmari. Ábati lóunahan Abimélekü le urúeibei uburugu Gerarü anügoun Sara lun yebe lanügünu lúmarime; <verse eid="GEN 20:2" /><verse number="3" style="v" sid="GEN 20:3" />gama lumoun áriebu ligía aba lariñagun Bungiu lun Abimélekü lidan aban uénedü:</para>
  <para style="p" vid="GEN 20:3">—Bounwe, ladüga würi to banügüboun, maríeitu.<verse eid="GEN 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 20:4" />Keiti marounrungili lan tuma, aba lóunabun:</para>
  <para style="p" vid="GEN 20:4">—Nabureme, haritaguatibu funagia báfarun aban gürigia le madügünti ni kata wuribati? <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />Abüraámü guánarügü ariñagubei nun luagu litu lan würi to, ariñaga tuguya giñe luagu tati lan ligia; lau lubéi yebeti taruman nanigi nadügei le, afiñetina madügüntina wuribati.<verse eid="GEN 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 20:6" />Ábati lóunabuni Bungiu lidan luénedü:</para>
  <para style="p" vid="GEN 20:6">—Subudi numuti luagu lau lan taruman banigi badügei. Ligía mígirun nubéi lun barounrun tuma, luéi bafigouhan nigibugiñe. <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />Guentó, ruboun lúmari wügüri le lun tárigoun ladüga profeta ligía, lafurieiduba buagu lun babagaridun, gama lumoun anhoun míchugun ban lun, bóunweba hau sun biduheñu.<verse eid="GEN 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 20:8" />Larugan binaafin aba lásaarun Abimélekü, aba lagúarun houn luwügüriñanigu, aba labahüdaguni luénedü houn. Dan le haganbunbalin, aba hanufudedagun. <verse eid="GEN 20:8" /><verse number="9" style="v" sid="GEN 20:9" />Lárigiñe aba lagúarun Abimélekü lun Abüraámü, lariñaga lun:</para>
  <para style="p" vid="GEN 20:9">—Arihabá badüga woun! Kagia wuribati nadügübei bun, lun banügübei lan óunwenbu figóu le nuagun hau sun numutuniña? Adügaadibu aban katei nun le moun lumuti ladügǘn. <verse eid="GEN 20:9" /><verse number="10" style="v" sid="GEN 20:10" />Ka baritagubei dan le badügünbalin sun le? Ítara liña ladimurehan Abimélekü lun Abüraámü.<verse eid="GEN 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 20:11" />Aba lóunabuni Abüraámü:</para>
  <para style="p" vid="GEN 20:11">—Haritaguatina yebe luagu minebenwa lan Bungiu lidan fulasu le, ani luagu háfarubadina lan tuéigiñe númari. <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />Gama lumoun inarüni luagu nitu lan tuguya; liráü núguchi, gama lumoun mama tiráü núguchu, ligía namarieidunbei tuma. <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />Dan le lasagarunbalina Bungiu lúbiñegiñe núguchi, aba namuriahan tuma lun sun lan fulasu ñein lumuti wachülüra lun tariñagun luagu tati lan au.<verse eid="GEN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 20:14" />Ábati líchugunu Abimélekü lúmari Abüraámü lun tárigoun. Edeweha ligía mudún lun, bágasu, hama idamuni, <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />lariñaga lun:</para>
  <para style="p" vid="GEN 20:15">—Anihán numúan, anúadahabei fulasu le hínsiñeti bun lidan lun baganóun ñein.<verse eid="GEN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 20:16" />Lariñaga tun Sara:</para>
  <para style="p" vid="GEN 20:16">—Milu murusun pülata lebegibei sun le níchugubei lun bati, leseriwiduba lun labuiduragüdüni ladimurehoun buagu hagibugiñe sun ha búmabaña. Úabaña adimurehatiña wuriba buagu.<verse eid="GEN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 20:17" />Ábati lafurieidun Abüraámü lun Bungiu aba lareidaguagüdüni Bungiu Abimélekü tau sun lúmari. Areidaguagüda lumutiña giñe tumusuniña ha würiña lun gayara lan hagaraüdün, <verse eid="GEN 20:17" /><verse number="18" style="v" sid="GEN 20:18" />ladüga adügaali yebe Bungiu lun ua tan würi agaraüdütu hádangiñe ha lúbiñebaña Abimélekü tuéigiñe Sara.<verse eid="GEN 20:18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s1">Lágurahoun Isaakü</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />Kei füramaselani Bungiu tun Sara aba lagunfuliruni le lariñagubei tun, <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />ítara liña tadageinadun, aba tagaraüdün aban wügüri irahü lau Abüraámü dan le wéiyaali. Aba lágurahoun irahü ligía lidan dan le buga lariñagubei Bungiu. <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />Isaakü ligía iri le líchugubei Abüraámü luagu irahü le tagaraüdübei Sara lau, <verse eid="GEN 21:3" /><verse number="4" style="v" sid="GEN 21:4" />aba híchugun seini tuagu lóustarun dan le wídühali weyu lau, kei lariñaguni Bungiu lun. <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />San irumu lau Abüraámü dan le garaüwa lubéi Isaakü. <verse eid="GEN 21:5" /><verse number="6" style="v" sid="GEN 21:6" />Aba tariñagun Sara túnguarügü:</para>
  <para style="p" vid="GEN 21:6">—Éheraagüda láadina Bungiu, sunme ha asubudiruti luagu garaühadina lan, héherahaba numa.<verse eid="GEN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 21:7" />Kaba yebe ariñaga lun Abüraámü luagu nagaraüdüba lan lau! Gama lumoun rúhadina aban irahü lun, lau sun wéiyaali lan.<verse eid="GEN 21:7" /></para>
  <para style="s1">Tabugún Agarü lau Ísümaeli</para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 21:8" />Aba laweiridun Isaakü, aba lachularun. Aba ladügün Abüraámü aban óunwenbu fedu le weyu le lachularunbei Isaakü.<verse eid="GEN 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 21:9" />Gama lumoun aba tarihin Sara luagu leredera lan burí Ísümaeli le tagaraüdübei Agarü to Ehiptuna lau Abüraámü adaagua bula lau Isaakü.<verse eid="GEN 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 21:10" />Aba tidin ariñaga lun Abüraámü:</para>
  <para style="p" vid="GEN 21:10">—Teiba idamuni to yáagiñe lau tiráü! Mabiamadagunbei niráü Isaakü luagu lalagante luma tiráü idamuni to.<verse eid="GEN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 21:11" />Gárititi katei le lun Abüraámü saragu ladüga liráü lan giñe Ísümaeli. <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" />Gama lumoun lariñaga Bungiu lun:</para>
  <para style="p" vid="GEN 21:12">—Madiheribá luagu Ísümaeli luma tuagu bidamun. Adügabéi sun le tamuriahan Sara buma, ladüga lídangiñeba Isaakü hayabin badügawagun. <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />Nadügüba giñe lun liyabin aban néchani wéiriti lídangiñe Ísümaeli, ladüga biráü ligía.<verse eid="GEN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 21:14" />Larugan, binaafingiua aba lanügün Abüraámü fein, gueru lau duna; aba líchuguni tanagawagu Agarü, aba líchuguni Ísümaeli tun aba lóunahanu. Aba tidin, aba téibugun lidan fulasu mageirawati le gíribei Bérüsewa, ibidiñounga tun haliñounboun lan. <verse eid="GEN 21:14" /><verse number="15" style="v" sid="GEN 21:15" />Dan le lagumuchunbei duna le lídanbei gueru, aba tígiruni irahü lábugiñe aban híduru, <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />aba tidin añuura dise ñéingiñe luéi tarihini lounwen. Dan le tañuurunbei, aba lagumeserun irahü ayahua. <verse eid="GEN 21:16" /><verse number="17" style="v" sid="GEN 21:17" />Gama lumoun aba laganbuni Bungiu layahun irahü le, aba lagúarun aban lani Bungiu ánheli tun Agarü siélugiñe, lariñaga tun:</para>
  <para style="p" vid="GEN 21:17">—Ka suserebei bun Agarü? Manufudedabá, ladüga aganba laali Bungiu layahun irahü le, le ñein lubéi. <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />Beiba! Budabei, ragübei lúhabu, nadügüba lun liabin aban néchani wéiriti lídangiñe.<verse eid="GEN 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 21:19" />Aba larihagüdün Bungiu aban fusu lau duna tun Agarü. Aba tidin, aba tabuinchagüdüni gueru lau duna, aba tíchugun lun Ísümaeli lun latun.<verse eid="GEN 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 21:20" />Aba líderaguni Bungiu aba laweiridun, aba laganóun lidan fulasu mageirawati, aba liabin lun ábanbei lan buiti gachüühaditi gimara. <verse eid="GEN 21:20" /><verse number="21" style="v" sid="GEN 21:21" />Aba laganóun lidan fulasu mageirawati le gíribei Parán, lárigiñe aba tamarieidagüdüni lúguchu tuma aban würi Ehiptuna.<verse eid="GEN 21:21" /></para>
  <para style="s1">Ladügün Abüraámü aban daradu luma Abimélekü</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />Kei burí lídounmeme dan ligía, aba lidin Abimélekü adimureha luma Abüraámü. Ñǘdünti Fikolu le hábuti lisudaran luma. Lariñaga Abimélekü lun Abüraámü:</para>
  <para style="p" vid="GEN 21:22">—Ariha wamuti luagu íderagua lánibu Bungiu lidan sun le badüga. <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />Fiñuba lubeiti nun lídanmeme fulasu le, luagu madügünbadibu lan ni kata wuribati nun, ni houn nirahüñü, ni houn nadügawagun. Fiñuba nun luagu bóuserubadina lan laumeme areini le aubei nóuserabu, ani ítarameme luba lan giñe badüga hama lílana fulasu le ñein lubéi baganawa guentó.<verse eid="GEN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 21:24" />Lariñaga Abüraámü lun:</para>
  <para style="p" vid="GEN 21:24">—Fiñú numuti bun.<verse eid="GEN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 21:25" />Gama lumoun aba lererun Abüraámü lun Abimélekü luéigiñe aban fusu le hagidarubei lumusun Abimélekü luéi.<verse eid="GEN 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 21:26" />Aba lóunabun Abimélekü:</para>
  <para style="p" vid="GEN 21:26">—Darí guentó ibidiñeti yebe ni kata libügürü katei le nun, ladüga mariñagunbani nun. Ibidiñeti giñe nun ka lan adügübalin.<verse eid="GEN 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 21:27" />Ábati lanügün Abüraámü mudún hama bágasu, aba líchuguniña lun Abimélekü. Aba hadügün biángubei hagía aban daradu weyuméme ligía. <verse eid="GEN 21:27" /><verse number="28" style="v" sid="GEN 21:28" />Gama lumoun aba ladireirun Abüraámü sedü mudún hádangiñe lilügüniña, <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />aba lubeiti lariñagun Abimélekü lun:</para>
  <para style="p" vid="GEN 21:29">—Kame san badireiraña sedü mudún ha?<verse eid="GEN 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 21:30" />Aba lóunabuni Abüraámü:</para>
  <para style="p" vid="GEN 21:30">—Ánhaña beresibira sedü mudún ha, bánharuña luagu nadüga lan fusu le.<verse eid="GEN 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 21:31" />Ligía Bérüsewa<note caller="2" style="f"><char style="fr" closed="false">21.31 </char><char style="ft" closed="false">Bérüsewa lidan Ebüréu gayaraati mini lan fusu lánina áfiñuruni.</char></note> lubéi líribei fulasu ligía, ladüga ñein hadüga biángubei hagía aban fiñún.<verse eid="GEN 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 21:32" />Lárigiñe hadügüni daradu ñein Bérüsewa, aba lagiribudun Abimélekü luma Fikolu hageiroun Filistéana. <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />Aba lábunun Abüraámü aban tídibu wewe tamarísiku ñein Bérüsewa, aba lafurieidun lidan liri Bungiu ñein. <verse eid="GEN 21:33" /><verse number="34" style="v" sid="GEN 21:34" />Aba laganóun Abüraámü hageira Filistéana saragu dan.<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s1">Lóuchaguni Bungiu lafiñen Abüraámü</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />Átiri dan lárigiñe, aba lóuchaguni Bungiu lafiñen Abüraámü. Aba lagúarun lun lau liri, aba lóunabun Abüraámü:</para>
  <para style="p" vid="GEN 22:1">—Anahán ya.<verse eid="GEN 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 22:2" />Aba lariñagun Bungiu lun:</para>
  <para style="p" vid="GEN 22:2">—Barübei biráü Isaakü, le ábanrügübei, le hínsiñebei bun, beiba lau lóubawagun Moriá. Bachülürünme ñein, ábame bíchuguni kei adagaragüdüni gudawarügüti luagu aban wübü le lunbei narufuduni bun.<verse eid="GEN 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 22:3" />Larugan, binaafingiua aba lásaarun Abüraámü, aba laranseruni lilügün burigü, chaünlei watu lun adagaragüdüni, aba lidin lau sun Isaakü le liráü lidoun fulasu le uágubei lariñaga Bungiu lun hama biama hádangiñe lumusuniña. <verse eid="GEN 22:3" /><verse number="4" style="v" sid="GEN 22:4" />Ǘrüwa weyu lárigiñe, ligía larihini Abüraámü fulasu ligía dísegiñe. <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />Ábati lariñagun houn lumusuniña:</para>
  <para style="p" vid="GEN 22:5">—Redei humá ya lau burigü. Au luma irahü le, wawansera wabaruaguóun, ábame wafurieidún, ábame wagiribudun.<verse eid="GEN 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 22:6" />Aba lanügüni Abüraámü lílemena adagaragüdüni, aba líchuguni légewagu Isaakü, aba lanügünu gusiñu luma watu gemeti, aba houdin úara. <verse eid="GEN 22:6" /><verse number="7" style="v" sid="GEN 22:7" />Málüti lúmagiñe aba lariñagun Isaakü lun Abüraámü:</para>
  <para style="p" vid="GEN 22:7">—Núguchi!</para>
  <para style="p" vid="GEN 22:7">—Ka babusenrubei niráü? —liña lóunabuni Abüraámü.</para>
  <para style="p" vid="GEN 22:7">Lariñaga Isaakü:</para>
  <para style="p" vid="GEN 22:7">—Anihán ílemei wama luma watu gemeti, gama lumoun hagéi san mudún lun adagaragüdüni?<verse eid="GEN 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 22:8" />Aba lóunabun Abüraámü:</para>
  <para style="p" vid="GEN 22:8">—Líchugubei Bungiu mudún lun adagaragüdüni, niráü.</para>
  <para style="p" vid="GEN 22:8">Aba hasigirun éibugeina úara. <verse eid="GEN 22:8" /><verse number="9" style="v" sid="GEN 22:9" />Dan le hachülürünbei lidoun fulasu le uágubei lariñaga Bungiu lun Abüraámü, aba ladügün Abüraámü aban latarü aba línchaguni watu; lárigiñe aba lagüraguni Isaakü le liráü, aba líchuguni luagu latarü ligibuagu watu; <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />gama lumoun dan le lanügünu gusiñu lun límiraguni liráü, <verse eid="GEN 22:10" /><verse number="11" style="v" sid="GEN 22:11" />aba lagúarun lani Bungiu ánheli lun Abüraámü siélugiñe:</para>
  <para style="p" vid="GEN 22:11">—Abüraámü! Abüraámü!</para>
  <para style="p" vid="GEN 22:11">Aba lóunabun Abüraámü:</para>
  <para style="p" vid="GEN 22:11">—Anahán ya, Nabureme.<verse eid="GEN 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 22:12" />Lariñaga lani Bungiu ánheli lun:</para>
  <para style="p" vid="GEN 22:12">—Madügabá damichi lun irahü le, ladüga subudi naali luagu inebe lan Bungiu bun, ladüga mamahantibu lau biráü le ábanrügüti nun.<verse eid="GEN 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 22:13" />Ábati larihin Abüraámü aban gábara dahigu luéigiñe liganchun lidan búbugati, aba lidin, aba lárügüdüni gábara ligía, aba líchuguni kei adagaragüdüni gudawarügüti leweñegua liráü. <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />Lárigiñe aba líchugun Abüraámü liri fulasu ligía: «Ru lumuti Bungiu le emegeirubei». Ligía ariñawagúagili lubéi: «Luagu aban wübü, ru lumuti Bungiu le emegeirubei».<verse eid="GEN 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 22:15" />Aba lagúarun lani Bungiu ánheli lun Abüraámü siélugiñe luagu libiaman wéiyaasu, <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />lariñaga lun:</para>
  <para style="p" vid="GEN 22:16">—Lariñahare Bungiu: «Ladüga badügüni katei le, mamahantibu lau biráü le ábanrügüti nun, fiñutina nuagu guánarügü luagu nabinirubadibu lan saragu. <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />Nadügüba lun gibe hamá badügawagun kei waruguma ha siélubaña, kei giñe lagu sagoun le lárubei beya. Hagañeirubaña giñe háganiñu súnwandan, <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />habinirúba giñe sun néchani ha ubouagubaña hádangiñe ladüga adüga baali le nubeibei».<verse eid="GEN 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 22:19" />Aba lagiribudun Abüraámü lidoun fulasu le buga ñein lubéi lígiraña lumusuniña. Lárigiñe aba houdin súngubei úara uburugun Bérüsewa, le ñein lubéi leredera Abüraámü aganawa.<verse eid="GEN 22:19" /></para>
  <para style="s1">Lirahüñü Naoru</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />Átiri dan lárigiñe, aba laganbun Abüraámü luagu garahüñüharu lan giñe Milüká lau Naoru le lamulen. <verse eid="GEN 22:20" /><verse number="21" style="v" sid="GEN 22:21" />Furumiñeti haráü Usu, lárigiñe Busu luma Kemueli le lúguchibei Aramü. <verse eid="GEN 22:21" /><verse number="22" style="v" sid="GEN 22:22" />Lárigiñe aba hagaraüdǘniwa Késedi, Asó, Pilüdási, Idiláfü luma Betueli. <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />Betueli ligía, ligía túguchibei Rebeka. Añahán widü irahüñü ha tirahüñübaña Milüká lau Naoru le lamulen Abüraámü. <verse eid="GEN 22:23" /><verse number="24" style="v" sid="GEN 22:24" />Garahüñüti giñe buga Naoru tau Reumá to tibiaman lúmari. Irahüñü hagía: Teba, Gaamü, Taasi luma Maaká.<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s1">Tounwen Sara luma tabunún</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />San-wein-sedü irumu tabagaridun Sara, <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />aba tounwen lidan aban fulasu gíriti Kiriatü-arüwá lememe uburugu Ebürón le Kananbei, aba layahun Abüraámü luagu tounwen Sara, aba lamuiserun tárigi. <verse eid="GEN 23:2" /><verse number="3" style="v" sid="GEN 23:3" />Lárigiñe aba láfuridun le ñéingiñe lubéi túgubu Sara, aba lidin ariñaga houn Étüna ha lídanbaña fulasu ligía:<verse eid="GEN 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 23:4" />—Lau sun terenchana nan haganagua, alugura humá aban umuahaü nun lun nábununu númari.<verse eid="GEN 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 23:5" />Aba hóunabuni Étüna:<verse eid="GEN 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 23:6" />—Adügabá fulesei woun, aganbabáwa! Aban wügüri le lanúadirun Bungiu buguya waganagua. Bunaboun búmari lidan lubuidun-agei wamúaha, úabei ni aban wádangiñe amaharuti lau umúahaü bun lun lira.<verse eid="GEN 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 23:7" />Ábati lararamun Abüraámü, aba labuluchagun hagibugiñe Étüna arufuda inebesei, <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />aba lariñagun houn:</para>
  <para style="p" vid="GEN 23:8">—Anhein hinarün lubéi luagu busén humá lun nábununu númari ya, fulesei humá nun amuriaha humá luma Efürón le liráü Sóarü lun <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />laluguruni lagadábugiñe dübü le Maküpelá nun, le lárurugubei lumúan. Nafayeirubei lebegi lagadábugiñe dübü ligía lun, ítara luba labureme nan aban umúahaü lidan fulasu le.<verse eid="GEN 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 23:10" />Keiti ñeinñein lan Efürón le Étüna haganagua, aba lóunabuni Efürón Abüraámü lun giñe gayara lan haganbuni lupaisanungu hama sun ha ásügürübaña yarafa lun lubenari uburugu:<verse eid="GEN 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 23:11" />—Uá, nabureme! Edeweharügü nubéi fulasu bun lau lagadábugiñe dübü le ñeinbei. Gefentiña lílana nageira luagu nedewehani bun. Bunaboun búmari.<verse eid="GEN 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 23:12" />Gama lumoun ábaya labuluchagun Abüraámü houn lílana fulasu ligía <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />ábati lóunabuni Abüraámü Efürón hagibugiñe súngubei:</para>
  <para style="p" vid="GEN 23:13">—Fuleseibana aganbabána, amuriahatina buma lun bárügüdüni seinsu luagu múa lárigiñeme gayaraahalime nábununu númari ñein.<verse eid="GEN 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 23:14" />Aba lóunabuni Efürón:<verse eid="GEN 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 23:15" />—Aganbabána nabureme. Gádürü-san murusun pülata lebegibei fulasu. Luagu ebegi le masigenehanbadiwa! Bunaboun búmari.<verse eid="GEN 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 23:16" />Aba lubeiti lánharun Abüraámü lafayeiruni seinsu le lariñagubei Efürón hagibugiñe Étüna, aba lafayeiruni lau pülata. <verse eid="GEN 23:16" /><verse number="17" style="v" sid="GEN 23:17" />Ítara liña lubeiti buga liabin lufulasun Efürón le Maküpelábei lau sun lagadábugiñe dübü luma sun tídibu wewe le lídanbei, lun lánibei lan Abüraámü. Fulasu ligía luéigiñeñein oubaü le ñéingiñe lubéi laboucha weyu libiti Mamüré. <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />Gefentiña Étüna luagu, hama sun ha ásügürübaña lubadugiñe lubenari fulasu.<verse eid="GEN 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 23:19" />Lárigiñe aba lábununu Abüraámü Sara to lúmari lidan lagadábugiñe dübü le lídanbei fulasu Maküpelá, luéigiñe oubaü le ñéingiñe lubéi laboucha weyu libiti Mamüré, fulasu le giñe subudiwabei lau iri le Ebürón, le giñe lídanbei lumúan Kanán. <verse eid="GEN 23:19" /><verse number="20" style="v" sid="GEN 23:20" />Ítara liña lerederun Abüraámü laburememe fulasu luma lagadábugiñe dübü le ñeinbei, le halugurubei Étüna lun, lun umúahaü.<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s1">Láluahan Abüraámü lúmari Isaakü</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />Wéiyaali bugaha Abüraámü saragu, ani biní laali Bungiu lidan sun katei. <verse eid="GEN 24:1" /><verse number="2" style="v" sid="GEN 24:2" />Luagu aban weyu, aba lagúarun lun lumusun le wéiyatimahalibei hádangiñe súngubei, le arihubei lau sun lúmati Abüraámü, aba lariñagun lun:</para>
  <para style="p" vid="GEN 24:2">—Rubei búhabu lábugiñe niyada, <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />fiñuba luagu liri Bungiu le Labureme sielu luma múa, luagu mígirunbadibu lan lun lamarieidun niráü Isaakü tuma aban würi to yaana Kanán le ñein lubéi naganawa, <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />bídiba lan nageira lun banúadahan lúmari hadan niduheñu.<verse eid="GEN 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 24:5" />Aba lóunabuni musu ligía:</para>
  <para style="p" vid="GEN 24:5">—Ánhounti maha würi tuguya tiabin numa, kábagia nadüga? Mosu lubeiti nanügüni biráü lidoun fulasu le ñéingiñe lubéi báfurida!<verse eid="GEN 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 24:6" />Lariñaga Abüraámü lun:</para>
  <para style="p" vid="GEN 24:6">—Uá, manügabéi niráü ñeinhin! <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />Babureme le Lubungiute sielu, ligía asagarubalina lúbiñegiñe núguchi luma hageiragiñe niduheñu, aba lariñagun nun luagu líchugubei lan múa le houn nadügawagun, lóunahabei lani ánheli bubá bubá lun banügün aban würi yétegiñe lun lúmarime niráü. <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />Anhoun maha würi tuguya tiabin buma, madurunbadibu, gama lumoun manügabéi niráü yágütoun!<verse eid="GEN 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 24:9" />Ábati líchuguni musu ligía lúhabu lábugiñe liyada Abüraámü, aba láfiñurun lun luagu ladügübei lan le lamuriahabei luma. <verse eid="GEN 24:9" /><verse number="10" style="v" sid="GEN 24:10" />Lárigiñe aba lanúadahan idewesei lídangiñe burí le buídutimabei luma labureme, aba lanügün diisi kameyu aba lidin uburugun le meha ñein lubéi laganawa Naoru lidan Mesopotamia. <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />Dan le lachülürünbei yarafa lun uburugu ligía lagumeseruña aburigada. Ligía oura ligía houdin würiña adabura duna. Aba lemeraaguagüdüniña musu kameyu laru aban fusu, <verse eid="GEN 24:11" /><verse number="12" style="v" sid="GEN 24:12" />aba lagumeserun afurieida:</para>
  <para style="p" vid="GEN 24:12">—Aburemei, Lubungiute niyubudiri Abüraámü, adügabá lun buidu lan lidin nun uguñe, arufudabéi bareini lun niyubudiri Abüraámü. <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />Neredera ya laru fusu, lubá hayabin würiña irahüñü ha lílana fulasu le adabura duna. <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />Adügabá lun to lanme irahü to untu nariñaga: «Adügabá fulesei nun, rarigüdabéi bidinan lun natun duna» lun tóunabunina: «Guraba, níchiga giñe duna houn bilügüniña kameyu», lun tuguya lan to banúadiruboun lun Isaakü. Ítara luba nachoururuni bareini lun niyubudiri.<verse eid="GEN 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15" />Másugili lafurieidun, ligía larihin tiabin Rebeka to liráü Betueli lau tidinan tégewagu. Betueli, tiráü bugaha Milüká lau Naoru le lamulen Abüraámü. <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />Magadiñetu buga Rebeka ani mámarigiru; magamaridun lágiru ni aban wügüri. Aba taragachun lidoun fusu, aba tárürüni tidinan, tagiribuda yebe <verse eid="GEN 24:16" /><verse number="17" style="v" sid="GEN 24:17" />ligía léibaagun musu ligía tárigi, lariñaga tun:</para>
  <para style="p" vid="GEN 24:17">—Adügabá fulesei nun. Ruba murusun duna nun lídangiñe bidinan lun natun.<verse eid="GEN 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 24:18" />Aba tóunabun:</para>
  <para style="p" vid="GEN 24:18">—Guraba.</para>
  <para style="p" vid="GEN 24:18">Aba tarariragüdüni tidinan, aba tágüdahani túhaburugu, aba tíchugun duna lun lun latun. <verse eid="GEN 24:18" /><verse number="19" style="v" sid="GEN 24:19" />Dan le lásurun latun, aba tariñagun lun:</para>
  <para style="p" vid="GEN 24:19">—Nadabura giñe duna houn bilügüniña kameyu lun hátuni sun le habusenrun.<verse eid="GEN 24:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 24:20" />Furesegueina, aba téseruni lila tidinan lidoun hátagüle animaalu aba téibaagun saragu wéiyaasu adabura, darí lun hatun sun kameyu. <verse eid="GEN 24:20" /><verse number="21" style="v" sid="GEN 24:21" />Anihánti buga musu le aríaguoun mariñagunga ni kata, ladüga busenti lachoururuni luagu adügaali lan Bungiu lun buidu lan lidin lun lidan luéiyasun.<verse eid="GEN 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 24:22" />Dan le lásurun hatun kameyu, aba lanügün wügüri ligía aban bagü golu le hǘrüti kei burí sisi güramu, aba líchuguni luagu tígiri. Ru ligía bián bángüli le golu tun le hǘrüti, <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />lariñaga tun:</para>
  <para style="p" vid="GEN 24:23">—Ariñagabéi nun ka lan iráü buguya, anhein giñe anihein lubéi ubaraü lúbiñe búguchi le ñein lumuti gayara lan násügürüni áriebu hama nánigu.<verse eid="GEN 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 24:24" />Aba tóunabun:</para>
  <para style="p" vid="GEN 24:24">—Liráü Betueli nuguya, le tiráü Milüká lau Naoru. <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />Ígiraguati ubaraü wábiñe lun básügürüni áriebu, anihein giñe sagadi luma éigini houn bilügüniña kameyu.<verse eid="GEN 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 24:26" />Ábati láhuduragun musu, aba leteingiruni Bungiu, <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />ariñaga ligía ítara:</para>
  <para style="p" vid="GEN 24:27">—Biniwati Wabureme, le Lubungiute niyubudiri Abüraámü! Ladüga úarati ani areida ligía lun niyubudiri, ani adundeha láadina luagu üma lun hábiñoun liduheñu niyubudiri!<verse eid="GEN 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28" />Aba tidin Rebeka éibaagueina túbiñoun túguchu, abahüdaguei sun le asuseredubei tun. <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />Ñeinñein aban tati gíriti Lawán, aba lidin éibaagueina lubadun fusu áluahei wügüri ligía, <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />ladüga ariha lumuti bagü luma bángüli le luagu tarüna litu, aganbaléi giñe tabahüdaguni le lariñagubei wügüri ligía tun. Aba liabin Lawán luagun lumusun Abüraámü ligía kei anihagua lan buga hau lilügüniña kameyu laru fusu, <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />lariñaga lun:</para>
  <para style="p" vid="GEN 24:31">—Higabu, wügüri biní lumuti Bungiu. Ka uagu beredera bóugudi? Aranse naaru muna luma aban ubaraü houn bilügüniña kameyu.<verse eid="GEN 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 24:32" />Ábati lidin wügüri ligía múnadoun. Aba larariragüdüni Lawán hanügün kameyu, aba líchugun éigini houn, lárigiñe, aba lanügün duna lun wügüri ligía hau sun ha úarabaña luma lun hachibuni hagudi. <verse eid="GEN 24:32" /><verse number="33" style="v" sid="GEN 24:33" />Dan le heseriwidun éigini houn, aba lariñagun, lumusun Abüraámü:</para>
  <para style="p" vid="GEN 24:33">—Méiginbadina darime ariñaga naali le lunbei nariñaguni.</para>
  <para style="p" vid="GEN 24:33">Lariñaga Lawán lun:</para>
  <para style="p" vid="GEN 24:33">—Badimureha.<verse eid="GEN 24:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 24:34" />Aba lariñagun:</para>
  <para style="p" vid="GEN 24:34">—Lumusun Abüraámü au. <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />Biní laali Bungiu niyubudiri saragu ani rísigüda laali giñe. Rúhali burí bágasu lun, pülata, golu, musu, kameyu hama burigü. <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />Garaüharu giñe Sara to lúmari aban wügüri irahü lau sun wéiyaaru lan, ígira láaliti niyubudiri sun lúmati lun liráü ligía. <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />Aba láfiñuragüdünina niyubudiri, lariñaga nun: “Mígirunbadibu lun lamarieidun niráü tuma aban würi yaana Kanán le ñein lubéi naganóua. <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />Lubaragiñe lira beiba hadoun liduheñu núguchi, báluahame lúmari hadan niduheñu”. <verse eid="GEN 24:38" /><verse number="39" style="v" sid="GEN 24:39" />Aba nariñagun lun: “Nabureme, ánhounmeti maha würi tuguya tiabin numa?” <verse eid="GEN 24:39" /><verse number="40" style="v" sid="GEN 24:40" />Aba lóunabunina: “Éibugaadina lidan lémeri Bungiu, lóunahabei lóunagüle buma, lun buidu lan buéiyasun. Banügüba aban würi lun niráü lun lúmarime hádangiñe niduheñu ha liduheñu núguchi. <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />Ánhabugubeirügü ñüdün hábiñe niduheñu, hamaharame híchugunu irahü bun, ligíarügüba madurun ban luagu áfiñuruni le badügübei”.<verse eid="GEN 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 24:42" />—Ítara liña lubeiti nachülürün uguñe laru fusu, aba nafurieidun lun Lubungiute niyubudiri Abüraámü, nariñaga: “Anhein inarüni lubéi luagu badügüba lan lun buidu lan nuéiyasun, <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />ayumuraguatina bun lun to lan irahü to ñǘbuintu adabura duna, to untu nariñaga: Adügabá fulesei nun, ruba murusun duna nun lídangiñe bidinan lun natun, <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />tariñagameti nun: Guraba, nadabura giñe lun hatun bilügüniña kameyu, lun tuguya lan würi to banúadiruboun lun lúmarime liráü niyubudiri”. <verse eid="GEN 24:44" /><verse number="45" style="v" sid="GEN 24:45" />Másugili yebe, nafurieidun, ligía narihin tiabin Rebeka tau aban dina tégewagu. Aba taragachun lidoun fusu adabura duna, aba nariñagun tun: “Adügabá fulesei nun, ruba murusun duna nun». <verse eid="GEN 24:45" /><verse number="46" style="v" sid="GEN 24:46" />Aba tarariragüdünu tidinan, aba tariñagun nun: «Guraba, nadabura giñe haniñe bilügüniña kameyu”. Aba tíchugun duna nun luma houn nilügüniña kameyu. <verse eid="GEN 24:46" /><verse number="47" style="v" sid="GEN 24:47" />Lárigiñe aba nálügüdünu. Ka iráü buguya? Aba tóunabunina: “Liráü Betueli nuguya, le liráü Naoru tau Milüká”. Ábati níchugun aban bagü luagu tígiri luma bián bángüli luagu tarüna; <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />aba náhuduragun eteingirei Bungiu, le Lubungiute niyubudiri Abüraámü luagu ladundehanina luéigiñe üma le úaraguabei, lun nanügünu liráü lamulen niyubudiri lun liráü. <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />Guentoti, ariñaga huméi nun anhein furangubadün lubéi luma niyubudiri, ánheinti madügün hubéi lubéi ítara, ariñaga huméi giñe nun, subudi náamugei kaba lan nadüga.<verse eid="GEN 24:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 24:50" />Ábati hóunabuni Lawán luma Betueli:</para>
  <para style="p" vid="GEN 24:50">—Lúmagiñe Bungiu liabin sun le, siñati lubeiti wariñagun bun ni anha, ni uá. <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />Anuhán Rebeka; barüboun, beiba tau lúmari táamuga liráü biyubudiri, keisi laranseruni Bungiu.<verse eid="GEN 24:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="GEN 24:52" />Dan le laganbunbalin lumusun Abüraámü dimurei le, aba láhuduragun ligibugiñe Bungiu darí ladagarun lerebe múarugu. <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />Aba lasagarun saragu katei le lauti pülata luma golu, tuma daüguaü, aba líchuguni tun Rebeka. Edewehati giñe lun tati luma tun túguchu. <verse eid="GEN 24:53" /><verse number="54" style="v" sid="GEN 24:54" />Lárigiñe aba leigin hau sun lupaanágu, gurá hagía, aba hásügürüni áriebu ñein. Larugan dan le hásaarun, aba lariñagun lubúein Abüraámü houn:</para>
  <para style="p" vid="GEN 24:54">—Ígira humana lun nagiribudun lúbiñoun niyubudiri.<verse eid="GEN 24:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 24:55" />Aba tariñagun túguchu Rebeka luma tati lun:</para>
  <para style="p" vid="GEN 24:55">—Rédeita Rebeka díisiraüya weyu wama, lárigiñeme, gayaraahalime tidin buma.<verse eid="GEN 24:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 24:56" />Lariñaga musu houn:</para>
  <para style="p" vid="GEN 24:56">—Hebé heredehanina. Adügaali Bungiu lun buidu lan nuéiyasun, ígira humana lubeiti lun nagiribudun<optbreak /> lúbiñoun niyubudiri.<verse eid="GEN 24:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 24:57" />Aba hóunabun:</para>
  <para style="p" vid="GEN 24:57">—Waguara tun Rebeka,<optbreak /> kaba lan tariñaga.<verse eid="GEN 24:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="GEN 24:58" />Aba hagúarun tun aba hálügüdünu:</para>
  <para style="p" vid="GEN 24:58">—Busentibu bidin luma gürigia le?</para>
  <para style="p" vid="GEN 24:58">Aba tóunabuniña:</para>
  <para style="p" vid="GEN 24:58">—Anha.<verse eid="GEN 24:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="GEN 24:59" />Ábati hígirun lun tidin Rebeka, tuma giñe würi to óunigirubarun súnwandan, luma lumusun Abüraámü hau sun ha úarabaña luma. <verse eid="GEN 24:59" /><verse number="60" style="v" sid="GEN 24:60" />Aba habinirunu Rebeka ítara:</para>
  <para style="b" vid="GEN 24:60" />
  <para style="q" vid="GEN 24:60">«Wamulelua, háguchuba<optbreak /> saragu míñunu!</para>
  <para style="q" vid="GEN 24:60">Gañei haméi badügawagun haburugute háganiñu!»<verse eid="GEN 24:60" /></para>
  <para style="b" />
  <para style="p">
    <verse number="61" style="v" sid="GEN 24:61" />Ábati tawarirun Rebeka hau tumusuniña hawagun kameyu, aba hafalaruni lumusun Abüraámü. Ítara liña lanügünu musu ligía Rebeka aba lidin ñéingiñe.<verse eid="GEN 24:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="GEN 24:62" />Lagiribuduña Isaakü luéigiñe fusu le gíribei «Wínwanti le aríagubei nun», kei lóubawagu lubéi Négebü laganawa. <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />Furihaliti buga ebeluha úara luma laguñeedun. Sódini larihin ayarafadeina hamá átiri kameyu. <verse eid="GEN 24:63" /><verse number="64" style="v" sid="GEN 24:64" />Aba giñe tarihini Rebeka, dan le tarihinbalin Isaakü, aba tararirun luéigiñe kameyu. <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />Aba tálügüdüni musu:</para>
  <para style="p" vid="GEN 24:65">—Katei san eyeri lite le ñǘbuinbei wawagun?</para>
  <para style="p" vid="GEN 24:65">Aba lóunabunu:</para>
  <para style="p" vid="GEN 24:65">—Niyubudiri.</para>
  <para style="p" vid="GEN 24:65">Ábati tanügünu tubelun, aba tadouragun lau tigibu.<verse eid="GEN 24:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="GEN 24:66" />Aba labahüdaguni musu sun le ladügübei lun Isaakü. <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />Aba lanügünu Isaakü Rebeka tidoun tikianpun Sara to lúguchu, aba lamarieidun tuma. Aba tínsiñedun Rebeka lun Isaakü saragu, ítara liña lárügüdagun lungua lárigi tounwen lúguchu.<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s1">Ladügawagun Abüraámü tuma Keturá</para>
  <para style="r">(<ref loc="1CH 1:32-33">1 Kro 1.32-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />Ábaya lagamaridun Abüraámü aban würi gíritu Keturá. <verse eid="GEN 25:1" /><verse number="2" style="v" sid="GEN 25:2" />Añahán lirahüñübaña tau: Simürámü, Hokusán, Medán, Madián, Isübákü luma Sua. <verse eid="GEN 25:2" /><verse number="3" style="v" sid="GEN 25:3" />Hokusán ligía meha lúguchibei Seba luma Dedán. Asuruna, Leluséuna hama Leumeuna, hagía ladügawagunbaña Dedán. <verse eid="GEN 25:3" /><verse number="4" style="v" sid="GEN 25:4" />Lirahüñü meha Madián, Efá, Éferü, Anoku, Abidá luma Elidá. Sun ha tadügawagun Keturá.<verse eid="GEN 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 25:5" />Rédeiti sun lúmati Abüraámü lalaganteme Isaakü. <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />Ha harahüñü híbiri lúmarigu rúrügüti idewesei houn, dan meha wínwangili aba lóunahaniña dise luéi Isaakü lóubawagun fulasu le ñéingiñe lubéi laboucha weyu.<verse eid="GEN 25:6" /></para>
  <para style="s1">Lounwen Abüraámü luma labunún</para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7" />San-ǘrüwa-wein-keinsi irumu labagaridun Abüraámü. <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />Aba lounwen lídangiñe sandi dan le wéirihali lueiyan. Ítara liña lóundarun hama lagüchagu. <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />Aba lábununi Isaakü luma Ísümaeli ha lirahüñü lidan lagadábugiñe dübü le gíribei Maküpelá le luéigiñebei oubaü le ñéingiñe lubéi laboucha weyu libiti Mamüré, lidan lufulasun Efürón, le liráü Sóarü le Étüna. <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />Ligía fulasu le buga lagañeihabei Abüraámü hámagiñe Étüna. Ñein labunúa Abüraámü tóubagiñe Sara to lúmari. <verse eid="GEN 25:10" /><verse number="11" style="v" sid="GEN 25:11" />Lárigiñe lounwen Abüraámü, aba labiniruni Bungiu Isaakü, le buga erederubei aganawa lurugabu fusu le gíribei «Wínwanti le aríagubei nun».<verse eid="GEN 25:11" /></para>
  <para style="s1">Ladügawagun Ísümaeli</para>
  <para style="r">(<ref loc="1CH 1:28-31">1 Kro 1.28-31</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12" />Añahán ladügawagun Ísümaeli le liráü Abüraámü tau Agarü Ehiptuna to tidamun Sara, <verse eid="GEN 25:12" /><verse number="13" style="v" sid="GEN 25:13" />lúmagiñe furumiñeti lumoun agumuhóuni: Nebaiotu, furumiñeti; lárigiñe Kedarü, Adübéeli, Mibüsámü, <verse eid="GEN 25:13" /><verse number="14" style="v" sid="GEN 25:14" />Misümá, Dumá, Masá, <verse eid="GEN 25:14" /><verse number="15" style="v" sid="GEN 25:15" />Adarü, Temá, Heturu, Nafisi, Kedümá. <verse eid="GEN 25:15" /><verse number="16" style="v" sid="GEN 25:16" />Anihán híribei duusu lirahüñü Ísümaeli, laumeme giñe iri burí ligía lasubudirúa hageira tuma hakianpun-agei. Kada aban ligía guánarügü hábutibei lumutuniña. <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />San-darandi-sedü irumu lau Ísümaeli ligía lounwen, ítara liña lóundarun hamoun lagüchagu. <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />Aba haganóun ladügawagun lidan fulasu le labadinaguabei Awilá luma Suru, le ligibugiñebei Ehiptu dan le liabiniwa Asiriagiñe; ñein latokara houn lun haganóun, lau sun magundan hamá yebe híbirigu.<verse eid="GEN 25:18" /></para>
  <para style="s1">Lágurahoun Hakobu luma Esaú</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />Anihán asusereduti le luáguti Isaakü le liráü Abüraámü. <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />Bián-wein irumu lau Isaakü dan le lamarieidunbei tuma Rebeka to liráü Betueli, litu Lawán, Aramüna ha meha aganóubaña Padán-aramü. <verse eid="GEN 25:20" /><verse number="21" style="v" sid="GEN 25:21" />Keiti siñá lan tagaraüdün Rebeka aba layumuragun Isaakü tuagu lun Bungiu. Aba laganbuni Bungiu lafurieidun, aba tadageinadun Rebeka. <verse eid="GEN 25:21" /><verse number="22" style="v" sid="GEN 25:22" />Keiti hageindagun mádounu turageirugu, aba tasaminarun:</para>
  <para style="p" vid="GEN 25:22">«Anhein ítarameme luba lubéi katei le, kagia hu lan nabagaridun?» Ábati tálügüdahan luagu katei le luma Bungiu. <verse eid="GEN 25:22" /><verse number="23" style="v" sid="GEN 25:23" />Aba lóunabunu:</para>
  <para style="b" vid="GEN 25:23" />
  <para style="q" vid="GEN 25:23">«Añahein bián néchanigu burageirugu;</para>
  <para style="q" vid="GEN 25:23">bián ageiraü ageindagua hámagua lubaragiñe hágurahoun.</para>
  <para style="q" vid="GEN 25:23">Hérebei aban luéi le aban,</para>
  <para style="q" vid="GEN 25:23">le íbugañaü lábugiñebei lugumadin le<optbreak /> amuleñein».<verse eid="GEN 25:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="GEN 25:24" />Aba lachülürün dan lun tágurahan Rebeka, aba hayabin mádounu. <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />Le águrahoubei furumiñe, funati lídiburi, háyuti giñe lura, aba híchugun Esaú luagu. <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />Lárigiñe aba liabin lamulen ragüñu luagu lihilin lugudi Esaú lau aban lúhabu, ligía híchugunbei Hakobu luagu. Ǘrüwa wein irumu lau Isaakü dan le tágurahanbaliña Rebeka.<verse eid="GEN 25:26" /></para>
  <para style="s1">Laluguruni Esaú liricha keisi íbugañaü</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27" />Aba haweinamudun irahüñü ha. Áraabu lifisiutebei Esaú luma éibaahani, ánheinti Hakobu, aban wügüri darangiluti, hínsiñeti lun lun lerederun tidan kianpu. <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />Keiti hou lan Isaakü hádangiñe animaalugu ha léibaahabaña Esaú, hínsiñetimatiti lun, ánhounti Rebeka hínsiñetimati Hakobu tun.<verse eid="GEN 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 25:29" />Luagu aban weyu, lábouguña Hakobu, ligía liabin Esaú áraabugiñe buchá luagu <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />aba lariñagun lun:</para>
  <para style="p" vid="GEN 25:30">—Adügabá fulesei nun, ruba murusun lídangiñe gisóu funati le búmabei ñein nun, ladüga láfaraadina ilamaü. Ligía hariñagunbei lun Edomu.<verse eid="GEN 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 25:31" />Aba lóunabuni Hakobu:</para>
  <para style="p" vid="GEN 25:31">—Furumiñe ru yebebéi biricha nun keisi íbugañaü.<verse eid="GEN 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 25:32" />Aba lariñagun Esaú lun:</para>
  <para style="p" vid="GEN 25:32">—Kei le aubei barihinina, nóunweña nilama, kati hu lan liricha íbugañaü nun?<verse eid="GEN 25:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 25:33" />Lariñaga Hakobu lun:</para>
  <para style="p" vid="GEN 25:33">—Fiñuba.</para>
  <para style="p" vid="GEN 25:33">Aba láfiñurun Esaú, aba líchuguni liricha keisi íbugañaü lun Hakobu. <verse eid="GEN 25:33" /><verse number="34" style="v" sid="GEN 25:34" />Aba líchugun Hakobu fein luma lenteha gisóu lun Esaú. Lásurun leigin, gurá ligía, aba lásaarun aba lidin. Ítara liña líchugun mebereseni luagu liricha keisi íbugañaü.<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s1">Lidin Isaakü Gerarü</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />Lidan dan ligía, aba ladagarun aban óunwenbu likesin éigini lidan fulasu ligía, bóugudin luéi le meha adagarubei dan meha wínwangili Abüraámü. Ligía lébubei lidin Isaakü Gerarü, le buga ñein lubéi laganawa Abimélekü le harúeite Filistéana. <verse eid="GEN 26:1" /><verse number="2" style="v" sid="GEN 26:2" />Ñein lasaliragua Bungiu lun, lariñaga lun:</para>
  <para style="p" vid="GEN 26:2">—Mídinba Ehiptu. Rédeiba le ñein lumuti nariñagun bun, <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />guentó redei yebebá aganawa lidan ageiraü le, búmabadina, nabinirubadibu, ladüga níchugubei múa le bun habu sun badügawagun. Ítara luba nagunfulirun lau dimurei le nariñagubei lun Abüraámü le búguchi. <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />Nadügüba lun gibe hamá badügawagun kei waruguma ha siélubaña, ábame níchuguni sun múa le houn, habinirúba giñe sun néchani ha ubouagubaña hádangiñe badügawagun, <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />ladüga aganba lumutina meha Abüraámü, gúnfulilei le nubeibei, nugumadin, nilurudun luma narufudahan.<verse eid="GEN 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 26:6" />Ábati lerederun Isaakü Gerarü, <verse eid="GEN 26:6" /><verse number="7" style="v" sid="GEN 26:7" />danti le hálügüdüni lílana fulasu ligía tuagu lúmari, aba lariñagun houn luagu litu tan. Hanufudeti lariñagun luagu lúmari lan Rebeka, ladüga magadiñe tan, haritaguatiti luagu háfarubei lan lílana ageiraü ligía tuéigiñe.<verse eid="GEN 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 26:8" />Ábati lerederun ñein. Luagu aban weyu ñeinñein Abimélekü aríaaha luéigiñe funedera, ligía larihini Isaakü íchuaha tuma Rebeka to lúmari. <verse eid="GEN 26:8" /><verse number="9" style="v" sid="GEN 26:9" />Ábati lóunahan luagu, lariñaga lun:</para>
  <para style="p" vid="GEN 26:9">—Ma búmari würi to, adian? Kati uagu bariñaga nun luagu bitu lan?</para>
  <para style="p" vid="GEN 26:9">Lariñaga Isaakü lun:</para>
  <para style="p" vid="GEN 26:9">—Ladüga naritagun luagu gayara lan háfarunina tuéigiñe.<verse eid="GEN 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 26:10" />Lariñaga Abimélekü lun:</para>
  <para style="p" vid="GEN 26:10">—Kame badügei katei le woun? Ítagaraü yebe badügün lun larounrun aban lílana fulasu tuma búmari; aba hamuga bafigoungüdüniwa.<verse eid="GEN 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 26:11" />Ábati lariñagun Abimélekü houn sun lílana fulasu: «Le añawarihati lun wügüri le odi tun lan lúmari, lasiadirúba lun lounwen».<verse eid="GEN 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12" />Lidan irumu ligía aba lábunagun Isaakü lidan ageiraü ligía. Ma lubuidun lalubahan, lárigiñe aba labiniruni Bungiu. <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />Aba larisidun, aba lagibedun lúmati. <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />Saragu haña lilügüniña mudún, bágasu, musu, darí lun hagimugadun Filistéana lun. <verse eid="GEN 26:14" /><verse number="15" style="v" sid="GEN 26:15" />Ligía hadouhanbalin sun fusu le burí hachíahabei lumusuniña Abüraámü, le lúguchi Isaakü, dan meha le wínwangili Abüraámü. <verse eid="GEN 26:15" /><verse number="16" style="v" sid="GEN 26:16" />Darí lun lachülürün dan, lun lariñagun Abimélekü lun Isaakü:</para>
  <para style="p" vid="GEN 26:16">—Beiba yáagiñe, ladüga rísihadibu sügǘ wau.<verse eid="GEN 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 26:17" />Aba lidin Isaakü, aba ladügün likianpun lidan fulasu wayati le gíribei Gerarü, aba lerederun aganawa ñein. <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />Ábaya lachigini burí fusu le meha achigíbei dan meha le wínwangili lúguchi, le burí meha hadourubei Filistéana lárigiñe lounwen, aba líchuguni írimeme burí le meha líchugubei lúguchi luagu.<verse eid="GEN 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 26:19" />Luagu aban weyu hachigiña lumusun Isaakü aban fusu lidan fulasu wayati, aba hadarirun aban lísensen duna. <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />Gama lumoun ábaha hageindagun hóuniri mudún ha Gerarüna hama hóuniri lilügüniña Isaakü, ladüga hariñagun luagu hadunari lan duna ligía. Ligía líchugunbei Isaakü luagu fusu ligía «Wuribu» ladüga hawuribuhan luma.<verse eid="GEN 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 26:21" />Lárigiñe ábaya hachigin lumusuniña Isaakü ábanya fusu, ábaya hageindagun luéigiñe, aba líchugun Isaakü liri fusu ligía «Gáganiguaü».<verse eid="GEN 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 26:22" />Aba lidin Isaakü dise ñéingiñe, ábaya lachigin aban fusu. Keiti mageindagunhaña lubéi luéigiñe, aba líchugun luagu «Esefuruni», lariñaga:</para>
  <para style="p" vid="GEN 26:22">—Ígira láadiwa Bungiu lun gayara lan wawanserun lidan fulasu le.<verse eid="GEN 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 26:23" />Ñéingiñe aba lidin Isaakü Bérüsewoun. <verse eid="GEN 26:23" /><verse number="24" style="v" sid="GEN 26:24" />Aba lasaliragun Bungiu lun áriebu ligía, lariñaga lun:</para>
  <para style="b" vid="GEN 26:24" />
  <para style="q" vid="GEN 26:24">«Au le, Lubungiute Abüraámü<optbreak /> le búguchi.</para>
  <para style="q" vid="GEN 26:24">Manufudedabá, anahein buma.</para>
  <para style="q" vid="GEN 26:24">Nabinirubadibu luéigiñe<optbreak /> lóubadina Abüraámü,</para>
  <para style="q" vid="GEN 26:24">gánwoungüdanañame badügawagun saragu».<verse eid="GEN 26:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="GEN 26:25" />Ábati ladügün Isaakü aban latarü ñein lun lafurieidun lun Bungiu, aba lerederagun lidan fulasu ligía, aba hachigin lumusun aban fusu.<verse eid="GEN 26:25" /></para>
  <para style="s1">Ladügün Isaakü aban daradu luma Abimélekü</para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />Luagu aban weyu aba liabin Abimélekü Gerarügiñe lun ladimurehan luma Isaakü. Ñǘbuinti Ausatü le lumada luma, labu Fikolu le hábuti lisudaran. <verse eid="GEN 26:26" /><verse number="27" style="v" sid="GEN 26:27" />Lariñaga Isaakü houn:</para>
  <para style="p" vid="GEN 26:27">—Anhein mínsiñen nubéi hun, darí lun habugunina hageiragiñe, ka uagu hiabin arihana?<verse eid="GEN 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 26:28" />Aba hóunabuni:</para>
  <para style="p" vid="GEN 26:28">—Ariha wamaali luagu anihein lan Bungiu buma, saminaadiwati wadügün aban daradu buma. Anihán daradu le lunbei wadügüni buma, <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />lun madügün ban ni murusun wuribati woun, ladüga mañawarihangidiwa bun. Lubaragiñe lira, adügarügütiwa buiti bun, aba wóunahanibu lau lubuidun, guentoti labiniruñadibu Bungiu.<verse eid="GEN 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 26:30" />Ábati ladügün Isaakü aban óunwenbu fedu houn, aba heigin, gurá hagía. <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />Larugan binaafin aba hásaarun, aba háfiñurun hámagua. Lárigiñe aba layouragun Isaakü houn, aba houdin keisi umadagu.<verse eid="GEN 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 26:32" />Weyuméme ligía aba hayabin lumusuniña Isaakü ariñaga lun luagu hadarirun duna lidan fusu le hachigibei. <verse eid="GEN 26:32" /><verse number="33" style="v" sid="GEN 26:33" />Aba líchugun Isaakü liri fusu ligía Sewa ligía Bérüsewamemegili lubéi liri uburugu ligía.<verse eid="GEN 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />Dan le bián wéinhali irumu lau Esaú aba lamarieidun tuma Hudidi to liráü Beerí le Étüna. Maríei ligía giñe tuma Basemátü liráü giñe aban Étüna gíriti Elón. <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />Rútiña bián würiña ha ligifi ibagari lun Isaakü tuma Rebeka.<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s1">Labiniruniña Isaakü Hakobu luma Esaú</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />Wéiyayaali buga Isaakü, marihinhali giñe. Luagu aban weyu aba lagúarun lun Esaú le íbugañaü hadan lirahüñü, lariñaga lun:</para>
  <para style="p" vid="GEN 27:1">—Niráü!</para>
  <para style="p" vid="GEN 27:1">Lariñaga Esaú lun:</para>
  <para style="p" vid="GEN 27:1">—An núguchi.<verse eid="GEN 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 27:2" />Lariñaga Isaakü lun:</para>
  <para style="p" vid="GEN 27:2">—Aríagubiña lubeigia luagu wéiyaadina lan ani gayaraati nounwen furumiñeguarügü lídangiñe weyu le. <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />Ligía nabusenrubei lun bidin áraabu éibaaha áfara báamuga aban animaalu. <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />Ábame badügün aban éigini semeeti kei línsiñe nun, banügeime nun lun néigini. Ábameti nabinirunibu lubaragiñe nounwen.<verse eid="GEN 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 27:5" />Aganbagutiñati Rebeka lun le lariñagubei Isaakü lun Esaú. Dan lubeiti lídinbei áraabu éibaaha, <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />aba tariñagun lun Hakobu le tadarahóun:</para>
  <para style="p" vid="GEN 27:6">—Aganba numuti ladimurehan búguchi lun Esaú, lariñahare lun: <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />“Agaliruhabá aban animaalu, badügame aban gisóu semeeti lun neigin, ábame nabinirunibu ligibugiñe Bungiu lubaragiñe nounwen”. <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />Ítara liña lubeiti niráü, aganbabéi le lunbei nariñaguni bun: <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />Beiba le ñein habéi wabiñanigu, banügame bián hádangiñe habuidun-agei gábara ha ñéinbaña nun; naransera aban gisóu lun búguchi kei línsiñe lun. <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />Banügeime lun lun léigini, biní láamugabu lubaragiñe lounwen.<verse eid="GEN 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 27:11" />Lariñaga Hakobu tun lúguchu:</para>
  <para style="p" vid="GEN 27:11">—Háyuti lura níbugaña, anhein au máyuti nura. <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />Ánheindügü aguura núguchi nuagu, lasubudiráname, laritaguba luagu nadügüña lan bula lau; ábameti líñaragunina lubaragiñe labinirunina.<verse eid="GEN 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 27:13" />Aba tóunabuni lúguchu:</para>
  <para style="p" vid="GEN 27:13">—Niráü lábürühame íñarawaguni ligía nuagun. Beiba, adügabéi le nubeibei bun; barübaña gábara hagía nun.<verse eid="GEN 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 27:14" />Aba lidin Hakobu aba lanügüniña gábara tun lúguchu. Ábati tadügün aban gisóu semeeti kei línsiñe lun Isaakü, <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />aba tasagarunu tubuidun-agei ladaüragun Esaú to areidúañuboun múnada, aba tadaürünu luagu Hakobu le tadarahóun. <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />Aba tóuburuni larüna Hakobu luma ligiina le ñein lubéi ua lan ídiburi lau hayu gábara, <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />aba tíchuguni gisóu lun tuma fein to tadügüboun.<verse eid="GEN 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 27:18" />Ábati lebelurun Hakobu le ñeinhin lubéi lúguchi, aba lariñagun lun:</para>
  <para style="p" vid="GEN 27:18">—Núguchi!</para>
  <para style="p" vid="GEN 27:18">Aba lóunabun Isaakü:</para>
  <para style="p" vid="GEN 27:18">—Anahán ya. Ka hádangiñe nirahüñü buguya?<verse eid="GEN 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 27:19" />Aba lariñagun Hakobu:</para>
  <para style="p" vid="GEN 27:19">—Esaú au, le biráü le íbugañaü. Adüga naali le uágubei bariñaga nun. Saraba, ñuruba hou báamuga lídangiñe animaalu le náfarubei, lárigiñe ábame babinirunina.<verse eid="GEN 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 27:20" />Ábati lálügüdüni Isaakü:</para>
  <para style="p" vid="GEN 27:20">—Ida liñagia lóufunbei badariruni, niráü?</para>
  <para style="p" vid="GEN 27:20">Aba lóunabun Hakobu:</para>
  <para style="p" vid="GEN 27:20">—Aburemei le Bubungiute íderagubalina lun nadariruni.<verse eid="GEN 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 27:21" />Lariñaga Isaakü lun:</para>
  <para style="p" vid="GEN 27:21">—Yarafabá, gurú náamugabu, ariha náamugei anhein Esaú lubéi le niráü buguya.<verse eid="GEN 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 27:22" />Aba layarafadun Hakobu lun laguuruni Isaakü. Ábati lariñagun Isaakü:</para>
  <para style="p" vid="GEN 27:22">—Umalali lumalali Hakobu, gama lumoun arünaü larüna Esaú.<verse eid="GEN 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 27:23" />Masubudirun lumuti lubeiti ladüga hayu lan larüna kei larüna Esaú. Gama lumoun dan le labiniraali lan yebe, <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />ábaya lálügüdüni:</para>
  <para style="p" vid="GEN 27:24">—Binarün san luagu Esaú lan buguya le niráü?</para>
  <para style="p" vid="GEN 27:24">Aba lóunabun Hakobu:</para>
  <para style="p" vid="GEN 27:24">—Anha, Esaú au.<verse eid="GEN 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 27:25" />Ábati lariñagun lúguchi lun:</para>
  <para style="p" vid="GEN 27:25">—Digabei neigin niráü, hou náamuga lídangiñe bíliru, biní náamugabu giñe.</para>
  <para style="p" vid="GEN 27:25">Aba ladigin Hakobu leigin lúguchi, barǘ ligía diwéin lun. Aba leigin Isaakü gurá ligía. <verse eid="GEN 27:25" /><verse number="26" style="v" sid="GEN 27:26" />Lárigiñe aba lariñagun lun:</para>
  <para style="p" vid="GEN 27:26">—Yarafabá niráü lun bachuurunina.<verse eid="GEN 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 27:27" />Dan le layarafadun Hakobu lun lachuuruni aba lirimichunu Isaakü ladaüragun. Ábati labiniruni, lau burí dimurei le:</para>
  <para style="b" vid="GEN 27:27" />
  <para style="q" vid="GEN 27:27">«Anha, líhemen niráü íhemeni le.</para>
  <para style="q" vid="GEN 27:27">Ítara liña kei líhemen aban áraabu le biní laali Bungiu.<verse eid="GEN 27:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="GEN 27:28" />Rulei Bungiu huya siélugiñeti bun,</para>
  <para style="q" vid="GEN 27:28">lubuidun-agei alubahani múarugugiñe</para>
  <para style="q" vid="GEN 27:28">saragu türigu tuma saragu diwéin.<verse eid="GEN 27:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="GEN 27:29" />Seriwi hamabu saragu gürigia;</para>
  <para style="q" vid="GEN 27:29">hudugua hamá néchanigu bigibugiñe.</para>
  <para style="q" vid="GEN 27:29">Gumadibaña bíbirigu guánarügü;</para>
  <para style="q" vid="GEN 27:29">hudugua hamá bigibugiñe!</para>
  <para style="q" vid="GEN 27:29">Híñarawaguba sun ha íñaragutibu,</para>
  <para style="q" vid="GEN 27:29">ha abinirutibu habinirúba».<verse eid="GEN 27:29" /></para>
  <para style="b" />
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30" />Súnhali labiniruni Isaakü Hakobu, láfuriduñati Hakobu le ñéingiñe lubéi lúguchi, ligía lagiribudun Esaú lídangiñe léibaahan. <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />Aba giñe laranserun aban gisóu semeeti, aba lanügüni lun lúguchi, lariñaga lun:</para>
  <para style="p" vid="GEN 27:31">—Saraba núguchi, houba lídangiñe animaalu le láfarubei biráü, biní báamugana.<verse eid="GEN 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 27:32" />Ábati lálügüdüni Isaakü:</para>
  <para style="p" vid="GEN 27:32">—Kátabu?</para>
  <para style="p" vid="GEN 27:32">Aba lóunabuni:</para>
  <para style="p" vid="GEN 27:32">—Esaú au, biráü le íbugañaü.<verse eid="GEN 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 27:33" />Aba taweiridun lanigi Isaakü, lariñaga lau umalali adadagarati:</para>
  <para style="p" vid="GEN 27:33">—Káteiti ñǘdünbei éibaaha aba liabin lau gisóu nun? Houna súngubei lubaragiñe biabin, aba nabiniruni, guentó rédeihati lau abiniruni.<verse eid="GEN 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 27:34" />Dan le laganbunbalin Esaú le lariñagubei lúguchi, aba layahun, aba lagúaragun:</para>
  <para style="p" vid="GEN 27:34">—Rubei giñe babinirun nun núguchi!<verse eid="GEN 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 27:35" />Aba lóunabun Isaakü:</para>
  <para style="p" vid="GEN 27:35">—Ñǘbuinhali bamulen, aba leyeedunina, barülati abiniruni le yebe bunbei.<verse eid="GEN 27:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 27:36" />Lariñaga Esaú:</para>
  <para style="p" vid="GEN 27:36">—Ligía híchugunbei Hakobu luagu! Anihán libiaman leyeedunina! Furumiñe aba lagidaruni niricha nuéi keisi íbugañaü, guentó barüla abiniruni le yebe nánibei, mareiduntibu san ni ábanraü abiniruni nubá?<verse eid="GEN 27:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 27:37" />Aba lóunabun Isaakü:</para>
  <para style="p" vid="GEN 27:37">—Rúhadina ubafu lun Hakobu buagu ani ru naaña sun liduheñu lun lubúeingubaña lan. Ariñagaadina giñe luagu ñeinboun lan saragu türigu tuma diwéin luma. Kábati gayara nadügün buagu guentó niráü?<verse eid="GEN 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 27:38" />Aba lagiribuhan Esaú, lariñaga:</para>
  <para style="p" vid="GEN 27:38">—Ábanrügüñein san abiniruni gayara bíchuguni, núguchi? Binibana giñe!</para>
  <para style="p" vid="GEN 27:38">Ábaya lagúaragun ayahua.<verse eid="GEN 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 27:39" />Ábati lariñagun Isaakü lun:</para>
  <para style="b" vid="GEN 27:39" />
  <para style="q" vid="GEN 27:39">«Baganóuba dise luéi múa le<optbreak /> buiti lun bunaguaü,</para>
  <para style="q" vid="GEN 27:39">dise giñe luéi huya<optbreak /> le áhuyubei siélugiñe.<verse eid="GEN 27:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="GEN 27:40" />Gasu besefuragun bungua<optbreak /> tau befeinte,</para>
  <para style="q" vid="GEN 27:40">lumusunbadibu bamulen; gama lumoun danme le béredun,</para>
  <para style="q" vid="GEN 27:40">báfuriduba lábugiñegiñe lugumadin».<verse eid="GEN 27:40" /></para>
  <para style="s1">Lanurahan Hakobu luéi Esaú</para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 27:41" />Lúmagiñe dan ligía aba liyereegudun Hakobu lun Esaú luagu abiniruni le líchugubei lúguchi lun, aba lasaminarun: «Málühadiwa ánhawa amuisera lárigi núguchi, lárigiñeme lira, ábame náfaruni namulen Hakobu».<verse eid="GEN 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 27:42" />Dan le tasubudirunbalin Rebeka le laritagubei Esaú ladügün, aba tóunahan agúara lun Hakobu tariñaga lun:</para>
  <para style="p" vid="GEN 27:42">—Busentitia bíbugaña Esaú láfarunibu, luéigiñe le badügübei lun. <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />Aganbabána lubeiti niráü; beiba furese lúbiñoun nati Lawán le aganóubei Arán. <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />Ábame berederun luma luagu átiri dan, darí lásügürün ligañi bíbugaña <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />bulíeileime sun le badügübei lun. Ábameti nóunahan awisarabu lun bagiribudun. Mabusenruntina neferidiruniña biángubei nirahüñü lidan ábanmeme weyu!<verse eid="GEN 27:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46" />Lárigiñe aba tariñagun Rebeka lun Isaakü:</para>
  <para style="p" vid="GEN 27:46">—Buchá nuagu lubá nibagari hadüga Étüna ha úmabaña lamarieida Esaú. Anhein amarieida Hakobu tuma aban Étüna hibe ha yáabaña Kanán, hilagubeina.<verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />Ábati lagúarun Isaakü lun Hakobu, aba labiniruni aba líchugun gumadi lun:</para>
  <para style="p" vid="GEN 28:1">—Mamarieidabá tuma ni aban würi to yaana Kanán. <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />Beiba Padán-aramü, lúbiñe báruguti Betueli, ábame bamarieidun ñein tuma aban hádangiñe lirahüñü biyaurite Lawán. <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />Binilabu Bungiu Suntigabafu, ru ligíame saragu adügawaguni bun, lun hayabin saragu néchani bídangiñe. <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" />Rulei giñe abiniruni le uágubei lariñaga lun Abüraámü bun luma houn badügawagun, lun labureme hamá múa le ñein lubéi waganawa guentó kei terencha, ladüga füramase lumuti lun Abüraámü.<verse eid="GEN 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 28:5" />Ítara liña lóunahani Isaakü Hakobu Padán-aramü lúbiñoun Lawán, le liráü Betueli le Aramüna tati Rebeka to lúguchu Hakobu luma Esaú.<verse eid="GEN 28:5" /></para>
  <para style="s1">Lamarieidun Esaú</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6" />Ariha lumuti buga Esaú dan le labinirunbalin Isaakü Hakobu aba lan lóunahani Padán-aramün lun lamarieidun ñein. Ariha lumuti giñe luagu dan lan le labinirunbalin lúguchi ariñaga lan lun lun mamarieidun lan tuma ni aban würi to ñeina Kanán, <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />ani luagu ñüdün lan Hakobu Padán-aramü kei hariñaguni lagübürigu lun. <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />Ítara liña lasubudiruni Esaú luagu mínsiñe hamá würiña ha ñeina Kanán lun lúguchi; <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />aba lubeiti lidin arihei Ísümaeli le liráü Abüraámü, aba lamarieidun tuma liráü Ísümaeli to gíriboun Maalatü to litu Nebaiotu, hánwounme buga lúmarigu ha Kananna.<verse eid="GEN 28:9" /></para>
  <para style="s1">Lasaliragun Bungiu lun Hakobu Beteli</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />Aba láfuridun Hakobu Bérüsewagiñe lun lárügüdüni üma lun Arán. <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />Aba lachülürün lidoun aban fulasu, aba lerederun ásügürei áriebu ñein, ladüga dárühali lan. Aba líchugun aban lídangiñe dübü burí le ñeinbei lichügübárarime, aba larounrun arumuga. <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />Aba gewenedü lan larihin aban esütépu lúmagiñe múarugugiñe darí sielu, añahati, lani Bungiu ánheli amudeiha luma arariha luéigiñe. <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />Ñeinñein giñe Bungiu rara lubadu esütépu ligía, lariñagati lun:</para>
  <para style="p" vid="GEN 28:13">—Bungiu au, le Lubungiute báruguti Abüraámü, Lubungiute giñe búguchi Isaakü. Níchugubei múa le ñein lubéi barounra bun luma houn badügawagun. <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />Hachülürüba badügawagun lun gibe hamá kei sagoun, añaheinbaña luagu nórute luma luagu suru; luagu oubaü le ñéingiñe lubéi laboucha weyu luma luagu le ñeinhin lubéi lálüda, ani sun iduheñu ha ubouagubaña habinirúba bídangiñe luma hádangiñe badügawagun. <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />Anahein buma; nóunigirubadibu ñein lumuti bidin, ani nagiribudagüdübadibu lidoun múa le. Mígirun nubadibu magunfulirunganei le füramase náalibei bun.<verse eid="GEN 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 28:16" />Dan le lagagudunbei Hakobu lídangiñe luénedü, aba lasaminarun: «Inarüni anihein Bungiu lidan fulasu le, ani au ibidiñeti yebe nun». <verse eid="GEN 28:16" /><verse number="17" style="v" sid="GEN 28:17" />Aba lanufudedagun, aba lasaminarun: «Sagüráuti fulasu le. Anuhán luban Bungiu ya, ligía lubenaribei sielu!»<verse eid="GEN 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 28:18" />Larugan aba lásaarun Hakobu binaafingiua, aba lanügüni dübü le buga eseriwidubei lun kei ichügübarari, aba lararamagüdüni úaragua, aba líchugun garaba luagu. <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />Ñeinñein meha aban uburugu gíriti leiti lidan fulasu ligía, gama lumoun aba lasansiruni Hakobu liri aba líchugun Beteli luagu. <verse eid="GEN 28:19" /><verse number="20" style="v" sid="GEN 28:20" />Ñein ladügei Hakobu füramasei le: «Anhein ñüdün Bungiu numa, góunigilaname lidan nuéiyasun; anhein íchiga éigini nun tuma daüguaü, <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />ani ánhana agiribuda lau magadiñein lúbiñoun núguchi, ligíaba Nubungiute. <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />Anihán dübü le níchugubei kei pilarü, lúbanbei Bungiu; ani súnwandan níchugubei lan diisi lídangiñe san lídangiñe sun le lunbei bíchuguni nun Bungiu».<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s1">Hakobu lidan fulasu le gíribei Arán</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />Aba lasigiruni Hakobu léibugun, aba lidin lidoun hamúan ha erederubaña lidan oubaü le ñéingiñe lubéi laboucha weyu. <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />Aba larihin aban fusu áraabu, ñéinñanu ǘrüwa hóuniri mudún. Kada aban hau mudún hama gábara ha lóunigirubaña, ladüga lídangiñe fusu ligía hata animaalugu duna. Ñeinñein aban óunwenbu dübü luagu liyuma fusu ligía, <verse eid="GEN 29:2" /><verse number="3" style="v" sid="GEN 29:3" />dan le buriti hóundaragun sun mudún ñein, ábaha hagidaruni hóuniri dübü lun hatun mudún duna, lárigiñe ábaya hadouruni. <verse eid="GEN 29:3" /><verse number="4" style="v" sid="GEN 29:4" />Aba lálügüdüniña Hakobu hóuniri mudún:</para>
  <para style="p" vid="GEN 29:4">—Halíana san huguya numadagu?</para>
  <para style="p" vid="GEN 29:4">Aba hóunabun:</para>
  <para style="p" vid="GEN 29:4">—Lídangiñetiwa fulasu le gíribei Arán.<verse eid="GEN 29:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 29:5" />Ábaya lálügüdahan:</para>
  <para style="p" vid="GEN 29:5">—Subuseti Lawán hun le liráü Naoru?</para>
  <para style="p" vid="GEN 29:5">Aba hóunabun:</para>
  <para style="p" vid="GEN 29:5">—Anha, subuseti woun.<verse eid="GEN 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 29:6" />Aba lagiribuhan Hakobu:</para>
  <para style="p" vid="GEN 29:6">—Magadiñeti ladariragun lungua?</para>
  <para style="p" vid="GEN 29:6">—Anha, magadiñeti Lawán —liña hóunabun hóuniri mudún—. Arihabá, anutén Rakeli to liráü hau halügüniña mudún.<verse eid="GEN 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 29:7" />Ábati lariñagun Hakobu:</para>
  <para style="p" vid="GEN 29:7">—Wéyuagugili lun hadaürǘniwa mudún. Ka uagu míchugun hubéi duna houn aba hamuga hígiruniña lun heigin?<verse eid="GEN 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 29:8" />Aba hóunabun:</para>
  <para style="p" vid="GEN 29:8">—Siñati wadügüni lira. Mosu wagurabun lun hóundaragun súngubei mudún, lun giñe hagidaruni hóuniri dübü luéigiñe liyuma fusu lun gayara lan lichugún duna houn mudún.<verse eid="GEN 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 29:9" />Sun anihán lan Hakobu adimureha hama, aba tachülürün Rakeli hau lilügüniña túguchi mudún kei tuguya lubéi óunigirubaliña. <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />Kei larihinu Hakobu hau lilügüniña liyaurite Lawán mudún, aba lagidaruni dübü luéigiñe liyuma fusu, aba líchugun duna houn mudún; <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />aba lachuurunu aba lagumeserun ayahua.<verse eid="GEN 29:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 29:12" />Dan le labahüdagun Hakobu tun luagu tiráü lan Rebeka ligía ani liraühaña lan Lawán aba tidin Rakeli éibaagueina abahüdaguei lun túguchi. <verse eid="GEN 29:12" /><verse number="13" style="v" sid="GEN 29:13" />Dan laganbunbei Lawán luagu Hakobu, le tiráü litu, aba léibaagun eresibirei, aba lóuburuni, aba lachuuruni, aba lanügüni lúbiñoun. Lárigiñe aba labahüdaguni Hakobu sun le asuseredubei lun.<verse eid="GEN 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 29:14" />Lariñaga Lawán lun:</para>
  <para style="p" vid="GEN 29:14">—Inarüni luagu aban ban hádangiñe nita.</para>
  <para style="s1" vid="GEN 29:14">Lawadigimaridun Hakobu tuagu Rakeli tuma Lía</para>
  <para style="p" vid="GEN 29:14">Aba lerederun Hakobu luma Lawán aban hati. <verse eid="GEN 29:14" /><verse number="15" style="v" sid="GEN 29:15" />Lárigiñe dan ligía aba lariñagun Lawán lun Hakobu:</para>
  <para style="p" vid="GEN 29:15">—Mawadigimaribadibu nun magañeirunga ni kata ladügarügü niduhe ban. Ariñagabéi nun átiri lan babusenrun nafayeirunibu.<verse eid="GEN 29:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 29:16" />Garahüñütiti Lawán bián würiña irahüñü: Lía tiña to íbugañaü, Rakeli to amuleluaü. <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />Buíduburiti tagu Lia; anhoun Rakeli magadiñetu lúmagiñe tugudi lumoun tichügü. <verse eid="GEN 29:17" /><verse number="18" style="v" sid="GEN 29:18" />Keiti buga hínsiñe tan Rakeli lun Hakobu, aba lariñagun:</para>
  <para style="p" vid="GEN 29:18">—Nuadigimariba sedü irumu buma tuagu Rakeli.<verse eid="GEN 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 29:19" />Aba lóunabuni Lawán:</para>
  <para style="p" vid="GEN 29:19">—Buítimati lun níchugunu bun, mama lun aban terencha. Rédeiba numa.<verse eid="GEN 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 29:20" />Ítara liña luadigimaridun Hakobu sedü irumu tuagu Rakeli, gama lumoun málüti lasandiruni dan ligía ladüga wéiriti tínsiñe lun.<verse eid="GEN 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 29:21" />Dan le lásügürünbei sedü irumu ligía aba lariñagun Hakobu lun Lawán:</para>
  <para style="p" vid="GEN 29:21">—Ruboun númari nun maríei náamuga tuma, ladüga gumuha dan le lunbei nuadigimariduni tuagu.<verse eid="GEN 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 29:22" />Ábati lamisurahaniña Lawán sun lubesinanigu lidoun fedu le lánina maríei le ladügübei. <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />Gama lumoun aba lanügünu Lawán Lía áriebu, aba líchugunu lun Hakobu, aba larumugun Hakobu tuma. <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />Ru ligía Lawán aban hádangiñe lumusun to gíriboun Silüpá tun Lía lun teseriwidun tun. <verse eid="GEN 29:24" /><verse number="25" style="v" sid="GEN 29:25" />Larugan binaafin, aba larihini Hakobu luagu tuma lan Lía larumuga, aba lariñagun lun Lawán:</para>
  <para style="p" vid="GEN 29:25">—Káteigia le badügübei nun? Ma tuagu Rakeli nuadigimarida buma? Kati uagu beyeedana?<verse eid="GEN 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 29:26" />Aba lóunabuni Lawán:</para>
  <para style="p" vid="GEN 29:26">—Magaburi wamuti ya lun tamarieidun amuleluaü tubaragiñe íbugañaü. <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />Gúnfulibei lidimasuna maríei le tani Lía, ábame giñe níchugunu Rakeli bun, anhein busén bubéi buadigimaridun ábanya sedü irumu numa.<verse eid="GEN 29:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 29:28" />Aba lánharun Hakobu, danti le lagumuchun lidimasun tamarieidun Lía, aba líchugunu Lawán Rakeli lun lúmarime. <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />Aba giñe líchugun Lawán aban hádangiñe lumusuniña gíritu Bilá tun Rakeli lun teseriwidun tun. <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />Ábati lóundarun Hakobu tuma Rakeli, aba tínsiñedun lun sügǘ tau Lía, íbini awadigimarida lan ábanya sedü irumu lanwoun luma Lawán.<verse eid="GEN 29:30" /></para>
  <para style="s1">Lirahüñü Hakobu</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />Dan larihinbei Bungiu luagu lougua lan tínsiñe Lía lun Hakobu, aba ladügün Bungiu lun tagaraüdün Lía, Rakeliti maraütu. <verse eid="GEN 29:31" /><verse number="32" style="v" sid="GEN 29:32" />Aba tadageinadun Lía, aba tagaraüdün aban irahü, aba tíchugun Rubén luagu, tariñaga:</para>
  <para style="p" vid="GEN 29:32">—Ariha lumuti Bungiu nirun. Nínsiñedaame lun númari guenlé.<verse eid="GEN 29:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 29:33" />Lárigiñe ábaya tagaraüdün Lía aban irahü, aba tíchugun Simeón luagu, tariñaga:</para>
  <para style="p" vid="GEN 29:33">—Ariha lumuti Bungiu luagu mínsiñen nan buga houn, ligía líchugunbei ábanya irahü nun.<verse eid="GEN 29:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 29:34" />Ábaya tagaraüdün aban, aba tíchugun Lewí luagu, tariñaga:</para>
  <para style="p" vid="GEN 29:34">—Guenlé lóundaratimaha númari numoun, ladüga ǘrüwaña nirahüñü lau.<verse eid="GEN 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 29:35" />Ábaya tagaraüdün aban, aba tíchugun Hudá luagu, tariñaga:</para>
  <para style="p" vid="GEN 29:35">—Neremuha lun Bungiu guenlé.</para>
  <para style="p" vid="GEN 29:35">Lárigiñe aba magaraüdün tan.<verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />Dan tarihinbei Rakeli luagu siñá lan tagaraüdün lau Hakobu, aba tagimugadun tun tíbugaña aba tariñagun lun túmari:</para>
  <para style="p" vid="GEN 30:1">—Garaügüdabana, ánhana magaraüdagüdün ban nóunweba.<verse eid="GEN 30:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 30:2" />Aba lagañidun Hakobu tuma, lariñaga tun:</para>
  <para style="p" vid="GEN 30:2">—Bungiu funagia au? Bungiu mígirunbei lun bagaraüdün.<verse eid="GEN 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 30:3" />Ábati tariñagun lun:</para>
  <para style="p" vid="GEN 30:3">—Barüboun Bilá to numusun, gámariboun; danme tagaraüdün, kéigubeirügüme nuguya lan agaraüdübei. Ítara luba gayara lan garahüñü nan.<verse eid="GEN 30:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 30:4" />Ítara liña tíchugunu Rakeli Bilá to tumusun lun Hakobu lun lúmarime aba larounrun Hakobu tuma Bilá, <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />aba tíchugun aban irahü lun Hakobu.<verse eid="GEN 30:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 30:6" />Ábati tariñagun Rakeli:</para>
  <para style="p" vid="GEN 30:6">—Dan, ligíaba liri irahü le, ladüga aganba laali Bungiu nafurieidun aba larichadun numa, aba líchugun aban irahü nun.<verse eid="GEN 30:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 30:7" />Ábaya tagaraüdün Bilá lau Hakobu. <verse eid="GEN 30:7" /><verse number="8" style="v" sid="GEN 30:8" />Aba tariñagun Rakeli:</para>
  <para style="p" vid="GEN 30:8">—Nefütalí, ligíaba liri irahü le, lugundun ageindaguaadina saragu tuma níbugaña ani gañei numutu.<verse eid="GEN 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 30:9" />Dan le tarihinbei Lía luagu siñá lan tagaraüdün, aba tíchugunu tumusun to Silüpá lun Hakobu lun lúmarime. <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />Danti le tagaraüdünbei Silüpá lau Hakobu. <verse eid="GEN 30:10" /><verse number="11" style="v" sid="GEN 30:11" />Aba tariñagun Lía:</para>
  <para style="p" vid="GEN 30:11">—Ubunuruni! Gadü Ligíaba liri irahü le.<verse eid="GEN 30:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 30:12" />Lárigiñe ábaya tagaraüdün Silüpá lau Hakobu, <verse eid="GEN 30:12" /><verse number="13" style="v" sid="GEN 30:13" />ábati tariñagun Lía:</para>
  <para style="p" vid="GEN 30:13">—Ugundani! Guenlé hariñaguba hiñaruñu luagu gunda nan. Aserü ligíaba liri irahü le!<verse eid="GEN 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14" />Luagu aban weyu, aba lidin Rubén áraabu lidan lidaani lalubahóun türigu. Aba ladarirun aban luwuyeri tin wewe gíritu mandürágora<note caller="3" style="f"><char style="fr" closed="false">30.14 </char><char style="ft" closed="false">Mandürágora: Según meha échuni, afiñewati meha buidu tan in to lun ménrengu lan hadageinadun würiña.</char></note> ñein, aba lanügünu tun Lía to lúguchu. Dan le tarihinu Rakeli tin wewe tuguya, aba tariñagun tun Lía:</para>
  <para style="p" vid="GEN 30:14">—Adügabá fulesei nun, ruba tídangiñe mandürágora, to lanügüboun biráü nun.<verse eid="GEN 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 30:15" />Gama lumoun aba tóunabunu Lía:</para>
  <para style="p" vid="GEN 30:15">—Lóuguagili san bun banügüni númari nuéi? Busentibu giñe banügünu lumandürágoran niráü nuéi!</para>
  <para style="p" vid="GEN 30:15">Tariñaga Rakeli tun:</para>
  <para style="p" vid="GEN 30:15">—Larumuguba Hakobu buma áriebu le teweñegua lumandürágoran biráü.<verse eid="GEN 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 30:16" />Dan le liabin Hakobu áraabugiñe guñoun, aba táfuridun Lía lubaroun, tariñaga lun:</para>
  <para style="p" vid="GEN 30:16">—Barumuga numa uguñe, ladüga akilaha náadibu tuagu lumandürágoran niráü.</para>
  <para style="p" vid="GEN 30:16">Aba larumugun Hakobu tuma Lía áriebu ligía. <verse eid="GEN 30:16" /><verse number="17" style="v" sid="GEN 30:17" />Aba tagaraüdüni haseingün tirahüñü lau, ladüga laganbuni Bungiu tafurieidun. <verse eid="GEN 30:17" /><verse number="18" style="v" sid="GEN 30:18" />Ábati tariñagun Lía:</para>
  <para style="p" vid="GEN 30:18">—Isakárü ligíaba liri irahü le, ladüga rúhali lan Bungiu nafayeiruaha ladüga níchugunu numusun lun númari lun lagamaridunu.<verse eid="GEN 30:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 30:19" />Lárigiñe aba tagaraüdüni Lía hasisin tirahüñü lau Hakobu, <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />aba tariñagun:</para>
  <para style="p" vid="GEN 30:20">—Rúhali Bungiu aban buiti idewesei nun. Nínsiñedatimaha lun númari guenlé, ladüga sísihaña nirahüñü lau.</para>
  <para style="p" vid="GEN 30:20">Ligía Sabulónba lubéi liri irahü le.<verse eid="GEN 30:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 30:21" />Le lagumuhóun aba tagaraüdün Lía aban würi irahü aba tíchugun Dina tuagu.<verse eid="GEN 30:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 30:22" />Aba laritagun Bungiu tuagun Rakeli; aba laganbuni tafurieidun, aba ladügün lun tagaraüdün, <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />danti le tagaraüdüni furumiñeti, aba tariñagun:</para>
  <para style="p" vid="GEN 30:23">—Gidala Bungiu busiganu lánina maraüni nuéi. <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />Garaüdügüya náamuga aban! Ligía Hoseeba lubéi liri irahü le.<verse eid="GEN 30:24" /></para>
  <para style="s1">Iwiyei hádangua Hakobu luma Lawán</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />Lárigiñe tágurahani Rakeli Hosé, aba lariñagun Hakobu lun Lawán:</para>
  <para style="p" vid="GEN 30:25">—Ígirabana lun nagiribudun nageiroun. <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />Rúbaña nirahüñü nun hau númarigu, ladüga nadagimeinhaadina buma hawagu, ígirabana lun nidin. Subudi bumuti buidu ida liña lan nuadigimaridun bun.<verse eid="GEN 30:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 30:27" />Gama lumoun aba lóunabuni Lawán:</para>
  <para style="p" vid="GEN 30:27">—Adügabá fulesei nun, rédeiba numa. Ariha naali luagu biní laadina lan Bungiu bídangiñe. <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />Ariñagabéi nun átiri lan babusenrun bagañeirun, nafayeirubei bun.<verse eid="GEN 30:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 30:29" />Ábati lariñagun Hakobu lun:</para>
  <para style="p" vid="GEN 30:29">—Subuseti bun buidu ida liña lan buga nuadigimaridun bun, góuniginaña bibiñanigu; <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />lubaragiñebei niabin míbetiña meha buma, guentó, gíbetimahaña buma. Biní laadibu Bungiu lúmagiñe nachülürün; gama lumoun ídabati nagumesera nadagimein houn niduheñu?<verse eid="GEN 30:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 30:31" />Aba lagiribuhan Lawán:</para>
  <para style="p" vid="GEN 30:31">—Átiriñein babusenrun nafayeirunibu?</para>
  <para style="p" vid="GEN 30:31">Aba lóunabun Hakobu:</para>
  <para style="p" vid="GEN 30:31">—Mafayeirabana ni kata. Nóunigirayabaña bilügüniña mudún ánhabu gundan lau nidaradun. <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />Ígiraba lun nebelurun hadoun sun bilügüniña uguñe, ábame nafanreinruniña sun mudún ha wuriburibaña hama sun gábara ha singa. Hagíaba nafayeiruaha. <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />Ítara luba danme biabin arihei le nagañeirubei líteme; bóuchagubadina luagu míweruhangidina lan buéi ánhabu adarira gábara ha mama singa o mudún ha máwurintiña, níweruhan buéi.<verse eid="GEN 30:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 30:34" />Lariñaga Lawán lun, buiti:</para>
  <para style="p" vid="GEN 30:34">—Gúndaatina lau bidaradun.<verse eid="GEN 30:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 30:35" />Gama lumoun weyuméme ligía, aba lafanreinraguniña Lawán sun gábara wügüriña ha singa hama gábara singa ha würiña ha burí barütiña murusun haruti, hama sun mudún wuritiña, aba líchuguniña houn lirahüñü lun hóunigiruniña. <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />Lárigiñe aba lidin hau mudún lídangiñe fulasu le ñein lubéi Hakobu lidoun amu fulasu le díseti ǘrüwa weyu éibuguni ñéingiñe. Ábati lerederun Hakobu óunigiraña híbiri lilügüniña Lawán mudún.<verse eid="GEN 30:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 30:37" />Aba láchuahan lilimun wewe le wurigili: Álamu, alüménduru luma kasütáñu, aba lélehani limu ligía lun larihín líharun. <verse eid="GEN 30:37" /><verse number="38-39" style="v" sid="GEN 30:38-39" />Aba líchuguni burí wewe léwaali ligía hagibugiñe animaalu, le ñein lubeiha hayabin ata duna. Ñeinha hawariraña gábara wügüriña gábara würiña, kéitiha ligibugiñe lan wewe ligía hadügei, dan le hemeilihan, hayabin harahüñü, singa.<verse eid="GEN 30:38-39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 30:40" />Hati mudún, ábaha lanügüniña Hakobu, aba líchuguniña hagibugiñe animaalu ha singa hama ha wuritiña hádangiñe lilügüniña Lawán. Ítara liña adügeinalani Hakobu lani lungua luéi lani Lawán.<verse eid="GEN 30:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 30:41" />Ságüha lidaani hawariruniña animaalu wügüriña ha dibunebaña würiña, ábaha líchuguni Hakobu wewe lidan fulasu le ñein lubéi hata duna, lun gayara lan harihini wewe ligía dan le lawarirunu wügüri würi; <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />gama lumoun danha le hayabin ha dúreitimabaña, michu lumuti wewe. Ligía sun lubeiha animaalu ha dúreibaña lilügüniña Lawán, ha dibunebaña lilügüniña Hakobu. <verse eid="GEN 30:42" /><verse number="43" style="v" sid="GEN 30:43" />Ítara liña larisidun Hakobu saragu, aba hagibedun lilügüniña mudún, lidamun, lilügüniña kameyu hama burigü.<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="s1">Laransehan Hakobu lun lanurun luéi Lawán</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />Aba laganbun Hakobu luagu hariñahare lan lirahüñü Lawán:</para>
  <para style="p" vid="GEN 31:1">—Barüla Hakobu sun le meha lani wáguchi, lau larisida.<verse eid="GEN 31:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 31:2" />Aba giñe larihini Hakobu luagu Lawán luagu mabuidunhali lan larihin luagun kei meha furumiñe. <verse eid="GEN 31:2" /><verse number="3" style="v" sid="GEN 31:3" />Ábati lariñagun Bungiu lun Hakobu:</para>
  <para style="p" vid="GEN 31:3">—Giribubá lageiroun búguchi le ñein habéi biduheñu, nídiba buma.<verse eid="GEN 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 31:4" />Aba lóunahan Hakobu tuagu Rakeli tuma Lía lun hayabin le ñeinhin lubéi hau lilügüniña mudún, <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />lariñaga houn:</para>
  <para style="p" vid="GEN 31:5">—Ariha numuti luagu móuserun láadina lan húguchi kei meha furumiñe, gama lumoun éibugati Lubungiute núguchi numa súnwandan. <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />Subudi humuti luagu nadagimeinhaadina lan lun húguchi le lubuidun-agei niyaraati. <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />Gama lumoun ligía, yeeda láadina, danmeme sansi laali nafayeiruaha. Lau sun lira mígirunti Bungiu lun ladügün ni murusun wuribani nun; <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />lubaragiñe lira danha le lariñagun: “Nafayeirubadibu hau animaalu singa”, súngubeiha aba hemeilihan singa. <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />Ítara liña lagidaruniña Bungiu libiñanigu luéi lun líchuguniña nun.<verse eid="GEN 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 31:10" />Luagu aban weyu dan le lidaani hawariruniña animaalu wügüriña animaalu würiña, aba gewenedü nan luagu singa hamá gábara wügüriña ha awarirubaliña gábara würiña. <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />Lidan uénedü ligía aba lagúarun lani Bungiu ánheli nun lau niri, nariñaga lun: «Anahán ya». <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />Lariñaga nun: «Arihabá buidu barihuba luagu sun lan animaalu wügüriña ha awarirubaliña animaalu würiña, singa, ladüga ariha naali sun le ladügübei Lawán bun. <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />Au Bungiu le arufudagubei lungua bun Beteli, le ñein lubéi bíchiga garaba luagu dübü, aba badügün aban füramasei nun. Saraba beiba lídangiñe fulasu le; giribubá lidoun fulasu le ñein lubéi bágurahoua».<verse eid="GEN 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 31:14" />Ábati hóunabun Rakeli tuma Lía:</para>
  <para style="p" vid="GEN 31:14">—Wagia malagantehaadiwa lúbiñe wáguchi. <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />Lubaragiñe lira óuserarügü lumutiwa kamá hamuga terencha wagía. Darí lun laluguruniwa, aba lerederun lau le bafayeirubei lun luagu bamarieidun wama! <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />Lidan linarün katei, sun irisini le lagidarubei Bungiu luéi wáguchi, wani hau warahüñü. Adügabéi lubeiti le lariñagubei Bungiu bun.<verse eid="GEN 31:16" /></para>
  <para style="s1">Lidin Hakobu Padán-aramügiñe</para>
  <para style="p">
    <verse number="17-18" style="v" sid="GEN 31:17-18" />Aba laranserun Hakobu lun lagiribudun lárigoun Kanáun, le ñein lubéi buga laganawa Isaakü le lúguchi. Aba lawariragüdüniña lirahüñü hama lúmarigu hawagun kameyu, barüléi sun lúmati aba líchuguniña luagu üma hama sun animaalu ha buga libihubaña luagu luadigimari, Padán-aramü. <verse eid="GEN 31:17-18" /><verse number="19" style="v" sid="GEN 31:19" />Dan le lídinbei Lawán ásaraña lilügüniña mudún, aba tíweruhaniña Rakeli liguariuan. <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />Ítara liña leyeeduni Hakobu Lawán le Aramüna lau masubudiragüdünlani lun luagu léibuga lan. <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />Aba lidin lau sun le lúmati. Málüti, aba lánhiñuraguni duna le Éufüratesi, aba lasigirun lubaruaguóun luagun burí luwübüri Galaadü.<verse eid="GEN 31:21" /></para>
  <para style="s1">Léibaahani Lawán Hakobu</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22" />Ǘrüwa weyu lárigiñe, aba lasubudiruni Lawán luagu ñǘdünha lan Hakobu. <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />Aba lidin lárigi hau liduheñu luma, aba lárügüdüni luagun burí luwübüri Galaadü, sedü weyu lárigiñe. <verse eid="GEN 31:23" /><verse number="24" style="v" sid="GEN 31:24" />Gama lumoun aba larufudagun Bungiu lungua lun Lawán le Aramüna áriebu ligía lidan luénedü, lariñaga lun:</para>
  <para style="p" vid="GEN 31:24">—Madimurehabátia lun Hakobu lau irofuni.<verse eid="GEN 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 31:25" />Aba lárügüdüni Lawán Hakobu luagu burí luwübüri Galaadü le ñein lubéi lemeraagua Hakobu. Ñéinmeme giñe lemeraagua Lawán hau liduheñu. <verse eid="GEN 31:25" /><verse number="26" style="v" sid="GEN 31:26" />Aba lariñagun lun Hakobu:</para>
  <para style="p" vid="GEN 31:26">—Ka badügübei? Kame beyeedana? Barǘ baña nirahüñü kamá hamuga adaürǘtiña ha lánina wuribu! <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />Ka uagu beyeedana aba biabin aramudaguarügü mariñagunga ni kata nun? Lun hamuga subudinani nóunahañadibu hamuga lau ugundani, lau lamuri garanwoun tuma árüpa. <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />Mígirungubeitibu lun nachuuruniña nirahüñü hama nibañan. Adügaadibu aban libidiounigan aau! <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />Gayaraati hamuga nadügün wuribati hun sun huguya guentó, gama lumoun adimurehati Lubungiute búguchi nun áriebu buga, lariñaga nun: “Madimurehabátia lun Hakobu lau irofuni”. <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />Gama lumoun anhein buga weiri lubéi babusenrun bagiribudun lúbiñoun búguchi, ani ligía lébubei bidin, kámegia bíweruhaña nubungiutegu?<verse eid="GEN 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 31:31" />Ábati lóunabuni Hakobu Lawán:</para>
  <para style="p" vid="GEN 31:31">—Ladüga nanufudedun. Naritagun yebe luagu busenbadibu lan bagidaruniña birahüñü nuéi lau erei. <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />Gama lumoun anhein añahein lubéi biguariuan luma aban hádangiñe ha yáabaña, hilala! Waduheñu guánarügü hagíaba gefén. Ariñagabéi nun anhein gemegen bubéi numa, barübei.</para>
  <para style="p" vid="GEN 31:32">Gama lumoun ibidiñeti yebe lun Hakobu luagu Rakeli lan íweruhabaliña liguariuan túguchi.<verse eid="GEN 31:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 31:33" />Aba lebelurun Lawán likianpunrugun Hakobu, lárigiñe, tidoun tikianpun Lía, luma giñe tidoun hakianpun bián idamuni, gama lumoun madari lumutiña guáriua. Dan láfuridun tídangiñe tikianpun Lía, aba lebelurun tidoun tikianpun Rakeli, <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />aba tanügüniña guáriua aba tíchuguniña lidoun lisadilin kameyu, aba tañuurun hawagu. Áluahati Lawán tidan sun kianpu, madari lumutiña. <verse eid="GEN 31:34" /><verse number="35" style="v" sid="GEN 31:35" />Ábati tariñagun Rakeli lun:</para>
  <para style="p" vid="GEN 31:35">—Núguchi, magañidabátia luagu siñá lan násaarun bigibugiñe, gama lumoun láuñadina nidaani.</para>
  <para style="p" vid="GEN 31:35">Keiti láluahaniña Lawán guáriua, madari lumutiña. <verse eid="GEN 31:35" /><verse number="36" style="v" sid="GEN 31:36" />Aba lagañidun Hakobu, aba lariñagun lun Lawán:</para>
  <para style="p" vid="GEN 31:36">—Ka duru nadügübei? Ka nifigounbei lanarimebei béibaahanina? <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />Asagaraha baali sun nílagu, kagia bumegen badarirubei lidan nílagu? Rubei ya hagibugiñe biduheñu hama niduheñu, ariñaga hamaamugei ka lan wádangiñe richaguabei! <verse eid="GEN 31:37" /><verse number="38" style="v" sid="GEN 31:38" />Sun wein irumu le nuadigimaribei buma, magüriagúntiña bilügüniña mudún, ni bilügüniña gábara; meigin au ni aban hádangiñe bilügüniña mudún, <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />manügün numutiña mudún ha burí háfarubaña animaalu áraabuna, lubaragiñe lira ábaha nafayeiruniña. Dan le burí híweruhoun bilügüniña áriebu yebe, wéyuagu yebe, aguburaha bumutiña nuéi. <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />Láfarahanaha lárouga wéyuagu, láfarahana lidiliga áriebu, dariha lun madabu lan nagu! <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />Wein irumu nau búbiñe ani anihán le yuubei nun. Nadagimeintina katorusu irumu buma hawagu bián birahüñü, sisi irumu hawagu bilügüniña animaalu, ani danmeme sansi baali nafayeiruaha. <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />Lun hamuga ua lan Lubungiute Abüraámü numa, Bungiu le Lubungiutebei núguchi Isaakü, chouru numuti luagu bóunahañadina lan hamuga málouga núhabu. Gama lumoun ariha lumuti Bungiu nirun, luma lebegi nuadigimari, aba ladeinhan bun áriebu buga.<verse eid="GEN 31:42" /></para>
  <para style="s1">Ladügün Hakobu aban daradu luma Lawán</para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />Ábati lóunabuni Lawán Hakobu:</para>
  <para style="p" vid="GEN 31:43">—Irahüñü nirahüñü, ibañani nibañan; mudún nilügüniña; sun le barihubei ya, nani! Lau sun lira, kagia gayaraabei nadügün guentó houn nisaanigu o houn lan hasaanigu nirahüñü? <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />Ligía lubeiti wadüga lubéi aban daradu le lunbei leseriwidun kei gefenti wadan wagía biángubei.<verse eid="GEN 31:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 31:45" />Ábati lanügün Hakobu aban dübü, aba líchuguni úaragua kei aban pilarü; <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />aba lariñagun houn liduheñu:</para>
  <para style="p" vid="GEN 31:46">—Óundaragua humá dübü!</para>
  <para style="p" vid="GEN 31:46">Aba hóundaragun sun hagía dübü, aba híchaaguni lidan aban, aba heigin ñein lurugabu dübü-agei ligía. <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />Aba líchugun Lawán liri fulasu ligía lidan lererun. «Hegarü Saadutá», líchigati Hakobu liri lidan lererun; Galaadü. <verse eid="GEN 31:47" /><verse number="48" style="v" sid="GEN 31:48" />Ábati lariñagun Lawán:</para>
  <para style="p" vid="GEN 31:48">—Gefenti dübü burí le wadan uguñe.</para>
  <para style="p" vid="GEN 31:48">Ligía Galaadü lubéi liri fulasu ligía, <verse eid="GEN 31:48" /><verse number="49" style="v" sid="GEN 31:49" />aba giñe híchugun liri fulasu ligía Misüpá ladüga lariñagun Lawán:</para>
  <para style="p" vid="GEN 31:49">—Óunigirala Bungiu wadan lubá danme le siñaali waríagun woungua. <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />Ánhaña bóusera nisaanigu wuriba, o ánhabu lan amarieida hama amu würiña hanwoun, íbinime ua lan ni aban kei gefenti wadan, gefenti Bungiu guánarügü.<verse eid="GEN 31:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="GEN 31:51" />Aban lasigirun Lawán ariñaga lun Hakobu:</para>
  <para style="p" vid="GEN 31:51">—Anihán dübü-agei le níchugubei wádangua wagía biángubei, <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />ligíaba gefenti luagu mánhiñuragun lubéi lan ni aban wádangiñe lun wañawarihan wóuniwagua. <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />Bungiu le Lubungiute báruguti Abüraámü, le giñe Lubungiute náruguti Naoru ligía lun larihin wadan.</para>
  <para style="p" vid="GEN 31:53">Ábati láfiñurun Hakobu luagu Lubungiute Isaakü le lúguchi. <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />Aba ladagaragüdün Hakobu luagu wübü, aba lagúarun houn liduheñu lun heigin, hóutiña sun hagía, aba hásügürüni áriebu luagu wübü. <verse eid="GEN 31:54" /><verse number="55" style="v" sid="GEN 31:55" />Larugan binaafin, aba lásaarun Lawán, aba lachuuruniña libañan hama lirahüñü; lárigiñe aba labiniruniña, aba lagiribudun lageiroun.<verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s1">Hadunragun Hakobu luma Esaú</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />Aba lasigiruni Hakobu lémeri, aba háfuridun átiri lani Bungiu ánheligu lubaroun. <verse eid="GEN 32:1" /><verse number="2" style="v" sid="GEN 32:2" />Dan le larihinbaliña Hakobu, aba lariñagun:</para>
  <para style="p" vid="GEN 32:2">—Lisudaranigu Bungiu ha.</para>
  <para style="p" vid="GEN 32:2">Ligía líchugunbei liri fulasu ligía Manaímü. <verse eid="GEN 32:2" /><verse number="3" style="v" sid="GEN 32:3" />Aba lóunahan Hakobu wügüriña lubá lidoun fulasu le gíribei Seirü lóubawagu Edomu, lun hariñagun lun líbugaña luagu lachülürüba lan, <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />lariñaga houn: Hariñagame lun níbugaña Esaú: «Lóunahaña hamulen Hakobu ariñaga hun: Aganawaadina luma Lawán sun dan le, <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />añahein bágasu numa, burigü, mudún, hama idamuni. Nóunahañein uganu le hun niyubudiri, agurabatina nagañeiruni hugundan».<verse eid="GEN 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 32:6" />Dan le hagiribudun ounahóutiña, aba hariñagun lun Hakobu:</para>
  <para style="p" vid="GEN 32:6">—Ñǘdüntiwa arihei bíbugaña Esaú, anitén bubaroun lun leresibirunibu, úara hama gádürü-san wügüriña.<verse eid="GEN 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 32:7" />Dan le laganbunbalin Hakobu katei le, aba lanufudedagun, aba ladiheridun saragu. Aba lafanreinraguniña Hakobu gürigia ha lúmabaña, bágasu, mudún, hama kameyu lidan biama, <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />aba lasaminarun: Anhein ñübuin Esaú lun lageindagun hama ha tídanbaña aban kianpu, gayaraabei tesefurun to aban kianpu.<verse eid="GEN 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 32:9" />Aba lagumeserun afurieida, lariñaga:</para>
  <para style="p" vid="GEN 32:9">—Bungiu, Lubungiute náruguti Abüraámü, luma núguchi Isaakü, buguya le ariñagubei nun lun nagiribudun nageiroun hamoun niduheñu, luagu badügüba lan lun buídubei lan nuéiyasun. <verse eid="GEN 32:9" /><verse number="10" style="v" sid="GEN 32:10" />Madüna numuti areini le aubei bóuserana. Hiñugua numuti duna Hordán le, manügünga ni kata luéidigia nubadun, guentó biánguaru nikianpun-agei. <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />Adügabá fulesei nun, sefubána luéi níbugaña Esaú! Hanufudetina luéi liabin ageindagua numa, láfaraguañame würiña ha hau irahüñü ha. <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" />Ariñaga baali furangu luagu badügüba lan lun buidu lan lidin nun, luma giñe gíbebaña lan nadügawagun kei sagoun le, gíbebaña nege darí lun siñabei lan habahüdǘn.<verse eid="GEN 32:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 32:13" />Aba larumugun Hakobu ñein áriebu ligía, aba lanúadahan idewesei lídangiñe lumegen lun líchuguni lun Esaú le líbugaña: <verse eid="GEN 32:13" /><verse number="14" style="v" sid="GEN 32:14" />Bián-san gábara würiña, wein gábara wügüriña, bián-san mudún würiña, wein mudún wügüriña. <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />Darandi kameyu würiña ha sun liña hemeilihan hau sun harahüñü, bián-wein bágasu, diisi harahüñü bágasu, wein burigü würiña, hama diisi burigü wügüriña: <verse eid="GEN 32:15" /><verse number="16" style="v" sid="GEN 32:16" />Ábati lafanreinraguniña lidan bián sétanu, aba líchuguniña houn lumusun, lariñaga houn:</para>
  <para style="p" vid="GEN 32:16">—Heiba nubá hadisedaguaraüme hubaruagua, aban sétanu lubá le aban.<verse eid="GEN 32:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 32:17" />Lariñaga lun le lóunahabei furumiñe:</para>
  <para style="p" vid="GEN 32:17">—Danme ladunragun níbugaña Esaú buma, danme lálügüdünibu ka lan baburemebei, haliñounbadibu lan, ka lan ilügüniña animaalu ha búmabaña, <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />bóunabeime: “Idewesei, nabureme Esaú, lóunahan hubúein Hakobu hun. Anitén wárigi wárigi”.<verse eid="GEN 32:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 32:19" />Ariñaga ligía lun le habiaman lóunahan, lun háürüwan luma houn sun ha ñǘdünbaña hau sun animaalu hagía:</para>
  <para style="p" vid="GEN 32:19">—Danme hadunragun luma Esaú, ligiamemelá hariñaga lun, <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />hariñagame giñe lun: “Anitén bubuein Hakobu wárigi wárigi”.</para>
  <para style="p" vid="GEN 32:20">Aba lasaminarun Hakobu: «Nagalumarubei ligañi lau burí idewesei le nóunahabei lun, lárigiñeme ábame nadunragun luma. Háfuga leresibirubadina buidu ítara». <verse eid="GEN 32:20" /><verse number="21" style="v" sid="GEN 32:21" />Aba lubeiti lidin idewesei furumiñe, ligía aba lerederun ásügürei áriebu tidan likianpun.<verse eid="GEN 32:21" /></para>
  <para style="s1">Lageindagun Hakobu luma ánheli</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 32:22" />Aba lásaarun Hakobu áriebumeme ligía, aba lanügüniña bián lúmarigu, bián lubúaligu hama unsu lirahüñü aba lánhiñuraguni duna Haboku hau, <verse eid="GEN 32:22" /><verse number="23" style="v" sid="GEN 32:23" />labu sun le lúmabei. <verse eid="GEN 32:23" /><verse number="24" style="v" sid="GEN 32:24" />Dan le lerederunbei Hakobu lábugua, aba lageindagun aban wügüri luma darí larugadun. <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />Larihinbei wügüri ligía luagu siñagua lan lungua luma Hakobu, aba labuleseiruni liranaagua aba ladiliragun ñein lun Hakobu sun aniha lan ageindagua luma. <verse eid="GEN 32:25" /><verse number="26" style="v" sid="GEN 32:26" />Ábati lariñagun wügüri ligía lun:</para>
  <para style="p" vid="GEN 32:26">—Ígiragüdabana, larugada.</para>
  <para style="p" vid="GEN 32:26">Aba lóunabuni Hakobu:</para>
  <para style="p" vid="GEN 32:26">—Mígiragüdün nubadibu ánhana mabinirun ban.<verse eid="GEN 32:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 32:27" />Lariñaga wügüri ligía lun:</para>
  <para style="p" vid="GEN 32:27">—Ka biri?</para>
  <para style="p" vid="GEN 32:27">Aba lóunabuni:</para>
  <para style="p" vid="GEN 32:27">—Hakobu níribei.<verse eid="GEN 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 32:28" />Lariñaga wügüri ligía lun:</para>
  <para style="p" vid="GEN 32:28">—Mámaalime Hakobu biri. Ísüraeli ligíaba biri, ladüga ageindaguaadibu luma Bungiu luma hama wügüriña, ani gáñeitibu.<verse eid="GEN 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 32:29" />Lariñagati Hakobu lun:</para>
  <para style="p" vid="GEN 32:29">—Ariñagabéiti nun ka lan biri guentó.</para>
  <para style="p" vid="GEN 32:29">Lariñaga wügüri ligía lun:</para>
  <para style="p" vid="GEN 32:29">—Kámegia bálügüdaha luagu niri? Aba labiniruni wügüri ligía ñein.<verse eid="GEN 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 32:30" />Aba láchuni Hakobu fulasu ligía Penueli, ladüga lariñagun:</para>
  <para style="p" vid="GEN 32:30">—Ariha naali Bungiu igibu luma igibu lau sun lira wínwangidina.<verse eid="GEN 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 32:31" />Láfuriduña Hakobu Penueligiñe ligía láfuachun weyu, adamaheina liñati lárigi ladiliragun liranaagua. <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />Ligía chülǘ lubéi lumoun dan le, meigin hamuti ladügawagun Hakobu iranaaguaü ladüga labuleseirun ñein lun Hakobu.<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s1">Harandarun Hakobu luma Esaú</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />Dan le larihinbei Hakobu anitén lan Esaú hau gádürü-san wügüriña, aba lafanreinraguniña irahüñü tun Lía tuma Rakeli hama bián lubúaligu, <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />aba líchuguniña idamuni furumiñe hau harahüñü, lárigiñe Lía hau tirahüñü, agumuhóuni Rakeli luma Hosé. <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />Aba lidin Hakobu habá, aba labuluchagun darí ladagarun lerebe múarugu sedü wéiyaasu ligibugiñe líbugaña darí lachülürün yarafa lun. <verse eid="GEN 33:3" /><verse number="4" style="v" sid="GEN 33:4" />Aba léibaagun Esaú lubaroun; aba lóuburuni, aba lachuuruni. Aba hayahun hagía biángubei. <verse eid="GEN 33:4" /><verse number="5" style="v" sid="GEN 33:5" />Aba larihiniña Esaú würiña hama irahüñü, aba lálügüdahan:</para>
  <para style="p" vid="GEN 33:5">—Angia ha, kátañagia?</para>
  <para style="p" vid="GEN 33:5">Lariñaga Hakobu lun:</para>
  <para style="p" vid="GEN 33:5">—Isaanigu ha líchugubaña Bungiu lun bubuein.<verse eid="GEN 33:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 33:6" />Ábati hayabin idamuni hau harahüñü, aba habuluchagun darí ladagarun herebe múarugu; <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />lárigiñe aba tiabin Lía hau tirahüñü aba giñe hadügüni ligiaméme, agumuhóuni liabin Hosé tuma Rakeli aba giñe hadügüni ligiaméme.<verse eid="GEN 33:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 33:8" />Sódini aba lariñagun Esaú:</para>
  <para style="p" vid="GEN 33:8">—Ka baritagubei badügün hau sun animaalu ha úmabaña nadunragua?</para>
  <para style="p" vid="GEN 33:8">Aba lóunabun Hakobu:</para>
  <para style="p" vid="GEN 33:8">—Lun nagañeiruni bugundan hau.<verse eid="GEN 33:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 33:9" />Lariñaga Esaú lun:</para>
  <para style="p" vid="GEN 33:9">—Uá, namulen, añahein giñe saragu numa. Rédeiba lau le bani.<verse eid="GEN 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 33:10" />Aba lagiribuhan Hakobu luma, lariñaga lun:</para>
  <para style="p" vid="GEN 33:10">—Uá, anhein gañei naali lubéi bugundan, resibibéi idewesei le, ladüga narihinibu nigibugiñe, ítara liña nun kamá hamuga Bungiu guánarügü narihubei, ladüga buiti beresibirunina. <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />Amuriahatina buma lun beresibiruni idewesei le níchugubei bun, rísigüda láadina Bungiu, úati nemegeirun.</para>
  <para style="p" vid="GEN 33:11">Gíbeti lagiribuhan Hakobu, darí lun lanügüni Esaú idewesei ligía.<verse eid="GEN 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 33:12" />Lariñagati:</para>
  <para style="p" vid="GEN 33:12">—Keimoun yáagiñe néibuga bubá bubá.<verse eid="GEN 33:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 33:13" />Lariñaga Hakobu lun:</para>
  <para style="p" vid="GEN 33:13">—Níbugaña, subudi bumuti luagu débili hamá irahüñü luagu giñe gasu lan nasaminarun hawagu mudún hama bágasu hau harahüñü, anhein abuchada hawagu, gayaraabei hóunwegun sun mudún ha lidan aban weyu. <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />Buítimati lun bidin nubá; nídinme hámaru hámaru úara hama animaalugu ha nubá nubaabaña, úara giñe hama irahüñü darime wóundarun buma Seirü.<verse eid="GEN 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 33:15" />Lariñaga Esaú lun:</para>
  <para style="p" vid="GEN 33:15">—Anha, nígira hádangiñe wügüriña ha ñǘbuinbaña numa bun.</para>
  <para style="p" vid="GEN 33:15">Aba lóunabuni Hakobu:</para>
  <para style="p" vid="GEN 33:15">—Uá, madiheribá.<verse eid="GEN 33:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 33:16" />Aba lagiribudun Esaú lidoun fulasu le Seirü weyuméme ligía. <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />Ánheinti Hakobu, aba lidin Sukotun, aba ladügün aban muna ñein lubarua tuma aban houn libiñanigu. Ligía láchubalin fulasu ligía Sukotu.<verse eid="GEN 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18" />Dan le liábinbei Hakobu Padán-aramügiñe, chülüti lau magadiñein lóubawagun Kanán aba lemeraagun ligibugiñe uburugu le Sikemü. <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />Aba lagañeihan aban fulasu hámagiñe lirahüñü Amoru, le lúguchi Sikemü luagu san murusun pülata, aba líchugunu likianpun ñein. <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />Lárigiñe, aba ladügün aban latarü aba láchuni Eli-Eloé-Ísüraeli.<verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s1">Láguragunu Sikemü Dina</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />Aba tidin Dina to tiráü Lía lau Hakobu ebeluha hamoun würiña irahüñü ha lílana fulasu ligía, <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />gama lumoun aba larihinu Sikemü le liráü Amoru le Eweuna, le ábuti lidan fulasu ligía, aba lafosurunu lun tarounrun luma. <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />Gama lumoun aba tínsiñedun lun saragu, aba louchun lagañeiruni tínsiñehabu. <verse eid="GEN 34:3" /><verse number="4" style="v" sid="GEN 34:4" />Ábati ladimurehan luma Amoru le lúguchi, lariñaga lun:</para>
  <para style="p" vid="GEN 34:4">—Beiba Amuriahei túhabu irahü to nun. Busentina namarieidun tuma.<verse eid="GEN 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 34:5" />Aba lasubudiruni Hakobu luagu lafosurunu Sikemü Dina to liráü lun tarounrun luma, gama lumoun kei añahein lubéi buga lirahüñü ha wügüriña áraabu habu habiñanigu, mariñagunti ni kata darí hagiribudun. <verse eid="GEN 34:5" /><verse number="6" style="v" sid="GEN 34:6" />Ábati lidin Amoru le lúguchi Sikemü arihei Hakobu lun ladimurehan luma. <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />Dan le hagiribudun lirahüñü Hakobu áraabugiñe, aba haganbuni le asuseredubei, aba hagañidun, ladüga aban lan busiganu wéiriti lun Hakobu larounrun Sikemü tuma liráü. Aban katei lira le moun lumuti yebe ladügǘn! <verse eid="GEN 34:7" /><verse number="8" style="v" sid="GEN 34:8" />Gama lumoun aba ladimurehan Amoru hama, lariñaga houn:</para>
  <para style="p" vid="GEN 34:8">—Wéiriti tínsiñe hitu lun niráü Sikemü; fulesei humana, ígira humoun lun tamarieidun luma, <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />ábame gaduheñugua humá wama; ábame gayara lan wamarieidun hama hirahüñü, huguyame hama warahüñü. <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />Redei humá aganawa wama. Anihán wageira le hadüga lidan, aganawa humá ya, hadaagua marasun, hagañeiha fulasu.<verse eid="GEN 34:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 34:11" />Lárigiñe aba lariñagun Sikemü lun túguchi Dina luma houn tíbugañanu:</para>
  <para style="p" vid="GEN 34:11">—Ayumuraguatina hun lun hánharun. Níchugubei le hamuriahan numa hun. <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />Meberesegúntina anhein íñubei lubéi le lunbei níchuguni tuagu, sügǘ lau le uágubei wéchuda, odi saragu lan idewesei, níchugubei hun, ígirarügü humaaru ligía würi to lun tamarieidun numa.<verse eid="GEN 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 34:13" />Keiti fosu laaru lan buga Sikemü Dina lun tarounrun luma, aba hóunabuni lirahüñü Hakobu Sikemü lau sun lúguchi lau iyeeni, <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />hariñaga houn:</para>
  <para style="p" vid="GEN 34:14">—Siñati wíchugunu watu lun aban wügüri le michugúnti seini tuagu lóustarun, ladüga busiganubei lira woun. <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />Ánhaüngubeirügü ítarada kei wagía, lun lichugún seini tuagu hóustarun súngubei wügüriña hidan. <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />Ítararügübei gayara lan hamarieidun hama warahüñü, maríei wagíame hama hirahüñü, ábame waganóun huma ábame aban wamá gürigia. <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />Gama lumoun anhaün máharun lun ítara luba lan, wóudiba yáagiñe barǘ wamounme watu.<verse eid="GEN 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 34:18" />Aba lánharun Amoru lau sun Sikemü le liráü lun le hariñagubei lirahüñü Hakobu. <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />Meferidirunga dan, aba líchugun Sikemü seini tuagu lóustarun ladüga wéiriti lan tínsiñe liráü Hakobu lun. Sikemü meha inebewatimabei hadan liduheñu Amoru le lúguchi.<verse eid="GEN 34:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 34:20" />Aba lidin ligía luma Amoru le lúguchi luagun lubenari uburugu, le ñein lubéi burí ladaawagúa marasun, aba hariñagun houn lílana fulasu:<verse eid="GEN 34:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 34:21" />—Wügüriña ha, wamadagu, haganóuba lidan fulasu le, adaagua hagíame marasun ya, anihein saragu múa houn ya; gayaraabei wamarieidun hama harahüñü, hagíame amarieida hama warahüñü. <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />Gama lumoun lun ábanmemebadiwa lan gürigia, ánhatiña lun haganóun wadan, gama lumoun gasu lichugún seini tuagu hóustarun sun wügüriña ha wádanbaña ítara kei hagía. <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />Sun hamegen, sun habiñanigu, wánibaña. Lérügüñein lunbei wadügüni, wariñagun houn, “Anha”. Ábame herederun aganawa wadan.<verse eid="GEN 34:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 34:24" />Aba hánharun sun wügüriña ha lílana uburugu ha gayaraahalibei hasudarahan, aba hánharun lun le lubeibei Sikemü luma lúguchi aba lichugún seini tuagu hóustarun. <verse eid="GEN 34:24" /><verse number="25" style="v" sid="GEN 34:25" />Aba liabin Simeón luma Lewí, lirahüñü Hakobu, tátinu Dina, ǘrüwa weyu lárigiñe, dan le gárigili lárigi lichugún seini tuagu hóustarun wügüriña hagía, aba háfaraguniña sun hagía tau eféin, deregüdagu hagía habá. <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />Aba háfaruni Amoru lau sun Sikemü tau eféin, aba hasagarunu Dina lúbiñegiñe Sikemü, aba houdin. <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />Aba giñe hachülürün híbiri lirahüñü Hakobu, aba hásügürün hagibuagugiñe hilaguaaña, aba hanügüni le hadarirun fulasurugu, lun haguburahani tibusigari hatu.<verse eid="GEN 34:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 34:28" />Barütiña mudún, bágasu, burigü luma sun le ñeinbei uburugu luma áraabu; <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />íweruha hamuti sun le burí tídanbei muna barǘ hamaña sun irahüñü hama würiña. <verse eid="GEN 34:29" /><verse number="30" style="v" sid="GEN 34:30" />Ábati lariñagun Hakobu lun Simeón luma Lewí:</para>
  <para style="p" vid="GEN 34:30">—Ru humaadina lidoun turobuli. Guentó neyereeguduba houn lílana fulasu le, Kananna hama Féresüna. Hóundaraguba ábame hábürühan nuagun, keiti mibe habéi nuwügüriñanigu, háfaraguaadiwa hau sun waduheñu.<verse eid="GEN 34:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 34:31" />Hariñaga lun:</para>
  <para style="p" vid="GEN 34:31">—Kámeti liabin óuseroun watu kei aban horu?<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s1">Labiniruni Bungiu Hakobu Beteli</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />Lariñaga Bungiu lun Hakobu:</para>
  <para style="p" vid="GEN 35:1">—Saraba, beiba aganawa Beteli. Badügame aban latarü lidan fulasu ligía lun Bungiu le meha arufudagubei lungua bun dan le banurahanbei luéi bíbugaña Esaú.<verse eid="GEN 35:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 35:2" />Ábati lariñagun Hakobu houn liduheñu hama sun ha úarabaña luma:</para>
  <para style="p" vid="GEN 35:2">—Sagá humaña sun búngiugu terenchatiña ha húmabaña, hágawa, ábame hasansirunu hadaüragun Sikemü. <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />Keimoun Beteli furese; nadügüba aban latarü ñein lun Bungiu le íderagubalina lidan buga nidiheri, le giñe ñǘdünhalibei le ñein lumuti nidin.<verse eid="GEN 35:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 35:4" />Aba hederegeruniña sun guáriua terenchatiña lun Hakobu tuma burí arigeilaü to luáguboun harigei, aba lábununi Hakobu sun le tábugiñe aban tídibu wewe gíritu ensina to yarafaboun lun Sikemü. <verse eid="GEN 35:4" /><verse number="5" style="v" sid="GEN 35:5" />Dan le háfuridunbei, aba ladügün Bungiu lun hanufudedagun sun gürigia ha lídanbaña fulasu ligía, ligíati méibaahanhabaniña lirahüñü Hakobu.<verse eid="GEN 35:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 35:6" />Aba lachülürün Hakobu hau sun gürigia ha lúmabaña lidoun uburugu Lusu le giñe gíribei Beteli, le lumúanrugubei Kanán. <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />Aba ladügün aban latarü ñein, aba láchuni fulasu ligía Beteli ladüga ñein meha larufudagua Bungiu lungua lun dan le meha lanurahanbei luéi líbugaña. <verse eid="GEN 35:7" /><verse number="8" style="v" sid="GEN 35:8" />Ñein giñe tounwe Débora to meha würi to óunigirubarun Rebeka, aba hábununu tábugiñe aban tídibu wewe to ensina yarafa lun Beteli. Aba láchuni Hakobu fulasu ligía «Lani Ayahuahani Ensina».<verse eid="GEN 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9" />Dan le lagiribudunbei Hakobu Padán-aramügiñe, ábaya larufudagun Bungiu lungua lun, aba labiniruni, <verse eid="GEN 35:9" /><verse number="10" style="v" sid="GEN 35:10" />ariñageina:</para>
  <para style="b" vid="GEN 35:10" />
  <para style="q" vid="GEN 35:10">«Hakobu bíribei,</para>
  <para style="q" vid="GEN 35:10">gama lumoun mámaalime ligía biri;</para>
  <para style="q" vid="GEN 35:10">lúmagiñe guentó Ísüraeli ligíaba biri».</para>
  <para style="b" vid="GEN 35:10" />
  <para style="p" vid="GEN 35:10">Lárigiñe lasansiruni Bungiu liri Hakobu, <verse eid="GEN 35:10" /><verse number="11" style="v" sid="GEN 35:11" />aba lariñagun lun:</para>
  <para style="b" vid="GEN 35:11" />
  <para style="q" vid="GEN 35:11">«Au Búngiubei le Suntigabafu.</para>
  <para style="q" vid="GEN 35:11">Gibe hamá birahüñü<optbreak /> hama badügawagun.</para>
  <para style="q" vid="GEN 35:11">Hayabinba aban néchani bídangiñe hama saragu gürigia,</para>
  <para style="q" vid="GEN 35:11">añaheinbaña urúeigu<optbreak /> hadan badügawagun.<verse eid="GEN 35:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="GEN 35:12" />Múa le níchugubei lun Abüraámü luma lun Isaakü,</para>
  <para style="q" vid="GEN 35:12">ru numuti giñe bun,</para>
  <para style="q" vid="GEN 35:12">bárigiñeme, ábame níchuguni<optbreak /> houn badügawagun».<verse eid="GEN 35:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="GEN 35:13" />Dan le lidin Bungiu lídangiñe fulasu le ñein lubéi ladimureha luma Hakobu, <verse eid="GEN 35:13" /><verse number="14" style="v" sid="GEN 35:14" />aba lanügün Hakobu aban dübü aba líchuguni kei aban seini lidan fulasu le ñein lubéi buga ladimureha Bungiu lun, aba lanúadiruni lun Bungiu lau láhurudaguni lau garaba tuma diwéin, <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />aba líchugun liri fulasu ligía Beteli.<verse eid="GEN 35:15" /></para>
  <para style="s1">Tounwen Rakeli</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />Lárigiñe aba houdin Beteligiñe, dan le díseraügiña luéi Éfürata aba tágurahan Rakeli; gama lumoun hénrenguti tágurahan. <verse eid="GEN 35:16" /><verse number="17" style="v" sid="GEN 35:17" />Lidan oura létima lénrengun aba tariñagun ágüdahatu tun:</para>
  <para style="p" vid="GEN 35:17">—Manufudedabá, garaüyaadibu aban eyeri irahü.<verse eid="GEN 35:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 35:18" />Gama lumoun tuguya yarafaaru buga lun tounwen, lidan lagumuhóun tawaragun, aba tíchugun liri irahü ligía: Benoní,<note caller="4" style="f"><char style="fr" closed="false">35.18 </char><char style="ft" closed="false">Benoní lidan Ebüréu ítarayuma liña lasounurun kei liráü nirun o kei liráü nidiheri.</char></note> ánheinti lúguchi aba líchugun Benhamín<note caller="5" style="f"><char style="fr" closed="false">35.18 </char><char style="ft" closed="false">Benhamín lidan Ebüréu ítarayuma liña lasounurun kei liráü nóunwenren o kei isaani hímeiwati o kei liráü nere.</char></note> luagu.<verse eid="GEN 35:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 35:19" />Ítara liña tounwen Rakeli, aba hábununu luagu lémeri Éfürata, le Belén guentó. <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />Aba líchugun Hakobu aban seini luagu tumuaha, ligíati seini le arufudubalin tumuaha Rakeli guentó.<note caller="6" style="f"><char style="fr" closed="false">35.20 </char><char style="ft" closed="false">Guentó, mini lan lira, darí dan le tabürüdǘnbei líburu to.</char></note> <verse eid="GEN 35:20" /><verse number="21" style="v" sid="GEN 35:21" />Aba lasigiruni Hakobu lémeri aba lerederagun yagürounmeme luéi luayelesin Éderü.<verse eid="GEN 35:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 35:22" />Luagu aban weyu, dan le laganóunbei Hakobu lidan fulasu ligía, aba lidin Rubén aba larounrun tuma Bilá to lúmari lúguchi. Dan le lasubudirunbalin Hakobu, aba lagañidun saragu.</para>
  <para style="s1" vid="GEN 35:22">Lirahüñü Hakobu</para>
  <para style="p" vid="GEN 35:22">Dúusuñanu buga lirahüñü Hakobu. <verse eid="GEN 35:22" /><verse number="23" style="v" sid="GEN 35:23" />Ha lirahüñü tau Lia; Rubén le íbugañaü, Simeón, Lewí, Hudá, Isakárü luma Sabulón. <verse eid="GEN 35:23" /><verse number="24" style="v" sid="GEN 35:24" />Lirahüñü tau Rakeli Hosé luma Benhamín. <verse eid="GEN 35:24" /><verse number="25" style="v" sid="GEN 35:25" />Lirahüñü tau Bilá, to tidamun Rakeli, Dan luma Nefütalí; <verse eid="GEN 35:25" /><verse number="26" style="v" sid="GEN 35:26" />lirahüñü tau Silüpá, to tidamun Lía, Gadü luma Aserü. Añahán lirahüñübaña Hakobu ha águrahoubaña Padán-aramü.<verse eid="GEN 35:26" /></para>
  <para style="s1">Lounwen Isaakü</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />Aba lidin Hakobu arihei Isaakü le lúguchi, lidan fulasu le Mamüré, uburugu lememe giñe gíribei Arübá o Ebürón. Aganawaali meha Abüraámü ñein luma Isaakü, <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />san-gádürü-wein irumu labagaridun Isaakü. <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />Lidan irumudiri le lounwe aba lidin óundara hama lagüchagu dan le hilaali, aba lábununi Esaú luma Hakobu ha lirahüñü.<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s1">Ladügawagun Esaú</para>
  <para style="r">(<ref loc="1CH 1:34-54">1 Kro 1.34-54</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />Añahán ladügawagun Esaú, lememe Edomu. <verse eid="GEN 36:1" /><verse number="2" style="v" sid="GEN 36:2" />Aba lamarieidun Esaú hama würiña Kananna: Tuma Adá, to liráü Elón le Étüna; tuma Aulibáma tiráü Ana libari Sibón le Eweuna; <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />tuma giñe Basemátü, liráü Ísümaeli, litu Nebaiotu. <verse eid="GEN 36:3" /><verse number="4" style="v" sid="GEN 36:4" />Elifási, ligía tiraübei Adá lau Esaú; aba tagaraüdüni Basemátü Reueli, <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />aba tagaraüdüniña Aulibáma Heusu, Haalamü luma Koré. Añahán lirahüñübaña Esaú ha águrahoubaña dan le laganóunbei lóubawagu Kanán.<verse eid="GEN 36:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 36:6" />Aba lanügüniña Esaú lúmarigu, lirahüñü, hama sun ha aganóubaña luma, aba lidin lidoun amu fulasu lun ladisedun luéi Hakobu le lamulen. Aba lanügüniña sun libiñanigu luma sun lumegen le ladügübei ñein Kanán, <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />ladüga gíbeyati hámati biángubei hagía darí lun siñá lan herederun lidan aban; fulasuti le ñein lubéi haganawa lóuguati lun heigin habiñanigu ñein. <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />Ligía lídinbei Esaú lememe Edomu aganawa lidan dabíara le lóubawagubei Seirü.<verse eid="GEN 36:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 36:9" />Añahán ladügawagun Esaú, le hagücha Edomuna ha meha aganóubaña lidan dabíara le lóubawagubei Seirü. <verse eid="GEN 36:9" /><verse number="10" style="v" sid="GEN 36:10" />Anihán hiri lirahüñü Esaú: Elifási tiráü Adá lau Esaú, luma Reueli, tiráü Basemátü lau Esaú. <verse eid="GEN 36:10" /><verse number="11" style="v" sid="GEN 36:11" />Lirahüñü Elifási: Temán, Omarü, Sefó, Gatamü luma Kenasi. <verse eid="GEN 36:11" /><verse number="12" style="v" sid="GEN 36:12" />Anurein meha aban lúmari Elifási gíritu Timüná; garaütu aban irahü lau gíriti Amalékü. Añahán meha tadügawagun Adá, aban hádangiñe lúmarigu Esaú. <verse eid="GEN 36:12" /><verse number="13" style="v" sid="GEN 36:13" />Lirahüñü Reueli: Naatü, Sera, Samá, Misá; añahán tadügawagunbaña Basemátü, aban hádangiñe lúmarigu Esaú.<verse eid="GEN 36:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 36:14" />Aulibáma tuguya giñe aban lúmari Esaú añahán tirahüñü lau: Heusu, Haalamü, Koré. Liráü meha Aná tuguya, libari Sibón.<verse eid="GEN 36:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 36:15" />Añahán ábutigu hadan ladügawagun Esaú: Ábutigu hadan ladügawagun Elifási le íbugañaü hadan lirahüñü Esaú: Temán, Omarü, Sefó, Kenasi, <verse eid="GEN 36:15" /><verse number="16" style="v" sid="GEN 36:16" />Koré, Gatamü luma Amalékü. Hagía ábutigubaña hadan ladügawagun Elifási lidan lumúan Edomu, sun hagía tadügawagunbaña Adá.<verse eid="GEN 36:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 36:17" />Ábutigu hadan lirahüñü Reueli le liráü Esaú: Naatü, Sera, Samá Misá. Hagía ábutigubaña hadan ladügawagun Reueli lidan lumúan Edomu, tadügawagun Basemátü hagía to lúmari Esaú.<verse eid="GEN 36:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 36:18" />Ábutigu hadan tirahüñü Aulibáma to tiráü Ana, lúmari Esaú: Heusu, Haalamü, luma Koré. <verse eid="GEN 36:18" /><verse number="19" style="v" sid="GEN 36:19" />Ladügawagun Esaú lememe Edomu sun hagía, hábutigu giñe hani türibu.<verse eid="GEN 36:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 36:20" />Lirahüñü Seirü le Óruna, ha meha aganóubaña lidan oubaü ligía: Lotán, Sobali, Sibón, Aná, <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />Disón, Éserü, Disán. Hagía meha hábutigubaña Óruna, ha ladügawagun Seirü, lidan lumúan Edomu.<verse eid="GEN 36:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 36:22" />Lirahüñü Lotán: Orí luma Emamü. Timüná litu Lotán.<verse eid="GEN 36:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 36:23" />Lirahüñü Sobali: Alübán, Manaatü, Ebali, Sefó luma Onamü.<verse eid="GEN 36:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 36:24" />Lirahüñü Sibón: Ayá luma Aná. Aná, ligía adarirubei lísensen duna lidan fulasu mageirawati dan le lóunigiruniña burigü ha lilügüniña Sibón le lúguchi. <verse eid="GEN 36:24" /><verse number="25" style="v" sid="GEN 36:25" />Garaüti Aná aban wügüri irahü gíriti Disón, tuma aban würi irahü gíritu Aulibáma. <verse eid="GEN 36:25" /><verse number="26" style="v" sid="GEN 36:26" />Lirahüñü Disón: Emüdán, Esübán, Itürán luma Kerán.<verse eid="GEN 36:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 36:27" />Lirahüñü Éserü: Bilán, Saawán luma Akán.<verse eid="GEN 36:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 36:28" />Lirahüñü Disán: Usu luma Arán.<verse eid="GEN 36:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 36:29" />Hábutigu Óruna: Lotán, Sobali, Sibón, Aná, <verse eid="GEN 36:29" /><verse number="30" style="v" sid="GEN 36:30" />Disón, Éserü, Disán. Hagía hábutigubaña Óruna lidan lumúan Seirü, iduheñu hawagu iduheñu.<verse eid="GEN 36:30" /></para>
  <para style="s1">Lurúeitegu Edomu</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 36:31" />Añahán meha urúeigu ha agumadihabaña Edomu, lubaragiñe meha garúeite hamá Ísüraelina. <verse eid="GEN 36:31" /><verse number="32" style="v" sid="GEN 36:32" />Bela, le meha liráü Beoru, urúei meha Edomu, Dinaba líribei luburugute. <verse eid="GEN 36:32" /><verse number="33" style="v" sid="GEN 36:33" />Danbei lounwen Bela, aba larúeihan Hobabü le liráü Sera le lídangiñebei fulasu le gíribei Bosurá. <verse eid="GEN 36:33" /><verse number="34" style="v" sid="GEN 36:34" />Danbei lounwen Hobabü, leweñegua aba lagumadihan Usamü, lóubawaguna Temán. <verse eid="GEN 36:34" /><verse number="35" style="v" sid="GEN 36:35" />Danbei lounwen Usamü, leweñegua, aba lagumadihan Adadü le liráü Bedadü, le áfarahabalin Madián lidan láraabute Moabü; Awitü líribei luburugute. <verse eid="GEN 36:35" /><verse number="36" style="v" sid="GEN 36:36" />Danbei lounwen Adadü, leweñegua, aba lagumadihan Samülá le Masürekána. <verse eid="GEN 36:36" /><verse number="37" style="v" sid="GEN 36:37" />Danbei lounwen Samülá, leweñegua, aba lagumadihan Saulu, le lídangiñebei Reobotu, fulasu le lárubei duna. <verse eid="GEN 36:37" /><verse number="38" style="v" sid="GEN 36:38" />Danbei lounwen Saulu, aba lagumadihan Baali-anán le liráü Akübóru leweñegua. <verse eid="GEN 36:38" /><verse number="39" style="v" sid="GEN 36:39" />Danbei lounwen Baali-anán, aba lagumadihan Adadü leweñegua; Pau líribei luburugute. Meetawéli tíribei lúmari, liráü Matürédi, libari Mesaabü.<verse eid="GEN 36:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 36:40" />Anihán híribei ábutigu hadan lánigu Esaú, hawagu iduheñu, luagu fulasu luma luagu iri: Timüná, Aliwá, Hetetü, <verse eid="GEN 36:40" /><verse number="41" style="v" sid="GEN 36:41" />Aulibáma, Elá, Pinón, <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />Kenasi, Temán, Mibüsárü, <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />Magüdiéli luma Iramü. Edomu giñe meha líribei Esaú, añahán ábutigubaña lun Edomu, según burí fulasu le ñein lubéi haganawa lememe hafulasun.<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />Aba lerederun Hakobu aganawa lóubawagu Kanán, le ñein lubéi meha laganawa lúguchi luagu átiri dan. <verse eid="GEN 37:1" /><verse number="2" style="v" sid="GEN 37:2" />Anihán asusereduti hawaguti liduheñu Hakobu.</para>
  <para style="s1" vid="GEN 37:2">Hosé hama líbugañanu</para>
  <para style="p" vid="GEN 37:2">Dan le meha ábangili nibureinti disedüti irumu Hosé, ábaha lóunigiruniña mudún úara hama líbugañanu, ha tirahüñü Bilá hama tirahüñü Silüpá, würiña ha lubúaligu lúguchi. Ábatiha lariñahani Hosé hiri líbugañanu lun háguchi luagu luriban hóuseruni.<verse eid="GEN 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 37:3" />Hínsiñeti meha Hosé lun Hakobu sügǘ hau ha híbiri lirahüñü, ladüga dan le wéiyaali lagaraüdǘwa. Ligía ladügünbei aban ligounun wéndetu. <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />Dan le hasubudirunbalin líbugañanu luagu hínsiñe lan lun háguchi sügǘ hau sun hagía, aba liyereegudun houn, mabusurungubeitiñaha lun.<verse eid="GEN 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5" />Luagu aban weyu, aba gewenedü lan Hosé aban uénedü, aba labahüdaguni houn líbugañanu; ábatima liyereegudun houn <verse eid="GEN 37:5" /><verse number="6" style="v" sid="GEN 37:6" />ladüga lariñagun houn:</para>
  <para style="p" vid="GEN 37:6">—Aganba humana, nabahüdaguaali nuénedü hun. <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />Gewenedütina sun lan nege wagía áraabuñadiwa adaagua güraguati türigu; sódini aba liñuragun nagüragun lungua aba lerederun suruñu, liabin buriti le hani güraguati aba legeyedagun lau le nani, aba labuluchagun súngubei lau inebesei.<verse eid="GEN 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 37:8" />Aba hóunabuni líbugañanu:</para>
  <para style="p" vid="GEN 37:8">—Bariñaguñati lau lira luagu warúeitebadibu lan, luagu giñe bagumadirubadiwa lan?</para>
  <para style="p" vid="GEN 37:8">Ábatimati liyereegudun houn luéigiñe luénedü luma luagu ligaburi labahüdaguni houn.<verse eid="GEN 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 37:9" />Lárigiñe ábaya gewenedü lan Hosé ábanya uénedü, ábaya giñe labahüdaguni houn líbugañanu. Lariñaga houn:</para>
  <para style="p" vid="GEN 37:9">—Ariha humá san, gewenedüyatina aban uénedü, aba narihini weyu, hati hama unsu waruguma abuluchagua íchiga inebesei nun.<verse eid="GEN 37:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 37:10" />Dan labahüdaguni Hosé uénedü le lun lúguchi hama líbugañanu, aba ladeinhan lúguchi lun, lariñaga lun:</para>
  <para style="p" vid="GEN 37:10">—Kagia mini ban lau uénedü le buénedübei? Gasu funagia wabuluchagun búguchu, bíbugañanu, nabu bigibugiñe?<verse eid="GEN 37:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 37:11" />Gimugatiñati líbugañanu lun, ánheinti lúguchi gíbeti lasaminarun luagun katei le.<verse eid="GEN 37:11" /></para>
  <para style="s1">Haluguruni líbugañanu Hosé, Hosé</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />Luagu aban weyu, aba houdin líbugañanu Hosé Sikemü áluaha éigini houn lilügüniña háguchi mudún. <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />Lariñagati Hakobu lun Hosé:</para>
  <para style="p" vid="GEN 37:13">—Añahein bíbugañanu Sikemü óunigiraña mudún. Busentina lun bidin arihaña.</para>
  <para style="p" vid="GEN 37:13">Aba lóunabun Hosé:</para>
  <para style="p" vid="GEN 37:13">—Nídiba lau sun nugundan.<verse eid="GEN 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 37:14" />Lariñagati Hakobu:</para>
  <para style="p" vid="GEN 37:14">—Beiba bariheime ida haña lan bíbugañanu habu mudún, ábame bagiribudun lau uganu nun.</para>
  <para style="p" vid="GEN 37:14">Aba lóunahani Hakobu Hosé lúmagiñe fulasu wayati le gíribei Ebürón, dan le lachülürün Hosé Sikemü, <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />aba layuridagun áraabu. Ábati ladunragun aban wügüri luma, aba lálügüdüni:</para>
  <para style="p" vid="GEN 37:15">—Ka báluahabei?<verse eid="GEN 37:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 37:16" />Aba lóunabuni Hosé:</para>
  <para style="p" vid="GEN 37:16">—Náluahañanu níbugañanu, gayaraati hamuga san bariñaguni nun halía lan hóunigiraña mudún?<verse eid="GEN 37:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 37:17" />Lariñaga lun:</para>
  <para style="p" vid="GEN 37:17">—Ñǘdünha yáagiñe, aganbatina hariñagun luagu héibuga lan Dotán.</para>
  <para style="p" vid="GEN 37:17">Aba lidin Hosé hárigi líbugañanu, aba ladariruniña Dotán. <verse eid="GEN 37:17" /><verse number="18" style="v" sid="GEN 37:18" />Aba harihini dísegiñe dan le liabin, aba heledegun lubá lun háfaruni hilagubei. <verse eid="GEN 37:18" /><verse number="19" style="v" sid="GEN 37:19" />Aba hariñagun hámagua:</para>
  <para style="p" vid="GEN 37:19">—Ariha humá, anitén labureme uénedü! <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />Higougu, áfara waméi hilagubei; lárigiñeme ábame wíchuguni lidoun aban fusu, wariñagame luagu houla lan aban animaalu áraabuna. Warihameti kaba lan asusereda lau burí luénedü!<verse eid="GEN 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 37:21" />Dan laganbuni Rubén katei le, aba labusenrun lun lesefuruni Hosé hawéi líbugañanu, aba lariñagun:</para>
  <para style="p" vid="GEN 37:21">—Máfara waméi. <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />Máwiyuragüda humá hitaü. Chü huméi lidoun fusu, le lídanbei fulasu mageirawati, gama lumoun máfara huméi.</para>
  <para style="p" vid="GEN 37:22">Lariñagunbei Rubén ítara, lun lesefuruni Hosé, óunaha láamugei lárigoun lun lúguchi. <verse eid="GEN 37:22" /><verse number="23" style="v" sid="GEN 37:23" />Dan le lachülürünbei Hosé le ñeinhin habéi líbugañanu, aba hagidarunu ligounun luéi, <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />aba hárügüdüni, aba háguruni lidoun fusu ligía, málati fusu ligía, mábeiti giñe. <verse eid="GEN 37:24" /><verse number="25" style="v" sid="GEN 37:25" />Lárigiñe aba hañuurun eiga. Sódini aba harihin saragu Ísümaelina hayabiña Galaadügiñe, barüina haña ibiñein burí hawagu halügüniña kameyu, bálüsamu, mira lun hanügüni Ehiptun. <verse eid="GEN 37:25" /><verse number="26" style="v" sid="GEN 37:26" />Ábati lariñagun Hudá houn líbirigu:</para>
  <para style="p" vid="GEN 37:26">—Ka wagañeiruña lau wáfaruni wamulen, lárigiñeme waramudei lounwen? <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />Lubaragiñe wáfaruni, aluguragubei waméi houn Ísümaelina; ladüga lárigiñe sun katei wamulentia.</para>
  <para style="p" vid="GEN 37:27">Aba hánharun líbirigu lun le lariñagubei. <verse eid="GEN 37:27" /><verse number="28" style="v" sid="GEN 37:28" />Dan le hásügürünbei Madianna ha alugurahabaña ñéingiñe, aba hasagaruni Hosé lídangiñe fusu, aba haluguruni houn Ísümaelina luagu wein murusun pülata. Ítara liña hanügüni Hosé Ehiptun.<verse eid="GEN 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 37:29" />Dan lagiribudunbei Rubén luagun fusu, kei madarirunlani Hosé lidan fusu, aba laheiridagunu ladaüragun le ligarigu. <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />Aba lagiribudun le ñeinhin habéi líbirigu, lariñaga houn:</para>
  <para style="p" vid="GEN 37:30">—Úaali Hosé lidan fusu! Kábati nadüga guentó?<verse eid="GEN 37:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 37:31" />Ábati hanügünu ligounun Hosé, aba hadaseirunu lau lita aban gábara le háfarubei; <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />aba hóunahanu lun háguchi lau uganu le:</para>
  <para style="p" vid="GEN 37:32">—Anuhán wadarirun. Arihabóun buidu anhein ligounun tubéi biráü, lumoun mama lan tuguya.<verse eid="GEN 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 37:33" />Dan le larihinbarun Hakobu, aba lariñagun:</para>
  <para style="p" vid="GEN 37:33">—Tuguya, ligounun niráü! Áfarala somu animaalu áraabuna, houla!<verse eid="GEN 37:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 37:34" />Ábati laheiridagunu Hakobu ladaüragun aba ladaürün ludu, aba lamuiserun lárigi liráü; ayahuaha lumuti lounwen liráü luagu átiri dan. <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />Hóuchatiña yebe sun lirahüñü wügüriña hama würiña lun hámalihani, gama lumoun máhati lámalihoun; lubaragiñe lira ayahuaharügü ligíaha lárigi liráü, lariñaga:</para>
  <para style="p" vid="GEN 37:35">—Namuisera lárigi niráü, darime nidin adunragua luma hadan hilaaña.<verse eid="GEN 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 37:36" />Aba haluguruni Madianna Hosé Ehiptu, lun aban wügüri gíriti Potifárü, hábuti lisudaranigu urúei Ehiptuna.<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s1">Hudá tuma Tamarü</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />Lidan dan ligía, aba ladisedun Hudá hawéi líbirigu, aba lidin aganawa lúbiñe aban wügüri gíriti Ira, lídangiñeti fulasu le gíribei Adulámü. <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />Ñein lasubudiroun liráü aban Kananna gíriti Sua, aba lamarieidun tuma. Dan le lóundarun tumoun, <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />aba tadageinadun, aba tagaraüdün aban irahü, aba tíchugun Erü luagu. <verse eid="GEN 38:3" /><verse number="4" style="v" sid="GEN 38:4" />Ábaya tadageinadun, aba tagaraüdün ábaya wügüri irahü, aba tíchugun Onán luagu. <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />Ábaya tagaraüdün ábaya wügüri irahü, aba tíchugun Sela luagu, dan le lágurahounbei Sela, Kesibüñein Hudá.<verse eid="GEN 38:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 38:6" />Aba lamarieidagüdüni Hudá Erü, le íbugañaü hadan lirahüñü tuma aban würi gíritu Tamarü. <verse eid="GEN 38:6" /><verse number="7" style="v" sid="GEN 38:7" />Gama lumoun magundanti Bungiu lau luriban lóuserun Erü, aba lagidaruni libagari. <verse eid="GEN 38:7" /><verse number="8" style="v" sid="GEN 38:8" />Ábati lariñagun Hudá lun Onán:</para>
  <para style="p" vid="GEN 38:8">—Aganawabá tuma lúmari meha finóu bíbugaña gúnfuli báamuga keisi uguñouni, gadügawagun láamuga bíbugaña bídangiñe.<verse eid="GEN 38:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 38:9" />Gama lumoun subudi lumuti Onán luagu anhoun lan agaraüda würi to lau, manügǘnbaña lan irahüñü hagía kei lirahüñü. Ságütiha lagamaridunu lúmari meha líbugaña, louchun lun lígiragüdün múarugun lun madageinadun tan, lun madügawagun lan líbugaña lídangiñe. <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />Aba giñe magundan lan Bungiu lau katei le ladügübei Onán, aba giñe lagidaruni libagari. <verse eid="GEN 38:10" /><verse number="11" style="v" sid="GEN 38:11" />Ábati lariñagun Hudá tun Tamarü:</para>
  <para style="p" vid="GEN 38:11">—Rédeiba kei aban würi hilaali túmari lúbiñe búguchi, darí laweiridun Sela le niráü.</para>
  <para style="p" vid="GEN 38:11">Lidan linarün katei, haritaguati Hudá luagu gayara lan giñe lounwen Sela kei líbugañanu. Ábati tidin Tamarü aganawa lúbiñe túguchi.<verse eid="GEN 38:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 38:12" />Dan luagun dan aba tounwen lúmari Hudá, to liráü Sua. Lárigiñe lágurun Hudá ludu, aba lidin lidan aban fulasu le gíribei Timünátü, le ñein habéi ha ásahabaliña halügüniña mudún, aba lidin Ira le Adulámüna le lumada luma. <verse eid="GEN 38:12" /><verse number="13" style="v" sid="GEN 38:13" />Dan le tasubudirunbalin Tamarü luagu aningira lan tímedamuru Timünátü lun hasarún lilügüniña mudún, <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />aba taragachunu tadaüragun to hadaüragun würiña hilaguaaña úmari aba tadaürün aban belu lun ibidiñewa tan, aba tañuurun luagu lubenari fulasu le Enaimü le luágubei lémeri Timünátü. Tadügünbalin le, ladüga wéirihali lan buga Sela, mamarieidagüdün hamutu luma.<verse eid="GEN 38:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 38:15" />Dan le larihinbarun Hudá, aba laritagun luagu aban lan horu, ladüga darugu liña lau tigibu. <verse eid="GEN 38:15" /><verse number="16" style="v" sid="GEN 38:16" />Ábati liabin tuagun, ibidiñounga lun luagu lídiñu tan, aba lariñagun tun:</para>
  <para style="p" vid="GEN 38:16">—Gayaraati narounrun buma?</para>
  <para style="p" vid="GEN 38:16">Aba tálügüdüni:</para>
  <para style="p" vid="GEN 38:16">—Kábagia bíchiga nun luagu barounrun numa?<verse eid="GEN 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 38:17" />Lariñaga tun:</para>
  <para style="p" vid="GEN 38:17">—Nóunahaba aban hádangiñe yégüniña gábara bun.</para>
  <para style="p" vid="GEN 38:17">Tariñaga lun:</para>
  <para style="p" vid="GEN 38:17">—Anha, gama lumoun ígiraba somu katei le bani nun kei seini luagu bagararaaguayaba lan, darí bóunahani gábara nun.<verse eid="GEN 38:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 38:18" />Aba lálügüdünu:</para>
  <para style="p" vid="GEN 38:18">—Kagia babusenrubei nígirun bun?</para>
  <para style="p" vid="GEN 38:18">Aba tóunabuni:</para>
  <para style="p" vid="GEN 38:18">—Rubei biseyun lau lagürüga nun luma badun le búhaburugubei.</para>
  <para style="p" vid="GEN 38:18">Aba líchuguni Hudá tun, aba larounrun tuma, aba tadageinadun. <verse eid="GEN 38:18" /><verse number="19" style="v" sid="GEN 38:19" />Lárigiñe aba tidin Tamarü agidaroun belu to buga tuáguboun, ábaya tadaürünu tadaüragun to hadaüragun würiña ha hilaguaaña úmari.<verse eid="GEN 38:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 38:20" />Aba lóunahani Hudá gábara luma lumada le Adulámüna, lun tóunahani würi tuguya liseyun lau lubadun lun lárigoun; gama lumoun madarirun laaru lumada würi tuguya. <verse eid="GEN 38:20" /><verse number="21" style="v" sid="GEN 38:21" />Ábati lariñagun houn wügüriña ha lílana fulasu ligía:</para>
  <para style="p" vid="GEN 38:21">—Hagóun san horu to Enaimüna to buga láruboun üma?</para>
  <para style="p" vid="GEN 38:21">Aba hóunabuni:</para>
  <para style="p" vid="GEN 38:21">—Úagiru ni aban horu ya.<verse eid="GEN 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 38:22" />Ábati lagiribudun le ñeinhin lubéi Hudá, lariñaga lun:</para>
  <para style="p" vid="GEN 38:22">—Madari numutu würi tuguya, ariñagatiña giñe wügüriña ha ñéinbaña nun luagu úagiru lan ni aban horu ñein.<verse eid="GEN 38:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 38:23" />Aba lóunabun Hudá:</para>
  <para style="p" vid="GEN 38:23">—Rédeita lau ílagu, ua hamaamuga adügütiña bula wau, au óunaha numuti yebe gábara, gama lumoun madari bumutu.<verse eid="GEN 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 38:24" />Kei burí ǘrüwa hati lárigiñe, aba hayabin ariñaga lun Hudá:</para>
  <para style="p" vid="GEN 38:24">—Róunharu bídiñu hama amu wügüriña, ladüga dageinañoun.</para>
  <para style="p" vid="GEN 38:24">Aba lagúaragun Hudá:</para>
  <para style="p" vid="GEN 38:24">—Sagá humóun, gudá humóun!<verse eid="GEN 38:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 38:25" />Gama lumoun dan le añahán lubéi asagaroun, aba tóunahan ariñaga lun tímedamuru: «Le labureme ílagu le, ligía adageinadagüdübalina. Arihabéi ka lan laburemebei seyu lau lagürüga luma badun le». <verse eid="GEN 38:25" /><verse number="26" style="v" sid="GEN 38:26" />Dan le larihinbalin Hudá ílagu, aba lariñagun:</para>
  <para style="p" vid="GEN 38:26">—Richatu sügǘ nau ladüga mamarieidagüdün numutu luma Sela le niráü.</para>
  <para style="p" vid="GEN 38:26">Aba marounrundigiaali lan tuma.<verse eid="GEN 38:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 38:27" />Dan le tágurahanbei Tamarü, aba hayabin mádounu tun. <verse eid="GEN 38:27" /><verse number="28" style="v" sid="GEN 38:28" />Lídanbei hágurahoun, aba lasagaruni aban hádangiñe lúhabu. Aba tagüürün ágüdahatu aban filu funati luagu lúhabu, aba tariñagun:</para>
  <para style="p" vid="GEN 38:28">—Anihán áfuridubei furumiñe.<verse eid="GEN 38:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 38:29" />Gama lumoun lidan oura ligía ábaya lebelaagüdüni lúhabu, aba láfuridun líbugaña furumiñe. Ligía tíchugunbei ágüdahatu Fáresi luagu, tariñaga:</para>
  <para style="p" vid="GEN 38:29">—Daraadibu üma bubarua!<verse eid="GEN 38:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 38:30" />Lárigiñe aba láfuridun le aban, le buga gawagubalin filu funati luagu lúhabu, aba tíchugun Sera lírime.<verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s1">Hosé tuma lúmari Potifárü</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />Dan le lanügǘnbei Hosé Ehiptun, aba lagañeihani aban Ehiptuna gíriti Potifárü hámagiñe Ísümaelina<note caller="7" style="f"><char style="fr" closed="false">39.1 </char><char style="ft" closed="false">Ísümaelina hagiaméme ha únbaña laguarúa Madianna.</char></note> ha anügübalin ñeinhin. Potifárü, ligía hábutibei lisudaran urúei Ehiptuna. <verse eid="GEN 39:1" /><verse number="2" style="v" sid="GEN 39:2" />Gama lumoun anirein Bungiu luma Hosé, buítiti lidin lun sun aniha lan aganawa lúbiñe Ehiptuna le liyubudiri. <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />Aba larihin liyubudiri Hosé luagu anihein lan Bungiu luma Hosé, luagu giñe adüga lan lun buidu lan lidin lun lidan sun katei. <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />Ligía línsiñedunbei Hosé lun liyubudiri, aba líchuguni lun ligía lan ariha tau muna, rulei sun katei lábugiñoun laríaahan. <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />Lúmagiñe weyu le líchugunbalin Potifárü Hosé lun larihin tau luban luma sun lumegen, aba labiniruni Bungiu wügüri Ehiptuna ligía dandu lúbiñe keisi áraabu. <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />Lau lóunigirunu Hosé luban Potifárü lau sun lumegen, meberesegúnhali lau ni kata luéidigia lun leigin. Keiti magadiñe lan Hosé, ani hínsiñeguti, <verse eid="GEN 39:6" /><verse number="7" style="v" sid="GEN 39:7" />átiri lubeiti dan lárigiñe, aba línsiñedun tun lúmari liyubudiri, aba tariñagun lun luagu aban weyu:</para>
  <para style="p" vid="GEN 39:7">—Rounba numa.<verse eid="GEN 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 39:8" />Gama lumoun máhati Hosé, aba lóunabunu:</para>
  <para style="p" vid="GEN 39:8">—Ru laali niyubudiri sun lúmati lábugiñoun naríaahan, lau anaha lan ya, madiheriti ni ka uagu. <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />Úati ni aban wéiriguti nuéi tidan muna to; mamahanti niyubudiri lau ni kata nun, luéidigia bau, ladüga lúmari buguya; siñati lubeiti nadügün aban katei wuribati ítara lun nafigouhan ligibugiñe Bungiu.<verse eid="GEN 39:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 39:10" />Lau sun tagiribuhan luma Hosé sagü weyu lun larounrun tuma, meberesegúnti tau. <verse eid="GEN 39:10" /><verse number="11" style="v" sid="GEN 39:11" />Gama lumoun luagu aban weyu aba lebelurun Hosé múnadoun lun ladügüni luadigimari, keiti málouga lubéi ñein, <verse eid="GEN 39:11" /><verse number="12" style="v" sid="GEN 39:12" />aba tárügüdüni tuéigiñe ladaüragun, tariñaga lun:</para>
  <para style="p" vid="GEN 39:12">—Rounba numa.</para>
  <para style="p" vid="GEN 39:12">Aba láfuridun éibaagueina aba terederun ladaüragun túhaburugu. <verse eid="GEN 39:12" /><verse number="13" style="v" sid="GEN 39:13" />Dan le tarihin luagu ígiralanu ladaüragun túhaburugu lidan láfuridun, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />aba tagúarun houn musu ha tánina muna, tariñaga houn:</para>
  <para style="p" vid="GEN 39:14">—Barühali númari aban ebüréu ñahoun, anihánti adaagua bula wau. Aba lebelurun arihana, aba yebe labusenrun larounrun numa, aba nagúaragun here; <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />keiti laganbun nagúaragun lau sun nere, aba láfuridun éibaagueina ígiraloun ladaüragun ya.<verse eid="GEN 39:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 39:16" />Aba tareidunu ladaüragun Hosé, darí lachülürün liyubudiri múnadoun. <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />Ábati tabahüdaguni lememe buga tariñagubei houn musu, lun túmari, tariñaga:</para>
  <para style="p" vid="GEN 39:17">—Aba lebelurun idamuni ebüréu le banügübei woun nirumunrugun, aba labusenrun lafosurunina lun narounrun luma. <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />Gama lumoun dan le nagúaragunbei lau sun nere, aba láfuridun éibaagueina ígira ladaüragun ya. <verse eid="GEN 39:18" /><verse number="19" style="v" sid="GEN 39:19" />Ítara liña lóuserunina bidamun.</para>
  <para style="p" vid="GEN 39:19">Aba lagañidun liyubudiri Hosé saragu dan le laganbuni le tabahüdagubei lúmari lun. <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />Ábati lárügüdüni Hosé, aba ladaürüni furisunrugu, le ñein habéi ladaüragüdün urúei. Gama lumoun lau sun furisunruguñein lan Hosé, <verse eid="GEN 39:20" /><verse number="21" style="v" sid="GEN 39:21" />ñeinñein Bungiu luma; aba lóuseruni lau areini, aba ladügün lun línsiñedun lun tábuti furisun, <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />aba lígiruniña sun adaürǘtiña lábugiñe laríaahan. Ábati Hosé lan íchiga dimurei luagu sun le lunbei ladügǘn ñein. <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />Memegeiruntiha tábuti furisun lun laríaahan ni kata lídangiñe le lábugiñebei laríaahan Hosé, ladüga anihein Bungiu luma, ani adügati lun lasalirun sun katei lun buidu.<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s1">Lariñaguni Hosé lanichigu bián uénedü</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />Lárigiñe le, aba liabin le eseriwihabarun diwéin lúbiñe urúei luma le adaagubei fein, aba hadügün katei le auti magundan lan hayubudiri, le lurúeite Ehiptu. <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />Aba lagañidun urúei hama biángubei hagía, hábuti eseriwihatiña diwéin luma hábuti adaagutiña fein, <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />aba ladaürüniña lúbiñe hábuti súdaragu, le ñein tubéi furisun. Ligiaméme fulasu le ñein lubéi ladaürǘwa Hosé. <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />Aba líchuguni hábuti súdara Hosé lun ligía lan ariha hau, aba herederun biángubei hagía saragu dan furisunrugu.<verse eid="GEN 40:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 40:5" />Luagu aban áriebu aba gewenedü hamá adaürǘtiña hagía, eseriwihati diwéin luma adaaguti fein aban uénedü kada aban, kada uénedü lau lanichigu. <verse eid="GEN 40:5" /><verse number="6" style="v" sid="GEN 40:6" />Dan le liabin Hosé arihaña binaafin, aba ladariruniña lau idiheri. <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />Ábati lálügüdüniña:</para>
  <para style="p" vid="GEN 40:7">—Ka uagu luribanbei higibu uguñe?<verse eid="GEN 40:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 40:8" />Aba hóunabuni:</para>
  <para style="p" vid="GEN 40:8">—Gewenedütiwa aban uénedü, ani úati kaba lan ariñagei lanichigu woun.</para>
  <para style="p" vid="GEN 40:8">Aba lálügüdüniña Hosé:</para>
  <para style="p" vid="GEN 40:8">—Ma funagia Bungiu íchugubalin lanichigu katei? Abahüdagua huméi huénedü nun.<verse eid="GEN 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 40:9" />Ábati labahüdaguni hábuti eseriwihatiña diwéin luénedü lun Hosé, lariñaga lun:</para>
  <para style="p" vid="GEN 40:9">—Gewenedütina ñeinñein lan aban lídibu beibei nigibugiñe. <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />Ñeinñein ǘrüwa limu luagu ídibu ligía, kei lilumadun, ítara legelewehan, aba lasaliragun lílewe lun béibeime to funaaru. <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />Ñéinñeinti likopun urúei numa núhaburugu, ábati nanügüni beibei, aba naribichaguni lidoun kopu. Lárigiñe aba níchuguni kopu lun urúei lúhaburugun.<verse eid="GEN 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 40:12" />Lariñaga Hosé lun:</para>
  <para style="p" vid="GEN 40:12">—Anihán mini lan buénedü: Ǘrüwa limu ligía, ǘrüwa weyu, <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />ǘrüwa weyu lárigiñe le larihubei urúei Ehiptuna bikesin ábame líchugunibu urúei bárigoun lidoun buadigimari, ábayame bíchaahani likopun urúei lun kei meha badügüni. <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />Danme lasuseredun ítara, baritaguame nuagun, badügame fulesei nun, badimurehame lun urúei lun lasagarunina lídangiñe fulasu le. Gudemená bun! <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />Au íweruhouarügütina hageiragiñe ebüréugu, ani moun lumuti yebe anahein lan furisunrugu, ladüga madügüntina ni kata wuribati.<verse eid="GEN 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 40:16" />Dan le larihinbalin hábuti adaagutiña fein luagu luáguñein lan lufulesein lanichigu uénedü le líchugubei Hosé, aba lariñagun lun:</para>
  <para style="p" vid="GEN 40:16">—Au gewenedütina luagu ñeinñoun lan ǘrüwa faniñe fein harutu nábulugu. <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />Lidan faniñe le íñugiñebei, ñeinñoun sun tuwuyeri fein lun urúei, gama lumoun aba burí hayabin dunuru eiga lídangiñe faniñe le nábulugubei.<verse eid="GEN 40:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 40:18" />Ábati lóunabuni Hosé:</para>
  <para style="p" vid="GEN 40:18">—Anihán mini lan buénedü: Ǘrüwa faniñe ligía, ǘrüwa weyu, <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />ani ǘrüwa weyu lárigiñe le larihubei urúei Ehiptuna bikesin ábame ladibiragüdünibu urúei luagu aban tídibu wewe, ábame héiginibu dunuru.<verse eid="GEN 40:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 40:20" />Ǘrüwa weyu lárigiñe ligía lagunfulirun urúei irumu, aba ladügün aban óunwenbu fedu houn nadagimeintiña luma. Hagibugiñe lamisurahan aba lóunahan asagarei hábuti eseriwihatiña diwéin luma hábuti adaagutiña fein. <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />Aba líchuguni eseriwihati diwéin lárigoun lidoun luadigimari ábaya líchaahani kopu lun urúei kei meha furumiñe; <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />gama lumoun aba lóunahan átigiragüdei le adaagubei fein, kei buga lariñaguni Hosé. <verse eid="GEN 40:22" /><verse number="23" style="v" sid="GEN 40:23" />Gama lumoun maritagunhali buga eseriwihati diwéin luagun Hosé.<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s1">Lariñaguni Hosé lanichigu luénedü urúei</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />Aba lásügürün bián irumu. Luagu aban weyu aba gewenedü lan urúei rara liña lan laru duna le gíribei Nilu, <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />aba háfuridun sedü bágasu dibunetiña ani buíduburitiña dúnarugugiñe, aba heigin híduru labadinagua maburu. <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />Hárigi aba háfuridun sedü bágasu wuribatiña ani dúreitiña dúnarugugiñe, aba hararamun laru duna harugabu ha buga híbiri. <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />Lárigiñe aba héiginiña bágasu ha dúreibaña ha dibunebaña.</para>
  <para style="p" vid="GEN 41:4">Aba lagagudun urúei. <verse eid="GEN 41:4" /><verse number="5" style="v" sid="GEN 41:5" />Gama lumoun ábaya larumugun urúei, ábaya gewenedü lan larihin sedü lugule türigu ma lubuidun burí ginti giñe, gama lumoun sédügubei luáguñein ábanmeme ugudinaü. <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />Lárigiñe aba liabin sedü limu mábeiti churá laali ligarabalin nuru, <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />aba léigini limu le minbei sedü le ginbei.</para>
  <para style="p" vid="GEN 41:7">Aba lagagudun urúei, aba lasubudiragun lungua luagu luénedü lan. <verse eid="GEN 41:7" /><verse number="8" style="v" sid="GEN 41:8" />Gama lumoun larugan binaafin lauñein idiheri, aba lóunahan hawagu sun garíaahatiña hama chu tau ha Ehiptubaña. Dan le labahüdaguni urúei luénedü houn, úati ni aban gayara lumuti lanichigu ariñaga lun. <verse eid="GEN 41:8" /><verse number="9" style="v" sid="GEN 41:9" />Ábati lariñagun hábuti eseriwihatiña diwéin lun urúei:</para>
  <para style="p" vid="GEN 41:9">—Haritaguaadina luagu adügaadina lan wuribati. <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />Dan meha le hagañidunbei numa labu luma hábuti adaagutiña fein, aba hóunahaniwa tidoun lufurisun hábuti óunigirutiña. <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />Luagu aban áriebu, aba gewenedü lan hábuti adaagutiña fein aban uénedü, gewenedü au aban, kada uénedü lau lanichigu lungua. <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />Ñein furisunrugu, ñeinñein aban wügüri nibureingili wama ebüréu, lumusun hábuti óunigirutiña. Aba wabahüdaguni wawenedü lun, aba lariñaguni lanichigu woun. <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />Aba lasuseredun ítara kei lariñaguni woun! Au aba nagiribudun nárigoun lidoun nuadigimari, le aban aba látigiruniwa.<verse eid="GEN 41:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14" />Aba lóunaagüdün urúei luagu Hosé, aba hasagaruni furese furisunrugúgiñe, aba lasarúniwa, sánsigua ligía, aba lidin lun urúei. <verse eid="GEN 41:14" /><verse number="15" style="v" sid="GEN 41:15" />Lariñagati urúei lun:</para>
  <para style="p" vid="GEN 41:15">—Gewenedütina aban uénedü, ani úati ni aban ariñaguti lanichigu nun; gama lumoun aganbaadina luagu dan lan le baganbun aban uénedü, gayara bani lanichigu asagara.<verse eid="GEN 41:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 41:16" />Lariñaga Hosé lun:</para>
  <para style="p" vid="GEN 41:16">—Mama nídanñein lira; gama lumoun lóunabubadün Bungiu warúeite luagu hufulesein.<verse eid="GEN 41:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 41:17" />Lariñaga urúei lun Hosé:</para>
  <para style="p" vid="GEN 41:17">—Lidan nuénedü raraníña laru duna le gíribei Nilu, <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />aba háfuridun sedü bágasu dibunetiña dúnarugugiñe ma habuidun burí, aba heigin sagadi labadinagua maburu. <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />Aba háfuridun sédüya bágasu hárigi ma hariban burí ma hadurein. Marihinñahagidina buga bágasu wuribaburitiña kei hagía lidan sun Ehiptu! <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />Aba héiginiña bágasu ha dúreibaña ha furumiñetiña sedü, ha buga dibunebaña, <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />gama lumoun lárigiñe héiginiña, menege lumuti luagu hóuhaña lan, dúreimemegiña kei buga lubaragiñe héiginiña. Aba nagagudún, <verse eid="GEN 41:21" /><verse number="22" style="v" sid="GEN 41:22" />gama lumoun ábaya narumugun, ábaya gewenedü nan labouchun sedü lugule türigu luagu ábanmeme ugudinaü, ma lubuidun burí, ginti. <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />Lárigi ábaya labouchun sédüya lugule mábeiti, bürüburiti churá laali ligarabalin nuru. <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />Aba léigini ugulei burí le mábeibei le buídumeraüburibei. Aba nabahüdaguni houn garíaahatiña, úati ni aban hádangiñe ariñaguti lanichigu nun.<verse eid="GEN 41:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 41:25" />Lariñagati Hosé lun urúei:</para>
  <para style="p" vid="GEN 41:25">—Biángubei uénedü le huénedübei urúei ábanmeme. Lariñaguñein Bungiu hun kaba lan ladüga. <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />Sedü bágasu buíduburitiña hagía sedü irumu, kéigubeirügü giñe sedü limu buíduburiti ligía, sedü giñe irumu, ábanmeme uénedü. <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />Sedü bágasu dúreitiña ha áfuridubaña hárigi ha dibunebaña, sedü giñe irumu; kéigubeirügü sedü limu mábeiti le churá laalibei ligarabalin nuru. Sédübei irumu lau ümi. <verse eid="GEN 41:27" /><verse number="28" style="v" sid="GEN 41:28" />Ítara liña kei nariñaguni hun urúei. Subudigüda laali Bungiu hun le lunbei ladügüni. <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />Liábinba sedü irumu lau saragu éigini lidan sun Ehiptu. <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />Lárigiñeme ábame liabin sedü irumu lau ümi. Úaañame aritagutiña luagun buga sedü irumu le gibe lubéi éigini Ehiptu, ladüga lañawarihabei ümi fulasu. <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />Wéiribei ümi le lunbei liabin darime lun merede lan lárigirugu liibe éigini le buga lubaabei. <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />Gewenedü lumuti warúeite ábanmeme uénedü bián wéiyaasu, ladüga anihein lidan Bungiu lun ladügüni katei le, ani ladügübei furese.<verse eid="GEN 41:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 41:33" />Buiti hamuga lubeiti lun lálugun warúeite aban wügüri le chu tau lun ligía lan gamanihari lau ageiraü. <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />Anihán le lunbei ladügüni warúeite: Óunaha laña warúeite agumadihatiña lun houdin lidan sun ageiraü Ehiptu lun hóundaruni seingü lídangiñe sun le alubahóuti Ehiptu lidan sedü irumu le lánina liibe éigini. <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />Lun hóundaraguni sun türigu le lánina irumu burí buiti le lunbei liabin, híchigeimeti lidan aban fulasu lábugiñe laríaahan warúeite, hareideime lidan burí uburugu lun héigagüdüniwa gürigia. <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />Ítara luba areidúañu lan türigu lun hageira, móunwegun hamaamuga gürigia halama lidan sedü irumu lau ümi le lunbei ñein lan Ehiptu.<verse eid="GEN 41:36" /></para>
  <para style="s1">Hosé kei gumadimati Ehiptu</para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />Gúndaati urúei hama sun lánigu lau le lubeibei Hosé, <verse eid="GEN 41:37" /><verse number="38" style="v" sid="GEN 41:38" />aba lubeiti lariñagun urúei houn:</para>
  <para style="p" vid="GEN 41:38">—Wadariruba funa san aban wügüri kei le, le lauti lani Bungiu sífiri?<verse eid="GEN 41:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 41:39" />Lariñagati lun Hosé:</para>
  <para style="p" vid="GEN 41:39">—Úati ni aban chu tau buéi, ladüga subudigüda laali Bungiu sun katei le bun. <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />Buguyaba gamanihari tau lúbaana narúeihan, sun lílana fulasu hóudiba lau le bubeibei. Áurügübei wéirigu buéi ladüga au lan urúeibei. <verse eid="GEN 41:40" /><verse number="41" style="v" sid="GEN 41:41" />Ru naadibu kei gumadan lidan sun Ehiptu. Dan lariñaguni urúei katei le.<verse eid="GEN 41:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 41:42" />Aba laragachuni lubagün le gawagubalin seyu lánina larúeihan, aba ladaürüni luagu Hosé. Aba lariñagun lun hadaüraguagüdüni tau daüguaü to tautu gamisa to fínutu, ani lun ladaürǘn aban iñari golu luagu ligiina. <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />Lárigiñe aba lawariragüdüniwa tidoun tubuidun-agei karü tárigiñe lugune urúei, aba líchugun lúrudu lun hagúarahan lubá lubá: «Ru humá üma!» Ítara liña lerederun Hosé gumadanme lidan sun Ehiptu. <verse eid="GEN 41:43" /><verse number="44" style="v" sid="GEN 41:44" />Lárigiñe, aba lariñagun urúei lun:</para>
  <para style="p" vid="GEN 41:44">—Lau sun au lan urúeibei, úati ni aban lun lánhingichun aban ifingaü lidan sun Ehiptu míchuga buguya üma.<verse eid="GEN 41:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 41:45" />Aba líchugun urúei liri Hosé le iri Ehiptuna: Safenátü-panéa, aba lamarieidagüdüni tuma Asenátü, to liráü Potifera le fádiri uburugu On. Ítara liña lerederun Hosé alidihei Ehiptu. <verse eid="GEN 41:45" /><verse number="46" style="v" sid="GEN 41:46" />Darandi meha irumu lau Hosé dan le hanügünbalin ligibugiñoun lurúeite Ehiptu. Aba lafanreinragun Hosé luma urúei, aba lagumeserun éibugei sun Ehiptu. <verse eid="GEN 41:46" /><verse number="47" style="v" sid="GEN 41:47" />Aba líchugun múa saragu éigini lidan sedü irumu le lidaani líbenouga éigini, <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />aba lóundaruni Hosé sun türigu le lídanbei sun Ehiptu lidan sedü irumu ligía, aba lareiduni lidan burí uburugu, ígiralei burí le abudahóubei lidan áraabu le burí yarafabei lun kada uburugu ñein. <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />Óundarati Hosé türigu kamá hamuga sagoun, le liibe. Gíbeyaali darí lun mamisurahan laali lan, siñá giñe labahüdǘn.<verse eid="GEN 41:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 41:50" />Lubaragiñebei lagumeserun lidaani ümi, garahüñüti Hosé bián irahüñü tau Asenátü to lúmari. <verse eid="GEN 41:50" /><verse number="51" style="v" sid="GEN 41:51" />Aba líchugun Manasési luagu furumiñeti, lariñaga:</para>
  <para style="p" vid="GEN 41:51">«Bulíeigüda laali Bungiu sun nasufurirun nun, bulíeigüda niduheñu». <verse eid="GEN 41:51" /><verse number="52" style="v" sid="GEN 41:52" />Aba líchugun Éfürain luagu le habiaman, lariñaga:</para>
  <para style="p" vid="GEN 41:52">«Garahüñügüda láadina Bungiu lidan ageiraü le ñein lubéi súfurihadina lan».<verse eid="GEN 41:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="GEN 41:53" />Aba lásügürün sedü irumu le lánina líbenouga Ehiptu, <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />aba lagumeserun sedü irumu le lánina ümi, kei buga lariñaguni Hosé. Aba ladagarun ilamaü lidan sun fulasu, Ehipturügüñein ñein lan éigini, <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" />danti le halamachunbei lílana Ehiptu, aba houdin amuriaha türigu luma urúei:</para>
  <para style="p" vid="GEN 41:55">—Lariñagati urúei houn sun Ehiptuna: Heiba lumoun Hosé, hadügeime le lubeibei hun.<verse eid="GEN 41:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 41:56" />Dan le laweiridagunbei ilamaü lidoun sun fulasu ligía, aba ladaarunu Hosé lagei türigu lun lalugurahan türigu houn Ehiptuna, ladüga, sagü dan aweirideinatima lan ilamaü. <verse eid="GEN 41:56" /><verse number="57" style="v" sid="GEN 41:57" />Ábati hayabin burí lídangiñe sun fulasu Ehiptu, agañeiha luma Hosé, ladüga ua lan éigini lidan amu fulasu.<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s1">Houdin líbugañanu Hosé Ehiptu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />Dan le lasubudirunbalin Hakobu luagu anihein lan türigu Ehiptu, aba lariñagun houn lirahüñü:</para>
  <para style="p" vid="GEN 42:1">—Ka uagu heredera aríagua huouguoun? <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" />Aganbaadina luagu anihein lan türigu Ehiptu. Heiba ñein agañeiha humaamuga türigu woungua gayara láamuga gabagarimeme wamá.<verse eid="GEN 42:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 42:3" />Ábati Houdin diisi hádangiñe líbugañanu Hosé Ehiptu agañeiha türigu, <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />gama lumoun mígirunti Hakobu lun lidin Benhamín le lamulen Hosé, luéi giñe lasuseredun somu katei wuribati lun. <verse eid="GEN 42:4" /><verse number="5" style="v" sid="GEN 42:5" />Aba houdin lirahüñü Hakobu haganagua amu ha burí giñe ñǘdünbaña agañeiha, ladüga ñeinñein lan ilamaü lidan sun lumúan Kanán.<verse eid="GEN 42:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 42:6" />Hosé méhati gumadanbei lidan sun ageiraü ligía, ligía giñe alugurahabei türigu houn gürigia ha ñǘbuinbaña lídangiñe amu burí fulasu. Dan le hachülürünbei líbugañanu Hosé ligibugiñe, aba habuluchagun darí ladagarun herebe múarugu. <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />Subudigubei lumutiñati Hosé líbugañanu larihinbaliña, gama lumoun aba ladügün kamá ibidiñetiña lun, aba lariñagun houn lau éregu:</para>
  <para style="p" vid="GEN 42:7">—Huguyati! Halíagiñe hiabin?</para>
  <para style="p" vid="GEN 42:7">Hariñaga lun:</para>
  <para style="p" vid="GEN 42:7">—Kanangiñe wayabin, agañeiha türigu.<verse eid="GEN 42:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 42:8" />Lau sun subudi lániña Hosé líbugañanu, hagía masubudirun hamuti. <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" />Ábati laritagun Hosé luagu burí uénedü le luénedübei hawagu, lariñaga houn:</para>
  <para style="p" vid="GEN 42:9">—Aríaahatiña huguya. Hiábiña ariha ka lan louba fulasu débilibei.<verse eid="GEN 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 42:10" />Hariñaga lun:</para>
  <para style="p" vid="GEN 42:10">—Wagia wayabiña agañeiha türigu. <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />Lirahüñü ábanmeme gürigia sun wagía, gürigia úaraguatiña wagía. Meseriwidúngidiwa lun waríaahan fulasu.<verse eid="GEN 42:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 42:12" />Lariñaga Hosé houn:</para>
  <para style="p" vid="GEN 42:12">—Hiyeeni, hiábiña aríaahei ka lan louba fulasu débilibei.<verse eid="GEN 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 42:13" />Hóunabeiti:</para>
  <para style="p" vid="GEN 42:13">—Wagia dúusuñadiwa íbirigu lirahüñü ábanmeme úguchili, Kanán waganawa. Rédeiha buga wamulen le agumuhóuni luma wáguchi, anhein le aban hilá.<verse eid="GEN 42:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 42:14" />Lariñagaya Hosé houn:</para>
  <para style="p" vid="GEN 42:14">—Kei buga nariñaguni! Aríaahatiña fulasu huguya. <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />Wachoururaali guentó: Fiñutina hun luagu urúei luagu máfuridunbadün lan yáagiñe darí liabin hamulen le agumuhóuni. <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />Leiba aban hídangiñe anügei. Ha híbiri, heredera adaürǘwa. Warihali anhein hinarün lubéi le hariñagubei, anhein mama lubéi inarüni le hariñagubei, aríaahatiña huguya. Fiñutina luagu urúei!<verse eid="GEN 42:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 42:17" />Aba ladaürüniña Hosé sun hagía luagu ǘrüwa weyu, <verse eid="GEN 42:17" /><verse number="18" style="v" sid="GEN 42:18" />le lǘrüwan weyu, lariñaga houn:</para>
  <para style="p" vid="GEN 42:18">—Au inebeti Bungiu nun. Adüga huméi le, ábame ferudunawa lan hibagari: <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />Anhein hinarün lubéi luagu haruma humá, ígira humá aban hádangiñe híbirigu furisunrugu; ha híbiri, barǘ hamá türigu lun heigin hiduheñu. <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />Lárigiñeme ábame hanügüni hamulen le agumuhóuni nun, ariha wamaamugei anhein inarüni lubéi hariñagubei. Anhein mama lubéi liña, hóunweguba.</para>
  <para style="p" vid="GEN 42:20">Aba hánharun. <verse eid="GEN 42:20" /><verse number="21" style="v" sid="GEN 42:21" />Gama lumoun hariñaga burí hámagua:</para>
  <para style="p" vid="GEN 42:21">—Wuribati méhatia wadüga lun wamulen, madügüntiwa meha gasu lau dan le layumuragunbei woun lun gudeme lan woun, lau sun ariha wamani luagu nidiheri lan. Ligía liábinbei sun idiheri le woun guentó.<verse eid="GEN 42:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 42:22" />Lariñaga Rubén houn:</para>
  <para style="p" vid="GEN 42:22">—Ariñagatina meha hun lun madügün humá wuribati lun; gama lumoun madügüntün gasu nau, guentoti mósuti wafayeihan luagu lounwen.<verse eid="GEN 42:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 42:23" />Ibidiñetiti houn luagu gunfuranda lániña Hosé, ladüga lau lan aban gürigia gariñagaditi lun hererun ladimureha houn. <verse eid="GEN 42:23" /><verse number="24" style="v" sid="GEN 42:24" />Aba ladireirun Hosé hawéi, aba layahun. Dan lagiribudunyabei ñeinhin habéi, ani gayaraahali ladimurehan houn, aba lanügüni Simeón hawéi, aba lagüraguágüdüni hagibugiñe.<verse eid="GEN 42:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25" />Lárigiñe aba lariñagun lun tabuinchawagüdün hasagüte lau türigu, lun giñe lichugúniwa liseinsun kada aban tidoun lisagüte, luma lun lichugún éigini houn lun heigin ǘmada. Aba ladügǘniwa ítara. <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />Ábati hawariragüdüni türigu hawagun halügüniña burigü, aba houdin ñéingiñe. <verse eid="GEN 42:26" /><verse number="27" style="v" sid="GEN 42:27" />Dan hachülürün lidoun fulasu le ñeinba lubéi hásügürei áriebu, aba ladaarunu aban hádangiñe lisagüte lun líchugun éigini lun lilügün burigü, aba larihin luagu anihán lan liseinsun luagu tiyuma lisagüte. <verse eid="GEN 42:27" /><verse number="28" style="v" sid="GEN 42:28" />Ábati lariñagun houn líbirigu:</para>
  <para style="p" vid="GEN 42:28">—Ariha humá, águyugüdawa niseinsun nun! Anihán tidan nisagüte!</para>
  <para style="p" vid="GEN 42:28">Aba halouchun sun hagía, hariñagati hámagua lau anufudei:</para>
  <para style="p" vid="GEN 42:28">—Katei san le ladügübei Bungiu woun?<verse eid="GEN 42:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 42:29" />Dan hachülürün Kanán, aba habahüdaguni sun le asuseredubei houn lun Hakobu le háguchi, hariñaga lun:<verse eid="GEN 42:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 42:30" />—Gürigia le gumadanbei lidan fulasu ligía, adimurehati woun lau éregu, aba giñe lariñagun luagu keisi lan aríaahatiña woudin lageira. <verse eid="GEN 42:30" /><verse number="31" style="v" sid="GEN 42:31" />Wariñaga lun luagu gürigia lan harumatiña wagía, luagu mama wama aríaahatiña; <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />luagu dúusuñadiwa lan lirahüñü aban mutu; luagu úaali lan aban wádangiñe wama, le lan amuleñein rédeiha lan buma Kanán. <verse eid="GEN 42:32" /><verse number="33" style="v" sid="GEN 42:33" />Ábati lariñagun woun: “Narihaali anhein hinarün lubéi luagu haruma humá. Ígira humá aban hádangiñe híbirigu numa ya, hídinme íchiga murusun türigu houn hiduheñu, <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />gama lumoun hanügeime hamulen le agumuhóuni nun, afiñe náamuga luagu gürigia lan harumatiña huguya, mama humá aríaahatiña, ábameti nígiragüdüni le aban hibiri, gayaraahalimeti hidin ñeinhin lumuti habusenra lidan ageiraü le”.<verse eid="GEN 42:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 42:35" />Dan hachagaruni líbugañanu Hosé tila hasagüte, aba harihin luagu ñeinñein lan liseinsun kada aban tidan lisagüte tidan aban tiraüraü sagü. Dan harihinu tiraüraü sagü tuguya lau seinsu, dandu hagía kei háguchi, aba halouchun. <verse eid="GEN 42:35" /><verse number="36" style="v" sid="GEN 42:36" />Lariñagati Hakobu houn:</para>
  <para style="p" vid="GEN 42:36">—Hígiruñadina marahüñüga. Úaali Hosé wama, ni Simeón, guentó hagidarayaali Benhamín nuéi! Nuágunñein sun le!<verse eid="GEN 42:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 42:37" />Lariñagati Rubén lun lúguchi:</para>
  <para style="p" vid="GEN 42:37">—Ígirabei Benhamín lábugiñe naríaahan, nagiribudagüdübei bun. Anhein magiribudagüdün nan bun, báfaraguañame bián nirahüñü hilagubei.<verse eid="GEN 42:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 42:38" />Ábati lóunabun Hakobu:</para>
  <para style="p" vid="GEN 42:38">—Mídinbei niráü huma. Hilá Hosé le líbugaña ani ligíarügaali. Ánheindügü asusereda somu katei wuribati lun lidan wéiyaasu le lunbei hadügüni, huguyaba gadurun luagu lounwen wéiyaali le lau íruni.<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s1">Lanügǘniwa Benhamín Ehiptun</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />Ábatima laweiridagun ilamaü fulasurugu, <verse eid="GEN 43:1" /><verse number="2" style="v" sid="GEN 43:2" />lárigiñe lubeiti héigini Hakobu hau sun lirahüñü lagumuhóun türigu le erederubei lídangiñe le buga hanügübei Ehiptugiñe, lariñaga Hakobu houn:</para>
  <para style="p" vid="GEN 43:2">—Héibaya agañeiha türigu woungua.<verse eid="GEN 43:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 43:3" />Lariñaga Hudá lun:</para>
  <para style="p" vid="GEN 43:3">—Ariñagati meha wügüri ligía woun furangu: Anhein manügün humá hamulen le agumuhóuni ñahoun, miábingubei humá arihana. <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />Anhein lubeiti bígira lun lidin wama, wóudiba agañeiha türigu bun; <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />gama lumoun anhein mígirun ban, mídinbadiwa.<verse eid="GEN 43:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 43:6" />Lariñagati Hakobu:</para>
  <para style="p" vid="GEN 43:6">—Ka uagu hadüga saragu wuribani nun ítara? Kame san hariñaga lun gürigia ligía luagu aniheingua lan ábanya hamulen?<verse eid="GEN 43:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 43:7" />Ábati hóunabuni:</para>
  <para style="p" vid="GEN 43:7">—Ladüga lálügüdaguniwa saragu wawougua luma hawagu waduheñu. Lariñaga woun: “Gáguchigidün? Gamuletün amu?” Ábati wóunabuni luagu le uágubei lálügüdaha. Kábagia yebe wasubudira luagu labusenruba lan wanügüni wamulen lun?<verse eid="GEN 43:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 43:8" />Lariñaga Hudá lun Hakobu le lúguchi:</para>
  <para style="p" vid="GEN 43:8">—Anhein busenwabei wabagaridun, ígiraba lun lidin Benhamín lábugiñe naríaahan, ábame woudin. Ítara luba móunwegun wamá ni buguya, ni wagía ni warahüñü. <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />Auba óunaba luagu; auba afayeira bun luagu le asusereduti lun. Anhein magiribudagüdün nan bun lídanmeme fulasu le, auba gadurun bigibugiñe súnwandan. <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />Lun hamuga madarasahan wamá ya saragu, ñǘdünhadiwa hamuga bián wéiyaasu, giribuya.<verse eid="GEN 43:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 43:11" />Ábati lóunabun háguchi:</para>
  <para style="p" vid="GEN 43:11">—Kei ua lubéi amu árani, adüga huméi le: Barǘ humá idewesei lun wügüri ligía tidan hisagüte. Barǘ humá le lubuidun-agei katei le yaana fulasurugu lun: Murusun bálüsamu, murusun sírudu, mira, nuésesi, alüméndüra. <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />Barǘ humá giñe dóbuli seinsu, ábame hederegeruni seinsu le agiribudawagüdübei hun; háfuga bulíeiguaü. <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />Barǘ huméi hamulen, héibaya lumoun wügüri ligía. <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />Gudemegüdalaün Bungiu Suntigabafu lun, gayara láamuga lígiragüdüni le aban híbiri luma Benhamín. Ánheinti au, anhein lunti lubéi nerederun marahüñüga, nerederuba marahüñüga.<verse eid="GEN 43:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 43:15" />Aba hanügüni lirahüñü Hakobu idewesei, luma dóbuli seinsu, luma Benhamín, aba houdin Ehiptu. Dan hachülürün ligibugiñe Hosé, <verse eid="GEN 43:15" /><verse number="16" style="v" sid="GEN 43:16" />aba larihin Hosé luagu anihán lan Benhamín hama, aba lariñagun lun túniri luban:</para>
  <para style="p" vid="GEN 43:16">—Barübaña gürigia ha núbiñoun. Áfaraba aban bágasu, baranserounme, ladüga héigiba numa amidirugu le.<verse eid="GEN 43:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 43:17" />Aba ladügüni túniri muna kei lariñaguni Hosé lun, aba lanügüniña ligía guánarügü, <verse eid="GEN 43:17" /><verse number="18" style="v" sid="GEN 43:18" />gama lumoun hagía aba halouchun ladüga hanügǘn lúbiñoun Hosé, aba hariñagun hámagua:</para>
  <para style="p" vid="GEN 43:18">—Luéigiñetia seinsu le meha hagiribudagüdübei woun hanügawa ñahoun. Hábürüha wawagun, ábame hanügüniwa lun wawadigimaridun kei idamuni, úara hama walügüniña burigü.<verse eid="GEN 43:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 43:19" />Dan lubeiti hachülürün tubenari muna, aba hayabin lumoun túniri muna lun hadimurehan luma, <verse eid="GEN 43:19" /><verse number="20" style="v" sid="GEN 43:20" />hariñaga lun:</para>
  <para style="p" vid="GEN 43:20">—Arihabá san! Aba wayabin agañeiha türigu lügürabuga, <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />gama lumoun dan wachülürün lidan fulasu le ñeinba lubéi wásügürei áriebu, aba wadaarunu wasagüte, ñeinñein liseinsun kada aban luagu tiyuma lisagüte. Dayarüñu liña seinsu, barǘ wamutiti guentó lun wáguyugüdüni, <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />barütiwa giñe amu seinsu lun wagañeihan türigu. Gama lumoun ibidiñeti woun ka lan íchugubalin furumiñeti waseinsun tidoun wasagüte.<verse eid="GEN 43:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 43:23" />Aba lóunabun túniri muna:</para>
  <para style="p" vid="GEN 43:23">—Ragügua humá hungua, manufudeda humá. Mosu le lan Hubungiute, le giñe Lubungiute húguchi íchugubalin seinsu tidoun hisagüte, ladüga au, resibi numuti seinsu le hafayeirubei.</para>
  <para style="p" vid="GEN 43:23">Aba lasagaruni túniri muna Simeón, aba lanügüni ñeinhin habéi líbirigu; <verse eid="GEN 43:23" /><verse number="24" style="v" sid="GEN 43:24" />lárigiñe aba lanügüniña súngubei lúbiñoun Hosé, aba líchugun duna houn lun hachibuni hagudi, ru ligía éigini houn halügüniña burigü. <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />Aba haranseruni idewesei, aba hagurabun lachülürün Hosé amidirugu kei aganbaaña lubéi luagu ñeinba lan heiga lánina amidi. <verse eid="GEN 43:25" /><verse number="26" style="v" sid="GEN 43:26" />Dan lachülürün Hosé múnadoun, aba híchuguni idewesei le hanügübei lun, aba habuluchagun darí ladagarun herebe múarugu. <verse eid="GEN 43:26" /><verse number="27" style="v" sid="GEN 43:27" />Aba lálügüdüniña Hosé ida haña lan, aba giñe lariñagun houn:</para>
  <para style="p" vid="GEN 43:27">—Ida liñagia húguchi, weiriei mutu le uágubei hayanuha nun? Wínwangili?<verse eid="GEN 43:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 43:28" />Aba habuluchagun, aba hariñagun:</para>
  <para style="p" vid="GEN 43:28">—Anihein wáguchi, le hubúein, magadiñeti. Ani wínwangili.<verse eid="GEN 43:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 43:29" />Aba larihin Hosé geyegua lau, aba larihini Benhamín le lamulen le liráü lúguchi tau lúguchu, lariñaga:</para>
  <para style="p" vid="GEN 43:29">—Anihán san hamulen le agumuhóuni le uágubei hadimureha nun? Binilabu Bungiu, niráü!</para>
  <para style="p" vid="GEN 43:29">Dan lariñaguni Hosé lira, <verse eid="GEN 43:29" /><verse number="30" style="v" sid="GEN 43:30" />aba lasandiragun lungua lau ugundani lau larihini lamulen, aba labusenrun layahun. Aba lebelurun lirumunrugun, aba layahun. <verse eid="GEN 43:30" /><verse number="31" style="v" sid="GEN 43:31" />Dan rédeihali layahun, aba lachibuni ligibu, aba láfuridun, aba lariñagun:</para>
  <para style="p" vid="GEN 43:31">—Seriwi huméi éigini!<verse eid="GEN 43:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 43:32" />Aba heseriwiduni Hosé luagu aban dábula, lhoun líbirigu luagu amu, luáguya amu ha Ehiptuna háñaha éigibaña luma Hosé; ladüga máhawati lun heigin Ehiptuna hama ebüréugu. <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />Aba lañuuragüdüniña Hosé líbirigu según harumudiri, lúmagiñe íbugañaü lumoun amuleñein, wéirituti hanigi, aba haríagun hawouguoun. <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />Aba líchugun Hosé éigini houn lídangiñe le luágubei lidabulan, aba líchugun gíbetimati lun Benhamín luéi houn híbiri. Aba latun Hosé hama líbirigu darí lun hagundaarun.<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s1">Luerun Hosé</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />Lárigiñe le, aba lariñagun Hosé lun túniri luban:</para>
  <para style="p" vid="GEN 44:1">—Buíngüda humóun hasagüte gürigia ha lau sun türigu le hayaraati anüga, híchigeime liseinsun kada aban hádangiñe luagu tiyuma lisagüte. <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />Ru huméi giñe nuerun le pülata luagu tiyuma lisagüte le agumuhóuni úara luma seinsu le lafayeirubei luagu türigu.</para>
  <para style="p" vid="GEN 44:2">Aba ladügüni túniri muna le lariñagubei Hosé lun. <verse eid="GEN 44:2" /><verse number="3" style="v" sid="GEN 44:3" />Aba lóunahaniña Hosé líbirigu úara luma labouchun weyu, hau sun halügüniña burigü. <verse eid="GEN 44:3" /><verse number="4" style="v" sid="GEN 44:4" />Madisegiña luéi uburugu, ligía lariñagun Hosé lun túniri luban:</para>
  <para style="p" vid="GEN 44:4">—Beiba hárigi gürigia ha, danme bachülürün hamoun, bariñagame houn: “Kame hafayeira buiti lau wuribati? Kame híweruhei weru le pülata. <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />Le layusurubei niyubudiri lun latun luma lun legesihan? Wuribati hadüga!”<verse eid="GEN 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 44:6" />Dan lachülürün túniri muna hamoun aban láguyuguagüdüni dimureimeme le houn, <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />hariñaga lun:</para>
  <para style="p" vid="GEN 44:7">—Kame badimureha woun ítara? Madügündügüwabei katei le! <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />Anhein giribu wabéi Kanangiñe agiribudagüdei seinsu le wadarirubei tidan wasagüte, ida liña hamugagia wíweruhan pülata luma golu lúbiñegiñe babureme? <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />Hilala furumiñeguarügü wádangiñe le úmati ladarirúa weru ligía, redei wagíame hidamunme.<verse eid="GEN 44:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 44:10" />Ábati lariñagun túniri muna:</para>
  <para style="p" vid="GEN 44:10">—Ladügǘwa kei hariñaguni, gama lumoun lérügüba úmati ladarirúa weru eredera nidamunme; ha híbiri, madurunbaña.<verse eid="GEN 44:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 44:11" />Aba larariragüdünu kada aban hádangiñe lisagüte furese, aba ladaaragunu. <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />Aba láluahan túniri muna tidan kada sagü, lagumesera túmagiñe lisagüte íbugañaü darí tumoun lisagüte amuleñein, aba ladariruni weru tidan lisagüte Benhamín. <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />Ábati haheiridagunu hadaüragun lun larihín hagarigu. Aba híchuguni kada aban hanügün lanagawagun halügün burigü, aba hagiribudun uburugun.<verse eid="GEN 44:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 44:14" />Dan lachülürünbei Hudá hau líbirigu lúbiñoun Hosé, ñéingili. Ábati habuluchagun ligibugiñe darí ladagarun herebe múarugu, <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />sun anihán lan Hosé ariñaga houn:</para>
  <para style="p" vid="GEN 44:15">—Ka san hadügübei? Ibidiñeti san hun luagu garíaahadi nan?<verse eid="GEN 44:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 44:16" />Aba lóunabun Hudá:</para>
  <para style="p" vid="GEN 44:16">—Kábagia wóunabagüle bun? Ida lubagia warufuduni madurun wamá? Darí laadiwa Bungiu lidan figóu. Awanhán búhaburugu; bidamun wagía lau sun le buga gámabalin weru.<verse eid="GEN 44:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 44:17" />Lariñaga Hosé houn:</para>
  <para style="p" vid="GEN 44:17">—Mama luba. Lérügübei buga gámabalin weru nidamun. Ha híbiri gayaraati hagiribudun lúbiñoun húguchi darangilañu, mañawarihanbei ni aban hun.<verse eid="GEN 44:17" /></para>
  <para style="s1">Layumuragun Hudá luagu Benhamín</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />Ábati layarafadun Hudá lumoun Hosé, lariñaga lun:</para>
  <para style="p" vid="GEN 44:18">—Ayumuraguatina bun, lun bánharun lun nariñagun aban katei aramudaguati bun. Fuleseibana, magañidabátia numa, ladüga buguya kéigubeirügü urúei ban <verse eid="GEN 44:18" /><verse number="19" style="v" sid="GEN 44:19" />álügüda bumutiwa meha anhein gáguchi wabéi o anihein lan amu wamulen, <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />aba wóunabun luagu gáguchi wamá aban weiriei mutu, ani gamulen wamá aban ñǘraügili, le águrahoubei lidan lueiyan wáguchi. Ariñagatiwa giñe bun luagu weiri lan línsiñe wamulen ligía lun wáguchi, ladüga ligíarügüñein liráü erederuti lun hádangiñe tirahüñü aban hádangiñe lúmarigu, hilati le aban líbugaña. <verse eid="GEN 44:20" /><verse number="21" style="v" sid="GEN 44:21" />Ábati bariñagun woun lun wanügüni bun, ladüga busén ban basubudiruni. <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />Aba wariñagun bun luagu siñá lan lígiruni irahü ligía lúguchi, ladüga anhein lan ligira, lóunweba lan lúguchi. <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />Gama lumoun aba bariñagun woun luagu anhein lan miabin wama, meresibirun bubadiwa lan.<verse eid="GEN 44:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 44:24" />—Dan wagiribudun lumoun wáguchi, aba wabahüdaguni sun le bariñagubei woun lun. <verse eid="GEN 44:24" /><verse number="25" style="v" sid="GEN 44:25" />Lariñagati wáguchi woun: “Héibaya agañeiha murusun türigu”, <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />wariñaga lun: “Siñati woudin ánheingubeirügü ñüdün wamulen le agumuhóuni wama; ladüga anhein midin wama, siñabei warihini wügüri ligía”. <verse eid="GEN 44:26" /><verse number="27" style="v" sid="GEN 44:27" />Lariñaga núguchi woun: “Subusi humuti luagu garáü tan buga númari to úmaboun namarieida bián irahüñü nau; <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />aba lidin aban hádangiñe nuéi, ani lúmagiñe dan ligía marihin nágili. Chouru numuti luagu áfarala lan aban animaalu áraabuna. <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />Ánheinya hanüga le aban niráü nuéi, lasuseredame somu katei wuribati lun, huguyaba gadurun luagu láfarunina íruni”.<verse eid="GEN 44:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 44:30" />—Wéiriti lubeiti línsiñe irahü le lun núguchi, darí lun anhein lan magiribudún numa, <verse eid="GEN 44:30" /><verse number="31" style="v" sid="GEN 44:31" />lóunweba wáguchi danme marihin lani. Wagíabati gadurun lau láfaruni íruni wáguchi. <verse eid="GEN 44:31" /><verse number="32" style="v" sid="GEN 44:32" />Ariñagatina lun núguchi luagu nóunigirubei lan irahü le, ariñagatina giñe lun: “Anhein magiribudagüdün nan bun, auba gadurun bigibugiñe lun sun dan”. <verse eid="GEN 44:32" /><verse number="33" style="v" sid="GEN 44:33" />Ligía lubeiti nayumuragunbei bun, lun au lan eredera bidamunme leweñegua. Ígiraba lun lidin hama líbugañanu. <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />Ladüga, ida lubagia nagiribudun lun núguchi anhein midin irahü le numa? Mabusenruntina narihini wuribati le lunbei lasufuriruni núguchi.<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s1">Lasubudiraguagüdün Hosé lungua houn líbirigu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />Siñá lárügüdagun Hosé lungua hagibugiñe sun ha eseriwidubalin, aba lagúaragun:</para>
  <para style="p" vid="GEN 45:1">—Furí hamá súngubei yáagiñe!</para>
  <para style="p" vid="GEN 45:1">Úati lubeiti ni aban hádangiñe ha eseriwidubalin ñein dan le larufudagunbei lungua houn líbirigu. <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />Ábati layahun here darí lun hasubudiruni sun Ehiptuna, aba lachülürün uganu lúbiñoun urúei Ehiptuna. <verse eid="GEN 45:2" /><verse number="3" style="v" sid="GEN 45:3" />Aba lariñagun Hosé houn líbirigu:</para>
  <para style="p" vid="GEN 45:3">—Hosé au. Wínwangili san núguchi? Wéiriti halouchun líbirigu luagu añahán lan ligibugiñe, darí lun siñá lan hóunabuni.<verse eid="GEN 45:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 45:4" />Lariñaga Hosé houn:</para>
  <para style="p" vid="GEN 45:4">—Yarafa humá nun.</para>
  <para style="p" vid="GEN 45:4">Dan hayarafadunbei aba lariñagun houn:</para>
  <para style="p" vid="GEN 45:4">—Au Hosé le hamulen, le halugurubei lun Ehiptu; <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />gama lumoun madiherida humá magañidun huguyame húniwagua luéigiñe halugurunina, ladüga lóunahañadina buga Bungiu hubá lun nesefurun ibagari. <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />Biámaali irumu lau ilamaü fulasurugu, ani mégeigili seingü irumu lun malubahóun lan ni kata, íbini lábunawagun. <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />Gama lumoun óunaha lumutina Bungiu hubaragiñe, lun gayaraabei lan herederun hadügawagun ubouagu, lun giñe nesefuruni hibagari lidan aban igaburi le buíduti. <verse eid="GEN 45:7" /><verse number="8" style="v" sid="GEN 45:8" />Bungiu lubeiti óunahabalina lidoun fulasu le, mama huguya; ru laadina Bungiu kei eweridihati lun urúei kei giñe gamanihariti tau luban, ani kei giñe gumadan lidan sun Ehiptu.<verse eid="GEN 45:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 45:9" />—Heiba furese le ñein lubéi núguchi, hariñagame lun: “Ítara liña lariñagun Hosé le biráü: Ru laadina Bungiu kei labureme sun Ehiptu. Higabu arihana. Madarasahabá. <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />Baganóuba lóubawagu Gosén, hau birahüñü hama bibañan, hau sun bibiñanigu luma sun búmati. Ítara luba yarafañu ban nun. <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />Níchuguba éigini bun ñein, luma houn sun biduheñu, luma houn sun ha búmabaña, ua láamuga hemegeirun; ladüga mégeigili seingü irumu lau ilamaü”.<verse eid="GEN 45:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 45:12" />—Benhamín le namulen huma, gefentün luagu au guánarügü lan ariñagubalin le. <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />Abahüdagua humá lun núguchi luagu ubafu le nuágubei Ehiptu luma sun le ariha humaalibei ya. Heiba furese, anügei núguchi!<verse eid="GEN 45:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 45:14" />Aba lóuburuni Hosé Benhamín le lamulen, aba layahun. Aba giñe layahun Benhamín hóuburagu luma Hosé. <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />Lárigiñe aba lachuuruniña Hosé sun líbugañanu, aba layahun dan le lóuburuniña. Lárigiñe lira ligíaali gayara lan hadimurehan lun.<verse eid="GEN 45:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 45:16" />Aba lachülürün uganu tidoun luban urúei luagu chülühaña lan líbirigu Hosé, aba lagundaarun urúei úara hau sun lánigu. <verse eid="GEN 45:16" /><verse number="17" style="v" sid="GEN 45:17" />Aba lariñagun urúei lun Hosé:</para>
  <para style="p" vid="GEN 45:17">—Ariñagabá houn bíbirigu lun haloduruniña halügüniña burigü, ábame hagiribudun lóubawagun Kanán, <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />hanügeime háguchi hama haduheñu nun. Níchuguba lídangiñe le buítimabei lídangiñe múa houn Ehiptu, héigiba giñe lídangiñe lubuidun-agei éigini le fulasurugubei. <verse eid="GEN 45:18" /><verse number="19" style="v" sid="GEN 45:19" />Ariñagabá houn lun hanügün burí kareta yáagiñe Ehiptugiñe lun hanügüniña hámarigu hau harahüñü luma húguchi. Lun hayabin, <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />ani lun meberesedun hamá lau le hánibei guentó, ladüga hánibei lubuidun-agei burí katei le Ehiptubei.<verse eid="GEN 45:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 45:21" />Aba hadügüni lirahüñü Hakobu ítara. Aba líchugunu Hosé kareta burí to uáguboun lariñaga urúei, ru ligía éigini houn lun heigin luagu üma; <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />ruti giñe daüguaü iseri houn lun hasansiragun, anhein lun Benhamín ruti ǘrüwa-san murusun pülata tuma seingü daüguaü. <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />Lunti lúguchi óunahati diisi burigü lau lubuidun-agei burí katei le Ehiptubei, hámaya diisi burigü barüina türigu, fein luma éigini lun leigin lúguchi luagu üma. <verse eid="GEN 45:23" /><verse number="24" style="v" sid="GEN 45:24" />Dan layouragunbei Hosé houn líbirigu, lariñaga houn:</para>
  <para style="p" vid="GEN 45:24">—Midin humatia ageindagueina luagu üma. Aba houdin.<verse eid="GEN 45:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 45:25" />Aba háfuridun Ehiptugiñe, aba hachülürün Kanán, le ñein lubéi laganawa Hakobu le háguchi. <verse eid="GEN 45:25" /><verse number="26" style="v" sid="GEN 45:26" />Dan hariñaahani lun Hakobu luagu wínwangili lan Hosé, luagu giñe ligía lan gumadanbei lidan sun Ehiptu, ibidiñeti lun kaba lan ladüga ni kaba lan lariñaga, ladüga siñati yebe lafiñerun luagu le hariñagubei lun. <verse eid="GEN 45:26" /><verse number="27" style="v" sid="GEN 45:27" />Gama lumoun dan habahüdaguni sun le lariñagubei Hosé houn lun, arihalóun burí kareta to lóunahaboun Hosé lun tanügüni aba lagundaarun saragu. <verse eid="GEN 45:27" /><verse number="28" style="v" sid="GEN 45:28" />Ábati lariñagun:</para>
  <para style="p" vid="GEN 45:28">—Buídurügüti nun nasubudiruni luagu wínwangili lan niráü Hosé! Néibuga arihei lubaragiñe nounwen.<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s1">Hakobu uburugu Ehiptu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />Aba lidin Hakobu lau sun lúmati. Dan lachülürün Bérüsewa, aba ladagaragüdün ñein, lun Lubungiute Isaakü le lúguchi. <verse eid="GEN 46:1" /><verse number="2" style="v" sid="GEN 46:2" />Áriebu ligía, aba ladimurehan Bungiu luma Hakobu lidan aban uénedü, aba lagúarun lun lau liri le Hakobu. Lariñaga lun:</para>
  <para style="p" vid="GEN 46:2">—Anahán ya.<verse eid="GEN 46:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 46:3" />Lariñagati Bungiu:</para>
  <para style="p" vid="GEN 46:3">—Bungiu au, le Lubungiute búguchi. Manufudedabá bidin Ehiptu, ladüga nadügüba aban néchani wéiriti hau badügawagun ñein. <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />Nídiba buma Ehiptu, ani au guánarüba asagaraña badügawagun ñéingiñe. Danme giñe bounwen, ñeinbei Hosé bóubawagu.<verse eid="GEN 46:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 46:5" />Lárigiñe aba lidin Hakobu Bérüsewagiñe. Aba híchuguni lirahüñü Hakobu háguchi, harahüñü hama hámarigu tidoun burí kareta to lóunahaboun urúei lun tanügüniña. <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />Aba lidin Hakobu hau sun lánigu Ehiptun, aba hanügüniña halügüniña bágasu, mudún lúmaha sun le hamegenbei Kanán. <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />Ñǘdüntiña sun lirahüñü hama libañan luma.<verse eid="GEN 46:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 46:8" />Anihán hiri Ísüraelina ha ñǘdünbaña Ehiptun, Hakobu hau ladügawagun: Rubén le liráü Hakobu le íbugañaü. <verse eid="GEN 46:8" /><verse number="9" style="v" sid="GEN 46:9" />Lirahüñü Rubén: Hanoku, Falú, Esürón luma Karümí. <verse eid="GEN 46:9" /><verse number="10" style="v" sid="GEN 46:10" />Lirahüñü Simeón: Hemueli, Hamín, Oadü, Hakín, Sóarü luma Saulu, le tiráü aban würi Kananna. <verse eid="GEN 46:10" /><verse number="11" style="v" sid="GEN 46:11" />Lirahüñü Lewí: Gerüsón, Keatü, luma Merarí. <verse eid="GEN 46:11" /><verse number="12" style="v" sid="GEN 46:12" />Lirahüñü Hudá: Erü, Onán, Sela, Fáresi tuma Sara. Gama lumoun Erü luma Onán hilatiña bugaha lóubawagu Kanán. Lirahüñüti buga Fáresi: Esürón luma Amuli. <verse eid="GEN 46:12" /><verse number="13" style="v" sid="GEN 46:13" />Lirahüñü Isakárü: Tolá, Puá, Hobu luma Simürón. <verse eid="GEN 46:13" /><verse number="14" style="v" sid="GEN 46:14" />Lirahüñü Sabulón: Séredü, Elón luma Haleeli. <verse eid="GEN 46:14" /><verse number="15" style="v" sid="GEN 46:15" />Añahán lirahüñübaña Hakobu tau Lía dan meha Padán-aramüñanu lubéi, bóugudin tuéi Dina to haráü. Darandi-ǘrüwañanu gürigia ladügawagun, wügüriña hama würiña.<verse eid="GEN 46:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 46:16" />Lirahüñü Gadü: Sefón, Agí, Esübón, Suní, Erí, Arodí luma Arelí. <verse eid="GEN 46:16" /><verse number="17" style="v" sid="GEN 46:17" />Lirahüñü Aserü: Imüná, Isüwá, Isüwí, Beriá tuma hatu to gíriboun Sera. Lirahüñüti Beriá: Éberü luma Malükiéli. <verse eid="GEN 46:17" /><verse number="18" style="v" sid="GEN 46:18" />Añahán lirahüñübaña Hakobu tau Silüpá to meha idamuni to ledewehaboun Lawán tun Lía to liráü, disisiñanu ladügawagun hadan súngubei.<verse eid="GEN 46:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 46:19" />Tirahüñü Rakeli to úmaboun lamarieida Hakobu: Hosé luma Benhamín. <verse eid="GEN 46:19" /><verse number="20" style="v" sid="GEN 46:20" />Lirahüñü Hosé tau Asenátü: Manasési luma Éfürain ha águrahoubaña Ehiptu. Asenátü liráü meha Potifera le lufadirin On. <verse eid="GEN 46:20" /><verse number="21" style="v" sid="GEN 46:21" />Lirahüñü Benhamín: Bela, Békerü, Asübéli, Gerá, Naamán, Ei, Rosu, Mupimü, Upimü luma Árüdi. <verse eid="GEN 46:21" /><verse number="22" style="v" sid="GEN 46:22" />Hagía ladügawagunbaña Hakobu tau Rakeli, katorusuñanu gürigia.<verse eid="GEN 46:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 46:23" />Liráü Dan: Usimü. <verse eid="GEN 46:23" /><verse number="24" style="v" sid="GEN 46:24" />Lirahüñü Nefütalí: Haseeli, Guni, Heserü luma Silemü. <verse eid="GEN 46:24" /><verse number="25" style="v" sid="GEN 46:25" />Añahán lirahüñübaña Hakobu tau Bilá, to meha idamuni to ledewehaboun Lawán tun liráü Rakeli, sédüñanu gürigia hadügawagun.<verse eid="GEN 46:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 46:26" />Ǘrüwa-wein-sísiñanu gürigia ha achülürübaña luma Hakobu Ehiptun ha liduheñu, ani mabahüdünga hámarigu lirahüñü Hakobu. <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />Biámañanu lirahüñü Hosé águrahoutiña Ehiptu. Ǘrüwa-wein-díisiñanu lubeiti gürigia ha liduheñu Hakobu achülürütiña Ehiptun.<verse eid="GEN 46:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28" />Aba lóunahani Hakobu Hudá furumiñe lumoun Hosé, lun liabin lubaroun lóubawagu Gosén. Dan hachülürün Gosén, <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />aba líchugun Hosé dimurei lun taranserun aban karü lun lidin eresibirei lúguchi. Dan lachülürün lumoun lúguchi, aba lóuburuni, aba lerederun ayahuaha lüti dan luagu lege. <verse eid="GEN 46:29" /><verse number="30" style="v" sid="GEN 46:30" />Ábati lariñagun Hakobu lun Hosé:</para>
  <para style="p" vid="GEN 46:30">—Lárigiñe ariha náadibu lan lau nagu, darinábu wínwanñu, gayaraahali nounwen!<verse eid="GEN 46:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 46:31" />Lariñaga Hosé houn líbirigu luma houn liduheñu lúguchi:</para>
  <para style="p" vid="GEN 46:31">—Néibuga arihei urúei, ru náamugei uganu lun. Nariñagame lun luagu ñǘbuinhaña lan níbirigu hama liduheñu núguchi ha meha aganóubaña lóubawagu Kanán lun herederun numa; <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />luagu giñe barǘ hamaniña halügüniña mudún, halügüniña bágasu, luma sun hámati ladüga hóunigiruniwa mudún luma hagüriahóun bágasu hafisiutebei. <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />Dánmeti lagúarun urúei hun, lun lálügüdünün ka lan huádigimaribei, <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />hariñagame lun luagu hagüriahóun lan mudún huádigimaribei súnwandan kei meha hagüchagu. Ítara luba gayara lan herederun aganawa Gosén, ladüga máhatiña Ehiptuna lun haganóun haganagua hóuniri mudún.<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />Aba lidin Hosé íchigei uganu lun urúei. Aba lariñagun lun luagu ñǘbuinhali lan lúguchi hau líbirigu Kanangiñe, luagu añaheinhaña lan lóubawagu Gosén, hau halügüniña mudún, bágasu labu sun hámati.<verse eid="GEN 47:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 47:2" />Aba lanúadahan seingü hádangiñe líbugañanu aba larufuduniña lun urúei lun lasubudirúniña. <verse eid="GEN 47:2" /><verse number="3" style="v" sid="GEN 47:3" />Ábati lálügüdüniña urúei líbugañanu Hosé:</para>
  <para style="p" vid="GEN 47:3">—Ka huádigimaribei?</para>
  <para style="p" vid="GEN 47:3">Aba hóunabuni hariñaga lun:</para>
  <para style="p" vid="GEN 47:3">—Óunigira mudún wafisiutebei kei meha wagüchagu. <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />Wayabiña lun werederun lidan ageiraü le, ladüga wéiriti ilamaü Kanán, ani úati éigini ñein houn walügüniña mudún. Adüga humá fulesei woun, ru humá üma woun lun werederun aganawa lóubawagu Gosén.<verse eid="GEN 47:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 47:5" />Lariñagati urúei lun Hosé.</para>
  <para style="p" vid="GEN 47:5">—Liábiña búguchi hau bíbirigu lun herederun buma. <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />Anihán lumúan Ehiptu huéi, adüga huméi le habusenrun lau. Rubei lóubawagu Gosén houn, ladüga ligía fulasu buítimabei lídangiñe sun wageira lun herederun aganawa ñein. Ánhabu giñe asubudira luagu añahein lan gayaraatiña hadan, rúbaña lun hamainiruniña yégüniña bágasu.<verse eid="GEN 47:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 47:7" />Aba giñe lanügüni Hosé Hakobu le lúguchi, lun lasubudiruni urúei. Aba labusurun Hakobu lun urúei lau saragu inebesei, <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />aba lálügüdüni urúei lariñaga lun:</para>
  <para style="p" vid="GEN 47:8">—Átiri irumu bau guentó?<verse eid="GEN 47:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 47:9" />Aba lóunabuni Hakobu Lariñaga lun:</para>
  <para style="p" vid="GEN 47:9">—Aniheinhali san-darandi irumu nau éibuga yagüroun yaroun. Fureseti lásügürün murusun dan le winwan náalibei ani hénrenguti saragu lídangiñe irumu le winwan náalibei. Mawinwandun nágili giñe saragu irumu le meha hawinwandubei nagüchagu.<verse eid="GEN 47:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 47:10" />Lárigiñe aba layouragun Hakobu lun urúei, aba lidin ñéingiñe. <verse eid="GEN 47:10" /><verse number="11" style="v" sid="GEN 47:11" />Aba líchugun Hosé múa houn lidan lubuidun-agei Ehiptu lun haganóun ñein, kei buga lariñaguni urúei. Ítara liña liabin lúguchi hama líbirigu lun buga gamúan hamá lóubawagu Ramüsési. <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />Ru ligía burí Hosé éigini houn sun liduheñu según hemegeirun.<verse eid="GEN 47:12" /></para>
  <para style="s1">Lafansehani Hosé luáguti múa</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />Úati buga türigu lidan sun fulasu, aweiridagueina ligíatima ilamaü. Gíbetiña hádangiñe Ehiptuna hama Kananna óunwegutiña halama. <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />Aba lóundaruni Hosé sun seinsu le lebegi hagañeihan Ehiptuna hama Kananna türigu, aba lareiduni tidan luban urúei. <verse eid="GEN 47:14" /><verse number="15" style="v" sid="GEN 47:15" />Dan le úaali seinsu Ehiptu, ni Kanán, aba houdin sun Ehiptuna ariñaga lun Hosé:</para>
  <para style="p" vid="GEN 47:15">—Ruba éigini woun! Marichati lun barihiniwa óunwegua walama ladügarügü maseinsunhaadiwa lan.<verse eid="GEN 47:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 47:16" />Aba lóunabuniña Hosé lariñaga houn:</para>
  <para style="p" vid="GEN 47:16">—Anhein maseinsunhaadün lubéi, barǘ humaña hibiñanigu, nasansirubaña hun luagu türigu.<verse eid="GEN 47:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 47:17" />Aba hanügüniña Ehiptuna halügüniña gabayu, mudún, bágasu hama burigü lun Hosé, aba líchugun Hosé türigu houn hawagu sun animaalugu hagía, sun irumu ligía. <verse eid="GEN 47:17" /><verse number="18" style="v" sid="GEN 47:18" />Aba lásügürün irumu ligía, leweñegua irumu ábaya houdin ariñaga lun Hosé:</para>
  <para style="p" vid="GEN 47:18">—Siñati wasigeneruni bun luagu maseinsunhaadiwa lan; hayabin meha wabiñanigu, bibiñaniguhaaña, úaali amu katei wama lun wíchuguni bun luéidigia wamúan luma wágubu. <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />Agañeihabawa lau sun wamúan luagu türigu. Werederuba lidamunme urúei, wawadigimarideime wamúan lun. Ruba ilaü woun gayara láamuga wabagaridun, meferidirun láamuga giñe múa. Kábagia uagu bígirawa óunwegua úara luma wamúan?<verse eid="GEN 47:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 47:20" />Ábati lagañeihani Hosé sun lumúan Ehiptu lun urúei, aba haluguruni sun Ehiptuna hamúan ladüga halama. Ítara liña lásügürün múa labun lubafu urúei, <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />aba hayabin Ehiptuna lun idamunibaña lan lidan sun Ehiptu. <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />Hamuanrügüñein fádirigu magañeihan lan Hosé, ladüga rútiha urúei türigu houn; malugurun hamuti lubeiti hamúan, ladüga hóutiñaha lídangiñe le líchugubei urúei houn.<verse eid="GEN 47:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 47:23" />Lárigiñe aba lariñagun Hosé houn gürigia:</para>
  <para style="p" vid="GEN 47:23">—Guentó, huguya lau sun humúan lánihadün urúei, ladüga agañeiha naadün lun. Anihán ilaü lun hábunaguni múa, <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />gama lumoun mosu híchuguni aban lídangiñe kada seingü murusun lídangiñe halubahan lun urúei, le líbiri gádürü lerederame lun hábunaguni múa, ani lun heigin huguya, hirahüñü hama sun ha aganóubaña huma.<verse eid="GEN 47:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 47:25" />Aba hóunabun:</para>
  <para style="p" vid="GEN 47:25">—Areidatibu woun, sefu baali wabagari. Lidamunbadiwa urúei!<verse eid="GEN 47:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 47:26" />Ítara liña líchuguni Hosé kei lúrudu lidan sun Ehiptu, lun lichugún liseingün fánreinti lídangiñe alubahani lun urúei. Aniheinmémegua lúrudu ligía guentó ñein, ánhañati fádirigu mafayeihantiña ni kata, ladüga magañeihan lumuti meha urúei hamúan.<verse eid="GEN 47:26" /></para>
  <para style="s1">Lagumuhóun lugundan Hakobu</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />Aba herederun Ísüraelina aganawa Ehiptu. Aba hanügüni Gosén hánime, aba hagibedagun ñein. <verse eid="GEN 47:27" /><verse number="28" style="v" sid="GEN 47:28" />Disedüñein irumu lau Hakobu aganawa Ehiptu, aba lachülürün lumoun san-bián-wein-sedü irumu. <verse eid="GEN 47:28" /><verse number="29" style="v" sid="GEN 47:29" />Aban weyu aba lasandiruni Hakobu luagu lounwe lan ábati lóunahan agúara luagu Hosé, lun lariñagun lun:</para>
  <para style="p" vid="GEN 47:29">—Anhein inarüni lubéi luagu busén ban badügün aban fulesei nun, rubei búhabu lábugiñe niyada, báfiñurame nun luagu badügübei lan le lunbei namuriahani buma. Adügabá fulesei nun, mábunabana Ehiptu! <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />Danme nounwen basagaraname Ehiptugiñe bídinme ábunana lidan hamúaha nagüchagu.</para>
  <para style="p" vid="GEN 47:30">Lóunabeiti Hosé:</para>
  <para style="p" vid="GEN 47:30">—Ítara luba nadügüni.<verse eid="GEN 47:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 47:31" />Lariñaga lúguchi lun:</para>
  <para style="p" vid="GEN 47:31">—Fiñubei nun. Aba láfiñuruni Hosé, ábati labuluchagun Hakobu tuagu tichügübarari ligabanan.<verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s1">Labiniruniña Hakobu Éfürain luma Manasési</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />Murusun dan luéigiñe, aba hariñagun lun Hosé luagu sándiha lan lúguchi. Ábati lidin Hosé arihei, barüinalaña bián lirahüñü, Manasési luma Éfürain. <verse eid="GEN 48:1" /><verse number="2" style="v" sid="GEN 48:2" />Dan hawisarunbalin Hakobu luagu chülühali lan Hosé arihei, aba ladügün erei, aba lañuurun tuagu ligabanan. <verse eid="GEN 48:2" /><verse number="3" style="v" sid="GEN 48:3" />Aba lariñagun lun Hosé:</para>
  <para style="p" vid="GEN 48:3">—Arufudaguati Bungiu Suntigabafu lungua nun yágüta uburugu Lusu lóubawagu Kanán, aba labinirunina <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />lau dimurei le: «Nadügüba lun gibe hamá birahüñü, lun hadügün badügawagun aban néchani. Níchugubei giñe múa le houn badügawagun. Hánibei lun sun dan».<verse eid="GEN 48:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 48:5" />—Birahüñüti ha Éfürain luma Manasési ha águrahoubaña ya Ehiptu lubaragiñe niabin bumoun, yúutiña nun. Nani hagía kéigubeirügü nani lan Rubén luma Simeón. <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />Ha lúnbaña birahüñü hama hárigiñe, hagíaba bani, ladügame giñe hamulenu hamá Éfürain luma Manasési, gafanranbaña lidan alagan. <verse eid="GEN 48:6" /><verse number="7" style="v" sid="GEN 48:7" />Dan meha nagiribudunbei Padán-aramügiñe, aba tounwen Rakeli to búguchu nuéi lóubawagu Kanán, lubaragiñe wachülürün Éfürata, aba nábununu ñein luagu lémeri Éfürata le gíribei Belén guentó.<verse eid="GEN 48:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 48:8" />Sódini aba larihin Hakobu hawagun lirahüñü Hosé, aba lálügüdahan:</para>
  <para style="p" vid="GEN 48:8">—Angia ha, kátañagia?<verse eid="GEN 48:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 48:9" />Aba lóunabun Hosé lariñaga lun:</para>
  <para style="p" vid="GEN 48:9">—Nirahüñü ha líchugubaña Bungiu nun ya Ehiptu.</para>
  <para style="p" vid="GEN 48:9">Lariñagati lúguchi lun:</para>
  <para style="p" vid="GEN 48:9">—Yarafagüdatimabaña nun, biní náamugaña.<verse eid="GEN 48:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 48:10" />Wéiyayaali bugati Hakobu, ani lóuguaali larihin. Ábati layarafadagüdüniña Hosé irahüñü hagía lun lúguchi aba lachuuruniña, aba lóuburuniña. <verse eid="GEN 48:10" /><verse number="11" style="v" sid="GEN 48:11" />Lárigiñe aba lariñagun lun Hosé:</para>
  <para style="p" vid="GEN 48:11">—Magurabunhaadina yebe narihinibu. Gama lumoun, arihagüda laaña giñe Bungiu birahüñü nun.<verse eid="GEN 48:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 48:12" />Aba lagidaruniña Hosé irahüñü luéigiñe ligachürügü lúguchi, aba labuluchagun darí ladagarun lerebe múarugu. <verse eid="GEN 48:12" /><verse number="13" style="v" sid="GEN 48:13" />Lárigiñe aba lanügüniña biángubei, Éfürain lau lóunwenren, Manasési lau lubaünan aba layarafadagüdüniña lun lúguchi. Ítara liña lerederun Éfürain luéigiñe lubaünan Hakobu, Manasési luéigiñe lóunwenren. <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />Dan látuleruni Hakobu lúhabu, aba lásügüraguagüdüni, aba líchuguni lóunwenren lábulugu Éfürain, le amuleñein, líchigei lubaünan lábulugu Manasési le íbugañaü. <verse eid="GEN 48:14" /><verse number="15" style="v" sid="GEN 48:15" />Ábati labiniruni Hosé, ítara:</para>
  <para style="b" vid="GEN 48:15" />
  <para style="q" vid="GEN 48:15">«Bungiu le buga unbei gaganbadi hamá</para>
  <para style="q" vid="GEN 48:15">Abüraámü luma Isaakü ha nagübürigu,</para>
  <para style="q" vid="GEN 48:15">Bungiu le óunigirubalina</para>
  <para style="q" vid="GEN 48:15">lúmagiñe weyu le nágurahounbei,<verse eid="GEN 48:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="GEN 48:16" />ánheli le esefurubalina lídangiñe<optbreak /> sun wuribati,</para>
  <para style="q" vid="GEN 48:16">binilaña irahüñü ha.</para>
  <para style="q" vid="GEN 48:16">Haritawagualá niri hádangiñe</para>
  <para style="q" vid="GEN 48:16">luma hiri nagübürigu Abüraámü<optbreak /> luma Isaakü.</para>
  <para style="q" vid="GEN 48:16">Gibe hamá harahüñü, gíbegua<optbreak /> hamá ubouagu».<verse eid="GEN 48:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="GEN 48:17" />Gama lumoun magundanti Hosé lau líchuguni lúguchi lúhabu le lóunwenren luagu lábulugu Éfürain, aba lubeiti lagidaruni lúhabu lúguchi lábulugugiñe Éfürain lun líchuguni lábulugu Manasési, <verse eid="GEN 48:17" /><verse number="18" style="v" sid="GEN 48:18" />ariñageina ligía lun:</para>
  <para style="p" vid="GEN 48:18">—Uá núguchi, mítaranla! Anihán íbugañaünbei. Rubei bóunwenren lábulugu.<verse eid="GEN 48:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 48:19" />Máhati lúguchi, lariñaga lun:</para>
  <para style="p" vid="GEN 48:19">—Subudi numuti, niráü, subudi numuti. Ligía, liábinba giñe lun aban lan néchani wéiriguti. Gama lumoun wéirigutimabei lamulen luéi, ani hayabinba saragu néchanigu hádangiñe ladügawagun.<verse eid="GEN 48:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 48:20" />Ábati labiniruniña Hakobu lidan weyu ligía lau dimurei burí le:</para>
  <para style="p" vid="GEN 48:20">—Hayusurubei Ísüraelina hiri lun abiniruni, hariñagame: «Adügalá Bungiu bau kei ladügün lau Éfürain luma Manasési».</para>
  <para style="p" vid="GEN 48:20">Ítara liña líchuguni Hakobu Éfürain lubaragiñe Manasési. <verse eid="GEN 48:20" /><verse number="21" style="v" sid="GEN 48:21" />Lárigiñe aba lariñagun lun Hosé:</para>
  <para style="p" vid="GEN 48:21">—Au, nounwe, gama lumoun ñeinbei Bungiu huma, lagiribudagüdübadün hageiroun hagüchagu. <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />Rúhadina gíbeti bun sügǘ lau houn bíbugañanu: Ru numuti Sikemü bun, le nanügübei hawéi Amoruna lidan nawuribuhan hama.<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s1">Lagumuhóun Burí lererun Hakobu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />Aba lagúarun Hakobu houn lirahüñü, lariñaga houn:</para>
  <para style="p" vid="GEN 49:1">—Yarafa humá, nariñagaali hun le lunbei lasuseredun hun líteme:<verse eid="GEN 49:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="GEN 49:2" />«Yarafa humá lun haganbun, lirahüñü Hakobu,</para>
  <para style="q" vid="GEN 49:2">aganba huméi Hakobu le húguchi».<verse eid="GEN 49:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="GEN 49:3" />«Buguya Rubén, buguya niraübei<optbreak /> le íbugañaü;</para>
  <para style="q" vid="GEN 49:3">buguya nérebei, furumiñeti lin nere,</para>
  <para style="q" vid="GEN 49:3">furumiñeti lidan uéiriguni, luma ubafu.<verse eid="GEN 49:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="GEN 49:4" />Gama lumoun mámaadibume furumiñeti,</para>
  <para style="q" vid="GEN 49:4">ladüga ítara biña kei aban léibaaguagüle duna le mágüdahouati:</para>
  <para style="q" vid="GEN 49:4">ladüga wíyeda bumutu nigabanan lau bagamaridunu nubúali.<verse eid="GEN 49:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="GEN 49:5" />«Simeón luma Lewí, gamulenuguátiña;</para>
  <para style="q" vid="GEN 49:5">lánina anarimeni hárumate.<verse eid="GEN 49:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="GEN 49:6" />Mabusenruntina hamuga lun anahein lan</para>
  <para style="q" vid="GEN 49:6">lidan fulasu le ñein lumuti hóundara!</para>
  <para style="q" vid="GEN 49:6">Ladüga dan le gañi hamá, áfaraguatiña gürigia;</para>
  <para style="q" vid="GEN 49:6">dan le gunda hamá áhalaha hamuti hagudi bágasu wügüriña.<verse eid="GEN 49:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="GEN 49:7" />Íñarawaguala hagañi le hanarimebei, le ítarabei kei igañi áraabuna!</para>
  <para style="q" vid="GEN 49:7">Nachagaragubaña sunsuinagubei lidan sun fulasu le Ísüraelibei!<verse eid="GEN 49:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="GEN 49:8" />«Buguya Hudá, híchuguba bíbirigu uéiriguni bun.</para>
  <para style="q" vid="GEN 49:8">Bárügüdübaña báganiñu luéigiñe hagiina,</para>
  <para style="q" vid="GEN 49:8">ani bíbirigu guánarügü habuluchaguba bun.<verse eid="GEN 49:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="GEN 49:9" />Buguya, Hudá, niráü!</para>
  <para style="q" vid="GEN 49:9">Ítara biña kei aban liraüraü liñún lárigiñe léigini líliru:</para>
  <para style="q" vid="GEN 49:9">Aba lélemuchun,<optbreak /> aba larounrun múarugu,</para>
  <para style="q" vid="GEN 49:9">kamá hamuga aban liñún wéirihali</para>
  <para style="q" vid="GEN 49:9">ani kábati ñüdün añawariha lun?<verse eid="GEN 49:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="GEN 49:10" />Úabei agidaruti ubafu luéi Hudá,</para>
  <para style="q" vid="GEN 49:10">ni badun lánina gumadi le lúhaburugubei,</para>
  <para style="q" vid="GEN 49:10">darime liabin labureme badun,</para>
  <para style="q" vid="GEN 49:10">le lunbei haganbuni lílana<optbreak /> fulasu lererun.<verse eid="GEN 49:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="GEN 49:11" />Gürá lumuti liraüraü lilügün burigü luagu lídibu beibei,</para>
  <para style="q" vid="GEN 49:11">güraléi tiráü burigü luagu ídibu;</para>
  <para style="q" vid="GEN 49:11">chibá lumutu ladaüragun<optbreak /> tidan diwéin,</para>
  <para style="q" vid="GEN 49:11">chügülóun lumandan lidan lita beibei!<verse eid="GEN 49:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="GEN 49:12" />Funougati lagu tárigi diwéin,</para>
  <para style="q" vid="GEN 49:12">harú burí ligía lari lárigi míligi.<verse eid="GEN 49:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="GEN 49:13" />«Sabulón, láruba barana laganawa,</para>
  <para style="q" vid="GEN 49:13">le ñein lubéi wafu tun ugunei.</para>
  <para style="q" vid="GEN 49:13">Lachülürüba láfadaragun lufulasun chülǘ Sidón.<verse eid="GEN 49:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="GEN 49:14" />«Isakárü, aban animaalu héreti le anaaguti ilaü ligía,</para>
  <para style="q" vid="GEN 49:14">le emeraagubei tidan haban animaalu.<verse eid="GEN 49:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="GEN 49:15" />Dan larihinbei luagu buidu lan fulasu,</para>
  <para style="q" vid="GEN 49:15">buidu ligía lun emeraaguni,</para>
  <para style="q" vid="GEN 49:15">aba lélemuchun lun lanügün ilaü,</para>
  <para style="q" vid="GEN 49:15">aba líchaagun lungua<optbreak /> idamunime masigenehanga.<verse eid="GEN 49:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="GEN 49:16" />«Lagumadirubaña Dan<optbreak /> lumutuniña guánarügü</para>
  <para style="q" vid="GEN 49:16">kei aban hádangiñe lani<optbreak /> Ísüraeli türibu.<verse eid="GEN 49:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="GEN 49:17" />Ítara luba Dan kei aban hewe to lárutu üma,</para>
  <para style="q" vid="GEN 49:17">to ágürübalin lihilin lugudi gabayu,</para>
  <para style="q" vid="GEN 49:17">aba téiguadagüdüni le<optbreak /> agalufehabalin gabayu.<verse eid="GEN 49:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="GEN 49:18" />«Nabureme, agurabatina besefurunina!<verse eid="GEN 49:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="GEN 49:19" />«Hábürühaba súdaragu luagun Gadü,</para>
  <para style="q" vid="GEN 49:19">gama lumoun lárigiñeme,<optbreak /> ligíahalime éibaahaña.<verse eid="GEN 49:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="GEN 49:20" />«Aniheinbei saragu éigini luma Aserü;</para>
  <para style="q" vid="GEN 49:20">líchuguba éigini le libe heigin urúeigu.<verse eid="GEN 49:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="GEN 49:21" />«Ítara liña Nefütalí kei aban usari to éibugutu farañu,</para>
  <para style="q" vid="GEN 49:21">to hautu harahüñü<optbreak /> usari buíduburitiña.<verse eid="GEN 49:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="GEN 49:22" />«Ítara liña Hosé kei aban nadü<optbreak /> laru duna</para>
  <para style="q" vid="GEN 49:22">to aginduboun saragu,</para>
  <para style="q" vid="GEN 49:22">ani wariguati tilimun luagun baríeiru.<verse eid="GEN 49:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="GEN 49:23" />Iyereeguti houn taburiña gimara,</para>
  <para style="q" vid="GEN 49:23">chǘguatiña gimara luagun,</para>
  <para style="q" vid="GEN 49:23">ani súnwandan hañawarihaña lan lun;<verse eid="GEN 49:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="GEN 49:24" />gama lumoun héreti larüna Hosé ani suruñutiña ligimaran;</para>
  <para style="q" vid="GEN 49:24">seremei lun Bungiu le gabafubei le Lubungiute Hakobu!</para>
  <para style="q" vid="GEN 49:24">Seremei lun liri hóuniri mudún, le ágüdahabalin Ísüraeli!<verse eid="GEN 49:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="GEN 49:25" />Teinki lun Lubungiute búguchi le lunbei líderagunibu;</para>
  <para style="q" vid="GEN 49:25">lun Bungiu Suntigabafu,<optbreak /> le lunbei labinirunibu!</para>
  <para style="q" vid="GEN 49:25">Lau burí abiniruni íñugiñeti<optbreak /> sielu!</para>
  <para style="q" vid="GEN 49:25">Lau burí abiniruni lídangiñeti barana huliliti!</para>
  <para style="q" vid="GEN 49:25">Lau abiniruni le lani aniguagu<optbreak /> luma urageirugu!<verse eid="GEN 49:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="GEN 49:26" />Biní lumutibu búguchi,</para>
  <para style="q" vid="GEN 49:26">sügǘ lau habinirunina nagübürigu.</para>
  <para style="q" vid="GEN 49:26">Ñeinbei abiniruni burí le lóugiñe lichügü Hosé</para>
  <para style="q" vid="GEN 49:26">chülǘ lumoun lébeha burí wübü<optbreak /> le magumuchadibei,</para>
  <para style="q" vid="GEN 49:26">ani anuadirúati Hosé<optbreak /> hádangiñe líbirigu.<verse eid="GEN 49:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="GEN 49:27" />«Aban ounli áraabuna<optbreak /> hanarimeti Benhamín,</para>
  <para style="q" vid="GEN 49:27">le éigibalin líliru binaafin,</para>
  <para style="q" vid="GEN 49:27">aba lafanreinhani lígiragun rábounweyu».<verse eid="GEN 49:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GEN 49:28" />Añahán duusu türibu lani Ísüraeli, ligía giñe lariñagubei háguchi houn lirahüñü dan le labinirunbaliña kada aban.<verse eid="GEN 49:28" /></para>
  <para style="s1">Lounwen Hakobu</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29" />Aban weyu, aba lariñagun Hakobu houn lirahüñü:</para>
  <para style="p" vid="GEN 49:29">—Madiseeli lun nounwen, hábunaname harugabu nagüchagu lagadábugiñe dübü le lídanbei lufulasun Efürón le Étüna, <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />yágüta lidan lumúan Kanán, lagadábugiñe dübü le Maküpelábei ligibugiñe Mamüré, le meha lagañeihabei Abüraámü úara luma lufulasun Efürón lun hamúahabei lan waduheñu. <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />Ñein labunúa Abüraámü tau sun Sara to lúmari; Isaakü tau sun Rebeka to lúmari; ñein giñe nábunoun Lía. <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />Fulasu luma lagadábugiñe dübü le ñeinbei, hámagiñe Étüna lagañeihóua.<verse eid="GEN 49:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 49:33" />Dan lásurun lariñaguni Hakobu sun burí katei le houn lirahüñü, ábaya larounrun tidoun ligabanan, aba lounwen.<verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />Ábati lóuburuni Hosé lúgubu lúguchi, aba lachuuruni ayahuaheina. <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />Lárigiñe aba lariñagun houn lisurusianigu lun haranseruni lúgubu lúguchi, aba haranseruni. <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />Bián-wein weyu hau aranserei, ladüga ítara liña dan lun laranserun aban hilaali. Aba hamuiserun Ehiptuna ǘrüwa-wein-diisi weyu lárigi Hakobu.<verse eid="GEN 50:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 50:4" />Lárigiñe lásügürün amuiseruni, aba ladimurehan Hosé hama tílana luban urúei, lariñaga houn:</para>
  <para style="p" vid="GEN 50:4">—Anhein gañei naali lubéi hínsiñehabu, adüga humá fulesei nun, lun hariñagun lun urúei <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />luagu dan lan meha lounwe lan núguchi, fiñugüda lánina luagu nábunubei lan lidan umúahaü le meha laranserubei lubarua lóubawagu Kanán. Amuriahatina lubeiti üma luma lun nidin ábunei núguchi, ábayame niabin.<verse eid="GEN 50:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 50:6" />Lariñaga urúei:</para>
  <para style="p" vid="GEN 50:6">—Beiba ábunei búguchi kei lamuriahani buma.<verse eid="GEN 50:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 50:7" />Aba lidin Hosé ábunei lúguchi, ñǘdüntiña sun nadagimeintiña hama ha gererunbaña tidan lani urúei palasiu luma lidan uburugu Ehiptu; <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />ha guánarügü liduheñu Hakobu, liduheñu Hosé, hama líbirigu. Irahüñürügüñanu hama animaalugu hígira Gosén. <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />Ñǘdüntiña giñe gürigia tídantiña kareta hawagutiña gabayu ábunaha luma Hosé, gíbetiña lubeiti gürigia ñǘdüntiña. <verse eid="GEN 50:9" /><verse number="10" style="v" sid="GEN 50:10" />Dan hachülürün Gorén-a-atadü, le luéigiñebei oubaü le ñéingiñe lubéi laboucha weyu libiti duna le Hordán, aba hadügün aban adamuridaguni lánina ábunahani ñein aba lamuiserun Hosé sedü weyu ñein lárigi lúguchi <verse eid="GEN 50:10" /><verse number="11" style="v" sid="GEN 50:11" />Dan harihini Kananna ha aganóubaña lidan fulasu ligía ábunahani, aba hariñagun: Hadügüña Ehiptuna aban ábunahani wéiriguti. Ligía háchubalin fulasu ligía: «Aweli-misüraímü. Le luéigiñebei labouchun weyu libiti Hordán».<verse eid="GEN 50:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 50:12" />Adüga hamuti lirahüñü Hakobu sun le lamuriahabei háguchi hama, <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />barǘ hamuti lóubawagun Kanán, buná haméi lagadábugiñe dübü le gíribei Maküpelá le meha lagañeihabei Abüraámü lúmagiñe Efürón le Étüna lun hamúahabei lan liduheñu. Fulasu ligía luma lagadábugiñe dübü ligía luéigiñeñein oubaü le ñéingiñe lubéi laboucha weyu libiti Mamüré. <verse eid="GEN 50:13" /><verse number="14" style="v" sid="GEN 50:14" />Lárigiñe lábununi Hosé lúguchi, aba lagiribudun Ehiptun úara hama líbirigu, hama ha ñǘdünbaña luma.<verse eid="GEN 50:14" /></para>
  <para style="s1">Lagumuhóun burí luéyuri Hosé</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15" />Kei buga hilá lan Hakobu, hariñaga líbirigu Hosé hóunguarügü:</para>
  <para style="p" vid="GEN 50:15">—Háfuga iyereegutiwa lun Hosé, lafayeiragüdübadiwati luagu sun meha wuribati le wadügübei lun.<verse eid="GEN 50:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 50:16" />Aba hóunahan ariñaga lun Hosé:</para>
  <para style="p" vid="GEN 50:16">—Lubaragiñe buga lounwen búguchi, ariñagati woun <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />lun wamuriahan buma lun feruduna bániwa luagu wuribati le wadügübei bun. Ligíati wamuriahanbei buma lun ferudunabani wuribani le buga wadügübei, ladüga idamuni wagía lun Lubungiute búguchi.</para>
  <para style="p" vid="GEN 50:17">Sun añaha lan óunagülei íchigei uganu lun Hosé, anihán ayahua. <verse eid="GEN 50:17" /><verse number="18" style="v" sid="GEN 50:18" />Aba hayabin líbirigu guánarügü, aba habuluchagun ligibugiñe darí ladagarun herebe múarugu, aba hariñagun lun:</para>
  <para style="p" vid="GEN 50:18">—Awanhán, bidamun wagía.<verse eid="GEN 50:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 50:19" />Lariñaga Hosé houn:</para>
  <para style="p" vid="GEN 50:19">—Manufudeda humá, siñati níchaagun nungua kei Bungiu. <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />Saminatün yebe meha hadügün wuribati nun, gama lumoun aba lasansiruni Bungiu wuribati ligía luagu buiti, lun ladügüni le warihubei uguñe weyu, lun lesefuruni habagari saragu gürigia. <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />Manufudeda humá lubeiti, níchuguba éigini hun luma houn hirahüñü.</para>
  <para style="p" vid="GEN 50:21">Ítara liña líchugun Hosé dǘgüdaguaü houn, ani adimurehati houn lau saragu ínsiñeni.<verse eid="GEN 50:21" /></para>
  <para style="s1">Lounwen Hosé</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22" />Aba lasigirun Hosé hau liduheñu lúguchi aganawa Ehiptu. San díisiñein irumu labagaridun Hosé, <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />chülüti arihaña ladügawagun Éfürain. Chülüti giñe eresibiraña lirahüñü libari le Makirü le liráü Manasési kei hádangiñetiña iduheñu.<verse eid="GEN 50:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 50:24" />Luagu aban weyu aba lariñagun Hosé houn líbirigu:</para>
  <para style="p" vid="GEN 50:24">—Madiseeli nounwen, gama lumoun liábinba Bungiu íderaguaün, lasagarubadün lídangiñe fulasu le, lun lanügünün lidoun fulasu le uágubei lariñaga lun Abüraámü, Isaakü luma Hakobu.<verse eid="GEN 50:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 50:25" />Aba láfiñuragüdüniña Hosé lirahüñü Hakobu, lariñaga houn:</para>
  <para style="p" vid="GEN 50:25">—Inarüni, liábinba Bungiu íderaguaün. Danme lasuseredun le, hanügeime nabu yáagiñe.<verse eid="GEN 50:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 50:26" />Aba lounwen Hosé Ehiptu luagu san-diisi irumu lau. Aba haranseruni lúgubu, aba híchuguni tidoun aban ganhun.<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>