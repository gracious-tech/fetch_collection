<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ECC" style="id">ESCLESIAS.TXT (Encoding update 2008) 27/02/2001 CAP C.R, GARIFUNA</book>
  <para style="h">Apurichihati</para>
  <para style="toc3">Apur</para>
  <para style="toc2">Apurichihati</para>
  <para style="toc1">Apurichihati</para>
  <para style="mt2">Liliburun</para>
  <para style="mt1">APURICHIHATI</para>
  <chapter number="1" style="c" sid="ECC 1" />
  <para style="ms">I. Libagari Apurichihati</para>
  <para style="mr">(<ref loc="ECC 1-2">1—2</ref>)</para>
  <para style="s1">Sun katei málati</para>
  <para style="p">
    <verse number="1-2" style="v" sid="ECC 1:1-2" />Anihán lererun apurichihati, le liráü Dawidi, le meha arúeihabei Herusalén.</para>
  <para style="b" vid="ECC 1:1-2" />
  <para style="q" vid="ECC 1:1-2">Málati sun katei! Sun katei málati!<verse eid="ECC 1:1-2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ECC 1:3" />Ka lagañeirubei gürigia lau luadigimari saragu ya ubouagu?<verse eid="ECC 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ECC 1:4" />Híbiri águrahoua, híbiri óunwegua,</para>
  <para style="q" vid="ECC 1:4">gama lumoun masansiragunti ubóu.<verse eid="ECC 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ECC 1:5" />Furiti weyu, dubú ligía,</para>
  <para style="q" vid="ECC 1:5">ábaya lagiribudun lidoun lubara lunya láfuridun.<verse eid="ECC 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ECC 1:6" />Futi garabali luagun suru,</para>
  <para style="q" vid="ECC 1:6">lárigiñe aba lagararaagun luagun nórute.</para>
  <para style="q" vid="ECC 1:6">Agararahati garabali!</para>
  <para style="q" vid="ECC 1:6">Gararaguati ani gararaguaya ligía!<verse eid="ECC 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ECC 1:7" />Sun duna baranahoun léibaagua</para>
  <para style="q" vid="ECC 1:7">gama lumoun mabuinchunti barana;</para>
  <para style="q" vid="ECC 1:7">sun duna giribuyati lárigoun lidoun fulasu le ñéingiñe lubéi láhücha</para>
  <para style="q" vid="ECC 1:7">lunya léibaaguni ümaméme ligía.<verse eid="ECC 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ECC 1:8" />Úati ni aban gayaraati lariñaguni furangu</para>
  <para style="q" vid="ECC 1:8">ida liña lan labuchadun hawagu gürigia lubá sun katei;</para>
  <para style="q" vid="ECC 1:8">úati giñe arihiti ni aganbuti le gumuti lun gufurumabei lan.<verse eid="ECC 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ECC 1:9" />Úabei ni kata lun úagili lan meha;</para>
  <para style="q" vid="ECC 1:9">madügǘnwabei ni kata le madügǘnwañahagili.</para>
  <para style="q" vid="ECC 1:9">Úati ni kata iseri ligibuagu ubóu le!<verse eid="ECC 1:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ECC 1:10" />Súnwandan ñeinbei lan ariñaguti:</para>
  <para style="q" vid="ECC 1:10">«Anati le, iseri!»</para>
  <para style="q" vid="ECC 1:10">Gama lumoun aniheinhali meha saragu dan wabaragiñe.<verse eid="ECC 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ECC 1:11" />Katei burí le sügühali, bulíeiwaali,</para>
  <para style="q" vid="ECC 1:11">labulieidúaba giñe le lunbei liabin</para>
  <para style="q" vid="ECC 1:11">hadan ha lúnbaña hayabin lárigiñe.<verse eid="ECC 1:11" /></para>
  <para style="s1">Le lásügürübei apurichihati</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12" />Au, le apurichihati, lurúeite meha Ísüraeli au Herusalén.<verse eid="ECC 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 1:13" />Rúguatina meha nungua sunsuinagubei lun naturiahani luma lun nasubudiruni lau lichú aau sun le adügǘbei ligibuagu ubóu le. Hǘrüti anügüni le líchugubei Bungiu hawagun gürigia lun lǘnabudagüdüniña lau!<verse eid="ECC 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 1:14" />Aba nasubudiruni luagu málati lan sun katei le adügǘbei ligibuagu ubóu le, kéigubeirügü hamuga wabusenrun wárügüdüni garabali.<verse eid="ECC 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 1:15" />Siñati lásuurawagüdüniwa le segebei,</para>
  <para style="q" vid="ECC 1:15">ni lun babahüdüni le úabei buma!<verse eid="ECC 1:15" /></para>
  <para style="p">
    <verse number="16-17" style="v" sid="ECC 1:16-17" />Ábati nariñagun núniwagua: «Anahán, aban gürigia wéiriguti, chuti nau sügǘ hau sun ha arúeihabaña Herusalén nubaragiñe, deregeguatina nungua sunsuinagubei lun nahulilidun lidan lichú aau luma subudi, luma giñe lidan libidiounigan aau luma lilouguan ichügü, lúnrügü nasubudiruni luagu labusenrúniwa lan lárügüdün garabali lira». <verse eid="ECC 1:16-17" /><verse number="18" style="v" sid="ECC 1:18" />Lidan linarün aban katei, gaweiridun ligía lichú aau, gaweiridun asufuriruni; gagibedun ligía lisubudin gürigia, gagibedun ligarigu.<verse eid="ECC 1:18" /></para>
  <chapter eid="ECC 1" />
  <chapter number="2" style="c" sid="ECC 2" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1" />Ariñagatina núnguarügü: «Noucha guentó lun níchugun ugundani núniwagua; nabagarida aban ibagari buiti».</para>
  <para style="p" vid="ECC 2:1">Gama lumoun íbini lira, ñǘbuinti lun káteibei lan le málati! <verse eid="ECC 2:1" /><verse number="2" style="v" sid="ECC 2:2" />Aba nasubudiruni luagu lílülün lan aau éherahani, ani meseriwín lan giñe ugundani.<verse eid="ECC 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 2:3" />Houcha numuti ka lan líchugubei tatún diwéin, madisedunga tugía nanigi luéi lichú aau aba nederegeragun nungua lun libidiounigan aau, lun narihini anhein ligía lubéi lunbei ladügüni gürigia lidan bianraü weyu le lunbei labagariduni ya ubouagu.<verse eid="ECC 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 2:4" />Adügatina óunwenbu burí katei; bunaguatina palasiu; gabeibein-ágeitina; <verse eid="ECC 2:4" /><verse number="5" style="v" sid="ECC 2:5" />gamúantina le ñein lumuti fuluri-agei, bunaguatina sun tuwuyeri wewe to geigúatu tin; <verse eid="ECC 2:5" /><verse number="6" style="v" sid="ECC 2:6" />adügatina lagei duna lun náturaguni ninadüri: <verse eid="ECC 2:6" /><verse number="7" style="v" sid="ECC 2:7" />Agañeihatina nidamun wügüriña hama würiña, gamusuntina ha águrahoutiña núbiñe, galügüntina meha giñe bágasu hama mudún sügǘ lau furumiñeguarügü le nubaati Herusalén. <verse eid="ECC 2:7" /><verse number="8" style="v" sid="ECC 2:8" />Óundaraguagüdatina saragu golu luma pülata, irisini le meha hani amu urúeigu luma burí amu fulasu le ñein lumuti narúeiha. Eremuhatiña wügüriña hama würiña lun hagundaaragüdünina, ani ñéinñanu meha giñe saragu würiña numa.<verse eid="ECC 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 2:9" />Aban meha wügüri wéiriguti au, chülütina agamada gibe sügǘ hau sun ha meha nubaabaña Herusalén. Lau sun lira mígirun lumutina meha lichú aau. <verse eid="ECC 2:9" /><verse number="10" style="v" sid="ECC 2:10" />Darí numuti meha sun katei le nayumahan núniwagua; masigeneruntina ni murusun ugundani núniwagua. Gúndaatina meha lau nuadigimari, ani ligía meha nafayeiruahabei.<verse eid="ECC 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 2:11" />Lárigiñe aba naritagun luagun sun nuadigimari luma lénrengun nadügüni, aba nasubudiruni luagu katei lan málati sun lira, kéigubeirügü hamuga lálugun gürigia lárügüdüni garabali, ani luagu ua lan ni kata anügüti buiti ligibuagu ubóu le.<verse eid="ECC 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 2:12" />Lárigiñe aba nasaminarun libügürü lichú aau, libidiounigan aau luma luriban ichügü kábagia gayara lan le lunbei larúeihan nárigiñe adüga, luéidigia le adügǘwaalibei meha? <verse eid="ECC 2:12" /><verse number="13" style="v" sid="ECC 2:13" />Aba nasubudiruni luagu buídutima lan lichú aau luéi libidiounigan aau, ítara kei buídutima lan larugounga luéi luburiga.<verse eid="ECC 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 2:14" />Yusu lumuti le chubei au lagu buidu, ánheinti le ibidiouguabei au, búrigati lau. Lau sun lira, aba narihini luagu le lan lunbei lasuseredun lun aban ligiamémeba lan giñe asusereda houn súngubei, <verse eid="ECC 2:14" /><verse number="15" style="v" sid="ECC 2:15" />ábati nariñagun núniwagua: «Le lunbei lasuseredun lun le ibidiouguabei au, ligiamémeba asusereda nun, málati lubeiti lichú aau! <verse eid="ECC 2:15" /><verse number="16" style="v" sid="ECC 2:16" />Lugundun úabei aritaguti luagu chu tau ni luagu ibidiougua tau; labulieidúaba sun le danme lachülürün dan, dandu chu tau kéigubeirügü ibidiougua tau hóunweguba».<verse eid="ECC 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 2:17" />Chülüti dan lun liyereegudun ibagari nun, ladüga sun le adügǘbei ligibuagu ubóu le kamá hamuga kóntürañein nuagu. Lidan linarün aban katei, málati sun lira, ítara liña kéigubeirügü hamuga labusenrun gürigia lárügüdüni garabali. <verse eid="ECC 2:17" /><verse number="18" style="v" sid="ECC 2:18" />Chülütina árügüda iyereehabúni luagu sun wadagimanu le nadügübei ligibuagu ubóu le, ladüga gasu lan nígiruni lun le lunbei liabin nárigiñe. <verse eid="ECC 2:18" /><verse number="19" style="v" sid="ECC 2:19" />Ani aban bugaha katei chóuruti: Luagu le lan lunbei nárigiñe lan, chu yebe lau, ibidiougua yebe lau, lerederuba lau le nibihubei lau saragu wadagimanu luma lichú aau ya ubouagu. Ani katei giñe málati sun lira.<verse eid="ECC 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ECC 2:20" />Dan narihinbalin le meha nadügübei ya ubouagu, aba nasakürihan nuadigimaridun saragu, <verse eid="ECC 2:20" /><verse number="21" style="v" sid="ECC 2:21" />lugundun añahein íchugutiña lichú aau luma subudi lidan hawadigimari, lúnrügü hígiruni súngubei lun le mawadigimaridunbei. Katei giñe málati lira ani aban óunwenbu marichaü!<verse eid="ECC 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ECC 2:22" />Lidan lagumuhóun dan, ka lagañeirubei gürigia lau luadigimaridun saragu luma lau lafuudun saragu ligibuagu ubóu le? <verse eid="ECC 2:22" /><verse number="23" style="v" sid="ECC 2:23" />Lauti asufuriruni sun libagari, aban anügüni hǘrüti; ni íbini áriebu memeraagunti laritagun. Katei giñe málati lira!<verse eid="ECC 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ECC 2:24" />Le lunbei ladügüni gürigia, lun leigin, latun luma lun lefeduhani le lagañeirubei luagu luadigimari, lugundun darí naali giñe luagu lúmagiñeti lan Bungiu lira. <verse eid="ECC 2:24" /><verse number="25" style="v" sid="ECC 2:25" />Kagia gayaraabei leigin o lefeduhan anhein mama lubéi luagu Bungiu? <verse eid="ECC 2:25" /><verse number="26" style="v" sid="ECC 2:26" />Gürigia le unbei hínsiñehabu lan Bungiu, ruti lichú aau lun, subudi luma ugundani. Gama lumoun ánheinti lun le afigouhabei, ruti Bungiu wadagimanu lun, lun lagibedun lúmati, lun lóundaragun irisini lárigiñe aba líchuguni irisini ligía lun le unbei hínsiñehabu lan. Sun lira katei giñe málati, ítara liña kéigubeirügü labusenrúniwa lárügüdün garabali.<verse eid="ECC 2:26" /></para>
  <chapter eid="ECC 2" />
  <chapter number="3" style="c" sid="ECC 3" />
  <para style="ms">II. Larihíniwa Ibagari</para>
  <para style="mr">(<ref loc="ECC 3:1-12:8">3.1—12.8</ref>)</para>
  <para style="s1">Sun katei gadaaniti</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 3:1" />Gadaaniti sun katei ya ligibuagu ubóu le; chülüti lidaani sun le asuseredubei:<verse eid="ECC 3:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ECC 3:2" />Lidaani águrahouni luma lidaani óunweni.</para>
  <para style="q" vid="ECC 3:2">Lidaani ábunaguni luma lidaani alubahani.<verse eid="ECC 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ECC 3:3" />Lidaani áfarahani luma lidaani agaranihani.</para>
  <para style="q" vid="ECC 3:3">Lidaani agünrinchaguni luma lidaani aransehani.<verse eid="ECC 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ECC 3:4" />Lidaani ayahuni luma lidaani éherahani.</para>
  <para style="q" vid="ECC 3:4">Lidaani amuiseruni luma lidaani efeduhani.<verse eid="ECC 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ECC 3:5" />Lidaani lachagarawagun dübü luma lidaani labudahóun.</para>
  <para style="q" vid="ECC 3:5">Lidaani agulichahani luma lidaani afanreinraguni.<verse eid="ECC 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ECC 3:6" />Lidaani áluahani luma lidaani eferidiruni.</para>
  <para style="q" vid="ECC 3:6">Lidaani areiduni luma lidaani achagahani.<verse eid="ECC 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ECC 3:7" />Lidaani aheiridaguni luma lidaani áhüchaguni.</para>
  <para style="q" vid="ECC 3:7">Lidaani ámanichuni luma lidaani adimurehani.<verse eid="ECC 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ECC 3:8" />Lidaani ínsiñeni luma lidaani iyereehabúni</para>
  <para style="q" vid="ECC 3:8">Lidaani wuribu luma lidaani darangilaü.<verse eid="ECC 3:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="ECC 3:9" />Kagia lagañeirubei gürigia lau luadigimaridun saragu? <verse eid="ECC 3:9" /><verse number="10" style="v" sid="ECC 3:10" />Ariha numuti ihürügu le líchugubei Bungiu hawagun gürigia lun lǘnabudagüdüniña lau. <verse eid="ECC 3:10" /><verse number="11" style="v" sid="ECC 3:11" />Ru lumuti Bungiu lidaani sun katei. Ru lumuti ayumahani tidoun hanigi gürigia lun gunfuranda habéi lan sun le susereelibei luma le lunbei lasuseredun, lau sun machülü hamá gürigia gunfurandei le ladügübei Bungiu buidu buidu.<verse eid="ECC 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 3:12" />Subudi numuti luagu lubuidun-agei lan katei le lunbei ladügüni gürigia lun lefeduhani libagari ani wínwanleime, <verse eid="ECC 3:12" /><verse number="13" style="v" sid="ECC 3:13" />lugundun ánhawa eiga, gurá wagía, aríagua wameime buiti le líchugubei wawadigimari, rúrügü liñalin Bungiu woun. <verse eid="ECC 3:13" /><verse number="14" style="v" sid="ECC 3:14" />Subudi numuti giñe luagu sun lan le ladügübei Bungiu, lerederuba lan lun súnwandan:</para>
  <para style="b" vid="ECC 3:14" />
  <para style="q" vid="ECC 3:14">Úati ni kata lun lichugún lanwoun,</para>
  <para style="q" vid="ECC 3:14">ua ligía ni kata lun lagidarún lídangiñe;</para>
  <para style="q" vid="ECC 3:14">ítara liña ladügüni Bungiu, lun inebebei lan houn sun gürigia.<verse eid="ECC 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ECC 3:15" />Úati ni kata susereti</para>
  <para style="q" vid="ECC 3:15">o lunti lasuseredun lun masuseredunñahagili lan.</para>
  <para style="q" vid="ECC 3:15">Adügati Bungiu lunya lagiribudun le bugaha sügühalibei.<verse eid="ECC 3:15" /></para>
  <para style="s1">Marichaü ubouagu</para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 3:16" />Ariha naali giñe luagu iwiyei lan luma wuribani ligibuagubei ubóu le, lubaragiñe hamuga irichaü lan luma úarani ñein. <verse eid="ECC 3:16" /><verse number="17" style="v" sid="ECC 3:17" />Ligíati nariñagunbei luagu laguseragüdübei lan Bungiu dandu gürigia le richaguabei kei le salufuribei, lugundun gadaaniti sun le asuseredubei luma sun le adügǘbei.<verse eid="ECC 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 3:18" />Ariñagatina giñe libügürü hóuserun gürigia, luagu lóuchaguñanu lan Bungiu, lun hasubudiruni luagu ítara haña lan giñe kei animaalugu. <verse eid="ECC 3:18" /><verse number="19" style="v" sid="ECC 3:19" />Ábanmeme hasinunbei gürigia hama animaalugu. Hilaguatiña gürigia kéisigubeirügü animaalugu, ábanmeme giñe hawaragun súngubei. Úati ni kata luagu gürigia luéi animaalu, katei málati súngubei, <verse eid="ECC 3:19" /><verse number="20" style="v" sid="ECC 3:20" />lídounbaña ábanmeme fulasu súngubei; lídangiñe múa hadügǘwa súngubei ani lídounyaba giñe múa hagiribuda. <verse eid="ECC 3:20" /><verse number="21" style="v" sid="ECC 3:21" />Kagia gayaraabei lachoururuni luagu mudei lan lani gürigia sífiri sielun, luma luagu rarí lan lani animaalu sífiri labun múa? <verse eid="ECC 3:21" /><verse number="22" style="v" sid="ECC 3:22" />Ariha naali luagu ua lan ni kata buítimati lun gürigia luéidigia lefeduhani lebegi luadigimari, lugundun ligía yuubei lun, ladüga úabei anügüti lun larihini le lunbei lasuseredun lárigiñe lounwen.<verse eid="ECC 3:22" /></para>
  <chapter eid="ECC 3" />
  <chapter number="4" style="c" sid="ECC 4" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 4:1" />Lárigiñe aba nadigiragun luagun marichaü le ligibuagubei ubóu le. Aba narihin saragu amudirawagutiña ani óuserawagua hagía. Ayahuahatiña ha óuserawagubaña, gama lumoun úatiña kaba lan íderaguaña. Úati íderagutiña ladüga hámañein lan ha éibaahabaliña ubafu. <verse eid="ECC 4:1" /><verse number="2" style="v" sid="ECC 4:2" />Ligía naritagunbei luagu fuleseiwa hamá ha hilaguaañabaña sügǘ hau ha nibagarigiñabaña; <verse eid="ECC 4:2" /><verse number="3" style="v" sid="ECC 4:3" />gama lumoun fuleseiwatimatiña ha mágurahoungiñabaña, lugundun marihin hamagili wuribani le adügǘbei ligibuagu ubóu le.<verse eid="ECC 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 4:4" />Ariha numuti giñe luagu barǘ lan wadagimanu gimugaü houn gürigia hádangua, ani katei giñe málati lira, kéigubeirügü hamuga habusenrun hárügüdüni garabali.<verse eid="ECC 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 4:5" />Hariñahare gürigia: «Chagua lumuti ibidiougua tau larüna, günringua ligía lúniwagua». <verse eid="ECC 4:5" /><verse number="6" style="v" sid="ECC 4:6" />Gama lumoun nariñahare: «Buítimati aban úhabu buin lau emeraaguni sügǘ lau biama lau lubucha uagu ladügarügü labusenrun lárügüdüni garabali».<verse eid="ECC 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 4:7" />Dan le nadigiragun luagun ábanya oubaü, ábaya narihin aban katei málati ligibuagu ubóu le: <verse eid="ECC 4:7" /><verse number="8" style="v" sid="ECC 4:8" />Aban wügüri lábuguarügüti, le mamadaguti, marahüñü, mábirigu, le márügüdünti ni murusun dan lun lemeraagun, mabuchadaditi luagu aríaguei lirisin, málügüdagunga ligía lungua ariñaga: «Ka san ubá nuadigimarida saragu? Ka uagu memeraagun nubéi?» Katei giñe málati lira, aban anügüni le hǘrüti.<verse eid="ECC 4:8" /></para>
  <para style="s1">Úarani adügübalin erei</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 4:9" />Buítimatiña biama luéi aban, lugundun wéiritimati hafayeiruaha luagu hawadigimari. <verse eid="ECC 4:9" /><verse number="10" style="v" sid="ECC 4:10" />Ani anhein éiguada aban hádangiñe, liñuragubei le aban. Gama lumoun fugiabu le éiguaduti ani lábuguarügüñein, ladüga úabei kaba lan iñuraguei! <verse eid="ECC 4:10" /><verse number="11" style="v" sid="ECC 4:11" />Ani ánhaña giñe arounra biámagua lidan aban habacharaguba hawougua, ánheinti ábanrügü, ida lubagia labacharagun? <verse eid="ECC 4:11" /><verse number="12" style="v" sid="ECC 4:12" />Ábanrügü lábugua ménrengubei láfarahoun, gama lumoun biámagua hénrengubei háfarahoun. Gúrudu le ǘrüwaguati, hénrenguti látumuragun.<verse eid="ECC 4:12" /></para>
  <para style="s1">Mama lídanñein uéiyani lichú aau</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 4:13" />Buítimati nibureingili le gudemeti ani chuti lau sügǘ lau urúei wéiyaali gama lumoun ibidiouguati lau, ladüga máhaali lun lererehóuniwa lun. <verse eid="ECC 4:13" /><verse number="14-15" style="v" sid="ECC 4:14-15" />Íbini furisunrugúgiñe lan liabin nibureingili le lunbei larúeihan leweñegua urúei ligía o lídangiñe lan gudemei liabin lun larúeihan. Ariha numuti luagu lúmagiñeñanu lan sun gürigia ha lílana ubóu le. <verse eid="ECC 4:14-15" /><verse number="16" style="v" sid="ECC 4:16" />Ani lau sun gibe hamá gürigia ha lúnbaña lábugiñebaña lan larúeihan, ni gürigia hagía, ni hadügawagun magundanbaña lau. Katei giñe málati lira, ítara liña kei labusenrúniwa lárügüdün garabali.<verse eid="ECC 4:16" /></para>
  <chapter eid="ECC 4" />
  <chapter number="5" style="c" sid="ECC 5" />
  <para style="s1">Gasu lagunfulirúniwa lau le füramasewaalibei</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 5:1" />Danme bidin litenpulunrugun Bungiu, góunigibei ligaburi bóuserun lubaragiñe bíchugun adagaragüdüni kei hadüga híbiri gürigia ibidiougua tau ha mefenbaña luagu wuriba lan le hadügübei, yarafabá aranseñu lun gaganbadi ban.<verse eid="ECC 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 5:2" />Móufudahaba adüga füramasei lun Bungiu, ni lau biyuma ni lidan bisaminan, lugundun siéluñein Bungiu, buguya múarugu. Ligía lubeiti mibelá lubéi badimurehan; <verse eid="ECC 5:2" /><verse number="3" style="v" sid="ECC 5:3" />lugundun lídangiñe liibe saminaü liabin uénedü, lídangiñe liibe dimurei lariñawagúa libidiounigan aau.<verse eid="ECC 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 5:4" />Danme badügün aban füramasei lun Bungiu madarasahabá lun bagunfuliruni, lugundun magundanti Bungiu hau ha ibidiouguabaña aau. Gúnfulibei lubeiti le füramase bubéi, <verse eid="ECC 5:4" /><verse number="5" style="v" sid="ECC 5:5" />lugundun buítimati lun ua lan füramase ban sügǘ lau füramase ban ani magunfuliruntibu.<verse eid="ECC 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 5:6" />Mígiraba lun lafigougüdünibu biyuma, ábame bariñagun ligibugiñe lóunagüle Bungiu luagu bulíeiguarügü ban. Kábagia uagu bagañidagüdei Bungiu lau le bariñagubei agünrinchagueime le adüga báalibei? <verse eid="ECC 5:6" /><verse number="7" style="v" sid="ECC 5:7" />Labadinagua lubeiti saragu luriban uénedü luma saragu dimurei málati, lunti barufuduni lineben Bungiu bun.<verse eid="ECC 5:7" /></para>
  <para style="s1">Ámuñegueina burí katei lidan ibagari</para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 5:8" />Maweiridatá banigi ánhabu ariha lamudirawagun aban gudemeti lidan somu fulasu, adügǘwa ligía anarimeni luma irichaü ñein, lugundun anihein aban úfisi íñutimati lóugiñe aban úfisi íñuti, añahein giñe úfisigu íñutimatiña hóugiñe biángubei hagía. <verse eid="ECC 5:8" /><verse number="9" style="v" sid="ECC 5:9" />Hariñaga: «Sun gürigia dariguatiña houngua áraabu, ánheinti urúei luagu le leresibirubei lídangiñe alubahani dipeni lan!»<verse eid="ECC 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 5:10" />Le hínsiñehabubei lun seinsu súnwandan busén lan lanwoun liseinsun; le hínsiñehabubei lun irisini, súnwandan laritagun luagu lougua lan le lúmabei. Katei giñe málati lira, <verse eid="ECC 5:10" /><verse number="11" style="v" sid="ECC 5:11" />lugundun gagibedun lúmati gürigia, gagibedun lawesirun. Kati lagañeirubei gürigia lau liibe liseinsun bóugudin luéi laríaguni? <verse eid="ECC 5:11" /><verse number="12" style="v" sid="ECC 5:12" />Le nadagimeinbei, gibe yebe leigin mibe yebe leigin, arumugati buidu; ánheinti le rísibei, marumugagüdün lumuti lirisin.<verse eid="ECC 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 5:13" />Anihein aban katei narihin ligibuagu ubóu le ruti íruni: Barǘ lan lareidahóun seinsu wuribani houn gürigia, <verse eid="ECC 5:13" /><verse number="14" style="v" sid="ECC 5:14" />lugundun gayaraati lagumuchun aban marasun mabuidunti lau sun lirisin, ani ánheinti garáü lubéi aban, úaalime ni kata luma lun lígiruni lun. <verse eid="ECC 5:14" /><verse number="15" style="v" sid="ECC 5:15" />Ani ítara kei ligaburi liabin ubouagun, ítara luba lidin: Surusu kei dan le lágurahounbei, manügünga ni kata lídangiñe lebegi luadigimari. <verse eid="ECC 5:15" /><verse number="16" style="v" sid="ECC 5:16" />Barüti katei le íruni le tímatimaati: Lun ítara lan kei liabin ubouagun, ítara lan giñe lidin. Kati lagañeirubei lau luadigimaridun saragu lun ni kata? <verse eid="ECC 5:16" /><verse number="17" style="v" sid="ECC 5:17" />Lanwoun lira, lidan luburiga lásügürei sun libagari, lau saragu ligariga uraü luma lagüürün wuribani tidan lanigi.<verse eid="ECC 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 5:18" />Ariha naali luagu lubuidun-agei lan katei le lunbei wadügüni, lun weigin, watun ani efeduha wameime lebegi wawadigimari ya ubouagu lidan murusun ibagari le líchugubei Bungiu woun lugundun ligía wafanranbei. <verse eid="ECC 5:18" /><verse number="19" style="v" sid="ECC 5:19" />Luéigiñe amu oubaü, sun le unbei líchiga Bungiu saragu irisini, ruti giñe ubafu lun, lun leigin lídangiñe, luma lun lárügüdüni le yuubei lun, lugundun lúmagiñe Bungiu liabin lira. <verse eid="ECC 5:19" /><verse number="20" style="v" sid="ECC 5:20" />Keiti buíngüdalanu Bungiu lanigi gürigia lau ugundani, maweirinti ladiheridun luagu libagari.<verse eid="ECC 5:20" /></para>
  <chapter eid="ECC 5" />
  <chapter number="6" style="c" sid="ECC 6" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1" />Anihein aban wuribani kamaniti narihin hadan gürigia ya ubouagu; <verse eid="ECC 6:1" /><verse number="2" style="v" sid="ECC 6:2" />añahein úntiña líchiga Bungiu saragu irisini luma lubuiduniga, ani memegeiruntiña ni kata lídangiñe le habusenrubei; gama lumoun mígirunti lun hefeduhani hámati, amu efeduhabalin. Aban giñe katei málati lira, ani híruti le tímatimaati! <verse eid="ECC 6:2" /><verse number="3" style="v" sid="ECC 6:3" />Gayaraati garahüñü lan aban wügüri san irahüñü abagarida ligía saragu dan; gama lumoun íbini migife lan labagaridun anhein mefeduhan lan lidaani buidu buidu, ani mábunahoungubeiti dan le lóunwenbei, afiñetina buítimati lan aban irahü le agüriaawaguti luéi wügüri ligía. <verse eid="ECC 6:3" /><verse number="4" style="v" sid="ECC 6:4" />Lugundun lau sun féridi lan irahü ligía lidan ni kata, lidan luburiga, le ñeinba lubéi leredera liri ibidiñounga ni ka un, <verse eid="ECC 6:4" /><verse number="5" style="v" sid="ECC 6:5" />lau sun machülü lan arihei weyu, masubudirun ligía ni kata, emeraaguati sügǘ lau wügüri buga ligía, <verse eid="ECC 6:5" /><verse number="6" style="v" sid="ECC 6:6" />le buga gayaraabei labagaridun bián-milu irumu, gama lumoun mefeduhan laali lubuidun lidaani. Ani lidan lagumuhóun dan, lídounbaña ábanmeme fulasu súngubei!<verse eid="ECC 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 6:7" />Nadagimeinti gürigia saragu lun leigin, gama lumoun makimuledunti <verse eid="ECC 6:7" /><verse number="8" style="v" sid="ECC 6:8" />kagia lúmaña chu tau le úati luma ibidiougua tau, luéidigia lisubudin lun gayaraabei lan lageindaguni ibagari?<verse eid="ECC 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 6:9" />Buítimati le arihúbei sügǘ lau le haritawagúarügübei luagun. Gama lumoun katei giñe málati lira, ítara liña kéigubeirügü labusenrúniwa lárügüdün garabali. <verse eid="ECC 6:9" /><verse number="10" style="v" sid="ECC 6:10" />Sun le aniheinbei guentó, binarü giri lan ani subudiwati katei lan. Siñati lageindagun gürigia luma le gabafutimabei luéi. <verse eid="ECC 6:10" /><verse number="11" style="v" sid="ECC 6:11" />Anihein aban katei inarüniti: Ñein lumuti saragu dimurei, gíbeti libidiounigan aau ñein, ani magañeirúnwati ni kata lau lira. <verse eid="ECC 6:11" /><verse number="12" style="v" sid="ECC 6:12" />Úati ni aban subudihabúti ka lan buítimabei lun gürigia lidan murusunraü dan le ladurarubei, katei málati le libagaribei. Lásügürüba lidaani kei aban lamuñounga, ani kábati ariñagei le lunbei lasuseredun lidan ubóu le lun lárigiñe lounwen?<verse eid="ECC 6:12" /></para>
  <chapter eid="ECC 6" />
  <chapter number="7" style="c" sid="ECC 7" />
  <para style="s1">Mosu wetenirun lun katei le súdinitimabei</para>
  <para style="q">
    <verse number="1" style="v" sid="ECC 7:1" />Buítimati buidu lan ladimurehóuniwa luagu gürigia</para>
  <para style="q" vid="ECC 7:1">sügǘ lau ibiñein buiti.</para>
  <para style="b" vid="ECC 7:1" />
  <para style="q" vid="ECC 7:1">Buítimati luéyuri óunweni</para>
  <para style="q" vid="ECC 7:1">sügǘ lau luéyuri águrahouni.<verse eid="ECC 7:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ECC 7:2" />Buítimati lidiniwa ábunaha sügǘ lau lidiniwa efeduha,</para>
  <para style="q" vid="ECC 7:2">lugundun óunweni hagumuchagülebei sun gürigia,</para>
  <para style="q" vid="ECC 7:2">lunti hamugati haritagun ha wínwangiñabaña luagun.<verse eid="ECC 7:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ECC 7:3" />Buítimati ayahuni sügǘ lau éherahani,</para>
  <para style="q" vid="ECC 7:3">lugundun wuribati ladüga ayahuni lun igibu</para>
  <para style="q" vid="ECC 7:3">gama lumoun buiti ladüga tun anigi.<verse eid="ECC 7:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ECC 7:4" />Saminati chu tau luagun óunweni,</para>
  <para style="q" vid="ECC 7:4">ánheinti ibidiougua tau,</para>
  <para style="q" vid="ECC 7:4">sun lisaminan luagun lefeduhan.<verse eid="ECC 7:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ECC 7:5" />Buítimati laganbún leweridihan chu tau</para>
  <para style="q" vid="ECC 7:5">sügǘ lau habimehan ibidiougua tau.<verse eid="ECC 7:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ECC 7:6" />Lugundun ítara liña léherahan ibidiougua tau</para>
  <para style="q" vid="ECC 7:6">kei láhurahan hiiyu wáturugu,</para>
  <para style="q" vid="ECC 7:6">ani katei giñe málati lira.<verse eid="ECC 7:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ECC 7:7" />Ibidiouguagüda lumuti anarimeni lau chu tau,</para>
  <para style="q" vid="ECC 7:7">günringua lumuti giñe idewesei lóuserun.<verse eid="ECC 7:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ECC 7:8" />Buítimati lagumuchun aban katei</para>
  <para style="q" vid="ECC 7:8">sügǘ lau lagumeserun.</para>
  <para style="b" vid="ECC 7:8" />
  <para style="q" vid="ECC 7:8">Buítimati gaguraasun ban</para>
  <para style="q" vid="ECC 7:8">sügǘ lau ganigi ban.<verse eid="ECC 7:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="ECC 7:9" />Mígiraguagüdaba bungua lun igañi, lugundun gürigia ibidiougua tau agañidubaña.<verse eid="ECC 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 7:10" />Málügüdaguaba bungua ka lan uagu buídutima lubéi sun dan le sügühalibei, lugundun mama álügüdahani lánina lichú aau lira.<verse eid="ECC 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 7:11" />Buítimati lichú aau houn ha awinwandubaña ya ubouagu, anhein anihein lubéi aban alagan úara luma lichú aau ligía. <verse eid="ECC 7:11" /><verse number="12" style="v" sid="ECC 7:12" />Lugundun ounigihati lichú aau kéigubeirügü seinsu, gama lumoun buítimati lichú aau ladüga ruti ibagari lun chu tau.<verse eid="ECC 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 7:13" />Arihabá buidu lun katei le ladügübei Bungiu: Kábagia gayara lásuuragüdüni le segé laalibei Bungiu? <verse eid="ECC 7:13" /><verse number="14" style="v" sid="ECC 7:14" />Dan le buidu lan lidin bun, efeduhabéi lubuidun dan ligía, gama lumoun dan le wuriba lan lidin bun, haritaguabá luagu Bungiu lan íchugubalin biángubei katei ligía, ani ibidiñeti giñe lun gürigia kaba lan lanüga dan le machülügilibei lun.<verse eid="ECC 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 7:15" />Ariha naali sun le, lidan katei málati le nibagaribei: Hóunwegun gürigia buítiña lau sun hareidun, ánheinti wuribatiña nibagaritiña saragu dan lau sun hariban.<verse eid="ECC 7:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="ECC 7:16" />Moun lumuti lásügürün lueirin bubuidun,</para>
  <para style="q" vid="ECC 7:16">ni lun lásügüragun lueirin lichú bau,</para>
  <para style="q" vid="ECC 7:16">kábagia uagu lagadeiragúa gürigia lungua?<verse eid="ECC 7:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ECC 7:17" />Másügüraguala buriban,</para>
  <para style="q" vid="ECC 7:17">ni libidiounigan bau,</para>
  <para style="q" vid="ECC 7:17">kábagia uagu wóunwegua lubaragiñe dan?<verse eid="ECC 7:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ECC 7:18" />Le buídubei lun ladügǘn,</para>
  <para style="q" vid="ECC 7:18">lun lárügüdüniwa aban katei buidu mígiragüdünga le aban.</para>
  <para style="b" vid="ECC 7:18" />
  <para style="q" vid="ECC 7:18">Le íchugubei inebesei lun Bungiu</para>
  <para style="q" vid="ECC 7:18">buídubei láfuridun lídangiñe sun katei le.<verse eid="ECC 7:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="ECC 7:19" />Rútimati lichú aau erei lun chu tau</para>
  <para style="q" vid="ECC 7:19">sügǘ lau híchugun diisi agumadihatiña erei lun aban uburugu.<verse eid="ECC 7:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="ECC 7:20" />Lau sun lira, úati ni aban gürigia úaraguati ubouagu le adügüti buiti súnwandan lun mafigouhanbei lan.<verse eid="ECC 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ECC 7:21" />Madügabá gasu lau sun le ariñawagúbei, ítara luba maganbunbani danme ladimurehan bumusun wuriba buagu. <verse eid="ECC 7:21" /><verse number="22" style="v" sid="ECC 7:22" />Íbini buguya, subudi bumuti giñe buidu luagu adimureha ban wuriba hawagu amu saragu wéiyaasu.<verse eid="ECC 7:22" /></para>
  <para style="s1">Láluahouniwa subudi</para>
  <para style="p">
    <verse number="23" style="v" sid="ECC 7:23" />Houcha numuti sun le lau lichú aau, nariñaga: Náluga lachuurun nau; gama lumoun díseti buga lichú aau nuéi. <verse eid="ECC 7:23" /><verse number="24" style="v" sid="ECC 7:24" />Sun le aniheinbei, díseti nuéi! Huliliyati ani siñati gunfurandawa lan!<verse eid="ECC 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ECC 7:25" />Ábati níchaagun nungua lun nárügüdün subudi, lun naturiahan áluaha lóunabaha nálügüdahan. Aba narihini luagu mabuidun lan libidiounigan aau, lílülün lan aau lidere ichügü.<verse eid="ECC 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ECC 7:26" />Darihadina aban katei gífitimati sügǘ lau óunweni: Würi to gasadaranboun tidan tanigi, to muruboun óuburahan lau tarüna. Ani le unbei hínsiñehabu lan Bungiu lesefuruba tuéi, ánheinti le gafigounbei lábürühaba tidoun tisadaran.<verse eid="ECC 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ECC 7:27" />Lidan náluahan nadariruni lébuna burí katei, au, le apurichihati, anihán burí katei le nadarirubei: <verse eid="ECC 7:27" /><verse number="28" style="v" sid="ECC 7:28" />Luagu madari nágili lan le náluahabei! Darihadina aban wügüri haganagua milu, gama lumoun madaritina ni aban würi hadan sun würiña. <verse eid="ECC 7:28" /><verse number="29" style="v" sid="ECC 7:29" />Ábanrügüñein katei nadarirun, anihán katei ligía: Luagu úaragua lan ladügüni Bungiu wügüri, gama lumoun añawariguaali wügüri lungua.<verse eid="ECC 7:29" /></para>
  <chapter eid="ECC 7" />
  <chapter number="8" style="c" sid="ECC 8" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 8:1" />Ka gayaraabei líchaagun lungua lóubawagu chu tau? Ka gayaraabei lasubudiruni lébuna burí katei? Harugoungadagüda lumuti lichú aau ligibu gürigia, adüga ligía lun lasansirun lihürü ligibu.<verse eid="ECC 8:1" /></para>
  <para style="s1">Gaganbadi lun urúei</para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 8:2" />Gúnfulibei le lubeibei urúei, lugundun ítara liña báfiñuruni ligibugiñe Bungiu. <verse eid="ECC 8:2" /><verse number="3" style="v" sid="ECC 8:3" />Máfuridaba ligibugiñegiñe lau saragu furesei, madan labu burí katei wuribati, lugundun, gayaraati ladügüni le labusenrun. <verse eid="ECC 8:3" /><verse number="4" style="v" sid="ECC 8:4" />Lúmañein urúei lagumuhóun dimurei, ani úati ni aban lun lálügüdaguni luagu sun le adüga láalibei.<verse eid="ECC 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 8:5" />Le agunfuliruti aban lúrudu, masuseredunbei ni kata wuribati lun, ani le chubei au gunfuranda lumuti ídaame lan ani ida luba lan lagunfuliruni. <verse eid="ECC 8:5" /><verse number="6" style="v" sid="ECC 8:6" />Le linarün aban katei, anihein dan luma igaburi lun ladügǘn sun le adügǘbei, gama lumoun le lánibei gürigia turobuli <verse eid="ECC 8:6" /><verse number="7" style="v" sid="ECC 8:7" />ibidiñe lan lun kaba lan asusereda, ua ligía kaba lan asubudiragüdei lun.<verse eid="ECC 8:7" /></para>
  <para style="s1">Úati gabafuti luagu ibagari luma óunweni</para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 8:8" />Úati gürigia gabafuti lun leredehani ibagari, ua ligía gabafuti luagu óunweni. Úati lunti lesefurun lídangiñe wuribu le. Gürigia le wuribabei, mesefurun lubéi luriban.<verse eid="ECC 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 8:9" />Anihán sun katei le narihibei, dan le níchaagunbei nungua sunsuinagubei lun nasubudiruni ka lan adügǘbei ligibuagu ubóu le, luma ubafu le luágubei gürigia lun ladügün damichi lun gürigia líledi.<verse eid="ECC 8:9" /></para>
  <para style="s1">Gürigia buítiña hama wuribatiña</para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 8:10" />Arihaadina giñe luagu gürigia lan ha wuribabaña, ha mídindadibaña lidan fulasu sánduti, adimurehóua lan buidu hawagu dan le hábunahoun; ani maritawagúnti wuribani le bugaha hadügübei lidan uburugu le ñein lubéi hadügei. Málati giñe katei lira. <verse eid="ECC 8:10" /><verse number="11" style="v" sid="ECC 8:11" />Lugundun, anhein masiadirún gürigia lárigiñe ladügün wuribani, lerederamémeba aritagua ladügün wuribani. <verse eid="ECC 8:11" /><verse number="12" style="v" sid="ECC 8:12" />Ítarati, le abagaridubei lidan figóu, migifeti libagari! Le nasubudirubei luagu buidu lan lidin houn ha inebehabubaña lun Bungiu; <verse eid="ECC 8:12" /><verse number="13" style="v" sid="ECC 8:13" />ánhaña ha wuribabaña, wuribabei lidin houn, sügüti habagari kei lásügürün aban lamuñounga, ladüga marufudun hamá inebehabu ligibugiñe Bungiu. <verse eid="ECC 8:13" /><verse number="14" style="v" sid="ECC 8:14" />Ya lubeiti ligibuagu ubóu le, susereti katei málati, hasufurirun gürigia buítiña kamá hamuga wuribatiña, luma giñe hagundaarun gürigia wuribatiña kamá hamuga buítiña. Nariñahare luagu katei lan giñe málati sun lira!<verse eid="ECC 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 8:15" />Ligía lúmagiñeñadina lubéi ugundani. Ani lubuidun-agei katei le lunbei ladügüni gürigia ya ligibuagu ubóu le, lun leigin, latun luma lefeduhan, lugundun ligíarügüñein eredera lun lídangiñe luadigimari lidan ibagari le líchugubei Bungiu lun ligibuagu ubóu le.<verse eid="ECC 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 8:16" />Gíchaagun áutima nungua lun nafurendeiruni, lun nasubudiruni luma lun narihini —sun le adügǘbei ligibuagu ubóu le chülüti dan lun siñá lan larumugun gürigia ni murusun—, <verse eid="ECC 8:16" /><verse number="17" style="v" sid="ECC 8:17" />arihatima numuti luagu siñá lan gunfurandalani gürigia le ladügübei Bungiu ni le asuseredubei ya ubouagu. Ida lan yebe láfaagun lidan sun luwuyeri áluahei lóunabagüle, madari lubéi; lau sun ariñaga lan chu tau luagu subudi lani, lidan linarün katei siñá lágili adarira.<verse eid="ECC 8:17" /></para>
  <chapter eid="ECC 8" />
  <chapter number="9" style="c" sid="ECC 9" />
  <para style="s1">Ámuya burí katei luáguti ibagari luma óunweni</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1" />Deregeguaadina nungua sunsuinagubei lun burí katei le, lúnrügü nadariruni luagu lúhaburuguñein lan Bungiu hawadigimari gürigia buítiña hama gürigia chu tau. Ibidiñeti luáguti ínsiñehabuni luma iyereehabúni lun gürigia, ni íbini danme lábugiñeñein lan larihin. <verse eid="ECC 9:1" /><verse number="2" style="v" sid="ECC 9:2" />Ábanmeme katei agurabubaliña súngubei: Le úaraguabei luma le múaranbei, le buídubei luma le wuribabei, le harumabei luma le wíyebei; le adagaragüdübei luma le madagaragüdünbei, dandu le buídubei kei le gafigounbei le áfiñurubei kei le máfiñurunbei.<verse eid="ECC 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 9:3" />Anihán katei le wuribabei lídangiñe sun le asuseredubei ya ubouagu: Ábanmeme lan katei agurabubaliña súngubei. Luéigiñe aban oubaü, buin liña lisaminan gürigia lau wuribani, lau libidiounigan aau lidan sun libagari; lárigiñe sun lira, ganbusandun!<verse eid="ECC 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 9:4" />Hemenigitimati le gabagarigilibei, ladüga buítimati ounli wínwangili sügǘ lau liñún hilaali. <verse eid="ECC 9:4" /><verse number="5" style="v" sid="ECC 9:5" />Ha giñe wínwangiñabaña subudi hamuti luagu hóunweguba lan, ánhaña ha hilaañabaña ibidiñeti ni kata houn, magañeirun hagía ni kata, lugundun rúaña lidoun bulíeiguaü. <verse eid="ECC 9:5" /><verse number="6" style="v" sid="ECC 9:6" />Ñein lagumucha hínsiñehabu, hayereehabu luma hayumahan, mafanrandigiaaña lidan ni kata lídangiñe le adügǘbei ya ubouagu.<verse eid="ECC 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 9:7" />Ítara liña lubeiti! Houboun beigan fein gurabóunme buniñe diwéin lau ugundani, ladüga gúndaahali Bungiu lau le badügübei. <verse eid="ECC 9:7" /><verse number="8" style="v" sid="ECC 9:8" />Dáüguaba daüguaü harutu súnwandan; ru buguyame ibiñein bábulugu. <verse eid="ECC 9:8" /><verse number="9" style="v" sid="ECC 9:9" />Efeduhabéi bibagari tuma würi to hínsiñeboun bun, lídanmeme ibagari le líchugubei Bungiu bun ya ubouagu. Ligíarügüba basagara lídangiñe saragu buadigimari ya ligibuagu ubóu le. <verse eid="ECC 9:9" /><verse number="10" style="v" sid="ECC 9:10" />Sun le gayaraabei badügüni, adügabéi lau sun biyaraati; lugundun lidan umúahaü, le lunbei ñéinhinba lan badagara, madügǘnti ni kata ñein maritawagún ni kata, úati subudi ni lichú aau ñein.<verse eid="ECC 9:10" /></para>
  <para style="s1">Marichaü burí lidan ibagari</para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 9:11" />Anihein giñe aban katei narihin ligibuagu ubóu le: Luagu mama lan ha furesebaña agañeirubalin éibaaguni, ni ha ganigibaña agañeirei wuribu; luagu mama lan súnwandan geigan hamá chu tau fein, marisin hagía huali tichügü, meresibirúniwa hagía furendeitiña buidu súnwandan, sun hagía agurabarügütiña murusun lidaani ubunuruni: <verse eid="ECC 9:11" /><verse number="12" style="v" sid="ECC 9:12" />Luéigiñe le aban oubaü, ibidiñeti lun ni aban ídaba lan lachülüra lidaani lun: Ítara kei tanügüniña seni úduraü, ítara kei hábürühan dunuru tidoun sádara, ítara liña giñe gürigia lidan magaradahan lan, ligía lábürühan.<verse eid="ECC 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13" />Anihein giñe aban katei narihin ya ubouagu le ídanbei nariha aban óunwenbu arufudahani: <verse eid="ECC 9:13" /><verse number="14" style="v" sid="ECC 9:14" />Aban liraüraü uburugu, hau fiuraü gürigia aganóutiña lidan, ábürühati aban urúei gabafuti luagun, aba legeyedaguni lun lageindagun luma. <verse eid="ECC 9:14" /><verse number="15" style="v" sid="ECC 9:15" />Lidan uburugu ligía anihein aban wügüri gudemeti aganóua ñein, gama lumoun chuti lau ani gayaraabei hamuga lesefuruni uburugu lau lichú lau, ani úati aritaguti luagun!<verse eid="ECC 9:15" /></para>
  <para style="s1">Ligibuagu sun katei, lichú aau</para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 9:16" />Gama lumoun chouru numuti luagu buítima lan chu lan lau gürigia sügǘ lau ganigi lan, íbini anhein mabahüdǘn lubéi lichú lau gürigia gudemeti meberesenwa ligía lau le lariñagubei.<verse eid="ECC 9:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ECC 9:17" />Aganbúatimati hererun chu tau lau darangilaü</para>
  <para style="q" vid="ECC 9:17">sügǘ lau lagúarahan harúeite ibidiougua tau.<verse eid="ECC 9:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ECC 9:18" />Buítimati lichú aau sügǘ tau áruma to lánina wuribu.</para>
  <para style="b" vid="ECC 9:18" />
  <para style="q" vid="ECC 9:18">Ábanrügü bulíeiguaü barüti óunwenbu günringuaü.<verse eid="ECC 9:18" /></para>
  <chapter eid="ECC 9" />
  <chapter number="10" style="c" sid="ECC 10" />
  <para style="q">
    <verse number="1" style="v" sid="ECC 10:1" />Aban werewere hilaali,</para>
  <para style="q" vid="ECC 10:1">híngiti ani féridigüda lumuti lubuidun líhemen ibiñein.</para>
  <para style="b" vid="ECC 10:1" />
  <para style="q" vid="ECC 10:1">Abahüdǘwatimati libidiounigan aau le furesebei</para>
  <para style="q" vid="ECC 10:1">sügǘ lau lichú aau le inebewatimabei.<verse eid="ECC 10:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ECC 10:2" />Luagun katei le buídubei</para>
  <para style="q" vid="ECC 10:2">labalacha lisaminan gürigia le chubei au,</para>
  <para style="q" vid="ECC 10:2">ánheinti ibidiougua tau</para>
  <para style="q" vid="ECC 10:2">luagun katei le wuribabei labalacha lisaminan.<verse eid="ECC 10:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ECC 10:3" />Le ibidiouguabei au,</para>
  <para style="q" vid="ECC 10:3">arufuda lumuti lugudemen lisaminan lidan sun le ladügübei,</para>
  <para style="q" vid="ECC 10:3">íbini lidan lariñagun luagu ha lan híbiri ibidiouguabaña au.<verse eid="ECC 10:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ECC 10:4" />Anhein agañida le agumadihabei buma,</para>
  <para style="q" vid="ECC 10:4">meferidirabéi bichügü;</para>
  <para style="q" vid="ECC 10:4">ladüga lanügǘn katei lau gálumaü</para>
  <para style="q" vid="ECC 10:4">láranibei bulíeiguaü le wéiriti.<verse eid="ECC 10:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="ECC 10:5" />Arihaadina aban bulíeiguaü adügǘti ligibuagu ubóu le, ani hádangiñe guánarügü agumadihatiña liabin: <verse eid="ECC 10:5" /><verse number="6" style="v" sid="ECC 10:6" />Luagu rúa lan aban ubaraü íñuguti lun ibidiougua tau, lichugúati ubaraü ǘnabuti houn gürigia ha chúbaña au. <verse eid="ECC 10:6" /><verse number="7" style="v" sid="ECC 10:7" />Arihaadina burí idamuni luagu gabayu, ánhaña burí harahüñü urúei eibu kamá hamuga idamuni hagía.<verse eid="ECC 10:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ECC 10:8" />Le achigiti huyu, héiguati lidoun.</para>
  <para style="b" vid="ECC 10:8" />
  <para style="q" vid="ECC 10:8">Le abouchaguti baríeiru gürǘ tumuti hewe.<verse eid="ECC 10:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ECC 10:9" />Le abouchaguti dübü, buleseiti lau.</para>
  <para style="q" vid="ECC 10:9">Le abouhati watu, ménrengubei láchuagun lungua.<verse eid="ECC 10:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ECC 10:10" />Anhein agumucha tamana harawa lunya mayaradún tan,</para>
  <para style="q" vid="ECC 10:10">mosu héretima lan lagayuahóun tau.</para>
  <para style="b" vid="ECC 10:10" />
  <para style="q" vid="ECC 10:10">Buítimati ladügǘn katei buidu ani lau lichú aau.<verse eid="ECC 10:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ECC 10:11" />Kagia un hu lan aban arumaagüdüti hewe,</para>
  <para style="q" vid="ECC 10:11">anhoun ágürüha hewe lubaragiñe larumaagüdünu?<verse eid="ECC 10:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ECC 10:12" />Hínsiñeguti lererun gürigia chu tau.</para>
  <para style="q" vid="ECC 10:12">Ánheinti ibidiougua tau barüti lererun günringuaü lun guánarügü;<verse eid="ECC 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ECC 10:13" />lagumesera adimureheina libidiounigan aau,</para>
  <para style="q" vid="ECC 10:13">lagumucha ariñageina luriban-agei dimurei.<verse eid="ECC 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ECC 10:14" />Memegeirunti dimurei lun ibidiougua tau!</para>
  <para style="b" vid="ECC 10:14" />
  <para style="q" vid="ECC 10:14">Ka gayaraabei lariñaguni le lunbei lasuseredun,</para>
  <para style="q" vid="ECC 10:14">ibidiñounga le lunbei liabin ni ka un?<verse eid="ECC 10:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ECC 10:15" />Héreti láfaagun ibidiougua tau lungua nadagimein,</para>
  <para style="q" vid="ECC 10:15">darí lun ibidiñe lan ni lémeri uburugu lun.<verse eid="ECC 10:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="ECC 10:16" />Fugiabu ageiraü le ñǘraügilibei lurúeite,</para>
  <para style="q" vid="ECC 10:16">ageiraü le ñein lubéi harugadúa lirahüñü urúei lidan fedu!<verse eid="ECC 10:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ECC 10:17" />Fuleseiwati aban ageiraü le garúeiteti aban urúei le inebewati,</para>
  <para style="q" vid="ECC 10:17">le ñein lubéi heiga agumadihatiña lidan lidaani éheraaguni,</para>
  <para style="q" vid="ECC 10:17">lun hárügüdüniya here, mama lun habacharuadun!<verse eid="ECC 10:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ECC 10:18" />Ha magúalibaña, héiguati tábulugu haban;</para>
  <para style="q" vid="ECC 10:18">ha madügünbaña ni kata, héiguatu haban sunsuinagubei.<verse eid="ECC 10:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="ECC 10:19" />Fein luntu teigín,</para>
  <para style="q" vid="ECC 10:19">diwéin lun lefeduhóun ibagari;</para>
  <para style="q" vid="ECC 10:19">gama lumoun lun sun lira mégeiwati seinsu.<verse eid="ECC 10:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="ECC 10:20" />Madimurehabá wuriba luagu urúei ni íbini lidan baritagun.</para>
  <para style="b" vid="ECC 10:20" />
  <para style="q" vid="ECC 10:20">Madimurehabá wuriba luagu rísiti,</para>
  <para style="q" vid="ECC 10:20">íbini bábuguarügüñadibu lan,</para>
  <para style="q" vid="ECC 10:20">lugundun áhamahatiña dunuru</para>
  <para style="q" vid="ECC 10:20">ani gayaraabei houdin ariñagei lun.<verse eid="ECC 10:20" /></para>
  <para style="b" />
  <chapter eid="ECC 10" />
  <chapter number="11" style="c" sid="ECC 11" />
  <para style="q">
    <verse number="1" style="v" sid="ECC 11:1" />Chüboun beigan fein dúnarugun;</para>
  <para style="q" vid="ECC 11:1">tagiribudayaba bun dan luagun dan.<verse eid="ECC 11:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ECC 11:2" />Afanreinhabei búmati le biyaraati,</para>
  <para style="q" vid="ECC 11:2">lugundun ibidiñeti wuribani</para>
  <para style="q" vid="ECC 11:2">le gayaraabei liabin luagun ageiraü bun.<verse eid="ECC 11:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ECC 11:3" />Anhein gala lubéi dúeri duna,</para>
  <para style="q" vid="ECC 11:3">ábürühati huya luagun múa,</para>
  <para style="q" vid="ECC 11:3">gayaraati lábürühan tídibu wewe luagun nórute o luagun lan suru,</para>
  <para style="q" vid="ECC 11:3">le ñeinhin lumuti lábürüha, ñeinba leredera.<verse eid="ECC 11:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ECC 11:4" />Le erederuti aríagua garabali mábunagunbei,</para>
  <para style="q" vid="ECC 11:4">le erederuti aríaaha dúerirugun, malubahanbei.<verse eid="ECC 11:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="ECC 11:5" />Ítara kei ibidiñe lan bun haliñoun lan lidin garabali, ni ida liña lan ladügǘn irahü turageirugu lúguchu, ítara giñe ibidiñe lan ni kata bun luagu le ladügübei Bungiu le adügübalin sun katei.<verse eid="ECC 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 11:6" />Bunabei binadüri binaafin, bunabei giñe rábounweyu, lugundun ibidiñewati kaba lan buídutima, anhein le lubéi bábunubei furumiñe o le lan libiaman o buídubei lan biángubei.<verse eid="ECC 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 11:7" />Buiti larugounga, buiti giñe lun larihini agu weyu; <verse eid="ECC 11:7" /><verse number="8" style="v" sid="ECC 11:8" />gama lumoun íbini labagaridun gürigia saragu dan, efeduhaléi sun dan ligía, lunti laritagun luagu saragubei lan lidaani luburiga, ani ugundani lan málati sun le lunbei liabin.<verse eid="ECC 11:8" /></para>
  <para style="s1">Eweridihani houn nibureingiña</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 11:9" />Befeduha nibureingili, guentó luagu buin biña lan lau ibagari; efeduhabéi le buídubei guentó le auti biyara, ígiraguagüdaba bungua lun le tariñagubei banigi bun, luma sun le barihubei, gama lumoun haritaguabá luagu laguseragüdübadibu lan Bungiu luagu sun katei le. <verse eid="ECC 11:9" /><verse number="10" style="v" sid="ECC 11:10" />Dísegüdabei idiheri lídangiñe bisaminan, fuibei súfuri buáriua, lugundun íbini lubuidun-agei lidaani nibureini, katei giñe málati.<verse eid="ECC 11:10" /></para>
  <chapter eid="ECC 11" />
  <chapter number="12" style="c" sid="ECC 12" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 12:1" />Haritaguabá luagu Bungiu guentó lau nibureingidibu lan, lau machülügili lan lénrengunga; anitebei dan lun bariñagun: «Manügünti nibagari ni murusun ugundani nun». <verse eid="ECC 12:1" /><verse number="2" style="v" sid="ECC 12:2" />Adügabéi guentó, lau méñeguchungili lan laruni weyu, hati hama waruguma, guentó luagu aniheingua lan dúeri lárigiñe láhuyun huya. <verse eid="ECC 12:2" /><verse number="3" style="v" sid="ECC 12:3" />Lachülürüba weyu lun hadadagarun óunigirutiña luban urúei, hudugua hagíame ganigitiña; halouguaduba amulihatiña darime lun mamulihanhaña lan, ha aríaahabaña lídangiñe funedera, hagumeseruba eferidirei harihin. <verse eid="ECC 12:3" /><verse number="4" style="v" sid="ECC 12:4" />Danme lachülürün weyu ligía, ladouruba burí bena le ǘmadarugunbei; eberesereina luba liréin amuligülei; haganbagüdübei dunuru hamalali, gama lumoun maganbúnhalime uremu. <verse eid="ECC 12:4" /><verse number="5" style="v" sid="ECC 12:5" />Lanufudedúaba luéi íñuni, ñeinbei denchaü ǘmadarugu.</para>
  <para style="b" vid="ECC 12:5" />
  <para style="q" vid="ECC 12:5">Láharuduba ídiburi,</para>
  <para style="q" vid="ECC 12:5">leferidiruba lisemén iyumulugu.</para>
  <para style="q" vid="ECC 12:5">Lugundun lídinñame gürigia lidoun lubara le magumuchadibei,</para>
  <para style="q" vid="ECC 12:5">ani haganbúba ha ayahubalin lounwen ǘmadarugu.<verse eid="ECC 12:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="ECC 12:6" />Haritaguabá luagu Bubungiute guentó lau mátumuragungili lan güringüri lauti pülata, mabouchagun ligía sóudieru lauti golu; guentó lau mabouchagungili lan ágeidinaü laru duna, magünrinchagun ligía ubalabalaü le arariragüdübalin ágeidinaü lun lasagarun duna lídangiñe fusu. <verse eid="ECC 12:6" /><verse number="7" style="v" sid="ECC 12:7" />Lárigiñeme lira ábame lagiribudun kaliki lárigoun múarugun, giribu ligíame sífiri lárigoun lun Bungiu le íchugubalin.<verse eid="ECC 12:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ECC 12:8" />Ariñagayatina au le apurichihati:</para>
  <para style="q" vid="ECC 12:8">Málati sun katei, málati sun katei!</para>
  <para style="q" vid="ECC 12:8">Sun katei málati!<verse eid="ECC 12:8" /></para>
  <para style="ms">III. Ásuruni</para>
  <para style="mr">(<ref loc="ECC 12:9-14">12.9-14</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9" />Kei lachuuruntima lau apurichihati, ítara larufudahantima houn gürigia. Aturiahati giñe saragu ariñawagúni, aransehaléi lidan lubudubu. <verse eid="ECC 12:9" /><verse number="10" style="v" sid="ECC 12:10" />Áfaaguati lun ladariruni dimurei burí le richabei lun labürühani inarüni burí le.<verse eid="ECC 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 12:11" />Hererun burí chu tau ítara liña kei katei gágiriti, le lárigiñebei oundarúaali lan, ítara liña kei wewe charuguti le láchourun ábanrügü amainiruti mudún.<verse eid="ECC 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 12:12" />Luéinamun eweridihani lasagarubei gürigia lídangiñe. Súnwandan tadaawaguba lan garudia, ani buchagüdati saragu aturiahani luagu gürigia.<verse eid="ECC 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 12:13" />Gumuha yanu. Ariñawagúaali sun katei. Ruba inebesei lun Bungiu, gúnfulibei lugumadin lugundun ligía lunbei hadügüni gürigia. <verse eid="ECC 12:13" /><verse number="14" style="v" sid="ECC 12:14" />Laguseragüdübadiwa Bungiu luagu sun le wadügübei dandu le buídubei kei le wuribabei, íbini aramudaguarügü lan wadügei.<verse eid="ECC 12:14" /></para>
  <chapter eid="ECC 12" />
</usx>