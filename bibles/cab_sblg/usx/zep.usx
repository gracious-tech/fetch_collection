<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ZEP" style="id">SOFONÍASI.TXT (Encoding update 2008) 27/02/2001 CAP C.R, GARIFUNA</book>
  <para style="h">Sofoníasi</para>
  <para style="toc3">Sof</para>
  <para style="toc2">Sofoníasi</para>
  <para style="toc1">Sofoníasi</para>
  <para style="mt2">Liliburun</para>
  <para style="mt1">SOFONÍASI</para>
  <chapter number="1" style="c" sid="ZEP 1" />
  <para style="ms">I. Luéyuri Laguseragüdün Bungiu</para>
  <para style="mr">(<ref loc="ZEP 1:1-2:3">1.1—2.3</ref>)</para>
  <para style="s1">Luéyuri ligañi Wabureme</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1" />Anihán uganu le líchugubei Wabureme lun Sofoníasi lidan dan le Hosíasi lan le liráü Amón lurúeitebei Hudá. Liráü bugaha Kusí Sofoníasi, Kusí liráü Gedalíasi, Gedalíasi liráü Amaríasi, Amaríasi liráü Esekíasi.<verse eid="ZEP 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ZEP 1:2" />Lariñahare Wabureme:</para>
  <para style="q" vid="ZEP 1:2">«Nagünrinchaguaali sun le ligibuagubei ubóu sunsuinagubei.<verse eid="ZEP 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEP 1:3" />Nagünrinchagubaña gürigia,</para>
  <para style="q" vid="ZEP 1:3">animaalugu, dunuru hama úduraü,</para>
  <para style="q" vid="ZEP 1:3">nachugeraguagüdübaña gürigia wuribatiña,</para>
  <para style="q" vid="ZEP 1:3">ábame nagumuchaguagüdüniña gürigia ubouagugiñe».</para>
  <para style="b" vid="ZEP 1:3" />
  <para style="q" vid="ZEP 1:3">Lariñahare Wabureme:<verse eid="ZEP 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEP 1:4" />«Niñurubei núhabu luagun Hudá</para>
  <para style="q" vid="ZEP 1:4">hama sun ha aganóubaña Herusalén.</para>
  <para style="q" vid="ZEP 1:4">Nagidarubei sun lárigirugu Baali lídangiñe fulasu le,</para>
  <para style="q" vid="ZEP 1:4">íbini hiri lufadirinigu nagidarubei ñéingiñe.<verse eid="ZEP 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEP 1:5" />Nagünrinchagubaña ha awarihabaña tábulugun muna</para>
  <para style="q" vid="ZEP 1:5">lun háhuduragun houn waruguma</para>
  <para style="q" vid="ZEP 1:5">hama ha áhuduragubaña áfiñureina luagu niri</para>
  <para style="q" vid="ZEP 1:5">úareina luma luagu liri bungiu Milükómu.<verse eid="ZEP 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEP 1:6" />Nagünrinchagubaña giñe ha adireirubaña nuéi,</para>
  <para style="q" vid="ZEP 1:6">ha máluahanbalina, miabin hagía álügüdaha numa».<verse eid="ZEP 1:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ZEP 1:7" />Maní humá ligibugiñe Wabureme,</para>
  <para style="q" vid="ZEP 1:7">ladüga yarafaali luéyuri!</para>
  <para style="q" vid="ZEP 1:7">Aranseli Bungiu aban adagaragüdüni</para>
  <para style="q" vid="ZEP 1:7">ani anúadira laaña ha lagunbirahabaña!<verse eid="ZEP 1:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ZEP 1:8" />Lariñahare Wabureme:</para>
  <para style="q" vid="ZEP 1:8">«Lidan weyu ligía nabeichubaña ábutigu,</para>
  <para style="q" vid="ZEP 1:8">nabeichagubaña giñe lirahüñü urúei</para>
  <para style="q" vid="ZEP 1:8">hama sun ha afalarubalin hechun gibe tubungiutegu.<verse eid="ZEP 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEP 1:9" />Lídanmeme weyu ligía,</para>
  <para style="q" vid="ZEP 1:9">nabeichagubaña giñe ha achubaragubalin bena</para>
  <para style="q" vid="ZEP 1:9">hama ha abuinchagüdübarun haban hamadagu</para>
  <para style="q" vid="ZEP 1:9">lau anarimeni luma iyeeni».<verse eid="ZEP 1:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ZEP 1:10" />Lariñahare Bungiu:</para>
  <para style="q" vid="ZEP 1:10">«Lídanme weyu ligía,</para>
  <para style="q" vid="ZEP 1:10">laganbuba agúarahani amuriaha ídemuei</para>
  <para style="q" vid="ZEP 1:10">lúmagiñe luéigiñe bena le gíribei Habenari Úduraü.</para>
  <para style="q" vid="ZEP 1:10">Hagúarahaba gürigia lídangiñe le aban louba Herusalén,</para>
  <para style="q" vid="ZEP 1:10">ñeinbei óunwenbu liréin günringuaü luéigiñe burí wübü.<verse eid="ZEP 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEP 1:11" />Hayahua, huguya le aganóubei lidan uburugu ǘnabuti,</para>
  <para style="q" vid="ZEP 1:11">ladüga hóunwegua sun alugurahatiña,</para>
  <para style="q" vid="ZEP 1:11">günrinwagua hagíame sun ha adaagubaña marasun lau seinsu!»<verse eid="ZEP 1:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ZEP 1:12" />«Lídanme dan ligía,</para>
  <para style="q" vid="ZEP 1:12">nanügüba aban lanpu ábame nakurukuhani Herusalén.</para>
  <para style="q" vid="ZEP 1:12">Ábameti nabeichaguniña gürigia</para>
  <para style="q" vid="ZEP 1:12">ha darangilubei hasandiragun houngua,</para>
  <para style="q" vid="ZEP 1:12">ha ariñagubaña hóunguarügü:</para>
  <para style="q" vid="ZEP 1:12">“Madügünbei Wabureme ni kata, ni buiti ni wuribati!”<verse eid="ZEP 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEP 1:13" />Ligía lasagarahóuba lubéi harisin,</para>
  <para style="q" vid="ZEP 1:13">günrinwagua tuguyame haban.</para>
  <para style="q" vid="ZEP 1:13">Hábunaguba muna, gama lumoun maganóunbaña tidan,</para>
  <para style="q" vid="ZEP 1:13">hábunaguba beibei, gama lumoun matun baña diwéin».<verse eid="ZEP 1:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ZEP 1:14" />Yarafaali lanarime luéyuri Wabureme!</para>
  <para style="q" vid="ZEP 1:14">Yarafaali, furesegueina liña liabin!</para>
  <para style="q" vid="ZEP 1:14">Gífibei ligaburi luéyuri Wabureme:</para>
  <para style="q" vid="ZEP 1:14">Íbini ha ganigitimabaña hagúarahaba!<verse eid="ZEP 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEP 1:15" />Ábanbei weyu lánina igañi,</para>
  <para style="q" vid="ZEP 1:15">íruni luma idiheri,</para>
  <para style="q" vid="ZEP 1:15">günringuaü, luburiga luma lanarime lamuñounga;<verse eid="ZEP 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ZEP 1:16" />ábanbei weyu tánina fidu luma agúarahani</para>
  <para style="q" vid="ZEP 1:16">ábürüheina luagun burí uburugu le derebugubei</para>
  <para style="q" vid="ZEP 1:16">lau burí liñun luayelesin.<verse eid="ZEP 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ZEP 1:17" />Lariñahare Wabureme:</para>
  <para style="q" vid="ZEP 1:17">«Níchugubaña gürigia lidoun lénrengunga.</para>
  <para style="q" vid="ZEP 1:17">Héibuguba kei marihintiña,</para>
  <para style="q" vid="ZEP 1:17">ladüga hafigouhan nigibugiñe.</para>
  <para style="q" vid="ZEP 1:17">Láwiyuruba hata kei duna,</para>
  <para style="q" vid="ZEP 1:17">lóundaraguba hágürügü kei hádiga animaalugu».<verse eid="ZEP 1:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ZEP 1:18" />Lídanme luéyuri ligañi Wabureme,</para>
  <para style="q" vid="ZEP 1:18">mesefubaña gürigia ni lau pülata ni lau golu,</para>
  <para style="q" vid="ZEP 1:18">ladüga lágudubei ligañi Wabureme sun fulasu.</para>
  <para style="q" vid="ZEP 1:18">Lagünrinchagubaña sun lílana ubóu lidan murusun oura!<verse eid="ZEP 1:18" /></para>
  <chapter eid="ZEP 1" />
  <chapter number="2" style="c" sid="ZEP 2" />
  <para style="q">
    <verse number="1" style="v" sid="ZEP 2:1" />Óundaragua humá huguya gürigia mabusigaritiña,<verse eid="ZEP 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEP 2:2" />lubaragiñe hachagarún kei sagadi sáühali</para>
  <para style="q" vid="ZEP 2:2">le agumuchagubei lidan aban weyu;</para>
  <para style="q" vid="ZEP 2:2">lubaragiñe lábürühan lanarime ligañi Wabureme huagun;</para>
  <para style="q" vid="ZEP 2:2">lubaragiñe lábürühan luéyuri ligañi huagun.<verse eid="ZEP 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEP 2:3" />Áluaha huméi Bungiu sun huguya le ǘnabugubei ya ubouagu,</para>
  <para style="q" vid="ZEP 2:3">huguya le adügübalin le lubeibei.</para>
  <para style="q" vid="ZEP 2:3">Adüga huméi sun katei lidan lúaragun lau ǘnabuguni,</para>
  <para style="q" vid="ZEP 2:3">háfuga ítara luba hadarirun aramudaguagülei</para>
  <para style="q" vid="ZEP 2:3">lídanme luéyuri ligañi Wabureme.<verse eid="ZEP 2:3" /></para>
  <para style="ms">II. Ñunsu Kóntüra Néchanigu Luma Kóntüra Herusalén</para>
  <para style="mr">(<ref loc="ZEP 2:4-3:8">2.4—3.8</ref>)</para>
  <para style="s1">Abeichúni le lunbei habihini néchanigu</para>
  <para style="q">
    <verse number="4" style="v" sid="ZEP 2:4" />Lerederuba uburugu Gasa kei fulasu mageirawati,</para>
  <para style="q" vid="ZEP 2:4">rédeime Asükalón málouga:</para>
  <para style="q" vid="ZEP 2:4">Habugúba ha aganóubaña Asüdódu wéyuagu,</para>
  <para style="q" vid="ZEP 2:4">hahulúba lílana Ekürón lau sun hálagüle.<verse eid="ZEP 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEP 2:5" />Fugiabugu huguya Küretana,</para>
  <para style="q" vid="ZEP 2:5">ha aganóubaña laru beya!</para>
  <para style="q" vid="ZEP 2:5">Ariñaga laali Bungiu siadi le huagu:</para>
  <para style="q" vid="ZEP 2:5">«Kanán hageira Filistéana,</para>
  <para style="q" vid="ZEP 2:5">nagünrinchaguaadibu, nígiraadibu úouga aganóutiña bidan!<verse eid="ZEP 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEP 2:6" />Ageiraü le lárubei beya lerederuba sagadi-ágeime</para>
  <para style="q" vid="ZEP 2:6">le ñeinba lubéi hóundaragua hóuniri mudún,</para>
  <para style="q" vid="ZEP 2:6">lerederuba hábiñeme mudún».<verse eid="ZEP 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEP 2:7" />Hámeti erederubaña hádangiñe lumutuniña Hudá,</para>
  <para style="q" vid="ZEP 2:7">herederuba lau ageiraü le danme liabin Bungiu íderaguaña,</para>
  <para style="q" vid="ZEP 2:7">danme lasansiragun habunurun.</para>
  <para style="q" vid="ZEP 2:7">Hóunigirubaña halügüniña ñein,</para>
  <para style="q" vid="ZEP 2:7">ábame hemeraagun tidan muna burí to Asükalónboun áriebu.<verse eid="ZEP 2:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8-9" style="v" sid="ZEP 2:8-9" />Lariñahare Aburemei Suntigabafu le Lubungiute Ísüraeli:</para>
  <para style="q" vid="ZEP 2:8-9">Aganba naali hanabahan Moábüna</para>
  <para style="q" vid="ZEP 2:8-9">luma hanabahan Amonna.</para>
  <para style="q" vid="ZEP 2:8-9">Lugundun hagía, anaba hamaaña numutuniña,</para>
  <para style="q" vid="ZEP 2:8-9">ani wéiriguhaña lídangiñe hamúan.</para>
  <para style="q" vid="ZEP 2:8-9">Ligía náfiñurunbei luagu nibagari</para>
  <para style="q" vid="ZEP 2:8-9">luagu lasusereduba lan lun Moabü kei lasuseredun lun Sodoma,</para>
  <para style="q" vid="ZEP 2:8-9">ani herederuba lan lílana Amón kei Gomora,</para>
  <para style="q" vid="ZEP 2:8-9">herederuba icharime le hiiyu-agei, luma salu-agei,</para>
  <para style="q" vid="ZEP 2:8-9">aban fulasu le málougati ñein súnwandan.</para>
  <para style="q" vid="ZEP 2:8-9">Hámeti erederutiña hádangiñe numutuniña hasagarahabaña,</para>
  <para style="q" vid="ZEP 2:8-9">ábame herederun hánime.<verse eid="ZEP 2:8-9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ZEP 2:10" />Ligíaba lafayeiruaha Moabü luma Amón</para>
  <para style="q" vid="ZEP 2:10">luagu hanabuniña lumutuniña Wabureme,</para>
  <para style="q" vid="ZEP 2:10">luagu luéirigun hanaagun houngua hawéi</para>
  <para style="q" vid="ZEP 2:10">lumutuniña Wabureme Suntigabafu.<verse eid="ZEP 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEP 2:11" />Hanarimebei Wabureme houn.</para>
  <para style="q" vid="ZEP 2:11">Lagünrinchagubaña sun búngiugu ha fulasurugubaña,</para>
  <para style="q" vid="ZEP 2:11">ábame lichugún uéiriguni lun lidan sun fulasu,</para>
  <para style="q" vid="ZEP 2:11">íbini gürigia ha ubouhubaña híchuguba uéiriguni lun.<verse eid="ZEP 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEP 2:12" />Íbini giñe huguya le Etiopíana,</para>
  <para style="q" vid="ZEP 2:12">háfarawaguba giñe tau lefeinte Wabureme!<verse eid="ZEP 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEP 2:13" />Liñurubei lúhabu luagun nórute</para>
  <para style="q" vid="ZEP 2:13">lun lagünrinchaguni Asiria,</para>
  <para style="q" vid="ZEP 2:13">lígirubei uburugu Níniwe málouga,</para>
  <para style="q" vid="ZEP 2:13">lasaliraguagüdübei lun ábanme fulasu mageirawati le mábeiti.<verse eid="ZEP 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ZEP 2:14" />Lahulúba burí tuenwena haban,</para>
  <para style="q" vid="ZEP 2:14">ábame harounrun mudún luagu</para>
  <para style="q" vid="ZEP 2:14">hama sun hawuyeri animaalugu áraabuna.</para>
  <para style="q" vid="ZEP 2:14">Larumuguba garún luma fidigilieru luagu tuágaburi,</para>
  <para style="q" vid="ZEP 2:14">hagúarahaba piánpiamu luagu burí funedera luma bena.<verse eid="ZEP 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEP 2:15" />Anihán uburugu pántati le meha hemenigibei,</para>
  <para style="q" vid="ZEP 2:15">le meha uágubei hariñaga lílana luagu ua lan libe ubouagu.</para>
  <para style="q" vid="ZEP 2:15">Rédeiha málouga,</para>
  <para style="q" vid="ZEP 2:15">hábiñehali animaalugu gáñitiña!</para>
  <para style="q" vid="ZEP 2:15">Ha ásügürütiña lurugabugiñe hínwinruba</para>
  <para style="q" vid="ZEP 2:15">ábame harihin gárati luagun.<verse eid="ZEP 2:15" /></para>
  <chapter eid="ZEP 2" />
  <chapter number="3" style="c" sid="ZEP 3" />
  <para style="s1">Lifigoun luma lesefurún Herusalén</para>
  <para style="q">
    <verse number="1" style="v" sid="ZEP 3:1" />Fugiabu Herusalén, uburugu mabuchahati,</para>
  <para style="q" vid="ZEP 3:1">dáseiwaali, le éibaahabaliña lílana!<verse eid="ZEP 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEP 3:2" />Meteniti lun lumalali Wabureme,</para>
  <para style="q" vid="ZEP 3:2">maha ligía lererehóun lun;</para>
  <para style="q" vid="ZEP 3:2">mafiñeti luagu Wabureme;</para>
  <para style="q" vid="ZEP 3:2">máluahan lumuti Lubungiute.<verse eid="ZEP 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEP 3:3" />Ítara haña lábutigu kei liñún ha áünhatiña,</para>
  <para style="q" vid="ZEP 3:3">aguseragüdütiña ítara haña kei ounli áraabuna lidan fulasu mageirawati</para>
  <para style="q" vid="ZEP 3:3">ha mígirunbaña ni aban abun lubá larugan binaafin.<verse eid="ZEP 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEP 3:4" />Marasualugutiña profetagu ani barügua hagía houngua,</para>
  <para style="q" vid="ZEP 3:4">magunfuliruntiña lau hererun;</para>
  <para style="q" vid="ZEP 3:4">wíyeda hamutu fádirigu ténpulu,</para>
  <para style="q" vid="ZEP 3:4">dürügua hamuti lilurudun Wabureme.<verse eid="ZEP 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEP 3:5" />Gama lumoun anihein Wabureme uburugu,</para>
  <para style="q" vid="ZEP 3:5">le buídubei ladügübei, mama le wuribabei.</para>
  <para style="q" vid="ZEP 3:5">Sagü binaafin ladügüni laguseragüdün.</para>
  <para style="q" vid="ZEP 3:5">Ánheinti le wuribabei, ibidiñegubéiti busiganu lun.<verse eid="ZEP 3:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ZEP 3:6" />Lariñahare Wabureme:</para>
  <para style="q" vid="ZEP 3:6">«Günringuaadina néchanigu, chagá naali lubarieirun,</para>
  <para style="q" vid="ZEP 3:6">ígira naali lémeri málouga,</para>
  <para style="q" vid="ZEP 3:6">úouga gürigia ásügürütiña luéigiñe.</para>
  <para style="q" vid="ZEP 3:6">Úaali ni aban aganóuti lidan burí luburugute!<verse eid="ZEP 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEP 3:7" />Nariñaga núnguarügü:</para>
  <para style="q" vid="ZEP 3:7">“Ítara luba inebe nan lun Herusalén,</para>
  <para style="q" vid="ZEP 3:7">ábame lánharun lun narufudahan lun;</para>
  <para style="q" vid="ZEP 3:7">ítara luba magünrinchawagun tan luban lau nabeichuni”.</para>
  <para style="q" vid="ZEP 3:7">Gama lumoun aba hóufudahan adüga sun luwuyeri wuribani.<verse eid="ZEP 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ZEP 3:8" />Aguraba humana lubeiti lídanme weyu násaarun adimureha huagu.</para>
  <para style="q" vid="ZEP 3:8">Nariñahare au, le Aburemei:</para>
  <para style="q" vid="ZEP 3:8">Aransedina lun nóundaraguniña néchanigu luma arúeihani</para>
  <para style="q" vid="ZEP 3:8">lun narariraguagüdüni lanarime nigañi hawagun.</para>
  <para style="q" vid="ZEP 3:8">Lagünrinchagubei lanarime nigañi sun múa.<verse eid="ZEP 3:8" /></para>
  <para style="ms">III. Füramasewa Lan Esefuruni</para>
  <para style="mr">(<ref loc="ZEP 3:9-20">3.9-20</ref>)</para>
  <para style="q">
    <verse number="9" style="v" sid="ZEP 3:9" />«Danme lasuseredun katei le,</para>
  <para style="q" vid="ZEP 3:9">nadügüba lun máhuduragun hamá lílana fulasu houn guáriuagu</para>
  <para style="q" vid="ZEP 3:9">lun núnrügü lan háhuduragua, au, le Aburemei Suntigabafu</para>
  <para style="q" vid="ZEP 3:9">nadügüba giñe lun gaganbadi hamá súngubei nun.<verse eid="ZEP 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEP 3:10" />Hayabiba numutuniña</para>
  <para style="q" vid="ZEP 3:10">ha chagagubaña loubafurugu Etiopía,</para>
  <para style="q" vid="ZEP 3:10">ayumuragua nun barüina hagíame idewesei nun.<verse eid="ZEP 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEP 3:11" />Lídanme dan ligía, huguya numutuniña,</para>
  <para style="q" vid="ZEP 3:11">masandihadünme busiganu</para>
  <para style="q" vid="ZEP 3:11">luagu ni aban lídangiñe katei</para>
  <para style="q" vid="ZEP 3:11">le aubei hawügürihóua nun,</para>
  <para style="q" vid="ZEP 3:11">ladüga nagidarubaña barügua tungua hídangiñe,</para>
  <para style="q" vid="ZEP 3:11">marufudunhaadünme anaaguni unguaü</para>
  <para style="q" vid="ZEP 3:11">luagu nuwübüri le sándubei.<verse eid="ZEP 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEP 3:12" />Nígiruba gürigia ǘnabugubutiña hidan,</para>
  <para style="q" vid="ZEP 3:12">ha lúnbaña híchuguni hafiñen nuagu.<verse eid="ZEP 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEP 3:13" />Hame erederutiña hádangiñe Ísüraelina,</para>
  <para style="q" vid="ZEP 3:13">Madügünbaña marichaü,</para>
  <para style="q" vid="ZEP 3:13">mariñagunbaña iyeeni,</para>
  <para style="q" vid="ZEP 3:13">mabuinchagüdün habéi hayuma lau marasualugu.</para>
  <para style="q" vid="ZEP 3:13">Gayaraabei heigin ani emeraagua hagíame manufudeuga»<verse eid="ZEP 3:13" /></para>
  <para style="s1">Uremu lánina ugundani luagu Herusalén</para>
  <para style="q">
    <verse number="14" style="v" sid="ZEP 3:14" />Beremuha, uburugu Sión!</para>
  <para style="q" vid="ZEP 3:14">Hagúaraha lau ugundani, lumutuniña Ísüraeli!</para>
  <para style="q" vid="ZEP 3:14">Gundaabá, Herusalén, gundaabá tau sun banigi!<verse eid="ZEP 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEP 3:15" />Gidala Wabureme siadi buéi,</para>
  <para style="q" vid="ZEP 3:15">bugá laaña báganiñu.</para>
  <para style="q" vid="ZEP 3:15">Anihein Wabureme, le lurúeite Ísüraeli buma:</para>
  <para style="q" vid="ZEP 3:15">Manufudedunhadibume ni ka uei.<verse eid="ZEP 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ZEP 3:16" />Lariñawagúba lun Herusalén lidan dan ligía:</para>
  <para style="q" vid="ZEP 3:16">«Manufudedabá Sión,</para>
  <para style="q" vid="ZEP 3:16">mígirun buguyame lun leferidiruni búhabu lere!»<verse eid="ZEP 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ZEP 3:17" />Anihein Wabureme le Bubungiute buma;</para>
  <para style="q" vid="ZEP 3:17">gabafuti ani lesefurubadibu!</para>
  <para style="q" vid="ZEP 3:17">Gúndaabei Wabureme bau.</para>
  <para style="q" vid="ZEP 3:17">Líchuguba iseri ibagari bun lau línsiñehabu;</para>
  <para style="q" vid="ZEP 3:17">leremuhaba lau ugundani<verse eid="ZEP 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ZEP 3:18" />kei lidan luéyuri fedu.</para>
  <para style="b" vid="ZEP 3:18" />
  <para style="q" vid="ZEP 3:18">Lariñahare Wabureme:</para>
  <para style="q" vid="ZEP 3:18">«Nesefurubadibu luéi wuribani le ayawadagutibu,</para>
  <para style="q" vid="ZEP 3:18">luma luéi busiganu le ábürühati buagun.<verse eid="ZEP 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ZEP 3:19" />Lídanme dan ligía,</para>
  <para style="q" vid="ZEP 3:19">nabeichagubaña ha amudiragubalibu.</para>
  <para style="q" vid="ZEP 3:19">Níderaguboun mudún to adamahaboun,</para>
  <para style="q" vid="ZEP 3:19">budanóunme to ayuridaguboun;</para>
  <para style="q" vid="ZEP 3:19">sun mebereseni le ichugúbei hun,</para>
  <para style="q" vid="ZEP 3:19">nadügübei lun uéirigunime luma inebesei.<verse eid="ZEP 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ZEP 3:20" />Lídanme dan ligía,</para>
  <para style="q" vid="ZEP 3:20">nanügübadün, nóundarubadün;</para>
  <para style="q" vid="ZEP 3:20">nasansirubei hubunurun,</para>
  <para style="q" vid="ZEP 3:20">níchuguba uéiriguni hun</para>
  <para style="q" vid="ZEP 3:20">haganagua sun gürigia ha ubouagubaña.</para>
  <para style="q" vid="ZEP 3:20">Au, le Aburemei, ariñagubalin».<verse eid="ZEP 3:20" /></para>
  <chapter eid="ZEP 3" />
</usx>