<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HOS" style="id">Oseas.TXT (Encoding update 2008) 27/02/2001 CAP C.R, GARIFUNA</book>
  <para style="h">Oseasi</para>
  <para style="toc3">Ose</para>
  <para style="toc2">Oseasi</para>
  <para style="toc1">Oseasi</para>
  <para style="mt2">Liliburun</para>
  <para style="mt1">OSEASI</para>
  <chapter number="1" style="c" sid="HOS 1" />
  <para style="ms">I. Oseasi, Lúmari Hama Lirahüñü</para>
  <para style="mr">(<ref loc="HOS 1-3">1—3</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1" />Anihán uganu le líchugubei Aburemei lun Oseasi, le liráü Beerí lidan meha lidaani Osiasi, Hotamü, Aasi luma Esekíasi ha lurúeitegu Hudá, luma Heroboamü le liráü Hoasi le lurúeite Ísüraeli.<verse eid="HOS 1:1" /></para>
  <para style="s1">Lúmari Oseasi hama lirahüñü</para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 1:2" />Ítara liña ligaburi lagumeseruni Aburemei le lariñagubei lídangiñe Oseasi:</para>
  <para style="p" vid="HOS 1:2">—Ahoruhaali Ísüraeli lau ladireirun nuéi. Ítarameme giñe, beiba, banügame aban würi horu búmarime, ábame bagaraüdagun tau, ítara, tirahüñübaña horu irahüñü hagía.<verse eid="HOS 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HOS 1:3" />Ábati lanügünu Oseasi Gómerü to liráü Dibülaímü lúmarime, aba tadageinadun, aba tagaraüdün aban wügüri irahü lau. <verse eid="HOS 1:3" /><verse number="4" style="v" sid="HOS 1:4" />Ábati lariñagun Aburemei lun Oseasi:</para>
  <para style="p" vid="HOS 1:4">—Ruba Hesüreeli luagu irahü le, lugundun madiseeli nabeichuniña ladügawagun urúei Heú luagu burí áfarahani le buga ladügübei Heú uburugu Hesüreeli, ani nagumuchaguagüdaali larúeihan Ísüraeligiñe. <verse eid="HOS 1:4" /><verse number="5" style="v" sid="HOS 1:5" />Wéyume ligía, nagünrinchagubei habafu lisudaranigu Ísüraeli lidan fulasu wayati le lani Hesüreeli.<verse eid="HOS 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 1:6" />Ábaya tadageinadun Gómerü, aba tagaraüdün aban würi irahü. Aba lariñagun Aburemei lun Oseasi:</para>
  <para style="p" vid="HOS 1:6">—Ruba Lo-ruama tuagu, ladüga magudemedunhaña lánigu Ísüraeli nun. Úabei feruduna nániña. <verse eid="HOS 1:6" /><verse number="7" style="v" sid="HOS 1:7" />Gama lumoun gudemehabubadina houn lánigu Hudá: Au guánarügüba le Habungiute esefuraña. Mámaba tau gimara nesefuraña, ni tau eféin, ni lau wuribu, ni hau gabayu ni hau agalufehatiña gabayu.<verse eid="HOS 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 1:8" />Lárigiñe tachularun Lo-ruama, ábaya tadageinadun Gómerü, aba tagaraüdün aban wügüri irahü. <verse eid="HOS 1:8" /><verse number="9" style="v" sid="HOS 1:9" />Ábati lariñagun Aburemei lun Oseasi:</para>
  <para style="p" vid="HOS 1:9">—Ruba Lo-amí luagu, lugundun huguya, mámaadün numutuniña, ani mámaadina giñe Hubungiute.<verse eid="HOS 1:9" /></para>
  <para style="s1">Uéiriguni le lunbei liabin lun Ísüraeli</para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 1:10" />Lachülürüba weyu lun ítara hamá Ísüraelina</para>
  <para style="q" vid="HOS 1:10">kei lisagounte barana,</para>
  <para style="q" vid="HOS 1:10">siñabei hamisurahóun ni habahüdǘn.</para>
  <para style="q" vid="HOS 1:10">Lubaragiñemeti lariñagun Bungiu houn:</para>
  <para style="q" vid="HOS 1:10">«Mámaadün numutuniña»</para>
  <para style="q" vid="HOS 1:10">Ariñagarügübei houn:</para>
  <para style="q" vid="HOS 1:10">«Lirahüñü Bungiu le wínwanbei huguya».<verse eid="HOS 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 1:11" />Ábameti hóundaragun lánigu Hudá hama lánigu Ísüraeli,</para>
  <para style="q" vid="HOS 1:11">ábame híchugun ábanrügü ábuti,</para>
  <para style="q" vid="HOS 1:11">ábame hayabin Herusaléun lídangiñe sun fulasu.</para>
  <para style="q" vid="HOS 1:11">Wéirigubei luéyuri Hesüreeli!<verse eid="HOS 1:11" /></para>
  <chapter eid="HOS 1" />
  <chapter number="2" style="c" sid="HOS 2" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 2:1" />Ábameti hariñagun houn híbirigu:</para>
  <para style="q" vid="HOS 2:1">«Lumutuniña Bungiu»,</para>
  <para style="q" vid="HOS 2:1">hariñagame houn hítunu:</para>
  <para style="q" vid="HOS 2:1">«Gudemewatiña».<verse eid="HOS 2:1" /></para>
  <para style="s1">Magunfulirun lan Ísüraeli</para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 2:2" />Lariñahare Aburemei:</para>
  <para style="q" vid="HOS 2:2">«Ru humá tidurun húguchu,</para>
  <para style="q" vid="HOS 2:2">ru humá tidurun,</para>
  <para style="q" vid="HOS 2:2">lugundun mámaaru númari,</para>
  <para style="q" vid="HOS 2:2">mámaadina giñe túmari!</para>
  <para style="q" vid="HOS 2:2">Hebé tarufudagun tungua keisi horu!</para>
  <para style="q" vid="HOS 2:2">Gidataña tubúaligu taniguagugiñe!<verse eid="HOS 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 2:3" />Anhein madügün tan ítara,</para>
  <para style="q" vid="HOS 2:3">nígiruboun surusu le gumuti:</para>
  <para style="q" vid="HOS 2:3">Nígiruboun kei weyu le tagaraüdün,</para>
  <para style="q" vid="HOS 2:3">nadügüboun ábanme fulasu mageirawati,</para>
  <para style="q" vid="HOS 2:3">múa le mábeiti,</para>
  <para style="q" vid="HOS 2:3">ábame nadügün lun láfarunu mágürabu.<verse eid="HOS 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 2:4" />Magudemehabubadina houn tirahüñü,</para>
  <para style="q" vid="HOS 2:4">ladüga lirahüñüna lan tahoruhan.<verse eid="HOS 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 2:5" />Deregeguatu háguchu tungua lun ahoruhani;</para>
  <para style="q" vid="HOS 2:5">“féridi tumuti tinebese dan le tariñagunbei:</para>
  <para style="q" vid="HOS 2:5">Néibuga hárigi nubúaligu ha íchugubalin neigin</para>
  <para style="q" vid="HOS 2:5">luma nuniñe duna nun, liyu mudún, linu, garaba tuma nuniñe diwéin”.<verse eid="HOS 2:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="HOS 2:6" />«Ligía nadourubei lubéi témeri lau hiiyu,</para>
  <para style="q" vid="HOS 2:6">níchuguba aban baríeiru geyegua tau lun madaritani témeri,<verse eid="HOS 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 2:7" />téibuguba hárigi tubúaligu gama lumoun márügüdüntubaña</para>
  <para style="q" vid="HOS 2:7">táluahabaña gama lumoun madaritubaña.</para>
  <para style="q" vid="HOS 2:7">Ábameti tariñagun:</para>
  <para style="q" vid="HOS 2:7">“Nagiribuda lun furumiñeti númari,</para>
  <para style="q" vid="HOS 2:7">buítimati meha dan nun luma luéi oura le”.<verse eid="HOS 2:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="HOS 2:8" />«Gama lumoun máhatu buga tasubudiruni</para>
  <para style="q" vid="HOS 2:8">luagu au lan íchugubei türigu, diwéin luma garaba tun,</para>
  <para style="q" vid="HOS 2:8">au aganwoundagüdei pülata luma golu tun</para>
  <para style="q" vid="HOS 2:8">le aubei tadaaguaña tubungiutegu.<verse eid="HOS 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 2:9" />Nagiribuduba lubeiti,</para>
  <para style="q" vid="HOS 2:9">ábame nanügüni nitürigun tuma nuniñe diwéin</para>
  <para style="q" vid="HOS 2:9">lidan lidaani alubahani,</para>
  <para style="q" vid="HOS 2:9">barünéime nani liyu mudún tuma nani linu</para>
  <para style="q" vid="HOS 2:9">to yebe níchuguboun tun lun tadouragun taugua.<verse eid="HOS 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 2:10" />Nasurusugüdüboun hagibugiñe tubúaligu.</para>
  <para style="q" vid="HOS 2:10">Úabei ni aban esefurutu núhaburugugiñe!<verse eid="HOS 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 2:11" />Nagumuchaguagüdübei tugundan,</para>
  <para style="q" vid="HOS 2:11">tefeduhan le irumuauti, le lánina sagü hati</para>
  <para style="q" vid="HOS 2:11">luma burí luéyuri emeraaguni.</para>
  <para style="q" vid="HOS 2:11">Sun tufedun nagumuchaguagüdübei.<verse eid="HOS 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 2:12" />Nagünrinchagubei tinadürigu beibei tuma igu,</para>
  <para style="q" vid="HOS 2:12">to buga uáguboun tariñaga:</para>
  <para style="q" vid="HOS 2:12">“Anihán fáyeiti le híchugubei nubúaligu nun”.</para>
  <para style="q" vid="HOS 2:12">Nadügübei ábame dabíara,</para>
  <para style="q" vid="HOS 2:12">ábame héigini animaalugu áraabuna.<verse eid="HOS 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 2:13" />Nabeichaaru luagu dan le tásügürübei</para>
  <para style="q" vid="HOS 2:13">águdaha kupali houn guáriuagu,</para>
  <para style="q" vid="HOS 2:13">dan burí meha tewendedun lau burí bagü luma iñari,</para>
  <para style="q" vid="HOS 2:13">lun tafalaruniña tubúaligu, lun tabulieidunina.</para>
  <para style="q" vid="HOS 2:13">Au, le Aburemei ariñagubalin.<verse eid="HOS 2:13" /></para>
  <para style="s1">Hínsiñetiña Ísüraelina lun Bungiu</para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 2:14" />«Ligía nadarihaboun lubéi,</para>
  <para style="q" vid="HOS 2:14">nanügüboun lidoun fulasu mageirawati</para>
  <para style="q" vid="HOS 2:14">ábame nadimurehan tidoun tanigi.<verse eid="HOS 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 2:15" />Lárigiñe ábame náguyugüdüni tubeibein-agei tun,</para>
  <para style="q" vid="HOS 2:15">ábame nadügüni fulasu wayati le lani asufuriruni</para>
  <para style="q" vid="HOS 2:15">lubenarime emenigini tun.</para>
  <para style="q" vid="HOS 2:15">Ñeinba tóunabana kei dan le meha nibureingiru,</para>
  <para style="q" vid="HOS 2:15">kei lidan weyu le táfuridunbei Ehiptugiñe.<verse eid="HOS 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HOS 2:16" />Ábameti tariñagun nun “Númari”,</para>
  <para style="q" vid="HOS 2:16">lubaragiñe tariñagun nun “Nabureme»”.</para>
  <para style="q" vid="HOS 2:16">Au, le Aburemei ariñagubalin.<verse eid="HOS 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HOS 2:17" />Nagidarubei hiri búngiugu tiyumulugugiñe,</para>
  <para style="q" vid="HOS 2:17">miridúnwadigiaañame.<verse eid="HOS 2:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="HOS 2:18" />«Lídanme dan ligía,</para>
  <para style="q" vid="HOS 2:18">nadügüba aban daradu hama animaalugu áraabuna</para>
  <para style="q" vid="HOS 2:18">luagu lufulesein Ísüraeli hama dunuru luma hama hewe;</para>
  <para style="q" vid="HOS 2:18">nagidaruboun gimara, eféin luma wuribu lídangiñe ageiraü le,</para>
  <para style="q" vid="HOS 2:18">lun haganóun numutuniña darangilu.<verse eid="HOS 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="HOS 2:19" />Ísüraeli, nadügübadibu númarime lun sun dan</para>
  <para style="q" vid="HOS 2:19">buguyaba númari to tímatimaatu</para>
  <para style="q" vid="HOS 2:19">keisi lariñaguni lúrudu,</para>
  <para style="q" vid="HOS 2:19">ladüga wéiriti bínsiñe nun.<verse eid="HOS 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="HOS 2:20" />Nadügübadibu númarime ani nagunfuliruba buma,</para>
  <para style="q" vid="HOS 2:20">ábameti basubudirunina keisi Babureme.<verse eid="HOS 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="HOS 2:21" />Nariñahare au, le Aburemei:</para>
  <para style="q" vid="HOS 2:21">Lídanme dan ligía, nóunabubei sielu,</para>
  <para style="q" vid="HOS 2:21">lóunabeime sielu múa;<verse eid="HOS 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="HOS 2:22" />lóunabeime múa türigu,</para>
  <para style="q" vid="HOS 2:22">diwéin luma garaba,</para>
  <para style="q" vid="HOS 2:22">lóunabeimeti sun katei le, Hesüreeli.<verse eid="HOS 2:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="HOS 2:23" />Nábunagubaña ninadürigume nábugua;</para>
  <para style="q" vid="HOS 2:23">gudemehabubadina tun Lo-ruama,</para>
  <para style="q" vid="HOS 2:23">nariñaguba lun Lo-amí:</para>
  <para style="q" vid="HOS 2:23">“Nánigu buguya”, lariñagame nun:</para>
  <para style="q" vid="HOS 2:23">“Nubungiute buguya” ».<verse eid="HOS 2:23" /></para>
  <chapter eid="HOS 2" />
  <chapter number="3" style="c" sid="HOS 3" />
  <para style="s1">Oseasi tuma aban würi agabarahatu túmari</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 3:1" />Ábaya lariñagun Aburemei nun:</para>
  <para style="q" vid="HOS 3:1">«Beiba adariha aban würi to hínsiñetu lun tubúali,</para>
  <para style="q" vid="HOS 3:1">to agabaraha tumuti túmari.</para>
  <para style="q" vid="HOS 3:1">Ítara liña hínsiñe Ísüraelina nun, au le Aburemei,</para>
  <para style="q" vid="HOS 3:1">íbini houdin hárigi búngiugu terencha,</para>
  <para style="q" vid="HOS 3:1">hou hagía lídangiñe le hadagaragüdübei houn».<verse eid="HOS 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 3:2" />Ábati nagañeihan aban würi númarime</para>
  <para style="q" vid="HOS 3:2">luagu keinsi murusun pülata</para>
  <para style="q" vid="HOS 3:2">luma ǘrüwa-san-darandi líburu sebada.<verse eid="HOS 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 3:3" />Aba nariñagun tun:</para>
  <para style="q" vid="HOS 3:3">«Númaribadibu luagu saragu dan;</para>
  <para style="q" vid="HOS 3:3">mahoruhabá, míchaagun buguyame bungua lun amu wügüri,</para>
  <para style="q" vid="HOS 3:3">ábame giñe nagunfulirun buma».<verse eid="HOS 3:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="HOS 3:4" />Herederuba Ísüraelina saragu dan marúeitega,</para>
  <para style="q" vid="HOS 3:4">mábutiga, úouga adagaragüdüni ni dübü sagüráuti</para>
  <para style="q" vid="HOS 3:4">ni hadaüragun fádirigu ni haguariuan iduheñu.<verse eid="HOS 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 3:5" />Lárigiñeme le,</para>
  <para style="q" vid="HOS 3:5">ábame hagararaagun Ísüraelina</para>
  <para style="q" vid="HOS 3:5">ábame háluahani Aburemei le Habungiute luma Dawidi le harúeite.</para>
  <para style="q" vid="HOS 3:5">Lídounme burí lagumuhóun dan,</para>
  <para style="q" vid="HOS 3:5">háluahabei Aburemei lau inebesei</para>
  <para style="q" vid="HOS 3:5">luma burí buiti le líchugubei.<verse eid="HOS 3:5" /></para>
  <chapter eid="HOS 3" />
  <chapter number="4" style="c" sid="HOS 4" />
  <para style="ms">II. Ñunsu Kóntüra Ísüraeli</para>
  <para style="mr">(<ref loc="HOS 4-13">4—13</ref>)</para>
  <para style="s1">Lariñaguni Bungiu hadurun Ísüraelina</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 4:1" />Ísüraelina, aganba huméi le lariñagubei Aburemei:</para>
  <para style="q" vid="HOS 4:1">«Lagañiduña hama ha aganóubaña lidan fulasu le,</para>
  <para style="q" vid="HOS 4:1">lugundun úaali inarüni hadan gürigia ha,</para>
  <para style="q" vid="HOS 4:1">ni gúnfuli ni lisubudinwa Wabungiute.<verse eid="HOS 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 4:2" />Gama lumoun anihein saragu áfiñuruni le málati fulasurugu luma iyeeni,</para>
  <para style="q" vid="HOS 4:2">áfarahani luma íweruhani,</para>
  <para style="q" vid="HOS 4:2">agabarahani luma anarimeni,</para>
  <para style="q" vid="HOS 4:2">anihein áfarahani gabügürügua.<verse eid="HOS 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 4:3" />Ligía lamuiseruña lubéi fulasu; méreeña gürigia</para>
  <para style="q" vid="HOS 4:3">ha aganóubaña ñein;</para>
  <para style="q" vid="HOS 4:3">hilaguatiña animaalugu áraabuna hama dunuru,</para>
  <para style="q" vid="HOS 4:3">hilagua hagía úduraü ha baranahabaña úara hama».<verse eid="HOS 4:3" /></para>
  <para style="s1">Líchugun Aburemei hadurun fádirigu</para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 4:4" />Lariñahare Aburemei:</para>
  <para style="q" vid="HOS 4:4">«Ualá ni aban íchuguti hadurun numutuniña,</para>
  <para style="q" vid="HOS 4:4">madeinhan hagíame houn!</para>
  <para style="q" vid="HOS 4:4">Húmarügüñein nawuribuha, huguya fádirigu.<verse eid="HOS 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 4:5" />Huguya hábürühaba wéyuagu,</para>
  <para style="q" vid="HOS 4:5">hábürühaba giñe profetagu huma guñoun,</para>
  <para style="q" vid="HOS 4:5">ánhañati húguchurunigu nagünrinchagubaña.<verse eid="HOS 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 4:6" />Günrinwaguatiña numutuniña,</para>
  <para style="q" vid="HOS 4:6">ladüga lilouguan hasubudin.</para>
  <para style="q" vid="HOS 4:6">Huguyati fádirigu ha amaharubaña lun subudi,</para>
  <para style="q" vid="HOS 4:6">gidá numutün lídangiñe afadirihani,</para>
  <para style="q" vid="HOS 4:6">kei bulíei hubalin larufudahan Habureme,</para>
  <para style="q" vid="HOS 4:6">nabulieidubaña giñe hadügawagun».<verse eid="HOS 4:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="HOS 4:7" />«Dántima meha gibe hamá fádirigu ligíatima</para>
  <para style="q" vid="HOS 4:7">lagibedun hafigouhan nigibugiñe;</para>
  <para style="q" vid="HOS 4:7">nasansirubei lubeiti haweirigun luagu ǘnabuguni.<verse eid="HOS 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 4:8" />Lídangiñe hafigoun numutuniña hawinwanda;</para>
  <para style="q" vid="HOS 4:8">ligía gunda habéi lun hafigouhan numutuniña.<verse eid="HOS 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 4:9" />Dandu numutuniña keisi fádirigu</para>
  <para style="q" vid="HOS 4:9">nabeichubaña luagu luriban hóuserun.<verse eid="HOS 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 4:10" />Ígira hamutina fádirigu aban heseriwidun houn amu búngiugu.</para>
  <para style="q" vid="HOS 4:10">Ligía héigiba lubéi lídangiñe adagaragüdüni le híchugubei numutuniña nun.</para>
  <para style="q" vid="HOS 4:10">Gama lumoun makimuledunbaña;</para>
  <para style="q" vid="HOS 4:10">Háhuduraguba houn búngiugu gama lumoun marahüñübaña».<verse eid="HOS 4:10" /></para>
  <para style="s1">Háhuduragun Ísüraelina houn guáriuagu</para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 4:11" />«Ahoruhani luma latun diwéin,</para>
  <para style="q" vid="HOS 4:11">féridigüda lumuti ichügü.<verse eid="HOS 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 4:12" />Álügüdahatiña numutuniña hama habungiutegu láutiña wewe,</para>
  <para style="q" vid="HOS 4:12">aríaagüda hagía luma aban wewe,</para>
  <para style="q" vid="HOS 4:12">lememe hórudua hamá falatiña lagübüri üma,</para>
  <para style="q" vid="HOS 4:12">ahoruhatiña lau hadisedun luéi Habungiute.<verse eid="HOS 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 4:13" />Dagagüdatiña lábulugu burí wübü</para>
  <para style="q" vid="HOS 4:13">ani águdahatiña kupali ligibuagu fulasu íñuti</para>
  <para style="q" vid="HOS 4:13">luma giñe lábugiñe lubuidun lamuñadiri burí,</para>
  <para style="q" vid="HOS 4:13">álamu, ensina luma burí lídibu wewe wéinamuti.</para>
  <para style="q" vid="HOS 4:13">Ligía hahoruhanbei hirahüñü würiña,</para>
  <para style="q" vid="HOS 4:13">agabaraha hamaña hídiñugu hirahüñü.<verse eid="HOS 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 4:14" />Gama lumoun mabeichun nubaña hirahüñü würiña danme hahoruhan,</para>
  <para style="q" vid="HOS 4:14">ni hídiñugu danme hagabarahaniña hirahüñü,</para>
  <para style="q" vid="HOS 4:14">lugundun huguya guánarügü ñǘdüntün hama horu;</para>
  <para style="q" vid="HOS 4:14">lun hadügün adagaragüdüni gudawarügüti,</para>
  <para style="q" vid="HOS 4:14">dáguatün hungua hamoun würiña ha adügübalin ahoruhani kei aban kultu.</para>
  <para style="q" vid="HOS 4:14">Ítara liña heferidirun gürigia ha lóuguabaña isubudin!»<verse eid="HOS 4:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="HOS 4:15" />«Ánhabu ahoruha Ísüraeli,</para>
  <para style="q" vid="HOS 4:15">mafigounhalá Hudá.</para>
  <para style="q" vid="HOS 4:15">Midin humá Gilügáli,</para>
  <para style="q" vid="HOS 4:15">mamudeira humá Betü-awén</para>
  <para style="q" vid="HOS 4:15">máfiñurun huguyame luagu libagari Aburemei!<verse eid="HOS 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HOS 4:16" />Mabuchahati Ísüraeli kei aban tiraüraü bágasu derenatu;</para>
  <para style="q" vid="HOS 4:16">ítarati, lóunigirubaña san Aburemei lidan sagadi-agei buiti</para>
  <para style="q" vid="HOS 4:16">kamá hamuga harahüñü mudún hagía?<verse eid="HOS 4:16" /></para>
  <para style="q">
    <verse number="17-18" style="v" sid="HOS 4:17-18" />Rúguaali Éfürain lungua lun áhuduraguni houn guáriuagu</para>
  <para style="q" vid="HOS 4:17-18">ábürühaaña sun hagía kei bacharuatiña!</para>
  <para style="q" vid="HOS 4:17-18">Ahoruhaaña saragu wéiyaasu,</para>
  <para style="q" vid="HOS 4:17-18">himei hamuti busiganu luéi inebesei.<verse eid="HOS 4:17-18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="HOS 4:19" />Lanügübei aban garabali larünarugu,</para>
  <para style="q" vid="HOS 4:19">ábame hanügün busiganu luagu háhuduragun houn guáriuagu!»<verse eid="HOS 4:19" /></para>
  <para style="b" />
  <chapter eid="HOS 4" />
  <chapter number="5" style="c" sid="HOS 5" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 5:1" />«Fádirigu, aganba huméi katei le;</para>
  <para style="q" vid="HOS 5:1">Ísüraelina, ru huméi harigei lun haganbun:</para>
  <para style="q" vid="HOS 5:1">Huguyaba gadurun lidan guséi,</para>
  <para style="q" vid="HOS 5:1">lugundun ítara hiña keisi aban sádara esetirútu Misüpá.</para>
  <para style="q" vid="HOS 5:1">Aban seni to esetirútu luagu wübü Taworu,<verse eid="HOS 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 5:2" />kei aban fusu huliliti lidan lani Sitimü fulasu wayati.</para>
  <para style="q" vid="HOS 5:2">Ligía nabeichubadün lubéi.<verse eid="HOS 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 5:3" />Subudi numuti Éfürain;</para>
  <para style="q" vid="HOS 5:3">subudi numuti giñe Ísüraeli,</para>
  <para style="q" vid="HOS 5:3">huduguaali Éfürain houn amu búngiugu; dáseihali Ísüraeli».<verse eid="HOS 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 5:4" />Mígirun lumutiña luriban hóuserun gürigia</para>
  <para style="q" vid="HOS 5:4">lun hagiribudun lun Habungiute.</para>
  <para style="q" vid="HOS 5:4">Le lueirin híchaagun houngua lun ahoruhani,</para>
  <para style="q" vid="HOS 5:4">máhaaña lun Aburemei.<verse eid="HOS 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 5:5" />Arufuda lumuti hapantan Ísüraelina luagu gadurun hamá;</para>
  <para style="q" vid="HOS 5:5">chugeguati Éfürain luagu luriban guánarügü,</para>
  <para style="q" vid="HOS 5:5">ani íbini Hudá, lachugeraguba úara hama!<verse eid="HOS 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 5:6" />Hóudiba hau halügüniña bágasu hama halügüniña mudún</para>
  <para style="q" vid="HOS 5:6">áluahei Aburemei gama lumoun madari habéi ladüga díreiha hawéi.<verse eid="HOS 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 5:7" />Múaraduntiña luma Aburemei,</para>
  <para style="q" vid="HOS 5:7">ladüga garahüñütiña ha lirahüñü amu úguchili.</para>
  <para style="q" vid="HOS 5:7">Ladüga magunfulin hamá,</para>
  <para style="q" vid="HOS 5:7">lagumuchaguba hamúan lidan ábanrügü hati.<verse eid="HOS 5:7" /></para>
  <para style="s1">Labeichún Ísüraeli luma Hudá</para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 5:8" />Win huméi ganchu le agúahabei lun wuribu uburugu Gibeá,</para>
  <para style="q" vid="HOS 5:8">win humóun fidu uburugu Ramá!</para>
  <para style="q" vid="HOS 5:8">Hawisaha uburugu Betü-awén!</para>
  <para style="q" vid="HOS 5:8">Fúugüda humaña lílana Benhamín!<verse eid="HOS 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 5:9" />Nasubudiragüdüñein houn lani Ísüraeli türibu,</para>
  <para style="q" vid="HOS 5:9">katei burí le lunbei lasuseredun lau achoururuni.</para>
  <para style="q" vid="HOS 5:9">Lagünrinchawaguba Éfürain lidan luéyuri abeichúni.<verse eid="HOS 5:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="HOS 5:10" />Lariñahare Aburemei:</para>
  <para style="q" vid="HOS 5:10">«Ítara haña lábutigu Hudá,</para>
  <para style="q" vid="HOS 5:10">kei gürigia ha anaahabaña lanwoun hachari lídangiñe fadaguaü.</para>
  <para style="q" vid="HOS 5:10">Gama lumoun nabuluchagüdübaña lau nigañi!<verse eid="HOS 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 5:11" />Libihiña Éfürain lidere dan dürüwaguati liricha,</para>
  <para style="q" vid="HOS 5:11">ladüga rúguaali lungua lun hafalarún hagübüri búngiugu.<verse eid="HOS 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 5:12" />Ítara nuba kei hamutiri lun Éfürain,</para>
  <para style="q" vid="HOS 5:12">kei añaladuni houn lánigu Hudá».<verse eid="HOS 5:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="HOS 5:13" />«Danme larihini Éfürain luagu sándiñein lan,</para>
  <para style="q" vid="HOS 5:13">arihaleime Hudá biti burí le luágubei,</para>
  <para style="q" vid="HOS 5:13">ábame lidin Éfürain Asiria amuriaha luma urúei lun líderaguni;</para>
  <para style="q" vid="HOS 5:13">gama lumoun siñabei lareidaguagüdüni,</para>
  <para style="q" vid="HOS 5:13">ni lagaranihan lun liwounun.<verse eid="HOS 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 5:14" />Kei aban liñún dan le lábürühan luagun lágani,</para>
  <para style="q" vid="HOS 5:14">ítara luba nábürühan luagun Hudá luma Éfürain;</para>
  <para style="q" vid="HOS 5:14">nagünrinchagubaña, lárigiñe ábame nidin;</para>
  <para style="q" vid="HOS 5:14">nabayurubaña, ani úabei esefurutiña».<verse eid="HOS 5:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="HOS 5:15" />«Lárigiñe ábame nagiribudun lidoun nubara,</para>
  <para style="q" vid="HOS 5:15">darime hánharun lun hafigoun ábame hayabin áluahana.</para>
  <para style="q" vid="HOS 5:15">Háluahabadina lidan hadiheri!»<verse eid="HOS 5:15" /></para>
  <chapter eid="HOS 5" />
  <chapter number="6" style="c" sid="HOS 6" />
  <para style="s1">Asakürihani le iyumaaruti</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 6:1" />«Higougu súngubei, giribu wamá lun Aburemei;</para>
  <para style="q" vid="HOS 6:1">günringua lumutiwa gama lumoun lagaranihaba giñe woun,</para>
  <para style="q" vid="HOS 6:1">bulesei lumutiwa gama lumoun lareidaguagüdübadiwa.<verse eid="HOS 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 6:2" />Lidan murusun oura láguyugüdübei wátuadi woun,</para>
  <para style="q" vid="HOS 6:2">liñuragubadiwa lun waganóun ligibugiñe.<verse eid="HOS 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 6:3" />Áfaagua wamá lun wasubudiruni Aburemei!</para>
  <para style="q" vid="HOS 6:3">Ítara kei chouru lan láfuridun weyu,</para>
  <para style="q" vid="HOS 6:3">ítara liña giñe chouru lan liabin Aburemei woun,</para>
  <para style="q" vid="HOS 6:3">Ítara giñe kei chouru lan ladüdüragüdüni huya múa</para>
  <para style="q" vid="HOS 6:3">lubaragiñe alubahani luma lárigiñe alubahani».<verse eid="HOS 6:3" /></para>
  <para style="s1">Lóunabagüle Aburemei</para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 6:4" />Lariñahare Aburemei:</para>
  <para style="q" vid="HOS 6:4">«Kaba san nadüga bau Éfürain?</para>
  <para style="q" vid="HOS 6:4">Kaba nadüga bau Hudá?</para>
  <para style="q" vid="HOS 6:4">Ínsiñehabuni le huágubei nun,</para>
  <para style="q" vid="HOS 6:4">ítara liña kei hemereedu binaafin,</para>
  <para style="q" vid="HOS 6:4">kei serenu lubá larugan,</para>
  <para style="q" vid="HOS 6:4">larugadun aba lagumuchagun.<verse eid="HOS 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 6:5" />Ligía günringua naadün lubéi hau nani profetagu,</para>
  <para style="q" vid="HOS 6:5">áfaragua naadün lau nuganute.</para>
  <para style="q" vid="HOS 6:5">Busentina lun harugounga humá kei larugounga weyu.<verse eid="HOS 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 6:6" />Le nabusenrubei húmagiñe lun hínsiñehabu humá nun,</para>
  <para style="q" vid="HOS 6:6">mama adagaragüdüni nabusenrubei húmagiñe;</para>
  <para style="q" vid="HOS 6:6">nabusenrun lun hasubudirunina keisi Bungiu</para>
  <para style="q" vid="HOS 6:6">mama lun hadagaragüdün le gudawarügüti nun».<verse eid="HOS 6:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="HOS 6:7" />«Gama lumoun adügaaña numutuniña kei ladüga Adán</para>
  <para style="q" vid="HOS 6:7">lau hadüraaguni nidaradun luma magunfulirun hamá numa.<verse eid="HOS 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 6:8" />Haburugute gürigia wuribatiña Galaadü,</para>
  <para style="q" vid="HOS 6:8">buin liña lau lárigirugu hitaü.<verse eid="HOS 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 6:9" />Fádirigu ha ñéinbaña,</para>
  <para style="q" vid="HOS 6:9">ítara haña keisi híwerutiña aranseñu habá gürigia,</para>
  <para style="q" vid="HOS 6:9">áfarahatiña, adüga hagía sun luwuyeri mabusigari lémerirugu Sikemü.<verse eid="HOS 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 6:10" />Arihaadina katei wuribaburiti uburugu Ísüraeli;</para>
  <para style="q" vid="HOS 6:10">huduguaali Éfürain houn búngiugu, dáseihali Ísüraeli.<verse eid="HOS 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 6:11" />Buguya giñe Hudá, arufuda naali luéyuri babeichún.</para>
  <para style="b" vid="HOS 6:11" />
  <para style="q" vid="HOS 6:11">«Dan le nabusenrun nasansiruni</para>
  <para style="q" vid="HOS 6:11">habunurun Ísüraelina ha numutuniña.<verse eid="HOS 6:11" /></para>
  <chapter eid="HOS 6" />
  <chapter number="7" style="c" sid="HOS 7" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 7:1" />Dan le nabusenrun nagaranihan houn numutuniña</para>
  <para style="q" vid="HOS 7:1">Éfürain luma Samaria ligía lafurangudun hafigoun luma hariban.</para>
  <para style="q" vid="HOS 7:1">Lugundun sun hagía eyeehatiña;</para>
  <para style="q" vid="HOS 7:1">belutiña hábiñoun mutu keisi híwerutiña,</para>
  <para style="q" vid="HOS 7:1">íweruha hagía hawéi gürigia ǘmadarugu.<verse eid="HOS 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 7:2" />Meberesegúntiña luagu haritagua nani sun hariban.</para>
  <para style="q" vid="HOS 7:2">Guentoti geyegua lumutiña hóuserun guánarügü le ligibugiñebei nagu súnwandan».<verse eid="HOS 7:2" /></para>
  <para style="s1">Luriban hóuserun arúeihatiña</para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 7:3" />«Éheragüda hamuti numutuniña urúei hama ábutigu</para>
  <para style="q" vid="HOS 7:3">lau hariban luma hayeeni.<verse eid="HOS 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 7:4" />Sun hagía agabaraha hamutiña hámarigu;</para>
  <para style="q" vid="HOS 7:4">ítara haña kei régigi,</para>
  <para style="q" vid="HOS 7:4">gemeeli ligía,</para>
  <para style="q" vid="HOS 7:4">aba máfuhanhaali lan ásürahati lau</para>
  <para style="q" vid="HOS 7:4">sun anuha lan fulúaru eresira.<verse eid="HOS 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 7:5" />Weyu le ladaürǘnbei liridin warúeite luagu,</para>
  <para style="q" vid="HOS 7:5">sándigüda hamuti ábutigu tau diwéin.</para>
  <para style="q" vid="HOS 7:5">Ani tulé lumuti lúhabu houn ha adaagubaña bula!<verse eid="HOS 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 7:6" />Aranse hamutu hanigi lun wuribani,</para>
  <para style="q" vid="HOS 7:6">kéigubeirügü hamuga lebedún aban régigi;</para>
  <para style="q" vid="HOS 7:6">arumugati ásürahati sun áriebu,</para>
  <para style="q" vid="HOS 7:6">gama lumoun larugan binaafin gemeñugili régigi buidu.<verse eid="HOS 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 7:7" />Sun hagía buintiña lau lisü igañi keisi aban régigi</para>
  <para style="q" vid="HOS 7:7">ani aba hagumuchaguagüdüniña aguseragüdütiña.</para>
  <para style="q" vid="HOS 7:7">Ítara liña hábürühan sun harúeitegu</para>
  <para style="q" vid="HOS 7:7">úati ni aban hádangiñe afurieiduti nun».<verse eid="HOS 7:7" /></para>
  <para style="s1">Ageiraü le adireirubei luéi Lubungiute</para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 7:8" />«Dáguaali Éfürain lungua hamoun amu gürigia.</para>
  <para style="q" vid="HOS 7:8">Ítara liña Éfürain kei aban durudia to ábanrügüti touba éfeda.<verse eid="HOS 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 7:9" />Gumú hamá gürigia terencha lere ibidiñoun lun.</para>
  <para style="q" vid="HOS 7:9">Íbini lídiburi haruha ibidiñoun lun!<verse eid="HOS 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 7:10" />Lupantan guánarügü Ísüraeli arufudubalin gadurun lan.</para>
  <para style="q" vid="HOS 7:10">Lau sun lira magararagúntiña</para>
  <para style="q" vid="HOS 7:10">lun háluahani Aburemei le Habungiute.<verse eid="HOS 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 7:11" />Ítara liña Éfürain</para>
  <para style="q" vid="HOS 7:11">kei aban unhun ibidiougaali tau,</para>
  <para style="q" vid="HOS 7:11">lamuriaha ídemuei luma Ehiptu,</para>
  <para style="q" vid="HOS 7:11">lárigiñe aba lidin lumoun Asiria.<verse eid="HOS 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 7:12" />Gama lumoun danme houdin ñein,</para>
  <para style="q" vid="HOS 7:12">náguruboun nisenin hau,</para>
  <para style="q" vid="HOS 7:12">ábame nanügüniña kei dunuru,</para>
  <para style="q" vid="HOS 7:12">nábürügüdübaña ladüga hariban».<verse eid="HOS 7:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="HOS 7:13" />«Fugiabugu hagía ladüga hadireirun nuéi!</para>
  <para style="q" vid="HOS 7:13">Lárügüdübaña günringuaü</para>
  <para style="q" vid="HOS 7:13">lugundun iñuraguaaña houngua nuagun.</para>
  <para style="q" vid="HOS 7:13">Busentina nesefuruniña gama lumoun eyeehatiña nuagu.<verse eid="HOS 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 7:14" />Lau sun hagúarahan dan le gabanarugu hamá,</para>
  <para style="q" vid="HOS 7:14">magúahan hamutina tau hanigi.</para>
  <para style="q" vid="HOS 7:14">Bíguatiña houngua lun hamuriahan türigu tuma diwéin;</para>
  <para style="q" vid="HOS 7:14">iñuraguaaña houngua nuagun!<verse eid="HOS 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 7:15" />Arufudahaadina yebe houn,</para>
  <para style="q" vid="HOS 7:15">ru au erei lun harüna,</para>
  <para style="q" vid="HOS 7:15">gama lumoun aransehatiña lun hadügün wuribani nun.<verse eid="HOS 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HOS 7:16" />Falaya hamaaña guáriuagu;</para>
  <para style="q" vid="HOS 7:16">Ítara haña kei gimara segetu</para>
  <para style="q" vid="HOS 7:16">to madagatu luagun le uágunbei tachürǘwa.</para>
  <para style="q" vid="HOS 7:16">Háfarawaguba hábutigu tau eféin ladüga hadimurehan lau éregu,</para>
  <para style="q" vid="HOS 7:16">ladügǘba bula hau Ehiptu».<verse eid="HOS 7:16" /></para>
  <chapter eid="HOS 7" />
  <chapter number="8" style="c" sid="HOS 8" />
  <para style="s1">Lasiadirún Ísüraeli</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 8:1" />«Winboun bifidun ladüga anute aban ágila tuagun luban Aburemei.</para>
  <para style="q" vid="HOS 8:1">Lugundun dürügua humaali nidaradun luma nilurudun.<verse eid="HOS 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 8:2" />Hayabinti agúaraheina nun, hariñaga:</para>
  <para style="q" vid="HOS 8:2">“Subudi wamutibu keisi Lubungiute Ísüraeli!”<verse eid="HOS 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 8:3" />Gama lumoun máhati Ísüraeli lun le buídubei,</para>
  <para style="q" vid="HOS 8:3">ligía héibaahabei lubéi láganiñu».<verse eid="HOS 8:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="HOS 8:4" />«Rútiña ábutigu ibidiñoun nun,</para>
  <para style="q" vid="HOS 8:4">málügüdahanga hagía numa.</para>
  <para style="q" vid="HOS 8:4">Barǘ hamaali hani pülata luma hagolun</para>
  <para style="q" vid="HOS 8:4">lun hadaagun guáriuagu,</para>
  <para style="q" vid="HOS 8:4">lun hagünrinchagun houngua.<verse eid="HOS 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 8:5" />Samaria, mínsiñeti liyawa bágasu le unbei báhuduragua nun!</para>
  <para style="q" vid="HOS 8:5">Durunguaali nigañi luagun.</para>
  <para style="q" vid="HOS 8:5">Ídaba funa san harumada Ísüraelina?<verse eid="HOS 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 8:6" />Liyawa bágasu Samariana le, mama Bungiu!</para>
  <para style="q" vid="HOS 8:6">Adügǘwarügüti ani lagünrinchawaguba.<verse eid="HOS 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 8:7" />Hagía bunaguatiña garabali,</para>
  <para style="q" vid="HOS 8:7">halubahaba luriban dan,</para>
  <para style="q" vid="HOS 8:7">macharibaña lun hábunagun,</para>
  <para style="q" vid="HOS 8:7">masagabaña fulúaru lídangiñe lin türigu,</para>
  <para style="q" vid="HOS 8:7">ánhañadügü asagara, héigiboun terencha.<verse eid="HOS 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 8:8" />Hulúaali Ísüraeli!</para>
  <para style="q" vid="HOS 8:8">Ítara liña harihini ha híbiri néchanigu</para>
  <para style="q" vid="HOS 8:8">kei aban katei le mebegiti.<verse eid="HOS 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 8:9" />Ladüga láluahani lídemuei Asiria</para>
  <para style="q" vid="HOS 8:9">keisi aban burigü áraabuna le deré taganbun.</para>
  <para style="q" vid="HOS 8:9">Ruti Éfürain idewesei lun lagañeihan lubúaligu!<verse eid="HOS 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 8:10" />Gama lumoun íbini líchugun edewehani houn néchanigu,</para>
  <para style="q" vid="HOS 8:10">guentó nadisedaguagüdaaña hawariuagua,</para>
  <para style="q" vid="HOS 8:10">lerederuba hafalarun urúeigu hama ábutigu luagu fiu dan».<verse eid="HOS 8:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="HOS 8:11" />«Lugundun adaaguati Éfürain saragu latarü,</para>
  <para style="q" vid="HOS 8:11">le eseriwidubei lun, lun lafigouhan.<verse eid="HOS 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 8:12" />Lau sun abürühanani buga narufudahan le gíbebei lun,</para>
  <para style="q" vid="HOS 8:12">barǘ lumuti kei katei terenchati.<verse eid="HOS 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 8:13" />Hínsiñeti adagaragüdüni gudawarügüti houn ani adüga hamuti,</para>
  <para style="q" vid="HOS 8:13">ani hóutiña lídangiñe úi le lánina adagaragüdüni gudawarügüti;</para>
  <para style="q" vid="HOS 8:13">gama lumoun au le Aburemei magundantina hama luagu lira;</para>
  <para style="q" vid="HOS 8:13">naritagubei wuribani le hadügübei,</para>
  <para style="q" vid="HOS 8:13">ábame nabeichuniña luagu hafigoun</para>
  <para style="q" vid="HOS 8:13">lau nagiribudagüdüniña Ehiptun.<verse eid="HOS 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 8:14" />Bunaguati burí Ísüraeli palasiu,</para>
  <para style="q" vid="HOS 8:14">gama lumoun bulíeiguati luéi le adügübalin.</para>
  <para style="q" vid="HOS 8:14">Ráramagüdati Hudá saragu uburugu derebuguti,</para>
  <para style="q" vid="HOS 8:14">gama lumoun nágudubei burí lidan aban watu le</para>
  <para style="q" vid="HOS 8:14">lunbei lágudunu lani burí palasiu».<verse eid="HOS 8:14" /></para>
  <chapter eid="HOS 8" />
  <chapter number="9" style="c" sid="HOS 9" />
  <para style="s1">Líchugun Oseasi ñunsu luagu labeichún Ísüraeli</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 9:1" />Magundaaraguabá Ísüraeli;</para>
  <para style="q" vid="HOS 9:1">machubahabá lau ugundani kei híbiri gürigia,</para>
  <para style="q" vid="HOS 9:1">ladüga ahoruhaadibu lau bígiruni Bubungiute.</para>
  <para style="q" vid="HOS 9:1">Hínsiñeti bun lun bafayeirúniwa luagu bahoruhan</para>
  <para style="q" vid="HOS 9:1">lidan fulasu le ñein lubéi léferehoua türigu.<verse eid="HOS 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 9:2" />Úabei türigu ni diwéin hama lánigu Ísüraeli;</para>
  <para style="q" vid="HOS 9:2">Memeniboun haniñe diwéin to iseri.<verse eid="HOS 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 9:3" />Lagiribuduba Éfürain Ehiptun,</para>
  <para style="q" vid="HOS 9:3">héigiba éigini wíyeti Asiria.</para>
  <para style="q" vid="HOS 9:3">Maganóundigiaañame lageira Aburemei.<verse eid="HOS 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 9:4" />Mátunbaña diwéin lidan liri Aburemei,</para>
  <para style="q" vid="HOS 9:4">míchugun hagíame adagaragüdüni lun ñein.</para>
  <para style="q" vid="HOS 9:4">Fein to héigiboun ítara tuba kei fein lánina lamiselu,</para>
  <para style="q" vid="HOS 9:4">ani ha éigitu fein tuguya, herederuba wíyeñu.</para>
  <para style="q" vid="HOS 9:4">Héigiboun fein tuguya,</para>
  <para style="q" vid="HOS 9:4">ánheinti lun hanügünu litenpulunrugu Aburemei siñabei.<verse eid="HOS 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 9:5" />Kaba san hadüga danme luéyuri fedu,</para>
  <para style="q" vid="HOS 9:5">le lufedun Aburemei?<verse eid="HOS 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 9:6" />Hagía anurahaaña luéi günringuaü;</para>
  <para style="q" vid="HOS 9:6">labudahabaña Ehiptu,</para>
  <para style="q" vid="HOS 9:6">habunúba uburugu Ménfisi.</para>
  <para style="q" vid="HOS 9:6">Labuinchuba harisin le pülata lau híduru,</para>
  <para style="q" vid="HOS 9:6">láhüchüba hiiyu hakianpun-ágeirugu.<verse eid="HOS 9:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="HOS 9:7" />Chülühali luéyuri abeichúni!</para>
  <para style="q" vid="HOS 9:7">Luéyuri labeichuni Bungiu lageira.</para>
  <para style="q" vid="HOS 9:7">Lasubudirubei Ísüraeli luagu chülühali lan dan ligía!</para>
  <para style="q" vid="HOS 9:7">Huguya, hariñahare:</para>
  <para style="q" vid="HOS 9:7">Aban deré taganbun profeta.</para>
  <para style="q" vid="HOS 9:7">Wügüri le hanichigubei, lǘlüti lau.</para>
  <para style="q" vid="HOS 9:7">Gama lumoun hariñagunbei ítara,</para>
  <para style="q" vid="HOS 9:7">ladüga buin hiña lan lau wuribani,</para>
  <para style="q" vid="HOS 9:7">lugundun weiri lan hiyereehabu.<verse eid="HOS 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 9:8" />Óunaha lumuti Bungiu lani profeta lun lawisaruni lageira,</para>
  <para style="q" vid="HOS 9:8">gama lumoun huguya, esetihatün sádara lubá;</para>
  <para style="q" vid="HOS 9:8">íbini tidan litenpulun Bungiu iyereeguti hun!<verse eid="HOS 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 9:9" />Gádeihadün sunsuinagubei,</para>
  <para style="q" vid="HOS 9:9">kei meha lidaaniwagu Gibeá.</para>
  <para style="q" vid="HOS 9:9">Gama lumoun laritaguba Aburemei luagu huriban</para>
  <para style="q" vid="HOS 9:9">ábame labeichunün luagu hifigoun.<verse eid="HOS 9:9" /></para>
  <para style="s1">Le lanügübei lifigoun Ísüraeli</para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 9:10" />Lariñahare Aburemei:</para>
  <para style="q" vid="HOS 9:10">«Dan le nadarirunbalin Ísüraeli</para>
  <para style="q" vid="HOS 9:10">aba nagundaaragun kei le adarirubei beibei lidan fulasu mageirawati.</para>
  <para style="q" vid="HOS 9:10">Ítara haña meha hagüchagu nun kei igu to agindutu furese.</para>
  <para style="q" vid="HOS 9:10">Gama lumoun dan le hachülürünbei Baali-peoru</para>
  <para style="q" vid="HOS 9:10">aba hederegeragun houngua houn hagübüri búngiugu,</para>
  <para style="q" vid="HOS 9:10">aba hǘnabudaguagüdün houngua kei guáriuagu ha meha hínsiñebaña houn.<verse eid="HOS 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 9:11" />Láhamahaba luéirigun Éfürain kei aban dunuru.</para>
  <para style="q" vid="HOS 9:11">Magaraüdǘnwaañame irahüñü.</para>
  <para style="q" vid="HOS 9:11">Úaañame würiña adageinadutiña,</para>
  <para style="q" vid="HOS 9:11">magaraüdǘnwaañame amu isaanigu.<verse eid="HOS 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 9:12" />Ánhañadügü hamuga aweinamuda hasaanigu,</para>
  <para style="q" vid="HOS 9:12">nagidaruñanu hamuga hawéi mígirunga ni aban houn.</para>
  <para style="q" vid="HOS 9:12">Fugiabugume gürigia ha danme le nadireirun hawéi!<verse eid="HOS 9:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 9:13" />Narihini lóuseruniña Éfürain lisaanigu</para>
  <para style="q" vid="HOS 9:13">kamá hamuga háliru agaliruhatiña;</para>
  <para style="q" vid="HOS 9:13">sagá lumutiña lun lederegeruniña lun háfarawagun hilagubei».<verse eid="HOS 9:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="HOS 9:14" />Aburemei, rubei le hadünabei houn!</para>
  <para style="q" vid="HOS 9:14">Ruba urageirugu maraüheiti houn luma aniguagu márati!<verse eid="HOS 9:14" /></para>
  <para style="s1">Lagañidun Aburemei luma Éfürain</para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 9:15" />Lariñahare Aburemei:</para>
  <para style="q" vid="HOS 9:15">«Adüga hamuti sun le wuribabei Gilügáli,</para>
  <para style="q" vid="HOS 9:15">ñein hagumesera eyereeguda nun.</para>
  <para style="q" vid="HOS 9:15">Nabugubaña núbiñegiñe ladüga luriban hóuserun;</para>
  <para style="q" vid="HOS 9:15">masigibadina lau nínsiñehabu houn,</para>
  <para style="q" vid="HOS 9:15">ladüga mabuchahatiña sun hábutigu.<verse eid="HOS 9:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HOS 9:16" />Bíwaguañein Éfürain;</para>
  <para style="q" vid="HOS 9:16">ítara liña kei aban tídibu wewe to mábeihali tílagüle,</para>
  <para style="q" vid="HOS 9:16">to magindunhaaru.</para>
  <para style="q" vid="HOS 9:16">Íbini liabin lun garahüñü lan, náfaragubaña».<verse eid="HOS 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HOS 9:17" />Máhatiña gürigia ha hadügün gasu lau Nubungiute;</para>
  <para style="q" vid="HOS 9:17">ligía lígirubaña lubéi Nubungiute houngua;</para>
  <para style="q" vid="HOS 9:17">herederuba éibudügü hadan néchanigu.<verse eid="HOS 9:17" /></para>
  <chapter eid="HOS 9" />
  <chapter number="10" style="c" sid="HOS 10" />
  <para style="s1">Lagünrinchawagun hani Ísüraelina latarü</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 10:1" />Ítara liña Ísüraeli kei aban lídibu beibei le gíbeti lin;</para>
  <para style="q" vid="HOS 10:1">gama lumoun sun meha dan le gíbetima lubéi lin,</para>
  <para style="q" vid="HOS 10:1">ligíatima ladaawagun latarü;</para>
  <para style="q" vid="HOS 10:1">dan létima buidu lubéi lumúan,</para>
  <para style="q" vid="HOS 10:1">ligíatima buídutima lan burí lidübüri le sagüráubei.<verse eid="HOS 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 10:2" />Fánreinguatu lanigi Ísüraeli,</para>
  <para style="q" vid="HOS 10:2">lafayeihati luagu lifigoun guentó.</para>
  <para style="q" vid="HOS 10:2">Lagünrinchagubei Aburemei lani burí latarü</para>
  <para style="q" vid="HOS 10:2">chagaléime burí lidübüri le sagüráubei.<verse eid="HOS 10:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="HOS 10:3" />Guentó hariñaguba gürigia ha:</para>
  <para style="q" vid="HOS 10:3">«Marúeitetiwa, lugundun minebenti Aburemei woun.</para>
  <para style="q" vid="HOS 10:3">Gama lumoun kaba hamugagia liyara</para>
  <para style="q" vid="HOS 10:3">aban urúei adüga luagu wafulesein?<verse eid="HOS 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 10:4" />Luéidigia ladimurehan saragu,</para>
  <para style="q" vid="HOS 10:4">magunfulirun lani le füramase láalibei luma laseinihan daradu;</para>
  <para style="q" vid="HOS 10:4">ítara luba hamuga liricha</para>
  <para style="q" vid="HOS 10:4">kei aban híduru péisiniti le áhüchübei lidan ichari».<verse eid="HOS 10:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="HOS 10:5" />Adadagaratiña lílana Samaria;</para>
  <para style="q" vid="HOS 10:5">aba hayahun lárigi liyawa bágasu le Betü-awenbei.</para>
  <para style="q" vid="HOS 10:5">Hayahuahañein lílana fulasu hama fádirigu,</para>
  <para style="q" vid="HOS 10:5">ladüga gumugua luéirigun.<verse eid="HOS 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 10:6" />Bágasu guánarügü ligía,</para>
  <para style="q" vid="HOS 10:6">lanügǘba Asirioun lun lichugún lun urúei.</para>
  <para style="q" vid="HOS 10:6">Ítara luba lerederun Éfürain lau busiganu:</para>
  <para style="q" vid="HOS 10:6">Lanügüba Ísüraeli busiganu lau liguariuan.<verse eid="HOS 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 10:7" />Lagumuchaguba lurúeite Samaria</para>
  <para style="q" vid="HOS 10:7">kei aban life wewe le áfayaruti ligibuagu duna.<verse eid="HOS 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 10:8" />Tagünrinchawaguba burí hasanduariun gibe tubungiutegu</para>
  <para style="q" vid="HOS 10:8">to ñéinñaha lubéi hafigouha lánigu Ísüraeli.</para>
  <para style="q" vid="HOS 10:8">Láhüchüba lagübüri sagadi luma hiiyu luagu burí hani latarü,</para>
  <para style="q" vid="HOS 10:8">hariñaguba gürigia lun burí wübü:</para>
  <para style="q" vid="HOS 10:8">«Darugua humá wau!»</para>
  <para style="q" vid="HOS 10:8">«Heigua humá wawagun!»<verse eid="HOS 10:8" /></para>
  <para style="s1">Lasiadiruni Aburemei Ísüraeli</para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 10:9" />Lariñahare Aburemei:</para>
  <para style="q" vid="HOS 10:9">«Lúmagiñe hagumeserun Ísüraeli afigouha uburugu Gibeá,</para>
  <para style="q" vid="HOS 10:9">meredegili hafigouhan.</para>
  <para style="q" vid="HOS 10:9">Aban le houn lidan hafigoun!</para>
  <para style="q" vid="HOS 10:9">Ligía lárügüdübaña lubéi wuribu</para>
  <para style="q" vid="HOS 10:9">gürigia wuribatiña ha, uburugu Gibeá.<verse eid="HOS 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 10:10" />Nabeichubaña gürigia danme le nabusenrun.</para>
  <para style="q" vid="HOS 10:10">Hóundaraguba néchanigu kóntüra hagía</para>
  <para style="q" vid="HOS 10:10">danme le nabeichuniña luagu hariban.<verse eid="HOS 10:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="HOS 10:11" />«Ítara liña bugaha Éfürain kei aban bágasu ñǘraügiru</para>
  <para style="q" vid="HOS 10:11">to hínsiñeti tun lun téferehan ilaü.</para>
  <para style="q" vid="HOS 10:11">Guentó rúhadina yugu luagu ligiina Éfürain</para>
  <para style="q" vid="HOS 10:11">lun lachawahan karü;</para>
  <para style="q" vid="HOS 10:11">Hudá, ligíaba achawahei awouhagülei,</para>
  <para style="q" vid="HOS 10:11">Hakobu ligíaba achawahei reeka.<verse eid="HOS 10:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 10:12" />Nariñaga houn: Bunagua humá irichaü,</para>
  <para style="q" vid="HOS 10:12">halubaha ínsiñehabuni.</para>
  <para style="q" vid="HOS 10:12">Aranse huméi múa lubá aban iseri bunaguaü,</para>
  <para style="q" vid="HOS 10:12">lugundun lidaanihali láluahoun Aburemei,</para>
  <para style="q" vid="HOS 10:12">danme liabin lanügüba huya lánina esefuruni huagun.<verse eid="HOS 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 10:13" />Gama lumoun huguya wuribani hábunagubei,</para>
  <para style="q" vid="HOS 10:13">alubahaadün marichaü,</para>
  <para style="q" vid="HOS 10:13">hóuhadün lin iyeeni.</para>
  <para style="b" vid="HOS 10:13" />
  <para style="q" vid="HOS 10:13">«Ladüga bemenigidun tuagu burí bikarün to lánina wuribu</para>
  <para style="q" vid="HOS 10:13">luma hawagu hibe bánigu ha wuriburuguna.<verse eid="HOS 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 10:14" />Ñeinbei chagaguaü hadan bumutuniña</para>
  <para style="q" vid="HOS 10:14">günrinwagua ligíame sun buburugute le derebuguti,</para>
  <para style="q" vid="HOS 10:14">ítara kei lagünrinchaguni Betü-arübéli le lurúeite Salümán lidan luéyuri wuribu,</para>
  <para style="q" vid="HOS 10:14">dan le taburechawagunbei úguchuru hau tirahüñü.<verse eid="HOS 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 10:15" />Ligiamémeba giñe asusereda hun,</para>
  <para style="q" vid="HOS 10:15">huguya lílana Beteli,</para>
  <para style="q" vid="HOS 10:15">ladüga lueirin huriban.</para>
  <para style="q" vid="HOS 10:15">Lóunweba lurúeite Ísüraeli úara luma larugadun!»<verse eid="HOS 10:15" /></para>
  <chapter eid="HOS 10" />
  <chapter number="11" style="c" sid="HOS 11" />
  <para style="s1">Línsiñehabu Bungiu houn lumutuniña mabuchahatiña</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 11:1" />«Dan meha le ñǘraügili Ísüraeli,</para>
  <para style="q" vid="HOS 11:1">hínsiñetimatiha nun kei meha niráü lubéi;</para>
  <para style="q" vid="HOS 11:1">wátina lun Ehiptugiñe.<verse eid="HOS 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 11:2" />Gama lumoun dántima le nagúahan lun,</para>
  <para style="q" vid="HOS 11:2">ligíatima ladisedun nuéi.</para>
  <para style="q" vid="HOS 11:2">Dagagüdati houn búngiugu ha mama Bungiu,</para>
  <para style="q" vid="HOS 11:2">águdaha ligía kupali houn guáriuagu.<verse eid="HOS 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 11:3" />Lau sun lira,</para>
  <para style="q" vid="HOS 11:3">adundeha numutiña lumutuniña Éfürain,</para>
  <para style="q" vid="HOS 11:3">arufudaha au éibuguni houn;</para>
  <para style="q" vid="HOS 11:3">gama lumoun úati gunfuranda hamani</para>
  <para style="q" vid="HOS 11:3">luagu au lan buga adundehabaliña.<verse eid="HOS 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 11:4" />Achawaha numutiña nuouguoun lau ínsiñehabuni;</para>
  <para style="q" vid="HOS 11:4">yarafagüda numutiña luagun nubuyubu</para>
  <para style="q" vid="HOS 11:4">kamá hamuga irahüñü guragiña;</para>
  <para style="q" vid="HOS 11:4">lemutina lun néigagüdüniña.<verse eid="HOS 11:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 11:5" />Gama lumoun hagía máhatiña hagiribudun nun.</para>
  <para style="q" vid="HOS 11:5">Ligíati hagiribuduba lubéi Ehiptun,</para>
  <para style="q" vid="HOS 11:5">larúeihaba Asiria hawagu.<verse eid="HOS 11:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 11:6" />Tábürühaba eféin luagun burí haburugute,</para>
  <para style="q" vid="HOS 11:6">tagumuchuba lau burí liderebugu haburugute,</para>
  <para style="q" vid="HOS 11:6">tagünrinchaguboun ladüga hariban.<verse eid="HOS 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 11:7" />Aban le houn numutuniña lau hadisedun nuéi;</para>
  <para style="q" vid="HOS 11:7">agúarahatiña iñun,</para>
  <para style="q" vid="HOS 11:7">gama lumoun úati íderagutiña».<verse eid="HOS 11:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="HOS 11:8" />«Ida lubagia nígirunibu Éfürain?</para>
  <para style="q" vid="HOS 11:8">Ida lubagia nágurunibu Ísüraeli?</para>
  <para style="q" vid="HOS 11:8">Gayaraabei funagia nagünrinchagunibu</para>
  <para style="q" vid="HOS 11:8">kei nagünrinchaguni uburugu Adümá,</para>
  <para style="q" vid="HOS 11:8">o nadügün lan bun kei nadüga lun Seboimü?</para>
  <para style="q" vid="HOS 11:8">Buin tiña nanigi lau gudemehabu bun!<verse eid="HOS 11:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 11:9" />Múaradunbadina luma lanarime nigañi.</para>
  <para style="q" vid="HOS 11:9">Magünrinchagundigia naali Éfürain,</para>
  <para style="q" vid="HOS 11:9">lugundun mama au wügüri, Bungiu au.</para>
  <para style="q" vid="HOS 11:9">Au sandu le bamidanguabei,</para>
  <para style="q" vid="HOS 11:9">ani mama niábiña agünrinchaguabu».<verse eid="HOS 11:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="HOS 11:10" />Hagía hafalarubei Aburemei,</para>
  <para style="q" vid="HOS 11:10">ligía ladürürühaba kei aban liñún.</para>
  <para style="q" vid="HOS 11:10">Ladürügüdüba ábame hayabin lánigu adadagareina</para>
  <para style="q" vid="HOS 11:10">lídangiñe oubaü le ñeinhin lubéi lálüda weyu,<verse eid="HOS 11:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="HOS 11:11" />«Hayabinba kei dunuru adadagareina Ehiptugiñe;</para>
  <para style="q" vid="HOS 11:11">hayabinba Asiriagiñe kei unhun;</para>
  <para style="q" vid="HOS 11:11">ábame nadügün lunya haganóun hábiñe.</para>
  <para style="q" vid="HOS 11:11">Au, le Aburemei ariñagubalin».<verse eid="HOS 11:11" /></para>
  <para style="s1">Lisalufurin lageira Bungiu</para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 11:12" />«Geyegua láadina Éfürain lau iyeeni;</para>
  <para style="q" vid="HOS 11:12">geyegua hamaadina lumutuniña Ísüraeli lau eyeeraguni.</para>
  <para style="q" vid="HOS 11:12">Díreihali Hudá luéi Bungiu,</para>
  <para style="q" vid="HOS 11:12">guentoti gúnfuliti hama guáriua.<verse eid="HOS 11:12" /></para>
  <chapter eid="HOS 11" />
  <chapter number="12" style="c" sid="HOS 12" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 12:1" />Adaaguagubeirügü wuribani leredera Ísüraeli,</para>
  <para style="q" vid="HOS 12:1">sun weyu lau adaagua katei málati.</para>
  <para style="q" vid="HOS 12:1">Gánwoungüda lumuti liyeeni luma lanarime,</para>
  <para style="q" vid="HOS 12:1">adaaguati daradu luma Asiria</para>
  <para style="q" vid="HOS 12:1">óunaha ligía edewehani le garaba lun Ehiptu».<verse eid="HOS 12:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="HOS 12:2" />Lageindaguña Aburemei luma Ísüraeli.</para>
  <para style="q" vid="HOS 12:2">Labeichubaña Bungiu kei le ladünabei hóuserun.<verse eid="HOS 12:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 12:3" />Lubaragiñebei lágurahoun Hakobu,</para>
  <para style="q" vid="HOS 12:3">ragǘ lumuti lubara líbugaña,</para>
  <para style="q" vid="HOS 12:3">dan le wügürihali ageindaguati luma Bungiu.<verse eid="HOS 12:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 12:4" />Ageindaguati luma aban ánheli, aba lagañeiruni;</para>
  <para style="q" vid="HOS 12:4">ayahuahati ayumuragua ligía lun, lun gudemehabu lan lun.</para>
  <para style="q" vid="HOS 12:4">Dúnguati Bungiu luma Hakobu Beteli,</para>
  <para style="q" vid="HOS 12:4">aba ladimurehan luma ñein.<verse eid="HOS 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 12:5" />Aburemei, Bungiu Suntigabafu,</para>
  <para style="q" vid="HOS 12:5">ligía líribei!<verse eid="HOS 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 12:6" />Ítara liña lubeiti, Ísüraeli,</para>
  <para style="q" vid="HOS 12:6">giribubá lun Bubungiute;</para>
  <para style="q" vid="HOS 12:6">buadigimarida lau úarani,</para>
  <para style="q" vid="HOS 12:6">hemenigibá luagu Bubungiute súnwandan.<verse eid="HOS 12:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="HOS 12:7" />Lariñahare Aburemei:</para>
  <para style="q" vid="HOS 12:7">«Anihein balansu híweruti lúhaburugu Kanán,</para>
  <para style="q" vid="HOS 12:7">ladüga hínsiñeti lun lun líweruhan.<verse eid="HOS 12:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 12:8" />Lariñahare Éfürain:</para>
  <para style="q" vid="HOS 12:8">“Rísihadina, darihadina aban irisini;</para>
  <para style="q" vid="HOS 12:8">gama lumoun úati ni aban gayaraati lariñagun</para>
  <para style="q" vid="HOS 12:8">luagu lau lan marichaü nadarirei nirisin!”<verse eid="HOS 12:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 12:9" />Au le Aburemei, le Bubungiutebei lúmagiñe meha Ehiptugidibu lan,</para>
  <para style="q" vid="HOS 12:9">nadügüba lunya baganóun tidan kianpu,</para>
  <para style="q" vid="HOS 12:9">kei meha burí dan le lidaani wadunragun</para>
  <para style="q" vid="HOS 12:9">lidan fulasu mageirawati.<verse eid="HOS 12:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="HOS 12:10" />«Adimurehatina houn profetagu</para>
  <para style="q" vid="HOS 12:10">gánwoungüdanei hawenedü;</para>
  <para style="q" vid="HOS 12:10">adimurehatina hádangiñe lau hénpulu.<verse eid="HOS 12:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 12:11" />Añahein búngiugu Galaadü,</para>
  <para style="q" vid="HOS 12:11">gama lumoun búngiugu ha mama Bungiu hagía.</para>
  <para style="q" vid="HOS 12:11">Afarúatiña bágasu Gilügáli lun adagaragüdüni;</para>
  <para style="q" vid="HOS 12:11">ítara liña burí lani latarü</para>
  <para style="q" vid="HOS 12:11">kei dübü óundarawaguti áraabu».<verse eid="HOS 12:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="HOS 12:12" />Anurahati meha Hakobu áraabun Aramü, nadagimeinti ñein óunigira mudún lun ladarirun lúmari. <verse eid="HOS 12:12" /><verse number="13" style="v" sid="HOS 12:13" />Sagá lumutiña Aburemei Ísüraelina Ehiptugiñe lau aban profeta; góunigi lumutiña Bungiu lau profeta ligía.<verse eid="HOS 12:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="HOS 12:14" />Gáñigüda hamaali lánigu Éfürain Aburemei,</para>
  <para style="q" vid="HOS 12:14">ligía lafayeiragüdübaña lubéi Aburemei luagu háfarahan,</para>
  <para style="q" vid="HOS 12:14">lábürügüdübei hariban guánarügü hawagun.<verse eid="HOS 12:14" /></para>
  <chapter eid="HOS 12" />
  <chapter number="13" style="c" sid="HOS 13" />
  <para style="s1">Lagünrinchawagun Ísüraeli</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 13:1" />Dan buga le hadimurehan lánigu Éfürain,</para>
  <para style="q" vid="HOS 13:1">arufuda hamuti híbiri lani Ísüraeli türibu henebenehabu;</para>
  <para style="q" vid="HOS 13:1">gama lumoun aba lounwen Éfürain ladüga láhuduragun lun Baali.<verse eid="HOS 13:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 13:2" />Ani añahamémegua afigouha!</para>
  <para style="q" vid="HOS 13:2">Adaaguatiña guáriuagu lau hani pülata,</para>
  <para style="q" vid="HOS 13:2">búngiugu ha hadüga wügüriña kei le auti habusenraña.</para>
  <para style="q" vid="HOS 13:2">Lárigiñe aba hariñagun:</para>
  <para style="q" vid="HOS 13:2">«Hadagaragüda houn!»</para>
  <para style="q" vid="HOS 13:2">Aba hachuuhaniña gürigia guáriua hagía</para>
  <para style="q" vid="HOS 13:2">ha hayawa bágasu wügüriña.<verse eid="HOS 13:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 13:3" />Ligía ítara haba lubéi kei hemereedu le lánina binaafin</para>
  <para style="q" vid="HOS 13:3">kei serenu le lánina larugadun,</para>
  <para style="q" vid="HOS 13:3">le agumuchagubei binaafingiua,</para>
  <para style="q" vid="HOS 13:3">kei ifei le lanügübei garabali;</para>
  <para style="q" vid="HOS 13:3">kei gumuleli le áfuridubei lídangiñe funedera.<verse eid="HOS 13:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="HOS 13:4" />Lariñahare Aburemei:</para>
  <para style="q" vid="HOS 13:4">«Au, le Aburemei Bubungiutebei lúmagiñe meha Ehiptugidibu:</para>
  <para style="q" vid="HOS 13:4">Manügabá amu keisi Bungiu nuéidigia,</para>
  <para style="q" vid="HOS 13:4">lugundun áurügüñein besefuragüle.<verse eid="HOS 13:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 13:5" />Góunigi numutibu buga</para>
  <para style="q" vid="HOS 13:5">lidan lisü fulasu mageirawati.<verse eid="HOS 13:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="HOS 13:6" />«Gama lumoun dan le lagibedunbei heigin darí lun lígiragun,</para>
  <para style="q" vid="HOS 13:6">aba habuinchun lau pantaü aba habulieidunina.<verse eid="HOS 13:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 13:7" />Ítara nuba lubeiti houn kei aban liñún,</para>
  <para style="q" vid="HOS 13:7">kei aban leoparüdu le agaradahati habá luagu üma.<verse eid="HOS 13:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 13:8" />Náfuriduba habaroun kei aban ounli áraabuna</para>
  <para style="q" vid="HOS 13:8">to eferidirubaliña tirahüñü,</para>
  <para style="q" vid="HOS 13:8">ábame nagünrinchagunu hanigi.</para>
  <para style="q" vid="HOS 13:8">Néigibaña kei aban liñún ñein guánarügü;</para>
  <para style="q" vid="HOS 13:8">nagünrinchagubaña kei aban animaalu gáñiti.<verse eid="HOS 13:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 13:9" />Nagünrinchagubadibu Ísüraeli,</para>
  <para style="q" vid="HOS 13:9">úabei erederutina luéi nadügüni.<verse eid="HOS 13:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 13:10" />Hageigia burúeite guentó,</para>
  <para style="q" vid="HOS 13:10">lun lesefurunibu lidan sun buburugute?</para>
  <para style="q" vid="HOS 13:10">Hagañagia ha buga úmabaña bamuriaha urúei hama ábutigu?<verse eid="HOS 13:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 13:11" />Gáñiñu buma, aba níchugun burúeite,</para>
  <para style="q" vid="HOS 13:11">gáñiñu buma, aba nagidaruniña buéi».<verse eid="HOS 13:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="HOS 13:12" />«Bürüwaali luriban Éfürain luma lifigoun.<verse eid="HOS 13:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 13:13" />Chülühali lóurate lágurahoun Ísüraeli,</para>
  <para style="q" vid="HOS 13:13">gama lumoun wéiriti libidiounigan lau,</para>
  <para style="q" vid="HOS 13:13">darí lun siñagua lan lungua</para>
  <para style="q" vid="HOS 13:13">lun lesetiragun lungua lidan lubudubu lun lágurahoun.<verse eid="HOS 13:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 13:14" />Nesefurañame san ítara luéi lubafu umúahaü?</para>
  <para style="q" vid="HOS 13:14">Nesefurañame san luéi óunweni?</para>
  <para style="q" vid="HOS 13:14">Óunweni, hagéi bubafu lun bagünrinchagun?</para>
  <para style="q" vid="HOS 13:14">Umuahaü, hagéi burí buriban?</para>
  <para style="q" vid="HOS 13:14">Magudemedunhaña gürigia ha nun!»<verse eid="HOS 13:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 13:15" />Íbini láhüchagun Ísüraeli kei híduru,</para>
  <para style="q" vid="HOS 13:15">láfuruba garabali,</para>
  <para style="q" vid="HOS 13:15">garabali héreti le áfurubei luéigiñe fulasu mageirawati,</para>
  <para style="q" vid="HOS 13:15">ábame lamabeidagüdüni lísensen lidunari.</para>
  <para style="q" vid="HOS 13:15">Labayurubei lágani lirisin luéi.<verse eid="HOS 13:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HOS 13:16" />Hanügübei lílana Samaria habeichún</para>
  <para style="q" vid="HOS 13:16">ladüga hiñuragun houngua luagun Habungiute.</para>
  <para style="q" vid="HOS 13:16">Háfarawaguba tau eféin,</para>
  <para style="q" vid="HOS 13:16">haburechawaguba hasaanigu múarugu,</para>
  <para style="q" vid="HOS 13:16">hagünrinchawaguba würiña dageinatiña.<verse eid="HOS 13:16" /></para>
  <chapter eid="HOS 13" />
  <chapter number="14" style="c" sid="HOS 14" />
  <para style="ms">III. Lasakürihan Ísüraeli Luma Füramasei Lánina Esefuruni</para>
  <para style="mr">(<ref loc="HOS 14:1-9">14.1-9</ref>)</para>
  <para style="s1">Lamuriahan Oseasi luma Ísüraeli lun lagiribudun lun Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 14:1" />Ísüraeli, buguya le ábürühabei ladüga bifigoun,</para>
  <para style="q" vid="HOS 14:1">giribubá lun Bubungiute!<verse eid="HOS 14:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 14:2" />Giribu humá lun Aburemei ariñageina humeime furíeigi le:</para>
  <para style="q" vid="HOS 14:2">«Ferudunabéi sun wariban,</para>
  <para style="q" vid="HOS 14:2">resibibéi weremuhan bun lau bareini.<verse eid="HOS 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 14:3" />Siñati lasalbaruniwa Asiria,</para>
  <para style="q" vid="HOS 14:3">ni lun wanurahan gabayuagu.</para>
  <para style="q" vid="HOS 14:3">Manügünhadiwa ni kata le wadüga lau wáhabu keisi Wabungiute,</para>
  <para style="q" vid="HOS 14:3">ladüga buguyarügüñein gudemehabu houn méteñuhaña, Aburemei».<verse eid="HOS 14:3" /></para>
  <para style="s1">Iseri ibagari lun Ísüraeli</para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 14:4" />Lariñahare Aburemei:</para>
  <para style="q" vid="HOS 14:4">«Nagaraniha houn lídangiñe hariban;</para>
  <para style="q" vid="HOS 14:4">hínsiñebaña nun lau sun madüna hamani,</para>
  <para style="q" vid="HOS 14:4">ladüga díreiha nigañi hawéi.<verse eid="HOS 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 14:5" />Ítara nuba lun Ísüraeli kei hemereedu,</para>
  <para style="q" vid="HOS 14:5">ábame lafulurihan kei liriu,</para>
  <para style="q" vid="HOS 14:5">derebugubei lílagüle kei wübü Líwanu;<verse eid="HOS 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 14:6" />buíduburibei lilimun kei lilimun oliwu,</para>
  <para style="q" vid="HOS 14:6">ítara luba líhemen kei hibúari le Líwanuna.<verse eid="HOS 14:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 14:7" />Haganóuayaba Ísüraelina lábugiñe nóunigirun;</para>
  <para style="q" vid="HOS 14:7">ábameti haweinamudun kei türigu,</para>
  <para style="q" vid="HOS 14:7">hegelewehaba kei tídibu beibei,</para>
  <para style="q" vid="HOS 14:7">dísebei laganbahoun hawagu</para>
  <para style="q" vid="HOS 14:7">kei diwéin to Líwanuna.<verse eid="HOS 14:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 14:8" />Lariñaguba Éfürain:</para>
  <para style="q" vid="HOS 14:8">“Meberesegúntina hau guáriuagu”</para>
  <para style="q" vid="HOS 14:8">Au etenirubei houn numutuniña!</para>
  <para style="q" vid="HOS 14:8">Ítara niña kei aban lídibu gudi hilumañu súnwandan,</para>
  <para style="q" vid="HOS 14:8">ani hadarirubei numutuniña nin súnwandan».<verse eid="HOS 14:8" /></para>
  <para style="s1">Lagumuhóun eweridiruni</para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 14:9" />Gunfuranda haméi chu tau hama buidu tichügü uganu le:</para>
  <para style="q" vid="HOS 14:9">Suruburiti lémeri Aburemei,</para>
  <para style="q" vid="HOS 14:9">ani falá hamuti ha richaguabaña;</para>
  <para style="q" vid="HOS 14:9">ánhañati ha wuribabaña chugeguatiña luagu.<verse eid="HOS 14:9" /></para>
  <chapter eid="HOS 14" />
</usx>