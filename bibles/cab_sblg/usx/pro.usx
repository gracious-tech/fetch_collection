<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">PROV4-98.TXT (Encoding update 2008) 27/02/2001 CAP C.R, GARIFUNA</book>
  <para style="h">Ariñawagúni</para>
  <para style="toc3">Ari</para>
  <para style="toc2">Ariñawaguni</para>
  <para style="toc1">Ariñawaguni</para>
  <para style="mt2">Liliburun</para>
  <para style="mt1">ARIÑAWAGÚNI</para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="ms">I. Ebelaagülei</para>
  <para style="mr">(<ref loc="PRO 1:1-7">1.1-7</ref>)</para>
  <para style="s1">Lebegi burí ariñawagúni</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 1:1" />Anihán burí ariñawagúni le labürühabei Salomón,</para>
  <para style="q" vid="PRO 1:1">lurúeite Ísüraeli, le liráü Dawidi.<verse eid="PRO 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 1:2" />Labürühanbalin dimurei burí le</para>
  <para style="q" vid="PRO 1:2">lun larufudahan houn lumutuniña</para>
  <para style="q" vid="PRO 1:2">lun habagaridun lau lichú aau,</para>
  <para style="q" vid="PRO 1:2">richaguaü, ísuruni luma arumani.<verse eid="PRO 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 1:3" />Lun líchugun aban igaburi lánina ibagari</para>
  <para style="q" vid="PRO 1:3">le richati ani úaraguati houn.<verse eid="PRO 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 1:4" />Lariñaga: «Busentina lun lachuuduba lan</para>
  <para style="q" vid="PRO 1:4">hau gürigia ha harumabaña anigi,</para>
  <para style="q" vid="PRO 1:4">luma lun narufudahan houn nibureintiña</para>
  <para style="q" vid="PRO 1:4">ida luba lan hagagibudagun</para>
  <para style="q" vid="PRO 1:4">ani aranseha hameime turobuli lidan ibagari le!»<verse eid="PRO 1:4" /></para>
  <para style="q">
    <verse number="5-6" style="v" sid="PRO 1:5-6" />Gürigia chu tau ha aganbuti dimurei le,</para>
  <para style="q" vid="PRO 1:5-6">lachuudatimaba hau,</para>
  <para style="q" vid="PRO 1:5-6">ánhañati nibureintiña gunfurandatimahañame</para>
  <para style="q" vid="PRO 1:5-6">ani gayaraahalime haransehan turobuli le hénrenguti.<verse eid="PRO 1:5-6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 1:7" />Linebenwa Bungiu lagumesehabei lichú aau.</para>
  <para style="q" vid="PRO 1:7">Hárügüñanu ibidiouguabaña aau máhabaña lun arufudahani</para>
  <para style="q" vid="PRO 1:7">ru hagía mebereseni lun lichú aau.<verse eid="PRO 1:7" /></para>
  <para style="ms">II. Ariñawagúni Lánina Lichú Aau</para>
  <para style="mr">(<ref loc="PRO 1:8-9:18">1.8—9.18</ref>)</para>
  <para style="s1">Eweridihani burí houn nibureintiña</para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 1:8" />Niráü, aganbabéi lererun búguchi,</para>
  <para style="q" vid="PRO 1:8">teni buguyame lun tarufudahan búguchu;<verse eid="PRO 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 1:9" />ladüga ítara luba kei aban uéndeni bun,</para>
  <para style="q" vid="PRO 1:9">kei aban iñari o kei lan aban ridi.<verse eid="PRO 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 1:10" />Ánhaña abusenra gafigountiña heyeedunibu,</para>
  <para style="q" vid="PRO 1:10">mígiraba lun hadügüni, niráü!<verse eid="PRO 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 1:11" />Ánhaña ariñaga bun:</para>
  <para style="q" vid="PRO 1:11">«Higabu wama, le wáhureragun,</para>
  <para style="q" vid="PRO 1:11">wesetiruba sádara lubá aban madurunti</para>
  <para style="q" vid="PRO 1:11">lun wáfaruni hilagubei danme lásügürün.<verse eid="PRO 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 1:12" />Wáhuluchubaña gürigia buítiña wínwanñu,</para>
  <para style="q" vid="PRO 1:12">kei láhuluchuniña óunweni ha ábürühatiña lidoun umúahaü.<verse eid="PRO 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 1:13" />Wadariruba sun luwuyeri irisini,</para>
  <para style="q" vid="PRO 1:13">wabuinchagüdüboun waban lau sun le wíweruhan!<verse eid="PRO 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 1:14" />Higabu, houchabéi bubunurun wama;</para>
  <para style="q" vid="PRO 1:14">wafanreinhabei sun le lunbei wadariruni».<verse eid="PRO 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 1:15" />Méibugaba hama, niráü!</para>
  <para style="q" vid="PRO 1:15">Disebá luéi lagübüri hémeri.<verse eid="PRO 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 1:16" />Ladüga éibaaguatiña lun hadügüni le wuribabei,</para>
  <para style="q" vid="PRO 1:16">óufudahatiña lun háwiyurun hitaü.<verse eid="PRO 1:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PRO 1:17" />Lau sun mala lan tesetirúniwa sádara habá dunuru</para>
  <para style="q" vid="PRO 1:17">anhein aríagu haña lubéi tun;<verse eid="PRO 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 1:18" />gürigia hagía, sétitiña sádara habaruagua</para>
  <para style="q" vid="PRO 1:18">ani ru hamuti habagari lidoun denchaü.<verse eid="PRO 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 1:19" />Ítara liña hagumuchagun ha igaaduabaña,</para>
  <para style="q" vid="PRO 1:19">áfaragua lumutiña uámaahabu le hawagubei.<verse eid="PRO 1:19" /></para>
  <para style="s1">Lagunbirahan lichú aau</para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 1:20" />Agúarahati lichú aau ǘmadarugu,</para>
  <para style="q" vid="PRO 1:20">aganbagüda lumuti lumalali párükerugu;<verse eid="PRO 1:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 1:21" />adimurehati lubadu burí bena,</para>
  <para style="q" vid="PRO 1:21">lidan burí fulasu le ñein lumuti guririguaü uburugu,</para>
  <para style="q" vid="PRO 1:21">lariñagati:<verse eid="PRO 1:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 1:22" />«Nibureintiña,</para>
  <para style="q" vid="PRO 1:22">gadaaguaditiña bula, ibidiougua tau,</para>
  <para style="q" vid="PRO 1:22">ídaba san hígirei libidiounigan aau,</para>
  <para style="q" vid="PRO 1:22">ladarirúniwa ugundani lidan ladaawagun bula,</para>
  <para style="q" vid="PRO 1:22">luma mebereseni lau lichú aau?<verse eid="PRO 1:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 1:23" />Ru huméi harigei lun narufudahan,</para>
  <para style="q" vid="PRO 1:23">ábame nabuinchagüdünün lau nani sífiri;</para>
  <para style="q" vid="PRO 1:23">nasubudiragüdübei nisaminan hun.<verse eid="PRO 1:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 1:24" />Agúahaadina hun, agunbiraha naadün lun hiabin,</para>
  <para style="q" vid="PRO 1:24">gama lumoun máhagidün hadügün gasu.<verse eid="PRO 1:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 1:25" />Lubaragiñe lira, rúrügü huguya mebereseni lau neweridihan,</para>
  <para style="q" vid="PRO 1:25">máhatün heresibiruni nererehan.<verse eid="PRO 1:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 1:26" />Néherahaba giñe danme liabin lamiselu hun!</para>
  <para style="q" vid="PRO 1:26">Nadaaguba bula hau danme buin humá lau anufudei,<verse eid="PRO 1:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 1:27" />danme liabin anufudei hun luma lénrengunga,</para>
  <para style="q" vid="PRO 1:27">asufuriruni luma idiheri,</para>
  <para style="q" vid="PRO 1:27">kei liabin aban hiriri le agünrinchagubalin sun katei!<verse eid="PRO 1:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PRO 1:28" />Lídanme weyu ligía, hagúahaba nun,</para>
  <para style="q" vid="PRO 1:28">gama lumoun móunabun nubadün,</para>
  <para style="q" vid="PRO 1:28">háluahabadina ani madari hubadina,<verse eid="PRO 1:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 1:29" />ladüga rutün mebereseni lau subudi,</para>
  <para style="q" vid="PRO 1:29">ani máhatün híchugun inebesei lun Bungiu.<verse eid="PRO 1:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 1:30" />Máhatün heresibiruni neweridihan,</para>
  <para style="q" vid="PRO 1:30">meberesentün lau nererehan.<verse eid="PRO 1:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 1:31" />Hasufurirubei lafayeiruaha hóuserun!</para>
  <para style="q" vid="PRO 1:31">Labuchadagüdüba luriban haritagun huagu!<verse eid="PRO 1:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 1:32" />Ha lóuguabaña isubudin,</para>
  <para style="q" vid="PRO 1:32">áfaragua lumutiña lilouguan hasubudin;</para>
  <para style="q" vid="PRO 1:32">ha ibidiouguabaña aau,</para>
  <para style="q" vid="PRO 1:32">günringua lumutiña mebereseni le hádanbei.<verse eid="PRO 1:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 1:33" />Ánhaña ha íchugutiña harigei lun le nubeibei,</para>
  <para style="q" vid="PRO 1:33">habagariduba darangilu,</para>
  <para style="q" vid="PRO 1:33">ani manufudeuga luéi denchaü».<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s1">Buiti le líchugubei lichú aau</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 2:1" />Niráü, furendeibéi le narufudahabei bun,</para>
  <para style="q" vid="PRO 2:1">mabulieidabei nugumadin.<verse eid="PRO 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 2:2" />Ruba arigei lun lichú aau,</para>
  <para style="q" vid="PRO 2:2">deregebéi bisaminan lun lualin ichügü.<verse eid="PRO 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 2:3" />Bamuriaha lichú aau</para>
  <para style="q" vid="PRO 2:3">luma lubuidun ichügü lau sun bere.<verse eid="PRO 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 2:4" />Rúguaba bungua lun báluahani,</para>
  <para style="q" vid="PRO 2:4">kamá hamuga báluahaña pülata</para>
  <para style="q" vid="PRO 2:4">o aban lan irisini le aramudaguati.<verse eid="PRO 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 2:5" />Ítara luba basubudiruni lanichigu</para>
  <para style="q" vid="PRO 2:5">lichugún inebesei lun Bungiu;</para>
  <para style="q" vid="PRO 2:5">ítara luba basubudiruni lanichigu</para>
  <para style="q" vid="PRO 2:5">lasubudirúniwa Bungiu!<verse eid="PRO 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 2:6" />Ladüga Bungiu íchugubalin lichú aau,</para>
  <para style="q" vid="PRO 2:6">ani lúmagiñe liabin subudi luma gunfurandaü.<verse eid="PRO 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 2:7" />Íderagua lumutiña ani góunigi laña</para>
  <para style="q" vid="PRO 2:7">ha abagaridubaña lidan úarani</para>
  <para style="q" vid="PRO 2:7">luma lidan arumani le gumuti.<verse eid="PRO 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 2:8" />Góunigi lumutiña ha éibugubaña richaguañu,</para>
  <para style="q" vid="PRO 2:8">areida laña ha gúnfulibaña luma.<verse eid="PRO 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 2:9" />Basubudirubei giñe ísuruni luma irichaü</para>
  <para style="q" vid="PRO 2:9">teni buguyame lun sun katei le buídubei,<verse eid="PRO 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 2:10" />ladüga lachuuduba bau,</para>
  <para style="q" vid="PRO 2:10">ábame giñe bóuchuni libimen lichú aau.<verse eid="PRO 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 2:11" />Lóunigirubadibu lichú bau</para>
  <para style="q" vid="PRO 2:11">luma gunfurandaü le bídanbei súnwandan,<verse eid="PRO 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 2:12" />leweridirubadibu luéi üma wuribati</para>
  <para style="q" vid="PRO 2:12">luma hawéi gürigia salufuritiña,<verse eid="PRO 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 2:13" />gürigia ha ígirubalin üma buiti</para>
  <para style="q" vid="PRO 2:13">lun héibugun lidan émeri búrigati;<verse eid="PRO 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 2:14" />gürigia ha asandirubaña ugundani</para>
  <para style="q" vid="PRO 2:14">lau hadügüni katei le wuribabei,</para>
  <para style="q" vid="PRO 2:14">efeduha haméi luriban hadaagun;<verse eid="PRO 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 2:15" />ha ígira hamaalibei üma le surubei</para>
  <para style="q" vid="PRO 2:15">lun héibugun lidan émeri le segebei.<verse eid="PRO 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 2:16" />Lesefurubadibu lichú aau tuéi würi to gámaritu,</para>
  <para style="q" vid="PRO 2:16">tuéi terencha, to achawahaboun lau burí libimen dimurei;<verse eid="PRO 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 2:17" />to ígirubalin túmari le úmabei tamarieida,</para>
  <para style="q" vid="PRO 2:17">bulieitéi le táfiñurubei ligibugiñe Bungiu.<verse eid="PRO 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 2:18" />Ánhabu ñüdün tuma túbiñoun,</para>
  <para style="q" vid="PRO 2:18">kéigubeirügü bídiña lan lidoun óunweni.<verse eid="PRO 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 2:19" />Ha ebelurutiña tuma túbiñoun, magiribudúnhaña,</para>
  <para style="q" vid="PRO 2:19">magiribudúndigiaaña éibugei lémeri ibagari.<verse eid="PRO 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 2:20" />Béibuga lubeiti luéigiñe üma le buídubei;</para>
  <para style="q" vid="PRO 2:20">falabei hóuserun ha richaguabaña.<verse eid="PRO 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 2:21" />Ladüga ha abagaridubaña lidan ísuruni sunsuinagubei,</para>
  <para style="q" vid="PRO 2:21">habagariduba súnwandan ubouagu;<verse eid="PRO 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 2:22" />ánhaña ha salufuribaña hama ha múaranbaña,</para>
  <para style="q" vid="PRO 2:22">hahulúba, bugawa hagíame ubouagugiñe.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s1">Ligaburi libihíniwa lichú aau</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 3:1" />Niráü, mabulieidabei le narufudahabei bun</para>
  <para style="q" vid="PRO 3:1">haritaguabei nugumadin súnwandan,<verse eid="PRO 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 3:2" />ábame líchugun aban ibagari migifeti</para>
  <para style="q" vid="PRO 3:2">le buin umuti lau ugundani bun.<verse eid="PRO 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 3:3" />Mígirabei ínsiñeni luma inarüni;</para>
  <para style="q" vid="PRO 3:3">barübei búmagua súnwandan kei aban iñari.</para>
  <para style="q" vid="PRO 3:3">Dabei tidoun banigi,<verse eid="PRO 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 3:4" />ábame fuleseihabu lánibu Bungiu,</para>
  <para style="q" vid="PRO 3:4">hínsiñe buguyame houn gürigia.<verse eid="PRO 3:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PRO 3:5" />Afiñebá luagu Bungiu tau sun banigi,</para>
  <para style="q" vid="PRO 3:5">mamalá luagu lualin bichügü.<verse eid="PRO 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 3:6" />Haritaguabá luagu Bungiu lidan sun le badügübei,</para>
  <para style="q" vid="PRO 3:6">ábame lanügünibu luéigiñe üma le surubei.<verse eid="PRO 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 3:7" />Maritaguabá buougua luagu weiri lan lichú bau;</para>
  <para style="q" vid="PRO 3:7">ruba inebesei lun Bungiu direi buguyame luéi wuribani:<verse eid="PRO 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 3:8" />Ligía lubuidun-ágeibei árani</para>
  <para style="q" vid="PRO 3:8">lun líchugun erei lun búgubu!<verse eid="PRO 3:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PRO 3:9" />Ruba inebesei lun Bungiu lau birisin</para>
  <para style="q" vid="PRO 3:9">luma lau furumiñeti balubahan bicharirugugiñe;<verse eid="PRO 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 3:10" />ítara luba tabuinchun lagei balubahan lau ilaü,</para>
  <para style="q" vid="PRO 3:10">ani gíbeboun diwéin buma darime básiñarunu areida.<verse eid="PRO 3:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 3:11" />Niráü, mamaharabá lun leweridihan Bungiu,</para>
  <para style="q" vid="PRO 3:11">magañidun buguyame dan le ladeinhan bun;<verse eid="PRO 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 3:12" />ladüga wéridi lumutiña Bungiu gürigia ha hínsiñebaña lun,</para>
  <para style="q" vid="PRO 3:12">kei ladüga aban úguchili lun liráü le hínsiñetimabei lun.<verse eid="PRO 3:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 3:13" />Fuleseiwatiña gürigia ha adarirubaña lichú aau,</para>
  <para style="q" vid="PRO 3:13">ha ibihubaña lualin ichügü;<verse eid="PRO 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 3:14" />ladüga buítimati sun lira sügǘ lau pülata;</para>
  <para style="q" vid="PRO 3:14">gebegitimati sügǘ lau golu.<verse eid="PRO 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 3:15" />Gebegitimati lichú aau sügǘ lau dübü buíduburiti;</para>
  <para style="q" vid="PRO 3:15">buiti sügǘ lau katei le burí hínsiñegutimabei!<verse eid="PRO 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 3:16" />Ruti lichú aau ibagari migifeti lau lóunwenren,</para>
  <para style="q" vid="PRO 3:16">ru ligía irisini luma inebesei lau lubaünan.<verse eid="PRO 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 3:17" />Buiti lasigirúniwa lugudárigi;</para>
  <para style="q" vid="PRO 3:17">darangilaü líchugubei leibugúniwa lidan lémeri.<verse eid="PRO 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 3:18" />Ibagari lichú aau houn ha gámabalin;</para>
  <para style="q" vid="PRO 3:18">fuleseiwatiña ha árügüdübaña luagu!<verse eid="PRO 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 3:19" />Lau lichú aau ladügei Bungiu ubóu;</para>
  <para style="q" vid="PRO 3:19">lau lisubudin líchigei sielu lidan lubara;<verse eid="PRO 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 3:20" />lau lichú aau ladüga lun lafanreinragun barana</para>
  <para style="q" vid="PRO 3:20">luma lun lábürühan serenu dúerirugugiñe.<verse eid="PRO 3:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 3:21" />Niráü, ragüba luagu lichú aau</para>
  <para style="q" vid="PRO 3:21">luma gunfurandaü súnwandan,</para>
  <para style="q" vid="PRO 3:21">mígirun buguyame lun ladisedun buéi;<verse eid="PRO 3:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 3:22" />ítara luba bun kei lísensen ibagari,</para>
  <para style="q" vid="PRO 3:22">lewendedagüdübadibu kei aban iñari.<verse eid="PRO 3:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 3:23" />Gayaraabei béibugun ǘmada madiheriga,</para>
  <para style="q" vid="PRO 3:23">ani machugeragundügübadibu.<verse eid="PRO 3:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 3:24" />Danme bemeraagun, manufudebadibu,</para>
  <para style="q" vid="PRO 3:24">danme barounrun, barumuguba darangilañu.<verse eid="PRO 3:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 3:25" />Manufudebadibu luéi denchaü le sódiniti,</para>
  <para style="q" vid="PRO 3:25">ni luéi günringuaü le lunbei liabin hawagun ha salufuribaña,<verse eid="PRO 3:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 3:26" />ladüga líchuguba Bungiu manufudei bun,</para>
  <para style="q" vid="PRO 3:26">ani mígirunbei lun bábürühan tidoun ni aban sádara.<verse eid="PRO 3:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PRO 3:27" />Mamaharabá badügün fulesei lun le amuriahati buma</para>
  <para style="q" vid="PRO 3:27">dan le gayara lan badügüni.<verse eid="PRO 3:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 3:28" />Ídehani le gayaraabei bíchuguni uguñe,</para>
  <para style="q" vid="PRO 3:28">mígirabei lubá haruga.<verse eid="PRO 3:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 3:29" />Meledaguabá wuribati habá ha hemenigibaña buagu.<verse eid="PRO 3:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 3:30" />Máluahaba wuribu ni ka uma</para>
  <para style="q" vid="PRO 3:30">anhein ua lubéi ni aban adügüti damichi bun.<verse eid="PRO 3:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 3:31" />Magimugarabaña gürigia ha salufuribaña,</para>
  <para style="q" vid="PRO 3:31">máyeihanbeime luriban housan;<verse eid="PRO 3:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 3:32" />ladüga mínsiñetiña ha wuribabaña igaburi lun Bungiu,</para>
  <para style="q" vid="PRO 3:32">ánheinti hama ha buídubaña, gamadaguati lungua.<verse eid="PRO 3:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 3:33" />Íñaragua lumutu Bungiu haban gürigia ha salufuribaña,</para>
  <para style="q" vid="PRO 3:33">gama lumoun biní lumutu haban ha richaguabaña.<verse eid="PRO 3:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 3:34" />Adaaguati Bungiu bula hau ha gadaaguadibaña bula;</para>
  <para style="q" vid="PRO 3:34">gama lumoun óusera lumutiña ha ǘnabugubaña lau areini.<verse eid="PRO 3:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 3:35" />Inebesei hibihubei ha chúbaña aau;</para>
  <para style="q" vid="PRO 3:35">ánhaña ibidiougua tau,</para>
  <para style="q" vid="PRO 3:35">arufudaguatiña houngua lau minebenwa hamá.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s1">Eweridihani lun lafalarúniwa üma le buídubei</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 4:1" />Nisaanigu, teni humá lun le harufudahabei hagübürigu hun,</para>
  <para style="q" vid="PRO 4:1">ru humá arigei lun, ibiha humaamuga gunfurandaü.<verse eid="PRO 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 4:2" />Buiti sun le narufudahabei hun,</para>
  <para style="q" vid="PRO 4:2">mabulieida huméi lubeiti nilurudun.<verse eid="PRO 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 4:3" />Isaani meha giñe au,</para>
  <para style="q" vid="PRO 4:3">wéiriti meha nínsiñe tun núguchu,<verse eid="PRO 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 4:4" />arufudahati meha núguchi nun, lariñaga nun:</para>
  <para style="q" vid="PRO 4:4">«Haritaguabá luagu le nariñagubei bun súnwandan,</para>
  <para style="q" vid="PRO 4:4">adügabéi le nubeibei bun, ábame babagaridun.<verse eid="PRO 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 4:5" />Ibihabá lichú aau luma lubuidun ichügü,</para>
  <para style="q" vid="PRO 4:5">mabulieidabei le nubeibei bun.<verse eid="PRO 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 4:6" />Hínsiñela lichú aau bun,</para>
  <para style="q" vid="PRO 4:6">mabulieidabei, ábame lóunigirunibu.<verse eid="PRO 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 4:7" />Lubaragiñe furumiñeguarügü katei,</para>
  <para style="q" vid="PRO 4:7">ibihabá lichú aau luma lubuidun ichügü.<verse eid="PRO 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 4:8" />Hínsiñela bun, ábame liñuragunibu;</para>
  <para style="q" vid="PRO 4:8">Hóuburabei, ábame líchugun inebesei bun;<verse eid="PRO 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 4:9" />ábanbei uéndeni lichú aau lun bichügü,</para>
  <para style="q" vid="PRO 4:9">ítara luba kei aban ridi bábulugu!»<verse eid="PRO 4:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 4:10" />Tenibá lun nererun, niráü;</para>
  <para style="q" vid="PRO 4:10">gamabéi, ábame líchugun lanwoun birumudiri.<verse eid="PRO 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 4:11" />Nanügübadibu luéigiñe lémeri lichú aau;</para>
  <para style="q" vid="PRO 4:11">néibugagüdübadibu lidan üma buiti,<verse eid="PRO 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 4:12" />le ñein lubéi úabei lan ni kata lun ladarasarunibu,</para>
  <para style="q" vid="PRO 4:12">le ñein lubéi machugeragunbadibu lan ni ánhabu éibaagua.<verse eid="PRO 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 4:13" />Ragüba luagu arufudahani, mabulieidaguabá luéi;</para>
  <para style="q" vid="PRO 4:13">areidabei, ladüga ligía lan bibagaribei.<verse eid="PRO 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 4:14" />Mafalarabaña ha salufuribaña,</para>
  <para style="q" vid="PRO 4:14">mafalarabéi luriban hóuserun.<verse eid="PRO 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 4:15" />Másügüraba lídangiñe hémeri,</para>
  <para style="q" vid="PRO 4:15">díreiba hawéi ani bubaruaguounbá,<verse eid="PRO 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 4:16" />ladüga hagía, mederaaguagüdüntiña ánhaña madügün wuribani;</para>
  <para style="q" vid="PRO 4:16">marumuguntiña ánhaña mañawarihan lun aban gürigia.<verse eid="PRO 4:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 4:17" />Hóutiña fein lánina wuribani,</para>
  <para style="q" vid="PRO 4:17">gurá hagía diwéin lánina anarimeni!<verse eid="PRO 4:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PRO 4:18" />Ítara liña hémeri ha harumabaña</para>
  <para style="q" vid="PRO 4:18">kei lagumeserun larugadun,</para>
  <para style="q" vid="PRO 4:18">arugoungadeinatima murusun murusun</para>
  <para style="q" vid="PRO 4:18">darí lun larugoungadun sunsuinagubei.<verse eid="PRO 4:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 4:19" />Ánheinti hémeri ha salufuribaña, búrigati;</para>
  <para style="q" vid="PRO 4:19">ibidiñeti houn ni ka lan uagu hachugeragua.<verse eid="PRO 4:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 4:20" />Tenibá lun nererun, niráü,</para>
  <para style="q" vid="PRO 4:20">ruba arigei lun.<verse eid="PRO 4:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 4:21" />Magidarabéi barihin luéi,</para>
  <para style="q" vid="PRO 4:21">bürübei tidan banigi.<verse eid="PRO 4:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 4:22" />Ruti ibagari luma átuadi</para>
  <para style="q" vid="PRO 4:22">houn sun ha adarirubalin.<verse eid="PRO 4:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 4:23" />Lídangiñe sun katei ubouagu,</para>
  <para style="q" vid="PRO 4:23">góunigiboun banigi,</para>
  <para style="q" vid="PRO 4:23">ladüga tídangiñe liabin ibagari.<verse eid="PRO 4:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 4:24" />Mariñagabá le mámagu ligía,</para>
  <para style="q" vid="PRO 4:24">díreiba luéi iyeeni.<verse eid="PRO 4:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 4:25" />Bubaruaguounlá bariha súnwandan</para>
  <para style="q" vid="PRO 4:25">mágurabei barihin múarugun lau busiganu.<verse eid="PRO 4:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 4:26" />Arihabá buidu halía lan bíchigei bugudi,</para>
  <para style="q" vid="PRO 4:26">ítara luba bararamun buidu súnwandan.<verse eid="PRO 4:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 4:27" />Madireirabá luéi bémeri;</para>
  <para style="q" vid="PRO 4:27">méibugaba lidan lagübüri üma.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s1">Eweridihani libügürü agabarahani</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 5:1" />Niráü, tenibá lun lichú nau,</para>
  <para style="q" vid="PRO 5:1">rubei barigei lun lualin nichügü.<verse eid="PRO 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 5:2" />Ítara luba buidu lan bigaburi,</para>
  <para style="q" vid="PRO 5:2">arufudaléime biyanun subudibani ka lan uagu bayanuha.<verse eid="PRO 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 5:3" />Ladüga semeeti tiyanun würi gagabarahatu,</para>
  <para style="q" vid="PRO 5:3">ani fínuti tumalali sügǘ lau garaba,<verse eid="PRO 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 5:4" />gama lumoun lagumuhóun oura, gífiti sügǘ lau asiwaru</para>
  <para style="q" vid="PRO 5:4">hamana ligía sügǘ tau aban eféin to biangua tamana.<verse eid="PRO 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 5:5" />Leibugúniwa tuma,</para>
  <para style="q" vid="PRO 5:5">kéisigubeirügü leibugún lidoun óunweni;</para>
  <para style="q" vid="PRO 5:5">tanügübadibu reiti lidoun umúahaü.<verse eid="PRO 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 5:6" />Meberesentu lau lémeri ibagari,</para>
  <para style="q" vid="PRO 5:6">segeti tǘmate, ani ibidiñeti tun.<verse eid="PRO 5:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 5:7" />Ítara liña lubeiti niráü, aganbabána,</para>
  <para style="q" vid="PRO 5:7">madireirabá luéi narufudahan.<verse eid="PRO 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 5:8" />Disebá tuéi würi gagabarahatu,</para>
  <para style="q" vid="PRO 5:8">mayarafadabá lun tubenari tuban,<verse eid="PRO 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 5:9" />mederegerun báamugei bere houn amu,</para>
  <para style="q" vid="PRO 5:9">ni birumudiri houn gürigia salufuritiña;<verse eid="PRO 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 5:10" />manügün láamugei ni aban terencha birisin</para>
  <para style="q" vid="PRO 5:10">lebegi báfaagun luma buadigimari,<verse eid="PRO 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 5:11" />luéi basakürihan</para>
  <para style="q" vid="PRO 5:11">danme le lagumuchagun búgubu murusun murusun.<verse eid="PRO 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 5:12" />Bariñagame:</para>
  <para style="q" vid="PRO 5:12">«Ka san meha uagu numaganbadinbei?</para>
  <para style="q" vid="PRO 5:12">Kame san namahara lun eweridihani?<verse eid="PRO 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 5:13" />Máhatina meha naganbuniña numaisturungu,</para>
  <para style="q" vid="PRO 5:13">metenitina houn ha meha arufudahabaña nun,<verse eid="PRO 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 5:14" />ítagaraü yebe nadariragun nungua</para>
  <para style="q" vid="PRO 5:14">kei ni kata hagibugiñe sun gürigia!»<verse eid="PRO 5:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 5:15" />Deregüdaguabá tuma búmari,</para>
  <para style="q" vid="PRO 5:15">túnrügüla bíchigei bínsiñehabu.<verse eid="PRO 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 5:16" />Ánhabu garahüñü tau amu würi,</para>
  <para style="q" vid="PRO 5:16">manügünbei lira buiti bun.<verse eid="PRO 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 5:17" />Lunti haweinamudun birahüñü lun híderagunibu,</para>
  <para style="q" vid="PRO 5:17">mama lun híderagun amu.<verse eid="PRO 5:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 5:18" />Gundaabá lubeiti tuma búmari,</para>
  <para style="q" vid="PRO 5:18">gundaabá tuma to úmaboun bamarieida danbei nibureingidibu;<verse eid="PRO 5:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 5:19" />magadiñetu ani wende tugía kei aban usari.</para>
  <para style="q" vid="PRO 5:19">Hóuburatabu lau tínsiñehabu.</para>
  <para style="q" vid="PRO 5:19">Gundaaguagüdatabu lau tuenden.<verse eid="PRO 5:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 5:20" />Ka san uagu bádaragua bungua tumoun</para>
  <para style="q" vid="PRO 5:20">würi gagabarahatu, niráü?</para>
  <para style="q" vid="PRO 5:20">Ka uagu báguragua bungua tarünarugun?<verse eid="PRO 5:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 5:21" />Aríagu liña Bungiu lun hagaburi sun gürigia,</para>
  <para style="q" vid="PRO 5:21">aríagu liña lun sun hagudárigi.<verse eid="PRO 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 5:22" />Ábürühatiña ha salufuribaña lidoun hariban guánarügü;</para>
  <para style="q" vid="PRO 5:22">güragua lumutiña hafigoun guánarügü kamá hamuga aban gúrudu.<verse eid="PRO 5:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 5:23" />Hóunweguba, ladüga márügüdagun hamá houngua,</para>
  <para style="q" vid="PRO 5:23">barǘ lumutiña libidiounigan hau lidoun féridi.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s1">Libügürü adúeihani</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 6:1" />Niráü, ánhabu íchaagua bungua</para>
  <para style="q" vid="PRO 6:1">lun bafayeiruni ladúeihan bumada,</para>
  <para style="q" vid="PRO 6:1">o bíchaagun bungua lun barihin lau aban terencha;<verse eid="PRO 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 6:2" />bagüraguña bungua lau biyuma guánarügü,</para>
  <para style="q" vid="PRO 6:2">badaüraguña bungua lidan bererun guánarügü.<verse eid="PRO 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 6:3" />Niráü, anhein lúhaburuguñadibu lubéi amu,</para>
  <para style="q" vid="PRO 6:3">adügabéi katei le lun besefurun:</para>
  <para style="q" vid="PRO 6:3">Bulieibéi anaaguni unguaü, aguburahabéi bumada.<verse eid="PRO 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 6:4" />Marumugabá,</para>
  <para style="q" vid="PRO 6:4">memeraaguabá ni murusun;<verse eid="PRO 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 6:5" />anurahabá,</para>
  <para style="q" vid="PRO 6:5">kei lanurahan usari luéi éibaahati;</para>
  <para style="q" vid="PRO 6:5">anurahabá, kei tanurahan dunuru tuéi sádara.<verse eid="PRO 6:5" /></para>
  <para style="s1">Eweridihani houn magúalitiña</para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 6:6" />Buguya le magúalibei, arihabá houn haü,</para>
  <para style="q" vid="PRO 6:6">arihabá lun hawadigimari, furendeibá hámagiñe:<verse eid="PRO 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 6:7" />Lau sun ua lan agumadirutiña,</para>
  <para style="q" vid="PRO 6:7">ua ariñaguti houn kaba lan hadüga,<verse eid="PRO 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 6:8" />áluaha hamuti heigin irumurugu,</para>
  <para style="q" vid="PRO 6:8">areidaha haméi lidan lidaani alubahani.<verse eid="PRO 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 6:9" />Hebé berederun arumuga, magúaliti!</para>
  <para style="q" vid="PRO 6:9">Hebé berederun róundügü!<verse eid="PRO 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 6:10" />Sun abunha lan arumuga o abunha lan áriha,</para>
  <para style="q" vid="PRO 6:10">ani cháguabei barüna lun buídutima lan barumugun,<verse eid="PRO 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 6:11" />liábinba gudemei ageindagua buma</para>
  <para style="q" vid="PRO 6:11">kei aban éibugañahadügüti le gárumateti.<verse eid="PRO 6:11" /></para>
  <para style="s1">Hagaburi salufuritiña</para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 6:12" />Gürigia ha salufuribaña,</para>
  <para style="q" vid="PRO 6:12">súnwandan habahüdaguña lan iyeeni;<verse eid="PRO 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 6:13" />ámuruha hamuti hagu,</para>
  <para style="q" vid="PRO 6:13">adaaguatiña seini lau hagudi luma lau hafinga;<verse eid="PRO 6:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 6:14" />wuribati hasaminan,</para>
  <para style="q" vid="PRO 6:14">súnwandan hasaminarun hadügün wuribani,</para>
  <para style="q" vid="PRO 6:14">luma herederun agubuha wuribu.<verse eid="PRO 6:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 6:15" />Ligía sódiniba lubéi liabin günringuaü houn;</para>
  <para style="q" vid="PRO 6:15">kei lámurudun luma ladaarun agu</para>
  <para style="q" vid="PRO 6:15">ítara luba hagünrinchawagun sunsuinagubei.<verse eid="PRO 6:15" /></para>
  <para style="s1">Katei le mínsiñebei lun Bungiu</para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 6:16" />Anihein sedü katei mínsiñeti lun Bungiu:<verse eid="PRO 6:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 6:17" />Agu pántati,</para>
  <para style="q" vid="PRO 6:17">iñeñein yeetu,</para>
  <para style="q" vid="PRO 6:17">úhabu le áfarahati gürigia maduruntiña;<verse eid="PRO 6:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 6:18" />Ichügü le afansehabei wuribani,</para>
  <para style="q" vid="PRO 6:18">ugudi le óufudahabei adüga wuribani,<verse eid="PRO 6:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 6:19" />gefentiña ha yéetiña,</para>
  <para style="q" vid="PRO 6:19">hama ha agubuhabaña wuribu hadan íbirigu.<verse eid="PRO 6:19" /></para>
  <para style="s1">Katei le burí lanügübei agabarahani</para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 6:20" />Niráü, areidabei hagumadin bagübürigu</para>
  <para style="q" vid="PRO 6:20">luma harufudahan lidan bisaminan súnwandan.<verse eid="PRO 6:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 6:21" />Barübei tidan banigi súnwandan,</para>
  <para style="q" vid="PRO 6:21">gürabei luagu bigiina.<verse eid="PRO 6:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 6:22" />Ladundehabadibu lidan buéiyasun,</para>
  <para style="q" vid="PRO 6:22">lóunigirubadibu dan le barumugun,</para>
  <para style="q" vid="PRO 6:22">layanuhaba buma dan le bagagudun.<verse eid="PRO 6:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PRO 6:23" />Lidan inarüni, gumadi luma arufudahani,</para>
  <para style="q" vid="PRO 6:23">ítara liña kei aban igemeri durunguati;</para>
  <para style="q" vid="PRO 6:23">adeinhani luma eweridihani,</para>
  <para style="q" vid="PRO 6:23">ligía lémeribei ibagari.<verse eid="PRO 6:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 6:24" />Lóunigirubadibu tuéi würi salufuritu,</para>
  <para style="q" vid="PRO 6:24">luma luéi libimen tererun würi maríeitu to gagabarahatu.<verse eid="PRO 6:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 6:25" />Mawamadirabéi tumagadiñen tidan banigi,</para>
  <para style="q" vid="PRO 6:25">Mígiraba lun tadiginibu lau ligaburi tarihin!<verse eid="PRO 6:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PRO 6:26" />Würi to horu, téibaahaña teigan fein;</para>
  <para style="q" vid="PRO 6:26">ánhounti to maríeitu to gagabarahatu,</para>
  <para style="q" vid="PRO 6:26">téibaahaña wügüri gebegiti.<verse eid="PRO 6:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PRO 6:27" />Ha íchugutiña watu gemeti haniguagu,</para>
  <para style="q" vid="PRO 6:27">táguduba hadaüragun.<verse eid="PRO 6:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 6:28" />Ha éibugutiña ligibuagu leñegura watu,</para>
  <para style="q" vid="PRO 6:28">lachuraruba hagudi.<verse eid="PRO 6:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 6:29" />Ha arumugutiña tuma würi maríeitu</para>
  <para style="q" vid="PRO 6:29">meredebaña mabeichúnga.<verse eid="PRO 6:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 6:30" />Úatiña iyereehabútiña lun híweruti</para>
  <para style="q" vid="PRO 6:30">le íweruhabei lun lagalumaruni lilama,<verse eid="PRO 6:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 6:31" />lau sun anhein lan árügüdüwa íweruha,</para>
  <para style="q" vid="PRO 6:31">gasu láguyugüdüni líweru sedü wéiyaasu,</para>
  <para style="q" vid="PRO 6:31">íbini lun líchuguni sun le lúmati lun lafayeiruni.<verse eid="PRO 6:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="PRO 6:32" />Ibidiouguati hau gürigia ha ádaragubaña houngua</para>
  <para style="q" vid="PRO 6:32">tumoun würi maríeitu!</para>
  <para style="q" vid="PRO 6:32">Ha adügütiña katei le, hagünrinchaguña houngua!<verse eid="PRO 6:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 6:33" />Háfaguba buleseiti luma anabawaguni,</para>
  <para style="q" vid="PRO 6:33">ani úabei ni kata lun lagidaruni lǘnabun hanügǘn.<verse eid="PRO 6:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 6:34" />Ladüga wügüri emeiditi, ítara liña kei watu gemeti,</para>
  <para style="q" vid="PRO 6:34">úati feruduna lan lidan lidaani láguyugüdün wuribani.<verse eid="PRO 6:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 6:35" />Máhati lun fáyeiti ni ka úmagiñe,</para>
  <para style="q" vid="PRO 6:35">magalumarun ligía ni anhein ichugúa saragu idewesei lun.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="s1">Tisumadin würi to gagabarahatu</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 7:1" />Aganbabéi nererun, niráü,</para>
  <para style="q" vid="PRO 7:1">areidabei nugumadin tidan banigi.<verse eid="PRO 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 7:2" />Aganbabéi nugumadin luma narufudahan;</para>
  <para style="q" vid="PRO 7:2">góunigibei kei lila bagu, ábame gabagari ban.<verse eid="PRO 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 7:3" />Gürabei luagu bifinga,</para>
  <para style="q" vid="PRO 7:3">bürübei tidan banigi.<verse eid="PRO 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 7:4" />Barübei lichú aau kei bíbugaña,</para>
  <para style="q" vid="PRO 7:4">barübei lualin ichügü kei bumada.<verse eid="PRO 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 7:5" />Lesefurubadibu tuéi würi gagabarahatu,</para>
  <para style="q" vid="PRO 7:5">tuéi würi to busenboun tadarihanibu lau burí libimen dimurei.<verse eid="PRO 7:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 7:6" />Luagu aban weyu,</para>
  <para style="q" vid="PRO 7:6">naríaguña luéigiñe funedera núbiñe,<verse eid="PRO 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 7:7" />aba narihin fiu nibureingiña lougua tisubudin,</para>
  <para style="q" vid="PRO 7:7">aba netenirun aríaguei létima ibidiouguabei aau hádangiñe.<verse eid="PRO 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 7:8" />Dan lachülürünbei luagu legeyedun üma,</para>
  <para style="q" vid="PRO 7:8">aba lánhiñuragun túbiñoun würi gagabarahatu tuguya.<verse eid="PRO 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 7:9" />Adarüdeina liña oura ligía,</para>
  <para style="q" vid="PRO 7:9">lagumeseruña aburigada.<verse eid="PRO 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 7:10" />Sódini, aba táfuridun würi tuguya lubaroun</para>
  <para style="q" vid="PRO 7:10">lau sun taranserun luma luriban taritagun keisi aban horu,<verse eid="PRO 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 7:11" />aban würi furesetu, to gademantu,</para>
  <para style="q" vid="PRO 7:11">to siñati terederun túbiñe,<verse eid="PRO 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 7:12" />to éibugañahadügütu ǘmada</para>
  <para style="q" vid="PRO 7:12">áluaha tárügüdüni furumiñeti wügüri ásügürüti.<verse eid="PRO 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 7:13" />Aba tóuburuni würi tuguya nibureingili ligía,</para>
  <para style="q" vid="PRO 7:13">aba tachuuruni liyuma,</para>
  <para style="q" vid="PRO 7:13">aba tariñagun lun, meberesegúnga ni ka au:<verse eid="PRO 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 7:14" />«Füramasetina meha adagaragüdüni le lánina arandaruni,</para>
  <para style="q" vid="PRO 7:14">gúnfulihadina buga lau nani füramasei uguñe.<verse eid="PRO 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 7:15" />Ligía náfuridunbei bubaroun;</para>
  <para style="q" vid="PRO 7:15">wéiriti buga nabusenrun narihinibu,</para>
  <para style="q" vid="PRO 7:15">ani darí náadibu!<verse eid="PRO 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 7:16" />Aranse naaru nigabanan,</para>
  <para style="q" vid="PRO 7:16">tau aban gúlucha Ehiptuna tautu linu,<verse eid="PRO 7:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 7:17" />tugua naaru lau ibiñein,</para>
  <para style="q" vid="PRO 7:17">le lauti mira, áloe luma kanela.<verse eid="PRO 7:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 7:18" />Higabu, keimoun wíchiga ugundani wóuniwagua sun áriebu,</para>
  <para style="q" vid="PRO 7:18">wásügürüba dan buiti wámagua darí larugadun,<verse eid="PRO 7:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 7:19" />ladüga úati númari ya,</para>
  <para style="q" vid="PRO 7:19">aningira luagu aban wéiyaasu lüti;<verse eid="PRO 7:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 7:20" />barüti saragu seinsu,</para>
  <para style="q" vid="PRO 7:20">ani magiribudúnbei darí fulenu hati».<verse eid="PRO 7:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 7:21" />Héretu luagu, aba tabimeduni nibureingili ligía</para>
  <para style="q" vid="PRO 7:21">darí lun tanügüni túmagua.<verse eid="PRO 7:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 7:22" />Aba lidin tárigi furese,</para>
  <para style="q" vid="PRO 7:22">kei aban bulu bágasu le anügǘti lun lafarún,</para>
  <para style="q" vid="PRO 7:22">kei aban usari le ábürühati tidoun sádara,<verse eid="PRO 7:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 7:23" />aba tabouchagunu aban gimara lanigi;</para>
  <para style="q" vid="PRO 7:23">kei aban dunuru le ñǘdünbei lungua tidoun sádara,</para>
  <para style="q" vid="PRO 7:23">ibidiñounga lun luagu lounwe lan.<verse eid="PRO 7:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PRO 7:24" />Ítara liña lubeiti, niráü, aganbabána;</para>
  <para style="q" vid="PRO 7:24">tenibá lun nererun.<verse eid="PRO 7:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 7:25" />Mígiraba lun tínsiñeduba lan aban würi tibe tura bun;</para>
  <para style="q" vid="PRO 7:25">beferidiruba anhoun bafalara,<verse eid="PRO 7:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 7:26" />ladüga gíbeeña táfaragun,</para>
  <para style="q" vid="PRO 7:26">saraguhaña tanügün lidoun óunweni!<verse eid="PRO 7:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 7:27" />Bálugun bafalarunu,</para>
  <para style="q" vid="PRO 7:27">kéigubeirügü bárügüdüni lémeri óunweni.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s1">Lapurichihan lichú aau</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 8:1" />Agúarahati lichú aau here,</para>
  <para style="q" vid="PRO 8:1">aganbagüda lumuti lualin ichügü lumalali.<verse eid="PRO 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 8:2" />Ráramati iñu luagu burí wübü,</para>
  <para style="q" vid="PRO 8:2">ráramaguati luagu burí legeyedun üma;<verse eid="PRO 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 8:3" />aganbaguagüdati lungua</para>
  <para style="q" vid="PRO 8:3">luagu burí lubenari uburugu, lariñaga:<verse eid="PRO 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 8:4" />«Hun huguya gürigia</para>
  <para style="q" vid="PRO 8:4">nariñagei dimurei burí le.<verse eid="PRO 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 8:5" />Irahüñü nibureingiña, lougua tisubudin,</para>
  <para style="q" vid="PRO 8:5">furendei humá lubuidun ichügü, ani chula giñe hau!<verse eid="PRO 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 8:6" />Aganba humá, nariñaga katei súdiniti, le richati.<verse eid="PRO 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 8:7" />Inarüni le lunbei nariñaguni hun;</para>
  <para style="q" vid="PRO 8:7">mínsiñeti nun lun nadimurehan iyeeni.<verse eid="PRO 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 8:8" />Sun nererun, richati;</para>
  <para style="q" vid="PRO 8:8">úati ni murusun iyeeni lidan.<verse eid="PRO 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 8:9" />Houn ha gunfurandabaña, hama ha chúbaña aau,</para>
  <para style="q" vid="PRO 8:9">furanguti sun nererun ani richá ligía.<verse eid="PRO 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 8:10" />Ibiha humá arufudahani luma subudi</para>
  <para style="q" vid="PRO 8:10">lubaragiñe golu luma pülata».<verse eid="PRO 8:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 8:11" />Buítimati lichú aau sügǘ lau dübü buíduburiti;</para>
  <para style="q" vid="PRO 8:11">buiti, sügǘ lau furumiñeguarügü katei le uámaawabei!<verse eid="PRO 8:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PRO 8:12" />«Au, le lichú aau,</para>
  <para style="q" vid="PRO 8:12">lidan aban naganawa luma lualin ichügü,</para>
  <para style="q" vid="PRO 8:12">ani gadariraditina lun lubuidun-agei eweridihani.<verse eid="PRO 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 8:13" />Lichugún inebesei lun Bungiu,</para>
  <para style="q" vid="PRO 8:13">kéisigubeirügü iyereehabúni lun wuribani.</para>
  <para style="q" vid="PRO 8:13">Iyereeguti pantaü luma liñun anaaguni unguaü nun,</para>
  <para style="q" vid="PRO 8:13">luma luriban üma, luma iyeeni.<verse eid="PRO 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 8:14" />Au aransehabei ladügǘn aban katei, au adügei;</para>
  <para style="q" vid="PRO 8:14">au lubuidunbei ichügü luma erei.<verse eid="PRO 8:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 8:15" />Seremei au harúeihanbei urúeigu,</para>
  <para style="q" vid="PRO 8:15">seremei giñe au híchugunbei gumadimatiña lúrudu richati.<verse eid="PRO 8:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 8:16" />Seremei au hagumadihanbei lábutigu fulasu,</para>
  <para style="q" vid="PRO 8:16">aguseragüda hagía lúrudugu.<verse eid="PRO 8:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 8:17" />Ha hínsiñehabubaña nun, hínsiñetiña giñe nun;</para>
  <para style="q" vid="PRO 8:17">darí hamutina ha áluahabalina.<verse eid="PRO 8:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 8:18" />Rútina irisini luma inebesei,</para>
  <para style="q" vid="PRO 8:18">óunwenbu uéiriguni luma awanseruni.<verse eid="PRO 8:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 8:19" />Gebegitimati le níchugubei sügǘ lau golu fínuti;</para>
  <para style="q" vid="PRO 8:19">le níchugubei, buítimati sügǘ lau pülata le fínutimabei.<verse eid="PRO 8:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 8:20" />Lídanñadina üma le surubei,</para>
  <para style="q" vid="PRO 8:20">luéigiñeñadina émeri le richabei.<verse eid="PRO 8:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 8:21" />Ha hínsiñehabubaña nun, ru numuti hafanran houn,</para>
  <para style="q" vid="PRO 8:21">buíngüda numutu haban lau irisini.<verse eid="PRO 8:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PRO 8:22" />«Adüga lumutina Bungiu lidan lagumeseruni luadigimari,</para>
  <para style="q" vid="PRO 8:22">lubaragiñe lagumeserun adügei sun katei.<verse eid="PRO 8:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 8:23" />Adüga lumutina lidan lagumeserun dan,</para>
  <para style="q" vid="PRO 8:23">lubaragiñe ladügüni ubóu.<verse eid="PRO 8:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 8:24" />Anaheinhadina meha lubaragiñe ñein lan barana,</para>
  <para style="q" vid="PRO 8:24">lubaragiñe ñein lan duna éibaaguati luma burí lísensen duna.<verse eid="PRO 8:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 8:25" />Lubaragiñebei lederebugudun wübü,</para>
  <para style="q" vid="PRO 8:25">adüga láadina meha Bungiu;<verse eid="PRO 8:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 8:26" />madügüngubei lágili meha ubóu ni áraabu,</para>
  <para style="q" vid="PRO 8:26">ni múa le aubei ladügei.<verse eid="PRO 8:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 8:27" />Danbei lederebudagüdünbalin sielu,</para>
  <para style="q" vid="PRO 8:27">lóugiñe lidunari óunwenbu barana, ñéinñadina meha.<verse eid="PRO 8:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 8:28" />Ñéinñadina deregüdagu lóubagiñe</para>
  <para style="q" vid="PRO 8:28">dan le líchugunbalin dúeri sielu,</para>
  <para style="q" vid="PRO 8:28">derebugugüdalei lísensen barana,<verse eid="PRO 8:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 8:29" />dan le lariñagunbei lun lidunari barana</para>
  <para style="q" vid="PRO 8:29">lun máfuridun lan lídangiñe leben,</para>
  <para style="q" vid="PRO 8:29">dan le líchugunbalin lebu ubóu.<verse eid="PRO 8:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 8:30" />Au íchugubei ugundani lun sun dan ligía,</para>
  <para style="q" vid="PRO 8:30">sun meha oura nadibirihaña liñuarü;<verse eid="PRO 8:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 8:31" />adibirihatina lidan ubóu le ladügübei,</para>
  <para style="q" vid="PRO 8:31">gúndaatina meha hau sun gürigia!<verse eid="PRO 8:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="PRO 8:32" />«Guentoti, nisaanigu, aganba humana;</para>
  <para style="q" vid="PRO 8:32">falá huméi nani hénpulu, buidu láamuga lidin hun.<verse eid="PRO 8:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 8:33" />Teni humá lun arufudahani,</para>
  <para style="q" vid="PRO 8:33">mamahara humá lun lichú aau.<verse eid="PRO 8:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 8:34" />Fuleseiwatiña ha aganbubalina,</para>
  <para style="q" vid="PRO 8:34">redei hagía óunigira lubadu tubenari nuban sagü weyu.<verse eid="PRO 8:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 8:35" />Ladüga ha adarirutina, darí hamaali ibagari,</para>
  <para style="q" vid="PRO 8:35">gañei haméi lugundan Bungiu;<verse eid="PRO 8:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PRO 8:36" />ánhañati ha adisedutiña nuéi,</para>
  <para style="q" vid="PRO 8:36">híchuguñein habagari lidoun denchaü;</para>
  <para style="q" vid="PRO 8:36">ha iyereehabútiña nun, hínsiñeti óunweni houn!»<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s1">Amu lichú aau, amu libidiounigan aau</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 9:1" />Adüga lumutu lichú aau luban,</para>
  <para style="q" vid="PRO 9:1">aba líchugun sedü tuágaburi;<verse eid="PRO 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 9:2" />áfarati animaalu lun adineruni,</para>
  <para style="q" vid="PRO 9:2">aranse ligía uniñein fínuti,</para>
  <para style="q" vid="PRO 9:2">aba lesetiruni dábula,<verse eid="PRO 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 9:3" />aba lóunahaniña lumusuniña agúaraha</para>
  <para style="q" vid="PRO 9:3">lúmagiñe luéigiñe fulasu le íñutimabei uburugu, hariñaga:<verse eid="PRO 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 9:4" />«Higougu nibureingiña, lougua tisubudin!»</para>
  <para style="q" vid="PRO 9:4">Óunaha ligía ariñaga houn ha lóuguabei gunfuranda hamá:<verse eid="PRO 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 9:5" />«Higougu heiga, gurá huguyame</para>
  <para style="q" vid="PRO 9:5">lidan adineruni le naranserubei.<verse eid="PRO 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 9:6" />Ígira huméi libidiounigan aau, gabagari humaamuga;</para>
  <para style="q" vid="PRO 9:6">habagarida kei gürigia huali tichügü».<verse eid="PRO 9:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 9:7" />Ánhabu erereha houn ibidiougua tau,</para>
  <para style="q" vid="PRO 9:7">o houn lan ha wuribabei igaburi, anabarügü habadibu.<verse eid="PRO 9:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PRO 9:8" />Ánhabu adeinha houn ibidiougua tau, beyereeguduba houn;</para>
  <para style="q" vid="PRO 9:8">ererehabá houn chu tau, ábame bínsiñedun houn.<verse eid="PRO 9:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PRO 9:9" />Ruba houn ha chúbaña aau, ábame lachuuruntima hau;</para>
  <para style="q" vid="PRO 9:9">arufudahabá houn gürigia ha buídubaña,</para>
  <para style="q" vid="PRO 9:9">ábame laganwoundun hasubudin.<verse eid="PRO 9:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 9:10" />Linebenwa Bungiu lagumesehabei lichú aau;</para>
  <para style="q" vid="PRO 9:10">lasubudirúniwa Bungiu, le Sándutimabei,</para>
  <para style="q" vid="PRO 9:10">ligía luálinbei ichügü.<verse eid="PRO 9:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 9:11" />Ladüga lichú bau, babagariduba saragu dan;</para>
  <para style="q" vid="PRO 9:11">ani laganwounduba lirumudiri bibagari.<verse eid="PRO 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 9:12" />Anhein chu lubéi bau, bunba ladüga buiti;</para>
  <para style="q" vid="PRO 9:12">anhein ibidiougua lubéi bau, buguyaba ariha lau.<verse eid="PRO 9:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 9:13" />Ítara liña luriban ichügü</para>
  <para style="q" vid="PRO 9:13">kei aban würi marasualugutu,</para>
  <para style="q" vid="PRO 9:13">dúndutu ani ibidiougua tau.<verse eid="PRO 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 9:14" />Ñurutu luagu aban haláü tubenari tuban,</para>
  <para style="q" vid="PRO 9:14">lidan fulasu le íñutimabei uburugu,<verse eid="PRO 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 9:15" />aba tagúahan houn ha éibugeinatiña</para>
  <para style="q" vid="PRO 9:15">ha áfaagubaña luagu hamarasun:<verse eid="PRO 9:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 9:16" />«Higougu nun, nibureingiña lougua tisubudin!»</para>
  <para style="q" vid="PRO 9:16">Tariñaga houn ha lóuguabei gunfuranda hamá:<verse eid="PRO 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 9:17" />«Bímetimati duna le íweruhouarügüti,</para>
  <para style="q" vid="PRO 9:17">semeetimati éigini le eigiti aramudaguarügü».<verse eid="PRO 9:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 9:18" />Gama lumoun ibidiñeti houn ha ebelurubaña túbiñoun,</para>
  <para style="q" vid="PRO 9:18">luagu ha lan afalarubarun,</para>
  <para style="q" vid="PRO 9:18">añahein lan guentó lidan habara hilaaña.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="ms">III. Lererun Salomón</para>
  <para style="mr">(<ref loc="PRO 10:1-22:16">10.1—22.16</ref>)</para>
  <para style="s1">Lererun burí Salomón</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 10:1" />Isaanigu ha chúbaña aau, gúndaaguagüda hamutiña hagübürigu,</para>
  <para style="q" vid="PRO 10:1">ánhaña ha ibidiouguabaña aau, súfurigüda hamutiña.<verse eid="PRO 10:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PRO 10:2" />Irisini le mabuidunbei libihíniwa, manügünti buiti;</para>
  <para style="q" vid="PRO 10:2">ánheinti arumani, sefu lumuti gürigia luéi óunweni.<verse eid="PRO 10:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PRO 10:3" />Kimulegüda lumutiña Bungiu gürigia ha buídubaña;</para>
  <para style="q" vid="PRO 10:3">ánhaña ha salufuribaña, ígira lumutiña lau halama.<verse eid="PRO 10:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PRO 10:4" />Ánhabu magúali, gudemebadibu;</para>
  <para style="q" vid="PRO 10:4">ánhabu benefa, rísibadibu.<verse eid="PRO 10:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PRO 10:5" />Ha chúbaña aau, alubahabaña irumurugu;</para>
  <para style="q" vid="PRO 10:5">ha mabusigaribaña, arumugubaña lidan lidaani alubahani.<verse eid="PRO 10:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 10:6" />Ábürühati saragu abiniruni hawagun gürigia ha buídubaña;</para>
  <para style="q" vid="PRO 10:6">ánhaña ha salufuribaña, ñaraguagüda lumutiña anarimeni.<verse eid="PRO 10:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 10:7" />Haritawagúati hawagun gürigia buítiña súnwandan lau abiniruni;</para>
  <para style="q" vid="PRO 10:7">ánhañati ha salufuribaña, bulíeiwatiña furese.<verse eid="PRO 10:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PRO 10:8" />Ha chúbaña aau, resibi hamuti gumadi;</para>
  <para style="q" vid="PRO 10:8">ánhaña ha adimurehabaña libidiounigan aau, günrinwaguatiña.<verse eid="PRO 10:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PRO 10:9" />Ha madurunbaña, manufudetiña;</para>
  <para style="q" vid="PRO 10:9">ha wuribabaña éibugun, wuribabei hagumuchun.<verse eid="PRO 10:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 10:10" />Ha ámuruhabalin hagu, barütiña saragu wuribani;</para>
  <para style="q" vid="PRO 10:10">ha adimurehatiña libidiounigan aau,</para>
  <para style="q" vid="PRO 10:10">lidan günringuaü hagumucha.<verse eid="PRO 10:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 10:11" />Lísensen ibagari hererun ha richaguabaña;</para>
  <para style="q" vid="PRO 10:11">ánhañati ha wuribabaña, lañaradaguagüdübaña hagañi.<verse eid="PRO 10:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PRO 10:12" />Agubuhati iyereehabúni wuribu;</para>
  <para style="q" vid="PRO 10:12">ánheinti ínsiñeni, feruduna lumuti sun wuribani.<verse eid="PRO 10:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 10:13" />Anihein lichú aau hayumulugu ha chúbaña aau;</para>
  <para style="q" vid="PRO 10:13">anhein wewe lunti hanagan ha ibidiouguabaña aau.<verse eid="PRO 10:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PRO 10:14" />Areida hamuti chu tau hasubudin;</para>
  <para style="q" vid="PRO 10:14">ánhaña ibidiougua tau dan le hadimurehan, yarafati denchaü.<verse eid="PRO 10:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 10:15" />Harisin rísitiña ágüdahabaliña;</para>
  <para style="q" vid="PRO 10:15">hagudemen gudemetiña agünrinchagubaliña.<verse eid="PRO 10:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PRO 10:16" />Ibagari hafayeiruahabei ha richaguabaña;</para>
  <para style="q" vid="PRO 10:16">ánhañati ha salufuribaña, figóu halubahabei.<verse eid="PRO 10:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PRO 10:17" />Ha ánharutiña lun ererehóuni, luéigiñeñanu lémeri ibagari;</para>
  <para style="q" vid="PRO 10:17">ánhaña ha máhabaña lun, luéigiñeñanu lémeri günringuaü.<verse eid="PRO 10:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PRO 10:18" />Gürigia yéetiña aramudahabalin iyereehabu;</para>
  <para style="q" vid="PRO 10:18">ibidiougua tau adimurehabei marasualugu.<verse eid="PRO 10:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PRO 10:19" />Ha gíbebaña adimurehan, gíbeti habulieidagun;</para>
  <para style="q" vid="PRO 10:19">ha ámanichubaña lidan dan, chuti hau.<verse eid="PRO 10:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 10:20" />Ítara tiña hañeñe ha richaguabaña kei pülata le fínuti;</para>
  <para style="q" vid="PRO 10:20">ánhaña ha salufuribaña, mebegiti hasaminan.<verse eid="PRO 10:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 10:21" />Arufudahatiña ha richaguabaña houn saragu gürigia;</para>
  <para style="q" vid="PRO 10:21">ánhañati ha ibidiouguabaña aau,</para>
  <para style="q" vid="PRO 10:21">hilaguatiña ladüga libidiounigan hau.<verse eid="PRO 10:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PRO 10:22" />Irisini labiniragülebei Bungiu,</para>
  <para style="q" vid="PRO 10:22">ani manügünti igarigu lúmagua.<verse eid="PRO 10:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PRO 10:23" />Gúndaatiña ibidiougua tau dan hadaagun wuribani;</para>
  <para style="q" vid="PRO 10:23">gúndaatiña chu tau lau lichú aau.<verse eid="PRO 10:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PRO 10:24" />Katei létima ueibei hanufudeda gürigia ha salufuribaña,</para>
  <para style="q" vid="PRO 10:24">ligía asuseredubei houn;</para>
  <para style="q" vid="PRO 10:24">ánhañati ha richaguabaña, gúnfuliti le hayumahabei.<verse eid="PRO 10:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PRO 10:25" />Lásügürün herigini, hagumuchagun gürigia ha salufuribaña;</para>
  <para style="q" vid="PRO 10:25">ánhañati ha richaguabaña, rédeitiña lun sun dan.<verse eid="PRO 10:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PRO 10:26" />Ítara haña ha magúalibaña houn ha óunahabaliña,</para>
  <para style="q" vid="PRO 10:26">kei binigá lun ari, kei gumuleli lun agu.<verse eid="PRO 10:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PRO 10:27" />Lichugúniwa inebesei lun Bungiu,</para>
  <para style="q" vid="PRO 10:27">barüti limigifen ibagari;</para>
  <para style="q" vid="PRO 10:27">anhein habagari salufuritiña, dürüwaguati.<verse eid="PRO 10:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PRO 10:28" />Houn ha richaguabaña, buiti le lunbei liabin;</para>
  <para style="q" vid="PRO 10:28">anhein houn ha salufuribaña, wuribati.<verse eid="PRO 10:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="PRO 10:29" />Góunigi lumutiña Bungiu ha adügübaña buiti,</para>
  <para style="q" vid="PRO 10:29">gama lumoun günringua lumutiña ha adügübaña wuribati.<verse eid="PRO 10:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="PRO 10:30" />Ha richaguabaña, súnwandan buídubei lan lidin houn;</para>
  <para style="q" vid="PRO 10:30">ánhañati ha salufuribaña, málübaña ubouagu.<verse eid="PRO 10:30" /></para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" sid="PRO 10:31" />Furiti lichú aau hayumulugugiñe ha chúbaña aau;</para>
  <para style="q" vid="PRO 10:31">ánhañati ha salufuribaña, tibugúba hañeñe.<verse eid="PRO 10:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="PRO 10:32" />Ha richaguabaña, katei buiti hariñagubei;</para>
  <para style="q" vid="PRO 10:32">ánhaña ha salufuribaña, katei wuribati hariñagubei.<verse eid="PRO 10:32" /></para>
  <para style="b" />
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 11:1" />Magundanti Bungiu lau balansu múaragunti;</para>
  <para style="q" vid="PRO 11:1">gama lumoun gúndaati lau le úaraguati.<verse eid="PRO 11:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PRO 11:2" />Barüti anaaguni unguaü busiganu;</para>
  <para style="q" vid="PRO 11:2">hámañein ǘnabugubutiña lichú aau.<verse eid="PRO 11:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PRO 11:3" />Gürigia ha úaraguabaña, adundeha lumutiña húaragun;</para>
  <para style="q" vid="PRO 11:3">ánhaña ha múaragunbaña, günringua lumutiña múaran hamá.<verse eid="PRO 11:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PRO 11:4" />Úabei hu lan irisini lidan luéyuri aguseruni;</para>
  <para style="q" vid="PRO 11:4">ánheinti richaguaü, sefu lumutiña gürigia lídangiñe óunweni.<verse eid="PRO 11:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PRO 11:5" />Surugüda lumuti richaguaü hémeri ha richaguabaña;</para>
  <para style="q" vid="PRO 11:5">ánhañati ha salufuribaña, ábürügüda lumutiña hariban guánarügü.<verse eid="PRO 11:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 11:6" />Sefu lumutiña richaguaü gürigia ha úaraguabaña;</para>
  <para style="q" vid="PRO 11:6">ánheinti uámaahabu, súfurigüda lumutiña ha salufuribaña.<verse eid="PRO 11:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 11:7" />Dan le hounwen gürigia ha salufuribaña,</para>
  <para style="q" vid="PRO 11:7">hilati hemenigin labu hayumahan úara hama.<verse eid="PRO 11:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PRO 11:8" />Sefu lumutiña Bungiu gürigia ha richaguabaña lídangiñe idiheri,</para>
  <para style="q" vid="PRO 11:8">aba líchuguni idiheri ligía houn ha salufuribaña.<verse eid="PRO 11:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PRO 11:9" />Günringua lumutiña hererun gürigia</para>
  <para style="q" vid="PRO 11:9">ha salufuribaña gürigia háledi;</para>
  <para style="q" vid="PRO 11:9">ánheinti lichú hau ha richaguabaña, sefu lumutiña.<verse eid="PRO 11:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 11:10" />Dan le hawanserun ha richaguabaña,</para>
  <para style="q" vid="PRO 11:10">gúndaatiña lílana fulasu;</para>
  <para style="q" vid="PRO 11:10">dan le hounwen salufuritiña,</para>
  <para style="q" vid="PRO 11:10">achubahatiña lílana fulasu lau ugundani.<verse eid="PRO 11:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 11:11" />Bunawaguati aban uburugu lau habinirun richaguatiña;</para>
  <para style="q" vid="PRO 11:11">ánheinti hererun salufuritiña, günringua lumuti.<verse eid="PRO 11:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PRO 11:12" />Ha salufuribaña, wuribati hadimurehan hawagu hamadagu;</para>
  <para style="q" vid="PRO 11:12">gürigia ha buídubaña, manitiña.<verse eid="PRO 11:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 11:13" />Ha marasualugubaña, abahüdagua hamuti sun katei;</para>
  <para style="q" vid="PRO 11:13">ánhañati ha manibaña, mariñaguntiña ni kata.<verse eid="PRO 11:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PRO 11:14" />Anhein ua agumadihani buiti, lagünrinchaguba fulasu;</para>
  <para style="q" vid="PRO 11:14">háhaburuguñein saragu eweridihatiña agañeiruni.<verse eid="PRO 11:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 11:15" />Wuribati líchugun lanügün kárugu</para>
  <para style="q" vid="PRO 11:15">lau ladúeihan terencha;</para>
  <para style="q" vid="PRO 11:15">ha manügüntiña kárugu lau hadúeihan amu,</para>
  <para style="q" vid="PRO 11:15">wínwantiña darangilu.<verse eid="PRO 11:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PRO 11:16" />Würi hanichigutu ibihatu inebesei;</para>
  <para style="q" vid="PRO 11:16">wügüri le benefati, ibihati irisini.<verse eid="PRO 11:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PRO 11:17" />Ha gudemehabubaña, adügatiña buiti hóuniwagua;</para>
  <para style="q" vid="PRO 11:17">ánhañati ha fásibaña, adügatiña wuribati hóuniwagua.<verse eid="PRO 11:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PRO 11:18" />Gürigia ha salufuribaña,</para>
  <para style="q" vid="PRO 11:18">ibihatiña afayeiruahaü le iyeeniti;</para>
  <para style="q" vid="PRO 11:18">ánhaña ha adügübaña katei lau richaguaü,</para>
  <para style="q" vid="PRO 11:18">buiti hafayeiruaha.<verse eid="PRO 11:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PRO 11:19" />Lafalarúniwa richaguaü,</para>
  <para style="q" vid="PRO 11:19">barǘ lumutiña gürigia lidoun ibagari;</para>
  <para style="q" vid="PRO 11:19">ánheinti lafalarúniwa wuribani,</para>
  <para style="q" vid="PRO 11:19">barǘ lumutiña lidoun óunweni.<verse eid="PRO 11:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 11:20" />Iyereegutiña ha wuribabaña isaminan lun Bungiu;</para>
  <para style="q" vid="PRO 11:20">ánhaña ha buídubaña óuserun, hínsiñetiña lun.<verse eid="PRO 11:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 11:21" />Meredebaña gürigia ha salufuribaña mabeichúnga;</para>
  <para style="q" vid="PRO 11:21">ánhaña ha richaguabaña, buídubei lidin houn.<verse eid="PRO 11:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PRO 11:22" />Würi to magadiñetu ani lóuguati tisaminan,</para>
  <para style="q" vid="PRO 11:22">ítara tiña kei bagü lauti golu luagu liyuma buíruhu.<verse eid="PRO 11:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PRO 11:23" />Súnwandan buidu lan lasalirun haritagun ha richaguabaña;</para>
  <para style="q" vid="PRO 11:23">ánheinti haransehan ha salufuribaña, igañi lanügübei.<verse eid="PRO 11:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PRO 11:24" />Añahein gürigia mángitiña,</para>
  <para style="q" vid="PRO 11:24">ibihatiña sügǘ lau le híchugubei;</para>
  <para style="q" vid="PRO 11:24">añahein giñe arügüretiña agumuchutiña lidan gudemei.<verse eid="PRO 11:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PRO 11:25" />Ha gareinibaña, awansetiña;</para>
  <para style="q" vid="PRO 11:25">ha íchugubaña, ibihatiña giñe.<verse eid="PRO 11:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PRO 11:26" />Ha máhabaña halugurun türigu lidan lidaani ilamaü,</para>
  <para style="q" vid="PRO 11:26">íñaragua hamutiña gürigia;</para>
  <para style="q" vid="PRO 11:26">ánhaña ha alugurahabaña biní hamutiña.<verse eid="PRO 11:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PRO 11:27" />Ha ñǘdünbaña lárigi katei le buídubei,</para>
  <para style="q" vid="PRO 11:27">buiti lidin houn;</para>
  <para style="q" vid="PRO 11:27">ha ñǘdünbaña lárigi katei le wuribabei,</para>
  <para style="q" vid="PRO 11:27">wuribabei lidin houn.<verse eid="PRO 11:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PRO 11:28" />Ha emenigidutiña luagu harisin,</para>
  <para style="q" vid="PRO 11:28">hábürühaba kei ubanaü sáühali;</para>
  <para style="q" vid="PRO 11:28">ánhaña ha richaguabaña,</para>
  <para style="q" vid="PRO 11:28">hilumarügübaña kei tilimun wewe.<verse eid="PRO 11:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="PRO 11:29" />Ha móunigirun hamutu haban,</para>
  <para style="q" vid="PRO 11:29">meredeti ni kata houn;</para>
  <para style="q" vid="PRO 11:29">ha ibidiouguabaña aau,</para>
  <para style="q" vid="PRO 11:29">súnwandan hadamunbaña lan ha chúbaña aau.<verse eid="PRO 11:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="PRO 11:30" />Ruti richaguaü ibagari;</para>
  <para style="q" vid="PRO 11:30">anhein anarimeni, gidarügü lumuti.<verse eid="PRO 11:30" /></para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" sid="PRO 11:31" />Resibi hamaali ligía ha richaguabaña hafayeiruaha ya ubouagu,</para>
  <para style="q" vid="PRO 11:31">gúbudigiame ha salufuribaña hama ha gafigounbaña!<verse eid="PRO 11:31" /></para>
  <para style="b" />
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 12:1" />Ha úntiña línsiñeda heresibirun ererehani,</para>
  <para style="q" vid="PRO 12:1">hínsiñeti subudi houn;</para>
  <para style="q" vid="PRO 12:1">ánhaña ha máhatiña lun ererehóuni, ibidiouguati hau.<verse eid="PRO 12:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PRO 12:2" />Gúndaati Bungiu hau gürigia ha buídubaña;</para>
  <para style="q" vid="PRO 12:2">gama lumoun siadi lumutiña ha wuribabaña isaminan.<verse eid="PRO 12:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PRO 12:3" />Mama ebu derebuguti wuribani ni ka un;</para>
  <para style="q" vid="PRO 12:3">ánhaña ha richaguabaña, gálagületiña súnwandan.<verse eid="PRO 12:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PRO 12:4" />Würi to buitu igaburi,</para>
  <para style="q" vid="PRO 12:4">barǘ tumuti túmari kei aban urúei</para>
  <para style="q" vid="PRO 12:4">anhoun to wuribaboun usan,</para>
  <para style="q" vid="PRO 12:4">günringua tumuti sunsuinagubei.<verse eid="PRO 12:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PRO 12:5" />Gürigia ha richaguabaña, luagu richaguaü hasaminara;</para>
  <para style="q" vid="PRO 12:5">ánhaña ha salufuribaña,</para>
  <para style="q" vid="PRO 12:5">luágunrügüñein heyeedagun gürigia hasaminara.<verse eid="PRO 12:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 12:6" />Ítara liña hererun gürigia ha salufuribaña</para>
  <para style="q" vid="PRO 12:6">kei aban sádara to áfarahatu;</para>
  <para style="q" vid="PRO 12:6">anhein hererun ha buídubaña,</para>
  <para style="q" vid="PRO 12:6">ítara liña kei esefuruni.<verse eid="PRO 12:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 12:7" />Ha salufuribaña, ábürühatiña;</para>
  <para style="q" vid="PRO 12:7">aba hagumuchagun hadügawagun;</para>
  <para style="q" vid="PRO 12:7">anhoun haban ha richaguabaña, mábürühantu;</para>
  <para style="q" vid="PRO 12:7">rédeimemetiña hadügawagun.<verse eid="PRO 12:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PRO 12:8" />Adimurehóuati buidu hawagu gürigia según hanichigu;</para>
  <para style="q" vid="PRO 12:8">ánhaña ha ibidiouguabaña aau hanügǘn kei ni kata hadünabei.<verse eid="PRO 12:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PRO 12:9" />Buítimatiña ha anügǘbaña kei ni kata,</para>
  <para style="q" vid="PRO 12:9">gama lumoun añahein eseriwidutiña houn,</para>
  <para style="q" vid="PRO 12:9">sügǘ hau ha wéirigubei hanügǘn,</para>
  <para style="q" vid="PRO 12:9">gama lumoun méigintiña buidu.<verse eid="PRO 12:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 12:10" />Ha richaguabaña,</para>
  <para style="q" vid="PRO 12:10">subudi hamuti hemegeirun habiñanigu;</para>
  <para style="q" vid="PRO 12:10">ánhaña ha salufuribaña,</para>
  <para style="q" vid="PRO 12:10">ibidiñeti ni kata luáguti gudemehabu houn.<verse eid="PRO 12:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 12:11" />Ha nadagimeintiña hachari, géigintiña saragu;</para>
  <para style="q" vid="PRO 12:11">ánhañati ha ibidiouguabaña aau lun katei málati hetenira.<verse eid="PRO 12:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PRO 12:12" />Luriban haritagun ha salufuribaña, ligía hasadaranbei;</para>
  <para style="q" vid="PRO 12:12">anhein hálagüle ha richaguabaña, magumuchaguaditi.<verse eid="PRO 12:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 12:13" />Gürigia ha salufuribaña,</para>
  <para style="q" vid="PRO 12:13">güraguatiña houngua lidan hayeeni guánarügü;</para>
  <para style="q" vid="PRO 12:13">ánhañati ha richaguabaña,</para>
  <para style="q" vid="PRO 12:13">furitiña buidu lídangiñe lénrengunga.<verse eid="PRO 12:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PRO 12:14" />Ibiha lumuti kada aban lebegi le lariñagubei,</para>
  <para style="q" vid="PRO 12:14">ibihaléi lafayeiruaha le ladügübei.<verse eid="PRO 12:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 12:15" />Ha ibidiouguabaña aau,</para>
  <para style="q" vid="PRO 12:15">haritaguatiña luagu buidu lan sun le hadügübei;</para>
  <para style="q" vid="PRO 12:15">ánhaña ha chúbaña aau, ánhatiña lun haganbun eweridiruni.<verse eid="PRO 12:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PRO 12:16" />Ha ibidiouguabaña aau, fureseti harufuduni hagañi;</para>
  <para style="q" vid="PRO 12:16">ánhaña ha buídubaña ichügü, meberesentiña lau hanabawagun.<verse eid="PRO 12:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PRO 12:17" />Gefentiña ha inarünitiña, ariñaga hamuti inarüni;</para>
  <para style="q" vid="PRO 12:17">gefentiña ha yéetiña, iyeeni hachoururubei.<verse eid="PRO 12:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PRO 12:18" />Añahein gürigia, abuleseihatiña láurügü hererun,</para>
  <para style="q" vid="PRO 12:18">gama lumoun ha chúbaña aau, areidaguagüdatiña lau hadimurehan.<verse eid="PRO 12:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PRO 12:19" />Lerederuba inarüni lun sun dan;</para>
  <para style="q" vid="PRO 12:19">anhein iyeeni, murusunrügübei dan ladurarun.<verse eid="PRO 12:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 12:20" />Anihein iyeeni lidan haransehan salufuritiña;</para>
  <para style="q" vid="PRO 12:20">anhein lidan heweridihan gürigia ha ñuruguatiña, anihein ugundani.<verse eid="PRO 12:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 12:21" />Masufurirunbaña gürigia ha richaguabaña wuribani;</para>
  <para style="q" vid="PRO 12:21">ánhaña ha salufuribaña, hasufuriruba sun luwuyeri wuribani.<verse eid="PRO 12:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PRO 12:22" />Iyereegutiña yéetiña lun Bungiu;</para>
  <para style="q" vid="PRO 12:22">gama lumoun gúndaati hau ha ariñagubalin inarüni.<verse eid="PRO 12:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PRO 12:23" />Ha chúbaña aau, aramuda hamuti lichú hau;</para>
  <para style="q" vid="PRO 12:23">ánhaña ha ibidiouguabaña aau,</para>
  <para style="q" vid="PRO 12:23">wagua hamuti libidiounigan hau lun laganbuni sun ubóu.<verse eid="PRO 12:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PRO 12:24" />Ha nadagimeintiña, hagumadihaba;</para>
  <para style="q" vid="PRO 12:24">ha magúalitiña, hagumadirúba.<verse eid="PRO 12:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PRO 12:25" />Hírugüda lumuti idiheri gürigia;</para>
  <para style="q" vid="PRO 12:25">anhein dimurei buiti, gúndaaguagüda lumuti.<verse eid="PRO 12:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PRO 12:26" />Ha richaguabaña, adundehatiña gürigia háledi;</para>
  <para style="q" vid="PRO 12:26">ánhaña ha wuribabaña, lídanñanu üma lun féridi.<verse eid="PRO 12:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PRO 12:27" />Éibaahatiña ha magúalibaña ani márügüdüntiña íliru;</para>
  <para style="q" vid="PRO 12:27">ánhañati ha benefabaña, daritiña óunwenbu irisini.<verse eid="PRO 12:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PRO 12:28" />Barǘ lumutiña lémeri richaguaü gürigia lidoun ibagari;</para>
  <para style="q" vid="PRO 12:28">anhein lémeri luriban ichügü, barüti gürigia lidoun óunweni.<verse eid="PRO 12:28" /></para>
  <para style="b" />
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 13:1" />Isaanigu ha chúbaña aau,</para>
  <para style="q" vid="PRO 13:1">aganba hamuti lererehan háguchi houn;</para>
  <para style="q" vid="PRO 13:1">ánhaña ha ibidiouguabaña aau, meberesentiña lau ebechúni.<verse eid="PRO 13:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PRO 13:2" />Ha buídubaña, ibiha hamuti lubuidun lafayeiha katei le hariñagubei;</para>
  <para style="q" vid="PRO 13:2">ánhaña ha múaranbaña, lamatiña lun anarimeni.<verse eid="PRO 13:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PRO 13:3" />Ha óunigirutiña hererun, góunigiguatiña hóuniwagua;</para>
  <para style="q" vid="PRO 13:3">ha gíbeti hadimurehan, hagünrinchaguba hóuniwagua.<verse eid="PRO 13:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PRO 13:4" />Ha magúalibaña, busentiña saragu katei,</para>
  <para style="q" vid="PRO 13:4">gama lumoun mibihintiña ni kata;</para>
  <para style="q" vid="PRO 13:4">ha nadagimeinbaña, awansetiña lun hibihini sun le habusenrubei.<verse eid="PRO 13:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PRO 13:5" />Gürigia ha richaguabaña, mínsiñeti iyeeni houn;</para>
  <para style="q" vid="PRO 13:5">ánhaña ha salufuribaña, lébuna busiganu luma minebesei hagía.<verse eid="PRO 13:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 13:6" />Ágüdaha lumutiña ísuruni gürigia ha buídubaña;</para>
  <para style="q" vid="PRO 13:6">günringua lumutiña wuribani gürigia gafigountiña.<verse eid="PRO 13:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 13:7" />Añahein gürigia,</para>
  <para style="q" vid="PRO 13:7">úati ni kata hama ani afamuratiña kei rísitiña;</para>
  <para style="q" vid="PRO 13:7">añahein gámatiña afamura kamá gudemetiña.<verse eid="PRO 13:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PRO 13:8" />Sefu lumuti harisin rísitiña habagari;</para>
  <para style="q" vid="PRO 13:8">ánhañati ha gudemebaña, úatiña álugutiña háfaruniña.<verse eid="PRO 13:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PRO 13:9" />Ítara haña ha richaguabaña, kei aban igemeri le elelehati;</para>
  <para style="q" vid="PRO 13:9">ánhaña salufuritiña, ítara haña kei igemeri le éñeguchuti.<verse eid="PRO 13:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 13:10" />Wuriburügüñein lanüga anaaguni unguaü;</para>
  <para style="q" vid="PRO 13:10">hámañein ha ǘnabugububaña lichú aau.<verse eid="PRO 13:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 13:11" />Ha ibihubaña irisini furese, lau eyeedúni,</para>
  <para style="q" vid="PRO 13:11">murusun murusun lidin hawéi;</para>
  <para style="q" vid="PRO 13:11">ha óundaragutiña irisini murusun murusun, lau arumani,</para>
  <para style="q" vid="PRO 13:11">gánwoungüda hamuti.<verse eid="PRO 13:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PRO 13:12" />Emenigini masaliti, anigi nidiheritu;</para>
  <para style="q" vid="PRO 13:12">ánheinti ayumahani gúnfuliwati,</para>
  <para style="q" vid="PRO 13:12">ítara liña kei tídibu wewe lánina ibagari.<verse eid="PRO 13:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 13:13" />Ha íchugutiña mebereseni luagu aban gumadi hasakürihaba;</para>
  <para style="q" vid="PRO 13:13">Ha inebeti gumadi houn, gafayeiruahabaña.<verse eid="PRO 13:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PRO 13:14" />Lísensen ibagari larufudahan le chubei aau,</para>
  <para style="q" vid="PRO 13:14">ani sefu lumutiña gürigia lídangiñe óunweni.<verse eid="PRO 13:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 13:15" />Lubuidun ichügü, gúndaawati lau;</para>
  <para style="q" vid="PRO 13:15">ánhaña ha múaranbaña, lídanñanu lémeri günringuaü.<verse eid="PRO 13:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PRO 13:16" />Gürigia ha buídubaña ichügü,</para>
  <para style="q" vid="PRO 13:16">lau lualin ichügü hadügei sun katei;</para>
  <para style="q" vid="PRO 13:16">ánhañati ha ibidiouguabaña aau,</para>
  <para style="q" vid="PRO 13:16">arufuda hamuti libidiounigan hau houn súngubei.<verse eid="PRO 13:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PRO 13:17" />Óunagüleigu ha wuribabaña, barütiña lénrengunga;</para>
  <para style="q" vid="PRO 13:17">ánhañati óunagüleigu ha úaraguabaña, huáliguagüda hamuti.<verse eid="PRO 13:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PRO 13:18" />Gudemei luma minebeni,</para>
  <para style="q" vid="PRO 13:18">ligíaba habiha ha meberesenbaña lau eweridihani;</para>
  <para style="q" vid="PRO 13:18">ánhaña ha aganbubaña ererehani,</para>
  <para style="q" vid="PRO 13:18">hibihuba óunwenbu inebesei.<verse eid="PRO 13:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PRO 13:19" />Libihín le busenwabei, barüti ugundani;</para>
  <para style="q" vid="PRO 13:19">ha ibidiouguabaña aau, mínsiñeti houn lun hadisedun luéi wuribani.<verse eid="PRO 13:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 13:20" />Ha óundaragutiña hama chu tau, lachuuduba hau,</para>
  <para style="q" vid="PRO 13:20">ánhaña ha óundaragubaña hama ibidiougua tau, heferidiruba.<verse eid="PRO 13:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 13:21" />Éibaaha lumutiña wuribani gafigountiña;</para>
  <para style="q" vid="PRO 13:21">ánhaña richaguatiña, fáyeiwatiña lau buiti.<verse eid="PRO 13:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PRO 13:22" />Gürigia ha buídubaña, ígiratiña alagan houn habañan,</para>
  <para style="q" vid="PRO 13:22">ánhaña ha gafigounbaña, óundaraguatiña irisini habá ha richaguabaña.<verse eid="PRO 13:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PRO 13:23" />Anihein saragu éigini hacharirugu gudemetiña,</para>
  <para style="q" vid="PRO 13:23">gama lumoun gíbeti féridi ñein lumuti ua lan richaguaü.<verse eid="PRO 13:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PRO 13:24" />Ha mererehantiña houn harahüñü, mínsiñetiña houn;</para>
  <para style="q" vid="PRO 13:24">ha hínsiñehabubaña houn, ererehatiña houn.<verse eid="PRO 13:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PRO 13:25" />Gürigia ha richaguabaña, hóutiña darí hakimuledun;</para>
  <para style="q" vid="PRO 13:25">ánhaña ha salufuribaña, rédeitiña lau ilamaü.<verse eid="PRO 13:25" /></para>
  <para style="b" />
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 14:1" />Würi to chuboun aau, aranseha tumuti sun le mégeibei múnada</para>
  <para style="q" vid="PRO 14:1">anhoun to ibidiouguaboun aau, günringua tumutu lau túhabu guánarügü.<verse eid="PRO 14:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PRO 14:2" />Ha surubaña óuserun, rútiña inebesei lun Bungiu;</para>
  <para style="q" vid="PRO 14:2">ánhaña ha segebaña óuserun, meberesentiña lau.<verse eid="PRO 14:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PRO 14:3" />Íñuguti hererun ibidiougua tau;</para>
  <para style="q" vid="PRO 14:3">anhein hererun ha chúbaña aau, ídehati.<verse eid="PRO 14:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PRO 14:4" />Dan le ua hamá bulu bágasu, mégeiti türigu;</para>
  <para style="q" vid="PRO 14:4">gánwounti alubahani lau lere bulu bágasu.<verse eid="PRO 14:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PRO 14:5" />Meyeehantiña gefentiña ha inarünitiña;</para>
  <para style="q" vid="PRO 14:5">ánhañati gefentiña ha yéetiña, iyeeni hariñagubei.<verse eid="PRO 14:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 14:6" />Áluahatiña ibidiougua tau lichú aau ani madari hamuti;</para>
  <para style="q" vid="PRO 14:6">ánhañati ha huálibaña ichügü, ménrengunti subudi houn.<verse eid="PRO 14:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 14:7" />Disebá hawéi ibidiougua tau,</para>
  <para style="q" vid="PRO 14:7">ladüga meresibirunbadibu subudi hámagiñe.<verse eid="PRO 14:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PRO 14:8" />Ha chúbaña aau, gunfuranda hamuti hóuserun lau lichú aau;</para>
  <para style="q" vid="PRO 14:8">ánhañati ha ibidiouguabaña aau</para>
  <para style="q" vid="PRO 14:8">eyeedagua lumutiña libidiounigan hau.<verse eid="PRO 14:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PRO 14:9" />Éherahatiña ibidiougua tau lau hadurun;</para>
  <para style="q" vid="PRO 14:9">anhein hadan gürigia harumatiña,</para>
  <para style="q" vid="PRO 14:9">anihein aritaguni buiti lidan aban lubá le aban.<verse eid="PRO 14:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 14:10" />Subudi tumuti anigi sun tigarigu,</para>
  <para style="q" vid="PRO 14:10">ani siñati tafanreinhani tugundan hama terencha.<verse eid="PRO 14:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 14:11" />Tagünrinchaguba haban gürigia salufuritiña;</para>
  <para style="q" vid="PRO 14:11">anhoun haban ha buídubaña, tawanseruba.<verse eid="PRO 14:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PRO 14:12" />Anihein burí üma suruti larihíniwa,</para>
  <para style="q" vid="PRO 14:12">gama lumoun óunweni lébehabei.<verse eid="PRO 14:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 14:13" />Gáritu anigi íbini lárigi éherahani,</para>
  <para style="q" vid="PRO 14:13">lárigiñe aba liabin ugundani lun ayahunibéi lan.<verse eid="PRO 14:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PRO 14:14" />Heresibirubei ha salufuribaña le hadünabei;</para>
  <para style="q" vid="PRO 14:14">ánhañati ha buídubaña hafayeirúaba luagu le hadügübei.<verse eid="PRO 14:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 14:15" />Afiñetiña ha mabuidunbaña ichügü</para>
  <para style="q" vid="PRO 14:15">luagu sun le ariñawagúbei houn;</para>
  <para style="q" vid="PRO 14:15">ánhaña ha buídubaña ichügü,</para>
  <para style="q" vid="PRO 14:15">ariha hamuti buidu halía lan héibuga.<verse eid="PRO 14:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PRO 14:16" />Hanufudetiña ha chúbaña aau luéi wuribani ani aba hadisedun luéi;</para>
  <para style="q" vid="PRO 14:16">ánhañati ibidiougua tau, kamá meberesentiña lau ni kata.<verse eid="PRO 14:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PRO 14:17" />Ha furesebaña lun hagañidun, adügatiña libidiounigan aau;</para>
  <para style="q" vid="PRO 14:17">ánhañati ha saminabaña, diliñu haña súnwandan.<verse eid="PRO 14:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PRO 14:18" />Libidiounigan aau halagantebei ha ibidiouguabaña aau,</para>
  <para style="q" vid="PRO 14:18">ánhaña ha saminabaña, geyeguhaña lau subudi.<verse eid="PRO 14:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PRO 14:19" />Habuluchaguba ha salufuribaña hagibugiñe ha buídubaña;</para>
  <para style="q" vid="PRO 14:19">hayumuraguba habenari ha richaguabaña.<verse eid="PRO 14:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 14:20" />Iyereegutiña ha gudemebaña íbini houn hamadagu guánarügü;</para>
  <para style="q" vid="PRO 14:20">ánhaña ha rísibaña, ígiraguatiña umadagu houn.<verse eid="PRO 14:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 14:21" />Ha íchugutiña mebereseni hau hamadagu, hadügüña figóu;</para>
  <para style="q" vid="PRO 14:21">gama lumoun fuleseiwatiña ha gudemehabubaña houn gudemetiña!<verse eid="PRO 14:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PRO 14:22" />Ha áluahabaña hadügün wuribani, féridi hamuti üma;</para>
  <para style="q" vid="PRO 14:22">ha áluahabaña hadügün buiti, hínsiñegutiña,</para>
  <para style="q" vid="PRO 14:22">úaragua hagía gürigia hama.<verse eid="PRO 14:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PRO 14:23" />Sagawati katei buiti lídangiñe sun áfaaguni;</para>
  <para style="q" vid="PRO 14:23">anhein lídangiñe saragu adimurehani, gudemei asagarúbei.<verse eid="PRO 14:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PRO 14:24" />Lichú hau ha chúbaña aau haridinbei;</para>
  <para style="q" vid="PRO 14:24">anhein haridin ibidiougua tau, libidiounigan aau.<verse eid="PRO 14:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PRO 14:25" />Sefu hamuti gefentiña ha inarünitiña habagari amu;</para>
  <para style="q" vid="PRO 14:25">ánhañati gefentiña ha yéetiña, lébuna óunweni hagía.<verse eid="PRO 14:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PRO 14:26" />Ha íchugubaña inebesei lun Bungiu,</para>
  <para style="q" vid="PRO 14:26">ibihatiña aban emenigini buiti,</para>
  <para style="q" vid="PRO 14:26">ani habihuba hasaanigu achoururuni.<verse eid="PRO 14:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PRO 14:27" />Linebenwa Bungiu, lísensenbei ibagari,</para>
  <para style="q" vid="PRO 14:27">le esefurubei gürigia lídangiñe óunweni.<verse eid="PRO 14:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PRO 14:28" />Luéirigun urúei lun larúeihaba lan hawagu saragu;</para>
  <para style="q" vid="PRO 14:28">anhein lun larúeihan hawagu bianraü, günringuaü lun.<verse eid="PRO 14:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="PRO 14:29" />Arufuda lumuti gaguraasuni lichú aau;</para>
  <para style="q" vid="PRO 14:29">anhein maguraasuni, arufudati óunwenbu libidiounigan aau.<verse eid="PRO 14:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="PRO 14:30" />Ichügü darangilati ibagaribei lun úgubu;</para>
  <para style="q" vid="PRO 14:30">ánheinti gimugaü, ágürüha lumuti íbini abun.<verse eid="PRO 14:30" /></para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" sid="PRO 14:31" />Ha adügütiña wuribani houn gudemetiña,</para>
  <para style="q" vid="PRO 14:31">hanabaguñein Habungiute;</para>
  <para style="q" vid="PRO 14:31">ánhaña ha gudemehabubaña houn gudemetiña,</para>
  <para style="q" vid="PRO 14:31">rútiña inebesei lun Habungiute.<verse eid="PRO 14:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="PRO 14:32" />Ha salufuribaña, günringua lumutiña hariban guánarügü;</para>
  <para style="q" vid="PRO 14:32">gürigia ha harumabaña, góunigi lumutiña haruman guánarügü.<verse eid="PRO 14:32" /></para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" sid="PRO 14:33" />Lidan ichügü le saminati buidu laganawa lichú aau;</para>
  <para style="q" vid="PRO 14:33">ánheinti hadan ibidiougua tau, ibidiñewati.<verse eid="PRO 14:33" /></para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" sid="PRO 14:34" />Richaguaü, ligía lapantaagülebei aban fulasu;</para>
  <para style="q" vid="PRO 14:34">anhein figóu, ligía lubusigaridünabei.<verse eid="PRO 14:34" /></para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" sid="PRO 14:35" />Eseriwidutiña ha buídubaña,</para>
  <para style="q" vid="PRO 14:35">gañei hamuti lufulesein urúei;</para>
  <para style="q" vid="PRO 14:35">anhein ha móunibaña, gañei hamuti ligañi.<verse eid="PRO 14:35" /></para>
  <para style="b" />
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 15:1" />Óunabagülei le buiti, gáluma lumuti igañi;</para>
  <para style="q" vid="PRO 15:1">anhein óunabagülei le hanarimeti, iñuraguatimarügü lumuti.<verse eid="PRO 15:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PRO 15:2" />Furiti lichú aau hayumulugugiñe ha chúbaña aau;</para>
  <para style="q" vid="PRO 15:2">anhein hayumulugugiñe ibidiougua tau,</para>
  <para style="q" vid="PRO 15:2">libidiounigan aau áfuridubei.<verse eid="PRO 15:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PRO 15:3" />Anihein Bungiu lidan sun fulasu;</para>
  <para style="q" vid="PRO 15:3">aríagu liña houn sun gürigia, buítiña hama wuribatiña.<verse eid="PRO 15:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PRO 15:4" />Ítara liña dimurei hínsiñehabuti,</para>
  <para style="q" vid="PRO 15:4">kei aban tídibu wewe to lánina ibagari;</para>
  <para style="q" vid="PRO 15:4">anhein dimurei burí wuribati, adügati damichi lun sífiri.<verse eid="PRO 15:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PRO 15:5" />Ha ibidiouguabaña aau, meberesentiña lau lererehan háguchi;</para>
  <para style="q" vid="PRO 15:5">ánhaña ha atenirutiña lun lererehan háguchi,</para>
  <para style="q" vid="PRO 15:5">arufuda hamuti lualin hachügü.<verse eid="PRO 15:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 15:6" />Anihein saragu katei buiti hábiñe gürigia ha buídubaña;</para>
  <para style="q" vid="PRO 15:6">ánhaña ha salufuribaña, úati hu lan le hagañeirubei houn.<verse eid="PRO 15:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 15:7" />Ha chúbaña aau, arufudahatiña lichú aau;</para>
  <para style="q" vid="PRO 15:7">ánhaña ha ibidiouguabaña aau, libidiounigan aau harufudahabei.<verse eid="PRO 15:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PRO 15:8" />Iyereeguti hadewese salufuritiña lun Bungiu,</para>
  <para style="q" vid="PRO 15:8">ánheinti hafurieidun ha richaguabaña,</para>
  <para style="q" vid="PRO 15:8">resibi lumuti lau ugundani.<verse eid="PRO 15:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PRO 15:9" />Iyereeguti hóuserun ha salufuribaña lun Bungiu;</para>
  <para style="q" vid="PRO 15:9">gama lumoun hínsiñetiña ha abagaridubaña ibagari suruti lun.<verse eid="PRO 15:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 15:10" />Ha ígiruti üma le buídubei, hérebei habeichún;</para>
  <para style="q" vid="PRO 15:10">ha iyereehabútiña lun ererehóuni, hóunweguba.<verse eid="PRO 15:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 15:11" />Anhein anihein lubéi óunweni luma umúahaü lábugiñe larihin Bungiu,</para>
  <para style="q" vid="PRO 15:11">gúbutimame hasaminan gürigia!<verse eid="PRO 15:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PRO 15:12" />Ha ibidiouguabaña aau,</para>
  <para style="q" vid="PRO 15:12">mínsiñetiña ha ererehabaña houn houn;</para>
  <para style="q" vid="PRO 15:12">máluahan lumutiña giñe ha chúbaña aau lun hádanbei lan.<verse eid="PRO 15:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 15:13" />Dan le gunda tan lanigi gürigia gúndaati ligibu,</para>
  <para style="q" vid="PRO 15:13">dan le sandi tan lanigi, híruti ligibu.<verse eid="PRO 15:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PRO 15:14" />Ha huálibaña ichügü, áluahatiña subudi;</para>
  <para style="q" vid="PRO 15:14">ánhaña ha ibidiouguabaña aau, libidiounigan aau háluahabei.<verse eid="PRO 15:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 15:15" />Gürigia ha nidiheribaña, sun weyu houn wuribati;</para>
  <para style="q" vid="PRO 15:15">ánhaña ha gúndaabaña, sun weyu houn kei fedu le súnwandanti.<verse eid="PRO 15:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PRO 15:16" />Buítimati gudeme lan gürigia</para>
  <para style="q" vid="PRO 15:16">ani ruti inebesei lun Bungiu,</para>
  <para style="q" vid="PRO 15:16">sügǘ lau risi lan ani nidiheriti libagari.<verse eid="PRO 15:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PRO 15:17" />Buítimati lun teigin fagudiya lau ínsiñehabuni,</para>
  <para style="q" vid="PRO 15:17">sügǘ lau leigín wiñaadu lau iyereehabúni.<verse eid="PRO 15:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PRO 15:18" />Gürigia ha gañi gáñibaña agubuhatiña wuribu;</para>
  <para style="q" vid="PRO 15:18">ánhaña ha gaguraasunbaña, darangilagüda hamuti wuribu.<verse eid="PRO 15:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PRO 15:19" />Buin liña üma lau hiiyu houn ha magúalibaña,</para>
  <para style="q" vid="PRO 15:19">anhein houn gürigia ha surubaña, buiti üma.<verse eid="PRO 15:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 15:20" />Isaanigu ha chúbaña aau, gúndaaguagüda hamutiña hagübürigu;</para>
  <para style="q" vid="PRO 15:20">ánhaña ha ibidiouguabaña aau, meberesentiña hau.<verse eid="PRO 15:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 15:21" />Ha wuribabaña isaminan,</para>
  <para style="q" vid="PRO 15:21">hínsiñeguatiña houngua lidan libidiounigan aau;</para>
  <para style="q" vid="PRO 15:21">ánhaña ha gachügübaña, suruti hémeri.<verse eid="PRO 15:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PRO 15:22" />Dan le ua lan álügüdahani,</para>
  <para style="q" vid="PRO 15:22">wuribati aransehani;</para>
  <para style="q" vid="PRO 15:22">según hibe eweridihatiña labuidura aransehani.<verse eid="PRO 15:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PRO 15:23" />Ma lubuidun dan le ladarirúniwa óunabagülei le richabei;</para>
  <para style="q" vid="PRO 15:23">dan létima liabin lidan dan!<verse eid="PRO 15:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PRO 15:24" />Iñun lárügüda üma lidoun ibagari,</para>
  <para style="q" vid="PRO 15:24">ani sefu lumutiña ha chúbaña aau luéi houdin lidoun umúahaü.<verse eid="PRO 15:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PRO 15:25" />Günringua lumutu Bungiu haban ha barüguabaña houngua;</para>
  <para style="q" vid="PRO 15:25">gama lumoun areida lumutu haban würiña ha hilaguaaña hámari.<verse eid="PRO 15:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PRO 15:26" />Magundanti Bungiu lau aransehani wuribati;</para>
  <para style="q" vid="PRO 15:26">gama lumoun gúndaati lau dimurei le buídubei.<verse eid="PRO 15:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PRO 15:27" />Ha áfaagubaña habihin irisini lau mabuiduni,</para>
  <para style="q" vid="PRO 15:27">günringua hamutiña haduheñu;</para>
  <para style="q" vid="PRO 15:27">anhein ha máhabaña lun mabuiduni, habagariduba.<verse eid="PRO 15:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PRO 15:28" />Gürigia ha richaguabaña, samina hamuti kaba lan hóunaba;</para>
  <para style="q" vid="PRO 15:28">ánhaña ha wuribabaña, wuribani hachüühabei hayumulugugiñe.<verse eid="PRO 15:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="PRO 15:29" />Díreiti Wabureme Bungiu hawéi ha wuribabaña,</para>
  <para style="q" vid="PRO 15:29">gama lumoun aganba lumuti hafurieidun ha richaguabaña.<verse eid="PRO 15:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="PRO 15:30" />Gúndaaguagüda lumutu áhayachuni lanigi gürigia;</para>
  <para style="q" vid="PRO 15:30">ruti uganu buiti iseri erei.<verse eid="PRO 15:30" /></para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" sid="PRO 15:31" />Ha adügütiña gasu lau ererehani le íchugubei ibagari,</para>
  <para style="q" vid="PRO 15:31">gabarabei hadan ha chúbaña aau.<verse eid="PRO 15:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="PRO 15:32" />Ha máhabaña lun ererehóuni, mínsiñeguatiña houngua;</para>
  <para style="q" vid="PRO 15:32">ha adügütiña gasu lau ererehóuni, ibihatiña gunfurandaü.<verse eid="PRO 15:32" /></para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" sid="PRO 15:33" />Arufudahati lichugún inebesei lun Bungiu,</para>
  <para style="q" vid="PRO 15:33">lichú aau houn gürigia;</para>
  <para style="q" vid="PRO 15:33">lun heresibirun gürigia inebesei,</para>
  <para style="q" vid="PRO 15:33">gasu ǘnabugu lan hanaagun houngua furumiñe.<verse eid="PRO 15:33" /></para>
  <para style="b" />
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 16:1" />Gürigia aransehabaña,</para>
  <para style="q" vid="PRO 16:1">gama lumoun lúmañein Bungiu lagumuhóun dimurei.<verse eid="PRO 16:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PRO 16:2" />Buiti sun le hadügübei gürigia lidan haritagun,</para>
  <para style="q" vid="PRO 16:2">gama lumoun Bungiu aguseragüdübalin saminaü.<verse eid="PRO 16:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PRO 16:3" />Rubei sun le badügübei lúhaburugun Bungiu,</para>
  <para style="q" vid="PRO 16:3">ábame lóunwenbudun le baransehabei.<verse eid="PRO 16:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PRO 16:4" />Adüga laali Bungiu sun katei lau aban saminaü:</para>
  <para style="q" vid="PRO 16:4">Íbini gürigia ha salufuribaña lubá luéyuri abeichúni.<verse eid="PRO 16:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PRO 16:5" />Magundanti Bungiu hau gürigia pántatiña,</para>
  <para style="q" vid="PRO 16:5">madisebei habihini habeichúniwa.<verse eid="PRO 16:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 16:6" />Lau ínsiñehabuni luma inarüni ferudunawa lan figóu,</para>
  <para style="q" vid="PRO 16:6">lau líchugun gürigia inebesei lun Bungiu ladiseda luéi wuribani.<verse eid="PRO 16:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 16:7" />Dan le hínsiñe lan lóuserun aban gürigia lun Bungiu,</para>
  <para style="q" vid="PRO 16:7">íbini láganiñu gürigia ligía arandaragüda lumutiña Bungiu luma.<verse eid="PRO 16:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PRO 16:8" />Buítimati murusun le agañeirúbei lau arumani</para>
  <para style="q" vid="PRO 16:8">sügǘ lau saragu le agañeirúbei lau marichaü.<verse eid="PRO 16:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PRO 16:9" />Gürigia lúnbaña haransehan,</para>
  <para style="q" vid="PRO 16:9">Bungiu lun ladundehani héibugun.<verse eid="PRO 16:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 16:10" />Adimurehati urúei luéigiñe lóubadina Bungiu;</para>
  <para style="q" vid="PRO 16:10">ani aguseragüdaali lau úarani.<verse eid="PRO 16:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 16:11" />Balansu luma amisuraagülei,</para>
  <para style="q" vid="PRO 16:11">ábürühati labun laguseragüdün Bungiu;</para>
  <para style="q" vid="PRO 16:11">ligía adügübalin sun balansu.<verse eid="PRO 16:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PRO 16:12" />Mabuidunti hadaagun urúeigu wuribani,</para>
  <para style="q" vid="PRO 16:12">ladüga luagu hala lederebuguda irichaü.<verse eid="PRO 16:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 16:13" />Hínsiñetiña ha adimurehabaña lau arumani</para>
  <para style="q" vid="PRO 16:13">luma inarüni houn urúeigu,</para>
  <para style="q" vid="PRO 16:13">ariha hamaña lau ugundani.<verse eid="PRO 16:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PRO 16:14" />Lóunagüle óunweni ligañi urúei,</para>
  <para style="q" vid="PRO 16:14">ani chuti hau ha óuchubaña hagalumaruni.<verse eid="PRO 16:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 16:15" />Füramasei lánina ibagari, lugundan urúei,</para>
  <para style="q" vid="PRO 16:15">ani ítara liña lareini kei lesetirun huya.<verse eid="PRO 16:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PRO 16:16" />Buítimati libihín lichú aau sügǘ lau golu;</para>
  <para style="q" vid="PRO 16:16">buítimati gunfurandaü sügǘ lau pülata.<verse eid="PRO 16:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PRO 16:17" />Díreitiña gürigia richaguatiña luéi wuribani.</para>
  <para style="q" vid="PRO 16:17">Ha óunigirutiña hóuserun hóunigiraguña houngua.<verse eid="PRO 16:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PRO 16:18" />Lárigi pantaü liabin günringuaü;</para>
  <para style="q" vid="PRO 16:18">lárigi anaaguni unguaü liabin ábürühani.<verse eid="PRO 16:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PRO 16:19" />Buítimati banaagun bungua ǘnabugu hama gudemetiña</para>
  <para style="q" vid="PRO 16:19">sügǘ lau gafanran ban lidan harisin ha pántabaña.<verse eid="PRO 16:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 16:20" />Ha alidihatiña buidu, buiti lidin houn;</para>
  <para style="q" vid="PRO 16:20">fuleseiwatiña ha hemenigibaña luagu Bungiu!<verse eid="PRO 16:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 16:21" />Ha asaminarubaña lau lichú aau barüwatiña kei chútiña aau;</para>
  <para style="q" vid="PRO 16:21">afiñeragüdatimati dimurei buiti.<verse eid="PRO 16:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PRO 16:22" />Lubuidun ichügü kéisigubeirügü lísensen ibagari;</para>
  <para style="q" vid="PRO 16:22">libidiounigan giñe aau, larufudahóun houn ibidiougua tau.<verse eid="PRO 16:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PRO 16:23" />Ha asaminarutiña lau lichú aau, buiti hadimurehan,</para>
  <para style="q" vid="PRO 16:23">afiñeragüdatimati giñe hererun.<verse eid="PRO 16:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PRO 16:24" />Dimurei burí bímeti ítara liña kei sírudu;</para>
  <para style="q" vid="PRO 16:24">bímegüdati, ru ligía iseri erei.<verse eid="PRO 16:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PRO 16:25" />Anihein burí üma laganóun kamá suruti,</para>
  <para style="q" vid="PRO 16:25">gama lumoun óunweni lébehabei.<verse eid="PRO 16:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PRO 16:26" />Ha nadagimeinbaña,</para>
  <para style="q" vid="PRO 16:26">ádaha lumutiña halama lun hawadigimaridun,</para>
  <para style="q" vid="PRO 16:26">nadagimeingüda lumutiña ilamaü le hasandirubei.<verse eid="PRO 16:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PRO 16:27" />Ítara haña gürigia ha salufuribaña</para>
  <para style="q" vid="PRO 16:27">kei aban régigi lánina wuribani;</para>
  <para style="q" vid="PRO 16:27">íbini hererun lenege ligemeri watu,<verse eid="PRO 16:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PRO 16:28" />Ha salufuribaña agubuhatiña wuribu,</para>
  <para style="q" vid="PRO 16:28">ha marasualugubaña, gáganiguagüdatiña.<verse eid="PRO 16:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="PRO 16:29" />Ha hanarimebaña, yeegua hamutiña hamadagu,</para>
  <para style="q" vid="PRO 16:29">aba hanügüniña lidoun üma wuribati.<verse eid="PRO 16:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="PRO 16:30" />Ha haritaguabaña hadügün wuribani ámuruha hamuti hagu.</para>
  <para style="q" vid="PRO 16:30">Ha adügaañabaña wuribani ágürüha hamuti hayumáru.<verse eid="PRO 16:30" /></para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" sid="PRO 16:31" />Afayeiruahaü aban ibagari migifeti houn gürigia ha richaguabaña,</para>
  <para style="q" vid="PRO 16:31">ítara liña hagaruban kei aban ridi.<verse eid="PRO 16:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="PRO 16:32" />Buítimati gaguraasuni sügǘ lau ganigi,</para>
  <para style="q" vid="PRO 16:32">buítimati lágüdaagun gürigia lungua</para>
  <para style="q" vid="PRO 16:32">sügǘ lau lagañeirun uburugu burí.<verse eid="PRO 16:32" /></para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" sid="PRO 16:33" />Gürigia achüürübei ubunuruni,</para>
  <para style="q" vid="PRO 16:33">gama lumoun Bungiu laubei lagumuhóun dimurei.<verse eid="PRO 16:33" /></para>
  <para style="b" />
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 17:1" />Buítimati teigín fein deretu lidan abagariduni darangilati</para>
  <para style="q" vid="PRO 17:1">sügǘ lau saragu fedu tidan aban muna ñein lumuti wuribu.<verse eid="PRO 17:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PRO 17:2" />Ubúeingu ha benefabaña,</para>
  <para style="q" vid="PRO 17:2">chülütiña lun hagíaba lan hayubudiri isaanigu ha marichabaña,</para>
  <para style="q" vid="PRO 17:2">ani gafanrantiña lidan alagan kei híbiri isaanigu.<verse eid="PRO 17:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PRO 17:3" />Watu gemeti óuchagubalin golu luma pülata,</para>
  <para style="q" vid="PRO 17:3">ánheinti saminaü, Bungiu óuchagubalin.<verse eid="PRO 17:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PRO 17:4" />Gürigia ha salufuribaña hama ha yéebaña,</para>
  <para style="q" vid="PRO 17:4">adügatiña gasu tau iñeñein wuribatu.<verse eid="PRO 17:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PRO 17:5" />Ha adügütiña bula hau gudemetiña,</para>
  <para style="q" vid="PRO 17:5">anabagua hamuti Habungiute;</para>
  <para style="q" vid="PRO 17:5">ha agundaarutiña lau halamiserun gudemetiña habihubei habeichún.<verse eid="PRO 17:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 17:6" />Habañan wéiyaaña mutu haridinbei;</para>
  <para style="q" vid="PRO 17:6">hagübürigu isaanigu hapantagüle.<verse eid="PRO 17:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 17:7" />Mabuidunti lun ibidiougua tau lun ladimurehan lau uéiriguni,</para>
  <para style="q" vid="PRO 17:7">ni lun gürigia inebewati lun ladimurehan lau eyeeraguni.<verse eid="PRO 17:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PRO 17:8" />Ha abagaridubaña lídangiñe afayeihani</para>
  <para style="q" vid="PRO 17:8">lun madügǘn lan le richaguabei</para>
  <para style="q" vid="PRO 17:8">haritaguatiña luagu gabiñegu hamá,</para>
  <para style="q" vid="PRO 17:8">ladüga buiti lidin houn lidan sun le hadügübei.<verse eid="PRO 17:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PRO 17:9" />Ha ígirubalin anabawaguni lun lásügürün,</para>
  <para style="q" vid="PRO 17:9">agüriahatiña ínsiñeni;</para>
  <para style="q" vid="PRO 17:9">ánhañati ha adügamémebalin,</para>
  <para style="q" vid="PRO 17:9">dísegüda hamutiña hamadagu.<verse eid="PRO 17:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 17:10" />Belutimati aban ebechúni houn gürigia ha gunfurandabaña</para>
  <para style="q" vid="PRO 17:10">sügǘ lau san beiti hawagu ibidiougua tau.<verse eid="PRO 17:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 17:11" />Gürigia ha chagaguabaña wuriburügüñein háluaha</para>
  <para style="q" vid="PRO 17:11">gama lumoun lounahóuba aban uganu hanarimeti houn.<verse eid="PRO 17:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PRO 17:12" />Buítimati labuguchúniwa luma aban animaalu gáñiti</para>
  <para style="q" vid="PRO 17:12">sügǘ lau luma aban ibidiougua tau dan le busén lan aban katei.<verse eid="PRO 17:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 17:13" />Madisedunbei wuribani hábiñegiñe gürigia</para>
  <para style="q" vid="PRO 17:13">ha águyugüdübaña wuribati luagu buiti.<verse eid="PRO 17:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PRO 17:14" />Ítara liña lagumeserun wuribu kei liñurun duna,</para>
  <para style="q" vid="PRO 17:14">buítimati ladisedúniwa luéi,</para>
  <para style="q" vid="PRO 17:14">sügǘ lau ládarawaguniwa unguaü lidoun.<verse eid="PRO 17:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 17:15" />Ferudunawa hamá gaduruntiña luma hasiadirún maduruntiña,</para>
  <para style="q" vid="PRO 17:15">ligía bián katei le auti magundan lan Bungiu.<verse eid="PRO 17:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PRO 17:16" />Ka uagu liabin ibidiougua tau lau seinsu lúhaburugu</para>
  <para style="q" vid="PRO 17:16">agañeiha lichú aau, úatiga gunfuranda lan?<verse eid="PRO 17:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PRO 17:17" />Aban umadaü, súnwandan buidu lan,</para>
  <para style="q" vid="PRO 17:17">ítara liña kei aban íbiri lidan lidaani idiheri.<verse eid="PRO 17:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PRO 17:18" />Ha ibidiouguabaña aau afayeihatiña hawagu hamadagu,</para>
  <para style="q" vid="PRO 17:18">ariha hagía lau hadúeihan.<verse eid="PRO 17:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PRO 17:19" />Ha hínsiñebei houn lun hanabahan,</para>
  <para style="q" vid="PRO 17:19">hínsiñeti wuribu houn;</para>
  <para style="q" vid="PRO 17:19">ha adimurehabaña wéirigu hawougua,</para>
  <para style="q" vid="PRO 17:19">ñoungua hamuti hawaguti guánarügü.<verse eid="PRO 17:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 17:20" />Madaridügü habéi ha wuribabaña isaminan katei le buídubei;</para>
  <para style="q" vid="PRO 17:20">tábürühaba iñeñein yeetu lidoun wuribani.<verse eid="PRO 17:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 17:21" />Igarigurügüñein lanüga ibidiougua tau lun lúguchi,</para>
  <para style="q" vid="PRO 17:21">úati gürigia gúndaati lau lúguchi lan aban ibidiougua tau.<verse eid="PRO 17:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PRO 17:22" />Árani buiti anigi gúndaatu,</para>
  <para style="q" vid="PRO 17:22">ánheinti íruni gidati lídangiñe erei.<verse eid="PRO 17:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PRO 17:23" />Ha salufuribaña resibitiña katei lau</para>
  <para style="q" vid="PRO 17:23">mabuiduni aramudaguarügü,</para>
  <para style="q" vid="PRO 17:23">lun hésegeruni léibugun irichaü.<verse eid="PRO 17:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PRO 17:24" />Lichú aau, ligía háluahabei ha huálibaña ichügü,</para>
  <para style="q" vid="PRO 17:24">ánhañati ha ibidiouguabaña aau,</para>
  <para style="q" vid="PRO 17:24">úati aban katei buiti háluahan.<verse eid="PRO 17:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PRO 17:25" />Isaanigu ha ibidiouguabaña aau,</para>
  <para style="q" vid="PRO 17:25">lébuna igañi luma igarigu houn hagübürigu.<verse eid="PRO 17:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PRO 17:26" />Mabuidunti lun hafayeirawagüdün gürigia ha madurunbaña,</para>
  <para style="q" vid="PRO 17:26">ni lun habeichún gürigia ha inebewabaña.<verse eid="PRO 17:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PRO 17:27" />Lichú aau lilouguan yanu,</para>
  <para style="q" vid="PRO 17:27">lualin ichügü gálumaü.<verse eid="PRO 17:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PRO 17:28" />Íbini ibidiougua tau,</para>
  <para style="q" vid="PRO 17:28">abahüdǘwati kei chuti aau luma kei huali tichügü</para>
  <para style="q" vid="PRO 17:28">dan le maniñu lan.<verse eid="PRO 17:28" /></para>
  <para style="b" />
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 18:1" />Gürigia ha aritagubaña hawouguounrügü,</para>
  <para style="q" vid="PRO 18:1">luágurügüñein katei le buídubei houn haritagua,</para>
  <para style="q" vid="PRO 18:1">máhatiña giñe haganbun eweridihani buiti.<verse eid="PRO 18:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PRO 18:2" />Ha ibidiouguabaña aau, mayumahantiña furendei</para>
  <para style="q" vid="PRO 18:2">hetenirun lúnrügü hapantahan lau le hasubudirubei.<verse eid="PRO 18:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PRO 18:3" />Luma wuribani liabin busiganu;</para>
  <para style="q" vid="PRO 18:3">luma anaaguni unguaü liabin minebesei.<verse eid="PRO 18:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PRO 18:4" />Ítara liña lererun gürigia kei duna huliliti,</para>
  <para style="q" vid="PRO 18:4">duna éibaaguati kei fusu lánina lichú aau.<verse eid="PRO 18:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PRO 18:5" />Mabuidunti lun fulesei hamaniña aguseragüdütiña ha gadurunbaña,</para>
  <para style="q" vid="PRO 18:5">gidá hameime haricha ha madurunbaña.<verse eid="PRO 18:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 18:6" />Dáguatiña ibidiougua tau houngua lidoun wuribu lau hererun;</para>
  <para style="q" vid="PRO 18:6">lau hererun áluahatiña abeichúni houngua.<verse eid="PRO 18:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 18:7" />Hererun guánarügü ibidiougua tau agadeirubaliña;</para>
  <para style="q" vid="PRO 18:7">lau hererun güratiña gúrudu hagiina guánarügü.<verse eid="PRO 18:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PRO 18:8" />Ítara liña marasualugu kei libimen-agei éigini,</para>
  <para style="q" vid="PRO 18:8">gama lumoun chülüti lidoun lilulin agei.<verse eid="PRO 18:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PRO 18:9" />Ha magúalibaña hama ha gagünrinchaguadibaña</para>
  <para style="q" vid="PRO 18:9">ñǘbuintiña lun gamulenugua hamá!<verse eid="PRO 18:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 18:10" />Aban wáyelesi héreti liri Bungiu,</para>
  <para style="q" vid="PRO 18:10">ñǘdüntiña ha richaguabaña aramudagua lidan.<verse eid="PRO 18:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 18:11" />Ha rísibaña, haritaguatiña luagu ítara liña lan harisin</para>
  <para style="q" vid="PRO 18:11">kei aban uburugu le íñuti lubarieirun.<verse eid="PRO 18:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PRO 18:12" />Lárigi anaaguni unguaü liabin féridi;</para>
  <para style="q" vid="PRO 18:12">lárigi ǘnabuguni liabin awanseruni.<verse eid="PRO 18:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 18:13" />Libidiounigan aau ani nibusigarídünati giñe</para>
  <para style="q" vid="PRO 18:13">hóunabun gürigia lubaragiñe haganbun.<verse eid="PRO 18:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PRO 18:14" />Ha sándibaña saragüda hamuti haguraasun;</para>
  <para style="q" vid="PRO 18:14">ánhañati ha maguraasunbaña, kaba ásaaragüdaña?<verse eid="PRO 18:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 18:15" />Ha chúbaña aau hama ha huálibaña ichügü</para>
  <para style="q" vid="PRO 18:15">darí hamuti subudi le háluahabei.<verse eid="PRO 18:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PRO 18:16" />Lau aban edewehani darati sun bena,</para>
  <para style="q" vid="PRO 18:16">ani chülüwati hamoun gürigia íñugubutiña.<verse eid="PRO 18:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PRO 18:17" />Ha furumiñetiña abuyeihatiña haweigiñegua henege garichatiña</para>
  <para style="q" vid="PRO 18:17">darí hachülürün háganiñu ariñaga luagu maricha hamá.<verse eid="PRO 18:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PRO 18:18" />Gumuguagüda lumuti laguseragüdün Bungiu wuribu,</para>
  <para style="q" vid="PRO 18:18">fánreingualaña ha ageindagubaña hámagua.<verse eid="PRO 18:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PRO 18:19" />Íderaguabei bíbiri ábame lágüdahanibu</para>
  <para style="q" vid="PRO 18:19">keisi aban uburugu le derebuguti lubarieirun,</para>
  <para style="q" vid="PRO 18:19">gama lumoun ánhabu awuribuha luma,</para>
  <para style="q" vid="PRO 18:19">ladourubei lubenari buéi.<verse eid="PRO 18:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 18:20" />Kada aban léigibei lin lererun</para>
  <para style="q" vid="PRO 18:20">darí labuchadun luagu.<verse eid="PRO 18:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 18:21" />Gayaraati besefurun o bagünrinchagun aban ibagari lau le bariñagubei,</para>
  <para style="q" vid="PRO 18:21">buidulá lubeiti bayusuruni bererun, ábame beresibiruni bafayeiruaha.<verse eid="PRO 18:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PRO 18:22" />Hagamaridun gürigia,</para>
  <para style="q" vid="PRO 18:22">kéigubeirügü hadariruni lubuidun-agei katei;</para>
  <para style="q" vid="PRO 18:22">arufuda lumuti lira luagu buidu lan Bungiu hama gürigia.<verse eid="PRO 18:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PRO 18:23" />Gürigia gudemetiña lau ayumuraguni hadimureha;</para>
  <para style="q" vid="PRO 18:23">ánhañati rísitiña lau anarimeni hóunaba.<verse eid="PRO 18:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PRO 18:24" />Anihein umadaguaü ménrengunti lagünrinchagun,</para>
  <para style="q" vid="PRO 18:24">gama lumoun añahein giñe umadagu úaraguatiña sügǘ lau íbiri.<verse eid="PRO 18:24" /></para>
  <para style="b" />
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 19:1" />Buítimati lun gudeme ban ani harumatibu</para>
  <para style="q" vid="PRO 19:1">sügǘ lau ibidiougua lan bau, marasualugu buguyame.<verse eid="PRO 19:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PRO 19:2" />Mabuidunti afuruduni masaminarunga buidu,</para>
  <para style="q" vid="PRO 19:2">saragu furesei barüti bulíeiguaü.<verse eid="PRO 19:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PRO 19:3" />Féridigüda lumuti libidiounigan lau gürigia üma lun,</para>
  <para style="q" vid="PRO 19:3">lárigiñeti líchigei duru luagun Bungiu.<verse eid="PRO 19:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PRO 19:4" />Chawati irisini saragu umadagu,</para>
  <para style="q" vid="PRO 19:4">ánheinti gudemeti, íbini lumadagu féridi lumutiña.<verse eid="PRO 19:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PRO 19:5" />Gefentiña ha yeebaña habihubei habeichún,</para>
  <para style="q" vid="PRO 19:5">ha yéebaña mesefurunbaña.<verse eid="PRO 19:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 19:6" />Gürigia ha mánginbaña,</para>
  <para style="q" vid="PRO 19:6">áluaha hamutiña sun gürigia, aba gamada hamaniña.<verse eid="PRO 19:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 19:7" />Meberesenhaaña ligía líbirigu gudemeti lau,</para>
  <para style="q" vid="PRO 19:7">gúbume madisedun hamá lumadagu luéi.<verse eid="PRO 19:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PRO 19:8" />Ha afurendeirutiña, adüga haméi le hafurendeirubei,</para>
  <para style="q" vid="PRO 19:8">hínsiñeguatiña houngua ani awansetiña.<verse eid="PRO 19:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PRO 19:9" />Meredebaña gefentiña ha yéetiña mabeichúnga,</para>
  <para style="q" vid="PRO 19:9">lagurabuñanu óunweni ha marasualugubaña.<verse eid="PRO 19:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 19:10" />Mabagariduntiña ibidiougua tau lidan wendei,</para>
  <para style="q" vid="PRO 19:10">madünama ligía hagumadiruniña idamuni gürigia wéirigutiña.<verse eid="PRO 19:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 19:11" />Ragüguaü unguaü luéi agañiduni ligía lubuidunbei ichügü;</para>
  <para style="q" vid="PRO 19:11">lichugún mebereseni luagu anabawaguni inebeseibei.<verse eid="PRO 19:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PRO 19:12" />Ítara liña ligañi urúei kei ladürürühan liñún;</para>
  <para style="q" vid="PRO 19:12">ánheinti lugundan ítara liña kei serenu ligibuagu sagadi.<verse eid="PRO 19:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 19:13" />Súfurigüda hamutiña isaanigu ibidiougua tau hagübürigu.</para>
  <para style="b" vid="PRO 19:13" />
  <para style="q" vid="PRO 19:13">Würi ganigitu wuribu,</para>
  <para style="q" vid="PRO 19:13">ítara tiña kei lédedehan duna merederagunga.<verse eid="PRO 19:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PRO 19:14" />Hámagiñe agübürigu habiha isaanigu muna luma irisini,</para>
  <para style="q" vid="PRO 19:14">lúmagiñe Bungiu úmari to huali tichügü.<verse eid="PRO 19:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 19:15" />Ruti magúali lilulin idabagu,</para>
  <para style="q" vid="PRO 19:15">ha magúalibaña háfaguba ilamaü.<verse eid="PRO 19:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PRO 19:16" />Ha agunfulirutiña gumadi, góunigi hamuti habagari;</para>
  <para style="q" vid="PRO 19:16">ha íchugutiña mebereseni luagu larufudahan Bungiu, hilaguatiña.<verse eid="PRO 19:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PRO 19:17" />Bafuredeihan lun gudemeti</para>
  <para style="q" vid="PRO 19:17">kéigubeirügü bafuredeihan lun Bungiu,</para>
  <para style="q" vid="PRO 19:17">ani Bungiu guánarügüba afayeirei dúeiti.<verse eid="PRO 19:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PRO 19:18" />Ererehabá lun bisaani lau gayaraagili lan laganbunibu,</para>
  <para style="q" vid="PRO 19:18">gama lumoun mabeichabéi darí báfaruni hilagubei.<verse eid="PRO 19:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PRO 19:19" />Ha hanarimebaña agañidun, resibi hamuti le hadünabei,</para>
  <para style="q" vid="PRO 19:19">ítara liña lesefuruniwa luéi abeichúni</para>
  <para style="q" vid="PRO 19:19">kéisigubeirügü laribadawagüdüntima katei.<verse eid="PRO 19:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 19:20" />Aganbabá eweridihani, anha buguyame lun ererehóuni,</para>
  <para style="q" vid="PRO 19:20">ítara luba biabin lun lachuudun bau.<verse eid="PRO 19:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 19:21" />Adügati gürigia saragu burí aransehani;</para>
  <para style="q" vid="PRO 19:21">gama lumoun laransehanrügüñein Bungiu agunfulira.<verse eid="PRO 19:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PRO 19:22" />Arumani busenwabei lúmagiñe gürigia,</para>
  <para style="q" vid="PRO 19:22">buítimati gudeme lan gürigia sügǘ lau mafayeihadi lan.<verse eid="PRO 19:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PRO 19:23" />Adundehati linebenwa Bungiu lidoun ibagari;</para>
  <para style="q" vid="PRO 19:23">abagaridúati gúndaañu masufurirunga ni murusun wuribani.<verse eid="PRO 19:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PRO 19:24" />Da hamuti ha magúalibaña háhabu lidoun asiedu,</para>
  <para style="q" vid="PRO 19:24">gama lumoun siñá hamuti íchiga hayumulugun.<verse eid="PRO 19:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PRO 19:25" />Lídangiñe habeichúniwa ha barüguabaña houngua,</para>
  <para style="q" vid="PRO 19:25">furendeitiña ha mabuidunbaña ichügü;</para>
  <para style="q" vid="PRO 19:25">ha chúbaña aau, furendeitiña láurügü lererúniwa houn.<verse eid="PRO 19:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PRO 19:26" />Lóuseruni isaani lúguchi wuriba,</para>
  <para style="q" vid="PRO 19:26">luma labugunu lúguchu múnadagiñe,</para>
  <para style="q" vid="PRO 19:26">nibusigarídünati lira ani madünama ligía.<verse eid="PRO 19:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PRO 19:27" />Niráü, ánhabu meberesen lau ererehani,</para>
  <para style="q" vid="PRO 19:27">badireiruba luéi eweridihani buiti.<verse eid="PRO 19:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PRO 19:28" />Gefentiña ha yéetiña, adügatiña bula lau irichaü;</para>
  <para style="q" vid="PRO 19:28">furiti wuribani hayumulugugiñe ha salufuribaña.<verse eid="PRO 19:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="PRO 19:29" />Aranseñu liña fiedu habá ha barüguabaña houngua,</para>
  <para style="q" vid="PRO 19:29">luma abeichúagülei lubá hanagan ha ibidiouguabaña aau.<verse eid="PRO 19:29" /></para>
  <para style="b" />
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 20:1" />Ibidiouguagüdatu diwéin hau gürigia;</para>
  <para style="q" vid="PRO 20:1">chagaguagüda lumutiña uniñein héreti;</para>
  <para style="q" vid="PRO 20:1">úatiña bacharuatiña adügüti katei lau lichú aau.<verse eid="PRO 20:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PRO 20:2" />Ítara liña aban urúei dan le gañi lan kei aban liñún,</para>
  <para style="q" vid="PRO 20:2">ha añawarihatiña lun, híchuguñein habagari lidoun denchaü.<verse eid="PRO 20:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PRO 20:3" />Hanebese gürigia lámalihoun sigenei,</para>
  <para style="q" vid="PRO 20:3">ánhañati ibidiougua tau, hagía agumeserubalin.<verse eid="PRO 20:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PRO 20:4" />Lidan lidaani awouhani, mawouhantiña ha magúalibaña;</para>
  <para style="q" vid="PRO 20:4">dánmeti lidaani alubahani,</para>
  <para style="q" vid="PRO 20:4">háluahaba gama lumoun madaribaña.<verse eid="PRO 20:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PRO 20:5" />Ítara liña saminaü aramudaguati kei duna huliliti;</para>
  <para style="q" vid="PRO 20:5">gama lumoun ha huálibaña ichügü, gadariraditiña lun.<verse eid="PRO 20:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 20:6" />Añahein saragu ariñagutiña luagu úaragua hamá</para>
  <para style="q" vid="PRO 20:6">gama lumoun madarirúnti ni aban le gayaraati lafiñerúniwa luagu.<verse eid="PRO 20:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 20:7" />Fuleseiwatiña isaanigu ha lígirubaña úguchili</para>
  <para style="q" vid="PRO 20:7">le abagaridubei lidan arumani luma ísuruni.<verse eid="PRO 20:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PRO 20:8" />Dan le lañuurun urúei tidan lúbaanina aguseruni,</para>
  <para style="q" vid="PRO 20:8">buídurügüti larihin lun labuiduni wuribani.<verse eid="PRO 20:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PRO 20:9" />Úati ni aban gayaraati lariñagun:</para>
  <para style="q" vid="PRO 20:9">«Harumatu nanigi, mafigountina».<verse eid="PRO 20:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 20:10" />Magundanti Bungiu lau balansu</para>
  <para style="q" vid="PRO 20:10">luma amisuraagülei le múaranti.<verse eid="PRO 20:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 20:11" />Luagu ligaburi hóuserun nibureintiña</para>
  <para style="q" vid="PRO 20:11">lasubudirúa anhein lídanñanu lubéi ísuruni.<verse eid="PRO 20:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PRO 20:12" />Arigeirugu lun aganbuni luma aguu lun arihini,</para>
  <para style="q" vid="PRO 20:12">Bungiu adügübalin lira.<verse eid="PRO 20:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 20:13" />Mederegeraguabá bungua lun lidabu aguu,</para>
  <para style="q" vid="PRO 20:13">ladüga bagudemeduba;</para>
  <para style="q" vid="PRO 20:13">agaguduañubá, ítara luba geigin ban saragu.<verse eid="PRO 20:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PRO 20:14" />«Luriban ebegidinaü mau!»</para>
  <para style="q" vid="PRO 20:14">Liña hariñagun ha agañeihabaña,</para>
  <para style="q" vid="PRO 20:14">gama lumoun lárigiñe hagañeihan ma hagundan.<verse eid="PRO 20:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 20:15" />Gebegitimatiña ha adimurehabaña lau lichú aau</para>
  <para style="q" vid="PRO 20:15">sügǘ lau sun golu luma uéndeni le ubouagubei.<verse eid="PRO 20:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PRO 20:16" />Ha íchaagutiña houngua lun hafayeiruni hadúeihan terencha,</para>
  <para style="q" vid="PRO 20:16">gidawatá hadaüragun hawéi darí hafayeiruni dúeiti.<verse eid="PRO 20:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PRO 20:17" />Hínsiñeti houn gürigia lun heigin iyeeni,</para>
  <para style="q" vid="PRO 20:17">íbini lílüwagu lan aba hasandirun kamá héigiña múa.<verse eid="PRO 20:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PRO 20:18" />Derebugugüdawati aransehani lau aban eweridihani buiti;</para>
  <para style="q" vid="PRO 20:18">lau afansehani buiti ladügǘwa wuribu.<verse eid="PRO 20:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PRO 20:19" />Ha marasualugubaña, mámanichuntiña lau katei aramudaguati,</para>
  <para style="q" vid="PRO 20:19">móundaraguaba lubeiti hama marasualugutiña.<verse eid="PRO 20:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 20:20" />Ha íñaragutiña háguchi o háguchu,</para>
  <para style="q" vid="PRO 20:20">hóunweguba lidan lanarime luburiga.<verse eid="PRO 20:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 20:21" />Irisini le ménrengubei libihíniwa,</para>
  <para style="q" vid="PRO 20:21">manügünti buiti houn gürigia.<verse eid="PRO 20:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PRO 20:22" />Maritaguabá lun báguyugüdün wuribani luagu wuribani,</para>
  <para style="q" vid="PRO 20:22">lubaragiñe lira afiñebá luagu Bungiu, ábame lagañeiragüdünibu.<verse eid="PRO 20:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PRO 20:23" />Magundanti Bungiu lau balansu</para>
  <para style="q" vid="PRO 20:23">luma amisuraagülei le múaranti.<verse eid="PRO 20:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PRO 20:24" />Bungiu adundehabalin wéibugun,</para>
  <para style="q" vid="PRO 20:24">ida lubati wasubudiruni wasinun guánarügü?<verse eid="PRO 20:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PRO 20:25" />Mabuidunti füramase lan gürigia lun Bungiu,</para>
  <para style="q" vid="PRO 20:25">ani ñéingiñe aba lasakürihan luagu le füramase láalibei.<verse eid="PRO 20:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PRO 20:26" />Urúei le chubei aau, dísegüda lumutiña wuribatiña luáriua,</para>
  <para style="q" vid="PRO 20:26">aba laburechaguniña lábugiñe aban ubalabalaü.<verse eid="PRO 20:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PRO 20:27" />Ítara liña Sífiri le líchugubei Bungiu houn gürigia,</para>
  <para style="q" vid="PRO 20:27">kei igemeri lun larugoungadagüdüni habagari.<verse eid="PRO 20:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PRO 20:28" />Chóuruguati urúei lungua luagu lálana larúeihan</para>
  <para style="q" vid="PRO 20:28">dan le labagaridun lau ínsiñehabuni luma inarüni.<verse eid="PRO 20:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="PRO 20:29" />Here nibureingiña hapantagülebei;</para>
  <para style="q" vid="PRO 20:29">hagaruban wéiyaaña mutu henebesebei.<verse eid="PRO 20:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="PRO 20:30" />Abeichúni luma igarigu láranibei wuribani;</para>
  <para style="q" vid="PRO 20:30">areidaguagüda lumutu buleseiti wanigi.<verse eid="PRO 20:30" /></para>
  <para style="b" />
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 21:1" />Ítara tiña lanigi urúei lúhaburugu Bungiu kei lémeri duna,</para>
  <para style="q" vid="PRO 21:1">ñǘdünti le ñéingiñe lubéi labusenrei Bungiu.<verse eid="PRO 21:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PRO 21:2" />Lidan haritagun gürigia, buiti sun le hadügübei,</para>
  <para style="q" vid="PRO 21:2">gama lumoun Bungiu aguseragüdübalin saminaü.<verse eid="PRO 21:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PRO 21:3" />Abagaridabá lidan ísuruni luma lidan richaguaü,</para>
  <para style="q" vid="PRO 21:3">ladüga hínsiñetimati lira lun Bungiu sügǘ lau adagaragüdüni.<verse eid="PRO 21:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PRO 21:4" />Agu íñuguti lanaagun lungua, saminaü pántati;</para>
  <para style="q" vid="PRO 21:4">figóu hagemeribei ha salufuribaña.<verse eid="PRO 21:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PRO 21:5" />Aransehani le saminawati buidu, buiti lasalirun,</para>
  <para style="q" vid="PRO 21:5">anhein le adügǘbei lau furesei, barüti günringuaü.<verse eid="PRO 21:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 21:6" />Irisini le ibihúbei lau iyeeni,</para>
  <para style="q" vid="PRO 21:6">katei gásügürati lira ani hani ha áluahabalin óunweni.<verse eid="PRO 21:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 21:7" />Ha salufuribaña lagünrinchagubaña hariban guánarügü,</para>
  <para style="q" vid="PRO 21:7">ladüga hamahan habagaridun lidan richaguaü.<verse eid="PRO 21:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PRO 21:8" />Gürigia ha wuribabaña igaburi,</para>
  <para style="q" vid="PRO 21:8">segeti ani machourunti giñe hémeri;</para>
  <para style="q" vid="PRO 21:8">ánheinti hóuserun gürigia ha úaraguabaña harumati.<verse eid="PRO 21:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PRO 21:9" />Buítimati laganóuniwa tarigeirugu muna,</para>
  <para style="q" vid="PRO 21:9">sügǘ lau tidan muna wéiritu</para>
  <para style="q" vid="PRO 21:9">tuma aban würi to ganigitu wuribu.<verse eid="PRO 21:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 21:10" />Gürigia ha salufuribaña hadügünrügüñein wuribani hasaminara;</para>
  <para style="q" vid="PRO 21:10">marihin hamutiña hábegunu lau areini.<verse eid="PRO 21:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 21:11" />Furendeitiña ha mabuidunbaña ichügü</para>
  <para style="q" vid="PRO 21:11">lídangiñe habeichún ha ibidiouguabaña aau;</para>
  <para style="q" vid="PRO 21:11">ha chúbaña aau, furendeitiña láurügü lafuranguagüdüniwa katei.<verse eid="PRO 21:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PRO 21:12" />Aríagua lumutu Bungiu haban gürigia ha salufuribaña,</para>
  <para style="q" vid="PRO 21:12">ani derege lumutiña ha wuribabaña lun günringuaü.<verse eid="PRO 21:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 21:13" />Ha máhabaña haganbuni hayumuragun gudemetiña,</para>
  <para style="q" vid="PRO 21:13">maganbúnbaña giñe danme le hamuriahan ídemuei.<verse eid="PRO 21:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PRO 21:14" />Edewehani le adügǘti maniñu,</para>
  <para style="q" vid="PRO 21:14">gáluma lumuti íbini igañi le héreti.<verse eid="PRO 21:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 21:15" />Dan le ladügǘn irichaü, gúndaatiña ha richaguabaña,</para>
  <para style="q" vid="PRO 21:15">ábati liabin günringuaü hawagun ha salufuribaña.<verse eid="PRO 21:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PRO 21:16" />Ha mafalatiña aban igaburi buiti,</para>
  <para style="q" vid="PRO 21:16">hóudiba adagara hadoun hilaaña.<verse eid="PRO 21:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PRO 21:17" />Ha ederegeragutiña houngua lun lagübüri ugundani,</para>
  <para style="q" vid="PRO 21:17">kei burí diwéin luma ibiñein,</para>
  <para style="q" vid="PRO 21:17">lídanba gudemei hagumucha.<verse eid="PRO 21:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PRO 21:18" />Gürigia ha yéebaña, salufuri hagía,</para>
  <para style="q" vid="PRO 21:18">hasufuriruba heweñegua ha harumabaña ani richagua.<verse eid="PRO 21:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PRO 21:19" />Buítimati laganóuniwa lidan fulasu mageirawati</para>
  <para style="q" vid="PRO 21:19">sügǘ lau tuma aban würi to ganigitu wuribu.<verse eid="PRO 21:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 21:20" />Hábiñe ha chúbaña aau, anihein irisini luma ibiñein</para>
  <para style="q" vid="PRO 21:20">ánhañati ibidiougua tau, wesi hamuti sun le hámabei.<verse eid="PRO 21:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 21:21" />Ha óuchubaña lun úaragua hamá,</para>
  <para style="q" vid="PRO 21:21">daritiña ibagari luma uéiriguni.<verse eid="PRO 21:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PRO 21:22" />Ageindaguatiña ha chúbaña aau luma aban uburugu le góunigiwati buidu,</para>
  <para style="q" vid="PRO 21:22">ani gumuguagüda hamuti ubafu le buga uágubei lemenigida uburugu ligía.<verse eid="PRO 21:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PRO 21:23" />Anhein mabusenrun bubéi gadan lánibu wuribani,</para>
  <para style="q" vid="PRO 21:23">góunigibei dimurei le lunbei bariñaguni.<verse eid="PRO 21:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PRO 21:24" />Barügua tungua, pántatiña, íñugutiña</para>
  <para style="q" vid="PRO 21:24">ítara liña laguarúniwa houn gürigia ha barüguabaña ungua.<verse eid="PRO 21:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PRO 21:25" />Hilatiña magúalitiña lau ayumahani,</para>
  <para style="q" vid="PRO 21:25">ladüga máhatiña hawadigimaridun;<verse eid="PRO 21:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 21:26" />sun weyu hau ayumaha.</para>
  <para style="q" vid="PRO 21:26">Ánhañati ha richaguabaña, mángitiña.<verse eid="PRO 21:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PRO 21:27" />Magundanti Bungiu lau hadewese salufuritiña,</para>
  <para style="q" vid="PRO 21:27">ladüga lau luriban aritaguni híchigei.<verse eid="PRO 21:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PRO 21:28" />Hagünrinchawaguba gefentiña ha yéebaña;</para>
  <para style="q" vid="PRO 21:28">ánhañati ha gaganbadibaña súnwandan gayaraabei lan hóunabun.<verse eid="PRO 21:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="PRO 21:29" />Ha salufuribaña, aba hafamurun kei chóuruguatiña houngua;</para>
  <para style="q" vid="PRO 21:29">ha harumabaña chóuruguatiña houngua luagu lubuidun hóuserun.<verse eid="PRO 21:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="PRO 21:30" />Úati lichú aau gebegiti ligibugiñe Bungiu,</para>
  <para style="q" vid="PRO 21:30">ni lualin ichügü ni saminaü buiti.<verse eid="PRO 21:30" /></para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" sid="PRO 21:31" />Aranse lumuti gürigia gabayu lubá lebelurun wuriburugun,</para>
  <para style="q" vid="PRO 21:31">gama lumoun Bungiu íchugubalin agañeiruni.<verse eid="PRO 21:31" /></para>
  <para style="b" />
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 22:1" />Buítimati lun ladimurehoun buidu luagu gürigia</para>
  <para style="q" vid="PRO 22:1">sügǘ lau gama lan saragu golu luma pülata.<verse eid="PRO 22:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PRO 22:2" />Anihein aban katei genegeguati lidan rísiti luma gudemeti:</para>
  <para style="q" vid="PRO 22:2">Biángubei lan hagía ladügün Bungiu.<verse eid="PRO 22:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PRO 22:3" />Ha buídubaña ichügü harihini denchaü hegeyedun luéi;</para>
  <para style="q" vid="PRO 22:3">ánhañati ha ibidiouguabaña aau,</para>
  <para style="q" vid="PRO 22:3">ñǘdünrügütiña lubaroun ábati hasufuriruni damichi.<verse eid="PRO 22:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PRO 22:4" />Barüti ǘnabuguni luma inebehabu lun Bungiu,</para>
  <para style="q" vid="PRO 22:4">irisini, uéiriguni luma ibagari kei afayeiruahaü.<verse eid="PRO 22:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PRO 22:5" />Buin liña hémeri gürigia ha salufuribaña tau sádara;</para>
  <para style="q" vid="PRO 22:5">ánhañati ha góunigibalin habagari, geyetiña tuéi.<verse eid="PRO 22:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 22:6" />Arufudahabá buiti lun irahü dan le ñǘraügili;</para>
  <para style="q" vid="PRO 22:6">íbini danme le wéiyaali mabulieidun lubéi.<verse eid="PRO 22:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 22:7" />Ha rísibaña, urúeiñanu hadan ha gudemebaña;</para>
  <para style="q" vid="PRO 22:7">ánheinti hadan ha adúeihabaña, ha afuredeihabaña.<verse eid="PRO 22:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PRO 22:8" />Ha ábunagutiña wuribani, halubahaba lamiselu;</para>
  <para style="q" vid="PRO 22:8">lagünrinchagubaña Bungiu lau ligañi!<verse eid="PRO 22:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PRO 22:9" />Habinirúba ha gudemehabutiña houn hábegu,</para>
  <para style="q" vid="PRO 22:9">ladüga hafanreinraguni heigin hama ha gudemebaña.<verse eid="PRO 22:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 22:10" />Houdin ha mabuchahabaña, lagumuchagun gáganiguaü,</para>
  <para style="q" vid="PRO 22:10">wuribu luma anabahani.<verse eid="PRO 22:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 22:11" />Gúndaati urúei hau gürigia ha harumabaña anigi,</para>
  <para style="q" vid="PRO 22:11">gamadagua ligía lungua hama ha adimurehabaña lau inebesei.<verse eid="PRO 22:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PRO 22:12" />Góunigi lumutiña Bungiu gürigia ha chúbaña aau;</para>
  <para style="q" vid="PRO 22:12">ani arufudaléi hayeeni ha yéebaña.<verse eid="PRO 22:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 22:13" />Ha magúalibaña, luéi hawadigimaridun,</para>
  <para style="q" vid="PRO 22:13">hariñaga luagu anihein lan aban liñún ǘmada abusenra láfaruniña.<verse eid="PRO 22:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PRO 22:14" />Ítara liña tiyuma würi to agabarahatu túmari kei fusu huliliti</para>
  <para style="q" vid="PRO 22:14">le ñeinhin lubéi hábürüha ha líñaragubaña Bungiu.<verse eid="PRO 22:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 22:15" />Libidiounigan aau, ligía aban lídangiñe katei</para>
  <para style="q" vid="PRO 22:15">le lídanbei hasaminan nibureingiña,</para>
  <para style="q" vid="PRO 22:15">gama lumoun gidati hawéi dan le habeichúniwa.<verse eid="PRO 22:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PRO 22:16" />Ha amudiragutiña gudemetiña lun harisidun</para>
  <para style="q" vid="PRO 22:16">o híchugun lan lun rísiti,</para>
  <para style="q" vid="PRO 22:16">hagumuchuba lidan gudemei.<verse eid="PRO 22:16" /></para>
  <para style="ms">IV. Hererun Chu Tau</para>
  <para style="mr">(<ref loc="PRO 22:17-24:22">22.17—24.22</ref>)</para>
  <para style="s1">Darandi hererun chútiña aau</para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 22:17" />Rubei barigei lun baganbuni le hariñagubei ha chúbaña aau;</para>
  <para style="q" vid="PRO 22:17">saminabá buidu luagu le narufudahabei bun.<verse eid="PRO 22:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 22:18" />Gúndaabadibu lau bareiduni bichügüwagu</para>
  <para style="q" vid="PRO 22:18">luma lun gayara lan báguyuguagüdüni súngubei aban lárigi aban.<verse eid="PRO 22:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 22:19" />Nasubudiragüdüñein bun uguñe,</para>
  <para style="q" vid="PRO 22:19">lun bíchuguni bafiñen luagu Bungiu.<verse eid="PRO 22:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 22:20" />Bürühadina darandi ariñawagúni bun</para>
  <para style="q" vid="PRO 22:20">le gádanbei eweridihani luma subudi,<verse eid="PRO 22:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 22:21" />lun larufudahan bun lun basubudiruni inarüni,</para>
  <para style="q" vid="PRO 22:21">lun gayara lan bíchugun óunabuni buiti lun le álügüdütibu.<verse eid="PRO 22:21" /></para>
  <para style="s2">-1-</para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 22:22" />Mamudiraguabáña ha gudemebaña ladüga hagudemen,</para>
  <para style="q" vid="PRO 22:22">mámurudunbañame ha siñaguabaña houngua hagibugiñe aguseragüdütiña;<verse eid="PRO 22:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 22:23" />ladüga liábinba Bungiu lun hámagiñe lan,</para>
  <para style="q" vid="PRO 22:23">ábame lámuruduniña ha ámurudubaliña.<verse eid="PRO 22:23" /></para>
  <para style="s2">-2-</para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 22:24" />Mamadaguabá bungua hama gürigia hanarimetiña</para>
  <para style="q" vid="PRO 22:24">ni hama gémutiña,<verse eid="PRO 22:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 22:25" />furendeibiñalin luriban hagaburi,</para>
  <para style="q" vid="PRO 22:25">ábameti bíchuguni gúrudu luagun bigiina.<verse eid="PRO 22:25" /></para>
  <para style="s2">-3-</para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 22:26" />Manügabá kárugu lau hadúeihan amu gürigia,<verse eid="PRO 22:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 22:27" />ladüga anhein ua buma lun bafayeiruni,</para>
  <para style="q" vid="PRO 22:27">íbini bigabanan, tagidarúba buéi.<verse eid="PRO 22:27" /></para>
  <para style="s2">-4-</para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 22:28" />Masansirabéi láfadaragun fulasu le harufudubei bagüchagu bun.<verse eid="PRO 22:28" /></para>
  <para style="s2">-5-</para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 22:29" />Ha adügütiña hawadigimari buidu,</para>
  <para style="q" vid="PRO 22:29">heseriwiduba houn urúeigu,</para>
  <para style="q" vid="PRO 22:29">mama houn furumiñeguarügü gürigia.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="s2">-6-</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 23:1" />Dan hagunbirahanibu gürigia wéirigutiña eiga,</para>
  <para style="q" vid="PRO 23:1">saminabá buidu ka lan igibugiñeñadibu.<verse eid="PRO 23:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 23:2" />Íbini weiri lan bilama,</para>
  <para style="q" vid="PRO 23:2">hámarula beigin.<verse eid="PRO 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 23:3" />Mawamadirabéi lubuidun heigin,</para>
  <para style="q" vid="PRO 23:3">ladüga gayaraati heyeeduñadibu lan.<verse eid="PRO 23:3" /></para>
  <para style="s2">-7-</para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 23:4" />Máfaaguaba lun barisidun,</para>
  <para style="q" vid="PRO 23:4">madiheridabá luagu lira.<verse eid="PRO 23:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 23:5" />Anhein bariha katei buidu, barihubei luagu ua lan irisini,</para>
  <para style="q" vid="PRO 23:5">áhamahati sódini kei ágila</para>
  <para style="q" vid="PRO 23:5">kamá hamuga saliguarügüti arünaü luagu.<verse eid="PRO 23:5" /></para>
  <para style="s2">-8-</para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 23:6" />Mañuurabá eiga hama arügüretiña,</para>
  <para style="q" vid="PRO 23:6">mawamadirunbéime lubuidun heigin,<verse eid="PRO 23:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 23:7" />ha ítarabaña kei aban ídiburi lidan agülerugu:</para>
  <para style="q" vid="PRO 23:7">Agunbiraha hamutibu lun beigin luma lun batun hama,</para>
  <para style="q" vid="PRO 23:7">gama lumoun mama lau linarün hagunbirahabu;<verse eid="PRO 23:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 23:8" />bewerahabéi le béigibei,</para>
  <para style="q" vid="PRO 23:8">úaalime hu lan lubuidun burí bererun bun.<verse eid="PRO 23:8" /></para>
  <para style="s2">-9-</para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 23:9" />Maganbagüdabéi bererun houn ha ibidiouguabaña aau,</para>
  <para style="q" vid="PRO 23:9">hadügüba bula lau lichú lau badimurehan.<verse eid="PRO 23:9" /></para>
  <para style="s2">-10-</para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 23:10" />Masansirabéi binadu fadaguaü,</para>
  <para style="q" vid="PRO 23:10">manügünbeime hafulasun méteñuhaña,<verse eid="PRO 23:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 23:11" />ladüga anihein aban esefuhati gabafuti hámagiñe,</para>
  <para style="q" vid="PRO 23:11">lageindaguba buma haweigiñe.<verse eid="PRO 23:11" /></para>
  <para style="s2">-11-</para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 23:12" />Rubei bisaminan luma barigei</para>
  <para style="q" vid="PRO 23:12">lun arufudahani luma subudi.<verse eid="PRO 23:12" /></para>
  <para style="s2">-12-</para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 23:13" />Merederalá bererehan lun irahü,</para>
  <para style="q" vid="PRO 23:13">máfarun lubéi abeichúni hilagubei;<verse eid="PRO 23:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 23:14" />lubaragiñe lira, anhein babeicha,</para>
  <para style="q" vid="PRO 23:14">besefurubei luéi óunweni.<verse eid="PRO 23:14" /></para>
  <para style="s2">-13-</para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 23:15" />Ragǘ baali ligíame lichú aau, niráü,</para>
  <para style="q" vid="PRO 23:15">úabei ni aban gúndaati nuéi;<verse eid="PRO 23:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 23:16" />nasandiruba aban óunwenbu ugundani</para>
  <para style="q" vid="PRO 23:16">danme naganbun badimurehan kei lubudubu.<verse eid="PRO 23:16" /></para>
  <para style="s2">-14-</para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 23:17" />Magimugarabaña gafigountiña,</para>
  <para style="q" vid="PRO 23:17">lubaragiñe lira, ruba inebesei lun Bungiu;<verse eid="PRO 23:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 23:18" />ítara luba buidu lan lidin bun,</para>
  <para style="q" vid="PRO 23:18">ani meferidirunbei bemenigin.<verse eid="PRO 23:18" /></para>
  <para style="s2">-15-</para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 23:19" />Gaganbadibá niráü, furendeibá;</para>
  <para style="q" vid="PRO 23:19">áfaaguaba bafalaruni üma le buídubei.<verse eid="PRO 23:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 23:20" />Móundaraguaba hama gátaditiña,</para>
  <para style="q" vid="PRO 23:20">ni hama wéinamu teigin,<verse eid="PRO 23:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 23:21" />ladüga gátaditiña hama wéinamu teigin,</para>
  <para style="q" vid="PRO 23:21">lidan günringuaü hagumucha;</para>
  <para style="q" vid="PRO 23:21">ha magúalibaña huchecheeru hadaüragunboun.<verse eid="PRO 23:21" /></para>
  <para style="s2">-16-</para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 23:22" />Aganbabéi búguchi le agaraüdübalibu,</para>
  <para style="q" vid="PRO 23:22">míchigaba mebereseni tun búguchu danme le taweiyadun.<verse eid="PRO 23:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 23:23" />Agañeihabei inarüni luma lichú aau,</para>
  <para style="q" vid="PRO 23:23">arufudahani luma gunfurandaü, ani malugurabéi!<verse eid="PRO 23:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 23:24" />Agübürigu ha gasaanitiña irahüñü buítiña ani chu ligía hau,</para>
  <para style="q" vid="PRO 23:24">garichatiña gúndaañu hamá hau, apantaha hagía hawagu;<verse eid="PRO 23:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 23:25" />adügabá lubeiti lun gúndaañu hamá bagübürigu,</para>
  <para style="q" vid="PRO 23:25">apantaha hagíame.<verse eid="PRO 23:25" /></para>
  <para style="s2">-17-</para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 23:26" />Tenibá buidu lun le nariñagubei, niráü,</para>
  <para style="q" vid="PRO 23:26">arihabéime nani hénpulu lidan nibagari;<verse eid="PRO 23:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 23:27" />ladüga würi to terencha, to horu,</para>
  <para style="q" vid="PRO 23:27">ítara tiña kei aban fusu huliliti ani bürüraü ligia;<verse eid="PRO 23:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 23:28" />sétitu habá wügüriña keisi aban híweruti;</para>
  <para style="q" vid="PRO 23:28">aba teferidiraguagüdün saragu wügüriña.<verse eid="PRO 23:28" /></para>
  <para style="s2">-18-</para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 23:29" />Ka asufurirubei? Ka ayahubei? Ka ageindagubei?</para>
  <para style="q" vid="PRO 23:29">Ka íbaawagubei mébunouga? Ka dagumebei arihin?<verse eid="PRO 23:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 23:30" />Le mígirunbalin átuni,</para>
  <para style="q" vid="PRO 23:30">ani redei ligía oucha sun tuwuyeri diwéin.<verse eid="PRO 23:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 23:31" />Mawamadatá diwéin bun.</para>
  <para style="q" vid="PRO 23:31">Mama tífunan ámiriha tugía lidan weru!</para>
  <para style="q" vid="PRO 23:31">Ma lubuidun tasandirúniwa dan le tatuniwa!<verse eid="PRO 23:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 23:32" />Gama lumoun lárigiñe,</para>
  <para style="q" vid="PRO 23:32">ítara liña tasandirúniwa kei tágürün hewe, ani gáriti.<verse eid="PRO 23:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 23:33" />Larihagüdübadibu katei terenchati,</para>
  <para style="q" vid="PRO 23:33">ladimuregüdübadibu ani saminagüdalábume libidiounigan aau,<verse eid="PRO 23:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 23:34" />basandiraguba bungua</para>
  <para style="q" vid="PRO 23:34">kamá baranahañadibu tidan aban ugunei</para>
  <para style="q" vid="PRO 23:34">balañu luagu wewe le wéiritimabei tuagu.<verse eid="PRO 23:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 23:35" />Bariñagame:</para>
  <para style="q" vid="PRO 23:35">«Buleseiwatina ani masandi numuti;</para>
  <para style="q" vid="PRO 23:35">béiwatina, ani mefentina luagu;</para>
  <para style="q" vid="PRO 23:35">gama lumoun danme násaarun,</para>
  <para style="q" vid="PRO 23:35">nídiyaba áluaha diwéin».<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="s2">-19-</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 24:1" />Magimugarabaña wuribatiña,</para>
  <para style="q" vid="PRO 24:1">mayumahabá lun lidan ban aban hama,<verse eid="PRO 24:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 24:2" />ladüga luágurügüñein anarimeni hasaminara,</para>
  <para style="q" vid="PRO 24:2">luágurügüñein ladügǘn wuribani hadimureha.<verse eid="PRO 24:2" /></para>
  <para style="s2">-20-</para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 24:3" />Lau lichú aau tábunawagua muna,</para>
  <para style="q" vid="PRO 24:3">lau lualin ichügü lichugúa tuágaburi;<verse eid="PRO 24:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 24:4" />lau subudi labuinchagüdüwa tirumun lau ílagu gebegiti le buíduburiti.<verse eid="PRO 24:4" /></para>
  <para style="s2">-21-</para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 24:5" />Buítimatiña gürigia chútiña aau sügǘ hau gürigia héretiña;</para>
  <para style="q" vid="PRO 24:5">buítimati lichú aau sügǘ lau ubafu;<verse eid="PRO 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 24:6" />ladüga lau aransehani buiti ladügǘwa wuribu,</para>
  <para style="q" vid="PRO 24:6">hádanñein saragu eweridihatiña agañeiruni.<verse eid="PRO 24:6" /></para>
  <para style="s2">-22-</para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 24:7" />Ha ibidiouguabaña aau, ibidiñeti houn kaba lan hariñaga</para>
  <para style="q" vid="PRO 24:7">ligibugiñe aguseragüdüti,</para>
  <para style="q" vid="PRO 24:7">ladüga díseti lichú aau hawéi.<verse eid="PRO 24:7" /></para>
  <para style="s2">-23-</para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 24:8" />Ha luágurügübei ladügǘn damichi hasaminara,</para>
  <para style="q" vid="PRO 24:8">adimurehóuati hawagu ladüga luriban hasaminan.<verse eid="PRO 24:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 24:9" />Figóu hasaminanbei ibidiougua tau;</para>
  <para style="q" vid="PRO 24:9">úati hínsiñehabuti houn ha wuribabaña ichügü.<verse eid="PRO 24:9" /></para>
  <para style="s2">-24-</para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 24:10" />Anhein ábürüha barüna dan le lidan ban lénrengunga,</para>
  <para style="q" vid="PRO 24:10">lóuguarügü liña bere.<verse eid="PRO 24:10" /></para>
  <para style="s2">-25-</para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 24:11" />Sefubáña ha siádiwaaña lun óunweni;</para>
  <para style="q" vid="PRO 24:11">sefubáña ha madiseelibei hounwen lídangiñe denchaü.<verse eid="PRO 24:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 24:12" />Ladüga íbini bariñagun luagu ibidiñe lan yebe bun,</para>
  <para style="q" vid="PRO 24:12">líchuguba le aguseragüdübalin lébuna katei fe luagu,</para>
  <para style="q" vid="PRO 24:12">lasubudirubei le aríagubei bun,</para>
  <para style="q" vid="PRO 24:12">le afayeirubalin kada aban según katei le ladügübei.<verse eid="PRO 24:12" /></para>
  <para style="s2">-26-</para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 24:13" />Guraba sírudu bímeti le tídangiñeti haban maba, niráü:</para>
  <para style="q" vid="PRO 24:13">Houchabéi, ariha báamugei lisemén.<verse eid="PRO 24:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 24:14" />Ítarameme luba libimen basandiruni lichú aau luma subudi;</para>
  <para style="q" vid="PRO 24:14">anhein badarira, buídubei lidin bun,</para>
  <para style="q" vid="PRO 24:14">ani meferidirunbei bemenigin.<verse eid="PRO 24:14" /></para>
  <para style="s2">-27-</para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 24:15" />Maransehabá lagübüri saminaü habá gürigia ha harumabaña,</para>
  <para style="q" vid="PRO 24:15">madügün buguyame günringuaü tidan muna to ñein lubéi haganawa,<verse eid="PRO 24:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 24:16" />ladüga íbini héiguadun sedü wéiyaasu,</para>
  <para style="q" vid="PRO 24:16">hásaarayaba sedü wéiyaasu,</para>
  <para style="q" vid="PRO 24:16">ánhaña ha salufuribaña hábürühaba lidan günringuaü.<verse eid="PRO 24:16" /></para>
  <para style="s2">-28-</para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 24:17" />Magundaarabá, mefeduhan buguyame lau léiguadun bágani,<verse eid="PRO 24:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 24:18" />ladüga mínsiñebei lun Bungiu lun larihini lira,</para>
  <para style="q" vid="PRO 24:18">ábameti ladisedun ligañi luéi bágani.<verse eid="PRO 24:18" /></para>
  <para style="s2">-29-</para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 24:19" />Magañidagüda hamabu ha wuribabaña,</para>
  <para style="q" vid="PRO 24:19">magimugarabaña giñe ha salufuribaña,<verse eid="PRO 24:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 24:20" />ladüga wuribabei hagumuchun gürigia ha salufuribaña:</para>
  <para style="q" vid="PRO 24:20">Héñeguchuba ha salufuribaña keisi aban lanpu!<verse eid="PRO 24:20" /></para>
  <para style="s2">-30-</para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 24:21" />Ruba inebesei lun Bungiu luma lun urúei, niráü,</para>
  <para style="q" vid="PRO 24:21">móundaraba hama áganiñu.<verse eid="PRO 24:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 24:22" />Ladüga madisebei liabin günringuaü hawagun,</para>
  <para style="q" vid="PRO 24:22">ani ibidiñewati kaba lan abeichúni líchiga Bungiu luma urúei houn.<verse eid="PRO 24:22" /></para>
  <para style="ms">V. Amu Burí Hererun Ha Chúbaña Aau</para>
  <para style="mr">(<ref loc="PRO 24:23-34">24.23-34</ref>)</para>
  <para style="s1">Hererun burí ha chúbaña aau</para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 24:23" />Anihán le hererun burí giñe ha chúbaña aau:</para>
  <para style="b" vid="PRO 24:23" />
  <para style="q" vid="PRO 24:23">Mabuidunti lun ǘnabu lan lanügǘn aban gürigia</para>
  <para style="q" vid="PRO 24:23">luéi le aban tidan lúbaanina aguseruni.<verse eid="PRO 24:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 24:24" />Ha agidarutiña hadurun ha gadurunbaña,</para>
  <para style="q" vid="PRO 24:24">íñaragua hamutiña gürigia,</para>
  <para style="q" vid="PRO 24:24">ani barüwatiña giñe kei ni kata;<verse eid="PRO 24:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 24:25" />ánhaña ha abeichubaliña ha gadurunbaña,</para>
  <para style="q" vid="PRO 24:25">buiti lidin houn ani biní hamutiña gürigia.<verse eid="PRO 24:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PRO 24:26" />Óunabagülei le inarüniti,</para>
  <para style="q" vid="PRO 24:26">ligía séinibei le lánina aban umadaguaü le tímatimaati.<verse eid="PRO 24:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PRO 24:27" />Aransehabei bumarasun ǘmada,</para>
  <para style="q" vid="PRO 24:27">adügabéime bidasin bicharirugu,</para>
  <para style="q" vid="PRO 24:27">lárigiñeme lira, gayaraahalime bábunagunu buban.<verse eid="PRO 24:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PRO 24:28" />Madimurehabá wuriba luagu gürigia bíledi marichaga,</para>
  <para style="q" vid="PRO 24:28">machoururun buguyame katei le mámabei ligía.<verse eid="PRO 24:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="PRO 24:29" />Masaminarabá bafayeiruni wuribani le ladügübei amu bun,</para>
  <para style="q" vid="PRO 24:29">lau badügüni wuribaniméme ligía lun.<verse eid="PRO 24:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="PRO 24:30" />Sügütina licharirugugiñe le magúalibei,</para>
  <para style="q" vid="PRO 24:30">luma lubeibein-ágeirugugiñe le lóuguabei gunfuranda lan<verse eid="PRO 24:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 24:31" />Le narihubei, aban fulasu buin lau hiiyu,</para>
  <para style="q" vid="PRO 24:31">lau layaraawagun le lauti dübü héiguañu.<verse eid="PRO 24:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 24:32" />Dan narihinbalin katei le,</para>
  <para style="q" vid="PRO 24:32">aba nareiduni nichügüwagu;</para>
  <para style="q" vid="PRO 24:32">ariha numuti, aba nafurendeiruni katei le:<verse eid="PRO 24:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 24:33" />Sun abunha lan áriha luma gewenedü,</para>
  <para style="q" vid="PRO 24:33">ani cháguabei barüna lun barumuguntima buidu,<verse eid="PRO 24:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 24:34" />liábinba gudemei ábame lageindagun buma</para>
  <para style="q" vid="PRO 24:34">keisi aban éibugañahadügüti le gárumateti.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="ms">VI. Lererun Burí Salomón Le Lóundaraguagüdübei Esekíasi Le Lurúeite Hudá</para>
  <para style="mr">(<ref loc="PRO 25:1-29:27">25.1—29.27</ref>)</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 25:1" />Anihán le, lariñagun burí giñe Salomón,</para>
  <para style="q" vid="PRO 25:1">le habürühabei gürigia ha eseriwidubaña lun Esekíasi le lurúeite Hudá.<verse eid="PRO 25:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 25:2" />Luéirigun Bungiu anihein lan katei aramudaguati luma,</para>
  <para style="q" vid="PRO 25:2">inebesei lun urúei lasubudiruni katei aramudaguati ligía.<verse eid="PRO 25:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PRO 25:3" />Liñun sielu,</para>
  <para style="q" vid="PRO 25:3">lilulin ubóu,</para>
  <para style="q" vid="PRO 25:3">luma hasaminan urúeigu,</para>
  <para style="q" vid="PRO 25:3">siñati lachülürǘniwa lumoun.<verse eid="PRO 25:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PRO 25:4" />Gidabei le mabuidunbei luagu pülata</para>
  <para style="q" vid="PRO 25:4">ábame ladügün nadagimeinti pülata aban kopu;<verse eid="PRO 25:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 25:5" />Gidabaña gürigia ha salufuribaña lídangiñe eseriwiduni lun urúei,</para>
  <para style="q" vid="PRO 25:5">ábame derebugu lan larúeihan lidan richaguaü.<verse eid="PRO 25:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 25:6" />Manaaguabá bungua weiri ligibugiñe urúei,</para>
  <para style="q" vid="PRO 25:6">manügünbeime giñe habara gürigia wéirigutiña;<verse eid="PRO 25:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 25:7" />buítimati lun bamisurahóun lun bawarirun,</para>
  <para style="q" vid="PRO 25:7">sügǘ lau banügǘn ǘnabun hagibugiñe gürigia wéirigutiña.</para>
  <para style="b" vid="PRO 25:7" />
  <para style="q" vid="PRO 25:7">Katei le barihubei lau bagu,<verse eid="PRO 25:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 25:8" />móufudahaba ñüdün ariñagei ligibugiñe aguseragüdüti,</para>
  <para style="q" vid="PRO 25:8">luéi liabin amu gefenti,</para>
  <para style="q" vid="PRO 25:8">lariñagame luagu biyeeni lan,</para>
  <para style="q" vid="PRO 25:8">ibidiñemeti bun kaba lan badüga.<verse eid="PRO 25:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PRO 25:9" />Badimureha buéigiñegua ligibugiñe le íchuguti bidurun,</para>
  <para style="q" vid="PRO 25:9">gama lumoun madimurehabá luagu katei aramudaguati le hani amu;<verse eid="PRO 25:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 25:10" />ladüga gayaraati laganbunibu amu ábame lígirunibu lidan busiganu;</para>
  <para style="q" vid="PRO 25:10">ábame máranina lan luriban ladimurehoun buagu.<verse eid="PRO 25:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 25:11" />Dimurei le ariñawaguti lidan dan;</para>
  <para style="q" vid="PRO 25:11">ítara liña kei mansana lautu golu lidan pülata.<verse eid="PRO 25:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PRO 25:12" />Ítara liña ladagarun ererehóuni houn ha ánhabaña heresibiruni</para>
  <para style="q" vid="PRO 25:12">keisi aban bagü luma aban iñari le lauti golu le fínutimabei.<verse eid="PRO 25:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 25:13" />Ítara haña óunagüleigu ha gúnfulibaña buidu houn ha óunahabaliña</para>
  <para style="q" vid="PRO 25:13">kei lidili niewe lidan lidaani lárouga,</para>
  <para style="q" vid="PRO 25:13">rútiña iseri gurasu lun hayubudiri.<verse eid="PRO 25:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PRO 25:14" />Ítara haña ha ariñagubaña luagu híchuguba lan ani míchutiña ni kata,</para>
  <para style="q" vid="PRO 25:14">kei lesetirun huya ani máhuyunti.<verse eid="PRO 25:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 25:15" />Gáluma lumuti gurasu igañi,</para>
  <para style="q" vid="PRO 25:15">günringua lumuti dimurei huáliti éregu.<verse eid="PRO 25:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PRO 25:16" />Ánhabu adarira sírudu,</para>
  <para style="q" vid="PRO 25:16">matabá lóugiñe le lunbei bátuni,</para>
  <para style="q" vid="PRO 25:16">ladüga ánhabu ata saragu, bewerahabéi.<verse eid="PRO 25:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PRO 25:17" />Ánhabu ñüdün ebeluha lumoun bumada,</para>
  <para style="q" vid="PRO 25:17">mídinba sagü weyu,</para>
  <para style="q" vid="PRO 25:17">buchaliñein luagu bubá ábame biyereegudun lun.<verse eid="PRO 25:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PRO 25:18" />Ha adimurehabaña mámagu ligía hawagu hamadagu,</para>
  <para style="q" vid="PRO 25:18">ítara haña kei eféin luma kei gimara.<verse eid="PRO 25:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PRO 25:19" />Ítara liña lafiñerúniwa hawagu gürigia ha gagarabaaguaditiña lidan lidaani idiheri,</para>
  <para style="q" vid="PRO 25:19">kei leibugúniwa lau aban úrunaü halaguaali</para>
  <para style="q" vid="PRO 25:19">o leiginiwa lan lau aban ari fuduhali.<verse eid="PRO 25:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 25:20" />Ítara liña leremuhóun uremu houn gürigia ha láuñanu idiheri,</para>
  <para style="q" vid="PRO 25:20">kei lichugúniwa binigá luagun guméi</para>
  <para style="q" vid="PRO 25:20">o tagidarúniwa lan daüguaü lidan lidiliga.<verse eid="PRO 25:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 25:21" />Anhein lamá habéi báganiñu, ruba éigini houn;</para>
  <para style="q" vid="PRO 25:21">anhein mágürabu habéi, ruba duna houn;<verse eid="PRO 25:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 25:22" />ítara luba badügün lun léigaaguniña busiganu,</para>
  <para style="q" vid="PRO 25:22">ani lafayeirubei Bungiu bun.<verse eid="PRO 25:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PRO 25:23" />Ítara kei lanügün garabali nóruterugugiñeti huya,</para>
  <para style="q" vid="PRO 25:23">ítara liña tanügün iñeñein wuribatu luriban igibu.<verse eid="PRO 25:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PRO 25:24" />Buítimati laganóuniwa tarigeirugu muna,</para>
  <para style="q" vid="PRO 25:24">sügǘ lau tidan muna wéiritu</para>
  <para style="q" vid="PRO 25:24">tuma aban würi ganigitu wuribu.<verse eid="PRO 25:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PRO 25:25" />Keisi duna diliti lidan mágürabu,</para>
  <para style="q" vid="PRO 25:25">ítara liña lábürühan uganu buiti le dísegiñeti.<verse eid="PRO 25:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PRO 25:26" />Ítara haña gürigia maduruntiña</para>
  <para style="q" vid="PRO 25:26">ha adadagarubaña hagibugiñe ha gadurunbaña</para>
  <para style="q" vid="PRO 25:26">kei lísensen duna dagumeti.<verse eid="PRO 25:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PRO 25:27" />Wuribati latún saragu sírudu,</para>
  <para style="q" vid="PRO 25:27">gama lumoun buiti lachiahóun libügürü katei hénrenguti.<verse eid="PRO 25:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PRO 25:28" />Ítara haña gürigia ha mágüdaagunbaña houngua,</para>
  <para style="q" vid="PRO 25:28">kei uburugu mabarieirúnti.<verse eid="PRO 25:28" /></para>
  <para style="b" />
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 26:1" />Lichugún inebesei houn ibidiougua tau,</para>
  <para style="q" vid="PRO 26:1">ítara liña kei niewe lidan lubachouga,</para>
  <para style="q" vid="PRO 26:1">kei huya lidan lidaani alubahani.<verse eid="PRO 26:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PRO 26:2" />Íñaraguni le mébunabei, madagabei,</para>
  <para style="q" vid="PRO 26:2">ítara liña kei dunuru yuriguaali o le lan mádibuti.<verse eid="PRO 26:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PRO 26:3" />Gasu labeichún ibidiougua tau,</para>
  <para style="q" vid="PRO 26:3">kéisigubeirügü gasu lan lamasurun gabayu,</para>
  <para style="q" vid="PRO 26:3">rúa ligía furenu luagu burigü.<verse eid="PRO 26:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PRO 26:4" />Anhein móunabun ban ibidiougua tau,</para>
  <para style="q" vid="PRO 26:4">mabidiouniganti bau.<verse eid="PRO 26:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 26:5" />Ánhaña bóunaba ibidiougua tau,</para>
  <para style="q" vid="PRO 26:5">ítara biña giñe kei hagía.<verse eid="PRO 26:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 26:6" />Lounahóun uganu hama ibidiougua tau,</para>
  <para style="q" vid="PRO 26:6">ítara liña kei lachugúniwa ugudi,</para>
  <para style="q" vid="PRO 26:6">áluahoua ligía turobuli.<verse eid="PRO 26:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 26:7" />Madiseti léibugun aban danimati lau lugudi,</para>
  <para style="q" vid="PRO 26:7">madiseti giñe léibugun ariñawagúni</para>
  <para style="q" vid="PRO 26:7">le hariñagun ibidiougua tau.<verse eid="PRO 26:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PRO 26:8" />Lichugúniwa inebesei houn ibidiougua tau,</para>
  <para style="q" vid="PRO 26:8">ítara liña kei lagüürǘniwa dübü tuagu ule.<verse eid="PRO 26:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PRO 26:9" />Ítara kei masandi hamani bacharuatiña límiruniña hiiyu,</para>
  <para style="q" vid="PRO 26:9">ítara liña ua lan gunfuranda hamá ibidiougua tau ariñawagúni.<verse eid="PRO 26:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 26:10" />Ítara haña ha íchugubaña wadagimanu</para>
  <para style="q" vid="PRO 26:10">houn ibidiougua tau hábiñe</para>
  <para style="q" vid="PRO 26:10">kei achüühatiña gimara ha esetirutu hagimaran</para>
  <para style="q" vid="PRO 26:10">luagun furumiñeguarügü ásügürüti.<verse eid="PRO 26:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 26:11" />Houya hamuti ounli hewerahan</para>
  <para style="q" vid="PRO 26:11">kei háguyuguagüdüni ibidiougua tau libidiounigan hau.<verse eid="PRO 26:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PRO 26:12" />Agurabúati katei hámagiñe ibidiougua tau</para>
  <para style="q" vid="PRO 26:12">sügǘ lau hámagiñe ha haritaguabaña luagu chu lan hau.<verse eid="PRO 26:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 26:13" />Luéi hawadigimaridun ha magúalibaña,</para>
  <para style="q" vid="PRO 26:13">ariñagatiña luagu anihein lan aban liñún agurabahaña ǘmada.<verse eid="PRO 26:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PRO 26:14" />Kei ladaarun luma ladourun bena,</para>
  <para style="q" vid="PRO 26:14">ítara liña hagarabahan magúalitiña hagabananrugu.<verse eid="PRO 26:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 26:15" />Da hamuti magúalitiña háhabu lidoun asiedu</para>
  <para style="q" vid="PRO 26:15">gama lumoun siñá hamuti íchiga hayumulugun.<verse eid="PRO 26:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PRO 26:16" />Ha magúalibaña haritaguatiña hawougua luagu chu lan hau</para>
  <para style="q" vid="PRO 26:16">sügǘ hau sedü gürigia ha góunabaditiña.<verse eid="PRO 26:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PRO 26:17" />Bádaragun bungua lidoun hawuribun amu,</para>
  <para style="q" vid="PRO 26:17">kéisigubeirügü bárügüdün aban ounli luéigiñe larigei.<verse eid="PRO 26:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PRO 26:18" />Kei lülü tau ha achüühatiña</para>
  <para style="q" vid="PRO 26:18">gimara lautu watu gemeti,<verse eid="PRO 26:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 26:19" />ítara haña ha eyeedagutiña hamadagu,</para>
  <para style="q" vid="PRO 26:19">lárigiñe aba hariñagun luagu háhurerarügüña lan hama.<verse eid="PRO 26:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 26:20" />Anhein mabúa watu, léñeguchuba,</para>
  <para style="q" vid="PRO 26:20">anhein ua marasualugu, lagumuchaguba wuribu.<verse eid="PRO 26:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 26:21" />Garubun lun ladügǘn eñeguraü,</para>
  <para style="q" vid="PRO 26:21">ílemei lun ladügǘn watu gemeti,</para>
  <para style="q" vid="PRO 26:21">le ganigibei wuribu, lun ladügǘn wuribu.<verse eid="PRO 26:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PRO 26:22" />Ítara liña marasualugu kei libimen-agei éigini,</para>
  <para style="q" vid="PRO 26:22">gama lumoun chülüti lidoun lilulin agei.<verse eid="PRO 26:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PRO 26:23" />Ítara liña dimurei huáliti le ariñawagúbei lau luriban aritaguni,</para>
  <para style="q" vid="PRO 26:23">kei sóudieru lauti múa le ouburúati lau pülata.<verse eid="PRO 26:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PRO 26:24" />Ha iyereehabúbaña,</para>
  <para style="q" vid="PRO 26:24">aramuda hamuti hayereehabu dan hadimurehan,</para>
  <para style="q" vid="PRO 26:24">gama lumoun adaaguatiña luriban aransehani hádangua.<verse eid="PRO 26:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PRO 26:25" />Mafiñerabá houn ánhaña adimureha bun lau idilini,</para>
  <para style="q" vid="PRO 26:25">ladüga buin liña hasaminan lau wuribani;<verse eid="PRO 26:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 26:26" />íbini houchun haramuduni hayereehabu,</para>
  <para style="q" vid="PRO 26:26">harihubei sun gürigia hariban.<verse eid="PRO 26:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PRO 26:27" />Ha achigitiña aban huyu, héiguaduba lidoun,</para>
  <para style="q" vid="PRO 26:27">ha abalabahatiña aban dübü, laburechagubaña dübü ligía.<verse eid="PRO 26:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PRO 26:28" />Iyereeguti inarüni houn yéetiña;</para>
  <para style="q" vid="PRO 26:28">ha dilibaña adimurehan barütiña chagaguaü.<verse eid="PRO 26:28" /></para>
  <para style="b" />
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 27:1" />Mapantahabá luagu weyu le harugabei,</para>
  <para style="q" vid="PRO 27:1">ibidiñeti bun kaba lan lanüga.<verse eid="PRO 27:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PRO 27:2" />Madimurehabá buiti buougua,</para>
  <para style="q" vid="PRO 27:2">ígiraba lun amu lan adimureha buiti buagu.<verse eid="PRO 27:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PRO 27:3" />Hǘrüti dübü luma sagoun,</para>
  <para style="q" vid="PRO 27:3">gama lumoun hǘrütimati ligañi ibidiougua tau.<verse eid="PRO 27:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PRO 27:4" />Wuribati igañi, gagünrinchaguadi ligía asafaraguni,</para>
  <para style="q" vid="PRO 27:4">gama lumoun mágüdahouati emeidini.<verse eid="PRO 27:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PRO 27:5" />Buítimati adeinhani lau furangu</para>
  <para style="q" vid="PRO 27:5">sügǘ lau ínsiñeni le aramudaguati.<verse eid="PRO 27:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 27:6" />Gayaraatimati lemenigidúniwa hawagu umadagu ha agañidagüdütiña</para>
  <para style="q" vid="PRO 27:6">sügǘ lau hawagu áganiñu ha achuuhatiña.<verse eid="PRO 27:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 27:7" />Ha kimulebaña, íbini lau sírudu meberesentiña,</para>
  <para style="q" vid="PRO 27:7">ánhaña ha lamabaña, íbini katei le gífiti, bímeti houn.<verse eid="PRO 27:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PRO 27:8" />Ítara haña ha dísebaña luéi fulasu le ñein lubéi hágurahoua</para>
  <para style="q" vid="PRO 27:8">kei dunuru to áhamahaboun dise luéi tumasa.<verse eid="PRO 27:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PRO 27:9" />Ibiñein buiti, lun tagundaarun anigi,</para>
  <para style="q" vid="PRO 27:9">leweridihan umadaü, lun tabimedun uani.<verse eid="PRO 27:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 27:10" />Mígirabaña bumadagu, ni lumadagu búguchi.</para>
  <para style="b" vid="PRO 27:10" />
  <para style="q" vid="PRO 27:10">Mídinba lau bani turobuli lúbiñoun bíbiri.</para>
  <para style="b" vid="PRO 27:10" />
  <para style="q" vid="PRO 27:10">Buítimati besinu yarafati sügǘ lau íbiri díseti.<verse eid="PRO 27:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 27:11" />Chula bau, niráü, ábame bagundaaragüdünina;</para>
  <para style="q" vid="PRO 27:11">ítara luba gayara lan nóunabuniña ha anabagutina.<verse eid="PRO 27:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PRO 27:12" />Ha buídubaña ichügü,</para>
  <para style="q" vid="PRO 27:12">harihini denchaü aba hegeyedun luéi,</para>
  <para style="q" vid="PRO 27:12">ánhaña ha mabuidunbaña ichügü,</para>
  <para style="q" vid="PRO 27:12">ñǘdüntiña habaruaguóun aba hasufuriruni damichi.<verse eid="PRO 27:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 27:13" />Ha anügütiña hadúeihan terencha hawouguoun,</para>
  <para style="q" vid="PRO 27:13">gidawatá hadaüragun hawéi darí hafayeihan.<verse eid="PRO 27:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PRO 27:14" />Labusurúniwa lun umadaü lau umalali héreti lubá larugan,</para>
  <para style="q" vid="PRO 27:14">ítara liña lun kei anabúni.<verse eid="PRO 27:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 27:15" />Ítara tiña aban würi ganigitu wuribu</para>
  <para style="q" vid="PRO 27:15">kei lédedehan duna lidan húyouga lan.<verse eid="PRO 27:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PRO 27:16" />Báluahan bararamunu,</para>
  <para style="q" vid="PRO 27:16">kéisigubeirügü báluahan bararamuni garabali</para>
  <para style="q" vid="PRO 27:16">o bárügüdün garaba búhaburugu.<verse eid="PRO 27:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PRO 27:17" />Hámagiñegua gürigia hafurendeira,</para>
  <para style="q" vid="PRO 27:17">kéisigubeirügü lau lan gürabu layarahóua gürabu.<verse eid="PRO 27:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PRO 27:18" />Ha óunigirutiña tídibu igu, hóutiña tídangiñe tin,</para>
  <para style="q" vid="PRO 27:18">Ha óunigirutiña hayubudirigu ibihatiña uéiriguni.<verse eid="PRO 27:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PRO 27:19" />Ítara kei arihúa tan liyawa igibu dúnarugu,</para>
  <para style="q" vid="PRO 27:19">ítara liña giñe aríagua hamá gürigia houngua tidan hanigi.<verse eid="PRO 27:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 27:20" />Óunweni, umúahaü luma luámaahabu gürigia, magufurumadaditi,</para>
  <para style="q" vid="PRO 27:20">súnwandan busenmémegili lan.<verse eid="PRO 27:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 27:21" />Lau watu gemeti louchúa golu luma pülata,</para>
  <para style="q" vid="PRO 27:21">ánhañati gürigia lau ladimurehoun buidu hawagu houchúa.<verse eid="PRO 27:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PRO 27:22" />Ha ibidiouguabaña aau,</para>
  <para style="q" vid="PRO 27:22">magidabei libidiounigan hau ni ánhaña bamuligida, muliliyabáñame.<verse eid="PRO 27:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PRO 27:23" />Subudibéi hawaguti bilügüniña mudún,</para>
  <para style="q" vid="PRO 27:23">góunigibaña bibiñanigu,<verse eid="PRO 27:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 27:24" />ladüga ni irisini ni ridi,</para>
  <para style="q" vid="PRO 27:24">madurati lun sun dan.<verse eid="PRO 27:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 27:25" />Danme labouchun sagadi le heigan mudún,</para>
  <para style="q" vid="PRO 27:25">danme labudahóun híduru áraabugiñe,<verse eid="PRO 27:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 27:26" />bibihuba lura mudún hádangiñe bibiñanigu tun badaüragun,</para>
  <para style="q" vid="PRO 27:26">gaseinsunbadibu giñe hádangiñe bilügüniña gábara lun bagañeihan bumúan.<verse eid="PRO 27:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 27:27" />Bibihuba giñe míligi hádangiñe gábara würiña</para>
  <para style="q" vid="PRO 27:27">lun batun hau sun biduheñu hama sun bubueingu.<verse eid="PRO 27:27" /></para>
  <para style="b" />
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 28:1" />Anurahatiña ha salufuribaña íbini méibaahouniwa hamá,</para>
  <para style="q" vid="PRO 28:1">ánhaña ha richaguabaña hemenigitiña kei aban liñún.<verse eid="PRO 28:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PRO 28:2" />Dan le wuriba lan lidin katei fulasurugu,</para>
  <para style="q" vid="PRO 28:2">aba haganwoundun gumadimatiña,</para>
  <para style="q" vid="PRO 28:2">gama lumoun alidihatiña ha buídubaña</para>
  <para style="q" vid="PRO 28:2">barǘ hamuti katei kei lubudubu.<verse eid="PRO 28:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PRO 28:3" />Gürigia salufuritiña ha agüreweidubaliña gudemetiña,</para>
  <para style="q" vid="PRO 28:3">ítara haña kei huya héreti le agünrinchagubalin alubahani.<verse eid="PRO 28:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PRO 28:4" />Ha adireirubaña luéi lúrudu, hámagiñeñanu ha salufuribaña;</para>
  <para style="q" vid="PRO 28:4">ánhaña ha agunfulirubalin, háganiñanu ha salufuribaña.<verse eid="PRO 28:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PRO 28:5" />Úati gunfuranda hamani gürigia ha wuribabaña richaguaü,</para>
  <para style="q" vid="PRO 28:5">ánhaña ha áluahabalin Bungiu, gunfuranda hamuti buidu.<verse eid="PRO 28:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 28:6" />Buítimati lun gudeme ban ani harumatibu</para>
  <para style="q" vid="PRO 28:6">sügǘ lau lun risi ban ani wuribati bisaminan.<verse eid="PRO 28:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 28:7" />Ha agunfulirutiña lilurudun Bungiu,</para>
  <para style="q" vid="PRO 28:7">isaanigu huali tichügü hagía,</para>
  <para style="q" vid="PRO 28:7">ánhañati ha éibugutiña hama wéinamu teigin,</para>
  <para style="q" vid="PRO 28:7">busiganu hagía houn hagübürigu.<verse eid="PRO 28:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PRO 28:8" />Ha añoundagutiña irisini lau haguburahan luagu lafuredeirúniwa seinsu,</para>
  <para style="q" vid="PRO 28:8">hañoundaguñein habá ha gudemehabubaña.<verse eid="PRO 28:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PRO 28:9" />Ánhaña maha gürigia hadügün gasu lau lilurudun Bungiu,</para>
  <para style="q" vid="PRO 28:9">maganbun lubéi giñe Bungiu hafurieidun.<verse eid="PRO 28:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 28:10" />Ha anügütiña gürigia buítiña lidoun üma wuribati,</para>
  <para style="q" vid="PRO 28:10">hábürühaba tidoun guánarügü hasadaran;</para>
  <para style="q" vid="PRO 28:10">ánhañati gürigia buítiña hibihubei le buídutimabei.<verse eid="PRO 28:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 28:11" />Ha rísibaña haritaguatiña luagu chu lan hau,</para>
  <para style="q" vid="PRO 28:11">gama lumoun gunfuranda hamutiña ha gudemebaña ani huali ligía hachügü.<verse eid="PRO 28:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PRO 28:12" />Dan hagañeirun ha richaguabaña, adügǘwati óunwenbu fedu,</para>
  <para style="q" vid="PRO 28:12">dan hagañeirun ha wuribabaña aramudaguatiña gürigia.<verse eid="PRO 28:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 28:13" />Ha adouragutiña lau hafigoun, mídinbei houn buidu,</para>
  <para style="q" vid="PRO 28:13">ánhaña ha agufeserútiña hafigoun, aba hígiruni,</para>
  <para style="q" vid="PRO 28:13">feruduna lubaña Bungiu.<verse eid="PRO 28:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PRO 28:14" />Fuleseiwatiña gürigia ha íchugubaña inebesei lun Bungiu súnwandan,</para>
  <para style="q" vid="PRO 28:14">ánhañati ha derebaña anigi hábürühaba lidoun lamiselu.<verse eid="PRO 28:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 28:15" />Ítara haña gürigia salufuritiña ha agumadihabaña lidan aban fulasu gudemeti,</para>
  <para style="q" vid="PRO 28:15">kei aban liñún o aban osu gáñiti.<verse eid="PRO 28:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PRO 28:16" />Agumadihatiña ha lóuguabei gunfuranda hamá,</para>
  <para style="q" vid="PRO 28:16">gánwoungüda hamuti lidere dan,</para>
  <para style="q" vid="PRO 28:16">ánhañati ha mawamaahabúbaña migifebei habagari.<verse eid="PRO 28:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PRO 28:17" />Ha áfarahaañabaña, mararamunbaña darí hábürühan lidoun umúahaü,</para>
  <para style="q" vid="PRO 28:17">ua hamatia áfaagutiña hararamuniña!<verse eid="PRO 28:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PRO 28:18" />Gürigia ha harumabaña hesefuruba,</para>
  <para style="q" vid="PRO 28:18">ánhaña ha salufuribaña hábürühaba lidoun lamiselu.<verse eid="PRO 28:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PRO 28:19" />Ha ábunagutiña hachari, ígiraguati éigini houn,</para>
  <para style="q" vid="PRO 28:19">ánhañati ha éibugutiña hama magúalitiña, gudemei ígiragubei houn.<verse eid="PRO 28:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 28:20" />Gürigia ha hemenigiwati hawagu, ladimurehóuba buiti hawagu;</para>
  <para style="q" vid="PRO 28:20">ánhaña ha afuudubaña luagu irisini, meredebaña mabeichúnga.<verse eid="PRO 28:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 28:21" />Mabuidunti lanügǘn aban gürigia ǘnabu luéi le aban;</para>
  <para style="q" vid="PRO 28:21">gayaraati hafigouhan gürigia íbini tuagu murusun fein.<verse eid="PRO 28:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PRO 28:22" />Ha igaaduabaña, afuresehatiña lun harisidun,</para>
  <para style="q" vid="PRO 28:22">gama lumoun ibidiñeti houn luagu lábürühaba lan gudemei hawagun.<verse eid="PRO 28:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PRO 28:23" />Luagu lílüwagu dan, hínsiñegutimati le gachurahadibei</para>
  <para style="q" vid="PRO 28:23">sügǘ hau ha adimurehabaña lau abimehani.<verse eid="PRO 28:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PRO 28:24" />Ítara haña ha íweruhatiña hawéi hagübürigu</para>
  <para style="q" vid="PRO 28:24">ani hariñaga luagu mama lan wuribati,</para>
  <para style="q" vid="PRO 28:24">kei hamadagu gáfarahatiña.<verse eid="PRO 28:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PRO 28:25" />Ha igaaduabaña, ageindaguagüdatiña,</para>
  <para style="q" vid="PRO 28:25">ánhañati ha hemenigibaña luagu Bungiu, hawanseruba.<verse eid="PRO 28:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PRO 28:26" />Hárügüñanu ibidiougua tau emenigida luagu haritagun guánarügü,</para>
  <para style="q" vid="PRO 28:26">ha adügütiña katei lau lichú aau, hawanseruba.<verse eid="PRO 28:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PRO 28:27" />Ha íderagutiña gudemetiña, memegeirúnbaña ni kata;</para>
  <para style="q" vid="PRO 28:27">ánhaña ha máhatiña híderaguniña, híñarawaguba saragu.<verse eid="PRO 28:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PRO 28:28" />Dan hagañeirun salufuritiña, aramudaguatiña gürigia;</para>
  <para style="q" vid="PRO 28:28">dan le hagumuchagun, aba hagibedagun richaguatiña.<verse eid="PRO 28:28" /></para>
  <para style="b" />
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 29:1" />Ha madügünbaña gasu dan le ladeinhóun houn,</para>
  <para style="q" vid="PRO 29:1">hagünrinchawaguba madise.<verse eid="PRO 29:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PRO 29:2" />Dan le hagibedagun richaguatiña, gúndaatiña gürigia;</para>
  <para style="q" vid="PRO 29:2">dan le hagumadihan wuribatiña, súfuritiña gürigia.<verse eid="PRO 29:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PRO 29:3" />Isaanigu ha chúbaña aau, gúndaagüda hamuti háguchi,</para>
  <para style="q" vid="PRO 29:3">ánhaña ha éibugutiña hama horu, chagá hamuti seinsu.<verse eid="PRO 29:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PRO 29:4" />Urúeigu ha richati hagumadihan, derebugugüda hamuti hageira;</para>
  <para style="q" vid="PRO 29:4">ánhaña ha aguburaharügübaña liseinsuna gumadi, günringua hamuti.<verse eid="PRO 29:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PRO 29:5" />Ha adimurehatiña buiti hawagu hamadagu súnwandan,</para>
  <para style="q" vid="PRO 29:5">hesetiruña aban sádara habá.<verse eid="PRO 29:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 29:6" />Hafigoun guánarügü gürigia salufuritiña hasadaranboun;</para>
  <para style="q" vid="PRO 29:6">ánhañati gürigia harumatiña gúndaati habagaridun.<verse eid="PRO 29:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 29:7" />Ha richaguabaña beresetiña lau haricha gudemetiña;</para>
  <para style="q" vid="PRO 29:7">ánhañati ha salufuribaña, meberesentiña ni ka au.<verse eid="PRO 29:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PRO 29:8" />Ha achagaraguagüdübaña gürigia, hingí hamuti fulasu;</para>
  <para style="q" vid="PRO 29:8">ha chúbaña aau gagalumahaditiña.<verse eid="PRO 29:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PRO 29:9" />Chútiña aau ha awuribuhatiña hama ibidiougua tau,</para>
  <para style="q" vid="PRO 29:9">hagañiduba, adaawaguame bula hau, ani maranserunbaña ni kata.<verse eid="PRO 29:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 29:10" />Iyereegutiña gürigia harumatiña houn ha gáfarahadibaña.<verse eid="PRO 29:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 29:11" />Ha ibidiouguabaña aau,</para>
  <para style="q" vid="PRO 29:11">falaguatiña houngua luma hagañi;</para>
  <para style="q" vid="PRO 29:11">ánhañati ha chúbaña aau, gáluma hamuti.<verse eid="PRO 29:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PRO 29:12" />Agumadihatiña ha adügütiña gasu lau iyeeni,</para>
  <para style="q" vid="PRO 29:12">gadei hamutiña sun ha eseriwidubaña houn.<verse eid="PRO 29:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PRO 29:13" />Ha gudemebaña hama ha agüreweidubaliña gudemetiña,</para>
  <para style="q" vid="PRO 29:13">anihein aban katei ábanti labu hawagu:</para>
  <para style="q" vid="PRO 29:13">Bungiu lan íchugubei arihini houn biángubei hagía.<verse eid="PRO 29:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PRO 29:14" />Urúeigu ha agumadirubaliña gudemetiña lau úarani,</para>
  <para style="q" vid="PRO 29:14">derebugugüda hamuti harúeihan lun súnwandan.<verse eid="PRO 29:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 29:15" />Lau abeichúni luma ebechúni hafurendeira gürigia,</para>
  <para style="q" vid="PRO 29:15">ánhañati isaanigu ha wéiriyati hínsiñegu rútiña busiganu tun háguchu.<verse eid="PRO 29:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PRO 29:16" />Ánhaña gibe salufuritiña, gíbebei giñe figóu;</para>
  <para style="q" vid="PRO 29:16">gama lumoun harihubei ha harumabaña heferidirun ha wuribabaña.<verse eid="PRO 29:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PRO 29:17" />Ererehabá lun biráü ábame darangila lan babagaridun,</para>
  <para style="q" vid="PRO 29:17">líchuguba saragu ugundani bun.<verse eid="PRO 29:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PRO 29:18" />Le ñein lumuti ua lan lagumadihan Bungiu,</para>
  <para style="q" vid="PRO 29:18">úati katei buiti ñein;</para>
  <para style="q" vid="PRO 29:18">fuleseiwatiña néchanigu ha agunfulirutiña lilurudun Bungiu!<verse eid="PRO 29:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PRO 29:19" />Mererehóunti houn idamuni lau dimurei,</para>
  <para style="q" vid="PRO 29:19">ladüga gunfurandatiña gama lumoun madügüntiña gasu.<verse eid="PRO 29:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 29:20" />Sagawati katei buiti hádangiñe ibidiougua tau</para>
  <para style="q" vid="PRO 29:20">sügǘ lau hádangiñe ha masaminarunbaña lubá hadimurehan.<verse eid="PRO 29:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 29:21" />Anhein bíchiga sun labusenrun bidamun lun lúmagiñe liñüraü,</para>
  <para style="q" vid="PRO 29:21">lachülürüba dan lun basakürihani.<verse eid="PRO 29:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PRO 29:22" />Gürigia ha gañi gáñibaña, agubuhatiña wuribu,</para>
  <para style="q" vid="PRO 29:22">ani adügatiña saragu katei le moun lumuti.<verse eid="PRO 29:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PRO 29:23" />Ha íñugubaña anaagun ungua rarigüdawatiña,</para>
  <para style="q" vid="PRO 29:23">ha ǘnabugubaña ibihatiña uéiriguni.<verse eid="PRO 29:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PRO 29:24" />Ha úaradutiña hama híwerutiña, mínsiñeguatiña houngua,</para>
  <para style="q" vid="PRO 29:24">íbini híñarawagun, magufeserunbaña.<verse eid="PRO 29:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PRO 29:25" />Ítara liña anufudei houn gürigia kei aban sádara,</para>
  <para style="q" vid="PRO 29:25">ánhaña ha hemenigibaña luagu Bungiu, góunigiwatiña.<verse eid="PRO 29:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PRO 29:26" />Saraguhaña áluahatiña hafulesein gumadimatiña,</para>
  <para style="q" vid="PRO 29:26">gama lumoun Búngiurügüñein richá aguseragüdün.<verse eid="PRO 29:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PRO 29:27" />Mínsiñetiña gürigia salufuritiña houn gürigia harumatiña,</para>
  <para style="q" vid="PRO 29:27">ha salufuribaña, mínsiñetiña ha harumabaña houn.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="ms">Lererun Aguru</para>
  <para style="mr">(<ref loc="PRO 30:1-33">30.1-33</ref>)</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 30:1" />Lererun burí Aguru le liráü Haké le Masaana.</para>
  <para style="q" vid="PRO 30:1">Ítara liña ladimurehan Aguru lun Itieli luma lun Ukali:<verse eid="PRO 30:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PRO 30:2" />Au ibidiouguatimabei aau hadan wügüriña,</para>
  <para style="q" vid="PRO 30:2">úati gunfurandaü le hani gürigia nidan.<verse eid="PRO 30:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 30:3" />Márügüdüngidina lichú aau,</para>
  <para style="q" vid="PRO 30:3">ibidiñeti ni kata luáguti le Sándutimabei nun.<verse eid="PRO 30:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 30:4" />Kagia amudeirubei sielun ábaya lararirun?</para>
  <para style="q" vid="PRO 30:4">Kagia gayaraabei lárügüdüni garabali lúhaburugu?</para>
  <para style="q" vid="PRO 30:4">Kagia óuburagubalin barana lidan lagei?</para>
  <para style="q" vid="PRO 30:4">Kagia amisurahabalin leben ubóu?</para>
  <para style="q" vid="PRO 30:4">Kagia liri, kagia liri liráü? Ma ibidiñeti bun!<verse eid="PRO 30:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PRO 30:5" />Góunigi lumutiña Bungiu ha hemenigibaña luagu,</para>
  <para style="q" vid="PRO 30:5">gayaraati lafiñerúniwa luagu le füramase lubéi.<verse eid="PRO 30:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 30:6" />Míchigaba ni kata lanwoun le lariñagun,</para>
  <para style="q" vid="PRO 30:6">ébecha liñalibu, ábame berederun kei yeeti.<verse eid="PRO 30:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PRO 30:7" />Biánrügüñein katei namuriahan buma Nubungiute,</para>
  <para style="q" vid="PRO 30:7">rubei nun lubaragiñe nounwen:<verse eid="PRO 30:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 30:8" />Dísegüdabei iyeeni nuéi,</para>
  <para style="q" vid="PRO 30:8">marisidagüdabana magudemedagüdün báname,</para>
  <para style="q" vid="PRO 30:8">rubei lérügü nemegeirun nun;<verse eid="PRO 30:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 30:9" />ladüga anhein gíbeya numa,</para>
  <para style="q" vid="PRO 30:9">gayaraati nabulieidagun buéi,</para>
  <para style="q" vid="PRO 30:9">nariñagame luagu ibidiñe ban nun;</para>
  <para style="q" vid="PRO 30:9">o ánhana lan emegeira ábame níweruhan</para>
  <para style="q" vid="PRO 30:9">anabagueime biri le wéirigubei.<verse eid="PRO 30:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PRO 30:10" />Madimurehabá wuriba luagu idamuni ligibugiñe labureme,</para>
  <para style="q" vid="PRO 30:10">íñaragualiñalibu ábame basufurirun luagu lira.<verse eid="PRO 30:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PRO 30:11" />Añahein gürigia íñaragua hamuti háguchi,</para>
  <para style="q" vid="PRO 30:11">ani mabinirun hamutu háguchu.<verse eid="PRO 30:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 30:12" />Añahein aritagutiña luagu haruma hamá</para>
  <para style="q" vid="PRO 30:12">ani marumadungiña lídangiñe hawiye.<verse eid="PRO 30:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 30:13" />Añahein aritagutiña luagu wéirigu hamá,</para>
  <para style="q" vid="PRO 30:13">ani harihaña híbiri gürigia kei ni kata.<verse eid="PRO 30:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 30:14" />Añahein ítarati hari kamá eféin tuma gusiñu</para>
  <para style="q" vid="PRO 30:14">lun hagumuchun hau gürigia gudemetiña.<verse eid="PRO 30:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 30:15" />Biámañanu tirahüñü gátaatu hitaü,</para>
  <para style="q" vid="PRO 30:15">ha ariñagubaña: «Ruba nun, ruba nun».</para>
  <para style="b" vid="PRO 30:15" />
  <para style="q" vid="PRO 30:15">Anihein gádürü katei makimuledaditi.<verse eid="PRO 30:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 30:16" />Umuahaü,</para>
  <para style="q" vid="PRO 30:16">würi maraüheitu,</para>
  <para style="q" vid="PRO 30:16">múa mábeiti</para>
  <para style="q" vid="PRO 30:16">luma watu gemeti.<verse eid="PRO 30:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PRO 30:17" />Ha íchugutiña mebereseni lau háguchi,</para>
  <para style="q" vid="PRO 30:17">adüga hagía bula tau háguchu,</para>
  <para style="q" vid="PRO 30:17">gadünatiña lun hachigini sanadi hagu luma lun héiginiña ágila.<verse eid="PRO 30:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PRO 30:18" />Anihein gádürü katei wéiritu nanigi lau</para>
  <para style="q" vid="PRO 30:18">ani úati gunfuranda nani.<verse eid="PRO 30:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 30:19" />Témeri ágila sielu,</para>
  <para style="q" vid="PRO 30:19">témeri hewe luagu dübü,</para>
  <para style="q" vid="PRO 30:19">témeri waporu baranaha</para>
  <para style="q" vid="PRO 30:19">luma lémeri wügüri tuagu würi.<verse eid="PRO 30:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PRO 30:20" />Anihán katei le tadügübei würi to gagabarahadiboun:</para>
  <para style="q" vid="PRO 30:20">Teigin, taragachuni tiyuma,</para>
  <para style="q" vid="PRO 30:20">lárigiñe tariñaga luagu madügün tan ni kata wuribati.<verse eid="PRO 30:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PRO 30:21" />Añahein gádürü hawuyeri gürigia mawandúntiña,</para>
  <para style="q" vid="PRO 30:21">adadagaragüda hamuti fulasu:<verse eid="PRO 30:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 30:22" />Idamuni le achülürüti arúeiha,</para>
  <para style="q" vid="PRO 30:22">ibidiougua tau le ígiraguati éigini luma,<verse eid="PRO 30:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 30:23" />würi meberesenwaali tau to adarirutu túmari</para>
  <para style="q" vid="PRO 30:23">tuma idamuni to árügüdüti tubara tabureme.<verse eid="PRO 30:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PRO 30:24" />Añahein gádürü harahüñü animaalugu ubouagu</para>
  <para style="q" vid="PRO 30:24">chuti hau sügǘ hau chu tau:<verse eid="PRO 30:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 30:25" />Haü, saraguhaña ani méretiña,</para>
  <para style="q" vid="PRO 30:25">gama lumoun óundaragua hamuti heigin irumurugu;<verse eid="PRO 30:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 30:26" />másaraga, míbetiña animaalugu hagía</para>
  <para style="q" vid="PRO 30:26">labadinagua dübü haganawa.<verse eid="PRO 30:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 30:27" />Chagagaru, lau sun marúeite hamá</para>
  <para style="q" vid="PRO 30:27">úarati héibugun;<verse eid="PRO 30:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 30:28" />gúnrenren, ñǘbüritiña,</para>
  <para style="q" vid="PRO 30:28">gayaraati lámurudawagun úhabu hau,</para>
  <para style="q" vid="PRO 30:28">ani lau sun lira ñǘdüntiña chülǘ tidoun lani urúei palasiu.<verse eid="PRO 30:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="PRO 30:29" />Añahein gádürü ganigitiña,</para>
  <para style="q" vid="PRO 30:29">hanarimeguti héibugun:<verse eid="PRO 30:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 30:30" />liñún, animaalu le hanarimetimabei,</para>
  <para style="q" vid="PRO 30:30">le manufudebei ni ka uei;<verse eid="PRO 30:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 30:31" />ariran le barüguabei ungua,</para>
  <para style="q" vid="PRO 30:31">gábara wügüri luma urúei le amarücharubei</para>
  <para style="q" vid="PRO 30:31">habá habá lisudaranigu.<verse eid="PRO 30:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="PRO 30:32" />Anhein barüguaadibu lubéi bungua weiri, le libidiounigan bau,</para>
  <para style="q" vid="PRO 30:32">ani aranseha buguya lagübüri aritaguni, saminabá<verse eid="PRO 30:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 30:33" />luagu anhein lan babadira míligi lasaliraguba lan bérume,</para>
  <para style="q" vid="PRO 30:33">anhein bahincha bígirugu here, laseñeinhaba,</para>
  <para style="q" vid="PRO 30:33">ánhabu agañidagüda gürigia lageindaguba buma.<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="ms">Lererun urúei Lemueli</para>
  <para style="mr">(<ref loc="PRO 31:1-9">31.1-9</ref>)</para>
  <para style="s1">Lererun Lemueli</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 31:1" />Lererun urúei Lemueli, le Masaana</para>
  <para style="q" vid="PRO 31:1">le tarufudahabei lúguchu lun:<verse eid="PRO 31:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PRO 31:2" />Niráü, lila nurageirugu,</para>
  <para style="q" vid="PRO 31:2">lóunabagüle Bungiu lun nayumuragun;</para>
  <para style="q" vid="PRO 31:2">ka amu gayaraabei nariñagun bun?<verse eid="PRO 31:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 31:3" />Mawesirabéi bere hama würiña,</para>
  <para style="q" vid="PRO 31:3">ladüga fériditiña urúeigu hadüga.<verse eid="PRO 31:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 31:4" />Mabuidunti giñe, Lemueli niráü,</para>
  <para style="q" vid="PRO 31:4">lun hatun urúeigu hama gumadimatiña diwéin luma uniñein héreti,<verse eid="PRO 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 31:5" />ladüga gayaraati habulieiduni lilurudun Bungiu</para>
  <para style="q" vid="PRO 31:5">dürügua hameime giñe haricha ha ǘnabugutimabaña.<verse eid="PRO 31:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PRO 31:6" />Ígiraboun diwéin luma uniñein héreti</para>
  <para style="q" vid="PRO 31:6">houn ha débilibaña hama ha maguraasunbaña;<verse eid="PRO 31:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 31:7" />gurá hamá bulíei hamaamugei hagudemen luma hasufurirun!<verse eid="PRO 31:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PRO 31:8" />Iñurabéi bumala haweigiñe ha siñabei hadimurehan;</para>
  <para style="q" vid="PRO 31:8">sefubáña ha siñabei hesefuragun houngua!<verse eid="PRO 31:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 31:9" />Inurabéi bumala, rubei haricha houn;</para>
  <para style="q" vid="PRO 31:9">sefubáña gudemetiña hama ǘnabugutiña!<verse eid="PRO 31:9" /></para>
  <para style="ms">Tuáguti Würi Buitu</para>
  <para style="mr">(<ref loc="PRO 31:10-31">31.10-31</ref>)</para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 31:10" />Würi buitu hénrenguti tadarirúniwa;</para>
  <para style="q" vid="PRO 31:10">gebegitu sügǘ lau dübü buíduburiti!<verse eid="PRO 31:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 31:11" />Afiñeti túmari tuagu le gumuti,</para>
  <para style="q" vid="PRO 31:11">ani magudemedaditi.<verse eid="PRO 31:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 31:12" />Rutu óunwenbu ugundani lun túmari sagü weyu.<verse eid="PRO 31:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 31:13" />Ñǘdüntu áluaha liyu mudún tuma gamisa fínutu</para>
  <para style="q" vid="PRO 31:13">lun tuadigimaridun lau ugundani.<verse eid="PRO 31:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 31:14" />Barütu heigin dísegiñe</para>
  <para style="q" vid="PRO 31:14">kamá waporu to anaahatu ilaü.<verse eid="PRO 31:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 31:15" />Saratu lubaragiñe larugadun,</para>
  <para style="q" vid="PRO 31:15">aba tíchugun éigini houn tirahüñü luma houn tumusuniña.<verse eid="PRO 31:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 31:16" />Aríaguatu aban fulasu, aba tagañeihani,</para>
  <para style="q" vid="PRO 31:16">lau le tagañeirubei aba tábunagun beibei.<verse eid="PRO 31:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 31:17" />Buin tiña lau iderebugu ani benefatu.<verse eid="PRO 31:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 31:18" />Góunigi tumuti marasun lun buídubei lan,</para>
  <para style="q" vid="PRO 31:18">nadagimeintu darí lumoun láriebudun.<verse eid="PRO 31:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 31:19" />Adaaguatu gamisa lau túhabu guánarügü.<verse eid="PRO 31:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 31:20" />Súnwandan tíderaguniña gudemetiña</para>
  <para style="q" vid="PRO 31:20">hama ha mégeihabubaña.<verse eid="PRO 31:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 31:21" />Madiheritu hawagu tiduheñu lidan lidaani lidiliga,</para>
  <para style="q" vid="PRO 31:21">ladüga sun hagía aransetiña lubá.<verse eid="PRO 31:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 31:22" />Tuguya guánarügü adügübarun hasidin,</para>
  <para style="q" vid="PRO 31:22">ani tifinun-agei gamisa tadaüragunboun.<verse eid="PRO 31:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 31:23" />Subudiwati túmari buidu buidu uburugu,</para>
  <para style="q" vid="PRO 31:23">ani hádanñein hátima inebewabaña fulasurugu.<verse eid="PRO 31:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 31:24" />Adaaguatu dúnigu luma béliti</para>
  <para style="q" vid="PRO 31:24">lun talugurahan houn ha adaagutiña marasun.<verse eid="PRO 31:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 31:25" />Buin tiña lau erei luma inebesei,</para>
  <para style="q" vid="PRO 31:25">ani madiheritu luagu weyu le harugabei.<verse eid="PRO 31:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 31:26" />Lau lichú aau tadimureha súnwandan,</para>
  <para style="q" vid="PRO 31:26">ani arufudahatu lau ínsiñeni.<verse eid="PRO 31:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 31:27" />Ténitu lun sun katei túbiñe,</para>
  <para style="q" vid="PRO 31:27">ani meigin tumuti le magañeirun tubéi.<verse eid="PRO 31:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 31:28" />Tirahüñü luma túmari adimurehatiña buidu tuagu,</para>
  <para style="q" vid="PRO 31:28">hariñaga:<verse eid="PRO 31:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 31:29" />«Añahein saragu würiña buítiña,</para>
  <para style="q" vid="PRO 31:29">gama lumoun buítimatibu hawéi súngubei».<verse eid="PRO 31:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 31:30" />Iyeeni magadiñein,</para>
  <para style="q" vid="PRO 31:30">gagumuchaguadi ligía uéndeni;</para>
  <para style="q" vid="PRO 31:30">anhoun würi to íchuguboun inebesei lun Bungiu,</para>
  <para style="q" vid="PRO 31:30">ladimurehouba buidu tuagu.<verse eid="PRO 31:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 31:31" />Alawaha humóun hagibugiñe sun gürigia!</para>
  <para style="q" vid="PRO 31:31">Hadimureha buidu tuagu luagu sun le tadügübei!<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>