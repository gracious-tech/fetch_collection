<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JER" style="id">JEREMIAS.TXT (Encoding update 2008) 27/02/2001 CAP C.R, GARIFUNA</book>
  <para style="h">Heremíasi</para>
  <para style="toc3">Her</para>
  <para style="toc2">Heremíasi</para>
  <para style="toc1">Heremíasi</para>
  <para style="mt2">Liliburun</para>
  <para style="mt1">HEREMÍASI</para>
  <chapter number="1" style="c" sid="JER 1" />
  <para style="ms">I. Ñunsu Libügürü Hudá Luma Herusalén</para>
  <para style="mr">(<ref loc="JER 1-25">1—25</ref>)</para>
  <para style="s1">Ebelaagülei</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 1:1" />Tabahüdaguñein garudia to le lariñagubei luma le ladügübei Heremíasi, le liráü Ilükíasi. Heremíasi, hádangiñeti meha haduheñu fádirigu ha aganóubaña Anatótu, hamúanrugu lani Benhamín türibu.<verse eid="JER 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 1:2" />Aba ladimurehan Wabureme lun Heremíasi lidan litareisin lirumudiri larúeihan Hosíasi le liráü Amón Hudá. <verse eid="JER 1:2" /><verse number="3" style="v" sid="JER 1:3" />Adimurehayati giñe lun, lidan lidaani larúeihan Hoakimü, le liráü Hosíasi, lárigiñe lira ayanuhayati luma Heremíasi luagu saragu wéiyaasu darí dan le hanügǘnbei Herusalénna bóugudin luéi hageira, lidan liseingün hati lidan liunsun lirumudiri larúeihan Sedekíasi le liráü Hosíasi lasusereda.<verse eid="JER 1:3" /></para>
  <para style="s1">Lagúarun Wabureme lun Heremíasi</para>
  <para style="p">
    <verse number="4" style="v" sid="JER 1:4" />Aba ladimurehan Wabureme numa, lariñaga nun:<verse eid="JER 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 1:5" />«Lubaragiñebei bágurahouniwa,</para>
  <para style="q" vid="JER 1:5">lídanbei turageirugugidibu búguchu, anúadira náadibu</para>
  <para style="q" vid="JER 1:5">ani direi numutibu lun profetabadibu lan houn néchanigu».<verse eid="JER 1:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="JER 1:6" />Ábati nóunabun:</para>
  <para style="q" vid="JER 1:6">«Nabureme, au ñǘraügidina ani mariñagaditina!»<verse eid="JER 1:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="JER 1:7" />Gama lumoun aba lóunabunina Wabureme lariñaga nun:</para>
  <para style="q" vid="JER 1:7">«Mariñagabá luagu ñǘraügidibu lan.</para>
  <para style="q" vid="JER 1:7">Bídiba le ñeinhin lumuti nóunahabu,</para>
  <para style="q" vid="JER 1:7">ani bariñagubei le nariñagun bun lun bariñaguni.<verse eid="JER 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 1:8" />Manufudedabá ni ka uéi,</para>
  <para style="q" vid="JER 1:8">ladüga búmabadina lun nóunigirunibu.</para>
  <para style="q" vid="JER 1:8">Au le Aburemei ariñagubalin».<verse eid="JER 1:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="JER 1:9" />Ábati látuleruni Aburemei lúhabu, aba laguuruni niyumaaru, lariñaga nun:<verse eid="JER 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 1:10" />«Ru numuti nererun biyumulugún.</para>
  <para style="q" vid="JER 1:10">Níchuguña ubafu bun uguñe luagu arúeihani luma hawagu néchanigu,</para>
  <para style="q" vid="JER 1:10">lun báhulahan luma lun bagünrinchagun</para>
  <para style="q" vid="JER 1:10">lun bagadeihan luma lun baguludagun,</para>
  <para style="q" vid="JER 1:10">luma giñe lun bábunagun muna ítara kei nadü».<verse eid="JER 1:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="JER 1:11" />Aba ladimurehan Aburemei nun, lariñaga nun:</para>
  <para style="q" vid="JER 1:11">«Ka barihubei Heremíasi?»</para>
  <para style="q" vid="JER 1:11">«Aban tilimun alüméndüra» —niña lun.<verse eid="JER 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 1:12" />«Binarün» —ligía Aburemei nun—.</para>
  <para style="q" vid="JER 1:12">«Aranseñu niña lun lagunfulirun nererun».<verse eid="JER 1:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="JER 1:13" />Ábaya ladimurehan Aburemei nun luagu libiaman wéiyaasu:</para>
  <para style="q" vid="JER 1:13">«Ka barihubei?» —liña lálügüdünina.</para>
  <para style="q" vid="JER 1:13">«Arihatina aban sóudieru áhuraha luéigiñe nórute,</para>
  <para style="q" vid="JER 1:13">ani lúnrügaali láwiyurun» —liña nóunabuni.<verse eid="JER 1:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="JER 1:14" />Ábati lariñagun Wabureme nun:</para>
  <para style="q" vid="JER 1:14">«Luéigiñeba nórute liabin wuribani hawagun</para>
  <para style="q" vid="JER 1:14">sun lílana fulasu le.<verse eid="JER 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 1:15" />Au le Aburemei, chóurutina hun luagu nagúaruba lan houn sun arúeihatiña nóruterugugiñe.</para>
  <para style="q" vid="JER 1:15">Hayabinba harúeitegu,</para>
  <para style="q" vid="JER 1:15">ábame híchuguni lálana harúeihan lubenari Herusalén,</para>
  <para style="q" vid="JER 1:15">ligibugiñe sun baríeiru le geyegubei lau,</para>
  <para style="q" vid="JER 1:15">luma ligibugiñe sun burí luburugute Hudá.<verse eid="JER 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 1:16" />Ligía abeichúni le lunbei nóunahani hawagun gafigountiña,</para>
  <para style="q" vid="JER 1:16">ha ígirubalina, ha águdahabaña kupali,</para>
  <para style="q" vid="JER 1:16">hudugua hagía houn búngiugu ha guánarügü hadüga.<verse eid="JER 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 1:17" />Buguyati, ragüba anigi, beiba,</para>
  <para style="q" vid="JER 1:17">bariñageime sun le nariñagubei bun houn.</para>
  <para style="q" vid="JER 1:17">Manufudedabá hawéi, lugundun ánhabu anufudeda,</para>
  <para style="q" vid="JER 1:17">nadadagaragüdübadibu hagibugiñe.<verse eid="JER 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 1:18" />Ru numutibu uguñe keisi uburugu derebuguti,</para>
  <para style="q" vid="JER 1:18">keisi wagabu lauti gürabu,</para>
  <para style="q" vid="JER 1:18">kei baríeiru lauti buronse,</para>
  <para style="q" vid="JER 1:18">lun bagagibudagun luma sun Hudá:</para>
  <para style="q" vid="JER 1:18">Hama lurúeitegu, lábutigu,</para>
  <para style="q" vid="JER 1:18">lufadirinigu, hau sun lílana.<verse eid="JER 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 1:19" />Hawuribuhaba buma, gama lumoun magañeirun habadibu</para>
  <para style="q" vid="JER 1:19">lugundun búmabadina lun nóunigirunibu.</para>
  <para style="q" vid="JER 1:19">Au, le Aburemei ru numuti nererun».<verse eid="JER 1:19" /></para>
  <chapter eid="JER 1" />
  <chapter number="2" style="c" sid="JER 2" />
  <para style="s1">Magunfulin lan Ísüraeli</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 2:1" />Aba ladimurehan Aburemei nun, lariñaga:<verse eid="JER 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 2:2" />«Beiba, badimurehame houn Herusalénna;</para>
  <para style="q" vid="JER 2:2">bagúaraguame lun haganbunibu buidu, bariñagame:</para>
  <para style="q" vid="JER 2:2">“Lariñahare Aburemei:</para>
  <para style="q" vid="JER 2:2">Haritagua numuti dan meha nibureingidibu,</para>
  <para style="q" vid="JER 2:2">gúnfulitibu meha numa,</para>
  <para style="q" vid="JER 2:2">lídanbei meha namarieidun buma,</para>
  <para style="q" vid="JER 2:2">hínsiñetina meha bun,</para>
  <para style="q" vid="JER 2:2">falá bumutina lídanbei básügürüni fulasu mageirawati,</para>
  <para style="q" vid="JER 2:2">múa le ñein lumuti mábunawagun lan ni kata”.<verse eid="JER 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 2:3" />Sánduti meha Ísüraeli nun,</para>
  <para style="q" vid="JER 2:3">lubuidun-agei meha nalubahan.</para>
  <para style="q" vid="JER 2:3">Ha meha adügütiña wuribati lun,</para>
  <para style="q" vid="JER 2:3">nabeichuniña lau nóunahan wuribani hawagun,</para>
  <para style="q" vid="JER 2:3">au le Aburemei ariñagubalin».<verse eid="JER 2:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="JER 2:4" />Ladügawagun Hakobu, iduheñugu Ísüraelina, aganba huméi lererun Aburemei. <verse eid="JER 2:4" /><verse number="5" style="v" sid="JER 2:5" />Lariñahare Aburemei hun:</para>
  <para style="b" vid="JER 2:5" />
  <para style="q" vid="JER 2:5">«Ka wuribati hadarirubei hagüchagu nuagu; hadisedunbei nuéi?</para>
  <para style="q" vid="JER 2:5">Aba houdin hárigi búngiugu ha ni kátabaña,</para>
  <para style="q" vid="JER 2:5">aba giñe hasalirun lun ni kátame.<verse eid="JER 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 2:6" />Máluahan hamutina,</para>
  <para style="q" vid="JER 2:6">au le asagarubaliña Ehiptugiñe,</para>
  <para style="q" vid="JER 2:6">aba nadundehaniña lidan fulasu mageirawati,</para>
  <para style="q" vid="JER 2:6">fulasu mábeiti le buin umuti lau saragu gudungu,</para>
  <para style="q" vid="JER 2:6">múa madunariti, le hanarimeti dencha lan,</para>
  <para style="q" vid="JER 2:6">le ñein lumuti ua hamá aganóutiña,</para>
  <para style="q" vid="JER 2:6">le ñéingiñe lumuti másügürün lan ni aban.<verse eid="JER 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 2:7" />Au anügübalün lidoun múa arandarati le,</para>
  <para style="q" vid="JER 2:7">lun heigin lídangiñe lubuidun-agei le áhüchübei ñein.</para>
  <para style="q" vid="JER 2:7">Gama lumoun aba hiabin, aba hawiyeduni numúan,</para>
  <para style="q" vid="JER 2:7">aba hahahünedagüdünina lun ageiraü le.<verse eid="JER 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 2:8" />Máluahan hamutina fádirigu,</para>
  <para style="q" vid="JER 2:8">masubudirun hamutina ha arufudahabalin lúrudu nageira,</para>
  <para style="q" vid="JER 2:8">iñuraguatiña ábutigu houngua nuagun,</para>
  <para style="q" vid="JER 2:8">adimurehatiña profetagu lidan liri Baali,</para>
  <para style="q" vid="JER 2:8">aba houdin hárigi guáriua ha móunitiña lun ni kata».<verse eid="JER 2:8" /></para>
  <para style="s1">Lidurun Ísüraeli luma Bungiu</para>
  <para style="q">
    <verse number="9" style="v" sid="JER 2:9" />«Ligía nariñagunbei au, le Aburemei:</para>
  <para style="q" vid="JER 2:9">Naguseragüdübadün hau sun hibañan.<verse eid="JER 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 2:10" />Heiba luagun burí ubouhu le luéigiñebei oubaü</para>
  <para style="q" vid="JER 2:10">le ñéingiñe lubéi laboucha weyu harihame;</para>
  <para style="q" vid="JER 2:10">óunaha humá aban gürigia Kedarü lun larihin buidu,</para>
  <para style="q" vid="JER 2:10">ariha humaamugei anhein<verse eid="JER 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 2:11" />aniheinhali lubéi aban hanechanin gibe tubungiutegu</para>
  <para style="q" vid="JER 2:11">asansirutiña habungiutegu.</para>
  <para style="q" vid="JER 2:11">Ani búngiugu ha mama tímatimaatiña!</para>
  <para style="q" vid="JER 2:11">Ánhañati numutuniña ígira hamaadina, au le haweirigunbei,</para>
  <para style="q" vid="JER 2:11">hawagu guáriua ha meseriwíntiña lun ni kata.<verse eid="JER 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 2:12" />Hanufudeguabá lau katei le sielu!</para>
  <para style="q" vid="JER 2:12">Badadagara lau anufudei!</para>
  <para style="q" vid="JER 2:12">Au le Aburemei ariñagubalin».<verse eid="JER 2:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="JER 2:13" />«Adügaaña lílana nageira dóbuli figóu:</para>
  <para style="q" vid="JER 2:13">Ígira hamaadina au le lísensen duna wínwanti,</para>
  <para style="q" vid="JER 2:13">aba hadügün hafusun houngua,</para>
  <para style="q" vid="JER 2:13">fusu le fuduti le mágüdahanti duna.<verse eid="JER 2:13" /></para>
  <para style="s1">Le lanügübei magunfulirun lan Ísüraeli</para>
  <para style="q">
    <verse number="14" style="v" sid="JER 2:14" />«Mama idamuni Ísüraeli, mama lidan adamurawaguni lagaraüdǘwa.</para>
  <para style="q" vid="JER 2:14">Kati uagu lasagarahóua?<verse eid="JER 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 2:15" />Adürürühatiña harahüñü liñún lubaroun,</para>
  <para style="q" vid="JER 2:15">iñura hamuti hamala, aba hígiruni lageira lidan günringuaü,</para>
  <para style="q" vid="JER 2:15">gudawaali burí luburugute,</para>
  <para style="q" vid="JER 2:15">úati ni aban erederuti lidan.<verse eid="JER 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 2:16" />Bougua hamuti Ménfisina</para>
  <para style="q" vid="JER 2:16">hama Táfünesina bichügü.<verse eid="JER 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 2:17" />Lasuseredunbei lira bun,</para>
  <para style="q" vid="JER 2:17">ladüga bígirunina au le Aburemei le Bubungiute,</para>
  <para style="q" vid="JER 2:17">léñaha adundehabalibu lidan bémeri.<verse eid="JER 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 2:18" />Guentoti, Kati bagañeirubei lau bidin Ehiptu</para>
  <para style="q" vid="JER 2:18">ata duna lídangiñe Nilu?</para>
  <para style="q" vid="JER 2:18">Ka bagañeiruña lau bidin Asiria</para>
  <para style="q" vid="JER 2:18">ata duna lídangiñe Éufüratesi?<verse eid="JER 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 2:19" />Labeichubadibu buriban guánarügü,</para>
  <para style="q" vid="JER 2:19">lasiadirubadibu magunfulirun ban numa.</para>
  <para style="q" vid="JER 2:19">Subudibéi lubeiti, arihabéime luagu wuriba lan</para>
  <para style="q" vid="JER 2:19">ani gifi ligía bígiruni Aburemei le Bubungiute,</para>
  <para style="q" vid="JER 2:19">luma míchugun ban inebesei nun,</para>
  <para style="q" vid="JER 2:19">liña lariñagun Aburemei Suntigabafu».<verse eid="JER 2:19" /></para>
  <para style="s1">Mabuchaha lan Ísüraeli</para>
  <para style="q">
    <verse number="20" style="v" sid="JER 2:20" />«Lúmagiñe binarü biñuragua bungua nuagun,</para>
  <para style="q" vid="JER 2:20">máhatibu baganbunina.</para>
  <para style="q" vid="JER 2:20">Ariñagatibu: “Mabusenruntina neseriwidun”.</para>
  <para style="q" vid="JER 2:20">Lanwoun sun lira, róuntibu tuma aban horu,</para>
  <para style="q" vid="JER 2:20">ligibuagu sun wübü íñuti,</para>
  <para style="q" vid="JER 2:20">luma tábugiñe tídibu wewe hilumatu.<verse eid="JER 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 2:21" />Buná numutibu keisi aban tídibu beibei to buítimatu,</para>
  <para style="q" vid="JER 2:21">kei tídibu beibei to fínutimaboun ila.</para>
  <para style="q" vid="JER 2:21">Gama lumoun ámuñeguaadibu saragu darí lun ibidiñeguaadibu lan nun!<verse eid="JER 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 2:22" />Íbini ánhabu achibagua bungua lau achibaguagülei le héretimati,</para>
  <para style="q" vid="JER 2:22">ani yusubéime sun sabun le babusenrun,</para>
  <para style="q" vid="JER 2:22">narihamémebei lidasein bifigoun.</para>
  <para style="q" vid="JER 2:22">Au le Aburemei ariñagubalin.<verse eid="JER 2:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 2:23" />Ida lubagia bariñagun: “Madaseiruntina,</para>
  <para style="q" vid="JER 2:23">méibugun au hárigi baaligu?”</para>
  <para style="q" vid="JER 2:23">Arihabéi ka lan buga bigaburibei lidan fulasu wayati,</para>
  <para style="q" vid="JER 2:23">arihabá lun sun le badügübei,</para>
  <para style="q" vid="JER 2:23">ítara biña kei aban kameyu maganbaditu</para>
  <para style="q" vid="JER 2:23">to éibaaguboun luagun sun oubaü,<verse eid="JER 2:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 2:24" />o kei burigü hiñaru to áraabuna,</para>
  <para style="q" vid="JER 2:24">aba téibaagun dabíararugun ehenheina.</para>
  <para style="q" vid="JER 2:24">Lidan tabusenragun tungua úati gayaraati lederaaguagüdünu.</para>
  <para style="q" vid="JER 2:24">Anhoun láluaha aban burigü mabuchabei luagu anhoun darí lan,</para>
  <para style="q" vid="JER 2:24">súnwandan ladarirunu lidan lidaani tabusenragun tungua.<verse eid="JER 2:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="JER 2:25" />«Ísüraeli, magüreweidabéi bugudi éibaagua mageidinga,</para>
  <para style="q" vid="JER 2:25">mígiraba lun lamabeidun bagülerugu!</para>
  <para style="q" vid="JER 2:25">Gama lumoun bariñaga: “Siñati,</para>
  <para style="q" vid="JER 2:25">hínsiñetiña terencha nun ani néibuga hama” ».<verse eid="JER 2:25" /></para>
  <para style="s1">Megei lumuti Ísüraeli abeichúni</para>
  <para style="q">
    <verse number="26" style="v" sid="JER 2:26" />«Ítara kei labusigaridagun híweruti dan le lárügüdüniwa íweruha,</para>
  <para style="q" vid="JER 2:26">ítara luba lanügün Ísüraeli busiganu,</para>
  <para style="q" vid="JER 2:26">lurúeitegu, lábutigu, lufadirinigu hama lánigu profeta;<verse eid="JER 2:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JER 2:27" />ladüga ariñagatiña íbini lun aban tídibu wewe:</para>
  <para style="q" vid="JER 2:27">“Buguya núguchibei”,</para>
  <para style="q" vid="JER 2:27">ariñaga hagía lun aban dübü:</para>
  <para style="q" vid="JER 2:27">“Buguya núguchuboun”.</para>
  <para style="q" vid="JER 2:27">Nunti, michu hamuti hagibu, hanagan híchugubei nuagun.</para>
  <para style="q" vid="JER 2:27">Gama lumoun lidan hadariragun houngua lidan denchaü aba hariñagun nun:</para>
  <para style="q" vid="JER 2:27">“Higabu besefurawa!”<verse eid="JER 2:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 2:28" />Hudá, Hagaña san bubungiutegu ha badügübaña?</para>
  <para style="q" vid="JER 2:28">Gíbetiña bubungiutegu kei liibe buburugute!</para>
  <para style="q" vid="JER 2:28">Ñübuin hamaati ariha anhein gayara hesefurunibu</para>
  <para style="q" vid="JER 2:28">danme lachülürün bilamiserun!<verse eid="JER 2:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 2:29" />Ka nidurunbei huma,</para>
  <para style="q" vid="JER 2:29">garabaguaadün lubéi súngubei nuagun?</para>
  <para style="q" vid="JER 2:29">Au le Aburemei ariñagubalin.<verse eid="JER 2:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 2:30" />Málati nabeichuniña hisaanigu,</para>
  <para style="q" vid="JER 2:30">mafurendeirún hamuti arufudahani.</para>
  <para style="q" vid="JER 2:30">Huguya guánarügü kei liñún gáñitiña,</para>
  <para style="q" vid="JER 2:30">áfaragua humutiña hani profetagu.<verse eid="JER 2:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JER 2:31" />(Huguya giñe ha lirahüñüna dan le,</para>
  <para style="q" vid="JER 2:31">teni humá lun luganute Aburemei.)</para>
  <para style="q" vid="JER 2:31">Ísüraeli, ítara niña funagia kei aban fulasu mageirawati bun?</para>
  <para style="q" vid="JER 2:31">Odi kei aban fulasu le dénchati?</para>
  <para style="q" vid="JER 2:31">Nánigu, Ka uagu hariñaga:</para>
  <para style="q" vid="JER 2:31">Wagía wóunguaadiwa, magiribudúndigiaadiwa bun?<verse eid="JER 2:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JER 2:32" />Gayaraati funagia tabulieiduni aban würi</para>
  <para style="q" vid="JER 2:32">to luntu tamarieidun tílagu burí lauti golu?</para>
  <para style="q" vid="JER 2:32">Ánhañati numutuniña, binarü habulieidana.<verse eid="JER 2:32" /></para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" sid="JER 2:33" />Ma lisubudin üma bun dan le báluahaña lan bubúali!</para>
  <para style="q" vid="JER 2:33">Máisturu buguya tidan lileskuelan wuribani!<verse eid="JER 2:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="JER 2:34" />Dáseiñutiña badaüragun lau hata gudemetiña hama maduruntiña</para>
  <para style="q" vid="JER 2:34">gürigia ha márügüdün bumutiña lidan ni aban duru.<verse eid="JER 2:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="JER 2:35" />Gama lumoun lau sun lira, ariñagatibu:</para>
  <para style="q" vid="JER 2:35">“Maduruntina, magañihali Aburemei numa”.</para>
  <para style="q" vid="JER 2:35">Kei ariñaga bubéi luagu mafigoun ban, naguseragüdaadibu.<verse eid="JER 2:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="JER 2:36" />Ka uagu bóufudaha asansihaña bumadagu?</para>
  <para style="q" vid="JER 2:36">Lachararuba giñe Ehiptu bun kei lachararun Asiria.<verse eid="JER 2:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="JER 2:37" />Bagiribuduba Ehiptugiñe buin lau busiganu,</para>
  <para style="q" vid="JER 2:37">lugundun fui naaña ha buga uágubaña bemenigida,</para>
  <para style="q" vid="JER 2:37">ani magañeirúnbadibu ni kata lau bumadagua hama».<verse eid="JER 2:37" /></para>
  <chapter eid="JER 2" />
  <chapter number="3" style="c" sid="JER 3" />
  <para style="s1">Magunfulirunti Ísüraeli lun Wabureme</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 3:1" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 3:1">«Anhein ígiragua aban wügüri tuma lúmari,</para>
  <para style="q" vid="JER 3:1">aba tamarieidun luma amu wügüri,</para>
  <para style="q" vid="JER 3:1">móundarundigiaalime le furumiñeti tumoun,</para>
  <para style="q" vid="JER 3:1">lugundun ábanbei anabawaguni wéiriti lira lun hageira.</para>
  <para style="q" vid="JER 3:1">Lau sun lira, buguya Ísüraeli,</para>
  <para style="q" vid="JER 3:1">ahoruhaadibu hama saragu ubúaligu,</para>
  <para style="q" vid="JER 3:1">ani guentó, busentibu bagiribudun nun!</para>
  <para style="q" vid="JER 3:1">Au le Aburemei ariñagubalin».<verse eid="JER 3:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JER 3:2" />«Arihabéi burí wübü hiyaali, arihabéi buidu:</para>
  <para style="q" vid="JER 3:2">Anihein funa fulasu le ñein lumuti marounrun ban kei horu?</para>
  <para style="q" vid="JER 3:2">Ñurutibu kei Arawiana lidan fulasu mageirawati,</para>
  <para style="q" vid="JER 3:2">agurabahaña bubúaligu laru üma.</para>
  <para style="q" vid="JER 3:2">Dasei baali fulasu lau bahoruhan luma buriban.<verse eid="JER 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 3:3" />Ligía mégeihali lubéi huya lidan lidaani.</para>
  <para style="q" vid="JER 3:3">Mabusigaritibu kei aban horu;</para>
  <para style="q" vid="JER 3:3">Nibusigarírügütibu hamuga!<verse eid="JER 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 3:4" />Málügili lúmagiñe bariñagunñaha nun:</para>
  <para style="q" vid="JER 3:4">“Núguchi, numada lúmagiñe niñüraü,<verse eid="JER 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 3:5" />gáñibadibu san súnwandan?</para>
  <para style="q" vid="JER 3:5">Laduraruba san bigañi lun sun dan?”</para>
  <para style="q" vid="JER 3:5">Gama lumoun sun abunha lan álügüdaguana</para>
  <para style="q" vid="JER 3:5">abunha adügei sun wuribati le biyaraati».<verse eid="JER 3:5" /></para>
  <para style="s1">Lemegeirúniwa asakürihani</para>
  <para style="p">
    <verse number="6" style="v" sid="JER 3:6" />Aba lariñagun Aburemei nun lidaaniwagu urúei Hosíasi:</para>
  <para style="p" vid="JER 3:6">—Ariha baali san le tadügübei mabuchahatu Ísüraeli? Rúguatu tungua ahoruha luagu sun wübü íñuti luma lábugiñe sun tídibu wewe hilumati. <verse eid="JER 3:6" /><verse number="7" style="v" sid="JER 3:7" />Naritagun yebe luagu tagiribuduba lan nun, lárigiñe sun le adüga táalibei, gama lumoun magiribudúntu. Ariha tumuti Hudá to tamulelua to giñe mabuchahaboun sun le; <verse eid="JER 3:7" /><verse number="8" style="v" sid="JER 3:8" />ariha tumuti giñe luagu ígira nanu mabuchahatu Ísüraeli, ani nígirunbarun lan ladüga agabarahani le tadügübei. Gama lumoun Hudá to móusanboun to tamulelua Ísüraeli, manufudeduntu, aba giñe tíchaagun tungua lun ahoruhani. <verse eid="JER 3:8" /><verse number="9" style="v" sid="JER 3:9" />Ani tadügei lau saragu lumenrengun darí lun tawiyeduni fulasu. Aba tadügün maricharaguni áhuduragua lun dübü luma burí lun tídibu wewe <verse eid="JER 3:9" /><verse number="10" style="v" sid="JER 3:10" />Lárigiñe sun le, magiribudúntu maricharaguntu Hudá numoun tau sun tanigi, yéedaguarügütana. Au le Bungiu ariñagubalin.<verse eid="JER 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 3:11" />Aba lariñagun Bungiu nun:</para>
  <para style="p" vid="JER 3:11">—Ísüraeli to dereboun aganbun, maweirinti tidurun kei Hudá to maricharagunboun. <verse eid="JER 3:11" /><verse number="12" style="v" sid="JER 3:12" />Beiba, bariñageime uganu le, lau bigibu luagun nórute:</para>
  <para style="b" vid="JER 3:12" />
  <para style="q" vid="JER 3:12">«Lariñahare Aburemei:</para>
  <para style="q" vid="JER 3:12">“Giribubá nun, mabuchahatu Ísüraeli!</para>
  <para style="q" vid="JER 3:12">Meresibirun nubadibu lau luriban,</para>
  <para style="q" vid="JER 3:12">magañidun aume lun sun dan, lugundun gudemehabutina.</para>
  <para style="q" vid="JER 3:12">Au le Aburemei ariñagubalin.<verse eid="JER 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 3:13" />Buídurügüti lun bánharun luagu adügaadibu lan wuribani,</para>
  <para style="q" vid="JER 3:13">ani mabuchaha ban lun Wabureme le Bubungiute;</para>
  <para style="q" vid="JER 3:13">luagu ñüdün ban áluaha hínsiñehabu terencha</para>
  <para style="q" vid="JER 3:13">lábugiñe tídibu wewe hilumatu,</para>
  <para style="q" vid="JER 3:13">luagu madügün ban gasu lau nererun.</para>
  <para style="q" vid="JER 3:13">Au le Aburemei ariñagubalin” ».<verse eid="JER 3:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="JER 3:14" />Lariñahare Aburemei:</para>
  <para style="p" vid="JER 3:14">—Giribu humá nun isaanigu mabuchahatiña, lugundun au Haburemebei. Nanügüba aban lídangiñe kada uburugu, biámame hádangiñe kada iduheñu, ábame nagiribudagüdünün uburugun Sión. <verse eid="JER 3:14" /><verse number="15" style="v" sid="JER 3:15" />Níchuguba arúeihatiña hun ha áutiña nagundaara, lun hadundehanün lau lichú aau luma gunfurandaü. <verse eid="JER 3:15" /><verse number="16" style="v" sid="JER 3:16" />Danme le gíbeguaadün fulasurugu, danme gíbeeña hisaanigu, madimurehóunhalime tuagu lubagüsinina lidaradun Aburemei; masaminarúnwabei maritawagún ligíame tuagun; memegeirúnwaarume, madügǘniwa tuguyame teweñegua. Au le Aburemei ru numuti nererun. <verse eid="JER 3:16" /><verse number="17" style="v" sid="JER 3:17" />Ligíameti dan ligía laguarúniwa lun Herusalén lálana larúeihan Aburemei hóundaraguba sun néchanigu ñein, lun híchugun uéiriguni nun, mafaladigia hamaalime wuribani le tídanbei hanigi.<verse eid="JER 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 3:18" />—Danme lachülürün weyu ligía, lóundaruba Hudá lumoun Ísüraeli, ábame hagiribudun úara lídangiñe ageiraü le nóruterugubei lidoun múa le níchugubei houn hagüchagu kei halagante.<verse eid="JER 3:18" /></para>
  <para style="s1">Hínsiñe guáriua lun Ísüraeli</para>
  <para style="q">
    <verse number="19" style="v" sid="JER 3:19" />«Ísüraeli, busentina yebe neresibirunibu kei niráü,</para>
  <para style="q" vid="JER 3:19">lun níchugun aban fulasu gimugawati bun,</para>
  <para style="q" vid="JER 3:19">ageiraü le buídutimabei ubouagu.</para>
  <para style="q" vid="JER 3:19">Naritagun yebe luagu bagúaruba lan nun núguchi,</para>
  <para style="q" vid="JER 3:19">luagu madisedunbadibu lan hamuga nuéi.<verse eid="JER 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 3:20" />Gama lumoun kei aban würi to maricharaguntu lun túmari,</para>
  <para style="q" vid="JER 3:20">ítara liña maricharagun humá nun.</para>
  <para style="q" vid="JER 3:20">Au, le Aburemei ariñagubalin».<verse eid="JER 3:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="JER 3:21" />«Aganbúati umalali luagu burí wübü le maganóunwati luagu:</para>
  <para style="q" vid="JER 3:21">Hamalali Ísüraelina ha ayahubaña, amuriaha gudemehabu!</para>
  <para style="q" vid="JER 3:21">Geyerügütiña luéi üma le surubei, ani aba habulieidagun nuéi,</para>
  <para style="q" vid="JER 3:21">au le Aburemei le Habungiute.<verse eid="JER 3:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 3:22" />Giribu humá nun, isaanigu mabuchahatiña,</para>
  <para style="q" vid="JER 3:22">ábame nagaranihan hun luéi mabuchahaü».</para>
  <para style="s1" vid="JER 3:22">Hóunabuni Ísüraelina Wabureme</para>
  <para style="q" vid="JER 3:22">«Awanhán, wayabiña bun,</para>
  <para style="q" vid="JER 3:22">ladüga buguya Aburemeibei le Wabungiute.<verse eid="JER 3:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 3:23" />Málati woudin luagun burí wübü agúaraha;</para>
  <para style="q" vid="JER 3:23">lídanrügüñein Aburemei le Wabungiute</para>
  <para style="q" vid="JER 3:23">ladarirei Ísüraeli lesefurun.<verse eid="JER 3:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 3:24" />Le meha habihubei wagübürigu lúmagiñe ñǘbürigidiwa,</para>
  <para style="q" vid="JER 3:24">mudún, bágasu hama isaanigu,</para>
  <para style="q" vid="JER 3:24">féridigüdala bulíeiguaü woun.<verse eid="JER 3:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 3:25" />Rugua wamá lubeiti woungua ǘnabu,</para>
  <para style="q" vid="JER 3:25">lau busiganu luma maweiriguni,</para>
  <para style="q" vid="JER 3:25">lugundun lúmagiñe ñǘbürigidiwa chülǘ lumoun dan le,</para>
  <para style="q" vid="JER 3:25">dandu wagía kei wagüchagu,</para>
  <para style="q" vid="JER 3:25">afigouhaadiwa ligibugiñe Aburemei le Wabungiute,</para>
  <para style="q" vid="JER 3:25">ani madügün wamuti le lubeibei».<verse eid="JER 3:25" /></para>
  <chapter eid="JER 3" />
  <chapter number="4" style="c" sid="JER 4" />
  <para style="s1">Agunbirahóuni lun asakürihani</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 4:1" />Lariñahare Bungiu:</para>
  <para style="q" vid="JER 4:1">«Ísüraeli anhein busén bubéi bagiribudun, lunti nunlá bagiribuda.</para>
  <para style="q" vid="JER 4:1">Ánhaña bígira hagübüri bubungiutegu,</para>
  <para style="q" vid="JER 4:1">madisedun buguyame nuéi,<verse eid="JER 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 4:2" />gayaraabei báfiñurun lidan niri lau inarüni,</para>
  <para style="q" vid="JER 4:2">irichaü luma ísuruni.</para>
  <para style="q" vid="JER 4:2">Lébunabei abiniruni luma eremuhani niri houn néchanigu».<verse eid="JER 4:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="JER 4:3" />Lariñahare Aburemei houn lílana Hudá luma Herusalén:</para>
  <para style="q" vid="JER 4:3">«Bunagua humá lidan múa le mábunawagungili ñein,</para>
  <para style="q" vid="JER 4:3">hebé hábunagun labadinagua hiiyu.<verse eid="JER 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 4:4" />Lílana Hudá luma Herusalén,</para>
  <para style="q" vid="JER 4:4">richagua humá lidan daradu le hadügübei numa</para>
  <para style="q" vid="JER 4:4">subudi humana keisi Aburemei,</para>
  <para style="q" vid="JER 4:4">ru huméi liseinin daradu tidoun hanigi,</para>
  <para style="q" vid="JER 4:4">durungualiñein nigañi kei watu gemeti ladüga luriban hóuserun,</para>
  <para style="q" vid="JER 4:4">ábame ladurangun úouga gayaraati léñeguchuni.<verse eid="JER 4:4" /></para>
  <para style="s1">Lasiadiruniwa Hudá lun lásiurawaguniwa</para>
  <para style="q">
    <verse number="5" style="v" sid="JER 4:5" />«Ariñaaha huméi katei le uburugu Herusalén luma Hudá,</para>
  <para style="q" vid="JER 4:5">subudigüda huméi lidan sun fulasu, wagua huméi here:</para>
  <para style="q" vid="JER 4:5">“Lun héibaagun lidoun burí uburugu le baríeiruati!”<verse eid="JER 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 4:6" />Arufuda huméi lémeri Sión;</para>
  <para style="q" vid="JER 4:6">aramudagua humá, mararamagua humá!</para>
  <para style="q" vid="JER 4:6">Lugundun nanüga lamiselu luma günringuaü nóruterugugiñe.<verse eid="JER 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 4:7" />Furihali liñún lídangiñe laramudaguagüle,</para>
  <para style="q" vid="JER 4:7">aniteeli le agünrinchagubalin burí néchani,</para>
  <para style="q" vid="JER 4:7">furihali lageiragiñe lun lagünrinchaguni bageira,</para>
  <para style="q" vid="JER 4:7">lun lagumuchaguagüdüni burí buburugute.<verse eid="JER 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 4:8" />Daügua humá lubeiti daüguaü súsutu,</para>
  <para style="q" vid="JER 4:8">hayahuaha lau igarigu,</para>
  <para style="q" vid="JER 4:8">lugundun madireirúngili lanarime ligañi Aburemei wawéi».<verse eid="JER 4:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="JER 4:9" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 4:9">«Danme lachülürün weyu ligía,</para>
  <para style="q" vid="JER 4:9">ladadagaruba urúei hama ábutigu lau anufudei,</para>
  <para style="q" vid="JER 4:9">hasandiruba fádirigu anufudei,</para>
  <para style="q" vid="JER 4:9">halouchuba profetagu».<verse eid="JER 4:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="JER 4:10" />Aba nariñagun: «Aburemei yéedaba lílana Herusalén!</para>
  <para style="q" vid="JER 4:10">Füramasetibu darangilaü houn,</para>
  <para style="q" vid="JER 4:10">gama lumoun guentó anuhán aban gusiñu luagu hagiina».<verse eid="JER 4:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="JER 4:11" />Danme lachülürün oura ligía,</para>
  <para style="q" vid="JER 4:11">lariñawagúba houn lílana Herusalén:</para>
  <para style="q" vid="JER 4:11">«Láfuhaña aban garabali süti luéigiñe</para>
  <para style="q" vid="JER 4:11">fulasu mageirawati luagun nageira.</para>
  <para style="q" vid="JER 4:11">Mama garabali le buídubei lun lewenihóun türigu;<verse eid="JER 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 4:12" />garabali le lunbei nóunahani,</para>
  <para style="q" vid="JER 4:12">héreyabei lun lira,</para>
  <para style="q" vid="JER 4:12">lugundun guentó, nasiadiráaña».<verse eid="JER 4:12" /></para>
  <para style="s1">Hegeyedaguni áganiñu Ísüraeli</para>
  <para style="q">
    <verse number="13" style="v" sid="JER 4:13" />Anitén ágani awansereina kei aban dúeri,</para>
  <para style="q" vid="JER 4:13">ítara tiña burí likarün to lánina wuribu kamá herigini,</para>
  <para style="q" vid="JER 4:13">furesetiña ligabayun sügǘ hau ágila.</para>
  <para style="q" vid="JER 4:13">Fugiabugu wagía, féridihadiwa!<verse eid="JER 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 4:14" />Herusalén, gidabei wuribani tídangiñe banigi,</para>
  <para style="q" vid="JER 4:14">ítara luba besefurun.</para>
  <para style="q" vid="JER 4:14">Ídaba lásura bagarabahan lagübüri saminaü bichügüwagu?<verse eid="JER 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 4:15" />Chülüti uganu wuribati lúmagiñe Dan luma luéigiñe burí luwübüri Éfürain:<verse eid="JER 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 4:16" />Wisá humaña néchanigu luma Herusalén añate lan áganiñu lídangiñe aban ageiraü díseti, agúaraheina agúarahani le lánina wuribu,</para>
  <para style="q" vid="JER 4:16">kóntüra burí luburugute Hudá.<verse eid="JER 4:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 4:17" />Hegeyedagubei Hudá, kei ha óunigirutiña ichari,</para>
  <para style="q" vid="JER 4:17">ladüga liñuragun lungua luagun Aburemei.</para>
  <para style="q" vid="JER 4:17">Au le Aburemei ariñagubalin.<verse eid="JER 4:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="JER 4:18" />«Bóuserun luma le badügübei lébunabei le asuseredubei bun;</para>
  <para style="q" vid="JER 4:18">líchugun buriban in gífiti le bun lun líbaagunu banigi».<verse eid="JER 4:18" /></para>
  <para style="s1">Ligarigu Heremíasi luagu lageira</para>
  <para style="q">
    <verse number="19" style="v" sid="JER 4:19" />Nagarabahaña lau gáriti!</para>
  <para style="q" vid="JER 4:19">Hanarimeti tádühan nanigi!</para>
  <para style="q" vid="JER 4:19">Mederaguagüdüntina, siñati námanichun!</para>
  <para style="q" vid="JER 4:19">Aganbaadina aban tamuri fidu,</para>
  <para style="q" vid="JER 4:19">aban agúarahani le lánina wuribu.<verse eid="JER 4:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 4:20" />Lachülühaña burí uganu luagu lamiselu;</para>
  <para style="q" vid="JER 4:20">günrinwagua sun wageira.</para>
  <para style="q" vid="JER 4:20">Günrinwagua burí waban sódini,</para>
  <para style="q" vid="JER 4:20">ani furesegueina aba haheirihanu tikorutinan waban.<verse eid="JER 4:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 4:21" />Ídaba lásura narihini fanidira iñurañu,</para>
  <para style="q" vid="JER 4:21">luma naganbahan tíñaahouniwa fidu?<verse eid="JER 4:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 4:22" />«Ibidiouguati hau numutuniña, ibidiñetina houn —liña Aburemei—.</para>
  <para style="q" vid="JER 4:22">Ítara haña kei isaanigu ha úati gunfuranda hamá.</para>
  <para style="q" vid="JER 4:22">Chuti hau lun hadügüni le wuribabei</para>
  <para style="q" vid="JER 4:22">gama lumoun madügaditiña lun le buídubei».<verse eid="JER 4:22" /></para>
  <para style="s1">Larihini Heremíasi agünrinchawaguni le lunbei liabin</para>
  <para style="q">
    <verse number="23" style="v" sid="JER 4:23" />Aba narihini ubóu,</para>
  <para style="q" vid="JER 4:23">ítara liña kei fulasu mageirawati, le múaragunti,</para>
  <para style="q" vid="JER 4:23">arihanéi sielu, úati larugounga ñein.<verse eid="JER 4:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 4:24" />Aba narihini burí wübü, ladadagaruña,</para>
  <para style="q" vid="JER 4:24">sun burí wübü layudeihaña.<verse eid="JER 4:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 4:25" />Aba narihin, úaali ni aban gürigia,</para>
  <para style="q" vid="JER 4:25">ani anurahouga buga sun dunuru.<verse eid="JER 4:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 4:26" />Aba narihini burí fuluri-agei,</para>
  <para style="q" vid="JER 4:26">saligua lan fulasume mageirawati,</para>
  <para style="q" vid="JER 4:26">ani sun burí uburugu günrinwaguaali.</para>
  <para style="q" vid="JER 4:26">Lanarime ligañi Aburemei adügübalin sun le.<verse eid="JER 4:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="JER 4:27" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 4:27">«Lerederuba sun múa málouga,</para>
  <para style="q" vid="JER 4:27">gama lumoun magünrinchagun nubéi sunsuinagubei.<verse eid="JER 4:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 4:28" />Labuinchuba múa lau íruni, lamuiseruba sielu.</para>
  <para style="q" vid="JER 4:28">Adimurehaadina ani masakürihanbadina;</para>
  <para style="q" vid="JER 4:28">merede ligíame nadügüni.<verse eid="JER 4:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 4:29" />Anurahatiña sun gürigia dan haganbuni hagúarahan</para>
  <para style="q" vid="JER 4:29">ha gabayuagubaña hama ha tábubaña gimara,</para>
  <para style="q" vid="JER 4:29">aba héibaagun sun mutu aramudagua lidan burí búbugati,</para>
  <para style="q" vid="JER 4:29">o hawarirun lan burí luagun dübü íñuti.</para>
  <para style="q" vid="JER 4:29">Rédeiti sun burí uburugu málouga;</para>
  <para style="q" vid="JER 4:29">úaaña kaba lan aganawa ñein.<verse eid="JER 4:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 4:30" />Buguya uburugu günrinwaguaali,</para>
  <para style="q" vid="JER 4:30">ka uagu badaüragua daüguaü funatu?</para>
  <para style="q" vid="JER 4:30">Ka uagu badaüragua golu buougua?</para>
  <para style="q" vid="JER 4:30">Ka uagu befeindihei bagu lau wuriti?</para>
  <para style="q" vid="JER 4:30">Málati baranseragun bungua,</para>
  <para style="q" vid="JER 4:30">ladüga fui hamaadibu bubúaligu, bounwen háluahabei.<verse eid="JER 4:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JER 4:31" />Aganbatina agúarahani le lánina igari,</para>
  <para style="q" vid="JER 4:31">kei tagúarahan aban würi to agaridutu lau furumiñeti tiráü;</para>
  <para style="q" vid="JER 4:31">Sión agúarahabei, lamumehati tuleñu larüna ariñageina:</para>
  <para style="q" vid="JER 4:31">“Fugiabu nuguya, háfaraadina gáfarahatiña!” »<verse eid="JER 4:31" /></para>
  <chapter eid="JER 4" />
  <chapter number="5" style="c" sid="JER 5" />
  <para style="s1">Lifigoun Herusalén</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 5:1" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 5:1">«Éibuga huméi lémeri Herusalén,</para>
  <para style="q" vid="JER 5:1">ariha humá buidu, háluaha burí párükerugu,</para>
  <para style="q" vid="JER 5:1">anhaün adarira aban gürigia le adügüti le úaraguabei, le harumabei,</para>
  <para style="q" vid="JER 5:1">anhein hadarira, feruduna nubéi Herusalén.<verse eid="JER 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 5:2" />Añahein áfiñurutiña luagu liri Aburemei,</para>
  <para style="q" vid="JER 5:2">gama lumoun iyeeni háfiñurun».<verse eid="JER 5:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="JER 5:3" />Aburemei, gürigia furangutiña báluahabaña.</para>
  <para style="q" vid="JER 5:3">Bei bumutiña, ani masandi hamuti ligari,</para>
  <para style="q" vid="JER 5:3">gadei bumutiña ani máhatiña hafurendeirun.</para>
  <para style="q" vid="JER 5:3">Mabuchahatiña, deretiña sügǘ lau dübü,</para>
  <para style="q" vid="JER 5:3">máhatiña hagiribudun lidoun lubuidun üma.<verse eid="JER 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 5:4" />Haritaguatina yebe:</para>
  <para style="q" vid="JER 5:4">Gudemetiñarügüñanu lan óusera kei ibidiougua tau,</para>
  <para style="q" vid="JER 5:4">lugundun ibidiñeti houn ka lan labusenrubei Aburemei,</para>
  <para style="q" vid="JER 5:4">le lariñagubei Habungiute lun ladügǘniwa.<verse eid="JER 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 5:5" />Nadimurehaba houn gürigia ha íñugutimabaña, aná hagía,</para>
  <para style="q" vid="JER 5:5">hasubudirubei le labusenrúbei Aburemei le Habungiute.</para>
  <para style="q" vid="JER 5:5">Gama lumoun sun hagía,</para>
  <para style="q" vid="JER 5:5">iñuraguaaña houngua luagun Aburemei,</para>
  <para style="q" vid="JER 5:5">máhatiña haganbuni le lubeibei.<verse eid="JER 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 5:6" />Ligía hachülaaguba lubéi liñún áraabugiñe, ábame háfaraguniña,</para>
  <para style="q" vid="JER 5:6">hamurusuhabaña ounli áraabuna ha lídanbaña fulasu mageirawati,</para>
  <para style="q" vid="JER 5:6">háfaragubaña géigusi lurugabu haburugute</para>
  <para style="q" vid="JER 5:6">ábame hamurusuhaniña danme le háfuridun;</para>
  <para style="q" vid="JER 5:6">lugundun gíbeeli figóu hadüga.<verse eid="JER 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 5:7" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 5:7">«Ida luba feruduna nani sun le bun?</para>
  <para style="q" vid="JER 5:7">Ígira hamaadinagu birahüñü,</para>
  <para style="q" vid="JER 5:7">ñéingiñe fiñutiña hawagu búngiugu ha mama Bungiu.</para>
  <para style="q" vid="JER 5:7">Rútina éigini gíbeti houn,</para>
  <para style="q" vid="JER 5:7">gama lumoun magunfuliruntiña numa,</para>
  <para style="q" vid="JER 5:7">aba híchaagun houngua lun ahoruhani.<verse eid="JER 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 5:8" />Kei gabayu ha hóugüdawatiña buidu ha busenguaaña houngua,</para>
  <para style="q" vid="JER 5:8">ítara liña hafuudun tuagu lúmari haduhe.<verse eid="JER 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 5:9" />Lunti funagia mabeichun nubaña lan luéigiñe burí katei le?</para>
  <para style="q" vid="JER 5:9">Lunti funagia michu nubéi lan le hadünabei gürigia ítaratiña houn?<verse eid="JER 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 5:10" />Belú hamá háganiñu, baraguagüda haméi beibei-agei,</para>
  <para style="q" vid="JER 5:10">íbini magünrinchagun hamani sunsuinagubei!</para>
  <para style="q" vid="JER 5:10">Hulá haméi burí lilimun lugundun mámaali nubeibein-agei!<verse eid="JER 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 5:11" />Garabaguaali Ísüraeli luma Hudá nuagun.</para>
  <para style="q" vid="JER 5:11">Au, le Aburemei ariñagubalin».<verse eid="JER 5:11" /></para>
  <para style="s1">Lariñawagúniwa luagu labeichúba lan Ísüraeli</para>
  <para style="q">
    <verse number="12" style="v" sid="JER 5:12" />Yéeguali Ísüraeli luma Hudá lau Aburemei;</para>
  <para style="q" vid="JER 5:12">ariñagaaña: «Mabahüdǘnti Aburemei,</para>
  <para style="q" vid="JER 5:12">masuseredunbei ni kata wuribati woun,</para>
  <para style="q" vid="JER 5:12">mawuribuhanbadiwa, malamachun wagíame».<verse eid="JER 5:12" /></para>
  <para style="q">
    <verse number="13-14" style="v" sid="JER 5:13-14" />Ítara haña profetagu kei garabali,</para>
  <para style="q" vid="JER 5:13-14">ladüga úati lererun Bungiu hadan.</para>
  <para style="b" vid="JER 5:13-14" />
  <para style="q" vid="JER 5:13-14">Anihán lubeiti lariñagubei Aburemei Suntigabafu nun:</para>
  <para style="q" vid="JER 5:13-14">«Ladüga hariñaguni katei le anihán le lunbei lasuseredun houn:</para>
  <para style="q" vid="JER 5:13-14">Nadüga lun lítaradun nererun biyumulugu kei watu gemeti,</para>
  <para style="q" vid="JER 5:13-14">lun ítara hamá lílana fulasu kei watu,</para>
  <para style="q" vid="JER 5:13-14">lun lagumuchaguagüdüniña watu gemeti ligía».<verse eid="JER 5:13-14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="JER 5:15" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 5:15">«Ísüraeli, nanüga gürigia dísegiñetiña buagun,</para>
  <para style="q" vid="JER 5:15">binadu gürigia ha héretiña.</para>
  <para style="q" vid="JER 5:15">Ibidiñeti hererun bun,</para>
  <para style="q" vid="JER 5:15">ua ligía gunfurandabani le hariñagubei.<verse eid="JER 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 5:16" />Wuriburuguna ganigitiña sun hagía,</para>
  <para style="q" vid="JER 5:16">óunweni tílabei hárumate.<verse eid="JER 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 5:17" />Héigibei balubahan, beigan fein,</para>
  <para style="q" vid="JER 5:17">hou hamañame birahüñü.</para>
  <para style="q" vid="JER 5:17">Héigibaña bilügüniña mudún,</para>
  <para style="q" vid="JER 5:17">bilügüniña bágasu, binadürigu beibei, binadürigu igu.</para>
  <para style="q" vid="JER 5:17">Tau burí hárumate hagünrinchagubei giñe uburugu burí baríeiruati le uágubei bemenigida».<verse eid="JER 5:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="JER 5:18" />Lariñahare Aburemei:</para>
  <para style="p" vid="JER 5:18">—Lau sun lira, magünrinchagun nubaña sunsuinagubei lidan dan ligía. <verse eid="JER 5:18" /><verse number="19" style="v" sid="JER 5:19" />Danme le hálügüdünibu: «Ka san uagu ladügei Aburemei le Wabungiute katei le woun?» Bariñagame houn: «Ítara kei hígiruni Aburemei, lun heseriwidun houn búngiugu terencha hageira, ítara luba giñe heseriwidun houn gürigia terencha lidan hageira amu».<verse eid="JER 5:19" /></para>
  <para style="s1">Leweridirúniwa Ísüraeli</para>
  <para style="q">
    <verse number="20" style="v" sid="JER 5:20" />«Wisá huméi sun Ísüraeli,</para>
  <para style="q" vid="JER 5:20">ariñaga huguyame lun Hudá:<verse eid="JER 5:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 5:21" />“Aganba huméi le, gürigia ibidiougua tau,</para>
  <para style="q" vid="JER 5:21">ha gágubaña ani marihintiña,</para>
  <para style="q" vid="JER 5:21">ha garigeirugubaña ani maganbuntiña.<verse eid="JER 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 5:22" />Nariñahare au, le Aburemei:</para>
  <para style="q" vid="JER 5:22">Manufudetün san nuéi?</para>
  <para style="q" vid="JER 5:22">Madadagaruntün san nigibugiñe?</para>
  <para style="q" vid="JER 5:22">Au íchugubalin beya kei lébeha barana,</para>
  <para style="q" vid="JER 5:22">siñati lásügürün barana ñéingiñe.</para>
  <para style="q" vid="JER 5:22">Iñurahati lugudi barana,</para>
  <para style="q" vid="JER 5:22">abounha ligía gama lumoun siñati lásügürün.<verse eid="JER 5:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 5:23" />Huguya, anuhein aban anigi huagu deretu ani mabuchahatu,</para>
  <para style="q" vid="JER 5:23">aba hígirunina aba hidin.<verse eid="JER 5:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 5:24" />Masaminaruntün, mariñagun huguya:</para>
  <para style="q" vid="JER 5:24">Inebelá Wabureme le Wabungiute woun,</para>
  <para style="q" vid="JER 5:24">le íchugubalin huya woun lidan lidaani</para>
  <para style="q" vid="JER 5:24">ru ligía dan lun gayaraabei lan walubahan.<verse eid="JER 5:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 5:25" />Gama lumoun sánsiguala hifigoun sun katei,</para>
  <para style="q" vid="JER 5:25">siñaali habagariduni sun meha katei buiti ligía.<verse eid="JER 5:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 5:26" />Lugundun añahein gürigia wuribatiña nageira,</para>
  <para style="q" vid="JER 5:26">ha agaradahatiña kei agaliruhatiña dunuru,</para>
  <para style="q" vid="JER 5:26">ha esetihabaña sádara lun hábürügüdüniña ha híbiri.<verse eid="JER 5:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JER 5:27" />Buíngüda hamutu burí haban lau ílagu le híweruhan,</para>
  <para style="q" vid="JER 5:27">kei tabuinchun haban dunuru hau dunuru.</para>
  <para style="q" vid="JER 5:27">Ítara liña gabafu hamá ani risi hagía.<verse eid="JER 5:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 5:28" />Aba hadibunedun ladüga hóutiña buidu, mébehati hariban,</para>
  <para style="q" vid="JER 5:28">michu hamuti haricha méteñuhaña houn,</para>
  <para style="q" vid="JER 5:28">maha hagía lun híchuguni haricha gudemetiña houn.<verse eid="JER 5:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 5:29" />Lunti mabeichun nubaña lan luéigiñe sun katei le?</para>
  <para style="q" vid="JER 5:29">Michunéimeti le hadünabei gürigia ítaratiña houn?</para>
  <para style="q" vid="JER 5:29">Au le Aburemei ariñagubalin.<verse eid="JER 5:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 5:30" />“Lasusereduña katei hanarimeti le</para>
  <para style="q" vid="JER 5:30">hanufunehabuti lidan ageiraü le.<verse eid="JER 5:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JER 5:31" />Iyeeni le hariñagubei profetagu;</para>
  <para style="q" vid="JER 5:31">hagumadihaña fádirigu kei líchaahouniwa houn.</para>
  <para style="q" vid="JER 5:31">Ani ítara liña habusenruni numutuniña!</para>
  <para style="q" vid="JER 5:31">Gama lumoun kaba san hadüga danme lachülürün</para>
  <para style="q" vid="JER 5:31">lagumuhóun dan?” »<verse eid="JER 5:31" /></para>
  <chapter eid="JER 5" />
  <chapter number="6" style="c" sid="JER 6" />
  <para style="s1">Legeyedaguni ágani Herusalén</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 6:1" />Gürigia lóubawaguna Benhamín,</para>
  <para style="q" vid="JER 6:1">áluaha humá haramudagun anuraha humá Herusaléngiñe!</para>
  <para style="q" vid="JER 6:1">Win humóun fidu Tekóa, iñura humá aban seini Betü-Akeremü,</para>
  <para style="q" vid="JER 6:1">lugundun anitén aban lamiselu luéigiñe nórute.<verse eid="JER 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 6:2" />Herusalén uburugu magadiñeti ani hínsiñeguti,</para>
  <para style="q" vid="JER 6:2">yarafaali barihin weyu;<verse eid="JER 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 6:3" />Hemeraaguba urúeigu ñein hau hasudaranigu,</para>
  <para style="q" vid="JER 6:3">hararamagüdüba hakianpun geyegua bau,</para>
  <para style="q" vid="JER 6:3">kada aban lidan fulasu le labusenrun.<verse eid="JER 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 6:4" />Hariñaga háganiñu:</para>
  <para style="q" vid="JER 6:4">«Aranse humá lun hageindagun luma!</para>
  <para style="q" vid="JER 6:4">Higougu ábürüha wamá luagun amidirugu!</para>
  <para style="q" vid="JER 6:4">Gama lumoun, siñá! Dárühali, búrigaali.<verse eid="JER 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 6:5" />Ábürüha wamaagubei luagun áriebu,</para>
  <para style="q" vid="JER 6:5">günringua waméi luayelesin!»<verse eid="JER 6:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="JER 6:6" />Wabureme le Súntibeigabafu íchugubalin lúrudu le:</para>
  <para style="q" vid="JER 6:6">«Chaün humá wewe adüga humá aban burichi</para>
  <para style="q" vid="JER 6:6">lun hábürühan luagun Herusalén!</para>
  <para style="q" vid="JER 6:6">Siádiwaali lun labeichún</para>
  <para style="q" vid="JER 6:6">lugundun buin liña lau wuribani.<verse eid="JER 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 6:7" />Ésehati wuribani Herusaléngiñe</para>
  <para style="q" vid="JER 6:7">kei lésehan duna lídangiñe aban fusu.</para>
  <para style="q" vid="JER 6:7">Wuribanirügüñein luma anarimeni aganbúa ñein;</para>
  <para style="q" vid="JER 6:7">wóunurügüñein luma gáriti nariha ñein.<verse eid="JER 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 6:8" />Furendeibá Herusalén,</para>
  <para style="q" vid="JER 6:8">lugundun anhein madügün ban,</para>
  <para style="q" vid="JER 6:8">nadiñuruba buéi laume magundani,</para>
  <para style="q" vid="JER 6:8">ábame nígirunibu kei aban fulasu mageirawati,</para>
  <para style="q" vid="JER 6:8">nígirubadibu málouga».<verse eid="JER 6:8" /></para>
  <para style="s1">Lichugúniwa ñunsu luagu abeichúni</para>
  <para style="q">
    <verse number="9" style="v" sid="JER 6:9" />Lariñahare Aburemei Suntigabafu:</para>
  <para style="q" vid="JER 6:9">«Hame Ísüraelina erederutiña, hénrengubei hadarirúniwa</para>
  <para style="q" vid="JER 6:9">gama lumoun háluahouba kei aban lin beibei laganagua sun limu,</para>
  <para style="q" vid="JER 6:9">darime madari hamá ni aban».<verse eid="JER 6:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="JER 6:10" />Aba nóunabun: «Kábagia uma nayanuha?</para>
  <para style="q" vid="JER 6:10">Ánhana hamuga adimureha,</para>
  <para style="q" vid="JER 6:10">kábagia aganbana?</para>
  <para style="q" vid="JER 6:10">Darú hamuti harigeirugu, luéi haganbun;</para>
  <para style="q" vid="JER 6:10">mabusenrúntiña haganbuni bererun adügarügütiña bula lau.<verse eid="JER 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 6:11" />Buin niña lau bigañi, Nabureme,</para>
  <para style="q" vid="JER 6:11">siñá naali ágüdaha».</para>
  <para style="b" vid="JER 6:11" />
  <para style="q" vid="JER 6:11">Lariñaga Wabureme nun:</para>
  <para style="q" vid="JER 6:11">«Ígiragüdabei hawagun nibureinhaña ǘmadarugu,</para>
  <para style="q" vid="JER 6:11">hawagun nibureinhaña ha adaagubaña salufuri ǘmadarugu.</para>
  <para style="q" vid="JER 6:11">Hanügǘba wügüriña hama hámarigu adaürǘwa,</para>
  <para style="q" vid="JER 6:11">hadaürawaguba giñe wéiyaaña mutu.<verse eid="JER 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 6:12" />Haban, hachari hama hámarigu,</para>
  <para style="q" vid="JER 6:12">hásügürüba lumoun amu.</para>
  <para style="q" vid="JER 6:12">Lugundun niñuraali núhabu lun nabeichuniña</para>
  <para style="q" vid="JER 6:12">ha aganóubaña lidan fulasu le.</para>
  <para style="q" vid="JER 6:12">Au le Aburemei ariñagubalin.<verse eid="JER 6:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="JER 6:13" />«Súngubei, wéinamuhaña hama ñǘbürigiña</para>
  <para style="q" vid="JER 6:13">luágunrügüñein íweruhani haritagua;</para>
  <para style="q" vid="JER 6:13">dandu profetagu kei fádirigu, íweruhatiña lau eyeeraguni.<verse eid="JER 6:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 6:14" />Ligibuagugiñe hagumein numutuniña hagaraniha houn;</para>
  <para style="q" vid="JER 6:14">hariñaga luagu lídanñein lan dan sun katei lau sun wuriba lan.<verse eid="JER 6:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 6:15" />Lunti hamuga nibusigari hamá hadügüni burí katei le aubei magundan nan!</para>
  <para style="q" vid="JER 6:15">Gama lumoun masanditiña busiganu,</para>
  <para style="q" vid="JER 6:15">ibidiñegubeihali ka lan busiganubei houn.</para>
  <para style="q" vid="JER 6:15">Ligía danme lubéi nabeichuniña,</para>
  <para style="q" vid="JER 6:15">hachugeraguba ábame héiguadun kei ha híbiri.</para>
  <para style="q" vid="JER 6:15">Au, le Aburemei ariñagubalin».<verse eid="JER 6:15" /></para>
  <para style="s1">Mabuchaha lan Ísüraeli</para>
  <para style="q">
    <verse number="16" style="v" sid="JER 6:16" />Lariñahare Aburemei houn lumutuniña:</para>
  <para style="q" vid="JER 6:16">«Rárama humá luagu burí üma, ariha humá,</para>
  <para style="q" vid="JER 6:16">hálügüdaha luagu binadu üma,</para>
  <para style="q" vid="JER 6:16">hagéi lan üma le buídubei;</para>
  <para style="q" vid="JER 6:16">falá huméi, ábame hadarirun emeraaguni».</para>
  <para style="q" vid="JER 6:16">Aba hariñagun:</para>
  <para style="q" vid="JER 6:16">«Uá, mabusenrúntiwa wafalaruni üma ligía».<verse eid="JER 6:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="JER 6:17" />Ruti Aburemei óunigihatiña, aba lariñagun houn gürigia:</para>
  <para style="q" vid="JER 6:17">«Ru humá arigei lun tumalali fidu».</para>
  <para style="q" vid="JER 6:17">Gama lumoun hariñaga: «Mabusenrúntiwa wadügün gasu lau».<verse eid="JER 6:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="JER 6:18" />Ligía lariñagunbei Aburemei:</para>
  <para style="q" vid="JER 6:18">«Aganba humá néchanigu,</para>
  <para style="q" vid="JER 6:18">subudi huméi le lunbei lasuseredun houn numutuniña.<verse eid="JER 6:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 6:19" />Aganbabá múa:</para>
  <para style="q" vid="JER 6:19">Nanüga aban lamiselu hawagun gürigia ha ladüga hariban,</para>
  <para style="q" vid="JER 6:19">lugundun madügün hamá gasu lau nererun,</para>
  <para style="q" vid="JER 6:19">máhatiña lun haganbuni narufudahan.<verse eid="JER 6:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 6:20" />Kame hanüga kupali nun uburugugiñe Sabá</para>
  <para style="q" vid="JER 6:20">luma burí sagadi hémeti lídangiñe ageiraü díseti?</para>
  <para style="q" vid="JER 6:20">Magundantina lau hadagaragüdün le gudawarügüti</para>
  <para style="q" vid="JER 6:20">ni lau líbiri hadagaragüdün».<verse eid="JER 6:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="JER 6:21" />Ligía lariñagunbei Aburemei:</para>
  <para style="q" vid="JER 6:21">«Nadüga lun hachugeragun gürigia ha, lun héiguadun.</para>
  <para style="q" vid="JER 6:21">Dandu agübürigu kei isaanigu,</para>
  <para style="q" vid="JER 6:21">besinagu, umadagu, sun hagía hóunweguba».<verse eid="JER 6:21" /></para>
  <para style="s1">Hayabin áganiñu nóruterugugiñe</para>
  <para style="p">
    <verse number="22" style="v" sid="JER 6:22" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 6:22">«Laranseruña aban néchani héreti luéigiñe nórute.<verse eid="JER 6:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 6:23" />Anuhein gimara tuma eféin hama;</para>
  <para style="q" vid="JER 6:23">fásitiña, magudemenihabutiña;</para>
  <para style="q" vid="JER 6:23">ítara liña hagúarahan kei liréin barana,</para>
  <para style="q" vid="JER 6:23">wariñu haña hawagu gabayu.</para>
  <para style="q" vid="JER 6:23">Aranseña lun hawuribuhan luma Sión».<verse eid="JER 6:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="JER 6:24" />Hariñagati Gürigia uburugu Herusalén:</para>
  <para style="q" vid="JER 6:24">«Aganba wamaali uganu, méreediwa ladüga wanufude;</para>
  <para style="q" vid="JER 6:24">sanditiwa íruni luma igari kei aban würi agaridutu.<verse eid="JER 6:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 6:25" />Midin humá áraabu, méibuga humá ǘmadarugu!</para>
  <para style="q" vid="JER 6:25">Lugundun gárumateti ágani;</para>
  <para style="q" vid="JER 6:25">anihein óunwenbu anufudei fulasurugu!»<verse eid="JER 6:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="JER 6:26" />Numutuniña, daü humá daüguaü súsutu arufudei higarigu;</para>
  <para style="q" vid="JER 6:26">habalabahóua lidan baligi, hamuisera,</para>
  <para style="q" vid="JER 6:26">hayahua kei dan le lounwen aban isaani le ábanrügüti,</para>
  <para style="q" vid="JER 6:26">lugundun aniteeli le lunbei lagünrinchaguniwa.<verse eid="JER 6:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="JER 6:27" />Lariñahare Aburemei nun: «Hóuchaguabaña numutuniña.</para>
  <para style="q" vid="JER 6:27">Arihabáña ida liña lan hóuserun».<verse eid="JER 6:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 6:28" />Aburemei, sun hagía mabuchahatiña,</para>
  <para style="q" vid="JER 6:28">gürigia marasualugutiña hagía, wuribatiña;</para>
  <para style="q" vid="JER 6:28">ítara haña kei buronse luma gürabu.<verse eid="JER 6:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 6:29" />Dan le láfurun láfugüle garabali lau sun lere</para>
  <para style="q" vid="JER 6:29">aba larürüdaguagüdüni watu gemeti balu.</para>
  <para style="q" vid="JER 6:29">Málati hafinuhóun marumadunbaña,</para>
  <para style="q" vid="JER 6:29">magumuchaguntiña wuribatiña.<verse eid="JER 6:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 6:30" />Lunti lariñawagún hawagu:</para>
  <para style="q" vid="JER 6:30">«Pülata le lunti lagurúniwa,</para>
  <para style="q" vid="JER 6:30">ladüga fui laña Aburemei».<verse eid="JER 6:30" /></para>
  <chapter eid="JER 6" />
  <chapter number="7" style="c" sid="JER 7" />
  <para style="s1">Lapurichihan Heremíasi ténpulurugu</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 7:1" />Aba ladimurehan Aburemei lun Heremíasi, lariñaga lun:<verse eid="JER 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 7:2" />—Ráramaba tubenari litenpulun Aburemei, bariñageime uganu le ñein: Sun lílana Hudá ha ebelurubaña lídangiñe bena le lun háhuduragun lun Aburemei, aganba huméi uganu le, <verse eid="JER 7:2" /><verse number="3" style="v" sid="JER 7:3" />le luganute Aburemei Suntigabafu, le Lubungiute Ísüraeli: Ígira huméi luriban hibagari luma luriban hóuserun, ábame nígirunün lun hasigirun aganawa lidan fulasu le. <verse eid="JER 7:3" /><verse number="4" style="v" sid="JER 7:4" />Memenigida humá hawagun ha eyeedubalün ariñaga: Anuhán litenpulun Aburemei, anuhán litenpulun Aburemei!<verse eid="JER 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 7:5" />—Anhein haransera hibagari luma hóuserun, buidu huguyame hama híbiri gürigia; <verse eid="JER 7:5" /><verse number="6" style="v" sid="JER 7:6" />ánhaña masagarahan humá méteñuhaña, würiña hilaaña úmari, máfaragun huguyame gürigia maduruntiña lidan fulasu le, meseriwidun huguyame kultu houn amu búngiugu, le aubei hagadeiragua hungua, <verse eid="JER 7:6" /><verse number="7" style="v" sid="JER 7:7" />nígirubadün lun hasigirun aganawa ya, lidan fulasu le níchugubei houn hagüchagu lun sun dan.<verse eid="JER 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 7:8" />—Huguya hemenigitün luagu burí dimurei le iyeeniti, meseriwínbei hun lun ni kata. <verse eid="JER 7:8" /><verse number="9" style="v" sid="JER 7:9" />Íweruhatün, áfaraha, agabarahatün, fiñú huguya le málati, águdaha huguya kupali lun Baali, seriwi huguya houn búngiugu, <verse eid="JER 7:9" /><verse number="10" style="v" sid="JER 7:10" />lárigiñe aba hiabin tidoun ténpulu to, to nitenpulun arufudagua hungua nun. Haritaguatün luagu chóurugua humá hungua ya; luagu gayara lan hasigirun adaaguei burí katei le, le aubei magundan nan. <verse eid="JER 7:10" /><verse number="11" style="v" sid="JER 7:11" />Haritaguatün funagia luagu haramudaguagüle lan híwerutiña nitenpulun? Ariha naali sun katei le. Au le Aburemei ariñagubalin. <verse eid="JER 7:11" /><verse number="12" style="v" sid="JER 7:12" />Heiba tidan nisanduariun Siló, furumiñeti fulasu le nanúadirubei lun naganóun ñein, hariheime le nadügübei ñein ladüga luriban nageira Ísüraeli. <verse eid="JER 7:12" /><verse number="13" style="v" sid="JER 7:13" />Lau sun wéridi naadün lan saragu wéiyaasu luagu hóuserun, máhagidün hidin lau le nubeibei, móunabungubei humagidina. Au, le Aburemei ariñagubalin. <verse eid="JER 7:13" /><verse number="14" style="v" sid="JER 7:14" />Ligía kei lubéi nadüga tun Sanduariu to Siloboun, ítara luba nadüga tun ténpulu to, to anuadirúaboun nun, to níchuguboun hun luma houn hagüchagu, to giñe uáguboun hemenigida. <verse eid="JER 7:14" /><verse number="15" style="v" sid="JER 7:15" />Nachagarubadün niñúarürugugiñe kei meha nachagaruniña híbirigu ha ladügawagun Éfürain.<verse eid="JER 7:15" /></para>
  <para style="s1">Magunfulirun lan Ísüraeli</para>
  <para style="p">
    <verse number="16" style="v" sid="JER 7:16" />—Buguya Heremíasi, mafurieidabá hawagu gürigia ha. Mayumuraguabá nun hawagu. Lugundun maganbun nubadibu. <verse eid="JER 7:16" /><verse number="17" style="v" sid="JER 7:17" />Marihin bumuti san le hadügübei lidan burí luburugute Hudá luma lidan burí lémeri Herusalén? <verse eid="JER 7:17" /><verse number="18" style="v" sid="JER 7:18" />Isaanigu abudaha watu, wügüriña ébedei, würiña añoundaguoun fulúaru lun hadaagun durudia lun hadagaragüdün tun bungiu to unboun hagúara lurúeite sielu. Bóugudin luéi lira, anabagua hamutina lau hadagaragüdün diwéin houn amu búngiugu. <verse eid="JER 7:18" /><verse number="19" style="v" sid="JER 7:19" />Gama lumoun sügǘ lau hanabagunina, anabaguatimatiña houngua, lun habusigarigua. Au, le Aburemei ariñagubalin. <verse eid="JER 7:19" /><verse number="20" style="v" sid="JER 7:20" />Ligía nachoururunbalin houn, au, le Aburemei, luagu narariragüdaali lan sun nigañi luagun fulasu le, hawagun gürigia, hawagun animaalugu, luagun burí tídibu wewe le áraabubei luma luagun le alubahóubei. Ítara luba kei aban gudáü le méñeguchati.<verse eid="JER 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 7:21" />Lariñahare Aburemei Suntigabafu le Lubungiute Ísüraeli houn lumutuniña:</para>
  <para style="p" vid="JER 7:21">—Adüga huméi sun adagaragüdüni le gudawarügüti luma adagaragüdüni le habusenrun, hou huguyame lídangiñe úi ligía. <verse eid="JER 7:21" /><verse number="22" style="v" sid="JER 7:22" />Gama lumoun dan le nasagarunbaliña hagüchagu Ehiptugiñe mariñaguntiña ni kata houn libügürü adagaragüdüni le gudawarügüti ni amu luwuyeri adagaragüdüni. <verse eid="JER 7:22" /><verse number="23" style="v" sid="JER 7:23" />Le nariñagubei houn, lun gaganbadi hamá nun; ítara luba lan auba lan Habungiute, hagíame numutuniña. Ariñaga au houn lun hagaburidun keisi nariñaguni houn, lun buídubei lan lidin houn. <verse eid="JER 7:23" /><verse number="24" style="v" sid="JER 7:24" />Gama lumoun maganbun hamutina, madügün hagía gasu nau, ábarüga hígiraguagüdün houngua lun luriban hagaburi. Lubaragiñe hamuga háluahanina, rúrügü haméi hanagan nuagun. <verse eid="JER 7:24" /><verse number="25" style="v" sid="JER 7:25" />Lúmagiñe háfuridun hagüchagu Ehiptugiñe chülǘ lumoun dan le, óunaha naaña sun nani profetagu hun aban lárigi aban. <verse eid="JER 7:25" /><verse number="26" style="v" sid="JER 7:26" />Gama lumoun maganbun humutina, madügün huguya gasu nau, wuribatimarügü hóuserun sügǘ hau hagüchagu.<verse eid="JER 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 7:27" />—Buguya, Heremíasi, ariñagabéi sun burí katei le houn, íbini madügün hamá gasu bau; wáguaba houn, íbini móunabun hamanibu. <verse eid="JER 7:27" /><verse number="28" style="v" sid="JER 7:28" />Ariñagabá houn: “Añahán gürigia ha máhabaña haganbuni Aburemei le Habungiute, maha hagía larufudahóun houn. Gumugua inarüni hayumulugugiñe sunsuinagubei”.<verse eid="JER 7:28" /></para>
  <para style="s1">Habeichúni gibe tubungiute</para>
  <para style="q">
    <verse number="29" style="v" sid="JER 7:29" />Herusalén, sabei bídiburi, fuibei!</para>
  <para style="q" vid="JER 7:29">Beremuha aban uremu híruti luagu burí wübü le mageirawati!</para>
  <para style="q" vid="JER 7:29">Lugundun gáñiha Aburemei houn bumutuniña, ígira laaña.<verse eid="JER 7:29" /></para>
  <para style="b" />
  <para style="p">
    <verse number="30" style="v" sid="JER 7:30" />Lariñahare Aburemei:</para>
  <para style="p" vid="JER 7:30">—Adügaaña lílana Hudá katei le magundantina lau: Ru hamutiña hagübüri haguariuan tidoun ténpulu to anuadirúaboun nun, aba hawiyedunu. <verse eid="JER 7:30" /><verse number="31" style="v" sid="JER 7:31" />Adügatiña aban latarü lun Tófeti luagu fulasu mawübüriti le lani Ben-inomu, lun háguduniña hasaanigu, katei le mariñagun numuti houn, machülügubeiti lidoun nisaminan. <verse eid="JER 7:31" /><verse number="32" style="v" sid="JER 7:32" />Ligía nariñagunbei au le Aburemei luagu lachülürüba lan weyu lun mariñagunhaña lanme lun fulasu ligía Tófeti, ni fulasu wayati le lani Ben-inomu, luéidigiame Fulasu Wayati lánina Áfarahani, ligíaba liri. Ábame hábunahaniña hilaguaaña Tófeti ladüga madarihaña lanme amu fulasu. <verse eid="JER 7:32" /><verse number="33" style="v" sid="JER 7:33" />Héigibei dunuru géigaditiña úi hama animaalu gáñitiña hágubu gürigia hagía, úabei kaba lan abugahaña. <verse eid="JER 7:33" /><verse number="34" style="v" sid="JER 7:34" />Nagumuchaguagüdübei eremuhani lánina fedu luma ugundani, luma uremu lánina maríei uburugugiñe luma lídangiñe sun Herusalén. Lerederuba kei aban fulasu mageirawati.<verse eid="JER 7:34" /></para>
  <chapter eid="JER 7" />
  <chapter number="8" style="c" sid="JER 8" />
  <para style="p">
    <verse number="1" style="v" sid="JER 8:1" />Lariñahare Aburemei:</para>
  <para style="p" vid="JER 8:1">—Lídounme dan ligía, lasagarúba habu urúeigu, ábutigu, fádirigu, profetagu hama sun ha aganóubaña Herusalén lídangiñe hamúaha; <verse eid="JER 8:1" /><verse number="2" style="v" sid="JER 8:2" />ábame higirún lubá weyu, hati hama sun waruguma, houn ha meha hínsiñebaña houn, seriwi hagía houn, falá hamaña, álügüdaha hagía hama, ani hudugua hagía houn. Úabei abudutiña lun lábununiña. Herederuba múarugu kei hádiga animaalugu. <verse eid="JER 8:2" /><verse number="3" style="v" sid="JER 8:3" />Hame erederutiña wínwanñu hádangiñe gürigia wuribatiña ha, lidan furumiñeguarügü fulasu le ñein hamuti lárigiñeme nachagaraguniña, himei habéi óunweni luéi ibagari. Au, le Aburemei Suntigabafu ariñagubalin.<verse eid="JER 8:3" /></para>
  <para style="s1">Lifigoun luma labeichúniwa Ísüraeli</para>
  <para style="p">
    <verse number="4" style="v" sid="JER 8:4" />—Buguya, Heremíasi, subudigüdabei uganu númagiñeti le houn gürigia:</para>
  <para style="b" vid="JER 8:4" />
  <para style="q" vid="JER 8:4">“Dan le héiguadun gürigia, sarayatiña;</para>
  <para style="q" vid="JER 8:4">dan hayuridagun, áluaha hamuti üma.<verse eid="JER 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 8:5" />Ísüraeli, kati uagu bagarabaagua nun?</para>
  <para style="q" vid="JER 8:5">Ka uagu Herusalén bamahada nun, lun súnwandan?</para>
  <para style="q" vid="JER 8:5">Ka uagu babusenra berederun lidan maganbadi ani máhatibu bagiribudun nun?<verse eid="JER 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 8:6" />Rúhadina narigei aganbaha,</para>
  <para style="q" vid="JER 8:6">gama lumoun maganbungidina luagu ni aban asakürihati luagu luriban,</para>
  <para style="q" vid="JER 8:6">lun hamuga lariñagun: Ka san le nadügübei?</para>
  <para style="q" vid="JER 8:6">Sun hagía éibaagueina haña lidan hémeri</para>
  <para style="q" vid="JER 8:6">kei gabayu ha siñawaaña herederúniwa wuriburugu.<verse eid="JER 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 8:7" />Íbini yábura,</para>
  <para style="q" vid="JER 8:7">subudi tumuti lidaani tidin lídangiñe aban fulasu lidoun amu.</para>
  <para style="q" vid="JER 8:7">Sun dunuru subudi hamuti dan le líchugubei Aburemei lun houdin luagun amu oubaü.</para>
  <para style="q" vid="JER 8:7">Ánheinti huguya, numutuniña,</para>
  <para style="q" vid="JER 8:7">ibidiñeti nilurudun hun.<verse eid="JER 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 8:8" />Ka uagu hariñaga luagu chu lan hau,</para>
  <para style="q" vid="JER 8:8">luagu anihein lan lilurudun Aburemei huma?</para>
  <para style="q" vid="JER 8:8">Sánsigua hamaaligu abürühatiña yéetiña?<verse eid="JER 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 8:9" />Gama lumoun herederuba chu tau hagía lau busiganu,</para>
  <para style="q" vid="JER 8:9">luma lau anufudei kei animaalu ábürühatiña tidoun sádara</para>
  <para style="q" vid="JER 8:9">hageiti lichú hau anhein máhaaña lubéi lun nererun?<verse eid="JER 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 8:10" />Ligía nederegerubaña lubéi hámarigu houn amu wügüriña,</para>
  <para style="q" vid="JER 8:10">runeime hamúan houn amu.</para>
  <para style="q" vid="JER 8:10">Ladüga sun hagía, dandu wéinamuhaña kei ñǘbürigiña,</para>
  <para style="q" vid="JER 8:10">luágunrügüñein agañeiruni marumanti hasaminara.</para>
  <para style="q" vid="JER 8:10">Dandu profetagu kei fádirigu, íweruhatiña lau eyeeraguni.<verse eid="JER 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 8:11" />Ligibuagurügüñein hagumein numutuniña hagaraniha houn,</para>
  <para style="q" vid="JER 8:11">hariñaga luagu mama lan sandi wéiriti hawagubei,</para>
  <para style="q" vid="JER 8:11">ani sandi wéiriti.<verse eid="JER 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 8:12" />Lunti hamuga hanügün busiganu lau hadügüni katei le,</para>
  <para style="q" vid="JER 8:12">le aubei magundan nan.</para>
  <para style="q" vid="JER 8:12">Gama lumoun masanditiña busiganu,</para>
  <para style="q" vid="JER 8:12">Ibidiñegubeihali houn ka lan busiganubei!</para>
  <para style="q" vid="JER 8:12">Ligía danme lubéi nabeichuniña,</para>
  <para style="q" vid="JER 8:12">hachugeraguba, ábame héiguadun kei ha híbiri.</para>
  <para style="q" vid="JER 8:12">Au, le Aburemei ariñagubalin”.<verse eid="JER 8:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="JER 8:13" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 8:13">«Nadürüraaña numutuniña kei ladürürǘn türigu.</para>
  <para style="q" vid="JER 8:13">Meredebei ni aban lin beibei lidan beibei-agei,</para>
  <para style="q" vid="JER 8:13">ni aban igu luagu tídibu igu.</para>
  <para style="q" vid="JER 8:13">Ubanaürügübei sáühali eredera».<verse eid="JER 8:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="JER 8:14" />Hariñagame numutuniña:</para>
  <para style="q" vid="JER 8:14">«Ka uagu weredera ya?</para>
  <para style="q" vid="JER 8:14">Keimoun sun wagía lidoun burí uburugu, le baríeiruati,</para>
  <para style="q" vid="JER 8:14">le ñein tumuti áruma áfarawagua wamaamugagubei.</para>
  <para style="q" vid="JER 8:14">Láfaraguaadiwa Wabureme le Wabungiute;</para>
  <para style="q" vid="JER 8:14">líchuguña duna péisiniti woun,</para>
  <para style="q" vid="JER 8:14">ladüga wafigouhan ligibugiñe.<verse eid="JER 8:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 8:15" />Agurabatiwa yebe awanseruni,</para>
  <para style="q" vid="JER 8:15">gama lumoun machülüti ni kata buiti woun.</para>
  <para style="q" vid="JER 8:15">Agurabatiwa yebe átuadi,</para>
  <para style="q" vid="JER 8:15">gama lumoun luéirinrügüñein anufudei ñübuin woun.<verse eid="JER 8:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 8:16" />Aniteeli ágani!</para>
  <para style="q" vid="JER 8:16">Aganbúaali lahunduhan ligabayun Dángiñe.</para>
  <para style="q" vid="JER 8:16">Lidan le hahinhan, adadagarati sun múa.</para>
  <para style="q" vid="JER 8:16">Hayabiña agünrinchaguei fulasu lau sun buiti le lídanbei,</para>
  <para style="q" vid="JER 8:16">hama sun ha aganóubaña lidan».<verse eid="JER 8:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="JER 8:17" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 8:17">«Nóunaha hewe péisinitiña huagun lun hágürühanün,</para>
  <para style="q" vid="JER 8:17">úabei ibiñegu lun lerederuniña».<verse eid="JER 8:17" /></para>
  <para style="s1">Ligarigu Heremíasi luagu lageira</para>
  <para style="q">
    <verse number="18" style="v" sid="JER 8:18" />Máraninati nigarigu,</para>
  <para style="q" vid="JER 8:18">larariruña tuguraasun nanigi.<verse eid="JER 8:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 8:19" />Aganbúati hayahun numutuniña fulasurugu:</para>
  <para style="q" vid="JER 8:19">«Úaali Bungiu uburugu Sión?»</para>
  <para style="q" vid="JER 8:19">Úaali lurúeite ñein?</para>
  <para style="q" vid="JER 8:19">Lariñaga Aburemei:</para>
  <para style="q" vid="JER 8:19">«Kame hanabaguana lau heseriwidun houn guáriua</para>
  <para style="q" vid="JER 8:19">luma houn búngiugu meseriwíntiña ha terencha?»<verse eid="JER 8:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 8:20" />Sügüha lubachouga,</para>
  <para style="q" vid="JER 8:20">gumuha alubahani ani awanhamémegua masalbarúntiwa.<verse eid="JER 8:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 8:21" />Súfuritina lau hasufurirun numutuniña;</para>
  <para style="q" vid="JER 8:21">beluha íruni luma anufudei nun.<verse eid="JER 8:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 8:22" />Úati funa san árani Galaadü?</para>
  <para style="q" vid="JER 8:22">Úati funa kaba lan agaraniha houn ñein?</para>
  <para style="q" vid="JER 8:22">Ka uagu siñá lubéi hareidagun numutuniña?<verse eid="JER 8:22" /></para>
  <chapter eid="JER 8" />
  <chapter number="9" style="c" sid="JER 9" />
  <para style="q">
    <verse number="1" style="v" sid="JER 9:1" />Dúnadügü hamuga nichügü,</para>
  <para style="q" vid="JER 9:1">lísensen hamugati águiraü nagu,</para>
  <para style="q" vid="JER 9:1">lun nayahun áriebu wéyuagu</para>
  <para style="q" vid="JER 9:1">hárigi numutuniña ha óunwegubaña!<verse eid="JER 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 9:2" />Aniheindügü hamuga aban fulasu numa lidan fulasu mageirawati</para>
  <para style="q" vid="JER 9:2">lun nidin aganawa ñein lun nidin diseun luéi nageira.</para>
  <para style="q" vid="JER 9:2">Lugundun wuribatiña sun hagía,</para>
  <para style="q" vid="JER 9:2">ani bóugudin luéi lira mabusenrúntiña haganbun nuagu.<verse eid="JER 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 9:3" />Aranseñu haña súnwandan lun hariñagun iyeeni</para>
  <para style="q" vid="JER 9:3">kamá hamuga hachüühaña gimara.</para>
  <para style="q" vid="JER 9:3">Iyeeni anügübei fulasu fulasurugu,</para>
  <para style="q" vid="JER 9:3">mama inarüni; wuribatimarügaaña,</para>
  <para style="q" vid="JER 9:3">lariñagati Aburemei:</para>
  <para style="q" vid="JER 9:3">«Máhatiña hánharun nun».<verse eid="JER 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 9:4" />Moun lumuti lafiñerún ni luagu umadaü;</para>
  <para style="q" vid="JER 9:4">ni íbini luagu íbiri siñati lafiñerún;</para>
  <para style="q" vid="JER 9:4">lugundun yéeguatiña íbirigu hóuniwagua,</para>
  <para style="q" vid="JER 9:4">adimureha hagía umadagu wuriba hawougua.<verse eid="JER 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 9:5" />Adaaguati aban bula lau le aban,</para>
  <para style="q" vid="JER 9:5">ani úati ariñaguti inarüni.</para>
  <para style="q" vid="JER 9:5">Héchuhaña eyeeha; salufuritiña,<verse eid="JER 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 9:6" />masansirúnti hóuserun.</para>
  <para style="b" vid="JER 9:6" />
  <para style="q" vid="JER 9:6">Lariñahare Aburemei:</para>
  <para style="q" vid="JER 9:6">«Wuribanigubeirügü luma iyeeni hadüga numutuniña,</para>
  <para style="q" vid="JER 9:6">máhatiña hánharun nun.<verse eid="JER 9:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 9:7" />Ligía nariñagunbei, au, le Aburemei Suntigabafu:</para>
  <para style="q" vid="JER 9:7">Kagia amu katei gayaraabei nadügün hau numutuniña,</para>
  <para style="q" vid="JER 9:7">luéidigia lun nádaruniña wáturugun lun nafinuhaniña?<verse eid="JER 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 9:8" />Ítara tiña hañeñe kei gimara gáfarahatu:</para>
  <para style="q" vid="JER 9:8">Iyeeni hadimurehabei. Busuguatiña houn hamadagu,</para>
  <para style="q" vid="JER 9:8">gama lumoun híchuguña sádara habá.<verse eid="JER 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 9:9" />Lunti mabeichun nubaña lan luéigiñe burí katei le?</para>
  <para style="q" vid="JER 9:9">Lun michu nubéi lan le hadünabei gürigia ítaratiña houn?</para>
  <para style="q" vid="JER 9:9">Au, le Aburemei, ariñagubalin.<verse eid="JER 9:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="JER 9:10" />«Hayahuaha lárigi burí wübü</para>
  <para style="q" vid="JER 9:10">heremuha lánina ayahuni luagu sagadi-agei,</para>
  <para style="q" vid="JER 9:10">ladüga gudaburiha, úaaña ásügürütiña ñéingiñe;</para>
  <para style="q" vid="JER 9:10">maganbúnhali hamuuhan bágasu,</para>
  <para style="q" vid="JER 9:10">íbini dunuru hama animaalu gáñitiña anurahouga.<verse eid="JER 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 9:11" />Nadügaali Herusalén ábanme bugan dübü,</para>
  <para style="q" vid="JER 9:11">nadügaali lun hábanme hewe;</para>
  <para style="q" vid="JER 9:11">nadügaali luburugute burí Hudá fulasume mageirawati,</para>
  <para style="q" vid="JER 9:11">úabaña aganóutiña ñein».<verse eid="JER 9:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="JER 9:12" />Ka chubei lau buidu lun gunfurandalani le? Ka un lasubudiragüdei Aburemei burí katei le, lun gayaraabei lan lafuranguagüdüni houn híbiri? Ka uagu günringua lubéi ageiraü, mabei ligía kei aban fulasu mageirawati, le ñéingiñe lubéi ua hamá ásügürütiña?<verse eid="JER 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 9:13" />Lóunaba Aburemei:</para>
  <para style="p" vid="JER 9:13">—Lasuseredunbei sun le, ladüga hígiruni Ísüraelina arufudahani le níchugubei houn; maganbun hamutina ani madügün hamuti le nubeibei. <verse eid="JER 9:13" /><verse number="14" style="v" sid="JER 9:14" />Falá hamuti lagübüri haritagun, aba heseriwidun houn búngiugu ha mama Bungiu kei harufudahan hagübürigu houn. <verse eid="JER 9:14" /><verse number="15" style="v" sid="JER 9:15" />Ligía nariñagunbei au, le Aburemei Suntigabafu, le Lubungiute Ísüraeli: Néigagüdaaña katei gífiti, nátagüdaaña duna péisiniti. <verse eid="JER 9:15" /><verse number="16" style="v" sid="JER 9:16" />Nachagaragubaña hadan gürigia ha ibidiñetiña houn, ni houn hagübürigu; nadügüba lun héibaahoun tau eféin, darime lun merede lan ni aban hádangiñe.<verse eid="JER 9:16" /></para>
  <para style="s1">Ayahuahani Herusalén</para>
  <para style="q">
    <verse number="17" style="v" sid="JER 9:17" />Lariñahare Aburemei Suntigabafu:</para>
  <para style="q" vid="JER 9:17">«Wa humá hawagu würiña ha gabeimahadibaña».<verse eid="JER 9:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="JER 9:18" />Ñübuin hamá furese ayahuaha hamaamuga wawagu;</para>
  <para style="q" vid="JER 9:18">buinla wagu lau águiraü</para>
  <para style="q" vid="JER 9:18">darime lun ladüdürün liyu wagu lárigi wayahun!<verse eid="JER 9:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 9:19" />Aganbatiwa ayahuni lánina igarigu Sióngiñe:</para>
  <para style="q" vid="JER 9:19">Rédeihadiwa lidan günringuaü!</para>
  <para style="q" vid="JER 9:19">Barühadiwa busiganu!</para>
  <para style="q" vid="JER 9:19">Gasu wígiruni wageira,</para>
  <para style="q" vid="JER 9:19">günringua burí waban.<verse eid="JER 9:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 9:20" />Würiña, aganba huméi lererun Bungiu,</para>
  <para style="q" vid="JER 9:20">teni humá lun luganute.</para>
  <para style="q" vid="JER 9:20">Arufudaha humá houn hirahüñü lun hayahun</para>
  <para style="q" vid="JER 9:20">luma houn humadagu lun hamumehan ítara:<verse eid="JER 9:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 9:21" />«Beluti óunweni wábiñoun, chülüti dagá tidoun burí wani palasiu;</para>
  <para style="q" vid="JER 9:21">áfaragua lumutiña irahüñü ǘmadarugu,</para>
  <para style="q" vid="JER 9:21">hama nibureinhaña párükerugu.<verse eid="JER 9:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 9:22" />Rédeitiña hágubu wügüriña hilaguaaña roun áraabu kei hádiga animaalugu</para>
  <para style="q" vid="JER 9:22">kei lilimun türigu le ginti ani úati abuduti».</para>
  <para style="q" vid="JER 9:22">Aburemei ariñagubalin.<verse eid="JER 9:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="JER 9:23" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 9:23">«Mapantahalá chu tau lau lichú lau,</para>
  <para style="q" vid="JER 9:23">ni gabafuti lau lubafu,</para>
  <para style="q" vid="JER 9:23">ni rísiti lau lirisin.<verse eid="JER 9:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 9:24" />Le busenti lapantahan,</para>
  <para style="q" vid="JER 9:24">lapantaha lau lasubudirúnina,</para>
  <para style="q" vid="JER 9:24">lau lasubudirúni luagu au lan Aburemeibei,</para>
  <para style="q" vid="JER 9:24">le adügübalin sun katei ubouagu lau ínsiñehabuni,</para>
  <para style="q" vid="JER 9:24">irichaü luma úarani,</para>
  <para style="q" vid="JER 9:24">lugundun ligía katei le aubei nagundaara.</para>
  <para style="q" vid="JER 9:24">Au, le Aburemei ariñagubalin».<verse eid="JER 9:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="JER 9:25" />Lariñahare Aburemei:</para>
  <para style="p" vid="JER 9:25">—Anitebei weyu lun nabeichaguniña sun ha adügübaña seini tuagu hóustarun gama lumoun magunfulirun hamuti nidaradun, kei burí: <verse eid="JER 9:25" /><verse number="26" style="v" sid="JER 9:26" />Ehiptu, Hudá Edomu, Amón luma Moabü, hama sun ha aganóubaña lidan fulasu mageirawati, ha ásaragubalin herebe. Lugundun sun hagía luma sun Ísüraeli, gabungiutetiña amu nuéi.<verse eid="JER 9:26" /></para>
  <chapter eid="JER 9" />
  <chapter number="10" style="c" sid="JER 10" />
  <para style="s1">Bungiu tímatimaati hama búngiugu</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 10:1" />Ísüraelina, aganba huméi uganu lúmagiñeti Bungiu le, <verse eid="JER 10:1" /><verse number="2" style="v" sid="JER 10:2" />lariñahare Aburemei:</para>
  <para style="b" vid="JER 10:2" />
  <para style="q" vid="JER 10:2">«Mafalara huméi hani híbiri néchanigu hénpulu,</para>
  <para style="q" vid="JER 10:2">malouchun huguyame lau burí seini siélugiñeti,</para>
  <para style="q" vid="JER 10:2">kei hadüga néchani hagía.<verse eid="JER 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 10:3" />Úati hu lan hechun gürigia ha lun ni kata.</para>
  <para style="q" vid="JER 10:3">Cháüntiña aban tugudina wewe áraabu,</para>
  <para style="q" vid="JER 10:3">aba luadigimariduni gagiwerihati tau lichichilin,<verse eid="JER 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 10:4" />lárigiñe aba hewendedagüdüni lau pülata luma golu,</para>
  <para style="q" vid="JER 10:4">aba hádaraguni lau gürabu luéi léiguadun.<verse eid="JER 10:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 10:5" />Ítara haña habungiutegu kei abugahatiña dunuru lidan ichari le ginti;</para>
  <para style="q" vid="JER 10:5">siñati hadimurehan,</para>
  <para style="q" vid="JER 10:5">gasu hóuyuahoun ladüga siñati héibugun.</para>
  <para style="q" vid="JER 10:5">Manufudeda humá hawéi,</para>
  <para style="q" vid="JER 10:5">lugundun madügüntiña wuribati ni buiti ni ka un».<verse eid="JER 10:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="JER 10:6" />Aburemei, úati ni aban kei buguya.</para>
  <para style="q" vid="JER 10:6">Wéiritibu, wéiriguti biri ani gabafuti.<verse eid="JER 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 10:7" />Kaba manufude buéi,</para>
  <para style="q" vid="JER 10:7">buguya le harúeite néchanigu?</para>
  <para style="q" vid="JER 10:7">Lunti inebewa ban.</para>
  <para style="q" vid="JER 10:7">Hadan sun chu tau hama urúeigu ubouagu,</para>
  <para style="q" vid="JER 10:7">úati ni aban kei buguya.<verse eid="JER 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 10:8" />Ibidiouguati hau súngubei.</para>
  <para style="q" vid="JER 10:8">Siñati larufudahan murusun wewe ni kata houn!<verse eid="JER 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 10:9" />Pülata anügǘti lídangiñe fulasu le gíribei Tárüsisi habungiutegubaña,</para>
  <para style="q" vid="JER 10:9">luma golu anügǘti lídangiñe fulasu le gíribei Ufasi,</para>
  <para style="q" vid="JER 10:9">gagiwerihatiña adügübaliña</para>
  <para style="q" vid="JER 10:9">aba hadaüraguagüdüniña tau gamisa guchu tuma funatu,</para>
  <para style="q" vid="JER 10:9">háhüchagun gáhüchaguatiña.<verse eid="JER 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 10:10" />Aburemei Búngiubei le inarüniti,</para>
  <para style="q" vid="JER 10:10">Aburemei le wínwanbei, Urúei lun sun dan.</para>
  <para style="q" vid="JER 10:10">Dan le lagañidun, adadagarati ubóu;</para>
  <para style="q" vid="JER 10:10">siñá hamuti néchanigu ligañi awanda.<verse eid="JER 10:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="JER 10:11" />(Huguya Ísüraelina, ariñaga humá houn gibe tubungiutegu: «Búngiugu ha madügünbalin sielu luma ubóu, hagumuchaguba ubouagugiñe; meredebei ni aban hádangiñe lábugiñe sielu».)<verse eid="JER 10:11" /></para>
  <para style="s1">Uremu lánina lalawahóuniwa Bungiu</para>
  <para style="r">(<ref loc="JER 51:15-19">Her 51.15-19</ref>)</para>
  <para style="q">
    <verse number="12" style="v" sid="JER 10:12" />Aburemei adügübalin múa lau lubafu;</para>
  <para style="q" vid="JER 10:12">derebugugüdalei ubóu lau lichú lau;</para>
  <para style="q" vid="JER 10:12">tulegualéi sielu lau lualin lichügü.<verse eid="JER 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 10:13" />Lau lumalali le ítarabei kei wayuhuru,</para>
  <para style="q" vid="JER 10:13">ahuuhagüda lumuti duna sielu,</para>
  <para style="q" vid="JER 10:13">warigüda lumuti dúeri lígirugugiñe ubóu,</para>
  <para style="q" vid="JER 10:13">durunguagüda lumuti labirihaniga labadinagua huya,</para>
  <para style="q" vid="JER 10:13">sagá lumuti garabali le ñéingiñe lubéi lareidei.<verse eid="JER 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 10:14" />Ibidiouguati hau sun gürigia.</para>
  <para style="q" vid="JER 10:14">Nibusigarigüda hamuti guáriuagu le adügübaliña:</para>
  <para style="q" vid="JER 10:14">Iyawaü ha iyeenitiña guáriuagu, ani mabagaritiña;<verse eid="JER 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 10:15" />kátaña mebegitiña guáriuagu, nibusigaridünatiña,</para>
  <para style="q" vid="JER 10:15">lagünrinchagubaña Aburemei danme laguseragüdün.<verse eid="JER 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 10:16" />Mítaranti Lubungiute Hakobu kei guáriua hagía,</para>
  <para style="q" vid="JER 10:16">Lubungiute Hakobu adügübalin sun le aniheinbei!</para>
  <para style="q" vid="JER 10:16">Anúadira lumuti Ísüraeli keisi lumegen.</para>
  <para style="q" vid="JER 10:16">Aburemei Suntigabafu líribei.<verse eid="JER 10:16" /></para>
  <para style="s1">Labugúba néchani le lumúanrugugiñe</para>
  <para style="q">
    <verse number="17" style="v" sid="JER 10:17" />Buguya néchani le geyegua hamaadibubei báganiñu,</para>
  <para style="q" vid="JER 10:17">budabei bílagu.<verse eid="JER 10:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 10:18" />Lugundun lariñahare Aburemei:</para>
  <para style="q" vid="JER 10:18">«Nachüüraaña lílana fulasu le diseun guentó.</para>
  <para style="q" vid="JER 10:18">Níchigaaña lidoun lénrengunga,</para>
  <para style="q" vid="JER 10:18">ariha náamuga ánhana háluaha».<verse eid="JER 10:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="JER 10:19" />Fugiabu au, lídanñadina günringuaü!</para>
  <para style="q" vid="JER 10:19">Máraninati niwounun!</para>
  <para style="q" vid="JER 10:19">Haritaguatina yebe nawandubei lan gáriti le!<verse eid="JER 10:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 10:20" />Günrinwagua nikianpun, tumuwagua sun tagürüga,</para>
  <para style="q" vid="JER 10:20">fui hamaadina nirahüñü, úaaña!</para>
  <para style="q" vid="JER 10:20">Úaaña kaba lan adaaraguoun nikianpun,</para>
  <para style="q" vid="JER 10:20">kaba lanya átuleraguoun tikorutinan.<verse eid="JER 10:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="JER 10:21" />«Ibidiouguati hau hóuniri mudún ha lídanbaña fulasu le;</para>
  <para style="q" vid="JER 10:21">máluahan hamuti Bungiu.</para>
  <para style="q" vid="JER 10:21">Ligía mawanserún habéi,</para>
  <para style="q" vid="JER 10:21">baragua sun habiñanigu.<verse eid="JER 10:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 10:22" />Aganba humá!</para>
  <para style="q" vid="JER 10:22">Anihánba uganu achülürüti!</para>
  <para style="q" vid="JER 10:22">Anitén aban ladürürühaniga luéigiñe nórute</para>
  <para style="q" vid="JER 10:22">le lunbei lígiruni luburugute burí Hudá fulasume mageirawati</para>
  <para style="q" vid="JER 10:22">le ñeinba lubéi haganawa ounli áraabuna».<verse eid="JER 10:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="JER 10:23" />Aburemei, subudi numuti luagu mama lan wügüri laburemebei libagari,</para>
  <para style="q" vid="JER 10:23">luagu mabafu lan luagu lisinun.<verse eid="JER 10:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 10:24" />Béibawa lau irichaü, Aburemei;</para>
  <para style="q" vid="JER 10:24">mama lau bigañi, ladüga bagumuchaguagüdübadiwa.<verse eid="JER 10:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 10:25" />Rariguagüdabei bigañi hawagun néchanigu ha ibidiñehabubaña bun,</para>
  <para style="q" vid="JER 10:25">ha máluahanbalibu,</para>
  <para style="q" vid="JER 10:25">ladüga hougua hamaaña lílana lageira Hakobu</para>
  <para style="q" vid="JER 10:25">ani günringua hamaaña buidu,</para>
  <para style="q" vid="JER 10:25">aba hígiruni fulasu lidan günringuaü.<verse eid="JER 10:25" /></para>
  <chapter eid="JER 10" />
  <chapter number="11" style="c" sid="JER 11" />
  <para style="s1">Láhalachawaguniwa daradu</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 11:1" />Aba ladimurehan Aburemei nun, au Heremíasi, lariñaga nun:<verse eid="JER 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 11:2" />—Ru hamá Ísüraelina harigei lun le bürüwañubei lidan daradu le. Badimureha houn lílana Hudá luma houn lílana Herusalén, <verse eid="JER 11:2" /><verse number="3" style="v" sid="JER 11:3" />bariñagame houn: Lariñahare Aburemei, le Lubungiute Ísüraeli: Íñarawaguati wügüri le mídinti lau le lubeibei daradu le. <verse eid="JER 11:3" /><verse number="4" style="v" sid="JER 11:4" />Daradu le buga nadügübei hama hagüchagu dan le nasagarunbaliña Ehiptugiñe, ageiraü le meha ítarabei houn kei aban régigi le ñein lubéi larürüdawaguagüda gürabu. Aba nariñagun houn: Adüga huméi le nubeibei, ábame au lan Hubungiute, huguyame numutuniña. <verse eid="JER 11:4" /><verse number="5" style="v" sid="JER 11:5" />Anhaün adüga gasu nau, nagunfulirubei fiñún le meha nadügübei houn hagüchagu lun níchugun aban fulasu houn, fulasu le gádanbaliña guentó, múa rísiti le buiti lun ábunaguni.</para>
  <para style="p" vid="JER 11:5">Aba nóunabuni Aburemei, nariñaga lun:</para>
  <para style="p" vid="JER 11:5">—Anha Nabureme.<verse eid="JER 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 11:6" />Ábati lariñagun Bungiu nun:</para>
  <para style="p" vid="JER 11:6">—Subudigüdabei uganu le lidan burí luburugute Hudá luma luagu burí lémeri Herusalén. Ariñagabá houn gürigia: “Aganba huméi ka lan lariñagubei daradu le, gúnfuli huméi. <verse eid="JER 11:6" /><verse number="7" style="v" sid="JER 11:7" />Dan le nasagarunbaliña hagüchagu Ehiptugiñe ariñagatina houn lun hadügün gasu nau, ani lúmagiñe dan ligía darí guentó, anahamémegua ariñagei houn. <verse eid="JER 11:7" /><verse number="8" style="v" sid="JER 11:8" />Gama lumoun madügüntiña gasu nau, madügün haméi le nubeibei, ábarüga hadügüni luriban haritagun. Máhatiña hagunfuliruni le lariñagubei daradu, ábati nábürügüdüni abeichúni le uágubei lariñaga daradu hawagun”.<verse eid="JER 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 11:9" />Aba lasigirun Aburemei ariñaga:</para>
  <para style="p" vid="JER 11:9">—Gürigia Hudaana hama lílana Herusalén, eledeguatiña nubá. <verse eid="JER 11:9" /><verse number="10" style="v" sid="JER 11:10" />Hadügüñein figóu lememe meha hadügübei hagüchagu ha meha máhabaña haganbunina, aba houdin hárigi amu búngiugu eseriwida houn. Dandu Ísüraelina kei Hudaana, dürügua hamaali daradu le buga nadügübei hama hagüchagu. <verse eid="JER 11:10" /><verse number="11" style="v" sid="JER 11:11" />Ligía nóunaha lubéi aban lamiselu hawagun, le ídangiñebei siñabei lan hesefurun. Íbinime ánhaña agúaraha amuriaha íderawaguni, maganbun nubaña. Au, le Aburemei ariñagubalin. <verse eid="JER 11:11" /><verse number="12" style="v" sid="JER 11:12" />Ábameti houdin lánigu Hudá hama lílana Herusalén amuriaha ídemuei hama búngiugu ha únbaña hágudaha kupali, gama lumoun hásiñarubaña esefura danme lachülürün lamiselu. <verse eid="JER 11:12" /><verse number="13" style="v" sid="JER 11:13" />Ítara kei liibe luburugute Hudá, ítara hiibe lubungiutegu, hayabinti lílana Herusalén, adügaaña saragu latarü lun hágudahan saragu kupali lun Baali. <verse eid="JER 11:13" /><verse number="14" style="v" sid="JER 11:14" />Buguya Heremíasi, mafurieidabá lubeiti hawagu gürigia ha; mafurieidabá mayumuragun buguyame nun hawagu, lugundun maganbun nubadibu, maganbun nubaña danme hamuriahan numa lun níderaguniña labadinagua lamiselu.<verse eid="JER 11:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="JER 11:15" />—Ka táluahabei Ísüraeli to hínsiñeboun nun ténpulurugu, lárigiñe tadügün saragu katei wuribati? Haritaguatu funagia luagu lau lan tanügün agülei luma úi lun adagaragüdüni, ladiseduba lan wuribani tuéi, ani tesefuruba lan ítara? <verse eid="JER 11:15" /><verse number="16" style="v" sid="JER 11:16" />Lidan meha amu dan, au le Aburemei, «oliwu hilumati le buíduburitu lin» liña meha nagúaruni. Ánheinti guentó nágudaali lubana, áhalahaneime lilimun lau wayuhuru héreti.<verse eid="JER 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 11:17" />—Au, le Aburemei Suntigabafu, le ábunubalibu; óunahaadina lamiselu buagun, ladüga figóu le hadügübei Ísüraelina hama Hudaana, ladüga anabagua hamaadina lau hágudahan kupali lun Baali.<verse eid="JER 11:17" /></para>
  <para style="s1">Hálugun láganiñu Heremíasi háfaruni</para>
  <para style="p">
    <verse number="18" style="v" sid="JER 11:18" />Aba lasubudiragüdüni Aburemei nun luagu anihein lan wuribani haritagun náganiñu hadügün. Aba léfegechuni nagu lun nasubudiruni. <verse eid="JER 11:18" /><verse number="19" style="v" sid="JER 11:19" />Darangilu niña yebe, kei aban mudún le anügǘti lun lafarún, ibidiñoun nun luagu haransehaña lan nubá lun háfarunina. Hariñaga:</para>
  <para style="p" vid="JER 11:19">—Chaün waméi tídibu wewe guentó lau sun lin, gidá waméi ubouagugiñe, ua láamuga aritaguti luagun.<verse eid="JER 11:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="JER 11:20" />Gama lumoun buguya, Aburemei Suntigabafu,</para>
  <para style="q" vid="JER 11:20">aban aguseragüdüti richati buguya,</para>
  <para style="q" vid="JER 11:20">subudi bumuti lilulin-agei haritagun gürigia.</para>
  <para style="q" vid="JER 11:20">Arufudabéi babeichuniña gürigia ha nun,</para>
  <para style="q" vid="JER 11:20">ladüga ru naali nikesin búhaburugun.<verse eid="JER 11:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="JER 11:21" />Lariñahare Aburemei houn lílana Anatótu ha yebe abusenrubaña háfarunina, ariñaga hagía nun lun madimurehan nan lidan liri Bungiu anhein mabusenrun nubéi háfarunina:<verse eid="JER 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JER 11:22" />—Nafayeiragüdaadün luagu hidurun; hóunweguba wügüriña nibureingiña wuriburugu, hilagua hagíame würiña lau ilamaü. <verse eid="JER 11:22" /><verse number="23" style="v" sid="JER 11:23" />Meredebei ni aban hádangiñe, lugundun anitebei weyu lun nafayeiragüdünün luagu hidurun, ábame nanügün lamiselu huagun.<verse eid="JER 11:23" /></para>
  <chapter eid="JER 11" />
  <chapter number="12" style="c" sid="JER 12" />
  <para style="s1">Ladimurehan profeta lun Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 12:1" />Aburemei, ánhana asigeneha buma, garichatibu súnwandan;</para>
  <para style="q" vid="JER 12:1">gama lumoun lau sun lira, busentina hamuga nálügüdünibu libügürü fiu katei.</para>
  <para style="q" vid="JER 12:1">Ka uagu buidu lubéi lidin houn gürigia wuribatiña?</para>
  <para style="q" vid="JER 12:1">Ka uagu darangilu lubéi habagaridun ha gachansihadibaña?<verse eid="JER 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 12:2" />Bunagua bumutiña, aba lárügüdün hálagüle,</para>
  <para style="q" vid="JER 12:2">aba haweinamudun aba hagindun.</para>
  <para style="q" vid="JER 12:2">Yarafatibu houn hayumulugugiñe,</para>
  <para style="q" vid="JER 12:2">gama lumoun tidan hanigi dísetibu hawéi.<verse eid="JER 12:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 12:3" />Ánhabuti buguya, Nabureme, subudi bumutina;</para>
  <para style="q" vid="JER 12:3">aríagu biña nun ani subudi bumuti lueirin bínsiñe nun.</para>
  <para style="q" vid="JER 12:3">Barübaña gürigia ha keisi mudún lun háfarawagun;</para>
  <para style="q" vid="JER 12:3">makübáña lubá luéyuri áfarahani.<verse eid="JER 12:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 12:4" />Dariba san ídaame mábeiñu lan múa, ani saü ligíame sagadi áraabu?</para>
  <para style="q" vid="JER 12:4">Hóunweguña animaalugu hama dunuru ladüga hariban lílana fulasu,</para>
  <para style="q" vid="JER 12:4">ha aritagubaña luagu marihinbani le hadügübei.<verse eid="JER 12:4" /></para>
  <para style="s1">Lóunabun Bungiu</para>
  <para style="q">
    <verse number="5" style="v" sid="JER 12:5" />«Anhein buchá lubéi buagu,</para>
  <para style="q" vid="JER 12:5">éibaagua kóntüra gürigia ha eibu umutiña,</para>
  <para style="q" vid="JER 12:5">ida lubagia béibaagun kóntüra gürigia ha gabayuagutiña?</para>
  <para style="q" vid="JER 12:5">Anhein chugegua bubéi aba béiguadun lidan múa le úaraguati,</para>
  <para style="q" vid="JER 12:5">Kábagia badüga lidan lidabiaran Hordán?<verse eid="JER 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 12:6" />Íbini bíbirigu ha hádangiñetiña biduheñu garabaguaaña buagun,</para>
  <para style="q" vid="JER 12:6">wáguatiña anababu banagangiñe.</para>
  <para style="q" vid="JER 12:6">Mafiñerabá hawagu ni ánhaña adimureha bun lau dimurei buiti.<verse eid="JER 12:6" /></para>
  <para style="s1">Lirun Wabureme luagu lásügürün Ísüraeli</para>
  <para style="q">
    <verse number="7" style="v" sid="JER 12:7" />«Ígira naali nageira,</para>
  <para style="q" vid="JER 12:7">mabusenrun naaru to meha nániboun.</para>
  <para style="q" vid="JER 12:7">Ru naaña gürigia ha meha wéiribei hínsiñe nun háhaburugun háganiñu.<verse eid="JER 12:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 12:8" />Gürigia ha, ha meha nánigubaña</para>
  <para style="q" vid="JER 12:8">ítara haña nun guentó kei aban liñún dabiararugu;</para>
  <para style="q" vid="JER 12:8">áünhatiña nubaroun, ligía heyereegudúnbei nun.<verse eid="JER 12:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 12:9" />Ítara haña numutuniña kei aban dunuru le buíduburiti liyu,</para>
  <para style="q" vid="JER 12:9">le úmabei hageindagua amu dunuru.</para>
  <para style="q" vid="JER 12:9">Higougu sun animaalugu áraabuna;</para>
  <para style="q" vid="JER 12:9">óundaragua humá lun hadinerun!<verse eid="JER 12:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 12:10" />Saraguhaña ábutigu ha áganiñu adügüraguti nubeibein-agei,</para>
  <para style="q" vid="JER 12:10">adüga hamaali múa le meha hínsiñetimabei nun fulasume mageirawati.<verse eid="JER 12:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 12:11" />Ígira hamaali lidan günringuaü, málouga, ani ariha numuti layahun.</para>
  <para style="q" vid="JER 12:11">Málaali sun fulasu, gama lumoun úati ebereseruti lau.<verse eid="JER 12:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 12:12" />Ñǘbuintiña wügüriña gáñitiña lídangiñe sun wübü</para>
  <para style="q" vid="JER 12:12">lídangiñe fulasu mageirawati,</para>
  <para style="q" vid="JER 12:12">ladüga au, le Aburemei,</para>
  <para style="q" vid="JER 12:12">anuhein aban eféin numa to lunboun tagünrinchaguni fulasu</para>
  <para style="q" vid="JER 12:12">lúmagiñe lagumeseha dagá lumoun lébeha,</para>
  <para style="q" vid="JER 12:12">ani úabei darangilaü ni ka un.<verse eid="JER 12:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 12:13" />Bunaguatiña türigu, aba halubahan hiiyu;</para>
  <para style="q" vid="JER 12:13">málati sun hawadigimari.</para>
  <para style="q" vid="JER 12:13">Mabuidunti alubahani, ladüga lanarime nigañi».<verse eid="JER 12:13" /></para>
  <para style="s1">Füramasei houn lubesinanigu Ísüraeli</para>
  <para style="p">
    <verse number="14" style="v" sid="JER 12:14" />Lariñahare Bungiu hawagu gürigia wuribatiña ha lubesinanigu Ísüraeli, ha agünrinchagubalin múa le líchugubei keisi alagan houn Ísüraelina ha lumutuniña:</para>
  <para style="p" vid="JER 12:14">—Náhulubaña hamúanrugugiñe, ábame nasagaruni Hudá hádangiñe. <verse eid="JER 12:14" /><verse number="15" style="v" sid="JER 12:15" />Gama lumoun lárigiñeme náhuluniña, hagudemedubaya nun, ábame nagiribudagüdüniña hamúanrugun, lun hageiroun. <verse eid="JER 12:15" /><verse number="16" style="v" sid="JER 12:16" />Inarüni luagu hagía lan arufudahabaña houn numutuniña lun háfiñurun lidan liri Baali, gama lumoun guentó, gayaraabei haganóun haganagua numutuniña, ánhaña ánhara lun ligaburi hafiñerun numutuniña nuagu, fiñú hagíame lidan niri ariñageina: “Luagu libagari Aburemei”. <verse eid="JER 12:16" /><verse number="17" style="v" sid="JER 12:17" />Ánhañati gürigia ha mídintiña lau le nubeibei, náhulubaña lau sun hálagüle, ábame nagünrinchaguniña. Au, le Aburemei ariñagubalin.<verse eid="JER 12:17" /></para>
  <chapter eid="JER 12" />
  <chapter number="13" style="c" sid="JER 13" />
  <para style="s1">Larufudúniwa magunfulirun lan Ísüraeli</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 13:1" />Lariñaga Aburemei nun:</para>
  <para style="p" vid="JER 13:1">—Beiba, bagañeihame aban galasunsiyu tautu gamisa to linu, ábame badaürünu biranaagua, gama lumoun madüdüragüdaboun lau duna lubaragiñe badaürünu. <verse eid="JER 13:1" /><verse number="2" style="v" sid="JER 13:2" />Aba nagañeihanu galasunsiyu tuguya kei lariñaguni Aburemei nun, aba nadaürünu. <verse eid="JER 13:2" /><verse number="3" style="v" sid="JER 13:3" />Ábayati ladimurehan Bungiu numa, lariñaga nun:<verse eid="JER 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 13:4" />—Barüboun galasunsiyu to bagañeihaboun, to buáguboun, beiba lárurugun duna Éufüratesi, ábame baramudunu ñein lidan luhuyun aban dübü.<verse eid="JER 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 13:5" />Ábati nidin larun duna Éufüratesi, aba naramudunu galasunsiyu ñein kei lariñaguni Bungiu nun.<verse eid="JER 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 13:6" />Saragu dan lárigiñe, aba lariñagun Bungiu nun:</para>
  <para style="p" vid="JER 13:6">—Beiba anügoun galasunsiyu to uáguboun nariñaga bun lun baramudunu laru duna Éufüratesi.<verse eid="JER 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 13:7" />Aba nidin, aba nasagarunu galasunsiyu tuguya lídangiñe fulasu le ñein lubéi naramudoun, gama lumoun ñalaaru, meseriwínharu lun ni kata. <verse eid="JER 13:7" /><verse number="8" style="v" sid="JER 13:8" />Ábayati ladimurehan Aburemei nun, <verse eid="JER 13:8" /><verse number="9" style="v" sid="JER 13:9" />lariñaga nun:</para>
  <para style="p" vid="JER 13:9">—Ítarameme luba nagünrinchaguni lupantan Hudá luma Herusalén. <verse eid="JER 13:9" /><verse number="10" style="v" sid="JER 13:10" />Gürigia wuribatiña ha, ha máhabaña haganbuni nererun, hadügei lagübüri haritagun. Houdin hárigi amu búngiugu lun heseriwidun houn luma lun háhuduragun houn. Ítara haña kei galasunsiyu to, meseriwínharu lun ni kata. <verse eid="JER 13:10" /><verse number="11" style="v" sid="JER 13:11" />Ítara kei támurudun galasunsiyu luagu iranaaguaü, ítara haña meha lánigu Ísüraeli hama lánigu Hudá numa, lun yebe hagíaba lan numutuniña, lun hasubudiragüdüni niri, lun hamuga hagíaba lan nuéirigun, gama lumoun maganbun hamutina. Au, le Aburemei ariñagubalin.<verse eid="JER 13:11" /></para>
  <para style="s1">Fudu tau diwéin</para>
  <para style="p">
    <verse number="12" style="v" sid="JER 13:12" />Ariñagabá giñe houn:</para>
  <para style="p" vid="JER 13:12">—Lariñahare Aburemei, le Lubungiute Ísüraeli: “Gayaraati labuinchawagüdün furumiñeguarügü ágeidinaü tau diwéin!” Hóunabubadibu Ísüraelina, hariñagame bun: “Ibidiñeti funagia woun luagu gayara lan labuinchawagüdün furumiñeguarügü ágeidinaü tau diwéin?” <verse eid="JER 13:12" /><verse number="13" style="v" sid="JER 13:13" />Bariñagame houn: “Lariñahare Aburemei: Nabacharuadagüdaaña sun ha aganóubaña lidan ageiraü le; urúeigu ha añuurubaña luagu lálana larúeihan Dawidi, fádirigu hama profetagu hama sun ha aganóubaña Herusalén. <verse eid="JER 13:13" /><verse number="14" style="v" sid="JER 13:14" />Lárigiñeme ábame nabuguchagüdüniña hawougua ítara kei labuguchun aban weru luagu amu lun labouchagun, dandu agübürigu kei isaanigu. Magudemenbaña nun; nagünrinchagubaña magudemehabuga. Au, le Aburemei ariñagubalin”.<verse eid="JER 13:14" /></para>
  <para style="s1">Anaaguni unguaü luma abeichúni</para>
  <para style="q">
    <verse number="15" style="v" sid="JER 13:15" />Ísüraelina, ayanuhaalitia Aburemei!</para>
  <para style="q" vid="JER 13:15">Mapantan humá, teni humá lun le lariñagubei.<verse eid="JER 13:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 13:16" />Ru humá uéiriguni lun Aburemei le Hubungiute,</para>
  <para style="q" vid="JER 13:16">lubaragiñe lóunahani lanarime luburiga lun hachugeragun lidan,</para>
  <para style="q" vid="JER 13:16">heiguadaméti ladüga burí wewe áraabu;</para>
  <para style="q" vid="JER 13:16">lídanmeti hagúahan luagu larugounga luburigarügüba hadarira.<verse eid="JER 13:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 13:17" />Anhaün madügün gasu,</para>
  <para style="q" vid="JER 13:17">nayahuba aramudaguarügü ladüga hupantan;</para>
  <para style="q" vid="JER 13:17">láwiyuhaba águiraü nágurugugiñe luéigiñe hanügǘn lánigu Aburemei adaürawagúa.<verse eid="JER 13:17" /></para>
  <para style="s1">Ñunsu lúmagiñeti Bungiu lun urúei</para>
  <para style="q">
    <verse number="18" style="v" sid="JER 13:18" />«Ariñagabá lun urúei luma tun urúei úguchuru:</para>
  <para style="q" vid="JER 13:18">“Rarí humá luéigiñe lálana arúeihani,</para>
  <para style="q" vid="JER 13:18">ñurú humá múarugu,</para>
  <para style="q" vid="JER 13:18">ladüga heigua ridi le meha ewendedagüdübalün hábulugugiñe”.<verse eid="JER 13:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 13:19" />Geyewagua luburugute burí Négebü;</para>
  <para style="q" vid="JER 13:19">siñati lásügürün ni aban.</para>
  <para style="q" vid="JER 13:19">Sagawagua sun lílana Hudá hageiragiñe</para>
  <para style="q" vid="JER 13:19">lun hanügǘniwa lidoun amu ageiraü.<verse eid="JER 13:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 13:20" />Iñura huméi harihin,</para>
  <para style="q" vid="JER 13:20">ariha humá liabin ágani luéigiñe nórute.</para>
  <para style="q" vid="JER 13:20">Hagaña gürigia ha níchugubaña labun baríaahan,</para>
  <para style="q" vid="JER 13:20">gürigia ha meha áubaña bapantaha?<verse eid="JER 13:20" /></para>
  <para style="s1">Ladimurehoun hasagarúniwa Ísüraelina hageiragiñe</para>
  <para style="q">
    <verse number="21" style="v" sid="JER 13:21" />«Kábagia bariñaga Herusalén,</para>
  <para style="q" vid="JER 13:21">danme hagumadirunibu gürigia ha buga únbaña barufudaha?</para>
  <para style="q" vid="JER 13:21">Basandiruba igarigu kei würi to agaridutu.<verse eid="JER 13:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 13:22" />Ánhabu álügüdaha ka lan uagu lasusereda le bun,</para>
  <para style="q" vid="JER 13:22">lunti basubudiruni luagu ladüga lan lanarime bifigoun;</para>
  <para style="q" vid="JER 13:22">ligía haragachaguagüdünbalibu, ani adüga haméi habusenrun bau!<verse eid="JER 13:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 13:23" />Gayaraati funagia lasansiruni aban Etiopíana líwurin lura?</para>
  <para style="q" vid="JER 13:23">O gayaraati lagidaruni géigusi lédehan lura?</para>
  <para style="q" vid="JER 13:23">Ni giñe huguya le héchuhalibei adüga wuribani,</para>
  <para style="q" vid="JER 13:23">siñati hadügüni le buídubei.<verse eid="JER 13:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 13:24" />Ligía nachagaraguagüdaadün lubéi kei ifei le</para>
  <para style="q" vid="JER 13:24">lanaahan garabali luéigiñe fulasu mageirawati.<verse eid="JER 13:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 13:25" />Ligía bisinunbei Ísüraeli,</para>
  <para style="q" vid="JER 13:25">ligía badünabei lun nadügüni bun.</para>
  <para style="q" vid="JER 13:25">Au, le Aburemei ariñagubalin.</para>
  <para style="q" vid="JER 13:25">Ladüga babulieidagun nuéi,</para>
  <para style="q" vid="JER 13:25">aba bíchuguni bemenigin hawagu búngiugu ha iyeenitiña.<verse eid="JER 13:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 13:26" />Nasurusugüdaadibu giñe,</para>
  <para style="q" vid="JER 13:26">lun banügün busiganu.<verse eid="JER 13:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JER 13:27" />Ariha naali lueirin bínsiñehabu, bagabarahan,</para>
  <para style="q" vid="JER 13:27">lubusigaridüna ligaburi bahoruhan,</para>
  <para style="q" vid="JER 13:27">luma liwiye bóuserun luagu burí wübü luma burí áraabu.</para>
  <para style="q" vid="JER 13:27">Fugiabu buguya, Herusalén!</para>
  <para style="q" vid="JER 13:27">Átiribei san dan bau wíyeñu nigibugiñe?»<verse eid="JER 13:27" /></para>
  <chapter eid="JER 13" />
  <chapter number="14" style="c" sid="JER 14" />
  <para style="s1">Lueirin lumabeinga</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 14:1" />Ladüga lueirin lumabeiniga,</para>
  <para style="q" vid="JER 14:1">aba ladimurehan Aburemei lun Heremíasi, lariñaga lun:<verse eid="JER 14:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JER 14:2" />«Layahuña Hudá lau íruni,</para>
  <para style="q" vid="JER 14:2">híruti sun burí luburugute,</para>
  <para style="q" vid="JER 14:2">roun haña burí gürigia múarugu.</para>
  <para style="q" vid="JER 14:2">Wáguati Herusalén le lánina igarigu.<verse eid="JER 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 14:3" />Óunaha hamutiña rísitiña hamusuniña áluaha duna;</para>
  <para style="q" vid="JER 14:3">ñǘdüntiña musu fúsurugu,</para>
  <para style="q" vid="JER 14:3">gama lumoun madaritiña duna,</para>
  <para style="q" vid="JER 14:3">aba hagiribudun lau hágeidina málouga;</para>
  <para style="q" vid="JER 14:3">aba hadouragun lau hachügü le habusigari.<verse eid="JER 14:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 14:4" />Daruguatiña ábunagutiña nadü lau hábulugu</para>
  <para style="q" vid="JER 14:4">ladüga máhuyun lan huya, ani mábeiti múa.<verse eid="JER 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 14:5" />Íbini usari áraabu,</para>
  <para style="q" vid="JER 14:5">ígira hamutiña harahüñü ha sun liña hemeilihóun,</para>
  <para style="q" vid="JER 14:5">ladüga úati sagadi lun heigin.<verse eid="JER 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 14:6" />Ráramatiña burigü áraabuna luagu burí wübü mábeiti</para>
  <para style="q" vid="JER 14:6">ata garabali kei ounli áraabuna,</para>
  <para style="q" vid="JER 14:6">aba laburigadun harihin ladüga lúan sagadi lun heigin».<verse eid="JER 14:6" /></para>
  <para style="s1">Lagúaruni profeta Wabureme luagu fulasu</para>
  <para style="q">
    <verse number="7" style="v" sid="JER 14:7" />Nabureme, lau sun arufuda lániwa wafigoun keisi gaduruntiña,</para>
  <para style="q" vid="JER 14:7">luagu luéirigun biri, arihabá wawagun!</para>
  <para style="q" vid="JER 14:7">Charaadiwa bun saragu, afigouhaadiwa bigibugiñe.<verse eid="JER 14:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 14:8" />Lemenigin Ísüraeli, wasalbaragüle lidan lénrengunga,</para>
  <para style="q" vid="JER 14:8">ka uagu bóusera kei aban terencha fulasurugu,</para>
  <para style="q" vid="JER 14:8">kei aban gaweiyasunti le rédeirügüti ásügüra aban áriebu?<verse eid="JER 14:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 14:9" />Ka uagu beredera kei aban gürigia bulíeiguaali,</para>
  <para style="q" vid="JER 14:9">kei aban wuriburuguna le siñati lídehan?</para>
  <para style="q" vid="JER 14:9">Gama lumoun Nabureme, abunhein wama,</para>
  <para style="q" vid="JER 14:9">subudi hamuti súngubei luagu bánigu lan wagía.</para>
  <para style="q" vid="JER 14:9">Mígirabawa!<verse eid="JER 14:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="JER 14:10" />Lariñahare Aburemei libügürü Ísüraeli:</para>
  <para style="p" vid="JER 14:10">—Hésebetiña gürigia ha yagüroun yaroun. Ligía magundan nubéi hau. Guentó, naritagua luagu hafigoun, nafayeiragüdaaña luagu.<verse eid="JER 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 14:11" />Lariñaga Aburemei nun:</para>
  <para style="p" vid="JER 14:11">—Mayumuraguabá nun luagu buiti houn gürigia ha. <verse eid="JER 14:11" /><verse number="12" style="v" sid="JER 14:12" />Íbini hayunarun saragu, maganbun nubéi hayumuragun; íbini hanügün saragu adagaragüdüni le gudawarügüti luma idewesei le fulúaruauti nun, magundaarunbadina lau. Nagumuchaguagüdaaña lau wuribu, ilamaü luma sandi.<verse eid="JER 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 14:13" />Aba nóunabuni:</para>
  <para style="p" vid="JER 14:13">—Gama lumoun, Nabureme; añahán profetagu ariñaga houn gürigia luagu úabei lan wuribu ni ilamaü, ani bíchuguba lan darangilaü magumuchaditi houn lidan fulasu le.<verse eid="JER 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 14:14" />Ábati lariñagun Aburemei nun:</para>
  <para style="p" vid="JER 14:14">—Anhein ligía lubéi hariñagubei profetagu lidan niri, heyeehaña. Móunahan numutiña, mariñagun au ni kata houn, madimurehangubeitina houn. Uénedü yeeti sun lira, katei le burí hadüga houngua, hasaminan houngua, ligía le hariñagunbei profetagu houn. <verse eid="JER 14:14" /><verse number="15" style="v" sid="JER 14:15" />Nariñahare au, le Aburemei, hawagu profetagu ha ariñagubaña luagu lidan lan niri hadimureha móunahanganaña, ani ariñaga hagía luagu úabei lan wuribu ni ilamaü lidan fulasu le: Hóunweguba profetagu hagía ladüga wuribu luma ilamaü. <verse eid="JER 14:15" /><verse number="16" style="v" sid="JER 14:16" />Gürigia ha únbaña hadimureha, hóunweguba giñe ladüga wuribu luma ilamaü hau sun hámarigu hama hasaanigu. Hachagarúba hilaaña lidan burí lémeri Herusalén, úabei kaba lan ábunaña. Ítara luba nafayeiragüdüniña luagu hariban.<verse eid="JER 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 14:17" />Ariñagabéi katei le houn gürigia:</para>
  <para style="b" vid="JER 14:17" />
  <para style="q" vid="JER 14:17">«Lésehaba águiraü nágurugugiñe wéyuagu áriebu,</para>
  <para style="q" vid="JER 14:17">luagu lueirin lásügürün nageira,</para>
  <para style="q" vid="JER 14:17">ladüga lueirin wounu le luágubei.<verse eid="JER 14:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 14:18" />Nidin áraabu, añaha ha óunwegubaña wuriburugu;</para>
  <para style="q" vid="JER 14:18">nebelura uburugun, añaha gürigia óunwegua halama.</para>
  <para style="q" vid="JER 14:18">Íbini profetagu hama fádirigu,</para>
  <para style="q" vid="JER 14:18">ñǘdünguatiña lidoun fulasu le ibidiñeti houn».<verse eid="JER 14:18" /></para>
  <para style="s1">Layanuhan profeta lun Wabureme</para>
  <para style="q">
    <verse number="19" style="v" sid="JER 14:19" />«Wabureme, fui baali san Hudá le tímatimaati?</para>
  <para style="q" vid="JER 14:19">Buchá san buagu lubá uburugu Sión?</para>
  <para style="q" vid="JER 14:19">Ka uagu bíchiga sandi mareidaguaditi wawagu?</para>
  <para style="q" vid="JER 14:19">Agurabatiwa yebe darangilaü,</para>
  <para style="q" vid="JER 14:19">gama lumoun miábinti ni kata buiti woun,</para>
  <para style="q" vid="JER 14:19">agurabatiwa átuadi liábinrüga anufudei.<verse eid="JER 14:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 14:20" />Ariha wamuti wariban luma hadurun wagüchagu;</para>
  <para style="q" vid="JER 14:20">afigouhaadiwa bigibugiñe, Aburemei.<verse eid="JER 14:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 14:21" />Luagu luéirigun biri, mágurabawa;</para>
  <para style="q" vid="JER 14:21">móuserabei uburugu le ñein</para>
  <para style="q" vid="JER 14:21">lubéi lálana barúeihan lau mebereseni.<verse eid="JER 14:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 14:22" />Anihein funagia aban hádangiñe guáriuagu le gayaraati láhuyagüdün huya?</para>
  <para style="q" vid="JER 14:22">Sielu guánarügü funagia áhuyagüdübei huya?</para>
  <para style="q" vid="JER 14:22">Uá, Wabureme, Wabungiute!</para>
  <para style="q" vid="JER 14:22">Buguya óunahabalin huya;</para>
  <para style="q" vid="JER 14:22">buguya adügübalin sun katei le,</para>
  <para style="q" vid="JER 14:22">ligía wemenigidúnbei buagu».<verse eid="JER 14:22" /></para>
  <chapter eid="JER 14" />
  <chapter number="15" style="c" sid="JER 15" />
  <para style="s1">Ladimurehóuniwa luagu abeichúni</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 15:1" />Aba lariñagun Aburemei nun:</para>
  <para style="p" vid="JER 15:1">—Ni anhein ñübuin Moisesi luma Samueli arufudagua houngua nigibugiñe, magudemedunbaña gürigia ha nun. Ariñagabá houn lun háfuridun niñúarürugugiñe, lun houdin, <verse eid="JER 15:1" /><verse number="2" style="v" sid="JER 15:2" />ánhabu hálügüda haliñounba lan houdin, bariñagame houn nóunahaña lan ariñaga:</para>
  <para style="b" vid="JER 15:2" />
  <para style="q" vid="JER 15:2">“Ha siádiwaañabaña lun hóunwegun lau sandi,</para>
  <para style="q" vid="JER 15:2">lauba sandi hóunwegua;</para>
  <para style="q" vid="JER 15:2">ha lúnbaña hóunwegun wuriburugu,</para>
  <para style="q" vid="JER 15:2">lídanba awuribuhani hóunwegua;</para>
  <para style="q" vid="JER 15:2">ha lúnbaña hóunwegun lau ilamaü, lau ilamaü,</para>
  <para style="q" vid="JER 15:2">ha lúnbaña hasagarún hageiragiñe,</para>
  <para style="q" vid="JER 15:2">hasagarúba hageiragiñe”.<verse eid="JER 15:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="JER 15:3" />Au, le Aburemei, nariñahare:</para>
  <para style="p" vid="JER 15:3">—Nóunaha gádürü ámuñegueina luwuyeri abeichúni hawagun: Háfarawaguba wuriburugu, haduruuhabaña ounli, héigibaña dunuru ha géigaditiña úi, héigibaña animaalu gáñitiña. <verse eid="JER 15:3" /><verse number="4" style="v" sid="JER 15:4" />Nadügüba lun hanufudedun gürigia lau le lunbei nadügüni hau, ladüga le ladügübei Manasési, le liráü Esekíasi, le lurúeite Hudá Herusalén.<verse eid="JER 15:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="JER 15:5" />«Kaba gudemehabu bun Herusalén?</para>
  <para style="q" vid="JER 15:5">Kaba ahirudagua buagu?</para>
  <para style="q" vid="JER 15:5">Kaba eberesera luagu ida biña lan?<verse eid="JER 15:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 15:6" />Ígira bumutina, ru bumuti banagan nuagun.</para>
  <para style="q" vid="JER 15:6">Au, le Aburemei ariñagubalin.</para>
  <para style="q" vid="JER 15:6">Ligía labuchadunbei nuagu bubá,</para>
  <para style="q" vid="JER 15:6">aba niñuruni núhabu lun nabeichunibu, aba nagünrinchagunibu.<verse eid="JER 15:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 15:7" />Aba nachagaraguniña bumutuniña kei ifei</para>
  <para style="q" vid="JER 15:7">lau nasagaruniña fulasurugugiñe.</para>
  <para style="q" vid="JER 15:7">Ígira numutiña marahüñüga, aba nagünrinchaguniña,</para>
  <para style="q" vid="JER 15:7">ladüga hamahan hígiruni luriban habagari.<verse eid="JER 15:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 15:8" />Ígiratina saragu würiña hilaguaaña úmarigu haganagua</para>
  <para style="q" vid="JER 15:8">sügǘ lau sagoun le lárubei beya.</para>
  <para style="q" vid="JER 15:8">Meni amidirugu nígiragüdei óunweni hawagun úguchurugu hau hasaanigu;</para>
  <para style="q" vid="JER 15:8">sódini nóunaha íruni luma anufudei hawagun.<verse eid="JER 15:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 15:9" />Óunweeguatiña úguchurugu ha gibe tirahüñü,</para>
  <para style="q" vid="JER 15:9">aba herederun magarabalinga;</para>
  <para style="q" vid="JER 15:9">buin lau busiganu, aba lagarabaagun larugounga weyu houn lun luburigame.</para>
  <para style="q" vid="JER 15:9">Ánhaña eredera hádangiñe lau ibagari nóunahabaña háganiñu áfaraguaña.</para>
  <para style="q" vid="JER 15:9">Au le Aburemei ariñagubalin».<verse eid="JER 15:9" /></para>
  <para style="s1">Lagúaragun profeta</para>
  <para style="q">
    <verse number="10" style="v" sid="JER 15:10" />Fugiabu au, núguchu,</para>
  <para style="q" vid="JER 15:10">au le bagaraüdübei lúnrügü nasigenehan</para>
  <para style="q" vid="JER 15:10">luma lun nageindagun hama sun mutu!</para>
  <para style="q" vid="JER 15:10">Mafuredeirúngidina seinsu ni ka un, mafuredeirúniwa ligía nun.</para>
  <para style="q" vid="JER 15:10">Gama lumoun, sun gürigia íñaragua hamutina.<verse eid="JER 15:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 15:11" />Dagala híñaragun nuagu, Nabureme,</para>
  <para style="q" vid="JER 15:11">anhein meseriwidun nubéi bun buidu,</para>
  <para style="q" vid="JER 15:11">anhein mayumuragun nubéi bun luagu hafulesein náganiñu,</para>
  <para style="q" vid="JER 15:11">dan le lídanñanu lan lamiselu.<verse eid="JER 15:11" /></para>
  <para style="s1">Lasubudiragüdüni Bungiu labeichún Ísüraeli</para>
  <para style="q">
    <verse number="12" style="v" sid="JER 15:12" />«Gayaraabei funa san láhalachaguni aban wügüri ligürabun luma luburonsen Nórute?<verse eid="JER 15:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 15:13" />Ítara liña giñe lásiñaruniwa lidere ligaburi ageiraü le áhalachawagua.</para>
  <para style="q" vid="JER 15:13">Luagu lubeiti liibe bifigoun, Ísüraeli,</para>
  <para style="q" vid="JER 15:13">nederegeraali birisin luma sun le bareidahabei,</para>
  <para style="q" vid="JER 15:13">sun le búmabei bumúanrugu houn báganiñu lun hanügüni.<verse eid="JER 15:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 15:14" />Nígiraadibu lun hadamunme báganiñu lidan fulasu le ibidiñeti bun,</para>
  <para style="q" vid="JER 15:14">lugundun durunguaali nigañi kei aban watu gemeti</para>
  <para style="q" vid="JER 15:14">le lunbei lagumuchaguagüdünibu».<verse eid="JER 15:14" /></para>
  <para style="s1">Lagúaruni Profeta Wabureme</para>
  <para style="q">
    <verse number="15" style="v" sid="JER 15:15" />Aburemei, subuditi sun katei bun,</para>
  <para style="q" vid="JER 15:15">haritaguabá nuagun, higabu bíderaguana!</para>
  <para style="q" vid="JER 15:15">Bageindagua nuéigiñe hama ha éibaahabalina!</para>
  <para style="q" vid="JER 15:15">Mígirabana lun nounwen ladügarügü lueirin buguraasun houn;</para>
  <para style="q" vid="JER 15:15">arihabéi awanda nan anabúni buéigiñe.<verse eid="JER 15:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 15:16" />Dan meha badimurehan nun, aganba numuti bererun;</para>
  <para style="q" vid="JER 15:16">ligía meha tugundan nanigi,</para>
  <para style="q" vid="JER 15:16">lugundun bani au, Nabureme Suntigabafu.<verse eid="JER 15:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 15:17" />Móundaraguntina hama ha luágurügübei fedu haritagua;</para>
  <para style="q" vid="JER 15:17">lúmagiñe banügünina bánime, nábuguañadina,</para>
  <para style="q" vid="JER 15:17">ladüga gáñigüda lumutina figóu le hadaagubei.<verse eid="JER 15:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 15:18" />Ka uagu magumuchadi lubéi nigarigu?</para>
  <para style="q" vid="JER 15:18">Ka uagu mareidaguadi lubéi biti le nuágubei?</para>
  <para style="q" vid="JER 15:18">Ítarahadibu nun kei aban duna chururunti,</para>
  <para style="q" vid="JER 15:18">húyarugu hanarimeti lidunari,</para>
  <para style="q" vid="JER 15:18">irumurugu aba lamabeidun kei abun.<verse eid="JER 15:18" /></para>
  <para style="s1">Lóunabun Wabureme</para>
  <para style="p">
    <verse number="19" style="v" sid="JER 15:19" />Ábati lariñagun Aburemei nun:</para>
  <para style="q" vid="JER 15:19">«Ánhabu agiribuda nun, neresibirayabadibu,</para>
  <para style="q" vid="JER 15:19">ani gayaraabei beseriwidun nun.</para>
  <para style="q" vid="JER 15:19">Anhein bígira bayanuhan luágurügü bayanuhan,</para>
  <para style="q" vid="JER 15:19">bayanuharügüme yanu le gálati,</para>
  <para style="q" vid="JER 15:19">buguyaba adimureha náugiñe.</para>
  <para style="q" vid="JER 15:19">Hagía lúnbaña hagiribudun bun,</para>
  <para style="q" vid="JER 15:19">mama buguya lun bagiribudun houn.<verse eid="JER 15:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 15:20" />Nadüga lun ítara ban houn gürigia ha,</para>
  <para style="q" vid="JER 15:20">kei aban baríeiru le lauti buronse le hénrenguti lun lagurúniwa.</para>
  <para style="q" vid="JER 15:20">Hawuribuhaba buma, gama lumoun magañeirun habadibu,</para>
  <para style="q" vid="JER 15:20">ladüga anahein buma lun nasalbarunibu luma lun nesefurunibu.</para>
  <para style="q" vid="JER 15:20">Au, le Aburemei ariñagubalin.<verse eid="JER 15:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 15:21" />Nesefurubadibu lábugiñegiñe habafu salufuritiña,</para>
  <para style="q" vid="JER 15:21">nasalbarubadibu lábugiñegiñe habafu hanarimetiña!»<verse eid="JER 15:21" /></para>
  <chapter eid="JER 15" />
  <chapter number="16" style="c" sid="JER 16" />
  <para style="s1">Leresibirun Heremíasi gumadi lúmagiñe Wabureme</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 16:1" />Aba ladimurehan Aburemei numa, lariñaga nun:<verse eid="JER 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 16:2" />—Mamarieidabá, marahüñü buguyame lidan fulasu le. <verse eid="JER 16:2" /><verse number="3" style="v" sid="JER 16:3" />Lugundun au, le Aburemei, nariñagaali bun kaba lan asusereda houn irahüñü ha agaraüdǘtiña lidan fulasu le luma houn hagübürigu. <verse eid="JER 16:3" /><verse number="4" style="v" sid="JER 16:4" />Láfaragubaña lanarime burí sandi, úabei ayahuti hárigi, mábunahoun hagíame: Herederuba riwagu múarugu kei hádiga animaalugu, lagumuchaguagüdübaña wuribu luma ilamaü héigibei dunuru hama animaalugu gáñitiña hágubu le hilaali.<verse eid="JER 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 16:5" />Ariñagati giñe Aburemei nun:</para>
  <para style="p" vid="JER 16:5">—Mebelurabá tidoun aban muna le ñein hamuti amuiserutiña lárigi hilaali; mayahuabá, marufudunbeime bigarigu luagu hilaali ligía, lugundun gidá naali darangilaü, nínsiñehabu luma nugudemehabu hawéi gürigia ha. <verse eid="JER 16:5" /><verse number="6" style="v" sid="JER 16:6" />Wéinamuhaña, ñǘbürigiña, hóunweguba lidan fulasu le; úabaña ábunutiña, úame ayahutiña hárigi, ni arufudutiña igarigu hawagu, ni íbaagutiña ungua ni ásaruti hádiburi. <verse eid="JER 16:6" /><verse number="7" style="v" sid="JER 16:7" />Úabei adügüti beluria, lun líchugun gurasu houn haduheñu, ni íbini anhein háguchi lubéi o háguchu lan óunweboun.<verse eid="JER 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 16:8" />—Mebelurabá giñe eiga hama tidan aban muna le ñein lumuti adineruni. <verse eid="JER 16:8" /><verse number="9" style="v" sid="JER 16:9" />Ladüga nariñahare au, le Aburemei Suntigabafu le Lubungiute Ísüraeli: Nadügüba lun lagumuchun eremuhani le lánina fedu lídangiñe fulasu le, luma eremuhani la lánina maríei. Lídanba huéyuri lasusereda, harihubei.<verse eid="JER 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 16:10" />—Danme le bariñaguni uganu le houn gürigia, hariñaguba bun: “Ka uagu lóunahei Aburemei óunwenbu wuribani le wawagun? Ka wuribati wadügübei? Ka wafigounbei ligibugiñe Aburemei le Wabungiute?» <verse eid="JER 16:10" /><verse number="11" style="v" sid="JER 16:11" />Bariñagame houn: «Lariñahare Aburemei: Ladüga hígirunina hagüchagu, aba houdin hárigi amu búngiugu lun heseriwidun houn, ígira hamutina, ani magunfulirun hamuti arufudahani le níchugubei houn. <verse eid="JER 16:11" /><verse number="12" style="v" sid="JER 16:12" />Ani huguya wuribatimatün sügǘ hau hagüchagu lugundun falá humaali lagübüri hisaminan, maganbun humutina. <verse eid="JER 16:12" /><verse number="13" style="v" sid="JER 16:13" />Ligía nasagarubadün lubéi lídangiñe fulasu le, lun lidoun aban ageiraü le ibidiñebei hun, ni houn hagüchagu, ábame heseriwidun ñein áriebu wéyuagu houn amu búngiugu, magudemehabubadina hun”.<verse eid="JER 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 16:14" />—Gama lumoun anitebei aban dan —au le Aburemei ariñagubalin—, lunme máfiñurunhaña lan ariñaga: “Luagu libagari Aburemei le asagarubaliña Ísüraelina Ehiptugiñe”, <verse eid="JER 16:14" /><verse number="15" style="v" sid="JER 16:15" />ariñagarügaañame: “Luagu libagari Aburemei le asagarubaliña Ísüraelina lídangiñe ageiraü le nóruterugubei luma lídangiñe líbiri burí ageiraü le meha ñeinhin lubéi lachagaraguaña”. Nadügüba lun hagiribudun hageiroun, lidoun fulasu le buga níchugubei houn hagüchagu.<verse eid="JER 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 16:16" />—Niábingüdüba saragu góuchahaditiña —au le Aburemei ariñagubalin—, lun hadiahaniña Ísüraelina. Lárigiñeme ábame nadügün lun hayabin éibaahatiña lun hagaliruhaniña sagá hamañame lídangiñe sun áraabu, wübü luma lídangiñe burí luhuyun dübü. <verse eid="JER 16:16" /><verse number="17" style="v" sid="JER 16:17" />Lugundun aríaguniña lun sun le hadügübei, maramudagunti ni aban lídangiñe hafigoun luéi narihin. <verse eid="JER 16:17" /><verse number="18" style="v" sid="JER 16:18" />Furumiñe, nafayeiragüdübaña dóbuli luagu hafigoun, ladüga hawiyeduni numúan hau hagübüri haguariuangu, ani lidan sun múa le níchugubei houn keisi halagante, adügatiña burí katei le iyereeguti nun.<verse eid="JER 16:18" /></para>
  <para style="s1">Lagúaruni Heremíasi Wabureme</para>
  <para style="q">
    <verse number="19" style="v" sid="JER 16:19" />Aburemei, buguya le nérebei,</para>
  <para style="q" vid="JER 16:19">le ágüdahabalina, naramudaguagüle lidan lidere dan;</para>
  <para style="q" vid="JER 16:19">hayabinba gürigia bumoun lúmagiñe lídangiñe lébeha ubóu,</para>
  <para style="q" vid="JER 16:19">hariñagame bun: «Búngiugurügüñanu móunitiña ha mabafutiña heresibira wagübürigu keisi alagan.<verse eid="JER 16:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 16:20" />Gayaraati san ladügüniña wügüri guánarügü lubungiutegu?</para>
  <para style="q" vid="JER 16:20">Mama lubéi tímatimaatiña búngiugu hagía!»<verse eid="JER 16:20" /></para>
  <para style="s1">Lóunabun Wabureme</para>
  <para style="q">
    <verse number="21" style="v" sid="JER 16:21" />«Ligía narufudaali lubéi nubafu hun,</para>
  <para style="q" vid="JER 16:21">subudi humaamugei luagu Aburemei lan níribei.<verse eid="JER 16:21" /></para>
  <chapter eid="JER 16" />
  <chapter number="17" style="c" sid="JER 17" />
  <para style="s1">Lifigoun Hudá luma labeichúniwa</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 17:1" />«Hudá, bürüwañu liña bifigoun lau chíchili le lauti gürabu,</para>
  <para style="q" vid="JER 17:1">lau lígiri déimaani luagu tidübüri banigi to dereboun,</para>
  <para style="q" vid="JER 17:1">lóubawagu burí bani latarü.<verse eid="JER 17:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 17:2" />Haritaguatiña birahüñü luagun burí latarü</para>
  <para style="q" vid="JER 17:2">hama burí guáriuagu sagüráutiña</para>
  <para style="q" vid="JER 17:2">ha meha híchugubaña lubadu tídibu wewe hilumatu</para>
  <para style="q" vid="JER 17:2">luma burí luagu wübü íñuburiti<verse eid="JER 17:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 17:3" />luma luagu burí wübü áraabu.</para>
  <para style="q" vid="JER 17:3">Ladüga bifigoun, nadügüba lun líweruhoun birisin,</para>
  <para style="q" vid="JER 17:3">asagarahóua ligíame buwübüri burí le sagüráubei lidan sun fulasu.<verse eid="JER 17:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 17:4" />Bígirubei múa le níchugubei bun keisi balagante,</para>
  <para style="q" vid="JER 17:4">ábame nígirunibu hadamunme báganiñu lidan fulasu le ibidiñeti bun,</para>
  <para style="q" vid="JER 17:4">ladüga durunguaali nigañi</para>
  <para style="q" vid="JER 17:4">kei aban watu gemeti le lunbei lagumuchaguagüdünibu».<verse eid="JER 17:4" /></para>
  <para style="s1">Saragu burí ñunsu</para>
  <para style="p">
    <verse number="5" style="v" sid="JER 17:5" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 17:5">«Íñarawaguati sun le adiñurutu lanigi nuéi,</para>
  <para style="q" vid="JER 17:5">le íchugubalin lemenigin hawagu wügüriña,</para>
  <para style="q" vid="JER 17:5">afiñe ligía luagu hámaba lan ladarira ídemuei.<verse eid="JER 17:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 17:6" />Ítara luba kei búbugati le lídanbei fulasu mageirawati,</para>
  <para style="q" vid="JER 17:6">le móunigirunwati, labadinagua burí dübü láhücha</para>
  <para style="q" vid="JER 17:6">lidan múa le mabuidunti tun nadü,</para>
  <para style="q" vid="JER 17:6">fulasu le úatiña aganóutiña ñein.<verse eid="JER 17:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="JER 17:7" />«Gama lumoun biniwati gürigia le afiñebei nuagu,</para>
  <para style="q" vid="JER 17:7">le íchugubalin lemenigin nuagu.<verse eid="JER 17:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 17:8" />Ítara luba kei aban tídibu wewe le abunúti laru duna,</para>
  <para style="q" vid="JER 17:8">le achawaragubalin lílagüle lidoun duna,</para>
  <para style="q" vid="JER 17:8">ani manufudeti dan le liabin lumabeiniga,</para>
  <para style="q" vid="JER 17:8">ladüga hilumati lubana súnwandan.</para>
  <para style="q" vid="JER 17:8">Mafuudunti lidan lidaani lumabeinga,</para>
  <para style="q" vid="JER 17:8">ani ginti súnwandan.<verse eid="JER 17:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="JER 17:9" />«Úati ni kata geyeedaguaditi ani salufuri</para>
  <para style="q" vid="JER 17:9">kei hanigi gürigia.</para>
  <para style="q" vid="JER 17:9">Kaba gayara gunfurandalanu?<verse eid="JER 17:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 17:10" />Au, le Aburemei, le subudihabúbei tun anigi,</para>
  <para style="q" vid="JER 17:10">subudinéi lilulin-agei aritaguni;</para>
  <para style="q" vid="JER 17:10">ani fáyeinei kada aban keisi ligaburi lóuserun».<verse eid="JER 17:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="JER 17:11" />Le arisiduti lau marumani,</para>
  <para style="q" vid="JER 17:11">ítara liña kei dunuru to áfugahaboun hagañén amu dunuru.</para>
  <para style="q" vid="JER 17:11">Lígirubei lirisin, lábugiñe sun héregili lan,</para>
  <para style="q" vid="JER 17:11">ani lagumuhóun oura, ábanraüyabei hanwoun ibidiougua tau.<verse eid="JER 17:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="JER 17:12" />Ítara tiña watenpulun kei aban lala urúei wéiriguti,</para>
  <para style="q" vid="JER 17:12">íñuñein lúmagiñe furumiñeti dan.<verse eid="JER 17:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="JER 17:13" />Aburemei, buguya lemeniginbei Ísüraeli.</para>
  <para style="q" vid="JER 17:13">Sun le ígirutibu, lanügüba busiganu,</para>
  <para style="q" vid="JER 17:13">sun le adiseduti buéi,</para>
  <para style="q" vid="JER 17:13">lagumuchaguba kei aban iri le abürüdǘti múarugu,</para>
  <para style="q" vid="JER 17:13">ladüga lígirunibu, buguya le lísensen duna diliti.<verse eid="JER 17:13" /></para>
  <para style="s1">Layumuragun Heremíasi lun Wabureme</para>
  <para style="q">
    <verse number="14" style="v" sid="JER 17:14" />Areidaguagüdabana Nabureme, ábame nareidagun;</para>
  <para style="q" vid="JER 17:14">sálbabana, ábame nasalbarun,</para>
  <para style="q" vid="JER 17:14">ladüga búnrügüñein níchiga uéiriguni.<verse eid="JER 17:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 17:15" />Ariñagatiña gürigia nun:</para>
  <para style="q" vid="JER 17:15">«Ka suserebei lun lererun Aburemei?</para>
  <para style="q" vid="JER 17:15">Gúnfulila guentó!»<verse eid="JER 17:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 17:16" />Lau sun lira, mebegiruntina lun bóunahan wuribani hawagun,</para>
  <para style="q" vid="JER 17:16">mayumahan au lamiselu houn.</para>
  <para style="q" vid="JER 17:16">Subudi bumuti buidu ka lan nariñagubei,</para>
  <para style="q" vid="JER 17:16">lugundun biñuarü nariñagei.<verse eid="JER 17:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 17:17" />Magarabaaguabá nun anufudeime,</para>
  <para style="q" vid="JER 17:17">lugundun buguya naramudaguagülebei lidan lidaani nigarigu.<verse eid="JER 17:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 17:18" />Rúbaña ha éibaahabalina lidoun busiganu,</para>
  <para style="q" vid="JER 17:18">mamalá au bíchiga,</para>
  <para style="q" vid="JER 17:18">hagialá anufudeda, mama au.</para>
  <para style="q" vid="JER 17:18">Barüba íruni hawagun,</para>
  <para style="q" vid="JER 17:18">günringuabaña sunsuinagubei.<verse eid="JER 17:18" /></para>
  <para style="s1">Luéyuri emeraaguni</para>
  <para style="p">
    <verse number="19" style="v" sid="JER 17:19" />Aba lariñagun Aburemei nun:</para>
  <para style="p" vid="JER 17:19">—Beiba, bararamame luagu bena le gíribei Lubenari Aüdü, le ñéingiñe lubéi hebelura luma háfurida lurúeitegu Hudá, badügeime giñe ítara luagu sun bena le Herusalénbei. <verse eid="JER 17:19" /><verse number="20" style="v" sid="JER 17:20" />Bariñagame houn gürigia: Urúeigu hama sun lílana Hudá, sun lílana Herusalén ha ebelurubaña luéigiñe bena le, aganba huméi lererun Bungiu. <verse eid="JER 17:20" /><verse number="21" style="v" sid="JER 17:21" />Lariñahare Aburemei: Weyu lánina emeraaguni, luagu hínsiñehabu lun hibagari, manaagua humá anügüni, mebelaagüdün humeime luéigiñe lubenari Herusalén. <verse eid="JER 17:21" /><verse number="22" style="v" sid="JER 17:22" />Masagara humá giñe ni aban anügüni húbiñegiñe lidan luéyuri emeraaguni, madügün huguyame ni aban luwuyeri wadagimanu lidan weyu ligía. Derege huméi luéyuri emeraaguni nun, kei meha nariñaguni houn hagüchagu. <verse eid="JER 17:22" /><verse number="23" style="v" sid="JER 17:23" />Gama lumoun madügüntiña gasu nau, madügün haméi le nubeibei, dererügüti haganbun, máhatiña hadügüni le narufudahabei houn.<verse eid="JER 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 17:24" />—Nariñahare au, le Aburemei: Adüga huméi le nubeibei, manüga humá anügüni ásügüragüda luéigiñe lubenari uburugu lidan luéyuri emeraaguni; mawadigimarida humá lidan weyu ligía. <verse eid="JER 17:24" /><verse number="25" style="v" sid="JER 17:25" />Anhein hagunfulira le nubeibei hun, súnwandan ñéinbaña lan urúeigu luagu lálana larúeihan Dawidi, lun hebeluhan tidan hakarün luma hawagu hagabayun luéigiñe lubenari uburugu le, úara hama ábutigu, hama lumutuniña Hudá luma Herusalén. <verse eid="JER 17:25" /><verse number="26" style="v" sid="JER 17:26" />Hayabinguaba gürigia lídangiñe burí luburugute Hudá le burí geyegubei lau Herusalén, luma lumúanrugugiñe Benhamín, luéigiñe fulasu mawübüriti luma lóubawagugiñe Négebü le dabíara. Hanügüba burí animaalugu ténpulurugun lun adagaragüdüni le gudawarügüti luma burí lun líbiri adagaragüdüni, fulúaruauti, kupali luma idewesei le lánina eteingiruni. <verse eid="JER 17:26" /><verse number="27" style="v" sid="JER 17:27" />Gama lumoun anhein madügün humá le nubeibei, lun hareiduni luéyuri emeraaguni luma lun mebelaagüdün humá anügüni luéigiñe lubenari Herusalén lidan weyu ligía, níchuguba watu gemeti lubenari uburugu, aban watu gemeti le lunbei lagünrinchagunu palasiu burí to Herusalénboun, ani úabei ni aban lun gayara lani éñegucha.<verse eid="JER 17:27" /></para>
  <chapter eid="JER 17" />
  <chapter number="18" style="c" sid="JER 18" />
  <para style="s1">Múa luma adaaguti ágeidinaü lauti múa</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 18:1" />Aba ladimurehan Aburemei numa, lariñaga nun:<verse eid="JER 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 18:2" />—Beiba lúbiñe nadagimeinti múa, níchuguba aban uganu bun ñein.<verse eid="JER 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 18:3" />Aba naragachun lúbiñoun nadagimeinti múa, aba nadariruni adüga aban weru. <verse eid="JER 18:3" /><verse number="4" style="v" sid="JER 18:4" />Weru le ladügübei oura ligía, aba lagünrinchagun lúhaburugu, ábaya ladüdüragüdüni múa ligía lun lañoundaguni deregüdayalei lunya luadigimariduni darí lun ladügüni kei labusenruni.<verse eid="JER 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 18:5" />Ábati lariñagun Aburemei nun:<verse eid="JER 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 18:6" />—Siñati funagia nadügün hau huguya Ísüraelina kei ladüga nadagimeinti múa le lau lumúan? <verse eid="JER 18:6" /><verse number="7" style="v" sid="JER 18:7" />Lidan murusun oura, ánhana busén lun náhulaagun, odi nachagaragun odi nagünrinchagun aban néchani luma burí arúeihani adüganéime. <verse eid="JER 18:7" /><verse number="8" style="v" sid="JER 18:8" />Gama lumoun anhein hígira gürigia hagía hariban, ábame móunahan naali lan abeichúni le yebe lunbei nóunahani hawagun. <verse eid="JER 18:8" /><verse number="9" style="v" sid="JER 18:9" />Lárigiñe, ánhana busén lun nábunagun luma lun nagibedaguagüdün aban néchani o arúeihani adüganéime. <verse eid="JER 18:9" /><verse number="10" style="v" sid="JER 18:10" />Gama lumoun anhein hadüga gürigia hagía le wuribabei, meberesen hagía lau neweridihan, ábame móunahan naali lan buiti le yebe lunbei nóunahani houn.<verse eid="JER 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 18:11" />—Ariñagabá lubeiti houn lílana Hudá luma houn aganóutiña Herusalén, luagu nariñahare lan houn, au, le Aburemei: Neledeguña hubá; haritaguatina nabeichunün. Ígira huméi luriban üma, aranse huméi hóuserun. <verse eid="JER 18:11" /><verse number="12" style="v" sid="JER 18:12" />Ábame hariñagun bun: “Meferidirabéi bidaani! Himei wamuti wabagaridun kei wagundan luma lun wafalaruni luriban tayumahan wanigi”.<verse eid="JER 18:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="JER 18:13" />Ligía lariñagunbei Aburemei:</para>
  <para style="q" vid="JER 18:13">«Álügüdaha humá hadan néchanigu,</para>
  <para style="q" vid="JER 18:13">anhein anihein lubéi aganbaali katei ítaraburiti.</para>
  <para style="q" vid="JER 18:13">Adügaaña lánigu Ísüraeli aban katei wéiriti luriban!<verse eid="JER 18:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 18:14" />Anihein funagia dan lagumuchagun niewe</para>
  <para style="q" vid="JER 18:14">luéigiñe burí liñun luwübüri Líwanu?</para>
  <para style="q" vid="JER 18:14">Lamabeiduba funagia lidili duna le ararirubei áraabugiñe?<verse eid="JER 18:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 18:15" />Gama lumoun numutuniña, bulíei hamaadina,</para>
  <para style="q" vid="JER 18:15">águdahatiña kupali houn búngiugu ha iyeenitiña,</para>
  <para style="q" vid="JER 18:15">yuriguaaña lidan hémeri, le binadu üma,</para>
  <para style="q" vid="JER 18:15">aba hafalarun üma le ibidiñewati.<verse eid="JER 18:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 18:16" />Adüga hamaali hageira fulasume mageirawati,</para>
  <para style="q" vid="JER 18:16">lébuname taweiridun hanigi,</para>
  <para style="q" vid="JER 18:16">sun ha ásügürütiña ñéingiñe,</para>
  <para style="q" vid="JER 18:16">hánhingichubei hachügü le hanufude.<verse eid="JER 18:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 18:17" />Au, kei aban garabali luéigiñeti oubaü le ñéingiñe lubéi laboucha weyu,</para>
  <para style="q" vid="JER 18:17">nachagaragubei Ísüraeli;</para>
  <para style="q" vid="JER 18:17">néibaaguagüdübei hawéi láganiñu.</para>
  <para style="q" vid="JER 18:17">Efeinba narufuda houn, mámaba nigibu,</para>
  <para style="q" vid="JER 18:17">danme lachülürün luéyuri habeichún».<verse eid="JER 18:17" /></para>
  <para style="s1">Eledeguni lubá profeta</para>
  <para style="p">
    <verse number="18" style="v" sid="JER 18:18" />Aba hariñagun:</para>
  <para style="p" vid="JER 18:18">—Waranseha lun wáfaruni Heremíasi. Memegeirúnbaña fádirigu lun harufudahan woun, chu tau lun heweridihaniwa hama profetagu lun hasubudiragüdüni lererun Bungiu woun. Ru wamá lidurun lun lafarún. Madüga wamá gasu lau ni kata lídangiñe le lariñagubei.<verse eid="JER 18:18" /></para>
  <para style="s1">Lafurieidun Heremíasi</para>
  <para style="q">
    <verse number="19" style="v" sid="JER 18:19" />Aburemei, tenibá nun!</para>
  <para style="q" vid="JER 18:19">Aganbabéi le hariñagubei náganiñu!<verse eid="JER 18:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 18:20" />Lau san wuribani lafayeirúa buiti?</para>
  <para style="q" vid="JER 18:20">Chigá hamaali numuaha!</para>
  <para style="b" vid="JER 18:20" />
  <para style="q" vid="JER 18:20">Haritaguabá luagu ñǘbuinhadina lan bigibugiñe</para>
  <para style="q" vid="JER 18:20">lun nadimurehan luagu hafulesein,</para>
  <para style="q" vid="JER 18:20">lun namuriahan buma lun badireiruni bigañi hawéi.<verse eid="JER 18:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 18:21" />Gama lumoun guentó, adügabá lun hóunwegun hasaanigu lau ilamaü o tau lan eféin;</para>
  <para style="q" vid="JER 18:21">lun herederun hámarigu mámariga, masaaniguga!</para>
  <para style="q" vid="JER 18:21">Lun láfaraguniña sandi wügüriña,</para>
  <para style="q" vid="JER 18:21">hilagua hagíame nibureinhaña wuriburugu!<verse eid="JER 18:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 18:22" />Óunahaba saragu híwerutiña hawagun sódini;</para>
  <para style="q" vid="JER 18:22">Aganbualá hagúarahan lau anufudei!</para>
  <para style="q" vid="JER 18:22">Ladüga hachigin huyu lun hárügüdünina sétitiña sádara nubá.<verse eid="JER 18:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 18:23" />Gama lumoun buguya Nabureme,</para>
  <para style="q" vid="JER 18:23">subudi bumuti sun aransehani le hadügübei lun háfarunina.</para>
  <para style="q" vid="JER 18:23">Ualá ferudunabani hariban, mabulieidabei hafigoun!</para>
  <para style="q" vid="JER 18:23">Ábürügüdabaña bigibugiñe, béibaña lau bigañi!<verse eid="JER 18:23" /></para>
  <chapter eid="JER 18" />
  <chapter number="19" style="c" sid="JER 19" />
  <para style="s1">Ágeidinaü bóuguaali</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 19:1" />Aba lariñagun Aburemei nun:</para>
  <para style="p" vid="JER 19:1">—Agañeihabá aban ágeidinaü le lauti múa, banügame fiu agabutihatiña ha lílana fulasu hama fiu fádirigu ha ábutigu búmagua. <verse eid="JER 19:1" /><verse number="2" style="v" sid="JER 19:2" />Ábame bidin luagun fulasu le mawübüriti le lani Ben-inomu, ligibugiñe bena le gíribei Lubenari Tiésütu, ábame bariñaguni uganu le lunbei nariñaguni bun ñein. <verse eid="JER 19:2" /><verse number="3" style="v" sid="JER 19:3" />Bariñagame houn: “Lurúeitegu Hudá, hama lílana Herusalén, aganba huméi luganute Aburemei Suntigabafu, le Lubungiute Ísüraeli: Nóunaha aban lanarime wuribani luagun fulasu le, sunme le aganbuti luagu, ladindinraguba larigeirugu. <verse eid="JER 19:3" /><verse number="4" style="v" sid="JER 19:4" />Ladüga hígirunina Ísüraelina, aba hadügüni fulasu le fulasume terencha; águdahatiña kupali ñein houn amu búngiugu ha buga ibidiñetiña houn, ni houn hagüchagu, ni houn lurúeitegu Hudá, aba habuinchagüdüni lau hata gürigia maduruntiña. <verse eid="JER 19:4" /><verse number="5" style="v" sid="JER 19:5" />Adügatiña burí giñe latarü lun hágudahaniña hasaanigu keisi adagaragüdüni gudawarügüti lun Baali, katei le mariñagun nubéi houn, maritagúngubei numuti. <verse eid="JER 19:5" /><verse number="6" style="v" sid="JER 19:6" />Ligía anitebei lubéi dan lun mámaali lanme Tófeti liri fulasu le, ni fulasu wayati le Ben-inomu, Fulasu Wayati lánina Áfarahani, ligíaba liri. Au, le Aburemei ariñagubalin. <verse eid="JER 19:6" /><verse number="7" style="v" sid="JER 19:7" />Nagünrinchagubei laransehan Hudá luma Herusalén lidan fulasu le. Nadügüba lun háfaraguniña háganiñu, lun leseriwidun hágubu lun héiginme dunuru hama animaalu gáñitiña. <verse eid="JER 19:7" /><verse number="8" style="v" sid="JER 19:8" />Nadügübei uburugu le ábanme fulasu mageirawati, ábame katei hanufunati. Sunme ha ásügürütiña ñéingiñe, hanufudedaguba, ábame taweiridun hanigi lau harihin günringua lan sunsuinagubei. <verse eid="JER 19:8" /><verse number="9" style="v" sid="JER 19:9" />Nadügüba lun héiginiña gürigia harahüñü guánarügü, hougua hagíame houngua danme hegeyedaguni háganiñu uburugu”.<verse eid="JER 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 19:10" />—Lárigiñeme bariñaguni katei le, ábame babouchaguni ágeidinaü hagibugiñe gürigia ha úarabaña buma, <verse eid="JER 19:10" /><verse number="11" style="v" sid="JER 19:11" />bariñagame houn: “Lariñahare Aburemei Suntigabafu: Nagünrinchagubei uburugu le hau sun lílana kei labouchawagun ágeidinaü le lauti múa le siñaali laranserún. Habunúba gürigia hilaguaaña Tófeti, ladüga úaalime amu fulasu lun habunún ñein. <verse eid="JER 19:11" /><verse number="12" style="v" sid="JER 19:12" />Ítara luba nadüga lun uburugu le, hau sun lílana. Nígirubei kei Tófeti. Au, le Aburemei ariñagubalin. <verse eid="JER 19:12" /><verse number="13" style="v" sid="JER 19:13" />Muna burí to Herusalénboun, hani lurúeitegu Hudá palasiu luma burí tábulugu muna to ñéinñaha lubéi hágudaha kupali houn amu búngiugu, lanügüba kei fulasu burí wíyeti ligibugiñe Aburemei ítara giñe kei Tófeti”.<verse eid="JER 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 19:14" />Lárigiñe, aba lagiribudun Heremíasi Tófetigiñe le buga ñeinhin lubéi lóunahei Aburemei adimureha lidan liri, aba lararamun tibürürünrugu ténpulu, aba lariñagun houn gürigia:<verse eid="JER 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 19:15" />—Lariñahare Aburemei Suntigabafu, le Lubungiute Ísüraeli: “Nóunahaali sun abeichúni le uágubei nariñaga luagun uburugu le luma luagun sun aüdü le yarafabei lun, lugundun máhatiña haganbuni nererun”.<verse eid="JER 19:15" /></para>
  <chapter eid="JER 19" />
  <chapter number="20" style="c" sid="JER 20" />
  <para style="s1">Heremíasi luma fádiri Pasuru</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 20:1" />Dan laganbunbei Pasuru, le liráü Imerü, le fádiri ani óunigihati le wéirigutimabei ténpulurugu lariñaguni Heremíasi katei le, <verse eid="JER 20:1" /><verse number="2" style="v" sid="JER 20:2" />aba lóunahan abuleseirei, aba hagüürüni luagu aban tonpu wewe le luágubei lubenari Benhamín le gíribei Bena Íñugiñeti, tubadu ténpulu. <verse eid="JER 20:2" /><verse number="3" style="v" sid="JER 20:3" />Aban weyu lárigiñe, aba lóunahan afaragadei Heremíasi luéigiñe tonpu, ábati lariñagun Heremíasi lun:</para>
  <para style="p" vid="JER 20:3">—Sansi laali Bungiu biri le Pasuru, luagu Magoru-misabíbü. <verse eid="JER 20:3" /><verse number="4" style="v" sid="JER 20:4" />Lugundun lariñahare Aburemei: “Nadügüba lun banufudedun buáriuagua, hanufude hagíame bumadagu buéi; háfaragubaña háganiñu bumadagu bigibugiñe tau eféin. Nederegerubaña sun lílana Hudá lúhaburugun lurúeite Babilónia, ábame lanügüniña Babilónioun o láfaraguniña tau gusiñu. <verse eid="JER 20:4" /><verse number="5" style="v" sid="JER 20:5" />Nederegerubei giñe sun lirisin uburugu le, sun lumúan, sun burí katei gebegiti le ñeinbei luma sun harisin lurúeitegu Hudá houn háganiñu lun hanügüni Babilónioun. <verse eid="JER 20:5" /><verse number="6" style="v" sid="JER 20:6" />Buguya Pasuru, banügǘba Babilónioun hau sun biduheñu. Bóunweba ñein, ábame babunún ñein hau sun bumadagu ha únbaña badimureha iyeeni”.<verse eid="JER 20:6" /></para>
  <para style="s1">Lekeharun Heremíasi lun Wabureme</para>
  <para style="q">
    <verse number="7" style="v" sid="JER 20:7" />Aburemei, aba badaürünina lidan bererun,</para>
  <para style="q" vid="JER 20:7">héretibu nuéi ani gañei bumutina.</para>
  <para style="q" vid="JER 20:7">Eherahóuati nau sun oura, adaawaguati bula nau.<verse eid="JER 20:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 20:8" />Sagü nadimurehan,</para>
  <para style="q" vid="JER 20:8">luágugubeirügü lanarimeniga luma günringuaü nadimureha.</para>
  <para style="q" vid="JER 20:8">Anabúatina adügǘwa ligía bula nau sun dan</para>
  <para style="q" vid="JER 20:8">ladüga nadimurehani bererun.<verse eid="JER 20:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 20:9" />Ánhana ariñaga:</para>
  <para style="q" vid="JER 20:9">«Masaminarundigiaadina luagun Aburemei,</para>
  <para style="q" vid="JER 20:9">madimurehandigiaadina lidan liri»,</para>
  <para style="q" vid="JER 20:9">aba nasandiruni bererun nídangua</para>
  <para style="q" vid="JER 20:9">kei aban watu gemeti le ebeluruti lidoun sun nabu.</para>
  <para style="q" vid="JER 20:9">Áfaaguatina yebe lun nawanduni,</para>
  <para style="q" vid="JER 20:9">gama lumoun siñá numuti.<verse eid="JER 20:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 20:10" />Aganbatina hagülülühan gürigia:</para>
  <para style="q" vid="JER 20:10">«Anihein anufudei lidan sun fulasu!»</para>
  <para style="q" vid="JER 20:10">Hariñaga: «Adüga wamá lidurun Heremíasi!»</para>
  <para style="q" vid="JER 20:10">Íbini numadagu agurabatiña nabulieidagun lun nábürühan.</para>
  <para style="q" vid="JER 20:10">Hariñaga: «Fagua gayaraabei weyeeduni lun wagañeiruni</para>
  <para style="q" vid="JER 20:10">ábameti waguburahani luagu sun le ladügübei woun».<verse eid="JER 20:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 20:11" />Gama lumoun Nabureme, abunhein numa</para>
  <para style="q" vid="JER 20:11">kei aban awuribuhati le meferidirati;</para>
  <para style="q" vid="JER 20:11">hábürühaba ha éibaahabalina,</para>
  <para style="q" vid="JER 20:11">siñaame hagañeirunina;</para>
  <para style="q" vid="JER 20:11">heferidiruba, hanügüba busiganu le mabulieidúati.<verse eid="JER 20:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="JER 20:12" />Aburemei Suntigabafu,</para>
  <para style="q" vid="JER 20:12">buguya le óuchagubei lau irichaü,</para>
  <para style="q" vid="JER 20:12">buguya le arihubalin sun le haritagunrugubei gürigia,</para>
  <para style="q" vid="JER 20:12">arufudabéi babeichuniña gürigia ha nun,</para>
  <para style="q" vid="JER 20:12">ladüga ru naali nikesin búhaburugun.<verse eid="JER 20:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="JER 20:13" />Heremuha lun Aburemei!</para>
  <para style="q" vid="JER 20:13">Sefu lumutiña Bungiu gürigia ha nidiheribaña háhaburugugiñe wuribatiña.<verse eid="JER 20:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="JER 20:14" />Íñarawaguala weyu le nagaraüdünwabei,</para>
  <para style="q" vid="JER 20:14">mabinirualá weyu le tágurahanbalina núguchu!<verse eid="JER 20:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 20:15" />Íñarawaguala le agundaaraguagüdübalin núguchi lau uganu</para>
  <para style="q" vid="JER 20:15">le ariñawagúbei lun luagu wügüri lan irahü liraübei!<verse eid="JER 20:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 20:16" />Ítarala gürigia ligía</para>
  <para style="q" vid="JER 20:16">kei burí uburugu le lagünrinchagubei Aburemei lun sun dan!</para>
  <para style="q" vid="JER 20:16">Aganbalá agúarahani lánina igarigu binaafin</para>
  <para style="q" vid="JER 20:16">luma areinchuni lánina wuribu amidirugu,<verse eid="JER 20:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 20:17" />ladüga máfarun lumutina Bungiu turageirugu núguchu!</para>
  <para style="q" vid="JER 20:17">Tuguyañoun hamuga numuaha,</para>
  <para style="q" vid="JER 20:17">magaraüdǘnwatina hamuga.<verse eid="JER 20:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 20:18" />Ka uagu náfurida turageirugugiñe núguchu</para>
  <para style="q" vid="JER 20:18">lúnrügü náfagun igarigu luma idiheri,</para>
  <para style="q" vid="JER 20:18">luma lun nagumuchuni nibagari buin lau busiganu?<verse eid="JER 20:18" /></para>
  <chapter eid="JER 20" />
  <chapter number="21" style="c" sid="JER 21" />
  <para style="s1">Ladimurehóuniwa abeichúni lun Heremíasi</para>
  <para style="p">
    <verse number="1-2" style="v" sid="JER 21:1-2" />Aba lóunahani urúei Sedekíasi Pasuru, le liráü Malükíasi luma fádiri Sofoníasi le liráü Maseíasi ariñaga lun Heremíasi:</para>
  <para style="p" vid="JER 21:1-2">—Adügabá fulesei nun, álügüdahaba luma Aburemei wawagu, lugundun lageindaguña Nabukodonosoru le lurúeite Babilónia wama. Lúndügü ladügün Aburemei aban lídangiñe lani burí milaguru lun lígiruniwa Nabukodonosoru woungua.</para>
  <para style="p" vid="JER 21:1-2">Ábati ladimurehan Aburemei lun Heremíasi, <verse eid="JER 21:1-2" /><verse number="3" style="v" sid="JER 21:3" />aba lariñagun Heremíasi houn lóunagülegu Sedekíasi:</para>
  <para style="p" vid="JER 21:3">—Ariñaga humá lun Sedekíasi <verse eid="JER 21:3" /><verse number="4" style="v" sid="JER 21:4" />luagu lariñahare lan Aburemei, le Lubungiute Ísüraeli: «Nagiribudagüdaaña hisudaranigu ha bóugudibaña luéi baríeiru ageindagua luma lurúeite Babilónia hama Kalüdéana, ábame nóundaruniña lamidangua uburugu le. <verse eid="JER 21:4" /><verse number="5" style="v" sid="JER 21:5" />Au guánarügüba ageindagua kóntüra huguya lau saragu ubafu luma óunwenbu lanarime igañi. <verse eid="JER 21:5" /><verse number="6" style="v" sid="JER 21:6" />Náfaragubaña sun lílana uburugu le; hóunweguba wügüriña hama animaalugu lau aban lanarime sandi. <verse eid="JER 21:6" /><verse number="7" style="v" sid="JER 21:7" />Lárigiñe ábame nederegeruni Sedekíasi le lurúeite Hudá lúhaburugun Nabukodonosoru luma háhaburugun híbiri láganiñu hau sun ha arúeihabaña luma, lisudaranigu hama gürigia ha erederutiña wínwanñu uburugu lárigiñe sandi, wuribu, luma ilamaü, nadügüba lun háfaraguniña tau eféin magudemehabuga. Au, le Aburemei, ariñagubalin.<verse eid="JER 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 21:8" />—Ariñagabá giñe houn gürigia luagu nariñahare lan au, le Aburemei: Anihán lémeri ibagari luma lémeri óunweni higibugiñe lun hanúadiruni le habusenrun lídangiñe biángubei. <verse eid="JER 21:8" /><verse number="9" style="v" sid="JER 21:9" />Le erederuti ya uburugu, lóunweba wuriburugu, o lau ilamaü o lau sandi. Ánheinti le áfuriduti lun lederegeragun lungua houn Kalüdéana ha ageindagubaña hama lílana uburugu guentó, móunwenbei; lesefurubei libagari. <verse eid="JER 21:9" /><verse number="10" style="v" sid="JER 21:10" />Ladüga aransedina lun nanügün wuribani leweñegua buiti luagun uburugu le. Nederegerubei lun lurúeite Babilónia, ábame láguduni. Au le Aburemei ariñagubalin.<verse eid="JER 21:10" /></para>
  <para style="s1">Ñunsu kóntüra lurúeite Hudá</para>
  <para style="p">
    <verse number="11-12" style="v" sid="JER 21:11-12" />—Ariñagabá houn tílana luban urúei Dawidi nariñahare lan:</para>
  <para style="b" vid="JER 21:11-12" />
  <para style="q" vid="JER 21:11-12">Aganba huméi luganute Bungiu.</para>
  <para style="q" vid="JER 21:11-12">Adüga huméi le richabei sagü weyu;</para>
  <para style="q" vid="JER 21:11-12">sefu humaña gudemetiña hawéi ha íchugubaña lidere dan houn,</para>
  <para style="q" vid="JER 21:11-12">durunguadügüliñein nigañi luagu luriban hóuserun</para>
  <para style="q" vid="JER 21:11-12">kei aban watu gemeti úougame kaba lan gayara léñeguchuni.<verse eid="JER 21:11-12" /></para>
  <para style="s1">Ladimurehoun labeichúniwa Herusalén</para>
  <para style="q">
    <verse number="13" style="v" sid="JER 21:13" />«Nageindaguba kóntüra uburugu Herusalén le ariñagubei séfuñu waña,</para>
  <para style="q" vid="JER 21:13">úabei aguuruti wawagu ya.<verse eid="JER 21:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 21:14" />Nabeichubadün keisi ladüna hóuserun.</para>
  <para style="q" vid="JER 21:14">Nébedubei dabíara le hageirabei,</para>
  <para style="q" vid="JER 21:14">ábame lágudun sun geyegua lau.</para>
  <para style="q" vid="JER 21:14">Au, le Aburemei, ariñagubalin».<verse eid="JER 21:14" /></para>
  <chapter eid="JER 21" />
  <chapter number="22" style="c" sid="JER 22" />
  <para style="s1">Ñunsu houn arúeihatiña Hudá</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 22:1" />Lariñaga Aburemei nun:</para>
  <para style="p" vid="JER 22:1">—Beiba tidan lani urúei palasiu, bariñageime uganu le, <verse eid="JER 22:1" /><verse number="2" style="v" sid="JER 22:2" />ligibugiñe lurúeite Hudá, le ñunbei luagu lálana larúeihan Dawidi, luma hagibugiñe lumusuniña hama gürigia ha lílana uburugu: “Aganba huméi lererun Aburemei. <verse eid="JER 22:2" /><verse number="3" style="v" sid="JER 22:3" />Adüga humá irichaü luma úarani lidan fulasu le, sefu humaña gudemetiña hawéi ha asufuriragüdübaliña, móusera humaña terencha wuriba, ni méteñuhaña ni würiña ha hilaaña úmari. Máfara humá gürigia maduruntiña. <verse eid="JER 22:3" /><verse number="4" style="v" sid="JER 22:4" />Anhein hadüga le nubeibei hun, ñeinmemebaña urúeigu añuurutiña luagu lálana larúeihan Dawidi, hebeluhaba tidan karü luma hawagu gabayu luéigiñe tubenari palasiu to, úara hama hánigu hama lílana fulasu. <verse eid="JER 22:4" /><verse number="5" style="v" sid="JER 22:5" />Gama lumoun anhein madügün humá le nubeibei, tagumuchaguba palasiu to. Au, le Aburemei, ariñagubalin”.<verse eid="JER 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 22:6" />Lugundun lariñahare Aburemei tibügürü lani lurúeite Hudá palasiu:</para>
  <para style="b" vid="JER 22:6" />
  <para style="q" vid="JER 22:6">«Ítara biña nun keisi wübü Galaadü, keisi luwübüri Líwanu,</para>
  <para style="q" vid="JER 22:6">gama lumoun fiñutina luagu nadügübadibu lan fulasume mageirawati.<verse eid="JER 22:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 22:7" />Nóunahaba gürigia tau áruma buagun lun hagünrinchagunibu.</para>
  <para style="q" vid="JER 22:7">Háchuahabei lubuidun burí buagaburi le hibúari,</para>
  <para style="q" vid="JER 22:7">ábame háguruni wáturugun».<verse eid="JER 22:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="JER 22:8" />—Hásügürüba gürigia lílana saragu néchani lubadugiñe uburugu le, ábame hálügüdagun houngua, hariñagame: “Ka uagu ladügei Aburemei katei le lun óunwenbu uburugu le?” <verse eid="JER 22:8" /><verse number="9" style="v" sid="JER 22:9" />Hóunabame: “Ladüga hígiruni daradu le meha ladügübei Aburemei le Habungiute hama, aba heseriwidun houn amu búngiugu”.<verse eid="JER 22:9" /></para>
  <para style="s1">Ñunsu libügürü Salumu (Hoakasi)</para>
  <para style="q">
    <verse number="10-11" style="v" sid="JER 22:10-11" />Mayahua humá luagu urúei Hosíasi,</para>
  <para style="q" vid="JER 22:10-11">mayahua humá luagu lounwen;</para>
  <para style="q" vid="JER 22:10-11">luagulá Salumu le liráü hayahua,</para>
  <para style="q" vid="JER 22:10-11">le lunbei lidin lun magiribudúndigiaali lan;</para>
  <para style="q" vid="JER 22:10-11">marihindigia laali múa le ñein lubéi lágurahoua.</para>
  <para style="b" vid="JER 22:10-11" />
  <para style="p" vid="JER 22:10-11">Ladüga lariñahare Aburemei libügürü Salumu, le liráü Hosíasi, le lurúeite Hudá, le arúeihabei lárigiñe lúguchi, le áfuridubei lídangiñe fulasu le:</para>
  <para style="p" vid="JER 22:10-11">—Magiribudúnhali <verse eid="JER 22:10-11" /><verse number="12" style="v" sid="JER 22:12" />hilarügübei lidan ageiraü le ñeinhin lubéi hanügei, marihindigia laali lageira.<verse eid="JER 22:12" /></para>
  <para style="s1">Ñunsu libügürü Hoakimü</para>
  <para style="q">
    <verse number="13" style="v" sid="JER 22:13" />«Fugiabu buguya le ábunagubarun bani palasiu</para>
  <para style="q" vid="JER 22:13">tuma burí buban íñuburitu lau wuribani luma maricharaguni,</para>
  <para style="q" vid="JER 22:13">buguya le nadagimeingüdübei gürigia</para>
  <para style="q" vid="JER 22:13">ani mafayeirun bumuti lebegi hawadigimari houn!<verse eid="JER 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 22:14" />Buguya le ariñagubei: “Nadüga aban nani palasiu wéiritu,</para>
  <para style="q" vid="JER 22:14">lau burí rumu wéinamuti tidan”.</para>
  <para style="q" vid="JER 22:14">Aba badügün burí funedera tuagu furaraboun lau hibúari</para>
  <para style="q" vid="JER 22:14">aba befeindihanu lau funati.<verse eid="JER 22:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 22:15" />Haritaguatibu funagia luagu laganóuniwa lan</para>
  <para style="q" vid="JER 22:15">geyegu lau hibúari, ligía lan arúeihanibei?</para>
  <para style="q" vid="JER 22:15">Buiti meha dan lun búguchi lidan libagari;</para>
  <para style="q" vid="JER 22:15">ladüga adüga lumuti meha sun katei lau irichaü luma úarani,</para>
  <para style="q" vid="JER 22:15">ligía meha buidu lubéi lidin lun.<verse eid="JER 22:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 22:16" />Ageindagua lumuti bugaha haricha gudemetiña,</para>
  <para style="q" vid="JER 22:16">ligía buidu lubéi buga lidin lun.</para>
  <para style="q" vid="JER 22:16">Ladüga subudi lánina kei Lubungiute.</para>
  <para style="q" vid="JER 22:16">Au, le Aburemei ariñagubalin.<verse eid="JER 22:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="JER 22:17" />Ánheinti buguya, luágurügüñein agañeiruni marumanti baritagua;</para>
  <para style="q" vid="JER 22:17">Ígira bumuti madurunti lun lounwen,</para>
  <para style="q" vid="JER 22:17">ru buguya lidere dan lun bageira».<verse eid="JER 22:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="JER 22:18" />Lariñahare Aburemei libügürü Hoakimü le liráü Hosíasi, le lurúeite Hudá:</para>
  <para style="b" vid="JER 22:18" />
  <para style="q" vid="JER 22:18">«Úabei ni aban ayahuti lárigi danme lounwen.</para>
  <para style="q" vid="JER 22:18">Úabei ariñaguti:</para>
  <para style="q" vid="JER 22:18">“Níbiri! Nitu!</para>
  <para style="q" vid="JER 22:18">Nabureme! Nurúeite!”<verse eid="JER 22:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 22:19" />Labunúba keisi aban burigü,</para>
  <para style="q" vid="JER 22:19">aduruuhóuarügübei bóugudin luéi Herusalén».<verse eid="JER 22:19" /></para>
  <para style="s1">Ñunsu libügürü Herusalén</para>
  <para style="q">
    <verse number="20" style="v" sid="JER 22:20" />«Hudá, wariba luagun luwübüri Líwanu ábame bagúaragun!</para>
  <para style="q" vid="JER 22:20">Iñurabéi bumalali dabíararugu Basán!</para>
  <para style="q" vid="JER 22:20">Wáguaba luéigiñe burí luwübüri Abarímü,</para>
  <para style="q" vid="JER 22:20">ladüga áfarawagua sun bubúaligu.<verse eid="JER 22:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 22:21" />Adimurehatina meha bun dan le lidan ban lubuidun bidaani,</para>
  <para style="q" vid="JER 22:21">gama lumoun máhatibu baganbunina.</para>
  <para style="q" vid="JER 22:21">Ítara liña badügüni lúmagiñe ñǘraügidibu:</para>
  <para style="q" vid="JER 22:21">Máhatibu baganbuni nererun!<verse eid="JER 22:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 22:22" />Ladurugudubaña garabali sun bábutigu hama bubúaligu</para>
  <para style="q" vid="JER 22:22">ábame hanügǘn bóugudi luéi hageira.</para>
  <para style="q" vid="JER 22:22">Berederame lau lueirin busiganu ladüga sun wuribani le badügübei.<verse eid="JER 22:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 22:23" />Darangilutibu guentó lidan bumasa,</para>
  <para style="q" vid="JER 22:23">labadinagua burí hibúari anügǘti Líwanugiñe,</para>
  <para style="q" vid="JER 22:23">Gama lumoun basufuriruba danme liabin gáriti bun,</para>
  <para style="q" vid="JER 22:23">le lánina águrahani».<verse eid="JER 22:23" /></para>
  <para style="s1">Ñunsu lúmagiñe Bungiu lun urúei Hekoníasi</para>
  <para style="p">
    <verse number="24" style="v" sid="JER 22:24" />Ariñagaali Wabureme lun Hekoníasi le liráü Hoakimü, le lurúeite Hudá:</para>
  <para style="p" vid="JER 22:24">—Fiñú numuti luagu nibagari: “Íbini anhein hamuga ábantibu bagü le lánina aseinihani luagu núhabu le nóunwenren, nagucharubadibu yebe ñéingiñe. <verse eid="JER 22:24" /><verse number="25" style="v" sid="JER 22:25" />Lun nederegerunibu houn báganiñu, ha uéibaña banufudeda saragu. Nederegerubadibu lun Nabukodonosoru le lurúeite Babilónia luma houn Kalüdéana. <verse eid="JER 22:25" /><verse number="26" style="v" sid="JER 22:26" />Nágurubadibu buguya tau sun búguchu lidoun aban fulasu le mámabei hageira, ñeinba hóunwegua biángubei”. <verse eid="JER 22:26" /><verse number="27" style="v" sid="JER 22:27" />Ítara liña lubeiti magiribudúnbaña lidoun fulasu le ñeinhin lubéi lueirin hayumahan hagiribudun.<verse eid="JER 22:27" /></para>
  <para style="s1">Lagúaragun profeta lau ligañi</para>
  <para style="q">
    <verse number="28" style="v" sid="JER 22:28" />Aban san weru bóuguaali o aban lan asiedu le mabusenrúnwaali,</para>
  <para style="q" vid="JER 22:28">le meseriwínhali Hekoníasi?</para>
  <para style="q" vid="JER 22:28">Ka uagu lagurúa habu sun lirahüñü lidoun aban fulasu le ibidiñewati?<verse eid="JER 22:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 22:29" />Múa, múa, múa,</para>
  <para style="q" vid="JER 22:29">aganbabéi lererun Aburemei!<verse eid="JER 22:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="JER 22:30" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 22:30">«Bürǘ huméi wügüri le tidan líburu</para>
  <para style="q" vid="JER 22:30">keisi aban wügüri masaaniguti,</para>
  <para style="q" vid="JER 22:30">keisi aban wügüri le wuribabei lidin lun lidan libagari.</para>
  <para style="q" vid="JER 22:30">Ladüga machülübei ni aban hádangiñe ladügawagun</para>
  <para style="q" vid="JER 22:30">añuura luagu lálana larúeihan Dawidi lunya larúeihan Hudá».<verse eid="JER 22:30" /></para>
  <chapter eid="JER 22" />
  <chapter number="23" style="c" sid="JER 23" />
  <para style="s1">Emenigini lubá weyu le machülügilibei</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 23:1" />Lariñahare Aburemei:</para>
  <para style="p" vid="JER 23:1">—Fugiabugu hóuniri mudún ha ígirubaña lun heferidirun luma lun hachagaragun nilügüniña mudún!<verse eid="JER 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 23:2" />Lariñahare Aburemei, le Lubungiute Ísüraeli houn hóuniri mudún ha óunigirubaliña lumutuniña: “Chagaguagüda humaaña nilügüniña mudún, anuraagüda humaaña, móunigirun humutiña. Nabeichaadün lubeiti luéigiñe le hadügübei. Au, le Aburemei, ariñagubalin. <verse eid="JER 23:2" /><verse number="3" style="v" sid="JER 23:3" />Au guánarügüba anügaña híbiri nilügüniña mudún lídangiñe ageiraü le ñeinhin lubéi nanuraagüdaña, ábame nóundaruniña, ábame nanügüniña hárigoun lun hemeilihan. <verse eid="JER 23:3" /><verse number="4" style="v" sid="JER 23:4" />Níchuguba hóuniri lun hóunigiruniña, manufude hamaamuga, memegeirunme ni aban hádangiñe. Au, le Aburemei, ariñagubalin.<verse eid="JER 23:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="JER 23:5" />Lariñahare Aburemei: Lachülürüba aban weyu danme nadügün</para>
  <para style="q" vid="JER 23:5">lun gadügawagun lan Dawidi aban le tímatimaati,</para>
  <para style="q" vid="JER 23:5">aban urúei le arúeihati lau lichú aau,</para>
  <para style="q" vid="JER 23:5">le adügüti sun katei lau irichaü luma úarani fulasurugu.<verse eid="JER 23:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 23:6" />Danme larúeihan, séfuñu luba Hudá,</para>
  <para style="q" vid="JER 23:6">ani chóuruñu luba giñe Ísüraeli.</para>
  <para style="q" vid="JER 23:6">Hagúahameti lun lau iri le: “Wabureme, Wasalbaragüle” ».<verse eid="JER 23:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="JER 23:7" />Lariñahare Aburemei:</para>
  <para style="p" vid="JER 23:7">—Anitebei weyu lun máfiñurun humá ariñaga: “Luagu libagari Aburemei le asagarubaliña Ísüraelina Ehiptugiñe”, <verse eid="JER 23:7" /><verse number="8" style="v" sid="JER 23:8" />hariñagame: “Luagu libagari Wabureme le asagarubaliña ladügawagun Ísüraeli lídangiñe ageiraü le nóruterugubei, luma lídangiñe burí líbiri fulasu le buga ñeinhin lubéi lachagaraguaña”. Ábame hayabin aganawa hageira.<verse eid="JER 23:8" /></para>
  <para style="s1">Ñunsu habügürü profetagu</para>
  <para style="q">
    <verse number="9" style="v" sid="JER 23:9" />Uganu habügürü profetagu: Wéiriti nidiheri hawagu profetagu;</para>
  <para style="q" vid="JER 23:9">ámuñeguati nasandiragun nungua kamá hamuga bacharuañadina,</para>
  <para style="q" vid="JER 23:9">ítara kei aban wügüri le sügüguaaru diwéin lau,</para>
  <para style="q" vid="JER 23:9">luéigiñe Wabureme luma lererun le sándubei.<verse eid="JER 23:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 23:10" />Buin liña fulasu hau gürigia gagabarahatiña,</para>
  <para style="q" vid="JER 23:10">hau gürigia ha éibaagubaña adüga wuribani,</para>
  <para style="q" vid="JER 23:10">ha ayusurubalin habafu lun hadügün marichaü.</para>
  <para style="q" vid="JER 23:10">Ligía líñaragunbalin Aburemei múa,</para>
  <para style="q" vid="JER 23:10">aba lamabeidun múa,</para>
  <para style="q" vid="JER 23:10">aba lágudun liluman sagadi.<verse eid="JER 23:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="JER 23:11" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 23:11">«Dandu profetagu keisi fádirigu,</para>
  <para style="q" vid="JER 23:11">minebenti Bungiu houn;</para>
  <para style="q" vid="JER 23:11">darí naaña adüga wuribati tidan nitenpulun.<verse eid="JER 23:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 23:12" />Ligía búrigabei lubéi hémeri, guyé ligiame;</para>
  <para style="q" vid="JER 23:12">nadügüba lun hadarúniwa lun héiguadun.</para>
  <para style="q" vid="JER 23:12">Danme nafayeiragüdüniña luagu hadüga,</para>
  <para style="q" vid="JER 23:12">nanügüba lamiselu hawagun.</para>
  <para style="q" vid="JER 23:12">Au, le Aburemei, ariñagubalin.<verse eid="JER 23:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="JER 23:13" />«Ariha naaña profetagu Samariana</para>
  <para style="q" vid="JER 23:13">adüga katei le wuribati lábürühan nun:</para>
  <para style="q" vid="JER 23:13">Adimurehatiña luagu liri Baali,</para>
  <para style="q" vid="JER 23:13">yuriguagüda hamaaña nánigu ha Ísüraelina.<verse eid="JER 23:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 23:14" />Ariha naaña profetagu Herusalénna,</para>
  <para style="q" vid="JER 23:14">adaagua katei wéiriti luriban:</para>
  <para style="q" vid="JER 23:14">Agabarahatiña, ani íweruha hagía lau iyeeni</para>
  <para style="q" vid="JER 23:14">rútiña gurasu houn ha wuribabaña</para>
  <para style="q" vid="JER 23:14">lun mígirun hamani luriban hóuserun.</para>
  <para style="q" vid="JER 23:14">Hagía hama lílana uburugu,</para>
  <para style="q" vid="JER 23:14">ítara haña nun kei Sodoma luma Gomora.<verse eid="JER 23:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 23:15" />Ligía nariñagunbalin katei le hawagu profetagu, au, le Aburemei:</para>
  <para style="q" vid="JER 23:15">Néigagüdübaña katei le wéiriti ligifi,</para>
  <para style="q" vid="JER 23:15">nátagüdübaña duna le péisiniti,</para>
  <para style="q" vid="JER 23:15">lugundun barühali wuribani fulasu lidan sun ageiraü le,</para>
  <para style="q" vid="JER 23:15">hadüga profetagu Herusalénna».<verse eid="JER 23:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="JER 23:16" />Lariñahare Bungiu Suntigabafu:</para>
  <para style="q" vid="JER 23:16">«Ísüraelina, madüga humá gasu lau le hariñagun profetagu hun.</para>
  <para style="q" vid="JER 23:16">Iyeeni le hariñagubei, katei le hadüga houngua,</para>
  <para style="q" vid="JER 23:16">mama au ariñagubalin houn.<verse eid="JER 23:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 23:17" />Ariñagatiña houn ha iyereegubei nererun houn:</para>
  <para style="q" vid="JER 23:17">“Buídubei lasalirun sun katei hun”.</para>
  <para style="q" vid="JER 23:17">Ariñaga hagía houn ha afalarubalin luriban tayumahan hanigi:</para>
  <para style="q" vid="JER 23:17">“Miábinbei ni murusun wuribani huagun” ».<verse eid="JER 23:17" /></para>
  <para style="s1">Lagúaragun Heremíasi lau ligañi</para>
  <para style="q">
    <verse number="18" style="v" sid="JER 23:18" />Gama lumoun: Kagia subudihabúbei lun katei aramudaguati le lani Wabureme?</para>
  <para style="q" vid="JER 23:18">Kagia arihubalin o aganbubalin lererun?</para>
  <para style="q" vid="JER 23:18">Kagia íchugubalin lidaani lun?<verse eid="JER 23:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 23:19" />Ítara liña ligañi Aburemei keisi aban luriban dan,</para>
  <para style="q" vid="JER 23:19">kei aban ligarabalin herigini le áfurubei hawagun wuribatiña.<verse eid="JER 23:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 23:20" />Meredebei ligañi Aburemei</para>
  <para style="q" vid="JER 23:20">darime adüga laali le laritagubei.</para>
  <para style="q" vid="JER 23:20">Lachülürüba dan lun hasaminarun</para>
  <para style="q" vid="JER 23:20">ani gunfuranda humeime katei burí le.<verse eid="JER 23:20" /></para>
  <para style="s1">Ñunsu kóntüra profetagu yéetiña</para>
  <para style="q">
    <verse number="21" style="v" sid="JER 23:21" />«Móunahan numutiña profetagu ha,</para>
  <para style="q" vid="JER 23:21">madimurehangubeitina houn,</para>
  <para style="q" vid="JER 23:21">gama lumoun aba héibaagun adimureha lidan niri.<verse eid="JER 23:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 23:22" />Lun hamuga hasubudiruni sun le aramudaguatibei numa</para>
  <para style="q" vid="JER 23:22">hariñaguñein hamuga nererun lun nageira,</para>
  <para style="q" vid="JER 23:22">diñú hamuti hamuga luéi luriban lémeri,</para>
  <para style="q" vid="JER 23:22">lun lígiruni luriban lóuserun».<verse eid="JER 23:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="JER 23:23" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 23:23">«Aban funagia Bungiu au le lídanrügüti aban fulasu leredera,</para>
  <para style="q" vid="JER 23:23">lun lásiñarun narihini le hadaagubei?<verse eid="JER 23:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 23:24" />Gayaraabei funa laramudagun furumiñeguarügü luéi narihin?</para>
  <para style="q" vid="JER 23:24">Buin liña sielu luma ubóu nau.<verse eid="JER 23:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="JER 23:25" />—Aganba naali hayeeni profetagu ha, ha ariñagubaña luagu lidan lan niri hadimureha, luagu adimureha hamá numa lidan uénedü. <verse eid="JER 23:25" /><verse number="26" style="v" sid="JER 23:26" />Ídaba san lásura hadimurehan profetagu ha iyeeni, le hadüga houngua? <verse eid="JER 23:26" /><verse number="27" style="v" sid="JER 23:27" />Lau burí uénedü le habahüdagubei hóuniwagua, hóuchuña lun habulieidaguagüdüniña nánigu nuéi ítara kei meha habulieidunina hagüchagu aba houdin lárigi Baali.<verse eid="JER 23:27" /></para>
  <para style="p">
    <verse number="28-29" style="v" sid="JER 23:28-29" />—Anhein gewenedü aban profeta aban uénedü, ariñagalá luagu aban lan uénedü, gama lumoun anhein leresibira nererun, adimurehalei keisi lubudubu! Siñati warufuduni ifei kei türigu. Ítara liña nererun kei watu gemeti, kei aban marüdiyu le añügürihati dübü. Au, le Aburemei ariñagubalin.<verse eid="JER 23:28-29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 23:30" />—Ligía kóntürañadina lubéi profetagu ha, hagía íweruhabalin nererun hawariuagua. Au, le Aburemei, ariñagubalin. <verse eid="JER 23:30" /><verse number="31" style="v" sid="JER 23:31" />Nariñaguñein kóntürañadina profetagu ha ásügüragüdübaña katei le hadüga houngua kamá hamuga uganu le númagiñeti. <verse eid="JER 23:31" /><verse number="32" style="v" sid="JER 23:32" />Kóntürañadina profetagu ha abahüdagubaña uénedü le iyeeni. Ha acharagadagüdübaliña numutuniña lau hayeeni. Móunahan numutiña, míchugun au dimurei houn, mabafutiña lubeiti lun híderagun gürigia. Au, le Aburemei ariñagubalin.<verse eid="JER 23:32" /></para>
  <para style="s1">Ligaburi layanuhóun ñunsu lúmagiñeti Aburemei</para>
  <para style="p">
    <verse number="33" style="v" sid="JER 23:33" />—Heremíasi, ánhabu lálügüda aban lílana fulasu o aban lan profeta o aban lan fádiri ka la lóunahabei Aburemei ariñaga, bariñagame houn: “Lariñahare Aburemei luagu huguya lan lihürübei ani lígiragüdaadün lan lun hábürühan”. <verse eid="JER 23:33" /><verse number="34" style="v" sid="JER 23:34" />Hawaguti profetagu ha yéetiña, fádirigu hama furumiñeguarügü lílana aüdü ha ariñagutiña “ñunsu lúmagiñeti Wabureme” nabeichagubaña hau sun tílana haban. <verse eid="JER 23:34" /><verse number="35" style="v" sid="JER 23:35" />Danme lálügüdahan furumiñeguarügü luma aban gürigia, o luma aban lumada o liduhe, gayaraabei lariñagun: “Ka lóunabubei Wabureme? Ka lariñagubei?” <verse eid="JER 23:35" /><verse number="36" style="v" sid="JER 23:36" />Gama lumoun mariñagadigia humá “ñunsu lúmagiñeti Wabureme” lugundun le ariñaguti dimurei le, nadügüba lun liabin lererun lihürügume. Sánsigua humaali lila lererun Bungiu le wínwanbei, le Hubungiute, le Aburemei Suntigabafu.<verse eid="JER 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JER 23:37" />—Heremíasi, álügüdabaña profetagu: “Ka lan lóunabagülebei Wabureme? Ka lan lariñagubei?” <verse eid="JER 23:37" /><verse number="38" style="v" sid="JER 23:38" />Ánhaña ariñaga “ñunsu lúmagiñeti Wabureme”, bariñagame houn: “Lariñahare Aburemei: Kei ǘnhagua lubéi ayusurei dimurei le ueibei nerera hun, lun mayusurun humani. <verse eid="JER 23:38" /><verse number="39" style="v" sid="JER 23:39" />Niñurubadün kei aban anügüni hǘrüti, huguya lau sun uburugu le níchugubei hun luma houn hagüchagu, ábame nígiragüdünün lun héiguadun dise nuéi. <verse eid="JER 23:39" /><verse number="40" style="v" sid="JER 23:40" />Ani nábürügüdüba busiganu luma ǘnabuguni huagun lun súnwandan le hásiñarun abulieida”.<verse eid="JER 23:40" /></para>
  <chapter eid="JER 23" />
  <chapter number="24" style="c" sid="JER 24" />
  <para style="s1">Faniñe tau burí igu</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 24:1" />Lárigiñebei lanügüni Nabukodonosoru le lurúeite Babilónia Hekoníasi le liráü Hoakimü lidoun amu ageiraü úara hama lábutigu Hudá, sarafangei hama nadagimeintiña gürabu, aba larufudun Aburemei bián faniñe tau igu nun tigibugiñe ténpulu. <verse eid="JER 24:1" /><verse number="2" style="v" sid="JER 24:2" />Lidan aban faniñe, ñeinñoun burí igu to buitu to furumiñetu áfunadutu, ánhounti to lídanboun le aban faniñe wuribaburitu, wéiriti turiban darí lun siñá lan teigín.<verse eid="JER 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 24:3" />Ábati lariñagun Aburemei nun:</para>
  <para style="p" vid="JER 24:3">—Ka barihubei Heremíasi?</para>
  <para style="p" vid="JER 24:3">Nariñaga lun:</para>
  <para style="p" vid="JER 24:3">—Igu burí. To buíduburiboun wéiriti tubuidun; gama lumoun, to wuribaburiboun wéiriti turiban darí lun siñá lan teigín.<verse eid="JER 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 24:4" />Ábati lariñagun Aburemei nun:<verse eid="JER 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 24:5" />—Nariñahare au, le Aburemei, le Lubungiute Ísüraeli: Kei igu to burí buíduboun ítara luba narihiniña lílana Hudá, ha nasagaragüdübaña yáagiñe hageiroun Kalüdéana. Narihubaña lau fuleseihabu, <verse eid="JER 24:5" /><verse number="6" style="v" sid="JER 24:6" />lábugiñebaña nóunigirun, nagiribudagüdübaña lidoun fulasu le. Nawanseragüdübaña ya, magünrinchagun náañame; nábunagubaña, máhulaagun náañame. <verse eid="JER 24:6" /><verse number="7" style="v" sid="JER 24:7" />Níchuguba gunfurandaü hadoun lun hasubudiruni luagu au lan Haburemebei, hagíaba nánigu, aume Habungiute, ladüga hagiribuduba nun tau sun hanigi.<verse eid="JER 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 24:8" />—Ánheinti Sedekíasi le lurúeite Hudá, ábutigu hama híbiri lílana Herusalén ha erederubaña lidan fulasu ligía o ha erederubaña aganawa Ehiptu, nóuserubaña kei igu to siñabei teigín ladüga lueirin turiban. <verse eid="JER 24:8" /><verse number="9" style="v" sid="JER 24:9" />Nadügüba aban katei hau le lunbei líchugun anufudei hadan sun lílana ubóu, ábanbei hénpulu lánina ǘnabuguni, luma íñarawaguni lidan sun fulasu le ñéinhinba lubéi nachagaraña. <verse eid="JER 24:9" /><verse number="10" style="v" sid="JER 24:10" />Nóunahaba wuribu hawagun, ilamaü luma sandi, darime lun merede lan ni aban hádangiñe fulasurugu lidan fulasu le níchugubei houn luma houn hagüchagu.<verse eid="JER 24:10" /></para>
  <chapter eid="JER 24" />
  <chapter number="25" style="c" sid="JER 25" />
  <para style="s1">Ágani le ñǘbuinbei nóruterugugiñe</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 25:1" />Lidan ligadürün lirumudiri larúeihan Hoakimü, le liráü Hosíasi Hudá, aba líchugun Aburemei aban uganu lun Heremíasi habügürü sun lílana Hudá. Ligía bugaha furumiñeti lirumudiri larúeihan Nabukodonosoru Babilónia. <verse eid="JER 25:1" /><verse number="2" style="v" sid="JER 25:2" />Aba lasubudiragüdüni profeta Heremíasi uganu ligía houn sun lílana Hudá luma houn lílana Herusalén. Lariñaga:<verse eid="JER 25:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 25:3" />—Lúmagiñe litareisin lirumudiri larúeihan Hosíasi le liráü Amón Hudá, darí lumoun dan le wein-ǘrüwa irumu guentó lúmagiñe ladimurehan Aburemei nun, aba nadimurehan hun saragu wéiyaasu; gama lumoun madügüntün gasu nau. <verse eid="JER 25:3" /><verse number="4" style="v" sid="JER 25:4" />Ani lau sun saraguhali lan wéiyaasu lóunahaniña Aburemei lánigu profeta humoun, madügüntün gasu, maha huguya haganbun. <verse eid="JER 25:4" /><verse number="5" style="v" sid="JER 25:5" />Ariñagaaña profetagu hun: “Ígira huméi luriban hóuserun; ítara luba gayara lan habagaridun lidan fulasu le líchugubei Aburemei hun luma houn hagüchagu lun sun dan. <verse eid="JER 25:5" /><verse number="6" style="v" sid="JER 25:6" />Mafalara humá amu búngiugu, meseriwida humá houn. Magañidagüda huméi Aburemei eseriwida houn búngiugu ha guánarügü hadüga, ábame móunahan lan ni murusun wuribani huagun”. <verse eid="JER 25:6" /><verse number="7" style="v" sid="JER 25:7" />Lariñahareti Aburemei hun guentó: “Máhatün hadügün gasu nau; gáñigüda humaadina eseriwida houn búngiugu ha guánarügü hadüga, hadügüña wuribani húniwagua”.<verse eid="JER 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 25:8" />—Ligía lariñagunbei Aburemei Suntigabafu: “Kei madügün hubéi gasu lau neweridihan, <verse eid="JER 25:8" /><verse number="9" style="v" sid="JER 25:9" />nagúara houn sun gürigia ha nóruteruguna luma lun nuwügürin Nabukodonosoru le lurúeite Babilónia lun hayabin lun hábürühan luagun fulasu le luma hawagun sun lílana luma hawagun sun ha besinagubaña huma. Nagünrinchagubadün sunsuinagubei. Nadügübadün ni kátame lun sun dan, nadügübadün káteime le hanufunati. <verse eid="JER 25:9" /><verse number="10" style="v" sid="JER 25:10" />Nadügüba lun maganbúndigiaali lanme uremu lánina fedu luma ugundani hadan, ni leremuna maríei, ni lumalali dübü le amuligülei, ni lun larihínya larugoungadüna lanpu. <verse eid="JER 25:10" /><verse number="11" style="v" sid="JER 25:11" />Lagünrinchaguba fulasu le, lárigirugurügaalime eredera. Lábugiñebaña lilurudun lurúeite Babilónia gürigia ha luagu ǘrüwa-wein-diisi irumu. <verse eid="JER 25:11" /><verse number="12" style="v" sid="JER 25:12" />Danme lagunfulirun ǘrüwa-wein-diisi irumu ligía, ábame nafayeiragüdüni lurúeite Babilónia luagu lifigoun hau sun lumutuniña, le hageira Kalüdéana, ábame nagünrinchaguni lun sun dan au, le Aburemei, ariñagubalin. <verse eid="JER 25:12" /><verse number="13" style="v" sid="JER 25:13" />Nábürügüdübei sun le uágubei nariñaga luagun fulasu le, sun le bürüwañubei tidan líburu to. Sun le ariñaga láalibei Heremíasi lidan niri kóntüra sun néchanigu. <verse eid="JER 25:13" /><verse number="14" style="v" sid="JER 25:14" />Heseriwiduba giñe houn néchanigu luma houn urúeigu gabafutiña. Ítara luba nafayeiruniña luagu le hadügübei”.<verse eid="JER 25:14" /></para>
  <para style="s1">Habeichawaguniwa néchanigu</para>
  <para style="p">
    <verse number="15" style="v" sid="JER 25:15" />Lariñahare Aburemei, le Lubungiute Ísüraeli nun:</para>
  <para style="p" vid="JER 25:15">—Arihabéi weru le buin tau diwéin to lánina nigañi. Barüboun, ábame bátagüdünu houn sun néchanigu le ñéinhinba lubéi nóunahabu. <verse eid="JER 25:15" /><verse number="16" style="v" sid="JER 25:16" />Danme le hátunu, ábame hagumeserun ewereha, ábame kéinaba lálülüdün hau ladüga wuribu le lunbei nóunahani hawagun.<verse eid="JER 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 25:17" />Aba nanügünu diwéin lúhaburugugiñe Aburemei, aba nátagüdünu houn sun gürigia ha úmounbaña lóunahana. <verse eid="JER 25:17" /><verse number="18" style="v" sid="JER 25:18" />Guragüda numuti lun Herusalén luma lun burí luburugute Hudá hau sun urúeigu hama ábutigu, lun hagünrinchagun, lun lárigirugurügü lan eredera, katei hanufunati, keisi hénpulu lani íñarawaguni le, ítaramemegiña darí lumoun dan le. <verse eid="JER 25:18" /><verse number="19" style="v" sid="JER 25:19" />Guragüda numutu giñe lun urúei Ehiptuna, hau sun lánigu, <verse eid="JER 25:19" /><verse number="20" style="v" sid="JER 25:20" />luma houn ámuñegueina rasa gürigia ha ñéinbaña; houn sun lurúeitegu Usu hama lóubawaguna hageira Filistéana: Asükalón, Gasa, Ekürón luma le erederubei lídangiñe Asüdódu; <verse eid="JER 25:20" /><verse number="21" style="v" sid="JER 25:21" />lun Edomu, Moabü luma Amón; <verse eid="JER 25:21" /><verse number="22" style="v" sid="JER 25:22" />houn sun lurúeitegu Tiru luma Sidón; houn sun urúeigu ha lurúeitegu fulasu burí le lani barana Mediteraniu; <verse eid="JER 25:22" /><verse number="23" style="v" sid="JER 25:23" />houn türibu ha lani Dedán, Temá, luma Busu, luma houn gürigia ha ásaragubalin hachügü; <verse eid="JER 25:23" /><verse number="24" style="v" sid="JER 25:24" />houn sun lurúeitegu Arawia; houn sun harúeitegu ámuñegueina hawuyeri gürigia ha aganóubaña lidan fulasu mageirawati; <verse eid="JER 25:24" /><verse number="25" style="v" sid="JER 25:25" />houn sun lurúeitegu Simürí, Elamü luma Media; <verse eid="JER 25:25" /><verse number="26" style="v" sid="JER 25:26" />houn sun lurúeitegu nórute, dandu ha yarafaguabaña keisi ha díseguabaña hawariuagua. Houn sun lurúeitegu sun ubóu, lurúeite Babilónia, ligíaba ata agumuhóuni.<verse eid="JER 25:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 25:27" />Lárigiñe aba lariñagun Aburemei nun:</para>
  <para style="p" vid="JER 25:27">—Ariñagabá houn luagu nariñahare lan houn, au, le Aburemei Suntigabafu, le Lubungiute Ísüraeli, lun hátagun darí habacharuadun, ewereha hagíame, heigua hagíame múarugun lun másaarunhaña lan ladüga wuribu le lunbei nóunahani hawagun. <verse eid="JER 25:27" /><verse number="28" style="v" sid="JER 25:28" />Ánhaña maha hanügünu diwéin búmagiñe lun hátunu, bariñagame houn: “Lariñahare Aburemei Suntigabafu: Lau sun luwuyeri, hátuboun. <verse eid="JER 25:28" /><verse number="29" style="v" sid="JER 25:29" />Ladüga nagumesera óunahei abeichúni hawagun lílana uburugu le uágubei liridúa niri. Haritaguatün san luagu mabeichúnbadün lan? Habeichúba, ladüga nóunahaali wuribu haganaguóun sun lílana ubóu. Au, le Aburemei Suntigabafu, ariñagubalin”.<verse eid="JER 25:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 25:30" />—Buguya, Heremíasi, subudigüdabéi burí katei le houn lau niri:</para>
  <para style="b" vid="JER 25:30" />
  <para style="q" vid="JER 25:30">“Aganbagüda lumuti Aburemei lumalali le wayuhuru íñugiñe,</para>
  <para style="q" vid="JER 25:30">lídangiñe fulasu sánduti le ñein lubéi laganawa.</para>
  <para style="q" vid="JER 25:30">Lagúarahaba kóntüra lánigu</para>
  <para style="q" vid="JER 25:30">kei hagúarahan ha adügühabalin beibei.<verse eid="JER 25:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JER 25:31" />Aganbúati areinchuni darí lumoun lébeha ubóu,</para>
  <para style="q" vid="JER 25:31">lugundun laguseragüdübaña Aburemei néchanigu</para>
  <para style="q" vid="JER 25:31">laguseragüdübaña sun gürigia,</para>
  <para style="q" vid="JER 25:31">lasiadirubaña ha salufuribaña lun óunweni.</para>
  <para style="q" vid="JER 25:31">Aburemei ariñagubalin”.<verse eid="JER 25:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="JER 25:32" />Lariñahare Aburemei Suntigabafu:</para>
  <para style="q" vid="JER 25:32">“Liábinba lamiselu houn gürigia aban lárigi aban;</para>
  <para style="q" vid="JER 25:32">ladagaruba aban lanarime dan lúmagiñe luéigiñe lígirugu ubóu”.<verse eid="JER 25:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JER 25:33" />Hame láfaragun Aburemei lidan weyu ligía,</para>
  <para style="q" vid="JER 25:33">herederuba riwagu múarugu lúmagiñe lagumeseha ubóu lumoun lébeha.</para>
  <para style="q" vid="JER 25:33">Úabei ni aban ayahuti hárigi,</para>
  <para style="q" vid="JER 25:33">mabudahóunbaña lun hábunahoun;</para>
  <para style="q" vid="JER 25:33">herederuba múarugu kei hádiga animaalu.<verse eid="JER 25:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="JER 25:34" />Hagúaraha, huguya hóuniri mudún,</para>
  <para style="q" vid="JER 25:34">hagúaraha lau igarigu!</para>
  <para style="q" vid="JER 25:34">Huguya le adundehabaliña ibiñanigu,</para>
  <para style="q" vid="JER 25:34">abalabahóua humá múarugu!</para>
  <para style="q" vid="JER 25:34">Chülüha lóurate áfarahani,</para>
  <para style="q" vid="JER 25:34">ani huguya háfarawaguba keisi mudún dibunetiña.<verse eid="JER 25:34" /></para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" sid="JER 25:35" />Siñabei hanurahan hóuniri mudún,</para>
  <para style="q" vid="JER 25:35">siñabei hesefurun ha adundehabaliña ibiñanigu.<verse eid="JER 25:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="JER 25:36" />Agúarahatiña hóuniri mudún,</para>
  <para style="q" vid="JER 25:36">wáguatiña ha adundehabaliña ibiñanigu lau igarigu,</para>
  <para style="q" vid="JER 25:36">ladüga lagünrinchaguni Aburemei sagadi le heigan habiñanigu.<verse eid="JER 25:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="JER 25:37" />Aba lagañidun Aburemei,</para>
  <para style="q" vid="JER 25:37">aba lagünrinchaguni lubuidun burí hachari.<verse eid="JER 25:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="JER 25:38" />Furiti kei aban liñún lúbiñegiñe aba lagünrinchaguni hageira,</para>
  <para style="q" vid="JER 25:38">ladüga ladurangun ligañi Aburemei aba lóunahan aban lanarime wuribu hawagun.<verse eid="JER 25:38" /></para>
  <chapter eid="JER 25" />
  <chapter number="26" style="c" sid="JER 26" />
  <para style="ms">II. Luáguti Libagari Heremíasi</para>
  <para style="mr">(<ref loc="JER 26-45">26—45</ref>)</para>
  <para style="s1">Lasiadirawaguniwa Heremíasi lun lounwen</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 26:1" />Lidan lagumeserun larúeihan Hoakimü, le liráü Hosíasi, Hudá, aba ladimurehan Aburemei lun Heremíasi, <verse eid="JER 26:1" /><verse number="2" style="v" sid="JER 26:2" />lariñaga lun:</para>
  <para style="p" vid="JER 26:2">—Ráramaba tibürürünrugu ténpulu, ábame bariñaguni sun le nariñagubei bun houn gürigia ha ñǘbuinbaña lídangiñe burí luburugute Hudá áhuduragua ténpulurugu. Mígiraba ni kata mariñagunga. <verse eid="JER 26:2" /><verse number="3" style="v" sid="JER 26:3" />Háfugadügü hadügün gasu bau, ábame hígiruni luriban hóuserun, ábame mabeichun nániña luagu luriban hagaburi, kei yebe naritagun nadügün. <verse eid="JER 26:3" /><verse number="4" style="v" sid="JER 26:4" />Ariñagabá houn luagu nariñahare lan, au le Aburemei: «Anhaün madügün gasu nau, magunfulirun hugíame lau arufudahani le níchugubei hun, <verse eid="JER 26:4" /><verse number="5" style="v" sid="JER 26:5" />madügün huguyame gasu lau heweridihan profetagu ha nóunahabaña humoun saragu wéiyaasu, meberesentün hau, <verse eid="JER 26:5" /><verse number="6" style="v" sid="JER 26:6" />nadügüba tun ténpulu to kei nadüga tun to Siloboun. Nadügübei uburugu le ábanme hénpulu lánina íñarawaguni houn néchanigu ha ubouagubaña».<verse eid="JER 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 26:7" />Aganba hamuti fádirigu, profetagu hama lílana fulasu dimurei burí le lariñagubei Heremíasi ténpulurugu. <verse eid="JER 26:7" /><verse number="8" style="v" sid="JER 26:8" />Lásurun lariñaguni le lariñagubei Aburemei lun, aba hárügüdüni fádirigu hama profetagu, aba hariñagun lun:</para>
  <para style="p" vid="JER 26:8">—Bounwe! <verse eid="JER 26:8" /><verse number="9" style="v" sid="JER 26:9" />Ida luba bariñagun lidan liri Aburemei luagu ítara tuba lan ténpulu to kei to Siloboun, ani lagünrinchawaguba lan uburugu le aba lanme lerederun úouga aganóutiña ñein?</para>
  <para style="p" vid="JER 26:9">Aba haguriridágun sun lílana fulasu geyegu lau Heremíasi ténpulurugu.<verse eid="JER 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 26:10" />Dan haganbunbalin ábutigu Hudá le asuseredubei, aba houdin tídangiñe lani urúei palasiu lun ténpulurugun, aba hañuurun ñein luagu Bena Iseri. <verse eid="JER 26:10" /><verse number="11" style="v" sid="JER 26:11" />Ábati hariñagun fádirigu hama profetagu houn ábutigu luma houn lílana fulasu:</para>
  <para style="p" vid="JER 26:11">—Lunti lasiadirún wügüri le lun lounwen ladüga adimurehaali kóntüra uburugu le. Aganba humuti hungua.<verse eid="JER 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 26:12" />Aba ladimurehan Heremíasi houn ábutigu luma houn lílana fulasu, lariñaga houn:</para>
  <para style="p" vid="JER 26:12">—Aburemei óunahabalina adimureha lidan liri, luma ariñagei sun le haganbubei nariñagun kóntüra ténpulu to, luma uburugu le. <verse eid="JER 26:12" /><verse number="13" style="v" sid="JER 26:13" />Aranse huméi higaburi, aganba huméi Aburemei le Hubungiute, ábame móunahan lani wuribani le uágubei nariñaga hun huagun. <verse eid="JER 26:13" /><verse number="14" style="v" sid="JER 26:14" />Auti, húhaburuguñadina, adüga huméi le habusenrun nau. <verse eid="JER 26:14" /><verse number="15" style="v" sid="JER 26:15" />Gama lumoun subudi huméi le buidu: Luagu ánhana lan háfara hilagubei, dandu huguya kei lílana fulasu le, gadurunbadün luagu háfarun aban gürigia madurunti; lugundun ninarün luagu Aburemei lan óunahabalina ariñagei katei le hun furangu.<verse eid="JER 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 26:16" />Ábati hariñagun ábutigu houn fádirigu, houn profetagu luma houn lílana fulasu:</para>
  <para style="p" vid="JER 26:16">—Mébunati lasiadirún gürigia le lun lounwen; lidan liri Aburemei le Wabungiute ladimureha woun.<verse eid="JER 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 26:17" />Aba hásaarun fiu ábutigu, aba hariñagun houn gürigia ha óundaragubaña ñein:<verse eid="JER 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 26:18" />—Lidan meha lidaani Esekíasi le lurúeite Hudá, adimurehati meha Mikeasi, le Moresétina houn lílana Hudá lidan liri Aburemei, lariñaga houn:</para>
  <para style="b" vid="JER 26:18" />
  <para style="q" vid="JER 26:18">“Lariñahare Aburemei Suntigabafu:</para>
  <para style="q" vid="JER 26:18">Lerederuba Sión kei aban ichari le awouhóuaali,</para>
  <para style="q" vid="JER 26:18">lerederuba Herusalén lidan günringuaü, lárigirugurügaalime eredera</para>
  <para style="q" vid="JER 26:18">láhüchüba sagadi luagu tuwübüri ténpulu”.<verse eid="JER 26:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="JER 26:19" />—Áfara hamuti funagia urúei Esekíasi hama lílana fulasu Mikeasi luéigiñe lira? Lubaragiñe lira: Sándirügüti urúei inebesei lun Aburemei, aba lamuriahan luma lun gudemehabu lan houn. Ábati móunahan lani Aburemei wuribani le yebe uágubei lariñaga hawagun. Wagíameti anüga óunwenbu ihürügu luagu lanarime áfarahani?<verse eid="JER 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 26:20" />Adimurehati giñe profeta Uríasi, le liráü Semaíasi le uburuguna Kiriatü-hearimü lidan liri Aburemei kóntüra uburugu le luma kóntüra ageiraü, ítara kei ladimurehan Heremíasi. <verse eid="JER 26:20" /><verse number="21" style="v" sid="JER 26:21" />Aganba lumuti urúei Hoakimü hau sun lánigu hama ábutigu, aba labusenrun urúei láfaruni. Gama lumoun dan lasubudirunbalin Uríasi, aba lanufudedun, aba lanurahan Ehiptun. <verse eid="JER 26:21" /><verse number="22" style="v" sid="JER 26:22" />Aba lóunahani urúei Hoakimü, Elünatán le liráü Akübóru lun Ehiptun hama amu burí wügüriña, <verse eid="JER 26:22" /><verse number="23" style="v" sid="JER 26:23" />anügei Uríasi Ehiptugiñe, aba hederegeruni lun urúei Hoakimü, le óunahabei áfarei aba háguruni lúgubu lárigiñe háfaruni lidoun umúahaü le ñein lubéi lichugúa hágubu hilaguaaña ha furumiñeguarügü.<verse eid="JER 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 26:24" />Aba ladimurehan Aikamü le liráü Safán luagu lufulesein Heremíasi, aba mederegerúniwa lan houn lílana fulasu lun háfaruni.<verse eid="JER 26:24" /></para>
  <chapter eid="JER 26" />
  <chapter number="27" style="c" sid="JER 27" />
  <para style="s1">Yugu le ichugúbei hawagu animaalugu</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 27:1" />Lidan ligadürün lirumudiri larúeihan Sedekíasi, le liráü Hosíasi Hudá, aba ladimurehan Aburemei lun Heremíasi, <verse eid="JER 27:1" /><verse number="2" style="v" sid="JER 27:2" />lariñaga lun:</para>
  <para style="p" vid="JER 27:2">—Adügabá agürügaü luma aban yugu, ábame bíchuguni luagu bigiina. <verse eid="JER 27:2" /><verse number="3" style="v" sid="JER 27:3" />Óunahaba dimurei hama ha ñǘbuinbaña arihei urúei Sedekíasi barüina hagía ñunsu Herusaléun, lun lurúeite Edomu, lun lurúeite Moabü, lun lurúeite Amón, lun lurúeite Tiru luma lun lurúeite Sidón. <verse eid="JER 27:3" /><verse number="4" style="v" sid="JER 27:4" />Bariñagame houn lun hariñagun houn harúeitegu luagu nariñahare lan au, le Aburemei Suntigabafu, le lurúeite Ísüraeli: <verse eid="JER 27:4" /><verse number="5" style="v" sid="JER 27:5" />Lau óunwenbu ubafu nadügei ubóu, gürigia hama animaalugu ha lídanbaña, ani gayaraati níchuguni lun le unti nabusenra. <verse eid="JER 27:5" /><verse number="6" style="v" sid="JER 27:6" />Ru naali múa le lábugiñoun lubafu Nabukodonosoru le lurúeite Babilónia, sun animaalugu áraabuna ru naaña lábugiñoun lagumadihan. <verse eid="JER 27:6" /><verse number="7" style="v" sid="JER 27:7" />Sun néchanigu lábugiñebaña lagumadihan, ligía, liráü luma libari, darime lachülürün oura lun giñe lerederun lageira lábugiñe hagumadihan néchanigu wéinamutiña hama urúeigu gabafutiña. <verse eid="JER 27:7" /><verse number="8" style="v" sid="JER 27:8" />Néchaniguti o urúeigu ha mígiraguagüdüntiña houngua lun herederun lábugiñe lagumadihan Nabukodonosoru, nabeichubaña lau wuribu, ilamaü luma sandi darí herederun súngubei lábugiñe lugumadin. Au, le Aburemei ariñagubalin.<verse eid="JER 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 27:9" />—Ligía lubeiti madüga humá gasu hau profetagu ha, garíaahatiña o afuranguagüdütiña uénedü, ni hau gabiñarahatiña ha ariñagubaña luagu subudi hamani le lunbei lasuseredun, ha ariñagubaña hun lun míchaagun humá hungua labun lugumadin lurúeite Babilónia. <verse eid="JER 27:9" /><verse number="10" style="v" sid="JER 27:10" />Iyeeni le hariñagubei hun, le lunbei lasuseredun hun, lun hasagarún hageiragiñe, ábameti nachagaragunün lun hóunwegun. <verse eid="JER 27:10" /><verse number="11" style="v" sid="JER 27:11" />Ánhañati ha íchaagutiña houngua labun lubafu lurúeite Babilónia, nígirubaña lun herederun hageira lun haganóun ñein luma lun hábunagun hanadürigu ñein. Au, le Aburemei ariñagubalin.<verse eid="JER 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 27:12" />Au, Heremíasi, aba nariñaguni sun katei le lun Sedekíasi, le Lurúeite Hudá, ariñaga au giñe lun:</para>
  <para style="p" vid="JER 27:12">—Rugua humá hungua labun lubafu lurúeite Babilónia hau sun hánigu, lun habagaridun. <verse eid="JER 27:12" /><verse number="13" style="v" sid="JER 27:13" />Kábagia lebu lun bounwen labu sun bageira lau wuribu, ilamaü luma sandi? Ladüga ariñagaali Aburemei luagu ítara luba lan lasuseredun houn sun gürigia ha míchaaguntiña houngua labun lubafu lurúeite Babilónia. <verse eid="JER 27:13" /><verse number="14" style="v" sid="JER 27:14" />Madüga humá gasu hau profetagu ha ariñagubaña hun lun mígiraguagüdün humá hungua labun lubafu lurúeite Babilónia, lugundun iyeeni le hariñagubei hun. <verse eid="JER 27:14" /><verse number="15" style="v" sid="JER 27:15" />Lariñahare Aburemei luagu mama lan ligía óunahabaliña; iyeeni hadimurehabei lidan liri Aburemei. Ítara, lachagaragubadün Aburemei, ábame hóunwegun hau sun profetagu ha ariñagubalin burí katei le hun.<verse eid="JER 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 27:16" />Adimurehatina giñe houn fádirigu luma houn sun lílana fulasu, nariñaga houn:</para>
  <para style="p" vid="JER 27:16">—Anihán lariñagubei Wabureme: “Madüga humá gasu hau profetagu ha achoururubalin hun luagu málühali lan anhein águyugüdawa tumegen burí ténpulu Babilóniagiñe. Iyeeni le hariñagubei hun. <verse eid="JER 27:16" /><verse number="17" style="v" sid="JER 27:17" />Madüga humá gasu hau, rugua humá hungua labun lubafu lurúeite Babilónia gabagari humaamuga. Kábagia uagu liabin uburugu le lun lárigirugurügaali lanme eredera? <verse eid="JER 27:17" /><verse number="18" style="v" sid="JER 27:18" />Anhein inarüni lubéi luagu profetagu lan hagía, ani inarüni lan luagu adimurehaadina lan houn, amuriaha hamá numa, au le Aburemei Suntigabafu, lun mígirun nan lun lanügǘn tumegen burí ténpulu le aniheinguabei tidan lani lurúeite Hudá palasiu luma uburugu Herusalén lun Babilónioun”.<verse eid="JER 27:18" /></para>
  <para style="p">
    <verse number="19-21" style="v" sid="JER 27:19-21" />—Dan le lanügünbalin lurúeite Babilónia Hekoníasi, le liráü Hoakimü le lurúeite Hudá Herusaléngiñe lun Babilónioun úara hama sun wügüriña wéirigutiña ha Hudaabaña hama ha Herusalénbaña, manügün lumuti wagabu, ni óunwenbu lagei duna lauti buronse, ni ebu, ni líbiri burí ílagu le erederubei ténpulurugu, luma tidan lani lurúeite Hudá palasiu luma uburugu Herusalén: <verse eid="JER 27:19-21" /><verse number="22" style="v" sid="JER 27:22" />“Lanügǘba Babilónioun, ábame lerederun ñein darime nabusenrun nanügüniya lidoun fulasu le. Au, le Aburemei ariñagubalin”.<verse eid="JER 27:22" /></para>
  <chapter eid="JER 27" />
  <chapter number="28" style="c" sid="JER 28" />
  <para style="s1">Heremíasi luma profeta Ananíasi</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 28:1" />Lidan liseingün hati lídanmeme irumu ligía, lememe ligadürün lirumudiri larúeihan Sedekíasi Hudá, aba ladimurehan profeta Ananíasi, le liráü Asuru, le Gabaónna lun Heremíasi ténpulurugu hagibugiñe fádirigu hama sun lílana fulasu, lariñaga lun:<verse eid="JER 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 28:2" />—Lariñahare Aburemei Suntigabafu, le Lubungiute Ísüraeli: “Náhalachagubei lubafu lurúeite Babilónia, <verse eid="JER 28:2" /><verse number="3" style="v" sid="JER 28:3" />ábame nadügün lun lagiribudun sun tílagu ténpulu le lanügübei Nabukodonosoru le lurúeite Babilónia Babilónioun bián irumu lárigiñe le. <verse eid="JER 28:3" /><verse number="4" style="v" sid="JER 28:4" />Nagiribudagüdübei giñe Hekoníasi, le liráü Hoakimü, le lurúeite Hudá lárigoun, hau sun híbiri gürigia ha meha anügǘbaña Hudaagiñe lun Babilónioun. Náhalachagubei lubafu lurúeite Babilónia. Au, le Aburemei ariñagubalin».<verse eid="JER 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 28:5" />Aba lariñagun profeta Heremíasi lun profeta Ananíasi hagibugiñe fádirigu hama gürigia ha ñéinbaña ténpulurugu:<verse eid="JER 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 28:6" />—Adügadügü láamugei Aburemei katei le! Gúnfuligüdadügü láamugei Bungiu dimurei le bariñagubei, lun giñe lagiribudun tílagu ténpulu hama sun ha anügǘbaña Babilónioun Babilóniagiñe! <verse eid="JER 28:6" /><verse number="7" style="v" sid="JER 28:7" />Gama lumoun aganbabéi le, le nariñagubei bun luma houn sun lílana fulasu: <verse eid="JER 28:7" /><verse number="8" style="v" sid="JER 28:8" />Profetagu ha meha lánina binadu dan, lubaragiñe wágurahouniwa au buma, adimurehatiña meha luagu wuribu, ilamaü luma sandi kóntüra saragu néchanigu luma arúeihani wéinamuti. <verse eid="JER 28:8" /><verse number="9" style="v" sid="JER 28:9" />Gama lumoun dan le ladimurehan aban profeta luagu ñeinbei lan lubuidun dan, ánheingubeirügü asusereda le lariñagubei, ligíarügüba lachoururún luagu Aburemei lan óunahabalin.<verse eid="JER 28:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 28:10" />Ábati lagidaruni Ananíasi yugu luéigiñe ligiina Heremíasi, aba láhalachaguni, <verse eid="JER 28:10" /><verse number="11" style="v" sid="JER 28:11" />ariñageina ligía hagibugiñe sun lílana fulasu:</para>
  <para style="p" vid="JER 28:11">—Lariñahare Aburemei: «Ítara luba nadüga bián irumu lárigiñe le, nagidarubei lubafu Nabukodonosoru le lurúeite Babilónia hagiinawagugiñe sun néchanigu, ábame náhalachaguni».</para>
  <para style="p" vid="JER 28:11">Aba lidin Heremíasi. <verse eid="JER 28:11" /><verse number="12" style="v" sid="JER 28:12" />Átiri dan lárigiñe lagidaruni Ananíasi yugu ligiinagiñe Heremíasi, aba ladimurehan Aburemei lun Heremíasi, lariñaga lun:<verse eid="JER 28:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 28:13" />—Beiba, bariñagame lun Ananíasi luagu nariñahare lan au, le Aburemei: Halaguatibu aban yugu le lauti wewe, gama lumoun aransedina aban yugu lauti gürabu. <verse eid="JER 28:13" /><verse number="14" style="v" sid="JER 28:14" />Lugundun nariñahare au, le Aburemei Suntigabafu, le Lubungiute Ísüraeli: Rúhadina aban yugu lauti gürabu hagiinawagu sun néchanigu lun heseriwidun keisi idamuni lun Nabukodonosoru, le lurúeite Babilónia. Íbini animaalugu áraabuna, ru naaña labun lubafu.<verse eid="JER 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 28:15" />Ábati lariñagun Heremíasi lun Ananíasi:</para>
  <para style="p" vid="JER 28:15">—Aganbabá Ananíasi! Mama Aburemei óunahabalibu, rúhadibu aban emenigini málati houn gürigia ha. <verse eid="JER 28:15" /><verse number="16" style="v" sid="JER 28:16" />Ligíati lariñahare lubéi Aburemei: «Anha, nóunahabadibu, gama lumoun lun bagumuchagun ligibuagugiñe ubóu le. Bóunweba lidan irumu le, ladüga adügaadibu lun hagarabaagun gürigia nuagun lau bererun».<verse eid="JER 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 28:17" />Aba lounwen profeta Ananíasi lidan lisedün hati lidan irumuméme ligía.<verse eid="JER 28:17" /></para>
  <chapter eid="JER 28" />
  <chapter number="29" style="c" sid="JER 29" />
  <para style="s1">Ligaradan Heremíasi houn ha asagarúbaña hageiragiñe</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 29:1" />«Anihán tila gárada to lóunahaboun profeta Heremíasi Herusaléngiñe houn wéiyaaña mutu ha erederubaña hádangiñe ha anügǘbaña, luma houn fádirigu hama profetagu hama sun gürigia ha lanügübaña Nabukodonosoru Herusaléngiñe lun Babilónioun: <verse eid="JER 29:1" /><verse number="2" style="v" sid="JER 29:2" />Lárigiñe láfuridun urúei Hekoníasi tau lúguchu, hama ha tílana palasiu, hama ábutigu Hudá luma Herusalén luma houn sun gürigia. <verse eid="JER 29:2" /><verse number="3" style="v" sid="JER 29:3" />Gárada tuguya luma Elasá le liráü Safán, Gemaríasi, le liráü Ilükíasi lóunahoun Sedekíasi le lurúeite Hudá lumoun lurúeite Babilónia Nabukodonosoru. Lariñahare tidan:<verse eid="JER 29:3" /></para>
  <para style="pi">
    <verse number="4" style="v" sid="JER 29:4" />Lariñahare Aburemei Suntigabafu, le Lubungiute Ísüraeli, houn sun ha lasagaragüdübaña Herusaléngiñe lun Babilónioun: <verse eid="JER 29:4" /><verse number="5" style="v" sid="JER 29:5" />“Hábunagua muna lun haganóun tidan; hábunagua nadü lun héigini tin. <verse eid="JER 29:5" /><verse number="6" style="v" sid="JER 29:6" />Maríei humá, garahüñügua humá, maríeigua hagíame hirahüñü lun giñe garahüñügua hamá gíbegua humaamuga ñein. <verse eid="JER 29:6" /><verse number="7" style="v" sid="JER 29:7" />Huádigimarida luagu lufulesein uburugu le ñeinhin lubéi nanügagüdaün, hamuriaha numa luagu, ladüga anhein buidu lidin lun, buídubei giñe lidin hun. <verse eid="JER 29:7" /><verse number="8" style="v" sid="JER 29:8" />Nariñahare hun, au, le Aburemei Suntigabafu, le Lubungiute Ísüraeli: Mígira humá lun heyeedunün profetagu hama garíaahatiña ha haganaguabaña; madüga humá gasu lau burí hawenedü. <verse eid="JER 29:8" /><verse number="9" style="v" sid="JER 29:9" />Iyeeni le hariñagubei hun lidan niri. Mama au óunahabaliña. Au, le Aburemei ariñagubalin”.<verse eid="JER 29:9" /></para>
  <para style="pi">
    <verse number="10" style="v" sid="JER 29:10" />«Lariñahare Aburemei: “Danme lagunfulirun ǘrüwa-wein-diisi irumu lun Babilónia, nuadigimariba luagu hufulesein, nagunfulirubei nererun lau nagiribudagüdünün lidoun fulasu le. <verse eid="JER 29:10" /><verse number="11" style="v" sid="JER 29:11" />Subudi numuti naransehan hubá, aransehani lun buiti mama lun wuribati hun, lun gayaraabei lan níchuguni dan le lunbei liabin buin lau emenigini hun. Au, le Aburemei ariñagubalin. <verse eid="JER 29:11" /><verse number="12" style="v" sid="JER 29:12" />Ábameti hagúahanina, afurieida huguyame nun ábame naganbunün. <verse eid="JER 29:12" /><verse number="13" style="v" sid="JER 29:13" />Háluahabadina ani hadarirubadina ladüga háluahabadina tau sun hanigi. <verse eid="JER 29:13" /><verse number="14" style="v" sid="JER 29:14" />Nígiruba lun hadarirunina, nadügüba lun lasansiragun hubunurun: Nasagarubadün lídangiñe sun fulasu le meha ñeinhin lubéi nachagaraguaün, ábame nóundarunün, ábame nadügün lun hagiribudun lidoun fulasu le. Au le Aburemei ariñagubalin”.<verse eid="JER 29:14" /></para>
  <para style="pi">
    <verse number="15" style="v" sid="JER 29:15" />«Hariñahare: “Rúhali Aburemei profetagu woun Babilónia”. <verse eid="JER 29:15" /><verse number="16" style="v" sid="JER 29:16" />Lariñahare Aburemei libügürü urúei le luágubei lálana larúeihan Dawidi luma habügürü lílana uburugu le, ha hiduheñu ha manügǘnbaña huma lídanbei hasagarúniwa hageiragiñe: <verse eid="JER 29:16" /><verse number="17" style="v" sid="JER 29:17" />“Nariñahare au, le Aburemei Suntigabafu: Nóunahaba wuribu, ilamaü luma sandi huagun. Nadügüba lun herederun kei igu ñalaaru to siñabei teigín ladüga lueirin turiban. <verse eid="JER 29:17" /><verse number="18" style="v" sid="JER 29:18" />Néibaahabadün lau wuribu, ilamaü luma sandi, nadügüba lun sun lan ha arihitün hiyereegudún houn, nadügübadün hénpulume lani íñarawaguni luma busiganu, hanufunebadün lidan sun fulasu le ñeinhin lubéi nachagaraguaün. <verse eid="JER 29:18" /><verse number="19" style="v" sid="JER 29:19" />Ladüga madügün hamá gasu lau eweridihani le nadügübei hun hádangiñe nani profetagu, ha nóunahabaña saragu wéiyaasu ani maganbun humutiña. Au, le Aburemei ariñagubalin. <verse eid="JER 29:19" /><verse number="20" style="v" sid="JER 29:20" />Aganba huméi lubeiti nererun, sun huguya le nasagaragüdübei Herusaléngiñe lun Babilónioun”.<verse eid="JER 29:20" /></para>
  <para style="pi">
    <verse number="21" style="v" sid="JER 29:21" />«Lariñahare Aburemei Suntigabafu, le Lubungiute Ísüraeli libügürü Aabü, le liráü Kolaíasi luma libügürü Sedekíasi, le liráü Maseíasi, ha adimurehabaña iyeeni hun lidan liri Aburemei: “Nadügüba lun hábürühan labun lubafu Nabukodonosoru le lurúeite Babilónia, ábame láfaraguniña higibugiñe. <verse eid="JER 29:21" /><verse number="22" style="v" sid="JER 29:22" />Dánmeti habusenrun lílana Hudá ha Babilóniabaña híñaragun aban gürigia, ábame hariñagun: Adüga láamuga Aburemei bun kei ladüga lun Sedekíasi luma lun Aabü, ha lásürahabaña lurúeite Babilónia lidan watu gemeti. <verse eid="JER 29:22" /><verse number="23" style="v" sid="JER 29:23" />Lasusereduba le houn ladüga hadügün burí katei wuribati Ísüraeli: Adaaguatiña agabarahani hama hámarigu wügüriña háledigu, ariñaga hagía burí iyeeni lidan niri le mama nariñagun houn lun hariñaguni. Subudi numuti ani gefentina luagu. Au, le Aburemei ariñagubalin” ».<verse eid="JER 29:23" /></para>
  <para style="s1">Ñunsu lun Semaíasi</para>
  <para style="p">
    <verse number="24" style="v" sid="JER 29:24" />Aba lariñagun Aburemei lun Heremíasi lun lariñagun lun Semaíasi, le Neelamüna:<verse eid="JER 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 29:25" />—Lariñahare Aburemei Suntigabafu, le Lubungiute Ísüraeli: “Óunahatibu aban gárada luagu biri houn sun gürigia ha Herusalénbaña, luma houn sun híbiri fádirigu. Bariñahare lun Sofoníasi tidan gárada tuguya: <verse eid="JER 29:25" /><verse number="26" style="v" sid="JER 29:26" />Ru laadibu Aburemei fádirime leweñegua Hoyadá lun buguyaba lan óunigiruti ténpulurugu le íñutimabei. Anhein ñübuin aban lülü tau adimureha keisi profeta, lunti badaürüni bagüragueime lau güringüri. <verse eid="JER 29:26" /><verse number="27" style="v" sid="JER 29:27" />Kati uagu madeinhan bubéi lun Heremíasi le Anatótuna, le adimurehaalibei higibugiñe keisi profeta? <verse eid="JER 29:27" /><verse number="28" style="v" sid="JER 29:28" />Darí lun óunaha lan aban gárada woun Babilónioun, le ñein lubéi lariñaga: Haduraruba gürigia ha asagarúbaña hageiragiñe saragu dan; bunagua humá muna lun haganóun ñein, bunagua huguyame nadü lun héigini tin”.<verse eid="JER 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 29:29" />Aliiha lumutu fádiri Sofoníasi gárada tuguya lun Heremíasi. <verse eid="JER 29:29" /><verse number="30" style="v" sid="JER 29:30" />Ábati ladimurehan Aburemei lun profeta Heremíasi, lariñaga lun: <verse eid="JER 29:30" /><verse number="31" style="v" sid="JER 29:31" />«Óunahaba ariñaga houn sun ha asagarúbaña hageiragiñe luagu nariñahare lan houn au le Aburemei: Kei adimurehaali lan Semaíasi le Neelamüna hun lidan niri móunahanganei, ani rúhali aban emenigini málati hun, <verse eid="JER 29:31" /><verse number="32" style="v" sid="JER 29:32" />nariñahare au, le Aburemei luagu nabeichubei lan Semaíasi hama ladügawagun. Madügawagunbei hadan numutuniña, mafanran ligíame lidan ugundani le lunbei níchuguni houn numutuniña, ladüga garabaguagüda laaña nuagun lau lererun. Au, le Aburemei ariñagubalin».<verse eid="JER 29:32" /></para>
  <chapter eid="JER 29" />
  <chapter number="30" style="c" sid="JER 30" />
  <para style="s1">Füramasei lúmagiñeti Aburemei lun dan le úagilibei</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 30:1" />Anihán uganu líchugubei Aburemei lun Heremíasi:<verse eid="JER 30:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 30:2" />—Lariñahare Aburemei le Lubungiute Ísüraeli: Abürühabei sun le ariñaga náalibei bun tidan aban líburu, <verse eid="JER 30:2" /><verse number="3" style="v" sid="JER 30:3" />lugundun anitebei weyu lun nasansiruni habunurun numutuniña Ísüraelina hama Hudaana. Au, le Aburemei ariñagubalin. Nagiribudagüdübaña lidoun múa le meha níchugubei houn hagübürigu keisi hamegen.<verse eid="JER 30:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 30:4" />Anihán ñunsu lúmagiñe Aburemei libügürü Ísüraeli luma Hudá. <verse eid="JER 30:4" /><verse number="5" style="v" sid="JER 30:5" />Lariñahare Aburemei:</para>
  <para style="b" vid="JER 30:5" />
  <para style="q" vid="JER 30:5">«Aganbúati agúarahani lánina lueirin anufudei luma lúan darangilaü!<verse eid="JER 30:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 30:6" />Álügüdaha humá anhein gayara lubéi lágurahan aban wügüri.</para>
  <para style="q" vid="JER 30:6">Kati uagu narihaña wügüriña ayubiahóua lau gáriti</para>
  <para style="q" vid="JER 30:6">kamá hamuga hagariduña?</para>
  <para style="q" vid="JER 30:6">Ka uagu harumalida sun hagía?<verse eid="JER 30:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 30:7" />Aniteeli aban lanarime weyu,</para>
  <para style="q" vid="JER 30:7">aban weyu le úagili amu libe!</para>
  <para style="q" vid="JER 30:7">Ábanbei dan le lidaani idiheri houn lumutuniña Hakobu,</para>
  <para style="q" vid="JER 30:7">gama lumoun nesefurubaña.<verse eid="JER 30:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 30:8" />Au, le Aburemei Suntigabafu, nariñahare:</para>
  <para style="q" vid="JER 30:8">Nesefurubaña numutuniña lábugiñegiñe yugu le lánina amudirawaguni,</para>
  <para style="q" vid="JER 30:8">mamudiragundigia hamaañame terencha.<verse eid="JER 30:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 30:9" />Ábame heseriwidun nun,</para>
  <para style="q" vid="JER 30:9">au le Habungiute, luma lun Dawidi,</para>
  <para style="q" vid="JER 30:9">le lunbei níchuguni harúeiteme.<verse eid="JER 30:9" /></para>
  <para style="s1">Lesefurubaña Aburemei lumutuniña</para>
  <para style="r">(<ref loc="JER 46:27-28">Her 46.27-28</ref>)</para>
  <para style="q">
    <verse number="10" style="v" sid="JER 30:10" />«Nariñahare au, le Aburemei:</para>
  <para style="q" vid="JER 30:10">Manufudeda humá, lánigu Hakobu, le nubuein;</para>
  <para style="q" vid="JER 30:10">manufudedabá Ísüraeli,</para>
  <para style="q" vid="JER 30:10">ladüga nesefurubadibu hau sun birahüñü</para>
  <para style="q" vid="JER 30:10">lídangiñe ageiraü díseti le ñeinhin lubéi hanügaün.</para>
  <para style="q" vid="JER 30:10">Babagaridayaba darangilu mañawarihounga bun ani madiheriga.<verse eid="JER 30:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 30:11" />Nariñahare au, le Aburemei,</para>
  <para style="q" vid="JER 30:11">luagu búmañadina lan lun nesefurunibu.</para>
  <para style="q" vid="JER 30:11">Nagünrinchagubaña sun néchanigu ha ídounbaña nachagaraguabu.</para>
  <para style="q" vid="JER 30:11">Ánheinti buguya, magünrinchagun nubadibu;</para>
  <para style="q" vid="JER 30:11">béirügü nubadibu keisi badüna lun babeichún;</para>
  <para style="q" vid="JER 30:11">mígirun nubadibu mabeichúnga».<verse eid="JER 30:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="JER 30:12" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 30:12">«Mareidaguaditi bugumein,</para>
  <para style="q" vid="JER 30:12">máraninati wuribati le buágubei.<verse eid="JER 30:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 30:13" />Úati kaba lan etenira bun,</para>
  <para style="q" vid="JER 30:13">úati kaba lan agaraniha lun biti le buágubei</para>
  <para style="q" vid="JER 30:13">ani maraninatibu.<verse eid="JER 30:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 30:14" />Bulíei hamaadibu sun bubúaligu,</para>
  <para style="q" vid="JER 30:14">meberesenhaaña bau.</para>
  <para style="q" vid="JER 30:14">Ladüga aba níbugunibu</para>
  <para style="q" vid="JER 30:14">kamá hamuga bágani au,</para>
  <para style="q" vid="JER 30:14">bei numutibu buidu luagu liibe wuribati le badügübei,</para>
  <para style="q" vid="JER 30:14">luagu liibe bifigoun.<verse eid="JER 30:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 30:15" />Ka uagu bagúaraha luagu biti le buágubei?</para>
  <para style="q" vid="JER 30:15">Máraninati bigarigu.</para>
  <para style="q" vid="JER 30:15">Ladüga lueirin buriban</para>
  <para style="q" vid="JER 30:15">luma liibe bifigoun nóuserabu ítara.<verse eid="JER 30:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 30:16" />Gama lumoun, sun le adügüti wuribati bun,</para>
  <para style="q" vid="JER 30:16">ladügǘba giñe wuribati lun,</para>
  <para style="q" vid="JER 30:16">ani hanügǘba báganiñu lidoun ageiraü le mama hageira;</para>
  <para style="q" vid="JER 30:16">nadügüba lun hasagarahóun ha asagarahabalibu,</para>
  <para style="q" vid="JER 30:16">luma lun líweruhoun hawéi ha íweruhabaña buéi.<verse eid="JER 30:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 30:17" />Náguyugüdübei bátuadi bun,</para>
  <para style="q" vid="JER 30:17">nagaranihaba lun biti le buágubei,</para>
  <para style="q" vid="JER 30:17">íbini ánhaña ariñaga báganiñu:</para>
  <para style="q" vid="JER 30:17">“Fuiwa Sión, meberesenwaali lau”.</para>
  <para style="q" vid="JER 30:17">Au, le Aburemei ariñagubalin».<verse eid="JER 30:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="JER 30:18" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 30:18">«Nasansirubei habunurun linechanin Hakobu,</para>
  <para style="q" vid="JER 30:18">gudemehabubadina lun hageira;</para>
  <para style="q" vid="JER 30:18">lararamayaba burí uburugu lidan guánarügü lárigirugu,</para>
  <para style="q" vid="JER 30:18">tuma burí palasiu lidan tubara.<verse eid="JER 30:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 30:19" />Láfuriduba uremu lánina eteingiruni</para>
  <para style="q" vid="JER 30:19">luma éherahani lánina ugundani hádangiñe.</para>
  <para style="q" vid="JER 30:19">Malouguadunbaña ladüga nadügüba lun haganwoundun.</para>
  <para style="q" vid="JER 30:19">Michugúnbei mebereseni hau</para>
  <para style="q" vid="JER 30:19">lugundun níchuguba uéiriguni houn.<verse eid="JER 30:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 30:20" />Ítara haba Ísüraelina kei meha furumiñe;</para>
  <para style="q" vid="JER 30:20">deregüdagu haba nigibugiñe,</para>
  <para style="q" vid="JER 30:20">nabeichubaña ha íchugubaña lidere dan houn.<verse eid="JER 30:20" /></para>
  <para style="q">
    <verse number="21-22" style="v" sid="JER 30:21-22" />Hádangiñeba láfurida hábuti;</para>
  <para style="q" vid="JER 30:21-22">láfuriduba aban agumadihati hádangiñe guánarügü.</para>
  <para style="q" vid="JER 30:21-22">Nadügüba lun hayarafadun nun, lugundun,</para>
  <para style="q" vid="JER 30:21-22">Kaba hamugagia ayarafada nun?</para>
  <para style="q" vid="JER 30:21-22">Hagíaba numutuniña, aume Habungiute,</para>
  <para style="q" vid="JER 30:21-22">Au le Aburemei ariñagubalin».<verse eid="JER 30:21-22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="JER 30:23" />Ítara liña ligañi Aburemei kei aban luriban dan,</para>
  <para style="q" vid="JER 30:23">kei aban garabali le lauti herigini</para>
  <para style="q" vid="JER 30:23">le áfurubei hawagun wuribatiña.<verse eid="JER 30:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 30:24" />Meredebei ligañi Aburemei,</para>
  <para style="q" vid="JER 30:24">darime adüga laali le laritagubei ladügün.</para>
  <para style="q" vid="JER 30:24">Lachülürüba dan lun gunfuranda humani burí katei le.<verse eid="JER 30:24" /></para>
  <chapter eid="JER 30" />
  <chapter number="31" style="c" sid="JER 31" />
  <para style="s1">Hagiribudun Ísüraelina hageiroun</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 31:1" />Lariñahare Aburemei:</para>
  <para style="p" vid="JER 31:1">—Lídanme dan ligía, auba Habungiute sun lani Ísüraeli türibu, hagíame numutuniña.<verse eid="JER 31:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JER 31:2" />Lariña hare Aburemei:</para>
  <para style="q" vid="JER 31:2">«Arufuda numuti nareini lidan fulasu mageirawati</para>
  <para style="q" vid="JER 31:2">houn gürigia ha esefurubaña luéi óunweni.</para>
  <para style="q" vid="JER 31:2">Dan buga láluahan Ísüraeli aban fulasu lun lemeraagun,<verse eid="JER 31:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 31:3" />ladüga lüha nariñagun lun Ísüraeli:</para>
  <para style="q" vid="JER 31:3">Hínsiñegubeiñadibu nun nageira, lau ínsiñeni le magumuchaditi</para>
  <para style="q" vid="JER 31:3">ligía nóuserunmemebalibu lau areini.<verse eid="JER 31:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 31:4" />Nararamagüdayabadibu, Ísüraeli.</para>
  <para style="q" vid="JER 31:4">Biábinyaba lau panderu abinaha lau ugundani.<verse eid="JER 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 31:5" />Bábunaguayaba beibei-agei luagu luwübüri Samaria,</para>
  <para style="q" vid="JER 31:5">ani ha ábunagutiña beibei, héigiba lídangiñe lin.<verse eid="JER 31:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 31:6" />Lugundun lachülürüba aban weyu lun</para>
  <para style="q" vid="JER 31:6">hagúaragun óunigirutiña luagu luwübüri Éfürain:</para>
  <para style="q" vid="JER 31:6">“Higougu, keimoun Sión lun Aburemei le Wabungiute” ».<verse eid="JER 31:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="JER 31:7" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 31:7">«Heremuha lau ugundani hawagu lumutuniña Hakobu,</para>
  <para style="q" vid="JER 31:7">ha wéirigutimabaña hadan sun néchanigu.</para>
  <para style="q" vid="JER 31:7">Aganbualá heremuhan, ariñaga humá:</para>
  <para style="q" vid="JER 31:7">“Sefu lumutiña Aburemei lánigu,</para>
  <para style="q" vid="JER 31:7">ha erederubaña hádangiñe Ísüraelina”.<verse eid="JER 31:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 31:8" />Nagiribudagüdübaña lídangiñe lagumuhóun larigei ubóu</para>
  <para style="q" vid="JER 31:8">hayabinba marihintiña hama, danimatiña,</para>
  <para style="q" vid="JER 31:8">würiña dageinatiña hama ha águrahaaña;</para>
  <para style="q" vid="JER 31:8">Hagiribuduba saragu gürigia!<verse eid="JER 31:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 31:9" />Hayabinba ayahuaheina luma afurieideina.</para>
  <para style="q" vid="JER 31:9">Nanügübaña le ñein lumuti saragu duna,</para>
  <para style="q" vid="JER 31:9">lídangiñe aban üma le úaraguati,</para>
  <para style="q" vid="JER 31:9">le ñein lumuti machugeragun hamá.</para>
  <para style="q" vid="JER 31:9">Ladüga au lúguchibei Ísüraeli,</para>
  <para style="q" vid="JER 31:9">Éfürain nígiramabei.<verse eid="JER 31:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="JER 31:10" />«Néchanigu, aganba huméi lererun Aburemei,</para>
  <para style="q" vid="JER 31:10">ani adimureha humá lidan burí kosu le díseburibei:</para>
  <para style="q" vid="JER 31:10">“Chagagua lumutiña Aburemei Ísüraelina,</para>
  <para style="q" vid="JER 31:10">gama lumoun lóundarubaña ábame lóunigiruniña</para>
  <para style="q" vid="JER 31:10">kei lóunigiruniña amainiruti mudún lilügüniña mudún”.<verse eid="JER 31:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 31:11" />Lugundun sefu lumutiña Aburemei lumutuniña Hakobu,</para>
  <para style="q" vid="JER 31:11">sefu lumutiña luéi aban néchani héretimati.<verse eid="JER 31:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 31:12" />Hayabinba ábame heremuhan lau ugundani</para>
  <para style="q" vid="JER 31:12">lidan fulasu le íñutimabei Sión,</para>
  <para style="q" vid="JER 31:12">hagundaaraguba lau buiti le líchugubei Aburemei:</para>
  <para style="q" vid="JER 31:12">Türigu, diwéin luma garaba, mudún hama bágasu.</para>
  <para style="q" vid="JER 31:12">Ítara haba kei aban nadü-agei le túaguati,</para>
  <para style="q" vid="JER 31:12">meferidirun hamaalime here.<verse eid="JER 31:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 31:13" />Habinahaba würiña irahüñü lau ugundani</para>
  <para style="q" vid="JER 31:13">kéigubeirügü wügüriña ha nibureingiña hama wéiyaaña mutu.</para>
  <para style="q" vid="JER 31:13">Níchuguba dǘgüdaguaü houn:</para>
  <para style="q" vid="JER 31:13">Nasansirubei hayahun lun ugundanime,</para>
  <para style="q" vid="JER 31:13">níchuguba ugundani houn le wéiritimati luéi hagarigu.<verse eid="JER 31:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 31:14" />Nadügüba lun héigini fádirigu lubuidun-agei éigini,</para>
  <para style="q" vid="JER 31:14">luma lun gafanran hamá nánigu lidan liibe buiti le níchugubei.</para>
  <para style="q" vid="JER 31:14">Au, le Aburemei ariñagubalin».<verse eid="JER 31:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="JER 31:15" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 31:15">«Aganbúati aban umalali Ramá,</para>
  <para style="q" vid="JER 31:15">le hamalali ayahutiña lau igarigu,</para>
  <para style="q" vid="JER 31:15">Rakeli to ayahuboun hárigi tirahüñü,</para>
  <para style="q" vid="JER 31:15">máhatu lun támalihoun ladüga hilagua lan tirahüñü».<verse eid="JER 31:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="JER 31:16" />Gama lumoun lariñaga Aburemei tun:</para>
  <para style="q" vid="JER 31:16">«Rakeli, hebé bayahun,</para>
  <para style="q" vid="JER 31:16">hebé láwiyurun báguira,</para>
  <para style="q" vid="JER 31:16">ladüga gafayeiruahabei bigarigu:</para>
  <para style="q" vid="JER 31:16">Hayabinyaba birahüñü hageiragiñe áganiñu.</para>
  <para style="q" vid="JER 31:16">Au, le Aburemei ariñagubalin.<verse eid="JER 31:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 31:17" />Anihein aban emenigini bun:</para>
  <para style="q" vid="JER 31:17">Hagiribuduba birahüñü hageiroun.</para>
  <para style="q" vid="JER 31:17">Au, le Aburemei ariñagubalin.<verse eid="JER 31:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 31:18" />Aganba naaña lánigu Éfürain ekehara lau igarigu, hariñaga:</para>
  <para style="q" vid="JER 31:18">“Ítara niña meha kei aban liraüraü bágasu le mabuchahati,</para>
  <para style="q" vid="JER 31:18">gama lumoun gidá baali numabuchahan,</para>
  <para style="q" vid="JER 31:18">giribugüdabana búmaguoun,</para>
  <para style="q" vid="JER 31:18">ladüga buguya Aburemeibei le Nubungiute.<verse eid="JER 31:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 31:19" />Asakürihaadina luagu nadisedun buéi;</para>
  <para style="q" vid="JER 31:19">ariha naali nungua lídanñadina lan figóu</para>
  <para style="q" vid="JER 31:19">ligía narufudunbalin nasakürihan lau náfarahani niyada,</para>
  <para style="q" vid="JER 31:19">sanditina busiganu luagu lifigouna niburein nan”.<verse eid="JER 31:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="JER 31:20" />«Ítara haña lumutuniña Éfürain nun</para>
  <para style="q" vid="JER 31:20">kei aban isaani hínsiñeguti;</para>
  <para style="q" vid="JER 31:20">ligía isaani le hínsiñetimabei nun.</para>
  <para style="q" vid="JER 31:20">Lau sun nadeinhan lun, mabulieidun numuti;</para>
  <para style="q" vid="JER 31:20">gudemehabutu nanigi lun.</para>
  <para style="q" vid="JER 31:20">Au le Aburemei ariñagubalin.<verse eid="JER 31:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 31:21" />«Ísüraeli, bíchaaha seini luagu üma,</para>
  <para style="q" vid="JER 31:21">ménrengun láamugaya badariruni;</para>
  <para style="q" vid="JER 31:21">arihabéi üma le buga ídanbei béibuga buidu.</para>
  <para style="q" vid="JER 31:21">Giribubá Ísüraeli,</para>
  <para style="q" vid="JER 31:21">giribubá lidoun burí buburugute!<verse eid="JER 31:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 31:22" />Ídaba san leredera yagüroun yaroun ban</para>
  <para style="q" vid="JER 31:22">kamá aban isaani to acharagadutu.</para>
  <para style="q" vid="JER 31:22">Au, le Aburemei, nadügüba lun lasuseredun aban katei iseri lidan ubóu le:</para>
  <para style="q" vid="JER 31:22">Tóunigirubei lan würi wügüri!»<verse eid="JER 31:22" /></para>
  <para style="s1">Lachülürüba dan lun lawanserun Ísüraeli</para>
  <para style="p">
    <verse number="23" style="v" sid="JER 31:23" />Lariñahare Aburemei Suntigabafu, le Lubungiute Ísüraeli:</para>
  <para style="p" vid="JER 31:23">—Danme le nasansiruni habunurun lílana Hudá, danme le lídanhaña hageira, haburuguterugu, hariñagayaba: “Binilei Aburemei wübü sánduti le ñein lubéi laganawa irichaü!” <verse eid="JER 31:23" /><verse number="24" style="v" sid="JER 31:24" />Haganóuba lumutuniña Hudá, hama lílana burí luburugute, ábunagutiña nadü hama hóuniri habiñanigu ñein. <verse eid="JER 31:24" /><verse number="25" style="v" sid="JER 31:25" />Níchuguba saragu éigini luma uniñein houn ha buchaañabaña uagu ani mere hagía.<verse eid="JER 31:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JER 31:26" />Aba nagagudún, aba néfegechuni nagu. Ma nugundan lau nuénedü.<verse eid="JER 31:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 31:27" />Lariñahare Aburemei:</para>
  <para style="p" vid="JER 31:27">—Lachülürüba weyu lun nadügün lun hagibedun gürigia hama animaalugu Ísüraeli luma Hudá. <verse eid="JER 31:27" /><verse number="28" style="v" sid="JER 31:28" />Ani ítara kei buga aranseñu nan lun náhulahan, lun nachagahan, lun nagünrinchagun luma lun nadügün damichi, ítara luba giñe aranseñu nan lun nararamagüdün luma lun nábunagun. Au le Aburemei ariñagubalin.<verse eid="JER 31:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 31:29" />—Lídanme dan ligía, mariñawagúnhalime: “Hóutiña agübürigu beibei garühütu aba láseiseidun hari hasaanigu”. <verse eid="JER 31:29" /><verse number="30" style="v" sid="JER 31:30" />Ladüga le éigiti beibei garühütu, ligíaba áseiseida lari. Lóunweba kada aban luagu lifigoun guánarügü.<verse eid="JER 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JER 31:31" />Lariñahare Aburemei:</para>
  <para style="p" vid="JER 31:31">—Lachülürüba weyu lun nadügün aban iseri daradu luma Ísüraeli labu Hudá. <verse eid="JER 31:31" /><verse number="32" style="v" sid="JER 31:32" />Mítaranbei daradu ligía kei le meha nadügübei hama hagüchagu dan le nárügüdünbalin háhabu lun nasagaruniña Ehiptugiñe; ladüga hagía, magunfulirun hamuti nidaradun, lau sun au lan buga Haburemebei. Au, le Aburemei ariñagubalin. <verse eid="JER 31:32" /><verse number="33" style="v" sid="JER 31:33" />Anihán daradu le lunbei nadügüni luma Ísüraeli lídounme dan ligía: Níchugubei nilurudun tidoun lanigi, ábame nabürüdüni lidan lisaminan. Auba Habungiute, hagíame numutuniña. Au, le Aburemei ariñagubalin. <verse eid="JER 31:33" /><verse number="34" style="v" sid="JER 31:34" />Memegeirúnwaalime lun larufudahan gürigia lun lumada o lun lan liduhe lun hasubudirunina, lugundun hasubudirubadina súngubei, lúmagiñe le wéiyatimahalibei dagá lumoun le ñǘraütimagilibei. Feruduna nubéi hariban, maritagundigiaadiname luagun hafigoun. Au, le Aburemei ariñagubalin.<verse eid="JER 31:34" /></para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" sid="JER 31:35" />Lariñahare Aburemei le íchugubalin weyu lun ladurangun wéyuagu</para>
  <para style="q" vid="JER 31:35">luma hati hama waruguma lun hadurangun áriebu,</para>
  <para style="q" vid="JER 31:35">le adügübei lun lánhingichun barana ahuuha ligía lugudi barana,</para>
  <para style="q" vid="JER 31:35">le gíribei Aburemei Suntigabafu:<verse eid="JER 31:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="JER 31:36" />«Ánheindügü hamuga achülüra weyu lun lachararun lúrudu</para>
  <para style="q" vid="JER 31:36">le burí níchugubei lun weyu, hati, waruguma, barana.</para>
  <para style="q" vid="JER 31:36">Ligíaba weyu ligía mámaaña lanme numutuniña Ísüraelina.</para>
  <para style="q" vid="JER 31:36">Au, le Aburemei ariñagubalin.<verse eid="JER 31:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="JER 31:37" />Lúndügü hamuga lamisurahóun sielu,</para>
  <para style="q" vid="JER 31:37">eibugúa ligía hamuga sun ubóu aríaahei chülǘ lumoun lagumeseha,</para>
  <para style="q" vid="JER 31:37">anhein hamuga asusereda ítara</para>
  <para style="q" vid="JER 31:37">ligíarügübei hamuga náguruni Ísüraeli nuáriua luagu sun lifigoun.</para>
  <para style="q" vid="JER 31:37">Au, le Aburemei ariñagubalin».<verse eid="JER 31:37" /></para>
  <para style="b" />
  <para style="p">
    <verse number="38" style="v" sid="JER 31:38" />Lariñahare Aburemei:</para>
  <para style="p" vid="JER 31:38">—Lachülürüba aban weyu lunya lararamun nuburugute, lúmagiñe luéigiñe luayelesin Ananéli darí lumoun bena le gíribei Lubenari Kaaná. <verse eid="JER 31:38" /><verse number="39" style="v" sid="JER 31:39" />Suruñu luba lébeha lidan laini lúmagiñe ñéingiñe darí luagun luwübüri Garebü, ñéingiñeme aba legeyedun luagun Goá. <verse eid="JER 31:39" /><verse number="40" style="v" sid="JER 31:40" />Sunme wayati le ñein lubéi hábunahoua hilaaña, achagahóua ligía baligi ñeinhin, sun ichari le lóugiñebei liraüraü duna Sedurón darí lumoun larigei Habenari Gabayu luéigiñe oubaü le ñéingiñe lubéi laboucha weyu, anuadirúabei nun, ani magurúnwadigiaalime magünrinchawagun ligíame.<verse eid="JER 31:40" /></para>
  <chapter eid="JER 31" />
  <chapter number="32" style="c" sid="JER 32" />
  <para style="s1">Lagañeihan Heremíasi aban fulasu</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 32:1" />Aba ladimurehan Aburemei lun Heremíasi lidan lidiisin lirumudiri larúeihan Sedekíasi Hudá, le lidisiwídün lirumudiri larúeihan Nabukodonosoru.<verse eid="JER 32:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 32:2" />Lidoun dan ligía, hageindaguña lisudaranigu lurúeite Babilónia luma Herusalén, ani ladaürǘña profeta Heremíasi tibürürünrugu furisun to lúbiñeboun lurúeite Hudá.<verse eid="JER 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 32:3" />Ladaüragüdün Sedekíasi ladüga buga lariñagun Heremíasi, luagu: «Lariñahare Aburemei: “Nábürügüdübei uburugu le labun lubafu lurúeite Babilónia, <verse eid="JER 32:3" /><verse number="4" style="v" sid="JER 32:4" />ani mesefubei urúei Sedekíasi hawéi Kalüdéana, lábürühaba labun lubafu lurúeite Babilónia, ani gasu larufudagun lungua ligibugiñe. <verse eid="JER 32:4" /><verse number="5" style="v" sid="JER 32:5" />Lanügübei Nabukodonosoru Sedekíasi Babilónioun, le ñeinba lubéi leredera darimeya nagúarun luagu. Íbini hageindagun hama Kalüdéana, magañeirúnbadün. Au, le Aburemei ariñagubalin” ».<verse eid="JER 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 32:6" />Aba lariñagun Heremíasi:<verse eid="JER 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 32:7" />—Adimurehati Aburemei nun, lariñaga: “Liábinba biduhe Anaméli, le liráü biyaurite Salumu ariñaga bun lun bagañeihani lufulasun le Anatótubei, ladüga buguya lan yarafaguatimabei biduhegua luma”. <verse eid="JER 32:7" /><verse number="8" style="v" sid="JER 32:8" />Ítara kei lariñaguni Aburemei nun, aba liabin niduhe Anaméli numoun tibürürünrugun furisun, aba lariñagun nun lun nagañeihani lufulasun le Anatótubei, hamúanrugu lani Benhamín türibu, ladüga au lan garichabei lun nerederun lau, luagu liyarafagun waduhegua. Dan nasubudirúnbalin luagu lóunahan lan Aburemei, <verse eid="JER 32:8" /><verse number="9-10" style="v" sid="JER 32:9-10" />aba nagañeihani fulasu ligía lúmagiñe niduhe Anaméli. Aba nederegerun disedü murusun pülata lun, ebegi le uágubei wadüga daradu, aba nadügüni daradu bürüwañu, tánpüwañu lau haseinin ha gefenbaña luagu. <verse eid="JER 32:9-10" /><verse number="11" style="v" sid="JER 32:11" />Ábati nanügünu biángubei kopia lani daradu, aban darugu lau ligaburi daradu lánina agañeihani, to aban madourawaguntu, <verse eid="JER 32:11" /><verse number="12" style="v" sid="JER 32:12" />aba níchugunu lun Baruku, le liráü Neríasi, le libari Maseíasi, ligibugiñe niduhe Anaméli, hama gefentiña ha aseinirubarun dugumedu, hama sun huríu ha ñúnbaña tibürürünrugu furisun. <verse eid="JER 32:12" /><verse number="13-14" style="v" sid="JER 32:13-14" />Aba nariñagun lun Baruku hagibugiñe:</para>
  <para style="p" vid="JER 32:13-14">«Lariñahare Aburemei Suntigabafu le Lubungiute Ísüraeli: Barüboun bián kopia lani daradu to, to daruguboun tuma to daraguboun, ruboun lidoun aban weru lauti múa lun tadurarun saragu dan. <verse eid="JER 32:13-14" /><verse number="15" style="v" sid="JER 32:15" />Ladüga lariñahare Aburemei Suntigabafu, le Lubungiute Ísüraeli: Lidan múa le, tagañeihóuayaba muna, ichari tuma beibei-agei».<verse eid="JER 32:15" /></para>
  <para style="s1">Lafurieidun Heremíasi</para>
  <para style="p">
    <verse number="16" style="v" sid="JER 32:16" />—Lárigiñe níchugunu dugumedu lánina agañeihani tugía lun Baruku, le liráü Neríasi, aba nafurieidún lun Aburemei, nariñaga: <verse eid="JER 32:16" /><verse number="17" style="v" sid="JER 32:17" />“Nabureme, lau óunwenbu bubafu badügei sielu luma ubóu. Úati ni kata siñati bun. <verse eid="JER 32:17" /><verse number="18" style="v" sid="JER 32:18" />Arufuda bumuti bínsiñehabu houn saragu, gama lumoun bei bumutiña giñe gürigia luagu hafigoun hagübürigu. Bungiu wéiriti ani gabafuti, Aburemei Suntigabafu bíribei! <verse eid="JER 32:18" /><verse number="19" style="v" sid="JER 32:19" />Wéirigutibu lidan baransehan luma lidan le badügübei. Ariha bumuti sun le hadügübei gürigia, aba bafayeiruni kada aban según le ladügübei. <verse eid="JER 32:19" /><verse number="20" style="v" sid="JER 32:20" />Adügatibu milaguru luma burí seini Ehiptu, ani dagá lumoun dan le, adügameme bágili dandu hadan lánigu Ísüraeli keisi hadan sun gürigia, aganbahóuatiti luagu biri. <verse eid="JER 32:20" /><verse number="21" style="v" sid="JER 32:21" />Sagá bumutiña bumutuniña ha Ísüraelina Ehiptugiñe lau óunwenbu bubafu, adügeina milaguru luma seini, anufudedaguagüdaña súngubei. <verse eid="JER 32:21" /><verse number="22" style="v" sid="JER 32:22" />Ru bumuti múa le lun Ísüraeli, le rísibei ani buidu ligía lun ábunaguni, kei buga bariñaguni houn hagüchagu. <verse eid="JER 32:22" /><verse number="23" style="v" sid="JER 32:23" />Gama lumoun dan le hebelurunbei fulasurugún aba hárügüdüni, mídintiña lau le bubeibei, mafalarun haméi arufudahani le bíchugubei houn, madügün hagía ni kata lídangiñe le bariñagubei houn. Ligía bóunahanbalin sun wuribani le hawagun.<verse eid="JER 32:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 32:24" />Guentó adügaaña Kalüdéana hebu lun hawariruni baríeiru lun hábürühan luagun uburugu, ani lau wuribu, ilamaü luma sandi lábürügüdübei uburugu háhaburugun áganiñu. Nabureme, ariha baali luagu lagunfuliruña lan le bariñagubei. <verse eid="JER 32:24" /><verse number="25" style="v" sid="JER 32:25" />Ani lau sun lira, Nabureme, ariñagatibu nun lun nagañeihani fulasu ligía hagibugiñe gefentiña, lau sun lábürühaba lan uburugu háhaburugun Kalüdéana».<verse eid="JER 32:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JER 32:26" />Ábati lóunabuni Aburemei Heremíasi, lariñaga lun:<verse eid="JER 32:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 32:27" />—Au Aburemeibei, Habungiute sun gürigia. Úati ni kata násiñarun. <verse eid="JER 32:27" /><verse number="28" style="v" sid="JER 32:28" />Nariñahare lubeiti bun: Nadügüba lun lábürühan uburugu le lúhaburugun Nabukodonosoru le lurúeite Babilónia luma labun habafu Kalüdéana. <verse eid="JER 32:28" /><verse number="29" style="v" sid="JER 32:29" />Kalüdéana ha ageindagubaña luma uburugu, hebeluruba uburugun, ábame hébeduni; hágudubei úara tuma muna burí to meha ñein lubéi hágudaha kupali tábulugu lun Baali, lun hanabagunina, dagagüdawa tuguya diwéin houn búngiugu terencha. <verse eid="JER 32:29" /><verse number="30" style="v" sid="JER 32:30" />Lúmagiñe furumiñeti dan hadügüñein lánigu Ísüraeli hama lánigu Hudá katei le magundantina lau; meredegili hanabagunina Ísüraelina hau búngiugu ha guánarügü hadügübaña. Au, le Aburemei ariñagubalin. <verse eid="JER 32:30" /><verse number="31" style="v" sid="JER 32:31" />Uburugu le, lúmagiñe weyu le lagumeserunbei ábunawagua, madügünti amu katei luéidigia lagañidagüdünina. Ligía nagumuchaguagüdaali lubéi <verse eid="JER 32:31" /><verse number="32" style="v" sid="JER 32:32" />luagu sun le anabagua láadinabei Hudá luma Ísüraeli lau luriban hagaburi, kéigubeirügü harúeitegu, hafadirinigu, hani profetagu hama sun lílana Hudá luma Herusalén. <verse eid="JER 32:32" /><verse number="33" style="v" sid="JER 32:33" />Ru hamaali hanagan nuagun. Lau sun merede lan narufudahan houn, madügüntiña gasu nau, maha hagía heresibiruni narufudahan. <verse eid="JER 32:33" /><verse number="34" style="v" sid="JER 32:34" />Darí lun wíyeda hamaaru lan ténpulu to anuadirúaboun nun aba híchuguniña hagübüri habungiutegu ñein. <verse eid="JER 32:34" /><verse number="35" style="v" sid="JER 32:35" />Adaaguatiña giñe latarü lun Baali luagu fulasu wayati le lani Ben-inomu, lun háguduniña hasaanigu keisi adagaragüdüni lun Moloku, afigougüdei Ísüraeli, lagübüri katei le mariñagun nubéi houn lun hadügüni ligía hadüga, le machülügubeiti lidoun nisaminan.<verse eid="JER 32:35" /></para>
  <para style="s1">Füramasei lubá dan le lunbei liabin</para>
  <para style="p">
    <verse number="36" style="v" sid="JER 32:36" />—Nariñahare au le Aburemei, le Lubungiute Ísüraeli libügürü uburugu le, le uágubei bariñaga luagu lábürühaba lan labun lubafu lurúeite Babilónia, ladüga wuribu, ilamaü luma sandi: <verse eid="JER 32:36" /><verse number="37" style="v" sid="JER 32:37" />Nóundarubaña lílana lídangiñe sun ageiraü le ñeinhin lubéi nachagaraguaña dan le nagañidunbei, ábame nagiribudagüdüniña lidoun fulasu le, lun habagaridun darangilu ya, <verse eid="JER 32:37" /><verse number="38" style="v" sid="JER 32:38" />hagíaba numutuniña, aume Habungiute. <verse eid="JER 32:38" /><verse number="39" style="v" sid="JER 32:39" />Nadügüba lun ninebedun houn lidan sun habagari, buidu láamuga lidin houn luma houn hadügawagun, <verse eid="JER 32:39" /><verse number="40" style="v" sid="JER 32:40" />nadügüba aban daradu le magumuchaditi hama: Meredebei nadügün buiti houn, nabuinchagüdübaña lau ayumahani lun híchugun uéiriguni nun. <verse eid="JER 32:40" /><verse number="41" style="v" sid="JER 32:41" />Nagundaaruba lau nadügün buiti houn, ani nadügüba lun haganóun lidan fulasu le tau sun nanigi luma lau sun ninarün.<verse eid="JER 32:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JER 32:42" />Ábaya lariñagun Aburemei:</para>
  <para style="p" vid="JER 32:42">—Ítara kei nóunahani lanarime wuribani le hawagun gürigia ha, nóunahabei giñe sun buiti le uágubei nariñaga houn. <verse eid="JER 32:42" /><verse number="43" style="v" sid="JER 32:43" />Ani lidan ageiraü le, le uágubei bariñaga luagu lerederuba lan málouga, úouga gürigia ni animaalugu ñein, ani luagu lábürühaba lan labun habafu Kalüdéana, lagañeinhóuayaba fulasu ñein. <verse eid="JER 32:43" /><verse number="44" style="v" sid="JER 32:44" />Lagañeinhóuba, ábame ladügǘn daradu bürüwañu, tánpüwa ani seini hameime gefentiña. Lasusereduba le lumúanrugu Benhamín, geyegua lau Herusalén luma burí luburuguterugu Hudá, dandu lidan fulasu burí le dabíararugubei kei lidan burí aüdü le lídanbei fulasu mawübüriti, luma lidan burí luburugute Négebü, ladüga nadügüba lun lasansiragun habunurun. Au, le Aburemei ariñagubalin.<verse eid="JER 32:44" /></para>
  <chapter eid="JER 32" />
  <chapter number="33" style="c" sid="JER 33" />
  <para style="s1">Füramasei lánina emenigini</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 33:1" />Sun anihagua lan Heremíasi adaürǘwa lidan tibürürün furisun, ábaya ladimurehan Aburemei luma, lariñaga lun:<verse eid="JER 33:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 33:2" />—Nariñahare bun, au, le Aburemei le adügübalin ubóu, aba níchuguni lidan lubara: <verse eid="JER 33:2" /><verse number="3" style="v" sid="JER 33:3" />Waba nuagu, ábame nóunabunibu, ábame narufudun katei wéinamuburiti ani aramudaguati bun, le ibidiñeti bun. <verse eid="JER 33:3" /><verse number="4-5" style="v" sid="JER 33:4-5" />Au, le Aburemei, le Lubungiute Ísüraeli, anihein aban uganu numa tibügürü burí muna to Herusalénboun tuma burí haban urúeigu to lunboun tagurún. Le hadügübei lau háfuridun ageindagua hama Kalüdéana tau eféin, leseriwidarügüba lun labuinchun hageira hau hilaaña. Au, lau lanarime nigañi, nadügüba lun hóunwegun, lugundun gidá naali narihin luéi uburugu le, ladüga saragu wuribani le adüga hamaalibei. <verse eid="JER 33:4-5" /><verse number="6" style="v" sid="JER 33:6" />Gama lumoun nagaranihaba houn, ábame nadügün lun habagaridun lidan darangilaü luma achoururuni. <verse eid="JER 33:6" /><verse number="7" style="v" sid="JER 33:7" />Nasansirubei lubunurun Hudá luma Ísüraeli, ábame nararamagüdüniya lun ítara lan burí kei meha furumiñe. <verse eid="JER 33:7" /><verse number="8" style="v" sid="JER 33:8" />Narumadagüdübaña lídangiñe sun figóu le hadügübei kóntüra au; feruduna sun wuribani le hadügübei, le aubei hiñuragua houngua nuagun. <verse eid="JER 33:8" /><verse number="9" style="v" sid="JER 33:9" />Ábanbei lébuna ugundani Herusalén nun, lébunabei uéiriguni luma inebesei hagibugiñe sun néchanigu ha ubouagubaña. Danme haganbun ladimurehoun luagu sun lubuiduniga luma awanseruni le lunbei nanügüni houn lílana Herusalén, hadadagaruba lau anufudei.<verse eid="JER 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 33:10" />Lariñahare Aburemei:</para>
  <para style="p" vid="JER 33:10">—Huguya, ariñagatün luagu málaali lan fulasu le, luagu úaaña lan gürigia ni animaalugu ñein; luagu málaali lan burí lémeri Herusalén luma burí luburugute Hudá; luagu maganóun hamá ni gürigia, ni animaalugu ñein. Laganbúayaba lubeiti <verse eid="JER 33:10" /><verse number="11" style="v" sid="JER 33:11" />uremu lánina fedu luma ugundani, luma heremuhan adarigu, laganbúba lariñawagún: “Ru humá eteingiruni lun Bungiu Suntigabafu, lugundun buiti Wabureme, lugundun magumuchaditi línsiñehabu”. Ábame hanügün idewesei lánina eteingiruni ténpulurugun. Nasansirubei habunurun lílana ageiraü le, lun ítaraya hamá kei meha furumiñe. Au, le Aburemei ariñagubalin.<verse eid="JER 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 33:12" />Lariñahare Aburemei Suntigabafu:</para>
  <para style="p" vid="JER 33:12">—Lidan ageiraü le, le málabei guentó, le ñein lubéi ua hamá gürigia ni animaalugu lidan sun luburugute, láhüchayaba sagadi lun hanügüniña hóuniri mudún habiñanigu éigagüda ñein. <verse eid="JER 33:12" /><verse number="13" style="v" sid="JER 33:13" />Harihúayaba hóuniri mudún abahüda mudún dandu lidan burí uburugu le lídanbei fulasu le gawübüribei, kei lidan le úaraguabei, luma lidan Négebü luma lidan lumúan Benhamín, luma lidan burí líbiri luburugute Hudá. Au, le Aburemei, ariñagubalin.<verse eid="JER 33:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 33:14" />Lariñahare Wabureme:</para>
  <para style="p" vid="JER 33:14">—Lachülürüba weyu lun nagunfuliruni füramasei le lánina abiniruni le nadügübei houn Ísüraelina hama lánigu Hudá. <verse eid="JER 33:14" /><verse number="15" style="v" sid="JER 33:15" />Danme lachülürün dan ligía luma weyu ligía, nadügüba lun gadügawagun lan Dawidi aban le tímatimaati, le lunbei ladügün irichaü luma úaraguni fulasurugu. <verse eid="JER 33:15" /><verse number="16" style="v" sid="JER 33:16" />Lídanme dan ligía, chóuruñu luba habagaridun Hudaana, hama Herusalénna. Hariñagameti: “Aburemei warichabei”. <verse eid="JER 33:16" /><verse number="17" style="v" sid="JER 33:17" />Au le Aburemei, nariñahare: Súnwandan ñeinbei lan aban ladügawagun Dawidi arúeiha Ísüraeli, <verse eid="JER 33:17" /><verse number="18" style="v" sid="JER 33:18" />súnwandan giñe ñéinbaña lan fádirigu ladügawagun Lewí lun hadagaragüdün nun sagü weyu.<verse eid="JER 33:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 33:19" />Aba ladimurehan Aburemei lun Heremíasi, Lariñaga lun:<verse eid="JER 33:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 33:20" />—Nariñahare, au le Aburemei: Siñati magunfulirun lan daradu le nadügübei luma wéyuagu labu luma áriebu, lun lerederun láfuachun kada aban lidan lidaani. <verse eid="JER 33:20" /><verse number="21" style="v" sid="JER 33:21" />Ítarameme siñá lan magunfulirun lan daradu le buga nadügübei luma Dawidi, ani lun úabei lan aban ladügawagun lun lañuurun luagu lálana larúeihan, o magunfulirun lan nidaradun hama nufadirinigu ha ladügawagun Lewí. <verse eid="JER 33:21" /><verse number="22" style="v" sid="JER 33:22" />Ani nadügüba lun hagibedagun ladügawagun Dawidi hama fádirigu ha ladügawagun Lewí kei waruguma ha siélubaña, luma kei sagoun le lárubei beya le siñabei labahüdǘn.<verse eid="JER 33:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 33:23" />Aba ladimurehan Aburemei lun Heremíasi, lariñaga lun:<verse eid="JER 33:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 33:24" />—Maganbun bágili san le hadimurehabei gürigia, luagu nege fui naaña lan bián iduheñu ha guánarügü nanúadirubaña, Ísüraeli luma Hudá? Ligía lébubei híchugun mebereseni hawagun numutuniña, manügün hamaña keisi néchani.<verse eid="JER 33:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 33:25" />Nariñahare au, le Aburemei: Au le adügaalibei aban daradu luma wéyuagu labu luma áriebu, runei lúrudu le lunbei lagumadihan sielu luma ubouagu, <verse eid="JER 33:25" /><verse number="26" style="v" sid="JER 33:26" />mágurun nubaña ladügawagun Dawidi, mígirunneime níchugun hádanguagiñe ha lúntiña hagumadiruniña ladügawagun Abüraámü, Isaakü luma Hakobu. Lugundun gudemehabubadina houn, ani nasansirubei habunurun.<verse eid="JER 33:26" /></para>
  <chapter eid="JER 33" />
  <chapter number="34" style="c" sid="JER 34" />
  <para style="s1">Ñunsu lun urúei Sedekíasi</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 34:1" />Dan le lageindaguña lubéi Nabukodonosoru le lurúeite Babilónia hau sun lisudaranigu ha lílana sun néchani ubouagu ha lábugiñebaña lubafu, kóntüra Herusalén, luma sun uburugu le yarafabei lun, aba ladimurehan Aburemei lun Heremíasi, lariñaga lun:<verse eid="JER 34:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 34:2" />—Au, le Aburemei, le Lubungiute Ísüraeli, nariñaguña bun lun bidin ariñaga lun Sedekíasi le lurúeite Hudá, luagu nariñahare lan au le Aburemei: “Nadüga lun lárügüdüni lurúeite Babilónia uburugu le, lun láguduni. <verse eid="JER 34:2" /><verse number="3" style="v" sid="JER 34:3" />Mesefubadibu, bábürühaba lúhaburugun; hárügüdübadibu ábame hederegerunibu lun, lárigiñeme barǘ hamaadibu lan ligibugiñóun, ábame banügǘn Babilónioun. <verse eid="JER 34:3" /><verse number="4" style="v" sid="JER 34:4" />Lau sun lira, Sedekíasi le lurúeite Hudá, aganbabéi le lunbei nariñaguni bun: Mámaba tau eféin bafarúa. <verse eid="JER 34:4" /><verse number="5" style="v" sid="JER 34:5" />Bóunweba darangilañu, lágudahouba ibiñein lidan bábunahoun kei lágudahoun lidan hábunahoun bagüchagu ha arúeihabaña bubaragiñe, hayahuba bárigi ariñageina Warúeite! Warúeite! Au le Aburemei ariñagubalin ani runei nererun”.<verse eid="JER 34:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 34:6" />Aban lariñaguni profeta Heremíasi sun le lun urúei Sedekíasi uburugu Herusalén. <verse eid="JER 34:6" /><verse number="7" style="v" sid="JER 34:7" />Sunti dan le, añaha buga lisudaranigu lurúeite Babilónia ageindagua kóntüra Herusalén, Lákisi luma Aseká, uburugu burí baríeiruati ligíarügaali biama uburugu ligía eredera luma Hudá.<verse eid="JER 34:7" /></para>
  <para style="s1">Hesefurúniwa idamunigu</para>
  <para style="p">
    <verse number="8" style="v" sid="JER 34:8" />Aba ladimurehan Aburemei lun Heremíasi, lárigiñe ladügün urúei Sedekíasi aban daradu hama sun lílana Herusalén lun hígiragüdüniña sun idamunigu. <verse eid="JER 34:8" /><verse number="9" style="v" sid="JER 34:9" />Lariñahare lidan daradu ligía lun sun lan ha gadamunbaña Ebüréana, lun lan hígiragüdüniña, lun ua lan ni aban gadamunti huríu líledi. <verse eid="JER 34:9" /><verse number="10" style="v" sid="JER 34:10" />Aba hánharun sun ábutigu hama sun híbiri gürigia lun le lariñagubei daradu ligía, aba hígiragüdüniña hadamun, aba mafosurundigia hamaaña lan lun heseriwidun houn. <verse eid="JER 34:10" /><verse number="11" style="v" sid="JER 34:11" />Lárigiñe, aba hasakürihan luagu hígiragüdüniña, ábaya hafosuruniña lun heseriwidun houn.<verse eid="JER 34:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 34:12" />Ábati ladimurehan Aburemei lun Heremíasi, lariñaga lun:<verse eid="JER 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 34:13" />—Au, le Aburemei le Lubungiute Ísüraeli, adügatina aban daradu hama hagüchagu dan le nasagarunbaliña Ehiptugiñe, le ñein lubéi meha heseriwida keisi idamuni. Aba nariñagun houn: <verse eid="JER 34:13" /><verse number="14" style="v" sid="JER 34:14" />Lun sagü lan sedü irumu lun lan hígiragüdüni furumiñeguarügü ebüréu le alugurúti houn, le seriwihali houn luagu sisi irumu. Gama lumoun madügüntiña hagüchagu gasu nau, madügün haméi le nubeibei houn.<verse eid="JER 34:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 34:15" />—Huguyati sansi humaali yebe higaburi, adüga humaali yebe le aubei nagundaara, lau hígiragüdüniña hupaisanun ha idamuni. Ariñaga huguya luagu hagunfulirubei lan daradu le hadügübei nigibugiñe tidan ténpulu to anuadirúaboun nun.<verse eid="JER 34:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 34:16" />—Gama lumoun lárigiñe, aba lasansiragun haritagun, aba mineben lan niri hun lau hafosuruniña idamuni ha buga ígiragüda humaañabaña lunya heseriwidun hun keisi idamuni.<verse eid="JER 34:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 34:17" />—Nariñahare lubeiti au, le Aburemei: Huguya, madügün humuti le nubeibei, ladüga mígiragüdün humutiña hupaisanun ha idamuni; nígiraali lubeiti wuribu, sandi luma ilamaü, lun ladügün aban katei hau le lunbei lanufudedagüdüniña sun néchanigu. Au, le Aburemei ariñagubalin.<verse eid="JER 34:17" /></para>
  <para style="p">
    <verse number="18-19" style="v" sid="JER 34:18-19" />—Adügatiña lábutigu Hudá luma Herusalén hama sun musu ha palasiurugubaña, fádirigu hama sun híbiri lílana fulasu aban daradu nigibugiñe: Aba habouchagun aban bágasu lidan bián murusun, aba hásügürün labadinaguagiñe biángubei murusun ligía. Gama lumoun lárigiñe aba hadüraaguni daradu, magunfuliruntiña lau hererun.<verse eid="JER 34:18-19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 34:20" />—Nábürügüdübaña lubeiti labun habafu háganiñu lun háfaraguniña, ábame leseriwidún hágubu lun héigini dunuru ha géigaditiña úi, hama animaalugu gáñitiña.<verse eid="JER 34:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 34:21" />—Nábürügüdübei giñe Sedekíasi hau sun ha agumadihabaña luma háhaburugun háganiñu, háhaburugun lisudaranigu lurúeite Babilónia, lau sun láramaguaali lan lageindagun hama guentó.<verse eid="JER 34:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JER 34:22" />—Nariñaguba houn lunya hayabin ageindagua luma uburugu le, lun hárügüdüni lun háguduni. Nadügüba lun lerederun líbiri luburugute Hudá málouga, úouga ni aban aganóuti ñein. Au, le Aburemei ariñagubalin.<verse eid="JER 34:22" /></para>
  <chapter eid="JER 34" />
  <chapter number="35" style="c" sid="JER 35" />
  <para style="s1">Heremíasi hama Rekabüna</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 35:1" />Lidan meha dan le Hoakimü lan le liráü Hosíasi urúeibei Hudá, aba ladimurehan Aburemei numa, lariñaga nun:<verse eid="JER 35:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 35:2" />—Beiba le ñein habéi Rekabüna, ábame badimurehan hama. Lárigiñe ábame banügüniña tidoun aban tídangiñe rumu to ténpuluruguboun ábame bíchugun diwéin houn.<verse eid="JER 35:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 35:3" />Au, Heremíasi, aba nidin áluahei Hasaníasi le liráü ábanya gíriti Heremíasi, libari Hawasiníasi hau líbirigu hama lirahüñü hama sun Rekabüna, <verse eid="JER 35:3" /><verse number="4" style="v" sid="JER 35:4" />Aba nanügüniña ténpulurugun, tidoun harumun lirahüñü Anán le liráü Igüdalíasi, le meha luwügürin Bungiu. Rumu tuguya, tubaduñoun harumun tábutigu ténpulu, tóugiñe lirumun Maseíasi, le liráü Salumu le lúniri ebelaagülei ténpulurugun. <verse eid="JER 35:4" /><verse number="5" style="v" sid="JER 35:5" />Aba neseriwidun diwéin houn Rekabüna, nariñaga houn:</para>
  <para style="p" vid="JER 35:5">—Gurá humá murusun diwéin.<verse eid="JER 35:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 35:6" />Hariñaga nun:</para>
  <para style="p" vid="JER 35:6">—Wagía mátuntiwa diwéin ladüga ariñagati bugaha Honadábü, le liráü Rekabü le wagücha woun lun matun wamá diwéin ni wagía, ni wadügawagun. <verse eid="JER 35:6" /><verse number="7" style="v" sid="JER 35:7" />Ariñagati giñe woun lun mábunagun wamá muna, mábunagun ichari ni beibei-agei. Lariñaga woun lun tidan lan kianpu waganawa sun dan lun wabagaridun saragu ya lidan múa le le ñein wabéi keisi terencha. <verse eid="JER 35:7" /><verse number="8" style="v" sid="JER 35:8" />Adüga wamuti le lubeibei wagücha Honadábü woun, mátuntiwa diwéin, ni wagía, ni wámarigu, ni wasaanigu, <verse eid="JER 35:8" /><verse number="9" style="v" sid="JER 35:9" />mábunagun wagía muna lun waganóun tidan, machari wagía beibei-agei. <verse eid="JER 35:9" /><verse number="10" style="v" sid="JER 35:10" />Tidan kianpu waganawa, gúnfuli wamuti sun le lariñagubei wagücha Honadábü woun. <verse eid="JER 35:10" /><verse number="11" style="v" sid="JER 35:11" />Gama lumoun dan le lebelurunbei Nabukodonosoru le lurúeite Babilónia lidoun fulasu le, aba wayabin Herusaléun anuraheina hawéi súdaragu Kalüdéana hama Síriana; ligía awanha lubéi aganawa Herusalén.<verse eid="JER 35:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 35:12" />Ábati ladimurehan Aburemei lun Heremíasi, lariñaga lun:<verse eid="JER 35:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 35:13" />—Nariñaguña bun, au le Aburemei Suntigabafu le Lubungiute Ísüraeli, lun bidin, bariñagame houn lílana Hudá luma Herusalén lun hafurendeiruni arufudahani, lun hadügüni le nubeibei. Au le Aburemei ariñagubalin. <verse eid="JER 35:13" /><verse number="14" style="v" sid="JER 35:14" />Gúnfulihaña ladügawagun Honadábü, le liráü Rekabü, lau le lariñagubei Honadábü houn lun matun hamá diwéin chülǘ lumoun dan le, ani matun hamutu lugundun gúnfuli hamani lererun hagücha. Rúhadina giñe dimurei hun saragu wéiyaasu ani madügün humuti le nubeibei. <verse eid="JER 35:14" /><verse number="15" style="v" sid="JER 35:15" />Óunaha naaña sun nani profetagu humoun aban lárigi aban lun hariñagun hun: Ígira huméi luriban hóuserun luma luriban higaburi. Midin humá hárigi amu búngiugu, meseriwidun huguyame houn, ítara luba gayara lan hasigirun aganawa lidan fulasu le níchugubei hun luma houn hagüchagu, gama lumoun madügüntün gasu nau. <verse eid="JER 35:15" /><verse number="16" style="v" sid="JER 35:16" />Gúnfuli hamuti ladügawagun Honadábü, le liráü Rekabü, le lariñagubei hagücha houn; ánhañati Ísüraelina, madügün hamuti le nubeibei. <verse eid="JER 35:16" /><verse number="17" style="v" sid="JER 35:17" />Ligía nariñagunbei au, le Aburemei Suntigabafu le Lubungiute Ísüraeli: Nábürügüdübei sun luwuyeri wuribani le uágubei nariñaga luagun Hudá luma hawagun lílana Herusalén. Lugundun adimurehaadina hun, madügüntün gasu nau; agúahaadina hun, móunabun humutina.<verse eid="JER 35:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 35:18" />Ariñagati giñe Heremíasi houn Rekabüna:</para>
  <para style="p" vid="JER 35:18">—Lariñahare Wabureme Suntigabafu, le Lubungiute Ísüraeli: “Kei adüga humaali lubéi le lubeibei hagücha Honadábü, <verse eid="JER 35:18" /><verse number="19" style="v" sid="JER 35:19" />chouru numuti hun, au le Aburemei, le Suntigabafu, le Lubungiute Ísüraeli, luagu súnwandan lan ñeinbei lan aban ladügawagun Honadábü eseriwida nun”.<verse eid="JER 35:19" /></para>
  <chapter eid="JER 35" />
  <chapter number="36" style="c" sid="JER 36" />
  <para style="s1">Laliihanu Baruku hóuburatu ténpulurugu</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 36:1" />Lidan ligadürün lirumudiri lagumadihan Hoakimü le liráü Hosíasi, le lurúeite Hudá, aba ladimurehan Aburemei lun Heremíasi, lariñaga lun:<verse eid="JER 36:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 36:2" />—Barüba aban hóuburatu to abürügülei, babürüheime sun le ariñaga náalibei bun libügürü Ísüraeli, Hudá hama híbiri néchanigu lúmagiñe dan le nagumeserúnbei adimureha bun, lidan lidaani Hosíasi dagá uguñe. <verse eid="JER 36:2" /><verse number="3" style="v" sid="JER 36:3" />Fagua danme haganbuni lílana Hudá luagu sun wuribani le naritagubei nóunahan hawagun, hígirei luriban hóuserun, ábame ferudunanani hariban luma hafigoun.<verse eid="JER 36:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 36:4" />Aba lagúarun Heremíasi lun Baruku le liráü Neríasi, aba lariñaguni sun le lariñagubei Aburemei lun, aba labürühani Baruku tidan aban hóuburatu to abürügülei. <verse eid="JER 36:4" /><verse number="5" style="v" sid="JER 36:5" />Lárigiñe, aba lasubudiragüdün Heremíasi lun Baruku:</para>
  <para style="p" vid="JER 36:5">—Ítara kei le aubei nadariragua nungua siñati nidin litenpulunrugu Wabureme. <verse eid="JER 36:5" /><verse number="6" style="v" sid="JER 36:6" />Bidin lubeimeti luéyuri ayunaruni le lunbei liabin, ábame baliihanu hóuburatu to nabürüdagüdüboun bun, lun haganbuni gürigia hama lílana luburugute burí Hudá ha ñǘbuinbaña ñahoun luganute Aburemei. <verse eid="JER 36:6" /><verse number="7" style="v" sid="JER 36:7" />Fagua hayumuragun lun Aburemei, ígira hameime luriban hóuserun, lugundun hanarimeti igañi le aubei lasiadirei Aburemei wageira.<verse eid="JER 36:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 36:8" />Aba ladügüni Baruku sun le lariñagubei profeta Heremíasi lun: Aba lidin ténpulurugu, aba laliihani luganute Aburemei tídangiñe hóuburatu to buga labürüdüboun.<verse eid="JER 36:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 36:9" />Lidan linefun hati lidan liseingün lirumudiri lagumadihan Hoakimü, le liráü Hosíasi, le lurúeite Hudá, aba lariñawagúniwa lunti lan hayunarun lílana Herusalén ligibugiñe Aburemei kéisirügü ha ñǘbuinbaña lídangiñe amu burí uburugu le lani Hudá. <verse eid="JER 36:9" /><verse number="10" style="v" sid="JER 36:10" />Aba lidin Baruku lidoun tibürürün ténpulu le íñugiñebei luéigiñe ebelaagülei le gíribei Iseri Bena, aba laliihani lererun Heremíasi le bürüwañubei tidan hóuburatu tugía houn sun lílana fulasu, lirumunrugúgiñe Safán le abürühabalin sun le asuseredubei fulasurugu.<verse eid="JER 36:10" /></para>
  <para style="s1">Taliihóun hóuburatu hagibugiñe lúrudugu</para>
  <para style="p">
    <verse number="11" style="v" sid="JER 36:11" />Aganba lumuti Mikaíasi, le liráü Gemaríasi, le libari Safán sun luganute Aburemei le laliihabei Baruku tídangiñe hóuburatu, <verse eid="JER 36:11" /><verse number="12" style="v" sid="JER 36:12" />aba lidin tidoun luban urúei, lirumunrugun le abürühabalin sun le asuseredubei fulasurugu, ñéinñanu sun agumadihatiña ha íñugutimabaña óundaraguañu: Elisamá le abürühabalin sun le asusereduti fulasurugu, Delaíasi le liráü Semaíasi, Elünatán, le liráü Akübóru; Gemaríasi, le liráü Safán; Sedekíasi le liráü Ananíasi, hama burí amu ábutigu. <verse eid="JER 36:12" /><verse number="13" style="v" sid="JER 36:13" />Aba labahüdaguni Mikaíasi sun le laganbubei dan le laliihanbarun Baruku hóuburatu hagibugiñe gürigia. <verse eid="JER 36:13" /><verse number="14" style="v" sid="JER 36:14" />Aba hóunahani ábutigu Heudí, le liráü Netaníasi, libari Selemíasi, lílawa Kusí, ariñaga lun Baruku lun lanügünu hóuburatu to buga laliihaboun hagibugiñe gürigia houn. Ábati lanügünu Baruku hóuburatu, aba lidin tau houn, <verse eid="JER 36:14" /><verse number="15" style="v" sid="JER 36:15" />aba hariñagun lun:</para>
  <para style="p" vid="JER 36:15">—Ñuruba, aliihaboun hóuburatu woun.</para>
  <para style="p" vid="JER 36:15">Aba laliihanu Baruku houn, <verse eid="JER 36:15" /><verse number="16" style="v" sid="JER 36:16" />ítara kei haganbuni, aba haríagun hawouguoun lau anufudei aba hariñagun:</para>
  <para style="p" vid="JER 36:16">—Gasu wasubudiragüdüni sun le lun urúei.<verse eid="JER 36:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 36:17" />Aba hariñagun lun Baruku:</para>
  <para style="p" vid="JER 36:17">—Ida liña san babürühani sun le?<verse eid="JER 36:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 36:18" />Lariñaga Baruku houn:</para>
  <para style="p" vid="JER 36:18">—Heremíasi ariñagubalin sun le nabürühabei tidan hóuburatu to nun.<verse eid="JER 36:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 36:19" />Ábati hariñagun lun:</para>
  <para style="p" vid="JER 36:19">—Buguya luma Heremíasi, heiba aramudagua, masubudiraléi ni aban halíañadün lan.<verse eid="JER 36:19" /></para>
  <para style="s1">Lágudunu urúei Hoakimü hóuburatu</para>
  <para style="p">
    <verse number="20" style="v" sid="JER 36:20" />Aba hígirunu ábutigu hóuburatu tugía lirumunrugu Elisamá le abürühabalin sun asusereduti, aba houdin lúbiñoun urúei asubudiragüdei sun katei lun. <verse eid="JER 36:20" /><verse number="21" style="v" sid="JER 36:21" />Aba lóunahani urúei Heudí anügoun hóuburatu lirumunrugúgiñe Elisamá le abürühati, aba lanügünu Heudí, aba laliihanu ligibugiñe urúei hama sun lánigu ha geyegubaña lau. <verse eid="JER 36:21" /><verse number="22" style="v" sid="JER 36:22" />Kei lidan lubéi linefun hati, tídanñein rumu to lánina lidiliga urúei ligibugiñe régigi lau watu gemeti. <verse eid="JER 36:22" /><verse number="23" style="v" sid="JER 36:23" />Sagü lásurun laliihan Heudí ǘrüwa o gádürü laini, ábaha líbuguni urúei tau aban gusiñu, aba láguruni wáturugun. Ítara liña ladüga darí lágudunu súngubei hóuburatu tuguya. <verse eid="JER 36:23" /><verse number="24" style="v" sid="JER 36:24" />Ni urúei, ni lánigu ha aganbubalin taliihóun hóuburatu, masanditiña anufudei marufudun hagía igarigu. <verse eid="JER 36:24" /><verse number="25" style="v" sid="JER 36:25" />Ayumuraguati yebe Elünatán, Delaíasi luma Gemaríasi lun urúei lun mágudun lanu hóuburatu tugía, gama lumoun madügünti gasu hau, <verse eid="JER 36:25" /><verse number="26" style="v" sid="JER 36:26" />ariñagarügü ligía lun Heraméeli le haduhe urúeigu, lun Seraíasi le liráü Asüriéli luma lun Semaíasi le liráü Abüdéli lun hadaürüni profeta Heremíasi luma Baruku le abürühabei lun. Gama lumoun aba laramuduniña Aburemei luéi.<verse eid="JER 36:26" /></para>
  <para style="s1">Labürüdagüdün Heremíasi ábanya hóuburatu</para>
  <para style="p">
    <verse number="27" style="v" sid="JER 36:27" />Lárigiñe lágudunu urúei hóuburatu to lauboun dimurei burí le labürüdagüdübei Heremíasi lun Baruku, aba ladimurehan Aburemei lun Heremíasi, lariñaga lun:<verse eid="JER 36:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JER 36:28" />—Barüyabá aban hóuburatu, babürühayéime sun le buga bürüwañubei tidan to furumiñetu, to láguduboun Hoakimü le lurúeite Hudá. <verse eid="JER 36:28" /><verse number="29" style="v" sid="JER 36:29" />Bariñagame giñe lun: “Lariñahare Aburemei: Gudá bumutu hóuburatu, dáügüdabei Heremíasi luéigiñe labürüdün tidan luagu liábinba lan lurúeite Babilónia agünrinchaguei ageiraü le, lígirei lanme úouga gürigia ni animaalugu lidan. <verse eid="JER 36:29" /><verse number="30" style="v" sid="JER 36:30" />Nariñahare lubeiti bun, Hoakimü, lurúeite Hudá, luagu madügawagunbadibu lan luagu lálana larúeihan Dawidi. Lerederuba búgubu danme hilaadibu ágawei lárouga le wéyuaguna luma lidiliga le áriebuna, <verse eid="JER 36:30" /><verse number="31" style="v" sid="JER 36:31" />ani buguya hau badügawagun hama bánigu ha arúeihabaña buma, nabeichubadün luagu hifigoun. Nábürügüdübei sun wuribani le uágubei nariñaga huagun, le aubei madügün humá gasu, hawagun lílana Herusalén luma hawagun lílana Hudá”.<verse eid="JER 36:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JER 36:32" />Ábayati lanügün Heremíasi ábanya hóuburatu, aba líchugunu lun Baruku le abürühabei lun, aba labürühani sun le lariñagubei Heremíasi lun, le buga bürüwañubei tidan hóuburatu to láguduboun urúei Hoakimü. Bürügüdati giñe Heremíasi amu burí dimurei lanwoun ítarayuma kei burí le abürüdübei furumiñe.<verse eid="JER 36:32" /></para>
  <chapter eid="JER 36" />
  <chapter number="37" style="c" sid="JER 37" />
  <para style="s1">Lamuriahan Sedekíasi luma Heremíasi</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 37:1" />Aba líchuguni Nabukodonosoru, le lurúeite Babilónia Sedekíasi le liráü Hosíasi lurúeiteme Hudá leweñegua Hekoníasi, le liráü Hoakimü. <verse eid="JER 37:1" /><verse number="2" style="v" sid="JER 37:2" />Gama lumoun ni Sedekíasi, ni ha arúeihabaña luma, ni lílana fulasu, madügüntiña gasu lau uganu le líchugubei Aburemei houn lídangiñe profeta Heremíasi.<verse eid="JER 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 37:3" />Aba lóunahani urúei Sedekíasi Hukali, le liráü Selemíasi, luma fádiri Sofoníasi, le liráü Maseíasi ariñaga lun profeta Heremíasi:</para>
  <para style="p" vid="JER 37:3">—Bafurieida wawagu lun Aburemei le Wabungiute.<verse eid="JER 37:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 37:4" />Madaürǘngili buga Heremíasi, gayaraagili lubeiti léibugun haganagua lílana fulasu. <verse eid="JER 37:4" /><verse number="5" style="v" sid="JER 37:5" />Furihañati buga lisudaranigu urúei Ehiptuna Ehiptugiñe. Dan hasubudirunbalin Kalüdéana ha ageindagubaña luma Herusalén, aba hadisedun ñéingiñe.<verse eid="JER 37:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 37:6" />Ábati ladimurehan Aburemei lun profeta Heremíasi, aba líchugun lúrudu lun lun lariñagun <verse eid="JER 37:6" /><verse number="7" style="v" sid="JER 37:7" />houn óunagüleigu:</para>
  <para style="p" vid="JER 37:7">—Ariñaga humá lun lurúeite Hudá le óunahabalün álügüdaha numa, luagu lisudaranigu lan urúei Ehiptuna ha yebe ñǘbuinbaña lun híderagunün, giribuha lan Ehiptun. <verse eid="JER 37:7" /><verse number="8" style="v" sid="JER 37:8" />Hagiribuduba Kalüdéana lun hageindagun luma Herusalén, hárügüdübei, ábame háguduni. <verse eid="JER 37:8" /><verse number="9" style="v" sid="JER 37:9" />Nariñaguña hun, au, le Aburemei: Maritagua humá luagu hadiseduba lan Kalüdéana, lugundun mama luba. <verse eid="JER 37:9" /><verse number="10" style="v" sid="JER 37:10" />Íbini anhein hagañeira wuribu hama hasudaranigu Kalüdéana ha ageindagubaña huma guentó, herederame fiúrügü wügüriña sándihaña hádangiñe tidan hakianpun, hásaaruba wügüriña hagía, ábame háguduni uburugu.<verse eid="JER 37:10" /></para>
  <para style="s1">Ladaürǘniwa Heremíasi</para>
  <para style="p">
    <verse number="11" style="v" sid="JER 37:11" />Dan le hóudiña lubéi súdaragu Kalüdéana Herusaléngiñe ladüga hasubudiruni luagu añate lan lisudaranigu urúei Ehiptuna, <verse eid="JER 37:11" /><verse number="12" style="v" sid="JER 37:12" />aba láfuridun Heremíasi uburugugiñe lun lidin lumúanrugun Benhamín ariha lun lafanreinhóun aban alagan hadan lílana lageira. <verse eid="JER 37:12" /><verse number="13" style="v" sid="JER 37:13" />Gama lumoun dan lachülürünbei luagu Lubenari Benhamín, aba lararamuni aban wügüri gíriti Iríasi, liráü Selemíasi, libari Ananíasi, hábuti óunigihatiña, lariñaga lun:</para>
  <para style="p" vid="JER 37:13">—Buguya básügüra hamoun Kalüdéana!<verse eid="JER 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 37:14" />Lariñaga Heremíasi lun:</para>
  <para style="p" vid="JER 37:14">—Iyeeni le, másügürünbadina hamoun Kalüdéana!</para>
  <para style="p" vid="JER 37:14">Gama lumoun meberesegúnti Iríasi lau, aba lárügüdüni, aba lanügüni houn ábutigu. <verse eid="JER 37:14" /><verse number="15" style="v" sid="JER 37:15" />Aba hagañidun ábutigu luma Heremíasi, aba habuleseiruni, aba hadaürüni tidan luban Yónatan, le abürühabei, to hadügüboun furisunme. <verse eid="JER 37:15" /><verse number="16" style="v" sid="JER 37:16" />Aba hanügüni Heremíasi tidoun furisun to guribiniboun, ñein hígirei luagu saragu dan.<verse eid="JER 37:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 37:17" />Aba lariñagun urúei Sedekíasi, lun hanügüni Heremíasi lun. Dan ñéinhali ligibugiñe, aba lálügüdüni aramudaguarügü, lariñaga lun:</para>
  <para style="p" vid="JER 37:17">—Anihein san uganu lúmagiñeti Wabureme?</para>
  <para style="p" vid="JER 37:17">Lariñaga Heremíasi lun:</para>
  <para style="p" vid="JER 37:17">—Anha anihein, anihán uganu ligía: Bábürühaba labun lubafu lurúeite Babilónia.<verse eid="JER 37:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 37:18" />Aba giñe lariñagun Heremíasi lun urúei Sedekíasi:</para>
  <para style="p" vid="JER 37:18">—Ka san nidurunbei lun urúei, o houn ha agumadihabaña o houn lílana fulasu, hádarunbalina furisunrugun? <verse eid="JER 37:18" /><verse number="19" style="v" sid="JER 37:19" />Hagañagia profetagu ha buga ariñagubaña luagu mageindagunbei lan lurúeite Babilónia huma, ni hama lílana fulasu le? <verse eid="JER 37:19" /><verse number="20" style="v" sid="JER 37:20" />Aganba humana guentó urúei, ayumuraguatina hun lun mígirun humá lunya nanügǘn tidoun luban Yónatan le abürühabei, luéi nounwen ñein.<verse eid="JER 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 37:21" />Ábati lariñagun urúei Sedekíasi lun lerederun Heremíasi adaürǘwa tidan tibürürün furisun, lun lan giñe sagü lan weyu hanügün aban fein lun. Ítara liña ladügǘn sun dan le anuhein lubéi fein uburugu. Ítara liña lerederun Heremíasi tibürürünrugu furisun.<verse eid="JER 37:21" /></para>
  <chapter eid="JER 37" />
  <chapter number="38" style="c" sid="JER 38" />
  <para style="s1">Hádaruni Heremíasi lidoun aban fusu mábeihali</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 38:1" />Aba laganbuni Sefatíasi le liráü Matán, Gedalíasi le liráü Pasuru, Hukali le liráü Selemíasi, luma Pasuru le liráü Malükíasi lariñagun Heremíasi hagibugiñe lílana fulasu:<verse eid="JER 38:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 38:2" />—Lariñahare Aburemei: “Le erederuti uburugu, lóunweba wuriburugu o lau ilamaü o lau sandi. Ánheinti le áfuriduti lun lederegeragun lungua houn Kalüdéana, lesefurubei libagari”.<verse eid="JER 38:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 38:3" />Lariñahare Aburemei:</para>
  <para style="p" vid="JER 38:3">—Lábürühaba uburugu le labun habafu lisudaranigu lurúeite Babilónia, lárügüdübei ani lásiñarubei ni aban eredera.<verse eid="JER 38:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 38:4" />Ábati hariñagun lánigu urúei lun:</para>
  <para style="p" vid="JER 38:4">—Gasu lafarún wügüri le, lugundun lau lererun áfara lumuti haritagun súdara ha añaheinguabaña uburugu, hama sun híbiri gürigia. Mabusenrunti wügüri le buiti houn lílana fulasu, luéidigia wuribati.<verse eid="JER 38:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 38:5" />Lariñaga urúei Sedekíasi houn:</para>
  <para style="p" vid="JER 38:5">—Buiti, adüga huméi le habusenrun lau: Siñati nadügün ni kata kóntüra huguya.<verse eid="JER 38:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 38:6" />Ábati hárügüdüni Heremíasi, aba hádaruni lidoun lifusun Malükíasi le tibürürünrugubei furisun. Aba hagüraguni lau gúrudu, keiti ua lubéi duna lidan fusu ligía, luéidigia baribarabu, aba labuluchun Heremíasi lidan.<verse eid="JER 38:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 38:7" />Aba laganbun aban Etiopía hádangiñe wügüriña safun ha lúbiñebaña urúei gíriti Éwedi-mélekü luagu da hamá lan Heremíasi fúsurugun. Lidan dan ligía lídanñein aban damuriguaü lidan fulasu le gíribei Lubenari Benhamín urúei. <verse eid="JER 38:7" /><verse number="8" style="v" sid="JER 38:8" />Ábati láfuridun Éwedi-mélekü tídangiñe lani urúei palasiu, aba lidin ariñaga lun urúei:<verse eid="JER 38:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 38:9" />—Uruei, mabuiduntitia le hadügübei wügüriña ha lau Heremíasi. Da hamá lidoun aban fusu, ani lóunweña lilama ñein, lugundun úaaru fein uburugu.<verse eid="JER 38:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 38:10" />Ábati lariñagun urúei lun Éwedi-mélekü lun lanügün darandi wügüriña lúmagua lun hasagaruni Heremíasi fúsurugugiñe lubaragiñe lounwen. <verse eid="JER 38:10" /><verse number="11" style="v" sid="JER 38:11" />Aba lanügüniña Ewedi-mélekü darandi wügüriña hagía, aba lidin tidan tagei daüguaü to palasiuruguboun, aba lasagarun gamisa wéiyaaru ñéingiñe, aba larariragüdünu lun Heremíasi lau gúrudu fúsurugun, <verse eid="JER 38:11" /><verse number="12" style="v" sid="JER 38:12" />lariñaga lun:</para>
  <para style="p" vid="JER 38:12">—Ruboun gamisa burí to lábugiñe barüna luéi lélechunibu gúrudu.</para>
  <para style="p" vid="JER 38:12">Aba ladügüni Heremíasi ítara. <verse eid="JER 38:12" /><verse number="13" style="v" sid="JER 38:13" />Ábati hachawaruni gúrudu, aba hasagaruni Heremíasi lídangiñe fusu. Lárigiñe, aba lerederun Heremíasi tibürürünrugu furisun.<verse eid="JER 38:13" /></para>
  <para style="s1">Lagúaragüdün Sedekíasi luagu Heremíasi</para>
  <para style="p">
    <verse number="14" style="v" sid="JER 38:14" />Aba lóunaagüdün urúei Sedekíasi luagu Heremíasi lun larihini luagu lǘrüwan tebelaagüle ténpulu. Lariñaga urúei lun ñein:</para>
  <para style="p" vid="JER 38:14">—Nálügüdaadibu aban katei, busentina bóunabunina furangu.<verse eid="JER 38:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 38:15" />Lariñaga Heremíasi lun:</para>
  <para style="p" vid="JER 38:15">—Ánhabu nóunaba, báfarubadina hilagubei, ánhana íchiga aban eweridiruni bun, madügünbadibu gasu nau.<verse eid="JER 38:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 38:16" />Gama lumoun aba láfiñurun urúei Sedekíasi aramudaguarügü lun Heremíasi, lariñaga lun:</para>
  <para style="p" vid="JER 38:16">—Fiñutina bun luagu Aburemei le íchugubei ibagari woun, luagu máfarun nubadibu lan, mederegerun nubadibu giñe háhaburugun ha busenbaña háfarunibu.<verse eid="JER 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 38:17" />Ábati lariñagun Heremíasi lun Sedekíasi:</para>
  <para style="p" vid="JER 38:17">—Lariñahare Aburemei Suntigabafu le Lubungiute Ísüraeli: “Ánhabu ederegeragua bungua houn lani lurúeite Babilónia heneraaligu hau sun biduheñu, hesefurubei hibagari, ani magudúnbei uburugu le. <verse eid="JER 38:17" /><verse number="18" style="v" sid="JER 38:18" />Gama lumoun ánhabu mederegeragun bungua houn, hárügüdübei Kalüdéana uburugu le, ábame háguduni, ani mesefubadibu”.<verse eid="JER 38:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 38:19" />Lariñaga Sedekíasi lun:</para>
  <para style="p" vid="JER 38:19">—Hanufudetina hawéi huríu ha ásügürübaña hamoun Kalüdéana; ánhana ábürüha háhaburugun, hasufuriragüdübadina.<verse eid="JER 38:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 38:20" />Lariñaga Heremíasi lun:</para>
  <para style="p" vid="JER 38:20">—Gama lumoun mábürühanbadibu háhaburugun. Adügabéi le lubeibei Aburemei le nariñagubei bun, ábame besefuruni bibagari. <verse eid="JER 38:20" /><verse number="21" style="v" sid="JER 38:21" />Arufuda laali Bungiu nun le lunbei lasuseredun, anhein mahaméme urúei lederegeragun lungua: <verse eid="JER 38:21" /><verse number="22" style="v" sid="JER 38:22" />Sun würiña ha erederutiña tidan luban urúei, le lurúeite Hudá, hasagarúba, ábame hederegerún houn lani lurúeite Babilónia heneraaligu, hariñagame würiña hagía:</para>
  <para style="b" vid="JER 38:22" />
  <para style="q" vid="JER 38:22">«Hátima meni lumadagu urúei</para>
  <para style="q" vid="JER 38:22">yeeda hamá lun hagañeiruni,</para>
  <para style="q" vid="JER 38:22">aba habuluchagüdüni lugudi lidoun baribarabu,</para>
  <para style="q" vid="JER 38:22">ñéingiñe aba híchuguni hanagan luagun».<verse eid="JER 38:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="JER 38:23" />Aba lasigirun Heremíasi ariñaga lun urúei:</para>
  <para style="p" vid="JER 38:23">—Hederegerúaba sun búmarigu hama birahüñü houn Kalüdéana, ani mesefubadibu hawéi, bederegerúaba lun lurúeite Babilónia, ábame háguduni uburugu.<verse eid="JER 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 38:24" />Ábati lariñagun Sedekíasi lun Heremíasi:</para>
  <para style="p" vid="JER 38:24">—Anhein hínsiñe lubéi bibagari bun, mariñagabei katei le ni ka un. <verse eid="JER 38:24" /><verse number="25" style="v" sid="JER 38:25" />Anhein hasubudira ábutigu luagu adimurehaadina lan buma, hayabinba álügüdabu ka lan bariñagubei nun, luma ka lan nariñagubei bun, hariñagame bun luagu hesefurubadibu lan anhein bariñaga houn ka lan nariñagubei bun. <verse eid="JER 38:25" /><verse number="26" style="v" sid="JER 38:26" />Bariñagame lubeiti houn luagu bayumuraguarügüña lan nun lun móunahananibuya tidoun luban Yónatan, luéi bounwen ñein.<verse eid="JER 38:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 38:27" />Aba houdin sun lánigu urúei arihei Heremíasi, aba hálügüdaguni, gama lumoun aba lóunabuniña kei lariñaguni urúei lun. Ábati hígiruni lungua, lugundun úati ni aban asubudiruti le layanuhabei luma urúei. <verse eid="JER 38:27" /><verse number="28" style="v" sid="JER 38:28" />Aba lerederun Heremíasi tibürürünrugu furisun darí weyu le lárügüdünwabei Herusalén.<verse eid="JER 38:28" /></para>
  <chapter eid="JER 38" />
  <chapter number="39" style="c" sid="JER 39" />
  <para style="s1">Lábürühan Herusalén</para>
  <para style="r">(<ref loc="2KI 24:20-25:21">2 Uru 24.20—25.21</ref>; <ref loc="2CH 36:17-21">2 Kro 36.17-21</ref>; <ref loc="JER 52:3-30">Her 52.3-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 39:1" />Lidan lidiisin hati lidan linefun lirumudiri larúeihan urúei Sedekíasi Hudá, aba lidin urúei Nabukodonosoru hau sun lisudaranigu ageindagua luma Herusalén, aba legeyedaguni. <verse eid="JER 39:1" /><verse number="2" style="v" sid="JER 39:2" />Weyu nefu lidan ligadürün hati lidan liunsun lirumudiri lagumadihan Sedekíasi, ligía hebelurun súdaragu ha áganiñu uburugun, <verse eid="JER 39:2" /><verse number="3" style="v" sid="JER 39:3" />aba hebelurun sun lisudaranigu lurúeite Babilónia ha íñugutimabaña aba herederun luéigiñe bena le lamidanguabei uburugu. Nerügáli-sareserü, Samügárü-nebu Sarüsekímü, lánigu urúei ha íñugutiña luma ábaya Nerügáli-sareserü, aba giñe hádangiñe lánigu urúei le íñuguti.<verse eid="JER 39:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 39:4" />Dan larihinbalin urúei Sedekíasi hama lisudaranigu le suserebei, aba hanurahan uburugugiñe. Aba háfuridun áriebu luéigiñe lémeri tufulurin-agei palasiu, lídangiñe bena le labadinaguabei bián baríeiru, aba hárügüdüni lémeri fulasu le mawübüriti le lani Hordán. <verse eid="JER 39:4" /><verse number="5-6" style="v" sid="JER 39:5-6" />Gama lumoun aba héibaahaniña súdaragu Kalüdéana aba hárügüdüni Sedekíasi lidan fulasu mawübüriti le lani Herikó. Aba hanügüni ligibugiñoun urúei Nabukodonosoru uburugun Ribülá lumúanrugu Amatü. Aba lasiadiruni Nabukodonosoru ñein. Aba ladürühagüdüni hachügü lirahüñü Sedekíasi liñúarü háguchi luma giñe hachügü sun lúrudugu Hudá. <verse eid="JER 39:5-6" /><verse number="7" style="v" sid="JER 39:7" />Aba lasagaragüdüni lagu Sedekíasi, aba hagüraguni lau güringüri, aba hanügüni Babilónioun.<verse eid="JER 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 39:8" />Aba hágudunu Kalüdéana lani urúei palasiu, tuma burí muna to uburuguboun, aba háguruni lubarieirun Herusalén. <verse eid="JER 39:8" /><verse number="9" style="v" sid="JER 39:9" />Lárigiñe, aba lanügüniña Nebusaradán, le gumadan tani tufurisuna luban urúei, dandu lílana uburugu ha erederubaña, kei ha ásügürübaña hamoun Kalüdéana Babilónioun, sun lílana fulasu. <verse eid="JER 39:9" /><verse number="10" style="v" sid="JER 39:10" />Fiúrügüñanu hádangiñe ha gudemetimabaña lígira lumúanrugu Hudá, ha úabei ni kata hama, weyu ligía, aba líchugun beibei-agei luma ichari houn lun hábunaguni.<verse eid="JER 39:10" /></para>
  <para style="s1">Lígiragüdüniwa Heremíasi</para>
  <para style="p">
    <verse number="11" style="v" sid="JER 39:11" />Aba lariñagun Nabukodonosoru le lurúeite Babilónia lun Nebusaradán, le gumadan tani furisun libügürü Heremíasi:<verse eid="JER 39:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 39:12" />—Góunigibei, móuserabei wuriba, rúrügübei sun le lamuriahan buma lun.<verse eid="JER 39:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 39:13" />Ábati lóunahan Nebusaradán, úara luma Nebusasübán luma Nerügáli-sareserü bián lani urúei úfisigu íñugutiña hama sun lani lurúeite Babilónia úfisigu <verse eid="JER 39:13" /><verse number="14" style="v" sid="JER 39:14" />asagarei Heremíasi tibürürünrugúgiñe furisun, aba híchuguni lábugiñe lóunigihan Gedalíasi, le liráü Aikamü, libari Safán, lun lanügüni lúbiñoun. Aba lubeiti lerederun Heremíasi aganawa hadan lílana fulasu.<verse eid="JER 39:14" /></para>
  <para style="s1">Füramasei lun Ewedi-mélekü</para>
  <para style="p">
    <verse number="15" style="v" sid="JER 39:15" />Dan buga anihagua lan Heremíasi, adaürǘwa tibürürünrugu furisun, aba ladimurehan Aburemei luma, lariñaga lun:<verse eid="JER 39:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 39:16" />—Beiba, bariñagame lun Ewedi-mélekü, le Etiopíana: “Lariñahare Aburemei Suntigabafu, le Lubungiute Ísüraeli: Nagunfulirubei le nariñagubei libügürü uburugu le, lun liabin wuribani houn, mama lun liabin buidu, ñéinbadibu danme lasuseredun katei le. <verse eid="JER 39:16" /><verse number="17" style="v" sid="JER 39:17" />Gama lumoun nesefurubadibu lun mábürühan ban háhaburugun gürigia ha, ha uéibaña banufudeda. <verse eid="JER 39:17" /><verse number="18" style="v" sid="JER 39:18" />Nesefurubadibu luéi háfarunibu hilagubei. Besefuruba lau ibagari, ladüga hemenigitibu nuagu. Au, le Aburemei ariñagubalin”.<verse eid="JER 39:18" /></para>
  <chapter eid="JER 39" />
  <chapter number="40" style="c" sid="JER 40" />
  <para style="s1">Lerederun Heremíasi luma Gedalíasi</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 40:1" />Aba ladimurehan Aburemei lun Heremíasi, lárigiñe lesefuruni Nebusaradán, le gumadan tani furisun uburugu Ramá. Ladaürǘña meha dan le ladarirunbálin Nebusaradán, güragu lau güringüri hadan gürigia ha lílana Herusalén luma Hudá ha anügǘbaña Babilónioun.<verse eid="JER 40:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 40:2" />Aba ladireiruni gumadan tani furisun Heremíasi lidoun fulasu daüti, aba lariñagun lun:</para>
  <para style="p" vid="JER 40:2">—Siadi lumuti Aburemei le Bubungiute fulasu le, lun lóunahani lamiselu le luagun, <verse eid="JER 40:2" /><verse number="3" style="v" sid="JER 40:3" />guentoti gúnfulila lasiadiruni. Lasuseredunbei le hun, ladüga hafigouhan kóntüra Aburemei, madügün humuti le lubeibei. <verse eid="JER 40:3" /><verse number="4" style="v" sid="JER 40:4" />Nagidaraali güringüri le aubei bagürawagua buéi guentó. Ánhabu busén bidin numa Babilónioun, keimoun; nóunigirubadibu. Gama lumoun anhein mabusenrun bubéi bidin, rédeiba. Anihán ageiraü bigibugiñe, gayaraati bidin le ñein lumuti babusenra. <verse eid="JER 40:4" /><verse number="5" style="v" sid="JER 40:5" />Anhein himei bubalin bagiribudun, giribubá lumoun Gedalíasi, le liráü Aikamü, le libari Safán, le líchugubei urúei keisi gumadimati lidan burí luburugute Hudá, ábame baganóun luma, luma hama bumutuniña. Beiba le ñeinhin lumuti babusenra.</para>
  <para style="p" vid="JER 40:5">Lárigiñe aba líchugun gumadan idewesei luma éigini lun Heremíasi, aba lóunahani. <verse eid="JER 40:5" /><verse number="6" style="v" sid="JER 40:6" />Aba lidin Heremíasi lumoun Gedalíasi uburugun Misüpá, aba lerederun aganawa luma, hama híbiri gürigia ha erederubaña fulasurugu.<verse eid="JER 40:6" /></para>
  <para style="s1">Eledeguni lubá Gedalíasi</para>
  <para style="p">
    <verse number="7" style="v" sid="JER 40:7" />Dan le hasubudirunbalin gumadangu hama súdaragu huríu ha erederubaña áraabu luagu rula lan lurúeite Babilónia Gedalíasi le liráü Aikamü keisi gumadimati fulasurugu, ani rula lan wügüriña, würiña hama irahüñü, gürigia ha gudemetimabaña ha manügǘnbaña Babilónioun labun lererehan.<verse eid="JER 40:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 40:8" />Aba houdin Misüpá hau hamutuniña arihei Gedalíasi. Ñeinñein Ísümaeli le liráü Netaníasi hadan: Hoanán luma Yónatan ha lirahüñü Karéa; Seraíasi le liráü Tanhumeti; hama lirahüñü Efái le Netofána lumoun Hesaníasi, liráü aban wügüri Maakatüna, hama luwügüriñanigu. <verse eid="JER 40:8" /><verse number="9" style="v" sid="JER 40:9" />Aba láfiñurun Gedalíasi houn:</para>
  <para style="p" vid="JER 40:9">—Manufudeda humá lun hederegeragun hungua houn Kalüdéana. Redei humá aganawa fulasurugu, deregegua humá hungua lun lurúeite Babilónia, ábame buidu lan lidin hun. <verse eid="JER 40:9" /><verse number="10" style="v" sid="JER 40:10" />Au, neredera Misüpá lun nadimurehan huagu houn Kalüdéana danme hayabin ya. Huguya rugua humá hungua areidaha diwéin, furuda luma garaba, ítara luba gayara lan herederun lidan burí uburugu le hárügüdübei.<verse eid="JER 40:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 40:11" />Aganba hamuti giñe huríu ha Moábübaña, ha Amonbaña hama ha Edomubaña hama ha lídanbaña amu burí ageiraü luagu ígira laaña lan lurúeite Babilónia fiu huríu lun herederun hamúanrugu, luagu giñe ru laali lan Gedalíasi keisi gumadimati houn. <verse eid="JER 40:11" /><verse number="12" style="v" sid="JER 40:12" />Ábati hagiribudun lun Hudáun lídangiñe sun fulasu le buga ñeinhin lubéi hachagarawagua, aba hayabin lumoun Gedalíasi Misüpá. Aba giñe hareidahan diwéin, tuma saragu furuda.<verse eid="JER 40:12" /></para>
  <para style="s1">Leledegun Ísümaeli lubá Gedalíasi</para>
  <para style="p">
    <verse number="13" style="v" sid="JER 40:13" />Aba lidin Hoanán le liráü Karéa hama híbiri hábutigu súdaragu ha erederubaña áraabu, aba houdin Misüpá arihei Gedalíasi, <verse eid="JER 40:13" /><verse number="14" style="v" sid="JER 40:14" />aba hariñagun lun:</para>
  <para style="p" vid="JER 40:14">—Ibidiñeti san bun luagu óunahala lan urúei Baalisi le Amonna Ísümaeli le liráü Netaníasi lun láfarunibu hilagubei?</para>
  <para style="p" vid="JER 40:14">Gama lumoun mafiñerunti Gedalíasi houn. <verse eid="JER 40:14" /><verse number="15" style="v" sid="JER 40:15" />Ábati lariñagun Hoanán lun Gedalíasi aramudaguarügü:</para>
  <para style="p" vid="JER 40:15">—Ígiraba lun nidin áfarei Ísümaeli hilagubei. Kábagia uagu wígira lun láfarunibu? Lachagaraguágüdübaña lira sun huríu ha óundaraguaañabaña geyegua bau, ani ligíaba giñe lagünrinchaguagüle murusun le erederubei lídangiñe Hudá.<verse eid="JER 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 40:16" />Lariñaga Gedalíasi lun:</para>
  <para style="p" vid="JER 40:16">—Madügabéi! Iyeeni le bariñagubei luagu Ísümaeli.<verse eid="JER 40:16" /></para>
  <chapter eid="JER 40" />
  <chapter number="41" style="c" sid="JER 41" />
  <para style="s1">Háfaruni Gedalíasi hilagubei</para>
  <para style="r">(<ref loc="2KI 25:25-26">2 Uru 25.25-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 41:1" />Lidan lisedün hati, aba lidin Ísümaeli le liráü Netaníasi uburugu Misüpá libari Elisamá, hádangiñeti iduheñu ha lánina arúeihani arihei Gedalíasi. Ñǘdüntiña diisi wügüriña luma. Ñein Misüpá, dan le añaha lubéi eiga lidan aban, <verse eid="JER 41:1" /><verse number="2" style="v" sid="JER 41:2" />aba lásaarun Ísümaeli hama diisi wügüriña ha lúmabaña sódini, aba háfaruni Gedalíasi tau eféin, Gedalíasi le buga líchugubei lurúeite Babilónia keisi gumadimati Hudá. <verse eid="JER 41:2" /><verse number="3" style="v" sid="JER 41:3" />Áfaragua lumutiña giñe Ísümaeli sun huríu hama súdaragu Kalüdéana ha lúmabaña Gedalíasi uburugu Misüpá.<verse eid="JER 41:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 41:4" />Larugan lárigiñe lafarún Gedalíasi, dan le úagiña aganbutiña luagu éibaaguti, <verse eid="JER 41:4" /><verse number="5" style="v" sid="JER 41:5" />aba hachülürün gádürü-wein wügüriña Sikemügiñe, Silogiñe luma Samariagiñe sáwaguañu hádiuma, hucheche hadaüragun luma burí biti hawougua le hadüga houngua. Barüina haña giñe idewesei fulúaruauti luma kupali lun hadagaragüdün lun Aburemei ténpulurugu. <verse eid="JER 41:5" /><verse number="6" style="v" sid="JER 41:6" />Ábati liabin Ísümaeli habaroun Misüpágiñe, ayahuaheina luagu üma. Kei le aubei ladunragua hama, aba lariñagun houn:</para>
  <para style="p" vid="JER 41:6">—Higougu harihei Gedalíasi le liráü Aikamü.<verse eid="JER 41:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 41:7" />Gama lumoun kei hachülürün lamidangua uburugu, aba láfaraguniña Ísümaeli hama luwügüriñanigu, aba háguruniña lidoun aban fusu huliliti. <verse eid="JER 41:7" /><verse number="8" style="v" sid="JER 41:8" />Gama lumoun ñéinñanu diisi hádangiñe wügüriña hagía ariñagutiña lun Ísümaeli:</para>
  <para style="p" vid="JER 41:8">—Máfarabawa, anihein türigu, sewada, garaba luma sírudu aramudañu wama áraabu.</para>
  <para style="p" vid="JER 41:8">Ábati máfaragun lániña Ísümaeli kei ladüga houn hapanaagu. <verse eid="JER 41:8" /><verse number="9" style="v" sid="JER 41:9" />Fusu le ñeinhin lubéi líchigaña Ísümaeli wügüriña ha láfaragubaña, ligía lememe meha ladügagüdübei urúei Asá lun laramudagun luéi Baasá le lurúeite Ísüraeli. Wéiriti fusu ligía, gama lumoun buinti hau gürigia ha láfaragubaña Ísümaeli. <verse eid="JER 41:9" /><verse number="10" style="v" sid="JER 41:10" />Aba giñe ladaüraguniña Ísümaeli lirahüñü urúei ha würiña hau sun gürigia ha erederubaña Misüpá, ha buga lígirubaña Nebusaradán lábugiñe laríaahan Gedalíasi. Aba ladaüraguniña Ísümaeli, aba lidin lau laritagun lun lásügürün lumúanrugun Amón.<verse eid="JER 41:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 41:11" />Dan le laganbunbei Hoanán, le liráü Karéa hama hábutigu milidaru ha lúmabaña luagu áfarahani le ladügübei Ísümaeli, <verse eid="JER 41:11" /><verse number="12" style="v" sid="JER 41:12" />aba hóundaruniña sun hamutuniña, aba houdin ageindagua luma. Aba hadariruni lurugabu lareidaha duna wéiriti le Gabaónbei. <verse eid="JER 41:12" /><verse number="13" style="v" sid="JER 41:13" />Dan harihinbalin ha lanügübaña Ísümaeli adaürǘwa Hoanán hama sun hábutigu milidaru ha úarabaña luma, aba hagundaaragun, <verse eid="JER 41:13" /><verse number="14" style="v" sid="JER 41:14" />aba houdin lumoun Hoanán. <verse eid="JER 41:14" /><verse number="15" style="v" sid="JER 41:15" />Gama lumoun aba léibaagun Ísümaeli hama widü wügüriña hádangiñe luwügüriñanigu luéi Hoanán, aba houdin lageiroun Amón.<verse eid="JER 41:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 41:16" />Aba larihin Hoanán hama hábutigu milidaru ha úarabaña luma hau súdaragu, würiña hama irahüñü hama ha buga íñugubaña lidan gumadi ha lanügübaña Ísümaeli dáüwañu Misüpágiñe lárigiñe láfaruni Gedalíasi, ha lagiribudagüdübaña Hoanán Gabaóngiñe. <verse eid="JER 41:16" /><verse number="17" style="v" sid="JER 41:17" />Aba héibugun darí hachülürün Gerutu-Kimamü lurugabu Belén, le ñein lubéi hararamagua. Haritagunti buga lun hasigirun darí hachülürün Ehiptu, <verse eid="JER 41:17" /><verse number="18" style="v" sid="JER 41:18" />lun hesefurun hawéi Kalüdéana, lugundun hanufudetiña hawéi, ladüga láfaruni Ísümaeli Gedalíasi, le yebe líchugubei lurúeite Babilónia gumadimatime fulasurugu.<verse eid="JER 41:18" /></para>
  <chapter eid="JER 41" />
  <chapter number="42" style="c" sid="JER 42" />
  <para style="s1">Lamuriahan ubóu luma Heremíasi lun lafurieidun hawagu</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 42:1" />Aba hayabin sun hábutigu milidaru lau sun Hoanán le liráü Karéa, Asaríasi le liráü Osaíasi, hama sun gürigia, ñǘbürigiña hama wéinamuhaña, aba hayabin <verse eid="JER 42:1" /><verse number="2" style="v" sid="JER 42:2" />lumoun profeta Heremíasi, aba hariñagun lun:</para>
  <para style="p" vid="JER 42:2">—Wamuriaha aban katei buma, mamaharabátia badügüni woun: Bayumuragua lun Aburemei le Bubungiute wawagu, wagía fiu ha erederubaña. Gíbetiwa meha, gama lumoun guentó, fiúrügaadiwa kei barihiniwa. <verse eid="JER 42:2" /><verse number="3" style="v" sid="JER 42:3" />Bayumuragua lun Aburemei le Bubungiute lun larufuduni üma le lunbei wafalaruni woun luma katei le lunbei wadügüni.<verse eid="JER 42:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 42:4" />Lariñaga Heremíasi houn:</para>
  <para style="p" vid="JER 42:4">—Buiti, nayumuraguba lun Aburemei le Hubungiute huagu, kei hamuriahani numa, ábame nasubudiragüdüni sun le lóunabagüle nun hun, maramudunga ni kata huéi.<verse eid="JER 42:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 42:5" />Ábati hariñagun lun Heremíasi:</para>
  <para style="p" vid="JER 42:5">—Aburemei le Bubungiute, ligíaba gefenti úaraguati kóntüra wagía anhein madügün wamá le lariñagun bun lun bariñaguni woun lun wadügüni. <verse eid="JER 42:5" /><verse number="6" style="v" sid="JER 42:6" />Gunda wagía yebe magundan lau lóunabagüle, wadügübei le lubeibei Aburemei le Wabungiute, le úmounbei wóunahabu álügüdaha, lun buídubei lan lidin woun.<verse eid="JER 42:6" /></para>
  <para style="s1">Lóunabuni Wabureme lafurieidun Heremíasi</para>
  <para style="p">
    <verse number="7" style="v" sid="JER 42:7" />Diisi weyu lárigiñe, aba ladimurehan Aburemei lun Heremíasi, <verse eid="JER 42:7" /><verse number="8" style="v" sid="JER 42:8" />aba lagúarun Heremíasi lun Hoanán, le liráü Karéa, luma houn hábutigu milidaru ha úarabaña luma, houn sun gürigia, lúmagiñe le ñǘraütimagilibei dagá lumoun le wéiyaalibei, <verse eid="JER 42:8" /><verse number="9" style="v" sid="JER 42:9" />lariñaga houn:</para>
  <para style="p" vid="JER 42:9">—Lariñahare Aburemei le Lubungiute Ísüraeli, le úmounbei hóunahana lun nayumuragun huagu: <verse eid="JER 42:9" /><verse number="10" style="v" sid="JER 42:10" />“Anhein busén hubéi lun herederun lidan fulasu le, nawanseragüdübadün, magünrinchagun nubadün, bunaguarügü nubadün máhulaagun nubadün, ladüga hǘrühali nun nóunahani wuribani le huagun. <verse eid="JER 42:10" /><verse number="11" style="v" sid="JER 42:11" />Manufudeda humá luéi lurúeite Babilónia, le ueibei weiri lan hanufude. Manufudeda humá luéi, ladüga anahein huma lun nasalbarunün luma lun nesefurunün luéi lubafu. Au, le Aburemei ariñagubalin. <verse eid="JER 42:11" /><verse number="12" style="v" sid="JER 42:12" />Gudemehabubadina hun, ani nadügüba lun giñe gudemehabu lan hun lun lígirun lun hagiribudun hageiroun”.<verse eid="JER 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 42:13" />—Gama lumoun anhein mabusenrun hubéi herederun lidan ageiraü le ani aba maganbadi humá lun Hubungiute lun <verse eid="JER 42:13" /><verse number="14" style="v" sid="JER 42:14" />hariñagunya: “Himei wamuti woudin aganawa Ehiptu le ñeinba lubéi marihin wamá wuribu, maganbun wameime tumalali fidu, móunwegun wagíame walama”, <verse eid="JER 42:14" /><verse number="15" style="v" sid="JER 42:15" />aganba huméi lubeiti le lariñagubei Aburemei Suntigabafu, huguya le erederubei hádangiñe lánigu Hudá: “Anhaün ítarameme abusenra hidin aganawa Ehiptu, <verse eid="JER 42:15" /><verse number="16" style="v" sid="JER 42:16" />lárügüdübadün wuribu luma ilamaü le ueibei hanufudeda ñein, ábame hóunwegun ñein. <verse eid="JER 42:16" /><verse number="17" style="v" sid="JER 42:17" />Sun ha lúnbaña houdin aganawa Ehiptu, hóunweguba ñein ladüga wuribu, ilamaü o sandi úabei ni aban erederuti wínwanñu, mesefubei ni aban luéi lamiselu le lunbei nóunahani”.<verse eid="JER 42:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 42:18" />—Lariñahare Aburemei Suntigabafu, le Lubungiute Ísüraeli: “Ítara kei nagañidun hama lílana Herusalén, ítara luba giñe nagañidun huma, anhaün ñüdün Ehiptun. Ábanbadün hénpulu lánina íñarawaguni, aban katei le hanufunati, marihindigia humaalime fulasu le”. <verse eid="JER 42:18" /><verse number="19" style="v" sid="JER 42:19" />Huguya le erederubei hádangiñe lánigu Hudá, lariñaguña Aburemei hun, lun midin humá Ehiptu. Subudi humeitia, neweridiruñadün guentó. <verse eid="JER 42:19" /><verse number="20" style="v" sid="JER 42:20" />Adügatün aban bulíeiguaü wéiriti, ladüga huguya guánarügü ariñagubei nun lun nayumuragun lun Aburemei le Hubungiute huagu, lun nasubudiragüdüni lóunabagüle hun, lun hadügüni le lubeibei. <verse eid="JER 42:20" /><verse number="21" style="v" sid="JER 42:21" />Subudigüda naali le lariñagubei Aburemei le Hubungiute hun uguñe, gama lumoun máhatün hadügüni le lubeibei. <verse eid="JER 42:21" /><verse number="22" style="v" sid="JER 42:22" />Subudi huméi lubeiti buidu luagu hóunweguba lan lidan ageiraü le ñeinhin lubéi habusenra hidin ladüga wuribu, ilamaü luma sandi.<verse eid="JER 42:22" /></para>
  <chapter eid="JER 42" />
  <chapter number="43" style="c" sid="JER 43" />
  <para style="s1">Lanügǘn Heremíasi lun Ehiptun</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 43:1" />Dan lásurunbei lasubudiragüdüni Heremíasi le lariñagubei Aburemei le Lubungiute lun lun lariñaguni houn lílana fulasu, <verse eid="JER 43:1" /><verse number="2" style="v" sid="JER 43:2" />aba lariñagun Asaríasi le liráü Osiasi, Hoanán le liráü Karéa hama amu burí wügüriña ha barüguatiña houngua lun Heremíasi:</para>
  <para style="p" vid="JER 43:2">—Biyeeni le bariñagubei! Mariñagunti Aburemei le Wabungiute bun lun bariñagun woun lun midin wamá aganawa Ehiptu. <verse eid="JER 43:2" /><verse number="3" style="v" sid="JER 43:3" />Baruku le liráü Neríasi ádahabalibu kóntüra wagía lun wábürühan labun habafu Kalüdéana, lun háfaraguniwa o lun lan hanügüniwa Babilónioun.<verse eid="JER 43:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 43:4" />Ni lubeiti Hoanán, ni hábutigu milidaru ni lílana fulasu meredetiña lumúanrugu Hudá, madügün hamuti le lubeibei Aburemei. <verse eid="JER 43:4" /><verse number="5" style="v" sid="JER 43:5" />Ábarüga lóundaraguniña Hoanán hama hábutigu milidaru fiu gürigia ha erederubaña hádangiñe lánigu Hudá, ha agiribudubaña Hudáun lárigi herederun anuraha lidan ámuñegueinarügü ageiraü: <verse eid="JER 43:5" /><verse number="6" style="v" sid="JER 43:6" />Wügüriña, würiña, irahüñü hama lirahüñü urúei würiña hama sun gürigia ha buga lígirubaña Nebusaradán lábugiñe laríaahan Gedalíasi, lau sun Heremíasi luma Baruku. <verse eid="JER 43:6" /><verse number="7" style="v" sid="JER 43:7" />Madügünga gasu lau le lubeibei Aburemei, aba houdin sun hagía Ehiptun, aba hachülürün uburugun Táfünesi.<verse eid="JER 43:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 43:8" />Aba ladimurehan Aburemei lun Heremíasi uburugu Táfünesi, lariñaga lun:<verse eid="JER 43:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 43:9" />—Barüba fiu dübü wéinamuti, ábame baramuduni labadinagua ladiríyu le aubei lafulouhoua tebelaagüle luban urúei Ehiptuna, hagibugiñe sun lílana Hudá. <verse eid="JER 43:9" /><verse number="10" style="v" sid="JER 43:10" />Bariñagame houn: “Lariñahare Aburemei Suntigabafu le Lubungiute Ísüraeli: Nadügüba lun liabin nubúein Nabukodonosoru le lurúeite Babilónia, ábame níchuguni lálana larúeihan tuma likianpun ligibuagu dübü le nábunubei ya. <verse eid="JER 43:10" /><verse number="11" style="v" sid="JER 43:11" />Liábinba, ábame lagünrinchaguni Ehiptu. Ha lúnbaña hóunwegun, hóunweguba, ha lúnbaña hanügǘniwa bóugudin luéi hageira hanügǘba, ha lúnbaña hóunwegun wuriburugu, hóunweguba wuriburugu. <verse eid="JER 43:11" /><verse number="12" style="v" sid="JER 43:12" />Láguduboun burí hatenpulun lubungiutegu Ehiptu, gudá láñame búngiugu o lanügüniña lan keisi adaürǘtiña. Larumadagüdübei Ehiptu kei lagidahan hóuniri mudún hayaba tuéigiñe ladaüragun, lárigiñeme ábame lidin úouga erederuti. <verse eid="JER 43:12" /><verse number="13" style="v" sid="JER 43:13" />Lagünrinchagubei liyawa burí Eliopolisi le Ehiptubei, ábame lágudunu hatenpulun lubungiutegu Ehiptu”.<verse eid="JER 43:13" /></para>
  <chapter eid="JER 43" />
  <chapter number="44" style="c" sid="JER 44" />
  <para style="s1">Ñunsu houn huríu ha ñǘdünbaña Ehiptun</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 44:1" />Uganu le leresibirubei Heremíasi houn sun huríu ha meha aganóubaña Ehiptu, uburugu burí Migüdólu, Táfünesi Ménfisi luma lóubawagu Suru.<verse eid="JER 44:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 44:2" />—Lariñahare Aburemei Suntigabafu le Lubungiute Ísüraeli: Ariha humaali burí lamiselu le nábürügüdübei luagun Herusalén luma luagun burí líbiri luburugute Hudá. Gádeihali burí guentó, úatiña aganóutiña ñein, <verse eid="JER 44:2" /><verse number="3" style="v" sid="JER 44:3" />luma wuribani le burí hadügübei, ladüga anabagua hamutina lau háhuduragun houn amu búngiugu, águdaha hagía kupali houn; búngiugu ha úmabei mani hamá ni kata, ni hagía, ni huguya, ni hagüchagu. <verse eid="JER 44:3" /><verse number="4" style="v" sid="JER 44:4" />Óunaha numutiña nani profetagu saragu wéiyaasu ariñaga hun, lun madügün humani burí lagübüri katei le aubei magundan nan. <verse eid="JER 44:4" /><verse number="5" style="v" sid="JER 44:5" />Gama lumoun madügüntün gasu nau. Lubaragiñe hamuga hígiruni huriban ábarüga hasigirun águdaha kupali houn amu búngiugu. <verse eid="JER 44:5" /><verse number="6" style="v" sid="JER 44:6" />Ábati liñuragun nigañi, aba lásüdün kei watu gemeti luburuguterugu burí Hudá luma burí lémerirugu Herusalén. Aba lerederun málouga chülǘ lumoun dan le.<verse eid="JER 44:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 44:7" />—Nariñahare lubeiti au, le Aburemei Suntigabafu le Lubungiute Ísüraeli: Ka uagu hanügei óunwenbu wuribani le huouguoun? Ka uagu hadüga lun hóunwegun sun lílana Hudá, wügüriña, würiña, irahüñü, íbini figigiña darí lun merede lan ni aban? <verse eid="JER 44:7" /><verse number="8" style="v" sid="JER 44:8" />Ka uagu hanabaguana lau hóuserun, águdaha huguya kupali houn amu búngiugu ya Ehiptu le ñeinhin lubéi hiabin aganawa? Lau lira, háluahañein hagumuchaguagüdün hungua. Ábame hiabin lun hénpulume lánina ǘnabuguni hadan sun néchanigu ha ubouagubaña. <verse eid="JER 44:8" /><verse number="9" style="v" sid="JER 44:9" />Bulíei humaali san sun wuribani le meha hadügübei hagüchagu, luma burí le hadügübei lurúeitegu Hudá hama hámarigu, luma burí le hadügübei huguya guánarügü hama húmarigu lumúanrugu Hudá luma burí lémerirugu Herusalén? <verse eid="JER 44:9" /><verse number="10" style="v" sid="JER 44:10" />Chülǘ lumoun dan le masansirun humagili higaburi, masandi huguya anufudei magunfulirun huméi narufudahan luma nilurudun le níchugubei hun luma houn hagüchagu.<verse eid="JER 44:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 44:11" />—Ligía nariñagunbei hun, au le Aburemei Suntigabafu, le Lubungiute Ísüraeli: Aranse naali naritagun lun nanügün wuribani huagun luma lun nagünrinchaguni sun Hudá. <verse eid="JER 44:11" /><verse number="12" style="v" sid="JER 44:12" />Nadügüba lun sun lan ha erederubaña hádangiñe lílana Hudá, aba houdin aganawa Ehiptu, lun hagünrinchawagun sunsuinagubei ñein. Sun hagía, lúmagiñe le ñǘraütimagilibei lumoun le wéiyatimahalibei, hóunweguba ladüga wuribu, o ilamaü ábame hasalirun hénpulume lánina íñarawaguni luma ǘnabuguni, ábanbei katei hanufunati le lunbei lasuseredun houn. <verse eid="JER 44:12" /><verse number="13" style="v" sid="JER 44:13" />Nabeichubaña ha aganóutiña Ehiptu kei meha nabeichuni Herusalén lau lamiselu, ilamaü luma sandi. <verse eid="JER 44:13" /><verse number="14" style="v" sid="JER 44:14" />Úabei ni aban hádangiñe fiuraü lílana Hudá ha ñǘdünbaña aganawa Ehiptu erederuti wínwanñu. Íbinime ánhaña abusenra hagiribudun Hudáun lun haganóun ñein, magiribudúnbaña, haweidigia fiu ha aramudagutiña ha esefurutiña lídangiñe wuribu.<verse eid="JER 44:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 44:15" />Hati subudibéi houn luagu águdaha hamá hámarigu kupali houn amu búngiugu, hama würiña ha ñéinbaña, hama huríu ha aganóubaña lidan suru libiti Ehiptu, aba hariñagun lun Heremíasi:<verse eid="JER 44:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 44:16" />—Madügünbadiwa gasu lau uganu le banügübei woun lúmagiñe Aburemei <verse eid="JER 44:16" /><verse number="17" style="v" sid="JER 44:17" />wadügamémebei le waritagubei wadügün. Wágudahamemeba kupali ru wagíame diwéin keisi idewesei tun bungiu to lurúeite sielu, ítara kei wadügüni chülǘ lumoun dan le, kei meha giñe hadügüni wagüchagu hama warúeitegu hama wábutigu luburuguterugu burí Hudá luma burí lémerirugu Herusalén. Ladüga géigintiwa meha saragu, buidu ligía dan woun, miabin ligía lamiselu woun; <verse eid="JER 44:17" /><verse number="18" style="v" sid="JER 44:18" />ánheinti lúmagiñe wígiruni wágudahan kupali luma wedewehan diwéin tun Lurúeite Sielu, úati ni kata wama, ani hilagua hagía wamutuniña lau ilamaü o wuriburugu.<verse eid="JER 44:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 44:19" />Ábaya giñe hariñagun würiña:</para>
  <para style="p" vid="JER 44:19">—Wagia, adaaguatiwa meha durudia tau tiyawa lurúeite sielu, ru wagía kupali tuma diwéin tun, gama lumoun sun le, lau hagundan wámarigu. Ani wadügamémebei.<verse eid="JER 44:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 44:20" />Ábati lariñagun Heremíasi houn sun wügüriña hama würiña ha óunabubalin ítara:<verse eid="JER 44:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 44:21" />—Haritaguatün san luagu mefén lan buga Aburemei, o bulíei lani luagu águdaha humá kupali houn amu búngiugu luburuguterugu burí Hudá luma lémerirugu Herusalén, huguya, hagüchagu, hábutigu hama sun lílana fulasu? <verse eid="JER 44:21" /><verse number="22" style="v" sid="JER 44:22" />Gama lumoun aba siñaali lan lawanduni Aburemei luriban higaburi, le aubei magundan lan. Ligía günringuaali lubéi hageira uguñe weyu, úouga aganóutiña ñein; ábanhali hénpulu lánina íñarawaguni, aban katei hanufunati. <verse eid="JER 44:22" /><verse number="23" style="v" sid="JER 44:23" />Lamiselu le gádanbalün guentó, lídangiñeti hadagaragüdün houn amu búngiugu, afigouha ítara kóntüra Aburemei, ani ladüga magunfulirun humani larufudahan luma lilurudun, magunfulirun huméi giñe lugumadin.<verse eid="JER 44:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 44:24" />Ariñagati giñe Heremíasi houn lílana fulasu, hóuntima würiña:</para>
  <para style="p" vid="JER 44:24">—Aganba huméi uganu le lúmagiñeti Aburemei, sun huguya lílana Hudá ha aganóubaña Ehiptu. <verse eid="JER 44:24" /><verse number="25" style="v" sid="JER 44:25" />Lariñahare Aburemei Suntigabafu, le Lubungiute Ísüraeli: “Huguya. Würiña, ariñaga humaali lau hiyuma ani hadügübei. Ariñagatün luagu füramasehadün lan luagu hadagaragüdüba lan tun lurúeite sielu, ani hagunfuliruba lan lau hererun. Buiti, gúnfuli huméi, adüga humeime le hariñagubei! <verse eid="JER 44:25" /><verse number="26" style="v" sid="JER 44:26" />Gama lumoun aganba huméi sun huguya lílana Hudá ha aganóubaña Ehiptu le nariñagubei hun au, le Aburemei: Fiñutina luagu niri, iri le wéirigutimabei, luagu mariñagundigia hamaali lanme Hudaana niri lidan sun Ehiptu, máfiñurunhañame ariñaga: Luagu libagari Aburemei. <verse eid="JER 44:26" /><verse number="27" style="v" sid="JER 44:27" />Lugundun aranseñunuba lun nóunahan lamiselu hawagun. Sun lílana Hudá ha aganóubaña Ehiptu, hagumuchaguba ladüga wuribu o ilamaü. <verse eid="JER 44:27" /><verse number="28" style="v" sid="JER 44:28" />Abahüdǘwarügübaña esefurutiña luéi hóunwegun wuriburugu lun hagiribudun Ehiptugiñe, lun Hudáun. Ítara luba harihini sun ha Hudaabaña, ha lúnbaña hayabin aganawa Ehiptu ka lan ererun agunfulirubei, anhein nererun lubéi lumoun hererun lan. <verse eid="JER 44:28" /><verse number="29" style="v" sid="JER 44:29" />Au, le Aburemei, níchigaali seini le hun keisi aba makü lun hachoururuni luagu lagunfuliruba lan nasiadirunün luagu nabeichagubadün lan lidan ageiraü le: <verse eid="JER 44:29" /><verse number="30" style="v" sid="JER 44:30" />Nederegerubei Ofurá le urúei Ehiptuna háhaburugun láganiñu, ítara kei nederegeruni Sedekíasi le lurúeite Hudá lúhaburugun Nabukodonosoru le lurúeite Babilónia le lágani lánina óunweni”.<verse eid="JER 44:30" /></para>
  <chapter eid="JER 44" />
  <chapter number="45" style="c" sid="JER 45" />
  <para style="s1">Füramasei lúmagiñeti Wabureme lun Baruku</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 45:1" />Lidan ligadürün lirumudiri lagumadihan Hoakimü le liráü Hosíasi, le lurúeite Hudá, sun aniha lan Baruku le liráü Neríasi abürühei le lariñagubei Heremíasi lun, aba lariñagun Heremíasi lun Baruku:<verse eid="JER 45:1" /></para>
  <para style="p">
    <verse number="2-3" style="v" sid="JER 45:2-3" />—Buguya Baruku, bariñahare: “Fugiabu au! Míchuti Aburemei amu katei nun luéidigia idiheri luma igarigu! Buchá nuagu ayahua, madaritina awalidaguni!” Lariñahare lubeiti Aburemei bibügürü, <verse eid="JER 45:2-3" /><verse number="4" style="v" sid="JER 45:4" />ani lóunahañadina ariñaga: “Günringua numuti le nábunagubei, hulaguanéi le nábunubei. Ani ligiamémeba nadüga lau sun ubóu. <verse eid="JER 45:4" /><verse number="5" style="v" sid="JER 45:5" />Busentibu san bamuriahan somu katei bungua le hanarimeguti? Málugagubeibei lugundun nóunaha lamiselu hawagun sun gürigia. Gama lumoun mígirunbadina lun bounwen le ñeinhin lumuti bidin. Au, le Aburemei ariñagubalin”.<verse eid="JER 45:5" /></para>
  <chapter eid="JER 45" />
  <chapter number="46" style="c" sid="JER 46" />
  <para style="ms">III. Ñunsu Kóntüra Burí Néchani</para>
  <para style="mr">(<ref loc="JER 46-51">46—51</ref>)</para>
  <para style="s1">Leferidiruni Ehiptu wuribu Karükémisi</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 46:1" />Aba ladimurehan Aburemei lun Heremíasi habügürü néchanigu.<verse eid="JER 46:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 46:2" />Anihán uganu le lariñagubei libügürü Ehiptu, hawagutima lisudaranigu Nekáu, le lurúeite Ehiptu le Karükémisibei lubadu duna le Éufüratesi, ligía urúei le láfarahabei Nabukodonosoru le lurúeite Babilónia lidan ligadürün lirumudiri larúeihan Hoakimü le liráü Hosíasi, le lurúeite Hudá:<verse eid="JER 46:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="JER 46:3" />«Aranse huméi idaüdinaü!</para>
  <para style="q" vid="JER 46:3">Ábürüha humá hawagun!<verse eid="JER 46:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 46:4" />Sádili humaña gabayu!</para>
  <para style="q" vid="JER 46:4">Warí humá, agalufehatiña!</para>
  <para style="q" vid="JER 46:4">Daü huméi hubunidin le lánina wuribu, úaragua humá!</para>
  <para style="q" vid="JER 46:4">Yará huméi tígiri higimaran!</para>
  <para style="q" vid="JER 46:4">Daü humóun hadaüragun lánina wuribu!<verse eid="JER 46:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="JER 46:5" />«Gama lumoun ka san le narihibei?</para>
  <para style="q" vid="JER 46:5">Habakürüña hárigoun buin lau anufudei.</para>
  <para style="q" vid="JER 46:5">Baragua wuriburuguna, heferidiruñein wuribu!</para>
  <para style="q" vid="JER 46:5">Aba háfuridun wuriburugugiñe éibaagueina madigiragunga hárigoun,</para>
  <para style="q" vid="JER 46:5">hanufudeugati lidan sun fulasu!</para>
  <para style="q" vid="JER 46:5">Au, le Aburemei ariñagubalin.<verse eid="JER 46:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 46:6" />Manurahadügü hamá ha óufutimabaña,</para>
  <para style="q" vid="JER 46:6">manurunbaña giñe ha ganigitimabaña</para>
  <para style="q" vid="JER 46:6">ladüga luéigiñe nórute libiti duna Éufüratesi</para>
  <para style="q" vid="JER 46:6">hachugeraguba lun héiguadun.<verse eid="JER 46:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 46:7" />Katei san le, le iñurubei kei liñurun duna Nilu,</para>
  <para style="q" vid="JER 46:7">kei aban duna le aguribihati le lere?<verse eid="JER 46:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 46:8" />Ehiptu le, le iñurubei kei liñurun duna Nilu,</para>
  <para style="q" vid="JER 46:8">kei aban duna le aguribihati le lere.</para>
  <para style="q" vid="JER 46:8">Lariñahare Ehiptu: “Niñura, lun nabuluchuni ubóu,</para>
  <para style="q" vid="JER 46:8">nagünrinchaguaali burí uburugu hau sun lílana”.<verse eid="JER 46:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="JER 46:9" />«Awanse hamá súdaragu ha gabayuagutiña!</para>
  <para style="q" vid="JER 46:9">Tubaruaguountá karü!</para>
  <para style="q" vid="JER 46:9">Awanse hamá wuriburuguna:</para>
  <para style="q" vid="JER 46:9">lisudaranigu Etiopía luma Liwia tau hadaüdina;</para>
  <para style="q" vid="JER 46:9">lisudaranigu Lidia, ha gachüühadibaña gimara».<verse eid="JER 46:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 46:10" />Luéyuri Aburemei Suntigabafu le,</para>
  <para style="q" vid="JER 46:10">weyu le lunbei láguyugüdüni wuribati houn láganiñu</para>
  <para style="q" vid="JER 46:10">luagu le hadügübei lun.</para>
  <para style="q" vid="JER 46:10">Táchuahaba eféin darime lun takimuledun,</para>
  <para style="q" vid="JER 46:10">darime giñe lun tabacharuadun lau hitaü.</para>
  <para style="q" vid="JER 46:10">Ladüga ladügüba Aburemei aban áfarahani</para>
  <para style="q" vid="JER 46:10">lidan ageiraü le luéigiñebei nórute,</para>
  <para style="q" vid="JER 46:10">lóubawagu duna Éufüratesi».<verse eid="JER 46:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="JER 46:11" />«Lílana Ehiptu, heiba Galaadü áluaha árani!</para>
  <para style="q" vid="JER 46:11">Gama lumoun gayaraabei hayusuruni sun árani le hiyaraati,</para>
  <para style="q" vid="JER 46:11">úabei hu lan hun, lugundun máraninaadün!<verse eid="JER 46:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 46:12" />Subudi hamaali néchanigu luagu ǘnabugüdawaadün lan,</para>
  <para style="q" vid="JER 46:12">ani aganbúati hagúarahan lidan sun fulasu;</para>
  <para style="q" vid="JER 46:12">buguguatiña wuriburuguna hawougua aba habalabahoun múarugun úara».<verse eid="JER 46:12" /></para>
  <para style="s1">Lábürühan Nabukodonosoru luagun Ehiptu</para>
  <para style="p">
    <verse number="13" style="v" sid="JER 46:13" />Aba ladimurehan Aburemei lun profeta Heremíasi dan le lídinbei Nabukodonosoru, le lurúeite Babilónia lun lageindagun luma Ehiptu.<verse eid="JER 46:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="JER 46:14" />«Aganbagüda humá uburugu Ehiptu, Migüdólu, Ménfisi</para>
  <para style="q" vid="JER 46:14">luma Táfünesi ítara:</para>
  <para style="q" vid="JER 46:14">“Aranseñu humá!</para>
  <para style="q" vid="JER 46:14">Anuhán eféin lun tagünrinchaguni bageira bau!”<verse eid="JER 46:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 46:15" />Ka uagu lanuraha Apisü, le bubagasun le sagüráubei?</para>
  <para style="q" vid="JER 46:15">Ka uagu merederun lubéi rara?</para>
  <para style="q" vid="JER 46:15">Ladüga náhuchuruni, au, le Aburemei.<verse eid="JER 46:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 46:16" />Chugeguatiña bisudaranigu hawougua,</para>
  <para style="q" vid="JER 46:16">aba hariñagun hóuniwagua:</para>
  <para style="q" vid="JER 46:16">“Keimoun yáagiñe, giribu hamá wageiroun;</para>
  <para style="q" vid="JER 46:16">lidoun ageiraü le ñein lubéi wagaraüdǘwa!</para>
  <para style="q" vid="JER 46:16">Anuraha wamá luéi lanarime wuribu!”<verse eid="JER 46:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="JER 46:17" />«Chagua huméi urúei Ehiptuna lau nikinému le:</para>
  <para style="q" vid="JER 46:17">“Dabarasi gamuriti lárigiñe dan”.<verse eid="JER 46:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 46:18" />Au, le Urúeibei ani Aburemei le Suntigabafu níribei.</para>
  <para style="q" vid="JER 46:18">Fiñutina luagu nibagari</para>
  <para style="q" vid="JER 46:18">kei liñun wübü Taworu labadinagua áraabu</para>
  <para style="q" vid="JER 46:18">ani kei liñun dabíara Karümélu luéi barana,</para>
  <para style="q" vid="JER 46:18">ítara luba lanarime lubafu ágani le lunbei liabin.<verse eid="JER 46:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 46:19" />Aranse humá lubá hasagarún hageiragiñe,</para>
  <para style="q" vid="JER 46:19">lílana Ehiptu, lerederuba Ménfisi málouga,</para>
  <para style="q" vid="JER 46:19">úouga aganóutiña ñein.<verse eid="JER 46:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 46:20" />Tenege aban bágasu ñǘraügiru to magadiñetu Ehiptu,</para>
  <para style="q" vid="JER 46:20">gama lumoun anute aban gunga luéigiñe nórute ásüroun.<verse eid="JER 46:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 46:21" />Ítara haña bisudaranigu kei bágasu wügüriña ha dibunetiña,</para>
  <para style="q" vid="JER 46:21">gama lumoun íbini hagía hanurahaba giñe,</para>
  <para style="q" vid="JER 46:21">mawandunbaña, lugundun aniteeli luéyuri lamiselu,</para>
  <para style="q" vid="JER 46:21">lóurate habeichawaguniwa.<verse eid="JER 46:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 46:22" />Lanurahaba Ehiptu íñaaheina</para>
  <para style="q" vid="JER 46:22">kei aban hewe danme hayarafadun súdaragu ageindagua tuma tau harawa,</para>
  <para style="q" vid="JER 46:22">kamá hamuga háchuahaña tídibu wewe.<verse eid="JER 46:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 46:23" />Háchuahabei hadabiaran le hilumabei!</para>
  <para style="q" vid="JER 46:23">Au, le Aburemei ariñagubalin.</para>
  <para style="q" vid="JER 46:23">Gíbetiña sügǘ hau chagagaru, siñati habahüdǘn.<verse eid="JER 46:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 46:24" />Lǘnabudagüdüwaba Ehiptu,</para>
  <para style="q" vid="JER 46:24">lábürühaba háhaburugun lílana nórute».<verse eid="JER 46:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="JER 46:25" />Lariñahare Aburemei Suntigabafu, le Lubungiute Ísüraeli:</para>
  <para style="p" vid="JER 46:25">—Labeichubei Amón, lubungiute Tébasi, Ehiptu hau sun lubungiutegu hama lurúeitegu, urúei Ehiptuna hama ha hemenigibaña luagu. <verse eid="JER 46:25" /><verse number="26" style="v" sid="JER 46:26" />Nábürügüdübaña háhaburugun háganiñu, lúhaburugun Nabukodonosoru le lurúeite Babilónia hama lumutuniña. Gama lumoun átirime dan lárigiñe, ñéinyabaña aganóutiña Ehiptu. Au, le Aburemei, ariñagubalin.<verse eid="JER 46:26" /></para>
  <para style="s1">Lesefurubaña Wabureme lumutuniña</para>
  <para style="r">(<ref loc="JER 30:10-11">Her 30.10-11</ref>)</para>
  <para style="q">
    <verse number="27" style="v" sid="JER 46:27" />“Manufudeda humá, lánigu Hakobu, nubúein,</para>
  <para style="q" vid="JER 46:27">manufudedabá Ísüraeli.</para>
  <para style="q" vid="JER 46:27">Ladüga buguya hau sun birahüñü,</para>
  <para style="q" vid="JER 46:27">nesefurubadün lídangiñe ageiraü díseti le,</para>
  <para style="q" vid="JER 46:27">le ñeinhin lubéi hanügǘwa hageiragiñe.</para>
  <para style="q" vid="JER 46:27">Babagaridayaba darangilu,</para>
  <para style="q" vid="JER 46:27">úouga anufudedaguagüdütibu.<verse eid="JER 46:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 46:28" />Nariñahare au, le Aburemei:</para>
  <para style="q" vid="JER 46:28">Manufudedabá Hakobu, nubúein,</para>
  <para style="q" vid="JER 46:28">lugundun anahein buma.</para>
  <para style="q" vid="JER 46:28">Nagünrinchagubaña sun néchanigu ha ídounbaña nachagarabu.</para>
  <para style="q" vid="JER 46:28">Gama lumoun buguya, magünrinchagun nubadibu;</para>
  <para style="q" vid="JER 46:28">béirügü nubadibu keisi badüna;</para>
  <para style="q" vid="JER 46:28">mígirun nubadibu mabeichúnga”.<verse eid="JER 46:28" /></para>
  <chapter eid="JER 46" />
  <chapter number="47" style="c" sid="JER 47" />
  <para style="s1">Ñunsu kóntüra Filistéana</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 47:1" />Anihán uganu le líchugubei Aburemei lun profeta Heremíasi habügürü Filistéana, lubaragiñebei lábürühan urúei Ehiptuna luagun Gasa:<verse eid="JER 47:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 47:2" />«Nariñahare au, le Aburemei:</para>
  <para style="q" vid="JER 47:2">Anite abuluchuni nóruterugugiñe,</para>
  <para style="q" vid="JER 47:2">kei lidan labuinchun duna le héreti,</para>
  <para style="q" vid="JER 47:2">bulugüda lumuti ageiraü</para>
  <para style="q" vid="JER 47:2">luma sun le ladarirun lubarua,</para>
  <para style="q" vid="JER 47:2">uburugu burí hau ha aganóubaña lidan.</para>
  <para style="q" vid="JER 47:2">Sun lílana fulasu aba hagúarahan lau igarigu,</para>
  <para style="q" vid="JER 47:2">amumehatiña gürigia le hagarigu.<verse eid="JER 47:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 47:3" />Danme haganbuni lamuri hagudi gabayu,</para>
  <para style="q" vid="JER 47:3">tirein karü luma lamuri tubalaba,</para>
  <para style="q" vid="JER 47:3">heferidirubei agübürigu erei,</para>
  <para style="q" vid="JER 47:3">ábame hígiruniña hasaanigu.<verse eid="JER 47:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 47:4" />Ladüga chülühame weyu lun</para>
  <para style="q" vid="JER 47:4">hagumuchawaguagüdün Filistéana,</para>
  <para style="q" vid="JER 47:4">lun lagidarún Tiru luma Sidón hawéi,</para>
  <para style="q" vid="JER 47:4">ídemuei le yebe hámaraügilibei».</para>
  <para style="b" vid="JER 47:4" />
  <para style="q" vid="JER 47:4">Lagünrinchagubaña Aburemei Filistéana</para>
  <para style="q" vid="JER 47:4">ha ñǘbuinbaña luéigiñe ubouhu le Küreta.<verse eid="JER 47:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 47:5" />Helugüda hamuti lílana Gasa hábulugu,</para>
  <para style="q" vid="JER 47:5">rédeitiña lílana Asükalón maniñu.</para>
  <para style="q" vid="JER 47:5">Hagumuhóun wuriburuguna hígandeigu,</para>
  <para style="q" vid="JER 47:5">ídaba san hígirei híbaagun hungua arufudei higarigu?<verse eid="JER 47:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 47:6" />Lefeinte Wabureme, ídaba san lagumucha báchuahan?</para>
  <para style="q" vid="JER 47:6">Beluyabá tidoun bagei, gálumaba, deregüdaguabá!<verse eid="JER 47:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 47:7" />Gama lumoun, ida luba san tederaguagüdün,</para>
  <para style="q" vid="JER 47:7">rúhaliga Aburemei lúrudu tun,</para>
  <para style="q" vid="JER 47:7">anhein ariñagaali lubéi tun</para>
  <para style="q" vid="JER 47:7">lun tageindagun luma Asükalón</para>
  <para style="q" vid="JER 47:7">ageindaguame luma aüdü burí le kósurugubei?<verse eid="JER 47:7" /></para>
  <chapter eid="JER 47" />
  <chapter number="48" style="c" sid="JER 48" />
  <para style="s1">Lagünrinchawagun Moabü</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 48:1" />Anihán ñunsu lúmagiñeti Aburemei Suntigabafu le Lubungiute Ísüraeli, libügürü Moabü:</para>
  <para style="b" vid="JER 48:1" />
  <para style="q" vid="JER 48:1">«Fugiabu uburugu Nebu, günrinwagua!</para>
  <para style="q" vid="JER 48:1">Ragüwati Kiriataimü aba lǘnabudawagüdün!</para>
  <para style="q" vid="JER 48:1">Fuíwati habarieirun múarugun!<verse eid="JER 48:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 48:2" />Gumugua luéirigun Moabü,</para>
  <para style="q" vid="JER 48:2">haransehaña áganiñu uburugu Esübón,</para>
  <para style="q" vid="JER 48:2">lun hagumuchaguagüdüni Moabü keisi aban néchani.</para>
  <para style="q" vid="JER 48:2">Buguya giñe Madümén, bagünrinchawaguba giñe,</para>
  <para style="q" vid="JER 48:2">ani súnwandan lasiadirubadibu wuribu.<verse eid="JER 48:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 48:3" />Aganbúati agúarahani Oronaimügiñe:</para>
  <para style="q" vid="JER 48:3">“Günringuaü luma óunwenbu agadeiruni!”<verse eid="JER 48:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="JER 48:4" />Gádeiha Moabü;</para>
  <para style="q" vid="JER 48:4">aganbúati hagúarahan lirahüñü.<verse eid="JER 48:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 48:5" />Anihein águiraü hágurugu ha amudeireinabaña</para>
  <para style="q" vid="JER 48:5">luéigiñe luwübüri Luitü;</para>
  <para style="q" vid="JER 48:5">ha aragachubaña uburugun Oronaímü,</para>
  <para style="q" vid="JER 48:5">agúarahatiña lau igarigu ladüga óunwenbu lamiselu.<verse eid="JER 48:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 48:6" />Anuraha humá! Sefulá le gayaraati!</para>
  <para style="q" vid="JER 48:6">Ítara humá kei búbugati lidan fulasu mageirawati!<verse eid="JER 48:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="JER 48:7" />«Moabü, hemenigiñahatibu luagu bere luma birisin,</para>
  <para style="q" vid="JER 48:7">gama lumoun bárügüdüwaba giñe.</para>
  <para style="q" vid="JER 48:7">Lanügǘba Kemosu le bubungiute</para>
  <para style="q" vid="JER 48:7">lidoun amu ageiraü habu sun lufadirinigu</para>
  <para style="q" vid="JER 48:7">hama gürigia ha wéirigubaña.<verse eid="JER 48:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 48:8" />Lachülürüba günringuaü lidoun sun burí uburugu,</para>
  <para style="q" vid="JER 48:8">mesefubei ni aban;</para>
  <para style="q" vid="JER 48:8">lerederuba fulasu wayati luma fulasu le wǘbüguati lidan günringuaü.</para>
  <para style="q" vid="JER 48:8">Au, le Aburemei ariñagubalin.<verse eid="JER 48:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 48:9" />Ru humá arünaü lun Moabü lun lidin áhamaheina;</para>
  <para style="q" vid="JER 48:9">lugundun hagünrinchaguaali</para>
  <para style="q" vid="JER 48:9">ladüga lerederuba burí luburugute lidan günringuaü</para>
  <para style="q" vid="JER 48:9">úouga ni aban aganóuti ñein».<verse eid="JER 48:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="JER 48:10" />(Íñarawaguati le madügünti wadagimanu le uáguti lariñaga Aburemei lau ugundani! Íñarawaguati le areiduti lefeinte lun máfarahan lan!)<verse eid="JER 48:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 48:11" />Súnwandanha darangilañu lan awinwanduni Moabü, masagarúnñahagiña lílana hageiragiñe. Ítara haña kei diwéin to igirúboun lun tañuuragun, to meserúnboun lídangiñe aban ágeidinaü lidoun amu, ligía meferidiradi lubéi tisemén ni tíhemen.<verse eid="JER 48:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 48:12" />Gama lumoun lariñahare Aburemei: Lachülürüba weyu danme nóunahan gürigia éseroun diwéin tuguya lidoun amu ágeidinaü, ábame habouchaguni ágeidinaü le erederubei málouga. <verse eid="JER 48:12" /><verse number="13" style="v" sid="JER 48:13" />Ábameti labusigaridagun Moabü lau Kemosu le lubungiute, ítara kei buga labusigaridagun Ísüraeli lau Beteli le meha uágubei líchigei sun lemenigin.<verse eid="JER 48:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="JER 48:14" />«Mariñagalátia Moabü: “Ganigitiwa,</para>
  <para style="q" vid="JER 48:14">wuriburuguna héretiña wagía”.<verse eid="JER 48:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 48:15" />Aniteeli agünrinchaguti Moabü luma burí luburugute.</para>
  <para style="q" vid="JER 48:15">Ha buídutimabaña hádangiñe ha nibureindeinabaña ñein hóunweguba.</para>
  <para style="q" vid="JER 48:15">Urúei le gíribei Aburemei Suntigabafu ariñagubalin.<verse eid="JER 48:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 48:16" />Layarafaduña lilamiserun Moabü.</para>
  <para style="q" vid="JER 48:16">Lúnrügaali lachülürün halamiserun.<verse eid="JER 48:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 48:17" />Lubesinanigu Moabü</para>
  <para style="q" vid="JER 48:17">hama sun ha subudihabúbaña lun laganbahoun luagu,</para>
  <para style="q" vid="JER 48:17">hayahuaha luagu, hariñagame:</para>
  <para style="q" vid="JER 48:17">“Ariha humá, halagua wewe le seini lánina erei,</para>
  <para style="q" vid="JER 48:17">lubaduna uéiriguni!”<verse eid="JER 48:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="JER 48:18" />«Rariba lídangiñe bubara le wéirigubei,</para>
  <para style="q" vid="JER 48:18">uburugu Dibón, ñuruba múarugu,</para>
  <para style="q" vid="JER 48:18">ladüga anitén le agünrinchagubalin Moabü buagun,</para>
  <para style="q" vid="JER 48:18">günringua laali sun bubarieirun.<verse eid="JER 48:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 48:19" />Uburugu Aroerü, ráramaba laru üma, barihame,</para>
  <para style="q" vid="JER 48:19">bálügüdañame ha móunwegunbaña ka lan asuseredubei.<verse eid="JER 48:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 48:20" />Ǘnabugüdüwa Moabü, anihein buin lau anufudei.</para>
  <para style="q" vid="JER 48:20">Hayahuaha lau igarigu luagu!</para>
  <para style="q" vid="JER 48:20">Ariñaga humá laru duna Arünón luagu günrinwagua lan Moabü!»<verse eid="JER 48:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="JER 48:21" />Chülüha abeichúni le ariñawagúaalibei luagun burí uburugu le lídanbei fulasu gawübüriguati: Olón, Haasü, Mefatü, <verse eid="JER 48:21" /><verse number="22" style="v" sid="JER 48:22" />Dibón, Nebu, Betü-dibülataímü, <verse eid="JER 48:22" /><verse number="23" style="v" sid="JER 48:23" />Kiriataimü, Betü-gamulu, Betü-meón, <verse eid="JER 48:23" /><verse number="24" style="v" sid="JER 48:24" />Keriotu, Bosurá labu burí sun luburugute Moabü, le yarafabei luma le dísebei.<verse eid="JER 48:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="JER 48:25" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 48:25">«Halagua lere Moabü,</para>
  <para style="q" vid="JER 48:25">günringua lubafu».<verse eid="JER 48:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="JER 48:26" />Bacharuagüda huméi Moabü,</para>
  <para style="q" vid="JER 48:26">ladüga liñuragun lungua luagun Aburemei.</para>
  <para style="q" vid="JER 48:26">Ábameti labalabahan Moabü lidan lewerahan guánarügü,</para>
  <para style="q" vid="JER 48:26">ábame ladügǘn bula lau.<verse eid="JER 48:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JER 48:27" />Moabü, ma adaaguañahatibu bula lau Ísüraeli,</para>
  <para style="q" vid="JER 48:27">adimureha buguyaha luagu lau mínsiñehabuni,</para>
  <para style="q" vid="JER 48:27">kamá hamuga aban híweruti ligía?<verse eid="JER 48:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 48:28" />Furí humá uburugugiñe lílana Moabü;</para>
  <para style="q" vid="JER 48:28">heiba aganawa laganagua dübü wéinamuti kei wagugua.</para>
  <para style="q" vid="JER 48:28">Ha adügübaña hamasa lárurugu gudungu.<verse eid="JER 48:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 48:29" />Subudi wamuti lanarime lanaagun Moabü lungua:</para>
  <para style="q" vid="JER 48:29">líñugun, lupantan luma lanarimegu.<verse eid="JER 48:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 48:30" />Subudi lumuti giñe Aburemei lumabuchahan,</para>
  <para style="q" vid="JER 48:30">adimuredügü lan luma lásurun erere.<verse eid="JER 48:30" /></para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" sid="JER 48:31" />Ligía nayahuba lubéi agúaraha nuguyame hawagu sun lílana Moabü</para>
  <para style="q" vid="JER 48:31">luma hawagu lílana Kirü-eresi.<verse eid="JER 48:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JER 48:32" />Nayahuba buagu, beibei-agei le lani Sibümá,</para>
  <para style="q" vid="JER 48:32">Sügǘ lau layahún luagu Haserü.</para>
  <para style="q" vid="JER 48:32">Chülüti burí meha bilimun yagürounmeme luéi barana,</para>
  <para style="q" vid="JER 48:32">chülüti meha darí Haserü.</para>
  <para style="q" vid="JER 48:32">Gama lumoun günrinwagua balubahan beibei.<verse eid="JER 48:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JER 48:33" />Maganbúnhali agúarahani lánina ugundani</para>
  <para style="q" vid="JER 48:33">lufulurin-ágeirugu Moabü.</para>
  <para style="q" vid="JER 48:33">Gumuha diwéin lídangiñe tagei.</para>
  <para style="q" vid="JER 48:33">Úaaña kaba lan achuinragua beibei,</para>
  <para style="q" vid="JER 48:33">úaali uremu lánina ugundani.<verse eid="JER 48:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="JER 48:34" />Agúarahatiña lílana Esübón lau igarigu,</para>
  <para style="q" vid="JER 48:34">chülüti hagúarahan darí Elalé luma Haasü,</para>
  <para style="q" vid="JER 48:34">luma lúmagiñe Sóarügiñe darí Oronaímü luma Egülátü-selisíya,</para>
  <para style="q" vid="JER 48:34">ladüga íbini lísensen duna le burí Nimürímübei mábeiha.<verse eid="JER 48:34" /></para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" sid="JER 48:35" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 48:35">«Nagünrinchagubaña lílana Moabü ha awarirubaña luagun burí wübü,</para>
  <para style="q" vid="JER 48:35">adagaragüda tidan hasanduariun gibe tubungiutegu</para>
  <para style="q" vid="JER 48:35">luma águdaha kupali houn habungiutegu».<verse eid="JER 48:35" /></para>
  <para style="b" />
  <para style="q">
    <verse number="36" style="v" sid="JER 48:36" />Ligía tamumehanbei nanigi luagu Moabü luma hawagu lílana Kirü-eresi</para>
  <para style="q" vid="JER 48:36">kamá hamuga tamuri fidu lidan ábunahani,</para>
  <para style="q" vid="JER 48:36">ladüga féridiha irisini le meha lóundaragubei.<verse eid="JER 48:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="JER 48:37" />Heluha sun ábulugu, sawa sun ídiumaü;</para>
  <para style="q" vid="JER 48:37">adügaaña súngubei biti luagu háhabu,</para>
  <para style="q" vid="JER 48:37">daügua hagía daüguaü súsutu.<verse eid="JER 48:37" /></para>
  <para style="b" />
  <para style="q">
    <verse number="38" style="v" sid="JER 48:38" />«Ayahunirügüñein aganbúa luagu</para>
  <para style="q" vid="JER 48:38">sun tábulugu muna Moabü luma lidan sun lémeri,</para>
  <para style="q" vid="JER 48:38">ladüga günringua nan Moabü kei aban weru le meseriwínti.</para>
  <para style="q" vid="JER 48:38">Au, le Aburemei ariñagubalin».<verse eid="JER 48:38" /></para>
  <para style="b" />
  <para style="q">
    <verse number="39" style="v" sid="JER 48:39" />Hayahuaha luagu Moabü!</para>
  <para style="q" vid="JER 48:39">Buin liña lau anufudei!</para>
  <para style="q" vid="JER 48:39">Areidalá lefeinte lau aban igaburi le nibusigarídünati!</para>
  <para style="q" vid="JER 48:39">Saliguaali lun ábanme katei hanufunati houn sun lubesinanigu.<verse eid="JER 48:39" /></para>
  <para style="b" />
  <para style="q">
    <verse number="40" style="v" sid="JER 48:40" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 48:40">«Láhamaruba lágani Moabü luagun</para>
  <para style="q" vid="JER 48:40">kei aban ágila lau tarüna tulegu.<verse eid="JER 48:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="JER 48:41" />Lábürühaba burí uburugu tuma muna to héreboun labun lubafu ágani,</para>
  <para style="q" vid="JER 48:41">lídanme weyu ligía hadadagaruba wuriburuguna Moábüna</para>
  <para style="q" vid="JER 48:41">kei würiña agaridutiña.<verse eid="JER 48:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="JER 48:42" />Lagünrinchawaguba Moabü,</para>
  <para style="q" vid="JER 48:42">ladüga liñuragun lungua nuagun,</para>
  <para style="q" vid="JER 48:42">au, le Aburemei.<verse eid="JER 48:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="JER 48:43" />Ligía nariñagunbei au, le Aburemei:</para>
  <para style="q" vid="JER 48:43">Ítara haba lílana Moabü kei animaalugu ha éibaahoutiña</para>
  <para style="q" vid="JER 48:43">o ha lan yarafaaña lun héiguadun lidoun huyu o tidoun sádara.<verse eid="JER 48:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="JER 48:44" />Le esefuruti hawéi éibaahatiña,</para>
  <para style="q" vid="JER 48:44">léiguaduba húyurugun,</para>
  <para style="q" vid="JER 48:44">le áfuriduti húyurugugiñe,</para>
  <para style="q" vid="JER 48:44">lábürühaba tidoun sádara,</para>
  <para style="q" vid="JER 48:44">ladüga nanügübei lidaani labeichún Moabü luagun.</para>
  <para style="q" vid="JER 48:44">Au, le Aburemei ariñagubalin.<verse eid="JER 48:44" /></para>
  <para style="b" />
  <para style="q">
    <verse number="45" style="v" sid="JER 48:45" />«Añahein anurahatiña ha méreeña áluaha haramudagun</para>
  <para style="q" vid="JER 48:45">lábugiñe lamuñan Esübón,</para>
  <para style="q" vid="JER 48:45">gama lumoun láguduña Esübón le luburugute urúei Sihón,</para>
  <para style="q" vid="JER 48:45">ani léibaahaña ligeme,</para>
  <para style="q" vid="JER 48:45">láguduñein luwübüri burí Moabü,</para>
  <para style="q" vid="JER 48:45">ageiraü súsuti ligía.<verse eid="JER 48:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="JER 48:46" />Fugiabu buguya Moabü!</para>
  <para style="q" vid="JER 48:46">Féridihadibu, lageira Kemosu!</para>
  <para style="q" vid="JER 48:46">Háfuridagüdüwaba birahüñü hageiragiñe.<verse eid="JER 48:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="JER 48:47" />Gama lumoun nasansirubei lubunurun Moabü lagumuhóun oura;</para>
  <para style="q" vid="JER 48:47">au, le Aburemei ariñagubalin».</para>
  <para style="b" vid="JER 48:47" />
  <para style="q" vid="JER 48:47">Anihán siadi le líchugubei Aburemei kóntüra Moabü.<verse eid="JER 48:47" /></para>
  <chapter eid="JER 48" />
  <chapter number="49" style="c" sid="JER 49" />
  <para style="s1">Hasiadirún Amonna</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 49:1" />Anihán ñunsu lúmagiñe Aburemei libügürü Amón:</para>
  <para style="q" vid="JER 49:1">«Hagaña san lirahüñü Ísüraeli?</para>
  <para style="q" vid="JER 49:1">Hagaña ha lúnbaña heresibiruni halagante?</para>
  <para style="q" vid="JER 49:1">Ka uagu bungiu lubéi Milükómu laburemebei Gadü guentó?</para>
  <para style="q" vid="JER 49:1">Ka uagu haganawa Amonna lidan burí luburugute?<verse eid="JER 49:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JER 49:2" />«Nariñahareti au, le Aburemei:</para>
  <para style="q" vid="JER 49:2">Lachülürüba weyu lun naganbagüdüni agúarahani lánina wuribu</para>
  <para style="q" vid="JER 49:2">lun uburugu Amón le lani Rabá;</para>
  <para style="q" vid="JER 49:2">lerederuba kei paili hime,</para>
  <para style="q" vid="JER 49:2">láguduba burí sun fulasu geyegua lau.</para>
  <para style="q" vid="JER 49:2">Ábayameti lárügüdüni Ísüraeli luburugute lárigoun.</para>
  <para style="q" vid="JER 49:2">Au, le Aburemei ariñagubalin.<verse eid="JER 49:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="JER 49:3" />«Bamumeha Esübón, ladüga gulúagua uburugu Ai!</para>
  <para style="q" vid="JER 49:3">Hayahuaha, würiña lílana Rabá!</para>
  <para style="q" vid="JER 49:3">Daügua humá ludu,</para>
  <para style="q" vid="JER 49:3">áfaraha huméi haniguagu!</para>
  <para style="q" vid="JER 49:3">Éibaagua humá kei lülü tau, bigua humá hungua!</para>
  <para style="q" vid="JER 49:3">Ladüga lanügǘwa bungiu Milükómu lidoun fulasu le mama hageira,</para>
  <para style="q" vid="JER 49:3">hau lufadirinigu hama gürigia wéirigutiña.<verse eid="JER 49:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 49:4" />Ka uagu banaagua bungua luagu bere?</para>
  <para style="q" vid="JER 49:4">Lagumuchuña bere mabuchahati buguya le,</para>
  <para style="q" vid="JER 49:4">buguya le hemenigibei luagu irisini le bóundarubei, ariñaga buguya:</para>
  <para style="q" vid="JER 49:4">“Kaba ñübuin nuagun?”<verse eid="JER 49:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 49:5" />Nóunahaba anufudei buagun lídangiñe sun fulasu.</para>
  <para style="q" vid="JER 49:5">Au, le Aburemei Suntigabafu ariñagubalin.</para>
  <para style="q" vid="JER 49:5">Héibaaguba sun huguya,</para>
  <para style="q" vid="JER 49:5">kada aban luagu lémeri,</para>
  <para style="q" vid="JER 49:5">ani úabei kaba lan óundaraguaün hárigoun.<verse eid="JER 49:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 49:6" />Gama lumoun lárigiñeme, nasansirubei habunurun Amonna.</para>
  <para style="q" vid="JER 49:6">Au, le Aburemei ariñagubalin».<verse eid="JER 49:6" /></para>
  <para style="s1">Ñunsu kóntüra Edomu</para>
  <para style="p">
    <verse number="7" style="v" sid="JER 49:7" />Anihán ñunsu lúmagiñeti Aburemei Suntigabafu libügürü Edomu:</para>
  <para style="b" vid="JER 49:7" />
  <para style="q" vid="JER 49:7">«Úaali san lichú aau Temán?</para>
  <para style="q" vid="JER 49:7">Ibidiñeeli san houn huali tichügü kaba lan hadüga?</para>
  <para style="q" vid="JER 49:7">Féridiha san lichú hau?<verse eid="JER 49:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 49:8" />Lílana Dedán, furí humá éibaagueina,</para>
  <para style="q" vid="JER 49:8">heiba aramudagua!</para>
  <para style="q" vid="JER 49:8">Ladüga nagünrinchaguaali Esaú,</para>
  <para style="q" vid="JER 49:8">chülüha dan lun nabeichuni.<verse eid="JER 49:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 49:9" />Lidan le talubahóuniwa beibei,</para>
  <para style="q" vid="JER 49:9">súnwandan ligirúniwa fiu liresimun;</para>
  <para style="q" vid="JER 49:9">dan le hayabin íweruhatiña áriebu,</para>
  <para style="q" vid="JER 49:9">lérügüñein hemegeirubei hanüga.<verse eid="JER 49:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 49:10" />Gama lumoun ígira naali lageira Esaú málouga,</para>
  <para style="q" vid="JER 49:10">darina burí laramudaguagüle, siñá laramudagun.</para>
  <para style="q" vid="JER 49:10">Günrinwagua lirahüñü, liduheñu hama lubesinanigu,</para>
  <para style="q" vid="JER 49:10">meredeeli ni aban lun lariñagun:<verse eid="JER 49:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 49:11" />“Ígirabaña méteñuhaña nun, nóunigirubaña.</para>
  <para style="q" vid="JER 49:11">Hemenigi hamá würiña hilaguaaña úmari nuagu” ».<verse eid="JER 49:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="JER 49:12" />Lariñahare Aburemei:</para>
  <para style="p" vid="JER 49:12">—Guraaña ligía ha yebe madünabei hatun lídangiñe likopun abeichúni, meredebadibu mabeichúnga, gasu giñe batun lídangiñe. <verse eid="JER 49:12" /><verse number="13" style="v" sid="JER 49:13" />Au, le Aburemei fiñú numuti nuougua: Lerederuba uburugu Bosurá kei fulasu mageirawati, günrinwaguañu keisi hénpulu lánina íñarawaguni, lerederuba giñe líbiri uburugu günrinwaguañu lun sun dan.<verse eid="JER 49:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="JER 49:14" />Chülühali aban uganu nun lúmagiñe Aburemei;</para>
  <para style="q" vid="JER 49:14">anihein aban apurichihati hadan néchanigu lariñaga:</para>
  <para style="q" vid="JER 49:14">«Óundaragua humá, heiba ábürüha luagun Edomu!</para>
  <para style="q" vid="JER 49:14">Aranse humá lubá wuribu!<verse eid="JER 49:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 49:15" />Nadügüba lun buguyatima lan ñüraü hadan néchanigu</para>
  <para style="q" vid="JER 49:15">létima iyereegubei haganagua wügüriña.<verse eid="JER 49:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 49:16" />Ígiraguagüdaadibu bungua lun leyeedunibu banaagun bungua,</para>
  <para style="q" vid="JER 49:16">ladüga hanufuneñahatibu.</para>
  <para style="q" vid="JER 49:16">Lidan lilulun dübü baganawa,</para>
  <para style="q" vid="JER 49:16">ragüñu babua luéigiñe lábulugu wübü.</para>
  <para style="q" vid="JER 49:16">Gama lumoun íbini ánhabu adüga bumasa ítara iñun kei ágila,</para>
  <para style="q" vid="JER 49:16">narariragüdübadibu ñéingiñe.</para>
  <para style="q" vid="JER 49:16">Au, le Aburemei ariñagubalin».<verse eid="JER 49:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="JER 49:17" />—Hanarimebei lueirin lagünrinchagun Edomu, darime lun líchugun anufudei. Sunme ha ásügürütiña ñéingiñe hanufudedaguba lau labeichún, <verse eid="JER 49:17" /><verse number="18" style="v" sid="JER 49:18" />lerederuba kei Sodoma luma Gomora luma burí líbiri uburugu le lubadubei, dan le meha lagünrinchawagunbei. Maganóundigiaali ni aban ñein, másügürünwame ñéingiñe. Au, le Aburemei ariñagubalin. <verse eid="JER 49:18" /><verse number="19" style="v" sid="JER 49:19" />Niábinba sódini kei aban liñún le áfuriduti lídangiñe búbugati le lani Hordán, lidoun fulasu le ñein lumuti sagadi hilumati súnwandan, ábame nanuragüdüniña lílana Edomu ñéingiñe, ábame nagumadihagüdüni le nasuesihan ñein. Ladüga, kábagia ítara kei au? Kábagia óuchagua lungua numa? Ka hóuniri mudún gayaraabei lagagibudagun numa? <verse eid="JER 49:19" /><verse number="20" style="v" sid="JER 49:20" />Aganba huméi le naransehabei, au le Aburemei kóntüra Edomu hama lílana Temán: Íbini mudún ha ñǘbüritimabaña, hanügǘba, lagünrinchawaguba giñe burí fulasu wǘbüguati. <verse eid="JER 49:20" /><verse number="21" style="v" sid="JER 49:21" />Hanarimebei liréin lábürühan Edomu, darime lun lánhingichun múa. Hagúarahaba amuriaha ídemuei, ábame laganbún hagúarahan chülǘ Barana funati. <verse eid="JER 49:21" /><verse number="22" style="v" sid="JER 49:22" />Lábürühaba ágani luagun Bosurá kei aban ágila lau tarüna tuleñu luagun tíliru, wéyume ligía, hadadagaruba wuriburuguna Edomuna kei würi agaridutu.<verse eid="JER 49:22" /></para>
  <para style="s1">Lasiadirún Damasüku</para>
  <para style="q">
    <verse number="23" style="v" sid="JER 49:23" />Anihán ñunsu libügürü Damasüku:</para>
  <para style="b" vid="JER 49:23" />
  <para style="q" vid="JER 49:23">«Lauñein busiganu uburugu Amatü luma Arüpádü,</para>
  <para style="q" vid="JER 49:23">ladüga chülüha uganu wuribati lun.</para>
  <para style="q" vid="JER 49:23">Buin liña lau anufudei, siñati darangilu lan.<verse eid="JER 49:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 49:24" />Méreeli Damasüku, laransehagubei lun lanurahan.</para>
  <para style="q" vid="JER 49:24">Gamanihariha anufudei luma íruni lau,</para>
  <para style="q" vid="JER 49:24">kei aban würi to agaridutu.<verse eid="JER 49:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 49:25" />Uburugu le meha aganbahóuabei luagu,</para>
  <para style="q" vid="JER 49:25">uburugu le meha gúndaabei, igirúa.<verse eid="JER 49:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 49:26" />Lídanme weyu ligía, herederuba lirahüñü,</para>
  <para style="q" vid="JER 49:26">ha nibureinhañabaña riwagu múarugu ǘmadarugu,</para>
  <para style="q" vid="JER 49:26">ani hóunweguba sun wuriburuguna ha lílana.</para>
  <para style="q" vid="JER 49:26">Au, le Aburemei Suntigabafu ariñagubalin.<verse eid="JER 49:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JER 49:27" />Nágudubei lubarieirun burí Damasüku,</para>
  <para style="q" vid="JER 49:27">lagünrinchagubon giñe watu gemeti ligía</para>
  <para style="q" vid="JER 49:27">lani burí Ben-adadü palasiu».<verse eid="JER 49:27" /></para>
  <para style="s1">Lasiadirún Kedarü luma Asoru</para>
  <para style="p">
    <verse number="28" style="v" sid="JER 49:28" />Anihán ñunsu lúmagiñe Aburemei habügürü lani Kedarü türibu hama ábutigu Asoruna, ha lagañeirubaña Nabukodonosoru le lurúeite Babilónia:</para>
  <para style="b" vid="JER 49:28" />
  <para style="q" vid="JER 49:28">«Sará humá, hageindagua luma Kedarü!</para>
  <para style="q" vid="JER 49:28">Günringua humaña türibu ha luéigiñebaña labouchagüle weyu.<verse eid="JER 49:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 49:29" />Barǘ humaña halügüniña kameyu hawéi,</para>
  <para style="q" vid="JER 49:29">ariñaga humá houn:</para>
  <para style="q" vid="JER 49:29">“Anihein lanarime anufudei lidan sun fulasu!”<verse eid="JER 49:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 49:30" />Furí humá éibaagueina lílana Asoru!</para>
  <para style="q" vid="JER 49:30">Heiba aramudagua!</para>
  <para style="q" vid="JER 49:30">Au, le Aburemei ariñagubalin.</para>
  <para style="q" vid="JER 49:30">Ladüga aransehali Nabukodonosoru</para>
  <para style="q" vid="JER 49:30">le lurúeite Babilónia kóntüra huguya.<verse eid="JER 49:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JER 49:31" />Au, le Aburemei, nariñaguña hun:</para>
  <para style="q" vid="JER 49:31">Sará humá, hageindagua hama gürigia ha,</para>
  <para style="q" vid="JER 49:31">ha abagaridubaña hemenigiñu,</para>
  <para style="q" vid="JER 49:31">ani darangilañu, mebenariga ani hábugua!<verse eid="JER 49:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JER 49:32" />Íweruha humaña halügüniña kameyu hawéi</para>
  <para style="q" vid="JER 49:32">hama sun habiñanigu!</para>
  <para style="q" vid="JER 49:32">Nabarachaguagüdaaña gürigia ha ásaragubalin hachügü,</para>
  <para style="q" vid="JER 49:32">nanügüba katei wuribati hawagun luéigiñe sun oubaü.</para>
  <para style="q" vid="JER 49:32">Au le Aburemei ariñagubalin.<verse eid="JER 49:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JER 49:33" />Lerederuba Asoru málouga lun súnwandan,</para>
  <para style="q" vid="JER 49:33">haganóuba ounli áraabuna ñein.</para>
  <para style="q" vid="JER 49:33">Au, le Aburemei ariñagubalin.</para>
  <para style="q" vid="JER 49:33">Úadigiaañame aganóutiña ñein,</para>
  <para style="q" vid="JER 49:33">ni íbini ásügürütiña merederagunbaña ñein».<verse eid="JER 49:33" /></para>
  <para style="s1">Lasiadirún Elamü</para>
  <para style="p">
    <verse number="34" style="v" sid="JER 49:34" />Dan lagumeserunbei Sedekíasi arúeiha Hudá, aba líchuguni Aburemei ñunsu le lun Heremíasi libügürü Elamü:<verse eid="JER 49:34" /></para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" sid="JER 49:35" />«Nariñahare au le Aburemei Suntigabafu:</para>
  <para style="q" vid="JER 49:35">Náhalachaguboun ligimaran Elamü to meni lárumate.<verse eid="JER 49:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="JER 49:36" />Nanügüba garabali hawagun gürigia ha</para>
  <para style="q" vid="JER 49:36">lídangiñe gádürügubei oubaü,</para>
  <para style="q" vid="JER 49:36">lun lachagaraguniña lidoun sun fulasu,</para>
  <para style="q" vid="JER 49:36">darime lun úaali lan ageiraü le ñeinhin lumuti machülü hamá aramudagua.<verse eid="JER 49:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="JER 49:37" />Nadadagaragüdübei Elamü hagibugiñe láganiñu,</para>
  <para style="q" vid="JER 49:37">nóunahaba wuribani luagun,</para>
  <para style="q" vid="JER 49:37">Nóunahabei nigañi luagun,</para>
  <para style="q" vid="JER 49:37">nóunahaba wuribu luagun darí lagünrinchagun sunsuinagubei.</para>
  <para style="q" vid="JER 49:37">Au, le Aburemei ariñagubalin.<verse eid="JER 49:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="JER 49:38" />Níchugubei lálana narúeihan Elamü,</para>
  <para style="q" vid="JER 49:38">Nadügüba lun hóunwegun lurúeitegu hama lábutigu.</para>
  <para style="q" vid="JER 49:38">Au, le Aburemei ariñagubalin.<verse eid="JER 49:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="JER 49:39" />Gama lumoun nasansirubei lubunurun Elamü.</para>
  <para style="q" vid="JER 49:39">Au, le Aburemei ariñagubalin».<verse eid="JER 49:39" /></para>
  <chapter eid="JER 49" />
  <chapter number="50" style="c" sid="JER 50" />
  <para style="s1">Lábürühan Babilónia</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 50:1" />Anihán ñunsu le lariñagagüdübei Aburemei lun profeta Heremíasi libügürü Babilónia, hageira Kalüdéana:<verse eid="JER 50:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JER 50:2" />«Apurichiha huméi katei le,</para>
  <para style="q" vid="JER 50:2">subudigüda huméi hadan néchanigu,</para>
  <para style="q" vid="JER 50:2">tulé huméi fanidira;</para>
  <para style="q" vid="JER 50:2">maramuda humá ni kata.</para>
  <para style="q" vid="JER 50:2">Ariñaga humá:</para>
  <para style="q" vid="JER 50:2">“Ragüwa Babilónia!</para>
  <para style="q" vid="JER 50:2">Rédeiha bungiu Beli lau busiganu,</para>
  <para style="q" vid="JER 50:2">Buinha bungiu Marüdúku lau anufudei!</para>
  <para style="q" vid="JER 50:2">Rédeiha habungiutegu lau busiganu luma anufudei!”<verse eid="JER 50:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 50:3" />Ladüga anitén aban néchani hawagun nóruterugugiñe</para>
  <para style="q" vid="JER 50:3">le lunbei lígiruni hageira kei aban fulasu le mageirawati.</para>
  <para style="q" vid="JER 50:3">Úaañame aganóutiña ñein,</para>
  <para style="q" vid="JER 50:3">ni gürigia ni animaalugu, hanurahaba súngubei».<verse eid="JER 50:3" /></para>
  <para style="s1">Hagiribudun Ísüraelina</para>
  <para style="p">
    <verse number="4" style="v" sid="JER 50:4" />Lariñahare Aburemei:</para>
  <para style="p" vid="JER 50:4">—Lídanme dan ligía, hayabinba lánigu Ísüraeli hama lánigu Hudá ayahuaheina áluahana, au, Aburemei le Habungiute. <verse eid="JER 50:4" /><verse number="5" style="v" sid="JER 50:5" />Hálügüdahaba luagu lémeri Sión, ábame houdin ñeinhin ariñageina: “Keimoun lumoun Aburemei, óundaragua wamá luma lidan aban daradu magumuchaditi, le mabulieidúati”.<verse eid="JER 50:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 50:6" />—Ítara haña meha numutuniña kei mudún féridihaña, ha mabuidunti hadundehaniña hóuniri, aba hígiruniña lun heferidirun, lun houdin luéigiñe aban wübü lun luagun amu, darí lun habulieiduni hafarügan. <verse eid="JER 50:6" /><verse number="7" style="v" sid="JER 50:7" />Dántiha le hadariruniña háganiñu, aba héiginiña, hariñagatiha: “Mama wagía gadurunbei luagu hafigouhan kóntüra Aburemei, le íchugubei ibagari houn, hemenigin hagüchagu”.<verse eid="JER 50:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="JER 50:8" />«Hanuraha Babilóniagiñe, hageiragiñe Kalüdéana!</para>
  <para style="q" vid="JER 50:8">Furí humá kei adundehatiña mudún habá habá mudún!<verse eid="JER 50:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 50:9" />So nadüga lun hóundaragun saragu</para>
  <para style="q" vid="JER 50:9">ageiraü ha nóruteruguna ha gabafutiña</para>
  <para style="q" vid="JER 50:9">lun hábürühan lidan aban luagun Babilónia.</para>
  <para style="q" vid="JER 50:9">Hafileihaba lau ábame hárügüdüni.</para>
  <para style="q" vid="JER 50:9">Wuriburuguna buítiña hagía,</para>
  <para style="q" vid="JER 50:9">dan le hachüürünu hagimaran, macharatiña.<verse eid="JER 50:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 50:10" />Hasagarahabaña Kalüdéana,</para>
  <para style="q" vid="JER 50:10">hasagarahabaña darime habuinchagun.</para>
  <para style="q" vid="JER 50:10">Au, le Aburemei ariñagubalin.<verse eid="JER 50:10" /></para>
  <para style="s1">Lábürühan Babilónia</para>
  <para style="p">
    <verse number="11" style="v" sid="JER 50:11" />«Huguya Kalüdéana,</para>
  <para style="q" vid="JER 50:11">ha buga asagarahabaliña numutuniña,</para>
  <para style="q" vid="JER 50:11">Ru humá ugundani húniwagua!</para>
  <para style="q" vid="JER 50:11">Hachubaha kei aban tiraüraü bágasu sagadirugu!</para>
  <para style="q" vid="JER 50:11">Hachubaahóua kei gabayu!<verse eid="JER 50:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 50:12" />Gama lumoun hageira, luma huburugute</para>
  <para style="q" vid="JER 50:12">lerederuba buin lau busiganu.</para>
  <para style="q" vid="JER 50:12">Ligíaba árigili hadan sun néchanigu,</para>
  <para style="q" vid="JER 50:12">ábanbei fulasu mageirawati le mábeiti ani maganóunwabei ñein.<verse eid="JER 50:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 50:13" />Lugundun nagañiduba,</para>
  <para style="q" vid="JER 50:13">ábame nígiruni súngubei málouga,</para>
  <para style="q" vid="JER 50:13">kei aban fulasu mageirawati.</para>
  <para style="q" vid="JER 50:13">Hanufudedaguba sun ha ásügürütiña ñéingiñe</para>
  <para style="q" vid="JER 50:13">lau harihini abeichúni le libihubei.<verse eid="JER 50:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="JER 50:14" />«Ragǘ huméi hubara achüühatiña gimara,</para>
  <para style="q" vid="JER 50:14">geyegua huméi Babilónia!</para>
  <para style="q" vid="JER 50:14">Chü humoun sun higimaran luagun,</para>
  <para style="q" vid="JER 50:14">ladüga lafigouhan kóntüra au, le Aburemei.<verse eid="JER 50:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 50:15" />Hagúaraha le lánina wuribu luéigiñe sun oubaü!</para>
  <para style="q" vid="JER 50:15">Lederegeragua Babilónia lungua!</para>
  <para style="q" vid="JER 50:15">Héiguouga wáyelesi, gulúagua baríeiru!</para>
  <para style="q" vid="JER 50:15">Anihán náguyugüdüni le hadügübei:</para>
  <para style="q" vid="JER 50:15">Fáyeigüda huméi luagu ladüga.</para>
  <para style="q" vid="JER 50:15">Adüga humá lun keimeme le ladügübei!<verse eid="JER 50:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 50:16" />Mígira humá ni aban Babilónia</para>
  <para style="q" vid="JER 50:16">le lunti lábunagun o le lunti lalubahan.</para>
  <para style="q" vid="JER 50:16">Danme harihini terencha wuribu gagünrinchaguaditi,</para>
  <para style="q" vid="JER 50:16">ábame hagiribudun hageiroun, kada aban anuraheina».<verse eid="JER 50:16" /></para>
  <para style="s1">Lagiribudun Ísüraeli</para>
  <para style="p">
    <verse number="17" style="v" sid="JER 50:17" />—Ítara liña Ísüraeli kei aban mudún féridiharu to héibaahan liñún. Furumiñe, aba léigini lurúeite Asiria; lárigiñe, aba láhiachuni Nabukodonosoru le lurúeite Babilónia labu. <verse eid="JER 50:17" /><verse number="18" style="v" sid="JER 50:18" />Ligía nariñagunbei, au, le Aburemei Suntigabafu, le Lubungiute Ísüraeli: Nabeichubei lurúeite Babilónia lau sun lageira kei nadüga lun lurúeite Asiria. <verse eid="JER 50:18" /><verse number="19" style="v" sid="JER 50:19" />Nagiribudagüdübei Ísüraeli lageiroun, ani kei aban mudún, ladariruba saragu sagadi luagu wübü Karümélu, Basán, luma lidan burí dabíara-agei le lani Éfürain luma Galaadü. <verse eid="JER 50:19" /><verse number="20" style="v" sid="JER 50:20" />Au le Aburemei ariñagubalin. Lídanme dan ligía, madurunhalime Ísüraeli luma Hudá, mafigoun ligíame, lugundun feruduna nubaña ha lúnbaña nígiruniña wínwanñu.<verse eid="JER 50:20" /></para>
  <para style="s1">Leferidirun Babilónia</para>
  <para style="q">
    <verse number="21" style="v" sid="JER 50:21" />«Ábürüha humá luagun lumúan Merataímü</para>
  <para style="q" vid="JER 50:21">luma hawagun lílana Pekodu!</para>
  <para style="q" vid="JER 50:21">Éibaaha humaña, günringua humaña sunsuinagubei!</para>
  <para style="q" vid="JER 50:21">Gúnfuli huméi sun le nariñagubei hun!</para>
  <para style="q" vid="JER 50:21">Au, le Aburemei íchugubalin lúrudu lun ladügǘn».<verse eid="JER 50:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="JER 50:22" />Aganbúati lamuri wuribu fulasurugu,</para>
  <para style="q" vid="JER 50:22">le lánina óunwenbu günringuaü.<verse eid="JER 50:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 50:23" />Halagua Babilónia, le lumarüdiyun sun ubóu!</para>
  <para style="q" vid="JER 50:23">Ma lanarime anufudei hasandirun néchanigu lau</para>
  <para style="q" vid="JER 50:23">harihini le asuseredubei lun Babilónia!<verse eid="JER 50:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 50:24" />Babilónia, buguya guánarügü esetirubei sádara bubarua,</para>
  <para style="q" vid="JER 50:24">aba bábürühan tidoun ibidiñounga bun.</para>
  <para style="q" vid="JER 50:24">Aba berederun adaürǘwa ñein siñauga báfuridun ñéingiñe</para>
  <para style="q" vid="JER 50:24">ladüga bebedaagun lun Aburemei.<verse eid="JER 50:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 50:25" />Darala Aburemei tagei lárumate,</para>
  <para style="q" vid="JER 50:25">aba lasagarunu lárumate ligañi,</para>
  <para style="q" vid="JER 50:25">ladüga anihein aban dasi lun ladügüni Aburemei Suntigabafu</para>
  <para style="q" vid="JER 50:25">lidan hageira Kalüdéana.<verse eid="JER 50:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 50:26" />Ábürüha humá luagun lídangiñe sun oubaü!</para>
  <para style="q" vid="JER 50:26">Dará humóun lagei leigin!</para>
  <para style="q" vid="JER 50:26">Günringua huméi!</para>
  <para style="q" vid="JER 50:26">Merederalá ni aban wínwanñu.<verse eid="JER 50:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JER 50:27" />Áfaragua humaña sun lisudaranigu!</para>
  <para style="q" vid="JER 50:27">Fugiabugu hagía!</para>
  <para style="q" vid="JER 50:27">Chülüha haweyuri,</para>
  <para style="q" vid="JER 50:27">luma lóurate habeichún!<verse eid="JER 50:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="JER 50:28" />(Hamalali ha anurahabaña Babilóniagiñe lun uburugun Sión abahüdaguei luáguti labeichuni Bungiu Babilónia luagu le ladügübei tau ténpulu.)<verse eid="JER 50:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="JER 50:29" />«Wa humá houn sun achüühatiña gimara,</para>
  <para style="q" vid="JER 50:29">lun hayabin ageindagua luma Babilónia!</para>
  <para style="q" vid="JER 50:29">Geyegua huméi uburugu ua láamuga ni aban esefuruti!</para>
  <para style="q" vid="JER 50:29">Fayei huméi keisi ladüna!</para>
  <para style="q" vid="JER 50:29">Adüga humá lun kei ladüga!</para>
  <para style="q" vid="JER 50:29">Ladüga liñuragun lungua nuagun,</para>
  <para style="q" vid="JER 50:29">au, le Aburemei le Sándubei,</para>
  <para style="q" vid="JER 50:29">le Lubungiute Ísüraeli.<verse eid="JER 50:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 50:30" />Ligía hábürühaba lubéi lílana</para>
  <para style="q" vid="JER 50:30">ha nibureinhaña lau óunweni ǘmadarugu,</para>
  <para style="q" vid="JER 50:30">hilagua hagíame sun lánigu ha wuriburuguna lidan weyu ligía».<verse eid="JER 50:30" /></para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" sid="JER 50:31" />Lariñahare Aburemei Suntigabafu:</para>
  <para style="q" vid="JER 50:31">«Gürigia barügua tungua, kóntürañadina huagu;</para>
  <para style="q" vid="JER 50:31">chülüha huéyuri, lóurate habeichún.<verse eid="JER 50:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JER 50:32" />Hachugeraguba ábame héiguadun,</para>
  <para style="q" vid="JER 50:32">úabei kaba lan iñuraguaün.</para>
  <para style="q" vid="JER 50:32">Nébedubei sun burí huburugute,</para>
  <para style="q" vid="JER 50:32">ábame lágudun sun geyegua hau».<verse eid="JER 50:32" /></para>
  <para style="b" />
  <para style="p">
    <verse number="33" style="v" sid="JER 50:33" />Lariñahare Aburemei Suntigabafu: «Hasufuriruña lánigu Ísüraeli hama lánigu Hudá lidere dan. Daü hamá háganiñu ani máhatiña hígiragüdüniña. <verse eid="JER 50:33" /><verse number="34" style="v" sid="JER 50:34" />Gama lumoun héreti hesefuragüle, ani Aburemei Suntigabafu líribei. Ligíaba ariha lun líchuguni haricha houn, lanügüba darangilaü lun fulasu luma lanarime anufudei houn lílana Babilónia».<verse eid="JER 50:34" /></para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" sid="JER 50:35" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 50:35">«Wuribu kóntüra Babilónia hau sun lílana!</para>
  <para style="q" vid="JER 50:35">Kóntüra lábutigu hama chu taugu ha ñéinbaña!<verse eid="JER 50:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="JER 50:36" />Wuribu kóntüra ha garíaahadibaña ñein: lun lálülüdün hau!<verse eid="JER 50:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="JER 50:37" />Wuribu kóntüra lisudaranigu:</para>
  <para style="q" vid="JER 50:37">Lun hadadagarun lau anufudei!</para>
  <para style="q" vid="JER 50:37">Wuribu kóntüra hagabayun tuma hakarün!</para>
  <para style="q" vid="JER 50:37">Wuribu kóntüra lisudaranigu ha terencha:</para>
  <para style="q" vid="JER 50:37">Lun hítaradun kei würiña!</para>
  <para style="q" vid="JER 50:37">Wuribu kóntüra harisin:</para>
  <para style="q" vid="JER 50:37">Lun líweruhoun hawéi!<verse eid="JER 50:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="JER 50:38" />Wuribu kóntüra hadunari éibaaguati:</para>
  <para style="q" vid="JER 50:38">Lun lamabeidun.</para>
  <para style="q" vid="JER 50:38">Ladüga hageira hagübüri burí guáriuagu Babilónia, lǘlügüdaaña lau.<verse eid="JER 50:38" /></para>
  <para style="b" />
  <para style="p">
    <verse number="39" style="v" sid="JER 50:39" />—Ligía hadügüba lubéi mesu áraabuna, ounli áraabuna hama awesüturusu hábiñe Babilónia. Maganóundigiaañame gürigia ñein. <verse eid="JER 50:39" /><verse number="40" style="v" sid="JER 50:40" />Lerederuba kei Sodoma luma Gomora luma burí uburugu le lubadubei, dan le lagünrinchawagunbei. Maganóunhañame gürigia ñein, ni íbini lun herederagun ñein. Au, le Aburemei ariñagubalin.<verse eid="JER 50:40" /></para>
  <para style="b" />
  <para style="q">
    <verse number="41" style="v" sid="JER 50:41" />«Laranseruña aban néchani héreti hama saragu urúeigu</para>
  <para style="q" vid="JER 50:41">lun hayabin lídangiñe fulasu díseti luéigiñe nórute.<verse eid="JER 50:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="JER 50:42" />Barütiña gimara tuma eféin, hanarimetiña, magudemehábutiña,</para>
  <para style="q" vid="JER 50:42">ítara liña hagúarahan kei liréin barana,</para>
  <para style="q" vid="JER 50:42">wariñu haña hawagu gabayu.</para>
  <para style="q" vid="JER 50:42">Aransetiña lun wuribu kóntüra Babilónia.<verse eid="JER 50:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="JER 50:43" />Rédeihali lurúeite Babilónia deregüdagu</para>
  <para style="q" vid="JER 50:43">lau anufudei lau laganbuni uganu le,</para>
  <para style="q" vid="JER 50:43">sanditi íruni luma gáriti kei aban würi agaridutu».<verse eid="JER 50:43" /></para>
  <para style="b" />
  <para style="p">
    <verse number="44" style="v" sid="JER 50:44" />—Niábinba sódini kei aban liñún le áfuriduti dabíararugugiñe laru Hordán lun lidoun fulasu le ñein lumuti sagadi hilumati súnwandan, ábame nanuragüdüniña Babilóniana ñéingiñe, ábame níchuguni le nabusenrun lun lagumadihan. Lugundun Kagia ítarabei kei au? Ka gayaraabei lageindagun numa? Ka hóuniri mudún gayaraabei lagagibudagun numa? <verse eid="JER 50:44" /><verse number="45" style="v" sid="JER 50:45" />Aganba huméi le naransehabei kóntüra Babilónia; kóntüra hageira Kalüdéana au le Aburemei: Íbini harahüñü mudún ha ñǘbüritimabaña, hanügǘba, hanufudeduba ha aganbutiña ayanuha luagu. <verse eid="JER 50:45" /><verse number="46" style="v" sid="JER 50:46" />Hanarimebei liréin lábürühan Babilónia, darime lun lánhingichun múa, ábame laganbún hagúarahan lidoun burí líbiri néchani.<verse eid="JER 50:46" /></para>
  <chapter eid="JER 50" />
  <chapter number="51" style="c" sid="JER 51" />
  <para style="s1">Lagünrinchawaguniwa Babilónia</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 51:1" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 51:1">«Nóunaha aban garabali le gagünrinchaguaditi</para>
  <para style="q" vid="JER 51:1">luagun Babilónia hama Kalüdéana.<verse eid="JER 51:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 51:2" />Nadügüba lun hóuseruni áganiñu Babilónia</para>
  <para style="q" vid="JER 51:2">kei türigu le achüürǘti garabalirugun;</para>
  <para style="q" vid="JER 51:2">nadügüba lun hígiruni lumúan úouga aganóutiña ñein.</para>
  <para style="q" vid="JER 51:2">Danme lachülürün luéyuri lamiselu,</para>
  <para style="q" vid="JER 51:2">hábürühaba luagun lídangiñe sun oubaü.<verse eid="JER 51:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 51:3" />Seti hamóun achüühatiña gimara hagimaran!</para>
  <para style="q" vid="JER 51:3">Daü hamóun hadaüragun to lánina wuribu!</para>
  <para style="q" vid="JER 51:3">Magudemehabu humá houn nibureinhaña ha Babilóniana;</para>
  <para style="q" vid="JER 51:3">günringua humaña hasudaranigu sunsuinagubei!<verse eid="JER 51:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 51:4" />Lidan sun hageira Kalüdéana,</para>
  <para style="q" vid="JER 51:4">herederuba gürigia riwagu múarugu ǘmada,<verse eid="JER 51:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 51:5" />lugundun lau sun afigouhaali lan Ísüraeli</para>
  <para style="q" vid="JER 51:5">luma Hudá nigibugiñe,</para>
  <para style="q" vid="JER 51:5">buíngüda haméi hageira lau figóu,</para>
  <para style="q" vid="JER 51:5">au, le Aburemei Suntigabafu,</para>
  <para style="q" vid="JER 51:5">le Lubungiute Ísüraeli, mágurun nágiña.<verse eid="JER 51:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="JER 51:6" />«Hanuraha Babilóniagiñe!</para>
  <para style="q" vid="JER 51:6">Sefulá le gayaraati!</para>
  <para style="q" vid="JER 51:6">Móunwegua humá luéigiñe lifigoun Babilónia!</para>
  <para style="q" vid="JER 51:6">Anihán lóurate nafayeiragüdüniña luagu le ladügübei,</para>
  <para style="q" vid="JER 51:6">ani nafayeirubei kei ladüna!<verse eid="JER 51:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 51:7" />Aban meha weru lauti golu Babilónia núhaburugu,</para>
  <para style="q" vid="JER 51:7">le abacharuadagüdütiña sun lílana ubóu.</para>
  <para style="q" vid="JER 51:7">Guratiña meha néchanigu tídangiñe diwéin tuguya,</para>
  <para style="q" vid="JER 51:7">aba heferidiruni hachügü.<verse eid="JER 51:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 51:8" />Gama lumoun sódini,</para>
  <para style="q" vid="JER 51:8">aba lábürühan Babilónia aba lañaünrüdagun.</para>
  <para style="q" vid="JER 51:8">Hayahuaha luagu!</para>
  <para style="q" vid="JER 51:8">Barǘ humá árani lun liwounun anhein areidagua».<verse eid="JER 51:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="JER 51:9" />Agaranihaadiwa lun Babilónia,</para>
  <para style="q" vid="JER 51:9">gama lumoun mareidagunti.</para>
  <para style="q" vid="JER 51:9">Ígira huméi keimoun yáagiñe,</para>
  <para style="q" vid="JER 51:9">kada aban lageiroun,</para>
  <para style="q" vid="JER 51:9">ladüga chülüha luriban Babilónia sielun,</para>
  <para style="q" vid="JER 51:9">iñuraguati dúerirugun.<verse eid="JER 51:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="JER 51:10" />Gáñeigüda lumuti Aburemei waricha.</para>
  <para style="q" vid="JER 51:10">Higougu, keimoun Sión,</para>
  <para style="q" vid="JER 51:10">abahüdaguei le ladügübei Aburemei le Wabungiute.<verse eid="JER 51:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 51:11" />Busenti Aburemei lagünrinchaguni Babilónia,</para>
  <para style="q" vid="JER 51:11">ani agaguda laali giñe káteimeme le hadan lurúeitegu Media.</para>
  <para style="q" vid="JER 51:11">Lafayeiragüdün Aburemei le,</para>
  <para style="q" vid="JER 51:11">luagu le hadügübei tun litenpulun.</para>
  <para style="q" vid="JER 51:11">Seti humóun gimara! Ragǘ huméi hidaüdina!<verse eid="JER 51:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 51:12" />Iñura huméi fanidira le liseinin lábürühoun</para>
  <para style="q" vid="JER 51:12">luagun lubarieirun Babilónia!</para>
  <para style="q" vid="JER 51:12">Ru humá hanwoun óunigihatiña!</para>
  <para style="q" vid="JER 51:12">Ru humá aríaahatiña!</para>
  <para style="q" vid="JER 51:12">Seti humá sádara!</para>
  <para style="b" vid="JER 51:12" />
  <para style="q" vid="JER 51:12">Ladüga aransehali Aburemei,</para>
  <para style="q" vid="JER 51:12">ani ladügüñein sun buga le leledegubei ladügün</para>
  <para style="q" vid="JER 51:12">kóntüra lílana Babilónia.<verse eid="JER 51:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 51:13" />Buguya Babilónia,</para>
  <para style="q" vid="JER 51:13">le lubadubei óunwenbu burí duna éibaaguati,</para>
  <para style="q" vid="JER 51:13">ani anihein burí irisini wéinamuti buma,</para>
  <para style="q" vid="JER 51:13">chülüha lagumuchun bidaani!<verse eid="JER 51:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 51:14" />Fiñuhali Aburemei Suntigabafu luagu libagari,</para>
  <para style="q" vid="JER 51:14">ariñageina:</para>
  <para style="q" vid="JER 51:14">«Labuinchagüdübadibu hau áganiñu kei chagagaru,</para>
  <para style="q" vid="JER 51:14">ábame hagañeirunibu wuriburugu».<verse eid="JER 51:14" /></para>
  <para style="s1">Uremu lánina lalawahóuniwa Bungiu</para>
  <para style="r">(<ref loc="JER 10:12-16">Her 10.12-16</ref>)</para>
  <para style="q">
    <verse number="15" style="v" sid="JER 51:15" />Aburemei adügübalin múa lau lubafu;</para>
  <para style="q" vid="JER 51:15">derebugugüdalei ubóu lau lichú lau;</para>
  <para style="q" vid="JER 51:15">tulegualéi sielu lau lualin lichügü.<verse eid="JER 51:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 51:16" />Lau lumalali le ítarabei kei wayuhuru,</para>
  <para style="q" vid="JER 51:16">ahuuhagüda lumuti duna sielu,</para>
  <para style="q" vid="JER 51:16">warigüda lumuti dúeri lígirugugiñe ubóu,</para>
  <para style="q" vid="JER 51:16">durunguagüda lumuti labirihaniga labadinagua huya,</para>
  <para style="q" vid="JER 51:16">sagá lumuti garabali le ñéingiñe lubéi lareidei.<verse eid="JER 51:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 51:17" />Ibidiouguati hau sun wügüriña,</para>
  <para style="q" vid="JER 51:17">nibusigarigüda hamuti guáriuagu le adügübaliña:</para>
  <para style="q" vid="JER 51:17">Iyawaü ha iyeenitiña guáriuagu, ani mabagaritiña;<verse eid="JER 51:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 51:18" />kátaña mebegitiña guáriuagu, nibusigaridünatiña,</para>
  <para style="q" vid="JER 51:18">lagünrinchagubaña Aburemei danme laguseragüdün.<verse eid="JER 51:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 51:19" />Mítaranti Lubungiute Hakobu kei guáriuagu hagía,</para>
  <para style="q" vid="JER 51:19">Lubungiute Hakobu adügübalin sun le aniheinbei!</para>
  <para style="q" vid="JER 51:19">Anúadira lumuti Ísüraeli keisi lumegen.</para>
  <para style="q" vid="JER 51:19">Aburemei Suntigabafu líribei.<verse eid="JER 51:19" /></para>
  <para style="s1">Babilónia labeihagüle Wabureme</para>
  <para style="q">
    <verse number="20" style="v" sid="JER 51:20" />«Babilónia, buguya numalinbei,</para>
  <para style="q" vid="JER 51:20">nárumate lánina wuribu!</para>
  <para style="q" vid="JER 51:20">Bau, nagünrinchagua néchanigu luma agumadihani.<verse eid="JER 51:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 51:21" />Bau, günringuatina gabayu habu ha wariñubaña hanagan,</para>
  <para style="q" vid="JER 51:21">karü habu ha abugahabarun.<verse eid="JER 51:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 51:22" />Bau, günringuatina wügüriña hama würiña,</para>
  <para style="q" vid="JER 51:22">wéiyaaña mutu hama ñǘbürigiña,</para>
  <para style="q" vid="JER 51:22">wügüriña nibureinhaña hama würiña nibureinhaña.<verse eid="JER 51:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 51:23" />Bau, günringuatina hóuniri mudún hau sun mudún,</para>
  <para style="q" vid="JER 51:23">ábunagutiña múa hama bulu bágasu ha lánina bunaguaü,</para>
  <para style="q" vid="JER 51:23">gumadimatiña hama lánigu urúei.<verse eid="JER 51:23" /></para>
  <para style="s1">Labeichúniwa Babilónia</para>
  <para style="q">
    <verse number="24" style="v" sid="JER 51:24" />«Gama lumoun nafayeirubei Babilónia hama sun Kalüdéana</para>
  <para style="q" vid="JER 51:24">keisi hadüna ligibugiñe hagu sun huguya,</para>
  <para style="q" vid="JER 51:24">luagu le hadügübei lun Sión.</para>
  <para style="q" vid="JER 51:24">Au, le Aburemei ariñagubalin.<verse eid="JER 51:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 51:25" />Kóntürañadina buagu,</para>
  <para style="q" vid="JER 51:25">buguya wübü gagünrinchaguaditi,</para>
  <para style="q" vid="JER 51:25">buguya le agünrinchagubalin sun múa.</para>
  <para style="q" vid="JER 51:25">Au, le Aburemei ariñagubalin.</para>
  <para style="q" vid="JER 51:25">Niñurubei núhabu lun nabeichunibu,</para>
  <para style="q" vid="JER 51:25">Nabalabaagüdübadibu luéigiñe dübü,</para>
  <para style="q" vid="JER 51:25">nadügübadibu ábanme wübü gudaali.<verse eid="JER 51:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 51:26" />Meseriwidunbei ni aban dübü le erederubei bárigirugu</para>
  <para style="q" vid="JER 51:26">lun tábunawagun muna.</para>
  <para style="q" vid="JER 51:26">Ábanbadibu fulasu mageirawati lun sun dan.<verse eid="JER 51:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="JER 51:27" />«Ru huméi liseinin wuribu fulasurugu!</para>
  <para style="q" vid="JER 51:27">Win huméi fidu,</para>
  <para style="q" vid="JER 51:27">seti humaña gürigia lun hábürühan luagun Babilónia!</para>
  <para style="q" vid="JER 51:27">Óundaragua humaña lílana Ararátü,</para>
  <para style="q" vid="JER 51:27">Miní luma Ásükenasü lun hábürühan luagun!</para>
  <para style="q" vid="JER 51:27">Ru humá aban heneraali lun ladundehani wuribu!</para>
  <para style="q" vid="JER 51:27">Awansegüda humaña gabayu kei chagagaru gáñitiña!<verse eid="JER 51:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 51:28" />Seti humaña néchanigu lun hábürühan luagun;</para>
  <para style="q" vid="JER 51:28">seti humaña lurúeitegu Media hama lani gumadimatiña hama sun lánigu,</para>
  <para style="q" vid="JER 51:28">luma sun fulasu le lábugiñebei hagumadin».<verse eid="JER 51:28" /></para>
  <para style="b" />
  <para style="q">
    <verse number="29" style="v" sid="JER 51:29" />Adadagarati múa,</para>
  <para style="q" vid="JER 51:29">ladüga lagunfuliruñein Aburemei le aranseha láalibei lun ladügüni</para>
  <para style="q" vid="JER 51:29">Babilónia ábanme hanufunati fulasu mageirawati.<verse eid="JER 51:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 51:30" />Rédeiha hageindagun lisudaranigu Babilónia,</para>
  <para style="q" vid="JER 51:30">Rédeigua tidan muna to ñéingiñe lubéi hageindagua;</para>
  <para style="q" vid="JER 51:30">gumuha here, henegerügaaña würiña.</para>
  <para style="q" vid="JER 51:30">Ragüwa burí haburugute lau erei,</para>
  <para style="q" vid="JER 51:30">gudawa tuguya burí haban.<verse eid="JER 51:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JER 51:31" />Aban lárigi aban héibaagun láutiña uganu,</para>
  <para style="q" vid="JER 51:31">ariñaga lun lurúeite Babilónia</para>
  <para style="q" vid="JER 51:31">luagu ragüwa lan luburugute sunsuinagubei.<verse eid="JER 51:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JER 51:32" />Ragüla ágani lémeri burí duna le éibaaguati,</para>
  <para style="q" vid="JER 51:32">gudala burí fulasu le ñéingiñe lubéi hageindagua</para>
  <para style="q" vid="JER 51:32">aba habuinchun súdaragu lau anufudei.<verse eid="JER 51:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JER 51:33" />Ladüga lariñahare Aburemei Suntigabafu le Lubungiute Ísüraeli:</para>
  <para style="q" vid="JER 51:33">«Málübei anhein líbaagua ágani Babilónia,</para>
  <para style="q" vid="JER 51:33">ábame ladügüraguni kei türigu múarugu».<verse eid="JER 51:33" /></para>
  <para style="b" />
  <para style="q">
    <verse number="34-35" style="v" sid="JER 51:34-35" />Lariñahare Herusalén le luburugute Sión:</para>
  <para style="q" vid="JER 51:34-35">«Günringua lumutina Nabukodonosoru le lurúeite Babilónia, aba léiginina;</para>
  <para style="q" vid="JER 51:34-35">ígira lumutina kei aban asiedu málati.</para>
  <para style="q" vid="JER 51:34-35">Hulú lumutina kei aban mónsturu baranahana;</para>
  <para style="q" vid="JER 51:34-35">kimule ligía lau le hínsiñetimabei lun nídangiñe,</para>
  <para style="q" vid="JER 51:34-35">le líbiri aba láguruni.</para>
  <para style="q" vid="JER 51:34-35">Lafayeiha Babilónia luagu le ladügübei nun!</para>
  <para style="q" vid="JER 51:34-35">Hafayeiha Kalüdéana hawagu gürigia ha háfaragubaña nuéi!»<verse eid="JER 51:34-35" /></para>
  <para style="s1">Füramasei lun Ísüraeli</para>
  <para style="p">
    <verse number="36" style="v" sid="JER 51:36" />Lariñahare Aburemei:</para>
  <para style="q" vid="JER 51:36">«Níchugubei biricha bun,</para>
  <para style="q" vid="JER 51:36">nafayeiragüdübaña báganiñu luagu le hadügübei bun.</para>
  <para style="q" vid="JER 51:36">Namabeidagüdaali duna sunsuinagubei,</para>
  <para style="q" vid="JER 51:36">luma burí lísensen-agei lidunari Babilónia,<verse eid="JER 51:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="JER 51:37" />darime lun lerederun lárigirugu kei bugan ifei,</para>
  <para style="q" vid="JER 51:37">lerederuba hábiñeme animaalugu,</para>
  <para style="q" vid="JER 51:37">ábanbei fulasu le maganóunwati ñein,</para>
  <para style="q" vid="JER 51:37">hanufunabei houn sun gürigia.<verse eid="JER 51:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="JER 51:38" />Sun Babilóniana hadürürühaba kei liñún,</para>
  <para style="q" vid="JER 51:38">aünha hagíame kei harahüñü liñún.<verse eid="JER 51:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="JER 51:39" />Lídanme láguduniña lárouga,</para>
  <para style="q" vid="JER 51:39">ábame nátagüdüniña uniñein to gabacharuadagüdaatu</para>
  <para style="q" vid="JER 51:39">lun heferidiruni hachügü.</para>
  <para style="q" vid="JER 51:39">Ítara luba hábürühan lidoun arumuguni magumuchaditi</para>
  <para style="q" vid="JER 51:39">le ídangiñebei magagudunbaña lanme.</para>
  <para style="q" vid="JER 51:39">Au, le Aburemei ariñagubalin.<verse eid="JER 51:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="JER 51:40" />Lariñahare ábame nanügüniña</para>
  <para style="q" vid="JER 51:40">kei hanügǘn mudún hama gábara lun háfarawagun».<verse eid="JER 51:40" /></para>
  <para style="s1">Lábürühan Babilónia</para>
  <para style="q">
    <verse number="41" style="v" sid="JER 51:41" />Ábürüha Babilónia,</para>
  <para style="q" vid="JER 51:41">uburugu le wéiritimabei ladimurehoun ubouagu, heigua, gáñeiwa,</para>
  <para style="q" vid="JER 51:41">Aba hanufudedagun néchanigu dan le harihini!<verse eid="JER 51:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="JER 51:42" />Darugua barana lau Babilónia,</para>
  <para style="q" vid="JER 51:42">darugualá lau lanarime burí luéinamun lugudi.<verse eid="JER 51:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="JER 51:43" />Rédeiha burí luburugute kei lanarime fulasu mageirawati,</para>
  <para style="q" vid="JER 51:43">kei múa mábeiti le mábiñewati,</para>
  <para style="q" vid="JER 51:43">le ñein lubéi ua hamá aganóutiña,</para>
  <para style="q" vid="JER 51:43">le ñéingiñe lubéi másügürün lan ni aban.<verse eid="JER 51:43" /></para>
  <para style="b" />
  <para style="q">
    <verse number="44" style="v" sid="JER 51:44" />«Nabeichubei bungiu Beli Babilónia,</para>
  <para style="q" vid="JER 51:44">newerehagüdübei le hulú laalibei lun.</para>
  <para style="q" vid="JER 51:44">Miábindigiaañame néchanigu lumoun. Ábürüha burí lubarieirun Babilónia!<verse eid="JER 51:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="JER 51:45" />Furí humá ñéingiñe numutuniña,</para>
  <para style="q" vid="JER 51:45">sefuléi kada aban libagari luéi lanarime nigañi.<verse eid="JER 51:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="JER 51:46" />Máhüchüra humá, manufudeda humá</para>
  <para style="q" vid="JER 51:46">luagu le agülülühóubei fulasurugu.</para>
  <para style="q" vid="JER 51:46">Ámuñegueinarügübei agülülühóuti ságüme irumu,</para>
  <para style="q" vid="JER 51:46">agülülühóuni luáguti lanarimeniga fulasurugu,</para>
  <para style="q" vid="JER 51:46">luma awuribuhani haganagua agumadihatiña.<verse eid="JER 51:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="JER 51:47" />Lachülürüba lubeiti weyu</para>
  <para style="q" vid="JER 51:47">lun nabeichuniña liguariuan Babilónia.</para>
  <para style="q" vid="JER 51:47">Lerederuba sun Babilónia lau busiganu,</para>
  <para style="q" vid="JER 51:47">buin hau hilaaña.<verse eid="JER 51:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="JER 51:48" />Lagundaaruba sielu,</para>
  <para style="q" vid="JER 51:48">múa luma sun le aniheinbei,</para>
  <para style="q" vid="JER 51:48">danme lábürühan Babilónia,</para>
  <para style="q" vid="JER 51:48">danme hayabin ha lúnbaña hagünrinchaguni luéigiñe nórute.</para>
  <para style="q" vid="JER 51:48">Au, le Aburemei ariñagubalin.<verse eid="JER 51:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="JER 51:49" />Gasu lábürühan Babilónia luéigiñe áfarahani</para>
  <para style="q" vid="JER 51:49">burí le ladügübei houn lánigu Ísüraeli,</para>
  <para style="q" vid="JER 51:49">luma áfarahani le ladügübei lidan sun ubóu».<verse eid="JER 51:49" /></para>
  <para style="s1">Ñunsu houn huríu ha Babilóniabaña</para>
  <para style="q">
    <verse number="50" style="v" sid="JER 51:50" />Huguya ha esefurubaña luéi háfarawagun,</para>
  <para style="q" vid="JER 51:50">anuraha humá, mararamagua humá,</para>
  <para style="q" vid="JER 51:50">ani íbini danme díseedün samina humá luagun Aburemei,</para>
  <para style="q" vid="JER 51:50">haritagua huguyame luagun Herusalén.<verse eid="JER 51:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="JER 51:51" />Huguya, hariñahare:</para>
  <para style="q" vid="JER 51:51">«Sanditiwa busiganu dan le waganbun hanabuniwa.</para>
  <para style="q" vid="JER 51:51">Daruguati bulíeiguaü lau wagibu,</para>
  <para style="q" vid="JER 51:51">ladüga beluhaña gürigia terencha</para>
  <para style="q" vid="JER 51:51">chülǘ lidoun fulasu le sándutimabei tidan watenpulun».<verse eid="JER 51:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="JER 51:52" />Gama lumoun lariñahare Aburemei:</para>
  <para style="q" vid="JER 51:52">«Anitebei weyu lun nabeichuniña guáriuagu ha lubungiutegu Babilónia,</para>
  <para style="q" vid="JER 51:52">hamumehaba ha achugútiña lidan sun hamúan.<verse eid="JER 51:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="JER 51:53" />Íbini anhein iñuragua Babilónia dagá sielun</para>
  <para style="q" vid="JER 51:53">lun liñuruni lubarieirun,</para>
  <para style="q" vid="JER 51:53">nóunahaba áganiñu lárigi ñeinhin lun hagünrinchaguni.</para>
  <para style="q" vid="JER 51:53">Au, le Aburemei ariñagubalin».<verse eid="JER 51:53" /></para>
  <para style="s1">Lagünrinchawaguniwa Babilónia</para>
  <para style="q">
    <verse number="54" style="v" sid="JER 51:54" />Aganbúati agúarahani lauti igarigu Babilóniagiñe,</para>
  <para style="q" vid="JER 51:54">aganbúati aban óunwenbu areinchuni hageiragiñe Kalüdéana.<verse eid="JER 51:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="JER 51:55" />Lagünrinchaguñein Aburemei Babilónia,</para>
  <para style="q" vid="JER 51:55">lagumuchaguagüdüñein lareinchun.</para>
  <para style="q" vid="JER 51:55">Hábürühaba áganiñu luagun kei lugudi barana lidan lérouga,</para>
  <para style="q" vid="JER 51:55">hábürühaba luagun lau óunwenbu areinchuni.<verse eid="JER 51:55" /></para>
  <para style="q">
    <verse number="56" style="v" sid="JER 51:56" />Hayabiña agünrinchaguei Babilónia;</para>
  <para style="q" vid="JER 51:56">ragǘ hamaaña awuribuhatiña ha lánigu,</para>
  <para style="q" vid="JER 51:56">halagua hamá hagimaran.</para>
  <para style="q" vid="JER 51:56">Lugundun, le Waburemebei aban Bungiu ligía,</para>
  <para style="q" vid="JER 51:56">le íchugubalin le ladünabei kada aban lun.<verse eid="JER 51:56" /></para>
  <para style="q">
    <verse number="57" style="v" sid="JER 51:57" />Lariñahare Urúei, le Aburemei Suntigabafu:</para>
  <para style="q" vid="JER 51:57">«Nabacharuadagüdübaña ábutigu Babilónia, lánigu ha chúbaña aau,</para>
  <para style="q" vid="JER 51:57">gumadimatiña, awadigimaridutiña lidan arúeihani hama lisudaranigu,</para>
  <para style="q" vid="JER 51:57">ábame hábürühan lidoun aban arumuguni magumuchaditi,</para>
  <para style="q" vid="JER 51:57">másaarunhañame lídangiñe.<verse eid="JER 51:57" /></para>
  <para style="q">
    <verse number="58" style="v" sid="JER 51:58" />Nariñahare au, le Aburemei Suntigabafu:</para>
  <para style="q" vid="JER 51:58">Lidabuberen burí lubarieirun Babilónia,</para>
  <para style="q" vid="JER 51:58">lagurúba sunsuinagubei,</para>
  <para style="q" vid="JER 51:58">gudawa ligíame luéinamun burí lubenari.</para>
  <para style="q" vid="JER 51:58">Meseriwínbei wadagimanu le</para>
  <para style="q" vid="JER 51:58">adüga hamaalibei gürigia luagu,</para>
  <para style="q" vid="JER 51:58">lagumuchuba lárouga houn lidan watu gemeti».<verse eid="JER 51:58" /></para>
  <para style="s1">Lanügǘniwa lani Heremíasi ñunsu Babilónioun</para>
  <para style="p">
    <verse number="59" style="v" sid="JER 51:59" />Dimurei lóunahan profeta Heremíasi lun Seraíasi, le liráü Neríasi, libari Maseíasi lidan ligadürün lirumudiri lagumadihan Sedekíasi, le lurúeite Hudá. Lídiña Seraíasi luma urúei Sedekíasi lidan luéiyasun Babilónioun keisi aransehati ligabanan urúei. <verse eid="JER 51:59" /><verse number="60" style="v" sid="JER 51:60" />Abürüha laali bugati Heremíasi ñunsu tidan aban garudia libügürü sun lamiselu le lunbei liabin luagun Babilónia luma líbiri katei le lunbei lasuseredun ñein, <verse eid="JER 51:60" /><verse number="61" style="v" sid="JER 51:61" />aba lariñagun lun Seraíasi:</para>
  <para style="p" vid="JER 51:61">—Danme bachülürün Babilónia, baliiheime sun ñunsu le. <verse eid="JER 51:61" /><verse number="62" style="v" sid="JER 51:62" />Lárigiñe ábame bariñagun: “Aburemei, ariñagaadibu luagu bagünrinchagubei lan fulasu le, lun maganóundigiaaña lan ni gürigia, ni animaalugu ñein, ladüga badügaali lan ábanme fulasu mageirawati lun sun dan”. <verse eid="JER 51:62" /><verse number="63" style="v" sid="JER 51:63" />Lárigiñemeti lásurun baliihanu líburu to, ábame bagüürün aban dübü tuagu, ábame bágurunu lidoun duna Éufüratesi, <verse eid="JER 51:63" /><verse number="64" style="v" sid="JER 51:64" />bariñagame: “Ítara luba labuluchun Babilónia, másaarunhalime lídangiñe lamiselu le lunbei lóunahani Aburemei luagun”.</para>
  <para style="p" vid="JER 51:64">Ya lagumucha lererun Heremíasi.<verse eid="JER 51:64" /></para>
  <chapter eid="JER 51" />
  <chapter number="52" style="c" sid="JER 52" />
  <para style="ms">IV. Ásuruni: Lábürühan Babilónia</para>
  <para style="mr">(<ref loc="JER 52:1-34">52.1-34</ref>)</para>
  <para style="s1">Larúeihan Sedekíasi</para>
  <para style="r">(<ref loc="2KI 24:18-20">2 Uru 24.18-20</ref>; <ref loc="2CH 36:11-16">2 Kro 36.11-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 52:1" />Wein-aban irumu lau Sedekíasi danbei le lagumeserun arúeiha, arúeihati unsu irumu Herusalén. Amutáli, ligía meha tíribei lúguchu, liráü Heremíasi le Libünáana.<verse eid="JER 52:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 52:2" />Gama lumoun wuribati lóuserun ligibugiñe Aburemei kéigubeirügü lóuserun Hoakimü. <verse eid="JER 52:2" /><verse number="3" style="v" sid="JER 52:3" />Ligía lagañidunbei Aburemei luma Herusalén labu Hudá, aba labugaguniña luáriua.</para>
  <para style="s1" vid="JER 52:3">Lábürühan Herusalén</para>
  <para style="r" vid="JER 52:3">(<ref loc="2KI 24:20-25:7">2 Uru 24.20—25.7</ref>; <ref loc="JER 39:1-7">Her 39.1-7</ref>)</para>
  <para style="p" vid="JER 52:3">Lárigiñe, aba liñuragun Sedekíasi lungua luéi lagumadihan lurúeite Babilónia. <verse eid="JER 52:3" /><verse number="4" style="v" sid="JER 52:4" />Weyu diisi lidan lidiisin hati lidan linefun lirumudiri larúeihan Sedekíasi, aba lidin Nabukodonosoru hau sun lisudaranigu luagun Herusalén aba legeyedaguni hau lisudaranigu. Aba líchugunu likianpun-agei ligibugiñe, luma geyegua lau, aba híchaahan hebu lun hawarirun lisudaranigu lun hageindagun luma. <verse eid="JER 52:4" /><verse number="5" style="v" sid="JER 52:5" />Rédeiti uburugu geyewaguañu hau súdaragu darí irumu unsu lidan larúeihan Sedekíasi. <verse eid="JER 52:5" /><verse number="6" style="v" sid="JER 52:6" />Weyu nefu lidan ligadürün hati lidan irumu ligía, ligía laweiridaguntima ilamaü fulasurugu, madarihaña gürigia kaba lan heiga. <verse eid="JER 52:6" /><verse number="7" style="v" sid="JER 52:7" />Ábati hadügün aban huyu luagu lubarieirun uburugu, aba lanurahan urúei hama sun lisudaranigu áriebu lau sun geyegua hamaniña Kalüdéana. Aba háfuridun luéigiñe bena le labadinaguabei bián baríeiru luéigiñe lémeri lufulurin-agei urúei, aba hárügüdün luéigiñe lémeri fulasu wayati le lani Hordán. <verse eid="JER 52:7" /><verse number="8" style="v" sid="JER 52:8" />Gama lumoun aba héibaahani súdaragu Kalüdéana urúei Sedekíasi, aba hárügüdüni luagu fulasu mawübüriti le lani Herikó, aba hígiruni sun lisudaranigu aba hafanreinragun. <verse eid="JER 52:8" /><verse number="9" style="v" sid="JER 52:9" />Aba hárügüdüni Kalüdéana urúei, aba hanügüni ligibugiñoun lurúeite Babilónia uburugu Ribülá, lumúanrugu Amatü. Aba lasiadiruni Nabukodonosoru Sedekíasi, <verse eid="JER 52:9" /><verse number="10" style="v" sid="JER 52:10" />aba lóunahan adürühei hachügü lirahüñü Sedekíasi hama sun wügüriña wéirigutiña Hudá liñúarü. <verse eid="JER 52:10" /><verse number="11" style="v" sid="JER 52:11" />Aba lóunahan asagaragüdei lagu Sedekíasi, aba hagüraguni lau güringüri, aba hanügüni Babilónioun, ñein lubéi leredera adaürǘwa darí lounwen.<verse eid="JER 52:11" /></para>
  <para style="s1">Tagünrinchawaguniwa ténpulu</para>
  <para style="r">(<ref loc="2KI 25:8-21">2 Uru 25.8-21</ref>; <ref loc="2CH 36:17-21">2 Kro 36.17-21</ref>; <ref loc="JER 39:8-10">Her 39.8-10</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JER 52:12" />Weyu diisi lidan liseingün hati lidan irumu disinéfu lidan larúeihan Nabukodonosoru, le lurúeite Babilónia, aba lachülürün Nebusaradán Herusaléun, anihán wügüri le lánibei urúei minisi, lememe giñe gumadan tani furisun to tani palasiu, <verse eid="JER 52:12" /><verse number="13" style="v" sid="JER 52:13" />aba lágudunu ténpulu, lani urúei palasiu tuma sun muna to uburuguboun, tótima haban íñugutiña, <verse eid="JER 52:13" /><verse number="14" style="v" sid="JER 52:14" />aba háguruni súdaragu Kalüdéana ha úarabaña luma baríeiru burí le geyegubei lau Herusalén. <verse eid="JER 52:14" /><verse number="15" style="v" sid="JER 52:15" />Lárigiñe, dandu buga ha erederubaña uburugu, kei ha ásügürübaña lumoun lurúeite Babilónia, aba lanügüniña Nebusaradán Babilónioun, hama giñe híbiri gadiñetiña. <verse eid="JER 52:15" /><verse number="16" style="v" sid="JER 52:16" />Fiúrügüñanu hádangiñe gürigia ha gudemetimabaña lígira lun hábunaguni múa.<verse eid="JER 52:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 52:17" />Aba hañaünrühani Kalüdéana ílagu lauti buronse le buga ténpulurugubei: Wagabu, ebu, óunwenbu lagei duna, aba hanügüni sun buronse Babilónioun. <verse eid="JER 52:17" /><verse number="18" style="v" sid="JER 52:18" />Barǘ hamuti giñe lagei baligi, chóbuli, tíbaaha mecha, kopu wéinamuti, guliyeru luma sun ílagu lauti buronse le ayusurúbei lidan kultu. <verse eid="JER 52:18" /><verse number="19" style="v" sid="JER 52:19" />Barǘ lumuti giñe Nebusaradán sun ílagu lauti golu luma pülata: Lagei leñegura watu, kopu wéinamuti, lagei baligi, lebu sanudelu, guliyeru luma weru burí le tagei diwéin to idewesei lun Aburemei. <verse eid="JER 52:19" /><verse number="20" style="v" sid="JER 52:20" />Bián wagabu, óunwenbu lagei duna hau duusu bágasu láutiña buronse ha ágüdahabalin, luma burí ebu le ladaagüdübei urúei Salomón tun ténpulu, siñati lasubudirun lihürü. <verse eid="JER 52:20" /><verse number="21" style="v" sid="JER 52:21" />Kada wagabu ñeinñein lóugiñe widü méturu luagu liñun, kei burí seingü méturu dimí ligaranan; hunrenti múnadagiñe libiti, sedü sentimeturu liduru buronse ligía. <verse eid="JER 52:21" /><verse number="22" style="v" sid="JER 52:22" />Kada wagabu ñeinñein aban kapitéli lauti buronse lóugiñegua, lóugiñe bián méturu liñun, geyegua lau ñeinñein aban liraüraü ayarawaguni lauti buronse, wéndegüdawati lau güranáda. Aban labu biángubei wagabu ligía. <verse eid="JER 52:22" /><verse number="23" style="v" sid="JER 52:23" />Ñeinñein san güranáda luagu kada liraüraü ayarawaguni ligía le luágubei kada kapitéli, arihúatu gádürü-wein-disisi lídangiñe.<verse eid="JER 52:23" /></para>
  <para style="s1">Hanaawagúniwa huríu Babilónioun</para>
  <para style="p">
    <verse number="24" style="v" sid="JER 52:24" />Daü lumuti giñe Nebusaradán Seraíasi, le fádiri le íñugutimabei, Sofoníasi le fádiri le lárigibei Seraíasi hama ǘrüwa ha óunigihabaña tubenari ténpulu. <verse eid="JER 52:24" /><verse number="25" style="v" sid="JER 52:25" />Hádangiñe lílana uburugu, daü lumuti úfisi le haubei súdaragu, sedü wügüriña ha eseriwidubalin urúei ha uburugubaña lidan oura ligía, ha agumadihabaña luma urúei milidaru le abudahabei wügüriña lun hasudarahan, hama ǘrüwa-wein lílana uburugu, ha íñugutiña. <verse eid="JER 52:25" /><verse number="26-27" style="v" sid="JER 52:26-27" />Aba lanügüniña Nebusaradán sun ha ligibugiñoun lurúeite Babilónia, uburugu Ribülá le lumúanrugubei Amatü. Aba láfaraguagüdüniña lurúeite Babilónia ñein.</para>
  <para style="p" vid="JER 52:26-27">Ítara liña hasagarúniwa lánigu Hudá hageiragiñe. <verse eid="JER 52:26-27" /><verse number="28" style="v" sid="JER 52:28" />Anihán hiibe gürigia ha lasagarubaña Nabukodonosoru hageiragiñe: Ǘrüwa-milu-wein-ǘrüwa Hudaagiñe, lidan lisedün lirumudiri larúeihan; <verse eid="JER 52:28" /><verse number="29" style="v" sid="JER 52:29" />lidan irumu disiwídü, sagati widü-san-darandi-biama Herusaléngiñe; <verse eid="JER 52:29" /><verse number="30" style="v" sid="JER 52:30" />lidan irumu wein-ǘrüwa, sagati Nebusaradán sedü-san-bián-wein-seingü Hudaagiñe, hadan súngubei, gádürü-milu-sisi-san gürigia asagarútiña hageiragiñe.<verse eid="JER 52:30" /></para>
  <para style="s1">Lasagarúniwa Hoakín furisunrugúgiñe</para>
  <para style="r">(<ref loc="2KI 25:27-30">2 Uru 25.27-30</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="JER 52:31" />Weyu wein-seingü lidan duusu hati, irumu darandi-sedü lúmagiñe lanügüniwa Hoakín le lurúeite Hudá lageiragiñe, ligía lagumeserun Ewili-merodákü arúeiha Babilónia, aba buidu lan lóuseruni lurúeite Babilónia Hoakín, aba lasagaruni furisunrugúgiñe, <verse eid="JER 52:31" /><verse number="32" style="v" sid="JER 52:32" />buiti lóuseruni sügǘ lau lóuseruniña híbiri urúeigu ha Babilóniabaña luma. <verse eid="JER 52:32" /><verse number="33" style="v" sid="JER 52:33" />Ítara liña gayara lan laragachunu Hoakín daüguaü to buga layusuruboun furisunrugu, hou ligía luma urúei lidan sun líbiri dan le labagaridubei. <verse eid="JER 52:33" /><verse number="34" style="v" sid="JER 52:34" />Ibihati giñe Hoakín fáyeiti sagü weyu lúmagiñe lurúeite Babilónia darí lounwen.<verse eid="JER 52:34" /></para>
  <chapter eid="JER 52" />
</usx>