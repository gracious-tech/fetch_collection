<usx version="3.0">
  <book code="LAM" style="id">LAMENTO.TXT (Encoding update 2008) 27/02/2001 CAP C.R, GARIFUNA</book>
  <para style="h">Ayahuni</para>
  <para style="toc3">Aya</para>
  <para style="toc2">Ayahuni</para>
  <para style="toc1">Ayahuni</para>
  <para style="mt2">Liliburun</para>
  <para style="mt1">AYAHUNI</para>
  <chapter number="1" style="c" sid="LAM 1" />
  <para style="ms">I. FURUMIÑETI AYAHUNI</para>
  <para style="mr">(<ref loc="LAM 1:1-22">1.1-22</ref>)</para>
  <para style="s1">Lirun Herusalén</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 1:1" />Málaali uburugu le meha buinbei hau gürigia!</para>
  <para style="q" vid="LAM 1:1">Inebewati meha lidan sun ubóu,</para>
  <para style="q" vid="LAM 1:1">tenegerügaali aban würi to hilaali túmari!</para>
  <para style="q" vid="LAM 1:1">Herusalén, le urúei hadan néchanigu</para>
  <para style="q" vid="LAM 1:1">maweirigunti luéi aban idamuni guentó!<verse eid="LAM 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="LAM 1:2" />Sagü áriebu layahun;</para>
  <para style="q" vid="LAM 1:2">chun liña lubuyubu lau águiraü.</para>
  <para style="q" vid="LAM 1:2">Úati ni aban ámalihati hádangiñe sun lubúaligu.</para>
  <para style="q" vid="LAM 1:2">Garabaguaaña sun lumadagu luagun; láganihaña guentó.<verse eid="LAM 1:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="LAM 1:3" />Bóugudin luéi súfuri luma lidere wadagimanu,</para>
  <para style="q" vid="LAM 1:3">lasufuriruñein Hudá adaürǘni guentó.</para>
  <para style="q" vid="LAM 1:3">Laganóunña lidan amu ageiraü,</para>
  <para style="q" vid="LAM 1:3">ani madariti emeraaguni.</para>
  <para style="q" vid="LAM 1:3">Ragǘ hamá háñaha éibaahabalin,</para>
  <para style="q" vid="LAM 1:3">aba híchuguni lidoun lénrengunga.<verse eid="LAM 1:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="LAM 1:4" />Híruha lémeri Sión!</para>
  <para style="q" vid="LAM 1:4">Úaaña ñǘbuintiña efeduha!</para>
  <para style="q" vid="LAM 1:4">Málougaali luagu burí lubenari uburugu,</para>
  <para style="q" vid="LAM 1:4">ayahuatiña fádirigu, nidiheritiña würiña nibureingiña,</para>
  <para style="q" vid="LAM 1:4">wuribati dan lun Herusalén.<verse eid="LAM 1:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="LAM 1:5" />Láganiñu agumadihabaña,</para>
  <para style="q" vid="LAM 1:5">buiti lidin houn ha iyereehabúbaña lun lidan sun le hadügübei.</para>
  <para style="q" vid="LAM 1:5">Nidiherigüda laali Bungiu luagu lifigoun,</para>
  <para style="q" vid="LAM 1:5">barǘ lumutiña ágani lirahüñü adaürǘwa lidoun amu fulasu.<verse eid="LAM 1:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="LAM 1:6" />Gumugua sun luenden Herusalén,</para>
  <para style="q" vid="LAM 1:6">ítara haña lábutigu kei usari áluaha sagadi lun heigin;</para>
  <para style="q" vid="LAM 1:6">aduruuheinei hagudi héibuga habá habá ha éibaahabaliña.<verse eid="LAM 1:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="LAM 1:7" />Haritagua lumuti Herusalén weyu</para>
  <para style="q" vid="LAM 1:7">le lerederunbei lábugua híruñu;</para>
  <para style="q" vid="LAM 1:7">haritaguati luagu sun irisini;</para>
  <para style="q" vid="LAM 1:7">le meha lúmabei lidan dan le sügühalibei;</para>
  <para style="q" vid="LAM 1:7">haritagua lumuti dan le lábürühanbei labun lubafu lágani,</para>
  <para style="q" vid="LAM 1:7">úati ñǘbuinti íderaguei,</para>
  <para style="q" vid="LAM 1:7">dan le harihinbalin láganiñu</para>
  <para style="q" vid="LAM 1:7">aba hadügün bula lau lagünrinchagun.<verse eid="LAM 1:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="LAM 1:8" />Gíbeeli lafigouhan Herusalén,</para>
  <para style="q" vid="LAM 1:8">darí lun lanügǘn kei ni kata.</para>
  <para style="q" vid="LAM 1:8">Ha meha wéirigubei hanügüni, meberesenhaaña lau,</para>
  <para style="q" vid="LAM 1:8">ladüga ariha hamaali lasurusuhan.</para>
  <para style="q" vid="LAM 1:8">Ligía layahuña lubéi, aba lagararaagun lau busiganu.<verse eid="LAM 1:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="LAM 1:9" />Buin tiña ladaüragun lau iwiyei;</para>
  <para style="q" vid="LAM 1:9">maritagunti buga luagu le lunbei lasuseredun lárigiñe.</para>
  <para style="q" vid="LAM 1:9">Guentó, ábürüha, úati kaba lan ámalihei.</para>
  <para style="q" vid="LAM 1:9">Aburemei, arihabá lun nidiheri</para>
  <para style="q" vid="LAM 1:9">luma liñun lanaagun nágani lungua!<verse eid="LAM 1:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="LAM 1:10" />Barüla ágani lirisin Herusalén lánime.</para>
  <para style="q" vid="LAM 1:10">Ariha hamuti lílana uburugu hebelurun áganiñu ténpulurugun lau anarimeni,</para>
  <para style="q" vid="LAM 1:10">gürigia ha únbaña bariñaga, Aburemei,</para>
  <para style="q" vid="LAM 1:10">lun mebelubaña lan bitenpulunrugun!<verse eid="LAM 1:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="LAM 1:11" />Hayahuña sun lílana Herusalén,</para>
  <para style="q" vid="LAM 1:11">háluahaña éigini;</para>
  <para style="q" vid="LAM 1:11">ru hamuti harisin luagu éigini lun habagaridun!</para>
  <para style="q" vid="LAM 1:11">Aburemei, arihabéi nagünrinchawagun!</para>
  <para style="q" vid="LAM 1:11">Arihabéi gádantina!<verse eid="LAM 1:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="LAM 1:12" />Huguya le luágubei üma,</para>
  <para style="q" vid="LAM 1:12">ráramagua humá asaminara anhein anihein</para>
  <para style="q" vid="LAM 1:12">lubéi gáriti libe le nuágubei,</para>
  <para style="q" vid="LAM 1:12">le asufuriragüdübalina saragu!</para>
  <para style="q" vid="LAM 1:12">Aburemei óunahabalin lamiselu le nuagun</para>
  <para style="q" vid="LAM 1:12">dan le ladurangunbei lanarime ligañi!<verse eid="LAM 1:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="LAM 1:13" />Chüti Aburemei aban watu gemeti íñugiñe</para>
  <para style="q" vid="LAM 1:13">le aburuchagubalin nabu;</para>
  <para style="q" vid="LAM 1:13">sétiti aban sádara nubá;</para>
  <para style="q" vid="LAM 1:13">aba lagiribudagüdünina;</para>
  <para style="q" vid="LAM 1:13">ígira láadina nábugua,</para>
  <para style="q" vid="LAM 1:13">lun nasufurirun sun dan.<verse eid="LAM 1:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="LAM 1:14" />Ariha laali Aburemei nifigoun, aba lóundaruni</para>
  <para style="q" vid="LAM 1:14">lárigiñe aba lagüürüni nigiina,</para>
  <para style="q" vid="LAM 1:14">lagumuchuña lihürü nifigoun lau nere!</para>
  <para style="q" vid="LAM 1:14">Ru laadina Bungiu háhaburugun gürigia</para>
  <para style="q" vid="LAM 1:14">ha siñá numutiña awanda.<verse eid="LAM 1:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="LAM 1:15" />Adügati Aburemei bula hau sun ganigitiña háñaha</para>
  <para style="q" vid="LAM 1:15">ageindagubaña nuéigiñe.</para>
  <para style="q" vid="LAM 1:15">Óunahati súdaragu nuagun lun hagumuchun</para>
  <para style="q" vid="LAM 1:15">hau nuwügüriñanigu ha ganigitimabaña.</para>
  <para style="q" vid="LAM 1:15">Buregualá Aburemei Hudá,</para>
  <para style="q" vid="LAM 1:15">kei taburechawagun beibei lun tadügün diwéin.<verse eid="LAM 1:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="LAM 1:16" />Ayahuagüda lumutina burí katei le.</para>
  <para style="q" vid="LAM 1:16">Buinti nagu lau águiraü,</para>
  <para style="q" vid="LAM 1:16">ladüga úati kaba lan ámalihana,</para>
  <para style="q" vid="LAM 1:16">kaba lan íchiga gurasu nun.</para>
  <para style="q" vid="LAM 1:16">Rédeiha nirahüñü lidan günringuaü</para>
  <para style="q" vid="LAM 1:16">ladüga héretima lan wágani wawéi.<verse eid="LAM 1:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="LAM 1:17" />Tulé lumuti Herusalén lúhabu ayumuragua</para>
  <para style="q" vid="LAM 1:17">gama lumoun úati kaba lan ámalihei.</para>
  <para style="q" vid="LAM 1:17">Ariñagaali Aburemei lun hegeyedaguni áganiñu Hakobu,</para>
  <para style="q" vid="LAM 1:17">katei le iyereehabúti Herusalén houn.<verse eid="LAM 1:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="LAM 1:18" />Adüga lumuti Aburemei le lubudubu,</para>
  <para style="q" vid="LAM 1:18">lugundun magunfulirun numuti lugumadin.</para>
  <para style="q" vid="LAM 1:18">Aganba humana, sun gürigia;</para>
  <para style="q" vid="LAM 1:18">ariha huméi nigarigu!</para>
  <para style="q" vid="LAM 1:18">Barüwagua wügüriña hama würiña ñǘbürigiña adaürǘwa!<verse eid="LAM 1:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="LAM 1:19" />Amuriahatina ídemuei hama nubúaligu,</para>
  <para style="q" vid="LAM 1:19">mibihin numuti hámagiñe.</para>
  <para style="q" vid="LAM 1:19">Hilaguatiña nufadirinigu hama wéiyaaña mutu uburugu.</para>
  <para style="q" vid="LAM 1:19">Háluahaña yebe éigini lun habagaridun!<verse eid="LAM 1:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="LAM 1:20" />Aburemei, arihabéi gádantina!</para>
  <para style="q" vid="LAM 1:20">Sanditina kamá lafaüncha naniguagu!</para>
  <para style="q" vid="LAM 1:20">Buregua lumutu gáriti nanigi</para>
  <para style="q" vid="LAM 1:20">dan le naritagun luagu mabuchaha nan.</para>
  <para style="q" vid="LAM 1:20">Bóugudi, áfaragua tumutiña eféin nirahüñü,</para>
  <para style="q" vid="LAM 1:20">ya múnada, anihein giñe óunweni.<verse eid="LAM 1:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="LAM 1:21" />Aganba hamuti gürigia nayahun,</para>
  <para style="q" vid="LAM 1:21">gama lumoun úatiña ámalihatina.</para>
  <para style="q" vid="LAM 1:21">Subudi hamuti sun náganiñu luáguti nilamiserun,</para>
  <para style="q" vid="LAM 1:21">gúndaatiña lau badüga lan.</para>
  <para style="q" vid="LAM 1:21">Chülügüdabei weyu le uágubei bariñaga,</para>
  <para style="q" vid="LAM 1:21">lun lasuseredun houn kei lasuseredun nun!<verse eid="LAM 1:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="LAM 1:22" />Chülügüdabéi sun wuribani le adüga hamaalibei bigibugiñoun;</para>
  <para style="q" vid="LAM 1:22">óuserabaña luagu hafigoun kei badüga nun,</para>
  <para style="q" vid="LAM 1:22">gíbeti nayahun; sánditu nanigi!<verse eid="LAM 1:22" /></para>
  <chapter eid="LAM 1" />
  <chapter number="2" style="c" sid="LAM 2" />
  <para style="ms">II. LIBIAMAN AYAHUNI</para>
  <para style="mr">(<ref loc="LAM 2:1-22">2.1-22</ref>)</para>
  <para style="s1">Labeichuni Bungiu Herusalén</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 2:1" />Wéiriti lagañidun Wabureme,</para>
  <para style="q" vid="LAM 2:1">darí lun laburigadun Herusalén le wéndebei!</para>
  <para style="q" vid="LAM 2:1">Rarigüda laali lubuidunmeraü Ísüraeli,</para>
  <para style="q" vid="LAM 2:1">kei siélugiñe lun múarugun;</para>
  <para style="q" vid="LAM 2:1">lidan ligañi, maritagungubeiti luagun lebu lugudi.<verse eid="LAM 2:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="LAM 2:2" />Mígirunti Wabureme ni aban luban Hakobu rara;</para>
  <para style="q" vid="LAM 2:2">lidan murusun oura lagañidun,</para>
  <para style="q" vid="LAM 2:2">günringua lumuti sun uburugu derebuguti le lani Hudá;</para>
  <para style="q" vid="LAM 2:2">gumuguagüdati arúeihani hama arúeihatiña.<verse eid="LAM 2:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="LAM 2:3" />Dan le ladurangunbei ligañi,</para>
  <para style="q" vid="LAM 2:3">aba ladüraaguni lubafu Ísüraeli.</para>
  <para style="q" vid="LAM 2:3">Gidá lumuti lídehan lubafu wawéi</para>
  <para style="q" vid="LAM 2:3">dan wagagibudagun luma ágani;</para>
  <para style="q" vid="LAM 2:3">béhali aban watu uburugu Hakobu,</para>
  <para style="q" vid="LAM 2:3">le águdubalin sun le ladarirun lubarua!<verse eid="LAM 2:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="LAM 2:4" />Wabureme, kei aban ágani,</para>
  <para style="q" vid="LAM 2:4">aba lesetirunu gimara, aba lederaagüdüni larüna;</para>
  <para style="q" vid="LAM 2:4">aba láfaraguniña ha hínsiñegutimabaña lidan wageira;</para>
  <para style="q" vid="LAM 2:4">óunaha lumuti ligañi kei aban watu gemeti</para>
  <para style="q" vid="LAM 2:4">tuagun likianpun-agei Herusalén.<verse eid="LAM 2:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="LAM 2:5" />Aba luadigimaridun Wabureme kei aban ágani.</para>
  <para style="q" vid="LAM 2:5">Günringua lumuti Ísüraeli sunsuinagubei;</para>
  <para style="q" vid="LAM 2:5">chagá lumutu sun burí lani palasiu luma liderebugu,</para>
  <para style="q" vid="LAM 2:5">dati saragu idiheri lidoun Hudá.<verse eid="LAM 2:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="LAM 2:6" />Beluti tidoun lisanduariun lau erei kei aban híweruti;</para>
  <para style="q" vid="LAM 2:6">günringua lumuti lubara óundaraguni.</para>
  <para style="q" vid="LAM 2:6">Adügati Wabureme lun labulieidúniwa fedu</para>
  <para style="q" vid="LAM 2:6">luma luéyuri emeraaguni uburugu Herusalén.</para>
  <para style="q" vid="LAM 2:6">Lidan lanarime ligañi, máhati lun urúei luma fádiri.<verse eid="LAM 2:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="LAM 2:7" />Máhaali Wabureme lun lani latarü,</para>
  <para style="q" vid="LAM 2:7">meberesenhali tau lani sanduariu;</para>
  <para style="q" vid="LAM 2:7">derege lumuti baríeiru léñaha ágüdahabalin</para>
  <para style="q" vid="LAM 2:7">uburugu, houn áganiñu.</para>
  <para style="q" vid="LAM 2:7">Anihein agúarahani litenpulunrugu Wabureme,</para>
  <para style="q" vid="LAM 2:7">kamá hamuga luéyuri fedu!<verse eid="LAM 2:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="LAM 2:8" />Fui lumuti Wabureme lubarieirun Herusalén.</para>
  <para style="q" vid="LAM 2:8">Eledegua lumuti günringuaü</para>
  <para style="q" vid="LAM 2:8">aba ladügüni memeraagunga.</para>
  <para style="q" vid="LAM 2:8">Ábürüha baríeiru luma touba muna le lóuburagubei tau ludu,</para>
  <para style="q" vid="LAM 2:8">héiguouga súngubei lidan aban.<verse eid="LAM 2:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="LAM 2:9" />Mebenariti uburugu, madaünda ligía,</para>
  <para style="q" vid="LAM 2:9">günringua lubenari, anihein múarugu!</para>
  <para style="q" vid="LAM 2:9">Lurúeite hama gumadimatiña,</para>
  <para style="q" vid="LAM 2:9">añahein hadan gibe tubungiutegu;</para>
  <para style="q" vid="LAM 2:9">úaali lilurudun Wabungiute.</para>
  <para style="q" vid="LAM 2:9">Ni íbini houn lani profetagu,</para>
  <para style="q" vid="LAM 2:9">madimurehanhali Wabureme!<verse eid="LAM 2:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="LAM 2:10" />Ñurutiña wéiyaaña mutu ha lílana Herusalén múarugu maniñu,</para>
  <para style="q" vid="LAM 2:10">chagatiña sagoun hábulugun,</para>
  <para style="q" vid="LAM 2:10">aba hadaüragun daüguaü súsutu arufudei hagarigu.</para>
  <para style="q" vid="LAM 2:10">Buluguatiña würiña irahüñü Herusalénna</para>
  <para style="q" vid="LAM 2:10">dagá hábulugu múarugu.<verse eid="LAM 2:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="LAM 2:11" />Buchá luagu nagu lárigi ayahuni,</para>
  <para style="q" vid="LAM 2:11">sanditina kamá lafaüncha naniguagu;</para>
  <para style="q" vid="LAM 2:11">gumuha nuguraasun lau narihini</para>
  <para style="q" vid="LAM 2:11">haburugute numutuniña günringuañu,</para>
  <para style="q" vid="LAM 2:11">lau narihin hóunwegun irahüñü</para>
  <para style="q" vid="LAM 2:11">figigiña halama ǘmada.<verse eid="LAM 2:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="LAM 2:12" />Hariñaga irahüñü houn háguchunigu:</para>
  <para style="q" vid="LAM 2:12">«Méiganhadiwa fein, maniñe diwéin!»</para>
  <para style="q" vid="LAM 2:12">Sun añaha lan ábürüha ǘmadarugu kei buleseiwaaña le lánina óunweni,</para>
  <para style="q" vid="LAM 2:12">sun añaha lan harünarugu háguchu íchigei lagumuhóun awaraguni.<verse eid="LAM 2:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="LAM 2:13" />Ka ítarabei kei buguya Herusalén?</para>
  <para style="q" vid="LAM 2:13">Ka hénpulu gayaraabei níchuguni lun námalihanibu,</para>
  <para style="q" vid="LAM 2:13">uburugu Herusalén le wéndebei?</para>
  <para style="q" vid="LAM 2:13">Wéiriti bagünrinchagun kei lueirin barana;</para>
  <para style="q" vid="LAM 2:13">kaba san gayara líchugun dǘgüdaguaü bun?<verse eid="LAM 2:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="LAM 2:14" />Uénedü le uágubei hadimureha bani profetagu bun,</para>
  <para style="q" vid="LAM 2:14">mama amu katei luéidigia iyeeni.</para>
  <para style="q" vid="LAM 2:14">Mafuranguagüdün hamuti bifigoun</para>
  <para style="q" vid="LAM 2:14">lun lasansirun bubunurun,</para>
  <para style="q" vid="LAM 2:14">adimurehatiña bun luagu uénedü le iyeeniti,</para>
  <para style="q" vid="LAM 2:14">aba hafiñeragüdünibu.<verse eid="LAM 2:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="LAM 2:15" />Dan le harihinibu ásügürütiña,</para>
  <para style="q" vid="LAM 2:15">aba hapouhan háhabu adüga bula bau;</para>
  <para style="q" vid="LAM 2:15">aba híñaahan, ánhinha haméi hachügü,</para>
  <para style="q" vid="LAM 2:15">hariñaga luagu Herusalén le wéndebei,</para>
  <para style="q" vid="LAM 2:15">«Anihán san uburugu le unbei</para>
  <para style="q" vid="LAM 2:15">hariñaga lubuiduntima fulasu ubouagu?»<verse eid="LAM 2:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="LAM 2:16" />Sun báganiñu ayanuhatiña wuriba buagu,</para>
  <para style="q" vid="LAM 2:16">hariñaga labadinagua híñaahan</para>
  <para style="q" vid="LAM 2:16">luma hayawadagun buagun:</para>
  <para style="q" vid="LAM 2:16">«Günringua wamá sunsuinagubei».</para>
  <para style="q" vid="LAM 2:16">Anihán weyu le wagurabahañahabei;</para>
  <para style="q" vid="LAM 2:16">arihadügü wamá!<verse eid="LAM 2:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="LAM 2:17" />Adügalá Wabureme laritagun gúnfuliha lau lererun.</para>
  <para style="q" vid="LAM 2:17">Günringualá le laritagubei lagünrinchagun lúmagiñe binarü,</para>
  <para style="q" vid="LAM 2:17">ígirati lun léherahan ágani bau aba líchuguni lubafu iñu.<verse eid="LAM 2:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="LAM 2:18" />Herusalén le wéndebei,</para>
  <para style="q" vid="LAM 2:18">bamuriaha luma Wabureme lun líderagunibu!</para>
  <para style="q" vid="LAM 2:18">Bayahuaha wéyuagu áriebu!</para>
  <para style="q" vid="LAM 2:18">Merederalá bayahun, memeraaguagüdabei bagu!<verse eid="LAM 2:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="LAM 2:19" />Saraba! Bagúaraha áriebu, wáguaba danmeme.</para>
  <para style="q" vid="LAM 2:19">Sagabei sun le tídanbei banigi ligibugiñe Wabureme,</para>
  <para style="q" vid="LAM 2:19">ígirabei lun léibaagun kei duna éibaaguati;</para>
  <para style="q" vid="LAM 2:19">bayumuragua lun luagu habagari birahüñü,</para>
  <para style="q" vid="LAM 2:19">ha óunwegubaña halama ǘmada.<verse eid="LAM 2:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="LAM 2:20" />Wabureme</para>
  <para style="q" vid="LAM 2:20">saminabá luagu úagili lan ni aban bóuserun ítara.</para>
  <para style="q" vid="LAM 2:20">Gasu funagia héiginiña úguchurugu hasaanigu ha guragiña?</para>
  <para style="q" vid="LAM 2:20">Gasu funagia háfarawagun fádirigu hama profetagu tidan sanduariu?<verse eid="LAM 2:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="LAM 2:21" />Arihúatiña ñǘbürigiña</para>
  <para style="q" vid="LAM 2:21">hama wéiyaaña mutu riwagu ǘmada</para>
  <para style="q" vid="LAM 2:21">áfarawaguatiña wügüriña hama würiña</para>
  <para style="q" vid="LAM 2:21">nibureintiña tau eféin.</para>
  <para style="q" vid="LAM 2:21">Áfarahatibu lidan luéyuri bigañi,</para>
  <para style="q" vid="LAM 2:21">áfarahatibu magudemehabuga!<verse eid="LAM 2:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="LAM 2:22" />Barühadibu denchaü lídangiñe sun oubaü,</para>
  <para style="q" vid="LAM 2:22">kamá hamuga liábiña lidoun aban fedu;</para>
  <para style="q" vid="LAM 2:22">úati ni aban esefuruti lidan luéyuri bigañi.</para>
  <para style="q" vid="LAM 2:22">Áfaragua lumutiña ágani ha nagüriarubaña.<verse eid="LAM 2:22" /></para>
  <chapter eid="LAM 2" />
  <chapter number="3" style="c" sid="LAM 3" />
  <para style="ms">III. LǗRÜWAN AYAHUNI</para>
  <para style="mr">(<ref loc="LAM 3:1-66">3.1-66</ref>)</para>
  <para style="s1">Abeichúni, asakürihani luma emenigini</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 3:1" />Au le sandí naalibei asufuriruni</para>
  <para style="q" vid="LAM 3:1">lábugiñe lagayuahan ligañi Wabureme.<verse eid="LAM 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 3:2" />Barǘ laadina lidoun burí fulasu búrigati,</para>
  <para style="q" vid="LAM 3:2">éibugagüda láadina lidan üma magemeriti,<verse eid="LAM 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 3:3" />aban lárigi aban,</para>
  <para style="q" vid="LAM 3:3">sagü murusun oura lagayuahan nuagu.<verse eid="LAM 3:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="LAM 3:4" />Wéiyagüdala nǘgürügü luma nura,</para>
  <para style="q" vid="LAM 3:4">halagualá nabu.<verse eid="LAM 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 3:5" />Iñuraguaali aban baríeiru lánina súfuri geyegua nau,<verse eid="LAM 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 3:6" />aganawagüda láadina lidan lamuñounga</para>
  <para style="q" vid="LAM 3:6">kei ha óunwegubaña lúmagiñe binarü.<verse eid="LAM 3:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="LAM 3:7" />Da lumutina lidoun aban baríeiru le</para>
  <para style="q" vid="LAM 3:7">siñabei náfuridun lídangiñe,</para>
  <para style="q" vid="LAM 3:7">gürá lumutina lau güringüri hǘrüti;<verse eid="LAM 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 3:8" />lau sun wáguana amuriaha ídemuei,</para>
  <para style="q" vid="LAM 3:8">meberesegúnti lau nayumuragun;<verse eid="LAM 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 3:9" />Darú lumuti üma nuéi lau baríeiru,</para>
  <para style="q" vid="LAM 3:9">geyé lumuti némeri!<verse eid="LAM 3:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="LAM 3:10" />Ítara liña nun kei aban liñún aramudaguñu,</para>
  <para style="q" vid="LAM 3:10">kei aban osu aranseñu lun lachubarun nuagun.<verse eid="LAM 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 3:11" />Direi láadina luéi üma, günringua láadina,</para>
  <para style="q" vid="LAM 3:11">ígira láadina buin lau anufudei!<verse eid="LAM 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 3:12" />Seti lumutu ligimaran,</para>
  <para style="q" vid="LAM 3:12">aba líchugunina lun nuágunba lan tadagara!<verse eid="LAM 3:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="LAM 3:13" />Beluharu gimara to lachüürüboun</para>
  <para style="q" vid="LAM 3:13">Wabureme nuagun buidu.<verse eid="LAM 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 3:14" />Adaaguatiña numutuniña bula nau.</para>
  <para style="q" vid="LAM 3:14">Au habulanbei sun oura.<verse eid="LAM 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 3:15" />Buíngüda láadina Wabureme lau idiheri,</para>
  <para style="q" vid="LAM 3:15">gífiti uniñein le líchugubei nun.<verse eid="LAM 3:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="LAM 3:16" />Halá lumuti nari lau láhuchurunina múarugun;</para>
  <para style="q" vid="LAM 3:16">hóugüda lumutina sagoun.<verse eid="LAM 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 3:17" />Díseeli darangilaü nuéi,</para>
  <para style="q" vid="LAM 3:17">darí lun bulieiná lan lubuidun dan.<verse eid="LAM 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 3:18" />Darí lun saminaadina lan luagu</para>
  <para style="q" vid="LAM 3:18">hilá lan lederaagüdün nemenigin luagu Wabureme.<verse eid="LAM 3:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="LAM 3:19" />Haritagua numuti nirun luma nábugua nan,</para>
  <para style="q" vid="LAM 3:19">nidiheri luma nasufurirun;<verse eid="LAM 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 3:20" />rédeitina asaminara luagun,</para>
  <para style="q" vid="LAM 3:20">aba lábürühan nuguraasun.<verse eid="LAM 3:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 3:21" />Gama lumoun mabusenruntina nabulieidun aban katei,</para>
  <para style="q" vid="LAM 3:21">lun níchuguni nemenigin luagu.<verse eid="LAM 3:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="LAM 3:22" />Luagu mébeha lan línsiñehabu Wabureme,</para>
  <para style="q" vid="LAM 3:22">ani malouguadungili lareini.<verse eid="LAM 3:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="LAM 3:23" />Iseriguati sagü binaafin,</para>
  <para style="q" vid="LAM 3:23">wéiriti ligunfulin!<verse eid="LAM 3:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="LAM 3:24" />Aba nariñagun nungua:</para>
  <para style="q" vid="LAM 3:24">«Wabureme, ligía sun káteibei nun;</para>
  <para style="q" vid="LAM 3:24">ligía hemenigi nubéi luagu!»<verse eid="LAM 3:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="LAM 3:25" />Areidati Aburemei houn ha hemenigibaña luagu,</para>
  <para style="q" vid="LAM 3:25">houn sun ha áluahabalin.<verse eid="LAM 3:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="LAM 3:26" />Buítimati wámanichun agurabaha</para>
  <para style="q" vid="LAM 3:26">líderaguniwa Bungiu.<verse eid="LAM 3:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="LAM 3:27" />Buítimati lederegeragun gürigia</para>
  <para style="q" vid="LAM 3:27">lungua lúmagiñe ñǘraügili.<verse eid="LAM 3:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="LAM 3:28" />Lunti lerederun gürigia lábugua ani maniñu,</para>
  <para style="q" vid="LAM 3:28">dan le ítara liña lan labusenruni Aburemei;<verse eid="LAM 3:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="LAM 3:29" />lunti ǘnabugubei lan darí ladagarun ligibu múarugu,</para>
  <para style="q" vid="LAM 3:29">luéidügü aniheingua lan emenigini;<verse eid="LAM 3:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="LAM 3:30" />lunti líchuguni lubuyubu lun le agayuahati luagu,</para>
  <para style="q" vid="LAM 3:30">lunti lawanduni luéirintima anabawaguni.<verse eid="LAM 3:30" /></para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" sid="LAM 3:31" />Mágurun lubadiwa Aburemei lun súnwandan.<verse eid="LAM 3:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="LAM 3:32" />Lau sun súfurigüda lan,</para>
  <para style="q" vid="LAM 3:32">gudemehabuti giñe,</para>
  <para style="q" vid="LAM 3:32">ladüga wéiriti línsiñehabu.<verse eid="LAM 3:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="LAM 3:33" />Lidan linarün katei,</para>
  <para style="q" vid="LAM 3:33">mínsiñeti lun lun ladiheridagüdün gürigia</para>
  <para style="q" vid="LAM 3:33">ni lun lasandiragüdün igari.<verse eid="LAM 3:33" /></para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" sid="LAM 3:34" />Subudi lumuti Aburemei dan le hadügürawagun adaürǘtiña</para>
  <para style="q" vid="LAM 3:34">ha lílana fulasu magudemehabuga<verse eid="LAM 3:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="LAM 3:35" />Subudi lumuti Aburemei dan le ladüraawagún liricha gürigia,</para>
  <para style="q" vid="LAM 3:35">ligibugiñe guánarügü Aburemei.<verse eid="LAM 3:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="LAM 3:36" />Subudi lumuti giñe dan le lésegerun liricha aban guséi,</para>
  <para style="q" vid="LAM 3:36">sun burí katei le, ani magundanti lau.<verse eid="LAM 3:36" /></para>
  <para style="b" />
  <para style="q">
    <verse number="37" style="v" sid="LAM 3:37" />Dan le lariñawagún aban katei,</para>
  <para style="q" vid="LAM 3:37">dan le lasuseredun aban katei;</para>
  <para style="q" vid="LAM 3:37">ladügarügü ígiraali lan Aburemei lun lasuseredun.<verse eid="LAM 3:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="LAM 3:38" />Dandu buiti kei wuribati, liábinbei,</para>
  <para style="q" vid="LAM 3:38">ladüga ítara liña lan laransehani Aburemei.<verse eid="LAM 3:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="LAM 3:39" />Gafigountiña gürigia,</para>
  <para style="q" vid="LAM 3:39">kati uagu hekehara lidan ibagari le?<verse eid="LAM 3:39" /></para>
  <para style="b" />
  <para style="q">
    <verse number="40" style="v" sid="LAM 3:40" />Samina wamá buidu luagu ligaburi wóuserun,</para>
  <para style="q" vid="LAM 3:40">giribuya wamá lun Aburemei.<verse eid="LAM 3:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="LAM 3:41" />Iñura waméi wasaminan</para>
  <para style="q" vid="LAM 3:41">luma wafurieigin lun Aburemei le siélubei.<verse eid="LAM 3:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="LAM 3:42" />Wagía afigouhatiwa, mabuchahatiwa,</para>
  <para style="q" vid="LAM 3:42">aba ua lan feruduna bániwa.<verse eid="LAM 3:42" /></para>
  <para style="b" />
  <para style="q">
    <verse number="43" style="v" sid="LAM 3:43" />Geyegua bumutiwa lau bigañi; éibaaha bumutiwa,</para>
  <para style="q" vid="LAM 3:43">gidá bumuti wabagari magudemehabuga!<verse eid="LAM 3:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="LAM 3:44" />Daruguatibu bougua lidan aban dúeri</para>
  <para style="q" vid="LAM 3:44">lun maganbunbani wayumuragun.<verse eid="LAM 3:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="LAM 3:45" />Óusera báadiwa kei lagübüri ifei hagibugiñe sun gürigia.<verse eid="LAM 3:45" /></para>
  <para style="b" />
  <para style="q">
    <verse number="46" style="v" sid="LAM 3:46" />Wagatiña sun wáganiñu kóntüra wagía;<verse eid="LAM 3:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="LAM 3:47" />anufudei, sádara luma günringuaü,</para>
  <para style="q" vid="LAM 3:47">ligía wafanranbei!<verse eid="LAM 3:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="LAM 3:48" />Áwiyuhati saragu águiraü nágurugugiñe</para>
  <para style="q" vid="LAM 3:48">luagu lagünrinchagun nuburugute le hínsiñebei nun.<verse eid="LAM 3:48" /></para>
  <para style="b" />
  <para style="q">
    <verse number="49" style="v" sid="LAM 3:49" />Memeraagunti nayahun</para>
  <para style="q" vid="LAM 3:49">lugundun úabei dǘgüdaguaü,<verse eid="LAM 3:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="LAM 3:50" />darime larihin Aburemei le siélubei wawagun íñugiñe.<verse eid="LAM 3:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="LAM 3:51" />Gáriti nagu chülǘ tumoun nuani</para>
  <para style="q" vid="LAM 3:51">luagu le asuseredubei houn lirahüñü nuburugute.<verse eid="LAM 3:51" /></para>
  <para style="b" />
  <para style="q">
    <verse number="52" style="v" sid="LAM 3:52" />Agaliruha hamaadina náganiñu kei dunuru</para>
  <para style="q" vid="LAM 3:52">lau sun mébuna lan;<verse eid="LAM 3:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="LAM 3:53" />buná hamutina wínwanñu lidan aban fusu,</para>
  <para style="q" vid="LAM 3:53">aba hadouruni liyuma lau aban dübü.<verse eid="LAM 3:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="LAM 3:54" />Daruguaali duna nau le gumuti,</para>
  <para style="q" vid="LAM 3:54">nariñagati núnguarügü:</para>
  <para style="q" vid="LAM 3:54">«Féridihadina».<verse eid="LAM 3:54" /></para>
  <para style="b" />
  <para style="q">
    <verse number="55" style="v" sid="LAM 3:55" />Aburemei,</para>
  <para style="q" vid="LAM 3:55">Wátina buagu lídangiñe luhulilin-agei fusu,<verse eid="LAM 3:55" /></para>
  <para style="q">
    <verse number="56" style="v" sid="LAM 3:56" />aganba bumuti numalali;</para>
  <para style="q" vid="LAM 3:56">ténitibu lun nayumuragun.<verse eid="LAM 3:56" /></para>
  <para style="q">
    <verse number="57" style="v" sid="LAM 3:57" />Weyu le nagúarun buagu,</para>
  <para style="q" vid="LAM 3:57">ñǘbuintibu numoun,</para>
  <para style="q" vid="LAM 3:57">aba bariñagun nun: «Manufudedabá».<verse eid="LAM 3:57" /></para>
  <para style="b" />
  <para style="q">
    <verse number="58" style="v" sid="LAM 3:58" />Ageindaguatibu nuéigiñe lidan náfaagun,</para>
  <para style="q" vid="LAM 3:58">Aburemei, sefu bumuti nibagari.<verse eid="LAM 3:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="LAM 3:59" />Nabureme, ariha bumuti marichaü le burí nasufurirubei,</para>
  <para style="q" vid="LAM 3:59">rubei niricha nun!<verse eid="LAM 3:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="LAM 3:60" />Ariha bumuti sun le hayumahabei</para>
  <para style="q" vid="LAM 3:60">luma le haransehabei kóntüra nuguya.<verse eid="LAM 3:60" /></para>
  <para style="b" />
  <para style="q">
    <verse number="61" style="v" sid="LAM 3:61" />Aganbabéi hanabagunina, Aburemei,</para>
  <para style="q" vid="LAM 3:61">luma le haransehabei kóntüra nuguya;<verse eid="LAM 3:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="LAM 3:62" />sun le hadimurehabei náganiñu nuagu sun oura.<verse eid="LAM 3:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="LAM 3:63" />Au lébunabei habulan lidan sun le hadügübei.<verse eid="LAM 3:63" /></para>
  <para style="b" />
  <para style="q">
    <verse number="64" style="v" sid="LAM 3:64" />Rubei le hadünabei houn, Aburemei,</para>
  <para style="q" vid="LAM 3:64">rubei le ladünabei hadüga houn.<verse eid="LAM 3:64" /></para>
  <para style="q">
    <verse number="65" style="v" sid="LAM 3:65" />Deregüdaboun hanigi, íñaraguabaña.<verse eid="LAM 3:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="LAM 3:66" />Éibaahabaña lau igañi, Aburemei,</para>
  <para style="q" vid="LAM 3:66">gumuguagüdabaña ubouagugiñe!<verse eid="LAM 3:66" /></para>
  <chapter eid="LAM 3" />
  <chapter number="4" style="c" sid="LAM 4" />
  <para style="ms">IV. LIGADÜRÜN AYAHUNI</para>
  <para style="mr">(<ref loc="LAM 4:1-22">4.1-22</ref>)</para>
  <para style="s1">Lagumuchun labeichún Herusalén</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 4:1" />Burúa golu! Féridila golu fínuti límirin!</para>
  <para style="q" vid="LAM 4:1">Chagagu liña burí tidübüri sanduariu!<verse eid="LAM 4:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="LAM 4:2" />Ha lílana Herusalén, ha meha wéirigubei houserún,</para>
  <para style="q" vid="LAM 4:2">ha meha gebegibalin hahürü lau golu,</para>
  <para style="q" vid="LAM 4:2">guentó ouserúatiña kei sóudieru lauti múa</para>
  <para style="q" vid="LAM 4:2">le ladüga gawadigimaridaditi katei lauti múa.<verse eid="LAM 4:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="LAM 4:3" />Íbini ounli áraabuna,</para>
  <para style="q" vid="LAM 4:3">guragüda tumutiña tirahüñü,</para>
  <para style="q" vid="LAM 4:3">ánheinti numutuniña, wuribatiña,</para>
  <para style="q" vid="LAM 4:3">wuribatiña kei aban awesüturusu houn tirahüñü</para>
  <para style="q" vid="LAM 4:3">lidan fulasu mageirawati.<verse eid="LAM 4:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="LAM 4:4" />Wéiriti hamagürabu irahüñü figigiña</para>
  <para style="q" vid="LAM 4:4">darí lun tabadülerun hañeñe luagu lisielun hayumulugu.</para>
  <para style="q" vid="LAM 4:4">Amuriahatiña irahüñü fein,</para>
  <para style="q" vid="LAM 4:4">gama lumoun úati íchugutu houn.<verse eid="LAM 4:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="LAM 4:5" />Ha meha aniheinbei saragu éigini hama,</para>
  <para style="q" vid="LAM 4:5">hilaguatiña halama ǘmada guentó.</para>
  <para style="q" vid="LAM 4:5">Ha meha aweinamudubaña lidan lubuiduniga,</para>
  <para style="q" vid="LAM 4:5">hímerugu haganóua guentó.<verse eid="LAM 4:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="LAM 4:6" />Wéiritimati habeichun numutuniña</para>
  <para style="q" vid="LAM 4:6">sügǘ lau labeichún Sodoma,</para>
  <para style="q" vid="LAM 4:6">le agünrinchawagubei lidan</para>
  <para style="q" vid="LAM 4:6">murusun oura mageindawagunga luma.<verse eid="LAM 4:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="LAM 4:7" />Ámirihati meha hagibu luwügüriñanigu ha</para>
  <para style="q" vid="LAM 4:7">anuadirúbaña sügǘ lau míligi;</para>
  <para style="q" vid="LAM 4:7">ani úati dáseiti hawagu kei niewe,</para>
  <para style="q" vid="LAM 4:7">dídeitiña, buin lau erei,</para>
  <para style="q" vid="LAM 4:7">ámirihati hagu le lubuidun hátuadi.<verse eid="LAM 4:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="LAM 4:8" />Gama lumoun guentó, hamuñati hagibu sügǘ lau lamuñounga;</para>
  <para style="q" vid="LAM 4:8">úabei gayaraati lasubudirúniña ǘmada.</para>
  <para style="q" vid="LAM 4:8">Badüle hara luagu habu,</para>
  <para style="q" vid="LAM 4:8">mábeiha kei watu!<verse eid="LAM 4:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="LAM 4:9" />Buítimati lidin houn ha óunwegubaña wuriburugu</para>
  <para style="q" vid="LAM 4:9">sügǘ hau ha láfaragubaña halama,</para>
  <para style="q" vid="LAM 4:9">ladüga ha láfaragubaña halama,</para>
  <para style="q" vid="LAM 4:9">murusun murusun hóunwegua</para>
  <para style="q" vid="LAM 4:9">lidan lúadun éigini le líchugubei múa.<verse eid="LAM 4:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="LAM 4:10" />Ñéinñanu würiña ha buítiña anigi</para>
  <para style="q" vid="LAM 4:10">ábougutiña hasaanigu houngua,</para>
  <para style="q" vid="LAM 4:10">hou hamutiña hasaanigu guánarügü</para>
  <para style="q" vid="LAM 4:10">dan le lagünrinchawagunbei Herusalén.<verse eid="LAM 4:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="LAM 4:11" />Óunaha lumuti Wabureme sun ligañi,</para>
  <para style="q" vid="LAM 4:11">ígiragüda lumuti súngubei.</para>
  <para style="q" vid="LAM 4:11">Gudá lumuti Herusalén,</para>
  <para style="q" vid="LAM 4:11">günringua lumuti íbini lebu.<verse eid="LAM 4:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="LAM 4:12" />Maritaguntiña yebe lurúeitegu fulasu,</para>
  <para style="q" vid="LAM 4:12">ni sun ha agumadihabaña ubouagu,</para>
  <para style="q" vid="LAM 4:12">luagu lebeluruba lan ágani luéigiñe lubenari Herusalén.<verse eid="LAM 4:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="LAM 4:13" />Ani sun lira, ladüga hafigoun profetagu,</para>
  <para style="q" vid="LAM 4:13">ladüga hariban fádirigu,</para>
  <para style="q" vid="LAM 4:13">ha gadurunbaña luagu hóunwegun gürigia maduruntiña!<verse eid="LAM 4:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="LAM 4:14" />Machoururunga héibuga kei marihintiña,</para>
  <para style="q" vid="LAM 4:14">lémerirugu uburugu;</para>
  <para style="q" vid="LAM 4:14">dáseiñu haña lau hitaü</para>
  <para style="q" vid="LAM 4:14">darí lun ua lan ni aban aguuruti tuagu hadaüragun.<verse eid="LAM 4:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="LAM 4:15" />Wáguati ariñaga houn:</para>
  <para style="q" vid="LAM 4:15">«Gidá humá harugabugiñe gürigia wíyetiña ha,</para>
  <para style="q" vid="LAM 4:15">maguura humaña!»</para>
  <para style="q" vid="LAM 4:15">«Éibugañahadügütiña anurahatiña hagía,</para>
  <para style="q" vid="LAM 4:15">liña hariñagun gibe tubungiutegu,</para>
  <para style="q" vid="LAM 4:15">siñati hasigirun aganóua ya».<verse eid="LAM 4:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="LAM 4:16" />Chagaguagüda lumutiña Wabureme,</para>
  <para style="q" vid="LAM 4:16">aba marihinhali lan hawagun.</para>
  <para style="q" vid="LAM 4:16">Minebenwatiña fádirigu,</para>
  <para style="q" vid="LAM 4:16">magudemenwa ligía houn wéiyaaña mutu.<verse eid="LAM 4:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="LAM 4:17" />Bucharuaali luagu wagu aguraba ídemuei</para>
  <para style="q" vid="LAM 4:17">ani machülüti.</para>
  <para style="q" vid="LAM 4:17">Agurabañu waña hachülürün gürigia ha siñabei hesefuruniwa.<verse eid="LAM 4:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="LAM 4:18" />Aríaaha hamuti sun wapasun,</para>
  <para style="q" vid="LAM 4:18">siñati wáfuridun ǘmadarugun.</para>
  <para style="q" vid="LAM 4:18">Yarafaali wagumuchagüle,</para>
  <para style="q" vid="LAM 4:18">éibaaha hamutiwa áraabu,</para>
  <para style="q" vid="LAM 4:18">sétitiña sádara wabá lidan fulasu mageirawati!<verse eid="LAM 4:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="LAM 4:19" />Furesetiña ha éibaahabaliwa sügǘ hau ágila,</para>
  <para style="q" vid="LAM 4:19">éibaaha hamutiwa áraabu,</para>
  <para style="q" vid="LAM 4:19">sétitiña sádara wabá lidan fulasu mageirawati!<verse eid="LAM 4:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="LAM 4:20" />Daüwa le lanúadirubei Wabureme,</para>
  <para style="q" vid="LAM 4:20">léñaha íchugubei gurasu lun wabagari,</para>
  <para style="q" vid="LAM 4:20">urúei léñaha uágubei wariñaga:</para>
  <para style="q" vid="LAM 4:20">«Lábugiñeba lamuñadirun waganawa hadan gürigia».<verse eid="LAM 4:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="LAM 4:21" />Béheraha, gundaabá uburugu Edomu;</para>
  <para style="q" vid="LAM 4:21">buguya le arúeihabei lóubawagu Usu!</para>
  <para style="q" vid="LAM 4:21">Lachülürüba giñe uniñein gífiti bun,</para>
  <para style="q" vid="LAM 4:21">ábame berederun bacharuañu, surusu!<verse eid="LAM 4:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="LAM 4:22" />Sunha babeichún, uburugu Herusalén;</para>
  <para style="q" vid="LAM 4:22">masagadigia láadibu Wabureme bageiragiñe.</para>
  <para style="q" vid="LAM 4:22">Gama lumoun labeichubei buriban, uburugu Edomu,</para>
  <para style="q" vid="LAM 4:22">lafuranguagüdübei bifigoun.<verse eid="LAM 4:22" /></para>
  <chapter eid="LAM 4" />
  <chapter number="5" style="c" sid="LAM 5" />
  <para style="ms">V. LISEINGÜN AYAHUNI</para>
  <para style="mr">(<ref loc="LAM 5:1-22">5.1-22</ref>)</para>
  <para style="s1">Ayumuraguni amuriaha gudemehabu</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 5:1" />Wabureme, haritaguabá luagun le susereelibei woun;</para>
  <para style="q" vid="LAM 5:1">arihabá lun hanabaguniwa.<verse eid="LAM 5:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="LAM 5:2" />Sun le buga wánibei,</para>
  <para style="q" vid="LAM 5:2">háhaburuguñein terencha guentó;</para>
  <para style="q" vid="LAM 5:2">hábanharu waban guentó.<verse eid="LAM 5:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="LAM 5:3" />Máguchiguhaadiwa;</para>
  <para style="q" vid="LAM 5:3">rédeiha wáguchu mámariga.<verse eid="LAM 5:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="LAM 5:4" />Gasu wagañeihani wadunari guánarügü,</para>
  <para style="q" vid="LAM 5:4">gasu wafayeiruni wáleme guánarügü.<verse eid="LAM 5:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="LAM 5:5" />Rúhaña aban anügüni luagu wagiina;</para>
  <para style="q" vid="LAM 5:5">buchati wawagu, ani mígiruntiña lun wemeraagun.<verse eid="LAM 5:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="LAM 5:6" />Tulé wamuti wáhabu houn Ehiptuna luma houn</para>
  <para style="q" vid="LAM 5:6">Asiriana lun wibihin éigini.<verse eid="LAM 5:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="LAM 5:7" />Wagübürigu meha afigouhabaña, guentó úaaña,</para>
  <para style="q" vid="LAM 5:7">wagíati afayeiha luagu hadurun.<verse eid="LAM 5:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="LAM 5:8" />Guentó hagumadiruñadiwa idamuni,</para>
  <para style="q" vid="LAM 5:8">ani úati kaba lan asagarawa háhaburugugiñe.<verse eid="LAM 5:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="LAM 5:9" />Lau lénrengun wibihoun weigan fein,</para>
  <para style="q" vid="LAM 5:9">hadüga wuriburuguna ha lídanbaña fulasu mageirawati.<verse eid="LAM 5:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="LAM 5:10" />Süti wara kei aban régigi,</para>
  <para style="q" vid="LAM 5:10">ladüga abiruaü le líchugubei walama woun.<verse eid="LAM 5:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="LAM 5:11" />Águrawaguatiña würiña wéinamuhaña</para>
  <para style="q" vid="LAM 5:11">hama würiña nibureintiña uburugu Herusalén</para>
  <para style="q" vid="LAM 5:11">luma burí luburuguterugu Hudá.<verse eid="LAM 5:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="LAM 5:12" />Dibigüdawatiña wábutigu luéigiñe háhabu,</para>
  <para style="q" vid="LAM 5:12">minebenwatiña wéiyaaña mutu.<verse eid="LAM 5:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="LAM 5:13" />Rúatiña wügüriña ha héretimabaña amuliha;</para>
  <para style="q" vid="LAM 5:13">héiguatiña wügüriña nibureintiña ladüga lihürü watu.<verse eid="LAM 5:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="LAM 5:14" />Úaaña wéiyaaña mutu lubenari uburugu;</para>
  <para style="q" vid="LAM 5:14">maganbúnhali heremuhan wügüriña nibureintiña.<verse eid="LAM 5:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="LAM 5:15" />Úaali ugundani tidan wanigi;</para>
  <para style="q" vid="LAM 5:15">gumuha wabinahan le lánina ugundani.<verse eid="LAM 5:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="LAM 5:16" />Heigua waridin wábulugugiñe;</para>
  <para style="q" vid="LAM 5:16">fugiabugu wagía ladüga wafigouhan!<verse eid="LAM 5:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="LAM 5:17" />Ligía sandi tubéi wanigi;</para>
  <para style="q" vid="LAM 5:17">ligía burúa lubéi warihin.<verse eid="LAM 5:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="LAM 5:18" />Aban bugan günringuaü wübü Sión;</para>
  <para style="q" vid="LAM 5:18">añahein ounli áraabuna aganóua ñein.<verse eid="LAM 5:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="LAM 5:19" />Gama lumoun buguya Wabureme,</para>
  <para style="q" vid="LAM 5:19">barúeihaba lun súnwandan;</para>
  <para style="q" vid="LAM 5:19">luágubadibu lálana barúeihan súnwandan!<verse eid="LAM 5:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="LAM 5:20" />Ka uagu babulieidawa lun súnwandan?</para>
  <para style="q" vid="LAM 5:20">Ka uagu bígirawa luagu saragu dan?<verse eid="LAM 5:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="LAM 5:21" />Giribugüdabawa bun, Wabureme!</para>
  <para style="q" vid="LAM 5:21">Adügayabá lun ítara lan wabagari kei lubéi meha.<verse eid="LAM 5:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="LAM 5:22" />Gama lumoun ígira báadiwa le gumuti;</para>
  <para style="q" vid="LAM 5:22">wéiriti bigañi wama.<verse eid="LAM 5:22" /></para>
  <chapter eid="LAM 5" />
</usx>