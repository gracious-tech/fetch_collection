<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ISA" style="id">ISAIAS.TXT (Encoding update 2008) 27/02/2001 CAP C.R, GARIFUNA</book>
  <para style="h">Isaíasi</para>
  <para style="toc3">Isa</para>
  <para style="toc2">Isaiasi</para>
  <para style="toc1">Isaiasi</para>
  <para style="mt2">Liliburun</para>
  <para style="mt1">ISAÍASI</para>
  <chapter number="1" style="c" sid="ISA 1" />
  <para style="ms">Furumiñeti Fánreinti</para>
  <para style="mr">(<ref loc="ISA 1-39">1—39</ref>)</para>
  <para style="s1">Hudá néchani gafigounti</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 1:1" />Anihán uganu luáguti Hudá luma Herusalén le líchugubei Wabureme lun Isaíasi le liráü Amosu lidan lidaani larúeihan Osiasi, Hotamü, Aasi luma Esekíasi uburugu Hudá.<verse eid="ISA 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ISA 1:2" />Sielu luma múa,</para>
  <para style="q" vid="ISA 1:2">aganba huméi le lariñagubei Wabureme:</para>
  <para style="q" vid="ISA 1:2">«Agüriahatina irahüñü darí haweinamudun,</para>
  <para style="q" vid="ISA 1:2">gama lumoun aba hagarabaagun nuagun.<verse eid="ISA 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 1:3" />Subudi lumuti bágasu labureme,</para>
  <para style="q" vid="ISA 1:3">subudiléi burigü halía lan líchiga labureme éigini lun;</para>
  <para style="q" vid="ISA 1:3">ánhañati numutuniña ibidiñeti ni kata houn,</para>
  <para style="q" vid="ISA 1:3">úati gunfuranda hamá Ísüraelina».<verse eid="ISA 1:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 1:4" />Gürigia gafigountiña!</para>
  <para style="q" vid="ISA 1:4">Gürigia buin umutiña lau wuribani,</para>
  <para style="q" vid="ISA 1:4">hadügawagun wuribatiña,</para>
  <para style="q" vid="ISA 1:4">Isaanigu salufuritiña!</para>
  <para style="q" vid="ISA 1:4">Díreihadün luéi Wabureme,</para>
  <para style="q" vid="ISA 1:4">diñuhadün luéi Lubungiute Ísüraeli le Sándubei, ígira humá.<verse eid="ISA 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 1:5" />Rúguatün hungua lun mabuchahaü,</para>
  <para style="q" vid="ISA 1:5">úaali halíaba lan habeichúa luagu húgubu.</para>
  <para style="q" vid="ISA 1:5">Anihein biti luagu sun hichügü,</para>
  <para style="q" vid="ISA 1:5">féridi humaali here sunsuinagubei.<verse eid="ISA 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 1:6" />Lúmagiñe lábugiñe hugudi darí lumoun hichügü,</para>
  <para style="q" vid="ISA 1:6">úati ni kata buiti huagu;</para>
  <para style="q" vid="ISA 1:6">luéidigia biti, buleseiti luma guméi ñalaali,</para>
  <para style="q" vid="ISA 1:6">magaranihóungili lun, magürawagún ligía,</para>
  <para style="q" vid="ISA 1:6">máhurudawagun ligía garaba luagu lun lagalumadun ligari.<verse eid="ISA 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 1:7" />Rédeiha hageira kei fulasu mageirawati,</para>
  <para style="q" vid="ISA 1:7">ani gudala watu uburugu.</para>
  <para style="q" vid="ISA 1:7">Hou hamuti háganiñu le hábunagubei higibugiñe guánarügü.</para>
  <para style="q" vid="ISA 1:7">Günringua hamá terencha humúan.<verse eid="ISA 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 1:8" />Siónrügüñein eredera rara,</para>
  <para style="q" vid="ISA 1:8">lábugua kei dibasein lamidangua beibei-agei,</para>
  <para style="q" vid="ISA 1:8">ítara liña giñe kei tagübüri muna,</para>
  <para style="q" vid="ISA 1:8">lamidangua fulasu le ñein lubéi tábunawagua melón,</para>
  <para style="q" vid="ISA 1:8">ítara kei aban uburugu le geyeguti ágani lau.<verse eid="ISA 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 1:9" />Lun hamuga mígirun lan Wabureme Suntigabafu fiu wádangiñe,</para>
  <para style="q" vid="ISA 1:9">ítara waña hamuga guentó kei Sodoma luma Gomora.<verse eid="ISA 1:9" /></para>
  <para style="s1">Eseriwiduni le tímatimaatibei lun Wabungiute</para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 1:10" />Ábutigu Herusalénna, aganba huméi lererun Wabureme;</para>
  <para style="q" vid="ISA 1:10">huguya le hanarimebei huriban kei Sodomana hama Gomorana.<verse eid="ISA 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 1:11" />Lariñahare Wabureme:</para>
  <para style="q" vid="ISA 1:11">«Ka uagu hanüga saragu idewesei nun?</para>
  <para style="q" vid="ISA 1:11">Buchá nuagu lubá hadagaragüdün le gudawarügüti</para>
  <para style="q" vid="ISA 1:11">ha mudún luma hagüle bágasu ñǘbürigiña;</para>
  <para style="q" vid="ISA 1:11">mínsiñeti hata bágasu wügüriña nun,</para>
  <para style="q" vid="ISA 1:11">ni hata mudún ni hata gábara ñǘbürigiña.<verse eid="ISA 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 1:12" />Ñǘbuintün arufudagua hungua nigibugiñe;</para>
  <para style="q" vid="ISA 1:12">gama lumoun, kagia ariñagubei hun lun hadügüraguni tibürürün nitenpulun?<verse eid="ISA 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 1:13" />Hebé hanügün idewesei málati nun,</para>
  <para style="q" vid="ISA 1:13">magundantina lau lugumulelin.</para>
  <para style="q" vid="ISA 1:13">Watün houn lílana fulasu</para>
  <para style="q" vid="ISA 1:13">lun hefeduhani iseri hati luma luéyuri emeraaguni,</para>
  <para style="q" vid="ISA 1:13">gama lumoun magundantina lau hefeduhan gürigia ha adaagubaña wuribani.<verse eid="ISA 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 1:14" />Iyereeguti hufedun le lánina iseri hati</para>
  <para style="q" vid="ISA 1:14">luma burí hadamuridagun nun;</para>
  <para style="q" vid="ISA 1:14">gáñigüda lumutina saragu, darí lun mawandun naali lan!<verse eid="ISA 1:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 1:15" />«Dan le hiñuruni húhabu lun hafurieidun,</para>
  <para style="q" vid="ISA 1:15">digí numuti narihin huéi;</para>
  <para style="q" vid="ISA 1:15">ani íbini hafurieidun saragu,</para>
  <para style="q" vid="ISA 1:15">maganbun numutün.</para>
  <para style="q" vid="ISA 1:15">Dáseihali húhabu lau hitaü.<verse eid="ISA 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 1:16" />Chibagua humá hungua, haruma humá!</para>
  <para style="q" vid="ISA 1:16">Direi huméi huriban luéi narihin!</para>
  <para style="q" vid="ISA 1:16">Hebé hadügün wuribani!<verse eid="ISA 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 1:17" />Furendei huméi ladügǘn buiti,</para>
  <para style="q" vid="ISA 1:17">áfaagua humá lun hadügüni le richabei,</para>
  <para style="q" vid="ISA 1:17">íderagua huméi le asufurirubei,</para>
  <para style="q" vid="ISA 1:17">ru huméi haricha méteñuhaña houn</para>
  <para style="q" vid="ISA 1:17">íderagua humaña würiña hilaguaaña úmarigu!»<verse eid="ISA 1:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ISA 1:18" />Lariñahare Wabureme:</para>
  <para style="q" vid="ISA 1:18">«Higougu, wadimureha libügürü katei le.</para>
  <para style="q" vid="ISA 1:18">Íbini anhein funá lubéi hifigoun kei lagumuhóun ífunani,</para>
  <para style="q" vid="ISA 1:18">náharudagüdübei kei niewe;</para>
  <para style="q" vid="ISA 1:18">íbini ítara lan kei gamisa féindiwatu lau funafunaguti,</para>
  <para style="q" vid="ISA 1:18">náharudagüdübei kei mouru.<verse eid="ISA 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 1:19" />Anhaün ǘnabudaguagüda hungua ani gaganbadi huguyame nun,</para>
  <para style="q" vid="ISA 1:19">héigiba lídangiñe lubuidun-agei alubahani le líchugubei múa;<verse eid="ISA 1:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 1:20" />Gama lumoun anhaün ítarameme lau humaganbadin,</para>
  <para style="q" vid="ISA 1:20">hóunweguba wuriburugu».</para>
  <para style="q" vid="ISA 1:20">Wabureme guánarügü ariñagubalin.<verse eid="ISA 1:20" /></para>
  <para style="s1">Larumadagüdübei Wabureme Herusalén</para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 1:21" />Uburugu gúnfuliti,</para>
  <para style="q" vid="ISA 1:21">ñǘbuinhadibu lun ítarabadibu lan kei aban horu!</para>
  <para style="q" vid="ISA 1:21">Sun meha gürigia ha aganóubaña bidan,</para>
  <para style="q" vid="ISA 1:21">úarati ani richaguati meha hóuserun,</para>
  <para style="q" vid="ISA 1:21">winwan hagía meha lidan lubudubu,</para>
  <para style="q" vid="ISA 1:21">ánheinti guentó buin haña gáfarahatiña bidan.<verse eid="ISA 1:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 1:22" />Pülata meha buguya, ánheinti guentó, saliguaadibu lun ífeime;</para>
  <para style="q" vid="ISA 1:22">diwéin meha buiti buguya, guentó, dúnaadibu.<verse eid="ISA 1:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 1:23" />Ha agumadihabaña bidan, mabuchahatiña,</para>
  <para style="q" vid="ISA 1:23">hamadagu gürigia wuribatiña ha híwerutiña.</para>
  <para style="q" vid="ISA 1:23">Sun hagía aluguraguatiña houngua luagu seinsu,</para>
  <para style="q" vid="ISA 1:23">áluaha hagía lichugún idewesei houn,</para>
  <para style="q" vid="ISA 1:23">michu hamuti liricha méteñuhali lun,</para>
  <para style="q" vid="ISA 1:23">meberesegúntiña lau tiricha würi to hilaali túmari.<verse eid="ISA 1:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="ISA 1:24" />Ligía lariñagunbei Wabureme Suntigabafu le Lubungiute Ísüraeli;</para>
  <para style="q" vid="ISA 1:24">Buídurügaali! Nageindaguba hama náganiñu,</para>
  <para style="q" vid="ISA 1:24">nafayeiragüdübaña luagu hadüga.<verse eid="ISA 1:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 1:25" />Niñurayabei núhabu buagun,</para>
  <para style="q" vid="ISA 1:25">ábame náguduni bíñebu sunsuinagubei;</para>
  <para style="q" vid="ISA 1:25">narumadagüdübadibu lídangiñe sun biwiye.<verse eid="ISA 1:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 1:26" />Nadügüba lunya ñein hamá aguseragüdütiña bidan kei meha furumiñe</para>
  <para style="q" vid="ISA 1:26">hama eweridihatiña kei meha ha furumiñetiña.</para>
  <para style="q" vid="ISA 1:26">Lárigiñeme nadügüni lira, ábayame laguarún bun</para>
  <para style="q" vid="ISA 1:26">«Uburugu lánina irichaü», «uburugu gúnfuliti».<verse eid="ISA 1:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="ISA 1:27" />Lau liricha nagumadihan luma nesefuhan,</para>
  <para style="q" vid="ISA 1:27">nesefurubaña lílana Sión lun hagiribudun nun;<verse eid="ISA 1:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 1:28" />Gama lumoun nagünrinchagubaña maganbaditiña hama gafigountiña,</para>
  <para style="q" vid="ISA 1:28">ha ígirutina hóunweguba.<verse eid="ISA 1:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 1:29" />Huguya hanügüba busiganu lau burí tídibu wewe</para>
  <para style="q" vid="ISA 1:29">luma fuluri-agei le wéiribei línsiñe hun,</para>
  <para style="q" vid="ISA 1:29">le ñein lubéi hadüga kultu houn guáriua.<verse eid="ISA 1:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="ISA 1:30" />Ítara huba kei tubana wewe le hilaali,</para>
  <para style="q" vid="ISA 1:30">luma kei aban fuluri-agei le madunariti.<verse eid="ISA 1:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="ISA 1:31" />Liábinba wügüri le hérebei lun ítara lan kei ubanaü sáühali,</para>
  <para style="q" vid="ISA 1:31">liábinme burí katei le ladügübei kei life leñegura watu;</para>
  <para style="q" vid="ISA 1:31">biángubei hagía háguduba lidan aban, ani úabaña kaba lan éñeguchaña.<verse eid="ISA 1:31" /></para>
  <chapter eid="ISA 1" />
  <chapter number="2" style="c" sid="ISA 2" />
  <para style="s1">Larúeihan Bungiu haganagua néchanigu</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 2:1" />Anihán uganu le leresibirubei Isaíasi le liráü Amosu lúmagiñe Wabungiute libügürü Hudá luma Herusalén:<verse eid="ISA 2:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ISA 2:2" />Lidoun burime lagumuhóun dan</para>
  <para style="q" vid="ISA 2:2">lederebuguduba wübü le ñein tubéi litenpulun Wabureme.</para>
  <para style="q" vid="ISA 2:2">Ligíaba wübü íñutima,</para>
  <para style="q" vid="ISA 2:2">íñutimabei sügǘ lau furumiñeguarügü amu wübü.</para>
  <para style="q" vid="ISA 2:2">Sun néchanigu hayabiba lumoun;<verse eid="ISA 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 2:3" />hayabiba saragu gürigia ariñageina:</para>
  <para style="q" vid="ISA 2:3">«Higougu, warí wamá luagun luwübüri Wabureme,</para>
  <para style="q" vid="ISA 2:3">tidoun litenpulun Lubungiute Hakobu,</para>
  <para style="q" vid="ISA 2:3">arufuda láamugei lémeri woun,</para>
  <para style="q" vid="ISA 2:3">gayara láamuga wéibugun lidan lémeri.</para>
  <para style="q" vid="ISA 2:3">Ladüga Sióngiñeba láfurida larufudahan Wabungiute,</para>
  <para style="q" vid="ISA 2:3">Herusaléngiñeme lererun».<verse eid="ISA 2:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 2:4" />Laguseragüdüba Wabureme hadan néchanigu,</para>
  <para style="q" vid="ISA 2:4">ladeinhaba giñe houn saragu gürigia.</para>
  <para style="q" vid="ISA 2:4">Ábame hadaagun hu tídangiñe hefeinte,</para>
  <para style="q" vid="ISA 2:4">adüga hagíame líbaaha sagadi lau harufunte.</para>
  <para style="q" vid="ISA 2:4">Mageindagunhalime aban néchani luma ábanya,</para>
  <para style="q" vid="ISA 2:4">mibihin hagíame arufudahani lun wuribu.<verse eid="ISA 2:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 2:5" />Higougu lumutuniña Hakobu,</para>
  <para style="q" vid="ISA 2:5">éibuga wamá lidan lilanpun Wabureme!<verse eid="ISA 2:5" /></para>
  <para style="s1">Laguseragüdün Wabureme</para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 2:6" />Wabureme, ígira baaña bumutuniña ha lílana Ísüraeli,</para>
  <para style="q" vid="ISA 2:6">buin liña fulasu hau garíaahatiña</para>
  <para style="q" vid="ISA 2:6">ha ñǘbuinbaña luéigiñe oubaü le ñéingiñe lubéi laboucha weyu</para>
  <para style="q" vid="ISA 2:6">buin liña hau búyeigu kei hadan Filistéana,</para>
  <para style="q" vid="ISA 2:6">aba hadaagun daradu hama terencha.<verse eid="ISA 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 2:7" />Buin liña fulasu lau golu luma pülata, lau saragu irisini</para>
  <para style="q" vid="ISA 2:7">buin liña fulasu hau gabayu tuma saragu karü.<verse eid="ISA 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 2:8" />Gama lumoun buin liña giñe hau guáriuagu!</para>
  <para style="q" vid="ISA 2:8">Huduguatiña gürigia houn búngiugu ha hadüga lau háhabu,</para>
  <para style="q" vid="ISA 2:8">ha hadüga lau hafinga guánarügü.<verse eid="ISA 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 2:9" />Ǘnabudaguagüdaaña houngua.</para>
  <para style="q" vid="ISA 2:9">Ualá ferudunabániña!<verse eid="ISA 2:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 2:10" />Hebeluruba burí gürigia labadinaguóun dübü, lábugiñoun múa;</para>
  <para style="q" vid="ISA 2:10">haramudaguba luéi harihini lanarime ligañi Wabureme,</para>
  <para style="q" vid="ISA 2:10">luéi lámirihan luéirigun.<verse eid="ISA 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 2:11" />Ha barüguabaña houngua, habuluchaguba,</para>
  <para style="q" vid="ISA 2:11">ha íñugubei hanaagun houngua, hǘnabudawagüdüba.</para>
  <para style="q" vid="ISA 2:11">Waburemerügüba arufudei luéirigun lidan weyu ligía.<verse eid="ISA 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 2:12" />Danme le lachülürün luéyuri Wabureme Suntigabafu</para>
  <para style="q" vid="ISA 2:12">kóntürabei sun ha barüguabaña houngua,</para>
  <para style="q" vid="ISA 2:12">ha íñugubei hanaagun houngua lun lǘnabudagüdüniña;<verse eid="ISA 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 2:13" />kóntüra sun ha íñugubei hasandiragun houngua</para>
  <para style="q" vid="ISA 2:13">kei hibúari le Líwanuna,</para>
  <para style="q" vid="ISA 2:13">odi kei lan tídibu ensina le Basanna;<verse eid="ISA 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 2:14" />kóntüra sun ha asandiragubaña houngua</para>
  <para style="q" vid="ISA 2:14">kei wübü burí íñuti,<verse eid="ISA 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 2:15" />kóntüra sun ha asandiragubaña houngua</para>
  <para style="q" vid="ISA 2:15">kei wáyelesi íñuti o baríeiru lauti dübü le derebuguti.<verse eid="ISA 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 2:16" />Kóntüra sun ha asandiragubaña houngua</para>
  <para style="q" vid="ISA 2:16">kei ugunei Tárüsisina o waporu buíduburitu.<verse eid="ISA 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 2:17" />Sun ha barüguabaña houngua,</para>
  <para style="q" vid="ISA 2:17">háünabudawagüdüba sunsuinagubei.</para>
  <para style="q" vid="ISA 2:17">Waburemerügübei arufudei luéirigun lídanme weyu ligía,<verse eid="ISA 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 2:18" />ábame lagumuchun hau sun guáriua.<verse eid="ISA 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 2:19" />Danme liabin Wabureme</para>
  <para style="q" vid="ISA 2:19">lun labuinchagüdüni ubóu lau anufudei,</para>
  <para style="q" vid="ISA 2:19">hebeluruba burí gürigia lagadábugiñoun dübü,</para>
  <para style="q" vid="ISA 2:19">lidoun burí huyu le múarugubei;</para>
  <para style="q" vid="ISA 2:19">haramudaguba luéi lanarime ligañi Wabureme,</para>
  <para style="q" vid="ISA 2:19">luéi lámirihan luéirigun.<verse eid="ISA 2:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="ISA 2:20" />Lídanme weyu ligía,</para>
  <para style="q" vid="ISA 2:20">hachagarubaña gürigia habungiutegu</para>
  <para style="q" vid="ISA 2:20">houn garadun luma houn búriri,</para>
  <para style="q" vid="ISA 2:20">habungiute ha pülata luma golu,</para>
  <para style="q" vid="ISA 2:20">ha hadügübaña lau háhabu guánarügü</para>
  <para style="q" vid="ISA 2:20">lun háhuduragun houn,<verse eid="ISA 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 2:21" />ábame burí hádaragun houngua lidoun luhuyun dübü,</para>
  <para style="q" vid="ISA 2:21">luma lagadábugiñoun dübü wéinamuti,</para>
  <para style="q" vid="ISA 2:21">lun haramudagun luéi lanarime ligañi Wabureme,</para>
  <para style="q" vid="ISA 2:21">luéi laruni luéirigun,</para>
  <para style="q" vid="ISA 2:21">danme liabin lun labuinchagüdüni ubóu lau anufudei.<verse eid="ISA 2:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="ISA 2:22" />Hebé hemenigidun hawagu gürigia, ladüga ni kata hagía.</para>
  <para style="q" vid="ISA 2:22">Ítara liña habagari gürigia kei aban awaraguni.<verse eid="ISA 2:22" /></para>
  <chapter eid="ISA 2" />
  <chapter number="3" style="c" sid="ISA 3" />
  <para style="s1">Labeichún Hudá luma Herusalén</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 3:1" />Ariha humá! Lagidarubaña Wabureme</para>
  <para style="q" vid="ISA 3:1">sun hawuyeri íchaahatiña éigini Herusaléngiñe luma Hudá</para>
  <para style="q" vid="ISA 3:1">úaarume ni fein, ni íbini duna.<verse eid="ISA 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 3:2" />Lagidarubaña ha ganigibaña, wuriburuguna,</para>
  <para style="q" vid="ISA 3:2">aguseragüdütiña, profetagu, gabiñegutiña, ábutigu,<verse eid="ISA 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 3:3" />úfisigu, wéirigutiña, eweridihatiña,</para>
  <para style="q" vid="ISA 3:3">gadiñetiña hama gayanuhaditiña.<verse eid="ISA 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 3:4" />Ábame líchugun nibureingiña ábutigume;</para>
  <para style="q" vid="ISA 3:4">irahüñüba agumadiraña.<verse eid="ISA 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 3:5" />Hanarimenóugabei fulasurugu</para>
  <para style="q" vid="ISA 3:5">íbinime umadagu hageindaguba hámagua,</para>
  <para style="q" vid="ISA 3:5">hiñuraguba nibureingiña houngua hawagun wéiyaaña mutu,</para>
  <para style="q" vid="ISA 3:5">iñuragua hagíame ha meberesenwabei hau hawagun gürigia ha wéirigubaña.<verse eid="ISA 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 3:6" />Lariñaguba aban íbiri lun aban líbiri lúbiñe háguchi:</para>
  <para style="q" vid="ISA 3:6">«Buguya, anuheinraü daüguaü buma lun badaürünu,</para>
  <para style="q" vid="ISA 3:6">buguyalá wábuti, agumadihabá lidan fulasu günringuaali le».<verse eid="ISA 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 3:7" />Lóunabeime le aban, lariñagame lun:</para>
  <para style="q" vid="ISA 3:7">«Au siñati nagaranihan lun wuribani le,</para>
  <para style="q" vid="ISA 3:7">úati éigini numa núbiñe,</para>
  <para style="q" vid="ISA 3:7">ua daüguaü numa lun nadaürünu.</para>
  <para style="q" vid="ISA 3:7">Míchiga humana lábutime fulasu».<verse eid="ISA 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 3:8" />Inarüni, lagünrichawagua Herusalén,</para>
  <para style="q" vid="ISA 3:8">leredera Hudá málouga,</para>
  <para style="q" vid="ISA 3:8">lagumuchaguba ladüga ariñawagúati</para>
  <para style="q" vid="ISA 3:8">adügǘwa ligía burí katei ñein le magundanti Wabureme lau,</para>
  <para style="q" vid="ISA 3:8">katei le burí anabaguti luéirigun Wabungiute.<verse eid="ISA 3:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 3:9" />Hagía guánarügü arufuda hamuti hadurun lau hóuserun;</para>
  <para style="q" vid="ISA 3:9">maramudun hamuti hafigoun;</para>
  <para style="q" vid="ISA 3:9">arufuda hamuti lun sun ubóu kei Sodoma.</para>
  <para style="q" vid="ISA 3:9">Fugiabugu hagía, ladüga hagía guánarügü aranseha hamuti habeichún!<verse eid="ISA 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 3:10" />Fuleseiwatiña gürigia ha richaguabaña,</para>
  <para style="q" vid="ISA 3:10">ladüga buídubei lidin houn</para>
  <para style="q" vid="ISA 3:10">ani gúndaabaña lau le hadügübei.<verse eid="ISA 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 3:11" />Fugiabugu ha wuribabaña, ladüga wuribabei lidin houn!</para>
  <para style="q" vid="ISA 3:11">Lafayeiragüdübaña Wabungiute luagu le hadügübei.<verse eid="ISA 3:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 3:12" />Aban nibureingili, ligía ábutibei lau erei hadan nánigu;</para>
  <para style="q" vid="ISA 3:12">háhaburuguñein würiña gumadi,</para>
  <para style="q" vid="ISA 3:12">numutuniña, heyeeduñadün ha agumadirubalün,</para>
  <para style="q" vid="ISA 3:12">wuribati üma le ñéingiñe lubéi hanügaün.<verse eid="ISA 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 3:13" />Aransehali Wabureme lun laguseragüdün,</para>
  <para style="q" vid="ISA 3:13">aranseli lun laguseragüdüniña lumutuniña.<verse eid="ISA 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 3:14" />Lagúaruba Wabureme aban guséi,</para>
  <para style="q" vid="ISA 3:14">lariñagame houn wéiyaaña mutu luma houn lábutigu fulasu:</para>
  <para style="q" vid="ISA 3:14">Huguya, hagünrinchaguáñahañoun ninadürigu beibei,</para>
  <para style="q" vid="ISA 3:14">íweruhaadün hawéi gudemetiña,</para>
  <para style="q" vid="ISA 3:14">aba hareiduni le híweruhabei húbiñe.<verse eid="ISA 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 3:15" />Kati uagu hasufuriragüdaña numutuniña,</para>
  <para style="q" vid="ISA 3:15">dügügua huméi haricha gudemetiña?</para>
  <para style="q" vid="ISA 3:15">Au le Aburemei ariñagubalin.<verse eid="ISA 3:15" /></para>
  <para style="s1">Habeichún würiña Herusalénna</para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 3:16" />Lariñahare giñe Wabureme:</para>
  <para style="q" vid="ISA 3:16">«Würiña ha lílana Sión, ha pántabaña,</para>
  <para style="q" vid="ISA 3:16">ha éibugubaña lau hachügü iñurañu, aríagueina lau pantaü,</para>
  <para style="q" vid="ISA 3:16">areincheina hagía lau luenden hagudi,<verse eid="ISA 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 3:17" />nígirubaña mádiburiga ladüga lisandi lura hachügü,</para>
  <para style="q" vid="ISA 3:17">ábame narufuduni hágubu surusu».<verse eid="ISA 3:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ISA 3:18" />Lídanme weyu ligía,</para>
  <para style="q" vid="ISA 3:18">lagidarubei Wabureme sun uéndeni le hayusurubei würiña;</para>
  <para style="q" vid="ISA 3:18">luagu hagudi, hachügü luma luagu hagiina:<verse eid="ISA 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 3:19" />arigeilaü, bángüli tuma belu,<verse eid="ISA 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 3:20" />liribante ichügü, iñari lánina ugudi,</para>
  <para style="q" vid="ISA 3:20">béliti, lirahüñü lagei ibiñein, lúyawa uraü,<verse eid="ISA 3:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 3:21" />bagü, luenden ígiri,<verse eid="ISA 3:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 3:22" />dúnigu buíduburitu, manda, idáü tuma burí posu,<verse eid="ISA 3:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 3:23" />isubusei, gamisa fínutu, búnedu, musue.<verse eid="ISA 3:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 3:24" />Ínginiba eredera leweñegua ibiñein;</para>
  <para style="q" vid="ISA 3:24">gúrudu leweñegua béliti;</para>
  <para style="q" vid="ISA 3:24">ábulugu heluti leweñegua aruraguni wéndeguti;</para>
  <para style="q" vid="ISA 3:24">gamisa súsutu teweñegua dúnigu fínutu;</para>
  <para style="q" vid="ISA 3:24">lumakün gürabu süti leweñegua magadiñein.<verse eid="ISA 3:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 3:25" />Hábürühaba buwügüriñanigu wuriburugu,</para>
  <para style="q" vid="ISA 3:25">hóunweguba bánigu wuriburuguna lidan wuribu.<verse eid="ISA 3:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 3:26" />Hayahuahaba lílana uburugu, ábame hamuiserun,</para>
  <para style="q" vid="ISA 3:26">eredereina ligíame uburugu málouga.<verse eid="ISA 3:26" /></para>
  <chapter eid="ISA 3" />
  <chapter number="4" style="c" sid="ISA 4" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 4:1" />Míbebaña wügüriña erederutiña lídanme weyu ligía,</para>
  <para style="q" vid="ISA 4:1">darime lun hageindagun sedü würiña luagu aban wügüri,</para>
  <para style="q" vid="ISA 4:1">hariñagame lun: «Wagüriaguba woungua,</para>
  <para style="q" vid="ISA 4:1">agañeiha wamounme wadaüragun woungua,</para>
  <para style="q" vid="ISA 4:1">wabusenrúnrügüñein lun wanügüni biri,</para>
  <para style="q" vid="ISA 4:1">sefubáwa luéi wabusigari luagu werederun mámariga».<verse eid="ISA 4:1" /></para>
  <para style="s1">Füramasei lánina ugundani lun Herusalén</para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 4:2" />Lídanme weyu ligía,</para>
  <para style="q" vid="ISA 4:2">iseri láhüchagun ídibu le lunbei liñuraguni Wabureme,</para>
  <para style="q" vid="ISA 4:2">ligíaba hawendegun luma haweirigun</para>
  <para style="q" vid="ISA 4:2">ha lúnbaña herederun wínwanñu Ísüraeli;</para>
  <para style="q" vid="ISA 4:2">le burime alubahóuni le lunbei líchuguni múa,</para>
  <para style="q" vid="ISA 4:2">ligíaba hapantagüle luma henebese.<verse eid="ISA 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 4:3" />Hame erederutiña wínwanñu Sión,</para>
  <para style="q" vid="ISA 4:3">luma Herusalén, redei hagíame aganawa ñein,</para>
  <para style="q" vid="ISA 4:3">lagúaruba houn «lánigu Wabureme».<verse eid="ISA 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 4:4" />Danme le lasiadihan Wabureme</para>
  <para style="q" vid="ISA 4:4">ani beigua láñame ha lúnbaña labeichuniña,</para>
  <para style="q" vid="ISA 4:4">larumadagüdübei Herusalén lídangiñe hitaü,</para>
  <para style="q" vid="ISA 4:4">chibaléime dáseiti le hawagubei lílana Sión.<verse eid="ISA 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 4:5" />Lóunahaba Wabureme aba huánriñu búrigati wéyuagu lóugiñe luwübüri Sión</para>
  <para style="q" vid="ISA 4:5">luma larugounga watu gemeti áriebu.</para>
  <para style="q" vid="ISA 4:5">Ñeinbei luéirigun Wabureme hóugiñe súngubei,<verse eid="ISA 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 4:6" />lun lóunigiruniña luma lun ladouragun hau,</para>
  <para style="q" vid="ISA 4:6">lichugúba lamuñounga houn luéi lárouga wéyuagu</para>
  <para style="q" vid="ISA 4:6">darugua ligíame hau luéi huya luma luéi luriban dan.<verse eid="ISA 4:6" /></para>
  <chapter eid="ISA 4" />
  <chapter number="5" style="c" sid="ISA 5" />
  <para style="s1">Lubeibei-agei Bungiu</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 5:1" />Lidan liri numada létima numada,</para>
  <para style="q" vid="ISA 5:1">nagúaraali uremu le, tuáguti linadürigu beibei.</para>
  <para style="b" vid="ISA 5:1" />
  <para style="q" vid="ISA 5:1">Ñeinñein bugaha aban ichari tau beibei luma numada</para>
  <para style="q" vid="ISA 5:1">lidan aban múa le arandarati.<verse eid="ISA 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 5:2" />Aba laranseruni múa, gidalei burí dübü lídangiñe</para>
  <para style="q" vid="ISA 5:2">aba lábunaguni lau lubuidun-agei beibei.</para>
  <para style="q" vid="ISA 5:2">Aba ladügün aban wáyelesi lamidangua bunaguaü,</para>
  <para style="q" vid="ISA 5:2">aranse ligía aban fulasu le ñeinba lubéi tadügǘwa diwéin,</para>
  <para style="q" vid="ISA 5:2">agurabati yebe numada lalubahan beibei to bímetu</para>
  <para style="q" vid="ISA 5:2">gama lumoun beibei garühütu ñǘbuinboun lun.<verse eid="ISA 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 5:3" />Guentoti lariñaga numada:</para>
  <para style="q" vid="ISA 5:3">«Lílana Herusalén, gürigia Hudaana,</para>
  <para style="q" vid="ISA 5:3">ariñaga huméi ka lan gadurunbei,</para>
  <para style="q" vid="ISA 5:3">anhein nichari lubéi odi au lan.<verse eid="ISA 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 5:4" />Anihein san amu katei lun nadügüni lun nichari?</para>
  <para style="q" vid="ISA 5:4">Anihein san katei madügün numuti lun?</para>
  <para style="q" vid="ISA 5:4">Agurabatina yebe líchugun beibei bímetu,</para>
  <para style="q" vid="ISA 5:4">Kati uagu líchugunbei beibei garühütu?<verse eid="ISA 5:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 5:5" />«Nariñagaali hun katei lan naritagubei nadügün lun nichari:</para>
  <para style="q" vid="ISA 5:5">Nagidaraali lubarieirun luéi, günrinwagua láamuga;</para>
  <para style="q" vid="ISA 5:5">nadaagua huyu luagu lubarieirun lun ladügürawagun;<verse eid="ISA 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 5:6" />nígiraali lungua.</para>
  <para style="q" vid="ISA 5:6">Matirimuhóunbei burí tídibu beibei le ñeinbei,</para>
  <para style="q" vid="ISA 5:6">magidahóun ligíame híduru luéi,</para>
  <para style="q" vid="ISA 5:6">ábame labuinchun lau hiiyu luma híduru wuribati.</para>
  <para style="q" vid="ISA 5:6">Nariñaga lun dúeri lun máhuyun lan huya luagun».<verse eid="ISA 5:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 5:7" />Ísüraeli ligía linadürigubei Suntigabafu le hínsiñetimabei lun</para>
  <para style="q" vid="ISA 5:7">lílana Hudá ligía fuluri-agei le aubei lagundaara.</para>
  <para style="q" vid="ISA 5:7">Agurabati yebe Wabureme lun yebe inebebei lan lilurudun houn,</para>
  <para style="q" vid="ISA 5:7">ladarirarüga áfarahani,</para>
  <para style="q" vid="ISA 5:7">agurabati yebe irichaü</para>
  <para style="q" vid="ISA 5:7">ladarirarüga agúarahani lánina igarigu.<verse eid="ISA 5:7" /></para>
  <para style="s1">Dimurei hawaguti wuribatiña</para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 5:8" />Fugiabugu huguya ha agañeihabaña saragu muna,</para>
  <para style="q" vid="ISA 5:8">huguya le ibihubei saragu ichari,</para>
  <para style="q" vid="ISA 5:8">darí lun mígirun humá ubaraü lun ni aban,</para>
  <para style="q" vid="ISA 5:8">aranseraguatün hungua kamá huguyarügüñein fulasurugu!<verse eid="ISA 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 5:9" />Fiñuhali Wabureme Suntigabafu ariñaga nun:</para>
  <para style="q" vid="ISA 5:9">«Tagünrinchawaguba saragu muna;</para>
  <para style="q" vid="ISA 5:9">ani lau sun tuéinamun ani buidu burí tuguya,</para>
  <para style="q" vid="ISA 5:9">úabaña aganóutiña tidan.<verse eid="ISA 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 5:10" />Darandi milu méturu ábunawaguti tau beibei,</para>
  <para style="q" vid="ISA 5:10">ábanrügübei liraüraü barín diwéin líchugun.</para>
  <para style="q" vid="ISA 5:10">Diisi sagü ilaü, ábanrügüboun sagü türigu líchugun».<verse eid="ISA 5:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ISA 5:11" />Fugiabugu huguya,</para>
  <para style="q" vid="ISA 5:11">ha saragiabaña lun houdin abacharuada, darí laguñeedun!<verse eid="ISA 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 5:12" />Lidan hufedun, afarúatu sun tuwuyeri árüpa, garanwoun tuma fidu,</para>
  <para style="q" vid="ISA 5:12">luma saragu diwéin lun hátagun;</para>
  <para style="q" vid="ISA 5:12">gama lumoun metenitün lun le ladügübei Wabureme,</para>
  <para style="q" vid="ISA 5:12">mebereseguntün lau luadigimari.<verse eid="ISA 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 5:13" />Ladüga lubeiti hamahan numutuniña gunfuranda hamá,</para>
  <para style="q" vid="ISA 5:13">hasagaruba hageiragiñe lidoun amu fulasu.</para>
  <para style="q" vid="ISA 5:13">Sun lílana fulasu hau sun hábutigu,</para>
  <para style="q" vid="ISA 5:13">láfaragubaña ilamaü luma mágürabu.<verse eid="ISA 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 5:14" />Wagaguati umúahaü kei animaalu gáñiti,</para>
  <para style="q" vid="ISA 5:14">lun láhuluchuniña lílana fulasu hau sun hábutigu,</para>
  <para style="q" vid="ISA 5:14">gürigia ha aganóubaña lidan hagundan.<verse eid="ISA 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 5:15" />Herederuba gürigia lau ǘnabugubuni le gumuti,</para>
  <para style="q" vid="ISA 5:15">habuluchaguba ha pántabaña.<verse eid="ISA 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 5:16" />Larufudubei Wabureme Suntigabafu luéirigun lidan guséi;</para>
  <para style="q" vid="ISA 5:16">Larufudubei Wabungiute le Sándubei luagu sandu lan,</para>
  <para style="q" vid="ISA 5:16">lau laguseragüdün lau irichaü.<verse eid="ISA 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 5:17" />Lagünrinchawaguba burí uburugu,</para>
  <para style="q" vid="ISA 5:17">ábame heigin mudún hama gábara sagadi lidan lárigirugu.<verse eid="ISA 5:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ISA 5:18" />Fugiabugu huguya, huguya le aduruuhabalin wuribani lau hiyeeni;</para>
  <para style="q" vid="ISA 5:18">huguya le aduruuhabalin figóu kei tachawahóun aban karü!<verse eid="ISA 5:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 5:19" />Huguya le ariñagubei:</para>
  <para style="q" vid="ISA 5:19">«Adügaléi Wabungiute le lunbei ladügüni furese, ariha wamaamugei;</para>
  <para style="q" vid="ISA 5:19">gúnfulilei Lubungiute Ísüraeli le sándubei laransehan, subudi wamaamugei».<verse eid="ISA 5:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="ISA 5:20" />Fugiabugu huguya le agúarubei lun le buídubei wuribati,</para>
  <para style="q" vid="ISA 5:20">hagúara lun le wuribabei buiti;</para>
  <para style="q" vid="ISA 5:20">huguya le aburigadagüdübalin larugounga,</para>
  <para style="q" vid="ISA 5:20">harugoungadagüda luburiga;</para>
  <para style="q" vid="ISA 5:20">huguya le agifidagüdübalin le bímebei,</para>
  <para style="q" vid="ISA 5:20">bímegüda huméi le gífibei!<verse eid="ISA 5:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="ISA 5:21" />Fugiabugu huguya le anaagubei hungua kei chu tau,</para>
  <para style="q" vid="ISA 5:21">haritagun, luagu huali lan hichügü!<verse eid="ISA 5:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="ISA 5:22" />Fugiabugu huguya le anügübalin furumiñeti fulasu</para>
  <para style="q" vid="ISA 5:22">lidan latuniwa diwéin,</para>
  <para style="q" vid="ISA 5:22">ani úati ni aban agañeirutün lidan tachouhóun diwéin!<verse eid="ISA 5:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 5:23" />Huguya le agidarubalin lidurun le gadurunbei luagu seinsu,</para>
  <para style="q" vid="ISA 5:23">ani michu humuti liricha le madurunbei lun.<verse eid="ISA 5:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 5:24" />Ligía ítara lubéi kei láguduni watu gemeti sagadi sáühali,</para>
  <para style="q" vid="ISA 5:24">ítara kei lagumuchaguagüdüni watu gemeti ubanaü sáühali</para>
  <para style="q" vid="ISA 5:24">ítara luba giñe hagumuchagun,</para>
  <para style="q" vid="ISA 5:24">kei nadü to añaladuti tílagüle,</para>
  <para style="q" vid="ISA 5:24">aba lagumuchagun tufulurin kei kaliki.</para>
  <para style="q" vid="ISA 5:24">Ladüga híchugun mebereseni lun larufudahan</para>
  <para style="q" vid="ISA 5:24">luma lererun Wabureme Suntigabafu, le Lubungiute Ísüraeli le Sándubei.<verse eid="ISA 5:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 5:25" />Ligía lagañidunbei Wabureme hama lumutuniña,</para>
  <para style="q" vid="ISA 5:25">aba liñuruni lúhabu lun labeichuniña.</para>
  <para style="q" vid="ISA 5:25">Hingiburiti wübü,</para>
  <para style="q" vid="ISA 5:25">rédeiti burí hágubu hilaaña ǘmadarugu chagagu kei ifei múarugu.</para>
  <para style="q" vid="ISA 5:25">Gama lumoun lau sun lira, magalumarúngili ligañi Wabureme,</para>
  <para style="q" vid="ISA 5:25">anihamémegua ayawadagua.<verse eid="ISA 5:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="ISA 5:26" />Iñurati Wabureme aban fanidira,</para>
  <para style="q" vid="ISA 5:26">aba línwinrun agúara lun aban néchani dísegiñeti;</para>
  <para style="q" vid="ISA 5:26">lídangiñe lidise-agei ubóu liábingüdei.</para>
  <para style="q" vid="ISA 5:26">Aba liabin furese, chülüti óufuda.<verse eid="ISA 5:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 5:27" />Úati débiliti ni bucharuaali hadan,</para>
  <para style="q" vid="ISA 5:27">agagudúañu haña sun hagía buidu,</para>
  <para style="q" vid="ISA 5:27">gürañu habelitin buidu,</para>
  <para style="q" vid="ISA 5:27">úati ni aban lau tagürüga ligeidin hüchüguaali hadan.<verse eid="ISA 5:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 5:28" />Gágiritu hagimaran buidu, deregüda tebu buidu.</para>
  <para style="q" vid="ISA 5:28">Ítara liña lúbara hagudi halügüniña gabayu kei dübü dereti,</para>
  <para style="q" vid="ISA 5:28">ítara liña tubalaba hakarün kei aban hiriri;<verse eid="ISA 5:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 5:29" />Ítara liña hadürürühan kei ladürürühan aban liñún,</para>
  <para style="q" vid="ISA 5:29">le áünhabei aban lárügüdüni líliru,</para>
  <para style="q" vid="ISA 5:29">aba lidin lau úouga kaba lan agidarei luéi.<verse eid="ISA 5:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="ISA 5:30" />Néchani ligía, danme lachülürün weyu,</para>
  <para style="q" vid="ISA 5:30">lahuuhaba kei barana luagun Ísüraeli;</para>
  <para style="q" vid="ISA 5:30">ani anhein ñein arihiti ubóu,</para>
  <para style="q" vid="ISA 5:30">larihubei hóuburagu lidan luburiga</para>
  <para style="q" vid="ISA 5:30">búrime larihini larugounga ladüga liduru huánriñu.<verse eid="ISA 5:30" /></para>
  <chapter eid="ISA 5" />
  <chapter number="6" style="c" sid="ISA 6" />
  <para style="s1">Laguarún lun Isaíasi</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 6:1" />Lidan irumu le lóunwegülebei urúei Usíasi, aba narihini Wabureme ñun luagu aban lala urúei íñuti; buintu ténpulu lau taru lumandan. <verse eid="ISA 6:1" /><verse number="2" style="v" sid="ISA 6:2" />Ñéinñanu fiu kátaña kamá láutiña watu gemeti lóugiñe. Sísiñein larüna kada aban hádangiñe, lau bián arünaü hadouragua lau hagibu, lau biama hadouragua lau ǘnabu libiti hágubu, lau le líbiri biama háhamaha. <verse eid="ISA 6:2" /><verse number="3" style="v" sid="ISA 6:3" />Aba burí hariñagun hámagua:</para>
  <para style="b" vid="ISA 6:3" />
  <para style="q" vid="ISA 6:3">«Sandu, sandu, sánduti Wabureme Suntigabafu;</para>
  <para style="q" vid="ISA 6:3">buin liña sun ubóu lau luéirigun».<verse eid="ISA 6:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="ISA 6:4" />Dan le laganbúnbei umalali ligía, aba ladadagarunga tubenari ténpulu, aba tabuinchun ténpulu lau gumuleli. <verse eid="ISA 6:4" /><verse number="5" style="v" sid="ISA 6:5" />Aba nariñagun núnguarügü:</para>
  <para style="p" vid="ISA 6:5">—Fugiabu au, nounwe! Ariha naali Urúei Wabureme Suntigabafu lau nagu; au, aban wügüri le wíyeti niyuma, ani hadan gürigia wiye tiyuma naganawa.<verse eid="ISA 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 6:6" />Lidan dan ligía, aba láhamarun aban hádangiñe kátaña hagía ha ítarabaña kei watu gemeti, aba liabin nuagun. Ñeinñein aban leñegura watu luma ragüñuléi tau aban tenasa, leñegura watu ligía luéigiñe latarü lanügei, <verse eid="ISA 6:6" /><verse number="7" style="v" sid="ISA 6:7" />aba laguuruni niyuma lau leñegura watu ligía, aba lariñagun nun:</para>
  <para style="b" vid="ISA 6:7" />
  <para style="q" vid="ISA 6:7">«Dagaali leñegura watu le luagu biyuma.</para>
  <para style="q" vid="ISA 6:7">Gidawaali buriban,</para>
  <para style="q" vid="ISA 6:7">ferudunawaali bifigoun»<verse eid="ISA 6:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="ISA 6:8" />Ábati naganbuni lariñagun lumalali Wabureme:</para>
  <para style="q" vid="ISA 6:8">«Kaba san nóunaha?</para>
  <para style="q" vid="ISA 6:8">Kaba ñüdün lau uganu?»</para>
  <para style="b" vid="ISA 6:8" />
  <para style="p" vid="ISA 6:8">Aba nóunabun:</para>
  <para style="q" vid="ISA 6:8">«Anahán, óunahabana».<verse eid="ISA 6:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="ISA 6:9" />Aba lariñagun nun:</para>
  <para style="q" vid="ISA 6:9">«Beiba, bariñagame houn lílana fulasu le:</para>
  <para style="q" vid="ISA 6:9">“Íbini híchugun harigei lun haganbun,</para>
  <para style="q" vid="ISA 6:9">úabei gunfuranda humá.</para>
  <para style="q" vid="ISA 6:9">Íbini híchaagun hungua lun harihin,</para>
  <para style="q" vid="ISA 6:9">mafurendeirúnbadün”.<verse eid="ISA 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 6:10" />Ibidiouguagüdabá lau hasaminan gürigia ha;</para>
  <para style="q" vid="ISA 6:10">darubei harigeirugu luma hagu maganbun hamaamuga,</para>
  <para style="q" vid="ISA 6:10">marihin hagíame ua ligíame gunfuranda hamá,</para>
  <para style="q" vid="ISA 6:10">miabin hamaamuga nun lun nareidaguagüdüniña».<verse eid="ISA 6:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ISA 6:11" />Aba nálügüdüni, nariñaga lun:</para>
  <para style="q" vid="ISA 6:11">«Átiribeigia dan ladurarun katei le, Nabureme?»</para>
  <para style="b" vid="ISA 6:11" />
  <para style="p" vid="ISA 6:11">Lariñaga nun:</para>
  <para style="q" vid="ISA 6:11">«Darime günringuaali sun burí uburugu</para>
  <para style="q" vid="ISA 6:11">ua ligíame ni aban aganóuti ñein;</para>
  <para style="q" vid="ISA 6:11">darime terederun burí muna málouga,</para>
  <para style="q" vid="ISA 6:11">mabei ligíame múa,<verse eid="ISA 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 6:12" />darime láfuridagüdüniña Wabureme gürigia</para>
  <para style="q" vid="ISA 6:12">keisi adaürǘtiña lidoun amu fulasu,</para>
  <para style="q" vid="ISA 6:12">redei ligíame ageiraü málouga sunsuinagubei.<verse eid="ISA 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 6:13" />Íbini ánhaña eredera aban hádangiñe kada diisi lílana fulasu,</para>
  <para style="q" vid="ISA 6:13">hagünrinchawaguba giñe,</para>
  <para style="q" vid="ISA 6:13">ítara kei dan le lachugún aban tídibu wewe to róbüle o aban lan ensina,</para>
  <para style="q" vid="ISA 6:13">ugudinaürügüñein eredera».</para>
  <para style="q" vid="ISA 6:13">(Gama lumoun láhüchaguba ugudinaü ligía, ani sándubei.)<verse eid="ISA 6:13" /></para>
  <chapter eid="ISA 6" />
  <chapter number="7" style="c" sid="ISA 7" />
  <para style="s1">Furumiñeti uganu líchugun Isaíasi lun Aasi</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 7:1" />Dan meha le Aasi lan le liráü Hotamü, libari Usíasi urúeibei Hudá aba liabin Resín le lurúeite Siria luma Peka le liráü Remalíasi lurúeite Ísüraeli, aba hábürühan luagun Herusalén lun yebe hárügüdüni, gama lumoun siñá hamuti. <verse eid="ISA 7:1" /><verse number="2" style="v" sid="ISA 7:2" />Aba hanügüni uganu le lun urúei Asi luma houn liduheñu, hariñaga houn: «Adügaaña Síriana umadaguaü hama ladügawagun Éfürain». Aba lagumeserun urúei hama lílana fulasu adadagara ítara kei ladadagarun burí tídibu wewe dabíararugu dan le láfurun garabali. <verse eid="ISA 7:2" /><verse number="3" style="v" sid="ISA 7:3" />Ábati lariñagun Wabureme lun Isaíasi:</para>
  <para style="p" vid="ISA 7:3">—Barübei Searü-yasubu le biráü, beiba adunragua luma urúei Aasi lígirugu chanili le wéiritimabei, luagu üma le luágunbei tachibaguagüle gamisa, <verse eid="ISA 7:3" /><verse number="4" style="v" sid="ISA 7:4" />bariñagame lun:</para>
  <para style="b" vid="ISA 7:4" />
  <para style="q" vid="ISA 7:4">“Góunigiba gama lumoun malouchabá</para>
  <para style="q" vid="ISA 7:4">manufudedabá madüraagun buguyame</para>
  <para style="q" vid="ISA 7:4">luéi bián leñegura watu agumulahati le.</para>
  <para style="q" vid="ISA 7:4">Resín le, hau lánigu Síriana, luma liráü Remalíasi</para>
  <para style="q" vid="ISA 7:4">ha águdubaña lau igañi.<verse eid="ISA 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 7:5" />Beluhaña Síriana hama lánigu Éfürain luma liráü Remalíasi</para>
  <para style="q" vid="ISA 7:5">lidoun daradu lun hadügün wuribani bun. Ariñagaaña:<verse eid="ISA 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 7:6" />Ábürüha wamá luagun Hudá, da wamá anufudei lidoun;</para>
  <para style="q" vid="ISA 7:6">ragǘ waméi, wíchigeime liráü Taweli urúeime.<verse eid="ISA 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 7:7" />Gama lumoun lariñahare Wabureme:</para>
  <para style="q" vid="ISA 7:7">Masuseredunbei lira!<verse eid="ISA 7:7" /></para>
  <para style="q">
    <verse number="8-9" style="v" sid="ISA 7:8-9" />Damasüku luburugutebei arúeihani Siria,</para>
  <para style="q" vid="ISA 7:8-9">ani Resín lurúeitebei Damasüku.</para>
  <para style="q" vid="ISA 7:8-9">Samaria luburugutebei arúeihani Éfürain,</para>
  <para style="q" vid="ISA 7:8-9">ani liráü Remalíasi lurúeitebei Samaria;</para>
  <para style="q" vid="ISA 7:8-9">gama lumoun yáagiñe lumoun ǘrüwa-wein-seingü irumu,</para>
  <para style="q" vid="ISA 7:8-9">mámaalime néchani Éfürain;</para>
  <para style="q" vid="ISA 7:8-9">ani huguya anhein mederebugu lubéi hafiñen,</para>
  <para style="q" vid="ISA 7:8-9">meredebadün giñe rara”.<verse eid="ISA 7:8-9" /></para>
  <para style="s1">Emanuéli, Bungiu wama</para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 7:10" />Ariñagati giñe Wabureme lun Aasi:<verse eid="ISA 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 7:11" />—Amuriahabá luma Aburemei le Bubungiute lun ladügün aban milaguru lun leseriwidun bun kei seini, ǘnabu yebe lidan lilulin-agei o iñu lan lidan liñun-agei.<verse eid="ISA 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 7:12" />Lariñaga Aasi lun:</para>
  <para style="p" vid="ISA 7:12">—Uá, móuchagun nubéi Wabureme amuriaha seini luma.<verse eid="ISA 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 7:13" />Ábati lariñagun Isaíasi:</para>
  <para style="b" vid="ISA 7:13" />
  <para style="q" vid="ISA 7:13">«Aganba humana huguya le</para>
  <para style="q" vid="ISA 7:13">tílana lúbaana larúeihan Dawidi.</para>
  <para style="q" vid="ISA 7:13">Ni kata san larihín hun hañawarihan houn gürigia,</para>
  <para style="q" vid="ISA 7:13">habusenrubei giñe hañawarihan lun Nubungiute?<verse eid="ISA 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 7:14" />Líchugubati Wabureme guánarügü aban seini hun:</para>
  <para style="q" vid="ISA 7:14">Tadageinaduba aban würi nibureingiru,<note caller="1" style="f"><char style="fr" closed="false">7.14 </char><char style="ft" closed="false">«Alma» lidan Ebüréu würi nibureintu lílabei, marieharu lan yebe o mamarieidungiru lan. Danti labürüdǘn lau güriegu lidan Matéu aba lerederun kei «parthenós» lememe «gañüngiru».</char></note></para>
  <para style="q" vid="ISA 7:14">ábame tagaraüdün aban wügüri irahü,</para>
  <para style="q" vid="ISA 7:14">ábame tíchugun Emanuéli luagu.<verse eid="ISA 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 7:15" />Lidan burime furumiñeti irumu lau irahü,</para>
  <para style="q" vid="ISA 7:15">léigiba burí furumasu luma sírudu.<verse eid="ISA 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 7:16" />Gama lumoun lubaragiñeme lachuurun lau irahü ligía,</para>
  <para style="q" vid="ISA 7:16">lerederuba hageira bián urúeigu ha uéibaña banufudeda málouga.<verse eid="ISA 7:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ISA 7:17" />Lóunahaba Wabureme súfuri buagun,</para>
  <para style="q" vid="ISA 7:17">hawagun lílana bageira</para>
  <para style="q" vid="ISA 7:17">luma hawagun biduheñu</para>
  <para style="q" vid="ISA 7:17">ñeinbei anufudei kei le úagilibei</para>
  <para style="q" vid="ISA 7:17">lúmagiñe lafanreinragun Éfürain luéi Hudá».</para>
  <para style="q" vid="ISA 7:17">Liábinba lurúeite Asiria hau lisudaranigu.<verse eid="ISA 7:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ISA 7:18" />Lídanme dan ligía, ladügüba Wabureme lun hayabin</para>
  <para style="q" vid="ISA 7:18">ha aganóubaña lígirugu Nilu le lidunari Ehiptu kei werewere,</para>
  <para style="q" vid="ISA 7:18">ñübuin hagíame ha aganóubaña Asiria kei maba.<verse eid="ISA 7:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 7:19" />Sun hagía hayabinba adüga hábiñe</para>
  <para style="q" vid="ISA 7:19">lidan burí fulasu wayati le hilumati,</para>
  <para style="q" vid="ISA 7:19">luma burí lidan lagadábugiñe dübü,</para>
  <para style="q" vid="ISA 7:19">lidan sun búbugati le gímiramirati</para>
  <para style="q" vid="ISA 7:19">luma burí lidan fulasu le ñein lubéi hata bágasu duna.<verse eid="ISA 7:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 7:20" />Lídanme weyu ligía, layusurubei Wabureme lurúeite Asiria</para>
  <para style="q" vid="ISA 7:20">keisi gusiñu akilahóutu yagürounmeme luéi duna Éufüratesi,</para>
  <para style="q" vid="ISA 7:20">ábame lásaraguni hádiburi Ísüraelina,</para>
  <para style="q" vid="ISA 7:20">hádiuma luma liyu hagudi.<verse eid="ISA 7:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="ISA 7:21" />Lídanme dan ligía, le agüriahati aban bágasu hama bián mudún <verse eid="ISA 7:21" /><verse number="22" style="v" sid="ISA 7:22" />ñeinbei saragu míligi luma, darime lun gayara lan leigin furumasu. Ani sun ha esefurutiña lídangiñe lagünrinchawagun fulasu, gayaraabei heigin furumasu luma sírudu.<verse eid="ISA 7:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="ISA 7:23" />Lídanme dan ligía, leme fulasu le ñein lubéi beibei-agei lau milu lídibu beibei ani milu murusun seinsu pülata lebegi, lerederuba hiiyu-ágeime luma búbugati-ágeime. <verse eid="ISA 7:23" /><verse number="24" style="v" sid="ISA 7:24" />Táurügüba gimara gayara lan lebelurún ñeinhin éibaaha, ladüga sun fulasu ligía, lerederuba hiiyu-ágeime luma búbugati-ágeime. <verse eid="ISA 7:24" /><verse number="25" style="v" sid="ISA 7:25" />Luagu burí wübü le meha ñein lubéi láhuruhoua tau hu, ñeinbei saragu hiiyu luma búbugati darime lun siñá lan lidin ni aban ñein. Lúnrügüba héigini bágasu hama mudún leseriwida.<verse eid="ISA 7:25" /></para>
  <chapter eid="ISA 7" />
  <chapter number="8" style="c" sid="ISA 8" />
  <para style="s1">Mini lan liri liráü Isaíasi</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 8:1" />Lariñaga Wabureme nun:</para>
  <para style="p" vid="ISA 8:1">—Barüba aban fulansu wéiriti, ábame babürüdün luagu lau abürühani le furanguti “Maerü-salalü-asübasi”. <verse eid="ISA 8:1" /><verse number="2" style="v" sid="ISA 8:2" />Ábame banügüniña fádiri Uríasi luma Sakaríasi le liráü Heberekíasi keisi gefentiña ha afiñewati hawagu.<verse eid="ISA 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 8:3" />Lárigiñe aba narounrun tuma númari to profetisa, aba tadageinadun, aba tagaraüdün aban wügüri irahü. Ábati lariñagun Wabureme nun:</para>
  <para style="p" vid="ISA 8:3">—Rubei Maerü-salalü-asübasi lírime. <verse eid="ISA 8:3" /><verse number="4" style="v" sid="ISA 8:4" />Ladüga lubaragiñeme gayara lan lariñagun irahü ligía “núguchi” luma “núguchu” Lasagarahóuba Damasüku luma Samaria, ábame lanügǘn lirisin lun lurúeite Asiria.<verse eid="ISA 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 8:5" />Ábaya lariñagun Wabureme nun:<verse eid="ISA 8:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 8:6" />“Kei ladüga lubéi hanufude gürigia ha</para>
  <para style="q" vid="ISA 8:6">luéi Resín luma luéi liráü Remalíasi</para>
  <para style="q" vid="ISA 8:6">hamahara lun lidunari Siloé, le éibaagubei hámaru.<verse eid="ISA 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 8:7" />Ladibiraguagüdübaña Wabureme</para>
  <para style="q" vid="ISA 8:7">lau lanarime lere léibaagun duna le Éufüratesi</para>
  <para style="q" vid="ISA 8:7">(mini lan lira, lurúeite Asiria lau sun lubafu).</para>
  <para style="q" vid="ISA 8:7">Láwiyuhaba lídangiñe sun lichanilin luma luéigiñe sun louba,<verse eid="ISA 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 8:8" />lachülürüba chülǘ Hudá ábame labuluchagüdüni,</para>
  <para style="q" vid="ISA 8:8">lachülürüba chülǘ luagu ligiina.</para>
  <para style="q" vid="ISA 8:8">Ítara luba Emanuéli kei aban dunuru lau larüna tuleñu</para>
  <para style="q" vid="ISA 8:8">le lunbei ladouragun lau sun bumúan”.<verse eid="ISA 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 8:9" />Óundaragua humá, néchanigu,</para>
  <para style="q" vid="ISA 8:9">buin humá lau anufudei;</para>
  <para style="q" vid="ISA 8:9">aganba huméi katei le sun burí ageiraü le dísebei:</para>
  <para style="q" vid="ISA 8:9">Íbini hárügüdünu hárumate, hanufudebadün.<verse eid="ISA 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 8:10" />Aranseha huméi haritagun, lau sun lira masalibei;</para>
  <para style="q" vid="ISA 8:10">ariñaga huméi haritagun,</para>
  <para style="q" vid="ISA 8:10">gama lumoun manügünbei fulasu,</para>
  <para style="q" vid="ISA 8:10">lugundun anihein Wabungiute wama.<verse eid="ISA 8:10" /></para>
  <para style="s1">Luéi lan Aburemei lanufudedúa</para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 8:11" />Ragǘ lumutina Wabureme here lau lúhabu, aba lariñagun nun lun mafala nani hémeri gürigia ha. Lariñaga nun:<verse eid="ISA 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 8:12" />—Mariñaga humá luagu eledeguni, eledeguni ítara kei hariñaguni gürigia ha. Maloucha humá, manufude huguyame luagu sun le ueibei hanufudeda. <verse eid="ISA 8:12" /><verse number="13" style="v" sid="ISA 8:13" />Wabureme Suntigabafu, ligía lunbei lanügǘn kei sánduti; ligía lunbei inebewa lan; lunti hanufudewa lan ligibugiñe. <verse eid="ISA 8:13" /><verse number="14" style="v" sid="ISA 8:14" />Ligía, ítara luba hun kei aban sádara; ligíaba dübü le uágubei hachugeraguba lan, le lunbei lábürügüdüni bián larúeihan Ísüraeli; ítara luba kei aban sádara to lunboun hábürühan lílana Herusalén tidoun. <verse eid="ISA 8:14" /><verse number="15" style="v" sid="ISA 8:15" />Saragubaña ábürühatiña ábame hóunwegun; saragubaña ábürühatiña tidoun sádara, ábame tárügüdüniña.<verse eid="ISA 8:15" /></para>
  <para style="s1">Ladimurehan Isaíasi houn lánigu</para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 8:16" />Areida huméi uganu le buidu;</para>
  <para style="q" vid="ISA 8:16">aramuda huméi arufudahani burí le,</para>
  <para style="q" vid="ISA 8:16">le níchugubei hun.<verse eid="ISA 8:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 8:17" />Lau sun laramudagun Wabureme hawéi lumutuniña Hakobu,</para>
  <para style="q" vid="ISA 8:17">hemenigitina luagu.</para>
  <para style="q" vid="ISA 8:17">Luagu níchigei nemenigin.<verse eid="ISA 8:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 8:18" />Au hama isaanigu ha líchugubaña Wabureme nun,</para>
  <para style="q" vid="ISA 8:18">seini lauti milaguru wagía lun Ísüraeli,</para>
  <para style="q" vid="ISA 8:18">líchugun Wabureme Suntigabafu le aganóubei luagu wübü Sión.<verse eid="ISA 8:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 8:19" />Chóuruti luagu hariñaguba lan gürigia hun:</para>
  <para style="q" vid="ISA 8:19">«Hálügüdaha luma hani hilaguaaña sífiri</para>
  <para style="q" vid="ISA 8:19">luma hama garíaahatiña ha,</para>
  <para style="q" vid="ISA 8:19">ha adimurehabaña hámaru.</para>
  <para style="q" vid="ISA 8:19">Ma funagia lunti hálügüdahan lílana fulasu hama habungiutegu,</para>
  <para style="q" vid="ISA 8:19">luma lun hamuriahan dimurei hama hilaaña habügürü wínwangiña<verse eid="ISA 8:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 8:20" />lun heresibirun arufudahani o aban lan uganu?»</para>
  <para style="q" vid="ISA 8:20">Hadimurehaba ítara, gama lumoun libidiounigan aau le hariñagubei.<verse eid="ISA 8:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="ISA 8:21" />Hóudiba gürigia lídangiñe aban fulasu lidoun amu</para>
  <para style="q" vid="ISA 8:21">lau súfuri luma lau ilamaü</para>
  <para style="q" vid="ISA 8:21">ábameti hagañidun ladüga halama.</para>
  <para style="q" vid="ISA 8:21">Híñaragubei harúeite hama habungiutegu.</para>
  <para style="q" vid="ISA 8:21">Harihuba iñun,<verse eid="ISA 8:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 8:22" />lárigiñe ábame harihin ǘnabun,</para>
  <para style="q" vid="ISA 8:22">madaribaña amu katei luéidigia gudemei,</para>
  <para style="q" vid="ISA 8:22">luburiga luma súfuri.</para>
  <para style="q" vid="ISA 8:22">Ladouraguba áriebu lau sun katei.</para>
  <para style="q" vid="ISA 8:22">Ani le lábugiñebei lidere dan,</para>
  <para style="q" vid="ISA 8:22">siñabei lesefurun.<verse eid="ISA 8:22" /></para>
  <chapter eid="ISA 8" />
  <chapter number="9" style="c" sid="ISA 9" />
  <para style="s1">Lurúeite darangilaü</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 9:1" />Furumiñe ǘnabugüda lumuti meha Wabungiute Galiléa le lumúan Nefütalí luma Sabulón fulasu le yarafabei houn gibe tubungiutegu, le lúmagiñebei loubafurugu Hordán darí laru barana; gama lumoun lárigiñe aba líchugun saragu uéiriguni lun.<verse eid="ISA 9:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ISA 9:2" />Gürigia ha meha lídanbaña luburiga,</para>
  <para style="q" vid="ISA 9:2">arihatiña aban óunwenbu larugounga;</para>
  <para style="q" vid="ISA 9:2">harugoungaali houn ha meha aganóubaña lidan lamuñounga le lánina óunweni.<verse eid="ISA 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 9:3" />Wabureme, barühadibu aban óunwenbu ugundani;</para>
  <para style="q" vid="ISA 9:3">wéiriti ugundani le.</para>
  <para style="q" vid="ISA 9:3">Gúndaatiña sun gürigia bigibugiñe kei lidan lidaani alubahani,</para>
  <para style="q" vid="ISA 9:3">kei hagundaarun ha afanreinhabaña óunwenbu irisini hádangua.<verse eid="ISA 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 9:4" />Lugundun günringuabá amudirawaguni le meha gádanbaliña lílana fulasu,</para>
  <para style="q" vid="ISA 9:4">lidere dan le meha adiheridagüdübaliña,</para>
  <para style="q" vid="ISA 9:4">lanarime meha lidere gumadi le gábugiñebaliña.</para>
  <para style="q" vid="ISA 9:4">Ítara liña kei dan le bagünrinchagunbalin Madián.<verse eid="ISA 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 9:5" />Hageidin súdaragu to meha gamuriboun</para>
  <para style="q" vid="ISA 9:5">tuma daüguaü to dáseiboun lau hitaü, tagudúba,</para>
  <para style="q" vid="ISA 9:5">lagumuchaguagüdüboun watu gemeti.<verse eid="ISA 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 9:6" />Ladüga águrahouaali aban irahü,</para>
  <para style="q" vid="ISA 9:6">rúhali Wabungiute aban isaani woun</para>
  <para style="q" vid="ISA 9:6">le unbei lichugúa ubafu lun lagumadihan.</para>
  <para style="q" vid="ISA 9:6">Anihánba burí iri le liri:</para>
  <para style="q" vid="ISA 9:6">Garíawaseti, Bungiu Gabafuti,</para>
  <para style="q" vid="ISA 9:6">Úguchili Magumuchaditi, Lurúeite Darangilaü.<verse eid="ISA 9:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 9:7" />Lañuuruba luagu lálana larúeihan Dawidi;</para>
  <para style="q" vid="ISA 9:7">lachawaraguba lubafu le lánina larúeihan lidoun sun fulasu</para>
  <para style="q" vid="ISA 9:7">ani magumuchadibei darangilaü;</para>
  <para style="q" vid="ISA 9:7">lárügüdüba larúeihan buidu buidu,</para>
  <para style="q" vid="ISA 9:7">irichaüba lugudina larúeihan,</para>
  <para style="q" vid="ISA 9:7">lúmagiñe guentó lun súnwandan.</para>
  <para style="q" vid="ISA 9:7">Lanarime línsiñehabu Suntigabafu, ligíaba adügei katei le.<verse eid="ISA 9:7" /></para>
  <para style="s1">Ligañi Wabureme luma Ísüraeli</para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 9:8" />Óunahaali Wabureme aban uganu lun Ísüraeli,</para>
  <para style="q" vid="ISA 9:8">houn lánigu Hakobu;<verse eid="ISA 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 9:9" />Gunfuranda hamaali sun lánigu Éfürain ha aganóubaña Samaria,</para>
  <para style="q" vid="ISA 9:9">ariñagatiña lau pantaü luma anaaguni unguaü:<verse eid="ISA 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 9:10" />«Heigua ladiríyu</para>
  <para style="q" vid="ISA 9:10">gama lumoun wábunaguba lau dübü.</para>
  <para style="q" vid="ISA 9:10">Chaün hamá índanu le lauti fulansu le igu</para>
  <para style="q" vid="ISA 9:10">gama lumoun wíchuguba le hibúari leweñegua».<verse eid="ISA 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 9:11" />Óunahaali Wabureme hanarime burí áganiñu;</para>
  <para style="q" vid="ISA 9:11">ligía guánarügü ariñagubei houn lun hageindagun.<verse eid="ISA 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 9:12" />Síriana luéigiñe oubaü le ñéingiñe lubéi laboucha weyu,</para>
  <para style="q" vid="ISA 9:12">Filistéana luéigiñe oubaü le ñeinhin lubéi lálüda.</para>
  <para style="q" vid="ISA 9:12">Láurügü aban háwagachun, hulú hamuti Ísüraeli.</para>
  <para style="q" vid="ISA 9:12">Ani lau sun lira, magalumarúngili ligañi Wabureme;</para>
  <para style="q" vid="ISA 9:12">anihamémegua ayawadagua.<verse eid="ISA 9:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ISA 9:13" />Gama lumoun magiribudúntiña lílana fulasu lun Wabungiute</para>
  <para style="q" vid="ISA 9:13">le abeichubaliña;</para>
  <para style="q" vid="ISA 9:13">máluahan hamuti Wabureme Suntigabafu.<verse eid="ISA 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 9:14" />Ábati lóuseruni Wabureme larúeihan Ísüraeli</para>
  <para style="q" vid="ISA 9:14">kei íbuguti lichügü aban animaalu luma lili,</para>
  <para style="q" vid="ISA 9:14">kei táchuahoun yaraüwa úara luma maburu.</para>
  <para style="q" vid="ISA 9:14">Sun le lidan ábanrügü weyu!<verse eid="ISA 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 9:15" />(Ábulugu, hagía wéiyaaña baña mutu hama ábutigu,</para>
  <para style="q" vid="ISA 9:15">ili, hagía profetagubaña ha arufudahabaña iyeeni.)<verse eid="ISA 9:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 9:16" />Yuriguagüda hamaaña ábutigu lílana fulasu ha,</para>
  <para style="q" vid="ISA 9:16">hati áluahabaña aban adundehati aba heferidiragun.<verse eid="ISA 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 9:17" />Ligía magudemedun habéi nibureingiña lun Wabureme,</para>
  <para style="q" vid="ISA 9:17">ni méteñuhaña, ni hilaguaaña úmarigu.</para>
  <para style="q" vid="ISA 9:17">Lugundun wuribatiña sun lílana fulasu,</para>
  <para style="q" vid="ISA 9:17">bóugudin luéi irichaü hadimureha</para>
  <para style="q" vid="ISA 9:17">ani lau sun lira magalumarúngili ligañi Wabureme;</para>
  <para style="q" vid="ISA 9:17">anihamémegua ayawadagua.<verse eid="ISA 9:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ISA 9:18" />Ígirati wuribani günringuaü kei aban gudáü</para>
  <para style="q" vid="ISA 9:18">le agumuchaguagüdüti hiiyu-agei luma áraabu lárigiñe</para>
  <para style="q" vid="ISA 9:18">aba lágudunu burí tídibu wewe to dabíararuguboun,</para>
  <para style="q" vid="ISA 9:18">aba lachüürünu garabalirugun labadinagua gumuleli.<verse eid="ISA 9:18" /></para>
  <para style="q">
    <verse number="19-20" style="v" sid="ISA 9:19-20" />Ladüga ligañi Wabureme Suntigabafu lágudunbei fulasu,</para>
  <para style="q" vid="ISA 9:19-20">lagumuchuña watu hau lílana fulasu;</para>
  <para style="q" vid="ISA 9:19-20">hou hamuti hágürügü hasaanigu guánarügü,</para>
  <para style="q" vid="ISA 9:19-20">ani magudementiña hábirigu houn.</para>
  <para style="q" vid="ISA 9:19-20">Anihein aban ya áhuluhati gama lumoun lamamémeti,</para>
  <para style="q" vid="ISA 9:19-20">anihein aban yágüta houti gama lumoun makimuledunti.<verse eid="ISA 9:19-20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 9:21" />Günringua lumuti Manasési Éfürain,</para>
  <para style="q" vid="ISA 9:21">günringualéi Éfürain Manasési,</para>
  <para style="q" vid="ISA 9:21">ani biángubei hagía ábürühatiña luagun Hudá.</para>
  <para style="q" vid="ISA 9:21">Ani lau sun lira,</para>
  <para style="q" vid="ISA 9:21">magalumarúngili ligañi Wabureme,</para>
  <para style="q" vid="ISA 9:21">anihamémegua ayawadagua.<verse eid="ISA 9:21" /></para>
  <chapter eid="ISA 9" />
  <chapter number="10" style="c" sid="ISA 10" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 10:1" />Fugiabugu huguya le íchugubei lúrudu le marichati,</para>
  <para style="q" vid="ISA 10:1">sagá huguya gumadi le mawandúaditi,<verse eid="ISA 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 10:2" />huguya le míchugunbalin haricha ha débilibaña houn,</para>
  <para style="q" vid="ISA 10:2">maha huguya lun haricha nánigu ha gudemebaña,</para>
  <para style="q" vid="ISA 10:2">huguya le átubalin hata würiña hilaguaaña úmari,</para>
  <para style="q" vid="ISA 10:2">íweruha huguya hawéi méteñuhaña.<verse eid="ISA 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 10:3" />Kábagia hadüga danme lachülürün weyu lun hálügüdawagun,</para>
  <para style="q" vid="ISA 10:3">danme harihini liabin abeichúni dísegiñe?</para>
  <para style="q" vid="ISA 10:3">Kábagia uma hamuriaha ídemuei?</para>
  <para style="q" vid="ISA 10:3">Halíabagia hígirei burí hirisin?<verse eid="ISA 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 10:4" />Anhaün mǘnabudawagüdün,</para>
  <para style="q" vid="ISA 10:4">barüwa huguyame adaürǘwa,</para>
  <para style="q" vid="ISA 10:4">hábürühaba kei ha óunwegubaña áfarawaguarügü.</para>
  <para style="q" vid="ISA 10:4">Ani lau sun lira, magalumarúngili ligañi Wabureme,</para>
  <para style="q" vid="ISA 10:4">anihamémegua ayawadagua.<verse eid="ISA 10:4" /></para>
  <para style="s1">Lanúadiruni Wabungiute lurúeite Asiria lun labeihagüleme</para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 10:5" />«Lurúeite Asiria!</para>
  <para style="q" vid="ISA 10:5">Ligía wewe le nayusurubei lun nabeihan,</para>
  <para style="q" vid="ISA 10:5">ligía wewe le nayusurubei dan le nagañidun.<verse eid="ISA 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 10:6" />Óunaha numuti ageindagua hama lílana aban fulasu ha wuribatiña, hama néchanigu ha anabagutina,</para>
  <para style="q" vid="ISA 10:6">lun líweruhan hawéi, gidaléime harisin,</para>
  <para style="q" vid="ISA 10:6">lun ladügüraguniña kei gubegubeti ǘmadarugu.<verse eid="ISA 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 10:7" />Gama lumoun masaminarunti lurúeite Asiria ítara,</para>
  <para style="q" vid="ISA 10:7">ani mama giñe ligía le laritagubei ladügün.</para>
  <para style="q" vid="ISA 10:7">Laritagun lúnrügü lagünrinchagun</para>
  <para style="q" vid="ISA 10:7">luma lun lagumuchun hau saragu néchanigu.<verse eid="ISA 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 10:8" />Lariñahare: “Sun urúeigu</para>
  <para style="q" vid="ISA 10:8">ábutigu lábugiñe nererehan.<verse eid="ISA 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 10:9" />Aban labu uburugu Kalünó nun kei Karükémisi,</para>
  <para style="q" vid="ISA 10:9">aban labu Amatü kei Arüpádü,</para>
  <para style="q" vid="ISA 10:9">aban labu Samaria luma Damasüku.<verse eid="ISA 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 10:10" />Dúnguaadina hama néchanigu ha gibe tubungiutegu,</para>
  <para style="q" vid="ISA 10:10">ha gibe tiguariuan sügǘ lau Herusalén luma Samaria.<verse eid="ISA 10:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 10:11" />Le nadügübei lun Samaria luma houn lubungiutegu,</para>
  <para style="q" vid="ISA 10:11">siñabei funagia nadügüni lun Herusalén hau liguariuan?” »<verse eid="ISA 10:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 10:12" />Danme adüga laali Bungiu sun le lunbei ladügüni</para>
  <para style="q" vid="ISA 10:12">luagu luwübüri Sión luma Herusalén,</para>
  <para style="q" vid="ISA 10:12">labeichubei Wabureme lurúeite Asiria</para>
  <para style="q" vid="ISA 10:12">ladüga lupantan luma lanaagun lungua.<verse eid="ISA 10:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ISA 10:13" />Ariñagaali lurúeite Asiria: «Lau nere nadügei;</para>
  <para style="q" vid="ISA 10:13">huáliti nichügü, au aransehabei lun ítara luba lan.</para>
  <para style="q" vid="ISA 10:13">Sansi naali láfadaragun burí néchani</para>
  <para style="q" vid="ISA 10:13">barǘ naali burí lirisin nánime,</para>
  <para style="q" vid="ISA 10:13">ani huchú naaña urúeigu kei aban le ganigiti.<verse eid="ISA 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 10:14" />Ru naali núhabu luagu lirisin burí fulasu,</para>
  <para style="q" vid="ISA 10:14">ragǘ naali sun fulasu ítara kei hanügǘn gañé lídangiñe aban umasaü,</para>
  <para style="q" vid="ISA 10:14">úouga kaba lan ánhingichei larüna ni kaba lan áwagacha ayahua».<verse eid="ISA 10:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 10:15" />Gayaraati funagia tanaagun harawa tungua</para>
  <para style="q" vid="ISA 10:15">wéirigu sügǘ lau le ahandilihabarun?</para>
  <para style="q" vid="ISA 10:15">Odi siyara sügǘ lau le íbaahabei lau?</para>
  <para style="q" vid="ISA 10:15">Kéigubeirügü hamuga badun,</para>
  <para style="q" vid="ISA 10:15">le mámabei amu katei luéidigia aban wewe,</para>
  <para style="q" vid="ISA 10:15">Gayaraabei funagia lánhingichuni gürigia le laubei?<verse eid="ISA 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 10:16" />Ligía lígirubaña lubéi Wabureme Suntigabafu ha dídeiburibaña méreuga,</para>
  <para style="q" vid="ISA 10:16">ábame lásüdagüdüni hágubu lau abiruaü.<verse eid="ISA 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 10:17" />Wabungiute le sándubei, le lilanpun Ísüraeli,</para>
  <para style="q" vid="ISA 10:17">lasaliraguba watu gemetime,</para>
  <para style="q" vid="ISA 10:17">ábame láguduni sun hiiyu luma dabíara le fulasurugubei lidan aban weyu.<verse eid="ISA 10:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 10:18" />Lagünrinchagubei luenden burí dabíara luma fuluri-agei sunsuinagubei.</para>
  <para style="q" vid="ISA 10:18">Lígirubei kei aban sánditi le méreeli.<verse eid="ISA 10:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 10:19" />Míbebei lídibu wewe erederuti dabíararugu,</para>
  <para style="q" vid="ISA 10:19">darime lun gayara lan labahüdüni aban irahü.<verse eid="ISA 10:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 10:20" />Lídanme dan ligía, fiuraü hame erederubaña</para>
  <para style="q" vid="ISA 10:20">hádangiñe lánigu Ísüraeli,</para>
  <para style="q" vid="ISA 10:20">hame esefurubaña hádangiñe lánigu Hakobu,</para>
  <para style="q" vid="ISA 10:20">márügüdündigiaañame luagu le agünrinchagubaliña,</para>
  <para style="q" vid="ISA 10:20">luéigiñeba Wabungiute le Sándubei le Lubungiute Ísüraeli hárügüda.<verse eid="ISA 10:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 10:21" />Fiu hádangiñe lánigu Hakobu,</para>
  <para style="q" vid="ISA 10:21">hagarabaaguba lumoun Wabungiute le meferidiradibei.<verse eid="ISA 10:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 10:22" />Ísüraeli, lau sun gibe hamá bánigu kei lagu sagoun le lárubei beya,</para>
  <para style="q" vid="ISA 10:22">fiúrügübaña agiribuda,</para>
  <para style="q" vid="ISA 10:22">aranseli günringuaü, ani ladügǘba irichaü le gumuti.<verse eid="ISA 10:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 10:23" />Ladüga ru laali Wabureme Suntigabafu laritagunrugun</para>
  <para style="q" vid="ISA 10:23">lun ladügǘn günringuaü, ani ladügübei lidan sun fulasu.<verse eid="ISA 10:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 10:24" />Lariñahare Wabureme Suntigabafu:</para>
  <para style="q" vid="ISA 10:24">«Numutuniña ha aganóubaña Sión,</para>
  <para style="q" vid="ISA 10:24">manufudeda humá hawéi Asiriana,</para>
  <para style="q" vid="ISA 10:24">íbini hagayuahan huagu lau hawewen,</para>
  <para style="q" vid="ISA 10:24">iñura hameime habadun huagun kei meha hadüga Ehiptuna.<verse eid="ISA 10:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 10:25" />Ladüga málühali anhein ábürüha abeichúni hawagun,</para>
  <para style="q" vid="ISA 10:25">ábame lagünrinchaguniña nigañi.<verse eid="ISA 10:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 10:26" />Labeichubaña Wabureme Suntigabafu kei dan le</para>
  <para style="q" vid="ISA 10:26">láfaraguniña Madianna luagu lidübüri Orebü,</para>
  <para style="q" vid="ISA 10:26">ábame larufuduni lubafu luagu Asiria</para>
  <para style="q" vid="ISA 10:26">kei dan le larufudunbalin luagu Ehiptu.<verse eid="ISA 10:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 10:27" />Lídanme weyu ligía,</para>
  <para style="q" vid="ISA 10:27">lagidarúba ihürügu le híchugubei banagawagu,</para>
  <para style="q" vid="ISA 10:27">halagua ligíame ihürügu le híchugubei bégewagu».</para>
  <para style="s1" vid="ISA 10:27">Hawanserun Asiriana</para>
  <para style="q" vid="ISA 10:27">Luéigiñeba Rimón liabin ágani,<verse eid="ISA 10:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 10:28" />chülüha Ayatün, sügüha Migüróngiñe,</para>
  <para style="q" vid="ISA 10:28">ígirala lanügün Mikümási,<verse eid="ISA 10:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 10:29" />hiñugualá lémeri ébeini héreti,</para>
  <para style="q" vid="ISA 10:29">tulela likianpun uburugu Geba;</para>
  <para style="q" vid="ISA 10:29">buinha Ramá lau anufudei,</para>
  <para style="q" vid="ISA 10:29">anurahouga Gibeana, ha luburuguteruguna urúei Saulu.<verse eid="ISA 10:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="ISA 10:30" />Bagúaraha, Batü-galimü!</para>
  <para style="q" vid="ISA 10:30">Aganbabáña, Laisa!</para>
  <para style="q" vid="ISA 10:30">Óunababa Anatótu!<verse eid="ISA 10:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="ISA 10:31" />Anuraha Madümená,</para>
  <para style="q" vid="ISA 10:31">aramudaguouga lílana Gebimü.<verse eid="ISA 10:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="ISA 10:32" />Lerederaguba híweruti uguñe Nobu;</para>
  <para style="q" vid="ISA 10:32">líchigei seini lun lábürühoun luagun wübü Sión,</para>
  <para style="q" vid="ISA 10:32">le luwübüri Herusalén.<verse eid="ISA 10:32" /></para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" sid="ISA 10:33" />Águha lumuti Wabureme Suntigabafu</para>
  <para style="q" vid="ISA 10:33">tídibu wewe lau lanarime lere;</para>
  <para style="q" vid="ISA 10:33">Cháünwati le burí íñutimabei, ábürühati múarugun.<verse eid="ISA 10:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="ISA 10:34" />Fui lumuti liduru-agei dabíara tau aban harawa,</para>
  <para style="q" vid="ISA 10:34">ábürühati tídibu wewe le buíduburitimabei Líwanurugu.<verse eid="ISA 10:34" /></para>
  <chapter eid="ISA 10" />
  <chapter number="11" style="c" sid="ISA 11" />
  <para style="s1">Arúeihani lánina darangilaü</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 11:1" />Ítara haña liduheñu Dawidi kei aban tugudina wewe,</para>
  <para style="q" vid="ISA 11:1">láfuriduba aban iseri urúei lídangiñe kei láhüchagun fuluri.<verse eid="ISA 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 11:2" />Ñeinbei lani Bungiu Sífiri luma súnwandan,</para>
  <para style="q" vid="ISA 11:2">líchuguba lichú aau lun, lualin ichügü,</para>
  <para style="q" vid="ISA 11:2">gabaroun lubéi katei, líchuguba giñe erei lun,</para>
  <para style="q" vid="ISA 11:2">subudi luma inebenehabu lun Wabureme.<verse eid="ISA 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 11:3" />Maguseragüdünbei luagu larihín aban katei,</para>
  <para style="q" vid="ISA 11:3">masiadihan ligíame luagu katei le machourunti.<verse eid="ISA 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 11:4" />Laguseragüdüba lau irichaü houn ha débilibaña,</para>
  <para style="q" vid="ISA 11:4">ageindagualeime haricha lílana fulasu ha gudemebaña.</para>
  <para style="q" vid="ISA 11:4">Ítara luba lererun kei aban wewe lun labeichuniña ha hanarimebaña,</para>
  <para style="q" vid="ISA 11:4">lau láfurun liyumulugugiñe láfarubaña ha wuribabaña.<verse eid="ISA 11:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 11:5" />Súnwandan ladaüraguba lan lau irichaü luma inarüni.<verse eid="ISA 11:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 11:6" />Laganóubati ounli áraabuna luma mudún lidan darangilaü hámawagua,</para>
  <para style="q" vid="ISA 11:6">lemeraaguba géigusi luma gábara lidan aban,</para>
  <para style="q" vid="ISA 11:6">haweinamuduba bágasu luma liñún aban lóubagiñe aban,</para>
  <para style="q" vid="ISA 11:6">hígiraguagüdüba houngua lun ladundehaniña aban irahü ñǘraügili.<verse eid="ISA 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 11:7" />Gamadaguabóun bágasu tuma osu,</para>
  <para style="q" vid="ISA 11:7">hemeraaguba harahüñü lidan aban.</para>
  <para style="q" vid="ISA 11:7">Léigiba liñún sagadi kei bágasu.<verse eid="ISA 11:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 11:8" />Gayaraabei ladibirihan irahü lidan huyu le ñein lubéi taganawa hewe,</para>
  <para style="q" vid="ISA 11:8">gayaraabei ládaruni lúhabu túbiñoun ani mágürün tubéi.<verse eid="ISA 11:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 11:9" />Úabei adügüti wuribati luagu nuwübüri le sándubei,</para>
  <para style="q" vid="ISA 11:9">ladüga ítara kei labuinchagüdüni duna barana,</para>
  <para style="q" vid="ISA 11:9">ítara luba labuinchun sun fulasu lau lasubudirúniwa luéirigun Wabureme.<verse eid="ISA 11:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 11:10" />Lídanme dan ligía, liñuraguba ladügawagun Dawidi le liráü Hesé lungua</para>
  <para style="q" vid="ISA 11:10">kei aban seini houn lílana burí fulasu;</para>
  <para style="q" vid="ISA 11:10">hóudiba néchanigu áluahei, ani wéirigubei fulasu le ñein lumuti.<verse eid="ISA 11:10" /></para>
  <para style="s1">Hagiribudun ha asagarúbaña hageiragiñe lau agañeiruni</para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 11:11" />Larufudayabei Wabureme lubafu lídanme dan ligía,</para>
  <para style="q" vid="ISA 11:11">lau lagiribudagüdüniña lumutuniña ha meha Asiriabaña,</para>
  <para style="q" vid="ISA 11:11">Ehiptu, Paturósu, Etiopía, Elamü, Sinarü,</para>
  <para style="q" vid="ISA 11:11">Amatü luma burí ubouhu.<verse eid="ISA 11:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 11:12" />Liñuruba aban seini houn néchanigu,</para>
  <para style="q" vid="ISA 11:12">ábame lóundaruniña Ísüraelina ha bóugudibaña luéi hageira;</para>
  <para style="q" vid="ISA 11:12">lóundarubaña sun lánigu Hudá ha chagagubaña</para>
  <para style="q" vid="ISA 11:12">lídangiñe gádürü larigei ubóu.<verse eid="ISA 11:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 11:13" />Lagumuchuba ligimugan Éfürain,</para>
  <para style="q" vid="ISA 11:13">lagalumaduba luriban laritagun Hudá;</para>
  <para style="q" vid="ISA 11:13">magimuganhaalime Éfürain lun Hudá,</para>
  <para style="q" vid="ISA 11:13">úame luriban aritaguni lidan Hudá lubá Éfürain,<verse eid="ISA 11:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 11:14" />hóudiba biángubei hagía ageindagua hama Filistéana,</para>
  <para style="q" vid="ISA 11:14">hábürühaba hawagun hanagangiñe;</para>
  <para style="q" vid="ISA 11:14">hagidarubei harisin türibu ha erederubaña luéigiñe oubaü</para>
  <para style="q" vid="ISA 11:14">le ñéingiñe lubéi láfuacha weyu.</para>
  <para style="q" vid="ISA 11:14">Lachülürüba habafu chülǘ Edomu luma Moabü,</para>
  <para style="q" vid="ISA 11:14">hagumadihaba giñe hawagu Amonna.<verse eid="ISA 11:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 11:15" />Ladaaruba Wabureme aban üma houn lídangiñe Barana Funati,</para>
  <para style="q" vid="ISA 11:15">liñurubei larüna lóugiñe duna Éufüratesi,</para>
  <para style="q" vid="ISA 11:15">láfuragüdüba aban lanarime garabali</para>
  <para style="q" vid="ISA 11:15">ábame ladüraaguni lidan sedü arünaü,</para>
  <para style="q" vid="ISA 11:15">ábame gayara lan hánhiñuraguni magidarunga hamóun hageidin.<verse eid="ISA 11:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 11:16" />Danme hagiribudun híbiri lumutuniña</para>
  <para style="q" vid="ISA 11:16">Wabureme hagía Asiriagiñe,</para>
  <para style="q" vid="ISA 11:16">hadariruba aban üma tuleti kei meha Ísüraeli</para>
  <para style="q" vid="ISA 11:16">dan le láfuridunbei Ehiptugiñe.<verse eid="ISA 11:16" /></para>
  <chapter eid="ISA 11" />
  <chapter number="12" style="c" sid="ISA 12" />
  <para style="s1">Uremu lánina eteingiruni</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 12:1" />Lídanme dan ligía, bariñaguba:</para>
  <para style="q" vid="ISA 12:1">«Seremei numutibu, Nabureme,</para>
  <para style="q" vid="ISA 12:1">ladüga lau sun buga bagañidun numa,</para>
  <para style="q" vid="ISA 12:1">sügüha bigañi ani águyugüda baali darangilaü nun.<verse eid="ISA 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 12:2" />Bungiu esefurubalina, hemenigitina luagu, manufudetina.</para>
  <para style="q" vid="ISA 12:2">Aburemei naramudaguagülebei luma nere, ligía nesefuragülebei.<verse eid="ISA 12:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 12:3" />Gayaraabei giñe hidin ata lau ugundani</para>
  <para style="q" vid="ISA 12:3">lidan lísensen esefuruni ligía».<verse eid="ISA 12:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 12:4" />Ábameti hariñagun: «Ru humá seremei,</para>
  <para style="q" vid="ISA 12:4">agúaha humeime Aburemei,</para>
  <para style="q" vid="ISA 12:4">habahüdagua houn néchanigu luagu burí katei le ladügübei,</para>
  <para style="q" vid="ISA 12:4">haritaguagüda humaña luagu lóugiñeñein lan sun katei.<verse eid="ISA 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 12:5" />Heremuha lun Wabureme, ladüga adügaali katei wéiriguti</para>
  <para style="q" vid="ISA 12:5">le yuubei lun lasubudirúniwa lidan sun ubóu.<verse eid="ISA 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 12:6" />Hagúaraha lau ugundani lílana Sión,</para>
  <para style="q" vid="ISA 12:6">lugundun anihein Wabungiute le Sándubei</para>
  <para style="q" vid="ISA 12:6">le Lubungiute Ísüraeli huma lau sun luéirigun».<verse eid="ISA 12:6" /></para>
  <chapter eid="ISA 12" />
  <chapter number="13" style="c" sid="ISA 13" />
  <para style="s1">Le lunbei lasuseredun lun Babilónia</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 13:1" />Katei le burí larufudubei Wabungiute lun Isaíasi le liráü Amosu, libügürü Babilónia:<verse eid="ISA 13:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ISA 13:2" />«Iñura huméi liseinin wuribu luagu aban wübü le hiyaali!</para>
  <para style="q" vid="ISA 13:2">Ru huméi dimurei houn súdara lun hagumeseruni wuribu!</para>
  <para style="q" vid="ISA 13:2">Iñura huméi húhabu lun hebelurun luéigiñe habenari lirahüñü urúei!<verse eid="ISA 13:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 13:3" />Wáhadina houn nánigu ha ganigibaña,</para>
  <para style="q" vid="ISA 13:3">rúhadina dimurei houn nánigu wuriburuguna ha deregeguabaña houngua,</para>
  <para style="q" vid="ISA 13:3">ha agundaarubaña lau nagañeirun,</para>
  <para style="q" vid="ISA 13:3">lun hagía lan abeiha neweñegua».<verse eid="ISA 13:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 13:4" />Aganbúati agúarahani luagu wübü kamá hagúarahan saragu gürigia.</para>
  <para style="q" vid="ISA 13:4">Aganbúati hadürürühan néchanigu,</para>
  <para style="q" vid="ISA 13:4">hadürürühan lílana burí fulasu ha óundaragubaña.</para>
  <para style="q" vid="ISA 13:4">Aranse lumutiña Wabureme Suntigabafu lisudaran lubá wuribu.<verse eid="ISA 13:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 13:5" />Añatén lídangiñe aban ageiraü díseti,</para>
  <para style="q" vid="ISA 13:5">yagürounmeme luéi leben warihin.</para>
  <para style="q" vid="ISA 13:5">Wabureme ñǘbuinbei lau ligañi,</para>
  <para style="q" vid="ISA 13:5">liábiña agünrinchaguei sun ubóu.<verse eid="ISA 13:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 13:6" />Hagúaraha, lugundun yarafaali luéyuri Wabureme,</para>
  <para style="q" vid="ISA 13:6">liabin kei aban buleseiti lúmagiñeti Suntigabafu.<verse eid="ISA 13:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 13:7" />Ábameti lábürühan harüna sun gürigia,</para>
  <para style="q" vid="ISA 13:7">súngubei heferidirubei hanigi,<verse eid="ISA 13:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 13:8" />herederuba súngubei lau anufudei,</para>
  <para style="q" vid="ISA 13:8">hasandiruba aban íruni luma óunwenbu igari</para>
  <para style="q" vid="ISA 13:8">darime lun haguribidagun kei würi to luntu tágurahan.</para>
  <para style="q" vid="ISA 13:8">Haríaguba hawouguoun lau tueirin anigi,</para>
  <para style="q" vid="ISA 13:8">ábame lásüdün hagibu lau busiganu.<verse eid="ISA 13:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 13:9" />Lachülüra luéyuri Wabureme, weyu hanarimeti,</para>
  <para style="q" vid="ISA 13:9">lau igañi süti, lasaliraguba ubóu fulasume mageirawati,</para>
  <para style="q" vid="ISA 13:9">ábame lagumuchun hau gafigountiña ha lídanbaña.<verse eid="ISA 13:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 13:10" />Marugoungadunhañame waruguma ni burí katei le siélubei;</para>
  <para style="q" vid="ISA 13:10">keime láfuridun weyu, ítara laburigadun, marunihalime hati.<verse eid="ISA 13:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ISA 13:11" />Lariñahare Wabureme: «Nabeichaali ubóu luagu luriban,</para>
  <para style="q" vid="ISA 13:11">nabeichaaña wuribatiña luagu háfarahan,</para>
  <para style="q" vid="ISA 13:11">nagumucha lau hapantan barügua tungua,</para>
  <para style="q" vid="ISA 13:11">nǘnabudagüdaaña ha wéirigubei hanaagun houngua.<verse eid="ISA 13:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 13:12" />Nadüga lun hekesidun wügüriña</para>
  <para style="q" vid="ISA 13:12">sügǘ lau golu fínuti le Ofirüna.<verse eid="ISA 13:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 13:13" />Ábameti lánhingichun sielu,</para>
  <para style="q" vid="ISA 13:13">diñú ligíame ubóu lídangiñe lubara</para>
  <para style="q" vid="ISA 13:13">ladügame lanarime nigañi lidan weyu ligía.<verse eid="ISA 13:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 13:14" />«Ítara haba gürigia kei usari éibaahoutu,</para>
  <para style="q" vid="ISA 13:14">o kei mudún dan le hachagaragun,</para>
  <para style="q" vid="ISA 13:14">úati kaba lan óundaraña.</para>
  <para style="q" vid="ISA 13:14">Hagiribuduba kada aban hageiroun,</para>
  <para style="q" vid="ISA 13:14">hanurahaba hageiroun guánarügü.<verse eid="ISA 13:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 13:15" />Le ígiraguagüdüti lungua lun ladarirún, límirawaguba,</para>
  <para style="q" vid="ISA 13:15">le arügüdǘti, lafarúba hilagubei.<verse eid="ISA 13:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 13:16" />Haburechawaguba hasaanigu ha ñǘbürigiña hagibugiñe;</para>
  <para style="q" vid="ISA 13:16">tasagarahóuba haban águrawagua hagíame hámarigu.<verse eid="ISA 13:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ISA 13:17" />«Nínchahaaña Médiana hawagun,</para>
  <para style="q" vid="ISA 13:17">gürigia ha meberesegúnbaña lau pülata ni lau golu.<verse eid="ISA 13:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 13:18" />Háfaragubaña nibureintiña tau gimara,</para>
  <para style="q" vid="ISA 13:18">magudemehábutiña houn irahüñü figigiña,</para>
  <para style="q" vid="ISA 13:18">ni houn irahüñü ñǘbürigiña.<verse eid="ISA 13:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 13:19" />Babilónia ligía haweirigunbei néchanigu,</para>
  <para style="q" vid="ISA 13:19">uburugu le wéndetimabei lidan sun arúeihani,</para>
  <para style="q" vid="ISA 13:19">lerederuba kei Sodoma luma Gomora</para>
  <para style="q" vid="ISA 13:19">dan meha nagünrinchagunbalin.<verse eid="ISA 13:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 13:20" />Lerederuba Babilónia málouga,</para>
  <para style="q" vid="ISA 13:20">maganóundigiaañame gürigia ñein,</para>
  <para style="q" vid="ISA 13:20">merederagun hañame Arawiana ñein.</para>
  <para style="q" vid="ISA 13:20">Nírügü óunigirutiña mudún</para>
  <para style="q" vid="ISA 13:20">memeraaguagüdün hamaañame halügüniña mudún ñein.<verse eid="ISA 13:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 13:21" />Mesu áraabuna hagíaba aganawa ñein,</para>
  <para style="q" vid="ISA 13:21">habuinchuba garún tidan burí muna,</para>
  <para style="q" vid="ISA 13:21">awesüturusuba aganawa ñein tidan,</para>
  <para style="q" vid="ISA 13:21">háhureruba giñe harahüñü gábara ñein.<verse eid="ISA 13:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 13:22" />Hagúarahaba chakali lidan burí wáyelesi,</para>
  <para style="q" vid="ISA 13:22">ñéinbaña ounli áraabuna tidan burí palasiu wéndegutu.</para>
  <para style="q" vid="ISA 13:22">Yarafaali lóurate Babilónia, míbeeli weyu lubá».<verse eid="ISA 13:22" /></para>
  <chapter eid="ISA 13" />
  <chapter number="14" style="c" sid="ISA 14" />
  <para style="s1">Hagiribudun lumutuniña Bungiu hageiroun</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 14:1" />Gudemehabubei Wabungiute lun Ísüraeli, lanügayabei Ísüraeli kei néchani le lanúadirubei, ladügüba lun hayabinya Ísüraelina aganawa hamúanrugu. Hayarafaduba terencha houn, hóundaruba hamoun lánigu Ísüraeli. <verse eid="ISA 14:1" /><verse number="2" style="v" sid="ISA 14:2" />Heresibirubaña saragu néchanigu Ísüraelina ábame houdin hama hageira, ábame hanügüniña Ísüraelina néchanigu hagía keisi hadamun lumúanrugu Wabureme. Hadaürübaña Ísüraelina ha meha adaürübaliña, hagumadihaba hawagu ha meha íchugubaña lidere dan houn.<verse eid="ISA 14:2" /></para>
  <para style="s1">Labularún lurúeite Babilónia</para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 14:3" />Lílana Ísüraeli, danme lemeraaguagüdünün Wabureme lídangiñe amudirawaguni luma súfuri, le gádanbalün, <verse eid="ISA 14:3" /><verse number="4" style="v" sid="ISA 14:4" />hariñagubei poema le, lun hadügün bula lau lurúeite Babilónia:</para>
  <para style="b" vid="ISA 14:4" />
  <para style="q" vid="ISA 14:4">Ariha humá ida liña lan herederun ha wuribabaña guentó!</para>
  <para style="q" vid="ISA 14:4">Ariha humá ida liña lan lagumuchagun hanarime!<verse eid="ISA 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 14:5" />Gidala Wabureme ubafu háhaburugugiñe,</para>
  <para style="q" vid="ISA 14:5">halagualá habadun gumadimatiña ha wuribabaña,<verse eid="ISA 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 14:6" />ha meha abeichubaliña néchanigu lau igañi,</para>
  <para style="q" vid="ISA 14:6">háñaha aburechagubaliña lílana fulasu lau igañi,</para>
  <para style="q" vid="ISA 14:6">éibaaha hamaña magudemehabuga.<verse eid="ISA 14:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 14:7" />Darangilañu liña sun ubóu guentó,</para>
  <para style="q" vid="ISA 14:7">sun gürigia eremuhatiña lau ugundani.<verse eid="ISA 14:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 14:8" />Íbini burí lídibu gudi luma burí hibúari le Líwanuna</para>
  <para style="q" vid="ISA 14:8">gúndaatiña lau bagünrinchawagun, hariñaga:</para>
  <para style="q" vid="ISA 14:8">«Lúmagiñe bábürühan, máchuahounhadiwa».<verse eid="ISA 14:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 14:9" />Anihein óunwenbu hingiguaü ǘnabu hadan hilaaña,</para>
  <para style="q" vid="ISA 14:9">furitiña eresibirabu.</para>
  <para style="q" vid="ISA 14:9">Agagudúatiña hilaaña, sun lábutigu ubóu furitiña bubaroun;</para>
  <para style="q" vid="ISA 14:9">sun lurúeitegu burí fulasu saratiña luéigiñe lálana harúeihan.<verse eid="ISA 14:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 14:10" />Sun hagía adimurehatiña, hariñaga bun:</para>
  <para style="q" vid="ISA 14:10">«Féridiba giñe bere, ítarahadibu kei wagía.<verse eid="ISA 14:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 14:11" />Ya liabin banaagun bungua eredera luma búyanute.</para>
  <para style="q" vid="ISA 14:11">Iñalaü bigabananboun, héweraü bisidin».<verse eid="ISA 14:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 14:12" />Ábürühaadibu siélugiñe,</para>
  <para style="q" vid="ISA 14:12">waruguma lánina binaafin!</para>
  <para style="q" vid="ISA 14:12">Fuíwaadibu múarugun,</para>
  <para style="q" vid="ISA 14:12">buguyañaha le agañeirubalin wuribu hawagu néchanigu.<verse eid="ISA 14:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 14:13" />Ariñagatibu yebe búnguarügü:</para>
  <para style="q" vid="ISA 14:13">«Namudeiruba chülǘ sielu,</para>
  <para style="q" vid="ISA 14:13">níchugubei lálana narúeihan hagibuagu luaruguman Wabungiute;</para>
  <para style="q" vid="ISA 14:13">nañuuruba yágüta dise luagun nórute,</para>
  <para style="q" vid="ISA 14:13">luagu wübü le ñein lubéi hóundaragua búngiugu.<verse eid="ISA 14:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 14:14" />Namudeiruba íñunmeme luéi dúeri le íñutimabei;</para>
  <para style="q" vid="ISA 14:14">ítara nuba kei Bungiu le Íñutimabei».<verse eid="ISA 14:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 14:15" />Gama lumoun inarüni luagu rarihadibu lan lidoun larúeihan óunweni,</para>
  <para style="q" vid="ISA 14:15">lidoun lǘnabun-agei umúahaü!<verse eid="ISA 14:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 14:16" />Ha arihubalibu, rédeitiña aríaguabu,</para>
  <para style="q" vid="ISA 14:16">dan haríagunibu aba hariñagun:</para>
  <para style="q" vid="ISA 14:16">«Anihán meha san wügüri le adadagaragüdübalin ubóu,</para>
  <para style="q" vid="ISA 14:16">le meha agünrinchagubaliña néchanigu?<verse eid="ISA 14:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 14:17" />Le ígirubalin ubóu kei aban fulasu mageirawati,</para>
  <para style="q" vid="ISA 14:17">le meha águdahabalin uburugu,</para>
  <para style="q" vid="ISA 14:17">le meha máfuridagüdünbaliña adaürǘtiña?»<verse eid="ISA 14:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ISA 14:18" />Sun lurúeitegu néchanigu, hemeraaguña lau uéiriguni,</para>
  <para style="q" vid="ISA 14:18">kada aban lidan lumuaha;<verse eid="ISA 14:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 14:19" />ánheinti buguya fuíwatibu dise</para>
  <para style="q" vid="ISA 14:19">luéi umúahaü kei ifei le mínsiñeguti;</para>
  <para style="q" vid="ISA 14:19">kei hágubu hilaaña le dügüwaguati,</para>
  <para style="q" vid="ISA 14:19">hadan gürigia áfarawagutiña, ha adürürǘtiña ichügü,</para>
  <para style="q" vid="ISA 14:19">ha agurútiña lidoun huyu buin lau dübü.<verse eid="ISA 14:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 14:20" />Mabunúnbadibu kei híbiri urúeigu,</para>
  <para style="q" vid="ISA 14:20">lugundun gadei bumuti bageira,</para>
  <para style="q" vid="ISA 14:20">áfaragua bumutiña lílana bageira.</para>
  <para style="q" vid="ISA 14:20">Madurabaña hadügawagun wuribatiña lun sun dan.<verse eid="ISA 14:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="ISA 14:21" />Aranse humá lun háfaraguniña isaanigu luéigiñe</para>
  <para style="q" vid="ISA 14:21">áfarahani le hadügübei hagübürigu,</para>
  <para style="q" vid="ISA 14:21">masaminarun hamaamuga hagumadihanya ubouagu,</para>
  <para style="q" vid="ISA 14:21">ni habuinchagüdüni ubóu lau burí uburugu.<verse eid="ISA 14:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="ISA 14:22" />Lariñahare Wabureme Suntigabafu:</para>
  <para style="q" vid="ISA 14:22">«Nuadigimarida hawagu,</para>
  <para style="q" vid="ISA 14:22">nagumucha lau liri Babilónia luma le erederuti lídangiñe,</para>
  <para style="q" vid="ISA 14:22">hau lirahüñü hama libañan.<verse eid="ISA 14:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 14:23" />Nadügaali suánpume, fulasume le buin umuti hau garún.</para>
  <para style="q" vid="ISA 14:23">Nabuidaali lau abuidagülei le lánina günringuaü.</para>
  <para style="q" vid="ISA 14:23">Wabureme Suntigabafu ariñagubalin».<verse eid="ISA 14:23" /></para>
  <para style="s1">Libügürü Asiria</para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 14:24" />Fiñuhali Suntigabafu ariñaga:</para>
  <para style="q" vid="ISA 14:24">«Le nariñagubei luagu nadügübei lan, lasusereduba,</para>
  <para style="q" vid="ISA 14:24">chóuruti; lagunfuliruba le naritagubei.<verse eid="ISA 14:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 14:25" />Nagünrinchagubaña lílana Asiria nageira,</para>
  <para style="q" vid="ISA 14:25">naburechagubaña lidan náraabute.</para>
  <para style="q" vid="ISA 14:25">Lidere dan le híchugubei hawagun numutuniña lagidarúba hawéi,</para>
  <para style="q" vid="ISA 14:25">gidawa ligíame lihürü hanügün hégewagugiñe.<verse eid="ISA 14:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 14:26" />Anihán naransehabei libügürü sun ubóu.</para>
  <para style="q" vid="ISA 14:26">Ayawadagua numutiña sun néchanigu lau núhabu».<verse eid="ISA 14:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="ISA 14:27" />Aranse laali Wabureme Suntigabafu lun ítara luba lan,</para>
  <para style="q" vid="ISA 14:27">úabei ni aban lun lerederuni.</para>
  <para style="q" vid="ISA 14:27">Layawadaguña lúhabu, úabei ni aban asansiraguagüdüti laritagun.<verse eid="ISA 14:27" /></para>
  <para style="s1">Lagünrinchagubei Wabungiute Filistéa</para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 14:28" />Anihán dimurei le lariñagubei Isaíasi</para>
  <para style="q" vid="ISA 14:28">lidan irumu le lóunwenbei urúei Aasi:<verse eid="ISA 14:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 14:29" />«Magundaarabá néchani Filistéa,</para>
  <para style="q" vid="ISA 14:29">lau láhalachawagun wewe le meha aubei babeichúa,</para>
  <para style="q" vid="ISA 14:29">ladüga le ñéingiñe lubéi táfurida aban tuwuyeri hewe,</para>
  <para style="q" vid="ISA 14:29">táfuriduba ámuya tuwuyeri, sügǘ lau lira,</para>
  <para style="q" vid="ISA 14:29">láfuriduba aban düragón áhamahati.<verse eid="ISA 14:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="ISA 14:30" />Hadariruba gudemetiña sagadi houn halügüniña nicharirugu,</para>
  <para style="q" vid="ISA 14:30">gürigia ha úabei ni kata hama hemeraaguba darangilu.</para>
  <para style="q" vid="ISA 14:30">Gama lumoun nadügüba lun hóunwegun bumutuniña lau ilamaü,</para>
  <para style="q" vid="ISA 14:30">áfaragua náñame fiu ha erederubaña.<verse eid="ISA 14:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="ISA 14:31" />Hayahuaha lílana burí uburugu Filistéa,</para>
  <para style="q" vid="ISA 14:31">hagúaraha lau igari, hadadagara lau anufudei!</para>
  <para style="q" vid="ISA 14:31">Lugundun hayabinba súdaragu luéigiñe nórute kei gumuleli;</para>
  <para style="q" vid="ISA 14:31">úabei ni aban wügüri áfuriduti lídangiñe fíleiti».<verse eid="ISA 14:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="ISA 14:32" />Kábagia au hounabúa ha ounahóubaña</para>
  <para style="q" vid="ISA 14:32">lau uganu lídangiñe ageiraü le?</para>
  <para style="q" vid="ISA 14:32">Luagu ru laali lan Wabureme iderebugu lun Sión,</para>
  <para style="q" vid="ISA 14:32">ani lánigu ha nidiheribaña, haramudaguba ñein.<verse eid="ISA 14:32" /></para>
  <chapter eid="ISA 14" />
  <chapter number="15" style="c" sid="ISA 15" />
  <para style="s1">Libügürü Moabü</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 15:1" />Dimurei luagu Moabü:</para>
  <para style="q" vid="ISA 15:1">Áriebu le lagünrinchawagunbei Arü,</para>
  <para style="q" vid="ISA 15:1">ligía lagumuchagun Moabü;</para>
  <para style="q" vid="ISA 15:1">áriebu le lagünrinchawagunbei Kirü,</para>
  <para style="q" vid="ISA 15:1">ligía lagumuchagun Moabü.<verse eid="ISA 15:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 15:2" />Múdeitiña lílana Dibón ayahuaha</para>
  <para style="q" vid="ISA 15:2">tidan ténpulu to luáguboun wübü.</para>
  <para style="q" vid="ISA 15:2">Ayahuahati Moabü luagu lagünrinchagun Nebu luma Medebá.</para>
  <para style="q" vid="ISA 15:2">Lun harufuduni hagarigu luma hirun</para>
  <para style="q" vid="ISA 15:2">sáwati hádiburi súngubei biwa hádiuma.<verse eid="ISA 15:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 15:3" />Táuñañu daüguaü súsutu gürigia ǘmada;</para>
  <para style="q" vid="ISA 15:3">agúarahatiña tábulugugiñe muna lau gáriti.</para>
  <para style="q" vid="ISA 15:3">Ayahuahatiña sun gürigia lau saragu águiraü mágidurugu.<verse eid="ISA 15:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 15:4" />Amuriahati Esübón luma Elalé ídemuei;</para>
  <para style="q" vid="ISA 15:4">aganbúati hagúarahan chülǘ Haasü.</para>
  <para style="q" vid="ISA 15:4">Ligía habuinchunbei súdara Moábüna lau anufudei.<verse eid="ISA 15:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 15:5" />Amuriahatu nanigi íderawaguni lun Moabü,</para>
  <para style="q" vid="ISA 15:5">anurahatiña lílana darí Sóarü, darí Egülátü-selisíya.</para>
  <para style="q" vid="ISA 15:5">Mudei hamuti luwübüri Luidü ayahuaheina;</para>
  <para style="q" vid="ISA 15:5">agúarahatiña lau igarigu luagu günringuaü</para>
  <para style="q" vid="ISA 15:5">éibugeina luagu lémeri Oronaímü.<verse eid="ISA 15:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 15:6" />Mábeiha burí luelun Nimürímü, saüha híduru,</para>
  <para style="q" vid="ISA 15:6">hilá burí sagadi, meredeti ni aban ubanaü wurigili.<verse eid="ISA 15:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 15:7" />Ligía habudahanbalin gürigia harisin,</para>
  <para style="q" vid="ISA 15:7">aba hanügüni yagürounmeme luéi lísensen duna le Álamosu.<verse eid="ISA 15:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 15:8" />Geyeguati lamuriahóun ídemuei lau láfadaragun Moabü;</para>
  <para style="q" vid="ISA 15:8">chülüti ayahuni dagá Egülaímü luma Beerü-elimü.<verse eid="ISA 15:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 15:9" />Lau sun buin liña lan burí luelun Dimón lau hitaü,</para>
  <para style="q" vid="ISA 15:9">nóunahamemeba wuribani wéinamutimati luagun;</para>
  <para style="q" vid="ISA 15:9">léigibaña aban liñún ha esefurutiña Moábügiñe,</para>
  <para style="q" vid="ISA 15:9">ha erederutiña wínwanñu ubouagu.<verse eid="ISA 15:9" /></para>
  <chapter eid="ISA 15" />
  <chapter number="16" style="c" sid="ISA 16" />
  <para style="s1">Haramudagun lílana Moabü uburugu Hudá</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 16:1" />Óunahatiña lábutigu fulasu mudún Selaagiñe</para>
  <para style="q" vid="ISA 16:1">le fulasurugubei mageirawati, darí luagun wübü Sión.<verse eid="ISA 16:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 16:2" />Ítara haña lílana Moabü luagu lémeri Arünón</para>
  <para style="q" vid="ISA 16:2">kei dunuru éibaawaguagüdütiña lídangiñe hamasa.<verse eid="ISA 16:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 16:3" />Hariñaga lun Sión:</para>
  <para style="q" vid="ISA 16:3">«Aransehabá lun baramuduniwa, bageindagua waweigiñe.</para>
  <para style="q" vid="ISA 16:3">Tulebei bamuñadina amidirugu kamá hamuga áriebu;</para>
  <para style="q" vid="ISA 16:3">ruba muna houn ha anurahabaña.<verse eid="ISA 16:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 16:4" />Ígiraba lun haramudagun anurahatiña Moábüna bidan,</para>
  <para style="q" vid="ISA 16:4">aramudabaña luéi le álugubei lagünrinchaguniña».</para>
  <para style="b" vid="ISA 16:4" />
  <para style="q" vid="ISA 16:4">Danme lagumuchun hibihin lidere dan,</para>
  <para style="q" vid="ISA 16:4">sügǘ ligíame günringuaü, danme ñǘdünhali le ebelurubei lau lere fulasurugugiñe,<verse eid="ISA 16:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 16:5" />lárügüdübei aban ladügawagun Dawidi arúeihani,</para>
  <para style="q" vid="ISA 16:5">arúeihani le derebuguti lau areini.</para>
  <para style="q" vid="ISA 16:5">Ábanbei aguseragüdüti le úaraguati ligía,</para>
  <para style="q" vid="ISA 16:5">líchugubei irichaü lun le garichabei.<verse eid="ISA 16:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 16:6" />Subudi wamuti lanarime lupantan Moabü,</para>
  <para style="q" vid="ISA 16:6">lanaagun lungua luma lanarimegu,</para>
  <para style="q" vid="ISA 16:6">luma burí lumalan lererun.<verse eid="ISA 16:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 16:7" />Ligía hayahuba lubéi sun lílana Moabü luagu hanechanin;</para>
  <para style="q" vid="ISA 16:7">hasandiruba igarigu lidan hadiheri hawagu lílana Kirü-aresetü.<verse eid="ISA 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 16:8" />Saüha tídibu burí beibei to Esübónboun luma Sibümá,</para>
  <para style="q" vid="ISA 16:8">günringua hamá lílana néchani.</para>
  <para style="q" vid="ISA 16:8">Chülüti meha burí tilimun chülǘ Haserü,</para>
  <para style="q" vid="ISA 16:8">sügǘ luéigiñe fulasu mageirawati,</para>
  <para style="q" vid="ISA 16:8">chülǘ yagürounmeme luéi barana.<verse eid="ISA 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 16:9" />Ligía nayahuba lubéi tuagu beibei-agei to lani Sibümá,</para>
  <para style="q" vid="ISA 16:9">kéigubeirügü luagu Haserü, ayahua au luagu Esübón luma Elalé,</para>
  <para style="q" vid="ISA 16:9">lugundun luagun le alubahóubei bídangiñe</para>
  <para style="q" vid="ISA 16:9">lábürüha agúarahani lánina wuribu.<verse eid="ISA 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 16:10" />Lagumuchuba ugundani luma areini áraabu;</para>
  <para style="q" vid="ISA 16:10">úaalime laguarahóun lau ugundani,</para>
  <para style="q" vid="ISA 16:10">ni eremuhani beibei-ágeirugu,</para>
  <para style="q" vid="ISA 16:10">machuinrúnharume giñe beibei lun lasagarun diwéin tídangiñe.</para>
  <para style="q" vid="ISA 16:10">Gumugua agúarahani.<verse eid="ISA 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 16:11" />Hingiguatu nanigi kei aban árüpa luagu Moabü</para>
  <para style="q" vid="ISA 16:11">luma luagu Kirü-aresetü.<verse eid="ISA 16:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 16:12" />Íbini lidin Moabü luagu burí wübü,</para>
  <para style="q" vid="ISA 16:12">lun layumuragun ñein darí labuchadun luagu,</para>
  <para style="q" vid="ISA 16:12">íbini lidin afurieida litenpulunrugu, madaribei ni kata.<verse eid="ISA 16:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="ISA 16:13" />Anihán burí dimurei le lariñagubei Wabureme luagu Moabü lúmagiñe binarü. <verse eid="ISA 16:13" /><verse number="14" style="v" sid="ISA 16:14" />Guentó, lariñahare Wabureme:</para>
  <para style="b" vid="ISA 16:14" />
  <para style="q" vid="ISA 16:14">«Ǘrüwa irumu lárigiñe le,</para>
  <para style="q" vid="ISA 16:14">kei labahüdüni aban nadagimeinti le awinwandubei lídangiñe lafayeiruaha,</para>
  <para style="q" vid="ISA 16:14">lanügüba luéirigun Moabü kei ni kata, lau sun hibe gürigia ñein;</para>
  <para style="q" vid="ISA 16:14">biánraürügübaña eredera, ha méretiña».<verse eid="ISA 16:14" /></para>
  <chapter eid="ISA 16" />
  <chapter number="17" style="c" sid="ISA 17" />
  <para style="s1">Labeichubei Bungiu Damasüku</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 17:1" />Dimurei luagu Damasüku:</para>
  <para style="q" vid="ISA 17:1">«Mámaalime uburugu Damasüku;</para>
  <para style="q" vid="ISA 17:1">ábanhalime lárigirugu fulasu.<verse eid="ISA 17:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 17:2" />Lerederuba málouga lun sun dan,</para>
  <para style="q" vid="ISA 17:2">lerederuba héigagüleme animaalugu sagadi;</para>
  <para style="q" vid="ISA 17:2">gayaraabei heigin animaalugu ñein darangilu.<verse eid="ISA 17:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 17:3" />Éfürain, le lapantaagülebei Ísüraeli,</para>
  <para style="q" vid="ISA 17:3">maburugutehalime le baríeiruati;</para>
  <para style="q" vid="ISA 17:3">ítara giñe, Damasüku le erederubei lídangiñe Siria</para>
  <para style="q" vid="ISA 17:3">úaalime arúeihani ñein.</para>
  <para style="q" vid="ISA 17:3">Wabureme Suntigabafu ariñagubalin.<verse eid="ISA 17:3" /></para>
  <para style="s1">Labeichún Ísüraeli</para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 17:4" />«Lídanme weyu ligía,</para>
  <para style="q" vid="ISA 17:4">leferidirubei Samaria le lapantaagüle Hakobu lere,</para>
  <para style="q" vid="ISA 17:4">lagumuchaguba lubuidun lidaani.<verse eid="ISA 17:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 17:5" />Ítara luba kei dan le lalubahani alubahati türigu</para>
  <para style="q" vid="ISA 17:5">aba labudahani lilimun lau lúhabu,</para>
  <para style="q" vid="ISA 17:5">o kei dan labudahóun limu lidan fulasu wayati le gíribei Refaímü,<verse eid="ISA 17:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 17:6" />le ñein lubéi ígiragutirügüñein lan abulieidúti eredera,</para>
  <para style="q" vid="ISA 17:6">o kei lan dan le lewenihóun oliwu</para>
  <para style="q" vid="ISA 17:6">aba terederun biámarügü o ǘrüwa aseitúna lígirugu aban limu</para>
  <para style="q" vid="ISA 17:6">o tibe-agei lan erederutu gádürü o seingü luagu tídibu.</para>
  <para style="q" vid="ISA 17:6">Wabureme le Lubungiute Ísüraeli ariñagubalin».<verse eid="ISA 17:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 17:7" />Lídanme weyu ligía,</para>
  <para style="q" vid="ISA 17:7">larihuba gürigia luagun le adügübalin,</para>
  <para style="q" vid="ISA 17:7">luagun Wabungiute le Sándubei,</para>
  <para style="q" vid="ISA 17:7">le Lubungiute Ísüraeli.<verse eid="ISA 17:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 17:8" />Marihindigiaalime luagun latarü ni luagun</para>
  <para style="q" vid="ISA 17:8">burí amu katei le hadüga wügüriña lau háhabu.</para>
  <para style="q" vid="ISA 17:8">Meberesendigiaalime lau ugudinaü sagüráuti,</para>
  <para style="q" vid="ISA 17:8">ni lau burí latarü le ñein lubéi</para>
  <para style="q" vid="ISA 17:8">lágudahoua kupali houn búngiugu.<verse eid="ISA 17:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 17:9" />Lídanme weyu ligía,</para>
  <para style="q" vid="ISA 17:9">ligirúba burí buburugute le íñubei lubarieirun málouga,</para>
  <para style="q" vid="ISA 17:9">kei ligirún burí haburugute Eweuna hama Amoruna</para>
  <para style="q" vid="ISA 17:9">ladüga lanufudewa hawéi Ísüraelina.</para>
  <para style="q" vid="ISA 17:9">Lerederuba burí uburugu ligía málouga,<verse eid="ISA 17:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 17:10" />ladüga babulieiduni Wabungiute le esefurubalibu,</para>
  <para style="q" vid="ISA 17:10">maritagun bumuti luagu ligía lan baramudaguagülebei le chóurubei.</para>
  <para style="q" vid="ISA 17:10">Bunagua bumuti lubuidun burí fuluri-agei le,</para>
  <para style="q" vid="ISA 17:10">bunaguatibu nadü lidan liri aban bungiu terenchati,<verse eid="ISA 17:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 17:11" />aranseha bumuti lidan weyu le bábunaguni,</para>
  <para style="q" vid="ISA 17:11">adüga buguya lun láhüchün larugan.</para>
  <para style="q" vid="ISA 17:11">Gama lumoun danme liabin sandi luma</para>
  <para style="q" vid="ISA 17:11">wuribani le mareidaguaditi leferidiruba alubahóuni.<verse eid="ISA 17:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 17:12" />Aganba huméi lamuri hareinchun saragu gürigia</para>
  <para style="q" vid="ISA 17:12">kamá hamuga lamuri barana!</para>
  <para style="q" vid="ISA 17:12">Ítara liña haréin néchanigu kei lamuri léibaagun duna héreti.<verse eid="ISA 17:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 17:13" />Gama lumoun dan le ladeinhan Bungiu houn,</para>
  <para style="q" vid="ISA 17:13">aba hanurahan diseun kei ifei le lanügübei garabali</para>
  <para style="q" vid="ISA 17:13">o kei lan híduru le laduruuhan luriban dan.<verse eid="ISA 17:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 17:14" />Hanarimetiña rábounweyu,</para>
  <para style="q" vid="ISA 17:14">gama lumoun lubaragiñe larugadun, hilagua.</para>
  <para style="q" vid="ISA 17:14">Ítara liña heben ha asagarahabaliwa,</para>
  <para style="q" vid="ISA 17:14">ítara liña hagumuchun ha agünrinchagubaliwa.<verse eid="ISA 17:14" /></para>
  <chapter eid="ISA 17" />
  <chapter number="18" style="c" sid="ISA 18" />
  <para style="s1">Labeichubei Bungiu Etiopía</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 18:1" />Fugiabu ageiraü le ñein lubéi hahunha íñenaü,</para>
  <para style="q" vid="ISA 18:1">ageiraü le yagürounmémebei luéi lidunari Etiopía,<verse eid="ISA 18:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 18:2" />le óunahabaliña lóunagülegu luéigiñe Nilu,</para>
  <para style="q" vid="ISA 18:2">áfayaheina dúnarugu tidan ugunei lautu maburu!</para>
  <para style="q" vid="ISA 18:2">Heiba furese óunagüleigu,</para>
  <para style="q" vid="ISA 18:2">houn gürigia gágubutiña ha mirí tura</para>
  <para style="q" vid="ISA 18:2">houn néchanigu ha hanufudewati hawéi lidan sun fulasu,</para>
  <para style="q" vid="ISA 18:2">gürigia héretiña, barügua houngua ha aganóubaña lidan aban fulasu</para>
  <para style="q" vid="ISA 18:2">le ñein lumuti saragu duna éibaaguati.<verse eid="ISA 18:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 18:3" />Sun huguya le lílana ubóu,</para>
  <para style="q" vid="ISA 18:3">harihubei seini luagu wübü,</para>
  <para style="q" vid="ISA 18:3">aganba humeime danme línwinrun fidu.<verse eid="ISA 18:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 18:4" />Lariñahare Wabureme nun:</para>
  <para style="q" vid="ISA 18:4">«Arihatina darangilu le ñéingiñe nubéi kei</para>
  <para style="q" vid="ISA 18:4">larugounga lidan aban weyu irumurugu,</para>
  <para style="q" vid="ISA 18:4">kei serenu lidan lárouga lidan lidaani alubahani.<verse eid="ISA 18:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 18:5" />Danme lásügürün tegelewehan beibei,</para>
  <para style="q" vid="ISA 18:5">lun táfunadun tin,</para>
  <para style="q" vid="ISA 18:5">lubaragiñe lidaani alubahani,</para>
  <para style="q" vid="ISA 18:5">latirimuhóuba limu tau gusiñu,</para>
  <para style="q" vid="ISA 18:5">láchuahouba ábame lagidarún ñéingiñe.<verse eid="ISA 18:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 18:6" />Lerederuba súngubei áraabu mebereserúnga lau</para>
  <para style="q" vid="ISA 18:6">houn dunuru áraabuna hama animaalugu áraabuna.</para>
  <para style="q" vid="ISA 18:6">Ñeinba hásügürei dunuru lidaani lubachouga,</para>
  <para style="q" vid="ISA 18:6">herederuba sun animaalugu áraabuna ñein lidan luribouga».<verse eid="ISA 18:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 18:7" />Lídanme dan ligía,</para>
  <para style="q" vid="ISA 18:7">lanügüba idewesei lun Wabureme Suntigabafu</para>
  <para style="q" vid="ISA 18:7">luéigiñe hóubadina lílana fulasu ha gágububaña, mirí ligía hara,</para>
  <para style="q" vid="ISA 18:7">néchanigu ha uéibaña hanufudewa lan lidan sun fulasu,</para>
  <para style="q" vid="ISA 18:7">gürigia héretiña, íñuguti hanaagun houngua,</para>
  <para style="q" vid="ISA 18:7">ha aganóubaña lidan fulasu le ñein lumuti saragu duna éibaaguati.</para>
  <para style="q" vid="ISA 18:7">Hanügübei idewesei ligía luagun wübü Sión</para>
  <para style="q" vid="ISA 18:7">le ñein lubéi laguahóua liri Wabureme Suntigabafu.<verse eid="ISA 18:7" /></para>
  <chapter eid="ISA 18" />
  <chapter number="19" style="c" sid="ISA 19" />
  <para style="s1">Labeichubei Bungiu Ehiptu</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 19:1" />Dimurei luagu Ehiptu. Ariha humá lun Wabureme:</para>
  <para style="q" vid="ISA 19:1">Liábiña Ehiptun wariñu ligibuagu aban dúeri fureseti.</para>
  <para style="q" vid="ISA 19:1">Adadagaratiña lubungiutegu Ehiptu ligibugiñe,</para>
  <para style="q" vid="ISA 19:1">buin hagía Ehiptuna lau anufudei.<verse eid="ISA 19:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 19:2" />Lariñaga Wabungiute:</para>
  <para style="q" vid="ISA 19:2">«Nafanreinraguagüdübaña Ehiptuna, lun hageindagun hámagua,</para>
  <para style="q" vid="ISA 19:2">umadaü luma umadaü, uburugu luma uburugu,</para>
  <para style="q" vid="ISA 19:2">arúeihani luma arúeihani.<verse eid="ISA 19:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 19:3" />Nabulieidaguagüdübaña, nagünrinchagubei haransehan.</para>
  <para style="q" vid="ISA 19:3">Ábameti hálügüdahan hama haguariuan luma hama gabiñarahatiña,</para>
  <para style="q" vid="ISA 19:3">hama hani hilaguaaña sífiri luma hama garíaahatiña.<verse eid="ISA 19:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 19:4" />Gama lumoun níchugubei Ehiptu labun lubafu aban aburemei dereti;</para>
  <para style="q" vid="ISA 19:4">lagumadihaba aban urúei fásiti Ehiptu».</para>
  <para style="q" vid="ISA 19:4">Wabureme Suntigabafu achoururubalin.<verse eid="ISA 19:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 19:5" />Lagumuchuba lidunari Nilu,</para>
  <para style="q" vid="ISA 19:5">lamabeiduba duna sunsuinagubei,<verse eid="ISA 19:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 19:6" />língiduba burí chanili.</para>
  <para style="q" vid="ISA 19:6">Lídiba burí léibaagun duna Ehiptuna</para>
  <para style="q" vid="ISA 19:6">agumuchagueina darí lamabeidun,</para>
  <para style="q" vid="ISA 19:6">lásaürüba burí maburu luma sagadi duruti;<verse eid="ISA 19:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 19:7" />Lásaürüba sun nadü le lárubei duna Nilu,</para>
  <para style="q" vid="ISA 19:7">lanügübei garabali sun ídibu</para>
  <para style="q" vid="ISA 19:7">ábame lagumuchagun.<verse eid="ISA 19:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 19:8" />Hayahuahaba sun ha óuchahabaña lidan duna Nilu;</para>
  <para style="q" vid="ISA 19:8">hírudaguba ha esenihabaña.<verse eid="ISA 19:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 19:9" />Hadiheriduba ha nadagimeinbaña gamisa fínuburitu;<verse eid="ISA 19:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 19:10" />Labuchaduba hawagu adaagutiña gamisa,</para>
  <para style="q" vid="ISA 19:10">bulíeigua hagíame gadiñetiña.<verse eid="ISA 19:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ISA 19:11" />Ibidiouguati hau huguya lábutigu Soán,</para>
  <para style="q" vid="ISA 19:11">eweridihatiña hátima chúbaña aau Ehiptu,</para>
  <para style="q" vid="ISA 19:11">ha eweridihabaña ibidiouguati hau huguya lidan linarün katei!</para>
  <para style="q" vid="ISA 19:11">Ida liñagia liábinbei hun lun hariñagun lun urúei Ehiptuna:</para>
  <para style="q" vid="ISA 19:11">«Hadügawagun chu tau wagía,</para>
  <para style="q" vid="ISA 19:11">hadügawagun binadu urúeigu»?<verse eid="ISA 19:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 19:12" />Hagañagia bánigu chu tau, urúei Ehiptuna, lun harufudahani</para>
  <para style="q" vid="ISA 19:12">luma lun hasubudiragüdüni laransehan</para>
  <para style="q" vid="ISA 19:12">Wabureme Suntigabafu bun lubá Ehiptu?<verse eid="ISA 19:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 19:13" />Ibidiouguati hau lábutigu Soán,</para>
  <para style="q" vid="ISA 19:13">ígiraguagüdatiña lábutigu Ménfisi houngua lun heyeedúniwa,</para>
  <para style="q" vid="ISA 19:13">barǘ hamaali lábutigu fulasu Ehiptu luéigiñe üma wuribati.<verse eid="ISA 19:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 19:14" />Rúhali Wabureme aban sífiri lánina bulíeiguaü hadoun;</para>
  <para style="q" vid="ISA 19:14">barǘ hamuti Ehiptu luéigiñe üma wuribati lidan sun le ladügübei,</para>
  <para style="q" vid="ISA 19:14">kei aban bacharuati le atuituihabei lárigi lewerahan.<verse eid="ISA 19:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 19:15" />Ani úati ni kata, ni rísiti ni gudemeti,</para>
  <para style="q" vid="ISA 19:15">ni wéiriguti ni ǘnabuguti</para>
  <para style="q" vid="ISA 19:15">lun gayara lan ladügün ni kata luagu lufulesein Ehiptu.<verse eid="ISA 19:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="ISA 19:16" />Lídanme weyu ligía, ítara haba Ehiptuna kei würiña, habuinchuba lau anufudei danme harihini liñuruni Wabureme lúhabu hawagun. <verse eid="ISA 19:16" /><verse number="17" style="v" sid="ISA 19:17" />Hasandiruba Ehiptuna anufudei ligibugiñe Hudá; láurügüme haritagun luagu liri. Habuinchuba lau anufudei luagu le laritagubei Wabureme Suntigabafu lau Ehiptu. <verse eid="ISA 19:17" /><verse number="18" style="v" sid="ISA 19:18" />Lídanme weyu ligía, ñeinbei seingü uburugu adimurehati ebüréu Ehiptu, fiñú hagíame gúnfuli lun Wabureme Suntigabafu. Luburugute Weyu, ligíaba liri aban lídangiñe uburugu ligía.<verse eid="ISA 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 19:19" />Lídanme weyu ligía, ñeinbei aban latarü deregewati lun Wabureme Ehiptu, lichugúba aban dübü lidan liri Wabureme yarafa lun láfadaragun Ehiptu. <verse eid="ISA 19:19" /><verse number="20" style="v" sid="ISA 19:20" />Leseriwiduba kei seini lun laritawagún luagu Wabureme Suntigabafu Ehiptu. Danme hagúaragun lun Wabureme amuriaha ídemuei hawéi ha íchugubaña lidere dan houn, lóunahaba aban esefuragülei houn lun lesefuruniña. <verse eid="ISA 19:20" /><verse number="21" style="v" sid="ISA 19:21" />Lasubudiraguagüdüba Wabureme lungua houn Ehiptuna, ábame hasubudiruni; hadügüba óundaruni lun, adagaragüda hagíame lun, ru hagíame idewesei lun. Hadügüba füramasei lun Wabureme ani hagunfulirubei. <verse eid="ISA 19:21" /><verse number="22" style="v" sid="ISA 19:22" />Lóunahaba Wabureme sandi luagun Ehiptu, gama lumoun lárigiñeme ábame lagaranihan lun. Háluahabei Wabureme, ábame gudemehabu lan houn, ábame lagaranihan houn.<verse eid="ISA 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 19:23" />Lídanme weyu ligía, ñeinbei aban üma tuleti lúmagiñe Ehiptu darí Asiria. Gayaraabei hachülürün Asiriana chülǘ Ehiptu, gayaraame hachülürün Ehiptuna chülǘ Asiria, ábame háhuduragun Ehiptuna hama Asiriana lun Wabureme lidan aban.<verse eid="ISA 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 19:24" />Lídanme weyu ligía, lúaraduba Ísüraeli luma Ehiptu luma Asiria, ani ábanbaña abiniruni ubouagu. <verse eid="ISA 19:24" /><verse number="25" style="v" sid="ISA 19:25" />Labinirubaña Wabureme Suntigabafu ariñageina: «Biní numuti Ehiptu le nánigu, Asiria, le nadügübei lau núhabu luma Ísüraeli, nánigu le nanúadirubei».<verse eid="ISA 19:25" /></para>
  <chapter eid="ISA 19" />
  <chapter number="20" style="c" sid="ISA 20" />
  <para style="s1">Lagañeiruni Asiria Ehiptu luma Etiopía</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 20:1" />Luagu aban dan, aban lóunahan Sarügón le lurúeite Asiria aban úfisi íñuguti uburugun Asüdódu, aba lábürühan úfisi ligía luagun uburugu Asüdódu aba lagañeiruni.<verse eid="ISA 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 20:2" />Lidoun dan ligía, aba ladimurehan Wabureme lídangiñe Isaíasi, le liráü Amosu, lariñaga lun:</para>
  <para style="p" vid="ISA 20:2">—Ragaboun daüguaü súsutu to buáguboun buáriua tuma sabadu to luáguboun Bugudi. Aba ladügüni Isaíasi le lariñagubei Wabungiute lun, aba lerederun mageidinga tau murusun gamisa luougua.<verse eid="ISA 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 20:3" />Ábati lariñagun Wabureme:</para>
  <para style="p" vid="ISA 20:3">—Rédeihali Isaíasi masabadunga tau murusun gamisa luougua luagu ǘrüwa irumu, kei seini lun Ehiptu luma Etiopía. <verse eid="ISA 20:3" /><verse number="4" style="v" sid="ISA 20:4" />Ítara luba giñe lanügüniña lurúeite Asiria Ehiptuna hama Etiopíana lidoun, amu fulasu, wéiyaaña ñǘbürigiña, masabadunga ani surusu, lau hede bóugudin, lun hanügün busiganu. <verse eid="ISA 20:4" /><verse number="5" style="v" sid="ISA 20:5" />Habuinchuba gürigia lau anufudei, nibusigari hagíame lau Etiopía le meha hemenigira, luma lau Ehiptu le meha hapantagüle. <verse eid="ISA 20:5" /><verse number="6" style="v" sid="ISA 20:6" />Lídanme dan ligía, hariñaguba sun ha aganóubaña lidan kosu ligía: “Ariha humá ka lan gádanbalin fulasu le meha wemenigira, le meha úmabei woudin amuriaha ídemuei, lun lesefuruniwa luéi lurúeite Asiria”. Ida lubati wesefurun guentó?<verse eid="ISA 20:6" /></para>
  <chapter eid="ISA 20" />
  <chapter number="21" style="c" sid="ISA 21" />
  <para style="s1">Dimurewa lan luagu lábürühan Babilónia</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 21:1" />Dimurei libügürü fulasu mageirawati:</para>
  <para style="q" vid="ISA 21:1">Kei herigini awanseruti luéigiñe suru,</para>
  <para style="q" vid="ISA 21:1">ítara liña liabin luéigiñe fulasu mageirawati,</para>
  <para style="q" vid="ISA 21:1">fulasu hanufunati.<verse eid="ISA 21:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 21:2" />Hanarimeti uénedü le larufudubei Wabungiute nun,</para>
  <para style="q" vid="ISA 21:2">lagünrinchaguña gagünrinchaguaditi.</para>
  <para style="q" vid="ISA 21:2">Saraba Elamü! Híweruha, Médiana!</para>
  <para style="q" vid="ISA 21:2">Mabusenrunhadina saragu ekeharuni.<verse eid="ISA 21:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 21:3" />Adadagarati núgubu, baruguatina lau igari kei würi águrahatu,</para>
  <para style="q" vid="ISA 21:3">mígirun lumutina íruni lun naganbun,</para>
  <para style="q" vid="ISA 21:3">mígirun lumutina anufudei lun narihin.<verse eid="ISA 21:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 21:4" />Anihein bulíeiguaü nichügüwagu,</para>
  <para style="q" vid="ISA 21:4">adadagaratina lau anufudei.</para>
  <para style="q" vid="ISA 21:4">Lidili rábounweyu le hínsiñeñahabei nun,</para>
  <para style="q" vid="ISA 21:4">ítara liña nun guentó kei aban katei hanarimeti.<verse eid="ISA 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 21:5" />Seriwiwaali éigini,</para>
  <para style="q" vid="ISA 21:5">tulewaaru seriweidu,</para>
  <para style="q" vid="ISA 21:5">gumeseeli adineruni.</para>
  <para style="q" vid="ISA 21:5">Rárama humá hábutigu súdaragu,</para>
  <para style="q" vid="ISA 21:5">mirigüda huméi hadaüdina lauti gürabu!<verse eid="ISA 21:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 21:6" />Ladüga ariñagaali Wabureme nun:</para>
  <para style="q" vid="ISA 21:6">«Beiba, bíchigame aban óunigiruti</para>
  <para style="q" vid="ISA 21:6">le lunti lawisahan luagu sun le lunbei larihini.<verse eid="ISA 21:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 21:7" />Anhein ariha karü to hachawahan aban feru gabayu,</para>
  <para style="q" vid="ISA 21:7">o gürigia wariñu hawagu mile o kameyu,</para>
  <para style="q" vid="ISA 21:7">ariagualáña buidu».<verse eid="ISA 21:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 21:8" />Aba lagúaragun le óunigirubei, lariñaga:</para>
  <para style="q" vid="ISA 21:8">«Nabureme, lídanñadina nubara sun weyu,</para>
  <para style="q" vid="ISA 21:8">nóunigiruña sagü áriebu.<verse eid="ISA 21:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 21:9" />Anutén aban karü achawaheina hamoun aban feru gabayu».</para>
  <para style="q" vid="ISA 21:9">Ábati lariñagun aban: «Ábürüha Babilónia!</para>
  <para style="q" vid="ISA 21:9">Sun hayawa lubungiutegu,</para>
  <para style="q" vid="ISA 21:9">heigua múarugun, günringua».<verse eid="ISA 21:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 21:10" />Dügüwaguatiña nánigu kei türigu,</para>
  <para style="q" vid="ISA 21:10">nariñaguñein le naganbubei lúmagiñe Wabungiute</para>
  <para style="q" vid="ISA 21:10">Suntigabafu le Lubungiute Ísüraeli bun.<verse eid="ISA 21:10" /></para>
  <para style="s1">Dimurewa lan luagu Edomu</para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 21:11" />Dimurei libügürü Edomu:</para>
  <para style="q" vid="ISA 21:11">Wáwaguati nun uburugugiñe Seirü:</para>
  <para style="q" vid="ISA 21:11">«Óunigiruti, Ka san oura guentó?»<verse eid="ISA 21:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 21:12" />Lóunaba óunigiruti, lariñaga:</para>
  <para style="q" vid="ISA 21:12">«Aniteeli larugan, gama lumoun aniteyaali giñe laguñeedun.</para>
  <para style="q" vid="ISA 21:12">Anhein busén hubéi hálügüdahan,</para>
  <para style="q" vid="ISA 21:12">hálügüdaha, ábayame hagiribudun álügüdaha».<verse eid="ISA 21:12" /></para>
  <para style="s1">Dimurewa lan luagu Arawia</para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 21:13" />Dimurei lidan fulasu mageirawati:</para>
  <para style="q" vid="ISA 21:13">Ñǘbuintiña gürigia eibu Dedangiñe áriebu,</para>
  <para style="q" vid="ISA 21:13">ha ásügürüti áriebu lidan híduru-agei lidan fulasu mageirawati,<verse eid="ISA 21:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 21:14" />furí humá lubaroun le mágürabubei, ru humá duna lun.</para>
  <para style="q" vid="ISA 21:14">Lílana Temá, furí humá lubaroun le anurahabei,</para>
  <para style="q" vid="ISA 21:14">ru humá éigini luma duna lun:<verse eid="ISA 21:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 21:15" />Ladüga hanurahaña tuéi eféin hamanatu,</para>
  <para style="q" vid="ISA 21:15">tuéi gimara to aranseñutu lun tachüürǘn</para>
  <para style="q" vid="ISA 21:15">luma luéi ligañi wuribu.<verse eid="ISA 21:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="ISA 21:16" />Lariñahare Wabureme nun:</para>
  <para style="q" vid="ISA 21:16">«Aban irumu lárigiñe le kei</para>
  <para style="q" vid="ISA 21:16">labahüdüni nadagimeinti le awinwandubei lídangiñe lafayeiruaha,</para>
  <para style="q" vid="ISA 21:16">gumuhalime luéirigun Kedarü.<verse eid="ISA 21:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 21:17" />Míbeboun gimara erederutu hama wuriburuguna ha lani Kedarü».</para>
  <para style="q" vid="ISA 21:17">Wabureme le Lubungiute Ísüraeli ariñagubalin.<verse eid="ISA 21:17" /></para>
  <chapter eid="ISA 21" />
  <chapter number="22" style="c" sid="ISA 22" />
  <para style="s1">Dimurewa lan libügürü Herusalén</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 22:1" />Dimurei libügürü fulasu wayati le lani uénedü:</para>
  <para style="q" vid="ISA 22:1">Ka suserebei hawarirunbei súngubei tábulugun muna?<verse eid="ISA 22:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 22:2" />Uburugu buinti lau chagaguaü luma anarimeni,</para>
  <para style="q" vid="ISA 22:2">uburugu lumada efeduhani,</para>
  <para style="q" vid="ISA 22:2">mama táfaragun eféin bánigu,</para>
  <para style="q" vid="ISA 22:2">mama wuriburugu hóunwegua;<verse eid="ISA 22:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 22:3" />éibaaguatiña bábutigu anuraheina,</para>
  <para style="q" vid="ISA 22:3">lidan hanurahan tuéi gimara ligía hadaürüniña.</para>
  <para style="q" vid="ISA 22:3">Buwügüriñanigu ha ganigitimabaña,</para>
  <para style="q" vid="ISA 22:3">éibaaguatiña anuraheina dise,</para>
  <para style="q" vid="ISA 22:3">gama lumoun dáüwatiña.<verse eid="ISA 22:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 22:4" />Ligía nariñagunbei:</para>
  <para style="q" vid="ISA 22:4">«Dise humá nuéi, busentina nayahun lau igarigu;</para>
  <para style="q" vid="ISA 22:4">máluaha humá hámalihanina luagu halamiserun nánigu».<verse eid="ISA 22:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 22:5" />Ladüga arufudaali Wabureme Suntigabafu</para>
  <para style="q" vid="ISA 22:5">aban weyu le luéyuri anufudei,</para>
  <para style="q" vid="ISA 22:5">günringuaü luma chagaguaü lidan fulasu wayati le lani uénedü.</para>
  <para style="q" vid="ISA 22:5">Lábürühaña burí barieiru;</para>
  <para style="q" vid="ISA 22:5">aganbúati agúarahani chülǘ luagun burí wübü.<verse eid="ISA 22:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 22:6" />Aranse hamaaru Elamüna hagimaran,</para>
  <para style="q" vid="ISA 22:6">wariñuhaña tidan burí hakarün luma hawagu hagabayun;</para>
  <para style="q" vid="ISA 22:6">sagá hamutu lílana Kirü hadaüdina lauti gürabu.<verse eid="ISA 22:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 22:7" />Buin liña burí lubuidun-agei fulasu wayati tau karü,</para>
  <para style="q" vid="ISA 22:7">añahein ha hawagubaña gabayu luagu lubenari uburugu.<verse eid="ISA 22:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="ISA 22:8" />Úati buga kaba lan au lageindagua Hudá luougua.</para>
  <para style="p" vid="ISA 22:8">Lidan weyu ligía, ariha humutu tagei áruma to tídanboun muna to dabíararuguboun, <verse eid="ISA 22:8" /><verse number="9" style="v" sid="ISA 22:9" />ariha humuti burí gubaguati le luágubei luburugute Dawidi aba habuinchagüdüni lagei duna le ǘnabubei; <verse eid="ISA 22:9" /><verse number="10" style="v" sid="ISA 22:10" />aba haríaahanu muna burí to Herusalénboun, aba hágurun fiu tídangiñe lun haransehani baríeiru. <verse eid="ISA 22:10" /><verse number="11" style="v" sid="ISA 22:11" />Aba hachigin aban fusu labadinagua bián baríeiru lun lésehan duna le lídanbei binadu lagei duna. Gama lumoun metenitün lun le adügübalin sun le, le aranserubalin lúmagiñe binarü.<verse eid="ISA 22:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 22:12" />Weyu ligía, amisuraha lumutün Wabureme</para>
  <para style="q" vid="ISA 22:12">Suntigabafu lun hayahun, lun hasakürihan lun hásaruni hádiburi,</para>
  <para style="q" vid="ISA 22:12">luma lun hadaürün daüguaü súsutu liseinime igarigu.<verse eid="ISA 22:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 22:13" />Gama lumoun le hadügübei, hefeduhaña,</para>
  <para style="q" vid="ISA 22:13">áfaraha bágasu hama mudún, eiga luma ata diwéin.</para>
  <para style="q" vid="ISA 22:13">Hariñaga: «Weiga, wata, ladüga haruga wóunwegun».<verse eid="ISA 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 22:14" />Aba lasaliragun Wabureme Suntigabafu nun,</para>
  <para style="q" vid="ISA 22:14">aba lariñagun narigeirugun:</para>
  <para style="q" vid="ISA 22:14">«Úabei ferudunanani figóu le hun;</para>
  <para style="q" vid="ISA 22:14">lubaragiñe lira, hóunweguba.</para>
  <para style="q" vid="ISA 22:14">Wabureme Suntigabafu ariñagubalin».<verse eid="ISA 22:14" /></para>
  <para style="s1">Dimurei libügürü Sebüná</para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 22:15" />Lariñahare Wabureme Suntigabafu nun:</para>
  <para style="p" vid="ISA 22:15">—Beiba arihei Sebüná le ábuti lúbiñe urúei, bariñagame lun:<verse eid="ISA 22:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="ISA 22:16" />“Ka san bumegenbei ya, ka íchugubei irichaü bun</para>
  <para style="q" vid="ISA 22:16">lun badügün aban umúahaü, ya lidan liñun-agei fulasu</para>
  <para style="q" vid="ISA 22:16">luma lun bachigin aban bubara luagu dübü lun bemeraagun?<verse eid="ISA 22:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 22:17" />Lágurubadibu Wabureme diseun,</para>
  <para style="q" vid="ISA 22:17">kei ladügüni aban wügüri héreti.</para>
  <para style="q" vid="ISA 22:17">Lárügüdübadibu lau erei,<verse eid="ISA 22:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 22:18" />labalabaagüdübadibu kei aban bali,</para>
  <para style="q" vid="ISA 22:18">ábame láhuchurunibu lidoun aban fulasu le wéiriti.</para>
  <para style="q" vid="ISA 22:18">Bóunweba ñein tararamuba burí karü to meha bapantaagüle ñein,</para>
  <para style="q" vid="ISA 22:18">buguyaba tibusigari luban biyubudiri.<verse eid="ISA 22:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 22:19" />Nagidarubadibu lídangiñe bubara,</para>
  <para style="q" vid="ISA 22:19">nagidarubei bifisiute buéi.<verse eid="ISA 22:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="ISA 22:20" />Lídanme weyu ligía,</para>
  <para style="q" vid="ISA 22:20">nagúaruba lun Eliakímü le liráü Ilükíasi;<verse eid="ISA 22:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 22:21" />nadaürüboun badaüragun luagu,</para>
  <para style="q" vid="ISA 22:21">níchugubei bubelitin le lánina binebese luagu,</para>
  <para style="q" vid="ISA 22:21">ábame níchuguni bubafu lun.</para>
  <para style="q" vid="ISA 22:21">Ítara luba kei aban úguchili houn lílana</para>
  <para style="q" vid="ISA 22:21">Herusalén luma houn lánigu Hudá.<verse eid="ISA 22:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 22:22" />Níchugubei tigelen luban Dawidi légewagu;</para>
  <para style="q" vid="ISA 22:22">úabei ni aban gayaraati ladaaruni le ladourubei,</para>
  <para style="q" vid="ISA 22:22">úame adouruti le ladaarubei.<verse eid="ISA 22:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 22:23" />Ítara luba kei aban lala urúei</para>
  <para style="q" vid="ISA 22:23">le wéiriguti houn liduheñu lúguchi.</para>
  <para style="q" vid="ISA 22:23">Nadügüba lun lárügüdün buidu lidan</para>
  <para style="q" vid="ISA 22:23">lubara kei aban gürabu.<verse eid="ISA 22:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 22:24" />Gayaraabei ladahirún sun katei le gebegiti</para>
  <para style="q" vid="ISA 22:24">le hámabei liduheñu lúguchi</para>
  <para style="q" vid="ISA 22:24">hama sun ladügawagun luagu,</para>
  <para style="q" vid="ISA 22:24">sun luwuyeri lirahüñü asiedu,</para>
  <para style="q" vid="ISA 22:24">lúmagiñe kopu dagá lumoun fudu.<verse eid="ISA 22:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 22:25" />Lídanme weyu ligía,</para>
  <para style="q" vid="ISA 22:25">lahulúba gürabu le buga derebugubei lidan lubara;</para>
  <para style="q" vid="ISA 22:25">lahulúba ábame léiguadun,</para>
  <para style="q" vid="ISA 22:25">ábame labouchagun sun burí katei le buga dibiñubei luagu”.</para>
  <para style="q" vid="ISA 22:25">Wabureme Suntigabafu ariñagubalin.<verse eid="ISA 22:25" /></para>
  <chapter eid="ISA 22" />
  <chapter number="23" style="c" sid="ISA 23" />
  <para style="s1">Dimurei libügürü Tiru luma Sidón</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 23:1" />Ladimurehoun luagu Tiru:</para>
  <para style="q" vid="ISA 23:1">Tayahuña burí ugunei to lani Tárüsisi,</para>
  <para style="q" vid="ISA 23:1">ladüga günrinwagua wafu.</para>
  <para style="q" vid="ISA 23:1">Gudawa wafu le meha ñeinhin lubéi lachülürǘwa Chípüregiñe<verse eid="ISA 23:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 23:2" />Rédeiha lílana Tiru hama adaagutiña</para>
  <para style="q" vid="ISA 23:2">marasun ha Sidonna maniñu.</para>
  <para style="q" vid="ISA 23:2">Hiñugua hamuti burí meha hóunagülegu barana,<verse eid="ISA 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 23:3" />luma burí óunwenbu duna,</para>
  <para style="q" vid="ISA 23:3">sagá hamuti meha hagañeirun</para>
  <para style="q" vid="ISA 23:3">lídangiñe alubahóuti lidan Nilu,</para>
  <para style="q" vid="ISA 23:3">aba halugurahani houn néchanigu.<verse eid="ISA 23:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 23:4" />Buinba lau busiganu, Sidón,</para>
  <para style="q" vid="ISA 23:4">lau sun Tiru, iderebugu le lárubei barana</para>
  <para style="q" vid="ISA 23:4">ladüga ariñagaali barana:</para>
  <para style="q" vid="ISA 23:4">«Masandiñahagidina ligari agaraüdüni, mágurahanñaha au.</para>
  <para style="q" vid="ISA 23:4">Marahüñüñahagidina lun nagüriahaniña ni lun narufudahan houn».<verse eid="ISA 23:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 23:5" />Danme lachülürün uganu houn Ehiptuna,</para>
  <para style="q" vid="ISA 23:5">hírudaguba luagu le asuseredubei lun Tiru.<verse eid="ISA 23:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 23:6" />Hariñagame: «Heiba uburugun Tárüsisi,</para>
  <para style="q" vid="ISA 23:6">hayahuaha lílana burí kosu».<verse eid="ISA 23:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 23:7" />Anihán san uburugu le binadubei, le ñéinñaha lubéi fedu?</para>
  <para style="q" vid="ISA 23:7">Le adügañahabei wéiyaasu lun lidoun burí fulasu díseti?<verse eid="ISA 23:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 23:8" />Aban meha uburugu wéiriguti Tiru</para>
  <para style="q" vid="ISA 23:8">ítarahaña meha ha adaagubaña marasun ñein</para>
  <para style="q" vid="ISA 23:8">kei harahüñü urúeigu</para>
  <para style="q" vid="ISA 23:8">inebewatiña meha ha alugurahabaña ñein lidan sun ubóu.</para>
  <para style="q" vid="ISA 23:8">Ka adügübalin le lun Tiru?<verse eid="ISA 23:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 23:9" />Wabureme Suntigabafu adügübalin</para>
  <para style="q" vid="ISA 23:9">lun lǘnabudaguagüdüni pantaü,</para>
  <para style="q" vid="ISA 23:9">luma lun lígiruniña sun ha gabafubaña ubouagu múarugu.<verse eid="ISA 23:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 23:10" />Lílana Tárüsisi, bunagua huméi múa,</para>
  <para style="q" vid="ISA 23:10">lugundun úaali fulasu le ñéinñaha</para>
  <para style="q" vid="ISA 23:10">lubéi tadaawagúa ugunei, gumugua.<verse eid="ISA 23:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 23:11" />Tulé lumuti Wabureme lúhabu luagun barana,</para>
  <para style="q" vid="ISA 23:11">aba ladadagaragüdüniña néchanigu,</para>
  <para style="q" vid="ISA 23:11">óunaha ligía agünrinchaguei lubarieirun Kanán.<verse eid="ISA 23:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 23:12" />Aba lariñagun lun Sidón:</para>
  <para style="q" vid="ISA 23:12">«Hebé bíchaagun bungua lun ugundani,</para>
  <para style="q" vid="ISA 23:12">nibureingiru fuíwaguaaru.</para>
  <para style="q" vid="ISA 23:12">Íbini bidin uburugun Chípüre,</para>
  <para style="q" vid="ISA 23:12">ni ñein madaribadibu emeraaguni».<verse eid="ISA 23:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ISA 23:13" />Ariha huméi fulasu le,</para>
  <para style="q" vid="ISA 23:13">fulasu meha ichugúti tun ugunei.</para>
  <para style="q" vid="ISA 23:13">Bunaguatiña Babilóniana wáyelesi ñein,</para>
  <para style="q" vid="ISA 23:13">günringua hamóun lani Sidón palasiu,</para>
  <para style="q" vid="ISA 23:13">aba hígiruni lidan günringuaü.</para>
  <para style="q" vid="ISA 23:13">Hagía adügübalin lira, mama Asiriana.<verse eid="ISA 23:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 23:14" />Hayahuaha, ugunei Tárüsisina,</para>
  <para style="q" vid="ISA 23:14">ladüga günrinwagua uburugu Tiru.<verse eid="ISA 23:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="ISA 23:15" />Lídanme dan ligía, labulieidúaba Tiru luagu ǘrüwa-wein-diisi irumu, dan le ladurarun libagari aban urúei. Lárigiñeme ǘrüwa-wein-diisi irumu ligía, ábame leremuhóun uremu ligira le tuáguti horu lun Tiru:<verse eid="ISA 23:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="ISA 23:16" />«Horu bulíeiwaaru,</para>
  <para style="q" vid="ISA 23:16">ragüboun bani árüpa,</para>
  <para style="q" vid="ISA 23:16">éibugabei uburugu, báfara úyanu buiti,</para>
  <para style="q" vid="ISA 23:16">beremuha saragu uremu,</para>
  <para style="q" vid="ISA 23:16">ariha báamuga ánhaña aritagua buagun».<verse eid="ISA 23:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="ISA 23:17" />Lárigiñeme ǘrüwa-wein-diisi irumu, lárügüdayabei Wabureme Tiru. Taluguraguayaba tungua, ábayame tahoruhan luma sun fulasu le ubouagubei. <verse eid="ISA 23:17" /><verse number="18" style="v" sid="ISA 23:18" />Gama lumoun tederegerubei le tagañeirubei lun Wabureme; mareidúnwabei, rúarügübei houn ha eseriwidubaña lun Wabureme lun hagañeihan saragu éigini tuma daüguaü fínutu.<verse eid="ISA 23:18" /></para>
  <chapter eid="ISA 23" />
  <chapter number="24" style="c" sid="ISA 24" />
  <para style="s1">Laguseragüdüniwa sun ubóu</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 24:1" />Lagünrinchagubei Wabureme ubóu,</para>
  <para style="q" vid="ISA 24:1">lamaladagüdübei, chagaguagüdaláñame lílana.<verse eid="ISA 24:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 24:2" />Ábanmemebei lun fádiri kei houn lílana fulasu,</para>
  <para style="q" vid="ISA 24:2">lun iyubudiri kei lun idamuni,</para>
  <para style="q" vid="ISA 24:2">tun iyubudiri kei tun idamuni,</para>
  <para style="q" vid="ISA 24:2">lun le agañeihabei kei lun le alugurahabei,</para>
  <para style="q" vid="ISA 24:2">lun le íchugubei furedeiti kei lun le ibihubei furedeiti</para>
  <para style="q" vid="ISA 24:2">lun le adúeihabei kei lun le adueirúabei.<verse eid="ISA 24:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 24:3" />Lagünrinchawaguba ubóu sunsuinagubei,</para>
  <para style="q" vid="ISA 24:3">lasagarahóuba sunsuinagubei.</para>
  <para style="q" vid="ISA 24:3">Lugundun ligía lariñagubei Wabureme.<verse eid="ISA 24:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 24:4" />Mábeiti múa aba lásaürün,</para>
  <para style="q" vid="ISA 24:4">mábeiti sun ubóu aba lásaürün,</para>
  <para style="q" vid="ISA 24:4">aba lírudagun sielu luma múa.<verse eid="ISA 24:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 24:5" />Rúhaña lílana fulasu minebeni lun hageira,</para>
  <para style="q" vid="ISA 24:5">lugundun máhaaña hagunfulirun lau lúrudu,</para>
  <para style="q" vid="ISA 24:5">rúhaña mebereseni lau gumadi,</para>
  <para style="q" vid="ISA 24:5">magunfulirun hagía lau nidaradun.<verse eid="ISA 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 24:6" />Ligía lagumuchunbei aban íñarawaguni lau fulasu,</para>
  <para style="q" vid="ISA 24:6">ábati hasufuriruni lílana abeichúni ligía.</para>
  <para style="q" vid="ISA 24:6">Ligía míbeeña lubéi, ani fiúrügaaña gürigia erederutiña.<verse eid="ISA 24:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 24:7" />Késiharu diwéin, sándiharu beibei-agei,</para>
  <para style="q" vid="ISA 24:7">ha meha gúndaabaña buin haña lau íruni.<verse eid="ISA 24:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 24:8" />Gumugua ugundani lau garanwoun tuma árüpa,</para>
  <para style="q" vid="ISA 24:8">maniha ha meha efeduhabaña eremuha hagía.<verse eid="ISA 24:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 24:9" />Matunwaarume diwéin lidan leremuhóun uremu;</para>
  <para style="q" vid="ISA 24:9">lagifiduba uniñein houn gátaatiña.<verse eid="ISA 24:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 24:10" />Gumugua uburugu le meha lagei chagaguaü,</para>
  <para style="q" vid="ISA 24:10">siñá lebelurún tidoun ni aban muna.<verse eid="ISA 24:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 24:11" />Ayahuahatiña gürigia ǘmada luagu tikesin diwéin;</para>
  <para style="q" vid="ISA 24:11">gumugua sun ugundani úaali ugundani ubouagu.<verse eid="ISA 24:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 24:12" />Günringua uburugu, áhalaha lubenari.<verse eid="ISA 24:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 24:13" />Ítara luba lidan sun néchani le ubouagubei:</para>
  <para style="q" vid="ISA 24:13">Kei dan le tátühoun aseituna lau wewe</para>
  <para style="q" vid="ISA 24:13">o dan lan le táluahoun beibei lárigi alubahani.<verse eid="ISA 24:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 24:14" />Hame esefurutiña luéi óunweni,</para>
  <para style="q" vid="ISA 24:14">hagúaraguba buin lau ugundani,</para>
  <para style="q" vid="ISA 24:14">hiñurubei hamala luéigiñe oubaü le ñeinhin lubéi lálüda weyu</para>
  <para style="q" vid="ISA 24:14">danme harihini luéirigun Wabureme.<verse eid="ISA 24:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 24:15" />Híchuguba ha aganóubaña luéigiñe oubaü</para>
  <para style="q" vid="ISA 24:15">le ñéingiñe lubéi laboucha weyu uéiriguni lun.</para>
  <para style="q" vid="ISA 24:15">Híchuguba ha aganóubaña kósurugu</para>
  <para style="q" vid="ISA 24:15">uéiriguni lun Wabureme le Lubungiute Ísüraeli.<verse eid="ISA 24:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 24:16" />Aganba wamaali heremuhan lúmagiñe lébeha ubóu,</para>
  <para style="q" vid="ISA 24:16">hariñaga lidan heremuhan: «Uéiriguni lun le richabei!»</para>
  <para style="b" vid="ISA 24:16" />
  <para style="q" vid="ISA 24:16">Gama lumoun aba nariñagun: Fugiabu au, lanarime nilamiserun!</para>
  <para style="q" vid="ISA 24:16">Ha gagarabaaguadibaña, adügatiña aban lanarime agarabaaguni!<verse eid="ISA 24:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 24:17" />Ítara haba lílana ubóu kei animaalugu ha éibaahoutiña</para>
  <para style="q" vid="ISA 24:17">o kei lan animaalugu ha lídantiña denchaü</para>
  <para style="q" vid="ISA 24:17">lun hábürühan húyurugun o tidoun lan sádara.<verse eid="ISA 24:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 24:18" />Ha esefurutiña hawéi éibaahatiña, héiguaduba húyurugun,</para>
  <para style="q" vid="ISA 24:18">ha áfuridutiña húyurugugiñe hábürühaba tidoun sádara.</para>
  <para style="q" vid="ISA 24:18">Lábürühaba aban guran huya siélugiñe,</para>
  <para style="q" vid="ISA 24:18">ábame ladadagarun lebu ubóu.<verse eid="ISA 24:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 24:19" />Ladadagaruba múa lau anarimeni,</para>
  <para style="q" vid="ISA 24:19">lánhingichuba, lañaünrüdaguba.<verse eid="ISA 24:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 24:20" />Latuituihóuba kei aban bacharuati,</para>
  <para style="q" vid="ISA 24:20">lánhingichuba kei aban tagübüri muna to mederebuguntu.</para>
  <para style="q" vid="ISA 24:20">Lábürühaba ladüga lihürü lifigoun, másaarunhalime.<verse eid="ISA 24:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 24:21" />Lídanme weyu ligía,</para>
  <para style="q" vid="ISA 24:21">labeichubaña Wabureme ubafu burí ha siélubaña,</para>
  <para style="q" vid="ISA 24:21">hama urúeigu ha ubouagubaña;<verse eid="ISA 24:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 24:22" />lóundarubaña ábame ládaraguniña tidoun aban furisun,</para>
  <para style="q" vid="ISA 24:22">ábame lígiruniña ñein adaürǘwa,</para>
  <para style="q" vid="ISA 24:22">saragu dan lárigiñe ábame labeichuniña.<verse eid="ISA 24:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 24:23" />Danme luadigimaridun Wabureme Suntigabafu keisi urúei,</para>
  <para style="q" vid="ISA 24:23">luagu wübü Sión, luma Herusalén, láfuriduba weyu luma hati,</para>
  <para style="q" vid="ISA 24:23">ábame harihini lábutigu fulasu luéirigun Wabureme.<verse eid="ISA 24:23" /></para>
  <chapter eid="ISA 24" />
  <chapter number="25" style="c" sid="ISA 25" />
  <para style="s1">Leremuhóun uremu lun Wabungiute</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 25:1" />Nabureme, buguya Nubungiutebei;</para>
  <para style="q" vid="ISA 25:1">rútina uéiriguni bun ani alawaha numuti biri,</para>
  <para style="q" vid="ISA 25:1">lugundun adüga baali baritagun le úaraguabei,</para>
  <para style="q" vid="ISA 25:1">chouru ligía le baransehabei lúmagiñe binadu dan.<verse eid="ISA 25:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 25:2" />Günringua bumuti burí uburugu le baríeiruati;</para>
  <para style="q" vid="ISA 25:2">günringua bumutu hani áganiñu palasiu ani mararamundigiaaru.<verse eid="ISA 25:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 25:3" />Ligía híchugunbei lílana fulasu ha hérebaña uéiriguni bun,</para>
  <para style="q" vid="ISA 25:3">inebe buguya houn lílana burí uburugu ha gabafubaña.<verse eid="ISA 25:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 25:4" />Ladüga, laramudaguagüle gudemeti buguya,</para>
  <para style="q" vid="ISA 25:4">íderagua bumuti le mégeihabubei lidan lidiheri,</para>
  <para style="q" vid="ISA 25:4">aramudaguagülei buguya lidan luriban dan,</para>
  <para style="q" vid="ISA 25:4">lamuñounga lidan lárouga.</para>
  <para style="q" vid="ISA 25:4">Ítara liña here wügüriña hanarimetiña</para>
  <para style="q" vid="ISA 25:4">kei huya lauti garabali lidan luribouga,<verse eid="ISA 25:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 25:5" />odi kei lan lárouga lidan múa mábeiti.</para>
  <para style="q" vid="ISA 25:5">Redei bumuti hachagaragun áganiñu.</para>
  <para style="q" vid="ISA 25:5">Gáluma bumuti lárouga lau lamuñan dúeri.</para>
  <para style="q" vid="ISA 25:5">Fosu bumutiña wügüriña fásitiña lun hámanichun.<verse eid="ISA 25:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 25:6" />Laranseruba Wabureme Suntigabafu aban adineruni luagu wübü Sión</para>
  <para style="q" vid="ISA 25:6">houn sun néchanigu ubouagu,</para>
  <para style="q" vid="ISA 25:6">ñeinbei lubuidun-agei éigini semeeti tuma diwéin to fínutimatu.<verse eid="ISA 25:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 25:7" />Luagu wübü Sión, lagünrinchaguboun Wabureme belu</para>
  <para style="q" vid="ISA 25:7">to adouraguboun hau sun lílana fulasu,</para>
  <para style="q" vid="ISA 25:7">manda to adouraguañahaboun hau sun néchanigu.<verse eid="ISA 25:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 25:8" />Lagünrinchagubei Wabureme óunweni lun súnwandan,</para>
  <para style="q" vid="ISA 25:8">laragahabei águiraü luéigiñe hagu sun gürigia,</para>
  <para style="q" vid="ISA 25:8">ábame lagumuchaguagüdüni hǘnabun lánigu lidan sun ubóu.</para>
  <para style="q" vid="ISA 25:8">Wabureme ariñagubalin.<verse eid="ISA 25:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 25:9" />Lariñawagúba lidan weyu ligía:</para>
  <para style="q" vid="ISA 25:9">«Anihán Wabungiutebei,</para>
  <para style="q" vid="ISA 25:9">luagu wemenigida aba lesefuruniwa.</para>
  <para style="q" vid="ISA 25:9">Gunda wamá, íderagua láadiwa».<verse eid="ISA 25:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 25:10" />Lóunigirubei Wabureme wübü Sión,</para>
  <para style="q" vid="ISA 25:10">ánheinti Moabü, ladügüragubei</para>
  <para style="q" vid="ISA 25:10">kei ladügürawagun ifei hímerugu.<verse eid="ISA 25:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 25:11" />Látulerubei Moabü larüna kei ladüga áfulihati,</para>
  <para style="q" vid="ISA 25:11">gama lumoun ságüme látuleruni labuluchuntima lanaagun lungua.<verse eid="ISA 25:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 25:12" />Lábürügüdübei Wabureme liñún burí</para>
  <para style="q" vid="ISA 25:12">luma lere lubarieirun, lágurubei múarugun.<verse eid="ISA 25:12" /></para>
  <chapter eid="ISA 25" />
  <chapter number="26" style="c" sid="ISA 26" />
  <para style="s1">Uremu lánina agañeiruni</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 26:1" />Lídanme weyu ligía, leremuhóuba uremu le lumúanrugu Hudá:</para>
  <para style="b" vid="ISA 26:1" />
  <para style="q" vid="ISA 26:1">«Anihein aban uburugu héreti wama lun wesefurun,</para>
  <para style="q" vid="ISA 26:1">bunaguati Wabureme baríeiru derebuguti.<verse eid="ISA 26:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 26:2" />Dará huméi bena, belú hamaamuga gürigia richaguatiña,</para>
  <para style="q" vid="ISA 26:2">gürigia gúnfulitiña lau inarüni.<verse eid="ISA 26:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 26:3" />Rútibu darangilaü houn ha deregüdaguabaña lidan hafiñen buagu</para>
  <para style="q" vid="ISA 26:3">ladüga hemenigitiña buagu.<verse eid="ISA 26:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 26:4" />Hemenigi humá luagu Wabureme súnwandan,</para>
  <para style="q" vid="ISA 26:4">ladüga aramudaguagülei magumuchaditi ligía.<verse eid="ISA 26:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 26:5" />Ábürügüda lumutiña pántatiña, ǘnabugüdalaña lílana</para>
  <para style="q" vid="ISA 26:5">uburugu ha barügua tungua, fui lumutiña múarugun,<verse eid="ISA 26:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 26:6" />lun hadügüraguniña ha ǘnabugubaña hama ha gudemebaña».<verse eid="ISA 26:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 26:7" />Suruti hémeri ha richaguabaña;</para>
  <para style="q" vid="ISA 26:7">adügati Wabureme lun úaragua lan hémeri.<verse eid="ISA 26:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 26:8" />Chóuruguatiwa giñe woungua lidan üma le</para>
  <para style="q" vid="ISA 26:8">larufudubei bilurudun, Wabureme.</para>
  <para style="q" vid="ISA 26:8">Tayumahan wanigi lun wasaminaruba lan buagun.<verse eid="ISA 26:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 26:9" />Álugatina buagu áriebu tau sun nanigi;</para>
  <para style="q" vid="ISA 26:9">áluaha numutibu lau sun ninarün.</para>
  <para style="q" vid="ISA 26:9">Danme baguseragüdüniña lílana ubóu,</para>
  <para style="q" vid="ISA 26:9">hafurendeirubei gürigia irichaü.<verse eid="ISA 26:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 26:10" />Íbini gudemehabu ban houn wuribatiña;</para>
  <para style="q" vid="ISA 26:10">hasigiruba adügei le wuribabei, mafurendeirun habéi le buídubei,</para>
  <para style="q" vid="ISA 26:10">wuribati hóuserun lidan hageira gürigia buítiña,</para>
  <para style="q" vid="ISA 26:10">ani meberesegúntiña lau luéirigun Wabureme.<verse eid="ISA 26:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 26:11" />Wabureme, aransedibu lun babeichuniña</para>
  <para style="q" vid="ISA 26:11">gama lumoun mabusenrúntiña hasubudiruni;</para>
  <para style="q" vid="ISA 26:11">danme harihini lueirin bínsiñehabu houn bánigu, herederuba wuriba.</para>
  <para style="q" vid="ISA 26:11">Lagumuchaguagüdaña hamuga lanarime bigañi!<verse eid="ISA 26:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 26:12" />Wabureme, rútibu darangilaü woun; lidan linarün katei,</para>
  <para style="q" vid="ISA 26:12">buguya adügübalin sun wawadigimari.<verse eid="ISA 26:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 26:13" />Wabureme, Wabungiute,</para>
  <para style="q" vid="ISA 26:13">ámuhaña gürigia waburiña,</para>
  <para style="q" vid="ISA 26:13">gama lumoun buguyarügüñein Wabungiute.<verse eid="ISA 26:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 26:14" />Hagía hilagua, mabagaridunhaña, iyawadirügüñanu másaarunhaña;</para>
  <para style="q" vid="ISA 26:14">bei baaña, günringua baaña, gumuhadibu lau laritawagún hawagun.<verse eid="ISA 26:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 26:15" />Gíbeguagüda bumutiña gürigia,</para>
  <para style="q" vid="ISA 26:15">gíbeguagüda bumutiña lun buéirigun,</para>
  <para style="q" vid="ISA 26:15">chawagua bumuti sun láfadaragun ageiraü.<verse eid="ISA 26:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 26:16" />Áluaha wamutibu lidan wadiheri</para>
  <para style="q" vid="ISA 26:16">dan le bererehan woun lau ábanrügü agülülühani.<verse eid="ISA 26:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 26:17" />Bigibugiñeñadiwa bugaha kei aban würi dan yarafaali dan lun tágurahan,</para>
  <para style="q" vid="ISA 26:17">aba taguribihan agúaraha tuguya lau igari.<verse eid="ISA 26:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 26:18" />Dageinatiwa, sandí wamuti ligari agaraüdüni,</para>
  <para style="q" vid="ISA 26:18">águrahatiwa, gama lumoun garabalirügüñein wáguraha,</para>
  <para style="q" vid="ISA 26:18">manügüntiwa esefuruni lun fulasu,</para>
  <para style="q" vid="ISA 26:18">ani mágurahounbaña gürigia lun haganóun ubouagu.<verse eid="ISA 26:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 26:19" />Gama lumoun ha óunwegubaña afiñeñu buagu,</para>
  <para style="q" vid="ISA 26:19">habagaridayaba, hásaaruba lídangiñe óunweni</para>
  <para style="q" vid="ISA 26:19">ábame hagúarahan lau ugundani,</para>
  <para style="q" vid="ISA 26:19">lugundun óunaha bumuti larugounga kei serenu</para>
  <para style="q" vid="ISA 26:19">ábayame hachülaagun hilaaña lídangiñe umúahaü.<verse eid="ISA 26:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="ISA 26:20" />Heiba, nánigu, belú humá húbiñoun hadouragueime bena haugua.</para>
  <para style="q" vid="ISA 26:20">Aramudagua humá luagu murusun dan,</para>
  <para style="q" vid="ISA 26:20">darí lásügürün ligañi Wabureme.<verse eid="ISA 26:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 26:21" />Lugundun láfuriduba Wabureme tídangiñe lani palasiu</para>
  <para style="q" vid="ISA 26:21">lun labeichuniña lílana ubóu luagu hafigoun,</para>
  <para style="q" vid="ISA 26:21">maramudun láañame múa ha áfarawagubaña,</para>
  <para style="q" vid="ISA 26:21">arufudarügü lubéi áfarahani le adaawagúbei lidan.<verse eid="ISA 26:21" /></para>
  <chapter eid="ISA 26" />
  <chapter number="27" style="c" sid="ISA 27" />
  <para style="s1">Lesefurun Ísüraeli</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 27:1" />Lídanme weyu ligía,</para>
  <para style="q" vid="ISA 27:1">labeichubei Wabureme Lewiatán le mónsturu baranahana,</para>
  <para style="q" vid="ISA 27:1">hewe le adugulehabei ani gougua ligía,</para>
  <para style="q" vid="ISA 27:1">láfarubei Wabureme düragón le aganóubei baranaha</para>
  <para style="q" vid="ISA 27:1">tau lefeinte to hanarimeboun, to wéiriboun to gabafuboun.<verse eid="ISA 27:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ISA 27:2" />Lariñaguba Wabureme lidan weyu ligía:</para>
  <para style="q" vid="ISA 27:2">«Heremuha tun beibei-agei to semeeboun.<verse eid="ISA 27:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 27:3" />Au le Aburemei, au óunigirubarun, súnwandan náturagunu.</para>
  <para style="q" vid="ISA 27:3">Góunigi numutu áriebu wéyuagu lun masuseredun lan ni kata tun.<verse eid="ISA 27:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 27:4" />Magañiduntina tuma, lun hamuga anihein lan hiiyu luma híduru tuagu,</para>
  <para style="q" vid="ISA 27:4">náhulahañein hamuga aba hamuga náguduni sunsuinagubei.<verse eid="ISA 27:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 27:5" />Anhein busén tubéi nóunigirunu, arandaratá numa, anha, arandaratá numa».<verse eid="ISA 27:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 27:6" />Anitebei dan lun láhüchagun lílagüle Hakobu,</para>
  <para style="q" vid="ISA 27:6">láhüchaguba Ísüraeli ábame legelewehan,</para>
  <para style="q" vid="ISA 27:6">ábame labuinchagüdüni ubóu lau lin.<verse eid="ISA 27:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 27:7" />Mabeichun lumutiña Wabungiute Ísüraelina</para>
  <para style="q" vid="ISA 27:7">kei labeichuniña ha íchugubaña lidere dan houn,</para>
  <para style="q" vid="ISA 27:7">máfarunlaña hilagubei kei láfaraguniña ha áfarubaliña.<verse eid="ISA 27:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 27:8" />Bei lumutiña Wabureme lánigu lau lasagaragüdüniña</para>
  <para style="q" vid="ISA 27:8">hageiragiñe lun lidoun amu fulasu,</para>
  <para style="q" vid="ISA 27:8">bugá lumutiña lau lanarime láfurun</para>
  <para style="q" vid="ISA 27:8">kei dan le láfurun garabali luéigiñe oubaü le ñéingiñe lubéi laboucha weyu.<verse eid="ISA 27:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 27:9" />Gama lumoun feruduna lubéi lifigoun Hakobu</para>
  <para style="q" vid="ISA 27:9">anhein lagünrinchagua Ísüraeli sun burí lani latarü le wíyeti hama burí lisandun</para>
  <para style="q" vid="ISA 27:9">luma burí latarü le ñein lubéi lágudaha kupali houn lubungiutegu.<verse eid="ISA 27:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 27:10" />Günringua uburugu derebuguti,</para>
  <para style="q" vid="ISA 27:10">rédeiha kei muna igirúaaru,</para>
  <para style="q" vid="ISA 27:10">kei fulasu le ñein lumuti ua hamá gürigia.</para>
  <para style="q" vid="ISA 27:10">Ábanhali fulasu le ñein lumuti heredera bágasu</para>
  <para style="q" vid="ISA 27:10">le ñein lumuti heiga aba harounrun emeraagua.<verse eid="ISA 27:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 27:11" />Halaguati lilimun tídibu wewe dan le lásaürün;</para>
  <para style="q" vid="ISA 27:11">ábati habudahani würiña hálememe.</para>
  <para style="q" vid="ISA 27:11">Gürigia hürü tichügü hagía.</para>
  <para style="q" vid="ISA 27:11">Ligía magudemehabubei lubéi Wabureme le adügübaliña houn.<verse eid="ISA 27:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 27:12" />Lídanme weyu ligía,</para>
  <para style="q" vid="ISA 27:12">luadigimariduba Wabureme lúmagiñe Éufüratesigiñe darí duna Ehiptu</para>
  <para style="q" vid="ISA 27:12">kei léferehoun lin nadü; ánheinti huguya Ísüraelina, habudahóuba aban aban.<verse eid="ISA 27:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 27:13" />Lídanme weyu ligía,</para>
  <para style="q" vid="ISA 27:13">tínwinruba fidu to wéiriboun,</para>
  <para style="q" vid="ISA 27:13">hámeti féridiñubaña Asiria</para>
  <para style="q" vid="ISA 27:13">hama ha buga anügǘbaña Ehiptun,</para>
  <para style="q" vid="ISA 27:13">hayabinba áhuduragua lun Wabureme Herusalén luagu wübü le sándubei.<verse eid="ISA 27:13" /></para>
  <chapter eid="ISA 27" />
  <chapter number="28" style="c" sid="ISA 28" />
  <para style="s1">Leweridirúniwa Samaria</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 28:1" />Fugiabu Samaria le lapantaagüle luma liridin Éfürain,</para>
  <para style="q" vid="ISA 28:1">gürigia bacharuatiña; wendei lauti fuluri sáühali</para>
  <para style="q" vid="ISA 28:1">uburugu le arihúbei lóugiñe fulasu buíduburiti,</para>
  <para style="q" vid="ISA 28:1">haburugute gürigia ha tagumadirun diwéin!<verse eid="ISA 28:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 28:2" />Areidañu liña Wabureme aban wügüri héreti,</para>
  <para style="q" vid="ISA 28:2">gabafuti kei lábürühan lúbara huya dereguati,</para>
  <para style="q" vid="ISA 28:2">kei garabali héreti le gagünrinchaguaditi,</para>
  <para style="q" vid="ISA 28:2">kei huya gárati, kei labuinchun fulasu.</para>
  <para style="q" vid="ISA 28:2">Lachagahaba múarugun lau lúhabu,<verse eid="ISA 28:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 28:3" />buregualéime hapantagüle luma haridin</para>
  <para style="q" vid="ISA 28:3">lílana Éfürain ha gátadibaña.<verse eid="ISA 28:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 28:4" />Wendei wéiriguti le lauti fuluri sáühali le,</para>
  <para style="q" vid="ISA 28:4">le arihubei lóugiñe fulasu wayati le hilumati,</para>
  <para style="q" vid="ISA 28:4">ítara luba kei furumiñetu igu lidan tidaani,</para>
  <para style="q" vid="ISA 28:4">dan le larihinu gürigia, aba lárügüdünu lun léiginu.<verse eid="ISA 28:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 28:5" />Ábanbei ridi wéiriguti Wabureme Suntigabafu lidan weyu ligía,</para>
  <para style="q" vid="ISA 28:5">aban wendei magadiñeti houn ha erederutiña hádangiñe lánigu,<verse eid="ISA 28:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 28:6" />ani líchuguba irichaü houn aguseragüdütiña tidan luban aguseruni,</para>
  <para style="q" vid="ISA 28:6">luma anigi houn ha óunigirubalin uburugu.<verse eid="ISA 28:6" /></para>
  <para style="s1">Eweridiruni luma füramasei lun Herusalén</para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 28:7" />Añahein giñe amu atuituihatiña lárigiñe hatun diwéin,</para>
  <para style="q" vid="ISA 28:7">tuitui hagía lárigiñe hatun uniñein héreti:</para>
  <para style="q" vid="ISA 28:7">Ítara kei fádirigu hama profetagu atuituihaaña lárigiñe hatun saragu diwéin.</para>
  <para style="q" vid="ISA 28:7">Huchú lumutiña diwéin múarugun, ibidiñeguagüdalaña houngua.</para>
  <para style="q" vid="ISA 28:7">Marihingüdaláña buidu, gibe ligía hasaminan dan hasiadihan.<verse eid="ISA 28:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 28:8" />Buin liña sun dábula lau lihahürüha ewerehani,</para>
  <para style="q" vid="ISA 28:8">úati ni murusun fulasu harumati ñein.<verse eid="ISA 28:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 28:9" />Adimurehatiña nuagu, hariñaga:</para>
  <para style="q" vid="ISA 28:9">«Liabin íchiga arufudahani woun,</para>
  <para style="q" vid="ISA 28:9">arufudahei le lasubudirágüdübei Wabungiute woun!</para>
  <para style="q" vid="ISA 28:9">Kamá hamuga irahüñü ñǘbürigiña wagía<verse eid="ISA 28:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 28:10" />ha agumeserutiña afurendeira aliihani: ba be bi bo bu!»<verse eid="ISA 28:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ISA 28:11" />Ánhaña madügün gasu,</para>
  <para style="q" vid="ISA 28:11">lauba dimurei le úati gunfuranda humá,</para>
  <para style="q" vid="ISA 28:11">lau dimurei terenchati ladimureha Wabungiute houn gürigia ha.<verse eid="ISA 28:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 28:12" />Ariñagaali meha houn lubaramegiua:</para>
  <para style="q" vid="ISA 28:12">«Anihán gálumaü, anihán emeraaguni;</para>
  <para style="q" vid="ISA 28:12">emeraagualá le buchabei uagu».</para>
  <para style="q" vid="ISA 28:12">Gama lumoun máhatiña hadügün gasu lau.<verse eid="ISA 28:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 28:13" />Ligía ladimurehaba lubéi Bungiu houn</para>
  <para style="q" vid="ISA 28:13">kamá hamuga irahüñü ñǘbürigiña hagía ha afurendeirutiña aliihani.</para>
  <para style="q" vid="ISA 28:13">Lun danme lan héibugun ábame héiguadun hanagangiñoun,</para>
  <para style="q" vid="ISA 28:13">ábame habuleseirun, hábürühaba tidoun sádara ábame tárügüdüniña.<verse eid="ISA 28:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 28:14" />Aganba huméi lubeiti lererun Wabureme,</para>
  <para style="q" vid="ISA 28:14">huguya gürigia wuribatiña ha agumadihabaña Herusalén.<verse eid="ISA 28:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 28:15" />Huguya hariñahare:</para>
  <para style="q" vid="ISA 28:15">«Adügaadiwa aban daradu luma óunweni,</para>
  <para style="q" vid="ISA 28:15">lun danme lan liabin lanarime lamiselu, lun madaga lan wawagun;</para>
  <para style="q" vid="ISA 28:15">áluahaadiwa aramudaguni lidan iyeeni luma ounigirúni lidan eyeeraguni».<verse eid="ISA 28:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 28:16" />Ligía lariñagunbei Wabureme:</para>
  <para style="q" vid="ISA 28:16">«Níchiga aban dübü Sión,</para>
  <para style="q" vid="ISA 28:16">aban dübü anuadahóuti le gebegiti,</para>
  <para style="q" vid="ISA 28:16">ligíaba dübü wéirigutimati, ani ligíaba ebu.</para>
  <para style="q" vid="ISA 28:16">Le hemenigiti, gayaraabei darangilu lan.<verse eid="ISA 28:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 28:17" />Lidan bunaguaü ligía, irichaüba nayusura kei balu,</para>
  <para style="q" vid="ISA 28:17">ísuruni kei amisuraagülei».</para>
  <para style="b" vid="ISA 28:17" />
  <para style="q" vid="ISA 28:17">Aramudaguagülei le buga hálugubei lidan iyeeni,</para>
  <para style="q" vid="ISA 28:17">lagünrinchagubei lúbara huya dereguati,</para>
  <para style="q" vid="ISA 28:17">barüléime duna fulasu le ñein lubéi haramudagua.<verse eid="ISA 28:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 28:18" />Mebegibei daradu le buga hadügübei luma óunweni.</para>
  <para style="q" vid="ISA 28:18">Lagadeiruba hidaradun hama hilaguaaña.</para>
  <para style="q" vid="ISA 28:18">Liábinba lanarime lamiselu ábame laburechagunün<verse eid="ISA 28:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 28:19" />Ságüme liabin, laduruhanün.</para>
  <para style="q" vid="ISA 28:19">Liábinba sagü binaafin, wéyuagu luma áriebu,</para>
  <para style="q" vid="ISA 28:19">hadadagaruba láurügü haganbun luagu.<verse eid="ISA 28:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 28:20" />Ítara luba kei larounrúniwa tidan aban gabana bürüraütu</para>
  <para style="q" vid="ISA 28:20">luma ladourawagun tau aban sidi ñǘraütu.<verse eid="ISA 28:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 28:21" />Luadigimariduba Wabureme kei luagu wübü Perasímü,</para>
  <para style="q" vid="ISA 28:21">lagañiduba kei luagu fulasu wayati le Gabaón,</para>
  <para style="q" vid="ISA 28:21">lun ladügüni luadigimari le aramudaguabei.<verse eid="ISA 28:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 28:22" />Gumugualá lubeiti libidiounigan aau le gádanbalün,</para>
  <para style="q" vid="ISA 28:22">murutimaliñein higüringürin;</para>
  <para style="q" vid="ISA 28:22">lugundun aganbaadina luagu aranseli lan Wabureme Suntigabafu lun lagünrinchaguni ageiraü.<verse eid="ISA 28:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="ISA 28:23" />Aganba huméi le nariñagubei,</para>
  <para style="q" vid="ISA 28:23">aganba huméi nererun buidu:<verse eid="ISA 28:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 28:24" />Dan le lábunagua lan aban ábunaguti nadü,</para>
  <para style="q" vid="ISA 28:24">meredeti awouhei múa súnwandan.<verse eid="ISA 28:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 28:25" />Ma lárigiñe lúaradaguagüdüni múa,</para>
  <para style="q" vid="ISA 28:25">aba lafuruhani ilaü, lárigiñe aba lábunagun türigu,</para>
  <para style="q" vid="ISA 28:25">bunagua ligía sewada luma burí amu ilaü laru laru?<verse eid="ISA 28:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 28:26" />Arufuda lumuti Wabureme lun, ida luba lan ladügüni.<verse eid="ISA 28:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 28:27" />Ladüga méferehounti enelidu,</para>
  <para style="q" vid="ISA 28:27">mabalabahoun tuguya kareta ligibuagu kominu;</para>
  <para style="q" vid="ISA 28:27">afuruhóuarügüti enelidu luma kominu lau aban liraüraü wewe.<verse eid="ISA 28:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 28:28" />Afarahóuati türigu gama lumoun lau dan ladügǘwa;</para>
  <para style="q" vid="ISA 28:28">adügǘwati giñe lau lásügürawagüdün tubalaba kareta luéigiñe,</para>
  <para style="q" vid="ISA 28:28">aba lasuesihouniwa ilaü machuinrunga ligía.<verse eid="ISA 28:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 28:29" />Ítara liña giñe ladügüni Wabureme Suntigabafu laranseha.</para>
  <para style="q" vid="ISA 28:29">Garíawaseti burí laransehan, ladügübei lau óunwenbu lichú aau.<verse eid="ISA 28:29" /></para>
  <chapter eid="ISA 28" />
  <chapter number="29" style="c" sid="ISA 29" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 29:1" />Fugiabu Arieli, uburugu le meha ñein lubéi líchigoun urúei Dawidi likianpun!</para>
  <para style="q" vid="ISA 29:1">Hefeduha átiriraüya dan,<verse eid="ISA 29:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 29:2" />Níchugubei Arieli lidoun lénrengunga, ñeinbei ayahuni.</para>
  <para style="q" vid="ISA 29:2">Ítara luba uburugu nun kei Arieli le tímatimaati.<verse eid="ISA 29:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 29:3" />Nóunahabaña nisudaran lun hegeyedagun bau,</para>
  <para style="q" vid="ISA 29:3">lun hábürühan buagun luéigiñe sun oubaü.<verse eid="ISA 29:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 29:4" />Berederuba ǘnabuguñu, roun múarugu;</para>
  <para style="q" vid="ISA 29:4">ítara luba bumalali kei lumalali pantu;</para>
  <para style="q" vid="ISA 29:4">hámarubei laganbún bererun.<verse eid="ISA 29:4" /></para>
  <para style="q">
    <verse number="5-6" style="v" sid="ISA 29:5-6" />Gama lumoun sódinime,</para>
  <para style="q" vid="ISA 29:5-6">ábame labeichuniña Wabureme báganiñu lau wayuhuru,</para>
  <para style="q" vid="ISA 29:5-6">hárabaganali, ladürürühaniga, luriban dan, luma gudáü.</para>
  <para style="q" vid="ISA 29:5-6">Herederuba báganiñu ha gíbebaña kei kaliki,</para>
  <para style="q" vid="ISA 29:5-6">haduruuhóuba ha éibaahabalibu ha gíbebaña kei ubanaü sáühali.<verse eid="ISA 29:5-6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 29:7" />Sun gürigia ha, ageindagubaña luma Arieli,</para>
  <para style="q" vid="ISA 29:7">ha íchubaña lidere dan lun,</para>
  <para style="q" vid="ISA 29:7">ítara haba kei aban uénedü o aban lan aritaguni áriebuna.<verse eid="ISA 29:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 29:8" />Ítara luba kei dan le gewenedü lan aban lamati léigiña lan,</para>
  <para style="q" vid="ISA 29:8">gama lumoun dan lagagudun, málati lurageirugu;</para>
  <para style="q" vid="ISA 29:8">o kei lan dan le gewenedü lan aban mágürabuti látuña lan,</para>
  <para style="q" vid="ISA 29:8">gama lumoun aba lagagudun lau mágürabu mábeiñu lagülerugu.</para>
  <para style="q" vid="ISA 29:8">Ítara luba lasuseredun houn gürigia ha ageindagubaña luma wübü Sión.<verse eid="ISA 29:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 29:9" />Ítarameme humá lau libidiounigan hau!</para>
  <para style="q" vid="ISA 29:9">Ítarameme humá marihinga, anhaün busén!</para>
  <para style="q" vid="ISA 29:9">Ítarameme humá atuituiha kei bacharuatiña,</para>
  <para style="q" vid="ISA 29:9">lau sun matun humá uniñein bacharuagüdati!<verse eid="ISA 29:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 29:10" />Óunahaali Wabureme aban idabagu huliliti huagun.</para>
  <para style="q" vid="ISA 29:10">Profetagu, hagía hágubaña lílana fulasu,</para>
  <para style="q" vid="ISA 29:10">gama lumoun daruguaali Wabureme hau tau aban belu.<verse eid="ISA 29:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ISA 29:11" />Ítara liña sun uénedü hun kei katei le</para>
  <para style="q" vid="ISA 29:11">bürüwañuti tidan aban líburu to hóuburatu.</para>
  <para style="q" vid="ISA 29:11">Anhoun ichugúa lun aban le galiihaditi lun laliihanu,</para>
  <para style="q" vid="ISA 29:11">lariñaguba: «Siñá numutu, ladüga murugutiña».<verse eid="ISA 29:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 29:12" />Anhoun ichugúa lun aban le maliiraditi</para>
  <para style="q" vid="ISA 29:12">lun laliihanu, lariñaguba: «Maliiraditina».<verse eid="ISA 29:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ISA 29:13" />Lariñahare Wabureme nun:</para>
  <para style="q" vid="ISA 29:13">«Gürigia ha, láurügüñein dimurei nínsiñeda houn,</para>
  <para style="q" vid="ISA 29:13">hayumárugiñe híchiga inebesei nun,</para>
  <para style="q" vid="ISA 29:13">ánhounti hanigi, dísetu nuéi,</para>
  <para style="q" vid="ISA 29:13">óundaruni le hadügübei nun,</para>
  <para style="q" vid="ISA 29:13">katei le hadüga wügüriña lira,</para>
  <para style="q" vid="ISA 29:13">lafurendeirun hachügü.<verse eid="ISA 29:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 29:14" />Ligía naweiridagüdayaboun lubéi hanigi lau seini luma milaguru.</para>
  <para style="q" vid="ISA 29:14">Lagumuchaguba lichú hau chu tau,</para>
  <para style="q" vid="ISA 29:14">gumugua ligíame hafurendei furendeitiña».<verse eid="ISA 29:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 29:15" />Fugiabugu ha aramudagubaña luéi Wabureme</para>
  <para style="q" vid="ISA 29:15">lun haramuduni haransehan,</para>
  <para style="q" vid="ISA 29:15">ha adaagubalin hariban lábugiñe luburiga,</para>
  <para style="q" vid="ISA 29:15">hariñaga: «Marihin lumutiwa ni aban,</para>
  <para style="q" vid="ISA 29:15">mefenti ni aban luagu le wadügübei!»<verse eid="ISA 29:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 29:16" />Ariha humá lun ligaburi hagadeiruni katei!</para>
  <para style="q" vid="ISA 29:16">Kamá hamuga ítara liña múa kei le nadagimeinbalin.</para>
  <para style="q" vid="ISA 29:16">Mariñagunbei aban katei lun le adügübalin:</para>
  <para style="q" vid="ISA 29:16">«Mama buguya adügübalina».</para>
  <para style="q" vid="ISA 29:16">Mariñagun ligíame aban katei lauti múa lun le adügübalin:</para>
  <para style="q" vid="ISA 29:16">«Ibidiñeti bun ka lan badügübei».<verse eid="ISA 29:16" /></para>
  <para style="s1">Füramasewa lan esefuruni lun Ísüraeli</para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 29:17" />Málühali anhein eredera dabíara lun fulasume lánina ábunaguni,</para>
  <para style="q" vid="ISA 29:17">liábinmeti fulasu le lánina ábunaguni, ítara luba kei dabíara.<verse eid="ISA 29:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 29:18" />Lídanme weyu ligía, ha maganbunbaña,</para>
  <para style="q" vid="ISA 29:18">gayaraabei haganbun danme laliihóuniwa houn,</para>
  <para style="q" vid="ISA 29:18">gayaraame harihin marihintiña.</para>
  <para style="q" vid="ISA 29:18">Séfuaañame lídangiñe luburiga.<verse eid="ISA 29:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 29:19" />Ha ǘnabugubaña, hagundaarayaba luma Wabureme,</para>
  <para style="q" vid="ISA 29:19">gunda hagíame ha gudemetimabaña luma Lubungiute Ísüraeli le sándubei.<verse eid="ISA 29:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 29:20" />Hagumuchaguba ha mabuchahabaña,</para>
  <para style="q" vid="ISA 29:20">hagumuchaguba ha barüguabaña houngua,</para>
  <para style="q" vid="ISA 29:20">hama ha luágurügübei ladügǘn wuribani haritagua.<verse eid="ISA 29:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 29:21" />Ha ariñagubaña hawagu amu luagu áfaraha hamá</para>
  <para style="q" vid="ISA 29:21">ru hagía sádaragu lubá aguseragüdüti,</para>
  <para style="q" vid="ISA 29:21">míchugun haméi liricha le madurunbei lun.<verse eid="ISA 29:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="ISA 29:22" />Ligía lariñagunbei Wabureme le Lubungiute Ísüraeli,</para>
  <para style="q" vid="ISA 29:22">le esefurubalin Abüraámü:</para>
  <para style="q" vid="ISA 29:22">«Lúmagiñe guentó lun lubaruaguóun, masandihalime Hakobu busiganu,</para>
  <para style="q" vid="ISA 29:22">masansiragun ligíame ligibu.<verse eid="ISA 29:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 29:23" />Lugundun danme harihini ladügawagun le nadügübei hageira,</para>
  <para style="q" vid="ISA 29:23">hasubudirubei luagu au lan sándubei,</para>
  <para style="q" vid="ISA 29:23">inebe nuguyame houn, au le Lubungiute Ísüraeli.<verse eid="ISA 29:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 29:24" />Ha buga bulíeiguabaña, hafurendeiruba lun lachuurun hau,</para>
  <para style="q" vid="ISA 29:24">ha gagülülühadibaña hánharuba lun le arufudahóubei houn».<verse eid="ISA 29:24" /></para>
  <chapter eid="ISA 29" />
  <chapter number="30" style="c" sid="ISA 30" />
  <para style="s1">Dimurei habügürü ha áluahabaña ídemuei luma Ehiptu</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 30:1" />Lariñahare Wabureme:</para>
  <para style="q" vid="ISA 30:1">«Fugiabugu isaanigu mabuchahatiña</para>
  <para style="q" vid="ISA 30:1">ha aransehabaña hadügün aban katei málügüdünga hamana,</para>
  <para style="q" vid="ISA 30:1">aranseha hagía hadügüni haritagun le uáguti mariñagun nan houn,</para>
  <para style="q" vid="ISA 30:1">rúguatiñati figóu ligibuagun figóu!<verse eid="ISA 30:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 30:2" />Ñǘdüntiña Ehiptu furesegueina,</para>
  <para style="q" vid="ISA 30:2">ani málügüdahantiña numa;</para>
  <para style="q" vid="ISA 30:2">áluahatiña ídemuei luma urúei Ehiptuna,</para>
  <para style="q" vid="ISA 30:2">aramudaguatiña lábugiñe lamuñadiri Ehiptu.<verse eid="ISA 30:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 30:3" />Gama lumoun leyeedubaña lídehan urúei Ehiptuna,</para>
  <para style="q" vid="ISA 30:3">wuribabei lanügün haramudagun lábugiñe lamuñadiri Ehiptu houn.<verse eid="ISA 30:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 30:4" />Lau sun hóunahan láutiña uganu uburugun Soán luma Anesi,<verse eid="ISA 30:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 30:5" />leyeedubadün néchani meseriwínti ligía, le manügünbei ídemuei,</para>
  <para style="q" vid="ISA 30:5">ni kata buiti hun luéidigia magundani luma lamiselu».<verse eid="ISA 30:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 30:6" />Anihán uganu habügürü animaalugu ha Negebübaña:</para>
  <para style="q" vid="ISA 30:6">«Luéigiñe fulasu le buin umuti lau denchaü,</para>
  <para style="q" vid="ISA 30:6">le ñein lumuti haganóua liñún,</para>
  <para style="q" vid="ISA 30:6">hewe hama düragón burí áhamahatiña,</para>
  <para style="q" vid="ISA 30:6">hanügei hirisin hanagawagu burigü hama kameyu Ehiptun,</para>
  <para style="q" vid="ISA 30:6">fulasu móuniti,<verse eid="ISA 30:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 30:7" />mabafuti, siñati lídehan.</para>
  <para style="q" vid="ISA 30:7">Ligía níchugunbalin iri le luagu:</para>
  <para style="q" vid="ISA 30:7">“Mónsturu le adürürühabei gama lumoun madügünti ni kata”. »<verse eid="ISA 30:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 30:8" />Lariñahare Wabureme nun:</para>
  <para style="q" vid="ISA 30:8">«Abürühabei lubeiti uénedü le guentó luagu aban fulansu,</para>
  <para style="q" vid="ISA 30:8">lun lerederun kei aban gefenti magumuchaditi lubá líteme.<verse eid="ISA 30:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 30:9" />Mabuchahatiña gürigia ha, magunfulintiña,</para>
  <para style="q" vid="ISA 30:9">máhatiña haganbuni larufudahan Wabureme.<verse eid="ISA 30:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 30:10" />Ariñagatiña houn aríaahatiña:</para>
  <para style="q" vid="ISA 30:10">Mewenedü humá. Ariñaga hagía houn profetagu:</para>
  <para style="q" vid="ISA 30:10">Mabahüdagua humá arufudúni inarüniti woun;</para>
  <para style="q" vid="ISA 30:10">hadimureha dimurei burí huáliti woun,</para>
  <para style="q" vid="ISA 30:10">magidara huméi waritagun wawéi.<verse eid="ISA 30:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 30:11" />Direi humá luéi üma, geyé humá luéi üma le surubei,</para>
  <para style="q" vid="ISA 30:11">míchiga humawa ligibugiñe Wabungiute le Sándubei, le Lubungiute Ísüraeli».<verse eid="ISA 30:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 30:12" />Ligía lariñagunbei Wabungiute le Sándubei le Lubungiute Ísüraeli:</para>
  <para style="q" vid="ISA 30:12">«Máhatün lun eweridihani le,</para>
  <para style="q" vid="ISA 30:12">hemenigitün luagu anarimeni luma wuribani,</para>
  <para style="q" vid="ISA 30:12">luagu burí katei le hárügüda;<verse eid="ISA 30:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 30:13" />Ligía gadurun hubéi.</para>
  <para style="q" vid="ISA 30:13">Ítara hiña kei aban baríeiru íñuti le</para>
  <para style="q" vid="ISA 30:13">fudufuduguhali le gayaraabei léiguadun sódini.<verse eid="ISA 30:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 30:14" />Ítara huba kei aban fudu le lauti múa,</para>
  <para style="q" vid="ISA 30:14">le dan lubéi labouchagun meredeti</para>
  <para style="q" vid="ISA 30:14">ni murusun life le gayaraati leseriwidun</para>
  <para style="q" vid="ISA 30:14">lun lasagahóun leñegura watu régigirugugiñe,</para>
  <para style="q" vid="ISA 30:14">o lun lan ladaburún duna fúsurugugiñe».<verse eid="ISA 30:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 30:15" />Lariñahare Wabureme le Sándubei le Lubungiute Ísüraeli:</para>
  <para style="q" vid="ISA 30:15">«Giribu humá, darangilu humá, ábame hesefurun.</para>
  <para style="q" vid="ISA 30:15">Lídanbei darangilaü luma emenigini here».</para>
  <para style="q" vid="ISA 30:15">Gama lumoun máhatün,<verse eid="ISA 30:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 30:16" />hariñagarüga: Uá, wanurahagubei gabayuagu.</para>
  <para style="q" vid="ISA 30:16">«Ítara luba lubeiti hanurahan».</para>
  <para style="q" vid="ISA 30:16">Ariñagatün giñe: «Wádinuba karü fureseburitu».</para>
  <para style="q" vid="ISA 30:16">Furese baña lubeiti ha lúnbaña héibaahanün.<verse eid="ISA 30:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 30:17" />Hanurahaba milu luéi ábanrügü wügüri,</para>
  <para style="q" vid="ISA 30:17">sun huguya hanurahaba hawéi séingürügü wügüriña</para>
  <para style="q" vid="ISA 30:17">darime herederun fiú kei lerederun aban wewe lábulugu aban wübü</para>
  <para style="q" vid="ISA 30:17">o aban lan seini le luáguti aban wübü.<verse eid="ISA 30:17" /></para>
  <para style="s1">Füramasewa lan gudemehabu lun uburugu</para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 30:18" />Gama lumoun lagurabuñadün Wabureme lau lugudemehabu hun; busenti larufuduni línsiñehabu hun, lugundun richati Wabureme le Wabungiute. Fuleseiwatiña sun ha hemenigibaña luagu!<verse eid="ISA 30:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 30:19" />Lílana Sión, ha aganóubaña Herusalén: Mayahundigiaadün. Gudemehabubei Wabureme hun danme laganbun hagúarahan amuriaha ídemuei, ani keime laganbunün, ítara luba lóunabunün. <verse eid="ISA 30:19" /><verse number="20" style="v" sid="ISA 30:20" />Ani lau sun líchugun Wabureme fein lánina asufuriruni, luma duna lánina idiheri hun, ligía le humaisturun, maramudagundigiaali; harihubei lau hagu. <verse eid="ISA 30:20" /><verse number="21" style="v" sid="ISA 30:21" />Ani anhaün adireira luagun hóunwenren o luagun lan hubaünan, haganbuba aban umalali hanagangiñe ariñaguti hun: «Anihán ǘmabei, ñéingiñela hidin». <verse eid="ISA 30:21" /><verse number="22" style="v" sid="ISA 30:22" />Ábame hanügüniña higuariuan kei katei wíyeti, higuariuan ha láutiña pülata hama ha láutiña golu. Híchuguba mebereseni hau kei katei wíyeti, hanügübaña kei ifei.<verse eid="ISA 30:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 30:23" />Líchuguba Wabureme huya hun lun hábunaguni múa, ábame líchugun múa saragu türigu hilumati. Lídanme weyu ligía, ñeinbei saragu fulasu houn hilügüniña lun heigin sagadi. <verse eid="ISA 30:23" /><verse number="24" style="v" sid="ISA 30:24" />Íbini bágasu wügüriña hama burigü ha nadagimeinbaña humúanrugu, héigibei lubuidun-agei heigin animaalugu. <verse eid="ISA 30:24" /><verse number="25" style="v" sid="ISA 30:25" />Danme lachülürün weyu lánina lueirin áfarahani, danme léiguadunga erei, ñeinbei lanarime léibaagun duna lidan burí liñun áraabu luma luagu burí liñun wübü. <verse eid="ISA 30:25" /><verse number="26" style="v" sid="ISA 30:26" />Lagaranihaba Wabureme lun burí biti le hawagubei lánigu, ábametima larunidun hati kei weyu, ani léreduba laruni weyu sedü wéiyaasu luéiñaha ligaburi, kei laruni sedü weyu lidan aban.<verse eid="ISA 30:26" /></para>
  <para style="s1">Labeichúba Asiria</para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 30:27" />Anitén Wabureme dísegiñe:</para>
  <para style="q" vid="ISA 30:27">Laduranguña ligañi lau gumuleli dereguati,</para>
  <para style="q" vid="ISA 30:27">buin liña liyumaaru lau igañi,</para>
  <para style="q" vid="ISA 30:27">ítara tiña liñeñe kei watu gemeti le gagünrinchaguati.<verse eid="ISA 30:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 30:28" />Ítara liña lawaragun kei aban duna le afuluduhati,</para>
  <para style="q" vid="ISA 30:28">dan le lawarirun chülüti luagun igiinaü;</para>
  <para style="q" vid="ISA 30:28">liábiña íchigei ihürügu hawagu gürigia lun lanügüniña lidoun günringuaü,</para>
  <para style="q" vid="ISA 30:28">íchiga furenu luagu hayuma lun layuridaguagüdüniña.<verse eid="ISA 30:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 30:29" />Ánheinti hun, ñeinbei uremu,</para>
  <para style="q" vid="ISA 30:29">kei lidan fedu sagüráuti;</para>
  <para style="q" vid="ISA 30:29">gúndaañu tuba hanigi,</para>
  <para style="q" vid="ISA 30:29">kei lanigi le éibuguti úara luma tamuri fidu</para>
  <para style="q" vid="ISA 30:29">lun lidin lidoun luwübüri Wabureme,</para>
  <para style="q" vid="ISA 30:29">lidoun laramudaguagüle Ísüraeli.<verse eid="ISA 30:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="ISA 30:30" />Laganbagüdübei Wabureme, luéirigun lumalali,</para>
  <para style="q" vid="ISA 30:30">larufudubei lubafu, le lunbei luadigimaridun lau lanarime igañi,</para>
  <para style="q" vid="ISA 30:30">lau watu gemeti le gagumuchaguagüdaditi,</para>
  <para style="q" vid="ISA 30:30">lau labirihaniga, lau guran huya luma lúbara huya dereguati.<verse eid="ISA 30:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="ISA 30:31" />Labuinchuba Asiria lau anufudei</para>
  <para style="q" vid="ISA 30:31">danme laganbuni lumalali Wabureme</para>
  <para style="q" vid="ISA 30:31">luma danme le labeichuni,<verse eid="ISA 30:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="ISA 30:32" />Ságüme lagayuahan Wabureme luagu,</para>
  <para style="q" vid="ISA 30:32">laganbúba garanwoun tuma árüpa.</para>
  <para style="q" vid="ISA 30:32">Líchuguba Wabureme aban lanarime wuribu luagu.<verse eid="ISA 30:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="ISA 30:33" />Lúmagiñe binarü aranseñu liña lan</para>
  <para style="q" vid="ISA 30:33">aban fulasu lánina asufuriruni</para>
  <para style="q" vid="ISA 30:33">lubá Asiria luma lubá lurúeite,</para>
  <para style="q" vid="ISA 30:33">le ñeinba lubéi lagudúa.</para>
  <para style="q" vid="ISA 30:33">Migifeti fulasu ligía ani huliliti giñe,</para>
  <para style="q" vid="ISA 30:33">aban bugan watu gemeti lau saragu watu.</para>
  <para style="q" vid="ISA 30:33">Lébedubei Wabureme lau lawaragun</para>
  <para style="q" vid="ISA 30:33">kei aban léibaagun duna lauti súfuru.<verse eid="ISA 30:33" /></para>
  <chapter eid="ISA 30" />
  <chapter number="31" style="c" sid="ISA 31" />
  <para style="s1">Habügürü ha áluahabaña ídemuei luma Ehiptu</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 31:1" />Fugiabugu ha ñǘdünbaña Ehiptu áluga híderawagun,</para>
  <para style="q" vid="ISA 31:1">ha hemenigibaña hawagu gabayu,</para>
  <para style="q" vid="ISA 31:1">ha íchugubalin hemenigi luagu tibe hakarün</para>
  <para style="q" vid="ISA 31:1">luma luagu hibe hagabayun,</para>
  <para style="q" vid="ISA 31:1">madigiragúntiña luagun Wabungiute le Lubungiute Ísüraeli,</para>
  <para style="q" vid="ISA 31:1">máluahan hamuti Wabureme!<verse eid="ISA 31:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 31:2" />Gama lumoun chuti lau Wabureme</para>
  <para style="q" vid="ISA 31:2">ani adügati lun ñein lan lamiselu,</para>
  <para style="q" vid="ISA 31:2">ani dan le lariñagun aban katei, adüga lumuti.</para>
  <para style="q" vid="ISA 31:2">Liñuraguba hawagun gürigia salufuritiña</para>
  <para style="q" vid="ISA 31:2">ha íderagubaliña wuribatiña adüga wuribani.<verse eid="ISA 31:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 31:3" />Mama búngiugu wügüriña Ehiptuna;</para>
  <para style="q" vid="ISA 31:3">láutiña ǘgürügü hagabayun, mama sífirigu.</para>
  <para style="q" vid="ISA 31:3">Liñurubei Wabureme lúhabu lun labeichuniña,</para>
  <para style="q" vid="ISA 31:3">ani dandu le ágüdahabei, kei le ágüdahoubei, hábürühaba;</para>
  <para style="q" vid="ISA 31:3">hagumuchaguba sun hagía úara.<verse eid="ISA 31:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 31:4" />Lariñahare Wabureme nun:</para>
  <para style="q" vid="ISA 31:4">«Ítara kei mígirun lan aban liñún le áfaraali aban mudún</para>
  <para style="q" vid="ISA 31:4">lun halouchagüdüni hóuniri mudún,</para>
  <para style="q" vid="ISA 31:4">íbini hóundaragun sun hagía oucha halouchagüdüni lau hagúarahan,</para>
  <para style="q" vid="ISA 31:4">ítara luba liabin Wabureme Suntigabafu</para>
  <para style="q" vid="ISA 31:4">esefuraña lánigu luagu wübü Sión.<verse eid="ISA 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 31:5" />Kei dunuru to óunigirubalin tumasa áhamaha lóugiñe,</para>
  <para style="q" vid="ISA 31:5">ítara luba lóunigiruni Wabureme Suntigabafu Herusalén;</para>
  <para style="q" vid="ISA 31:5">lóunigirubei, líderagubei, lesefurubei».<verse eid="ISA 31:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 31:6" />Lirahüñü Ísüraeli,</para>
  <para style="q" vid="ISA 31:6">giribu humá lun le hanabagubei.<verse eid="ISA 31:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 31:7" />Lugundun wéyume hígiruniña sun guáriua láutiña golu luma pülata</para>
  <para style="q" vid="ISA 31:7">ha hadügübaña lau húhabu gafigounti,<verse eid="ISA 31:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 31:8" />lábürühaba Asiria tau eféin,</para>
  <para style="q" vid="ISA 31:8">gama lumoun mama lau lubafu wügüri.</para>
  <para style="q" vid="ISA 31:8">Lanuraagüdübaña wuribu lílana fulasu,</para>
  <para style="q" vid="ISA 31:8">ábame hanaawagun nibureintiña</para>
  <para style="q" vid="ISA 31:8">ha wuriburuguna idamunime;<verse eid="ISA 31:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 31:9" />láfuriduba lurúeite éibaagueina le lanufude,</para>
  <para style="q" vid="ISA 31:9">hanurahaba hábutigu súdara lídangiñe habara.</para>
  <para style="q" vid="ISA 31:9">Aburemei ariñagubalin le,</para>
  <para style="q" vid="ISA 31:9">luagu anihein lan aban bugan watu gemeti luma uburugu Herusalén</para>
  <para style="q" vid="ISA 31:9">lun labeichaguniña láganiñu.<verse eid="ISA 31:9" /></para>
  <chapter eid="ISA 31" />
  <chapter number="32" style="c" sid="ISA 32" />
  <para style="s1">Arúeihani le richati</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 32:1" />Anihein aban urúei le lunbei larúeihan lau ísuruni</para>
  <para style="q" vid="ISA 32:1">hama gumadimatiña ha lúnbaña hagumadihan lau irichaü.<verse eid="ISA 32:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 32:2" />Ítara luba kada aban hádangiñe</para>
  <para style="q" vid="ISA 32:2">kei aramudaguagülei luéi garabali luma luéi luriban dan,</para>
  <para style="q" vid="ISA 32:2">kei lísensen duna lidan múa mábeiti,</para>
  <para style="q" vid="ISA 32:2">kei lamuñadina aban óunwenbu dübü lidan fulasu mageirawati.<verse eid="ISA 32:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 32:3" />Fegeñu luba hagu buidu buidu,</para>
  <para style="q" vid="ISA 32:3">ani aranseñu haba lun haganbun;<verse eid="ISA 32:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 32:4" />Móufudahanbaña adüga aban katei,</para>
  <para style="q" vid="ISA 32:4">hadügübei lau lichú aau,</para>
  <para style="q" vid="ISA 32:4">ariñaga hameime katei lau lufurangun.<verse eid="ISA 32:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 32:5" />Mariñagunbaña gürigia lun le wuribabei buiti,</para>
  <para style="q" vid="ISA 32:5">manügün hameime le wíyebei igaburi kei gürigia wéiriguti.<verse eid="ISA 32:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 32:6" />Lugundun le wuribabei igaburi,</para>
  <para style="q" vid="ISA 32:6">kei wuriba tigaburi ladimureha,</para>
  <para style="q" vid="ISA 32:6">lagübüri aritaguni laritagunrugubei;</para>
  <para style="q" vid="ISA 32:6">áluahati láfarahan,</para>
  <para style="q" vid="ISA 32:6">adimurehati iyeeni luagu Wabureme;</para>
  <para style="q" vid="ISA 32:6">méigagüdün lumuti le lamabei,</para>
  <para style="q" vid="ISA 32:6">mátagüdünlei le mágürabubei.<verse eid="ISA 32:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 32:7" />Le wíyebei adaaguati iwiyei;</para>
  <para style="q" vid="ISA 32:7">añawariha lumutiña gudemetiña lau liyeeni,</para>
  <para style="q" vid="ISA 32:7">hama mégeihabutiña ha amuriahabaña irichaü.<verse eid="ISA 32:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 32:8" />Ánheinti le harumabei, harumati laritagun,</para>
  <para style="q" vid="ISA 32:8">ani deregüdagu liña lidan laruman aritaguni ligía.<verse eid="ISA 32:8" /></para>
  <para style="s1">Ñunsu houn würiña Herusalénna</para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 32:9" />Huguya würiña ha meberesenbaña lau ni kata,</para>
  <para style="q" vid="ISA 32:9">aganba huméi le lunbei nariñaguni hun.</para>
  <para style="q" vid="ISA 32:9">Würiña hemenigitiña, aganba huméi nererun.<verse eid="ISA 32:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 32:10" />Hemenigitün guentó,</para>
  <para style="q" vid="ISA 32:10">gama lumoun aban irumu átiriraüya lárigiñe le,</para>
  <para style="q" vid="ISA 32:10">hanufudedaguba, lugundun lagumuchuba alubahani,</para>
  <para style="q" vid="ISA 32:10">mabudahanhaadünme beibei.<verse eid="ISA 32:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 32:11" />Huguya le meberesenbei lau ni kata, hadadagara;</para>
  <para style="q" vid="ISA 32:11">huguya le sandiguabei hungua lau emenigini, hingi humá,</para>
  <para style="q" vid="ISA 32:11">ragá humoun daüguaü to huáriua,</para>
  <para style="q" vid="ISA 32:11">daü humá daüguaü súsutu arufudei higarigu.<verse eid="ISA 32:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 32:12" />Arufuda huméi higarigu</para>
  <para style="q" vid="ISA 32:12">luagu burí ichari luma beibei-agei hilumati.<verse eid="ISA 32:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 32:13" />Láhüchüba hiiyu hamúanrugu nánigu.</para>
  <para style="q" vid="ISA 32:13">Hayahuaha luagu uburugu le lánina ugundani,</para>
  <para style="q" vid="ISA 32:13">luma burí tuagu muna to buinboun hau gürigia gúndaatiña.<verse eid="ISA 32:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 32:14" />Terederuba luban urúei</para>
  <para style="q" vid="ISA 32:14">luma uburugu le meha gíbebaña gürigia ñein málouga;</para>
  <para style="q" vid="ISA 32:14">lerederuba uburugu baríeiruati málouga lun súnwandan;</para>
  <para style="q" vid="ISA 32:14">haganóuba burigü áraabuna ñein, hou hagíame bágasu sagadi ñein.<verse eid="ISA 32:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 32:15" />Gama lumoun liábiyaba lubafu Bungiu wawagun íñugiñe,</para>
  <para style="q" vid="ISA 32:15">ábame liabin fulasu mageirawati lun múame lánina tábunawagun nadü</para>
  <para style="q" vid="ISA 32:15">ani larandaratimaba múa le ñein lumuti nadü.<verse eid="ISA 32:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 32:16" />Larúeihaba úarani luma irichaü</para>
  <para style="q" vid="ISA 32:16">tidan sun muna fulasurugu.<verse eid="ISA 32:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 32:17" />Lanügüba irichaü, darangilaü</para>
  <para style="q" vid="ISA 32:17">luma emenigini lun súnwandan.<verse eid="ISA 32:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 32:18" />Haganóuba numutuniña lidan aban fulasu gálumati,</para>
  <para style="q" vid="ISA 32:18">tidan burí rumu chóurutu, tidan burí muna darangilatu,<verse eid="ISA 32:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 32:19" />íbini anhein achugúa sun dabíara,</para>
  <para style="q" vid="ISA 32:19">ǘnabugüdawa uburugu.<verse eid="ISA 32:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 32:20" />Huguya habagariduba gúndaañu,</para>
  <para style="q" vid="ISA 32:20">lau duna buídurügüti lun hichari luma éigini chóuruti</para>
  <para style="q" vid="ISA 32:20">lun burigü luma lun bulu bágasu.<verse eid="ISA 32:20" /></para>
  <chapter eid="ISA 32" />
  <chapter number="33" style="c" sid="ISA 33" />
  <para style="s1">Asufuriruni luma esefuruni</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 33:1" />Fugiabu buguya le agünrinchagubei ani magünrinchawaguntibu!</para>
  <para style="q" vid="ISA 33:1">Agarabahati le magarabaawagunti luagun!</para>
  <para style="q" vid="ISA 33:1">Danme lásurun bagünrinchagun, bagünrinchawaguba,</para>
  <para style="q" vid="ISA 33:1">danme lásurun bagarabahan, lagarabawaguba giñe bun.<verse eid="ISA 33:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ISA 33:2" />Wabureme, gudemehabubá woun,</para>
  <para style="q" vid="ISA 33:2">wagía le hemenigibei buagu.</para>
  <para style="q" vid="ISA 33:2">Buagulá wabalacha sagü weyu,</para>
  <para style="q" vid="ISA 33:2">Wesefuragülebá lidan lénrengunga.<verse eid="ISA 33:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 33:3" />Éibaaguatiña gürigia dan haganbuni bumalali,</para>
  <para style="q" vid="ISA 33:3">dan le biñuragun bungua aba hachagaragun néchanigu;<verse eid="ISA 33:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 33:4" />aba hábürühan háganiñu hawagun kei chigangaru, aba hagidaruni harisin hawéi.<verse eid="ISA 33:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 33:5" />Íñuguti Wabureme lugundun sielu laganóua;</para>
  <para style="q" vid="ISA 33:5">buíngüda laali Sión lau úaraguni luma irichaü.<verse eid="ISA 33:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 33:6" />Ani líchuguba achoururuni lun súnwandan,</para>
  <para style="q" vid="ISA 33:6">lichú au luma subudi,</para>
  <para style="q" vid="ISA 33:6">aban irisini le esefuhati;</para>
  <para style="q" vid="ISA 33:6">aban irisini inebehabu lun Wabureme.<verse eid="ISA 33:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 33:7" />Aganbabéi hagúarahan ganigitiña ǘmadarugu</para>
  <para style="q" vid="ISA 33:7">luma hayahuahan ha ounahóubaña áluahei darangilaü!<verse eid="ISA 33:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 33:8" />Mala buriti üma úatiña éibugutiña luagu,</para>
  <para style="q" vid="ISA 33:8">dürüwaguati daradu;</para>
  <para style="q" vid="ISA 33:8">úati inebenehabúni ni ka un.<verse eid="ISA 33:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 33:9" />Lamuiseruña múa, híruti.</para>
  <para style="q" vid="ISA 33:9">Lásaürüña Líwanu lau busiganu,</para>
  <para style="q" vid="ISA 33:9">rédeiha lani Sarón fulasu wayati kei fulasu mageirawati,</para>
  <para style="q" vid="ISA 33:9">hiyá Basán luma wübü Karümélu.<verse eid="ISA 33:9" /></para>
  <para style="s1">Ñunsu houn áganiñu</para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 33:10" />Lariñahare Wabureme:</para>
  <para style="q" vid="ISA 33:10">«Nuadigimarida guentó;</para>
  <para style="q" vid="ISA 33:10">narufudaali sun nuéirigun.<verse eid="ISA 33:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 33:11" />Huguya, sun le haransehabei luma sun le hadügübei,</para>
  <para style="q" vid="ISA 33:11">ítara liña kei ifei;</para>
  <para style="q" vid="ISA 33:11">lagumuchaguagüdübadün náfurun</para>
  <para style="q" vid="ISA 33:11">kei lagumuchaguagüdün aban gudáü.<verse eid="ISA 33:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 33:12" />Lasaliraguba burí fulasu baligime;</para>
  <para style="q" vid="ISA 33:12">láguduba kei hiiyu cháünwaali lidan watu gemeti.<verse eid="ISA 33:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 33:13" />Ha dísebaña, aganba haméi le nadügübei,</para>
  <para style="q" vid="ISA 33:13">ha yarafabaña, subudi haméi nubafu».<verse eid="ISA 33:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 33:14" />Adadagaratiña gafigountiña Sión,</para>
  <para style="q" vid="ISA 33:14">ha salufuribaña buíntiña lau anufudei aba hariñagun:</para>
  <para style="q" vid="ISA 33:14">«Ka wádangiñe gayaraabei labagaridun</para>
  <para style="q" vid="ISA 33:14">lidan watu gemeti le gagünrinchaguaditi,</para>
  <para style="q" vid="ISA 33:14">lidan aban watu gemeti magumuchaditi?»<verse eid="ISA 33:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 33:15" />Le úaraguabei igaburi ariñagaléi inarüni,</para>
  <para style="q" vid="ISA 33:15">le marisidunbei lau erei,</para>
  <para style="q" vid="ISA 33:15">mígiraguagüdün ligía lungua lun lagañeihóun lau edewehani,</para>
  <para style="q" vid="ISA 33:15">le madügünbei gasu lau ínchahani lun áfarahani</para>
  <para style="q" vid="ISA 33:15">ani muruléi lagu luéi laríagun wuribani,<verse eid="ISA 33:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 33:16" />ligíaba abagarida chóuruñu,</para>
  <para style="q" vid="ISA 33:16">lídanbei aban baríeiru laramudaguagüle,</para>
  <para style="q" vid="ISA 33:16">géiginbei súnwandan ani memegeirúnbei duna lun.<verse eid="ISA 33:16" /></para>
  <para style="s1">Emenigini houn lánigu Bungiu</para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 33:17" />Barihayabei urúei lidan luéirigun;</para>
  <para style="q" vid="ISA 33:17">lachülürüba burí láfadaragun fulasu dise.<verse eid="ISA 33:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 33:18" />Danme baritagun luagun anufudei le meha gádanbalibu,</para>
  <para style="q" vid="ISA 33:18">bariñaguba: «Hagéi san le meha abahüdübalin liseinsuna fulasu?</para>
  <para style="q" vid="ISA 33:18">Hagéi le meha abahüdübalin wáyelesi?</para>
  <para style="q" vid="ISA 33:18">Hagéi le meha óunigiruñahabalin baríeiru?»<verse eid="ISA 33:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 33:19" />Maganóunhadibume haganagua gürigia salufuritiña,</para>
  <para style="q" vid="ISA 33:19">gürigia ha hénrengubei gunfurandawa lan hererun.<verse eid="ISA 33:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 33:20" />Arihabá lun Sión, luburugute wefeduhan;</para>
  <para style="q" vid="ISA 33:20">arihabá lun Herusalén, uburugu chóuruti;</para>
  <para style="q" vid="ISA 33:20">ítara luba kei aban kianpu-agei derebugutu,</para>
  <para style="q" vid="ISA 33:20">to mahulúnti tuenwena, mátumurun ligía tuguruduna.<verse eid="ISA 33:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 33:21" />Ñeinbei Wabureme wama lau luéirigun.</para>
  <para style="q" vid="ISA 33:21">Aban fulasu le ñein lumuti duna éibaaguati, le dabubereti, Herusalén,</para>
  <para style="q" vid="ISA 33:21">gama lumoun mebelubaña áganiñu ñeinhin tau burí tuéinamun hagune.<verse eid="ISA 33:21" /></para>
  <para style="q">
    <verse number="22-23" style="v" sid="ISA 33:22-23" />Siñá lumuti burí tugurudun ugunei tuguya birebu ágüdaha;</para>
  <para style="q" vid="ISA 33:22-23">siñati látuleragun bira.</para>
  <para style="q" vid="ISA 33:22-23">Wabayuruba saragu irisini hawéi áganiñu,</para>
  <para style="q" vid="ISA 33:22-23">darime lun libihini marihinti lufanran</para>
  <para style="q" vid="ISA 33:22-23">asagaraha hagíame méibuguntiña.</para>
  <para style="q" vid="ISA 33:22-23">Lugundun Wabureme wánibei aguseragüdüti,</para>
  <para style="q" vid="ISA 33:22-23">ligía íchugubei lúrudu woun,</para>
  <para style="q" vid="ISA 33:22-23">ligía warúeitebei, lesefurubadiwa.<verse eid="ISA 33:22-23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 33:24" />Mariñagunbei ni aban lílana fulasu:</para>
  <para style="q" vid="ISA 33:24">«Sándiñadina». Ladüga feruduna lubéi Wabungiute hafigoun lílana Sión.<verse eid="ISA 33:24" /></para>
  <chapter eid="ISA 33" />
  <chapter number="34" style="c" sid="ISA 34" />
  <para style="s1">Labeichuni Wabungiute Edomu</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 34:1" />Gürigia, higougu yarafa humá lun haganbun,</para>
  <para style="q" vid="ISA 34:1">néchanigu ru humá arigei.</para>
  <para style="q" vid="ISA 34:1">Aganbalá sun ubóu,</para>
  <para style="q" vid="ISA 34:1">aganba hamá giñe sun ha aganóubaña lidan.<verse eid="ISA 34:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 34:2" />Lugundun gáñiti Wabureme hama sun néchanigu,</para>
  <para style="q" vid="ISA 34:2">luma hama sun lisudaranigu,</para>
  <para style="q" vid="ISA 34:2">ani siadiláña lun günringuaü luma lun óunweni.<verse eid="ISA 34:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 34:3" />Higirúba hilaguaaña chagagu,</para>
  <para style="q" vid="ISA 34:3">ábame língidun hágubu</para>
  <para style="q" vid="ISA 34:3">léibaaguba hitaü luéigiñe wübü kei duna.<verse eid="ISA 34:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 34:4" />Lagünrinchawaguba weyu, hati tuma burí waruguma,</para>
  <para style="q" vid="ISA 34:4">labaruchaguba sielu kei aban gárada.</para>
  <para style="q" vid="ISA 34:4">Tábürühaba sun waruguma</para>
  <para style="q" vid="ISA 34:4">kei lábürühan aban tubana beibei o tubana tídibu igu</para>
  <para style="q" vid="ISA 34:4">le átügürüti luéigiñe lídibu.<verse eid="ISA 34:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 34:5" />Tasaliraguba lefeinte Wabureme sielu</para>
  <para style="q" vid="ISA 34:5">ábame tábürühan luagun Edomu,</para>
  <para style="q" vid="ISA 34:5">fulasu le siádiwaalibei lun óunweni.<verse eid="ISA 34:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 34:6" />Tabuinchuba lefeinte Wabureme lau hitaü luma agülei,</para>
  <para style="q" vid="ISA 34:6">kei dan le háfarun mudún hama gábara lidan adagaragüdüni.</para>
  <para style="q" vid="ISA 34:6">Ladügüba Wabureme aban adagaragüdüni uburugu Bosurá,</para>
  <para style="q" vid="ISA 34:6">aban óunwenbu áfarahani uburugu Edomu.<verse eid="ISA 34:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 34:7" />Hábürühaba kei bágasu wügüriña</para>
  <para style="q" vid="ISA 34:7">ladüdürüba múa lau hitaü,</para>
  <para style="q" vid="ISA 34:7">ábame labuinchun kaliki lau agülei.<verse eid="ISA 34:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 34:8" />Luéyuribei láguyugüdün Wabureme wuribani,</para>
  <para style="q" vid="ISA 34:8">irumu lánina libihini Sión le leferidirubei lárigoun.<verse eid="ISA 34:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 34:9" />Lasaliraguba lirahüñü burí duna le</para>
  <para style="q" vid="ISA 34:9">uburugubei Edomu lagüleme gudi,</para>
  <para style="q" vid="ISA 34:9">saliguame kaliki súfurume;</para>
  <para style="q" vid="ISA 34:9">legemechuba múa kei lagüle gudi.<verse eid="ISA 34:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 34:10" />Méñeguchunbei ni wéyuagu ni áriebu;</para>
  <para style="q" vid="ISA 34:10">lamudeiruba lugumulelin súnwandan.</para>
  <para style="q" vid="ISA 34:10">Lerederuba málouga gumugua dan.</para>
  <para style="q" vid="ISA 34:10">Másügürünwadigiaalime ñéingiñe.<verse eid="ISA 34:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 34:11" />Ñeinba haganóua yalifu hama dunuru áriebuna,</para>
  <para style="q" vid="ISA 34:11">hadügüba hádibu ñein.</para>
  <para style="q" vid="ISA 34:11">Ladügübei Wabureme ageiraü ligía fulasume mageirawati.<verse eid="ISA 34:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 34:12" />Úadigiaalime aban urúei lun larúeihan ñein;</para>
  <para style="q" vid="ISA 34:12">hagumuchaguba sun lábutigu.<verse eid="ISA 34:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 34:13" />Láhüchüba hiiyu tidan hani palasiu,</para>
  <para style="q" vid="ISA 34:13">luma híduru luagu habarieirun.</para>
  <para style="q" vid="ISA 34:13">Ábanbei fulasu le ñein lumuti haganóua ounli áraabuna,</para>
  <para style="q" vid="ISA 34:13">le ñein lumuti hemeraagua dunuru.<verse eid="ISA 34:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 34:14" />Haganóuba mesu áraabuna ñein hama ounli áraabuna,</para>
  <para style="q" vid="ISA 34:14">hagúahaba gábara hóuniwagua ñein.</para>
  <para style="q" vid="ISA 34:14">Ñeinba laganóua pantu le anufudehabei áriebu,</para>
  <para style="q" vid="ISA 34:14">ladariruba lubara ñein lun lemeraagun.<verse eid="ISA 34:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 34:15" />Tadügüba garún tídibu ñein,</para>
  <para style="q" vid="ISA 34:15">temeilihaba ñein, ábame tasagaruniña tirahüñü,</para>
  <para style="q" vid="ISA 34:15">ábame tóundaruniña lun tóunigiruniña.</para>
  <para style="q" vid="ISA 34:15">Hóundaraguba giñe garún ñein</para>
  <para style="q" vid="ISA 34:15">kada garún wügüri tau lúmari.<verse eid="ISA 34:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="ISA 34:16" />Ariha humoun liliburun Wabureme, aliiha humoun:</para>
  <para style="q" vid="ISA 34:16">Memegeirúnbei ni aban hádangiñe animaalugu ha,</para>
  <para style="q" vid="ISA 34:16">kada animaalu wügüri tau lúmari,</para>
  <para style="q" vid="ISA 34:16">ladüga ítara liña laranseruni Wabureme guánarügü,</para>
  <para style="q" vid="ISA 34:16">lóundarubaña lau láfurun.<verse eid="ISA 34:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 34:17" />Arufuda laali lubara kada aban lun,</para>
  <para style="q" vid="ISA 34:17">arufuda laali lufulasun lun lau lúhabu,</para>
  <para style="q" vid="ISA 34:17">ñéinbaña lun súnwandan;</para>
  <para style="q" vid="ISA 34:17">haganóuba ñein gumugua dan.<verse eid="ISA 34:17" /></para>
  <chapter eid="ISA 34" />
  <chapter number="35" style="c" sid="ISA 35" />
  <para style="s1">Hagiribudun gürigia uburugun Sión</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 35:1" />Gundaalá fulasu mageirawati, múa mábeiti;</para>
  <para style="q" vid="ISA 35:1">buinla lau ugundani, legeleweha.<verse eid="ISA 35:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 35:2" />Hüchala fuluri ñein kei liriu,</para>
  <para style="q" vid="ISA 35:2">buinla lau ugundani.</para>
  <para style="q" vid="ISA 35:2">Labuiduragüdübei Wabungiute kei Líwanu,</para>
  <para style="q" vid="ISA 35:2">fulasume arandarati lun bunaguaü kei Karümélu luma Sarón.</para>
  <para style="q" vid="ISA 35:2">Harihubei sun gürigia luéirigun Wabungiute.<verse eid="ISA 35:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 35:3" />Ru humá erei houn ha méreeñabaña,</para>
  <para style="q" vid="ISA 35:3">ru humá gurasu houn ha buchaañabaña uagu,<verse eid="ISA 35:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 35:4" />ariñaga humá houn ha hanufudebaña:</para>
  <para style="q" vid="ISA 35:4">«Ganigi humá, manufudeda humá!</para>
  <para style="q" vid="ISA 35:4">Anihán Hubungiute lun lesefurunün,</para>
  <para style="q" vid="ISA 35:4">labeichubaña háganiñu keisi hadüna!»<verse eid="ISA 35:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 35:5" />Ábameti haganbun ha maganbunbaña</para>
  <para style="q" vid="ISA 35:5">ariha hagíame ha marihinbaña;<verse eid="ISA 35:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 35:6" />hachubahaba ha méibugunbaña kei usari,</para>
  <para style="q" vid="ISA 35:6">hagúarahaba ha mariñagadibaña.</para>
  <para style="q" vid="ISA 35:6">Láwiyuhaba saragu duna lidan fulasu mageirawati, fulasu mábeiti.<verse eid="ISA 35:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 35:7" />Ábanbei lagunu fulasu mageirawati,</para>
  <para style="q" vid="ISA 35:7">labuinchuba múa mábeiti lau lísensen duna.</para>
  <para style="q" vid="ISA 35:7">Le ñein lubéi haganóua ounli áraabuna guentó,</para>
  <para style="q" vid="ISA 35:7">labouchuba maburu luma híduru dúnaruguna ñein.<verse eid="ISA 35:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 35:8" />Ñeinbei aban üma gíriti «émeri sagüráuti».</para>
  <para style="q" vid="ISA 35:8">Siñabei hásügürün ha wíyebaña luéigiñe;</para>
  <para style="q" vid="ISA 35:8">méibugun hagíame ha maganbadibaña luéigiñe.<verse eid="ISA 35:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 35:9" />Úabaña liñún ñein,</para>
  <para style="q" vid="ISA 35:9">mayarafadun hagíame animaalu gáñitiña ñeinhin.</para>
  <para style="q" vid="ISA 35:9">Luéigiñeba üma ligía hagiribuda ha esefurubaña,<verse eid="ISA 35:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 35:10" />ha agañeiha láañabaña Wabureme;</para>
  <para style="q" vid="ISA 35:10">hebeluruba uburugun Sión eremuheina lau ugundani,</para>
  <para style="q" vid="ISA 35:10">ani habagariduba gúndaañu súnwandan.</para>
  <para style="q" vid="ISA 35:10">Hadariruba ugundani luma ubunuruni,</para>
  <para style="q" vid="ISA 35:10">lagumuchaguba ayahuni luma igarigu.<verse eid="ISA 35:10" /></para>
  <chapter eid="ISA 35" />
  <chapter number="36" style="c" sid="ISA 36" />
  <para style="s1">Günringuaü le ladügübei Senakeríbü</para>
  <para style="r">(<ref loc="2KI 18:13-37">2 Uru 18.13-37</ref>; <ref loc="2CH 32:1-19">2 Kro 32.1-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 36:1" />Lidan irumu katorusu lidan larúeihan Esekíasi, aba lábürühan Senakeríbü, le lurúeite Asiria luagun sun luburugute Hudá le baríeiruabei, aba lárügüdüni. <verse eid="ISA 36:1" /><verse number="2" style="v" sid="ISA 36:2" />Aba lóunahan aban úfisi Lákisigiñe hau súdaragu lun houdin arihei urúei Esekíasi uburugu Herusalén, aba hararamun lurugabu lichanilin fusu le íñugiñebei, luagu üma le luágunbei áraabu le Achibaguagülei. <verse eid="ISA 36:2" /><verse number="3" style="v" sid="ISA 36:3" />Aba láfuridun Eliakímü le liráü Ilükíasi, le agumadihabei tidan palasiu habaroun; Sebüná le abürühabei; luma Hoá le liráü Asafü, lani urúei abürühati. <verse eid="ISA 36:3" /><verse number="4" style="v" sid="ISA 36:4" />Aba lariñagun úfisi Asiriana houn:</para>
  <para style="p" vid="ISA 36:4">—Ariñaga huméi uganu le lun Esekíasi lúmagiñe urúei wéiriguti le lurúeite Asiria: “Ka uagu luéirinbei bachoururagun bungua? <verse eid="ISA 36:4" /><verse number="5" style="v" sid="ISA 36:5" />Odi haritaguatibu luagu gebegitima lan dimurei buíduburiti kei lichú aau luma erei lun wuribu? Ka uagu bemenigida lun biñuragun bungua nuagun? <verse eid="ISA 36:5" /><verse number="6" style="v" sid="ISA 36:6" />Ariha numuti luagu hemenigi ban luagu lídehan Ehiptu. Ítara liña Ehiptu kei aban maburu fereeli, ánhabu abalacha luagu, límirubei búhabu. Ítara liña lóuserun urúei Ehiptuna hama sun ha hemenigibaña luagu. <verse eid="ISA 36:6" /><verse number="7" style="v" sid="ISA 36:7" />Ani ánhabu ariñaga nun: Luagu Wabureme le Wabungiute wemenigida, Ma funagia gidá lumuti Esekíasi fulasu burí le lánina óundaruni luma burí lani Bungiu ligía latarü, aba lariñagun houn lílana Hudá luma Herusalén lun luágurügü lan aban kultu hadüga óundaruni lun? <verse eid="ISA 36:7" /><verse number="8" style="v" sid="ISA 36:8" />Adügabá aban daradu luma nabureme le lurúeite Asiria: Níchuguba bián milu gabayu bun, ánhabu adarira kaba lan agalufehaña. <verse eid="ISA 36:8" /><verse number="9" style="v" sid="ISA 36:9" />Buguya, mabafutibu lun béibaaguagüdüni ni le ǘnabutimabei hadan úfisigu Asiriana, ani agurabatibu badarirun gabayu hama agalufehatiña Ehiptu? <verse eid="ISA 36:9" /><verse number="10" style="v" sid="ISA 36:10" />Bóugudin luéi lira, haritaguatibu luagu niábiña lan agünrinchaguei ageiraü le, ibidiñoun lun Wabureme Wabungiute guánarügü óunahabalina lun niabin agünrinchaguei!”<verse eid="ISA 36:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 36:11" />Aba hóunabuni Eliakímü, Sebüná luma Hoá, hariñaga lun:</para>
  <para style="p" vid="ISA 36:11">—Adügabá fulesei woun, badimureha woun lidan araméu, ladüga gunfuranda wamuti. Madimurehabá woun lidan ebüréu, ladüga haganbahaña sun gürigia ha luágubaña baríeiru.<verse eid="ISA 36:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 36:12" />Lariñaga úfisi Asiriana houn:</para>
  <para style="p" vid="ISA 36:12">—Mama lun babureme, ni hun lóunahana lurúeite Asiria ariñagei le. Houn gürigia ha luágubaña baríeiru, ladüga dandu hagía kei huguya, héigibei hídiga guánarügü gurá humeime hiñe guánarügü.<verse eid="ISA 36:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 36:13" />Ábati lararamun úfisi, aba lagúaragun ariñaga lidan ebüréu:</para>
  <para style="p" vid="ISA 36:13">—Aganba huméi le lariñagubei urúei wéiriguti, le lurúeite Asiria: <verse eid="ISA 36:13" /><verse number="14" style="v" sid="ISA 36:14" />“Mígiraguagüda humá hungua lun leyeedunün Esekíasi, siñaguabei lungua lun lesefurunün”. <verse eid="ISA 36:14" /><verse number="15" style="v" sid="ISA 36:15" />Anhein áluaha lagañeirunün lun hemenigidun luagu Bungiu, lariñaga hun: “Lesefurubadiwa Bungiu; mígirunbei lun lábürühan uburugu le labun lubafu lurúeite Asiria”, <verse eid="ISA 36:15" /><verse number="16" style="v" sid="ISA 36:16" />madüga humá gasu lau. Lóunahañadina lurúeite Asiria ariñaga hun, lun hígiraguagüdün hungua, gayara láamuga leigin kada aban hídangiñe lídangiñe le lalubahabei licharirugu, gurá ligíame duna lídangiñe luelun guánarügü. <verse eid="ISA 36:16" /><verse number="17" style="v" sid="ISA 36:17" />Lárigiñeme, ábame lanügünün lidoun aban ageiraü lenege hageira, ageiraü le ñein lumuti türigu luma beibei lun tadügün fein luma diwéin. <verse eid="ISA 36:17" /><verse number="18" style="v" sid="ISA 36:18" />Anhein ariñaga Esekíasi hun luagu lesefurubadün lan Bungiu, mígiraguagüda humá hungua lun leyeedunün. Sefu lumutiña funagia aban hádangiñe búngiugu ha habungiutegu lílana amu fulasu lumutuniña luéi lubafu lurúeite Asiria? <verse eid="ISA 36:18" /><verse number="19" style="v" sid="ISA 36:19" />Hagañagia lubungiutegu Amatü luma Arüpádü? Hagaña lubungiutegu Sefarüwaímü? Sefu hamuti funagia Samaria luéi lubafu Asiria? <verse eid="ISA 36:19" /><verse number="20" style="v" sid="ISA 36:20" />Ka hádangiñe sun búngiugu ha, esefurubaliña lumutuniña luéi lubafu lurúeite Asiria? Ka uagu haritagua luagu gayara lubéi lan Bungiu Herusalén esefura?<verse eid="ISA 36:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 36:21" />Aba herederun maniñu, móunabuntiña ni aban dimurei, ladüga ariñagaali buga urúei houn lun móunabun hamá. <verse eid="ISA 36:21" /><verse number="22" style="v" sid="ISA 36:22" />Ábati hírudagun Eliakímü, Sebüná luma Hoá, aba haheiridagunu hanaagun hawougua, aba houdin arihei Esekíasi lun habahüdaguni le lariñagubei úfisi Asiriana lun.<verse eid="ISA 36:22" /></para>
  <chapter eid="ISA 36" />
  <chapter number="37" style="c" sid="ISA 37" />
  <para style="s1">Lesefuruni Aburemei Hudá hawéi híwerutiña múa</para>
  <para style="r">(<ref loc="2KI 19:1-37">2 Uru 19.1-37</ref>; <ref loc="2CH 32:20-23">2 Kro 32.20-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 37:1" />Dan laganbunbalin urúei Esekíasi katei le, aba laheiridagunu ladaüragun luougua, aba ladaürün daüguaü súsutu arufudei ligarigu, aba lidin litenpulunrúgun Bungiu. <verse eid="ISA 37:1" /><verse number="2" style="v" sid="ISA 37:2" />Aba lóunahani Eliakímü le hábuti nadagimeintiña tidan palasiu, Sebüná, le abürühabei, hama fádirigu ha íñugutimabaña tau daüguaü súsutu arufudei hagarigu lumoun profeta Isaíasi, le liráü Amosu, <verse eid="ISA 37:2" /><verse number="3" style="v" sid="ISA 37:3" />lun hariñagun lun luéigiñe lóubadina urúei: «Láuñadiwa íruni uguñe, abeichúni luma anabawaguni, kei hamuga terederun aban würi méreuga lidan lóurate tágurahan. <verse eid="ISA 37:3" /><verse number="4" style="v" sid="ISA 37:4" />Aganbadügü láamugei Bubungiute le Babureme dimurei burí le lóunahabei lurúeite Asiria ariñaga lun, anabaguei Bungiu le wínwanbei, beigua láamugaña Bubungiute le Aburemei luagu burí katei le laganbubei. Adügabá lubeiti aban afurieidúni hawagu ha erederubaña».<verse eid="ISA 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 37:5" />Resibi lumuti Isaíasi uganu lúmagiñeti urúei Esekíasi <verse eid="ISA 37:5" /><verse number="6" style="v" sid="ISA 37:6" />ábati lóunahani óunabagülei le: «Lariñahare Wabureme: “Manufudedabá luéi dimurei le aubei hanabaguana eseriwidutiña lun urúei Asiriana. <verse eid="ISA 37:6" /><verse number="7" style="v" sid="ISA 37:7" />Aganbabá, nadügüba lun lachülürün aban uganu lun, le lunbei lagiribudagüdüni lageiroun, ábameti nadügün lun lounwen afarúarügü ñein” ».<verse eid="ISA 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 37:8" />Aba laganbun úfisi Asiriana luagu ñǘdünha lan buga urúei Asiriana uburugugiñe Lákisi. Ábati lidin Herusaléngiñe, aba ladariruni urúei Asiriana ageindagua luma Libüná. <verse eid="ISA 37:8" /><verse number="9" style="v" sid="ISA 37:9" />Ñein laganba urúei Asiriana luagu añate lan buga súdaragu Ehiptuna lábugiñe lagumadihan urúei Tirüháka awuribuha luma. Ábayati lóunahan urúei Asiriana ariñaga lun Esekíasi le lurúeite Hudá: <verse eid="ISA 37:9" /><verse number="10" style="v" sid="ISA 37:10" />«Bubungiute, le uágubei bafiñera, chouru lumuti bun luagu mábürühanbei lan Herusalén labun nubafu; gama lumoun mígiraguagüdaba bungua lun leyeedunibu. <verse eid="ISA 37:10" /><verse number="11" style="v" sid="ISA 37:11" />Aganba baali le hadügübei lurúeitegu Asiria lau sun burí ageiraü le hagünrinchagubei. Buguyadigiameti esefura? <verse eid="ISA 37:11" /><verse number="12" style="v" sid="ISA 37:12" />Sefu hamuti funagia búngiugu líbiri fulasu le hagünrinchagubei nagüchagu: Gosán, Arán, Résefü, hama gürigia lílana Betü-edén ha meha aganóubaña Telasárü? <verse eid="ISA 37:12" /><verse number="13" style="v" sid="ISA 37:13" />Hagañagia lurúeitegu Amatü, Arüpádü, Sefarüwaímü Ená hama lurúeitegu Iwá?»<verse eid="ISA 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 37:14" />Aba lárügüdünu Esekíasi gárada to hederegeruboun óunagüleigu lun, aba laliihanu. Lárigiñe aba lidin ténpulurugu, aba látuleragunu gárada tuguya ligibugiñe Bungiu, <verse eid="ISA 37:14" /><verse number="15" style="v" sid="ISA 37:15" />aba lafurieidun, ítara:<verse eid="ISA 37:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 37:16" />—Wabureme Suntigabafu, Lubungiute Ísüraeli, buguya le gámabalin lálana barúeihan hawagu kátaña garünatiña, buguyarügüñein Bungiu le Lubungiute sun arúeihani ubouagu buguya adügübalin sielu luma ubóu. <verse eid="ISA 37:16" /><verse number="17" style="v" sid="ISA 37:17" />Ruba arigei Wabureme, aganbabá. Fegebei bagu Bungiu, arihabá. Aganbabéi dimurei le lóunahabei Senakeríbü ariñaga nun, dimurei burí le anabagutibu, buguya le Bungiu wínwanti. <verse eid="ISA 37:17" /><verse number="18" style="v" sid="ISA 37:18" />Inarüni luagu günringua hamaña lan lurúeitegu Asiria gürigia lau sun hageira, <verse eid="ISA 37:18" /><verse number="19" style="v" sid="ISA 37:19" />ani gudá hamaña lan habungiutegu, ladüga lidan linarün katei, mama búngiugu hagía, kátaña burí láutiña wewe o dübü ha ladüga wügüri. Ligía hagünrinchagunbaliña. <verse eid="ISA 37:19" /><verse number="20" style="v" sid="ISA 37:20" />Guentó lubeiti Wabungiute, sefubáwa luéi habafu, subudi hamaamugei sun gürigia ubouagu luagu buguyarügüñein lan Bungiu.<verse eid="ISA 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 37:21" />Ábati lóunahan Isaíasi ariñaga lun Esekíasi: «Lariñahare Bungiu le Lubungiute Ísüraeli: Aganba naali afurieiduni le badügübei nun libügürü Senakeríbü le lurúeite Asiria».<verse eid="ISA 37:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 37:22" />Anihán burí dimurei le lariñagubei Bungiu libügürü lurúeite Asiria:</para>
  <para style="b" vid="ISA 37:22" />
  <para style="q" vid="ISA 37:22">«Senakeríbü, éherahati uburugu Sión bau</para>
  <para style="q" vid="ISA 37:22">kei téherahan aban nibureingiru,</para>
  <para style="q" vid="ISA 37:22">ánhinha lumuti Herusalén lichügü adaagua bula bau</para>
  <para style="q" vid="ISA 37:22">dan le badisedun.<verse eid="ISA 37:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 37:23" />Kagia bóuseragubei, kagia banabubei?</para>
  <para style="q" vid="ISA 37:23">Ka un biñurei bumala luma barihin lau anaaguni unguaü?</para>
  <para style="q" vid="ISA 37:23">Lun Bungiu le sándubei le Lubungiute Ísüraeli!<verse eid="ISA 37:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 37:24" />Anaba bumuti Bungiu hayumulugugiñe bani úfisigu.</para>
  <para style="q" vid="ISA 37:24">Aba bariñagun:</para>
  <para style="q" vid="ISA 37:24">“Múdeitina tau nikarün to gíbeboun</para>
  <para style="q" vid="ISA 37:24">to lánina wuribu lábulugun wübü,</para>
  <para style="q" vid="ISA 37:24">luagu liñun-agei Líwanu.</para>
  <para style="q" vid="ISA 37:24">Áchuaha numuti limiginagun-agei lani hibúari,</para>
  <para style="q" vid="ISA 37:24">luma gudi le burí buídutimabei ñein.</para>
  <para style="q" vid="ISA 37:24">Chülütina luagun liñun-agei</para>
  <para style="q" vid="ISA 37:24">luma luagun burí dabíara le lenegebei fuluri-agei.<verse eid="ISA 37:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 37:25" />Chigatina burí fusu lidan fulasu terencha,</para>
  <para style="q" vid="ISA 37:25">aba natun duna lídangiñe, mábeigüda numuti</para>
  <para style="q" vid="ISA 37:25">sun lidunari Ehiptu lau lábugiñe nugudi”.<verse eid="ISA 37:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 37:26" />Gama lumoun ibidiñeti yebe bun luagu au lan le Aburemei</para>
  <para style="q" vid="ISA 37:26">aranserubei lun ítara luba lan sun katei le?</para>
  <para style="q" vid="ISA 37:26">Lúmagiñe binarü naranseha lun</para>
  <para style="q" vid="ISA 37:26">ítara luba lan, guentó suseregüdaná;</para>
  <para style="q" vid="ISA 37:26">ligía bagünrinchagunbei burí uburugu derebuguti,</para>
  <para style="q" vid="ISA 37:26">aba bagumuchaguagüdüni.<verse eid="ISA 37:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 37:27" />Ha burí lílana, mabafutiña,</para>
  <para style="q" vid="ISA 37:27">buin lau anufudei luma busiganu,</para>
  <para style="q" vid="ISA 37:27">ítara haña kei híduru áraabu,</para>
  <para style="q" vid="ISA 37:27">kei sagadi ñǘgili,</para>
  <para style="q" vid="ISA 37:27">kei híduru le áhüchüti tábulugu muna</para>
  <para style="q" vid="ISA 37:27">aba láguduni garabali le suedi.<verse eid="ISA 37:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 37:28" />Subudi numuti sun bánhingichun;</para>
  <para style="q" vid="ISA 37:28">subudi numuti luagu iyereegu nan bun.<verse eid="ISA 37:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 37:29" />Ani kei subudi nubalin biyereehabu luma banaagun bungua,</para>
  <para style="q" vid="ISA 37:29">níchiga aban bángüli luagu bígiri,</para>
  <para style="q" vid="ISA 37:29">luma aban furenu luagu biyuma,</para>
  <para style="q" vid="ISA 37:29">ábame nagiribudagüdünibu luéigiñe üma le ñéingiñe lubéi biabin».<verse eid="ISA 37:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="ISA 37:30" />Ábati lariñagun Isaíasi lun Esekíasi:</para>
  <para style="q" vid="ISA 37:30">«Anihánba liseinin le lunbei lasuseredun:</para>
  <para style="q" vid="ISA 37:30">Irumu le, luma leweñegua irumu</para>
  <para style="q" vid="ISA 37:30">héigibei türigu le áhüchübei lungua,</para>
  <para style="q" vid="ISA 37:30">gama lumoun lídanme lǘrüwan irumu,</para>
  <para style="q" vid="ISA 37:30">gayaraabei hábunagun alubaha huguyame,</para>
  <para style="q" vid="ISA 37:30">gayaraabei hábunagun beibei lun heigin tídangiñe tin.<verse eid="ISA 37:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="ISA 37:31" />Ítara haba ha erederubaña hádangiñe lílana Hudá kei nadü;</para>
  <para style="q" vid="ISA 37:31">háhüchaguba ábame hagindun;<verse eid="ISA 37:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="ISA 37:32" />Ladüga ñéinbaña erederutiña Herusalén;</para>
  <para style="q" vid="ISA 37:32">ñéinbaña móunweguntiña luagu wübü Sión.</para>
  <para style="q" vid="ISA 37:32">Lanarimeba línsiñehabu Bungiu Suntigabafu adügei le.<verse eid="ISA 37:32" /></para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" sid="ISA 37:33" />Lariñahare Bungiu libügürü lurúeite Asiria:</para>
  <para style="q" vid="ISA 37:33">“Mebelubei uburugun Herusalén,</para>
  <para style="q" vid="ISA 37:33">machüübei ni aban gimara luagun uburugu,</para>
  <para style="q" vid="ISA 37:33">mageindagunbei luma lau idaüdinaü lauti gürabu,</para>
  <para style="q" vid="ISA 37:33">móundarun ligíame múa geyegua lau baríeiru lauti dübü,</para>
  <para style="q" vid="ISA 37:33">lun lawarirun agünrinchaguei uburugu.<verse eid="ISA 37:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="ISA 37:34" />Luéigiñememe üma le ñéingiñe lubéi liabin,</para>
  <para style="q" vid="ISA 37:34">ñéingiñeba lagiribuda;</para>
  <para style="q" vid="ISA 37:34">mebelubei lidoun uburugu le.</para>
  <para style="q" vid="ISA 37:34">Aburemei ariñagubalin.<verse eid="ISA 37:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="ISA 37:35" />Nóunigirubei uburugu le, ani nesefurubei,</para>
  <para style="q" vid="ISA 37:35">luagu nínsiñehabu lun nubúein Dawidi</para>
  <para style="q" vid="ISA 37:35">luma nínsiñehabu núniwagua” ».<verse eid="ISA 37:35" /></para>
  <para style="b" />
  <para style="p">
    <verse number="36" style="v" sid="ISA 37:36" />Aba lidin lani Bungiu ánheli, aba láfaragun san gádürü wein seingü milu wügüriña tídangiñe hakianpun-agei Asiriana. Laruganbei yebe hilaguaaña súngubei. <verse eid="ISA 37:36" /><verse number="37" style="v" sid="ISA 37:37" />Ábati labudunu Senakeríbü le lurúeite Asiria kianpu-agei, aba lagiribudun uburugun Níniwe. <verse eid="ISA 37:37" /><verse number="38" style="v" sid="ISA 37:38" />Luagu aban weyu dan le láhuduraguña lubéi tidan litenpulun Nisüróku le lubungiute, aba hayabin Adüramélekü luma Sareserü ha lirahüñü aba háfaruni, aba hanurahan lóubawagun Ararátü. Aba larúeihan Esaradón le liráü leweñegua.<verse eid="ISA 37:38" /></para>
  <chapter eid="ISA 37" />
  <chapter number="38" style="c" sid="ISA 38" />
  <para style="s1">Lasandirun luma lareidagun Esekíasi</para>
  <para style="r">(<ref loc="2KI 20:1-11">2 Uru 20.1-11</ref>; <ref loc="2CH 32:24-26">2 Kro 32.24-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 38:1" />Lidoun dan ligía, aba lábürühan Esekíasi lau aban óunwenbu sandi, aba lidin Isaíasi le liráü Amosu arihei, aba lariñagun lun:</para>
  <para style="p" vid="ISA 38:1">—Lariñahare Bungiu: «Ariñagabéi lagumuhóun le lunbei bariñaguni houn biduheñu, ladüga bounwe, mareidagunhadibu».<verse eid="ISA 38:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 38:2" />Aba lagararaagun Esekíasi lau ligibu luagun touba muna, aba lafurieidun lun Bungiu, lariñaga:<verse eid="ISA 38:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 38:3" />—Ayumuraguatina bun, Aburemei, lun baritagun luagu ligaburi neseriwidun bun lau úaraguni luma arumani adügei le aubei bagundaara. Aba layahuahan lau igarigu.<verse eid="ISA 38:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 38:4" />Aba lariñagun Wabureme lun Isaíasi <verse eid="ISA 38:4" /><verse number="5" style="v" sid="ISA 38:5" />lun lidin ariñaga lun Esekíasi:</para>
  <para style="p" vid="ISA 38:5">—Lariñaga Wabureme le Lubungiute badügawagun Dawidi: “Aganba naali bayumuragun ani ariha naali báguira. Níchiga keinsi irumu lanwoun bibagari. <verse eid="ISA 38:5" /><verse number="6" style="v" sid="ISA 38:6" />Buguya lau sun Herusalén, nesefurubadün luéi lurúeite Asiria. Nóunigirubei uburugu le”.<verse eid="ISA 38:6" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 38:21" />Aba lañoundaguagüdün Isaíasi igu aba tafadarún luagu lisandi urúei, aba lareidagun. <verse eid="ISA 38:21" /><verse number="22" style="v" sid="ISA 38:22" />Ábati lálügüdüni Esekíasi Isaíasi, lariñaga lun:</para>
  <para style="p" vid="ISA 38:22">—Kábagia seini nibiha luagu gayaraabei lan nidin litenpulunrúgun Bungiu?<note caller="2" style="f"><char style="fr" closed="false">38.22 </char><char style="ft" closed="false">Bérusu 21-22 barüwarügüti ñahoun, según 2 Uru 20.7-8.</char></note><verse eid="ISA 38:22" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 38:7" />Lariñaga Isaíasi lun:</para>
  <para style="p" vid="ISA 38:7">—Anihán seini le lunbei líchuguni Bungiu bun lun larufuduni bun luagu lagunfulirubei lan le lariñagubei: <verse eid="ISA 38:7" /><verse number="8" style="v" sid="ISA 38:8" />Nadügüba lun lagiribudun lamuñan weyu le awanselibei diisi esütépu lidan luachin Aasi.</para>
  <para style="p" vid="ISA 38:8">Aba lasuseredun Ítara.<verse eid="ISA 38:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 38:9" />Dan le lareidagunbei urúei Esekíasi lídangiñe lisandi, aba ladügüni Sálumu le:<verse eid="ISA 38:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 38:10" />Nariñaga yebe núnguarügü:</para>
  <para style="q" vid="ISA 38:10">Nounwe lidan lubuidun-agei nibagari,</para>
  <para style="q" vid="ISA 38:10">rúaali dimurei nun lun nidin lidoun larúeihan óunweni lun sun dan.<verse eid="ISA 38:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 38:11" />Nariñaga núnguarügü:</para>
  <para style="q" vid="ISA 38:11">Marihindigia naali Bungiu ya ubouagu,</para>
  <para style="q" vid="ISA 38:11">marihindigiaadina ni aban hádangiñe ha aganóubaña ubouagu.<verse eid="ISA 38:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 38:12" />Günrinwagua nirumun, gidawa nuéi,</para>
  <para style="q" vid="ISA 38:12">kei hakianpun hóuniri mudún.</para>
  <para style="q" vid="ISA 38:12">Ítara liña buga nibagari kei ligamisan</para>
  <para style="q" vid="ISA 38:12">aban adaaguti gamisa to ibugúboun.</para>
  <para style="q" vid="ISA 38:12">Súfurigüda bumutina áriebu wéyuagu.<verse eid="ISA 38:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 38:13" />Agúarahatina lau gáriti sun áriebu,</para>
  <para style="q" vid="ISA 38:13">kamá hamuga anihán aban liñún áhalahei nabu.</para>
  <para style="q" vid="ISA 38:13">Súfurigüda bumutina áriebu wéyuagu.<verse eid="ISA 38:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 38:14" />Amumehatina hámaru kei dugurue,</para>
  <para style="q" vid="ISA 38:14">áünhatina kei unhun.</para>
  <para style="q" vid="ISA 38:14">Buchati luagu nagu aríagua sielun.</para>
  <para style="q" vid="ISA 38:14">Bungiu, hénrengungati nun, óunababa nuéigiñe!<verse eid="ISA 38:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 38:15" />Gama lumoun kábagia niyara ariñaga lun,</para>
  <para style="q" vid="ISA 38:15">anhein ligía lubéi adügübalin?</para>
  <para style="q" vid="ISA 38:15">Madabuhali nagu ladüga tirun nuani.<verse eid="ISA 38:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="ISA 38:16" />Habagariduba ha lóunigirubaña Bungiu,</para>
  <para style="q" vid="ISA 38:16">ani nabagariduba hama sun hagía.</para>
  <para style="q" vid="ISA 38:16">Rúhadibu átuadi nun,</para>
  <para style="q" vid="ISA 38:16">águyugüda baali nibagari nun.<verse eid="ISA 38:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 38:17" />Guentó, leweñegua íruni, darangilatina.</para>
  <para style="q" vid="ISA 38:17">Areida baali nibagari luéi huyu lánina günringuaü,</para>
  <para style="q" vid="ISA 38:17">lugundun feruduna baali sun nifigoun.<verse eid="ISA 38:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 38:18" />Siñati heremuhan ha lídanbaña umúahaü bun,</para>
  <para style="q" vid="ISA 38:18">siñati híchugun hilaaña uéiriguni bun,</para>
  <para style="q" vid="ISA 38:18">ha ararirubaña lidoun hamúaha</para>
  <para style="q" vid="ISA 38:18">siñati hagurabuni bigunfulin.<verse eid="ISA 38:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 38:19" />Hárügüñanu wínwanbaña gayara heremuhan bun,</para>
  <para style="q" vid="ISA 38:19">kei nadügüni uguñe.</para>
  <para style="q" vid="ISA 38:19">Adimurehatiña agübürigu houn hasaanigu luagu bigunfulin.<verse eid="ISA 38:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 38:20" />Anihein Bungiu ya lun lesefurunina.</para>
  <para style="q" vid="ISA 38:20">Daün wamóun wani árüpa,</para>
  <para style="q" vid="ISA 38:20">weremuha sagü weyu litenpulunrugu Bungiu.<verse eid="ISA 38:20" /></para>
  <chapter eid="ISA 38" />
  <chapter number="39" style="c" sid="ISA 39" />
  <para style="s1">Leresibiruniña Esekíasi óunagülei Babilóniana</para>
  <para style="r">(<ref loc="2KI 20:12-19">2 Uru 20.12-19</ref>; <ref loc="2CH 32:27-31">2 Kro 32.27-31</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 39:1" />Lidoun dan ligía, aba laganbun Merodákü-baladán le liráü Baladán, le lurúeite Babilónia luagu sándiñahañein lan Esekíasi gama lumoun areidaguaali lan, aba lóunahan lóunagülegu tau gárada luma aban idewesei lun. <verse eid="ISA 39:1" /><verse number="2" style="v" sid="ISA 39:2" />Aba lagundaarun Esekíasi lau hachülürün óunagüleigu, aba larufuduni lirisin houn, pülata luma golu, ibiñein, agülei fínuti luma le ñein tubéi burí lárumate luma sun le lúbiñebei. Úati ni kata tidan lani palasiu luma lidan sun larúeihan lun marufudun lani houn. <verse eid="ISA 39:2" /><verse number="3" style="v" sid="ISA 39:3" />Ábati lidin profeta Isaíasi arihei urúei Esekíasi, aba lálügüdüni:</para>
  <para style="p" vid="ISA 39:3">—Halíagiñe hayabin wügüriña ha, ka hariñagubei bun?</para>
  <para style="p" vid="ISA 39:3">Lariñaga Esekíasi lun:</para>
  <para style="p" vid="ISA 39:3">—Lídangiñe aban fulasu díseti hayabin; Babilóniagiñe.<verse eid="ISA 39:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 39:4" />Lariñaga Isaíasi lun:</para>
  <para style="p" vid="ISA 39:4">—Kagia harihubei tidan bani palasiu?</para>
  <para style="p" vid="ISA 39:4">Lariñaga Esekíasi lun:</para>
  <para style="p" vid="ISA 39:4">—Ariha hamuti sun le ñeinbei, úati ni kata lídangiñe le areidañu nubéi lun marufudun nani houn.<verse eid="ISA 39:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 39:5" />Ábati lariñagun Isaíasi lun Esekíasi: Aganbabéi uganu le, lúmagiñeti Bungiu Suntigabafu:<verse eid="ISA 39:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 39:6" />—Lachülürüba dan lun lanügǘn sun le tídanbei bani palasiu luma sun le hóundarubei bagüchagu chülǘ lumoun weyu le uguñebei Babilónioun. Meredebei ni kata ya. <verse eid="ISA 39:6" /><verse number="7" style="v" sid="ISA 39:7" />Ñéinbaña giñe hádangiñe badügawagun anügǘtiña Babilónioun, hasafunrúba, ábame herederun kei musu tidan lani urúei palasiu.<verse eid="ISA 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 39:8" />Laritaguati Esekíasi luagu lidan lan lidaani libagari, ñeinbei lan darangilaü, aba lariñagun lun Isaíasi:</para>
  <para style="p" vid="ISA 39:8">—Fuleseihabúti uganu le banügübei nun luéigiñe lóubadina Bungiu.<verse eid="ISA 39:8" /></para>
  <chapter eid="ISA 39" />
  <chapter number="40" style="c" sid="ISA 40" />
  <para style="ms">II. Libiaman Fánreinti: Lámalihoun Ísüraeli</para>
  <para style="mr">(<ref loc="ISA 40-55">40—55</ref>)</para>
  <para style="s1">Lámalihani Wabureme Herusalén</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 40:1" />Ítara liña lariñagun Wabungiute:</para>
  <para style="q" vid="ISA 40:1">«Ámaliha humaña numutuniña;<verse eid="ISA 40:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 40:2" />hadimureha tidoun lanigi Herusalén,</para>
  <para style="q" vid="ISA 40:2">ariñaga humá lun luagu mámaali lan idamuni,</para>
  <para style="q" vid="ISA 40:2">luagu fáyeihali lan luagu lidurun,</para>
  <para style="q" vid="ISA 40:2">luagu resibihali lan dóbuli núhaburugugiñe luagu lifigoun».<verse eid="ISA 40:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 40:3" />Aganbúati aban umalali,</para>
  <para style="q" vid="ISA 40:3">lidan fulasu mageirawati, lariñaga:</para>
  <para style="q" vid="ISA 40:3">«Aranse humá aban üma lubá Aburemei lidan fulasu mageirawati,</para>
  <para style="q" vid="ISA 40:3">adüga humá aban émeri lubá Wabungiute lidan fulasu mabuidunti.<verse eid="ISA 40:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 40:4" />Achagaha huméi sun fulasu wayati,</para>
  <para style="q" vid="ISA 40:4">rarigüda huméi sun wübü luma liñun-agei fulasu;</para>
  <para style="q" vid="ISA 40:4">úaraguagüda huméi fulasu le múaranbei,</para>
  <para style="q" vid="ISA 40:4">surugüda humeime fulasu le segebei.<verse eid="ISA 40:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 40:5" />Ábameti larufuduni Aburemei luéirigun,</para>
  <para style="q" vid="ISA 40:5">ábame harihini sun gürigia.</para>
  <para style="q" vid="ISA 40:5">Aburemei guánarügü ariñagubalin».<verse eid="ISA 40:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 40:6" />Lariñaga aban umalali: «Wáguaba»,</para>
  <para style="q" vid="ISA 40:6">nariñaga: «Kábagia nagúaragua?»</para>
  <para style="q" vid="ISA 40:6">Luagu ítara haña lan sun gürigia kei híduru,</para>
  <para style="q" vid="ISA 40:6">liabin here kei aban fuluri áraabuna.<verse eid="ISA 40:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 40:7" />Aba lásaürün híduru,</para>
  <para style="q" vid="ISA 40:7">aban lounwen fuluri dan le láfurun Aburemei luagun.</para>
  <para style="q" vid="ISA 40:7">Lidan linarün katei, ítara haña gürigia kei híduru.<verse eid="ISA 40:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 40:8" />Saüti híduru, hilá ligía fuluri,</para>
  <para style="q" vid="ISA 40:8">ánheinti Lererun Wabureme rédeiti lun súnwandan.<verse eid="ISA 40:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 40:9" />Múdeiba Sión lábulugun aban wübü,</para>
  <para style="q" vid="ISA 40:9">iñurabéi bumalali here lun bíchugun aban uganu buiti.</para>
  <para style="q" vid="ISA 40:9">Iñurabéi bumala manufudeuga, Herusalén,</para>
  <para style="q" vid="ISA 40:9">ariñagabá lun burí luburugute Hudá:</para>
  <para style="q" vid="ISA 40:9">«Anihán Hubungiute!»<verse eid="ISA 40:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 40:10" />Anitebei Aburemei lau óunwenbu ubafu,</para>
  <para style="q" vid="ISA 40:10">lun líchuguni sun katei kei labusenruni lau lere larüna.</para>
  <para style="q" vid="ISA 40:10">Añatebaña lumutuniña luma lárigiñe lesefuruniña.<verse eid="ISA 40:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 40:11" />Liabin kei aban hóuniri mudún le óunigirutiña lánigu;</para>
  <para style="q" vid="ISA 40:11">budá lumutiña harahüñü mudún larünarugu,</para>
  <para style="q" vid="ISA 40:11">aba lanügüniña laniguagu</para>
  <para style="q" vid="ISA 40:11">teni ligía houn ha sun líñabei hemeilihóun.<verse eid="ISA 40:11" /></para>
  <para style="s1">Luéirigun Lubungiute Ísüraeli</para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 40:12" />Ka amisurahabalin barana lau lurageirugu lúhabu?</para>
  <para style="q" vid="ISA 40:12">Ka abahüdübalin lidabuberen sielu lau lifinga lúhabu?</para>
  <para style="q" vid="ISA 40:12">Ka amisurahabalin sun kaliki le múarugubei?</para>
  <para style="q" vid="ISA 40:12">Ka amisurahabalin wübü luma burí áraabu lidan aban balansu?<verse eid="ISA 40:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 40:13" />Ka eweridihabalin Aburemei, odi ka arufudahabei lun?<verse eid="ISA 40:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 40:14" />Ka íchugubei eweridihani luma gunfurandaü lun?</para>
  <para style="q" vid="ISA 40:14">Ka arufudahabei lun, lun laguseragüdün lau úarani?</para>
  <para style="q" vid="ISA 40:14">Ka arufudahabei subudi lun?</para>
  <para style="q" vid="ISA 40:14">Ka íchugubei arufudahani luáguti lichú aau lun?<verse eid="ISA 40:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 40:15" />Ítara haña gürigia lun kei aban lédederun duna,</para>
  <para style="q" vid="ISA 40:15">kei aban lagu kaliki lidan balansu;</para>
  <para style="q" vid="ISA 40:15">ítara liña ageiraü burí le baranahabei lun kei aban lagu sagoun.<verse eid="ISA 40:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 40:16" />Lóuguatiña sun animaalugu ha Líwanurugubaña</para>
  <para style="q" vid="ISA 40:16">lun ladügǘn aban adagaragüdüni gudawarügüti lun,</para>
  <para style="q" vid="ISA 40:16">lougua watu le ñeinbei lun watu gemeti.<verse eid="ISA 40:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 40:17" />Ni kata sun néchanigu ligibugiñe Aburemei;</para>
  <para style="q" vid="ISA 40:17">mebegitiña ni murusun ligibugiñe.<verse eid="ISA 40:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 40:18" />Kaba umoun harihei lúaragun Wabungiute?</para>
  <para style="q" vid="ISA 40:18">Kaba au iyawaü harufudei?<verse eid="ISA 40:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="ISA 40:19" />Adügati aban gadiñeti aban guáriua,</para>
  <para style="q" vid="ISA 40:19">aba lafuraruni aban gawadigimaridaditi golu lau golu</para>
  <para style="q" vid="ISA 40:19">ru ligía iñari lauti pülata luagu.<verse eid="ISA 40:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 40:20" />Le adügüti aban guáriua,</para>
  <para style="q" vid="ISA 40:20">anúadahati wewe le lunbei mañaladun lan,</para>
  <para style="q" vid="ISA 40:20">áluga ligía aban buiti gadiñeti</para>
  <para style="q" vid="ISA 40:20">lun lederebudagüdüni lun méiguadun lan.<verse eid="ISA 40:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="ISA 40:21" />Ibidiñeñahati funagia hun?</para>
  <para style="q" vid="ISA 40:21">Maganbunñahagidün funagia lariñawagún?</para>
  <para style="q" vid="ISA 40:21">Mabahüdawagunti funagia hun lúmagiñe furumiñeti dan?</para>
  <para style="q" vid="ISA 40:21">Úagili funagia gunfuranda humani lúmagiñe ladügǘn ubóu?<verse eid="ISA 40:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 40:22" />Ligibuaguñein ubóu lala Wabungiute le lálana larúeihan,</para>
  <para style="q" vid="ISA 40:22">larihiniña gürigia ñéingiñe kamá hamuga chagagaru.</para>
  <para style="q" vid="ISA 40:22">Tulé lumuti sielu kamá hamuga aban fubulíña,</para>
  <para style="q" vid="ISA 40:22">tulegua lumuti kei aban kianpu.<verse eid="ISA 40:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 40:23" />Adüga lumutiña gürigia wéirigutiña ni kátame,</para>
  <para style="q" vid="ISA 40:23">gumuguagüdalaña ábutigu ubouagu.<verse eid="ISA 40:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 40:24" />Ítara haña kei nadü ñǘbürigili le sun liña labunún,</para>
  <para style="q" vid="ISA 40:24">le lagumeseruña lílagüle árügüda múarugu.</para>
  <para style="q" vid="ISA 40:24">Anhein áfura Bungiu hawagun, aba hásaürün,</para>
  <para style="q" vid="ISA 40:24">aba lanügüniña herigini kei sagadi sáühali.<verse eid="ISA 40:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="ISA 40:25" />Lariñahare Bungiu le sándubei:</para>
  <para style="q" vid="ISA 40:25">Kaba uma hóuchaguana?</para>
  <para style="q" vid="ISA 40:25">Ka gayaraabei ítara lan kei au?<verse eid="ISA 40:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 40:26" />Iñura huméi hagu sielun, ariha huméi,</para>
  <para style="q" vid="ISA 40:26">Kagia adügübalin sun le?</para>
  <para style="q" vid="ISA 40:26">Le afanreinhabarun aban aban,</para>
  <para style="q" vid="ISA 40:26">wa ligía houn súngubei lau hiri.</para>
  <para style="q" vid="ISA 40:26">Wéiriti lubafu luma lere,</para>
  <para style="q" vid="ISA 40:26">memegeirunti ni aban hádangiñe.<verse eid="ISA 40:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="ISA 40:27" />Ísüraeli, luburugute Hakobu, ka uagu bamumeha?</para>
  <para style="q" vid="ISA 40:27">Ka uagu bariñaga: «Mefenti Aburemei luagu gádantina;</para>
  <para style="q" vid="ISA 40:27">meberesenti Bungiu nau?»<verse eid="ISA 40:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 40:28" />Ibidiñeti funagia bun? Maganbun bágili funagia?</para>
  <para style="q" vid="ISA 40:28">Aburemei, Bungiu le magumuchaditi, le adügübalin sun ubóu,</para>
  <para style="q" vid="ISA 40:28">mabuchadaditi luagu, magumuchadi ligía lichú lau.<verse eid="ISA 40:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 40:29" />Ruti erei lun le buchaalibei uagu,</para>
  <para style="q" vid="ISA 40:29">ru ligía lanwoun lere le uánimabei.<verse eid="ISA 40:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="ISA 40:30" />Gayaraati labuchadun hawagu nibureintiña,</para>
  <para style="q" vid="ISA 40:30">íbini ha héretimabaña ábürühatiña,<verse eid="ISA 40:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="ISA 40:31" />gama lumoun ha hemenigibaña luagu Aburemei,</para>
  <para style="q" vid="ISA 40:31">súnwandan hibihuba lan iseri erei,</para>
  <para style="q" vid="ISA 40:31">gayaraabei háhamahan kei ágila;</para>
  <para style="q" vid="ISA 40:31">gayaraabei héibaagun gama lumoun mabuchabei hawagu,</para>
  <para style="q" vid="ISA 40:31">gayaraabei héibugun ani gaguraasunmémebaña.<verse eid="ISA 40:31" /></para>
  <chapter eid="ISA 40" />
  <chapter number="41" style="c" sid="ISA 41" />
  <para style="s1">Füramase lani Wabungiute lesefurun Ísüraeli</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 41:1" />«Maní humá nigibugiñe huguya ha aganóutiña ubouhu,</para>
  <para style="q" vid="ISA 41:1">ragǘ humá anigi néchanigu,</para>
  <para style="q" vid="ISA 41:1">higougu, ayanuha wamaamuga libügürü katei le;</para>
  <para style="q" vid="ISA 41:1">wóundaragua lun wayanuhan luagu.<verse eid="ISA 41:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ISA 41:2" />«Ka achülaaguagüdübalin urúei le súnwandanbei lagañeirun</para>
  <para style="q" vid="ISA 41:2">luéigiñe oubaü le ñéingiñe lubéi laboucha weyu?</para>
  <para style="q" vid="ISA 41:2">Ka ederegerubaliña néchanigu lun,</para>
  <para style="q" vid="ISA 41:2">adüga ligía lun hǘnabudun urúeigu ligibugiñe,</para>
  <para style="q" vid="ISA 41:2">lun lǘnhürüniña tau lefeinte luma tau ligimaran,</para>
  <para style="q" vid="ISA 41:2">chagagualaña kei sagadi sáühali?<verse eid="ISA 41:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 41:3" />Ka adügübei lun léibaahaniña,</para>
  <para style="q" vid="ISA 41:3">lun lawanserun darangilu</para>
  <para style="q" vid="ISA 41:3">kamá hamuga madagati lugudi múarugu?<verse eid="ISA 41:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 41:4" />Kagia adügübalin wadagimanu le?</para>
  <para style="q" vid="ISA 41:4">Ka agúarubei houn gürigia lúmagiñe lagumeserun?</para>
  <para style="q" vid="ISA 41:4">Au adügübalin, au le Aburemei, Bungiu le ábanrügüti,</para>
  <para style="q" vid="ISA 41:4">le furumiñeti ani lagumuhóun».<verse eid="ISA 41:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 41:5" />Ariha hamuti lílana ubouhu aba habuinchun lau anufudei;</para>
  <para style="q" vid="ISA 41:5">aba lánhingichun ubóu lúmagiñe aba lígirugu lumoun le aban,</para>
  <para style="q" vid="ISA 41:5">hayarafaduña, añatén.<verse eid="ISA 41:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 41:6" />Kada gadiñeti íderagua lumuti lupaaná ru ligía gurasu lun.<verse eid="ISA 41:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 41:7" />Le adaagubei guáriua ruti gurasu lun awadigimariduti golu;</para>
  <para style="q" vid="ISA 41:7">le ádaragubei lau marüdiyu ruti gurasu lun le</para>
  <para style="q" vid="ISA 41:7">ádühabei gürabu,</para>
  <para style="q" vid="ISA 41:7">aba lariñaguni anhein buidu lubéi wadagimanu,</para>
  <para style="q" vid="ISA 41:7">lárigiñe aba ládaraguni guáriua lau gürabu lun mánhingichun lan.<verse eid="ISA 41:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 41:8" />«Aganbabána Ísüraeli, lílana Hakobu, eseriwiduti nun le nanúadirubei,</para>
  <para style="q" vid="ISA 41:8">gürigia ladügawagun numada Abüraámü.<verse eid="ISA 41:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 41:9" />Au asagarubalibu lígirugugiñe ubóu,</para>
  <para style="q" vid="ISA 41:9">au agúarubei bun lídangiñe lidise-agei larigeirugu ubóu,</para>
  <para style="q" vid="ISA 41:9">aba nariñagun bun: “Eseriwiduti nun buguya”</para>
  <para style="q" vid="ISA 41:9">au anúadirubalibu, mígirun nágidibu.<verse eid="ISA 41:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 41:10" />Manufudedabá, ladüga anahein buma;</para>
  <para style="q" vid="ISA 41:10">manufudedabá au Bubungiutebei.</para>
  <para style="q" vid="ISA 41:10">Rútina erei bun, íderagua numutibu,</para>
  <para style="q" vid="ISA 41:10">ágüdaha numutibu lau núhabu le gagañeiradibei.<verse eid="ISA 41:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ISA 41:11" />Sun ha iyereehabúbaña bun,</para>
  <para style="q" vid="ISA 41:11">hanügüba busiganu, ǘnabugu hagíame;</para>
  <para style="q" vid="ISA 41:11">hagumuchuba ha ageindagubaña buma.<verse eid="ISA 41:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 41:12" />Báluahabaña báganiñu, madaribubaña;</para>
  <para style="q" vid="ISA 41:12">ha awuribuhabaña buma,</para>
  <para style="q" vid="ISA 41:12">kamaame úatiña ubouagu.<verse eid="ISA 41:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 41:13" />Lugundun au le Bubungiute, ragǘ naali búhabu;</para>
  <para style="q" vid="ISA 41:13">ani ariñagaadina bun: “Manufudedabá, íderagua numutibu” ».<verse eid="ISA 41:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 41:14" />Ariñagati Bungiu: Manufudedabá Ísüraeli;</para>
  <para style="q" vid="ISA 41:14">lau sun biñüraü luma buánima íderagua numutibu.</para>
  <para style="q" vid="ISA 41:14">Au le Lubungiute Ísüraeli le Sándubei,</para>
  <para style="q" vid="ISA 41:14">au besefuragülebei.<verse eid="ISA 41:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 41:15" />Nadügübadibu ábanme éfereegülei iseri lau ari héreti;</para>
  <para style="q" vid="ISA 41:15">béferehabei burí wübü, badügübei kalikime,</para>
  <para style="q" vid="ISA 41:15">badügübei burí dabíara sagadime sáühali.<verse eid="ISA 41:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 41:16" />Bachagarubei ábame lanügüni garabali;</para>
  <para style="q" vid="ISA 41:16">lachagaragubei herigini.</para>
  <para style="q" vid="ISA 41:16">Ábameti bagundaaragun lau Bungiu,</para>
  <para style="q" vid="ISA 41:16">pántabadibu lau Bungiu le Sándubei Lubungiute Ísüraeli.<verse eid="ISA 41:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 41:17" />«Áluahatiña gürigia gudemetiña duna, madaritiña.</para>
  <para style="q" vid="ISA 41:17">Mábeiha hañeñe ladüga hamagürabu;</para>
  <para style="q" vid="ISA 41:17">gama lumoun au, le Aburemei, neteniruba houn,</para>
  <para style="q" vid="ISA 41:17">mígirun nubaña au le Lubungiute Ísüraeli.<verse eid="ISA 41:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 41:18" />Nasaliraguagüdüba duna luagu burí wübü le ñein lumuti málouga lan</para>
  <para style="q" vid="ISA 41:18">luma lísensen duna labadinagua fulasu wayati;</para>
  <para style="q" vid="ISA 41:18">nadügübei fulasu mageirawati lagunume</para>
  <para style="q" vid="ISA 41:18">nasaliraguagüdüba lirahüñü duna éibaaguati lidan fulasu mábeiti.<verse eid="ISA 41:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 41:19" />Nábunaguba hibúari lidan fulasu mageirawati,</para>
  <para style="q" vid="ISA 41:19">akasia, arayán luma oliwu;</para>
  <para style="q" vid="ISA 41:19">náhüchagüdüba lídibu gudi lidan múa mábeiti</para>
  <para style="q" vid="ISA 41:19">luma abetu luma sipürési,<verse eid="ISA 41:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 41:20" />Lun harihin sun gürigia, subudi hagíame,</para>
  <para style="q" vid="ISA 41:20">gunfuranda hamaamuga luagu au lan le Aburemei adügübalin le lau nubafu,</para>
  <para style="q" vid="ISA 41:20">luagu au lan le Aburemei sánduti,</para>
  <para style="q" vid="ISA 41:20">le Lubungiute Ísüraeli adügübalin».<verse eid="ISA 41:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 41:21" />Lariñahare Bungiu le lurúeite Ísüraeli:</para>
  <para style="q" vid="ISA 41:21">«Higougu guáriuagu hageindagua huéigiñegua.<verse eid="ISA 41:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 41:22" />Higougu hariñagei le lunbei lasuseredun woun</para>
  <para style="q" vid="ISA 41:22">luma ariñagei le sügühalibei, ábame waganbunün;</para>
  <para style="q" vid="ISA 41:22">ariñaga huméi katei le burí lunbei liabin woun,</para>
  <para style="q" vid="ISA 41:22">ariha wamaamugei kaba lan idan lagumucha;<verse eid="ISA 41:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 41:23" />ariñaga huméi woun kaba lan asusereda lárigiñe,</para>
  <para style="q" vid="ISA 41:23">arufuda huméi woun luagu búngiugu humá le tímatimaati.</para>
  <para style="q" vid="ISA 41:23">Adüga huméi le hiyaraati, buiti wuribati,</para>
  <para style="q" vid="ISA 41:23">somu katei le íchuguti anufudei woun.<verse eid="ISA 41:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 41:24" />Gama lumoun ni kata huguya ani siñati hadügün ni kata!</para>
  <para style="q" vid="ISA 41:24">Íñarawaguati le anúadahabalün.<verse eid="ISA 41:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="ISA 41:25" />«Saliguagüdatina aban wügüri luéigiñe oubaü le ñéingiñe lubéi laboucha weyu;</para>
  <para style="q" vid="ISA 41:25">wáhadina lun lau liri, anitén luéigiñe nuru.</para>
  <para style="q" vid="ISA 41:25">Dügügua lumutiña gumadimatiña kei ladügürawagun múa;</para>
  <para style="q" vid="ISA 41:25">kei dan le lañoundaguni nadagimeinti múa lau lugudi.<verse eid="ISA 41:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 41:26" />Ka íchugubei uganu luagu le lúmagiñe lagumeserun lun wasubudirubei lan?</para>
  <para style="q" vid="ISA 41:26">Ka ariñagubei lúmagiñe binarü luagu lasusereduba lan,</para>
  <para style="q" vid="ISA 41:26">lun wánharuba lan luagu richá lan?</para>
  <para style="q" vid="ISA 41:26">Míchugun lumuti ni aban hídangiñe uganu</para>
  <para style="q" vid="ISA 41:26">úati ni aban aganbuti hariñagun ni aban dimurei.<verse eid="ISA 41:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 41:27" />Au ariñagubalin lun Sión lúmagiñe lagumeserun,</para>
  <para style="q" vid="ISA 41:27">au óunahabei aban nóunagüle Herusalén</para>
  <para style="q" vid="ISA 41:27">lun lariñagun luagu málühaña lan lílana ánhaña giribu.<verse eid="ISA 41:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 41:28" />Marihintina lachülaagun ni aban hádangiñe ha híbiri búngiugu;</para>
  <para style="q" vid="ISA 41:28">ni aban le gayaraati leweridihan,</para>
  <para style="q" vid="ISA 41:28">ni aban le óunabuti nálügüdahan.<verse eid="ISA 41:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 41:29" />Ni kata sun hagía! Siñati hadügün ni kata;</para>
  <para style="q" vid="ISA 41:29">búngiugu málatiña hagía.<verse eid="ISA 41:29" /></para>
  <chapter eid="ISA 41" />
  <chapter number="42" style="c" sid="ISA 42" />
  <para style="s1">Eseriwiduti lun Aburemei</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 42:1" />«Anihán nubúein le nágüdahabei,</para>
  <para style="q" vid="ISA 42:1">le nanúadirubei le aubei nagundaara.</para>
  <para style="q" vid="ISA 42:1">Ru naali nani sífiri lidoun lun lanügün irichaü lun sun néchani.<verse eid="ISA 42:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 42:2" />Magúaragunbei, miñurun lubéi lumala,</para>
  <para style="q" vid="ISA 42:2">maganbagüdün lubéi lumalali ǘmadarugu,<verse eid="ISA 42:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 42:3" />Máhalachagun lubéi maburu le halamémeelibei,</para>
  <para style="q" vid="ISA 42:3">méñeguchunleime lanpu le ñegumémeelibei.</para>
  <para style="q" vid="ISA 42:3">Lanügübei irichaü le tímatimaati.<verse eid="ISA 42:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 42:4" />Memeraagunbei meferidirunme luguraasun,</para>
  <para style="q" vid="ISA 42:4">darime deregüda laali irichaü ubouagu.</para>
  <para style="q" vid="ISA 42:4">Aranseñu haba lílana burí ubouhu lun haganbuni larufudahan».<verse eid="ISA 42:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 42:5" />Lariñaga Bungiu, le adügübalin sielu ani tulegualei,</para>
  <para style="q" vid="ISA 42:5">le adügübalin múa luma sun le áhüchübei lidan,</para>
  <para style="q" vid="ISA 42:5">le íchugubei ibagari houn ha nibagaribaña</para>
  <para style="q" vid="ISA 42:5">lariñahare lun lubúein:<verse eid="ISA 42:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 42:6" />«Au, le Aburemei agúarubei bun,</para>
  <para style="q" vid="ISA 42:6">aba nárügüdüni búhabu,</para>
  <para style="q" vid="ISA 42:6">aba nadügünibu lun lébunabadibu lan esefuruni;</para>
  <para style="q" vid="ISA 42:6">au adügübalibu, lugundun busentina lun</para>
  <para style="q" vid="ISA 42:6">buguyaba lan liseinin nidaradun hama nánigu,</para>
  <para style="q" vid="ISA 42:6">lanpu houn néchanigu.<verse eid="ISA 42:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 42:7" />Busentina lun barihagüdün marihintiña,</para>
  <para style="q" vid="ISA 42:7">lun basagaruniña adaürǘtiña furisunrugúgiñe,</para>
  <para style="q" vid="ISA 42:7">le ñein lubéi haganóua lidan luburiga.<verse eid="ISA 42:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 42:8" />Au Aburemeibei, ligía níribei,</para>
  <para style="q" vid="ISA 42:8">ani mígirunbadina lun lichugún nuéirigun lun amu,</para>
  <para style="q" vid="ISA 42:8">ni lun híchugun inebesei houn guáriuagu, luéidigia nun.<verse eid="ISA 42:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 42:9" />Ariha humá lagunfulirun le meha uágubei nariñaga furumiñe,</para>
  <para style="q" vid="ISA 42:9">guentó nariñaga iseri burí katei.</para>
  <para style="q" vid="ISA 42:9">Nasubudiragüdüñein hun lubaragiñe lasuseredun».<verse eid="ISA 42:9" /></para>
  <para style="s1">Uremu luagu lesefuhan Bungiu</para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 42:10" />Heremuha aban uremu iseri lun Aburemei;</para>
  <para style="q" vid="ISA 42:10">heremuha lun lídangiñe lidise-agei ubóu</para>
  <para style="q" vid="ISA 42:10">sun ha áfayahabaña baranaha</para>
  <para style="q" vid="ISA 42:10">hama animaalugu ha aganóubaña baranaha,</para>
  <para style="q" vid="ISA 42:10">hama ha burí aganóubaña lidan burí ubouhu.<verse eid="ISA 42:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 42:11" />Gundaagualá fulasu mageirawati luma burí luburugute</para>
  <para style="q" vid="ISA 42:11">tuma burí hakianpun lani Kedarü türibu.</para>
  <para style="q" vid="ISA 42:11">Heremuha lílana Selá lau ugundani;</para>
  <para style="q" vid="ISA 42:11">iñura haméi hamala lábulugugiñe burí wübü.<verse eid="ISA 42:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 42:12" />Ru hamá uéiriguni lun Bungiu</para>
  <para style="q" vid="ISA 42:12">eremuha hagíame lun lidan burí ageiraü le luágubei ubouhu.<verse eid="ISA 42:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 42:13" />Láfuriduba Bungiu kei aban ganigiti</para>
  <para style="q" vid="ISA 42:13">ábame lageindagun lau igañi keisi aban wuriburuguna;</para>
  <para style="q" vid="ISA 42:13">liñurubei lumala ábame lagúaragun lun lageindawagun,</para>
  <para style="q" vid="ISA 42:13">ábame láfaraguniña láganiñu.<verse eid="ISA 42:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 42:14" />Lariñahare Bungiu:</para>
  <para style="q" vid="ISA 42:14">«Rédeihadina maniñu luagu saragu dan,</para>
  <para style="q" vid="ISA 42:14">manitina, ragüguatina nungua;</para>
  <para style="q" vid="ISA 42:14">gama lumoun guentó, nagúaragua kei würi águrahatu</para>
  <para style="q" vid="ISA 42:14">áünheina, awaragueina.<verse eid="ISA 42:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 42:15" />Nagünrinchaguaali sun áraabu luma sun wübü</para>
  <para style="q" vid="ISA 42:15">násaüragüdaali sun nadü le lídanbei.</para>
  <para style="q" vid="ISA 42:15">Namabeidagüdaali sun duna éibaaguati luma sun lagunu.<verse eid="ISA 42:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 42:16" />Nanügübaña marihintiña lídangiñe üma le ibidiñeñahati houn.</para>
  <para style="q" vid="ISA 42:16">Nasaliraguagüdübei luburiga larugounganme hagibugiñe</para>
  <para style="q" vid="ISA 42:16">úaraguagüdaneime burí fulasu múaragunti.</para>
  <para style="q" vid="ISA 42:16">Chóuruti luagu nadügübei lan burí katei le.<verse eid="ISA 42:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 42:17" />Ha afiñebaña hawagu guáriuagu,</para>
  <para style="q" vid="ISA 42:17">ha ariñagubaña houn guáriuagu:</para>
  <para style="q" vid="ISA 42:17">“huguya wabungiutegubaña”,</para>
  <para style="q" vid="ISA 42:17">hadiseduba lau busiganu.<verse eid="ISA 42:17" /></para>
  <para style="s1">Marihini luagu Ísüraeli</para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 42:18" />«Aganba humá, huguya le maganbunbei;</para>
  <para style="q" vid="ISA 42:18">ariha humá, huguya le marihinbei.<verse eid="ISA 42:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 42:19" />Úati marihinti, maganbun ligía kei nubúein le nóunagüle,</para>
  <para style="q" vid="ISA 42:19">ua ligía marihinti, maganbun ligía kei nóunagüle, le lubúein Bungiu.<verse eid="ISA 42:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 42:20" />Arihaali saragu katei gama lumoun meteniti lun;</para>
  <para style="q" vid="ISA 42:20">gayaraati laganbun gama lumoun maganbunti ni kata».<verse eid="ISA 42:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 42:21" />Aburemei, ladüga aban lan Bungiu le esefuhati,</para>
  <para style="q" vid="ISA 42:21">hóuchati yebe lun wéirigu lan larufudahan;<verse eid="ISA 42:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 42:22" />Gama lumoun íweruhouatiña gürigia ha, asagarahóua hagía,</para>
  <para style="q" vid="ISA 42:22">ábürügüda hamaña sun hagía furisunrugun,</para>
  <para style="q" vid="ISA 42:22">dáwaaña tidoun furisun tótima asufuriragülei;</para>
  <para style="q" vid="ISA 42:22">barüwaguaaña, ani úati kaba lan esefuraña;</para>
  <para style="q" vid="ISA 42:22">íweruhouatiña, ani úati kaba lan asagaraña.<verse eid="ISA 42:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="ISA 42:23" />Gama lumoun ka hídangiñe adügübei gasu lau le?</para>
  <para style="q" vid="ISA 42:23">Ka aranseñubei lun laganbuni le lunbei lasuseredun?<verse eid="ISA 42:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 42:24" />Kagia ígirubei lun hagañeirun</para>
  <para style="q" vid="ISA 42:24">luma lun híweruhoun lánigu Hakobu?</para>
  <para style="q" vid="ISA 42:24">Ma Bungiu?</para>
  <para style="q" vid="ISA 42:24">Afigouhatiña ligibugiñe,</para>
  <para style="q" vid="ISA 42:24">máhatiña héibugun lidan üma le larufudubei houn,</para>
  <para style="q" vid="ISA 42:24">maganbadi hagía lun larufudahan.<verse eid="ISA 42:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 42:25" />Ligía lagañidunbei hama aba labeichaguniña,</para>
  <para style="q" vid="ISA 42:25">lau aban wuribu le aduranguagüdübaliña lidan ligemeri watu gemeti;</para>
  <para style="q" vid="ISA 42:25">gama lumoun ni ítara máhatiña gunfuranda hamá.<verse eid="ISA 42:25" /></para>
  <chapter eid="ISA 42" />
  <chapter number="43" style="c" sid="ISA 43" />
  <para style="s1">Aburemeirügüñein esefuha</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 43:1" />Gama lumoun guentó, Ísüraeli, lumutuniña Hakobu,</para>
  <para style="q" vid="ISA 43:1">lariñahare Bungiu le adügübalün hun:</para>
  <para style="q" vid="ISA 43:1">«Manufudeda humá sefu naadün;</para>
  <para style="q" vid="ISA 43:1">wátina hun lau hiri, nani huguya.<verse eid="ISA 43:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 43:2" />Danme básügürün dúnarugugiñe, búmabadina,</para>
  <para style="q" vid="ISA 43:2">danme bánhiñuragun duna éibaaguati, mañaradagunbadibu;</para>
  <para style="q" vid="ISA 43:2">danme básügürün lídangiñe watu gemeti; mágudunbadibu,</para>
  <para style="q" vid="ISA 43:2">megemebei watu buagu.<verse eid="ISA 43:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 43:3" />Ladüga au Baburemebei, au Besefuragülebei,</para>
  <para style="q" vid="ISA 43:3">Bungiu le Sándubei le Lubungiute Ísüraeli.</para>
  <para style="q" vid="ISA 43:3">Agañeiha náadibu;</para>
  <para style="q" vid="ISA 43:3">ru naali Ehiptu, Etiopía, luma Sabá</para>
  <para style="q" vid="ISA 43:3">lebegime nagañeihanibu.<verse eid="ISA 43:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 43:4" />Ladüga bínsiñe nun,</para>
  <para style="q" vid="ISA 43:4">wéiriti bebegi ani hínsiñetibu nun.</para>
  <para style="q" vid="ISA 43:4">Deregetina wügüriña hama néchanigu</para>
  <para style="q" vid="ISA 43:4">lun numa ban luma lun nesefuruni bibagari.<verse eid="ISA 43:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 43:5" />Manufudedabá, ladüga anahein buma.</para>
  <para style="b" vid="ISA 43:5" />
  <para style="q" vid="ISA 43:5">«Nagúaruba houn bánigu lídangiñe oubaü le ñéingiñe lubéi laboucha weyu</para>
  <para style="q" vid="ISA 43:5">luma le ñeinhin lubéi lálüda lun nóundaraguniña».<verse eid="ISA 43:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 43:6" />Nariñaguba lun nórute: “Águyugüdabaña”,</para>
  <para style="q" vid="ISA 43:6">ariñaga aume lun suru: “Merederabá hau.</para>
  <para style="q" vid="ISA 43:6">Barübaña nisaanigu dísegiñe lígirugugiñe ubóu,<verse eid="ISA 43:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 43:7" />sun ha anügübalin niri,</para>
  <para style="q" vid="ISA 43:7">ha nadügübaña lun híchugun uéiriguni nun”.<verse eid="ISA 43:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 43:8" />«Ñǘbuingüda humaña numutuniña,</para>
  <para style="q" vid="ISA 43:8">ha gágubaña gama lumoun marihintiña,</para>
  <para style="q" vid="ISA 43:8">garigeirugu hagía gama lumoun maganbuntiña.<verse eid="ISA 43:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 43:9" />Óundaraguala sun ageiraü,</para>
  <para style="q" vid="ISA 43:9">dungua hamá sun néchanigu.</para>
  <para style="q" vid="ISA 43:9">Kagia hádangiñe ariñagubalin le lubaragiñe lasuseredun?</para>
  <para style="q" vid="ISA 43:9">Kagia adimurehabei luagu le sügühalibei?</para>
  <para style="q" vid="ISA 43:9">Barǘ hamá gefentiña, arufuda haméi luagu richá hamá,</para>
  <para style="q" vid="ISA 43:9">aganbúa láamuga, ariñawagúa ligíame luagu inarüni lan».<verse eid="ISA 43:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 43:10" />Lariñahare Bungiu:</para>
  <para style="q" vid="ISA 43:10">«Huguya nánibei gefentiña,</para>
  <para style="q" vid="ISA 43:10">huguya eseriwidubaña nun, ha nanúadirubaña</para>
  <para style="q" vid="ISA 43:10">lun hasubudirunina, afiñe huguyame nuagu,</para>
  <para style="q" vid="ISA 43:10">gunfuranda humeime kátana lan.</para>
  <para style="q" vid="ISA 43:10">Úagubeiñein ni aban bungiu nubaragiñe,</para>
  <para style="q" vid="ISA 43:10">ani úabei giñe nárigiñe.<verse eid="ISA 43:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 43:11" />Áurügüñein Bungiu;</para>
  <para style="q" vid="ISA 43:11">úati ni aban gayaraati lesefuhan, nuéidigia».<verse eid="ISA 43:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 43:12" />Lariñahare Bungiu:</para>
  <para style="q" vid="ISA 43:12">«Au anügübalin uganu: au esefurubalün;</para>
  <para style="q" vid="ISA 43:12">mama aban bungiu terencha adügübalin, gefentün luagu.<verse eid="ISA 43:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 43:13" />Bungiu au lúmagiñe súnwandan</para>
  <para style="q" vid="ISA 43:13">úati gayaraati lesefuhan núhaburugugiñe</para>
  <para style="q" vid="ISA 43:13">Siñati lagünrinchaguni ni aban le nadügübei».<verse eid="ISA 43:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 43:14" />Lariñahare Bungiu le Sándubei le Lubungiute Ísüraeli, le esefurubaliña:</para>
  <para style="q" vid="ISA 43:14">«Lun nesefurunün, nóunahaba gürigia Babilónia,</para>
  <para style="q" vid="ISA 43:14">ábame nánhunrenchagüdüni sun bena,</para>
  <para style="q" vid="ISA 43:14">ábame lagarabaagun hagundan Kalüdéana lun igarigume.<verse eid="ISA 43:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 43:15" />Au Aburemeibei, le adügübalin Ísüraeli,</para>
  <para style="q" vid="ISA 43:15">au Búngiubei le Sándubei le hurúeite».<verse eid="ISA 43:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="ISA 43:16" />Darati Aburemei aban üma baranahagiñe,</para>
  <para style="q" vid="ISA 43:16">aban üma labadinaguagiñe lérouga;<verse eid="ISA 43:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 43:17" />aba ladügün lun háfuridun súdaragu tau burí hakarün</para>
  <para style="q" vid="ISA 43:17">hama hagabayun lun lagünrinchaguniña.</para>
  <para style="q" vid="ISA 43:17">Aba hábürühan siñá hásaarun,</para>
  <para style="q" vid="ISA 43:17">aba hagumuchun kei téñeguchun mecha.<verse eid="ISA 43:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 43:18" />Guentoti, lariñahare Bungiu houn lánigu:</para>
  <para style="q" vid="ISA 43:18">«Maritagua humá luagu wurinouga,</para>
  <para style="q" vid="ISA 43:18">masaminara humá luagu le sügühalibei.<verse eid="ISA 43:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 43:19" />Nadüga aban katei iseri,</para>
  <para style="q" vid="ISA 43:19">ani hariha luagu lasusereda lan reiti guentó.</para>
  <para style="q" vid="ISA 43:19">Nadaara aban üma lidan fulasu mageirawati,</para>
  <para style="q" vid="ISA 43:19">luma duna éibaaguati lidan múa marandarunti.<verse eid="ISA 43:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 43:20" />Híchuguba animaalugu áraabuna,</para>
  <para style="q" vid="ISA 43:20">hama awesüturusu hama ounli áraabuna uéiriguni nun,</para>
  <para style="q" vid="ISA 43:20">luagu nasaliraguagüdün duna lidan fulasu mageirawati,</para>
  <para style="q" vid="ISA 43:20">luma duna éibaaguati lidan múa marandarunti,</para>
  <para style="q" vid="ISA 43:20">lun hatun numutuniña ha nanúadirubaña,<verse eid="ISA 43:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 43:21" />gürigia ha nadügübaña lun heremuhan nuagu.<verse eid="ISA 43:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="ISA 43:22" />«Gama lumoun buguya, Ísüraeli, lumutuniña Hakobu</para>
  <para style="q" vid="ISA 43:22">magúahantibu nun, bucharügüti buagu nubá.<verse eid="ISA 43:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 43:23" />Madagaragüdüntibu mudún nun,</para>
  <para style="q" vid="ISA 43:23">míchutibu uéiriguni nun lau badagaragüdün.</para>
  <para style="q" vid="ISA 43:23">Au mabuchadagüdüntina buagu amuriaha idewesei buma,</para>
  <para style="q" vid="ISA 43:23">mamuriahan au kupali buma.<verse eid="ISA 43:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 43:24" />Magañeihantibu maburu hémeti lun banügüni nun keisi idewesei,</para>
  <para style="q" vid="ISA 43:24">mamuriahan au buma lun banügün hagüle animaalugu adagarawagüdütiña nun.</para>
  <para style="q" vid="ISA 43:24">Buchagüdarügütibu nuagu lau burí bifigoun;</para>
  <para style="q" vid="ISA 43:24">gáñigüda bumutina lau burí bisalufurin.<verse eid="ISA 43:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 43:25" />«Gama lumoun au, ladüga Bubungiute nan bulíei numuti bumabuchahan,</para>
  <para style="q" vid="ISA 43:25">ani maritagunbadina luagu bifigoun<verse eid="ISA 43:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 43:26" />Anhein anihein lubéi nadüga bun le mínsiñeti bun,</para>
  <para style="q" vid="ISA 43:26">barǘ waméi ligibugiñoun aguseragüdüti.</para>
  <para style="q" vid="ISA 43:26">Ariñagabéi le lunbei bariñaguni,</para>
  <para style="q" vid="ISA 43:26">arihúa láamuga anhein madurun bubéi.<verse eid="ISA 43:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 43:27" />Afigouhati furumiñeti badügawagun,</para>
  <para style="q" vid="ISA 43:27">garabaguatiña bumaisturungu nuagun;<verse eid="ISA 43:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 43:28" />wíyeda hamutu gumadimatiña nitenpulun;</para>
  <para style="q" vid="ISA 43:28">ligía nígirunbei lun hagünrinchawagun Ísüraelina</para>
  <para style="q" vid="ISA 43:28">ha lánigu Hakobu, anabúa hagía».<verse eid="ISA 43:28" /></para>
  <chapter eid="ISA 43" />
  <chapter number="44" style="c" sid="ISA 44" />
  <para style="s1">Ligunfulin Aburemei, Bungiu le ábanrügüti</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 44:1" />«Aganbabána guentó Ísüraeli, lumutuniña Hakobu,</para>
  <para style="q" vid="ISA 44:1">nánigu, gürigia ha nanúadirubaña.<verse eid="ISA 44:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 44:2" />Au Aburemeibei, le adügübalibu lúmagiñe lubaragiñe bágurahoun,</para>
  <para style="q" vid="ISA 44:2">ani íderaguanabu.</para>
  <para style="q" vid="ISA 44:2">Manufudedabá Hakobu,</para>
  <para style="q" vid="ISA 44:2">ni buguya Hesurún, nubúein, le nanúadirubei,<verse eid="ISA 44:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 44:3" />lugundun nadüga lun léibaagun duna lidan fulasu mageirawati,</para>
  <para style="q" vid="ISA 44:3">lirahüñü duna lidan fulasu mábeiti.</para>
  <para style="q" vid="ISA 44:3">Níchuguba iseri ibagari houn badügawagun,</para>
  <para style="q" vid="ISA 44:3">nóunahabei nabinirun hawagun.<verse eid="ISA 44:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 44:4" />Haweinamuduba kei híduru le túaguati</para>
  <para style="q" vid="ISA 44:4">kei álamu laru duna.<verse eid="ISA 44:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 44:5" />Lariñaguba aban luougua: “Lani Bungiu au”,</para>
  <para style="q" vid="ISA 44:5">lariñagame amu, ladügawagun Hakobu au,</para>
  <para style="q" vid="ISA 44:5">ñeinbei abürüdüti luagu lúhabu:</para>
  <para style="q" vid="ISA 44:5">“Lumegen Bungiu”</para>
  <para style="q" vid="ISA 44:5">ábame líchuguni liri Ísüraeli lánwounme liri».<verse eid="ISA 44:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 44:6" />Lariñahare Bungiu, le lurúeite le lesefuha Ísüraeli,</para>
  <para style="q" vid="ISA 44:6">Bungiu le Suntigabafu:</para>
  <para style="q" vid="ISA 44:6">«Au furumiñetibei, au agumuhóuni,</para>
  <para style="q" vid="ISA 44:6">úati amu Bungiu bóugudi nuéi.<verse eid="ISA 44:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 44:7" />Káteigia ítarabei kei au? Layanuha, ariñagaléi nun.</para>
  <para style="q" vid="ISA 44:7">Ka ariñagubalin lúmagiñe binarü le lunbei liabin,</para>
  <para style="q" vid="ISA 44:7">ariñagaléi le lunbei lasuseredun?<verse eid="ISA 44:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 44:8" />Gama lumoun, gaguraasun humá, manufudeda humá!</para>
  <para style="q" vid="ISA 44:8">Ítara liña nariñaguni lúmagiñe binarü,</para>
  <para style="q" vid="ISA 44:8">ani huguya nánibei gefentiña.</para>
  <para style="q" vid="ISA 44:8">Anihein funagia amu bungiu nuéi?</para>
  <para style="q" vid="ISA 44:8">Úati amu aramudaguagülei;</para>
  <para style="q" vid="ISA 44:8">úati ni aban nasubudirun».<verse eid="ISA 44:8" /></para>
  <para style="s1">Luáguti láhudurawaguniwa houn guáriuagu</para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 44:9" />Ni kata sun ha adaagubaña búngiugu. Móunitiña giñe búngiugu ha únbaña híchiga inebesei lun ni kata. Ha adügübaña kultu houn, marihintiña ani ibidiouguati hau, ligía wuribabei lubéi lidin houn. <verse eid="ISA 44:9" /><verse number="10" style="v" sid="ISA 44:10" />Le adügüti aban guáriua lun láhuduragun tun, anügoun kei lubungiute, leferidiruñein lidaani. <verse eid="ISA 44:10" /><verse number="11" style="v" sid="ISA 44:11" />Wuribabei lidin houn sun ha áhuduragubaña tun. Wügüriña adaagubaña guáriuagu. Lun hamuga hayabin sun hagía lun haguserun, heferidiruña hamuga aba hamuga habuinchun lau anufudei.<verse eid="ISA 44:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 44:12" />Anihán katei le ladügübei nadagimeinti gürabu: Aba lárügüdüni lichichilin, lásurun lásüdagüdüni gürabu lidan leñegura watu, aba líchaagun marüdiyu luagu lun lasalirun kei labusenruni. Aba luadigimarini lau lere larüna, gama lumoun anhein alamacha, aba lagumuchun lere, anhein amagürabuda, aba labuchadun luagu.<verse eid="ISA 44:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 44:13" />Anihán le ladügübei le adaagubei guáriua: Aba lamisurahan lau lamisuraagüle aba láfiuruni le lunbei ladügüni lau lápisi luma konpasi, aba luadigimarini tau chíchili; ítara liña ladügün aban guáriua lenege gürigia, lárigiñe aba líchuguni tidoun aban ténpulu.<verse eid="ISA 44:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 44:14" />Añahein, aba hábunagun hibúari, aba laweinamudagüdüni huya; lárigiñe aba gayaraahali lan háchuahani. Odi anhein gudi lubéi labusenrubei odi róbüle lan, aba lóunigiruni wewe burí ligía dabíararugu darí laweinamudun, garana ligía. <verse eid="ISA 44:14" /><verse number="15" style="v" sid="ISA 44:15" />Lárigiñe lachugún, aba hóuseruni gürigia líbiri lun hébeduni hálememe; líbiri lun habacharagun; líbiri lun hásürahan fein; líbiri lun hadügün liyawa aban bungiu, aba habuluchagun íchiga inebesei lun.<verse eid="ISA 44:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 44:16" />Añahein giñe, aba hádaruni lamidan wewe ligía wáturugun, aba hásürahan úi, aba héigini, aba hakimuledun. Bachaguatiña giñe lau, aba hariñagun: «Lubuidun lerederun larügürügü watu ma; wagumesera abacharagua!» <verse eid="ISA 44:16" /><verse number="17" style="v" sid="ISA 44:17" />Lauti lígiragun wewe, aba hadügün liyawa aban bungiu, aba habuluchagun ligibugiñe lun híchugun inebesei lun, aba hayumuragun lun, hariñaga: «Sefubáwa, ladüga buguya wabungiutebei!»<verse eid="ISA 44:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 44:18" />Ibidiouguati hau gürigia hagía, úati gunfuranda hamá; wéiriti darugu lan hagu darí lun siñá lan harihin, darugu liña lau hasaminan darí lun siñá lan gunfuranda hamá. <verse eid="ISA 44:18" /><verse number="19" style="v" sid="ISA 44:19" />Masaminaruntiña, mégeitiña gunfurandaü lun gayara lan hariñagun: «Be wamuti lamidan wewe, aba wásürahan fein lau leñegura, ásüraha wagía úi aba wéigini; lau líbiri wewe ligía wadügei lagübüri katei le. Murusun wewe unbei níchiga inebesei!» <verse eid="ISA 44:19" /><verse number="20" style="v" sid="ISA 44:20" />Lidan linarün katei, ítara liña kei leigín baligi. Wígiraguagüdüña woungua lun weyeedún lau burí katei málati. Siñabei hesefurun gürigia hagía. Úabei gunfuranda hamá luagu iyeeni lan le háhaburugubei.<verse eid="ISA 44:20" /></para>
  <para style="s1">Bungiu Lesefuragülebei Ísüraeli</para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 44:21" />«Ísüraeli, lumutuniña Hakobu,</para>
  <para style="q" vid="ISA 44:21">haritagua humá luagu nubúeingu lan sun huguya;</para>
  <para style="q" vid="ISA 44:21">au adügübalün, Ísüraelina, mabulieida humana.<verse eid="ISA 44:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 44:22" />Gumuguagüda naali hidurun luma hifigoun,</para>
  <para style="q" vid="ISA 44:22">kei lagumuchagun dúeri.</para>
  <para style="q" vid="ISA 44:22">Giribu humá nun, ladüga au esefurubalün».<verse eid="ISA 44:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="ISA 44:23" />Sielu, wáguaba lau ugundani luagu le ladügübei Bungiu!</para>
  <para style="q" vid="ISA 44:23">Gudungu burí le ubouagubei, hagúaraha lau ugundani!</para>
  <para style="q" vid="ISA 44:23">Áraabu burí luma dabíara lau burí sun lídibu wewe,</para>
  <para style="q" vid="ISA 44:23">hagúaraha lau ugundani,</para>
  <para style="q" vid="ISA 44:23">ladüga arufuda laali Bungiu luéirigun,</para>
  <para style="q" vid="ISA 44:23">lau lesefuruniña Ísüraelina, ha lumutuniña Hakobu!<verse eid="ISA 44:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="ISA 44:24" />Lariñahare Bungiu le esefurubalibu,</para>
  <para style="q" vid="ISA 44:24">le adügübalibu lúmagiñe lubaragiñe bágurahoun:</para>
  <para style="q" vid="ISA 44:24">«Au Aburemeibei le adügübalin sun katei,</para>
  <para style="q" vid="ISA 44:24">au átulerubalin sielu, derebugugüdanei múa,</para>
  <para style="q" vid="ISA 44:24">míderagunga lana ni aban.<verse eid="ISA 44:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 44:25" />Mígiruntina lun lagunfulirun le hariñagubei profetagu yéetiña;</para>
  <para style="q" vid="ISA 44:25">adügatina lun heferidiruni garíaahatiña hachügü.</para>
  <para style="q" vid="ISA 44:25">Adügatina lun hasigenehan chu tau hámagua</para>
  <para style="q" vid="ISA 44:25">luma lun liabin hasubudin libidiouniganme aau.<verse eid="ISA 44:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 44:26" />Gama lumoun adügatina lun lagunfulirun hererun nubúeingu</para>
  <para style="q" vid="ISA 44:26">luma lun buidu lan lasalirun haransehan ha nóunahabaña.</para>
  <para style="q" vid="ISA 44:26">Nariñahare luagu haganóuayaba lan gürigia Herusalén,</para>
  <para style="q" vid="ISA 44:26">luagu lararamayaba lan burí luburugute Hudá.</para>
  <para style="q" vid="ISA 44:26">Nadügüba lun hásaarun lídangiñe hagünrinchawagun.<verse eid="ISA 44:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 44:27" />Gayaraati níchugun lúrudu lun lamabeidun barana</para>
  <para style="q" vid="ISA 44:27">luma lun lerederun duna éibaaguati mábeiñu.<verse eid="ISA 44:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 44:28" />Ariñagatina lun Siru: “Buguya nánibei hóuniri mudún,</para>
  <para style="q" vid="ISA 44:28">badügübei sun le nabusenrun”;</para>
  <para style="q" vid="ISA 44:28">ariñaga au lun Herusalén: “Bararamagüdüwayaba”,</para>
  <para style="q" vid="ISA 44:28">ariñaga au tun ténpulu: “Lichugúba buagaburi” ».<verse eid="ISA 44:28" /></para>
  <chapter eid="ISA 44" />
  <chapter number="45" style="c" sid="ISA 45" />
  <para style="s1">Lanúadiruni Wabureme Siru lun luadigimari</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 45:1" />Anúadira lumuti Bungiu Siru keisi urúei,</para>
  <para style="q" vid="ISA 45:1">barǘ lumuti luéigiñe lúhabu lun lagumadiruniña néchanigu</para>
  <para style="q" vid="ISA 45:1">luma lun lagünrinchaguniña urúeigu.</para>
  <para style="q" vid="ISA 45:1">Adügati Bungiu lun lánhunrenchun lubenari burí uburugu ligibugiñe Siru,</para>
  <para style="q" vid="ISA 45:1">úouga kaba lan adourei luéi.</para>
  <para style="q" vid="ISA 45:1">Lariñahareti lun guentó:<verse eid="ISA 45:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 45:2" />«Nídiba bubá bubá, násuragüdübei le segebei;</para>
  <para style="q" vid="ISA 45:2">nabouchaguba bena burí le lauti buronse,</para>
  <para style="q" vid="ISA 45:2">günringuaneime burí idaündaü lauti gürabu.<verse eid="ISA 45:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 45:3" />Níchugubei irisini le burí aramudúañubei bun,</para>
  <para style="q" vid="ISA 45:3">irisini areidúañuti lidan fulasu aramudaguati;</para>
  <para style="q" vid="ISA 45:3">lun basubudiruni luagu au lan Aburemeibei,</para>
  <para style="q" vid="ISA 45:3">Lubungiute Ísüraeli, le agúarubei bun lau biri.<verse eid="ISA 45:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 45:4" />Ladüga nugudemehabu lun Hakobu le eseriwidubei nun,</para>
  <para style="q" vid="ISA 45:4">luma houn Ísüraelina ha nanúadirubaña.</para>
  <para style="q" vid="ISA 45:4">Wáhadina bun lau biri, ru au uéiriguni bun,</para>
  <para style="q" vid="ISA 45:4">ibidiñounga au bun,<verse eid="ISA 45:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 45:5" />Au Aburemeibei, úati amu;</para>
  <para style="q" vid="ISA 45:5">úati amu Bungiu nuéi.</para>
  <para style="q" vid="ISA 45:5">Aranse náadibu lun wuribu</para>
  <para style="q" vid="ISA 45:5">ibidiñounga au bun,<verse eid="ISA 45:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 45:6" />lun hasubudiruni sun ha luéigiñebaña oubaü</para>
  <para style="q" vid="ISA 45:6">le ñéingiñe lubéi laboucha weyu,</para>
  <para style="q" vid="ISA 45:6">hama ha luéigiñebaña oubaü le ñeinhin lubéi lálüda</para>
  <para style="q" vid="ISA 45:6">luagu ua lan amu bóugudi nuéi.</para>
  <para style="q" vid="ISA 45:6">Au Aburemeibei, úati amu.<verse eid="ISA 45:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 45:7" />Au adügübalin larugounga luma luburiga,</para>
  <para style="q" vid="ISA 45:7">barütina lubuiduniga barǘ au lamiselu.</para>
  <para style="q" vid="ISA 45:7">Au le Aburemei, adüga numuti sun le».<verse eid="ISA 45:7" /></para>
  <para style="s1">Lubafu Bungiu</para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 45:8" />«Nóunahabei nagañeirun íñugiñe,</para>
  <para style="q" vid="ISA 45:8">kei serenu siélugiñe,</para>
  <para style="q" vid="ISA 45:8">kei huya dúerirugugiñe,</para>
  <para style="q" vid="ISA 45:8">ábame leresibiruni múa;</para>
  <para style="q" vid="ISA 45:8">líchuguba esefuruni kei in,</para>
  <para style="q" vid="ISA 45:8">legelewehaba irichaü lóubagiñe».<verse eid="ISA 45:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 45:9" />Aban asiedu lauti múa,</para>
  <para style="q" vid="ISA 45:9">le ítarati kei furumiñeguarügü asiedu,</para>
  <para style="q" vid="ISA 45:9">masigenehanti luma le adügübalin.</para>
  <para style="q" vid="ISA 45:9">Mariñagunti múa lun le nadagimeinbalin:</para>
  <para style="q" vid="ISA 45:9">«Ka badügübei?»</para>
  <para style="q" vid="ISA 45:9">Mariñagun ligía katei le ladügübei lun:</para>
  <para style="q" vid="ISA 45:9">«Mawadigimaridatibu».<verse eid="ISA 45:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 45:10" />Siñati giñe ladeinhan aban isaani</para>
  <para style="q" vid="ISA 45:10">houn lagübürigu luagu hagaraüdüni.<verse eid="ISA 45:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 45:11" />Lariñahare Aburemei, le Sándubei,</para>
  <para style="q" vid="ISA 45:11">le Lubungiute Ísüraeli, le adügübalin:</para>
  <para style="q" vid="ISA 45:11">«Hálügüdagubadina funagia hawagu nisaanigu,</para>
  <para style="q" vid="ISA 45:11">o harufudahaba nun ida luba lan nadügüni le nadügübei?<verse eid="ISA 45:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 45:12" />Au adügübalin ubóu hau sun lílana,</para>
  <para style="q" vid="ISA 45:12">au átulerubalin sielu lau núhabu,</para>
  <para style="q" vid="ISA 45:12">aba nasaliraguagüdüniña sun waruguma.<verse eid="ISA 45:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 45:13" />Au achülaaguagüdübalin Siru lun lagañeirun,</para>
  <para style="q" vid="ISA 45:13">ani nadügüba lun ménrengun lan sun üma lun;</para>
  <para style="q" vid="ISA 45:13">lararamagüdayabei nuburugute,</para>
  <para style="q" vid="ISA 45:13">lígiragüdübaña ha anügǘbaña hageiragiñe keisi adaürǘtiña maguburahangalaña».</para>
  <para style="q" vid="ISA 45:13">Aburemei Suntigabafu adimurehabei.<verse eid="ISA 45:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 45:14" />Ítara liña lariñagun Bungiu lun Ísüraeli:</para>
  <para style="q" vid="ISA 45:14">«Hederegeraguba Ehiptuna ha nadagimeinbaña áraabu houngua bun</para>
  <para style="q" vid="ISA 45:14">hau sun alugurahatiña Etiopíana</para>
  <para style="q" vid="ISA 45:14">hama gürigia Sabaana, ha gágububuribaña,</para>
  <para style="q" vid="ISA 45:14">ábame herederun bidamunme;</para>
  <para style="q" vid="ISA 45:14">hóudiba bárigi bárigi güragu lau güringüri,</para>
  <para style="q" vid="ISA 45:14">háhuduraguba bigibugiñe ábame hayumuragun bun ariñaga:</para>
  <para style="q" vid="ISA 45:14">“Inarüni luagu anihein lan Bungiu huma,</para>
  <para style="q" vid="ISA 45:14">úati amu, úati amu bungiu” ».<verse eid="ISA 45:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 45:15" />Lau sun lira aban Bungiu marihínti buguya,</para>
  <para style="q" vid="ISA 45:15">Bungiu le lesefuragüle Ísüraeli.<verse eid="ISA 45:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="ISA 45:16" />Sun ha adaagubaña guáriuagu,</para>
  <para style="q" vid="ISA 45:16">habuinchuba lau busiganu.<verse eid="ISA 45:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 45:17" />Ánheinti Ísüraeli sefu lumuti Aburemei,</para>
  <para style="q" vid="ISA 45:17">sefu lumuti lun sun dan,</para>
  <para style="q" vid="ISA 45:17">ani manügündügübei busiganu.<verse eid="ISA 45:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="ISA 45:18" />Lariñahare Bungiu le adügübalin sielu,</para>
  <para style="q" vid="ISA 45:18">Bungiu le Aburemeibei</para>
  <para style="q" vid="ISA 45:18">le adügübalin múa, aranseléi,</para>
  <para style="q" vid="ISA 45:18">le ederebudagüdübalin,</para>
  <para style="q" vid="ISA 45:18">lun haganóun gürigia:</para>
  <para style="q" vid="ISA 45:18">«Au Aburemeibei, úati amu nuéi.<verse eid="ISA 45:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 45:19" />Madimurehantina aramudaguarügü</para>
  <para style="q" vid="ISA 45:19">ni lidan burí fulasu búrigati ubouagu.</para>
  <para style="q" vid="ISA 45:19">Mariñaguntina houn ladügawagun Hakobu:</para>
  <para style="q" vid="ISA 45:19">“Áluaha humana le ñein lumuti ua lan ni kata”.</para>
  <para style="q" vid="ISA 45:19">Au, le Aburemei, inarüni nadimurehabei,</para>
  <para style="q" vid="ISA 45:19">irichaü nariñagubei.<verse eid="ISA 45:19" /></para>
  <para style="s1">Lagagibudagun Aburemei hama guáriuagu</para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 45:20" />«Óundaragua humá, higougu,</para>
  <para style="q" vid="ISA 45:20">yarafa humá sun ha wínwangiñabaña ubouagu.</para>
  <para style="q" vid="ISA 45:20">Ibidiouguati hau ha asariñagüdübaña</para>
  <para style="q" vid="ISA 45:20">hau haguariuan ha láutiña wewe,</para>
  <para style="q" vid="ISA 45:20">afurieida hagía lun aban bungiu le siñabei lesefuruniña.<verse eid="ISA 45:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 45:21" />Hadimureha, arufuda huméi hinarün,</para>
  <para style="q" vid="ISA 45:21">anhein busén hubéi, álügüdagua humá húmagua:</para>
  <para style="q" vid="ISA 45:21">Ka ariñagubalin burí katei le lúmagiñe furumiñeti dan?</para>
  <para style="q" vid="ISA 45:21">Mama funagia au le Aburemei?</para>
  <para style="q" vid="ISA 45:21">Úati Bungiu bóugudi nuéi,</para>
  <para style="q" vid="ISA 45:21">úati Bungiu esefuhati nuéidigia.<verse eid="ISA 45:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="ISA 45:22" />«Higougu numoun sun lílana ubóu sefu humaamuga,</para>
  <para style="q" vid="ISA 45:22">ladüga au Búngiubei, úati amu Bungiu nuéi.<verse eid="ISA 45:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 45:23" />Fiñú numuti lidan niri guánarügü,</para>
  <para style="q" vid="ISA 45:23">adügatina aban füramasei lánina agañeiruni</para>
  <para style="q" vid="ISA 45:23">ani lagunfuliruba füramasei ligía:</para>
  <para style="q" vid="ISA 45:23">Luagu háhuduraguba lan sun gürigia nigibugiñe,</para>
  <para style="q" vid="ISA 45:23">fiñú hagíame súngubei lidan niri,<verse eid="ISA 45:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 45:24" />hariñagame: “Lídanrügüñein Bungiu agañeiruni luma ubafu”.</para>
  <para style="q" vid="ISA 45:24">Wuribabei lidin houn sun ha iyereehabúbaña nun.<verse eid="ISA 45:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 45:25" />Lau nareini, hagañeiruba sun lánigu Ísüraeli</para>
  <para style="q" vid="ISA 45:25">ani hapantahaba nau.<verse eid="ISA 45:25" /></para>
  <chapter eid="ISA 45" />
  <chapter number="46" style="c" sid="ISA 46" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 46:1" />«Huduguati bungiu Beli,</para>
  <para style="q" vid="ISA 46:1">heigua ligía bungiu Nebu múarugun.</para>
  <para style="q" vid="ISA 46:1">Barüwarügütiña hanagawagu gabayu,</para>
  <para style="q" vid="ISA 46:1">ani hǘrütiña houn animaalugu buchaaña uagu.<verse eid="ISA 46:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 46:2" />Segeguatiña búngiugu, ábürüha hagía múarugun</para>
  <para style="q" vid="ISA 46:2">siñati hesefuragun houngua,</para>
  <para style="q" vid="ISA 46:2">hagía guánarügü barüwatiña lidoun fulasu mageirawati.<verse eid="ISA 46:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 46:3" />«Aganba humana, ladügawagun Hakobu,</para>
  <para style="q" vid="ISA 46:3">sun ha erederubaña hádangiñe lánigu Ísüraeli:</para>
  <para style="q" vid="ISA 46:3">Abayayaha naadün núhaburugu lúmagiñe lubaragiñe hágurahoun;<verse eid="ISA 46:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 46:4" />Ani ítarameme nuba huma danme haweiyadun;</para>
  <para style="q" vid="ISA 46:4">nágüdahamemebadün danme le garubaadün.</para>
  <para style="q" vid="ISA 46:4">Au adügübalün ani nabayayahamémebadün,</para>
  <para style="q" vid="ISA 46:4">nágüdahabadün ani nesefurubadün.<verse eid="ISA 46:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 46:5" />«Kaba uma gayara lan hóuchaguana?</para>
  <para style="q" vid="ISA 46:5">Kagia nenegebei según huguya?<verse eid="ISA 46:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 46:6" />Añahein asagarutiña saragu golu tídangiñe hasagüte,</para>
  <para style="q" vid="ISA 46:6">amisuraha hagía pülata lidan balansu;</para>
  <para style="q" vid="ISA 46:6">lárigiñe aba hadügün daradu luma aban gadiñeti</para>
  <para style="q" vid="ISA 46:6">lun ladügün aban bungiu houn lun háhuduragun lun.<verse eid="ISA 46:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 46:7" />Aba hiñurahani hégewagun aba houdin lau;</para>
  <para style="q" vid="ISA 46:7">aba hadagaragüdüni luagu lebu aba lerederun ñein,</para>
  <para style="q" vid="ISA 46:7">mánhingichunga lídangiñe lubara.</para>
  <para style="q" vid="ISA 46:7">Lau sun hagúaragun amuriaha luma lun líderaguniña,</para>
  <para style="q" vid="ISA 46:7">móunabun lumutiña siñá lasagaruniña lídangiñe le gádanbaliña.<verse eid="ISA 46:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 46:8" />«Haritagua huméi katei le, huguya gafigountiña,</para>
  <para style="q" vid="ISA 46:8">samina humá buidu ani darangilu humá,<verse eid="ISA 46:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 46:9" />haritagua huméi le susereelibei lúmagiñe binadu dan.</para>
  <para style="q" vid="ISA 46:9">Au Búngiubei, úati amu nuéi;</para>
  <para style="q" vid="ISA 46:9">Bungiu au ani úati amu kei au.<verse eid="ISA 46:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 46:10" />Ariñaga numuti le lunbei lasuseredun lúmagiñe furumiñeti dan;</para>
  <para style="q" vid="ISA 46:10">ariñaga numuti le anitebei saragu dan lubaragiñe. Ariñagatina:</para>
  <para style="q" vid="ISA 46:10">Lasusereduba sun le naransehabei;</para>
  <para style="q" vid="ISA 46:10">nadügübei sun le naritagubei nadügün.<verse eid="ISA 46:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 46:11" />Wáhadina lun aban wügüri luéigiñeti oubaü le ñéingiñe lubéi laboucha weyu,</para>
  <para style="q" vid="ISA 46:11">le lunbei liabin dísegiñe kei dunuru géigaahati</para>
  <para style="q" vid="ISA 46:11">ábame ladügüni naritagun.</para>
  <para style="q" vid="ISA 46:11">Ariñaga naali ani ítara luba nadügüni,</para>
  <para style="q" vid="ISA 46:11">adüga naali naransehan ani nagunfulirubei.<verse eid="ISA 46:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 46:12" />«Aganba humana huguya gürigia deré tanigi,</para>
  <para style="q" vid="ISA 46:12">huguya le aritagubei luagu dise lan esefuruni huéi:<verse eid="ISA 46:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 46:13" />Adügatina lun layarafadun nesefuhan,</para>
  <para style="q" vid="ISA 46:13">madarasahanbei nesefuhan, le madiseelibei.</para>
  <para style="q" vid="ISA 46:13">Nesefurubei Sión,</para>
  <para style="q" vid="ISA 46:13">níchugubei nuéirigun lun Ísüraeli».<verse eid="ISA 46:13" /></para>
  <chapter eid="ISA 46" />
  <chapter number="47" style="c" sid="ISA 47" />
  <para style="s1">Lábürühan Babilónia</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 47:1" />«Babilónia, rariba luéigiñe lálana barúeihan,</para>
  <para style="q" vid="ISA 47:1">ñuruba lidan kaliki.</para>
  <para style="q" vid="ISA 47:1">Ítara biña meha kei aban würi mámarigiru;</para>
  <para style="q" vid="ISA 47:1">wéndetu ani hínsiñegutu,</para>
  <para style="q" vid="ISA 47:1">guentó mítarandigiaali.<verse eid="ISA 47:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 47:2" />Guentó ábanhadibu idamuni</para>
  <para style="q" vid="ISA 47:2">ragübei amuligülei, hürüboun fulúaru,</para>
  <para style="q" vid="ISA 47:2">gidaboun bubelun, róuguaboun bugudun,</para>
  <para style="q" vid="ISA 47:2">asurusugüdabéi biyada, hiñuguabei duna eibu;<verse eid="ISA 47:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 47:3" />Ariha hamabu súngubei madaüragunga,</para>
  <para style="q" vid="ISA 47:3">surusu sunsuinagubei.</para>
  <para style="q" vid="ISA 47:3">Nafayeiragüdaadibu luagu le badügübei,</para>
  <para style="q" vid="ISA 47:3">ani siñabei lararamunina ni aban lau layumuragun».<verse eid="ISA 47:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 47:4" />Lariñahare Wesefuragüle,</para>
  <para style="q" vid="ISA 47:4">Bungiu le Sándubei le Lubungiute Ísüraeli,</para>
  <para style="q" vid="ISA 47:4">le gíribei Aburemei Suntigabafu:<verse eid="ISA 47:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 47:5" />«Ñuruba maniñu nibureintu Kalüdéana,</para>
  <para style="q" vid="ISA 47:5">beluba lidoun luburiga</para>
  <para style="q" vid="ISA 47:5">ladüga maguarúnwadigiaalime bun harúeite néchanigu.<verse eid="ISA 47:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 47:6" />Dan buga le gáñiñadina lubéi hama numutuniña,</para>
  <para style="q" vid="ISA 47:6">aba nederegeruniña lun busiganu,</para>
  <para style="q" vid="ISA 47:6">aba nígiruniña lun hábürühan labun bubafu.</para>
  <para style="q" vid="ISA 47:6">Magudemehabútibu houn,</para>
  <para style="q" vid="ISA 47:6">aba bíchugun lihürü anügüni hawagun wéiyaaña mutu.<verse eid="ISA 47:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 47:7" />Bariñaga: “Urúeibadina lun sun dan”;</para>
  <para style="q" vid="ISA 47:7">masaminaruntibu libügürü burí katei le,</para>
  <para style="q" vid="ISA 47:7">maritagun buguya ida luba lan lagumuchun sun katei.<verse eid="ISA 47:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 47:8" />Aganbabéi lubeiti katei le guentó,</para>
  <para style="q" vid="ISA 47:8">buguya würi to hínsiñehabuboun lun wendei,</para>
  <para style="q" vid="ISA 47:8">to darangilañuboun luagu tala le lálana arúeihani,</para>
  <para style="q" vid="ISA 47:8">to ariñaguboun tídangua: “Nuguya, úatu amu nuéidigia;</para>
  <para style="q" vid="ISA 47:8">meredebadina kei hiñaru hilaali túmari,</para>
  <para style="q" vid="ISA 47:8">merede nuguyame marahüñüga”.<verse eid="ISA 47:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 47:9" />Liábinba biángubei lamiselu le bun sódini lidan ábanmeme weyu:</para>
  <para style="q" vid="ISA 47:9">Berederuba kei würi hilaali túmari ani marahüñüga,</para>
  <para style="q" vid="ISA 47:9">íbini lanarime babiñarahadi luma liibe bibiñegu,<verse eid="ISA 47:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 47:10" />chóuruguati yebe basandiragun bungua lidan buriban,</para>
  <para style="q" vid="ISA 47:10">aba bariñagun búnguarügü:</para>
  <para style="q" vid="ISA 47:10">“Úati arihitina”.</para>
  <para style="q" vid="ISA 47:10">Eyeeda lumutibu lichú bau luma bisubudin.</para>
  <para style="q" vid="ISA 47:10">Ariñagatibu búnguarügü:</para>
  <para style="q" vid="ISA 47:10">“Nuguya, úatu amu nuéidigia”.<verse eid="ISA 47:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 47:11" />Gama lumoun liábinba lamiselu buagun,</para>
  <para style="q" vid="ISA 47:11">ani siñá bubéi ararama lau babiñarahan;</para>
  <para style="q" vid="ISA 47:11">lábürühaba aban lamiselu buagun le básiñarun eredera;</para>
  <para style="q" vid="ISA 47:11">aban lamiselu le yebe magurabun bumuti,</para>
  <para style="q" vid="ISA 47:11">ligíaba ñübuin buagun sódini.<verse eid="ISA 47:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 47:12" />Ítaramemeba lau babiñarahan</para>
  <para style="q" vid="ISA 47:12">le badügübei lúmagiñe biñüraü,</para>
  <para style="q" vid="ISA 47:12">wariha anhein eseriwida bun,</para>
  <para style="q" vid="ISA 47:12">wariha ánhaña anufudeda gürigia buéi.<verse eid="ISA 47:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 47:13" />Gámaadibu saragu eweridihatiña,</para>
  <para style="q" vid="ISA 47:13">darí lun labuchadun buagu.</para>
  <para style="q" vid="ISA 47:13">Ñübuin hamaati bánigu ha aríagubalin sielu,</para>
  <para style="q" vid="ISA 47:13">ha egesihabaña lau haríaguniña waruguma,</para>
  <para style="q" vid="ISA 47:13">ha ariñagubaña bun kaba lan asusereda sagü hati,</para>
  <para style="q" vid="ISA 47:13">ñübuin hamá oucha hesefurunibu!<verse eid="ISA 47:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 47:14" />Gama lumoun ítara haba kei sagadi sáühali,</para>
  <para style="q" vid="ISA 47:14">lágudubaña watu gemeti,</para>
  <para style="q" vid="ISA 47:14">ani siñabei hesefurun lídangiñe leñegura.</para>
  <para style="q" vid="ISA 47:14">Lugundun mámabei aban watu le lauti eñeguraü</para>
  <para style="q" vid="ISA 47:14">le lunti lañuurún abacharagua larügürügü.<verse eid="ISA 47:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 47:15" />Ítara luba hagumuchun bani gabiñarahatiña,</para>
  <para style="q" vid="ISA 47:15">ha úmabaña badaradura saragu lidan sun bibagari.</para>
  <para style="q" vid="ISA 47:15">Aba lárügüdüni kada aban lémeri,</para>
  <para style="q" vid="ISA 47:15">úabei ni aban lun lesefurunibu.<verse eid="ISA 47:15" /></para>
  <chapter eid="ISA 47" />
  <chapter number="48" style="c" sid="ISA 48" />
  <para style="s1">Líchugun Aburemei iseri uganu</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 48:1" />Aganbabéi katei le, tílana luban Hakobu,</para>
  <para style="q" vid="ISA 48:1">buguya le anügübalin liri Ísüraeli,</para>
  <para style="q" vid="ISA 48:1">ani ladügawagun Hudá buguya;</para>
  <para style="q" vid="ISA 48:1">buguya le áfiñurubei lidan liri Wabureme,</para>
  <para style="q" vid="ISA 48:1">buguya le agúahabalin Lubungiute Ísüraeli,</para>
  <para style="q" vid="ISA 48:1">gama lumoun mama lau arumani ni lau úaraguni;<verse eid="ISA 48:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 48:2" />buguya le ariñagubei luagu lílana ban uburugu sánduti,</para>
  <para style="q" vid="ISA 48:2">ani hemenigi ban luagu Lubungiute Ísüraeli,</para>
  <para style="q" vid="ISA 48:2">le gíribei Aburemei Suntigabafu.<verse eid="ISA 48:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 48:3" />Ariñaga numuti le sügühalibei bun lúmagiñe binarü;</para>
  <para style="q" vid="ISA 48:3">au guánarügü asubudiragüdübalin.</para>
  <para style="q" vid="ISA 48:3">Sódini aba nadügüni naritagun, aba lasuseredun.<verse eid="ISA 48:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 48:4" />Keiti subudi nubalin deré tan banigi,</para>
  <para style="q" vid="ISA 48:4">luagu ítara tiña lan kei gürabu,</para>
  <para style="q" vid="ISA 48:4">mabaruchaguadi tuguya kei buronse,<verse eid="ISA 48:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 48:5" />aba nadimurehani bun lúmagiñe binarü,</para>
  <para style="q" vid="ISA 48:5">ariñaga numuti bun lubaragiñe lasuseredun.</para>
  <para style="q" vid="ISA 48:5">Luéi bariñagun: Nuguariuan adügübalin,</para>
  <para style="q" vid="ISA 48:5">guáriua le nadügübei abusenrubei lun ítara luba lan.<verse eid="ISA 48:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 48:6" />«Aganba baali sun le; tenibá lun,</para>
  <para style="q" vid="ISA 48:6">ábame bánharun luagu inarüni lan.</para>
  <para style="q" vid="ISA 48:6">Guentó nadimureha bun luagu burí katei iseri,</para>
  <para style="q" vid="ISA 48:6">katei le burí aramudaguati le ibidiñeñahati bun,<verse eid="ISA 48:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 48:7" />katei le burí adügüti guentó, mama lidan binadu dan,</para>
  <para style="q" vid="ISA 48:7">le uágubei maganbunñahagidibu lan darí uguñe.</para>
  <para style="q" vid="ISA 48:7">Mariñagun báamuga: “Subudiñaha naali”.<verse eid="ISA 48:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 48:8" />Maganbunñahagidibu ladimurehoun luagu,</para>
  <para style="q" vid="ISA 48:8">ibidiñe ligía burí bun,</para>
  <para style="q" vid="ISA 48:8">lugundun darugu liñaha barigei súnwandan.</para>
  <para style="q" vid="ISA 48:8">Subudi numuti luagu magunfulin ban,</para>
  <para style="q" vid="ISA 48:8">luma luagu wa hamá bun mabuchahati lúmagiñe bágurahoun.<verse eid="ISA 48:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 48:9" />«Gama lumoun gaguraasuntina bubá luagu ninebengua nungua,</para>
  <para style="q" vid="ISA 48:9">ligía nárügüdagunbei nungua luéi nagünrinchagunibu.<verse eid="ISA 48:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 48:10" />Harumagüda numutibu gama lumoun mama kei ladügǘn lun pülata,</para>
  <para style="q" vid="ISA 48:10">hóuchaguarügü numutibu lidan régigi le lánina asufuriruni.<verse eid="ISA 48:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 48:11" />Luagu nineben nadügei lira,</para>
  <para style="q" vid="ISA 48:11">lugundun siñati lawiyedúniwa niri.</para>
  <para style="q" vid="ISA 48:11">Mígirunbadina lun lichugún nuéirigun lun amu».<verse eid="ISA 48:11" /></para>
  <para style="s1">Lesefurubaña Wabureme lumutuniña</para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 48:12" />«Aganbabána, Ísüraeli, lumutuniña Hakobu,</para>
  <para style="q" vid="ISA 48:12">ha únbaña wáhadina lan:</para>
  <para style="q" vid="ISA 48:12">Áurügüñein Bungiu,</para>
  <para style="q" vid="ISA 48:12">au furumiñebei luma agumuhóuni.<verse eid="ISA 48:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 48:13" />Lau núhabu nederebudagüdei ubóu;</para>
  <para style="q" vid="ISA 48:13">lau núhabu nátulerei sielu;</para>
  <para style="q" vid="ISA 48:13">kei níriduni liri, aba burí lasaliragun.<verse eid="ISA 48:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 48:14" />Óundaragua humá sun huguya, aganba humá:</para>
  <para style="q" vid="ISA 48:14">Ka hídangiñe ariñagubalin sun le,</para>
  <para style="q" vid="ISA 48:14">le lunbei lasuseredun,</para>
  <para style="q" vid="ISA 48:14">luagu wügüri lan le anúadira naalibei,</para>
  <para style="q" vid="ISA 48:14">ladügübei lan le naritagubei nadügün lun Babilónia</para>
  <para style="q" vid="ISA 48:14">luma houn harasan Kalüdéana?<verse eid="ISA 48:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 48:15" />Au ariñagubalin, au agúarubei lun,</para>
  <para style="q" vid="ISA 48:15">aba nadügün lun liabin,</para>
  <para style="q" vid="ISA 48:15">ani lagañeiruba le ñein lumuti lidin.<verse eid="ISA 48:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 48:16" />Yarafa humá nun, aganba huméi le:</para>
  <para style="q" vid="ISA 48:16">Lúmagiñe furumiñeti dan, madimurehantina aramudaguarügü;</para>
  <para style="q" vid="ISA 48:16">ani dan le lasuseredunbei sun katei le, ñéinñadina.</para>
  <para style="q" vid="ISA 48:16">Guentoti ru naali nubafu lun, au le Aburemei,</para>
  <para style="q" vid="ISA 48:16">ani óunaha naali».<verse eid="ISA 48:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ISA 48:17" />Lariñahare Bungiu le besefuragüle,</para>
  <para style="q" vid="ISA 48:17">Bungiu Sánduti le Lubungiute Ísüraeli:</para>
  <para style="q" vid="ISA 48:17">«Au Aburemeibei le Bubungiute;</para>
  <para style="q" vid="ISA 48:17">arufudaha numuti le buídubei bun,</para>
  <para style="q" vid="ISA 48:17">adundeha numutibu luéigiñe üma le lunbei bafalaruni.<verse eid="ISA 48:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 48:18" />Adügaadibu hamuga gasu lau nererun!</para>
  <para style="q" vid="ISA 48:18">Aganwoundeina liña hamuga lubuidun dan bun kei duna éibaaguati,</para>
  <para style="q" vid="ISA 48:18">ítara liña hamuga bawanserun kei lugudi barana,<verse eid="ISA 48:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 48:19" />Saragu haña hamuga badügawagun</para>
  <para style="q" vid="ISA 48:19">siñá hamuga habahüdün kei sagoun le lárubei beya;</para>
  <para style="q" vid="ISA 48:19">magünrinchagun numutiña hamuga,</para>
  <para style="q" vid="ISA 48:19">madireirun numutiña hamuga giñe luéi narihin».<verse eid="ISA 48:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="ISA 48:20" />Furí humá Babilóniagiñe, hanuraha hawéi Kalüdéana.</para>
  <para style="q" vid="ISA 48:20">Agúaraha huméi uganu le lau ugundani,</para>
  <para style="q" vid="ISA 48:20">subudigüda huméi chülǘ lumoun lígirugu ubóu.</para>
  <para style="q" vid="ISA 48:20">Ariñaga humá: «Sefu laali Bungiu Hakobu le eseriwidubei lun!»<verse eid="ISA 48:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 48:21" />Lau sun sügügüda lániña lídangiñe burí fulasu mageirawati,</para>
  <para style="q" vid="ISA 48:21">mamagürabuduntiña,</para>
  <para style="q" vid="ISA 48:21">bougua lumuti dübü aba láfuridun saragu duna lídangiñe.<verse eid="ISA 48:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 48:22" />Ánheinti houn ha wuribabaña úati lubuidun dan.</para>
  <para style="q" vid="ISA 48:22">Aburemei ariñagubalin.<verse eid="ISA 48:22" /></para>
  <chapter eid="ISA 48" />
  <chapter number="49" style="c" sid="ISA 49" />
  <para style="s1">Lubúein Wabureme</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 49:1" />Aganba humana, lílana burí ubouhu,</para>
  <para style="q" vid="ISA 49:1">teni humá nun néchanigu dísetiña:</para>
  <para style="q" vid="ISA 49:1">Lúmagiñe lubaragiñe nágurahoun lagúara Bungiu nun;</para>
  <para style="q" vid="ISA 49:1">írida lumuti niri lúmagiñe turageirugugidina núguchu.<verse eid="ISA 49:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 49:2" />Adüga lumutu niñeñe efeinme to hamanatu,</para>
  <para style="q" vid="ISA 49:2">aramuda lumutina lúhaburugu,</para>
  <para style="q" vid="ISA 49:2">adüga lumutina ábanme gimara gágiritu</para>
  <para style="q" vid="ISA 49:2">aba lareidunina tidan tagei ligimaran.<verse eid="ISA 49:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 49:3" />Lariñaga nun: «Ísüraeli, nubúein buguya,</para>
  <para style="q" vid="ISA 49:3">narufudubei nuéirigun buagu».<verse eid="ISA 49:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 49:4" />Ariñagaadina yebe núnguarügü:</para>
  <para style="q" vid="ISA 49:4">«Nadagimeinhaadina luagu ni kata, yusu naali nere mébuga».</para>
  <para style="q" vid="ISA 49:4">Lidan linarün katei,</para>
  <para style="q" vid="ISA 49:4">lúhaburuguñein Bungiu nikesin,</para>
  <para style="q" vid="ISA 49:4">lúmañein Bungiu nafayeiruaha.<verse eid="ISA 49:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 49:5" />Ibihaadina uéiriguni ligibugiñe Wabureme le Nubungiute,</para>
  <para style="q" vid="ISA 49:5">ladüga ligía nérebei.</para>
  <para style="q" vid="ISA 49:5">Bungiu adügübalina lúmagiñe turageirugugiñe núguchu</para>
  <para style="q" vid="ISA 49:5">lun neseriwidun lun.</para>
  <para style="q" vid="ISA 49:5">Lun nadügün lun lagiribudun Ísüraeli lun,</para>
  <para style="q" vid="ISA 49:5">lun hóundarun lumutuniña Hakobu luma,<verse eid="ISA 49:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 49:6" />lariñahare: «Lóuguati lun beseriwidun nun</para>
  <para style="q" vid="ISA 49:6">lúnrügü bóundaraguniña lani Hakobu türibu</para>
  <para style="q" vid="ISA 49:6">luma lun bagiribudagüdüniña ha erederubaña wínwanñu hádangiñe Ísüraelina;</para>
  <para style="q" vid="ISA 49:6">nadügüba lun leiti ban houn néchanigu</para>
  <para style="q" vid="ISA 49:6">lun banügüni nesefuhan chülǘ lumoun lidise-agei ubóu».<verse eid="ISA 49:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 49:7" />Lariñahare Bungiu, le Esefuragülei,</para>
  <para style="q" vid="ISA 49:7">Bungiu Sánduti le Lubungiute Ísüraeli houn gürigia ha meberesenwabei hau</para>
  <para style="q" vid="ISA 49:7">ha iyereegubaña houn híbiri gürigia,</para>
  <para style="q" vid="ISA 49:7">ha rédeihañabaña idamunime houn gürigia wuriba tigaburi:</para>
  <para style="q" vid="ISA 49:7">«Danme harihinibu urúeigu hama hasaanigu,</para>
  <para style="q" vid="ISA 49:7">hásaaruba, ábame habuluchagun bigibugiñe,</para>
  <para style="q" vid="ISA 49:7">ladüga au, le Aburemei Sánduti le Lubungiute Ísüraeli,</para>
  <para style="q" vid="ISA 49:7">anúadira náadibu, ani gúnfuli numuti nererun».<verse eid="ISA 49:7" /></para>
  <para style="s1">Lichugún uganu luagu lararamawagüdünya Herusalén</para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 49:8" />Lariñahare Bungiu:</para>
  <para style="q" vid="ISA 49:8">«Chülüti dan lun narufuduni nareini bun, aba nóunabunibu;</para>
  <para style="q" vid="ISA 49:8">chülüti luéyuri esefuruni, aba níderagunibu.</para>
  <para style="q" vid="ISA 49:8">Areida numutibu lun nadügüni nidaradun hama lílana fulasu bídangiñe,</para>
  <para style="q" vid="ISA 49:8">lun lararamawagüdünya fulasu,</para>
  <para style="q" vid="ISA 49:8">lun hibihini múa le buga igirúaalibei,<verse eid="ISA 49:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 49:9" />lun lasagaruniña adaürǘtiña,</para>
  <para style="q" vid="ISA 49:9">lun lafuranguagüdüniña ha lídanbaña luburiga.</para>
  <para style="q" vid="ISA 49:9">Hadariruba sagadi laru sun üma,</para>
  <para style="q" vid="ISA 49:9">hadariruba éigini houn habiñanigu lidan furumiñeguarügü fulasu mageirawati.<verse eid="ISA 49:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 49:10" />Malamabaña, mamagürabu;</para>
  <para style="q" vid="ISA 49:10">mañawarihan lubaña weyu ni lárouga,</para>
  <para style="q" vid="ISA 49:10">lugundun hínsiñetiña nun, ani adundeha numutiña,</para>
  <para style="q" vid="ISA 49:10">ani nanügübaña lidoun lísensen duna.<verse eid="ISA 49:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 49:11" />Nadaaruba aban üma labadinaguagiñe wübü,</para>
  <para style="q" vid="ISA 49:11">nachagahabei burí émeri».<verse eid="ISA 49:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 49:12" />Ariha humá! Añatén dísegiñe:</para>
  <para style="q" vid="ISA 49:12">Híbiri luéigiñe nórute,</para>
  <para style="q" vid="ISA 49:12">híbiri luéigiñe oubaü le ñeinhin lubéi lálüda weyu,</para>
  <para style="q" vid="ISA 49:12">híbiri lóubawagugiñe Asuán.<verse eid="ISA 49:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 49:13" />Sielu, bagúaraha lau ugundani!</para>
  <para style="q" vid="ISA 49:13">Ubóu, buinba lau ugundani!</para>
  <para style="q" vid="ISA 49:13">Wübü, bagúaraha lau ugundani!</para>
  <para style="q" vid="ISA 49:13">Lugundun ámaliha laaña Bungiu lánigu,</para>
  <para style="q" vid="ISA 49:13">gudemehabuhaali houn lidan hadiheri.<verse eid="ISA 49:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 49:14" />Lariñahare meha Sión:</para>
  <para style="q" vid="ISA 49:14">«Ígira láadina Aburemei,</para>
  <para style="q" vid="ISA 49:14">bulíei láadina Nubungiute».<verse eid="ISA 49:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 49:15" />Gama lumoun Rédeiti funagia tínsiñehabu aban</para>
  <para style="q" vid="ISA 49:15">úguchuru houn tirahüñü odi bulíei tumutiña?</para>
  <para style="q" vid="ISA 49:15">Íbini hamuga tabulieiduniña,</para>
  <para style="q" vid="ISA 49:15">au, mabulieidun nubadibu.<verse eid="ISA 49:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 49:16" />Bürüwañubiña núhaburugu,</para>
  <para style="q" vid="ISA 49:16">súnwandan naritagun luagun bubarieirun.<verse eid="ISA 49:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 49:17" />Furesetimatiña ha araramayagüdübadibu</para>
  <para style="q" vid="ISA 49:17">sügǘ hau ha agünrinchagubadibu;</para>
  <para style="q" vid="ISA 49:17">ñǘdünha ha ábürügüdübalibu.<verse eid="ISA 49:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 49:18" />Iñurabéi barihin, arihabá geyegua bau,</para>
  <para style="q" vid="ISA 49:18">arihabá lun hóundaragun súngubei aba hagiribudun bun.</para>
  <para style="b" vid="ISA 49:18" />
  <para style="q" vid="ISA 49:18">«Au le Aburemei, fiñutina luagu nibagari</para>
  <para style="q" vid="ISA 49:18">luagu ítara haba lan sun hagía kei uéndeni le lunbei badaürüni,</para>
  <para style="q" vid="ISA 49:18">keisi tuéndegun aban adari.<verse eid="ISA 49:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 49:19" />Günringuaali bugaha bageira,</para>
  <para style="q" vid="ISA 49:19">gama lumoun guentó ñǘraübei bumúan</para>
  <para style="q" vid="ISA 49:19">houn ha lúnbaña haganóun ñein.</para>
  <para style="q" vid="ISA 49:19">Añahein ha agünrinchagubalibu dise.<verse eid="ISA 49:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 49:20" />Birahüñü ha meha féridihañabaña hariñaguba barigeirugun:</para>
  <para style="q" vid="ISA 49:20">“Ñǘraüyati ageiraü le woun;</para>
  <para style="q" vid="ISA 49:20">álugaba fulasu woun lun waganóun ñein”.<verse eid="ISA 49:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 49:21" />Ábame bariñagun bídangua:</para>
  <para style="q" vid="ISA 49:21">“Ka íchugun isaanigu ha nun?</para>
  <para style="q" vid="ISA 49:21">Masaanigutina meha, ani siñati meha gasaanigu nan;</para>
  <para style="q" vid="ISA 49:21">Babilóniañadina meha keisi adaürǘtiña,</para>
  <para style="q" vid="ISA 49:21">ka agüriahabaliña?</para>
  <para style="q" vid="ISA 49:21">Ígira hamaadina meha nábugua,</para>
  <para style="q" vid="ISA 49:21">halíagiñe hayabin?” »<verse eid="ISA 49:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="ISA 49:22" />Lariñahare Bungiu:</para>
  <para style="q" vid="ISA 49:22">«Níchiga dimurei houn néchanigu;</para>
  <para style="q" vid="ISA 49:22">níchiga aban seini houn gürigia</para>
  <para style="q" vid="ISA 49:22">lun hanügüniña bisaanigu ha wügüriña háhaburugu,</para>
  <para style="q" vid="ISA 49:22">hanügañame ha würiña hégewagu.<verse eid="ISA 49:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 49:23" />Urúeigu, hagíaba bagübürigu ha agüriahatibu,</para>
  <para style="q" vid="ISA 49:23">lirahüñü urúei, hagíaba búyawa.</para>
  <para style="q" vid="ISA 49:23">Habuluchaguba chülǘ múarugun bigibugiñe,</para>
  <para style="q" vid="ISA 49:23">ábame héheluhani kaliki luéigiñe bugudi.</para>
  <para style="q" vid="ISA 49:23">Ábame hasubudiruni luagu au lan Aburemeibei,</para>
  <para style="q" vid="ISA 49:23">ani ha hemenigibaña nuagu, meyeedúnbaña».<verse eid="ISA 49:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="ISA 49:24" />Gayaraati san labayurún katei le lagañeirubei</para>
  <para style="q" vid="ISA 49:24">aban wügüri héreti wuriburugu luéi?</para>
  <para style="q" vid="ISA 49:24">Odi gayaraati lanurun aban adaürǘti</para>
  <para style="q" vid="ISA 49:24">luéi aban wügüri le dereti lagumadihan?<verse eid="ISA 49:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 49:25" />Lariñahare Bungiu luagu gayara lan:</para>
  <para style="q" vid="ISA 49:25">«Labayurúba le lagañeirubei wügüri héreti luéi,</para>
  <para style="q" vid="ISA 49:25">gidawame lagañeirun deré tagumadihan luéi.</para>
  <para style="q" vid="ISA 49:25">Nagagibudaguba hama ha áluahatiña wuribu buma;</para>
  <para style="q" vid="ISA 49:25">au guánarügüba esefuraña bisaanigu.<verse eid="ISA 49:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 49:26" />Nafosurubaña ha íchugubaña lidere dan bun</para>
  <para style="q" vid="ISA 49:26">lun héigini hágürügü guánarügü</para>
  <para style="q" vid="ISA 49:26">luma lun habacharuadun lau hata kamá hamuga binu.</para>
  <para style="q" vid="ISA 49:26">Ítara luba hasubudiruni sun gürigia,</para>
  <para style="q" vid="ISA 49:26">luagu au lan le Aburemei Basalbaragülebei,</para>
  <para style="q" vid="ISA 49:26">luagu au lan le Lubungiute Hakobu Besefuragülebei».<verse eid="ISA 49:26" /></para>
  <chapter eid="ISA 49" />
  <chapter number="50" style="c" sid="ISA 50" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 50:1" />Lariñahare Bungiu:</para>
  <para style="q" vid="ISA 50:1">«Maritagua humatia luagu ígiragua nan tuma Ísüraeli, to húguchu,</para>
  <para style="q" vid="ISA 50:1">kei lígiragun aban wügüri tuma lúmari,</para>
  <para style="q" vid="ISA 50:1">o luagu alugura naadün lan keisi idamuni</para>
  <para style="q" vid="ISA 50:1">ladüga hamuga gadúeihan nan!</para>
  <para style="q" vid="ISA 50:1">Ladüga hafigouhan halugurúnbei;</para>
  <para style="q" vid="ISA 50:1">ladüga humabuchahan tigirúnbei Ísüraeli to húguchu.<verse eid="ISA 50:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 50:2" />Kagia uagu, madarirun nubéi ni aban dan le niábinbei?</para>
  <para style="q" vid="ISA 50:2">Kagia uagu móunabun lubéi ni aban dan le nagúahanbei?</para>
  <para style="q" vid="ISA 50:2">Haritaguatün yebe funagia luagu siñá nubadün lan esefura?</para>
  <para style="q" vid="ISA 50:2">Buídurügüti nariñagun dimurei lun lamabeidun barana</para>
  <para style="q" vid="ISA 50:2">luma lun lerederun duna éibaaguati kei fulasu mageirawati;</para>
  <para style="q" vid="ISA 50:2">lun hóunwegun úduraü hamagürabu,</para>
  <para style="q" vid="ISA 50:2">ñalagua hagíame ladüga lúan duna.<verse eid="ISA 50:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 50:3" />Dáüguagüda numuti sielu tau ludu,</para>
  <para style="q" vid="ISA 50:3">daruguatina lau tau daüguaü to lánina íruni».<verse eid="ISA 50:3" /></para>
  <para style="s1">Lemenigin Lubúein Bungiu</para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 50:4" />Arufudahaali Bungiu nun</para>
  <para style="q" vid="ISA 50:4">lun níchugun dǘgüdaguaü houn ha buchaañabaña uagu.</para>
  <para style="q" vid="ISA 50:4">Adügati lun deregüdagu nan sagü binaafin</para>
  <para style="q" vid="ISA 50:4">lun naganbuni le larufudahabei kei lubudubu.<verse eid="ISA 50:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 50:5" />Rúhali Aburemei gunfurandaü nun,</para>
  <para style="q" vid="ISA 50:5">ani aganba numuti, michu numuti nanagan luagun.<verse eid="ISA 50:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 50:6" />Ru numuti nanagan lun labeichún,</para>
  <para style="q" vid="ISA 50:6">ígiratina lun lahulún nídiuma.</para>
  <para style="q" vid="ISA 50:6">Madireirun numuti nigibu hawéi ha anabubalina suegua hamana:<verse eid="ISA 50:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 50:7" />Aburemei íderagubalina:</para>
  <para style="q" vid="ISA 50:7">Ligía madügün lubéi anabúni ni kata nun;</para>
  <para style="q" vid="ISA 50:7">ligía deregüdagu nubéi kei aban dübü,</para>
  <para style="q" vid="ISA 50:7">subudi numuti luagu manügünbadina lan busiganu.<verse eid="ISA 50:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 50:8" />Anihein le ágüdahabalina nóubagiñe:</para>
  <para style="q" vid="ISA 50:8">Anihein san somu gürigia le mama númagiñeti?</para>
  <para style="q" vid="ISA 50:8">Keimoun ligibugiñoun aguseragüdüti!</para>
  <para style="q" vid="ISA 50:8">Anihein san gürigia le sandiguati lungua garicha lan lun líchugun nidurun?</para>
  <para style="q" vid="ISA 50:8">Ñǘbuinla ariñagei nun!<verse eid="ISA 50:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 50:9" />Aburemei íderagubalina;</para>
  <para style="q" vid="ISA 50:9">kaba san gayara lasiadirunina?</para>
  <para style="q" vid="ISA 50:9">Hagumuchaguba sun náganiñu kei gamisa to heigin hamutiri.<verse eid="ISA 50:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 50:10" />Huguya le íchugubei inebesei lun Bungiu,</para>
  <para style="q" vid="ISA 50:10">ani aganba huméi lererun lubúein:</para>
  <para style="q" vid="ISA 50:10">Anhaün éibuga lidan luburiga,</para>
  <para style="q" vid="ISA 50:10">úouga ni murusun larugounga hau,</para>
  <para style="q" vid="ISA 50:10">ru huméi hemenigin luagu Bungiu, balá humá luagun.<verse eid="ISA 50:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 50:11" />Ánhañati sun ha áfuragubaña watu</para>
  <para style="q" vid="ISA 50:11">aranseha hagía gimara gemetu,</para>
  <para style="q" vid="ISA 50:11">hábürühaba lidoun guánarügü watu gemeti le háfuragubei,</para>
  <para style="q" vid="ISA 50:11">tau gimara to guánarügü hébeduboun.</para>
  <para style="q" vid="ISA 50:11">Lóunahabei Bungiu abeichúni le hawagun</para>
  <para style="q" vid="ISA 50:11">ábame herederun riwagu labadinagua asufuriruni.<verse eid="ISA 50:11" /></para>
  <chapter eid="ISA 50" />
  <chapter number="51" style="c" sid="ISA 51" />
  <para style="s1">Dimurei lánina dǘgüdaguaü</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 51:1" />Aganba humana huguya le busenbei habagaridun lidan ísuruni</para>
  <para style="q" vid="ISA 51:1">huguya le áluahabalina, liña lariñagun Bungiu.</para>
  <para style="q" vid="ISA 51:1">Ariha huméi dübü le uéigiñebei hátügürüwa,</para>
  <para style="q" vid="ISA 51:1">huyu le ñéingiñe lubéi hasagarúa:<verse eid="ISA 51:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 51:2" />«Ariha huméi Abüraámü, le húguchi,</para>
  <para style="q" vid="ISA 51:2">tuma Sara to agaraüdübalün.</para>
  <para style="q" vid="ISA 51:2">Ábanrügüñein dan le nagúarunbei lun,</para>
  <para style="q" vid="ISA 51:2">gama lumoun biní numuti</para>
  <para style="q" vid="ISA 51:2">aba níchugun saragu ladügawagun.<verse eid="ISA 51:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 51:3" />Gudemehabubadina lun Sión,</para>
  <para style="q" vid="ISA 51:3">uburugu le meha günringuaalibei.</para>
  <para style="q" vid="ISA 51:3">Nadügübei múa mábeiti le lídanbei</para>
  <para style="q" vid="ISA 51:3">fulasu mageirawati fuluri-ágeime,</para>
  <para style="q" vid="ISA 51:3">kei fuluri-agei le lábunagubei Aburemei Edén.</para>
  <para style="q" vid="ISA 51:3">Aniheinbei ugundani ñein luma eremuhani.<verse eid="ISA 51:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="ISA 51:4" />Nánigu, teni humá nun,</para>
  <para style="q" vid="ISA 51:4">aganba humana, néchanigu:</para>
  <para style="q" vid="ISA 51:4">Nasubudiragüdübei narufudahan,</para>
  <para style="q" vid="ISA 51:4">larugoungadagüdüba nugumadin hau gürigia.<verse eid="ISA 51:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 51:5" />Yarafaali nagañeirun, aniteeli nesefuhan luagu üma,</para>
  <para style="q" vid="ISA 51:5">Nagumadirubaña gürigia lau nubafu.</para>
  <para style="q" vid="ISA 51:5">Hagurabahabadina ha aganóubaña luagu burí ubouhu,</para>
  <para style="q" vid="ISA 51:5">híchugubei hemenigi nuagu».<verse eid="ISA 51:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 51:6" />Iñura huméi harihin sielun,</para>
  <para style="q" vid="ISA 51:6">ariha humá ǘnabun, luagun múa;</para>
  <para style="q" vid="ISA 51:6">lagumuchaguba sielu kei gumuleli,</para>
  <para style="q" vid="ISA 51:6">lawesiruba múa kei aban dúnigu,</para>
  <para style="q" vid="ISA 51:6">hóunweguba lílana ubóu kei minimini.</para>
  <para style="q" vid="ISA 51:6">Ánheinti nesefuhan magumuchadibei,</para>
  <para style="q" vid="ISA 51:6">laduraruba nagañeirun lun sun dan.<verse eid="ISA 51:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 51:7" />«Aganba humana huguya le subudihabúbei lun le richabei,</para>
  <para style="q" vid="ISA 51:7">gürigia ha anügübalin narufudahan kei katei le mama huraraü.</para>
  <para style="q" vid="ISA 51:7">Manufudeda humá luéi hanabagunün gürigia,</para>
  <para style="q" vid="ISA 51:7">mírudagua humá lau hanabunün,<verse eid="ISA 51:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 51:8" />lugundun hagumuchaguba kei dúnigu to heigin hamutiri,</para>
  <para style="q" vid="ISA 51:8">kei lana to hágürühan héweraü.</para>
  <para style="q" vid="ISA 51:8">Ánheinti nagañeirun magumuchadibei,</para>
  <para style="q" vid="ISA 51:8">laduraruba nesefuhan lun sun dan».<verse eid="ISA 51:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 51:9" />Agaguduabá, agaguduabá larüna Bungiu,</para>
  <para style="q" vid="ISA 51:9">ragüba erei agaguduabá kei meha lidan binadu dan,</para>
  <para style="q" vid="ISA 51:9">lidan dan le sügühalibei.</para>
  <para style="q" vid="ISA 51:9">Günringua bumuti Raabü, mónsturu baranahana;<verse eid="ISA 51:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 51:10" />mábeigüda bumuti barana,</para>
  <para style="q" vid="ISA 51:10">lidunari gudungu le hulilibei,</para>
  <para style="q" vid="ISA 51:10">adüga bumuti lilulin barana lun ǘmame,</para>
  <para style="q" vid="ISA 51:10">lun hásügürün ha esefurubaña.<verse eid="ISA 51:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 51:11" />Ítara luba giñe hagiribudun ha lesefurubaña Bungiu,</para>
  <para style="q" vid="ISA 51:11">ábame hebelurun uburugun Sión agúaraheina lau ugundani;</para>
  <para style="q" vid="ISA 51:11">hadariruba lubuiduniga, ábame lagumuchagun igarigu luma ayahuni.<verse eid="ISA 51:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 51:12" />«Au, au guánarügü rútina gurasu bun.</para>
  <para style="q" vid="ISA 51:12">Ka uei banufudeda? Hawéi san wügüriña?</para>
  <para style="q" vid="ISA 51:12">Hawéi san gürigia góunwedaditiña ha ítarabaña kei híduru?<verse eid="ISA 51:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 51:13" />Babulieidubei Aburemei le adügübalibu,</para>
  <para style="q" vid="ISA 51:13">le átulerubalin sielu, le ederebudagüdübalin ubóu?</para>
  <para style="q" vid="ISA 51:13">Badadagaruba sun oura ladüga hagañi ha íchugubaña lidere dan,</para>
  <para style="q" vid="ISA 51:13">ha aranseñubaña lun hagünrinchagunibu?</para>
  <para style="q" vid="ISA 51:13">Hageigia igañi ligía?<verse eid="ISA 51:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 51:14" />Le buga áfagubei lidere dan, lesefuruba furese,</para>
  <para style="q" vid="ISA 51:14">móunwenbei furisunrugu,</para>
  <para style="q" vid="ISA 51:14">memegeirun lubóun giñe leigan fein.<verse eid="ISA 51:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 51:15" />«Au Aburemeibei le Bubungiute,</para>
  <para style="q" vid="ISA 51:15">Aburemei Suntigabafu níribei;</para>
  <para style="q" vid="ISA 51:15">hingigua numuti barana aba lahuuhan lugudi,<verse eid="ISA 51:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 51:16" />Tulé numuti sielu, derebugugüdanei ubóu.</para>
  <para style="q" vid="ISA 51:16">Ru numuti nererun biyumulugún aba nóunigirunibu núhaburugu.</para>
  <para style="q" vid="ISA 51:16">Ariñagatina lun Sión: “Huguya numutuniñabei” ».<verse eid="ISA 51:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ISA 51:17" />Agaguduabá, Herusalén, saraba,</para>
  <para style="q" vid="ISA 51:17">súfuri bumuti ligañi Aburemei,</para>
  <para style="q" vid="ISA 51:17">kei le átubei lídangiñe aban kopu darí lamaladun,</para>
  <para style="q" vid="ISA 51:17">darí labacharuadun.<verse eid="ISA 51:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 51:18" />Hadan sun birahüñü, úati ni aban lun ladundehanibu;</para>
  <para style="q" vid="ISA 51:18">hadan sun isaanigu ha bagüriarubaña,</para>
  <para style="q" vid="ISA 51:18">úati ni aban lun lárühani búhabu.<verse eid="ISA 51:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 51:19" />Ábürühati bián lamiselu le buagun:</para>
  <para style="q" vid="ISA 51:19">Günrinwaguati bageira asagarahóua ligía,</para>
  <para style="q" vid="ISA 51:19">hilagua bumutuniña ladüga ilamaü luma wuribu,</para>
  <para style="q" vid="ISA 51:19">kaba gudemehabu bun? Kaba ámalihabu?<verse eid="ISA 51:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 51:20" />Ítara haña birahüñü kei usari ábürühatiña tidoun sádara,</para>
  <para style="q" vid="ISA 51:20">méreeña, roun haña burí luagu larigei furumiñeguarügü üma,</para>
  <para style="q" vid="ISA 51:20">bulesei laaña ligañi Aburemei,</para>
  <para style="q" vid="ISA 51:20">bulesei laaña labeihan Bungiu.<verse eid="ISA 51:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 51:21" />Ligía aganbabéi lubéi katei le uburugu mabunurunti,</para>
  <para style="q" vid="ISA 51:21">buguya le bacharuabei gama lumoun mama tau diwéin;<verse eid="ISA 51:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 51:22" />Babureme le Bubungiute,</para>
  <para style="q" vid="ISA 51:22">le ageindagubalin hakesin lánigu, lariñahare:</para>
  <para style="q" vid="ISA 51:22">«Nagidarubei weru diwéin le aubei babacharuada búhaburugugiñe,</para>
  <para style="q" vid="ISA 51:22">mátundigia báalime luerun nigañi.<verse eid="ISA 51:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 51:23" />Níchugubei houn ha añawarihabaña bun,</para>
  <para style="q" vid="ISA 51:23">houn háñaha ariñagubaña bun:</para>
  <para style="q" vid="ISA 51:23">“Rounba múarugu, wásügüra buéigiñe”,</para>
  <para style="q" vid="ISA 51:23">aba barounrun múarugu lun hadügüragunibu kei kaliki».<verse eid="ISA 51:23" /></para>
  <chapter eid="ISA 51" />
  <chapter number="52" style="c" sid="ISA 52" />
  <para style="s1">Uganu luagu lesefurun Herusalén</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 52:1" />Agaguduabá Sión, agaguduabá, ragüba erei;</para>
  <para style="q" vid="ISA 52:1">Herusalén, uburugu sánduti,</para>
  <para style="q" vid="ISA 52:1">daüboun tubuidun-agei badaüragun,</para>
  <para style="q" vid="ISA 52:1">lugundun mebeludigiaaña gibe tubungiute,</para>
  <para style="q" vid="ISA 52:1">gürigia wíyetiña bidoun.<verse eid="ISA 52:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 52:2" />Herusalén, furubei kaliki buáriua,</para>
  <para style="q" vid="ISA 52:2">ñuruba luagu lálana arúeihani.</para>
  <para style="q" vid="ISA 52:2">Sión, nibureintu adaürǘtu,</para>
  <para style="q" vid="ISA 52:2">gidabei yugu luéigiñe bigiina.<verse eid="ISA 52:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 52:3" />Lariñahare Aburemei: «Mibihintina ni aban gáwanaü</para>
  <para style="q" vid="ISA 52:3">dan le hanaawagunbei kei idamuni;</para>
  <para style="q" vid="ISA 52:3">míchubadina giñe ni aban gáwanaü lun nesefurunün.<verse eid="ISA 52:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 52:4" />Furumiñe meha, ñǘdüntiña numutuniña Ehiptun,</para>
  <para style="q" vid="ISA 52:4">aba haganóun ñein kei terencha;</para>
  <para style="q" vid="ISA 52:4">lárigiñe aba líchugun Asiria lidere dan houn mébunouga.<verse eid="ISA 52:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 52:5" />Guentó, barüwa numutuniña Babilónioun mébunouga,</para>
  <para style="q" vid="ISA 52:5">ha amudiragubaliña, agúarahatiña lau pantaü,</para>
  <para style="q" vid="ISA 52:5">merede ligía hanabagunina.<verse eid="ISA 52:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 52:6" />Gama lumoun lachülürüba weyu</para>
  <para style="q" vid="ISA 52:6">danme hasubudiruni numutiña luagu au lan le Aburemei, adimurehabei houn».<verse eid="ISA 52:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 52:7" />Ma lubuidun larihín lachülürün le anügübei uganu buiti;</para>
  <para style="q" vid="ISA 52:7">le anügübei uganu lánina darangilaü,</para>
  <para style="q" vid="ISA 52:7">le adimurehabei luagu esefuruni ariñaga ligía lun Sión:</para>
  <para style="q" vid="ISA 52:7">Urúei Bubungiute!<verse eid="ISA 52:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 52:8" />Aganbabéi hamalali óunigirutiña,</para>
  <para style="q" vid="ISA 52:8">agúarahatiña úara, agúarahani le lánina agañeiruni,</para>
  <para style="q" vid="ISA 52:8">ladüga ariha hamuti lagiribudagüdüni Aburemei Sión.<verse eid="ISA 52:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 52:9" />Wagua humá le lánina agañeiruni, lárigirugu Herusalén,</para>
  <para style="q" vid="ISA 52:9">lugundun gudemehabuhaali Aburemei houn lumutuniña,</para>
  <para style="q" vid="ISA 52:9">sefu laali Herusalén!<verse eid="ISA 52:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 52:10" />Arufuda laali Aburemei lubafu hagibugiñe sun néchanigu.</para>
  <para style="q" vid="ISA 52:10">Lasubudirúba lidan sun ubóu luagu sefu láadiwa lan Wabungiute.<verse eid="ISA 52:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 52:11" />Furí humá, furí humá Babilóniagiñe,</para>
  <para style="q" vid="ISA 52:11">maguura humá ni kata le wíyeti,</para>
  <para style="q" vid="ISA 52:11">furí humá Babilóniagiñe!</para>
  <para style="q" vid="ISA 52:11">Redei humá harumañu</para>
  <para style="q" vid="ISA 52:11">huguya le anaahabalin burí katei le layusurubei Bungiu!<verse eid="ISA 52:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 52:12" />Gama lumoun máfuridunbadün lau lufuresen,</para>
  <para style="q" vid="ISA 52:12">máfuridunbadün anuraheina,</para>
  <para style="q" vid="ISA 52:12">lugundun lóunigirubadün Aburemei le Lubungiute Ísüraeli luéigiñe sun oubaü.<verse eid="ISA 52:12" /></para>
  <para style="s1">Lasufurirun lubúein Aburemei</para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 52:13" />Buídubei lidin lun nubúein,</para>
  <para style="q" vid="ISA 52:13">liñurúaba ábame lichugún lidan ubaraü íñuti.<verse eid="ISA 52:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 52:14" />Ítara kei buga taweiridun hanigi saragu lau</para>
  <para style="q" vid="ISA 52:14">dan harihinbalin lámuñedagun larihín,</para>
  <para style="q" vid="ISA 52:14">menege hamaali lan buga gürigia;<verse eid="ISA 52:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 52:15" />ítara luba giñe saragubaña lan néchanigu aweiridutu hanigi,</para>
  <para style="q" vid="ISA 52:15">danme harihini urúeigu, siñabei hariñagun ni aban dimurei,</para>
  <para style="q" vid="ISA 52:15">lugundun harihubei le mabahüdawagunñahagilibei houn,</para>
  <para style="q" vid="ISA 52:15">gunfuranda hameime le maganbunñaha hamagilibei.<verse eid="ISA 52:15" /></para>
  <para style="b" />
  <chapter eid="ISA 52" />
  <chapter number="53" style="c" sid="ISA 53" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 53:1" />Kábagia afiñera luagu le ariñaga wamaalibei?</para>
  <para style="q" vid="ISA 53:1">Ka un larufudei Aburemei lubafu?<verse eid="ISA 53:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 53:2" />Adügati Aburemei lun laweiridun lubúein</para>
  <para style="q" vid="ISA 53:2">kei nadü ñǘraügili le ábunubalin lílagüle lidoun múa mábeiti,</para>
  <para style="q" vid="ISA 53:2">mamagadiñeti, úati ni kata le garíawaseti luagu, mínsiñegu ligia;<verse eid="ISA 53:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 53:3" />meberesenwati lau, barǘ haméi gürigia kei ni kata.</para>
  <para style="q" vid="ISA 53:3">Aban bugaha wügüri le buin umuti lau igarigu ligía,</para>
  <para style="q" vid="ISA 53:3">le héchuti luagu asufuriruni.</para>
  <para style="q" vid="ISA 53:3">Mabahüdün wamuti, barǘ wamuti kei gürigia le madünamati laríawagun,</para>
  <para style="q" vid="ISA 53:3">barǘ wamuti kei ni kata.<verse eid="ISA 53:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 53:4" />Lau sun lira, barǘ lumuti wasandi luouguoun,</para>
  <para style="q" vid="ISA 53:4">súfurilei wagarigu.</para>
  <para style="q" vid="ISA 53:4">Barǘ wamuti kei béiwaali, kei buleseiwaali</para>
  <para style="q" vid="ISA 53:4">ani kei nidiherigüda laali Bungiu.<verse eid="ISA 53:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 53:5" />Gama lumoun luéigiñe wamabuchahan lasufurira,</para>
  <para style="q" vid="ISA 53:5">muliliwati luagu wafigoun;</para>
  <para style="q" vid="ISA 53:5">barüti abeichúni le lasufurirubei darangilaü woun;</para>
  <para style="q" vid="ISA 53:5">luéigiñe burí biti le libihubei wareidagua sungua luagu.<verse eid="ISA 53:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 53:6" />Chararatiwa sun wagía kei mudún,</para>
  <para style="q" vid="ISA 53:6">ragǘ lumuti kada aban lémeri,</para>
  <para style="q" vid="ISA 53:6">gama lumoun barǘ lumuti Bungiu sun wariban íchiga luagun.<verse eid="ISA 53:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 53:7" />Ouserúati wuriba, gama lumoun ígiraguagüdati lungua lau ǘnabuguni,</para>
  <para style="q" vid="ISA 53:7">máwagachungubeiti ariñaga ni kata;</para>
  <para style="q" vid="ISA 53:7">barǘ hamuti kei mudún ñǘraügili lun lafarún,</para>
  <para style="q" vid="ISA 53:7">aba lerederun maniñu, mariñagunti ni kata,</para>
  <para style="q" vid="ISA 53:7">kei aban mudún dan le lasarún.<verse eid="ISA 53:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 53:8" />Dáüwati, siádiwa ani barüwa ligía lun lafarún,</para>
  <para style="q" vid="ISA 53:8">ani úati ariñaguti dimurei luéigiñe lufulesein;</para>
  <para style="q" vid="ISA 53:8">úati ni aban ebereseruti kaba lan asusereda lun.</para>
  <para style="q" vid="ISA 53:8">Hulá hamuti lidan giñe múa le,</para>
  <para style="q" vid="ISA 53:8">aba háfaruni hilagubei luagu hafigoun numutuniña.<verse eid="ISA 53:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 53:9" />Bunawati hóubagiñe gürigia salufuritiña,</para>
  <para style="q" vid="ISA 53:9">bunawati keisi rísitiña,</para>
  <para style="q" vid="ISA 53:9">lau sun máfarahan lan ni aban wéiyaasu,</para>
  <para style="q" vid="ISA 53:9">ua ligía iyeeni liyumulugu.<verse eid="ISA 53:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 53:10" />Ánhati Aburemei lasufuriragüdüni.</para>
  <para style="q" vid="ISA 53:10">Ani kei deregegua lubéi lungua kei adagaragüdüni luagu figóu,</para>
  <para style="q" vid="ISA 53:10">migifebei libagari, larihubaña ladügawagun;</para>
  <para style="q" vid="ISA 53:10">lawanseragüdübei laransehan Aburemei.<verse eid="ISA 53:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 53:11" />Larihubei larugounga lárigiñe saragu idiheri,</para>
  <para style="q" vid="ISA 53:11">ani ábame lagundaarun lau;</para>
  <para style="q" vid="ISA 53:11">saragubaña lesefurun lubúein Aburemei,</para>
  <para style="q" vid="ISA 53:11">ladüga lanügübei hariban luouguoun.<verse eid="ISA 53:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 53:12" />Ligía líchuguba lubéi Bungiu aban ubaraü lun hadan wéirigutiña,</para>
  <para style="q" vid="ISA 53:12">gafanranbei lidan agañeiruni hama gabafutiña,</para>
  <para style="q" vid="ISA 53:12">ladüga deregeguati lungua lun lounwen,</para>
  <para style="q" vid="ISA 53:12">abahüdǘwa ligía hadan wuribatiña,</para>
  <para style="q" vid="ISA 53:12">lau sun barǘ lani hafigoun saragu luougua</para>
  <para style="q" vid="ISA 53:12">amuriaha ligía hawagu gafigountiña.<verse eid="ISA 53:12" /></para>
  <chapter eid="ISA 53" />
  <chapter number="54" style="c" sid="ISA 54" />
  <para style="s1">Línsiñehabu Bungiu le magumuchadibei</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 54:1" />Bagúaraha lau ugundani, würi maraüheitu to marahüñütu,</para>
  <para style="q" vid="ISA 54:1">buguya le mágurahanñahagidibubei,</para>
  <para style="q" vid="ISA 54:1">lugundun lariñahare Bungiu:</para>
  <para style="q" vid="ISA 54:1">«Gíbetimabaña tirahüñü würi to meberesenwaboun au</para>
  <para style="q" vid="ISA 54:1">sügǘ tau to gámariboun».<verse eid="ISA 54:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 54:2" />Wéirigüdaboun bikianpun,</para>
  <para style="q" vid="ISA 54:2">tuleguaboun giánbisi to ábugiñeboun baganóua,</para>
  <para style="q" vid="ISA 54:2">chawaguabei gúrudu, dáguabei wewe buidu,<verse eid="ISA 54:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 54:3" />lugundun bachawaraguba luagun bóunwenren luma luagun bubaünan;</para>
  <para style="q" vid="ISA 54:3">hagañeiruba badügawagun saragu néchanigu</para>
  <para style="q" vid="ISA 54:3">ábame haganóun lidan fulasu burí le málabei guentó.<verse eid="ISA 54:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 54:4" />Manufudedabá, manügünbadibu busiganu;</para>
  <para style="q" vid="ISA 54:4">manabúnbadibu, úame kaba lan au babusigarida.</para>
  <para style="q" vid="ISA 54:4">Babulieidubei lubusigaridüna biñüraü</para>
  <para style="q" vid="ISA 54:4">ani maritagundigiaadibume luagu</para>
  <para style="q" vid="ISA 54:4">lubusigaridüna berederun mámariga.<verse eid="ISA 54:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 54:5" />Ladüga lanügübadibu le adügübalibu lun lúmarime.</para>
  <para style="q" vid="ISA 54:5">Aburemei Suntigabafu líribei;</para>
  <para style="q" vid="ISA 54:5">Bungiu le sándubei le Lubungiute Ísüraeli ligía besefuragülebei,</para>
  <para style="q" vid="ISA 54:5">le Lubungiute sun ubóu.<verse eid="ISA 54:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 54:6" />Ítara biña meha kei aban úmari nibureingiru to igirúaaru lau idiheri,</para>
  <para style="q" vid="ISA 54:6">gama lumoun wáyaali Bubungiute bun aba lariñagun bun:<verse eid="ISA 54:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 54:7" />«Ígira numutibu luagu murusun dan,</para>
  <para style="q" vid="ISA 54:7">gama lumoun nóundaraya buma lau óunwenbu nareini.<verse eid="ISA 54:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 54:8" />Aramudaguatina buéi luagu murusun dan,</para>
  <para style="q" vid="ISA 54:8">lidan le nagañidun,</para>
  <para style="q" vid="ISA 54:8">gama lumoun gudemehabutina bun lau ínsiñeni le magumuchaditi».</para>
  <para style="q" vid="ISA 54:8">Aburemei le besefuragüle ariñagubalin.<verse eid="ISA 54:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 54:9" />«Ítara kei náfiñurun lun Noé dan le ladagarunbei guran,</para>
  <para style="q" vid="ISA 54:9">luagu mabuluchagüdündigia naali lan ubóu,</para>
  <para style="q" vid="ISA 54:9">ítara liña giñe náfiñurun guentó</para>
  <para style="q" vid="ISA 54:9">luagu magañidundigiaadina lan buma</para>
  <para style="q" vid="ISA 54:9">mayawadagun aume buagun.<verse eid="ISA 54:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 54:10" />Íbini lasansiruni burí áraabu lubara,</para>
  <para style="q" vid="ISA 54:10">heigua ligía burime wübü,</para>
  <para style="q" vid="ISA 54:10">masansiragunbei bínsiñe nun,</para>
  <para style="q" vid="ISA 54:10">méiguadun ligíame nidaradun le lánina darangilaü».</para>
  <para style="q" vid="ISA 54:10">Bungiu le gudemehabubei bun ariñagubalin.<verse eid="ISA 54:10" /></para>
  <para style="s1">Iseri Herusalén</para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 54:11" />«Fugiabu uburugu bei laali luriban dan,</para>
  <para style="q" vid="ISA 54:11">úouga ni aban íchuguti dǘgüdaguaü bun!</para>
  <para style="q" vid="ISA 54:11">Nararamagüdayabadibu lau dübü buíduburiti,</para>
  <para style="q" vid="ISA 54:11">adüganéime buagaburi lau safiru;<verse eid="ISA 54:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 54:12" />nadügübei buayelesin lau rubí,</para>
  <para style="q" vid="ISA 54:12">bubenari lau berilu,</para>
  <para style="q" vid="ISA 54:12">sunme bubarieirun lau dübü buíduburiti.<verse eid="ISA 54:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 54:13" />Narufudahaba houn sun birahüñü,</para>
  <para style="q" vid="ISA 54:13">buídubei dan houn sun hagía.<verse eid="ISA 54:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 54:14" />Léredagüdübadibu irichaü</para>
  <para style="q" vid="ISA 54:14">bagidarúba lábugiñegiñe lidere dan luma anufudei</para>
  <para style="q" vid="ISA 54:14">mañawarihan láadibume anufudei.<verse eid="ISA 54:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 54:15" />Anhein ageindawagúa buma, mámabei nídangiñeti,</para>
  <para style="q" vid="ISA 54:15">gama lumoun bagañeirubei le ageindaguti buma.<verse eid="ISA 54:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="ISA 54:16" />«Au adügübalin nadagimeinti gürabu</para>
  <para style="q" vid="ISA 54:16">le áfuhabalin leñegura watu,</para>
  <para style="q" vid="ISA 54:16">adüga ligía ámuñegueinarügü tuwuyeri áruma;</para>
  <para style="q" vid="ISA 54:16">au giñe adügübalin wügüri le gagünrinchaguadibei lun lagünrinchagun.<verse eid="ISA 54:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 54:17" />Gama lumoun úagili ni aban adügütu áruma to lunboun tagünrinchagunibu.</para>
  <para style="q" vid="ISA 54:17">Bámanichagüdübei sun le íchuguti bidurun.</para>
  <para style="q" vid="ISA 54:17">Anihán katei le níchugubei houn ha eseriwidubaña nun: Agañeiruni».</para>
  <para style="q" vid="ISA 54:17">Bungiu ariñagubalin.<verse eid="ISA 54:17" /></para>
  <chapter eid="ISA 54" />
  <chapter number="55" style="c" sid="ISA 55" />
  <para style="s1">Füramase lan Aburemei</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 55:1" />«Sun ha mágürabubaña, ñübuin hamá ata duna;</para>
  <para style="q" vid="ISA 55:1">ha maseinsunbaña, ñübuin hamá,</para>
  <para style="q" vid="ISA 55:1">ibiha humá türigu mafayeihanga lun heigin,</para>
  <para style="q" vid="ISA 55:1">ibiha humá diwéin luma míligi mafayeihanga ni kata.<verse eid="ISA 55:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 55:2" />Ka uagu hewesirei hiseinsun luagu le mámabei fein?</para>
  <para style="q" vid="ISA 55:2">Ka uagu hewesirei lebegi huádigimari luagu katei le makimuledagüdünti?</para>
  <para style="q" vid="ISA 55:2">Aganba humana buidu,</para>
  <para style="q" vid="ISA 55:2">ábame heigin éigini buiti, éigini semeeti.<verse eid="ISA 55:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 55:3" />Higougu numoun teni humá nun,</para>
  <para style="q" vid="ISA 55:3">aganba humana ábame habagaridun.</para>
  <para style="q" vid="ISA 55:3">Nadügüba aban daradu magumuchaditi huma,</para>
  <para style="q" vid="ISA 55:3">lun nagunfuliruni füramasei le meha nadügübei lun Dawidi ladüga nínsiñehabu.<verse eid="ISA 55:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 55:4" />Ru numuti kei gefenti houn gürigia,</para>
  <para style="q" vid="ISA 55:4">kei ábuti luma arufudahati houn néchanigu.<verse eid="ISA 55:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 55:5" />Bagúaruba houn gürigia ha ibidiñetiña bun;</para>
  <para style="q" vid="ISA 55:5">gürigia ha buga ibidiñetibu houn,</para>
  <para style="q" vid="ISA 55:5">hóudiba éibaagueina bumoun,</para>
  <para style="q" vid="ISA 55:5">ladüga au, le Babureme le Bungiu Sánduti</para>
  <para style="q" vid="ISA 55:5">le Lubungiute Ísüraeli, rúhadina uéiriguni bun.<verse eid="ISA 55:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 55:6" />Áluaha huméi Aburemei lau gayaraagili lan hadariruni,</para>
  <para style="q" vid="ISA 55:6">háwaha lun luagu yarafagili lan.<verse eid="ISA 55:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 55:7" />Ígiralei wügüri le wuribabei lagübüri lémeri,</para>
  <para style="q" vid="ISA 55:7">ígiraleime salufuriti luriban lisaminan;</para>
  <para style="q" vid="ISA 55:7">giribu humá lun Aburemei ábame gudemehabu lan hun;</para>
  <para style="q" vid="ISA 55:7">giribu humá lun Wabungiute, le mánginbei lun feruduna lanün.<verse eid="ISA 55:7" /></para>
  <para style="q">
    <verse number="8-9" style="v" sid="ISA 55:8-9" />Lugundun mítaranti nisaminan kei hisaminan,</para>
  <para style="q" vid="ISA 55:8-9">mítaran nóuserun kei huguya.</para>
  <para style="q" vid="ISA 55:8-9">Ítara kei lóugiñeñein lan múa sielu,</para>
  <para style="q" vid="ISA 55:8-9">ítara giñe lóugiñeñein lan hisaminan luma hóuserun</para>
  <para style="q" vid="ISA 55:8-9">nisaminan luma nóuserun».</para>
  <para style="q" vid="ISA 55:8-9">Liña lariñagun Bungiu.<verse eid="ISA 55:8-9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 55:10" />«Ítara kei lararirun huya luma niewe siélugiñe,</para>
  <para style="q" vid="ISA 55:10">magiribudúnhali ñeinhin,</para>
  <para style="q" vid="ISA 55:10">lubaragiñe lira aba ladüdüragüdüni múa,</para>
  <para style="q" vid="ISA 55:10">arandaragüdalei, ru ligía ilaü lun ábunaguti,</para>
  <para style="q" vid="ISA 55:10">ru ligía fein lun teigín,<verse eid="ISA 55:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 55:11" />ítara liña giñe dimurei le áfuridubei niyumulugugiñe,</para>
  <para style="q" vid="ISA 55:11">magiribudúnti nun madügüngalei le nabusenrubei,</para>
  <para style="q" vid="ISA 55:11">lubaragiñe lira adüga lumuti le nabusenrubei,</para>
  <para style="q" vid="ISA 55:11">gúnfuli lumuti le nariñagubei.<verse eid="ISA 55:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ISA 55:12" />«Háfuriduba ñéingiñe lau ugundani,</para>
  <para style="q" vid="ISA 55:12">hagiribuduba hageiroun lau darangilaü,</para>
  <para style="q" vid="ISA 55:12">Danme larihinün burí wübü, leremuhaba lau ugundani,</para>
  <para style="q" vid="ISA 55:12">lapouhabei sun lídibu wewe le áraabubei lúhabu.<verse eid="ISA 55:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 55:13" />Láhüchüba lídibu gudi leweñegua hiiyu,</para>
  <para style="q" vid="ISA 55:13">leweñegua híduru péisiniti labouchuba lídibu fuluri</para>
  <para style="q" vid="ISA 55:13">laweiridagüdübei lira liri Aburemei,</para>
  <para style="q" vid="ISA 55:13">ábanbei seini magumuchaditi le magünrinchaguaditi».<verse eid="ISA 55:13" /></para>
  <chapter eid="ISA 55" />
  <chapter number="56" style="c" sid="ISA 56" />
  <para style="ms">III. Lǘrüwan Fánreinti</para>
  <para style="mr">(<ref loc="ISA 56-66">56—66</ref>)</para>
  <para style="s1">Hafayeiruaha ha gúnfulibaña luma daradu</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 56:1" />Lariñahare Bungiu: «Adüga humá irichaü,</para>
  <para style="q" vid="ISA 56:1">adüga huméi le úaraguabei,</para>
  <para style="q" vid="ISA 56:1">lugundun málühadina ánhana ñübuin esefuraün,</para>
  <para style="q" vid="ISA 56:1">narufudubei nubafu le lánina nasalbahan.<verse eid="ISA 56:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 56:2" />Fuleseiwatiña gürigia ha afalarubalin gumadi le,</para>
  <para style="q" vid="ISA 56:2">gúnfuli haméi lau úarani,</para>
  <para style="q" vid="ISA 56:2">ha inebehabubaña lun luéyuri emeraaguni</para>
  <para style="q" vid="ISA 56:2">ani mawiyedun hamuti,</para>
  <para style="q" vid="ISA 56:2">ha góunigibaña lun madügün hamá ni kata wuribati».<verse eid="ISA 56:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 56:3" />Anhein ederegeragua aban terencha lungua lun Aburemei,</para>
  <para style="q" vid="ISA 56:3">moun lumuti lariñagun:</para>
  <para style="q" vid="ISA 56:3">«Lígirubadina Bungiu dise hawéi lumutuniña».</para>
  <para style="q" vid="ISA 56:3">Moun lumuti giñe lariñagun wügüri le sáfunwaali:</para>
  <para style="q" vid="ISA 56:3">«Aban tídibu wewe mábeihali au».<verse eid="ISA 56:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 56:4" />Lugundun lariñahare Bungiu:</para>
  <para style="q" vid="ISA 56:4">«Anhein inebe luéyuri emeraaguni houn wügüriña safun,</para>
  <para style="q" vid="ISA 56:4">anhein hagunfulira nugundan,</para>
  <para style="q" vid="ISA 56:4">deregüdagua hagíame lidan nidaradun,<verse eid="ISA 56:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 56:5" />níchuguba katei buítimati houn sügǘ hau isaanigu;</para>
  <para style="q" vid="ISA 56:5">nadügüba lun lerederun hiri bürüwañu lun sun dan</para>
  <para style="q" vid="ISA 56:5">tidan nitenpulun lurageirugu nubarieirun;</para>
  <para style="q" vid="ISA 56:5">níchuguba aban iri magumuchaditi houn,</para>
  <para style="q" vid="ISA 56:5">le lunbei maguludúnwadügübei lan.<verse eid="ISA 56:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 56:6" />Terencha ha ederegeragutiña houngua nun lun heseriwidun nun,</para>
  <para style="q" vid="ISA 56:6">luma lun nínsiñedun houn lun nubúeingu hamá,</para>
  <para style="q" vid="ISA 56:6">anhein inebe luéyuri emeraaguni houn,</para>
  <para style="q" vid="ISA 56:6">ani madügün hagía katei le moun lumuti ladügǘn lidan weyu ligía,</para>
  <para style="q" vid="ISA 56:6">ani deregüdagua hagía lidan nidaradun,<verse eid="ISA 56:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 56:7" />nanügübaña luagun nuwübüri le sándubei,</para>
  <para style="q" vid="ISA 56:7">ábame nagundaaragüdüniña tidan nuban to lánina afurieiduni.</para>
  <para style="q" vid="ISA 56:7">Neresibirubei hadagaragüdün le gudawarügüti luagu nani latarü,</para>
  <para style="q" vid="ISA 56:7">lugundun lúbaana afurieiduni ligíaba tiri nuban houn sun gürigia.<verse eid="ISA 56:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 56:8" />Nadügüba lun hayabin luma lun hóundaragun</para>
  <para style="q" vid="ISA 56:8">ha añaheinguabaña lidan amu ageiraü keisi adaürǘtiña».</para>
  <para style="q" vid="ISA 56:8">Liña lariñagun Aburemei le adügübei lunya hóundaragun Ísüraelina ha meha chagagubaña.<verse eid="ISA 56:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 56:9" />Higougu animaalugu gáñitiña;</para>
  <para style="q" vid="ISA 56:9">higougu animaalugu áraabuna,</para>
  <para style="q" vid="ISA 56:9">higougu héigaña mudún;<verse eid="ISA 56:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 56:10" />lugundun marihinhaña hóuniri numutuniña,</para>
  <para style="q" vid="ISA 56:10">mefentiña luagu ni kata.</para>
  <para style="q" vid="ISA 56:10">Ounli mariñagaditiña sun hagía siñati háwouhan;</para>
  <para style="q" vid="ISA 56:10">róundügühaña sun weyu, ewenedüha,</para>
  <para style="q" vid="ISA 56:10">hínsiñeti houn harumugun.<verse eid="ISA 56:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 56:11" />Ounli lamatiña hagía, ha makimuledaditiña,</para>
  <para style="q" vid="ISA 56:11">hóuniri mudún ha úati gunfuranda hamá ni kata;</para>
  <para style="q" vid="ISA 56:11">falá lumuti kada aban lémeri le labusenrubei,</para>
  <para style="q" vid="ISA 56:11">lérügüñein buídubei houn háluaha.<verse eid="ISA 56:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 56:12" />Ariñagatiña: «Keimoun wáluaha diwéin</para>
  <para style="q" vid="ISA 56:12">luma uniñein héreti lun wabacharuadun.</para>
  <para style="q" vid="ISA 56:12">Haruga ábayame wadügün kei uguñe o sügǘ lan lau».<verse eid="ISA 56:12" /></para>
  <para style="b" />
  <chapter eid="ISA 56" />
  <chapter number="57" style="c" sid="ISA 57" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 57:1" />Hilaguatiña gürigia buítiña,</para>
  <para style="q" vid="ISA 57:1">ani úati ebereseruti hau;</para>
  <para style="q" vid="ISA 57:1">gumuguatiña gürigia buítiña,</para>
  <para style="q" vid="ISA 57:1">ani úati ni aban gunfurandati</para>
  <para style="q" vid="ISA 57:1">luagu dan lan le hóunwegun sefu hamá luéi wuribani,<verse eid="ISA 57:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 57:2" />aba hebelurun lidoun darangilaü.</para>
  <para style="q" vid="ISA 57:2">Falaaña meha aban üma suruti,</para>
  <para style="q" vid="ISA 57:2">guentó añahein emeraagua lidan hamúaha.<verse eid="ISA 57:2" /></para>
  <para style="s1">Lasiadiruni Aburemei láhudurawagun houn guáriuagu</para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 57:3" />Yarafa humá, tirahüñü gabiñarahatu,</para>
  <para style="q" vid="ISA 57:3">lirahüñü aban gagabarahati tau aban horu.<verse eid="ISA 57:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 57:4" />Ka au hadaagua bula?</para>
  <para style="q" vid="ISA 57:4">Ka un héheluha,</para>
  <para style="q" vid="ISA 57:4">ani chawagua huméi hiyuma?</para>
  <para style="q" vid="ISA 57:4">Lirahüñü figóu huguya,</para>
  <para style="q" vid="ISA 57:4">gürigia marasualugutiña;<verse eid="ISA 57:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 57:5" />adaaguatün sun luwuyeri iwiyei</para>
  <para style="q" vid="ISA 57:5">lábugiñe tídibu wewe hilumati,</para>
  <para style="q" vid="ISA 57:5">adagaragüda humaña hisaanigu laru duna</para>
  <para style="q" vid="ISA 57:5">labadinagua labouchagun dübü.<verse eid="ISA 57:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ISA 57:6" />«Ísüraeli,</para>
  <para style="q" vid="ISA 57:6">himei bumuti badügün kultu lun burí dübü guyeti le dúnarugubei,</para>
  <para style="q" vid="ISA 57:6">anihein aban ubaraü baranserun bubarua ñein.</para>
  <para style="q" vid="ISA 57:6">Rúhadibu idewesei le diwéin luma ilaü lun.</para>
  <para style="q" vid="ISA 57:6">Ani busentibu lun gúndaabadina lan lárigiñe sun le?<verse eid="ISA 57:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 57:7" />Ru bumutu bigabanan luagu aban wübü íñuti,</para>
  <para style="q" vid="ISA 57:7">warihadibu giñe adagaragüda ñein.<verse eid="ISA 57:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 57:8" />Ru bumutiña bubungiutegu ha wíyebaña lanagangiñe bubenari.</para>
  <para style="q" vid="ISA 57:8">Bulíeiguatibu nuéi, ragaguatibu</para>
  <para style="q" vid="ISA 57:8">aba barounrun tidan tidabuberen bigabanan;</para>
  <para style="q" vid="ISA 57:8">adügatibu daradu hama wügüriña ha</para>
  <para style="q" vid="ISA 57:8">úmabaña babusenra barounrun,</para>
  <para style="q" vid="ISA 57:8">abunha aríaguei guáriua.<verse eid="ISA 57:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 57:9" />«Éibaaguatibu lumoun bungiu Mélekü</para>
  <para style="q" vid="ISA 57:9">barüina garaba luma saragu ibiñein;</para>
  <para style="q" vid="ISA 57:9">óunahatibu láutiña uganu dise,</para>
  <para style="q" vid="ISA 57:9">rarigüda bumutiña chülǘ lidoun umúahaü.<verse eid="ISA 57:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 57:10" />Buchati buagu adaagua wéiyaasu,</para>
  <para style="q" vid="ISA 57:10">gama lumoun masubudirun bumuti luagu mala lan sun lira.</para>
  <para style="q" vid="ISA 57:10">Géigintibu búmagua,</para>
  <para style="q" vid="ISA 57:10">ligía mabuchadun lubéi buagu.<verse eid="ISA 57:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ISA 57:11" />«Kátaña búngiugu ha, ha meha uéibaña banufudeda</para>
  <para style="q" vid="ISA 57:11">ani ru buguya inebesei houn,</para>
  <para style="q" vid="ISA 57:11">magunfulirun bubéi numa,</para>
  <para style="q" vid="ISA 57:11">aba babulieidunina le gumuti.</para>
  <para style="q" vid="ISA 57:11">Dan meha le michu ban inebesei nun</para>
  <para style="q" vid="ISA 57:11">ábaha nerederun maniñu.<verse eid="ISA 57:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 57:12" />Gama lumoun nasubudiragüdaali bigaburi</para>
  <para style="q" vid="ISA 57:12">le buídubei lidan baritagun.<verse eid="ISA 57:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 57:13" />Danme bagúarahan amuriaha íderawaguni,</para>
  <para style="q" vid="ISA 57:13">míderagun habadibu bubungiutegu mesefu hamabume.</para>
  <para style="q" vid="ISA 57:13">Lanügübaña garabali sun hagía;</para>
  <para style="q" vid="ISA 57:13">lagumuchaguagüdübaña aban láfurun garabali.</para>
  <para style="q" vid="ISA 57:13">Ánheinti le hemenigiti nuagu,</para>
  <para style="q" vid="ISA 57:13">laganóuba fulasurugu luagu nuwübüri le sándubei».<verse eid="ISA 57:13" /></para>
  <para style="s1">Labeichún luma lareidaguagüdüniwa Ísüraeli</para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 57:14" />Ábameti laganbún lariñawagún:</para>
  <para style="q" vid="ISA 57:14">«Aranse humá aban üma úaraguati,</para>
  <para style="q" vid="ISA 57:14">gidá huméi katei le burí beresebei ñein</para>
  <para style="q" vid="ISA 57:14">sügǘ hamaamuga numutuniña».<verse eid="ISA 57:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 57:15" />Ladüga lariñahare le Íñugutimabei,</para>
  <para style="q" vid="ISA 57:15">le wínwanbei lun sun dan le sándubei liri:</para>
  <para style="q" vid="ISA 57:15">«Lidan aban fulasu íñuti ani sagüráuti naganóua,</para>
  <para style="q" vid="ISA 57:15">gama lumoun anahein giñe luma le ǘnabugubei ani nidiheri ligía,</para>
  <para style="q" vid="ISA 57:15">ani rútina gurasu luma dǘgüdaguaü lun.<verse eid="ISA 57:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 57:16" />Meredebadina íchiga hadurun numutuniña súnwandan,</para>
  <para style="q" vid="ISA 57:16">merede aume gáñiñu sun dan;</para>
  <para style="q" vid="ISA 57:16">ladüga anhein nadüga ítara,</para>
  <para style="q" vid="ISA 57:16">heferidirubei gürigia ha nadügübaña haguraasun nuagu.<verse eid="ISA 57:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 57:17" />Ladüga lifigoun Ísüraeli nerederunbei gáñiñu aban dan,</para>
  <para style="q" vid="ISA 57:17">aba nabeichuni, aba nadisedun luéi;</para>
  <para style="q" vid="ISA 57:17">gama lumoun aba larufuduni lumabuchahan</para>
  <para style="q" vid="ISA 57:17">aba hasigirun lidan hémeri.<verse eid="ISA 57:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 57:18" />Ariha naali ligaburi,</para>
  <para style="q" vid="ISA 57:18">gama lumoun nagaranihaba lun ábame níchugun emeraaguni lun</para>
  <para style="q" vid="ISA 57:18">luma darangilaü le gumuti.</para>
  <para style="q" vid="ISA 57:18">Níchuguba dǘgüdaguaü houn ha hírubaña,<verse eid="ISA 57:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 57:19" />nariñagame houn súngubei:</para>
  <para style="q" vid="ISA 57:19">“Darangilaü houn ha dísebaña,</para>
  <para style="q" vid="ISA 57:19">darangilaü houn ha yarafabaña!</para>
  <para style="q" vid="ISA 57:19">Nareidaguagüdübaña numutuniña!”<verse eid="ISA 57:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 57:20" />Ánhaña ha salufuribaña, ítara haña kei barana dan le lérouga,</para>
  <para style="q" vid="ISA 57:20">siñati lagalumadun, barüti baribarabu luma iwiyei lidan lugudi.<verse eid="ISA 57:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 57:21" />Úati lubuidun dan houn ha wuribabaña».</para>
  <para style="q" vid="ISA 57:21">Bungiu ariñagubalin.<verse eid="ISA 57:21" /></para>
  <chapter eid="ISA 57" />
  <chapter number="58" style="c" sid="ISA 58" />
  <para style="s1">Ayunaruni le tímatimaati</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 58:1" />Lariñahare Bungiu nun:</para>
  <para style="q" vid="ISA 58:1">«Wáguaba here manufudeuga,</para>
  <para style="q" vid="ISA 58:1">iñurabéi bumala kei aban fidu;</para>
  <para style="q" vid="ISA 58:1">badeinha houn numutuniña luagu hadurun,</para>
  <para style="q" vid="ISA 58:1">houn lánigu Hakobu luagu hafigoun.<verse eid="ISA 58:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 58:2" />Áluaha hamutina sagü weyu</para>
  <para style="q" vid="ISA 58:2">ani gúndaatiña lau hasubudiruni némeri,</para>
  <para style="q" vid="ISA 58:2">kamá hamuga gürigia ha adügübalin le buídubei hagía,</para>
  <para style="q" vid="ISA 58:2">ha mígirunbalin nilurudun;</para>
  <para style="q" vid="ISA 58:2">amuriahatiña lúrudu richati numa</para>
  <para style="q" vid="ISA 58:2">ani arufuda haméi hagundan lau hayarafadun nun,<verse eid="ISA 58:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 58:3" />gama lumoun ariñagatiña:</para>
  <para style="q" vid="ISA 58:3">“Kaba uagu wayunara, marihingalawa Bungiu?</para>
  <para style="q" vid="ISA 58:3">Kaba uagu wáfaagua, mefentiga luagu?”</para>
  <para style="q" vid="ISA 58:3">Barǘ hamuti luéyuri ayunaruni lun hagañeihan luma lun halugurahan,</para>
  <para style="q" vid="ISA 58:3">luma lun hasufuriragüdüniña nadagimeintiña houn.<verse eid="ISA 58:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 58:4" />Sügǘ hamuti luéyuri ayunaruni asigeneha, ageindagua,</para>
  <para style="q" vid="ISA 58:4">luma agayuaha tau agufudein.</para>
  <para style="q" vid="ISA 58:4">Luéyuri ayunaruni ítarati</para>
  <para style="q" vid="ISA 58:4">siñabei ladügün lun naganbuni hafurieidun.<verse eid="ISA 58:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 58:5" />Haritaguatün san luagu ayunaruni lan le aubei nagundaara</para>
  <para style="q" vid="ISA 58:5">lunti lan hadiheridun, habuluchagun kei aban góunwenre,</para>
  <para style="q" vid="ISA 58:5">luma lun harounrun tau daüguaü súsutu ligibuagu baligi?</para>
  <para style="q" vid="ISA 58:5">Anihán le unbei hagúara “ayunaruni”,</para>
  <para style="q" vid="ISA 58:5">luma “weyu auti lagundaara Bungiu”?<verse eid="ISA 58:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 58:6" />Mama liña.</para>
  <para style="q" vid="ISA 58:6">Anihán ayunaruni le aubei nagundaara:</para>
  <para style="q" vid="ISA 58:6">Lun hátumuraguni ligüringürin marichaü,</para>
  <para style="q" vid="ISA 58:6">luma lun hafaragaduni lagu gürati le ámurudubalin yugu;</para>
  <para style="q" vid="ISA 58:6">lun hígiragüdüniña ha asufurirubaña,</para>
  <para style="q" vid="ISA 58:6">gumuguagüda humeime amudirawaguni;<verse eid="ISA 58:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 58:7" />lun bafanreinragunu beigan fein luma le lamabei,</para>
  <para style="q" vid="ISA 58:7">resibibéime le gudemebei búbiñe;</para>
  <para style="q" vid="ISA 58:7">lun bíchugun daüguaü lun le madaüragunbei</para>
  <para style="q" vid="ISA 58:7">mígirun buguyame bíderaguniña gürigia bíledigu.<verse eid="ISA 58:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 58:8" />Ábameti larugoungadun bilanpun kei larugadun,</para>
  <para style="q" vid="ISA 58:8">ábame lareidagun bibugún furese.</para>
  <para style="q" vid="ISA 58:8">Lídiba biricha bubá bubá,</para>
  <para style="q" vid="ISA 58:8">lídinme nuéirigun bárigi, bárigi.<verse eid="ISA 58:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 58:9" />Ánhabumeti agúara nun, nóunabubadibu;</para>
  <para style="q" vid="ISA 58:9">ánhabu agúaragua amuriaha íderawaguni,</para>
  <para style="q" vid="ISA 58:9">nariñaguba bun: “Anahán ya”.</para>
  <para style="q" vid="ISA 58:9">«Anhein bagumuchaguagüda sun asufuriruni,</para>
  <para style="q" vid="ISA 58:9">ánhabu manabun gürigia,</para>
  <para style="q" vid="ISA 58:9">ánhabu madimurehan biyeeni hawagu amu íchiga hadurun,<verse eid="ISA 58:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 58:10" />ánhabu íchaagua bungua lun beseriwidun lun le lamabei,</para>
  <para style="q" vid="ISA 58:10">anhein bíderagua le nidiheribei lau le lemegeirubei,</para>
  <para style="q" vid="ISA 58:10">laduranguba bilanpun lidan luburiga,</para>
  <para style="q" vid="ISA 58:10">lasaliraguba bamuñadina larugounganme le lánina amidi.<verse eid="ISA 58:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 58:11" />Nadundehabadibu súnwandan,</para>
  <para style="q" vid="ISA 58:11">níchuguba saragu éigini bun lidan fulasu mageirawati,</para>
  <para style="q" vid="ISA 58:11">níchuguba erei lun búgubu,</para>
  <para style="q" vid="ISA 58:11">ítara buba kei aban fuluri-agei le túaguati buidu,</para>
  <para style="q" vid="ISA 58:11">kei aban lísensen duna le mamabeidaditi.<verse eid="ISA 58:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 58:12" />Hábunaguayabei bumutuniña lárigirugu binadu fulasu,</para>
  <para style="q" vid="ISA 58:12">ábame hachoururuni luagaburi le meha ábunawagubei</para>
  <para style="q" vid="ISA 58:12">saragu sígulu lubaragiñe guentó.</para>
  <para style="q" vid="ISA 58:12">Lariñawagúba houn bánigu “aransehatiña baríeiru héiguaali”,</para>
  <para style="q" vid="ISA 58:12">“araramagüdütiña muna günringuaaru”.<verse eid="ISA 58:12" /></para>
  <para style="s1">Libügürü luéyuri emeraaguni</para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 58:13" />«Inebelá luéyuri emeraaguni bun;</para>
  <para style="q" vid="ISA 58:13">madaaguabá marasun lidan nuéyuri le sándubei.</para>
  <para style="q" vid="ISA 58:13">Barübei weyu ligía kei luéyuri ugundani,</para>
  <para style="q" vid="ISA 58:13">kei luéyuri Bungiu le sándubei, le lunti inebewa lan;</para>
  <para style="q" vid="ISA 58:13">ruba inebesei lun lau míchaagun ban bungua lun katei le bani,</para>
  <para style="q" vid="ISA 58:13">máluahanbeime burí katei le búnguarügüti,</para>
  <para style="q" vid="ISA 58:13">madaagun buguyame marasun.<verse eid="ISA 58:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 58:14" />Anhein badüga ítara, badarirubei bugundan nidan,</para>
  <para style="q" vid="ISA 58:14">ábame nanügünibu luagun liñun ageiraü,</para>
  <para style="q" vid="ISA 58:14">ábame bayusuruni lalagante Hakobu le búguchi».</para>
  <para style="q" vid="ISA 58:14">Aburemei guánarügü ariñagubalin.<verse eid="ISA 58:14" /></para>
  <chapter eid="ISA 58" />
  <chapter number="59" style="c" sid="ISA 59" />
  <para style="s1">Lidurun luma labeichún Ísüraeli</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 59:1" />Malouguadungili lubafu Bungiu lun mesefuhanhaali lan,</para>
  <para style="q" vid="ISA 59:1">mamaganbadidun ligía lun lásiñaruba lan laganbun.<verse eid="ISA 59:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 59:2" />Gama lumoun fánreinguagüda laadün huriban luma Bungiu,</para>
  <para style="q" vid="ISA 59:2">adügaali hifigoun lun ladouragun Bungiu lau ligibu,</para>
  <para style="q" vid="ISA 59:2">luma lun lamaharun laganbunün.<verse eid="ISA 59:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 59:3" />Dáseiñu liña húhabu lau hitaü,</para>
  <para style="q" vid="ISA 59:3">dáseiñu hifinga lau áfarahani;</para>
  <para style="q" vid="ISA 59:3">adimurehati hiyuma iyeeni,</para>
  <para style="q" vid="ISA 59:3">ariñaga hiñeñe wuribani.<verse eid="ISA 59:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 59:4" />Úati ariñaguti katei richati hidan,</para>
  <para style="q" vid="ISA 59:4">ua ligía aguseragüdüti lau arumani.</para>
  <para style="q" vid="ISA 59:4">Afiñetimatün luagu iyeeni luma burí dimurei málati;</para>
  <para style="q" vid="ISA 59:4">dageinañadün wuribani, háguraha áfarahani.<verse eid="ISA 59:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 59:5" />Emeilihatün tigañén hewe,</para>
  <para style="q" vid="ISA 59:5">adaagua huguya hágüra gúnrenren;</para>
  <para style="q" vid="ISA 59:5">le éigitiña gañé hagía, hilati,</para>
  <para style="q" vid="ISA 59:5">ánhaña aburechawagúa,</para>
  <para style="q" vid="ISA 59:5">aba háfuridun hewe péisinitiña hádangiñe.<verse eid="ISA 59:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 59:6" />Madügǘntu daüguaü lau hágüra gúnrenren ligia;</para>
  <para style="q" vid="ISA 59:6">siñati ladaüragun ni aban lau le háhüchagubei.</para>
  <para style="q" vid="ISA 59:6">Sun le hadügübei lánina áfarahani,</para>
  <para style="q" vid="ISA 59:6">lun ladügün háhabu wuribani luadigimarida.<verse eid="ISA 59:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 59:7" />Lun héibaagun adüga wuribani leseriwida hagudi houn,</para>
  <para style="q" vid="ISA 59:7">lun hóufudahan áwiyura hitaü le hata maduruntiña.</para>
  <para style="q" vid="ISA 59:7">Luagu áfarahani hasaminara,</para>
  <para style="q" vid="ISA 59:7">günringuaürügüñein hígira hárigiñe.<verse eid="ISA 59:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 59:8" />Ibidiñeti lémeri darangilaü houn,</para>
  <para style="q" vid="ISA 59:8">úati ísuruni lidan hóuserun.</para>
  <para style="q" vid="ISA 59:8">Segeti üma burí le hafalarubei;</para>
  <para style="q" vid="ISA 59:8">ha éibugubaña lidan üma ligía,</para>
  <para style="q" vid="ISA 59:8">madaritiña darangilaü.<verse eid="ISA 59:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ISA 59:9" />Ligía díseeli lubéi esefuruni wawéi,</para>
  <para style="q" vid="ISA 59:9">mayarafadunti esefuruni woun;</para>
  <para style="q" vid="ISA 59:9">agurabatiwa yebe larugounga,</para>
  <para style="q" vid="ISA 59:9">aba liabin luburiga,</para>
  <para style="q" vid="ISA 59:9">agurabatiwa yebe lanpu,</para>
  <para style="q" vid="ISA 59:9">gama lumoun lídanñadiwa meha luburiga.<verse eid="ISA 59:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 59:10" />Adandiaharügü wéibuga kei marihintiña lubadu touba muna,</para>
  <para style="q" vid="ISA 59:10">kamá hamuga mágutiwa.</para>
  <para style="q" vid="ISA 59:10">Chugeguatiwa wéyuagu kamá hamuga áriebuhaali;</para>
  <para style="q" vid="ISA 59:10">lau sun gátuadi wamá, kamá hamuga hilaadiwa.<verse eid="ISA 59:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 59:11" />Agülülühatiwa sun wagía kamá osu,</para>
  <para style="q" vid="ISA 59:11">áünhatiwa kei unhun;</para>
  <para style="q" vid="ISA 59:11">agurabatiwa irichaü gama lumoun miábinti;</para>
  <para style="q" vid="ISA 59:11">aguraba wamuti esefuruni gama lumoun díseti wawéi.<verse eid="ISA 59:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 59:12" />Anabagua wamaadibu saragu,</para>
  <para style="q" vid="ISA 59:12">arufuda lumuti wafigoun guánarügü wadurun,</para>
  <para style="q" vid="ISA 59:12">aríagu waña lun wadurun,</para>
  <para style="q" vid="ISA 59:12">ani subudi wamuti wariban.<verse eid="ISA 59:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 59:13" />Mabuchahatiwa meha ani magunfulin wagía luma Aburemei,</para>
  <para style="q" vid="ISA 59:13">máhatiwa buga wafalaruni Wabungiute,</para>
  <para style="q" vid="ISA 59:13">adimurehaadiwa luagu anarimeni luma agarabaaguni</para>
  <para style="q" vid="ISA 59:13">aransehaadiwa lun weyeeraguniña híbiri.<verse eid="ISA 59:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 59:14" />Rúhadiwa mebereseni luagu irichaü,</para>
  <para style="q" vid="ISA 59:14">díseti úaraguni wawéi,</para>
  <para style="q" vid="ISA 59:14">chugeguati inarüni luagu párüke,</para>
  <para style="q" vid="ISA 59:14">siñati larufudagun arumani lungua.<verse eid="ISA 59:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 59:15" />Gumugua inarüni,</para>
  <para style="q" vid="ISA 59:15">éibaahouatiña ha adisedutiña luéi wuribani.</para>
  <para style="b" vid="ISA 59:15" />
  <para style="q" vid="ISA 59:15">Gáñihali Bungiu lau larihin luagu ua lan richaguaü.<verse eid="ISA 59:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 59:16" />Wéiritu lanigi lau larihin luagu ua lan ni aban íderaguti lumutuniña;</para>
  <para style="q" vid="ISA 59:16">ábati lanügün esefuruni lau lubafu guánarügü,</para>
  <para style="q" vid="ISA 59:16">aba lagañeirun, ladüga ligía lan Bungiu le richaguabei.<verse eid="ISA 59:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 59:17" />Daruguati laugua lau agañeiruni kei tau aban daüguaü lánina wuribu,</para>
  <para style="q" vid="ISA 59:17">daü lumuti esefuruni kei aban bunidi lánina wuribu,</para>
  <para style="q" vid="ISA 59:17">dáüguati lau láguyugüdüniwa wuribani kei tau aban dúnigu,</para>
  <para style="q" vid="ISA 59:17">hóuburaguati lungua lau igañi kei tau aban manda.<verse eid="ISA 59:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 59:18" />Lafayeirubei Bungiu le ladünabei kada aban lun;</para>
  <para style="q" vid="ISA 59:18">labeichagubaña láganiñu.</para>
  <para style="q" vid="ISA 59:18">Líchugubei le hadünabei, ha iyereehabúbaña lun houn,</para>
  <para style="q" vid="ISA 59:18">líchugubei giñe houn ha aganóubaña luagu burí ubouhu.<verse eid="ISA 59:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 59:19" />Sunme gürigia lúmagiñe oubaü le ñéingiñe lubéi laboucha weyu</para>
  <para style="q" vid="ISA 59:19">lumoun le ñeinhin lubéi lálüda,</para>
  <para style="q" vid="ISA 59:19">linebeduba Aburemei houn danme harihini luéirigun.</para>
  <para style="q" vid="ISA 59:19">Lugundun liábinba kei aban duna afuluduhati le liñuraguagüdün aban garabali héreti.<verse eid="ISA 59:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 59:20" />Liábinba keisi lesefuragüle Sión hama sun ladügawagun Hakobu</para>
  <para style="q" vid="ISA 59:20">ha asakürihatiña lídangiñe hafigoun.</para>
  <para style="q" vid="ISA 59:20">Bungiu ariñagubalin.<verse eid="ISA 59:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="ISA 59:21" />Lariñahare Bungiu:</para>
  <para style="q" vid="ISA 59:21">«Adügatina aban daradu huma,</para>
  <para style="q" vid="ISA 59:21">ani füramasetina hun luagu madisedunbei lan nubafu</para>
  <para style="q" vid="ISA 59:21">ni arufudahani le ru naalibei hun huéi</para>
  <para style="q" vid="ISA 59:21">ni hawéi hadügawagun lun sun dan».<verse eid="ISA 59:21" /></para>
  <chapter eid="ISA 59" />
  <chapter number="60" style="c" sid="ISA 60" />
  <para style="s1">Luéirigun iseri Herusalén</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 60:1" />Saraba, Herusalén, hóuburagu lidan larugounga,</para>
  <para style="q" vid="ISA 60:1">lugundun chülühali bilanpun,</para>
  <para style="q" vid="ISA 60:1">ani harugoungati luéirigun Bungiu buagu.<verse eid="ISA 60:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 60:2" />Daruguati luburiga lau ubóu,</para>
  <para style="q" vid="ISA 60:2">hóuburagua lumutiña luburiga néchanigu,</para>
  <para style="q" vid="ISA 60:2">gama lumoun larugoungadagüdüba Bungiu bau,</para>
  <para style="q" vid="ISA 60:2">ábame lasaliragun luéirigun buagu.<verse eid="ISA 60:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 60:3" />Hayabinba néchanigu luagun bilanpun,</para>
  <para style="q" vid="ISA 60:3">héibuguba urúeigu lábugiñe larugounga barugadun.<verse eid="ISA 60:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 60:4" />Iñurabéi barihin, arihabá geyegua bau:</para>
  <para style="q" vid="ISA 60:4">Óundaraguatiña súngubei, aba hayabin bumoun.</para>
  <para style="q" vid="ISA 60:4">Hayabinba birahüñü dísegiñe,</para>
  <para style="q" vid="ISA 60:4">hanügǘba óuyuahouarügü.<verse eid="ISA 60:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 60:5" />Danme barihiniña, babuinchuba lau ugundani,</para>
  <para style="q" vid="ISA 60:5">tagundaruba banigi;</para>
  <para style="q" vid="ISA 60:5">lanügǘba lirisin burí ubouhu bun.</para>
  <para style="q" vid="ISA 60:5">Lederegeruba harisin néchanigu bun.<verse eid="ISA 60:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 60:6" />Ñéinbaña saragu kameyu buma,</para>
  <para style="q" vid="ISA 60:6">ha ñǘbuintiña Madiangiñe luma Efaagiñe;</para>
  <para style="q" vid="ISA 60:6">hayabinba sun Sabaana lau golu luma kupali,</para>
  <para style="q" vid="ISA 60:6">ábame hadimurehan luagu luéirigun Aburemei.<verse eid="ISA 60:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 60:7" />Sun ibiñanigu ha Kedarübaña bilügüniñabaña;</para>
  <para style="q" vid="ISA 60:7">heseriwiduba gábara ha Nebaiotubaña bun,</para>
  <para style="q" vid="ISA 60:7">lun badagaragüdüniña lun Bungiu luagu lani latarü</para>
  <para style="q" vid="ISA 60:7">keisi idewesei le aubei lagundaara,</para>
  <para style="q" vid="ISA 60:7">ábame labuiduragüdünutima litenpulun.<verse eid="ISA 60:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 60:8" />Kátaña san ha, ha áhamahabaña kei dúeri,</para>
  <para style="q" vid="ISA 60:8">ha ñǘdünbaña kei unhun lidoun hádibu?<verse eid="ISA 60:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 60:9" />Waporu burí to ñǘbuinboun úara tuma</para>
  <para style="q" vid="ISA 60:9">burí ugunei Tárüsisina tubá tubá,</para>
  <para style="q" vid="ISA 60:9">barüina birahüñü dísegiñe lau hagolun luma hani pülata,</para>
  <para style="q" vid="ISA 60:9">lidan liri Babureme le Bungiu Sánduti le Lubungiute Ísüraeli,</para>
  <para style="q" vid="ISA 60:9">le íchugubei uéiriguni bun.<verse eid="ISA 60:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 60:10" />Hararamagüdayabei gürigia terencha bubarieirun,</para>
  <para style="q" vid="ISA 60:10">seriwi hagíame harúeitegu bun;</para>
  <para style="q" vid="ISA 60:10">lugundun lau sun bei lánibu Bungiu lidan ligañi,</para>
  <para style="q" vid="ISA 60:10">guentó gudemehabuhaali bun lidan lareini.<verse eid="ISA 60:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 60:11" />Hunren luba bubenari súnwandan;</para>
  <para style="q" vid="ISA 60:11">madourúnbei ni áriebu ni wéyuagu,</para>
  <para style="q" vid="ISA 60:11">lun gayara lan lanügüni harisin néchanigu bun,</para>
  <para style="q" vid="ISA 60:11">luma lun hebelurun urúeigu hau hánigu.<verse eid="ISA 60:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 60:12" />Lagumuchaguba ageiraü le meseriwidunti bun;</para>
  <para style="q" vid="ISA 60:12">lagünrinchawaguba burí néchanigu dayarüti.<verse eid="ISA 60:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ISA 60:13" />Ítara liña lariñagun Aburemei lun Herusalén:</para>
  <para style="q" vid="ISA 60:13">«Liábinguaba lirisin Líwanu bun:</para>
  <para style="q" vid="ISA 60:13">Gudi, abetu luma sipürési lun tewendedun nitenpulun,</para>
  <para style="q" vid="ISA 60:13">lun líchugun uéiriguni lun fulasu le ñein lubéi níchigei nugudi.<verse eid="ISA 60:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 60:14" />Hayabinba hasaanigu ha buga asufuriragüdübalibu abuluchagua bigibugiñe,</para>
  <para style="q" vid="ISA 60:14">sun buga ha íchugubaña mebereseni bau,</para>
  <para style="q" vid="ISA 60:14">háhuduraguba bigibugiñe,</para>
  <para style="q" vid="ISA 60:14">hariñagame bun: “Luburugute Bungiu”,</para>
  <para style="q" vid="ISA 60:14">“Sión le lani Bungiu Sánduti le Lubungiute Ísüraeli”.<verse eid="ISA 60:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ISA 60:15" />«Merededigiaadibu lidan bulíeiguaü, iyereeguñu, bábugua,</para>
  <para style="q" vid="ISA 60:15">nadügüba lun wéirigu ban gumugua dan,</para>
  <para style="q" vid="ISA 60:15">lun lébuna ban ugundani súnwandan.<verse eid="ISA 60:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 60:16" />Híchugubei néchanigu lubuidun-agei heigin bun,</para>
  <para style="q" vid="ISA 60:16">hanügübei urúeigu harisin bun;</para>
  <para style="q" vid="ISA 60:16">ábame basubudiruni luagu au lan le Bungiu Basalbaragülebei,</para>
  <para style="q" vid="ISA 60:16">luagu au lan le gabafubei Besefuragülebei.<verse eid="ISA 60:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ISA 60:17" />«Níchuguba golu bun leweñegua buronse,</para>
  <para style="q" vid="ISA 60:17">pülata leweñegua gürabu,</para>
  <para style="q" vid="ISA 60:17">buronse leweñegua wewe,</para>
  <para style="q" vid="ISA 60:17">gürabu leweñegua dübü.</para>
  <para style="q" vid="ISA 60:17">Nadügüba lun labugurunibu darangilaü,</para>
  <para style="q" vid="ISA 60:17">luma lun ladundehanibu úaraguni.<verse eid="ISA 60:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 60:18" />Maganbúnhalime lumalali anarimeni bageira,</para>
  <para style="q" vid="ISA 60:18">úadigiaalime günringuaü bumúanrugu,</para>
  <para style="q" vid="ISA 60:18">bariñaguba lun bubarieirun “Esefuruni”</para>
  <para style="q" vid="ISA 60:18">lun bubenari “Alawahani”.<verse eid="ISA 60:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="ISA 60:19" />«Memegeirúnhadibume larugounga weyu wéyuagu,</para>
  <para style="q" vid="ISA 60:19">ni laruni hati áriebu;</para>
  <para style="q" vid="ISA 60:19">lugundun au, le Aburemei auba bilanpun gumugua dan;</para>
  <para style="q" vid="ISA 60:19">au le Aburemei, auba larugounga bau.<verse eid="ISA 60:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 60:20" />Málüdünhalime weyu bun,</para>
  <para style="q" vid="ISA 60:20">mabulubudun ligíame hati,</para>
  <para style="q" vid="ISA 60:20">ladüga au le Aburemei, auba bilanpun gumugua dan;</para>
  <para style="q" vid="ISA 60:20">báguruba ludu.<verse eid="ISA 60:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="ISA 60:21" />Gürigiabaña harumatiña sun lílana bageira,</para>
  <para style="q" vid="ISA 60:21">laburiñabaña hageira lun sun dan,</para>
  <para style="q" vid="ISA 60:21">láhüchagun aban nadü le nábunubei,</para>
  <para style="q" vid="ISA 60:21">wadagimanu le nadügübei lau núhabu lun narufuduni nuéirigun.<verse eid="ISA 60:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 60:22" />Ha míbebañaha, hóustaruba milu;</para>
  <para style="q" vid="ISA 60:22">bianraü gürigia ha, ábanbaña óunwenbu néchani.</para>
  <para style="q" vid="ISA 60:22">Au Aburemeibei, nadügüba lun lasuseredun furese,</para>
  <para style="q" vid="ISA 60:22">danme lachülürün dan ligía».<verse eid="ISA 60:22" /></para>
  <chapter eid="ISA 60" />
  <chapter number="61" style="c" sid="ISA 61" />
  <para style="s1">Lesefurun Ísüraeli</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 61:1" />Anihein lani Bungiu sífiri nuagu,</para>
  <para style="q" vid="ISA 61:1">lugundun anúadira láadina Bungiu;</para>
  <para style="q" vid="ISA 61:1">óunaha láadina apurichihei iseri uganu houn gudemetiña,</para>
  <para style="q" vid="ISA 61:1">awalidaguagüdaña ha nidiheribaña,</para>
  <para style="q" vid="ISA 61:1">adimureha houn adaürǘtiña ha furisunrugubaña luagu áfuriduni;<verse eid="ISA 61:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 61:2" />íchigei uganu houn gürigia,</para>
  <para style="q" vid="ISA 61:2">luagu chülühali lan weyu,</para>
  <para style="q" vid="ISA 61:2">luéyuri lesefuruniña Bungiu lumutuniña,</para>
  <para style="q" vid="ISA 61:2">weyu le lunbei lageindagun Wabungiute hama wáganiñu waweigiñe,</para>
  <para style="q" vid="ISA 61:2">óunaha láadina ámalihaña sun ha hírubaña,<verse eid="ISA 61:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 61:3" />íchiga aban ridi lánina ugundani</para>
  <para style="q" vid="ISA 61:3">houn lílana Sión ha nidiheribaña leweñegua íruni,</para>
  <para style="q" vid="ISA 61:3">ibiñein lánina ugundani leweñegua águiraü,</para>
  <para style="q" vid="ISA 61:3">daüguaü lánina fedu teweñegua ludu.</para>
  <para style="q" vid="ISA 61:3">Hadügübei le úaraguabei,</para>
  <para style="q" vid="ISA 61:3">ítara haba kei tídibu wewe</para>
  <para style="q" vid="ISA 61:3">le lábunagubei Bungiu lun larufuduni luéirigun.<verse eid="ISA 61:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 61:4" />Lábunawaguayaba le günringuawaalibei,</para>
  <para style="q" vid="ISA 61:4">tararamayaba binadu burí muna to meha günrinwaguaaruboun lúmagiñe binarü,</para>
  <para style="q" vid="ISA 61:4">aransehóua ligíame uburugu burí le günringuaalibei.<verse eid="ISA 61:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ISA 61:5" />Hóunigirubaña terencha hibiñanigu,</para>
  <para style="q" vid="ISA 61:5">hichari tuma burí hinadürigu beibei.<verse eid="ISA 61:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 61:6" />Hariñagame hun: Lufadirinigu Aburemei,</para>
  <para style="q" vid="ISA 61:6">eseriwidutiña lun Wabungiute.</para>
  <para style="q" vid="ISA 61:6">Héigibei harisin amu néchanigu,</para>
  <para style="q" vid="ISA 61:6">daügua humeime hawenden.<verse eid="ISA 61:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 61:7" />Ani kei súfurihadün lubéi ǘnabuguni luma anabúni dóbuli,</para>
  <para style="q" vid="ISA 61:7">heresibiruba dóbuli irisini hageira,</para>
  <para style="q" vid="ISA 61:7">ani magumuchadibei hugundan.<verse eid="ISA 61:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 61:8" />Lugundun hínsiñeti irichaü lun Aburemei,</para>
  <para style="q" vid="ISA 61:8">iyereeguti íweruhani luma áfarahani lun.</para>
  <para style="q" vid="ISA 61:8">Líchugubei hafayeiruaha houn,</para>
  <para style="q" vid="ISA 61:8">ábame ladügün aban daradu magumuchaditi hama.<verse eid="ISA 61:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 61:9" />Subudiwabaña hadügawagun hadan néchanigu;</para>
  <para style="q" vid="ISA 61:9">sunme ha arihitiña,</para>
  <para style="q" vid="ISA 61:9">hasubudirubei luagu gürigia lan ha biní laaña Aburemei hagía.<verse eid="ISA 61:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 61:10" />Gúndaatina luma Aburemei!</para>
  <para style="q" vid="ISA 61:10">Buin niña lau ugundani luma Nubungiute,</para>
  <para style="q" vid="ISA 61:10">lugundun sefu láadina, gáñeigüda láadina.</para>
  <para style="q" vid="ISA 61:10">Ítara niña kei aban adari le adaürüti liridin,</para>
  <para style="q" vid="ISA 61:10">o kei lan aban adari to ewendedutu lau burí tílagu lauti golu.<verse eid="ISA 61:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 61:11" />Lugundun ítara kei láhüchün nadü,</para>
  <para style="q" vid="ISA 61:11">hüchagua ligía fuluri hilaali lidan fuluri-agei,</para>
  <para style="q" vid="ISA 61:11">ítara luba ladügün Aburemei lun láhüchün lagañeirun,</para>
  <para style="q" vid="ISA 61:11">ábame heremuhan sun néchanigu lun.<verse eid="ISA 61:11" /></para>
  <chapter eid="ISA 61" />
  <chapter number="62" style="c" sid="ISA 62" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 62:1" />Ladüga nínsiñehabu bun, Sión, mámanichunbadina;</para>
  <para style="q" vid="ISA 62:1">ladüga nínsiñehabu bun, Herusalén,</para>
  <para style="q" vid="ISA 62:1">memeraagunbadina darime lámiridun bagañeirun kei larugadun</para>
  <para style="q" vid="ISA 62:1">luma besefurun kei aban tochi durunguati.<verse eid="ISA 62:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 62:2" />Harihubei néchanigu besefurun,</para>
  <para style="q" vid="ISA 62:2">harihubei sun urúeigu buéirigun.</para>
  <para style="q" vid="ISA 62:2">Ábameti líchugun Bungiu aban iri iseri buagu.<verse eid="ISA 62:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 62:3" />Ábanbadibu lubuidunmeraü liridin</para>
  <para style="q" vid="ISA 62:3">urúei lúhaburugu Aburemei.<verse eid="ISA 62:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 62:4" />Mariñawagúnhalime bun «Igirúaaru»</para>
  <para style="q" vid="ISA 62:4">mariñawagúnme lun bumúan «Günrinwaguaali»,</para>
  <para style="q" vid="ISA 62:4">«To hínsiñetimaboun nun» ligíaba biri,</para>
  <para style="q" vid="ISA 62:4">«Nani weiriou», ligíaba liri bageira.</para>
  <para style="q" vid="ISA 62:4">Ladüga buguya hínsiñetimabei lun Aburemei,</para>
  <para style="q" vid="ISA 62:4">ani ítara luba Aburemei kei aban úmari lun bageira.<verse eid="ISA 62:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 62:5" />Lugundun ítara kei lamarieidun aban wügüri tuma ladari,</para>
  <para style="q" vid="ISA 62:5">ítara luba giñe lanügünibu Bungiu lúmarime,</para>
  <para style="q" vid="ISA 62:5">lararamagüdayabadibu ábame gundan lan buma,</para>
  <para style="q" vid="ISA 62:5">kei lugundan wügüri tuma lúmari.<verse eid="ISA 62:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 62:6" />Herusalén, rúhadina óunigirutiña luagu burí bubarieirun,</para>
  <para style="q" vid="ISA 62:6">ha nibei wéyuagu ni áriebu meredeti hariñagun:</para>
  <para style="q" vid="ISA 62:6">«Ha agúahabalin Aburemei, meredera hamá maniñu,<verse eid="ISA 62:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 62:7" />mígira huméi lun lemeraagun</para>
  <para style="q" vid="ISA 62:7">darime lararamagüdüni Herusalén lárigoun,</para>
  <para style="q" vid="ISA 62:7">ani eremuha hagíame sun gürigia lun».<verse eid="ISA 62:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 62:8" />Fiñuhali Aburemei lau liñuruni larüna gabafuti le lóunwenren:</para>
  <para style="q" vid="ISA 62:8">«Mígirundigiaadina lun héigini báganiñu bitürigun,</para>
  <para style="q" vid="ISA 62:8">ni lun hátuni terencha buniñe diwéin to badügüboun lau buadigimari;<verse eid="ISA 62:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 62:9" />huguya guánarügüba alubaha,</para>
  <para style="q" vid="ISA 62:9">ábame héigini le halubahabei,</para>
  <para style="q" vid="ISA 62:9">ábame heremuhan nun;</para>
  <para style="q" vid="ISA 62:9">halubahaboun beibei ábame hátunu diwéin</para>
  <para style="q" vid="ISA 62:9">lidan tibürürün nitenpulun to sánduboun».<verse eid="ISA 62:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 62:10" />Furí humá, furí humá lídangiñe bena,</para>
  <para style="q" vid="ISA 62:10">aranse huméi üma habá numutuniña,</para>
  <para style="q" vid="ISA 62:10">úaraguagüda huméi émeri,</para>
  <para style="q" vid="ISA 62:10">gidagua huméi dübü luéigiñe,</para>
  <para style="q" vid="ISA 62:10">iñura huméi seini lun hagúarun houn néchanigu.<verse eid="ISA 62:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 62:11" />Adimureha lumuti Aburemei katei le chülǘ lumoun lígirugu ubóu:</para>
  <para style="q" vid="ISA 62:11">«Ariñaga humá lun uburugu Sión luagu chülühali lan lesefuragüle.</para>
  <para style="q" vid="ISA 62:11">Ñǘbuintiña lumutuniña ha lesefurubaña luma».<verse eid="ISA 62:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 62:12" />Lariñawagúba houn Ísüraelina «Gürigia Sándutiña».</para>
  <para style="q" vid="ISA 62:12">«Ha lesefurubaña Aburemei».</para>
  <para style="q" vid="ISA 62:12">Lariñawagúame lun Herusalén,</para>
  <para style="q" vid="ISA 62:12">«Uburugu Ayumahóuati»,</para>
  <para style="q" vid="ISA 62:12">«Uburugu Migirúnti».<verse eid="ISA 62:12" /></para>
  <chapter eid="ISA 62" />
  <chapter number="63" style="c" sid="ISA 63" />
  <para style="s1">Labeichuniña Bungiu láganiñu</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 63:1" />Katei san le, le ñǘbuinbei Bosurágiñe,</para>
  <para style="q" vid="ISA 63:1">le luburugute Edomu,</para>
  <para style="q" vid="ISA 63:1">tau ladaüragun féindiwañu lau funati,</para>
  <para style="q" vid="ISA 63:1">le wéndebei asansiragun,</para>
  <para style="q" vid="ISA 63:1">éibugeina lau lanarime erei?</para>
  <para style="b" vid="ISA 63:1" />
  <para style="q" vid="ISA 63:1">«Au, au le adimurehabei luagu agañeiruni,</para>
  <para style="q" vid="ISA 63:1">ani gabafutina lun nesefuhan».<verse eid="ISA 63:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ISA 63:2" />«Kagia uagu funa tubéi bidunigun,</para>
  <para style="q" vid="ISA 63:2">kamá hamuga chuínguaadibu beibei lau bugudi?»<verse eid="ISA 63:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ISA 63:3" />«Ítara liña, nachuinraguañahaña beibei nábugua,</para>
  <para style="q" vid="ISA 63:3">úati ni aban íderagutina;</para>
  <para style="q" vid="ISA 63:3">aba nabuinchun lau igañi,</para>
  <para style="q" vid="ISA 63:3">aba nachuinraguniña náganiñu,</para>
  <para style="q" vid="ISA 63:3">aba naburechaguniña lau nigañi,</para>
  <para style="q" vid="ISA 63:3">aba labahichagun hata tuagun nidunigun,</para>
  <para style="q" vid="ISA 63:3">aba ladaseirunu nadaüragun.<verse eid="ISA 63:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 63:4" />Aranse numuti luagu lachülürüba lan weyu lun nadügün irichaü;</para>
  <para style="q" vid="ISA 63:4">chülühali buga dan lun nesefuruniña numutuniña.<verse eid="ISA 63:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 63:5" />Aba narihin, úati kaba lan íderaguana;</para>
  <para style="q" vid="ISA 63:5">wéiritu nanigi lau ua lan ni aban númagiñe.</para>
  <para style="q" vid="ISA 63:5">Narüna agañeiragüdübalina,</para>
  <para style="q" vid="ISA 63:5">nigañi ágüdahana.<verse eid="ISA 63:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 63:6" />Aba nabuinchun lau igañi,</para>
  <para style="q" vid="ISA 63:6">aba naburechaguniña néchanigu,</para>
  <para style="q" vid="ISA 63:6">günringua numutiña lau nigañi,</para>
  <para style="q" vid="ISA 63:6">aba náwiyuragüdüni hata múarugu».<verse eid="ISA 63:6" /></para>
  <para style="s1">Lareini Bungiu lun Ísüraeli</para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 63:7" />Busentina nadimurehan luagu línsiñehabu Aburemei,</para>
  <para style="q" vid="ISA 63:7">busentina neremuhan lun</para>
  <para style="q" vid="ISA 63:7">luagu sun le adüga láalibei luagu wafulesein,</para>
  <para style="q" vid="ISA 63:7">luagu lareini hama tílana luban Hakobu</para>
  <para style="q" vid="ISA 63:7">luagu sun le adüga láalibei lidan lueirin lareini</para>
  <para style="q" vid="ISA 63:7">luma lidan lueirin línsiñehabu.<verse eid="ISA 63:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 63:8" />Ariñagati: «Numutuniña hagía,</para>
  <para style="q" vid="ISA 63:8">isaanigu ha lúnbaña magarabaagun hamá nun».</para>
  <para style="q" vid="ISA 63:8">Aba lesefuruniña<verse eid="ISA 63:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 63:9" />lídangiñe sun hadiheri.</para>
  <para style="q" vid="ISA 63:9">Mama óunaharügüti esefuraña;</para>
  <para style="q" vid="ISA 63:9">Aburemei guánarügü esefurubaliña.</para>
  <para style="q" vid="ISA 63:9">Ligía esefurubaliña lau línsiñehabu luma lugudemehabu,</para>
  <para style="q" vid="ISA 63:9">aba liñuruniña, aba lanügüniña larünarugu.</para>
  <para style="q" vid="ISA 63:9">Ítara liña ladügüni súnwandan.<verse eid="ISA 63:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 63:10" />Gama lumoun aba hiñuragun houngua luagun Aburemei</para>
  <para style="q" vid="ISA 63:10">aba hanabaguni lani sífiri le sándubei;</para>
  <para style="q" vid="ISA 63:10">ligía lagaganirunbaliña,</para>
  <para style="q" vid="ISA 63:10">aba lawuribuhan hama.<verse eid="ISA 63:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 63:11" />Aba haritagun luagun binadu dan,</para>
  <para style="q" vid="ISA 63:11">luagun Moisesi le asagarubaliña lumutuniña,</para>
  <para style="q" vid="ISA 63:11">aba hálügüdagun houngua:</para>
  <para style="q" vid="ISA 63:11">«Hagéi san Bungiu le esefurubalin Moisesi</para>
  <para style="q" vid="ISA 63:11">le hóuniri lilügüniña mudún lídangiñe Nilu?</para>
  <para style="q" vid="ISA 63:11">Hagéi le íchugubalin lani sífiri le sándubei lidoun Moisesi,<verse eid="ISA 63:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 63:12" />le adügübei lun lúmabei lan Moisesi luéirigun lubafu,</para>
  <para style="q" vid="ISA 63:12">le afanreinragubalin barana lun hásügürün lumutuniña,</para>
  <para style="q" vid="ISA 63:12">lun buga laganbahóuba lan hawagu súnwandan,<verse eid="ISA 63:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 63:13" />le ásügüragüdübaliña lamidanguagiñe barana miriraagunga hagía,</para>
  <para style="q" vid="ISA 63:13">kei gabayu lidan fulasu mageirawati,<verse eid="ISA 63:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 63:14" />kei bágasu dan le hararirun luéigiñe wübü?</para>
  <para style="q" vid="ISA 63:14">Adundeha lumutiña bugaha lani Bungiu sífiri».</para>
  <para style="q" vid="ISA 63:14">Ítara liña labuguruniña lumutuniña,</para>
  <para style="q" vid="ISA 63:14">aba habihin uéiriguni, aganbahóua ligía hawagu.<verse eid="ISA 63:14" /></para>
  <para style="s1">Lamuriahóun lídehan Bungiu</para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 63:15" />Arihabá siélugiñe Aburemei,</para>
  <para style="q" vid="ISA 63:15">lídangiñe fulasu sánduti ani wéiriguti le ñein lubéi baganawa.</para>
  <para style="q" vid="ISA 63:15">Hagéi san bubafu luma bóunigiruniwa?</para>
  <para style="q" vid="ISA 63:15">Magidarabéi bínsiñehabu luma bugudemehabu wawéi.<verse eid="ISA 63:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 63:16" />Buguya wáguchibei!</para>
  <para style="q" vid="ISA 63:16">Íbini lamaharun Abüráamü luagu lirahüñü wamá,</para>
  <para style="q" vid="ISA 63:16">maritagun ligía Ísüraeli wawagun,</para>
  <para style="q" vid="ISA 63:16">buguya, Aburemei, wáguchibei</para>
  <para style="q" vid="ISA 63:16">buguyagubeiñein Wesefuragüle súnwandan.<verse eid="ISA 63:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 63:17" />Ka uagu badüga lun wadireirun luéi bémeri, Aburemei,</para>
  <para style="q" vid="ISA 63:17">ani deregüdaboun wanigi lun mineben ban woun?</para>
  <para style="q" vid="ISA 63:17">Sánsiguala bigaburi luagu bínsiñehabu houn bubueingu,</para>
  <para style="q" vid="ISA 63:17">luma houn bani türibu.<verse eid="ISA 63:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 63:18" />Luágurügüñein murusun dan laburiña lan fulasu bumutuniña!</para>
  <para style="q" vid="ISA 63:18">Dügügua hamaaru wáganiñu bitenpulun.<verse eid="ISA 63:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 63:19" />Ítara waña kamá hamuga magumadirúnñaha bágidiwa,</para>
  <para style="q" vid="ISA 63:19">kamá hamuga mámañahagidiwa bumutuniña.<verse eid="ISA 63:19" /></para>
  <chapter eid="ISA 63" />
  <chapter number="64" style="c" sid="ISA 64" />
  <para style="q">
    <verse number="1" style="v" sid="ISA 64:1" />Baheiridaguei hamuga sielu, aba hamuga bararirun</para>
  <para style="q" vid="ISA 64:1">lun ladadagarunga wübü lau biñuarü,<verse eid="ISA 64:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 64:2" />ítara kei dan le láguduni watu gemeti búbugati</para>
  <para style="q" vid="ISA 64:2">o láhuragüdüni lan duna.</para>
  <para style="q" vid="ISA 64:2">Aba hamuga hasubudiruni báganiñu biri,</para>
  <para style="q" vid="ISA 64:2">adadagara hagía hamuga néchanigu bigibugiñe.<verse eid="ISA 64:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 64:3" />Dan meha le badügünbei katei hanarime buriti le magurabun wamuti,</para>
  <para style="q" vid="ISA 64:3">dan le baragachunbei, adadagarati burí áraabu bigibugiñe.<verse eid="ISA 64:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 64:4" />Maganbúnñahagili luagu, marihín ligía amu bungiu buéi le adügüti burí katei le</para>
  <para style="q" vid="ISA 64:4">luagu hafulesein ha hemenigibaña luagu.<verse eid="ISA 64:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 64:5" />Resibi bumuti le adügübalin le buídubei lau ugundani</para>
  <para style="q" vid="ISA 64:5">ani adügaléi le babusenrubei.</para>
  <para style="b" vid="ISA 64:5" />
  <para style="q" vid="ISA 64:5">Gáñitibu ladüga afigouhaadiwa lan;</para>
  <para style="q" vid="ISA 64:5">anabagua wamaadibu lúmagiñe binarü.<verse eid="ISA 64:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 64:6" />Ítara waña sun wagía kei aban wügüri wíyeti;</para>
  <para style="q" vid="ISA 64:6">sun buiti le wadügübei ítara liña kei gamisa wíyetu;</para>
  <para style="q" vid="ISA 64:6">ábürühaadiwa sun wagía kei ubanaü sáühali,</para>
  <para style="q" vid="ISA 64:6">aduruuha lumutiwa wáfarahan kei garabali.<verse eid="ISA 64:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 64:7" />Úati agúahatibu,</para>
  <para style="q" vid="ISA 64:7">ua áfaaguti labalachun buagun;</para>
  <para style="q" vid="ISA 64:7">ligía baramudagunbei wawéi,</para>
  <para style="q" vid="ISA 64:7">aba bígiruniwa ladüga wariban.<verse eid="ISA 64:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ISA 64:8" />Lau sun lira Aburemei, buguya Wáguchibei;</para>
  <para style="q" vid="ISA 64:8">múa wagía, buguyati nadagimeinti múa ligía,</para>
  <para style="q" vid="ISA 64:8">ladügün lubeiti búhabu sun wagía!<verse eid="ISA 64:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 64:9" />Aburemei, magañidabá saragu,</para>
  <para style="q" vid="ISA 64:9">maritagun buguyame luagu wariban súnwandan.</para>
  <para style="q" vid="ISA 64:9">Bumutuniñatia wagía!<verse eid="ISA 64:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 64:10" />Ítara liña burí buburugute le sándubei, kamá fulasu mageirawati,</para>
  <para style="q" vid="ISA 64:10">günrinwagua Herusalén.<verse eid="ISA 64:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 64:11" />Gumuguagüdalá watu gemeti wani sanduariu,</para>
  <para style="q" vid="ISA 64:11">to meha ñein lubéi heremuha wagübürigu bun.</para>
  <para style="q" vid="ISA 64:11">Sun le meha hínsiñetimabei woun, günringua!<verse eid="ISA 64:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 64:12" />Lau sun burí katei le, Aburemei,</para>
  <para style="q" vid="ISA 64:12">Beredera san deregüdagu?</para>
  <para style="q" vid="ISA 64:12">Beredera san maniñu ǘnabugüdawa sunsuinagubei?<verse eid="ISA 64:12" /></para>
  <chapter eid="ISA 64" />
  <chapter number="65" style="c" sid="ISA 65" />
  <para style="s1">Hadurun mabuchahatiña</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 65:1" />Lariñahare Bungiu:</para>
  <para style="q" vid="ISA 65:1">«Ha buga mamuriahangiñabaña ni kata numa,</para>
  <para style="q" vid="ISA 65:1">hagía ñǘbuinbaña numoun;</para>
  <para style="q" vid="ISA 65:1">ha buga máluahanbalina, hagía adarirubalina,</para>
  <para style="q" vid="ISA 65:1">houn gürigia ha máluahanbalina nariñaga: “Anahán ya”.<verse eid="ISA 65:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 65:2" />Tulé numuti núhabu sun weyu</para>
  <para style="q" vid="ISA 65:2">lun yebe nachawahaniña gürigia mabuchahatiña</para>
  <para style="q" vid="ISA 65:2">ha ñǘdünbaña luéigiñe lagübüri hémeri,</para>
  <para style="q" vid="ISA 65:2">afalarei lagübüri hasaminan súnwandan;<verse eid="ISA 65:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 65:3" />gürigia ha anabagubalina nigibuagun súnwandan;</para>
  <para style="q" vid="ISA 65:3">ha adagaragüdübaña houn búngiugu lidan fuluri-agei,</para>
  <para style="q" vid="ISA 65:3">águdaha hagía kupali luagu burí latarü le lauti ladiríyu;<verse eid="ISA 65:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 65:4" />ha añuurubaña lidan burí umúahaü,</para>
  <para style="q" vid="ISA 65:4">sügǘ haméi burí áriebu lidan fulasu aramudaguati;</para>
  <para style="q" vid="ISA 65:4">ha éigibaña buíruhu,</para>
  <para style="q" vid="ISA 65:4">buíngüda haméi burí hasoudierun lau iraü wíyeti.<verse eid="ISA 65:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 65:5" />Ha ariñagubaña: “Ñeinbá lidan bubara, maguurabá nuagu;</para>
  <para style="q" vid="ISA 65:5">sánduyatina, lun baguurun nuagu”.</para>
  <para style="q" vid="ISA 65:5">Ítara haña gürigia hagía kei watu le durungu liña sun weyu;</para>
  <para style="q" vid="ISA 65:5">beresetiña nun kei gumuleli lidan ígirugu.<verse eid="ISA 65:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 65:6" />Gama lumoun bürüwañu liña sun le nigibugiñe,</para>
  <para style="q" vid="ISA 65:6">meredebadina deregüdagu;</para>
  <para style="q" vid="ISA 65:6">níchigaali le hadünabei houn,<verse eid="ISA 65:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 65:7" />dandu luagu huriban, kei luagu hariban hagübürigu.</para>
  <para style="q" vid="ISA 65:7">Águdahatiña meha kupali ligibuagu wübü,</para>
  <para style="q" vid="ISA 65:7">anabagua hamana lidan fulasu íñuti.</para>
  <para style="q" vid="ISA 65:7">Nabahüdaali sun le hadügübei furumiñe lubá níchuguni le hadünabei houn».</para>
  <para style="q" vid="ISA 65:7">Aburemei ariñagubalin.<verse eid="ISA 65:7" /></para>
  <para style="s1">Füramase lani Bungiu labinirun</para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 65:8" />Lariñahare Bungiu:</para>
  <para style="q" vid="ISA 65:8">«Dan le gara lan beibei saragu,</para>
  <para style="q" vid="ISA 65:8">meferidirun hamuti gürigia,</para>
  <para style="q" vid="ISA 65:8">ladüga gayaraati hasagarun saragu diwéin lídangiñe,</para>
  <para style="q" vid="ISA 65:8">ítara luba giñe nadüga luagu nínsiñehabu houn nubúeingu:</para>
  <para style="q" vid="ISA 65:8">Magünrinchagun nubaña súngubei.<verse eid="ISA 65:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 65:9" />Nadügüba lun gadügawagun lan Hakobu,</para>
  <para style="q" vid="ISA 65:9">luma lun ñein hamá gürigia Hudá lun haganóun lidan náraabute.</para>
  <para style="q" vid="ISA 65:9">Hárügüdübei ha nanúadirubaña múa,</para>
  <para style="q" vid="ISA 65:9">ñeinba haganóua nubúeingu.<verse eid="ISA 65:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 65:10" />Labuinchuba Sarón hau mudún,</para>
  <para style="q" vid="ISA 65:10">buin ligíame fulasu wayati le Akoru hau bágasu</para>
  <para style="q" vid="ISA 65:10">ha halügüniña gürigia ha áluahatina.<verse eid="ISA 65:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 65:11" />Ánheinti huguya le adisedubei luéi Aburemei,</para>
  <para style="q" vid="ISA 65:11">bulíeigua huguya luéi nuwübüri sánduti,</para>
  <para style="q" vid="ISA 65:11">huguya le adagaragüdübei éigini tuma diwéin lun Gadü luma Mení,</para>
  <para style="q" vid="ISA 65:11">ha lubungiutegu ubunuruni luma isinuni,<verse eid="ISA 65:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 65:12" />mabunuruniba hibiha:</para>
  <para style="q" vid="ISA 65:12">Nadügüba lun háfarawagun tau eféin.</para>
  <para style="q" vid="ISA 65:12">Ladüga agúahatina hun, móunabuntün;</para>
  <para style="q" vid="ISA 65:12">adimurehatina hun, maganbun humutina;</para>
  <para style="q" vid="ISA 65:12">adüga humuti le unbei namahara,</para>
  <para style="q" vid="ISA 65:12">anúadira humuti le aubei magundan nan».<verse eid="ISA 65:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ISA 65:13" />Ligía lariñagubei Bungiu:</para>
  <para style="q" vid="ISA 65:13">«Géiginbaña nubúeingu,</para>
  <para style="q" vid="ISA 65:13">anhein huguya, hasufuriruba ilamaü;</para>
  <para style="q" vid="ISA 65:13">hagía ganiñebaña, huguya háfaguba mágürabu;</para>
  <para style="q" vid="ISA 65:13">hagía hagundaaruba, huguya hanügüba busiganu;<verse eid="ISA 65:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 65:14" />hagía heremuhaba</para>
  <para style="q" vid="ISA 65:14">ladüga ugundani le tídanbei hanigi,</para>
  <para style="q" vid="ISA 65:14">anhein huguya hagúarahaba ayahuaha</para>
  <para style="q" vid="ISA 65:14">ladüga íruni luma idiheri.<verse eid="ISA 65:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 65:15" />Hayusurubei nánigu hiri</para>
  <para style="q" vid="ISA 65:15">lun híñaragun luma lun hayumahan wuribani houn amu,</para>
  <para style="q" vid="ISA 65:15">ánhañati nubúeingu, nasansirubei hiri.<verse eid="ISA 65:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 65:16" />Furumiñeguarügüme le amuriahati abiniruni fulasurugu,</para>
  <para style="q" vid="ISA 65:16">lúmaba Bungiu gúnfuliti lamuriahei;</para>
  <para style="q" vid="ISA 65:16">furumiñeguarügüme le áfiñuruti fulasurugu,</para>
  <para style="q" vid="ISA 65:16">lídanba liri Bungiu gúnfuliti láfiñura.</para>
  <para style="q" vid="ISA 65:16">Bulieiná binadu burí hidiheri,</para>
  <para style="q" vid="ISA 65:16">gumugua ligibugiñegiñe nagu.<verse eid="ISA 65:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ISA 65:17" />«Nadügüba aban iseri sielu luma aban iseri ubóu.</para>
  <para style="q" vid="ISA 65:17">Labulieidúaba sun le sügühalibei,</para>
  <para style="q" vid="ISA 65:17">úaalime aritaguti luagun.<verse eid="ISA 65:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 65:18" />Buin humá lau ugundani lun sun dan luagu le lunbei nadügüni,</para>
  <para style="q" vid="ISA 65:18">lugundun nadügüba aban Herusalén gúndaati,</para>
  <para style="q" vid="ISA 65:18">hama gürigia gúndaatiña lun haganóun ñein.<verse eid="ISA 65:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 65:19" />Au guánarügü, nagundaaruba luagu Herusalén</para>
  <para style="q" vid="ISA 65:19">nasandiruba ugundani hawagu numutuniña.</para>
  <para style="q" vid="ISA 65:19">Maganbúndigiaalime ayahuni ñein,</para>
  <para style="q" vid="ISA 65:19">ni agúaraguni lánina idiheri.<verse eid="ISA 65:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 65:20" />Úabaña irahüñü figigiña óunwegutiña ñein,</para>
  <para style="q" vid="ISA 65:20">ni wéiyaaña mutu lun magunfulirun hamani hadaani.</para>
  <para style="q" vid="ISA 65:20">Leme óunweti luagu san irumu lau, nibureingili lounwen,</para>
  <para style="q" vid="ISA 65:20">le machülüti san irumu, íñarawaguati.<verse eid="ISA 65:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 65:21" />Hábunaguba gürigia haban ábame haganóun tidan,</para>
  <para style="q" vid="ISA 65:21">hábunaguba beibei ábame héiginu tin.<verse eid="ISA 65:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 65:22" />Mábunagunbei gürigia muna laganóuame amu tidan,</para>
  <para style="q" vid="ISA 65:22">mábunagun ligíame mutu nadü, léigounme amu tin.</para>
  <para style="q" vid="ISA 65:22">Migifebei habagari numutuniña kei libagari tídibu wewe;</para>
  <para style="q" vid="ISA 65:22">harihubei numutuniña le hawadigimaribei lau háhabu.<verse eid="ISA 65:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 65:23" />Mawadigimaridunbaña luagu ni kata,</para>
  <para style="q" vid="ISA 65:23">móunwegun hagíame hasaanigu lubaragiñe hadaani,</para>
  <para style="q" vid="ISA 65:23">lugundun hadügawagun ha biní laañabaña Aburemei hagía,</para>
  <para style="q" vid="ISA 65:23">ani ítara haba giñe hadügawagun.<verse eid="ISA 65:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 65:24" />Nóunabubaña lubaragiñe hagúarun nun;</para>
  <para style="q" vid="ISA 65:24">naganbubaña lubaragiñe lagumuchun hadimurehan.<verse eid="ISA 65:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 65:25" />Léigiba géigusi luma mudún lidan aban,</para>
  <para style="q" vid="ISA 65:25">léigiba liñún sagadi kei bágasu, téigame hewe múa.</para>
  <para style="q" vid="ISA 65:25">Úabei ni kata adügüti damichi lidan sun nuwübüri le sándubei».</para>
  <para style="q" vid="ISA 65:25">Aburemei ariñagubalin.<verse eid="ISA 65:25" /></para>
  <chapter eid="ISA 65" />
  <chapter number="66" style="c" sid="ISA 66" />
  <para style="s1">Luáguti kultu iyeeniti</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 66:1" />Lariñahare Aburemei:</para>
  <para style="q" vid="ISA 66:1">«Sielu lálanabei narúeihan,</para>
  <para style="q" vid="ISA 66:1">ubóu lébubei nugudi.</para>
  <para style="q" vid="ISA 66:1">Halíaba gayara lan hábunagun aban muna nun?</para>
  <para style="q" vid="ISA 66:1">Halíaba gayara lan hadügün aban ubaraü nun lun nemeraagun?<verse eid="ISA 66:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 66:2" />Au guánarügü adügübalin sun burí katei le,</para>
  <para style="q" vid="ISA 66:2">ítara liña ladügǘn súngubei!</para>
  <para style="q" vid="ISA 66:2">Au, le Aburemei ariñagubalin.</para>
  <para style="b" vid="ISA 66:2" />
  <para style="q" vid="ISA 66:2">Luagun gürigia le gudemeti ani nidiheri ligía nariha,</para>
  <para style="q" vid="ISA 66:2">le inebehabubei lun nererun.<verse eid="ISA 66:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 66:3" />Gama lumoun añahein adagaragüdütiña aban bágasu wügüri,</para>
  <para style="q" vid="ISA 66:3">áfara hagía aban gürigia;</para>
  <para style="q" vid="ISA 66:3">bi hamuti ligiina aban mudún,</para>
  <para style="q" vid="ISA 66:3">tigitiña giñe aban ounli;</para>
  <para style="q" vid="ISA 66:3">adagaragüdatiña ilaü, adagaragüda hagía lita buíruhu;</para>
  <para style="q" vid="ISA 66:3">águdahatiña kupali, huduguatiña giñe lun aban guáriua.</para>
  <para style="q" vid="ISA 66:3">Ha anúadirubalin lagübüri igaburi iyereehabúti le,</para>
  <para style="q" vid="ISA 66:3">hínsiñeti houn lun hadügüni katei burí le.<verse eid="ISA 66:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 66:4" />Nanúadirubei giñe asufuriruni houn,</para>
  <para style="q" vid="ISA 66:4">nanügübei le ueibei hanufudeda houn.</para>
  <para style="q" vid="ISA 66:4">Lugundun agúahatina, úati óunabutina,</para>
  <para style="q" vid="ISA 66:4">adimurehatina, úati aganbutina;</para>
  <para style="q" vid="ISA 66:4">adüga hamuti le unbei namahara,</para>
  <para style="q" vid="ISA 66:4">anúadira hamuti le mínsiñebei nun».<verse eid="ISA 66:4" /></para>
  <para style="s1">Guséi luma esefuruni</para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 66:5" />Huguya le inebehabubei lun lererun Aburemei,</para>
  <para style="q" vid="ISA 66:5">aganba huméi lererun:</para>
  <para style="q" vid="ISA 66:5">«Hariñahare hupaisanun ha iyereehabúbaña hun,</para>
  <para style="q" vid="ISA 66:5">ha éibaahabalün ladüga hagúahani niri:</para>
  <para style="q" vid="ISA 66:5">Arufudaléi Aburemei luéirigun;</para>
  <para style="q" vid="ISA 66:5">busentiwa warihinün gúndaañu</para>
  <para style="q" vid="ISA 66:5">gama lumoun hagía, hanügüba busiganu.<verse eid="ISA 66:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 66:6" />Umalali le, le ñǘbuinbei uburugugiñe,</para>
  <para style="q" vid="ISA 66:6">areinchuni le aganbúbei ténpulurugugiñe,</para>
  <para style="q" vid="ISA 66:6">ligía areinchuni le ladügübei Aburemei</para>
  <para style="q" vid="ISA 66:6">dan le líchuguni le hadünabei láganiñu houn.<verse eid="ISA 66:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ISA 66:7" />«Águrahatu Sión lidan murusun oura,</para>
  <para style="q" vid="ISA 66:7">lubaragiñe tagaridun.<verse eid="ISA 66:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 66:8" />Ka aganbaalibei katei ítaraburiti?</para>
  <para style="q" vid="ISA 66:8">Ka arihaalibei líbeina katei le?</para>
  <para style="q" vid="ISA 66:8">Saliguatiña lílana aban néchani lidan ábanrügü weyu?</para>
  <para style="q" vid="ISA 66:8">Saliguati aban ageiraü lidan murusun oura?<verse eid="ISA 66:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 66:9" />Ida luba hamugagia nararamuni águrahani,</para>
  <para style="q" vid="ISA 66:9">ani au águrahagüdübei?»</para>
  <para style="q" vid="ISA 66:9">Aburemei le Bubungiute ariñagubalin.<verse eid="ISA 66:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ISA 66:10" />«Gunda humá tuma Herusalén,</para>
  <para style="q" vid="ISA 66:10">buin humá lau ugundani huguya le hínsiñehabubei tun;</para>
  <para style="q" vid="ISA 66:10">gunda humá úara tuma sun huguya le ayahuahaalibei tuagu;<verse eid="ISA 66:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 66:11" />tuguya kei aban úguchuru tanurihabadün</para>
  <para style="q" vid="ISA 66:11">lau dǘgüdaguaü darí hakimuledun.<verse eid="ISA 66:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 66:12" />Lugundun nariñahare au, le Aburemei:</para>
  <para style="q" vid="ISA 66:12">Nadügüba lun liabin darangilaü tuagun</para>
  <para style="q" vid="ISA 66:12">kei aban duna éibaaguati,</para>
  <para style="q" vid="ISA 66:12">luma lirisin burí néchani kei aban duna afuluduhati.</para>
  <para style="q" vid="ISA 66:12">Tátagüdübadün Herusalén keisi aban úguchuru,</para>
  <para style="q" vid="ISA 66:12">tanügübadün tarünarugu,</para>
  <para style="q" vid="ISA 66:12">ábame tasalagadunün lau saragu ínsiñeni.<verse eid="ISA 66:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 66:13" />Kei támalihani aban úguchuru tiráü,</para>
  <para style="q" vid="ISA 66:13">ítara luba námalihanün,</para>
  <para style="q" vid="ISA 66:13">ábame hadariruni dǘgüdaguaü Herusalén».<verse eid="ISA 66:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ISA 66:14" />Danme harihini katei le, tagundaaruba hanigi;</para>
  <para style="q" vid="ISA 66:14">láhüchaguba húgubu kei híduru.</para>
  <para style="q" vid="ISA 66:14">Lasubudirágüdübei Bungiu lubafu hadan lánigu,</para>
  <para style="q" vid="ISA 66:14">luma ligañi hadan láganiñu.<verse eid="ISA 66:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 66:15" />Lugundun liábinba Aburemei labadinagua watu gemeti;</para>
  <para style="q" vid="ISA 66:15">ítara tiña likarün kei hiriri</para>
  <para style="q" vid="ISA 66:15">larariraguagüdübei lanarime ligañi</para>
  <para style="q" vid="ISA 66:15">luma watu gemeti le lánina labeihan.<verse eid="ISA 66:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 66:16" />Lauba watu gemeti ladügei Aburemei guséi,</para>
  <para style="q" vid="ISA 66:16">laguseragüdübei sun ubóu tau lefeinte</para>
  <para style="q" vid="ISA 66:16">ani saragubaña láfaragun hilagubei.<verse eid="ISA 66:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17-18" style="v" sid="ISA 66:17-18" />Lariñahare Aburemei:</para>
  <para style="q" vid="ISA 66:17-18">Ha ederegeragubaña houngua lun hadügün kultu wíyeti lidan burí fuluri-agei,</para>
  <para style="q" vid="ISA 66:17-18">afalareina aban le hamidanguabei,</para>
  <para style="q" vid="ISA 66:17-18">ha éigibaña buíruhu, garadun o furumiñeguarügü animaalugu wíyetiña, hagumuchawaguagüdüba,</para>
  <para style="q" vid="ISA 66:17-18">lugundun subudi numuti hóuserun luma hasaminan.</para>
  <para style="b" vid="ISA 66:17-18" />
  <para style="q" vid="ISA 66:17-18">«Ábameti niabin óundaraguaña sun gürigia,</para>
  <para style="q" vid="ISA 66:17-18">ábame hayabin, ábame harihini nuéirigun.<verse eid="ISA 66:17-18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 66:19" />Níchuguba aban seini houn:</para>
  <para style="q" vid="ISA 66:19">Nígiruba lun houdin fiu hádangiñe</para>
  <para style="q" vid="ISA 66:19">ábame nóunahaniña lidoun burí néchani le:</para>
  <para style="q" vid="ISA 66:19">Tárüsisi, Liwia, Lidia,</para>
  <para style="q" vid="ISA 66:19">fulasu le ñein habéi gahandilihatiña gimara,</para>
  <para style="q" vid="ISA 66:19">Tubali, Güresia, luma burí luagun ubouhu díseti</para>
  <para style="q" vid="ISA 66:19">le ñein lubéi maganbúngili lan nuagu, marihín nuéirigun;</para>
  <para style="q" vid="ISA 66:19">ábame hadimurehan houn néchanigu luagu nuéirigun.<verse eid="ISA 66:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 66:20" />Hanügübaña sun hupaisanun hádangiñe sun néchanigu,</para>
  <para style="q" vid="ISA 66:20">hawagu gabayu, tidan karü, tidan hagei,</para>
  <para style="q" vid="ISA 66:20">hawagu mile hama kameyu.</para>
  <para style="q" vid="ISA 66:20">Ábanbei idewesei nun, uburugu Herusalén nuwübüri le sándubei,</para>
  <para style="q" vid="ISA 66:20">kei burí edewehani le hanügübei Ísüraelina lidan weru harumati nitenpulunrugun.</para>
  <para style="q" vid="ISA 66:20">Au, le Aburemei ariñagubalin.<verse eid="ISA 66:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="ISA 66:21" />Nanúadiruba hádangiñe lun fádirigume</para>
  <para style="q" vid="ISA 66:21">luma lun Lewitagume.</para>
  <para style="q" vid="ISA 66:21">Au, le Aburemei ariñagubalin».<verse eid="ISA 66:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="ISA 66:22" />Ariñagati giñe Aburemei:</para>
  <para style="q" vid="ISA 66:22">«Ítara kei laduraruba lan iseri sielu luma iseri múa</para>
  <para style="q" vid="ISA 66:22">le lunbei nadügüni lun sun dan,</para>
  <para style="q" vid="ISA 66:22">ítara luba giñe hadurarun badügawagun luma biri.<verse eid="ISA 66:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 66:23" />Ságüme hati, lidan luéyuri iseri hati,</para>
  <para style="q" vid="ISA 66:23">luma sagü luéyuri emeraaguni,</para>
  <para style="q" vid="ISA 66:23">hayabinba sun gürigia áhuduragua nigibugiñe.</para>
  <para style="q" vid="ISA 66:23">Au, le Aburemei ariñagubalin.<verse eid="ISA 66:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="ISA 66:24" />Hayabinba, ábame harihini hágubu hilaguaaña ha meha iñuragubaña houngua nuagun.</para>
  <para style="q" vid="ISA 66:24">Móunwegunbaña héweraü ha éigibaliña,</para>
  <para style="q" vid="ISA 66:24">méñeguchun ligíame watu gemeti le águdubaliña.</para>
  <para style="q" vid="ISA 66:24">Ábanbaña katei le iyereehabúti houn sun gürigia!»<verse eid="ISA 66:24" /></para>
  <chapter eid="ISA 66" />
</usx>