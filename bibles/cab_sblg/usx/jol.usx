<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOL" style="id">Hoeli.TXT (Encoding update 2008) 27/02/2001 CAP C.R, GARIFUNA</book>
  <para style="h">Hoeli</para>
  <para style="toc3">Hoe</para>
  <para style="toc2">Hoeli</para>
  <para style="toc1">Hoeli</para>
  <para style="mt2">Liliburun</para>
  <para style="mt1">HOELI</para>
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="ms">I. Igei Le Hani Chagagaru</para>
  <para style="mr">(<ref loc="JOL 1:1-2:17">1.1—2.17</ref>)</para>
  <para style="s1">Hagadeiruni chagagaru alubahani</para>
  <para style="q">
    <verse number="1" style="v" sid="JOL 1:1" />Anihán uganu le líchugubei Wabureme lun Hoeli,</para>
  <para style="q" vid="JOL 1:1">le liráü Petueli:<verse eid="JOL 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOL 1:2" />Aganba huméi katei le buidu huguya ábutigu</para>
  <para style="q" vid="JOL 1:2">huma sun huguya lílana fulasu.</para>
  <para style="q" vid="JOL 1:2">Arihañahaadün katei ítaraburiti?</para>
  <para style="q" vid="JOL 1:2">Arihúati meha katei ítaraburiti</para>
  <para style="q" vid="JOL 1:2">hadaaniwagu hagübürigu?<verse eid="JOL 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 1:3" />Abahüdagua huméi houn hisaanigu,</para>
  <para style="q" vid="JOL 1:3">habahüdagueime hisaanigu houn hasaanigu,</para>
  <para style="q" vid="JOL 1:3">habahüdagueime hasaanigu houn ha águrahoutiña hárigiñe.<verse eid="JOL 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOL 1:4" />Hou hamá chagagaru súngubei.</para>
  <para style="q" vid="JOL 1:4">Le hígirubei furumiñetiña,</para>
  <para style="q" vid="JOL 1:4">aba hayabin amu aba héigini.<verse eid="JOL 1:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="JOL 1:5" />Huguya bacharuatiña,</para>
  <para style="q" vid="JOL 1:5">agagudúa humá!</para>
  <para style="q" vid="JOL 1:5">Hayahuaha, huguya gátaatiña diwéin,</para>
  <para style="q" vid="JOL 1:5">lugundun íbini diwéin tagidarúba huéi!<verse eid="JOL 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOL 1:6" />Lugundun beluhaña chagagaru nageiroun</para>
  <para style="q" vid="JOL 1:6">kei súdaragu gíbetiña, ha héretiña,</para>
  <para style="q" vid="JOL 1:6">ítara liña hari kei hari liñún.<verse eid="JOL 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 1:7" />Günringua hamá wanadürigu beibei tuma wanadürigu igu,</para>
  <para style="q" vid="JOL 1:7">hiyá hamá le gumuti darí lerederun tilimun haruñu.<verse eid="JOL 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOL 1:8" />Ítara kei adari to ayahuboun,</para>
  <para style="q" vid="JOL 1:8">amuisera tuguya lárigi tadari,<verse eid="JOL 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 1:9" />ítara liña hayahun fádirigu ladüga úaaru ilaü</para>
  <para style="q" vid="JOL 1:9">ni diwéin ténpulurugu lun idewesei lun Wabureme.<verse eid="JOL 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 1:10" />Úaali ni kata lidan burí ichari;</para>
  <para style="q" vid="JOL 1:10">lamuiseruña múa.</para>
  <para style="q" vid="JOL 1:10">Féridiha türigu, mábeiha beibei-agei saüha giñe oliwu.<verse eid="JOL 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 1:11" />Huguya le nadagimeinbei áraabu luma beibei-ágeirugu,</para>
  <para style="q" vid="JOL 1:11">hayahua lau íruni, ladüga féridiha bunaguaü luma</para>
  <para style="q" vid="JOL 1:11">lalubahóun türigu luma sebada.<verse eid="JOL 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 1:12" />Mábeiha beibei-agei,</para>
  <para style="q" vid="JOL 1:12">féridiha tídibu burí igu,</para>
  <para style="q" vid="JOL 1:12">Mábeiha burí giñe güranáda, tídibu yaraüwa,</para>
  <para style="q" vid="JOL 1:12">mansanu luma sun tídibu wewe le áraabubei.</para>
  <para style="q" vid="JOL 1:12">Féridiha hagundan sun gürigia!<verse eid="JOL 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 1:13" />Huguya fádirigu, daü humá daüguaü súsutu,</para>
  <para style="q" vid="JOL 1:13">hayahuaha lau igarigu, ladüga úaali ilaü litenpulunrugu</para>
  <para style="q" vid="JOL 1:13">Hubungiute ni diwéin lun idewesei.<verse eid="JOL 1:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="JOL 1:14" />Wáhuma hawagu lílana fulasu, ayunara huguyame;</para>
  <para style="q" vid="JOL 1:14">óundaragua humaña wéiyaaña mutu</para>
  <para style="q" vid="JOL 1:14">hama sun ha aganóubaña fulasurugu litenpulunrugu Wabureme,</para>
  <para style="q" vid="JOL 1:14">ábame hafurieidun lun Wabureme.<verse eid="JOL 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOL 1:15" />Yarafaali luéyuri Wabureme!</para>
  <para style="q" vid="JOL 1:15">Weyu hanarimeti le barüinabei günringuaü woun!</para>
  <para style="q" vid="JOL 1:15">Luéigiñe lóubadina Suntigabafu.<verse eid="JOL 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 1:16" />Gidawati weigin wawéi aríagu wagía lun,</para>
  <para style="q" vid="JOL 1:16">gumuha ugundani litenpulunrugu Wabungiute.<verse eid="JOL 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 1:17" />Ñalá ilaü, féridiha türigu, günringua muna to lagei ilaü.<verse eid="JOL 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 1:18" />Hamuuhaña bágasu!</para>
  <para style="q" vid="JOL 1:18">Háluahadügüña yebe sagadi; hóunweguña mudún.<verse eid="JOL 1:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="JOL 1:19" />Ayumuraguatina bun, Wabureme,</para>
  <para style="q" vid="JOL 1:19">ladüga gudala watu gemeti sagadi le fulasurugubei</para>
  <para style="q" vid="JOL 1:19">mageirawati luma burí tídibu wewe le áraabubei!<verse eid="JOL 1:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 1:20" />Íbini animaalugu áraabuna ayumuraguatiña bun,</para>
  <para style="q" vid="JOL 1:20">lugundun mábeiha burí lísensen duna ani láguduñein watu gemeti sagadi!<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="q">
    <verse number="1" style="v" sid="JOL 2:1" />Win humóun fidu luagu wübü Sión;</para>
  <para style="q" vid="JOL 2:1">win humá le lánina awisahani luagu luwübüri Wabureme.</para>
  <para style="q" vid="JOL 2:1">Adadagara hamá sun ha aganóubaña Hudá,</para>
  <para style="q" vid="JOL 2:1">ladüga yarafaali luéyuri Wabureme;<verse eid="JOL 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 2:2" />luéyuri luburiga luma lamuñounga,</para>
  <para style="q" vid="JOL 2:2">luéyuri dúeri le wuriti.</para>
  <para style="s1" vid="JOL 2:2">Hadaagun chagagaru damichi</para>
  <para style="q" vid="JOL 2:2">Añahein saragu súdara</para>
  <para style="q" vid="JOL 2:2">héretiña luagu burí wübü kei</para>
  <para style="q" vid="JOL 2:2">larugounga le lánina larugadun.</para>
  <para style="q" vid="JOL 2:2">Marihínñahagili katei ítaraburiti, ani marihínwadigiaali.<verse eid="JOL 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 2:3" />Ítara haña kei watu gemeti le agumuchaguagüdübalin</para>
  <para style="q" vid="JOL 2:3">sun le ladarirun lubarua;</para>
  <para style="q" vid="JOL 2:3">le águdahabei lubaragiñe lásügürün</para>
  <para style="q" vid="JOL 2:3">luma lárigiñe lásügürün.</para>
  <para style="q" vid="JOL 2:3">Múa le meha wéndebei lubaragiñe hachülürün,</para>
  <para style="q" vid="JOL 2:3">ítara liña kei aban fulasu mageirawati lárigiñe houdin.</para>
  <para style="q" vid="JOL 2:3">Úati ni kata esefuruti hawéi!<verse eid="JOL 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOL 2:4" />Henege gabayu hagía,</para>
  <para style="q" vid="JOL 2:4">éibaaguatiña kei gürigia ha hawagutiña gabayu,<verse eid="JOL 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOL 2:5" />le harein dan le hachubarun luagun burí wübü,</para>
  <para style="q" vid="JOL 2:5">ítara liña kei tamuri burí karü to lánina wuribu,</para>
  <para style="q" vid="JOL 2:5">kei lamuri ubanaü sáühali dan le lágudun wáturugu,</para>
  <para style="q" vid="JOL 2:5">ítara haña kei súdara héretiña ha aransetiña lubá wuribu.<verse eid="JOL 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOL 2:6" />Adadagaratiña gürigia dan le harihiniña.<verse eid="JOL 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 2:7" />Keisi wügüriña wuriburuguna ha ganigitiña,</para>
  <para style="q" vid="JOL 2:7">éibaaguatiña, warí hamuti burí baríeiru,</para>
  <para style="q" vid="JOL 2:7">awansetiña habaruaguóun meferidirunga haméi hémeri.<verse eid="JOL 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOL 2:8" />Mabuguchaguntiña hawougua;</para>
  <para style="q" vid="JOL 2:8">héibugun kada aban luagu hémeri,</para>
  <para style="q" vid="JOL 2:8">sügütiña tabadinaguagiñe gimara machagaragunga hagía.<verse eid="JOL 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 2:9" />Belutiña uburugun, éibaaguatiña ligibuagu baríeiru,</para>
  <para style="q" vid="JOL 2:9">waritiña tuéigiñe burí muna,</para>
  <para style="q" vid="JOL 2:9">belutiña lídangiñe funedera kei híwerutiña.<verse eid="JOL 2:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="JOL 2:10" />Adadagarati múa hagibugiñe,</para>
  <para style="q" vid="JOL 2:10">hingiguati sielu, búriti weyu luma hati</para>
  <para style="q" vid="JOL 2:10">féridi hamuti waruguma hámirihan.<verse eid="JOL 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 2:11" />Aganbagüda lumuti Wabureme lumalali</para>
  <para style="q" vid="JOL 2:11">le ítarabei kei wayuhuru hagibugiñe lisudaran.</para>
  <para style="q" vid="JOL 2:11">Gíbetiña lisudaranigu; siñati habahüdün ha agunfulirubalin lererun.</para>
  <para style="q" vid="JOL 2:11">Wéiriti ani hanarimeti luéyuri Wabureme!</para>
  <para style="q" vid="JOL 2:11">Úati kaba lan gayara lawanduni.<verse eid="JOL 2:11" /></para>
  <para style="s1">Lugudemehabu Wabureme</para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 2:12" />«Gama lumoun guentó —lariñahare Wabureme—,</para>
  <para style="q" vid="JOL 2:12">giribu humá nun tau sun hanigi.</para>
  <para style="q" vid="JOL 2:12">Hayunara, hagúaragua, hayahua!»<verse eid="JOL 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 2:13" />Giribu humá lun Wabureme le Wabungiute,</para>
  <para style="q" vid="JOL 2:13">héirigua humóun hanigi,</para>
  <para style="q" vid="JOL 2:13">mamalá hadaüragun haheiridagua!</para>
  <para style="q" vid="JOL 2:13">Lugundun gudemehabuti Wabureme,</para>
  <para style="q" vid="JOL 2:13">wéiriti lareini ani hínsiñehabuti,</para>
  <para style="q" vid="JOL 2:13">aranseñu liña súnwandan lun lerederuni labeihan.<verse eid="JOL 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 2:14" />Háfugadügü laritagun mabeichun lanün,</para>
  <para style="q" vid="JOL 2:14">ábame lóunahan abiniruni hun luma ilaü luma diwéin lun</para>
  <para style="q" vid="JOL 2:14">lidewese Wabureme le Wabungiute.<verse eid="JOL 2:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="JOL 2:15" />Win humóun fidu luagu luwübüri Sión!</para>
  <para style="q" vid="JOL 2:15">Óundaragua humaña gürigia, ayunara huguyame;<verse eid="JOL 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 2:16" />Óundaragua humaña lumutuniña Wabungiute;</para>
  <para style="q" vid="JOL 2:16">harumagüda humaña; óundaragua humaña wéiyaaña mutu, irahüñü hama ha guragiña.</para>
  <para style="q" vid="JOL 2:16">Íbini ha sun liñabei hamarieidun, furí hamá harumunrugugiñe!<verse eid="JOL 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 2:17" />Hayahuaha fádirigu,</para>
  <para style="q" vid="JOL 2:17">ha eseriwidubalin Wabureme lidan tibürürün ténpulu</para>
  <para style="q" vid="JOL 2:17">ariñaga humá labadinagua tebelaagüle ténpulu luma latarü:</para>
  <para style="q" vid="JOL 2:17">«Wabureme, ferudunabaña bumutuniña;</para>
  <para style="q" vid="JOL 2:17">mígiraba lun ladügǘn bula hau bánigu;</para>
  <para style="q" vid="JOL 2:17">mígiraba lun hadügüni amu néchanigu habusenrun hau,</para>
  <para style="q" vid="JOL 2:17">ni lun hariñagun gibe tubungiutegu: “Hagéi san Habungiute?” »<verse eid="JOL 2:17" /></para>
  <para style="ms">II. Füramase Lan Bungiu Labiniruniya Múa</para>
  <para style="mr">(<ref loc="JOL 2:18-27">2.18-27</ref>)</para>
  <para style="s1">Labiniruniya Wabureme múa</para>
  <para style="p">
    <verse number="18" style="v" sid="JOL 2:18" />Ábati larufuduni Wabureme línsiñehabu houn lumutuniña; aba gudemehabu lan houn, <verse eid="JOL 2:18" /><verse number="19" style="v" sid="JOL 2:19" />aba lariñagun:</para>
  <para style="b" vid="JOL 2:19" />
  <para style="q" vid="JOL 2:19">«Nóunaha türigu houn luma diwéin luma garaba darí hakimuledun;</para>
  <para style="q" vid="JOL 2:19">mígirundigiaadina lun hadügün gibe tubungiutegu ha bula hau.<verse eid="JOL 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 2:20" />Nadisedagüdübaña chagagaru ha</para>
  <para style="q" vid="JOL 2:20">ñǘbuinbaña luéigiñe nórute huéi,</para>
  <para style="q" vid="JOL 2:20">ábame nachagaruniña lidoun fulasu mageirawati.</para>
  <para style="q" vid="JOL 2:20">Nañaradaguagüdübaña ha ubaraübaña lidan</para>
  <para style="q" vid="JOL 2:20">barana hilaali,</para>
  <para style="q" vid="JOL 2:20">ha árigibaña lidan Mediteraniu,</para>
  <para style="q" vid="JOL 2:20">ábame lañaladun hágubu ábame língidun,</para>
  <para style="q" vid="JOL 2:20">Nadügüba katei wéinamuburiti!<verse eid="JOL 2:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="JOL 2:21" />«Gundaaguabá saragu, múa, manufudedabá,</para>
  <para style="q" vid="JOL 2:21">lugundun ladügüba Wabureme katei wéinamuburiti.<verse eid="JOL 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOL 2:22" />Manufudeda humá animaalugu áraabuna,</para>
  <para style="q" vid="JOL 2:22">lalumadayaba sagadi,</para>
  <para style="q" vid="JOL 2:22">lagindayaba nadü, ñeinboun saragu igu tuma beibei.<verse eid="JOL 2:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOL 2:23" />Gúndaagua humá, huguya lílana Sión,</para>
  <para style="q" vid="JOL 2:23">gunda humá luma Wabureme le Wabungiute!</para>
  <para style="q" vid="JOL 2:23">Áhuyagüda laali huya hun lidan dan,</para>
  <para style="q" vid="JOL 2:23">huya lárigiñe alubahani luma huya lubaragiñe alubahani</para>
  <para style="q" vid="JOL 2:23">ítara kéiñaha ladügüni.<verse eid="JOL 2:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOL 2:24" />Ñeinbei aban buiti lalubahóun türigu</para>
  <para style="q" vid="JOL 2:24">luma saragu diwéin luma garaba.<verse eid="JOL 2:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOL 2:25" />Nafayeirubei irumu burí le heferidirubei hun hadüga chagagaru,</para>
  <para style="q" vid="JOL 2:25">súdaragu gagünrinchaguaditiña ha nóunahabaña huagun.<verse eid="JOL 2:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOL 2:26" />Héigiba darí hakimuledun</para>
  <para style="q" vid="JOL 2:26">ábame heremuhan lun Wabureme le Wabungiute,</para>
  <para style="q" vid="JOL 2:26">ladüga adügaadina óunwenbu burí katei huagu.</para>
  <para style="q" vid="JOL 2:26">Manügündigiaañame numutuniña busiganu,<verse eid="JOL 2:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOL 2:27" />ani huguya Ísüraelina, hasubudirubei luagu</para>
  <para style="q" vid="JOL 2:27">anahein lan huma au le Aburemei,</para>
  <para style="q" vid="JOL 2:27">luagu au lan Hubungiutebei, úati amu nuéi.</para>
  <para style="q" vid="JOL 2:27">Manügündigiaañame numutuniña busiganu!»<verse eid="JOL 2:27" /></para>
  <para style="ms">III. Luéyuri Bungiu Suntigabafu</para>
  <para style="mr">(<ref loc="JOL 2:28-3:21">2.28—3.21</ref>)</para>
  <para style="s1">Luéyuri Wabungiute</para>
  <para style="q">
    <verse number="28" style="v" sid="JOL 2:28" />«Lárigiñeme burí katei le,</para>
  <para style="q" vid="JOL 2:28">nóunahabei nani Sífiri hawagun sun gürigia:</para>
  <para style="q" vid="JOL 2:28">Hadimurehaba hisaanigu luéigiñe nóubadina,</para>
  <para style="q" vid="JOL 2:28">gewenedübaña wéiyaaña mutu,</para>
  <para style="q" vid="JOL 2:28">harihuba wügüriña nibureintiña arufudúni.<verse eid="JOL 2:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOL 2:29" />Lidoun burime weyu ligía,</para>
  <para style="q" vid="JOL 2:29">nóunahabei giñe nani Sífiri hawagun idamuni;<verse eid="JOL 2:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOL 2:30" />narufuduba óunwenbu burí katei buiti sielu,</para>
  <para style="q" vid="JOL 2:30">narufuduba giñe hitaü, watu gemeti,</para>
  <para style="q" vid="JOL 2:30">luma dúeri lau gumuleli ubouagu.<verse eid="JOL 2:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOL 2:31" />Laburigaduba weyu, láfunaduba hati kei hitaü,</para>
  <para style="q" vid="JOL 2:31">lubaragiñe lachülürün luéyuri Wabureme,</para>
  <para style="q" vid="JOL 2:31">weyu wéiriti ani hanufunati».<verse eid="JOL 2:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="JOL 2:32" />Gama lumoun sun ha agúaruti liri Wabureme,</para>
  <para style="q" vid="JOL 2:32">hesefuruba lídangiñe óunweni,</para>
  <para style="q" vid="JOL 2:32">ladüga ñeinbei esefuruni luagu wübü Sión le lani Herusalén,</para>
  <para style="q" vid="JOL 2:32">ítara kei lariñaguni Wabureme.</para>
  <para style="q" vid="JOL 2:32">Ha anúadira láañabaña herederuba wínwanñu.<verse eid="JOL 2:32" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="s1">Laguseragüdübaña Wabungiute néchanigu</para>
  <para style="q">
    <verse number="1" style="v" sid="JOL 3:1" />Lariñahare Wabureme:</para>
  <para style="q" vid="JOL 3:1">«Danme lachülürün oura ligía,</para>
  <para style="q" vid="JOL 3:1">nadügüba lun lasansiragun</para>
  <para style="q" vid="JOL 3:1">lubunurun Hudá luma Herusalén.<verse eid="JOL 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 3:2" />Nóundarubaña sun néchanigu,</para>
  <para style="q" vid="JOL 3:2">nanügübaña luagun fulasu wayati Hosafátü</para>
  <para style="q" vid="JOL 3:2">ábame naguseragüdüniña ñein luagu le hadügübei</para>
  <para style="q" vid="JOL 3:2">houn Ísüraelina ha numutuniña.</para>
  <para style="q" vid="JOL 3:2">Ladüga chagagua hamutiña Ísüraelina lidoun sun ubóu,</para>
  <para style="q" vid="JOL 3:2">aba hafanreinhani nageira hádangua.<verse eid="JOL 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 3:3" />Fánreingua hamutiña numutuniña hádangua,</para>
  <para style="q" vid="JOL 3:3">aluguraha hamutiña irahüñü,</para>
  <para style="q" vid="JOL 3:3">aba hewesiruni seinsu tuagu diwéin luma hawagu horu».<verse eid="JOL 3:3" /></para>
  <para style="s1">Lasiadiruniña Bungiu néchanigu</para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4" />—Ka habusenrubei númagiñe, Tiru, Sidón luma Filistéa? Busentün haguburahan somu katei? Madisebei nafayeiruni le hadünabei hun! <verse eid="JOL 3:4" /><verse number="5" style="v" sid="JOL 3:5" />Íweruha humuti nani pülata luma nigolun, barǘ humuti nirisin tidoun hitenpulun. <verse eid="JOL 3:5" /><verse number="6" style="v" sid="JOL 3:6" />Barǘ humutiña lílana Hudá diseun hama lílana Herusalén aba haluguruniña houn Güresiana keisi idamuni. <verse eid="JOL 3:6" /><verse number="7" style="v" sid="JOL 3:7" />Gama lumoun nasagarubaña lídangiñe fulasu le ñein lubéi haluguraña, ábame nasufuriragüdünün kei hagía. <verse eid="JOL 3:7" /><verse number="8" style="v" sid="JOL 3:8" />Nalugurubaña hirahüñü houn huríu lun haluguruniña huríu houn Sabaana, gürigia dise tageira. Au le Aburemei ariñagubalin.<verse eid="JOL 3:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="JOL 3:9" />Subudigüda huméi le houn sun néchanigu:</para>
  <para style="q" vid="JOL 3:9">Agúaraha huméi wuribu!</para>
  <para style="q" vid="JOL 3:9">Wa humá houn ganigitiña!</para>
  <para style="q" vid="JOL 3:9">Ñübuin hamá wuriburuguna,</para>
  <para style="q" vid="JOL 3:9">awanse hamá!<verse eid="JOL 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 3:10" />Hadaagua eféin tau hahuute,</para>
  <para style="q" vid="JOL 3:10">luma abeihagülei lídangiñe harufunte</para>
  <para style="q" vid="JOL 3:10">ariñagalá le débilibei:</para>
  <para style="q" vid="JOL 3:10">«Ganigitina!»<verse eid="JOL 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 3:11" />Sun huguya néchanigu ha yarafabaña,</para>
  <para style="q" vid="JOL 3:11">óufuda humá, higougu hóundaragua!</para>
  <para style="q" vid="JOL 3:11">Le gürigia le gálumabei, lawuribuha!<verse eid="JOL 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 3:12" />Aranse hamá néchanigu,</para>
  <para style="q" vid="JOL 3:12">heiba luagun fulasu wayati Hosafátü,</para>
  <para style="q" vid="JOL 3:12">ladüga ñeinba laguseragüdaña</para>
  <para style="q" vid="JOL 3:12">Wabureme sun néchanigu ha yarafabaña.<verse eid="JOL 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 3:13" />Ladüga lueirin hariban,</para>
  <para style="q" vid="JOL 3:13">chaün humaña kei türigu funaali,</para>
  <para style="q" vid="JOL 3:13">lugundun lidaanihali alubahani.</para>
  <para style="q" vid="JOL 3:13">Chuingua humaña kei beibei, ladüga aranseli</para>
  <para style="q" vid="JOL 3:13">sun katei lun tadügün diwéin,<verse eid="JOL 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 3:14" />Añahein saragu gürigia luagu fulasu wayati le gíribei Diseidi,</para>
  <para style="q" vid="JOL 3:14">ladüga yarafaali luéyuri Wabureme.<verse eid="JOL 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOL 3:15" />Laburigaduba weyu luma hati,</para>
  <para style="q" vid="JOL 3:15">heferidirubei waruguma harugounga.<verse eid="JOL 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 3:16" />Dan laganbagüdüni Wabureme lumalali le ítarabei</para>
  <para style="q" vid="JOL 3:16">kei wayuhuru luéigiñe wübü Sión, uburugu Herusalén,</para>
  <para style="q" vid="JOL 3:16">adadagarati sielu luma múa.</para>
  <para style="q" vid="JOL 3:16">Gama lumoun Wabureme, aban aramudaguagülei ligía</para>
  <para style="q" vid="JOL 3:16">houn Ísüraelina ha lumutuniña.<verse eid="JOL 3:16" /></para>
  <para style="s1">Labiniruniña Wabureme lumutuniña</para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 3:17" />«Huguya, hasubudirubei luagu au lan</para>
  <para style="q" vid="JOL 3:17">le Habureme le Hubungiute, aganóua nan Sión.</para>
  <para style="q" vid="JOL 3:17">Ábanbei uburugu sánduti Herusalén.</para>
  <para style="q" vid="JOL 3:17">Márügüdündigia hamaali terencha.<verse eid="JOL 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 3:18" />Lídanme weyu ligía,</para>
  <para style="q" vid="JOL 3:18">tésehaba diwéin luma míligi kei duna luéigiñe burí wübü,</para>
  <para style="q" vid="JOL 3:18">líchuguba burí lirahüñü lidunari Hudá saragu duna.</para>
  <para style="q" vid="JOL 3:18">Lésehaba aban lísensen duna nitenpulunrugugiñe</para>
  <para style="q" vid="JOL 3:18">le lunbei láturaguni lani Sitimü fulasu wayati.<verse eid="JOL 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 3:19" />Lagünrinchawaguba Ehiptu,</para>
  <para style="q" vid="JOL 3:19">liábinba Edomu lun ábanbei lan fulasu mageirawati,</para>
  <para style="q" vid="JOL 3:19">ladüga hageindagun hama lílana Hudá,</para>
  <para style="q" vid="JOL 3:19">ladüga háfaraguniña maduruntiña.<verse eid="JOL 3:19" /></para>
  <para style="q">
    <verse number="20-21" style="v" sid="JOL 3:20-21" />Nafayeiragüdübei hóunwegun,</para>
  <para style="q" vid="JOL 3:20-21">úabei feruduna nani le gadurunbei.</para>
  <para style="q" vid="JOL 3:20-21">Gama lumoun ñéinbaña gürigia aganóua Hudá luma Herusalén súnwandan,</para>
  <para style="q" vid="JOL 3:20-21">Au, le Aburemei,</para>
  <para style="q" vid="JOL 3:20-21">naganóuba luagu wübü Sión».<verse eid="JOL 3:20-21" /></para>
  <chapter eid="JOL 3" />
</usx>