<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Tsishingini (tsw)</book>
  <para style="h">Juwe</para>
  <para style="toc3">Juw</para>
  <para style="toc2">Juwe</para>
  <para style="toc1">Juwe</para>
  <para style="mt2">Juwe</para>
  <para style="mt1">Juwe</para>
  <para style="is">Ucuɗuwu wa Aatagada a nda</para>
  <para style="ip">E reve ili ya̱ a̱ɓula̱ o ro adama a ɗa a vumava̱sula̱ Juwe shi. Agba waru a gura reve na̱ mantsa ma na u yuwain wuma wa̱ yi shi. Amma a ta majiyan ma na a ɗa ta̱ aatagada a̱ Juwe a'wan ukpakuton (500) a̱ tyo ukpakuna̱shi (400) kafu a matsan Yesu, a mantsa ma na Pasiya yuwusain tsugono tso o uvaɗi.</para>
  <para style="ip">Juwe yuwan ta̱ adanshi e ikaka ya akyun oɓolo na ambulu o upasu wa Filisidinu. A̱tsuma̱ e ili yo ndolo fo u cinkaya ta̱ urana wa̱ A̱sulazuva a na a̱ ri lo a̱ ta̱wa̱, a mantsa ma na A̱sulazuva na aciya̱yi wa̱ ge'eto aza a na a 'yuwain ili i na u cigai ya̱ a̱ɓula̱ a̱yi. Vumava̱sula̱ Juwe yuwan ta̱ adanshi adama e ifoɓi ya̱ A̱sulazuva oɓolo na̱ ɗewu va a ama a̱ yi avadala na̱ nzuwulai a dansa a̱ ta̱ tsura̱ isa'ani na aba'un a̱ tyo uba̱ta̱ wa ama'a. A̱ba̱jini aɗa'a a̱ yi ɗa nzuwulai n na A̱sula̱ a yuwain a na wa̱ lyungu na̱ Ruhu va Akiza a̱yi a̱ tyo uba̱ta̱ wa ama a̱yi suru, ali na̱ a̱ma̱ci olobo na̱ mukuci.</para>
  <para style="iot">Ili i na i ri pe a̱tsuma̱ a aatagada a nda</para>
  <para style="io1">A̱tsuma̱lima̱ a apapari 1:1-2:17</para>
  <para style="io1">Nzuwulai mu uka̱mbusa̱ cece 2:18-27</para>
  <para style="io1">Urana wa̱ A̱sulazuva 2:28-3:21</para>
  <para style="ib" />
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />Apa nda adanshi a na A̱sulazuva a dammai Juwe ulobo wa̱ Petuwe.<verse eid="JOL 1:1" /></para>
  <para style="s">A̱tsuma̱lima̱ a apapari</para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2" />Uwwai nda, a̱ɗu mbara,</para>
  <para style="q2" vid="JOL 1:2">poloi atsuvu a̱ɗu na i ri nden a̱tsuma̱ e iɗa!</para>
  <para style="q1" vid="JOL 1:2">Cu'un vi ili i nda i fara ta̱ ɗe</para>
  <para style="q2" vid="JOL 1:2">a rana ɗu ɗa?</para>
  <para style="q2" vid="JOL 1:2">Ko a rana vu nkaya n ɗu?<verse eid="JOL 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3" />I damma muwun n ɗu adama a ɗa a̱yi,</para>
  <para style="q2" vid="JOL 1:3">waru lyawa muwun nɗu n damma muwun nle,</para>
  <para style="q1" vid="JOL 1:3">muwun, muwun n muwun n ɗu a damma</para>
  <para style="q2" vid="JOL 1:3">mantsa ma na ma̱a̱ ri a̱a̱ ta̱wa̱.<verse eid="JOL 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4" />Ili i na oɓolo a apapari a tama a lyawai,</para>
  <para style="q2" vid="JOL 1:4">a̱vu akyun a gbagbain a̱ ta̱wa̱ a tama,</para>
  <para style="q1" vid="JOL 1:4">ili i na akyun a gbagbain a tama a lyawai,</para>
  <para style="q2" vid="JOL 1:4">a̱vu apapari e keke'en a̱ ta̱wa̱ a tama,</para>
  <para style="q1" vid="JOL 1:4">apapari e keke'en a tama a lyawai,</para>
  <para style="q2" vid="JOL 1:4">a̱vu o oɓolo a apapari o ro a̱ ta̱ ta̱wa̱ a tama.<verse eid="JOL 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5" />'Yoyin a̱ɗu ososowi, a̱vu i shon!</para>
  <para style="q2" vid="JOL 1:5">Saalai, a̱ɗu na yoo sowuso masayan,</para>
  <para style="q1" vid="JOL 1:5">saalai adama a masayan ma sa'avu,</para>
  <para style="q2" vid="JOL 1:5">adama a na a usa yi ta̱ a̱ na̱ ɗu.<verse eid="JOL 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6" />Adama a na iɗa i ro i riya̱a̱ ta̱ iɗa i va̱,</para>
  <para style="q2" vid="JOL 1:6">oɓolo a ɗa a na a̱ ri nu ucira lon,</para>
  <para style="q2" vid="JOL 1:6">a̱soja a̱ yi a̱ ri n kece shi.</para>
  <para style="q1" vid="JOL 1:6">Ucira wa anga apapari o ndolo a̱ ta̱ tsa za vu kamu,</para>
  <para style="q2" vid="JOL 1:6">tsa a kamu vu ka na ri o upan.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="REV 9:8">Wen 9:8</ref>.</char></note><verse eid="JOL 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7" />Oɓolo o ndolo a yuwan ta̱ ulungusu</para>
  <para style="q2" vid="JOL 1:7">wu uɗuma̱ wa aataci a̱ ina̱bi a̱ va̱,</para>
  <para style="q2" vid="JOL 1:7">a̱vu a̱ lungusa̱ ɗanga vu ubiri va̱,</para>
  <para style="q1" vid="JOL 1:7">a̱vu a̱ pucu'wan a̱vun a ɗanga'a,</para>
  <para style="q2" vid="JOL 1:7">a̱vu a̱ ka̱mba̱to eten e le a̱ ka̱mba̱ u'uri puka̱!<verse eid="JOL 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8" />Shoyin mesun mo a̱tsumola̱ngu tsu usheli</para>
  <para style="q2" vid="JOL 1:8">u na ri wotowu na akashamuna a̱ a̱tsumola̱ngu</para>
  <para style="q2" vid="JOL 1:8">adama o ukwa̱ we eegeɓe a̱yi.<verse eid="JOL 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9" />Babu kucci vi ishina ko kucci vi ili yo oso</para>
  <para style="q2" vid="JOL 1:9">a̱tsuma̱ o U'wa wa̱ A̱sula̱.</para>
  <para style="q1" vid="JOL 1:9">Nan ganu a ta yuwusan mesun ma̱ a̱tsumola̱ngu,</para>
  <para style="q2" vid="JOL 1:9">e le na a yuwusaan A̱sulazuva a̱ga̱nda̱.<verse eid="JOL 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10" />Atsusa a̱ la̱nga̱ ta̱,</para>
  <para style="q2" vid="JOL 1:10">iɗa i ta̱ mesun tsa za va̱ a̱tsumola̱ngu,</para>
  <para style="q2" vid="JOL 1:10">adama a na a̱ lungusa̱ ta̱ ishina,</para>
  <para style="q2" vid="JOL 1:10">waru masayan ma sa'avu me 'yewe ta̱,</para>
  <para style="q2" vid="JOL 1:10">reve mani'in ma̱ zetun mo koto!<verse eid="JOL 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11" />Yuwain a̱tsumola̱ngu a̱ɗu acimbi!</para>
  <para style="q2" vid="JOL 1:11">I saala, a̱ɗu a̱za̱ mokpoko mo umatsun inabi!</para>
  <para style="q1" vid="JOL 1:11">Saalai adama o oroci a yitabo oɓolo na̱ yitabo,</para>
  <para style="q2" vid="JOL 1:11">adama a na itana yu uɗuma̱ i la̱nga̱ ta̱.<verse eid="JOL 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12" />A̱ɗuma̱ a̱ inabi e 'yewe ta̱ cece!</para>
  <para style="q2" vid="JOL 1:12">Ɗanga vu biri a kpanla ta̱ suru,</para>
  <para style="q1" vid="JOL 1:12">ne ɗa fo ɗanga na a̱ tsu ɗe ruma fo e 'yewei,</para>
  <para style="q2" vid="JOL 1:12">oɓolo na̱ da̱bina̱, oɓolo na̱ ɗanga muwun m peme,</para>
  <para style="q2" vid="JOL 1:12">ɗanga va atsusa na tsu matsan suru 'yewe ta̱,</para>
  <para style="q1" vid="JOL 1:12">na amayun ma̱za̱nga̱ mo koto ta̱ cece</para>
  <para style="q2" vid="JOL 1:12">diga e ekere a vaɗilima̱.<verse eid="JOL 1:12" /></para>
  <para style="s">Ɗewu adama o uvadalasa na avasa</para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13" />I oto akashamuna a̱ a̱tsumola̱ngu,</para>
  <para style="q2" vid="JOL 1:13">a̱ɗu nan ganu,</para>
  <para style="q1" vid="JOL 1:13">reve i saala,</para>
  <para style="q2" vid="JOL 1:13">a̱ɗu na yaa yuwusaan A̱sula̱ a̱ga̱nda̱ elime a masa'a.</para>
  <para style="q1" vid="JOL 1:13">Uwai a̱tsuma̱ A̱a̱'isa̱,</para>
  <para style="q2" vid="JOL 1:13">ya asa a̱tsuma̱ a akashamuna a̱tsumola̱ngu,</para>
  <para style="q2" vid="JOL 1:13">a̱ɗu na yaa yuwusaan A̱sula̱ a̱ va̱ a̱ga̱nda̱!</para>
  <para style="q1" vid="JOL 1:13">Adama a na babu kucci vi ishina na̱ kucci vi ili yo oso</para>
  <para style="q2" vid="JOL 1:13">a̱tsuma̱ o U'wa wa̱ A̱sula̱ a̱ɗu.<verse eid="JOL 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14" />Lapai ulingi adama a na a yuwan akuli,</para>
  <para style="q2" vid="JOL 1:14">i yuwan ɗewu vi iɓolo ya akiza.</para>
  <para style="q1" vid="JOL 1:14">I ɓoloto mbara oɓolo na aza a na a̱ ri nden e iɗa'a</para>
  <para style="q2" vid="JOL 1:14">a uwa a̱tsuma̱ o U'wa wa̱ A̱sulazuva A̱sula̱ a̱ɗu,</para>
  <para style="q2" vid="JOL 1:14">adama e showen A̱sulazuva.<verse eid="JOL 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15" />A̱tsuma̱lima̱ adama o urana u ndolo!</para>
  <para style="q2" vid="JOL 1:15">Adama a na urana wa̱ A̱sulazuva u yuwan ta̱ zuzu,</para>
  <para style="q2" vid="JOL 1:15">a̱tsuma̱lima̱ a ɗa diga uba̱ta̱ u Mogono me Ili Suru ma na ma̱ ri lo a̱ ta̱wa̱!<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="ISA 13:6">Ish 13:6</ref>.</char></note><verse eid="JOL 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16" />E esu a̱tsu a ɗa a̱ lungusa̱i ilyalya i tsu,</para>
  <para style="q2" vid="JOL 1:16">a̱tsuma̱ a̱tsu babu ma̱za̱nga̱ na̱ mere</para>
  <para style="q2" vid="JOL 1:16">o u'wa wa̱ A̱sula̱ a̱ tsu.<verse eid="JOL 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17" />Icu'un yi ca̱'a̱n i shama ta̱ e iɗa</para>
  <para style="q2" vid="JOL 1:17">babu itana a̱tsuma̱ mpon,</para>
  <para style="q1" vid="JOL 1:17">mpon waru fo o ɓoso ta̱,</para>
  <para style="q2" vid="JOL 1:17">adama a na ishina i 'yewe ta̱ a nan.<verse eid="JOL 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18" />O'o n ne'en cine inama i ri yaa yisaali.</para>
  <para style="q2" vid="JOL 1:18">Oɓolo e inan a̱ ra̱pula̱ ta̱</para>
  <para style="q2" vid="JOL 1:18">adama a na a̱ ri na anlya a na a yuwan alyuna shi.</para>
  <para style="q1" vid="JOL 1:18">Waru oɓolo e ikyon na̱ mgbele</para>
  <para style="q2" vid="JOL 1:18">a ta uwwusa a̱tsuma̱lima̱.<verse eid="JOL 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19" />A̱sulazuva ya̱'a̱ wu ɗa n ri ya̱a̱ mesun!</para>
  <para style="q2" vid="JOL 1:19">Adama a na akina a̱ kula̱to ta̱ anlya alyuna</para>
  <para style="q2" vid="JOL 1:19">elentsu a akina a̱ kula̱to ta̱ ɗanga va atsusa suru.<verse eid="JOL 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20" />Ko inama yu una fo</para>
  <para style="q2" vid="JOL 1:20">a ta yuwusan mesun a̱ tyo ya̱'a̱ wu,</para>
  <para style="q1" vid="JOL 1:20">adama a na ɗolu 'yewe ta̱ cece,</para>
  <para style="q2" vid="JOL 1:20">waru akina a̱ kula̱to ta̱ uba̱ta̱ wa alyuna.<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="s">Iroci yu urana wa̱ A̱sulazuva</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1" />Yi ivula̱ avana a̱tsuma̱ a̱ Sihiyona,</para>
  <para style="q2" vid="JOL 2:1">i saala zuva Masasan ma̱ va̱ ma Akiza!</para>
  <para style="q1" vid="JOL 2:1">Lyawa ama a na a̱ ri nden a̱tsuma̱ e iɗa'a suru e je'en lipu,</para>
  <para style="q2" vid="JOL 2:1">adama a na urana wa̱ A̱sulazuva u ta̱ lo a̱ ta̱wa̱</para>
  <para style="q2" vid="JOL 2:1">waru u yuwan ta̱ zuzu.<verse eid="JOL 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 2:2" />Urana wi irumbu u ɗa na̱ a̱tsuma̱lima̱,</para>
  <para style="q2" vid="JOL 2:2">urana we eleshe oɓolo ni irumbu i pici i ɗa.</para>
  <para style="q1" vid="JOL 2:2">Tsi irumbu i na a bazai zuva vu nsasan</para>
  <para style="q2" vid="JOL 2:2">ne ɗa o oɓolo a̱soja o ucira a̱ ri lo a̱ ta̱wa̱,</para>
  <para style="q1" vid="JOL 2:2">waru a̱ da̱shi ene cu'un va̱ yi shi, diga a mantsa a̱ tyo a mantsa.<verse eid="JOL 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3" />Akina a̱ da̱na̱ ta̱ a lyuwusa elime a̱ a̱soja,</para>
  <para style="q2" vid="JOL 2:3">a̱ca̱pa̱ e le waru elentsu a akina a̱ ta̱ da̱na̱ lyuwusa.</para>
  <para style="q1" vid="JOL 2:3">Elime e le iɗa'a i ta̱ da̱na̱ ulobonu tsa̱ a̱a̱rumbu a Adini,</para>
  <para style="q2" vid="JOL 2:3">amma a mantsa ma na a̱ ka̱ra̱i,</para>
  <para style="q1" vid="JOL 2:3">reve wo o'wo a̱tsumona.</para>
  <para style="q2" vid="JOL 2:3">Na amayun babu ili i na ya la'a diga e ekere e le.<verse eid="JOL 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4" />Iroci ya apapari'i o rotso ta̱ iroci yi ido,</para>
  <para style="q2" vid="JOL 2:4">e ilaɗi cine vu revei ido yu uvon.<note caller="-" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="REV 9:7-9">Wen 9:7-9</ref>.</char></note><verse eid="JOL 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5" />A tsu'yan zuva vu nsasan,</para>
  <para style="q2" vid="JOL 2:5">ilama i le cine vu revei ilama yi ikeke yi ido ɗa,</para>
  <para style="q1" vid="JOL 2:5">na̱ ma̱gugwa̱ cine vu revei akina a malyuwa,</para>
  <para style="q2" vid="JOL 2:5">tsa ali o uvon o ucira na a darai adama o uvon.<verse eid="JOL 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6" />E menee me ele nɗa n tsu da'wan ta̱,</para>
  <para style="q2" vid="JOL 2:6">waru urewesu wu nɗa'a suru u tsu la̱nga̱ ta̱.<verse eid="JOL 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7" />A tsu yuwan ta̱ tsa̱ a̱za̱ o uvon,</para>
  <para style="q2" vid="JOL 2:7">a tsu pasa ta̱ ukari tsa̱ a̱soja.</para>
  <para style="q1" vid="JOL 2:7">A tsu wala ta̱ ugeru ugeru,</para>
  <para style="q2" vid="JOL 2:7">babu vuma na tsu takatsuwa.<verse eid="JOL 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8" />A tsu uwulai o ugeru shi,</para>
  <para style="q2" vid="JOL 2:8">za suru tsu wala ta̱ mejege o ure wa̱ yi.</para>
  <para style="q1" vid="JOL 2:8">A tsu ɓatsalai ta̱ a̱tsuma̱ a n'yuwatan nle</para>
  <para style="q2" vid="JOL 2:8">waru babu vuma na tsi isawaton le.<verse eid="JOL 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9" />A̱ tsu 'ya̱wa̱ ta̱ na̱ a̱ ta̱wi a̱tsuma̱ a̱ lyuci,</para>
  <para style="q2" vid="JOL 2:9">a̱ tsu da̱na̱ ta̱ e ilaɗi o ukari a uwa a 'wa.</para>
  <para style="q2" vid="JOL 2:9">A tsu uwa ta̱ nu usowoto wu upepu tse evu.<verse eid="JOL 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10" />A̱ ma̱ka̱ka̱n me ele iɗa i tsu jinga̱ɗa̱ ta̱,</para>
  <para style="q2" vid="JOL 2:10">zuva va zuva tsu je'en ta̱ lipu.</para>
  <para style="q1" vid="JOL 2:10">Waru urana na̱ woto o tso o'wo ta̱ irumbu,</para>
  <para style="q2" vid="JOL 2:10">italyo'o fo aa casu ekan shi.<note caller="-" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="REV 8:12">Wen 8:12</ref>.</char></note><verse eid="JOL 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11" />Nu uɗyo wu ucira wa̱ yi,</para>
  <para style="q2" vid="JOL 2:11">A̱sulazuva a damma ta̱ a̱soja a̱ yi,</para>
  <para style="q2" vid="JOL 2:11">a̱soja a̱ yi a̱ ri kece shi!</para>
  <para style="q1" vid="JOL 2:11">A̱soja a na a yuwusan tsutoni nu udammu wa̱ yi</para>
  <para style="q2" vid="JOL 2:11">a̱ ta̱ nu ucira lon.</para>
  <para style="q1" vid="JOL 2:11">Na amayun urana wa̱ A̱sulazuva a̱ba̱jini a ɗa,</para>
  <para style="q2" vid="JOL 2:11">za na a casu wovon lon,</para>
  <para style="q2" vid="JOL 2:11">zane ɗa aa la'a?<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="REV 6:17">Wen 6:17</ref>.</char></note><verse eid="JOL 2:11" /></para>
  <para style="s">Ɗewu adama a na a vadala</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12" />Apa ili i na A̱sulazuva a dammai,</para>
  <para style="q1" vid="JOL 2:12">&lt;&lt;Ko gogo,</para>
  <para style="q2" vid="JOL 2:12">i ta gura ka̱mba̱ uba̱ta̱ u va̱ no okolo a̱ ta̱,</para>
  <para style="q2" vid="JOL 2:12">na akuli na̱ mesun, na̱ a̱tsumola̱ngu.&gt;&gt;<verse eid="JOL 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13" />Wukaru wa̱ a̱tugu a̱ɗu u rawa shi,</para>
  <para style="q2" vid="JOL 2:13">lyawa okolo a̱ɗu o roco uvadalasa u ɗu.</para>
  <para style="b" vid="JOL 2:13" />
  <para style="q1" vid="JOL 2:13">I ka̱mba̱ uba̱ta̱ wa̱ A̱sulazuva A̱sula̱ a̱ɗu,</para>
  <para style="q2" vid="JOL 2:13">adama a na u ta̱ ni isa'ani waru u tse ene ta̱ iliyali,</para>
  <para style="q2" vid="JOL 2:13">icigi ya̱ yi i tsu vadala shi,</para>
  <para style="q2" vid="JOL 2:13">waru u tsu vadala ta̱ e ili i na u dammai waa yuwan.<verse eid="JOL 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14" />N na̱ i ka̱mba̱ uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="JOL 2:14">zane ɗa revei ko u ta vadala diga a majiyan ma̱ yi</para>
  <para style="q2" vid="JOL 2:14">u zuwa ɗu aba'un?</para>
  <para style="q1" vid="JOL 2:14">U ta gura wo o'wo i cayisa</para>
  <para style="q2" vid="JOL 2:14">kucci vi ishina na̱ kucci vi ili yo oso</para>
  <para style="q2" vid="JOL 2:14">uba̱ta̱ wa̱ A̱sulazuva A̱sula̱ a̱ ɗu.<verse eid="JOL 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15" />Ivula̱i avana ɗe Sihiyona!</para>
  <para style="q2" vid="JOL 2:15">I zuwa akuli a akiza adama a na yo o'wo cece!</para>
  <para style="q2" vid="JOL 2:15">I ɗe iɓolo ya̱ akiza!<verse eid="JOL 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16" />I ɓoloto wa ama!</para>
  <para style="q2" vid="JOL 2:16">I tawaa A̱sulazuva iɓolo ya akiza'a!</para>
  <para style="q1" vid="JOL 2:16">I ɓoloto mbara</para>
  <para style="q2" vid="JOL 2:16">na̱ muwun oɓolo na aza a na aa apusa maani!</para>
  <para style="q1" vid="JOL 2:16">Lyawa vali vu kasa'avu lyawa aasula a̱ yi,</para>
  <para style="q2" vid="JOL 2:16">kasa'avu fo u lyawa aarungutsu a̱ yi.<verse eid="JOL 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17" />Lyawa nan ganu a na a yuwusan a̱ga̱nda̱ a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva,</para>
  <para style="q2" vid="JOL 2:17">e memere ma̱ mo u'uwata wa̱ a̱a̱'isa̱ na̱ masa'a a̱ shon.</para>
  <para style="q1" vid="JOL 2:17">Lyawa le a damma, &lt;&lt;A̱sulazuva,</para>
  <para style="q2" vid="JOL 2:17">vee ene iliyali ya ama a̱ wu.</para>
  <para style="q1" vid="JOL 2:17">She vu lyawa ama a agadu a̱ wu a uwwa wono wan,</para>
  <para style="q2" vid="JOL 2:17">hali na nɗa n ro maa yuwan tsugono aci e le.</para>
  <para style="q1" vid="JOL 2:17">Adama nye ɗa aa damma a̱tsuma̱ a nɗa</para>
  <para style="q2" vid="JOL 2:17">&lt;Te ɗa gba A̱sula̱ e le?&gt; &gt;&gt;<verse eid="JOL 2:17" /></para>
  <para style="s">Nzuwulai ma̱ A̱sulazuva n na wa lapulisa iɗa'a</para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18" />Reve A̱sulazuva a yuwan tsushu'un adama e iɗa ya̱ yi</para>
  <para style="q1" vid="JOL 2:18">a̱vu we ene iliyali ya ama a̱ yi.<verse eid="JOL 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 2:19" />Reve A̱sulazuva a̱ usu avasa ama a̱ yi u damma,</para>
  <para style="q2" vid="JOL 2:19">&lt;&lt;A̱yi ɗa nda, n ta̱ lyungusa̱a̱ ɗu</para>
  <para style="q1" vid="JOL 2:19">ni ishina na̱ masayan oɓolo na̱ mani'in ma̱ zetun,</para>
  <para style="q2" vid="JOL 2:19">agba i ta̱ cuwa̱n ne le.</para>
  <para style="q1" vid="JOL 2:19">Agba ma̱a̱ da̱shi ka̱mbuwa̱ ɗu ili yi izo'oshi</para>
  <para style="q2" vid="JOL 2:19">e ekere a nɗa waru shi.<verse eid="JOL 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20" />N to lo apapari alanga na̱ a̱ɗu,</para>
  <para style="q2" vid="JOL 2:20">oɓolo na̱ a̱soja o ugana na a̱ riya̱a̱ ɗu nu uvon.</para>
  <para style="q1" vid="JOL 2:20">N to lo le a̱ tyo a̱tsumona a na a̱ ri babu ili,</para>
  <para style="q2" vid="JOL 2:20">aza a na a̱ ri elime a uwa a Mala ma Akpaɗi ma asana,</para>
  <para style="q2" vid="JOL 2:20">aza a na o tono le a̱ca̱pa̱ a uwa a Mala ma Araba wa̱ a̱livu.</para>
  <para style="q1" vid="JOL 2:20">Ushamu wa̱ a̱kwa̱kwa̱ le u ta̱ 'yon zuva,</para>
  <para style="q2" vid="JOL 2:20">ushamu wi iwuya i le i ta̱ ɓa̱ru ba̱ta̱ biti.</para>
  <para style="q1" vid="JOL 2:20">Na amayun a̱mu A̱sulazuva</para>
  <para style="q2" vid="JOL 2:20">n ta yuwan linga va asalama!<verse eid="JOL 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 2:21" />She vu uwwa wovon wan, a̱vu iɗa,</para>
  <para style="q2" vid="JOL 2:21">vu yuwan ma̱za̱nga̱ na̱ mere,</para>
  <para style="q1" vid="JOL 2:21">adama a na a̱mu A̱sulazuva</para>
  <para style="q2" vid="JOL 2:21">n yuwan ta̱ linga va asalama.<verse eid="JOL 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOL 2:22" />She yu uwwa wovon wan, a̱ɗu inama yu una,</para>
  <para style="q2" vid="JOL 2:22">adama a na anlya a̱tsumona a̱ lima̱na̱ ta̱,</para>
  <para style="q1" vid="JOL 2:22">ɗanga waru a matsan ta̱ muwun,</para>
  <para style="q2" vid="JOL 2:22">ɗanga vu biri oɓolo na̱ a̱ɗuma̱ a̱ inabi</para>
  <para style="q2" vid="JOL 2:22">a ta a limatan babu usa̱n.<verse eid="JOL 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23" />I yuwan ma̱za̱nga̱, a̱ɗu ama a̱ Sihiyona,</para>
  <para style="q2" vid="JOL 2:23">yuwain mere e ekere e ili i na A̱sulazuva a̱ A̱sula̱ a̱ ɗu a yuwaan nɗu,</para>
  <para style="q1" vid="JOL 2:23">na u ca yi iro'i yu ufaru,</para>
  <para style="q2" vid="JOL 2:23">waru u lyunguwa̱ ɗu na̱ mini ma̱ lyushi a mantsa ma na wuntsayi.<verse eid="JOL 2:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24" />Osoroto a ta shiwan ni ishina,</para>
  <para style="q2" vid="JOL 2:24">a̱ba̱jini e nden a ta shiwan hali o oco,</para>
  <para style="q2" vid="JOL 2:24">na̱ masayan ma̱ inabi oɓolo na̱ mani'in ma̱ zetun.&gt;&gt;<verse eid="JOL 2:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25" />&lt;&lt;N ta̱ ka̱mbuwa̱ ili i na apapari suru</para>
  <para style="q2" vid="JOL 2:25">a tamai a̱tsuma̱ a'wan nda,</para>
  <para style="q1" vid="JOL 2:25">ko apapari ɗa</para>
  <para style="q2" vid="JOL 2:25">ko akyun e keke'en</para>
  <para style="q1" vid="JOL 2:25">ko oɓolo akyun o ro ɗa,</para>
  <para style="q2" vid="JOL 2:25">ko akyun o ro a na a yuwusan agara a ɗa,</para>
  <para style="q2" vid="JOL 2:25">oɓolo a̱ba̱jini a̱ a̱soja a̱ va̱ na n lyunguwa̱a̱ nɗu.<verse eid="JOL 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26" />Diga gogo i ta lyuwa hali i cuwa̱n,</para>
  <para style="q2" vid="JOL 2:26">reve i cuwa Aala A̱sulazuva A̱sula̱ a̱ ɗu,</para>
  <para style="q2" vid="JOL 2:26">za na yuwain linga va asalama adama a̱ ɗu.</para>
  <para style="q1" vid="JOL 2:26">Ama a̱ va̱ aa buwa a uwwa wono shi.<verse eid="JOL 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27" />A̱ɗu Isra'ila i ta̱ gba reve a na n ri oɓolo a̱ ɗu,</para>
  <para style="q2" vid="JOL 2:27">waru i reve a na a̱mu A̱sulazuva A̱sula̱ a̱ ɗu a ɗa,</para>
  <para style="q2" vid="JOL 2:27">waru babu lo za ro.</para>
  <para style="q1" vid="JOL 2:27">Waru ama a̱ va̱ a buwa a uwwa wono shi. &gt;&gt;<verse eid="JOL 2:27" /></para>
  <para style="s">Urana wa̱ A̱sulazuva</para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28" />&lt;&lt;Na̱ a̱yi ndolo koto,</para>
  <para style="q2" vid="JOL 2:28">n ta̱ tsuwa̱a̱n a ama a̱ va̱ Ruhu va̱ suru.</para>
  <para style="q1" vid="JOL 2:28">Olobo a̱ɗu ne esheli a̱ɗu a ta yuwan adanshi e ikaka ya̱ A̱sula̱,</para>
  <para style="q2" vid="JOL 2:28">mbara nɗu n ta yuwan alavu,</para>
  <para style="q2" vid="JOL 2:28">olobo ne esheli a̱ɗu e te ene alavu alavu.<note caller="-" style="x"><char style="xo" closed="false">2:28 </char><char style="xt" closed="false"><ref loc="DEU 2:17-21">U.Wl 2:17-21</ref>.</char></note><verse eid="JOL 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29" />Hali fo agbashi a̱ɗu ali na̱ a̱ma̱ci</para>
  <para style="q2" vid="JOL 2:29">n ta̱ tsuwa̱a̱n le Ruhu va̱ a rana ndolo.<verse eid="JOL 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30" />N to roco ili ya asalama</para>
  <para style="q2" vid="JOL 2:30">zuva no o uvaɗi,</para>
  <para style="q2" vid="JOL 2:30">a ta yuwan mpasa na akina oɓolo na̱ a̱kutsu a̱ mikyon.<verse eid="JOL 2:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31" />Kafu uta̱wu wa̱ a̱ba̱jini o urana u ndolo</para>
  <para style="q2" vid="JOL 2:31">u wovon wa̱ A̱sulazuva,</para>
  <para style="q1" vid="JOL 2:31">urana u to o'wo irumbu,</para>
  <para style="q2" vid="JOL 2:31">woto waru san tsa mpasa.<note caller="-" style="x"><char style="xo" closed="false">2:31 </char><char style="xt" closed="false"><ref loc="MAT 24:29">Mat 24:29</ref>; <ref loc="MRK 13:24-25">Mak 13:24-25</ref>; <ref loc="LUK 21:25">Luk 21:25</ref>; <ref loc="REV 6:12-13">Wen 6:12-13</ref>.</char></note><verse eid="JOL 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32" />U ta̱ waru o'wo</para>
  <para style="q2" vid="JOL 2:32">za na suru ɗeyi a ala a̱ A̱sulazuva</para>
  <para style="q2" vid="JOL 2:32">adama e izami yi ikambishi a ta wawai.<note caller="-" style="x"><char style="xo" closed="false">2:32 </char><char style="xt" closed="false"><ref loc="ROM 10:13">Rom 10:13</ref>. </char></note></para>
  <para style="q1" vid="JOL 2:32">Waru a̱tsuma̱ a Masasan ma̱ Sihiyona na̱ a̱tsuma̱ a̱ Urishelima</para>
  <para style="q2" vid="JOL 2:32">a̱ ta̱ tsura̱ iwawi,</para>
  <para style="q2" vid="JOL 2:32">cine a̱mu A̱sulazuva n dammai,</para>
  <para style="q2" vid="JOL 2:32">a̱tsuma̱ a aza a na a buwai,</para>
  <para style="q2" vid="JOL 2:32">a̱ ta̱ na aza a na a̱mu A̱sulazuva me ɗesu.&gt;&gt;<verse eid="JOL 2:32" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="s">A̱sulazuva a̱ ta̱ ge'eto nɗa</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 3:1" />A̱sulazuva a damma ta̱,</para>
  <para style="q1" vid="JOL 3:1">&lt;&lt;A̱yi ɗa nda a̱tsuma̱ a rana nda na a mantsa ma nda,</para>
  <para style="q2" vid="JOL 3:1">n ta̱ ka̱mbuwa̱a̱ Yahuda na̱ Urishelima na aba'un e le.<verse eid="JOL 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2" />N to ɓoloto nɗa suru,</para>
  <para style="q2" vid="JOL 3:2">a̱vu n ta̱wa̱to le o Uka̱ri wa Jehoshafa.</para>
  <para style="q1" vid="JOL 3:2">Uba̱ta̱ u ɗaɗa mee ge'eto le adama a ama a̱ va̱,</para>
  <para style="q2" vid="JOL 3:2">adama a na e bete'we ta̱ ama a̱ va̱ aza a Isra'ila diga a̱tsuma̱ e le</para>
  <para style="q2" vid="JOL 3:2">reve fo e ne'eshen iɗa i va̱.<verse eid="JOL 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3" />Reve a zuwa agita adama a ama a̱ va̱</para>
  <para style="q2" vid="JOL 3:3">reve a kita'wa olobo o una̱ wa aashakala,</para>
  <para style="q2" vid="JOL 3:3">a wina esheli adama a masayan ma na oo sowo.&gt;&gt;<verse eid="JOL 3:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4" />&lt;&lt;Gogo tsunda! Nye i ɗa i ri na̱ a̱yi a aci a̱ va̱, a̱ɗu ilyuci ya Taya na̱ Sidon oɓolo na̱ mulyuci ya Filistiya? I ta tsupusa mu adama e ili i na n yuwain? Ni i ta tsupusa mu, n ta̱ ka̱mbuwa̱a̱ ɗu atsupu a̱ɗu e ekere a̱ɗu babu usa̱n.<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">Ish 14:29-31</ref>; <ref loc="ISA 23:1-18">23:1-18</ref>; <ref loc="JER 47:1-7">Irm 47:1-7</ref>; <ref loc="EZK 25:15">Izk 25:15</ref>; <ref loc="EZK 28:26">28:26</ref>; <ref loc="AMO 1:6-10">Emo 1:6-10</ref>; <ref loc="ZEP 2:4-7">Zaf 2:4-7</ref>; <ref loc="ZEC 9:1-7">Zak 9:1-7</ref>; <ref loc="MAT 11:21-22">Mat 11:21-22</ref>; <ref loc="LUK 10:13-14">Luk 10:13-14</ref>.</char></note> <verse eid="JOL 3:4" /><verse number="5" style="v" sid="JOL 3:5" />Adama a na i pura̱ mu ta̱ azurufa na̱ zinariya, aza a na a̱ ri itana isa'ani i va̱ na i pura̱i a̱ tyo asula a̱ a̱'isa̱ a̱ɗu. <verse eid="JOL 3:5" /><verse number="6" style="v" sid="JOL 3:6" />Reve waru i purisa̱ a ama a̱ va̱ aza a Yahuda na aza a Urishelima a̱vu i winaa a̱ a̱za̱ e Heleni tsa̱ra̱ a̱ 'ya̱wa̱to le alanga ni iɗa i le.&gt;&gt;<verse eid="JOL 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOL 3:7" />Reve A̱sulazuva a damma, &lt;&lt;Ka̱lyuwa̱i, n ta̱ ta̱wa̱to le diga uba̱ta̱ u na i wina nle, reve fo n yuwaan ɗu ili i na i yuwaan nle. <verse eid="JOL 3:7" /><verse number="8" style="v" sid="JOL 3:8" />N ta wina olobo ne esheli a̱ɗu a̱ tyo e ekere a ama a Yahuda, reve e le gba a wina le a̱ tyo e ekere a ama a Sabeya, ɗe e iɗa ya alanga ya Arama. A̱sulazuva a ɗa a dammai ne.&gt;&gt;<verse eid="JOL 3:8" /></para>
  <para style="s">A̱sula̱ a̱ ta̱ ge'eto waru u suɗato nɗa</para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9" />Reve A̱sulazuva a dammisa,</para>
  <para style="q1" vid="JOL 3:9">&lt;&lt;Dammai ili i nda a̱tsuma̱ a nɗa:</para>
  <para style="q2" vid="JOL 3:9">I foɓo uvon!</para>
  <para style="q1" vid="JOL 3:9">'Ya̱sa̱in ali o uvon!</para>
  <para style="q2" vid="JOL 3:9">I zuwa a̱soja a rawa zuzu,</para>
  <para style="q2" vid="JOL 3:9">a dara adama o uvon.<verse eid="JOL 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10" />I ka̱mba̱to a̱ba̱ri e iluma a̱ɗu o o'wo mutsun mu pe'eni,</para>
  <para style="q2" vid="JOL 3:10">mutsun wukoɗu we eten gba mbata.</para>
  <para style="q2" vid="JOL 3:10">Lyawa za babu ucira damma, &lt;N ta̱ nu ucira!&gt;<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="ISA 2:4">Ish 2:4</ref>; <ref loc="MIC 4:3">Mik 4:3</ref>.</char></note><verse eid="JOL 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11" />Ta̱wa̱i gogo gogo, a̱ɗu nɗa suru mu upasu suru,</para>
  <para style="q2" vid="JOL 3:11">i ɓoloto ɗe.</para>
  <para style="q2" vid="JOL 3:11">Vu zuwa a̱soja o uvon a̱ wu a̱ cipa̱, A̱sulazuva!<verse eid="JOL 3:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12" />&lt;&lt;Lyawa nɗa n 'yon a̱ ka̱ra̱,</para>
  <para style="q2" vid="JOL 3:12">a̱ tyo o Uka̱ri wa̱ Jehoshafa,</para>
  <para style="q2" vid="JOL 3:12">adama a na ɗe ɗa ma̱a̱ da̱nu</para>
  <para style="q2" vid="JOL 3:12">tsa̱ra̱ n ge'eto nɗa suru upasu suru.<verse eid="JOL 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13" />Nusu le yuwan ta̱ a̱bunda̱.</para>
  <para style="q2" vid="JOL 3:13">Vuta̱la̱i ugonu u ɗu, yipaɗa le</para>
  <para style="q2" vid="JOL 3:13">adama a na itana yu uɗuma̱ yi ina ta̱.</para>
  <para style="q1" vid="JOL 3:13">Ta̱wa̱i, i dadasa le cine i tsu dadasa umatsun u ina̱bi,</para>
  <para style="q2" vid="JOL 3:13">adama a na uba̱ta̱ u mokpoko u ina̱bi u shiwan ta̱,</para>
  <para style="q2" vid="JOL 3:13">hali na a̱ba̱jini a̱ba̱jini a ara'atsu a shiwain a̱ ri o moco adama a na iwuya i le i yuwan ta̱ a̱bunda̱ lon.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="REV 14:14-16">Wen 14:14-16</ref>,<ref loc="REV 14:19-20">19-20</ref>; <ref loc="REV 19:15">19:15</ref>.</char></note><verse eid="JOL 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14" />Oɓolo a̱ a̱bunda̱</para>
  <para style="q2" vid="JOL 3:14">a̱ ta̱ pe e ipiri o uka̱ri wu uge'etosu!</para>
  <para style="q1" vid="JOL 3:14">Adama a na urana wa̱ A̱sulazuva u yuwan ta̱ zuzu</para>
  <para style="q2" vid="JOL 3:14">o uka̱ri wu uge'etosu.<verse eid="JOL 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15" />Urana na̱ woto aa ta yuwan irumbu,</para>
  <para style="q2" vid="JOL 3:15">italyo'o waru a buwa aa casu ekan shi.<verse eid="JOL 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16" />A̱sulazuva a ta yuwan adanshi nu uɗyo u gbain diga Sihiyona,</para>
  <para style="q2" vid="JOL 3:16">reve u yuwan tsata diga Urishelima,<note caller="-" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="AMO 1:2">Emo 1:2</ref>.</char></note></para>
  <para style="q2" vid="JOL 3:16">uvaɗi na̱ zuva e te je'en lipu.</para>
  <para style="q1" vid="JOL 3:16">Amma A̱sulazuva o to o'wo upa'atan wu ucira wa ama a̱ yi,</para>
  <para style="q2" vid="JOL 3:16">na aatsura waru adama a aza a Isra'ila.<verse eid="JOL 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17" />&lt;&lt;Tsundolo tsa ɗa yee reve na a̱mu ɗa A̱sulazuva A̱sula̱ a̱ ɗu,</para>
  <para style="q2" vid="JOL 3:17">waru i ta̱ reve a na n ri nden a̱tsuma̱ a̱ Sihiyona,</para>
  <para style="q2" vid="JOL 3:17">aagaɗi a akiza a̱ va̱.</para>
  <para style="q1" vid="JOL 3:17">Urishelima ta̱ da̱na̱ na akiza,</para>
  <para style="q2" vid="JOL 3:17">babu waru omocin a na a̱a̱ da̱shi kuru pe.&gt;&gt;<verse eid="JOL 3:17" /></para>
  <para style="s">A̱sula̱ a ta zuwaa aza a Isra'ila aba'un</para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18" />&lt;&lt;O urana u ndolo</para>
  <para style="q2" vid="JOL 3:18">nsasan n to oco masayan ma sa'avu,</para>
  <para style="q1" vid="JOL 3:18">a̱vu agaɗi e yeneto maani,</para>
  <para style="q2" vid="JOL 3:18">reve ɗolu va Yahuda suru e yene na̱ mini.</para>
  <para style="q1" vid="JOL 3:18">Lyusu mini ta̱ yene</para>
  <para style="q2" vid="JOL 3:18">diga o U'wa wa̱ A̱sulazuva,</para>
  <para style="q2" vid="JOL 3:18">reve u ca Uka̱ri wa Akashiya mini.<verse eid="JOL 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19" />Amma Masar to o'wo okongo,</para>
  <para style="q2" vid="JOL 3:19">Edom waru a̱tsumona a na a̱ ri ni ili shi,</para>
  <para style="q1" vid="JOL 3:19">adama e iwuya i na a yuwayin</para>
  <para style="q2" vid="JOL 3:19">ama a Yahuda,</para>
  <para style="q1" vid="JOL 3:19">adama a na o ocoi mpasa ma aza a babu unusu</para>
  <para style="q2" vid="JOL 3:19">a̱tsuma̱ e iɗa ya Yahuda.<verse eid="JOL 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20" />Amma Yahuda gba to o'wo</para>
  <para style="q2" vid="JOL 3:20">uba̱ta̱ wu nden wa ama a̱ va̱ hali hali,</para>
  <para style="q2" vid="JOL 3:20">Urishelima waru ta̱ da̱na̱ lo diga a mantsa a̱ tyo a mantsa.<verse eid="JOL 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21" />N ta tsupa unusu u wocosu wu mpasa wu za na ri nu unusu shi,</para>
  <para style="q2" vid="JOL 3:21">maa yuwan le gafura shi,</para>
  <para style="q1" vid="JOL 3:21">a̱mu A̱sulazuva n ta̱ da̱na̱ nden a̱tsuma̱ a̱ Sihiyona.&gt;&gt;<verse eid="JOL 3:21" /></para>
  <chapter eid="JOL 3" />
</usx>