<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Tsishingini (tsw)</book>
  <para style="h">Nahum</para>
  <para style="toc3">Nah</para>
  <para style="toc2">Nahum</para>
  <para style="toc1">Nahum</para>
  <para style="mt2">Nahum</para>
  <para style="mt1">Nahum</para>
  <para style="is">Ucuɗuwu wa aatagada a nda</para>
  <para style="ip">Aatagada a Nahum Ishipa i ɗa na o rocosu ma̱za̱nga̱ mo uriyu wa Niniva, lyuci gbain va Asuriya, za na a yuwusan tsushu'un na̱ Isra'ila. U ta gura wo o'wo a ɗana ta̱ aatagada'a o una̱ wa a'wan Ukpakuta̱li na̱ kupa ne ejere 612 babu na a matsain Yesu. A̱risa̱ a Niniva a̱ ta̱ rocosu uge'etosu wa̱ A̱sula̱ adama aciyogbamu a̱ yi oɓolo na̱ a̱bunda̱ e iwuya i na u ri na̱ yi. Uge'etosu u nda u fara ta̱ o ukosu u mantsa ma̱ cindere babu na a matsain Yesu.</para>
  <para style="iot">Ili i na i ri pe a̱tsuma̱ a aatagada a nda</para>
  <para style="io">1. Uge'etosu wa Niniva 1:1-15</para>
  <para style="io">2. Uriyu wa Niniva 2:1-3:19.</para>
  <chapter number="1" style="c" sid="NAM 1" />
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1" />Adanshi e ikaka ya̱ A̱sula̱ a̱ tyo Niniva. Aatagada a alavu alavu a na Nahum vuma va Elikoshi enei.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="ISA 10:5-34">Ish 10:5-34</ref>; <ref loc="ISA 14:24-27">14:24-27</ref>; <ref loc="ZEP 2:13-15">Zaf 2:13-15</ref>.</char></note><verse eid="NAM 1:1" /></para>
  <para style="s">Upan wa̱ A̱sulazuva aci a Niniva</para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 1:2" />A̱sulazuva A̱sula̱ a̱ tsushu'un a ɗa,</para>
  <para style="q2" vid="NAM 1:2">waru za va atsupu a ɗa.</para>
  <para style="q1" vid="NAM 1:2">A̱sulazuva za va atsupu a ɗa,</para>
  <para style="q2" vid="NAM 1:2">waru za vu upan wu usuɗuwu.</para>
  <para style="q1" vid="NAM 1:2">U tsu tsupa ta̱</para>
  <para style="q2" vid="NAM 1:2">e ekere a n'yuwatan ma̱ yi.</para>
  <para style="q2" vid="NAM 1:2">A̱ ta̱wusa̱a̱ n'yuwatan ma̱ yi nu upan.<verse eid="NAM 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 1:3" />A̱sulazuva a tsu yuwan upan go'o shi,</para>
  <para style="q2" vid="NAM 1:3">waru za vu ucira u ɗa lon,</para>
  <para style="q2" vid="NAM 1:3">u tsu lyawa za vu unusu ka̱ra̱ fa̱a̱n shi.</para>
  <para style="b" vid="NAM 1:3" />
  <para style="q1" vid="NAM 1:3">Ure wa̱ yi u ta̱ pe a̱tsuma̱ a̱ lipa̱ na̱ wunla̱,</para>
  <para style="q2" vid="NAM 1:3">eleshe waru ma̱buta̱ ma apata ana a̱ yi.<verse eid="NAM 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 1:4" />U tsu ɓara ta̱ mala hali u 'yewe,</para>
  <para style="q2" vid="NAM 1:4">waru u tsu 'yeweto ta̱ ɗolu suru.</para>
  <para style="q1" vid="NAM 1:4">Bashan na̱ Kame a̱ tsu 'yewe ta̱,</para>
  <para style="q2" vid="NAM 1:4">yipa̱lu ya Lebanon fo a tsu kpanla ta̱.<verse eid="NAM 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 1:5" />Nsasan n tsu jinga̱ɗa̱ ta̱ elime a̱ yi,</para>
  <para style="q2" vid="NAM 1:5">agaɗi waru e jeruwe.</para>
  <para style="q1" vid="NAM 1:5">Uvaɗi u jinga̱ɗa̱ ta̱ elime a̱ yi</para>
  <para style="q2" vid="NAM 1:5">na aza a na a̱ ri pe a̱tsuma̱ a̱ yi.<verse eid="NAM 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 1:6" />Zane ɗa aa gura isawan a̱ ma̱ka̱ka̱n ma̱ yi</para>
  <para style="q2" vid="NAM 1:6">nu u yuwan upan?</para>
  <para style="q1" vid="NAM 1:6">Zane ɗa aa gura isawaan</para>
  <para style="q2" vid="NAM 1:6">usuɗuwu wu upan wa̱ yi?</para>
  <para style="q1" vid="NAM 1:6">Upan wa̱ yi u to ocusho tsa a akina,</para>
  <para style="q2" vid="NAM 1:6">atali a̱ ta̱ ɓosuso a̱ ma̱ka̱ka̱n ma̱ yi.<verse eid="NAM 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 1:7" />A̱sulazuva za vi isa'ani i ɗa,</para>
  <para style="q2" vid="NAM 1:7">uba̱ta̱ wu upa'atan wu ucira</para>
  <para style="q2" vid="NAM 1:7">a mantsa ma addama.</para>
  <para style="q1" vid="NAM 1:7">Waru u ta aɗa aza a na a zuwai ucira u le ya̱'a̱ yi.<verse eid="NAM 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 1:8" />Agba na̱ mini ma gbain ma ɗa</para>
  <para style="q2" vid="NAM 1:8">A̱sulazuva o kototo Niniva,</para>
  <para style="q2" vid="NAM 1:8">u ta̱ lo n'yuwatan ma̱ yi a̱ tyo e irumbu.<verse eid="NAM 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 1:9" />Ili i na o foɓoi aci A̱sulazuva biti</para>
  <para style="q2" vid="NAM 1:9">u ta rawa utyo.</para>
  <para style="q2" vid="NAM 1:9">Addama a̱ da̱shi ta̱wa̱ wa̱ ire shi.<verse eid="NAM 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 1:10" />O to o'wo tsi ili i na awanda a̱ guza̱i</para>
  <para style="q2" vid="NAM 1:10">reve o'wo gashi aza a na ma̱ra̱ ma̱ tsura̱to yi,</para>
  <para style="q2" vid="NAM 1:10">a̱ ta̱ kuloto le tsa anlya o u'yewu.<verse eid="NAM 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 1:11" />A̱tsuma̱ Niniva a ɗa vuma ro uta̱i,</para>
  <para style="q2" vid="NAM 1:11">za na foɓoyi A̱sulazuva iwuya,</para>
  <para style="q1" vid="NAM 1:11">reve u ca a̱sa̱la̱ e pere.<verse eid="NAM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NAM 1:12" />Apa ili i na A̱sulazuva a dammai,</para>
  <para style="q1" vid="NAM 1:12">&lt;&lt;Ko na wo o'woi a̱ ta̱ na aza a na o ɓoloi aci na̱ a̱bunda̱,</para>
  <para style="q2" vid="NAM 1:12">o to koɗo ɗu reve a̱ tsun ɗu a̱ nge'en.</para>
  <para style="q1" vid="NAM 1:12">A̱ɗu aza a Yahuda ko na wo o'woi</para>
  <para style="q2" vid="NAM 1:12">n ca ɗu ta̱ a̱tsuma̱lima̱,</para>
  <para style="q2" vid="NAM 1:12">ma̱a̱ da̱shi yuwan ne shi.<verse eid="NAM 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 1:13" />Gogo n ta kuɗa a̱a̱gba̱la̱ e inan yi iluma i na u zuwaa nɗu a̱ yinlu,</para>
  <para style="q2" vid="NAM 1:13">reve n kakasa akani a na a̱ nla̱ ɗu na̱ yi.&gt;&gt;<verse eid="NAM 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="NAM 1:14" />A̱sulazuva a yuwan ta̱ adanshi</para>
  <para style="q2" vid="NAM 1:14">a aci a̱ wu Nineva a na,</para>
  <para style="q1" vid="NAM 1:14">&lt;&lt;Vu buwa a̱ tsura̱ muwun mu ugundo</para>
  <para style="q2" vid="NAM 1:14">n na e ɗe na aala a̱ wu shi.</para>
  <para style="q1" vid="NAM 1:14">Waru n ta̱ kototo musula̱ n na i she'ein</para>
  <para style="q2" vid="NAM 1:14">na̱ a̱ma̱li a na a̱ zuɗa̱i,</para>
  <para style="q1" vid="NAM 1:14">aza musa'a n ɗu.</para>
  <para style="q1" vid="NAM 1:14">N ta̱ foɓoo ɗu aason,</para>
  <para style="q2" vid="NAM 1:14">adama a na i ri nu urana shi.&gt;&gt;<verse eid="NAM 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 1:15" />Ka̱lyuwa̱! Zuva vu nsasan m gbagbain</para>
  <para style="q2" vid="NAM 1:15">ana aza a na a̱ ta̱wusa̱a̱ na alabari asa'ani,</para>
  <para style="q2" vid="NAM 1:15">za na a cuɗuwusa asuvu nden!</para>
  <para style="q1" vid="NAM 1:15">A̱vu Yahuda vu yuwan a̱buki a̱ wu,</para>
  <para style="q2" vid="NAM 1:15">vu shiton akucunu a̱ wu.</para>
  <para style="q1" vid="NAM 1:15">Adama a na n'yuwatan n buwa</para>
  <para style="q2" vid="NAM 1:15">a̱ ka̱nda̱ruwa̱ wu shi</para>
  <para style="q2" vid="NAM 1:15">o to kototo le suru suru.<verse eid="NAM 1:15" /></para>
  <chapter eid="NAM 1" />
  <chapter number="2" style="c" sid="NAM 2" />
  <para style="s">A̱risa̱ a̱ lyuci va Niniva</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 2:1" />Za vu ulungusu ta̱wa̱ ta̱ aci a̱ wu Niniva,</para>
  <para style="q2" vid="NAM 2:1">vu geshe ba̱ta̱ vu upa'atan</para>
  <para style="q2" vid="NAM 2:1">vi idana re</para>
  <para style="q2" vid="NAM 2:1">vi isawan nu ucira,</para>
  <para style="q2" vid="NAM 2:1">vu ɓoloto a̱za̱ e ipiri ya̱ wu suru!<verse eid="NAM 2:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="NAM 2:2" />Ko na̱ shi a damma a̱za̱ o ulungusu wu utsuru</para>
  <para style="q2" vid="NAM 2:2">a̱ shi a̱ ta̱ a̱ lungusa̱ utsuru wi iɗa i le,</para>
  <para style="q2" vid="NAM 2:2">ko shi gba a damma a̱ lungusa̱ ta̱ eten a ataci a ina̱bi i le,</para>
  <para style="q1" vid="NAM 2:2">A̱sulazuva gba ta̱ ka̱mbuwa̱a̱ Isra'ila na̱ tsugbain tsa a̱ yi suru.<verse eid="NAM 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="NAM 2:3" />A̱ra̱ga̱ ali o uvon a Niniva</para>
  <para style="q2" vid="NAM 2:3">a̱za̱ a̱ shili a ɗa,</para>
  <para style="q1" vid="NAM 2:3">a̱soja a̱ yi a̱ ta̱ wotowu</para>
  <para style="q2" vid="NAM 2:3">na̱ a̱tugu a̱ shili a̱ ma̱ɗiya̱.</para>
  <para style="q1" vid="NAM 2:3">Irumu yi ikeke yi ido i le i da̱na̱ ta̱ e ikanasa</para>
  <para style="q2" vid="NAM 2:3">urana u na o foɓo n le</para>
  <para style="q2" vid="NAM 2:3">a fabusa ibata nu ucasu u wovon.<verse eid="NAM 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 2:4" />Ikeke yi ido'o</para>
  <para style="q2" vid="NAM 2:4">a̱ da̱na̱ ta̱ e ilaɗi ujaru a̱tsuma̱ e re,</para>
  <para style="q1" vid="NAM 2:4">reve a sumusa na̱ a̱ 'ya̱wi na̱ a̱ ka̱mbi</para>
  <para style="q2" vid="NAM 2:4">a̱tsuma̱ agalaci a̱ lyuci'i.</para>
  <para style="q1" vid="NAM 2:4">A̱ ta̱ tsi fitila,</para>
  <para style="q2" vid="NAM 2:4">a̱ ka̱ra̱sa̱ tsi imaɗatsu.<verse eid="NAM 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="NAM 2:5" />Reve mogono ma Niniva mo ɓoloto ali o uvon a̱ yi,</para>
  <para style="q2" vid="NAM 2:5">a̱vu a̱ ka̱ra̱ a̱ ta̱ɗa̱tsa̱sa̱ a̱ 'ya̱wa̱,</para>
  <para style="q1" vid="NAM 2:5">a̱ jika̱ a̱ tyo o ukari u lyuci,</para>
  <para style="q2" vid="NAM 2:5">a̱ shuwa̱ ili i na a yuwaan aciyele mapari.<verse eid="NAM 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 2:6" />A̱ kpa̱tu'wa̱ ta̱ agula o ɗolu,</para>
  <para style="q2" vid="NAM 2:6">reve ukobu u mogono wo oco.<verse eid="NAM 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 2:7" />Adanshi ma̱ 'ya̱wa̱a̱ ma tsugbashi me e iɗa ya Niniva ma̱ ta̱ lo.</para>
  <para style="q2" vid="NAM 2:7">Agbashi e esheli a̱ ta̱ da̱na̱ e mesun tsa muɗa</para>
  <para style="q2" vid="NAM 2:7">no o korosoyi ekere aci.<verse eid="NAM 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 2:8" />Niniva ta̱ tsa aagula</para>
  <para style="q2" vid="NAM 2:8">a na o ɓosoi,</para>
  <para style="q1" vid="NAM 2:8">Waru a ta yisali a dansa, &lt;&lt;Isawain! Isawain!&gt;&gt;</para>
  <para style="q2" vid="NAM 2:8">Agba babu za na vadalai.<verse eid="NAM 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 2:9" />I pura̱ azurufa!</para>
  <para style="q2" vid="NAM 2:9">I pura̱ zinariya!</para>
  <para style="q1" vid="NAM 2:9">Utsuru wa̱ yi u ri na̱ utyo shi,</para>
  <para style="q2" vid="NAM 2:9">na̱ cu'un vu utsuru va̱ yi biti</para>
  <para style="q2" vid="NAM 2:9">diga uba̱ta̱ wi izuwa ya̱ yi!<verse eid="NAM 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 2:10" />Niniva la̱nga̱ ta̱,</para>
  <para style="q2" vid="NAM 2:10">waru u kuwa̱ ta̱,</para>
  <para style="q2" vid="NAM 2:10">reve wo o'wo okongo!</para>
  <para style="q1" vid="NAM 2:10">Okolo ama a̱ yi a kuɗa ta̱,</para>
  <para style="q2" vid="NAM 2:10">a̱lu e le a̱ ka̱ra̱ ta̱ e meje'en,</para>
  <para style="q2" vid="NAM 2:10">waru rewesu le rakpatsa ta̱.<verse eid="NAM 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="NAM 2:11" />Nye ɗa i shi i cinai lyuci ndolo Niniva</para>
  <para style="q2" vid="NAM 2:11">za na shi vadama a̱ba̱nu e ikamu?</para>
  <para style="q1" vid="NAM 2:11">A̱ba̱nu a na a tsu lyuwato muwun mi ikamu,</para>
  <para style="q2" vid="NAM 2:11">uba̱ta̱ u na kamu na̱ ka vu kamu tsu yuwusan alyuna,</para>
  <para style="q2" vid="NAM 2:11">oɓolo na̱ muwun mi ikamu babu wovon?<verse eid="NAM 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 2:12" />Kamu kakara ta̱ ili na̱ a̱bunda̱</para>
  <para style="q2" vid="NAM 2:12">adama a̱ muwun ma̱ yi,</para>
  <para style="q1" vid="NAM 2:12">waru wu una ta̱ fo ka vu kamu va̱ yi nama.</para>
  <para style="q2" vid="NAM 2:12">A̱vu u shiton a̱ba̱nu a̱ yi ni ili i na wu unai,</para>
  <para style="q2" vid="NAM 2:12">a̱ba̱nu a̱ yi fo ni inama'a.<verse eid="NAM 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="NAM 2:13" />Reve A̱sulazuva o oɓolo a̱ a̱soja a zuva damma,</para>
  <para style="q2" vid="NAM 2:13">&lt;&lt;A̱yi ɗa nda, n ta̱ riya̱a̱ Niniva!</para>
  <para style="q1" vid="NAM 2:13">A̱vu n kuloto ikeke yi ido ya̱ yi na akina.</para>
  <para style="q2" vid="NAM 2:13">Matsun me pe'eni ma ta lyuwa a̱ a̱soja a̱ yi.</para>
  <para style="q2" vid="NAM 2:13">Aza a na a̱ ri tsi ikamu yu ucira.</para>
  <para style="q1" vid="NAM 2:13">N ta putsa yi na woo kototo nɗa mu uvaɗi,</para>
  <para style="q2" vid="NAM 2:13">reve n putsaa nlingata ma̱ yi</para>
  <para style="q2" vid="NAM 2:13">na 'ya̱wa̱a̱ ni ikaka i wovon.&gt;&gt;<verse eid="NAM 2:13" /></para>
  <chapter eid="NAM 2" />
  <chapter number="3" style="c" sid="NAM 3" />
  <para style="s">Niniva to o'wo okongo</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 3:1" />Woo yo'ono wu shi!</para>
  <para style="q1" vid="NAM 3:1">A̱vu lyuci na ocosu mpasa,</para>
  <para style="q2" vid="NAM 3:1">zana ri tapu ne epen</para>
  <para style="q2" vid="NAM 3:1">za na ri tapu ni itana i na a̱ pura̱i,</para>
  <para style="q2" vid="NAM 3:1">u lamba itana i na a usai shi!<verse eid="NAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 3:2" />Uwwa! Mesun ma asuɗu</para>
  <para style="q2" vid="NAM 3:2">na̱ mesun ma̱ a̱ga̱nda̱mu e ikeke,</para>
  <para style="q2" vid="NAM 3:2">na̱ mesun me ilaɗi yi ido kirib kirib</para>
  <para style="q2" vid="NAM 3:2">na̱ cine ikeke'e a̱ jinga̱ɗa̱sa̱ iɗa!<verse eid="NAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 3:3" />Ka̱lyuwa̱! Aza a na a kumbusa ido</para>
  <para style="q2" vid="NAM 3:3">a̱ ta̱ a̱tsuma̱ o uvon,</para>
  <para style="q1" vid="NAM 3:3">mutsun m pe'eni n ta a madala</para>
  <para style="q2" vid="NAM 3:3">ɓolo ni ibata,</para>
  <para style="q2" vid="NAM 3:3">waru apa a̱bunda̱ ama a na o unai.</para>
  <para style="q1" vid="NAM 3:3">Apa oɓolo a̱kwa̱kwa̱,</para>
  <para style="q2" vid="NAM 3:3">a na a̱ ri n kece shi,</para>
  <para style="q2" vid="NAM 3:3">ama a̱ ka̱ra̱ ta̱ a̱ ta̱ɗa̱tsa̱sa̱</para>
  <para style="q2" vid="NAM 3:3">zuva va̱ a̱kwa̱kwa̱.<verse eid="NAM 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 3:4" />Ili i nda i fara ta̱ suru</para>
  <para style="q2" vid="NAM 3:4">adama a̱bunda̱ a tsushakala a Niniva,</para>
  <para style="q2" vid="NAM 3:4">aashakala o una̱ wu uyo'o u ndolo,</para>
  <para style="q2" vid="NAM 3:4">mma va̱ a̱za̱ nkunu,</para>
  <para style="q1" vid="NAM 3:4">za na pusa̱yin nɗa</para>
  <para style="q2" vid="NAM 3:4">a̱tsuma̱ o ure u tsu shakala tsa̱ a̱ yi,</para>
  <para style="q2" vid="NAM 3:4">ne elentsu a̱tsuma̱ o ure u tsuboci tsa̱ a̱ yi.<verse eid="NAM 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="NAM 3:5" />A̱sulazuva o oɓolo a̱ a̱soja a damma ta̱,</para>
  <para style="q2" vid="NAM 3:5">&lt;&lt;A̱yi ɗa nda, n ri tsushu'un na̱ Niniva,</para>
  <para style="q1" vid="NAM 3:5">n ta̱ 'ya̱sa̱n ma̱kuru ma̱ wu</para>
  <para style="q2" vid="NAM 3:5">n roco nɗa ataɓu a̱ wu,</para>
  <para style="q2" vid="NAM 3:5">reve vo o'wo ili i wono e ekere o tsugono tsu uvaɗi suru.<verse eid="NAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 3:6" />N ta kusha'wa wu ili yi idaba,</para>
  <para style="q2" vid="NAM 3:6">a̱vu n ca wu wono</para>
  <para style="q2" vid="NAM 3:6">mo o'woto wu ili i na o goro.<verse eid="NAM 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 3:7" />Aza a na a̱ ka̱lyuwa̱ nuwu suru</para>
  <para style="q2" vid="NAM 3:7">o to rono na̱ a̱ca̱pa̱ a damma,</para>
  <para style="q1" vid="NAM 3:7">&lt;Ili ya asalama!</para>
  <para style="q2" vid="NAM 3:7">Niniva wo o'wo ta̱ okongo,</para>
  <para style="q2" vid="NAM 3:7">zane ɗa a̱ shon</para>
  <para style="q2" vid="NAM 3:7">adama a̱ yi?</para>
  <para style="q1" vid="NAM 3:7">A te ɗa ma̱a̱ tsura̱a̱ wu</para>
  <para style="q2" vid="NAM 3:7">aza a na a ca wu adanshi?&gt; &gt;&gt;<verse eid="NAM 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="NAM 3:8" />Niniva, vu la'a ta̱ lyuci va̱ Tebe,</para>
  <para style="q2" vid="NAM 3:8">zana ri o una̱ wu Uɗolu wa̱ Nilu ɗa?</para>
  <para style="q1" vid="NAM 3:8">A̱yi fo mini ma ɗa ma̱ ka̱nda̱ruwa̱ niyi,</para>
  <para style="q2" vid="NAM 3:8">mala ma ɗa uba̱ta̱ wu upa'atan wa̱ a̱ yi,</para>
  <para style="q2" vid="NAM 3:8">mini ma ɗa ukari wa̱ yi.<verse eid="NAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 3:9" />Kush na̱ Masar ɗa ucira wa̱ yi,</para>
  <para style="q2" vid="NAM 3:9">waru ucira wa̱ yi u ri nu utyo shi.</para>
  <para style="q2" vid="NAM 3:9">Put na̱ Libiya e le ɗa aza a na o ɓoloso una̱ na̱ yi.<verse eid="NAM 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 3:10" />Nu ucira wa̱ yi suru a̱ pura̱i ta̱</para>
  <para style="q2" vid="NAM 3:10">a̱ 'ya̱wa̱ e iɗa i tsugbashi,</para>
  <para style="q2" vid="NAM 3:10">a̱ ka̱ra̱ ta̱ na̱ yi a̱ tyo e iɗa i ro.</para>
  <para style="q1" vid="NAM 3:10">O ɓuɓosuso ta̱ aci a̱ nreɓu ma̱ yi,</para>
  <para style="q2" vid="NAM 3:10">oboguzu e re suru.</para>
  <para style="q1" vid="NAM 3:10">E ne'eshen ta̱ mbara ma̱ yi</para>
  <para style="q2" vid="NAM 3:10">a̱tsuma̱ o ure u matawa ma agita,</para>
  <para style="q2" vid="NAM 3:10">a̱ nla̱ ta̱ azagbain a̱ yi na akani suru.<verse eid="NAM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 3:11" />Niniva vu to o'wo usowu tim,</para>
  <para style="q2" vid="NAM 3:11">waru vu to sowo a̱tsuma̱lima̱ lon.</para>
  <para style="q1" vid="NAM 3:11">Vu ta zami uba̱ta̱ wu upa'atan,</para>
  <para style="q2" vid="NAM 3:11">diga e ekere a n'yuwatan ma̱ wu.<verse eid="NAM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 3:12" />Ba̱ta̱ vu ɓaɓu va̱ wu ri nu ucira shi,</para>
  <para style="q2" vid="NAM 3:12">a ta lyuwa le tsu umatsun wu ubiri na e inai.</para>
  <para style="q1" vid="NAM 3:12">A mantsa ma na a̱ jinga̱ɗa̱i ɗanga'a,</para>
  <para style="q2" vid="NAM 3:12">a̱vu muwu'un a̱ riya̱</para>
  <para style="q2" vid="NAM 3:12">o una̱ wu za va alya.<verse eid="NAM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 3:13" />Ka̱lyuwa̱ a̱soja o uvon a̱ wu,</para>
  <para style="q2" vid="NAM 3:13">a̱ ta̱ tsa̱ a̱ma̱ci.</para>
  <para style="q1" vid="NAM 3:13">Na̱ntsu lyuci va̱ wu ukpa̱tu'u ɗa a̱ ri</para>
  <para style="q2" vid="NAM 3:13">e ekere a n'yuwatan ma̱ wu.</para>
  <para style="q2" vid="NAM 3:13">Akina a lyuwa ta̱ ɗanga vu ukatsusu vu na̱ntsu va̱ wu.<verse eid="NAM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 3:14" />Rono mini adama a na a̱ ta̱ ka̱nda̱ruwa̱ wu,</para>
  <para style="q2" vid="NAM 3:14">vu tsura̱ mini ma̱ a̱bunda̱</para>
  <para style="q2" vid="NAM 3:14">kafu uvo'on u teme.</para>
  <para style="q1" vid="NAM 3:14">Vu da̱shi ugbamu wu uɓaɓu wa̱ wu!</para>
  <para style="q2" vid="NAM 3:14">Vu ka̱ra̱ a̱ 'ya̱wa̱ o uɓaa</para>
  <para style="q2" vid="NAM 3:14">vu dadasa ci'in,</para>
  <para style="q2" vid="NAM 3:14">reve vu tara ili i ma̱zuɗa̱ me ikunku!<verse eid="NAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 3:15" />Ni ifoɓi i nda suru,</para>
  <para style="q2" vid="NAM 3:15">akina a ta lyuwa wu,</para>
  <para style="q1" vid="NAM 3:15">matsun me pe'eni ma̱ ta̱ kototo wu,</para>
  <para style="q2" vid="NAM 3:15">waru u ta tama wu tsa apapari.</para>
  <para style="b" vid="NAM 3:15" />
  <para style="q1" vid="NAM 3:15">Vu da̱shi ta̱ a̱bunda̱ tsa apapari,</para>
  <para style="q2" vid="NAM 3:15">reve vu da̱shi a̱bunda̱ tso oɓolo akyun!<verse eid="NAM 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NAM 3:16" />Vu da̱shi ta̱ a̱bunda̱</para>
  <para style="q2" vid="NAM 3:16">aza atsulu na wina a̱ wu</para>
  <para style="q2" vid="NAM 3:16">hali a la'a oɓolo a̱ italyo'o ya zuva.</para>
  <para style="q1" vid="NAM 3:16">A̱ ta̱ tsa akyun</para>
  <para style="q2" vid="NAM 3:16">a na a tsu yuwan ulungusu</para>
  <para style="q2" vid="NAM 3:16">reve a̱ kpa̱tu'wa̱ evelu e le a 'yawan.<verse eid="NAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="NAM 3:17" />Aza e ipiri ya̱ wu a̱ ta̱ a̱bunda̱</para>
  <para style="q2" vid="NAM 3:17">va damma akyun a na a̱ ri a̱ ma̱ka̱ra̱</para>
  <para style="q2" vid="NAM 3:17">azagbain a̱ wu a̱ ta̱ tso o oɓolo apapari,</para>
  <para style="q1" vid="NAM 3:17">nden zuva va alya</para>
  <para style="q2" vid="NAM 3:17">a mantsa mo uta̱nu.</para>
  <para style="q1" vid="NAM 3:17">Mantsa ma na urana u suɗuwai,</para>
  <para style="q2" vid="NAM 3:17">a̱vu a 'yawan,</para>
  <para style="q2" vid="NAM 3:17">waru babu za na tsu reve</para>
  <para style="q2" vid="NAM 3:17">uba̱ta̱ u na a̱ tyo yi.<verse eid="NAM 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="NAM 3:18" />&lt;&lt;A̱vu mogono ma Asuriya</para>
  <para style="q2" vid="NAM 3:18">aza a na e idanasa ama a̱ wu a̱ ta̱ nlavu,</para>
  <para style="q2" vid="NAM 3:18">mbara ma̱ wu fo n ta nlavu.</para>
  <para style="q1" vid="NAM 3:18">Akapi a ama a̱ wu a̱ ta̱ ubetu'wu</para>
  <para style="q2" vid="NAM 3:18">tsi ikyon zuva vu nsasan,</para>
  <para style="q2" vid="NAM 3:18">a̱ ri na̱ za va aguɓa a na oɓoloto le shi.<verse eid="NAM 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NAM 3:19" />Babu ili i na ya inato wuntsu a̱ wu,</para>
  <para style="q2" vid="NAM 3:19">adama a na wuntsu wa̱ wu</para>
  <para style="q2" vid="NAM 3:19">za a na a̱ tsu ta̱wa̱ nu ukwisa̱ u ɗa.</para>
  <para style="q1" vid="NAM 3:19">Zana uwwai adama a ɗa wu</para>
  <para style="q2" vid="NAM 3:19">u ta ɓasa ekere a̱ yi u damma, &lt;Ulobono ta̱!&gt;</para>
  <para style="q1" vid="NAM 3:19">Adama a na za lo</para>
  <para style="q2" vid="NAM 3:19">na kuɗa̱i o sowo a̱tsuma̱lima̱</para>
  <para style="q2" vid="NAM 3:19">diga e ekere a̱ wu shi?&gt;&gt;<verse eid="NAM 3:19" /></para>
  <chapter eid="NAM 3" />
</usx>