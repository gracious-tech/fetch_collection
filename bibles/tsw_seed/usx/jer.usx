<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JER" style="id">- Tsishingini (tsw)</book>
  <para style="h">Irimiya</para>
  <para style="toc3">Irm</para>
  <para style="toc2">Irimiya</para>
  <para style="toc1">Irimiya</para>
  <para style="mt2">Irimiya</para>
  <para style="mt1">Irimiya</para>
  <para style="is">Ucuɗuwu wa aatagada a nda</para>
  <para style="ip">Vumava̱sula̱ Irimiya yuwan ta̱ wuma u na u rawai aa'wan ukpaku kupocindere (700) kafu a matsan Yesu. A̱tsuma̱ a̱ a̱ga̱nda̱ yi, u rono ta̱ a ama a̱ A̱sula̱ atsuvu adama a̱tsuma̱lima̱ a na a̱ ri lo zuzu na wa̱a̱ riya̱a̱ nɗa ma Yahuda adama a̱ nusu le oɓolo na̱ mayan ma̱ a̱ga̱nda̱ uba̱ta̱ u musula̱. A̱tsuma̱ a wuma wa̱ Irimiya vumava̱sula̱ na u yuwain u shiwan ta̱ o una̱ wa̱ a̱risa̱ a̱ Urishelima e ekere o Mogono Nebukanaza va Babila. Na̱ ne suru a mantsa'a o kototo ta̱ lyuci'i na̱ a̱a̱'isa̱'a̱, reve a̱ pura̱ mogono ma Yahuda na a ama a̱yi a̱tyo tsugbashi a Babila. Waru Irimiya yuwan ta̱ adanshi o uka̱mbu wa ama'a diga e iɗa i tsugbashi, oɓolo nu ulapulu wu nɗa ma Yahuda.</para>
  <para style="ip">Idanshi i ro i gbagbain a̱tsuma̱ aatagada a nda o rono ta̱ ugbozu wu za na a yuwusan ɗewu nu una̱ na̱ cine ili i ɓa̱la̱ yi Irimiya, hali acina mantsa ma na A̱sulazuva na ama a̱yi a yuwain nzuwulai. A mantsa ma nda, ama A̱sula̱ a ta yuwan tsutoni na̱ nzuwulai'i ba she ni ikambishi i malu mo ro shi, adama a na a ta ɗana le a̱tsuma̱ okolo e le, ununa u ri uɗanu ana, &lt;&lt;N to o'wo A̱sula̱ e le, waru ele o to o'wo a ama a̱ va̱.&gt;&gt;</para>
  <para style="iot">Ili i na i ri pe a̱tsuma̱ a aatagada a nda</para>
  <para style="io1">Ɗewu va̱ Irimiya 1:1-19</para>
  <para style="io1">Adanshi e ikaka kuci a mantsa ma̱ mogono Yosiya na̱ mogono Jehoyakim na̱ mogono Yehoyakin, oɓolo na̱ mogono Zedekiya 2:1-25:38</para>
  <para style="io1">Ili i na i farai a̱tsuma̱ a wuma wa̱ Irimiya 26:1-45:5</para>
  <para style="io1">Adanshi e ikaka kuci a aci a nɗa 46:1-51:64</para>
  <para style="io1">A̱risa̱ a̱ Urishelima 52:1-34</para>
  <chapter number="1" style="c" sid="JER 1" />
  <para style="s">Vumava̱sula̱ Irimiya</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 1:1" />Apa idanshi ya Irimiya ulobo wa Hilikiya, za ta̱ a̱tsuma̱ a nan ganu ɗe Anatot a̱tsuma̱ e iɗa ya Banyami. <verse eid="JER 1:1" /><verse number="2" style="v" sid="JER 1:2" />Adanshi A̱sulazuva a̱ ta̱wa̱ ta̱ ya̱'a̱ yi, a̱tsuma̱ a aa'wan a kupa na aza a ta'atsu o tsugono tsa̱ Josiya ulobo wa Amon mogono ma Yahuda,<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="2CH 34:8">2 Alb 34:8</ref>; <ref loc="2CH 35:19">35:19</ref>; <ref loc="2KI 22:3">2 Ngo 22:3</ref>; <ref loc="2KI 23:27">23:27</ref>.</char></note> <verse eid="JER 1:2" /><verse number="3" style="v" sid="JER 1:3" />hali acina mantsa mo tsugono tsa̱ Jehoyakim ulobo wa̱ Josiya mogono ma Yahuda, acina woto wa tawun wa aa'wan kupa na̱ za ta̱ o tsugono tsa̱ Zedekiya ulobo wa̱ Josiya mogono ma Yahuda, a mantsa ma na a̱ pura̱i ama a̱ Urishelima a̱ tyo tsugbashi.<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="2KI 23:36">2 Ngo 23:36</ref>; <ref loc="2KI 24:7">24:7</ref>; <ref loc="2KI 18:1">18:1</ref>; <ref loc="2KI 25:21">25:21</ref>; <ref loc="2CH 36:5-8">2 Alb 36:5-8</ref>; <ref loc="2CH 11:21">11:21</ref>.</char></note><verse eid="JER 1:3" /></para>
  <para style="s">Ɗewu va Irimiya</para>
  <para style="p">
    <verse number="4" style="v" sid="JER 1:4" />Adanshi A̱sulazuva a̱ ta̱wa̱ ta̱ ya̱'a̱ va̱, adansa,<verse eid="JER 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 1:5" />&lt;&lt;Babu na a yuwain a̱'ya̱n a na a yuwan a̱a̱tsuma̱ a̱ wu,</para>
  <para style="q2" vid="JER 1:5">n reve wu ta̱,</para>
  <para style="q1" vid="JER 1:5">waru kafu a matsan wu,</para>
  <para style="q2" vid="JER 1:5">n tawa wu ta̱,</para>
  <para style="q1" vid="JER 1:5">n zuwa wu vumava̱sula̱,</para>
  <para style="q2" vid="JER 1:5">e ekere a nɗa.&gt;&gt;<verse eid="JER 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 1:6" />Reve n damma, &lt;&lt;Ee, A̱sulazuva Zagbain! N reve ili i na maa damma shi, a̱mu mawun ma ɗa.&gt;&gt;<verse eid="JER 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 1:7" />Amma a̱vu A̱sulazuva a damma mu, &lt;&lt;She vu damma, &lt;A̱mu mawun ma ɗa wan.&gt; Na̱ vu 'yuwan vu ciga vu 'ya̱wa̱ uba̱ta̱ wu za na n lyungu nuwu, waru vu damma ili i na n damma nuwu. <verse eid="JER 1:7" /><verse number="8" style="v" sid="JER 1:8" />She vu uwwa wovon ule wan, adama a na n to oɓolo na̱ a̱vu waru n wawa wu,&gt;&gt; ne ɗa A̱sulazuva a dammai.<verse eid="JER 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 1:9" />Reve A̱sulazuva a̱ ba̱ruwa̱ ukere wa̱ yi u ju'wa̱n una̱ u va̱, u damma, &lt;&lt;Ka̱lyuwa̱, gogo n zuwa ta̱ adanshi a̱ va̱ o una̱ wa̱ wu. <verse eid="JER 1:9" /><verse number="10" style="v" sid="JER 1:10" />Ka̱lyuwa̱, ana'an nda n ca wu ta̱ ucira, e ekere a nɗa na̱ tsugono, na va̱a̱ mula̱, waru vu kototo, vu varu, a̱vu voo oco, na va suwa waru vu shuwa̱.&gt;&gt;<verse eid="JER 1:10" /></para>
  <para style="s">A̱sulazuva o roco ta̱ Irimiya alavu alavu e re</para>
  <para style="p">
    <verse number="11" style="v" sid="JER 1:11" />Reve adanshi A̱sulazuva a̱ ta̱wa̱ ya̱'a̱ va̱, adansa, &lt;&lt;Nye ɗa ve enei, Irimiya?&gt;&gt;</para>
  <para style="p" vid="JER 1:11">Reve n usu, &lt;&lt;Mee ene ta̱ eten o uɗanga u alumon.&gt;&gt;<verse eid="JER 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 1:12" />Reve A̱sulazuva a damma mu, &lt;&lt;Vee ene ta̱ ulobonu, adama a na n ta̱ ka̱lyuwusa̱ adama mee ene adanshi a̱ va̱ a shiwan ta̱.&gt;&gt;<verse eid="JER 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 1:13" />Reve adanshi a̱ A̱sulazuva a̱ ta̱wisa̱ mu adansa, &lt;&lt;Nye vee enei?&gt;&gt;</para>
  <para style="p" vid="JER 1:13">Reve n usu, &lt;&lt;Mee ene ta̱ upondo a̱ ma̱puna̱ uza̱nluwu a̱ ka̱lyuwusa̱ ugana.&gt;&gt;<verse eid="JER 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JER 1:14" />Reve A̱sulazuva a damma mu,</para>
  <para style="q2" vid="JER 1:14">&lt;&lt;Diga upasu wu ugana a̱ ta̱ tsun a̱tsuma̱lima̱,</para>
  <para style="q2" vid="JER 1:14">uba̱ta̱ wa aza a na a̱ ri pe nden e iɗa'a!<verse eid="JER 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 1:15" />Ka̱lyuwa̱, n ta̱ mpolo n na moo ɓoloto a ama o tsugono</para>
  <para style="q2" vid="JER 1:15">tsu upasu wu ugana suru,</para>
  <para style="qr" vid="JER 1:15">ne ɗa A̱sulazuva a dammai.</para>
  <para style="q1" vid="JER 1:15">Ngono n le n ta̱ ta̱wa̱ a zuwa ootogu o tsugono tse le</para>
  <para style="q2" vid="JER 1:15">o una̱ntsu wa̱ Urishelima,</para>
  <para style="q1" vid="JER 1:15">a̱ ta̱ ta̱wa̱ a̱ ka̱nda̱ruwa̱ kari va̱ yi suru,</para>
  <para style="q2" vid="JER 1:15">a̱ ka̱nda̱ruwa̱ ilyuci ya Yahuda suru.<verse eid="JER 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 1:16" />Waru n ta damma uge'etosu u va̱ a aci a ama a̱ va̱,</para>
  <para style="q2" vid="JER 1:16">adama e iwuya i le suru</para>
  <para style="q2" vid="JER 1:16">na a 'yuwan numu,</para>
  <para style="q1" vid="JER 1:16">o ukula̱tosu wa̱ a̱tsuka̱ a̱ ma̱guru a̱ tyo a̱ musula̱ n ro,</para>
  <para style="q2" vid="JER 1:16">na̱ mayan ma̱ a̱ga̱nda̱ e ekere e ili i na ekere e le a yuwain.&gt;&gt;<verse eid="JER 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 1:17" />Amma a̱vu, Irimiya vu nla̱ gbakala va̱ wu! Vu 'yon vu damma le suru ili i na n damma nuwu. She vu da'wan adama ele wan, adama she mu da'waton wu a̱ ma̱ka̱ka̱n me le wan. <verse eid="JER 1:17" /><verse number="18" style="v" sid="JER 1:18" />Ana'an nda n ka̱mbuwa̱ wu ta̱ lyuci vu ukari wu ucira, tsa atsura a̱ rumu, nu ukari wu rumushili, adama vi isawan nla̱ngi a aci e iɗa'a suru, na̱ waru u yuwan nla̱ngi na̱ ngono ma Yahuda na̱ azagbain a̱ yi, na̱ nan ganu na ama a̱ yi. <verse eid="JER 1:18" /><verse number="19" style="v" sid="JER 1:19" />A ta yuwan nla̱ngi na̱ a̱vu, amma a lyuwa a aci a̱ wu shi, adama a na n to oɓolo na̱ a̱vu, waru n wawa wu, ne ɗa A̱sulazuva a dammai.<verse eid="JER 1:19" /></para>
  <chapter eid="JER 1" />
  <chapter number="2" style="c" sid="JER 2" />
  <para style="s">Isra'ila icina ta̱ na̱ A̱sula̱</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 2:1" />Adanshi A̱sulazuva a̱ ta̱wa̱ ta̱ ya̱'a̱ va̱, adansa, <verse eid="JER 2:1" /><verse number="2" style="v" sid="JER 2:2" />&lt;&lt;'Ya̱wa̱ vu damma a atsuvu ama a̱ Urishelima, apa ili i na A̱sulazuva a dammai,</para>
  <para style="q1" vid="JER 2:2">&lt;&lt; &lt;N cuwan ta̱ na̱ a̱ɓula̱ a̱ wu</para>
  <para style="q2" vid="JER 2:2">a na vu da̱na̱i a̱ tsusheli,</para>
  <para style="q2" vid="JER 2:2">icigi ya̱ wu tsu ka sa'avu na cigai vali va̱ yi,</para>
  <para style="q1" vid="JER 2:2">reve vu toni mu a̱ a̱tsumona,</para>
  <para style="q2" vid="JER 2:2">e iɗa i na a tsu yuwan ca̱'a̱n shi.<verse eid="JER 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 2:3" />Isra'ila da̱na̱ ta̱ na a akiza e ekere a̱ A̱sulazuva,</para>
  <para style="q2" vid="JER 2:3">tsu umatsun wu ufaru wu ugasa,</para>
  <para style="q1" vid="JER 2:3">aza a na a lyuwa niyi suru a̱ ta̱ reme le nu unusu,</para>
  <para style="q2" vid="JER 2:3">waru meleshe ma ta cina le,</para>
  <para style="qr" vid="JER 2:3">ne ɗa A̱sulazuva a dammai.&gt; &gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="EXO 23:19">Mta̱ 23:19</ref>.</char></note><verse eid="JER 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 2:4" />Uwai adanshi a̱ A̱sulazuva,</para>
  <para style="q2" vid="JER 2:4">&lt;&lt;a̱ɗu u'wa wa Yakubu,</para>
  <para style="q2" vid="JER 2:4">a̱ɗu ugundo wa Isra'ila suru.&gt;&gt;<verse eid="JER 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 2:5" />Apa nda ili i na A̱sulazuva a dammai,</para>
  <para style="q1" vid="JER 2:5">&lt;&lt;Unusu u ne ɗa nkaya nɗu n tsura̱a̱ numu na̱ yi?</para>
  <para style="q2" vid="JER 2:5">Hali na a yuwain alanga na̱ mu?</para>
  <para style="q2" vid="JER 2:5">A̱ kuru ta̱ a̱ma̱li e pere,</para>
  <para style="q2" vid="JER 2:5">reve gba o'wo ili ye pere?<verse eid="JER 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 2:6" />Agba a yuwan yeci,</para>
  <para style="q2" vid="JER 2:6">&lt;A̱ te ɗa A̱sulazuva,</para>
  <para style="q2" vid="JER 2:6">a na o uta̱a̱ ntsu diga e iɗa ya Masar,</para>
  <para style="q1" vid="JER 2:6">a̱vu u rono tsu aaɗanga a̱tsumona,</para>
  <para style="q2" vid="JER 2:6">a̱tsuma̱ e iɗa ya̱ a̱tsumona na̱ a̱ka̱ri,</para>
  <para style="q1" vid="JER 2:6">e iɗa yu u'yewu ni irumbu pici,</para>
  <para style="q2" vid="JER 2:6">iɗa i na za tsu kuru shi</para>
  <para style="q2" vid="JER 2:6">waru uba̱ta̱ u na za tsu da̱nu shi?&gt;<verse eid="JER 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 2:7" />N ta̱wa̱to ɗu ta̱ e iɗa yu umili,</para>
  <para style="q2" vid="JER 2:7">adama i lyuwa limatan va̱ yi,</para>
  <para style="q2" vid="JER 2:7">ni ili i mawwa mo uyo'o u na waa casu biti.</para>
  <para style="q1" vid="JER 2:7">Amma a̱vu i ta̱wa̱ i ka̱mbuwa̱ iɗa'a idaba,</para>
  <para style="q2" vid="JER 2:7">a̱vu waru i ka̱mbuwa̱ agadu a̱ va̱ ili yi idaba.<verse eid="JER 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 2:8" />Nan ganu a yuwan yeci,</para>
  <para style="q2" vid="JER 2:8">&lt;A̱ te ɗa A̱sulazuva shi?&gt;</para>
  <para style="q1" vid="JER 2:8">Aza a na o ritosu wila̱ e reve mu shi.</para>
  <para style="q2" vid="JER 2:8">Azagbain a̱ 'ya̱sa̱n mu ta̱ a aci.</para>
  <para style="q1" vid="JER 2:8">Ama̱sula̱ a yuwan ta̱ adanshi e ikaka na ala a Ba'al,</para>
  <para style="q2" vid="JER 2:8">o tono a̱ma̱li a na a̱ ri na̱ a̱ɓula̱ shi.<verse eid="JER 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="JER 2:9" />&lt;&lt;Adama o ndolo a̱mu a̱ A̱sulazuva,</para>
  <para style="q2" vid="JER 2:9">n ta̱wisa̱ ta̱ na adanshi aciya̱ɗu,&gt;&gt;</para>
  <para style="qr" vid="JER 2:9">ne ɗa A̱sulazuva a dammai.</para>
  <para style="q1" vid="JER 2:9">Waru n ta̱wa̱a̱ na adanshi a aci a̱ muwun</para>
  <para style="q2" vid="JER 2:9">muwun ntsukaya nɗu.<verse eid="JER 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 2:10" />&lt;&lt;Pasai mala a̱ tyo a̱ nge'en ma Kitim yee ene,</para>
  <para style="q1" vid="JER 2:10">i lyungu a̱ tyo Keda i ka̱lyuwa̱ ulobonu,</para>
  <para style="q2" vid="JER 2:10">yee ene ko a yuwan ta̱ ɗe ili i ro tsunda?<verse eid="JER 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 2:11" />Iɗa i ro i ta̱ lo a na,</para>
  <para style="q2" vid="JER 2:11">u vadalai musula̱ ma̱ yi?</para>
  <para style="q2" vid="JER 2:11">ko na wo o'woi e le musula̱ n ɗa shi,</para>
  <para style="q1" vid="JER 2:11">amma ama a̱ va̱ a kita'wan mu ta̱</para>
  <para style="q2" vid="JER 2:11">a̱mu na ma̱a̱ 'ya̱susa̱n le,</para>
  <para style="q2" vid="JER 2:11">na̱ a̱ma̱li a na a̱ ri na̱ a̱ɓula̱ shi.<verse eid="JER 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 2:12" />A̱ɗu zuva, jinga̱ɗa̱i adama o ndolo,</para>
  <para style="q2" vid="JER 2:12">waru yi da'wan adama a̱ba̱jini o wovon,</para>
  <para style="qr" vid="JER 2:12">ne ɗa A̱sulazuva a dammai.<verse eid="JER 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 2:13" />Ama a̱ va̱ a yuwan ta̱ nusu re,</para>
  <para style="q2" vid="JER 2:13">a vari mu ta̱,</para>
  <para style="q2" vid="JER 2:13">a̱mu lyusu mini ma na maa casu wuma.</para>
  <para style="q1" vid="JER 2:13">Reve ee she'en aciya̱le a̱ka̱ri a na a̱ da̱nu mini,</para>
  <para style="q2" vid="JER 2:13">aza a na a̱ ri wukaru,</para>
  <para style="q2" vid="JER 2:13">na tsu gura da̱nu mini shi.<verse eid="JER 2:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JER 2:14" />&lt;&lt;A̱vu Isra'ila, a̱vu aagbashi o usheli a ɗa?</para>
  <para style="q2" vid="JER 2:14">A matsain ta̱ a tsugbashi?</para>
  <para style="q1" vid="JER 2:14">To, nye i zuwai wo o'woi ili i ma̱pura̱</para>
  <para style="q2" vid="JER 2:14">e ekere a n'yuwatan nɗu?<verse eid="JER 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 2:15" />Ikamu i gugwa̱ ta̱</para>
  <para style="q2" vid="JER 2:15">a̱ gugwa̱ ta̱ aci a̱ yi.</para>
  <para style="q1" vid="JER 2:15">A̱ lungusa̱ ta̱ iɗa ya̱ yi,</para>
  <para style="q2" vid="JER 2:15">a̱ lungusa̱ ta̱ ilyuci ya̱ yi,</para>
  <para style="q2" vid="JER 2:15">babu za na ri pe na̱ nden.<verse eid="JER 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 2:16" />Waru ama a Memfis na aza a Takifanke,</para>
  <para style="q2" vid="JER 2:16">a puna ta̱ aaci a̱ wu.<verse eid="JER 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 2:17" />Ashe a̱vu ɗa vu ronoo yi aciya̱wu ili i nda shi,</para>
  <para style="q2" vid="JER 2:17">a na vu lyawai A̱sulazuva A̱sula̱ a̱ wu</para>
  <para style="q1" vid="JER 2:17">a mantsa ma na u ronoo nuwu</para>
  <para style="q2" vid="JER 2:17">aaɗanga a̱tsuma̱ o ure shi?<verse eid="JER 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 2:18" />To, nye i zuwai va̱a̱ 'ya̱wa̱ Masar,</para>
  <para style="q2" vid="JER 2:18">adama vu sowo mini mo uɗolu wa̱ Nilu?</para>
  <para style="q1" vid="JER 2:18">Waru nye i zuwai va̱a̱ 'ya̱wa̱ Asuriya</para>
  <para style="q2" vid="JER 2:18">adama vu sowo mini mo uɗolu wa̱ Yufireti?<verse eid="JER 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 2:19" />Iwuya ya̱ wu i ta ca wu a̱tsuma̱lima̱,</para>
  <para style="q2" vid="JER 2:19">uvadalu wu ucina̱ wa̱ wu</para>
  <para style="q2" vid="JER 2:19">u ta ca wu oforo.</para>
  <para style="q1" vid="JER 2:19">A̱vu vi idana waru vu reve,</para>
  <para style="q2" vid="JER 2:19">cine za vi iwuya no okono a̱ ri e ekere a̱ wu</para>
  <para style="q1" vid="JER 2:19">a mantsa ma na vu lyawai A̱sulazuva A̱sula̱ a̱ wu</para>
  <para style="q2" vid="JER 2:19">waru va uwwusa wovon u va̱ shi,</para>
  <para style="qr" vid="JER 2:19">ne ɗa A̱sulazuva o oɓolo a̱ a̱soja a zuva a dammai.&gt;&gt;<verse eid="JER 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JER 2:20" />&lt;&lt;A̱vu usheli Isra'ila, ɗe nu ujimu,</para>
  <para style="q2" vid="JER 2:20">vu kuɗa ta̱ a̱gba̱la̱ a na a tsugba nuwu,</para>
  <para style="q2" vid="JER 2:20">a̱vu vu taɓa akani a̱ wu.</para>
  <para style="q1" vid="JER 2:20">Na̱ ne suru, vu damma ta̱,</para>
  <para style="q2" vid="JER 2:20">&lt;Maa yuwaan wu a̱ga̱nda̱ shi.&gt;</para>
  <para style="q1" vid="JER 2:20">Amayun, ba̱ta̱ va̱ a̱ga̱nda̱,</para>
  <para style="q2" vid="JER 2:20">na̱ za̱la̱ vu uɗanga kpa̱la̱m suru,</para>
  <para style="q2" vid="JER 2:20">vu ka̱ɗa̱to ta̱ aciya̱wu a yuwusan tsushakala.<verse eid="JER 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 2:21" />N shuwa̱ wu ta̱,</para>
  <para style="q2" vid="JER 2:21">tsa ataci a̱ ina̱bi a na n ɗangulai,</para>
  <para style="q2" vid="JER 2:21">icu'un i sa'ani za na aa zuwaa ucira.</para>
  <para style="q1" vid="JER 2:21">Nye i zuwai vu vadalai a̱ tsushu'un na̱ mu,</para>
  <para style="q2" vid="JER 2:21">vu la̱nga̱ ta̱,</para>
  <para style="q1" vid="JER 2:21">vo o'wo ta̱ tse eten ataci</para>
  <para style="q2" vid="JER 2:21">o una a babu a̱ɓula̱?<verse eid="JER 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 2:22" />Ko na wo o'woi vu za̱'wa̱ ta̱ aciya̱wu na̱ a̱zuma̱'a̱</para>
  <para style="q2" vid="JER 2:22">vu yuwan ta̱ ulinga na̱ a̱zuma̱'a̱ lon,</para>
  <para style="q1" vid="JER 2:22">na̱ ne suru, hali n gogo</para>
  <para style="q2" vid="JER 2:22">alana o unusu wa̱ wu</para>
  <para style="q2" vid="JER 2:22">a̱ ta̱ lo elime a̱ va̱,</para>
  <para style="qr" vid="JER 2:22">ne ɗa A̱sulazuva Zagbain dammai.<verse eid="JER 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 2:23" />Cine tsu ɗa va damma, &lt;N lungusa̱ aciya̱va̱ shi?</para>
  <para style="q2" vid="JER 2:23">N kuru Ba'al shi?&gt;</para>
  <para style="q1" vid="JER 2:23">Ka̱lyuwa̱ cine vu yuwain a̱tsuma̱ o uka̱ri,</para>
  <para style="q2" vid="JER 2:23">vee ene ili i na vu yuwain.</para>
  <para style="q1" vid="JER 2:23">Vu te e ilaɗi tsa̱ a̱na̱wu a arakumi,</para>
  <para style="q2" vid="JER 2:23">a̱ 'ya̱wusa̱ na̱ vu ka̱mbi,<verse eid="JER 2:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 2:24" />tsa̱ a̱na̱wu o mololi mo una,</para>
  <para style="q2" vid="JER 2:24">na cigai nden mo a̱tsumona,</para>
  <para style="q1" vid="JER 2:24">a̱ 'yuwusan upepu</para>
  <para style="q2" vid="JER 2:24">a mantsa ma na u cigai tsukoɓi,</para>
  <para style="q2" vid="JER 2:24">zane ɗa a gura putsayi?</para>
  <para style="q1" vid="JER 2:24">Ogono a na a zama yi,</para>
  <para style="q2" vid="JER 2:24">wuntsa u foro aciya̱yi shi,</para>
  <para style="q1" vid="JER 2:24">adama a na o woto</para>
  <para style="q2" vid="JER 2:24">u tsukumbi tsa̱ yi a̱ ta̱ tsura̱i.<verse eid="JER 2:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 2:25" />A̱vu Isra'ila, she vu suma</para>
  <para style="q2" vid="JER 2:25">hali na atan a̱ wu a taɓa wan,</para>
  <para style="q1" vid="JER 2:25">hali na vaa lyawa fo</para>
  <para style="q2" vid="JER 2:25">a̱la̱kutsu a̱ wu e 'yewe,</para>
  <para style="q2" vid="JER 2:25">adama e itoni i musula̱ n ro wan.</para>
  <para style="q1" vid="JER 2:25">Amma a̱vu vu damma,</para>
  <para style="q2" vid="JER 2:25">&lt;U ri nu urana shi!</para>
  <para style="q1" vid="JER 2:25">N ciga ta̱ omocin a̱ musula̱,</para>
  <para style="q2" vid="JER 2:25">waru ele ɗa ma̱ kuru!&gt; &gt;&gt;<verse eid="JER 2:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="JER 2:26" />&lt;&lt;Cine vivu tsu uwwa wono,</para>
  <para style="q2" vid="JER 2:26">a mantsa ma na e reme niyi,</para>
  <para style="q1" vid="JER 2:26">ne ɗa u'wa wa Isra'ila wa uwwa wono,</para>
  <para style="q2" vid="JER 2:26">ele, na̱ ngono nle na̱ azagbain e le,</para>
  <para style="q2" vid="JER 2:26">na̱ nan ganu e le, oɓolo na a ama̱sula̱ e le.<verse eid="JER 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 2:27" />Agba i ta dansaa uɗanga, &lt;A̱vu ɗa dada va̱,&gt;</para>
  <para style="q2" vid="JER 2:27">Aatali waru, &lt;A̱vu ɗa vu matsan numu.&gt;</para>
  <para style="q1" vid="JER 2:27">A vadalaa mu ta̱ ucina̱ u le,</para>
  <para style="q2" vid="JER 2:27">o una̱ wu urewesu u le.</para>
  <para style="q1" vid="JER 2:27">Na̱ ne suru a mantsa ma na a̱ ri pe</para>
  <para style="q2" vid="JER 2:27">a̱tsuma̱ a̱tsuma̱lima̱,</para>
  <para style="q1" vid="JER 2:27">a tsu damma ta̱,</para>
  <para style="q2" vid="JER 2:27">&lt;Ta̱wa̱ vu wawa tsu!&gt;<verse eid="JER 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 2:28" />To, gogo a te ɗa musula̱</para>
  <para style="q2" vid="JER 2:28">n na i yuwayin aciya̱ɗu?</para>
  <para style="q1" vid="JER 2:28">Lyawa a̱ ta̱wa̱ nna a gura wawa ɗu,</para>
  <para style="q2" vid="JER 2:28">a mantsa ma na i ri a̱tsuma̱lima̱!</para>
  <para style="q1" vid="JER 2:28">Adama a na i ri na̱ musula̱ ma̱ a̱bunda̱,</para>
  <para style="q2" vid="JER 2:28">ununa i ri ni ilyuci,</para>
  <para style="q2" vid="JER 2:28">a̱ɗu a ama a Yahuda.&gt;&gt;<verse eid="JER 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 2:29" />&lt;&lt;Nye i zuwai i ta̱wa̱i,</para>
  <para style="q2" vid="JER 2:29">na adanshi a aci a̱ va̱?</para>
  <para style="q1" vid="JER 2:29">Suru nɗu ɗa i yuwaan numu aciyogbamu,</para>
  <para style="qr" vid="JER 2:29">ne ɗa A̱sulazuva a dammai.<verse eid="JER 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 2:30" />Ulinga we pere u ɗa</para>
  <para style="q2" vid="JER 2:30">a na n cayi ama a̱ ɗu oforo,</para>
  <para style="q2" vid="JER 2:30">a tara ulapulu shi.</para>
  <para style="q1" vid="JER 2:30">Matsun me pe'eni ma̱ ɗu</para>
  <para style="q2" vid="JER 2:30">ma lyuwa ta̱ ama̱sula̱ a̱ ɗu,</para>
  <para style="q2" vid="JER 2:30">tsa kamu na a uwwusa ambulu.<verse eid="JER 2:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 2:31" />A̱ɗu ama a mantsa ma nda,</para>
  <para style="q2" vid="JER 2:31">uwwai ili i na A̱sulazuva a dammai.</para>
  <para style="q1" vid="JER 2:31">Mo o'wo ta̱ Isra'ila tsa̱ a̱tsumona ɗa?</para>
  <para style="q2" vid="JER 2:31">Ko tsi iɗa ya̱ a̱bunda̱ e irumbu pici?</para>
  <para style="q1" vid="JER 2:31">Nye i zuwai ama a̱ va̱ a dansa,</para>
  <para style="q2" vid="JER 2:31">&lt;Tsu ta̱ nu ucira u na tsa̱ da̱na̱ a agara,</para>
  <para style="q2" vid="JER 2:31">tsa̱a̱ da̱shi 'ya̱wa̱ uba̱ta̱ wa̱ wu shi&gt;?<verse eid="JER 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 2:32" />Usheli u te icina ni itana i wukalu ya̱ yi,</para>
  <para style="q2" vid="JER 2:32">ko ka sa'avu e icina ni itana i yisukumishi ya̱ yi?</para>
  <para style="q1" vid="JER 2:32">Na̱ ne suru ama a̱ va̱ e icina ta̱ na̱ mu,</para>
  <para style="q2" vid="JER 2:32">rana na̱ a̱bunda̱.&gt;&gt;<verse eid="JER 2:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="JER 2:33" />&lt;&lt;Vu ta̱ nu ugbozu lon</para>
  <para style="q2" vid="JER 2:33">uba̱ta̱ wi izami i macigata!</para>
  <para style="q1" vid="JER 2:33">Hali na a̱ma̱ci a na a la'ai iwuya,</para>
  <para style="q2" vid="JER 2:33">o rito a̱tsuma̱ a̱ re va̱ wu.<verse eid="JER 2:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 2:34" />A̱ a̱tugu a̱ wu ama a tsu cina ta̱,</para>
  <para style="q2" vid="JER 2:34">mpasa mo ozo o ulambu,</para>
  <para style="q2" vid="JER 2:34">aza a na a̱ ri babu unusu,</para>
  <para style="q1" vid="JER 2:34">ko na wo o'woi vu reme le</para>
  <para style="q2" vid="JER 2:34">a na o ɓosoi a uwa shi,</para>
  <para style="q2" vid="JER 2:34">suru na̱ ne,<verse eid="JER 2:34" /></para>
  <para style="q2">
    <verse number="35" style="v" sid="JER 2:35" />vu damma ta̱, &lt;N ri nu unusu shi,</para>
  <para style="q2" vid="JER 2:35">agba u ri o upan na̱ mu shi.&gt;</para>
  <para style="q1" vid="JER 2:35">Amma n ta̱ ta̱wa̱ nu uge'etosu a aci a̱ wu,</para>
  <para style="q2" vid="JER 2:35">adama a na vu dammai,</para>
  <para style="q2" vid="JER 2:35">&lt;N yuwan unusu shi.&gt;<verse eid="JER 2:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 2:36" />Adama a̱ nye vu ri e igaru tsunda,</para>
  <para style="q2" vid="JER 2:36">a vadalasa re va̱ wu?</para>
  <para style="q1" vid="JER 2:36">Masar ta ca wu wono</para>
  <para style="q2" vid="JER 2:36">ununa vu sowoi wono e ekere aza a Asuriya.<verse eid="JER 2:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 2:37" />Agba vu ta lyawa uba̱ta̱'a̱</para>
  <para style="q2" vid="JER 2:37">ne e ekere a̱ wu aaci ukoru,</para>
  <para style="q1" vid="JER 2:37">adama a na A̱sulazuva a 'yuwan ta̱,</para>
  <para style="q2" vid="JER 2:37">aza a na vu zuwayi ucira,</para>
  <para style="q2" vid="JER 2:37">agba va̱a̱ tsura̱ ikambishi diga ya̱'a̱ le shi.&gt;&gt;<verse eid="JER 2:37" /></para>
  <para style="b" />
  <chapter eid="JER 2" />
  <chapter number="3" style="c" sid="JER 3" />
  <para style="q1">
    <verse number="1" style="v" sid="JER 3:1" />A̱sula̱ a damma ta̱,</para>
  <para style="q2" vid="JER 3:1">&lt;&lt;Na̱ vuma kakasa na̱ ka va̱ yi,</para>
  <para style="q2" vid="JER 3:1">reve u ka̱ra̱ wo olo vuma ro,</para>
  <para style="q1" vid="JER 3:1">vuma'a u ta̱ gura</para>
  <para style="q2" vid="JER 3:1">ka̱mbuwisa̱ yi ɗa?<note caller="-" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">U.Wl 24:1-4</ref>.</char></note></para>
  <para style="q2" vid="JER 3:1">Ashe iɗa'a ya̱a̱ la̱nga̱ suru suru shi?</para>
  <para style="q1" vid="JER 3:1">Amma i yuwan ta̱ wuma tsa ashakala a na a̱ ri</para>
  <para style="q2" vid="JER 3:1">na̱ a̱za̱ e icigi a̱bunda̱ lon,</para>
  <para style="q2" vid="JER 3:1">gogo gba a̱vu vu ka̱mba̱ ya̱'a̱ va̱?</para>
  <para style="qr" vid="JER 3:1">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 3:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="JER 3:2" />&lt;&lt;'Ya̱sa̱n esu a̱ wu zuva</para>
  <para style="q2" vid="JER 3:2">vu ka̱lyuwa̱ agaɗi vee ene!</para>
  <para style="q1" vid="JER 3:2">Uba̱ta̱ u ro u tu lo</para>
  <para style="q2" vid="JER 3:2">a na a̱ kuɗa̱i o voyin na̱ a̱vu?</para>
  <para style="q1" vid="JER 3:2">Vu da̱nu ta̱ a̱ nge'en mu ure</para>
  <para style="q2" vid="JER 3:2">a pura macigata ma̱ wu,</para>
  <para style="q2" vid="JER 3:2">vu da̱nu ta̱ she damma za va aguɓa a̱ a̱tsumona.</para>
  <para style="q1" vid="JER 3:2">Vu lungusa̱ ta̱ iɗa'a,</para>
  <para style="q2" vid="JER 3:2">na̱ tsushakala tsa̱ wu ni iwuya ya̱ wu.<verse eid="JER 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 3:3" />Adama o ndolo ɗa a̱ kuɗa̱i o ro'o mini,</para>
  <para style="q2" vid="JER 3:3">waru lyushi da̱nu shi.</para>
  <para style="q1" vid="JER 3:3">Na̱ ne suru, vu ta̱ ni iroci ya aashakala,</para>
  <para style="q2" vid="JER 3:3">reve vu kuɗa̱ a uwwa wono.<verse eid="JER 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 3:4" />Ashe gogo ɗa vu ɗe numu,</para>
  <para style="q2" vid="JER 3:4">&lt;Dada va̱, ni i utsa̱ i va̱</para>
  <para style="q2" vid="JER 3:4">diga a̱mu a̱ tsulolobo,<verse eid="JER 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 3:5" />vu ta̱ da̱na̱ o upan kuci ɗa?</para>
  <para style="q2" vid="JER 3:5">Upan wa̱ wu u ta lyuwa elime hali hali?&gt;</para>
  <para style="q1" vid="JER 3:5">Ne ɗa vu tsu yuwusan adanshi,</para>
  <para style="q2" vid="JER 3:5">amma vu tsu yuwusan ta̱</para>
  <para style="q2" vid="JER 3:5">iwuya i na vu cigai suru.&gt;&gt;<verse eid="JER 3:5" /></para>
  <para style="s">Isra'ila vu ulambu wa̱ a̱ɓula̱</para>
  <para style="p">
    <verse number="6" style="v" sid="JER 3:6" />A mantsa mo tsugono tso Mogono Josaya, A̱sulazuva a yuwan ta̱ adanshi na̱ mu u damma, &lt;&lt;Vee ene ta̱ ili i na za vu ulambu wa̱ a̱ɓula̱ a nda, Isra'ila vu upasu wu ugana yuwain? U lapa ta̱ agawan aagaɗi o uga'an biti na̱ za̱la̱ vu ɗanga kpa̱la̱m suru adama u yuwan tsushakala ɗe.<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="2KI 22:1">2 Ngo 22:1</ref>; <ref loc="2KI 23:30">23:30</ref>; <ref loc="2CH 34:1">2 Alb 34:1</ref>; <ref loc="2CH 35:27">35:27</ref>.</char></note> <verse eid="JER 3:6" /><verse number="7" style="v" sid="JER 3:7" />N yuwan ta̱ majiyan ma na nu u koto ili i nda suru, u ta̱ ka̱mba̱ uba̱ta̱ u va̱, agba u yuwan ne shi, waru Yahuda na ri upasu wu uyagi mawun ma̱ a̱na̱wun ma̱ yi mo o ulambu wa̱ a̱ɓula̱ mee ene ta̱. <verse eid="JER 3:7" /><verse number="8" style="v" sid="JER 3:8" />N ca ta̱ Isra'ila za vu ulambu wa̱ a̱ɓula̱ a nda a aatagada a wukasu, a̱vu n lyawai u ka̱ra̱ adama a tsushakala tsa̱ yi suru. Na̱ ne suru mee ene ta̱ mawun ma̱ a̱na̱wun ma̱ yi Yahuda vu ulambu wa̱ a̱ɓula̱ uwwa wovon shi, reve fo u ka̱ra̱ o uta̱ u yuwan tsushakala. <verse eid="JER 3:8" /><verse number="9" style="v" sid="JER 3:9" />Adama a na tsushakala tsa Isra'ila tsa rawai shi, reve wo o'woto iɗa'a idaba a̱vu u yuwan tsushakala na atali oɓolo na̱ ɗanga. <verse eid="JER 3:9" /><verse number="10" style="v" sid="JER 3:10" />Na̱ ne suru, mawun ma̱ a̱na̱wun ma̱ yi Yahuda za vu ulambu wa̱ a̱ɓula̱ o ndolo, u ka̱mba̱ ya̱'a̱ va̱ no okolo a̱ ta̱ shi, amma she a̱tsuma̱ o ulambu wa amayun, ne ɗa A̱sulazuva a dammai.&gt;&gt;<verse eid="JER 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 3:11" />A̱vu A̱sulazuva a damma mu, &lt;&lt;Isra'ila vu ulambu wa̱ a̱ɓula̱, u ta̱ na̱ a̱ɓula̱ a na a la'ai ulambu wa̱ a̱ɓula̱ a Yahuda. <verse eid="JER 3:11" /><verse number="12" style="v" sid="JER 3:12" />'Ya̱wa̱, vu damma adanshi a nda upasu wu ugana, vu damma,</para>
  <para style="b" vid="JER 3:12" />
  <para style="q1" vid="JER 3:12">&lt;&lt;Vu ka̱mba̱, a̱vu Isra'ila vu ulambu wa̱ a̱ɓula̱,</para>
  <para style="qr" vid="JER 3:12">ne ɗa A̱sulazuva a dammai,</para>
  <para style="q1" vid="JER 3:12">ma̱a̱ da̱shi yuwan upan na̱ a̱vu shi,</para>
  <para style="q2" vid="JER 3:12">adama a na a̱mu za vi iliyali ɗa,</para>
  <para style="q1" vid="JER 3:12">maa yuwan upan na̱ a̱vu hali hali shi,</para>
  <para style="qr" vid="JER 3:12">ne ɗa A̱sulazuva a dammai.<verse eid="JER 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 3:13" />A̱vu de vu usu unusu wa̱ wu,</para>
  <para style="q2" vid="JER 3:13">vu 'ya̱sa̱a̱n ta̱ A̱sulazuva A̱sula̱ a̱ wu aci,</para>
  <para style="q1" vid="JER 3:13">voo oco ta̱ a̱ɓula̱ a̱ wu uba̱ta̱ u musula̱ n ro,</para>
  <para style="q2" vid="JER 3:13">za̱la̱ vu uɗanga kpa̱la̱m suru.</para>
  <para style="q1" vid="JER 3:13">Agba vu yuwaan mu tsutoni shi,</para>
  <para style="qr" vid="JER 3:13">ne ɗa A̱sulazuva a dammai.<verse eid="JER 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 3:14" />Reve A̱sulazuva a damma,</para>
  <para style="q2" vid="JER 3:14">i vadala a̱ɗu ama o ulambu wa̱ a̱ɓula̱,</para>
  <para style="q2" vid="JER 3:14">adama a na a̱mu ɗa vali ɗu.</para>
  <para style="q1" vid="JER 3:14">N ta tara ɗu a̱za̱ ta̱ ta̱</para>
  <para style="q2" vid="JER 3:14">diga a̱tsuma̱ e ilyuci i ɗu</para>
  <para style="q2" vid="JER 3:14">ne ejere re diga a̱tsuma̱ o gundo ɗu</para>
  <para style="q2" vid="JER 3:14">reve n ta̱wa̱to ɗu Sihiyona.&gt;&gt;<verse eid="JER 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 3:15" />&lt;&lt;Reve n ca ɗu aza aguɓa a na aa yuwusan ili i na okolo a̱ va̱ a cigai, aza a na o ronoo ɗu aaɗanga nu ugbozu nu urevu. <verse eid="JER 3:15" /><verse number="16" style="v" sid="JER 3:16" />A rana ndolo na i da̱shiyi a̱bunda̱ a̱tsuma̱ e iɗa'a, ne ɗa A̱sulazuva a dammai, ama a̱ da̱shi yuwisan adanshi adama Akpati a nzuwulai a̱ A̱sula̱ shi.&gt;&gt; Wa̱a̱ da̱shi uwisa okolo e le, ko a̱ da̱shi cuwan na̱ yi shi, wa̱a̱ puwa̱a̱n shi, ko a̱ da̱shi yuwisan cu'un va̱ yi shi. <verse eid="JER 3:16" /><verse number="17" style="v" sid="JER 3:17" />&lt;&lt;A mantsa ma ɗaɗa e ɗe Urishelima Ootogu o Tsugono a̱ A̱sulazuva. Waru nɗa suru n to ɓoloto a̱tsuma̱ a̱ Urishelima a ca Ala a̱ A̱sulazuva tsugbain. A̱a̱ da̱shi kuru aciyogbamu o okolo e le shi. <verse eid="JER 3:17" /><verse number="18" style="v" sid="JER 3:18" />A rana ndolo u'wa wa Yahuda u to ɓolo ukere nu u'wa wa Isra'ila, waru oɓolo a ɗa a̱ ka̱mba̱ diga e iɗa yu ugana a̱ tyo e iɗa i na n cayi nkaya nle wa agadu.&gt;&gt;<verse eid="JER 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JER 3:19" />&lt;&lt; &lt;A̱mu na aciya̱va̱ n damma ta̱,</para>
  <para style="q2" vid="JER 3:19">na̱ ma̱za̱nga̱ ma ɗa ma tara wu</para>
  <para style="q2" vid="JER 3:19">tsa̱ muwun mo olobo n va̱,</para>
  <para style="q1" vid="JER 3:19">a̱vu n ca wu iɗa i sa'ani,</para>
  <para style="q2" vid="JER 3:19">agadu a na a la'ai ulobonu suru</para>
  <para style="q2" vid="JER 3:19">a̱tsuma̱ a nɗa mu uvaɗi.</para>
  <para style="q1" vid="JER 3:19">N shi ta̱ n yuwan majiyan</para>
  <para style="q2" vid="JER 3:19">ma na vee ɗe mu Dada</para>
  <para style="q2" vid="JER 3:19">waru va̱a̱ da̱shi kakasa na̱ mu shi.<verse eid="JER 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 3:20" />Amma cine ka tsu da̱na̱</para>
  <para style="q2" vid="JER 3:20">nu ulambu wa̱ a̱ɓula̱ e ekere a vali va̱ yi,</para>
  <para style="q1" vid="JER 3:20">ne ɗa i yuwaan numu ulambu wa̱ a̱ɓula̱,</para>
  <para style="q2" vid="JER 3:20">a̱vu u'wa wa Isra'ila,</para>
  <para style="qr" vid="JER 3:20">ne ɗa A̱sulazuva a dammai.&gt; &gt;&gt;<verse eid="JER 3:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JER 3:21" />&lt;&lt;A uwwa ta̱ uɗyo u mesun a agalaci agaɗi,</para>
  <para style="q2" vid="JER 3:21">uɗyo u mesun ni ipati ya ama a Isra'ila,</para>
  <para style="q1" vid="JER 3:21">adama a na a̱ lungusa̱ ta̱ re le,</para>
  <para style="q2" vid="JER 3:21">waru e icina ta̱ na̱ A̱sulazuva A̱sula̱ e le.<verse eid="JER 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 3:22" />Ka̱mba̱ yi, a̱ɗu ama o ulambu wa̱ a̱ɓula̱,</para>
  <para style="q2" vid="JER 3:22">n ta̱ ka̱mbuwa̱ ulambu wa̱ a̱ɓula̱ a̱ ɗu gbaga!&gt;&gt;</para>
  <para style="b" vid="JER 3:22" />
  <para style="q1" vid="JER 3:22">&lt;&lt;Amayun, tsu ta̱ ka̱mba̱ uba̱ta̱ wa̱ wu,</para>
  <para style="q2" vid="JER 3:22">adama a na a̱vu ɗa A̱sulazuva A̱sula̱ a̱ tsu.<verse eid="JER 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 3:23" />Amayun a̱ga̱nda̱ e itoni i musula̱</para>
  <para style="q2" vid="JER 3:23">a agaɗi na atali ili i wulumu i ɗa.</para>
  <para style="q1" vid="JER 3:23">Amayun uba̱ta̱ wa̱ A̱sulazuva A̱sula̱ a̱ tsu a ɗa goon,</para>
  <para style="q2" vid="JER 3:23">iwawi ya Isra'ila i ri.<verse eid="JER 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 3:24" />Diga a̱ tsulolobo tsa̱ tsu,</para>
  <para style="q2" vid="JER 3:24">musula̱ n wono nda n lyuwa ntsu iliyinkapa,</para>
  <para style="q1" vid="JER 3:24">ya̱a̱ a̱tsuma̱lima̱ a nkaya n tsu</para>
  <para style="q2" vid="JER 3:24">yo oɓolo e ikyon i le na̱ mgbele</para>
  <para style="q2" vid="JER 3:24">olobo e le ne esheli.<verse eid="JER 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 3:25" />Lyawa tsu von e iɗa na̱ wono u tsu,</para>
  <para style="q2" vid="JER 3:25">waru lyawa ili i wono i tsu i kpoto tsu.</para>
  <para style="q1" vid="JER 3:25">Adama a na tsu yuwaan ta̱</para>
  <para style="q2" vid="JER 3:25">A̱sulazuva A̱sula̱ a̱ tsu unusu,</para>
  <para style="q2" vid="JER 3:25">a̱tsu na̱ nkaya ntsu.</para>
  <para style="q1" vid="JER 3:25">Diga a̱ tsulolobo tsa̱ tsu,</para>
  <para style="q2" vid="JER 3:25">acina ana'an,</para>
  <para style="q1" vid="JER 3:25">tsu yuwaan A̱sulazuva</para>
  <para style="q2" vid="JER 3:25">A̱sula̱ a̱ tsu tsutoni shi.&gt;&gt;<verse eid="JER 3:25" /></para>
  <chapter eid="JER 3" />
  <chapter number="4" style="c" sid="JER 4" />
  <para style="q1">
    <verse number="1" style="v" sid="JER 4:1" />&lt;&lt;Nna̱ va̱ ka̱mba̱, a̱vu Isra'ila,</para>
  <para style="q2" vid="JER 4:1">vu ka̱mba̱ ya̱'a̱ va̱,&gt;&gt;</para>
  <para style="qr" vid="JER 4:1">ne ɗa A̱sulazuva a dammai.</para>
  <para style="q1" vid="JER 4:1">&lt;&lt;Nna̱ i tawa a̱ma̱li e idaba a̱ ɗu,</para>
  <para style="q2" vid="JER 4:1">a̱ ma̱ka̱ka̱n ma̱ va̱,</para>
  <para style="q2" vid="JER 4:1">a̱vu i lyawa agara nu ugbozu u ɗu,<verse eid="JER 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 4:2" />waru a̱tsuma̱ amayun na̱ a̱ɓula̱ vu kucina ta̱,</para>
  <para style="q2" vid="JER 4:2">&lt;Nna̱ A̱sulazuva a̱ ri wuma,&gt;</para>
  <para style="q1" vid="JER 4:2">to, nɗa n ta̱ tsura̱ aba'un o una̱ wa̱ yi,</para>
  <para style="q2" vid="JER 4:2">waru a̱ ta̱ tsura̱ tsugbain a̱tsuma̱ a̱ yi.&gt;&gt;<verse eid="JER 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 4:3" />Apa nda ili i na A̱sulazuva a dammai</para>
  <para style="q1" vid="JER 4:3">ama a̱ Urishelima na̱ Yahuda.</para>
  <para style="b" vid="JER 4:3" />
  <para style="q2" vid="JER 4:3">&lt;&lt;Cimbai iɗa i ɗu</para>
  <para style="q2" vid="JER 4:3">waru she i cu'wa̱n a̱tsuma̱ awanda wan.<note caller="-" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="HOS 10:12">Hos 10:12</ref>.</char></note><verse eid="JER 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 4:4" />I paɗa aciya̱ɗu uryumbu</para>
  <para style="q2" vid="JER 4:4">u matawa ma aciya̱ɗu uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="JER 4:4">a̱ɗu ama a Yahuda na ama a̱ Urishelima,</para>
  <para style="q1" vid="JER 4:4">Ni i 'yuwan upan u va̱ u ta̱ cipa̱</para>
  <para style="q2" vid="JER 4:4">u lyuwa ɗu tsa akina,</para>
  <para style="q2" vid="JER 4:4">adama e iwuya i na i yuwain,</para>
  <para style="q1" vid="JER 4:4">u ta lyuwa</para>
  <para style="q2" vid="JER 4:4">agba babu za na a̱ kimusa̱ yi.&gt;&gt;<verse eid="JER 4:4" /></para>
  <para style="s">Addama diga upasu wu Ugana</para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JER 4:5" />&lt;&lt;Salai a̱tsuma̱ a Yahuda</para>
  <para style="q2" vid="JER 4:5">waru i damma a̱tsuma̱ a̱ Urishelima,</para>
  <para style="q1" vid="JER 4:5">&lt;Ivula̱i avana e iɗa'a suru!&gt;</para>
  <para style="q2" vid="JER 4:5">Oruwoi lon i damma,</para>
  <para style="q2" vid="JER 4:5">&lt;Ɓoloto yi!</para>
  <para style="q1" vid="JER 4:5">Lyawa tsu sumai a̱ tyo e ilyuci</para>
  <para style="q2" vid="JER 4:5">i na i ri na̱ kari vu ucira!&gt; &gt;&gt;<verse eid="JER 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 4:6" />&lt;&lt;'Ya̱sa̱in atuta adama a̱ ma̱ 'ya̱wa̱ ma̱ Sihiyona!</para>
  <para style="q2" vid="JER 4:6">Suma yi adama a wuma u ɗu babu u ro!</para>
  <para style="q1" vid="JER 4:6">Adama a na n ta̱ ta̱wusa̱</para>
  <para style="q2" vid="JER 4:6">na addama diga upasu wu ugana</para>
  <para style="q2" vid="JER 4:6">oɓolo na̱ a̱ba̱jini o ukototosu.&gt;&gt;<verse eid="JER 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 4:7" />&lt;&lt;Kamu 'yon ta̱ diga a̱ nda̱na̱ta̱ ma̱ yi,</para>
  <para style="q2" vid="JER 4:7">za vu ukototosu wu nɗa wu uta̱ ta̱.</para>
  <para style="q1" vid="JER 4:7">U lyawa ta̱ nda̱na̱ta̱ ma̱ yi,</para>
  <para style="q2" vid="JER 4:7">adama u lungusa̱ iɗa ya̱ wu,</para>
  <para style="q2" vid="JER 4:7">ilyuci ya̱ wu i to o'wo okongo</para>
  <para style="q2" vid="JER 4:7">babu za pe.<verse eid="JER 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 4:8" />Adama o ndolo yo oto akashamuna</para>
  <para style="q2" vid="JER 4:8">i yuwan a̱tsumola̱ngu, waru i shon.</para>
  <para style="q1" vid="JER 4:8">Adama a na upan wa̱ a̱bunda̱ wa̱ A̱sulazuva</para>
  <para style="q2" vid="JER 4:8">u vadaluwa tsu ucina̱ shi.&gt;&gt;<verse eid="JER 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 4:9" />A̱sulazuva a damma ta̱ &lt;&lt;O urana u ndolo,&gt;&gt;</para>
  <para style="q2" vid="JER 4:9">&lt;&lt;mogono na azagbain a ta kuɗa okolo,</para>
  <para style="q1" vid="JER 4:9">nan ganu a ta lamba ili i na a damma,</para>
  <para style="q2" vid="JER 4:9">ama̱sula̱ waru a ta yuwan asalama.&gt;&gt;<verse eid="JER 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 4:10" />Reve n damma,</para>
  <para style="q2" vid="JER 4:10">&lt;&lt;O'o A̱sulazuva Zagbain,</para>
  <para style="q1" vid="JER 4:10">cine vu luluma̱i ama a nda</para>
  <para style="q2" vid="JER 4:10">suru suru na̱ Urishelima</para>
  <para style="q1" vid="JER 4:10">a na vu dammai,</para>
  <para style="q2" vid="JER 4:10">&lt;I ta̱ da̱na̱ na̱ asuvu nden,&gt;</para>
  <para style="q2" vid="JER 4:10">mantsa ma na matsun me pe'eni</para>
  <para style="q2" vid="JER 4:10">ma̱ ri a̱la̱kutsu a̱ tsu?&gt;&gt;<verse eid="JER 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JER 4:11" />A mantsa mo ndolo</para>
  <para style="q2" vid="JER 4:11">a ta damma ama a nda na̱ Urishelima,</para>
  <para style="q1" vid="JER 4:11">&lt;&lt;Upepu wu usuɗuwu diga agaɗi a̱tsumona</para>
  <para style="q2" vid="JER 4:11">u ta lapa a̱ tyo uba̱ta̱ wa ama a̱ va̱,</para>
  <para style="q2" vid="JER 4:11">amma adama u yeluwe ko u zangaɗu u ɗa shi,<verse eid="JER 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 4:12" />upepu wu ucira u nda'a</para>
  <para style="q2" vid="JER 4:12">diga uba̱ta̱ u va̱ u ɗa.</para>
  <para style="q1" vid="JER 4:12">Gogo n ta cuɗuwa</para>
  <para style="q2" vid="JER 4:12">uge'etosu u va̱ aci e le.&gt;&gt;<verse eid="JER 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JER 4:13" />&lt;&lt;Ka̱lyuwa̱i, u tu lo a̱ ta̱wa̱ tse eleshe,</para>
  <para style="q2" vid="JER 4:13">ikeke yi ido ya̱ yi a̱ ta̱wa̱ tsa̱ lipa̱,</para>
  <para style="q1" vid="JER 4:13">ido ya̱ yi i la'a ta̱ a̱kuru ilaɗi.</para>
  <para style="q2" vid="JER 4:13">A̱tsuma̱lima̱ a cina tsu ta̱!</para>
  <para style="q2" vid="JER 4:13">Tsu uwa ta̱ uta'atsu!&gt;&gt;<verse eid="JER 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 4:14" />&lt;&lt;A̱vu Urishelima,</para>
  <para style="q2" vid="JER 4:14">vu zuza̱'wa̱ unusu wo okolo a̱ wu,</para>
  <para style="q2" vid="JER 4:14">adama vu tsura̱ iwawi.</para>
  <para style="q1" vid="JER 4:14">Hali mantsa ma̱ ne ma ɗa</para>
  <para style="q2" vid="JER 4:14">va̱ ɓa̱na̱ majiyan ma vama okolo a̱ wu?<verse eid="JER 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 4:15" />Uɗyo u ta adanshi diga a Dan,</para>
  <para style="q2" vid="JER 4:15">a dansa iwuya</para>
  <para style="q2" vid="JER 4:15">diga o upasu wa aagaɗi a Ifiramu.&gt;&gt;<verse eid="JER 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 4:16" />&lt;&lt;Dammai nɗa ili ya nda!</para>
  <para style="q2" vid="JER 4:16">I damma Urishelima ana,</para>
  <para style="q2" vid="JER 4:16">&lt;A̱soja a̱ tu lo a̱ ta̱wa̱ diga e iɗa ya alanga,</para>
  <para style="q1" vid="JER 4:16">a̱ 'ya̱susa̱n uɗyo wu uvon</para>
  <para style="q2" vid="JER 4:16">a aci e ilyuci gbain gbain ya Yahuda.<verse eid="JER 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 4:17" />A̱ ka̱nda̱ruwa̱ yi ta̱</para>
  <para style="q2" vid="JER 4:17">tsa̱ a̱za̱ e ipiri ya atsusa,</para>
  <para style="q2" vid="JER 4:17">adama a na u yuwaan mu ta̱ aciyogbamu,&gt; &gt;&gt;</para>
  <para style="qr" vid="JER 4:17">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 4:18" />&lt;&lt;Ili na vu yuwain</para>
  <para style="q2" vid="JER 4:18">na̱ linga va̱ wu ɗa</para>
  <para style="q2" vid="JER 4:18">ta̱wa̱a̱ nuwu ni ili ya nda'a.</para>
  <para style="q1" vid="JER 4:18">A̱yi nda a̱ yi ɗa oforo a̱ wu,</para>
  <para style="q2" vid="JER 4:18">waru u to okono,</para>
  <para style="q2" vid="JER 4:18">u uwa ta̱ she o okolo a̱ wu.&gt;&gt;<verse eid="JER 4:18" /></para>
  <para style="s">Irimiya yuwan ta̱ mesun adama a ama a̱ yi</para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JER 4:19" />&lt;&lt;A̱tsuma̱lima̱ a̱ va̱! A̱tsuma̱lima̱ a̱ va̱!</para>
  <para style="q2" vid="JER 4:19">N te e ikpatatsu a̱tsuma̱ a̱tsuma̱lima̱!</para>
  <para style="q1" vid="JER 4:19">Okolo a̱ va̱ a̱ ta̱ ma̱riya̱,</para>
  <para style="q2" vid="JER 4:19">maa gura rungwa̱ kpen shi.</para>
  <para style="q1" vid="JER 4:19">Adama a na mu uwwa ta̱ mesun ma aavana,</para>
  <para style="q2" vid="JER 4:19">mu uwwa ta̱ yisali yu uvon.<verse eid="JER 4:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 4:20" />Addama aci addama,</para>
  <para style="q2" vid="JER 4:20">o kototo ta̱ iɗa suru.</para>
  <para style="q1" vid="JER 4:20">Babu usa̱n o kototo ta̱ ogodo a̱ va̱,</para>
  <para style="q2" vid="JER 4:20">avu a kara umuna wu una̱ntsu u va̱.<verse eid="JER 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 4:21" />Hali mantsa ma ne ma ɗa</para>
  <para style="q2" vid="JER 4:21">me ene atuta o uvon</para>
  <para style="q2" vid="JER 4:21">waru mu uwa mesun ma aavana?&gt;&gt;<verse eid="JER 4:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="JER 4:22" />&lt;&lt;Ama a̱ va̱ olo a ɗa,</para>
  <para style="q2" vid="JER 4:22">e reve mu shi.</para>
  <para style="q1" vid="JER 4:22">Muwun n babu ugbozu a ɗa,</para>
  <para style="q2" vid="JER 4:22">a̱ ri nu urevu shi.</para>
  <para style="q1" vid="JER 4:22">A̱ tu nu uguru u mayan me iwuya,</para>
  <para style="q2" vid="JER 4:22">e reve cine a yuwan isa'ani shi.&gt;&gt;<verse eid="JER 4:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 4:23" />&lt;&lt;N ka̱lyuwa̱ ta̱ uvaɗi</para>
  <para style="q2" vid="JER 4:23">u ri ni ili shi waru ofoli a ɗa,</para>
  <para style="q1" vid="JER 4:23">reve fo n ka̱lyuwa̱ zuva,</para>
  <para style="q2" vid="JER 4:23">agba babu ɗe ekan.<verse eid="JER 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 4:24" />N ka̱lyuwa̱ ta̱ nsasan,</para>
  <para style="q2" vid="JER 4:24">reve me ene le e ijinga̱ɗu,</para>
  <para style="q2" vid="JER 4:24">agaɗi suru e meje'en.&gt;&gt;<verse eid="JER 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 4:25" />N ka̱lyuwa̱ ta̱, waru babu vuma,</para>
  <para style="q2" vid="JER 4:25">nnunu ma zuva suru n suma ta̱.<verse eid="JER 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 4:26" />&lt;&lt;N ka̱lyuwa̱ ta̱,</para>
  <para style="q2" vid="JER 4:26">a̱vu me ene iɗa yu umili yo o'wo a̱tsumona,</para>
  <para style="q1" vid="JER 4:26">ilyuci ya̱ yi suru yo o'wo ta̱ okongo</para>
  <para style="q2" vid="JER 4:26">a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva</para>
  <para style="q2" vid="JER 4:26">nu upan wu usuɗuwu wa̱ yi.&gt;&gt;<verse eid="JER 4:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="JER 4:27" />Apa ili i na A̱sulazuva a Dammai,</para>
  <para style="q2" vid="JER 4:27">&lt;&lt;Iɗa suru i to o'wo okongo,</para>
  <para style="q1" vid="JER 4:27">ko a na wo o'woi</para>
  <para style="q2" vid="JER 4:27">mo kototo yi suru suru shi.<verse eid="JER 4:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 4:28" />Adama o ndolo ama o uvaɗi</para>
  <para style="q2" vid="JER 4:28">a ta yuwan a̱tsumola̱ngu</para>
  <para style="q2" vid="JER 4:28">waru zuva ta̱ ka̱mba̱ irumbu,</para>
  <para style="q1" vid="JER 4:28">adama a na n damma ta̱</para>
  <para style="q2" vid="JER 4:28">waru ma̱ bula̱ shi,</para>
  <para style="q1" vid="JER 4:28">n yuwan ta̱ majiyan</para>
  <para style="q2" vid="JER 4:28">waru ma̱ ka̱mba̱ a̱ca̱pa̱ shi.&gt;&gt;<verse eid="JER 4:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="JER 4:29" />&lt;&lt;Diga a mawwa me ilama</para>
  <para style="q2" vid="JER 4:29">ya akumbi e ido na aza alapiya,</para>
  <para style="q2" vid="JER 4:29">lyuci suru suma ta̱.</para>
  <para style="q1" vid="JER 4:29">Ozo ro a uwa ta̱ a̱a̱rumbu</para>
  <para style="q2" vid="JER 4:29">ozo ro a kumba atali.</para>
  <para style="q1" vid="JER 4:29">Ilyuci suru yo o'wo ta̱ okongo,</para>
  <para style="q2" vid="JER 4:29">babu za na a̱ da̱nu pe.<verse eid="JER 4:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 4:30" />A̱vu za na o kototo yi,</para>
  <para style="q2" vid="JER 4:30">nye va jiyasan</para>
  <para style="q1" vid="JER 4:30">hali a na vo otoyi</para>
  <para style="q2" vid="JER 4:30">aciya̱wu mutugu n shili</para>
  <para style="q2" vid="JER 4:30">na̱ atali a zinariya?</para>
  <para style="q1" vid="JER 4:30">Nyen i zuwai vu yuwain</para>
  <para style="q2" vid="JER 4:30">yisukumishi o urewesu wa̱ wu?</para>
  <para style="q2" vid="JER 4:30">Vu lobonoto ta̱ aciya̱wu pere.</para>
  <para style="q1" vid="JER 4:30">A̱za̱ e icigi ya̱ wu a suma wu ta̱,</para>
  <para style="q2" vid="JER 4:30">a̱ te izami i wuma ya̱ wu.&gt;&gt;<verse eid="JER 4:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 4:31" />Mu uwwa ta̱ mesun</para>
  <para style="q2" vid="JER 4:31">she damma ka na da̱nuyi teri,</para>
  <para style="q1" vid="JER 4:31">a̱ ma̱nga̱ tsa za na</para>
  <para style="q2" vid="JER 4:31">a matsan mawun mo ufaru,</para>
  <para style="q1" vid="JER 4:31">Sihiyona a̱ mesun</para>
  <para style="q2" vid="JER 4:31">a̱ wivuwun uta̱ ta̱,</para>
  <para style="q1" vid="JER 4:31">a̱ba̱ruwusa̱ ekere a̱ yi a dansa,</para>
  <para style="q2" vid="JER 4:31">&lt;&lt;A̱tsuma̱lima̱ a cina mu ta̱!</para>
  <para style="q1" vid="JER 4:31">N ta̱ a̱ ma̱lima̱ a̱ ma̱ka̱ka̱n</para>
  <para style="q2" vid="JER 4:31">ma̱ a̱za̱ mona ma ama.&gt;&gt;<verse eid="JER 4:31" /></para>
  <chapter eid="JER 4" />
  <chapter number="5" style="c" sid="JER 5" />
  <para style="s">Babu za na a yuwusan a̱ɓula̱ na amayun</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="JER 5:1" />&lt;&lt;Kuruyi re va̱ Urishelima</para>
  <para style="q2" vid="JER 5:1">i gawan ni i cipi,</para>
  <para style="q1" vid="JER 5:1">i ka̱lyuwa̱ ba̱ta̱ suru yi idana,</para>
  <para style="q2" vid="JER 5:1">i ka̱lyuwa̱ uba̱ta̱ wa agalaci a̱ lyuci.</para>
  <para style="q1" vid="JER 5:1">Ko i ta̱ tsura̱ vuma ta̱</para>
  <para style="q2" vid="JER 5:1">na yuwusan a̱ɓula̱,</para>
  <para style="q1" vid="JER 5:1">za na cigai amayun,</para>
  <para style="q2" vid="JER 5:1">tsura̱ n yuwaan lyuci gbain nda gafura.<verse eid="JER 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 5:2" />Ko na wo o'woi a damma ta̱,</para>
  <para style="q2" vid="JER 5:2">&lt;Tsu kucina ta̱ na̱ A̱sulazuva a na a̱ ri wuma,&gt; &gt;&gt;</para>
  <para style="q2" vid="JER 5:2">na̱ ne suru akucunu epen ɗa a yuwusan.<verse eid="JER 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 5:3" />A̱sulazuva, amayun a ɗa esu a̱ wu a zama shi?</para>
  <para style="q2" vid="JER 5:3">Vu faba le ta̱,</para>
  <para style="q2" vid="JER 5:3">amma a uwwa mɓa̱la̱ shi,</para>
  <para style="q1" vid="JER 5:3">vu minjira le ta̱</para>
  <para style="q2" vid="JER 5:3">amma a 'yuwan ta̱ a yuwan ulapulu.</para>
  <para style="q1" vid="JER 5:3">A shuvulai ta̱ urewesu u le,</para>
  <para style="q2" vid="JER 5:3">hali u la'a aatali ugbamu,</para>
  <para style="q2" vid="JER 5:3">reve a̱ kuɗa̱ a vadala.<verse eid="JER 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 5:4" />Reve n jiyan adansa,</para>
  <para style="q2" vid="JER 5:4">&lt;&lt;Ele nda a̱za̱ o ulambu ɗa gon,</para>
  <para style="q2" vid="JER 5:4">a̱ ri nu ugbozu shi,</para>
  <para style="q1" vid="JER 5:4">adama a na e reve ure wa̱ A̱sulazuva shi,</para>
  <para style="q2" vid="JER 5:4">ko ili i na A̱sula̱ e le a cigai shi.<verse eid="JER 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 5:5" />Adama o ndolo n ta̱ 'ya̱wa̱</para>
  <para style="q2" vid="JER 5:5">uba̱ta̱ wa azagbain</para>
  <para style="q2" vid="JER 5:5">n yuwan adanshi ne le,</para>
  <para style="q1" vid="JER 5:5">na amayun e reve ta̱ ure wa̱ A̱sulazuva,</para>
  <para style="q2" vid="JER 5:5">ni ili i na A̱sula̱ e le a cigai.</para>
  <para style="q1" vid="JER 5:5">Amma no okolo a̱ ta̱ a ɗa</para>
  <para style="q2" vid="JER 5:5">a kuɗai a̱gba̱la̱ e iluma,</para>
  <para style="q2" vid="JER 5:5">reve a taɓa akani.<verse eid="JER 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 5:6" />Adama o ndolo kamu diga</para>
  <para style="q2" vid="JER 5:6">a̱a̱rumbu to kototo le,</para>
  <para style="q1" vid="JER 5:6">nkerenkesu diga a̱tsumona</para>
  <para style="q2" vid="JER 5:6">mo to una le,</para>
  <para style="q1" vid="JER 5:6">uta̱su u ta vawan ilyuci i le,</para>
  <para style="q2" vid="JER 5:6">wu kara za na suru</para>
  <para style="q2" vid="JER 5:6">uta̱i mukari mukari,</para>
  <para style="q1" vid="JER 5:6">adama a na nusu le</para>
  <para style="q2" vid="JER 5:6">yuwan ta̱ a̱bunda̱ lon,</para>
  <para style="q1" vid="JER 5:6">ulambu wa̱ a̱ɓula̱ e le</para>
  <para style="q2" vid="JER 5:6">a yuwan ta̱ kpara.&gt;&gt;<verse eid="JER 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 5:7" />Amma a̱vu A̱sulazuva a damma,</para>
  <para style="q2" vid="JER 5:7">&lt;&lt;Nye i zuwai maa yuwaan wu gafura?</para>
  <para style="q2" vid="JER 5:7">Muwun ma̱ wu mu kasa ta̱ na̱ mu,</para>
  <para style="q1" vid="JER 5:7">reve a yuwan akucunu</para>
  <para style="q2" vid="JER 5:7">na̱ musula̱ nna ri musula̱ shi.</para>
  <para style="q1" vid="JER 5:7">N yuwaan le ta̱ ili i na a cigai suru,</para>
  <para style="q2" vid="JER 5:7">na̱ ne suru a yuwan ta̱ tsipere</para>
  <para style="q2" vid="JER 5:7">reve a̱ shiton 'wa va za a tsushakala.<verse eid="JER 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 5:8" />A̱ ta̱ tse ido i na i ri ni icigi i tsukoɓi,</para>
  <para style="q2" vid="JER 5:8">za suru a zama ka moron ma̱ nden ma̱ yi.<verse eid="JER 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 5:9" />Ulobono n ca le a̱tsuma̱lima̱ shi?&gt;&gt;</para>
  <para style="q2" vid="JER 5:9">Waru ulobono n tsupaa aciya̱va̱</para>
  <para style="q2" vid="JER 5:9">a̱ cu'un vu nɗa nda shi?</para>
  <para style="qr" vid="JER 5:9">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 5:10" />&lt;&lt;I ɓatsa pe a̱tsuma̱</para>
  <para style="q2" vid="JER 5:10">a̱ɗuma̱ ina̱bi va̱ yi i tama le,</para>
  <para style="q2" vid="JER 5:10">amma she i kototo le suru suru wan.</para>
  <para style="q1" vid="JER 5:10">I za̱ka̱tsa̱ eten e le,</para>
  <para style="q2" vid="JER 5:10">adama a na ama a nda</para>
  <para style="q2" vid="JER 5:10">a̱za̱ a̱ A̱sulazuva a ɗa shi.<verse eid="JER 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 5:11" />U'wa wa Isra'ila na̱ Yahuda o o'wo ta̱</para>
  <para style="q2" vid="JER 5:11">a̱za̱ o ulambu wa̱ a̱ɓula̱</para>
  <para style="q2" vid="JER 5:11">suru suru e ekere a̱ va̱,</para>
  <para style="qr" vid="JER 5:11">ne ɗa A̱sulazuva a dammai.<verse eid="JER 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 5:12" />A yuwan ta̱ epen a aci a̱ A̱sulazuva,</para>
  <para style="q2" vid="JER 5:12">adansa, wa yuwan ili shi!</para>
  <para style="q1" vid="JER 5:12">Babu iwuya i na ya̱ ta̱wa̱ tsu,</para>
  <para style="q2" vid="JER 5:12">tse ene matsun me pe'eni</para>
  <para style="q2" vid="JER 5:12">ko ambulu shi.&gt;&gt;<verse eid="JER 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 5:13" />&lt;&lt;Ama̱sula̱ e epen ɗa,</para>
  <para style="q2" vid="JER 5:13">adanshi A̱sula̱ a̱ ri oɓolo ne le shi,</para>
  <para style="q1" vid="JER 5:13">adama o ndolo lyawa ili i na a dammai</para>
  <para style="q2" vid="JER 5:13">i ka̱mba̱ aci ye le.&gt;&gt;<verse eid="JER 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 5:14" />Adama o ndolo, apa ili i na A̱sulazuva A̱sula̱</para>
  <para style="q2" vid="JER 5:14">o oɓolo a̱ a̱soja a zuva a dammai,</para>
  <para style="q1" vid="JER 5:14">&lt;&lt;Adama a na ama</para>
  <para style="q2" vid="JER 5:14">a yuwan ta̱ adanshi a nda,</para>
  <para style="q1" vid="JER 5:14">n ta zuwa adanshi a̱ va̱</para>
  <para style="q2" vid="JER 5:14">o una̱ wa̱ wu wo o'wo akina</para>
  <para style="q1" vid="JER 5:14">waru ama'a o o'wo</para>
  <para style="q2" vid="JER 5:14">ɗanga na akina a̱ tsu kuloto.&gt;&gt;<verse eid="JER 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 5:15" />&lt;&lt;Ka̱lyuwa̱i, a̱ɗu u'wa wa Isra'ila,</para>
  <para style="q2" vid="JER 5:15">n ta̱ ta̱wa̱a̱ ɗu na̱ nɗa</para>
  <para style="q2" vid="JER 5:15">ma alanga a yuwan nla̱ngi na̱ ɗu,&gt;&gt;</para>
  <para style="q1" vid="JER 5:15">nɗa mu ufaru na kaɓai asuvu,</para>
  <para style="q2" vid="JER 5:15">ama a na i revei elentsu e le shi,</para>
  <para style="q2" vid="JER 5:15">aza a na i revei ili i na a dansa shi.</para>
  <para style="qr" vid="JER 5:15">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 5:16" />&lt;&lt;Ujin u le u ta̱ tsa ason a na a̱ ri ukpa̱tu'u,</para>
  <para style="q2" vid="JER 5:16">a̱soja le suru ali o uvon a ɗa.<verse eid="JER 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 5:17" />A ta tama itana ya̱ a̱ɗuma̱ a̱ ɗu</para>
  <para style="q2" vid="JER 5:17">ni ilyalya i ɗu,</para>
  <para style="q1" vid="JER 5:17">waru o to kototo muwun</para>
  <para style="q2" vid="JER 5:17">mo olobo ne esheli a̱ ɗu,</para>
  <para style="q1" vid="JER 5:17">o to soɗu geru vi ikyon i ɗu,</para>
  <para style="q2" vid="JER 5:17">reve a tama ataci</para>
  <para style="q2" vid="JER 5:17">na̱ ɗanga vu biri ɗu.</para>
  <para style="q1" vid="JER 5:17">Na̱ matsun me pe'eni ma ɗa o kototo</para>
  <para style="q2" vid="JER 5:17">ilyuci yu ucira i na i zuwayi ucira.&gt;&gt;<verse eid="JER 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 5:18" />&lt;&lt;Amma ko a̱tsuma̱ a rana ndolo,</para>
  <para style="q2" vid="JER 5:18">A̱sulazuva a damma ta̱,</para>
  <para style="q2" vid="JER 5:18">mo kototo ɗu suru suru shi.&gt;&gt;<verse eid="JER 5:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JER 5:19" />&lt;&lt;Waru mantsa ma na ama a yuwain yeci,</para>
  <para style="q2" vid="JER 5:19">&lt;Nye i zuwai A̱sulazuva A̱sula̱ a̱ tsu</para>
  <para style="q2" vid="JER 5:19">a yuwain ili ya nda suru?&gt;</para>
  <para style="q1" vid="JER 5:19">I ta damma le, &lt;Cine i vari numu,</para>
  <para style="q2" vid="JER 5:19">a̱vu i yuwaan musula̱</para>
  <para style="q2" vid="JER 5:19">mo omocin e iɗa i ɗu a̱ga̱nda̱,</para>
  <para style="q1" vid="JER 5:19">ne ɗa yaa yuwaan omocin a̱ga̱nda̱</para>
  <para style="q2" vid="JER 5:19">e iɗa i na ri za ɗu shi.&gt; &gt;&gt;<verse eid="JER 5:19" /></para>
  <para style="s">Wuntsa ta̱ e ge'eto limatan va Yakubu</para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 5:20" />&lt;&lt;Vu damma u'wa wa Yakubu ili ya nda</para>
  <para style="q2" vid="JER 5:20">vu damma yi a̱tsuma̱ a Yahuda, ana,<verse eid="JER 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 5:21" />uwwai nda, a̱ɗu olo</para>
  <para style="q2" vid="JER 5:21">na ama o ulambu wu ugbozu,</para>
  <para style="q1" vid="JER 5:21">aza a na a̱ ri ne esu</para>
  <para style="q2" vid="JER 5:21">agba e tse ene shi,</para>
  <para style="q1" vid="JER 5:21">aza a na a̱ ri na atsuvu</para>
  <para style="q2" vid="JER 5:21">agba a tsu uwwa shi.<note caller="-" style="x"><char style="xo" closed="false">5:21 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">Ish 6:9-10</ref>; <ref loc="EZK 12:2">Izk 12:2</ref>; <ref loc="MRK 8:18">Mak 8:18</ref>.</char></note><verse eid="JER 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 5:22" />Wuntsa yu uwwa wovon u va̱ shi?</para>
  <para style="q2" vid="JER 5:22">Wuntsa vu je'en lipu</para>
  <para style="q2" vid="JER 5:22">a̱ ma̱ka̱ka̱n ma̱ va̱ shi?</para>
  <para style="q1" vid="JER 5:22">A̱mu ɗa n zuwai wuyun</para>
  <para style="q2" vid="JER 5:22">wo o'wo utyo u mala,</para>
  <para style="q2" vid="JER 5:22">utyo u na u ri nu ukosu shi,</para>
  <para style="q1" vid="JER 5:22">Ikeɗu i mini i ta̱ vuta̱la̱,</para>
  <para style="q2" vid="JER 5:22">agba a gura pasai shi,</para>
  <para style="q1" vid="JER 5:22">a̱ ta̱ gugwa̱</para>
  <para style="q2" vid="JER 5:22">agba a gura pasulaniyi shi.</para>
  <para style="qr" vid="JER 5:22">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 5:23" />Amma ama a nda a̱ ta̱ na</para>
  <para style="q2" vid="JER 5:23">aciyogbamu nu ugbawu wo okolo,</para>
  <para style="q2" vid="JER 5:23">a vadaluwa ta̱ reve e cina na̱ mu.<verse eid="JER 5:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 5:24" />A damma aciyele,</para>
  <para style="q2" vid="JER 5:24">&lt;Lyawa tsu uwwa wovon</para>
  <para style="q2" vid="JER 5:24">wa̱ A̱sulazuva A̱sula̱ a̱ tsu shi,</para>
  <para style="q1" vid="JER 5:24">za na tsu ca mini na̱ lyushi,</para>
  <para style="q2" vid="JER 5:24">mini mo ufaru u lyushi</para>
  <para style="q2" vid="JER 5:24">nu ukosu u lyushi,</para>
  <para style="q1" vid="JER 5:24">za na damma ntsu a lamba ajuma o ugasa</para>
  <para style="q2" vid="JER 5:24">a̱tsuma̱ aa'wan suru shi.<verse eid="JER 5:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 5:25" />Nusu ɗu kakasa ɗu ta̱ ni ili ya nda,</para>
  <para style="q2" vid="JER 5:25">waru iwuya i ɗu i putsa ɗu ta̱</para>
  <para style="q2" vid="JER 5:25">a̱ tsura̱ isa'ani.<verse eid="JER 5:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 5:26" />A̱tsuma̱ ama a̱ va̱</para>
  <para style="q2" vid="JER 5:26">a̱ tsura̱ ta̱ ama a vama,</para>
  <para style="q1" vid="JER 5:26">aza a na a vawusan she damma</para>
  <para style="q2" vid="JER 5:26">aza a na azusu nnunu,</para>
  <para style="q1" vid="JER 5:26">tsa aza a na azusu igolo,</para>
  <para style="q2" vid="JER 5:26">adama e reme ama.<verse eid="JER 5:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 5:27" />Cine aruta a tsu shiwan na̱ nnunu,</para>
  <para style="q2" vid="JER 5:27">'wa le shiwan ta̱ ne epen,</para>
  <para style="q1" vid="JER 5:27">o o'wo ta̱ a̱za̱ o utsuru,</para>
  <para style="q2" vid="JER 5:27">na̱ a̱za̱ o ucira,<verse eid="JER 5:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 5:28" />a yuwan ta̱ mgbain a madala.</para>
  <para style="q2" vid="JER 5:28">Iwuya i le i ri nu utyo shi,</para>
  <para style="q1" vid="JER 5:28">a tsu yuwaan mkpa'an</para>
  <para style="q2" vid="JER 5:28">uge'etosu wa̱ a̱ɓula̱ shi,</para>
  <para style="q1" vid="JER 5:28">waru a̱ tsi isawaan</para>
  <para style="q2" vid="JER 5:28">a̱za̱ o ulambu shi.<verse eid="JER 5:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 5:29" />Wuntsa n ca le a̱tsuma̱lima̱</para>
  <para style="q2" vid="JER 5:29">adama e ili i nda shi?</para>
  <para style="q1" vid="JER 5:29">Ko wuntsaa n tsupaa aciya̱va̱</para>
  <para style="q2" vid="JER 5:29">uba̱ta̱ wu nɗa tsunda shi?</para>
  <para style="qr" vid="JER 5:29">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 5:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="JER 5:30" />&lt;&lt; &lt;Ili i wovon ni ili yi idaba</para>
  <para style="q2" vid="JER 5:30">i fara ta̱ e iɗa'a.<verse eid="JER 5:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 5:31" />Ama̱sula̱ a ta yuwusan</para>
  <para style="q2" vid="JER 5:31">adanshi e ikaka ye epen,</para>
  <para style="q1" vid="JER 5:31">nan ganu a ta yuwusan</para>
  <para style="q2" vid="JER 5:31">uge'etosu nu ucira u le,</para>
  <para style="q2" vid="JER 5:31">waru ama a̱ va̱ a ciga ta̱ ne,</para>
  <para style="q1" vid="JER 5:31">agba nye ɗa ya yuwan</para>
  <para style="q2" vid="JER 5:31">nu ukosu u ta̱wa̱?&gt; &gt;&gt;<verse eid="JER 5:31" /></para>
  <chapter eid="JER 5" />
  <chapter number="6" style="c" sid="JER 6" />
  <para style="s">A̱ ka̱nda̱ruwa̱ ta̱ Urishelima nu uvon</para>
  <para style="q1">
    <verse number="1" style="v" sid="JER 6:1" />&lt;&lt;Sumai adama i la'ato wuma u ɗu,</para>
  <para style="q2" vid="JER 6:1">a̱ɗu ama a Banyami!</para>
  <para style="q2" vid="JER 6:1">Sumai diga Urishelima!</para>
  <para style="q1" vid="JER 6:1">Ivula̱i abulu a̱tsuma̱ a̱ Tekowa,</para>
  <para style="q2" vid="JER 6:1">waru i 'ya̱sa̱n atuta</para>
  <para style="q2" vid="JER 6:1">zuva va Bet Hakerem,</para>
  <para style="q1" vid="JER 6:1">adama a na a̱tsuma̱lima̱ a̱ ta̱ 'yosun</para>
  <para style="q2" vid="JER 6:1">diga upasu wu ugana,</para>
  <para style="q2" vid="JER 6:1">nu ukototosu wu ucira.<verse eid="JER 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 6:2" />N to kototo iɗa ya̱ Sihiyona,</para>
  <para style="q2" vid="JER 6:2">a̱vu iɗa i isa'ani</para>
  <para style="q2" vid="JER 6:2">uba̱ta̱ wa alyuna o ulobonu.&gt;&gt;<verse eid="JER 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 6:3" />&lt;&lt;Aza a aguɓa ni ikyon i le</para>
  <para style="q2" vid="JER 6:3">a̱ ta̱ ta̱wa̱ ya̱'a̱ yi,</para>
  <para style="q1" vid="JER 6:3">a̱ ta̱ shuwa̱ ogodo e le</para>
  <para style="q2" vid="JER 6:3">uka̱nda̱ruwu na̱ yi,</para>
  <para style="q2" vid="JER 6:3">za suru e idanasa uba̱ta̱ wa̱ yi.&gt;&gt;<verse eid="JER 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 6:4" />&lt;&lt;Foɓoi uvon a aci a̱ Urishelima!</para>
  <para style="q2" vid="JER 6:4">'Yoyin, lyawa tsu riya̱ yi nu urana!</para>
  <para style="q1" vid="JER 6:4">A'a, mantsa ma̱ ka̱ra̱ ta̱,</para>
  <para style="q2" vid="JER 6:4">adama a na urana u ta̱ a̱ ma̱riya̱a̱,</para>
  <para style="q2" vid="JER 6:4">ayin a ta yuwusan.<verse eid="JER 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 6:5" />Adama o ndolo 'yoyin,</para>
  <para style="q2" vid="JER 6:5">lyawa tsu riya̱a̱ yi na ayin,</para>
  <para style="q2" vid="JER 6:5">tsu ɓoso ba̱ta̱ vu cira va̱ yi!&gt;&gt;<verse eid="JER 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 6:6" />&lt;&lt;Apa ili i na A̱sulazuva</para>
  <para style="q2" vid="JER 6:6">o oɓolo a̱ a̱soja a zuva a dammai,</para>
  <para style="q2" vid="JER 6:6">yi koɗo ɗanga'a</para>
  <para style="q1" vid="JER 6:6">reve i ɓoloto ma̱bula̱</para>
  <para style="q2" vid="JER 6:6">uka̱nda̱ruwu na̱ Urishelima.</para>
  <para style="q1" vid="JER 6:6">Ko a 'yuwan a ciga</para>
  <para style="q2" vid="JER 6:6">a ca Lyuci Gbai'in oforo,</para>
  <para style="q2" vid="JER 6:6">adama a na u shiwan ta̱ ni ɓongishi.<verse eid="JER 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 6:7" />Cine oko'o a̱ tsu uta̱sa̱a̱ mini ma̱ yi,</para>
  <para style="q2" vid="JER 6:7">ne ɗa wa̱a̱ uta̱sa̱a̱ iwuya ya̱ yi.</para>
  <para style="q1" vid="JER 6:7">Mona nu ukototosu u ta̱</para>
  <para style="q2" vid="JER 6:7">ma̱gugwa̱ a̱tsuma̱ a̱ yi,</para>
  <para style="q1" vid="JER 6:7">ubanakun nan antsu a̱ yi</para>
  <para style="q2" vid="JER 6:7">a̱ ta̱ a̱ ma̱ka̱ka̱n ma̱ va̱.&gt;&gt;<verse eid="JER 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 6:8" />&lt;&lt;Vu uwwa tsuɓari, a̱vu Urishelima,</para>
  <para style="q2" vid="JER 6:8">ko gbashi n vadaluwa wu ucina̱,</para>
  <para style="q1" vid="JER 6:8">reve n ka̱mba̱to iɗa ya̱ wu okongo</para>
  <para style="q2" vid="JER 6:8">adama she za da̱nu pe wan.&gt;&gt;<verse eid="JER 6:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="JER 6:9" />Apa ili i na A̱sulazuva</para>
  <para style="q2" vid="JER 6:9">o oɓolo a̱ a̱soja a zuva a dammai,</para>
  <para style="q1" vid="JER 6:9">&lt;&lt;Lyawa le a 'yanla</para>
  <para style="q2" vid="JER 6:9">akapi a Isra'ila ulobonu</para>
  <para style="q2" vid="JER 6:9">cine a tsu 'yanla ataci.</para>
  <para style="q1" vid="JER 6:9">Vu da̱shi ba̱ruwa̱ ukere wa̱ wu e ete'en,</para>
  <para style="q2" vid="JER 6:9">tsa za na o ɓolotosu ina̱bi.&gt;&gt;<verse eid="JER 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 6:10" />&lt;&lt;Zane ɗa maa yuwaan adanshi,</para>
  <para style="q2" vid="JER 6:10">a̱vu n ca tsuɓari?</para>
  <para style="q1" vid="JER 6:10">Zane ɗa a uwwa mu?</para>
  <para style="q2" vid="JER 6:10">A ula ta̱ atsuvu e le,</para>
  <para style="q2" vid="JER 6:10">adama a̱ kuɗa̱ a uwwa.</para>
  <para style="q1" vid="JER 6:10">Adanshi A̱sulazuva o o'wo ta̱</para>
  <para style="q2" vid="JER 6:10">unusu e ekere e le,</para>
  <para style="q2" vid="JER 6:10">a uwwusa uyo'o wa̱ yi shi.<verse eid="JER 6:10" /></para>
  <para style="s">Upan wa̱ A̱sulazuva a̱ ta̱ cipa̱ aci a za biti</para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 6:11" />Adama o ndolo n ta̱ tapu</para>
  <para style="q2" vid="JER 6:11">nu upan wa̱ A̱sulazuva,</para>
  <para style="q2" vid="JER 6:11">hali n kuɗa̱ a kaɓa asuvu.</para>
  <para style="q1" vid="JER 6:11">A̱ tsun upan a aci a̱ muwun n na ri o ure,</para>
  <para style="q2" vid="JER 6:11">oɓolo nu uba̱ta̱ wi iɓolo yo olobo,</para>
  <para style="q1" vid="JER 6:11">a aci a ali na̱ a̱ma̱ci</para>
  <para style="q2" vid="JER 6:11">na̱ mukoshi na̱ mukuci.&gt;&gt;<verse eid="JER 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JER 6:12" />&lt;&lt;A ta ca ozo ro 'wa le,</para>
  <para style="q2" vid="JER 6:12">oɓolo na̱ a̱ɗuma̱ e le</para>
  <para style="q2" vid="JER 6:12">na̱ a̱ma̱ci e le suru.</para>
  <para style="q1" vid="JER 6:12">Mantsa ma na n cananai ukere u va̱</para>
  <para style="q2" vid="JER 6:12">nla̱ngi na̱ nda̱na̱ta̱ mi iɗa'a.</para>
  <para style="qr" vid="JER 6:12">Ne ɗa A̱sulazuva a dammai.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">6:12 </char><char style="xt" closed="false"><ref loc="JER 8:10-12">Irm 8:10-12</ref>.</char></note><verse eid="JER 6:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JER 6:13" />&lt;&lt;Diga uba̱ta̱ wu za na la'ai uka̱la̱mu</para>
  <para style="q2" vid="JER 6:13">a̱ tyo a zagbain a̱tsuma̱ e le,</para>
  <para style="q1" vid="JER 6:13">za suru a̱tsuma̱ e le</para>
  <para style="q2" vid="JER 6:13">a ta yuwusan utsa̱n u na</para>
  <para style="q2" vid="JER 6:13">wa̱a̱ tsura̱ uda̱shiwu wa̱ a̱bunda̱.</para>
  <para style="q1" vid="JER 6:13">Hali fo na ama̱sula̱ na̱ nan ganu,</para>
  <para style="q2" vid="JER 6:13">suru nle a ta yuwusan ulambu wa̱ a̱ɓula̱.<verse eid="JER 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 6:14" />O tsu co'wo ta̱ antsu ama a̱ va̱</para>
  <para style="q2" vid="JER 6:14">she damma ili i ro i ɗa shi.</para>
  <para style="q1" vid="JER 6:14">Adansa, nden ma asuvu,</para>
  <para style="q2" vid="JER 6:14">nden ma asuvu,</para>
  <para style="q1" vid="JER 6:14">agba a̱ yi ɗa nda</para>
  <para style="q2" vid="JER 6:14">babu nden ma asuvu.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="EZK 13:10">Izk 13:10</ref>.</char></note><verse eid="JER 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 6:15" />&lt;&lt;A ta uwwusa wono</para>
  <para style="q2" vid="JER 6:15">wi ili yi idaba i na a yuwain?</para>
  <para style="q1" vid="JER 6:15">O'o, a̱ ri na̱ wono shi ko ke'en,</para>
  <para style="q2" vid="JER 6:15">agba e reve cine</para>
  <para style="q2" vid="JER 6:15">a̱ ka̱ɗa̱to urewesu shi.</para>
  <para style="q1" vid="JER 6:15">Adama o ndolo a̱ ta̱ riya̱</para>
  <para style="q2" vid="JER 6:15">oɓolo na aza a na a̱ a̱risa̱,</para>
  <para style="q1" vid="JER 6:15">a̱ ta̱ ka̱ɗa̱to le</para>
  <para style="q2" vid="JER 6:15">a mantsa ma na n ca nle oforo,&gt;&gt;</para>
  <para style="qr" vid="JER 6:15">ne ɗa A̱sulazuva a dammai.<verse eid="JER 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 6:16" />&lt;&lt;Apa ili i na A̱sulazuva a dammai,</para>
  <para style="q2" vid="JER 6:16">isawain a nsanji mu ure i ka̱lyuwa̱,</para>
  <para style="q2" vid="JER 6:16">ye ece a te ɗa akuci o ure,</para>
  <para style="q1" vid="JER 6:16">ye ece a te ɗa ure u sa'ani,</para>
  <para style="q2" vid="JER 6:16">a̱vu i kuru yi.</para>
  <para style="q1" vid="JER 6:16">Tsura̱ i tsura̱a̱ wuma u ɗu wivuwun.</para>
  <para style="q2" vid="JER 6:16">Amma a̱vu i damma,</para>
  <para style="q2" vid="JER 6:16">&lt;Tsa̱a̱ kuru pe shi.&gt;<verse eid="JER 6:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 6:17" />N zuwaa ɗu ta̱ eze e ipiri, a adansa,</para>
  <para style="q2" vid="JER 6:17">&lt;Poloi atsuvu e mesun ma aavana!&gt;</para>
  <para style="q1" vid="JER 6:17">Amma a̱vu i damma,</para>
  <para style="q2" vid="JER 6:17">&lt;Tsa uwwa shi.&gt;<verse eid="JER 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 6:18" />Adama o ndolo uwwai, a̱ɗu nɗa,</para>
  <para style="q2" vid="JER 6:18">waru i reve, a̱ɗu esu a ama,</para>
  <para style="q2" vid="JER 6:18">ili i na yaa fara ne le.<verse eid="JER 6:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 6:19" />Uwwa, a̱vu uvaɗi!</para>
  <para style="q2" vid="JER 6:19">N ta̱ ta̱wa̱ na addama</para>
  <para style="q2" vid="JER 6:19">a aci a ama a nda,</para>
  <para style="q2" vid="JER 6:19">o una̱ wu linga le,</para>
  <para style="q1" vid="JER 6:19">adama a na o poloo adanshi a̱ va̱ atsuvu shi,</para>
  <para style="q2" vid="JER 6:19">reve a 'yuwan wila̱ u va̱.&gt;&gt;<verse eid="JER 6:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 6:20" />&lt;&lt;E te ɗa urana u na a̱ ta̱wa̱a̱ mu</para>
  <para style="q2" vid="JER 6:20">na̱ furenkisen diga a Sheba,</para>
  <para style="q1" vid="JER 6:20">ko a̱ ta̱wa̱ na̱ erike</para>
  <para style="q2" vid="JER 6:20">diga e iɗa ya alanga?</para>
  <para style="q1" vid="JER 6:20">Kucci vu ukula̱tosu ɗu</para>
  <para style="q2" vid="JER 6:20">ili i na ma̱a̱ usu ɗa shi,</para>
  <para style="q1" vid="JER 6:20">waru kucci ɗu</para>
  <para style="q2" vid="JER 6:20">a tawa mu esu shi.&gt;&gt;<verse eid="JER 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 6:21" />Adama o ndolo apa ili i na</para>
  <para style="q2" vid="JER 6:21">A̱sulazuva a dammai,</para>
  <para style="q1" vid="JER 6:21">&lt;&lt;N ta zuwa ili yu uta̱ɗa̱tsa̱sa̱</para>
  <para style="q2" vid="JER 6:21">elime ama a nda.</para>
  <para style="q1" vid="JER 6:21">Dada na̱ muwun mo olobo ma̱ yi,</para>
  <para style="q2" vid="JER 6:21">n ta̱ ta̱ɗa̱tsa̱ va̱ni le,</para>
  <para style="q1" vid="JER 6:21">moron ma̱ nden ni i'utsa̱ ya̱ yi,</para>
  <para style="q2" vid="JER 6:21">a̱ ta̱ kuwa̱ oɓolo!&gt;&gt;<verse eid="JER 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 6:22" />Apa ili i na A̱sulazuva a dammai,</para>
  <para style="q2" vid="JER 6:22">&lt;&lt;Ka̱lyuwa̱, a̱soja a̱ ta̱ lo a̱ ta̱wa̱</para>
  <para style="q2" vid="JER 6:22">diga upasu wu ugana,</para>
  <para style="q1" vid="JER 6:22">a̱ ta̱ 'ya̱sa̱n nɗa mu ucira</para>
  <para style="q2" vid="JER 6:22">diga o ukosu wu uvaɗi.<verse eid="JER 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 6:23" />A̱ tu uɓa̱nu nu ujin ni ibata,</para>
  <para style="q2" vid="JER 6:23">ama a vama a ɗa</para>
  <para style="q2" vid="JER 6:23">e tse ene iliyali shi,</para>
  <para style="q1" vid="JER 6:23">ma̱gugwa̱ me le ma̱ ta̱</para>
  <para style="q2" vid="JER 6:23">tsa̱ ma̱gugwa̱ ma mala,</para>
  <para style="q1" vid="JER 6:23">mantsa ma na a̱ ri</para>
  <para style="q2" vid="JER 6:23">a mmalu zuva vi ido i le,</para>
  <para style="q1" vid="JER 6:23">a̱ tsu ta̱wa̱ ta̱ ugeru she damma</para>
  <para style="q2" vid="JER 6:23">aza a na a darai</para>
  <para style="q1" vid="JER 6:23">adama o uvon,</para>
  <para style="q2" vid="JER 6:23">a̱ riya̱a̱ wu,</para>
  <para style="q2" vid="JER 6:23">a̱vu Urishelima!&gt;&gt;<verse eid="JER 6:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="JER 6:24" />&lt;&lt;Tsu uwwa ta̱ adama a ɗa e le,</para>
  <para style="q2" vid="JER 6:24">reve ekere a̱ tsu a̱ kuwa̱.</para>
  <para style="q1" vid="JER 6:24">A̱tsuma̱lima̱ a cina tsu ta̱,</para>
  <para style="q2" vid="JER 6:24">mɓa̱la̱ tsa ka na ri e teri.<verse eid="JER 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 6:25" />She yu uta̱ a̱ 'ya̱wa̱ o uɗuma̱ wan,</para>
  <para style="q2" vid="JER 6:25">ko i wala e re wan,</para>
  <para style="q1" vid="JER 6:25">adama a na ma'yuwatan ma̱ ta̱</para>
  <para style="q2" vid="JER 6:25">na̱ mutsun me pe'eni,</para>
  <para style="q2" vid="JER 6:25">waru wovon u ta̱ lo uba̱ta̱ biti.<verse eid="JER 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 6:26" />A̱ɗu ama a̱ va̱,</para>
  <para style="q2" vid="JER 6:26">otoyi akashamuna</para>
  <para style="q2" vid="JER 6:26">reve i bunda̱la̱ okomo,</para>
  <para style="q1" vid="JER 6:26">i yuwan a̱tsumola̱ngu wu usuɗuwu,</para>
  <para style="q2" vid="JER 6:26">she damma za na lambai</para>
  <para style="q2" vid="JER 6:26">mawun mo ulobo ma̱ ta̱ ma̱ yi,</para>
  <para style="q1" vid="JER 6:26">adama a na babu urevu</para>
  <para style="q2" vid="JER 6:26">za vu ukototosu ta̱ ta̱wa̱ a aci a̱ ɗu.&gt;&gt;<verse eid="JER 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 6:27" />Amma a̱vu Irimiya,</para>
  <para style="q2" vid="JER 6:27">&lt;&lt;N zuwa wu ta̱</para>
  <para style="q1" vid="JER 6:27">za na o rito wi irumu</para>
  <para style="q2" vid="JER 6:27">a̱tsuma̱ ama a̱ va̱,</para>
  <para style="q1" vid="JER 6:27">adama vu reve</para>
  <para style="q2" vid="JER 6:27">waru vu kurato le.<verse eid="JER 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 6:28" />Suru n le aza aciyogbamu a ɗa,</para>
  <para style="q2" vid="JER 6:28">nu u'ya̱susa̱n wa a aci,</para>
  <para style="q1" vid="JER 6:28">a gara a bazasa</para>
  <para style="q2" vid="JER 6:28">adanshi e ke'en ke'en.</para>
  <para style="q1" vid="JER 6:28">A̱ le irumushili i ɗa,</para>
  <para style="q2" vid="JER 6:28">suru nle a̱za̱ o ulambu</para>
  <para style="q2" vid="JER 6:28">wa̱ a̱ɓula̱ a ɗa.<verse eid="JER 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 6:29" />A̱ fa̱la̱ ta̱ elentsu akina nu ucira</para>
  <para style="q2" vid="JER 6:29">tsura̱ wu jeruweto rumu.</para>
  <para style="q1" vid="JER 6:29">Amma wujeruwetosu'u suru</para>
  <para style="q2" vid="JER 6:29">ili ye pere i ɗa,</para>
  <para style="q2" vid="JER 6:29">o uta̱ aza a awuya shi.<verse eid="JER 6:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 6:30" />A̱ ta̱ ɗesu le azurufa ve pere,</para>
  <para style="q2" vid="JER 6:30">adama a na A̱sulazuva a 'yuwan nle.&gt;&gt;<verse eid="JER 6:30" /></para>
  <chapter eid="JER 6" />
  <chapter number="7" style="c" sid="JER 7" />
  <para style="s">Itoni ye epen</para>
  <para style="r">(<ref loc="JER 26:1-6">Irm 26:1-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 7:1" />Apa adanshi a na A̱sulazuva a yuwayin Irimiya, ana, <verse eid="JER 7:1" /><verse number="2" style="v" sid="JER 7:2" />isawan o una̱ntsu wu u'wa wa̱ A̱sulazuva, reve vu damma ikaka i nda, &lt;&lt; &lt;Uwwai adanshi A̱sulazuva, a̱ɗu ama a Yahuda suru, aza a na a̱ ta̱wa̱i nu una̱ntsu u nda adama a yuwaan A̱sulazuva a̱ga̱nda̱.&gt; &gt;&gt; <verse eid="JER 7:2" /><verse number="3" style="v" sid="JER 7:3" />&lt;&lt;Apa nda ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva a̱ A̱sula̱ a Isra'ila a dammai, lapulai re na̱ linga ɗu, a̱vu n lyawa ɗu i da̱nu uba̱ta̱ nda.&gt;&gt; <verse eid="JER 7:3" /><verse number="4" style="v" sid="JER 7:4" />She i zuwa ucira u ɗu adanshi a̱za̱ e epen i damma, &lt;&lt;A̱yi nda ɗa A̱a̱'isa̱mapaɗa a̱ A̱sulazuva, A̱a̱'isa̱mapaɗa a̱ A̱sulazuva, A̱a̱'isa̱mapaɗa a̱ A̱sulazuva wan!&gt;&gt;<verse eid="JER 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 7:5" />&lt;&lt;Ni i lapula re na̱ linga ɗu na amayun, waru i yuwulai a̱ɓula̱ ca ɗu, <verse eid="JER 7:5" /><verse number="6" style="v" sid="JER 7:6" />ni iɓongi omoci na̱ mkpa'an shi, ko nra̱na̱, ko yoo oco mpasa ma za babu unusu pa nda shi, ko i kuru musula̱ mo omocin n ro nna ma̱a̱ ta̱wa̱ wu kototosu shi, <verse eid="JER 7:6" /><verse number="7" style="v" sid="JER 7:7" />ne ɗa maa lyawa ɗu i da̱nu uba̱ta̱ u nda, a̱tsuma̱ e iɗa i na n cayi nkaya nɗu hali hali hali.<verse eid="JER 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 7:8" />&lt;&lt;Ka̱lyuwa̱, i zuwa ta̱ ucira adanshi epen a na a̱ ri na̱ a̱ɓula̱ shi.<verse eid="JER 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 7:9" />&lt;&lt;Reve i yuwusan wivu na̱ mona, ni i yuwusayin tsipere, na akucunu epen, ni i casuyi Ba'al kuci, ni i kurusu yi musula̱ n ro nna i revei shi,&gt;&gt; <verse eid="JER 7:9" /><verse number="10" style="v" sid="JER 7:10" />gogo nda a̱vu i ta̱wa̱ yi isawan a̱ ma̱ka̱ka̱n ma̱ va̱ o u'wa u nda na e ɗesu na Aala a̱ va̱, adansa, &lt;&lt;Tsu la'a ta̱,&gt;&gt; Tsu la'a ta̱ na tsa lyuwa elime na̱ mayan me ili yi idaba i nda shi? <verse eid="JER 7:10" /><verse number="11" style="v" sid="JER 7:11" />&lt;&lt;U'wa u nda, na e ɗesu na Aala a̱ va̱, wo o'wo ta̱ a̱ka̱ri evu e wenu u ɗu? Amma n ta̱ a̱ka̱nla̱.<note caller="-" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="MAT 21:13">Mat 21:13</ref>; <ref loc="MRK 11:17">Mak 11:17</ref>; <ref loc="LUK 19:46">Luk 19:46</ref>.</char></note> Ne ɗa A̱sulazuva a dammai. <verse eid="JER 7:11" /><verse number="12" style="v" sid="JER 7:12" />Amma gogo ka̱ra̱i a̱ tyo Uba̱ta̱ u va̱ u na u ri a̱ Shilo, uba̱ta̱ u na n ɗangwai Aala a̱ va̱ a̱ da̱na̱ nu ufaru, tsura̱ yee ene ili i na n yuwain na̱ yi, adama a̱bunda̱ e iwuya ya ama a̱ va̱ Isra'ila.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">7:12-14 </char><char style="xt" closed="false"><ref loc="JOS 18:1">Jos 18:1</ref>; <ref loc="PSA 78:60">Ica 78:60</ref>; <ref loc="JER 26:6">Irm 26:6</ref>. </char></note> <verse eid="JER 7:12" /><verse number="13" style="v" sid="JER 7:13" />Reve A̱sulazuva a damma, mantsa ma na yaa yuwusan ili i nda suru,&lt;&lt;N yuwan ta̱ adanshi na̱ ɗu kuci kuci, agba i zuwaa mu atsuvu shi, reve n ɗe ɗu, amma suru na̱ ne i usu mu shi. <verse eid="JER 7:13" /><verse number="14" style="v" sid="JER 7:14" />Adama o ndolo, n ta yuwan nu u'wa u na e ɗesu na Aala a̱ va̱, na i zuwayi ucira, nu uba̱ta̱ u na n ca nɗu na̱ nkaya nɗu, cine n yuwain na̱ Shilo. <verse eid="JER 7:14" /><verse number="15" style="v" sid="JER 7:15" />Waru n ta kakasa ɗu nu urewesu u va̱, cine n kakasai na̱ a̱za̱ ɗu suru, ama a Ifiramu.&gt;&gt;<verse eid="JER 7:15" /></para>
  <para style="s">A putsaa ta̱ Irimiya na avasa adama a ama a̱ yi</para>
  <para style="p">
    <verse number="16" style="v" sid="JER 7:16" />&lt;&lt;A̱vu waru Irimiya, she vu yuwan avasa adama a ama a nda wan, she vu shon ko vu yuwan avasa adama e le wan, ko vu pati mu wan, adama a na ma uwwa wu shi. <verse eid="JER 7:16" /><verse number="17" style="v" sid="JER 7:17" />Vee ene ili i na a yuwusan e ilyuci ya Yahuda na̱ re va̱ Urishelima shi? <verse eid="JER 7:17" /><verse number="18" style="v" sid="JER 7:18" />Muwun n tsu ɓoloto ta̱ ɗanga, reve nan dada a gba'ato akina, waru a̱ma̱ci a tsu uban ta̱ yira tsura̱ a yuwan akala adama a̱ ma̱sula̱ ma na a̱ tsu ɗe Egbere va Zuva. Waru o tso oco ta̱ kuci vo oso uba̱ta̱ u musula̱ n ro, tsura̱ a zuwa mu n yuwan upan.<note caller="-" style="x"><char style="xo" closed="false">7:18 </char><char style="xt" closed="false"><ref loc="JER 44:7-19">Irm 44:7-19</ref>.</char></note> <verse eid="JER 7:18" /><verse number="19" style="v" sid="JER 7:19" />Amma a̱mu ɗa a suɗatosu asuvu? Ne ɗa A̱sulazuva a dammai. Ashe aciyele a ɗa a palasa, a casu aciyele wono shi?&gt;&gt;<verse eid="JER 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 7:20" />Adama o ndolo apa ili i na A̱sulazuva A̱sula̱ a dammai, &lt;&lt;Ka̱lyuwa̱, n ta̱ tsun upan u va̱ na̱ a̱tsumola̱ngu a̱ va̱ uba̱ta̱ u nda, a aci ama ni inama, na̱ zuva vu ɗanga na̱ a̱ɗuma̱ ni itana yi ca̱'a̱n vi iɗa, waru u ta̱ kula̱ agba a gura kimusa̱ yi shi.&gt;&gt;<verse eid="JER 7:20" /></para>
  <para style="s">Kucci tsu tara tsugbain tsa̱ tsutoni shi</para>
  <para style="p">
    <verse number="21" style="v" sid="JER 7:21" />Apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva, A̱sula̱ a Isra'ila, a dammai, &lt;&lt;Lyuwai elime i da̱shi kucci vu ukula̱tosu ɗu e ekere e ikucci i ɗu, a̱vu i tama inama na aciya̱ɗu! <verse eid="JER 7:21" /><verse number="22" style="v" sid="JER 7:22" />A̱tsuma̱ o urana u na mu uta̱a̱ yi nkaya nɗu diga a̱tsuma̱ e iɗa ya Masar, shi n yuwan adanshi ne le, ko n damma le, adama a ɗa a̱ kucci vu ukula̱tosu nu ucasu shi. <verse eid="JER 7:22" /><verse number="23" style="v" sid="JER 7:23" />Amma n ca le ta̱ udammu u nda, &lt;Yuwain tsutoni na̱ a̱mu, waru n to o'wo A̱sula̱ a̱ ɗu, waru a̱ɗu i to o'wo ama a̱ va̱. I yuwan mmalu a̱tsuma̱ a̱ re vu udammu u na n ca nɗu, adama ili i wala ɗu mejege.&gt; &gt;&gt; <verse eid="JER 7:23" /><verse number="24" style="v" sid="JER 7:24" />&lt;&lt;Amma a uwwa shi ko o polo atsuvu shi, reve a̱ kuru a̱sa̱la̱ nu ugbawu wo okolo a vama e le, reve a̱ ka̱mba̱ a̱ca̱pa̱ o una̱ u na a lyuwa elime. <verse eid="JER 7:24" /><verse number="25" style="v" sid="JER 7:25" />Diga a mantsa ma na nkaya nɗu mu uta̱i e iɗa ya Masar hali acina ana'an, urana biti, n lyungusu ta̱ agbashi a̱ va̱ ama̱sula̱ suru ya̱'a̱ le. <verse eid="JER 7:25" /><verse number="26" style="v" sid="JER 7:26" />Na̱ ne suru a̱ kuɗa̱ ta̱ a uwwa mu, ko o poloo mu atsuvu e le. Reve a gbawato okolo e le a̱vu a yuwan iwuya ula'awu na̱ nkaya n le.&gt;&gt;<verse eid="JER 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 7:27" />&lt;&lt;A mantsa ma na vu damma n le ili i nda suru, o poloo wu atsuvu shi, a mantsa ma na vu ɗe nle, a̱a̱ usu shi. <verse eid="JER 7:27" /><verse number="28" style="v" sid="JER 7:28" />Adama o ndolo vu damma le ana, apa nda iɗa i na i kuɗa̱i a yuwan tsutoni na̱ A̱sulazuva A̱sula̱ e le, waru a̱ usu tsuɓari tsa̱ yi shi. Waru amayun o lo shi, u puwa̱a̱n ta̱ a̱ na̱ le. <verse eid="JER 7:28" /><verse number="29" style="v" sid="JER 7:29" />&lt;Punai a̱nji aci a̱ ɗu adama a̱tsumola̱ngu, reve yo oco le. I cana ishipa ya̱ a̱tsumola̱ngu agaɗi, adama a na A̱sulazuva a 'yuwan ta̱ ama gogo nda, wu kasa ta̱ ne le adama o upan u na a zuwa niyi.&gt; &gt;&gt;<verse eid="JER 7:29" /></para>
  <para style="s">Uka̱ri u mapaɗa</para>
  <para style="p">
    <verse number="30" style="v" sid="JER 7:30" />&lt;&lt;Ama a Yahuda a yuwan ta̱ iwuya esu a̱ va̱,&gt;&gt; ne ɗa a̱ A̱sulazuva a dammai. &lt;&lt;A̱ shuwa̱ ta̱ a̱ma̱li e idaba a̱tsuma̱ o U'wa a na e ɗesu na ala a̱ va̱, reve a̱ lungusa̱ yi. <verse eid="JER 7:30" /><verse number="31" style="v" sid="JER 7:31" />A suwa ta̱ ba̱ta̱ va̱ a̱ga̱nda̱ va̱ Tofe, za na a̱ yi ɗa Uka̱ri wa̱ Ben Hinom, adama a̱ kula̱to muwun mo olobo n le ne esheli a̱tsuma̱ akina, agba n zuwa le a yuwan ne shi, waru u ta̱wa̱ mu okolo shi.&gt;&gt;<verse eid="JER 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JER 7:32" />&lt;&lt;Adama o ndolo uwwai, urana u ta̱ lo a̱ ta̱wa̱,&gt;&gt; ne ɗa A̱sulazuva a dammai, &lt;&lt;Ana a̱ da̱shi ɗe yi Tofe shi, ko Uka̱ri wa̱ Ben Hinom shi, amma Uka̱ri u mapaɗa, adama a na a̱ ta̱ ciɗo a̱kwa̱kwa̱ a̱tsuma̱ a̱ Tofe hali she na̱ a lamba uba̱ta̱ wa̱ a̱ciɗa̱. <verse eid="JER 7:32" /><verse number="33" style="v" sid="JER 7:33" />Lipu va̱ a̱kwa̱kwa̱ a ama a nda'a o to o'wo ilyalya yu nnunu, ni inama yu uvaɗi, waru babu za na a̱ gba̱ra̱ le. <verse eid="JER 7:33" /><verse number="34" style="v" sid="JER 7:34" />N ta̱ ta̱wa̱ nu ukosu we elemu a̱ ma̱za̱nga̱ na̱ mere, nu uɗyo u vali sa'avu na̱ ka sa'avu a̱tsuma̱ a̱ lyuci gbain va Yahuda na̱ re va̱ Urishelima, adama a na iɗa'a i to o'wo okongo.&gt;&gt;<verse eid="JER 7:34" /></para>
  <chapter eid="JER 7" />
  <chapter number="8" style="c" sid="JER 8" />
  <para style="s">Unusu na aciyogbamu wa aza a Yahuda</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 8:1" />A̱sulazuva a damma ta̱, &lt;&lt;A mantsa mo ndolo, a̱ ta̱ o uta̱a̱ ne etele o ngono ma Yahuda, ne etele a nan ganu na aza a ama̱sula̱, ne etele a ama a̱ Urishelima diga ason le. <verse eid="JER 8:1" /><verse number="2" style="v" sid="JER 8:2" />A̱ ta̱ o uta̱ le o urana no woto na̱ mutyolo'o ma zuva nna i cigai, a na wo o'woi a̱ ta̱ kurusu urana na̱ woto na̱ mutyolo'o, musula̱n nna a cigai waru aa yuwusaan le a̱ga̱nda̱. Oo ɓoloto le ko a̱ ciɗo le shi, amma o to o'wo tsa̱ edemu wocowu e iɗa. <verse eid="JER 8:2" /><verse number="3" style="v" sid="JER 8:3" />Uba̱ta̱ u na m gba̱ra̱ nle a̱ 'ya̱wa̱ suru, akapi a na a buwai suru a̱tsuma̱ akapi o gundo vu nɗa n vama nda a ta la'a ciga ukwa̱ na̱ a̱ da̱na̱ wuma,&gt;&gt; ne ɗa A̱sulazuva o oɓolo a̱ a̱soja a zuva dammai.<verse eid="JER 8:3" /></para>
  <para style="s">Unusu nu ucasu wa̱ a̱tsuma̱lima̱</para>
  <para style="p">
    <verse number="4" style="v" sid="JER 8:4" />Irimiya vu damma le,</para>
  <para style="q2" vid="JER 8:4">apa ili i na A̱sulazuva a dammai,</para>
  <para style="q1" vid="JER 8:4">&lt;&lt;Na̱ vuma riya̱ u tsu 'yowisa̱n shi?</para>
  <para style="q2" vid="JER 8:4">Na̱ vuma lyawa ure wa̱ ka̱mbisa̱ shi?<verse eid="JER 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 8:5" />Nye i zuwai ama a nda a vadalai ucina̱?</para>
  <para style="q2" vid="JER 8:5">Nye i zuwai a̱za̱ a̱ Urishelima</para>
  <para style="q2" vid="JER 8:5">a vadalai ucina̱ kuci?</para>
  <para style="q1" vid="JER 8:5">A suraa ta̱ epen,</para>
  <para style="q2" vid="JER 8:5">reve a 'yuwan na a vadala.<verse eid="JER 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 8:6" />N polo ta̱ atsuvu ulobono,</para>
  <para style="q2" vid="JER 8:6">amma a yuwan adanshi</para>
  <para style="q2" vid="JER 8:6">e mejege shi.</para>
  <para style="q1" vid="JER 8:6">Babu za na vadaluwai</para>
  <para style="q2" vid="JER 8:6">diga e iwuya ya̱ yi,</para>
  <para style="q2" vid="JER 8:6">adansa, &lt;Nye ɗa n yuwain?&gt;</para>
  <para style="q1" vid="JER 8:6">Za suru ta̱ kurusu okolo a̱ yi,</para>
  <para style="q2" vid="JER 8:6">cine do tsu foɓo</para>
  <para style="q2" vid="JER 8:6">u 'ya̱wa̱ uba̱ta̱ o uvon.<verse eid="JER 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 8:7" />Ko aashamuwa a na a̱ ri agalaci a zuva,</para>
  <para style="q2" vid="JER 8:7">e reve ta̱ mantsa ma̱ yi.</para>
  <para style="q1" vid="JER 8:7">Waru ma̱rukuku na̱ manunu na̱ a̱a̱pa̱mu,</para>
  <para style="q2" vid="JER 8:7">e reve ta̱ mantsa ma na a̱ tsu ka̱mba̱,</para>
  <para style="q1" vid="JER 8:7">amma ama a̱ va̱ e reve</para>
  <para style="q2" vid="JER 8:7">ili i na A̱sulazuva a cigai shi.&gt;&gt;<verse eid="JER 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 8:8" />Cine tsu ɗa yaa damma,</para>
  <para style="q2" vid="JER 8:8">&lt;&lt;Tsu tu nu ugbozu,</para>
  <para style="q1" vid="JER 8:8">adama a na tsu ta̱</para>
  <para style="q2" vid="JER 8:8">na̱ wila̱ wa̱ A̱sulazuva,&gt;&gt;</para>
  <para style="q1" vid="JER 8:8">agba a̱ yi ɗa nda,</para>
  <para style="q2" vid="JER 8:8">agita a za vi iɗana</para>
  <para style="q2" vid="JER 8:8">a ɗanasa epen?<verse eid="JER 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 8:9" />&lt;&lt;A ta ca a̱za̱ o ugbozu wono,</para>
  <para style="q2" vid="JER 8:9">a ta dada'wan reve e reme le,</para>
  <para style="q1" vid="JER 8:9">na wo o'woi a 'yuwain</para>
  <para style="q2" vid="JER 8:9">adanshi a̱ A̱sulazuva,</para>
  <para style="q1" vid="JER 8:9">gogo cu'un vu ugbozu</para>
  <para style="q2" vid="JER 8:9">u ne u ɗa a̱ ri na̱ yi?<verse eid="JER 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 8:10" />Adama o ndolo n ta ca</para>
  <para style="q2" vid="JER 8:10">ozo o ro a̱ma̱ci e le,</para>
  <para style="q1" vid="JER 8:10">a̱ɗuma̱ le waru uba̱ta̱ wa aza na</para>
  <para style="q2" vid="JER 8:10">a lyuwa nle nu uvon,</para>
  <para style="q1" vid="JER 8:10">diga uba̱ta̱ wu za a na la'ai</para>
  <para style="q2" vid="JER 8:10">uka̱la̱mu a̱ tyo a zagbain,</para>
  <para style="q1" vid="JER 8:10">za suru ta zamishi u tsura̱</para>
  <para style="q2" vid="JER 8:10">uda̱shiwu wa̱ a̱bunda̱,</para>
  <para style="q1" vid="JER 8:10">hali fo na ama̱sula̱ na̱ nan ganu,</para>
  <para style="q2" vid="JER 8:10">za suru ta yuwusan ulinga ne epen.&gt;&gt;<verse eid="JER 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 8:11" />O tsu co'wo ta̱ antsu ama a̱ va̱</para>
  <para style="q2" vid="JER 8:11">she damma ili i ro i ɗa shi.</para>
  <para style="q1" vid="JER 8:11">Adansa, &lt;&lt;Nden ma asuvu,</para>
  <para style="q2" vid="JER 8:11">Nden ma asuvu,&gt;&gt;</para>
  <para style="q1" vid="JER 8:11">agba a̱ yi ɗa nda</para>
  <para style="q2" vid="JER 8:11">babu nden ma asuvu. <note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="EZK 13:10">Izk 13:10</ref>.</char></note><verse eid="JER 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 8:12" />&lt;&lt;A ta uwwusa wono</para>
  <para style="q2" vid="JER 8:12">wi ili yi idaba i na a yuwain?</para>
  <para style="q2" vid="JER 8:12">O'o, a̱ ri na̱ wono shi ko ke'en,</para>
  <para style="q1" vid="JER 8:12">agba e reve cine</para>
  <para style="q2" vid="JER 8:12">a̱ ka̱ɗa̱to urewesu shi.</para>
  <para style="q1" vid="JER 8:12">Adama o ndolo a̱ ta̱ riya̱</para>
  <para style="q2" vid="JER 8:12">oɓolo na aza a na a̱ a̱risa̱,</para>
  <para style="q1" vid="JER 8:12">a̱ ta̱ ka̱ɗa̱to le a mantsa</para>
  <para style="q2" vid="JER 8:12">ma na n ca nle oforo,&gt;&gt;</para>
  <para style="qr" vid="JER 8:12">ne ɗa A̱sulazuva a dammai.<verse eid="JER 8:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JER 8:13" />&lt;&lt;N ta usa itana yu ugasa u le,&gt;&gt;</para>
  <para style="qr" vid="JER 8:13">ne ɗa A̱sulazuva a dammai.</para>
  <para style="q1" vid="JER 8:13">Muwun n ina̱bi ma̱a̱ da̱na̱ ɗe ataci'i shi,</para>
  <para style="q2" vid="JER 8:13">a̱ tsura̱ muwun mu ubiri</para>
  <para style="q2" vid="JER 8:13">zuva vu uɗanga shi,</para>
  <para style="q2" vid="JER 8:13">waru a̱vu'un e le a̱ ta̱ 'yewe.</para>
  <para style="q1" vid="JER 8:13">Utsuru u na n ca nle fo</para>
  <para style="q2" vid="JER 8:13">a ta usa le ɗa.<verse eid="JER 8:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JER 8:14" />Reve ama a Yahuda a damma,</para>
  <para style="q2" vid="JER 8:14">&lt;&lt;Nye i zuwai tsu ri pa nden kuci?</para>
  <para style="q2" vid="JER 8:14">Lyawa tsu ɓolotoi tsu sumai</para>
  <para style="q1" vid="JER 8:14">a̱ tyo e ilyuci i na i ri</para>
  <para style="q2" vid="JER 8:14">na̱ ɓaɓu vu ucira tsu kuwa̱i ɗe!</para>
  <para style="q1" vid="JER 8:14">Adama a na a̱ A̱sulazuva A̱sula̱ a̱ tsu</para>
  <para style="q2" vid="JER 8:14">a lyawa tsu ta̱ tsu kuwa̱i,</para>
  <para style="q1" vid="JER 8:14">waru u ca tsu ta̱ mini ma yaza tsu sowo,</para>
  <para style="q2" vid="JER 8:14">adama a na tsu yuwan niyi unusu.<verse eid="JER 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 8:15" />Tsu zuwa ta̱ okolo</para>
  <para style="q2" vid="JER 8:15">a̱ nden ma asuvu</para>
  <para style="q2" vid="JER 8:15">amma babu ili i sa'ani i na i ta̱wa̱i,</para>
  <para style="q1" vid="JER 8:15">a mantsa ma na tsa̱ tsura̱ opocino,</para>
  <para style="q2" vid="JER 8:15">amma she wovon goon!<verse eid="JER 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 8:16" />Diga o upasu wa Dan</para>
  <para style="q2" vid="JER 8:16">a ta uwwusa mesun</para>
  <para style="q2" vid="JER 8:16">me ido yi n'yuwatan,</para>
  <para style="q1" vid="JER 8:16">a mawwa me mesun me ido i i le'e,</para>
  <para style="q2" vid="JER 8:16">iɗa'a suru i jinga̱ɗa̱ ta̱.</para>
  <para style="q1" vid="JER 8:16">A̱ ta̱wa̱ ta̱ adama a lyuwa iɗa'a</para>
  <para style="q2" vid="JER 8:16">oɓolo ni ili i na i ri pe</para>
  <para style="q2" vid="JER 8:16">a̱tsuma̱ a̱ yi suru,</para>
  <para style="q1" vid="JER 8:16">waru a lyuwa lyuci gbai'in nu uvon</para>
  <para style="q2" vid="JER 8:16">oɓolo na aza a na</para>
  <para style="q2" vid="JER 8:16">a̱ ri pe na̱ nden suru.&gt;&gt;<verse eid="JER 8:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="JER 8:17" />A̱vu A̱sulazuva a damma,</para>
  <para style="q2" vid="JER 8:17">&lt;&lt;Ka̱lyuwa̱i, n ta̱ lyunguwa̱a̱ ɗu</para>
  <para style="q1" vid="JER 8:17">ni iyo i tsukono</para>
  <para style="q2" vid="JER 8:17">e memere ma̱ ɗu,</para>
  <para style="q1" vid="JER 8:17">iruku i na a gura geshe shi,</para>
  <para style="q2" vid="JER 8:17">waru a̱ ta̱ a̱ ka̱ɗa̱ ɗu.&gt;&gt;<verse eid="JER 8:17" /></para>
  <para style="s">Irimiya shon ta̱ adama ama a̱ yi</para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 8:18" />&lt;&lt;Za na a casu mu adanshi</para>
  <para style="q2" vid="JER 8:18">a mantsa ma̱ a̱tsumola̱ngu a̱ va̱,</para>
  <para style="q2" vid="JER 8:18">okolo a̱ va̱ a̱ la̱nga̱ ta̱ lon.&gt;&gt;<verse eid="JER 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 8:19" />Vu uwwa mesun ma ama a̱ va̱,</para>
  <para style="q2" vid="JER 8:19">diga e iɗa ya alanga,</para>
  <para style="q1" vid="JER 8:19">&lt;&lt;A̱sulazuva a̱ ri pe Sihiyona shi?</para>
  <para style="q2" vid="JER 8:19">Mogono ma̱ yi ma buwa pe shi?&gt;&gt;</para>
  <para style="b" vid="JER 8:19" />
  <para style="q1" vid="JER 8:19">Reve A̱sulazuva Mogono</para>
  <para style="q2" vid="JER 8:19">ma̱ le ma̱ usu u damma,</para>
  <para style="q1" vid="JER 8:19">&lt;&lt;Adama nye a yuwusaan</para>
  <para style="q2" vid="JER 8:19">a̱ma̱li a̱ a̱ga̱nda̱?</para>
  <para style="q1" vid="JER 8:19">Adama a̱ nye i zuwa numu</para>
  <para style="q2" vid="JER 8:19">n yuwan upan</para>
  <para style="q1" vid="JER 8:19">na yaa yuwusaan musula̱ mo omoci n ro</para>
  <para style="q2" vid="JER 8:19">a̱ga̱nda̱ a na a̱ ri nu urana shi?&gt;&gt;<verse eid="JER 8:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JER 8:20" />Reve Irimiya usu u damma,</para>
  <para style="q2" vid="JER 8:20">&lt;&lt;Mantsa mo ugasa ma̱ ka̱ra̱ ta̱</para>
  <para style="q2" vid="JER 8:20">waru lyushi koto ta̱,</para>
  <para style="q2" vid="JER 8:20">agba hali gogo a wawa tsu shi.&gt;&gt;<verse eid="JER 8:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JER 8:21" />&lt;&lt;Usa̱n u na amatoyin ama a̱ va̱,</para>
  <para style="q2" vid="JER 8:21">wa amaton ta̱ okolo a̱ va̱</para>
  <para style="q1" vid="JER 8:21">n ta̱ a̱tsumola̱ngu,</para>
  <para style="q2" vid="JER 8:21">waru wovon u guza̱ mu ta̱ lon.<verse eid="JER 8:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 8:22" />Na amayun a̱guma̱ a̱ ɗe Giliyadu shi?</para>
  <para style="q2" vid="JER 8:22">Za va̱ a̱guma̱ ɗe shi?</para>
  <para style="q1" vid="JER 8:22">To, nye i zuwai a yuwaayin</para>
  <para style="q2" vid="JER 8:22">antsu ama a̱ va̱ opocino shi?&gt;&gt;<verse eid="JER 8:22" /></para>
  <chapter eid="JER 8" />
  <chapter number="9" style="c" sid="JER 9" />
  <para style="s">A̱tsumola̱ngu a aci a̱ Sihiyona</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="JER 9:1" />&lt;&lt;A̱ shi a damma,</para>
  <para style="q2" vid="JER 9:1">a̱mu na aciya̱va̱</para>
  <para style="q2" vid="JER 9:1">oko'o a̱ mini a ɗa,</para>
  <para style="q1" vid="JER 9:1">esu a̱ va̱ waru iɓula i mini,</para>
  <para style="q2" vid="JER 9:1">n shi ta̱ shon usana na ayin</para>
  <para style="q2" vid="JER 9:1">adama ama a̱ va̱ a na o unai.<verse eid="JER 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 9:2" />O'o, a̱ shi a damma</para>
  <para style="q2" vid="JER 9:2">n ta̱ ɗe a̱tsumona</para>
  <para style="q1" vid="JER 9:2">uba̱ta̱ u na aza</para>
  <para style="q2" vid="JER 9:2">a mmalu a̱ shi a cu'wan,</para>
  <para style="q1" vid="JER 9:2">n she ta̱ a lyawa ama a̱ va̱</para>
  <para style="q2" vid="JER 9:2">n ka̱ra̱ adama n lyawa le,</para>
  <para style="q1" vid="JER 9:2">adama a na suru nle</para>
  <para style="q2" vid="JER 9:2">a̱za̱ a̱ tsipere a ɗa,</para>
  <para style="q1" vid="JER 9:2">iɓolo yaa a ama</para>
  <para style="q2" vid="JER 9:2">o ulambu wa̱ a̱ɓula̱.&gt;&gt;<verse eid="JER 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 9:3" />&lt;&lt;O foɓo ta̱ elentsu e le tsu utan</para>
  <para style="q2" vid="JER 9:3">azama a na e tewin epen,</para>
  <para style="q1" vid="JER 9:3">agba a̱tsuma̱ amayun a ɗa</para>
  <para style="q2" vid="JER 9:3">a̱ tsura̱sa̱ ulyuwu we elime</para>
  <para style="q2" vid="JER 9:3">a̱tsuma̱ e iɗa'a shi.</para>
  <para style="q1" vid="JER 9:3">A̱ tsu 'yon ta̱ diga o unusu u nda</para>
  <para style="q2" vid="JER 9:3">a̱ tyo o unusu u nde'en,</para>
  <para style="q2" vid="JER 9:3">agba e reve mu shi,&gt;&gt;</para>
  <para style="qr" vid="JER 9:3">ne ɗa A̱sulazuva a dammai.<verse eid="JER 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 9:4" />&lt;&lt;Vu yuwan ugbozu</para>
  <para style="q2" vid="JER 9:4">ni i'utsa̱ ya̱ wu,</para>
  <para style="q1" vid="JER 9:4">she vu soɗuwoo mawun</para>
  <para style="q2" vid="JER 9:4">ma̱ a̱na̱wun ma̱ wu</para>
  <para style="q2" vid="JER 9:4">ma̱tsa̱n wan,</para>
  <para style="q1" vid="JER 9:4">adama a na mawun</para>
  <para style="q2" vid="JER 9:4">ma̱ a̱na̱wun suru</para>
  <para style="q2" vid="JER 9:4">za yipalishi ɗa,</para>
  <para style="q1" vid="JER 9:4">i'utsa̱ waru suru</para>
  <para style="q2" vid="JER 9:4">za vu ulungusu wa aala a ɗa.<verse eid="JER 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 9:5" />I'utsa̱ i tsu luluma̱ ta̱ i'utsa̱</para>
  <para style="q2" vid="JER 9:5">agba babu za na</para>
  <para style="q2" vid="JER 9:5">tsu dansa amayun.</para>
  <para style="q1" vid="JER 9:5">O rito ta̱ elentsu e le</para>
  <para style="q2" vid="JER 9:5">mayan me epen,</para>
  <para style="q1" vid="JER 9:5">reve a̱ kuna̱to aciyele</para>
  <para style="q2" vid="JER 9:5">na̱ mayan mo unusu.&gt;&gt;<verse eid="JER 9:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JER 9:6" />&lt;&lt;A̱vu Irimiya, vu ta̱ nden</para>
  <para style="q2" vid="JER 9:6">e memere ma aza a yipalishi,</para>
  <para style="q1" vid="JER 9:6">a̱tsuma̱ a yipalishi i le</para>
  <para style="q2" vid="JER 9:6">a̱ kuɗa̱ ta̱ a na e reve mu,&gt;&gt;</para>
  <para style="qr" vid="JER 9:6">ne ɗa A̱sulazuva a dammai.<verse eid="JER 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JER 9:7" />Adama o ndolo apa ili i na A̱sulazuva</para>
  <para style="q2" vid="JER 9:7">oɓolo a̱ a̱soja a zuva a dammai,</para>
  <para style="q1" vid="JER 9:7">&lt;&lt;Ka̱lyuwa̱i, n ta̱ jeruweto le</para>
  <para style="q2" vid="JER 9:7">reve n lyungwa̱ le,</para>
  <para style="q1" vid="JER 9:7">adama a na, nye ɗa m buwai a yuwan</para>
  <para style="q2" vid="JER 9:7">adama o unusu wa a ama a̱ va̱?&gt;&gt;<verse eid="JER 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 9:8" />&lt;&lt;Elentsu e le iliya i ɗa i tsukono,</para>
  <para style="q2" vid="JER 9:8">u ta dansa epen.</para>
  <para style="q1" vid="JER 9:8">Nu una̱ wa̱ yi u ɗa</para>
  <para style="q2" vid="JER 9:8">u tsu dansaa moron ma̱ nden ma̱ yi</para>
  <para style="q2" vid="JER 9:8">adanshi asuvu nden,</para>
  <para style="q1" vid="JER 9:8">amma a̱tsuma̱ okolo a̱ yi,</para>
  <para style="q2" vid="JER 9:8">maza ma ɗa woo foɓuso yi.&gt;&gt;<verse eid="JER 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 9:9" />Reve A̱sulazuva a damma,</para>
  <para style="q2" vid="JER 9:9">&lt;&lt;Wuntsaa n ca le oforo</para>
  <para style="q2" vid="JER 9:9">adama a nda shi?</para>
  <para style="q1" vid="JER 9:9">Wuntsaa na ma tsupa a aci</para>
  <para style="q2" vid="JER 9:9">a̱ cu'un vu nɗa nda shi?&gt;&gt;<verse eid="JER 9:9" /></para>
  <para style="s">Ishipa ya̱ a̱tsumola̱ngu adama aza a Yahuda</para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 9:10" />&lt;&lt;N ta̱ shon, mo oruwo, adama a nsasan,</para>
  <para style="q2" vid="JER 9:10">a̱vu waru n yuwan a̱tsumola̱ngu</para>
  <para style="q2" vid="JER 9:10">adama o uba̱ta̱ wa alyuna a̱tsumona.</para>
  <para style="q1" vid="JER 9:10">O o'wo ta̱ okongo</para>
  <para style="q2" vid="JER 9:10">waru babu za na tsu kuru pe,</para>
  <para style="q1" vid="JER 9:10">agba a tsu uwwa mesun me inan pe shi,</para>
  <para style="q2" vid="JER 9:10">nnunu n suma ta̱,</para>
  <para style="q2" vid="JER 9:10">inama suru i bete'we ta̱.&gt;&gt;<verse eid="JER 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 9:11" />&lt;&lt;N to o'wo to Urishelima edemu okongo,</para>
  <para style="q2" vid="JER 9:11">uba̱ta̱'a̱ u to o'wo uba̱ta̱</para>
  <para style="q2" vid="JER 9:11">wu nven yi musa̱n yu una.</para>
  <para style="q1" vid="JER 9:11">Waru n ta̱ ka̱mba̱to</para>
  <para style="q2" vid="JER 9:11">ilyuci ya Yahuda o o'wo ofoli,</para>
  <para style="q2" vid="JER 9:11">adama o ndolo babu za na a̱ da̱nu ɗe.&gt;&gt;<verse eid="JER 9:11" /></para>
  <para style="s">Ili i na i zuwai na e ge'eto nɗa'a</para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="JER 9:12" />Reve a̱mu Irimiya n yuwan yeci n damma, &lt;&lt;Vuma ne ɗa ri nu ugbozu wa̱ a̱bunda̱ na waa gura reve ili i nda? Zane ɗa A̱sulazuva a zuwai na waa gura ca ucuɗuwu u nda? Nye i zuwai a̱ lungusa̱i iɗa'a wo o'woi okongo tsa̱ a̱tsumona hali na za a gura ɓatsa pe shi?&gt;&gt;<verse eid="JER 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 9:13" />Reve A̱sulazuva a damma, &lt;&lt;Ili ya nda i fara ta̱ adama a na a lyawai wila̱ u va̱, za na n zuwaa nle a̱ kuru, a yuwaan mu tsutoni ko o toni wila̱ u va̱ shi. <verse eid="JER 9:13" /><verse number="14" style="v" sid="JER 9:14" />Na̱ ne suru, reve a yuwan aciyogbamu, a̱ kuru majiyan mo okolo e le aa yuwusaan Ba'al a̱ga̱nda̱, cine nkaya n le n rito nle.&gt;&gt; <verse eid="JER 9:14" /><verse number="15" style="v" sid="JER 9:15" />Adama o ndolo apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva A̱sula̱ a Isra'ila a dammai. &lt;&lt;Ka̱lyuwa̱i, n ta zuwa ama a nda a lyuwa ilyalya yo okono waru o sowo mini ma yaza. <verse eid="JER 9:15" /><verse number="16" style="v" sid="JER 9:16" />N ta̱ bete'we le a̱tsuma̱ a nɗa, za na e le ko nkaya n le n revei shi, waru n ta gbagba le na̱ matsun me pe'eni, hali she na̱ n kototo le.&gt;&gt;<verse eid="JER 9:16" /></para>
  <para style="s">Ɗewu adama a̱ mesun ma̱ a̱tsumola̱ngu</para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="JER 9:17" />Apa ili i na A̱sulazuva</para>
  <para style="q2" vid="JER 9:17">oɓolo a̱ a̱soja a zuva a dammai,</para>
  <para style="q1" vid="JER 9:17">&lt;&lt;Ka̱lyuwa̱i gogo! Ɗeyi a̱ma̱ci a na a̱ ri</para>
  <para style="q2" vid="JER 9:17">a̱ nden n wiruta̱ a̱ ta̱wa̱,</para>
  <para style="q1" vid="JER 9:17">a̱vu fo i lyunguwa̱a̱ a̱ a̱ma̱ci</para>
  <para style="q2" vid="JER 9:17">a na a gurai mesun a̱ ta̱wa̱.&gt;&gt;<verse eid="JER 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 9:18" />&lt;&lt;Lyawa le a̱ ta̱wa̱ gogo,</para>
  <para style="q2" vid="JER 9:18">adama a yuwan mesun adama a̱ tsu,</para>
  <para style="q1" vid="JER 9:18">hali she ne esu a̱ tsu a shiwan na aɓara</para>
  <para style="q2" vid="JER 9:18">hali a̱ga̱pa̱na̱ a̱ tsu waru e re'we na̱ mini.&gt;&gt;<verse eid="JER 9:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 9:19" />&lt;&lt;A uwwa ta̱ mesun ma̱ a̱tsumola̱ngu</para>
  <para style="q2" vid="JER 9:19">diga Sihiyona,</para>
  <para style="q1" vid="JER 9:19">&lt;O'o! Ka̱lyuwa̱ cine o kototo n tsu!</para>
  <para style="q2" vid="JER 9:19">Ka̱lyuwa̱ ne'e cu'un va̱ a̱ba̱jini</para>
  <para style="q2" vid="JER 9:19">o wono a na tsu sowoi!</para>
  <para style="q1" vid="JER 9:19">Ko na̱ shi tsu ciga tsu 'yuwan</para>
  <para style="q2" vid="JER 9:19">tsu lyawa iɗa'a,</para>
  <para style="q1" vid="JER 9:19">adama a na 'wa tsu</para>
  <para style="q2" vid="JER 9:19">o o'wo ta̱ okongo.&gt; &gt;&gt;<verse eid="JER 9:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JER 9:20" />&lt;&lt;Gogo a̱ɗu a̱ma̱ci,</para>
  <para style="q2" vid="JER 9:20">uwwai adanshi a̱ A̱sulazuva,</para>
  <para style="q2" vid="JER 9:20">i polo atsuvu e idanshi yu una̱ ya̱ yi.</para>
  <para style="q1" vid="JER 9:20">I rito muwun me esheli n ɗu</para>
  <para style="q2" vid="JER 9:20">mesun mo a̱tsumola̱ngu</para>
  <para style="q1" vid="JER 9:20">za suru rito moron ma̱ nden ma̱ yi,</para>
  <para style="q2" vid="JER 9:20">ishipa ya̱a̱ a̱tsumola̱ngu.<verse eid="JER 9:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 9:21" />Ukwa̱ u gawan ta̱ a̱ tyo</para>
  <para style="q2" vid="JER 9:21">uba̱ta̱ wu usowoto wu upepu u tsu,</para>
  <para style="q1" vid="JER 9:21">hali u uwa a̱ ba̱ta̱ vu ucira tsu wu una</para>
  <para style="q2" vid="JER 9:21">muwun diga a̱tsuma̱ a̱ re,</para>
  <para style="q1" vid="JER 9:21">waru wu una ta̱ muwun mo olobo</para>
  <para style="q2" vid="JER 9:21">diga a̱tsuma̱ agalaci a̱ lyuci.&gt;&gt;<verse eid="JER 9:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 9:22" />Vu damma,</para>
  <para style="q2" vid="JER 9:22">&lt;&lt;Apa ili i na A̱sulazuva a dammai,</para>
  <para style="q2" vid="JER 9:22">&lt;a̱kwa̱kwa̱ a̱ lipu a ama o to oco</para>
  <para style="q2" vid="JER 9:22">tse everi a agalaci,</para>
  <para style="q1" vid="JER 9:22">tsa̱ moɓolo me ishina</para>
  <para style="q2" vid="JER 9:22">na za vu ugasa kotoi kya'an,</para>
  <para style="q2" vid="JER 9:22">waru za lo na wo ɓoloto le shi.&gt; &gt;&gt;<verse eid="JER 9:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="JER 9:23" />Apa ili i na A̱sulazuva a dammai,</para>
  <para style="q2" vid="JER 9:23">&lt;&lt;She za vu ugbozu yuwan</para>
  <para style="q2" vid="JER 9:23">uvaɗu nu ugbozu wa̱ yi wan,</para>
  <para style="q1" vid="JER 9:23">ko za na ri nu ucira yuwan</para>
  <para style="q2" vid="JER 9:23">uvaɗu nu ucira wa̱ yi wan,</para>
  <para style="q1" vid="JER 9:23">ko za vu utsuru yuwan</para>
  <para style="q2" vid="JER 9:23">uvaɗu nu utsuru wa̱ yi wan,<verse eid="JER 9:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 9:24" />amma lyawa za na</para>
  <para style="q2" vid="JER 9:24">cigai na wa yuwan uvaɗu</para>
  <para style="q2" vid="JER 9:24">u yuwan uvaɗu e ili ya nda,<note caller="-" style="x"><char style="xo" closed="false">9:24 </char><char style="xt" closed="false"><ref loc="1CO 1:31">1 Kor 1:31</ref>; <ref loc="2CO 10:17">2 Kor 10:17</ref>.</char></note></para>
  <para style="q1" vid="JER 9:24">a na u ri nu ugbozu waru u reve numu,</para>
  <para style="q2" vid="JER 9:24">a na a̱mu ɗa A̱sulazuva,</para>
  <para style="q1" vid="JER 9:24">za na tsu roco isa'ani na amayun,</para>
  <para style="q2" vid="JER 9:24">oɓolo na̱ a̱ɓula̱ a̱tsuma̱ o uvaɗi,</para>
  <para style="q1" vid="JER 9:24">adama a na a̱ cu'un vi ili i ndolo i ɗa</para>
  <para style="q2" vid="JER 9:24">n tsu uwwusa uyo'o,</para>
  <para style="qr" vid="JER 9:24">ne ɗa A̱sulazuva a dammai.&gt;&gt;<verse eid="JER 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 9:25" />&lt;&lt;Gogo rana ta̱ lo a̱ ta̱wa̱,&gt;&gt; ne ɗa A̱sulazuva a dammai, &lt;&lt;ana ma̱a̱ ge'eto aza a na a paɗai uryumbu u lipu goon suru, <verse eid="JER 9:25" /><verse number="26" style="v" sid="JER 9:26" />aza a Masar na aza a Yahuda na̱ a̱za̱ a̱ Edom na aza a Amon na̱ a̱za̱ a̱ Mowa na aza a na a̱ ri nden o upasu wa̱ a̱tsumona, aza a na a̱ ri e iɗa ya alanga. Adama a na nɗa nda suru a̱za̱ o ulambu wa̱ a̱ɓula̱ a ɗa, hali fo nu u'wa wa Isra'ila suru a̱za̱ o ulambu wa̱ a̱ɓula̱ o okolo a ɗa.&gt;&gt;<verse eid="JER 9:26" /></para>
  <chapter eid="JER 9" />
  <chapter number="10" style="c" sid="JER 10" />
  <para style="s">A̱sula̱ a wuma na̱ a̱ma̱li</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 10:1" />&lt;&lt;Uwwa adanshi a na A̱sulazuva a damma nuwu, a̱vu u'wa wa Isra'ila.<verse eid="JER 10:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="JER 10:2" />&lt;&lt;Apa ili i na A̱sulazuva a dammai,</para>
  <para style="q2" vid="JER 10:2">&lt;She i rito re vu nɗa n ro wan,</para>
  <para style="q1" vid="JER 10:2">ko yu uwwa wovon</para>
  <para style="q2" vid="JER 10:2">wi iroci ya zuva wan,</para>
  <para style="q1" vid="JER 10:2">ko na wo o'woi nɗa</para>
  <para style="q2" vid="JER 10:2">n ta uwwusa wovon u le.<verse eid="JER 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 10:3" />Adama a na agadu</para>
  <para style="q2" vid="JER 10:3">a ama'a ili ya̱ pere i ɗa,</para>
  <para style="q1" vid="JER 10:3">o tsu koɗo ta̱ ɗanga diga a̱a̱rumbu,</para>
  <para style="q2" vid="JER 10:3">reve she'ein she'en yi na̱ meshe'en.<verse eid="JER 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 10:4" />A tsu sura yi ta̱ na̱ azurufa na̱ zinariya,</para>
  <para style="q2" vid="JER 10:4">reve a̱ shuwa̱ ɗanga'a</para>
  <para style="q2" vid="JER 10:4">na̱ ma̱ka̱ta̱ ni ikusa</para>
  <para style="q2" vid="JER 10:4">tsura̱ u riya̱ wan.&gt; &gt;&gt;<verse eid="JER 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 10:5" />&lt;&lt;A̱ma̱li e le o ndolo a̱ ta̱</para>
  <para style="q2" vid="JER 10:5">tsi iroci yi ili i wovon</para>
  <para style="q2" vid="JER 10:5">o uɗuma̱ wo oɗyoryo,</para>
  <para style="q1" vid="JER 10:5">waru a tsu gura</para>
  <para style="q2" vid="JER 10:5">yuwan adanshi shi,</para>
  <para style="q1" vid="JER 10:5">ko na 'yuwan a ciga</para>
  <para style="q2" vid="JER 10:5">usheɗu u ɗa a̱ tsu sheɗe le</para>
  <para style="q2" vid="JER 10:5">adama a na a tsu gura wala shi.</para>
  <para style="q1" vid="JER 10:5">She yu uwwa wovon u le wan,</para>
  <para style="q2" vid="JER 10:5">adama a na a̱ ri nu ucira</para>
  <para style="q2" vid="JER 10:5">u na a yuwan iwuya shi,</para>
  <para style="q1" vid="JER 10:5">waru a̱ ri nu ucira</para>
  <para style="q2" vid="JER 10:5">u na a yuwan isa'ani fo shi.&gt;&gt;<verse eid="JER 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 10:6" />&lt;&lt;A̱sulazuva za lo tsa̱ wu shi!</para>
  <para style="q2" vid="JER 10:6">A̱vu zagbain ɗa,</para>
  <para style="q1" vid="JER 10:6">Ala a̱ wu a̱ ta̱ na̱</para>
  <para style="q2" vid="JER 10:6">tsugbain nu ucira lon.<verse eid="JER 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 10:7" />Zane ɗa a ca wu tsugbain shi,</para>
  <para style="q2" vid="JER 10:7">a̱vu mogono ma nɗa?<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="REV 15:4">Wen 15:4</ref>.</char></note></para>
  <para style="q1" vid="JER 10:7">Na amayun vu ntsaa ta̱</para>
  <para style="q2" vid="JER 10:7">a uwwa wovon wa̱ wu.</para>
  <para style="q1" vid="JER 10:7">A̱tsuma̱ aza a na a la'ai</para>
  <para style="q2" vid="JER 10:7">ugbozu a̱tsuma̱ a nɗa,</para>
  <para style="q2" vid="JER 10:7">na̱ a̱tsuma̱ o tsugono tsa̱ le suru,</para>
  <para style="q2" vid="JER 10:7">za lo tsa̱ wu shi.<verse eid="JER 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 10:8" />Ele a̱za̱ o ulambu</para>
  <para style="q2" vid="JER 10:8">wu ugbozu a ɗa, waru olo,</para>
  <para style="q1" vid="JER 10:8">a̱ma̱li a ɗanga</para>
  <para style="q2" vid="JER 10:8">e pere a ɗa o ritosu le.<verse eid="JER 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 10:9" />A̱ tsu ta̱wa̱ ta̱ nu uruma</para>
  <para style="q2" vid="JER 10:9">u azurufa diga Tarshishi</para>
  <para style="q2" vid="JER 10:9">na̱ zinariya diga Ufaz.</para>
  <para style="q1" vid="JER 10:9">Ili i na maruma,</para>
  <para style="q2" vid="JER 10:9">na̱ za vu ulinga</para>
  <para style="q2" vid="JER 10:9">u zinariya u yuwain,</para>
  <para style="q1" vid="JER 10:9">a̱vu o oto le mutugu n da̱nda̱n</para>
  <para style="q2" vid="JER 10:9">na̱ mini ma̱ ma̱ɗiya̱,</para>
  <para style="q2" vid="JER 10:9">suru le ulinga wu za vu uɗava ɗa.<verse eid="JER 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 10:10" />Amma A̱sulazuva a ɗa A̱sula̱ amayun.</para>
  <para style="q2" vid="JER 10:10">A̱yi ɗa A̱sula̱ a wuma,</para>
  <para style="q2" vid="JER 10:10">Mogono ma na ma̱ ri nu ukosu shi.</para>
  <para style="q1" vid="JER 10:10">Nna̱ u yuwan upan</para>
  <para style="q2" vid="JER 10:10">uvaɗi u tsu jinga̱ɗa̱ ta̱,</para>
  <para style="q1" vid="JER 10:10">waru nɗa maa gura</para>
  <para style="q2" vid="JER 10:10">kaɓa asuvu nu upan wa̱ shi.&gt;&gt;<verse eid="JER 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 10:11" />Apa ili i na vaa damma le, &lt;&lt;Musula̱ nda aza a na a yuwain zuva ni iɗa i ɗa shi, a̱ ta̱ puwa̱a̱n diga o uvaɗi na̱ diga za̱la̱ va zuva. &gt;&gt;<verse eid="JER 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JER 10:12" />&lt;&lt;Amma A̱sula̱ a ɗa</para>
  <para style="q2" vid="JER 10:12">a yuwain uvaɗi nu ucira wa̱ yi,</para>
  <para style="q1" vid="JER 10:12">za na shuwa̱i uvaɗi</para>
  <para style="q2" vid="JER 10:12">o una̱ wu ugbozu wa̱ yi,</para>
  <para style="q1" vid="JER 10:12">reve u polo zuva</para>
  <para style="q2" vid="JER 10:12">o una̱ wu urevu wa̱ yi.<verse eid="JER 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 10:13" />A mantsa ma na u yuwain tsata,</para>
  <para style="q2" vid="JER 10:13">mini ma zuva ma̱ tsu gugwa̱ ta̱.</para>
  <para style="q1" vid="JER 10:13">U tsu zuwa ta̱ eleshe 'yon</para>
  <para style="q2" vid="JER 10:13">diga o ukosu wu uvaɗi,</para>
  <para style="q1" vid="JER 10:13">u tsu lyungu ta̱ fo</para>
  <para style="q2" vid="JER 10:13">ni imaɗatsu ni iro'i,</para>
  <para style="q1" vid="JER 10:13">waru u tsu uta̱a̱ ta̱ upepu</para>
  <para style="q2" vid="JER 10:13">diga o u'wa wi izuwa ya̱ yi.<note caller="-" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="PSA 135:7">Ica 135:7</ref>.</char></note><verse eid="JER 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 10:14" />Za suru ri na aci shi,</para>
  <para style="q2" vid="JER 10:14">waru babu ugbozu.</para>
  <para style="q1" vid="JER 10:14">Za vu ulinga u zinariya suru</para>
  <para style="q2" vid="JER 10:14">u ta uwwa wono adama a̱ma̱li a̱ yi,</para>
  <para style="q1" vid="JER 10:14">iroci ya̱ yi suru a̱ma̱li a ɗa,</para>
  <para style="q2" vid="JER 10:14">a̱ ri nu wivuwun a̱tsuma̱ e le shi.<verse eid="JER 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 10:15" />Ele ili ye pere i ɗa,</para>
  <para style="q2" vid="JER 10:15">ili yi izo'oshi,</para>
  <para style="q1" vid="JER 10:15">na̱ mantsa mo oforo le ta̱wa̱</para>
  <para style="q2" vid="JER 10:15">o to kototo le.<verse eid="JER 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 10:16" />Adama a na A̱sula̱,</para>
  <para style="q2" vid="JER 10:16">za na wo o'woi akunda a Yakubu</para>
  <para style="q2" vid="JER 10:16">a̱ ri tsunda shi,</para>
  <para style="q1" vid="JER 10:16">adama a na a̱ yi ɗa</para>
  <para style="q2" vid="JER 10:16">za na yuwain ili suru,</para>
  <para style="q1" vid="JER 10:16">oɓolo na̱ Isra'ila ugundo</para>
  <para style="q2" vid="JER 10:16">we elentsu agadu a̱ yi,</para>
  <para style="q1" vid="JER 10:16">waru ala a̱ yi ɗa,</para>
  <para style="q2" vid="JER 10:16">a̱ A̱sulazuva oɓolo a̱ a̱soja a zuva.&gt;&gt;<verse eid="JER 10:16" /></para>
  <para style="s">Ukototosu u na u ri lo a̱a̱ ta̱wa̱</para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="JER 10:17" />&lt;&lt;Ɓolotoi itana i ɗu,</para>
  <para style="q2" vid="JER 10:17">adama i lyawa lyuci'i,</para>
  <para style="q1" vid="JER 10:17">a̱ɗu na i ri nden uba̱ta̱ u na</para>
  <para style="q2" vid="JER 10:17">a̱ ka̱nda̱ruwa̱i nu uvon.&gt;&gt;<verse eid="JER 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 10:18" />Adama a na apa</para>
  <para style="q2" vid="JER 10:18">ili i na A̱sulazuva a dammai,</para>
  <para style="q1" vid="JER 10:18">&lt;&lt;A mantsa ma nda</para>
  <para style="q2" vid="JER 10:18">n ta̱ vuta̱la̱ n vari</para>
  <para style="q1" vid="JER 10:18">aza a na a̱ ri pe na̱ nden</para>
  <para style="q2" vid="JER 10:18">a̱tsuma̱ e iɗa i nda,</para>
  <para style="q1" vid="JER 10:18">n ta̱ ta̱wa̱a̱ le na̱ a̱tsuma̱lima̱</para>
  <para style="q2" vid="JER 10:18">adama a̱ tsura̱ e reme le.&gt;&gt;<verse eid="JER 10:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JER 10:19" />A̱vu ama a̱ Urishelima a damma,</para>
  <para style="q2" vid="JER 10:19">&lt;&lt;A̱tsuma̱lima̱ a cina mu ta̱</para>
  <para style="q2" vid="JER 10:19">adama a̱ wufuru u va̱!</para>
  <para style="q1" vid="JER 10:19">Usa̱n u va̱ za na</para>
  <para style="q2" vid="JER 10:19">a̱ ka̱mba̱ gbaga ɗa shi!&gt;&gt;</para>
  <para style="q1" vid="JER 10:19">Na̱ ne suru n damma ta̱ aciya̱va̱,</para>
  <para style="q2" vid="JER 10:19">&lt;&lt;Mɓa̱la̱ n va̱ n ɗa,</para>
  <para style="q1" vid="JER 10:19">waru ko n 'yuwan n ciga</para>
  <para style="q2" vid="JER 10:19">n kaɓa asuvu na̱ yi.&gt;&gt;<verse eid="JER 10:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 10:20" />&lt;&lt;A̱ lungusa̱ ta̱ oogodo a̱ va̱,</para>
  <para style="q2" vid="JER 10:20">a taɓa ta̱ amunga a̱ yi suru,</para>
  <para style="q1" vid="JER 10:20">muwun mo olobo n va̱</para>
  <para style="q2" vid="JER 10:20">mu kasa ta̱ na̱ mu</para>
  <para style="q2" vid="JER 10:20">waru a buwa lo shi,</para>
  <para style="q1" vid="JER 10:20">babu za na buwai lo</para>
  <para style="q2" vid="JER 10:20">na̱ a̱ shuwisa̱ oogodo a̱ va̱,</para>
  <para style="q1" vid="JER 10:20">ko u sakato umuna</para>
  <para style="q2" vid="JER 10:20">wo oogodo a̱ va̱.<verse eid="JER 10:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 10:21" />Adama a na aza aguɓa'a</para>
  <para style="q2" vid="JER 10:21">a̱ ri na aci shi,</para>
  <para style="q2" vid="JER 10:21">waru a tsu pati A̱sulazuva shi.</para>
  <para style="q1" vid="JER 10:21">Adama o ndolo a̱ tsura̱</para>
  <para style="q2" vid="JER 10:21">ulyuwu we elime shi,</para>
  <para style="q2" vid="JER 10:21">waru e bete'we ta̱ ikyon i le suru.<verse eid="JER 10:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 10:22" />Uwwai ne'e!</para>
  <para style="q2" vid="JER 10:22">Alabari a̱ ta̱ lo a̱ ta̱wa̱,</para>
  <para style="q1" vid="JER 10:22">a̱ba̱jini o u'ya̱susa̱n wu ugbozu</para>
  <para style="q2" vid="JER 10:22">diga o upasu wi iɗa yu ugana!</para>
  <para style="q1" vid="JER 10:22">U ta̱ ka̱mba̱to ilyuci ya Yahuda okongo,</para>
  <para style="q2" vid="JER 10:22">uba̱ta̱ wu nden m musa̱n yu una.&gt;&gt;<verse eid="JER 10:22" /></para>
  <para style="s">Avasa a̱ Irimiya</para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 10:23" />&lt;&lt;A̱sulazuva, n reve ta̱,</para>
  <para style="q2" vid="JER 10:23">a na wuma u vuma</para>
  <para style="q2" vid="JER 10:23">u ri o ukere wa̱ yi shi,</para>
  <para style="q1" vid="JER 10:23">vuma ɗa ri nu ucira u na</para>
  <para style="q2" vid="JER 10:23">wa walato mmalu ma̱ yi shi.<verse eid="JER 10:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 10:24" />Zuwa mu n kira, A̱sulazuva,</para>
  <para style="q2" vid="JER 10:24">a̱tsuma̱ o ure wa̱ a̱ɓula̱,</para>
  <para style="q1" vid="JER 10:24">amma a̱tsuma̱ o upan wa̱ wu shi,</para>
  <para style="q2" vid="JER 10:24">adama ta̱wa̱ vu kototo mu wan.<verse eid="JER 10:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 10:25" />Tsun upan wa̱ wu a aci a nɗa</para>
  <para style="q2" vid="JER 10:25">nna n reve nuwu shi,</para>
  <para style="q1" vid="JER 10:25">e ekere a ama a na</para>
  <para style="q2" vid="JER 10:25">e ɗesu ala a̱ wu shi,</para>
  <para style="q1" vid="JER 10:25">adama a na o kototo ta̱</para>
  <para style="q2" vid="JER 10:25">ugundo wa Yakubu,</para>
  <para style="q1" vid="JER 10:25">a lyuwa yi ta̱ kpa̱ra̱a̱,</para>
  <para style="q2" vid="JER 10:25">reve o kototo uba̱ta̱ wu nda̱na̱ta̱ ma̱ yi.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">10:25 </char><char style="xt" closed="false"><ref loc="PSA 79:6-7">Ica 79:6-7</ref>.</char></note><verse eid="JER 10:25" /></para>
  <chapter eid="JER 10" />
  <chapter number="11" style="c" sid="JER 11" />
  <para style="s">A kuɗa ta̱ Nzuwulai</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 11:1" />Apa adanshi a na A̱sulazuva a yuwayin Irimiya, ana, <verse eid="JER 11:1" /><verse number="2" style="v" sid="JER 11:2" />&lt;&lt;Vu polo atsuvu e idanshi ya akucunu a nda, reve vu damma ama a Yahuda na aza a na a̱ ri na̱ nden a̱tsuma̱ a̱ Urishelima. <verse eid="JER 11:2" /><verse number="3" style="v" sid="JER 11:3" />Vu damma le, apa ili i na A̱sulazuva, A̱sula̱ a Isra'ila a dammai, una̱ u ta̱ reme za na kuɗa̱i a yuwan tsutoni ni idanshi ya akucunu a nda. <verse eid="JER 11:3" /><verse number="4" style="v" sid="JER 11:4" />Nzuwulai nna n yuwain na̱ nkaya nɗu a mantsa ma na mu uta̱a̱ nle diga e iɗa ya Masar, diga a̱tsuma̱ o usuɗuwu wu usa̱n u tsugbashi o ndolo tsa akina o uruma. A̱vu vu damma le, &lt;A yuwan tsutoni na adanshi a̱ va̱, a yuwan suru ili na n damma n le. Na̱ tsundolo tsa ɗa o o'wo ama a̱ va̱, a̱vu mo o'wo A̱sula̱ a̱ ɗu.&gt; &gt;&gt; <verse eid="JER 11:4" /><verse number="5" style="v" sid="JER 11:5" />Ɗaɗa moo shiton akucunu a na n yuwayin nkaya n ɗu, na maa ca le iɗa i na yee yeneshe maani ni ishiki, iɗa i na i tarai ana'an.</para>
  <para style="p" vid="JER 11:5">Reve n usu, &lt;&lt;Lyawa wo o'wo ne A̱sulazuva.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="DEU 27:15-26">U.Wl 27:15-26</ref>.</char></note><verse eid="JER 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 11:6" />A̱vu A̱sulazuva a damma mu, &lt;&lt;Vu yuwan adanshi a nda suru a̱tsuma̱ e ilyuci ya Yahuda na̱ a̱tsuma̱ e re va̱ Urishelima. Vu damma le, o polo atsuvu e idanshi ya akucunu o ndolo a̱vu a̱ kuru le, <verse eid="JER 11:6" /><verse number="7" style="v" sid="JER 11:7" />adama a na a mantsa ma na mu uta̱yi nkaya n ɗu diga e iɗa ya Masar hali a̱ tyo ana'an, n rono le ta̱ atsuvu lon adansa, i yuwaan mu tsutoni. <verse eid="JER 11:7" /><verse number="8" style="v" sid="JER 11:8" />Na̱ ne suru a uwwa ko o poloo mu atsuvu shi, o una̱ u ndolo reve a̱ kuru aciyogbamu o okolo e iwuya i le. Ɗaɗa ma̱a̱ ta̱wa̱a̱ le nu una̱ u na u ri a aci a nzuwulai n ndolo suru, na n damma nle a̱ kuru, agba a̱ kuru shi.&gt;&gt;<verse eid="JER 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 11:9" />Reve A̱sulazuva a damma mu, &lt;&lt;N gura ta̱ reve a na a̱ tsura̱i uɓolu wu una̱ a̱tsuma̱ e ilyuci i na i ri a̱tsuma̱ a Yahuda na aza a na a̱ ri nden a̱tsuma̱ a̱ Urishelima. <verse eid="JER 11:9" /><verse number="10" style="v" sid="JER 11:10" />A vadala ta̱ a̱ ka̱mba̱ ba̱ta̱ a̱ nusu vu nkaya nle, aza a na a 'yuwain a uwwa adanshi a̱ va̱. A̱ kuru ta̱ musula̱ n ro aa yuwusaan le a̱ga̱nda̱. U'wa wa Isra'ila oɓolo nu u'wa wa Yahuda a kuɗa ta̱ akucunu a na n yuwain na̱ nkaya nle. <verse eid="JER 11:10" /><verse number="11" style="v" sid="JER 11:11" />Adama o ndolo apa ili i na A̱sulazuva a dammai, &lt;N ta̱ ta̱wa̱a̱ le na̱ a̱tsuma̱lima̱ a na a la'a shi. Ko na̱ e showen numu moo poloo le atsuvu shi.&gt; &gt;&gt; <verse eid="JER 11:11" /><verse number="12" style="v" sid="JER 11:12" />&lt;&lt;Ɗaɗa ilyuci i na i ri a̱tsuma̱ a Yahuda na ama a̱ Urishelima a̱a̱ 'ya̱wa̱ e showen musula̱ n na a̱a̱ kula̱tosa̱a̱ a̱tsuka̱, agba aa wawa le shi ko ke'en a mantsa ma na addama'a a̱a̱ ta̱wa̱. <verse eid="JER 11:12" /><verse number="13" style="v" sid="JER 11:13" />A̱vu Yahuda, vu ta̱ na̱ musula̱ a̱bunda̱ cine vu revei ilyuci ya̱ wu, waru musa'a n na i varai adama i kula̱tosa̱a̱ ma̱sula̱ mo o ulambu u wono u ndolo Ba'al a̱tsuka̱, a rawa ta̱ a̱bunda̱ e re va̱ Urishelima.&gt;&gt;<verse eid="JER 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 11:14" />Reve A̱sulazuva a damma Irimiya, &lt;&lt;She vu yuwaan ama a nda avasa wan, ko vu yuwan ipati i ro adama e le wan, adama a na moo poloo le atsuvu shi a mantsa ma na e ɗeyi a̱ tyo ya̱'a̱ va̱, adama a̱ a̱tsuma̱lima̱ e le.&gt;&gt;<verse eid="JER 11:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JER 11:15" />&lt;&lt;Zane ca nuwu ucira,</para>
  <para style="q2" vid="JER 11:15">a̱vu macigata ma̱ va̱ Yahuda,</para>
  <para style="q2" vid="JER 11:15">na vu ta̱wa̱i a̱tsuma̱ a̱ A̱a̱'isamapaɗa a̱ va̱,</para>
  <para style="q1" vid="JER 11:15">na vaa yuwusan ifoɓi iwuya</para>
  <para style="q2" vid="JER 11:15">oɓolo na ama a̱ a̱bunda̱?</para>
  <para style="q1" vid="JER 11:15">Vu ta yuwusan ma̱za̱nga̱ a mantsa</para>
  <para style="q2" vid="JER 11:15">ma na vaa yuwusan iwuya.</para>
  <para style="q1" vid="JER 11:15">A̱ yene ya̱ wu,</para>
  <para style="q2" vid="JER 11:15">nama na vu cayi kucci</para>
  <para style="q2" vid="JER 11:15">u ta gura tawa oforo a̱ wu ɗa?&gt;&gt;<verse eid="JER 11:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 11:16" />&lt;&lt;A̱sulazuva e ɗe wu ta̱,</para>
  <para style="q2" vid="JER 11:16">uɗanga u zetun u na u ri nu ululu</para>
  <para style="q1" vid="JER 11:16">wu ulobonu wa̱ a̱ka̱nla̱,</para>
  <para style="q2" vid="JER 11:16">u na u ri na̱ muwun n sa'ani.</para>
  <para style="q1" vid="JER 11:16">Amma na̱ ma̱gugwa̱</para>
  <para style="q2" vid="JER 11:16">ma̱ wunla̱ ma gbain ma ɗa</para>
  <para style="q2" vid="JER 11:16">wa zuwa yi akina,</para>
  <para style="q2" vid="JER 11:16">a̱vu ete'en a̱ yi a kuɗa.&gt;&gt;<verse eid="JER 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 11:17" />&lt;&lt;A̱mu A̱sulazuva A̱sula̱ o oɓolo a̱ a̱soja a zuva za na shuwa̱ nɗu, m paɗa ta̱ a̱sa̱la̱ a na meleshe ma̱ cipa̱a̱ ɗu, adama e iwuya i na i yuwain, a̱ɗu u'wa wa Isra'ila na̱ Yahuda. Adama a na i zuwa mu ta̱ n yuwan upan, adama a na i kula̱towa̱a̱ ta̱ Ba'al aturare a̱ ma̱guru.&gt;&gt;<verse eid="JER 11:17" /></para>
  <para style="s">Uɓolu wu una̱ adama o una Irimiya</para>
  <para style="p">
    <verse number="18" style="v" sid="JER 11:18" />&lt;&lt;A̱sulazuva a̱ revetyo mu ta̱ ifoɓi i le, waru n reve ta̱, adama a na a mantsa ma nda u roco mu ta̱ ili i na a yuwusan. <verse eid="JER 11:18" /><verse number="19" style="v" sid="JER 11:19" />Moo o'wo ta̱ tsa̱ mokyokyon ma na ma̱ ri na̱ nla̱ngi shi, za na a tarai a̱ 'ya̱wa̱ uba̱ta̱ u na a paɗa, n shi reve, ashe aci a̱ va̱ a ɗa oo ɓoloso una̱ adansa,</para>
  <para style="b" vid="JER 11:19" />
  <para style="q1" vid="JER 11:19">&lt;&lt;Lyawa tsu kototoi uɗanga'a</para>
  <para style="q2" vid="JER 11:19">na̱ muwun ma̱ yi suru,</para>
  <para style="q1" vid="JER 11:19">lyawa tsu tawa niyi</para>
  <para style="q2" vid="JER 11:19">diga o uvaɗi wa aza a wuma,</para>
  <para style="q1" vid="JER 11:19">hali na a̱ da̱shi cuwan</para>
  <para style="q2" vid="JER 11:19">na aala a̱yi shi.&gt;&gt;<verse eid="JER 11:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 11:20" />&lt;&lt;Amma a̱vu, A̱sulazuva A̱sula̱</para>
  <para style="q2" vid="JER 11:20">o oɓolo a̱ a̱soja a zuva,</para>
  <para style="q1" vid="JER 11:20">a̱vu ɗa za vu uge'etosu wa amayun,</para>
  <para style="q2" vid="JER 11:20">a̱vu ɗa za na tsu petelyuwe</para>
  <para style="q2" vid="JER 11:20">okolo na̱ majiyan ma vuma.</para>
  <para style="q1" vid="JER 11:20">Lyawa me ene atsupu a̱ wu</para>
  <para style="q2" vid="JER 11:20">adama a̱ va̱ aci e le,</para>
  <para style="q1" vid="JER 11:20">adama a na ya̱ a̱ wu ɗa</para>
  <para style="q2" vid="JER 11:20">n ta̱wa̱yi na̱ mesun ma̱ va̱.&gt;&gt;<verse eid="JER 11:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="JER 11:21" />Adama o ndolo apa ili i na A̱sulazuva A̱sula̱ o oɓolo a̱ a̱soja a zuva a dammai, adama o uɓolu wu una̱ u na ama a Anatot aa yuwusan, aza a na a zama o una mu. A ta dansa, &lt;&lt;She vu yuwan adanshi e ikaka ya̱ A̱sula̱ na aala A̱sulazuva wan. Nna̱ vu yuwan, ne ekere a̱ tsu ɗa tsoo una wu.&gt;&gt; <verse eid="JER 11:21" /><verse number="22" style="v" sid="JER 11:22" />Adama o ndolo apa ili i na A̱sulazuva A̱sula̱ o oɓolo a̱ a̱soja a zuva a dammai, &lt;&lt;N ta ca le oforo. Olobo le a̱ ta̱ kuwa̱ o ure u matsun me pe'eni, muwun molobo na̱ esheli le ambulu a ɗa o una le. <verse eid="JER 11:22" /><verse number="23" style="v" sid="JER 11:23" />Ko vuma ta̱ a lyawa shi. Adama a na n ta̱ ta̱wa̱a̱ a ama a Anatot na̱ meleshe aa'wan a na a ca le oforo.&gt;&gt;<verse eid="JER 11:23" /></para>
  <chapter eid="JER 11" />
  <chapter number="12" style="c" sid="JER 12" />
  <para style="s">Yeci i na Irimiya yuwain A̱sulazuva</para>
  <para style="q1">
    <verse number="1" style="v" sid="JER 12:1" />&lt;&lt;A̱sulazuva, a̱vu za va̱ a̱ɓula̱ ɗa kuci,</para>
  <para style="q2" vid="JER 12:1">a mantsa ma na n ta̱wa̱yi</para>
  <para style="q2" vid="JER 12:1">na adanshi ya̱'a̱ wu.</para>
  <para style="q1" vid="JER 12:1">Na̱ ne suru n ta yuwan adanshi na̱ a̱vu</para>
  <para style="q2" vid="JER 12:1">adama o uge'etosu wa̱ wu.</para>
  <para style="q1" vid="JER 12:1">Nye i zuwai re va̱ a̱za̱ e iwuya a balasa?</para>
  <para style="q2" vid="JER 12:1">Nye i zuwai a̱za̱ o ule'e</para>
  <para style="q2" vid="JER 12:1">a̱ ri a̱ nden n lafiya?<verse eid="JER 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 12:2" />A̱vu ɗa vu shuwa̱ nle tsa ɗanga,</para>
  <para style="q2" vid="JER 12:2">a̱vu a yuwan aralu,</para>
  <para style="q1" vid="JER 12:2">a̱vu a kungwa,</para>
  <para style="q2" vid="JER 12:2">reve a matsan lon,</para>
  <para style="q1" vid="JER 12:2">mantsa suru aala a̱ wu</para>
  <para style="q2" vid="JER 12:2">a̱ ta̱ o una̱ u le,</para>
  <para style="q1" vid="JER 12:2">amma u ta alanga</para>
  <para style="q2" vid="JER 12:2">no okolo e le.<verse eid="JER 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 12:3" />Adama o ndolo vu rono le</para>
  <para style="q2" vid="JER 12:3">tsi ikyon i na aa paɗa!</para>
  <para style="q1" vid="JER 12:3">Vu tawa le,</para>
  <para style="q2" vid="JER 12:3">adama o urana u mapaɗa!&gt;&gt;</para>
  <para style="q1" vid="JER 12:3">Amma a̱mu, A̱sulazuva,</para>
  <para style="q2" vid="JER 12:3">vu reve mu ta̱,</para>
  <para style="q2" vid="JER 12:3">vu ta̱ enishe mu,</para>
  <para style="q1" vid="JER 12:3">vu lyungwa̱ majiyan ma̱ va̱</para>
  <para style="q2" vid="JER 12:3">adama a ɗa a̱ wu.<verse eid="JER 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 12:4" />Hali a cina mantsa ma̱ ne ɗa iɗa'a</para>
  <para style="q2" vid="JER 12:4">yaa yuwan a̱tsuma̱la̱ngu,</para>
  <para style="q2" vid="JER 12:4">anlya a atsusa waru a̱ 'yewe?</para>
  <para style="q1" vid="JER 12:4">Adama e iwuya yaa ama</para>
  <para style="q2" vid="JER 12:4">a na a̱ ri nden iɗa'a,</para>
  <para style="q2" vid="JER 12:4">iliyamunga na̱ nnunu a̱ kuwa̱ ta̱.</para>
  <para style="q1" vid="JER 12:4">Na̱ ne suru, a ama a ta dansa,</para>
  <para style="q2" vid="JER 12:4">&lt;&lt;Waa gura ene ili i na</para>
  <para style="q2" vid="JER 12:4">yaa farasa na̱ tsu shi.&gt;&gt;<verse eid="JER 12:4" /></para>
  <para style="s">U'usuwu wa̱ A̱sulazuva a̱ tyo ya̱ Irimiya.</para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 12:5" />A̱sulazuva a damma ta̱,</para>
  <para style="q2" vid="JER 12:5">&lt;&lt;Nna̱ ala'anlai na ama a na</para>
  <para style="q2" vid="JER 12:5">a̱ ri e ilaɗi a ana,</para>
  <para style="q2" vid="JER 12:5">a ta zuwa wu vu kuna̱,</para>
  <para style="q1" vid="JER 12:5">cine tsa ɗa vaa gura</para>
  <para style="q2" vid="JER 12:5">yuwan ala'anlai ni ido?</para>
  <para style="q1" vid="JER 12:5">Nna̱ vu riya̱ e iɗa i na i ri hawun,</para>
  <para style="q2" vid="JER 12:5">cine tsa ɗa vaa yuwan</para>
  <para style="q1" vid="JER 12:5">na a damma a̱tsuma̱ a awanda</para>
  <para style="q2" vid="JER 12:5">a na a̱ ri zuzu na̱ a̱a̱rumbu a̱ Urudu ɗa?<verse eid="JER 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 12:6" />Agba a̱yi ɗa nda hali</para>
  <para style="q2" vid="JER 12:6">na̱ mmaci ma̱ wu,</para>
  <para style="q2" vid="JER 12:6">na ama o u'wa wa̱ wu,</para>
  <para style="q1" vid="JER 12:6">a vadalaa nuwu ucina̱,</para>
  <para style="q2" vid="JER 12:6">a yisali adama a̱ wu.</para>
  <para style="q1" vid="JER 12:6">She vu soɗuwo le ma̱tsa̱n wan,</para>
  <para style="q2" vid="JER 12:6">ko na aa yuwusan adanshi</para>
  <para style="q2" vid="JER 12:6">a sa'ani a aci a̱ wu.&gt;&gt;<verse eid="JER 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JER 12:7" />Reve A̱sulazuva a damma,</para>
  <para style="q2" vid="JER 12:7">&lt;&lt;N lyawa ta̱ ama a̱ va̱ Isra'ila,</para>
  <para style="q1" vid="JER 12:7">mu kasa ta̱ na ama a̱ va̱</para>
  <para style="q2" vid="JER 12:7">agadu a̱ va̱.</para>
  <para style="q1" vid="JER 12:7">N ta ca za na n cigai</para>
  <para style="q2" vid="JER 12:7">e ekere a n'yuwatan ma̱ yi.<verse eid="JER 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 12:8" />Ama agadu a̱ va̱ o o'wo mu ta̱</para>
  <para style="q2" vid="JER 12:8">tsa kamu a̱tsuma̱ a̱tsumona,</para>
  <para style="q2" vid="JER 12:8">a̱a̱ 'ya̱susa̱n mu uɗyo tsa kamu.</para>
  <para style="q1" vid="JER 12:8">Adama o ndolo a ɗa</para>
  <para style="q2" vid="JER 12:8">n 'yuwan niyi.<verse eid="JER 12:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 12:9" />Ama agadu a̱ va̱</para>
  <para style="q2" vid="JER 12:9">o o'wo mu ta̱ tsa̱ ajimba</para>
  <para style="q1" vid="JER 12:9">lyawa nnunu n na n tsu ka̱ɗa̱ inama</para>
  <para style="q2" vid="JER 12:9">a̱ ka̱nda̱ruwa̱ yi.</para>
  <para style="q1" vid="JER 12:9">'Ya̱wa̱ vu ɓoloto</para>
  <para style="q2" vid="JER 12:9">inama yu una suru,</para>
  <para style="q1" vid="JER 12:9">vu ta̱wa̱to le</para>
  <para style="q2" vid="JER 12:9">adama a tama le.<verse eid="JER 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 12:10" />Aza aguɓa na̱ a̱bunda̱ a̱ lungusa̱ ta̱</para>
  <para style="q2" vid="JER 12:10">uɗuma̱ u inabi u va̱,</para>
  <para style="q2" vid="JER 12:10">a dadasa ta̱ uɗuma̱ u va̱,</para>
  <para style="q1" vid="JER 12:10">a̱ ka̱mbuwa̱ ta̱ uɗuma̱ u sa'ani u va̱</para>
  <para style="q2" vid="JER 12:10">okongo a na a̱ ri nu urana shi.<verse eid="JER 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 12:11" />O to o'wo okongo,</para>
  <para style="q2" vid="JER 12:11">o u'yewu no ofoli elime a̱ va̱,</para>
  <para style="q2" vid="JER 12:11">iɗa'a suru u to o'wo okongo,</para>
  <para style="q1" vid="JER 12:11">adama a na babu</para>
  <para style="q2" vid="JER 12:11">za na ka̱mbuwa̱i ugbozu.<verse eid="JER 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 12:12" />Zuva va agaɗi a̱tsumona a nda</para>
  <para style="q2" vid="JER 12:12">a̱za̱ o ukototosu a̱ ta̱ ta̱wa̱,</para>
  <para style="q1" vid="JER 12:12">adama a na matsun me pe'eni</para>
  <para style="q2" vid="JER 12:12">ma̱ A̱sulazuva ma ta yuwan ukototosu</para>
  <para style="q1" vid="JER 12:12">diga o ukosu wi iɗa</para>
  <para style="q2" vid="JER 12:12">a̱ tyo o ukosu u ro.</para>
  <para style="q1" vid="JER 12:12">Na amayun, babu za na</para>
  <para style="q2" vid="JER 12:12">a̱ da̱nu lafiya.<verse eid="JER 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 12:13" />A̱ ta̱ cu'wan oroci a yitabo,</para>
  <para style="q2" vid="JER 12:13">reve a gasa awanda,</para>
  <para style="q1" vid="JER 12:13">A̱ ta̱ kuna̱to aciyele</para>
  <para style="q2" vid="JER 12:13">agba a̱ tsura̱ iliyinkapa shi.</para>
  <para style="q1" vid="JER 12:13">Adama o ndolo sowoi wono</para>
  <para style="q2" vid="JER 12:13">wi ili i na i gasai,</para>
  <para style="q1" vid="JER 12:13">adama o upan</para>
  <para style="q2" vid="JER 12:13">wu usuɗuwu wa̱ A̱sulazuva.&gt;&gt;<verse eid="JER 12:13" /></para>
  <para style="s">A̱sulazuva a̱ ta̱ ene iliyali ya akapi a nɗa</para>
  <para style="p">
    <verse number="14" style="v" sid="JER 12:14" />Apa ili i na A̱sulazuva a dammai, a aci o nron mu nden n vama ma ama a̱ yi, &lt;&lt;Ama a na a usai agadu a na u cayi ama a̱ yi Isra'ila wa agadu, n ta̱ mula̱ le diga a̱tsuma̱ e iɗa i le, waru n ta̱ mula̱ u'wa wa Yahuda diga a̱tsuma̱ e le. <verse eid="JER 12:14" /><verse number="15" style="v" sid="JER 12:15" />Amma a mantsa ma na m mula̱ nle, n ta̱ da̱shi uwwisa iliyali i le, a̱vu n ka̱mbuwisa̱ koyan uba̱ta̱ waa agadu a̱ yi ni iɗa ya̱ yi. <verse eid="JER 12:15" /><verse number="16" style="v" sid="JER 12:16" />Ɗe nu ufaru a̱ shi ta̱ rito ama a̱ va̱, cine a̱ shi a yuwan akucunu na ala a Ba'al. Amma nna̱ a̱ ka̱mbuwa̱ ugbozu, o rito re wuma wa ama a̱ va̱, a̱vu a yuwan akucunu na ala a̱ va̱ a damma,&lt;N kucina ta̱ na ala A̱sulazuva a na a̱ ri wuma,&gt; To, a̱ ta̱ gba a̱ shuwa̱ le a̱tsuma̱ ama a̱ va̱. <verse eid="JER 12:16" /><verse number="17" style="v" sid="JER 12:17" />Amma nɗa nna suru n 'yuwain a uwwa adanshi a̱ va̱, n ta̱ mula̱ le suru suru avu n kototo le. Ne ɗa A̱sulazuva a dammai.&gt;&gt;<verse eid="JER 12:17" /></para>
  <chapter eid="JER 12" />
  <chapter number="13" style="c" sid="JER 13" />
  <para style="s">Iroci na̱ gbakala vu ukwan</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 13:1" />Reve A̱sulazuva a damma mu, &lt;&lt;Wala vu tsulaa aciya̱wu ukwan, vu yuwan gbakala na̱ yi, agba she vu lyawa u ju'wa̱n mini wan. <verse eid="JER 13:1" /><verse number="2" style="v" sid="JER 13:2" />Reve n tsula yi cine adanshi A̱sulazuva a dammai, a̱vu n yuwan gbakala na̱ yi.&gt;&gt;<verse eid="JER 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 13:3" />A̱vu A̱sulazuva a̱ da̱shi yuwan adanshi na̱ mu, wa̱ ire u damma, <verse eid="JER 13:3" /><verse number="4" style="v" sid="JER 13:4" />&lt;&lt;Vu tara gbakala vu ukwan u na vu tsulai'i, zana waru vu yuwayin gbakala na̱ yi gogo, vu ka̱ra̱ a̱ tyo o uɗolu wa̱ Yufiriti, vu soko yi ɗe uba̱ta̱'a̱ a̱tsuma̱ a̱a̱ba̱nu a aatali.&gt;&gt; <verse eid="JER 13:4" /><verse number="5" style="v" sid="JER 13:5" />Ɗaɗa n ka̱ra̱i n soko niyi a̱ a̱a̱ba̱nu zuzu nu uɗolu wa̱ Yufiriti cine A̱sulazuva a damma numu.<verse eid="JER 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 13:6" />Ana a yuwain ayin e re, a̱vu A̱sulazuva a damma mu, &lt;&lt;'Yon, vu ka̱ra̱ a̱ 'ya̱wa̱ Yufiriti, vu tara gbakala na n damma nuwu vu soko ɗe.&gt;&gt; <verse eid="JER 13:6" /><verse number="7" style="v" sid="JER 13:7" />Reve n ka̱ra̱ a̱ 'ya̱wa̱ Yufiriti mu uta̱a̱ gbakala'a, diga a̱a̱bunu uba̱ta̱ u na n soko niyi. Agba gogo gbakala'a u la̱nga̱ ta̱, u buwa nu ulinga u ro waru shi.<verse eid="JER 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 13:8" />Reve A̱sulazuva a yuwan adanshi na̱ mu ana, <verse eid="JER 13:8" /><verse number="9" style="v" sid="JER 13:9" />&lt;&lt;Apa ili i na a̱ A̱sulazuva a dammai, &lt;Ne ɗa fo ma̱a̱ lungusa̱ uvaɗu wa Yahuda na̱ a̱bunda̱ o uvaɗu wa̱ Urishelima. <verse eid="JER 13:9" /><verse number="10" style="v" sid="JER 13:10" />Ama awuya a nda a 'yuwan ta̱ a uwwa adanshi a̱ va̱. A̱ ta̱ kurusu ugbawu wo okolo e le, hali o tonishi musula̱ n ro aa yuwusaan le a̱ga̱nda̱ nu ulinga. O to o'wo tsa̱ gbakala ndolo, za na ri nu ulinga shi. <verse eid="JER 13:10" /><verse number="11" style="v" sid="JER 13:11" />Cine gbakala tsu shiva ikyun i vuma, ne ɗa n zuwai u'wa wa Isra'ila na̱ Yahuda suru a sura numu, adama o o'wo ama a̱ va̱, a ca aala a̱ va̱ tsugbain, a̱ ta̱wa̱a̱ mu ni ica na̱ tsugbain, agba a̱ kuɗa̱ ta̱ a uwwa. Ne ɗa A̱sulazuva a dammai.&gt; &gt;&gt;<verse eid="JER 13:11" /></para>
  <para style="s">Tsa̱n vu kwan masayan ma̱ ina̱bi</para>
  <para style="p">
    <verse number="12" style="v" sid="JER 13:12" />&lt;&lt;Vu damma le, &lt;Apa ili i na A̱sulazuva, A̱sula̱ a Isra'ila, a dammai, o shiton tsa̱n vu kwan masayan ma̱ ina̱bi biti na̱ mini.&gt; Amma na damma wu, &lt;A̱tsu, tsu reve a na o shiton tsa̱n vu kwan masayan ma̱ ina̱bi biti na̱ mini shi?&gt; &gt;&gt;<verse eid="JER 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 13:13" />&lt;&lt;A̱vu vu damma le, &lt;Apa ili i na A̱sulazuva a dammai, n to shiton a ama e iɗa i nda suru na̱ masayan ma̱ ina̱bi hali o o'wo usowu, hali fo na̱ ngono nna n ri na agadu ootogu o tsugono tsa̱ Da̱wuda, na̱ nan ganu na ama̱sula̱ na ama a̱ nda̱na̱ta̱ ma Urishelima suru. <verse eid="JER 13:13" /><verse number="14" style="v" sid="JER 13:14" />N ta zuwa le o ɓosoloi aci e le na aci e le, nan dada na̱ muwun. Maa lyawa iliyali ko ankuri ko isa'ani a putsaa mu o kototo le shi. Ne ɗa A̱sulazuva a dammai.&gt; &gt;&gt;<verse eid="JER 13:14" /></para>
  <para style="s">Morono ma atsuvu adama a tsugbashi</para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 13:15" />&lt;&lt;Uwwai, reve i polo atsuvu,</para>
  <para style="q2" vid="JER 13:15">she i yuwan ugbawu wan,</para>
  <para style="q2" vid="JER 13:15">adama a na A̱sulazuva a yuwan ta̱ adanshi.<verse eid="JER 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 13:16" />I ca A̱sulazuva A̱sula̱ a̱ ɗu tsugbain,</para>
  <para style="q2" vid="JER 13:16">kafu u ta̱wa̱a̱ ni irumbu,</para>
  <para style="q1" vid="JER 13:16">kafu waru ana a̱ ɗu a̱ ta̱ɗa̱tsa̱</para>
  <para style="q2" vid="JER 13:16">zuva va agaɗi e irumbu,</para>
  <para style="q1" vid="JER 13:16">a̱ ɗu pe e ibingi ye ekan,</para>
  <para style="q2" vid="JER 13:16">a̱vu u ka̱mbuwai irumbu,</para>
  <para style="q2" vid="JER 13:16">u ka̱mbuwai irumbu i lima̱ pici.<verse eid="JER 13:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 13:17" />Amma ni i kuɗa̱ a uwwa,</para>
  <para style="q2" vid="JER 13:17">n ta̱ shon usokowu</para>
  <para style="q2" vid="JER 13:17">adama o uvaɗu u ɗu.</para>
  <para style="q1" vid="JER 13:17">N ta yuwan mesun mo usuɗu,</para>
  <para style="q2" vid="JER 13:17">esu a̱ va̱ o to oco a aɓara lon,</para>
  <para style="q1" vid="JER 13:17">adama a na a̱ ta̱ pura̱ oɓolo e ikyon</para>
  <para style="q2" vid="JER 13:17">ya̱ A̱sulazuva a̱ tyo tsugbashi.&gt;&gt;<verse eid="JER 13:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JER 13:18" />Vu damma mogono</para>
  <para style="q2" vid="JER 13:18">ne egbere mma mogono,</para>
  <para style="q1" vid="JER 13:18">&lt;&lt;Cipa̱i diga o ootogu</para>
  <para style="q2" vid="JER 13:18">o tsugono tsa̱ ɗu,</para>
  <para style="q1" vid="JER 13:18">adama a na okokolo o tsugono</para>
  <para style="q2" vid="JER 13:18">tsa tsugbain tsa̱ ɗu</para>
  <para style="q2" vid="JER 13:18">a̱ ta̱ riya̱ diga aci a̱ ɗu.<verse eid="JER 13:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 13:19" />A̱ ta̱ ɓa̱ru ilyuci ye Nege,</para>
  <para style="q2" vid="JER 13:19">agba babu za na</para>
  <para style="q2" vid="JER 13:19">a katsu'wa le.</para>
  <para style="q1" vid="JER 13:19">A̱ ta̱ pura̱ aza a Yahuda suru</para>
  <para style="q2" vid="JER 13:19">a̱ tyo tsugbashi,</para>
  <para style="q2" vid="JER 13:19">a̱ ta̱ pura̱ le kpa̱ra̱a̱.&gt;&gt;<verse eid="JER 13:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JER 13:20" />&lt;&lt;'Ya̱sa̱yin esu ɗu,</para>
  <para style="q2" vid="JER 13:20">i ka̱lyuwa̱ yee ene,</para>
  <para style="q1" vid="JER 13:20">aza a na a̱ ri a̱ ta̱wa̱</para>
  <para style="q2" vid="JER 13:20">diga o upasu wu ugana.</para>
  <para style="q1" vid="JER 13:20">A te ɗa oɓolo a na</para>
  <para style="q2" vid="JER 13:20">a zuwai ekere a̱ ɗu,</para>
  <para style="q2" vid="JER 13:20">oɓolo e ikyon i na</para>
  <para style="q2" vid="JER 13:20">yaa yuwusan uvaɗu ne ele?<verse eid="JER 13:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 13:21" />Nye yaa damma mantsa ma na</para>
  <para style="q2" vid="JER 13:21">A̱sulazuva a zuwaa nɗu</para>
  <para style="q1" vid="JER 13:21">aza a na i tarai n'utsa̱ n ɗu</para>
  <para style="q2" vid="JER 13:21">a yuwan tsugbain e ekere a̱ ɗu?</para>
  <para style="q1" vid="JER 13:21">Ashe ya uwwa a̱tsuma̱lima̱</para>
  <para style="q2" vid="JER 13:21">tsa ka na ri e teri shi?&gt;&gt;<verse eid="JER 13:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 13:22" />Nna̱ waru yee ece aciya̱ɗu,</para>
  <para style="q2" vid="JER 13:22">&lt;&lt;Nye i zuwai ili i nda</para>
  <para style="q2" vid="JER 13:22">i cina ntsu?&gt;&gt;</para>
  <para style="q1" vid="JER 13:22">Ili ya nda gba</para>
  <para style="q2" vid="JER 13:22">adama a̱bunda̱ o unusu u ɗu u ɗa</para>
  <para style="q1" vid="JER 13:22">i zuwai a̱ ba̱ɗa̱ nuwu</para>
  <para style="q2" vid="JER 13:22">umuna alanga eteshe,</para>
  <para style="q2" vid="JER 13:22">reve a suɗato lipu va̱ wu.<verse eid="JER 13:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 13:23" />&lt;&lt;Vuma va̱ Kush ta gura</para>
  <para style="q2" vid="JER 13:23">vadala iroci yu ukwan</para>
  <para style="q2" vid="JER 13:23">i lipu va̱ yi ɗa?</para>
  <para style="q1" vid="JER 13:23">Ko uta̱su u ta gura vadala</para>
  <para style="q2" vid="JER 13:23">abasabasa a̱ lipu va̱ yi ɗa?</para>
  <para style="q1" vid="JER 13:23">Yaa gura yuwan isa'ani a̱ɗu na</para>
  <para style="q2" vid="JER 13:23">i tsu yuwusan iwuya kuci shi?<verse eid="JER 13:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 13:24" />N ta̱ bete'we ɗu tsa̱ tsu'yuwa̱,</para>
  <para style="q2" vid="JER 13:24">tsa̱ tsu'yuwa̱ tsa na upepu</para>
  <para style="q2" vid="JER 13:24">wa̱ a̱tsumona u tsu pura̱.<verse eid="JER 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 13:25" />A̱yi ndolo a̱yi ɗa akunda a̱ ɗu,</para>
  <para style="q2" vid="JER 13:25">akunda a na n ritowo nɗu,</para>
  <para style="q1" vid="JER 13:25">adama a na yi icinai na̱ mu,</para>
  <para style="q2" vid="JER 13:25">a̱vu i zuwaa musula̱ me epen ucira.&gt;&gt;</para>
  <para style="qr" vid="JER 13:25">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 13:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 13:26" />&lt;&lt;A̱mu na aciya̱va̱,</para>
  <para style="q2" vid="JER 13:26">n ta̱ pa̱lu'wa̱ ɗu</para>
  <para style="q2" vid="JER 13:26">n lyawa ɗu ataɓu</para>
  <para style="q2" vid="JER 13:26">hali wono u guza̱ ɗu.<verse eid="JER 13:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 13:27" />Adama e icigi i tsipere tsa̱ a̱ ɗu,</para>
  <para style="q2" vid="JER 13:27">ni icigi yi ili yi idaba i ɗu,</para>
  <para style="q2" vid="JER 13:27">na̱ tsushakala tsa̱ wono tsa̱ ɗu,</para>
  <para style="q1" vid="JER 13:27">mee ene ta̱ linga vi idaba ɗu</para>
  <para style="q2" vid="JER 13:27">zuva va agaɗi na̱ a̱tsuma̱ a agalaci.</para>
  <para style="q1" vid="JER 13:27">A̱tsuma̱lima̱ a ta cina wu Urishelima!</para>
  <para style="q2" vid="JER 13:27">Hali mantsa ma̱ ne</para>
  <para style="q2" vid="JER 13:27">vaa lyuwa elime na̱ nden</para>
  <para style="q2" vid="JER 13:27">mu ulambu wa akiza?&gt;&gt;<verse eid="JER 13:27" /></para>
  <chapter eid="JER 13" />
  <chapter number="14" style="c" sid="JER 14" />
  <para style="s">Ulambu u mini na ambulu na̱ matsun me pe'eni</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 14:1" />Apa adanshi a̱ A̱sulazuva a na a̱ ta̱wa̱i uba̱ta̱ wa̱ Irimiya adama o ulambu u mini.<verse eid="JER 14:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="JER 14:2" />&lt;&lt;Yahuda ta̱ nden n wiruta̱,</para>
  <para style="q2" vid="JER 14:2">ilyuci ya̱ yi i ta̱ ma̱dukwa̱ ma̱ mesun.</para>
  <para style="q1" vid="JER 14:2">A̱ ta̱ mesun adama e iɗa'a,</para>
  <para style="q2" vid="JER 14:2">mesun ma̱ ta̱ 'yosun</para>
  <para style="q2" vid="JER 14:2">diga a̱tsuma̱ a̱ Urishelima.<verse eid="JER 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 14:3" />Azagbain a̱ lyungu ta̱</para>
  <para style="q2" vid="JER 14:3">agbashi e le mekene</para>
  <para style="q2" vid="JER 14:3">ma̱ mini o oko'o,</para>
  <para style="q2" vid="JER 14:3">agba a̱ tsura̱ mini shi.</para>
  <para style="q1" vid="JER 14:3">Reve a̱ ka̱mba̱ na̱ nden n le la̱nga̱,</para>
  <para style="q2" vid="JER 14:3">na̱ wono na̱ wupalu wu urewesu,</para>
  <para style="q2" vid="JER 14:3">na aci e le wupalu.<verse eid="JER 14:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 14:4" />Iɗa'a yi ɓatsa ta̱</para>
  <para style="q2" vid="JER 14:4">adama o ulambu wi iro'i,</para>
  <para style="q1" vid="JER 14:4">acimbi o sowo ta̱ wono,</para>
  <para style="q2" vid="JER 14:4">hali a pala urewesu u le.<verse eid="JER 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 14:5" />Hali fo na mere'on mo una,</para>
  <para style="q2" vid="JER 14:5">ma suma u lyawa mawun</para>
  <para style="q2" vid="JER 14:5">ma na u matsain usa'avu</para>
  <para style="q2" vid="JER 14:5">adama o ulambu wa anlya.<verse eid="JER 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 14:6" />Nloli mu una</para>
  <para style="q2" vid="JER 14:6">n ta̱ mishin zuva va agaɗi,</para>
  <para style="q1" vid="JER 14:6">o ronuso wivuwun zuva zuva</para>
  <para style="q2" vid="JER 14:6">tsa̱ musa̱n mu una,</para>
  <para style="q1" vid="JER 14:6">esu e le e inda ure shi</para>
  <para style="q2" vid="JER 14:6">adama o ulambu wu uba̱ta̱ wa alyuna.&gt;&gt;<verse eid="JER 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JER 14:7" />&lt;&lt;Ko na wo o'woi unusu u tsu</para>
  <para style="q2" vid="JER 14:7">u ta adanshi a aci a̱ tsu,</para>
  <para style="q1" vid="JER 14:7">a̱vu A̱sulazuva, vu yuwan</para>
  <para style="q2" vid="JER 14:7">ili i ro adama a ala a̱ wu.</para>
  <para style="q1" vid="JER 14:7">Adama a na uvadalusa</para>
  <para style="q2" vid="JER 14:7">wu ucina̱ u tsu</para>
  <para style="q2" vid="JER 14:7">u yuwan ta̱ a̱bunda̱,</para>
  <para style="q1" vid="JER 14:7">na amayun,</para>
  <para style="q2" vid="JER 14:7">tsu yuwaan wu ta̱ unusu.<verse eid="JER 14:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 14:8" />O'o, a̱vu uzuwu</para>
  <para style="q2" vid="JER 14:8">wo okolo a Isra'ila,</para>
  <para style="q1" vid="JER 14:8">a̱vu za vi iwawi ya̱ yi</para>
  <para style="q2" vid="JER 14:8">a mantsa ma atakaci!</para>
  <para style="q1" vid="JER 14:8">Adama nye vo o'woi</para>
  <para style="q2" vid="JER 14:8">tso mocin e iɗa'a?</para>
  <para style="q1" vid="JER 14:8">Cine vu rotsoi za vu mmalu na asai</para>
  <para style="q2" vid="JER 14:8">nu usana a̱vu u ka̱ra̱?<verse eid="JER 14:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 14:9" />Nye i zuwai va yuwusan va damma</para>
  <para style="q2" vid="JER 14:9">vuma na ri urupulu,</para>
  <para style="q1" vid="JER 14:9">tsa yali yu uvon na ri nu ucira</para>
  <para style="q2" vid="JER 14:9">u na waa wawa aciya̱yi shi?</para>
  <para style="q1" vid="JER 14:9">A̱vu A̱sulazuva,</para>
  <para style="q2" vid="JER 14:9">vu ta̱ a̱tsuma̱ a̱ tsu,</para>
  <para style="q1" vid="JER 14:9">waru a̱ ta̱ ɗesu tsu na ala a̱ wu,</para>
  <para style="q2" vid="JER 14:9">she vu vari tsu wan!&gt;&gt;<verse eid="JER 14:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 14:10" />Apa ili i na A̱sulazuva a dammai</para>
  <para style="q2" vid="JER 14:10">adama a ama nda,</para>
  <para style="q1" vid="JER 14:10">&lt;&lt;Na amayun a ciga ta̱</para>
  <para style="q2" vid="JER 14:10">a̱ da̱na̱ e igaru,</para>
  <para style="q1" vid="JER 14:10">a tsu putsaa ana e le</para>
  <para style="q2" vid="JER 14:10">ni igaru shi.</para>
  <para style="q1" vid="JER 14:10">Adama o ndolo, a̱mu A̱sulazuva,</para>
  <para style="q2" vid="JER 14:10">moo soɗuwo le ma̱tsa̱n shi,</para>
  <para style="q1" vid="JER 14:10">gogo n ta cuwan ni iwuya i le,</para>
  <para style="q2" vid="JER 14:10">waru n ca le oforo</para>
  <para style="q2" vid="JER 14:10">adama a̱ nusu le.&gt;&gt;<verse eid="JER 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 14:11" />Reve A̱sulazuva a damma mu, &lt;&lt;She vu yuwan avasa adama addama ama a nda wan. <verse eid="JER 14:11" /><verse number="12" style="v" sid="JER 14:12" />Ko na̱ shi a yuwan akuli, ma uwwa mesun ma̱ le shi. Ko na wo o'woi a ta casu kucci vu ukula̱tosu na̱ kucci vi ishina, ma̱a̱ ushi le shi. O una̱ u ndolo, n to kototo le na̱ matsun me pe'eni na ambulu na̱ mɓa̱la̱.&gt;&gt;<verse eid="JER 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 14:13" />Reve a̱mu Irimiya, n usu n damma, &lt;&lt;Ayya, A̱sulazuva Zagbain! Ama̱sula̱ a dansaa le ta̱, &lt;Yee ene matsun me pe'eni mo uvon ko ambulu shi. A̱sulazuva a ta ca ɗu nden ma asuvu nna moo koto shi uba̱ta̱ u nda'a.&gt; &gt;&gt;<verse eid="JER 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 14:14" />Reve A̱sulazuva a damma mu, &lt;&lt;Ama̱sula̱ a nda, adanshi e ikaka ye epen i ɗa aa yuwusan na ala a̱ va̱. A̱mu n lyungu le shi, waru n zuwa le shi, ko n yuwan adanshi ne le shi. A ta yuwusaan ɗu adanshi e ikaka ye epen ya alavu alavu na̱ yindi i vanvama, a ta yuwusan tsuboci, waru a dansa majiyan mo okolo e le goon. <verse eid="JER 14:14" /><verse number="15" style="v" sid="JER 14:15" />Adama o ndolo, apa ili i na a̱mu A̱sulazuva ma dansa a aci ama̱sula̱ a na aa yuwusan adanshi e ikaka ye epen na ala a̱ va̱. N lyungu le shi, amma a ta dansa, &lt;Babu matsun me pe'eni ko ambulu a na a̱ ju'wa̱n iɗa i nda.&gt; Ele ama̱sula̱ a nda, matsun me pe'eni na ambulu a ɗa o kototo le. <verse eid="JER 14:15" /><verse number="16" style="v" sid="JER 14:16" />Ama a na ama̱sula̱ o ndolo aa yuwusaan adanshi e ikaka ye epe'en, o to oco a̱kwa̱kwa̱ a̱ lipu le e re va̱ Urishelima adama a ambulu na̱ matsun me pe'eni. Waru babu za na a̱ ciɗo le, ko a̱ ciɗo a̱ma̱ci e le, ko muwun mo olobo n le ne esheli e le. Na amayun n ta̱ ka̱mbuwa̱ iwuya i le a aci e le.<verse eid="JER 14:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="JER 14:17" />&lt;&lt;A̱vu Irimiya,</para>
  <para style="q2" vid="JER 14:17">vu yuwaan le adanshi a nda,</para>
  <para style="q1" vid="JER 14:17">&lt;Lyawa esu a̱ va̱ a̱ da̱na̱</para>
  <para style="q2" vid="JER 14:17">oo ocosu aɓara,</para>
  <para style="q2" vid="JER 14:17">ayin nu urana she a̱ bula̱ wan.</para>
  <para style="q1" vid="JER 14:17">Adama a na a̱ ga̱la̱ ta̱ ama a̱ va̱,</para>
  <para style="q2" vid="JER 14:17">macigata ma̱ va̱ Usheli u va̱,</para>
  <para style="q1" vid="JER 14:17">a kada yi ta̱ lon,</para>
  <para style="q2" vid="JER 14:17">a uwwato yi ta̱ usa̱n lon.<verse eid="JER 14:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 14:18" />Nna̱ n ka̱ra̱ a uwa</para>
  <para style="q2" vid="JER 14:18">a̱tsuma̱ a̱ mulyuci'i,</para>
  <para style="q1" vid="JER 14:18">n tse ene ta̱ aza a na</para>
  <para style="q2" vid="JER 14:18">o unai na̱ matsun me pe'eni!</para>
  <para style="q1" vid="JER 14:18">Nna̱ n ka̱ra̱ a uwa a̱tsuma̱ a̱ lyuci gbain,</para>
  <para style="q2" vid="JER 14:18">n tse ene ta̱ aza a na</para>
  <para style="q2" vid="JER 14:18">a̱ ri o mpolo na ambulu.</para>
  <para style="q1" vid="JER 14:18">Na ama̱sula̱ na̱ nan ganu suru,</para>
  <para style="q2" vid="JER 14:18">a̱ ka̱ra̱ ta̱ a̱ tyo e iɗa</para>
  <para style="q2" vid="JER 14:18">i na e revei shi.&gt; &gt;&gt;<verse eid="JER 14:18" /></para>
  <para style="s">Avasa e ipati yi iliyali</para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 14:19" />&lt;&lt;A̱sulazuva, vu 'yuwan ta̱</para>
  <para style="q2" vid="JER 14:19">Yahuda suru suru ɗa?</para>
  <para style="q1" vid="JER 14:19">Vu ta̱ e inda idaba</para>
  <para style="q2" vid="JER 14:19">ya̱ Sihiyona ɗa?</para>
  <para style="q1" vid="JER 14:19">Nye i zuwai vu lapa ntsu?</para>
  <para style="q2" vid="JER 14:19">Adama she tsu tsura̱ lafiya wan?</para>
  <para style="q1" vid="JER 14:19">Tsu zuwa ta̱ okolo</para>
  <para style="q2" vid="JER 14:19">a̱ nden ma asuvu,</para>
  <para style="q2" vid="JER 14:19">agba babu isa'ani i na i ta̱wa̱i,</para>
  <para style="q1" vid="JER 14:19">tsu zuwa ta̱ okolo</para>
  <para style="q2" vid="JER 14:19">a mantsa ma na tsa̱a̱ tsura̱ lafiya,</para>
  <para style="q2" vid="JER 14:19">agba she tsuda'un goon.<verse eid="JER 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 14:20" />A̱sulazuva tsu reve ta̱</para>
  <para style="q2" vid="JER 14:20">iwuya i na tsu yuwain,</para>
  <para style="q2" vid="JER 14:20">na̱ nusu na nkaya n tsu n yuwain.</para>
  <para style="q1" vid="JER 14:20">Ee, na amayun suru ntsu,</para>
  <para style="q2" vid="JER 14:20">tsu yuwan wu ta̱ unusu.<verse eid="JER 14:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 14:21" />A̱sulazuva, adama a ala a̱ wu</para>
  <para style="q2" vid="JER 14:21">tsu ta patishi wu,</para>
  <para style="q1" vid="JER 14:21">she vu 'yuwan tsu wan,</para>
  <para style="q2" vid="JER 14:21">she vu rono a̱ba̱jini ootogu</para>
  <para style="q2" vid="JER 14:21">a tsugbain tsa̱ wu e iɗa wan.</para>
  <para style="q1" vid="JER 14:21">Vu cuwan na̱ nzuwulai</para>
  <para style="q2" vid="JER 14:21">ma̱ wu na̱ a̱tsu,</para>
  <para style="q2" vid="JER 14:21">she vu kuɗa yi wan.<verse eid="JER 14:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 14:22" />A̱ ta̱ tsura̱ a̱tsuma̱ a̱ musula̱</para>
  <para style="q2" vid="JER 14:22">n vanvama mu nɗa</para>
  <para style="q2" vid="JER 14:22">nna n tsu lyungu ni iro'i?</para>
  <para style="q1" vid="JER 14:22">Zuva gba na aciya̱yi</para>
  <para style="q2" vid="JER 14:22">u tsu ta̱wa̱a̱ ta̱ na̱ yiji'in?</para>
  <para style="q1" vid="JER 14:22">Ko ke'en, she a̱vu a̱ nde'en,</para>
  <para style="q2" vid="JER 14:22">A̱sulazuva A̱sula̱ a̱ tsu.</para>
  <para style="q1" vid="JER 14:22">Adama o ndolo,</para>
  <para style="q2" vid="JER 14:22">uzuwu wo okolo a̱ tsu</para>
  <para style="q2" vid="JER 14:22">a̱ ta̱ ya̱'a̱ wu,</para>
  <para style="q1" vid="JER 14:22">adama a na a̱vu ɗa,</para>
  <para style="q2" vid="JER 14:22">va yuwusan ili i nda suru.&gt;&gt;<verse eid="JER 14:22" /></para>
  <chapter eid="JER 14" />
  <chapter number="15" style="c" sid="JER 15" />
  <para style="s">A paɗa ta̱ ugana adama a ama a Yahuda</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 15:1" />A̱vu A̱sulazuva a damma mu,&lt;&lt;Ko na̱ shi Musa na̱ Sama'ila e isawan a̱ ma̱ka̱ka̱n ma̱ va̱ e ipati, na̱ ne suru okolo a̱ va̱ a̱ ka̱mba̱ uba̱ta̱ wa ama a nda shi. Vu gba̱ra̱ le diga elime a̱ va̱! Lyawa le a̱ ka̱ra̱! <verse eid="JER 15:1" /><verse number="2" style="v" sid="JER 15:2" />Nna̱ e ece wu waru, &lt;A̱ te ɗa tsa̱ ka̱ra̱ a̱ tyo?&gt; Vu damma le, &lt;Apa nda ili i na A̱sulazuva a dammai.&gt; &gt;&gt;</para>
  <para style="b" vid="JER 15:2" />
  <para style="q1" vid="JER 15:2">&lt;&lt; &lt;Aza a na a zuwai na̱ a̱a̱ kuwa̱ suru,</para>
  <para style="q1" vid="JER 15:2">a̱ ta̱ gba kuwa̱!</para>
  <para style="q1" vid="JER 15:2">Aza a na a zuwai o una̱ u matsun me pe'eni,</para>
  <para style="q1" vid="JER 15:2">a̱ ta̱ gba kuwa̱ na̱ matsun me pe'eni!</para>
  <para style="q1" vid="JER 15:2">Aza a na a zuwai o una̱ wa ambulu,</para>
  <para style="q1" vid="JER 15:2">a̱ ta̱ gba kuwa̱ na ambulu!</para>
  <para style="q1" vid="JER 15:2">Aza a na a zuwai a na a̱ 'ya̱wa̱ tsugbashi,</para>
  <para style="q1" vid="JER 15:2">a̱ ta̱ gba a̱ 'ya̱wa̱ tsugbashi!&gt; &gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">15:2 </char><char style="xt" closed="false"><ref loc="REV 13:10">Wen 13:10</ref>.</char></note><verse eid="JER 15:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="JER 15:3" />&lt;&lt;N ta̱ lyunguwa̱a̱ le na̱ re na̱shi vu ukototosu,&gt;&gt; ne ɗa A̱sulazuva a dammai, &lt;&lt;matsun me pe'eni adama mo o una, na̱ musa̱n adama a kakara a̱kwa̱kwa̱, na̱ nnunu ni inama yu una adama a tama le waru o kototo. <verse eid="JER 15:3" /><verse number="4" style="v" sid="JER 15:4" />N ta zuwa le o o'wo ili yi idaba e ekere o tsugono tsa a nɗa suru, adama e ili i na Manase mogono ma Yahuda ulobo wa̱ Hezekiya yuwain ɗe Urishelima.&gt;&gt;<verse eid="JER 15:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JER 15:5" />&lt;&lt;Zane ɗa e ene iliyali ya̱ wu,</para>
  <para style="q2" vid="JER 15:5">a̱vu Urishelima,</para>
  <para style="q1" vid="JER 15:5">Zane ɗa a̱ shon,</para>
  <para style="q2" vid="JER 15:5">adama a̱ wu?</para>
  <para style="q1" vid="JER 15:5">Zane ɗa a̱ ta̱ra̱nu we ece wu,</para>
  <para style="q2" vid="JER 15:5">nye i cina nuwu?&gt;&gt;<verse eid="JER 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 15:6" />A̱sulazuva a damma ta̱,</para>
  <para style="q2" vid="JER 15:6">&lt;&lt;Vu 'yuwan mu ta̱,</para>
  <para style="q1" vid="JER 15:6">vu lyuwa ta̱ elime</para>
  <para style="q2" vid="JER 15:6">na̱ morono ma̱ a̱ca̱pa̱.</para>
  <para style="q1" vid="JER 15:6">Adama o ndolo n ta̱ 'ya̱sa̱n ukere u va̱</para>
  <para style="q2" vid="JER 15:6">a aci a̱ wu n kototo wu,</para>
  <para style="q2" vid="JER 15:6">ma̱a̱ da̱shi roco wu iliyali shi.<verse eid="JER 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 15:7" />N ta̱ yeluwe ama a̱ wu,</para>
  <para style="q2" vid="JER 15:7">na aakpatalutsu o uyeluwu</para>
  <para style="q2" vid="JER 15:7">a̱ na̱ntsu vi ilyuci yi iɗa'a.</para>
  <para style="q1" vid="JER 15:7">N ta̱ ta̱wa̱ na̱ a̱tsuma̱lima̱</para>
  <para style="q2" vid="JER 15:7">nu ukototosu a aci ama a̱ va̱,</para>
  <para style="q1" vid="JER 15:7">adama a na a vadala</para>
  <para style="q2" vid="JER 15:7">diga a̱ re le shi.<verse eid="JER 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 15:8" />N ta̱ da̱shi nruna̱ n le a̱bunda̱</para>
  <para style="q2" vid="JER 15:8">hali a la'a wuyun</para>
  <para style="q2" vid="JER 15:8">wu nkyun m mala a̱bunda̱.</para>
  <para style="q1" vid="JER 15:8">N ta̱ ta̱wa̱ na̱ za vu ukototosu</para>
  <para style="q2" vid="JER 15:8">nu urana aci,</para>
  <para style="q2" vid="JER 15:8">a aci a nan mma vo olobo le,</para>
  <para style="q1" vid="JER 15:8">nu uta̱ u ɗa ma̱a̱ ta̱wa̱a̱ le</para>
  <para style="q2" vid="JER 15:8">na̱ a̱tsuma̱lima̱ na̱ wovon.<verse eid="JER 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 15:9" />Ka na matsain muwun</para>
  <para style="q2" vid="JER 15:9">n cindere ta̱ lima̱,</para>
  <para style="q1" vid="JER 15:9">reve u rono wivuwun</para>
  <para style="q2" vid="JER 15:9">wu ukosu wa̱ yi,<note caller="-" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="1SA 2:5">1 Sam 2:5</ref>.</char></note></para>
  <para style="q1" vid="JER 15:9">adama a na u lamba ta̱</para>
  <para style="q2" vid="JER 15:9">uzuwu wo okolo a̱ yi suru</para>
  <para style="q2" vid="JER 15:9">she damma urana u riya̱ yi ta̱</para>
  <para style="q2" vid="JER 15:9">nu urana a aci.</para>
  <para style="q1" vid="JER 15:9">A ta ca yi wono,</para>
  <para style="q2" vid="JER 15:9">agba a tara yi ili i ro shi.</para>
  <para style="q1" vid="JER 15:9">N ta zuwa o una akapi a na a la'ai</para>
  <para style="q2" vid="JER 15:9">na̱ matsun me pe'eni</para>
  <para style="q2" vid="JER 15:9">elime a n'yuwatan n le.&gt;&gt;</para>
  <para style="qr" vid="JER 15:9">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 15:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 15:10" />&lt;&lt;A̱tsuma̱lima̱ acina mu ta̱,</para>
  <para style="q2" vid="JER 15:10">a̱vu mma va̱ na vu matsa numu!</para>
  <para style="q1" vid="JER 15:10">Vuma na suru iɗa i ri a̱ nla̱ngi na̱ a̱yi</para>
  <para style="q2" vid="JER 15:10">waru a̱ ri a mawasan na̱ a̱yi!</para>
  <para style="q1" vid="JER 15:10">A̱mu n ca okopu</para>
  <para style="q2" vid="JER 15:10">ko n ushi okopu shi,</para>
  <para style="q1" vid="JER 15:10">na̱ ne suru, koyan</para>
  <para style="q2" vid="JER 15:10">ta yuwusaan mu una̱.&gt;&gt;<verse eid="JER 15:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JER 15:11" />A̱vu A̱sulazuva a̱ usu u damma,</para>
  <para style="q2" vid="JER 15:11">&lt;&lt;Na amayun, n ta wawa wu</para>
  <para style="q2" vid="JER 15:11">adama e isa'ani,</para>
  <para style="q1" vid="JER 15:11">na amayun, n ta zuwa</para>
  <para style="q2" vid="JER 15:11">n'yuwatan ma̱ wu n yuwan</para>
  <para style="q2" vid="JER 15:11">ipati e ekere a̱ wu,</para>
  <para style="q1" vid="JER 15:11">a mantsa ma̱ a̱tsuma̱lima̱</para>
  <para style="q2" vid="JER 15:11">na atakaci.<verse eid="JER 15:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 15:12" />Vuma ta gura kuɗa rumu,</para>
  <para style="q2" vid="JER 15:12">rumu diga ugana ko rumushili?&gt;&gt;<verse eid="JER 15:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JER 15:13" />&lt;&lt;N ta zuwa utsuru u ɗu</para>
  <para style="q2" vid="JER 15:13">nu uzuwa u ɗu,</para>
  <para style="q1" vid="JER 15:13">wo o'wo itana i na a̱ pura̱i</para>
  <para style="q2" vid="JER 15:13">uba̱ta̱ o uvon une'e.</para>
  <para style="q1" vid="JER 15:13">Adama a̱ nusu ɗu</para>
  <para style="q2" vid="JER 15:13">na i yuwain suru,</para>
  <para style="q2" vid="JER 15:13">ba̱ta̱ biti a̱tsuma̱ e iɗa i ɗu.<verse eid="JER 15:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 15:14" />N ta zuwa i yuwaan</para>
  <para style="q2" vid="JER 15:14">n'yuwatan n ɗu tsugbashi</para>
  <para style="q2" vid="JER 15:14">e iɗa i na i revei shi.</para>
  <para style="q1" vid="JER 15:14">Adama a na upan u va̱</para>
  <para style="q2" vid="JER 15:14">u ta dala tsa akina,</para>
  <para style="q2" vid="JER 15:14">na̱ a̱ da̱na̱ a lyuwusa a aci a̱ ɗu.&gt;&gt;<verse eid="JER 15:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JER 15:15" />&lt;&lt;A̱vu Irimiya dammisa,</para>
  <para style="q2" vid="JER 15:15">A̱sulazuva, vu cuwan na̱ mu</para>
  <para style="q2" vid="JER 15:15">waru vi idana mu.</para>
  <para style="q1" vid="JER 15:15">Vu tsupaa mu a aci</para>
  <para style="q2" vid="JER 15:15">aza a na o ɓongishi mu.</para>
  <para style="q1" vid="JER 15:15">A̱tsuma̱ a makaɓa ma asuvu ma̱ wu,</para>
  <para style="q2" vid="JER 15:15">she vu una mu wan.</para>
  <para style="q1" vid="JER 15:15">Vu cuwan na̱ wisulusa u na,</para>
  <para style="q2" vid="JER 15:15">n sowoi adama a̱ wu.<verse eid="JER 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 15:16" />Mantsa ma na idanshi ya̱ wu i ta̱wa̱i,</para>
  <para style="q2" vid="JER 15:16">n tama le ta̱,</para>
  <para style="q1" vid="JER 15:16">e le ɗa a̱ da̱na̱i ma̱za̱nga̱ ma̱ va̱,</para>
  <para style="q2" vid="JER 15:16">waru okolo a̱ va̱ a yuwan ta̱ mere,</para>
  <para style="q1" vid="JER 15:16">adama a na a̱ ta̱ ɗesu mu</para>
  <para style="q2" vid="JER 15:16">na ala a̱ wu,</para>
  <para style="q1" vid="JER 15:16">a̱vu A̱sulazuva A̱sula̱</para>
  <para style="q2" vid="JER 15:16">o oɓolo a̱ a̱soja a zuva.<verse eid="JER 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 15:17" />Ko ta̱ n rito da̱nu a̱tsuma̱ e iɓolo</para>
  <para style="q2" vid="JER 15:17">ya aza a na a̱ 'ya̱susa̱n aci shi,</para>
  <para style="q1" vid="JER 15:17">agba ko ta̱ n rito yuwan ma̱za̱nga̱</para>
  <para style="q2" vid="JER 15:17">oɓolo ne le shi.</para>
  <para style="q1" vid="JER 15:17">N da̱nu ta̱ a̱mu nde'en,</para>
  <para style="q2" vid="JER 15:17">adama a na ukere</para>
  <para style="q2" vid="JER 15:17">wa̱ wu u ta aci a̱ va̱,</para>
  <para style="q1" vid="JER 15:17">waru vu zuwa mu ta̱</para>
  <para style="q2" vid="JER 15:17">n shiwan nu upan.<verse eid="JER 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 15:18" />Adama a̱ nye ɗa wo o'woi</para>
  <para style="q2" vid="JER 15:18">a̱tsuma̱lima̱ a̱ va̱ a̱ ri n koto shi?</para>
  <para style="q1" vid="JER 15:18">Waru usa̱n u va̱</para>
  <para style="q2" vid="JER 15:18">u ri na̱ a̱guma̱ shi?</para>
  <para style="q1" vid="JER 15:18">Vu ta̱ luluma̱ mu tsu uka̱ri</para>
  <para style="q2" vid="JER 15:18">u na we 'yewushe ɗa?</para>
  <para style="q1" vid="JER 15:18">Va damma oko'o a na</para>
  <para style="q2" vid="JER 15:18">a gura zuwaa ucira shi?&gt;&gt;<verse eid="JER 15:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JER 15:19" />Adama o ndolo apa ili i na</para>
  <para style="q2" vid="JER 15:19">A̱sulazuva a dammai Irimiya,</para>
  <para style="q1" vid="JER 15:19">&lt;&lt;Na amayun, nna̱ vu vadala</para>
  <para style="q2" vid="JER 15:19">n ta̱ ka̱mba̱to wu</para>
  <para style="q2" vid="JER 15:19">adama vu yuwaan mu a̱ga̱nda̱,</para>
  <para style="q1" vid="JER 15:19">nna̱ vu yuwan adanshi a sa'ani,</para>
  <para style="q2" vid="JER 15:19">agba adanshi a vama shi,</para>
  <para style="q2" vid="JER 15:19">vu to o'wo una̱ u va̱.</para>
  <para style="q1" vid="JER 15:19">Lyawa ama a nda</para>
  <para style="q2" vid="JER 15:19">a̱ ka̱mba̱ uba̱ta̱ wa̱ wu,</para>
  <para style="q1" vid="JER 15:19">amma a̱vu she vu vadala</para>
  <para style="q2" vid="JER 15:19">uba̱ta̱ u le wan.<verse eid="JER 15:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 15:20" />N ta zuwa wu voo o'wo ama'a</para>
  <para style="q2" vid="JER 15:20">uɓaɓu wu ucira wu rumushili.</para>
  <para style="q1" vid="JER 15:20">A ta yuwan uvon na̱ a̱vu,</para>
  <para style="q2" vid="JER 15:20">agba a lyuwa a aci wu shi.</para>
  <para style="q1" vid="JER 15:20">Adama a na n to oɓolo na̱ a̱vu,</para>
  <para style="q2" vid="JER 15:20">n wawa wu a̱vu waru n papa wu.&gt;&gt;</para>
  <para style="qr" vid="JER 15:20">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 15:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 15:21" />&lt;&lt;N ta wawa wu</para>
  <para style="q2" vid="JER 15:21">diga e ekere a n'yuwatan,</para>
  <para style="q1" vid="JER 15:21">reve n wawa wu</para>
  <para style="q2" vid="JER 15:21">diga e ekere a̱za̱ o ulambu</para>
  <para style="q2" vid="JER 15:21">u mene me iliyali.&gt;&gt;<verse eid="JER 15:21" /></para>
  <chapter eid="JER 15" />
  <chapter number="16" style="c" sid="JER 16" />
  <para style="s">Urana wa addama</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 16:1" />Reve adanshi A̱sulazuva a̱a̱ ta̱wa̱ ya̱'a̱ va̱ ana, <verse eid="JER 16:1" /><verse number="2" style="v" sid="JER 16:2" />&lt;&lt;She vu yuwan lolo vu matsan muwun mo olobo ne esheli uba̱ta̱ u nda wan. <verse eid="JER 16:2" /><verse number="3" style="v" sid="JER 16:3" />Adama a na apa ili i na A̱sulazuva a dammai a aci a̱ muwun mo olobo ne esheli a na a matsain e iɗa i nda'a, oɓolo na̱ a̱ma̱ci a na a matsan nle na ali a na a matsan nle fo. <verse eid="JER 16:3" /><verse number="4" style="v" sid="JER 16:4" />A̱ ta̱ kuwa̱ na̱ mɓa̱la̱ n wuya. Agba babu za na a̱ shon adama o ukwisa̱ u le, ko a̱ ciɗo le. O to o'wo edemu. Matsun me pe'eni na ambulu a ɗa o una le, a̱vu a̱kwa̱kwa̱ e le o o'wo ilyalya yi nnunu oɓolo ni inama yu una.&gt;&gt;<verse eid="JER 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 16:5" />Apa ili i na A̱sulazuva a̱ da̱shi dammisai ana, &lt;&lt;She vu uwa o u'wa u na a yuwusan mesun mo ukwa̱, ko vu 'ya̱wa̱ uba̱ta̱ u na a yuwusan a̱tsuma̱la̱ngu, she vu la̱nga̱ a̱a̱tsuma̱ adama e le wan, adama a na n tawa ta̱ ɗe aba'un a̱ va̱, ni icigi i va̱, ni iliyali i va̱, diga uba̱ta̱ wa ama a nda.&gt;&gt; Ne ɗa A̱sulazuva a dammai. <verse eid="JER 16:5" /><verse number="6" style="v" sid="JER 16:6" />&lt;&lt;Zagbain na̱ mawun suru a̱ ta̱ kuwa̱ e iɗa i nda. Agba a̱ ciɗo le shi, ko a yuwan a̱tsuma̱la̱ngu adama e le shi. Agba babu za na a kyu'wan lipu va̱ yi, ko u puna ogbondo adama e le, adama a na A̱sulazuva a̱ usuwa̱ le a yuwan ne shi.<note caller="-" style="x"><char style="xo" closed="false">16:6 </char><char style="xt" closed="false"><ref loc="DEU 14:1">U.Wl 14:1</ref>.</char></note> <verse eid="JER 16:6" /><verse number="7" style="v" sid="JER 16:7" />Agba za lo na wa ca za vu nden n wirota̱ ilyalya adama o ucasu wa adanshi adama a̱ a̱kwa̱kwa̱'a̱ shi, ko shi za ro ca ili yo oso adama u ca dada ko mma va̱ yi adanshi shi. <verse eid="JER 16:7" /><verse number="8" style="v" sid="JER 16:8" />She vu uwa o u'wa u na a yuwusan a̱buki vu da̱nu, adama vu lyuwa vu sowo wan. <verse eid="JER 16:8" /><verse number="9" style="v" sid="JER 16:9" />Adama a na apa ili i na A̱sulazuva oɓolo a̱ a̱soja a zuva, A̱sula̱ a Isra'ila a dammai, ka̱lyuwa̱, e esu a̱ wu a ɗa, waru a̱tsuma̱ a rana va̱ wu ɗa, ma̱a̱ ta̱wa̱a̱ nu ukosu wu uɗyo u mere na̱ ma̱za̱nga̱, wu uɗyo u vali vu ka sa'avu na̱ ka sa'avu diga uba̱ta̱ u nda.&gt;&gt;<verse eid="JER 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 16:10" />&lt;&lt;A mantsa ma na vu dammai ama a nda idanshi i nda suru, a̱ ta̱ gba a damma wu, &lt;Nye i zuwai A̱sulazuva a lyawai a̱ba̱jini a̱ meleshe ma nda a aci a̱ tsu? Cu'un vi iwuya i ne ɗa tsu yuwain? Cu'un vu unusu u ne ɗa tsu yuwayin A̱sulazuva A̱sula̱ a̱ tsu?&gt; <verse eid="JER 16:10" /><verse number="11" style="v" sid="JER 16:11" />A̱vu vu damma le cu'un nda fara ta̱, &lt;Adama a na nkaya n ɗu mu kasa ta̱ na̱ mu,&gt; Ne ɗa A̱sulazuva a dammai. &lt;A̱vu a̱ kuru musula̱ n ro, a̱ ka̱ɗa̱to wa̱ le a yuwaan le a̱ga̱nda̱. Reve a kasa na̱ mu, agba a yuwan tsutoni na̱ wila̱ u va̱ shi. <verse eid="JER 16:11" /><verse number="12" style="v" sid="JER 16:12" />Agba a̱ɗu i la'a ta̱ yuwan iwuya ula'awu na̱ nkaya nɗu. Ka̱lyuwa̱, cine za suru a̱tsuma̱ a̱ɗu a̱ ri a̱ kurusu aciyogbamu o okolo a̱ yi, o una̱ u na aa yuwan mu tsutoni. <verse eid="JER 16:12" /><verse number="13" style="v" sid="JER 16:13" />Adama o ndolo, n ta̱ vari ɗu alanga diga e iɗa i nda a̱ tyo e iɗa i ro, e iɗa i na ko a̱ɗu ko nkaya n ɗu n revei shi. Ɗe uba̱ta̱'a̱ i ta̱ yuwaan musula̱ n ro tsugbashi usana na ayin, adama a na moo roco ɗu iliyali shi.&gt; &gt;&gt;<verse eid="JER 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 16:14" />Amma a̱vu A̱sulazuva a damma, &lt;&lt;Rana ta̱ lo a̱ ta̱wa̱, o una̱ u na a̱a̱ da̱shi damma, &lt;Nna̱ A̱sulazuva a̱ ri wuma, za na o uta̱yi aza a Isra'ila diga e iɗa ya Masar,&gt; <verse eid="JER 16:14" /><verse number="15" style="v" sid="JER 16:15" />u ta la'aa le a damma, &lt;N na̱ A̱sulazuva a̱ ri wuma, za na uta̱yi aza a Isra'ila diga e iɗa yu ugana na̱ diga a nɗa n na waru u gba̱ra̱ nle suru,&gt; Adama a na n ta̱ ka̱mbuwa̱ le e iɗa i na n cayi nkaya nle.<verse eid="JER 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 16:16" />&lt;&lt;Amma gogo n ta̱ lyungu n'yuwatan ma̱ a̱bunda̱, aza a na e reme ama a nda, tsa̱ a̱za̱ e mereme ma mugula,&gt;&gt; ne ɗa A̱sulazuva a dammai. &lt;&lt;Na̱ a̱yi ndolo koto, reve n lyunguwisa̱ e ɗe a̱za̱ o ugenge a̱bunda̱ a̱ ta̱wa̱, a yuwan ugenge u le tsa̱ a̱za̱ o ugenge, diga aatali suru na nsasan na agaɗi biti, hali fo na̱ a̱bunu atali. <verse eid="JER 16:16" /><verse number="17" style="v" sid="JER 16:17" />Adama a na esu a̱ va̱ a̱ ta̱ a̱ re le suru, a̱ ri usokowu ya̱'a̱ va̱ shi. Waru nusu le a̱ ri usokowu esu a̱ va̱ shi. <verse eid="JER 16:17" /><verse number="18" style="v" sid="JER 16:18" />N ta tsupa le udoɓonuwu, o una̱ wi iwuya i le nu unusu u le, adama a na a̱ lungusa̱ ta̱ iɗa i va̱, na̱ musula̱ n na n ri wuma shi vi idaba i le. Reve fo o shiton ili ya agadu a̱ va̱ na̱ musula̱ n le vi idaba.&gt;&gt;<verse eid="JER 16:18" /></para>
  <para style="s">Irimiya zuwaa ta̱ A̱sulazuva ucira</para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 16:19" />A̱sulazuva, a̱vu ɗa ucira u va̱</para>
  <para style="q2" vid="JER 16:19">nu uba̱ta̱ wu upa'atan wu ucira u va̱,</para>
  <para style="q1" vid="JER 16:19">uba̱ta̱ o upa'atan u va̱</para>
  <para style="q2" vid="JER 16:19">a mantsa ma̱ a̱tsuma̱lima̱,</para>
  <para style="q1" vid="JER 16:19">uba̱ta̱ wa̱ wu u ɗa nɗa ma̱ ta̱wa̱,</para>
  <para style="q2" vid="JER 16:19">diga o utyo wu uvaɗi a̱vu a damma,</para>
  <para style="q1" vid="JER 16:19">&lt;&lt;Agadu a na nkaya n tsu n ri na̱ yi,</para>
  <para style="q2" vid="JER 16:19">a̱yi ɗa musula̱ me epen goon,</para>
  <para style="q1" vid="JER 16:19">a̱ma̱li a̱ pere a na</para>
  <para style="q2" vid="JER 16:19">a yuwaan nle ulinga shi.<verse eid="JER 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 16:20" />Vaɗilima̱ ta gura yuwaan aciya̱yi musula̱?</para>
  <para style="q2" vid="JER 16:20">Ee, amma ele ndolo gba musula̱ n ɗa shi!&gt;&gt;<verse eid="JER 16:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JER 16:21" />A̱vu A̱sulazuva a̱ usu u damma,</para>
  <para style="q1" vid="JER 16:21">&lt;&lt;Adama o ndolo gba</para>
  <para style="q2" vid="JER 16:21">n ta lyawa le a̱ reve</para>
  <para style="q2" vid="JER 16:21">nu ucira u va̱ nu ukadu u va̱,</para>
  <para style="q1" vid="JER 16:21">waru e te reve ana,</para>
  <para style="q2" vid="JER 16:21">ala a̱ va̱ a ɗa A̱sulazuva.&gt;&gt;<verse eid="JER 16:21" /></para>
  <chapter eid="JER 16" />
  <chapter number="17" style="c" sid="JER 17" />
  <para style="s">Unusu no oforo a Yahuda</para>
  <para style="q1">
    <verse number="1" style="v" sid="JER 17:1" />A̱sulazuva a damma ta,</para>
  <para style="q2" vid="JER 17:1">&lt;&lt;A̱ she'en ta̱ unusu wa aza a Yahuda</para>
  <para style="q2" vid="JER 17:1">na̱ maɗanutsu ma̱ rumu vu ugba̱mu.</para>
  <para style="q1" vid="JER 17:1">A ɗana ta̱ nusu le na aɓaci</para>
  <para style="q2" vid="JER 17:1">aatali na ri tsa agali o okolo e le.</para>
  <para style="q1" vid="JER 17:1">A ɗana ta̱ nusu le o okolo e le,</para>
  <para style="q2" vid="JER 17:1">na avana a masa'a mo ukula̱tosu u kucci u le.<verse eid="JER 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 17:2" />Ama e le fo a ta cuwusan</para>
  <para style="q2" vid="JER 17:2">na̱ musa'a na̱ a̱shuwutsu a Ashera,</para>
  <para style="q1" vid="JER 17:2">zuzu na̱ ɗanga na ri kpa̱la̱m</para>
  <para style="q2" vid="JER 17:2">ni irumbu pici,</para>
  <para style="q2" vid="JER 17:2">na̱ zuva va agaɗi biti,<verse eid="JER 17:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 17:3" />na̱ zuva vu nsasan n va̱ mi iɗa'a,</para>
  <para style="q2" vid="JER 17:3">nu utsuru u ɗu suru</para>
  <para style="q2" vid="JER 17:3">nu uzuwa u ɗu suru,</para>
  <para style="q1" vid="JER 17:3">n ta zuwa le o o'wo itana</para>
  <para style="q2" vid="JER 17:3">i na a̱ pura̱i uba̱ta̱ uvon,</para>
  <para style="q1" vid="JER 17:3">oɓolo na̱ ba̱ta̱ va̱ a̱ga̱nda̱ a̱ a̱ma̱li a̱ ɗu,</para>
  <para style="q2" vid="JER 17:3">adama o unusu u na u ri ba̱ta̱ suru</para>
  <para style="q2" vid="JER 17:3">a̱tsuma̱ e iɗa i ɗu.<verse eid="JER 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 17:4" />Adama a̱ nusu ɗu i ta lamba</para>
  <para style="q2" vid="JER 17:4">agadu a na n ca nɗu,</para>
  <para style="q1" vid="JER 17:4">n ta zuwa ɗu tsugbashi</para>
  <para style="q2" vid="JER 17:4">e ekere a n'yuwatan n ɗu</para>
  <para style="q2" vid="JER 17:4">e iɗa i na i revei shi.</para>
  <para style="q1" vid="JER 17:4">Adama a na i 'ya̱sa̱n ta̱ upan u va̱</para>
  <para style="q2" vid="JER 17:4">waru u ta lyuwa elime</para>
  <para style="q2" vid="JER 17:4">na̱ ma̱kula̱ tsa akina hali hali.&gt;&gt;<verse eid="JER 17:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JER 17:5" />Apa ili i na A̱sulazuva a dammai,</para>
  <para style="q1" vid="JER 17:5">&lt;&lt;Una̱ u te reme vuma na zuwai ucira</para>
  <para style="q2" vid="JER 17:5">wa̱ yi e ekere a vaɗilima̱,</para>
  <para style="q1" vid="JER 17:5">za na zuwai ucira wa̱ yi a̱ lipu goon,</para>
  <para style="q2" vid="JER 17:5">za na waru okolo a̱ yi</para>
  <para style="q2" vid="JER 17:5">a vadalaa yi A̱sulazuva ucina̱.<verse eid="JER 17:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 17:6" />U to o'wo tsa atsusa a̱tsumona,</para>
  <para style="q2" vid="JER 17:6">wee ene ulyuwu we elime</para>
  <para style="q2" vid="JER 17:6">a mantsa ma na u ta̱wa̱i shi,</para>
  <para style="q1" vid="JER 17:6">u ta̱ da̱nu uba̱ta̱ o u'yewu a̱ a̱tsumona,</para>
  <para style="q2" vid="JER 17:6">e iɗa ya akpaɗi uba̱ta̱ u na za ri shi.&gt;&gt;<verse eid="JER 17:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JER 17:7" />&lt;&lt;Amma za va aba'un ɗa za na aa zuwusa</para>
  <para style="q2" vid="JER 17:7">ucira wa̱ yi uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="JER 17:7">za na A̱sulazuva a ɗa ucira wa̱ yi.<verse eid="JER 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 17:8" />U to o'wo tsu uɗanga</para>
  <para style="q2" vid="JER 17:8">u na a̱ shuwa̱i zuzu nu uɗolu,</para>
  <para style="q2" vid="JER 17:8">na buba̱ruwa̱i aralu a̱ yi a̱ tyo a̱ mini'i,</para>
  <para style="q1" vid="JER 17:8">u tsu uwwa wovon a mantsa ma na</para>
  <para style="q2" vid="JER 17:8">usuɗu u ta̱wa̱i shi,</para>
  <para style="q2" vid="JER 17:8">a̱vu'un a̱ yi a̱ tu uta̱nu mantsa biti.</para>
  <para style="q1" vid="JER 17:8">Ili i tsu ɓa̱la̱ yi a mantsa mo u'yewu shi,</para>
  <para style="q2" vid="JER 17:8">waru u tsu bula̱ a ca muwun shi.&gt;&gt;<verse eid="JER 17:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="JER 17:9" />&lt;&lt;Okolo a la'a ta̱ ili suru nsata,</para>
  <para style="q2" vid="JER 17:9">waru tapu ɗa u ri ni iwuya.</para>
  <para style="q1" vid="JER 17:9">U la'a ta̱ ucira u na za o'wo gbaga,</para>
  <para style="q2" vid="JER 17:9">zane ɗa a gura reve yi?<verse eid="JER 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 17:10" />&lt;&lt;A̱mu A̱sulazuva n tsu</para>
  <para style="q2" vid="JER 17:10">petelyuwe ta̱ okolo,</para>
  <para style="q2" vid="JER 17:10">reve mi idana majiyan,</para>
  <para style="q1" vid="JER 17:10">adama n tsupaa za suru</para>
  <para style="q2" vid="JER 17:10">a̱tyo e re wuma wa̱ yi</para>
  <para style="q2" vid="JER 17:10">na̱ linga va̱ yi.&gt;&gt;<verse eid="JER 17:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JER 17:11" />&lt;&lt;Tsa manunu ma na ma̱ va̱pa̱i okowo</para>
  <para style="q2" vid="JER 17:11">a na a̱ ri a̱za̱ a̱ yi shi,</para>
  <para style="q1" vid="JER 17:11">ne ɗa u ri e ekere a vuma na tsura̱i utsuru</para>
  <para style="q2" vid="JER 17:11">o ure u na u ri babu ulobonu.</para>
  <para style="q1" vid="JER 17:11">O uɓatsulai u wuma wa̱ yi</para>
  <para style="q2" vid="JER 17:11">utsuru'u u ta kakasa na̱ a̱yi,</para>
  <para style="q2" vid="JER 17:11">acina ukosu waru u to o'wo ulo.&gt;&gt;<verse eid="JER 17:11" /></para>
  <para style="s">Irimiya yuwan ta avasa</para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JER 17:12" />Reve n damma,</para>
  <para style="q2" vid="JER 17:12">A̱sulazuva, diga ɗe o ufaru</para>
  <para style="q1" vid="JER 17:12">vu ta̱ nden o ootogu o tsugono</para>
  <para style="q2" vid="JER 17:12">tsa tsugbain tsa̱ wu ɗe zuva,</para>
  <para style="q2" vid="JER 17:12">waru a̱vu ɗa uba̱ta̱ o upa'atan u tsu.<verse eid="JER 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 17:13" />&lt;&lt;A̱sulazuva uzuwu wo okolo a Isra'ila!</para>
  <para style="q2" vid="JER 17:13">Aza a na a lyawa nuwu suru,</para>
  <para style="q2" vid="JER 17:13">o to sowo wono.</para>
  <para style="q1" vid="JER 17:13">Aza a na a vadala nuwu</para>
  <para style="q2" vid="JER 17:13">ucina̱, a̱ ta̱ puwa̱a̱n</para>
  <para style="q2" vid="JER 17:13">tsa̱ aala a na a ɗanai a̱ ma̱bula̱,</para>
  <para style="q1" vid="JER 17:13">adama a na a kakasa ta̱ na̱ A̱sulazuva</para>
  <para style="q2" vid="JER 17:13">lyusu mini ma wuma.&gt;&gt;<verse eid="JER 17:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JER 17:14" />&lt;&lt;A̱sulazuva, yuwaan mu opocino,</para>
  <para style="q2" vid="JER 17:14">agba n to o'wo gbaga.</para>
  <para style="q1" vid="JER 17:14">Vu wawa mu,</para>
  <para style="q2" vid="JER 17:14">n ta̱ gba a̱ tsura̱ iwawi,</para>
  <para style="q1" vid="JER 17:14">adama a na a̱vu ɗa</para>
  <para style="q2" vid="JER 17:14">maa yuwusaan ica!&gt;&gt;<verse eid="JER 17:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 17:15" />A lyuwa ta̱ elime a dansaa mu,</para>
  <para style="q2" vid="JER 17:15">&lt;&lt;A̱ te ɗa gba adanshi a̱ A̱sulazuva a̱ ri?</para>
  <para style="q2" vid="JER 17:15">Lyawa u shiwan gogo!&gt;&gt;<verse eid="JER 17:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 17:16" />&lt;&lt;Amma a̱mu gba</para>
  <para style="q2" vid="JER 17:16">n suma n lyawa ulinga</para>
  <para style="q2" vid="JER 17:16">wu za va aguɓa a̱ wu shi,</para>
  <para style="q1" vid="JER 17:16">a̱vu vu reve ta̱,</para>
  <para style="q2" vid="JER 17:16">n ciga urana wa addama shi.</para>
  <para style="q1" vid="JER 17:16">Ili i na yu uta̱i diga o una̱ u va̱ suru,</para>
  <para style="q2" vid="JER 17:16">u ta alanga eteshe elime a̱ wu.<verse eid="JER 17:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 17:17" />She vo o'wo mu ili i wovon wan,</para>
  <para style="q2" vid="JER 17:17">a̱vu ɗa upa'atan u va̱</para>
  <para style="q2" vid="JER 17:17">o urana wa̱ a̱tsuma̱lima̱.<verse eid="JER 17:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 17:18" />Lyawa aza a na a casu mu</para>
  <para style="q2" vid="JER 17:18">a̱tsuma̱lima̱ o sowo wono,</para>
  <para style="q1" vid="JER 17:18">amma she vu lyawa mu</para>
  <para style="q2" vid="JER 17:18">n sowo wono wan.</para>
  <para style="q1" vid="JER 17:18">Lyawa a da'wan,</para>
  <para style="q2" vid="JER 17:18">amma she vu lyawa mu</para>
  <para style="q2" vid="JER 17:18">n dada'wan wan.</para>
  <para style="q1" vid="JER 17:18">Lyunguwa̱a̱ le</para>
  <para style="q2" vid="JER 17:18">nu urana wa̱ a̱tsuma̱lima̱</para>
  <para style="q1" vid="JER 17:18">reve vu kototo le</para>
  <para style="q2" vid="JER 17:18">nu ukototosu udoɓonuwu!&gt;&gt;<verse eid="JER 17:18" /></para>
  <para style="s">Tsutoni nu urana wa Ashibi</para>
  <para style="p">
    <verse number="19" style="v" sid="JER 17:19" />Apa ili i na A̱sulazuva a damma numu, &lt;&lt;'Ya̱wa̱ vi isawan o una̱ntsu u lyuci, uba̱ta̱ u na ngono ma Yahuda n tsu uwusa no o uta̱sa̱yi. Reve fo vi isawan a akapi a̱ na̱ntsu va̱ Urishelima suru. <verse eid="JER 17:19" /><verse number="20" style="v" sid="JER 17:20" />Reve vu damma le, &lt;Uwwai adanshi a̱ A̱sulazuva, a̱ɗu ngono ma Yahuda, na akapi ama a Yahuda suru, na akapi aza a na a̱ ri nden Urishelima, aza a na a̱ tsu kurusu na̱ na̱ntsu nda. <verse eid="JER 17:20" /><verse number="21" style="v" sid="JER 17:21" />Apa nda ili i na A̱sulazuva a dammai, i yuwan ugbozu, she i tanu itana o urana wa ashibi, ko i uwa ni itana na̱ na̱ntsu lyuci va̱ Urishelima wan. <verse eid="JER 17:21" /><verse number="22" style="v" sid="JER 17:22" />She i tanu itana yu uta̱ na̱ yi diga a 'wa ɗu o urana wa ashibi wan, ko gba i yuwan ulinga u ro o urana'a wan. O una̱ u ndolo i tawa urana wa ashibi'i wo o'wo na akiza, ununa n dammai nkaya n ɗu.<note caller="-" style="x"><char style="xo" closed="false">17:22 </char><char style="xt" closed="false"><ref loc="EXO 20:8-10">Mta̱ 20:8-10</ref>; <ref loc="DEU 5:12-14">U.Wl 5:12-14</ref>.</char></note> <verse eid="JER 17:22" /><verse number="23" style="v" sid="JER 17:23" />Amma na̱ ne suru, nkaya nɗu m poloo mu atsuvu shi, ko a̱ ka̱mbuwa̱ ugbozu shi. Amma a̱vu a yuwan aciyogbamu, adama she a uwwa ko a̱ usu tsuɓari'i shi.&gt; <verse eid="JER 17:23" /><verse number="24" style="v" sid="JER 17:24" />Amma a̱vu A̱sulazuva a damma, nna̱ i ka̱mbuwa̱ ugbozu i yuwan tsutoni na̱ mu, a̱vu i kuɗa̱ a uwa ni itana na̱ na̱ntsu u lyuci'i o urana wa ashibi, a̱vu i tawa urana wa ashibi wo o'wo na akiza, hali fo i kuɗa̱ a yuwan ulinga o urana'a, <verse eid="JER 17:24" /><verse number="25" style="v" sid="JER 17:25" />n ta̱ gba zuwa ngono nna n ri nden ootogu o tsugono tsa̱ Da̱wuda a uwa na̱ na̱ntsu u lyuci'i oɓolo na azagbain e le. Ele na azagbain e le a ta uwa zuva vi ikeke yi ido i le ni ido, ama a Yahuda a̱ shewusun le oɓolo na aza a na a̱ ri nden a̱tsuma̱ a̱ Urishelima. Waru lyuci nda ta̱ da̱na̱ na ama hali hali. <verse eid="JER 17:25" /><verse number="26" style="v" sid="JER 17:26" />Ama a̱ ta̱ ta̱wa̱ diga e ilyuci ya Yahuda na̱ mulyuci na n ri uka̱nda̱ruwu na̱ Urishelima, diga o upasu wi iɗa ya Banyami na̱ Shefela, na̱ diga o upasu u mugaɗi ma̱ a̱livu, nu upasu wi iɗa i mugaɗi oɓolo na̱ Nege, a̱ ta̱wusa̱a̱ na̱ kucci vu ukula̱tosu, ni ikucci i ro na̱ kucci vi ishina, na̱ za ma̱guru, na̱ ne'e vu ugodyusho o u'wa wa̱ A̱sulazuva. <verse eid="JER 17:26" /><verse number="27" style="v" sid="JER 17:27" />Amma ni i 'yuwan o poloo mu atsuvu, a̱vu i kuɗa̱ a tara urana wa ashibi na akiza, a̱vu i tanu itana i ro a mantsa ma na yaa zama i uwa na̱ na̱ntsu va̱ Urishelima o urana wa ashibi, to, n ta̱ gba daɓa na̱ntsu va̱ Urishelima na akina a na aa gura kimusa̱ shi, na a alyuwa ba̱ta̱ vu cira va̱ yi.&gt;&gt;<verse eid="JER 17:27" /></para>
  <chapter eid="JER 17" />
  <chapter number="18" style="c" sid="JER 18" />
  <para style="s">Iroci yi za vu uma'an vu mpondo</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 18:1" />Apa adanshi a na A̱sulazuva a yuwayin Irimiya, ana, <verse eid="JER 18:1" /><verse number="2" style="v" sid="JER 18:2" />&lt;&lt;'Yon vu zura̱ a̱ tyo uba̱ta̱ wu za vu uma'an vu mpondo. Ɗe ɗa maa ca wu ikaka i va̱.&gt;&gt; <verse eid="JER 18:2" /><verse number="3" style="v" sid="JER 18:3" />Reve n ka̱ra̱ a̱ cipa̱, n cina za vu uma'an vu mpondo'o a yuwusan uma'an wu mpondo. <verse eid="JER 18:3" /><verse number="4" style="v" sid="JER 18:4" />Ili i na u ma'asain no olo'o u la̱nga̱ ta̱ e ekere a̱ yi, a̱vu u ma'isan upondo u ro ko'o no olo'o'o ununa u cigai.<verse eid="JER 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 18:5" />Reve adanshi a̱ A̱sula̱ a̱ ta̱wa̱ uba̱ta̱ u va̱ ana, <verse eid="JER 18:5" /><verse number="6" style="v" sid="JER 18:6" />&lt;&lt;U'wa wa Isra'ila, ashe ma gura yuwan na̱ ɗu cine za vu uma'an vu mpondo nda yuwain shi? Agba a̱ yi ɗa nda cine olo'o a̱ ri e ekere aza vu uma'an, ne ɗa a̱ɗu fo i ri e ekere a̱ va̱, a̱ɗu ama a Isra'ila. <verse eid="JER 18:6" /><verse number="7" style="v" sid="JER 18:7" />A mantsa ma na n yuwain aɗa e iɗa suru, ko tsugono tso ro na ma̱ mula̱ ko n lungusa̱ ko n kototo, <verse eid="JER 18:7" /><verse number="8" style="v" sid="JER 18:8" />nna̱ iɗa i na n yuwain adama aɗa e le o ndolo'o n vadala diga e iwuya i le, to, n ta vadala majiyan ma̱ va̱, a̱vu n tawa addama a na n shi n foɓoi a aci e le. <verse eid="JER 18:8" /><verse number="9" style="v" sid="JER 18:9" />Agba mantsa ma na suru n yuwain adanshi adama e iɗa suru ko tsugono tsa na ma̱ 'ya̱sa̱n ko n shuwa̱, <verse eid="JER 18:9" /><verse number="10" style="v" sid="JER 18:10" />nna̱ u yuwan iwuya elime a̱ va̱, reve u 'yuwan na waa uwwa adanshi a̱ va̱, to, n ta vadala ifoɓi isa'ani i va̱ na shi n foɓoi na ma̱a̱ ta̱wa̱a̱ yi.&gt;&gt;<verse eid="JER 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 18:11" />&lt;&lt;Gogo vu yuwan adanshi na ama a Yahuda na aza a na a̱ ri nden a̱tsuma̱ a̱ Urishelima vu damma le, &lt;Apa ili i na A̱sulazuva a dammai, ka̱lyuwa̱, n ta̱ e ifoɓi i na ma̱a̱ ta̱wa̱ ɗu na addama waru n foɓo ta̱ iwuya adama a̱ ɗu. Gogo she za suru vadala diga o ure wi iwuya ya̱ yi, waru u lapula re va̱ yi na̱ linga va̱ yi.&gt; <verse eid="JER 18:11" /><verse number="12" style="v" sid="JER 18:12" />Amma a̱ ta̱ usu a damma, &lt;U ri nu urana shi! Tsu ta lyuwa elime ni ili i na okolo a̱ tsu a cigai, za suru a̱tsuma̱ a̱ tsu ta̱ toni aciyogbamu o okolo a̱ yi vi iwuya.&gt; &gt;&gt;<verse eid="JER 18:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JER 18:13" />&lt;&lt;Adama o ndolo,</para>
  <para style="q2" vid="JER 18:13">apa ili i na A̱sulazuva a dammai,</para>
  <para style="q2" vid="JER 18:13">vu yuwan yeci a̱tsuma̱ a nɗa,</para>
  <para style="q1" vid="JER 18:13">zane ɗa uwwai ɗe cu'un nda?</para>
  <para style="q2" vid="JER 18:13">Isra'ila yuwan ta̱ iwuya lon!<verse eid="JER 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 18:14" />Mini ma atayan ma masasan</para>
  <para style="q2" vid="JER 18:14">ma̱ Lebanon ma kasa ta̱</para>
  <para style="q2" vid="JER 18:14">na atali a masasa'an?</para>
  <para style="q1" vid="JER 18:14">Ko mini mo uta̱nu ma̱ yi na ri</para>
  <para style="q2" vid="JER 18:14">e meyene diga alanga</para>
  <para style="q2" vid="JER 18:14">kuɗa̱ ta̱ na e yene?<verse eid="JER 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 18:15" />Amma na̱ ne suru,</para>
  <para style="q2" vid="JER 18:15">ama a̱ va̱ e icina ta̱ na̱ a̱mu,</para>
  <para style="q1" vid="JER 18:15">a̱ kula̱towa̱a̱ ta̱</para>
  <para style="q2" vid="JER 18:15">musula̱ n vama a̱tsuka̱.</para>
  <para style="q1" vid="JER 18:15">Aza a na a zuwa nle a̱ ta̱ɗa̱tsa̱i a̱ re le,</para>
  <para style="q2" vid="JER 18:15">a̱tsuma̱ a̱ re vu ufaru le.</para>
  <para style="q1" vid="JER 18:15">A zuwa le ta̱ a yuwan mmalu</para>
  <para style="q2" vid="JER 18:15">a̱tsuma̱ o ure u na u ri ulobonu shi,</para>
  <para style="q2" vid="JER 18:15">a̱tsuma̱ o ure u na wuntsayi shi,</para>
  <para style="q2" vid="JER 18:15">a̱tsuma̱ a̱ re na o foɓoi shi.<verse eid="JER 18:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 18:16" />Adama o ndolo iɗa ya aza a Yahuda</para>
  <para style="q2" vid="JER 18:16">i to o'wo okongo,</para>
  <para style="q2" vid="JER 18:16">ni ili i macuru hali hali.</para>
  <para style="q1" vid="JER 18:16">Aza a na a̱ ka̱ra̱sa̱ lo suru,</para>
  <para style="q2" vid="JER 18:16">a ta yuwan asalama</para>
  <para style="q2" vid="JER 18:16">reve a gbaɗatsa aaci.<verse eid="JER 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 18:17" />Cine upepu wa asana</para>
  <para style="q2" vid="JER 18:17">u tsu lapa ma̱buta̱,</para>
  <para style="q1" vid="JER 18:17">ne ɗa me bete'we e le</para>
  <para style="q2" vid="JER 18:17">elime a n'yuwatan n le.</para>
  <para style="q1" vid="JER 18:17">N ta vadalaa le ucina̱</para>
  <para style="q2" vid="JER 18:17">mo roco le urewesu u va̱ shi,</para>
  <para style="q2" vid="JER 18:17">a̱tsuma̱ o urana wa addama e le.&gt;&gt;<verse eid="JER 18:17" /></para>
  <para style="s">Ifoɓi adama a na o una Irimiya</para>
  <para style="p">
    <verse number="18" style="v" sid="JER 18:18" />Reve ama a Yahuda a dammulai va̱ni le ana, &lt;&lt;Ta̱wa̱i, tsu yuwain ifoɓi a aci a Irimiya, adama uritosu u wila̱ wa Musa u na nan ganu a yuwain nu ucasu wa̱ a̱sa̱la̱ wa̱ a̱za̱ o urevu, oɓolo na adanshi diga uba̱ta̱ wa ama̱sula̱ puwa̱n wan. Adama o ndolo ta̱wa̱i, tsu la'a niyi nu una̱, she tsu poloi atsuvu e ili i na waa dansa wan.&gt;&gt;<verse eid="JER 18:18" /></para>
  <para style="s">Avasa a Irimiya</para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JER 18:19" />&lt;&lt;Reve Irimiya yuwan avasa u damma,</para>
  <para style="q2" vid="JER 18:19">A̱sulazuva vu poloo mu atsuvu,</para>
  <para style="q2" vid="JER 18:19">vu uwwa ili i na n'yuwatan n va̱ maa dansa!<verse eid="JER 18:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 18:20" />U lobono ta̱ a tsupa isa'ani ni iwuya?</para>
  <para style="q2" vid="JER 18:20">Na̱ ne suru a̱ ka̱pa̱a̱ ta̱</para>
  <para style="q2" vid="JER 18:20">wuma u va̱ a̱ka̱ri e iwuya.</para>
  <para style="q1" vid="JER 18:20">Vu cuwan cine mi isawain elime a̱ wu</para>
  <para style="q2" vid="JER 18:20">na n yuwain adanshi o una̱ u le,</para>
  <para style="q2" vid="JER 18:20">adama vu tawa upan wa̱ wu a aci e le.<verse eid="JER 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 18:21" />Amma gogo gba,</para>
  <para style="q2" vid="JER 18:21">vu ta̱wa̱a̱ muwun n le na ambulu,</para>
  <para style="q2" vid="JER 18:21">vu zuwa o una le na̱ matsun me pe'eni.</para>
  <para style="q1" vid="JER 18:21">Lyawa a̱ma̱ci e le a lamba muwun nle,</para>
  <para style="q2" vid="JER 18:21">o o'wo nruna̱.</para>
  <para style="q1" vid="JER 18:21">Lyawa o una ali e le,</para>
  <para style="q2" vid="JER 18:21">a̱vu fo o una olobo e le</para>
  <para style="q2" vid="JER 18:21">na̱ matsun me pe'eni uba̱ta̱ o uvon.<verse eid="JER 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 18:22" />Lyawa a uwwa mesun a 'wa le</para>
  <para style="q2" vid="JER 18:22">mantsa ma na vu ta̱wa̱yi</para>
  <para style="q2" vid="JER 18:22">na aza a na a̱ riya̱a̱ le nu uta̱.</para>
  <para style="q1" vid="JER 18:22">Adama a na a̱ ka̱pa̱ ta̱ a̱ka̱ri e iwuya</para>
  <para style="q2" vid="JER 18:22">adama e reme mu,</para>
  <para style="q1" vid="JER 18:22">reve fo azu maza</para>
  <para style="q2" vid="JER 18:22">adama e reme ana a̱ va̱.<verse eid="JER 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 18:23" />Amma a̱vu A̱sulazuva, vu reve ta̱</para>
  <para style="q2" vid="JER 18:23">ni ifoɓi i iwuya i le suru</para>
  <para style="q2" vid="JER 18:23">na a cigai o una mu.</para>
  <para style="q1" vid="JER 18:23">She vu yuwaan le gafura</para>
  <para style="q2" vid="JER 18:23">vi iwuya i na a yuwain wan,</para>
  <para style="q1" vid="JER 18:23">ko vu ta'asa nusu le</para>
  <para style="q2" vid="JER 18:23">diga a̱ ma̱ka̱ka̱n ma̱ wu wan.</para>
  <para style="q1" vid="JER 18:23">Lyawa a tawa le elime a̱ wu,</para>
  <para style="q2" vid="JER 18:23">vu ge'eto le a mantsa</para>
  <para style="q2" vid="JER 18:23">ma na vu ri o upan!&gt;&gt;<verse eid="JER 18:23" /></para>
  <chapter eid="JER 18" />
  <chapter number="19" style="c" sid="JER 19" />
  <para style="s">Iroci i meden ma na mo ɓosoi</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 19:1" />Apa ili i na A̱sulazuva a dammai, &lt;&lt;'Ya̱wa̱ vu tsula meden uba̱ta̱ wu za vu uma'an. Vu tara ozo o ro diga a̱tsuma̱ a mbara ma ama na̱ a̱tsuma̱ a nan ganu. <verse eid="JER 19:1" /><verse number="2" style="v" sid="JER 19:2" />Vu ka̱ra̱ a̱ tyo o Uka̱ri wa Ben Hinom o Uwata wa Ayimba. Lo ɗa va yuwan adanshi e ili i na ma damma wu.<note caller="-" style="x"><char style="xo" closed="false">19:2 </char><char style="xt" closed="false"><ref loc="2KI 23:10">2 Ngo 23:10</ref>; <ref loc="JER 7:30-32">Irm 7:30-32</ref>; <ref loc="JER 32:34-35">32:34-35</ref>.</char></note> <verse eid="JER 19:2" /><verse number="3" style="v" sid="JER 19:3" />Reve vu damma, &lt;Uwwai adanshi a̱ A̱sulazuva, a̱ɗu ngono ma Yahuda na̱ nda̱na̱ta̱ ma Urishelima. Apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva A̱sula̱ a Isra'ila a dansa, i polo atsuvu! N ta̱ ta̱wa̱ na addama uba̱ta̱ u nda, za na uwwai biti, lipu va̱ yi ta̱ je'en lon. <verse eid="JER 19:3" /><verse number="4" style="v" sid="JER 19:4" />Adama a na ama a nda a lyawa mu ta̱, reve a̱ ka̱mba̱to uba̱ta̱ u nda, uba̱ta̱ u musula̱ mo omoci, a ca ta̱ kucci vu ukula̱tosu uba̱ta̱'a̱ a̱ tyo uba̱ta̱ u musula̱. Musula̱ nna ko le, ko nkaya nle ko ngono ma Yahuda nle e revei shi. Reve fo o shiton uba̱ta̱ u nda na̱ mpasa ma aza a babu unusu. <verse eid="JER 19:4" /><verse number="5" style="v" sid="JER 19:5" />A̱vu waru a suwa ba̱ta̱ va̱ a̱ga̱nda̱ va Ba'al adama a na a ca kucci vu ukula̱tosu u muwun nle va akina, udammu u na n ca yi shi, ko wila̱ shi, waru n yuwan majiyan ma̱ yi shi<note caller="-" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="LEV 18:21">N.Gn 18:21</ref>.</char></note>. <verse eid="JER 19:5" /><verse number="6" style="v" sid="JER 19:6" />Adama o ndolo i da̱na̱ nu urevu, mantsa ma̱ ta̱ lo a̱ ta̱wa̱ na a̱ da̱shi ɗe uba̱ta̱ u nda Tofe ko Uka̱ri wa Ben Hinom shi, amma a̱ ta̱ ɗe yi Uka̱ri u wocosu wu mpasa. Ne ɗa A̱sulazuva a dammai. <verse eid="JER 19:6" /><verse number="7" style="v" sid="JER 19:7" />N ta̱ ka̱mbuwa̱ ifoɓi ya Yahuda na̱ Urishelima ili ya̱ pere uba̱ta̱ u nda. N ta zuwa n'yuwatan nle o una le na̱ matsun me pe'eni, amayun n ta zuwa le a̱ riya̱ e ekere aza a na a zama wuma u le o una le. N ta zuwa a̱kwa̱kwa̱ a̱ lipu le wo o'wo ilyalya yi nnunu ni inama yu una. <verse eid="JER 19:7" /><verse number="8" style="v" sid="JER 19:8" />N ta̱ ka̱mbuwa̱ lyuci nda okongo ni ili i wovon ni ili i macuru. Za na ka̱ra̱la̱i lo uba̱ta̱'a̱ u ta lamba ili i na wa damma reve u cira adama addama a na a cinai lyuci'i. <verse eid="JER 19:8" /><verse number="9" style="v" sid="JER 19:9" />N ta zuwa le a tama inama i muwun nle yo olobo ne esheli, a̱ ta̱ gba a tama inama i lipu i le yi nron mu nden nle a mantsa ma na a̱tsuma̱lima̱ a̱ ka̱nda̱ruwa̱ nle, na n'yuwatan nle n ta̱wa̱a̱ nle aza a na a zama wuma u le.&gt; &gt;&gt;<verse eid="JER 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 19:10" />Reve A̱sulazuva a lyuwa elime u damma,&lt;&lt;Vu ɓoso mede'en esu aza a na a̱ shewun nuwu e le a̱ka̱nla̱. <verse eid="JER 19:10" /><verse number="11" style="v" sid="JER 19:11" />A̱vu vu damma le, &lt;Ununa vu ɓosoi mede'en hali na u ri n lapula shi, ne ɗa a̱mu A̱sulazuva o oɓolo a̱ a̱soja a zuva moo kototo ama a̱ lyuci a nda. A̱ ta̱ ciɗo ama a Tofe hali she nu uba̱ta̱ wa̱ ciɗa̱ a̱ ka̱la̱ma̱. Ne ɗa A̱sulazuva a dammai. <verse eid="JER 19:11" /><verse number="12" style="v" sid="JER 19:12" />To, gogo apa ili i na ma yuwan nu uba̱ta̱ u nda, na aza a na a̱ ri nden pa, n ta̱ gba ka̱mba̱to lyuci nda tsa̱ Tofe, ne ɗa A̱sulazuva a dammai. <verse eid="JER 19:12" /><verse number="13" style="v" sid="JER 19:13" />'Wa na ri Urishelima na̱ za vu ngono ma Yahuda, o to o'woto le idaba tsa Tofe, oɓolo na̱ 'wa na aa casu kucci vu kula̱tosu wi ili i ma̱guru zuva va asula e igungu biti a̱ tyo uba̱ta̱ italyo'o ya zuva waru a casu kucci vi ili yo oso uba̱ta̱ u musula̱ n ro.&gt; &gt;&gt;<verse eid="JER 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 19:14" />Reve Irimiya ka̱mba̱ diga Tofe, uba̱ta̱ u na A̱sulazuva a̱ lyungu niyi na wa yuwan adanshi e ikaka, reve wi isawan okowo wu u'wa wa̱ A̱sulazuva u damma ama'a suru, <verse eid="JER 19:14" /><verse number="15" style="v" sid="JER 19:15" />&lt;&lt;Apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva A̱sula̱ a Isra'ila dammai, &lt;Uwwai! A̱yi ɗa nda n ta̱ ta̱wa̱a̱ lyuci nda na̱ nda̱na̱ta̱ nle suru na addama a na n dammai a aci le, adama a na a̱ 'ya̱sa̱n mu ta̱ aci, waru o polo atsuvu e idanshi i va̱ shi.&gt; &gt;&gt;<verse eid="JER 19:15" /></para>
  <chapter eid="JER 19" />
  <chapter number="20" style="c" sid="JER 20" />
  <para style="s">Pashu ganu ɓara ta̱ Irimiya</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 20:1" />Ana Pashu ganu ulobo wa Imme, zagbain vu ulinga wu u'wa wa̱ A̱sulazuva, uwwai Irimiya adanshi e ikaka i nda, <verse eid="JER 20:1" /><verse number="2" style="v" sid="JER 20:2" />reve u zuwa a kada Irimiya vumava̱sula̱, reve u zuwa yi gba, a̱vu a zuwai o na̱ntsu wa Zuva va Banyami o u'wa wa̱ A̱sulazuva. <verse eid="JER 20:2" /><verse number="3" style="v" sid="JER 20:3" />Ana usana u tawai, a mantsa ma na Pashu tawai ana Irimiya diga a̱tsuma̱ akpata a na a̱ guzusa̱ ana'a, a̱vu Irimiya damma yi, &lt;&lt;A̱sulazuva a̱ da̱shi ɗe wu na aala Pashu shi, amma na aala Magomisabi.<note caller="+" style="f"><char style="fr" closed="false">20:3 </char><char style="fq" closed="false">Magomisabi </char><char style="ft" closed="false">Ureve wa aala a nda a̱ yi ɗa wovon uba̱ta̱ suru.</char></note> <verse eid="JER 20:3" /><verse number="4" style="v" sid="JER 20:4" />Adama a na apa ili i na A̱sulazuva a dammai, &lt;N ta zuwa vo o'wo ili i wovon wa aciya̱wu, na̱ n'utsa̱ ma̱ wu suru. Ne esu a̱ wu a ɗa vee ene matsun me pe'eni ma n'yuwatan o kototosu le. N ta ca ama a Yahuda suru e ekere o mogono ma Babila, za na a̱ pura̱ le suru a̱ tyo tsugbashi a Babila, reve fo wu una le na̱ matsun me pe'eni. <verse eid="JER 20:4" /><verse number="5" style="v" sid="JER 20:5" />N ta ca n'yuwatan nle suru utsuru u lyuci u nda, ni itana ya̱ yi suru, ni ili ya awina i le suru, ni itana isa'ani i le suru, nu utsuru wu ngono ma Yahuda suru. A̱ ta̱ pura̱ le tsi itana i na a̱ pura̱i uba̱ta̱ o uvon a̱ tyo iɗa ya Babila tsugbashi. <verse eid="JER 20:5" /><verse number="6" style="v" sid="JER 20:6" />Agba a̱vu Pashu, na ama a na a̱ ri o u'wa wa̱ wu suru, a̱ ta̱ a̱ tyowetyo ɗu tsugbashi a Babila. Ɗe ɗa ya̱ kuwa̱, waru ɗe ɗa a̱ ciɗo ɗu, a̱vu na̱ n'utsa̱ ma̱ wu suru, aza a na vu yuwayin adanshi e ikaka ye epen.&gt; &gt;&gt;<verse eid="JER 20:6" /></para>
  <para style="s">Irimiya showen ta̱ A̱sulazuva</para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="JER 20:7" />&lt;&lt;A̱sulazuva vu luluma̱ mu ta̱,</para>
  <para style="q2" vid="JER 20:7">waru mu uwwa ta̱ wulumu'u.</para>
  <para style="q1" vid="JER 20:7">Vu la'a mu ta̱ ucira,</para>
  <para style="q2" vid="JER 20:7">waru vu lyuwa ta̱ aci a̱ va̱.</para>
  <para style="q1" vid="JER 20:7">Mo o'wo ta̱ ili yi izo'oshi</para>
  <para style="q2" vid="JER 20:7">urana ma̱ɓula̱,</para>
  <para style="q1" vid="JER 20:7">waru za suru</para>
  <para style="q2" vid="JER 20:7">ta yuwusaan mu ulamu.<verse eid="JER 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 20:8" />A mantsa ma na</para>
  <para style="q2" vid="JER 20:8">maa yuwan adanshi suru,</para>
  <para style="q1" vid="JER 20:8">n tsu 'ya̱sa̱n ta̱</para>
  <para style="q2" vid="JER 20:8">uɗyo n yuwan adanshi</para>
  <para style="q2" vid="JER 20:8">nu ucira n damma,</para>
  <para style="q1" vid="JER 20:8">u'ya̱susa̱n wu ugbozu</para>
  <para style="q2" vid="JER 20:8">nu ukototosu goon.</para>
  <para style="q1" vid="JER 20:8">Adama o ndolo a ɗa</para>
  <para style="q2" vid="JER 20:8">adanshi a̱ A̱sulazuva</para>
  <para style="q2" vid="JER 20:8">a̱ ta̱wa̱a̱ numu na̱ wisulusa</para>
  <para style="q2" vid="JER 20:8">na avandaru urana ma̱ɓula̱.&gt;&gt;<verse eid="JER 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 20:9" />Amma nna̱ n damma,</para>
  <para style="q2" vid="JER 20:9">&lt;&lt;Mee ɗe ala a̱ A̱sulazuva shi,</para>
  <para style="q1" vid="JER 20:9">ko n da̱shi yuwan</para>
  <para style="q2" vid="JER 20:9">adanshi na ala'a shi,&gt;&gt;</para>
  <para style="q1" vid="JER 20:9">reve mu uwwa adanshi a̱ yi</para>
  <para style="q2" vid="JER 20:9">a̱tsuma̱ a̱ va̱ va damma akina,</para>
  <para style="q1" vid="JER 20:9">tsa akina a na</para>
  <para style="q2" vid="JER 20:9">a tamusa etele a̱ va̱.</para>
  <para style="q1" vid="JER 20:9">N kuna̱ ta̱</para>
  <para style="q2" vid="JER 20:9">a tsutsugbusa yi a̱tsuma̱ a̱ va̱,</para>
  <para style="q2" vid="JER 20:9">na amayun ma gura shi.<verse eid="JER 20:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 20:10" />Mu uwwa ta̱ ama na̱ a̱bunda̱</para>
  <para style="q2" vid="JER 20:10">a̱ yemenu adansa,</para>
  <para style="q2" vid="JER 20:10">&lt;&lt;U'ya̱susa̱n wu ugbozu mɓa̱nga̱ biti!&gt;&gt;</para>
  <para style="q1" vid="JER 20:10">Waru a dansa,</para>
  <para style="q2" vid="JER 20:10">&lt;&lt;Tsu 'ya̱wa̱i na adanshi a̱yi!</para>
  <para style="q2" vid="JER 20:10">Naa amayun,</para>
  <para style="q2" vid="JER 20:10">tsu 'ya̱wa̱i na adanshi a̱yi!&gt;&gt;</para>
  <para style="q1" vid="JER 20:10">N'utsa̱ n va̱ suru</para>
  <para style="q2" vid="JER 20:10">a ta pura a̱risa̱ a̱ va̱.</para>
  <para style="q1" vid="JER 20:10">Waru a ta dansa,</para>
  <para style="q2" vid="JER 20:10">&lt;&lt;U ta gura wo o'wo</para>
  <para style="q2" vid="JER 20:10">a̱ luluma̱ yi,</para>
  <para style="q1" vid="JER 20:10">adama tsu lyuwa aci a̱ yi,</para>
  <para style="q2" vid="JER 20:10">tsu tsupa.&gt;&gt;<verse eid="JER 20:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 20:11" />&lt;&lt;Amma A̱sulazuva</para>
  <para style="q2" vid="JER 20:11">a̱ ta̱ oɓolo na̱ mu,</para>
  <para style="q2" vid="JER 20:11">tsa yali yu uvon.</para>
  <para style="q1" vid="JER 20:11">Adama o ndolo n'yuwatan n va̱</para>
  <para style="q2" vid="JER 20:11">n ta̱ ta̱ɗa̱tsa̱,</para>
  <para style="q2" vid="JER 20:11">waru a lyuwa aci a̱ va̱ shi.</para>
  <para style="q1" vid="JER 20:11">A̱ ta̱ riya̱ a̱vu o sowo wono lon,</para>
  <para style="q2" vid="JER 20:11">a̱a̱ da̱shi e icina nu ulambu</para>
  <para style="q2" vid="JER 20:11">u tsutoni tsa̱ e le shi.<verse eid="JER 20:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 20:12" />A̱sulazuva oɓolo a̱ a̱soja a zuva,</para>
  <para style="q2" vid="JER 20:12">zana tsu lyungwa̱ a̱za̱ a̱ a̱ɓula̱,</para>
  <para style="q1" vid="JER 20:12">zana tse ene okolo,</para>
  <para style="q2" vid="JER 20:12">oɓolo na̱ majiyan ma vaɗilima̱,</para>
  <para style="q1" vid="JER 20:12">lyawa me ene atsupu a̱ wu a aci e le,</para>
  <para style="q2" vid="JER 20:12">adama a na ya̱'a̱ wu ɗa,</para>
  <para style="q2" vid="JER 20:12">n ta̱wa̱i na adanshi a̱ va̱.<verse eid="JER 20:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 20:13" />Canayi A̱sulazuva ishipa!</para>
  <para style="q2" vid="JER 20:13">Cuwai A̱sulazuva!</para>
  <para style="q1" vid="JER 20:13">Adama a na u tsu wawusa ta̱</para>
  <para style="q2" vid="JER 20:13">aza a na a cigai ikambishi,</para>
  <para style="q1" vid="JER 20:13">diga e ekere aza a na</para>
  <para style="q2" vid="JER 20:13">a yuwusan iwuya.&gt;&gt;<verse eid="JER 20:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JER 20:14" />&lt;&lt;Lyawa una̱ u reme</para>
  <para style="q2" vid="JER 20:14">urana u na a matsan numu!</para>
  <para style="q1" vid="JER 20:14">She urana u na mma va̱ matsa numu</para>
  <para style="q2" vid="JER 20:14">da̱na̱ na aba'un wan!&gt;&gt;<verse eid="JER 20:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 20:15" />Za na a yuwayin una̱ ɗa</para>
  <para style="q2" vid="JER 20:15">za na 'ya̱wa̱i na aɗa</para>
  <para style="q2" vid="JER 20:15">a limatan va̱</para>
  <para style="q2" vid="JER 20:15">uba̱ta̱ wa abara a̱ va̱,</para>
  <para style="q1" vid="JER 20:15">za na zuwai abara a̱ va̱</para>
  <para style="q2" vid="JER 20:15">a yuwain ma̱za̱nga̱ a dansa,</para>
  <para style="q2" vid="JER 20:15">&lt;&lt;A matsaan wu ta̱ ulobo!&gt;&gt;<verse eid="JER 20:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 20:16" />&lt;&lt;Lyawa vuma ndolo o'wo</para>
  <para style="q2" vid="JER 20:16">tse ilyuci i na A̱sulazuva</para>
  <para style="q2" vid="JER 20:16">a̱ mula̱i babu ene iliyali.</para>
  <para style="q1" vid="JER 20:16">Lyawa wu uwwa yisali nu usana,</para>
  <para style="q2" vid="JER 20:16">waru wu uwwa yisali</para>
  <para style="q2" vid="JER 20:16">yu uvon nu urana,<verse eid="JER 20:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 20:17" />ana wo o'woi u kototo mu,</para>
  <para style="q2" vid="JER 20:17">a̱mu a̱tsuma̱ a̱a̱tsuma̱ shi.</para>
  <para style="q1" vid="JER 20:17">U shi ta la'a a damma,</para>
  <para style="q2" vid="JER 20:17">a̱a̱tsuma̱ a mma va̱</para>
  <para style="q2" vid="JER 20:17">wo o'wo aason a̱ va̱,</para>
  <para style="q1" vid="JER 20:17">a̱a̱tsuma̱ a̱yi waru</para>
  <para style="q2" vid="JER 20:17">a̱ da̱na̱ mgbain hali hali.<verse eid="JER 20:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 20:18" />Adama nye mu uta̱i</para>
  <para style="q2" vid="JER 20:18">a̱tsuma̱ a̱a̱tsuma̱ a mma va̱,</para>
  <para style="q1" vid="JER 20:18">na mee ene a̱tsuma̱lima̱</para>
  <para style="q2" vid="JER 20:18">na̱ a̱tsumola̱ngu,</para>
  <para style="q1" vid="JER 20:18">waru n koto rana va̱,</para>
  <para style="q2" vid="JER 20:18">a̱tsuma̱ a̱tsuma̱ o wono?&gt;&gt;<verse eid="JER 20:18" /></para>
  <chapter eid="JER 20" />
  <chapter number="21" style="c" sid="JER 21" />
  <para style="s">A̱sula̱ a 'yuwan ta̱ a̱ usu ipati ya̱ Zedekiya</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 21:1" />Apa adanshi a na A̱sulazuva a dammai Irimiya, a mantsa ma na Zedekiya mogono ma̱ lyunguwa̱yi Pashu ulobo wa Malkiya oɓolo na̱ Zafaniya ganu ulobo wa Ma'aseya ni ikaka a damma Irimiya, <verse eid="JER 21:1" /><verse number="2" style="v" sid="JER 21:2" />&lt;&lt;Patiya tsu A̱sulazuva, a na wo o'woi Nebukanaza mogono ma Babila ma̱ ta̱ ta̱wusa̱a̱ tsu nu uvon. U ta gura wo o'wo A̱sulazuva a ta yuwaan tsu ulinga wa asalama o ro, ununa u tsu yuwusan, za na a zuwa Nebukanaza'a u tawa ekere a̱ yi.&gt;&gt;<verse eid="JER 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 21:3" />Amma Irimiya usu le ta̱ u damma, &lt;&lt;Dammai Zedekiya, <verse eid="JER 21:3" /><verse number="4" style="v" sid="JER 21:4" />apa ili i na A̱sulazuva A̱sula̱ a aza a Isra'ila a dammai, ka̱lyuwa̱, n ta vadaluwa itana yu uvon i na i ri ekere a̱ ɗu, aza a na yaa yuwusan ulinga ne le i yuwan uvon na̱ mogono ma Babila na aza a Babila, ama a na a̱ ka̱nda̱ruwa̱i ukari u lyuci ɗu. Reve m ɓoloto ama'a e memere ma̱ lyuci gbain nda. <verse eid="JER 21:4" /><verse number="5" style="v" sid="JER 21:5" />A̱mu na aciya̱va̱ n ta yuwan nla̱ngi na̱ ɗu, nu ukere wu ucira u va̱, oɓolo na̱ linga va asalama, nu upan, na asuvu usuɗuwu, nu upan wu usuɗuwu lon. <verse eid="JER 21:5" /><verse number="6" style="v" sid="JER 21:6" />Waru n ta faba aza a na a̱ ri na̱ nden a̱ lyuci gbain nda, ama ni inama yu una suru a̱ ta̱ kuwa̱, o ure wu mɓa̱la̱ n vama nda. <verse eid="JER 21:6" /><verse number="7" style="v" sid="JER 21:7" />Reve A̱sulazuva a damma, na̱ a̱yi ndolo koto, n ta tara Zedekiya mogono ma Yahuda oɓolo na azagbain a̱yi, na ama a na a̱ ri pe a̱ lyuci gbai'in aza a na a la'ai uba̱ta̱ a̱ mɓa̱la̱ n vama nda'a, na̱ matsun me pe'eni na ambulu reve n ca le e ekere a Nebukanaza mogono ma Babila, oɓolo ne e ekere a n'yuwatan nle aza a na a zama wuma u le. Mogono'o u to kototo le na̱ matsun me pe'eni. Wa lyawa le shi, waru we ene iliyali i le shi, ko u jibaa le shi.&gt;&gt;<verse eid="JER 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 21:8" />&lt;&lt;Na̱ ne suru, reve A̱sulazuva a damma n damma ama a nda'a, &lt;Apa ili i na A̱sulazuva a dammai, ka̱lyuwa̱i, n foɓo ta̱ re re elime a̱ ɗu na yaa ɗangula, ure u na ya la'a nu ure u na ya̱ kuwa̱. <verse eid="JER 21:8" /><verse number="9" style="v" sid="JER 21:9" />Za na suru da̱nuyi a̱ lyuci gbain nda'a u ta̱ kuwa̱ na̱ matsun me pe'eni, na ambulu na̱ mɓa̱la̱ n vama. Amma za na suru uta̱i u cayi aciya̱yi e ekere aza a Babila aza a na a̱ ka̱nda̱ruwa̱ nɗu nu uvon, u ta la'ato wuma wa̱ yi. <verse eid="JER 21:9" /><verse number="10" style="v" sid="JER 21:10" />Adama a na a̱mu A̱sulazuva n zuwa ta̱ urewesu u va̱ a̱ lyuci gbain nda'a adama o ukototosu, waru adama e isa'ani shi, n ta ca yi e ekere o mogono ma Babila, waru a̱yi ɗa wa̱a̱ kula̱to yi na akina.&gt; &gt;&gt; Ne ɗa A̱sulazuva a dammai.<verse eid="JER 21:10" /></para>
  <para style="s">Ikaka i tsushu'un na̱ ngono ma Yahuda</para>
  <para style="p">
    <verse number="11" style="v" sid="JER 21:11" />&lt;&lt;Reve A̱sulazuva a damma mu, n damma u'wa u tsugono tsa Yahuda, uwwai adanshi a̱ A̱sulazuva, <verse eid="JER 21:11" /><verse number="12" style="v" sid="JER 21:12" />a̱vu u'wa wa Da̱wuda, apa ili i na A̱sulazuva a dammai!</para>
  <para style="b" vid="JER 21:12" />
  <para style="q1" vid="JER 21:12">&lt;&lt;I yuwan isa'ani usana suru,</para>
  <para style="q2" vid="JER 21:12">waru i wawa za na o ɓongishi,</para>
  <para style="q2" vid="JER 21:12">za na a yuwain wivu,</para>
  <para style="q1" vid="JER 21:12">adama she upan u va̱ u ɓa̱tsa̱ tsa akina</para>
  <para style="q2" vid="JER 21:12">u lyuwa elime na alya</para>
  <para style="q2" vid="JER 21:12">waru babu za na a gura kimusa̱ yi,</para>
  <para style="q2" vid="JER 21:12">adama a linga vi iwuya i ɗu wan.<verse eid="JER 21:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 21:13" />Ka̱lyuwa̱i, agba a̱ yi ɗa nda</para>
  <para style="q2" vid="JER 21:13">n ta̱ nla̱ngi na̱ ɗu,</para>
  <para style="q1" vid="JER 21:13">a̱ɗu aza na i ri nden zuva vu uka̱ri,</para>
  <para style="q2" vid="JER 21:13">a̱ɗu na i ri nden agalaci atali,</para>
  <para style="q1" vid="JER 21:13">a̱ɗu na yaa dansa,</para>
  <para style="q2" vid="JER 21:13">zane ɗa a gura zura̱ a̱ tyo ya̱'a̱ tsu,</para>
  <para style="q1" vid="JER 21:13">zane ɗa a gura uwa</para>
  <para style="q2" vid="JER 21:13">ba̱ta̱ vu ucira tsu?</para>
  <para style="qr" vid="JER 21:13">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 21:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 21:14" />N ta̱ ge'eto ɗu</para>
  <para style="q2" vid="JER 21:14">o una̱ wu linga ɗu,</para>
  <para style="q1" vid="JER 21:14">n ta daɓa a̱a̱rumbu a̱ ɗu na akina,</para>
  <para style="q2" vid="JER 21:14">adama u kula̱to ili i na i ri</para>
  <para style="q2" vid="JER 21:14">uka̱nda̱ruwu na̱ yi suru.&gt;&gt;</para>
  <para style="qr" vid="JER 21:14">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 21:14" /></para>
  <chapter eid="JER 21" />
  <chapter number="22" style="c" sid="JER 22" />
  <para style="s">Uge'etosu a aci o ngono me iwuya</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 22:1" />Apa ili i na A̱sulazuva a dammai, &lt;&lt;Irimiya, ka̱ra̱ a̱cipa̱ o ukobu u mogono ma Yahuda reve vu damma ɗe adanshi a nda, <verse eid="JER 22:1" /><verse number="2" style="v" sid="JER 22:2" />&lt;Uwwa adanshi a̱ A̱sulazuva, a̱vu mogono ma Yahuda, a̱vu za na vu da̱nuyi ootogu o tsugono tsa̱ Da̱wuda, a̱vu na azagbain a̱ wu, oɓolo na ama a̱ wu a na a uwusa na̱ na̱ntsu nda.&gt; <verse eid="JER 22:2" /><verse number="3" style="v" sid="JER 22:3" />&lt;Apa ili i na A̱sulazuva a dammai, i yuwan ili i na i ri amayun na̱ mejege. I wawa za na a yuwain a'usa diga ekere a̱za̱ o ɓongishi. Waru she i yuwaan omocin ili yu uwuyanu ko i palaa yi wan, ko mkpa'an ko nra̱na̱, waru she yo oco mpasa ma aza a babu unusu uba̱ta̱ u nda wan. <verse eid="JER 22:3" /><verse number="4" style="v" sid="JER 22:4" />Na amayun, nni i yuwan tsutoni nu udammu u nda, ngono nna n ri nden ootogu o tsugono tsu u'wa wa Da̱wuda n ta uwa nu una̱ntsu wu ukobu u nda, zuva vi ikeke yi ido ni ido, za suru na azagbain a̱ yi na ama a̱ yi. <verse eid="JER 22:4" /><verse number="5" style="v" sid="JER 22:5" />Amma ni i yuwan tsutoni na adanshi a nda shi, n kucina ta̱ na aciya̱va̱, ukobu u mogono u nda u to o'wo okongo.&gt; &gt;&gt; Ne ɗa A̱sulazuva a dammai.<note caller="-" style="x"><char style="xo" closed="false">22:5 </char><char style="xt" closed="false"><ref loc="MAT 23:38">Mat 23:38</ref>; <ref loc="LUK 13:35">Luk 13:35</ref>.</char></note> <verse eid="JER 22:5" /><verse number="6" style="v" sid="JER 22:6" />Adama a na apa ili i na A̱sulazuva a dammai adama o ukobu u mogono ma Yahuda,</para>
  <para style="b" vid="JER 22:6" />
  <para style="q1" vid="JER 22:6">&lt;&lt;Ulobonu wa̱ wu u ta̱</para>
  <para style="q2" vid="JER 22:6">tsa̱ Giliyadu uba̱ta̱ u va̱,</para>
  <para style="q2" vid="JER 22:6">waru tsa̱ a̱ba̱jini a agaɗi a Lebanon.</para>
  <para style="q1" vid="JER 22:6">Na amayun n ta̱ ka̱mba̱to wu</para>
  <para style="q2" vid="JER 22:6">tsa̱ a̱tsumona,</para>
  <para style="q2" vid="JER 22:6">lyuci gbain na ri na̱ za shi.<verse eid="JER 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 22:7" />N ta̱ lyungu aza a na o kototo wu,</para>
  <para style="q2" vid="JER 22:7">za suru ni itana yu uvon ya̱ yi.</para>
  <para style="q1" vid="JER 22:7">A ta gagasa atsura</para>
  <para style="q2" vid="JER 22:7">a sida o ulobonu wa̱ wu,</para>
  <para style="q2" vid="JER 22:7">reve a vari le akina.&gt;&gt;<verse eid="JER 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 22:8" />Ama a nɗa na̱ a̱bunda̱ a̱ ta̱ kuru na̱ nge'en n lyuci gbai'in, za suru ta damma moron ma̱ nden ma̱ yi ana, &lt;&lt;Nye i zuwai A̱sulazuva a yuwain tsunda na̱ lyuci gbai'in? <verse eid="JER 22:8" /><verse number="9" style="v" sid="JER 22:9" />Reve a̱ usu a damma,&lt;Ili i na i zuwai a̱ yi ɗa, a kuɗa ta̱ akucunu a̱ A̱sulazuva A̱sula̱ e le, reve a yuwaan musula̱ n ro a̱ga̱nda̱, a̱vu fo aa yuwaan le ulinga.&gt; &gt;&gt;<verse eid="JER 22:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 22:10" />&lt;&lt;She i shon adama o mogono</para>
  <para style="q2" vid="JER 22:10">ma na ma̱ kuwa̱i wan,</para>
  <para style="q1" vid="JER 22:10">ko i yuwan a̱tsumola̱ngu adama</para>
  <para style="q2" vid="JER 22:10">o ukwisa̱ wa̱ yi wan.</para>
  <para style="q1" vid="JER 22:10">Amma o una̱ ndolo,</para>
  <para style="q2" vid="JER 22:10">i shon lon adama a za na</para>
  <para style="q2" vid="JER 22:10">a tarai a̱ tyo tsugbashi,</para>
  <para style="q2" vid="JER 22:10">adama a na wa̱a̱ da̱shi ka̱mba̱ shi,</para>
  <para style="q1" vid="JER 22:10">ko u da̱shi ene iɗa</para>
  <para style="q2" vid="JER 22:10">i na a matsan niyi shi.&gt;&gt;<verse eid="JER 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 22:11" />&lt;&lt;Apa ili i na A̱sulazuva a dammai, adama a Shalum<note caller="+" style="f"><char style="fr" closed="false">22:11 </char><char style="fq" closed="false">Shalum </char><char style="ft" closed="false">Urevu wa aala a nda waru a̱yi ɗa Yehowaha.</char></note> ulobo wa Josiya, zana o'woi mogono o una̱ wa dada va̱ yi mogono ma Yahuda, agba u lyawa ta̱ uba̱ta̱ u nda, waru wa̱a̱ da̱shi ka̱mba̱ pa shi.<note caller="-" style="x"><char style="xo" closed="false">22:11 </char><char style="xt" closed="false"><ref loc="2KI 23:34">2 Ngo 23:34</ref>.</char></note> <verse eid="JER 22:11" /><verse number="12" style="v" sid="JER 22:12" />Amma uba̱ta̱ u na a tara niyi a̱ tyo tsugbashi, ɗe ɗa wa̱ kuwa̱, wa̱a̱ da̱shi ene iɗa i nda shi.&gt;&gt;<verse eid="JER 22:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JER 22:13" />&lt;&lt;A̱tsuma̱lima̱ a ta cina</para>
  <para style="q2" vid="JER 22:13">za na suwai ukobu wa̱ yi</para>
  <para style="q2" vid="JER 22:13">a̱tsuma̱ o ure wu ulambu wa̱ a̱ɓula̱,</para>
  <para style="q1" vid="JER 22:13">oɓolo na asula a zuva</para>
  <para style="q2" vid="JER 22:13">a̱tsuma̱ o ure wa amayun shi,</para>
  <para style="q1" vid="JER 22:13">za na a zuwusa a ama</para>
  <para style="q2" vid="JER 22:13">e iɗa ya̱ yi ulinga wa̱ pere,</para>
  <para style="q2" vid="JER 22:13">agba wa tsupusa melen me le shi.&gt;&gt;<verse eid="JER 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 22:14" />Agba u ta dansa,</para>
  <para style="q2" vid="JER 22:14">&lt;&lt;N ta suwaa aciya̱va̱ a̱ba̱jini o ukobu,</para>
  <para style="q2" vid="JER 22:14">na̱ a̱ba̱jini a̱ba̱jini asula a zuva.</para>
  <para style="q1" vid="JER 22:14">A̱vu u yuwaan le uba̱ta̱ wu usowoto wu upepu,</para>
  <para style="q2" vid="JER 22:14">reve wu kala ɓaɓu va̱ yi na̱ ɗanga sida,</para>
  <para style="q2" vid="JER 22:14">a̱vu wu kala yi ni ili i shili.&gt;&gt;<verse eid="JER 22:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JER 22:15" />&lt;&lt;Ili ya nda i to o'woto wu mogono</para>
  <para style="q2" vid="JER 22:15">nna̱ vu ri na̱ ɗanga sida va̱ a̱bunda̱?</para>
  <para style="q1" vid="JER 22:15">Ashe dada va̱ wu da̱na̱</para>
  <para style="q2" vid="JER 22:15">ni ilyalya ni ili yo oso shi?</para>
  <para style="q1" vid="JER 22:15">U yuwan ta̱ amayun na̱ a̱ɓula̱,</para>
  <para style="q2" vid="JER 22:15">a̱yi ɗa i zuwai u tsura̱i ulyuwu we elime.<verse eid="JER 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 22:16" />U da̱na̱ ta̱ o ucina̱</para>
  <para style="q2" vid="JER 22:16">wa̱ a̱za̱ o ulambu</para>
  <para style="q2" vid="JER 22:16">na aza a na a cigai ikambishi,</para>
  <para style="q1" vid="JER 22:16">a̱ yi ɗa i zuwai u tsura̱i</para>
  <para style="q2" vid="JER 22:16">ulyuwu we elime.</para>
  <para style="q1" vid="JER 22:16">A̱yi nda a̱ yi ɗa</para>
  <para style="q2" vid="JER 22:16">a tsu damma urevu u va̱ shi?</para>
  <para style="qr" vid="JER 22:16">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 22:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 22:17" />Amma a̱vu, vu zuwa ta̱ esu a̱ wu,</para>
  <para style="q2" vid="JER 22:17">no okolo a̱ wu</para>
  <para style="q2" vid="JER 22:17">e izami yu uda̱shiwu u na u ri ulobonu shi,</para>
  <para style="q1" vid="JER 22:17">na̱ wocosu wu mpasa</para>
  <para style="q2" vid="JER 22:17">wa aza a na a̱ ri nu unusu shi,</para>
  <para style="q2" vid="JER 22:17">ni ɓongishi nu u'ya̱susa̱n wu ugbozu.&gt;&gt;<verse eid="JER 22:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JER 22:18" />Adama o ndolo,</para>
  <para style="q2" vid="JER 22:18">apa ili i na A̱sulazuva adansa,</para>
  <para style="q1" vid="JER 22:18">adama o mogono Jehoyakim</para>
  <para style="q2" vid="JER 22:18">ulobo wa̱ Josiya mogono ma Yahuda,</para>
  <para style="q1" vid="JER 22:18">&lt;&lt;A yuwan mesun adama a̱ yi shi,</para>
  <para style="q2" vid="JER 22:18">&lt;Ayya, mawun ma a̱na̱wun mo ulobo ma̱ va̱!&gt;</para>
  <para style="q2" vid="JER 22:18">Ayya, mawun ma a̱na̱wun mo usheli ma̱ va̱!</para>
  <para style="q1" vid="JER 22:18">A yuwan mesun adama a̱ yi shi,</para>
  <para style="q2" vid="JER 22:18">&lt;Ayya, zagbain tsu!&gt;</para>
  <para style="q2" vid="JER 22:18">&lt;Ayya, za tsugbain!&gt;<verse eid="JER 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 22:19" />A̱ ta̱ ciɗo yi tso mololi,</para>
  <para style="q2" vid="JER 22:19">o to rono yi a vari yi</para>
  <para style="q2" vid="JER 22:19">o ucina̱ wu na̱ntsu va̱ Urishelima.&gt;&gt;<verse eid="JER 22:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JER 22:20" />&lt;&lt;A̱vu Urishelima,</para>
  <para style="q2" vid="JER 22:20">gawan a̱ tyo Lebanon vu sala,</para>
  <para style="q1" vid="JER 22:20">lyawa a uwwa uɗyo wa̱ wu a Bashan,</para>
  <para style="q2" vid="JER 22:20">vu sala diga a Abarim,</para>
  <para style="q1" vid="JER 22:20">adama a na o kototo ta̱</para>
  <para style="q2" vid="JER 22:20">a̱za̱ e icigi ya̱ wu suru.&gt;&gt;<verse eid="JER 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 22:21" />A̱mu A̱sulazuva, n rono wu ta̱ atsuvu</para>
  <para style="q2" vid="JER 22:21">a mantsa ma na vu da̱na̱i na asuvu nden,</para>
  <para style="q1" vid="JER 22:21">amma reve vu damma,</para>
  <para style="q2" vid="JER 22:21">&lt;&lt;Moo polo asuvu shi!&gt;&gt;</para>
  <para style="q1" vid="JER 22:21">A̱yi nda a̱ yi ɗa wuma wa̱ wu</para>
  <para style="q2" vid="JER 22:21">diga a̱vu o tsulolobo,</para>
  <para style="q2" vid="JER 22:21">vu 'yuwan ta̱ a yuwaan mu tsutoni.<verse eid="JER 22:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 22:22" />&lt;&lt;Upepu wu ucira u ta̱</para>
  <para style="q2" vid="JER 22:22">pura̱ azagbain a̱ wu,</para>
  <para style="q1" vid="JER 22:22">aza a na a ciga nuwu waru</para>
  <para style="q2" vid="JER 22:22">a̱ ta̱ 'ya̱wa̱to le tsugbashi.</para>
  <para style="q1" vid="JER 22:22">Vu ta̱ gba o sowo wono nu ulamu,</para>
  <para style="q2" vid="JER 22:22">adama e iwuya ya̱ wu suru.<verse eid="JER 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 22:23" />A̱vu na vu ri nden a Lebanon<note caller="+" style="f"><char style="fr" closed="false">22:23 </char><char style="fq" closed="false">Lebanon </char><char style="ft" closed="false">A̱yi nda ukobu u tsugono tsa ɗa a̱tsuma̱ a̱ Urishelima.</char></note>,</para>
  <para style="q2" vid="JER 22:23">u'wa u na a yuwain na̱ ɗanga sida,</para>
  <para style="q2" vid="JER 22:23">vu ta yuwan ma̱nga̱ a mantsa</para>
  <para style="q2" vid="JER 22:23">ma na usuɗuwu u ta̱wa̱ nuwu,</para>
  <para style="q1" vid="JER 22:23">cu'un va̱ a̱tsuma̱lima̱ a ka na</para>
  <para style="q2" vid="JER 22:23">da̱nuyi teri!&gt;&gt;<verse eid="JER 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 22:24" />Reve A̱sulazuva a damma, &lt;&lt;Nna̱ n ri wuma,&gt;&gt; Ko na̱ shi a damma a̱vu mogono Yekoniya<note caller="+" style="f"><char style="fr" closed="false">22:24 </char><char style="fq" closed="false">Yekoniya </char><char style="ft" closed="false">Waru e revei ta̱ na aala o ro a na a tsu ɗe Yehohacin na̱ Koniya.</char></note> ulobo wa̱ Jehoyakim va Yahuda, makawani mo urotsu wu ukere usa'ani u va̱ u ɗa, na̱ ne suru n to foɗo wu,<note caller="-" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="2KI 24:8-15">2 Ngo 24:8-15</ref>; <ref loc="2CH 36:9-10">2 Alb 36:9-10</ref>.</char></note> <verse eid="JER 22:24" /><verse number="25" style="v" sid="JER 22:25" />&lt;&lt;n cawu e ekere aza a na a zama wuma wa̱ wu, e ekere aza a na vaa uwwusa wovon, e ekere mogono Nebukanaza va Babila ne e ekere aza a Babila. <verse eid="JER 22:25" /><verse number="26" style="v" sid="JER 22:26" />N ta vari wu a̱vu na̱ mma va̱ wu na matsan nuwu, e iɗa i ro uba̱ta̱ u na a matsan n ɗu shi, ɗe ɗa ya̱ kuwa̱. <verse eid="JER 22:26" /><verse number="27" style="v" sid="JER 22:27" />Iɗa i na gba vu ri a maluwa ma na va̱a̱ ka̱mba̱ a̱tsuma̱ a̱ yi, va̱a̱ ka̱mba̱ a̱tsuma̱ a̱ yi shi.&gt;&gt;<verse eid="JER 22:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="JER 22:28" />&lt;&lt;Cine a yuwain Yekoniya</para>
  <para style="q2" vid="JER 22:28">o o'woi meden ma na mo ɓosoi,</para>
  <para style="q2" vid="JER 22:28">meden ma na za ri o ulinga na̱ yi shi!</para>
  <para style="q1" vid="JER 22:28">Nye i zuwai a vari niyi,</para>
  <para style="q2" vid="JER 22:28">a̱yi na̱ muwun ma̱ yi,</para>
  <para style="q2" vid="JER 22:28">e iɗa i na e revei shi?&gt;&gt;<verse eid="JER 22:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="JER 22:29" />&lt;&lt;A̱vu iɗa, a̱vu iɗa, a̱vu iɗa!</para>
  <para style="q2" vid="JER 22:29">Vu uwwa adanshi a̱ A̱sulazuva!<verse eid="JER 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 22:30" />Apa ili i na A̱sulazuva adansa,</para>
  <para style="q2" vid="JER 22:30">&lt;Vu lyawa vuma nda'a</para>
  <para style="q2" vid="JER 22:30">she damma za na ri na̱ limatan shi,</para>
  <para style="q1" vid="JER 22:30">vuma na a̱ tsura̱ ulyuwu wa aci</para>
  <para style="q2" vid="JER 22:30">a̱tsuma̱ a rana wuma wa̱ yi shi.</para>
  <para style="q1" vid="JER 22:30">Adama a na babu za ro diga</para>
  <para style="q2" vid="JER 22:30">a̱tsuma̱ o ugundo wa̱ yi na̱ tsura̱ ulyuwu wa aci,</para>
  <para style="q1" vid="JER 22:30">babu za na a̱ da̱nu ootogu o tsugono tsa̱ Da̱wuda,</para>
  <para style="q2" vid="JER 22:30">ko gba shi u yuwan tsugono a̱tsuma̱ a Yahuda.&gt; &gt;&gt;<verse eid="JER 22:30" /></para>
  <chapter eid="JER 22" />
  <chapter number="23" style="c" sid="JER 23" />
  <para style="s">Ikaka adama o mogono ma̱ a̱ɓula̱</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 23:1" />&lt;&lt;A̱tsuma̱lima̱ a ta cina aza a aguɓa a na a̱ lungususa̱ waru e bete'wishe ikyon ya aguɓa a̱ va̱!&gt;&gt; Ne ɗa A̱sulazuva a dammai. <verse eid="JER 23:1" /><verse number="2" style="v" sid="JER 23:2" />&lt;&lt;Adama o ndolo, apa ili i na A̱sulazuva a̱ A̱sula̱ a Isra'ila a dammai, aza a na a tarai ume wa aguɓa a ama a̱ va̱. Ana wo o'woi i bete'wei ikyon i va̱ reve i gba̱ra̱ le, agba yi idana le shi. Agba gogo, n ta ca ɗu oforo o una̱ wu unusu u na i yuwain.&gt;&gt; Ne ɗa A̱sulazuva a dammai.<verse eid="JER 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 23:3" />&lt;&lt;A̱mu na aciya̱va̱ m ta̱ ɓoloto akapi e ikyon i va̱ na buwai diga e iɗa suru, aza a na m gba̱ra̱i. N ta̱ ka̱mba̱to le uba̱ta̱ wa alyuna u le, uba̱ta̱ u na a yuwan limatan reve a yuwan a̱bunda̱ lon. <verse eid="JER 23:3" /><verse number="4" style="v" sid="JER 23:4" />N ta zuwaa le aza a aguɓa a na e indana le, a buwa a̱ da̱shi uwwa wovon ko a dada'wan shi, waru a buwa da̱shi lamba za ro a̱tsuma̱ e le shi. Ne ɗa A̱sulazuva a dammai.&gt;&gt;<verse eid="JER 23:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JER 23:5" />&lt;&lt;Ka̱lyuwa̱, rana ta̱ lo a̱ ta̱wa̱,&gt;&gt;</para>
  <para style="qr" vid="JER 23:5">Ne ɗa A̱sulazuva a dammai,</para>
  <para style="q1" vid="JER 23:5">&lt;&lt;Na ma̱a̱ 'ya̱sa̱n eten a̱ a̱ɓula̱</para>
  <para style="q2" vid="JER 23:5">o mogono diga o ugundo wa̱ Da̱wuda,</para>
  <para style="q2" vid="JER 23:5">mogono ma na maa yuwan</para>
  <para style="q2" vid="JER 23:5">tsugono a̱tsuma̱ o ugbozu,</para>
  <para style="q1" vid="JER 23:5">mogono ma na maa yuwan amayun</para>
  <para style="q2" vid="JER 23:5">na̱ a̱ɓula̱ a̱tsuma̱ e iɗa'a.<note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="JER 33:14-16">Irm 33:14-16</ref>; <ref loc="ZEC 3:8">Zak 3:8</ref>.</char></note><verse eid="JER 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 23:6" />A̱tsuma̱ a rana va̱ yi</para>
  <para style="q2" vid="JER 23:6">a ta wawa Yahuda,</para>
  <para style="q2" vid="JER 23:6">waru Isra'ila ta̱ da̱nu gbaga.</para>
  <para style="q1" vid="JER 23:6">Agba apa ala a na e ɗeyi na̱ yi,</para>
  <para style="q2" vid="JER 23:6">A̱sulazuva a̱ A̱ɓula̱ A̱tsu.&gt;&gt;<verse eid="JER 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 23:7" />&lt;&lt;Adama o ndolo, a̱mu A̱sulazuva n damma ta̱, agba a̱ yi ɗa nda rana ta̱ lo a̱ ta̱wa̱ na̱ da̱shi damma, &lt;N kucuna ta̱ na̱ A̱sulazuva a na a̱ ri wuma, za na o uta̱yi aza a Isra'ila diga e iɗa ya Masar shi.&gt; <verse eid="JER 23:7" /><verse number="8" style="v" sid="JER 23:8" />Amma o una̱ u ndolo a ta damma, &lt;N kucuna ta̱ na̱ A̱sulazuva a na a̱ ri wuma, za na o uta̱i ugundo wa̱ Isra'ila diga e iɗa yu ugana, diga e iɗa i na u bete'we nle.&gt; Ɗaɗa a̱ da̱shi da̱nu a̱tsuma̱ e iɗa i le.&gt;&gt;<verse eid="JER 23:8" /></para>
  <para style="s">Ama̱sula̱ epen</para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="JER 23:9" />&lt;&lt;Okolo a̱ va̱ a̱ la̱nga̱ ta̱,</para>
  <para style="q2" vid="JER 23:9">adama a ama̱sula̱ epen,</para>
  <para style="q1" vid="JER 23:9">etele a̱ lipu a̱ va̱ suru</para>
  <para style="q2" vid="JER 23:9">a̱ ta̱ meje'en,</para>
  <para style="q1" vid="JER 23:9">mo o'wo ta̱ tsa za na ri usowu,</para>
  <para style="q2" vid="JER 23:9">tsa za na masayan ma̱ ina̱bi ma̱ tsura̱toi</para>
  <para style="q1" vid="JER 23:9">adama a̱ A̱sulazuva,</para>
  <para style="q2" vid="JER 23:9">oɓolo ni idanshi ya akiza a̱ yi.<verse eid="JER 23:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 23:10" />Adama a na iɗa'a i shiwan ta̱</para>
  <para style="q2" vid="JER 23:10">na aza a na a yuwusan tsipere,</para>
  <para style="q1" vid="JER 23:10">adama o una̱ iɗa'a u ta̱ a̱tsumola̱ngu,</para>
  <para style="q2" vid="JER 23:10">hali ogozo a alyuna a̱tsumona e 'yewe.</para>
  <para style="q1" vid="JER 23:10">Majiyan ma ama̱sula̱'a̱ iwuya i ɗa</para>
  <para style="q2" vid="JER 23:10">waru a yuwan ulinga nu ucira u le</para>
  <para style="q2" vid="JER 23:10">a̱tsuma̱ o ure wa amayun shi.&gt;&gt;<verse eid="JER 23:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JER 23:11" />&lt;&lt;Ama̱sula̱ na̱ nan ganu suru</para>
  <para style="q2" vid="JER 23:11">a̱ ri no okolo A̱sula̱ shi,</para>
  <para style="q1" vid="JER 23:11">hali fo n cina ta̱ iwuya i le</para>
  <para style="q2" vid="JER 23:11">a̱tsuma̱ a̱ a̱a̱'isa̱ a̱ va̱.</para>
  <para style="qr" vid="JER 23:11">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 23:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 23:12" />Adama o ndolo, re le to o'wo</para>
  <para style="q2" vid="JER 23:12">re ve ederi tapu ni irumbu,</para>
  <para style="q2" vid="JER 23:12">ɗe ɗa a̱ riya̱.</para>
  <para style="q1" vid="JER 23:12">N ta̱ ta̱wa̱a̱ le na addama,</para>
  <para style="q2" vid="JER 23:12">a̱tsuma̱ a'wan a na a ca le oforo.</para>
  <para style="qr" vid="JER 23:12">Ne ɗa A̱sulazuva a dammai.&gt;&gt;<verse eid="JER 23:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JER 23:13" />&lt;&lt;A̱tsuma̱ ama̱sula̱ a Samariya,</para>
  <para style="q2" vid="JER 23:13">me ene ta̱ ili yi idaba i nda.</para>
  <para style="q1" vid="JER 23:13">A yuwan ta̱ adanshi</para>
  <para style="q2" vid="JER 23:13">e ikaka na ala a Ba'al</para>
  <para style="q1" vid="JER 23:13">reve a zuwa a ama a̱ va̱ Isra'ila</para>
  <para style="q2" vid="JER 23:13">a vadalaa mu ucina̱.<verse eid="JER 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 23:14" />A̱tsuma̱ a ama̱sula̱ a̱ Urishelima,</para>
  <para style="q2" vid="JER 23:14">me ene ta̱ ili i ro i na i la'ai idaba.</para>
  <para style="q1" vid="JER 23:14">A ta yuwusan tsushakala</para>
  <para style="q2" vid="JER 23:14">waru a ta mmalu a̱tsuma̱ epen,</para>
  <para style="q1" vid="JER 23:14">waru a̱ ta̱ o ucina̱</para>
  <para style="q2" vid="JER 23:14">wa aza a na a yuwusan iwuya,</para>
  <para style="q1" vid="JER 23:14">hali na babu za na vadalai</para>
  <para style="q2" vid="JER 23:14">diga a̱tsuma̱ o ure wi iwuya ya̱ yi.</para>
  <para style="q1" vid="JER 23:14">Suru nle a̱ ta̱ tsa̱ Sodom ya̱'a̱ va̱,</para>
  <para style="q2" vid="JER 23:14">waru a ama a̱ Urishelima</para>
  <para style="q2" vid="JER 23:14">a̱ ta̱ tsa̱ Gomora.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">23:14 </char><char style="xt" closed="false"><ref loc="GEN 18:20">Ufr 18:20</ref>; <ref loc="EZK 16:49">Izk 16:49</ref>.</char></note><verse eid="JER 23:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JER 23:15" />Adama o ndolo, apa ili i na</para>
  <para style="q2" vid="JER 23:15">A̱sulazuva o oɓolo a̱ a̱soja a zuva a dammai</para>
  <para style="q2" vid="JER 23:15">adama a ama̱sula̱ a nda,</para>
  <para style="q1" vid="JER 23:15">&lt;&lt;Ka̱lyuwa̱, n ta zuwa le a lyuwa</para>
  <para style="q2" vid="JER 23:15">ilyalya yo okono ya̱ a̱tsuma̱lima̱,</para>
  <para style="q2" vid="JER 23:15">waru o sowo mini ma̱ tsukono.</para>
  <para style="q1" vid="JER 23:15">Adama a na diga uba̱ta̱</para>
  <para style="q2" vid="JER 23:15">wa ama̱sula̱ a̱ Urishelima ɗa,</para>
  <para style="q1" vid="JER 23:15">ulambu u wovon wa̱ A̱sula̱</para>
  <para style="q2" vid="JER 23:15">u bete'wei a̱tsuma̱ e iɗa'a suru. &gt;&gt;<verse eid="JER 23:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="JER 23:16" />Apa ili i na A̱sulazuva</para>
  <para style="q2" vid="JER 23:16">oɓolo a̱ a̱soja a zuva dammai,</para>
  <para style="q1" vid="JER 23:16">&lt;&lt;She i polo atsuvu e idanshi</para>
  <para style="q2" vid="JER 23:16">ya ama̱sula̱ a nda wan,</para>
  <para style="q2" vid="JER 23:16">a̱ ta̱ lulumusa̱ ɗu.</para>
  <para style="q1" vid="JER 23:16">A ta dansa alavu alavu a majiyan me le goon,</para>
  <para style="q2" vid="JER 23:16">agba adanshi A̱sulazuva a ɗa shi.<verse eid="JER 23:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 23:17" />Ama̱sula̱ a nda a ta dansaa</para>
  <para style="q2" vid="JER 23:17">ama a na a vadalaa yi</para>
  <para style="q2" vid="JER 23:17">adanshi a̱ A̱sulazuva ucina̱,</para>
  <para style="q1" vid="JER 23:17">&lt;Na amayun i ta̱ da̱nu gbaga!&gt;</para>
  <para style="q2" vid="JER 23:17">Waru a ta dansaa aza a na a̱ ri</para>
  <para style="q2" vid="JER 23:17">a mmalu a̱tsuma̱ okolo aciyogbamu e le,</para>
  <para style="q2" vid="JER 23:17">&lt;Babu addama a na a̱ ta̱wa̱ ɗu.&gt; &gt;&gt;<verse eid="JER 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 23:18" />&lt;&lt;Amma zane ɗa a̱tsuma̱ e le isawain ɗe,</para>
  <para style="q2" vid="JER 23:18">a̱tsuma̱ e iɓolo i tsugbain</para>
  <para style="q2" vid="JER 23:18">ya̱ A̱sulazuva ɗe zuva,</para>
  <para style="q1" vid="JER 23:18">adama we ene,</para>
  <para style="q2" vid="JER 23:18">ko wu uwwa adanshi a̱ yi?</para>
  <para style="q1" vid="JER 23:18">Zane ɗa a̱tsuma̱ e le a uwwai</para>
  <para style="q2" vid="JER 23:18">waru wu uwwai adanshi a̱ yi?<verse eid="JER 23:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 23:19" />Ka̱lyuwa̱, agba a̱yi ɗa nda,</para>
  <para style="q2" vid="JER 23:19">upan wu ucira wa̱ A̱sulazuva u ɓa̱tsa̱i,</para>
  <para style="q2" vid="JER 23:19">tsu upepu wu lipa̱ vu ukototosu,</para>
  <para style="q2" vid="JER 23:19">waru u ta̱ riya̱a̱ a̱za̱ e iwuya.<verse eid="JER 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 23:20" />Upan wa̱ A̱sulazuva o von shi,</para>
  <para style="q2" vid="JER 23:20">she nu yuwan, waru u shiton</para>
  <para style="q2" vid="JER 23:20">ili i na i ri okolo a̱yi.</para>
  <para style="q1" vid="JER 23:20">A rana na va̱a̱ ta̱wa̱,</para>
  <para style="q2" vid="JER 23:20">i ta̱ reve ifoɓi i nda ulobonu.<verse eid="JER 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 23:21" />N lyungu ama̱sula̱ a nda shi,</para>
  <para style="q2" vid="JER 23:21">na̱ ne suru, a̱ ka̱ra̱ ta̱ ni ikaka i le.</para>
  <para style="q1" vid="JER 23:21">N yuwan adanshi ne le shi,</para>
  <para style="q2" vid="JER 23:21">na̱ ne suru, a lyuwa ta̱</para>
  <para style="q2" vid="JER 23:21">elime na adanshi e ikaka.<verse eid="JER 23:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 23:22" />Amma na̱ shi a damma</para>
  <para style="q2" vid="JER 23:22">e isawan ta̱ a̱tsuma̱ e iɓolo</para>
  <para style="q2" vid="JER 23:22">i tsugbain tsa̱ a̱ va̱,</para>
  <para style="q1" vid="JER 23:22">a̱ shi ta a yuwaan ama a̱ va̱</para>
  <para style="q2" vid="JER 23:22">adanshi a̱ va̱,</para>
  <para style="q1" vid="JER 23:22">a̱ shi ta a zuwa a ama a̱ va̱ a vadala,</para>
  <para style="q2" vid="JER 23:22">a lyawa re vi iwuya i le,</para>
  <para style="q2" vid="JER 23:22">oɓolo na̱ linga vi iwuya i le.&gt;&gt;<verse eid="JER 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 23:23" />Amma a̱vu A̱sulazuva a damma,</para>
  <para style="q2" vid="JER 23:23">&lt;&lt;A̱mu'u A̱sula̱ a na a̱ ri zuzu goon ɗa,</para>
  <para style="q2" vid="JER 23:23">agba A̱sula̱ a na a̱ ri alanga shi?&gt;&gt;<verse eid="JER 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 23:24" />&lt;&lt;A̱ ta̱ tsura̱ za ro na a gura soko aciya̱yi,</para>
  <para style="q2" vid="JER 23:24">hali na ma̱a̱ kuɗa̱ ene yi?</para>
  <para style="qr" vid="JER 23:24">Ne ɗa A̱sulazuva a dammai.</para>
  <para style="q2" vid="JER 23:24">Ashe a̱mu ɗa n shitoyin zuva ni iɗa shi?&gt;&gt;</para>
  <para style="qr" vid="JER 23:24">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 23:25" />Mu uwwa ta̱ ili i na ama̱sula̱ a dammai, aza a na aa yuwusan adanshi e ikaka ye epen na ala a̱ va̱, a dansa, &lt;&lt;N yuwan ta̱ alavu, n yuwan ta̱ alavu!&gt;&gt; <verse eid="JER 23:25" /><verse number="26" style="v" sid="JER 23:26" />&lt;&lt;Hali acina mantsa ma̱ ne ɗa ili i ndolo yaa lyuwa elime a̱tsuma̱ okolo a ama̱sula̱ a nda na a yuwusan epen, aza a na aa yuwusan adanshi e ikaka ye epen i wulumu i majiyan i le? <verse eid="JER 23:26" /><verse number="27" style="v" sid="JER 23:27" />A ta majiyan ma alavu a na adansa va̱ni le, a ta gura zuwa ama a̱ va̱ e icina na ala a̱ va̱, cine nkaya nle mi icinai na ala a̱ va̱, a̱tsuma̱ o ure u mayan ma̱ a̱ga̱nda̱ a̱ tyo ya Ba'al.&gt;&gt;<verse eid="JER 23:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="JER 23:28" />&lt;&lt;Lyawa vumava̱sula̱ na a yuwusan alavu,</para>
  <para style="q2" vid="JER 23:28">damma alanga eteshe</para>
  <para style="q2" vid="JER 23:28">na alavu yi ɗa.</para>
  <para style="q1" vid="JER 23:28">Amma lyawa za na</para>
  <para style="q2" vid="JER 23:28">a yuwusan adanshi a̱ va̱,</para>
  <para style="q2" vid="JER 23:28">damma adanshi a̱ va̱ a̱tsuma̱ a amayun.</para>
  <para style="q1" vid="JER 23:28">Ana wo o'woi babu ili i na i ɓoloi</para>
  <para style="q2" vid="JER 23:28">ogozo ni ishina.&gt;&gt;</para>
  <para style="qr" vid="JER 23:28">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 23:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 23:29" />&lt;&lt;Ashe, adanshi a̱ va̱ akina ɗa shi?</para>
  <para style="q2" vid="JER 23:29">Ashe, u ri tsa̱ ma̱ka̱ta̱</para>
  <para style="q2" vid="JER 23:29">ma na a̱ tsu ɓoso atali shi?&gt;&gt;</para>
  <para style="qr" vid="JER 23:29">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 23:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 23:30" />Adama o ndolo, A̱sulazuva a damma ta̱, &lt;&lt;N ta tsurala na ama̱sula̱ a na e iva̱i idanshi i le va̱ni le, a yuwusan adanshi a̱ yi, she damma wu uta̱ ta̱ uba̱ta̱ u va̱. <verse eid="JER 23:30" /><verse number="31" style="v" sid="JER 23:31" />Na amayun, n ta tsurala na ama̱sula̱ a na a̱ kpa̱tu'usa̱ una̱ u le, adansa majiyan me le. &lt;Ne ɗa A̱sulazuva a dammai.&gt; <verse eid="JER 23:31" /><verse number="32" style="v" sid="JER 23:32" />Na amayun, n ta tsurala na aza a na a yuwusan adanshi e ikaka ya alavu epen. A dansa alavu'u, a zuwusa a ama a̱ va̱ a vadalaa ure wa amayun a̱ va̱ ucina̱ a̱tsuma̱ o ure we epen le, nu uvaɗu we pere u le. A̱mu n lyungu le shi, waru n ca le udammu shi, waru a̱ da̱na̱ nu urana e ekere a ama nda ko ke'en shi.&gt;&gt; Ne ɗa A̱sulazuva a dammai.<verse eid="JER 23:32" /></para>
  <para style="s">Idanshi yi ikaka ye epen na ama̱sula̱ epen</para>
  <para style="p">
    <verse number="33" style="v" sid="JER 23:33" />&lt;&lt;Amma a̱vu Irimiya, nna a ama a nda ko vumava̱sula̱ ko nan ganu ece wu, &lt;Nye ɗa ikaka ya̱ A̱sulazuva?&gt; Vu damma le, &lt;Cu'un vi ikaka i ne? N ta vari ɗu.&gt; Ne ɗa A̱sulazuva a dammai. <verse eid="JER 23:33" /><verse number="34" style="v" sid="JER 23:34" />Amma nna̱ vumava̱sula̱ ko ganu ko vuma ro ɗe ko'o damma,&lt;Apa ikaka i na A̱sulazuva a dammai,&gt; N ta ca yi oforo nu u'wa wa̱ yi suru. <verse eid="JER 23:34" /><verse number="35" style="v" sid="JER 23:35" />Amma apa ili i na za suru a damma za va̱ yi na̱ moron ma̱ nden ma̱ yi, &lt;Nye ɗa u'usuwu wa̱ A̱sulazuva?&gt; Ko a damma, &lt;Nye ɗa A̱sulazuva a dammai?&gt; <verse eid="JER 23:35" /><verse number="36" style="v" sid="JER 23:36" />Amma she i da̱shi damma, &lt;Apa ikaka i na A̱sulazuva a dammai wan,&gt; Adama a na ume wi ikaka yi za suru, u ta̱ da̱na̱ aciya̱yi. Agba a̱ yi ɗa nda ya̱a̱ lyungususa̱ ikaka ya̱ A̱sula̱ a Wuma, A̱sulazuva oɓolo a̱ a̱soja a zuva, A̱sula̱ a̱ tsu. <verse eid="JER 23:36" /><verse number="37" style="v" sid="JER 23:37" />Apa cine yaa yuwan adanshi na̱ vumava̱sula̱, i damma yi, &lt;Cu'un vu u'usuwu u ne ɗa A̱sulazuva a ca yi?&gt; Ko gba shi, &lt;Nye ɗa A̱sulazuva a dammai?&gt; <verse eid="JER 23:37" /><verse number="38" style="v" sid="JER 23:38" />Ko na wo o'woi i ta dansa, &lt;A̱yi nda ɗa ikaka ya̱ A̱sulazuva,&gt; apa ili i na A̱sulazuva a dammai. I yuwan ta̱ ulinga ni idanshi i nda, &lt;Apa adanshi e ikaka ya̱ A̱sulazuva,&gt; ko na wo o'woi n damma ɗu ta̱, she i yuwan ulinga na̱ yi wan, &lt;Apa ikaka ya̱ A̱sulazuva.&gt; <verse eid="JER 23:38" /><verse number="39" style="v" sid="JER 23:39" />Adama o ndolo, na amayun n ta̱ e icina na̱ ɗu, a̱vu n vari ɗu diga elime a̱ va̱ oɓolo na̱ lyuci gbain na n ca nɗu na̱ nkaya nɗu. <verse eid="JER 23:39" /><verse number="40" style="v" sid="JER 23:40" />N ta zuwa ɗu yo o'wo ili i na ogoro ni ili i wono hali hali. Waru e icina ni ili yaa nda shi.&gt;&gt;<verse eid="JER 23:40" /></para>
  <chapter eid="JER 23" />
  <chapter number="24" style="c" sid="JER 24" />
  <para style="s">Okondo e re a̱ biri</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 24:1" />A mantsa ma na Nebukanaza remei Yekoniya<note caller="+" style="f"><char style="fr" closed="false">24:1 </char><char style="fq" closed="false">Yekoniya </char><char style="ft" closed="false">Na̱ Tsuyahuda, aala o ro a ɗa a Yehoyakim.</char></note> ulobo wa̱ Jehoyakim mogono ma Yahuda, oɓolo na azagbain a̱ yi, oɓolo na aza a na a yuwusan ulinga wu ukere biti, oɓolo na̱ a̱za̱ o ulinga u yironishi a Yahuda diga Urishelima a̱ tyo Babila tsugbashi, A̱sulazuva o roco mu ta̱ okondo e re a̱ biri, aza a na a zuwai elime a̱ A̱a̱'isa̱mapaɗa a̱ A̱sulazuva.<note caller="-" style="x"><char style="xo" closed="false">24:1 </char><char style="xt" closed="false"><ref loc="2KI 24:12-16">2 Ngo 24:12-16</ref>; <ref loc="2CH 36:10">2 Alb 36:10</ref>.</char></note> <verse eid="JER 24:1" /><verse number="2" style="v" sid="JER 24:2" />A̱tsuma̱ o okondo a̱ta̱ biri sa'ani da̱na̱ ta̱ pe, tsu umatsun wu ufaru wu biri. Wa̱ ire waru aza a na a̱ ri babu ulobonu, a̱ la̱nga̱ ta̱ lon hali na a gura lyuwa le shi.<verse eid="JER 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 24:3" />Ɗaɗa A̱sulazuva a damma numu, &lt;&lt;Nye vee enei Irimiya?&gt;&gt;</para>
  <para style="p" vid="JER 24:3">Reve n usu, &lt;&lt;Muwun mu biri. Aza a na a̱ ri ulobonu'u a̱ tu ulobonu lon, amma aza a na a̱ ri ulobonu shi, a̱ la̱nga̱ ta̱ lon hali na a gura lyuwa le shi.&gt;&gt;<verse eid="JER 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 24:4" />Reve adanshi a̱ A̱sulazuva a̱ ta̱wa̱ ya̱'a̱ va̱ ana, <verse eid="JER 24:4" /><verse number="5" style="v" sid="JER 24:5" />Apa ili i na A̱sulazuva A̱sula̱ a Isra'ila a dammai, &lt;&lt;Ununa biri sa'ani nda ri, ne ɗa me e idana a ama a Yahuda, aza a na a̱ pura̱i, na mu uta̱yi diga uba̱ta̱ u nda a̱ tyo tsugbashi e iɗa ya Babila. <verse eid="JER 24:5" /><verse number="6" style="v" sid="JER 24:6" />Esu a̱ va̱ a̱ ta̱ e idana le, adama e isa'ani i le, reve n ka̱mba̱to le a̱tsuma̱ e iɗa i nda. N ta̱ 'ya̱sa̱n le, agba moo kototo le shi, n ta̱ gba shuwa̱ le, waru ma̱a̱ mula̱ le shi. <verse eid="JER 24:6" /><verse number="7" style="v" sid="JER 24:7" />N ta ca le okolo a na ee reve mu, ne ee reve ana a̱mu ɗa A̱sulazuva. O to o'wo a ama a̱ va̱, reve fo mo o'wo A̱sula̱ e le, adama a na a̱ ta̱ ka̱mba̱ uba̱ta̱ u va̱ no okolo a̱ta̱.&gt;&gt;<verse eid="JER 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 24:8" />&lt;&lt;Amma ununa biri na la̱nga̱i nda ri hali na a gura lyuwa le shi, ne ɗa maa yuwan na̱ Zedekiya mogono ma Yahuda, na azagbain a̱yi na akapi ama a na a la'ai diga Urishelima, ko na̱ shi a̱ ri e iɗa i nda, ko na̱ shi gba a̱ ri nden e iɗa ya Masar. Ne ɗa A̱sulazuva a dammai. <verse eid="JER 24:8" /><verse number="9" style="v" sid="JER 24:9" />N to o'woto le ili i wovon, ni ili yi idaba, e ekere o tsugono tsu uvaɗi suru. O to o'wo ili yi izo'oshi, ni ili ya avandaru, ni ili i na a yuwayin una̱, a̱ tyo ba̱ta̱ na mee bete'we le suru. <verse eid="JER 24:9" /><verse number="10" style="v" sid="JER 24:10" />N ta̱ lyunguwa̱ le na̱ matsun me pe'eni na ambulu na̱ mɓa̱la̱, hali she no o kototo le kpa̱ra̱ diga a̱tsuma̱ e iɗa i na n ca nle na̱ nkaya nle.&gt;&gt;<verse eid="JER 24:10" /></para>
  <chapter eid="JER 24" />
  <chapter number="25" style="c" sid="JER 25" />
  <para style="s">A'wan kupocindere a tsugbashi</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 25:1" />Apa adanshi a na A̱sulazuva a yuwayin Irimiya adama a̱ nda̱na̱ta̱ ma ama a Yahuda suru, a̱tsuma̱ a'wan a̱ na̱shi o tsugono tsa̱ mogono Jehoyakim ulobo wa̱ Josiya va Yahuda. A̱yi a'wan o ndolo'o a̱ yi ɗa a'wan o ufaru u tsugono tsa̱ mogono Nebukanaza va Babila.<note caller="-" style="x"><char style="xo" closed="false">25:1 </char><char style="xt" closed="false"><ref loc="2KI 24:1">2 Ngo 24:1</ref>; <ref loc="2CH 36:5-7">2 Alb 36:5-7</ref>; <ref loc="DAN 1:1-2">Dan 1:1-2</ref>.</char></note> <verse eid="JER 25:1" /><verse number="2" style="v" sid="JER 25:2" />Ɗaɗa Irimiya vumava̱sula̱ dammai a ama a Yahuda suru na̱ nda̱na̱ta̱ ma̱ Urishelima suru ana, <verse eid="JER 25:2" /><verse number="3" style="v" sid="JER 25:3" />&lt;&lt;a'wan ushin na aza a ta'atsu, diga ya Josiya ulobo wa Amon mogono ma Yahuda hali acina urana u nda, adanshi a̱ A̱sulazuva a̱ ta̱wa̱ ta̱ uba̱ta̱ u va̱ waru n yuwaan ɗu ta̱ adanshi kuci, agba yu uwwa shi.&gt;&gt;<verse eid="JER 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 25:4" />&lt;&lt;Ko na wo o'woi A̱sulazuva a̱ lyungu ta̱ agbashi a̱yi ama̱sula̱ suru mantsa kuci, agba yu uwwa shi, ko i polo le atsuvu shi. <verse eid="JER 25:4" /><verse number="5" style="v" sid="JER 25:5" />A dansa ɗu ta̱, vadalai gogo, za suru lyawa ure wi iwuya ya̱ yi, na̱ linga vi iwuya ya̱ yi, adama i da̱nu a̱tsuma̱ e iɗa i na A̱sulazuva a ca nɗu na̱ nkaya nɗu hali hali. <verse eid="JER 25:5" /><verse number="6" style="v" sid="JER 25:6" />She i toni musula̱ n ro adama i yuwaan le ulinga ko a̱ga̱nda̱ wan. She i zuwa mu n yuwan upan o una̱ u na i yuwayin linga vee ekere a̱ ɗu a̱ga̱nda̱ wan. Ne ɗa ma̱a̱ ta̱wa̱a̱ ɗu na addama shi.&gt;&gt; <verse eid="JER 25:6" /><verse number="7" style="v" sid="JER 25:7" />&lt;&lt;Amma na̱ ne suru, yi uwwa mu shi. I zuwa mu ta̱ n yuwan upan adama e ili i na ekere a̱ ɗu a yuwain, agba a̱ yi ɗa nda i ronoyi aciya̱ɗu addama.&gt;&gt; Ne ɗa A̱sulazuva a dammai.<verse eid="JER 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 25:8" />Adama o ndolo A̱sulazuva o oɓolo a̱ a̱soja a zuva a damma ta̱, &lt;&lt;Ana wo o'woi i 'yuwain a yuwan tsutoni na adanshi a̱ va̱, <verse eid="JER 25:8" /><verse number="9" style="v" sid="JER 25:9" />n ta̱ ɗe ama o upasu wu ugana suru oɓolo na aagbashi a̱ va̱ Nebukanaza mogono ma Babila,&gt;&gt; ne ɗa A̱sulazuva a dammai, &lt;&lt;n ta̱ gba a̱ ta̱wa̱to le adama a yuwan uvon ni iɗa i nda, oɓolo na̱ nda̱na̱ta̱ ma̱ yi, oɓolo na̱ nɗa nna n ri uka̱nda̱ruwu na̱ yi suru. N to kototo le suru, reve n ka̱mba̱to le ili i wovon, ni ili yi izo'oshi, a̱ ta̱ gba o'wo okongo hali hali. Ne ɗa A̱sulazuva a dammai. <verse eid="JER 25:9" /><verse number="10" style="v" sid="JER 25:10" />N ta̱ kimusa̱ uɗyo u ma̱za̱nga̱ na̱ mere diga uba̱ta̱ u le, oɓolo nu uɗyo wu ka sa'avu na̱ za vali vu kasa'avu. N ta zuwa a̱ kuɗa̱ a uwwa ilama ya aatali a yira, waru ene ekan i fitila pe shi, zana a̱yi ɗa iroci yu ulambu wa asuvu nden.<note caller="-" style="x"><char style="xo" closed="false">25:10 </char><char style="xt" closed="false"><ref loc="JER 7:34">Irm 7:34</ref>; <ref loc="JER 16:9">16:9</ref>; <ref loc="REV 18:22-23">Wen 18:22-23</ref>.</char></note> <verse eid="JER 25:10" /><verse number="11" style="v" sid="JER 25:11" />Iɗa i nda suru i to o'wo okongo, waru nɗa n da n ta yuwaan mogono ma Babila tsugbashi hali a'wan kupocindere.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">25:11 </char><char style="xt" closed="false"><ref loc="2CH 36:21">2 Alb 36:21</ref>; <ref loc="JER 29:10">Irm 29:10</ref>; <ref loc="DAN 9:2">Dan 9:2</ref>.</char></note><verse eid="JER 25:11" /></para>
  <para style="s">A̱ ta̱ ge'eto Babila</para>
  <para style="p">
    <verse number="12" style="v" sid="JER 25:12" />&lt;&lt;Amma a mantsa ma na a'wan kupocindere'e a shiwain, n ta ca mogono ma Babila oforo oɓolo na̱ nɗa ma̱ yi suru, iɗa ya aza a Babila adama a̱ nusu le. N ta zuwa iɗa'a yo o'wo okongo hali hali. Ne ɗa A̱sulazuva a dammai. <verse eid="JER 25:12" /><verse number="13" style="v" sid="JER 25:13" />N ta̱ fo a̱ ta̱wa̱a̱ iɗa i nda suru ni ili i na n yuwain adanshi a aci a̱ yi, ili i na a ɗanai a̱tsuma̱ a aatagada a nda suru, oɓolo ni ili i na Irimiya yuwain adanshi e ikaka a aci a nɗa nda suru. <verse eid="JER 25:13" /><verse number="14" style="v" sid="JER 25:14" />N ta tsupaa aza a Babila o una̱ wi ili i na a yuwain oɓolo na̱ linga ve ekere le, waru nɗa na̱ ngono ma̱ a̱bunda̱ n ta zuwa le ulinga u tsugbashi.&gt;&gt;<verse eid="JER 25:14" /></para>
  <para style="s">Mokkoto mo upan wa̱ A̱sula̱</para>
  <para style="p">
    <verse number="15" style="v" sid="JER 25:15" />Apa adanshi a na A̱sulazuva A̱sula̱ a Isra'ila a damma numu, &lt;&lt;Irimiya, vu ushi mokkoto ma masayan ma̱ ina̱bi ma nda mo upan u va̱ diga o ukere u va̱, vu zuwa nɗa nna suru ma̱a̱ lyungu wu ya̱'a̱ le o sowo yi. <verse eid="JER 25:15" /><verse number="16" style="v" sid="JER 25:16" />A mantsa ma na o sowo niyi a ta takalyuwa, waru a yuwan ujaru adama a matsun me pe'eni ma na ma̱a̱ lyungu a̱tsuma̱ e le.&gt;&gt;<verse eid="JER 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 25:17" />A̱vu n ushi mokkoto'o diga o ukere wa̱ a̱ A̱sulazuva. Reve n zuwa nɗa nna A̱sulazuva a̱ lyungu numu ya̱'a̱ le o sowo yi suru. <verse eid="JER 25:17" /><verse number="18" style="v" sid="JER 25:18" />Urishelima na̱ mulyuci ma Yahuda na̱ ngono n le na azagbain e le, adama n ka̱mba̱to le okongo, ni ili i macuru ni ili i na a yuwayin una̱ ununa u ri ana'an<note caller="+" style="f"><char style="fr" closed="false">25:18 </char><char style="fq" closed="false">ununa u ri ana'an </char><char style="ft" closed="false">A ta dansa hali acina mantsa ma na a ɗanai aatagada a Irimiya. </char></note>. <verse eid="JER 25:18" /><verse number="19" style="v" sid="JER 25:19" />Waru n ca ta̱ fo mogono Firi'awuna ma Masar, oɓolo na aza a na a yuwusayin ulinga, na azagbain a̱ yi oɓolo na ama suru. <verse eid="JER 25:19" /><verse number="20" style="v" sid="JER 25:20" />N ca ta̱ omoci a na a̱ ri ɗe fo, oɓolo na̱ ngono mi iɗa ya̱ Uz suru, oɓolo na̱ ngono mi iɗa ya Filistiya aza a Ashikelon na aza a Gaza na̱ Ekuron na akapi a ama a Ashido. <verse eid="JER 25:20" /><verse number="21" style="v" sid="JER 25:21" />Waru n ca ta̱ fo a̱za̱ a̱ Edom na̱ Mowa na̱ Amon, <verse eid="JER 25:21" /><verse number="22" style="v" sid="JER 25:22" />oɓolo na̱ ngono ma Taya suru, na̱ ngono ma̱ Sidon oɓolo na̱ ngono mu upasu u mala. <verse eid="JER 25:22" /><verse number="23" style="v" sid="JER 25:23" />Ni iɗa ya Dedan na̱ Tema na̱ Buz, na aza a na a̱ ri alanga fo o osowo. <verse eid="JER 25:23" /><verse number="24" style="v" sid="JER 25:24" />N ca ta̱ fo ngono ma Arabiya suru, na̱ ngono mo omocin nna ri nden a̱ a̱tsumona. <verse eid="JER 25:24" /><verse number="25" style="v" sid="JER 25:25" />A̱vu fo n ca ngono ma Zimri na̱ ngono ma Elam suru, na̱ ngono ma Midiya. <verse eid="JER 25:25" /><verse number="26" style="v" sid="JER 25:26" />Waru n ca ta̱ fo ngono mu upasu wu ugana suru, na aza a̱ ri alanga na̱ zuzu, ukuruwu ukuruwu, hali fo na̱ tsugono tsa na tsa̱ ri o urewesu wu uvaɗi suru. A mantsa ma na e le o sowoi suru, reve mogono ma Babila sowo fo.<verse eid="JER 25:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 25:27" />&lt;&lt;Ɗaɗa gba n damma nle ana, &lt;Apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva A̱sula̱ a Isra'ila a dammai, i sowo, yo o'wo usowu hali i shaama, i riya̱ hali na ya̱a̱ da̱shi 'yon shi, a̱yi ɗa uvon u na ma̱a̱ lyunguwa̱a̱ a̱ ɗu.&gt; <verse eid="JER 25:27" /><verse number="28" style="v" sid="JER 25:28" />Amma na a 'yuwan a̱ ushi mokkoto'o diga o ukere wa̱ wu no o sowo, reve vu damma le, &lt;apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva a dammai, ko na̱ shi i 'yuwan i ciga i sowoi! <verse eid="JER 25:28" /><verse number="29" style="v" sid="JER 25:29" />Ka̱lyuwa̱, n te e ifoɓi i na ma̱a̱ ta̱wa̱a̱ na addama a̱ lyuci na e ɗesu na Ala a̱ va̱. To, e yene i ɗu a ca ɗu oforo shi? Adama a na n ta̱ ta̱wa̱a̱ nda̱na̱ta̱ mu uvaɗi suru na̱ matsun me pe'eni.&gt; &gt;&gt; Ne ɗa A̱sulazuva o oɓolo a̱ a̱soja a zuva a dammai. <verse eid="JER 25:29" /><verse number="30" style="v" sid="JER 25:30" />Gogo she vu yuwan adanshi e ikaka yi idanshi i nda a aci e le, vu damma le,</para>
  <para style="b" vid="JER 25:30" />
  <para style="q1" vid="JER 25:30">&lt;&lt;A̱sulazuva a̱ ta̱ gugwa̱ diga zuva,<note caller="-" style="x"><char style="xo" closed="false">25:30 </char><char style="xt" closed="false"><ref loc="AMO 1:1">Emo 1:1</ref>.</char></note></para>
  <para style="q2" vid="JER 25:30">u ta yuwan tsata</para>
  <para style="q2" vid="JER 25:30">diga uba̱ta̱ wu nden wa̱ yi wa akiza.</para>
  <para style="q2" vid="JER 25:30">Reve u gugwa̱ nu ucira a aci e iɗa ya̱ yi.</para>
  <para style="q1" vid="JER 25:30">U ta yuwan yisali she damma aza a na</para>
  <para style="q2" vid="JER 25:30">a dadasa umatsun u ina̱bi,</para>
  <para style="q1" vid="JER 25:30">u yuwan yisali a aci</para>
  <para style="q2" vid="JER 25:30">a̱ nda̱na̱ta̱ mu uvaɗi suru.<verse eid="JER 25:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 25:31" />Elemu a̱ ta̱ 'yon hali acina ukosu wu uvaɗi,</para>
  <para style="q1" vid="JER 25:31">adama a na A̱sulazuva</para>
  <para style="q2" vid="JER 25:31">a̱ ta̱wa̱a̱ ta̱ na adanshi a aci nɗa,</para>
  <para style="q2" vid="JER 25:31">u ta̱ ta̱wa̱ nu ge'etosu a aci a vaɗilima̱ suru,</para>
  <para style="q1" vid="JER 25:31">a̱vu waru wu una a̱za̱ e iwuya suru</para>
  <para style="q2" vid="JER 25:31">na̱ matsun me pe'eni.&gt;&gt;</para>
  <para style="qr" vid="JER 25:31">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 25:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 25:32" />Apa ili i na a̱ A̱sulazuva</para>
  <para style="q2" vid="JER 25:32">oɓolo a̱ a̱soja a zuva a dammai,</para>
  <para style="q1" vid="JER 25:32">&lt;&lt;Ka̱lyuwa̱, addama a ta a yuwusan a̱bunda̱,</para>
  <para style="q2" vid="JER 25:32">diga a nɗa a̱ tyo a nɗa.</para>
  <para style="q1" vid="JER 25:32">Waru wunla̱ wu upepu u ta̱ 'yosun</para>
  <para style="q2" vid="JER 25:32">diga o ukosu wu uvaɗi.&gt;&gt;<verse eid="JER 25:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JER 25:33" />&lt;&lt;A mantsa'a aza a na A̱sulazuva o una a̱ ta̱ da̱na̱ uba̱ta̱ biti, diga o ukosu wu uvaɗi u nda acina a̱ yi ndeɗe. Waru a yuwan mesun mo a̱tsumola̱ngu adama e le shi. Agba o ɓoloto a̱kwa̱kwa̱ a̱ lipu le, adama a na a̱ ciɗo le shi. Amma a ta lyawa le e iɗa tsa̱ a̱ya̱n.&gt;&gt;<verse eid="JER 25:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="JER 25:34" />&lt;&lt;I yuwan mesun na̱ a̱tsumola̱ngu,</para>
  <para style="q2" vid="JER 25:34">a̱ɗu aza aguɓa,</para>
  <para style="q1" vid="JER 25:34">waru i gandala o okomo,</para>
  <para style="q2" vid="JER 25:34">a̱ɗu azagbain e ikyo i va̱.</para>
  <para style="q1" vid="JER 25:34">Adama a na mantsa ma na</para>
  <para style="q2" vid="JER 25:34">a paɗa ɗu yuwan ta̱.</para>
  <para style="q1" vid="JER 25:34">Waru i ta̱ riya̱</para>
  <para style="q2" vid="JER 25:34">a̱vu i ɓoso tsa aasa'atsu asa'ani.<verse eid="JER 25:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="JER 25:35" />Aza aguɓa a̱ tsura̱ ure u na</para>
  <para style="q2" vid="JER 25:35">a suma a̱ ka̱ra̱ shi,</para>
  <para style="q1" vid="JER 25:35">azagbain aza aguɓa a̱ tsura̱ uba̱ta̱ u na</para>
  <para style="q2" vid="JER 25:35">a la'ato wuma u le shi.<verse eid="JER 25:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 25:36" />Uwwa mesun ma aza aguɓa'a,</para>
  <para style="q2" vid="JER 25:36">na̱ yisali yaa azagbain o oɓolo'o.</para>
  <para style="q1" vid="JER 25:36">Adama a na A̱sulazuva o to kototosu</para>
  <para style="q2" vid="JER 25:36">uba̱ta̱ wa alyuna u le.<verse eid="JER 25:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 25:37" />Uɗolu u na wee yeneshe ben</para>
  <para style="q2" vid="JER 25:37">u to o'wo okongo</para>
  <para style="q2" vid="JER 25:37">adama o upan wu usuɗuwu wa̱ A̱sulazuva.<verse eid="JER 25:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 25:38" />Tsa kamu na lyawai uba̱ta̱ wu upa'anta wa̱ yi,</para>
  <para style="q2" vid="JER 25:38">iɗa i le i to o'wo okongo,</para>
  <para style="q1" vid="JER 25:38">adama a matsun me pe'eni</para>
  <para style="q2" vid="JER 25:38">ma aza a yipalishi</para>
  <para style="q2" vid="JER 25:38">oɓolo nu upan wu usuɗuwu wa̱ a̱ A̱sulazuva.&gt;&gt;<verse eid="JER 25:38" /></para>
  <chapter eid="JER 25" />
  <chapter number="26" style="c" sid="JER 26" />
  <para style="s">A yuwan ta̱ ifoɓi i na o una Irimiya</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 26:1" />A̱tsuma̱ a'wan o ufaru u tsugono tsa̱ mogono Jehoyakim ulobo wa̱ Josiya va Yahuda,<note caller="-" style="x"><char style="xo" closed="false">26:1 </char><char style="xt" closed="false"><ref loc="2KI 23:36">2 Ngo 23:36</ref>; <ref loc="2KI 24:6">24:6</ref>; <ref loc="2CH 36:5-6">2 Alb 36:5-6</ref>.</char></note> A̱sulazuva a yuwan ta̱ adanshi na̱ a̱mu u damma, <verse eid="JER 26:1" /><verse number="2" style="v" sid="JER 26:2" />apa ili i na A̱sulazuva a dammai, &lt;&lt;Vi isawan o ukowo wu u'wa u va̱, vu yuwan adanshi na a ama a na a̱ ta̱wa̱i diga e ilyuci ya Yahuda suru, ele na a̱ ta̱wa̱i o u'wa wa̱ A̱sulazuva adama a yuwan a̱ga̱nda̱. Vu damma le ili i na n damma nuwu suru, she vu jiba ko idanshi i ta̱ wan. <verse eid="JER 26:2" /><verse number="3" style="v" sid="JER 26:3" />U ta gura o'wo a uwwa, za suru a̱tsuma̱ e le ta gura vadala diga a̱tsuma̱ o ure wi iwuya ya̱ yi. To, nna a yuwan ne, n ta vadala ifoɓi i va̱ n tawa addama a na n foɓoi adama a linga vi iwuya i na a yuwain.&gt;&gt; <verse eid="JER 26:3" /><verse number="4" style="v" sid="JER 26:4" />Vu damma le, &lt;&lt;Apa ili i na A̱sulazuva a dammai, nni i zuwaa mu atsuvu shi, waru i yuwan mmalu a̱tsuma̱ o uritosu u va̱ na n zuwai elime a̱ ɗu shi, <verse eid="JER 26:4" /><verse number="5" style="v" sid="JER 26:5" />nni i zuwaa idanshi yaa agbashi a̱ va̱ ama̱sula̱ atsuvu shi, aza a na n lyunguwa̱ nɗu kuci, ko na wo o'woi yu uwwa shi, <verse eid="JER 26:5" /><verse number="6" style="v" sid="JER 26:6" />to, nni i vadala i yuwaan mu tsutoni shi, n ta̱ ɓoso u'wa u nda, ununa mu ɓosoi uba̱ta̱ wa̱ a̱ga̱nda̱ a̱ Shilo<note caller="+" style="f"><char style="fr" closed="false">26:6 </char><char style="fq" closed="false">Shilo </char><char style="ft" closed="false">Uba̱ta̱ u ro u ɗa u na a yuwusayin A̱sulazuva a̱ga̱nda̱, kafu a suwa A̱a̱'isamapaɗa a̱ Sulemanu, agba gogo wo o'wo ta̱ okongo.</char></note>. A̱vu n ka̱mbuwa̱ ala a̱ lyuci nda wo o'wo ili i na a yuwayin una̱ a̱tsuma̱ a nɗa mu uvaɗi suru.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">26:6 </char><char style="xt" closed="false"><ref loc="JOS 18:1">Jos 18:1</ref>; <ref loc="PSA 78:60">Ica 78:60</ref>; <ref loc="JER 7:12-14">Irm 7:12-14</ref>.</char></note><verse eid="JER 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 26:7" />&lt;&lt;Reve nan ganu na ama̱sula̱ oɓolo na ama suru, a uwwa Irimiya a dansa idanshi i nda o u'wa wa̱ A̱sulazuva.&gt;&gt; <verse eid="JER 26:7" /><verse number="8" style="v" sid="JER 26:8" />A mantsa ma na Irimiya kotoi adansa suru ili i na A̱sulazuva a damma niyi u damma, reve nan ganu na ama̱sula̱ oɓolo na ama suru e reme yi, a damma, &lt;&lt;Ko vu 'yuwan vu ciga vu kuwa̱! <verse eid="JER 26:8" /><verse number="9" style="v" sid="JER 26:9" />Adama nye vu yuwain adanshi e ikaka na ala A̱sulazuva, na vu dammai o to ɓoso u'wa u nda ununa a yuwain na̱ Shilo? Adama nye vu dammai lyuci nda to o'wo okongo, waru za a̱ da̱nu pe shi?&gt;&gt; Reve a ama suru oɓoloto a̱ ka̱nda̱ruwa̱ Irimiya a̱tsuma̱ o u'wa wa̱ A̱sulazuva.<verse eid="JER 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 26:10" />A mantsa ma na nan a̱duga̱ri a Yahuda a uwwai a ɗa nda, reve o uta̱ diga o ukobu u mogono a̱ tyo o u'wa wa̱ A̱sulazuva, a̱vu a̱ da̱nu za suru o uba̱ta̱ wu nden ma̱ yi, reve a yuwan iɓolo o Una̱ntsu u Sa'avu wu u'wa wa̱ A̱sulazuva. <verse eid="JER 26:10" /><verse number="11" style="v" sid="JER 26:11" />Ɗaɗa nan ganu'u na ama̱sula̱'a̱ a dammai a̱duga̱ri'i na ama'a suru ana, &lt;&lt;Irimiya, vuma nda ntsaa ta̱ a paɗaa yi ugana wu ukwa̱, adama a na u yuwan ta̱ adanshi e ikaka a aci a̱ lyuci nda, ununa yu uwwai na atsuvu ɗu!&gt;&gt;<verse eid="JER 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 26:12" />Reve Irimiya yuwan adanshi na̱ a̱duga̱ri'i na ama'a u damma, &lt;&lt;A̱sulazuva a ɗa a̱ lyungu numu n damma adanshi e ikaka i nda a aci o u'wa u nda na̱ lyuci nda, ununa yu uwwai. <verse eid="JER 26:12" /><verse number="13" style="v" sid="JER 26:13" />Adama o ndolo, she i lapula wuma u ɗu, na̱ linga ɗu, waru i yuwan tsutoni nu uɗyo wa̱ A̱sulazuva A̱sula̱ a̱ ɗu, ɗaɗa A̱sulazuva a vadala ifoɓi ya̱ yi adama a addama a na u dammai a aci a̱ ɗu. <verse eid="JER 26:13" /><verse number="14" style="v" sid="JER 26:14" />Amma a̱mu gba, n ta̱ ekere ɗu, she i yuwaan mu ili i na yenei ulobono nɗu, waru wuntsaa nɗu. <verse eid="JER 26:14" /><verse number="15" style="v" sid="JER 26:15" />Amma i reve, ili i ro yi lo shi nna̱ yu una mu, i ta̱ ronoo aciya̱ɗu okofi a mpasa m babu unusu, oɓolo na̱ lyuci nda na̱ nda̱na̱ta̱ ma̱ yi. Amayun za ta̱ ɗa, A̱sulazuva a ɗa a̱ lyungu numu uba̱ta̱ u ɗu, adama n damma adanshi a nda atsuvu a̱ ɗu.&gt;&gt;<verse eid="JER 26:15" /></para>
  <para style="s">A wawa ta̱ wuma wa̱ Irimiya</para>
  <para style="p">
    <verse number="16" style="v" sid="JER 26:16" />Ɗaɗa nan a̱duga̱ri'i na ama'a suru a dammai nan ganu'u na ama̱sula̱'a̱, &lt;&lt;Vuma nda wuntsaa a paɗaa yi ugana wu ukwa̱ shi, adama a na u yuwaan tsu ta̱ adanshi na ala A̱sulazuva a̱ A̱sula̱ a̱ tsu.&gt;&gt; <verse eid="JER 26:16" /><verse number="17" style="v" sid="JER 26:17" />Ɗaɗa ozo o ro a̱tsuma̱ a mbara n lyuci'i a̱ 'yoyin mishin, a yuwaayin oɓolo ama'a adanshi a damma, <verse eid="JER 26:17" /><verse number="18" style="v" sid="JER 26:18" />&lt;&lt;Vumava̱sula̱ Mika diga Moreshete yuwan ta̱ adanshi e ikaka, a mantsa ma na mogono Hezekiya da̱na̱i o tsugono tsa Yahuda.&gt;&gt; Mika yuwaan ta̱ ama suru adanshi u damma,</para>
  <para style="b" vid="JER 26:18" />
  <para style="q1" vid="JER 26:18">Apa ili i na A̱sulazuva</para>
  <para style="q2" vid="JER 26:18">oɓolo a̱ a̱soja a zuva dammai,</para>
  <para style="q1" vid="JER 26:18">&lt;&lt;A ta luma Sihiyona</para>
  <para style="q2" vid="JER 26:18">cine a tsu luma uɗuma̱,</para>
  <para style="q2" vid="JER 26:18">Urishelima to o'wo edemu e everi,</para>
  <para style="q1" vid="JER 26:18">aagaɗi a na a suwai</para>
  <para style="q2" vid="JER 26:18">u'wa wa̱ A̱sulazuva zuva va̱ yi</para>
  <para style="q2" vid="JER 26:18">u to o'wo olopu.&gt;&gt;<verse eid="JER 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 26:19" />Reve a lyuwa elime na adanshi a damma, &lt;&lt;To, mogono Hezekiya va Yahuda na akapi ama a Yahuda o una ta̱ Mika vumava̱sula̱ ɗa? Ko ke'en! Ashe Hezekiya uwwa wovon wa̱ A̱sulazuva u pati ya̱ A̱sulazuva, u vadala ifoɓi ya̱ yi adama addama a na u foɓoi, na wa̱a̱ ta̱wa̱a̱ aciyele shi? Gogo tsu ta̱ zuzu na tsa̱a̱ ta̱wa̱a̱ aciya̱tsu na̱ a̱ba̱jini addama!&gt;&gt;<verse eid="JER 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 26:20" />&lt;&lt;Waru a̱ da̱na̱ ta̱ na̱ vuma ro na yuwain adanshi e ikaka na ala A̱sulazuva. Ala a vuma ndolo ɗa Uriya ulobo wa Shemaya diga Kiriyat Jeyarim. U yuwan ta̱ adanshi e ikaka a aci a̱ lyuci nda ni iɗa i nda ununa Irimiya yuwain. <verse eid="JER 26:20" /><verse number="21" style="v" sid="JER 26:21" />A mantsa ma na mogono Jehoyakim na̱ nan a̱duga̱ri a̱ yi oɓolo na̱ a̱soja a̱ yi suru a uwwai adanshi a vuma ndolo, reve mogono ma zami ure u na wo unai. Amma a mantsa ma na Uriya u uwwai ifoɓi i mogono, a̱vu wu uwwa wovon u suma a̱ tyo Masar adama u la'a. <verse eid="JER 26:21" /><verse number="22" style="v" sid="JER 26:22" />Ɗaɗa mogono Jehoyakim lyunguyi Elinatan ulobo wa Akbo, oɓolo na ama o ro a̱ tyo Masar. <verse eid="JER 26:22" /><verse number="23" style="v" sid="JER 26:23" />Reve e reme Uriya o uta̱ yi e iɗa ya Masar a̱ ta̱wa̱ na̱ yi uba̱ta̱ u mogono Jehoyakim. Reve mogono mo o una yi na̱ matsun me pe'eni, reve a vari a̱ a̱kwa̱kwa̱ a̱ lipu va̱ yi uba̱ta̱ u na a̱ ciɗosu alambi.&gt;&gt;<verse eid="JER 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 26:24" />Ana mbara'a n kotoi adanshi'i suru, a̱vu Ahikam ulobo wa Shafa isawaan Irimiya, adama o ndolo a ca yi e ekere a ama adama o unai shi.<verse eid="JER 26:24" /></para>
  <chapter eid="JER 26" />
  <chapter number="27" style="c" sid="JER 27" />
  <para style="s">Yahuda ta yuwaan Nebukanaza ulinga</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 27:1" />A̱tsuma̱ o ufaru u tsugono tsa̱ mogono Zedekiya ulobo wa̱ Josiya va Yahuda, A̱sulazuva a damma ta̱ Irimiya adanshi a nda,<note caller="-" style="x"><char style="xo" closed="false">27:1 </char><char style="xt" closed="false"><ref loc="2KI 24:18-20">2 Ngo 24:18-20</ref>; <ref loc="2CH 36:11-13">2 Alb 36:11-13</ref>.</char></note> <verse eid="JER 27:1" /><verse number="2" style="v" sid="JER 27:2" />&lt;&lt;apa ili i na A̱sulazuva a damma numu, vu yuwaan aciya̱wu a̱a̱gba̱la̱ e inan yi iluma, waru vu yuwan amunga o ukwa, reve vu nla̱ a̱a̱gba̱la̱'a̱ a̱ yinlu ya̱ wu. <verse eid="JER 27:2" /><verse number="3" style="v" sid="JER 27:3" />A̱vu vu lyungu ni ikaka a̱ tyo ya̱ mogono ma̱ Edom na̱ mogono ma Mowa na̱ mogono ma Amon na̱ mogono ma Taya oɓolo na̱ mogono ma̱ Sidon e ekere a nlingata nle nna n ta̱wa̱i Urishelima adama a na ene mogono Zedekiya va Yahuda. <verse eid="JER 27:3" /><verse number="4" style="v" sid="JER 27:4" />Waru vu damma le a̱ ka̱ra̱ a̱ 'ya̱wa̱ a damma azagbain e le, ikaka i nda na yu uta̱i diga uba̱ta̱ wa̱ A̱sulazuva oɓolo a̱ a̱soja a zuva, A̱sula̱ a Isra'ila ana, <verse eid="JER 27:4" /><verse number="5" style="v" sid="JER 27:5" />A̱mu ɗa nu ukere wu ucira u va̱ na̱ linga gbagbain va asalama a̱ va̱ n yuwain uvaɗi, oɓolo na̱ vaɗilima̱ suru, ni iliyamunga ya̱ yi suru na ri pe a̱tsuma̱ a̱yi. Waru n ca yi ta̱ e ekere a za na me enei n ta gura ca. <verse eid="JER 27:5" /><verse number="6" style="v" sid="JER 27:6" />Gogo n ca ta̱ iɗa i ɗu suru e ekere mogono Nebukanaza va Babila, hali fo ni inama yu una a ta yuwayin ulinga. <verse eid="JER 27:6" /><verse number="7" style="v" sid="JER 27:7" />Nɗa suru n ta yuwayin tsugbashi, a̱yi na̱ mawun ma̱ yi, na̱ mawun ma tsukaya ma̱ yi, hali acina mantsa ma na n zuwai iɗa ya̱ yi i riya̱. A̱vu nɗa na̱ a̱bunda̱ na̱ ngono m gbagbain n la'a ucira wa̱ yi.&gt;&gt;<verse eid="JER 27:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 27:8" />&lt;&lt;Amma nna̱ nɗa n ro ko tsugono tso o ro tsa 'yuwan aa yuwaan mogono Nebukanaza va Babila tsugbashi, ko u 'yuwan a ca aci za̱la̱ vu ucira mogono'o, ununa nan vi iluma tsu ca yinlu a zuwayi a̱a̱gba̱la̱, n ta̱ ge'eto nɗa ndolo na̱ matsun me pe'eni na ambulu na̱ mɓa̱la̱, hali she na̱ n kototo nɗa nda e ekere Nebukanaza.&gt;&gt; Ne ɗa A̱sulazuva a dammai. <verse eid="JER 27:8" /><verse number="9" style="v" sid="JER 27:9" />Adama o ndolo, she i poloo ama̱sula̱ a̱ɗu atsuvu wan, na̱ a̱za̱ a̱ yindi, na aza a na a tsu cuɗuwusa alavu, ko aza a na o ɓoloso aci na̱ ruhu va̱ a̱kwa̱kwa̱, ko a̱za̱ a̱ nkunu wan, aza a na a dansaa ɗu, &lt;&lt;Yaa yuwaan mogono ma Babila tsugbashi shi.&gt;&gt; <verse eid="JER 27:9" /><verse number="10" style="v" sid="JER 27:10" />&lt;&lt;Na amayun a ta yuwusan ɗu adanshi e ikaka ye epen ɗa, za na a zuwa a̱ 'ya̱wa̱to ɗu e iɗa i ro i na i ri zuzu ni iɗa i ɗu shi. N ta̱ gba̱ra̱ ɗu yu uta̱ diga a̱tsuma̱ e iɗa i ɗu, waru i ta̱ kuwa̱ e iɗa i ro. <verse eid="JER 27:10" /><verse number="11" style="v" sid="JER 27:11" />Amma iɗa i na i cayi aciya̱yi suru, za̱la̱ va̱ a̱gba̱la̱ o ucira u mogono ma Babila adama u yuwayin a̱ga̱nda̱, n ta lyawai e iɗa ya̱ yi, adama u cimba yi, waru u da̱nu pe a̱tsuma̱ a̱yi. Ne ɗa A̱sulazuva a dammai.&gt;&gt;<verse eid="JER 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 27:12" />N damma ta̱ mogono Zedekiya va Yahuda adanshi a nda ana,&lt;&lt;Vu ca aciya̱wu za̱la̱ va̱ a̱gba̱la̱ o ucira u mogono ma Babila, vu yuwayin a̱ga̱nda̱ oɓolo na ama a̱yi, vu ta̱ gba a̱ da̱na̱ wuma. <verse eid="JER 27:12" /><verse number="13" style="v" sid="JER 27:13" />Adama nye a̱vu na ama a̱ wu ya̱a̱ kuwa̱ o ure u matsun me pe'eni, na ambulu na̱ mɓa̱la̱, ununa A̱sulazuva a dammai yaa fara na̱ nɗa suru na 'yuwain a yuwaan mogono ma Babila tsugbashi? <verse eid="JER 27:13" /><verse number="14" style="v" sid="JER 27:14" />Waru she yu uwwa adanshi ama̱sula̱ a̱ɗu a na a dansaa ɗu ana, &lt;She i yuwaan mogono ma Babila a̱ga̱nda̱ wan,&gt; Adama a na adanshi e ikaka ye epen a ɗa a yuwusan ɗu, <verse eid="JER 27:14" /><verse number="15" style="v" sid="JER 27:15" />adama a na n lyungu le shi.&gt;&gt; Ne ɗa A̱sulazuva a dammai. &lt;&lt;A̱yi nda ta zuwa mu m gba̱ra̱ ɗu a̱tsuma̱ e iɗa i ɗu, agba i ta̱ kuwa̱, a̱ɗu na ama̱sula̱ a̱ɗu a na a yuwusaan ɗu adanshi e ikaka ye epen.&gt;&gt;<verse eid="JER 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 27:16" />Ana n kotoi a yuwusan adanshi na̱ mogono, reve a̱mu Irimiya n ka̱ra̱ n yuwan adanshi na̱ nan ganu oɓolo na ama suru ana, &lt;&lt;Apa ili i na A̱sulazuva a dammai, &lt;She i poloo ama̱sula̱ a nda atsuvu aza a na a dansa, &lt;&lt;Ka̱lyuwa̱, a jima shi, a̱ ta̱ ka̱mbuwa̱ ni itana i na a̱ pura̱i suru diga o u'wa wa̱ A̱sulazuva a̱ tyo Babila.&gt;&gt; Adanshi e ikaka ye epen i ɗa goon a yuwusaan ɗu. <verse eid="JER 27:16" /><verse number="17" style="v" sid="JER 27:17" />She yu uwwa ama̱sula̱ a nda wan. A̱ɗu de i yuwaan mogono ma Babila tsugbashi, i ta̱ gba da̱na̱ wuma. Adama nye yaa zuwa o ɓoso lyuci nda, a̱ ka̱mbuwa̱i okongo? <verse eid="JER 27:17" /><verse number="18" style="v" sid="JER 27:18" />Nna amayun a ɗa e le ama̱sula̱ a na a̱ ri ni ikaka ya̱ A̱sulazuva a ɗa, to, lyawa a pati A̱sulazuva oɓolo a̱ a̱soja a zuva, adama akapi e itana i na i buwai o u'wa wa̱ A̱sulazuva o u'wa u mogono ma Yahuda, oɓolo na̱ lyuci gbain va̱ Urishelima, adama she a̱ ka̱ra̱ na̱ le a̱ tyo Babila wan. <verse eid="JER 27:18" /><verse number="19" style="v" sid="JER 27:19" />Adama a na apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva dammai, i cuwan mogono Nebukanaza va Babila lyawa ta̱ atsura oɓolo na̱ a̱ba̱jini akwanu na a̱ tsu ɗe Mala, ni ili i mishin i na a tsu tawa, na akapi e itana i ro lo a̱ lyuci'i. <verse eid="JER 27:19" /><verse number="20" style="v" sid="JER 27:20" />Mogono Nebukanaza pura̱ le shi, a mantsa ma na u ka̱ra̱i na̱ mogono Yekoniya ulobo wa̱ Jehoyakim va Yahuda, oɓolo na azagbain ama a Yahuda diga Urishelima a̱ tyo Babila. <verse eid="JER 27:20" /><verse number="21" style="v" sid="JER 27:21" />Na amayun, apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva A̱sula̱ a Isra'ila a dammai, adama akapi e itana i na a lyawai a̱tsuma̱ o u'wa wa̱ A̱sulazuva, na̱ a̱tsuma̱ o u'wa u mogono ma Yahuda na̱ a̱tsuma̱ a̱ Urishelima, <verse eid="JER 27:21" /><verse number="22" style="v" sid="JER 27:22" />&lt;&lt;a̱ ta̱ pura̱ le a̱ tyo Babila. Ɗe ɗa a̱ da̱na̱, hali acina urana u na maa cuwan ne le,&gt;&gt; Ne ɗa A̱sulazuva a dammai. &lt;&lt;Reve n ka̱mba̱to le n zuwisa le uba̱ta̱ u nda.&gt;&gt; &gt; &gt;&gt;<verse eid="JER 27:22" /></para>
  <chapter eid="JER 27" />
  <chapter number="28" style="c" sid="JER 28" />
  <para style="s">Hananiya vumava̱sula̱ ve epen</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 28:1" />Ele lo a̱tsuma̱ a'wan o ndolo, o woto wa tawun wa a'wan a̱ na̱shi, wu ufaru u tsugono tsa̱ mogono Zedekiya va Yahuda, reve vumava̱sula̱ Hananiya ulobo wa Azur vuma va̱ Gibiyon yuwan adanshi na̱ mu o u'wa wa̱ A̱sulazuva. Waru u yuwan ta̱ adanshi'i elime a nan ganu na ama'a suru u damma, <verse eid="JER 28:1" /><verse number="2" style="v" sid="JER 28:2" />&lt;&lt;Apa ili i na A̱sulazuva oɓolo a̱ a̱soja a zuva, A̱sula̱ a Isra'ila a dammai, &lt;N ta kuɗa a̱a̱gba̱la̱ a̱ yinlu a na mogono ma Babila ma̱a̱ nla̱a̱ nɗu. <verse eid="JER 28:2" /><verse number="3" style="v" sid="JER 28:3" />A̱tsuma̱ a'wan e re, n ta̱ ka̱mba̱to ni itana yu u'wa wa̱ A̱sulazuva uba̱ta̱ u nda, na amayun itana i na mogono Nebukanaza va Babila pura̱i diga o u'wa wa̱ A̱sulazuva. <verse eid="JER 28:3" /><verse number="4" style="v" sid="JER 28:4" />Waru n ta̱ ka̱mba̱to mogono Yekoniya ulobo u mogono Jehoyakim va Yahuda uba̱ta̱ u nda. Ne ɗa fo ma̱a̱ ka̱mba̱to aza a na a̱ pura̱i suru diga a Yahuda a̱ tyo Babila tsugbashi, adama a na n ta kuɗa a̱a̱gba̱la̱ a̱ yinlu a na Babila zuwaa nle. Ne ɗa A̱sulazuva a dammai.&gt; &gt;&gt;<verse eid="JER 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 28:5" />Ɗaɗa vumava̱sula̱ Irimiya usuyi vumava̱sula̱ Hananiya elime a nan ganu, na ama a na a̱ ri lo mishin o u'wa wa̱ A̱sulazuva suru, <verse eid="JER 28:5" /><verse number="6" style="v" sid="JER 28:6" />u damma, &lt;&lt;Amin! Lyawa A̱sulazuva a zuwa wo o'wo ne! Lyawa A̱sulazuva o shiton adanshi e ikaka i na vu yuwain, na̱ a̱ ka̱mba̱to itana yu u'wa wa̱ A̱sulazuva, oɓolo na ama a na a̱ pura̱i suru a̱ tyo e iɗa i tsugbashi, diga a Babila a̱ tyo uba̱ta̱ u nda. <verse eid="JER 28:6" /><verse number="7" style="v" sid="JER 28:7" />Na̱ ne suru, she vu polo atsuvu e idanshi i na maa damma atsuvu a̱ wu, oɓolo na atsuvu ama a nda suru. <verse eid="JER 28:7" /><verse number="8" style="v" sid="JER 28:8" />Diga ɗe o ufaru ama̱sula̱ a na a̱ da̱na̱i elime a̱tsu, a̱mu na̱ a̱vu, a yuwan ta̱ adanshi e ikaka yu uvon, oɓolo na addama na̱ mɓa̱la̱ e ekere a nɗa ma̱a̱ a̱bunda̱ na̱ a̱za̱ o tsugono tsa a gbain. <verse eid="JER 28:8" /><verse number="9" style="v" sid="JER 28:9" />Amma vumava̱sula̱ na yuwain adanshi e ikaka ya asuvu nden, a̱yi ɗa a tsu tara o una̱ wu za na A̱sulazuva a̱ lyunguyi, hali nni ili i na fo u dammai u shiwan na amayun.&gt;&gt;<verse eid="JER 28:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 28:10" />Ɗaɗa vumava̱sula̱ Hananiya tawai a̱a̱gba̱la̱ a̱ yinlu a na a̱ da̱na̱i a̱ yinlu ya̱ Irimiya vumava̱sula̱ reve u kuɗa yi, <verse eid="JER 28:10" /><verse number="11" style="v" sid="JER 28:11" />elime ama'a suru u damma, &lt;&lt;Apa ili i na A̱sulazuva a dammai, &lt;Ne ɗa maa kuɗa a̱a̱gba̱la̱ a̱ yinlu o mogono Nebukanaza va Babila diga a̱ yinlu yi nɗa a̱tsuma̱ a a'wan e re.&gt; &gt;&gt; Diga lo ɗaɗa Irimiya vumava̱sula̱ yuwain mmalu ma̱ yi.<verse eid="JER 28:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 28:12" />Ana a tarai mantsa wa'a, a na vumava̱sula̱ Hananiya kuɗai a̱a̱gba̱la̱ a̱ yinlu a na a̱ da̱na̱i a̱ yinlu ya̱ Irimiya vumava̱sula̱, ɗaɗa A̱sulazuva a yuwain adanshi na̱ Irimiya ana, <verse eid="JER 28:12" /><verse number="13" style="v" sid="JER 28:13" />&lt;&lt;Ka̱ra̱ vu damma Hananiya ana, &lt;Apa ili i na A̱sulazuva a dammai, mee ene ta̱ vu kuɗai a̱a̱gba̱la̱ a̱ yinlu a aɗanga nda, o una̱ u ndolo n ta yuwan a̱a̱gba̱la̱ e irumu.&gt; &gt;&gt; <verse eid="JER 28:13" /><verse number="14" style="v" sid="JER 28:14" />Adama a na apa ili i na A̱sulazuva oɓolo a̱ a̱soja a zuva, A̱sula̱ a Isra'ila a dammai, &lt;&lt;N ta zuwa a̱a̱gba̱la̱ a̱ rumu a̱ yinlu yi nɗa nda suru, adama a na aa yuwaan mogono Nebukanaza va Babila tsugbashi, ko a 'yuwan a ciga a yuwayin tsugbashi. N ta̱ fo a zuwa yi u yuwan tsugbain a aci e inama yu una.&gt;&gt;<verse eid="JER 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 28:15" />Ɗaɗa vumava̱sula̱ Irimiya dammai Hananiya vumava̱sula̱ ana, &lt;&lt;Uwwa ne'e Hananiya, A̱sulazuva a̱ lyungu wu shi, na̱ ne suru vu kpara ta̱ a ama a nda a zuwa okolo e epen. <verse eid="JER 28:15" /><verse number="16" style="v" sid="JER 28:16" />Adama o ndolo, apa ili i na A̱sulazuva a dammai, &lt;N ta̱ o mpolo nna maa tawa wu diga o urewesu wu uvaɗi. Vu ta̱ gba a̱ kuwa̱ a̱tsuma̱ a a'wan a nda, adama a na vu yuwan ta̱ alajiya aciyogbamu e ekere a̱ A̱sulazuva.&gt; &gt;&gt;<verse eid="JER 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 28:17" />Ɗaɗa Hananiya vumava̱sula̱ kuwa̱i o woto wa̱ cindere a aa'wan o ndolo.<verse eid="JER 28:17" /></para>
  <chapter eid="JER 28" />
  <chapter number="29" style="c" sid="JER 29" />
  <para style="s">Mepepelime a̱ tyo uba̱ta̱ wa aza a na a̱ ri a tsugbashi</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 29:1" />Apa idanshi yi ikaka i na Irimiya vumava̱sula̱ lyunguyi diga Urishelima a̱ tyo uba̱ta̱ wa akapi a mbara ma ama a Yahuda, na̱ nan ganu na ama̱sula̱ oɓolo na ama a na Nebukanaza pura̱i diga Urishelima a̱ tyo tsugbashi Babila. <verse eid="JER 29:1" /><verse number="2" style="v" sid="JER 29:2" />U ɗana ta̱ idanshi yi ikaka'a cina a tara mogono Yekoniya a̱ tyo Babila oɓolo ne egbere mma mogono, na azagbain o ukobu u mogono na azagbain a Yahuda na̱ Urishelima, na̱ a̱za̱ o ulinga wu ukere, oɓolo na aruma diga Urishelima. <verse eid="JER 29:2" /><verse number="3" style="v" sid="JER 29:3" />A̱vu Irimiya lyungu ikaka'a e ekere Elasa ulobo wa Shafa na̱ Gemariya ulobo wa Hilikiya aza a na mogono Zedekiya va Yahuda lyunguyi Babila, uba̱ta̱ u mogono Nebukanaza va Babila. Apa ili i na idanshi yi ikaka'a ya dansa,<verse eid="JER 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 29:4" />&lt;&lt;Apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva A̱sula̱ a Isra'ila a dammai, a̱ tyo uba̱ta̱ wa aza a na a̱ pura̱i diga Urishelima a̱ tyo tsugbashi a Babila. <verse eid="JER 29:4" /><verse number="5" style="v" sid="JER 29:5" />&lt;I suwaa aciya̱ɗu 'wa i da̱nu pe. I shuwa̱ ɗanga waru i lyuwa umatsun u le. <verse eid="JER 29:5" /><verse number="6" style="v" sid="JER 29:6" />Yuwain lolo i matsan olobo ne esheli. Waru i zamiya muwun mo olobo n ɗu a̱ma̱ci, adama a matsan muwun mo olobo ne esheli. I da̱na̱ a mamatsan ɗe i yuwan a̱bunda̱, waru she i jiba a̱bunda̱ wan. <verse eid="JER 29:6" /><verse number="7" style="v" sid="JER 29:7" />Amma i zami nden n lafiya ɗe a̱ lyuci na n tyowetyo nɗu tsugbashi. Waru i yuwan avasa uba̱ta̱ wa̱ A̱sulazuva adama o uba̱ta̱'a̱, adama a na nden n lafiya mu uba̱ta̱'a̱ a̱ yi ɗa nden n lafiya n ɗu. <verse eid="JER 29:7" /><verse number="8" style="v" sid="JER 29:8" />Adama a na apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva A̱sula̱ a Isra'ila a dammai, &lt;&lt;She i lyawa ama̱sula̱ a̱ ɗu na̱ a̱za̱ a̱ yindi a na a̱ ri a̱tsuma̱ a̱ ɗu a̱ luluma̱ ɗu wan. She i polo atsuvu a alavu a na i cigai a yuwaan ɗu wan. <verse eid="JER 29:8" /><verse number="9" style="v" sid="JER 29:9" />A ta yuwusaan ɗu adanshi e ikaka ye epen na ala a̱ va̱. Agba n lyungu le shi,&gt;&gt; &gt;</para>
  <para style="qr" vid="JER 29:9">ne ɗa A̱sulazuva a dammai.<verse eid="JER 29:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 29:10" />&lt;&lt;Apa ili i na A̱sulazuva a dammai, a mantsa ma na i shiwain a'wan kupocindere za̱la̱ tsugono tsa Babila, n ta bura ɗu, waru n ta̱ shiton nzuwulai n sa'ani n na n yuwaan nɗu, nzuwulai n na ma̱a̱ ka̱mba̱to ɗu uba̱ta̱ u nda.<note caller="-" style="x"><char style="xo" closed="false">29:10 </char><char style="xt" closed="false"><ref loc="2CH 36:21">2 Alb 36:21</ref>; <ref loc="JER 25:11">Irm 25:11</ref>; <ref loc="DAN 9:2">Dan 9:2</ref>.</char></note> <verse eid="JER 29:10" /><verse number="11" style="v" sid="JER 29:11" />N reve ta̱ cu'un vi ifoɓi i na n ri na̱ yi aci ya̱ ɗu. Ifoɓi yi isa'ani, agba yi iwuya shi, adama n ca ɗu uzuwu wo okolo na̱ wuma u sa'ani u na i cigai nda a̱ tyo elime. Ne ɗa A̱sulazuva a dammai. <verse eid="JER 29:11" /><verse number="12" style="v" sid="JER 29:12" />Ne ɗa yaa yuwan ɗesu uba̱ta̱ u va̱, a̱vu i vadala i yuwan avasa uba̱ta̱ u va̱, reve mu uwwa ɗu. <verse eid="JER 29:12" /><verse number="13" style="v" sid="JER 29:13" />I ta zami mu reve i tsura̱ mu, n ni i zami mu no okolo a̱ ɗu suru.<note caller="-" style="x"><char style="xo" closed="false">29:13 </char><char style="xt" closed="false"><ref loc="DEU 4:29">U.Wl 4:29</ref>.</char></note> <verse eid="JER 29:13" /><verse number="14" style="v" sid="JER 29:14" />Waru n ta zuwa i tsura̱ mu. A̱vu n ka̱mbuwa̱a̱ ɗu aba'un a̱ ɗu, a̱vu m ɓoloto ɗu diga a̱tsuma̱ a nɗa suru na̱ ba̱ta̱ na suru m gba̱ra̱ nɗu, ne ɗa A̱sulazuva a dammai. N ta̱ ka̱mba̱to ɗu uba̱ta̱ u nda, diga uba̱ta̱ u na n zuwai a̱ pura̱ ɗu a̱ tyo tsugbashi. Ne ɗa A̱sulazuva a dammai.&gt;&gt;<verse eid="JER 29:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 29:15" />&lt;&lt;I ta gura damma, &lt;A̱sulazuva a̱ 'ya̱sa̱n ta̱ ama̱sula̱ adama a̱ tsu a̱tsuma̱ a Babila,&gt; <verse eid="JER 29:15" /><verse number="16" style="v" sid="JER 29:16" />agba apa ili i na A̱sulazuva a dammai adama o mogono, za na ri nden o ootogu o tsugono tsa̱ Da̱wuda, oɓolo na ama a na a buwai suru a̱tsuma̱ a̱ lyuci nda, ele nro mu nden n ɗu aza a na o toni nɗu a̱ tyo tsugbashi shi, <verse eid="JER 29:16" /><verse number="17" style="v" sid="JER 29:17" />na amayun,&gt;&gt; apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva dammai, &lt;&lt;N ta̱ lyungu na̱ matsun me pe'eni na ambulu na̱ mɓa̱la̱ a aci le, waru n ta zuwa le o o'wo tsu biri na shamai hali na a gura lyuwa le shi adama o ulambu wu ulobonu u le. <verse eid="JER 29:17" /><verse number="18" style="v" sid="JER 29:18" />N ta saɓa le na̱ matsun me pe'eni na ambulu na̱ mɓa̱la̱, waru n zuwa le o o'wo ili i wovon uba̱ta̱ wa̱ a̱za̱ o tsugono tsu uvaɗi suru, ni ili i na a yuwayin una̱ ni ili i wovon ni ili i macuru ni ili yi izo'oshi e ekere a nɗa suru, a̱ tyo uba̱ta̱ u na n gba̱ra̱ nle a̱ tyo biti. <verse eid="JER 29:18" /><verse number="19" style="v" sid="JER 29:19" />Adama a na a uwwa adanshi a̱ va̱ shi,&gt;&gt; ne ɗa A̱sulazuva a dammai, &lt;&lt;Idanshi i na n lyungusa̱ n le kuci diga o una̱ wa agbashi a̱ va̱ ama̱sula̱. Agba a̱ɗu na i ri nden e iɗa i tsugbashi yu uwwa shi,&gt;&gt; ne ɗa A̱sulazuva a dammai.<verse eid="JER 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 29:20" />&lt;&lt;Adama o ndolo, yu uwwa adanshi A̱sulazuva, a̱ɗu na m gba̱ra̱i suru diga Urishelima a̱ tyo Babila tsugbashi.&gt;&gt; <verse eid="JER 29:20" /><verse number="21" style="v" sid="JER 29:21" />Apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva a̱ A̱sula̱ a Isra'ila dammai, adama Ahabu ulobo wa̱ Kolaya na̱ Zedekiya ulobo wa Ma'aseya, aza a na a yuwusan adanshi e ikaka ye epen na ala a̱ va̱. &lt;&lt;N ta ca le ekere o mogono Nebukanaza va Babila, waru u ta̱ o una le esu a̱ ɗu. <verse eid="JER 29:21" /><verse number="22" style="v" sid="JER 29:22" />Adama e ili i na yaa cina le, ama a Yahuda suru aza a na a̱ tyowetyoi tsugbashi a Babila, a̱ ta̱ bunga̱ danshi vu una̱ n na a dansa, &lt;Lyawa A̱sulazuva a̱ ka̱mba̱to wu tsa vumava̱sula̱ Zedekiya na̱ vumava̱sula̱ Ahabu aza a na mogono ma Babila ma̱ kula̱toi na akina!&gt; <verse eid="JER 29:22" /><verse number="23" style="v" sid="JER 29:23" />Adama a na a yuwan ta̱ linga vi iwuya a̱tsuma̱ a Isra'ila, a yuwan ta̱ tsipere na̱ a̱ma̱ci o nro mu nden n le, reve fo a yuwan adanshi epen na ala a̱ va̱, adanshi a na n damma le shi. A̱mu n reve ta̱, waru a̱mu ɗa esu aciya̱va̱. Ne ɗa A̱sulazuva a dammai.&gt;&gt;<verse eid="JER 29:23" /></para>
  <para style="s">Ikaka a̱ tyo ya̱ Shemaya</para>
  <para style="p">
    <verse number="24" style="v" sid="JER 29:24" />&lt;&lt;Vu damma Shemaya vuma va̱ Nehelam, <verse eid="JER 29:24" /><verse number="25" style="v" sid="JER 29:25" />apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva a̱ A̱sula̱ a Isra'ila dammai, vu lyungu ta̱ na̱ mpepelime na ala a̱ wu a̱ tyo uba̱ta̱ wa ama a̱ Urishelima suru, a̱ tyo ya Zafaniya ulobo wa Maseya ganu, oɓolo na akapi a nan ganu. Vu damma Zafaniya, <verse eid="JER 29:25" /><verse number="26" style="v" sid="JER 29:26" />A̱sulazuva a ɗangula wu ta̱ vo o'wo ganu o una̱ wa̱ Yehoyida, adama vu da̱na̱ za na a̱ da̱na̱ e idanasa u'wa wa̱ A̱sulazuva. Waru vu ta̱ nu ucira u na vee reme suru ajarata a vuma na e ɗesu aciya̱yi vumava̱sula̱, adama vu gbagara le a gba, reve fo vu zuwaa le ili i yinlu yi rumu a̱ yinlu i le. <verse eid="JER 29:26" /><verse number="27" style="v" sid="JER 29:27" />To, agba nye i zuwai vu ɓarai Irimiya vuma va Anato, za na ka̱mbuwa̱i aciya̱yi vumava̱sula̱ a̱tsuma̱ a̱ ɗu shi? <verse eid="JER 29:27" /><verse number="28" style="v" sid="JER 29:28" />Adama a na u lyungu ta̱ ni ikaka a̱ tyo ya̱'a̱ a̱ tsu a Babila adansa, &lt;Nden n tsugbashi nda n ta jima. Adama o ndolo she i suwa 'wa i da̱nu pe. Reve i shuwa̱ a̱ɗuma̱ waru i lyuwa umatsun u le.&gt; &gt;&gt;<verse eid="JER 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 29:29" />Ɗaɗa Zafaniya ganu ɗeyi mepepelime'e nu una̱ atsuvu a Irimiya vumava̱sula̱. <verse eid="JER 29:29" /><verse number="30" style="v" sid="JER 29:30" />Ɗaɗa A̱sulazuva a yuwain adanshi na̱ Irimiya u dammai, <verse eid="JER 29:30" /><verse number="31" style="v" sid="JER 29:31" />vu lyungu ni ikaka i nda a̱ tyo uba̱ta̱ wa aza a na a̱ ri nden n tsugbashi, &lt;&lt;Apa ili i na A̱sulazuva a dammai adama a Shemaya vuma va̱ Nehelam. Ana wo o'woi Shemaya yuwaan ɗu adanshi e ikaka, ko na wo o'woi n lyunguyi shi, reve u zuwa ɗu i zuwa okolo adanshi epen, <verse eid="JER 29:31" /><verse number="32" style="v" sid="JER 29:32" />adama o ndolo, apa ili i na A̱sulazuva a dammai, na amayun n ta ca Shemaya vuma va̱ Nehelam oforo na̱ limatan va̱ yi suru. Waru wa̱a̱ da̱na̱ lo na̱ za na buwai wuma a̱tsuma̱ a ama a nda shi, agba wee ene isa'ani i na maa yuwaan a ama a̱ va̱ shi, adama a na u yuwan ta̱ alajiya aciyogbamu a aci a̱ va̱.&gt;&gt; Ne ɗa A̱sulazuva a dammai.<verse eid="JER 29:32" /></para>
  <chapter eid="JER 29" />
  <chapter number="30" style="c" sid="JER 30" />
  <para style="s">Uka̱mbu wa aza a Isra'ila</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 30:1" />Adanshi A̱sulazuva a̱ ta̱wa̱ ta̱ ya̱ Irimiya, u damma, <verse eid="JER 30:1" /><verse number="2" style="v" sid="JER 30:2" />&lt;&lt;Apa ili i na A̱sulazuva a̱ A̱sula̱ a Isra'ila a dammai, &lt;Vu ɗana adanshi a na suru n damma nuwu a aatagada. <verse eid="JER 30:2" /><verse number="3" style="v" sid="JER 30:3" />Adama a na mantsa ma̱a̱ ta̱ lo a̱ ta̱wa̱ a na ma̱a̱ ka̱mbuwa̱ ama a̱ va̱ aza a Isra'ila na̱ Yahuda diga uba̱ta̱ u tsugbashi. Reve fo n ka̱mba̱to le e iɗa i na n cayi nkaya nle wa agadu.&gt; Ne ɗa A̱sulazuva a dammai.&gt;&gt;<verse eid="JER 30:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 30:4" />Apa adanshi a na A̱sulazuva a dammai, adama a Isra'ila na Yahuda.<verse eid="JER 30:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JER 30:5" />Apa ili i na A̱sulazuva a dammai,</para>
  <para style="q2" vid="JER 30:5">&lt;&lt;A uwwa ta̱ yisali i wuda'un na̱ za wovon,</para>
  <para style="q2" vid="JER 30:5">waru babu nden ma asuvu.<verse eid="JER 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 30:6" />Gogo yuwain yeci yu uwwa,</para>
  <para style="q2" vid="JER 30:6">vali ta gura matsan ɗa?</para>
  <para style="q1" vid="JER 30:6">To, nye i zuwai mee eneshe vali suru</para>
  <para style="q2" vid="JER 30:6">ee mereme me ikyun,</para>
  <para style="q2" vid="JER 30:6">she damma ka ve teri?</para>
  <para style="q1" vid="JER 30:6">Nye i zuwai urewesu wu za suru</para>
  <para style="q2" vid="JER 30:6">ri ulukutu adama o wovon?<verse eid="JER 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 30:7" />A̱tsuma̱lima̱ a ta cina ɗu!</para>
  <para style="q2" vid="JER 30:7">Adama a na urana u nda</para>
  <para style="q2" vid="JER 30:7">a̱ba̱jini o urana a ɗa,</para>
  <para style="q2" vid="JER 30:7">urana wu lo tsa̱ a̱ yi shi,</para>
  <para style="q1" vid="JER 30:7">mantsa ma ɗa ma̱ a̱tsuma̱lima̱</para>
  <para style="q2" vid="JER 30:7">mo ugundo wa Yakubu,</para>
  <para style="q1" vid="JER 30:7">amma na̱ ne suru a ta wawa yi,</para>
  <para style="q2" vid="JER 30:7">diga a̱tsuma̱ a̱tsuma̱lima̱ a̱ yi.&gt;&gt;<verse eid="JER 30:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JER 30:8" />A̱sulazuva o oɓolo a̱ a̱soja</para>
  <para style="q2" vid="JER 30:8">a zuva a damma ta̱,</para>
  <para style="q1" vid="JER 30:8">&lt;&lt;O urana u ndolo, n ta kuɗa</para>
  <para style="q2" vid="JER 30:8">a̱a̱gba̱la̱ diga a̱ yinlu i le,</para>
  <para style="q2" vid="JER 30:8">a̱vu mu taɓa ili i yinlu i le,</para>
  <para style="q1" vid="JER 30:8">waru omocin a buwa a̱ ka̱mba̱to le</para>
  <para style="q2" vid="JER 30:8">agbashi waru shi.<verse eid="JER 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 30:9" />Amma a ta yuwaan A̱sulazuva</para>
  <para style="q2" vid="JER 30:9">A̱sula̱ e le a̱ga̱nda̱,</para>
  <para style="q1" vid="JER 30:9">nu ugundo wa̱ Da̱wuda,</para>
  <para style="q2" vid="JER 30:9">mogono ma na ma̱a̱ 'ya̱sa̱n adama e le.&gt;&gt;<verse eid="JER 30:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 30:10" />&lt;&lt;Gogo, a̱vu Yakubu aagbashi a̱ va̱,</para>
  <para style="q2" vid="JER 30:10">she vu uwwa wovon wan,</para>
  <para style="q1" vid="JER 30:10">a̱vu Isra'ila</para>
  <para style="q2" vid="JER 30:10">she vu da'wan wan!</para>
  <para style="q1" vid="JER 30:10">Adama a na a̱ yi ɗa nda n ta wawa wu</para>
  <para style="q2" vid="JER 30:10">diga e iɗa ya alanga,</para>
  <para style="q1" vid="JER 30:10">n ta̱ fo a wawa muwun ma̱ wu</para>
  <para style="q2" vid="JER 30:10">diga e iɗa i tsugbashi.</para>
  <para style="q1" vid="JER 30:10">Waru ugundo wa̱ wu u ta̱ da̱shi</para>
  <para style="q2" vid="JER 30:10">tsurisa̱ nden ma asuvu,</para>
  <para style="q2" vid="JER 30:10">na̱ nden n lafiya,</para>
  <para style="q1" vid="JER 30:10">agba babu za na buwai</para>
  <para style="q2" vid="JER 30:10">na a dada'waton wu.</para>
  <para style="q2" vid="JER 30:10">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 30:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 30:11" />A̱sulazuva a damma ta̱,</para>
  <para style="q2" vid="JER 30:11">n to oɓolo na̱ a̱vu,</para>
  <para style="q2" vid="JER 30:11">waru n ta wawa wu.</para>
  <para style="q1" vid="JER 30:11">Ko na wo o'woi n ta̱ kototo nɗa suru suru,</para>
  <para style="q2" vid="JER 30:11">uba̱ta̱ u na m bete'we nɗu,</para>
  <para style="q2" vid="JER 30:11">moo kototo ɗu suru suru shi.</para>
  <para style="q1" vid="JER 30:11">N ta̱ ge'eto ɗu nu uge'etosu wa amayun,</para>
  <para style="q2" vid="JER 30:11">na amayun maa lyawa ɗu i ka̱ra̱ fa̱a̱n,</para>
  <para style="q2" vid="JER 30:11">babu na n ca ɗu oforo shi.&gt;&gt;<verse eid="JER 30:11" /></para>
  <para style="s">A̱sulazuva na aciya̱yi a ɗa a yuwan opocino</para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JER 30:12" />&lt;&lt;Apa ili i na A̱sulazuva a dammai,</para>
  <para style="q2" vid="JER 30:12">antsu a̱ wu aza a na e ina ɗa shi,</para>
  <para style="q2" vid="JER 30:12">waru wamatowun wa̱ wu za vu usa̱n ɗa lon.<verse eid="JER 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 30:13" />Babu za na aa yuwan ipati</para>
  <para style="q2" vid="JER 30:13">adama o usa̱n wa̱ wu,</para>
  <para style="q1" vid="JER 30:13">agba babu a̱guma̱ adama antsu a̱ wu,</para>
  <para style="q2" vid="JER 30:13">waru va̱a̱ tsura̱ opocino shi.<verse eid="JER 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 30:14" />Ncigata ma̱ wu suru e icina ta̱ na̱ a̱vu,</para>
  <para style="q2" vid="JER 30:14">agba ili i ɓa̱la̱ le na̱ a̱vu shi.</para>
  <para style="q1" vid="JER 30:14">N ga̱la̱ wu ta̱ ununa</para>
  <para style="q2" vid="JER 30:14">ma'yuwatan ma tsu yuwan,</para>
  <para style="q1" vid="JER 30:14">reve waru n ca wu oforo</para>
  <para style="q2" vid="JER 30:14">ununa za vi iwuya tsu yuwan,</para>
  <para style="q1" vid="JER 30:14">adama a na unusu wa̱ wu u ta̱ a̱bunda̱ lon,</para>
  <para style="q2" vid="JER 30:14">waru nusu va̱ wu yuwan ta̱ a̱bunda̱ lon.<verse eid="JER 30:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 30:15" />Adama nye vu ri a̱ mesun</para>
  <para style="q2" vid="JER 30:15">adama o usa̱n wa̱ wu,</para>
  <para style="q2" vid="JER 30:15">usa̱n wa̱ wu u na u ri na̱ a̱guma̱ shi?</para>
  <para style="q1" vid="JER 30:15">Adama a̱ba̱jini o unusu wa̱ wu u ɗa</para>
  <para style="q2" vid="JER 30:15">na̱ nusu va̱a̱ a̱bunda̱ va̱ wu ɗa</para>
  <para style="q2" vid="JER 30:15">n yuwaan nuwu ili i nda.&gt;&gt;<verse eid="JER 30:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="JER 30:16" />&lt;&lt;Amma aza a na o kototo nuwu suru,</para>
  <para style="q2" vid="JER 30:16">e le fo o to kototo le.</para>
  <para style="q1" vid="JER 30:16">Waru n'yuwatan ma̱ wu suru</para>
  <para style="q2" vid="JER 30:16">n ta̱ 'ya̱wa̱ tsugbashi.</para>
  <para style="q1" vid="JER 30:16">Aza a na a̱ pura̱ nuwu itana biti,</para>
  <para style="q2" vid="JER 30:16">e le fo a̱ ta̱ pura̱ le i ɗa.</para>
  <para style="q1" vid="JER 30:16">Aza a na a̱ lungusa̱ nuwu biti,</para>
  <para style="q2" vid="JER 30:16">a̱mu fo n ta̱ lungusa̱ le.<verse eid="JER 30:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 30:17" />Amma n ta̱ ka̱mbuwisa̱a̱ wu na̱ lafiya va̱ wu,</para>
  <para style="q2" vid="JER 30:17">reve n yuwaan antsu a̱ wu opocino,</para>
  <para style="q2" vid="JER 30:17">ne ɗa A̱sulazuva a dammai.</para>
  <para style="q1" vid="JER 30:17">&lt;Ko na wo o'woi a ta dansa wu</para>
  <para style="q2" vid="JER 30:17">vu ri nu urana shi,</para>
  <para style="q2" vid="JER 30:17">a̱vu Sihiyona na za damai na̱ yi shi.&gt; &gt;&gt;<verse eid="JER 30:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JER 30:18" />&lt;&lt;Apa ili i na A̱sulazuva a dammai,</para>
  <para style="q2" vid="JER 30:18">n ta̱ ka̱mbuwa̱a̱ ogodo a Yakubu na aba'un a̱ yi,</para>
  <para style="q1" vid="JER 30:18">reve fo mee ene iliyali</para>
  <para style="q2" vid="JER 30:18">yu uba̱ta̱ u na u ri nden.</para>
  <para style="q1" vid="JER 30:18">A̱ ta̱ da̱shi suwisa lyuci'i uba̱ta̱ u na u da̱na̱i,</para>
  <para style="q2" vid="JER 30:18">reve ukobu u mogono wo o'wo ushuwu</para>
  <para style="q2" vid="JER 30:18">uba̱ta̱ u na u da̱na̱i nu ufaru.<verse eid="JER 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 30:19" />Diga a̱tsuma̱ e le, a ta uwwa ishipa yu ugodyusho,</para>
  <para style="q2" vid="JER 30:19">oɓolo nu uɗyo u ma̱za̱nga̱.</para>
  <para style="q1" vid="JER 30:19">Waru n ta̱ da̱shi le a̱bunda̱,</para>
  <para style="q2" vid="JER 30:19">agba a̱ da̱na̱ uka̱la̱mu shi,</para>
  <para style="q1" vid="JER 30:19">n ta ca le tsugbain,</para>
  <para style="q2" vid="JER 30:19">agba o goro le shi.<verse eid="JER 30:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 30:20" />Muwun nle n ta yuwan a̱bunda̱ tsu ufaru,</para>
  <para style="q2" vid="JER 30:20">waru ama le o to o'wo ushuwu elime a̱ va̱.</para>
  <para style="q1" vid="JER 30:20">Reve fo n ca za na suru</para>
  <para style="q2" vid="JER 30:20">ɓongi n le oforo.<verse eid="JER 30:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 30:21" />Zagbain le to o'wo diga a̱tsuma̱ e le,</para>
  <para style="q2" vid="JER 30:21">za na a yuwan tsugono tsa̱ le waru,</para>
  <para style="q2" vid="JER 30:21">diga a̱tsuma̱ e le.</para>
  <para style="q1" vid="JER 30:21">N ta̱ ta̱wa̱to yi zuzu</para>
  <para style="q2" vid="JER 30:21">agba u ta rawa zuzu na̱ mu,</para>
  <para style="q1" vid="JER 30:21">adama a na za ne ɗa aa yuwan okolo o ugbamu</para>
  <para style="q2" vid="JER 30:21">hali u ta̱wa̱ zuzu na̱ mu?</para>
  <para style="q2" vid="JER 30:21">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 30:22" />I to o'wo ama a̱ va̱,</para>
  <para style="q2" vid="JER 30:22">reve a̱mu fo mo o'wo A̱sula̱ a̱ ɗu.&gt;&gt;<verse eid="JER 30:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="JER 30:23" />&lt;&lt;Ka̱lyuwa̱, a̱yi ɗa nda wunla̱ wu upan</para>
  <para style="q2" vid="JER 30:23">wu usuɗuwu wa̱ A̱sulazuva o ɓosoi o uta̱,</para>
  <para style="q1" vid="JER 30:23">tsu upepu wu lipa̱ wu ukototosu,</para>
  <para style="q2" vid="JER 30:23">a̱ cipusa̱ a aci a̱za̱ e iwuya.<verse eid="JER 30:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 30:24" />Upan wa̱ a̱ A̱sulazuva wa̱a̱ ka̱mba̱ a̱ca̱pa̱ shi,</para>
  <para style="q2" vid="JER 30:24">she nu u shiton ifoɓi</para>
  <para style="q2" vid="JER 30:24">yi ili i na i ri okolo a̱ yi.</para>
  <para style="q1" vid="JER 30:24">A rana na a̱ ta̱wa̱ ɗa,</para>
  <para style="q2" vid="JER 30:24">yee reve ili i nda ulobonu.&gt;&gt;<verse eid="JER 30:24" /></para>
  <chapter eid="JER 30" />
  <chapter number="31" style="c" sid="JER 31" />
  <para style="p">
    <verse number="1" style="v" sid="JER 31:1" />&lt;&lt;A mantsa mo ndolo n to o'wo A̱sula̱ a ama o u'wa wa Isra'ila suru, waru ele o to o'wo a ama a̱ va̱,&gt;&gt; ne ɗa A̱sulazuva a dammai.<verse eid="JER 31:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="JER 31:2" />Apa ili i na A̱sulazuva a dammai,</para>
  <para style="q2" vid="JER 31:2">&lt;&lt;Ama a na a la'ai diga e meleshe</para>
  <para style="q2" vid="JER 31:2">ma matsun me pe'eni,</para>
  <para style="q1" vid="JER 31:2">a̱ ta̱ a̱tsura̱ isa'ani a̱ a̱tsumona,</para>
  <para style="q2" vid="JER 31:2">a mantsa ma na aza a Isra'ila a zamiyi wivuwun.&gt;&gt;<verse eid="JER 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 31:3" />A̱sulazuva o roco tsu ta̱</para>
  <para style="q2" vid="JER 31:3">aciya̱yi ɗe nu ufaru adansa,</para>
  <para style="q2" vid="JER 31:3">&lt;&lt;N ta̱ e icigi ya̱ wu,</para>
  <para style="q2" vid="JER 31:3">ni icigi i na i tsu koto shi,</para>
  <para style="q1" vid="JER 31:3">n ta̱wa̱to wu ta̱ uba̱ta̱ u va̱,</para>
  <para style="q2" vid="JER 31:3">ni icigi i na i tsu vadala shi.<verse eid="JER 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 31:4" />N ta̱ da̱shi suwisa wu,</para>
  <para style="q2" vid="JER 31:4">waru vu ta uwwa usuwu,</para>
  <para style="q2" vid="JER 31:4">a̱vu Usheli Isra'ila.</para>
  <para style="q1" vid="JER 31:4">Waru vu ta̱ da̱shi tarisa aganga a̱ wu,</para>
  <para style="q2" vid="JER 31:4">reve vu uwa uje'en wa̱ a̱za̱ a̱ ma̱za̱nga̱.<verse eid="JER 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 31:5" />Vu ta̱ da̱shi shuwisa̱ a̱ɗuma̱ a̱ inabi,</para>
  <para style="q2" vid="JER 31:5">zuva va agaɗi a Samariya.</para>
  <para style="q1" vid="JER 31:5">Acimbi a ɗa a̱ shuwa̱ le,</para>
  <para style="q2" vid="JER 31:5">a̱vu a uwwa uyo'o wu umatsun u le.<verse eid="JER 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 31:6" />Adama a na urana u ta̱ lo a̱ ta̱wa̱,</para>
  <para style="q2" vid="JER 31:6">na a̱za̱ e ipiri diga a aagaɗi a Ifiramu</para>
  <para style="q2" vid="JER 31:6">o uta̱a̱ uɗyo a sala a damma,</para>
  <para style="q1" vid="JER 31:6">&lt;Ta̱wa̱yi, tsu ka̱ra̱i a gawan a̱ tyo Sihiyona,</para>
  <para style="q2" vid="JER 31:6">a̱ tyo uba̱ta̱ wa̱ A̱sulazuva A̱sula̱ a̱ tsu.&gt; &gt;&gt;<verse eid="JER 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 31:7" />Adama a na apa ili i na A̱sulazuva a dammai,</para>
  <para style="q2" vid="JER 31:7">&lt;&lt;I cana ishipa i ma̱za̱nga̱</para>
  <para style="q2" vid="JER 31:7">adama o ugundo wa Yakubu!</para>
  <para style="q1" vid="JER 31:7">I 'ya̱sa̱n uɗyo</para>
  <para style="q2" vid="JER 31:7">adama a za na la'ai tsugbain a̱tsuma̱ a nɗa!</para>
  <para style="q1" vid="JER 31:7">Lyawa a uwwa ica i ɗu,</para>
  <para style="q2" vid="JER 31:7">reve i damma,</para>
  <para style="q2" vid="JER 31:7">&lt;A̱sulazuva vu wawa ama a̱ wu,</para>
  <para style="q2" vid="JER 31:7">vu wawa akapi ama a̱ wu Isra'ila!&gt;<verse eid="JER 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 31:8" />Ka̱lyuwa̱, n ta̱ ta̱wa̱ ne le</para>
  <para style="q2" vid="JER 31:8">diga e iɗa yu upasu wu ugana,</para>
  <para style="q2" vid="JER 31:8">reve m ɓoloto le diga o ukosu wu uvaɗi.</para>
  <para style="q1" vid="JER 31:8">A̱tsuma̱ e le a̱ ta̱ da̱na̱ na̱ nrumba̱ na̱ a̱kutsuma̱,</para>
  <para style="q2" vid="JER 31:8">na̱ a̱ma̱ci a̱ a̱tsuma̱, na̱ a̱ma̱ci a na a̱ ri e teri,</para>
  <para style="q2" vid="JER 31:8">na amayun ama a̱bunda̱ a ɗa a̱ ka̱mba̱.<verse eid="JER 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 31:9" />A̱tsuma̱ a̱ mesun a ɗa</para>
  <para style="q2" vid="JER 31:9">a̱ ta̱wa̱ a yuwusan avasa</para>
  <para style="q2" vid="JER 31:9">a mantsa ma na ma̱a̱ ka̱mbusa̱ le.</para>
  <para style="q1" vid="JER 31:9">N to toni ne le na̱ mɓa̱nga̱ mu uyene u mini</para>
  <para style="q2" vid="JER 31:9">reve n toni ne le o ure u na u ri mejege,</para>
  <para style="q2" vid="JER 31:9">u na a̱ ta̱ɗa̱tsa̱ shi.</para>
  <para style="q1" vid="JER 31:9">Adama a na a̱mu dada va Isra'ila ɗa,</para>
  <para style="q2" vid="JER 31:9">waru Ifiramu mawun mo ufaru ma̱ va̱ ma ɗa.<verse eid="JER 31:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 31:10" />&lt;&lt;Uwwai adanshi a̱ A̱sulazuva a̱ɗu nɗa,</para>
  <para style="q2" vid="JER 31:10">i cuɗuwa adanshi a̱ yi a pasu</para>
  <para style="q2" vid="JER 31:10">vu nge'en m mala, i damma,</para>
  <para style="q1" vid="JER 31:10">&lt;A̱yi na u bete'wei Isra'ila,</para>
  <para style="q2" vid="JER 31:10">a̱yi ɗa waru woo ɓoloto le,</para>
  <para style="q1" vid="JER 31:10">waru u ta̱ e indana iɓolo ya̱ yi,</para>
  <para style="q2" vid="JER 31:10">ununa za va aguɓa tsi indana ikyon ya̱ yi.&gt;<verse eid="JER 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 31:11" />Adama a na a̱ A̱sulazuva a wawa ta̱ Yakubu,</para>
  <para style="q2" vid="JER 31:11">reve u tsupaa le ekere aza a na a la'a nle ucira.<verse eid="JER 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 31:12" />A̱ ta̱ ta̱wa̱ a cana ishipa nu ucira,</para>
  <para style="q2" vid="JER 31:12">zuva va aagaɗi a̱ Sihiyona,</para>
  <para style="q1" vid="JER 31:12">urewesu u le u ta yuwan ma̱za̱nga̱</para>
  <para style="q2" vid="JER 31:12">adama e isa'ani ya̱ A̱sulazuva</para>
  <para style="q2" vid="JER 31:12">na̱ ma̱za̱nga̱ ma na a̱ tsura̱i ishina,</para>
  <para style="q2" vid="JER 31:12">na̱ masayan ma̱ ina̱bi oɓolo na̱ mani'in ma̱ zetun,</para>
  <para style="q1" vid="JER 31:12">na̱ ma̱za̱nga̱ ma na a̱ tsura̱i</para>
  <para style="q2" vid="JER 31:12">muwun mi ikyon ni inan.</para>
  <para style="q1" vid="JER 31:12">O to o'wo tsa̱a̱ a̱a̱rumbu a na a casu mini,</para>
  <para style="q2" vid="JER 31:12">agba a̱a̱ da̱shi yuwisan a̱tsumola̱ngu shi.<verse eid="JER 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 31:13" />A mantsa mo ndolo muwun ma̱ esheli n ta yuwan uje'en</para>
  <para style="q2" vid="JER 31:13">waru a yuwan ma̱za̱nga̱,</para>
  <para style="q2" vid="JER 31:13">ne ɗa fo muwun mo olobo na̱ mbara.</para>
  <para style="q1" vid="JER 31:13">N ta vadala mesun</para>
  <para style="q2" vid="JER 31:13">ma̱ a̱tsumola̱ngu e le a̱ tyo a̱ ma̱za̱nga̱,</para>
  <para style="q2" vid="JER 31:13">reve n ca le adanshi,</para>
  <para style="q1" vid="JER 31:13">a̱vu fo n ca le ma̱za̱nga̱</para>
  <para style="q2" vid="JER 31:13">o una̱ wa̱ a̱tsumola̱ngu.<verse eid="JER 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 31:14" />N ta̱ cuwa̱ton nan ganu</para>
  <para style="q2" vid="JER 31:14">ni ilyalya ya̱a̱ a̱bunda̱,</para>
  <para style="q1" vid="JER 31:14">waru ama a̱ va̱ a̱ ta̱ cuwa̱n</para>
  <para style="q2" vid="JER 31:14">ni isa'ani ya̱a̱ a̱bunda̱ a̱ va̱.&gt;&gt;</para>
  <para style="q2" vid="JER 31:14">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 31:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JER 31:15" />Apa ili i na A̱sulazuva a dammai,</para>
  <para style="q2" vid="JER 31:15">&lt;&lt;A uwwa ta̱ uɗyo a Rama,</para>
  <para style="q2" vid="JER 31:15">uɗyo wo a̱tsumola̱ngu na̱ za mesun nu ucira,</para>
  <para style="q1" vid="JER 31:15">Rahila ɗa ri e mesun adama a̱ muwun ma̱ yi,</para>
  <para style="q2" vid="JER 31:15">waru u 'yuwan ta̱ a̱ usu wa̱a̱ a̱sa̱la̱</para>
  <para style="q1" vid="JER 31:15">adama a na muwun ma̱ yi,</para>
  <para style="q2" vid="JER 31:15">m buwa lo shi.<note caller="-" style="x"><char style="xo" closed="false">31:15 </char><char style="xt" closed="false"><ref loc="MAT 2:18">Mat 2:18</ref>.</char></note>&gt;&gt;<verse eid="JER 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 31:16" />Apa ili i na A̱sulazuva a dammai,</para>
  <para style="q2" vid="JER 31:16">&lt;&lt;Vu rungwa̱ mesun,</para>
  <para style="q2" vid="JER 31:16">vu ta'asa aɓara diga e esu a̱ wu.</para>
  <para style="q1" vid="JER 31:16">Adama a na vu ta̱ tsura̱</para>
  <para style="q2" vid="JER 31:16">iliyinkapa yu ulinga wa̱ wu,</para>
  <para style="q1" vid="JER 31:16">waru a̱ ta̱ ka̱mba̱ diga e iɗa yi n'yuwatan.</para>
  <para style="q2" vid="JER 31:16">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 31:17" />Adama o ndolo uzuwu wo okolo a̱ ta̱ lo</para>
  <para style="q2" vid="JER 31:17">nda a̱ tyo we elime,&gt;&gt;</para>
  <para style="q1" vid="JER 31:17">waru muwun ma̱ wu n ta̱ ka̱mba̱ e iɗa i le,</para>
  <para style="q2" vid="JER 31:17">ne ɗa A̱sulazuva a dammai.<verse eid="JER 31:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JER 31:18" />&lt;&lt;Na amayun, mu uwwa ta̱</para>
  <para style="q2" vid="JER 31:18">a̱tsumola̱ngu a Ifiramu, a na wa dansa,</para>
  <para style="q1" vid="JER 31:18">&lt;Vu ca mu ta̱ oforo tsa̱ ma̱dindim ma na</para>
  <para style="q2" vid="JER 31:18">ma tsu uwwa adanshi shi,</para>
  <para style="q2" vid="JER 31:18">waru mu uwwa ta̱ oforo'o.</para>
  <para style="q1" vid="JER 31:18">Vu ka̱mba̱to mu,</para>
  <para style="q2" vid="JER 31:18">waru n ta̱ gba ka̱mba̱,</para>
  <para style="q1" vid="JER 31:18">adama a na a̱vu ɗa</para>
  <para style="q2" vid="JER 31:18">A̱sulazuva A̱sula̱ a̱ va̱.<verse eid="JER 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 31:19" />A mantsa ma na n shi n lyawai ure,</para>
  <para style="q2" vid="JER 31:19">reve n vadala a̱ ka̱mba̱.</para>
  <para style="q1" vid="JER 31:19">Mantsa ma na n ta̱wa̱i n revei</para>
  <para style="q2" vid="JER 31:19">reve n ka̱ɗa̱to aci,</para>
  <para style="q1" vid="JER 31:19">mu uwwa ta̱ wono na̱ a̱tsuma̱lima̱</para>
  <para style="q2" vid="JER 31:19">adama a na n tu utanuwu</para>
  <para style="q2" vid="JER 31:19">na̱ wono u tsulolobo tsa̱ a̱ va̱.&gt; &gt;&gt;<verse eid="JER 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 31:20" />&lt;&lt;Ashe, Ifiramu macigata</para>
  <para style="q2" vid="JER 31:20">ma mawun ma̱ va̱ ma ɗa shi?</para>
  <para style="q1" vid="JER 31:20">Ko na wo o'woi n tsu yuwusan ta̱</para>
  <para style="q2" vid="JER 31:20">adanshi e iwuya ya̱ yi kuci,</para>
  <para style="q1" vid="JER 31:20">na̱ ne suru a̱tsuma̱ e icigi</para>
  <para style="q2" vid="JER 31:20">n tsu cuwan ta̱ na̱ a̱ yi.</para>
  <para style="q1" vid="JER 31:20">Adama a na okolo a̱ va̱</para>
  <para style="q2" vid="JER 31:20">a ta maluwa ma̱ yi,</para>
  <para style="q1" vid="JER 31:20">waru na amayun n ta̱ ene iliyali ya̱ yi lon,&gt;&gt;</para>
  <para style="q2" vid="JER 31:20">ne ɗa A̱sulazuva a dammai.<verse eid="JER 31:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JER 31:21" />&lt;&lt;Vu shuwa̱a̱ aciya̱wu iroci o ure,</para>
  <para style="q2" vid="JER 31:21">vu shuwa̱a̱ aciya̱wu</para>
  <para style="q2" vid="JER 31:21">iroci i na yoo o roco wu ure.</para>
  <para style="q1" vid="JER 31:21">Vi idana ure u gbain ulobonu,</para>
  <para style="q2" vid="JER 31:21">ure u na vu toniyi.</para>
  <para style="q1" vid="JER 31:21">Vu ka̱mba̱, a̱vu Usheli Isra'ila,</para>
  <para style="q2" vid="JER 31:21">vu ka̱mba̱ a̱ tyo e ilyuci ya̱ wu.<verse eid="JER 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 31:22" />Hali acina mantsa ma̱ ne ɗa</para>
  <para style="q2" vid="JER 31:22">va̱a̱ da̱na̱ a agara e iwau,</para>
  <para style="q2" vid="JER 31:22">a̱vu Usheli wu ulambu wa̱ a̱ɓula̱?</para>
  <para style="q1" vid="JER 31:22">A̱sulazuva a̱ ta̱ e ifoɓi i na wa yuwan</para>
  <para style="q2" vid="JER 31:22">ili i sa'avu a̱tsuma̱ o uvaɗi</para>
  <para style="q1" vid="JER 31:22">na a damma ka ɗa aa yuwaan vali mapari.&gt;&gt;<verse eid="JER 31:22" /></para>
  <para style="s">Akucunu asa'avu na̱ nzuwulai n ro</para>
  <para style="p">
    <verse number="23" style="v" sid="JER 31:23" />Apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva a̱ A̱sula̱ a Isra'ila a dammai, &lt;&lt;A mantsa ma na n ka̱mba̱to n le diga uba̱ta̱ u tsugbashi tsa ama e iɗa ya Yahuda oɓolo ni ilyuci ya̱ yi, a̱ ta̱ da̱shi yuwisan ulinga ni idanshi i nda.</para>
  <para style="b" vid="JER 31:23" />
  <para style="q1" vid="JER 31:23">&lt;&lt;&lt;Lyawa A̱sulazuva a zuwa wu aba'un,</para>
  <para style="q2" vid="JER 31:23">a̱vu nda̱na̱ta̱ ma̱ a̱ɓula̱, a̱vu aagaɗi a Akiza!&gt;<verse eid="JER 31:23" /></para>
  <para style="b" />
  <para style="m">
    <verse number="24" style="v" sid="JER 31:24" />Ama a̱ ta̱ da̱nu oɓolo a̱tsuma̱ a Yahuda oɓolo ni ilyuci ya̱ yi suru, acimbi na aza a na a yuwusan agara aguɓa oɓolo e ikyon i le. <verse eid="JER 31:24" /><verse number="25" style="v" sid="JER 31:25" />Adama a na n ta kamba aza a na a̱ kuna̱i, reve fo n cuwa̱ton aza a na a̱ ta̱ka̱lyuwa̱i.&gt;&gt;<verse eid="JER 31:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JER 31:26" />&lt;&lt;Adama o ndolo, a̱vu a̱mu Irimiya n 'yon diga a nlavu n damma, Na amayun nlavu nda n yo'ono mu ta̱!&gt;&gt;<verse eid="JER 31:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 31:27" />Reve A̱sulazuva a damma, ka̱lyuwa̱, &lt;&lt;Rana ta̱ lo a̱ ta̱wa̱ na ma̱a̱ da̱shi u'wa wa Isra'ila na̱ Yahuda oɓolo na a ama ni iliyamunga a̱bunda̱. <verse eid="JER 31:27" /><verse number="28" style="v" sid="JER 31:28" />Ununa mi indana n le, adama n mula̱ le, waru o ɓoso le, a̱vu fo a̱ lyungusa̱, o kototo waru a̱ ta̱wa̱a̱ na addama, ne ɗa mee e indana le adama a̱ tsura̱ usuwu waru a̱ tsura̱ ushuwu.&gt;&gt; Ne ɗa A̱sulazuva a dammai. <verse eid="JER 31:28" /><verse number="29" style="v" sid="JER 31:29" />A rana ndolo ama a̱a̱ da̱shi damma,</para>
  <para style="b" vid="JER 31:29" />
  <para style="q1" vid="JER 31:29">&lt;&lt; &lt;Nan dada a ɗa a tamai muwun n ina̱bi ma alamu,</para>
  <para style="q2" vid="JER 31:29">agba anga a̱ muwun nle ɗa n kuwa̱i shi.&gt; &gt;&gt;<verse eid="JER 31:29" /></para>
  <para style="b" />
  <para style="p">
    <verse number="30" style="v" sid="JER 31:30" />&lt;&lt;Amma za suru ta̱ kuwa̱ adama o unusu wa̱ yi, za na suru tamai muwun n ina̱bi ma alamu, anga a̱ yi ɗa a̱ kuwa̱ goon.&gt;&gt;<verse eid="JER 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JER 31:31" />&lt;&lt;Reve A̱sulazuva a damma, ka̱lyuwa̱, rana ta̱ lo a̱ ta̱wa̱ a na maa yuwan nzuwulai n sa'avu nu u'wa wa Isra'ila na̱ Yahuda.<note caller="-" style="x"><char style="xo" closed="false">31:31 </char><char style="xt" closed="false"><ref loc="MAT 26:28">Mat 26:28</ref>; <ref loc="MRK 14:24">Mak 14:24</ref>; <ref loc="LUK 22:20">Luk 22:20</ref>; <ref loc="1CO 11:25">1 Kor 11:25</ref>; <ref loc="2CO 3:6">2 Kor 3:6</ref>.</char></note><note caller="-" style="x"><char style="xo" closed="false">31:31 </char><char style="xt" closed="false"><ref loc="HEB 8:8-12">M.Ib 8:8-12</ref>.</char></note> <verse eid="JER 31:31" /><verse number="32" style="v" sid="JER 31:32" />Wa̱a̱ da̱na̱ tsa nzuwulai n na n yuwain na̱ nkaya nle a mantsa ma na m ɓana nle ukere na n ronoo nle aɗanga o uta̱ diga e iɗa ya Masar shi. Adama a na a kuɗa ta̱ nzuwulai n va̱, ko na wo o'woi n ta̱ tsa vali uba̱ta̱ u le. Ne ɗa A̱sulazuva a dammai. <verse eid="JER 31:32" /><verse number="33" style="v" sid="JER 31:33" />Gogo apa nzuwulai n na maa yuwan nu u'wa wa Isra'ila na̱ a̱yi nda koto.&gt;&gt;</para>
  <para style="b" vid="JER 31:33" />
  <para style="q1" vid="JER 31:33">N ta zuwa wila̱ u va̱ a majiyan ma̱ ele,</para>
  <para style="q2" vid="JER 31:33">reve waru n ɗana le a akpata o okolo e le.</para>
  <para style="q1" vid="JER 31:33">N to o'wo A̱sula̱ e le,</para>
  <para style="q2" vid="JER 31:33">reve ele fo o'wo ama a̱ va̱.<note caller="-" style="x"><char style="xo" closed="false">31:33 </char><char style="xt" closed="false"><ref loc="HEB 10:16">M.Ib 10:16</ref>.</char></note></para>
  <para style="q2" vid="JER 31:33">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 31:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 31:34" />&lt;&lt;Vuma ro buwa o roco moron ma̱ nden ma̱ yi,</para>
  <para style="q2" vid="JER 31:34">ko u damma yi,</para>
  <para style="q1" vid="JER 31:34">&lt;Reve A̱sulazuva,&gt; shi</para>
  <para style="q2" vid="JER 31:34">adama a na suru nle a̱ ta̱ reve mu,</para>
  <para style="q2" vid="JER 31:34">diga a za ke'en a̱ tyo a zagbain a̱tsuma̱ e le.</para>
  <para style="q1" vid="JER 31:34">N ta yuwaan le gafura vi iwuya i le,</para>
  <para style="q2" vid="JER 31:34">waru ma̱a̱ da̱shi cuwan na̱ nusu le shi.<note caller="-" style="x"><char style="xo" closed="false">31:34 </char><char style="xt" closed="false"><ref loc="HEB 10:17">M.Ib 10:17</ref>.</char></note>&gt;&gt;<verse eid="JER 31:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="JER 31:35" />&lt;&lt;Apa ili i na A̱sulazuva a dammai,</para>
  <para style="q2" vid="JER 31:35">a̱yi na u shuwa̱i urana</para>
  <para style="q2" vid="JER 31:35">adama o o'wo ekan yu urana,</para>
  <para style="q1" vid="JER 31:35">a̱yi na u zuwai woto na̱ italyo'o</para>
  <para style="q2" vid="JER 31:35">adama oo o'wo ekan na ayin,</para>
  <para style="q1" vid="JER 31:35">a̱yi na u tsu zuru'wa̱ mala</para>
  <para style="q2" vid="JER 31:35">adama ikeɗu i mala i le i gugwa̱</para>
  <para style="q2" vid="JER 31:35">A̱sulazuva o oɓolo a̱ a̱soja a zuva a ɗa ala a̱ yi.&gt;&gt;<verse eid="JER 31:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 31:36" />&lt;&lt;N na̱ udammu u va̱ u nda na n yuwain</para>
  <para style="q2" vid="JER 31:36">puwa̱a̱n diga elime a̱ va̱,</para>
  <para style="q1" vid="JER 31:36">to, ɗaɗa ugundo wa Isra'ila waa buwa</para>
  <para style="q2" vid="JER 31:36">a̱ nden mi iɗa ekere a̱ va̱ shi,</para>
  <para style="q2" vid="JER 31:36">ne ɗa A̱sulazuva a dammai.&gt;&gt;<verse eid="JER 31:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="JER 31:37" />Apa ili i na A̱sulazuva a dammai,</para>
  <para style="q2" vid="JER 31:37">&lt;&lt;N na a ta gura rito zuva,</para>
  <para style="q1" vid="JER 31:37">reve waru a gura reve</para>
  <para style="q2" vid="JER 31:37">cine uvaɗi pe za̱la̱ wo o'woi,</para>
  <para style="q1" vid="JER 31:37">to, ɗaɗa gba ma 'yuwan</para>
  <para style="q2" vid="JER 31:37">ugundo wa Isra'ila suru,</para>
  <para style="q2" vid="JER 31:37">adama e ili i na a yuwain suru.&gt;&gt;</para>
  <para style="q2" vid="JER 31:37">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 31:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JER 31:38" />Reve A̱sulazuva a damma, &lt;&lt;Ka̱lyuwa̱, rana ta̱ lo a̱ ta̱wa̱, a na a̱da̱shi suwisa lyuci nda adama a̱ va̱, diga o Usaa wu ugaɗi wa Hanane hali a̱ tyo o Uwata wu Mɓa̱nga̱. <verse eid="JER 31:38" /><verse number="39" style="v" sid="JER 31:39" />Amunga o uritosu u ta̱ ba̱ruwa̱ diga ɗe, reve u saɓa a̱ tyo aagaɗi Gare, reve u vadala a̱ tyo Gowa. <verse eid="JER 31:39" /><verse number="40" style="v" sid="JER 31:40" />Ka̱ri na ocosu a̱kwa̱kwa̱ no okomo suru, ni iɗa'a suru hali a̱ tyo Uka̱ri wa̱ Kidron, hali fo a̱ tyo o Una̱ntsu wu nven wi Ido ya asana, o to o'wo na akiza adama a̱ A̱sulazuva. Waru a buwa a̱da̱shi mula̱ lyuci'i shi, ko gba shi o ɓuɓoso yi shi ko ke'en.&gt;&gt;<verse eid="JER 31:40" /></para>
  <chapter eid="JER 31" />
  <chapter number="32" style="c" sid="JER 32" />
  <para style="s">Irimiya tsula ta̱ atsusa</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 32:1" />Apa adanshi a na a̱ ta̱wa̱i uba̱ta̱ wa̱ Irimiya diga uba̱ta̱ wa̱ A̱sulazuva, a̱tsuma̱ a a'wan a kupa o tsugono tsa̱ Zedekiya mogono ma Yahuda, za na da̱na̱i a'wan kupa na̱ kula̱ tso tsugono tso mogono Nebukanaza va Babila.<note caller="-" style="x"><char style="xo" closed="false">32:1 </char><char style="xt" closed="false"><ref loc="2KI 25:1-7">2 Ngo 25:1-7</ref>.</char></note> <verse eid="JER 32:1" /><verse number="2" style="v" sid="JER 32:2" />A mantsa mo ndolo a̱soja o mogono ma Babila a̱ ka̱nda̱ruwa̱ ta̱ Urishelima nu uvon, vumava̱sula̱ Irimiya da̱na̱ ta̱ uɓa̱ruwu agalaci a̱ mɓa̱nga̱ ma aza a na a yuwusan ipiri a̱tsuma̱ o u'wa u mogono ma yahuda.<verse eid="JER 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 32:3" />Agba mogono Zedekiya va Yahuda ɗa shi ɓa̱ru niyi ɗe, adansa, &lt;&lt;Adama a̱ nye vaa a yuwusan adanshi e ikaka? Vu damma, &lt;Apa ili i na A̱sulazuva a dammai, n yuwan ta̱ zuzu na ma ca lyuci nda e ekere o mogono ma Babila, waru u ta lyuwa lyuci'i nu uvon. <verse eid="JER 32:3" /><verse number="4" style="v" sid="JER 32:4" />Agba Zedekiya mogono ma Yahuda maa la'a diga e ekere aza a Babila shi, amma na amayun a ta cayi e ekere o mogono ma Babila, waru u ta yuwan adanshi na̱ yi una̱ nu una̱, reve waru we enei esu na̱ esu. <verse eid="JER 32:4" /><verse number="5" style="v" sid="JER 32:5" />U ta tara Zedekiya a̱ tyo Babila, uba̱ta̱ u na wa̱a̱ da̱na̱ hali she na̱ n ca yi oforo, ne ɗa A̱sulazuva a dammai. Ko na̱ shi vu yuwan uvon na aza a Babila vaa lyuwa aci shi.&gt; &gt;&gt;<verse eid="JER 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 32:6" />Reve Irimiya usu u damma, &lt;&lt;Apa adanshi a na a̱ A̱sulazuva a damma numu, <verse eid="JER 32:6" /><verse number="7" style="v" sid="JER 32:7" />ka̱lyuwa̱, Haname ulobo wa Shalum edenge a dada va̱ wu, u ta̱ lo a̱ ta̱wa̱ ya̱'a̱ wu u damma, &lt;Tsula atsusa a̱ va̱ a na a̱ ri a̱tsuma̱ a Anatot, a na wo o'woi vu ri a̱ nden mee edenge a̱ va̱ a̱ zuzu, na amayun ili yi lo shi, a̱vu ɗa vu ntsayi vu tsula yi.&gt; &gt;&gt;<verse eid="JER 32:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 32:8" />&lt;&lt;Ɗaɗa gba ununa A̱sulazuva a dammai'i, edenge a̱ va̱ Haname ta̱wa̱i uba̱ta̱ u va̱, agalaci a̱ mɓa̱nga̱ ma̱ a̱za̱ e ipiri u dammai, &lt;Tsula atsusa a̱ va̱ a na a̱ ri a̱tsuma̱ a Anatot na ri o upasu wa Banyami. A na wo o'woi vu ta̱ nu ucira u na va tsula yi waru wo o'wo agadu a̱ wu, vu tsula yi adama aci ya̱ wu.&gt; &gt;&gt;</para>
  <para style="pi" vid="JER 32:8">&lt;&lt;Ɗaɗa n gura revei a na a̱ yi nda adanshi A̱sulazuva a ɗa.&gt;&gt;<verse eid="JER 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 32:9" />&lt;&lt;Adama o ndolo a ɗa gba n tsulai atsusa a na a̱ ri a̱tsuma̱ a Anatot diga o ukere wa Haname, mawun ma̱ a̱na̱wun ma dada va̱ o una̱ u makundatsu u azurufa ume kupa na̱ a̱za̱ a̱ cindere. <verse eid="JER 32:9" /><verse number="10" style="v" sid="JER 32:10" />Reve n zuwa ukere a aatagada, a̱vu n sura nzuwulai'i, a̱vu fo n zami esu n rito azurufa'a na̱ makundatsu. <verse eid="JER 32:10" /><verse number="11" style="v" sid="JER 32:11" />Reve n tara aatagada e iroci i na n tsulai uba̱ta̱'a̱ oɓolo nu udammu u na u ri pe adama atsulu'u o una̱ u wila̱ u na u ri pe a̱vu n sura za ta̱ reve n lyawa za ta̱ babu usuru, <verse eid="JER 32:11" /><verse number="12" style="v" sid="JER 32:12" />reve n ca Baruk ulobo wa̱ Neriya mawun ma tsukaya ma Ma'aseya. A̱vu n ca yi aatagada'a elime a Haname mawun ma̱ a̱na̱wun ma dada va̱, oɓolo ne elime esu a na a zuwai ukere a̱tsuma̱ aatagada'a oɓolo ne elime a ama a Yahuda suru, aza a na a̱ ri nden agalaci a̱ mɓa̱nga̱ ma̱ a̱za̱ e ipiri'i. <verse eid="JER 32:12" /><verse number="13" style="v" sid="JER 32:13" />Elime le ɗa n ronoi Baruk atsuvu a na dammai, <verse eid="JER 32:13" /><verse number="14" style="v" sid="JER 32:14" />apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva a̱ A̱sula̱ a Isra'ila a dammai, &lt;Tara atagada a nzuwulai'i na a surai na̱ za na a surai shi, vu zuwa le a̱tsuma̱ o upondo u ci'in adama she a̱ la̱nga̱ wan. <verse eid="JER 32:14" /><verse number="15" style="v" sid="JER 32:15" />Adama a na apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva a̱ A̱sula̱ a Isra'ila dammai, a̱ ta̱ da̱shi tsulisa 'wa na̱ ba̱ta̱ oɓolo na̱ a̱ɗuma̱ a̱ ina̱bi e iɗa i nda.&gt; &gt;&gt;<verse eid="JER 32:15" /></para>
  <para style="s">Irimiya yuwan ta̱ avasa adama a ca yi urevu</para>
  <para style="p">
    <verse number="16" style="v" sid="JER 32:16" />&lt;&lt;Ele lo, a mantsa ma na a̱mu Irimiya n cayi Baruk ulobo wa̱ Neriya atagada e iroci i na a tsulai uɗuma̱'a̱, reve n yuwan avasa uba̱ta̱ wa̱ A̱sulazuva n damma, <verse eid="JER 32:16" /><verse number="17" style="v" sid="JER 32:17" />&lt;O'o, A̱sulazuva, A̱sula̱! Ka̱lyuwa̱, a̱vu ɗa vu yuwain zuva ni iɗa o ure wu ukere wa̱ wu wu ucira na̱ linga va asalama a̱ wu! Babu ili i na i la'ai ucira wa̱ wu. <verse eid="JER 32:17" /><verse number="18" style="v" sid="JER 32:18" />Vu tsu roco ta̱ icigi ya̱ wu i na i tsu vadala shi uba̱ta̱ a ama kpaku kupa va̱ a̱bunda̱, amma vu tsu lyawa ta̱ oforo o unusu u nan dada reme muwun. A̱sula̱ zagbain na̱ za vu ucira, za na ala a̱ yi a ɗa A̱sulazuva oɓolo a̱ a̱soja a zuva, <verse eid="JER 32:18" /><verse number="19" style="v" sid="JER 32:19" />ifoɓi ya̱ wu suru i ta̱ mgbain, waru linga va̱ wu fo a̱ ta̱ mgbain. Esu a̱ wu a̱ ta̱ e inda ulinga wu uvaɗilima̱ suru, waru vu tsu tsupa ta̱ za suru a̱tsuma̱ a̱ re wuma wa̱ yi na̱ linga va̱ yi. <verse eid="JER 32:19" /><verse number="20" style="v" sid="JER 32:20" />A̱vu ɗa vu yuwain iroci na̱ linga va asalama a̱tsuma̱ e iɗa ya Masar. Hali na ana'an vu ta yuwusan le a̱tsuma̱ a Isra'ila oɓolo nu uba̱ta̱ wu vaɗilima̱. Waru vu yuwan ta̱ ala a na a cuwusan na̱ yi hali acina ana'an. <verse eid="JER 32:20" /><verse number="21" style="v" sid="JER 32:21" />Vu uta̱ ta̱ ama a̱ wu Isra'ila diga a̱tsuma̱ a Masar a̱tsuma̱ e iroci yi linga va asalama, oɓolo nu ukere wu ukadu nu ukere wu ucira lon, oɓolo nu u casu u wovon. <verse eid="JER 32:21" /><verse number="22" style="v" sid="JER 32:22" />Reve vu ca le iɗa i na vu kucinayi nkaya n le na va ca le. Iɗa i ɗa i na i ri e yee yeneshe maani ni ishiki lon. <verse eid="JER 32:22" /><verse number="23" style="v" sid="JER 32:23" />Reve nkaya nle n uwwa a usa iɗa'a. Amma a yuwan tsutoni nu uɗyo wa̱ wu shi, waru a yuwan mmalu a̱tsuma̱ o ure u wila̱ wa̱ wu shi. Agba a yuwan tsutoni ni ili i na vu damma n le shi. Adama o ndolo a ɗa vu ta̱wa̱yi na addama a nda suru a aci e le. <verse eid="JER 32:23" /><verse number="24" style="v" sid="JER 32:24" />Ka̱lyuwa̱, agba a̱ yi ɗa nda o ɓolotoi ɗe ma̱bula̱ adama a katsa o ɓoso ukari u lyuci'i adama o uvon. E ekere a matsun me pe'eni na ambulu na̱ mɓa̱la̱ a ca ta̱ lyuci va̱ Urishelima e ekere aza a Babila aza a na a̱ ri o uvon na̱ yi gogo. Ili i na vu dammai i fara ta̱, ununa vee eneshe gogo.&gt; &gt;&gt; <verse eid="JER 32:24" /><verse number="25" style="v" sid="JER 32:25" />Amma na̱ ne suru, A̱sulazuva zagbain, vu damma mu ta̱, &lt;&lt;Tsula uɗuma̱'a̱ ni ikebe, reve n zami aza a na e isawan mu esu,&gt;&gt; ko na wo o'woi a ta ca lyuci'i e ekere aza a Babila.<verse eid="JER 32:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JER 32:26" />Reve A̱sulazuva a yuwan adanshi na̱ Irimiya u damma, <verse eid="JER 32:26" /><verse number="27" style="v" sid="JER 32:27" />&lt;&lt;Ka̱lyuwa̱, a̱mu ɗa A̱sulazuva A̱sula̱ a vaɗilima̱. Ili i ta̱ lo na la'ai ucira u va̱? <verse eid="JER 32:27" /><verse number="28" style="v" sid="JER 32:28" />Adama o ndolo, apa ili i na A̱sulazuva a dammai, n yuwan ta̱ zuzu na ma ca lyuci nda e ekere aza a Babila, oɓolo na̱ Nebukanaza mogono ma Babila za na a lyuwai nu uvon. <verse eid="JER 32:28" /><verse number="29" style="v" sid="JER 32:29" />Aza a Babila a na a̱ ri a̱ nla̱ngi na̱ lyuci'i a̱ ta̱ ta̱wa̱ a daɓa yi akina reve a̱ kula̱to yi, oɓolo na̱ 'wa uba̱ta̱ u na ama a zuwa numu n yuwain upan, a̱tsuma̱ o ure wu ukula̱tosu wi ili i ma̱guru zuva vi igungu adama a Ba'al, reve fo o oco kucci vi ili yo oso uba̱ta̱ u musula̱ n ro. <verse eid="JER 32:29" /><verse number="30" style="v" sid="JER 32:30" />Na amayun, a ama a Isra'ila na̱ Yahuda a yuwan ulinga u ro elime a̱ va̱ shi, she iwuya goon. Babu ili i na a yuwain she de a na a zuwa numu n yuwain upan adama a linga ve ekere le. Ne ɗa A̱sulazuva a dammai. <verse eid="JER 32:30" /><verse number="31" style="v" sid="JER 32:31" />Adama a na diga a mantsa ma na a suwa niyi hali acina gogo, lyuci nda'a u 'ya̱sa̱n ta̱ upan wu usuɗuwu u va̱ lon. Ko shi a 'yuwan a ciga o kototo le diga elime a̱ va̱. <verse eid="JER 32:31" /><verse number="32" style="v" sid="JER 32:32" />Ama a Yahuda na̱ Isra'ila a zuwa mu ta̱ n yuwan upan na̱ ngono n le na azagbain e le na̱ nan ganu e le na ama̱sula̱ e le na ama a Yahuda na̱ nda̱na̱ta̱ ma̱ Urishelima suru adama e iwuya i na a yuwain. <verse eid="JER 32:32" /><verse number="33" style="v" sid="JER 32:33" />A vadalaa mu ta̱ ucina̱, agba a ca mu urewesu u le shi. Ko na wo o'woi n ritosu le ta̱ kuci, o poloo mu atsuvu shi, waru a̱ usu tsuɓari tsa̱ a̱ va̱ shi. <verse eid="JER 32:33" /><verse number="34" style="v" sid="JER 32:34" />A̱ shuwa̱ ta̱ musula̱ n le me idaba a̱tsuma̱ o u'wa u na e ɗesu na ala a̱ va̱, reve o o'woto yi ili yi idaba.<note caller="-" style="x"><char style="xo" closed="false">32:34 </char><char style="xt" closed="false"><ref loc="2KI 23:10">2 Ngo 23:10</ref>; <ref loc="JER 7:30-31">Irm 7:30-31</ref>; <ref loc="JER 19:1-6">19:1-6</ref>.</char></note> <verse eid="JER 32:34" /><verse number="35" style="v" sid="JER 32:35" />A suwa ta̱ ba̱ta̱ va̱ a̱ga̱nda̱ a̱ma̱li a Ba'al o Uka̱ri wa̱ Ben Hinom, adama a ca muwun nle olobo ne esheli kucci uba̱ta̱ u musula̱ ma̱ Mole. Agba a̱mu n damma le a yuwan ne shi, waru fo n yuwan majiyan me ili yi idaba i nda shi. Ne ɗa a zuwai Yahuda yuwain unusu.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">32:35 </char><char style="xt" closed="false"><ref loc="EXO 18:21">Mta̱ 18:21</ref>; <ref loc="2KI 23:10">2 Ngo 23:10</ref>; <ref loc="JER 7:31">Irm 7:31</ref>.</char></note><verse eid="JER 32:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JER 32:36" />Agba apa ili i na A̱sulazuva A̱sula̱ a Isra'ila a dammai adama a̱ lyuci nda, &lt;&lt;A̱tsuma̱ o ure u matsun me pe'eni na ambulu na̱ mɓa̱la̱ n ɗa a ca yi e ekere o mogono ma Babila, <verse eid="JER 32:36" /><verse number="37" style="v" sid="JER 32:37" />na amayun, n ta̱ e ifoɓi i na moo ɓoloto le, diga o ukosu wu ba̱ta̱ na m gba̱ra̱ nle a̱tsuma̱ o upan u va̱, nu upan wu usuɗuwu u va̱. N ta̱ gba ka̱mba̱to le uba̱ta̱ u nda, reve waru n zuwa le a̱ da̱nu gbaga. <verse eid="JER 32:37" /><verse number="38" style="v" sid="JER 32:38" />O to o'wo a ama a̱ va̱, reve a̱mu fo mo o'wo A̱sula̱ e le. <verse eid="JER 32:38" /><verse number="39" style="v" sid="JER 32:39" />N ta ca le okolo a̱ ta̱ na̱ majiyan ma̱ ta̱, adama mantsa suru a̱ da̱na̱ a uwwusa wovon u va̱, adama u yuwaan le urana, ele na̱ muwun nle na a matsan a̱ca̱pa̱ e le. <verse eid="JER 32:39" /><verse number="40" style="v" sid="JER 32:40" />N ta yuwan nzuwulai n na n ri nu ukosu shi ne e le adansa, ma̱a̱ kuɗa̱ o roco le isa'ani shi. Waru n ta zuwa le a uwwa wovon u va̱, adama she a vadala diga e itoni i va̱ wan. <verse eid="JER 32:40" /><verse number="41" style="v" sid="JER 32:41" />N ta yuwan ma̱za̱nga̱ a na moo rocosu le isa'ani, na amayun n ta zuwa le a̱ shuwa̱ a̱tsuma̱ e iɗa i nda, no okolo a̱ ta̱ na̱ wuma u va̱ suru.&gt;&gt;<verse eid="JER 32:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JER 32:42" />&lt;&lt;Apa ili i na A̱sulazuva a dammai, ununa n ta̱wa̱i na̱ cu'un va̱a̱ a̱ba̱jini addama a nda a aci a ama a nda, ne ɗa fo ma̱a̱ ta̱wa̱a̱ le ni isa'ani i na n yuwaan nle nzuwulai suru. <verse eid="JER 32:42" /><verse number="43" style="v" sid="JER 32:43" />A̱ ta̱ da̱shi tsulisa atsusa a̱tsuma̱ a nɗa nda na i dammai, &lt;Okongo a ɗa, u ri na̱ vuma ko nama shi, adama a na a ca yi ta̱ e ekere aza a Babila. <verse eid="JER 32:43" /><verse number="44" style="v" sid="JER 32:44" />A ta tsula atsusa'a na̱ azurufa, waru a ta zuwa ukere a aatagada a nzuwulai'i a̱vu a sura yi esu aza a na e isawai'in diga o upasu wi iɗa ya Banyami, na̱ mulyuci na ri uka̱nda̱ruwu na̱ Urishelima na̱ a̱tsuma̱ e ilyuci ya Yahuda, oɓolo ni ilyuci i na i ri e iɗa ya aagaɗi, ni ilyuci i na i ri za̱la̱ va agaɗi, ni ilyuci i na i ri Nege. Adama a na n ta̱ ka̱mbuwa̱a̱ le na aba'un e le. Ne ɗa A̱sulazuva a dammai.&gt; &gt;&gt;<verse eid="JER 32:44" /></para>
  <chapter eid="JER 32" />
  <chapter number="33" style="c" sid="JER 33" />
  <para style="s">Nzuwulai mu Uka̱mbisa̱</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 33:1" />Ele lo reve A̱sulazuva a yuwan adanshi na̱ irimiya wa̱ ire, mantsa ma na u da̱na̱i uɓa̱ru o u'wa wa ali a̱ mɓa̱nga̱ ma aza a na a yuwusan ipiri u damma, <verse eid="JER 33:1" /><verse number="2" style="v" sid="JER 33:2" />&lt;&lt;Apa ili i na A̱sulazuva a dammai, za na yuwain uvaɗi, reve n foɓo yi a̱vu n shuwa̱ yi, A̱sulazuva a ɗa ala a̱ yi. <verse eid="JER 33:2" /><verse number="3" style="v" sid="JER 33:3" />Ɗe numu reve a̱mu gba n usu ɗu, a̱vu fo n damma ɗu a̱ba̱jini e ili yu usa̱n i mereve, aza a na koto i revei shi.&gt;&gt;<verse eid="JER 33:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 33:4" />&lt;&lt;Adama a na apa ili i na A̱sulazuva A̱sula̱ a Isra'ila a dammai, adama a 'wa lyuci nda na̱ 'wa vu ngono ma Yahuda aza a na o ɓosoi adama o ɓolo ma̱bula̱ ma na a putsaa a kumba nu ukari na̱ matsun me pe'eni, <verse eid="JER 33:4" /><verse number="5" style="v" sid="JER 33:5" />a yuwan uvon na̱ a̱soja a Babila. A ta shiwan na̱ a̱kwa̱kwa̱ a ama a na n zuwai o una a̱tsuma̱ o upan u va̱, nu upan wu usuɗuwu u va̱. N ta̱ soko urewesu u va̱ adama a ama a̱ lyuci nda, adama e iwuya i le i na a yuwain suru.&gt;&gt;<verse eid="JER 33:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 33:6" />&lt;&lt;Na̱ ne suru na amayun, n ta̱ ta̱wa̱a̱ lyuci nda na̱ nden n lafiya no opocino. N ta̱ gba yuwaan ama a̱ va̱ opocino reve n lyawa le a uwwa uyo'o wa asuvu nden na̱ mapari, <verse eid="JER 33:6" /><verse number="7" style="v" sid="JER 33:7" />a mantsa ma na n ka̱mba̱toi Isra'ila na̱ Yahuda diga uba̱ta̱ u tsugbashi, waru n ta̱ da̱shi shuwa̱ le ununa a̱ da̱na̱i ɗe nu ufaru. <verse eid="JER 33:7" /><verse number="8" style="v" sid="JER 33:8" />N ta̱ fo o'woto le cece diga o unusu u na a yuwaan numu suru, a̱vu n yuwaan le gafura vu nusu le suru na aciyogbamu a na a yuwaan numu. <verse eid="JER 33:8" /><verse number="9" style="v" sid="JER 33:9" />Ɗaɗa lyuci nda'a a zuwa e reve mu, ili i ma̱za̱nga̱ ni ili yi ica ni ili i tsugbain uba̱ta̱ wu nɗa mu uvaɗi suru. A mantsa ma na a uwwai isa'ani i na n yuwaan niyi suru, a ta uwwa reve a uwwa wovon, a̱vu a da'wan adama a̱bunda̱ e isa'ani na̱ nden n lafiya n na n cayi lyuci'i.&gt;&gt;<verse eid="JER 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 33:10" />Apa ili i na A̱sulazuva a dammai, &lt;&lt;Ko na yaa dansa adama o uba̱ta̱ u nda ana, &lt;Okongo a ɗa, babu pe vuma ko inama a̱tsuma̱ a̱ yi.&gt; &gt;&gt; Na̱ ne suru a̱tsuma̱ e ilyuci ya Yahuda na̱ re va̱ Urishelima na lyawai wo o'woi okongo, amma a̱ ta̱ da̱shi uwwa, <verse eid="JER 33:10" /><verse number="11" style="v" sid="JER 33:11" />uɗyo u ma̱za̱nga̱ na̱ mere, nu uɗyo u vali vu ka sa'avu na̱ za vu ka sa'avu, nu ɗyo va aza a na a̱ ta̱wa̱yi na̱ kucci vu ugodyusho a̱tsuma̱ o u'wa wa̱ A̱sulazuva adansa,</para>
  <para style="b" vid="JER 33:11" />
  <para style="q1" vid="JER 33:11">&lt;&lt;&lt;I godyowo A̱sulazuva oɓolo a̱ a̱soja a zuva,</para>
  <para style="q2" vid="JER 33:11">adama a na A̱sulazuva za vi isa'ani ɗa,</para>
  <para style="q2" vid="JER 33:11">waru icigi ya̱ yi i na i tsu vadala shi i ta̱ lo hali hali!&gt; &gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">33:11 </char><char style="xt" closed="false"><ref loc="JER 7:34">Irm 7:34</ref>; <ref loc="JER 16:9">16:9</ref>; <ref loc="JER 25:10">25:10</ref>; <ref loc="1CH 16:34">1 Alb 16:34</ref>; <ref loc="2CH 5:13">2 Alb 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Ezr 3:11</ref>; <ref loc="PSA 100:5">Ica 100:5</ref>; <ref loc="PSA 106:1">106:1</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="PSA 136:1">136:1</ref>.</char></note><verse eid="JER 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 33:12" />Apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva dammai, &lt;&lt;Lo uba̱ta̱ u nda'a, uba̱ta̱ u na u ri okongo babu pe vuma ko nama'a, a̱tsuma̱ e ilyuci ya̱ yi a̱ ta̱ da̱shi tsurisa̱ ba̱ta̱ va alyuna, adama aza aguɓa a̱ da̱nu oɓolo ni iliyamunga i le.&gt;&gt; <verse eid="JER 33:12" /><verse number="13" style="v" sid="JER 33:13" />Reve A̱sulazuva a damma, &lt;&lt;Aza aguɓa a̱ ta̱ da̱shi e isawan a canana ukere u le e keceshe iliyamunga i le mantsa ma na a̱ ri a̱ ma̱ka̱ra̱, a̱tsuma̱ e ilyuci ya agaɗi, na aza a mugaɗi ma̱ a̱livu n keke'en wa̱ Nege, na ri a̱tsuma̱ o upasu wi iɗa ya Banyami, na̱ mulyuci na ri uka̱nda̱ruwu na̱ Urishelima, oɓolo na akapi e ilyuci ya Yahuda.&gt;&gt;<verse eid="JER 33:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 33:14" />&lt;&lt;Reve A̱sulazuva a damma, agba a̱yi ɗa nda mantsa ma̱ ta̱ lo a̱ ta̱wa̱ a na moo shiton nzuwulai n na n yuwain nu u'wa wa Isra'ila na Yahuda.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">33:14 </char><char style="xt" closed="false"><ref loc="JER 23:5-6">Irm 23:5-6</ref>.</char></note><verse eid="JER 33:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JER 33:15" />&lt;&lt;A rana ndolo, na a mantsa mo ndolo,</para>
  <para style="q2" vid="JER 33:15">n ta zuwa eten a̱ a̱ɓula̱ o uta̱</para>
  <para style="q2" vid="JER 33:15">diga o ugundo wa̱ Da̱wuda,</para>
  <para style="q2" vid="JER 33:15">waru u ta yuwan uge'etosu wa̱ a̱ɓula̱ e iɗa'a.<verse eid="JER 33:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 33:16" />A rana ndolo a ta wawa Yahuda,</para>
  <para style="q2" vid="JER 33:16">Urishelima waru ta yuwan nden n lafiya.</para>
  <para style="q1" vid="JER 33:16">Apa ala a na e ɗe ete'en,</para>
  <para style="q2" vid="JER 33:16">A̱sulazuva A̱ɓula̱ A̱tsu.&gt;&gt;<verse eid="JER 33:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 33:17" />&lt;&lt;Adama a na apa ili i na A̱sulazuva a dammai, ugundo wa̱ Da̱wuda wa̱a̱ kuɗa̱ aa lamba za na a̱ da̱nu ootogu o tsugono tsu u'wa wa Isra'ila shi. <verse eid="JER 33:17" /><verse number="18" style="v" sid="JER 33:18" />Ko nan ganu o ugundo wa̱ Levi a̱a̱ kuɗa̱ aa lamba za na e isawan elime a̱ va̱ shi, na waa ca kucci vu ukula̱tosu, na̱ kucci vi ishina na akapi a̱ kuci shi.&gt;&gt;<verse eid="JER 33:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 33:19" />Apa adanshi a na A̱sulazuva a yuwayin Irimiya adansa, <verse eid="JER 33:19" /><verse number="20" style="v" sid="JER 33:20" />&lt;&lt;Apa ili i na A̱sulazuva a dammai, nna̱ vu ta gura putsaa urana na ayin na o roco aciyele a mantsa ma na wuntsayi, <verse eid="JER 33:20" /><verse number="21" style="v" sid="JER 33:21" />to, a ta gura kuɗa nzuwulai n va̱ na aagbashi a̱ va̱ Da̱wuda, oɓolo na̱ n nzuwulai n va̱ nu ugundo wa̱ Levi nan ganu, aza a na aa yuwusan a̱ga̱nda̱ elime a̱ va̱, waru Da̱wuda buwa a̱a̱ da̱shi tsura̱ ugundo u na wa̱a̱ da̱nu ootogu o tsugono shi. <verse eid="JER 33:21" /><verse number="22" style="v" sid="JER 33:22" />N ta zuwa ugundo wa̱ Da̱wuda aagbashi a̱ va̱, na̱ a̱za̱ a̱ Levi ugundo u nan ganu a yuwan a̱bunda̱ tsa̱ italyo'o ya zuva na̱ tsa̱ wuyun wu nge'en m mala, hali na a gura kece le shi. &gt;&gt;<verse eid="JER 33:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 33:23" />Reve A̱sulazuva a̱ da̱shi yuwan adanshi na̱ Irimiya u damma, <verse eid="JER 33:23" /><verse number="24" style="v" sid="JER 33:24" />&lt;&lt;Ko vu uwwa ta̱ ili i na a ama a nda a dansa gba? A ta dansa, &lt;A̱sulazuva a 'yuwan ta̱ 'wa re na u ɗangulai ɗa?&gt; &gt;&gt; Adama o ndolo a ɗa o goroi a ama a̱ va̱, waru a̱ da̱shi a tara le tsa nɗa waru shi. <verse eid="JER 33:24" /><verse number="25" style="v" sid="JER 33:25" />Gogo gba, apa ili i na A̱sulazuva a dammai, &lt;&lt;Nna̱ a̱mu ɗa n yuwain urana na ayin shi, waru a̱vu n lapula wila̱ wa zuva na̱ za vu uvaɗi shi, <verse eid="JER 33:25" /><verse number="26" style="v" sid="JER 33:26" />to, n ta̱ gba a 'yuwan ugundo wa Yakubu na aagbashi a̱ va̱ Da̱wuda, waru ma̱a̱ da̱shi ɗangula za ro diga a̱tsuma̱ a̱ muwun mo olobo ma̱ yi, na waa yuwan tsugono e ekere o ugundo wa Ibrahim na̱ Ishiyaku na̱ Yakubu shi. Adama a na n ta̱ ka̱mbuwa̱a̱ le na aba'un e le, reve n roco le iliyali.&gt;&gt;<verse eid="JER 33:26" /></para>
  <chapter eid="JER 33" />
  <chapter number="34" style="c" sid="JER 34" />
  <para style="s">A ɓara ta̱ Zedekiya</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 34:1" />A mantsa ma na mogono Nebukanaza va Babila oɓolo na̱ a̱soja a̱ yi suru, nu uba̱ta̱ u tsugono tsa̱ a̱ yi suru, oɓolo na ama o tsugono a na a̱ ri za̱la̱ tsugono tsa̱ a̱ yi, na aa yuwusan uvon na̱ Urishelima oɓolo na̱ mulyuci nna n ri uka̱nda̱ruwu ne ele, reve adanshi a nda a̱ ta̱wa̱ uba̱ta̱ wa̱ Irimiya diga uba̱ta̱ wa̱ A̱sulazuva adansa,<note caller="-" style="x"><char style="xo" closed="false">34:1 </char><char style="xt" closed="false"><ref loc="2KI 25:1-11">2 Ngo 25:1-11</ref>; <ref loc="2CH 36:17-21">2 Alb 36:17-21</ref>.</char></note> <verse eid="JER 34:1" /><verse number="2" style="v" sid="JER 34:2" />&lt;&lt;Apa ili i na A̱sulazuva A̱sula̱ a Isra'ila a dammai, Irimiya, ka̱ra̱ vu yuwan adanshi na̱ mogono Zedekiya va Yahuda vu damma yi, &lt;Apa ili i na A̱sulazuva a dammai, n yuwan ta̱ zuzu na maa ca lyuci nda e ekere o mogono ma Babila, waru u ta̱ kula̱to yi. <verse eid="JER 34:2" /><verse number="3" style="v" sid="JER 34:3" />Agba a̱vu mogono Zedekiya vaa la'a diga e ekere a̱ yi shi, amma na amayun a̱ ta̱ e reme wu, reve waru a ca wu e ekere a̱ yi. Vu ta̱ ene mogono ma Babila esu ne esu, waru vu yuwan adanshi na̱ yi una̱ nu una̱. Ko vu 'yuwan vu ciga, vu ta̱ gba a̱ ka̱ra̱ a̱ tyo Babila.&gt; &gt;&gt;<verse eid="JER 34:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 34:4" />&lt;&lt;Amma na̱ ne suru, a̱vu mogono Zedekiya va Yahuda uwwa ne'e nzuwulai n na A̱sulazuva a yuwain. Apa ili i na A̱sulazuva a dammai a aci a̱ wu, va̱a̱ kuwa̱ e ekere a matsun me pe'eni shi! <verse eid="JER 34:4" /><verse number="5" style="v" sid="JER 34:5" />Vu ta̱ kuwa̱ na asuvu nden, cine ama a̱ tsu gba'ato akina a̱ a̱ciɗa̱ adama a ca nkaya ma̱ wu tsugbain, ngono nna n kuwa̱i elime a̱ wu, ne ɗa a gba'ato akina adama a ca wu tsugbain na adama a̱ a̱tsumola̱ngu a̱ wu adansa, &lt;Ayya, zagbain tsu kuwa̱ ta̱!&gt; &gt;&gt; Ne ɗa A̱sulazuva a dammai.<verse eid="JER 34:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 34:6" />Reve vumava̱sula̱ Irimiya damma Mogono Zedekiya va Yahuda suru adanshi a nda a̱tsuma̱ a̱ Urishelima. <verse eid="JER 34:6" /><verse number="7" style="v" sid="JER 34:7" />Mantsa ma na a̱soja o mogono ma Babila a̱ da̱na̱i a yuwusan uvon na̱ Urishelima oɓolo na akapi e ilyuci ya Yahuda i na i buwai suru, lyuci va Lakish na̱ Azeka. Adama a na ele nda ɗa goon ilyuci ya Yahuda i na i buwai na̱ kari.<verse eid="JER 34:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 34:8" />&lt;&lt;Adanshi'i u ta̱wa̱ ta̱ uba̱ta̱ wa̱ Irimiya cina mogono Zedekiya yuwan nzuwulai na ama Urishelima suru adama a ca ucuɗuwu wa aza a na a̱ ri a tsugbashi a̱ da̱na̱ fa̱a̱n. <verse eid="JER 34:8" /><verse number="9" style="v" sid="JER 34:9" />O una̱ wu nzuwulai'i za suru ta lyawa agbashi a̱ yi, ali na̱ a̱ma̱ci, aza a na a̱ ri Mmaci ma Ibrahim. She za guza̱ aagbashi a na ri vuma va Yahuda wan ko vali ko ka wan, suru nɗu edenge ɗa i ri.&gt;&gt; <verse eid="JER 34:9" /><verse number="10" style="v" sid="JER 34:10" />&lt;&lt;Adama o ndolo ɗaɗa azagbai'in suru na a ama'a suru a yuwain nzuwulai'i na za suru ta lyawa agbashi a̱ yi ali na̱ a̱ma̱ci, waru a buwa da̱shi guza̱ le shi. Reve a̱ usula̱i, reve a lyawa le a̱ ka̱ra̱.&gt;&gt; <verse eid="JER 34:10" /><verse number="11" style="v" sid="JER 34:11" />Agba a̱ 'ya̱wa̱ elime a̱vu a avadala majiyan me e le, reve a̱ ka̱mbuwisa̱ agbashi'i ali na̱ a̱ma̱ci, aza a na a̱ shi a lyawai, a̱vu a̱ da̱shi ka̱mba̱to le agbashi.<verse eid="JER 34:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 34:12" />Reve adanshi A̱sulazuva a̱ ta̱wa̱ uba̱ta̱ wa̱ Irimiya adansa, <verse eid="JER 34:12" /><verse number="13" style="v" sid="JER 34:13" />&lt;&lt;Apa ili i na A̱sulazuva a̱ A̱sula̱ a Isra'ila a dammai, n yuwan ta̱ akucunu na̱ nkaya n ɗu, a mantsa ma na mu uta̱a̱ nle e iɗa ya Masar, o uwa wa ali, na n dammai, <verse eid="JER 34:13" /><verse number="14" style="v" sid="JER 34:14" />&lt;A̱tsuma̱ aa'wan a̱ cindere biti, ko za 'yuwan u ciga u lyawa Mmaci ma Ibrahim nna u tsulai. Cina u yuwaan ɗu tsugbashi a'wan a̱ ta̱li, ko shi i 'yuwan i ciga i lyawa yi u ka̱ra̱ fa̱a̱n. Amma nkaya nɗu mu uwwa shi waru o poloo mu atsuvu shi.<note caller="-" style="x"><char style="xo" closed="false">34:14 </char><char style="xt" closed="false"><ref loc="EXO 21:2">Mta̱ 21:2</ref>; <ref loc="DEU 15:12">U.Wl 15:12</ref>.</char></note> <verse eid="JER 34:14" /><verse number="15" style="v" sid="JER 34:15" />Ko ta̱ shi i jima a na i vadalai shi, hali i yuwan ili i na i ri mejege elime a̱ va̱, a̱vu za suru a̱tsuma̱ ɗu ca ucuɗuwu u na wa lyawa za va̱ yi fa̱a̱n. Waru i yuwan ta̱ nzuwulai'i elime a̱ va̱, a̱tsuma̱ o u'wa u na e ɗesu na Aala a̱ va̱. <verse eid="JER 34:15" /><verse number="16" style="v" sid="JER 34:16" />Amma gogo a̱ yi ɗa nda i vadalai yoo o o'wotoi Aala a̱ va̱ ili yi idaba, na za suru a̱tsuma̱ ɗu ka̱mba̱toi agbashi a̱ yi ali na̱ a̱ma̱ci aza a na i lyawai fa̱a̱n a yuwan ili i na a cigai. Amma a̱vu i da̱shi zuwisa le ko na̱ shi a 'yuwan o o'wo agbashi a̱ ɗu.&gt; &gt;&gt;<verse eid="JER 34:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 34:17" />&lt;&lt;Adama o ndolo, apa ili i na A̱sulazuva a dammai, i yuwaan mu ta̱ ulambu u tsutoni, i yuwan adanshi a na mawun ma̱ a̱na̱wu ma̱ ɗu mo o'wo fa̱a̱n shi. Adama o ndolo gogo n yuwaan ɗu ta̱ adanshi a na yo o'wo fa̱a̱n, ne ɗa A̱sulazuva a dammai, ugana u na ya̱a̱ kuwa̱ o ure u matsun me pe'eni, mɓa̱la̱ na ambulu. Waru n ta zuwa ɗu yo o'wo ili yi idaba e ekere a̱za̱ o tsugono tsu uvaɗi. <verse eid="JER 34:17" /><verse number="18" style="v" sid="JER 34:18" />Ama a na a kuɗai nzuwulai n va̱, reve a 'yuwan o shiton nzuwulai nna a yuwain elime a̱ va̱, n ta̱ gba a yuwan ne le tsa̱ ma̱dindim ma na a tsu ɓatsalai ure<note caller="+" style="f"><char style="fr" closed="false">34:18 </char><char style="fq" closed="false">tsa̱ ma̱dindim ma na a tsu ɓatsalai ure </char><char style="ft" closed="false">Aza a Yahuda a tsu ɓatsalai ta̱ ma̱dindim ure a mantsa ma na a tarasa nzuwulai na̱ a̱za̱ ele.</char></note>, reve a̱ kuru na̱ memere ma̱ yi. <verse eid="JER 34:18" /><verse number="19" style="v" sid="JER 34:19" />Azagbain a Yahuda na̱ a̱za̱ a̱ Urishelima suru, na azagbain o ukobu na̱ nan ganu, oɓolo na ama e iɗa'a suru na toniyi nu upasu u na e ne'eshein ma̱dindim mo ndolo pasu re, <verse eid="JER 34:19" /><verse number="20" style="v" sid="JER 34:20" />n ta̱ gba ca le e ekere a n'yuwatan n le aza a na a zama wuma u le. Waru a̱kwa̱kwa̱ a̱ lipu le to o'wo ilyalya ya asala ni inama yu una.&gt;&gt;<verse eid="JER 34:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 34:21" />&lt;&lt;Amma n ta ca mogono Zedekiya va Yahuda na azagbain a̱ yi e ekere a n'yuwatan n le, aza a na a zama wuma u le e ekere a̱soja o mogono ma Babila, aza a na o ronoi na̱ a̱ca̱pa̱ a lyawa nɗu. <verse eid="JER 34:21" /><verse number="22" style="v" sid="JER 34:22" />Ka̱lyuwa̱, gogo n ta ca mogono ma Babila a̱ yi na̱ a̱soja udammu, waru n ta̱ ka̱mba̱to le a̱ lyuci nda. Agba a ta yuwan uvon na̱ lyuci'i, reve a usa yi, a̱vu a daɓa lyuci'i akina. Waru n ta zuwa ilyuci ya Yahuda yo o'wo okongo, adama she za da̱nu pe wan.&gt;&gt; Ne ɗa A̱sulazuva a dammai.<verse eid="JER 34:22" /></para>
  <chapter eid="JER 34" />
  <chapter number="35" style="c" sid="JER 35" />
  <para style="s">Ama a Rekab</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 35:1" />Apa adanshi a na A̱sulazuva a yuwayin Irimiya, u damma, a mantsa ma na mogono Jehoyakim ulobo wa̱ Josiya da̱na̱i o tsugono tsa̱ Yahuda, <verse eid="JER 35:1" /><verse number="2" style="v" sid="JER 35:2" />&lt;&lt;Ka̱ra̱ a̱ 'ya̱wa̱ o u'wa wa̱ a̱za̱ a̱ Rekab vu banu le a̱ ta̱wa̱ a uwa a̱tsuma̱ aasula a̱ ta̱ a̱tsuma̱ asula a na ri a̱ nge'en a̱tsuma̱ o uwa wa̱ A̱sulazuva, reve vu ca le masayan ma̱ ina̱bi ma na ma̱a̱ tsu tsura̱to o sowo.&gt;&gt; <verse eid="JER 35:2" /><verse number="3" style="v" sid="JER 35:3" />Ɗaɗa n ka̱ra̱i adama n ta̱wa̱a̱ na̱ Ja'azaniya ulobo wa̱ Irimiya ulobo wa Habaziniya, oɓolo na̱ a̱za̱ yi na̱ muwun mo olobo ma̱ yi, u'wa wa Rekab suru. <verse eid="JER 35:3" /><verse number="4" style="v" sid="JER 35:4" />Reve n ta̱wa̱to le a̱tsuma̱ o u'wa wa̱ A̱sulazuva. Reve tsu uwa aasula o olobo a Hanan ulobo wa̱ Igidaliya vuma na a uwwusa wovon wa̱ A̱sula̱. Asula'a u da̱na̱ ta̱ zuzu na aasula azagbain, na ri zuva na aasula a Ma'aseya ulobo wa̱ Shalum, za na a yuwusan ipiri yu una̱ntsu wu uwata wu u'wa wa̱ A̱sulazuva. <verse eid="JER 35:4" /><verse number="5" style="v" sid="JER 35:5" />Ɗaɗa n zuwai a̱ka̱bu a̱ va̱ tapu na̱ masayan ma̱ ina̱bi ma na ma̱a̱ tsu tsura̱to oɓolo na̱ mukkoto n ro elime a̱za̱ a̱ Rekab'm. Reve n damma le, &lt;&lt;Sowoi masaya'an.&gt;&gt;<verse eid="JER 35:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 35:6" />Reve a̱za̱ a̱ Rekab'm a̱ usu a damma, &lt;&lt;A̱tsu, tsu tsu sowo masayan ma̱ ina̱bi ma na ma̱a̱ tsu tsura̱to shi, adama a na akaya a̱ tsu Jonadab ulobo wa̱ Rekab damma tsu ta̱, &lt;Ko tsu, ko limatan tsu, she tsu sowo masayan ma̱ ina̱bi ma na ma̱a̱ tsu tsura̱to wan. <verse eid="JER 35:6" /><verse number="7" style="v" sid="JER 35:7" />Ne ɗa waru tsa suwa 'wa, ko tsu cu'wa̱n cu'un ko tsu cimba uɗuma̱ u ina̱bi shi, she tsu da̱na̱ ni ili i ro diga a̱tsuma̱ e ili i nda wan. Amma ko na̱ shi tsu 'yuwan tsu ciga tsu da̱nu a̱tsuma̱ o ogodo. Ne ɗa tsa yuwan wuma wa̱ a̱bunda̱ a̱tsuma̱ e iɗa i na tsu ri o tsumoci.&gt; <verse eid="JER 35:7" /><verse number="8" style="v" sid="JER 35:8" />Agba tsu yuwan ta̱ tsutoni nu udammu wa akaya a̱ tsu Yehonada ulobo wa Rekab a̱tsuma̱ e ili i na u damma n tsu biti. A̱tsu ko a̱ma̱ci a̱ tsu ko muwun mo olobo n tsu ne esheli, koto tsu rito sowo masayan ma̱ ina̱bi ma na ma̱a̱ tsu tsura̱to shi, <verse eid="JER 35:8" /><verse number="9" style="v" sid="JER 35:9" />ko tsu suwaa aciya̱tsu 'wa na tsa̱ da̱nu shi, ko tsu da̱na̱ nu uɗuma̱ u ina̱bi, ko atsusa ko icu'un yi ca̱'a̱n shi. <verse eid="JER 35:9" /><verse number="10" style="v" sid="JER 35:10" />Gogo tsunda tsu ta yuwusan wuma u tsu a̱tsuma̱ o ogodo. Waru tsu ta yuwusan tsutoni lon ni ili i na suru akaya a̱ tsu Jonadab dammai tsu yuwan. <verse eid="JER 35:10" /><verse number="11" style="v" sid="JER 35:11" />Amma a mantsa ma na mogono Nebukanaza va Babila ta̱wa̱i nu uvon a̱tsuma̱ e iɗa i nda, tsu damma ta̱, &lt;Ta̱wa̱i, ko shi tsu 'yuwan tsu ciga tsu 'ya̱wa̱i Urishelima, adama tsu la'ai diga e ekere a̱soja a Babila na̱ a̱soja a Suriya.&gt;Adama o ndolo a ɗa tsu ri pe a̱tsuma̱ a̱ Urishelima.&gt;&gt;<verse eid="JER 35:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 35:12" />Reve A̱sulazuva a̱ da̱shi yuwan danshi na̱ Irimiya u damma, <verse eid="JER 35:12" /><verse number="13" style="v" sid="JER 35:13" />&lt;&lt;Apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva a̱ A̱sula̱ a Isra'ila a dammai, ka̱ra̱ vu damma a ama a Yahuda na̱ nda̱na̱ta̱ ma̱ Urishelima ana, &lt;Gogo yoo rito ili i ro nda'a na yaa yuwan tsutoni na adanshi a̱ va̱ shi?&gt; Ne ɗa A̱sulazuva a dammai <verse eid="JER 35:13" /><verse number="14" style="v" sid="JER 35:14" />Ka̱lyuwa̱ ne'e, cine a yuwain tsutoni na adanshi a̱ Yehonada ulobo wa̱ Rekab, za na u dammai muwun ma̱ yi she o sowo masayan ma̱ ina̱bi ma na ma̱a̱ tsu tsura̱to wan. Agba e le ɗa nda o sowo masaya'an shi hali acina ana'an, adama a na a ta yuwusan tsutoni nu dammu wa akaya e le. Amma n yuwusan ta̱ adanshi na̱ ɗu kuci, na̱ ne suru i yuwan tsutoni na̱ a̱mu shi. <verse eid="JER 35:14" /><verse number="15" style="v" sid="JER 35:15" />N da̱na̱ ta̱ lyungusa̱a̱ ɗu agbashi a̱ va̱ ama̱sula̱ kuci adansa, &lt;Za suru vadala diga o ure wi iwuya ya̱ yi, reve u lapula linga va̱ yi, she u kuru musula̱ n ro ko u yuwaan le a̱ga̱nda̱ wan. Ɗaɗa ya̱a̱ da̱nu a̱tsuma̱ e iɗa i na n ca nɗu, a̱ɗu na̱ nkaya n ɗu.&gt; &gt;&gt; Amma i poloo mu atsuvu ko yu uwwa mu shi. <verse eid="JER 35:15" /><verse number="16" style="v" sid="JER 35:16" />&lt;&lt;Na amayun, olobo a̱ Yehonada ulobo wa̱ Rekab, a yuwan ta̱ ulinga nu udammu u na akaya le a lyawaa nle, amma a ama a nda a yuwaan mu tsutoni shi.&gt;&gt;<verse eid="JER 35:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 35:17" />&lt;&lt;Adama o ndolo, apa ili i na a̱ A̱sulazuva o oɓolo a̱ a̱soja a zuva a̱ A̱sula̱ a Isra'ila dammai, uwwai ne'e! N ta̱ ta̱wa̱a̱ ama a Yahuda na aza a na biti a̱ ri nden a̱tsuma̱ a̱ Urishelima suru, na̱ cu'un va addama biti na n dammai n ta̱ ta̱wa̱a̱ a aci le. N yuwaan le ta̱ adanshi, agba a uwwa mu shi, a̱vu n ɗe le, reve a̱ kuɗa̱ a̱ usu mu.&gt;&gt;<verse eid="JER 35:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 35:18" />Ɗaɗa Irimiya dammai u'wa wa Rekab ana, &lt;&lt;Apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva a̱ A̱sula̱ a Isra'ila dammai, ana wo o'woi i yuwain tsutoni na adanshi akaya a̱ ɗu Yehonada, reve i yuwan tsutoni ni i ili i na u damma nɗu suru, reve fo i yuwan ili biti ununa wuntsayi a yuwan, <verse eid="JER 35:18" /><verse number="19" style="v" sid="JER 35:19" />adama o ndolo, apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva a̱ A̱sula̱ a Isra'ila dammai, adama o ndolo, limatan va Yonadab ulobo wa̱ Rekab wa̱a̱ puwa̱a̱n shi.&gt;&gt;<verse eid="JER 35:19" /></para>
  <chapter eid="JER 35" />
  <chapter number="36" style="c" sid="JER 36" />
  <para style="s">Jehoyakim kula̱to ta̱ aatagada o ukutsuluwu wa̱ Irimiya</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 36:1" />A̱tsuma̱ a aa'wan a̱ na̱shi o tsugono tsa̱ Jehoyakim ulobo wa̱ Josiya mogono ma Yahuda, A̱sulazuva a yuwan ta̱ adanshi na̱ Irimiya vumava̱sula̱<note caller="-" style="x"><char style="xo" closed="false">36:1 </char><char style="xt" closed="false"><ref loc="2KI 24:1">2 Ngo 24:1</ref>; <ref loc="2CH 36:5-7">2 Alb 36:5-7</ref>; <ref loc="DAN 1:1-2">Dan 1:1-2</ref>.</char></note> u damma, <verse eid="JER 36:1" /><verse number="2" style="v" sid="JER 36:2" />&lt;&lt;Tara aatagada o ukutsuluwu vu ɗana idanshi i na n damma nuwu adama a Isra'ila na̱ Yahuda oɓolo na akapi a nɗa suru. Vu ɗana suru ili i na n damma nuwu suru diga o urana u na n yuwain adanshi na̱ a̱vu, diga a rana tsugono tsa̱ Josiya hali acina ana'an. <verse eid="JER 36:2" /><verse number="3" style="v" sid="JER 36:3" />U ta gura o'wo nna̱ u'wa wa̱ Yahuda uwwa addama a na n foɓoo nle suru na n foɓoi a aci e le, u ta gura o'wo za suru a̱tsuma̱ e le ta gura vadala diga a̱tsuma̱ o ure wi iwuya ya̱ yi, adama n yuwaan le gafura vi iwuya i le na̱ nusu le.&gt;&gt;<verse eid="JER 36:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 36:4" />Adama o ndolo ɗaɗa Irimiya ɗeyi Baruk ulobo wa̱ Neriya, ɗaɗa u dansaa niyi idanshi i na A̱sulazuva a damma niyi suru, reve Baruk ɗana le pe a̱tsuma̱ aatagada o ukutsuluwu. <verse eid="JER 36:4" /><verse number="5" style="v" sid="JER 36:5" />A̱vu Irimiya damma Baruk, &lt;&lt;A putsa mu ta̱ a̱ 'ya̱wa̱ a̱tsuma̱ a̱ A̱a̱'isamapaɗa a̱ A̱sulazuva. <verse eid="JER 36:5" /><verse number="6" style="v" sid="JER 36:6" />Adama o ndolo, a̱vu vu ka̱ra̱ a̱ 'ya̱wa̱ a̱ A̱a̱'isamapaɗa a̱ A̱sulazuva a̱tsuma̱ o urana wa akuli, reve vu yuwaan ama ɗesununa̱ diga a̱tsuma̱ e idanshi ya̱ A̱sulazuva a na n dansaa nuwu'u. Vu yuwan ɗesununa̱ atsuvu a ama a Yahuda aza a na a̱ ta̱wa̱i diga e ilyuci i le. <verse eid="JER 36:6" /><verse number="7" style="v" sid="JER 36:7" />U ta gura o'wo a yuwaan A̱sulazuva ipati yi izami yi iliyali, a̱vu za suru vadala diga a̱tsuma̱ a̱ re vi iwuya ya̱ yi, adama a na upan nu upan wu usuɗuwu u na a yuwain adanshi a aci a ama a nda ili i ma̱gigi i ɗa.&gt;&gt; <verse eid="JER 36:7" /><verse number="8" style="v" sid="JER 36:8" />A̱vu Baruk ulobo wa̱ Neriya ka̱ra̱ u yuwan suru ili i na vumava̱sula̱ Irimiya damma niyi u yuwan. A̱vu u ɗe idanshi ya̱ A̱sulazuva nu una̱ diga a̱tsuma̱ aatagada o ukutsuluwu a̱tsuma̱ a̱ A̱a̱'isamapaɗa a̱ A̱sulazuva.<verse eid="JER 36:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 36:9" />A̱tsuma̱ o woto wa̱ kucci wa aa'wan a tawun o tsugono tso mogono Jehoyakim ulobo wa̱ Josiya va Yahuda ɗa a lapai ulingi adama a yuwan akuli elime a̱ A̱sulazuva. Akuli'i u reme ta̱ fo na̱ nda̱na̱ta̱ ma̱ Urishelima suru, oɓolo na ama a na a̱ ta̱wa̱i diga e ilyuci ya Yahuda. <verse eid="JER 36:9" /><verse number="10" style="v" sid="JER 36:10" />Reve Baruk yuwan ɗesununa̱ atsuvu ama'a suru yi idanshi ya̱ A̱sulazuva diga o una̱ wa̱ Irimiya, aza a na u ɗanai a̱tsuma̱ a aatagada o ukutsuluwu'u. A̱vu u ɗe yi a̱tsuma̱ o u'wa wa̱ A̱sulazuva o ukobu wa̱ Gemariya ulobo wa̱ Shafa za vi iɗana. Ukobu'u u da̱na̱ ta̱ lo zuzu nu uba̱ta̱ wu Uwata Usa'avu wu Una̱ntsu wu u'wa wa̱ A̱sulazuva.<verse eid="JER 36:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 36:11" />Ana Mikaya ulobo wa̱ Gemariya ulobo wa̱ Shafa uwwai suru idanshi ya̱ A̱sulazuva a na a ɗanai a̱tsuma̱ a aatagada'a, <verse eid="JER 36:11" /><verse number="12" style="v" sid="JER 36:12" />ɗaɗa u ka̱ra̱i a̱ cipa̱ a̱ tyo aasula za vi iɗana mogono, uba̱ta̱ u na azagbain a̱ ri nden suru, Elishama za vi iɗana na̱ Delaya ulobo wa̱ Shemaya na̱ Elinatan ulobo wa Akbo na̱ Gemariya ulobo wa̱ Shafa na̱ Zedekiya ulobo wa Hananiya oɓolo na akapi a azagbai'in suru. <verse eid="JER 36:12" /><verse number="13" style="v" sid="JER 36:13" />Ana Mikaya ka̱mbuwa̱ n le idanshi i na wu uwwai Baruk yuwayin ama ɗesununa̱ suru diga a̱tsuma̱ aatagada o ukutsuluwu, <verse eid="JER 36:13" /><verse number="14" style="v" sid="JER 36:14" />a̱vu azagbai'in suru a̱ lyungu Yehudi ulobo wa̱ Netaniya, ulobo wa̱ Shelemiya ulobo wa̱ Kush, na waa damma Baruk ana, &lt;&lt;Vu tara aatagada a na vu yuwayin ama ɗesununa̱ reve vu ta̱wa̱.&gt;&gt; Ɗaɗa Baruk ulobo wa̱ Neriya ka̱ra̱i a̱ 'ya̱wa̱ uba̱ta̱ u le na aatagada o ukutsuluwu'u o ukere wa̱ yi. <verse eid="JER 36:14" /><verse number="15" style="v" sid="JER 36:15" />Reve a damma yi, &lt;&lt;Da̱nu vu yuwan tsu ɗesununa̱ tsu uwwa.&gt;&gt; Ɗaɗa gba Baruk yuwaan le ɗesununa̱, a̱vu a uwwa na atsuvu e le. <verse eid="JER 36:15" /><verse number="16" style="v" sid="JER 36:16" />A mantsa ma na a uwwai idanshi i nda suru, reve a̱ ka̱la̱la̱i a̱tsuma̱ o wovon, a̱vu a damma Baruk, &lt;&lt;Ili i ro yi lo shi, tsu ta̱ ka̱mbuwa̱ mogono idanshi i nda suru.&gt;&gt; <verse eid="JER 36:16" /><verse number="17" style="v" sid="JER 36:17" />Reve ece Baruk, &lt;&lt;Damma tsu, cine vu yuwain vu ɗanai idanshi i nda suru? Irimiya ɗa dansaa nuwu?&gt;&gt;<verse eid="JER 36:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 36:18" />Reve Baruk usu u damma, &lt;&lt;Ee, a̱ yi ɗa u dansaa numu idanshi i nda'a, a̱vu a̱mu n ɗanasa le na̱ maɗanutsu a̱tsuma̱ a aatagada.&gt;&gt;<verse eid="JER 36:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 36:19" />Reve azagbai'in a damma Baruk, &lt;&lt;Suma vu pa'an, a̱vu na̱ Irimiya! Waru she i lyawa nanza reve uba̱ta̱ u na i pa'ain wan.&gt;&gt;<verse eid="JER 36:19" /></para>
  <para style="s">Jehoyakim kula̱to ta̱ aatagada o ukutsuluwu</para>
  <para style="p">
    <verse number="20" style="v" sid="JER 36:20" />A mantsa ma na a zuwai aatagada o ukutsuluwu aasula a̱ Elishama za vi iɗana, reve a̱ ka̱ra̱ a̱ tyo uba̱ta̱ u mogono o ukowo u na u ri a̱tsuma̱ o u'wa u mogono, a̱vu a̱ ka̱mbuwa̱ yi ili'i suru. <verse eid="JER 36:20" /><verse number="21" style="v" sid="JER 36:21" />A̱vu mogono ma̱ lyungu Yehudi u tara aatagada o ukutsuluwu'u a̱ ta̱wa̱, diga aasula a Elishama za vi iɗana, reve u yuwaan mogono ɗesununa̱ oɓolo na azagbain o mogono a na a̱ ri mishin zuzu na̱ yi. <verse eid="JER 36:21" /><verse number="22" style="v" sid="JER 36:22" />O woto wa̱ kucci u ɗa u da̱na̱i a mantsa mo uta̱nu, waru mogono'o u da̱na̱ aasula a na u tsu da̱nu a mantsa mo uta̱nu, a uwwusa sheshen wa akina a na a̱ ri pe a̱tsuma̱ a mataɗa. <verse eid="JER 36:22" /><verse number="23" style="v" sid="JER 36:23" />A mantsa ma na Yehudi ɗeyi nu una̱ u ka̱ra̱ ugeru uta'atsu ko a̱za̱ a̱ na̱shi shi diga a̱tsuma̱ aatagada'a, reve mogono ma tara matsun mo ulapulu u maɗanutsu, u paɗa upasu wa aatagada'a a̱vu u tsun yi pe a̱tsuma̱ akina a na a̱ ri a̱tsuma̱ a mataɗa'a, reve u yuwusan ne hali u kula̱to aatagada o ukutsuluwu'u suru. <verse eid="JER 36:23" /><verse number="24" style="v" sid="JER 36:24" />Na̱ ne suru, ko mogono ko azagbain a̱ yi aza a na a uwwai idanshi ya aatagada a nda, ko za da'wan ko wukara utugu wa̱ yi adama u roco a̱tsumola̱ngu shi. <verse eid="JER 36:24" /><verse number="25" style="v" sid="JER 36:25" />&lt;&lt;Ko na o'woi Elinatan na̱ Delaya na̱ Gemariya a̱ pati ta̱ mogono she u ukuloto aatagada'a wan, na̱ ne suru u poloo le atsuvu shi.&gt;&gt; <verse eid="JER 36:25" /><verse number="26" style="v" sid="JER 36:26" />&lt;&lt;O una̱ u ndolo, reve mogono ma damma ulobo wa̱ yi Yerameye na̱ Seraya ulobo wa̱ Aziriyel na̱ Shelemiya ulobo wa̱ Abideyel e reme Baruk za vi iɗana na̱ Irimiya vumava̱sula̱. Amma a̱vu A̱sulazuva o soko le.&gt;&gt;<verse eid="JER 36:26" /></para>
  <para style="s">A̱ da̱shi ta̱ ɗana aatagada o ukutsuluwu o ro</para>
  <para style="p">
    <verse number="27" style="v" sid="JER 36:27" />A mantsa ma na mogono ma̱ kula̱toi aatagada o ukutsuluwu a na a̱ ri ni idanshi i na Irimiya dansaa yi Baruk ɗana, reve a̱ A̱sulazuva a yuwan adanshi na̱ Irimiya ana, <verse eid="JER 36:27" /><verse number="28" style="v" sid="JER 36:28" />&lt;&lt;Vu tara aatagada o ukutsuluwu o ro a̱vu vu ɗana idanshi i na i da̱na̱i aatagada o ufaru e de ɗe, za na mogono Jehoyakim va Yahuda kula̱toi.&gt;&gt; <verse eid="JER 36:28" /><verse number="29" style="v" sid="JER 36:29" />Reve vu damma mogono Jehoyakim va Yahuda, &lt;&lt;apa ili i na A̱sulazuva a dammai, a̱vu ɗa vu kula̱toi aatagada o ukutsuluwu a nda a̱vu vu damma, &lt;adama a̱ nye vu ɗanai pe a̱tsuma̱ a̱ yi ana, ili i ro yi lo shi mogono ma Babila ma̱ ta̱ ta̱wa̱ u kototo iɗa i nda, a̱vu waru wu una a ama a̱ yi ni inama ya̱ yi?&gt; &gt;&gt; <verse eid="JER 36:29" /><verse number="30" style="v" sid="JER 36:30" />&lt;&lt;Adama o ndolo apa ili i na a̱ A̱sulazuva a dammai adama o mogono Jehoyakim va Yahuda. Va̱a̱ tsura̱ za ro diga o ugundo wa̱ wu na a̱ da̱nu ootogu o tsugono tsa̱ Da̱wuda shi. A ta vari a̱kwa̱kwa̱ a̱ lipu a̱ wu alanga adama u sowo urana reve u sowo uta̱nu waru na ayin. <verse eid="JER 36:30" /><verse number="31" style="v" sid="JER 36:31" />N ta ca yi oforo oɓolo na̱ muwun ma̱ yi na aza a na a yuwusaan yi a̱ga̱nda̱ adama e iwuya i le. N ta̱ ta̱wa̱ na addama a aci e le suru na n yuwain adanshi aci a̱ yi, oɓolo na̱ nda̱na̱ta̱ ma̱ Urishelima na̱ Yahuda. Adama a na i 'yuwain a uwwa.&gt;&gt;<verse eid="JER 36:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JER 36:32" />Reve Irimiya tara aatagada o ukutsuluwu o ro, u ca Baruk za vi iɗana ulobo wa̱ Neriya, nu u dansaa niyi ili i na A̱sulazuva a damma niyi, a̱vu Baruk ɗana a̱tsuma̱ aatagada'a suru idanshi i na i da̱na̱i a̱tsuma̱ aatagada a na mogono Jehoyakim va Yahuda kula̱toi a̱tsuma̱ akina. Reve a̱ da̱shi yuwisan adanshi na̱ a̱bunda̱ cu'un vu za vu ufaru.<verse eid="JER 36:32" /></para>
  <chapter eid="JER 36" />
  <chapter number="37" style="c" sid="JER 37" />
  <para style="s">Irimiya ɓara ta̱ Zedekiya</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 37:1" />A̱vu Nebukanaza va Babila katala Zedekiya ulobo wa̱ Josiya wo o'wo mogono ma Yahuda o una̱ u Mogono Yekoniya ulobo wa̱ Jehoyakim.<note caller="-" style="x"><char style="xo" closed="false">37:1 </char><char style="xt" closed="false"><ref loc="2KI 24:17">2 Ngo 24:17</ref>; <ref loc="2CH 36:10">2 Alb 36:10</ref>.</char></note> <verse eid="JER 37:1" /><verse number="2" style="v" sid="JER 37:2" />Amma a̱yi na aza a na a yuwusan yi a̱ga̱nda̱ oɓolo na ama e iɗa'a o polo atsuvu adanshi a̱ A̱sulazuva za na u yuwaan le o una̱ wa̱ Irimiya vumava̱sula̱ shi.<verse eid="JER 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 37:3" />A̱vu mogono Zedekiya lyungu Yehukal ulobo wa̱ Shelemiya oɓolo na̱ Zafaniya ganu ulobo wa̱ Ma'aseya a̱ tyo ya̱ Irimiya vumava̱sula̱ ni ikaka i nda, &lt;&lt;Vu yuwan ankuri vu yuwan avasa a̱ tyo uba̱ta̱ wa̱ A̱sulazuva A̱sula̱ a̱ tsu o una̱ u tsu.&gt;&gt;<verse eid="JER 37:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 37:4" />A mantsa mo ndolo koto a̱ shi a zuwa Irimiya o u'wa wa ali shi. Waru u da̱na̱ ta̱ nu ucira u na wa uwa a̱tsuma̱ ama ununa u cigai. <verse eid="JER 37:4" /><verse number="5" style="v" sid="JER 37:5" />Ele lo a̱vu a̱soja o mogono a Firi'awuna va Masar o uta̱ diga Masar reve a saɓa a̱ tyo Urishelima. Ana a̱soja a Babila aza a na a̱ ka̱nda̱ruwa̱i Urishelima nu uvon a uwwai adama a ɗa e le, a̱vu a̱ ta̱ra̱nu na̱ a̱ca̱pa̱ a lyawa Urishelima.<verse eid="JER 37:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 37:6" />A̱vu a̱ A̱sulazuva a yuwan adanshi na̱ vumava̱sula̱ Irimiya u damma, <verse eid="JER 37:6" /><verse number="7" style="v" sid="JER 37:7" />&lt;&lt;Apa ili i na A̱sulazuva a̱ A̱sula̱ a Isra'ila dammai, vu damma mogono ma Yahuda, za na lyunguyi a zami mu ana, &lt;A̱soja a̱ Firi'awuna a na o uta̱i adama a kamba wu, a̱ ta̱ ka̱mba̱ e iɗa i le Masar. <verse eid="JER 37:7" /><verse number="8" style="v" sid="JER 37:8" />Agba waru a̱soja a Babila a̱ ta̱ ka̱mba̱ a yuwan uvon na̱ lyuci nda. Waru a ta lyuwa yi, a̱vu a̱ kula̱to yi na akina.&gt; &gt;&gt;<verse eid="JER 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 37:9" />&lt;&lt;Apa ili i na A̱sulazuva a dammai, she i luluma̱ aciya̱ɗu a majiyan adansa, &lt;Na amayun a̱soja a Babila a lyawa tsu ta̱.&gt; O'o, aa lyawa ɗu shi! <verse eid="JER 37:9" /><verse number="10" style="v" sid="JER 37:10" />Ko na̱ shi a damma i ta lyuwa oɓolo a̱soja a Babila aza a na a yuwusan uvon na̱ ɗu nu uvon, akapi aza a na a uwwai usa̱n a na ri nven a̱tsuma̱ ogodo e le, a̱ ta̱ 'yon a daɓa lyuci'i akina.&gt;&gt;<verse eid="JER 37:10" /></para>
  <para style="s">A zuwa ta̱ Irimiya o u'wa wa ali</para>
  <para style="p">
    <verse number="11" style="v" sid="JER 37:11" />Ele lo a̱vu oɓolo a̱soja a Babila a lyawa uvon na̱ Urishelima adama o uta̱wu wa̱ a̱soja o mogono a Firi'awuna va Masar, <verse eid="JER 37:11" /><verse number="12" style="v" sid="JER 37:12" />reve Irimiya lyawa lyuci'i adama u 'ya̱wa̱ upasu wi iɗa ya Banyami adama u ushiyi akunda agadu a̱ yi uba̱ta̱ wa ama a na a̱ ri ɗe. <verse eid="JER 37:12" /><verse number="13" style="v" sid="JER 37:13" />Amma a mantsa ma na u rawai o una̱ntsu u na e ɗesu una̱ntsu wa Banyami, a̱vu u cina yali ya̱ a̱soja ro wa̱ a̱za̱ e ipiri uba̱ta̱'a̱, za va ala Irija ulobo wa̱ Shelemiya ulobo wa Hananiya. Reve Irija reme Irimiya vumava̱sula̱ u damma, &lt;&lt;Vu ta̱ e ilaɗi adama a̱soja a Babila!&gt;&gt;<verse eid="JER 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 37:14" />Amma a̱vu Irimiya damma,&lt;&lt;Amayun a ɗa shi! N ri e ilaɗi adama a̱soja a Babila shi!&gt;&gt; Amma Irija zuwaa Irimiya atsuvu shi, o una̱ u ndolo, reve u reme Irimiya u tyowetyo yi uba̱ta̱ wa azagbain o mogono. <verse eid="JER 37:14" /><verse number="15" style="v" sid="JER 37:15" />A̱vu azagbain o mogono'o a yuwan upan na̱ Irimiya, reve a kada yi, a̱vu a̱ nla̱ yi o u'wa wa Jonata za vi iɗana i mogono, adama a na a̱ ka̱mbuwa̱i ɗe u'wa'a wo o'woi u'wa wa ali.<verse eid="JER 37:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 37:16" />A̱vu a zuwa Irimiya a̱tsuma̱ a̱ka̱ri a̱tsuma̱ o u'wa wa ali, waru u yuwan ta̱ rana a̱bunda̱ uba̱ta̱'a̱.<verse eid="JER 37:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 37:17" />Reve mogono Zedekiya lyungu a̱ ta̱wa̱ na̱ yi, reve a̱ ta̱wa̱ na̱ yi o ukobu. Uba̱ta̱ u na u yuwan niyi yeci usokowu u damma, &lt;&lt;Adanshi o ro a̱ ta̱ lo diga uba̱ta̱ wa̱ A̱sulazuva?&gt;&gt;</para>
  <para style="p" vid="JER 37:17">A̱vu Irimiya usu, &lt;&lt;Ee, adanshi a̱ ta̱ lo!&gt;&gt; A̱vu u lyuwa elime na adanshi u damma, &lt;&lt;A ta ca wu ekere o mogono ma Babila!&gt;&gt;<verse eid="JER 37:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 37:18" />Reve Irimiya damma mogono Zedekiya, &lt;&lt;Unusu u ne ɗa n yuwaan nuwu na azagbain a̱ wu ko a ama a nda, a na vu zuwai a vari mu a̱tsuma̱ o u'wa wa ali? <verse eid="JER 37:18" /><verse number="19" style="v" sid="JER 37:19" />A̱ te ɗa ama̱sula̱ a̱ wu a̱ ri, aza a na a̱ da̱na̱i a yuwusaan wu adanshi e ikaka ana, &lt;Mogono ma Babila a̱ ta̱wa̱a̱ wu nu uvon a̱tsuma̱ a̱ lyuci'i shi&gt;? <verse eid="JER 37:19" /><verse number="20" style="v" sid="JER 37:20" />Amma gogo, wuma wa̱ wu ujima, zagbain va̱, uwwa ne'e, lyawa n ta̱wa̱ na̱ mesun ma̱ va̱ elime a̱ wu. She vu da̱shi ka̱mba̱to mu o u'wa wa Jonata za vi iɗana wan, na̱ ne ɗa shi n ta̱ kuwa̱ ɗe.&gt;&gt;<verse eid="JER 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 37:21" />&lt;&lt;A̱vu mogono Zedekiya ca udammu a̱ ɓa̱ru Irimiya o ukowo a̱ nge'en mu upasu wa̱ a̱za̱ e ipiri. A̱vu a lyuwa elime a casu yi a̱ a̱a̱kutsu opopofu diga o upasu wa aza a na a̱ zunsu opopofu urana biti, hali acina mantsa ma na opopofu a̱ lyuci'i o kotoi. Adama o ndolo a ɗa Irimiya da̱nuyi o ukowo a̱ nge'en mu upasu wa̱ a̱za̱ e ipiri.&gt;&gt;<verse eid="JER 37:21" /></para>
  <chapter eid="JER 37" />
  <chapter number="38" style="c" sid="JER 38" />
  <para style="s">A vari ta̱ Irimiya o oko'o a na a̱ ri na̱ mini shi</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 38:1" />Ele lo a̱vu Shefatiya ulobo wa Mattan na̱ Gedaliya ulobo wa Fashu na̱ Yehukal ulobo wa Shelemiya na̱ Fashu ulobo wa Malkiya, suru nle a uwwa ta̱ adanshi a na Irimiya yuwain elime a ama ana, <verse eid="JER 38:1" /><verse number="2" style="v" sid="JER 38:2" />&lt;&lt;Apa ili i na A̱sulazuva a dammai, za na da̱nuyi a̱tsuma̱ a̱ lyuci nda suru u ta̱ kuwa̱ a̱tsuma̱ o ure u matsun me pe'eni na ambulu na̱ mɓa̱la̱. Amma za na o uta̱i suru u cayi aciya̱yi e ekere a̱ a̱soja a Babila u ta̱ da̱na̱ wuma. Na amayun u ta la'ato wuma wa̱ yi reve u da̱na̱ wuma. <verse eid="JER 38:2" /><verse number="3" style="v" sid="JER 38:3" />Waru nda ili i na A̱sulazuva a dammai, na amayun a ta ca lyuci nda e ekere a̱ a̱soja o mogono ma Babila, za na aa lyuwai nu uvon.&gt;&gt;<verse eid="JER 38:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 38:4" />Reve azagbai'in a damma mogono, &lt;&lt;Wuntsaa ta̱ o una vuma nda'a. Adama a na u kuɗa ta okolo akapi a̱soja a na a buwai a̱tsuma̱ a̱ lyuci'i, oɓolo na akapi okolo a ama, o ure wi ili i na waa dansaa le. Adama a na vuma nda'a u ri a ɗa gbaga lipu va ama nda shi, she a̱tsuma̱lima̱ goon.&gt;&gt; <verse eid="JER 38:4" /><verse number="5" style="v" sid="JER 38:5" />A̱vu mogono Zedekiya damma, &lt;&lt;To, o lo yi gba ekere a̱ ɗu, a̱mu mogono maa gura putsaa ɗu shi.&gt;&gt;<verse eid="JER 38:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 38:6" />Adama o ndolo a̱vu a tara Irimiya a zuwai oko'o a̱tsuma̱ o u'wa wa Malkiya ulobo u mogono, za na ri upasu wu ukowo wa̱ a̱za̱ e ipiri. Reve a̱ cipa̱to Irimiya a̱tsuma̱ oko'o na amunga. Waru oko'o u da̱na̱ pe na̱ mini shi, she yilyo'o goon, a̱vu Irimiya liɓa pe a̱tsuma̱ a̱ yilyo'o'o.<verse eid="JER 38:6" /></para>
  <para style="s">Ebedimele wawa ta̱ Irimiya</para>
  <para style="p">
    <verse number="7" style="v" sid="JER 38:7" />Amma a̱vu Ebedimele vuma va Kush zagbain a̱tsuma̱ o u'wa u mogono uwwa ana, a zuwa ta̱ Irimiya a̱tsuma̱ oko'o a na a̱ ri pe na̱ mini shi. A mantsa ma na mogono ma̱ da̱na̱i nden o una̱ntsu u na a̱ tsu ɗe una̱ntsu wa Banyami, <verse eid="JER 38:7" /><verse number="8" style="v" sid="JER 38:8" />a̱vu Ebedimele uta̱ diga a̱tsuma̱ o ukobu u damma yi, <verse eid="JER 38:8" /><verse number="9" style="v" sid="JER 38:9" />&lt;&lt;Wuma wa̱ wu u jima zagbain va̱ mogono, ama a nda a yuwan ta̱ iwuya suru a̱tsuma̱ e ili i na a yuwayin vumava̱sula̱ Irimiya. A vari yi ta̱ a̱tsuma̱ oko'o a na a̱ ri na̱ mini shi, uba̱ta̱ u na wa̱a̱ kuwa̱ na ambulu, adama a na babu akapi opopofu a na a buwai a̱tsuma̱ e iɗa'a.&gt;&gt;<verse eid="JER 38:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 38:10" />A̱vu mogono ma damma Ebedimele vuma va̱ Kush,&lt;&lt;Tara ama mata'atsu diga pa, i ka̱ra̱ yu uta̱a̱ Irimiya diga oko'o'o kafu u kuwa̱.&gt;&gt;<verse eid="JER 38:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 38:11" />Adama o ndolo reve Ebedimele tara ama'a u ka̱ra̱ ne ele a̱ tyo a̱tsuma̱ o u'wa wi izuwa a̱tsuma̱ o ukobu. Reve u pura̱ akuci a amuna na akashi a̱ a̱tugu na amunga a̱vu wu telyuwetyowa̱ Irimiya pe a̱tsuma̱ oko'o'o. <verse eid="JER 38:11" /><verse number="12" style="v" sid="JER 38:12" />A̱vu Ebedimele vuma va Kush damma Irimiya, &lt;&lt;Zuwa akuci amuna'a na akashi a̱tugu'u a yipayan ya̱ wu ukatalu na amunga'a.&gt;&gt; Reve Irimiya yuwan ne. <verse eid="JER 38:12" /><verse number="13" style="v" sid="JER 38:13" />Reve o rono yi agawan na amunga a̱vu o uta̱a̱ yi diga a̱tsuma̱ o oko'o. A̱vu Irimiya da̱nu o ukowo o upasu wa aza a na a yuwusan ipiri.<verse eid="JER 38:13" /></para>
  <para style="s">Zedekiya da̱shi ta̱ yuwan Irimiya yeci</para>
  <para style="p">
    <verse number="14" style="v" sid="JER 38:14" />A̱vu mogono Zedekiya da̱shi lyunguwisa̱ a̱ ta̱wa̱ na̱ Irimiya vumava̱sula̱ uba̱ta̱ wa̱ yi o una̱ntsu wa ta'atsu wu u'wa wa̱ A̱sulazuva. Reve mogono ma damma Irimiya, &lt;&lt;N ciga ta̱ me ece wu ili i ro ne'e, agba she vu soko mu ili wan.&gt;&gt;<verse eid="JER 38:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 38:15" />A̱vu Irimiya damma Zedekiya, &lt;&lt;Nna̱ n ca wu usu, voo o una mu shi? Ko na̱ shi n ca wu a̱sa̱la̱ voo o polo mu atsuvu shi!&gt;&gt;<verse eid="JER 38:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 38:16" />Amma a̱vu mogono Zedekiya kucinaa Irimiya usokowu u damma, &lt;&lt;N kucina ta̱ na̱ A̱sulazuva a na a̱ ri wuma, za na zuwai tse e ivuwusan, moo o una wu shi, ko n ca wu e ekere aza a na a zama wuma wa̱ wu shi.&gt;&gt;<verse eid="JER 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 38:17" />A̱vu Irimiya damma mogono Zedekiya, &lt;&lt;Apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva a̱ A̱sula̱ a Isra'ila dammai, nna̱ vu ca aciya̱wu e ekere a̱soja o mogono ma Babila, a ta lyawa wu wuma waru a̱ kula̱to lyuci nda shi, a̱vu nu u'wa wa̱ wu i ta̱ da̱na̱ wuma. <verse eid="JER 38:17" /><verse number="18" style="v" sid="JER 38:18" />Amma nna̱ vu ca aciya̱wu e ekere a̱ a̱soja o mogono ma Babila shi, to, a ta ca lyuci nda e ekere e le, waru a̱ ta̱ kula̱to yi na akina, waru a̱vu na aciya̱wu vaa la'a e ekere e le shi.&gt;&gt;<verse eid="JER 38:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 38:19" />A̱vu mogono Zedekiya damma Irimiya, &lt;&lt;N ta uwwusa wovon wa aza a Yahuda na a sumai a cayi aci ye le e ekere a̱ a̱soja a Babila. U ta gura o o'wo a̱soja a Babila a ca mu e ekere aza a Yahuda o ndolo adama a yuwaan mu ulamu.&gt;&gt;<verse eid="JER 38:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 38:20" />A̱vu Irimiya usu u damma, &lt;&lt;A ca wu e ekere e le shi. A̱vu de vu yuwan tsutoni na adanshi a̱ A̱sulazuva a na ma adansa wu. U ta̱ gba yuwaan wu urana, waru vu ta la'a na̱ wuma wa̱ wu.&gt;&gt; <verse eid="JER 38:20" /><verse number="21" style="v" sid="JER 38:21" />&lt;&lt;Amma nna̱ vu 'yuwan a ca aciya̱wu, to, apa ili i na A̱sulazuva o roco numu, <verse eid="JER 38:21" /><verse number="22" style="v" sid="JER 38:22" />a̱ma̱ci a na a lyawai suru a̱tsuma̱ o ukobu u mogono ma̱ Yahuda, a̱ ta̱ o uta̱ ne le adama a ca azagbain o mogono ma Babila, waru a̱ma̱ci'i a ta damma wu,</para>
  <para style="b" vid="JER 38:22" />
  <para style="q1" vid="JER 38:22">&lt;&lt;A̱ luluma̱ wu ta̱ reve a lyuwa aci a̱ wu,</para>
  <para style="q2" vid="JER 38:22">ele n'utsa̱ nna vu soɗuwoyi ma̱tsa̱n.</para>
  <para style="q1" vid="JER 38:22">N'utsa̱ ma̱ wu n vari wu ta̱,</para>
  <para style="q2" vid="JER 38:22">mantsa ma na ana a̱ wu</para>
  <para style="q2" vid="JER 38:22">o sovuroi a̱tsuma̱ a̱ yilyo'o.&gt;&gt;<verse eid="JER 38:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 38:23" />&lt;&lt;A̱ ta̱ o uta̱ wa̱a̱ a̱soja a Babila na̱ a̱ma̱ci a̱ wu na̱ muwun ma̱ a̱ wu alanga. Waru a̱vu na aciya̱wu vaa la'a diga e ekere e le shi, amma a ta zuwa mogono ma Babila me reme wu, waru a̱ ta̱ kula̱to lyuci nda na akina.&gt;&gt;<verse eid="JER 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 38:24" />A̱vu Zedekiya damma Irimiya,&lt;&lt;She vu lyawa za ro reve na adanshi a nda wan, nna̱ za ro reve gba, a̱vu ɗa va̱ kuwa̱. <verse eid="JER 38:24" /><verse number="25" style="v" sid="JER 38:25" />Nna azagbain a̱ va̱ a uwwa n yuwan ta̱ adanshi na̱ vu, a̱vu a̱ ta̱wa̱ uba̱ta̱ wa̱ wu a̱vu a damma, &lt;Vu damma tsu ili i na vu dammai mogono, oɓolo ni ili i na mogono ma damma nuwu, she vu soko tsu ili i ro wan, na̱ ne ɗa shi tsu to o una wu.&gt; <verse eid="JER 38:25" /><verse number="26" style="v" sid="JER 38:26" />A̱vu vu damma le ana, &lt;M pati ta̱ mogono she u da̱shi lyawa mu n ka̱mba̱ o u'wa wa Jonata adama n kuwa̱ ɗe wan.&gt; &gt;&gt;<verse eid="JER 38:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 38:27" />&lt;&lt;Reve gba azagbain o mogono suru a̱ ka̱ra̱ a̱ tyo ya̱ Irimiya a̱vu ece yi, a̱vu u damma le suru ili i na mogono ma damma niyi u damma. Adama o ndolo a ɗa a̱ da̱shi damma niyi adama shi, adama a na babu za na uwwai n dammulai nna a yuwain na̱ mogono.&gt;&gt;<verse eid="JER 38:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JER 38:28" />A̱vu Irimiya da̱nu o ukowo wu upasu wa aza a na a yuwusan ipiri, hali acina urana u na a lyuwai Urishelima nu uvon.</para>
  <para style="s" vid="JER 38:28">A̱risa̱ a̱ Urishelima</para>
  <para style="p" vid="JER 38:28">Apa cine a lyuwai Urishelima nu uvon,<verse eid="JER 38:28" /></para>
  <chapter eid="JER 38" />
  <chapter number="39" style="c" sid="JER 39" />
  <para style="p">
    <verse number="1" style="v" sid="JER 39:1" />A̱tsuma̱ a aa'wan a̱ kucci o tsugono tsa̱ mogono Zedekiya va Yahuda, o woto wa kupa a̱vu mogono Nebukanaza va Babila ta̱wa̱ na̱ a̱soja yi suru, a̱vu a̱ ka̱nda̱ruwa̱ Urishelima nu uvon. <verse eid="JER 39:1" /><verse number="2" style="v" sid="JER 39:2" />A̱tsuma̱ o urana wa̱ kucci o woto wa̱ na̱shi, a̱tsuma̱ aa'wan a kupa na̱ za ta̱ o tsugono tso mogono Zedekiya, ɗaɗa a̱ ba̱ma̱i ukari u lyuci.<verse eid="JER 39:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 39:3" />Ɗaɗa azagbain o mogono ma Babila suru a uwwai a̱ da̱nuyi o Una̱ntsu u Memere u lyuci adama a yuwan tsugbain tsa lyuci'i. Aza a na ele ɗa Nerigal Sareze na̱ Samga Nebo na̱ Sarisekim za va Rabisari yali ya̱ a̱soja na̱ Neriga Sareze va Rabima oɓolo na azagbain o mogono a Babila suru.<verse eid="JER 39:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 39:4" />A mantsa ma na mogono Zedekiya va Yahuda no oɓolo a̱ a̱soja a̱ yi ene nle a̱vu a suma, a lyawa lyuci'i na ayin a̱ kuru na̱ a̱a̱rumbu o mogono, nu una̱ntsu u na u ri e memere vu ɓaɓu re, a̱vu a saɓa nu ure wu Uka̱ri wa Araba.<verse eid="JER 39:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 39:5" />Amma a̱vu a̱soja a Babila a saɓa le, a̱vu e reme mogono Zedekiya a agalaci a̱ Jeriko. Reve e reme yi a̱ tyowetyo yi uba̱ta̱ wa̱ Nebukanaza a̱tsuma̱ a Ribla e iɗa ya Hamat, uba̱ta̱ u na Nebukanaza paɗa niyi ugana. <verse eid="JER 39:5" /><verse number="6" style="v" sid="JER 39:6" />Ɗe a̱tsuma̱ a Ribla ɗa mogono ma Babila mo o unai olobo a̱ Zedekiya, esu a̱ yi a ɗa waru o unai azagbain a ama a Yahuda suru. <verse eid="JER 39:6" /><verse number="7" style="v" sid="JER 39:7" />A̱vu wu foɗo esu a Zedekiya, a̱vu wu wunla̱ yi na amunga e irumu u tara yi a̱ tyo Babila.<verse eid="JER 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 39:8" />A̱vu a̱ a̱soja a Babila a̱ kula̱to u'wa u mogono na̱ 'wa va ama na akina, a̱vu fo o ɓoso ukari u lyuci wa̱ Urishelima. <verse eid="JER 39:8" /><verse number="9" style="v" sid="JER 39:9" />A̱vu Nebuzarada, zagbain va̱ a̱za̱ e ipiri i mogono pura̱ akapi ama a na a buwai a̱tsuma̱ a̱ lyuci'i, oɓolo na aza a na a sumai a̱ tyo ya̱'a̱ yi o o'woi a̱za̱ a̱ yi, u pura̱ le ta̱ suru a̱ tyo tsugbashi e iɗa ya Babila. <verse eid="JER 39:9" /><verse number="10" style="v" sid="JER 39:10" />Amma a̱vu Nebuzarada zagbain va̱ a̱za̱ e ipiri'i, u lyawaa a̱za̱ o ulambu o ro a̱tsuma̱ e iɗa ya Yahuda a̱ɗuma̱ a̱ ina̱bi na atsusa.<verse eid="JER 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 39:11" />To, agba a̱ yi ɗa nda, mogono Nebukanaza va Babila cayi ɗe Nebuzarada zagbain va̱ a̱za̱ e ipiri i mogono u dammu adama a̱ Irimiya ana, <verse eid="JER 39:11" /><verse number="12" style="v" sid="JER 39:12" />&lt;&lt;Vu tara Irimiya vi idana yi ulobonu lon, agba she vu yuwayin iwuya i ro wan, amma vu yuwayin ili i na u cigai biti.&gt;&gt;<verse eid="JER 39:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 39:13" />&lt;&lt;Adama o ndolo a̱vu Nebuzarada zagbain va̱ a̱za̱ e ipiri i mogono na̱ Nebushaban za na tsu ɗe Rabisari yali ya̱ a̱soja na̱ Neriga Sareze za na tsu ɗe Rabima oɓolo na akapi a̱soja o mogono ma Babila, <verse eid="JER 39:13" /><verse number="14" style="v" sid="JER 39:14" />a̱ lyungu adama a̱ ta̱wa̱ na̱ Irimiya diga o upasu wu ukowo wa̱ a̱za̱ e piri. A̱vu a ca yi e ekere a̱ Gedaliya ulobo wa̱ Ahikam, ulobo wa Shafa, adama u tara Irimiya a̱ tyo o u'wa, adama u da̱nu ɗe a̱tsuma̱ ama a̱ yi.&gt;&gt; <verse eid="JER 39:14" /><verse number="15" style="v" sid="JER 39:15" />A̱sulazuva a̱ shi ta̱ a yuwan adanshi na̱ Irimiya a mantsa ma na u da̱na̱i uɓa̱ruwu a̱ nge'en mu upasu wa̱ a̱za̱ e ipiri u damma, <verse eid="JER 39:15" /><verse number="16" style="v" sid="JER 39:16" />Ka̱ra̱ vu yuwan adanshi na̱ Ebedimele vuma va̱ Kush vu damma yi, &lt;&lt;apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva a̱ A̱sula̱ a Isra'ila dammai, ka̱lyuwa̱, agba a̱ yi ɗa nda n yuwan ta̱ zuzu na moo o shiton adanshi a na n yuwain adama a̱ lyuci nda, adanshi a addama agba za vi isa'ani shi. A mantsa'a a ta shiwan e esu a̱ wu. <verse eid="JER 39:16" /><verse number="17" style="v" sid="JER 39:17" />Amma o urana u ndolo n ta wawa wu Ebedimele, waru aa ca wu e ekere aza a na vaa uwwusa wovon shi. Ne ɗa A̱sulazuva a dammai. <verse eid="JER 39:17" /><verse number="18" style="v" sid="JER 39:18" />Na amayun n ta wawa wu, waru va̱a̱ kuwa̱ a̱tsuma̱ o ure u matsun me pe'eni shi, vu ta la'a na̱ wuma wa̱ wu, adama a na vu zuwai ucira wa̱ wu ya̱'a̱ va̱. Ne ɗa A̱sulazuva a dammai.&gt;&gt;<verse eid="JER 39:18" /></para>
  <chapter eid="JER 39" />
  <chapter number="40" style="c" sid="JER 40" />
  <para style="s">A lyawa ta̱ Irimiya da̱nu fa̱a̱n</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 40:1" />Reve A̱sulazuva a yuwan adanshi na̱ Irimiya a mantsa ma na Nebuzarada zagbain va̱ a̱za̱ e ipiri i mogono lyawa niyi ɗe a Rama, Nebuzarada shi ta̱ 'ya̱wa̱ ɗe na̱ Irimiya wunlu na akani, oɓolo na ama a̱ Urishelima na̱ Yahuda aza a na a tarai a̱ tyo tsugbashi a̱tsuma̱ a Babila. <verse eid="JER 40:1" /><verse number="2" style="v" sid="JER 40:2" />Ana zagbain va̱ a̱za̱ e ipiri'i u cinai Irimiya, reve u damma yi, &lt;&lt;A̱sulazuva A̱sula̱ a̱ wu a ɗa a yuwain adanshi adama a addama o uba̱ta̱ u nda. <verse eid="JER 40:2" /><verse number="3" style="v" sid="JER 40:3" />Gogo A̱sulazuva a zuwa yi ta̱ u shiwan, waru a̱ yi ɗa nda u yuwain ununa u dammai. Ili ya nda suru i fara ta̱ adama a na i yuwayin A̱sulazuva unusu, waru i yuwaan yi tsutoni shi. <verse eid="JER 40:3" /><verse number="4" style="v" sid="JER 40:4" />Agba ana'an n ta̱ ba̱ɗa̱ amunga a na a̱ ri a̱ yinlu ya̱ wu. Ta̱wa̱ tsu ka̱ra̱ a̱ tyo Babila na̱ vu ciga, n ta̱ gba e idana wu ulobonu, amma na̱ vu ciga shi, she vu ta̱wa̱ wan. Ka̱lyuwa̱, agba a̱ yi ɗa iɗa'a suru i ta̱ ekere a̱ wu, vu ka̱ra̱ a̱ tyo uba̱ta̱ u na vu cigai biti.&gt;&gt; <verse eid="JER 40:4" /><verse number="5" style="v" sid="JER 40:5" />Amma kafu Irimiya vadala na wa̱ ka̱ra̱, reve Nebuzarada da̱shi damma yi, &lt;&lt;Vu ka̱mba̱ uba̱ta̱ wa̱ Gedaliya ulobo wa Ahikam ulobo wa Shafa, za na mogono ma Babila ma zuwai a na wa yuwan tsugono tsi ilyuci ya Yahuda, vu da̱nu oɓolo na̱ a̱ yi na ama'a, ko gba shi vu tyo uba̱ta̱ u na ve e enei ulobono nuwu biti.&gt;&gt; Reve u ca Irimiya ilyalya oɓolo nu une'e, a̱vu u lyawai u ka̱ra̱. <verse eid="JER 40:5" /><verse number="6" style="v" sid="JER 40:6" />Reve Irimiya ka̱ra̱ a̱ tyo ya Gedaliya ulobo wa Ahikam a̱tsuma̱ a Mizfa, a̱vu u da̱nu oɓolo na̱ a̱ yi na akapi ama na a buwai pe e iɗa'a.<verse eid="JER 40:6" /></para>
  <para style="s">O una ta̱ Gedaliya</para>
  <para style="r">(<ref loc="2KI 25:25-26">2 Ngo 25:25-26</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="JER 40:7" />A mantsa ma na azagbain a̱soja suru na a̱ ri a pasu va Yahuda oɓolo na ama e le, a uwwai alabari a na Mogono ma Babila ma zuwa ta̱ Gedaliya ulobo wa Ahikam wo o'wo za na a yuwan tsugbain tsi iɗa'a e ekere a ali na̱ a̱ma̱ci na̱ muwun, aza a na a̱ ri nu ulambu a̱tsuma̱ e iɗa'a, oɓolo na aza a na a̱ pura̱i a̱ tyo e iɗa ya Babila tsugbashi shi, <verse eid="JER 40:7" /><verse number="8" style="v" sid="JER 40:8" />reve a̱ ta̱wa̱ uba̱ta̱ wa̱ Gedaliya a̱tsuma̱ a Mizfa, Isma'ila ulobo wa Netaniya na̱ Yohanan na̱ Jonata olobo a Kareya na̱ Seraya ulobo wa Tahume no olobo a Epai vuma va Netofa na̱ Jazaniya ulobo u vuma va Ma'aka oɓolo na ama e le. <verse eid="JER 40:8" /><verse number="9" style="v" sid="JER 40:9" />Gedaliya ulobo wa Ahikam ulobo wa Shafa, ma kucinaa le ta̱ oɓolo na a ama e le u damma, &lt;&lt;She yu uwwa wovon u na yaa yuwaan Babila tsugbashi wan. Yuwain nden n ɗu a̱tsuma̱ e iɗa'a, i yuwaan Mogono ma Babila tsugbashi, waru u ta yuwan ɗu urana. <verse eid="JER 40:9" /><verse number="10" style="v" sid="JER 40:10" />A̱mu na aciya̱va̱ n ta̱ da̱nu a̱tsuma̱ a Mizfa, na moo o'wo ɗu lyusu uba̱ta̱ wa aza a Babila aza a na a̱ ta̱wa̱i uba̱ta̱ u tsu. Amma i gasa umatsun u ina̱bi nu umatsun wu uɗanga ni irana na̱ mani'i ma̱ zetun, i zuɗa̱ le a̱tsuma̱ a̱ka̱bu e izuwa a̱ ɗu, reve waru i da̱nu a̱tsuma̱ e ilyuci i na i usai.&gt;&gt;<verse eid="JER 40:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 40:11" />A mantsa ma na aza a Yahuda suru a na a̱ ri a̱tsuma̱ a Mowa na̱ Amon na̱ Edom oɓolo na akapi a nɗa a uwwai ana, mogono ma Babila ma lyawa ta̱ akapi a ama o ro a̱tsuma̱ a Yahuda, a̱vu u ɗangula Gedaliya ulobo wa Ahikam ulobo wa Shafa gwamna aci e le. <verse eid="JER 40:11" /><verse number="12" style="v" sid="JER 40:12" />Reve a̱ ka̱mba̱ a̱tsuma̱ e iɗa ya Yahuda, uba̱ta̱ wa Gedaliya a̱tsuma̱ a Mizfa, diga a̱tsuma̱ e iɗa i na a̱ da̱na̱i ubetu'wu suru. A̱vu o ɓoloto masayan ma̱ ina̱bi lon nu umatsun wu ɗanga ni irana.<verse eid="JER 40:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 40:13" />Uranu u ro a̱vu Yohanan ulobo wa̱ Kareya oɓolo na a azagbain a̱soja a na a̱ ri ubetu'wu suru a̱tsuma̱ a nɗa, a̱ ta̱wa̱ uba̱ta̱ wa̱ Gedaliya a̱tsuma̱ a Mizfa, <verse eid="JER 40:13" /><verse number="14" style="v" sid="JER 40:14" />reve a damma yi, &lt;&lt;Ko vu ta̱ nu urevu u na Ba'ali Mogono ma aza a Amon ma̱ lyunguyi Isma'ila ulobo wa Netaniya a na wo o una wu?&gt;&gt; Amma Gedaliya ulobo wa Ahikam, tara adanshi e le ili ya̱ a̱ɓula̱ shi.<verse eid="JER 40:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 40:15" />Reve Yohanan ulobo wa Kareya yuwan adanshi na̱ Gedaliya a̱tsuma̱ a Mizfa usokowu u damma, &lt;&lt;Lyawa n ka̱ra̱ na ma̱a̱ 'ya̱wa̱ mu una Isma'ila ulobo wa Netaniya, waru babu za na ee reve. Adama a̱ nye ɗa a̱ yi u cigai a na wo o una wu, adama u bete'we aza a Yahuda suru na a̱ ri o oɓolo na̱ a̱vu, hali na akapi a aza a Yahuda a na a buwai a̱ kuwa̱?&gt;&gt;<verse eid="JER 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 40:16" />Amma reve Gedaliya ulobo wa Ahikam damma Yohanan ulobo wa Kareya, &lt;&lt;She vu yuwan cu'un vi ili i ndolo wan, adama a na ili i na va adansa adama Isma'ila, amayun a ɗa shi.&gt;&gt;<verse eid="JER 40:16" /></para>
  <chapter eid="JER 40" />
  <chapter number="41" style="c" sid="JER 41" />
  <para style="p">
    <verse number="1" style="v" sid="JER 41:1" />A̱tsuma̱ o woto wa̱ cindere a̱vu Isma'ila ulobo wa Netaniya ulobo wa Elishama, diga o ugundo u tsugono, za ta̱ a̱ a̱tsuma̱ a̱za̱ e ipiri i mogono, ta̱wa̱ uba̱ta̱ wa Gedaliya ulobo wa Ahikam a̱tsuma̱ a Mizfa oɓolo na ama kupa. A mantsa ma na a̱ ri a alya e ilyalya oɓolo, <verse eid="JER 41:1" /><verse number="2" style="v" sid="JER 41:2" />a̱vu Isma'ila ulobo wa Netaniya, oɓolo na ama a kupa a na a̱ ri oɓolo na̱ a̱ yi, a̱ 'yon o una Gedaliya ulobo wa Ahikam ulobo wa Shafa na̱ matsun me pe'eni, za na Mogono ma Babila ma ɗangulai a na wo o'wo gwamna vi iɗa'a. <verse eid="JER 41:2" /><verse number="3" style="v" sid="JER 41:3" />Isma'ila fo una ta̱ aza a Yahuda suru a na a̱ da̱na̱i oɓolo na̱ Gedaliya a̱tsuma̱ a Mizfa, oɓolo na̱ a̱soja a Babila a na a̱ ri lo uba̱ta̱'a̱.<verse eid="JER 41:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 41:4" />Ana usana u tawai cina o una Gedaliya, babu na za ro revei ili i na i farai, <verse eid="JER 41:4" /><verse number="5" style="v" sid="JER 41:5" />she n lo ama kupakunla̱ a̱ ta̱wa̱ diga Shekem na̱ Shilo na̱ Samariya na̱ ntsuka̱ n le upunu na̱ a̱tugu e le wukaru na̱ lipu le ɓuɓatsa adama a̱ a̱tsumola̱ngu. Reve a̱ ta̱wa̱ na̱ yira adama a̱ kucci na aturare a̱ ma̱guru adama a na a ca kucci a̱tsuma̱ o u'wa wa̱ A̱sulazuva. <verse eid="JER 41:5" /><verse number="6" style="v" sid="JER 41:6" />Reve Isma'ila ulobo wa Netaniya uta̱ diga a̱ a̱tsuma̱ a Mizfa adama u ga'an ne le, a̱ mesun, adansa, &lt;&lt;Ta̱wa̱i uba̱ta̱ wa Gedaliya ulobo wa Ahikam.&gt;&gt; <verse eid="JER 41:6" /><verse number="7" style="v" sid="JER 41:7" />A mantsa ma na a uwai a̱tsuma̱ a̱ lyuci'i, reve Isma'ila ulobo wa Netaniya na ama a na a̱ ri oɓolo na̱ a̱ yi o una le suru, reve o oco le a̱tsuma̱ a̱ka̱ri.<verse eid="JER 41:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 41:8" />Amma a̱vu ama a kupa diga a̱tsuma̱ ama'a a damma Isma'ila, &lt;&lt;She vu una tsu wan, adama a na tsu ta̱ na̱ asula e izuwa yo oroci a yitabo na̱ yitabo na̱ mani'in ma̱ zetun ni ishiki, a̱ ta̱ ɗe usokowu a̱ a̱ɗuma̱.&gt;&gt; Reve u lyawa le, agba wu una le oɓolo na akapi'i shi. <verse eid="JER 41:8" /><verse number="9" style="v" sid="JER 41:9" />To, agba a̱ka̱ri a na Isma'ila variyi a̱kwa̱kwa̱ a ama a na wu unai'i oɓolo na̱ Gedaliya, a̱ yi ɗa u da̱na̱i a̱ka̱ri a na Mogono Asa ka̱pa̱i adama a mapari e ekere Basha Mogono ma Isra'ila. Reve Isma'ila ulobo wa Netaniya shiton yi na̱ a̱kwa̱kwa̱.<verse eid="JER 41:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 41:10" />Reve Isma'ila pura̱ akapi ama a na a̱ ri a̱tsuma̱ a Mizpa, esheli o mogono oɓolo na aza a na a lyawai a̱tsuma̱ a Mizfa, aza a na Nebuzarada zagbain va̱ a̱za̱ e ipiri zuwai e ekere a Gedaliya ulobo wa Ahikam. Isma'ila ulobo wa Netaniya pura̱ e le ta̱ a̱ tyo tsugbashi, reve u 'yon tsura̱ u pasa a gawan a̱ tyo o upasu wa aza a Amon.<verse eid="JER 41:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 41:11" />Amma a mantsa ma na Yohanan ulobo wa Kareya, oɓolo na a azagbain a̱soja a na a̱ ri oɓolo na̱ a̱ yi a uwwai cu'un vi iwuya i na Isma'ila ulobo wa Netaniya yuwain, <verse eid="JER 41:11" /><verse number="12" style="v" sid="JER 41:12" />reve a̱ pura̱ ama e le suru, adama a̱ 'ya̱wa̱ a yuwan uvon na̱ Isma'ila ulobo wa Netaniya. A̱vu a cina yi o oko'o a gbain a̱tsuma̱ a Gibiyon. <verse eid="JER 41:12" /><verse number="13" style="v" sid="JER 41:13" />A mantsa ma na ama a na a̱ da̱na̱i oɓolo na̱ Isma'ila enei Yohanan ulobo wa̱ Kareya a̱ ta̱wa̱ oɓolo na̱ nan yali ya̱ a̱soja, reve a yuwan ma̱za̱nga̱. <verse eid="JER 41:13" /><verse number="14" style="v" sid="JER 41:14" />A̱vu ama a na Isma'ila pura̱i suru diga a Mizfa a vadala a̱ ka̱mba̱ uba̱ta̱ wa̱ Yohanan ulobo wa̱ Kareya. <verse eid="JER 41:14" /><verse number="15" style="v" sid="JER 41:15" />Amma a̱vu Isma'ila ulobo wa̱ Netaniya oɓolo na ama kunla̱ a̱tsuma̱ a ama a̱ yi a la'a diga ekere a Yohanan, reve a̱ tyo uba̱ta̱ wa aza a Amon.<verse eid="JER 41:15" /></para>
  <para style="s">Ilaɗi a̱ tyo e iɗa ya Masar</para>
  <para style="p">
    <verse number="16" style="v" sid="JER 41:16" />A̱vu Yohanan ulobo wa̱ Kareya oɓolo na̱ nan yali ya̱ a̱soja suru a na a̱ ri oɓolo na̱ yi, a wawa ama a na Isma'ila ulobo wa̱ Netaniya pura̱i diga a Mizfa, cina wu una Gedaliya ulobo wa̱ Ahikam. A̱tsuma̱ le a̱ da̱na̱ ta̱ na̱ a̱soja na̱ a̱ma̱ci na̱ muwun na azagbain o ukobu, a na u ta̱wa̱i ne le diga a̱ lyuci va̱ Gibiyon. <verse eid="JER 41:16" /><verse number="17" style="v" sid="JER 41:17" />Reve a̱ 'yon na̱ a̱ ka̱ra̱ a̱ tyo Masar, a̱vu e isawan a Geru Kimham zuzu na̱ Batalami, <verse eid="JER 41:17" /><verse number="18" style="v" sid="JER 41:18" />adama a na a la'a diga e ekere a̱soja a Babila. A uwwusa ta̱ wovon u le adama a na Isma'ila ulobo wa̱ Netaniya unai Gedaliya ulobo wa̱ Ahikam, za na mogono ma Babila ma̱ shi ma zuwai gwamna vi iɗa'a.<verse eid="JER 41:18" /></para>
  <chapter eid="JER 41" />
  <chapter number="42" style="c" sid="JER 42" />
  <para style="p">
    <verse number="1" style="v" sid="JER 42:1" />Ɗaɗa nan yali ya̱ a̱soja suru, oɓolo na̱ Yohanan ulobo wa̱ Kareya na̱ Yazaniya ulobo wa̱ Hoshaya, oɓolo na ama'a suru, diga a za ke'en a̱ tyo a zagbain a̱ ta̱wa̱i, <verse eid="JER 42:1" /><verse number="2" style="v" sid="JER 42:2" />a̱vu a damma vumava̱sula̱ Irimiya, &lt;&lt;Tsu ta̱ e ipati ya̱ wu vu uwwa mesun ma̱ tsu, vu yuwan avasa a̱ tyo uba̱ta̱ wa̱ A̱sulazuva A̱sula̱ a̱ tsu, adama akapi ama a na a buwai nda'a suru. Adama a na ununa vee e nda'a gogo, ko na wo o'woi tsu da̱na̱ ta̱ a̱bunda̱ ɗe nu ufaru, agba gogo a̱ yi ɗa nda wa'a ɗa tsu buwai. <verse eid="JER 42:2" /><verse number="3" style="v" sid="JER 42:3" />Vu Patiyaa tsu A̱sulazuva A̱sula̱ a̱ tsu, adama u roco tsu ure u na tso toni, oɓolo ni ili i na tsa yuwan.&gt;&gt;<verse eid="JER 42:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 42:4" />A̱vu vumava̱sula̱ Irimiya usu le u damma, &lt;&lt;Mu uwwa ta̱, na amayun n ta yuwan avasa a̱ tyo uba̱ta̱ wa̱ A̱sulazuva A̱sula̱ a̱ tsu ununa i patiyi, waru n ta damma ɗu suru ili i na A̱sulazuva a dammai, agba babu ili i na moo soko ɗu.&gt;&gt;<verse eid="JER 42:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 42:5" />A̱vu ama'a a damma Irimiya &lt;&lt;Lyawa A̱sulazuva wo o'wo tsu e esu a amayun na̱ a̱ɓula̱ a aci a̱ tsu, nna̱ tsu yuwan ulobonu ununa A̱sulazuva A̱sula̱ a̱ tsu a̱ lyungu nuwu vu damma tsu shi. <verse eid="JER 42:5" /><verse number="6" style="v" sid="JER 42:6" />Ko na̱ shi ikaka'a za vu uyo'o ɗa ko nu ri uyo'o shi, tsu ta yuwan tsutoni na̱ A̱sulazuva a̱ A̱sula̱ a̱ tsu, za na tsu lyungu nuwu ya̱'a̱ yi, adama ili i wala tsu mejege, adama a na tsu ta yuwan tsutoni na̱ A̱sulazuva a̱ A̱sula̱ a̱ tsu.&gt;&gt;<verse eid="JER 42:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 42:7" />Ana a yuwain rana kupa, a̱vu A̱sulazuva a yuwan adanshi na̱ Irimiya. <verse eid="JER 42:7" /><verse number="8" style="v" sid="JER 42:8" />Ɗaɗa u ɗeyi Yohanan ulobo wa̱ Kareya, oɓolo na̱ nan yali ya̱ a̱soja a na a̱ ri oɓolo na̱ yi suru, oɓolo na ama suru diga a za ke'en a̱ tyo a zagbain. <verse eid="JER 42:8" /><verse number="9" style="v" sid="JER 42:9" />A̱vu u damma le, &lt;&lt;Apa ili i na A̱sulazuva a̱ A̱sula̱ a Isra'ila a dammai, za na i lyungu numu ya̱'a̱ yi adama n damma yi mesun ma̱ ɗu, u damma ta̱, <verse eid="JER 42:9" /><verse number="10" style="v" sid="JER 42:10" />Nni i da̱nu e iɗa nda, to, n ta suwa ɗu, mo ɓuɓoso ɗu shi. N ta̱ shuwa̱ ɗu, agba ma̱ mula̱ ɗu shi. Adama a na okolo a̱ va̱ a̱ tu ula̱ngu adama e iwuya i na n ta̱wa̱a̱ yi a aci ɗu. <verse eid="JER 42:10" /><verse number="11" style="v" sid="JER 42:11" />She yu uwwa wovon u mogono ma Babila wan, za na gogo ya uwwusa wovon. She yu uwwa wovon wa̱ yi wan, adama a na n ta̱ lo oɓolo na̱ ɗu, n ta wawa ɗu diga e ekere a̱ yi. Ne ɗa A̱sulazuva a dammai. <verse eid="JER 42:11" /><verse number="12" style="v" sid="JER 42:12" />N to roco ɗu iliyali, adama a̱ yi u roco ɗu iliyali, waru u ka̱mba̱to ɗu e iɗa i ɗu. <verse eid="JER 42:12" /><verse number="13" style="v" sid="JER 42:13" />Amma nni i damma, &lt;Tsee e isawan e iɗa i nda shi, i yuwan ta̱ ulambu u tsutoni na̱ A̱sulazuva a̱ A̱sula̱ a̱ tsu.&gt; <verse eid="JER 42:13" /><verse number="14" style="v" sid="JER 42:14" />Agba ni i dammisa, &lt;O'o, tsu ta̱ ka̱ra̱ tsu 'ya̱wa̱ tsu da̱nu e iɗa ya Masar, uba̱ta̱ u na tse ene uvon ko tsu uwwa mesun ma avana shi, ko tsu uwwa ambulu shi,&gt; &gt;&gt; <verse eid="JER 42:14" /><verse number="15" style="v" sid="JER 42:15" />&lt;&lt;to, gogo uwwai adanshi A̱sulazuva, a̱ɗu akapi ama a Yahuda. A̱sulazuva o oɓolo a̱ a̱soja a zuva a̱ A̱sula̱ a Isra'ila a damma ta̱, &lt;Nni izuwa ta̱ okolo a na ya̱a̱ 'ya̱wa̱ Masar, reve waru i ka̱ra̱ i 'ya̱wa̱ i da̱nu ɗe, <verse eid="JER 42:15" /><verse number="16" style="v" sid="JER 42:16" />to, matsun me pe'eni ma na yaa uwwusa wovon wa̱ yi'i u ta cina ɗu ɗe, waru ambulu a na i ri e ilaɗi'i u ta̱ toni ɗu a̱ tyo Masar, waru ɗe ɗa ya̱ kuwa̱. <verse eid="JER 42:16" /><verse number="17" style="v" sid="JER 42:17" />Na amayun, aza a na a zuwai okolo a na a̱ 'ya̱wa̱ Masar a̱ da̱nu ɗe, a̱ ta̱ kuwa̱ a̱tsuma̱ o ure u matsun me pe'eni na ambulu na̱ mɓa̱la̱. Babu vuma na a̱ da̱na̱ wuma ko u la'a diga addama a na ma̱a̱ ta̱wa̱a̱ a aci e le.&gt; &gt;&gt;<verse eid="JER 42:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 42:18" />&lt;&lt;Adama a na apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva a̱ A̱sula̱ a Isra'ila dammai, ununa moo ocoyi upan u va̱ nu upan wu usuɗuwu u va̱ a̱ nda̱na̱ta̱ ma̱ Urishelima, ne ɗa moo oco upan wu usuɗuwu u va̱ aciya̱ɗu, nni i ka̱ra̱ a̱ tyo Masar. I to o'wo ili i na a yuwaan una̱ ni ili i wovon, ili yi idaba ni ili yi izo'oshi, waru ya̱a̱ da̱shi ene uba̱ta̱ u nda shi. <verse eid="JER 42:18" /><verse number="19" style="v" sid="JER 42:19" />A̱ɗu akapi ama a Yahuda a na a buwai, uwwai ili na A̱sulazuva a dammai adama a̱ ɗu. &lt;She i ka̱ra̱ a̱ tyo Masar wan!&gt; I gura reve na̱ a̱ yi nda, na n rono nɗu atsuvu! <verse eid="JER 42:19" /><verse number="20" style="v" sid="JER 42:20" />I yuwan ta̱ a̱ba̱jini o unusu, a mantsa ma na a̱ɗu na aciya̱ɗu i lyungu numu uba̱ta̱ wa̱ A̱sulazuva a̱ A̱sula̱ a̱ tsu, waru a̱vu i damma mu, &lt;Vu Patiyaa tsu A̱sulazuva A̱sula̱ a̱ tsu, waru vu damma tsu ili i na u damma nuwu suru, tsu ta̱ gba a yuwan ulinga na̱ a̱ yi.&gt; <verse eid="JER 42:20" /><verse number="21" style="v" sid="JER 42:21" />Agba a̱ yi ɗa nda n damma n ɗu ana'an, amma hali n gogo i yuwan tsutoni na̱ A̱sulazuva a̱ A̱sula̱ a̱ tsu, a̱tsuma̱ e ili i na u lyungu numu n damma ɗu shi. <verse eid="JER 42:21" /><verse number="22" style="v" sid="JER 42:22" />To, gogo she i reve ni ili i nda, i ta̱ kuwa̱ a̱tsuma̱ o ure u matsun me pe'eni, na ambulu na̱ mɓa̱la̱ a̱ tyo uba̱ta̱ u na i cigai i 'ya̱wa̱ i da̱nu.&gt;&gt;<verse eid="JER 42:22" /></para>
  <chapter eid="JER 42" />
  <chapter number="43" style="c" sid="JER 43" />
  <para style="p">
    <verse number="1" style="v" sid="JER 43:1" />A mantsa ma na Irimiya kotoi adansaa ama a nda suru idanshi i na A̱sulazuva a̱ A̱sula̱ e le a̱ lyungu niyi u damma le, <verse eid="JER 43:1" /><verse number="2" style="v" sid="JER 43:2" />a̱vu Azariya ulobo wa̱ Hoshaya na̱ Yohanan ulobo wa̱ Kareya na ali a na a̱ ri ugbawu suru a damma Irimiya, &lt;&lt;Epen ɗa vaa yuwusan! A̱sulazuva A̱sula̱ a̱ tsu a̱ lyungu wu vu damma, &lt;She tsu ka̱ra̱ tsu 'ya̱wa̱ Masar tsu da̱nu ɗe shi!&gt; <verse eid="JER 43:2" /><verse number="3" style="v" sid="JER 43:3" />Amma Baruk ulobo wa Neriya ɗa a̱a̱ da̱shishi wu a aci a̱ tsu, adama vu ca tsu e ekere a̱soja a Babila, adama o una tsu, ko gba shi a̱ ka̱ra̱ na̱ tsu a̱ tyo e iɗa ya Babila tsugbashi!&gt;&gt; <verse eid="JER 43:3" /><verse number="4" style="v" sid="JER 43:4" />Reve Yohanan ulobo wa̱ Kareya, oɓolo na̱ nan yali ya̱ a̱soja, na akapi a ama'a suru a 'yuwan a yuwan tsutoni nu udammu wa̱ A̱sulazuva a na a̱ da̱nu a̱tsuma̱ e iɗa ya Yahuda. <verse eid="JER 43:4" /><verse number="5" style="v" sid="JER 43:5" />O una̱ u ndolo, a̱vu Yohanan ulobo wa̱ kareya oɓolo na̱ nan yali ya̱ a̱soja'a a̱ pura̱ akapi a ama a Yahuda'a, aza a na a̱ ka̱mba̱i adama a̱ da̱nu a̱tsuma̱ a Yahuda diga a̱tsuma̱ a nɗa nna a̱ shi a̱ gba̱ra̱ nle a̱ tyo. <verse eid="JER 43:5" /><verse number="6" style="v" sid="JER 43:6" />Reve fo a̱ pura̱ ali suru, na̱ a̱ma̱ci na̱ muwun ne esheli o mogono, aza a na Nebuzarada zagbain va aza a na a yuwusan ipiri i mogono shi lyawai e ekere a Gedaliya ulobo wa Ahikam ulobo wa Shafa, oɓolo na̱ Irimiya vumava̱sula̱ na̱ Baruk ulobo wa Neriya. <verse eid="JER 43:6" /><verse number="7" style="v" sid="JER 43:7" />Adama o ndolo reve a uwa Masar a̱tsuma̱ o ure wu ulambu wa̱ a̱ɓula̱ a̱ tyo e ekere a̱ A̱sulazuva, hali fo acina lyuci va Tapanes. <verse eid="JER 43:7" /><verse number="8" style="v" sid="JER 43:8" />Ɗe a̱tsuma̱ Tapanes a̱ A̱sulazuva a yuwan ta̱ adanshi na̱ Irimiya u damma, <verse eid="JER 43:8" /><verse number="9" style="v" sid="JER 43:9" />&lt;&lt;Vu pura̱ aatali a gbagbain o ukere wa̱ wu, a̱vu vu ciɗo le uba̱ta̱ u na a̱ ru'wa̱i wu udasata wu una̱ntsu wu uwata wu u'wa u mogono Firi'awuna a̱ lyuci va Tapanes. Vu yuwan ne e esu a ama a Yahuda.&gt;&gt; <verse eid="JER 43:9" /><verse number="10" style="v" sid="JER 43:10" />Reve vu damma le, &lt;&lt;Apa ili i na a̱ A̱sulazuva o oɓolo a̱ a̱soja a zuva a̱ A̱sula̱ a Isra'ila dammai, ka̱lyuwa̱, n ta̱ lyunguwa̱a̱ aagbashi a̱ va̱ mogono Nebukanaza va Babila ta̱wa̱ uba̱ta̱ u nda. Waru n ta̱ shuwa̱ Ootogu o tsugono tsa̱ yi zuva va atali a nda a na Irimiya soko yi. Nebukanaza gba ta̱ shuwa̱ a̱ba̱jini Oogodo o tsugono tsa̱ yi uba̱ta̱'a̱. <verse eid="JER 43:10" /><verse number="11" style="v" sid="JER 43:11" />U ta̱ ta̱wa̱ u lyuwa Masar nu uvon, u ta̱ ta̱wa̱ nu ukwa̱ e ekere aza a na a zuwai na̱ ukwa̱, na̱ nde n tsugbashi e ekere aza a zuwai na̱ a̱ 'ya̱wa̱ tsugbashi, oɓolo na̱ matsun me pe'eni e ekere aza a na a zuwai na̱ kuwa̱ na̱ matsun me pe'eni. <verse eid="JER 43:11" /><verse number="12" style="v" sid="JER 43:12" />U ta̱ kula̱to a̱a̱'isa̱ a̱ musula̱ mi iɗa ya Masar, agba u ta̱ kula̱to musula̱ n le a̱vu u pura̱ musula̱ n le a̱ tyo tsugbashi. Ununa za va aguɓa tsu ka̱nda̱'wa̱ aapalutsu a̱ yi uka̱nda̱ruwu na̱ yi, ne ɗa wa̱ ka̱nda̱'wa̱ Masar reve u 'yon u ka̱ra̱ gbaga. <verse eid="JER 43:12" /><verse number="13" style="v" sid="JER 43:13" />U to ɓuɓoso a̱a̱'isa̱ o urana a na a̱ ri pe a̱tsuma̱ a Masar, a̱vu u kototo a atsura a akiza, reve u kula̱to a̱'isa̱ a̱ musula̱ ma Masar.&gt;&gt;<verse eid="JER 43:13" /></para>
  <chapter eid="JER 43" />
  <chapter number="44" style="c" sid="JER 44" />
  <para style="s">Addama adama a̱ga̱nda̱ a̱ a̱ma̱li</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 44:1" />Adanshi a nda a̱ ta̱wa̱ ta̱ ya̱ Irimiya adama a ama a Yahuda a na a̱ ri nden a̱tsuma̱ e iɗa ya Masar va̱ Za̱la̱ na̱ Megido na̱ Takifanke na̱ Memfis oɓolo na̱ Masar vo Gon. <verse eid="JER 44:1" /><verse number="2" style="v" sid="JER 44:2" />&lt;&lt;Apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva a̱ A̱sula̱ a Isra'ila dammai, yee ene ta̱ cu'un va̱a̱ a̱ba̱jini addama a na n ta̱wa̱yi Urishelima oɓolo ni ilyuci ya Yahuda suru, waru a̱yi ɗa nda ana'an o o'woi okongo waru babu za, <verse eid="JER 44:2" /><verse number="3" style="v" sid="JER 44:3" />adama e iwuya i le. A zuwa mu ta̱ n yuwan upan a̱tsuma̱ o ure wu ukula̱tosu wa̱ a̱tsuka̱ a̱ ma̱guru wa̱ a̱ga̱nda̱ uba̱ta̱ u musula̱ n ro, musula̱ nna ele, ko nkaya nle e revei shi. <verse eid="JER 44:3" /><verse number="4" style="v" sid="JER 44:4" />N da̱na̱ ta̱ a̱a̱ lyungusa̱a̱ le na agbashi a̱ va̱ ama̱sula̱ kuci adansa, &lt;She i yuwan ili yi idaba i ndolo i na A̱sulazuva a 'yuwain wan!&gt; &gt;&gt; <verse eid="JER 44:4" /><verse number="5" style="v" sid="JER 44:5" />Agba a uwwa shi, ko o polo atsuvu e le, a vadala diga a̱tsuma̱ e iwuya i le shi. Ko a lyawa ukula̱tosu wa̱ a̱tsuka̱ a̱ ma̱guru uba̱ta̱ u musula̱ n ro shi. <verse eid="JER 44:5" /><verse number="6" style="v" sid="JER 44:6" />Adama o ndolo a ɗa upan u va̱ wu usuɗuwu, u cipa̱i a aci e ilyuci ya Yahuda, oɓolo na̱ re va̱ Urishelima. A̱vu n ka̱mba̱to le okongo ununa a̱ ri ana'an. <verse eid="JER 44:6" /><verse number="7" style="v" sid="JER 44:7" />To, agba gogo, apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva a̱ A̱sula̱ a Isra'ila a dammai, adama a̱ nye i ronoyi aciya̱ɗu cu'un va̱ a̱ba̱jini va̱ a̱tsuma̱lima̱ a nda? Nye i zuwai yu uta̱a̱ yi ali na̱ a̱ma̱ci na̱ muwun na̱ nreɓu diga a̱tsuma̱ a Yahuda a̱ tyo Masar, hali na wo o'wo babu za na a la'a? <verse eid="JER 44:7" /><verse number="8" style="v" sid="JER 44:8" />Nye i zuwai yaa zuwusa mu upan adama a linga ve ekere a̱ ɗu, na ya̱a̱ kula̱tosu a̱tsuka̱ a̱ ma̱guru a̱ tyo uba̱ta̱ u musula̱ n ro a̱tsuma̱ a Masar, uba̱ta̱ u na i ta̱wa̱i adama a na ya̱a̱ da̱nu? I to o una aciya̱ɗu, reve waru i ka̱mba̱to aciya̱ɗu ili i na a yuwayin una̱, ni ili i wisulusa e ekere a nɗa mu uvaɗi ma̱ɓula̱. <verse eid="JER 44:8" /><verse number="9" style="v" sid="JER 44:9" />Ko yi icina ta̱ na̱ linga vi iwuya vu nkaya nɗu oɓolo na̱ a̱za̱ o ngono na̱ nan egbere a Yahuda, oɓolo ni iwuya ya̱ a̱ma̱ci e le, ni iwuya i ɗu ni iwuya ya̱ a̱ma̱ci ɗu, aza a na i yuwain e iɗa ya Yahuda oɓolo na̱ re va̱ Urishelima? <verse eid="JER 44:9" /><verse number="10" style="v" sid="JER 44:10" />Hali acina ana'an i ka̱ɗa̱to aci ya̱ ɗu, ko i ca mu tsugbain shi, ko i yuwan tsutoni na̱ wila̱ u va̱ nu udammu u va̱ na n ca ɗu, a̱ɗu na̱ nkaya n ɗu shi.<verse eid="JER 44:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 44:11" />&lt;&lt;Adama o ndolo, apa ili i na A̱sulazuva o oɓolo a̱soja a zuva A̱sula̱ a Isra'ila dammai, n ta̱ e ifoɓi i na ma̱a̱ ta̱wa̱a̱ a̱ɗu, a̱ɗu aza a Yahuda suru na̱ a̱tsuma̱lima̱ nu ukototosu. <verse eid="JER 44:11" /><verse number="12" style="v" sid="JER 44:12" />N to kototo akapi a ama a Yahuda, ele a na a zuwai aci adama a̱ nden a̱tsuma̱ e iɗa ya Masar. Suru n le a̱ ta̱ kuwa̱ ɗe, a̱ ta̱ kuwa̱ a̱tsuma̱ o ure u matsun me pe'eni ko a̱ kuwa̱ na ambulu. Diga a za ke'en a̱ tyo a zagbain a̱ ta̱ kuwa̱ a̱tsuma̱ o ure u matsun me pe'eni na ambulu. O to o'wo ili ye pere ni ili i wovon, ni ili i na a yuwayin una̱ ni ili i wisulusa. <verse eid="JER 44:12" /><verse number="13" style="v" sid="JER 44:13" />N ta ca aza a na a̱ ri nden a̱tsuma̱ e iɗa ya Masar oforo, ununa n cayi Urishelima oforo na̱ matsun me pe'eni na ambulu na̱ mɓa̱la̱. <verse eid="JER 44:13" /><verse number="14" style="v" sid="JER 44:14" />Babu za ro diga a̱tsuma̱ akapi a ama a Yahuda na 'ya̱wa̱i Masar na̱ a̱ da̱na̱ wuma ko u la'a na wa̱ ka̱mba̱ e iɗa ya Yahuda, za na a̱a̱ da̱na̱ a maluwa ma na a̱ ka̱mba̱ a̱ da̱nu, babu za na a̱ ka̱mba̱ she de ke'en na la'ai.&gt;&gt;<verse eid="JER 44:14" /></para>
  <para style="s">Ama aa zuwaa ikaka ya̱ A̱sulazuva atsuvu shi</para>
  <para style="p">
    <verse number="15" style="v" sid="JER 44:15" />Ɗaɗa ali a na suru e revei a na a̱ma̱ci e le a̱ kula̱tosa̱a̱ musula̱ n ro a̱tsuka̱ a̱ ma̱guru, oɓolo na̱ a̱ma̱ci a na a̱ ri pe a̱tsuma̱ a̱ba̱jini e iɓolo'o, oɓolo na ama a na suru a̱ ri nden a̱tsuma̱ a Masar vo Gon na̱ Za̱la̱, a dammai Irimiya, <verse eid="JER 44:15" /><verse number="16" style="v" sid="JER 44:16" />&lt;&lt;Tsoo polo atsuvu tsu uwwa ikaka ya adanshi a̱tsuma̱ ala A̱sulazuva a na vu damma n tsu shi! <verse eid="JER 44:16" /><verse number="17" style="v" sid="JER 44:17" />Na amayun tsu ta yuwan ili i na tsu cigai. Tsu ta ca kucci vi ili i ma̱guru a̱ tyo e iroci yi ka ndolo ma̱sula̱ ma na a̱ tsu ɗe Egbere va Zuva, tsu ta ca yi kucci vi ili yo oso, ununa a̱tsu na̱ nkaya n tsu na̱ ngono n tsu na azagbain a̱ tsu, tsa yuwusan a̱tsuma̱ e ilyuci ya Yahuda na̱ a̱tsuma̱ a̱ re va̱ Urishelima. A mantsa mo ndolo tsu da̱na̱ ta̱ ni ilyalya lon, reve tsu tsura̱ utsuru waru babu ili i na i damaton n tsu. <verse eid="JER 44:17" /><verse number="18" style="v" sid="JER 44:18" />Amma diga a mantsa ma na tsu lyawai a̱ kula̱tosa̱a̱ ma̱sula̱ ma na a̱ tsu ɗe Egbere va Zuva a̱tsuka̱ a̱ ma̱guru na̱ kucci vi ili yo oso, ɗaɗa tsu lambai ili biti, a̱vu tsu reme tsu kuwa̱ a̱tsuma̱ o ure u matsun me pe'eni na ambulu.&gt;&gt;<verse eid="JER 44:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 44:19" />A̱vu a̱ma̱ci a̱ da̱shi damma, &lt;&lt;A mantsa ma na tsu cayi kucci va̱ a̱tsuka̱ a̱ ma̱guru na̱ kucci vi ili yo oso a̱ tyo uba̱ta̱ u ma̱sula̱ ma na a̱ tsu ɗe Egbere va Zuva, ashe ali a̱ tsu e reve a na tsa yuwusan emeshen a̱tsuma̱ e iroci yi ka'a hali na tsa casu yi kucci vi ili yo oso shi?&gt;&gt;<verse eid="JER 44:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 44:20" />A̱vu Irimiya damma ama'a suru, ali na̱ a̱ma̱ci aza a na a ca niyi u'usuwu u nda u damma, <verse eid="JER 44:20" /><verse number="21" style="v" sid="JER 44:21" />&lt;&lt;A majiyan ma̱ ɗu, A̱sulazuva e reve ko u cuwan na̱ kucci va̱ a̱tsuka̱ a̱ ma̱guru nna i cayi a̱tsuma̱ e ilyuci ya Yahuda na̱ a̱tsuma̱ a̱ re va̱ Urishelima, na̱ a̱ɗu na̱ nkaya nɗu na̱ ngono nɗu na azagbain a̱ɗu, na ama e iɗa'a shi? <verse eid="JER 44:21" /><verse number="22" style="v" sid="JER 44:22" />Amma na wo o'woi A̱sulazuva a gura kaɓa asuvu adama a linga vi iwuya na̱ linga vi idaba na i yuwain shi, ɗaɗa iɗa i ɗu yo o'woi ili i na a yuwayin una̱ no okongo, waru babu pe za, ununa u ri ana'an. <verse eid="JER 44:22" /><verse number="23" style="v" sid="JER 44:23" />Adama a na i kula̱toi a̱tsuka̱ a̱ ma̱guru, waru a̱vu i yuwaan A̱sulazuva unusu agba i yuwan yi tsutoni shi, ko i kuru wila̱ wa̱ yi ko udammu wa̱ yi ko ili i na u zuwai shi, ɗaɗa gba addama a nda a cina nɗu, ununa yee enei nda'a.&gt;&gt;<verse eid="JER 44:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 44:24" />Ɗaɗa Irimiya dammai ama'a suru, oɓolo na̱ a̱ma̱ci'i, &lt;&lt;Uwwai adanshi a̱ A̱sulazuva suru nɗu ama a Yahuda a̱ɗu na i ri a̱tsuma̱ e iɗa ya Masar. <verse eid="JER 44:24" /><verse number="25" style="v" sid="JER 44:25" />Apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva a̱ A̱sula̱ a Isra'ila dammai, a̱ɗu na̱ a̱ma̱ci a̱ɗu i roco ta̱ a̱tsuma̱ o ure u ɗu na i kucinai na i dammai, &lt;Na amayun tsu to shiton akucunu a na tsu yuwain na tsa ca kucci va̱ a̱tsuka̱ a̱ ma̱guru oɓolo na̱ kucci vi ili yo oso a̱ tyo uba̱ta̱ u ma̱sula̱ ma na a̱ tsu ɗe Egbere va Zuva.&gt; &gt;&gt; To, she i lyuwa elime, i shiton akucunu'u! I shiton akucunu a̱ ɗu!<verse eid="JER 44:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JER 44:26" />&lt;&lt;Amma gogo yu uwwa adanshi a na A̱sulazuva a dansa, ama a Yahuda a na a̱ ri nden a̱tsuma̱ e iɗa ya Masar suru, n kucuna ta̱ na ala a̱ va̱ adansa, ko vuma ta̱ a̱tsuma̱ a aza a Yahuda a na a̱ ri a̱tsuma̱ e iɗa ya Masar a̱a̱ da̱shi ɗe ala a̱ va̱ ko u kucuna adansa, &lt;Nna̱ a̱ A̱sulazuva Mogono me Ili suru ri wuma&gt; &gt;&gt; shi. <verse eid="JER 44:26" /><verse number="27" style="v" sid="JER 44:27" />Adama a na n zuwaa le ta̱ esu adama e ifoɓi yi iwuya, agba yi isa'ani shi, ama a Yahuda a na a̱ ri nden a̱tsuma̱ e iɗa ya Masar suru a̱ ta̱ kuwa̱ a̱tsuma̱ o ure u matsun me pe'eni na ambulu hali she no o kototo le suru suru. <verse eid="JER 44:27" /><verse number="28" style="v" sid="JER 44:28" />Aza a na waru a la'ai diga o ukwa̱ u matsun me pe'eni, reve a̱ ka̱mba̱ a̱tsuma̱ e iɗa ya Masar o to o'wo wa'a goon. Ɗaɗa akapi ama a Yahuda aza a na a̱ ta̱wa̱i adama a̱ da̱nu a̱tsuma̱ a Masar ee reve a na adanshi a̱ zane ɗa a shiwan, za va̱ ko za le. <verse eid="JER 44:28" /><verse number="29" style="v" sid="JER 44:29" />Ili ya nda i to o'wo ɗu iroci i na ma ca ɗu oforo uba̱ta̱ u nda, ne ɗa A̱sulazuva a dammai, to, gogo she i reve adanshi a na n yuwain na ma̱a̱ ta̱wa̱a̱ ɗu na addama u ta shiwan na amayun. <verse eid="JER 44:29" /><verse number="30" style="v" sid="JER 44:30" />Apa ili i na A̱sulazuva a dammai, &lt;&lt;Na amayun n ta ca Firi'awuna va Hofira mogono ma Masar e ekere a n'yuwatan ma̱ yi aza a na aa zama wuma wa̱ yi, ununa n cayi mogono Zedekiya va Yahuda e ekere o mogono Nebukanaza va Babila ma'yuwatan ma̱ yi, za na da̱na̱i a zama wuma wa̱ yi.&gt;&gt;<verse eid="JER 44:30" /></para>
  <chapter eid="JER 44" />
  <chapter number="45" style="c" sid="JER 45" />
  <para style="s">Ikaka a̱ tyo ya Baruk</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 45:1" />Apa ikaka i na Irimiya vumava̱sula̱ dammai Baruk ulobo wa̱ Neriya, a̱tsuma̱ a aa'wan a̱ na̱shi o tsugono tso mogono Jehoyakim va Yahuda ulobo wa̱ Josiya cina Baruk ɗana a̱tsuma̱ a aatagada o ukutsuluwu wi idanshi i na Irimiya dansaa niyi ana, <verse eid="JER 45:1" /><verse number="2" style="v" sid="JER 45:2" />&lt;&lt;Apa ili A̱sulazuva A̱sula̱ a Isra'ila a dansa adama a̱ wu Baruk, <verse eid="JER 45:2" /><verse number="3" style="v" sid="JER 45:3" />vu damma ta̱, &lt;A̱tsuma̱lima̱ a cina mu ta̱! A̱sulazuva a̱ da̱shi mu ta̱ a̱tsuma̱lima̱ zuva va atakaci a̱ va̱! N kuna̱ ta̱ na̱ ma̱nga̱, waru n ri na̱ wivuwun shi!&gt; &gt;&gt; <verse eid="JER 45:3" /><verse number="4" style="v" sid="JER 45:4" />To, &lt;&lt;A̱sulazuva a damma mu ta̱ n damma wu, &lt;apa ili i na A̱sulazuva a dammai, n ta̱ ɓuɓoso ili i na n suwai, reve waru n mula̱ ili i na n shuwa̱i, a̱tsuma̱ e iɗa'a ma̱ɓula̱. <verse eid="JER 45:4" /><verse number="5" style="v" sid="JER 45:5" />Gogo wuntsaa ta̱ vu zami utsuru wu uvaɗi ɗa? She vu zami le wan. Adama a na n ta̱ lyungu a̱tsuma̱lima̱ a aci a vaɗilima̱ suru, ne ɗa A̱sulazuva a dammai. Amma suru uba̱ta̱ u na vu tyoyi, n ta ca wu wuma wa̱ wu fa̱a̱n tsi itana i na a̱ pura̱i uba̱ta̱ o uvon.&gt; &gt;&gt;<verse eid="JER 45:5" /></para>
  <chapter eid="JER 45" />
  <chapter number="46" style="c" sid="JER 46" />
  <para style="s">Ikaka a̱ tyo a nɗa, za vu ufaru a̱ tyo Masar</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 46:1" />Apa adanshi a na a̱ A̱sulazuva a dammai vumava̱sula̱ Irimiya adama a nɗa.<verse eid="JER 46:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 46:2" />Adama e iɗa ya Masar. Apa ikaka adama a̱soja a Firi'awuna Neko mogono ma Masar, za na mogono Nebukanaza va Babila ma lyuwai nu uvon a̱tsuma̱ e iɗa ya Karkemi na ri zuzu nu Uɗolu wa̱ Yufiriti a̱tsuma̱ a aa'wan a̱ na̱shi o tsugono tso mogono Jehoyakim ulobo wa Josiya mogono ma Yahuda.<verse eid="JER 46:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="JER 46:3" />Reve a̱soja a Masar a̱ 'ya̱sa̱n uɗyo a damma,</para>
  <para style="q2" vid="JER 46:3">&lt;&lt;Foɓoi a̱ra̱ga̱ a̱ ɗu zagbain na̱ za ke'en,</para>
  <para style="q2" vid="JER 46:3">i foɓo yu uta̱ adama o uvon!<verse eid="JER 46:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 46:4" />I Foɓo ido,</para>
  <para style="q2" vid="JER 46:4">i zuwaa le rutsu!</para>
  <para style="q1" vid="JER 46:4">Yi isawan ba̱ta̱ ɗu</para>
  <para style="q2" vid="JER 46:4">wotowu na̱ nlezu mi irumu,</para>
  <para style="q1" vid="JER 46:4">I tewen mbata n ɗu!</para>
  <para style="q2" vid="JER 46:4">Yo oto itana yu uvon!<verse eid="JER 46:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 46:5" />Nye ɗa mee nda nda'a?</para>
  <para style="q2" vid="JER 46:5">Okolo e le a kuɗa ta̱,</para>
  <para style="q1" vid="JER 46:5">o to ronoso na̱ a̱ca̱pa̱,</para>
  <para style="q2" vid="JER 46:5">a lyuwa ta̱ a̱soja e le,</para>
  <para style="q1" vid="JER 46:5">reve a suma kaukau,</para>
  <para style="q2" vid="JER 46:5">agba a vadala ucina̱ shi,</para>
  <para style="q2" vid="JER 46:5">adama a na wovon u ɓa̱ru le ta̱ uba̱ta̱ suru.&gt;&gt;</para>
  <para style="qr" vid="JER 46:5">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 46:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 46:6" />&lt;&lt;Aza a na a gurai ilaɗi</para>
  <para style="q2" vid="JER 46:6">a gura suma shi,</para>
  <para style="q1" vid="JER 46:6">aza a na a la'ai ucira</para>
  <para style="q2" vid="JER 46:6">a la'a shi.</para>
  <para style="q1" vid="JER 46:6">A̱ ta̱ɗa̱tsa̱ ta̱ a̱ riya̱ a̱ mɓa̱nga̱</para>
  <para style="q2" vid="JER 46:6">mu Uɗolu wa̱ Yufiriti wu ugana.<verse eid="JER 46:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 46:7" />Zane ɗa gba nda'a a̱ 'yosun</para>
  <para style="q2" vid="JER 46:7">she damma mini mo uɗolu wa̱ Nilu,</para>
  <para style="q2" vid="JER 46:7">tso ɗolu na mini me le ma shiwain lon?<verse eid="JER 46:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 46:8" />Masar ɗa a̱ 'yosun she damma uɗolu wa̱ Nilu,</para>
  <para style="q2" vid="JER 46:8">tso ɗolu na mini me le ma̱ ri a̱ ma̱gugwa̱,</para>
  <para style="q1" vid="JER 46:8">adansa, &lt;N ta̱ 'yon m ɓa̱ru uvaɗi ma̱ɓula̱,</para>
  <para style="q2" vid="JER 46:8">n to kototo ilyuci oɓolo na ama le suru.&gt; &gt;&gt;<verse eid="JER 46:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 46:9" />&lt;&lt;'Yoyin nu usuɗu, a̱ɗu Ido!</para>
  <para style="q2" vid="JER 46:9">I 'yon ni ilaɗi,</para>
  <para style="q2" vid="JER 46:9">a̱ɗu na yoo ronoso ikeke yi ido!</para>
  <para style="q1" vid="JER 46:9">I da̱na̱ o uta̱sa̱ a̱ɗu a̱soja a̱ Kush na̱ Lud</para>
  <para style="q2" vid="JER 46:9">aza a na a̱ guzusa̱ a̱ra̱ga̱,</para>
  <para style="q1" vid="JER 46:9">i da̱na̱ o uta̱sa̱ a̱ɗu a̱soja a̱ lyuci va Lidiya,</para>
  <para style="q2" vid="JER 46:9">aza a na a gurai uvon na aya.<verse eid="JER 46:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 46:10" />Adama a na urana u ndolo urana wu Zagbain ɗa</para>
  <para style="q2" vid="JER 46:10">urana wa̱ A̱sulazuva o oɓolo a̱ a̱soja a zuva,</para>
  <para style="q1" vid="JER 46:10">urana wa atsupu,</para>
  <para style="q2" vid="JER 46:10">atsupu a aci a n'yuwatan ma̱ yi.</para>
  <para style="q1" vid="JER 46:10">Matsun me pe'eni ma̱ ta̱ sowo mpasa,</para>
  <para style="q2" vid="JER 46:10">hali u cuwa̱n,</para>
  <para style="q2" vid="JER 46:10">hali she nu u tawa akuli.</para>
  <para style="q1" vid="JER 46:10">Adama a na Zagbain,</para>
  <para style="q2" vid="JER 46:10">A̱sulazuva oɓolo a̱ a̱soja a zuva</para>
  <para style="q2" vid="JER 46:10">a ta ca kucci e iɗa yu upasu wu ugana</para>
  <para style="q2" vid="JER 46:10">zuzu nu Uɗolu wa̱ Yufiriti.&gt;&gt;<verse eid="JER 46:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 46:11" />&lt;&lt;Vu ka̱ra̱ agawan a̱ tyo Giliyadu vu ushi a̱guma̱,</para>
  <para style="q2" vid="JER 46:11">a̱vu Usheli u va̱ Masar na koto u revei vali shi.</para>
  <para style="q1" vid="JER 46:11">Ili ye pere i ɗa vu yuwan ulinga na̱ a̱guma̱,</para>
  <para style="q2" vid="JER 46:11">adama a na va̱a̱ tsura̱ opocino shi.<verse eid="JER 46:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 46:12" />Nɗa n ta̱ tsura̱</para>
  <para style="q2" vid="JER 46:12">aɗa a labari o wono a na vu sowoi,</para>
  <para style="q2" vid="JER 46:12">mesun ma̱ wu mo to shiton uvaɗi.</para>
  <para style="q1" vid="JER 46:12">Soja ta ga'an na̱ soja,</para>
  <para style="q2" vid="JER 46:12">reve e le ra a̱ riya̱ oɓolo.&gt;&gt;<verse eid="JER 46:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 46:13" />Apa adanshi a na a̱ A̱sulazuva a dammai vumava̱sula̱ Irimiya adama o uta̱wu u mogono Nebukanaza va Babila adama u yuwan uvon ni iɗa ya Masar.<verse eid="JER 46:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JER 46:14" />&lt;&lt;Vu damma aɗa a nda a̱tsuma̱ e iɗa ya Masar,</para>
  <para style="q2" vid="JER 46:14">reve fo vu cuɗuwai a̱tsuma̱ a̱ lyuci va Megido,</para>
  <para style="q1" vid="JER 46:14">a̱vu fo vu damma yi a̱tsuma̱ a̱ lyuci va̱ Memfis</para>
  <para style="q2" vid="JER 46:14">na̱ a̱tsuma̱ a̱ lyuci va Takifanke.</para>
  <para style="q1" vid="JER 46:14">&lt;Yi isawan ulobonu a̱vu i foɓo,</para>
  <para style="q2" vid="JER 46:14">adama a na matsun me pe'eni ma ta lyuwusa</para>
  <para style="q2" vid="JER 46:14">aza a na a̱ ri uka̱nda̱ruwu na̱ a̱ɗu.&gt;<verse eid="JER 46:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 46:15" />Nye i zuwai o o'woto</para>
  <para style="q2" vid="JER 46:15">ali o uvon a̱ wu tsunda?</para>
  <para style="q1" vid="JER 46:15">A gura e isawan shi,</para>
  <para style="q2" vid="JER 46:15">adama a na A̱sulazuva</para>
  <para style="q2" vid="JER 46:15">e te keɓe le a̱ tyo e iɗa.<verse eid="JER 46:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 46:16" />A̱ ta̱ da̱na̱ a̱ ta̱ɗa̱tsa̱ kuci,</para>
  <para style="q2" vid="JER 46:16">reve za suru riya̱ zuva vu za va̱ a̱yi.</para>
  <para style="q1" vid="JER 46:16">A̱ ta̱ da̱na̱ adansa,</para>
  <para style="q2" vid="JER 46:16">&lt;Tsu 'Yoyin tsu ka̱mba̱ uba̱ta̱ wa ama a̱ tsu,</para>
  <para style="q2" vid="JER 46:16">tsu ka̱mba̱ e iɗa yu umatsun u tsu,</para>
  <para style="q2" vid="JER 46:16">tsu sumaa matsun me pe'eni ma n'yuwatan n tsu.&gt;<verse eid="JER 46:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 46:17" />Ɗe ɗa a̱ 'ya̱sa̱n uɗyo a damma,</para>
  <para style="q2" vid="JER 46:17">&lt;Firi'awuna mogono ma Masar</para>
  <para style="q2" vid="JER 46:17">she uguru wu una̱,</para>
  <para style="q2" vid="JER 46:17">hali u lamba ili na̱ a̱bunda̱!&gt; &gt;&gt;<verse eid="JER 46:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JER 46:18" />&lt;&lt;Nna̱ hali n ri wuma,&gt;&gt;</para>
  <para style="q2" vid="JER 46:18">ne ɗa Mogono ma dammai,</para>
  <para style="q1" vid="JER 46:18">za na aala a̱ yi ɗa</para>
  <para style="q2" vid="JER 46:18">A̱sulazuva oɓolo a̱ a̱soja a zuva,</para>
  <para style="q2" vid="JER 46:18">&lt;&lt;Nanza to o uta̱ diga</para>
  <para style="q2" vid="JER 46:18">a̱tsuma̱ a Tabo a̱tsuma̱ a nsasan,</para>
  <para style="q2" vid="JER 46:18">oroci a masasan ma Kame zuzu na̱ mala.<verse eid="JER 46:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 46:19" />I goloɓo itana i ɗu</para>
  <para style="q2" vid="JER 46:19">i foɓo a na ya̱a̱ tyo tsugbashi</para>
  <para style="q2" vid="JER 46:19">a̱ɗu na i ri nde a̱tsuma̱ a Masar,</para>
  <para style="q1" vid="JER 46:19">adama a na lyuci va̱ Memfis to o'wo ofoli,</para>
  <para style="q2" vid="JER 46:19">no okongo uba̱ta̱ u na babu za.<verse eid="JER 46:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JER 46:20" />&lt;&lt;Masar ma̱na̱wu ma nan ma sa'ani ma ɗa,</para>
  <para style="q2" vid="JER 46:20">amma ataɗi a̱ ta̱ lo a̱ ta̱wa̱ yi</para>
  <para style="q2" vid="JER 46:20">diga o upasu wu ugana.<verse eid="JER 46:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 46:21" />A̱soja a na o kopoi</para>
  <para style="q2" vid="JER 46:21">na a̱ ri pe a̱tsuma̱ a̱ yi,</para>
  <para style="q2" vid="JER 46:21">a̱ ta̱ tsa̱ ma̱dindim nna n ri na̱ lipu.</para>
  <para style="q1" vid="JER 46:21">Ele fo a ta vadala a suma oɓolo,</para>
  <para style="q2" vid="JER 46:21">a gura ee isawan fo shi.</para>
  <para style="q1" vid="JER 46:21">Adama a na urana wa̱ a̱tsuma̱lima̱</para>
  <para style="q2" vid="JER 46:21">a̱ ta̱ lo a̱ ta̱wa̱ a aci e le,</para>
  <para style="q2" vid="JER 46:21">mantsa ma na o sowo oforo.<verse eid="JER 46:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 46:22" />Masar ta̱ gugwa̱ tso yo na ri e ilaɗi,</para>
  <para style="q2" vid="JER 46:22">a mantsa ma na ma'yuwatan ma̱ yi</para>
  <para style="q2" vid="JER 46:22">ma̱a̱ za̱ra̱sa̱ nu ucira,</para>
  <para style="q1" vid="JER 46:22">a̱ ta̱ riya̱a̱ yi na aɓau,</para>
  <para style="q2" vid="JER 46:22">tsa ama a na a ɓatsa ɗanga.<verse eid="JER 46:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 46:23" />O to koɗo a̱a̱rumbu a̱ yi,&gt;&gt;</para>
  <para style="q2" vid="JER 46:23">&lt;&lt;ko na wo o'woi u shiwan ta̱ na̱ ɗanga,</para>
  <para style="q1" vid="JER 46:23">a la'a ta̱ apapari a̱bunda̱,</para>
  <para style="q2" vid="JER 46:23">agba a̱ ri n kece shi,</para>
  <para style="qr" vid="JER 46:23">ne ɗa A̱sulazuva a dammai.<verse eid="JER 46:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 46:24" />Ama a Masar o to sowo wono,</para>
  <para style="q2" vid="JER 46:24">a ta ca le e ekere ama o upasu wu ugana.&gt;&gt;<verse eid="JER 46:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 46:25" />A̱sulazuva o oɓolo a̱ a̱soja a zuva a̱ A̱sula̱ a Isra'ila a damma ta̱, &lt;&lt;N yuwan ta̱ zuzu na ma̱a̱ ta̱wa̱a̱ ma̱sula̱ ma Amon va Tebe na̱ Firi'awuna na aza a Masar suru oforo, na̱ musula̱ ma̱ yi oɓolo na̱ ngono ma̱ yi. Na amayun n ta ca Firi'awuna oforo oɓolo na aza a na a zuwaa niyi ucira suru. <verse eid="JER 46:25" /><verse number="26" style="v" sid="JER 46:26" />N ta ca le e ekere a za na a zama wuma u le, e ekere o mogono Nebukanaza va Babila na̱ a̱soja a̱ yi. Amma a̱ tyo a̱ca̱pa̱, Masar ta̱ da̱shi da̱na̱ na̱ nda̱na̱ta̱ cine u da̱na̱i ɗe nu ufaru,&gt;&gt; ne ɗa A̱sulazuva a dammai.<verse eid="JER 46:26" /></para>
  <para style="s">A̱sulazuva a ta wawa Isra'ila</para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 46:27" />&lt;&lt;Gogo, a̱vu Yakubu aagbashi a̱ va̱,</para>
  <para style="q2" vid="JER 46:27">she vu uwwa wovon wan,</para>
  <para style="q1" vid="JER 46:27">a̱vu Isra'ila</para>
  <para style="q2" vid="JER 46:27">she vu da'wan wan!</para>
  <para style="q1" vid="JER 46:27">Adama a na a̱ yi ɗa nda n ta wawa wu</para>
  <para style="q2" vid="JER 46:27">diga e iɗa ya alanga,</para>
  <para style="q1" vid="JER 46:27">n ta̱ fo a wawa muwun ma̱ wu</para>
  <para style="q2" vid="JER 46:27">diga e iɗa i tsugbashi.</para>
  <para style="q1" vid="JER 46:27">Waru ugundo wa̱ wu</para>
  <para style="q2" vid="JER 46:27">u ta̱ da̱shi tsurisa̱ nden ma asuvu,</para>
  <para style="q2" vid="JER 46:27">na̱ nden n lafiya,</para>
  <para style="q1" vid="JER 46:27">agba babu za na buwai</para>
  <para style="q2" vid="JER 46:27">na a dada'waton wu.<verse eid="JER 46:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 46:28" />She vu uwwa wovon wan,</para>
  <para style="q2" vid="JER 46:28">a̱vu Yakubu aagbashi a̱ va̱,</para>
  <para style="q2" vid="JER 46:28">adama a na n to oɓolo na̱ a̱vu,&gt;&gt;</para>
  <para style="q1" vid="JER 46:28">&lt;&lt;Ko na wo o'woi n ta̱ kototo nɗa suru suru,</para>
  <para style="q2" vid="JER 46:28">uba̱ta̱ u na m bete'we nɗu,</para>
  <para style="q2" vid="JER 46:28">moo kototo ɗu suru suru shi.</para>
  <para style="q1" vid="JER 46:28">N ta̱ ge'eto ɗu nu uge'etosu wa amayun,</para>
  <para style="q2" vid="JER 46:28">na amayun maa lyawa ɗu i ka̱ra̱ fa̱a̱n,</para>
  <para style="q2" vid="JER 46:28">babu na n ca ɗu oforo shi,&gt;&gt;</para>
  <para style="qr" vid="JER 46:28">ne ɗa A̱sulazuva a dammai.<verse eid="JER 46:28" /></para>
  <chapter eid="JER 46" />
  <chapter number="47" style="c" sid="JER 47" />
  <para style="s">Adanshi e ikaka a aci aza a Filistiya</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 47:1" />Apa adanshi e ikaka i na A̱sulazuva a dammai Irimiya vumava̱sula̱ adama aza a Filistiya, kafu Firi'awuna riya̱a̱ lyuci va Gaza nu uvon.<verse eid="JER 47:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="JER 47:2" />Apa ili i na A̱sulazuva a dammai,</para>
  <para style="q2" vid="JER 47:2">&lt;&lt;Ka̱lyuwa̱, cine mini ma̱a̱ 'yosun</para>
  <para style="q2" vid="JER 47:2">diga o upasu wu ugana,</para>
  <para style="q1" vid="JER 47:2">a̱ ta̱wusa̱ tsa̱ mini mo ucira,</para>
  <para style="q2" vid="JER 47:2">na o soɗu wi iɗa'a ni ili i na i ri pe a̱tsuma̱ a̱ yi,</para>
  <para style="q2" vid="JER 47:2">na o soɗu wi ilyuci ni ili i na i ri pe suru.</para>
  <para style="q1" vid="JER 47:2">Ama a̱ lyuci'i a ta yuwan yisali</para>
  <para style="q2" vid="JER 47:2">yi izami yi ikambishi,</para>
  <para style="q2" vid="JER 47:2">nda̱na̱ta̱ mi iɗa'a suru o to oruwo,<verse eid="JER 47:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 47:3" />diga a mawwa mo udasuwu wi ido,</para>
  <para style="q2" vid="JER 47:3">ni ilama yi ikeke yi ido yi n'yuwatan,</para>
  <para style="q2" vid="JER 47:3">ni ilama ya̱ a̱ga̱nda̱mu e ikeke i le,</para>
  <para style="q1" vid="JER 47:3">nan dada a̱ tsura̱ esu a na a vadala</para>
  <para style="q2" vid="JER 47:3">adama a̱ ka̱lyuwa̱ muwun nle shi,</para>
  <para style="q2" vid="JER 47:3">adama a na ekere e le a̱ ɗa̱mba̱i.<verse eid="JER 47:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 47:4" />Adama a na urana u ta̱wa̱ ta̱,</para>
  <para style="q2" vid="JER 47:4">a na A̱sulazuva o kototo aza a Filistiya suru,</para>
  <para style="q1" vid="JER 47:4">waru u ta'asa akapi a na a la'ai,</para>
  <para style="q2" vid="JER 47:4">na a kamba aza a Taya na̱ Sidon.</para>
  <para style="q1" vid="JER 47:4">A̱sulazuva a yuwan ta̱ zuzu</para>
  <para style="q2" vid="JER 47:4">na wo kototo aza a Filistiya,</para>
  <para style="q1" vid="JER 47:4">akapi a na a buwai</para>
  <para style="q2" vid="JER 47:4">e ikyun i mala ma Karita.<verse eid="JER 47:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 47:5" />Ama a Gaza a ta puna aci le</para>
  <para style="q2" vid="JER 47:5">a̱tsuma̱ a̱tsumola̱ngu.</para>
  <para style="q1" vid="JER 47:5">Lyuci va Ashikelon ta̱ rungwa̱ kpen.</para>
  <para style="q2" vid="JER 47:5">A̱ɗu akapi a na i ri nden agalaci,</para>
  <para style="q2" vid="JER 47:5">hali a̱ tyo mantsa ma̱ ne ɗa</para>
  <para style="q2" vid="JER 47:5">yaa lyawa a kyu'usan lipu ɗu?&gt;&gt;<verse eid="JER 47:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 47:6" />&lt;&lt;I ta̱ shon adansa,</para>
  <para style="q2" vid="JER 47:6">&lt;ayya, matsun me pe'eni ma̱ A̱sulazuva,</para>
  <para style="q2" vid="JER 47:6">hali a̱ tyo mantsa ma̱ ne ɗa vee ivuwan?</para>
  <para style="q1" vid="JER 47:6">Na va̱a̱ ka̱mba̱ a̱tsuma̱ e ibici ya̱ wu,</para>
  <para style="q2" vid="JER 47:6">vi ivuwan vu rungwa̱ kpen!&gt;<verse eid="JER 47:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 47:7" />Amma a̱vu Irimiya usu u damma,</para>
  <para style="q2" vid="JER 47:7">&lt;cine wee e ivuwan,</para>
  <para style="q1" vid="JER 47:7">a na wo o'woi A̱sulazuva a ɗa a zuwa niyi,</para>
  <para style="q2" vid="JER 47:7">na u zuwa niyi u riya̱a̱ Ashikelon,</para>
  <para style="q2" vid="JER 47:7">na̱ nda̱na̱ta̱ nna n ri e ikyun i mala.&gt; &gt;&gt;<verse eid="JER 47:7" /></para>
  <chapter eid="JER 47" />
  <chapter number="48" style="c" sid="JER 48" />
  <para style="s">Ikaka adama a̱ Mowa</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="JER 48:1" />Adama a̱ Mowa.</para>
  <para style="q2" vid="JER 48:1">Apa ili i na a̱ A̱sulazuva oɓolo a̱ a̱soja a zuva</para>
  <para style="q2" vid="JER 48:1">a̱ A̱sula̱ a Isra'ila a dammai,</para>
  <para style="q1" vid="JER 48:1">&lt;&lt;A̱tsuma̱lima̱ a ta cina wu Nebo,</para>
  <para style="q2" vid="JER 48:1">adama a na u ta̱ la̱nga̱.</para>
  <para style="q1" vid="JER 48:1">Kiriyatayim ta̱ sowo wono,</para>
  <para style="q2" vid="JER 48:1">waru a usa yi.</para>
  <para style="q1" vid="JER 48:1">Uba̱ta̱ wu upa'atan wu ucira u ta̱ sowo wono,</para>
  <para style="q2" vid="JER 48:1">waru a̱ ta̱ bete'we yi.<verse eid="JER 48:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 48:2" />A̱ da̱shi cuwa na̱ Mowa shi,</para>
  <para style="q2" vid="JER 48:2">a̱tsuma̱ a̱ Heshibon ama a̱ ta̱ foɓo a̱risa̱ a̱ yi,</para>
  <para style="q1" vid="JER 48:2">&lt;Ta̱wa̱i, tsu ta̱wa̱i nu ukosu wu nɗa nda!&gt;</para>
  <para style="q2" vid="JER 48:2">A̱ɗu fo ama a Madmen i ta̱ rungwa̱ kpen,</para>
  <para style="q2" vid="JER 48:2">waru matsun me pe'eni ma ta saɓa ɗu.<verse eid="JER 48:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 48:3" />Uwwai uɗyo u mesun diga Horonayim,</para>
  <para style="q2" vid="JER 48:3">uɗyo wa̱ a̱ba̱jini o lyungusu nu ukototosu.<verse eid="JER 48:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 48:4" />A ta kuɗa Mowa</para>
  <para style="q2" vid="JER 48:4">muwun keke'en ma̱ yi n ta̱ shon.<verse eid="JER 48:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 48:5" />O toni ta̱ agawan a̱ tyo Luhi,</para>
  <para style="q2" vid="JER 48:5">a̱ mesun lon a mantsa ma na a̱ ri a mmalu,</para>
  <para style="q1" vid="JER 48:5">nu ure u na u ka̱ra̱i a̱cipa̱ a̱ tyo Horonayim</para>
  <para style="q2" vid="JER 48:5">a̱ mesun a aci o ukototosu u na a uwwai.<verse eid="JER 48:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 48:6" />Sumai! Sumai adama a wuma u ɗu!</para>
  <para style="q2" vid="JER 48:6">Tsura̱ yo o'wo cine ido yu una i tsu sumusa.<verse eid="JER 48:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 48:7" />Ana wo o'woi i zuwai ucira u ɗu,</para>
  <para style="q2" vid="JER 48:7">a linga ɗu nu utsuru u ɗu,</para>
  <para style="q2" vid="JER 48:7">a̱ɗu fo a̱ ta̱ pura̱ ɗu a̱ tyo tsugbashi,</para>
  <para style="q1" vid="JER 48:7">Kemosh fo ta̱ 'ya̱wa̱ tsugbashi,</para>
  <para style="q2" vid="JER 48:7">oɓolo na̱ nan ganu a̱ yi</para>
  <para style="q2" vid="JER 48:7">na azagbain a̱ yi.<verse eid="JER 48:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 48:8" />Za vu ukototosu ta̱ riya̱a̱ lyuci suru,</para>
  <para style="q2" vid="JER 48:8">waru babu lyuci na a la'a.</para>
  <para style="q1" vid="JER 48:8">Ka̱ri ta̱ la̱nga̱</para>
  <para style="q2" vid="JER 48:8">reve o kototo musasan,</para>
  <para style="q2" vid="JER 48:8">adama a na ne ɗa A̱sulazuva a dammai.<verse eid="JER 48:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 48:9" />Tsuyin akpaɗi pe a̱ Mowa,</para>
  <para style="q2" vid="JER 48:9">adama iɗa'a i la̱nga̱ she ili i topo pe wan</para>
  <para style="q2" vid="JER 48:9">adama wo o'wo okongo,</para>
  <para style="q1" vid="JER 48:9">waru ilyuci ya̱ yi yo o'wo okongo,</para>
  <para style="q2" vid="JER 48:9">babu za na a̱ da̱nu pe.&gt;&gt;<verse eid="JER 48:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JER 48:10" />&lt;&lt;Una̱ u ta̱ reme za na tarai</para>
  <para style="q2" vid="JER 48:10">ulinga wa̱ A̱sulazuva ili i ro shi!</para>
  <para style="q1" vid="JER 48:10">Una̱ u ta̱ reme</para>
  <para style="q2" vid="JER 48:10">za na ronoi matsun me pe'eni ma̱ yi,</para>
  <para style="q2" vid="JER 48:10">diga o wocosu wu mpasa!&gt;&gt;<verse eid="JER 48:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JER 48:11" />&lt;&lt;Mowa da̱na̱ ta̱ na asuvu nden</para>
  <para style="q2" vid="JER 48:11">diga o tsulolobo tsa̱ a̱ yi,</para>
  <para style="q2" vid="JER 48:11">u to lo uba̱ta̱ u na a zuwa niyi,</para>
  <para style="q1" vid="JER 48:11">koto a tarai diga nda a̱ tyo ndeɗe shi</para>
  <para style="q2" vid="JER 48:11">ko u rito u tyo uba̱ta̱ u tsugbashi shi</para>
  <para style="q2" vid="JER 48:11">u ta̱ lo nu uyo'o wa̱ yi babu ukotu.&gt;&gt;<verse eid="JER 48:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 48:12" />Amma rana ta̱ lo a̱ ta̱wa̱,</para>
  <para style="q2" vid="JER 48:12">na ma̱ lyungu ama a na o kototo Mowa,</para>
  <para style="q2" vid="JER 48:12">o to o'woto ilyuci ya ama a̱ yi ofoli,</para>
  <para style="q2" vid="JER 48:12">reve fo o o'woto ilyuci'i okongo,</para>
  <para style="qr" vid="JER 48:12">ne ɗa A̱sulazuva a dammai.<verse eid="JER 48:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 48:13" />A̱za̱ a̱ Mowa a ta uwwa wono</para>
  <para style="q2" vid="JER 48:13">u ma̱sula̱ ma̱ le Kemosh,</para>
  <para style="q1" vid="JER 48:13">a ta uwwa wono</para>
  <para style="q2" vid="JER 48:13">ununa aza a Isra'ila a uwwai wono</para>
  <para style="q1" vid="JER 48:13">a mantsa ma na a zuwai</para>
  <para style="q2" vid="JER 48:13">ucira u le a̱tsuma̱ a̱ Betel.<verse eid="JER 48:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JER 48:14" />&lt;&lt;Gogo cine ya damma,</para>
  <para style="q2" vid="JER 48:14">&lt;a̱tsu nan yali o uvon a ɗa,</para>
  <para style="q2" vid="JER 48:14">ama a na a gurai uvon lon?&gt; &gt;&gt;<verse eid="JER 48:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 48:15" />&lt;&lt;O to kototo Mowa</para>
  <para style="q2" vid="JER 48:15">a̱ ta̱ ka̱nda̱ruwa̱ ilyuci ya̱ yi nu uvon,</para>
  <para style="q1" vid="JER 48:15">waru a ta paɗa</para>
  <para style="q2" vid="JER 48:15">olobo a sa'ani a̱ yi.</para>
  <para style="q1" vid="JER 48:15">Ne ɗa mogono ma dammai,</para>
  <para style="q2" vid="JER 48:15">za na ala a̱ yi a ɗa</para>
  <para style="q2" vid="JER 48:15">A̱sulazuva oɓolo a̱ a̱soja a zuva.&gt;&gt;<verse eid="JER 48:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 48:16" />&lt;&lt;A̱risa̱ a̱ Mowa a yuwan ta̱ zuzu,</para>
  <para style="q2" vid="JER 48:16">waru addama a̱ yi a̱ la̱pa̱ ta̱wa̱ shi.<verse eid="JER 48:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 48:17" />Yuwain mesun</para>
  <para style="q2" vid="JER 48:17">ma̱a̱ a̱tsumola̱ngu adama a̱ yi,</para>
  <para style="q2" vid="JER 48:17">a̱ɗu na i ri uka̱nda̱ruwu na̱ yi suru,</para>
  <para style="q1" vid="JER 48:17">a̱ɗu nɗa suru na i revei</para>
  <para style="q2" vid="JER 48:17">na aɗa o ucira wa̱ yi.</para>
  <para style="q1" vid="JER 48:17">I yuwan mesun ma̱a̱ a̱tsumola̱ngu i damma,</para>
  <para style="q2" vid="JER 48:17">&lt;Ka̱lyuwa̱i ne'e,</para>
  <para style="q2" vid="JER 48:17">cine o kototoi tsugono</para>
  <para style="q2" vid="JER 48:17">tsu ucira wa̱ yi suru!&gt; &gt;&gt;<verse eid="JER 48:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JER 48:18" />&lt;&lt;Cipa̱ yi diga uba̱ta̱ u tsugbain tsa̱ ɗu</para>
  <para style="q2" vid="JER 48:18">i da̱nu e iɗa,</para>
  <para style="q2" vid="JER 48:18">a̱ɗu na i ri nde a̱tsuma̱ a̱ Dibon</para>
  <para style="q1" vid="JER 48:18">adama a na za na o kototo Mowa</para>
  <para style="q2" vid="JER 48:18">ta̱ ta̱wa̱ u kototo wu,</para>
  <para style="q1" vid="JER 48:18">waru u to kototo ilyuci</para>
  <para style="q2" vid="JER 48:18">yi kari vu ucira ɗu.<verse eid="JER 48:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 48:19" />A̱ɗu na i ri nde a̱tsuma̱ a Arowa,</para>
  <para style="q2" vid="JER 48:19">yi isawan a̱ nge'en</para>
  <para style="q2" vid="JER 48:19">mu ure reve i ka̱lyuwa̱,</para>
  <para style="q1" vid="JER 48:19">yee ece vali na ri a zama</para>
  <para style="q2" vid="JER 48:19">na waa la'a na̱ wuma wa̱ yi</para>
  <para style="q2" vid="JER 48:19">oɓolo na̱ ka na cigai</para>
  <para style="q2" vid="JER 48:19">u la'ato wuma wa̱ yi,</para>
  <para style="q1" vid="JER 48:19">yee ece e le i damma,</para>
  <para style="q2" vid="JER 48:19">&lt;Nye ɗa gba yaa farasa?&gt;<verse eid="JER 48:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 48:20" />Mowa ili i wono i ɗa</para>
  <para style="q2" vid="JER 48:20">adama a na o kototo yi ta̱!</para>
  <para style="q1" vid="JER 48:20">I shon waru i 'ya̱sa̱n uɗyo!</para>
  <para style="q2" vid="JER 48:20">I yuwan adanshi zuzu na̱ Anon adansa,</para>
  <para style="q2" vid="JER 48:20">o kototo ta̱ Mowa.&gt;&gt;<verse eid="JER 48:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JER 48:21" />&lt;&lt;Uge'etosu u ta̱ ta̱wa̱</para>
  <para style="q2" vid="JER 48:21">a aci e ilyuci i na i ri a agaɗi,</para>
  <para style="q2" vid="JER 48:21">a̱ tyo Holon na̱ Yaza na̱ Mefa'a,<verse eid="JER 48:21" /></para>
  <para style="q2">
    <verse number="22" style="v" sid="JER 48:22" />na̱ Dibon na̱ Nebo na̱ Bet Dibilatayim,<verse eid="JER 48:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 48:23" />na̱ Kiriyatayim na̱ Bet Gamu na̱ Bet Meyo,<verse eid="JER 48:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 48:24" />na̱ Keriyot na̱ Bozura</para>
  <para style="q2" vid="JER 48:24">na aci e ilyuci ya̱ Mowa</para>
  <para style="q2" vid="JER 48:24">aza a na a̱ ri alanga na̱ zuzu.<verse eid="JER 48:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 48:25" />A ta kuɗa avana a̱ Mowa,</para>
  <para style="q2" vid="JER 48:25">waru a kuɗa ta̱ avangaci a̱ yi.&gt;&gt;</para>
  <para style="qr" vid="JER 48:25">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 48:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="JER 48:26" />&lt;&lt;Tsura̱to niyi,</para>
  <para style="q2" vid="JER 48:26">adama a na u yuwaan ta̱</para>
  <para style="q2" vid="JER 48:26">A̱sulazuva aciyogbamu.</para>
  <para style="q1" vid="JER 48:26">Lyawa Mowa yuwan igandalu</para>
  <para style="q2" vid="JER 48:26">a̱tsuma̱ a tsushamu tsa̱ yi,</para>
  <para style="q2" vid="JER 48:26">lyawa wo o'wo ili yi izo'oshi.<verse eid="JER 48:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 48:27" />Ashe a̱ɗu ama a̱ Mowa,</para>
  <para style="q2" vid="JER 48:27">i ri e izo'oshi</para>
  <para style="q2" vid="JER 48:27">ya ama a Isra'ila shi,</para>
  <para style="q1" vid="JER 48:27">ashe i yuwan nda'a ne le</para>
  <para style="q2" vid="JER 48:27">she damma evu a ɗa shi,</para>
  <para style="q1" vid="JER 48:27">na vaa gbaɗatsasa aci o ulamu</para>
  <para style="q2" vid="JER 48:27">a mantsa ma na vu ri</para>
  <para style="q2" vid="JER 48:27">a adanshi a̱ yi shi?<verse eid="JER 48:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 48:28" />A̱ɗu na ri nde a̱tsuma̱ a̱ Mowa,</para>
  <para style="q2" vid="JER 48:28">i lyawa ilyuci i ɗu!</para>
  <para style="q2" vid="JER 48:28">I 'ya̱wa̱ i da̱nu a̱tsuma̱ a atali!</para>
  <para style="q1" vid="JER 48:28">Yoo o'wo tsa muɗa ma na</para>
  <para style="q2" vid="JER 48:28">ma tsu yuwan yikinda</para>
  <para style="q2" vid="JER 48:28">o una̱ntsu wa̱a̱ a̱ba̱nu.<verse eid="JER 48:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 48:29" />Mu uwwa ta̱ aɗa aciyogbamu a̱ Mowa,</para>
  <para style="q2" vid="JER 48:29">n reve ta̱ a na a̱ ri nu uvaɗu.</para>
  <para style="q1" vid="JER 48:29">Mu uwwa ta̱ a na a̱ ri</para>
  <para style="q2" vid="JER 48:29">ugbawu na̱ ma̱ka̱ga̱</para>
  <para style="q2" vid="JER 48:29">nu u 'ya̱susa̱n wa avangaci u na ri na̱ yi,</para>
  <para style="q2" vid="JER 48:29">a tara aci ye le zuzu shi.<verse eid="JER 48:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 48:30" />A̱mu n reve ta̱ a na Mowa ri na aciyogbamu,</para>
  <para style="q2" vid="JER 48:30">ma̱ka̱ga̱ me pere ma ɗa waa yuwusan.&gt;&gt;</para>
  <para style="qr" vid="JER 48:30">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 48:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 48:31" />Adama o ndolo n ta̱ shon adama a̱ Mowa suru,</para>
  <para style="q2" vid="JER 48:31">n ta yuwan a̱tsumola̱ngu adama a ama a Kir Here.<verse eid="JER 48:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 48:32" />A̱vu uɗuma̱ u ina̱bi u Sibima</para>
  <para style="q2" vid="JER 48:32">n ta̱ shon adama a̱ wu</para>
  <para style="q1" vid="JER 48:32">ula'awu na̱ cine ma̱a̱ shon</para>
  <para style="q2" vid="JER 48:32">adama a ama a Jaza!</para>
  <para style="q1" vid="JER 48:32">ete'en a̱ wu a̱ ba̱ruwa̱ ta̱</para>
  <para style="q2" vid="JER 48:32">hali a̱ tyo a mala ma Jaza,</para>
  <para style="q1" vid="JER 48:32">za vu ukototosu ta̱ riya̱a̱</para>
  <para style="q2" vid="JER 48:32">umatsun wu ɗanga va̱ vu na kutsai,</para>
  <para style="q2" vid="JER 48:32">na ataci a̱ ina̱bi va̱ wu na kutsai.<verse eid="JER 48:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 48:33" />Ma̱za̱nga̱ na̱ Mere ma̱a̱ ta̱ puwa̱a̱n</para>
  <para style="q2" vid="JER 48:33">diga a̱tsuma̱ e iɗa yu umili ya̱ Mowa.</para>
  <para style="q1" vid="JER 48:33">N ta̱ e isawaton moco ma masayan ma̱ ina̱bi</para>
  <para style="q2" vid="JER 48:33">diga o uba̱ta̱ u mokpoko u masayan,</para>
  <para style="q2" vid="JER 48:33">babu za na o kpoko le na̱ yisali i ma̱za̱nga̱.</para>
  <para style="q1" vid="JER 48:33">Ko na wo o'woi a̱ ta̱ a yisali</para>
  <para style="q2" vid="JER 48:33">yisali'i gba za ma̱za̱nga̱ ɗa shi.<verse eid="JER 48:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="JER 48:34" />&lt;&lt;Uɗyo u mesun me le ma̱ ta̱ 'yosun</para>
  <para style="q2" vid="JER 48:34">diga a̱tsuma̱ a Heshibon na̱ Eleyale</para>
  <para style="q2" vid="JER 48:34">mesu'un u tara ta̱ hali acina Jaza,</para>
  <para style="q1" vid="JER 48:34">waru a ta uwwai a Zowa</para>
  <para style="q2" vid="JER 48:34">hali acina Horonayim na̱ Egla Shelishiya.</para>
  <para style="q2" vid="JER 48:34">hali na fo mini ma̱ Nimrim ma̱ 'yewe.<verse eid="JER 48:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="JER 48:35" />A̱tsuma̱ a̱ Mowa n ta̱ ta̱wa̱ nu ukosu</para>
  <para style="q2" vid="JER 48:35">wa aza a na a casu kucci</para>
  <para style="q2" vid="JER 48:35">vu ukula̱tosu a̱ ba̱ta̱ va̱ a̱ga̱nda̱,</para>
  <para style="q1" vid="JER 48:35">waru a̱ kula̱tosu a̱tsuka̱ a̱ ma̱guru</para>
  <para style="q2" vid="JER 48:35">uba̱ta̱ u musula̱ nle,&gt;&gt;</para>
  <para style="qr" vid="JER 48:35">ne ɗa A̱sulazuva a dammai.<verse eid="JER 48:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 48:36" />&lt;&lt;Adama o ndolo okolo a̱ va̱ a̱ ta̱ a̱tsumola̱ngu</para>
  <para style="q2" vid="JER 48:36">adama a̱ Mowa tsa gbala,</para>
  <para style="q1" vid="JER 48:36">u ta̱ a̱tsumola̱ngu tsa a gbala</para>
  <para style="q2" vid="JER 48:36">adama a ama a Kir Here.</para>
  <para style="q2" vid="JER 48:36">Waru utsuru u na a̱ tsura̱i u koto ta̱.<verse eid="JER 48:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 48:37" />A puna ta̱ aaci biti</para>
  <para style="q2" vid="JER 48:37">a̱vu a puna za biti ntsuka̱</para>
  <para style="q2" vid="JER 48:37">za suru kyu'wan ta̱ ekere a̱ yi</para>
  <para style="q1" vid="JER 48:37">reve a̱ nla̱a̱ za suru utugu</para>
  <para style="q2" vid="JER 48:37">wa̱ a̱tsumola̱ngu e ikyun ya̱ yi.<verse eid="JER 48:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 48:38" />Zuva vu ukwa̱'a̱ wa̱ Mowa biti</para>
  <para style="q2" vid="JER 48:38">oɓolo nu uba̱ta̱ u na a ama o ɓolotosu</para>
  <para style="q1" vid="JER 48:38">ili i ro yi lo shi, she mesun goon</para>
  <para style="q2" vid="JER 48:38">adama a na mu ɓoso ta̱ Mowa</para>
  <para style="q2" vid="JER 48:38">tsa̱ a̱ka̱bu a na a cigai shi,</para>
  <para style="qr" vid="JER 48:38">ne ɗa A̱sulazuva a dammai.<verse eid="JER 48:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="JER 48:39" />Ka̱lyuwa̱, cine e bete'we niyi!</para>
  <para style="q2" vid="JER 48:39">Ka̱lyuwa̱, cine u ri mesun!</para>
  <para style="q1" vid="JER 48:39">Ka̱lyuwa̱, cine Mowa vadalai ucina̱ wa̱ yi</para>
  <para style="q2" vid="JER 48:39">adama o wono!</para>
  <para style="q1" vid="JER 48:39">Mowa o'woto ili i wovon</para>
  <para style="q2" vid="JER 48:39">e ekere aza a na a̱ ri uka̱nda̱ruwu na̱ yi.&gt;&gt;<verse eid="JER 48:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="JER 48:40" />Gogo apa ili i na A̱sulazuva a dammai,</para>
  <para style="q2" vid="JER 48:40">&lt;&lt;Ka̱lyuwa̱, a̱a̱kuru a̱ zura̱ ta̱ a̱ tyo e iɗa,</para>
  <para style="q2" vid="JER 48:40">a̱ ba̱ruwusa̱ evelu a̱ yi a aci a Mowa.<verse eid="JER 48:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="JER 48:41" />A ta usa lyuci va̱ Keriyot</para>
  <para style="q2" vid="JER 48:41">na̱ ba̱ta̱ vu ucira va̱ yi.</para>
  <para style="q1" vid="JER 48:41">A̱tsuma̱ o urana u ndolo</para>
  <para style="q2" vid="JER 48:41">okolo a̱ a̱soja a Mowa</para>
  <para style="q2" vid="JER 48:41">o to o'wo tso okolo a ka na ri e teri.<verse eid="JER 48:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="JER 48:42" />A̱ ta̱ kototo Mowa a̱ nden ma̱ yi mi iɗa,</para>
  <para style="q2" vid="JER 48:42">adama a na u yuwaan ta̱ A̱sulazuva unusu.<verse eid="JER 48:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="JER 48:43" />Wovon na̱ a̱ka̱ri na̱ maza a ta pura wu,</para>
  <para style="q2" vid="JER 48:43">a̱ɗu a ama a̱ Mowa.</para>
  <para style="qr" vid="JER 48:43">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 48:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="JER 48:44" />Adama a na za na suru</para>
  <para style="q2" vid="JER 48:44">sumai adama o wovon</para>
  <para style="q2" vid="JER 48:44">u ta̱ riya̱ a̱tsuma̱ a̱ka̱ri,</para>
  <para style="q1" vid="JER 48:44">waru za na sumai diga a̱ka̱ri</para>
  <para style="q2" vid="JER 48:44">u ta̱ riya̱ a̱tsuma̱ a maza,</para>
  <para style="q1" vid="JER 48:44">adama a na n ta̱ ta̱wa̱a̱ Mowa</para>
  <para style="q2" vid="JER 48:44">na aa'wan oforo,</para>
  <para style="qr" vid="JER 48:44">ne ɗa A̱sulazuva a dammai.<verse eid="JER 48:44" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="45" style="v" sid="JER 48:45" />&lt;&lt;A̱za̱ e ilaɗi adama o uvon a̱ ta̱ mishin</para>
  <para style="q2" vid="JER 48:45">za̱la̱ vu ululu wa̱ Heshibon</para>
  <para style="q2" vid="JER 48:45">waru babu za na a kamba le,</para>
  <para style="q2" vid="JER 48:45">adama a na akina e reme ta̱ a̱tsuma̱ a̱ Heshbon.</para>
  <para style="q1" vid="JER 48:45">Na̱ elentsu akina diga e memere ma̱ Sihon,</para>
  <para style="q2" vid="JER 48:45">a̱ kula̱tosu cin va̱ Mowa,</para>
  <para style="q2" vid="JER 48:45">no okoluwo aza a aciyogbamu a nda.<verse eid="JER 48:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="JER 48:46" />A̱tsuma̱lima̱ a ta cina wu, a̱vu Mowa!</para>
  <para style="q2" vid="JER 48:46">O kototo ta̱ aza a na a yuwusaan Kemosh a̱ga̱nda̱!</para>
  <para style="q1" vid="JER 48:46">Waru a̱ pura̱ ta̱ olobo a̱ wu</para>
  <para style="q2" vid="JER 48:46">ne esheli a̱ wu a̱ tyo tsugbashi.<verse eid="JER 48:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="JER 48:47" />Na̱ ne suru, a rana na a̱ ta̱wa̱,</para>
  <para style="q2" vid="JER 48:47">n ta̱ ka̱mbuwa̱a̱ Mowa na aba'un a̱ yi,&gt;&gt;</para>
  <para style="qr" vid="JER 48:47">ne ɗa A̱sulazuva a dammai.</para>
  <para style="p" vid="JER 48:47">Pa ɗa uge'etosu a aci a̱ Mowa o kotoi.<verse eid="JER 48:47" /></para>
  <chapter eid="JER 48" />
  <chapter number="49" style="c" sid="JER 49" />
  <para style="s">Ikaka adama aza a Amon</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 49:1" />Adama aza a Amon,</para>
  <para style="b" vid="JER 49:1" />
  <para style="q1" vid="JER 49:1">apa ili i na A̱sulazuva a dammai,</para>
  <para style="q2" vid="JER 49:1">&lt;&lt;Isra'ila ri na̱ muwun mo olobo shi?</para>
  <para style="q2" vid="JER 49:1">Ko u ri na̱ za na a lyuwa agadu a̱ yi shi?</para>
  <para style="q1" vid="JER 49:1">To, nye i zuwai aza a na a yuwusaan Mole a̱ga̱nda̱</para>
  <para style="q2" vid="JER 49:1">a usai iɗa ya Gadu?</para>
  <para style="q1" vid="JER 49:1">Nye i zuwai ama a̱ yi</para>
  <para style="q2" vid="JER 49:1">a̱ da̱nuyi a̱tsuma̱ e ilyuci ya̱ yi?&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">49:1-6 </char><char style="xt" closed="false"><ref loc="EZK 21:28-32">Izk 21:28-32</ref>; <ref loc="EZK 25:1-7">25:1-7</ref>; <ref loc="AMO 1:13-15">Emo 1:13-15</ref>; <ref loc="ZEP 2:8-11">Zaf 2:8-11</ref>. </char></note><verse eid="JER 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 49:2" />&lt;&lt;Amma rana ta̱ lo a̱ ta̱wa̱,</para>
  <para style="qr" vid="JER 49:2">ne ɗa A̱sulazuva a dammai,</para>
  <para style="q2" vid="JER 49:2">na ma zuwa Raba lyuci gbain va Amon</para>
  <para style="q2" vid="JER 49:2">uwwa mesun ma aavana o uvon.</para>
  <para style="q1" vid="JER 49:2">Raba to o'wo okongo,</para>
  <para style="q2" vid="JER 49:2">a̱ ta̱ kula̱to mulyuci ma̱ yi na akina.</para>
  <para style="q1" vid="JER 49:2">Reve Isra'ila gba̱ra̱</para>
  <para style="q2" vid="JER 49:2">aza a na a̱ shi a̱ gba̱ra̱ ni yi ɗe.</para>
  <para style="qr" vid="JER 49:2">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 49:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="JER 49:3" />&lt;&lt;Yuwain yisali, a̱ɗu a ama a̱ Heshibon,</para>
  <para style="q2" vid="JER 49:3">adama a na o kototo ta̱ lyuci va̱ Ai!</para>
  <para style="q1" vid="JER 49:3">I 'ya̱sa̱n uɗyo u mesun a̱ɗu nda̱na̱ta̱ ma Raba!</para>
  <para style="q2" vid="JER 49:3">Yoo oto akashi amuna</para>
  <para style="q2" vid="JER 49:3">reve i yuwan a̱tsuma̱la̱ngu.</para>
  <para style="q1" vid="JER 49:3">Reve i suma i 'ya̱wa̱ ni i ta̱wi,</para>
  <para style="q2" vid="JER 49:3">a̱tsuma̱ o ukari u lyuci'i.</para>
  <para style="q1" vid="JER 49:3">Adama a na ma̱sula̱ Mole ma̱ ta̱ 'ya̱wa̱ tsugbashi,</para>
  <para style="q1" vid="JER 49:3">oɓolo na̱ nan ganu a̱ yi,</para>
  <para style="q2" vid="JER 49:3">na azagbain a̱ yi.<verse eid="JER 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 49:4" />Adama nye ya yuwusan uvaɗu</para>
  <para style="q2" vid="JER 49:4">adama o uka̱ri u ɗu,</para>
  <para style="q1" vid="JER 49:4">adama o uka̱ri u ɗu</para>
  <para style="q2" vid="JER 49:4">u na u ri ulobonu?</para>
  <para style="q1" vid="JER 49:4">A̱vu usheli wu ulambu wa̱ a̱ɓula̱,</para>
  <para style="q2" vid="JER 49:4">vu zuwaa ta̱ utsuru wa̱ wu ucira,</para>
  <para style="q2" vid="JER 49:4">reve vu damma,</para>
  <para style="q2" vid="JER 49:4">&lt;Zane ɗa a̱ riya̱a̱ mu nu uvon?&gt;<verse eid="JER 49:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 49:5" />Ka̱lyuwa̱, n ta̱ ta̱wa̱a̱</para>
  <para style="q2" vid="JER 49:5">na̱ tsuda'un a aci a̱ wu,</para>
  <para style="q1" vid="JER 49:5">diga uba̱ta̱ wa aza a na a̱ ri</para>
  <para style="q2" vid="JER 49:5">uka̱nda̱ruwu na̱ a̱ vu,</para>
  <para style="q1" vid="JER 49:5">a̱ ta̱ gba̱ra̱ za suru a̱tsuma̱ a̱ ɗu,</para>
  <para style="q2" vid="JER 49:5">waru babu za na a gura ɓoloto</para>
  <para style="q2" vid="JER 49:5">aza a na a zama a la'a.&gt;&gt;</para>
  <para style="qr" vid="JER 49:5">Ne ɗa A̱sulazuva oɓolo a̱soja a zuva dammai.<verse eid="JER 49:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JER 49:6" />&lt;&lt;Na̱ ne suru, a̱ ta̱wa̱ elime n ta̱ ka̱mbuwa̱a̱</para>
  <para style="q2" vid="JER 49:6">a̱za̱ a̱ Mowa na aba'un e le.&gt;&gt;</para>
  <para style="qr" vid="JER 49:6">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 49:6" /></para>
  <para style="s">Ikaka adama a̱ Edom</para>
  <para style="p">
    <verse number="7" style="v" sid="JER 49:7" />Adama a̱ Edom,</para>
  <para style="b" vid="JER 49:7" />
  <para style="q1" vid="JER 49:7">apa ili i na a̱ A̱sulazuva o oɓolo a̱ a̱soja a zuva dammai,</para>
  <para style="q2" vid="JER 49:7">&lt;&lt;Babu urevu a̱tsuma̱ a̱ Teman ɗa?</para>
  <para style="q2" vid="JER 49:7">A̱sa̱la̱ a̱ la̱nga̱ ta̱ e ekere a̱za̱ o urevu ɗa?</para>
  <para style="q2" vid="JER 49:7">Urevu u le u puwa̱a̱n ta̱ ɗa?<verse eid="JER 49:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 49:8" />Vadalai i suma,</para>
  <para style="q2" vid="JER 49:8">i pa'an a̱tsuma̱ oko'o a̱ru'un,</para>
  <para style="q2" vid="JER 49:8">a̱ ɗu na ri nden a̱tsuma̱ a̱ Dedan,</para>
  <para style="q1" vid="JER 49:8">adama a na n ta̱ ta̱wa̱a̱ Isuwa na addama,</para>
  <para style="q2" vid="JER 49:8">a mantsa ma na maa ca yi oforo.<verse eid="JER 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 49:9" />Nna aza a na a tsu taɓusa icu'un ina̱bi</para>
  <para style="q2" vid="JER 49:9">a̱ ta̱wa̱ uba̱ta̱ wa̱ wu,</para>
  <para style="q2" vid="JER 49:9">ashe, a tsu lyawa ozo o ro shi?</para>
  <para style="q1" vid="JER 49:9">Nna̱ e evu a̱ ta̱wa̱ na ayin,</para>
  <para style="q2" vid="JER 49:9">ashe, a tsu tara ili i na a cigai goon shi?<verse eid="JER 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 49:10" />Agba a̱mu n ta lyawa Isuwa ataɓu,</para>
  <para style="q2" vid="JER 49:10">a̱vu n kpa̱tu'wa̱ ba̱ta̱ vu pa'atan va̱ yi,</para>
  <para style="q2" vid="JER 49:10">hali na wa̱ kuɗa̱ pa'aton aciya̱yi!</para>
  <para style="q1" vid="JER 49:10">O to kototo muwun ma̱ a̱ yi,</para>
  <para style="q2" vid="JER 49:10">na̱ a̱za̱ a̱ yi na̱ nron mu nden ma̱ a̱ yi,</para>
  <para style="q2" vid="JER 49:10">hali na babu za na a buwa.<verse eid="JER 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 49:11" />Lyawaa mu mkpa'an ma̱ wu,</para>
  <para style="q2" vid="JER 49:11">n ta̱ gba e idana le.</para>
  <para style="q1" vid="JER 49:11">Waru lyawa nruna̱ ma̱ wu</para>
  <para style="q2" vid="JER 49:11">n zuwa ucira u le ya̱'a̱ va̱.&gt;&gt;<verse eid="JER 49:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="JER 49:12" />Apa ili i na A̱sulazuva a dammai, &lt;&lt;Nna̱ aza a na a ntsaayi a ca oforo shi o sowo oforo, adama a̱ nye a̱ ɗu yoo sowo oforo shi? Yaa la'a shi, na amayun n ta ca ɗu oforo! <verse eid="JER 49:12" /><verse number="13" style="v" sid="JER 49:13" />A̱mu n kucina ta̱ na Ala a̱ va̱ ana, Bozura to o'wo okongo, ni ili i wono, ni ili i wovon, ni ili i na a yuwayin una̱. Waru ilyuci ya̱ yi suru o to o'wo okongo hali hali.&gt;&gt;</para>
  <para style="qr" vid="JER 49:13">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 49:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JER 49:14" />Ɗaɗa Irimiya dammai,</para>
  <para style="q2" vid="JER 49:14">&lt;&lt;N ushi ta̱ ikaka diga uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="JER 49:14">a̱ lyungu ta̱ malingata a̱tsuma̱ a nɗa adansa,</para>
  <para style="q1" vid="JER 49:14">i ɓoloto aciya̱ɗu adama i riya̱a̱ Edom nu uvon!</para>
  <para style="q2" vid="JER 49:14">'Yoyin adama o uvon!<verse eid="JER 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 49:15" />Ka̱lyuwa̱, a̱vu Edom,</para>
  <para style="q2" vid="JER 49:15">n ta̱ ka̱mbuwa̱ wu vo o'wo ke'en a̱tsuma̱ a nɗa,</para>
  <para style="q2" vid="JER 49:15">ni ili yu ugoruso e ekere a vaɗilima̱.<verse eid="JER 49:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 49:16" />Wovon u na vu zuwai a uwwai,</para>
  <para style="q2" vid="JER 49:16">oɓolo na aciyogbamu o okolo a̱ wu</para>
  <para style="q2" vid="JER 49:16">a̱ luluma̱ wu ta̱.</para>
  <para style="q1" vid="JER 49:16">A̱vu na vu ri nden a̱ wungu wa atali,</para>
  <para style="q2" vid="JER 49:16">a̱vu na vu ri zuva va aagaɗi.</para>
  <para style="q1" vid="JER 49:16">Ko no wo o'woi vu yuwan ta̱ u'wa wa̱ wu</para>
  <para style="q2" vid="JER 49:16">ɗe aagaɗi tsa̱ a̱a̱kuru,</para>
  <para style="q1" vid="JER 49:16">na̱ ne suru, n ta vari wu</para>
  <para style="q2" vid="JER 49:16">e iɗa diga uba̱ta̱'a̱,&gt;&gt;</para>
  <para style="qr" vid="JER 49:16">ne ɗa A̱sulazuva a dammai.<verse eid="JER 49:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="JER 49:17" />&lt;&lt;Edom o to o'wo ili i wovon.</para>
  <para style="q2" vid="JER 49:17">Za na ka̱ra̱i lo uba̱ta̱'a̱ suru</para>
  <para style="q2" vid="JER 49:17">u ta lamba ili i na waa damma,</para>
  <para style="q1" vid="JER 49:17">reve u cira,</para>
  <para style="q2" vid="JER 49:17">adama a̱bunda̱ addama a na acina niyi.<verse eid="JER 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 49:18" />Ununa o kototoi Sodom na̱ Gomora</para>
  <para style="q2" vid="JER 49:18">ni ilyuci i na i ri zuzu ne le,</para>
  <para style="q2" vid="JER 49:18">ne ɗa a tawa Edom.</para>
  <para style="q1" vid="JER 49:18">Babu za na a̱ da̱nu pe,</para>
  <para style="q2" vid="JER 49:18">waru babu vaɗilima̱</para>
  <para style="q2" vid="JER 49:18">na a buwa pe a̱tsuma̱ yi,</para>
  <para style="qr" vid="JER 49:18">ne ɗa A̱sulazuva a dammai.<verse eid="JER 49:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 49:19" />Ununa vu revei kamu tsu uta̱</para>
  <para style="q2" vid="JER 49:19">a̱tsumona wu Uɗolu wa̱ Urudu</para>
  <para style="q2" vid="JER 49:19">a̱vu u gba̱ra̱ oɓolo e ikyon</para>
  <para style="q2" vid="JER 49:19">diga uba̱ta̱ wa alyuna,</para>
  <para style="q1" vid="JER 49:19">ne ɗa ma̱a̱ ta̱wa̱ n gba̱ra̱ a̱za̱ a̱ Edom nu uta̱</para>
  <para style="q2" vid="JER 49:19">diga a̱tsuma̱ e iɗa'a.</para>
  <para style="q1" vid="JER 49:19">Zagbain na maa ɗangula,</para>
  <para style="q2" vid="JER 49:19">a̱ yi ɗa waa yuwan tsugono tsa̱ yi.</para>
  <para style="q1" vid="JER 49:19">Adama a na zane ɗa ri tsa̱ va̱?</para>
  <para style="q2" vid="JER 49:19">Waru zane ɗa a gura 'ya̱wa̱ na adanshi a̱ va̱?</para>
  <para style="q1" vid="JER 49:19">A te ɗa za va aaguɓa a na a gura</para>
  <para style="q2" vid="JER 49:19">isawan u yuwan tsushu'un na̱ a̱mu?&gt;&gt;<verse eid="JER 49:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JER 49:20" />&lt;&lt;Adama o ndolo, apa ili i na A̱sulazuva</para>
  <para style="q2" vid="JER 49:20">o foɓoi a aci a̱za̱ a̱ Edom,</para>
  <para style="q1" vid="JER 49:20">ili i na u foɓoi e ekere</para>
  <para style="q2" vid="JER 49:20">aza a na a̱ ri nden a̱tsuma̱ a Teman.</para>
  <para style="q1" vid="JER 49:20">A̱ ta̱ gba̱ra̱ muwun nle a̱ ka̱ra̱</para>
  <para style="q2" vid="JER 49:20">reve o to kototo iɗa i le</para>
  <para style="q2" vid="JER 49:20">adama e ili i na a yuwain.<verse eid="JER 49:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 49:21" />Ilama ya̱a̱ a̱risa̱ a̱ Edom</para>
  <para style="q2" vid="JER 49:21">a ta zuwa uvaɗi u jinga̱ɗa̱,</para>
  <para style="q1" vid="JER 49:21">waru a ta uwwa uɗyo u mesun u le</para>
  <para style="q2" vid="JER 49:21">a Mala ma̱ Shili.<verse eid="JER 49:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 49:22" />Ka̱lyuwa̱, a̱a̱kuru a̱ ta̱ 'yon zuva</para>
  <para style="q2" vid="JER 49:22">reve u ɗa̱luwa̱ a̱ tyo e iɗa,</para>
  <para style="q1" vid="JER 49:22">wu ba̱ruwa̱ evelu a̱ yi</para>
  <para style="q2" vid="JER 49:22">reve u cipa̱ a aci Bozura.</para>
  <para style="q1" vid="JER 49:22">O urana u ndolo okolo a̱soja a̱ Edom a̱ ta̱ 'yon</para>
  <para style="q2" vid="JER 49:22">tso okolo a ka na ri e teri.&gt;&gt;<verse eid="JER 49:22" /></para>
  <para style="s">Ikaka adama aza a Dimaska</para>
  <para style="p">
    <verse number="23" style="v" sid="JER 49:23" />Adama aza a Dimaska,</para>
  <para style="b" vid="JER 49:23" />
  <para style="q1" vid="JER 49:23">&lt;&lt;Hamat na̱ Afa a̱ ra̱pula̱ ta̱,</para>
  <para style="q2" vid="JER 49:23">adama a na a uwwa ta̱</para>
  <para style="q2" vid="JER 49:23">alabari a na a̱ ri uyo'o shi.</para>
  <para style="q1" vid="JER 49:23">O uta̱ ta̱ okolo adama o wovon,</para>
  <para style="q2" vid="JER 49:23">waru a̱ ta̱ meje'en</para>
  <para style="q2" vid="JER 49:23">tsa mala ma na ma gura rungwa̱i kpen shi.<verse eid="JER 49:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 49:24" />Dimaska wo o'wo ta̱ babu ucira,</para>
  <para style="q2" vid="JER 49:24">reve u vadala adama u suma.</para>
  <para style="q1" vid="JER 49:24">A̱tsuma̱lima̱ na addama a cina yi ta̱,</para>
  <para style="q2" vid="JER 49:24">a̱tsuma̱lima̱ tsa ka na ri e teri.<verse eid="JER 49:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 49:25" />Amma a Dimaska a dammulai ta̱,</para>
  <para style="q2" vid="JER 49:25">ka̱lyuwa̱ ne'e lyuci tsu na shi yuwain ala,</para>
  <para style="q2" vid="JER 49:25">za na shi tsu zuwa tsu ma̱za̱nga̱ o'woi okongo!<verse eid="JER 49:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 49:26" />Na amayun, olobo a̱ yi</para>
  <para style="q2" vid="JER 49:26">a̱ ta̱ kuwa̱ alanga eteshe a̱ lyuci'i,</para>
  <para style="q2" vid="JER 49:26">waru a̱ ta̱ pura̱ a̱soja a̱ yi suru o urana u ndolo.<verse eid="JER 49:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 49:27" />N ta daɓa ukari u lyuci wa̱ Dimaska akina,</para>
  <para style="q2" vid="JER 49:27">waru u ta lyuwa ba̱ta̱ vu ucira u mogono Ben Hada.&gt;&gt;</para>
  <para style="qr" vid="JER 49:27">Ne ɗa A̱sulazuva o oɓolo a̱ a̱soja a zuva a dammai.<verse eid="JER 49:27" /></para>
  <para style="s">Ikaka adama a Keda na̱ Hazo</para>
  <para style="p">
    <verse number="28" style="v" sid="JER 49:28" />Adama a Keda na̱ tsugono tsa Hazo, aza a na Mogono Nebukanaza ma Babila ma lyuwai nu uvon.</para>
  <para style="b" vid="JER 49:28" />
  <para style="p" vid="JER 49:28">Apa ili i na A̱sulazuva a dammai,</para>
  <para style="q1" vid="JER 49:28">&lt;&lt;'Yoyin i riya̱a̱ Keda nu uvon,</para>
  <para style="q2" vid="JER 49:28">reve fo i kototo a ama a asana!<verse eid="JER 49:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 49:29" />A ta usa ogodo e le</para>
  <para style="q2" vid="JER 49:29">no oɓolo e ikyon i le,</para>
  <para style="q2" vid="JER 49:29">reve a̱ pura̱ uba̱ta̱ u wivuwusan u le,</para>
  <para style="q2" vid="JER 49:29">oɓolo ni itana i le na arakumi e le.</para>
  <para style="q1" vid="JER 49:29">Ama a ta saala le a damma,</para>
  <para style="q2" vid="JER 49:29">&lt;U'ya̱susa̱n wu ugbozu</para>
  <para style="q2" vid="JER 49:29">u ɓa̱ru tsu ta̱ mɓa̱nga̱ biti!&gt;<verse eid="JER 49:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 49:30" />Jika̱i i suma!</para>
  <para style="q2" vid="JER 49:30">I da̱nu a̱ a̱ba̱nu a̱ru'un,</para>
  <para style="q2" vid="JER 49:30">a̱ɗu na i ri nden a̱tsuma̱ a Hazo!</para>
  <para style="q1" vid="JER 49:30">Nebukanaza mogono ma Babila</para>
  <para style="q2" vid="JER 49:30">ma yuwan ta̱ ifoɓi a aci a̱ ɗu,</para>
  <para style="q1" vid="JER 49:30">u yuwan ta̱ ifoɓi yi iwuya a aci a̱ ɗu.</para>
  <para style="qr" vid="JER 49:30">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 49:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="JER 49:31" />&lt;&lt;'Yoyin, a̱ɗu a̱ a̱soja a Babila,</para>
  <para style="q2" vid="JER 49:31">i riya̱a̱ nɗa nna yenei</para>
  <para style="q1" vid="JER 49:31">she damma a̱ ta̱ nden n lafiya</para>
  <para style="q2" vid="JER 49:31">na asuvu nden,</para>
  <para style="q1" vid="JER 49:31">nɗa nna n ri na̱ na̱ntsu</para>
  <para style="q2" vid="JER 49:31">ko aɗanga e irumu shi,</para>
  <para style="q2" vid="JER 49:31">nɗa nna n ri a̱ nden a̱ nde'en.</para>
  <para style="qr" vid="JER 49:31">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 49:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 49:32" />A̱ ta̱ pura̱ arakumi e le,</para>
  <para style="q2" vid="JER 49:32">iliyamunga i le ya̱a̱ a̱bunda̱ i to o'wo</para>
  <para style="q2" vid="JER 49:32">itana i na a̱ pura̱i uba̱ta̱ wu uvon.</para>
  <para style="q1" vid="JER 49:32">N ta̱ bete'we aza a na a̱ ri</para>
  <para style="q2" vid="JER 49:32">ba̱ta̱ va alanga uba̱ta̱ suru,</para>
  <para style="q2" vid="JER 49:32">waru n ta̱ ta̱wa̱a̱ le na addama mɓa̱nga̱ biti.</para>
  <para style="qr" vid="JER 49:32">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 49:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 49:33" />Hazo to o'wo uba̱ta̱ wu nden</para>
  <para style="q2" vid="JER 49:33">n musa̱n mu una.</para>
  <para style="q1" vid="JER 49:33">Babu za na a̱ da̱nu pe,</para>
  <para style="q2" vid="JER 49:33">waru babu vaɗilima̱ na a̱ da̱nu pe uba̱ta̱'a̱.&gt;&gt;<verse eid="JER 49:33" /></para>
  <para style="s">Ikaka adama a̱ Elam</para>
  <para style="p">
    <verse number="34" style="v" sid="JER 49:34" />Apa ikaka i na a̱ A̱sulazuva a dammai vumava̱sula̱ Irimiya, adama a̱ Elam, a̱tsuma̱ a aa'wan o ufaru u tsugono tsa̱ Zedekiya va Yahuda.<verse eid="JER 49:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="JER 49:35" />Apa ili i na A̱sulazuva oɓolo a̱ a̱soja a zuva a dammai,</para>
  <para style="q2" vid="JER 49:35">&lt;&lt;N ta̱ kototo aza a na a yuwusan uvon</para>
  <para style="q2" vid="JER 49:35">ni ibata nu utan ya̱ Elam</para>
  <para style="q2" vid="JER 49:35">aza a na e le ɗa ucira wa̱ a̱soja a̱ yi.<verse eid="JER 49:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 49:36" />N ta zuwa upepu diga a̱ mɓa̱nga̱ n na̱shi mu uvaɗi,</para>
  <para style="q2" vid="JER 49:36">n lapa Elam diga a̱ mɓa̱nga̱ biti.</para>
  <para style="q1" vid="JER 49:36">N ta̱ bete'we a ama'a</para>
  <para style="q2" vid="JER 49:36">a̱ tyo a̱ mɓa̱nga̱ n na̱shi'i,</para>
  <para style="q1" vid="JER 49:36">hali na babu nɗa nna</para>
  <para style="q2" vid="JER 49:36">a lamba aza a Elam pe.<verse eid="JER 49:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 49:37" />N ta zuwa a ama a̱ Elam e je'en lipu</para>
  <para style="q2" vid="JER 49:37">elime a n'yuwatan nle</para>
  <para style="q2" vid="JER 49:37">aza a na a zama wuma u le.</para>
  <para style="q1" vid="JER 49:37">N ta̱ ta̱wa̱ na addama a aci e le</para>
  <para style="q2" vid="JER 49:37">nu upan wu usuɗuwu u va̱,</para>
  <para style="q1" vid="JER 49:37">reve n saɓa le na̱ matsun me pe'eni,</para>
  <para style="q2" vid="JER 49:37">hali she na̱ me ene ukosu u le.</para>
  <para style="qr" vid="JER 49:37">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 49:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 49:38" />N ta̱ shuwa̱ ootogu o tsugono tsa̱ a̱ va̱ a̱tsuma̱ a̱ Elam</para>
  <para style="q2" vid="JER 49:38">a̱vu n kototo mogono ma̱ yi na azagbain a̱ yi,</para>
  <para style="qr" vid="JER 49:38">ne ɗa A̱sulazuva a dammai.<verse eid="JER 49:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="JER 49:39" />&lt;&lt;Na̱ ne suru, a̱tsuma̱ a rana na a̱ ta̱wa̱,</para>
  <para style="q2" vid="JER 49:39">n ta̱ ka̱mbuwa̱a̱ a ama Elam na aba'un e le.</para>
  <para style="qr" vid="JER 49:39">Ne ɗa A̱sulazuva a dammai.&gt;&gt;<verse eid="JER 49:39" /></para>
  <chapter eid="JER 49" />
  <chapter number="50" style="c" sid="JER 50" />
  <para style="s">Ikaka adama a Babila</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 50:1" />Apa adanshi a na a̱ A̱sulazuva a dammai vumava̱sula̱ Irimiya adama a Babila, na adama e iɗa ya aza a Babila.<verse eid="JER 50:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="JER 50:2" />&lt;&lt;I damma nɗa, reve i lapa ulingi,</para>
  <para style="q2" vid="JER 50:2">i 'ya̱sa̱n atuta, reve i damma,</para>
  <para style="q2" vid="JER 50:2">she i soko ili i ro wan,</para>
  <para style="q1" vid="JER 50:2">amma i damma,</para>
  <para style="q2" vid="JER 50:2">&lt;A ta lyuwa Babila nu uvon,</para>
  <para style="q2" vid="JER 50:2">waru a ta ca Bel ma̱sula̱ wono,</para>
  <para style="q2" vid="JER 50:2">Merodak a̱ma̱li ta shiwan na̱ wono.</para>
  <para style="q1" vid="JER 50:2">Yironishi ya̱ yi i ta̱ sowo wono,</para>
  <para style="q2" vid="JER 50:2">waru a̱ma̱li a̱ yi a ta shiwan na̱ wovon.&gt; &gt;&gt;<verse eid="JER 50:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 50:3" />&lt;&lt;Nɗa diga o upasu wu ugana</para>
  <para style="q2" vid="JER 50:3">n ta̱ riya̱a̱ yi nu uvon,</para>
  <para style="q2" vid="JER 50:3">a̱vu u ka̱mbuwa̱i okongo.</para>
  <para style="q1" vid="JER 50:3">Babu vuma na a̱ da̱nu pe,</para>
  <para style="q2" vid="JER 50:3">vaɗilima̱ ni inama biti a ta suma,</para>
  <para style="q2" vid="JER 50:3">a lyawa uba̱ta̱'a̱.&gt;&gt;<verse eid="JER 50:3" /></para>
  <para style="s">Uzuwu wo okolo a̱ ta̱ lo adama a Isra'ila na̱ Yahuda</para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JER 50:4" />&lt;&lt;A̱tsuma̱ a rana ndolo,</para>
  <para style="q2" vid="JER 50:4">na a mantsa mo ndolo,</para>
  <para style="q1" vid="JER 50:4">a ama a Isra'ila na̱ Yahuda wirota̱,</para>
  <para style="q2" vid="JER 50:4">a̱ ta̱ ta̱wa̱ a̱tsuma̱ a̱ mesun,</para>
  <para style="q2" vid="JER 50:4">adama a zami A̱sulazuva A̱sula̱ e le.<verse eid="JER 50:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 50:5" />E te ece ure a̱ tyo Sihiyona,</para>
  <para style="q2" vid="JER 50:5">reve waru a vadala urewesu le uba̱ta̱ wa̱ yi,</para>
  <para style="q2" vid="JER 50:5">a̱ ta̱ ta̱wa̱ a suraa A̱sulazuva.</para>
  <para style="q1" vid="JER 50:5">A̱tsuma̱ a nzuwulai ma hali hali,</para>
  <para style="q2" vid="JER 50:5">za na a̱ kuɗa̱ e icina na̱ yi suru suru.&gt;&gt;<verse eid="JER 50:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JER 50:6" />&lt;&lt;Ama a̱ va̱ a̱ ta̱ tsi ikyon i na i puwa̱yin,</para>
  <para style="q2" vid="JER 50:6">aza a na azaguɓa e le</para>
  <para style="q2" vid="JER 50:6">a lyawa n le a̱ puwa̱yin.</para>
  <para style="q1" vid="JER 50:6">Reve a zuwa le a̱ da̱na̱</para>
  <para style="q2" vid="JER 50:6">agara a̱tsuma̱ a nsasan.</para>
  <para style="q1" vid="JER 50:6">A̱ da̱na̱ e igaru zuva vu nsasan na agaɗi,</para>
  <para style="q2" vid="JER 50:6">hali e icina nu uba̱ta̱ u wivuwun u le.<verse eid="JER 50:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 50:7" />Za na biti cina n le</para>
  <para style="q2" vid="JER 50:7">to kototo le,</para>
  <para style="q1" vid="JER 50:7">n'yuwatan n le n damma ta̱,</para>
  <para style="q2" vid="JER 50:7">&lt;Tsu ri nu unusu shi,</para>
  <para style="q1" vid="JER 50:7">adama a na a yuwaan ta̱ A̱sulazuva unusu,</para>
  <para style="q2" vid="JER 50:7">za na a̱ yi ɗa uba̱ta̱ wa alyuna a amayun e le,</para>
  <para style="q2" vid="JER 50:7">A̱sulazuva a na a̱ yi ɗa ucawu wo okolo a nkaya n le.&gt; &gt;&gt;<verse eid="JER 50:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JER 50:8" />&lt;&lt;Suma yi diga Babila,</para>
  <para style="q2" vid="JER 50:8">i lyawa iɗa ya aza a Babila,</para>
  <para style="q2" vid="JER 50:8">yo o'wo tsa̱ mgbele nna n ronoi ikyon aaɗanga.<verse eid="JER 50:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 50:9" />Adama a na n ta̱ 'ya̱sa̱n</para>
  <para style="q2" vid="JER 50:9">nɗa m gbagbain mu upasu wu ugana,</para>
  <para style="q2" vid="JER 50:9">adama o ɓolo a aci a yuwan uvon na̱ Babila,</para>
  <para style="q1" vid="JER 50:9">a̱ ta̱ ta̱wa̱ a dara</para>
  <para style="q2" vid="JER 50:9">adama a yuwan uvon na̱ yi,</para>
  <para style="q1" vid="JER 50:9">waru a lyuwa yi nu uvon</para>
  <para style="q2" vid="JER 50:9">diga o upasu wu ugana.</para>
  <para style="q1" vid="JER 50:9">Iliya i le i ta̱ da̱na̱ tsa nan yali ya̱ a̱soja,</para>
  <para style="q2" vid="JER 50:9">aza a na a̱ tsu ka̱mba̱ ekere lya̱nga̱,</para>
  <para style="q2" vid="JER 50:9">diga uba̱ta̱ o uvon shi.<verse eid="JER 50:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 50:10" />Adama o ndolo Babila</para>
  <para style="q2" vid="JER 50:10">o to o'wo akunda e itana i na</para>
  <para style="q2" vid="JER 50:10">a̱ pura̱i uba̱ta̱ wu uvon,</para>
  <para style="q1" vid="JER 50:10">aza a na a usa niyi suru a̱ ta̱ cuwa̱n.&gt;&gt;</para>
  <para style="qr" vid="JER 50:10">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 50:10" /></para>
  <para style="s">A̱risa̱ a Babila na amayun</para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JER 50:11" />&lt;&lt;Adama o ndolo i ta̱ a̱ mere na̱ ma̱za̱nga̱,</para>
  <para style="q2" vid="JER 50:11">a̱ɗu na i pura̱i agadu a̱ va̱,</para>
  <para style="q1" vid="JER 50:11">waru i ta tsu'yan she damma</para>
  <para style="q2" vid="JER 50:11">nan na tsura̱i osoroto,</para>
  <para style="q1" vid="JER 50:11">agba i to oruwuso</para>
  <para style="q2" vid="JER 50:11">cine vu revei oɓolo e ido.<verse eid="JER 50:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 50:12" />Mma ɗu to sowo wono wa̱ a̱bunda̱ lon,</para>
  <para style="q2" vid="JER 50:12">a̱ yi na u matsan n ɗu wono u ta̱ ɓa̱ru yi.</para>
  <para style="q1" vid="JER 50:12">U to o'wo iɗa i na i la'ai uka̱la̱mu a̱tsuma̱ a nɗa,</para>
  <para style="q2" vid="JER 50:12">tsa̱ a̱tsumona ni iɗa yu 'yewu,</para>
  <para style="q2" vid="JER 50:12">ɓolo na̱ a̱tsumona a na a̱ ri babu za.<verse eid="JER 50:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 50:13" />Adama o upan wa̱ A̱sulazuva</para>
  <para style="q2" vid="JER 50:13">babu za na a̱ da̱nu pe,</para>
  <para style="q2" vid="JER 50:13">amma u to o'wo okongo suru.</para>
  <para style="q1" vid="JER 50:13">Za na suru ka̱ra̱la̱i nu upasu wa Babila,</para>
  <para style="q2" vid="JER 50:13">u ta lamba ili i na waa damma,</para>
  <para style="q2" vid="JER 50:13">u ta cira adama addama a na acina niyi.<verse eid="JER 50:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JER 50:14" />&lt;&lt;Darai i ka̱nda̱ruwa̱ Babila,</para>
  <para style="q2" vid="JER 50:14">a̱ɗu na i tsu rono utan suru.</para>
  <para style="q1" vid="JER 50:14">Tawan niyi!</para>
  <para style="q2" vid="JER 50:14">Waru she i buwaa aya wan.</para>
  <para style="q2" vid="JER 50:14">Adama a na u yuwaan ta̱ A̱sulazuva unusu.<verse eid="JER 50:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 50:15" />Ka̱nda̱ruwa̱ niyi na̱ yisali yu uvon mɓa̱nga̱ biti!</para>
  <para style="q2" vid="JER 50:15">U 'ya̱sa̱n ta̱ ekere a̱ yi</para>
  <para style="q2" vid="JER 50:15">e izami ya asuvu nde,</para>
  <para style="q1" vid="JER 50:15">ukari wa̱ yi u riya̱ ta̱,</para>
  <para style="q2" vid="JER 50:15">waru uɓaɓu wa̱ yi wo oco ta̱.</para>
  <para style="q1" vid="JER 50:15">Adama a na a̱ yi nda</para>
  <para style="q2" vid="JER 50:15">atsupu a ɗa diga uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q1" vid="JER 50:15">Tsupa yi a aci a̱ yi,</para>
  <para style="q2" vid="JER 50:15">yuwaan niyi cine u yuwain akapi.<verse eid="JER 50:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 50:16" />She i lyawa a yuwan ca̱'a̱n</para>
  <para style="q2" vid="JER 50:16">ko a yuwan ugasa a̱tsuma̱ a Babila wan.</para>
  <para style="q1" vid="JER 50:16">Adama a matsun me pe'eni ma n'yuwatan,</para>
  <para style="q2" vid="JER 50:16">lyawa za suru ka̱mba̱ uba̱ta̱ wa ama a̱ yi,</para>
  <para style="q2" vid="JER 50:16">lyawa za suru suma u ka̱mba̱ e iɗa ya̱ yi.&gt;&gt;<verse eid="JER 50:16" /></para>
  <para style="s">Ama a̱ A̱sulazuva a̱ ta̱ nu uzuwu wo okolo</para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="JER 50:17" />&lt;&lt;Isra'ila tu ubete'u</para>
  <para style="q2" vid="JER 50:17">cine vu revei ikyon</para>
  <para style="q2" vid="JER 50:17">i na ikamu i gba̱ra̱i.</para>
  <para style="q1" vid="JER 50:17">Nu ufaru mogono ma Asuriya ɗa</para>
  <para style="q2" vid="JER 50:17">fara lyuwa niyi nu uvon.</para>
  <para style="q1" vid="JER 50:17">A̱ tyo o ukosu reve mogono Nebukanaza va Babila</para>
  <para style="q2" vid="JER 50:17">kukuɗa etele a̱ yi.<verse eid="JER 50:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 50:18" />Adama o ndolo apa ili i na A̱sulazuva oɓolo a̱ a̱soja a zuva</para>
  <para style="q2" vid="JER 50:18">a̱ A̱sula̱ a Isra'ila a dammai,</para>
  <para style="q1" vid="JER 50:18">&lt;N ta ca mogono ma Babila oforo</para>
  <para style="q2" vid="JER 50:18">oɓolo ni iɗa ya̱ yi,</para>
  <para style="q2" vid="JER 50:18">ununa n cayi mogono ma Asuriya oforo.<verse eid="JER 50:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 50:19" />Amma n ta̱ ka̱mbuwa̱ Isra'ila</para>
  <para style="q2" vid="JER 50:19">a̱tsuma̱ e iɗa ya̱ yi,</para>
  <para style="q1" vid="JER 50:19">u ta lyuwa u cuwa̱n a masasan ma gbain</para>
  <para style="q2" vid="JER 50:19">ma Kame na̱ Bashan,</para>
  <para style="q1" vid="JER 50:19">waru u ta tawa maluwa ma̱ yi</para>
  <para style="q2" vid="JER 50:19">agaɗi a Ifiramu nu upasu wa Giliyadu.<verse eid="JER 50:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 50:20" />A rana ndolo na a mantsa ma nda,</para>
  <para style="q2" vid="JER 50:20">a ta zami unusu wa Isra'ila</para>
  <para style="q2" vid="JER 50:20">agba a̱ tsura̱i shi,</para>
  <para style="q1" vid="JER 50:20">waru a ta zami nusu va Yahuda,</para>
  <para style="q2" vid="JER 50:20">agba a̱ tsura̱ le shi.</para>
  <para style="q1" vid="JER 50:20">Adama a na n ta yuwaan</para>
  <para style="q2" vid="JER 50:20">akapi a na n lyawai gafura.&gt; &gt;&gt;</para>
  <para style="qr" vid="JER 50:20">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 50:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JER 50:21" />&lt;&lt;I riya̱a̱ iɗa ya Meratayim,</para>
  <para style="q2" vid="JER 50:21">oɓolo na aza a na a̱ ri nden</para>
  <para style="q2" vid="JER 50:21">a̱tsuma̱ a̱ Peko nu uvon.</para>
  <para style="q1" vid="JER 50:21">Saɓa nle, yu una le,</para>
  <para style="q2" vid="JER 50:21">waru i kototo le suru suru.</para>
  <para style="q1" vid="JER 50:21">I yuwan ili i na n damma nɗu.</para>
  <para style="qr" vid="JER 50:21">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 50:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 50:22" />Yisali yu uvon i ta̱ pe a̱tsuma̱ a̱ lyuci'i</para>
  <para style="q2" vid="JER 50:22">yisali ya̱ a̱ba̱jini o ukototosu!<verse eid="JER 50:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 50:23" />Ka̱lyuwa̱, ne'e cine a kukuɗai Babila,</para>
  <para style="q2" vid="JER 50:23">a tawa ta̱ ma̱ka̱ta̱ a na a̱ shi a lapai uvaɗi</para>
  <para style="q2" vid="JER 50:23">a mantsa ma na ma̱ ka̱ra̱i ɗe nu ufaru!</para>
  <para style="q2" vid="JER 50:23">Ukototosu wa̱ yi u ca ta̱ nɗa suru wovon!<verse eid="JER 50:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 50:24" />A̱vu Babila, a̱mu A̱sulazuva</para>
  <para style="q2" vid="JER 50:24">ma azuwa wu ta̱ maza,</para>
  <para style="q1" vid="JER 50:24">waru maza'a u reme wu ta̱,</para>
  <para style="q2" vid="JER 50:24">babu a̱vu urevu.</para>
  <para style="q1" vid="JER 50:24">A cina wu ta̱ a̱vu e reme wu,</para>
  <para style="q2" vid="JER 50:24">adama a na vu yuwan ta̱ tsushu'un na̱ mu.<verse eid="JER 50:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 50:25" />A̱sulazuva a̱ kpa̱tu'wa̱ ta̱</para>
  <para style="q2" vid="JER 50:25">asula e izuwa yi itana yu uvon ya̱ yi,</para>
  <para style="q2" vid="JER 50:25">reve wu uta̱a̱ ni itana yu upan ya̱ yi,</para>
  <para style="q1" vid="JER 50:25">adama a na A̱sulazuva oɓolo a̱ a̱soja a zuva</para>
  <para style="q2" vid="JER 50:25">a̱ ta̱ nu ulinga u na u cigai na waa yuwan</para>
  <para style="q2" vid="JER 50:25">a̱tsuma̱ e iɗa ya Babila.<verse eid="JER 50:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 50:26" />Ta̱wa̱i i riya̱a̱ Babila diga e iɗa ya alanga.</para>
  <para style="q2" vid="JER 50:26">I katsu'wa asula e izuwa ya̱ yi,</para>
  <para style="q2" vid="JER 50:26">reve i ka̱mbuwa̱i tsa̱ a̱ edemu.</para>
  <para style="q1" vid="JER 50:26">I kototo yi suru,</para>
  <para style="q2" vid="JER 50:26">she i buwa yi ili i ro wan.<verse eid="JER 50:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 50:27" />Yu una ogono e inan ya̱ yi suru,</para>
  <para style="q2" vid="JER 50:27">lyawa a̱ zura̱ a̱ tyo uba̱ta̱ u mapaɗa!</para>
  <para style="q1" vid="JER 50:27">A̱tsuma̱lima̱ a ta cina le!</para>
  <para style="q2" vid="JER 50:27">Adama a na urana u le u rawa ta̱,</para>
  <para style="q2" vid="JER 50:27">mantsa ma yuwan ta̱ a na a ca le oforo.<verse eid="JER 50:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 50:28" />Uwwa ne'e, ilama ya aza a na a̱ ri e ilaɗi</para>
  <para style="q2" vid="JER 50:28">adama a la'a na̱ wuma u le,</para>
  <para style="q1" vid="JER 50:28">na aza a na a zama uba̱ta̱ u na pa'an</para>
  <para style="q2" vid="JER 50:28">diga e iɗa ya Babila.</para>
  <para style="q1" vid="JER 50:28">A ta dansa a̱tsuma̱ a̱ Sihiyona,</para>
  <para style="q2" vid="JER 50:28">ununa A̱sulazuva a̱ A̱sula̱ a̱tsu</para>
  <para style="q2" vid="JER 50:28">a tarai na waa yuwan atsupu,</para>
  <para style="q2" vid="JER 50:28">atsupu adama A̱a̱'isamapaɗa a̱ yi.&gt;&gt;<verse eid="JER 50:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="JER 50:29" />&lt;&lt;Ɗeyi a̱za̱ e ibata a aci aza a Babila,</para>
  <para style="q2" vid="JER 50:29">aza a na a gurai morono mo utan suru.</para>
  <para style="q1" vid="JER 50:29">I va̱la̱ uka̱nda̱ruwu na̱ yi suru,</para>
  <para style="q2" vid="JER 50:29">she i lyawa nanza la'a wan.</para>
  <para style="q1" vid="JER 50:29">I tsupa a aci a̱ yi</para>
  <para style="q2" vid="JER 50:29">o una̱ wu linga va̱ yi,</para>
  <para style="q2" vid="JER 50:29">i tsupa yi o una̱ wi ili i na u yuwain,</para>
  <para style="q1" vid="JER 50:29">adama a na u goro ta̱ A̱sulazuva,</para>
  <para style="q2" vid="JER 50:29">Za va Akiza a Isra'ila.<note caller="-" style="x"><char style="xo" closed="false">50:29 </char><char style="xt" closed="false"><ref loc="REV 18:6">Wen 18:6</ref>.</char></note><verse eid="JER 50:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 50:30" />Adama ndolo, olobo a̱ yi</para>
  <para style="q2" vid="JER 50:30">a̱ ta̱ riya̱ a̱ re lyuci,</para>
  <para style="q1" vid="JER 50:30">waru a̱ ta̱ o una a̱soja a̱ yi suru</para>
  <para style="q2" vid="JER 50:30">a̱tsuma̱ o urana u ndolo.&gt;&gt;</para>
  <para style="qr" vid="JER 50:30">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 50:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="JER 50:31" />&lt;&lt;Ka̱lyuwa̱, a̱vu Babila</para>
  <para style="q2" vid="JER 50:31">n ta̱ tsushu'un na̱ a̱vu,</para>
  <para style="q2" vid="JER 50:31">a̱vu za va aciyogbamu.</para>
  <para style="q1" vid="JER 50:31">Adama a na urana wa̱ wu u ta̱wa̱ ta̱,</para>
  <para style="q2" vid="JER 50:31">urana u na a ca wu oforo.</para>
  <para style="qr" vid="JER 50:31">Ne ɗa A̱sulazuva o oɓolo a̱ a̱soja a zuva a dammai.<verse eid="JER 50:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 50:32" />A̱vu za va aciyogbamu,</para>
  <para style="q2" vid="JER 50:32">vu ta̱ ta̱ɗa̱tsa̱ vu riya̱,</para>
  <para style="q2" vid="JER 50:32">agba babu za na a̱ 'ya̱sa̱n wu.</para>
  <para style="q1" vid="JER 50:32">N ta̱ kula̱to ilyuci ya̱ wu na akina,</para>
  <para style="q2" vid="JER 50:32">a na a lyuwa suru aza a na</para>
  <para style="q2" vid="JER 50:32">a̱ ri uka̱nda̱ruwu na̱ vu suru.&gt;&gt;<verse eid="JER 50:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="JER 50:33" />&lt;&lt;Apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva dammai,</para>
  <para style="q2" vid="JER 50:33">o ɓongi ta̱ ama a Isra'ila,</para>
  <para style="q2" vid="JER 50:33">waru o ɓongi ta̱ fo ama a Yahuda.</para>
  <para style="q1" vid="JER 50:33">Aza a na e reme nle suru</para>
  <para style="q2" vid="JER 50:33">a tsu ɓana na le ta̱ ugbamu,</para>
  <para style="q1" vid="JER 50:33">agba a tsu 'yuwan ta̱</para>
  <para style="q2" vid="JER 50:33">a na a lyawa le a̱ ka̱ra̱.<verse eid="JER 50:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 50:34" />Na̱ ne suru, za vi iwawi i le</para>
  <para style="q2" vid="JER 50:34">i tu nu ucira lon,</para>
  <para style="q2" vid="JER 50:34">A̱sulazuva o oɓolo a̱ a̱soja a zuva ɗa Ala a̱ yi.</para>
  <para style="q1" vid="JER 50:34">Na amayun u ta̱ ee isawaan le,</para>
  <para style="q2" vid="JER 50:34">adama u ta̱wa̱a̱ na̱ wivuwun a̱tsuma̱ e iɗa i le,</para>
  <para style="q1" vid="JER 50:34">amma u ta̱wa̱ nu ulambu u wivuwun</para>
  <para style="q2" vid="JER 50:34">e ekere aza a na a̱ ri nden a̱tsuma̱ a Babila.&gt;&gt;<verse eid="JER 50:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="JER 50:35" />&lt;&lt;A̱sulazuva a damma ta̱,</para>
  <para style="q2" vid="JER 50:35">matsun me pe'eni ma̱ ta̱ da̱na̱</para>
  <para style="q2" vid="JER 50:35">a aci aza a Babila!</para>
  <para style="q1" vid="JER 50:35">Na a aci a̱ nda̱na̱ta̱ ma Babila,</para>
  <para style="q2" vid="JER 50:35">na a aci azagbain e le na̱ a̱za̱ o urevu u le!<verse eid="JER 50:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 50:36" />Matsun me pe'eni fo ma̱ ta̱ da̱na̱</para>
  <para style="q2" vid="JER 50:36">a aci ama̱sula̱ epen e le!</para>
  <para style="q2" vid="JER 50:36">O to o'wo olo!</para>
  <para style="q1" vid="JER 50:36">Na̱ matsun me pe'eni a aci a̱soja i le,</para>
  <para style="q2" vid="JER 50:36">a ta shiwan na̱ wovon lon!<verse eid="JER 50:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 50:37" />Matsun me pe'eni ma̱ ta̱ da̱na̱</para>
  <para style="q2" vid="JER 50:37">a aci e ido i le,</para>
  <para style="q2" vid="JER 50:37">ni ikeke yi ido i le!</para>
  <para style="q1" vid="JER 50:37">Na a aci omoci a̱soja a na a̱ ri</para>
  <para style="q2" vid="JER 50:37">a̱tsuma̱ a̱soja o uvon u le!</para>
  <para style="q2" vid="JER 50:37">O to o'wo a̱ma̱ci.</para>
  <para style="q1" vid="JER 50:37">Matsun me pe'eni ma̱ ta̱ da̱na̱</para>
  <para style="q2" vid="JER 50:37">a aci asula e izuwa ya̱ yi!</para>
  <para style="q1" vid="JER 50:37">A̱ ta̱ pura̱ le suru o o'wo itana</para>
  <para style="q2" vid="JER 50:37">i na a̱ pura̱i uba̱ta̱ wu uvon!<verse eid="JER 50:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 50:38" />Nu ulambu u mini a̱ ba̱ta̱ mini ma̱ yi,</para>
  <para style="q2" vid="JER 50:38">a ta kwa suru!</para>
  <para style="q1" vid="JER 50:38">Adama a na iɗa i ɗa ya̱ a̱ma̱li,</para>
  <para style="q2" vid="JER 50:38">a̱ma̱li a na a jaara na̱ wovon!&gt;&gt;<verse eid="JER 50:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="JER 50:39" />&lt;&lt;Adama o ndolo inama yu una</para>
  <para style="q2" vid="JER 50:39">na̱ nkunzu n ɗa a̱ da̱nu ɗe,</para>
  <para style="q2" vid="JER 50:39">ɗe ɗa fo vori a̱ da̱nu.</para>
  <para style="q1" vid="JER 50:39">A̱ da̱shi da̱nu pe shi,</para>
  <para style="q2" vid="JER 50:39">adama a na uba̱ta̱'a̱ u to o'wo okongo</para>
  <para style="q2" vid="JER 50:39">diga a mantsa a̱ tyo a mantsa.<verse eid="JER 50:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JER 50:40" />Ununa A̱sulazuva a̱ kototoi Sodom na̱ Gomora,</para>
  <para style="q2" vid="JER 50:40">ni ilyuci i na i ri zuzu ne le,</para>
  <para style="q2" vid="JER 50:40">ne ɗa o kototo Babila.</para>
  <para style="q1" vid="JER 50:40">Babu vuma na a̱ da̱nu pe,</para>
  <para style="q2" vid="JER 50:40">babu vaɗilima̱ na a buwa uba̱ta̱'a̱.&gt;&gt;</para>
  <para style="qr" vid="JER 50:40">Ne ɗa a̱ A̱sulazuva a dammai.<verse eid="JER 50:40" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="41" style="v" sid="JER 50:41" />&lt;&lt;Ka̱lyuwa̱, a̱soja a̱ ta̱ lo a̱ ta̱wa̱</para>
  <para style="q2" vid="JER 50:41">diga o upasu wu uyagi</para>
  <para style="q1" vid="JER 50:41">iɗa i gbain na̱ ngono ma̱ a̱bunda̱ lon,</para>
  <para style="q2" vid="JER 50:41">a̱ ta̱ lo a̱ ta̱wa̱ diga o ukosu wu uvaɗi.<verse eid="JER 50:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="JER 50:42" />A̱ tu uguzu nu utan ni ibata,</para>
  <para style="q2" vid="JER 50:42">ama a avama a ɗa</para>
  <para style="q2" vid="JER 50:42">a̱ tsee ene iliyali shi ko ke'en.</para>
  <para style="q1" vid="JER 50:42">Ilama i le i ta̱ tsi ilama i mala,</para>
  <para style="q2" vid="JER 50:42">a mantsa ma na a̱ ri ukatsu e ikeke yi ido i le.</para>
  <para style="q1" vid="JER 50:42">A̱ ta̱ ta̱wusa̱ she damma ama a na a darai</para>
  <para style="q2" vid="JER 50:42">adama o uvon,</para>
  <para style="q1" vid="JER 50:42">adama a̱ riya̱ wu nu uvon,</para>
  <para style="q2" vid="JER 50:42">a̱vu Usheli Babila.<verse eid="JER 50:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="JER 50:43" />Mogono ma̱ Babila ma uwwa ta̱</para>
  <para style="q2" vid="JER 50:43">aɗa adama e le,</para>
  <para style="q2" vid="JER 50:43">reve ekere a̱ yi a̱ kuwa̱.</para>
  <para style="q1" vid="JER 50:43">A̱tsuma̱lima̱ a cina yi ta̱,</para>
  <para style="q2" vid="JER 50:43">usuɗuwu tsa ka na da̱nuyi e teri.<verse eid="JER 50:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="JER 50:44" />Ununa vu revei kamu tsu uta̱</para>
  <para style="q2" vid="JER 50:44">a̱tsumona wu Uɗolu wa̱ Urudu</para>
  <para style="q2" vid="JER 50:44">a̱vu u gba̱ra̱ oɓolo e ikyon</para>
  <para style="q2" vid="JER 50:44">diga uba̱ta̱ wa alyuna,</para>
  <para style="q1" vid="JER 50:44">ne ɗa ma̱a̱ ta̱wa̱ n gba̱ra̱ aza a Babila nu uta̱</para>
  <para style="q2" vid="JER 50:44">diga a̱tsuma̱ e iɗa'a.</para>
  <para style="q1" vid="JER 50:44">Zagbain na maa ɗangula,</para>
  <para style="q2" vid="JER 50:44">a̱ yi ɗa waa yuwan tsugono tsa̱ yi.</para>
  <para style="q1" vid="JER 50:44">Adama a na zane ɗa ri tsa̱ va̱?</para>
  <para style="q2" vid="JER 50:44">Waru zane ɗa a gura 'ya̱wa̱ na adanshi a̱ va̱?</para>
  <para style="q1" vid="JER 50:44">A te ɗa za va aaguɓa a na a gura</para>
  <para style="q2" vid="JER 50:44">isawan u yuwan tsushu'un na̱ a̱mu?&gt;&gt;<verse eid="JER 50:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="JER 50:45" />&lt;&lt;Adama o ndolo, apa ili i na A̱sulazuva</para>
  <para style="q2" vid="JER 50:45">o foɓoi a aci a Babila,</para>
  <para style="q1" vid="JER 50:45">ili i na u foɓoi e ekere</para>
  <para style="q2" vid="JER 50:45">aza a na a̱ ri nden a̱tsuma̱ a Babila.</para>
  <para style="q1" vid="JER 50:45">A̱ ta̱ gba̱ra̱ muwun nle a̱ ka̱ra̱</para>
  <para style="q2" vid="JER 50:45">reve o to kototo iɗa i le</para>
  <para style="q2" vid="JER 50:45">adama e ili i na a yuwain.<verse eid="JER 50:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="JER 50:46" />Diga na uwwa a lyuwa ta̱ Babila nu uvon</para>
  <para style="q2" vid="JER 50:46">reve uvaɗi u jinga̱ɗa̱,</para>
  <para style="q1" vid="JER 50:46">waru a ta uwwa yisali ya̱ yi</para>
  <para style="q2" vid="JER 50:46">a̱tsuma̱ a nɗa suru.&gt;&gt;<verse eid="JER 50:46" /></para>
  <chapter eid="JER 50" />
  <chapter number="51" style="c" sid="JER 51" />
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="JER 51:1" />Apa ili i na A̱sulazuva a dammai,</para>
  <para style="q2" vid="JER 51:1">&lt;&lt;Ka̱lyuwa̱ n ta̱ ta̱wa̱a̱ na̱ ruhu</para>
  <para style="q2" vid="JER 51:1">vu ukototosu a aci a Babila</para>
  <para style="q2" vid="JER 51:1">na̱ nda̱na̱ta̱ ma Babila.<verse eid="JER 51:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 51:2" />N ta̱ lyungu no omoci a̱ 'ya̱wa̱ Babila</para>
  <para style="q2" vid="JER 51:2">adama a̱ yeluwe yi,</para>
  <para style="q2" vid="JER 51:2">waru a yuwan ili i na a cigai ni iɗa'a biti,</para>
  <para style="q1" vid="JER 51:2">a̱ ta̱ ta̱wa̱ a̱ riya̱ yi mɓa̱nga̱ biti</para>
  <para style="q2" vid="JER 51:2">a̱tsuma̱ o urana wa addama a̱ yi.<verse eid="JER 51:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 51:3" />She i lyawa za vu utan</para>
  <para style="q2" vid="JER 51:3">wu nla̱ amunga o utan wa̱ yi wan,</para>
  <para style="q1" vid="JER 51:3">waru she i lyawa yi</para>
  <para style="q2" vid="JER 51:3">u oto itana yu uvon ya̱ yi wan.</para>
  <para style="q1" vid="JER 51:3">She i lyawa olobo a̱ yi wan,</para>
  <para style="q2" vid="JER 51:3">waru i kototo a̱soja a̱ yi suru suru.<verse eid="JER 51:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 51:4" />A̱ ta̱ riya̱ ukwa̱ e iɗa ya Babila,</para>
  <para style="q2" vid="JER 51:4">nu usa̱n wa̱ a̱bunda̱ a̱ lipu le a̱ re va̱ yi.<verse eid="JER 51:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 51:5" />Agba A̱sulazuva oɓolo a̱ a̱soja a zuva</para>
  <para style="q2" vid="JER 51:5">a lyawa aza a Isra'ila ko Yahuda shi,</para>
  <para style="q2" vid="JER 51:5">waru a̱mu ɗa A̱sula̱ e le.</para>
  <para style="q1" vid="JER 51:5">Ko na wo o'woi iɗa i le</para>
  <para style="q2" vid="JER 51:5">i shiwan ta̱ nu unusu,</para>
  <para style="q2" vid="JER 51:5">unusu u na a yuwaan numu,</para>
  <para style="q2" vid="JER 51:5">a̱mu za va Akiza a Isra'ila.&gt;&gt;<verse eid="JER 51:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JER 51:6" />&lt;&lt;I suma diga a̱tsuma̱ a Babila</para>
  <para style="q2" vid="JER 51:6">za suru suma adama a wuma wa̱ yi!</para>
  <para style="q1" vid="JER 51:6">Adama she o kototo ɗu</para>
  <para style="q2" vid="JER 51:6">adama o unusu wa Babila wan!</para>
  <para style="q1" vid="JER 51:6">Adama a na mantsa ma yuwan ta̱</para>
  <para style="q2" vid="JER 51:6">a na A̱sulazuva e ge'eto yi,</para>
  <para style="q1" vid="JER 51:6">u ta yuwan atsupu a aci yi</para>
  <para style="q2" vid="JER 51:6">o una̱ wu linga va̱ yi.<verse eid="JER 51:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 51:7" />Ɗe nu ufaru Babila da̱na̱ ta̱</para>
  <para style="q2" vid="JER 51:7">cine revei mokkoto ma Zinariya</para>
  <para style="q2" vid="JER 51:7">o ukere wa̱ A̱sulazuva.</para>
  <para style="q1" vid="JER 51:7">U zuwa ta̱ uvaɗi suru wo o'wo usowu,</para>
  <para style="q2" vid="JER 51:7">nɗa mu uvaɗi n sowo ta̱</para>
  <para style="q2" vid="JER 51:7">masayan ma̱ ina̱bi va̱ yi</para>
  <para style="q2" vid="JER 51:7">reve o o'wo ujaru.<verse eid="JER 51:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 51:8" />Babu ufaru Babila riya̱ ta̱ reve wu kuɗa</para>
  <para style="q2" vid="JER 51:8">i shon adama a̱ yi!</para>
  <para style="q1" vid="JER 51:8">I zamiya yi a̱guma̱ adama antsu a̱ yi,</para>
  <para style="q2" vid="JER 51:8">u ta gura o o'wo u tsura̱ opocino.<verse eid="JER 51:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 51:9" />Tsu shi ta̱ a yuwaan Babila opocino,</para>
  <para style="q2" vid="JER 51:9">amma wa̱ tsura̱ lafiya shi,</para>
  <para style="q1" vid="JER 51:9">tsu rungwa̱ niyi kpen,</para>
  <para style="q2" vid="JER 51:9">za suru ka̱mba̱ a̱ wa̱ta̱ wa̱ yi,</para>
  <para style="q1" vid="JER 51:9">adama a na uge'etosu wa̱ yi</para>
  <para style="q2" vid="JER 51:9">u rawa ta̱ zuva va zuva</para>
  <para style="q1" vid="JER 51:9">u 'yon zuva</para>
  <para style="q2" vid="JER 51:9">hali acina eleshe.<verse eid="JER 51:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 51:10" />A̱sulazuva a wawa tsu ta̱</para>
  <para style="q2" vid="JER 51:10">ta̱wa̱ yi tsu yuwain adanshi a̱ yi</para>
  <para style="q2" vid="JER 51:10">a̱tsuma̱ a̱ Sihiyona,</para>
  <para style="q1" vid="JER 51:10">tsu dammai ili i na A̱sulazuva</para>
  <para style="q2" vid="JER 51:10">a̱ A̱sula̱ a̱ tsu a yuwain.&gt;&gt;<verse eid="JER 51:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 51:11" />&lt;&lt;Nan yali a̱ a̱soja a damma ta̱,</para>
  <para style="q2" vid="JER 51:11">tewen yi ibata i ɗu!</para>
  <para style="q2" vid="JER 51:11">Reve i tara a̱ra̱ga̱ a̱ ɗu!</para>
  <para style="q1" vid="JER 51:11">Adama a na A̱sulazuva a̱ 'ya̱sa̱n ta̱</para>
  <para style="q2" vid="JER 51:11">ruhu va̱ a̱za̱ o tsugono tsa Midiya</para>
  <para style="q1" vid="JER 51:11">adama a na ifoɓi ya̱ yi</para>
  <para style="q2" vid="JER 51:11">a̱ yi ɗa u kototo Babila.</para>
  <para style="q1" vid="JER 51:11">A̱sulazuva a ta yuwan atsupu,</para>
  <para style="q2" vid="JER 51:11">atsupu adama a̱ A̱a̱'isa̱mapaɗa a̱ yi.<verse eid="JER 51:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 51:12" />'Ya̱sa̱in atuta</para>
  <para style="q2" vid="JER 51:12">i teme o ɓuɓosuso kari va Babila!</para>
  <para style="q1" vid="JER 51:12">Waru i da̱shi ucira wa̱ a̱za̱ e ipiri,</para>
  <para style="q2" vid="JER 51:12">a̱vu fo yi shuwa̱ a̱za̱ e ipiri a̱ ba̱ta̱ le,</para>
  <para style="q2" vid="JER 51:12">reve i vawan yi!</para>
  <para style="q1" vid="JER 51:12">Adama a na A̱sulazuva o to shiton</para>
  <para style="q2" vid="JER 51:12">ili i na u dammai,</para>
  <para style="q2" vid="JER 51:12">udamma wa̱ yi a aci a ama a Babila.<verse eid="JER 51:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 51:13" />A̱vu na vu ri nden zuzu</para>
  <para style="q2" vid="JER 51:13">nu uba̱ta̱ u na u ri na̱ mini ma̱ a̱bunda̱,</para>
  <para style="q1" vid="JER 51:13">a̱vu na vu ri nu utsuru wa̱ a̱bunda̱,</para>
  <para style="q2" vid="JER 51:13">ukosu wa̱ wu u ta̱wa̱ ta̱.</para>
  <para style="q2" vid="JER 51:13">Mantsa ma na o kototo wu yuwan ta̱.<verse eid="JER 51:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 51:14" />A̱sulazuva oɓolo a̱ a̱soja a zuva</para>
  <para style="q2" vid="JER 51:14">a kucina ta̱ na aciya̱yi u damma,</para>
  <para style="q1" vid="JER 51:14">na amayun n ta̱ shiton wu na ama</para>
  <para style="q2" vid="JER 51:14">she damma oɓolo akyun,</para>
  <para style="q1" vid="JER 51:14">agba a̱ ta̱ 'ya̱sa̱n uɗyo wu ulyuwu wa a aci,</para>
  <para style="q2" vid="JER 51:14">a na a̱ tsura̱i a aci a̱ wu.&gt;&gt;<verse eid="JER 51:14" /></para>
  <para style="r">(<ref loc="JER 10:12-16">Irm 10:12-16</ref>)</para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JER 51:15" />&lt;&lt;U yuwan ta̱ uvaɗi a̱tsuma̱ o ucira wa̱ yi,</para>
  <para style="q2" vid="JER 51:15">reve u shuwa̱ uvaɗi a̱tsuma̱ o ugbozu wa̱ yi,</para>
  <para style="q2" vid="JER 51:15">a̱vu fo u polo zuva va zuva a̱tsuma̱ o urevu wa̱ yi.<verse eid="JER 51:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 51:16" />A mantsa ma na u yuwain tsata,</para>
  <para style="q2" vid="JER 51:16">mini ma zuva va zuva ma̱ tsu gugwa̱ ta̱.</para>
  <para style="q1" vid="JER 51:16">U tsu zuwa ta̱ eleshe a̱ 'yon</para>
  <para style="q2" vid="JER 51:16">diga o ukosu wu uvaɗi.</para>
  <para style="q1" vid="JER 51:16">U tsu lyungu ta̱ ni imaɗatsu</para>
  <para style="q2" vid="JER 51:16">oɓolo ni iro'i</para>
  <para style="q1" vid="JER 51:16">waru u tsu lapa ta̱ upepu,</para>
  <para style="q2" vid="JER 51:16">diga o u'wa wi izuwa ya̱ yi.<note caller="-" style="x"><char style="xo" closed="false">51:16 </char><char style="xt" closed="false"><ref loc="PSA 135:7">Ica 135:7</ref>.</char></note><verse eid="JER 51:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 51:17" />Za suru ri nu ugbozu shi,</para>
  <para style="q2" vid="JER 51:17">waru u ri nu urevu shi,</para>
  <para style="q1" vid="JER 51:17">za vu uruma u zinariya suru,</para>
  <para style="q2" vid="JER 51:17">u tsu sowo ta̱ wono diga a̱ a̱ma̱li a̱ yi.</para>
  <para style="q1" vid="JER 51:17">Iroci ya̱ yi epen a ɗa,</para>
  <para style="q2" vid="JER 51:17">a̱ ri na̱ wivuwun a̱tsuma̱ e le shi.<verse eid="JER 51:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 51:18" />A̱ ri nu urana shi,</para>
  <para style="q2" vid="JER 51:18">ili ya avandaru i ɗa goon,</para>
  <para style="q1" vid="JER 51:18">mantsa ma na uge'etosu u le u rawai,</para>
  <para style="q2" vid="JER 51:18">a̱ ta̱ kuwa̱.<verse eid="JER 51:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 51:19" />A̱sula̱ a na a̱yi ɗa akunda agadu a Yakubu,</para>
  <para style="q2" vid="JER 51:19">u ri tsa̱ musula̱ nda shi,</para>
  <para style="q1" vid="JER 51:19">adama a na a̱ yi ɗa u yuwain ili biti</para>
  <para style="q2" vid="JER 51:19">oɓolo nu ugundo wa agadu a̱ yi.</para>
  <para style="qr" vid="JER 51:19">A̱sulazuva oɓolo a̱ a̱soja a zuva a ɗa ala a̱ yi.&gt;&gt;<verse eid="JER 51:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JER 51:20" />&lt;&lt;A̱sulazuva a damma ta̱,</para>
  <para style="q2" vid="JER 51:20">a̱vu ɗa itana yu uvon i va̱,</para>
  <para style="q2" vid="JER 51:20">aaɗanga o uvon u va̱,</para>
  <para style="q1" vid="JER 51:20">na̱ a̱vu ɗa m bete'wei nɗa mu uvaɗi suru,</para>
  <para style="q2" vid="JER 51:20">waru na̱ a̱vu ɗa n kototoi tsugono tsu uvaɗi.<verse eid="JER 51:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 51:21" />Na̱ a̱vu ɗa m bete'wei ido</para>
  <para style="q2" vid="JER 51:21">na aza a na a kumbusa le,</para>
  <para style="q1" vid="JER 51:21">na̱ a̱vu ɗa fo m bete'wei ikeke yi ido,</para>
  <para style="q2" vid="JER 51:21">na aza a na a kumbusa le.<verse eid="JER 51:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 51:22" />Na̱ a̱vu ɗa m bete'wei vali na̱ ka,</para>
  <para style="q2" vid="JER 51:22">waru na̱ a̱vu ɗa m bete'wei abara nu ulobo,</para>
  <para style="q2" vid="JER 51:22">na̱ a̱vu ɗa fo m bete'wei ulobo nu usheli.<verse eid="JER 51:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 51:23" />Na̱ a̱vu ɗa m bete'wei za va aguɓa</para>
  <para style="q2" vid="JER 51:23">no oɓolo e ikyon ya̱ yi,</para>
  <para style="q1" vid="JER 51:23">na̱ a̱vu ɗa m bete'wei cimbi</para>
  <para style="q2" vid="JER 51:23">ni inan yi iluma ya̱ yi,</para>
  <para style="q1" vid="JER 51:23">waru na̱ a̱vu ɗa m bete'wei nan gwamna</para>
  <para style="q2" vid="JER 51:23">na azagbain a̱ yi.&gt;&gt;<verse eid="JER 51:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="JER 51:24" />&lt;&lt;E esu ɗu a ɗa maa tsupa a aci a Babila na a aci a̱ nda̱na̱ta̱ ma aza a Babila suru, adama e iwuya i na a yuwain suru, a̱tsuma̱ a̱ Sihiyona,&gt;&gt;</para>
  <para style="qr" vid="JER 51:24">ne ɗa A̱sulazuva a dammai.<verse eid="JER 51:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="JER 51:25" />&lt;&lt;Ka̱lyuwa̱, n ta̱ tsushu'un na̱ a̱vu,</para>
  <para style="q2" vid="JER 51:25">a̱ba̱jini a masasan mo ukototosu,</para>
  <para style="q1" vid="JER 51:25">a̱vu na vu kototoi uvaɗi ma̱ɓula̱,</para>
  <para style="q2" vid="JER 51:25">n ta canana ukere u va̱ a̱ nla̱ngi na̱ vu,</para>
  <para style="q1" vid="JER 51:25">n ta̱ keɓe wu vu bunda̱la̱</para>
  <para style="q2" vid="JER 51:25">diga zuva a̱ tyo e iɗa,</para>
  <para style="q2" vid="JER 51:25">waru n kula̱to wu vu la̱nga̱.</para>
  <para style="qr" vid="JER 51:25">ne ɗa A̱sulazuva a dammai.<verse eid="JER 51:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 51:26" />A̱ da̱shi tsura̱ aatali a sa'ani</para>
  <para style="q2" vid="JER 51:26">a na a vara ikyun yu ucira yu usaa shi,</para>
  <para style="q1" vid="JER 51:26">ko a̱a̱ tsura̱ aatali a na</para>
  <para style="q2" vid="JER 51:26">a vara ikyun yu usaa shi,</para>
  <para style="q2" vid="JER 51:26">adama a na aatali'i a̱ da̱na̱ nu urana shi hali hali.</para>
  <para style="qr" vid="JER 51:26">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 51:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="JER 51:27" />&lt;&lt;Ya̱sa̱in atuta e iɗa'a,</para>
  <para style="q2" vid="JER 51:27">yi ivula̱a̱ nɗa mu uvaɗi avana!</para>
  <para style="q1" vid="JER 51:27">I foɓo nɗa adama a yuwan uvon na̱ yi,</para>
  <para style="q2" vid="JER 51:27">i ɗe tsugono tsu uvaɗi</para>
  <para style="q2" vid="JER 51:27">adama a̱ riya̱a̱ yi nu uvon,</para>
  <para style="q1" vid="JER 51:27">i ɗe Arara na̱ Minni na̱ Ashekenaza,</para>
  <para style="q2" vid="JER 51:27">i zuwa yali yu uvon</para>
  <para style="q2" vid="JER 51:27">i rono a̱soja aaɗanga adama a̱ yi,</para>
  <para style="q1" vid="JER 51:27">i zuwa ido i ɓa̱tsa̱</para>
  <para style="q2" vid="JER 51:27">tso oɓolo akyun.<verse eid="JER 51:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 51:28" />I foɓo nɗa adama a yuwan uvon na̱ yi,</para>
  <para style="q2" vid="JER 51:28">i foɓo ngono ma aza a Midiya</para>
  <para style="q2" vid="JER 51:28">na̱ nan gwamna e le oɓolo na azagbain e le,</para>
  <para style="q2" vid="JER 51:28">ni iɗa i na i ri za̱la̱ tsugono tsa̱ le suru.<verse eid="JER 51:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 51:29" />Iɗa'a i jinga̱ɗa̱ ta̱,</para>
  <para style="q2" vid="JER 51:29">u ta̱ o uje'en adama a̱ a̱tsuma̱lima̱,</para>
  <para style="q1" vid="JER 51:29">adama a na A̱sulazuva o to shiton</para>
  <para style="q2" vid="JER 51:29">ifoɓi ya̱ yi a aci a Babila,</para>
  <para style="q1" vid="JER 51:29">ifoɓi i na wa̱a̱ ka̱mbuwa̱i okongo</para>
  <para style="q2" vid="JER 51:29">uba̱ta̱ u na babu pe za.<verse eid="JER 51:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 51:30" />Nan yali o uvon a Babila a lyawa ta̱ uvon,</para>
  <para style="q2" vid="JER 51:30">reve a̱ da̱nu a̱tsuma̱ a̱ ba̱ta̱ vu ucira le,</para>
  <para style="q1" vid="JER 51:30">ucira u le u koto ta̱,</para>
  <para style="q2" vid="JER 51:30">reve o o'wo tsa̱ a̱ma̱ci,</para>
  <para style="q1" vid="JER 51:30">na a zuwai ba̱ta̱ vu nden n le akina,</para>
  <para style="q2" vid="JER 51:30">waru a kuɗa ta̱ irumu yi na̱ntsu i ilyuci'i.<verse eid="JER 51:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 51:31" />Aza a na a tsu yuwan uro shi</para>
  <para style="q2" vid="JER 51:31">a̱ ta̱ ntoniloi,</para>
  <para style="q1" vid="JER 51:31">malingata ma̱ ta̱ e itoni</para>
  <para style="q2" vid="JER 51:31">i malingata babu uro,</para>
  <para style="q1" vid="JER 51:31">adama a̱a̱ 'ya̱wa̱a̱</para>
  <para style="q2" vid="JER 51:31">mogono ma Babila ni ikaka ana,</para>
  <para style="q2" vid="JER 51:31">a̱ ka̱nda̱ruwa̱ ta̱ lyuci'i suru nu uvon.<verse eid="JER 51:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 51:32" />A usa ta̱ ba̱ta̱ vu pasata n mini suru,</para>
  <para style="q2" vid="JER 51:32">a̱vu fo a daɓa a̱rumbu na akina</para>
  <para style="q2" vid="JER 51:32">waru a̱ a̱soja a uwwa ta̱ wovon.<verse eid="JER 51:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 51:33" />Adama a na apa ili i na A̱sulazuva oɓolo a̱ a̱soja a zuva</para>
  <para style="q2" vid="JER 51:33">A̱sula̱ a Isra'ila dammai,</para>
  <para style="q1" vid="JER 51:33">Usheli u va̱ Babila</para>
  <para style="q2" vid="JER 51:33">u ta̱ tso osoroto,</para>
  <para style="q2" vid="JER 51:33">uba̱ta̱ u na o foɓoi ishina adama a faba,</para>
  <para style="q2" vid="JER 51:33">aa jima shi mantsa ma na a faba yi ta̱ ta̱wa̱.&gt;&gt;<verse eid="JER 51:33" /></para>
  <para style="s">Ikambishi ya̱ A̱sulazuva i ta̱ ta̱wa̱a̱ nu uzuwu wo okolo</para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="JER 51:34" />&lt;&lt;Nebukanaza mogono ma Babila</para>
  <para style="q2" vid="JER 51:34">ma lyuwa tsu ta̱ nu uvon,</para>
  <para style="q1" vid="JER 51:34">waru u zuwa tsu ta̱ a̱tsuma̱ o urupulu,</para>
  <para style="q2" vid="JER 51:34">a̱vu wo o'woto tsu</para>
  <para style="q2" vid="JER 51:34">tsa̱ a̱ka̱bu a na a̱ ri ni ili shi.</para>
  <para style="q1" vid="JER 51:34">U soɗu tsu ta̱ cine a agangu a tsu yuwan,</para>
  <para style="q2" vid="JER 51:34">reve u shiton a̱a̱tsuma̱ a̱ yi</para>
  <para style="q2" vid="JER 51:34">ni ilyalya i na tsu tsu lyuwusa,</para>
  <para style="q2" vid="JER 51:34">a̱vu u shaama tsu.<verse eid="JER 51:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="JER 51:35" />Lyawa nda̱na̱ta̱ ma̱ Sihiyona n damma,</para>
  <para style="q2" vid="JER 51:35">lyawa A̱sula̱ a zuwa ulungusu</para>
  <para style="q2" vid="JER 51:35">u na Babila yuwaan numu</para>
  <para style="q2" vid="JER 51:35">ka̱mba̱ aci a̱ yi!&gt;&gt;</para>
  <para style="q1" vid="JER 51:35">Lyawa fo nda̱na̱ta̱ ma̱ Urishelima n damma,</para>
  <para style="q2" vid="JER 51:35">&lt;&lt;Lyawa alaki a mpasa ntsu</para>
  <para style="q2" vid="JER 51:35">n da̱na̱ a aci a̱ nda̱na̱ta̱ ma Babila.&gt;&gt;<verse eid="JER 51:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 51:36" />&lt;&lt;Adama o ndolo, apa ili i na A̱sulazuva a dammai,</para>
  <para style="q2" vid="JER 51:36">ka̱lyuwa̱, n ta̱ ee isawaan ɗu,</para>
  <para style="q2" vid="JER 51:36">reve n tsupaa ɗu,</para>
  <para style="q1" vid="JER 51:36">n ta zuwa mala ma Babila me 'yewe,</para>
  <para style="q2" vid="JER 51:36">a̱vu fo n zuwa esu a̱ mini a̱ yi a kwan.<verse eid="JER 51:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 51:37" />Babila to o'wo edemu everi,</para>
  <para style="q2" vid="JER 51:37">uba̱ta̱ wu nden n musa̱n mu una,</para>
  <para style="q1" vid="JER 51:37">oɓolo ni ili i wovon ni ili i macuru,</para>
  <para style="q2" vid="JER 51:37">waru uba̱ta̱ u na babu pe za.<verse eid="JER 51:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 51:38" />Ama a Babila a ta yuwan ilama</para>
  <para style="q2" vid="JER 51:38">cine vu revei kamu,</para>
  <para style="q1" vid="JER 51:38">waru a yuwan yisali</para>
  <para style="q2" vid="JER 51:38">cine vu revei muwun mi ikamu.<verse eid="JER 51:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="JER 51:39" />Amma a mantsa ma na a jisan n le,</para>
  <para style="q2" vid="JER 51:39">n ta̱ foɓoo le ilyalya ya̱ a̱buki,</para>
  <para style="q1" vid="JER 51:39">reve n zuwa le osowo</para>
  <para style="q2" vid="JER 51:39">o o'wo usowu,</para>
  <para style="q1" vid="JER 51:39">adama a yuwan yisali ni izo'oshi,</para>
  <para style="q2" vid="JER 51:39">reve a uwa a lantsa,</para>
  <para style="q2" vid="JER 51:39">nlavu n na a juwan shi.</para>
  <para style="qr" vid="JER 51:39">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 51:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JER 51:40" />N ta̱ cipa̱ na̱ le a̱ tyo uba̱ta̱ u mapaɗa,</para>
  <para style="q2" vid="JER 51:40">tsa̱ a̱giri'i ni ikyon na̱ nga̱ji.<verse eid="JER 51:40" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="41" style="v" sid="JER 51:41" />&lt;&lt;Ununa a lyuwa Babila nu uvon</para>
  <para style="q2" vid="JER 51:41">uvaɗi ma̱ɓula̱ u ta lyawa uvaɗu!</para>
  <para style="q1" vid="JER 51:41">Babila to o'wo ili yi idaba a̱tsuma̱ a nɗa!<verse eid="JER 51:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="JER 51:42" />Mala ma̱ 'yon ta̱,</para>
  <para style="q2" vid="JER 51:42">reve u ɓa̱ru Babila,</para>
  <para style="q1" vid="JER 51:42">ikeɗu i mini mo ujaru,</para>
  <para style="q2" vid="JER 51:42">ma̱ ta̱ ɓa̱ru yi.<verse eid="JER 51:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="JER 51:43" />Ilyuci ya̱ yi yo o'wo ta̱ okongo,</para>
  <para style="q2" vid="JER 51:43">iɗa yu u'yewu na̱ a̱tsumona,</para>
  <para style="q2" vid="JER 51:43">iɗa i na babu pe za,</para>
  <para style="q2" vid="JER 51:43">waru babu vaɗilima̱ na a ɓatsaa na̱ pe.<verse eid="JER 51:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="JER 51:44" />N ta̱ ca Bel ma̱sula̱ ma Babila oforo,</para>
  <para style="q2" vid="JER 51:44">a̱vu n zuwa yi u shaama ili i na u soɗu yi.</para>
  <para style="q1" vid="JER 51:44">Nɗa m buwa a suma a̱ tyo ya̱'a̱ yi shi,</para>
  <para style="q2" vid="JER 51:44">na amayun, ukari wa Babila u to oco!&gt;&gt;<verse eid="JER 51:44" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="45" style="v" sid="JER 51:45" />&lt;&lt;A̱ɗu ama a̱ va̱,</para>
  <para style="q2" vid="JER 51:45">uta̱i diga a̱tsuma̱ a Babila!</para>
  <para style="q1" vid="JER 51:45">Za suru suma adama a wuma wa̱ yi,</para>
  <para style="q2" vid="JER 51:45">i suma diga o upan wu usuɗu wa̱ A̱sulazuva!<verse eid="JER 51:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="JER 51:46" />Gogo, she yu uta̱a̱ okolo</para>
  <para style="q2" vid="JER 51:46">ko yu uwwa wovon wan,</para>
  <para style="q1" vid="JER 51:46">adama adanshi e keke'en a na a uwwusa</para>
  <para style="q2" vid="JER 51:46">a̱tsuma̱ e iɗa'a wan.</para>
  <para style="q1" vid="JER 51:46">Adanshi e keke'en aa'wan a nda</para>
  <para style="q2" vid="JER 51:46">ko'o ɗa na adanshi e keke'en aa'wan o ro,</para>
  <para style="q1" vid="JER 51:46">na adanshi e keke'en</para>
  <para style="q2" vid="JER 51:46">o 'ya̱susa̱n wu ugbozu wi iɗa'a,</para>
  <para style="q1" vid="JER 51:46">Adanshi e keke'en o mogono ma̱ ndeɗe</para>
  <para style="q2" vid="JER 51:46">ma̱ 'yon ta̱ tsushu'un</para>
  <para style="q2" vid="JER 51:46">na̱ mogono ma̱ ndeɗe.<verse eid="JER 51:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="JER 51:47" />Adama o ndolo, rana ta̱ lo a̱ ta̱wa̱,</para>
  <para style="q2" vid="JER 51:47">a na ma ca musula̱ ma Babila oforo,</para>
  <para style="q1" vid="JER 51:47">iɗa'a suru u to sowo wono,</para>
  <para style="q2" vid="JER 51:47">waru a̱ a̱kwa̱kwa̱ a ama a̱ yi a na o unai</para>
  <para style="q2" vid="JER 51:47">a̱ ta̱ da̱na̱ uba̱ta̱ suru a̱tsuma̱ e iɗa'a.<verse eid="JER 51:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="JER 51:48" />Zuva ni iɗa,</para>
  <para style="q2" vid="JER 51:48">ni ili i na i ri pe a̱tsuma̱ e le suru,</para>
  <para style="q2" vid="JER 51:48">a ta yuwan yisali i ma̱za̱nga̱ a aci a Babila,</para>
  <para style="q1" vid="JER 51:48">adama a na ozo o ukototosu a̱ ta̱ riya̱a̱ yi</para>
  <para style="q2" vid="JER 51:48">diga upasu wu ugana.</para>
  <para style="qr" vid="JER 51:48">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 51:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="JER 51:49" />Na amayun Babila ta̱ riya̱</para>
  <para style="q2" vid="JER 51:49">adama ama a Isra'ila a na o unai.</para>
  <para style="q1" vid="JER 51:49">Ununa aza a na o unai a̱tsuma̱ o uvaɗi suru,</para>
  <para style="q2" vid="JER 51:49">a̱ riya̱i e ekere a Babila.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">51:49 </char><char style="xt" closed="false"><ref loc="REV 18:24">Wen 18:24</ref>.</char></note><verse eid="JER 51:49" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="50" style="v" sid="JER 51:50" />&lt;&lt;A̱ɗu na i ri e ilaɗi adama i la'a</para>
  <para style="q2" vid="JER 51:50">ekere a matsun me pe'eni,</para>
  <para style="q2" vid="JER 51:50">Suma yi! She yi isawan wan!</para>
  <para style="q1" vid="JER 51:50">I cuwan na̱ A̱sulazuva,</para>
  <para style="q2" vid="JER 51:50">ko na wo o'woi i ta̱ ɗe e iɗa ya alanga,</para>
  <para style="q2" vid="JER 51:50">i da̱na̱ a cuwusan na̱ Urishelima.<verse eid="JER 51:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="JER 51:51" />&lt;Tsu sowo ta̱ wono lon,</para>
  <para style="q2" vid="JER 51:51">adama o ulamu u na a yuwaan ntsu,</para>
  <para style="q1" vid="JER 51:51">adama a na omoci a uwa ta̱ ba̱ta̱ va akiza</para>
  <para style="q2" vid="JER 51:51">a̱tsuma̱ o u'wa wa̱ A̱sulazuva!&gt; &gt;&gt;<verse eid="JER 51:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="JER 51:52" />&lt;&lt;Amma adama o ndolo,</para>
  <para style="q2" vid="JER 51:52">rana ta̱ lo a̱ ta̱wa̱,</para>
  <para style="q2" vid="JER 51:52">a na ma ca musula̱ ma Babila oforo,</para>
  <para style="q1" vid="JER 51:52">aza a na a uwwai usa̱n</para>
  <para style="q2" vid="JER 51:52">a̱tsuma̱ e iɗa ya̱ yi suru</para>
  <para style="q2" vid="JER 51:52">a̱ ta̱ da̱na̱ a̱ ma̱nga̱.&gt;&gt;</para>
  <para style="qr" vid="JER 51:52">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 51:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="JER 51:53" />&lt;&lt;Ko na̱ shi aza a Babila a kumba a̱ tyo zuva,</para>
  <para style="q2" vid="JER 51:53">a suwa atsura o ucira ɗe,</para>
  <para style="q1" vid="JER 51:53">na̱ ne suru, n ta̱ lyungu wa̱ yi,</para>
  <para style="q2" vid="JER 51:53">na̱ a̱za̱ o ukototosu.&gt;&gt;</para>
  <para style="qr" vid="JER 51:53">Ne ɗa A̱sulazuva a dammai.<verse eid="JER 51:53" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="54" style="v" sid="JER 51:54" />&lt;&lt;Uwwai uɗyo u mesun</para>
  <para style="q2" vid="JER 51:54">a̱tsuma̱ a Babila,</para>
  <para style="q1" vid="JER 51:54">ni ilama ya̱ a̱ba̱jini o ukototosu</para>
  <para style="q2" vid="JER 51:54">diga a̱tsuma̱ a Babila!<verse eid="JER 51:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="JER 51:55" />Adama a na a̱ A̱sulazuva a̱ ta̱ kototo Babila,</para>
  <para style="q2" vid="JER 51:55">u ta zuwa yi u ɓa̱na̱ una̱ wu uvaɗu wa̱ yi.</para>
  <para style="q1" vid="JER 51:55">A̱soja a̱ ta̱ da̱na̱ a̱ zura̱sa̱ tsi ikeɗu i mala</para>
  <para style="q2" vid="JER 51:55">a̱ 'ya̱susa̱n ɗyo le.<verse eid="JER 51:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="JER 51:56" />Adama a na za vu ukototosu</para>
  <para style="q2" vid="JER 51:56">riya̱a̱ ta̱ Babila,</para>
  <para style="q1" vid="JER 51:56">a̱ ta̱ reme a̱ a̱soja a̱ yi,</para>
  <para style="q2" vid="JER 51:56">reve a kuɗa tan le suru.</para>
  <para style="q1" vid="JER 51:56">Adama a na A̱sulazuva, A̱sula̱ atsupu a ɗa,</para>
  <para style="q2" vid="JER 51:56">waru u ta yuwan atsupu e mejege.<verse eid="JER 51:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="JER 51:57" />N ta zuwa azagbain a̱ yi</para>
  <para style="q2" vid="JER 51:57">na̱ a̱za̱ o urevu a̱ yi,</para>
  <para style="q1" vid="JER 51:57">na̱ nan gwamna a̱ yi</para>
  <para style="q2" vid="JER 51:57">na̱ a̱soja a̱ yi</para>
  <para style="q2" vid="JER 51:57">na̱ nan yali ya̱ a̱soja a̱ yi o sowo,</para>
  <para style="q1" vid="JER 51:57">o o'wo usowu hali a lantsa,</para>
  <para style="q2" vid="JER 51:57">nlavu n na a juwan shi.</para>
  <para style="q1" vid="JER 51:57">Ne ɗa mogono za na ala a̱ yi ɗa</para>
  <para style="q2" vid="JER 51:57">A̱sulazuva mogono mo oɓolo a̱ a̱soja a zuva dammai.<verse eid="JER 51:57" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="58" style="v" sid="JER 51:58" />&lt;&lt;Apa ili i na A̱sulazuva</para>
  <para style="q2" vid="JER 51:58">oɓolo a̱ a̱soja a zuva dammai,</para>
  <para style="q1" vid="JER 51:58">ukari wu uga'an u nda wa Babila,</para>
  <para style="q2" vid="JER 51:58">o to ɓosoi hali a̱ tyo e iɗa,</para>
  <para style="q1" vid="JER 51:58">na̱ntsu va̱ yi vu ga'an nda,</para>
  <para style="q2" vid="JER 51:58">a̱ ta̱ kula̱to le na akina.</para>
  <para style="q1" vid="JER 51:58">Ukadu wa ama e le</para>
  <para style="q2" vid="JER 51:58">u to o'wo pere</para>
  <para style="q1" vid="JER 51:58">atakaci a nɗa mu uvaɗi</para>
  <para style="q2" vid="JER 51:58">u to o'wo ili i na akina a lyuwa.&gt;&gt;<verse eid="JER 51:58" /></para>
  <para style="b" />
  <para style="p">
    <verse number="59" style="v" sid="JER 51:59" />A̱yi nda a̱ yi ɗa ikaka i na Irimiya vumava̱sula̱ cayi Seraya ulobo wa̱ Neriya ulobo wa Ma'aseya, a mantsa ma na u ka̱ra̱i oɓolo na̱ Zedekiya mogono ma Yahuda, a̱ tyo Babila a̱tsuma̱ aa'wan a̱ na̱shi o tsugono tsa̱ a̱ yi. Waru Seraya ɗa da̱na̱i zagbain na e idanasa u ucu'watan wo omoci. <verse eid="JER 51:59" /><verse number="60" style="v" sid="JER 51:60" />Irimiya ɗana ta̱ a̱tsuma̱ a aatagada o ukutsuluwu suru addama a na aa cina Babila, a̱ yi adanshi a na a ɗanai suru a aci a Babila. <verse eid="JER 51:60" /><verse number="61" style="v" sid="JER 51:61" />Reve Irimiya damma Seraya, &lt;&lt;Mantsa ma na vu rawai Babila, vu reve vu ɗe ta̱ nu una̱ wi idanshi i nda suru za suru a uwwusa. <verse eid="JER 51:61" /><verse number="62" style="v" sid="JER 51:62" />A̱vu vu damma, &lt;A̱sulazuva a̱vu ɗa vu yuwain adanshi adama o uba̱ta̱ nda, adansa, vu ta̱ kototo yi, hali na babu ili i na ya̱a̱ da̱nu pe, ko vuma ko iliyamunga. Uba̱ta̱'a̱ u to o'wo okongo hali hali.&gt; <verse eid="JER 51:62" /><verse number="63" style="v" sid="JER 51:63" />A mantsa ma na vu kotoi ɗesununa̱ diga a̱tsuma̱ aatagada o ukutsuluwu'u, reve vu nla̱a̱ yi aatali, vu variyi a̱tsuma̱ a̱ mini ma Yufiriti. <verse eid="JER 51:63" /><verse number="64" style="v" sid="JER 51:64" />Reve vu damma, &lt;Ne ɗa Babila a liɓa, waru wa̱a̱ da̱shi 'yon shi, adama a̱tsuma̱lima̱ a na ma̱a̱ ta̱wa̱a̱ yi. Waru a ama a̱ yi a̱ ta̱ kuwa̱.&gt; &gt;&gt;</para>
  <para style="p" vid="JER 51:64">A̱yi nda a̱ yi ɗa ukosu wi idanshi ya Irimiya vumava̱sula̱.<verse eid="JER 51:64" /></para>
  <chapter eid="JER 51" />
  <chapter number="52" style="c" sid="JER 52" />
  <para style="s">A̱risa̱ a̱ Urishelima</para>
  <para style="r">(<ref loc="2KI 24:18">2 Ngo 24:18</ref>; <ref loc="2KI 25:7">25:7</ref>; <ref loc="2CH 36:11-16">2 Alb 36:11-16</ref>,<ref loc="2CH 36:17-20">17-20</ref>; <ref loc="JER 39:1-10">Irm 39:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 52:1" />Zedekiya da̱na̱ ta̱ na̱ aa'wan ushin na̱ za ta̱ a mantsa ma na u temei tsugono. U yuwan ta̱ tsugono a̱tsuma̱ a̱ Urishelima a'wan kupa na̱ za ta̱. Aala mma va̱ yi ɗa Hamuta usheli u vuma ro na a tsu ɗe Irimiya vuma va Libina. <verse eid="JER 52:1" /><verse number="2" style="v" sid="JER 52:2" />U yuwan ta̱ iwuya elime a̱ A̱sulazuva, ununa mogono Jehoyakim yuwain. <verse eid="JER 52:2" /><verse number="3" style="v" sid="JER 52:3" />Na amayun Urishelima na̱ Yahuda a zuwa ta̱ A̱sulazuva a yuwan upan, hali u tawa le diga a̱ ma̱ka̱nka̱ ma̱ yi.</para>
  <para style="p" vid="JER 52:3">Zedekiya gba 'ya̱sa̱a̱n ta̱ mogono ma Babila a aci. <verse eid="JER 52:3" /><verse number="4" style="v" sid="JER 52:4" />A̱tsuma̱ a aa'wan a̱ kucci o tsugono tso o mogono Zedekiya, o urana wa kupa o woto wa kupa, a̱vu Nebukanaza mogono ma Babila ta̱wa̱ na̱ a̱soja a̱ yi suru adama a na a yuwan uvon a̱tsuma̱ a̱ Urishelima. A̱vu u uka̱nda̱ruwa̱ lyuci'i nu uvon, a̱vu a suwa ukari a̱ ka̱nda̱ruwa̱ adama o uvon. <verse eid="JER 52:4" /><verse number="5" style="v" sid="JER 52:5" />Lyuci'i u da̱na̱ ta̱ uka̱nda̱ruwu na̱ a̱ a̱soja o uvon, hali acina a'wan kupa na̱ za ta̱ o tsugono tso mogono Zedekiya.<verse eid="JER 52:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 52:6" />O urana wa̱ kucci o woto wa̱ na̱shi, a mantsa ma na ambulu a yuwain a̱bunda̱ lon a̱tsuma̱ a̱ lyuci'i, hali na babu ilyalya i na a ama a lyuwa, <verse eid="JER 52:6" /><verse number="7" style="v" sid="JER 52:7" />reve a̱ ba̱ma̱ uɓaɓu u lyuci'i. Reve a̱ a̱soja'a a suma o uta̱ diga a̱ lyuci'i na ayin. Reve o toni nu una̱ntsu u na u ri e memmere ma ɓaɓu re, za na ri zuzu na̱ a̱a̱rumbu o mogono, ko na wo o'woi a̱ a̱soja a Babila a̱ da̱na̱i uka̱nda̱ruwu na̱ lyuci'i. Reve a suma a saɓa Uka̱ri wa̱ Araba. <verse eid="JER 52:7" /><verse number="8" style="v" sid="JER 52:8" />Amma a̱vu a̱ a̱soja a Babila o toni mogono Zedekiya, a̱vu e reme yi a agalaci a̱ Jeriko. A̱vu a̱ a̱soja a Zedekiya suru a kasa na̱ yi, e bete'we a lyawa yi. <verse eid="JER 52:8" /><verse number="9" style="v" sid="JER 52:9" />Ana e remei Zedekiya'a, a̱vu a tara yi a̱ tyo uba̱ta̱ u mogono Nebukanaza va Babila a̱ lyuci va̱ Ribla wa Hamat. Uba̱ta̱ u na a paɗa niyi ugana. <verse eid="JER 52:9" /><verse number="10" style="v" sid="JER 52:10" />A̱vu mogono Nebukanaza va Babila zuwa o una muwun ma ali ma̱ Zedekiya esu a̱ yi. Reve fo u zuwa o una azagbain a Yahuda suru a̱ lyuci va Ribla. <verse eid="JER 52:10" /><verse number="11" style="v" sid="JER 52:11" />Reve Mogono Nebukanaza fufoɗo esu o mogono Zedekiya, a̱vu wunla̱ yi na akani a̱ rumushili, a̱vu u ka̱ra̱ na̱ yi a̱ tyo Babila, uba̱ta̱ u na u zuwa niyi o u'wa wa ali, hali acina uranu u na Zedekiya'a u kuwa̱i.<verse eid="JER 52:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 52:12" />A̱tsuma̱ o urana wa kupa o woto wa tawun wa aa'wan a kupa na̱ kucci o tsugono tso mogono Nebukanaza va Babila, reve Nebuzarada zagbain va̱ a̱za̱ e ipiri yu u'wa u mogono ma̱ ta̱wa̱ Urishelima. <verse eid="JER 52:12" /><verse number="13" style="v" sid="JER 52:13" />Ana u uwwai a̱tsuma̱ a̱ lyuci'i, a̱vu Nebuzarada kula̱to u'wa wa̱ A̱sulazuva nu u'wa u mogono, oɓolo na̱ 'wa va azagbain a̱ Urishelima. <verse eid="JER 52:13" /><verse number="14" style="v" sid="JER 52:14" />Reve akapi a̱ a̱soja a Babila a na a̱ da̱na̱i oɓolo na̱ yi suru o ɓoso kari va̱ Urishelima. <verse eid="JER 52:14" /><verse number="15" style="v" sid="JER 52:15" />A̱vu Nebuzarada pura̱ akapi a ama a̱ Urishelima na a buwai a̱ tyo nden tsugbashi, oɓolo na alambi o ro, oɓolo na̱ a̱za̱ o ro a na a sumai a cayi aciyele e ekere a̱ yi, oɓolo no ozo o ulinga wu ukere o ro aza a na a buwai a̱tsuma̱ a̱ lyuci'i, u tara le ta̱ suru a̱ tyo nden n tsugbashi uba̱ta̱ u mogono ma Babila. <verse eid="JER 52:15" /><verse number="16" style="v" sid="JER 52:16" />Amma Nebuzarada lyawa ta̱ pe ozo o ro a na a la'ai ulambu a̱tsuma̱ a̱ lyuci'i adama a yuwan ulinga a̱tsuma̱ o uɗuma̱ u ina̱bi na akapi a̱ ɗuma̱.<verse eid="JER 52:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 52:17" />A̱vu a̱ a̱soja a Babila o ɓuɓoso atsura e irumushili na ri pe a̱tsuma̱ o u'wa wa̱ A̱sulazuva, oɓolo na̱ wisawatan na ri pe a̱tsuma̱ o u'wa'a, na̱ a̱a̱ba̱jini o ura'atsu wu rumushili a na a̱ tsu ɗe Mala. Reve a̱ a̱soja'a a̱ pura̱ le a̱ tyo Babila. <verse eid="JER 52:17" /><verse number="18" style="v" sid="JER 52:18" />Reve fo a̱ pura̱ mpondo, na akana a na a tsu paɗa a̱punda̱ a fitila, ni ili i mekene ma akina, na akwanu a gbagbain, na akwanu, na̱ cu'un vi itana yi rumushili biti aza a na nan ganu a tsu yuwusan ulinga ne le adama o ulinga wa̱ A̱a̱'isa̱mapaɗa a̱ A̱sulazuva. <verse eid="JER 52:18" /><verse number="19" style="v" sid="JER 52:19" />A̱vu fo a̱ da̱shi pura̱, asa'atsu a gbagbain, na akwanu a̱ ma̱pura̱ ma akinkina a akina, na akwanu e keke'en na̱ mpondo, na aɗanga na a̱ tsu guza̱ ifitila, na akwanu e irumu, na̱ mukkoto biti, na̱ cu'un vi ili i na a yuwain biti na̱ zinariya can ko azurufa can. <verse eid="JER 52:19" /><verse number="20" style="v" sid="JER 52:20" />Ume wu rumushili na mogono Sulemanu yuwayin ulinga na̱ yi adama a ruma ili i nda'a a̱ A̱a̱'isa̱mapaɗa a̱ A̱sulazuva a la'a ta̱ ucira u na a̱ kunzu le, ele atsura e re o ndolo na̱ a̱ba̱jini akwanu a na e ɗesu Mala, no ogono e inan kupa ne ejere na ri za̱la̱ Mala'a, ni ili i mishin i na a tsu tawa. <verse eid="JER 52:20" /><verse number="21" style="v" sid="JER 52:21" />Atsura biti udasuwu ushin na̱ a̱za̱ cindere ɗa, waru washin wa̱ yi u rawa ta̱ udasuwu kupa na̱ kunla̱ wu za ta̱ suru. Za ta̱ le suru ta̱ na̱ wungu pe, waru ugba̱mu u lipu u le u rawa ta̱ washin wa akatsu a̱ na̱shi. <verse eid="JER 52:21" /><verse number="22" style="v" sid="JER 52:22" />Zuva va atsura biti a yuwaan yi ta̱ aci a̱ rumushili, aci biti mishin ma̱ yi udasuwu u cindere ɗa na akapi, waru u ta̱ ni yiɗanishi, yi ili i yinlu wi iroci yu ɗanga muwun m peme uka̱nda̱ruwu na aci biti, waru a̱za̱ a̱ rumushili ɗa suru. <verse eid="JER 52:22" /><verse number="23" style="v" sid="JER 52:23" />A̱ da̱na̱ ta̱ na̱ ɗanga muwun m peme ukpaku kupa kucci na̱ a̱za̱ a̱ ta̱li uka̱nda̱ruwu na akwanu atsura'a. Ɗanga muwun m peme na ri suru zuva yironishi yi ili i yinlu'u ukpaku (100) u ɗa.<verse eid="JER 52:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 52:24" />Yali ya̱ a̱za̱ e ipiri yu u'wa u mogono ma Babila u tara ta̱ Seraya zagbain nan ganu na̱ Zafaniya za na o to yi, oɓolo na̱ ama a ta'atsu a aza a na a yuwusan ipiri yu una̱ntsutsu wa̱ A̱a̱'isamapaɗa a̱ A̱sulazuva. <verse eid="JER 52:24" /><verse number="25" style="v" sid="JER 52:25" />A̱tsuma̱ a̱ lyuci'i u tara ta̱ yali ya̱ a̱soja ro, na ama e cindere aza a na a casu mogono a̱sa̱la̱, aza a na a cina nle a̱tsuma̱ a̱ lyuci'i. Reve fo u tara za vi iɗana na tsu ɓolotosu nan soja a̱ lyuci'i, na ama gbagbain kupota̱li na a cinai pe a̱tsuma̱ a̱ lyuci'i. <verse eid="JER 52:25" /><verse number="26" style="v" sid="JER 52:26" />Nebuzarada pura̱ ta̱ a ama a nda suru u ta̱wa̱ na̱ le uba̱ta̱ u mogono ma Babila a Ribla. <verse eid="JER 52:26" /><verse number="27" style="v" sid="JER 52:27" />A̱vu mogono ma Babila mo una le a̱tsuma̱ o upasu wa̱ Ribla wi iɗa ya Hamat. Ne ɗa o uta̱yi a ama a Yahuda a̱ tyo tsugbashi diga e iɗa i le.<verse eid="JER 52:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JER 52:28" />Apa a̱bunda̱ ama a na Nebukanaza remei a̱ tyo tsugbashi. A̱tsuma̱ aa'wan cindere o tsugono tsa̱ yi, u pura̱ ta̱ aza a Yahuda ukpaku kupa uta'atsu nu ushin na aza ta'atsu (3,023). <verse eid="JER 52:28" /><verse number="29" style="v" sid="JER 52:29" />A̱tsuma̱ a aa'wan kupa na̱ kula̱ o tsugono tsa̱ yi, u pura̱ ta̱ a ama ukpaku kupa na̱ mata'atsu ne ejere (832) diga a̱ Urishelima. <verse eid="JER 52:29" /><verse number="30" style="v" sid="JER 52:30" />A̱tsuma̱ a aa'wan ushin na aza a ta'atsu o tsugono tsa Nebukanaza, Nebuzarada zagbain vu u'wa wa̱ yi pura̱ ta̱ aza a Yahuda ukpaku ucindere na amunga no ozo ton (745).</para>
  <para style="p" vid="JER 52:30">A̱bunda̱ ama a na a̱ pura̱i a̱ tyo tsugbashi o ukere wa̱ Nebukanaza, a ama ukpaku kupa una̱shi na̱ kupota̱li (4,600) ɗa.<verse eid="JER 52:30" /></para>
  <para style="s">Isa'ani ya̱ A̱sulazuva a̱ tyo uba̱ta̱ u mogono Yekoniya</para>
  <para style="r">(<ref loc="2KI 25:26-30">2 Ngo 25:26-30</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="JER 52:31" />Mogono Yekoniya va Yahuda yuwan ta̱ a'wan mata'atsu na̱ a̱za̱ e cindere o u'wa wa ali a Babila. A̱tsuma̱ o urana wu ushin no ozo o ton o woto wa kupa ne ejere aa'wan a na Ebilmeroda o o'woi mogono ma Babila, reve u roco mogono Yehoyakin va Yahuda isa'ani wu uta̱ yi diga a̱tsuma̱ o u'wa wa ali. <verse eid="JER 52:31" /><verse number="32" style="v" sid="JER 52:32" />Mogono Ebilmeroda maa yuwaan yi ta̱ adanshi a sa'ani, reve u ca yi tsugbain ula'awu na̱ ngono nna n da̱na̱i oɓolo na̱ yi a̱tsuma̱ a Babila. <verse eid="JER 52:32" /><verse number="33" style="v" sid="JER 52:33" />Reve Yekoniya foɗo itana ya̱ yi yu u'wa wa ali, a̱vu u teme a lyuwusa ilyalya apada oɓolo na̱ Mogono Ebilmeroda, hali acina ukosu wu rana wuma va̱ yi suru. <verse eid="JER 52:33" /><verse number="34" style="v" sid="JER 52:34" />Reve mogono Ebilmeroda va Babila ma zuwa a casu Yekoniya mu kebe wa'a wa'a wa ana'an na̱ nfa'an, acina ukosu wu rana wuma va̱ yi suru.<verse eid="JER 52:34" /></para>
  <chapter eid="JER 52" />
</usx>