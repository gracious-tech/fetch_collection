<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HOS" style="id">- Tsishingini (tsw)</book>
  <para style="h">Hosiya</para>
  <para style="toc3">Hos</para>
  <para style="toc2">Hosiya</para>
  <para style="toc1">Hosiya</para>
  <para style="mt2">Hosiya</para>
  <para style="mt1">Hosiya</para>
  <para style="is">Ucuɗuwu wa aatagada a nda</para>
  <para style="ip">A̱tsuma̱ a Isra'ila a mantsa mo ro ɗe iwuya i yuwan ta̱ a̱bunda̱ lon, adama a na ama a vadala ta̱ e reme a yuwusaan a̱ma̱li a̱ga̱nda̱. A mantsa mo ndolo vumava̱sula̱ Emos kuwa̱ ta̱ ɗe, agba vumava̱sula̱ Hosiya teme ta̱ alajiya a̱yi upasu u tsugono wu ugana wa Isra'ila, a̱ca̱pa̱ a wuma a vumava̱sula̱ Emos. Ili yo ndolo i fara ta̱ a mantsa mo urupulu wa aza a Isra'ila kafu a mantsa ma̱a̱ a̱risa̱ a Samariya a̱tsuma̱ a'wan ukpaku ucindere nu ushin na̱ za ta̱ (721) kafu limatan va̱ Yesu. Hosiya roco ta̱ a̱tsumola̱ngu a̱yi adama a mayan ma̱ a̱ga̱nda̱ a̱ a̱ma̱li a ama a̱yi, oɓolo nu ulambu wa̱ a̱ɓula̱ wa a ama a̱yi e ekere A̱sula̱. Waru u roco ta̱ ululu wu ulambu wa̱ a̱ɓula̱ o ndolo o una̱ u lolo wa̱ yi wu ulambu wa asuvu nden na̱ ka vu ulambu wa̱ a̱ɓula̱. Ununa ka va̱ yi Goma yuwaan niyi ulambu wa̱ a̱ɓula̱, ne ɗa ama A̱sula̱ a kasai na̱ A̱sulazuva. Adama o ndolo reve A̱sulazuva oforo ama a̱yi. Amma acina ukosu icigi ya̱ A̱sula̱ i na i tsu vadala shi o una̱ wa ama a̱yi i te e isawan hali hali, waru u ta̱ ka̱mbuwa̱ ama a̱yi uba̱ta̱ wa̱ yi nu ulapulu wu nden nle. Cu'un vi icigi i ndolo i roco ta̱ idanshi yu ucira a̱tsuma̱ aatagada a nda, idanshi i na yaa dansa, &lt;&lt;Cine maa lyawa wu? Cine waru maa kasa na̱ a̱vu Isra'ila? Okolo a̱ va̱ a̱ ta̱ ma̱zungwa̱, waru iliyali i va̱ i ta̱ da̱shishi.&gt;&gt;</para>
  <para style="iot">Ili i na i ri pe a̱tsuma̱ a aatagada a nda</para>
  <para style="io1">Lolo va̱ Hosiya na̱ limatan va̱ yi 1:1-3:5</para>
  <para style="io1">Ikaka adama a Isra'ila 4:1-13:16</para>
  <para style="io1">Ikaka yu uvadalusa oɓolo na̱ nzuwulai 14:1-9</para>
  <para style="ib" />
  <chapter number="1" style="c" sid="HOS 1" />
  <para style="s">Ka va Hosiya na̱ muwun</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1" />Adanshi a̱ A̱sulazuva a̱ ta̱wa̱ ta̱ uba̱ta̱ wa̱ Hosiya ulobo wa̱ Beri, a mantsa mo tsugono tsa a ama a nda: Uziya na̱ Jotam na̱ Ahaz na̱ Hezekiya ngono ma Yahuda, waru za suru ushi ta̱ tsugono diga e ekere a za na kuwa̱i. A mantsa mo ndolo ma ɗa Yerobowam ulobo wa̱ Yowash da̱na̱i o tsugono a̱tsuma̱ a Isra'ila. A mantsa mo tsugono vu ngono n ndolo ɗa A̱sulazuva a̱ lyunguyi ikaka ya̱ yi o una̱ wa̱ Hosiya.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 14:23">2 Ngo 14:23</ref>; <ref loc="2KI 15:7">15:7</ref>; <ref loc="2KI 15:32-16:20">15:32-16:20</ref>; <ref loc="2KI 18:1-20:21">18:1-20:21</ref>; <ref loc="2CH 26:1-27:8">2 Alb 26:1-27:8</ref>; <ref loc="2CH 28:1-32:33">28:1-32:33</ref>.</char></note><verse eid="HOS 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 1:2" />Ikaka yu ufaru u na A̱sulazuva a dammai Hosiya a̱ yi ɗa, &lt;&lt;'Ya̱wa̱, vu taraa aciya̱wu ka na aa yuwusan tsushakala adama vu matsan muwun tsipere, adama a na iɗa'a i ta yuwusan tsipere lon, a na u lyawai tsutoni na̱ A̱sula̱.&gt;&gt;<verse eid="HOS 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HOS 1:3" />Ɗaɗa u ka̱ra̱i u zuwai Goma usheli wa̱ Dibiliyam, reve u yuwan a̱a̱tsuma̱ u matsaan yi mawun mo ulobo. <verse eid="HOS 1:3" /><verse number="4" style="v" sid="HOS 1:4" />Ɗaɗa A̱sulazuva a dammai Hosiya, &lt;&lt;Vu ca yi aala Yezireyel,<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="fq" closed="false">Yezireyel </char><char style="ft" closed="false">Urevu wa̱ yi u ɗa A̱sula̱ e bete'we.</char></note> adama a na wa jima na ma ca u'wa wa̱ Yehu oforo adama a mpasa n na wo ocoi ɗe Yezireyel shi. N ta̱ ta̱wa̱ nu ukosu u tsugono tsa Isra'ila.<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="2KI 10:11">2 Ngo 10:11</ref>.</char></note> <verse eid="HOS 1:4" /><verse number="5" style="v" sid="HOS 1:5" />O urana u ndolo n ta kuɗa utan wa Isra'ila o Uka̱ri wa̱ Yezireyel.&gt;&gt;<verse eid="HOS 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 1:6" />Reve Goma yuwisan a̱a̱tsuma̱ u matsan usheli. Reve A̱sulazuva a dammisa Hosiya, &lt;&lt;Vu ca yi aala Lo Rahama,<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">Urevu wa aala &lt;&lt;Lo Rahama&gt;&gt; A̱yi ɗa, &lt;&lt;za na a cigai shi.&gt;&gt; </char></note> adama a na m buwa o roco u'wa wa Isra'ila iliyali shi, hali na mayuwan le gafura shi. <verse eid="HOS 1:6" /><verse number="7" style="v" sid="HOS 1:7" />Na̱ ne suru n to roco u'wa wa Yahuda iliyali, a̱vu n wawa le, agba a̱tsuma̱ e itana yu uvon wa aya ko matsun me pe'eni, ko ni ido ko na akumbi e ido ko uvon shi. Amma a̱mu A̱sulazuva A̱sula̱ e le n ta wawa le.&gt;&gt;<verse eid="HOS 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 1:8" />Ana Goma kasai Lo Rahama maani, u yuwisan ta̱ a̱a̱tsuma̱ a̱vu u matsisan mawun mo ulobo mo ro. <verse eid="HOS 1:8" /><verse number="9" style="v" sid="HOS 1:9" />Ɗaɗa A̱sulazuva a damma niyi, &lt;&lt;Ca yi aala Lo Ami<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">Urevu wa aala &lt;&lt;Lo Ami&gt;&gt; A̱yi ɗa, aza a na a̱ ri ama a̱ va̱ shi</char></note>, adama a na Isra'ila ama a̱ va̱ a ɗa shi, a̱mu waru A̱sula̱ e le a ɗa shi.&gt;&gt;<verse eid="HOS 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HOS 1:10" />&lt;&lt;Suru na̱ ne ugundo wa ama a Isra'ila a̱ ta̱ da̱na̱ a̱bunda̱ cine vu revei wuyun wu nge'en m mala, n na aa gura rito ko e kece shi. Waru uba̱ta̱ u na a damma nle, &lt;Ama a̱ va̱ a ɗa i ri shi,&gt; a̱ ta̱ ɗe le &lt;Muwun ma̱ A̱sula̱ a Wuma.&gt;<note caller="-" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="ROM 9:26">Rom 9:26</ref>.</char></note> <verse eid="HOS 1:10" /><verse number="11" style="v" sid="HOS 1:11" />Adama o ndolo reve oɓolo ama a Yahuda na ama a Isra'ila o'wo ili i ta̱. A̱vu a zuwaa aciyele zagbain ta̱, na̱ zagbain ndolo ɗa o uta̱ a usa iɗa'a. Adama a na urana u ndolo u to o'wo a̱ba̱jini o urana, urana u ɗa wa̱ Yezireyel!&gt;&gt;<verse eid="HOS 1:11" /></para>
  <chapter eid="HOS 1" />
  <chapter number="2" style="c" sid="HOS 2" />
  <para style="s">Oforo o ulambu wa̱ a̱ɓula̱ a Isra'ila</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 2:1" />&lt;&lt;Vu ɗe a̱za̱ a̱ wu olobo, &lt;A̱ɗu ama a̱ va̱<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fq" closed="false">ama a̱ va̱: </char><char style="ft" closed="false">Na̱ Tsuyahuda a ɗana ta̱ &lt;&lt;Ammi&gt;&gt; ɗa pa nda.</char></note> ɗa,&gt; a̱za̱ a̱ wu esheli waru vu ɗe le, &lt;Aza a na a̱ tsura̱i iliyali.&gt; &gt;&gt;<verse eid="HOS 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 2:2" />&lt;&lt;I ɓara mma ɗu,</para>
  <para style="q2" vid="HOS 2:2">i ɓara yi,</para>
  <para style="q1" vid="HOS 2:2">adama a na ka va̱ ɗa u ri shi,</para>
  <para style="q2" vid="HOS 2:2">a̱mu waru vali va̱ yi ɗa n ri shi.</para>
  <para style="q1" vid="HOS 2:2">Pati niyi u lyawa wutu tsa aashakala,</para>
  <para style="q2" vid="HOS 2:2">waru wu kasa na aza na oo kpukpokuso yi maani.<verse eid="HOS 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 2:3" />Na ne ɗa shi, n ta̱ ba̱ɗa̱ yi</para>
  <para style="q2" vid="HOS 2:3">n lyawa yi ataɓu cine u da̱na̱i o urana u na a matsan niyi.</para>
  <para style="q1" vid="HOS 2:3">N ka̱mba̱to yi tsa̱ a̱tsumona,</para>
  <para style="q2" vid="HOS 2:3">tsi iɗa yu u'yewu,</para>
  <para style="q2" vid="HOS 2:3">a̱vu mu una yi na akuli.<verse eid="HOS 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 2:4" />Mee ene iliyali i muwun ma̱ yi shi,</para>
  <para style="q2" vid="HOS 2:4">na wo o'woi ele a̱za̱ a̱ va̱ ɗa shi,</para>
  <para style="q2" vid="HOS 2:4">muwun n tsipere n ɗa.<verse eid="HOS 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 2:5" />Adama a na mma le gura guza̱ aciya̱yi shi,</para>
  <para style="q2" vid="HOS 2:5">ɗaɗa u matsan nle a̱tsuma̱ o wono.</para>
  <para style="q1" vid="HOS 2:5">Adama a na u damma ta̱, &lt;N to toni aza a na a ciga numu,</para>
  <para style="q2" vid="HOS 2:5">adama a na a ca mu ta̱ malyuwa na̱ mosowoo,</para>
  <para style="q2" vid="HOS 2:5">na̱ a̱punda̱ o uzula̱ no okoro a sa'ani,</para>
  <para style="q2" vid="HOS 2:5">oɓolo na̱ mani'in ma̱ zetun na̱ masayan ma̱ inabi.&gt; &gt;&gt;<verse eid="HOS 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 2:6" />&lt;&lt;Adama o ndolo,</para>
  <para style="q1" vid="HOS 2:6">n ta̱ ka̱nda̱ruwa̱ Isra'ila nu ukari wa awanda.</para>
  <para style="q2" vid="HOS 2:6">A̱mu n ta̱ titiga̱ re va̱ yi,</para>
  <para style="q2" vid="HOS 2:6">adama u puwa̱n u lamba ure u na wo toni.<verse eid="HOS 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 2:7" />U to toni aza a na o voyin na̱ yi,</para>
  <para style="q2" vid="HOS 2:7">agba waa cina le shi.</para>
  <para style="q1" vid="HOS 2:7">U ta zami le,</para>
  <para style="q2" vid="HOS 2:7">agba wa̱a̱ tsura̱ le shi.</para>
  <para style="q1" vid="HOS 2:7">Ɗaɗa waa damma,</para>
  <para style="q2" vid="HOS 2:7">&lt;N ta̱ ka̱mba̱ uba̱ta̱ u vali vu ufaru u va̱,</para>
  <para style="q2" vid="HOS 2:7">adama a na nden mu ufaru n la'a ta̱ za na maa yuwusan gogo!&gt; &gt;&gt;<verse eid="HOS 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 2:8" />Koto u reve a na</para>
  <para style="q2" vid="HOS 2:8">a̱mu ɗa n shi acasu yi ishina'a shi,</para>
  <para style="q2" vid="HOS 2:8">na̱ masayan ma̱ ina̱bi na̱ mani'in ma̱ zetun,</para>
  <para style="q1" vid="HOS 2:8">za na ca niyi zinariya oɓolo na̱ azurufa pere,</para>
  <para style="q2" vid="HOS 2:8">na a yuwain ulinga ne ele a̱ zuɗa̱i Ba'al shi.<verse eid="HOS 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 2:9" />Reve A̱sulazuva a damma,</para>
  <para style="q2" vid="HOS 2:9">&lt;&lt;Adama o ndolo n ta̱ ushi ishina i va̱</para>
  <para style="q2" vid="HOS 2:9">a mantsa ma na u rawai ugasa,</para>
  <para style="q2" vid="HOS 2:9">oɓolo na̱ masayan ma̱ ina̱bi ma̱ va̱ mantsa ma na u yuwain.</para>
  <para style="q1" vid="HOS 2:9">N ta̱ ushi a̱punda̱ a̱ va̱ oɓolo no okoro a sa'ani a̱ va̱ a na n ca niyi</para>
  <para style="q2" vid="HOS 2:9">na wa̱ zula̱ tsura̱ wu pala ataɓu a̱ yi.<verse eid="HOS 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 2:10" />To, gogo tsunda n ta lyawa yi ataɓu a alanga e eteshe,</para>
  <para style="q2" vid="HOS 2:10">a̱ ma̱ka̱ka̱n ma aza a na o voyin na̱ yi.</para>
  <para style="q2" vid="HOS 2:10">Agba babu za na aa wawa yi e ekere a̱ va̱.<verse eid="HOS 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 2:11" />N te isawaton a̱buki a̱ yi suru,</para>
  <para style="q2" vid="HOS 2:11">a̱buki a aa'wan,</para>
  <para style="q2" vid="HOS 2:11">oɓolo na̱ a̱buki o Woto u Sa'avu, na̱ rana va Ashibi,</para>
  <para style="q2" vid="HOS 2:11">na̱ a̱buki a na u zuwai suru.<verse eid="HOS 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 2:12" />N to una a̱ɗuma̱ a̱ ina̱bi a̱ yi,</para>
  <para style="q2" vid="HOS 2:12">oɓolo na̱ ɗanga vu biri va̱ yi, aza a na u dammai,</para>
  <para style="q1" vid="HOS 2:12">&lt;Ele nda e le ɗa ili i na n tsura̱i</para>
  <para style="q2" vid="HOS 2:12">uba̱ta̱ wa aza a na o voyin na̱ mu na a ca numu.&gt;</para>
  <para style="q1" vid="HOS 2:12">N ta̱ ka̱mba̱to a̱ɗuma̱ a̱ ina̱bi e le atsusa,</para>
  <para style="q2" vid="HOS 2:12">na inama yu una ya tama.<verse eid="HOS 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 2:13" />N ta ca yi a̱tsuma̱lima̱</para>
  <para style="q2" vid="HOS 2:13">adama a rana na u kula̱toi kucci vi ili i ma̱guru a̱ tyo ya Ba'al.</para>
  <para style="q1" vid="HOS 2:13">U yuwaan ta̱ aciya̱yi yisukumishi oɓolo na̱ nkawani n zinariya,</para>
  <para style="q2" vid="HOS 2:13">u toni aza a na o voyin na̱ yi.</para>
  <para style="q2" vid="HOS 2:13">A̱vu wi icina na̱ mu.&gt;&gt;<verse eid="HOS 2:13" /></para>
  <para style="s">A̱sulazuva o roco ta̱ Isra'ila iliyali</para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 2:14" />&lt;&lt;Adama o ndolo, uwwai nda, n ta kpara yi.</para>
  <para style="q2" vid="HOS 2:14">A̱vu n tara yi a̱ tyo a̱ a̱tsumona,</para>
  <para style="q2" vid="HOS 2:14">a̱vu n yuwaan yi adanshi ben.<verse eid="HOS 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 2:15" />Ɗe ɗa ma̱a̱ ka̱mbuwa̱a̱ yi na̱ a̱ɗuma̱ a̱ inabi a̱ yi.</para>
  <para style="q2" vid="HOS 2:15">A̱vu n ka̱mba̱to Uka̱ri wa Ako una̱ntsu u mazuwa mo okolo.</para>
  <para style="q1" vid="HOS 2:15">Ɗe ɗa wa̱ usu mu</para>
  <para style="q2" vid="HOS 2:15">cine u da̱na̱i a mawun,</para>
  <para style="q2" vid="HOS 2:15">a mantsa ma na wu uta̱i e iɗa ya Masar.<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="JOS 7:24-26">Jos 7:24-26</ref>.</char></note><verse eid="HOS 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 2:16" />A̱sulazuva a damma ta̱,</para>
  <para style="q1" vid="HOS 2:16">o urana u ndolo, vu ta̱ ɗe mu &lt;Vali va̱,&gt;</para>
  <para style="q2" vid="HOS 2:16">Va̱a̱ da̱shi ɗe mu na aala &lt;Ba'al<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">Aala a̱ a̱ma̱li a Ka'ana a nda urevu wa̱ yi u ta gura o'wo &lt;&lt;A̱sulazuva&gt;&gt; ko gba, &lt;&lt;vali&gt;&gt; </char></note> va̱ shi.&gt;<verse eid="HOS 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 2:17" />Adama a na n ta tawa aala a Ba'al</para>
  <para style="q2" vid="HOS 2:17">o una̱ wa̱ yi.</para>
  <para style="q2" vid="HOS 2:17">A buwa waru a̱ da̱shi cuwan na ala e le shi.<verse eid="HOS 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 2:18" />O urana u ndolo n ta yuwaan le nzuwulai</para>
  <para style="q2" vid="HOS 2:18">ni inama yu una oɓolo na̱ nnunu,</para>
  <para style="q1" vid="HOS 2:18">ni ili yi ika̱ta̱pu</para>
  <para style="q2" vid="HOS 2:18">adama ama a̱ va̱ a yuwan nden n lafiya nle.</para>
  <para style="q1" vid="HOS 2:18">N ta tawa utan oɓolo na̱ matsun me pe'eni</para>
  <para style="q2" vid="HOS 2:18">nu uvon e iɗa'a,</para>
  <para style="q2" vid="HOS 2:18">tsa̱ra̱ i da̱nu gbaga.&gt;&gt;<verse eid="HOS 2:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="HOS 2:19" />&lt;&lt;N ta zuwa wu vo o'wo ka va̱ hali hali.</para>
  <para style="q2" vid="HOS 2:19">N ta̱ olo wu a̱tsuma̱ a amayun na̱ a̱ɓula̱,</para>
  <para style="q1" vid="HOS 2:19">n roco wu icigi i na i tsu vadala shi</para>
  <para style="q2" vid="HOS 2:19">waru n roco wu iliyali.<verse eid="HOS 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="HOS 2:20" />N ta yuwan lolo na̱ a̱vu a̱tsuma̱ a amayun,</para>
  <para style="q2" vid="HOS 2:20">waru vu ta̱ reve na a̱mu ɗa A̱sulazuva.&gt;&gt;<verse eid="HOS 2:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="HOS 2:21" />A̱sulazuva a damma ta̱,</para>
  <para style="q1" vid="HOS 2:21">&lt;&lt;O urana u ndolo n ta̱ usu.</para>
  <para style="q2" vid="HOS 2:21">A̱mu n ta̱ usuwa̱ zuva va zuva,</para>
  <para style="q1" vid="HOS 2:21">a̱vu e le a̱ usuwa̱ uvaɗi.<verse eid="HOS 2:21" /></para>
  <para style="q2">
    <verse number="22" style="v" sid="HOS 2:22" />Uvaɗi gba u ta̱ usu ni ishina, oɓolo na̱ masayan ma̱ ina̱bi na̱ mani'in ma̱ zetun, a̱vu a̱ usu Yezireyel.<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">Urevu wa &lt;&lt;Yezireyel&gt;&gt; a̱yi ɗa A̱sulazuva a̱ cu'wan ta̱ </char></note><verse eid="HOS 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="HOS 2:23" />N ta̱ shuwa̱ ama a̱ va̱ e iɗa'a adama a aciya̱va̱.</para>
  <para style="q2" vid="HOS 2:23">N to roco iliyali i va̱ a̱ tyo uba̱ta̱ wu za na n rocoyi iliyali shi,</para>
  <para style="q2" vid="HOS 2:23">n ta damma aza a na n ɗeyi, &lt;Ama a̱ va̱ shi,&gt; &lt;A̱ɗu ɗa ama a̱ va̱!&gt;</para>
  <para style="q1" vid="HOS 2:23">A̱vu e le a damma,&lt;A̱vu ɗa A̱sula̱ a̱ tsu!&gt; &gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="ROM 9:25">Rom 9:25</ref>; <ref loc="1PE 2:10">1 Bit 2:10</ref>.</char></note><verse eid="HOS 2:23" /></para>
  <chapter eid="HOS 2" />
  <chapter number="3" style="c" sid="HOS 3" />
  <para style="s">Hosiya na̱ ka va̱ yi a lapula ta̱ nden n lolo</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 3:1" />Reve A̱sulazuva a damma mu, &lt;&lt;'Ya̱wa̱ vu rocowiso ka va̱ wu icigi, ko na wo o'woi u to tono ali o ro a yuwusan tsipere. Vu ciga yi cine A̱sulazuva a cigai aza a Isra'ila, ko na a vadalai a̱ kuruyi musula̱ n ro a̱vu waru a ciga akala a̱ a̱kwisa̱ e le.&gt;&gt;<verse eid="HOS 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 3:2" />&lt;&lt;N tsupa ta̱ ikebe i azurufa gendu oɓolo na̱ kilo ukpaku na̱ kupoton (150) u yitabo adama a̱ yi. <verse eid="HOS 3:2" /><verse number="3" style="v" sid="HOS 3:3" />Reve n damma yi, &lt;Vu ta̱ da̱na̱ oɓolo na̱ a̱mu hali rana a̱bunda̱. She vu uta̱ tsushakala wan, ko vu von na̱ vali ro wan, waru a̱mu fo mo von na̱ a̱vu shi.&gt; &gt;&gt;<verse eid="HOS 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 3:4" />Adama a na aza a Isra'ila a̱ ta̱ da̱na̱ babu mogono ko zagbain hali rana a̱bunda̱, waru babu kucci, babu ijigo, ko epo ko gba a̱a̱ma̱li. <verse eid="HOS 3:4" /><verse number="5" style="v" sid="HOS 3:5" />Na̱ a̱yi ndolo koto a̱ ta̱ ka̱mba̱ a zami A̱sulazuva A̱sula̱ e le oɓolo na̱ mogono me le Da̱wuda. A rana vu ukosu a̱ ta̱ ka̱mba̱ uba̱ta̱ wa̱ A̱sulazuva na̱ wovon, adama a̱ tsura̱ isa'ani ya̱ yi.<verse eid="HOS 3:5" /></para>
  <chapter eid="HOS 3" />
  <chapter number="4" style="c" sid="HOS 4" />
  <para style="s">A̱sulazuva e kece ta̱ nusu va aza a Isra'ila</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 4:1" />Uwwa yi adanshi a̱ A̱sulazuva,</para>
  <para style="q2" vid="HOS 4:1">a̱ɗu aza a Isra'ila,</para>
  <para style="q2" vid="HOS 4:1">A̱sulazuva a̱ ta̱ a̱ nla̱ngi na aza a na a̱ ri na̱ nden e iɗa'a,</para>
  <para style="q1" vid="HOS 4:1">&lt;&lt;Babu mejege babu icigi,</para>
  <para style="q2" vid="HOS 4:1">waru babu urevu wa̱ A̱sula̱ e iɗa'a.<verse eid="HOS 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 4:2" />She misululai kuci, epen a ɗa nda oɓolo na̱ munulai,</para>
  <para style="q2" vid="HOS 4:2">na̱ wivu na̱ tsipere, nu urocosu u mala'a mo ucira,</para>
  <para style="q2" vid="HOS 4:2">na̱ wocosu wu mpasa mantsa suru.<verse eid="HOS 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 4:3" />Adama o ndolo a ɗa iɗa i 'yewei,</para>
  <para style="q2" vid="HOS 4:3">ili i na i ri pe waru a̱ kuwusa̱.</para>
  <para style="q1" vid="HOS 4:3">Inama yu una suru oɓolo na̱ nnunu,</para>
  <para style="q2" vid="HOS 4:3">na̱ mugula n na n ri pe a̱tsuma̱ a mala a̱ ta̱ ma̱kuwa̱.&gt;&gt;<verse eid="HOS 4:3" /></para>
  <para style="s">A̱sulazuva a tawaa ta̱ nan ganu</para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 4:4" />A̱vu A̱sulazuva a damma,</para>
  <para style="q2" vid="HOS 4:4">&lt;&lt;She za tawaa nan za wan,</para>
  <para style="q2" vid="HOS 4:4">ko i tawaa vuma ro na addama wan,</para>
  <para style="q1" vid="HOS 4:4">adama a na na̱ nan ganu ɗa</para>
  <para style="q2" vid="HOS 4:4">n ri a̱ nla̱ngi goon.<verse eid="HOS 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 4:5" />Adama o ndolo n to foro nan ganu ayin nu urana,</para>
  <para style="q2" vid="HOS 4:5">ama̱sula̱ fo a̱ ta̱ riya̱ oɓolo na̱ a̱ɗu.</para>
  <para style="q2" vid="HOS 4:5">Adama o ndolo n to kototo Isra'ila mma ɗu.<verse eid="HOS 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 4:6" />O kototo ta̱ ama a̱ va̱ adama o ulambu wu urevu.</para>
  <para style="q2" vid="HOS 4:6">Adama a na i 'yuwain urevu,</para>
  <para style="q2" vid="HOS 4:6">n 'yuwan ɗu ta̱ yo o'wo nan ganu a̱ va̱.</para>
  <para style="q1" vid="HOS 4:6">Adama a na waru yi icinai na̱ wila̱ wa̱ A̱sula̱ a̱ ɗu,</para>
  <para style="q2" vid="HOS 4:6">a̱mu fo n te icina na̱ muwun n ɗu.<verse eid="HOS 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 4:7" />Agba a̱ yi ɗa nda a mantsa ma na nan ganu a̱a̱ da̱shishi a̱bunda̱,</para>
  <para style="q2" vid="HOS 4:7">ne ɗa fo mayan mo unusu a̱a̱ da̱shishi a̱bunda̱.</para>
  <para style="q2" vid="HOS 4:7">N ta̱ gba a vadala tsugbain tse ele wo o'wo ili i wono.<verse eid="HOS 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 4:8" />A̱tsuma̱ o unusu wa ama a̱ va̱ a ɗa a lyuwusa,</para>
  <para style="q2" vid="HOS 4:8">waru a̱ to utsa̱n a̱tsuma̱ e iwuya i le.<verse eid="HOS 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 4:9" />Cine ama a̱ ri, ne ɗa nan ganu a̱ ri.</para>
  <para style="q2" vid="HOS 4:9">N ta ca le a̱tsuma̱lima̱ adama e re le,</para>
  <para style="q2" vid="HOS 4:9">a̱vu waru n tsupa le adama a linga le.<verse eid="HOS 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 4:10" />A ta lyuwa agba a̱a̱ cuwa̱n shi,</para>
  <para style="q2" vid="HOS 4:10">a yuwan tsushakala waru a̱a̱ da̱shi a̱bunda̱ shi.</para>
  <para style="q1" vid="HOS 4:10">Adama a na a lyawai A̱sulazuva</para>
  <para style="q2" vid="HOS 4:10">o toniyi musula̱ n ro.&gt;&gt;<verse eid="HOS 4:10" /></para>
  <para style="s">A̱sulazuva a ta tsugya mayan ma̱ a̱ga̱nda̱ e ekere a̱ma̱li</para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 4:11" />Reve A̱sulazuva a damma,</para>
  <para style="q2" vid="HOS 4:11">&lt;&lt;Tsushakala na̱ masayan ma sa'avu,</para>
  <para style="q1" vid="HOS 4:11">na akuci a masayan</para>
  <para style="q2" vid="HOS 4:11">a ta tawusa ugbozu wa ama a̱ va̱.<verse eid="HOS 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 4:12" />A tsu zami ta̱ urevu uba̱ta̱ wa̱ a̱ma̱li a na a yuwain na̱ ɗanga,</para>
  <para style="q2" vid="HOS 4:12">a yuwusan majiyan aɗanga a mmalu e le a̱ ta̱ usu le.</para>
  <para style="q1" vid="HOS 4:12">Ruhu tsushakala rono le ta̱ a̱ tyo o ure u vama,</para>
  <para style="q2" vid="HOS 4:12">reve a lyawa A̱sula̱ e le e teme tsushakala.<verse eid="HOS 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 4:13" />Reve a ca kucci ɗe zuva vu nsasan.</para>
  <para style="q2" vid="HOS 4:13">Reve a̱ kula̱to kucci vu ukula̱tosu a agaɗi,</para>
  <para style="q2" vid="HOS 4:13">waru za̱la̱ vu ɗanga vo Oku oɓolo na̱ ɗanga gbain,</para>
  <para style="q2" vid="HOS 4:13">adama a na lulu le tu uyo'o.</para>
  <para style="q1" vid="HOS 4:13">Adama o ndolo a ɗa esheli a̱ ɗu a yuwain tsushakala</para>
  <para style="q2" vid="HOS 4:13">a̱vu ejene a̱ ɗu a̱ ka̱ra̱ a yuwusan tsipere.<verse eid="HOS 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 4:14" />Maa ca esheli a̱ ɗu a̱tsuma̱lima̱</para>
  <para style="q2" vid="HOS 4:14">na a yuwusan tsushakala shi,</para>
  <para style="q1" vid="HOS 4:14">ko ejene a̱ ɗu</para>
  <para style="q2" vid="HOS 4:14">na a yuwusan tsipere shi,</para>
  <para style="q1" vid="HOS 4:14">adama a na a̱ɗu ali fo i ta yuwusan ne.</para>
  <para style="q2" vid="HOS 4:14">Waru i to vosun na aashakala a̱ a̱'isa̱,</para>
  <para style="q2" vid="HOS 4:14">waru i to tonishi aashakala o ro a alanga.</para>
  <para style="q1" vid="HOS 4:14">Za na 'yuwain a zuwa atsuvu o to kototo yi suru.<verse eid="HOS 4:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="HOS 4:15" />&lt;&lt;Ko na yaa yuwusan tsushakala,</para>
  <para style="q2" vid="HOS 4:15">a̱ɗu aza a Isra'ila,</para>
  <para style="q2" vid="HOS 4:15">she yo oto pe Yahuda wan.</para>
  <para style="q1" vid="HOS 4:15">She i 'ya̱wa̱ Gilga wan,</para>
  <para style="q2" vid="HOS 4:15">she i 'ya̱wa̱ Bet Aven wan.</para>
  <para style="q1" vid="HOS 4:15">She i kucina, &lt;Na̱ A̱sulazuva a na a̱ ri wuma wan!&gt;<verse eid="HOS 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 4:16" />Aza a Isra'ila a̱ ta̱ na aciyogbamu,</para>
  <para style="q2" vid="HOS 4:16">cine vu revei a̱na̱wun a nan.</para>
  <para style="q2" vid="HOS 4:16">Cine tsa ɗa A̱sulazuva a lyuwato le</para>
  <para style="q2" vid="HOS 4:16">tsa mokyokyon</para>
  <para style="q2" vid="HOS 4:16">a̱tsuma̱ a̱ a̱ba̱jini o uba̱ta̱ wa alyuna?<verse eid="HOS 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 4:17" />Ifiramu ɓolo ta̱ na̱ musula̱,</para>
  <para style="q2" vid="HOS 4:17">lyawa niyi!<verse eid="HOS 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 4:18" />A mantsa ma na o kotoi yisowishi i le,</para>
  <para style="q2" vid="HOS 4:18">a̱vu a uwa elime na̱ tsushakala babu uro.</para>
  <para style="q1" vid="HOS 4:18">Azagbain e le a la'a ta̱ ciga ili i wono</para>
  <para style="q2" vid="HOS 4:18">ula'awu na̱ tsugbain.<verse eid="HOS 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 4:19" />Lipa̱ ta̱ pura̱ le a̱ ka̱ra̱,</para>
  <para style="q2" vid="HOS 4:19">a̱vu kucci le o o'wo le ili i wono.&gt;&gt;<verse eid="HOS 4:19" /></para>
  <chapter eid="HOS 4" />
  <chapter number="5" style="c" sid="HOS 5" />
  <para style="s">Uge'etosu a aci a Isra'ila na aza a Yahuda</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 5:1" />Reve A̱sulazuva a damma,</para>
  <para style="q1" vid="HOS 5:1">&lt;&lt;Yu uwwa ili i nda, a̱ɗu nan ganu!</para>
  <para style="q2" vid="HOS 5:1">I zuwa atsuvu, a̱ɗu aza a Isra'ila!</para>
  <para style="q1" vid="HOS 5:1">I zuwa atsuvu a̱ɗu a̱za̱ o u'wa u tsugono!</para>
  <para style="q2" vid="HOS 5:1">Uge'etosu u nda a aci a̱ ɗu a ɗa u ri.</para>
  <para style="q2" vid="HOS 5:1">Yo o'wo ta̱ maza ɗe a Mizfa,</para>
  <para style="q2" vid="HOS 5:1">i baza ta̱ igolo ɗe a Tabo.<verse eid="HOS 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 5:2" />I ka̱pa̱a̱ le ta̱ a̱a̱ka̱ri a̱ a̱ru'un ɗe Shitim,</para>
  <para style="q2" vid="HOS 5:2">n ta ca le oforo suru.<verse eid="HOS 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 5:3" />N reve ta̱ ili suru a aci a Ifiramu,</para>
  <para style="q2" vid="HOS 5:3">Isra'ila waru ri usokowu e ekere a̱ va̱ shi.</para>
  <para style="q1" vid="HOS 5:3">Ifiramu ka̱mba̱ ta̱ a yuwusan tsushakala gogo.</para>
  <para style="q2" vid="HOS 5:3">Isra'ila o'wo ta̱ idaba.<verse eid="HOS 5:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 5:4" />&lt;&lt;Linga le lyawa le</para>
  <para style="q2" vid="HOS 5:4">a̱ ka̱mba̱ uba̱ta̱ wa̱ A̱sula̱ e le shi.</para>
  <para style="q1" vid="HOS 5:4">Adama a na ruhu tsushakala to o okolo e le,</para>
  <para style="q2" vid="HOS 5:4">e reve A̱sulazuva shi.<verse eid="HOS 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 5:5" />Ugbawu wa aza a Isra'ila</para>
  <para style="q2" vid="HOS 5:5">wi isawan ta̱ a̱ ma̱ka̱ka̱n me le.</para>
  <para style="q1" vid="HOS 5:5">Aza a Isra'ila oɓolo na aza a Ifiramu a̱ ta̱ riya̱ a̱tsuma̱ o unusu u le,</para>
  <para style="q2" vid="HOS 5:5">Yahuda fo ta̱ riya̱ oɓolo ne e le.<verse eid="HOS 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 5:6" />Oɓolo ni inan i le ni ikyon i le</para>
  <para style="q2" vid="HOS 5:6">a̱ ta̱ 'ya̱wa̱ a zami A̱sulazuva,</para>
  <para style="q1" vid="HOS 5:6">agba a̱a̱ tsura̱ yi shi,</para>
  <para style="q2" vid="HOS 5:6">adama a na u lyawa le ta̱.<verse eid="HOS 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 5:7" />A yuwaan A̱sulazuva a̱ɓula̱ shi,</para>
  <para style="q2" vid="HOS 5:7">a̱vu a matsan mugirutu.</para>
  <para style="q1" vid="HOS 5:7">Gogo tsunda a̱buki o Woto u Sa'avu</para>
  <para style="q2" vid="HOS 5:7">u to kototo le oɓolo ni iɗa i le.&gt;&gt;<verse eid="HOS 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 5:8" />&lt;&lt;Yi ivula̱ avana a̱tsuma̱ a Gibiya!</para>
  <para style="q2" vid="HOS 5:8">Abulu a̱tsuma̱ a Rama!</para>
  <para style="q2" vid="HOS 5:8">I yuwan yisaali yu uvon a̱tsuma̱ a Bet Aven,</para>
  <para style="q2" vid="HOS 5:8">tsu to toni wu, Banyami!<verse eid="HOS 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 5:9" />Ifiramu to o'wo ofoli</para>
  <para style="q2" vid="HOS 5:9">o urana u na aa ca yi a̱tsuma̱lima̱.</para>
  <para style="q1" vid="HOS 5:9">A̱tsuma̱ o ugundo wa aza a Isra'ila,</para>
  <para style="q2" vid="HOS 5:9">n ta zuwa e reve ili i na yo o'wo amayun.<verse eid="HOS 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 5:10" />Azagbain a Yahuda o o'wo ta̱</para>
  <para style="q2" vid="HOS 5:10">cine vu revei aza a na a tsu vadala utyo wi iɗa.</para>
  <para style="q1" vid="HOS 5:10">N ta tsuwa̱a̱n le upan u va̱</para>
  <para style="q2" vid="HOS 5:10">cine vu revei mini.<verse eid="HOS 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 5:11" />O ɓongi ta̱ Ifiramu,</para>
  <para style="q2" vid="HOS 5:11">a̱vu a̱ rutsa̱ le o uge'etosu,</para>
  <para style="q2" vid="HOS 5:11">adama a na u ɗangwai u wala na̱ a̱ma̱li.<verse eid="HOS 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 5:12" />Amma n to o'wo cine vu revei mafawi uba̱ta̱ wa̱ Ifiramu,</para>
  <para style="q2" vid="HOS 5:12">waru cine vu revei ashami uba̱ta̱ wa Yahuda.&gt;&gt;<verse eid="HOS 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 5:13" />&lt;&lt;Na̱ Ifiramu e ene ubanakun wa̱ yi,</para>
  <para style="q2" vid="HOS 5:13">a̱vu Yahuda ene antsu a̱ yi,</para>
  <para style="q1" vid="HOS 5:13">a̱vu Ifiramu ka̱mba̱ Asuriya izami yi ikambishi,</para>
  <para style="q2" vid="HOS 5:13">a̱vu u lyungu azagbain uba̱ta̱ u mogono ma gbain.</para>
  <para style="q2" vid="HOS 5:13">Agba waa gura ka̱mba̱to ɗu gbaga shi</para>
  <para style="q2" vid="HOS 5:13">ko u yuwaan ɗu opocino a antsu a̱ ɗu shi.<verse eid="HOS 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 5:14" />N to o'wo cine vu revei kamu uba̱ta̱ wa̱ Ifiramu,</para>
  <para style="q2" vid="HOS 5:14">cine vu revei makamu uba̱ta̱ u tsugono tsa Yahuda.</para>
  <para style="q2" vid="HOS 5:14">N ta kara le mukari mukari a̱vu n yuwan mmalu n va̱.</para>
  <para style="q1" vid="HOS 5:14">N ta yuwan uka̱ru u va̱,</para>
  <para style="q2" vid="HOS 5:14">waru babu vuma na aa gura wawa le.<verse eid="HOS 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 5:15" />N ta̱ ka̱mba̱ uba̱ta̱ u va̱</para>
  <para style="q2" vid="HOS 5:15">she mantsa ma na a vadalai o unusu u le,</para>
  <para style="q2" vid="HOS 5:15">na a zami urewesu u va̱.</para>
  <para style="q1" vid="HOS 5:15">A̱tsuma̱ a̱ a̱tsuma̱lima̱ e le</para>
  <para style="q2" vid="HOS 5:15">a ta zami mu no okolo e le suru.&gt;&gt;<verse eid="HOS 5:15" /></para>
  <chapter eid="HOS 5" />
  <chapter number="6" style="c" sid="HOS 6" />
  <para style="s">Ulambu wu uvadalu wa aza a Isra'ila</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 6:1" />Reve ama a damma,</para>
  <para style="q2" vid="HOS 6:1">&lt;&lt;Ta̱wa̱i tsu ka̱mba̱i uba̱ta̱ wa̱ A̱sulazuva!</para>
  <para style="q1" vid="HOS 6:1">Wu kara tsu ta̱ akari akari</para>
  <para style="q2" vid="HOS 6:1">agba u ta̱ ka̱mba̱to tsu gbaga.</para>
  <para style="q1" vid="HOS 6:1">Wu uwwato tsu ta̱ usa̱n,</para>
  <para style="q2" vid="HOS 6:1">amma u ta̱ nla̱ antsu a̱tsu.<verse eid="HOS 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 6:2" />Na a yuwan ayin e re u ta̱ ka̱mba̱to tsu gbaga.</para>
  <para style="q2" vid="HOS 6:2">O urana wa ta'atsu u ta̱ 'ya̱sa̱n tsu,</para>
  <para style="q2" vid="HOS 6:2">adama tsu yuwain nden a̱ ma̱ka̱ka̱n ma̱ yi.<verse eid="HOS 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 6:3" />Lyawa tsu revei A̱sulazuva,</para>
  <para style="q2" vid="HOS 6:3">tsu lyuwai elime na̱ mereve ma̱ yi.</para>
  <para style="q1" vid="HOS 6:3">Na amayun nu usana u tawa,</para>
  <para style="q2" vid="HOS 6:3">u ta̱ ta̱wa̱ ya̱'a̱ tsu.</para>
  <para style="q1" vid="HOS 6:3">U ta̱ ta̱wa̱ tsu cine mini mo ufaru ma̱ ri,</para>
  <para style="q2" vid="HOS 6:3">cine vu revei mini ma̱ ca̱'a̱n ma̱ tsu re'weto iɗa.&gt;&gt;<verse eid="HOS 6:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 6:4" />A̱vu A̱sulazuva a damma,</para>
  <para style="q2" vid="HOS 6:4">&lt;&lt;Nye maa yuwan na̱ a̱ɗu, aza a Ifiramu?</para>
  <para style="q2" vid="HOS 6:4">Nye maa yuwan na̱ a̱ɗu, aza a Yahuda?</para>
  <para style="q1" vid="HOS 6:4">A̱yi ɗa nda icigi i ɗu</para>
  <para style="q2" vid="HOS 6:4">cine vu revei megeve mo usana,</para>
  <para style="q2" vid="HOS 6:4">cine waru vu revei a'iza a na a̱ tsu za̱ka̱tsa̱ nu usana.<verse eid="HOS 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 6:5" />Adama o ndolo n lyungu ta̱ ama̱sula̱ a̱ va̱ a̱ ta̱wa̱ o koɗo ɗu okoɗi okoɗi.</para>
  <para style="q2" vid="HOS 6:5">Mu una ɗu na adanshi o una̱ a̱ va̱.</para>
  <para style="q1" vid="HOS 6:5">Uge'etosu u va̱ u ta̱wa̱ ɗu ta̱</para>
  <para style="q2" vid="HOS 6:5">cine vu revei imaɗatsu.<verse eid="HOS 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 6:6" />N ciga ta̱ icigi i na i tsu vadala shi, amma kucci shi,</para>
  <para style="q2" vid="HOS 6:6">urevu wa̱ A̱sula̱ u la'a kucci vu ukula̱tosu.<note caller="-" style="x"><char style="xo" closed="false">6:6 </char><char style="xt" closed="false"><ref loc="MAT 9:13">Mat 9:13</ref>; <ref loc="MAT 12:7">12:7</ref>.</char></note><verse eid="HOS 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 6:7" />Amma tsa Ada̱mu,</para>
  <para style="q2" vid="HOS 6:7">e le fo a kuɗa ta̱ akucunu a̱ va̱'a̱,</para>
  <para style="q2" vid="HOS 6:7">a yuwaan mu ta̱ ulambu wa̱ a̱ɓula̱.<verse eid="HOS 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 6:8" />Giliyadu lyuci va ama a vama a ɗa,</para>
  <para style="q2" vid="HOS 6:8">udasu wa ana e le ulakatu na̱ mpasa.<verse eid="HOS 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 6:9" />Cine vu revei a̱za̱ a̱ nga̱la̱la̱i</para>
  <para style="q2" vid="HOS 6:9">a tsu vawan vuma o una,</para>
  <para style="q2" vid="HOS 6:9">ne ɗa nan ganu a tsu yuwan.</para>
  <para style="q1" vid="HOS 6:9">A tsu una ta̱ o ure wa Shekem<note caller="+" style="f"><char style="fr" closed="false">6:9 </char><char style="fq" closed="false">Shekem </char><char style="ft" closed="false">Lyuci ta̱ ɗa a̱tsuma̱ e ilyuci i mapa'an uba̱ta̱ u na vuma a gura suma u pa'an e ekere a za wocosu wu mpasa.</char></note>,<note caller="-" style="x"><char style="xo" closed="false">6:9 </char><char style="xt" closed="false"><ref loc="JOS 20:1-9">Jos 20:1-9</ref>.</char></note></para>
  <para style="q2" vid="HOS 6:9">a yuwusan ili i wuya icu'un icu'un.<verse eid="HOS 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 6:10" />Me ene ta̱ ili i vama o u'wa wa Isra'ila,</para>
  <para style="q2" vid="HOS 6:10">ugundo wa Ifiramu u ta yuwusan tsushakala</para>
  <para style="q2" vid="HOS 6:10">uba̱ta̱ u mayan ma̱ a̱ga̱nda̱ e ekere a̱ musula̱,</para>
  <para style="q1" vid="HOS 6:10">na amayun Isra'ila o'wo ta̱ idaba.&gt;&gt;<verse eid="HOS 6:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 6:11" />&lt;&lt;Adama a̱ wu fo, Yahuda,</para>
  <para style="q2" vid="HOS 6:11">o foɓoo ɗu ta̱</para>
  <para style="q2" vid="HOS 6:11">urana u na yaa gasa ili i na i cu'wa̱in.</para>
  <para style="q1" vid="HOS 6:11">a mantsa ma na ma̱a̱ ka̱mbuwa̱ ama a̱ va̱</para>
  <para style="q2" vid="HOS 6:11">a na a̱ pura̱i a̱ tyo tsugbashi,</para>
  <para style="q2" vid="HOS 6:11">waru n ka̱mbuwa̱a̱ le na aba'un e le.&gt;&gt;<verse eid="HOS 6:11" /></para>
  <chapter eid="HOS 6" />
  <chapter number="7" style="c" sid="HOS 7" />
  <para style="s">Aza a Isra'ila a la'a ta̱ ciga iwuya</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 7:1" />&lt;&lt;Mantsa ma na maa ciga n yuwaan aza a Isra'ila opocino biti,</para>
  <para style="q2" vid="HOS 7:1">a̱vu unusu wu ugundo wa Ifiramu wu uta̱ a alanga eteshe,</para>
  <para style="q2" vid="HOS 7:1">oɓolo ni iwuya ya Samariya.</para>
  <para style="q1" vid="HOS 7:1">Suru nle aza yipalishi a ɗa.</para>
  <para style="q2" vid="HOS 7:1">Ele evu ɗa, a̱za̱ a̱ nga̱la̱la̱i.<verse eid="HOS 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 7:2" />Agba a gura reve</para>
  <para style="q2" vid="HOS 7:2">a na n cuwain ni iwuya i le shi.</para>
  <para style="q1" vid="HOS 7:2">Nusu le tu uka̱nda̱ruwu ne e le,</para>
  <para style="q2" vid="HOS 7:2">ili suru a̱ ma̱ka̱ka̱n ma̱ va̱ ma ɗa u ri.&gt;&gt;<verse eid="HOS 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 7:3" />&lt;&lt;A tsu zuwa ta̱ mogono ma yuwan ma̱za̱nga̱ ni iwuya i le,</para>
  <para style="q2" vid="HOS 7:3">a̱vu a zuwa azagbain a uwwa uyo'o</para>
  <para style="q2" vid="HOS 7:3">ne epen e le.<verse eid="HOS 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 7:4" />Suru nle a̱za̱ e tsipere tsa ɗa,</para>
  <para style="q2" vid="HOS 7:4">usuɗuwu cine vu revei wuwan u na u tsu da̱na̱ usuɗuwu</para>
  <para style="q1" vid="HOS 7:4">diga a mantsa ma na o umbai yira</para>
  <para style="q2" vid="HOS 7:4">hali u 'yon.<verse eid="HOS 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 7:5" />O urana wa̱ a̱buki o mogono'o</para>
  <para style="q2" vid="HOS 7:5">azagbain o tso o'wo ta̱ usowu</para>
  <para style="q2" vid="HOS 7:5">na̱ masayan,</para>
  <para style="q2" vid="HOS 7:5">a̱vu u canana ukere oɓolo na̱ a̱za̱ o ulamu.<verse eid="HOS 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 7:6" />Okolo e le a̱ ta̱ tsa wuwan,</para>
  <para style="q2" vid="HOS 7:6">a̱ tsu ta̱wa̱ yi ta̱ ni ikpa'a.</para>
  <para style="q1" vid="HOS 7:6">Upan u le u tsu suɗuwa ta̱ ayin ma̱ɓula̱,</para>
  <para style="q2" vid="HOS 7:6">reve nu usana u baza cine vu revei elentsu a akina.<verse eid="HOS 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 7:7" />Suru nle a̱ tu usuɗuwu cine vu revei wuwan,</para>
  <para style="q2" vid="HOS 7:7">o tsu soɗu ta̱ azagbain e le.</para>
  <para style="q1" vid="HOS 7:7">Ngono nle suru a̱ riya̱ ta̱,</para>
  <para style="q2" vid="HOS 7:7">a̱tsuma̱ e le babu za na ɗe numu.&gt;&gt;<verse eid="HOS 7:7" /></para>
  <para style="s">Isra'ila na akapi a nɗa</para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 7:8" />&lt;&lt;Ifiramu ja̱mba̱ra̱ ta̱ aciya̱yi na̱ nɗa,</para>
  <para style="q2" vid="HOS 7:8">wo o'wo tsa aakala a na a vadalai shi.<verse eid="HOS 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 7:9" />Omocin a ta lyuwusa ucira u le,</para>
  <para style="q2" vid="HOS 7:9">agba e reve na̱ za ndolo shi.</para>
  <para style="q1" vid="HOS 7:9">A̱nji e le a̱ ta̱ ka̱mba̱sa̱ yono</para>
  <para style="q2" vid="HOS 7:9">agba e reve shi.<verse eid="HOS 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 7:10" />Uvaɗu wa Isra'ila u ta yuwusan adanshi a aci a̱ yi,</para>
  <para style="q2" vid="HOS 7:10">agba na̱ ne suru</para>
  <para style="q2" vid="HOS 7:10">u ka̱mba̱ uba̱ta̱ wa̱ A̱sulazuva A̱sula̱ a̱ yi shi</para>
  <para style="q2" vid="HOS 7:10">ko u zami yi shi.&gt;&gt;<verse eid="HOS 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 7:11" />&lt;&lt;Ifiramu ta̱ tsa muɗa,</para>
  <para style="q2" vid="HOS 7:11">a̱ tsu luma̱ yi ta̱ babu usa̱n waru babu aci.</para>
  <para style="q1" vid="HOS 7:11">Gogo u ta̱ da̱na̱ e ɗesu va Masar,</para>
  <para style="q2" vid="HOS 7:11">reve na alanga a jima u ka̱ra̱ a̱ tyo Asuriya adama u tsura̱ ikambi.<verse eid="HOS 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 7:12" />A mantsa ma na a̱a̱ ka̱ra̱, n ta variya le igolo i va̱,</para>
  <para style="q2" vid="HOS 7:12">a̱vu n rono le cine vu revei nnunu ma zuva.</para>
  <para style="q1" vid="HOS 7:12">A mantsa ma na mu uwwa nle a mmalu oɓolo,</para>
  <para style="q2" vid="HOS 7:12">a̱vu n reme le.<verse eid="HOS 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 7:13" />Addama a ta cina le, adama a na a lyawa numu!</para>
  <para style="q2" vid="HOS 7:13">Ukototosu u ta̱ da̱na̱ a aci e le, adama a na a̱ 'ya̱sa̱a̱n numu a aci!</para>
  <para style="q1" vid="HOS 7:13">N shi ta̱ a ciga n wawa le,</para>
  <para style="q2" vid="HOS 7:13">agba a̱vu a̱ ka̱ra̱ a yuwusan epen a aci a̱ va̱.<verse eid="HOS 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 7:14" />A̱ showen mu diga o okolo e le shi,</para>
  <para style="q2" vid="HOS 7:14">amma a̱ da̱na̱ ta̱ e mesun a̱ a̱ga̱da̱ e le.</para>
  <para style="q1" vid="HOS 7:14">Reve a pupaɗa lipu le cine vu revei atakpaci,</para>
  <para style="q2" vid="HOS 7:14">a patishi ishina oɓolo na̱ masayan ma̱ inabi.</para>
  <para style="q2" vid="HOS 7:14">Reve waru a̱ 'ya̱sa̱a̱n mu a aci.<verse eid="HOS 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 7:15" />Ko na n rito nle</para>
  <para style="q2" vid="HOS 7:15">a̱vu waru n da̱shi ekere e le ucira,</para>
  <para style="q2" vid="HOS 7:15">na̱ ne suru a yuwan ta̱ ifoɓi i wuya a aci a̱ va̱.<verse eid="HOS 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 7:16" />A̱ ka̱mba̱ uba̱ta̱ wa̱ A̱sulazuva Mogono shi,</para>
  <para style="q2" vid="HOS 7:16">reve wo o'wo tsu utan u na u ri gbaga shi.</para>
  <para style="q1" vid="HOS 7:16">A̱ to una azagbain e le na̱ matsun me pe'eni</para>
  <para style="q2" vid="HOS 7:16">adama a adanshi o uvaɗu u le.</para>
  <para style="q1" vid="HOS 7:16">A̱yi ndolo ta zuwa fo a yuwaan le ulamu</para>
  <para style="q2" vid="HOS 7:16">e iɗa ya Masar.&gt;&gt;<verse eid="HOS 7:16" /></para>
  <chapter eid="HOS 7" />
  <chapter number="8" style="c" sid="HOS 8" />
  <para style="s">Aza a Isra'ila a ta gasa lipa̱</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 8:1" />Reve A̱sulazuva a damma,</para>
  <para style="q1" vid="HOS 8:1">&lt;&lt;Yi ivula̱ avana!</para>
  <para style="q2" vid="HOS 8:1">Tsa̱ a̱a̱kuru,</para>
  <para style="q2" vid="HOS 8:1">ma'yuwatan ma̱ cipa̱ ta̱ a aci a ama a̱ A̱sulazuva</para>
  <para style="q1" vid="HOS 8:1">adama a na ama a kuɗa ta̱ akucunu</para>
  <para style="q2" vid="HOS 8:1">reve a yuwaan wila̱ u va̱ aciyogbamu.<verse eid="HOS 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 8:2" />Isra'ila showen mu ta̱,</para>
  <para style="q2" vid="HOS 8:2">&lt;A̱sula̱ a̱ tsu, tsu reve wu ta̱!&gt;<verse eid="HOS 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 8:3" />Agba aza a Isra'ila a 'yuwan ta̱ ili i sa'ani,</para>
  <para style="q2" vid="HOS 8:3">ma'yuwatan gba ma ta saɓa le.<verse eid="HOS 8:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 8:4" />&lt;&lt;A̱ shuwa̱ ta̱ ngono babu a̱mu urevu,</para>
  <para style="q2" vid="HOS 8:4">reve a ɗangula azagbain babu na a̱mu n usuyi.</para>
  <para style="q1" vid="HOS 8:4">A yuwan ta̱ musula̱ na̱ zinariya oɓolo na̱ azurufa le</para>
  <para style="q2" vid="HOS 8:4">o foɓusoo aciyele ulungusu.<verse eid="HOS 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 8:5" />A̱vu Samariya! I vari ma̱dindim n ɗu n na i zuɗa̱i,</para>
  <para style="q2" vid="HOS 8:5">upan u va̱ u ta̱ ma̱puna̱ a aci e le.</para>
  <para style="q2" vid="HOS 8:5">Mantsa ma̱ ne ma ɗa yaa lyawa ulinga wa̱ a̱ma̱li?<verse eid="HOS 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 8:6" />A̱yi ma̱dindim'm diga Isra'ila ɗa!</para>
  <para style="q2" vid="HOS 8:6">Za vu ushe'en u ɗa yuwan niyi,</para>
  <para style="q1" vid="HOS 8:6">A̱sula̱ a ɗa shi!</para>
  <para style="q2" vid="HOS 8:6">A̱ ta̱ gba o ɓoso</para>
  <para style="q2" vid="HOS 8:6">a̱ma̱li a̱ ma̱dindim ma Samariya'a miri miri.&gt;&gt;<verse eid="HOS 8:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="HOS 8:7" />&lt;&lt;Adama a na ili i na i cu'wa̱in,</para>
  <para style="q2" vid="HOS 8:7">a̱ yi ɗa yaa gasa.</para>
  <para style="q1" vid="HOS 8:7">Akunku e ishina a na a̱ ri mishin a̱ ri na̱ a̱ga̱za̱ shi,</para>
  <para style="q2" vid="HOS 8:7">adama o ndolo a̱a̱ tsura̱ yira shi.</para>
  <para style="q1" vid="HOS 8:7">Ko na̱ u shi u matsan,</para>
  <para style="q2" vid="HOS 8:7">omocin a ɗa oo soɗu yi.<verse eid="HOS 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 8:8" />O soɗu ta̱ Isra'ila.</para>
  <para style="q2" vid="HOS 8:8">Gogo a̱ ta̱ pe a̱tsuma̱ a nɗa</para>
  <para style="q2" vid="HOS 8:8">she damma akarapalu a na a̱ ri nu ulinga shi.<verse eid="HOS 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 8:9" />Adama a na a̱ ka̱ra̱ ta̱ a̱ tyo Asuriya,</para>
  <para style="q2" vid="HOS 8:9">cine vu revei mololi mo una a agara a̱ nde'en.</para>
  <para style="q2" vid="HOS 8:9">Ifiramu tsulaa ta̱ aciya̱yi a za a na a yuwan tsipere.<verse eid="HOS 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 8:10" />Ko na u tsulayi aciya̱yi nɗa,</para>
  <para style="q2" vid="HOS 8:10">gogo n to ɓoloto le uba̱ta̱ u ta̱.</para>
  <para style="q1" vid="HOS 8:10">A̱ ta̱ da̱na̱ a̱ mingira̱sa̱ a̱tsuma̱ a̱ a̱tsuma̱lima̱</para>
  <para style="q2" vid="HOS 8:10">za̱la̱ vi iɓongi i mogono ma gbain.&gt;&gt;<verse eid="HOS 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 8:11" />&lt;&lt;Ko na wo o'woi Ifiramu</para>
  <para style="q2" vid="HOS 8:11">yuwan ta̱ musa'a na̱ a̱bunda̱</para>
  <para style="q1" vid="HOS 8:11">adama a mayan mo unusu,</para>
  <para style="q2" vid="HOS 8:11">wo o'wo yi ta̱ musa'a mo unusu.<verse eid="HOS 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 8:12" />N ɗanaa le ta̱ ili ya̱ a̱bunda̱ i wila̱ u va̱,</para>
  <para style="q2" vid="HOS 8:12">agba a tara le ta̱ tsi ili i sa'avu.<verse eid="HOS 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 8:13" />A ta casu kucci tsu une'e a̱ tyo ya̱'a̱ va̱,</para>
  <para style="q2" vid="HOS 8:13">adama a tama inama'a,</para>
  <para style="q2" vid="HOS 8:13">agba a̱mu A̱sulazuva ma uwwusa uyo'o u le shi.</para>
  <para style="q1" vid="HOS 8:13">To, gogo n ta cuwan ni iwuya i le,</para>
  <para style="q2" vid="HOS 8:13">reve n ca le a̱tsuma̱lima̱ adama a̱ nusu le.</para>
  <para style="q2" vid="HOS 8:13">A̱ ta̱ ka̱mba̱ Masar.<verse eid="HOS 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 8:14" />Isra'ila icina ta̱ za na yuwan niyi.</para>
  <para style="q2" vid="HOS 8:14">A̱vu u suwa a̱ba̱jini a̱ba̱jini o kobu.</para>
  <para style="q1" vid="HOS 8:14">Reve fo Yahuza suwaa</para>
  <para style="q2" vid="HOS 8:14">ilyuci'i ɓaɓu vu ucira va̱ a̱bunda̱.</para>
  <para style="q2" vid="HOS 8:14">Adama o ndolo n ta̱ lyungu akina a aci e ilyuci'i,</para>
  <para style="q2" vid="HOS 8:14">reve u kula̱to ba̱ta̱ vu ucira'a.&gt;&gt;<verse eid="HOS 8:14" /></para>
  <chapter eid="HOS 8" />
  <chapter number="9" style="c" sid="HOS 9" />
  <para style="s">Oforo a aci a aza a Isra'ila</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 9:1" />Aza a Isra'ila she i yuwan ma̱za̱nga̱ wan!</para>
  <para style="q2" vid="HOS 9:1">She i yuwan mere tsa akapi a nɗa wan!</para>
  <para style="q1" vid="HOS 9:1">Adama a na i yuwan ta̱ ulambu wa̱ a̱ɓula̱ uba̱ta̱ wa̱ A̱sula̱ a̱ ɗu.</para>
  <para style="q2" vid="HOS 9:1">I ciga ta̱ atsupu a aashakala diga uba̱ta̱ wo osoroto suru.<verse eid="HOS 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 9:2" />Ishina yo osoroto na̱ masayan ma na o kpokoi uba̱ta̱ u mokpoko u masayan waa lyuwato ama'a shi.</para>
  <para style="q2" vid="HOS 9:2">Masayan ma sa'avu maa rawa le shi.<verse eid="HOS 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 9:3" />Aa buwa e iɗa ya̱ A̱sulazuva shi.</para>
  <para style="q2" vid="HOS 9:3">Amma Ifiramu ta̱ ka̱mba̱ Masar,</para>
  <para style="q2" vid="HOS 9:3">reve a lyuwa ilyalya yi idaba a̱tsuma̱ a Asuriya.<verse eid="HOS 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 9:4" />A̱a̱ tsun kucci masayan uba̱ta̱ wa̱ A̱sulazuva shi,</para>
  <para style="q2" vid="HOS 9:4">waru kucci le o yo'onoto yi okolo shi.</para>
  <para style="q1" vid="HOS 9:4">Cu'un kucci ndolo to o'wo tso opopofu va̱ a̱za̱ a̱ mesun a̱ a̱tsumola̱ngu,</para>
  <para style="q2" vid="HOS 9:4">aza a na a tama nle suru o to o'wo ili yi idaba.</para>
  <para style="q1" vid="HOS 9:4">A ta lyuwa ilyalya i nda na aciyele,</para>
  <para style="q2" vid="HOS 9:4">amma a̱ ta̱wa̱ na̱ yi o U'wa wa̱ A̱sulazuva shi.<verse eid="HOS 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 9:5" />Ili i ne i ɗa yaa yuwan o urana wa̱ a̱buki a na a zuwai?</para>
  <para style="q2" vid="HOS 9:5">Cine tsa ɗa yaa yuwan a̱buki a̱ A̱sulazuva?<verse eid="HOS 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 9:6" />Ka̱lyuwa̱i, ko na a la'a diga o kototosu,</para>
  <para style="q2" vid="HOS 9:6">Masar to ɓoloto le,</para>
  <para style="q2" vid="HOS 9:6">Memfi ta̱ ciɗo le.</para>
  <para style="q1" vid="HOS 9:6">Ma̱lyo ma ta usa ili i sa'ani i azurufa i le,</para>
  <para style="q2" vid="HOS 9:6">awanda a̱ ta̱ da̱na̱ o ogodo e le.<verse eid="HOS 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 9:7" />Rana vo oforo ta̱ lo a̱ ta̱wa̱,</para>
  <para style="q2" vid="HOS 9:7">urana wa atsupu u ta̱wa̱ ta̱,</para>
  <para style="q2" vid="HOS 9:7">lyawa Isra'ila reve na̱ yi.</para>
  <para style="q1" vid="HOS 9:7">Adama a na nusu ɗu ta̱ a̱bunda̱</para>
  <para style="q2" vid="HOS 9:7">waru i'ima̱ i ɗu i ta̱ kpara,</para>
  <para style="q1" vid="HOS 9:7">hali na ya tarasa vumava̱sula̱ ulo u ɗa,</para>
  <para style="q2" vid="HOS 9:7">vuma na ri na̱ ruhu u jaara ta̱.<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="LUK 21:22">Luk 21:22</ref>.</char></note><verse eid="HOS 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 9:8" />Vumava̱sula̱, oɓolo na̱ A̱sula̱ a̱ va̱,</para>
  <para style="q2" vid="HOS 9:8">a̱yi ɗa za vu uka̱lyuwusa̱ wa Ifiramu.</para>
  <para style="q2" vid="HOS 9:8">Na̱ ne suru yakuru ta pura e re va̱ yi suru,</para>
  <para style="q2" vid="HOS 9:8">ni i'ima̱ a̱tsuma̱ o U'wa wa̱ A̱sula̱ a̱ yi.<verse eid="HOS 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 9:9" />A yuwan ta̱ a̱ru'un a̱tsuma̱ o ulambu wa̱ a̱ɓula̱,</para>
  <para style="q2" vid="HOS 9:9">cine vu revei rana va Gibiya.<note caller="-" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="JDG 19:1-30">A̱.Ug 19:1-30</ref>.</char></note></para>
  <para style="q1" vid="HOS 9:9">A̱sula̱ a ta cuwan ni iwuya i le</para>
  <para style="q2" vid="HOS 9:9">a̱vu u ca le a̱tsuma̱lima̱ adama a̱ nusu le.<verse eid="HOS 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 9:10" />&lt;&lt;Cine vu revei ataci a̱tsuma̱ o una,</para>
  <para style="q2" vid="HOS 9:10">ne ɗa n cinai Isra'ila.</para>
  <para style="q1" vid="HOS 9:10">Cine vu revei umatsun wu ufaru wu uɗanga wu ubiri a yashi yu ufaru,</para>
  <para style="q2" vid="HOS 9:10">me ene ta̱ nkaya n ɗu.</para>
  <para style="q1" vid="HOS 9:10">Agba a na a̱ ta̱wa̱i Ba'al Peyo,</para>
  <para style="q2" vid="HOS 9:10">a̱vu a ca aciyele e ekere a̱ma̱li o wono o ndolo</para>
  <para style="q2" vid="HOS 9:10">reve wo o'wo ili yi idaba cine vu revei ili i na a cigai.<verse eid="HOS 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 9:11" />Tsugbain tsa Ifiramu tsu ta 'yawan she damma manunu,</para>
  <para style="q2" vid="HOS 9:11">babu limatan, babu a̱a̱tsuma̱, waa tara a̱a̱tsuma̱ shi.<verse eid="HOS 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 9:12" />Ko na a kungwato muwun,</para>
  <para style="q2" vid="HOS 9:12">suru na̱ ne n ta̱ da̱na̱ a̱ mona me le.</para>
  <para style="q1" vid="HOS 9:12">Addama a ta cina le</para>
  <para style="q2" vid="HOS 9:12">n na̱ n kakasa ne ele!<verse eid="HOS 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 9:13" />Me ene ta̱ Ifiramu, she damma Taya,</para>
  <para style="q2" vid="HOS 9:13">na a̱ cu'wa̱in uba̱ta̱ u sa'ani.</para>
  <para style="q1" vid="HOS 9:13">Amma Ifiramu ta̱ uta̱a̱</para>
  <para style="q2" vid="HOS 9:13">na̱ muwun ma̱ yi a paɗasa le.&gt;&gt;<verse eid="HOS 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 9:14" />Ca le, A̱sulazuva,</para>
  <para style="q2" vid="HOS 9:14">ili i ne i ɗa vaa ca le?</para>
  <para style="q1" vid="HOS 9:14">Ca le umatsutsun u na wa̱a̱ ɓa̱na̱ a̱a̱tsuma̱ shi</para>
  <para style="q2" vid="HOS 9:14">oɓolo na̱ maani ma na ma̱ ri na̱ mini shi.<verse eid="HOS 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 9:15" />Reve A̱sulazuva a damma,</para>
  <para style="q1" vid="HOS 9:15">&lt;&lt;Adama e iwuya i le a̱tsuma̱ a Gilga,</para>
  <para style="q2" vid="HOS 9:15">n 'yuwan le ta̱ ɗe.</para>
  <para style="q1" vid="HOS 9:15">Adama a linga vi iwuya i le,</para>
  <para style="q2" vid="HOS 9:15">n to lo le o U'wa u va̱.</para>
  <para style="q1" vid="HOS 9:15">M buwa a ciga le shi.</para>
  <para style="q2" vid="HOS 9:15">Azagbain e le suru a̱za̱ o u'ya̱susa̱n wu ugbozu u ɗa.<verse eid="HOS 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 9:16" />A lapa ta̱ Ifiramu,</para>
  <para style="q2" vid="HOS 9:16">aralu e le e 'yewe ta̱,</para>
  <para style="q2" vid="HOS 9:16">aa matsan muwun shi.</para>
  <para style="q1" vid="HOS 9:16">Ko na a matsan,</para>
  <para style="q2" vid="HOS 9:16">n to una muwun n na a cigai.&gt;&gt;<verse eid="HOS 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 9:17" />A̱sula̱ a̱ va̱ a ta 'yuwan le</para>
  <para style="q2" vid="HOS 9:17">adama a na a zuwaa niyi atsuvu shi.</para>
  <para style="q2" vid="HOS 9:17">O to o'wo a̱za̱ a̱ a̱ka̱nda̱riya̱ a̱tsuma̱ a nɗa.<verse eid="HOS 9:17" /></para>
  <chapter eid="HOS 9" />
  <chapter number="10" style="c" sid="HOS 10" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 10:1" />Isra'ila da̱na̱ ta̱ tsa ataci a na a balasa,</para>
  <para style="q2" vid="HOS 10:1">u matsan ta̱ muwun adama a aciya̱yi.</para>
  <para style="q1" vid="HOS 10:1">Muwun ma̱ yi a balasa,</para>
  <para style="q2" vid="HOS 10:1">a̱yi a̱ da̱shi suwusa musa'a.</para>
  <para style="q1" vid="HOS 10:1">Cine iɗa ya̱ yi yaa lyuwusa elime,</para>
  <para style="q2" vid="HOS 10:1">ne ɗa atsura a na waa yuwusaan a̱ga̱nda̱ aa lyuwusa elime.<verse eid="HOS 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 10:2" />Okolo e le a̱za̱ e ikpa'a a ɗa,</para>
  <para style="q2" vid="HOS 10:2">gogo a ciga a 'yuwan a̱ ushi akunda o unusu u le.</para>
  <para style="q1" vid="HOS 10:2">A̱sulazuva a̱ ta̱ rukutsa̱ musa'a n le</para>
  <para style="q2" vid="HOS 10:2">reve u lungusa̱ atsura a na a yuwusaan a̱ga̱nda̱.<verse eid="HOS 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 10:3" />Ɗaɗa aa damma, &lt;&lt;Tsu ri na̱ mogono shi,</para>
  <para style="q2" vid="HOS 10:3">adama a na tsu ri o wovon wa̱ A̱sulazuva shi.</para>
  <para style="q1" vid="HOS 10:3">Agba ko na̱ tsu shi na̱ mogono,</para>
  <para style="q2" vid="HOS 10:3">nye i ɗa waa yuwaan tsu?&gt;&gt;<verse eid="HOS 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 10:4" />A yuwan ta̱ nzuwulai ma̱ a̱bunda̱,</para>
  <para style="q2" vid="HOS 10:4">a yuwan akucunu e epen</para>
  <para style="q2" vid="HOS 10:4">a̱vu a̱ usula̱i.</para>
  <para style="q1" vid="HOS 10:4">A̱vu uge'etosu wu uta̱</para>
  <para style="q2" vid="HOS 10:4">cine vu revei anlya a na a̱ ri na̱ tsukono a atsusa a cimba.<verse eid="HOS 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 10:5" />Ama a na a̱ ri nden a̱tsuma̱ a Samariya a uwwa ta̱ wovon</para>
  <para style="q2" vid="HOS 10:5">adama o uzuɗu u ma̱dindim ma̱ a̱ma̱li ma Bet Aven.</para>
  <para style="q1" vid="HOS 10:5">Ama a̱ yi a̱ ta̱ showen yi.</para>
  <para style="q2" vid="HOS 10:5">Ne ɗa fo nan ganu a̱ a̱ga̱nda̱ a̱ a̱ma̱li,</para>
  <para style="q2" vid="HOS 10:5">adama a na tsugbain tsa̱ a̱ma̱li'i wu kasa ta̱ ne le.<verse eid="HOS 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 10:6" />A ta tara yi a̱ tyo Asuriya</para>
  <para style="q2" vid="HOS 10:6">tsu une'e uba̱ta̱ u mogono ma gbain.</para>
  <para style="q1" vid="HOS 10:6">A ta zuwa Ifiramu o wono,</para>
  <para style="q2" vid="HOS 10:6">a̱vu Isra'ila uwwa wono adama a̱ a̱ma̱li a̱ yi.<verse eid="HOS 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 10:7" />Samariya na̱ mogono ma̱ yi mo to koto</para>
  <para style="q2" vid="HOS 10:7">cine vu revei mini ma̱ tsu pura̱ maɗanga.<verse eid="HOS 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 10:8" />A̱ ta̱ lungusa̱ ba̱ta̱ va̱ a̱ga̱nda̱ e iwuya ya agaɗi,</para>
  <para style="q2" vid="HOS 10:8">a̱yi ɗa unusu wa Isra'ila.</para>
  <para style="q1" vid="HOS 10:8">Awanda oɓolo ne ma̱lyo a ta kungwa</para>
  <para style="q2" vid="HOS 10:8">reve a pala musa'a n le.</para>
  <para style="q1" vid="HOS 10:8">Reve a damma nsasan n le, &lt;&lt;Pala ntsu!&gt;&gt;</para>
  <para style="q2" vid="HOS 10:8">Reve a damma agaɗi, &lt;&lt;Riya̱a̱ ntsu!&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="LUK 23:30">Luk 23:30</ref>; <ref loc="REV 6:16">Wen 6:16</ref>.</char></note><verse eid="HOS 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 10:9" />Reve A̱sulazuva a damma,</para>
  <para style="q1" vid="HOS 10:9">&lt;&lt;Diga a mantsa ma Gibiya, i yuwan ta̱ unusu, a̱ɗu aza a Isra'ila,</para>
  <para style="q2" vid="HOS 10:9">reve i lyuwa elime.</para>
  <para style="q1" vid="HOS 10:9">Uvon u lyuwa a aci</para>
  <para style="q2" vid="HOS 10:9">aza a na a yuwusan iwuya a̱tsuma̱ a Gibiya shi?<note caller="-" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="JDG 19:1-30">A̱.Ug 19:1-30</ref>.</char></note><verse eid="HOS 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 10:10" />A mantsa ma na n cigai, n ta ca le oforo.</para>
  <para style="q2" vid="HOS 10:10">Nɗa n to ɓoloto a yuwan uvon ne e le</para>
  <para style="q2" vid="HOS 10:10">reve a zuwa le wunlu adama a̱ nusu va̱ a̱bunda̱ e le.&gt;&gt;<verse eid="HOS 10:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 10:11" />&lt;&lt;Ifiramu a̱na̱wun a nan a ɗa</para>
  <para style="q2" vid="HOS 10:11">na a yuwain aguta za na a uwwusa uyo'o wo osoroto,</para>
  <para style="q1" vid="HOS 10:11">gogo n zuwaa ta̱ yinlu i sa'ani ya Isra'ila</para>
  <para style="q2" vid="HOS 10:11">a̱gba̱la̱ o ume.</para>
  <para style="q1" vid="HOS 10:11">N ta̱ gba̱ra̱ Ifiramu.</para>
  <para style="q2" vid="HOS 10:11">Yahuda ciga u 'yuwan u luma,</para>
  <para style="q2" vid="HOS 10:11">Yakubu ciga u 'yuwan wu ɓoso iɗa adama a aciya̱yi.<verse eid="HOS 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 10:12" />I cu'wa̱a̱n aciya̱ɗu a̱ɓula̱,</para>
  <para style="q2" vid="HOS 10:12">a̱vu i gasa amayun a na a̱ ri n koto shi,</para>
  <para style="q1" vid="HOS 10:12">a̱vu yi ɓoso iɗa i na koto a lumai shi.</para>
  <para style="q2" vid="HOS 10:12">Adama a na mantsa ma na yaa zami A̱sulazuva a ɗa,</para>
  <para style="q1" vid="HOS 10:12">adama u ta̱wa̱</para>
  <para style="q2" vid="HOS 10:12">u ro'oo ɗu a̱ɓula̱.<verse eid="HOS 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 10:13" />Amma i cu'wa̱n ta̱ iwuya,</para>
  <para style="q2" vid="HOS 10:13">a̱vu i gasa ulambu wa̱ a̱ɓula̱,</para>
  <para style="q2" vid="HOS 10:13">i lyuwa ta̱ muwun me epen.</para>
  <para style="q1" vid="HOS 10:13">Adama a na yi isawain o ucira wa aciya̱ɗu</para>
  <para style="q2" vid="HOS 10:13">na̱ a̱soja o ukpakukupa ukpaku u ɗu,<verse eid="HOS 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 10:14" />mesun mo uvon ma̱ ta̱ 'yon a̱tsuma̱ a ama a̱ ɗu.</para>
  <para style="q2" vid="HOS 10:14">Reve ba̱ta̱ vu ucira ɗu a̱ ra̱mo suru,</para>
  <para style="q1" vid="HOS 10:14">cine Shalman ra̱moyi Bet Abel o urana wu uvon,</para>
  <para style="q2" vid="HOS 10:14">a na a kpasu'wai nan mma oɓolo na̱ muwun n le.<verse eid="HOS 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 10:15" />Tsundolo tsa ɗa aa yuwaan ɗu, a̱vu Betel,</para>
  <para style="q2" vid="HOS 10:15">adama a̱ba̱jini e iwuya ya̱ wu.</para>
  <para style="q1" vid="HOS 10:15">Na̱ wasasa,</para>
  <para style="q2" vid="HOS 10:15">o to kototo mogono ma Isra'ila suru suru.&gt;&gt;<verse eid="HOS 10:15" /></para>
  <chapter eid="HOS 10" />
  <chapter number="11" style="c" sid="HOS 11" />
  <para style="s">Icigi ya̱ A̱sula̱ a̱ tyo ya aza a Isra'ila</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 11:1" />Reve A̱sulazuva a damma,</para>
  <para style="q1" vid="HOS 11:1">&lt;&lt;Ana Isra'ila da̱na̱i mawun,</para>
  <para style="q2" vid="HOS 11:1">n ciga yi ta̱,</para>
  <para style="q2" vid="HOS 11:1">waru, n ɗe ta̱ mawun ma̱ va̱ mo uta̱ Masar.<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="EXO 4:22">Mta̱ 4:22</ref>; <ref loc="MAT 2:15">Mat 2:15</ref>.</char></note><verse eid="HOS 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 11:2" />Amma a̱mu e ɗesu aza a Isra'ila,</para>
  <para style="q2" vid="HOS 11:2">e le a̱ da̱shi ka̱ra̱sa̱.</para>
  <para style="q1" vid="HOS 11:2">A lyuwa ta̱ elime a casu kucci a̱ tyo ya Ba'al</para>
  <para style="q2" vid="HOS 11:2">oɓolo na̱ a̱tsuka̱ o ukula̱tosu va̱ a̱ma̱li.<verse eid="HOS 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 11:3" />Na̱ ne suru a̱mu ɗa n ritoi Ifiramu mmalu,</para>
  <para style="q2" vid="HOS 11:3">m ɓa̱na̱ ta̱ ekere e le.</para>
  <para style="q2" vid="HOS 11:3">Agba e reve a na a̱mu ɗa n ka̱mba̱to nle gbaga shi.<verse eid="HOS 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 11:4" />N rono le ta̱ na amunga e isa'ani,</para>
  <para style="q2" vid="HOS 11:4">a̱vu mu nla̱ le ni icigi.</para>
  <para style="q1" vid="HOS 11:4">Reve mo o'wo le</para>
  <para style="q2" vid="HOS 11:4">cine vu revei za na tsu ka̱mba̱to a̱a̱gba̱la̱ e inan va̱n a̱ yinlu i le,</para>
  <para style="q2" vid="HOS 11:4">reve n ka̱ɗa̱to n lyuwato le.<verse eid="HOS 11:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="HOS 11:5" />&lt;&lt;A̱a̱ ka̱mba̱ e iɗa ya Masar shi,</para>
  <para style="q2" vid="HOS 11:5">agba Asuriya to o'wo le mogono,</para>
  <para style="q2" vid="HOS 11:5">adama a na a 'yuwain a̱ ka̱mba̱ uba̱ta̱ u va̱.<verse eid="HOS 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 11:6" />Matsun me pe'eni ma ta paɗala e ilyuci i le,</para>
  <para style="q2" vid="HOS 11:6">a̱vu u lungusa̱ akpata a̱ na̱ntsu n le,</para>
  <para style="q2" vid="HOS 11:6">a̱vu u kototo le adama e ifoɓi i le.<verse eid="HOS 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 11:7" />Ama a̱ va̱ a zuwa ta̱ okolo a na aa vadalaa mu ucina̱.</para>
  <para style="q2" vid="HOS 11:7">Agba ko ne e ɗe Mogono ma̱ A̱sula̱,</para>
  <para style="q2" vid="HOS 11:7">wa̱a̱ 'ya̱sa̱n le shi ko ke'en.<verse eid="HOS 11:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HOS 11:8" />&lt;&lt;Cine tsa ɗa maa lyawa wu, a̱vu Ifiramu?</para>
  <para style="q2" vid="HOS 11:8">Cine tsa ɗa maa kasa na̱ a̱vu Isra'ila?</para>
  <para style="q1" vid="HOS 11:8">Cine maa yuwan na̱ a̱ɗu cine n yuwain na̱ Aduma?</para>
  <para style="q2" vid="HOS 11:8">Cine maa yuwan na̱ a̱ɗu cine n yuwain na̱ Zeboyim?<note caller="-" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="DEU 29:23">U.Wl 29:23</ref>.</char></note></para>
  <para style="q1" vid="HOS 11:8">U ɓa̱li mu ta̱ lon,</para>
  <para style="q2" vid="HOS 11:8">waru icigi i va̱ i ta̱ da̱shishi.<verse eid="HOS 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 11:9" />Maa yuwan na̱ a̱ɗu a̱tsuma̱ o upan wa̱ a̱bunda̱ a̱ va̱ shi,</para>
  <para style="q2" vid="HOS 11:9">ma̱a̱ da̱shi kototo Ifiramu shi.</para>
  <para style="q1" vid="HOS 11:9">Adama a na a̱mu A̱sula̱ a ɗa, agba vuma shi,</para>
  <para style="q2" vid="HOS 11:9">a̱mu za va Akiza ɗa na ri a̱tsuma̱ a̱ ɗu.</para>
  <para style="q1" vid="HOS 11:9">Ma̱a̱ ta̱wa̱ ya̱'a̱ ɗu a̱tsuma̱ o upan wu usuɗuwu shi.<verse eid="HOS 11:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="HOS 11:10" />&lt;&lt;O to toni A̱sulazuva.</para>
  <para style="q2" vid="HOS 11:10">U ta saala tsa kamu,</para>
  <para style="q1" vid="HOS 11:10">reve nu u saala,</para>
  <para style="q2" vid="HOS 11:10">muwun ma̱ yi n ta̱wa̱ e meje'en ma̱ lipu diga a̱livu.<verse eid="HOS 11:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 11:11" />Reve A̱sulazuva a damma,</para>
  <para style="q1" vid="HOS 11:11">a̱ ta̱ ta̱wa̱ e meje'en ma̱ lipu</para>
  <para style="q2" vid="HOS 11:11">tsu nnunu diga Masar,</para>
  <para style="q1" vid="HOS 11:11">tsa muɗa diga e iɗa ya Asuriya.</para>
  <para style="q2" vid="HOS 11:11">A̱vu n ka̱mbuwa̱ le a 'wa le.<verse eid="HOS 11:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 11:12" />Ifiramu ka̱nda̱ruwa̱ mu ta̱</para>
  <para style="q2" vid="HOS 11:12">ne epen a̱bunda̱,</para>
  <para style="q1" vid="HOS 11:12">u'wa wa Isra'ila u ka̱nda̱ruwa̱ mu ta̱</para>
  <para style="q2" vid="HOS 11:12">na̱ wulumu.</para>
  <para style="q1" vid="HOS 11:12">Amma Yahuda guza̱ ta̱ A̱sula̱,</para>
  <para style="q2" vid="HOS 11:12">waru u ta̱ na amayun e ekere a Za va Akiza.&gt;&gt;<verse eid="HOS 11:12" /></para>
  <chapter eid="HOS 11" />
  <chapter number="12" style="c" sid="HOS 12" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 12:1" />Reve A̱sulazuva a damma,</para>
  <para style="q1" vid="HOS 12:1">&lt;&lt;Ifiramu ta guɓusa upepu,</para>
  <para style="q2" vid="HOS 12:1">u to tono upepu wa asana urana ma̱ɓula̱</para>
  <para style="q2" vid="HOS 12:1">waru a̱ da̱shishi epen nu u'ya̱susa̱n wu ugbozu.</para>
  <para style="q1" vid="HOS 12:1">A yuwan ta̱ nzuwulai na aza a Asuriya,</para>
  <para style="q2" vid="HOS 12:1">reve a tanu mani'in ma̱ zetun a̱ tyo Masar.<verse eid="HOS 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 12:2" />A̱sulazuva a̱ ta̱wa̱ ta̱ na adanshi a aci a Yahuda.</para>
  <para style="q2" vid="HOS 12:2">U ta ca Yakubu a̱tsuma̱lima̱ adama e ili i na u yuwain,</para>
  <para style="q2" vid="HOS 12:2">reve waru u tsupa yi adama a linga va̱ yi.<verse eid="HOS 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 12:3" />Pe a̱ a̱a̱tsuma̱ u reme ta̱ a̱civa̱ a za va̱ yi.<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="GEN 25:26">Ufr 25:26</ref>.</char></note></para>
  <para style="q2" vid="HOS 12:3">Ana u rawai vali reve u yuwan mpolo na̱ A̱sula̱.<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="GEN 32:24-26">Ufr 32:24-26</ref>.</char></note><verse eid="HOS 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 12:4" />U yuwan ta̱ mpolo na̱ malingata ma̱ A̱sula̱ a̱vu u lyuwa aci a̱ yi.</para>
  <para style="q2" vid="HOS 12:4">U shon ta̱ a̱vu u pati isa'ani ya̱ yi.</para>
  <para style="q1" vid="HOS 12:4">U cina ta̱ A̱sula̱ ɗe Betel,</para>
  <para style="q2" vid="HOS 12:4">ɗe ɗa u yuwain adanshi na̱ yi.<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="GEN 28:10-22">Ufr 28:10-22</ref>.</char></note><verse eid="HOS 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 12:5" />A̱sulazuva, A̱sula̱ o oɓolo a̱ a̱soja a zuva,</para>
  <para style="q2" vid="HOS 12:5">A̱sulazuva a ɗa ala a na a̱ ri n cuwusan na̱ a̱yi!<verse eid="HOS 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 12:6" />Vu ciga vu 'yuwan vu ka̱mba̱ uba̱ta̱ wa̱ A̱sula̱.</para>
  <para style="q2" vid="HOS 12:6">Vu ɓa̱na̱ icigi na̱ a̱ɓula̱,</para>
  <para style="q2" vid="HOS 12:6">reve vu purosu A̱sula̱ a̱ wu kuci.&gt;&gt;<verse eid="HOS 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="HOS 12:7" />Reve A̱sulazuva a damma,</para>
  <para style="q1" vid="HOS 12:7">&lt;&lt;Aza a atsulu na awina a tsu yuwan ta̱ ulinga ni ili ya akunda a babu ulobonu,</para>
  <para style="q2" vid="HOS 12:7">a ciga ta̱ yipalishi.<verse eid="HOS 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 12:8" />Ifiramu damma ta̱,</para>
  <para style="q2" vid="HOS 12:8">&lt;N ta̱ nu utsuru wa̱ a̱bunda̱, n tsura̱ ta̱ ikebe.</para>
  <para style="q1" vid="HOS 12:8">Nu utsuru u va̱ suru</para>
  <para style="q2" vid="HOS 12:8">a̱a̱ tsura̱ mu ni iwuya ko unusu shi.&gt; &gt;&gt;<verse eid="HOS 12:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 12:9" />&lt;&lt;A̱mu ɗa A̱sulazuva A̱sula̱ a̱ ɗu,</para>
  <para style="q2" vid="HOS 12:9">za na uta̱a̱ nɗu e iɗa ya Masar.</para>
  <para style="q1" vid="HOS 12:9">N ta zuwa i da̱nu waru a̱tsuma̱ o ogodo a̱ ɗu,</para>
  <para style="q2" vid="HOS 12:9">cine a yuwusain a mantsa ma̱ a̱buki a na n zuwai.<verse eid="HOS 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 12:10" />N yuwan ta̱ adanshi na ama̱sula̱,</para>
  <para style="q2" vid="HOS 12:10">n roco le ta̱ alavu alavu a̱ a̱bunda̱</para>
  <para style="q2" vid="HOS 12:10">reve n yuwaan le adanshi ni iroci o una̱ wa ama̱sula̱.&gt;&gt;<verse eid="HOS 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 12:11" />&lt;&lt;Giliyadu ta̱ na ahali a awuya?</para>
  <para style="q2" vid="HOS 12:11">Ama a̱ yi a̱ ri na̱ a̱ɓula̱ shi!</para>
  <para style="q1" vid="HOS 12:11">A ta casu kucci vi inan ɗe Gilga?</para>
  <para style="q2" vid="HOS 12:11">Musa'a n le n to o'wo cine vu revei oɓolo a atali</para>
  <para style="q2" vid="HOS 12:11">e iɗa i na a lumai.&gt;&gt;<verse eid="HOS 12:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="HOS 12:12" />Yakubu suma ta̱ a̱ tyo e iɗa ya Suriya.</para>
  <para style="q2" vid="HOS 12:12">Yakubu linga ta̱ adama u tsura̱ ka,</para>
  <para style="q2" vid="HOS 12:12">waru adama u tsupa adama a̱ yi,</para>
  <para style="q2" vid="HOS 12:12">u guɓusa ta̱ ikyon.<note caller="-" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="GEN 29:1-20">Ufr 29:1-20</ref>.</char></note><verse eid="HOS 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 12:13" />A̱sulazuva a yuwan ta̱ ulinga na̱ vumava̱sula̱ u ta̱wa̱to Isra'ila diga Masar,</para>
  <para style="q2" vid="HOS 12:13">na̱ vumava̱sula̱ ɗa u ka̱lyuwusa̱ niyi.<verse eid="HOS 12:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 12:14" />Ifiramu zuwa ta̱ A̱sulazuva a yuwan upan lon.</para>
  <para style="q2" vid="HOS 12:14">A̱sulazuva a̱ yi a ta yuwaan yi</para>
  <para style="q2" vid="HOS 12:14">cine u yuwain adama o unusu wa̱ yi u wocosu wu mpasa</para>
  <para style="q2" vid="HOS 12:14">na adama e ili i wono i na u yuwain.<verse eid="HOS 12:14" /></para>
  <chapter eid="HOS 12" />
  <chapter number="13" style="c" sid="HOS 13" />
  <para style="s">Upan wa̱ A̱sulazuva a aci aza a Isra'ila</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 13:1" />Ana Ifiramu yuwain adanshi, ama e je'en ta̱ lipu,</para>
  <para style="q2" vid="HOS 13:1">a ca yi ta̱ tsugbain a̱tsuma̱ a Isra'ila.</para>
  <para style="q2" vid="HOS 13:1">Amma u yuwan ta̱ unusu a yuwusaan Ba'al a̱ga̱nda̱ reve u kuwa̱.<verse eid="HOS 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 13:2" />Gogo a ta lyuwusa elime nu unusu,</para>
  <para style="q2" vid="HOS 13:2">a yuwusaan aciyele a̱ma̱li na̱ azurufa le,</para>
  <para style="q1" vid="HOS 13:2">uruma u sa'ani,</para>
  <para style="q2" vid="HOS 13:2">suru nle ulinga u maruma u ɗa.</para>
  <para style="q1" vid="HOS 13:2">A yuwan ta̱ adanshi adama a ama a nda:</para>
  <para style="q2" vid="HOS 13:2">&lt;&lt;A ca ta̱ kucci vu vaɗilima̱</para>
  <para style="q2" vid="HOS 13:2">reve a katala yi.&gt;&gt;<verse eid="HOS 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 13:3" />Adama o ndolo o to o'wo tsa a'iza o usana,</para>
  <para style="q2" vid="HOS 13:3">tsa a'iza o usana a na a̱ tsu puwa̱n.</para>
  <para style="q2" vid="HOS 13:3">O to o'wo cine vu revei owopo a na upepu u tsu pura̱ a mantsa mo uyeluwu,</para>
  <para style="q2" vid="HOS 13:3">cine waru vu revei mikyon n tsu uta̱ o usowoto wu upepu.<verse eid="HOS 13:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 13:4" />Reve A̱sulazuva a damma,</para>
  <para style="q1" vid="HOS 13:4">&lt;&lt;A̱mu ɗa A̱sulazuva A̱sula̱ a̱ a̱ɗu,</para>
  <para style="q2" vid="HOS 13:4">a mantsa ma na i da̱na̱i a̱tsuma̱ a Masar,</para>
  <para style="q1" vid="HOS 13:4">i reve A̱sula̱ o ro shi, she a̱mu goon,</para>
  <para style="q2" vid="HOS 13:4">babu na̱ a̱mu, babu Za vi Iwawi i ro.<verse eid="HOS 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 13:5" />A̱mu ɗa n ka̱lyuwusa̱ nɗu a̱tsumona,</para>
  <para style="q2" vid="HOS 13:5">e iɗa yu u'yewu.<note caller="-" style="x"><char style="xo" closed="false">13:5 </char><char style="xt" closed="false"><ref loc="DEU 8:11-17">U.Wl 8:11-17</ref>.</char></note><verse eid="HOS 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 13:6" />Ana n lyuwato le, a̱ cuwa̱n ta̱.</para>
  <para style="q2" vid="HOS 13:6">Ana a̱ cuwa̱in, reve a̱ 'ya̱sa̱n avangaci,</para>
  <para style="q2" vid="HOS 13:6">a̱vu e icina na̱ a̱mu.<verse eid="HOS 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 13:7" />Adama o ndolo n ta̱ ta̱wa̱ le tsa kamu,</para>
  <para style="q2" vid="HOS 13:7">tsu uta̱su u ɗa ma̱a̱ piri le o ure.<verse eid="HOS 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 13:8" />N ta̱ riya̱a̱ le tsa biya na a usai muwun,</para>
  <para style="q2" vid="HOS 13:8">n ta̱ riya̱a̱ le a̱vu mu ɓatsa nka̱ka̱n n le.</para>
  <para style="q1" vid="HOS 13:8">Cine vu revei kamu ɗa maa tama le.</para>
  <para style="q2" vid="HOS 13:8">Cine vu revei nama vu una ɗa maa kara le mukari mukari.&gt;&gt;<verse eid="HOS 13:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 13:9" />&lt;&lt;O kototo ɗu ta̱, aza a Isra'ila,</para>
  <para style="q2" vid="HOS 13:9">adama a na i ta̱ a̱ nla̱ngi na̱ a̱mu, i ta̱ a̱ nla̱ngi na̱ za na aa kambusa ɗu.<verse eid="HOS 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 13:10" />Te ɗa mogono ma̱ wu, ma na maa wawa wu?</para>
  <para style="q2" vid="HOS 13:10">Te ɗa azagbain e ilyuci i ɗu suru,</para>
  <para style="q1" vid="HOS 13:10">aza a na i dammai,</para>
  <para style="q2" vid="HOS 13:10">&lt;Ca numu mogono na azagbain&gt;?<note caller="-" style="x"><char style="xo" closed="false">13:10 </char><char style="xt" closed="false"><ref loc="1SA 8:5-6">1 Sam 8:5-6</ref>.</char></note><verse eid="HOS 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 13:11" />N ca ɗu ta̱ mogono a̱tsuma̱ o upan u va̱,</para>
  <para style="q2" vid="HOS 13:11">reve n tara yi o upan wu usuɗuwu u va̱.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">13:11 </char><char style="xt" closed="false"><ref loc="1SA 10:17-24">1 Sam 10:17-24</ref>; <ref loc="1SA 15:26">15:26</ref>.</char></note><verse eid="HOS 13:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="HOS 13:12" />&lt;&lt;Unusu wa Ifiramu u tu uzuwu,</para>
  <para style="q2" vid="HOS 13:12">nusu va̱ yi tu uɗanu.<verse eid="HOS 13:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 13:13" />Mɓa̱la̱ mu ka limatan n ta̱wa̱ ta̱ ya̱'a̱ yi,</para>
  <para style="q2" vid="HOS 13:13">agba a̱yi mawun ma ɗa babu ugbozu.</para>
  <para style="q1" vid="HOS 13:13">Ana mantsa ma rawai,</para>
  <para style="q2" vid="HOS 13:13">u 'yuwan ta̱ a na aa matsan yi.<verse eid="HOS 13:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 13:14" />N ta wawa le diga o ucira wu uba̱ta̱ wa̱ a̱kwa̱kwa̱,</para>
  <para style="q2" vid="HOS 13:14">n ta wawa le diga o ukwa̱.</para>
  <para style="q1" vid="HOS 13:14">Ukwa̱ te ɗa mɓa̱la̱ ma̱ wu?</para>
  <para style="q2" vid="HOS 13:14">Te ɗa, ucira wa̱ wu uba̱ta̱ wa̱ a̱kwa̱kwa̱?</para>
  <para style="q1" vid="HOS 13:14">&lt;Mee ene iliyali ya̱ wu shi,&gt;<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="1CO 15:55">1 Kor 15:55</ref>.</char></note><verse eid="HOS 13:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="HOS 13:15" />ko na u balai a̱tsuma̱ a ama a̱ yi,</para>
  <para style="q1" vid="HOS 13:15">upepu wa asana wa̱ A̱sulazuva u ta̱ ta̱wa̱,</para>
  <para style="q2" vid="HOS 13:15">a lapusa diga a̱tsumona.</para>
  <para style="q1" vid="HOS 13:15">Reve esu a̱ mini a̱ yi e 'yewe,</para>
  <para style="q2" vid="HOS 13:15">reve waru oko'o e 'yewe.</para>
  <para style="q1" vid="HOS 13:15">A̱ ta̱ pura̱ itana i sa'ani</para>
  <para style="q2" vid="HOS 13:15">i mopon me izuwa ya̱ yi suru.<verse eid="HOS 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 13:16" />Ama a Samariya a ta tanu unusu u le,</para>
  <para style="q2" vid="HOS 13:16">adama a na a yuwayin A̱sula̱ e le aciyogbamu.</para>
  <para style="q1" vid="HOS 13:16">A̱ to una le na̱ matsun me pe'eni.</para>
  <para style="q2" vid="HOS 13:16">A ta gasa muwun n le mupaɗi mupaɗi,</para>
  <para style="q2" vid="HOS 13:16">a̱ma̱ci a̱a̱tsuma̱ e le waru a̱ ta̱ ɗa̱ra̱ le.&gt;&gt;<verse eid="HOS 13:16" /></para>
  <chapter eid="HOS 13" />
  <chapter number="14" style="c" sid="HOS 14" />
  <para style="s">Uvadalasa u tsu ta̱wa̱a̱ ta̱ na aba'un</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 14:1" />A̱ɗu aza a Isra'ila,</para>
  <para style="q1" vid="HOS 14:1">ka̱mba̱i, uba̱ta̱ wa̱ A̱sulazuva A̱sula̱ a̱ ɗu.</para>
  <para style="q2" vid="HOS 14:1">I riya̱ ta̱ adama a̱ nusu ɗu.<verse eid="HOS 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 14:2" />I ka̱mba̱ uba̱ta̱ wa̱ A̱sulazuva na adanshi</para>
  <para style="q2" vid="HOS 14:2">i damma yi, &lt;&lt;Vu yuwaan tsu gafura vu nusu suru,</para>
  <para style="q1" vid="HOS 14:2">vu ushi tsu ne ekere e re,</para>
  <para style="q2" vid="HOS 14:2">reve a̱tsu na aciya̱tsu tsu cuwa wu na̱ na̱ tsu,</para>
  <para style="q2" vid="HOS 14:2">o una̱ u kucci vo ogono e inan.<verse eid="HOS 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 14:3" />Asuriya aa gura wawa tsu shi,</para>
  <para style="q2" vid="HOS 14:3">tsaa gura kumba e ido shi,</para>
  <para style="q1" vid="HOS 14:3">tsaa gura da̱shi damma ili i na ekere a̱ tsu a yuwain, &lt;Musula̱ n tsu&gt; shi,</para>
  <para style="q2" vid="HOS 14:3">adama a na e ekere a̱ wu a ɗa</para>
  <para style="q2" vid="HOS 14:3">mkpa'an n tsu tsura̱ isa'ani.&gt;&gt;<verse eid="HOS 14:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 14:4" />Reve A̱sulazuva a damma,</para>
  <para style="q1" vid="HOS 14:4">&lt;&lt;Ucina̱ u na a̱ shi a vadala na̱ mu,</para>
  <para style="q2" vid="HOS 14:4">n ta yuwan le gafura</para>
  <para style="q2" vid="HOS 14:4">reve n ciga le na amayun,</para>
  <para style="q2" vid="HOS 14:4">adama a na upan u va̱ u von ta̱ aci e le.<verse eid="HOS 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 14:5" />N to o'wo tsa a'iza uba̱ta̱ wa aza a Isra'ila.</para>
  <para style="q2" vid="HOS 14:5">Ɗaɗa woo ɓoso tsa̱ yipa̱lu yu una.</para>
  <para style="q1" vid="HOS 14:5">U ta yuwan aralu</para>
  <para style="q2" vid="HOS 14:5">tsu uɗanga u Lebanon,<verse eid="HOS 14:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 14:6" />ototopi a̱ yi a ta kungwa.</para>
  <para style="q1" vid="HOS 14:6">Ulobonu wa̱ yi u to o'wo tsu uɗanga u zetun,</para>
  <para style="q2" vid="HOS 14:6">ma̱guru ma̱ yi waru tsu uɗanga u Lebanon.<verse eid="HOS 14:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 14:7" />Ama a̱ ta̱ da̱shi da̱nu a̱ lulu va̱ yi.</para>
  <para style="q2" vid="HOS 14:7">U ta bala tsi ishina.</para>
  <para style="q1" vid="HOS 14:7">U to ɓoso tsa ataci,</para>
  <para style="q2" vid="HOS 14:7">ala a̱ yi o to o'wo tsa masayan ma̱ Lebanon.<verse eid="HOS 14:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 14:8" />A̱vu Ifiramu, nye ma̱a̱ da̱shi yuwan na̱ a̱ma̱li?</para>
  <para style="q2" vid="HOS 14:8">N ta̱ usu yi reve n ka̱lyuwa̱ yi.</para>
  <para style="q1" vid="HOS 14:8">N ta̱ tsu uɗanga u na u ri na̱ a̱vu'un a̱lima̱ kuci.</para>
  <para style="q2" vid="HOS 14:8">Utsuru u limatan wa̱ wu uba̱ta̱ u va̱ u ɗa wu uta̱i.&gt;&gt;<verse eid="HOS 14:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 14:9" />Zane ɗa ri nu ugbozu? U te reve ili i nda.</para>
  <para style="q2" vid="HOS 14:9">Zane ɗa ri nu urevu wi ili? U ta̱ tsura̱ urevu wi ili i nda.</para>
  <para style="q1" vid="HOS 14:9">Re va̱ A̱sulazuva ta̱ mejege,</para>
  <para style="q2" vid="HOS 14:9">za va̱ a̱ɓula̱ tsu kuru ta̱ a̱tsuma̱ e le.</para>
  <para style="q2" vid="HOS 14:9">Amma aza a na a̱ tsu 'ya̱susa̱n a aci a̱ tsu ta̱ɗa̱tsa̱ ta̱ a̱tsuma̱ e le.<verse eid="HOS 14:9" /></para>
  <chapter eid="HOS 14" />
</usx>