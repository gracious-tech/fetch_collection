<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ZEP" style="id">- Tsishingini (tsw)</book>
  <para style="h">Zafaniya</para>
  <para style="toc3">Zaf</para>
  <para style="toc2">Zafaniya</para>
  <para style="toc1">Zafaniya</para>
  <para style="mt2">Zafaniya</para>
  <para style="mt1">Zafaniya</para>
  <para style="is">Ucuɗuwu wa aatagada a nda</para>
  <para style="ip">Zafaniya vumava̱sula̱ yuwan ta̱ adanshi e ikaka o ukosu wa a'wan ukpakucindere (700) kafu a matsan Yesu. U ta gura o'wo adanshi e ikaka i nda i fara ta̱ a'wan kupa kafu Mogono Josiya yuwan ulapulu wi itoni a a'wan ukpakukupa uta̱li nu ushin na̱ za ta̱ (621) kafu limatan va̱ Yesu.</para>
  <para style="ip">Aatagada'a u ta̱ ni idanshi yi ikaka i na a̱ ri urevu ne e le, za na aa dansa, urana wu uge'etosu nu ukototosu u ta̱ lo a̱ ta̱wa̱ na A̱sulazuva aa yuwaan Yahuda adama a na wa yuwusaan musula̱ n ro a̱ga̱nda̱. Waru A̱sulazuva a̱ ta̱ ge'eto akapi a nɗa suru.</para>
  <para style="ip">Ko na wo o'woi e ge'eto ta̱ Urishelima, acina elime a̱ ta̱ ka̱mbuwa̱i cine u da̱na̱i. Ama a na a̱a̱ da̱nu pe, o to o'wo ama a na a̱ ka̱ɗa̱toi aciyele oɓolo na̱ a̱za̱ a̱ a̱ɓula̱. A̱sulazuva na aciya̱yi u ta yuwan ma̱za̱nga̱ o una̱ wa akapi ama a̱yi na buwai.</para>
  <para style="iot">Ili i na i ri pe a̱tsuma̱ a aatagada a nda</para>
  <para style="io">Urana u na A̱sulazuva e ge'eto Yahuda ta̱ lo a̱ ta̱wa̱ 1:1-18</para>
  <para style="io">Ɗewu adama o uvadalasa 2:1-3</para>
  <para style="io">Uge'etosu wu nɗa ma atakpaci 2:4-15</para>
  <para style="io">Uge'etosu wa̱ Urishelima ni iwawi ya̱ yi 3:1-13</para>
  <para style="io">Ishipa i ma̱za̱nga̱ 3:14-20.</para>
  <para style="ib" />
  <chapter number="1" style="c" sid="ZEP 1" />
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1" />A mantsa ma na Josiya ulobo wa Amon da̱na̱i o tsugono tsa Yahuda, vumava̱sula̱ Zafaniya ulobo wa Kush, ulobo wa Gedaliya, mawun ma tsukaya ma Amariya wu u'wa wa Hezekiya, damma ta̱ ili i na A̱sulazuva a damma niyi.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 22:1-23:30">2 Ngo 22:1-23:30</ref>; <ref loc="2CH 34:1-35:27">2 Alb 34:1-35:27</ref>.</char></note><verse eid="ZEP 1:1" /></para>
  <para style="s">Urana wu uge'etosu wa̱ A̱sulazuva</para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 1:2" />Reve A̱sulazuva a damma, &lt;&lt;N ta̱ kototo ili biti</para>
  <para style="q2" vid="ZEP 1:2">a̱tsuma̱ o uvaɗi.&gt;&gt;<verse eid="ZEP 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 1:3" />&lt;&lt;N ta̱ kototo vaɗilima̱</para>
  <para style="q2" vid="ZEP 1:3">ni inama yu uvaɗi suru,</para>
  <para style="q1" vid="ZEP 1:3">n ta̱ kototo nnunu</para>
  <para style="q2" vid="ZEP 1:3">na̱ mugula m mala,</para>
  <para style="q1" vid="ZEP 1:3">n ta̱ kototo a̱za̱ e iwuya,</para>
  <para style="q2" vid="ZEP 1:3">a̱vu n tawa vaɗilima̱ diga o uvaɗi.&gt;&gt;<verse eid="ZEP 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 1:4" />&lt;&lt;N ta̱ ba̱ruwa̱ ukere u va̱ n yuwan nla̱ngi na̱ Yahuda</para>
  <para style="q2" vid="ZEP 1:4">na aza a na a̱ ri nden a̱tsuma̱ a̱ Urishelima suru.</para>
  <para style="q1" vid="ZEP 1:4">Waru n to kototo akapi ama a na a yuwusaan Ba'al a̱ga̱nda̱</para>
  <para style="q2" vid="ZEP 1:4">na ala a nan ganu a na a yuwusan yi ulinga.<verse eid="ZEP 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 1:5" />N ta̱ kototo aza a na a tsu kumba ukwa̱'a̱</para>
  <para style="q2" vid="ZEP 1:5">a yuwaan urana na̱ woto na̱ italyo'o a̱ga̱nda̱.</para>
  <para style="q1" vid="ZEP 1:5">N ta̱ kototo aza a na a̱ ka̱ɗa̱tosu a kucinasa na̱ A̱sulazuva,</para>
  <para style="q2" vid="ZEP 1:5">waru a yuwusan akucunu na̱ ma̱sula̱ Mole.<verse eid="ZEP 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 1:6" />N ta̱ kototo aza a na a vadalai ucina a lyawai itoni ya̱ A̱sulazuva,</para>
  <para style="q2" vid="ZEP 1:6">na aza a na a zamiyi A̱sulazuva ko a pati niyi ikambishi shi.&gt;&gt;<verse eid="ZEP 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 1:7" />Vu rungwa̱ kpen a̱ ma̱ka̱nka̱ ma̱ A̱sulazuva!</para>
  <para style="q2" vid="ZEP 1:7">Adama a na urana wa̱ yi u yuwan ta̱ zuzu.</para>
  <para style="q1" vid="ZEP 1:7">A̱sulazuva o foɓo ta̱ na wa ca a ama a̱ yi kucci,</para>
  <para style="q2" vid="ZEP 1:7">waru u ɗangula ta̱ aza a yuwan ili i na u foɓoi.<verse eid="ZEP 1:7" /></para>
  <para style="s">Uge'etosu a aci azagbain o mogono</para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 1:8" />&lt;&lt;Urana u na a̱mu A̱sulazuva maa ca ama a̱ va̱ kucci,</para>
  <para style="q2" vid="ZEP 1:8">n ta̱ ge'eto azagbain o mogono na̱ muwun n mogono,</para>
  <para style="q1" vid="ZEP 1:8">na aza a na oo otosu a̱tugu a̱ga̱nda̱</para>
  <para style="q2" vid="ZEP 1:8">a̱ musula̱ mi iɗa i ro.<verse eid="ZEP 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 1:9" />O urana u ndolo n ta̱ ge'eto za na suru</para>
  <para style="q2" vid="ZEP 1:9">a yuwusan a̱ga̱nda̱ tsa za na revei A̱sula̱ shi<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="fq" closed="false">a yuwusan a̱ga̱nda̱ tsa za na revei A̱sula̱ shi </char><char style="ft" closed="false">A̱yi nda agadu aza a Filistiya a ɗa. Ka̱lyuwa̱ 1 Sam 5:5.</char></note>,</para>
  <para style="q1" vid="ZEP 1:9">na aza a na o shitoyin u'wa wu zagbain le</para>
  <para style="q2" vid="ZEP 1:9">ni ili ya usa na̱ yipalishi.&gt;&gt;<verse eid="ZEP 1:9" /></para>
  <para style="s">Uge'etosu a aci aza a atsulu na awina a Urishelima</para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 1:10" />A̱vu A̱sulazuva a damma, &lt;&lt;O urana u ndolo,</para>
  <para style="q2" vid="ZEP 1:10">a ta uwwa mesun diga o Una̱ntsu u Magula,</para>
  <para style="q1" vid="ZEP 1:10">yorori diga o Upasu u ire,</para>
  <para style="q2" vid="ZEP 1:10">ni ilama yu ucira i ma̱riya̱ ma agaɗi.<verse eid="ZEP 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 1:11" />Oruwoi, a̱ɗu aza a na i ri nden upasu we eden!</para>
  <para style="q2" vid="ZEP 1:11">Adama a na o kototo ta̱ suru aza a atsulu na awina,</para>
  <para style="q1" vid="ZEP 1:11">aza a na a tsulusa azurufa suru</para>
  <para style="q2" vid="ZEP 1:11">o una le ta̱.<verse eid="ZEP 1:11" /></para>
  <para style="s">Uge'etosu e ekere aza a na a cayi okolo shi</para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 1:12" />A mantsa mo ndolo</para>
  <para style="q2" vid="ZEP 1:12">n ta gbangaɗa Urishelima ni ifitila,</para>
  <para style="q1" vid="ZEP 1:12">a̱vu n ca a̱za̱ nden n vama oforo,</para>
  <para style="q2" vid="ZEP 1:12">aza a na aa yuwusan majiyan,</para>
  <para style="q2" vid="ZEP 1:12">&lt;A̱sulazuva a yuwan tsu isa'ani ko iwuya shi.&gt;<verse eid="ZEP 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 1:13" />A̱ ta̱ pura̱ utsuru u le,</para>
  <para style="q2" vid="ZEP 1:13">'wa le waru o kototo le,</para>
  <para style="q2" vid="ZEP 1:13">a ta suwa 'wa agba a̱ da̱nu pe shi.</para>
  <para style="q1" vid="ZEP 1:13">A̱ ta̱ cu'wa̱n a̱ɗuma̱ a̱ ina̱bi</para>
  <para style="q2" vid="ZEP 1:13">agba oo sowo masayan me le shi.&gt;&gt;<verse eid="ZEP 1:13" /></para>
  <para style="s">Urana wa̱ A̱sulazuva</para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 1:14" />Urana u gbain wa̱ A̱sulazuva</para>
  <para style="q2" vid="ZEP 1:14">a yuwan ta̱ zuzu a̱ zura̱sa̱ ni ilaɗi.</para>
  <para style="q1" vid="ZEP 1:14">Uwwai! Uɗyo u mesun ma̱ A̱sulazuva ma̱ ta̱ da̱na̱ okono,</para>
  <para style="q2" vid="ZEP 1:14">o urana'a za a na gurai uvon u ta yuwan yisali lon.<verse eid="ZEP 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 1:15" />Urana u ndolo u to o'wo urana wu upan,</para>
  <para style="q2" vid="ZEP 1:15">urana u ɗa wa̱ a̱tsumola̱ngu na̱ a̱tsuma̱lima̱,</para>
  <para style="q1" vid="ZEP 1:15">urana u ɗa wa̱ a̱tsuma̱lima̱ nu ukototosu,</para>
  <para style="q2" vid="ZEP 1:15">urana u ɗa wi irumbu pici,</para>
  <para style="q1" vid="ZEP 1:15">urana u ɗa we eleshe ni irumbu da̱n.<verse eid="ZEP 1:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="ZEP 1:16" />Urana u ɗa u mesun ma avana na̱ yorori yu uvon</para>
  <para style="q2" vid="ZEP 1:16">a aci e ilyuci i na i ri na̱ kari vu ucira</para>
  <para style="q2" vid="ZEP 1:16">na atsura o uga'an.<verse eid="ZEP 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 1:17" />&lt;&lt;N ta̱ ta̱wa̱a̱ ama na̱ a̱tsuma̱lima̱</para>
  <para style="q2" vid="ZEP 1:17">hali e reme mmalu tsa̱ nrumba̱,</para>
  <para style="q1" vid="ZEP 1:17">adama a na a yuwaan ta̱ A̱sulazuva unusu.</para>
  <para style="q2" vid="ZEP 1:17">O to oco mpasa n le tsa̱ mini,</para>
  <para style="q2" vid="ZEP 1:17">inama i le waru tse everi.&gt;&gt;<verse eid="ZEP 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 1:18" />O urana wu upan wa̱ A̱sulazuva</para>
  <para style="q2" vid="ZEP 1:18">azurufa na̱ zinariya le</para>
  <para style="q2" vid="ZEP 1:18">aa gura wawa le shi.</para>
  <para style="q1" vid="ZEP 1:18">A̱tsuma̱ o upan wu usuɗu wa̱ yi,</para>
  <para style="q2" vid="ZEP 1:18">u to kototo uvaɗi ma̱ɓula̱.</para>
  <para style="q1" vid="ZEP 1:18">Na amayun u ta̱ kototo</para>
  <para style="q2" vid="ZEP 1:18">aza a na a̱ ri nden o uvaɗi suru.<verse eid="ZEP 1:18" /></para>
  <chapter eid="ZEP 1" />
  <chapter number="2" style="c" sid="ZEP 2" />
  <para style="s">Ɗewu adama o uvadalusa</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 2:1" />Ɓolotoi, ɓolotoi,</para>
  <para style="q2" vid="ZEP 2:1">a̱ɗu iɗa yu ulambu u wono,<verse eid="ZEP 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 2:2" />kafu e bete'we ɗu tso owopo,</para>
  <para style="q2" vid="ZEP 2:2">kafu upan wu usuɗuwu wa̱ A̱sulazuva u cipa̱a̱ ɗu,</para>
  <para style="q1" vid="ZEP 2:2">kafu urana wu upan</para>
  <para style="q2" vid="ZEP 2:2">wa̱ A̱sulazuva u ta̱wa̱ aci a̱ ɗu.<verse eid="ZEP 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 2:3" />I zami A̱sulazuva suru nɗu,</para>
  <para style="q2" vid="ZEP 2:3">a̱ɗu na i tarai aciya̱ɗu ili i ro shi e iɗa'a,</para>
  <para style="q2" vid="ZEP 2:3">a̱ɗu na yaa yuwusan ili i na u dammai.</para>
  <para style="q1" vid="ZEP 2:3">I zami ya̱ a̱ɓula̱, i tara aciya̱ɗu ili i ro wan.</para>
  <para style="q2" vid="ZEP 2:3">U ta gura o'wo a pa'aton ɗu</para>
  <para style="q2" vid="ZEP 2:3">o urana wu upan wa̱ A̱sulazuva.<verse eid="ZEP 2:3" /></para>
  <para style="s">Uge'etosu a aci aza a Filistiya</para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 2:4" />O to kototo Gaza</para>
  <para style="q2" vid="ZEP 2:4">Ashikelon to o'wo okongo.</para>
  <para style="q1" vid="ZEP 2:4">A̱ ta̱ gba̱ra̱ Ashido nu urana a aci,</para>
  <para style="q2" vid="ZEP 2:4">reve fo a̱ gba̱ra̱ Ekuron.<note caller="-" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">Ish 14:29-31</ref>; <ref loc="JER 47:1-7">Irm 47:1-7</ref>; <ref loc="EZK 25:15-17">Izk 25:15-17</ref>; <ref loc="JOL 3:4-8">Juw 3:4-8</ref>; <ref loc="AMO 1:6-8">Emo 1:6-8</ref>; <ref loc="ZEC 9:5-7">Zak 9:5-7</ref>.</char></note><verse eid="ZEP 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 2:5" />A̱tsuma̱lima̱ a ta cina a̱ɗu,</para>
  <para style="q2" vid="ZEP 2:5">a̱ɗu na i ri e ikyun i mala,</para>
  <para style="q1" vid="ZEP 2:5">a̱ɗu aza a Keretiya,</para>
  <para style="q2" vid="ZEP 2:5">adanshi a̱ A̱sulazuva a̱ ta̱ a̱ nla̱ngi na̱ ɗu,</para>
  <para style="q1" vid="ZEP 2:5">a̱vu Ka'ana iɗa ya aza a Filistiya,</para>
  <para style="q2" vid="ZEP 2:5">&lt;&lt;N ta̱ kototo wu,</para>
  <para style="q2" vid="ZEP 2:5">hali na za a la'a shi.&gt;&gt;<verse eid="ZEP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 2:6" />Iɗa i na i ri e ikyun i mala,</para>
  <para style="q2" vid="ZEP 2:6">uba̱ta̱ u na aza a Keretiya a̱ ri na̱ nden,</para>
  <para style="q1" vid="ZEP 2:6">u to o'wo uba̱ta̱ wa alyuna,</para>
  <para style="q2" vid="ZEP 2:6">nu uva̱la̱ta̱ wa aza a aguɓa</para>
  <para style="q2" vid="ZEP 2:6">nu uba̱ta̱ wa aguta e ikyon.<verse eid="ZEP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 2:7" />Uba̱ta̱'a̱ u to o'wo, uba̱ta̱ wa aza a na</para>
  <para style="q2" vid="ZEP 2:7">a buwai wuma o u'wa wa Yahuda,</para>
  <para style="q2" vid="ZEP 2:7">lo ɗa a yuwan alyuna.</para>
  <para style="q1" vid="ZEP 2:7">Nu ulivu a̱vu o von</para>
  <para style="q2" vid="ZEP 2:7">a 'wa va aza a Ashikelon.</para>
  <para style="q1" vid="ZEP 2:7">Adama a na A̱sulazuva A̱sula̱ e le a̱ ta̱ da̱na̱ a ɗa e le,</para>
  <para style="q2" vid="ZEP 2:7">waru u ta̱ ka̱mbuwa̱a̱ le na aba'un e le.<verse eid="ZEP 2:7" /></para>
  <para style="s">Uge'etosu aci a Mowa na̱ Amon</para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 2:8" />&lt;&lt;Mu uwwa ta̱ ulamu u na aza Mowa a yuwusan,</para>
  <para style="q2" vid="ZEP 2:8">na̱ wisulusa u na aza a Amon a yuwusan,</para>
  <para style="q1" vid="ZEP 2:8">aza a na ee isulusa ama a̱ va̱</para>
  <para style="q2" vid="ZEP 2:8">a lapusa ma̱ka̱nka̱ a dansa,</para>
  <para style="q2" vid="ZEP 2:8">a ta lyuwa iɗa ya ama a̱ va̱.<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="ISA 15:1-16:14">Ish 15:1-16:14</ref>; <ref loc="ISA 25:10-12">25:10-12</ref>; <ref loc="JER 48:1-49:6">Irm 48:1-49:6</ref>; <ref loc="EZK 21:28-32">Izk 21:28-32</ref>; <ref loc="EZK 25:1-11">25:1-11</ref>; <ref loc="AMO 1:13-15">Emo 1:13-15</ref>.</char></note><verse eid="ZEP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 2:9" />A̱vu A̱sulazuva o oɓolo a̱ a̱soja a zuva</para>
  <para style="q2" vid="ZEP 2:9">A̱sula̱ a Isra'ila a damma,</para>
  <para style="q1" vid="ZEP 2:9">n kucina ta̱ na̱ wuma u va̱,</para>
  <para style="q2" vid="ZEP 2:9">Mowa to o'wo tso Sodom,</para>
  <para style="q2" vid="ZEP 2:9">aza a Amon waru tsa Gomora</para>
  <para style="q2" vid="ZEP 2:9">iɗa'a u ta shiwan na awanda na̱ a̱nci a akpaɗi,</para>
  <para style="q2" vid="ZEP 2:9">iɗa i na i kuwa̱i hali hali.</para>
  <para style="q1" vid="ZEP 2:9">Ama a̱ va̱ a na a la'ai a̱ ta̱ pura̱ itana i le,</para>
  <para style="q2" vid="ZEP 2:9">wo o'wo agadu le.&gt;&gt;<verse eid="ZEP 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 2:10" />A̱yi nda a̱yi ɗa ili yi iliyinkapa ya aciyogbamu u le,</para>
  <para style="q2" vid="ZEP 2:10">adama a na a tarai ama'a ili i ro shi,</para>
  <para style="q1" vid="ZEP 2:10">reve a yuwan tsushu'un na ama</para>
  <para style="q2" vid="ZEP 2:10">a̱ A̱sulazuva o oɓolo a̱ a̱soja a zuva.<verse eid="ZEP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 2:11" />A̱sulazuva o to o'wo ili i wovon e ekere e le,</para>
  <para style="q2" vid="ZEP 2:11">na amayun u kototo ta̱ musula̱ mu uvaɗi suru.</para>
  <para style="q1" vid="ZEP 2:11">Reve nɗa n na n ri e ikyun i mala a̱ ka̱ɗa̱to wa̱ yi,</para>
  <para style="q2" vid="ZEP 2:11">za suru diga e iɗa ya̱ yi.<verse eid="ZEP 2:11" /></para>
  <para style="s">Uge'etosu a aci a̱za̱ a̱ Kush</para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 2:12" />&lt;&lt;Hali na̱ a̱ɗu fo a̱za̱ a̱ Kush,</para>
  <para style="q2" vid="ZEP 2:12">o to o una ɗu na̱ matsun me pe'eni ma̱ va̱.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="ISA 18:1-7">Ish 18:1-7</ref>.</char></note><verse eid="ZEP 2:12" /></para>
  <para style="s">Uge'etosu a aci aza a Asuriya</para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 2:13" />A̱sulazuva a̱ ta̱ ba̱ruwa̱ ukere wa̱ yi</para>
  <para style="q2" vid="ZEP 2:13">a̱ tyo wu ugana u kototo Asuriya,</para>
  <para style="q1" vid="ZEP 2:13">u ta̱ ka̱mba̱to Niniva okongo,</para>
  <para style="q2" vid="ZEP 2:13">u'yewu tsa̱ a̱tsumona.<note caller="-" style="x"><char style="xo" closed="false">2:13-15 </char><char style="xt" closed="false"><ref loc="ISA 10:5-34">Ish 10:5-34</ref>; <ref loc="ISA 14:24-27">14:24-27</ref>; <ref loc="NAM 1:1-3:19">Nah 1:1-3:19</ref>.</char></note><verse eid="ZEP 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 2:14" />Iliyamunga o to von e memere ma̱ yi,</para>
  <para style="q2" vid="ZEP 2:14">na̱ cu'un vu nama biti.</para>
  <para style="q1" vid="ZEP 2:14">Vori na̱ papagula a̱ ta̱ da̱na̱</para>
  <para style="q2" vid="ZEP 2:14">zuva va atsura a̱ lyuci'i,</para>
  <para style="q1" vid="ZEP 2:14">yisali i le i ta̱ da̱na̱ o uta̱sa̱</para>
  <para style="q2" vid="ZEP 2:14">a angu a asula na̱ na̱ntsu,</para>
  <para style="q1" vid="ZEP 2:14">n'yuwatan n ta palu'wa</para>
  <para style="q2" vid="ZEP 2:14">ɗanga seda vu kwa̱'a̱ va̱ yi.<verse eid="ZEP 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 2:15" />A̱yi nda a̱yi ɗa lyuci va afalu</para>
  <para style="q2" vid="ZEP 2:15">na shi nden gbaga,</para>
  <para style="q1" vid="ZEP 2:15">za na dammai aciya̱yi,</para>
  <para style="q2" vid="ZEP 2:15">&lt;&lt;A̱mu ɗa goon, waru za ro lo shi!&gt;&gt;</para>
  <para style="q1" vid="ZEP 2:15">A̱yi ɗa nda wo o'woi okongo,</para>
  <para style="q2" vid="ZEP 2:15">uba̱ta̱ wu nven wi inama yu una!</para>
  <para style="q1" vid="ZEP 2:15">Za na ka̱ra̱i lo suru,</para>
  <para style="q2" vid="ZEP 2:15">u ta cira a̱vu u gbaɗatsa aaci.<verse eid="ZEP 2:15" /></para>
  <chapter eid="ZEP 2" />
  <chapter number="3" style="c" sid="ZEP 3" />
  <para style="s">Uge'etosu a aci a̱ Urishelima</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 3:1" />A̱tsuma̱lima̱ a ta cina lyuci va aciyogbamu,</para>
  <para style="q2" vid="ZEP 3:1">lyuci vi idaba ni iɓongishi!<verse eid="ZEP 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 3:2" />U tsu poloo za atsuvu shi,</para>
  <para style="q2" vid="ZEP 3:2">waru u tsu usu ulapulu shi.</para>
  <para style="q1" vid="ZEP 3:2">U tsu zuwaa A̱sulazuva okolo a̱ yi shi,</para>
  <para style="q2" vid="ZEP 3:2">waru u tsu rawa zuzu na̱ A̱sula̱ shi.<verse eid="ZEP 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 3:3" />Azagbain a̱ yi a̱ ta̱ tsi ikamu i ma̱gugwa̱,</para>
  <para style="q2" vid="ZEP 3:3">a̱za̱ o uge'etosu a̱ yi a̱ ta̱ tsa̱ nkerenkesu n na n liva̱i na ambulu,</para>
  <para style="q2" vid="ZEP 3:3">aza a na a tsu buwaa ili adama a nfa'an shi.<verse eid="ZEP 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 3:4" />Ama̱sula̱ a̱ yi ama a vama a ɗa,</para>
  <para style="q2" vid="ZEP 3:4">a̱za̱ e ikpa'a,</para>
  <para style="q1" vid="ZEP 3:4">nan ganu a̱ yi a tara ili ya akiza ili i ro shi.</para>
  <para style="q2" vid="ZEP 3:4">Waru a kuɗa ta̱ wila̱.<verse eid="ZEP 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 3:5" />A̱sulazuva a na a̱ ri a̱tsuma̱ a̱ lyuci'i za va̱ a̱ɓula̱ a ɗa,</para>
  <para style="q2" vid="ZEP 3:5">u tsu yuwan unusu shi.</para>
  <para style="q1" vid="ZEP 3:5">Usana biti u tsu roco ta̱ a̱ɓula̱ a̱ yi,</para>
  <para style="q2" vid="ZEP 3:5">usana wa̱ A̱sula̱ suru u tsu ka̱la̱ma̱ shi,</para>
  <para style="q2" vid="ZEP 3:5">suru na̱ ne za vu ulambu wa̱ a̱ɓula̱ ri na̱ wono shi.<verse eid="ZEP 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 3:6" />Reve A̱sulazuva a damma, &lt;&lt;N kototo ta̱ ɗe nɗa mu uvaɗi,</para>
  <para style="q2" vid="ZEP 3:6">ba̱ta̱ vu pa'atan vu ucira le la̱nga̱ ta̱.</para>
  <para style="q1" vid="ZEP 3:6">Waru n lungusa̱ ta̱ re le,</para>
  <para style="q2" vid="ZEP 3:6">babu za na a̱ kurusu le.</para>
  <para style="q1" vid="ZEP 3:6">O kototo ta̱ ilyuci i le suru suru</para>
  <para style="q2" vid="ZEP 3:6">ko za la'a shi</para>
  <para style="q2" vid="ZEP 3:6">waru ko za ri pe shi.<verse eid="ZEP 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 3:7" />Shi ta̱ n tara na amayun, a ama a̱ va̱ a ta uwwa wovon u va̱,</para>
  <para style="q2" vid="ZEP 3:7">waru a̱ usu tsuɓari,</para>
  <para style="q2" vid="ZEP 3:7">agba a̱a̱ da̱shi yuwan ulambu wu ugbozu shi,</para>
  <para style="q2" vid="ZEP 3:7">diga e ili i na n rono nle atsuvu.</para>
  <para style="q1" vid="ZEP 3:7">Amma suru na̱ ne reve a lyuwa elime nu ulambu wa̱ a̱ɓula̱</para>
  <para style="q2" vid="ZEP 3:7">e ili i na aa yuwusan suru.<verse eid="ZEP 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 3:8" />Adama o ndolo a̱mu A̱sulazuva n damma ta̱,</para>
  <para style="q2" vid="ZEP 3:8">&lt;Puroyi urana u na ma̱ 'yon n yuwan adanshi a aci a nɗa,</para>
  <para style="q1" vid="ZEP 3:8">adama a na n zuwa ta̱ okolo a na mo ɓoloto wu nɗa,</para>
  <para style="q2" vid="ZEP 3:8">no ozo o tsugono uba̱ta̱ u ta̱,</para>
  <para style="q1" vid="ZEP 3:8">reve n tsun wa̱ le upan u va̱,</para>
  <para style="q2" vid="ZEP 3:8">upan wu usuɗu u va̱ a aci e le.</para>
  <para style="q1" vid="ZEP 3:8">Uvaɗi ma̱ɓula̱ u ta̱ koto</para>
  <para style="q2" vid="ZEP 3:8">adama o upan wu usuɗuwu u va̱.&gt; &gt;&gt;<verse eid="ZEP 3:8" /></para>
  <para style="s">Uvadalasa wu nɗa</para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 3:9" />&lt;&lt;Na amayun, a mantsa ma ɗaɗa</para>
  <para style="q2" vid="ZEP 3:9">ma̱a̱ ka̱mba̱to nɗa a̱a̱ da̱na̱ a dansa amayun,</para>
  <para style="q1" vid="ZEP 3:9">suru nle a̱ ta̱ ɗe Aala A̱sulazuva,</para>
  <para style="q2" vid="ZEP 3:9">waru a yuwayin a̱ga̱nda̱ no okolo a̱ ta̱.<verse eid="ZEP 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 3:10" />Diga a alanga o upasu wu uɗolu wa̱ Kush</para>
  <para style="q2" vid="ZEP 3:10">aza a na aa yuwusaan mu a̱ga̱nda̱,</para>
  <para style="q1" vid="ZEP 3:10">ama a̱ va̱ a na a̱ ri ubete'u,</para>
  <para style="q2" vid="ZEP 3:10">a̱ ta̱ ta̱wa̱a̱ mu na̱ kucci.&gt;&gt;<verse eid="ZEP 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 3:11" />&lt;&lt;O urana u ndolo yaa uwwa wono shi</para>
  <para style="q2" vid="ZEP 3:11">adama a̱ nusu na i yuwaan numu shi.</para>
  <para style="q1" vid="ZEP 3:11">Adama a na n ta̱ o uta̱a̱ aza a aciyogbamu</para>
  <para style="q2" vid="ZEP 3:11">no ozo o uvaɗu a̱tsuma̱ a̱ ɗu.</para>
  <para style="q1" vid="ZEP 3:11">Waru ya̱a̱ da̱shi yuwan aciyogbamu</para>
  <para style="q2" vid="ZEP 3:11">a Masasan ma Akiza ma̱ va̱ shi.<verse eid="ZEP 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 3:12" />Agba n ta lyawa aza a na a tarai aciyele ili i ro shi,</para>
  <para style="q2" vid="ZEP 3:12">na aza a na a̱ ka̱ɗa̱toi aciyele a̱tsuma̱ a̱ ɗu,</para>
  <para style="q2" vid="ZEP 3:12">a ta zami upa'anta uba̱ta̱ wa̱ A̱sulazuva.<verse eid="ZEP 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 3:13" />Aza a Isra'ila a na a buwai a̱a̱ da̱shi yuwan unusu shi,</para>
  <para style="q2" vid="ZEP 3:13">waru a̱a̱ da̱shi yuwan epen shi,</para>
  <para style="q2" vid="ZEP 3:13">agba a̱a̱ da̱shi tsura̱ epen a̱ na̱ le shi.</para>
  <para style="q1" vid="ZEP 3:13">A ta yuwan aguɓa, reve o von,</para>
  <para style="q2" vid="ZEP 3:13">agba za lo na a da'waton le shi.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="REV 14:5">Wen 14:5</ref>.</char></note><verse eid="ZEP 3:13" /></para>
  <para style="s">Ishipa i ma̱za̱nga̱</para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 3:14" />Cana ishipa nu ucira, a̱vu Sihiyona!</para>
  <para style="q2" vid="ZEP 3:14">Vu 'ya̱sa̱n uɗyo, a̱vu Isra'ila!</para>
  <para style="q1" vid="ZEP 3:14">Vu yuwan ma̱za̱nga̱</para>
  <para style="q2" vid="ZEP 3:14">waru vu yuwan mere no okolo a̱ wu suru,</para>
  <para style="q2" vid="ZEP 3:14">a̱vu Urishelima!<verse eid="ZEP 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 3:15" />A̱sulazuva a tawa ta̱ oforo a aci a̱ wu,</para>
  <para style="q2" vid="ZEP 3:15">waru u loso ta̱ n'yuwatan ma̱ wu.</para>
  <para style="q1" vid="ZEP 3:15">A̱sulazuva mogono ma Isra'ila ma̱ ta̱ oɓolo na̱ a̱vu,</para>
  <para style="q2" vid="ZEP 3:15">va̱a̱ da̱shi uwwa wovon u meleshe shi.<verse eid="ZEP 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 3:16" />O urana u ndolo a ta damma Urishelima,</para>
  <para style="q2" vid="ZEP 3:16">&lt;&lt;She vu uwwa wovon wan, a̱vu Sihiyona,</para>
  <para style="q2" vid="ZEP 3:16">she vu lyawa ekere a̱ wu a̱ ɗa̱mba̱ wan.<verse eid="ZEP 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 3:17" />A̱sulazuva A̱sula̱ a̱ wu</para>
  <para style="q2" vid="ZEP 3:17">a̱ ta̱ oɓolo na̱ a̱vu,</para>
  <para style="q2" vid="ZEP 3:17">za vu uvon ɗa, waru u tsu ulyuwu ta̱ aci.</para>
  <para style="q1" vid="ZEP 3:17">U ta yuwan ma̱za̱nga̱ a̱vu yuwan mere adama a̱ wu,</para>
  <para style="q2" vid="ZEP 3:17">u ta̱ ka̱mba̱to wu usa'avu adama e icigi ya̱ yi.</para>
  <para style="q2" vid="ZEP 3:17">U ta cana ishipa i ma̱za̱nga̱ nu ucira adama a̱ wu,<verse eid="ZEP 3:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ZEP 3:18" />ununa a tsu yuwan urana wa̱ a̱buki.</para>
  <para style="q1" vid="ZEP 3:18">N ta tawa ɗu a̱tsumola̱ngu</para>
  <para style="q2" vid="ZEP 3:18">waru ya̱a̱ da̱shi uwwa wono shi.<verse eid="ZEP 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ZEP 3:19" />Agba a mantsa'a n ta̱ ge'eto</para>
  <para style="q2" vid="ZEP 3:19">aza a na suru oo ɓongishi nɗu.</para>
  <para style="q1" vid="ZEP 3:19">N ta wawa a̱kutsuma̱</para>
  <para style="q2" vid="ZEP 3:19">reve m ɓoloto aza a na e bete'wei.</para>
  <para style="q1" vid="ZEP 3:19">Oto o'wo ili yi ica waru a ca le tsugbain,</para>
  <para style="q2" vid="ZEP 3:19">a̱ ba̱ta̱ na suru a ca nle wono.<verse eid="ZEP 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ZEP 3:20" />A mantsa mo ndolo n to ɓoloto ɗu,</para>
  <para style="q2" vid="ZEP 3:20">n ka̱mba̱to ɗu o u'wa.</para>
  <para style="q1" vid="ZEP 3:20">N ta zuwa a ca ɗu tsugbain a̱vu i tsura̱ ica</para>
  <para style="q2" vid="ZEP 3:20">a̱tsuma̱ a ama o uvaɗi suru,</para>
  <para style="q1" vid="ZEP 3:20">a mantsa ma na n ka̱mbuwa̱a̱ nɗu</para>
  <para style="q2" vid="ZEP 3:20">nu utsuru u ɗu e esu a̱ ɗu.</para>
  <para style="q1" vid="ZEP 3:20">A̱mu A̱sulazuva a ɗa n dammai ne.&gt;&gt;<verse eid="ZEP 3:20" /></para>
  <chapter eid="ZEP 3" />
</usx>