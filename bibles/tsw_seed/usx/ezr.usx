<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EZR" style="id">- Tsishingini (tsw)</book>
  <para style="h">Ezura</para>
  <para style="toc3">Ezr</para>
  <para style="toc2">Ezura</para>
  <para style="toc1">Ezura</para>
  <para style="mt2">Ezura</para>
  <para style="mt1">Ezura</para>
  <para style="is">Ucuɗuwu wa aatagada a nda</para>
  <para style="im">A ca ucuɗuwu wu za na ɗanai aatagada a nda shi. A ta majiyan ma na a ɗana ta̱ aatagada a Ezura a a'wan ukpakuna̱shi na amunga (440) kafu limatan va̱ Yesu. Alabari aatagada a nda a lyuwa ta̱ elime diga uba̱ta̱ u na Aatagada Alabari e isawain.</para>
  <para style="ip">Ukere wa̱ A̱sula̱ u da̱na̱ ta̱ pe a̱tsuma̱ e ili i na suru i farai a̱tsuma̱ aatagada a̱ Ezura. A̱sula̱ a yuwan ta̱ ne adama u shiton adanshi a na u yuwain o una̱ wa Irimiya.</para>
  <para style="ip">Apa cine ili'i i farai:</para>
  <para style="imi">1 Oɓolo o ufaru wa aza a Yahuda a na a̱ da̱na̱i e iɗa i tsugbashi a̱ ka̱mba̱ ta̱ diga a Babila o una̱ wu dammu u Mogono Sayiru va Pashiya.</para>
  <para style="imi">2 A̱da̱shi ta̱ suwisa A̱a̱'isa̱mapaɗa reve a tawai, a̱vu a̱ ka̱mba̱ a yuwusan a̱ga̱nda̱ uba̱ta̱ wa̱ A̱sula̱ a̱tsuma̱ a̱ Urishelima.</para>
  <para style="imi">3 Ana a yuwain a'wan o ro a̱vu oɓolo aza a Yahuda o ro a̱ ka̱mba̱ Urishelima za̱la̱ tsugbain tsa Ezura.</para>
  <para style="ip">Ezura za vi iɗana ɗa nu urevu wu uritosu wa Musa. A̱yi ɗa u kambai ama a na a lapula wuma wi itoni i le, wa ana'an na̱ nfa'an, adama a yuwan tsutoni na agadu e le, na̱ nzuwulai ma̱ A̱sula̱ na̱ nda̱na̱ta̱ n sa'ani wa ama a Isra'ila.</para>
  <para style="iot">Ili i na i ri pe a̱tsuma̱ a aatagada a nda</para>
  <para style="io">1 Uka̱mbu wu ufaru diga e iɗa i tsugbashi 1:1-2:70.</para>
  <para style="io1">A suwisa ta̱ waru a tawa a̱ A̱a̱'isa̱mapaɗa 3:1-6:22</para>
  <para style="io1">Ezura ka̱mba̱ ta̱ no ozo o ro diga e iɗa i tsugbashi 7:1-10:44.</para>
  <para style="ib" />
  <chapter number="1" style="c" sid="EZR 1" />
  <para style="s">Mogono Sayiru lyawa ta̱ aza a tsugbashi a̱ ka̱mba̱</para>
  <para style="r">(<ref loc="2CH 36:22-23">2 Alb 36:22-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 1:1" />A̱tsuma̱ a aa'wan o ufaru u Sayiru mogono ma Pashiya, reve A̱sulazuva o shiton adanshi a na u yuwain o una̱ u vumava̱sula̱ Irimiya, a na u ju'wa̱in okolo o mogono Sayiru a̱vu u ca udammu adama aza a Yahuda a̱ ka̱mba̱. Reve mogono'o ma zuwa a lapa ulingi wu udammu u na u cayi waru a ɗanai a̱tsuma̱ e iɗa i tsugono tsa̱ a̱yi. <verse eid="EZR 1:1" /><verse number="2" style="v" sid="EZR 1:2" />Apa nda ili i na Sayiru mogono ma Pashiya ma dammai,</para>
  <para style="b" vid="EZR 1:2" />
  <para style="pi" vid="EZR 1:2">A̱sulazuva A̱sula̱ a zuva, a ca mu ta̱ tsugono tsu uvaɗi suru, waru u zuwa mu ta̱ n suwaa yi u'wa a Urishelima a̱tsuma̱ a Yahuda. <verse eid="EZR 1:2" /><verse number="3" style="v" sid="EZR 1:3" />Za ne ɗa a̱tsuma̱ a̱ ɗu za na a̱ ri diga ama A̱sula̱ a Isra'ila? Lyawa u ka̱mba̱ a̱ tyo Urishelima za na ri e iɗa ya Yahuda, u suwisa U'wa wa̱ A̱sulazuva A̱sula̱ a Isra'ila, A̱sula̱ a na a̱ ri Urishelima. Lyawa A̱sula̱ a̱ yi a̱ da̱na̱ oɓolo na̱ yi.<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">Isha 44:28.</char></note> <verse eid="EZR 1:3" /><verse number="4" style="v" sid="EZR 1:4" />Lyawa vuma va Yahuda na la'ai biti, a̱vu ama o uba̱ta̱'a̱ a kamba yi na̱ azurufa na̱ zinariya ni itana ni iliyamunga na̱ ucasu wu ucigu wo okolo adama a̱ A̱a̱'isamapaɗa a̱ A̱sula̱ a na a̱ ri Urishelima.<verse eid="EZR 1:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="EZR 1:5" />Reve azagbain a 'wa vu nkaya ma Yahuza na̱ Banyami na̱ nan ganu na̱ nan Levi, na̱ za na A̱sula̱ a̱ ju'wa̱in okolo a̱ yi suru, u gawan a suwa U'wa wa̱ A̱sulazuva u na u ri Urishelima. <verse eid="EZR 1:5" /><verse number="6" style="v" sid="EZR 1:6" />Reve aza a na suru a̱ ri nden zuzu ne ele a kamba le ni itana i na a yuwain na̱ azurufa na̱ zinariya ni itana ni iliyamunga na̱ ne'e sa'ani oɓolo na̱ ne'e vu ucigu wo okolo.<verse eid="EZR 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 1:7" />Mogono Sayiru waru mo uta̱a̱ ta̱ itana yu U'wa ya̱ A̱sulazuva i na Nebukanaza shi pura̱i diga Urishelima reve u zuwa le a 'wa musula̱ ma̱ yi. <verse eid="EZR 1:7" /><verse number="8" style="v" sid="EZR 1:8" />Reve Sayiru mogono ma Pashiya ma zuwa Mitireda za vi izuwa wu uta̱a̱ ni itana'a u kecee Sheshibaza, zagbain va aza a Yahuda.<verse eid="EZR 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZR 1:9" />Apa nda a̱bunda̱ e le,</para>
  <para style="b" vid="EZR 1:9" />
  <para style="li1" vid="EZR 1:9">akwanu a gbagbain a zinariya mata'atsu,</para>
  <para style="li1" vid="EZR 1:9">aza a azurufa ukpakukupa (1,000)</para>
  <para style="li1" vid="EZR 1:9">na̱ mutsun ushin na̱ kucci,<verse eid="EZR 1:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="EZR 1:10" />na asa'atsu a zinariya mata'atsu</para>
  <para style="li1" vid="EZR 1:10">na asa'atsu a azurufa o ro ukpakuna̱shi na̱ kupa (410)</para>
  <para style="li1" vid="EZR 1:10">ni itana i ro ukpakukupa (1,000).<verse eid="EZR 1:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="EZR 1:11" />Suru itana i zinariya na̱ azurufa'a, e reme ta̱ ukpakukupa uton nu ukpakuna̱shi (5,400). Sheshibaza gawan ta̱ ni ili ya nda suru a mantsa ma na aza a na a̱ pura̱i diga uba̱ta̱ u tsugbashi a gawain diga Babila a̱ ka̱mba̱ Urishelima.<verse eid="EZR 1:11" /></para>
  <chapter eid="EZR 1" />
  <chapter number="2" style="c" sid="EZR 2" />
  <para style="s">A̱bunda̱ a aza a tsugbashi a na a̱ ka̱mba̱i</para>
  <para style="r">(<ref loc="NEH 7:4-73">Neh 7:4-73</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 2:1" />Ele nda ele ɗa a̱bunda̱ ama a na a lyawai upasu wi iɗa ya Babila reve a̱ ka̱mba̱ Urishelima na̱ Yahuda. Za suru ka̱mba̱ ta̱ a̱ lyuci va̱ yi. Acina mantsa ma na Nebukanaza mogono ma Babila ma̱ pura̱i nkaya n le a̱ tyo tsugbashi, limatan le da̱na̱ ta̱ nden a̱tsuma̱ a Babila. <verse eid="EZR 2:1" /><verse number="2" style="v" sid="EZR 2:2" />A̱ ka̱mba̱ ta̱ oɓolo na̱ Zerubabe na̱ Jesuwa na̱ Nehemiya na̱ Seraya na̱ Rilaya na̱ Modekaya na̱ Bilshan na̱ Misipa na̱ Bigivai na̱ Rehum na̱ Ba'ana.</para>
  <para style="b" vid="EZR 2:2" />
  <para style="p" vid="EZR 2:2">Apa ala a ama a Isra'ila a na a̱ ka̱mba̱i diga uba̱ta̱ tsugbashi na̱ a̱bunda̱ ele.<verse eid="EZR 2:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="EZR 2:3" />Limatan va Parosh, ele ɗa ama ukpakukupa ure nu ukpaku na̱ kupocindere ne ejere (2,172).<verse eid="EZR 2:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="EZR 2:4" />Limatan va Shefatiya ele ɗa ama ukpakuta'atsu na̱ kupocindere ne ejere (372).<verse eid="EZR 2:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="EZR 2:5" />Limatan va Ara ele ɗa ama ukpakucindere na̱ kupocindere no ozo o ton (775).<verse eid="EZR 2:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="EZR 2:6" />Limatan va Paha Mowa za vu u'wa wa Jesuwa na̱ Yowab ele ɗa ama ukpakukupa ure nu ukpakukunla̱ na̱ kupa ne ejere (2,812).<verse eid="EZR 2:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="EZR 2:7" />Limatan va Elam ele ɗa ama ukpakukupa nu ukpakure na̱ kupoton na̱ a̱za̱ a̱ na̱shi (1,254).<verse eid="EZR 2:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="EZR 2:8" />Limatan va Zatu ele ɗa ama ukpakukucci na amunga no ozo o ton (945).<verse eid="EZR 2:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="EZR 2:9" />Limatan va Zakai ele ɗa ama ukpakucindere na̱ kupota̱li (760).<verse eid="EZR 2:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="EZR 2:10" />Limatan va Bani ele ɗa ama ukpakuta̱li na amunga ne ejere (642).<verse eid="EZR 2:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="EZR 2:11" />Limatan va Bebai ele ɗa ama ukpakuta̱li nu ushin na aza a ta'atsu (623).<verse eid="EZR 2:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="EZR 2:12" />Limatan va Aziga ele ɗa ama ukpakukupa nu ukpakure nu ushin ne ejere (1,222).<verse eid="EZR 2:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="EZR 2:13" />Limatan va Adonikam ele ɗa ama ukpakuta̱li na̱ kupota̱li na̱ a̱za̱ a̱ ta̱li (666).<verse eid="EZR 2:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="EZR 2:14" />Limatan va Bigivai ele ɗa ama ukpakukupa ure na̱ kupoton na̱ a̱za̱ a̱ ta̱li (2,056).<verse eid="EZR 2:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="EZR 2:15" />Limatan va Adin ele ɗa ama ukpakuna̱shi na̱ kupoton na̱ a̱za̱ a̱ na̱shi (454).<verse eid="EZR 2:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="EZR 2:16" />Limatan va Ata za na a̱ tsu ɗe Hezekiya, ele ɗa ama kupakucci na̱ kunla̱.<verse eid="EZR 2:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="EZR 2:17" />Limatan va Bezai ele ɗa ama ukpakuta'atsu nu ushin na aza a ta'atsu (323).<verse eid="EZR 2:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="EZR 2:18" />Limatan va Jora ele ɗa ama ukpaku na̱ kupa ne ejere (112).<verse eid="EZR 2:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="EZR 2:19" />Limatan va Hashum ele ɗa ama ukpakure nu ushin na aza a ta'atsu (223).<verse eid="EZR 2:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="EZR 2:20" />Limatan va Giba ele ɗa ama kupakucci no ozo o ton.<verse eid="EZR 2:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="EZR 2:21" />Ama a na nkaya n le n da̱nu yi e ilyuci i nda a na a̱ ka̱mba̱i diga uba̱ta̱ u tsugbashi ele ɗa,</para>
  <para style="b" vid="EZR 2:21" />
  <para style="li1" vid="EZR 2:21">Ama a Batalami ele ɗa ukpaku nu ushin a aza a ta'atsu (123).<verse eid="EZR 2:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="EZR 2:22" />Ama a Netofa ele ɗa kupoton na̱ a̱za̱ a̱ ta̱li.<verse eid="EZR 2:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="EZR 2:23" />Ama a Anato ele ɗa ukpaku nu ushin na̱ kunla̱ (128).<verse eid="EZR 2:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="EZR 2:24" />Ama a Azumave ele ɗa amunga ne ejere.<verse eid="EZR 2:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="EZR 2:25" />Ama a Kiriyat Jeyarim na̱ Kefira na̱ Biyaro ele ɗa ukpakucindere na amunga na aza a ta'atsu (743).<verse eid="EZR 2:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="EZR 2:26" />Ama a Rama na̱ Geba ele ɗa ukpakuta̱li nu ushin na̱ za ta̱ (621).<verse eid="EZR 2:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="EZR 2:27" />Ama a Mikimash ele ɗa ukpaku nu ushin ne ejere (122).<verse eid="EZR 2:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="EZR 2:28" />Ama a Betel na̱ Ai ele ɗa ukpakure nu ushin na aza a ta'atsu (223).<verse eid="EZR 2:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="EZR 2:29" />Ama a Nebo ele ɗa kupoton ne ejere.<verse eid="EZR 2:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="EZR 2:30" />Ama a Magibish ele ɗa ukpaku na̱ kupoton na̱ a̱za̱ a̱ ta̱li (156).<verse eid="EZR 2:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="EZR 2:31" />Ama a Elam o ro ele ɗa ukpakukupa nu ukpakure na̱ kupoton na̱ a̱za̱ a̱ na̱shi (1,254).<verse eid="EZR 2:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="EZR 2:32" />Ama a Harim ele ɗa ukpaku uta'atsu nu ushin (320).<verse eid="EZR 2:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="EZR 2:33" />Ama a Lod na̱ Hadi na̱ Ono ele ɗa ukpakucindere nu ushin no ozo o ton (725).<verse eid="EZR 2:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="EZR 2:34" />Ama a̱ Jeriko ele ɗa ukpakuta'atsu na amunga no ozo o ton (345).<verse eid="EZR 2:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="EZR 2:35" />Ama a Sena'a ele ɗa ukpakukupa uta'atsu nu ukpakuta̱li na̱ mata'atsu (3,630).<verse eid="EZR 2:35" /></para>
  <para style="b" />
  <para style="p">
    <verse number="36" style="v" sid="EZR 2:36" />Apa ala a Nan ganu a na a̱ ka̱mba̱i diga uba̱ta̱ u tsugbashi.</para>
  <para style="li1" vid="EZR 2:36">Limatan va Jedaya za vu ugundo wa̱ Jesuwa ele ɗa ama ukpakukucci na̱ kupocindere na aza a ta'atsu (973).<verse eid="EZR 2:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="EZR 2:37" />Limatan va Ima ele ɗa ama ukpakukupa na̱ kupoton ne ejere (1,052).<verse eid="EZR 2:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="EZR 2:38" />Limatan va Pashihu ele ɗa ama ukpakukupa nu ukpakure na amunga na̱ a̱za̱ e cindere (1,247).<verse eid="EZR 2:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="EZR 2:39" />Limatan va Harim ele ɗa ama ukpakukupa na̱ kupa na̱ a̱za̱ e cindere (1,017).<verse eid="EZR 2:39" /></para>
  <para style="b" />
  <para style="p">
    <verse number="40" style="v" sid="EZR 2:40" />Apa ala a Nan Levi a na a̱ ka̱mba̱i diga uba̱ta̱ u tsugbashi.</para>
  <para style="b" vid="EZR 2:40" />
  <para style="li1" vid="EZR 2:40">Limatan va Jesuwa na̱ Kadimiye vu u'wa wa Hodaviya ele ɗa ama kupocindere na̱ a̱za̱ a̱ na̱shi.<verse eid="EZR 2:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="EZR 2:41" />Limatan va Asaf ashipi, ele ɗa ama ukpaku nu ushin na̱ kunla̱ (128).<verse eid="EZR 2:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="EZR 2:42" />Limatan va Shalum na̱ Ata na̱ Talmon na̱ Akub na̱ Hatita na̱ Shobai, ele ɗa a̱ a̱za̱ e ipiri yu una̱ntsu, waru ele ɗa ama ukpaku na̱ mata'atsu na̱ kucci (139).<verse eid="EZR 2:42" /></para>
  <para style="b" />
  <para style="p">
    <verse number="43" style="v" sid="EZR 2:43" />Apa ala ozo o ulinga a̱ A̱a̱'isa̱mapaɗa a na a̱ ka̱mba̱i diga uba̱ta̱ u tsugbashi.</para>
  <para style="b" vid="EZR 2:43" />
  <para style="li1" vid="EZR 2:43">Limatan va Ziha na̱ Hasufa na̱ Tabawo,<verse eid="EZR 2:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="EZR 2:44" />na̱ Kero na̱ Siyaha na̱ Padon,<verse eid="EZR 2:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="EZR 2:45" />na̱ Lebana na̱ Hagaba na̱ Akub,<verse eid="EZR 2:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="EZR 2:46" />na̱ Haga na̱ Shalmai na̱ Hanan,<verse eid="EZR 2:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="EZR 2:47" />na̱ Gidel na̱ Gaha Reyaya,<verse eid="EZR 2:47" /></para>
  <para style="li1">
    <verse number="48" style="v" sid="EZR 2:48" />na̱ Rezin na̱ Nekoda na̱ Gazam,<verse eid="EZR 2:48" /></para>
  <para style="li1">
    <verse number="49" style="v" sid="EZR 2:49" />na̱ Uza na̱ Pasiya na̱ Besai,<verse eid="EZR 2:49" /></para>
  <para style="li1">
    <verse number="50" style="v" sid="EZR 2:50" />na̱ Asna na̱ Mewunim na̱ Nefusim,<verse eid="EZR 2:50" /></para>
  <para style="li1">
    <verse number="51" style="v" sid="EZR 2:51" />na̱ Bakubu na̱ Hakufa na̱ Harahu,<verse eid="EZR 2:51" /></para>
  <para style="li1">
    <verse number="52" style="v" sid="EZR 2:52" />na̱ Bazilu na̱ Mehida na̱ Hasha,<verse eid="EZR 2:52" /></para>
  <para style="li1">
    <verse number="53" style="v" sid="EZR 2:53" />na̱ Bariko na̱ Sisera na̱ Tema,<verse eid="EZR 2:53" /></para>
  <para style="li1">
    <verse number="54" style="v" sid="EZR 2:54" />na̱ Naziya na̱ Hatifa.<verse eid="EZR 2:54" /></para>
  <para style="b" />
  <para style="p">
    <verse number="55" style="v" sid="EZR 2:55" />Apa ala agbashi a Sulemanu a na a̱ ka̱mba̱i diga uba̱ta̱ u tsugbashi.</para>
  <para style="b" vid="EZR 2:55" />
  <para style="li1" vid="EZR 2:55">Limatan va Sotai na̱ Hesofere na̱ Peruda,<verse eid="EZR 2:55" /></para>
  <para style="li1">
    <verse number="56" style="v" sid="EZR 2:56" />na̱ Ja'ala na̱ Darikon na̱ Gidel,<verse eid="EZR 2:56" /></para>
  <para style="li1">
    <verse number="57" style="v" sid="EZR 2:57" />na̱ Shefatiya na̱ Hati na̱ Pokere Hazebayim na̱ Ami.<verse eid="EZR 2:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="EZR 2:58" />A̱bunda̱ a limatan va̱ ozo o ulinga wa̱ a̱ A̱a̱'isa̱mapaɗa na̱ agbashi a Sulemanu a na a̱ ka̱mba̱i diga uba̱ta̱ u tsugbashi ele ɗa ukpakuta'atsu na̱ kupakucci ne ejere (392).<verse eid="EZR 2:58" /></para>
  <para style="b" />
  <para style="p">
    <verse number="59" style="v" sid="EZR 2:59" />Ele nda ele ɗa aza a na a̱ ta̱wa̱i diga e ilyuci ya Tel Mela na̱ Tel Hasha na̱ Kerub na̱ Adon oɓolo na̱ Ima. Agba a gura reve nu umatsun u le ko na̱ 'wa vu nkaya n le a na e le aza a Isra'ila ɗa shi.<verse eid="EZR 2:59" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="60" style="v" sid="EZR 2:60" />Limatan va Delaya na̱ Tobiya na̱ Nekoda ele ɗa ama ukpakuta̱li na̱ kupoton ne ejere (652).<verse eid="EZR 2:60" /></para>
  <para style="b" />
  <para style="p">
    <verse number="61" style="v" sid="EZR 2:61" />Diga a limatan nan ganu,</para>
  <para style="b" vid="EZR 2:61" />
  <para style="li1" vid="EZR 2:61">Limatan va Habaya na̱ Hako na̱ Bazilai.</para>
  <para style="p" vid="EZR 2:61">Vuma na zuwai usheli wa Bazilai za va Giliyadu, reve e ɗe yi na aala'a.<verse eid="EZR 2:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="EZR 2:62" />Ele a nda ɗa a zami yi ala le a̱tsuma̱ aatagada a nkaya n le, agba a̱ tsura̱ shi. Adama o ndolo a ɗa a tara n le ili yi idaba, reve o u ta̱ le a̱tsuma̱ o ulinga u tsuganu. <verse eid="EZR 2:62" /><verse number="63" style="v" sid="EZR 2:63" />Ɗaɗa gwamna damma n le aa lyuwa ilyalya i na i la'ai akiza shi hali she mantsa ma na a̱ tsura̱i ganu na aa yuwan a̱ga̱nda̱ na̱ Urim na̱ Tumim.<note caller="+" style="f"><char style="fr" closed="false">2:63 </char><char style="ft" closed="false">Mkc 27:21.</char></note><verse eid="EZR 2:63" /></para>
  <para style="b" />
  <para style="p">
    <verse number="64" style="v" sid="EZR 2:64" />A̱bunda̱ a ama a na a̱ ka̱mba̱i diga e iɗa i tsugbashi ya Yahuda ele ɗa ama ukpakukupa amunga nu ukpakukupa ure nu ukpakuta'atsu na̱ kupota̱li (42,360). <verse eid="EZR 2:64" /><verse number="65" style="v" sid="EZR 2:65" />Waru a̱ da̱na̱ ta̱ na agbashi a ali na̱ a̱ a̱ma̱ci ukpakukupa ucindere nu ukpakuta'atsu na̱ mata'atsu na̱ a̱za̱ e cindere (7,337). Waru a̱ shi ta̱ na ashipi ali na̱ a̱ma̱ci ama ukpakure (200). <verse eid="EZR 2:65" /><verse number="66" style="v" sid="EZR 2:66" />A̱ shi ta̱ ni ido ukpakucindere na̱ mata'atsu na̱ a̱za̱ a̱ ta̱li (736), na̱ nloli mi ido ukpakure na amunga no ozo o ton (245), <verse eid="EZR 2:66" /><verse number="67" style="v" sid="EZR 2:67" />na arakumi e le ukpakuna̱shi na̱ mata'atsu no ozo o ton (435) na̱ nloli n le ukpakukupa uta̱li nu ukpakucindere nu ushin (6,720).<verse eid="EZR 2:67" /></para>
  <para style="b" />
  <para style="p">
    <verse number="68" style="v" sid="EZR 2:68" />A mantsa ma na a rawai o U'wa wa̱ A̱sulazuva a̱tsuma̱ a̱ Urishelima, reve azagbain a 'wa vu matsun ro a ca kucci vu ucigu wo okolo adama a suwisa U'wa wa̱ A̱sula̱ a̱ wira̱ wa̱ yi. <verse eid="EZR 2:68" /><verse number="69" style="v" sid="EZR 2:69" />Za suru ca ta̱ une'e a̱ tyo a na waa gura ca adama o ulinga'a. Reve oɓoloto zinariya makundatsu ukpakukupa kupota̱li nu ukpakukupa (61,000) na̱ makundatsu ma azurufa ukpakukupa uton (5,000) na̱ a̱tugu a nan ganu ukpaku (100).<verse eid="EZR 2:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="EZR 2:70" />Nan ganu na̱ nan Levi na ama o ro, na ashipi na̱ a̱za̱ e ipiri yu na̱ntsu na̱ ozo o ulinga wa̱ a̱ A̱a̱'isa̱mapaɗa a̱ da̱nu ta̱ e ilyuci i le. Akapi a ama a Isra'ila a na a buwai a̱ ka̱mba̱ ta̱ e ilyuci i na nkaya n le n shi n da̱nu yi.<note caller="+" style="f"><char style="fr" closed="false">2:70 </char><char style="ft" closed="false">1 Alb 9:2; Neh 11:3.</char></note><verse eid="EZR 2:70" /></para>
  <chapter eid="EZR 2" />
  <chapter number="3" style="c" sid="EZR 3" />
  <para style="s">Usuwisa u masa'a</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 3:1" />Ana woto we cindere wi isawain, reve aza a Isra'ila a na a̱ shi nden e ilyuci i le, o ɓoloto she damma vuma ta̱ a̱tsuma̱ a̱ Urishelima. <verse eid="EZR 3:1" /><verse number="2" style="v" sid="EZR 3:2" />Reve Jesuwa ulobo wa Jozada oɓolo na̱ a̱za̱ a̱ yi nan ganu na̱ Zerubabe ulobo wa Sheyatiye na̱ a̱za̱ a̱ yi, e teme usaa u masa'a ma̱ A̱sula̱ a Isra'ila. Reve a suwa masa'a adama a na a ca kucci vu ukula̱tosu cine u ri uɗanu a̱ wila̱ wa Musa vuma va̱ A̱sula̱.<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">Mta̱ 27:1.</char></note> <verse eid="EZR 3:2" /><verse number="3" style="v" sid="EZR 3:3" />Reve a suwisa masa'a'a uba̱ta̱ u na u da̱na̱i adama a na a uwwusa ta̱ wovon wa ama e iɗa'a. A̱vu a ca A̱sulazuva kucci vu ukula̱tosu ɗe, kucci vu ukula̱tosu vu usana nu ulivu.<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">Mkc 28:1-8.</char></note> <verse eid="EZR 3:3" /><verse number="4" style="v" sid="EZR 3:4" />Reve waru a yuwan A̱buki o Ogodo cine u ri uɗanu. Reve a ca kucci vu ukula̱tosu vu urana suru o una̱ wa̱ a̱bunda̱ a̱ kucci cine a zuwai.<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">Mkc 29:12-38.</char></note> <verse eid="EZR 3:4" /><verse number="5" style="v" sid="EZR 3:5" />Ana a̱yi ndolo kotoi, a̱vu a lyuwa elime nu ucasu u kucci vu ukula̱tosu wa na'an na̱ nfa'an, na̱ Kucci va̱ A̱buki o Woto u Sa'avu na̱ A̱buki A̱sulazuva a na a zuwai suru, nu ucasu wu ucigu wo okolo e ekere a̱ A̱sulazuva. <verse eid="EZR 3:5" /><verse number="6" style="v" sid="EZR 3:6" />O urana wu ufaru u woto we cindere reve a fara a casu kucci vu ukula̱tosu e ekere a̱ A̱sulazuva. Agba koto a̱ shi a vara ikyun yu usaa ya̱ A̱a̱'isamapaɗa a̱ A̱sulazuva shi.<verse eid="EZR 3:6" /></para>
  <para style="s">Usuwisa wa̱ A̱a̱'isamapaɗa</para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 3:7" />Reve a ca ikebe adama a ca asuwi na̱ a̱za̱ o ulinga wa akpata. Reve a ca aza a Sidon na aza a Taya ilyalya ni ili yo oso na̱ mani'in ma̱ zetun a̱ ta̱wa̱a̱ na̱ ɗanga Sida diga Lebanon a mala a̱ tyo Japa, a̱bunda̱ cine Sayiru mogono ma Pashiya ma zuwai.<verse eid="EZR 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 3:8" />O woto we ire wa aa'wan e ire a na a̱ ka̱mba̱i o U'wa wa̱ A̱sula̱ a̱ Urishelima, reve Zerubabe ulobo wa Sheyatiye na̱ Jesuwa ulobo wa Jozada na akapi a̱ a̱za̱ e le nan ganu na̱ nan Levi na aza a na suru a̱ ka̱mba̱i Urishelima diga o uba̱ta̱ u tsugbashi a fara ulingaꞌa. A̱vu a zuwa nan Levi diga aa'wan ushin a gawan a̱ ka̱lyuwusa̱ ulinga wu usaa wu U'wa wa̱ A̱sulazuva. <verse eid="EZR 3:8" /><verse number="9" style="v" sid="EZR 3:9" />Jesuwa no olobo a̱ yi na̱ a̱za̱ a̱ yi na̱ Kadimiye no olobo a̱ yi na̱ limatan va Hodaviya no olobo a Henada, suru n le nan Levi ɗa, reve e idanasa ulinga wu usaa wu U'wa wa̱ A̱sula̱.<verse eid="EZR 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 3:10" />Ana asuwi a varai ikyun yu usaa wa̱ A̱a̱'isamapaɗa a̱ A̱sulazuva, a̱vu nan ganu a̱ da̱na̱ lo mishin wotowu na̱ a̱tugu a tsuganu waru uguzu na avana. Ne ɗa waru nan Levi limatan va Asaf o uta̱i za su uguzu ni nyangi, adama a cuwa A̱sulazuva cine Da̱wuda mogono ma Isra'ila ma zuwai.<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="ft" closed="false">1 Alb 25:1.</char></note> <verse eid="EZR 3:10" /><verse number="11" style="v" sid="EZR 3:11" />Reve a cana a cuwusa o godyushoo A̱sulazuva a dansa,</para>
  <para style="b" vid="EZR 3:11" />
  <para style="q2" vid="EZR 3:11">&lt;&lt;A̱sulazuva za vi isa'ani ɗa,</para>
  <para style="q2" vid="EZR 3:11">icigi ya̱ yi a̱ tyo ya aza a Isra'ila u ri na̱ a̱tyo shi.&gt;&gt;</para>
  <para style="b" vid="EZR 3:11" />
  <para style="p" vid="EZR 3:11">Reve ama suru a̱ 'ya̱sa̱n uɗyo nu ucira a cuwa A̱sulazuva, adama a na a varai ikyun yu usa yu U'wa wa̱ A̱sulazuva.<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">1 Alb 16:34; 2 Alb 5:13; 7:3; Ica 100:5; 106:1; 107:1; 118:1; 136:1; Irm 33:11.</char></note> <verse eid="EZR 3:11" /><verse number="12" style="v" sid="EZR 3:12" />Agba nan ganu na̱ a̱bunda̱ na̱ nan Levi na azagbain a 'wa na̱ mbara n na mee enei o U'wa wa̱ A̱sulazuva wu ufaru, reve e shon o uta̱a̱ uɗyo a na e enei a varai ikyun yu usaa ya̱ A̱a̱'isamapaɗa a nda, ko a na wo o'woi ozo o ro a yuwan ta̱ yisali i ma̱za̱nga̱. <verse eid="EZR 3:12" /><verse number="13" style="v" sid="EZR 3:13" />Hali ko za gura kasa uɗyo u ma̱za̱nga̱ na̱ za mesun shi adama a na ama o oruwo ta̱ lon. Hali a uwwa ɗyo le diga alanga.<verse eid="EZR 3:13" /></para>
  <chapter eid="EZR 3" />
  <chapter number="4" style="c" sid="EZR 4" />
  <para style="s">Tsushu'un adama o ulinga wu usa'a</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 4:1" />Ana n'yuwatan ma Yahuza na̱ Banyami uwwai a na aza a tsugbashi a na a̱ ka̱mba̱i a ta suwusaa A̱sulazuva A̱sula̱ a Isra'ila A̱a̱'isamapaɗa, <verse eid="EZR 4:1" /><verse number="2" style="v" sid="EZR 4:2" />a̱vu a̱ 'ya̱wa̱ ya Zerubabe na azagbain a 'wa a̱vu a damma le, &lt;&lt;Lyawa tsu ɓolo aci tsu yuwan yi usa'a oɓolo, adama a na tsu ta yuwusaan fo A̱sula̱ a̱ ɗu a̱ga̱nda̱ cine yaa yuwusan. Tsu jima ta̱ a casu yi kucci diga a mantsa ma Esahadon mogono ma Asuriya za na ta̱wa̱i na̱ a̱tsu pa na̱ nde.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:2 </char><char style="ft" closed="false">2 Alb 17:24-41.</char></note><verse eid="EZR 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 4:3" />Amma Zerubabe na̱ Jesuwa na akapi a azagbain a 'wa va aza a Isra'ila a damma le ta̱, &lt;&lt;Babu i mini i ɗu a na yaa kamba tsu nu ulinga wu usaa wa̱ A̱a̱'isamapaɗa A̱sula̱ a̱ tsu. A̱tsu ɗa goon tsa suwaa A̱sulazuva A̱sula̱ a Isra'ila usaa, cine Mogono Sayiru mogono ma Pashiya ma damma n tsu.&gt;&gt;<verse eid="EZR 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZR 4:4" />Reve ama e iɗa'a a yuwan cine biti a yuwan adama a putsaa a ama a Yahuda, reve waru a ca le wovon adama a yuwan usa'a wan. <verse eid="EZR 4:4" /><verse number="5" style="v" sid="EZR 4:5" />Reve a ca aza a na aa casu mogono a̱sa̱la̱ utowusu wu una̱ adama a̱ lungusa̱ ifoɓi i le a mantsa ma tsugono tsa Sayiru mogono ma Pashiya hali a̱ tyo a mantsa mo tsugono tso Mogono Dariyu va Pashiya.<verse eid="EZR 4:5" /></para>
  <para style="s">Mepepelime ma̱ tsushu'un adama o usuwisa wa̱ A̱a̱'isamapaɗa</para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 4:6" />O ufaru u tsugono tsa Mogono Ahasuweru<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="fq" closed="false">Ahasuweru </char><char style="ft" closed="false">A̱tsu ɗeyi ta̱ waru Atazeze.</char></note> n'yuwatan n ɗana ta̱ adanshi a aci a̱ ama a Yahuda na̱ Urishelima.<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">Est 1:1.</char></note><verse eid="EZR 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 4:7" />A rana tsugono tsa Atazeze mogono ma Pashiya, Bishlam na̱ Mitireda na̱ Tabe na akapi a aza a na a̱ ri a muwwulai a ɗanaa ta̱ Atazeze mepepelime. Ne elentsu a Tsu'arama tsa ɗa a ɗana niyi reve a cuɗuwa yi adama o mogono.<verse eid="EZR 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 4:8" />Reve Rehum yali ya̱ a̱soja na̱ Shimshai za vi iɗana a ɗana mepepelime a̱ tyo uba̱ta̱ u Mogono Atazeze a aci a̱ Urishelima.<verse eid="EZR 4:8" /></para>
  <para style="b" />
  <para style="pi">
    <verse number="9" style="v" sid="EZR 4:9" />A̱vu Rehum yali ya̱ a̱soja na̱ Shimshai za vi iɗana, oɓolo na aza a na a̱ ri a muwwulai, a̱za̱ o uge'etosu na̱ mbara na azagbain a na e idanasa pasu, diga o upasu wi iɗa ya Pashiya na̱ Ere na̱ Babila na̱ Susa na̱ Elam, <verse eid="EZR 4:9" /><verse number="10" style="v" sid="EZR 4:10" />na akapi a ama a na Asanapa zagbain pura̱i reve u ta̱wa̱ to le u zuwa le a̱ da̱nu a̱tsuma̱ a Samariya na akapi a pasu vi iɗa na ri mavada mo Uɗolu wa̱ Yufireti.<verse eid="EZR 4:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="EZR 4:11" />Apa nda ili i na a ɗanai a̱tsuma̱ e mepepelime'e.</para>
  <para style="b" vid="EZR 4:11" />
  <para style="pi" vid="EZR 4:11">&lt;&lt;Ica̱su a̱ tyo yo Mogono Atazeze diga uba̱ta̱ wa aza a na a yuwusan wu tsugbashi, ama a na a̱ ri mavada mo Uɗolu wa̱ Yufireti.&gt;&gt;<verse eid="EZR 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 4:12" />&lt;&lt;Tsu ciga ta̱ mogono me reve aza a Yahuda o ndolo aza a na a lyawai uba̱ta̱ wa̱ wu a̱ tyo uba̱ta̱ u tsu a̱ ka̱ra̱ ta̱ a̱ tyo Urishelima. A̱ da̱shi ta̱ suwisa lyuci vu u'ya̱susa̱n wa̱ a aci ni iwuya. O to kosuso usaa wu ukari'i waru a ta lapulusa ikyun yu usa'a. <verse eid="EZR 4:12" /><verse number="13" style="v" sid="EZR 4:13" />Gogo lyawa mogono me reve na a suwisa lyuci ndolo nu ukari o koto, a̱ da̱shi tsupa utafa shi, ko ikebe i ma'uwaa na̱ mota̱a̱ me e itana shi, ni ikebe yu ure shi, o ukosu ikebe yi izuwa i tsugono i ta̱ jebe. <verse eid="EZR 4:13" /><verse number="14" style="v" sid="EZR 4:14" />Gogo a na tsu peɗei uyo'o wu ukobu u tsugono, wo lobono tse ene a̱ kuɗa̱ tara mogono ili i ro shi. Adama o ndolo a ɗa tsa ɗanasa tsu revetyo mogono, <verse eid="EZR 4:14" /><verse number="15" style="v" sid="EZR 4:15" />adama a̱ bunga̱ a̱tsuma̱ a aatagada a alabari a nkaya. Vu te ene a̱tsuma̱ a aatagada a alabari a nkaya'a a na lyuci nda lyuci vu u'ya̱susa̱n wu ugbozu u ɗa. Diga ɗe a mantsa mo ufaru lyuci nda u ta casu ngono na̱ pasu a aci ya̱ a̱ mɓa̱la̱. Mantsa suru ama'a a̱ ta̱ 'ya̱susa̱n ugbozu. Adama o ndolo a ɗa a̱ lungusa̱i lyuci'i. <verse eid="EZR 4:15" /><verse number="16" style="v" sid="EZR 4:16" />Tsu te revetyosu mogono a na, na a suwisa lyuci nda reve waru o koto usaa wu ukari wa̱ yi, vaa buwa ni ili a mavada mo Uɗolu wa̱ Yufireti shi.&gt;&gt;<verse eid="EZR 4:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="EZR 4:17" />Reve mogono ma̱ lyunguwa̱ le u usu u damma,</para>
  <para style="b" vid="EZR 4:17" />
  <para style="pi" vid="EZR 4:17">&lt;&lt;Ica̱su a̱ tyo ya Rehum yali ya̱ a̱soja na̱ Shimshai za vi iɗana, na akapi aza a na i ri a muwwulai ne ele a na a̱ ri na̱ nden Samariya, oɓolo na akapi a na a̱ ri upasu u Mavada mo Uɗolu wa̱ Yufireti.<verse eid="EZR 4:17" /></para>
  <para style="pi">
    <verse number="18" style="v" sid="EZR 4:18" />Mepepelime ma na i lyunguwa̱ ntsu e ɗe yi ta̱ nu una̱ reve a cuɗuwa mu a̱yi. <verse eid="EZR 4:18" /><verse number="19" style="v" sid="EZR 4:19" />Reve n ca udammu, a̱vu a̱ bunga̱ reve e ene a na lyuci nda diga ɗe nu ujumu u ta̱ na ala a aciyogbamu e ekere o ngono, waru a̱ ta̱ na̱ a̱bunda̱ o 'ya̱susa̱n wu ugbozu na̱ nla̱ngi. <verse eid="EZR 4:19" /><verse number="20" style="v" sid="EZR 4:20" />A yuwan ta̱ ngono m gbagbain a na a yuwain tsugono a̱tsuma̱ a̱ Urishelima nu upasu u na u ri a Mavada mo Uɗolu wa̱ Yufireti, a̱ ushishi ta̱ utafa, ni ikebe i ma'uwaa na̱ mota̱a̱ me itana, ni ikebe yu ure. <verse eid="EZR 4:20" /><verse number="21" style="v" sid="EZR 4:21" />Adama o ndolo i ca udammu u na wa putsaa ama'a a lyawa usaa u lyuci'i, hali she mantsa ma na n ca yi udammu. <verse eid="EZR 4:21" /><verse number="22" style="v" sid="EZR 4:22" />I ka̱mbuwa̱ ugbozu adama a ɗa a nda, she i lyungusa̱ mantsa wan adama a̱ da̱shi yuwan ulungusu u ro u na wa̱a̱ ta̱wa̱a̱ mogono nu ulambu wan.&gt;&gt;<verse eid="EZR 4:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="EZR 4:23" />Ana e ɗeweyi Rehum na̱ Shimshai za vi iɗana na aza a na a̱ ri a muwwulai ne ele mepepelime mo mogono Atazeze, reve a̱ jika̱ a̱ 'ya̱wushi uba̱ta̱ wa aza a Yahuda a̱tsuma̱ a̱ Urishelima, reve a zuwa le a lyawa ulinga'a nu ucira.<verse eid="EZR 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 4:24" />Ne ɗa e isawaton yi ulinga wu U'wa wa̱ A̱sula̱ a na ri Urishelima, hali she a aa'wan e ire o tsugono tsa Dariyu mogono ma Pashiya.<note caller="+" style="f"><char style="fr" closed="false">4:24 </char><char style="ft" closed="false">Hag 1:1; Zak 1:1.</char></note><verse eid="EZR 4:24" /></para>
  <chapter eid="EZR 4" />
  <chapter number="5" style="c" sid="EZR 5" />
  <para style="s">Mepepelime ma Tatena a̱ tyo ya Dariyu</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 5:1" />A mantsa'a ama̱sula̱ Hagai na̱ Zakariya ulobo wa̱ Ido a yuwan ta̱ adanshi e ikaka ya̱ A̱sula̱ a̱ tyo ya aza Isra'ila a na a̱ ri na̱ nden a̱tsuma̱ a Yahuda na̱ Urishelima, na ala a̱ A̱sula̱ a Isra'ila a na a̱ ri o tsugono a aci e le.<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">Hag 1:1; Zak 1:1.</char></note> <verse eid="EZR 5:1" /><verse number="2" style="v" sid="EZR 5:2" />Reve Zerubabe ulobo wa Shiyatiyel na̱ Jesuwa ulobo wa Jozada a̱ 'yon a̱vu e teme usaa wu U'wa wa̱ A̱sula̱ a na a̱ ri Urishelima. Ama̱sula̱ a nda a̱ shi ta̱ oɓolo ne ele a kambusa le.<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">Hag 1:12; Zak 4:6-9.</char></note><verse eid="EZR 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 5:3" />A mantsa'a a̱vu Tatenai gwamna Mavada mo Uɗolu wa̱ Yufireti na̱ Sheta Bozenai na aza a na a̱ ri a muwwulai a̱ ta̱wa̱ ya̱'a̱ le a̱tsuma̱ Urishelima a̱vu a yuwan yeci a damma, &lt;&lt;Zane ɗa ca nɗu ucira i suwa U'wa u nda, reve waru i ɓoloto wi itana i nda?&gt;&gt; <verse eid="EZR 5:3" /><verse number="4" style="v" sid="EZR 5:4" />Reve waru e ece le a damma, &lt;&lt;A te ɗa ala aza a na a zama a̱ 'ya̱sa̱n usaa u nda?&gt;&gt; <verse eid="EZR 5:4" /><verse number="5" style="v" sid="EZR 5:5" />Amma ucira wa̱ A̱sula̱ u ta aci a mbara ma aza a Yahuda, adama o ndolo aa gura isawaton wu usa'a shi, hali she na a̱ 'ya̱wa̱ yi Dariyu na alabari, waru she na a̱ tsura̱i usuwu uɗanu.<verse eid="EZR 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 5:6" />Apa nda ili i na i ri e mepepelime ma na Tatenai gwamna vu upasu u Mavada mo Uɗolu wa̱ Yufireti na̱ Sheta Bozenai na aza a na a̱ ri a muwwulai ne ele a na a̱ ri mbara o upasu u Mavada mo Uɗolu wa̱ Yufireti a̱ lyunguwa̱i Dariyu mogono.<verse eid="EZR 5:6" /></para>
  <para style="pi">
    <verse number="7" style="v" sid="EZR 5:7" />Reve a̱ lyungu wa̱ yi nu ucuɗuwu uɗanu adansa.</para>
  <para style="b" vid="EZR 5:7" />
  <para style="pi" vid="EZR 5:7">&lt;&lt;A̱ tyo ya Mogono Dariyu, Vu da̱na̱ na asuvu nden! <verse eid="EZR 5:7" /><verse number="8" style="v" sid="EZR 5:8" />Tsu ciga ta̱ mogono me reve a na tsu 'ya̱wa̱i upasu wi iɗa ya Yahuda, o U'wa wa̱ A̱sula̱, A̱sula̱ a gbain o ndolo. A ta suwusa yi na atali a gbagbain a na e she'ein, waru a zuwa ta̱ akpata o uɓaɓu'u. A ta lyuwusa elime nu ulinga'a waru a ta yuwusan ulinga'a babu uro. <verse eid="EZR 5:8" /><verse number="9" style="v" sid="EZR 5:9" />Tse ece ta̱ fo azagbain ama tsu damma, &lt;Zane ca nɗu ucira i suwisa U'wa u nda, hali na i ɓolotoi itana i nda?&gt; <verse eid="EZR 5:9" /><verse number="10" style="v" sid="EZR 5:10" />Waru tse ece le ta̱ ala e le, adama tsu ɗanaa wu tsu revetyo wu azagbain a̱tsuma̱ e le. <verse eid="EZR 5:10" /><verse number="11" style="v" sid="EZR 5:11" />Reve a̱ usu tsu a damma. &lt;A̱tsu agbashi a̱ A̱sula̱ a ɗa a na a yuwain zuva ni iɗa, waru tsu ta suwusa A̱a̱'isamapaɗa a na a̱ shi a suwai ɗe a'wan na̱ a̱bunda̱ a na a̱ ka̱ra̱i, U'wa u na mogono ma gbain mo ro ma Isra'ila ma̱ shi ma suwai hali gba u koto. <verse eid="EZR 5:11" /><verse number="12" style="v" sid="EZR 5:12" />Amma a na wo o'woi nkaya n tsu n ca ta̱ A̱sula̱ a zuva upan, a̱vu u ca le e ekere a Nebukanaza mogono ma Babila vuma va Kaldiya. A̱yi ɗa za na lungusa̱i U'wa u nda, a̱vu u pura̱ ama'a a̱ tyo tsugbashi e iɗa ya Babila.<note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="ft" closed="false">2 Ngo 25:8-12; 2 Alb 36:17-20; Irm 51:12-15.</char></note> <verse eid="EZR 5:12" /><verse number="13" style="v" sid="EZR 5:13" />Amma a̱tsuma̱ aa'wan o ufaru u tsugono mo mogono Sayiru ma Babila, Sayiru Mogono ma ca ta̱ udammu a na a suwisa U'wa wa̱ A̱sula̱.<note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="ft" closed="false">Ezr 1:2-11.</char></note> <verse eid="EZR 5:13" /><verse number="14" style="v" sid="EZR 5:14" />Suru na̱ ne, Mogono Sayiru ɗa ka̱mbuwa̱i itana i zinariya na̱ azurufa ya̱ A̱a̱'isamapaɗa wa̱ A̱sulazuva a na Nebukanaza shi pura̱i diga a̱ A̱a̱'isamapaɗa a na a̱ ri Urishelima a̱vu u 'ya̱wa̱ ne ele a masa'a a̱tsuma̱ a Babila. Reve u zuwa le ekere a vuma na a̱ tsu ɗe Sheshibaza, za na a zuwai gwamna va Yahuda. <verse eid="EZR 5:14" /><verse number="15" style="v" sid="EZR 5:15" />Reve Sayiru da̱shi damma yi, &lt;&lt;Vu pura̱ itana i nda vu ka̱mbuwa̱ le a̱ A̱a̱'isamapaɗa a na a̱ ri Urishelima, reve a suwa U'wa wa̱ A̱sula̱ a̱ wira̱ wa̱ yi.&gt;&gt; <verse eid="EZR 5:15" /><verse number="16" style="v" sid="EZR 5:16" />A̱vu Sheshibaza ta̱wa̱ u vara ikyun yu usaa yu U'wa wa̱ A̱sula̱ a na a̱ ri Urishelima. Diga a mantsa mo ndolo hali n gogo a ta lyuwusa elime nu ulinga'a, agba o koto shi.&gt; <verse eid="EZR 5:16" /><verse number="17" style="v" sid="EZR 5:17" />Adama o ndolo, nu u yo'ono ta̱ mogono, lyawa a̱ ka̱lyuwa̱ a̱tsuma̱ aasula a aatagada alabari o tsugono a Babila, ko a̱ ta̱ tsura̱ u dammu u na mogono Sayiru ma ɗanai a na u ca yi udammu a na a suwisa U'wa wa̱ A̱sula̱ a na a̱ ri Urishelima, ko babu. Waru lyawa mogono ma̱ lyunguwa̱ tsu na̱ a̱sa̱la̱ a̱ yi adama aɗa a nda.&gt;&gt;<verse eid="EZR 5:17" /></para>
  <chapter eid="EZR 5" />
  <chapter number="6" style="c" sid="EZR 6" />
  <para style="s">Udammu u Mogono Dariyu</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 6:1" />Reve Mogono Dariyu ca udammu, reve a̱ bunga̱ a̱tsuma̱ aasula a atagada alabari o tsugono za na ri a Babila uba̱ta̱ u na a̱ shi a zuwai atagada alabari o tsugono tse le. <verse eid="EZR 6:1" /><verse number="2" style="v" sid="EZR 6:2" />Agba a̱vu a̱ tsura̱ a aatagada'a a̱tsuma̱ a Ekibatana lyuci gbain vu upasu wi iɗa ya Midiya a na a ɗanai,</para>
  <para style="b" vid="EZR 6:2" />
  <para style="pi" vid="EZR 6:2">Ili yu ucuwusan.<verse eid="EZR 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 6:3" />&lt;&lt;A̱tsuma̱ aa'wan o ufaru u tsugono tsa Mogono Sayiru, u ca ta̱ udammu adama o U'wa wa̱ A̱sula̱ a na a̱ ri Urishelima. U ca ta̱ udammu u na a suwisa U'wa'a, uba̱ta̱ u na a ca kucci. Lyawa a vara ikyun yu usa'a, waru a zuwa uga'an wa̱ yi mishin ana kupakucci, washin wa̱ yi waru ana kupakucci. <verse eid="EZR 6:3" /><verse number="4" style="v" sid="EZR 6:4" />Waru apa cine a suwa uɓaɓu wa̱ yi. O ukuruwu wa atali a ta'atsu a gbagbain a na e she'ein biti, a ta zuwa ukuruwu uta̱ wa aakpata. Diga e izuwa yu ukobu u mogono ma ɗa aa tsupa ikebe yu ulinga'a. <verse eid="EZR 6:4" /><verse number="5" style="v" sid="EZR 6:5" />Waru lyawa a̱ ka̱mbuwa̱ ni itana i zinariya na̱ azurufa yu U'wa wa̱ A̱sula̱ aza a na Nebukanaza pura̱i diga a̱ A̱a̱'isamapaɗa a na a̱ ri Urishelima a̱ ta̱wa̱ Babila. A̱ ka̱mbuwa̱ le suru uba̱ta̱ u na a̱ da̱na̱i a̱ A̱a̱'isamapaɗa a̱tsuma̱ a̱ Urishelima. A̱vu a zuwa le o U'wa wa̱ A̱sula̱.&gt;&gt;<verse eid="EZR 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 6:6" />&lt;&lt;Reve Mogono Dariyu lyungu nu usuwu u nda u damma, a̱ tyo ya Tatenai gwamna vu upasu u Mavada mo Uɗolu wa̱ Yufireti na̱ Sheta Bozenai na̱ a̱ɗu aza a na i ri ya muwwulai na̱ ne le mbara mu upasu u Mavada mo Uɗolu wa̱ Yufiriti, i lyawa uba̱ta̱'a̱. <verse eid="EZR 6:6" /><verse number="7" style="v" sid="EZR 6:7" />I tawa ekere a̱ ɗu diga o ulinga wa̱ A̱a̱'isamapaɗa a̱ A̱sula̱ a nda adama u lyuwa elime. Waru i lyawa gwamna va aza a Yahuda oɓolo na̱ mbara nle a suwisa U'wa wa̱ A̱sula̱ a̱ wira̱ wa̱ yi. <verse eid="EZR 6:7" /><verse number="8" style="v" sid="EZR 6:8" />Waru, n ta casu udammu adama e ili i na ko i ciga i 'yuwan i na ya yuwan adama i kamba mbara ma aza a Yahuda adama a suwisa U'wa wa̱ A̱sula̱. Waru a tsupa ikebe yu ulinga ya ama'a diga e izuwa yu ukobu wu u'wa u mogono, ikebe yu utafa yu upasu u Mavada mo Uɗolu wa̱ Yufireti. Waru a tsupa menle me le babu usa̱n. <verse eid="EZR 6:8" /><verse number="9" style="v" sid="EZR 6:9" />Waru i ca nan ganu a na a̱ ri Urishelima ili i na a cigai vu urana suru babu bula̱. I ca le ogono e inan na̱ a̱giri'i ko mugiri'i adama a̱ kucci vu ukula̱tosu a̱ tyo ekere a̱ A̱sula̱ a Zuva. Ko akpaɗi ko masayan ma̱ ina̱bi ko mani'in ma̱ zetun. <verse eid="EZR 6:9" /><verse number="10" style="v" sid="EZR 6:10" />A ta yuwan tsun nda adama a gura ca kucci na yo'onoto A̱sula̱ a zuva okolo, waru a yuwan avasa adama a wuma u mogono no olobo a̱ yi. <verse eid="EZR 6:10" /><verse number="11" style="v" sid="EZR 6:11" />Waru n ca ta̱ udammu ana, suru za na vadalai wila̱ u nda, a ta tara a̱a̱gba̱la̱ o u'wa wa̱ yi reve e cembeɗe a̱a̱gba̱la̱'a̱ a̱vu a sapa vuma'a na̱ a̱yi she nu u tusulai lipu va̱ yi. Waru o to kototo wu u'wa wa̱ yi kpa̱ra̱. <verse eid="EZR 6:11" /><verse number="12" style="v" sid="EZR 6:12" />Lyawa A̱sulazuva na zuwai ala a̱ yi a̱ da̱nu a̱ a̱tsuma̱ a̱ Urishelima, u foɗo suru mogono ko ama a na a zama a vadala wila̱ u nda, ko a zama a̱ lungusa̱ A̱a̱'isamapaɗa a̱ A̱sula̱ a Urishelima. A̱mu Mogono Dariyu n zuwa ta̱ wila̱ u nda, lyawa a̱ kuru yi mejege.&gt;&gt;<verse eid="EZR 6:12" /></para>
  <para style="s">Ucasu wa̱ A̱a̱'isamapaɗa</para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 6:13" />Reve Tatenai gwamna vu upasu u Mavada mo Uɗolu wa̱ Yufireti na̱ Sheta Bozenai na aza a na a̱ ri a muwwulai o toni wila̱ u na Dariyu zuwai mejege. <verse eid="EZR 6:13" /><verse number="14" style="v" sid="EZR 6:14" />Ne ɗa mbara ma Yahuda a lyuwai elime nu usa'a waru a̱ ta̱ tsura̱sa̱ ulyuwu wa aci adama a alajiya a a̱ma̱sula̱ Hagai na̱ Zakariya ulobo wa Ido. Reve o koto usa'a ununa A̱sula̱ a Isra'ila a dammai Sayiru na̱ Dariyu na̱ Atazeze ngono ma Pashiya.<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false">Hag 1:1; Zak 1:1.</char></note> <verse eid="EZR 6:14" /><verse number="15" style="v" sid="EZR 6:15" />Reve o koto usaa wu Uwa'a o urana wa ta'atsu u woto wa Ada<note caller="+" style="f"><char style="fr" closed="false">6:15 </char><char style="fq" closed="false">Ada </char><char style="ft" closed="false">Ada a̱yi ɗa u shi woto wa ta'atsu wa aa'wan wa aza a Isra'ila.</char></note>, a̱tsuma̱ aa'wan a̱ ta̱li o tsugono tsa Dariyu Mogono.<verse eid="EZR 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 6:16" />Reve ama a Isra'ila, nan ganu na̱ nan Levi, na akapi a aza na a̱ ka̱mba̱i diga uba̱ta̱ tsugbashi, a yuwan a̱buki o ucasu wu U'wa wa̱ A̱sula̱ na̱ ma̱za̱nga̱. <verse eid="EZR 6:16" /><verse number="17" style="v" sid="EZR 6:17" />O ucasu wu U'wa wa̱ A̱sula̱'a̱ ama a ca ta̱ ogono e inan ukpaku (100) na̱ a̱giri'i ukpakure (200) na̱ mugiri'i ukpakuna̱shi (400). Waru a ca ta̱ nga̱ji kupa ne ejere adama a̱ kucci a̱ wuza̱'u wu unusu adama o ugundo wa̱ Isra'ila suru. <verse eid="EZR 6:17" /><verse number="18" style="v" sid="EZR 6:18" />Reve e ne'eshen nan ganu ba̱ta̱ ba̱ta̱, nan Levi waru ba̱ta̱ ba̱ta̱ adama a̱ a̱ga̱nda̱ a̱ A̱sula̱ a̱tsuma̱ a̱ Urishelima, cine a ɗanai a aatagada a Musa.<verse eid="EZR 6:18" /></para>
  <para style="s">A̱buki a Mapasa</para>
  <para style="p">
    <verse number="19" style="v" sid="EZR 6:19" />Reve ama a na a̱ ka̱mba̱i diga uba̱ta̱ u tsugbashi a yuwan A̱buki a Mapasa o urana wa kupa na̱ a̱za̱ a̱ na̱shi u woto wu ufaru.<note caller="+" style="f"><char style="fr" closed="false">6:19 </char><char style="ft" closed="false">Mta̱ 12:1-20. </char></note> <verse eid="EZR 6:19" /><verse number="20" style="v" sid="EZR 6:20" />Adama a na nan ganu na̱ nan Levi a̱ ka̱mbuwa̱ ta̱ ɗe aciyele na akiza suru nle a̱ ri idaba shi. Reve nan Levi a paɗa a̱a̱giri'i A̱buki a Mapasa adama a aza a na a̱ ka̱mba̱i diga uba̱ta̱ u tsugbashi suru, na adama a nan ganu a̱za̱ e le na adama a aciyele. <verse eid="EZR 6:20" /><verse number="21" style="v" sid="EZR 6:21" />Reve aza a Isra'ila a na a̱ ka̱mba̱i na aza a na a tawai aciyele e ili yi idaba ya atakpaci yi nron mu nden n le, adama a cuwa A̱sulazuva A̱sula̱ a Isra'ila a tama a̱a̱giri'i a̱ A̱buki a Mapasa'a. <verse eid="EZR 6:21" /><verse number="22" style="v" sid="EZR 6:22" />Reve a yuwan A̱buki o Opopofu a na a̱ ri na̱ Wolilo shi rana cindere a̱ ma̱za̱nga̱, adama a na A̱sulazuva o shiton le ta̱ na̱ ma̱za̱nga̱, waru u vadala ta̱ majiyan mo mogono ma Asuriya a̱ tyo ya̱'a̱ le, adama a na u kamba le ta̱ o ulinga wu U'wa wa̱ A̱sula̱, A̱sula̱ a Isra'ila.<verse eid="EZR 6:22" /></para>
  <chapter eid="EZR 6" />
  <chapter number="7" style="c" sid="EZR 7" />
  <para style="s">Ezura ta̱wa̱ ta̱ Urishelima</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 7:1" />Ana ili i ndolo i kotoi, a mantsa mo tsugono tsa Mogono Atazeze ma Pashiya, reve Ezura 'yon diga Babila. Waru Ezura reve ta̱ nu umatsun wa̱ yi a na a̱ yi ulobo wa Seraya limatan va Azariya ulobo wa Hilikiya, <verse eid="EZR 7:1" /><verse number="2" style="v" sid="EZR 7:2" />ulobo wa Shalum ulobo wa Zadok ulobo wa Ahitu, <verse eid="EZR 7:2" /><verse number="3" style="v" sid="EZR 7:3" />ulobo wa Amariya ulobo wa Azariya ulobo wa Merayo, <verse eid="EZR 7:3" /><verse number="4" style="v" sid="EZR 7:4" />ulobo wa Zerahiya ulobo wa Uzi ulobo wa Buki, <verse eid="EZR 7:4" /><verse number="5" style="v" sid="EZR 7:5" />ulobo wa Abishuwa ulobo wa Finiha ulobo wa Eliyaza, ulobo wa Haruna ganu gbain ɗa.<verse eid="EZR 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 7:6" />Ezura nda a̱yi ɗa u ta̱wa̱i diga Babila. A̱yi za vi iɗana i ɗa na ri nu urevu u wila̱ u na A̱sulazuva A̱sula̱ a Isra'ila a cayi Musa. Mogono ma ca yi ta̱ ili i na we ecei biti, adama a na ukere wa̱ A̱sulazuva A̱sula̱ a̱ yi a̱ shi ta̱ oɓolo na̱ a̱yi. <verse eid="EZR 7:6" /><verse number="7" style="v" sid="EZR 7:7" />A̱tsuma̱ aa'wan e cindere o tsugono tsa Mogono Atazeze ɗa Ezura uta̱i diga e iɗa ya Babila a̱ tyo Urishelima oɓolo na ama a Isra'ila o ro, oɓolo na̱ nan ganu na̱ nan Levi na ashipi na̱ a̱za̱ e ipiri yi na̱ntsu na aza a na a yuwusan ulinga o U'wa wa̱ A̱sulazuva.<verse eid="EZR 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 7:8" />Ezura rawa ta̱ Urishelima o woto wa tawun a aa'wan e cindere o tsugono tso mogono Atazeze. <verse eid="EZR 7:8" /><verse number="9" style="v" sid="EZR 7:9" />U fara ta̱ mmalu a̱ tyo Babila o woto wu ufaru, reve o urana wu ufaru u woto wa tawun u rawa Urishelima, adama a na ukere wi isa'ani wa̱ A̱sula̱ a̱ yi a̱ shi ta̱ oɓolo na̱ a̱yi. <verse eid="EZR 7:9" /><verse number="10" style="v" sid="EZR 7:10" />Adama a na Ezura ca ta̱ aciya̱yi u reve wila̱ wa̱ A̱sulazuva, u kuru yi, waru u rito ama a Isra'ila wila̱ nu udammu wa̱ yi.<verse eid="EZR 7:10" /></para>
  <para style="s">Mepepelime ma na Mogono Atazeze ma cayi Ezura</para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 7:11" />A̱yi nda a̱ yi ɗa mepepelime mo ucawusu wu una̱ u na Atazeze Mogono ma cayi Ezura ganu waru za vi iɗana. Za na ri nu urevu u wila̱ nu udammu wa̱ A̱sulazuva e ekere ama a Isra'ila.<verse eid="EZR 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 7:12" />U damma, &lt;&lt;Diga Atazeze mogono mo ngono, a̱ tyo ya Ezura ganu, za vi iɗana i wila̱ wa̱ A̱sula̱ a zuva. Vu da̱na̱ na asuvu nde. <verse eid="EZR 7:12" /><verse number="13" style="v" sid="EZR 7:13" />N ca ta̱ udammu a na vuma va Isra'ila suru ko nan ganu ko nan Levi za na a̱ ri a̱tsuma̱ o upasu u tsugono tsa̱ va̱, za na suru cigai u ka̱mba̱ Urishelima oɓolo na̱ a̱vu, u ta gura ka̱ra̱. <verse eid="EZR 7:13" /><verse number="14" style="v" sid="EZR 7:14" />Adama a na mogono na ama e cindere aza a na aa casu yi a̱sa̱la̱ ɗa a̱ lyungu nuwu, vu 'ya̱wa̱ vu reve cu'un vu nden n na aza a Yahuda na aza a Urishelima a yuwusan o una̱ wu Uritosu wa̱ A̱sula̱ a̱ wu za na ri o ukere wa̱ wu. <verse eid="EZR 7:14" /><verse number="15" style="v" sid="EZR 7:15" />Waru vu tara zinariya na̱ azurufa aza a na mogono na aza a na aa casu yi a̱sa̱la̱ a cayi nu ucigu wo okolo e le e ekere A̱sula̱ a Isra'ila za na nda̱na̱ta̱ ma̱ yi n ri Urishelima. <verse eid="EZR 7:15" /><verse number="16" style="v" sid="EZR 7:16" />Waru vu tara azurufa na̱ zinariya suru na vu ɓolotoi diga a pasu va̱ Babila, oɓolo nu ucasu wu ucigu wo okolo a na ama a Isra'ila na̱ nan ganu a cayi adama o U'wa wa̱ A̱sula̱ e le za na ri Urishelima. <verse eid="EZR 7:16" /><verse number="17" style="v" sid="EZR 7:17" />Vu yuwan ulinga ni ikebe i nda adama vu tsula ogono e inan na̱ a̱giri'i na̱ mugiri'i, oɓolo nu ucasu wi ishina i le nu ucasu wi ili yo oso i le na wuntsa a̱ yi, adama vu ca le zuva masa'a vu U'wa wa̱ A̱sula̱ a na a̱ ri Urishelima. <verse eid="EZR 7:17" /><verse number="18" style="v" sid="EZR 7:18" />A̱vu suru akapi a azurufa na̱ zinariya na buwai, reve a̱vu na̱ a̱za̱ a̱ wu i yuwan ili i na i lobono n ɗu ununa A̱sula̱ a̱ ɗu a cigai. <verse eid="EZR 7:18" /><verse number="19" style="v" sid="EZR 7:19" />Itana i na a ca nuwu adama a̱ga̱nda̱ o U'wa wa̱ A̱sula̱ a̱ wu, vu 'ya̱wa̱ ne ele uba̱ta̱ wa̱ A̱sula̱ a̱tsuma̱ a̱ Urishelima. <verse eid="EZR 7:19" /><verse number="20" style="v" sid="EZR 7:20" />Waru suru ili i na vu cigai adama o ulinga wu U'wa wa̱ A̱sula̱ a̱ wu, za na waru wo o'woi ume wa̱ wu u ɗa vu ca, vu uta̱a̱ diga e izuwa i mogono.<verse eid="EZR 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 7:21" />&lt;&lt;Waru a̱mu Mogono Atazeze, n ca ta̱ udammu e ekere e izuwa suru yu pasu u Mavada mo Uɗolu wa̱ Yufireti a na, ili i na suru Ezura za vi iɗana wu Uritosu wa̱ A̱sula̱ a zuva, a ciga biti diga o ukere u ɗu, i ca yi no okolo a̱ ta̱. <verse eid="EZR 7:21" /><verse number="22" style="v" sid="EZR 7:22" />I ca yi makundatsu mo ume u azurufa ukpakukupa uta'atsu nu ukpakuna̱shi (3,400) ni ibufu i yitabo ukpaku (100) na̱ nden n masayan ma̱ ina̱bi ukpakukupa ure (2,000) na̱ nden n mani'in ma̱ zetun ukpakukupa ure (2,000) na akpaɗi a̱bunda̱ a na aa ciga. <verse eid="EZR 7:22" /><verse number="23" style="v" sid="EZR 7:23" />Ili i na suru A̱sula̱ a zuva a dammai adama o U'wa wa̱ a̱yi, a̱vu a yuwain no okolo ta̱, adama she o rono upan wa̱ a̱ yi a aci o tsugono tso mogono oɓolo na̱ muwun ma̱ a̱ yi wan. <verse eid="EZR 7:23" /><verse number="24" style="v" sid="EZR 7:24" />Waru tsu ta dansaa ɗu she i ushi ikebe yu utafa ko ikebe i ma'uwaa na̱ mota̱a̱ ko ikebe yu ure ekere a nan ganu na̱ nan Levi na̱ a̱za̱ e ishipa na̱ a̱za̱ e ipiri yu na̱ntsu oɓolo na akapi ozo ulinga o U'wa wa̱ A̱sula̱ a nda wan.<verse eid="EZR 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZR 7:25" />&lt;&lt;Waru a̱vu Ezura, o una̱ wu urevu u na A̱sula̱ a ca nuwu, vu zuwa ozo o uge'etosu na azagbain o ukobu adama a na o rito wa ama a na a̱ ri Mavada mo Uɗolu wa̱ Yufireti, aza a na suru e revei wila̱ wa̱ A̱sula̱ a̱ wu. Waru vu rito aza a na e revei wila̱'a̱ shi. <verse eid="EZR 7:25" /><verse number="26" style="v" sid="EZR 7:26" />Suru za na 'yuwain a yuwan tsutoni na̱ wila̱ wa̱ A̱sula̱ a̱ wu, ko udammu u mogono, ili yi lo shi a ta paɗaa yi ugana, ko vu ukwisa̱, ko ma̱gba̱ra̱, ko ma'usa me itana ya̱ yi, ko u mazuwa o u'wa wa ali.&gt;&gt;<verse eid="EZR 7:26" /></para>
  <para style="s">Ezura cuwa ta̱ A̱sula̱</para>
  <para style="p">
    <verse number="27" style="v" sid="EZR 7:27" />Reve Ezura damma, &lt;&lt;Ica za va̱ A̱sulazuva a ɗa, A̱sula̱ a nkaya n tsu! A̱yi ɗa za na zuwai cu'un majiyan ma nda okolo o mogono adama a na wa ca U'wa wa̱ A̱sulazuva tsugbain a na a̱ ri Urishelima waru a̱ da̱shi suwisa yi. <verse eid="EZR 7:27" /><verse number="28" style="v" sid="EZR 7:28" />Waru a̱tsuma̱ e isa'ani ya̱ yi n tsura̱ ta̱ icigi uba̱ta̱ u mogono, na aza a na a casu yi a̱sa̱la̱ waru ne e ekere a azagbain o ucira u mogono. N kaɓa ta̱ asuvu, adama a na ukere wa̱ A̱sulazuva A̱sula̱ a̱ va̱ a̱ shi ta̱ oɓolo na̱ a̱mu. Hali na n gura ɓolotoi azagbain a Isra'ila adama a na a̱ ka̱mba̱ oɓolo na̱ a̱mu.&gt;&gt;<verse eid="EZR 7:28" /></para>
  <chapter eid="EZR 7" />
  <chapter number="8" style="c" sid="EZR 8" />
  <para style="s">Ama a na a̱ ka̱mba̱i diga uba̱ta̱ u tsugbashi oɓolo na̱ Ezura</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 8:1" />Apa ala a limatan vu 'wa nu ugeru wa ala aza a na a̱ ka̱mba̱i diga e iɗa i tsugbashi a Babila oɓolo na̱ Ezura a̱ tyo Urishelima a mantsa mo tsugono tsa Atazeze Mogono.<verse eid="EZR 8:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="EZR 8:2" />Diga a Limatan va Finiha, Gashon ɗa da̱na̱i zagbain.</para>
  <para style="li1" vid="EZR 8:2">Limatan va Itama, Daniya ɗa da̱na̱i zagbain.<verse eid="EZR 8:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="EZR 8:3" />Limatan va̱ Da̱wuda, Hatush ulobo wa Shekaniya ɗa da̱na̱i zagbain.</para>
  <para style="li1" vid="EZR 8:3">Limatan va Parosh, Zakariya ɗa zagbain. U ka̱mba̱ ta̱ na ali ukpaku na̱ kupoton (150) diga a limatan va̱ yi. A̱tsura̱ ta̱ ala e le a̱tsuma̱ alabari a nkaya n le.<verse eid="EZR 8:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="EZR 8:4" />Limatan va Paha Mowa, Eliyehona ulobo wa Zerahiya ɗa zagbain. U ka̱mba̱ ta̱ na ali ukpakure (200).<verse eid="EZR 8:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="EZR 8:5" />Limatan va Zatu, Shekaniya ulobo wa Yahaziyel ɗa da̱na̱i zagbain. U ka̱mba̱ ta̱ na ali ukpakuta'atsu (300).<verse eid="EZR 8:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="EZR 8:6" />Limatan va Adin, Ebe ulobo wa Jonata ɗa da̱na̱i zagbain. U ka̱mba̱ ta̱ na ali kupoton.<verse eid="EZR 8:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="EZR 8:7" />Limatan va Elam, Yeshaya ulobo wa Ataliya ɗa da̱na̱i zagbain. U ka̱mba̱ ta̱ na ali kupocindere.<verse eid="EZR 8:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="EZR 8:8" />Limatan va Shefatiya, Zebadiya ulobo wa Mika'ilu ɗa da̱na̱i zagbain. U ka̱mba̱ ta̱ na ali kupakunla̱.<verse eid="EZR 8:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="EZR 8:9" />Limatan va Yowab, Obadiya ulobo wa Jehiye ɗa da̱na̱i zagbain. U ka̱mba̱ ta̱ na ali ukpakure na̱ kupa na̱ kunla̱ (218).<verse eid="EZR 8:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="EZR 8:10" />Limatan va Bani, Shelomi ulobo wa Josifiya ɗa da̱na̱i zagbain. U ka̱mba̱ ta̱ na ali ukpaku na̱ kupota̱li (160).<verse eid="EZR 8:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="EZR 8:11" />Limatan va Bebai, Zakariya ulobo wa Bebai ɗa da̱na̱i zagbain. U ka̱mba̱ ta̱ na ali ushin na̱ kunla̱.<verse eid="EZR 8:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="EZR 8:12" />Limatan va Aziga, Johanan ulobo wa Hakatan ɗa da̱na̱i zagbain. U ka̱mba̱ ta̱ na ali ukpaku na̱ kupa (110).<verse eid="EZR 8:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="EZR 8:13" />Limatan va Adonikam, aza a na a̱ ta̱wa̱i na̱ a̱ca̱pa̱, e le a ɗa Elifele na̱ Yeyiyel na̱ Shemaya ele ɗa a̱ da̱na̱i azagbain. A̱ ka̱mba̱ ta̱ na ali kupota̱li.<verse eid="EZR 8:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="EZR 8:14" />Limatan va Bigivai, Utai na̱ Zaku ɗa a̱ da̱na̱i azagbain. A̱ ka̱mba̱ ta̱ na ali kupocindere.<verse eid="EZR 8:14" /></para>
  <para style="s">Mmalu ma Ezura a̱ ka̱mba̱ Urishelima</para>
  <para style="p">
    <verse number="15" style="v" sid="EZR 8:15" />M ɓoloto ta̱ ama a nda suru o uɗolu u na wee yeneshe a̱ cipa̱ a̱ tyo a̱ lyuci va Ahava, lo ɗa tsu da̱nuyi hali rana ta'atsu. Reve n petelyuwe ama'a na̱ nan ganu, agba n tsura̱ nan Levi a̱tsuma̱ e le shi. <verse eid="EZR 8:15" /><verse number="16" style="v" sid="EZR 8:16" />Reve n zuwa e ɗewe a̱mu Eliyeza na̱ Ariye na̱ Shemaya na̱ Elinatan na̱ Jari na̱ Elinatan na̱ Natan na̱ Zakariya na̱ Meshulam azagbain. A̱vu n zuwa e ɗewe a̱mu Joyari na̱ Elinatan, adama a na e le a̱za̱ o urevu u ɗa. <verse eid="EZR 8:16" /><verse number="17" style="v" sid="EZR 8:17" />Waru n lyungu le ta̱ ya̱ Ido zagbain a̱tsuma̱ a Kasifiya. A̱vu n damma le ili i na aa damma Ido na̱ a̱za̱ a̱ yi na aza a na a yuwusan ulinga o U'wa wa̱ A̱sulazuva aza a na a̱ ri na̱ nden a̱tsuma̱ a Kasifiya, adama a̱ lyunguwa̱ tsu na̱ ozo o ulinga o U'wa wa̱ A̱sula̱ a̱ tsu a̱tsuma̱ a̱ Urishelima. <verse eid="EZR 8:17" /><verse number="18" style="v" sid="EZR 8:18" />Ana wo o'woi ukere wi isa'ani ya̱ A̱sula̱ a̱ tsu a̱ ta̱ oɓolo na̱ a̱tsu, a̱vu a̱ lyunguwa̱ tsu na̱ Sherebiya vuma vu urevu, diga a limatan va Mali ulobo wa̱ Levi ulobo wa Isra'ila. U ta̱wa̱ ta̱ oɓolo no olobo a̱ yi na̱ a̱za̱ a̱ yi ama kupa na̱ kunla̱. <verse eid="EZR 8:18" /><verse number="19" style="v" sid="EZR 8:19" />Reve a̱ lyunguwisa̱ a̱tsu na̱ Hashabiya oɓolo na̱ Yeshaya diga a limatan va Merari oɓolo na̱ a̱za̱ a̱ yi no olobo e le. Ele ɗa a̱ da̱na̱i ali ushin. <verse eid="EZR 8:19" /><verse number="20" style="v" sid="EZR 8:20" />Na̱ ne suru, a̱ lyungu wa̱ a̱tsu ta̱ na ama ukpakure nu ushin (220) aza a na a yuwusan ulinga o U'wa wa̱ A̱sulazuva, aza a na Mogono Da̱wuda na azagbain a tawai adama a kamba nan Levi. E kece le ta̱ o una̱ wa ala e le suru.<verse eid="EZR 8:20" /></para>
  <para style="s">Akuli na avasa adama a mapari</para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 8:21" />Lo a̱ nge'en mu uɗolu ma Ahava, n lapa ta̱ ulingi adama a tara akuli, adama tsu ka̱ɗa̱to aciya̱tsu a̱ ma̱ka̱ka̱n ma̱ A̱sula̱ a̱ tsu, waru a mmalu n tsu u yuwaan tsu mapari, na̱ a̱tsu na̱ muwun n tsu, oɓolo ni itana i tsu. <verse eid="EZR 8:21" /><verse number="22" style="v" sid="EZR 8:22" />Adama a na mu uwwa ta̱ wono u na ma pati mogono u ca tsu a̱soja ana na akumbi e ido, adama a na ee geshe tsu e ekere a n'yuwatan a̱tsuma̱ o ure. Adama a na n damma ta̱ ɗe mogono, &lt;&lt;Ukere wi isa'ani wa̱ A̱sula̱ a̱ tsu u to oɓolo na̱ za na suru zuwai ucira wa̱ yi ya̱ a̱ yi, amma usuɗuwu wu upan wa̱ yi u ta a aci a za na suru vadalaa niyi ucina̱.&gt;&gt; <verse eid="EZR 8:22" /><verse number="23" style="v" sid="EZR 8:23" />Adama o ndolo a ɗa tsu yuwain akuli, a̱vu tsu pati A̱sula̱ a̱ tsu adama u yuwan tsu mapari. Waru usu ta̱ avasa a̱ tsu.<verse eid="EZR 8:23" /></para>
  <para style="s">Ne'e adama A̱a̱'isa̱mapaɗa</para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 8:24" />A̱vu n tawa ama kupa ne ejere diga a̱tsuma̱ azagbain a nan ganu, Sherebiya na̱ Hashabiya oɓolo na̱ a̱za̱ e le ama kupa. <verse eid="EZR 8:24" /><verse number="25" style="v" sid="EZR 8:25" />Reve n kunzuwa̱ le azurufa na̱ zinariya ni itana i na mogono na aza a na aa casu yi a̱sa̱la̱ na azagbain a̱ yi na aza a Isra'ila a na a̱ ri lo a cayi adama o u'wa wa̱ A̱sula̱ a̱ tsu.<verse eid="EZR 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EZR 8:26" />Apa ili i na n kunzu yi n ca yi nan ganu o ukere.</para>
  <para style="b" vid="EZR 8:26" />
  <para style="li1" vid="EZR 8:26">Makundatsu ma azurufa ma na ma rawai ume ushin ne ejere.</para>
  <para style="li1" vid="EZR 8:26">Ni itana i azurufa ukpaku (100) aza a na ukunzuwu wu ume u le u rawai kupocindere.</para>
  <para style="li1" vid="EZR 8:26">Nu ukunzuwu wu ume u zinariya u na u rawai ukpakukupa uta'atsu nu ukpakuna̱shi (3,400).<verse eid="EZR 8:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="EZR 8:27" />Akwanu a zinariya ushin aza a na ukunzuwu wu ume u le u rawai ukpakukupa (1,000).<note caller="+" style="f"><char style="fr" closed="false">8:27 </char><char style="ft" closed="false">Ume wi Ikebe'e u ta̱ reme rumu ta̱ a̱tsuma̱ a̱za̱ a̱ na̱shi (1/4) ko irumu kunla̱ na akapi (8.5).</char></note></para>
  <para style="li1" vid="EZR 8:27">Na akwanu e re a̱ rumushili, ulobonu u le una̱ta̱ u ɗa a̱ ri na̱ aza a zinariya.<verse eid="EZR 8:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="EZR 8:28" />A̱vu n damma le, &lt;&lt;A̱ɗu ni itana i nda a tawa ɗu ta̱ yo o'wo na akiza e ekere a̱ A̱sulazuva. Waru Azurufa na̱ zinariya'a ucasu wu ucigu wo okolo ɗa uba̱ta̱ wa̱ A̱sulazuva A̱sula̱ a nkaya n ɗu. <verse eid="EZR 8:28" /><verse number="29" style="v" sid="EZR 8:29" />I Yuwan ipiri i le waru yi idana le, hali she ni i 'ya̱wa̱ i rito le a asula o U'wa wa̱ A̱sulazuva a na a̱ ri Urishelima a̱ ma̱ka̱ka̱n ma nan ganu a gbagbain na̱ nan Levi na azagbain a 'wa va Isra'ila suru.&gt;&gt; <verse eid="EZR 8:29" /><verse number="30" style="v" sid="EZR 8:30" />Reve nan ganu na̱ nan Levi a̱ ushi azurufa na̱ zinariya ni itana i na a̱ kunzuyi ume u le, adama a̱ 'ya̱wa̱ ne ele o U'wa wa̱ A̱sula̱ a̱ tsu a̱ Urishelima.<verse eid="EZR 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EZR 8:31" />Reve tsu 'yon diga e ikyun yu uɗolu wa Ahava o urana wa kupa ne ejere u woto wu ufaru, adama tsu ka̱ra̱ a̱ tyo Urishelima. Ukere wa̱ A̱sula̱ a̱ tsu a̱ shi ta̱ oɓolo na̱ a̱tsu, reve u wawa tsu e ekere a n'yuwatan ne e ekere a̱ a̱za̱ a̱ nga̱la̱la̱i a̱tsuma̱ o ure. <verse eid="EZR 8:31" /><verse number="32" style="v" sid="EZR 8:32" />Ne ɗa tsu rawai Urishelima, reve tsi ivuwan pe rana ta'atsu.<verse eid="EZR 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EZR 8:33" />O urana wa̱ na̱shi a̱vu tsu ka̱ra̱ a̱ tyo o U'wa wa̱ A̱sula̱ a̱tsu, lo ɗa tsu ritoyi ume u azurufa na̱ zinariya ni itana, reve tsu zuwa le e ekere a Meremo ulobo wa Uriya ganu. Oɓolo na̱ a̱ yi a̱ da̱na̱ ta̱ na̱ Eliyaza ulobo wa Finiha, na̱ nan Levi o ro Jozaba ulobo wa Jesuwa na̱ Nowadiya ulobo wa Binuyi. <verse eid="EZR 8:33" /><verse number="34" style="v" sid="EZR 8:34" />A̱vu e kece ili'i biti reve a̱ rito ume u le, reve a ɗana a̱bunda̱ o ume u le.<verse eid="EZR 8:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EZR 8:35" />Aza a na a̱ ka̱mba̱i diga e iɗa i tsugbashi suru a ca ta̱ kucci vu ukula̱tosu u le uba̱ta̱ wa̱ A̱sula̱ a Isra'ila. Reve a ca kucci vo ogono e inan kupa ne ejere adama a aza a Isra'ila suru na̱ a̱giri'i kupakucci na̱ a̱za̱ a̱ ta̱li na̱ mugiri'i kupocindere na̱ a̱za̱ e cindere. Reve waru a ca kucci matara mo ume mo unusu na̱ nga̱ji kupa ne ejere. Reve a ca kucci vu ukula̱tosu u nda suru a̱ tyo e ekere a̱ A̱sulazuva. <verse eid="EZR 8:35" /><verse number="36" style="v" sid="EZR 8:36" />Reve a ca mepepelime ma nda wu udammu u Mogono Atazeze uba̱ta̱ wa azagbain e iɗa na̱ nan gwamna vu upasu u Mavada mo Uɗolu wa̱ Yufireti. Reve a ca ikambishi i le ekere ama'a oɓolo nu U'wa wa̱ A̱sula̱.<verse eid="EZR 8:36" /></para>
  <chapter eid="EZR 8" />
  <chapter number="9" style="c" sid="EZR 9" />
  <para style="s">Aɗa e i lolo adama aza a Yahuda na atakpaci</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 9:1" />Ana a yuwain ili i ndolo o kotoi, reve azagbain a Isra'ila o ro a̱ ta̱wa̱ uba̱ta̱ u va̱ a damma mu cu'un wuma u na ama a Isra'ila na̱ nan ganu na̱ na̱ nan Levi a yuwusan. Reve waru a damma mu cine aza a Isra'ila a̱ kuɗa̱i a kasa na atakpaci, aza a wuma wi idaba, ele ɗa aza a Ka'ana na aza a Hitiya na aza a Periziya na aza a Jebusiya na aza a Amon na̱ a̱za̱ a̱ Mowa na aza a Masar na aza a Amoriya. <verse eid="EZR 9:1" /><verse number="2" style="v" sid="EZR 9:2" />Adama a na ali a Isra'ila a taraa ta̱ aciyele atakpaci a̱ a̱ma̱ci, hali fo a taraa olobo e le esheli diga a̱tsuma̱ e le. Ne ɗa a̱ ja̱mba̱ra̱i ugundo wa akiza na atakpaci'i. Waru azagbain na̱ mbara a̱ zungu ta̱ aciyele a mayan me ili i wono i nda.<verse eid="EZR 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 9:3" />A mantsa ma na mu uwwai a ɗa a nda reve mu kara a̱tugu a̱ va̱, a̱vu mumula̱ a̱nji a aaci a̱ va̱ na̱ ntsuka̱ n va̱, a̱vu n da̱nu n lamba ili i na ma damma. <verse eid="EZR 9:3" /><verse number="4" style="v" sid="EZR 9:4" />Ɗaɗa aza a na e je'ein lipu adama e idanshi ya̱ A̱sula̱ a Isra'ila adama o ulambu wa̱ a̱ɓula̱ wa aza a na a̱ ka̱mba̱i diga e iɗa i tsugbashi, a̱vu o ɓoloto u ka̱nda̱ruwu na̱ a̱mu a mantsa ma na n da̱na̱i n nden ulukutu, hali she a mantsa ma̱ kucci vu ulivu.<verse eid="EZR 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 9:5" />A mantsa ma na kucci vu ulivu yuwain, reve n yon a̱tsuma̱ a̱tsuma̱la̱ngu a na n ri wotowu na̱ a̱tugu a na mu karai. Reve n kingyo n 'ya̱sa̱n ekere a̱ va̱ a̱ tyo ya̱ A̱sulazuva A̱sula̱ a̱ va̱.<verse eid="EZR 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 9:6" />Reve n damma, &lt;&lt;A̱sula̱ a̱ va̱, wono u ɓa̱ru mu ta̱ hali n gura gaɗuwa urewesu u va̱ elime a̱ wu shi. Adama a na unusu u tsu u la'a ta̱ ucira u tsu waru u yuwan ta̱ uga'an hali u rawa zuva. <verse eid="EZR 9:6" /><verse number="7" style="v" sid="EZR 9:7" />Diga a mantsa ma nkaya n tsu hali acina ana'an, tsu yuwan ta̱ unusu u gbain. Adama a̱ nusu tsu a̱tsu na̱ ngono n tsu na̱ nan ganu a̱ tsu, ɗaɗa tsu uwai e ekere o ngono mu nɗa'a. Reve o una tsu na̱ matsun me pe'eni, a̱vu a̱ pura̱ a̱tsu a̱ tyo e iɗa i tsugbashi, a̱vu fo a̱ pura̱ itana i tsu, reve oto tsu a̱tsuma̱ o wono cine tsu ri ana'an. <verse eid="EZR 9:7" /><verse number="8" style="v" sid="EZR 9:8" />Gogo gba a mantsa wa'a, A̱sulazuva A̱sula̱ a̱ tsu o roco tsu ta̱ isa'ani a na u lyawaa ntsu akapi a ama wuma, waru a na u ca ntsu nda̱na̱ta̱ n sa'ani uba̱ta̱ wu nden wu za va akiza, adama u ta̱wa̱a̱ tsu na̱ wivuwun wa'a a̱tsuma̱ a tsugbashi tsa̱ a̱tsu waru u zuwa urewesu u tsu u yuwan ma̱za̱nga̱. <verse eid="EZR 9:8" /><verse number="9" style="v" sid="EZR 9:9" />Ko a na tsu ri agbashi, A̱sula̱ a̱ tsu a vari tsu a̱tsuma̱ a̱ tsugbashi tsa̱ tsu shi. Amma u zuwa ta̱ ngono ma Pashiya o roco tsu isa'ani waru a yuwan tsu ili i na tsu cigai biti adama a na tsa suwisa U'wa wa̱ A̱sula̱, waru tsu leɓenu ba̱ta̱ na o ocoi adama tsu tsura̱ ukari u na wa yuwan tsu mapari a̱tsuma̱ a Yahuda na̱ Urishelima.<verse eid="EZR 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 9:10" />&lt;&lt;To, gogo A̱sulazuva a̱ tsu, nye ɗa tsaa damma adama e ili i nda? Adama a na tsu 'yuwan ta̱ a̱ kuru wila̱ wa̱ wu, <verse eid="EZR 9:10" /><verse number="11" style="v" sid="EZR 9:11" />za na vu ca ntsu e ekere a agbashi a̱ wu ama̱sula̱ a na vu damma ntsu, &lt;Iɗa i na yaa zama i usa adama wo o'wo agadu a̱ ɗu, iɗa i ɗa yi idaba. Elentsu e iɗa'a o shiton ta̱ uba̱ta̱ suru na̱ linga n le vi idaba na̱ tsugya. <verse eid="EZR 9:11" /><verse number="12" style="v" sid="EZR 9:12" />Adama o ndolo she tsu lyawa esheli a̱ tsu o olo ali e iɗa'a wan ko olobo a̱ tsu a zuwa esheli e le wan. Waru she tsu kamba le ko tsu zami nden lafiya na̱ e le wan. Ne ɗa tsa yuwan ucira waru tsu uwwa uyo'o wi iɗa'a, waru tsu lyawaa muwun ntsu iɗa'a yo o'o agadu e le hali hali.&gt;<note caller="+" style="f"><char style="fr" closed="false">9:12 </char><char style="ft" closed="false">Mta̱ 34:11-16; U. Wl 7:1-5.</char></note> <verse eid="EZR 9:12" /><verse number="13" style="v" sid="EZR 9:13" />Ana ili i ndolo suru i cina ntsu adama a linga tsu vi iwuya na̱ nusu va̱ a̱bunda̱ ɗa, waru tsu gura ta̱ reve suru na̱ ne a̱vu A̱sula̱ a̱ tsu a ɗa, vu ca tsu oforo o usuɗuwu o una̱ wu unusu shi, hali na vu lyawaa ntsu akapi ama wuma tsunda. <verse eid="EZR 9:13" /><verse number="14" style="v" sid="EZR 9:14" />To, gogo cine tsa̱ da̱shi kuɗa wila̱ wa̱ wu a na tsa zuwulai a̱ma̱ci na ama a nda aza a na a yuwusan cu'un vi ili yi idaba i nda? N na̱ tsu yuwan ne, vu ta yuwan upan na̱ a̱tsu hali vu kototo tsu suru suru, babu aza a na a buwa waru babu aza a na a la'a. <verse eid="EZR 9:14" /><verse number="15" style="v" sid="EZR 9:15" />A̱sulazuva A̱sula̱ a Isra'ila, a̱vu za va̱ a̱ɓula̱ a ɗa! Adama a na vu lyawaa tsu ta̱ ozo o ro a na a la'ai cine u ri ana'an. A̱tsu ɗa nda a̱ ma̱ka̱ka̱n ma̱ wu na̱ nusu tsu, adama a na ko vuma ta̱ a̱tsuma̱ a̱ tsu aa gura isawan a̱ ma̱ka̱ka̱n ma̱ wu adama e ili i nda shi.&gt;&gt;<verse eid="EZR 9:15" /></para>
  <chapter eid="EZR 9" />
  <chapter number="10" style="c" sid="EZR 10" />
  <para style="s">Ama a damma ta̱ nusu le</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 10:1" />A mantsa ma na Ezura da̱na̱i a yuwusan avasa u kingyo wu elime o U'wa wa̱ A̱sula̱ a dansa nusu le waru e mesun, a̱vu iɓolo i gbain ya ama a Isra'ila, ali na̱ a̱ma̱ci na̱ muwun a̱ ka̱nda̱ruwa̱i, a̱vu ele fo a̱ shon lon. <verse eid="EZR 10:1" /><verse number="2" style="v" sid="EZR 10:2" />A̱vu Shekaniya ulobo wa Jehiye limatan va Elam, damma Ezura, &lt;&lt;Tsu yuwaan ta̱ A̱sula̱ a̱ tsu ulambu wa̱ a̱ɓula̱ na tsu zuwai atakpaci a̱ a̱ma̱ci e iɗa'a, amma suru na̱ ne Isra'ila buwa ta̱ nu uzuwu wo okolo. <verse eid="EZR 10:2" /><verse number="3" style="v" sid="EZR 10:3" />Gogo lyawa tsu yuwain nzuwulai na̱ A̱sula̱ a̱ tsu, tsu gba̱ra̱i a̱ma̱ci a nda na̱ muwun n le o una̱ wa̱ a̱sa̱la̱ a na a̱vu na akapi azagbain a na a casu wila̱ wa̱ A̱sula̱ tsugbain a ca n tsu. Waru tsu yuwan ili i na uritosu wa̱ A̱sula̱ a dammai. <verse eid="EZR 10:3" /><verse number="4" style="v" sid="EZR 10:4" />'Yon, adama a na addama a nda a̱ ta̱ e ekere a̱ wu. A̱tsu waru tsu ta̱ o ucina̱ wa̱ wu. Gogo vu kaɓa asuvu vu yuwan ne.&gt;&gt;<verse eid="EZR 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 10:5" />Ɗaɗa Ezura 'yoyin a̱vu u zuwa azagbain a nan ganu na̱ nan Levi oɓolo na aza a Isra'ila suru a tara akucunu a na a ta yuwan ili i na Shekaniya dammai. Reve gba a tara akucunu'u. <verse eid="EZR 10:5" /><verse number="6" style="v" sid="EZR 10:6" />Reve Ezura 'yon u lyawa uba̱ta̱ u na u shi elime U'wa wa̱ A̱sula̱'a̱, a̱vu u ka̱ra̱ a̱ tyo a aasula a Jehohana ulobo wa Eliyashi, agba u lyuwa ɗe ilyalya ko u sowo mini shi, adama a na u shi a̱tsumola̱ngu o ulambu wa̱ a̱ɓula̱ wa aza a na a̱ ka̱mba̱i diga e iɗa i tsugbashi.<verse eid="EZR 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 10:7" />Reve a lapa ulingi uba̱ta̱ suru a̱tsuma̱ a̱ Urishelima na̱ Yahuda a na aza a na a̱ ka̱mba̱i diga e iɗa i tsugbashi o ɓoloto Urishelima. <verse eid="EZR 10:7" /><verse number="8" style="v" sid="EZR 10:8" />Waru za na suru ta̱wa̱i a̱tsuma̱ a rana ta'atsu o udammu wu mbara na azagbain shi, o una̱ wi itana ya̱ yi, waru a ta takatsuwai diga a̱tsuma̱ e iɓolo ya ama a na a̱ ka̱mba̱i diga e iɗa i tsugbashi.<verse eid="EZR 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZR 10:9" />Reve gba ali o upasu wa Yahuza na Banyami o ɓoloto a̱tsuma̱ a̱ Urishelima a rana ta'atsu'u. O urana wu ushin o woto wa̱ kucci, reve ama suru a̱ da̱nu a alanga e eteshe a na a̱ ri U'wa wa̱ A̱sula̱. A̱da̱na̱ ta̱ e meje'en ma̱ lipu adama a ɗa a nda waru a yuwusan ta̱ iro'i yu ucira.<verse eid="EZR 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 10:10" />Reve Ezura ganu 'yon u yuwan adanshi ne e le, u damma, &lt;&lt;I yuwan ta̱ ulambu wa̱ a̱ɓula̱ a na i zuwai atakpaci a̱ a̱ma̱ci. Ne ɗa i da̱shi yi unusu wa aza a Isra'ila. <verse eid="EZR 10:10" /><verse number="11" style="v" sid="EZR 10:11" />Gogo she i damma A̱sulazuva, A̱sula̱ a nkaya n ɗu nusu ɗu. A̱vu i yuwan ili i na u cigai. Yi kasa aciya̱ɗu na ama e iɗa'a na atakpaci a̱ a̱ma̱ci.&gt;&gt;<verse eid="EZR 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 10:12" />Ɗaɗa oɓolo ama'a suru a̱ usuyi nu uɗyo zuva, &lt;&lt;Ne ɗa u ri, na̱ tsu ciga tsu 'yuwan tsu yuwan cine vu dammai. <verse eid="EZR 10:12" /><verse number="13" style="v" sid="EZR 10:13" />Amma ama a̱ ta̱ a̱bunda̱ waru mantsa me iro'i mo ucira ma ɗa, adama o ndolo tsaa gura isawan a alanga e eteshe shi. Waru ulinga u nda za vu uranu u ta̱ ko vu rana re ɗa shi, adama a na na̱ a̱bunda̱ a̱tsuma̱ a̱ tsu a yuwan ta̱ unusu lon a̱tsuma̱ a adanshi a nda. <verse eid="EZR 10:13" /><verse number="14" style="v" sid="EZR 10:14" />Lyawa azagbain a̱ tsu e isawan a̱tsuma̱ a̱ Urishelima a na e petelyuwe adanshi a nda o una̱ u tsu. Lyawa vuma suru a̱tsuma̱ e ilyuci i tsu i na a zuwai takpaci vu ka u ta̱wa̱ a mantsa ma na a zuwai, oɓolo na̱ mbara na̱ a̱za̱ o uge'etosu u lyuci suru. Tsu ta yuwan ne adama A̱sula̱ a̱ tsu a̱ fa̱la̱ diga a̱tsuma̱ o upan wu usuɗuwu wa̱ yi adama a ɗa a nda.&gt;&gt; <verse eid="EZR 10:14" /><verse number="15" style="v" sid="EZR 10:15" />Babu za na 'ya̱sa̱in a aci adama e ifoɓi i nda, she Jonata ulobo wa Asahe na̱ Jazeya ulobo wa Tikiva. Reve Meshulam na̱ Shabeta limatan va̱ Levi o wo'o le ucina̱.<verse eid="EZR 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 10:16" />Reve aza a na a̱ ka̱mba̱i diga e iɗa i tsugbashi a yuwan ili i na a dammai. Reve Ezura ganu ɗangula ali aza a na e le ɗa azagbain a 'wa le, o una̱ u limatan le, za suru na ala a̱ yi. A̱vu a ga'an o urana wu ufaru u woto wa kupa adama e petelyuwe adanshi'i. <verse eid="EZR 10:16" /><verse number="17" style="v" sid="EZR 10:17" />Ɗaɗa o kotoi u petelyuwushe wa a ɗa ali a na a zuwai atakpaci a̱ a̱ma̱ci o urana wu ufaru u woto wu ufaru.<verse eid="EZR 10:17" /></para>
  <para style="s">Ali a na a zuwai atakpaci a̱ a̱ma̱ci</para>
  <para style="p">
    <verse number="18" style="v" sid="EZR 10:18" />Apa ala a nan ganu a na a̱ ri pe a̱tsuma̱ aza a na a zuwai atakpaci a̱ a̱ma̱ci.</para>
  <para style="b" vid="EZR 10:18" />
  <para style="li1" vid="EZR 10:18">Limatan va Jesuwa ulobo wa Jozada na̱ a̱za̱ a̱ yi,</para>
  <para style="li1" vid="EZR 10:18">Maseya na̱ Eliyeza na̱ Jari na̱ Gedaliya. <verse eid="EZR 10:18" /><verse number="19" style="v" sid="EZR 10:19" />A̱vu a yuwan akucunu a na a̱ gba̱ra̱ a̱ma̱ci e le. Za suru a̱tsuma̱ e le ca ta a̱a̱giri'i adama a̱ kucci vu unusu.<verse eid="EZR 10:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="EZR 10:20" />Diga a limatan va Ima,</para>
  <para style="li2" vid="EZR 10:20">Hanani na̱ Zebadiya.<verse eid="EZR 10:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="EZR 10:21" />Limatan va Harim,</para>
  <para style="li2" vid="EZR 10:21">Maseya na̱ Iliya na̱ Shemaya na̱ Jehiye na̱ Uziya.<verse eid="EZR 10:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="EZR 10:22" />Limatan va Pashihu,</para>
  <para style="li2" vid="EZR 10:22">Eliyonai na̱ Maseya na̱ Isma'ila na̱ Nataniya na̱ Jozaba na̱ Elasa.<verse eid="EZR 10:22" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="23" style="v" sid="EZR 10:23" />Diga a nan Levi,</para>
  <para style="li2" vid="EZR 10:23">Jozaba na̱ Shimeyi na̱ Kelaya za na a̱yi ɗa Kelita, na̱ Petahiya na̱ Yahuza na̱ Eliyeza.<verse eid="EZR 10:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="EZR 10:24" />Diga e iɓolo ya̱ a̱za̱ e ishipa,</para>
  <para style="li2" vid="EZR 10:24">Eliyashi ɗa.</para>
  <para style="li1" vid="EZR 10:24">Diga uba̱ta̱ wa̱ a̱za̱ e ipiri yu una̱ntsu,</para>
  <para style="li2" vid="EZR 10:24">Shalum na̱ Telem na̱ Uri.<verse eid="EZR 10:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="EZR 10:25" />Apa akapi ala a aza a Isra'ila a na a̱ ri na̱ cu'un vu unusu u nda.</para>
  <para style="b" vid="EZR 10:25" />
  <para style="li1" vid="EZR 10:25">Limatan va Parosh,</para>
  <para style="li2" vid="EZR 10:25">Ramiya na̱ Iziya na̱ Malkiya na̱ Miyamin na̱ Eliyaza na̱ Malkiya na̱ Benaya.<verse eid="EZR 10:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="EZR 10:26" />Limatan va Elam,</para>
  <para style="li2" vid="EZR 10:26">Mataniya na̱ Zakariya na̱ Jehiye na̱ Abidi na̱ Yeremo na̱ Iliya.<verse eid="EZR 10:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="EZR 10:27" />Limatan va Zatu,</para>
  <para style="li2" vid="EZR 10:27">Eliyonai na̱ Eliyashi na̱ Mataniya na̱ Yeremo na̱ Zabad na̱ Aziza.<verse eid="EZR 10:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="EZR 10:28" />Limatan va Bebai,</para>
  <para style="li2" vid="EZR 10:28">Jehohana na̱ Hananiya na̱ Zabai na̱ Atilai.<verse eid="EZR 10:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="EZR 10:29" />Limatan va Bani,</para>
  <para style="li2" vid="EZR 10:29">Meshulam na̱ Maluk na̱ Adaya na̱ Jashu na̱ Sheya na̱ Yeremo.<verse eid="EZR 10:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="EZR 10:30" />Limatan va Paha Mowa,</para>
  <para style="li2" vid="EZR 10:30">Adina na̱ Kela na̱ Benaya Maseya na̱ Mataniya na̱ Bezale na̱ Binuyi na̱ Manase.<verse eid="EZR 10:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="EZR 10:31" />Limatan va Harim,</para>
  <para style="li2" vid="EZR 10:31">Eliyeza na̱ Ishiya na̱ Malkiya na̱ Shemaya na̱ Shimeyon, <verse eid="EZR 10:31" /><verse number="32" style="v" sid="EZR 10:32" />na̱ Banyami na̱ Maluk na̱ Shemariya.<verse eid="EZR 10:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="EZR 10:33" />Limatan va Hashum,</para>
  <para style="li2" vid="EZR 10:33">Matenai na̱ Matata na̱ Zabad na̱ Elifele na̱ Jeremai na̱ Manase na̱ Shimeyi.<verse eid="EZR 10:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="EZR 10:34" />Limatan va Bani,</para>
  <para style="li2" vid="EZR 10:34">Madai na̱ Amuram na̱ Uwe, <verse eid="EZR 10:34" /><verse number="35" style="v" sid="EZR 10:35" />na̱ Benaya na̱ Bedeyiya na̱ Keluhi, <verse eid="EZR 10:35" /><verse number="36" style="v" sid="EZR 10:36" />na̱ Vaniya na̱ Meremo na̱ Eliyashi, <verse eid="EZR 10:36" /><verse number="37" style="v" sid="EZR 10:37" />na̱ Mataniya na̱ Matenai na̱ Ja'asu.<verse eid="EZR 10:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="EZR 10:38" />Limatan va Binuyi,</para>
  <para style="li2" vid="EZR 10:38">Shimeyi, <verse eid="EZR 10:38" /><verse number="39" style="v" sid="EZR 10:39" />na̱ Shelemiya na̱ Natan na̱ Adaya, <verse eid="EZR 10:39" /><verse number="40" style="v" sid="EZR 10:40" />na̱ Makinadebai na̱ Shashai na̱ Sharai, <verse eid="EZR 10:40" /><verse number="41" style="v" sid="EZR 10:41" />na̱ Azare na̱ Shelemiya na̱ Shemariya, <verse eid="EZR 10:41" /><verse number="42" style="v" sid="EZR 10:42" />na̱ Shalum na̱ Amariya na̱ Isuhu.<verse eid="EZR 10:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="EZR 10:43" />Limatan va Nebo,</para>
  <para style="li2" vid="EZR 10:43">Yeyiyel na̱ Matitiya na̱ Zabad na̱ Zebina na̱ Jadai na̱ Juwe na̱ Benaya.<verse eid="EZR 10:43" /></para>
  <para style="b" />
  <para style="p">
    <verse number="44" style="v" sid="EZR 10:44" />Ele nda suru a̱ shi ta̱ a zuwa atakpaci a̱ a̱ma̱ci. Reve a̱ gba̱ra̱ a̱ma̱ci'i suru na̱ muwun n le.<verse eid="EZR 10:44" /></para>
  <chapter eid="EZR 10" />
</usx>