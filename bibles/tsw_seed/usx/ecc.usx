<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ECC" style="id">- Tsishingini (tsw)</book>
  <para style="h">Alajiya</para>
  <para style="toc3">Alj</para>
  <para style="toc2">Alajiya</para>
  <para style="toc1">Alajiya</para>
  <para style="mt2">Alajiya</para>
  <para style="mt1">Alajiya</para>
  <para style="is">Ucuɗuwu wa aatagada a nda</para>
  <para style="ip">Aatagada a Alajiya a̱ tu utanuwu na̱ majiyan ma̱ a̱ru'un. Za vi iɗana'a u roco ta̱ a̱ba̱jini a ɗa, adama a mantsa ma wa'a ma na wuma wu vaɗilima̱ ri, na̱ cine urupulu u shitoyin wuma, nu urocosu wa aɗangulu a na a̱ ri na aci shi, oɓolo na̱ a̱tsuma̱lima̱, aza a na a̱ ta̱wa̱i nu ukosu wa adanshi adansa, &lt;&lt;Ili suru ili ye pere i ɗa&gt;&gt;. U gura reve re va̱ A̱sula̱ shi, za na ri ni ili i na i ri e ekere a̱ yi suru shi. Na̱ ne suru u tsu ca ama a yuwan ulinga nu ukadu shi, waru a uwwa uyo'o wu une'e wa̱ A̱sula̱ ele ubuwu wuma shi.</para>
  <para style="ip">U ta gura wo o'wo cu'un majiyan ma̱a̱ a̱ru'un a nda'a ta̱ ta̱wa̱a̱ na̱ a̱tsuma̱la̱ngu ko wuta̱su wo ookolo. Amma a na wo o'woi o otoi Aatagada a Akiza a nda u roco ta̱ a na ucawu wo okolo o una̱ wu uritosu wa Aatagada a Akiza u ta̱ a̱ru'un lon. Hali na u tarai majiyan mo ulambu wu usuwu nu ulambu wu urevu. Ama na̱ a̱bunda̱ a̱ tsu tsura̱ ta̱ ikambishi a mantsa ma na e petelyuwei adanshi'i adama wo o'wo le tsa̱ ma̱suka̱ci. Waru a tsu gura ta̱ reve ana Aatagada a Akiza a nda'a za na aa casu ucuɗuwu wu cu'un majiyan ma nda'a, u ta̱wa̱ ta̱ nu uzuwu wo okolo uba̱ta̱ wa̱ A̱sula̱ za na aa casu wuma u sa'ani.</para>
  <para style="iot">Ili i na i ri pe a̱tsuma̱ a aatagada a nda</para>
  <para style="io1">Wuma u ta̱ nu urana gba? 1:1-2:26</para>
  <para style="io1">Aɗa adama a wuma 3:1-11:8</para>
  <para style="io1">Ukosu wa adanshi 11:9-12:8</para>
  <para style="io1">Adanshi ke'en 12:9-14</para>
  <para style="ib" />
  <chapter number="1" style="c" sid="ECC 1" />
  <para style="s">Ili suru ili ye pere i ɗa</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 1:1" />Idanshi yi za va a alajiya, ulobo wa̱ Da̱wuda, mogono a̱tsuma̱ a̱ Urishelima.<verse eid="ECC 1:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="ECC 1:2" />&lt;&lt;Ili ye pere i ɗa, ili suru ili ye pere i ɗa,</para>
  <para style="q2" vid="ECC 1:2">za va alajiya a damma ta̱,</para>
  <para style="q2" vid="ECC 1:2">ili suru ili ye pere i ɗa.&gt;&gt;<verse eid="ECC 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 1:3" />Cu'un va atsupu a̱ ne ɗa za a̱a̱ tsura̱</para>
  <para style="q2" vid="ECC 1:3">diga a̱tsuma̱ o ulinga wa̱ yi,</para>
  <para style="q2" vid="ECC 1:3">za na waa yuwusan a̱tsuma̱ o uvaɗi u nda suru?<verse eid="ECC 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 1:4" />Mantsa mo ro ma̱a̱ tsu ka̱ra̱ ta̱,</para>
  <para style="q2" vid="ECC 1:4">reve mantsa mo ro ma̱ ta̱wa̱,</para>
  <para style="q2" vid="ECC 1:4">amma uvaɗi u ta̱ lo hali hali.<verse eid="ECC 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 1:5" />Urana u tsu ɓa̱tsa̱ ta̱,</para>
  <para style="q2" vid="ECC 1:5">a̱vu waru u riya̱,</para>
  <para style="q1" vid="ECC 1:5">u tsu jika̱ ta̱ a̱vu u ka̱mba̱</para>
  <para style="q2" vid="ECC 1:5">uba̱ta̱ u na u tsu uta̱sa̱.<verse eid="ECC 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 1:6" />Upepu u tsu lapa ta̱</para>
  <para style="q2" vid="ECC 1:6">a̱ tyo wu uyagi,</para>
  <para style="q2" vid="ECC 1:6">a̱vu u vadala a̱ tyo wu ugana,</para>
  <para style="q1" vid="ECC 1:6">u tsu da̱na̱ ta̱ a̱ ka̱nda̱ruwusa̱,</para>
  <para style="q2" vid="ECC 1:6">a̱vu u ka̱mba̱ uba̱tu u na wu uta̱i.<verse eid="ECC 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 1:7" />Ɗolu suru tsu yene ta̱ a̱ tyo a mala,</para>
  <para style="q2" vid="ECC 1:7">amma mala ma tsu shiwan shi.</para>
  <para style="q1" vid="ECC 1:7">Uba̱ta̱ u na mini'i wu uta̱i,</para>
  <para style="q2" vid="ECC 1:7">ɗe ɗa u tsu ka̱mba̱ waru.<verse eid="ECC 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 1:8" />Ili suru i tsu zuwa ta̱ vu da̱na̱ nu ukunu,</para>
  <para style="q2" vid="ECC 1:8">u tsu la'a ta̱ ili na va gura damma,</para>
  <para style="q1" vid="ECC 1:8">esu a̱ tsu kuna̱ na̱ me ene shi,</para>
  <para style="q2" vid="ECC 1:8">atsuvu waru a̱ tsu kuna̱ na̱ mawwa shi.<verse eid="ECC 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 1:9" />Ili i na i farai ɗe nu ufaru,</para>
  <para style="q2" vid="ECC 1:9">a̱ yi ɗa waru wa farasa,</para>
  <para style="q1" vid="ECC 1:9">Ili na a yuwain ɗe nu ufaru,</para>
  <para style="q2" vid="ECC 1:9">a̱ yi ɗa a̱da̱shishi yuwusa.</para>
  <para style="q1" vid="ECC 1:9">Babu ili i na i ri usa'avu</para>
  <para style="q2" vid="ECC 1:9">a̱tsuma̱ a wuma wu uvaɗi u nda.<verse eid="ECC 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 1:10" />A̱ ta̱ tsura̱ ili i ro i na a damma,</para>
  <para style="q2" vid="ECC 1:10">&lt;&lt;Ka̱lyuwa̱! Ili i nda ili i sa'avu i ɗa&gt;&gt;?</para>
  <para style="q1" vid="ECC 1:10">U da̱na̱ ta̱ pa, ɗe nu ujumu</para>
  <para style="q2" vid="ECC 1:10">u da̱na̱ ta̱ pa kafu mantsa ma̱ a̱ tsu.<verse eid="ECC 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 1:11" />Babu za na tsu cuwan</para>
  <para style="q2" vid="ECC 1:11">ni ili i na a yuwain ɗe nu ufaru.</para>
  <para style="q1" vid="ECC 1:11">Babu za na a cuwan</para>
  <para style="q2" vid="ECC 1:11">ni ili i na ya̱a̱ ta̱wa̱ eleme.</para>
  <para style="q1" vid="ECC 1:11">Babu za na a̱ cuwan</para>
  <para style="q2" vid="ECC 1:11">ni ili i na ya̱a̱ ta̱wa̱</para>
  <para style="q2" vid="ECC 1:11">a mantsa ma̱ gogo na̱ mantsa ma na ma̱a̱ ta̱wa̱.<verse eid="ECC 1:11" /></para>
  <para style="s">I zami yu ugbozu ili ya̱ pere i ɗa</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12" />A̱mu, za va alajiya, n da̱na̱ ta̱ mogono a aci a Isra'ila a̱tsuma̱ Urishelima. <verse eid="ECC 1:12" /><verse number="13" style="v" sid="ECC 1:13" />N zuwa ta̱ aciya̱va̱ na moo rito, waru na mee reve nu ugbozu wi ili i na i ri pa a̱tsuma̱ o uvaɗi suru, a̱vu n reve ili yu ume u ne A̱sula̱ a zuwayi vaɗilima̱! <verse eid="ECC 1:13" /><verse number="14" style="v" sid="ECC 1:14" />Agba me ene ta̱ suru ili na a yuwain a̱tsuma̱ o uvaɗi u nda ili ya̱ pere i ɗa, waru n reve ta̱ suru ndolo tsa̱ me reme mo upepu u ɗa.<verse eid="ECC 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ECC 1:15" />Ili i na i ri uka̱nzu suru</para>
  <para style="q2" vid="ECC 1:15">a gura ba̱ruwa̱ yi shi,</para>
  <para style="q1" vid="ECC 1:15">ili i na i ri lo shi,</para>
  <para style="q2" vid="ECC 1:15">a gura kece shi.<verse eid="ECC 1:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="ECC 1:16" />A̱vu n damma aciya̱va̱, &lt;&lt;Ka̱lyuwa̱, n kungwa ta̱ nu urevu lon, hali n la'a ama suru a na a yuwain tsugono a aci a Urishelima kafu a̱mu. Na̱ amayun n tsura̱ ta̱ urevu nu ugbozu lon.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="1KI 4:29-31">1 Ngo 4:29-31</ref>.</char></note> <verse eid="ECC 1:16" /><verse number="17" style="v" sid="ECC 1:17" />Agba n zuwa ta̱ aciya̱va̱ uba̱tu u na mee reve nu ugbozu, a̱vu n reve na̱ tsulo nu ujaru, amma n reve ta̱ suru ndolo tsa̱ me reme mo upepu u ɗa.<verse eid="ECC 1:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ECC 1:18" />Adama a na a̱bunda̱ o ugbozu u tsu ta̱wa̱a̱ ta̱ na̱ a̱bunda̱ a̱tsuma̱la̱ngu,</para>
  <para style="q2" vid="ECC 1:18">a̱bunda̱ o urevu waru u tsu ta̱wa̱a̱ ta̱ na̱ a̱bunda̱ a̱tsuma̱lima̱.<verse eid="ECC 1:18" /></para>
  <chapter eid="ECC 1" />
  <chapter number="2" style="c" sid="ECC 2" />
  <para style="s">Mawwa mo uyo'o ili ya̱ pere i ɗa</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1" />A̱vu n damma aciya̱va̱, &lt;&lt;Lyawa n zuwa okolo a̱ va̱ na maa uwwa uyo'o, tsura̱ n reve cine mawwa moo uyo'o ma̱ ri!&gt;&gt; Amma n cina ta̱ ili i ndolo suru ili ye pere i ɗa. <verse eid="ECC 2:1" /><verse number="2" style="v" sid="ECC 2:2" />N gura ta̱ reve izo'oshi tsulo tsa ɗa, wuma u mawwa mo uyo'o fo, u ri nu urana shi. <verse eid="ECC 2:2" /><verse number="3" style="v" sid="ECC 2:3" />N gura ta̱ idana okolo a̱ va̱, cine maa ca aciya̱va̱ mawwa mo uyo'o na̱ masayan ma inabi, mantsa ma na ugbozu u ri a majiyan ma̱ va̱. A̱vu waru n tara tsulo adama na mee e reve ili na i ri ulobonu u na vaɗilima̱ a yuwan a̱tsuma̱ o uvaɗi a rana ke'en u wuma u le. <verse eid="ECC 2:3" /><verse number="4" style="v" sid="ECC 2:4" />N yuwa ta̱ ili i gbagbain na̱ a̱bunda̱, a̱vu n suwaa aciya̱va̱ 'wa, a̱vu waru n cu'wa̱a̱n aciya̱va̱ a̱ɗuma̱ a inabi. <verse eid="ECC 2:4" /><verse number="5" style="v" sid="ECC 2:5" />N yuwaan ta̱ aciya̱va̱ a̱ɗuma̱ na̱ ba̱ta̱ wivuwun, waru n cu'wa̱n ta̱ cu'un vu ɗanga biti za na tsu matsusan muwun. <verse eid="ECC 2:5" /><verse number="6" style="v" sid="ECC 2:6" />N yuwaan ta̱ aciya̱va̱ uba̱ta̱ wu uɓolotosu u mini, adama a na a ca ɗanga na kungwai mini. <verse eid="ECC 2:6" /><verse number="7" style="v" sid="ECC 2:7" />A̱vu n tsulaa aciya̱va̱ agbashi a ali na̱ a̱ma̱ci, a̱vu fo a matsaan mu muwun ma agbashi a̱tsuma̱ o u'wa u va̱. Waru n da̱na̱ fo za vi iliyamunga, wi inan ni ikyon na̱ mgbele nna n la'ai za suru, na fara da̱nu wa̱ numu a̱tsuma̱ a̱ Urishelima.<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="1KI 4:23">1 Ngo 4:23</ref>.</char></note> <verse eid="ECC 2:7" /><verse number="8" style="v" sid="ECC 2:8" />N ɓolotowo ta̱ aciya̱va̱ azurufa na̱ zinariya, no oɓolo e itana i maluwa va̱ a̱za̱ o tsugono, oɓolo no ozo o tsugono tsu upasu u na maa yuwusan tsugono tsa̱ le. A̱vu n tsura̱ ashipi ali na̱ a̱ma̱ci adama a canaa mu ishipa, ni ili icu'un icu'un adama a mawwa mo u uyo'o u wuma, na̱ a̱ma̱ci a̱ nge'en a̱bunda̱ a na n zuwai. <verse eid="ECC 2:8" /><verse number="9" style="v" sid="ECC 2:9" />Na amayun tsugbain tsa̱ va̱ tsa̱ da̱shi ta̱, waru n la'a ta̱ aza a na a fara da̱nuwa̱ numu a̱tsuma̱ a̱ Urishelima. Na̱ ne suru ugbozu u va̱ wu kasa na̱ a̱mu shi.<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="1CH 29:25">1 Alb 29:25</ref>.</char></note><verse eid="ECC 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ECC 2:10" />Ili i na lyusu va̱ ri a maluwa biti,</para>
  <para style="q2" vid="ECC 2:10">n tsu putsaa yi shi.</para>
  <para style="q1" vid="ECC 2:10">N tsu putsaa aciya̱va̱</para>
  <para style="q2" vid="ECC 2:10">na̱ mawwa moo uyo'o shi.</para>
  <para style="q1" vid="ECC 2:10">Wuma u va̱ wu uwwa uyo'o wu ulinga u va̱,</para>
  <para style="q2" vid="ECC 2:10">a̱yi nda a̱yi ɗa iliyinkapa yu ulinga u va̱ suru.<verse eid="ECC 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 2:11" />N yuwan ta̱ majiyan mo ulinga wu ukere u va̱ suru,</para>
  <para style="q2" vid="ECC 2:11">nu ulinga u na n yuwain suru</para>
  <para style="q2" vid="ECC 2:11">na ma̱a̱ tsura̱ ulyuwu we elime,</para>
  <para style="q1" vid="ECC 2:11">me ene ta̱ a̱ yi ndolo suru ili ya̱ pere i ɗa</para>
  <para style="q2" vid="ECC 2:11">waru suru ndolo tsa̱ me reme mo upepu u ɗa.</para>
  <para style="q1" vid="ECC 2:11">Babu ili na i ri ulobonu</para>
  <para style="q2" vid="ECC 2:11">a wuma wu uvaɗi u nda.<verse eid="ECC 2:11" /></para>
  <para style="s">Ugbozu na̱ tsulo suru ili ya̱ pere i ɗa</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 2:12" />A̱vu n vadala majiyan ma̱ va̱ uba̱ta̱ wu ugbozu,</para>
  <para style="q2" vid="ECC 2:12">oɓolo nu ujaru na̱ tsulo.</para>
  <para style="q1" vid="ECC 2:12">Adama a na za na aa lyuwa tsugono nye wa yuwan?</para>
  <para style="q2" vid="ECC 2:12">Babu ili i ro,</para>
  <para style="q1" vid="ECC 2:12">ili ta̱ i ɗa wa gura yuwan</para>
  <para style="q2" vid="ECC 2:12">a̱ yi ɗa u yuwan ili i na a̱za̱ o tsugono tsu ufaru a yuwain.<verse eid="ECC 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 2:13" />Me ene ta̱ ulinga wu ugbozu u la'a ta̱ tsulo,</para>
  <para style="q2" vid="ECC 2:13">cine ekan i la'ai irumbu.<verse eid="ECC 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 2:14" />Vuma vu ugbozu tsu da̱na̱ ta̱ nu urevu,</para>
  <para style="q2" vid="ECC 2:14">amma ulo u tsu wala ta̱ a̱tsuma̱ e irumbu.</para>
  <para style="q1" vid="ECC 2:14">Na̱ ne suru, mee ene ta̱</para>
  <para style="q2" vid="ECC 2:14">ukosu wi ili biti ili i ta̱ i ɗa.<verse eid="ECC 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 2:15" />A̱vu n damma aciya̱va̱,</para>
  <para style="q2" vid="ECC 2:15">&lt;&lt;Ili i na i cinai ulo, u ta cina na mu fo.</para>
  <para style="q1" vid="ECC 2:15">To, iliyinkapa i ne i ɗa n tsura̱i a̱ nden mu za vu ugbozu?&gt;&gt;</para>
  <para style="q2" vid="ECC 2:15">A̱vu n damma aciya̱va̱,</para>
  <para style="q2" vid="ECC 2:15">&lt;&lt;Suru ili ya̱ nda ili ya̱ pere i ɗa.&gt;&gt;<verse eid="ECC 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 2:16" />Adama a na za vu ugbozu nu ulo suru,</para>
  <para style="q2" vid="ECC 2:16">a cuwan na̱ le a̱ ya̱wa̱ elime shi.</para>
  <para style="q2" vid="ECC 2:16">A rana ve elime a̱ ta̱ e icina ne le suru.</para>
  <para style="q1" vid="ECC 2:16">Cine za vu ugbozu tsu kuwa̱,</para>
  <para style="q2" vid="ECC 2:16">ne ɗa fo ulo u tsu kuwa̱!<verse eid="ECC 2:16" /></para>
  <para style="s">Ulinga fo ili ya̱ pere i ɗa</para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 2:17" />Adama o ndolo, wuma ili i ro i ɗa shi e ekere a̱ va̱, adama a na e ekere a̱ va̱ suru, ili na a yuwusan a wuma wu uvaɗi u nda, u ri nu urana shi. Suru ili, ili ya̱ pere i ɗa, waru ndolo suru tsa̱ mereme mo upepu u ɗa. <verse eid="ECC 2:17" /><verse number="18" style="v" sid="ECC 2:18" />Ulinga u va̱ u na n yuwain suru o uvaɗi u nda, ili i ro i ɗa shi e ekere a̱ va̱, a na wo o'woi n gura revei n ta lyawaa za na a tara agadu a̱ va̱. <verse eid="ECC 2:18" /><verse number="19" style="v" sid="ECC 2:19" />Zane revei za na aa tara a agadu a̱ va̱'a̱, vuma ɗa na ri nu ugbozu ko ulo u ɗa? Na̱ ne suru, u ta tara agadu e ili i na n leweyin a̱tsuma̱ o uvaɗi u nda suru. Ili ya nda suru ili ye pere i ɗa. <verse eid="ECC 2:19" /><verse number="20" style="v" sid="ECC 2:20" />Na m petelyuwei reve okolo a̱ va̱ a kuɗa a̱tsuma̱ o ulinga u na n yuwain a̱tsuma̱ a wuma u va̱ wu uvaɗi u nda. <verse eid="ECC 2:20" /><verse number="21" style="v" sid="ECC 2:21" />Adama a na za na yuwain ulinga wa̱ yi nu ugbozu nu urevu nu uguru, na̱ ne suru, u ta lyawaa nanza za na suɗuwai oɓolo na̱ a̱yi shi. Ili ya nda ili ye pere i ɗa, agba ili yi iwuya i ɗa. <verse eid="ECC 2:21" /><verse number="22" style="v" sid="ECC 2:22" />Nye ɗa vaɗilima̱ tsu tsura̱ a̱tsuma̱ o ulinga u na aa yuwusan, na̱ cu'un va̱ a̱tsuma̱lima̱ na a tsu sowuso a̱tsuma̱ a wuma u le a̱tsuma̱ o uvaɗi nda? <verse eid="ECC 2:22" /><verse number="23" style="v" sid="ECC 2:23" />Adama a na wuma u le u ta̱ tapu nu usa̱n, ulinga u le waru a̱tsuma̱lima̱ a ɗa. Na ayin fo okolo e le a tsu ivuwan shi. Ili ya nda suru ili ya̱ pere i ɗa.<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="JOB 5:7">Ayb 5:7</ref>; <ref loc="JOB 14:1">14:1</ref>.</char></note> <verse eid="ECC 2:23" /><verse number="24" style="v" sid="ECC 2:24" />Babu ili i na i la'ai ulobonu e ekere a vaɗilima̱, na la'ai a lyuwa a̱vu a̱ osowo, waru a uwwa uyo'o wu ulinga u le. N reve ta̱, a na nda'a diga uba̱ta̱ wa̱ A̱sula̱ a ɗa.<note caller="-" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="ECC 3:13">Alj 3:13</ref>; <ref loc="ECC 5:18">5:18</ref>; <ref loc="ECC 9:7">9:7</ref>; <ref loc="LUK 12:19">Luk 12:19</ref>; <ref loc="1CO 15:32">1 Kor 15:32</ref>.</char></note> <verse eid="ECC 2:24" /><verse number="25" style="v" sid="ECC 2:25" />Cine vuma a gura uwwa uyo'o wa alya no oso, nna̱ diga uba̱ta̱ wa̱ A̱sula̱ a ɗa shi? <verse eid="ECC 2:25" /><verse number="26" style="v" sid="ECC 2:26" />E ekere a za na a yo'onotosu A̱sula̱ ookolo, A̱sula̱ ɗa a tsu ca yi ugbozu, nu urevu, na̱ ma̱za̱nga̱. Amma e ekere a za vu unusu, A̱sula̱ a tsu ca yi ta̱ usa̱n wi izami nu uɓolotosu, a̱ tyo o ukosu a̱vu u ca za na tsu yo'onotosu A̱sula̱ ookolo. Na̱ ne suru ili ya nda ili ya̱ pere i ɗa, waru suru ndolo tsa̱ me reme mo upepu u ɗa.<note caller="-" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="JOB 32:8">Ayb 32:8</ref>; <ref loc="PRO 2:6">Udm 2:6</ref>. </char></note><verse eid="ECC 2:26" /></para>
  <chapter eid="ECC 2" />
  <chapter number="3" style="c" sid="ECC 3" />
  <para style="s">Mantsa me ili suru</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="ECC 3:1" />Ili suru i ta̱ na̱ mantsa,</para>
  <para style="q2" vid="ECC 3:1">mantsa me ili biti, ma na ma ntsayi o uvaɗi.<verse eid="ECC 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 3:2" />Mantsa ma limatan na̱ mantsa mo ukwisa̱,</para>
  <para style="q2" vid="ECC 3:2">mantsa ma̱ ca̱'a̱n na̱ mantsa mo ugasa.<verse eid="ECC 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 3:3" />Mantsa ma̱ mo una, na̱ mantsa ma na a̱ da̱na̱ gbaga,</para>
  <para style="q2" vid="ECC 3:3">na̱ mantsa mo wuɓosu na̱ mantsa ma na a suwisa.<verse eid="ECC 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 3:4" />Na̱ mantsa me mesun na̱ mantsa me izo'oshi,</para>
  <para style="q2" vid="ECC 3:4">na̱ mantsa ma̱ a̱tsuma̱la̱ngu, na̱ mantsa ma̱ ma̱za̱nga̱.<verse eid="ECC 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 3:5" />Mantsa ma na e bete'we atali, na̱ mantsa ma na o ɓoloto le,</para>
  <para style="q2" vid="ECC 3:5">mantsa mo ukatalasa, na̱ mantsa ma na a i'wan ukatalasa,<verse eid="ECC 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 3:6" />mantsa me izami, na̱ mantsa ma na a lamba,</para>
  <para style="q2" vid="ECC 3:6">na̱ mantsa ma mazuwa, na̱ mantsa ma na a vari le alanga,<verse eid="ECC 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 3:7" />Mantsa ma na a kakara, na̱ mantsa ma na a̱ zula̱,</para>
  <para style="q2" vid="ECC 3:7">mantsa ma na a̱ rungwa̱ kpen na̱ mantsa ma na a yuwan adanshi.<verse eid="ECC 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 3:8" />Mantsa me icigi, na̱ mantsa me ima̱,</para>
  <para style="q2" vid="ECC 3:8">na̱ mantsa mo uvon na̱ mantsa ma asuvu nde.<verse eid="ECC 3:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="ECC 3:9" />Ili isa'ani i ne ɗa vuma a̱ tsura̱ a̱tsuma̱ o ulinga wa̱ yi? <verse eid="ECC 3:9" /><verse number="10" style="v" sid="ECC 3:10" />Me ene ta̱ ili i na A̱sula̱ a cayi e ekere a vuma a na wa̱a̱ da̱na̱ a yuwusan. <verse eid="ECC 3:10" /><verse number="11" style="v" sid="ECC 3:11" />U zuwa ta̱ ili suru ulobonu na̱ mantsa ma̱ yi. Na̱ ne suru, u zuwa ta̱ majiyan ma vaɗilima̱ na wee reve ili na i ka̱ra̱i ɗe ni ili i na i ri ɗe elime, amma na̱ ne suru a gura reve ili na A̱sula̱ a yuwain diga o ufaru a̱ tyo o ukosu shi. <verse eid="ECC 3:11" /><verse number="12" style="v" sid="ECC 3:12" />N gura ta̱ reve babu ili i na i la'ai ulobono vuma yuwan, na la'ai u yuwan ma̱za̱nga̱, a̱vu waru u yuwan isa'ani a̱tsuma̱ a wuma wa̱ yi. <verse eid="ECC 3:12" /><verse number="13" style="v" sid="ECC 3:13" />Za suru u lyuwa a̱vu u sowo, a̱vu wu uwwaa aciya̱yi uyo'o suru a̱tsuma̱ o ulinga wa̱ yi, adama a na a̱ yi ndolo une'e wa̱ A̱sula̱ a ɗa.<verse eid="ECC 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 3:14" />N gura ta̱ reve suru ili i na a̱ A̱sula̱ a yuwain u ta̱ da̱na̱ lo hali hali, babu ili i na a̱ da̱shi, ko a jiba pe a̱tsuma̱ a̱ yi. A̱sula̱ a yuwan ta̱ ne adama ama suru a̱ da̱na̱ a uwwusa wovon wa̱ yi.<verse eid="ECC 3:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ECC 3:15" />Ili i na suru i farai gogo, u da̱na̱ ta̱ ɗe nu ufaru.</para>
  <para style="q2" vid="ECC 3:15">Ili i na ya fara fo, u shi ta̱ ɗe u fara,</para>
  <para style="q1" vid="ECC 3:15">A̱sula̱ waru a tsu zuwa ta̱ suru ili i da̱shi fara.<verse eid="ECC 3:15" /></para>
  <para style="s">Uge'etosu na̱ wuma we elime za va̱ A̱sula̱ a ɗa</para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 3:16" />Na̱ ne suru, me ene ta̱ ili i ro a̱tsuma̱ o uvaɗi u nda,</para>
  <para style="q2" vid="ECC 3:16">o una̱ wu uge'etosu wa amayun, she iwuya</para>
  <para style="q2" vid="ECC 3:16">o una̱ wi isa'ani, agba she ili i na i ri ulobonu shi.<verse eid="ECC 3:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ECC 3:17" />N damma ta̱ o okolo a̱ va̱,</para>
  <para style="q2" vid="ECC 3:17">&lt;&lt;Na̱ za na a yuwusan a̱ɓula̱</para>
  <para style="q2" vid="ECC 3:17">na̱ za vi iwuya,</para>
  <para style="q2" vid="ECC 3:17">A̱sula̱ a̱ ta̱ ge'eto le,</para>
  <para style="q1" vid="ECC 3:17">adama na u zuwa ta̱ mantsa</para>
  <para style="q2" vid="ECC 3:17">ma na aa yuwan ili biti,</para>
  <para style="q2" vid="ECC 3:17">mantsa ma na aa yuwan ulinga suru.&gt;&gt;<verse eid="ECC 3:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="ECC 3:18" />Agba waru n damma ta̱ o okolo a̱ va̱, &lt;&lt;Adama a vaɗilima̱ A̱sula̱ a ɗa a̱ tsu lyungwa̱ le, adama u roco le a la'a iliyamunga shi. <verse eid="ECC 3:18" /><verse number="19" style="v" sid="ECC 3:19" />Adama a na ukosu wu vaɗilima̱ na̱ za vi iliyamunga suru ili i ta̱ i ɗa. Cine za ta̱ tsu kuwa̱, ne ɗa fo e ekere a za ta̱'a̱. Wivuwun u le ili i ta̱ i ɗa, waru vaɗilima̱ la'a iliyamunga shi. Ili suru ili ye pere i ɗa. <verse eid="ECC 3:19" /><verse number="20" style="v" sid="ECC 3:20" />Suru n le uba̱ta̱ u ta̱ u ɗa a̱ tsu 'ya̱wa̱, suru n le diga a̱ ma̱buta̱ ma ɗa o uta̱i, suru n le waru a̱ ta̱ a̱ ka̱mba̱ a̱ ma̱buta̱. <verse eid="ECC 3:20" /><verse number="21" style="v" sid="ECC 3:21" />Zane ɗa a gura reve na wuma wu vaɗilima̱ u tsu ka̱ra̱ ta̱ a̱ 'ya̱wa̱ zuva, a̱vu fo wuma wi iliyamunga i ka̱ra̱ a̱ cipa̱ a̱tsuma̱ e iɗa?&gt;&gt; <verse eid="ECC 3:21" /><verse number="22" style="v" sid="ECC 3:22" />N gura ta̱ reve babu ili na i la'ai tsundolo, vaɗilima̱ uwwa uyo'o wu ulinga u le, adama a na a̱ yi ndolo a̱ yi ɗa ifoɓi i na A̱sula̱ a yuwaan n le. Zane ɗa aa gura zuwa le ee reve ili i na yaa fara a mantsa ma na a̱ kuwa̱i?<verse eid="ECC 3:22" /></para>
  <chapter eid="ECC 3" />
  <chapter number="4" style="c" sid="ECC 4" />
  <para style="s">O ɓongi ta̱ aza a babu ucira</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 4:1" />Reve n ka̱lyuwa̱, a̱vu me ene suru cu'un vi iɓongi i na aa yuwusan a̱tsuma̱ o uvaɗi u nda.</para>
  <para style="q1" vid="ECC 4:1">Me ene ta̱ aɓara a zana o ɓongishi,</para>
  <para style="q2" vid="ECC 4:1">agba babu za na aa casu le adanshi.</para>
  <para style="q1" vid="ECC 4:1">Ele ozo o uɓongishi'i e le ɗa a̱ ri nu ucira.</para>
  <para style="q2" vid="ECC 4:1">Ele a̱za̱ oo uɓongishi'i,</para>
  <para style="q2" vid="ECC 4:1">babu za na a casu le adanshi.<verse eid="ECC 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 4:2" />A̱vu n damma aza a na a̱ kuwa̱i ɗe e ivuwan ta̱,</para>
  <para style="q2" vid="ECC 4:2">a la'a ta̱ aza a na a̱ ri wuma mawwa mo uyo'o.<verse eid="ECC 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 4:3" />Amma za na la'a n le uwwa uyo'o suru suru,</para>
  <para style="q2" vid="ECC 4:3">a̱yi ɗa za na koto a matsain shi,</para>
  <para style="q1" vid="ECC 4:3">za na koto enei linga vi iwuya</para>
  <para style="q2" vid="ECC 4:3">i na aa yuwusan a̱tsuma̱ o uvaɗi u nda shi.<verse eid="ECC 4:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="ECC 4:4" />N gura ta̱ reve ili na i zuwai ama suru a̱ ri na̱ a̱ɓula̱ a̱tsuma̱ o ulinga u le suru. Ili i na i zuwai a̱ yi ɗa za suru ciga ta̱ na wa la'a moron ma̱ nden ma̱ yi utsuru. Ili ya̱ ndolo fo ili ya̱ pere i ɗa, waru suru ndolo tsa̱ me reme mo upepu u ɗa.<verse eid="ECC 4:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ECC 4:5" />Ulo u tsu katala ta̱ ekere a̱yi</para>
  <para style="q2" vid="ECC 4:5">a̱vu u da̱nu hali ambulu a̱ ta̱wa̱ o kototo yi.<verse eid="ECC 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 4:6" />U ta la'a na̱ ke'en o ukere uta̱, no okolo nven,</para>
  <para style="q2" vid="ECC 4:6">na̱ a̱za̱ a̱bunda̱ e ekere e re, na̱ a̱bunda̱ o ulinga,</para>
  <para style="q2" vid="ECC 4:6">a̱yi nda fo tsa̱ mereme mo upepu u ɗa.<verse eid="ECC 4:6" /></para>
  <para style="s">Uyo'o wu nden oɓolo</para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 4:7" />A̱vu waru me ene ili ye pere i ro a̱tsuma̱ o uvaɗi u nda.<verse eid="ECC 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 4:8" />Me ene ta̱ za ro a̱ nde'en,</para>
  <para style="q2" vid="ECC 4:8">babu mawun, babu mawun ma̱ a̱na̱wu,</para>
  <para style="q2" vid="ECC 4:8">na̱ ne suru u ta̱ o ukadu wu ulinga mantsa suru.</para>
  <para style="q1" vid="ECC 4:8">U tsu cuwa̱n nu utsuru wa̱ yi shi,</para>
  <para style="q2" vid="ECC 4:8">a̱vu we ece aciya̱yi u damma,</para>
  <para style="q1" vid="ECC 4:8">&lt;&lt; Zane ɗa gba maa yuwusaan a̱ga̱nda̱ o ulinga u nda'a,</para>
  <para style="q2" vid="ECC 4:8">hali na m putsayi aciya̱va̱ na̱ mawwa mo uyo'o?&gt;&gt;</para>
  <para style="q1" vid="ECC 4:8">Nda fo ili ya̱ pere i ɗa,</para>
  <para style="q2" vid="ECC 4:8">nden mu usa̱n n ɗa!<verse eid="ECC 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ECC 4:9" />Ama e re a la'a ta̱ vuma ta̱,</para>
  <para style="q2" vid="ECC 4:9">adama na ulinga wa ama e re</para>
  <para style="q2" vid="ECC 4:9">u tsu la'a ta̱ ulinga u vuma ta̱.<verse eid="ECC 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 4:10" />Adama a na nna̱ vuma ta̱ riya̱,</para>
  <para style="q2" vid="ECC 4:10">za ve ire'e u ta kamba za va̱ yi u 'ya̱sa̱n yi.</para>
  <para style="q1" vid="ECC 4:10">Amma a̱tsuma̱lima̱ a ta cina za na ri a̱ nden e nde'en,</para>
  <para style="q1" vid="ECC 4:10">nnu u riya̱ babu za na aa kamba yi u ya̱sa̱n yi.<verse eid="ECC 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 4:11" />Nna̱ waru ama e re a̱ ri nven uba̱ta̱ ta̱ oɓolo,</para>
  <para style="q2" vid="ECC 4:11">a̱tsu uwwa ta̱ sheshen,</para>
  <para style="q1" vid="ECC 4:11">amma cine vuma ta̱ a uwwa sheshen</para>
  <para style="q2" vid="ECC 4:11">a̱yi e nde'en?<verse eid="ECC 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 4:12" />A ta gura lyuwa a aci a vuma ta̱,</para>
  <para style="q2" vid="ECC 4:12">amma ama e re a̱ ta̱ tsura̱ u lyuwu wa a aci.</para>
  <para style="q1" vid="ECC 4:12">Amunga a̱ ta̱ a na a ɗavai na amunga ata'atsu</para>
  <para style="q2" vid="ECC 4:12">u tsu da̱na̱ ta̱ usa̱n u na aa kasa yi go'o.<verse eid="ECC 4:12" /></para>
  <para style="s">Tsugono fo ili ya̱ pere i ɗa</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 4:13" />U la'a ta̱ nu ulobo u na u ri nu ugbozu za na ri nu ulambu, na akuci o mogono za tsulo na tsu usu a̱sa̱la̱ shi. <verse eid="ECC 4:13" /><verse number="14" style="v" sid="ECC 4:14" />U ta gura wo'o ulobo'o wu u ta̱ o u'wa wa ali tsura̱ u kumba tsugono, ko na wo o'woi a matsa yi ta̱ a̱tsuma̱ o ulambu a̱tsuma̱ e iɗa ya̱ yi. <verse eid="ECC 4:14" /><verse number="15" style="v" sid="ECC 4:15" />N yuwa ta̱ majiyan ma ama a na a̱ ri wuma a̱tsuma̱ o uvaɗi u nda, a̱vu n gura reve a̱tsuma̱ e le a̱ ta̱ tsura̱ ulobo u na waa gura kumba ootogu o mogono. <verse eid="ECC 4:15" /><verse number="16" style="v" sid="ECC 4:16" />Ko na wo o'woi ama na a yuwusan tsugono aciyele a yuwain a̱bunda̱ babu utyo, amma a mantsa ma na u ri lo shi, babu za na o roco ma̱za̱nga̱ me ili na u yuwain. Amayun ili ya̱ ndolo fo ili ya̱ pere i ɗa, waru suru ndolo tsa̱ me reme mo upepu u ɗa.<verse eid="ECC 4:16" /></para>
  <chapter eid="ECC 4" />
  <chapter number="5" style="c" sid="ECC 5" />
  <para style="s">A uwwa wovon wa̱ A̱sula̱</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 5:1" />Vi idana nu udasu wa̱ wu a mantsa ma na vu uwai o u'wa wa̱ A̱sula̱. U ta la'aa wu vu 'ya̱wa̱ na̱ majiyan ma na voo polo atsuvu, ana a damma vu 'ya̱wa̱ ta̱ vu ca kucci cu'un vo olo, adama a na olo e reve i ili a yuwusan u ri ulobonu shi.<verse eid="ECC 5:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="ECC 5:2" />She vo o'wo za va̱ a̱bunda̱ o una̱ wan,</para>
  <para style="q2" vid="ECC 5:2">ko vu lyawa okolo a̱ wu a̱ je'en,</para>
  <para style="q2" vid="ECC 5:2">a mayan ma adanshi a̱ ma̱ka̱ka̱n ma̱ A̱sula̱ wan.</para>
  <para style="q1" vid="ECC 5:2">Adama a na A̱sula̱ a̱ ta̱ zuva,</para>
  <para style="q2" vid="ECC 5:2">a̱vu gba vu ta̱ pa o uvaɗi.</para>
  <para style="q1" vid="ECC 5:2">Adama o ndolo, lyawa adanshi a̱ wu a̱ da̱na̱ wa'a.<verse eid="ECC 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 5:3" />A̱bunda̱ o udamu u tsu zuwa ta̱</para>
  <para style="q2" vid="ECC 5:3">a̱ a̱bunda̱ alavu.</para>
  <para style="q1" vid="ECC 5:3">Ne ɗa waru a̱bunda̱ a adanshi</para>
  <para style="q2" vid="ECC 5:3">u tsu ta̱wa̱ ta̱ na adanshi o tsulo.<verse eid="ECC 5:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="ECC 5:4" />A mantsa ma na vu yuwain akucunu na̱ A̱sula̱, she vu lungusa̱ mantsa ma na vo shiton wan, adama a na u tsu uwwa uyo'o wo olo shi. Vu shiton akucunu a na vu yuwain. <verse eid="ECC 5:4" /><verse number="5" style="v" sid="ECC 5:5" />U ta la'a wu na va yuwan akucunu shi, a na a damma vu yuwan ta̱ akucunu a gba vu shiton shi. <verse eid="ECC 5:5" /><verse number="6" style="v" sid="ECC 5:6" />She vu lyawa una̱ wa̱ wu u tara wu a̱ tyo o unusu wan, adama ta̱wa̱ vu damma ganu wan,&lt;&lt;N yuwan ta̱ akucunu a̱tsuma̱ o ulambu wu urevu u ɗa. &gt;&gt; Nye i zuwai va zuwa a̱ A̱sula̱ a yuwan upan na̱ vu, hali na wo kototo ulinga wa̱ ekere a̱ wu? <verse eid="ECC 5:6" /><verse number="7" style="v" sid="ECC 5:7" />A̱bunda̱ a alavu na̱ a̱bunda̱ adanshi a̱ wu suru ili ya̱ pere i ɗa. Amma vu uwwa wovon wa̱ A̱sula̱.<verse eid="ECC 5:7" /></para>
  <para style="s">Utsuru fo Ili ya̱ Pere i ɗa</para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 5:8" />Na̱ ve ene cine o ɓongishi a̱za̱ o ulambu o uvaɗi, na̱ cine a 'yuwusan ulambu wa̱ a̱ɓula̱ na̱ amayun, she vu yuwan asalama adama e ili i na yaa farasa wan. Adama a na zagbain biti u ta̱ na̱ za na ri zuva va̱ yi, ne ɗa waru a̱ ta̱ na azagbain a na a̱ ri zuva le suru. <verse eid="ECC 5:8" /><verse number="9" style="v" sid="ECC 5:9" />Za suru tsu uwwa ta̱ uyo'o wi itana yu una i na iɗa i matsain, mogono fo aciya̱yi u tsu tsura̱ ta̱ uda̱shiyi diga a̱ ɗuma̱.<verse eid="ECC 5:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ECC 5:10" />Za vi icigi yi ikebe lon,</para>
  <para style="q2" vid="ECC 5:10">ikebe i tsu rawai shi,</para>
  <para style="q1" vid="ECC 5:10">za na cigai utsuru waru,</para>
  <para style="q2" vid="ECC 5:10">u tsu cuwa̱n ni ili na wa̱a̱ tsura̱sa̱ shi.</para>
  <para style="q2" vid="ECC 5:10">Suru ndolo ili ya̱ pere i ɗa.<verse eid="ECC 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 5:11" />Mantsa ma na utsuru u da̱shiyi,</para>
  <para style="q2" vid="ECC 5:11">aza alya a̱ tsu da̱shi ta̱ fo.</para>
  <para style="q1" vid="ECC 5:11">Ili isa'ani i ne ɗa za vu utsuru a̱a̱ tsura̱?</para>
  <para style="q2" vid="ECC 5:11">She de u reve na u ri nu utsuru goon.<verse eid="ECC 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 5:12" />Za vu ulinga tsu uwwa ta̱ uyo'o wu nlavu ma̱ yi,</para>
  <para style="q2" vid="ECC 5:12">ko na̱ shi u lyuwa ilyalya ke'en ko a̱bunda̱.</para>
  <para style="q1" vid="ECC 5:12">Amma ucuwun wu za vu utsuru, u tsu putsa yi ta̱ na̱ nlavu,</para>
  <para style="q2" vid="ECC 5:12">adama a̱bunda̱ o utsuru wa̱ yi.<verse eid="ECC 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 5:13" />N gura ta̱ ene ili iwuya i ro a̱tsuma̱ a wuma wu uvaɗi u nda,</para>
  <para style="q1" vid="ECC 5:13">utsuru u na za vi ili zuwai,</para>
  <para style="q2" vid="ECC 5:13">u ronoo yi ta̱ a̱tsuma̱la̱ngu,<verse eid="ECC 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 5:14" />agba a̱ lungusa̱ ta̱ utsuru'u</para>
  <para style="q2" vid="ECC 5:14">o ure u na u ri ulobonu shi,</para>
  <para style="q1" vid="ECC 5:14">ko na wo o'woi a yuwan ta̱ limatan,</para>
  <para style="q2" vid="ECC 5:14">na̱ ne suru a̱ ri ni ili i na a lyawaa muwun nle shi.<verse eid="ECC 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 5:15" />Ataɓu a ɗa vuma uta̱i a̱ a̱a̱tsuma̱ a mma va̱ yi,</para>
  <para style="q2" vid="ECC 5:15">ataɓu a ɗa waru wa̱a̱ ka̱mba̱.</para>
  <para style="q1" vid="ECC 5:15">Waa tara ili i ro o ukere wa̱ yi,</para>
  <para style="q2" vid="ECC 5:15">a̱tsuma̱ o ulinga u na u yuwain shi.<note caller="-" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="JOB 1:21">Ayb 1:21</ref>; <ref loc="PSA 49:17">Ica 49:17</ref>; <ref loc="1TI 6:7">1 Tim 6:7</ref>.</char></note><verse eid="ECC 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 5:16" />Ili ya nda fo a̱ba̱jini e iwuya i ɗa.</para>
  <para style="q1" vid="ECC 5:16">Ununa vaɗilima̱ ta̱wa̱i,</para>
  <para style="q2" vid="ECC 5:16">ne ɗa waru u tsu ka̱mba̱.</para>
  <para style="q1" vid="ECC 5:16">Ili isa'ani i ne ɗa a̱ tsu tsura̱</para>
  <para style="q2" vid="ECC 5:16">diga a̱tsuma̱lima̱ a̱ mereme mo upepu?<verse eid="ECC 5:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ECC 5:17" />Agba a̱yi ɗa nda rana wuma va̱ yi suru,</para>
  <para style="q2" vid="ECC 5:17">u tsu lyuwa ta̱ a̱tsuma̱ e irumbu,</para>
  <para style="q2" vid="ECC 5:17">na̱ a̱tsuma̱la̱ngu, nu usa̱n, na̱ mɓa̱la̱, nu upan.<verse eid="ECC 5:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="ECC 5:18" />Apa ili na me enei. U ta̱ da̱na̱ ulobonu vuma lyuwa a̱vu u sowo, a̱vu waru wu uwwa uyo'o wu ulinga wa̱ yi, a̱tsuma̱ a wuma u ke'en u na u ri na̱ yi, na A̱sula̱ a ca niyi, adama a na a̱ yi ɗa agadu a na A̱sula̱ o foɓoyi vaɗilima̱. <verse eid="ECC 5:18" /><verse number="19" style="v" sid="ECC 5:19" />Ne ɗa u ri suru e ekere a za na A̱sula̱ a cayi utsuru ni itana, reve fo u ca yi mantsa ma na wa uwwa uyo'o u le. Mawwa mo uyo'o wu ulinga wa̱ yi nu ushishi wi ili i na A̱sula̱ oo foɓo niyi, a̱yi nda fo u ne'e u ɗa uba̱ta̱ wa̱ A̱sula̱. <verse eid="ECC 5:19" /><verse number="20" style="v" sid="ECC 5:20" />Adama a na cu'un vuma ndolo tsu da̱na̱ nu udamu a̱tsuma̱ a wuma wa̱ yi shi, adama a na A̱sula̱ a tsu tsupusa yi ta̱ ili i na okolo a̱ yi a cigai.<verse eid="ECC 5:20" /></para>
  <chapter eid="ECC 5" />
  <chapter number="6" style="c" sid="ECC 6" />
  <para style="s">Wuma wu usa̱n</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1" />N gura ta̱ ene cu'un vi iwuya i ro a̱tsuma̱ o uvaɗi u nda, agba ili'i i yuwan ta̱ a̱bunda̱ lon e ekere a vaɗilima̱. <verse eid="ECC 6:1" /><verse number="2" style="v" sid="ECC 6:2" />A̱sula̱ a tsu ca ta̱ nanza utsuru, ni ili yi nden, na̱ tsugbain, hali fo ni ili i na u cigai suru a wuma wa̱ yi. Na̱ ne suru A̱sula̱ a tsu lyawai na wa uwwa uyo'o wi ili ya nda shi. O una̱ u ndolo mocin ro ɗa ɗe ko'o, na a uwwa uyo'o u le. A̱yi nda fo ili ya̱ pere i ɗa, waru iwuya i ɗa.<verse eid="ECC 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 6:3" />U ta gura o'wo vuma matsan muwun ukpaku, a̱vu waru u da̱na̱ na̱ wuma a alanga. Amma na̱ a̱bunda̱ a wuma wa̱ yi suru, nna̱ wu uwwa uyo'o wi ili na u ɓoloto yi shi, agba waru u tsura̱ a̱ciɗa̱ a sa'ani shi, a̱vu n damma, u la'a ta̱ na a matsan mereɓu ukwa̱.<verse eid="ECC 6:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ECC 6:4" />Ili ya̱ pere i ɗa mereɓu ma̱ ta̱wa̱ ukwa̱,</para>
  <para style="q2" vid="ECC 6:4">a̱tsuma̱ e irumbu a̱vu u ka̱mba̱,</para>
  <para style="q2" vid="ECC 6:4">irumbu iɗa i kpoto yi aala a̱yi.<verse eid="ECC 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 6:5" />Wee ene urana shi,</para>
  <para style="q2" vid="ECC 6:5">u reve wuma shi,</para>
  <para style="q1" vid="ECC 6:5">amma suru na̱ ne,</para>
  <para style="q2" vid="ECC 6:5">u la'a ta̱ asuvu nden na̱ vuma ndeɗe'e.<verse eid="ECC 6:5" /></para>
  <para style="b" />
  <para style="m">
    <verse number="6" style="v" sid="ECC 6:6" />Ko na̱ shi vuma'a u yuwan a'wan ukpakukupa ure, agba wu uwwa uyo'o wi ili shi, wuma wa̱ yi u ri nu urana shi, adama a na suru n le uba̱ta̱ u ta̱ u ɗa a̱ 'ya̱wa̱ shi?<verse eid="ECC 6:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ECC 6:7" />Ulinga wu vaɗilima̱ suru adama a̱ a̱a̱tsuma̱ a ɗa,</para>
  <para style="q2" vid="ECC 6:7">na̱ ne suru u tsu cuwa̱n shi.<verse eid="ECC 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 6:8" />Nye i zuwai za vu ugbozu la'ai ulo?</para>
  <para style="q2" vid="ECC 6:8">Urana u ne ɗa za vu ulambu ri na̱ a̱yi,</para>
  <para style="q1" vid="ECC 6:8">a̱tsuma̱ o urevu wu nden</para>
  <para style="q2" vid="ECC 6:8">n na waa yuwan na aza a na a̱ ri wuma?<verse eid="ECC 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 6:9" />U ta la'a ni ili i na esu e enei,</para>
  <para style="q2" vid="ECC 6:9">a na a zuwa okolo e ili i iwau.</para>
  <para style="q1" vid="ECC 6:9">Ili ya nda fo ili ya̱ pere i ɗa,</para>
  <para style="q2" vid="ECC 6:9">waru tsa̱ mereme mo upepu u ɗa.<verse eid="ECC 6:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ECC 6:10" />Suru ili i na a yuwain,</para>
  <para style="q2" vid="ECC 6:10">a ca yi ta̱ ɗe ala.</para>
  <para style="q1" vid="ECC 6:10">Cine vuma ri,</para>
  <para style="q2" vid="ECC 6:10">e revei ta̱ ɗe.</para>
  <para style="q1" vid="ECC 6:10">Babu za na a gura mawasan</para>
  <para style="q2" vid="ECC 6:10">na̱ za na la'a niyi ucira.<verse eid="ECC 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 6:11" />Cine adanshi a̱ da̱shishi,</para>
  <para style="q2" vid="ECC 6:11">ne ɗa fo ulambu wa̱ a̱ɓula̱ wa̱ yi u tsu da̱shishi.</para>
  <para style="q2" vid="ECC 6:11">Cine tsu ɗa ili i ndolo ya̱a̱ ta̱wa̱a̱ na̱ a̱ɓula̱ e ekere a vuma?<verse eid="ECC 6:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="ECC 6:12" />Amayun ɗa, za ne ɗa a gura reve ili i na i ri na̱ a̱ɓula̱ e ekere a vaɗilima̱ a̱tsuma̱ a rana wuma wa̱ yi zana ri na̱ a̱ɓula̱ shi, aza a na a tsu ka̱ra̱sa̱ cine ululu u tsu ka̱ra̱? Zane ɗa aa gura damma yi ili i na yaa fara mantsa ma na wuma wa̱ yi u kotoi a̱tsuma̱ o uvaɗi u nda?<verse eid="ECC 6:12" /></para>
  <chapter eid="ECC 6" />
  <chapter number="7" style="c" sid="ECC 7" />
  <para style="s">Ugbozu</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 7:1" />Aala a sa'ani a la'a ta̱ mani'i ma̱ ma̱guru ulobonu,</para>
  <para style="q2" vid="ECC 7:1">waru urana wu ukwa̱ u la'a ta̱ urana u limatan.<verse eid="ECC 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 7:2" />U la'a ta̱ a̱ 'ya̱wa̱ o u'wa u na a̱ ri a̱ a̱tsuma̱la̱ngu,</para>
  <para style="q2" vid="ECC 7:2">na a̱ ya̱wa̱ o u'wa u na a yuwusan a̱buki,</para>
  <para style="q1" vid="ECC 7:2">adama a na ukwa̱ a̱ yi ɗa ukosu u vuma,</para>
  <para style="q2" vid="ECC 7:2">u ta̱ da̱na̱ ulobonu za na ri wuma suru u da̱na̱ na̱ nda okolo a̱ yi.<verse eid="ECC 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 7:3" />U ta la'a ulobonu a na a yuwan a̱tsuma̱la̱ngu</para>
  <para style="q2" vid="ECC 7:3">a na a yuwan izo'oshi,</para>
  <para style="q1" vid="ECC 7:3">adama a na ulukutu we esu</para>
  <para style="q2" vid="ECC 7:3">u tsu ta̱wa̱a̱ ta̱ na̱ ma̱za̱nga̱ mo ookolo.<verse eid="ECC 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 7:4" />Ookolo a za vu ugbozu</para>
  <para style="q2" vid="ECC 7:4">u tsu yuwan ta̱ majiyan mo ukwa̱</para>
  <para style="q1" vid="ECC 7:4">amma okolo o ulo a tsu yuwan ta̱</para>
  <para style="q2" vid="ECC 7:4">majiyan ma na wa uwwa uyo'o goon.<verse eid="ECC 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 7:5" />U ta la'a a na vuma a uwwa tsuɓari tsa za vu ugbozu,</para>
  <para style="q2" vid="ECC 7:5">a na uwwa ishipa yi ica yo olo.<verse eid="ECC 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 7:6" />Izo'oshi yu ulo u ta̱ tse e ilama ya awanda</para>
  <para style="q2" vid="ECC 7:6">a na lyuwusa na̱ akina o ugundo wu upondo.</para>
  <para style="q2" vid="ECC 7:6">Nda fo ili ya̱ pere i ɗa.<verse eid="ECC 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 7:7" />Amayun ule'e u tsu zuwa ta̱</para>
  <para style="q2" vid="ECC 7:7">za vu ugbozu ka̱mba̱ ulo,</para>
  <para style="q2" vid="ECC 7:7">u ushishi wu utowusu wu una̱</para>
  <para style="q2" vid="ECC 7:7">u tsu lungusa̱ ta̱ okolo a sa'ani.<verse eid="ECC 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 7:8" />U ta la'a nu ukosu wi ili nu ufaru wa̱ yi,</para>
  <para style="q2" vid="ECC 7:8">u ta la'a na̱ za va a ankuri</para>
  <para style="q2" vid="ECC 7:8">na̱ za va aciyogbamu.<verse eid="ECC 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 7:9" />She vu da̱na̱ za na tsu yuwan upan go'o wan,</para>
  <para style="q2" vid="ECC 7:9">adama a na ulo u ɗa u tsu da̱na̱ tapu nu upan.<verse eid="ECC 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 7:10" />She vu damma,</para>
  <para style="q2" vid="ECC 7:10">&lt;&lt; Nye i zuwai rana vu ufaru a la'ai a̱za̱ gogo?&gt;&gt;</para>
  <para style="q2" vid="ECC 7:10">Adama a na yeci i nda'a, yeci yu ugbozu u ɗa shi.<verse eid="ECC 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ECC 7:11" />Ugbozu u tu ulobonu cine a agadu a̱ ri,</para>
  <para style="q2" vid="ECC 7:11">u tu ulobonu e ekere aza a na a̱ ri wuma.<verse eid="ECC 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 7:12" />Ugbozu mapari ma ɗa,</para>
  <para style="q2" vid="ECC 7:12">u tsu yuwaan ta̱ vuma mapari</para>
  <para style="q2" vid="ECC 7:12">cine ikebe i tsu yuwusan.</para>
  <para style="q1" vid="ECC 7:12">Mapari ma na ugbozu</para>
  <para style="q2" vid="ECC 7:12">u tsu yuwaan za na ri na̱ yi,</para>
  <para style="q2" vid="ECC 7:12">a̱ yi ɗa ulobonu wu urevu.<verse eid="ECC 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 7:13" />Vi idana ulinga wa̱ A̱sula̱,</para>
  <para style="q2" vid="ECC 7:13">za ne aa gura ba̱ruwa̱ ili i na u konzoi?<verse eid="ECC 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 7:14" />A rana mawwa mo uyo'o, vu yuwan ma̱za̱nga̱,</para>
  <para style="q2" vid="ECC 7:14">a rana va̱ a̱tsuma̱lima̱ waru, vu petelyuwe,</para>
  <para style="q1" vid="ECC 7:14">A̱sula̱ a ɗa a yuwain ejere le'e,</para>
  <para style="q2" vid="ECC 7:14">ne ɗa vaɗilima̱ e reve,</para>
  <para style="q2" vid="ECC 7:14">wa gura reve ili i na ya fara na̱ yi ɗe elime shi.<verse eid="ECC 7:14" /></para>
  <para style="s">Nden n wuma</para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 7:15" />A̱tsuma̱ a rana va̱, va̱ pere, me ene ta̱ ili i nda suru.</para>
  <para style="q1" vid="ECC 7:15">Vuma va̱ a̱ɓula̱ tsu kuwa̱ ta̱ u tsu jima shi,</para>
  <para style="q2" vid="ECC 7:15">na̱ a̱ɓula̱ a̱ yi suru,</para>
  <para style="q1" vid="ECC 7:15">za vi iwuya tsu jima ta̱</para>
  <para style="q2" vid="ECC 7:15">ni iwuya i na waa yuwusan suru.<verse eid="ECC 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 7:16" />She vu tara aciya̱wu za va̱ a̱ɓula̱ lon wan,</para>
  <para style="q2" vid="ECC 7:16">agba vu roco aciya̱wu,</para>
  <para style="q2" vid="ECC 7:16">a̱vu za vu ugbozu ɗa lon wan.</para>
  <para style="q2" vid="ECC 7:16">Adama nye ɗa vo una aciya̱wu?<verse eid="ECC 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 7:17" />She vu da̱na̱ za vi iwuya wan,</para>
  <para style="q2" vid="ECC 7:17">agba she vu da̱na̱ a yuwusan tsulo wan.</para>
  <para style="q1" vid="ECC 7:17">Adama nye ɗa va̱a̱ kuwa̱,</para>
  <para style="q2" vid="ECC 7:17">babu na mantsa ma̱ wu ma rawai?<verse eid="ECC 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 7:18" />U ta la'aa wu na vo toni a̱sa̱la̱ e re a nda</para>
  <para style="q2" vid="ECC 7:18">a na vo toni za ta̱ a̱vu vu lyawa za ta̱.</para>
  <para style="q1" vid="ECC 7:18">Adama a na vuma na a uwwusa wovon wa̱ A̱sula̱,</para>
  <para style="q2" vid="ECC 7:18">u ta gura yuwan tsutoni ni ili i nda suru.<verse eid="ECC 7:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="ECC 7:19" />Ugbozu u tsu ca ta̱ za vu ugbozu ucira,</para>
  <para style="q2" vid="ECC 7:19">ula'awu na ama kupa a na a̱ ri o tsugono a̱ lyuci.<verse eid="ECC 7:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ECC 7:20" />Amayun, babu vuma va̱ a̱ɓula̱ o uvaɗi u nda,</para>
  <para style="q2" vid="ECC 7:20">za na a yuwusan ili i mejege mantsa suru,</para>
  <para style="q2" vid="ECC 7:20">babu na u yuwain unusu.<verse eid="ECC 7:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ECC 7:21" />She vu ca ugbozu wa̱ wu suru</para>
  <para style="q2" vid="ECC 7:21">e ili i na ama a dansa wan,</para>
  <para style="q1" vid="ECC 7:21">u ta̱ gura wo'o vu uwwa agbashi a̱ wu</para>
  <para style="q2" vid="ECC 7:21">a̱ ta̱ isulusa wu.<verse eid="ECC 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ECC 7:22" />Adama a na a̱vu aciya̱wu vu reve ta̱ okolo a̱ wu</para>
  <para style="q2" vid="ECC 7:22">na̱ a̱bunda̱ vu tsu isula ta̱ ozo o ro.<verse eid="ECC 7:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="ECC 7:23" />N yuwan ta ulinga nu ugbozu u va̱, adama a na ma kurato ili i nda suru, a̱vu n damma,</para>
  <para style="q1" vid="ECC 7:23">&lt;&lt;N yuwan ta̱ majiyan ma na ma̱ da̱na̱ za vu ugbozu,&gt;&gt;</para>
  <para style="q2" vid="ECC 7:23">amma ili'i u la'a ta̱ ucira u va̱.<verse eid="ECC 7:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ECC 7:24" />Nden mu uvaɗi u ta̱ a̱ru'un lon,</para>
  <para style="q2" vid="ECC 7:24">ili yu usa̱n i mereve i ɗa.</para>
  <para style="q2" vid="ECC 7:24">Zane ɗa aa gura reve ili yu usokowu wa̱ yi?<verse eid="ECC 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ECC 7:25" />N vadala ta̱ n zuwa aciya̱va̱ a̱tsuma̱ e izami yu urevu,</para>
  <para style="q2" vid="ECC 7:25">n yuwan ibingi, n zami yu ugbozu,</para>
  <para style="q2" vid="ECC 7:25">nu usuwu u yeci i va̱,</para>
  <para style="q1" vid="ECC 7:25">a̱vu fo n reve tsulo tsi iwuya,</para>
  <para style="q2" vid="ECC 7:25">na̱ cine tsulo tsu ujaru tsa̱ a̱ ri.<verse eid="ECC 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ECC 7:26" />A̱vu n cina ili i na i la'ai ukwa̱ okono,</para>
  <para style="q2" vid="ECC 7:26">a̱yi ɗa ka na icigi ya̱ yi maza ma ɗa,</para>
  <para style="q1" vid="ECC 7:26">za na okolo a̱ yi igolo i ɗa</para>
  <para style="q2" vid="ECC 7:26">ukatalu we ekere a̱ yi tsa akani a ɗa.</para>
  <para style="q1" vid="ECC 7:26">Vuma na tsu yo'ono to A̱sula̱ ookolo</para>
  <para style="q2" vid="ECC 7:26">u ta la'a ekere a̱ yi.</para>
  <para style="q1" vid="ECC 7:26">Amma vuma na a yuwusan unusu</para>
  <para style="q2" vid="ECC 7:26">wa la'a ekere a̱ yi shi.<verse eid="ECC 7:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="ECC 7:27" />Ka̱lyuwa̱, ili i na n cinai, udammu wu za va a alajiya,</para>
  <para style="q1" vid="ECC 7:27">&lt;&lt;N da̱shishi ta̱ ili i ta̱ a̱ ya̱wa̱ a za va̱ ire</para>
  <para style="q2" vid="ECC 7:27">a̱vu n rito ili na̱ a̱bunda̱</para>
  <para style="q2" vid="ECC 7:27">adama n reve usuwu u yeci i va̱,<verse eid="ECC 7:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ECC 7:28" />u usuwu u na okolo a̱ va̱ a cigai,</para>
  <para style="q2" vid="ECC 7:28">agba n tsura̱i shi.</para>
  <para style="q1" vid="ECC 7:28">Ununa u dammu u ri a̱ yi ɗa,</para>
  <para style="q2" vid="ECC 7:28">&lt;N tsura̱ ta̱ vuma ta̱ za vu ugbozu goon,</para>
  <para style="q2" vid="ECC 7:28">a̱tsuma̱ ali ukpakukupa,</para>
  <para style="q1" vid="ECC 7:28">agba a̱tsuma̱ a̱ma̱ci suru</para>
  <para style="q2" vid="ECC 7:28">n tsura̱ ka ta̱ za vu ugbozu shi.&gt;<verse eid="ECC 7:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ECC 7:29" />Ka̱lyuwa̱, a̱yi nda ɗa goon n tsura̱i,</para>
  <para style="q2" vid="ECC 7:29">A̱sula̱ a yuwan ta̱ vaɗilima̱ no okolo a̱ mejege,</para>
  <para style="q2" vid="ECC 7:29">amma a̱vu tsu lungusa̱ aciya̱tsu.&gt;&gt;<verse eid="ECC 7:29" /></para>
  <chapter eid="ECC 7" />
  <chapter number="8" style="c" sid="ECC 8" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 8:1" />Zane ɗa ri tsa vuma na ri nu ugbozu?</para>
  <para style="q2" vid="ECC 8:1">Zane ɗa fo gura revei ucuɗuwu wi ili na̱ a̱bunda̱?</para>
  <para style="q1" vid="ECC 8:1">Ugbozu u tsu zuwa ta̱ urewesu u vuma u da̱na̱ a madala,</para>
  <para style="q2" vid="ECC 8:1">u tsu zuwa ta̱ fo urewesu</para>
  <para style="q2" vid="ECC 8:1">u na u ri ulukutu u yuwan ma̱za̱nga̱.<verse eid="ECC 8:1" /></para>
  <para style="s">Vu yuwaan Mogono tsutoni</para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 8:2" />Vu yuwan tsutoni nu udammu u mogono, adama a akucunu a na vu tarai a̱ ma̱ka̱ka̱n ma̱ A̱sula̱. <verse eid="ECC 8:2" /><verse number="3" style="v" sid="ECC 8:3" />She vu da̱na̱ e meje'en ma na va lyawa uba̱ta̱ u mogono wan. Waru she jima uba̱ta̱ u meleshe wan, adama a na mogono ma ta gura yuwan ili i na u cigai suru. <verse eid="ECC 8:3" /><verse number="4" style="v" sid="ECC 8:4" />Ana wo o'woi adanshi o mogono a̱ ta̱ nu ucira lon, za ne ɗa aa gura damma yi, &lt;&lt;Nye vaa yuwusan?&gt;&gt; <verse eid="ECC 8:4" /><verse number="5" style="v" sid="ECC 8:5" />Za na suru yuwain tsutoni nu u dammu u mogono, wa̱a̱ da̱na̱ ee meleshe shi, amma okolo a za vu ugbozu, ta̱ reve cine wa yuwan ili, a mantsa ma na wuntsayi a yuwain. <verse eid="ECC 8:5" /><verse number="6" style="v" sid="ECC 8:6" />Adama a na ili suru, i tsu da̱na̱ ta̱ na̱ mantsa ma̱ yi, nu ure wa̱ yi,</para>
  <para style="q2" vid="ECC 8:6">ko na wo o'woi a̱tsuma̱lima̱ a vaɗilima̱, a̱ a̱bunda̱ a ɗa u ri lon.<verse eid="ECC 8:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ECC 8:7" />Amayun, babu za na revei ili i na yaa fara,</para>
  <para style="q2" vid="ECC 8:7">adama a na za ne ɗa a damma yi, ili i na i ri lo elime?<verse eid="ECC 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 8:8" />Babu za na ri nu ucira e ekere a̱ wivuwun wa̱ yi,</para>
  <para style="q2" vid="ECC 8:8">babu waru za na ri nu ucira, adama o urana u na wa̱ kuwa̱.</para>
  <para style="q1" vid="ECC 8:8">Ununa u ri, babu za na ri nu ucira u na waa lyawa uvon,</para>
  <para style="q2" vid="ECC 8:8">babu za vi iwuya na a la'a, o ure wi iwuya ya̱ yi.<verse eid="ECC 8:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="ECC 8:9" />Me ene ta̱ ili i ndolo suru, a mantsa ma na n da̱na̱i a majiyan, me ili i na maa yuwan pe a̱tsuma̱ o uvaɗi u nda. Me ene ta̱ nanza na ri nu ucira a aci ozo o ro, amma reve ucira'a u ka̱mba̱ u palaa yi.<verse eid="ECC 8:9" /></para>
  <para style="s">Re va̱ A̱sula̱ a̱ ta̱ usa̱n u mereve</para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 8:10" />A̱vu waru me ene, a̱ ciɗosu a̱za̱ e iwuya, a za na a tsu uwusa na̱ o utusa̱i, a̱tsuma̱ o uba̱ta̱ wa akiza, a tsu yuwaan le ta̱ ica, a̱tsuma̱ e iɗa i na a yuwain iwuya i ndolo. Ili ya̱ ndolo fo ili ya̱ pere i ɗa.<verse eid="ECC 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 8:11" />Adama a na a̱ tsa̱ a̱ jika̱ a na a paɗa ugana uba̱ta̱ wa aza a na aa yuwusan iwuya shi, u zuwa ta̱ okolo ama a̱ da̱na̱ tapu ni iwuya, na̱ majiyan ma na aa yuwan iwuya. <verse eid="ECC 8:11" /><verse number="12" style="v" sid="ECC 8:12" />Ko na wo o'woi za vi iwuya tsu yuwan ta̱ iwuya a̱ tyo ukpaku, a̱vu waru u jima a̱tsuma̱ o uvaɗi, na̱ ne suru n reve ta̱ n na̱ vuma ri na̱ wovon wa̱ A̱sula̱, waru a casu yi tsugbain, ili suru i ta wala yi mejege. <verse eid="ECC 8:12" /><verse number="13" style="v" sid="ECC 8:13" />Amma n reve ta̱ a za a na aa yuwusan iwuya a̱a̱ da̱na̱ na asuvu nden shi, a̱ ta̱ tsu ululu, a jima a̱tsuma̱ o uvaɗi shi, adama a na a̱ ri na̱ wovon wa̱ A̱sula̱ shi.<verse eid="ECC 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 8:14" />Ka̱lyuwa̱, ili ya̱ pere i na yaa farasa a̱tsuma̱ o uvaɗi. Ili i na i tsu cina a̱za̱ a̱ a̱ɓula̱, she damma ele a̱za̱ e iwuya a ɗa, ili i na waru i tsu cina a̱za̱ e iwuya, she damma ele ama a̱ɓula̱ a ɗa. N damma ta̱ fo ili ya̱ ndolo ili ye pere i ɗa. <verse eid="ECC 8:14" /><verse number="15" style="v" sid="ECC 8:15" />Adama o ndolo, n damma ta̱ u tu ulobonu vuma uwwa uyo'o u wuma wa̱ yi, adama a na babu ili i ro a̱tsuma̱ a wuma wu uvaɗi u nda, na la'ai vuma lyuwa a̱vu u sowo, waru wu uwwa uyo'o u wuma wa̱ yi. A̱yi ndolo fo u ta kamba yi suru a̱tsuma̱ o ulinga wa̱ yi, a wuma wa̱ yi na A̱sula̱ a ca niyi a̱tsuma̱ o uvaɗi u nda.<verse eid="ECC 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 8:16" />N yuwan ta̱ majiyan ma na ma̱ da̱na̱ za vu ugbozu, waru n gura reve ili i na yaa farasa a̱tsuma̱ o uvaɗi u nda, waru n ca esu a̱ va̱ nlavu shi urana na ayin. <verse eid="ECC 8:16" /><verse number="17" style="v" sid="ECC 8:17" />A̱vu me ene suru ulinga u na A̱sula̱ a yuwain, a̱vu n gura reve babu vuma na gura revei, ili i na yaa farasa a̱tsuma̱ aa wuma wu uvaɗi u nda. Na̱ a̱bunda̱ o ukadu wi izami ya̱ yi biti, waa gura tsura̱ ili i ro shi. Ko na̱ shi u tara aciya̱yi za vu ugbozu ɗa, za na ri nu urevu, na̱ ne suru waa gura tsura̱ ili i ro shi.<verse eid="ECC 8:17" /></para>
  <chapter eid="ECC 8" />
  <chapter number="9" style="c" sid="ECC 9" />
  <para style="s">Ukosu wu za suru ukwa̱ u ɗa</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1" />Amayun, n jima ta̱ aa yuwusan majiyan me ili i nda lon, a̱tsuma̱ okolo a̱ va̱, a̱vu fo m petelyuwe ili i nda, me ene cine a̱za̱ a̱ a̱ɓula̱, na̱ a̱za̱ o ugbozu, na̱ linga le suru, a̱ ta̱ o ukere wa̱ A̱sula̱. Hali fo ni icigi i le, ni ima̱ i le. Babu za na revei ili i na yaa cina le nda elime. <verse eid="ECC 9:1" /><verse number="2" style="v" sid="ECC 9:2" />Babu ili i na i tawai ko'o, ili i ta̱ i ɗa suru yaa cina za. E ekere a za̱ va̱ a̱ɓula̱ na̱ za vi iwuya, na̱ za vi sa'ani na̱ za babu isa'ani, na̱ za cece na̱ za vi idaba, na̱ za na a casu kucci, na̱ za na tsu ca kucci shi.</para>
  <para style="q1" vid="ECC 9:2">Za va̱ a̱ɓula̱,</para>
  <para style="q2" vid="ECC 9:2">la'a za vu unusu shi.</para>
  <para style="q1" vid="ECC 9:2">Za na tsu tara akucunu,</para>
  <para style="q2" vid="ECC 9:2">la'a za na tsu 'yuwan a tara akucunu shi.<verse eid="ECC 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 9:3" />A̱yi nda a̱ yi ɗa iwuya i na yaa farasa a̱tsuma̱ o uvaɗi u nda, ukosu wu za suru ili i ta̱ i ɗa. Na̱ ne suru okolo a vaɗilima̱, tapu ɗa u ri ni iwuya, waru a̱ ta̱ nu ulungusu okolo e le, a mantsa ma na a̱ ri wuma. A̱ tyo o ukosu waru, reve a̱ kuwa̱. <verse eid="ECC 9:3" /><verse number="4" style="v" sid="ECC 9:4" />Amma za na ri a̱tsuma̱ a za a wuma biti, u tu nu uzuwu wo okolo a̱ tyo elime, adama a na u la'a ta̱ na̱ musa̱n ma na ma̱ ri wuma, na̱ a̱kwa̱kwa̱ a kamu!<verse eid="ECC 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 9:5" />Adama a na aza a na a̱ ri wuma</para>
  <para style="q2" vid="ECC 9:5">e reve ta̱ na a̱ ta̱ kuwa̱,</para>
  <para style="q2" vid="ECC 9:5">amma a za na a̱ kuwa̱i ɗe e reve ili i ro shi.</para>
  <para style="q1" vid="ECC 9:5">A̱ ri na atsupu o ro waru shi,</para>
  <para style="q2" vid="ECC 9:5">waru a̱ da̱shi cuwan ne le shi.<verse eid="ECC 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 9:6" />Icigi i le, ni i ima̱ i le, na̱ tsushu'un tsa̱ le</para>
  <para style="q2" vid="ECC 9:6">a̱ kuwa̱ ta̱ oɓolo ne le.</para>
  <para style="q1" vid="ECC 9:6">A̱ da̱shi waru yuwan ili i na a yuwusan,</para>
  <para style="q2" vid="ECC 9:6">a̱tsuma̱ a wuma wu uvaɗi u nda shi.<verse eid="ECC 9:6" /></para>
  <para style="s">Wuma u ta̱ mokoɗi</para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 9:7" />Ka̱ra̱, vu yuwan mmalu ma̱ wu, vu uwwa uyo'o wi ilyalya ya̱ wu, vu sowo masayan ma ina̱bi ma̱ wu na̱ ma̱za̱nga̱. Adama a na ili ya̱ ndolo a̱ yi ɗa ifoɓi i na A̱sula̱ a yuwaan nuwu. <verse eid="ECC 9:7" /><verse number="8" style="v" sid="ECC 9:8" />Mantsa suru oto itana i u ri, she vu lyawa aci a̱ wu a kasa na̱ mani'i wan. <verse eid="ECC 9:8" /><verse number="9" style="v" sid="ECC 9:9" />Vu uwwa uyo'o u wuma wa̱ wu na̱ ka na vu ucigai, a̱tsuma̱ rana ve pere na A̱sula̱ a ca nuwu a̱tsuma̱ a wuma wu uvaɗi u nda suru, adama a na mawwa mo uyo'o u nda, a̱ yi ɗa goon iliyinkapa ya̱ wu yu ulinga u na vu yuwain a̱tsuma̱ o uvaɗi u nda. <verse eid="ECC 9:9" /><verse number="10" style="v" sid="ECC 9:10" />Ili i na suru vu tsura̱i naa va yuwan, vu yuwain nu ucira wa̱ wu suru, adama a na babu ulinga, ko majiyan, ko urevu, ko ugbozu uba̱ta̱ wu nden ma̱ a̱kwa̱kwa̱ uba̱ta̱ u na va̱a̱ 'ya̱wa̱.<verse eid="ECC 9:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="ECC 9:11" />Me ene ta̱ ili i ro a̱tsuma̱ a wuma wu uvaɗi u nda, ashe,</para>
  <para style="q1" vid="ECC 9:11">mantsa suru ɗa za na gurai ilaɗi lon,</para>
  <para style="q2" vid="ECC 9:11">tsu lyuwa ala'anlai shi,</para>
  <para style="q1" vid="ECC 9:11">mantsa suru ɗa za na ri nu ucira</para>
  <para style="q2" vid="ECC 9:11">tsu lyuwa uvon shi,</para>
  <para style="q1" vid="ECC 9:11">mantsa suru ɗa za vu ugbozu</para>
  <para style="q2" vid="ECC 9:11">tsu tsura̱ ilyalya shi,</para>
  <para style="q1" vid="ECC 9:11">mantsa suru ɗa za na ri nu urevu</para>
  <para style="q2" vid="ECC 9:11">tsu oɓoloto utsuru shi,</para>
  <para style="q1" vid="ECC 9:11">mantsa suru ɗa za na gurai</para>
  <para style="q2" vid="ECC 9:11">a̱ yi ɗa u tsu tsura̱ icigi shi.</para>
  <para style="q1" vid="ECC 9:11">Amma mantsa nu ulyuwu we elime</para>
  <para style="q2" vid="ECC 9:11">i tsu cina ta̱ koyan a̱tsuma̱ e le.<verse eid="ECC 9:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ECC 9:12" />Adama a na vuma tsu reve mantsa ma̱ yi shi.</para>
  <para style="q1" vid="ECC 9:12">Tsa magula ma na a tsu reme</para>
  <para style="q2" vid="ECC 9:12">a̱tsuma̱ e igolo,</para>
  <para style="q1" vid="ECC 9:12">ko tsu nnunu n na a tsu reme</para>
  <para style="q2" vid="ECC 9:12">a̱tsuma̱ a maza,</para>
  <para style="q1" vid="ECC 9:12">ne ɗa fo a̱ tsu reme vaɗilima̱ babu urevu</para>
  <para style="q2" vid="ECC 9:12">a mantsa ma addama.<verse eid="ECC 9:12" /></para>
  <para style="s">Ugbozu u la'a ta̱ tsulo</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13" />N gura ta̱ ene ili i na moo rito adama o ugbozu a̱tsuma̱ a wuma wu uvaɗi u nda, e ekere a̱ va̱ ili i gbain i ɗa. <verse eid="ECC 9:13" /><verse number="14" style="v" sid="ECC 9:14" />A yuwan ta̱ lyuci ke'en ro, ama na a̱ ri pe ke'en ɗa a̱ ri. A̱vu mogono ma gbain mo ro ma̱a̱ ta̱wa̱a̱ yi nu uvon, a̱vu waru u ka̱nda̱ruwa̱ lyuci'i, a̱vu u suwa ili i na a kumba o ukari adama o uvon. <verse eid="ECC 9:14" /><verse number="15" style="v" sid="ECC 9:15" />A̱tsuma̱ a̱ lyuci'i a yuwan ta̱ za vu ulambu ro na da̱na̱i nu ugbozu, za na adama o ugbozu wa̱ yi u wawai lyuci'i. Na̱ ne suru babu za na cuwain na̱ za vu ulambu u ndolo'o. <verse eid="ECC 9:15" /><verse number="16" style="v" sid="ECC 9:16" />A̱vu n damma, &lt;&lt;Ugbozu u la'a ta̱ ucira ulinga.&gt;&gt; Amma o goro ta̱ ugbozu wu za vu ulambu u ndolo, a̱ da̱shi a cuwan na adanshi a̱ yi waru shi.<verse eid="ECC 9:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ECC 9:17" />U ta la'a na a uwwa adanshi e ben a za vu ugbozu,</para>
  <para style="q2" vid="ECC 9:17">a na a uwwa yisali yi za tsugbain e memere mo olo.<verse eid="ECC 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 9:18" />U la'a ta̱ a̱ tsura̱ ugbozu</para>
  <para style="q2" vid="ECC 9:18">a na a̱ tsura̱ itana yu uvon,</para>
  <para style="q1" vid="ECC 9:18">amma za vu unusu tsu lungusa̱ ta̱</para>
  <para style="q2" vid="ECC 9:18">ili yu ulobonu ya̱ a̱bunda̱.<verse eid="ECC 9:18" /></para>
  <chapter eid="ECC 9" />
  <chapter number="10" style="c" sid="ECC 10" />
  <para style="s">Ili i na a̱a̱ ka̱mbuwa̱a̱ ugbozu</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 10:1" />Ununa a̱kwa̱kwa̱ a ayun</para>
  <para style="q2" vid="ECC 10:1">a tsu zuwa mani'i ma ma̱guru ma yuwan ushamu,</para>
  <para style="q1" vid="ECC 10:1">ne ɗa fo tsulo ke'en</para>
  <para style="q2" vid="ECC 10:1">ma̱ tsu lungusa̱ ugbozu na̱ tsugbain.<verse eid="ECC 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 10:2" />Ookolo aza vu ugbozu u tsu zuwai ta̱</para>
  <para style="q2" vid="ECC 10:2">u yuwan ili i na i ri mejege,</para>
  <para style="q1" vid="ECC 10:2">amma okolo o ulo u tsu zuwai ta̱</para>
  <para style="q2" vid="ECC 10:2">u yuwan ili i na i ri babu ulobonu.<verse eid="ECC 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 10:3" />Ulo, ko a̱tsuma̱ a mmalu o ure,</para>
  <para style="q2" vid="ECC 10:3">u tsu roco ta̱ a na a̱yi u ri nu ugbozu shi,</para>
  <para style="q2" vid="ECC 10:3">waru u tsu roco ta̱ za suru, na a̱yi ulo u ɗa.<verse eid="ECC 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 10:4" />Nna̱ upan wu za tsugono 'yon aciya̱wu,</para>
  <para style="q2" vid="ECC 10:4">she vu jika̱ vu lyawa uba̱ta̱ u na vu ri wan,</para>
  <para style="q1" vid="ECC 10:4">adama a na uvotowun wo ookolo,</para>
  <para style="q2" vid="ECC 10:4">u tsu zuwa ta̱ a yuwan gafura vu unusu u gbain.<verse eid="ECC 10:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ECC 10:5" />Iwuya i ro i ta̱ lo a na me enei,</para>
  <para style="q2" vid="ECC 10:5">a̱tsuma̱ a wuma wu uvaɗi u nda,</para>
  <para style="q2" vid="ECC 10:5">a̱ba̱jini o unusu u na a̱za̱ a̱ tsugono a tsu yuwan,<verse eid="ECC 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 10:6" />a tsu ca ta̱ olo tsugbain tsa gbain gbain,</para>
  <para style="q2" vid="ECC 10:6">aza a na a̱ ri nu utsuru waru</para>
  <para style="q2" vid="ECC 10:6">a̱vu a ca le ba̱ta̱ na ri na̱ a̱ɓula̱ shi.<verse eid="ECC 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 10:7" />Me ne ta̱ ɗe agbashi zuva vi ido,</para>
  <para style="q2" vid="ECC 10:7">muwun mogono a mmalu ana tsa agbashi.<verse eid="ECC 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 10:8" />Za na ka̱pa̱i a̱ka̱ri e iwuya</para>
  <para style="q2" vid="ECC 10:8">a̱yi ɗa wa̱a̱ riya̱ pe,</para>
  <para style="q1" vid="ECC 10:8">za na ɓuɓoso yi ukari,</para>
  <para style="q2" vid="ECC 10:8">a̱yi ɗa yo a̱ ka̱ɗa̱.<note caller="-" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="PSA 7:15">Ica 7:15</ref>; <ref loc="PRO 26:27">Udm 26:27</ref>.</char></note><verse eid="ECC 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 10:9" />Za na ɓuɓoso yi atali,</para>
  <para style="q2" vid="ECC 10:9">ele ɗa a̱ tsu amaton yi,</para>
  <para style="q1" vid="ECC 10:9">za na ɓuɓatsa yi ɗanga,</para>
  <para style="q2" vid="ECC 10:9">ele ɗa a̱ tsu ronoo yi usa̱n.<verse eid="ECC 10:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ECC 10:10" />Nna̱ una̱ wo aɓau u ri ulya shi,</para>
  <para style="q2" vid="ECC 10:10">waru e tewen una̱'a̱ shi,</para>
  <para style="q1" vid="ECC 10:10">she nu ukadu lon ɗa a yuwan ulinga na̱ yi,</para>
  <para style="q2" vid="ECC 10:10">amma ugbozu u tsu ta̱wa̱a̱ ta̱ nu ulyuwu wa aci.<verse eid="ECC 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 10:11" />Nna̱ yo ka̱ɗa̱ vuma babu na a ca niyi gitsutsu,</para>
  <para style="q2" vid="ECC 10:11">nye ɗa ya̱a̱ da̱na̱ ulinga u gitsutsu'u?<verse eid="ECC 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ECC 10:12" />Adanshi a na za vu ugbozu dammai,</para>
  <para style="q2" vid="ECC 10:12">u tsu ta̱wa̱ yi ta̱ ni icigi lon.</para>
  <para style="q1" vid="ECC 10:12">Amma adanshi a na a̱ tsu utusa̱ diga o una̱ wu ulo,</para>
  <para style="q2" vid="ECC 10:12">u tsu kototo yi ta̱.<verse eid="ECC 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 10:13" />Ufaru wa adanshi o una̱ wa̱ yi tsulo tsa ɗa,</para>
  <para style="q2" vid="ECC 10:13">ukosu wa adanshi a̱ yi waru iwuya iɗa nu ujaru.<verse eid="ECC 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 10:14" />Na̱ ne suru ulo u tsu da̱na̱ ta̱ adanshi a̱bunda̱.</para>
  <para style="b" vid="ECC 10:14" />
  <para style="q1" vid="ECC 10:14">Babu za na revei ili i na yaa fara,</para>
  <para style="q2" vid="ECC 10:14">zane ɗa aa gura damma nanza nda ili i na yaa fara nda elime?<verse eid="ECC 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ECC 10:15" />Ulinga wu ulo u tsu kuna̱to yi ta̱</para>
  <para style="q2" vid="ECC 10:15">a na wo o'woi tsulo tsa̱ yi</para>
  <para style="q2" vid="ECC 10:15">tsa̱ ɓa̱ru yi ta̱ esu.<verse eid="ECC 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ECC 10:16" />Woo yo'ono wu shi,</para>
  <para style="q2" vid="ECC 10:16">a̱vu iɗa i na mogono ma̱ wu mawun ma ɗa,</para>
  <para style="q2" vid="ECC 10:16">a̱vu na azagbain a̱ wu a yuwusan a̱buki lo nu usana!<verse eid="ECC 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 10:17" />A̱vu za ma̱za̱nga̱ ɗa,</para>
  <para style="q2" vid="ECC 10:17">a̱vu iɗa i na mogono ma̱ wu abara a ɗa,</para>
  <para style="q1" vid="ECC 10:17">a̱vu na azagbain a̱ wu a tsu yuwan a̱buki</para>
  <para style="q2" vid="ECC 10:17">a mantsa ma na wuntsayi,</para>
  <para style="q2" vid="ECC 10:17">adama tsura̱ ucira wan, ko a̱ da̱na̱ u tsura̱to wu wan.<verse eid="ECC 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 10:18" />Nna̱ vuma ri na̱ a̱ɓula̱ shi,</para>
  <para style="q2" vid="ECC 10:18">u tsu zuwa ta̱ ɗanga vu ukwa̱'a̱ a̱ da̱na̱ e ilama,</para>
  <para style="q1" vid="ECC 10:18">nna̱ ekere a̱yi a yuwan ulinga shi,</para>
  <para style="q2" vid="ECC 10:18">ukwa̱'a̱ u tsu da̱na̱ ta̱ a uwusa mini.<verse eid="ECC 10:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="ECC 10:19" />O tsu foɓo ta̱ a̱buki adama a uwwa uyo'o,</para>
  <para style="q2" vid="ECC 10:19">masayan ma ina̱bi waru adama a yuwan mere,</para>
  <para style="q2" vid="ECC 10:19">ikebe waru adama a yuwan ili biti.<verse eid="ECC 10:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ECC 10:20" />She vu isula mogono ko a̱tsuma̱ okolo a̱ wu wan,</para>
  <para style="q2" vid="ECC 10:20">ko vu isula za vu utsuru uba̱ta̱ wu nven ma̱ wu wan,</para>
  <para style="q1" vid="ECC 10:20">adama a na u ta gura wo o'wo manunu mo ro</para>
  <para style="q2" vid="ECC 10:20">ma̱ 'ya̱wa̱ na adanshi a̱ wu,</para>
  <para style="q1" vid="ECC 10:20">ko ili ya̱ evelu i ro</para>
  <para style="q2" vid="ECC 10:20">i pa̱lu'wa̱ ili i na vu dammai.<verse eid="ECC 10:20" /></para>
  <chapter eid="ECC 10" />
  <chapter number="11" style="c" sid="ECC 11" />
  <para style="s">Ili i na za vu ugbozu tsu yuwan</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 11:1" />Vu ca nu ukere fa̱a̱n,</para>
  <para style="q2" vid="ECC 11:1">adama a na vu ta̱ ta̱wa̱ vu tsura̱i a rana vee elime.<verse eid="ECC 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 11:2" />Vu ne'eshe ili i na vu ri na̱ yi,</para>
  <para style="q2" vid="ECC 11:2">ba̱ta̱ cindere ko kunla̱,</para>
  <para style="q1" vid="ECC 11:2">adama a na vu reve cu'un meleshe</para>
  <para style="q2" vid="ECC 11:2">ma na ma̱a̱ riya̱a̱ uvaɗi u nda shi.<verse eid="ECC 11:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ECC 11:3" />A mantsa ma na eleshe a shunwai na̱ mini,</para>
  <para style="q2" vid="ECC 11:3">a̱ tsu ro'o ta̱ mini e iɗa,</para>
  <para style="q1" vid="ECC 11:3">mɓa̱nga̱ n na uɗanga u riya̱i, ko uyagi ko ugana,</para>
  <para style="q2" vid="ECC 11:3">uba̱ta̱ u na u riya̱i, lo ɗa u tsu von.<verse eid="ECC 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 11:4" />Za na suru ri e idanasa upepu,</para>
  <para style="q2" vid="ECC 11:4">wa yuwan ca̱'a̱n shi,</para>
  <para style="q1" vid="ECC 11:4">za na suru e idanasa eleshe,</para>
  <para style="q2" vid="ECC 11:4">wa yuwan ugasa shi.<verse eid="ECC 11:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ECC 11:5" />Cine vu revei ure wu upepu shi,</para>
  <para style="q2" vid="ECC 11:5">ko cine wuma u tsu uwa a̱ lipu mereɓu</para>
  <para style="q2" vid="ECC 11:5">a̱a̱tsuma̱ a mma va̱ yi shi,</para>
  <para style="q1" vid="ECC 11:5">ne ɗe fo vu reve ulinga wa̱ A̱sula̱ shi,</para>
  <para style="q2" vid="ECC 11:5">a̱yi na u yuwain ili biti.<verse eid="ECC 11:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ECC 11:6" />Vu yuwan ca̱'a̱n vi icu'un ya̱ wu nu usana,</para>
  <para style="q2" vid="ECC 11:6">nu ulivu she vu katala ekere a̱ wu wan,</para>
  <para style="q1" vid="ECC 11:6">adama a na vu reve za na a yuwan aba'un shi,</para>
  <para style="q2" vid="ECC 11:6">ko a̱yi nda, ko a̱yi ndeɗe,</para>
  <para style="q2" vid="ECC 11:6">ko waru suru nle a̱ da̱na̱ na a aba'un.<verse eid="ECC 11:6" /></para>
  <para style="s">Vu uwwa uyo'o u wuma vu cuwan na̱ A̱sula̱</para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 11:7" />Amayun ekan a̱ tu uyo'o,</para>
  <para style="q2" vid="ECC 11:7">ili yu ulobonu iɗa esu a̱ ka̱lyuwa̱ ekan yu urana.<verse eid="ECC 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 11:8" />Ko na̱ shi vuma yuwan a'wan a̱bunda̱,</para>
  <para style="q2" vid="ECC 11:8">lyawa wu uwwa uyo'o u le suru.</para>
  <para style="q1" vid="ECC 11:8">Lyawa u cuwan na̱ rana vi irumbu,</para>
  <para style="q2" vid="ECC 11:8">adama a na a̱ ta̱ a̱bunda̱ lon.</para>
  <para style="q2" vid="ECC 11:8">Ili i na i na i farai suru, ili ya̱ pere i ɗa.<verse eid="ECC 11:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ECC 11:9" />Vu yuwan ma̱za̱nga̱, a̱vu molobo a mantsa ma na vu ri a̱ tsulobo,</para>
  <para style="q2" vid="ECC 11:9">lyawa okolo a̱ wu a yuwan ma̱za̱nga̱</para>
  <para style="q2" vid="ECC 11:9">a rana wuma u tsulolobo tsa̱ a̱ wu.</para>
  <para style="q1" vid="ECC 11:9">Vu toni ure wo o okolo a̱ wu,</para>
  <para style="q2" vid="ECC 11:9">na̱ suru ili i na esu a̱ wu enei.</para>
  <para style="q1" vid="ECC 11:9">Amma vu reve, e ekere e ili nda suru,</para>
  <para style="q2" vid="ECC 11:9">A̱sula̱ a̱ ta̱ ge'eto wu.<verse eid="ECC 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 11:10" />Vu tawa cu'un vu udamu suru o okolo a̱ wu,</para>
  <para style="q2" vid="ECC 11:10">nu usa̱n diga a̱ lipu va̱ wu.</para>
  <para style="q1" vid="ECC 11:10">Adama a na tsulobo na̱ tsulolobo</para>
  <para style="q2" vid="ECC 11:10">ili ye pere i ɗa suru.<verse eid="ECC 11:10" /></para>
  <chapter eid="ECC 11" />
  <chapter number="12" style="c" sid="ECC 12" />
  <para style="q1">
    <verse number="1" style="v" sid="ECC 12:1" />Vu cuwan na̱ za na yuwan nuwu,</para>
  <para style="q2" vid="ECC 12:1">a rana tsulolobo tsa̱ a̱ wu,</para>
  <para style="q1" vid="ECC 12:1">babu na rana vi iwuya ta̱wa̱i,</para>
  <para style="q2" vid="ECC 12:1">waru aa'wan a̱ ta̱ ta̱wusa̱ zuzu a na va damma,</para>
  <para style="q2" vid="ECC 12:1">&lt;&lt;Maa uwusa uyo'o u le shi.&gt;&gt;<verse eid="ECC 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 12:2" />Babu na ekan o urana, ne ekan o woto</para>
  <para style="q2" vid="ECC 12:2">na̱ italyo'o yo o'wo irumbu,</para>
  <para style="q1" vid="ECC 12:2">eleshe waru e bete'we</para>
  <para style="q2" vid="ECC 12:2">a mantsa ma na o kotoi iro'i.<verse eid="ECC 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 12:3" />A mantsa mo ndolo ma ɗa ekere a̱ wu</para>
  <para style="q2" vid="ECC 12:3">a na aa yuwusan ipiri i lipu va̱ wu,</para>
  <para style="q2" vid="ECC 12:3">a uwa meje'en,</para>
  <para style="q2" vid="ECC 12:3">ana a̱ wu waru o to o'wo babu ucira</para>
  <para style="q1" vid="ECC 12:3">anga a̱ wu na a tsu ira ilyalya</para>
  <para style="q2" vid="ECC 12:3">o to o'wo ke'en, babu ulinga,</para>
  <para style="q1" vid="ECC 12:3">esu a̱ wu na vaa yuwusaan a̱ka̱nla̱</para>
  <para style="q2" vid="ECC 12:3">a̱ ta̱ rumba̱na̱.<verse eid="ECC 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 12:4" />A mantsa'a va uwwa ilama o ure shi,</para>
  <para style="q2" vid="ECC 12:4">ilama i yira fo, va uwwa yi lon shi,</para>
  <para style="q2" vid="ECC 12:4">uɗyo wi ishipa fo, ili yu usa̱n i ɗa na va uwwa le.</para>
  <para style="q1" vid="ECC 12:4">Amma mesun ma manunu</para>
  <para style="q2" vid="ECC 12:4">ma ta gura 'ya̱sa̱n wu a̱tsuma̱ a nlavu.<verse eid="ECC 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 12:5" />Na amayun vu ta uwwa wovon</para>
  <para style="q2" vid="ECC 12:5">wi ili i na i ri uga'an,</para>
  <para style="q2" vid="ECC 12:5">mmalu a̱tsuma̱ o ure u ta̱ ta̱wa̱ wu na̱ wovon.</para>
  <para style="q1" vid="ECC 12:5">Tsa̱ yipa̱lu yu uɗanga wa almon</para>
  <para style="q2" vid="ECC 12:5">a̱nji aaci a̱ wu a ta yuwan yono.</para>
  <para style="q1" vid="ECC 12:5">Tsa apapari a na a kutsai,</para>
  <para style="q2" vid="ECC 12:5">vu ta̱ rono ana adama a mmalu,</para>
  <para style="q1" vid="ECC 12:5">Cu'un maluwa ma̱ lipu biti</para>
  <para style="q2" vid="ECC 12:5">ma̱ ta̱ koto.</para>
  <para style="q1" vid="ECC 12:5">Diga lo she a̱ tyo o u'wa u na u ri hali hali,</para>
  <para style="q2" vid="ECC 12:5">aza na a̱ ri a̱ mesun a̱ ta̱ da̱na̱ a̱ 'ya̱wusa̱ na̱ a̱ ka̱mbi a̱tsuma̱ a̱ re.<verse eid="ECC 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 12:6" />Vu cuwan na̱ za na yuwan nuwu</para>
  <para style="q2" vid="ECC 12:6">babu na amunga a azurufa aa taɓa,</para>
  <para style="q2" vid="ECC 12:6">ko aakwanu a zinariya oo ɓoso,</para>
  <para style="q1" vid="ECC 12:6">ko medele mo ɓoso o una̱ u lyusu mini,</para>
  <para style="q2" vid="ECC 12:6">ko amunga o morono ma̱ mini ma taɓa</para>
  <para style="q2" vid="ECC 12:6">o una̱ wo oko'o.<verse eid="ECC 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 12:7" />Ma̱buta̱ waru ma̱ ka̱mba̱ ma̱bula̱ cine u shi nu ufaru,</para>
  <para style="q2" vid="ECC 12:7">wuma waru u ka̱mba̱ uba̱ta̱ wa̱ A̱sula̱ za na yuwan niyi.<verse eid="ECC 12:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ECC 12:8" />&lt;&lt;Ili ya̱ pere i ɗa! Ili suru Ili ya̱ pere i ɗa!&gt;&gt;</para>
  <para style="q2" vid="ECC 12:8">O udammu wu za va alajiya,</para>
  <para style="q2" vid="ECC 12:8">&lt;&lt;Ili suru ili ya̱ pere i ɗa!&gt;&gt;<verse eid="ECC 12:8" /></para>
  <para style="s">Ukosu wu udammu suru</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9" />Adama a na za va alajiya da̱na̱i za vu ugbozu, a̱vu u roco ama urevu. U petelyuwe ta̱, a̱vu fo u bunga̱, reve u foɓo udammu wa adanshi na̱ a̱bunda̱. <verse eid="ECC 12:9" /><verse number="10" style="v" sid="ECC 12:10" />Za va alajiya'a u zami ta̱ adanshi a na a̱ ri uyo'o u mawwa, a̱vu u ɗana adanshi amayun mejege. <verse eid="ECC 12:10" /><verse number="11" style="v" sid="ECC 12:11" />Adanshi a ama a na a̱ ri nu ugbozu a̱ ta̱ tsa aɗanga a aguɓa, adanshi'i a̱ ta̱ da̱na̱ cine ikusa i tsu da̱na̱ wu sapu a aaɗanga a aguɓa. Adanshi a nda'a za va aguɓa a̱ ta̱ a ɗa oɓoloto n le.<verse eid="ECC 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 12:12" />Vu yuwan ugbozu, ulobo u va̱, adama a na ulinga u maɗana ma atagada ma̱ ri nu ukosu shi, waru a̱bunda̱ a̱ ɗewu nu una̱ a̱ tsu kuna̱to ta̱ vuma.<verse eid="ECC 12:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="ECC 12:13" />Ana a uwwai ili yo ndolo suru,</para>
  <para style="q2" vid="ECC 12:13">apa ukosu wa adanshi'i,</para>
  <para style="q1" vid="ECC 12:13">vu uwwa wovon wa̱ A̱sula̱, vu yuwan tsutoni nu udammu wa̱ yi,</para>
  <para style="q2" vid="ECC 12:13">adama a na a̱ yi nda goon a̱yi ɗa ulinga u vuma.<verse eid="ECC 12:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 12:14" />Adama a na A̱sula̱ a̱ ta̱ ge'eto cu'un vu ulinga suru,</para>
  <para style="q2" vid="ECC 12:14">ko usokowu ɗa a yuwan niyi,</para>
  <para style="q2" vid="ECC 12:14">ko za sa'ani ɗa, ko iwuya ɗa.<verse eid="ECC 12:14" /></para>
  <chapter eid="ECC 12" />
</usx>