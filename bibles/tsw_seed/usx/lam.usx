<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LAM" style="id">- Tsishingini (tsw)</book>
  <para style="h">Mesun</para>
  <para style="toc3">Mes</para>
  <para style="toc2">Mesun</para>
  <para style="toc1">Mesun</para>
  <para style="mt2">Mesun</para>
  <para style="mt1">Mesun</para>
  <para style="is">Ucuɗuwu wa aatagada a nda</para>
  <para style="ip">Kafu a matsan Yesu, a̱ da̱na̱ ta̱ nu uzuwu wo okolo a na za mesu'un a̱yi ɗa vumava̱sula̱ Irimiya. Aatagada a̱ mesu'un ma nda'a u tara ta̱ ishipa ya̱ a̱tsumola̱ngu a̱ na̱shi adama o ukototosu wa̱ Urishelima a na a rawai a'wan ukpaku kupoton nu ukpakuta̱li na̱ a̱za̱ ta̱li (586) kafu limatan va̱ Yesu, na̱ cine lyuci'i wo o'woi okongo oɓolo na̱ cine a tarai ama'a a̱ tyo tsugbashi. Ana o kotoi mesun ejere wu ufaru, a̱ da̱na̱ ta̱ ni ishipa yi za mesun aciya̱yi, kafu ishipa ya ta'atsu na̱ za va̱ na̱shi. Ko na wo o'woi aatagada a nda o roco ta̱ wuma wa̱ a̱tsumola̱ngu, na̱ ne suru, uzuwu wo okolo u tu uba̱ta̱ wa̱ A̱sula̱ oɓolo nu uzuwu wo okolo a̱ tyo nda elime. A̱tsuma̱ e idanshi i na i ri pe a̱tsuma̱ a aatagada a nda'a u ta̱ na̱ a̱ka̱nla̱ oɓolo na̱ mene. Mantsa na̱ a̱bunda̱ za na ri a̱tsumola̱ngu u tsu ɗe ta̱ A̱sulazuva a̱ ka̱lyuwa̱ a̱tsuma̱lima̱ a̱ yi, adama a na nɗa n ta̱ e nda ataɓu a̱ Sihiyona, za na A̱sulazuva e ɗesu Usheli Okolo a̱ va̱. Aza a Yahuda a ta yuwusan ulinga na̱ mesun ma nda'a a̱tsuma̱ a̱ a̱ga̱nda̱ a rana va akuli e le, na̱ rana va̱ a̱tsumola̱ngu adama a na a cuwan na addama a na a̱ ri a̱tsuma̱ e iɗa i le. Na̱ Tsuheleni, uguzu wi ishipa biti u teme ta̱ ni idanshi i ta̱ a̱tsuma̱ o ugeru wi idanshi wi idana yee elentsu'un. Uɗyo u tsuwe'e wi ishipa'a uɗyo u ɗa ko'o wi ishipa ya̱ a̱tsumola̱ngu.</para>
  <para style="iot">Ili i na i ri pe a̱tsuma̱ a aatagada a nda</para>
  <para style="io1">Ishipa ya̱ a̱tsumola̱ngu wu ufaru: A̱tsumola̱ngu a̱ Sihiyona 1:1-22</para>
  <para style="io1">Ishipa ya̱ a̱tsumola̱ngu wa̱ ire: Uge'etosu wa̱ Urishelima 2:1-22</para>
  <para style="io1">Ishipa ya̱ a̱tsumola̱ngu wa ta'atsu: Mesun ma za va̱ a̱tsuma̱lima̱ na̱ mazuwa mo okolo ma̱ a̱ yi 3:1-66</para>
  <para style="io1">Ishipa ya̱ a̱tsumola̱ngu wa̱ na̱shi: Cina Urishelima riya̱ 4:1-22</para>
  <para style="io1">Ishipa ya̱ a̱tsumola̱ngu wa tawun: Avasa adama o ulapulu wu nden 5:1-22.</para>
  <chapter number="1" style="c" sid="LAM 1" />
  <para style="s">A̱tsumola̱ngu a Sihiyona</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 1:1" />O'o! O'o!</para>
  <para style="b" vid="LAM 1:1" />
  <para style="q1" vid="LAM 1:1">A̱vu lyuci na shi tapu na ama,</para>
  <para style="q2" vid="LAM 1:1">gogo vo o'wo ta̱ babu vuma.</para>
  <para style="q1" vid="LAM 1:1">A̱vu na vu shi egbere a̱tsuma̱ a nɗa</para>
  <para style="q2" vid="LAM 1:1">gogo vo o'wo ta̱ a̱ nde'en tsa̱ ma̱runa̱.</para>
  <para style="q1" vid="LAM 1:1">A̱vu na vu shi egbere e ilyuci vu pasu tsugono suru,</para>
  <para style="q2" vid="LAM 1:1">gogo vo o'wo ta̱ aagbashi.<verse eid="LAM 1:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2" />Na ayin u tsu shosun ta̱ lon,</para>
  <para style="q2" vid="LAM 1:2">aɓara a̱ yi oo ocusho a agbaguzu a̱ yi.</para>
  <para style="q1" vid="LAM 1:2">A̱tsuma̱ a aza a na a ciga niyi suru</para>
  <para style="q2" vid="LAM 1:2">ko za lo na aa ca yi adanshi shi.</para>
  <para style="q1" vid="LAM 1:2">N'utsa̱ ma̱ yi suru n wina yi ta̱</para>
  <para style="q2" vid="LAM 1:2">reve o o'wo n'yuwatan ma̱ yi.<verse eid="LAM 1:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3" />A̱ pura̱ ta̱ Yahuda a̱ ka̱ra̱,</para>
  <para style="q2" vid="LAM 1:3">a̱tsuma̱ e iɓongi na̱ tsugbashi tsa̱ a̱tsuma̱lima̱.</para>
  <para style="q1" vid="LAM 1:3">U ta̱ nden a̱tsuma̱ a nɗa mo omocin</para>
  <para style="q2" vid="LAM 1:3">agba u ri nu uba̱ta̱ u wivuwun shi.</para>
  <para style="q1" vid="LAM 1:3">Aza a na aa saɓusa yi suru a cina yi ta̱</para>
  <para style="q2" vid="LAM 1:3">e memere ma̱ a̱tsuma̱lima̱ ma̱ yi</para>
  <para style="q2" vid="LAM 1:3">agba u ri nu ula'atan shi.<verse eid="LAM 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4" />Re va̱ Sihiyona kima̱ ta̱,</para>
  <para style="q2" vid="LAM 1:4">adama a na ko vuma ta̱wa̱</para>
  <para style="q2" vid="LAM 1:4">uba̱ta̱ wa̱ a̱buki a̱ yi a na a zuwai shi.</para>
  <para style="q1" vid="LAM 1:4">Na̱ntsu va̱ yi suru vo o'wo ta̱ lya̱nga̱,</para>
  <para style="q2" vid="LAM 1:4">nan ganu a̱yi suru e te i'wan.</para>
  <para style="q1" vid="LAM 1:4">Esheli a̱ yi suru e te mesun,</para>
  <para style="q2" vid="LAM 1:4">a̱yi aciya̱yi u ta̱ a̱tsuma̱ a̱tsuma̱lima̱ lon.<verse eid="LAM 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5" />N'yuwatan ma̱ yi mo o'wo ta̱ azagbain a̱ yi,<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="DEU 28:44">U.Wl 28:44</ref>.</char></note></para>
  <para style="q2" vid="LAM 1:5">reve waru n'yuwatan ma̱ yi n lyuwa elime,</para>
  <para style="q1" vid="LAM 1:5">adama a na A̱sulazuva a ca ta̱ Urishelima oforo</para>
  <para style="q2" vid="LAM 1:5">adama a̱ a̱bunda̱ a̱ nusu va̱ yi.</para>
  <para style="q1" vid="LAM 1:5">N'yuwatan n reme ta̱ muwun ma̱ yi</para>
  <para style="q2" vid="LAM 1:5">reve a̱ pura̱ le a̱ tyo tsugbashi.<verse eid="LAM 1:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6" />Ulobonu wa̱ Sihiyona suru</para>
  <para style="q2" vid="LAM 1:6">wu kasa ta̱ na̱ a̱yi.</para>
  <para style="q1" vid="LAM 1:6">Ngono ma̱ yi suru o rotso ta̱ nre'on ma ambulu</para>
  <para style="q2" vid="LAM 1:6">adama a na a̱ tsura̱i uba̱ta̱ wa alyuna shi.</para>
  <para style="q1" vid="LAM 1:6">A̱ ri nu ucira u na aa sumaa</para>
  <para style="q2" vid="LAM 1:6">aza a na aa saɓusa le shi.<verse eid="LAM 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7" />A rana va̱ a̱tsuma̱lima̱ a̱ yi na agara a̱ yi,</para>
  <para style="q2" vid="LAM 1:7">Urishelima cuwan ta̱ na̱ wuma wa̱a̱ yi</para>
  <para style="q2" vid="LAM 1:7">ni itana yi ikebe ya̱ yi yu ufaru.</para>
  <para style="q1" vid="LAM 1:7">Agba gogo u riya̱ ta̱ e ekere a n'yuwatan ma̱ yi,</para>
  <para style="q2" vid="LAM 1:7">waru babu za na aa kamba yi.</para>
  <para style="q1" vid="LAM 1:7">N'yuwatan ma̱ yi n zo'oso yi ta̱,</para>
  <para style="q2" vid="LAM 1:7">a̱vu a yuwaan yi ulamu o ukototosu wa̱ yi.<verse eid="LAM 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8" />Urishelima yuwan ta̱ unusu lon,</para>
  <para style="q2" vid="LAM 1:8">reve gba wo o'wo idaba.</para>
  <para style="q1" vid="LAM 1:8">Aza a na suru a̱ shi a ca niyi tsugbain</para>
  <para style="q2" vid="LAM 1:8">aa tarasa yi ili i ro waru shi,</para>
  <para style="q2" vid="LAM 1:8">adama a na e ene ta̱ ataɓu a̱ yi.</para>
  <para style="q1" vid="LAM 1:8">A̱yi na aciya̱yi</para>
  <para style="q2" vid="LAM 1:8">u te i'wan na̱ mapala mo urewesu wa̱ yi.<verse eid="LAM 1:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9" />Idaba ya̱ yi i roco ta̱ a̱ nkuru ma̱ yi,</para>
  <para style="q2" vid="LAM 1:9">u yuwan majiyan cine wuma wa̱a̱ da̱na̱ elime shi.</para>
  <para style="q1" vid="LAM 1:9">Adama o ndolo uriyu wa̱ yi u wuyana ta̱ lon,</para>
  <para style="q2" vid="LAM 1:9">babu za na aa ca yi adanshi.</para>
  <para style="q1" vid="LAM 1:9">Reve u damma, &lt;&lt;A̱sulazuva, ka̱lyuwa̱ a̱tsuma̱lima̱ a̱ va̱,</para>
  <para style="q2" vid="LAM 1:9">adama a na ma'yuwatan ma lyuwa ta̱ aci.&gt;&gt;<verse eid="LAM 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10" />Ma'yuwatan ma̱ pura̱ ta̱</para>
  <para style="q2" vid="LAM 1:10">itana yi ikebe ya̱ yi suru.</para>
  <para style="q1" vid="LAM 1:10">Urishelima ene ta̱ ma'yuwatan ma̱ yi</para>
  <para style="q2" vid="LAM 1:10">a uwusa a̱ A̱a̱'isa̱ a̱ yi,</para>
  <para style="q1" vid="LAM 1:10">aza a na vu putsayi she a uwa</para>
  <para style="q2" vid="LAM 1:10">a̱tsuma̱ e iɓolo ya ama a̱ wu wan.<verse eid="LAM 1:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11" />Ama a̱ yi suru a̱ te i'wan</para>
  <para style="q2" vid="LAM 1:11">e izami yi ilyalya.</para>
  <para style="q1" vid="LAM 1:11">A wina ta̱ itana yi ikebe i na a̱ ri ne ele suru</para>
  <para style="q2" vid="LAM 1:11">adama a̱ tsura̱ ilyalya na a̱ da̱na̱ wuma.</para>
  <para style="q1" vid="LAM 1:11">Reve Urishelima damma, &lt;&lt;A̱sulazuva, ka̱lyuwa̱ ve ene</para>
  <para style="q2" vid="LAM 1:11">cine a tara numu ili shi.&gt;&gt;<verse eid="LAM 1:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12" />&lt;&lt;U ɓa̱la̱ ɗu shi, a̱ɗu na ya̱a̱ ka̱ra̱sa̱?</para>
  <para style="q2" vid="LAM 1:12">Ka̱lyuwa̱i yee ene.</para>
  <para style="q1" vid="LAM 1:12">A̱tsuma̱lima̱ o ro o ta̱ lo tsa za va̱,</para>
  <para style="q2" vid="LAM 1:12">za na a fabaa numu</para>
  <para style="q1" vid="LAM 1:12">za na A̱sulazuva a̱ ta̱wa̱a̱ numu</para>
  <para style="q2" vid="LAM 1:12">o urana wu upan wu usuɗuwu wa̱ yi?<verse eid="LAM 1:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13" />&lt;&lt;U lyungu ta̱ akina diga zuva,</para>
  <para style="q2" vid="LAM 1:13">za na uwai she e etele a̱ va̱.</para>
  <para style="q1" vid="LAM 1:13">Wa azuwaa ta̱ ana a̱ va̱ igolo,</para>
  <para style="q2" vid="LAM 1:13">a̱vu u rono mu a̱ ka̱mba̱ a̱ca̱pa̱.</para>
  <para style="q1" vid="LAM 1:13">U lyawa mu ta̱ a̱ nde'en,</para>
  <para style="q2" vid="LAM 1:13">ulimu urana ma̱ɓula̱.<verse eid="LAM 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14" />&lt;&lt;Wu nla̱ ta̱ unusu u va̱ tsa̱ a̱a̱gba̱la̱,</para>
  <para style="q2" vid="LAM 1:14">nu ukere wa̱ yi u ɗa u ɓoloto nle.</para>
  <para style="q1" vid="LAM 1:14">A zuwa le ta̱ a̱ yinlu i va̱</para>
  <para style="q2" vid="LAM 1:14">a̱vu u zuwa ucira u va̱ u ga̱sa̱.</para>
  <para style="q1" vid="LAM 1:14">U zuwa mu ta̱ e ekere a aza a na</para>
  <para style="q2" vid="LAM 1:14">maa gura isawan a̱ ma̱ka̱ka̱n me le shi.<verse eid="LAM 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15" />&lt;&lt;A̱sulazuva a 'yuwan ta̱</para>
  <para style="q2" vid="LAM 1:15">ama a̱ va̱ a na a gurai uvon suru,</para>
  <para style="q1" vid="LAM 1:15">a̱vu u zuwa oɓolo a̱ a̱soja nla̱ngi na̱ a̱mu</para>
  <para style="q2" vid="LAM 1:15">adama a̱ rukutsa̱ olobo a̱ va̱.</para>
  <para style="q1" vid="LAM 1:15">A̱sulazuva a dasa ta̱ ama a Yahuda</para>
  <para style="q2" vid="LAM 1:15">uba̱ta̱ u mokpoko ma masayan ma̱ yi.<verse eid="LAM 1:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16" />&lt;&lt;Adama e ili i nda i ɗa n ri e mesun,</para>
  <para style="q2" vid="LAM 1:16">aɓara oo ocusho e esu a̱ va̱.</para>
  <para style="q1" vid="LAM 1:16">Ko za lo zuzu na waa ca mu adanshi shi,</para>
  <para style="q2" vid="LAM 1:16">za lo na waa jisan ruhu va̱ shi.</para>
  <para style="q1" vid="LAM 1:16">Muwun n va̱ mo o'wo ta̱ uvariyi</para>
  <para style="q2" vid="LAM 1:16">adama a na ma'yuwatan ma lyuwa ta̱ aci e le.&gt;&gt;<verse eid="LAM 1:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17" />Sihiyona buba̱ruwa̱ ta̱ ekere a̱ yi,</para>
  <para style="q2" vid="LAM 1:17">agba za lo na aa ca yi adanshi shi.</para>
  <para style="q1" vid="LAM 1:17">A̱sulazuva a ca ta̱ udammu a aci a Yakubu</para>
  <para style="q2" vid="LAM 1:17">na nron mu nden yi ma̱ moo o'wo n'yuwatan ma̱ yi.</para>
  <para style="q1" vid="LAM 1:17">Urishelima o'wo ta̱</para>
  <para style="q2" vid="LAM 1:17">ili yi idaba uba̱ta̱ u le.<verse eid="LAM 1:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18" />Reve u damma, &lt;&lt;A̱sulazuva a yuwan ta̱ mejege,</para>
  <para style="q2" vid="LAM 1:18">adama a na n 'ya̱sa̱a̱n ta̱ adanshi a̱ yi aci.</para>
  <para style="q1" vid="LAM 1:18">Poloi atsuvu a̱ɗu ama suru,</para>
  <para style="q2" vid="LAM 1:18">yee ene a̱tsuma̱lima̱ a̱ va̱.</para>
  <para style="q1" vid="LAM 1:18">Esheli a̱ va̱ no olobo a̱ va̱</para>
  <para style="q2" vid="LAM 1:18">a tara le ta̱ a̱ 'ya̱wa̱ tsugbashi.<verse eid="LAM 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19" />&lt;&lt;N ɗe ta̱ nɗa n na n ciga numu,</para>
  <para style="q2" vid="LAM 1:19">agba a̱vu a̱ luluma̱ mu.</para>
  <para style="q1" vid="LAM 1:19">Nan ganu a̱ va̱ na̱ mbara n va̱</para>
  <para style="q2" vid="LAM 1:19">ele e izami yi ilyalya</para>
  <para style="q1" vid="LAM 1:19">adama a̱ da̱na̱ wuma</para>
  <para style="q2" vid="LAM 1:19">ɗaɗa a̱ kuwa̱i a̱tsuma̱ a̱ lyuci'i.<verse eid="LAM 1:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20" />&lt;&lt;A̱sulazuva, ka̱lyuwa̱ cine n ri a̱tsuma̱lima̱!</para>
  <para style="q2" vid="LAM 1:20">N ta̱ oo sowuso a̱tsuma̱lima̱ lon,</para>
  <para style="q1" vid="LAM 1:20">okolo a̱ va̱ waru e te meje'en,</para>
  <para style="q2" vid="LAM 1:20">adama a na n 'ya̱sa̱a̱n wu ta̱ aci.</para>
  <para style="q1" vid="LAM 1:20">A alanga matsun me pe'eni ma̱ to unusa,</para>
  <para style="q2" vid="LAM 1:20">a̱tsuma̱ a 'wa waru ukwa̱ u ɗa nda.<verse eid="LAM 1:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21" />&lt;&lt;Ama a uwwa ta̱ i'wan i va̱,</para>
  <para style="q2" vid="LAM 1:21">agba ko za lo na waa caa mu adanshi shi.</para>
  <para style="q1" vid="LAM 1:21">N'yuwatan n va̱ suru mu uwwa ta̱ aɗa a̱ a̱tsuma̱lima̱ a̱ va̱,</para>
  <para style="q2" vid="LAM 1:21">a̱ za̱nga̱na̱ ta̱ ni ili i na vu yuwaan numu.</para>
  <para style="q1" vid="LAM 1:21">Ta̱wa̱a̱ nu urana u na vu yuwain adanshi a̱ yi</para>
  <para style="q2" vid="LAM 1:21">adama o o'wo tsa̱ va̱.<verse eid="LAM 1:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22" />&lt;&lt;Lyawa iwuya i le suru i rawa uba̱ta̱ wa̱ wu,</para>
  <para style="q2" vid="LAM 1:22">vu yuwan ne ele</para>
  <para style="q1" vid="LAM 1:22">cine vu yuwain na̱ a̱mu</para>
  <para style="q2" vid="LAM 1:22">adama a̱ a̱bunda̱ a̱ nusu va̱ suru.</para>
  <para style="q1" vid="LAM 1:22">I'wan i va̱ i yuwan ta̱ a̱bunda̱,</para>
  <para style="q2" vid="LAM 1:22">waru okolo a̱ va̱ a kuɗa ta̱.&gt;&gt;<verse eid="LAM 1:22" /></para>
  <para style="b" />
  <chapter eid="LAM 1" />
  <chapter number="2" style="c" sid="LAM 2" />
  <para style="s">Upan wa̱ A̱sula̱ aci a Isra'ila</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 2:1" />Cine A̱sulazuva a̱ ɓa̱ruyi</para>
  <para style="q2" vid="LAM 2:1">Sihiyona a̱tsuma̱ e eleshe o upan!</para>
  <para style="q1" vid="LAM 2:1">U vari ta̱ ulobonu wa Isra'ila</para>
  <para style="q2" vid="LAM 2:1">diga zuva a̱ tyo e iɗa.</para>
  <para style="q1" vid="LAM 2:1">U cuwan nu uzuwata wa ana wa̱ yi shi</para>
  <para style="q2" vid="LAM 2:1">a̱tsuma̱ o urana wu upan wa̱ yi.<verse eid="LAM 2:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2" />A̱sulazuva o soɗu ta̱</para>
  <para style="q2" vid="LAM 2:2">uba̱ta̱ wu nden wa Yakubu suru babu roco iliyali.</para>
  <para style="q1" vid="LAM 2:2">A̱tsuma̱ o upan wa̱ yi u varu ta̱</para>
  <para style="q2" vid="LAM 2:2">ɓaɓu vu ucira va Yahuda.</para>
  <para style="q1" vid="LAM 2:2">U polo ta̱ uba̱ta̱ u tsugono tsa̱ yi</para>
  <para style="q2" vid="LAM 2:2">no ozo o tsugono tsa̱ yi e iɗa u tara le ili i ro shi.<verse eid="LAM 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3" />A̱tsuma̱ o upan u tawa ta̱</para>
  <para style="q2" vid="LAM 2:3">ucira wa Isra'ila suru,</para>
  <para style="q1" vid="LAM 2:3">u vura̱nu ta̱ ukere u sa'ani wa̱ yi a̱ ka̱mba̱ a̱ca̱pa̱</para>
  <para style="q2" vid="LAM 2:3">a̱ ma̱ka̱ka̱n ma n'yuwatan n le.</para>
  <para style="q1" vid="LAM 2:3">U kula̱to ta̱ a̱tsuma̱ a Yakubu tsa akina a madala</para>
  <para style="q2" vid="LAM 2:3">a na a̱ tsu kula̱to ili i na i ri lo uka̱nda̱ruwu suru.<verse eid="LAM 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4" />U ni'wa̱n ta̱ utan wa̱ yi tsa ma'yuwatan,</para>
  <para style="q2" vid="LAM 2:4">nu ukere u sa'ani wa̱ yi ufoɓu,</para>
  <para style="q1" vid="LAM 2:4">a̱vu u kototo</para>
  <para style="q2" vid="LAM 2:4">a̱za̱ o ukadu suru.</para>
  <para style="q1" vid="LAM 2:4">Woo oco ta̱ upan wa̱ yi tsa akina</para>
  <para style="q2" vid="LAM 2:4">o oogodo a ama a̱ Sihiyona.<verse eid="LAM 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5" />A̱sulazuva o o'wo ta̱ tsa ma'yuwatan,</para>
  <para style="q2" vid="LAM 2:5">u soɗu ta̱ Isra'ila.</para>
  <para style="q1" vid="LAM 2:5">U soɗu ta̱ kobu tsugono tsa̱ yi suru</para>
  <para style="q2" vid="LAM 2:5">a̱vu u kototo ɓaɓu vu ucira va̱ yi suru.</para>
  <para style="q1" vid="LAM 2:5">U da̱shi ta̱ ama a Yahuda</para>
  <para style="q2" vid="LAM 2:5">a̱tsumola̱ngu na̱ mesun.<verse eid="LAM 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6" />Woo oco ta̱ A̱a̱'isa̱ a̱ yi tso oogodo,</para>
  <para style="q2" vid="LAM 2:6">reve u kototo uba̱ta̱ wu uga'asusan wa̱ yi.</para>
  <para style="q1" vid="LAM 2:6">A̱sulazuva a zuwa ta̱ Sihiyona icina na̱ a̱buki a̱ yi a na a zuwai suru</para>
  <para style="q2" vid="LAM 2:6">na̱ rana va Ashibi a̱ yi.</para>
  <para style="q1" vid="LAM 2:6">A̱tsuma̱ o upan wu usuɗuwu wa̱ yi</para>
  <para style="q2" vid="LAM 2:6">u 'yuwan ta̱ mogono na̱ ganu.<verse eid="LAM 2:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7" />A̱sulazuva a 'yuwan ta̱ masa'a ma̱ yi,</para>
  <para style="q2" vid="LAM 2:7">a̱vu u vari A̱a̱'isa̱ a̱ yi.</para>
  <para style="q1" vid="LAM 2:7">U ca ta̱ ma'yuwatan</para>
  <para style="q2" vid="LAM 2:7">ɓaɓu vu kobu tsugono tsa̱ Urishelima.</para>
  <para style="q1" vid="LAM 2:7">O to oruwuso a̱tsuma̱ o u'wa wa̱ A̱sulazuva</para>
  <para style="q2" vid="LAM 2:7">she damma urana wa̱ a̱buki a na a zuwai.<verse eid="LAM 2:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8" />A̱sulazuva a zuwa ta̱ okolo a na woo ɓoso</para>
  <para style="q2" vid="LAM 2:8">uɓaɓu wa̱ Sihiyona.</para>
  <para style="q1" vid="LAM 2:8">Wu ba̱ruwa̱ ta̱ amunga o uritosu wu ukototosu</para>
  <para style="q2" vid="LAM 2:8">u ka̱mba̱to ukere wu ucira wa̱ yi wu ukototosu shi,</para>
  <para style="q1" vid="LAM 2:8">u zuwa ta̱ atsura na̱ ɓaɓu mesun,</para>
  <para style="q2" vid="LAM 2:8">suru a̱ la̱nga̱ ta̱.<verse eid="LAM 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9" />Na̱ntsu va̱ yi liɓa ta̱ e iɗa,</para>
  <para style="q2" vid="LAM 2:9">wu kuɗa ta̱ katsuwata va̱ yi.</para>
  <para style="q1" vid="LAM 2:9">Ngono ma̱ yi na azagbain a̱ yi</para>
  <para style="q2" vid="LAM 2:9">a̱ pura̱ le ta̱ a̱ tyo a nɗa n ro,</para>
  <para style="q2" vid="LAM 2:9">wila̱ wa̱ yi u buwa shi.</para>
  <para style="q1" vid="LAM 2:9">Ama̱sula̱ a̱ yi waru a buwa a̱ tsurusa̱</para>
  <para style="q2" vid="LAM 2:9">alavu alavu uba̱ta̱ wa̱ A̱sulazuva shi.<verse eid="LAM 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10" />Mbara ma ama a̱ Sihiyona</para>
  <para style="q2" vid="LAM 2:10">a̱ ta̱ nden e iɗa kuci kuci.</para>
  <para style="q1" vid="LAM 2:10">A̱ tsun ta̱ ma̱buta̱ a aci e le</para>
  <para style="q2" vid="LAM 2:10">e mesun ma̱ a̱tsumola̱ngu,</para>
  <para style="q2" vid="LAM 2:10">a̱vu o oto akashamuna.</para>
  <para style="q1" vid="LAM 2:10">Esheli a̱ Urishelima</para>
  <para style="q2" vid="LAM 2:10">a̱ ka̱ɗa̱to ta̱ aci e le e iɗa.<verse eid="LAM 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11" />Esu a̱ va̱ a̱ kuna̱ ta̱ na̱ mesun,</para>
  <para style="q2" vid="LAM 2:11">a̱a̱tsuma̱ a̱ va̱ a̱ ɗumbura̱ ta̱.</para>
  <para style="q1" vid="LAM 2:11">Okolo a̱ va̱ e jeruwe ta̱</para>
  <para style="q2" vid="LAM 2:11">adama o ukototosu wa ama a̱ va̱,</para>
  <para style="q1" vid="LAM 2:11">adama a na nreɓu na̱ muwun n ta̱ a̱ limusa̱</para>
  <para style="q2" vid="LAM 2:11">e re gbain lyuci'i.<verse eid="LAM 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12" />A̱ ta̱ shoshen nan mma le,</para>
  <para style="q2" vid="LAM 2:12">&lt;&lt;Te ilyalya na̱ masayan?&gt;&gt;</para>
  <para style="q1" vid="LAM 2:12">Ele a̱ limusa̱ tsa ama a na a amatoyin</para>
  <para style="q2" vid="LAM 2:12">e re gbain lyuci'i,</para>
  <para style="q1" vid="LAM 2:12">wuma u le o utusa̱</para>
  <para style="q2" vid="LAM 2:12">e ekere a nan mma le.<verse eid="LAM 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13" />Nye maa damma adama a̱ wu?</para>
  <para style="q2" vid="LAM 2:13">Na̱ nye maa kurato wu,</para>
  <para style="q2" vid="LAM 2:13">a̱vu Urishelima?</para>
  <para style="q1" vid="LAM 2:13">Na̱ nye maa kurato wu,</para>
  <para style="q2" vid="LAM 2:13">adama n ca wu adanshi,</para>
  <para style="q2" vid="LAM 2:13">a̱vu Sihiyona?</para>
  <para style="q1" vid="LAM 2:13">A̱ru'un a̱ wuntsu a̱ wu ta̱ tsa̱ a̱ru'un a mala.</para>
  <para style="q2" vid="LAM 2:13">Zane ɗa aa gura ka̱mba̱to wu gbaga?<verse eid="LAM 2:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14" />Alavu alavu a na ama̱sula̱ a̱ wu e enei</para>
  <para style="q2" vid="LAM 2:14">a̱za̱ e epen a ɗa, ili ye pere.</para>
  <para style="q1" vid="LAM 2:14">A̱ pa̱lu'wa̱ unusu na waa putsaa</para>
  <para style="q2" vid="LAM 2:14">a̱ pura̱ ɗu shi.</para>
  <para style="q1" vid="LAM 2:14">Ili i na yaa fara na a dammai</para>
  <para style="q2" vid="LAM 2:14">epen a ɗa waru u pusa̱sun u ɗu.<verse eid="LAM 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15" />Aza a na suru a̱a̱ ka̱ra̱sa̱</para>
  <para style="q2" vid="LAM 2:15">a ta yuwusaan wu ulamu,</para>
  <para style="q1" vid="LAM 2:15">a lumgbatsusaa</para>
  <para style="q2" vid="LAM 2:15">Urishelima aci e le.</para>
  <para style="q1" vid="LAM 2:15">&lt;&lt;A̱yi nda a̱yi ɗa lyuci na ee ɗesu</para>
  <para style="q2" vid="LAM 2:15">lyuci na la'ai ulobonu,</para>
  <para style="q2" vid="LAM 2:15">ma̱za̱nga̱ mo uvaɗi suru shi?&gt;&gt;<verse eid="LAM 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16" />N'yuwatan ma̱ wu suru</para>
  <para style="q2" vid="LAM 2:16">e meɗee wu ta̱ na̱ le,</para>
  <para style="q1" vid="LAM 2:16">a ta yuwusaan wu ulamu</para>
  <para style="q2" vid="LAM 2:16">waru a macuru na a dammi,</para>
  <para style="q1" vid="LAM 2:16">&lt;&lt;Tsu soɗu yi ta̱!</para>
  <para style="q2" vid="LAM 2:16">A̱yi nda a̱yi ɗa urana u na tsaa pura,</para>
  <para style="q2" vid="LAM 2:16">a̱yi ɗa nda gba u rawai tse ene yi ta̱!&gt;&gt;<verse eid="LAM 2:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17" />A̱sulazuva a yuwan ta̱ ili i na u foɓoi,</para>
  <para style="q2" vid="LAM 2:17">u shiton ta̱ adanshi a̱ yi</para>
  <para style="q2" vid="LAM 2:17">a na u dammai ɗe nu ujumu.</para>
  <para style="q1" vid="LAM 2:17">U vari wu ta̱ babu roco iliyali.</para>
  <para style="q2" vid="LAM 2:17">U zuwa ta̱ ma'yuwatan ma̱ za̱nga̱na̱ e ekere a̱ wu,</para>
  <para style="q2" vid="LAM 2:17">u 'ya̱sa̱n ta̱ ucira wu n'yuwatan ma̱ wu.<verse eid="LAM 2:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18" />Okolo a ama</para>
  <para style="q2" vid="LAM 2:18">e showen ta̱ A̱sulazuva.</para>
  <para style="q1" vid="LAM 2:18">O'o, uɓaɓu wa ama a̱ Sihiyona,</para>
  <para style="q2" vid="LAM 2:18">lyawa aɓara a̱ wu e yene tsu uɗolu</para>
  <para style="q2" vid="LAM 2:18">urana na ayin.</para>
  <para style="q1" vid="LAM 2:18">She vo o'woto aciya̱wu fa̱a̱n wan,</para>
  <para style="q2" vid="LAM 2:18">she vu ca esu a̱ wu wivuwun wan.<verse eid="LAM 2:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19" />'Yon vu shon ayin ma̱ɓula̱,</para>
  <para style="q2" vid="LAM 2:19">vu damma ili i na i ri okolo a̱ wu,</para>
  <para style="q1" vid="LAM 2:19">vu za̱za̱la̱ okolo a̱ wu tsa̱ mini</para>
  <para style="q2" vid="LAM 2:19">a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva.</para>
  <para style="q1" vid="LAM 2:19">'Ya̱sa̱n ekere a̱ wu zuva a̱ tyo ya̱'a̱ yi</para>
  <para style="q2" vid="LAM 2:19">adama a wuma u muwun ma̱ wu,</para>
  <para style="q1" vid="LAM 2:19">aza a na a̱ lima̱i o ure biti</para>
  <para style="q2" vid="LAM 2:19">adama a ambulu.<verse eid="LAM 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20" />&lt;&lt;A̱sulazuva, ka̱lyuwa̱ ve ene,</para>
  <para style="q2" vid="LAM 2:20">zane ɗa vu yuwain ɗe na̱ a̱yi ne tsunda?</para>
  <para style="q1" vid="LAM 2:20">U lobono ta̱ a̱ma̱ci a tama muwun n le,</para>
  <para style="q2" vid="LAM 2:20">muwun n na a kungwatoi?</para>
  <para style="q1" vid="LAM 2:20">U lobono ta̱ o una nan ganu na ama̱sula̱</para>
  <para style="q2" vid="LAM 2:20">a̱tsuma̱ a̱ A̱a̱'isa̱ a̱ A̱sulazuva?<verse eid="LAM 2:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21" />&lt;&lt;Muwun mo olobo na̱ mbara</para>
  <para style="q2" vid="LAM 2:21">n von ta̱ a̱ ma̱buta̱ me re gbain.</para>
  <para style="q1" vid="LAM 2:21">Esheli a̱ va̱ no olobo a̱ va̱</para>
  <para style="q2" vid="LAM 2:21">a̱ kuwa̱ ta̱ a matsun me pe'eni.</para>
  <para style="q1" vid="LAM 2:21">Vu una le ta̱ a̱tsuma̱ o urana wu upan wa̱ wu,</para>
  <para style="q2" vid="LAM 2:21">vu paɗa le ta̱ babu roco iliyali.<verse eid="LAM 2:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22" />&lt;&lt;Vu banu ta̱ n'yuwatan a ca mu wovon e eɓele biti,</para>
  <para style="q2" vid="LAM 2:22">cine a̱ tsu banu ama o urana wa̱ a̱buki.</para>
  <para style="q1" vid="LAM 2:22">O urana wu upan wa̱ A̱sulazuva</para>
  <para style="q2" vid="LAM 2:22">ko za la'a ko pasa shi.</para>
  <para style="q1" vid="LAM 2:22">Aza a na n ka̱lyuwa̱i n kungwatoi</para>
  <para style="q2" vid="LAM 2:22">n'yuwatan n kototo le ta̱.&gt;&gt;<verse eid="LAM 2:22" /></para>
  <para style="b" />
  <chapter eid="LAM 2" />
  <chapter number="3" style="c" sid="LAM 3" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 3:1" />A̱mu ɗa vuma na e enei a̱tsuma̱lima̱</para>
  <para style="q2" vid="LAM 3:1">a aaɗanga o upan wa̱ yi.<verse eid="LAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2" />U gba̱ra̱ mu ta̱ a̱vu u zuwa mu mmalu</para>
  <para style="q2" vid="LAM 3:2">a̱tsuma̱ e irumbu o una we ekan.<verse eid="LAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3" />Amayun u vadala ta̱ ukere wa̱ yi aci a̱ va̱</para>
  <para style="q2" vid="LAM 3:3">a̱a̱ ga̱la̱sa̱ mu kuci a̱liva̱.<verse eid="LAM 3:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4" />U zuwa ta̱ ukwan u lipu u va̱</para>
  <para style="q2" vid="LAM 3:4">ni inama i lipu i va̱ a̱ la̱nga̱,</para>
  <para style="q2" vid="LAM 3:4">a̱vu wu kuɗa etele a̱ va̱.<verse eid="LAM 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5" />U ka̱nda̱ruwa̱ mu ta̱ a̱vu u ɓa̱ru mu</para>
  <para style="q2" vid="LAM 3:5">no okono na̱ a̱tsuma̱lima̱ lon.<verse eid="LAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6" />U zuwa mu ta̱ n da̱nu a̱tsuma̱ e irumbu,</para>
  <para style="q2" vid="LAM 3:6">tsa aza a na a̱ kuwa̱i ɗe nu ujumu.<verse eid="LAM 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7" />U ka̱nda̱ruwa̱ mu ta̱ nu uɓaɓu adama n la'a wan,</para>
  <para style="q2" vid="LAM 3:7">wu nla̱ mu ta̱ na akani o ume.<verse eid="LAM 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8" />Ko na n ri e mesun me izami yi ikambishi,</para>
  <para style="q2" vid="LAM 3:8">u ula ta̱ atsuvu a avasa a̱ va̱.<verse eid="LAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9" />U geshe ta̱ ure u va̱ ni iponu ya atali,</para>
  <para style="q2" vid="LAM 3:9">a̱vu u zuwa ure u va̱ wo o'wo ugondoru ugondoru.<verse eid="LAM 3:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10" />U vawan mu ta̱ tsa biya,</para>
  <para style="q2" vid="LAM 3:10">tsa kamu e ipiri uvawun.<verse eid="LAM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11" />U rono mu ta̱ diga o ure,</para>
  <para style="q2" vid="LAM 3:11">reve wu kara mu muyejin muyejin,</para>
  <para style="q2" vid="LAM 3:11">a̱vu u lyawa mu nde'en babu ikambishi.<verse eid="LAM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12" />U rono ta̱ utan wa̱ yi,</para>
  <para style="q2" vid="LAM 3:12">reve wo o'woto mu ili i na waa tawan.<verse eid="LAM 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13" />U tawan ta̱ okolo a̱ va̱</para>
  <para style="q2" vid="LAM 3:13">na aya o ujin a̱ yi.<verse eid="LAM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14" />Mo o'wo ta̱ ili yi izo'oshi e ekere a ama a̱ va̱ suru,</para>
  <para style="q2" vid="LAM 3:14">a ta yuwusaan mu ulamu a̱tsuma̱ e ishipa a̱liva̱.<verse eid="LAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15" />U shiton mu ta̱ na̱ mini mo okono</para>
  <para style="q2" vid="LAM 3:15">a̱vu u cuwa̱ton mu ni ili yo okono.<verse eid="LAM 3:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16" />Wu kuɗa ta̱ anga a̱ va̱ na atali,</para>
  <para style="q2" vid="LAM 3:16">a̱vu u zuwa mu igandalu a̱tsuma̱ a̱ ma̱buta̱.<verse eid="LAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17" />A putsaa mu ta̱ na asuvu nden,</para>
  <para style="q2" vid="LAM 3:17">mi icina ta̱ ni ili i na a̱ tsu ɗe ulyuwu we elime.<verse eid="LAM 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18" />Ɗaɗa n salai, &lt;&lt;Tsugbain tsa̱ va̱ tso koto ta̱!</para>
  <para style="q2" vid="LAM 3:18">Ne ɗa waru ili i na n zuwai okolo uba̱ta̱ wa̱ A̱sulazuva.&gt;&gt;<verse eid="LAM 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19" />N ta majiyan ma̱ a̱tsuma̱lima̱ ma̱ va̱</para>
  <para style="q2" vid="LAM 3:19">nu ulambu wu nda̱na̱ta̱ n va̱,</para>
  <para style="q2" vid="LAM 3:19">ili yo okono i ɗa na̱ tsukono.<verse eid="LAM 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20" />N ta cuwusan ne ele kuci,</para>
  <para style="q2" vid="LAM 3:20">waru asuvu a̱ va̱ a kuɗa ta̱.<verse eid="LAM 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21" />Agba n ta cuwusan ni ili i nda,</para>
  <para style="q2" vid="LAM 3:21">adama o ndolo n ta̱ nu uzuwu wo okolo.<verse eid="LAM 3:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22" />Adama e icigi ya̱ A̱sulazuva i na i tsu vadala shi</para>
  <para style="q2" vid="LAM 3:22">o soɗu tsu shi,</para>
  <para style="q2" vid="LAM 3:22">adama a na isa'ani ya̱ yi i ri na̱ a̱tyo shi.<verse eid="LAM 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23" />Usa'avu u ɗa a̱ ri usana biti,</para>
  <para style="q2" vid="LAM 3:23">a̱ɓula̱ a̱ wu a̱ ta̱ a̱bunda̱.<verse eid="LAM 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24" />Reve n damma aciya̱va̱, &lt;&lt;A̱sulazuva a ɗa akunda a̱ va̱,</para>
  <para style="q2" vid="LAM 3:24">adama o ndolo n ta zuwa okolo ya̱'a̱ yi.&gt;&gt;<verse eid="LAM 3:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25" />A̱sulazuva a̱ ta̱ ni isa'ani a̱ tyo e ekere</para>
  <para style="q2" vid="LAM 3:25">a aza a na a zuwai okolo ya̱'a̱ yi,</para>
  <para style="q2" vid="LAM 3:25">uba̱ta̱ wu za na a zama yi.<verse eid="LAM 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26" />U tu ulobonu vuma piri kuci kuci</para>
  <para style="q2" vid="LAM 3:26">we ene iwawi ya̱ A̱sulazuva.<verse eid="LAM 3:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27" />U tu ulobonu vuma kaɓa asuvu</para>
  <para style="q2" vid="LAM 3:27">na̱ a̱a̱gba̱la̱ o ume a̱yi a̱tsuma̱ tsulolobo tsa̱ yi.<verse eid="LAM 3:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28" />Lyawa u da̱nu kpaku,</para>
  <para style="q2" vid="LAM 3:28">a mantsa ma na A̱sulazuva a̱ kuruwa̱a̱ niyi a̱yi.<verse eid="LAM 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29" />Lyawa u kpa̱to urewesu wa̱ yi a̱ ma̱buta̱,</para>
  <para style="q2" vid="LAM 3:29">u ta gura o'wo uzuwu wo okolo u ta̱wa̱.<verse eid="LAM 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30" />Lyawa u ca za na aa ɓasa yi ugbaguzu,</para>
  <para style="q2" vid="LAM 3:30">lyawa u shiwan no oso o wono.<verse eid="LAM 3:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31" />Adama a na Zagbain</para>
  <para style="q2" vid="LAM 3:31">tsu vari vuma suru suru shi.<verse eid="LAM 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32" />Ko na̱ shi u ta̱wa̱a̱ na̱ a̱tsumola̱ngu u tse ene ta̱ iliyali,</para>
  <para style="q2" vid="LAM 3:32">adama e icigi ya̱ a̱bunda̱ ya̱ yi i na i tsu vadala shi.<verse eid="LAM 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33" />Adama a na u tsu ta̱wa̱a̱ ama na̱ a̱tsuma̱lima̱</para>
  <para style="q2" vid="LAM 3:33">ko a̱tsumola̱ngu nu ucigu wa̱ yi shi.<verse eid="LAM 3:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34" />Nna a minjira aza a na a̱ ri</para>
  <para style="q2" vid="LAM 3:34">o u'wa wa ali suru na ana e iɗa,<verse eid="LAM 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35" />nna a putsaa vuma ili i na i ri za va̱ yi</para>
  <para style="q2" vid="LAM 3:35">a̱ ma̱ka̱ka̱n mo Mogono ma̱ A̱sula̱,<verse eid="LAM 3:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36" />nna a putsaa vuma nu uge'etosu wa amayun,</para>
  <para style="q2" vid="LAM 3:36">A̱sulazuva a̱ ta̱ usu ili ya̱ ndolo?<verse eid="LAM 3:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37" />Zane ɗa aa yuwan adanshi a̱vu ili'i i fara</para>
  <para style="q2" vid="LAM 3:37">nna̱ A̱sulazuva a ɗa a zuwai shi?<verse eid="LAM 3:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38" />Ashe diga o una̱ u Mogono ma̱ A̱sula̱ a ɗa</para>
  <para style="q2" vid="LAM 3:38">iwuya ni isa'ani i tsu uta̱ shi?<verse eid="LAM 3:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39" />To, nye i zuwai vuma na ri wuma aa yuwan adanshawuya</para>
  <para style="q2" vid="LAM 3:39">a mantsa ma na a ca niyi oforo adama a̱ nusu va̱ yi?<verse eid="LAM 3:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40" />Lyawai tsu ritoi a̱vu tsu ka̱lyuwa̱i re tsu,</para>
  <para style="q2" vid="LAM 3:40">a̱vu tsu ka̱mba̱i uba̱ta̱ wa̱ A̱sulazuva.<verse eid="LAM 3:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41" />Lyawai tsu ca yi okolo a̱ tsu, tsu 'ya̱sa̱in ekere a̱ tsu</para>
  <para style="q2" vid="LAM 3:41">a̱ tyo uba̱ta̱ wa̱ A̱sula̱ a zuva tsu dammai,<verse eid="LAM 3:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42" />&lt;&lt;Tsu yuwain ta̱ unusu a̱vu tsu 'ya̱sa̱n aci,</para>
  <para style="q2" vid="LAM 3:42">a̱vu gba vu yuwaan tsu gafura shi.<verse eid="LAM 3:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43" />&lt;&lt;Vu pala ta̱ aciya̱wu nu upan a̱vu vu saɓa tsu,</para>
  <para style="q2" vid="LAM 3:43">o unusa babu ene iliyali.<verse eid="LAM 3:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44" />Vu pala ta̱ aciya̱wu ne eleshe</para>
  <para style="q2" vid="LAM 3:44">adama avasa a̱ tsu a rawa uba̱ta̱ wa̱ wu wan.<verse eid="LAM 3:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45" />Vo o'woto tsu ta̱ everi ne edemu</para>
  <para style="q2" vid="LAM 3:45">a̱tsuma̱ a nɗa.<verse eid="LAM 3:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46" />&lt;&lt;N'yuwatan n tsu suru m kpa̱tu'wa̱ ta̱ na̱ le</para>
  <para style="q2" vid="LAM 3:46">a yuwusan adanshi a aci a̱ tsu.<verse eid="LAM 3:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47" />Tsu shiwan ta̱ na̱ wovon na̱ maza</para>
  <para style="q2" vid="LAM 3:47">nu ulungusu nu ukototosu.&gt;&gt;<verse eid="LAM 3:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48" />Aɓara e te yeneshe diga e esu a̱ va̱ tsa̱ mini mo ɗolu</para>
  <para style="q2" vid="LAM 3:48">adama o ukototosu wa ama a̱ va̱.<verse eid="LAM 3:48" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49" />Aɓara a̱ va̱ a̱ ta̱ da̱na̱ e meyene</para>
  <para style="q2" vid="LAM 3:49">babu kasa, babu wivuwun,<verse eid="LAM 3:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LAM 3:50" />hali she na̱ A̱sulazuva</para>
  <para style="q2" vid="LAM 3:50">a̱ ka̱lyuwa̱ diga zuva we ene.<verse eid="LAM 3:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51" />Ili i na me enei u zuwa mu ta̱ a̱tsumola̱ngu</para>
  <para style="q2" vid="LAM 3:51">adama a̱ a̱tsuma̱lima̱ a na a cinai esheli a̱ lyuci va̱.<verse eid="LAM 3:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52" />Aza a na a 'yuwan numu babu ufaru,</para>
  <para style="q2" vid="LAM 3:52">a̱ ta̱ tsuten tsa̱ va̱ tsa manunu.<verse eid="LAM 3:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53" />A vari mu ta̱ a̱tsuma̱ a̱ a̱a̱ka̱ri</para>
  <para style="q2" vid="LAM 3:53">a̱vu a vara mu na atali,<verse eid="LAM 3:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54" />mini mo soɗu ta̱ aci a̱ va̱,</para>
  <para style="q2" vid="LAM 3:54">reve me ene gashi za va̱ koto ta̱.<verse eid="LAM 3:54" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55" />A̱sulazuva, n ɗe ta̱ ala a̱ wu,</para>
  <para style="q2" vid="LAM 3:55">diga a̱ a̱ru'un a̱ a̱a̱ka̱ri.<verse eid="LAM 3:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56" />Vu uwwa ta̱ ipati i va̱, &lt;&lt;She vu ula atsuvu a̱ wu</para>
  <para style="q2" vid="LAM 3:56">e mesun ma̱ va̱ me izami yi ikambishi wan!&gt;&gt;<verse eid="LAM 3:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57" />Vu rawa ta̱ zuzu a mantsa ma na n ɗe nuwu,</para>
  <para style="q2" vid="LAM 3:57">a̱vu vu damma mu, &lt;&lt;She vu uwwa wovon wan.&gt;&gt;<verse eid="LAM 3:57" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58" />Zagbain vu tara ta̱ addama a̱ va̱,</para>
  <para style="q2" vid="LAM 3:58">vu tsupaa ta̱ wuma u va̱.<verse eid="LAM 3:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59" />A̱sulazuva, ve ene ta̱ unusu u na a yuwaan numu.</para>
  <para style="q2" vid="LAM 3:59">Vu ge'eto aza a na a̱ ta̱wa̱a̱ numu na addama.<verse eid="LAM 3:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60" />Ve ene ta̱ atsupu e le suru,</para>
  <para style="q2" vid="LAM 3:60">ni ifoɓi i le a aci a̱ va̱ suru.<verse eid="LAM 3:60" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61" />A̱sulazuva, vu uwwa ta̱ wisulusa u le,</para>
  <para style="q2" vid="LAM 3:61">ni ifoɓi i le suru a aci a̱ va̱.<verse eid="LAM 3:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62" />N'yuwatan n va̱ n te yemenu</para>
  <para style="q2" vid="LAM 3:62">na̱ majiyan a aci a̱ va̱ a̱liva̱.<verse eid="LAM 3:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63" />Ka̱lyuwa̱ le! Nden ko mishin,</para>
  <para style="q2" vid="LAM 3:63">a ta yuwusaan mu avandaru a̱tsuma̱ a ishipa i le.<verse eid="LAM 3:63" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64" />A̱sulazuva, tsupa le ili i na yintsayi</para>
  <para style="q2" vid="LAM 3:64">adama e ili i na a yuwain.<verse eid="LAM 3:64" /></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65" />Vu zuwa le o'wo okolo ukwa̱,</para>
  <para style="q2" vid="LAM 3:65">lyawa una̱ wa̱ wu u reme le.<verse eid="LAM 3:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66" />A̱sulazuva, saɓa le a̱tsuma̱ o upan wa̱ wu</para>
  <para style="q2" vid="LAM 3:66">vu kototo le za̱la̱ va zuva va̱ wu.<verse eid="LAM 3:66" /></para>
  <para style="b" />
  <chapter eid="LAM 3" />
  <chapter number="4" style="c" sid="LAM 4" />
  <para style="s">Ili i na i farai ana o kototoi Urishelima</para>
  <para style="q1">O'o! O'o!</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 4:1" />Cine zinariya lambai cece va̱ yi,</para>
  <para style="q2" vid="LAM 4:1">cine zinariya can vadalai wo o'woi da̱n!</para>
  <para style="q1" vid="LAM 4:1">Atali o Uba̱ta̱ wa Akiza</para>
  <para style="q2" vid="LAM 4:1">ubazu lakatala e re gbain suru.<verse eid="LAM 4:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2" />Cine ulobonu u muwun ma̱ Sihiyona n da̱na̱i,</para>
  <para style="q2" vid="LAM 4:2">aza a na ulobonu u le u shi tsa zinariya,</para>
  <para style="q1" vid="LAM 4:2">gogo a tara le ta̱ tso mpondo mo olo'o,</para>
  <para style="q2" vid="LAM 4:2">ulinga we ekere wu ma'in!<verse eid="LAM 4:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3" />Ko musa̱n mu una n tsa apato ta̱ maani</para>
  <para style="q2" vid="LAM 4:3">a kungwato muwun n le,</para>
  <para style="q1" vid="LAM 4:3">amma ama a̱ va̱ o o'wo ta̱ no okolo e iwuya</para>
  <para style="q2" vid="LAM 4:3">tsa azamina a̱ a̱tsumona.<verse eid="LAM 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4" />Elentsu e mereɓu a ta kaɓusa</para>
  <para style="q2" vid="LAM 4:4">a gan vu una̱ va̱ yi adama a akuli.</para>
  <para style="q1" vid="LAM 4:4">Muwun n ta patishi ilyalya,</para>
  <para style="q2" vid="LAM 4:4">agba ko za ca le shi.<verse eid="LAM 4:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5" />Ele na a̱ shi a lyuwusa ilyalya yu uyo'o,</para>
  <para style="q2" vid="LAM 4:5">ele ɗa nda o sowuso a̱tsuma̱lima̱ e re.</para>
  <para style="q1" vid="LAM 4:5">Aza a na a kungwatoi ni itana i san da̱n da̱n<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="ft" closed="false">Itana i san da̱n da̱n a mantsa ma̱ ndeɗe a̱za̱ e ikebe a ɗa o tso oto cu'un vi itana i na i ri na̱ mini mo ndolo shi.</char></note>,</para>
  <para style="q2" vid="LAM 4:5">gogo ele ɗa nda nden a aganga o okomo.<verse eid="LAM 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6" />Oforo a ama a̱ va̱</para>
  <para style="q2" vid="LAM 4:6">a la'a ta̱ za va̱ Sodom,</para>
  <para style="q1" vid="LAM 4:6">za na a̱ mula̱i mantsa wa'a,</para>
  <para style="q2" vid="LAM 4:6">babu za na zuwai ukere u na waa kamba yi.<verse eid="LAM 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7" />Azagbain a̱ yi a̱ shi ta̱ a la'a atayan cece</para>
  <para style="q2" vid="LAM 4:7">waru a la'a ta̱ maani u'uri.</para>
  <para style="q1" vid="LAM 4:7">Lipu le waru la'a ta̱ atali a̱ shili e ikebe,</para>
  <para style="q2" vid="LAM 4:7">o rotso ta̱ atali a safaya.<verse eid="LAM 4:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8" />Agba gogo a la'a ta̱ upondo ulima̱,</para>
  <para style="q2" vid="LAM 4:8">a gura reve ne ele e re shi.</para>
  <para style="q1" vid="LAM 4:8">Ukwan u lipu le u kaɓa ta̱ e etele e le,</para>
  <para style="q2" vid="LAM 4:8">wo o'wo ta̱ u'yewu tsa aaɗanga.<verse eid="LAM 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9" />Aza a na o unai na̱ matsun me pe'eni</para>
  <para style="q2" vid="LAM 4:9">a la'a ta̱ aza a na a̱ kuwa̱i na ambulu.</para>
  <para style="q1" vid="LAM 4:9">A ramba ta̱ na ambulu</para>
  <para style="q2" vid="LAM 4:9">o ulambu wi ilyalya diga a̱ a̱ɗuma̱.<verse eid="LAM 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10" />Ekere a̱ a̱ma̱ci a na a̱ shi e tse ene iliyali</para>
  <para style="q2" vid="LAM 4:10">a su'wan ta̱ muwun n le,</para>
  <para style="q1" vid="LAM 4:10">a̱vu o o'wo le ilyalya</para>
  <para style="q2" vid="LAM 4:10">a mantsa ma na o kototosu ama a̱ va̱.<verse eid="LAM 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11" />A̱sulazuva a̱ ba̱ɗa̱ ta̱ upan wa̱ yi,</para>
  <para style="q2" vid="LAM 4:11">u tsun ta̱ upan wu usuɗuwu wa̱ yi.</para>
  <para style="q1" vid="LAM 4:11">U daɓa ta̱ akina a̱tsuma̱ a̱ Sihiyona</para>
  <para style="q2" vid="LAM 4:11">a na o soɗuyi ikyun ya̱ yi.<verse eid="LAM 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12" />Ngono mu uvaɗi n usu shi,</para>
  <para style="q2" vid="LAM 4:12">ko ama a na a̱ ri nden o uvaɗi,</para>
  <para style="q1" vid="LAM 4:12">a tara a na aza a na a̱ ri a̱ nla̱ngi ko n'yuwatan</para>
  <para style="q2" vid="LAM 4:12">maa gura uwa a̱tsuma̱ a̱ na̱ntsu va̱ Urishelima shi.<verse eid="LAM 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13" />Agba u fara ta̱ adama a̱ nusu va ama̱sula̱ a̱ yi</para>
  <para style="q2" vid="LAM 4:13">ni iwuya i nan ganu a̱ yi,</para>
  <para style="q1" vid="LAM 4:13">aza a na o ocoi mpasa</para>
  <para style="q2" vid="LAM 4:13">ma̱ a̱za̱ a̱ a̱ɓula̱ a̱tsuma̱ a̱ yi.<verse eid="LAM 4:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14" />A̱ da̱na̱ ta̱ e ipapuru a̱tsuma̱ e re</para>
  <para style="q2" vid="LAM 4:14">tsa̱ nrumba̱,</para>
  <para style="q1" vid="LAM 4:14">a̱ lungusa̱ ta̱ aciyele na̱ mpasa,</para>
  <para style="q2" vid="LAM 4:14">hali na ko za aa gura ju'wa̱n a̱tugu e le shi.<verse eid="LAM 4:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15" />Ama a saala le ta̱, &lt;&lt;Tawai pe ure! Tawai pe ure!</para>
  <para style="q2" vid="LAM 4:15">I ta̱ idaba!</para>
  <para style="q2" vid="LAM 4:15">She i ju'wa̱n tsu wan!&gt;&gt;</para>
  <para style="q1" vid="LAM 4:15">Ɗaɗa a sumai reve o o'wo aza a agara,</para>
  <para style="q2" vid="LAM 4:15">ama a nɗa a dansa,</para>
  <para style="q2" vid="LAM 4:15">&lt;&lt;Ee isawan pa oɓolo na̱ a̱tsu shi.&gt;&gt;<verse eid="LAM 4:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16" />A̱sulazuva na aciya̱yi a ɗa e bete'we nle,</para>
  <para style="q2" vid="LAM 4:16">waru u buwa a̱ da̱shi idana le shi.</para>
  <para style="q1" vid="LAM 4:16">A buwa a tarasa nan ganu ili ya̱ a̱ɓula̱ shi,</para>
  <para style="q2" vid="LAM 4:16">waru a buwa a casu mbara tsugbain shi.<verse eid="LAM 4:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17" />Waru esu a̱ tsu a̱ kuna̱ ta̱,</para>
  <para style="q2" vid="LAM 4:17">a̱ a̱ka̱nla̱ e ikambi i pere.</para>
  <para style="q1" vid="LAM 4:17">Tsu zuwa ta̱ esu e izami yi iɗa</para>
  <para style="q2" vid="LAM 4:17">i na yaa wawa tsu shi.<verse eid="LAM 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18" />Ama a̱ kuru ta̱ ana a̱ tsu uba̱ta̱ biti,</para>
  <para style="q2" vid="LAM 4:18">adama o ndolo tsu gura wala a̱tsuma̱ e re gbain tsu shi.</para>
  <para style="q1" vid="LAM 4:18">Ukosu u tsu u shi ta̱ u rawa zuzu, rana tsu shi ta̱ ukecu,</para>
  <para style="q2" vid="LAM 4:18">adama a na ukosu u tsu u shi ta̱ u rawa.<verse eid="LAM 4:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19" />Aza a na aa saɓusa tsu</para>
  <para style="q2" vid="LAM 4:19">a la'a ta̱ a̱kuru ilaɗi,</para>
  <para style="q1" vid="LAM 4:19">a̱ gba̱ra̱ tsu ta̱ a nsasan,</para>
  <para style="q2" vid="LAM 4:19">reve a vawan tsu a̱tsumona.<verse eid="LAM 4:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20" />Za na A̱sulazuva a ɗangwai wivuwun u wuma u tsu,</para>
  <para style="q2" vid="LAM 4:20">e reme yi ta̱ a maza me ele.</para>
  <para style="q1" vid="LAM 4:20">Tsu da̱na̱ ta̱ a majiyan a̱tsuma̱ o ululu wa̱ yi u ɗa</para>
  <para style="q2" vid="LAM 4:20">tsa̱a̱ da̱nu oɓolo na̱ nɗa n ro.<verse eid="LAM 4:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21" />Yuwan ma̱za̱nga̱ vu yuwan mere, a̱ɗu ama a̱ Edom,</para>
  <para style="q2" vid="LAM 4:21">a̱ɗu na i ri na̱ nden e iɗa ya Uz.</para>
  <para style="q1" vid="LAM 4:21">Amma a̱vu fo a ta ca wu a̱tsuma̱lima̱ vu sowo,</para>
  <para style="q2" vid="LAM 4:21">vu to o'wo usowu hali vo o'wo ataɓu.<verse eid="LAM 4:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22" />A̱vu Sihiyona, oforo a̱ wu o to koto,</para>
  <para style="q2" vid="LAM 4:22">wa̱a̱ da̱shi lyawa wu vu jima a̱tsuma̱ a tsugbashi shi.</para>
  <para style="q1" vid="LAM 4:22">Amma a̱vu Edom, u ta ca unusu wa̱ wu oforo,</para>
  <para style="q2" vid="LAM 4:22">a̱vu u pa̱lu'wa̱ iwuya ya̱ wu.<verse eid="LAM 4:22" /></para>
  <para style="b" />
  <chapter eid="LAM 4" />
  <chapter number="5" style="c" sid="LAM 5" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 5:1" />A̱sulazuva, cuwan ni ili i na i cina ntsu!</para>
  <para style="q2" vid="LAM 5:1">Ka̱lyuwa̱ ve ene ili i wono i na i cina ntsu.<verse eid="LAM 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2" />A tara ta̱ agadu a̱ tsu a ca omocin,</para>
  <para style="q2" vid="LAM 5:2">'wa tsu a ca ama o ro.<verse eid="LAM 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3" />Tso o'wo ta̱ mkpa'an.</para>
  <para style="q2" vid="LAM 5:3">Nan mma tsu o o'wo ta̱ tsu nruna̱.<verse eid="LAM 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4" />Tsu ciga tsu 'yuwan tsu tsula mini ma na tsoo sowo,</para>
  <para style="q2" vid="LAM 5:4">ɗanga vu mpondo she tsu tsula.<verse eid="LAM 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5" />Aza a na aa saɓusa tsu</para>
  <para style="q2" vid="LAM 5:5">o to tono tsu ana ana,</para>
  <para style="q1" vid="LAM 5:5">tsu kuna̱ ta̱,</para>
  <para style="q2" vid="LAM 5:5">agba tsu tsura̱ wivuwun shi.<verse eid="LAM 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6" />Tsu ca ta̱ aciya̱tsu e ekere a Masar na̱ Asuriya</para>
  <para style="q2" vid="LAM 5:6">adama tsu tsura̱ ilyalya i na yaa rawa tsu.<verse eid="LAM 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7" />Nkaya n tsu n yuwan ta̱ unusu agba a buwa shi,</para>
  <para style="q2" vid="LAM 5:7">gogo tsu to sowuso oforo o unusu u le.<verse eid="LAM 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8" />Aza a na a̱ ri tsa agbashi a ɗa</para>
  <para style="q2" vid="LAM 5:8">aa yuwusan tsugbain a aci a̱ tsu,</para>
  <para style="q2" vid="LAM 5:8">agba za lo na waa wawa tsu diga e ekere e le shi.<verse eid="LAM 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9" />A̱tsuma̱ e meleshe ma wuma u tsu u ɗa tsa̱a̱ tsurusa̱ ilyalya,</para>
  <para style="q2" vid="LAM 5:9">adama a̱za̱ o uvon a na a̱ ri uka̱nda̱ruwu na̱ lyuci.<verse eid="LAM 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10" />Ukwan u lipu tsu u suɗuwa ta̱ tsa wuwan</para>
  <para style="q2" vid="LAM 5:10">adama o usuɗuwu wa ambulu.<verse eid="LAM 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11" />O to vosun na̱ a̱ma̱ci nu ucira a̱tsuma̱ a̱ Sihiyona,</para>
  <para style="q2" vid="LAM 5:11">ne esheli waru a̱tsuma̱ a̱ mulyuci ma Yahuda.<verse eid="LAM 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12" />A̱ sa̱ga̱do ta̱ azagbain a̱ tsu ne ekere e le,</para>
  <para style="q2" vid="LAM 5:12">a ca mbara tsugbain shi.<verse eid="LAM 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13" />A zuwa ta̱ olobo ulinga nu ucira uba̱ta̱ u yira.</para>
  <para style="q2" vid="LAM 5:13">Muwun n ta̱ takalyuwusa za̱la̱ nu ume wa̱ a̱gba̱la̱.<verse eid="LAM 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14" />Mbara m buwa a̱ da̱nusu o una̱ntsu u lyuci shi,</para>
  <para style="q2" vid="LAM 5:14">olobo waru a lyawa ta̱ yiwa'ishi i le.<verse eid="LAM 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15" />Ma̱za̱nga̱ ma kasa ta̱ no okolo a̱ tsu,</para>
  <para style="q2" vid="LAM 5:15">uje'en u tsu u ka̱mba̱ ta̱ mesun ma̱ a̱tsumola̱ngu.<verse eid="LAM 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16" />Okokolo a tsugbain a̱ riya̱ ta̱ diga a aci a̱ tsu.</para>
  <para style="q2" vid="LAM 5:16">A̱tsuma̱lima̱ a cina tsu ta̱ adama a na tsu yuwan ta̱ unusu.<verse eid="LAM 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17" />Adama o ndolo okolo a̱ tsu a kuɗa ta̱,</para>
  <para style="q2" vid="LAM 5:17">adama e ili i nda esu a̱ tsu a̱ da̱mba̱lya̱ ta̱,<verse eid="LAM 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18" />adama a Masasan ma̱ Sihiyona za na o'woi ofoli,</para>
  <para style="q2" vid="LAM 5:18">na̱ musa̱n mu una a agara pe.<verse eid="LAM 5:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19" />A̱sulazuva, tsugbain tsa̱ wu tsa̱ ri nu ukotu shi,</para>
  <para style="q2" vid="LAM 5:19">otogu o tsugono tsa̱ wu tsa vara ta̱ diga mantsa a̱tyo mantsa.<verse eid="LAM 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20" />Adama a̱ nye vi icinai na̱ a̱tsu kuci?</para>
  <para style="q2" vid="LAM 5:20">Adama a̱ nye vu vari ntsu nu ujumu tsunda?<verse eid="LAM 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21" />A̱sulazuva, ka̱mba̱to tsu uba̱ta̱ wa̱ wu adama tsu ka̱mba̱.</para>
  <para style="q2" vid="LAM 5:21">Ka̱mba̱to rana tsu usa'avu tsu ufaru.<verse eid="LAM 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22" />She de na̱ wo o'wo vu vari tsu ta̱ suru suru,</para>
  <para style="q2" vid="LAM 5:22">reve vu reme upan na̱ a̱tsu babu a̱tyo.<verse eid="LAM 5:22" /></para>
  <chapter eid="LAM 5" />
</usx>