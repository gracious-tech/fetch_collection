<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Tsishingini (tsw)</book>
  <para style="h">Ica</para>
  <para style="toc3">Ica</para>
  <para style="toc2">Ica</para>
  <para style="toc1">Ica</para>
  <para style="mt2">Ica</para>
  <para style="mt1">Ica</para>
  <para style="is">Ucuɗuwu wa aatagada a nda</para>
  <para style="ip">Aatagada e Ica a̱yi ɗa aatagada e ishipa na avasa a Aatagada a Akiza. Ama icu'un icu'un i ɗa a ɗanai niyi hali na u tarai mantsa lon. Ishipa i nda'a na avasa'a a ama a Isra'ila o oɓoloto le ta̱ uba̱ta̱ uta̱ reve e teme ulinga ne le a̱tsuma̱ a̱ a̱ga̱nda̱ ele. Acina ukosu reve oɓolo na akapi aatagada e itoni.</para>
  <para style="ip">Ishipa i na a ɗanai nda'a oɓolo na avasa a nda'a a̱ ta̱ lo icu'un icu'un. A̱ ta̱ na̱ ishipa ya̱ A̱sula̱, na̱ za vu ugodyusho adama e isa'ani ya̱ A̱sula̱. A̱da̱na̱ ta̱ na avasa e izami yi ikambishi, na̱ za mapari na̱ za vi iwawi. A̱da̱na̱ ta̱ na̱ za mesun me izami i gafura oɓolo na̱ za na e ge'eto n'yuwatan. A̱da̱na̱ ta̱ waru na̱ za va̱ a̱ga̱nda̱ a̱ re wuma. A̱da̱na̱ ta̱ ni ishipa i ma̱a̱ 'ya̱wa̱ mo uba̱ta̱ wa̱ a̱ga̱nda̱ na̱ za vu ukatalasa u mogono.</para>
  <para style="ip">Ele avasa a nda'a adama a vuma ɗa oɓolo na̱ za va a ama suru. Ozo o ro ele a̱ ta̱ rocosu cine vuma tsu uwwa a̱tsuma̱ o okolo a̱yi, ozo o ro ele waru a̱ ta̱ rocosu ili i na ama A̱sula̱ a cigai na̱ cine a uwwusa.</para>
  <para style="ip">Yesu yuwan ta̱ ulinga na aatagada e Ica. Aza a na a ɗanai Nzuwulai n Sa'avu waru a yuwan ta̱ ulinga ne ele a̱tsuma̱ a yiɗanishi i le. Diga o ufaru wo oɓolo wa aza a na o tono aatagada e Ica wo o'wo ta̱ aatagada a̱ɓula̱ wa̱ a̱ga̱nda̱ a̱yi. (Urevu wu danshi nda &lt;&lt;Sela<note caller="+" style="f"><char style="fr" closed="false">1:0 </char><char style="fq" closed="false">Sela </char><char style="ft" closed="false">Wivuwun u ɗa a mantsa ma na i ri a yuwusan ishipa.</char></note>&gt;&gt; na̱ Tsuyahuda wu uta̱ a alanga eteshe shi, amma ucuɗuwu u ro u roco ta̱ wivuwun u ɗa a̱tsuma̱ e ishipa.)</para>
  <para style="is">Ili i na i ri pe a̱tsuma̱ a aatagada a nda</para>
  <para style="ip">A̱ ta̱na̱ aatagada e Ica ukpaku na̱ kupoton (150), waru e ne'eshe le ta̱ a̱ tyo aatagada o ton tsu nda:</para>
  <para style="io1">Aatagada o ufaru 1-41</para>
  <para style="io1">Aatagada a̱ ire 42-72</para>
  <para style="io1">Aatagada a ta'atsu 73-89</para>
  <para style="io1">Aatagada a̱ na̱shi 90-106</para>
  <para style="io1">Aatagada a tawun 107-150</para>
  <chapter number="1" style="c" sid="PSA 1" />
  <para style="ms">Aatagada o Ufaru</para>
  <para style="mr">(<ref loc="PSA 1">Ica 1</ref>)</para>
  <para style="s">Wuma wa̱ a̱ɓula̱ na̱ za vi iwuya</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1" />Za ma̱za̱nga̱ ɗa vuma na</para>
  <para style="q2" vid="PSA 1:1">tsu toni a̱sa̱la̱ a̱za̱ e iwuya shi,</para>
  <para style="q1" vid="PSA 1:1">ko u toni ure wa̱ a̱za̱ o unusu shi,</para>
  <para style="q2" vid="PSA 1:1">ko u da̱nu oɓolo na̱ a̱za̱ o ulamu.<verse eid="PSA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2" />Amma u ta uwwusa uyo'o</para>
  <para style="q2" vid="PSA 1:2">u yuwan tsutoni na̱ wila̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 1:2">waru a yuwusan majiyan ma̱ wila̱'a̱ usana na ayin.<verse eid="PSA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3" />U ta̱ tsu uɗanga</para>
  <para style="q2" vid="PSA 1:3">u na a̱ shuwa̱i e ikyun yu uɗolu,<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="JER 17:8">Irm 17:8</ref>.</char></note></para>
  <para style="q1" vid="PSA 1:3">za na tsu matsan a mantsa ma̱ yi,</para>
  <para style="q2" vid="PSA 1:3">waru a̱vu'un a̱ yi a̱ tsu kpanla shi.</para>
  <para style="q1" vid="PSA 1:3">Ili i na u yuwain suru, u tsu tsura̱ ta̱ ulyuwu we elime.<verse eid="PSA 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4" />Amma a̱za̱ e iwuya</para>
  <para style="q2" vid="PSA 1:4">a̱ ri ne shi.</para>
  <para style="q1" vid="PSA 1:4">A̱ ta̱ tso owopo</para>
  <para style="q2" vid="PSA 1:4">a na upepu u tsu pura̱.<verse eid="PSA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5" />A̱za̱ e iwuya</para>
  <para style="q2" vid="PSA 1:5">a la'a diga uba̱ta̱ o uge'etosu shi,</para>
  <para style="q1" vid="PSA 1:5">ko a̱za̱ o unusu a̱tsura̱ uba̱ta̱</para>
  <para style="q2" vid="PSA 1:5">a̱tsuma̱ e iɓolo ya̱ a̱za̱ a̱ a̱ɓula̱ shi.<verse eid="PSA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6" />Adama a na A̱sulazuva</para>
  <para style="q2" vid="PSA 1:6">a̱ ta̱ e idanasa mmalu ma̱ a̱za̱ a̱ a̱ɓula̱,</para>
  <para style="q1" vid="PSA 1:6">amma linga va̱ a̱za̱ e iwuya</para>
  <para style="q2" vid="PSA 1:6">u ta̱ 'ya̱wa̱to le o ukwisa̱.<verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" sid="PSA 2" />
  <para style="s">Mogono ma na A̱sulazuva a tawai</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1" />Nye i zuwai nɗa</para>
  <para style="q2" vid="PSA 2:1">m ɓoloi a̱ 'ya̱sa̱in aci?<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="ACT 4:25-26">Ajy 4:25-26</ref>; <ref loc="REV 11:18">Wen 11:18</ref>.</char></note></para>
  <para style="q1" vid="PSA 2:1">Nye i zuwai e elentsu</para>
  <para style="q2" vid="PSA 2:1">a yuwusan ifoɓi ye pere?<verse eid="PSA 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2" />Nye i zuwai ngono mu uvaɗi</para>
  <para style="q2" vid="PSA 2:2">o foɓoi uvon?</para>
  <para style="q1" vid="PSA 2:2">Nye i zuwai a̱za̱ a̱ tsugono</para>
  <para style="q2" vid="PSA 2:2">o ɓoloi aci,</para>
  <para style="q1" vid="PSA 2:2">a yuwusan tsushu'un na̱ A̱sulazuva</para>
  <para style="q2" vid="PSA 2:2">oɓolo na̱ mogono ma na u tawai?<verse eid="PSA 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3" />Adansa,</para>
  <para style="q2" vid="PSA 2:3">&lt;&lt;Lyawa tsu uta̱a̱ aciya̱tsu diga o tsugono tsa̱ ele,</para>
  <para style="q2" vid="PSA 2:3">na̱ tsugono tsa̱ A̱sulazuva</para>
  <para style="q1" vid="PSA 2:3">oɓolo na̱ mogono ma na u tawai,</para>
  <para style="q2" vid="PSA 2:3">tsu fa̱tsa̱ e ekere ele.&gt;&gt;<verse eid="PSA 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4" />Amma A̱sulazuva o zo'oso le ta̱,</para>
  <para style="q2" vid="PSA 2:4">diga Ootogu o tsugono tsa̱ yi ɗe zuva.</para>
  <para style="q2" vid="PSA 2:4">Reve u zuwa le o o'wo ili yu ulamu.<verse eid="PSA 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5" />Reve u ɓara le nu upan,</para>
  <para style="q2" vid="PSA 2:5">a̱vu upan wa̱ yi wu da'waton le lon.<verse eid="PSA 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6" />A̱vu u damma,</para>
  <para style="q2" vid="PSA 2:6">&lt;&lt;N zuwa ta̱ mogono ma̱ va̱,</para>
  <para style="q2" vid="PSA 2:6">ɗe Sihiyona<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="fq" closed="false">Sihiyona </char><char style="ft" closed="false">Aala a nda a ɗa a ca yi Lyuci va̱ Da̱wuda, ko Urishelima, a mantsa ma na u lyuwai a̱za̱ a̱ Jebusiya nu uvon. Aala'a na̱ a̱ca̱pa̱ a nda ɗa u ta̱wa̱ wo o'woi uba̱ta̱ u na U'wa wa A̱sulazuva a̱ ri.</char></note> Aagaɗi Akiza a̱ va̱.&gt;&gt;<verse eid="PSA 2:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 2:7" />A̱vu mogono'o u damma,</para>
  <para style="q2" vid="PSA 2:7">&lt;&lt;N ta yuwan adanshi e ili i na A̱sulazuva a dammai.<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="ACT 13:33">Ajy 13:33</ref>; <ref loc="HEB 1:5">M.Ib 1:5</ref>; <ref loc="HEB 5:5">5:5</ref>.</char></note></para>
  <para style="q1" vid="PSA 2:7">A̱vu A̱sulazuva a damma mu, &lt;A̱vu mawun ma̱ va̱ ma ɗa,</para>
  <para style="q2" vid="PSA 2:7">ana'an mo o'wo ta̱ dada va̱ wu.<verse eid="PSA 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8" />Pati mu,</para>
  <para style="q2" vid="PSA 2:8">n ta ca wu nɗa mo o'wo agadu a̱ wu,</para>
  <para style="q2" vid="PSA 2:8">uvaɗi ma̱ɓula̱ u to o'wo za va̱ wu.<verse eid="PSA 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9" />Vu ta yuwan tsugono tsa̱ le na aaɗanga a̱ rumu,<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="REV 2:26-27">Wen 2:26-27</ref>; <ref loc="REV 12:5">12:5</ref>; <ref loc="REV 19:15">19:15</ref>.</char></note></para>
  <para style="q2" vid="PSA 2:9">vu to ɓuɓoso le tsa ayimba.&gt; &gt;&gt;<verse eid="PSA 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10" />Gogo gba, i yuwan ugbozu,</para>
  <para style="q2" vid="PSA 2:10">a̱ɗu ngono,</para>
  <para style="q1" vid="PSA 2:10">i ka̱mbuwa̱ ugbozu,</para>
  <para style="q2" vid="PSA 2:10">a̱ɗu a̱za̱ a̱ tsugono tsu uvaɗi.<verse eid="PSA 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11" />I yuwaan A̱sulazuva a̱ga̱nda̱ na̱ wovon,</para>
  <para style="q2" vid="PSA 2:11">na̱ meje'en ma̱ lipu.<verse eid="PSA 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12" />I ka̱ɗa̱to a̱ ma̱ka̱ka̱n ma̱ yi,<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="fq" closed="false">yi </char><char style="ft" closed="false">Aatagada o ro avadala ta̱ &lt;&lt;yi&gt;&gt; a̱ tyo &lt;&lt;mawun.&gt;&gt;</char></note></para>
  <para style="q2" vid="PSA 2:12">na̱ ne ɗa shi upan wa̱ yi u ta̱ 'yon</para>
  <para style="q2" vid="PSA 2:12">a̱vu i kuwa̱,</para>
  <para style="q1" vid="PSA 2:12">adama a na upan wa̱ yi u tsu la̱pa̱ 'yon shi.</para>
  <para style="b" vid="PSA 2:12" />
  <para style="q1" vid="PSA 2:12">A̱za̱ a̱ ma̱za̱nga̱ a ɗa</para>
  <para style="q2" vid="PSA 2:12">aza a na suru a zama upa'atan uba̱ta̱ wa̱ yi.<verse eid="PSA 2:12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" sid="PSA 3" />
  <para style="s">Avasa o usana adama e izami yi ikambishi</para>
  <para style="d">Ica ya̱ Da̱wuda a mantsa ma na u sumaayi ulobo wa̱ yi Absalom.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 3:1">n'yuwatan n va̱ a̱ ta̱ a̱bunda̱!</para>
  <para style="q2" vid="PSA 3:1">Aza a na a yuwusan tsushu'un na̱ mu fo a̱ ta̱ a̱bunda̱.<verse eid="PSA 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2" />Na̱ a̱bunda̱ a ta yuwusan adanshi a aciya̱va̱ adansa,</para>
  <para style="q2" vid="PSA 3:2">&lt;&lt;A̱sula̱ a wawa yi shi!&gt;&gt;<verse eid="PSA 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3" />Amma a̱vu A̱sulazuva,</para>
  <para style="q2" vid="PSA 3:3">a̱vu ɗa mapari ma̱ va̱ uba̱ta̱ suru.</para>
  <para style="q1" vid="PSA 3:3">A̱vu ɗa va̱ 'ya̱susa̱n mu,</para>
  <para style="q2" vid="PSA 3:3">waru va casu mu tsugbain.<verse eid="PSA 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4" />Uba̱ta̱ wa̱ A̱sulazuva a ɗa</para>
  <para style="q2" vid="PSA 3:4">n tsu zami ikambishi,</para>
  <para style="q1" vid="PSA 3:4">waru u tsu usu mu ta̱</para>
  <para style="q2" vid="PSA 3:4">diga a Masasan ma Akiza a̱ yi.<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="PSA 2:6">Ica 2:6</ref>.</char></note><verse eid="PSA 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5" />N tsu von ta̱ n lantsa,</para>
  <para style="q2" vid="PSA 3:5">reve n 'yon gbaga,</para>
  <para style="q1" vid="PSA 3:5">adama a na A̱sulazuva a ɗa mapari ma̱ va̱.<verse eid="PSA 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6" />Maa uwwusa wovon wa ama ukpakukupa kupa shi</para>
  <para style="q2" vid="PSA 3:6">aza a na a yuwusan tsushu'un na̱ mu uba̱ta̱ suru.<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="PSA 27:3">Ica 27:3</ref>.</char></note><verse eid="PSA 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7" />'Yon, A̱sulazuva!</para>
  <para style="q2" vid="PSA 3:7">Vu wawa mu, A̱sula̱ a̱ va̱!</para>
  <para style="q1" vid="PSA 3:7">Vu lyuwa aci a n'yuwatan n va̱ suru,</para>
  <para style="q2" vid="PSA 3:7">waru vu kototo a̱za̱ e iwuya suru!<verse eid="PSA 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8" />Iwawi i tsu ta̱wa̱ ta̱ diga uba̱ta̱ wa̱ A̱sulazuva.<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="JON 2:10">Yun 2:10</ref>.</char></note></para>
  <para style="q2" vid="PSA 3:8">Lyawa u zuwaa aa ama a̱yi aba'un.<verse eid="PSA 3:8" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" sid="PSA 4" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Ni itana i tsuwe'e ya akiza. Ica ya̱ Da̱wuda.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1" />Vu usu mu a mantsa ma na n ɗeyi,</para>
  <para style="q2" vid="PSA 4:1">A̱sula̱ a̱ va̱, za na tsu roco,</para>
  <para style="q2" vid="PSA 4:1">a̱mu za babu unusu ɗa!</para>
  <para style="q1" vid="PSA 4:1">Vu tawaa mu a̱tsuma̱lima̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 4:1">vee ene iliyali i va̱, vu uwwa avasa a̱ va̱.<verse eid="PSA 4:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2" />A̱ɗu ama a nda,</para>
  <para style="q2" vid="PSA 4:2">hali a cina mantsa ma̱ ne ma ɗa</para>
  <para style="q2" vid="PSA 4:2">ya lyawa a̱ lungususa̱ aala a̱ va̱?</para>
  <para style="q1" vid="PSA 4:2">Hali mantsa ma̱ ne ma ɗa ya</para>
  <para style="q2" vid="PSA 4:2">lyawa icigi ya adanshi e pere ne epen?<verse eid="PSA 4:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3" />I gura reve,</para>
  <para style="q2" vid="PSA 4:3">A̱sulazuva a ɗangulaa ta̱ aciya̱yi</para>
  <para style="q2" vid="PSA 4:3">a̱za̱ a̱ cu'un vo okolo a̱yi,</para>
  <para style="q1" vid="PSA 4:3">A̱sulazuva a ta uwwa mu,</para>
  <para style="q2" vid="PSA 4:3">a mantsa ma na n ɗe niyi.<verse eid="PSA 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4" />Nna̱ i yuwan upan,</para>
  <para style="q2" vid="PSA 4:4">she u zuwa ɗu i yuwan unusu wan.<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="EPH 4:26">Afi 4:26</ref>.</char></note></para>
  <para style="q1" vid="PSA 4:4">I yuwan majiyan me e ili ya nda kpen o okolo a̱ɗu,</para>
  <para style="q2" vid="PSA 4:4">a mantsa ma na i voyin a̱ga̱da̱ a̱ɗu.<verse eid="PSA 4:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5" />I ca A̱sulazuva</para>
  <para style="q2" vid="PSA 4:5">kucci na ntsayi,</para>
  <para style="q2" vid="PSA 4:5">waru i zuwa ucira u ɗu uba̱ta̱ wa̱ yi.<verse eid="PSA 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6" />Ama na̱ a̱bunda̱ a ta dansa,</para>
  <para style="q2" vid="PSA 4:6">&lt;&lt;Zane ɗa o roco tsu isa'ani!&gt;&gt;</para>
  <para style="q1" vid="PSA 4:6">Amma A̱sulazuva,</para>
  <para style="q2" vid="PSA 4:6">vu ka̱lyuwa̱ tsu ne esu asa'ani.<verse eid="PSA 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7" />Vu shiton ta̱ okolo a̱ va̱ na̱ ma̱za̱nga̱ lon,</para>
  <para style="q2" vid="PSA 4:7">ma na ma la'ai</para>
  <para style="q2" vid="PSA 4:7">aza a na a̱ ri ni ishina na̱ masayan ma̱ inabi ma̱ a̱bunda̱.<verse eid="PSA 4:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8" />N to von a̱vu n lantsa na asuvu nden,</para>
  <para style="q2" vid="PSA 4:8">adama a na a̱vu ɗa goon mapari ma̱ va̱.<verse eid="PSA 4:8" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" sid="PSA 5" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Adama a̱ wivulusa̱ wu gbala. Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 5:1">vu poloo adanshi a̱ va̱ atsuvu,</para>
  <para style="q2" vid="PSA 5:1">waru vu uwwa ma̱nga̱ mo okolo a̱ va̱.<verse eid="PSA 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2" />Mogono ma̱ va̱ A̱sula̱ a̱ va̱!</para>
  <para style="q2" vid="PSA 5:2">Vu uwwa mesun ma̱ va̱ mee izami yi ikambishi.</para>
  <para style="q2" vid="PSA 5:2">Adama a na e ekere a̱ wu ɗa maa yuwusan avasa.<verse eid="PSA 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3" />Nu usana vu tsu uwwa ta̱ avasa a̱ va̱.</para>
  <para style="q2" vid="PSA 5:3">Urana a̱ ma̱ɓa̱tsa̱a̱ waru n tsu ta̱wa̱ ta̱ ni ipati i va̱,</para>
  <para style="q2" vid="PSA 5:3">waru m puro usuwu wa̱ wu.<verse eid="PSA 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4" />Adama a na a̱vu</para>
  <para style="q2" vid="PSA 5:4">A̱sula̱ ɗa na uwwusa uyo'o wi iwuya shi.</para>
  <para style="q1" vid="PSA 5:4">Waru vu tsu lyawa a̱za̱ e iwuya,</para>
  <para style="q2" vid="PSA 5:4">a̱ ta̱wa̱ elime wu shi.<verse eid="PSA 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5" />Aza aciyogbamu,</para>
  <para style="q2" vid="PSA 5:5">aa gura e isawan a̱ ma̱ka̱ka̱n ma̱ wu shi,</para>
  <para style="q2" vid="PSA 5:5">vu 'yuwan ta̱ aza a na a yuwusan iwuya.<verse eid="PSA 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6" />Vu tsu kototo ta̱ aza a na a yuwusan epen,</para>
  <para style="q2" vid="PSA 5:6">Vu ta̱ e nda tsugya va aza a na o ocosu mpasa oɓolo na̱ a̱za̱ a̱ wulumu.<verse eid="PSA 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7" />Agba a̱mu,</para>
  <para style="q2" vid="PSA 5:7">e ekere e icigi ya̱ wu i na i tsu vadala shi,</para>
  <para style="q1" vid="PSA 5:7">n ta uwa a̱tsuma̱ o u'wa wa̱ wu,</para>
  <para style="q2" vid="PSA 5:7">n yuwan a̱ga̱nda̱ a̱tsuma̱ A̱a̱'isamapaɗa a akiza a̱ wu,</para>
  <para style="q2" vid="PSA 5:7">a̱vu n kingyo n yuwan wu a̱ga̱nda̱ a̱tsuma̱ A̱a̱'isamapaɗa a̱ wu.<verse eid="PSA 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8" />A̱sulazuva, vu rono mu aaɗanga a̱tsuma̱ a̱ a̱ɓula̱ a̱ wu.</para>
  <para style="q2" vid="PSA 5:8">Adama a na n'yuwatan n va̱ n yuwan ta̱ a̱bunda̱.</para>
  <para style="q2" vid="PSA 5:8">Vu roco mu ure wa̱ wu a alanga e eteshe tsa̱ra̱ n toni.<verse eid="PSA 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9" />Na̱ le ri na amayun shi,<note caller="-" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="ROM 3:13">Rom 3:13</ref>. </char></note></para>
  <para style="q2" vid="PSA 5:9">okolo ele tapu ɗa u ri na̱ majiyan mo ukototosu,</para>
  <para style="q1" vid="PSA 5:9">waru a̱la̱kutsu e le ason ɗa,</para>
  <para style="q2" vid="PSA 5:9">elentsu ele fo idanshi ye epen ɗa.<verse eid="PSA 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10" />A̱sula̱! Lyawa le a tanu nusu le,</para>
  <para style="q2" vid="PSA 5:10">vu zuwa ifoɓi iwuya i le i ka̱mba̱ aciyele.</para>
  <para style="q1" vid="PSA 5:10">Vu gba̱ra̱ le diga elime a̱ wu,</para>
  <para style="q2" vid="PSA 5:10">adama a̱bunda̱ a̱ nusu le,</para>
  <para style="q2" vid="PSA 5:10">adama a na a̱ 'ya̱sa̱a̱n nuwu a aci.<verse eid="PSA 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11" />Amma lyawa aza a na a pa'asan ya̱'a̱ wu,</para>
  <para style="q2" vid="PSA 5:11">a yuwan ma̱za̱nga̱.</para>
  <para style="q1" vid="PSA 5:11">Lyawa le a̱ da̱na̱ e ishipa i ma̱za̱nga̱.</para>
  <para style="q2" vid="PSA 5:11">Vu pala le ne evelu a̱ wu,</para>
  <para style="q1" vid="PSA 5:11">adama a̱za̱ e icigi yaa aala a̱ wu,</para>
  <para style="q2" vid="PSA 5:11">a yuwan ma̱za̱nga̱ adama a̱ wu.<verse eid="PSA 5:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 5:12">na amayun, vu zuwaa ta̱ a̱za̱ a̱ a̱ɓula̱ aba'un!</para>
  <para style="q1" vid="PSA 5:12">Isa'ani ya̱ wu i ta̱ oɓolo ne ele tsa̱ a̱a̱ra̱ga̱.<verse eid="PSA 5:12" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" sid="PSA 6" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Ni itana i tsuwe'e yi kumburu o una̱ wa̱ Shemini<note caller="+" style="f"><char style="fr" closed="false">6:0 </char><char style="fq" closed="false">Shemini </char><char style="ft" closed="false">A̱yi nda idanshi yi ishipa i ɗa, ko waru za yiwa'ishi i ɗa. Idana Ica 12 waru.</char></note>. Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 6:1">she vu ɓara mu a̱tsuma̱ o upan wa̱ wu wan,<note caller="-" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="PSA 38:1">Ica 38:1</ref>; <ref loc="JER 10:24">Irm 10:24</ref>. </char></note></para>
  <para style="q2" vid="PSA 6:1">she vu foro mu a̱tsuma̱ o upan wu usuɗu wa̱ wu wan.<verse eid="PSA 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 6:2">vee ene iliyali i va̱, n ta̱ ma̱kuwa̱ ben ben,</para>
  <para style="q2" vid="PSA 6:2">etele a̱ va̱ a̱ ta̱ka̱lyuwa̱ ta̱ lon, vu da̱shi mu ucira!<verse eid="PSA 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 6:3">n ta̱ pe a̱tsuma̱lima̱ lon,</para>
  <para style="q2" vid="PSA 6:3">hali mantsa ma̱ ne ma ɗa woo koto?<verse eid="PSA 6:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4" />A̱sulazuva ta̱wa̱,</para>
  <para style="q2" vid="PSA 6:4">vu wawa mu!</para>
  <para style="q1" vid="PSA 6:4">Vu wawa mu,</para>
  <para style="q2" vid="PSA 6:4">adama e icigi ya̱ wu i na i tsu vadala shi.<verse eid="PSA 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5" />Adama a na a̱tsuma̱ a̱kwa̱kwa̱,</para>
  <para style="q2" vid="PSA 6:5">zane ɗa a cuwan na̱ a̱vu?</para>
  <para style="q1" vid="PSA 6:5">Za lo na wa cuwa wu,</para>
  <para style="q2" vid="PSA 6:5">a̱tsuma̱ a aason shi.<verse eid="PSA 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6" />N kuna̱ ta̱ suru suru adama a̱tsuma̱lima̱,</para>
  <para style="q1" vid="PSA 6:6">ayin ma̱ɓula̱,</para>
  <para style="q2" vid="PSA 6:6">n tsu re'weto ta̱ a̱a̱ga̱da̱ a̱ va̱ na aɓara,</para>
  <para style="q1" vid="PSA 6:6">n tsu re'weto ta̱ ili i buku ya aci i va̱,</para>
  <para style="q2" vid="PSA 6:6">na aɓara.<verse eid="PSA 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7" />Esu a̱ va̱ a tsutsa ta̱,</para>
  <para style="q2" vid="PSA 6:7">nu usa̱n u ɗa me eneshe,</para>
  <para style="q1" vid="PSA 6:7">adama a̱bunda̱ a̱ mesun ma̱ va̱,</para>
  <para style="q2" vid="PSA 6:7">mesun ma na n'yuwatan n va̱ n zuwa numu.<verse eid="PSA 6:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8" />Lyawa numu, a̱ɗu a̱za̱ e iwuya!<note caller="-" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="MAT 7:23">Mat 7:23</ref>; <ref loc="LUK 13:27">Luk 13:27</ref>.</char></note></para>
  <para style="q2" vid="PSA 6:8">Adama a na A̱sulazuva a uwwa ta̱ ɗe mesun ma̱ va̱.<verse eid="PSA 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9" />A̱sulazuva a uwwa ta̱ ɗe ipati i va,</para>
  <para style="q2" vid="PSA 6:9">waru u usu ta̱ avasa a̱ va̱.<verse eid="PSA 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10" />Lyawa n'yuwatan n va̱ suru a uwwa wono,</para>
  <para style="q2" vid="PSA 6:10">waru a da'wan lon.</para>
  <para style="q1" vid="PSA 6:10">Lyawa a vadala babu usa̱n a̱ ka̱mba̱ na̱ wono.<verse eid="PSA 6:10" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" sid="PSA 7" />
  <para style="d">Tsuwe'e tso o ro ya̱ Da̱wuda, za na u yuwayin A̱sulazuva adama a̱ Kush, vuma va Banyami.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 7:1" />A̱sulazuva A̱sula̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 7:1">uba̱ta̱ wa̱ wu u ɗa maa zama upa'atan.</para>
  <para style="q1" vid="PSA 7:1">Vu wawa mu diga e ekere aza a na a azama wuma u va̱,</para>
  <para style="q2" vid="PSA 7:1">vu yuwaan mu mapari.<verse eid="PSA 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2" />Na̱ ne ɗa shi,</para>
  <para style="q2" vid="PSA 7:2">aa ta tara mu</para>
  <para style="q2" vid="PSA 7:2">a̱ tyo uba̱ta̱ u na babu za na a wawa mu.</para>
  <para style="q1" vid="PSA 7:2">Ɗe ɗa a kakara mu,</para>
  <para style="q2" vid="PSA 7:2">ununa kamu tsu yuwan.<verse eid="PSA 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3" />A̱sulazuva A̱sula̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 7:3">n na̱ yuwan ta̱ unusu,</para>
  <para style="q2" vid="PSA 7:3">hali na a̱ tsura̱i unusu e ekere a̱ va̱,<verse eid="PSA 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 7:4" />n na̱ m paala ta̱ ɗe i'utsa̱ i va̱,</para>
  <para style="q2" vid="PSA 7:4">ko babu ufaru n paala ma'yuwatan ma̱ va̱,<verse eid="PSA 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5" />to, lyawa n'yuwatan n va̱</para>
  <para style="q2" vid="PSA 7:5">n saɓa mu e reme mu.</para>
  <para style="q1" vid="PSA 7:5">Lyawa a dadasa a̱mu e iɗa,</para>
  <para style="q2" vid="PSA 7:5">hali na a lyawa mu e iɗa ukwa̱.<verse eid="PSA 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6" />'Yon, A̱sulazuva,</para>
  <para style="q2" vid="PSA 7:6">a̱tsuma̱ o upan wa̱ wu,</para>
  <para style="q2" vid="PSA 7:6">vu yuwan nla̱ngi nu upan wu n'yuwatan n va̱.</para>
  <para style="q1" vid="PSA 7:6">'Yon, A̱sula̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 7:6">vu kamba mu,</para>
  <para style="q2" vid="PSA 7:6">vu yuwan uge'etosu u mejege.<verse eid="PSA 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7" />Lyawa o ɓoloto elentsu suru uba̱ta̱ wa̱ wu,</para>
  <para style="q2" vid="PSA 7:7">vu yuwan tsugono tsa̱ ele diga zuva.<verse eid="PSA 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 7:8" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 7:8">a̱vu ɗa za na e ge'etosu nɗa suru.</para>
  <para style="q1" vid="PSA 7:8">A̱sulazuva,</para>
  <para style="q2" vid="PSA 7:8">vu ge'eto mu o una̱ wa̱ a̱ɓula̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 7:8">adama a na vu reve ta̱ naa n ri nu unusu shi.<verse eid="PSA 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9" />A̱sula̱ za va̱ a̱ɓula̱,</para>
  <para style="q2" vid="PSA 7:9">a̱vu ɗa za na tsu reve majiyan oɓolo no okolo a ama.</para>
  <para style="q1" vid="PSA 7:9">Lyawa vi isawaton iwuya ya̱ a̱za̱ e iwuya,</para>
  <para style="q2" vid="PSA 7:9">a̱vu vu tsupaa ama a̱ɓula̱.<verse eid="PSA 7:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10" />A̱sula̱ a ɗa a̱a̱ra̱ga̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 7:10">waru u tsu wawa ta̱ a̱za̱ tsutoni na̱ yi.<verse eid="PSA 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11" />A̱sula̱ za vu uge'etosu wa̱ a̱ɓula̱ a ɗa.</para>
  <para style="q2" vid="PSA 7:11">Za na tsu ge'eto a̱za̱ e iwuya mantsa suru.<verse eid="PSA 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12" />N na̱ vuma vadala shi,</para>
  <para style="q2" vid="PSA 7:12">A̱sula̱ a̱ te tewen matsun me pe'eni ma̱ yi,</para>
  <para style="q2" vid="PSA 7:12">waru u foɓo ta̱ ɗe utan wa̱ yi.<verse eid="PSA 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13" />U foɓo ta̱ ɗe itana yu uvon i tsukono tsa̱ yi,</para>
  <para style="q2" vid="PSA 7:13">waru u satsu ta̱ ɗe iliya ya akina ya̱ yi.<verse eid="PSA 7:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14" />Ka̱lyuwa̱ cine a̱za̱ e iwuya,</para>
  <para style="q2" vid="PSA 7:14">a̱ ri utanuwu na̱ a̱a̱tsuma̱ e iwuya,</para>
  <para style="q1" vid="PSA 7:14">a̱ ta̱ na̱ a̱a̱tsuma̱ o mokoɗo,</para>
  <para style="q2" vid="PSA 7:14">waru a ta matsusan epen.<verse eid="PSA 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15" />A̱ ta̱ ka̱pusa̱ a̱ka̱ri a̱ a̱ru'un,</para>
  <para style="q2" vid="PSA 7:15">waru a̱ ta̱ riya̱ a yakuru na a azuyi.<verse eid="PSA 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16" />O foɓoo ta̱ ozo o ro ibili,</para>
  <para style="q2" vid="PSA 7:16">amma a̱vu u vadala aciyele.</para>
  <para style="q1" vid="PSA 7:16">Waru o foɓo ta̱ u'ya̱susa̱n wu ugbozu,</para>
  <para style="q2" vid="PSA 7:16">agba a̱ yi ɗa nda u vadalai aci ele.<verse eid="PSA 7:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17" />N ta̱ godyowo A̱sulazuva,</para>
  <para style="q2" vid="PSA 7:17">adama o uge'etosu wa̱ a̱ɓula̱ a̱yi,</para>
  <para style="q1" vid="PSA 7:17">waru n ta cana ishipa yi ica</para>
  <para style="q2" vid="PSA 7:17">a̱ tyo uba̱ta̱ wa̱ A̱sulazuva za na La'ai Tsugbain.<verse eid="PSA 7:17" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" sid="PSA 8" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. O una̱ wa &lt;&lt;Giti.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">8:0 </char><char style="fq" closed="false">Giti </char><char style="ft" closed="false">Danshi i nda za vu uɗyo wi ishipa i ɗa, ko za tsuwe'e tso o ro. </char></note> Ica ya̱ Da̱wuda.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1" />A̱sulazuva, A̱sulazuva a̱ tsu,</para>
  <para style="q2" vid="PSA 8:1">e reve ta̱ na̱ tsugbain tsa Aala a̱ wu</para>
  <para style="q2" vid="PSA 8:1">a̱tsuma̱ o uvaɗi suru!</para>
  <para style="q1" vid="PSA 8:1">A̱vu na ica ya̱ wu</para>
  <para style="q2" vid="PSA 8:1">i rawai zuva va zuva!<verse eid="PSA 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2" />Vu zuwa ta̱ ica ya̱ wu yu uta̱,</para>
  <para style="q2" vid="PSA 8:2">diga o una̱ u muwun na̱ nreɓu. <note caller="-" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="MAT 21:16">Mat 21:16</ref>.</char></note></para>
  <para style="q1" vid="PSA 8:2">Ica ya̱ wu yo o'wo ta̱</para>
  <para style="q2" vid="PSA 8:2">ukari e ekere a n'yuwatan ma̱ wu,</para>
  <para style="q1" vid="PSA 8:2">adama e isawaton aza a na a 'yuwan nuwu</para>
  <para style="q2" vid="PSA 8:2">oɓolo na aza a na a cigai a tsupa.<verse eid="PSA 8:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3" />A mantsa ma na n ka̱lyuwa̱i zuva,</para>
  <para style="q2" vid="PSA 8:3">ulinga wu ukere wa̱ wu,</para>
  <para style="q1" vid="PSA 8:3">woto ni italyo'o</para>
  <para style="q2" vid="PSA 8:3">na vu zuwai uba̱ta̱ u le,<verse eid="PSA 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4" />reve n damma,</para>
  <para style="q2" vid="PSA 8:4">&lt;&lt;Za ne ɗa vaɗilima̱ na vu ri aɗa a̱ yi,<note caller="-" style="x"><char style="xo" closed="false">8:4 </char><char style="xt" closed="false"><ref loc="PSA 144:3">Ica 144:3</ref>; <ref loc="HEB 2:6-8">M.Ib 2:6-8</ref>.</char></note></para>
  <para style="q2" vid="PSA 8:4">na vaa idanasa yi?&gt;&gt;<verse eid="PSA 8:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5" />Na̱ ne suru ili yi lo na la'ai vaɗilima̱ shi,</para>
  <para style="q2" vid="PSA 8:5">she a̱vu goon,<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">babu a̱vu babu lo ili i na i la'ai vaɗilima̱: Urevu wi danshi i nda uba̱ta̱ u ro a̱yi ɗa, &lt;&lt;Vu yuwan ta̱ vuma uka̱la̱mu na̱ nlingata.&gt;&gt;</char></note></para>
  <para style="q2" vid="PSA 8:5">hali na vu ca niyi tsugbain</para>
  <para style="q2" vid="PSA 8:5">vu tara niyi na̱ a̱ɓula̱.<verse eid="PSA 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6" />Na vu zuwa niyi u yuwan tsugono,</para>
  <para style="q2" vid="PSA 8:6">aci e ili i na vu yuwain suru.<note caller="-" style="x"><char style="xo" closed="false">8:6 </char><char style="xt" closed="false"><ref loc="1CO 15:27">1 Kor 15:27</ref>; <ref loc="EPH 1:22">Afi 1:22</ref>; <ref loc="HEB 2:8">M.Ib 2:8</ref>.</char></note></para>
  <para style="q1" vid="PSA 8:6">Hali na vu zuwai ili suru za̱la̱ vu ucira va̱ yi,<verse eid="PSA 8:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="PSA 8:7" />ni ikyon ni inan,</para>
  <para style="q2" vid="PSA 8:7">ni inama yu una suru,<verse eid="PSA 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8" />na̱ nnunu na̱ mugula,</para>
  <para style="q2" vid="PSA 8:8">na̱ cu'un vi ili i wuma i na i ri a̱tsuma̱ a mala suru.<verse eid="PSA 8:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9" />A̱sulazuva, A̱sulazuva a̱ tsu,</para>
  <para style="q2" vid="PSA 8:9">e reve ta̱ na̱ tsugbain tsa̱ a̱ wu</para>
  <para style="q2" vid="PSA 8:9">a̱tsuma̱ o uvaɗi suru!<verse eid="PSA 8:9" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" sid="PSA 9" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Nu uɗyo &lt;&lt;Wu Ukwa̱ u Mawun.&gt;&gt; Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 9:1" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 9:1">n to godyoo wu no okolo a̱ va̱ suru,</para>
  <para style="q1" vid="PSA 9:1">n ta damma ili i na vu yuwain suru,</para>
  <para style="q2" vid="PSA 9:1">yi linga va̱ wu va asalama suru.<verse eid="PSA 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2" />A̱vu za na La'ai Tsugbain,</para>
  <para style="q2" vid="PSA 9:2">n ta yuwan ma̱za̱nga̱ na̱ mere adama a̱ wu,</para>
  <para style="q2" vid="PSA 9:2">waru n ta cana ishipa yi ica adama Aala a̱ wu.<verse eid="PSA 9:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3" />N'yuwatan n va̱ n rono ta̱ na̱ a̱ca̱pa̱ a na ene nuwu,</para>
  <para style="q2" vid="PSA 9:3">reve a̱ ta̱ɗa̱tsa̱ a̱ riya̱ a̱ kuwa̱ a̱ ma̱ka̱ka̱n ma̱ wu.<verse eid="PSA 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4" />Adama a na uge'etosu u na vu yuwaan numu</para>
  <para style="q2" vid="PSA 9:4">u roco ta̱ amayun,</para>
  <para style="q1" vid="PSA 9:4">diga o ootogu o tsugono tsa̱ wu,</para>
  <para style="q2" vid="PSA 9:4">vu yuwan ta̱ uge'etosu wa̱ a̱ɓula̱.<verse eid="PSA 9:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5" />A̱vu ɗa vu ɓarai nɗa,</para>
  <para style="q2" vid="PSA 9:5">vu kototoi a̱za̱ e iwuya.</para>
  <para style="q2" vid="PSA 9:5">A̱vu ɗa vu ta'asai ala ele hali hali.<verse eid="PSA 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6" />O kototo ta̱ n'yuwatan hali hali</para>
  <para style="q2" vid="PSA 9:6">reve vu kototo ilyuci i le.</para>
  <para style="q2" vid="PSA 9:6">Hali e cina ne le suru suru.<verse eid="PSA 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7" />Amma A̱sulazuva mogono ma ɗa hali hali,</para>
  <para style="q2" vid="PSA 9:7">u shuwa̱ ta̱ ootogu o tsugono tsa̱ yi adama o uge'etosu.<verse eid="PSA 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8" />A̱yi ɗa za na aa yuwusan uge'etosu wu uvaɗi na̱ a̱ɓula̱,</para>
  <para style="q2" vid="PSA 9:8">u tsu ge'eto ta̱ nɗa mejege.<verse eid="PSA 9:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9" />A̱sulazuva a ɗa uba̱ta̱ wu upa'atan,</para>
  <para style="q2" vid="PSA 9:9">uba̱ta̱ wu upa'atan wa aza a na o ɓongishi,</para>
  <para style="q2" vid="PSA 9:9">a̱yi uba̱ta̱ wu upa'atan u ɗa a mantsa ma addama.<verse eid="PSA 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10" />Aza a na e revei Aala a̱ wu</para>
  <para style="q2" vid="PSA 9:10">a ta zuwusa ucira ule ya̱'a̱ wu,</para>
  <para style="q1" vid="PSA 9:10">agba vu tsu vari a̱za̱ e izami ya̱ wu shi.<verse eid="PSA 9:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11" />Canaa yi A̱sulazuva ica,</para>
  <para style="q2" vid="PSA 9:11">za na a yuwusan tsugono ɗe Sihiyona!</para>
  <para style="q1" vid="PSA 9:11">I damma linga va̱ yi</para>
  <para style="q2" vid="PSA 9:11">a̱tsuma̱ a nɗa suru.<verse eid="PSA 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12" />Adama a na a̱yi ɗa za na tsu tsupusaa</para>
  <para style="q2" vid="PSA 9:12">aza a na o unai ozo o ro,</para>
  <para style="q1" vid="PSA 9:12">u ta cuwan na aza a na o sowuso a̱tsuma̱lima̱,</para>
  <para style="q2" vid="PSA 9:12">waru wa̱ rungwa̱ mesun ma aza a na o ɓongishi shi.<verse eid="PSA 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 9:13">ene iliyali i va̱!</para>
  <para style="q1" vid="PSA 9:13">Ka̱lyuwa̱ a̱tsuma̱lima̱</para>
  <para style="q2" vid="PSA 9:13">a na aza a na a 'yuwan numu a casu mu,</para>
  <para style="q1" vid="PSA 9:13">a̱vu za na a wawusa mu diga o una̱ wu ukwa̱,<verse eid="PSA 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14" />adama n gura damma ica ya̱ wu</para>
  <para style="q2" vid="PSA 9:14">elime a ama a̱ wu a̱za̱ a̱ Sihiyona,</para>
  <para style="q1" vid="PSA 9:14">waru n yuwan ma̱za̱nga̱ adama e iwawi ya̱ wu.<verse eid="PSA 9:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15" />Nɗa n ka̱pa̱ ta̱ a̱ka̱ri,</para>
  <para style="q2" vid="PSA 9:15">reve gba a̱ riya̱ pe.</para>
  <para style="q1" vid="PSA 9:15">A̱vu a dasa yakuru na a azuyi,</para>
  <para style="q2" vid="PSA 9:15">reve gba u reme ana ele.<verse eid="PSA 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16" />A̱sulazuva a zuwa ta̱ e reve yi adama o uge'etosu wa̱ a̱ɓula̱ a̱yi.</para>
  <para style="q2" vid="PSA 9:16">A̱za̱ e iwuya e reme ta̱ aciyele na̱ linga le.<verse eid="PSA 9:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17" />A̱za̱ e iwuya a̱ ta̱ ka̱ra̱ a̱ cipa̱ aason,</para>
  <para style="q2" vid="PSA 9:17">ne ɗa fo nɗa</para>
  <para style="q2" vid="PSA 9:17">n na e icinai na̱ A̱sula̱.<verse eid="PSA 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18" />Adama a na mantsa suru ɗa</para>
  <para style="q2" vid="PSA 9:18">e icina na aza a na a zamishi ikambishi shi,</para>
  <para style="q1" vid="PSA 9:18">waru a kuɗa</para>
  <para style="q2" vid="PSA 9:18">uzuwu wo okolo wa̱ a̱za̱ o ulambu shi hali hali.<verse eid="PSA 9:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19" />A̱sulazuva, 'yon!</para>
  <para style="q2" vid="PSA 9:19">She vu lyawa vaɗilima̱ lyuwa aci a̱ wu wan,</para>
  <para style="q2" vid="PSA 9:19">lyawa e ge'eto nɗa a̱ ma̱ka̱ka̱n ma̱ wu.<verse eid="PSA 9:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 9:20">vu zuwa le e je'en lipu adama o wovon.</para>
  <para style="q1" vid="PSA 9:20">Vu zuwa nɗa n reve</para>
  <para style="q2" vid="PSA 9:20">a na ele ama a ɗa goon.<verse eid="PSA 9:20" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" sid="PSA 10" />
  <para style="s">Avasa na̱ mesun adama aza a wuya</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 10:1">nye i zuwai vi isawain ɗe alanga?</para>
  <para style="q1" vid="PSA 10:1">Nye i zuwai vu soko yi aciya̱wu</para>
  <para style="q2" vid="PSA 10:1">a mantsa ma na tsu ri pe a̱tsuma̱lima̱?<verse eid="PSA 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2" />A̱za̱ e iwuya a̱ ta̱ 'ya̱susa̱n avangaci</para>
  <para style="q2" vid="PSA 10:2">o ɓongishi aza a na a̱ ri nu ucira shi.</para>
  <para style="q2" vid="PSA 10:2">Lyawa ifoɓi yi iwuya i le i ka̱mba̱ a aci e le.<verse eid="PSA 10:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3" />A̱za̱ e iwuya a ta yuwusan uvaɗu</para>
  <para style="q2" vid="PSA 10:3">ni icigi yi iwuya yo okolo e le.</para>
  <para style="q1" vid="PSA 10:3">A̱za̱ a̱bunda̱ o utsa̱n</para>
  <para style="q2" vid="PSA 10:3">a̱ tsi isula ta̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 10:3">waru a tsu tara yi ili shi.<verse eid="PSA 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4" />A̱za̱ e iwuya a̱ ta̱ na aciyogbamu,</para>
  <para style="q2" vid="PSA 10:4">ili i bura le na̱ A̱sula̱ shi.</para>
  <para style="q1" vid="PSA 10:4">A̱tsuma̱ a majiyan ma̱ le suru a tsu damma ta̱, &lt;&lt;A̱sula̱ lo shi.&gt;&gt;<verse eid="PSA 10:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5" />A̱za̱ e iwuya a̱ tsu tsura̱ ta̱ ulyuwu we elime mantsa suru,</para>
  <para style="q2" vid="PSA 10:5">a̱ tsu reve nu uge'etosu wa̱ A̱sula̱ shi,</para>
  <para style="q2" vid="PSA 10:5">a̱ tsu ka̱lyuwusa̱ ta̱ n'yuwatan nle ne esu avama.<verse eid="PSA 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6" />A̱tsuma̱ a majiyan ma̱ le a̱ tsu damma ta̱,</para>
  <para style="q2" vid="PSA 10:6">&lt;&lt;Tsa da'wan shi,</para>
  <para style="q1" vid="PSA 10:6">diga mantsa a̱ tyo mantsa</para>
  <para style="q2" vid="PSA 10:6">tsa uwa a̱tsuma̱lima̱ shi.&gt;&gt;<verse eid="PSA 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7" />Una̱ u le tapu ɗa u ri na̱ wisulusa,</para>
  <para style="q2" vid="PSA 10:7">ne epen oɓolo ni ibili.<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="ROM 3:14">Rom 3:14</ref>.</char></note></para>
  <para style="q1" vid="PSA 10:7">Elentsu e le a̱ ta̱ na</para>
  <para style="q2" vid="PSA 10:7">adanshi a avama ni iwuya.<verse eid="PSA 10:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8" />A̱ tsu pa'an ta̱ a̱tsuma̱ a̱ mulyuci,</para>
  <para style="q2" vid="PSA 10:8">uvawun</para>
  <para style="q2" vid="PSA 10:8">o una aza a babu unusu.</para>
  <para style="q1" vid="PSA 10:8">A tsu zuwa ta̱ esu uba̱ta̱ wa aza a babu ucira.<verse eid="PSA 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 10:9" />A̱ tsu da̱na̱ ta̱ uvawun uba̱ta̱ u na a pa'ain tsa kamu.</para>
  <para style="q2" vid="PSA 10:9">A̱ tsu von ta̱ azama aza a na a̱ ri nu ucira shi.</para>
  <para style="q1" vid="PSA 10:9">Ni iyakuru i le a̱ tsu reme ta̱ aza a na a̱ ri nu ucira shi</para>
  <para style="q2" vid="PSA 10:9">a̱ ka̱ra̱ ne ele.<verse eid="PSA 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10" />A̱ tsu dadasa ta̱ aza a na a̱ ri nu ucira shi reve a̱ lungusa̱ le,</para>
  <para style="q2" vid="PSA 10:10">o roco le ucira, reve a lyuwa aci e le.<verse eid="PSA 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11" />A̱tsuma̱ a majiyan ma̱ le a tsu damma ta̱,</para>
  <para style="q2" vid="PSA 10:11">&lt;&lt;A̱sula̱ a dama shi!</para>
  <para style="q2" vid="PSA 10:11">U pala ta̱ esu a̱yi, we enishe shi!&gt;&gt;<verse eid="PSA 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12" />'Yon A̱sulazuva!</para>
  <para style="q2" vid="PSA 10:12">Vu roco ucira wu ukere wa̱ wu, A̱sula̱!</para>
  <para style="q2" vid="PSA 10:12">She vi icina na aza a babu ucira wan!<verse eid="PSA 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13" />Nye i zuwai a̱za̱ e iwuya o goroi A̱sula̱?</para>
  <para style="q2" vid="PSA 10:13">Nye i zuwai aa dansa okolo ele,</para>
  <para style="q2" vid="PSA 10:13">&lt;&lt;Wa̱a̱ ge'eto tsu shi&gt;&gt;?<verse eid="PSA 10:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14" />Amma a̱vu A̱sula̱,</para>
  <para style="q2" vid="PSA 10:14">na amayun vu ta̱ e eneshe!</para>
  <para style="q1" vid="PSA 10:14">Ee, na amayun vu ta̱ a̱ ka̱lyuwusa̱ usa̱n na̱ a̱tsuma̱lima̱,</para>
  <para style="q2" vid="PSA 10:14">waru mantsa suru vu tu ufoɓu adama a na vaa kamba.</para>
  <para style="q1" vid="PSA 10:14">Ya̱'a̱ wu ɗa aza a na a̱ ri nu ucira shi aa zuwusa ucira u le,</para>
  <para style="q2" vid="PSA 10:14">a̱vu ɗa za na a kambusa mkpa'an.<verse eid="PSA 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15" />Lyawa vu kuɗa ucira wa̱ a̱za̱ e iwuya</para>
  <para style="q2" vid="PSA 10:15">na ama a avama.</para>
  <para style="q1" vid="PSA 10:15">Vu ge'eto a̱za̱ e iwuya</para>
  <para style="q2" vid="PSA 10:15">hali she na̱ a̱ pa̱lu'wa̱ iwuya i le suru.<verse eid="PSA 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16" />A̱sulazuva mogono ma ɗa hali hali!</para>
  <para style="q2" vid="PSA 10:16">Nɗa n na n 'yuwain a yuwaan yi a̱ga̱nda̱</para>
  <para style="q2" vid="PSA 10:16">o to kototo le diga e iɗa'a.<verse eid="PSA 10:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 10:17">uwwa mesun ma aza a na a̱ ri nu ucira shi,</para>
  <para style="q1" vid="PSA 10:17">vu uwwa le</para>
  <para style="q2" vid="PSA 10:17">vu ca le okolo o ugbamu.<verse eid="PSA 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18" />Vu ta yuwan uge'etosu u mejege</para>
  <para style="q2" vid="PSA 10:18">adama a mkpa'an na aza a na e le'ei</para>
  <para style="q1" vid="PSA 10:18">tsa̱ra̱ ama</para>
  <para style="q2" vid="PSA 10:18">a̱ da̱shi ca le wovon wan.<verse eid="PSA 10:18" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" sid="PSA 11" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Adama a̱ wivulusa̱ wu gbala. Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1" />A̱sulazuva a ɗa upa'atan u va̱.</para>
  <para style="q2" vid="PSA 11:1">To cine yaa damma mu,</para>
  <para style="q1" vid="PSA 11:1">&lt;&lt;'Yawan tsa manunu</para>
  <para style="q2" vid="PSA 11:1">a̱ tyo a masasan!<verse eid="PSA 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2" />A̱yi ɗa nda a̱za̱ e iwuya a lapulai tan le,</para>
  <para style="q2" vid="PSA 11:2">reve o foɓo aya e le,</para>
  <para style="q2" vid="PSA 11:2">tsa̱ra̱ a tawan ama a̱ɓula̱ a̱tsuma̱ e irumbu.<verse eid="PSA 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3" />Ili yi lo i na a̱za̱ a̱ɓula̱ a gura yuwan shi,</para>
  <para style="q2" vid="PSA 11:3">nna̱ ili i la̱nga̱.&gt;&gt;<verse eid="PSA 11:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4" />A̱sulazuva a̱ ta̱ pe a̱tsuma̱ a̱ A̱a̱'isamapaɗa a akiza a̱yi,</para>
  <para style="q2" vid="PSA 11:4">ootogu o tsugono tsa̱ a̱ yi tsa̱ ta̱ ɗe zuva.<note caller="-" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="HAB 2:20">Hab 2:20</ref>.</char></note></para>
  <para style="q1" vid="PSA 11:4">Esu a̱ yi a̱ te inda a ama uba̱ta̱ suru,</para>
  <para style="q2" vid="PSA 11:4">waru u ta zuwusa esu e ili i na vaɗilima̱ a yuwusan.<verse eid="PSA 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5" />A̱sulazuva a̱ tsu lyungwa̱ ta̱ za va̱ a̱ɓula̱,</para>
  <para style="q2" vid="PSA 11:5">na̱ za vi iwuya,</para>
  <para style="q1" vid="PSA 11:5">amma u tsu 'yuwan ta̱ aza a na a tsu ciga u'ya̱susa̱n wu ugbozu.<verse eid="PSA 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6" />U ta̱ lyunguwa̱ a̱za̱ e iwuya na akina,</para>
  <para style="q2" vid="PSA 11:6">oɓolo na̱ farinwuta.</para>
  <para style="q1" vid="PSA 11:6">Upepu wu usuɗuwu lon,</para>
  <para style="q2" vid="PSA 11:6">u to o'wo akunda e le.<verse eid="PSA 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7" />Adama a na A̱sulazuva za va̱ a̱ɓula̱ ɗa,</para>
  <para style="q2" vid="PSA 11:7">u ciga ta̱ linga va̱ a̱ɓula̱,</para>
  <para style="q2" vid="PSA 11:7">a̱za̱ a̱ɓula̱ e te ene urewesu wa̱ yi.<verse eid="PSA 11:7" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" sid="PSA 12" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Ni itana i tsuwe'e. O una̱ wa &lt;&lt;Shemini<note caller="+" style="f"><char style="fr" closed="false">12:0 </char><char style="fq" closed="false">Shemini </char><char style="ft" closed="false">Idanshi i nda uɗyo wi ishipa i ɗa, ko i tsuwe'e i ro.</char></note>&gt;&gt; Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1" />Wawa tsu A̱sulazuva!</para>
  <para style="q2" vid="PSA 12:1">Adama a na babu lo za na ri na̱ a̱ɓula̱ tsa̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 12:1">na buwai.</para>
  <para style="q1" vid="PSA 12:1">Aza a na adansa amayun a buwa shi</para>
  <para style="q2" vid="PSA 12:1">diga a̱tsuma̱ a ama.<verse eid="PSA 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2" />Vuma suru ta yuwusaan moron ma̱ nden ma̱ yi epen.</para>
  <para style="q2" vid="PSA 12:2">A̱ ta̱ luluma̱sa̱ aciyele nu una̱ wu uyo'o.<verse eid="PSA 12:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 12:3">zuwa elentsu a̱za̱ o una̱ wu uyo'o a̱ rungwa̱ kpaku!</para>
  <para style="q1" vid="PSA 12:3">Vu kpa̱to na̱ va̱ a̱za̱ o uvaɗu.<verse eid="PSA 12:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 12:4" />Aza a na a dansa,</para>
  <para style="q2" vid="PSA 12:4">&lt;&lt;Nu una̱ u tsu u ɗa tsa lyuwa aci.</para>
  <para style="q1" vid="PSA 12:4">Waru tsu ta damma ili i na tsu cigai,</para>
  <para style="q2" vid="PSA 12:4">za ne ɗa a putsa tsu?&gt;&gt;<verse eid="PSA 12:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5" />Amma a̱vu A̱sulazuva a damma,</para>
  <para style="q2" vid="PSA 12:5">&lt;&lt;Me ene ta̱ ule'e u na a yuwusaan a̱za̱ o ulambu,</para>
  <para style="q2" vid="PSA 12:5">waru mu uwwa ta̱ ma̱nga̱ ma̱ a̱za̱ e izami yi ikambishi.</para>
  <para style="q1" vid="PSA 12:5">To, gogo n ta̱ 'yon</para>
  <para style="q2" vid="PSA 12:5">n wawa le o una̱ wi ili i na a cigai!&gt;&gt;<verse eid="PSA 12:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6" />Adanshi a̱ A̱sulazuva mejege ma ɗa can,</para>
  <para style="q2" vid="PSA 12:6">adanshi a̱yi a̱ ta̱ tsa azurufa va̱ni,</para>
  <para style="q1" vid="PSA 12:6">azurufa na e jeruwetoi a̱tsuma̱ a akina,</para>
  <para style="q2" vid="PSA 12:6">toto ucindere.<verse eid="PSA 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7" />A̱sulazuva, vu wawa tsu,</para>
  <para style="q2" vid="PSA 12:7">diga e ekere a̱za̱ e iwuya waru vu yuwan tsu mapari,</para>
  <para style="q2" vid="PSA 12:7">vu yuwan tsu mapari hali hali.<verse eid="PSA 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8" />Adama a na mɓa̱nga̱ suru,</para>
  <para style="q2" vid="PSA 12:8">ama awuya a ta agara,</para>
  <para style="q1" vid="PSA 12:8">adama a na wo o'woi a ta cuwusa iwuya,</para>
  <para style="q2" vid="PSA 12:8">a̱tsuma̱ a ama.<verse eid="PSA 12:8" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" sid="PSA 13" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 13:1">hali mantsa ma̱ ne ma ɗa ve e icina na̱ a̱mu?</para>
  <para style="q1" vid="PSA 13:1">Hali mantsa ma̱ ne ma ɗa vo sokowo mu urewesu wa̱ wu?</para>
  <para style="q2" vid="PSA 13:1">U to o'wo hali hali?<verse eid="PSA 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2" />Hali mantsa ma̱ ne ma ɗa ma yuwan mpolo na̱ a̱tsuma̱lima̱ a nda?</para>
  <para style="q2" vid="PSA 13:2">Urana suru n ta̱ na̱ a̱tsuma̱lima̱ o okolo a̱ va̱.</para>
  <para style="q1" vid="PSA 13:2">Hali acina mantsa ma̱ ne ɗa a lyawa n'yuwatan n va̱,</para>
  <para style="q2" vid="PSA 13:2">n lyuwa aci a̱ va̱?<verse eid="PSA 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3" />Ka̱lyuwa̱ mu, A̱sulazuva A̱sula̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 13:3">vu usu mu!</para>
  <para style="q1" vid="PSA 13:3">Vu zuwa esu a̱ va̱ ene ure,</para>
  <para style="q2" vid="PSA 13:3">she vu lyawa ukwisa̱ u ɓa̱ru le wan.<verse eid="PSA 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4" />Ta̱wa̱ n'yuwatan n va̱ n damma,</para>
  <para style="q2" vid="PSA 13:4">&lt;&lt;Tsu lyuwa ta̱ aci a̱yi.&gt;&gt;</para>
  <para style="q1" vid="PSA 13:4">A̱vu a yuwan ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 13:4">a mantsa ma na n riya̱i wan.<verse eid="PSA 13:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5" />Amma n zuwa ta̱ ucira u va̱,</para>
  <para style="q2" vid="PSA 13:5">uba̱ta̱ wi icigi ya̱ wu i na i tsu vadala shi.</para>
  <para style="q1" vid="PSA 13:5">Ookolo a̱ va̱ a ta yuwan ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 13:5">adama e iwawi ya̱ wu.<verse eid="PSA 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6" />N ta canaa A̱sulazuva ishipa,</para>
  <para style="q2" vid="PSA 13:6">adama a na u ta̱ rocosu mu isa'ani lon.<verse eid="PSA 13:6" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" sid="PSA 14" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1" />Olo a tsu damma ta̱ o okolo e le,</para>
  <para style="q2" vid="PSA 14:1">&lt;&lt;Babu A̱sula̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">14:1 </char><char style="ft" closed="false">Ica 10:4.</char></note></para>
  <para style="q1" vid="PSA 14:1">A̱ la̱nga̱ ta̱ suru nle, a yuwan ta̱ linga vi idaba.</para>
  <para style="q2" vid="PSA 14:1">A̱tsuma̱ e le babu za na a yuwusan ulinga u sa'ani.<verse eid="PSA 14:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2" />A̱sulazuva a̱ ka̱lyuwa̱ ta̱ vuma diga zuva,</para>
  <para style="q2" vid="PSA 14:2">ko u ta̱ tsura̱ ozo o ro a na ri nu ugbozu,</para>
  <para style="q2" vid="PSA 14:2">za na ri e izami i na we reve A̱sula̱.<verse eid="PSA 14:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3" />Suru nle a lyawa ta̱ ure,<note caller="-" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="ROM 3:11-12">Rom 3:11-12</ref>.</char></note></para>
  <para style="q2" vid="PSA 14:3">suru nle a̱ puwa̱n ta̱,</para>
  <para style="q1" vid="PSA 14:3">babu vuma na a yuwusan ili ya̱ a̱ɓula̱,</para>
  <para style="q2" vid="PSA 14:3">ko vuma ta̱!<verse eid="PSA 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4" />Ko a̱ ri nu urevu shi?</para>
  <para style="q2" vid="PSA 14:4">A̱za̱ e iwuya suru,</para>
  <para style="q2" vid="PSA 14:4">a̱ ri nu urevu shi?</para>
  <para style="q1" vid="PSA 14:4">A ta tamusa ama a̱ va̱ cine a tsu tama opopofu,</para>
  <para style="q2" vid="PSA 14:4">waru a yuwusan ɗewu uba̱ta̱ wa̱ A̱sulazuva shi.<verse eid="PSA 14:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5" />Agba e le ɗa a nda, a da'wain adama o wovon,</para>
  <para style="q2" vid="PSA 14:5">adama a na A̱sula̱ oto oɓolo na̱ a̱za̱ a̱ a̱ɓula̱.<verse eid="PSA 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6" />A̱ɗu a̱za̱ e iwuya,</para>
  <para style="q2" vid="PSA 14:6">i tsu lungusa̱ ta̱ ifoɓi ya̱ a̱za̱ o ulambu,</para>
  <para style="q2" vid="PSA 14:6">amma A̱sulazuva a ɗa upa'atan u le.<verse eid="PSA 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7" />Ashe aa damma, iwawi i ta̱ ta̱wa̱ Isra'ila</para>
  <para style="q2" vid="PSA 14:7">lyawa u ta̱wa̱ diga Sihiyona wo'o!</para>
  <para style="q1" vid="PSA 14:7">A̱sulazuva a̱ ta̱ ka̱mbuwa̱a̱ ama a̱yi na̱ aba'un e le,</para>
  <para style="q2" vid="PSA 14:7">ugundo wa Yakubu u ta yuwan ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 14:7">ama a Isra'ila a ta yuwan mere.<verse eid="PSA 14:7" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" sid="PSA 15" />
  <para style="d">Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 15:1">zane ɗa a̱a̱ da̱nu Oogodo o Uga'asusan a̱ wu?</para>
  <para style="q1" vid="PSA 15:1">Zane ɗa rawai naa wa yuwan a̱ga̱nda̱ ɗe Sihiyona,</para>
  <para style="q2" vid="PSA 15:1">Aagaɗi a Akiza a̱ wu?<verse eid="PSA 15:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2" />She za na ri na amayun,</para>
  <para style="q2" vid="PSA 15:2">a yuwusan ulinga u na u ri mejege,</para>
  <para style="q1" vid="PSA 15:2">na̱ za na adansa mejege,</para>
  <para style="q2" vid="PSA 15:2">diga o okolo a̱yi,<verse eid="PSA 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 15:3" />za na tsu lungusa̱ aala a za va̱ yi shi,</para>
  <para style="q2" vid="PSA 15:3">za na tsu yuwaan i'utsa̱ ya̱ yi iwuya shi,</para>
  <para style="q1" vid="PSA 15:3">ko u bete'we adanshi</para>
  <para style="q2" vid="PSA 15:3">adama o moron me nden ma̱ yi iwau shi.<verse eid="PSA 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4" />Ko za na tsu tara vuma na,</para>
  <para style="q2" vid="PSA 15:4">A̱sulazuva a 'yuwain ili i ro shi,</para>
  <para style="q1" vid="PSA 15:4">amma u tsu ca ta̱ tsugbain</para>
  <para style="q2" vid="PSA 15:4">e ekere aza a na a uwwusa wovon wa̱ A̱sulazuva,</para>
  <para style="q1" vid="PSA 15:4">u tsu shiton ta̱ nzuwulai ma̱ yi,</para>
  <para style="q2" vid="PSA 15:4">ko woo yo'ono yi shi.<verse eid="PSA 15:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5" />Za na tsu ca okopu e ikebe babu na u zamiyi u da̱shiyi,</para>
  <para style="q2" vid="PSA 15:5">waru u tsu ushi utowusu wu una̱ shi,</para>
  <para style="q2" vid="PSA 15:5">adama u ca usuwu wa̱ epen e ekere a za na ri nu unusu shi.</para>
  <para style="q2" vid="PSA 15:5">Cu'un vuma ndolo babu za na a gura jinga̱ɗa̱ yi, ko ke'en!<verse eid="PSA 15:5" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" sid="PSA 16" />
  <para style="d">Ica ya̱ Da̱wuda. Cu'un va &lt;&lt;Mikitam<note caller="+" style="f"><char style="fr" closed="false">16:0 </char><char style="fq" closed="false">Mikitam </char><char style="ft" closed="false">U ta gura wo o'wo idanshi yi ishipa i ro ɗa.</char></note>.&gt;&gt;</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1" />Vu ka̱lyuwa̱ mu A̱sula̱,</para>
  <para style="q2" vid="PSA 16:1">adama a na a̱vu ɗa upa'atan u va̱.<verse eid="PSA 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2" />N damma ta̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 16:2">&lt;&lt;A̱vu ɗa A̱sulazuva a̱ va̱,</para>
  <para style="q2" vid="PSA 16:2">n ri ni ili i sa'ani i ro shi she a̱vu a̱ nde'en.&gt;&gt;<verse eid="PSA 16:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3" />Aza a na a̱ ri na akiza a̱tsuma̱ e iɗa'a</para>
  <para style="q2" vid="PSA 16:3">ele ɗa a̱ ri na̱ tsugbain!</para>
  <para style="q2" vid="PSA 16:3">Ele ɗa aza a na a zuwusa mu ma̱za̱nga̱.<verse eid="PSA 16:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4" />Aza a na a ɗangulai,</para>
  <para style="q2" vid="PSA 16:4">o toni musula̱ n ro,</para>
  <para style="q2" vid="PSA 16:4">a̱ ta̱ da̱shishi aciyele a̱tsuma̱lima̱ lon.</para>
  <para style="q1" vid="PSA 16:4">Moo ɓolo aci ne le,</para>
  <para style="q2" vid="PSA 16:4">uba̱ta̱ wu ucasu u kucci ne le shi,</para>
  <para style="q2" vid="PSA 16:4">me ɗe aala a̱ musula̱ nle shi.<verse eid="PSA 16:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 16:5">a̱vu ɗa goon n ri na̱ yi,</para>
  <para style="q1" vid="PSA 16:5">a̱vu ɗa va yuwusaan mu ili i na n cigai biti.</para>
  <para style="q2" vid="PSA 16:5">Wuma u va̱ u ta̱ e ekere a̱ wu.<verse eid="PSA 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6" />Akunda a na a ca numu</para>
  <para style="q2" vid="PSA 16:6">u tu ulobonu lon.</para>
  <para style="q2" vid="PSA 16:6">Ili i ro yi lo shi n ta̱ na agadu a sa'ani.<verse eid="PSA 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7" />N ta cuwa A̱sulazuva za na a casu mu a̱sa̱la̱,</para>
  <para style="q2" vid="PSA 16:7">ko na ayin okolo a̱ va̱ a ta casu mu adanshi.<verse eid="PSA 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8" />Mantsa suru n reve ta̱ A̱sulazuva o to oɓolo na̱ mu,<note caller="-" style="x"><char style="xo" closed="false">16:8 </char><char style="xt" closed="false"><ref loc="DEU 2:25-28">U.Wl 2:25-28</ref>.</char></note></para>
  <para style="q2" vid="PSA 16:8">adama a na u ta̱ zuzu na̱ mu,</para>
  <para style="q2" vid="PSA 16:8">babu ili i na ya da'waton mu.<verse eid="PSA 16:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9" />Adama o ndolo tapu ɗa n ri na̱ ma̱za̱nga̱ na̱ mere,</para>
  <para style="q2" vid="PSA 16:9">mantsa suru n ta uwwusa gbaga ɗa n ri.<verse eid="PSA 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10" />Adama a na va lyawa wuma u va̱,</para>
  <para style="q2" vid="PSA 16:10">a̱tsuma̱ aason shi,</para>
  <para style="q2" vid="PSA 16:10">ko vu lyawa macigata ma̱ wu ma shama shi.<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="ACT 13:35">Ajy 13:35</ref>.</char></note><verse eid="PSA 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11" />Vu roco mu ta̱ ure,</para>
  <para style="q2" vid="PSA 16:11">u wuma,</para>
  <para style="q1" vid="PSA 16:11">na̱ vu ri lo uba̱ta̱ u va̱,</para>
  <para style="q2" vid="PSA 16:11">n tsu shiwan ta̱ na̱ ma̱za̱nga̱ lon,</para>
  <para style="q1" vid="PSA 16:11">nden o ukere usa'ani wa̱ wu,</para>
  <para style="q2" vid="PSA 16:11">mawwa mo uyo'o u ɗa hali hali.<verse eid="PSA 16:11" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" sid="PSA 17" />
  <para style="d">Avasa a̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 17:1">vu uwwa ipati i va̱ yi izami yu uge'etosu wa amayun,</para>
  <para style="q2" vid="PSA 17:1">vu uwwa mesun ma̱ va̱ me izami yi ikambishi,</para>
  <para style="q1" vid="PSA 17:1">Vu zuwaa avasa a̱ va̱ atsuvu,</para>
  <para style="q2" vid="PSA 17:1">adama a na babu epen o una̱ u va̱.<verse eid="PSA 17:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2" />Lyawa na va yuwan uge'etosu,</para>
  <para style="q2" vid="PSA 17:2">uge'etosu u na wo roco</para>
  <para style="q2" vid="PSA 17:2">a̱mu za babu unusu ɗa,</para>
  <para style="q1" vid="PSA 17:2">lyawa esu a̱ wu e ene,</para>
  <para style="q2" vid="PSA 17:2">ili i na i ri mejege.<verse eid="PSA 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3" />Na̱ vu ka̱lyuwa̱ okolo a̱ va̱,</para>
  <para style="q2" vid="PSA 17:3">vu bura mu na ayin,</para>
  <para style="q1" vid="PSA 17:3">a̱vu vu lyungwa̱ mu suru,</para>
  <para style="q2" vid="PSA 17:3">va cina ifoɓi iwuya uba̱ta̱ u va̱ shi.</para>
  <para style="q1" vid="PSA 17:3">N yuwan ta̱ ɗe ifoɓi,</para>
  <para style="q2" vid="PSA 17:3">una̱ u va̱ wa yuwan unusu shi.<verse eid="PSA 17:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 17:4" />N yuwan cine akapi a ama a yuwusan shi,</para>
  <para style="q1" vid="PSA 17:4">n yuwan ta̱ tsutoni na adanshi o una̱ wa̱ wu,</para>
  <para style="q2" vid="PSA 17:4">n toni re va̱ a̱za̱ o u'ya̱susa̱n wu ugbozu shi.<verse eid="PSA 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5" />N ta a mmalu a̱tsuma̱ o ure wa̱ wu mantsa suru,</para>
  <para style="q2" vid="PSA 17:5">waru n vadala shi.<verse eid="PSA 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6" />N ta yuwusan avasa uba̱ta̱ wa̱ wu A̱sula̱,</para>
  <para style="q2" vid="PSA 17:6">adama a na a̱vu ɗa za na a̱ usu mu.</para>
  <para style="q1" vid="PSA 17:6">Lyawa vu uwwa mu,</para>
  <para style="q2" vid="PSA 17:6">vu zuwaa adanshi a̱ va̱ atsuvu.<verse eid="PSA 17:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7" />Vu roco a̱ba̱jini asalama e icigi ya̱ wu,</para>
  <para style="q2" vid="PSA 17:7">icigi ya̱ wu i na i tsu vadala shi,</para>
  <para style="q1" vid="PSA 17:7">a̱vu na vu tsu wawa aza a na a zamishi upa'atan,</para>
  <para style="q2" vid="PSA 17:7">aza a na a zama a pa'an o ukere usa'ani wa̱ wu,</para>
  <para style="q2" vid="PSA 17:7">diga e ekere a n'yuwatan n le.<verse eid="PSA 17:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8" />Vi idana mu cine vu revei mawun ma̱ lyusu ma̱ wu,</para>
  <para style="q2" vid="PSA 17:8">vu soko mu za̱la̱ vu ululu ve evelu a̱ wu,<verse eid="PSA 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9" />diga uba̱ta̱ wa ama a vama na a zama o kototo mu,</para>
  <para style="q2" vid="PSA 17:9">na̱ diga e ekere a n'yuwatan n va̱ n na n ka̱nda̱ruwa̱ numu.<verse eid="PSA 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10" />A̱tsuma̱ okolo e le, e tse ene iliyali shi,</para>
  <para style="q2" vid="PSA 17:10">a̱tsuma̱ o una̱ u le waru she adanshi aciyogbamu.<verse eid="PSA 17:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11" />A zuwaa mu ta̱ esu, gogo a̱ ka̱nda̱ruwa̱ mu ta̱,</para>
  <para style="q2" vid="PSA 17:11">a̱ tu ufoɓu, o polo mu e iɗa.<verse eid="PSA 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12" />A̱ ta̱ tsi ikamu,</para>
  <para style="q2" vid="PSA 17:12">a zama na a kakara mu,</para>
  <para style="q1" vid="PSA 17:12">a̱ ta̱ tsi ikamu yu ucira i na i ri uva̱pu.<verse eid="PSA 17:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13" />'Yon A̱sulazuva!</para>
  <para style="q2" vid="PSA 17:13">Vu riya̱a̱ n'yuwatan n va̱ nu uvon,</para>
  <para style="q1" vid="PSA 17:13">vu lyuwa le.</para>
  <para style="q1" vid="PSA 17:13">Vu wawa mu e ekere a̱za̱ e iwuya,</para>
  <para style="q2" vid="PSA 17:13">na̱ matsun me pe'eni ma̱ wu.<verse eid="PSA 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 17:14">vu wawa mu diga e ekere a ama,</para>
  <para style="q1" vid="PSA 17:14">na̱ diga e icu'un ya ama o uvaɗi a nda,</para>
  <para style="q2" vid="PSA 17:14">e ekere e ili i na a̱ ri na̱ yi.</para>
  <para style="q1" vid="PSA 17:14">Vu ge'eto le ni ili i na vu foɓo nle.</para>
  <para style="q2" vid="PSA 17:14">Lyawa muwun n le fo n gada ifoɓi'i suru,</para>
  <para style="q2" vid="PSA 17:14">hali a̱ tyo a̱ muwun ntsukaya nle.<verse eid="PSA 17:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15" />A̱mu gba, n ta̱ ene urewesu wa̱ wu,</para>
  <para style="q2" vid="PSA 17:15">adama a na a̱mu za babu unusu ɗa.</para>
  <para style="q1" vid="PSA 17:15">A mantsa ma na n 'yoyin a nlavu,</para>
  <para style="q2" vid="PSA 17:15">a̱ ma̱ka̱ka̱n ma̱ wu n ta shiwan na̱ ma̱za̱nga̱.<verse eid="PSA 17:15" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" sid="PSA 18" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Wa̱ Da̱wuda aagbashi a̱ A̱sulazuva. U canaa ta̱ A̱sulazuva a̱ yi, idanshi yi ishipa i nda a mantsa ma na A̱sulazuva a wawa niyi e ekere a n'yuwatan ma̱ a̱ yi oɓolo na̱ Shawulu, u damma.</para>
  <para style="r">(<ref loc="2SA 22:1-51">2 Sam 22:1-51</ref>)</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1" />N ciga wu ta̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 18:1">a̱vu ɗa ucira u va̱.<verse eid="PSA 18:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2" />A̱sulazuva a ɗa aatali o upa'atan u va̱,</para>
  <para style="q2" vid="PSA 18:2">ukari u va̱ na̱ zamawawa va̱.</para>
  <para style="q1" vid="PSA 18:2">A̱sula̱ a̱ va̱ a̱yi ɗa aatali o upa'atan u va̱,</para>
  <para style="q2" vid="PSA 18:2">uba̱ta̱ wa̱ yi u ɗa n tsu pa'an.</para>
  <para style="q1" vid="PSA 18:2">A̱yi ɗa a̱a̱ra̱ga̱ a̱ va̱ na aavana e iwawi i va̱,</para>
  <para style="q2" vid="PSA 18:2">waru upa'atan u va̱.<verse eid="PSA 18:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3" />N tsu ɗe ta̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 18:3">za na rawai ica,</para>
  <para style="q2" vid="PSA 18:3">waru u tsu wawa mu ta̱ e ekere a n'yuwatan n va̱.<verse eid="PSA 18:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4" />Meleshe mo o ukwa̱ ma̱ nla̱ mu ta̱ kpakpa,</para>
  <para style="q2" vid="PSA 18:4">ikeɗu i mala yu ukototosu n la'a ta̱ ucira u va̱.<verse eid="PSA 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5" />Amunga a aason a katala mu ta̱,</para>
  <para style="q2" vid="PSA 18:5">aason a zuwaa mu ta̱ maza.<verse eid="PSA 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6" />A̱tsuma̱ a̱tsuma̱lima̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 18:6">n ɗe ta̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 18:6">reve n showen A̱sula̱ adama e ikambishi.</para>
  <para style="q1" vid="PSA 18:6">Diga A̱a̱'isamapaɗa a̱yi wu uwwa ta̱ uɗyo u va̱,</para>
  <para style="q2" vid="PSA 18:6">waru mesun ma̱ va̱ ma rawa ta̱ atsuvu a̱yi.<verse eid="PSA 18:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7" />Uvaɗi u uje'en ta̱ a̱vu u jinga̱ɗa̱,</para>
  <para style="q2" vid="PSA 18:7">reve nkyun vu nsasan fo e je'en a̱ jinga̱ɗa̱,</para>
  <para style="q2" vid="PSA 18:7">adama o upan wa̱ yi.<verse eid="PSA 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8" />Mikyon n ta̱ o uta̱sa̱ a̱ vunu va̱ yi,</para>
  <para style="q2" vid="PSA 18:8">akina a malyuwa na akinkina a madala o uta̱sa̱ o una wa̱ yi.<verse eid="PSA 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9" />U kpa̱tu'wa̱ ta̱ zuva a̱vu u cipa̱,</para>
  <para style="q2" vid="PSA 18:9">ne eleshe a̱ lima̱ da̱n za̱la̱ va ana a̱yi.<verse eid="PSA 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10" />Reve u kumba zuva ve evelu e ikerobobi wu 'yawan zuva,</para>
  <para style="q2" vid="PSA 18:10">a̱vu u zura̱ a̱cipa̱.<verse eid="PSA 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11" />U ka̱mba̱to ta̱ irumbu aapalutsu a̱yi,</para>
  <para style="q2" vid="PSA 18:11">reve u sokowo aciya̱yi a̱tsuma̱ e eleshe a̱ lima̱ a̱ mini.<verse eid="PSA 18:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12" />Reve imaɗatsu yu uta̱ ta̱ diga e eleshe a̱yi,</para>
  <para style="q2" vid="PSA 18:12">reve mini ma atayan oɓolo ne elentsu a akina,</para>
  <para style="q2" vid="PSA 18:12">o uta̱ e elime a̱yi.<verse eid="PSA 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13" />Reve A̱sulazuva a yuwan tsata diga zuva,</para>
  <para style="q2" vid="PSA 18:13">reve uɗyo u Mogono me Ili Suru ma yuwan ilama.<verse eid="PSA 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14" />Reve u tewin aya a̱ yi,</para>
  <para style="q2" vid="PSA 18:14">u baza n'yuwatan ma̱ yi.</para>
  <para style="q1" vid="PSA 18:14">Ni imaɗatsu ya̱ yi ɗa,</para>
  <para style="q2" vid="PSA 18:14">u bete'we nle.<verse eid="PSA 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15" />A̱vu a̱ kpa̱tu'wa̱ ikyun i mala,</para>
  <para style="q2" vid="PSA 18:15">a̱vu ikyun yu uvaɗi yi uta̱ a alanga e eteshe,</para>
  <para style="q2" vid="PSA 18:15">o una̱ u tsuɓari tsa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 18:15">nu ucira u wivuwun wa̱ yi.<verse eid="PSA 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16" />Diga zuva A̱sulazuva a canana ta̱ ukere wa̱ yi,</para>
  <para style="q2" vid="PSA 18:16">wu uta̱ mu,</para>
  <para style="q1" vid="PSA 18:16">diga a̱tsuma̱ a̱ mini ma̱ a̱ru'un ɗa,</para>
  <para style="q2" vid="PSA 18:16">u papa numu.<verse eid="PSA 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17" />U wawa mu ta̱,</para>
  <para style="q2" vid="PSA 18:17">e ekere a n'yuwatan n va̱ mu ucira,</para>
  <para style="q1" vid="PSA 18:17">ne e ekere aza a na a 'yuwan numu,</para>
  <para style="q2" vid="PSA 18:17">adama a na a la'a numu ucira.<verse eid="PSA 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18" />A̱ riya̱a̱ mu ta̱ o urana wa̱ a̱tsuma̱lima̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 18:18">amma A̱sulazuva a kamba mu ta̱.<verse eid="PSA 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19" />Wu uta̱ mu ta̱ a̱tsuma̱ e meleshe,</para>
  <para style="q2" vid="PSA 18:19">waru u wawa mu ta̱ adama a na waa uwwusa uyo'o u va̱.<verse eid="PSA 18:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20" />A̱sulazuva a tsupa mu ta̱ adama a̱ a̱ɓula̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 18:20">u ca mu ta̱ iliyinkapa adama a na e ekere a̱ va̱ a̱ ri nu unusu shi.<verse eid="PSA 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21" />Adama a na n yuwan ta̱ tsutoni nu ure wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 18:21">agba n lyawa A̱sula̱ a̱ va̱ a̱vu n yuwan iwuya shi.<verse eid="PSA 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22" />N yuwan ta tsutoni na̱ wila̱ wa̱ yi suru,</para>
  <para style="q2" vid="PSA 18:22">agba n lyawa ili i na u zuwai a na a̱a̱ kuru shi.<verse eid="PSA 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23" />N da̱na̱ ta̱ babu unusu a̱ ma̱ka̱ka̱n ma̱ yi,</para>
  <para style="q2" vid="PSA 18:23">n tawa ta̱ aciya̱va̱ diga o ure u na maa yuwan unusu.<verse eid="PSA 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24" />A̱sulazuva a tsupa mu ta̱ adama a̱ a̱ɓula̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 18:24">adama a na u reve ta̱ a̱mu za vu unusu ɗa shi e esu a̱ yi.<verse eid="PSA 18:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25" />A̱sulazuva vu tsu roco ta̱ a̱ɓula̱ e ekere aza a na a̱ ri na̱ a̱ɓula̱.</para>
  <para style="q2" vid="PSA 18:25">Za na ri babu unusu, vu tsu roco ta̱ a̱vu za vu unusu ɗa shi.<verse eid="PSA 18:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26" />E ekere a za na ri cece,</para>
  <para style="q2" vid="PSA 18:26">vu tsu roco ta̱ aciya̱wu cece.</para>
  <para style="q1" vid="PSA 18:26">Agba e ekere a za vi iwuya,</para>
  <para style="q2" vid="PSA 18:26">vu tsu roco yi ta̱ tsushu'un.<verse eid="PSA 18:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27" />Vu tsu wawa ta̱ aza a na a̱ ka̱ɗa̱toi aciyele,</para>
  <para style="q2" vid="PSA 18:27">amma esu a̱ wu a̱ ta̱ uba̱ta̱ wa aza a na a̱ ri na aciyogbamu,</para>
  <para style="q2" vid="PSA 18:27">adama vu ka̱ɗa̱to le.<verse eid="PSA 18:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28" />A̱sulazuva, a̱vu ɗa ekan a̱ va̱,</para>
  <para style="q2" vid="PSA 18:28">a̱vu ɗa vi i ikanai irumbu i va̱.<verse eid="PSA 18:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29" />Adama a na ni ikambi ya̱ wu i ɗa ma̱ riya̱a̱ a̱soja o uvon,</para>
  <para style="q2" vid="PSA 18:29">ni ikambi ya̱ A̱sula̱ a̱ va̱ a ɗa maa pasa ukari u lyuci.<verse eid="PSA 18:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30" />A̱sula̱ gba, re va̱ yi mejege ma ɗa!</para>
  <para style="q2" vid="PSA 18:30">Adanshi a̱ A̱sulazuva waru amayun a ɗa!</para>
  <para style="q2" vid="PSA 18:30">A̱ra̱ga̱ a ɗa e ekere a za na suru zamiyi upa'atan ya̱'a̱ yi. <note caller="-" style="x"><char style="xo" closed="false">18:30 </char><char style="xt" closed="false"><ref loc="PRO 30:5">Udm 30:5</ref>.</char></note><verse eid="PSA 18:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31" />Zane ɗa A̱sula̱, babu na̱ A̱sulazuva?</para>
  <para style="q2" vid="PSA 18:31">Zane ɗa gba aatali o upa'atan,</para>
  <para style="q2" vid="PSA 18:31">babu na̱ a̱vu A̱sula̱ a̱ tsu?<verse eid="PSA 18:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32" />A̱sula̱ a ɗa za na a casu mu ucira,</para>
  <para style="q2" vid="PSA 18:32">waru u tsu zuwa ta̱ re va̱ o o'wo babu unusu.<verse eid="PSA 18:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33" />U zuwa mu ta̱ n wala kau kau babu ta̱ɗa̱tsa̱,</para>
  <para style="q2" vid="PSA 18:33">cine mere'on ma tsu wala zuva vu nsasan.<note caller="-" style="x"><char style="xo" closed="false">18:33 </char><char style="xt" closed="false"><ref loc="HAB 3:19">Hab 3:19</ref>.</char></note><verse eid="PSA 18:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34" />U rito mu ta̱ cine ma yuwan uvon,</para>
  <para style="q2" vid="PSA 18:34">adama n gura ni'wa̱n utan wu rumushili.<verse eid="PSA 18:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35" />Vu ca mu ta̱ a̱a̱ra̱ga̱ a̱ wu za na wawa numu,</para>
  <para style="q2" vid="PSA 18:35">ukere u sa'ani wa̱ wu u guza̱ mu ta̱,</para>
  <para style="q2" vid="PSA 18:35">ikambishi ya̱ wu i ca mu ta̱ tsugbain.<verse eid="PSA 18:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36" />Vu zuwa mu ta̱ uba̱ta̱ u na u ri na̱ meleshe shi,</para>
  <para style="q2" vid="PSA 18:36">agba n riya̱ mantsa mo uvon shi.<verse eid="PSA 18:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37" />M gbagba ta̱ n'yuwatan n va̱, a̱vu n kototo le,</para>
  <para style="q2" vid="PSA 18:37">mi isawan shi she na n lyuwai aci e le suru.<verse eid="PSA 18:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38" />N kototo le ta̱ suru suru, hali a̱ kuɗa̱ 'yon,</para>
  <para style="q2" vid="PSA 18:38">a̱vu a̱ riya̱ za̱la̱ va ana a̱ va̱.<verse eid="PSA 18:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39" />Vu ca mu ta̱ ucira adama n yuwan uvon,</para>
  <para style="q2" vid="PSA 18:39">vu zuwa ta̱ n'yuwatan n va̱ za̱la̱ va ana a̱ va̱.<verse eid="PSA 18:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40" />Agba vu zuwa ta̱ n'yuwatan n va̱ a vadala reve a sumaa mu,</para>
  <para style="q2" vid="PSA 18:40">a̱vu n kototo aza a na a 'yuwan numu.<verse eid="PSA 18:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41" />A sala ta̱ adama a kamba le,</para>
  <para style="q2" vid="PSA 18:41">agba babu lo za na a wawa le,</para>
  <para style="q1" vid="PSA 18:41">a̱vu a salaa a̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 18:41">agba u usu le shi.<verse eid="PSA 18:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42" />N ta̱ luɓa̱tsa̱ le, hali o o'wo tsa̱ ma̱buta̱,</para>
  <para style="q1" vid="PSA 18:42">a̱vu n kula̱ le, mu dasa le tso olo'o e re.<verse eid="PSA 18:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43" />Vu wawa mu ta̱ e ekere a ama e iwuya a̱ va̱,</para>
  <para style="q2" vid="PSA 18:43">vu shuwa̱ mu ta̱ mo o'wo zagbain vu nɗa.</para>
  <para style="q2" vid="PSA 18:43">Ama a na n revei shi, o o'wo ta̱ agbashi a̱ va̱.<verse eid="PSA 18:43" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44" />Ele a uwwa adama aɗa a̱ va̱,</para>
  <para style="q2" vid="PSA 18:44">a tsu yuwaan mu ta̱ tsutoni,</para>
  <para style="q1" vid="PSA 18:44">na̱ meje'en ma̱ lipu</para>
  <para style="q2" vid="PSA 18:44">omocin a̱ tsu ta̱wa̱ ta̱ uba̱ta̱ u va̱, adama a ca mu tsugbain.<verse eid="PSA 18:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45" />Okolo e le a kuɗa ta̱,</para>
  <para style="q2" vid="PSA 18:45">a̱vu o uta̱ na̱ meje'en ma̱ lipu,</para>
  <para style="q2" vid="PSA 18:45">diga uba̱ta̱ u na a̱ da̱na̱i upa'awun.<verse eid="PSA 18:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46" />A̱sulazuva a̱ ta̱ wuma!</para>
  <para style="q2" vid="PSA 18:46">Aba'un za va̱ wu ɗa aatali o upa'atan a̱ va̱!</para>
  <para style="q2" vid="PSA 18:46">Tsugbain tsa̱ ta̱ e ekere a̱ A̱sula̱ za vi Iwawi i va̱.<verse eid="PSA 18:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47" />A̱yi ɗa A̱sula̱ a̱ va̱ za na a tsupaa mu,</para>
  <para style="q2" vid="PSA 18:47">a̱yi ɗa u zuwai nɗa za̱la̱ va̱.<verse eid="PSA 18:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 18:48" />U tsu wawa mu ta̱ diga e ekere a n'yuwatan n va̱.</para>
  <para style="q2" vid="PSA 18:48">U tsu ca mu ta̱ tsugbain e ekere aza a na a̱ ri a̱ tsushu'un na̱ mu.</para>
  <para style="q2" vid="PSA 18:48">U tsu wawa mu ta̱ e ekere a̱za̱ o 'ya̱sa̱sa̱n wu ugbozu.<verse eid="PSA 18:48" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49" />Adama o ndolo, A̱sulazuva,</para>
  <para style="q2" vid="PSA 18:49">n ta cuwa wu a̱tsuma̱ a nɗa,<note caller="-" style="x"><char style="xo" closed="false">18:49 </char><char style="xt" closed="false"><ref loc="ROM 15:9">Rom 15:9</ref>.</char></note></para>
  <para style="q2" vid="PSA 18:49">n ta cana ishipa yi ica a̱ tyo a Aala a̱ wu.<verse eid="PSA 18:49" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50" />U tsu ca ta̱ mogono ma̱ yi a̱ba̱jini o ulyuwu wa aci,</para>
  <para style="q2" vid="PSA 18:50">u tsu roco ta̱ icigi ya̱ yi i na i tsu vadala shi</para>
  <para style="q2" vid="PSA 18:50">uba̱ta̱ wu za na u tawai,</para>
  <para style="q1" vid="PSA 18:50">e ekere mogono Da̱wuda</para>
  <para style="q2" vid="PSA 18:50">nu ugundo wa̱ yi hali hali.<verse eid="PSA 18:50" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" sid="PSA 19" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1" />Zuva ta yuwusan adanshi a tsugbain tsa̱ A̱sula̱!</para>
  <para style="q2" vid="PSA 19:1">Eleshe waru a ta yuwusan adanshi a linga ve e ekere a̱ yi!<verse eid="PSA 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2" />Urana u tsu damma urana suru tsugbain tsa̱ a̱ yi,</para>
  <para style="q2" vid="PSA 19:2">ayin a tsu damma ta̱ ayin suru urevu wa̱ yi.<verse eid="PSA 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3" />Babu adanshi, ko danshi diga uba̱ta̱ u le,</para>
  <para style="q2" vid="PSA 19:3">waru babu uɗyo u na a uwwa.<verse eid="PSA 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4" />Amma suru na̱ ne uɗyo u le u rawa ta̱ a̱tsuma̱ o uvaɗi suru,<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="ROM 10:18">Rom 10:18</ref>.</char></note></para>
  <para style="q2" vid="PSA 19:4">idanshi i le i rawa ta̱ a̱tsuma̱ o uvaɗi suru.</para>
  <para style="b" vid="PSA 19:4" />
  <para style="q1" vid="PSA 19:4">Ɗe zuva A̱sula̱ a yuwaan ta̱ urana uba̱ta̱ wu nden,<verse eid="PSA 19:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 19:5" />wutu wu urana,</para>
  <para style="q2" vid="PSA 19:5">u ta̱ tsa vali sa'avu o uta̱sa̱ a aasula a̱yi,</para>
  <para style="q1" vid="PSA 19:5">ma̱za̱nga̱ ma̱ yi,</para>
  <para style="q2" vid="PSA 19:5">mo rotso ta̱ za vi ilaɗi na ri e ifoɓi i na wa suma.<verse eid="PSA 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6" />U tsu 'yon ta̱ diga a̱ ncilecile ma zuva,</para>
  <para style="q2" vid="PSA 19:6">a̱vu u ka̱nda̱ruwa̱ diga upasu u nda a̱ tyo upasu u ndeɗe,</para>
  <para style="q2" vid="PSA 19:6">babu ili i na yaa gura pa'an o usuɗuwu wa̱ yi.<verse eid="PSA 19:6" /></para>
  <para style="b" />
  <para style="s">Iroci yu uritosu wa̱ A̱sula̱</para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7" />Wila̱ wa̱ A̱sulazuva u ta̱ mejege,</para>
  <para style="q2" vid="PSA 19:7">u tsu ka̱mba̱to ta̱ wuma usa'avu.</para>
  <para style="q1" vid="PSA 19:7">Tsuɓari tsa̱ A̱sulazuva amayun a ɗa,</para>
  <para style="q2" vid="PSA 19:7">u tsu zuwa ta̱ za babu majiyan u tsura̱ ugbozu.<verse eid="PSA 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8" />Udammu wa̱ A̱sulazuva mejege ma ɗa a̱ ri,</para>
  <para style="q2" vid="PSA 19:8">a casu okolo ma̱za̱nga̱.</para>
  <para style="q1" vid="PSA 19:8">Wila̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 19:8">a̱ ri usa̱n u mereve shi,</para>
  <para style="q2" vid="PSA 19:8">a tsu ca ta̱ okolo urevu.<verse eid="PSA 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9" />Wovon wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 19:9">u tsu zuwa ta̱ okolo amayun,</para>
  <para style="q2" vid="PSA 19:9">a̱ da̱na̱ hali hali.</para>
  <para style="q1" vid="PSA 19:9">Wila̱ wa̱ A̱sulazuva amayun a ɗa,</para>
  <para style="q2" vid="PSA 19:9">waru a̱za̱ a̱ɓula̱ ɗa suru.<verse eid="PSA 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10" />Ili i maluwa ma ɗa i na i la'ai zinariya.</para>
  <para style="q2" vid="PSA 19:10">Amayun! U la'a ta̱ zinariya can!</para>
  <para style="q1" vid="PSA 19:10">A la'a ta̱ ishiki a̱limu.</para>
  <para style="q2" vid="PSA 19:10">Amayun! U la'a ta̱ ishiki i na i ri a abaji!<verse eid="PSA 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11" />O ure u le u ɗa aagbashi a̱ wu a̱ tsu tsura̱ tsuɓari,</para>
  <para style="q2" vid="PSA 19:11">uba̱ta̱ u tsutoni u le a̱ tsu tsura̱ ta̱ iliyinkapa ya̱ a̱bunda̱.<verse eid="PSA 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12" />Zane ɗa aa gura reve nusu va̱ yi?</para>
  <para style="q2" vid="PSA 19:12">Vu yuwaan mu gafura vu nusu na n revei shi.<verse eid="PSA 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13" />Vu wawa mu diga a mayan me ili i na n revei unusu u ɗa.</para>
  <para style="q2" vid="PSA 19:13">She vu lyawa ili i na okolo a̱ va̱ a cigai a la'a ucira u va̱ wan!</para>
  <para style="q1" vid="PSA 19:13">Tsundolo tsa ɗa mo o'wo za babu unusu,</para>
  <para style="q2" vid="PSA 19:13">moo o'wo za babu unusu fa̱a̱n.<verse eid="PSA 19:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14" />Lyawa adanshi o una̱ u va̱ na̱ majiyan mo okolo a̱ va̱,</para>
  <para style="q2" vid="PSA 19:14">o o'wo ili yu usuwu a̱ ma̱ka̱ka̱n ma̱ wu,</para>
  <para style="q1" vid="PSA 19:14">A̱sulazuva,</para>
  <para style="q2" vid="PSA 19:14">aatali o upa'atan u va̱ na̱ za va atsupu a̱ va̱!<verse eid="PSA 19:14" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" sid="PSA 20" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1" />Lyawa A̱sulazuva a uwwa wu,</para>
  <para style="q2" vid="PSA 20:1">a mantsa ma̱ a̱tsuma̱lima̱!</para>
  <para style="q1" vid="PSA 20:1">Lyawa ala a̱ A̱sula̱ a Yakubu,</para>
  <para style="q2" vid="PSA 20:1">wo o'wo wu mapari!<verse eid="PSA 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2" />Lyawa u lyungu wa̱ wu ni ikambi,</para>
  <para style="q2" vid="PSA 20:2">diga uba̱ta̱ wu nden ma akiza a̱ yi,</para>
  <para style="q1" vid="PSA 20:2">waru u ca wu ikambishi,</para>
  <para style="q2" vid="PSA 20:2">diga Sihiyona.<verse eid="PSA 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3" />Lyawa u cuwan,</para>
  <para style="q2" vid="PSA 20:3">na̱ kucci va̱ wu suru,</para>
  <para style="q1" vid="PSA 20:3">waru wu uwwa uyo'o,</para>
  <para style="q2" vid="PSA 20:3">u kucci vu ukula̱tosu va̱ wu suru!<verse eid="PSA 20:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4" />Lyawa u ca wu,</para>
  <para style="q2" vid="PSA 20:4">ili i na okolo a̱ wu a cigai biti,</para>
  <para style="q1" vid="PSA 20:4">u cawu ulyuwu wa aci,</para>
  <para style="q2" vid="PSA 20:4">a̱tsuma̱ e ifoɓi ya̱ wu biti.<verse eid="PSA 20:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5" />Tsu ta yuwan yisali,</para>
  <para style="q2" vid="PSA 20:5">adama a̱ ma̱za̱nga̱ o lyuwu wa aci a̱ wu,</para>
  <para style="q1" vid="PSA 20:5">tsu ta yuwan uje'en na̱ mere,</para>
  <para style="q2" vid="PSA 20:5">a̱tsuma̱ a aala a̱ A̱sula̱ a̱tsu.</para>
  <para style="q1" vid="PSA 20:5">Lyawa A̱sulazuva a̱ usu,</para>
  <para style="q2" vid="PSA 20:5">ipati ya̱ wu suru!<verse eid="PSA 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6" />Gogo tsunda n reve ta̱,</para>
  <para style="q2" vid="PSA 20:6">A̱sulazuva a tsu wawa ta̱ za na u tawai wo o'wo mogono,</para>
  <para style="q1" vid="PSA 20:6">u ta̱ usu yi diga zuva va akiza a̱ yi,</para>
  <para style="q2" vid="PSA 20:6">waru u ta ca yi a̱ba̱jini a̱ba̱jini o lyuwu wa aci,</para>
  <para style="q2" vid="PSA 20:6">nu ucira wu ukere usa'ani wa̱ yi.<verse eid="PSA 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7" />Ozo o ro a zuwaa ta̱,</para>
  <para style="q2" vid="PSA 20:7">ikeke yi ido ucira,</para>
  <para style="q1" vid="PSA 20:7">ozo o ro waru a zuwaa ta̱,</para>
  <para style="q2" vid="PSA 20:7">ido i le ucira.</para>
  <para style="q1" vid="PSA 20:7">Amma a̱tsu, tsu zuwaa ta̱</para>
  <para style="q2" vid="PSA 20:7">Ala a̱ A̱sulazuva A̱sula̱ a̱tsu ucira.<verse eid="PSA 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8" />Amma icu'un ya ama o ndolo a̱ ta̱ ta̱ɗa̱tsa̱ a̱vu a̱ riya̱.</para>
  <para style="q2" vid="PSA 20:8">Amma a̱tsu gba tsu ta̱ 'yon tsi isawan nu ukadu.<verse eid="PSA 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 20:9">vu wawa mogono!</para>
  <para style="q2" vid="PSA 20:9">Lyawa vu uwwa tsu a mantsa ma na tsu ɗeyi.<verse eid="PSA 20:9" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" sid="PSA 21" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 21:1">adama o ucira wa̱ wu u ɗa mogono maa yuwusan ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 21:1">U ta yuwusan ma̱za̱nga̱ lon adama a na vu wawa niyi!<verse eid="PSA 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2" />Vu ca yi ta̱ ili i na okolo a̱ yi a cigai,</para>
  <para style="q2" vid="PSA 21:2">vu kuɗa̱ a̱ usu ili i na u patiyi shi.<verse eid="PSA 21:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3" />Vu ta̱wa̱a̱ yi ta̱ na aba'un a sa'ani,</para>
  <para style="q2" vid="PSA 21:3">vu katala ta̱ aaci a̱ yi no okokolo a zinariya.<verse eid="PSA 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4" />U pati wu ta̱ wuma, a̱vu vu ca yi,</para>
  <para style="q2" vid="PSA 21:4">vu ca yi ta̱ wuma na̱ rana va̱ a̱bunda̱ hali hali.<verse eid="PSA 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5" />Tsugbain tsa̱ yi tsa̱ ta̱ mgbain,</para>
  <para style="q2" vid="PSA 21:5">adama e ikambishi ya̱ wu,</para>
  <para style="q2" vid="PSA 21:5">vu ca yi ta̱ tsugbain na̱ a̱ɓula̱.<verse eid="PSA 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6" />Vu zuwa ta̱ wo o'wo za va aba'un hali hali,</para>
  <para style="q2" vid="PSA 21:6">na vu ri oɓolo na̱ yi u yo'onoto yi ta̱ okolo.<verse eid="PSA 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7" />Ana wo o'woi mogono'o ma zuwa ta̱ ucira wa̱ yi uba̱ta̱ wa̱ wu,</para>
  <para style="q2" vid="PSA 21:7">A̱sulazuva Mogono Zagbain,</para>
  <para style="q1" vid="PSA 21:7">e ekere e icigi ya̱ wu i na i tsu vadala shi,</para>
  <para style="q2" vid="PSA 21:7">mogono mo ndolo ma̱ ri n jinga̱ɗa̱ shi.<verse eid="PSA 21:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8" />Ekere a̱ wu e te reme,</para>
  <para style="q2" vid="PSA 21:8">n'yuwatan ma̱ wu suru,</para>
  <para style="q1" vid="PSA 21:8">ukere usa'ani wa̱ wu uta̱ reme,</para>
  <para style="q2" vid="PSA 21:8">aza a na a 'yuwan nuwu.<verse eid="PSA 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9" />Vu ta̱ lyuwa le cine vu revei a akina a malya,</para>
  <para style="q2" vid="PSA 21:9">mantsa ma na vu uta̱i.</para>
  <para style="q1" vid="PSA 21:9">A̱sulazuva,</para>
  <para style="q2" vid="PSA 21:9">a̱tsuma̱ o upan wa̱ wu vu ta̱ soɗu le,</para>
  <para style="q2" vid="PSA 21:9">waru akina a ta lyuwa le.<verse eid="PSA 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10" />Mogono ma̱ ta̱ kototo muwun n le,</para>
  <para style="q2" vid="PSA 21:10">na̱ limatan le suru.<verse eid="PSA 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11" />Ko na̱ a̱ shi o foɓoo wu iwuya,</para>
  <para style="q2" vid="PSA 21:11">ko na̱ a̱ shi o foɓoo wu addama,</para>
  <para style="q2" vid="PSA 21:11">aa lyuwa aci shi.<verse eid="PSA 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12" />Adama a na vu ta zuwa le a vadala reve a suma,</para>
  <para style="q2" vid="PSA 21:12">mantsa ma na vu tewiyin aya a̱ wu.<verse eid="PSA 21:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 21:13">lyawa a ca wu tsugbain adama o ucira wa̱ wu,</para>
  <para style="q2" vid="PSA 21:13">tsu ta cana ishipa tsu cuwa tsugbain tsa aala a̱ wu.<verse eid="PSA 21:13" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" sid="PSA 22" />
  <para style="d">Udammu e ekere ma̱dobiya: A yuwain o una̱ wu uɗyo &lt;&lt;Mere'on&gt;&gt;. Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1" />A̱sula̱ a̱ va̱! A̱sula̱ a̱ va̱!</para>
  <para style="q2" vid="PSA 22:1">Adama nye vu vari numu?<note caller="-" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="ISA 49:14">Ish 49:14</ref>; <ref loc="MAT 27:46">Mat 27:46</ref>; <ref loc="MRK 15:34">Mak 15:34</ref>.</char></note></para>
  <para style="q1" vid="PSA 22:1">Nye i zuwai iwawi ya̱ wu i yuwain alanga na̱ a̱mu?</para>
  <para style="q2" vid="PSA 22:1">Nye i zuwai vu rungwa̱i mesun ma addama a̱ va̱?<verse eid="PSA 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2" />A̱sula̱ a̱ va̱!</para>
  <para style="q2" vid="PSA 22:2">N shon ta̱ nu urana,</para>
  <para style="q2" vid="PSA 22:2">agba vu usu mu shi.</para>
  <para style="q1" vid="PSA 22:2">N shon ta̱ na ayin,</para>
  <para style="q2" vid="PSA 22:2">agba n tsa̱ra̱ okolo nven shi.<verse eid="PSA 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3" />Na̱ ne suru a̱vu za va akiza ɗa,</para>
  <para style="q2" vid="PSA 22:3">na Isra'ila a yuwusaan ica.<verse eid="PSA 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4" />Nkaya ntsu n zuwa ta̱ ucira u le ya̱'a̱ wu,</para>
  <para style="q2" vid="PSA 22:4">a zuwa ta̱ ucira u le ya̱'a̱ wu,</para>
  <para style="q2" vid="PSA 22:4">agba vu wawa le ta̱.<verse eid="PSA 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5" />Ya̱'a̱ wu ɗa a̱ 'ya̱wa̱i na̱ mesun me e le,</para>
  <para style="q2" vid="PSA 22:5">a̱vu vu wawa le.</para>
  <para style="q1" vid="PSA 22:5">Ya̱'a̱ wu ɗa a zuwai ucira u le,</para>
  <para style="q2" vid="PSA 22:5">agba vu ca le wono shi.<verse eid="PSA 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6" />A̱mu vuma ɗa shi,</para>
  <para style="q2" vid="PSA 22:6">aazun a ɗa n ri goon,</para>
  <para style="q2" vid="PSA 22:6">ili yu ulamu ni ili i na ama a goroi.<verse eid="PSA 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7" />Aza a na ene numu suru,<note caller="-" style="x"><char style="xo" closed="false">22:7 </char><char style="xt" closed="false"><ref loc="MAT 27:39">Mat 27:39</ref>; <ref loc="MRK 15:29">Mak 15:29</ref>; <ref loc="LUK 23:35">Luk 23:35</ref>.</char></note></para>
  <para style="q2" vid="PSA 22:7">a tsu yuwaan mu ta̱ ulamu,</para>
  <para style="q2" vid="PSA 22:7">a tsu goro mu ta̱, reve a gbaɗatsasa aci e le.<verse eid="PSA 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8" />A tsu damma ta̱,</para>
  <para style="q2" vid="PSA 22:8">&lt;&lt;Ashe vu zuwa ucira wa̱ wu uba̱ta̱ wa̱ A̱sulazuva shi?<note caller="-" style="x"><char style="xo" closed="false">22:8 </char><char style="xt" closed="false"><ref loc="MAT 27:43">Mat 27:43</ref>.</char></note></para>
  <para style="q2" vid="PSA 22:8">To, lyawa u wawa wu!</para>
  <para style="q1" vid="PSA 22:8">Lyawa A̱sulazuva aa wawa wu,</para>
  <para style="q2" vid="PSA 22:8">nna̱ waa uwwusa uyo'o wa̱ wu!&gt;&gt;<verse eid="PSA 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9" />Na̱ ne suru,</para>
  <para style="q2" vid="PSA 22:9">a̱vu ɗa vu uta̱a̱ numu a̱a̱tsuma̱ a mma va̱,</para>
  <para style="q1" vid="PSA 22:9">a̱vu ɗa vu zuwa numu n zuwai okolo a̱ va̱ ya̱'a̱ wu,</para>
  <para style="q2" vid="PSA 22:9">a̱mu a apusa maani ma mma va̱.<verse eid="PSA 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10" />Diga a mantsa ma na a matsa numu n zuwa ta̱ ucira u va̱ ya̱'a̱ wu.</para>
  <para style="q2" vid="PSA 22:10">A̱vu ɗa A̱sula̱ a̱ va̱, diga urana u na a matsa numu.<verse eid="PSA 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11" />She vu yuwan alanga na̱ a̱mu wan,</para>
  <para style="q2" vid="PSA 22:11">adama a na addama a̱ ta̱ lo zuzu,</para>
  <para style="q2" vid="PSA 22:11">waru babu za vi ikambishi.<verse eid="PSA 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12" />N'yuwatan n va̱ n ka̱nda̱ruwa̱ mu ta̱ cine vu revei ogono e inan,</para>
  <para style="q2" vid="PSA 22:12">tso ogono e inan yu ucira ya atsusa a Bashan.<verse eid="PSA 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13" />A̱ kpa̱tu'wa̱ ta̱ na̱ le, cine vu revei ikamu,</para>
  <para style="q2" vid="PSA 22:13">i na i ri a̱ ma̱gugwa̱,</para>
  <para style="q2" vid="PSA 22:13">a zama a kakara mu.<verse eid="PSA 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14" />Ucira u va̱ u koto ta̱,</para>
  <para style="q2" vid="PSA 22:14">u lyawa mu ta̱ cine vu revei mini ma na mo ocoi.</para>
  <para style="q1" vid="PSA 22:14">Etele a̱ va̱ suru a kasa ta̱ na̱ a̱la̱ta̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 22:14">tsi ishiki wu ujeruwu,</para>
  <para style="q2" vid="PSA 22:14">ucira wo okolo a̱ va̱ a lyawa mu ta̱.<verse eid="PSA 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15" />Ucira u va̱ u koto ta̱ tsa ayimba,</para>
  <para style="q2" vid="PSA 22:15">eelentsu a̱ va̱ a kaɓa ta̱ o una̱ u va̱.</para>
  <para style="q1" vid="PSA 22:15">Vu lyawa mu ta̱ a̱tsuma̱ a̱ ma̱buta̱,</para>
  <para style="q2" vid="PSA 22:15">waru vu lyawa mu ta̱ tsa za na kuwa̱i.<verse eid="PSA 22:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16" />Oɓolo a̱za̱ e iwiya a̱ ka̱nda̱ruwa̱ mu ta̱,</para>
  <para style="q2" vid="PSA 22:16">cine vu revei oɓolo a̱ musa̱n.</para>
  <para style="q2" vid="PSA 22:16">A yazalan ta̱ e ekere a̱ va̱ oɓolo na̱ a ana a̱ va̱.<verse eid="PSA 22:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17" />N ta gura kece etele a̱ va̱ suru.</para>
  <para style="q2" vid="PSA 22:17">N'yuwatan n va̱ n zuwaa mu ta̱ esu,</para>
  <para style="q2" vid="PSA 22:17">a̱ ka̱lyuwusa̱ mu zuva zuva.<verse eid="PSA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18" />A yuwan ta̱ mazuwa ma agita adama o utugu u va̱,<note caller="-" style="x"><char style="xo" closed="false">22:18 </char><char style="xt" closed="false"><ref loc="MAT 27:35">Mat 27:35</ref>; <ref loc="MRK 15:24">Mak 15:24</ref>; <ref loc="LUK 23:34">Luk 23:34</ref>; <ref loc="JHN 19:24">Yah 19:24</ref>.</char></note></para>
  <para style="q2" vid="PSA 22:18">reve e ne'eshe utugu u va̱ a̱tsuma̱ ele.<verse eid="PSA 22:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19" />A̱sulazuva, she vu yuwan alanga na̱ mu wan!</para>
  <para style="q2" vid="PSA 22:19">Vu jika̱ naa vaa kamba mu, a̱vu za vu ucira!<verse eid="PSA 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20" />Vu wawa mu o una̱ u matsun me pe'eni,</para>
  <para style="q2" vid="PSA 22:20">vu wawa wuma u va̱ e ekere a̱ musa̱n nda.<verse eid="PSA 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21" />Vu wawa mu o una̱ wi ikamu nda!</para>
  <para style="q2" vid="PSA 22:21">Vu wawa mu e ekere a avana a yacin vu una!<verse eid="PSA 22:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22" />N ta damma a̱za̱ a̱ va̱ adama aala a̱ wu,<note caller="-" style="x"><char style="xo" closed="false">22:22 </char><char style="xt" closed="false"><ref loc="HEB 2:12">M.Ib 2:12</ref>.</char></note></para>
  <para style="q2" vid="PSA 22:22">n ta cuwa wu a̱tsuma̱ oɓolo a ama.<verse eid="PSA 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23" />A̱ɗu na yaa uwwusa wovon wa̱ A̱sulazuva, cuwa niyi!</para>
  <para style="q2" vid="PSA 22:23">Ugundo wa Yakubu suru ca niyi tsugbain!</para>
  <para style="q2" vid="PSA 22:23">'Ya̱sa̱in aala a̱yi zuva a̱ɗu ugundo wa Isra'ila suru!<verse eid="PSA 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24" />Adama a na u tsu lyawa aza a na a̱ ri nu ucira shi,</para>
  <para style="q2" vid="PSA 22:24">ko na wa̱ kuɗa̱ e idana a̱tsuma̱lima̱ ele shi.</para>
  <para style="q1" vid="PSA 22:24">U tsu soko urewesu wa̱ yi uba̱ta̱ u le shi,</para>
  <para style="q2" vid="PSA 22:24">amma u tsu uwwa le ta̱ mantsa ma na e ɗeyi izami yi ikambi.<verse eid="PSA 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25" />A̱vu ɗa ufaru wi ica i va̱,</para>
  <para style="q2" vid="PSA 22:25">a̱tsuma̱ a̱ a̱ba̱jini e iɓolo ya ama a̱ wu.</para>
  <para style="q1" vid="PSA 22:25">N ta̱ shiton akucunu a̱ va̱,</para>
  <para style="q2" vid="PSA 22:25">elime aza a na a uwwusa wovon wa̱ wu.<verse eid="PSA 22:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26" />Alambi a ta lyuwa hali a̱ cuwa̱n,</para>
  <para style="q2" vid="PSA 22:26">aza a na a zama e reve A̱sulazuva,</para>
  <para style="q2" vid="PSA 22:26">a ta cuwa yi.</para>
  <para style="q1" vid="PSA 22:26">Lyawa okolo ele a̱ da̱na̱,</para>
  <para style="q2" vid="PSA 22:26">na̱ ma̱za̱nga̱ hali hali.<verse eid="PSA 22:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27" />Ama o ukosu wu uvaɗi suru a ta cuwan,</para>
  <para style="q2" vid="PSA 22:27">reve a̱ ka̱mba̱ uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q1" vid="PSA 22:27">ama o umatsun wu uvaɗi suru,</para>
  <para style="q2" vid="PSA 22:27">a̱ ta̱ ka̱ɗa̱to a yuwan yi a̱ga̱nda̱.<verse eid="PSA 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28" />Adama a na tsugono tsa̱ ta̱ e ekere a̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 22:28">waru u ta yuwusan tsugono a aci a nɗa.<verse eid="PSA 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29" />A̱za̱ o utsuru a̱tsuma̱ o uvaɗi suru a̱ ta̱ ka̱ɗa̱to wa̱ yi,</para>
  <para style="q2" vid="PSA 22:29">oɓolo na aza a na a̱ ka̱mba̱ ma̱buta̱ suru,</para>
  <para style="q1" vid="PSA 22:29">oɓolo na aza a na a gura guza̱ wuma ule shi,</para>
  <para style="q2" vid="PSA 22:29">a̱ ta̱ kingyo elime a̱yi.<verse eid="PSA 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30" />Limatan nna ma̱a̱ ta̱wa̱,</para>
  <para style="q2" vid="PSA 22:30">ta yuwaan yi a̱ga̱nda̱.</para>
  <para style="q1" vid="PSA 22:30">Muwun nna a matsa,</para>
  <para style="q2" vid="PSA 22:30">aa ta uwwa adama aɗa A̱sulazuva.<verse eid="PSA 22:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31" />Ele fo aa ta yuwan adanshi adama aɗa a̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 22:31">e ekere aza a na o koto a matsain shi,</para>
  <para style="q1" vid="PSA 22:31">a ta damma le ana,</para>
  <para style="q2" vid="PSA 22:31">A̱sulazuva a ɗa a yuwain iwawi i nda.<verse eid="PSA 22:31" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" sid="PSA 23" />
  <para style="s">A̱sulazuva za va aguɓa a̱ va̱</para>
  <para style="d">Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1" />A̱sulazuva a ɗa za va aguɓa a̱ va̱,</para>
  <para style="q2" vid="PSA 23:1">maa lamba ili shi.<verse eid="PSA 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2" />U tsu zuwa mu ta̱ n von,<note caller="-" style="x"><char style="xo" closed="false">23:2 </char><char style="xt" closed="false"><ref loc="REV 7:17">Wen 7:17</ref>.</char></note></para>
  <para style="q2" vid="PSA 23:2">uba̱ta̱ wa anlya o uta̱nu.</para>
  <para style="q1" vid="PSA 23:2">U tsu toni ta̱ na̱ a̱mu,</para>
  <para style="q2" vid="PSA 23:2">e nge'en mu ɗolu</para>
  <para style="q2" vid="PSA 23:2">n na mee yeneshe ben.<verse eid="PSA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 23:3" />U tsu ca mu ta̱ ucira,</para>
  <para style="q2" vid="PSA 23:3">u tsu toni ta̱ na̱ a̱mu</para>
  <para style="q2" vid="PSA 23:3">o ure u mejege,</para>
  <para style="q2" vid="PSA 23:3">adama a ca ala a̱yi tsugbain.<verse eid="PSA 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4" />Ko na̱ shi n wala o uka̱ri</para>
  <para style="q2" vid="PSA 23:4">wi irumbu wu ukwa̱,</para>
  <para style="q1" vid="PSA 23:4">maa uwwa wovon shi,</para>
  <para style="q2" vid="PSA 23:4">adama a na vu to oɓolo na̱ a̱mu,</para>
  <para style="q1" vid="PSA 23:4">aaɗanga a mmalu,</para>
  <para style="q2" vid="PSA 23:4">na aaɗanga a aguɓa a̱ wu,</para>
  <para style="q2" vid="PSA 23:4">a ta ca mu asuvu nden.<verse eid="PSA 23:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5" />Vu foɓoo mu ta̱ mapara</para>
  <para style="q2" vid="PSA 23:5">a̱ ma̱ka̱ka̱n ma n'yuwatan n va̱.</para>
  <para style="q1" vid="PSA 23:5">Vu tsuwa̱a̱n ta̱ aaci a̱ va̱</para>
  <para style="q2" vid="PSA 23:5">mani'in e yeneshe,</para>
  <para style="q1" vid="PSA 23:5">hali mokkoto ma̱ va̱</para>
  <para style="q2" vid="PSA 23:5">ma shiwan mo oco.<verse eid="PSA 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6" />Na amayun, isa'ani ya̱ wu</para>
  <para style="q2" vid="PSA 23:6">ni icigi ya̱ wu i na i tsu vadala shi</para>
  <para style="q2" vid="PSA 23:6">i to toni mu,</para>
  <para style="q2" vid="PSA 23:6">a rana wuma u va̱ suru.</para>
  <para style="q1" vid="PSA 23:6">N ta̱ da̱nu o u'wa̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 23:6">hali hali.<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" sid="PSA 24" />
  <para style="d">Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1" />Uvaɗi za va̱ A̱sulazuva a ɗa,</para>
  <para style="q2" vid="PSA 24:1">ni ili i na i ri pe a̱tsuma̱ a̱ yi suru.</para>
  <para style="q1" vid="PSA 24:1">Uvaɗi za va̱ yi ɗa,</para>
  <para style="q2" vid="PSA 24:1">oɓolo na aza a na a̱ ri pe a̱tsuma̱ a̱ yi suru.<note caller="-" style="x"><char style="xo" closed="false">24:1 </char><char style="xt" closed="false"><ref loc="1CO 10:26">1 Kor 10:26</ref>.</char></note><verse eid="PSA 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2" />Adama a na u suwa yi ta̱ zuva mala<note caller="+" style="f"><char style="fr" closed="false">24:2 </char><char style="fq" closed="false">zuva mala </char><char style="ft" closed="false">A mantsa mo ufaru aza a Yahuda a̱ shi ta̱ adansaa a̱ shuwa̱ ta̱ uvaɗi zuva mala.</char></note>,</para>
  <para style="q2" vid="PSA 24:2">waru u shuwa̱ ta̱ ikyun ya̱ yi zuva mini.<verse eid="PSA 24:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3" />Zane ɗa aa gura kumba</para>
  <para style="q2" vid="PSA 24:3">zuva masasan ma̱ A̱sulazuva?<note caller="-" style="x"><char style="xo" closed="false">24:3 </char><char style="xt" closed="false"><ref loc="PSA 15:1">Ica 15:1</ref>.</char></note></para>
  <para style="q1" vid="PSA 24:3">Zane ɗa aa gura isawan</para>
  <para style="q2" vid="PSA 24:3">o Oogodo o Uga'asusan a̱ yi?<verse eid="PSA 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4" />Za na e ekere a̱yi a̱ ri cece,</para>
  <para style="q2" vid="PSA 24:4">waru okolo a̱yi a̱ ri cece,</para>
  <para style="q1" vid="PSA 24:4">za na zuwai okolo a̱yi,</para>
  <para style="q2" vid="PSA 24:4">uba̱ta̱ wa̱ a̱ma̱li shi,</para>
  <para style="q2" vid="PSA 24:4">ko u yuwan akucunu e epen shi.<note caller="-" style="x"><char style="xo" closed="false">24:4 </char><char style="xt" closed="false"><ref loc="MAT 5:8">Mat 5:8</ref>.</char></note><verse eid="PSA 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5" />Cu'un vuma ndolo ta̱ tsura̱ aba'un</para>
  <para style="q2" vid="PSA 24:5">uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q1" vid="PSA 24:5">ni iwawi diga uba̱ta̱ wa̱ A̱sula̱</para>
  <para style="q2" vid="PSA 24:5">za vi iwawi ya̱ yi.<verse eid="PSA 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6" />Ele ɗa icu'un ya a ama a na a̱ ta̱wusa̱ uba̱ta̱ wa̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 24:6">aza a na a̱ ta̱wusa̱ a̱ ma̱ka̱nka̱ ma̱ A̱sula̱ a Yakubu.<verse eid="PSA 24:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7" />A̱ɗu na̱ntsu, i kpa̱tu'wa̱ washin!</para>
  <para style="q2" vid="PSA 24:7">A̱ɗu akuci a̱ na̱ntsu, i kpa̱tu'wa̱!</para>
  <para style="q1" vid="PSA 24:7">Adama a na Mogono ma gbain maa uwa!<verse eid="PSA 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8" />Zane ɗa Mogono ma gbai'in?</para>
  <para style="q2" vid="PSA 24:8">A̱sulazuva a ɗa</para>
  <para style="q2" vid="PSA 24:8">za vu ucira nu ukadu!</para>
  <para style="q1" vid="PSA 24:8">A̱sulazuva a na a tsu lyuwa a aci</para>
  <para style="q2" vid="PSA 24:8">a̱tsuma̱ o uvon!<verse eid="PSA 24:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9" />A̱ɗu na̱ntsu kpa̱tu'wa̱ yi washin!</para>
  <para style="q2" vid="PSA 24:9">A̱ɗu akuci a̱ na̱ntsu, i kpa̱tu'wa̱!</para>
  <para style="q2" vid="PSA 24:9">Adama a na Mogono ma gbain maa uwa!<verse eid="PSA 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10" />Zane ɗa Mogono ma gbai'in?</para>
  <para style="q2" vid="PSA 24:10">A̱sulazuva o oɓolo a̱soja a zuva,</para>
  <para style="q2" vid="PSA 24:10">a̱yi ɗa Mogono ma gbai'in.<verse eid="PSA 24:10" /></para>
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" sid="PSA 25" />
  <para style="s">Ipati yi izami i gafura oɓolo na̱ mapari</para>
  <para style="d">Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1" />A̱sulazuva ya̱'a̱ wu ɗa,</para>
  <para style="q2" vid="PSA 25:1">maa zuwusa okolo a̱ va̱.<verse eid="PSA 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2" />A̱sula̱ ya̱'a̱ wu ɗa</para>
  <para style="q2" vid="PSA 25:2">n zuwai ucira u va̱.</para>
  <para style="q1" vid="PSA 25:2">She vu lyawa mu uwwa wono wan,</para>
  <para style="q2" vid="PSA 25:2">ko vu lyawa n'yuwatan n va̱,</para>
  <para style="q2" vid="PSA 25:2">n lyuwa a aci a̱ va̱ wan.<verse eid="PSA 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3" />She vu lyawa za na zuwai okolo a̱yi,</para>
  <para style="q2" vid="PSA 25:3">ya̱'a̱ wu uwwa wono wan.</para>
  <para style="q1" vid="PSA 25:3">Amma lyawa aza a yipaalishi,</para>
  <para style="q2" vid="PSA 25:3">a uwwa wono.<verse eid="PSA 25:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4" />A̱sulazuva vu roco mu re va̱ wu,</para>
  <para style="q2" vid="PSA 25:4">waru vu rito mu aɗa a̱ wu.<verse eid="PSA 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5" />Vu toni na̱ a̱mu</para>
  <para style="q2" vid="PSA 25:5">o ure wa amayun a̱ wu,</para>
  <para style="q2" vid="PSA 25:5">waru vu rito mu.</para>
  <para style="q1" vid="PSA 25:5">Adama a na a̱vu ɗa A̱sula̱</para>
  <para style="q2" vid="PSA 25:5">za vi iwawi i va̱,</para>
  <para style="q1" vid="PSA 25:5">u zuwu o okolo a̱ va̱</para>
  <para style="q2" vid="PSA 25:5">a̱ ta̱ ya̱'a̱ wu mantsa suru.<verse eid="PSA 25:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6" />A̱sulazuva vu cuwan ni iliyali ya̱ wu</para>
  <para style="q2" vid="PSA 25:6">ni icigi ya̱ wu i na i tsu vadala shi,</para>
  <para style="q2" vid="PSA 25:6">aza a na vu yuwain ɗe.<verse eid="PSA 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7" />She vu cuwan na̱ nusu</para>
  <para style="q2" vid="PSA 25:7">tsulolobo tsa̱ va̱</para>
  <para style="q2" vid="PSA 25:7">na̱ re va aciyogbamu a̱ va̱ wan,</para>
  <para style="q1" vid="PSA 25:7">vu cuwan na̱ a̱mu,</para>
  <para style="q2" vid="PSA 25:7">o una̱ wi icigi ya̱ wu i na i tsu vadala shi,</para>
  <para style="q2" vid="PSA 25:7">adama a na a̱vu za vi isa'ani ɗa.<verse eid="PSA 25:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8" />A̱sulazuva za va̱ a̱ɓula̱ ni isa'ani ɗa,</para>
  <para style="q2" vid="PSA 25:8">u tsu roco ta̱ ozo o unusu</para>
  <para style="q2" vid="PSA 25:8">ure u na o toni.<verse eid="PSA 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9" />U tsu toni ta̱</para>
  <para style="q2" vid="PSA 25:9">na aza a na a tarai aciyele</para>
  <para style="q2" vid="PSA 25:9">ili i ro shi</para>
  <para style="q1" vid="PSA 25:9">a̱tsuma̱ e ili i na iri mejege</para>
  <para style="q2" vid="PSA 25:9">reve u roco le re va̱ yi.<verse eid="PSA 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10" />Re va̱ A̱sulazuva suru,</para>
  <para style="q2" vid="PSA 25:10">icigi i ɗa i na i tsu vadala shi na̱ a̱ɓula̱,</para>
  <para style="q1" vid="PSA 25:10">e ekere aza a na a toniyi</para>
  <para style="q2" vid="PSA 25:10">udammu na̱ nzuwulai ma̱ yi.<verse eid="PSA 25:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11" />A̱sulazuva, adama aala a̱ wu</para>
  <para style="q2" vid="PSA 25:11">vu yuwaan mu gafura vu unusu u va̱,</para>
  <para style="q2" vid="PSA 25:11">ko na wo o'woi a̱ ta̱ a̱bunda̱ lon.<verse eid="PSA 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12" />Zane ɗa vuma na</para>
  <para style="q2" vid="PSA 25:12">a uwwusa wovon wa̱ A̱sulazuva?</para>
  <para style="q2" vid="PSA 25:12">U ta̱ roco yi ure u na woo toni.<verse eid="PSA 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13" />Mantsa suru u ta̱ da̱na̱</para>
  <para style="q2" vid="PSA 25:13">na asuvu nden</para>
  <para style="q1" vid="PSA 25:13">waru muwun ma̱ yi</para>
  <para style="q2" vid="PSA 25:13">n to o'wo na agadu e iɗa'a.<verse eid="PSA 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14" />A̱sulazuva i'utsa̱ ya aza a na</para>
  <para style="q2" vid="PSA 25:14">a uwwusa wovon wa̱ yi u ɗa,</para>
  <para style="q1" vid="PSA 25:14">u tsu lyawa le ta̱</para>
  <para style="q2" vid="PSA 25:14">e reve nzuwulai ma̱ yi.<verse eid="PSA 25:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15" />Esu a̱ va̱ a̱ ta̱ kuci</para>
  <para style="q2" vid="PSA 25:15">uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q1" vid="PSA 25:15">adama a na a̱yi ɗa</para>
  <para style="q2" vid="PSA 25:15">u tsu wawa mu a̱tsuma̱ e meleshe.<verse eid="PSA 25:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16" />Vu vadala a̱ tyo ya̱'a̱ va̱,</para>
  <para style="q2" vid="PSA 25:16">vu yuwaan mu isa'ani,</para>
  <para style="q1" vid="PSA 25:16">adama a na a̱mu ɗa a̱ nde'en,</para>
  <para style="q2" vid="PSA 25:16">waru a 'yuwan mu ta̱.<verse eid="PSA 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17" />A̱tsuma̱lima̱ a̱ va̱ a̱ da̱shi ta̱,</para>
  <para style="q2" vid="PSA 25:17">vu uta̱a̱ mu</para>
  <para style="q2" vid="PSA 25:17">a̱tsuma̱ a̱ a̱tsuma̱lima̱ a̱ va̱ suru.<verse eid="PSA 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18" />Vi idana a̱tsuma̱lima̱ a̱ va̱</para>
  <para style="q2" vid="PSA 25:18">na addama a̱ va̱,</para>
  <para style="q1" vid="PSA 25:18">vu yuwaan mu gafura</para>
  <para style="q2" vid="PSA 25:18">vu nusu va̱ suru.<verse eid="PSA 25:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19" />Ka̱lyuwa̱ cine n'yuwatan n va̱</para>
  <para style="q2" vid="PSA 25:19">n da̱shiyi a̱bunda̱,</para>
  <para style="q2" vid="PSA 25:19">na̱ cine a̱ ima̱ numu lon!<verse eid="PSA 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20" />Vu geshe wuma u va̱!</para>
  <para style="q2" vid="PSA 25:20">Reve vu wawa mu!</para>
  <para style="q1" vid="PSA 25:20">She vu lyawa mu,</para>
  <para style="q2" vid="PSA 25:20">mu uwwa wono wan!</para>
  <para style="q2" vid="PSA 25:20">Adama a na a̱vu ɗa upa'atan u va̱!<verse eid="PSA 25:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21" />Lyawa a̱ɓula̱ na amayun,</para>
  <para style="q2" vid="PSA 25:21">a̱ geshe mu,</para>
  <para style="q1" vid="PSA 25:21">adama a na ya̱'a̱ wu ɗa</para>
  <para style="q2" vid="PSA 25:21">maa zuwusa okolo a̱ va̱.<verse eid="PSA 25:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22" />A̱sula̱ vu wawa aza a Isra'ila,</para>
  <para style="q2" vid="PSA 25:22">a̱tsuma̱ a̱ a̱tsuma̱lima̱ e le suru.<verse eid="PSA 25:22" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" sid="PSA 26" />
  <para style="d">Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1" />A̱sulazuva vu roco,</para>
  <para style="q2" vid="PSA 26:1">a̱mu za vu unusu ɗa shi,</para>
  <para style="q1" vid="PSA 26:1">adama a na n yuwan ta̱</para>
  <para style="q2" vid="PSA 26:1">ili i na i ri mejege,</para>
  <para style="q1" vid="PSA 26:1">waru n zuwa ta̱</para>
  <para style="q2" vid="PSA 26:1">ucira u va̱ ya̱'a̱ wu</para>
  <para style="q2" vid="PSA 26:1">n kuɗa okolo shi.<verse eid="PSA 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2" />A̱sulazuva vu petelyuwe mu ve e ene,</para>
  <para style="q2" vid="PSA 26:2">waru vu lyungwa̱ mu,</para>
  <para style="q1" vid="PSA 26:2">vi idana okolo a̱ va̱</para>
  <para style="q2" vid="PSA 26:2">na̱ majiyan ma̱ va̱.<verse eid="PSA 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3" />Adama a na n ta̱ nu</para>
  <para style="q2" vid="PSA 26:3">urevu wi icigi ya̱ wu i na i tsu vadala shi,</para>
  <para style="q1" vid="PSA 26:3">waru a̱tsuma̱ a̱ɓula̱ a̱ wu a ɗa</para>
  <para style="q2" vid="PSA 26:3">ma yuwusan mmalu mantsa suru.<verse eid="PSA 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4" />N tsu da̱nu naa ama e pere shi,</para>
  <para style="q2" vid="PSA 26:4">waru babu imini i va̱ na̱ a̱za̱ e ikpa'a.<verse eid="PSA 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5" />N 'yuwan ta̱ iɓolo yaa ama awuya,</para>
  <para style="q2" vid="PSA 26:5">waru n 'yuwan ta̱ a̱ da̱nu</para>
  <para style="q2" vid="PSA 26:5">na̱ a̱za̱ e iwuya.<verse eid="PSA 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6" />A̱sulazuva mu za̱'wa̱ ta̱ e ekere a̱ va̱,</para>
  <para style="q2" vid="PSA 26:6">adama n roco n ri nu unusu shi,</para>
  <para style="q1" vid="PSA 26:6">na̱ a̱ga̱nda̱ a ɗa n tsu dasu</para>
  <para style="q2" vid="PSA 26:6">a̱ka̱nda̱ruwa̱ masa'a ma̱ wu.<verse eid="PSA 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7" />N ta canasa ishipa</para>
  <para style="q2" vid="PSA 26:7">yu ugodyusho nu ucira,</para>
  <para style="q1" vid="PSA 26:7">a dansa ili ya asalama</para>
  <para style="q2" vid="PSA 26:7">a na vu yuwain suru.<verse eid="PSA 26:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8" />A̱sulazuva n ta̱ e icigi,</para>
  <para style="q2" vid="PSA 26:8">yu u'wa u na vu ri nden,</para>
  <para style="q1" vid="PSA 26:8">uba̱ta̱ u na tsugbain tsa̱ wu</para>
  <para style="q2" vid="PSA 26:8">tsa̱ ri nden.<verse eid="PSA 26:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9" />She vu kototo mu</para>
  <para style="q2" vid="PSA 26:9">oɓolo no ozo o unusu wan,</para>
  <para style="q1" vid="PSA 26:9">ko vu tara wuma u va̱</para>
  <para style="q2" vid="PSA 26:9">oɓolo na aza a na</para>
  <para style="q2" vid="PSA 26:9">o ocosu mpasa wan.<verse eid="PSA 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10" />Ekere e le a ta yuwusan iwuya,</para>
  <para style="q2" vid="PSA 26:10">waru ekere le a̱ ta̱ tapu</para>
  <para style="q2" vid="PSA 26:10">nu utowusu wu una̱.<verse eid="PSA 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11" />Amma a̱mu za va̱ a̱ɓula̱ ɗa,</para>
  <para style="q2" vid="PSA 26:11">vu wawa mu</para>
  <para style="q2" vid="PSA 26:11">waru vu roco mu iliyali.<verse eid="PSA 26:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12" />Vu wawa mu ta̱ a̱tsuma̱ e meleshe suru,</para>
  <para style="q2" vid="PSA 26:12">a̱tsuma̱ e iɓolo ya akiza</para>
  <para style="q2" vid="PSA 26:12">n ta cuwa a̱ A̱sulazuva.<verse eid="PSA 26:12" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" sid="PSA 27" />
  <para style="d">Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1" />A̱sulazuva a ɗa ekan a̱ va̱</para>
  <para style="q2" vid="PSA 27:1">ni iwawi i va̱,</para>
  <para style="q2" vid="PSA 27:1">wovon wa zane ɗa maa uwwa?</para>
  <para style="q1" vid="PSA 27:1">A̱sulazuva a ɗa upa'atan u va̱,</para>
  <para style="q2" vid="PSA 27:1">wovon wa zane ɗa maa uwwa?<verse eid="PSA 27:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2" />Mantsa ma na a̱za̱ e iwuya</para>
  <para style="q2" vid="PSA 27:2">a̱ riya̱a̱ numu,</para>
  <para style="q1" vid="PSA 27:2">tsa̱ra̱ o una a̱mu,</para>
  <para style="q2" vid="PSA 27:2">a̱ ta̱ ta̱ɗa̱tsa̱ a̱vu a̱ riya̱.<verse eid="PSA 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3" />Ko na̱ shi o oɓolo a̱ a̱soja</para>
  <para style="q2" vid="PSA 27:3">a̱ ka̱nda̱ruwa̱ mu,</para>
  <para style="q2" vid="PSA 27:3">okolo a̱ va̱ a da'wan shi.</para>
  <para style="q1" vid="PSA 27:3">Ko na̱ shi a̱ riya̱a̱ mu ta̱ nu uvon,</para>
  <para style="q2" vid="PSA 27:3">na̱ ne suru n ta̱ da̱na̱ na asuvu nven.<verse eid="PSA 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4" />M pati ta̱ A̱sulazuva ili i ta̱,</para>
  <para style="q2" vid="PSA 27:4">apa ili i na m patiyi,</para>
  <para style="q1" vid="PSA 27:4">n ciga ta̱ n da̱nu</para>
  <para style="q2" vid="PSA 27:4">o u'wa wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 27:4">a wuma u va̱ suru,</para>
  <para style="q1" vid="PSA 27:4">tsa̱ra̱ n da̱na̱ e eneshe</para>
  <para style="q2" vid="PSA 27:4">tsugbain tsa̱ yi,</para>
  <para style="q1" vid="PSA 27:4">waru n zami urewesu wa̱ yi</para>
  <para style="q2" vid="PSA 27:4">a̱ A̱a̱'isamapaɗa a̱ yi.<verse eid="PSA 27:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5" />Adama a na a̱tsuma̱ a rana va̱ a̱tsuma̱lima̱,</para>
  <para style="q2" vid="PSA 27:5">u to soko mu a̱tsuma̱ oogodo a̱yi,</para>
  <para style="q1" vid="PSA 27:5">u to soko mu o ululu</para>
  <para style="q2" vid="PSA 27:5">wa akiza oogodo a̱yi,</para>
  <para style="q1" vid="PSA 27:5">reve u zuwa mu zuva</para>
  <para style="q2" vid="PSA 27:5">va aatali o uga'an.<verse eid="PSA 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6" />Adama n tsura̱ ulyuwu wa a aci</para>
  <para style="q2" vid="PSA 27:6">e ekere a n'yuwatan</para>
  <para style="q2" vid="PSA 27:6">n na n ka̱nda̱ruwa̱ numu,</para>
  <para style="q1" vid="PSA 27:6">o oogodo a̱yi ɗa maa ca kucci</para>
  <para style="q2" vid="PSA 27:6">nu uɗyo u ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 27:6">n ta cana a̱vu n yuwaan A̱sulazuva tsuwe'e.<verse eid="PSA 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7" />A̱sulazuva, vu uwwa uɗyo u va̱,</para>
  <para style="q2" vid="PSA 27:7">a mantsa ma na n ɗeyi,</para>
  <para style="q1" vid="PSA 27:7">vee e ene iliyali i va̱</para>
  <para style="q2" vid="PSA 27:7">vu uwwa mu.<verse eid="PSA 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8" />A̱sulazuva vu damma ta̱,</para>
  <para style="q2" vid="PSA 27:8">&lt;&lt;Ta̱wa̱ uba̱ta̱ u va̱,&gt;&gt;</para>
  <para style="q2" vid="PSA 27:8">N ta̱ gba a̱ ta̱wa̱ uba̱ta̱ wa̱ wu.<verse eid="PSA 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9" />She vu tawa urewesu wa̱ wu uba̱ta̱ u va̱ wan!</para>
  <para style="q2" vid="PSA 27:9">She vu lo aagbashi a̱ wu a̱tsuma̱ o upan wan!</para>
  <para style="q1" vid="PSA 27:9">A̱vu ɗa za vi ikambi i va̱,</para>
  <para style="q2" vid="PSA 27:9">she vu lyawa mu ko vu vari mu wan,</para>
  <para style="q2" vid="PSA 27:9">A̱sula̱ za vi iwawi i va̱!<verse eid="PSA 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10" />Ko na̱ shi dada va̱ na̱ mma va̱ a vari mu,</para>
  <para style="q2" vid="PSA 27:10">A̱sulazuva a̱ ta̱ e idana mu.<verse eid="PSA 27:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11" />A̱sulazuva vu roco mu re va̱ wu.</para>
  <para style="q2" vid="PSA 27:11">Vu rono mu aaɗanga o ure u mejege,</para>
  <para style="q1" vid="PSA 27:11">adama a na n'yuwatan n va̱</para>
  <para style="q2" vid="PSA 27:11">n ta pura n riya̱.<verse eid="PSA 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12" />She vu vari mu e ekere a n'yuwatan n va̱</para>
  <para style="q2" vid="PSA 27:12">aza a na aa yuwusan adanshi e epen a aci a̱ va̱,</para>
  <para style="q2" vid="PSA 27:12">a̱ 'ya̱susa̱n ugbozu u va̱ wan.<verse eid="PSA 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13" />A̱mu n ta̱ nu uzuwu wo okolo,</para>
  <para style="q2" vid="PSA 27:13">n te ene isa'ani ya̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 27:13">pa o uvaɗi wa aza a wuma.<verse eid="PSA 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14" />Vu zuwa okolo uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 27:14">vu da̱na̱ nu ugbamu wo okolo a̱vu vu kaɓa asuvu!</para>
  <para style="q2" vid="PSA 27:14">Amayun, vu zuwa okolo uba̱ta̱ wa̱ A̱sulazuva.<verse eid="PSA 27:14" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" sid="PSA 28" />
  <para style="d">Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1" />A̱sulazuva a̱vu ɗa n ri e ipati aatali o upa'atan u va̱!</para>
  <para style="q2" vid="PSA 28:1">She vu ulaa mu atsuvu wan.</para>
  <para style="q1" vid="PSA 28:1">Adama a na n na̱ vu rungwa̱ kpen,</para>
  <para style="q2" vid="PSA 28:1">n to o'wo tsa aza a na</para>
  <para style="q2" vid="PSA 28:1">a̱ ka̱ra̱i a̱ tyo a aason.<verse eid="PSA 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2" />Vu uwwa ipati i va̱</para>
  <para style="q2" vid="PSA 28:2">vee ene iliyali i va̱</para>
  <para style="q2" vid="PSA 28:2">a mantsa ma na n ɗe nuwu</para>
  <para style="q2" vid="PSA 28:2">adama e ikambishi,</para>
  <para style="q1" vid="PSA 28:2">a mantsa ma na n 'ya̱sa̱in</para>
  <para style="q2" vid="PSA 28:2">e ekere a̱ va̱ a avasa,</para>
  <para style="q2" vid="PSA 28:2">a̱ ka̱lyuwusa̱ A̱a̱'isa̱ Akiza a̱ wu.<verse eid="PSA 28:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3" />She vu kece mu oɓolo</para>
  <para style="q2" vid="PSA 28:3">na̱ a̱za̱ e iwuya wan,</para>
  <para style="q1" vid="PSA 28:3">oɓolo na aza a na</para>
  <para style="q2" vid="PSA 28:3">a yuwusan iwuya wan,</para>
  <para style="q1" vid="PSA 28:3">ama a na adanshi e le</para>
  <para style="q2" vid="PSA 28:3">va damma za muwwulai ɗa,</para>
  <para style="q1" vid="PSA 28:3">amma okolo e le</para>
  <para style="q2" vid="PSA 28:3">tapu ɗa u ri na̱ tsushu'un.<verse eid="PSA 28:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4" />Vu tsupa le o una̱ wi ili i na a yuwain,</para>
  <para style="q2" vid="PSA 28:4">na̱ o una̱ wi iwuya i na a yuwain fo.</para>
  <para style="q1" vid="PSA 28:4">Vu tsupa le o una̱ wu ulinga</para>
  <para style="q2" vid="PSA 28:4">u na e ekere e le a yuwain,</para>
  <para style="q2" vid="PSA 28:4">a̱vu vu tsupa le ili i na yi ntsaa nle.<verse eid="PSA 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5" />Ana wo o'woi a tara</para>
  <para style="q2" vid="PSA 28:5">ulinga wa̱ A̱sulazuva ili i ro shi</para>
  <para style="q2" vid="PSA 28:5">oɓolo ni ili i na e ekere a̱ yi a yuwain shi,</para>
  <para style="q1" vid="PSA 28:5">u ta̱ kototo le,</para>
  <para style="q2" vid="PSA 28:5">waru wa̱a̱ da̱shi 'ya̱sa̱n le shi.<verse eid="PSA 28:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6" />Aba'un za va̱ A̱sulazuva a ɗa,</para>
  <para style="q2" vid="PSA 28:6">adama a na wu uwwa ta̱</para>
  <para style="q2" vid="PSA 28:6">mesun me izami yi ikambishi i va̱.<verse eid="PSA 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7" />A̱sulazuva a ɗa ucira u va̱</para>
  <para style="q2" vid="PSA 28:7">oɓolo na̱ a̱a̱ra̱ga̱ a̱ va̱,</para>
  <para style="q1" vid="PSA 28:7">okolo a̱ va̱</para>
  <para style="q2" vid="PSA 28:7">a zuwa ta̱ ucira ya̱ a̱ yi,</para>
  <para style="q2" vid="PSA 28:7">waru u kamba mu ta̱.</para>
  <para style="q1" vid="PSA 28:7">Okolo a̱ va̱ a yuwan ta̱ ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 28:7">waru n ta̱ godyoo yi</para>
  <para style="q2" vid="PSA 28:7">a̱tsuma̱ e ishipa.<verse eid="PSA 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8" />A̱sulazuva a ɗa ucira</para>
  <para style="q2" vid="PSA 28:8">wa a ama a̱yi,</para>
  <para style="q1" vid="PSA 28:8">upa'atan wu ucira wi iwawi</para>
  <para style="q2" vid="PSA 28:8">adama o mogono ma na u tawai.<verse eid="PSA 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9" />Lyawa vu wawa a ama a̱ wu,</para>
  <para style="q2" vid="PSA 28:9">vu zuwaa a ama agadu a̱ wu aba'un,</para>
  <para style="q1" vid="PSA 28:9">vo o'wo za va aguɓa e le,</para>
  <para style="q2" vid="PSA 28:9">a̱vu vi idana le hali hali.<verse eid="PSA 28:9" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" sid="PSA 29" />
  <para style="d">Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1" />I cuwa A̱sulazuva a̱ɗu musula̱,</para>
  <para style="q2" vid="PSA 29:1">i cuwa tsugbain tsa̱ yi nu ucira wa̱ yi.<verse eid="PSA 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2" />I cuwa tsugbain tsa ala a̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 29:2">i kingyo elime a̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 29:2">adama a tsugbain tsa akiza a̱ yi.<verse eid="PSA 29:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3" />A uwwa ta̱ uɗyo wa̱ A̱sulazuva zuva mala,</para>
  <para style="q2" vid="PSA 29:3">A̱sula̱ za Tsugbain yuwan ta̱ tsata.</para>
  <para style="q2" vid="PSA 29:3">Tsata'an u usu ta̱ nu ucira zuva mala.<verse eid="PSA 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4" />Uɗyo wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 29:4">u ta̱ nu ucira.</para>
  <para style="q1" vid="PSA 29:4">Uɗyo wa̱ yi,</para>
  <para style="q2" vid="PSA 29:4">u ta̱ tapu na̱ tsugbain.<verse eid="PSA 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5" />Uɗyo wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 29:5">u ta a kuɗusa ɗanga sida,<note caller="+" style="f"><char style="fr" closed="false">29:5 </char><char style="fq" closed="false">ɗanga sida </char><char style="ft" closed="false">Cu'un vu uɗanga u ro u ɗa wu ugbamu lon na a̱ a̱tsura̱ e iɗa ya̱ Lebanon. Mishin wu uga'an wu uɗanga'a u rawa ta̱ udasuwu kupa kucci, ugba̱mu wa̱ yi waru u rawa ta̱ udasuwu mata'atsu no ozo o ton.</char></note></para>
  <para style="q2" vid="PSA 29:5">u ta a kuɗusa ɗanga gbagbain va Lebanon.<verse eid="PSA 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6" />U ta zuwusa nsasan ma̱ Lebanon,</para>
  <para style="q2" vid="PSA 29:6">tsu'yan tsa ma̱dindim,</para>
  <para style="q1" vid="PSA 29:6">masasan ma Hamon waru tsu'yan</para>
  <para style="q2" vid="PSA 29:6">tsa mawun ma yanci.<verse eid="PSA 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7" />Uɗyo wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 29:7">u tsu zuwa ta̱ imaɗatsu i ca ekan.<verse eid="PSA 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8" />Uɗyo wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 29:8">u tsu zuwa ta̱ a̱tsumona a̱ jinga̱ɗa̱.</para>
  <para style="q1" vid="PSA 29:8">Uɗyo wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 29:8">u tsu zuwa ta̱ a̱tsumona a Kedesh a̱ jinga̱ɗa̱.<verse eid="PSA 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9" />Uɗyo wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 29:9">u tsu zuwa ta̱ ɗanga seda a̱ jinga̱ɗa̱,</para>
  <para style="q2" vid="PSA 29:9">u tsu zuwa ta̱ ɗanga va̱ a̱rumbu o oco a̱vu'un.</para>
  <para style="q1" vid="PSA 29:9">A̱tsuma̱ a̱ A̱a̱'isamapaɗa a̱ yi</para>
  <para style="q2" vid="PSA 29:9">vuma suru tsu 'ya̱sa̱n ta̱</para>
  <para style="q2" vid="PSA 29:9">uɗyo wa̱ yi adansa,</para>
  <para style="q2" vid="PSA 29:9">&lt;&lt;Tsugbain za va̱ A̱sula̱ ɗa!&gt;&gt;<verse eid="PSA 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10" />A̱sulazuva a ta yuwusan,</para>
  <para style="q2" vid="PSA 29:10">tsugono zuva mini ma gbain,</para>
  <para style="q1" vid="PSA 29:10">A̱sulazuva a ta yuwusan tsugono,</para>
  <para style="q2" vid="PSA 29:10">tsa̱ mogono hali hali.<verse eid="PSA 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11" />Lyawa a̱ A̱sulazuva a ca ama a̱ yi ucira!</para>
  <para style="q2" vid="PSA 29:11">Lyawa a̱ A̱sulazuva a ca ama a̱ yi asuvu nden.<verse eid="PSA 29:11" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" sid="PSA 30" />
  <para style="d">Ica. Ishipa. Adama a matawa ma̱ A̱a̱'isamapaɗa<note caller="+" style="f"><char style="fr" closed="false">30:0 </char><char style="fq" closed="false">A̱a̱'isamapaɗa </char><char style="ft" closed="false">Ko ukobu.</char></note>. Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1" />A̱sulazuva, n ta ca wu tsugbain!</para>
  <para style="q2" vid="PSA 30:1">Adama a na vu wawa numu,</para>
  <para style="q1" vid="PSA 30:1">waru vu lyawa n'yuwatan n va̱</para>
  <para style="q2" vid="PSA 30:1">n lyuwa a aci a̱ va̱ shi.<verse eid="PSA 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2" />A̱sulazuva A̱sula̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 30:2">n showen wu ta̱ adama e ikambishi,</para>
  <para style="q2" vid="PSA 30:2">reve vu ka̱mba̱to mu gbaga.<verse eid="PSA 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3" />A̱sulazuva vu uta̱a̱ mu ta̱ diga a aason,</para>
  <para style="q2" vid="PSA 30:3">a̱vu vu wawa mu na ma̱a̱ 'ya̱wa̱ a aason.<verse eid="PSA 30:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4" />I cana ishipa a̱ tyo</para>
  <para style="q2" vid="PSA 30:4">uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q1" vid="PSA 30:4">a̱ɗu aza e icigi ya̱ yi,</para>
  <para style="q2" vid="PSA 30:4">i cuwa Aala a akiza a̱yi.<verse eid="PSA 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5" />Adama a na upan wa̱ yi</para>
  <para style="q2" vid="PSA 30:5">za mantsa wa'a ɗa,</para>
  <para style="q1" vid="PSA 30:5">amma isa'ani ya̱ yi</para>
  <para style="q2" vid="PSA 30:5">i ri nu ukosu shi.</para>
  <para style="q1" vid="PSA 30:5">Tsu ta gura shon ayin ma̱ɓula̱,</para>
  <para style="q2" vid="PSA 30:5">amma a̱vu tsu yuwan ma̱za̱nga̱ nu usana.<verse eid="PSA 30:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6" />A mantsa ma na n ri na asuvu nden,</para>
  <para style="q2" vid="PSA 30:6">n tsu damma ta̱,</para>
  <para style="q2" vid="PSA 30:6">&lt;&lt;Ili yi lo na ya̱ 'ya̱sa̱n mu ugbozu shi.&gt;&gt;<verse eid="PSA 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7" />A̱sulazuva adama e isa'ani ya̱ wu</para>
  <para style="q2" vid="PSA 30:7">vu shuwa̱ mu ta̱ tsa aatali a gbain.</para>
  <para style="q1" vid="PSA 30:7">Amma a mantsa ma na vu vadalaa numu ucina̱,</para>
  <para style="q2" vid="PSA 30:7">reve wovon u reme mu lon.<verse eid="PSA 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8" />A̱sulazuva n ta̱ mesun a̱ tyo ya̱'a̱ wu,</para>
  <para style="q2" vid="PSA 30:8">vee e ene iliyali i va̱.<verse eid="PSA 30:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9" />&lt;&lt;Uda̱shiyi u ne u ɗa a̱a̱ tsura̱ a̱tsuma̱ o ukwisa̱ u va̱?</para>
  <para style="q2" vid="PSA 30:9">Uda̱shiyi u ne u ɗa a̱a̱ tsura̱ a̱ ma̱ka̱ra̱a̱ ma̱ va̱ a̱ tyo a aason?</para>
  <para style="q1" vid="PSA 30:9">A̱kwa̱kwa̱ aa ta gura cuwa wu?</para>
  <para style="q2" vid="PSA 30:9">A ta gura ca adanshi a alabari a sa'ani a̱ wu?<verse eid="PSA 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10" />A̱sulazuva vu uwwa mu,</para>
  <para style="q2" vid="PSA 30:10">waru vee ene iliyali i va̱!</para>
  <para style="q2" vid="PSA 30:10">A̱sulazuva vu kamba mu.&gt;&gt;<verse eid="PSA 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11" />Vu vadala ta̱ a̱tsumola̱ngu a̱ va̱,</para>
  <para style="q2" vid="PSA 30:11">wo o'wo ma̱za̱nga̱,</para>
  <para style="q1" vid="PSA 30:11">a̱vu vu foɗo utugu wa̱ a̱tsumola̱ngu a̱ va̱,</para>
  <para style="q2" vid="PSA 30:11">vo oto mu utugu u ma̱za̱nga̱,<verse eid="PSA 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12" />adama asuvu a̱ va̱</para>
  <para style="q2" vid="PSA 30:12">a canaa wu ica,</para>
  <para style="q2" vid="PSA 30:12">a̱ rungwa̱ kpen wan.</para>
  <para style="q1" vid="PSA 30:12">A̱sulazuva A̱sula̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 30:12">n ta̱ godyowo wu hali hali.<verse eid="PSA 30:12" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" sid="PSA 31" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1" />A̱sulazuva ya̱'a̱ wu ɗa n tsura̱i,</para>
  <para style="q2" vid="PSA 31:1">uba̱ta̱ wu upa'atan wu ucira,</para>
  <para style="q1" vid="PSA 31:1">she vu lyawa mu,</para>
  <para style="q2" vid="PSA 31:1">mu uwwa wono wan.</para>
  <para style="q1" vid="PSA 31:1">Vu wawa mu</para>
  <para style="q2" vid="PSA 31:1">a̱tsuma̱ a̱ a̱ɓula̱ a̱ wu.<verse eid="PSA 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2" />Vu zuwaa mu atsuvu!</para>
  <para style="q2" vid="PSA 31:2">Jika̱ vu wawa mu!</para>
  <para style="q1" vid="PSA 31:2">Lyawa vo o'wo mu</para>
  <para style="q2" vid="PSA 31:2">aatali o upa'atan wu ucira,</para>
  <para style="q1" vid="PSA 31:2">ukari wu ucira</para>
  <para style="q2" vid="PSA 31:2">u na waa wawa mu.<verse eid="PSA 31:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3" />A̱vu ɗa upa'atan u va̱ na̱ mapari ma̱ va̱</para>
  <para style="q2" vid="PSA 31:3">vu ronoo mu aaɗanga cine vu yuwain nzuwulai.<verse eid="PSA 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4" />Vu wawa mu a̱tsuma̱ a maza</para>
  <para style="q2" vid="PSA 31:4">ma na azuwaa numu,</para>
  <para style="q1" vid="PSA 31:4">adama a na a̱vu ɗa</para>
  <para style="q2" vid="PSA 31:4">uba̱ta̱ wu upa'atan wu ucira u va̱.<verse eid="PSA 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5" />E ekere a̱ wu a ɗa</para>
  <para style="q2" vid="PSA 31:5">n zuwai wuma u va̱,<note caller="-" style="x"><char style="xo" closed="false">31:5 </char><char style="xt" closed="false"><ref loc="LUK 23:46">Luk 23:46</ref>; <ref loc="ACT 7:59">Ajy 7:59</ref>.</char></note></para>
  <para style="q2" vid="PSA 31:5">A̱sulazuva vu wawa mu,</para>
  <para style="q2" vid="PSA 31:5">A̱sula̱ a̱ a̱ɓula̱.<verse eid="PSA 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6" />N 'yuwan ta̱ aza a na</para>
  <para style="q2" vid="PSA 31:6">a zuwaa yi a̱ma̱li e pere ucira,</para>
  <para style="q1" vid="PSA 31:6">amma a̱mu n zuwa ta̱ ucira u va̱</para>
  <para style="q2" vid="PSA 31:6">uba̱ta̱ wa̱ A̱sulazuva.<verse eid="PSA 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7" />N ta yuwan mere na̱ ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 31:7">adama e icigi ya̱ wu i na u tsu vadala shi,</para>
  <para style="q1" vid="PSA 31:7">vee ene ta̱ atakaci a̱ va̱,</para>
  <para style="q2" vid="PSA 31:7">waru vu reve ta̱ nu usa̱n wo okolo a̱ va̱.<verse eid="PSA 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8" />Vu lyawa mu e ekere a n'yuwatan n va̱ shi,</para>
  <para style="q2" vid="PSA 31:8">reve vu zuwa mu uba̱ta̱ u na u ri na addama shi.<verse eid="PSA 31:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9" />A̱sulazuva vee ene iliyali i va̱,</para>
  <para style="q2" vid="PSA 31:9">adama a na n ta̱ pe a̱tsuma̱ a̱tsuma̱lima̱.</para>
  <para style="q1" vid="PSA 31:9">Esu a̱ va̱ a tsutsa ta̱ adama e mesun,</para>
  <para style="q2" vid="PSA 31:9">wuma u va̱ oɓolo na̱ lipu va̱ a̱ ta̱ka̱lyuwa̱ ta̱.<verse eid="PSA 31:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10" />A̱tsuma̱lima̱ a jiba ta̱ rana wuma va̱,</para>
  <para style="q2" vid="PSA 31:10">mesun waru ma jiba ta̱ a'wan a̱ va̱,</para>
  <para style="q1" vid="PSA 31:10">okolo a̱ va̱ a kuɗa ta̱ adama atakaci,</para>
  <para style="q2" vid="PSA 31:10">hali e etele a̱ va̱ a̱ kuwa̱.<verse eid="PSA 31:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11" />Mo o'wo ta̱ ili yi izo'oshi,</para>
  <para style="q2" vid="PSA 31:11">uba̱ta̱ wu n'yuwatan n va̱ suru,</para>
  <para style="q1" vid="PSA 31:11">ili i mo goro fo uba̱ta̱ wu nron mu nden n va̱,</para>
  <para style="q2" vid="PSA 31:11">aza a na e ene mu o ure biti a̱vu a uwa ilaɗi i va̱.<verse eid="PSA 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12" />E icina ta̱ na̱ a̱mu va damma n kuwa̱ ta̱.</para>
  <para style="q2" vid="PSA 31:12">Mo o'wo ta̱ va damma aakatayimba.<verse eid="PSA 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13" />Mu uwwa ta̱ adanshi e ke'en ke'en na̱ a̱bunda̱,</para>
  <para style="q2" vid="PSA 31:13">wovon u ka̱nda̱ruwa̱ mu ta̱ suru.</para>
  <para style="q1" vid="PSA 31:13">O ɓolo ta̱ a aci adama a̱ va̱,</para>
  <para style="q2" vid="PSA 31:13">a zamishi ure u na o una mu.<verse eid="PSA 31:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14" />Amma A̱sulazuva n zuwa ta̱ ucira u va̱ ya̱'a̱ wu,</para>
  <para style="q2" vid="PSA 31:14">waru n damma ta̱, &lt;&lt;A̱vu ɗa A̱sula̱ a va̱.&gt;&gt;<verse eid="PSA 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15" />Mantsa ma̱ va̱ ma̱ ta̱ e ekere a̱ wu</para>
  <para style="q2" vid="PSA 31:15">vu wawa mu e ekere a n'yuwatan n va̱,</para>
  <para style="q2" vid="PSA 31:15">oɓolo na aza a na a casu mu atakaci.<verse eid="PSA 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16" />Lyawa vee ene iliyali ya aagbashi a̱ wu,</para>
  <para style="q2" vid="PSA 31:16">vu wawa mu a̱tsuma̱ e icigi ya̱ wu i na i tsu vadala shi.<verse eid="PSA 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17" />A̱sulazuva she vu lyawa mu,</para>
  <para style="q2" vid="PSA 31:17">mu uwwa wono wan,</para>
  <para style="q2" vid="PSA 31:17">adama a na n showen wu ta̱.</para>
  <para style="q1" vid="PSA 31:17">Amma vu lyawa aza awuya a uwwa wono,</para>
  <para style="q2" vid="PSA 31:17">waru o von kpaku a̱tsuma̱ aason.<verse eid="PSA 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18" />Lyawa una̱ u le u kpa̱to,</para>
  <para style="q2" vid="PSA 31:18">adama a na nu uvaɗu</para>
  <para style="q2" vid="PSA 31:18">oɓolo nu ulamu u ɗa,</para>
  <para style="q1" vid="PSA 31:18">a tsu yuwan adanshi</para>
  <para style="q2" vid="PSA 31:18">a aci ama a̱ a̱ɓula̱.<verse eid="PSA 31:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19" />Te ɗa iroci ya̱ a̱bunda̱ e isa'ani ya̱ wu,</para>
  <para style="q2" vid="PSA 31:19">isa'ani i na vu foɓoyi aza a na a uwwusa wovon wa̱ wu.</para>
  <para style="q1" vid="PSA 31:19">Isa'ani i na vu rocoyi vaɗilima̱,</para>
  <para style="q2" vid="PSA 31:19">uba̱ta̱ wa aza a na</para>
  <para style="q2" vid="PSA 31:19">aa zama upa'atan ya̱'a̱ wu.<verse eid="PSA 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20" />Vu tsu soko le ta̱ uba̱ta̱ u na vu ri,</para>
  <para style="q2" vid="PSA 31:20">e ekere a ama a na a yuwusan maza.</para>
  <para style="q1" vid="PSA 31:20">Vu tsu zuwa le ta̱ gbaga uba̱ta̱ wu nden ma̱ wu,</para>
  <para style="q2" vid="PSA 31:20">adama a uwwa wisulusa wa ama wan.<verse eid="PSA 31:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21" />Aba'un za va̱ A̱sulazuva a ɗa!</para>
  <para style="q2" vid="PSA 31:21">Adama a na u roco mu ta̱</para>
  <para style="q2" vid="PSA 31:21">icigi ya̱ yi i na i tsu vadala shi,</para>
  <para style="q1" vid="PSA 31:21">a mantsa ma na a̱ ka̱nda̱ruwa̱ numu</para>
  <para style="q2" vid="PSA 31:21">a̱ riya̱a̱ numu nu uvon.<verse eid="PSA 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22" />A̱tsuma̱ o wovon u va̱ n tara ta̱,</para>
  <para style="q2" vid="PSA 31:22">&lt;&lt;U tawa mu ta̱ e esu a̱ yi!&gt;&gt;</para>
  <para style="q1" vid="PSA 31:22">Na̱ ne suru wu uwwa ta̱ ipati i va̱</para>
  <para style="q2" vid="PSA 31:22">e izami vee ene iliyali i va̱,</para>
  <para style="q2" vid="PSA 31:22">a mantsa ma na n ɗe nuwu</para>
  <para style="q2" vid="PSA 31:22">adama e ikambishi.<verse eid="PSA 31:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23" />I ciga A̱sulazuva,</para>
  <para style="q2" vid="PSA 31:23">suru nɗu aza a na a̱ ri e icigi ya̱ yi!</para>
  <para style="q1" vid="PSA 31:23">A̱sulazuva a̱ ta̱ ka̱lyuwusa̱</para>
  <para style="q2" vid="PSA 31:23">aza a na a̱ ri na̱ a̱ɓula̱,</para>
  <para style="q2" vid="PSA 31:23">waru u tsu tsupa ta̱ aza a aciyogbamu lon.<verse eid="PSA 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24" />I da̱na̱ nu ucira no okolo o ugbamu,</para>
  <para style="q2" vid="PSA 31:24">a̱ɗu na suru i zuwai okolo a̱ ɗu</para>
  <para style="q2" vid="PSA 31:24">uba̱ta̱ wa̱ A̱sulazuva.<verse eid="PSA 31:24" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" sid="PSA 32" />
  <para style="d">Ica ya̱ Da̱wuda. Ishipa yu uyo'o.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1" />Za ma̱za̱nga̱ a ɗa vuma na</para>
  <para style="q2" vid="PSA 32:1">a yuwayin gafura vu nusu va̱ yi,</para>
  <para style="q2" vid="PSA 32:1">za na a tawai nusu va̱ yi.<note caller="-" style="x"><char style="xo" closed="false">32:1 </char><char style="xt" closed="false"><ref loc="ROM 4:7-8">Rom 4:7-8</ref>. </char></note><verse eid="PSA 32:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2" />Za ma̱za̱nga̱ a ɗa vuma na</para>
  <para style="q2" vid="PSA 32:2">A̱sulazuva e kecei nusu va̱ yi shi,</para>
  <para style="q2" vid="PSA 32:2">waru u cina yi nu ulambu wa amayun shi.<verse eid="PSA 32:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3" />Mantsa ma na koto shi</para>
  <para style="q2" vid="PSA 32:3">n dammai nusu va̱ shi,</para>
  <para style="q1" vid="PSA 32:3">n kuna̱to ta̱ aciya̱va̱</para>
  <para style="q2" vid="PSA 32:3">na̱ a̱bunda̱ e mesun urana ma̱ɓula̱.<verse eid="PSA 32:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4" />Adama a na urana na ayin,</para>
  <para style="q2" vid="PSA 32:4">ukere wa̱ wu u ta̱ ume aciya̱va̱.</para>
  <para style="q1" vid="PSA 32:4">Ucira u va̱ u koto ta̱ babu usa̱n,</para>
  <para style="q2" vid="PSA 32:4">cine vu revei anlya o uta̱nu,</para>
  <para style="q2" vid="PSA 32:4">a tsu 'yewe ni irana.<verse eid="PSA 32:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5" />Ɗaɗa n damma nuwu nusu va̱,</para>
  <para style="q2" vid="PSA 32:5">waru n soko nusu va̱ shi.</para>
  <para style="q1" vid="PSA 32:5">N damma ta̱, &lt;&lt;N ta damma A̱sulazuva nusu va̱.&gt;&gt;</para>
  <para style="q2" vid="PSA 32:5">A̱vu gba vu yuwaan mu gafura vu nusu va̱.<verse eid="PSA 32:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6" />Adama o ndolo lyawa aza a na</para>
  <para style="q2" vid="PSA 32:6">a̱ ri no okolo a̱ɓula̱</para>
  <para style="q2" vid="PSA 32:6">a yuwan avasa a̱ tyo ya̱'a̱ wu,</para>
  <para style="q2" vid="PSA 32:6">a mantsa ma addama.</para>
  <para style="q1" vid="PSA 32:6">Ko na̱ shi a̱tsuma̱lima̱ a̱ 'yon</para>
  <para style="q2" vid="PSA 32:6">cine vu revei mini ma̱ gbain</para>
  <para style="q2" vid="PSA 32:6">ma na ma̱ ri a mmalu,</para>
  <para style="q2" vid="PSA 32:6">waa rawa uba̱ta̱ ule shi.<verse eid="PSA 32:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7" />A̱vu ɗa upa'atan u va̱,</para>
  <para style="q2" vid="PSA 32:7">vu ta wawa mu diga e meleshe.</para>
  <para style="q1" vid="PSA 32:7">N ta canasa ishipa nu ucira adama e iwawi ya̱ wu,</para>
  <para style="q2" vid="PSA 32:7">adama a na vu yuwaan mu ta̱ mapari.<verse eid="PSA 32:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8" />A̱vu A̱sulazuva a damma, &lt;&lt;N to rito wu,</para>
  <para style="q2" vid="PSA 32:8">waru n roco wu ure u na va̱a̱ kuru.</para>
  <para style="q1" vid="PSA 32:8">N ta cawu a̱sa̱la̱,</para>
  <para style="q2" vid="PSA 32:8">waru mi idana wu.<verse eid="PSA 32:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9" />She vo o'wo ulo tso do ko mololi mo do wan,</para>
  <para style="q2" vid="PSA 32:9">amma she no rono yi na̱ rumu na amunga,</para>
  <para style="q2" vid="PSA 32:9">nna̱ ne shi oo toni wu shi.&gt;&gt;<verse eid="PSA 32:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10" />A̱tsuma̱lima̱ a̱za̱ e iwuya,</para>
  <para style="q2" vid="PSA 32:10">a̱ ta̱ a̱bunda̱,</para>
  <para style="q1" vid="PSA 32:10">agba aza na a zuwai okolo e le uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 32:10">icigi ya̱ yi i na i tsu vadala shi</para>
  <para style="q2" vid="PSA 32:10">i tsu yuwaan le ta̱ mapari.<verse eid="PSA 32:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11" />I yuwan mere a̱ɗu a̱za̱ a̱ a̱ɓula̱ suru,</para>
  <para style="q2" vid="PSA 32:11">i yuwan ma̱za̱nga̱ adama e ili i na A̱sulazuva a yuwain,</para>
  <para style="q1" vid="PSA 32:11">a̱ɗu na ya yuwusan tsutoni na̱ yi suru,</para>
  <para style="q2" vid="PSA 32:11">i cana ishipa i ma̱za̱nga̱!<verse eid="PSA 32:11" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" sid="PSA 33" />
  <para style="s">Ishipa yi ica</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1" />I yuwan ishipa i ma̱za̱nga̱ a̱ɗu a̱za̱ a̱ɓula̱,</para>
  <para style="q2" vid="PSA 33:1">adama a na wuntsaa ta̱</para>
  <para style="q2" vid="PSA 33:1">aza amayun okolo a yuwaan yi ica.<verse eid="PSA 33:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2" />I yuwaan A̱sulazuva ica ni igaraya,</para>
  <para style="q2" vid="PSA 33:2">i wa'a yi ishipa yi ica,</para>
  <para style="q2" vid="PSA 33:2">na̱ kumburu va a'yin kupa.<verse eid="PSA 33:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3" />I canaa yi ishipa i sa'avu,</para>
  <para style="q2" vid="PSA 33:3">i yuwan tsuwe'e nu uguru,</para>
  <para style="q2" vid="PSA 33:3">reve i 'ya̱sa̱n uɗyo na̱ ma̱za̱nga̱.<verse eid="PSA 33:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4" />Adama a na adanshi a̱ A̱sulazuva</para>
  <para style="q2" vid="PSA 33:4">mejege ma ɗa na amayun,</para>
  <para style="q1" vid="PSA 33:4">waru u ta̱ na amayun</para>
  <para style="q2" vid="PSA 33:4">a̱tsuma̱ e ili i na waa yuwusan biti.<verse eid="PSA 33:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5" />A̱sulazuva a ciga ta̱ a̱ɓula̱</para>
  <para style="q2" vid="PSA 33:5">nu uge'etosu wa amayun,</para>
  <para style="q1" vid="PSA 33:5">uvaɗi u ta̱ tapu</para>
  <para style="q2" vid="PSA 33:5">ni icigi ya̱ yi i na i tsu vadala shi.<verse eid="PSA 33:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6" />E idanshi ya̱ yi i ɗa A̱sulazuva a yuwain zuva.</para>
  <para style="q1" vid="PSA 33:6">O udammu wa̱ yi u ɗa a yuwain</para>
  <para style="q2" vid="PSA 33:6">urana, woto oɓolo ni italyo'o ya zuva.<verse eid="PSA 33:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7" />U ɓoloto ta̱ mini ma mala suru uba̱tu ta̱,</para>
  <para style="q2" vid="PSA 33:7">reve u soko mini ma mala ma̱ a̱ru'un</para>
  <para style="q2" vid="PSA 33:7">cine vuma tsu soko ishina aasula e izuwa.<verse eid="PSA 33:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8" />Lyawa uvaɗi ma̱ɓula̱ wu uwwa</para>
  <para style="q2" vid="PSA 33:8">wovon wa̱ A̱sulazuva,</para>
  <para style="q1" vid="PSA 33:8">lyawa ama o uvaɗi ma̱ɓula̱</para>
  <para style="q2" vid="PSA 33:8">a ca yi tsugbain.<verse eid="PSA 33:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9" />Ana u yuwain adanshi,</para>
  <para style="q2" vid="PSA 33:9">reve uvaɗi wo o'wo,</para>
  <para style="q1" vid="PSA 33:9">u ca ta̱ udammu,</para>
  <para style="q2" vid="PSA 33:9">reve ili suru yo o'wo.<verse eid="PSA 33:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10" />A̱sulazuva a̱ tsu lungusa̱ ta̱ ifoɓi yi nɗa,</para>
  <para style="q2" vid="PSA 33:10">u tsu putsa ta̱ a ama a yuwan ifoɓi i le.<verse eid="PSA 33:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11" />Amma ifoɓi ya̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 33:11">a tsi isawan ta̱ hali hali,</para>
  <para style="q2" vid="PSA 33:11">na̱ majiyan mo okolo a̱ yi a mantsa suru.<verse eid="PSA 33:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12" />Za ma̱za̱nga̱ ɗa iɗa i na,</para>
  <para style="q2" vid="PSA 33:12">A̱sula̱ a ɗa A̱sulazuva e le,</para>
  <para style="q1" vid="PSA 33:12">ama a na u ɗangwai</para>
  <para style="q2" vid="PSA 33:12">o'wo ili ya agadu a̱yi.<verse eid="PSA 33:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13" />Diga zuva A̱sulazuva a̱ tsu ka̱lyuwa̱ ta̱,</para>
  <para style="q2" vid="PSA 33:13">a̱vu we ene vaɗilima̱ suru.<verse eid="PSA 33:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14" />Diga uba̱ta̱ wu nden ma̱ yi u tsu idana ta̱,</para>
  <para style="q2" vid="PSA 33:14">aza a na a̱ ri nden a̱tsuma̱ o uvaɗi suru.<verse eid="PSA 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15" />A̱yi ɗa u yuwain okolo ama suru,</para>
  <para style="q2" vid="PSA 33:15">u tsu reve ta̱ ili i na a yuwusan suru.<verse eid="PSA 33:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16" />Mogono ma̱ tsu tsura̱ ulyuwu wa a aci</para>
  <para style="q2" vid="PSA 33:16">adama a̱bunda̱ ali o uvon a̱ yi shi,</para>
  <para style="q1" vid="PSA 33:16">ko za na gurai uvon la'a</para>
  <para style="q2" vid="PSA 33:16">adama o ucira wa̱ yi shi.<verse eid="PSA 33:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17" />Mazuwa mo okolo o do vu uvon ili ye pere i ɗa,</para>
  <para style="q2" vid="PSA 33:17">na̱ a̱bunda̱ o ucira wa̱ yi suru,</para>
  <para style="q2" vid="PSA 33:17">waa gura wawa za shi.<verse eid="PSA 33:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18" />Amma esu a̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 33:18">a̱ ta̱ uba̱ta̱ wa aza a na</para>
  <para style="q2" vid="PSA 33:18">a uwwusa wovon wa̱ yi,</para>
  <para style="q1" vid="PSA 33:18">e ekere aza a na a zuwai okolo e le</para>
  <para style="q2" vid="PSA 33:18">uba̱ta̱ wi icigi ya̱ yi</para>
  <para style="q2" vid="PSA 33:18">i na i tsu vadala shi.<verse eid="PSA 33:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19" />U tsu wawa le ta̱ a̱tsuma̱ o ukwa̱,</para>
  <para style="q2" vid="PSA 33:19">waru u lyawa le wuma</para>
  <para style="q2" vid="PSA 33:19">a mantsa ma ambulu.<verse eid="PSA 33:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20" />Tsu zuwa ta̱ okolo a̱ tsu</para>
  <para style="q2" vid="PSA 33:20">e ekere a̱ A̱sulazuva,</para>
  <para style="q1" vid="PSA 33:20">a̱yi ɗa ikambi i tsu</para>
  <para style="q2" vid="PSA 33:20">waru a̱a̱ra̱ga̱ a̱ tsu.<verse eid="PSA 33:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21" />Okolo a̱ tsu a yuwan ta̱ ma̱za̱nga̱ na̱ yi,</para>
  <para style="q2" vid="PSA 33:21">adama a na tsu zuwa ta̱ okolo a̱ tsu</para>
  <para style="q2" vid="PSA 33:21">uba̱ta̱ wa aala akiza a̱yi.<verse eid="PSA 33:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22" />A̱sulazuva lyawa icigi ya̱ wu</para>
  <para style="q2" vid="PSA 33:22">i na i tsu vadala shi,</para>
  <para style="q2" vid="PSA 33:22">u da̱na̱ oɓolo na̱ a̱tsu,</para>
  <para style="q2" vid="PSA 33:22">na wo o'woi tsu zuwai okolo a̱ tsu ya̱'a̱ wu.<verse eid="PSA 33:22" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" sid="PSA 34" />
  <para style="d">Ica ya̱ Da̱wuda. A mantsa ma na u yuwain she damma u gara ta̱ elime a Abimele, za na zuwai u gba̱ra̱ niyi, a̱vu u ka̱ra̱.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1" />N ta cuwa A̱sulazuva mantsa suru,</para>
  <para style="q2" vid="PSA 34:1">ica ya̱ yi i ta̱ da̱na̱ o una̱ u va̱ mantsa biti.<verse eid="PSA 34:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2" />Wuma u va̱ u ta cuwa A̱sulazuva,</para>
  <para style="q2" vid="PSA 34:2">lyawa aza a na a̱ ri nu ucira shi,</para>
  <para style="q2" vid="PSA 34:2">a uwwa a yuwan ma̱za̱nga̱.<verse eid="PSA 34:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3" />I ca A̱sulazuva tsugbain oɓolo na̱ a̱mu,</para>
  <para style="q2" vid="PSA 34:3">lyawai tsu cayi aala a̱yi tsugbain oɓolo!<verse eid="PSA 34:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4" />M pati ta̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 34:4">reve u usu mu,</para>
  <para style="q1" vid="PSA 34:4">reve wu uta̱a̱ mu</para>
  <para style="q2" vid="PSA 34:4">a̱tsuma̱ o wovon u va̱ suru.<verse eid="PSA 34:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5" />Za na aa zuwusa esu ya̱'a̱ yi,</para>
  <para style="q2" vid="PSA 34:5">urewesu wa̱ yi wa̱ da̱na̱ ulukutu shi</para>
  <para style="q2" vid="PSA 34:5">adama a̱ ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 34:5">waru wono wa̱ uɓa̱ru yi shi.<verse eid="PSA 34:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6" />Za vu ulambu ɗe ta̱,</para>
  <para style="q2" vid="PSA 34:6">a̱vu A̱sulazuva a̱ usu yi,</para>
  <para style="q1" vid="PSA 34:6">reve u wawa yi</para>
  <para style="q2" vid="PSA 34:6">a̱tsuma̱ addama a̱ yi suru.<verse eid="PSA 34:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7" />Malingata ma̱ A̱sula̱ ma̱ ta̱ e ipiri</para>
  <para style="q2" vid="PSA 34:7">ma aza a na a uwwusa wovon wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 34:7">reve u wawa le diga meleshe suru.<verse eid="PSA 34:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8" />I peɗe yee ene na aciya̱ɗu A̱sulazuva a̱ tu ulobonu,<note caller="-" style="x"><char style="xo" closed="false">34:8 </char><char style="xt" closed="false"><ref loc="1PE 2:3">1 Bit 2:3</ref>.</char></note></para>
  <para style="q2" vid="PSA 34:8">za ma̱za̱nga̱ ɗa,</para>
  <para style="q2" vid="PSA 34:8">za na tsura̱i upa'atan uba̱ta̱ wa̱ yi.<verse eid="PSA 34:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9" />Yu uwwa wovon wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 34:9">a̱ɗu ama a akiza a̱ yi,</para>
  <para style="q1" vid="PSA 34:9">adama a na aza a na a uwwusa</para>
  <para style="q2" vid="PSA 34:9">wovon wa̱ yi a tsu lamba ili shi.<verse eid="PSA 34:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10" />Ko ikamu i tsu lamba ta̱ ilyalya</para>
  <para style="q2" vid="PSA 34:10">reve a uwwa ambulu,</para>
  <para style="q1" vid="PSA 34:10">amma aza a na aa zamishi A̱sulazuva,</para>
  <para style="q2" vid="PSA 34:10">a tsu lamba ili isa'ani shi.<verse eid="PSA 34:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11" />Ta̱wa̱i muwun n va̱,</para>
  <para style="q2" vid="PSA 34:11">i poloo mu atsuvu,</para>
  <para style="q1" vid="PSA 34:11">n to roco ɗu</para>
  <para style="q2" vid="PSA 34:11">cine ya uwwa wovon wa̱ A̱sulazuva.<verse eid="PSA 34:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12" />Zane ɗa cigai wu uwwa uyo'o u wuma?<note caller="-" style="x"><char style="xo" closed="false">34:12 </char><char style="xt" closed="false"><ref loc="1PE 3:10-12">1 Bit 3:10-12</ref>.</char></note></para>
  <para style="q2" vid="PSA 34:12">Zane ɗa cigai we ene rana sa'ani va̱ a̱bunda̱?<verse eid="PSA 34:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13" />To, she u guza̱ una̱ wa̱ yi</para>
  <para style="q2" vid="PSA 34:13">a adanshi e iwuya</para>
  <para style="q2" vid="PSA 34:13">na adanshi e epen.<verse eid="PSA 34:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14" />U lyawa iwuya u yuwan isa'ani,</para>
  <para style="q2" vid="PSA 34:14">u zami asuvu nden no okolo a̱yi suru.<verse eid="PSA 34:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15" />Esu a̱ A̱sulazuva a̱ ta̱ a aci a̱za̱ a̱ a̱ɓula̱,</para>
  <para style="q2" vid="PSA 34:15">atsuvu a̱yi waru a ta uwwusa mesun me le.<verse eid="PSA 34:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16" />Urewesu wa̱ a̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 34:16">u ta a aci aza a na a yuwusan iwuya,</para>
  <para style="q1" vid="PSA 34:16">adama a tawa,</para>
  <para style="q2" vid="PSA 34:16">aɗa e le a̱tsuma̱ o uvaɗi.<verse eid="PSA 34:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17" />A̱za̱ a̱ a̱ɓula̱ a̱ tsu shon ta̱,</para>
  <para style="q2" vid="PSA 34:17">a̱vu A̱sulazuva a uwwa le,</para>
  <para style="q1" vid="PSA 34:17">u tsu wawa le ta̱ a̱tsuma̱ a addama le suru.<verse eid="PSA 34:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18" />A̱sulazuva a̱ ta̱ zuzu,</para>
  <para style="q2" vid="PSA 34:18">na aza na a kuɗai okolo ele,</para>
  <para style="q2" vid="PSA 34:18">u tsu kamba ta̱ aza a na o uta̱yi okolo.<verse eid="PSA 34:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19" />A̱tsuma̱lima̱ a za va̱ a̱ɓula̱ a̱ ta̱ a̱bunda̱,</para>
  <para style="q2" vid="PSA 34:19">agba A̱sulazuva a tsu wawa yi ta̱,</para>
  <para style="q2" vid="PSA 34:19">a̱tsuma̱ ele suru.<verse eid="PSA 34:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20" />U tsu ka̱lyuwusa̱ le ta̱ suru,</para>
  <para style="q2" vid="PSA 34:20">babu eetele a̱ ta̱ a na aa kuɗa.<verse eid="PSA 34:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21" />Iwuya i ta̱ o una za vi iwuya,</para>
  <para style="q2" vid="PSA 34:21">waru a̱ ta̱ ge'eto aza a na a 'yuwain a̱za̱ a̱ a̱ɓula̱.<verse eid="PSA 34:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22" />A̱sulazuva a tsu wawa ta̱ agbashi a̱yi,</para>
  <para style="q2" vid="PSA 34:22">aza a na a zamiyi upa'atan uba̱ta̱ wa̱ yi,</para>
  <para style="q2" vid="PSA 34:22">a̱ da̱na̱ nu unusu shi.<verse eid="PSA 34:22" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" sid="PSA 35" />
  <para style="d">Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 35:1">vu yuwan nla̱ngi na aza a na a yuwusan nla̱ngi na̱ a̱mu,</para>
  <para style="q2" vid="PSA 35:1">vu yuwan uvon na aza a na a yuwusan uvon na̱ a̱mu.<verse eid="PSA 35:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2" />Vu tara a̱a̱ra̱ga̱ ni itana yu uvon ya̱ wu,</para>
  <para style="q2" vid="PSA 35:2">vu ta̱wa̱ vu kamba mu!<verse eid="PSA 35:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3" />'Ya̱sa̱n ibata ya̱ wu na̱ aɓau a̱ wu zuva,</para>
  <para style="q2" vid="PSA 35:3">vu geshe aza a na oo tono mu.</para>
  <para style="q1" vid="PSA 35:3">Lyawa mu uwwa wu a dansaa mu,</para>
  <para style="q2" vid="PSA 35:3">&lt;&lt;A̱mu ɗa iwawi ya̱ wu.&gt;&gt;<verse eid="PSA 35:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4" />Lyawa aza a na a zama wuma u va̱,</para>
  <para style="q2" vid="PSA 35:4">a uwwa wono waru a ca le wono.</para>
  <para style="q1" vid="PSA 35:4">Lyawa aza a na o foɓusoo mu iwuya,</para>
  <para style="q2" vid="PSA 35:4">a̱ ka̱mba̱ a̱ca̱pa̱ a̱vu a̱ ra̱pula̱!<verse eid="PSA 35:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5" />Lyawa le o'wo cine owopo a na upepu u tsu pura̱,</para>
  <para style="q2" vid="PSA 35:5">a mantsa ma na malingata ma̱ A̱sulazuva mo losuso le a̱ a̱ka̱ra̱.<verse eid="PSA 35:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6" />Lyawa vu zuwa ure u le wo o'wo irumbu,</para>
  <para style="q2" vid="PSA 35:6">wo o'wo ederi,</para>
  <para style="q2" vid="PSA 35:6">a mantsa ma na malingata ma̱ A̱sulazuva ma̱ ri a gbagbusa le.<verse eid="PSA 35:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7" />Babu ili i ro ɗaɗa azuwaa numu maza,</para>
  <para style="q2" vid="PSA 35:7">waru babu ili i ro ɗaɗa a̱ ka̱pa̱ numu a̱a̱ka̱ri,</para>
  <para style="q2" vid="PSA 35:7">adama a̱ tsura̱ wuma u va̱.<verse eid="PSA 35:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8" />Lyawa ukototosu u riya̱a̱ le babu urevu,</para>
  <para style="q2" vid="PSA 35:8">lyawa maza ma na azuyi u reme le,</para>
  <para style="q2" vid="PSA 35:8">lyawa a̱ riya̱ a̱tsuma̱ a̱a̱ka̱ri a na a̱ ka̱pa̱i a̱vu u kototo le.<verse eid="PSA 35:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9" />Wuma u va̱ u ta yuwan ma̱za̱nga̱ a̱ tyo uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 35:9">n ta yuwan mere a na u wawa numu.<verse eid="PSA 35:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10" />Wuma u va̱ suru u ta damma A̱sulazuva,</para>
  <para style="q2" vid="PSA 35:10">&lt;&lt;Zane ɗa ri tsa̱ wu!</para>
  <para style="q1" vid="PSA 35:10">Vu wawa ta̱ alambi,</para>
  <para style="q2" vid="PSA 35:10">e ekere aza a na a la'a nle ucira,</para>
  <para style="q1" vid="PSA 35:10">alambi na aza a na a cigai ikambi,</para>
  <para style="q2" vid="PSA 35:10">e ekere aza a na a yuwusaan le ikpa'a.&gt;&gt;<verse eid="PSA 35:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11" />Aza a na a yuwusan adanshi e epen a̱ 'ya̱sa̱a̱n mu ta̱,</para>
  <para style="q2" vid="PSA 35:11">e ece mu ta̱,</para>
  <para style="q2" vid="PSA 35:11">e ili i na n revei adama a̱ yi shi.<verse eid="PSA 35:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12" />A tsupaa mu ta̱ ni iwuya</para>
  <para style="q2" vid="PSA 35:12">o una̱ wi isa'ani i na n yuwaan nle,</para>
  <para style="q2" vid="PSA 35:12">mo o'wo ta̱ ubanakun adama o wovon.<verse eid="PSA 35:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13" />A̱mu gba mantsa ma na a̱ ri ubanakun,</para>
  <para style="q2" vid="PSA 35:13">n tsu oto ta̱ itana ya̱ a̱tsumola̱ngu,</para>
  <para style="q1" vid="PSA 35:13">n tsu ca ta̱ aciya̱va̱ a̱tsuma̱lima̱ na akuli.</para>
  <para style="q2" vid="PSA 35:13">N yuwan ta̱ avasa aaci a̱ va̱ uka̱ɗa̱towu.<verse eid="PSA 35:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 35:14" />N tsu uta̱ ta̱ a yuwusan a̱tsumola̱ngu,</para>
  <para style="q2" vid="PSA 35:14">ngashi n lamba ta̱ i'utsa̱ i va̱ ko vuma va̱.</para>
  <para style="q1" vid="PSA 35:14">N tsu ka̱ɗa̱to ta̱ aaci a̱ va̱ a̱ tyo e iɗa a̱ a̱tsuma̱lima̱,</para>
  <para style="q2" vid="PSA 35:14">e mesun ngashi za na lambai mma va̱ yi.<verse eid="PSA 35:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15" />Amma ana n ta̱ɗa̱tsa̱i,</para>
  <para style="q2" vid="PSA 35:15">reve o ɓoloto a uwa ma̱za̱nga̱,</para>
  <para style="q1" vid="PSA 35:15">n'yuwatan n va̱ o ɓoloto ta̱ adama a̱ va̱ babu a̱mu urevu,</para>
  <para style="q2" vid="PSA 35:15">a̱vu a yuwusan izo'oshi yu ulamu babu lyawa.<verse eid="PSA 35:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16" />Ngashi aza a na a uwwusa wovon wa̱ A̱sula̱ shi,</para>
  <para style="q2" vid="PSA 35:16">ɗaɗa a yuwusaan numu ulamu,</para>
  <para style="q1" vid="PSA 35:16">adama e ima̱ i va̱,</para>
  <para style="q2" vid="PSA 35:16">a̱vu a̱ ka̱ra̱ a magaga ma anga e le.<verse eid="PSA 35:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 35:17">hali mantsa ma ne ma ɗa va̱a̱ da̱na̱ a̱ka̱nla̱ ele?</para>
  <para style="q1" vid="PSA 35:17">Vu wawa mu e ekere ele,</para>
  <para style="q2" vid="PSA 35:17">vu wawa wuma u va̱ e ekere e ikamu i nda!<verse eid="PSA 35:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18" />N to roco ma̱za̱nga̱ a̱ ma̱ka̱ka̱n mo oɓolo a ama a̱bunda̱,</para>
  <para style="q2" vid="PSA 35:18">a̱ ma̱ka̱ka̱n ma ama a̱bunda̱ a ɗa ma cuwa wu.<verse eid="PSA 35:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19" />She vu lyawa aza a na a 'yuwan numu a̱za̱ e epen,</para>
  <para style="q2" vid="PSA 35:19">a yuwan ma̱za̱nga̱ a aci a̱ va̱ wan,</para>
  <para style="q1" vid="PSA 35:19">she vu lyawa aza a na a 'yuwan numu agba n yuwaan le ili i ro shi,</para>
  <para style="q2" vid="PSA 35:19">a yuwan ma̱za̱nga̱ adama a̱ a̱tsuma̱lima̱ a̱ va̱ wan.<verse eid="PSA 35:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20" />A tsu yuwan adanshi asuvu nden shi,</para>
  <para style="q2" vid="PSA 35:20">o una̱ u ndolo a tsu yuwusan ta̱ adanshi e epen,</para>
  <para style="q2" vid="PSA 35:20">a aci aza a na a cigai nden ma alafiya.<verse eid="PSA 35:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21" />A̱vu a̱ kpa̱tu'wa̱ na̱ le a aci a̱ va̱ a dansa,</para>
  <para style="q2" vid="PSA 35:21">&lt;&lt;Ee! Ee!</para>
  <para style="q2" vid="PSA 35:21">Tse ene wu ta̱ ne esu a̱ tsu!&gt;&gt;<verse eid="PSA 35:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22" />A̱sulazuva vee ene ta̱,</para>
  <para style="q2" vid="PSA 35:22">she vu rungwa̱ wan!</para>
  <para style="q2" vid="PSA 35:22">A̱sulazuva she vu yuwan alanga na̱ a̱mu wan.<verse eid="PSA 35:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23" />'Yon, vu kamba mu!</para>
  <para style="q2" vid="PSA 35:23">A̱sula̱, A̱sulazuva a̱ va̱</para>
  <para style="q2" vid="PSA 35:23">vu usaa mu ili i na i ri za va̱!<verse eid="PSA 35:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24" />A̱sulazuva A̱sula̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 35:24">roco le ulambu wu unusu u va̱ a̱tsuma̱ a̱ a̱ɓula̱ a̱ wu,</para>
  <para style="q2" vid="PSA 35:24">she vu lyawa le a yuwan ma̱za̱nga̱ a aci a̱ va̱ wan.<verse eid="PSA 35:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25" />She vu lyawa le a jiyan o okolo adansa,</para>
  <para style="q2" vid="PSA 35:25">&lt;&lt;Ee! Tsundolo tsa ɗaɗa tsu cigai!&gt;&gt;</para>
  <para style="q1" vid="PSA 35:25">Ko a na va lyawa le adamma,</para>
  <para style="q2" vid="PSA 35:25">&lt;&lt;Tsu kototo yi ta̱.&gt;&gt;<verse eid="PSA 35:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26" />Lyawa aza a na a yuwusan ma̱za̱nga̱ adama a̱tsuma̱lima̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 35:26">a uwwa wono reve a lamba ugbozu u le suru suru.</para>
  <para style="q1" vid="PSA 35:26">Lyawa aza a na a̱ 'ya̱sa̱sa̱n aci adansa a la'a mu ta̱,</para>
  <para style="q2" vid="PSA 35:26">a ca le wono, o'wo ili yi izo'oshi.<verse eid="PSA 35:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27" />Amma vu ca ma̱za̱nga̱ ma̱ a̱bunda̱,</para>
  <para style="q2" vid="PSA 35:27">a̱ tyo uba̱ta̱ wa aza a na e isawaan numu.</para>
  <para style="q1" vid="PSA 35:27">Lyawa le adansa kuci, &lt;&lt;A̱sulazuva zagbain ɗa,</para>
  <para style="q2" vid="PSA 35:27">adama a na u ta uwwusa uyo'o,</para>
  <para style="q2" vid="PSA 35:27">u kamba aagbashi a̱yi!&gt;&gt;<verse eid="PSA 35:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28" />Eelentsu a̱ va̱ a ta yuwan adanshi a̱ a̱ɓula̱ a̱ wu,</para>
  <para style="q2" vid="PSA 35:28">waru u yuwaan wu ica urana ma̱ɓula̱.<verse eid="PSA 35:28" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" sid="PSA 36" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Wa̱ Da̱wuda aagbashi A̱sulazuva.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1" />Unusu u tsu yuwan ta̱ adanshi,</para>
  <para style="q2" vid="PSA 36:1">na̱ a̱za̱ e iwuya pe a̱tsuma̱ o okolo,</para>
  <para style="q1" vid="PSA 36:1">a̱ ri na̱ wovon wa̱ A̱sula̱ shi,</para>
  <para style="q2" vid="PSA 36:1">ko ke'en e esu e le.<verse eid="PSA 36:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2" />A̱ luma̱ ta̱ aciyele a dansa,</para>
  <para style="q2" vid="PSA 36:2">ili yu usokowu i le wa̱ u ta̱ alanga shi,</para>
  <para style="q2" vid="PSA 36:2">a na a ca le unusu shi.<verse eid="PSA 36:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3" />Idanshi yu una̱ u le iwuya i ɗa</para>
  <para style="q2" vid="PSA 36:3">oɓolo na̱ wulumu,</para>
  <para style="q1" vid="PSA 36:3">a vadalaa ta̱ ugbozu ucina̱,</para>
  <para style="q2" vid="PSA 36:3">a̱vu a lyawa mayan me ili i sa'ani.<verse eid="PSA 36:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4" />A̱ a̱ga̱da̱ nven nle,</para>
  <para style="q2" vid="PSA 36:4">a̱ ta̱ foɓuso iwuya,</para>
  <para style="q1" vid="PSA 36:4">a ca ta̱ aciyele a yuwusan unusu,</para>
  <para style="q2" vid="PSA 36:4">waru a tsu 'yuwan iwuya shi.<verse eid="PSA 36:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 36:5">icigi ya̱ wu i na i tsu vadala shi,</para>
  <para style="q2" vid="PSA 36:5">u rawa ta̱ zuva,</para>
  <para style="q1" vid="PSA 36:5">amayun a̱ wu waru</para>
  <para style="q2" vid="PSA 36:5">a rawa ta̱ e eleshe.<verse eid="PSA 36:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 36:6">a̱ɓula̱ a̱ wu a̱ ta̱ tsu,</para>
  <para style="q2" vid="PSA 36:6">nsasan m gbagbain,</para>
  <para style="q1" vid="PSA 36:6">uge'etosu wa̱ wu waru,</para>
  <para style="q2" vid="PSA 36:6">tsa̱ mala ma̱ a̱ru'un.</para>
  <para style="q2" vid="PSA 36:6">A̱vu ɗa va̱a̱ ka̱lyuwusa̱ ama ni inama.<verse eid="PSA 36:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7" />A̱sula̱,</para>
  <para style="q2" vid="PSA 36:7">te ɗa iroci i tsugbain tsa̱ e icigi ya̱ wu za na tsu vadala shi!</para>
  <para style="q1" vid="PSA 36:7">Vaɗilima̱ tsu tsura̱ ta̱ uba̱ta̱ u na waa pa'an,</para>
  <para style="q2" vid="PSA 36:7">za̱la̱ vu ululu wa̱ evelu a̱ wu.<verse eid="PSA 36:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8" />A tsu yuwan ta̱ a̱buki ni ilyalya ya̱ a̱bunda̱ yu u'wa ya̱ wu,</para>
  <para style="q2" vid="PSA 36:8">vu tsu ca le ta̱ ili yo oso,</para>
  <para style="q2" vid="PSA 36:8">o uɗolu wi isa'ani ya̱ wu.<verse eid="PSA 36:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9" />A̱vu ɗa esu a̱ mini a na a casu wuma,</para>
  <para style="q2" vid="PSA 36:9">a̱tsuma̱ e ekan ya̱ wu i ɗa tse eneshe ekan.<verse eid="PSA 36:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10" />Lyuwa elime ni icigi ya̱ wu,</para>
  <para style="q2" vid="PSA 36:10">a̱ tyo e ekere aza a na e reve nuwu,</para>
  <para style="q1" vid="PSA 36:10">na̱ a̱ɓula̱ a̱ wu waru,</para>
  <para style="q2" vid="PSA 36:10">a̱ tyo e ekere aza a amayun o okolo ele.<verse eid="PSA 36:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11" />She vu lyawa ana aza aciyogbamu a dasa mu wan,</para>
  <para style="q2" vid="PSA 36:11">ko ekere a̱za̱ e iwuya a̱ gba̱ra̱ mu wan.<verse eid="PSA 36:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12" />Ka̱lyuwa̱ cine a̱za̱ e iwuya a̱ riya̱i,</para>
  <para style="q2" vid="PSA 36:12">a tsugba le ta̱, agba a gura 'yon shi.<verse eid="PSA 36:12" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" sid="PSA 37" />
  <para style="d">Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1" />She vu yuwan a̱tsumola̱ngu adama aza a na a yuwusan iwuya wan,</para>
  <para style="q2" vid="PSA 37:1">ko vu yuwan tsushu'un,</para>
  <para style="q2" vid="PSA 37:1">adama aza a na a yuwusan ili i babu ulobonu.<verse eid="PSA 37:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2" />A̱ ta̱ 'yewe cine vu revei anlya babu usa̱n,</para>
  <para style="q2" vid="PSA 37:2">a ta kpanla babu usa̱n cine vu revei ototopi.<verse eid="PSA 37:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3" />Vu zuwa okolo a̱ wu uba̱ta̱ wa̱ A̱sulazuva vu yuwan isa'ani.</para>
  <para style="q2" vid="PSA 37:3">Vu da̱nu a̱tsuma̱ e iɗa'a,</para>
  <para style="q2" vid="PSA 37:3">vu tsura̱ asuvu nden.<verse eid="PSA 37:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4" />Vu zami ma̱za̱nga̱ ma̱ wu e ekere a̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 37:4">u to shitowon wu majiyan mo okolo ma̱ wu.<verse eid="PSA 37:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5" />Vu lyawaa A̱sulazuva re wuma va̱ wu,</para>
  <para style="q2" vid="PSA 37:5">vu zuwaa yi ucira, u ta̱ ka̱lyuwa̱ wu.<verse eid="PSA 37:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6" />U ta zuwa a̱ɓula̱ a̱ wu e ikana,</para>
  <para style="q2" vid="PSA 37:6">uge'etosu wa amayun a̱ wu u te ikana,</para>
  <para style="q2" vid="PSA 37:6">tse ekan yu urana a aci.<verse eid="PSA 37:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7" />Vi isawan kpen a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 37:7">vu kaɓa asuvu vu zuwa okolo a̱ wu ya̱'a̱ yi,</para>
  <para style="q1" vid="PSA 37:7">she vu yuwan a̱tsumola̱ngu nu ulyuwu we elime wu za ro wan,</para>
  <para style="q2" vid="PSA 37:7">ko za na a lyuwusa elime,</para>
  <para style="q2" vid="PSA 37:7">a̱tsuma̱ e ifoɓi yi iwuya ya̱ yi.<verse eid="PSA 37:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8" />She vu lyawa asuvu a̱ wu a̱ 'yon wan,</para>
  <para style="q2" vid="PSA 37:8">ko vu yuwan upan wan,</para>
  <para style="q1" vid="PSA 37:8">she wovon u reme wu wan,</para>
  <para style="q2" vid="PSA 37:8">cu'un ndolo tsu ta̱wa̱ ni ili shi, she iwuya.<verse eid="PSA 37:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9" />Adama a na o to kototo,</para>
  <para style="q2" vid="PSA 37:9">a̱za̱ e iwuya,</para>
  <para style="q1" vid="PSA 37:9">amma aza a na a zuwusa okolo e le uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 37:9">iɗa'a u to o'wo agadu ele.<verse eid="PSA 37:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10" />Mantsa wa'a a̱za̱ e iwuya a̱ ta̱ puwa̱n,</para>
  <para style="q2" vid="PSA 37:10">ko na̱ vu ka̱lyuwa̱ uba̱ta̱ u na a̱ da̱na̱i,</para>
  <para style="q2" vid="PSA 37:10">vee ene le waru shi.<verse eid="PSA 37:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11" />Amma aza a na a tarai aciyele ili i ro shi,</para>
  <para style="q2" vid="PSA 37:11">iɗa'a u to o'wo agadu e le.</para>
  <para style="q2" vid="PSA 37:11">Reve a uwwa uyo'o wa a asuvu nden lon.<verse eid="PSA 37:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12" />Za vi iwuya tsu yuwaan ta̱</para>
  <para style="q2" vid="PSA 37:12">vuma va̱ a̱ɓula̱ ifoɓi iwuya.</para>
  <para style="q1" vid="PSA 37:12">U tsu gutanasa yi ta̱</para>
  <para style="q2" vid="PSA 37:12">adama a̱ tsushu'un.<verse eid="PSA 37:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13" />Amma A̱sulazuva a̱ tsu zo'oso ta̱</para>
  <para style="q2" vid="PSA 37:13">za vi iwuya,</para>
  <para style="q1" vid="PSA 37:13">adama a na u reve ta̱ urana,</para>
  <para style="q2" vid="PSA 37:13">wu kototosu wa̱ yi u ta̱ lo a̱ ta̱wa̱.<verse eid="PSA 37:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14" />A̱za̱ e iwuya a tsu tala ta̱ mutsun mu pe'eni,</para>
  <para style="q2" vid="PSA 37:14">reve o rono tan le,</para>
  <para style="q1" vid="PSA 37:14">tsa̱ra̱ o una alambi na aza a na a cigai ikambishi,</para>
  <para style="q2" vid="PSA 37:14">tsa̱ra̱ o una a̱za̱ a̱ɓula̱.<verse eid="PSA 37:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15" />Amma mutsun mu pe'eni nle n ta̱ o una le,</para>
  <para style="q2" vid="PSA 37:15">waru a kuɗa tan le.<verse eid="PSA 37:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16" />Ke'en na za va̱ a̱ɓula̱ ri na̱ a̱ yi,</para>
  <para style="q2" vid="PSA 37:16">u la'a ta̱ a̱bunda̱ a na za vi iwuya ri na̱ a̱ yi.<verse eid="PSA 37:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17" />Adama a na A̱sulazuva a ta kuɗa ucira wu za vi iwuya,</para>
  <para style="q2" vid="PSA 37:17">amma u ta yuwaan za va̱ a̱ɓula̱ mapari.<verse eid="PSA 37:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18" />A̱sulazuva a̱ ta̱ ka̱lyuwusa̱ aza a na aa yuwusan yi tsutoni,</para>
  <para style="q2" vid="PSA 37:18">iɗa'a u to o'wo za le hali hali.<verse eid="PSA 37:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19" />A uwwa wono,</para>
  <para style="q2" vid="PSA 37:19">a mantsa ma̱ meleshe shi,</para>
  <para style="q1" vid="PSA 37:19">a rana va ambulu,</para>
  <para style="q2" vid="PSA 37:19">a̱ ta̱ da̱na̱ ni ilyalya ya̱ a̱bunda̱.<verse eid="PSA 37:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20" />Amma a̱za̱ e iwuya a̱ ta̱ puwa̱n,</para>
  <para style="q2" vid="PSA 37:20">aza a na a 'yuwain A̱sulazuva,</para>
  <para style="q2" vid="PSA 37:20">a̱ ta̱ puwa̱n cine vu revei yipa̱lu yu una,</para>
  <para style="q1" vid="PSA 37:20">a̱ ta̱ puwa̱n tsa mikyon.<verse eid="PSA 37:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21" />Za vi iwuya,</para>
  <para style="q2" vid="PSA 37:21">u tsu lyuwa ta̱ utan agba wa tsupa shi,</para>
  <para style="q1" vid="PSA 37:21">amma za̱ va a̱ɓula̱,</para>
  <para style="q2" vid="PSA 37:21">u tsu ca ta̱ ne'e no okolo a̱ ta̱.<verse eid="PSA 37:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22" />Aza a na A̱sulazuva a zuwaa yi aba'un,</para>
  <para style="q2" vid="PSA 37:22">iɗa'a i to o'wo agadu e le,</para>
  <para style="q1" vid="PSA 37:22">amma aza a na u yuwayin una̱,</para>
  <para style="q2" vid="PSA 37:22">a̱ ta̱ gba̱ra̱ le.<verse eid="PSA 37:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23" />Na̱ A̱sulazuva a uwwusa uyo'o,</para>
  <para style="q2" vid="PSA 37:23">u wuma u vuma,</para>
  <para style="q2" vid="PSA 37:23">u tsu ka̱lyuwusa̱ ta̱ mmalu ma̱ yi na amayun.<verse eid="PSA 37:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24" />Ko na̱ u shi u ta̱ɗa̱tsa̱, wa̱a̱ riya̱ shi,</para>
  <para style="q2" vid="PSA 37:24">adama a na A̱sulazuva a ɗa a̱ guza̱i ukere wa̱ yi.<verse eid="PSA 37:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25" />N da̱na̱ ta̱ mawun</para>
  <para style="q2" vid="PSA 37:25">agba gogo n kutsa ta̱,</para>
  <para style="q1" vid="PSA 37:25">suru na̱ ne koto me ene</para>
  <para style="q2" vid="PSA 37:25">a vari a̱za̱ a̱ɓula̱ shi,</para>
  <para style="q1" vid="PSA 37:25">ko muwun nle</para>
  <para style="q2" vid="PSA 37:25">a pati ilyalya shi.<verse eid="PSA 37:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26" />A̱za̱ a̱ɓula̱ e tse ene ta̱ iliyali mantsa suru,</para>
  <para style="q2" vid="PSA 37:26">a̱ tsu ca ta̱ okopu no okolo a̱ ta̱,</para>
  <para style="q2" vid="PSA 37:26">waru a ta zuwaa muwun nle aba'un.<verse eid="PSA 37:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27" />Vu lyawa iwuya vu yuwan isa'ani,</para>
  <para style="q2" vid="PSA 37:27">ne ɗa va̱a̱ da̱nu e iɗa'a hali hali.<verse eid="PSA 37:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28" />Adama a na A̱sulazuva,</para>
  <para style="q2" vid="PSA 37:28">a ciga ta̱ ili i na i ri mejege,</para>
  <para style="q2" vid="PSA 37:28">u tsu vari a̱za̱ a̱ɓula̱ a̱ yi shi.</para>
  <para style="q1" vid="PSA 37:28">U ta̱ ka̱lyuwa̱ a̱za̱ a̱ɓula̱ hali hali,</para>
  <para style="q2" vid="PSA 37:28">amma u ta̱ kototo muwun ma̱ a̱za̱ e iwuya.<verse eid="PSA 37:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29" />A̱za̱ a̱ a̱ɓula̱ a ta tara agadu e iɗa'a</para>
  <para style="q2" vid="PSA 37:29">waru a̱ da̱nu pe hali hali.<verse eid="PSA 37:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30" />Za va̱ a̱ɓula̱ tsu yuwan ta̱ adanshi nu ugbozu</para>
  <para style="q2" vid="PSA 37:30">waru eelentsu a̱ yi a̱ tsu yuwan ta̱ adanshi mejege.<verse eid="PSA 37:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31" />Wila̱ wa̱ A̱sula̱ a̱ yi u ta̱ okolo a̱ yi,</para>
  <para style="q2" vid="PSA 37:31">u tsu lyawai shi suru suru.<verse eid="PSA 37:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32" />A̱za̱ e iwuya a tsu</para>
  <para style="q2" vid="PSA 37:32">vawan ta̱ a̱za̱ a̱ a̱ɓula̱,</para>
  <para style="q2" vid="PSA 37:32">adama o una le.<verse eid="PSA 37:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33" />Amma A̱sulazuva aa lyawa le,</para>
  <para style="q2" vid="PSA 37:33">e ekere le shi,</para>
  <para style="q1" vid="PSA 37:33">ko u lyawa a yuwaan le</para>
  <para style="q2" vid="PSA 37:33">uge'etosu we epen shi.<verse eid="PSA 37:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34" />Vu zuwa okolo a̱ wu</para>
  <para style="q2" vid="PSA 37:34">uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 37:34">vu yuwan tsutoni na̱ wila̱ wa̱ yi.</para>
  <para style="q1" vid="PSA 37:34">A̱yi ɗa waa ca wu ucira</para>
  <para style="q2" vid="PSA 37:34">waru vu ta̱ ene</para>
  <para style="q2" vid="PSA 37:34">a na a̱ gba̱ra̱i a̱za̱ e iwuya.<verse eid="PSA 37:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35" />Me ene ta̱ ɗe vuma wuya,</para>
  <para style="q2" vid="PSA 37:35">za na tse ene iliyali shi,</para>
  <para style="q1" vid="PSA 37:35">a balasa tsu uɗanga wu uta̱nu,</para>
  <para style="q2" vid="PSA 37:35">u na u ri e iɗa yu umili.<verse eid="PSA 37:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36" />Amma na a tarai mantsa wa'a</para>
  <para style="q2" vid="PSA 37:36">na n ka̱mba̱i me ene yi waru shi,</para>
  <para style="q2" vid="PSA 37:36">n zami yi ta̱, agba me ene yi shi.<verse eid="PSA 37:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37" />Vi idana aza a na a̱ ri a mmalu a̱tsuma̱ amayun,</para>
  <para style="q2" vid="PSA 37:37">vi idana vuma va̱ a̱ɓula̱.</para>
  <para style="q1" vid="PSA 37:37">Adama a na a̱ ta̱ tsura̱</para>
  <para style="q2" vid="PSA 37:37">asuvu n nden o kosu.<verse eid="PSA 37:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38" />Amma o to kototo a̱za̱ o unusu suru,</para>
  <para style="q2" vid="PSA 37:38">waru o to kototo limatan le.<verse eid="PSA 37:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39" />A̱sulazuva a tsu wawa ta̱</para>
  <para style="q2" vid="PSA 37:39">a̱za̱ a̱ a̱ɓula̱,</para>
  <para style="q1" vid="PSA 37:39">waru a̱yi ɗa</para>
  <para style="q2" vid="PSA 37:39">uba̱ta̱ wu upa'atan wu ucira u le</para>
  <para style="q2" vid="PSA 37:39">a mantsa ma̱ a̱tsuma̱lima̱.<verse eid="PSA 37:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40" />A̱sulazuva a tsu kamba le ta̱</para>
  <para style="q2" vid="PSA 37:40">waru u wawa le,</para>
  <para style="q1" vid="PSA 37:40">u tsu wawa le ta̱ e ekere a̱za̱ e iwuya,</para>
  <para style="q2" vid="PSA 37:40">waru u wawa le,</para>
  <para style="q1" vid="PSA 37:40">adama a na a̱ tsu ta̱wa̱ ta̱</para>
  <para style="q2" vid="PSA 37:40">uba̱ta̱ wa̱ yi izami yu upa'anta.<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" sid="PSA 38" />
  <para style="d">Ica ya̱ Da̱wuda. Avasa a ɗa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1" />A̱sulazuva she vu ɓara mu</para>
  <para style="q2" vid="PSA 38:1">a̱tsuma̱ o upan wa̱ wu wan,</para>
  <para style="q1" vid="PSA 38:1">ko vu ca mu oforo</para>
  <para style="q2" vid="PSA 38:1">a̱tsuma̱ o upan wa̱ wu wan.<verse eid="PSA 38:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2" />Adama a na vu uwwato mu ta̱</para>
  <para style="q2" vid="PSA 38:2">usa̱n ni aya a̱ wu,</para>
  <para style="q1" vid="PSA 38:2">a̱vu waru vu lapa mu</para>
  <para style="q2" vid="PSA 38:2">nu ukere wa̱ wu.<verse eid="PSA 38:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3" />Adama o upan wa̱ wu,</para>
  <para style="q2" vid="PSA 38:3">lipu va̱ ri gbaga shi,</para>
  <para style="q1" vid="PSA 38:3">etele a̱ va̱ a̱ ri nu ucira shi,</para>
  <para style="q2" vid="PSA 38:3">adama o unusu u va̱.<verse eid="PSA 38:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4" />Nusu va̱ la'a ta̱ ucira u va̱,</para>
  <para style="q2" vid="PSA 38:4">tsi itana yu ume</para>
  <para style="q2" vid="PSA 38:4">a la'a ta̱ ucira u va̱.<verse eid="PSA 38:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5" />Adama o tsulo tsa̱ va̱,</para>
  <para style="q2" vid="PSA 38:5">antsu a̱ va̱ a shama ta̱</para>
  <para style="q2" vid="PSA 38:5">hali a̱ ka̱ra̱ o uta̱sa̱ ushamu.<verse eid="PSA 38:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6" />Mɓa̱la̱ n va̱ n tu usa̱n lon</para>
  <para style="q2" vid="PSA 38:6">hali mɓa̱la̱'a̱ mpolo mu</para>
  <para style="q2" vid="PSA 38:6">n da̱na̱ ta̱ e mesun urana ma̱ɓula̱.<verse eid="PSA 38:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7" />N ta̱ mpolo ni ivuna̱</para>
  <para style="q2" vid="PSA 38:7">n tu ubanakun lon.<verse eid="PSA 38:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8" />N kuna̱ ta̱ suru suru,</para>
  <para style="q2" vid="PSA 38:8">lipu va̱ e ina ta̱ lon,</para>
  <para style="q1" vid="PSA 38:8">okolo a̱ va̱ a̱ ri nven shi</para>
  <para style="q2" vid="PSA 38:8">n ta̱ a̱ ma̱nga̱ adama o usa̱n.<verse eid="PSA 38:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9" />A̱sulazuva vu reve ta̱ ili i na n cigai,</para>
  <para style="q2" vid="PSA 38:9">waru vu ta uwwusa ma̱nga̱ ma̱ va̱ suru.<verse eid="PSA 38:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10" />Okolo a̱ va̱ a̱ ta̱ ma̱riya̱,</para>
  <para style="q2" vid="PSA 38:10">ucira u va̱ u koto ta̱,</para>
  <para style="q2" vid="PSA 38:10">esu a̱ va̱ o'wo ta̱ pilika̱.<verse eid="PSA 38:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11" />N'utsa̱ n va̱ na̱ nron mu nden n va̱,</para>
  <para style="q2" vid="PSA 38:11">a suma mu ta̱</para>
  <para style="q2" vid="PSA 38:11">adama a antsu a̱ va̱,</para>
  <para style="q1" vid="PSA 38:11">hali fo a̱za̱ o u'wa a̱ va̱ a suma mu.<verse eid="PSA 38:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12" />Aza a na a cigai o una mu</para>
  <para style="q2" vid="PSA 38:12">azuwaa mu ta̱ maza,</para>
  <para style="q1" vid="PSA 38:12">aza a na a cigai a paala mu</para>
  <para style="q2" vid="PSA 38:12">a yuwan ta̱ ifoɓi</para>
  <para style="q2" vid="PSA 38:12">i na a yuwan mu ulungusu.</para>
  <para style="q1" vid="PSA 38:12">Urana ma̱ɓula̱ a̱ ta̱</para>
  <para style="q2" vid="PSA 38:12">foɓuso mu iwuya.<verse eid="PSA 38:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13" />N ta̱ tsa aagulani, n tsu uwwa shi,</para>
  <para style="q2" vid="PSA 38:13">n ta̱ tsa za na tsu gura yuwan adanshi shi.<verse eid="PSA 38:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14" />Mo o'wo ta̱ tsa aagulani</para>
  <para style="q2" vid="PSA 38:14">n tsu uwwa adanshi shi,</para>
  <para style="q2" vid="PSA 38:14">za na tsu gura usu adanshi shi.<verse eid="PSA 38:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15" />A̱sulazuva ya̱'a̱ wu ɗa</para>
  <para style="q2" vid="PSA 38:15">maa zuwusa ucira,</para>
  <para style="q1" vid="PSA 38:15">A̱sulazuva A̱sula̱ a̱ va̱</para>
  <para style="q2" vid="PSA 38:15">a̱vu ɗa vaa uwwa mu.<verse eid="PSA 38:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16" />Avasa a̱ va̱ a̱ yi ɗa,</para>
  <para style="q2" vid="PSA 38:16">&lt;&lt;She vu lyawa n'yuwatan n va̱</para>
  <para style="q2" vid="PSA 38:16">n yuwan ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 38:16">adama a̱tsuma̱lima̱ a̱ va̱ wan,</para>
  <para style="q1" vid="PSA 38:16">she vu lyawa le a lapa ma̱ka̱ka̱n</para>
  <para style="q2" vid="PSA 38:16">adama a̱ a̱risa̱ a̱ va̱ wan.&gt;&gt;<verse eid="PSA 38:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17" />Adama a na n ciga ta̱ ma̱riya̱a̱,</para>
  <para style="q2" vid="PSA 38:17">mantsa suru n ta̱ pe a̱tsuma̱lima̱.<verse eid="PSA 38:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18" />N damma ta̱ nusu va̱,</para>
  <para style="q2" vid="PSA 38:18">nusu va̱ zuwa ta̱</para>
  <para style="q2" vid="PSA 38:18">mo o'wo udamu lon.<verse eid="PSA 38:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19" />A̱za̱ a̱ tsushu'un na̱ mu</para>
  <para style="q2" vid="PSA 38:19">babu ufaru a̱ ta̱ nu ucira lon,</para>
  <para style="q1" vid="PSA 38:19">aza a na a 'yuwan mu</para>
  <para style="q2" vid="PSA 38:19">babu ufaru a̱ ta̱ a̱bunda̱.<verse eid="PSA 38:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20" />Aza a na a tsu tsupaa mu</para>
  <para style="q2" vid="PSA 38:20">isa'ani ni iwuya,</para>
  <para style="q2" vid="PSA 38:20">a̱ ta̱ tsushu'un na̱ mu,</para>
  <para style="q1" vid="PSA 38:20">adama a na n ta yuwusan</para>
  <para style="q2" vid="PSA 38:20">ukadu u na maa yuwan isa'ani.<verse eid="PSA 38:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21" />A̱sulazuva she vu vari mu wan,</para>
  <para style="q2" vid="PSA 38:21">A̱sula̱ a̱ va̱ she vu yuwan</para>
  <para style="q2" vid="PSA 38:21">alanga na̱ a̱mu wan.<verse eid="PSA 38:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22" />A̱sulazuva za vi iwawi i va̱</para>
  <para style="q2" vid="PSA 38:22">vu kamba mu gogo.<verse eid="PSA 38:22" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" sid="PSA 39" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Adama a Yedutun. Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1" />N damma ta̱, &lt;&lt;N ta guza̱ una̱ u va̱,</para>
  <para style="q2" vid="PSA 39:1">ma yuwan unusu ne eelentsu a̱ va̱ shi.</para>
  <para style="q1" vid="PSA 39:1">N te reme una̱ u va̱,</para>
  <para style="q2" vid="PSA 39:1">mantsa ma na a̱za̱ e iwuya a̱ ri zuzu na̱ mu.&gt;&gt;<verse eid="PSA 39:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2" />N guza̱ ta̱ una̱ u va̱,</para>
  <para style="q2" vid="PSA 39:2">n damma ili i ro shi.</para>
  <para style="q1" vid="PSA 39:2">Ko na n da̱na̱i kpaku,</para>
  <para style="q2" vid="PSA 39:2">u kamba mu shi,</para>
  <para style="q1" vid="PSA 39:2">suru na̱ ne a̱tsuma̱lima̱ a̱ va̱</para>
  <para style="q2" vid="PSA 39:2">a̱ da̱shishi ta̱.<verse eid="PSA 39:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3" />Okolo a̱ va̱ a shiwan ta̱ na atakaci,</para>
  <para style="q2" vid="PSA 39:3">o una̱ wa̱ a̱ a̱bunda̱ a majiyan ma̱ va̱,</para>
  <para style="q2" vid="PSA 39:3">ne ɗa a̱bunda̱ a̱tsuma̱lima̱ a̱ va̱ wo o'woi</para>
  <para style="q1" vid="PSA 39:3">Ili'i u zuwa mu ta̱</para>
  <para style="q2" vid="PSA 39:3">ko n 'yuwan n ciga n yuwan adanshi.<verse eid="PSA 39:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4" />&lt;&lt;A̱sulazuva lyawa n reve</para>
  <para style="q2" vid="PSA 39:4">a̱bunda̱ a rana va̱.</para>
  <para style="q1" vid="PSA 39:4">Urana u ne u ɗa ma̱a̱ kuwa̱?</para>
  <para style="q2" vid="PSA 39:4">Roco mu cine rana va̱ ri a̱ ma̱ka̱ra̱.<verse eid="PSA 39:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5" />&lt;&lt;A̱yi ɗa nda a̱bunda̱ a rana,</para>
  <para style="q2" vid="PSA 39:5">wuma va̱ a̱ ri a̱bunda̱ shi,</para>
  <para style="q1" vid="PSA 39:5">e ekere a̱ wu a'wan a̱ va̱</para>
  <para style="q2" vid="PSA 39:5">ili i ro i ɗa shi.</para>
  <para style="q1" vid="PSA 39:5">Amayun, vaɗilima̱ suru,</para>
  <para style="q2" vid="PSA 39:5">u tu tsu upepu u na wa̱a̱ ka̱ra̱sa̱.<verse eid="PSA 39:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6" />Wuma u vuma u ta̱ cine vu revei</para>
  <para style="q2" vid="PSA 39:6">ululu u tsu vadala,</para>
  <para style="q2" vid="PSA 39:6">nu uvadalasa wa̱ yi suru pere ɗa.</para>
  <para style="q1" vid="PSA 39:6">U tsu ɓoloto ta̱ utsuru,</para>
  <para style="q2" vid="PSA 39:6">amma u tsu reve za na</para>
  <para style="q2" vid="PSA 39:6">a uwwa uyo'o u le shi.&gt;&gt;<verse eid="PSA 39:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7" />&lt;&lt;A̱sulazuva a̱ nye ɗa maa zuwa okolo a̱ va̱?</para>
  <para style="q2" vid="PSA 39:7">Ya̱'a̱ wu ɗa maa zuwusa okolo a̱ va̱.<verse eid="PSA 39:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8" />Wawa mu a̱tsuma̱ a̱ nusu va̱ suru,</para>
  <para style="q2" vid="PSA 39:8">she vu lyawa olo a yuwaan mu ulamu wan.<verse eid="PSA 39:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9" />N guza̱ ta̱ una̱ u va̱,</para>
  <para style="q2" vid="PSA 39:9">maa damma ili shi,</para>
  <para style="q2" vid="PSA 39:9">adama a na a̱vu ɗa vu yuwain ne.<verse eid="PSA 39:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10" />Vu tawa mu a̱tsuma̱lima̱ a̱ wu,</para>
  <para style="q2" vid="PSA 39:10">n ciga ta̱ ma̱kuwa̱a̱ adama a̱ likuku va̱ wu.<verse eid="PSA 39:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11" />Vu tsu ɓara ta̱,</para>
  <para style="q2" vid="PSA 39:11">a̱vu vu ge'eto vuma</para>
  <para style="q2" vid="PSA 39:11">adama o unusu wa̱ yi,</para>
  <para style="q1" vid="PSA 39:11">cine vu revei aran,</para>
  <para style="q2" vid="PSA 39:11">vu tsu lungusa̱ ta̱ ili i na vuma la'a cigai,</para>
  <para style="q1" vid="PSA 39:11">amayun, vuma suru,</para>
  <para style="q2" vid="PSA 39:11">u tu lo cine vu revei upepu u na u tsu ka̱ra̱.<verse eid="PSA 39:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12" />&lt;&lt;A̱sulazuva vu uwwa avasa a̱ va̱,</para>
  <para style="q2" vid="PSA 39:12">waru vu uwwa mesun ma̱ va̱,</para>
  <para style="q1" vid="PSA 39:12">vu tasa mu aɓara.</para>
  <para style="q2" vid="PSA 39:12">Adama a na n to oɓolo na̱ a̱vu,</para>
  <para style="q2" vid="PSA 39:12">cine vu revei mocin na a̱ ka̱ra̱,</para>
  <para style="q1" vid="PSA 39:12">a̱mu mocin ɗa,</para>
  <para style="q2" vid="PSA 39:12">cine vu revei nkaya n tsu n da̱na̱i.<verse eid="PSA 39:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13" />Vu lyawa mu ko n ta̱ tsura̱ asuvu nden,</para>
  <para style="q2" vid="PSA 39:13">kafu n ka̱ra̱ n lyawa pa suru suru.&gt;&gt;<verse eid="PSA 39:13" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" sid="PSA 40" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Ica ya̱ Da̱wuda. Ica i ɗa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1" />M puro ta̱ ikambishi ya̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 40:1">na ankuri,</para>
  <para style="q1" vid="PSA 40:1">reve u polo atsuvu wu uwwa ipati i va̱.<verse eid="PSA 40:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2" />Wu uta̱a̱ mu ta̱ a̱tsuma̱</para>
  <para style="q2" vid="PSA 40:2">a̱ a̱a̱ka̱ri e meleshe,</para>
  <para style="q2" vid="PSA 40:2">a̱tsuma̱ olo'o na̱ yilyo'o.</para>
  <para style="q1" vid="PSA 40:2">Reve u zuwa ana a̱ va̱</para>
  <para style="q2" vid="PSA 40:2">zuva va aatali uba̱ta̱ u na</para>
  <para style="q2" vid="PSA 40:2">n gura isawain ulobonu.<verse eid="PSA 40:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3" />U zuwa ta̱ n cana ishipa i sa'avu,</para>
  <para style="q2" vid="PSA 40:3">ishipa yi ica ya̱ A̱sula̱ a̱ tsu.</para>
  <para style="q1" vid="PSA 40:3">Ama na̱ a̱bunda̱ e te ene</para>
  <para style="q2" vid="PSA 40:3">ili ya nda a̱vu a uwwa wovon,</para>
  <para style="q1" vid="PSA 40:3">a̱vu a zuwa okolo e le</para>
  <para style="q2" vid="PSA 40:3">uba̱ta̱ wa̱ A̱sulazuva.<verse eid="PSA 40:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4" />Za ma̱za̱nga̱ ɗa</para>
  <para style="q2" vid="PSA 40:4">za na zuwai ucira wa̱ yi</para>
  <para style="q2" vid="PSA 40:4">uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q1" vid="PSA 40:4">za na a uwwusa maluwa</para>
  <para style="q2" vid="PSA 40:4">ma aza a na a̱ 'ya̱susa̱n a aci shi,</para>
  <para style="q1" vid="PSA 40:4">ko u ɓolo a aci</para>
  <para style="q2" vid="PSA 40:4">na aza na aa yuwusaan musula̱ a̱ga̱nda̱ shi.<verse eid="PSA 40:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5" />A̱sulazuva A̱sula̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 40:5">linga va̱ wu va asalama</para>
  <para style="q2" vid="PSA 40:5">ta̱ a̱bunda̱ lon!</para>
  <para style="q1" vid="PSA 40:5">Ili i na vu foɓoo ntsu,</para>
  <para style="q2" vid="PSA 40:5">u la'a ta̱ ucira u na e kece!</para>
  <para style="q1" vid="PSA 40:5">Ko na̱ shi n ciga n yuwan adanshi e le,</para>
  <para style="q2" vid="PSA 40:5">ko n ca alabari e le,</para>
  <para style="q1" vid="PSA 40:5">a̱bunda̱ e le a la'a ta̱</para>
  <para style="q2" vid="PSA 40:5">ucira u na e kece.<verse eid="PSA 40:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6" />Vu ciga kucci vu ne'en shi,</para>
  <para style="q2" vid="PSA 40:6">na̱ kucci vu ukula̱tosu shi,</para>
  <para style="q1" vid="PSA 40:6">vu ciga a ca wu</para>
  <para style="q2" vid="PSA 40:6">kucci vu ukula̱tosu,</para>
  <para style="q1" vid="PSA 40:6">vi iliyamunga zuva masa'a shi</para>
  <para style="q2" vid="PSA 40:6">ko ne'en adama a matawa mo unusu shi.</para>
  <para style="q1" vid="PSA 40:6">Amma vu ca mu ta̱</para>
  <para style="q2" vid="PSA 40:6">atsuvu a na ma uwwa wu.<verse eid="PSA 40:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7" />Ɗaɗa n dammai, &lt;&lt;Apa mu, n ta̱wa̱ ta̱,</para>
  <para style="q2" vid="PSA 40:7">cine u ri uɗanu</para>
  <para style="q2" vid="PSA 40:7">adama aɗa a̱ va̱ a̱tsuma̱ a aatagada.<verse eid="PSA 40:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8" />A̱sula̱ a̱ va̱ n ciga ta̱,</para>
  <para style="q2" vid="PSA 40:8">n yuwan ili i na vu cigai lon,</para>
  <para style="q2" vid="PSA 40:8">n guza̱ ta̱ uritosu wa̱ wu</para>
  <para style="q2" vid="PSA 40:8">a̱tsuma̱ okolo a̱ va̱.&gt;&gt;<verse eid="PSA 40:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9" />A̱sulazuva n damma ta̱</para>
  <para style="q2" vid="PSA 40:9">linga va̱ a̱ɓula̱ a̱ wu suru</para>
  <para style="q2" vid="PSA 40:9">a̱tsuma̱ e iɓolo ya ama,</para>
  <para style="q1" vid="PSA 40:9">vu reve ta̱ n kpa̱to</para>
  <para style="q2" vid="PSA 40:9">una̱ u va̱ shi.<verse eid="PSA 40:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10" />N guza̱ alabari e iwawi ya̱ wu</para>
  <para style="q2" vid="PSA 40:10">adama a aciya̱va̱ goon shi,</para>
  <para style="q1" vid="PSA 40:10">n tsu yuwan ta̱ adanshi a̱ a̱ɓula̱ a̱ wu</para>
  <para style="q2" vid="PSA 40:10">ni ikambi ya̱ wu mantsa suru.</para>
  <para style="q1" vid="PSA 40:10">N tsu rungwa̱ kpen</para>
  <para style="q2" vid="PSA 40:10">a̱tsuma̱ e iɓolo ya a ama a̱ wu shi</para>
  <para style="q1" vid="PSA 40:10">amma n tsu yuwan ta̱ adanshi e icigi ya̱ wu</para>
  <para style="q2" vid="PSA 40:10">i na i tsu vadala shi</para>
  <para style="q2" vid="PSA 40:10">na̱ a̱ɓula̱ a̱ wu.<verse eid="PSA 40:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11" />A̱sulazuva n reve ta̱ vu kuɗa̱</para>
  <para style="q2" vid="PSA 40:11">e ene iliyali i va̱ shi!</para>
  <para style="q1" vid="PSA 40:11">Amma icigi ya̱ wu i na i tsu vadala shi</para>
  <para style="q2" vid="PSA 40:11">na̱ a̱ɓula̱ a̱ wu</para>
  <para style="q1" vid="PSA 40:11">a ta yuwaan mu mapari</para>
  <para style="q2" vid="PSA 40:11">mantsa suru.<verse eid="PSA 40:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12" />Addama icu'un icu'un</para>
  <para style="q2" vid="PSA 40:12">a̱ ka̱nda̱ruwa̱ mu ta̱,</para>
  <para style="q2" vid="PSA 40:12">hali na a̱ ri n kece shi!</para>
  <para style="q1" vid="PSA 40:12">Nusu va̱ la'a ta̱ ucira u va̱,</para>
  <para style="q2" vid="PSA 40:12">hali na maa gura e ene shi.</para>
  <para style="q1" vid="PSA 40:12">A la'a ta̱ a̱nji a aaci a̱ va̱ a̱bunda̱,</para>
  <para style="q2" vid="PSA 40:12">hali okolo a̱ va̱ a kuɗa.<verse eid="PSA 40:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13" />A̱sulazuva vu wawa mu,</para>
  <para style="q2" vid="PSA 40:13">vu jika̱ vu kamba mu!<verse eid="PSA 40:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14" />Vu zuwa aza a na</para>
  <para style="q2" vid="PSA 40:14">a zama o una mu</para>
  <para style="q2" vid="PSA 40:14">a lyuwa aci aciyele a̱ ra̱pula̱.</para>
  <para style="q1" vid="PSA 40:14">Vu zuwa aza a na a̱ ri a̱ ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 40:14">adama a̱tsuma̱lima̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 40:14">a̱ ka̱mba̱ na̱ wono.<verse eid="PSA 40:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15" />Vu zuwa aza a na o zo'osuso mu</para>
  <para style="q2" vid="PSA 40:15">a lamba ili i na a damma adama o wono!<verse eid="PSA 40:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16" />Vu zuwa aza a na a̱ ta̱wusa̱ uba̱ta̱ wa̱ wu</para>
  <para style="q2" vid="PSA 40:16">a yuwan ma̱za̱nga̱ na̱ mere!</para>
  <para style="q1" vid="PSA 40:16">Vu zuwa aza a na a cigai iwawi ya̱ wu,</para>
  <para style="q2" vid="PSA 40:16">mantsa suru a damma, &lt;&lt;A̱sulazuva zagbain ɗa!&gt;&gt;<verse eid="PSA 40:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17" />A̱sulazuva n ri nu ucira shi</para>
  <para style="q2" vid="PSA 40:17">agba n ri na̱ za na</para>
  <para style="q2" vid="PSA 40:17">a kamba mu shi,</para>
  <para style="q2" vid="PSA 40:17">vu ta̱wa̱ uba̱ta̱ u va̱ gogo.</para>
  <para style="q1" vid="PSA 40:17">A̱vu ɗa za na a kamba mu</para>
  <para style="q2" vid="PSA 40:17">na̱ za vi iwawi i va̱.</para>
  <para style="q2" vid="PSA 40:17">A̱sulazuva she lungusa̱ mantsa wan!<verse eid="PSA 40:17" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" sid="PSA 41" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1" />Za ma̱za̱nga̱ ɗa vuma na tsu kambusa</para>
  <para style="q2" vid="PSA 41:1">aza a na a̱ ri nu ucira shi,</para>
  <para style="q1" vid="PSA 41:1">A̱sulazuva a ta kamba yi</para>
  <para style="q2" vid="PSA 41:1">a mantsa ma addama.<verse eid="PSA 41:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2" />A̱sulazuva a ta yuwan yi mapari</para>
  <para style="q2" vid="PSA 41:2">waru u geshe wuma wa̱ yi,</para>
  <para style="q1" vid="PSA 41:2">u ta zuwa yi wu uwwa uyo'o</para>
  <para style="q2" vid="PSA 41:2">a̱tsuma̱ e iɗa'a.</para>
  <para style="q1" vid="PSA 41:2">Waa lyawai e ekere</para>
  <para style="q2" vid="PSA 41:2">a n'yuwatan ma̱ yi shi.<verse eid="PSA 41:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3" />A̱sulazuva a ta kamba yi,</para>
  <para style="q2" vid="PSA 41:3">a mantsa ma na u ri ubanakun,</para>
  <para style="q2" vid="PSA 41:3">a̱vu u yuwaan yi opocino.<verse eid="PSA 41:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4" />N damma ta̱,</para>
  <para style="q2" vid="PSA 41:4">&lt;&lt;A̱sulazuva n yuwaan wu ta̱ unusu,</para>
  <para style="q1" vid="PSA 41:4">vee ene iliyali i va̱</para>
  <para style="q2" vid="PSA 41:4">vu yuwaan mu opocino!&gt;&gt;<verse eid="PSA 41:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5" />N'yuwatan n va̱ n ta yuwusan</para>
  <para style="q2" vid="PSA 41:5">adanshi e iwuya a aciya̱va̱,</para>
  <para style="q1" vid="PSA 41:5">a dansa, &lt;&lt;Uranu u ne ɗa wa̱ kuwa̱</para>
  <para style="q2" vid="PSA 41:5">adama e icina na̱ yi?&gt;&gt;<verse eid="PSA 41:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6" />Aza a na a̱ ta̱wusa̱ ica̱su i va̱</para>
  <para style="q2" vid="PSA 41:6">na aɗa e re ɗa a̱ ta̱wusa̱,</para>
  <para style="q1" vid="PSA 41:6">a̱tsu ɓoloto ta̱ adanshi e epen a aci a̱ va̱,</para>
  <para style="q2" vid="PSA 41:6">a̱vu a̱ 'ya̱wa̱ e bete'we adanshi'i uba̱ta̱ suru.<verse eid="PSA 41:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7" />Aza a na a 'yuwan numu suru,</para>
  <para style="q2" vid="PSA 41:7">a̱ ta̱ e idami i va̱,</para>
  <para style="q1" vid="PSA 41:7">a majiyan n gashi n la'a ta̱ za suru iwuya.<verse eid="PSA 41:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8" />A dansa, &lt;&lt;Ubanakun wu ukwisa̱ u ɗa yi,</para>
  <para style="q2" vid="PSA 41:8">waa la'a shi.&gt;&gt;<verse eid="PSA 41:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9" />Hali ni i'utsa̱ i va̱ fo,</para>
  <para style="q2" vid="PSA 41:9">za na n soɗu wo yi ma̱tsa̱n,</para>
  <para style="q1" vid="PSA 41:9">za na tsu, tsu lyuwa ilyalya a mapara ma̱ ta̱,</para>
  <para style="q2" vid="PSA 41:9">u vadala ta̱ u reme tsushu'un na̱ a̱mu.<verse eid="PSA 41:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10" />Amma, a̱vu A̱sulazuva,</para>
  <para style="q2" vid="PSA 41:10">vee e ene iliyali i va̱</para>
  <para style="q1" vid="PSA 41:10">vu yuwaan mu opocino,</para>
  <para style="q2" vid="PSA 41:10">tsa̱ra̱ n tsupa n'yuwatan n va̱.<verse eid="PSA 41:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11" />N ta̱ reve na vaa uwwusa uyo'o u va̱,</para>
  <para style="q2" vid="PSA 41:11">adama a na a lyuwa a aci a̱ va̱ shi.<verse eid="PSA 41:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12" />Vu ta kamba mu</para>
  <para style="q2" vid="PSA 41:12">adama a na maa yuwusan</para>
  <para style="q2" vid="PSA 41:12">ili i mejege,</para>
  <para style="q2" vid="PSA 41:12">vu ta zuwa mu a̱ ma̱ka̱ka̱n ma̱ wu hali hali.<verse eid="PSA 41:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13" />Lyawa tsu cuwa yi</para>
  <para style="q2" vid="PSA 41:13">A̱sulazuva A̱sula̱ aza a Isra'ila,</para>
  <para style="q1" vid="PSA 41:13">cuwa niyi gogo na̱ hali hali!</para>
  <para style="q2" vid="PSA 41:13">Lyawa wo o'wo ne! Lyawa wo o'wo ne!<verse eid="PSA 41:13" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" sid="PSA 42" />
  <para style="ms1">Aatagada a̱ ire</para>
  <para style="mr">(<ref loc="PSA 42-71">Ica 42-71</ref>)</para>
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Ishipa yu uyo'o i muwun mo olobo ma Kora.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1" />Cine meshon ma̱ tsu da̱na̱</para>
  <para style="q2" vid="PSA 42:1">a maluwa ma mini mo uta̱nu o uɗolu,</para>
  <para style="q1" vid="PSA 42:1">ne ɗa wuma u va̱ u ri</para>
  <para style="q2" vid="PSA 42:1">a maluwa ma̱ wu</para>
  <para style="q2" vid="PSA 42:1">A̱sula̱ a̱ va̱.<verse eid="PSA 42:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2" />A̱sula̱ n ta uwwusa akuli a̱ wu,</para>
  <para style="q2" vid="PSA 42:2">A̱sula̱ a wuma.</para>
  <para style="q1" vid="PSA 42:2">Urana une u ɗa ma̱a̱ ta̱wa̱</para>
  <para style="q2" vid="PSA 42:2">n yuwan a̱ga̱nda̱ a̱ ma̱ka̱ka̱n ma̱ wu?<verse eid="PSA 42:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3" />Ayin nu urana n ta̱ a̱ mesun,</para>
  <para style="q2" vid="PSA 42:3">aɓara a̱ va̱ a ɗa ilyalya i va̱,</para>
  <para style="q1" vid="PSA 42:3">mantsa suru n'yuwatan n va̱</para>
  <para style="q2" vid="PSA 42:3">a ta a dansaa mu,</para>
  <para style="q2" vid="PSA 42:3">&lt;&lt;Te ɗa A̱sula̱ a̱ wu?&gt;&gt;<verse eid="PSA 42:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4" />Mantsa ma na n cuwain ili i na i ka̱ra̱i,</para>
  <para style="q2" vid="PSA 42:4">reve okolo a̱ va̱ a̱ la̱ngwa̱,</para>
  <para style="q1" vid="PSA 42:4">cine n tsu wala na ama,</para>
  <para style="q2" vid="PSA 42:4">a̱ tyo o u'wa wa̱ A̱sula̱.</para>
  <para style="q1" vid="PSA 42:4">Oɓolo ama a̱ ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 42:4">e ishipa a̱ 'ya̱susa̱n uɗyo</para>
  <para style="q2" vid="PSA 42:4">a yuwusaan A̱sula̱ ica.<verse eid="PSA 42:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5" />Adama a̱ nye okolo a̱ va̱ a̱ la̱nga̱i?</para>
  <para style="q2" vid="PSA 42:5">Adama a̱ nye mo o'woi a̱tsumola̱ngu tsunda?</para>
  <para style="q1" vid="PSA 42:5">N ta zuwa okolo a̱ va̱ uba̱ta̱ wa̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 42:5">n ta cuwisa yi,</para>
  <para style="q2" vid="PSA 42:5">za vi iwawi i va̱ na̱ A̱sula̱ a̱ va̱.<verse eid="PSA 42:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6" />Okolo a̱ va̱ a̱ la̱ngwa̱ ta̱ lon.</para>
  <para style="q2" vid="PSA 42:6">Adama o ndolo n ta cuwan na̱ a̱vu</para>
  <para style="q2" vid="PSA 42:6">o upasu wi iɗa ya Yahuda,</para>
  <para style="q1" vid="PSA 42:6">na aagaɗi a Hamon,</para>
  <para style="q2" vid="PSA 42:6">na aagaɗi a Miza.<verse eid="PSA 42:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7" />A̱tsuma̱lima̱ a̱ va̱ a̱ ta̱ tsa̱ mini ma̱ a̱ru'un,</para>
  <para style="q2" vid="PSA 42:7">o ɓolotosu aciyele tsa̱ra̱ a̱ pura̱ a̱mu,</para>
  <para style="q1" vid="PSA 42:7">ikeɗu i mini ma̱ wu waru,</para>
  <para style="q2" vid="PSA 42:7">a la'a ta̱ ucira u va̱.<verse eid="PSA 42:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8" />A̱sulazuva o roco mu ta̱,</para>
  <para style="q2" vid="PSA 42:8">icigi ya̱ yi i na i tsu vadala shi urana suru,</para>
  <para style="q1" vid="PSA 42:8">na ayin n ta yuwayin ica,</para>
  <para style="q2" vid="PSA 42:8">n yuwan avasa uba̱ta̱ wa̱ A̱sula̱</para>
  <para style="q2" vid="PSA 42:8">a na a ca numu wuma.<verse eid="PSA 42:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9" />N damma ta̱ A̱sula̱, aatali o upa'atan u va̱,</para>
  <para style="q2" vid="PSA 42:9">&lt;&lt;Cine vi icinai na̱ a̱mu?</para>
  <para style="q1" vid="PSA 42:9">Nye i zuwai mo sowuso a̱tsuma̱lima̱,</para>
  <para style="q2" vid="PSA 42:9">adama o ule'e wu n'yuwatan n va̱?&gt;&gt;<verse eid="PSA 42:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10" />Adanshi a n'yuwatan n va̱ a sapa mu ta̱,</para>
  <para style="q2" vid="PSA 42:10">tsa matsun me pe'eni e etele a̱ va̱,</para>
  <para style="q1" vid="PSA 42:10">na a tsu dansa mu,</para>
  <para style="q2" vid="PSA 42:10">&lt;&lt;Te ɗa A̱sula̱ a̱ wu?&gt;&gt;<verse eid="PSA 42:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11" />Nye i ta̱wa̱a̱ numu na̱ okolo ula̱ngu?</para>
  <para style="q2" vid="PSA 42:11">Nye i ta̱wa̱a̱ numu na̱ a̱tsumola̱ngu?</para>
  <para style="q1" vid="PSA 42:11">N ta zuwa okolo a̱ va̱ uba̱ta̱ wa̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 42:11">n ta cuwisa yi,</para>
  <para style="q2" vid="PSA 42:11">za vi iwawi i va̱ na̱ A̱sula̱ a̱ va̱.<verse eid="PSA 42:11" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" sid="PSA 43" />
  <para style="s">Avasa aza na ri a tsugbashi</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1" />A̱sula̱ vu roco,</para>
  <para style="q2" vid="PSA 43:1">n ri nu unusu shi,</para>
  <para style="q1" vid="PSA 43:1">vu usaa mu ili i na i ri za va̱,</para>
  <para style="q2" vid="PSA 43:1">e ekere aza a na e revei A̱sula̱ shi.</para>
  <para style="q1" vid="PSA 43:1">Vu wawa mu</para>
  <para style="q2" vid="PSA 43:1">diga epen a̱za̱ e iwuya.<verse eid="PSA 43:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2" />A̱vu ɗa A̱sula̱,</para>
  <para style="q2" vid="PSA 43:2">a̱vu ɗa upa'atan u va̱,</para>
  <para style="q2" vid="PSA 43:2">adama a̱ nye vu lyawa numu?</para>
  <para style="q1" vid="PSA 43:2">Adama a̱ nye n ri a mmalu na̱ a̱tsumola̱ngu,</para>
  <para style="q2" vid="PSA 43:2">adama o ule'e wu n'yuwatan n va̱?<verse eid="PSA 43:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3" />Vu lyungu ekan na amayun a̱ wu,</para>
  <para style="q2" vid="PSA 43:3">vu zuwa le a̱ ronoo mu aaɗanga.</para>
  <para style="q1" vid="PSA 43:3">Vu zuwa le a̱ ta̱wa̱to mu aagaɗi a akiza a̱ wu,</para>
  <para style="q2" vid="PSA 43:3">uba̱ta̱ u na vu ri na̱ nden.<verse eid="PSA 43:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4" />Reve n 'ya̱wa̱ a masa'a ma̱ wu A̱sula̱,</para>
  <para style="q2" vid="PSA 43:4">a̱ 'ya̱wa̱ uba̱ta̱ wa̱ wu</para>
  <para style="q2" vid="PSA 43:4">a̱vu na va zuwusa mu ma̱za̱nga̱ na̱ mere.</para>
  <para style="q1" vid="PSA 43:4">N ta cana ishipa yi ica a̱ tyo uba̱ta̱ wa̱ wu na̱ kumburu va̱,</para>
  <para style="q2" vid="PSA 43:4">A̱sula̱, A̱sula̱ a̱ va̱.<verse eid="PSA 43:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5" />Nye i ta̱wa̱a̱ numu na̱ okolo ula̱ngu?</para>
  <para style="q2" vid="PSA 43:5">Nye i ta̱wa̱a̱ numu na̱ a̱tsumola̱ngu?</para>
  <para style="q1" vid="PSA 43:5">N ta zuwa okolo a̱ va̱ uba̱ta̱ wa̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 43:5">n ta cuwisa yi,</para>
  <para style="q2" vid="PSA 43:5">za vi iwawi i va̱ na̱ A̱sula̱ a̱ va̱.<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" sid="PSA 44" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Ishipa yu uyo'o i muwun mo olobo ma Kora.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1" />A̱sula̱ tsu uwwa ta̱ na atsuvu a̱ tsu,</para>
  <para style="q2" vid="PSA 44:1">nkaya n tsu n damma tsu ta̱,</para>
  <para style="q1" vid="PSA 44:1">linga na vu yuwain a mantsa me le,</para>
  <para style="q2" vid="PSA 44:1">a mantsa ma na ma̱ ka̱ra̱i.<verse eid="PSA 44:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2" />Cine a̱vu na aciya̱wu</para>
  <para style="q2" vid="PSA 44:2">vu gba̱ra̱i aza a na e revei A̱sula̱ shi,</para>
  <para style="q2" vid="PSA 44:2">a̱vu vu shuwa̱ nkaya ntsu e iɗa i le.</para>
  <para style="q1" vid="PSA 44:2">Cine vu ge'eto yi nɗa n ro</para>
  <para style="q2" vid="PSA 44:2">a̱vu vu zuwa a ama a̱ wu abala.<verse eid="PSA 44:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3" />Na̱ matsun me pe'eni me le ma ɗa,</para>
  <para style="q2" vid="PSA 44:3">a lyuwai iɗa'a nu uvon shi,</para>
  <para style="q1" vid="PSA 44:3">nu ucira u le u ɗa</para>
  <para style="q2" vid="PSA 44:3">a lyuwai a aci iɗa'a shi,</para>
  <para style="q1" vid="PSA 44:3">amma nu ucira wa̱ wu u ɗa,</para>
  <para style="q2" vid="PSA 44:3">na vu roco nle vu to oɓolo ne e le,</para>
  <para style="q2" vid="PSA 44:3">o rocosu vu ta̱ e icigi i le.<verse eid="PSA 44:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4" />A̱vu ɗa Mogono ma̱ va̱ na̱ A̱sula̱ a̱ va̱.</para>
  <para style="q2" vid="PSA 44:4">Vu ca ta̱ a ama a̱ wu</para>
  <para style="q2" vid="PSA 44:4">aza a Isra'ila ulyuwu wa aci.<verse eid="PSA 44:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5" />Nu ucira wa̱ wu u ɗa</para>
  <para style="q2" vid="PSA 44:5">tsu kototoi n'yuwatan n tsu.</para>
  <para style="q1" vid="PSA 44:5">Na a ala a̱ wu a ɗa tsu dasai</para>
  <para style="q2" vid="PSA 44:5">aza a na a yuwusan nla̱ngi na̱ a̱tsu.<verse eid="PSA 44:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6" />N zuwa ucira u va̱</para>
  <para style="q2" vid="PSA 44:6">o utan u va̱ shi,</para>
  <para style="q1" vid="PSA 44:6">matsun me pe'eni ma̱ va̱</para>
  <para style="q2" vid="PSA 44:6">ma̱a̱ ta̱wa̱a̱ mu</para>
  <para style="q2" vid="PSA 44:6">nu ulyuwu wa aci shi.<verse eid="PSA 44:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7" />Amma vu wawa tsu ta̱</para>
  <para style="q2" vid="PSA 44:7">e ekere a n'yuwatan ntsu,</para>
  <para style="q1" vid="PSA 44:7">waru vu ca ta̱ aza a na a cigai</para>
  <para style="q2" vid="PSA 44:7">e ene tsu shi wono.<verse eid="PSA 44:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8" />E ekere a̱ A̱sula̱ a ɗa</para>
  <para style="q2" vid="PSA 44:8">tsaa yuwusan afalu mantsa suru,</para>
  <para style="q2" vid="PSA 44:8">waru tsu ta cuwa a ala a̱ wu hali hali.<verse eid="PSA 44:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9" />Amma gogo vu vari tsu ta̱,</para>
  <para style="q2" vid="PSA 44:9">reve vu zuwa a ca tsu wono,</para>
  <para style="q2" vid="PSA 44:9">vu buwa o uta̱sa̱ na̱ a̱soja a̱ tsu shi.<verse eid="PSA 44:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10" />Vu zuwa tsu ta̱ tsu sumaa</para>
  <para style="q2" vid="PSA 44:10">n'yuwatan n tsu,</para>
  <para style="q1" vid="PSA 44:10">aza na a 'yuwan ntsu</para>
  <para style="q2" vid="PSA 44:10">a̱vu a̱ pura̱ itana i tsu.<verse eid="PSA 44:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11" />Vu zuwa ta̱ tso o'wo</para>
  <para style="q2" vid="PSA 44:11">tsi ikyon i na a paɗa,</para>
  <para style="q2" vid="PSA 44:11">reve vu bete'we tsu a̱tsuma̱ a nɗa.<verse eid="PSA 44:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12" />Vu wina ta̱ ama a̱ wu ni ikebe ke'en,</para>
  <para style="q2" vid="PSA 44:12">vu tsura̱ ili i na i uwa nuwu shi.<verse eid="PSA 44:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13" />Vu lyawa ta̱ nron mu nden n tsu</para>
  <para style="q2" vid="PSA 44:13">n yuwaan tsu ulamu,</para>
  <para style="q1" vid="PSA 44:13">tso o'wo ta̱ ili yi izo'oshi</para>
  <para style="q2" vid="PSA 44:13">ni ili ya adanshi uba̱ta̱ wa aza a na</para>
  <para style="q2" vid="PSA 44:13">a̱ ri uka̱nda̱ruwu na̱ a̱tsu.<verse eid="PSA 44:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14" />Vu lyawa tsu ta̱ tso o'wo</para>
  <para style="q2" vid="PSA 44:14">ili yi iroci a̱tsuma̱ a nɗa,</para>
  <para style="q1" vid="PSA 44:14">ama a̱ ka̱ra̱ ta̱ o ulamu</para>
  <para style="q2" vid="PSA 44:14">a lumgbatsasa tsu aci.<verse eid="PSA 44:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15" />Mantsa suru n ta̱ pe a̱tsuma̱ wono,</para>
  <para style="q2" vid="PSA 44:15">wono u ɓa̱ru mu ta̱ uba̱ta̱ suru.<verse eid="PSA 44:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16" />Adama aza adanshi e pere</para>
  <para style="q2" vid="PSA 44:16">oɓolo na̱ a̱za̱ o ulamu,</para>
  <para style="q1" vid="PSA 44:16">na adama a n'yuwatan</para>
  <para style="q2" vid="PSA 44:16">aza a na a cigai a tsupa.<verse eid="PSA 44:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17" />Ili i ndolo i cina tsu ta̱ suru,</para>
  <para style="q2" vid="PSA 44:17">ko na wo o'woi tsi icina na̱ a̱vu shi,</para>
  <para style="q2" vid="PSA 44:17">ko tsu kuɗa akucunu a̱ wu shi.<verse eid="PSA 44:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18" />Okolo a̱ tsu a vadala diga uba̱ta̱ wa̱ wu shi,</para>
  <para style="q2" vid="PSA 44:18">ana tsu a lyawa ure wa̱ wu shi.<verse eid="PSA 44:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19" />Na̱ ne suru vu 'yuwan ta̱</para>
  <para style="q2" vid="PSA 44:19">a kamba a̱ tsu,</para>
  <para style="q1" vid="PSA 44:19">a̱vu vu lyawa tsu</para>
  <para style="q2" vid="PSA 44:19">e ekere a̱ musa̱n mu una,</para>
  <para style="q1" vid="PSA 44:19">vu lyawa tsu ta̱</para>
  <para style="q2" vid="PSA 44:19">a̱tsuma̱ e irumbu pici.<verse eid="PSA 44:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20" />A damma tsi icina ta̱</para>
  <para style="q2" vid="PSA 44:20">na ala a̱ A̱sula̱ a̱ tsu,</para>
  <para style="q1" vid="PSA 44:20">ko a damma tsu yuwaan ta̱</para>
  <para style="q2" vid="PSA 44:20">ma̱sula̱ mo ro a̱ga̱nda̱,<verse eid="PSA 44:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21" />vu shi ta̱ e reve,</para>
  <para style="q2" vid="PSA 44:21">adama a na vu reve ta̱</para>
  <para style="q2" vid="PSA 44:21">majiyan mo okolo a̱ tsu suru.<verse eid="PSA 44:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22" />Adama a̱ wu a ɗa</para>
  <para style="q2" vid="PSA 44:22">o unusa tsu mantsa suru,</para>
  <para style="q1" vid="PSA 44:22">a̱ ka̱mba̱to tsu ta̱</para>
  <para style="q2" vid="PSA 44:22">cine vu revei ikyon i na a paɗa.<verse eid="PSA 44:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23" />'Yon A̱sulazuva!</para>
  <para style="q2" vid="PSA 44:23">Nye i zuwai vu ri a nlavu?</para>
  <para style="q2" vid="PSA 44:23">'Yon! She vu vari tsu suru suru wan.<verse eid="PSA 44:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24" />Nye i zuwai vu sokoyi urewesu wa̱ wu?</para>
  <para style="q2" vid="PSA 44:24">Adama nye vi icinai</para>
  <para style="q2" vid="PSA 44:24">na̱ a̱tsuma̱lima̱ a̱ tsu?</para>
  <para style="q1" vid="PSA 44:24">Adama nye vi icinai</para>
  <para style="q2" vid="PSA 44:24">nu ule'e u na a yuwusan tsu?<verse eid="PSA 44:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25" />O polo tsu ta̱ e iɗa,</para>
  <para style="q2" vid="PSA 44:25">a̱vu a lyawa tsu nven a̱ ma̱buta̱.<verse eid="PSA 44:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26" />'Yon vu kamba tsu,</para>
  <para style="q2" vid="PSA 44:26">vu wawa tsu</para>
  <para style="q2" vid="PSA 44:26">adama e icigi ya̱ wu i na i tsu vadala shi.<verse eid="PSA 44:26" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" sid="PSA 45" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. A cana yi nu uɗyo u &lt;&lt;Lili.&gt;&gt; Wo olobo a Kora. Ishipa yu uyo'o.Ishipa i lolo.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1" />Okolo a̱ va̱ a̱ ta̱</para>
  <para style="q2" vid="PSA 45:1">tapu ni idanshi i sa'ani,</para>
  <para style="q1" vid="PSA 45:1">m ɓatsa ta̱ ishipa i nda</para>
  <para style="q2" vid="PSA 45:1">adama o mogono.</para>
  <para style="q1" vid="PSA 45:1">Eelentsu a̱ va̱ a̱ ta̱</para>
  <para style="q2" vid="PSA 45:1">tsa maɗanutsu,</para>
  <para style="q2" vid="PSA 45:1">e ekere a za vu uguru.<verse eid="PSA 45:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2" />A̱vu mogono vu la'a ta̱</para>
  <para style="q2" vid="PSA 45:2">za suru a̱tsuma̱ a ama,</para>
  <para style="q2" vid="PSA 45:2">vu tsu yuwan ta̱ adanshi a sa'ani,</para>
  <para style="q1" vid="PSA 45:2">A̱sula̱ a zuwaa wu ta̱</para>
  <para style="q2" vid="PSA 45:2">aba'un hali hali.<verse eid="PSA 45:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3" />Vu wo'o matsun me pe'eni ma̱ wu</para>
  <para style="q2" vid="PSA 45:3">yali yu uvon,</para>
  <para style="q2" vid="PSA 45:3">vu ta̱ na̱ tsugbain na̱ a̱ɓula̱!<verse eid="PSA 45:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4" />A̱tsuma̱ a tsugbain tsa̱ wu,</para>
  <para style="q2" vid="PSA 45:4">vu yuwan mmalu</para>
  <para style="q2" vid="PSA 45:4">a̱tsuma̱ o ulyuwu wa aci,</para>
  <para style="q2" vid="PSA 45:4">o una̱ u mejege na̱ a̱ɓula̱.</para>
  <para style="q1" vid="PSA 45:4">Lyawa ukere u sa'ani wa̱ wu,</para>
  <para style="q2" vid="PSA 45:4">u yuwan ulinga wa asalama!<verse eid="PSA 45:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5" />Aya a̱ wu a̱ ta̱ ucembeɗu lon,</para>
  <para style="q2" vid="PSA 45:5">a sapusa o okolo</para>
  <para style="q2" vid="PSA 45:5">a n'yuwatan m mogono,</para>
  <para style="q1" vid="PSA 45:5">nɗa n ta̱ riya̱sa̱</para>
  <para style="q2" vid="PSA 45:5">za̱la̱ va̱ wu.<verse eid="PSA 45:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6" />Ootogu o tsugono tsa̱ wu</para>
  <para style="q2" vid="PSA 45:6">diga uba̱ta̱ wa̱ A̱sula̱ a ɗa,</para>
  <para style="q2" vid="PSA 45:6">na ri hali hali,</para>
  <para style="q1" vid="PSA 45:6">aaɗanga a tsugbain tsa̱ wu</para>
  <para style="q2" vid="PSA 45:6">za mejege ɗa.<verse eid="PSA 45:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7" />Vu ciga ta̱ ili i na i ri mejege,</para>
  <para style="q2" vid="PSA 45:7">vu 'yuwan ta̱ iwuya.</para>
  <para style="q1" vid="PSA 45:7">A̱yi ɗa i zuwai A̱sula̱,</para>
  <para style="q2" vid="PSA 45:7">A̱sula̱ a̱ wu, u tawa nuwu.</para>
  <para style="q1" vid="PSA 45:7">A̱vu u sukuma wu</para>
  <para style="q2" vid="PSA 45:7">na̱ mani'in ma̱ ma̱za̱nga̱</para>
  <para style="q1" vid="PSA 45:7">reve u ca wu tsugbain</para>
  <para style="q2" vid="PSA 45:7">ula'awu na̱ n'utsa̱ ma̱ wu.<verse eid="PSA 45:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8" />Itana ya̱ wu a̱ ta̱ uta̱sa̱,</para>
  <para style="q2" vid="PSA 45:8">ma̱guru ma̱ aturare a̱ mur</para>
  <para style="q2" vid="PSA 45:8">na̱ alo na̱ Kasiya.</para>
  <para style="q1" vid="PSA 45:8">Tsuwe'e diga a 'wa vu ngono,</para>
  <para style="q2" vid="PSA 45:8">na a 'wa na ri wukalu na anga a agiwa,</para>
  <para style="q2" vid="PSA 45:8">a ta zuwusa wu ma̱za̱nga̱.<verse eid="PSA 45:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9" />Muwun ma̱ esheli mu ngono</para>
  <para style="q2" vid="PSA 45:9">n ta̱ pe a̱tsuma̱ a̱ a̱ma̱ci</para>
  <para style="q2" vid="PSA 45:9">a na acasu tsugbain</para>
  <para style="q1" vid="PSA 45:9">o ukere usa'ani wo ootogu o tsugono tsa̱ wu,</para>
  <para style="q2" vid="PSA 45:9">egbere ta̱ lo mishin,</para>
  <para style="q2" vid="PSA 45:9">wotowu ni itana</para>
  <para style="q2" vid="PSA 45:9">i zinariya i na i la'ai ulobonu.<verse eid="PSA 45:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10" />A̱vu usheli u va̱,</para>
  <para style="q2" vid="PSA 45:10">vu polo atsuvu vu uwwa</para>
  <para style="q2" vid="PSA 45:10">ili i na maa damma,</para>
  <para style="q1" vid="PSA 45:10">vi icina na a ama a̱ wu na̱ mmaci ma̱ wu.<verse eid="PSA 45:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11" />Mogono ma̱ te ene ulobonu wa̱ wu,</para>
  <para style="q2" vid="PSA 45:11">a̱vu wu uwwa maluwa ma̱ wu,</para>
  <para style="q1" vid="PSA 45:11">na wo o'woi a̱yi vali va̱ wu ɗa,</para>
  <para style="q2" vid="PSA 45:11">a̱vu vu yuwaan yi tsutoni.<verse eid="PSA 45:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12" />Ama a Taya a̱ ta̱ ta̱wa̱a̱ wu na̱ ne'e,</para>
  <para style="q2" vid="PSA 45:12">a̱za̱ o utsuru a ta zami isa'ani ya̱'a̱ wu.<verse eid="PSA 45:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13" />Kasa'avu mogono ta a maa uwa</para>
  <para style="q2" vid="PSA 45:13">o u'wa u mogono,</para>
  <para style="q2" vid="PSA 45:13">a gura kurato ulobonu wa̱ yi shi.</para>
  <para style="q1" vid="PSA 45:13">A̱ zula̱ ta̱ itana ya̱ yi</para>
  <para style="q2" vid="PSA 45:13">na̱ a̱punda̱ a zinariya.<verse eid="PSA 45:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14" />A̱ 'ya̱wa̱ ta̱ na̱ a̱yi uba̱ta̱ u mogono</para>
  <para style="q2" vid="PSA 45:14">wotowu ni itana i sa'ani i wukalu,</para>
  <para style="q2" vid="PSA 45:14">nan na̱wa̱yi a̱yi esheli a̱ shewun yi ta̱.<verse eid="PSA 45:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15" />A̱ shewun le ta̱ na̱ ma̱za̱nga̱ na̱ mere,</para>
  <para style="q2" vid="PSA 45:15">a uwa o u'wa u mogono.<verse eid="PSA 45:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16" />Mogono vu ta matsan</para>
  <para style="q2" vid="PSA 45:16">olobo na̱ a̱bunda̱,</para>
  <para style="q2" vid="PSA 45:16">a ta tara tsugbain tsu nkaya ma̱ wu.</para>
  <para style="q1" vid="PSA 45:16">Vu ta̱ zuwa le a yuwan tsugono</para>
  <para style="q2" vid="PSA 45:16">tsu uvaɗi suru.<verse eid="PSA 45:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17" />N ta zuwa a cuwan na ala a̱ wu,</para>
  <para style="q2" vid="PSA 45:17">diga mantsa a̱ tyo mantsa,</para>
  <para style="q1" vid="PSA 45:17">tsa̱ra̱ elentsu a cuwa wu,</para>
  <para style="q2" vid="PSA 45:17">hali hali hali.<verse eid="PSA 45:17" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" sid="PSA 46" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Wo olobo a Kora. Nu uɗyo wa alamo a ɗa a cana yi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1" />A̱sula̱ a ɗa uba̱ta̱ wu upa'atan</para>
  <para style="q2" vid="PSA 46:1">u tsu nu ucira u tsu,</para>
  <para style="q1" vid="PSA 46:1">ufoɓu u ɗa u ri tsa̱ra̱ u kamba tsu</para>
  <para style="q2" vid="PSA 46:1">a mantsa ma̱ a̱tsuma̱lima̱ suru.<verse eid="PSA 46:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2" />Adama o ndolo tsa uwwa wovon shi,</para>
  <para style="q2" vid="PSA 46:2">ko na̱ shi uvaɗi u jinga̱ɗa̱,</para>
  <para style="q2" vid="PSA 46:2">ko na̱ shi atali a̱ riya̱ a mala,<verse eid="PSA 46:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3" />ko na̱ shi mala ma̱ puna̱ a̱vu u gugwa̱,</para>
  <para style="q2" vid="PSA 46:3">ko na̱ shi nsasan n je'en</para>
  <para style="q2" vid="PSA 46:3">adama a na iɗa i jinga̱ɗa̱i.<verse eid="PSA 46:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4" />Uɗolu u tu lo na wa̱a̱ ta̱wusa̱a̱</para>
  <para style="q2" vid="PSA 46:4">lyuci va̱ A̱sula̱ na̱ ma̱za̱nga̱,</para>
  <para style="q1" vid="PSA 46:4">nu uba̱ta̱ wa akiza a na</para>
  <para style="q2" vid="PSA 46:4">Mogono ma̱ A̱sula̱ ma̱ ri nden.<verse eid="PSA 46:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5" />A̱sula̱ a̱ ta̱ pe e memere ma̱ lyuci'i,</para>
  <para style="q2" vid="PSA 46:5">aa gura kototo yi shi.</para>
  <para style="q1" vid="PSA 46:5">A̱sula̱ a ta kamba yi</para>
  <para style="q2" vid="PSA 46:5">nu usana u tawa.<verse eid="PSA 46:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6" />Nɗa mu uwwa ta̱ wovon,</para>
  <para style="q2" vid="PSA 46:6">tsugono tsu da'wan ta̱ fo.</para>
  <para style="q1" vid="PSA 46:6">Ana A̱sula̱ a yuwain tsata,</para>
  <para style="q2" vid="PSA 46:6">uvaɗi wu jeruwe ta̱.<verse eid="PSA 46:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7" />A̱sulazuva o oɓolo a̱ a̱soja a zuva</para>
  <para style="q2" vid="PSA 46:7">o to oɓolo na̱ a̱tsu,</para>
  <para style="q1" vid="PSA 46:7">A̱sula̱ a Yakubu a̱yi ɗa</para>
  <para style="q2" vid="PSA 46:7">uba̱ta̱ wu upa'atan wu ucira u tsu.<verse eid="PSA 46:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8" />Ta̱wa̱i ye ene ili i na A̱sulazuva a yuwain,</para>
  <para style="q2" vid="PSA 46:8">ka̱lyuwa̱i ili ya asalama a na</para>
  <para style="q2" vid="PSA 46:8">u yuwain a̱tsuma̱ o uvaɗi!<verse eid="PSA 46:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9" />Wi isawaton ta̱ uvon o uvaɗi ma̱ɓula̱,</para>
  <para style="q2" vid="PSA 46:9">a kuɗusa tan nu lungususai ibata,</para>
  <para style="q2" vid="PSA 46:9">a̱ kula̱tosu a̱ra̱ga̱ na akina.<verse eid="PSA 46:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10" />A̱vu A̱sula̱ a damma, &lt;&lt;Isawan yi kpen,</para>
  <para style="q2" vid="PSA 46:10">tsura̱ i reve a̱mu ɗa A̱sula̱.</para>
  <para style="q1" vid="PSA 46:10">A ta ca mu tsugbain a̱tsuma̱ a nɗa,</para>
  <para style="q2" vid="PSA 46:10">a ta ca mu tsugbain a̱tsuma̱ o uvaɗi.&gt;&gt;<verse eid="PSA 46:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11" />A̱sulazuva o oɓolo a̱ a̱soja a zuva</para>
  <para style="q2" vid="PSA 46:11">o to oɓolo na̱ a̱tsu,</para>
  <para style="q1" vid="PSA 46:11">A̱sula̱ a Yakubu a̱yi ɗa</para>
  <para style="q2" vid="PSA 46:11">uba̱ta̱ wu upa'atan wu ucira u tsu.<verse eid="PSA 46:11" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" sid="PSA 47" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Wo olobo a Kora. Ica i ɗa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1" />I ɓasa ekere adama a̱ ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 47:1">a̱ɗu nɗa suru,</para>
  <para style="q1" vid="PSA 47:1">i cana ishipa nu ucira</para>
  <para style="q2" vid="PSA 47:1">i cuwa A̱sula̱.<verse eid="PSA 47:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2" />A̱sulazuva za na La'ai Tsugbain,</para>
  <para style="q2" vid="PSA 47:2">ili i wovon ɗa</para>
  <para style="q2" vid="PSA 47:2">a̱yi ɗa mogono ma gbain</para>
  <para style="q2" vid="PSA 47:2">za tsugono tsu uvaɗi suru.<verse eid="PSA 47:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3" />U ca tsu ta̱ ulyuwu wa aci e ekere a nɗa,</para>
  <para style="q2" vid="PSA 47:3">u zuwa ta̱ tsu yuwan tsugono tsa nɗa.<verse eid="PSA 47:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4" />U ɗangulaa tsu ta̱ iɗa ya agadu,</para>
  <para style="q2" vid="PSA 47:4">iɗa ya afalu ya ama a̱ yi,</para>
  <para style="q2" vid="PSA 47:4">ugundo wa Yakubu, vuma na u cigai.<verse eid="PSA 47:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5" />A̱sula̱ a̱ ka̱ra̱ ta̱ tyo zuva</para>
  <para style="q2" vid="PSA 47:5">o ootogu o tsugono tsa̱ a̱ yi,</para>
  <para style="q2" vid="PSA 47:5">a̱vu a yuwan yisaali i ma̱za̱nga̱,</para>
  <para style="q1" vid="PSA 47:5">nu wivulu wa avana,</para>
  <para style="q2" vid="PSA 47:5">a mantsa ma na A̱sulazuva a̱ ri a̱ ka̱ra̱.<verse eid="PSA 47:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6" />I canaa A̱sula̱ ishipa yi ica,</para>
  <para style="q2" vid="PSA 47:6">i canaa mogono ma̱ tsu ishipa yi ica.<verse eid="PSA 47:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7" />A̱sula̱ a ɗa mogono mo o uvaɗi suru,</para>
  <para style="q2" vid="PSA 47:7">i canaa yi ishipa yi ica.<verse eid="PSA 47:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8" />A̱sula̱ a̱ ta̱ nden o ootogu</para>
  <para style="q2" vid="PSA 47:8">o tsugono tsa akiza a̱ yi</para>
  <para style="q2" vid="PSA 47:8">a yuwusan tsugono tsu nɗa.<verse eid="PSA 47:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9" />Azagbain a nɗa o ɓoloto ta̱,</para>
  <para style="q2" vid="PSA 47:9">o ɓoloto ta̱ oɓolo na̱ a̱tsu.</para>
  <para style="q2" vid="PSA 47:9">A̱tsu a ama a̱ A̱sula̱ a Ibrahim,</para>
  <para style="q1" vid="PSA 47:9">adama a na ngono mu uvaɗi suru</para>
  <para style="q2" vid="PSA 47:9">a̱za̱ a̱ A̱sula̱ a ɗa,</para>
  <para style="q2" vid="PSA 47:9">A̱sula̱ a na aa ca tsugbain lon.<verse eid="PSA 47:9" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" sid="PSA 48" />
  <para style="d">Ishipa i ɗa. Ica yo olobo a Kora.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1" />A̱sulazuva zagbain ɗa,</para>
  <para style="q2" vid="PSA 48:1">wu ntsaa ta̱ a ca yi tsugbain lon,</para>
  <para style="q2" vid="PSA 48:1">a̱ lyuci va̱ A̱sula̱ a̱ tsu,</para>
  <para style="q1" vid="PSA 48:1">a masasan ma akiza a̱ yi.<verse eid="PSA 48:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2" />Masasan ma Sihiyona ma̱ tu uga'an,</para>
  <para style="q2" vid="PSA 48:2">nu ulobonu wa̱ a̱ka̱nla̱ uba̱ta̱ wa̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 48:2">lyuci gbain mo Mogono ma gbain,</para>
  <para style="q1" vid="PSA 48:2">za na tsu ta̱wa̱a̱ na̱</para>
  <para style="q2" vid="PSA 48:2">ma̱za̱nga̱ o uvaɗi suru.<verse eid="PSA 48:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3" />A̱sula̱ a̱ ta̱ pe</para>
  <para style="q2" vid="PSA 48:3">a̱ lyuci gbain na ri nu ukari,</para>
  <para style="q1" vid="PSA 48:3">adama a na a̱yi na aciya̱yi</para>
  <para style="q2" vid="PSA 48:3">uba̱ta̱ wu upa'atan u ɗa.<verse eid="PSA 48:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4" />A̱yi ɗa nda ngono n ɓoloi aci,</para>
  <para style="q2" vid="PSA 48:4">adama a̱ riya̱a̱ masasan ma Sihiyona nu uvon.<verse eid="PSA 48:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5" />Amma ana e ene niyi,</para>
  <para style="q2" vid="PSA 48:5">a̱vu a uwa asalama</para>
  <para style="q1" vid="PSA 48:5">a uwwa wovon,</para>
  <para style="q2" vid="PSA 48:5">ɗaɗa a sumai.<verse eid="PSA 48:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6" />Meje'en ma̱ lipu ma̱ guza̱ le ta̱,</para>
  <para style="q2" vid="PSA 48:6">reve o sowo a̱tsuma̱lima̱</para>
  <para style="q2" vid="PSA 48:6">tsa ka na ri a gan limatan.<verse eid="PSA 48:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7" />Tsu upepu wa asana,</para>
  <para style="q2" vid="PSA 48:7">za na tsu lungusa̱</para>
  <para style="q2" vid="PSA 48:7">antsun a Tarshishi.<verse eid="PSA 48:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8" />Cine tsu uwwai,</para>
  <para style="q2" vid="PSA 48:8">ne ɗa tse enei,</para>
  <para style="q1" vid="PSA 48:8">a̱ lyuci va̱ A̱sulazuva o oɓolo a̱ a̱soja a zuva,</para>
  <para style="q2" vid="PSA 48:8">a̱ lyuci va̱ A̱sula̱ a̱ tsu,</para>
  <para style="q2" vid="PSA 48:8">za na A̱sula̱ e geshe yi hali hali.<verse eid="PSA 48:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9" />A̱sula̱, a̱tsuma̱ A̱a̱'isamapaɗa a̱ wu,</para>
  <para style="q2" vid="PSA 48:9">tsu ta yuwusan majiyan</para>
  <para style="q2" vid="PSA 48:9">me icigi ya̱ wu i na i tsu vadala shi.<verse eid="PSA 48:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10" />Ama a ta yuwusan wu ica uba̱ta̱ suru,</para>
  <para style="q2" vid="PSA 48:10">ala a̱ wu a baza ta̱ o uvaɗi suru</para>
  <para style="q2" vid="PSA 48:10">vu ta yuwusan tsugono na̱ a̱ɓula̱.<verse eid="PSA 48:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11" />Lyawa Masasan ma̱ Sihiyona</para>
  <para style="q2" vid="PSA 48:11">ma yuwan ma̱za̱nga̱,</para>
  <para style="q1" vid="PSA 48:11">mulyuci ma Yahuda n yuwan mere,</para>
  <para style="q2" vid="PSA 48:11">adama o uge'etosu wa̱ wu.<verse eid="PSA 48:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12" />'Ya̱wa̱i i ka̱lyuwa̱ Sihiyona,</para>
  <para style="q2" vid="PSA 48:12">i ka̱nda̱ruwa̱ yi,</para>
  <para style="q2" vid="PSA 48:12">i kece saa vu uga'an va̱ yi.<verse eid="PSA 48:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13" />I ka̱lyuwa̱ ɓaɓu vu ucira va̱ yi,</para>
  <para style="q2" vid="PSA 48:13">i ka̱lyuwa̱ waru kari va̱ yi,</para>
  <para style="q2" vid="PSA 48:13">adama i tsura̱ ili i na ya damma limatan ve elime.<verse eid="PSA 48:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14" />Adama a na A̱sula̱ a nda</para>
  <para style="q2" vid="PSA 48:14">A̱sula̱ a tsu a ɗa hali hali,</para>
  <para style="q2" vid="PSA 48:14">u to ronoo tsu aaɗanga hali a̱ tyo o ukosu.<verse eid="PSA 48:14" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" sid="PSA 49" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Wo olobo a Kora. Ica i ɗa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1" />Uwwai nda,</para>
  <para style="q2" vid="PSA 49:1">a̱ɗu ama suru,</para>
  <para style="q1" vid="PSA 49:1">zuwai atsuvu,</para>
  <para style="q2" vid="PSA 49:1">a̱ɗu na i ri nden</para>
  <para style="q2" vid="PSA 49:1">a̱tsuma̱ o uvaɗi.<verse eid="PSA 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2" />Zagbain na̱ mawun suru,</para>
  <para style="q2" vid="PSA 49:2">za vu utsuru na̱ za vu ulambu suru.<verse eid="PSA 49:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3" />Una̱ u va̱ u ta yuwan</para>
  <para style="q2" vid="PSA 49:3">adanshi o ugbozu,</para>
  <para style="q1" vid="PSA 49:3">majiyan mo okolo ma̱ va̱</para>
  <para style="q2" vid="PSA 49:3">u ta̱ tapu nu urevu.<verse eid="PSA 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4" />N ta zuwa ugbozu u va̱</para>
  <para style="q2" vid="PSA 49:4">a danshi o udammu,</para>
  <para style="q1" vid="PSA 49:4">n cuɗuwa urevu wa̱ yi</para>
  <para style="q2" vid="PSA 49:4">mantsa ma na ma taɗasa kumburu.<verse eid="PSA 49:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5" />Adama a̱ nye a ɗa</para>
  <para style="q2" vid="PSA 49:5">maa uwwa wovon a rana meleshe,</para>
  <para style="q1" vid="PSA 49:5">a mantsa ma na a̱za̱ e iwuya</para>
  <para style="q2" vid="PSA 49:5">a̱ ka̱nda̱ruwa̱ numu,<verse eid="PSA 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6" />aza a na a zuwai ucira</para>
  <para style="q2" vid="PSA 49:6">o utsuru u le,</para>
  <para style="q1" vid="PSA 49:6">aza a na a yuwusan uvaɗu</para>
  <para style="q2" vid="PSA 49:6">adama o utsuru wa̱ a̱bunda̱ u le?<verse eid="PSA 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7" />Amayun, babu vuma na a gura</para>
  <para style="q2" vid="PSA 49:7">tsupa wuma o una̱ u vuma ro,</para>
  <para style="q1" vid="PSA 49:7">ko u gura tsupa A̱sula̱</para>
  <para style="q2" vid="PSA 49:7">adama a wuma wa̱ yi.<verse eid="PSA 49:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8" />Adama a na ikebe ya atsupu</para>
  <para style="q2" vid="PSA 49:8">a wuma u vuma n ri kece shi,</para>
  <para style="q1" vid="PSA 49:8">ili i na wa tsupa suru</para>
  <para style="q2" vid="PSA 49:8">wa rawa shi ko ke'en.<verse eid="PSA 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9" />Adama u da̱na̱ lo hali hali,</para>
  <para style="q2" vid="PSA 49:9">ko u putsayi na wa̱ kuwa̱.<verse eid="PSA 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10" />U tsu zuwa ta̱ a̱za̱ o ugbozu a̱ kuwa̱,</para>
  <para style="q2" vid="PSA 49:10">no olo na ama e pere fo,</para>
  <para style="q1" vid="PSA 49:10">a̱ ta̱ kuwa̱ a lyawaa</para>
  <para style="q2" vid="PSA 49:10">ozo o ro utsuru u le.<verse eid="PSA 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11" />Ason e le a ɗa</para>
  <para style="q2" vid="PSA 49:11">a̱a̱ da̱na̱ 'wa le hali hali,</para>
  <para style="q2" vid="PSA 49:11">ɗe ɗa a̱ da̱na̱ mantsa suru,</para>
  <para style="q1" vid="PSA 49:11">ko na wo o'woi a ca ta̱</para>
  <para style="q2" vid="PSA 49:11">atsusa e le ala le.<verse eid="PSA 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12" />Tsugbain tsa vuma</para>
  <para style="q2" vid="PSA 49:12">tsa putsa yi na wa̱ kuwa̱ shi,</para>
  <para style="q2" vid="PSA 49:12">u ta̱ kuwa̱ tsa nama.<verse eid="PSA 49:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13" />Ne ɗa ukosu wa aza a na</para>
  <para style="q2" vid="PSA 49:13">a zuwaa yi aciyele ucira wo o'wo,</para>
  <para style="q1" vid="PSA 49:13">nu ukosu wa aza a na a̱ cuwa̱in</para>
  <para style="q2" vid="PSA 49:13">nu utsuru u le.<verse eid="PSA 49:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14" />O to ronoso le tsi ikyon</para>
  <para style="q2" vid="PSA 49:14">a̱ tyo uba̱ta̱ wu nden wa̱ a̱kwa̱kwa̱,</para>
  <para style="q2" vid="PSA 49:14">ukwa̱ u to o'wo za va aguɓa e le.</para>
  <para style="q1" vid="PSA 49:14">Nu usana a̱za̱ a̱ a̱ɓula̱ a ta yuwan</para>
  <para style="q2" vid="PSA 49:14">tsugbain a aci e le.</para>
  <para style="q1" vid="PSA 49:14">Lipu le ta shama a̱tsuma̱ a aason,</para>
  <para style="q2" vid="PSA 49:14">uba̱ta̱ wu nden wa̱ a̱kwa̱kwa̱ u ɗa</para>
  <para style="q2" vid="PSA 49:14">wo o'wo 'wa le.<verse eid="PSA 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15" />Amma A̱sula̱ a ta tsupaa wuma u va̱,</para>
  <para style="q2" vid="PSA 49:15">diga e ekere o ukwa̱</para>
  <para style="q1" vid="PSA 49:15">amayun u ta tara mu</para>
  <para style="q2" vid="PSA 49:15">a̱ tyo uba̱ta̱ wa̱ yi.<verse eid="PSA 49:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16" />Vu uwa a̱tsumola̱ngu</para>
  <para style="q2" vid="PSA 49:16">na̱ vuma o'wo za vu utsuru wan,</para>
  <para style="q2" vid="PSA 49:16">ko nu utsuru wu u'wa wa̱ yi wa̱ da̱shishi,<verse eid="PSA 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17" />adama a na nu u kuwa̱</para>
  <para style="q2" vid="PSA 49:17">wa̱ ka̱ra̱ ni ili shi,</para>
  <para style="q1" vid="PSA 49:17">utsuru wa̱ yi wo toni yi</para>
  <para style="q2" vid="PSA 49:17">a̱ tyo a aason shi.<verse eid="PSA 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18" />Ko na̱ shi u tara aciya̱yi</para>
  <para style="q2" vid="PSA 49:18">za va aba'un,</para>
  <para style="q1" vid="PSA 49:18">ko ama a cuwa yi</para>
  <para style="q2" vid="PSA 49:18">nu u lyuwa aci,<verse eid="PSA 49:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19" />na̱ ne suru u ta cina</para>
  <para style="q2" vid="PSA 49:19">nkaya ma̱ yi n na n kuwa̱i ɗe,</para>
  <para style="q1" vid="PSA 49:19">aza a na a̱a̱ da̱shi e ene</para>
  <para style="q2" vid="PSA 49:19">ekan waru shi.<verse eid="PSA 49:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20" />Tsugbain tsa vuma</para>
  <para style="q2" vid="PSA 49:20">tsa putsa yi naa wa̱ kuwa̱ shi,</para>
  <para style="q2" vid="PSA 49:20">u ta̱ kuwa̱ tsa nama.<verse eid="PSA 49:20" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" sid="PSA 50" />
  <para style="d">Ica ya Asaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1" />A̱sulazuva, A̱sula̱ a Tsugbain</para>
  <para style="q2" vid="PSA 50:1">a yuwan ta̱ adanshi,</para>
  <para style="q1" vid="PSA 50:1">u ta̱ e ɗesu uvaɗi suru</para>
  <para style="q2" vid="PSA 50:1">diga asana a̱ tyo a̱livu.<verse eid="PSA 50:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2" />A̱sula̱ a̱ te ikanasa diga Sihiyona,</para>
  <para style="q2" vid="PSA 50:2">lyuci vu ulobonu lon,<verse eid="PSA 50:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3" />A̱sula̱ a̱tsu a̱ ta̱ lo a̱ ta̱wa̱</para>
  <para style="q2" vid="PSA 50:3">wa̱a̱ rungwa̱ kpen shi,</para>
  <para style="q1" vid="PSA 50:3">akina o ukula̱tosu a̱ ta̱ elime yi,</para>
  <para style="q2" vid="PSA 50:3">a̱ba̱jini a̱ wunla̱ a̱ tu uka̱nda̱ruwu na̱ a̱yi.<verse eid="PSA 50:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4" />U ta̱ ɗesu zuva ni iɗa o'wo esu yi,</para>
  <para style="q2" vid="PSA 50:4">ene cine wa̱ ge'eto ama a̱yi.<verse eid="PSA 50:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5" />Adansa,</para>
  <para style="q2" vid="PSA 50:5">&lt;&lt;Ɓolotowo numu a̱za̱ a̱ a̱ɓula̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 50:5">aza a na a yuwain akucunu na̱ a̱mu</para>
  <para style="q2" vid="PSA 50:5">o una̱ wu ucasu u kucci.&gt;&gt;<verse eid="PSA 50:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6" />Zuva ta yuwusan adanshi a̱ a̱ɓula̱ a̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 50:6">adama a na a̱yi na aciya̱yi</para>
  <para style="q2" vid="PSA 50:6">a̱yi ɗa za vu uge'etosu.<verse eid="PSA 50:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7" />&lt;&lt;Uwwai, a̱ɗu ama a̱ va̱,</para>
  <para style="q2" vid="PSA 50:7">n ta yuwan adanshi a̱ ɗu Isra'ila,</para>
  <para style="q1" vid="PSA 50:7">n ta yuwan adanshi</para>
  <para style="q2" vid="PSA 50:7">a na i ri nu unusu,</para>
  <para style="q2" vid="PSA 50:7">A̱mu ɗa A̱sula̱, A̱sula̱ a̱ ɗu.<verse eid="PSA 50:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8" />M ɓara ɗu adama a̱ kucci ɗu shi,</para>
  <para style="q2" vid="PSA 50:8">ko kucci vu ukula̱tosu ɗu,</para>
  <para style="q2" vid="PSA 50:8">na ya yuwusan mu kuci shi.<verse eid="PSA 50:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9" />N ciga oogono e inan</para>
  <para style="q2" vid="PSA 50:9">diga a 'wa ɗu shi,</para>
  <para style="q1" vid="PSA 50:9">ko mgbele diga</para>
  <para style="q2" vid="PSA 50:9">iliyamunga i ɗu shi.<verse eid="PSA 50:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10" />Adama a na inama yu una suru</para>
  <para style="q2" vid="PSA 50:10">a̱za̱ a̱ va̱ a ɗa,</para>
  <para style="q1" vid="PSA 50:10">ni inan ya̱ a̱bunda̱</para>
  <para style="q2" vid="PSA 50:10">i na i ri a agaɗi.<verse eid="PSA 50:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11" />Nnunu n na n ri</para>
  <para style="q2" vid="PSA 50:11">a nsasan suru,</para>
  <para style="q1" vid="PSA 50:11">ni ili i wuma i na i ri e iɗa</para>
  <para style="q2" vid="PSA 50:11">a̱za̱ a̱ va̱ a ɗa suru.<verse eid="PSA 50:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12" />Ko na̱ n shi a uwwusa ambulu,</para>
  <para style="q2" vid="PSA 50:12">maa pati ɗu ilyalya shi,</para>
  <para style="q1" vid="PSA 50:12">adama a na uvaɗi,</para>
  <para style="q2" vid="PSA 50:12">ni ili i na i ri pe suru za va̱ ɗa.<verse eid="PSA 50:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13" />N tsu tama ta̱ nama vo ogono e inan ɗa?</para>
  <para style="q2" vid="PSA 50:13">Ko n tsu sowo ta̱ mpasa mu mgbele?<verse eid="PSA 50:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14" />I ta̱wa̱a̱ A̱sula̱ na̱ kucci</para>
  <para style="q2" vid="PSA 50:14">vu ugodyusho ɗu,</para>
  <para style="q1" vid="PSA 50:14">i shiton nzuwulai n ɗu</para>
  <para style="q2" vid="PSA 50:14">a̱ tyo uba̱ta̱ wa̱ A̱sulazuva Zagbain.<verse eid="PSA 50:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15" />I ɗe mu o urana wa̱ a̱tsuma̱lima̱,</para>
  <para style="q2" vid="PSA 50:15">n ta wawa ɗu,</para>
  <para style="q2" vid="PSA 50:15">reve gba i ca mu tsugbain.&gt;&gt;<verse eid="PSA 50:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 50:16" />Amma A̱sula̱ a damma ta̱</para>
  <para style="q2" vid="PSA 50:16">a̱za̱ e iwuya,</para>
  <para style="q1" vid="PSA 50:16">&lt;&lt;Zane ɗa ca nɗu ucira u na</para>
  <para style="q2" vid="PSA 50:16">ya̱a̱ da̱na̱ a̱ ɗesu wila̱ u va̱?</para>
  <para style="q1" vid="PSA 50:16">Adama a̱ nye ya yuwan</para>
  <para style="q2" vid="PSA 50:16">adanshi a nzuwulai n va̱?<verse eid="PSA 50:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17" />I 'yuwan ta̱ tsuɓari tsa̱ va̱,</para>
  <para style="q2" vid="PSA 50:17">a̱vu i vadalaa wila̱ u va̱ ucina̱.<verse eid="PSA 50:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18" />Na̱ ye ene vivu,</para>
  <para style="q2" vid="PSA 50:18">i tsu ɓolo ta̱ aci na̱ a̱yi,</para>
  <para style="q2" vid="PSA 50:18">i tsu ɓolo ta̱ aci na̱ a̱za̱ a̱ tsipere.<verse eid="PSA 50:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19" />I tsu da̱na̱ ta̱ adanshi e iwuya nu una̱ u ɗu,</para>
  <para style="q2" vid="PSA 50:19">elentsu a̱ ɗu waru tapu ne epen.<verse eid="PSA 50:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20" />I tsu yuwusan ta̱ adanshi</para>
  <para style="q2" vid="PSA 50:20">a vama a aci</para>
  <para style="q2" vid="PSA 50:20">a̱za̱ ɗu babu lyawa,</para>
  <para style="q2" vid="PSA 50:20">a̱vu i lungusa̱ aala a mmaci n ɗu.<verse eid="PSA 50:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21" />Ili i na i yuwain ɗa ndolo</para>
  <para style="q2" vid="PSA 50:21">a̱mu gba kpaku,</para>
  <para style="q2" vid="PSA 50:21">i yuwusan ta̱ majiyan n ta̱ tsa̱ ɗu.</para>
  <para style="q1" vid="PSA 50:21">Amma gogo n ta ɓara ɗu,</para>
  <para style="q2" vid="PSA 50:21">n damma ɗu nusu ɗu</para>
  <para style="q2" vid="PSA 50:21">a̱ ma̱ka̱ka̱n ma̱ ɗu.<verse eid="PSA 50:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22" />Uwwai nda,</para>
  <para style="q2" vid="PSA 50:22">a̱ɗu na yi icinai na̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 50:22">na̱ ne ɗa shi n ta kara ɗu mukari mukari,</para>
  <para style="q2" vid="PSA 50:22">babu za na a wawa ɗu.<verse eid="PSA 50:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23" />Za na ta̱wa̱i na̱ kucci vu ugodyusho suru</para>
  <para style="q2" vid="PSA 50:23">u ca mu ta̱ tsugbain,</para>
  <para style="q1" vid="PSA 50:23">waru u foɓo ta̱ ure</para>
  <para style="q2" vid="PSA 50:23">tsa̱ra̱ n roco yi</para>
  <para style="q2" vid="PSA 50:23">iwawi ya̱ A̱sula̱.&gt;&gt;<verse eid="PSA 50:23" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" sid="PSA 51" />
  <para style="s">Mesun me e izami i gafura</para>
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya: Ica ya̱ Da̱wuda. A mantsa ma na Natan vumava̱sula̱ ta̱wa̱i uba̱ta̱ wa̱ Da̱wuda cina Da̱wuda yuwan tsipere na̱ Bashaba.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1" />A̱sula̱, vee ene iliyali i va̱,</para>
  <para style="q2" vid="PSA 51:1">adama e icigi ya̱ wu i na i tsu vadala shi.</para>
  <para style="q1" vid="PSA 51:1">Vu tasa nusu va̱,</para>
  <para style="q2" vid="PSA 51:1">adama a̱bunda̱ e iliyali ya̱ wu.<verse eid="PSA 51:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2" />Vu za̱'wa̱ nusu va̱ suru,</para>
  <para style="q2" vid="PSA 51:2">vu ka̱mba̱to mu cece</para>
  <para style="q2" vid="PSA 51:2">diga o unusu u va̱!<verse eid="PSA 51:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3" />Adama a na n tu urevu na̱ nusu va̱,</para>
  <para style="q2" vid="PSA 51:3">waru unusu u va̱ u ta̱</para>
  <para style="q2" vid="PSA 51:3">a̱ ma̱ka̱ka̱n ma̱ va̱ kuci.<verse eid="PSA 51:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4" />A̱vu ɗa goon n yuwayin unusu,</para>
  <para style="q2" vid="PSA 51:4">n yuwan ta̱ iwuya e esu a̱ wu,</para>
  <para style="q1" vid="PSA 51:4">na wo o'woi vu tsu yuwan ta̱ mejege o uge'etosu wa̱ wu,</para>
  <para style="q2" vid="PSA 51:4">ugana u na vu paɗai wuntsaa ta̱.<verse eid="PSA 51:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5" />Amayun, a̱mu za vu unusu ɗa,</para>
  <para style="q2" vid="PSA 51:5">diga a mantsa ma na</para>
  <para style="q2" vid="PSA 51:5">mma va̱ tarai a̱a̱tsuma̱ a̱ va̱.</para>
  <para style="q1" vid="PSA 51:5">Amayun, a̱mu za vu unusu ɗa,</para>
  <para style="q2" vid="PSA 51:5">diga urana u na a matsan numu.<verse eid="PSA 51:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6" />Amayun vu ciga ta̱ mejege pe a̱a̱tsuma̱ a̱ va̱.</para>
  <para style="q2" vid="PSA 51:6">Vu rito mu ugbozu pe a̱a̱tsuma̱ a̱ va̱.<verse eid="PSA 51:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7" />Vu za̱'wa̱ mu na̱ hiso<note caller="+" style="f"><char style="fr" closed="false">51:7 </char><char style="fq" closed="false">hiso </char><char style="ft" closed="false">A̱vu'un o ro a ɗa e iɗa ya Isra'ila na aa yuwusan ulinga na̱ a̱yi, a mantsa mo ro nna̱ mini ma̱ lukuta̱ adama u kira̱. Mantsa mo ro waru a̱ tsu luɓa̱ yi ta̱ adama a tama opopofu na̱ a̱yi, waru a̱guma̱ a ɗa. </char></note>,</para>
  <para style="q2" vid="PSA 51:7">n to o'wo cece!</para>
  <para style="q1" vid="PSA 51:7">Vu za̱'wa̱ mu diga o unusu u va̱,</para>
  <para style="q2" vid="PSA 51:7">reve mo o'wo puwu hali n la'a tsikilu.<verse eid="PSA 51:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8" />Vu zuwa mu n yuwan ma̱za̱nga̱ na̱ mere,</para>
  <para style="q2" vid="PSA 51:8">vu zuwa etele a na vu kuɗai a yuwan ma̱za̱nga̱.<verse eid="PSA 51:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9" />Vu tawa nusu va̱,</para>
  <para style="q2" vid="PSA 51:9">reve vu tasa nusu va̱ suru.<verse eid="PSA 51:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10" />A̱sula̱, vu rumaa mu okolo e cece,</para>
  <para style="q2" vid="PSA 51:10">a̱vu vu zuwaa mu wuma u sa'avu u tsutoni.<verse eid="PSA 51:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11" />She vu gba̱ra̱ mu a̱ ma̱ka̱ka̱n ma̱ wu wan,</para>
  <para style="q2" vid="PSA 51:11">ko vu tawa Ruhu va Akiza a̱ wu a̱a̱tsuma̱ a̱ va̱.<verse eid="PSA 51:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12" />Vu ka̱mbuwa̱a̱ mu na̱ ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 51:12">cine ushi a mantsa ma na vu wawa numu,</para>
  <para style="q1" vid="PSA 51:12">a̱vu vu ca mu ruhu tsutoni</para>
  <para style="q2" vid="PSA 51:12">na a ɓana mu.<verse eid="PSA 51:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13" />Ne ɗa moo rito a̱za̱ o unusu re va̱ wu,</para>
  <para style="q2" vid="PSA 51:13">waru a̱za̱ o unusu a̱ ta̱ ka̱mba̱ uba̱ta̱ wa̱ wu.<verse eid="PSA 51:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14" />A̱sula̱ vu wawa mu</para>
  <para style="q2" vid="PSA 51:14">diga o unusu u wocosu wu mpasa.</para>
  <para style="q1" vid="PSA 51:14">A̱sula̱ e iwawi i va̱,</para>
  <para style="q2" vid="PSA 51:14">eelentsu a̱ va̱ aa ta cana a̱ɓula̱ a̱ wu.<verse eid="PSA 51:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15" />A̱sulazuva kpa̱tu'wa̱ una̱ u va̱,</para>
  <para style="q2" vid="PSA 51:15">lyawa una̱ u va̱ u yuwaan wu ica.<verse eid="PSA 51:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16" />Vaa yuwan ma̱za̱nga̱ na̱ kucci shi,</para>
  <para style="q2" vid="PSA 51:16">na̱ ne ɗa shi n shi ta̱ a̱ ta̱wa̱a̱ wu ne ele,</para>
  <para style="q1" vid="PSA 51:16">nna̱ n ta̱wa̱a̱ wu na̱ kucci vu ukula̱tosu</para>
  <para style="q2" vid="PSA 51:16">va̱a̱ usu le shi.<verse eid="PSA 51:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17" />A̱sula̱, kucci va amayun e ekere a̱ wu,</para>
  <para style="q2" vid="PSA 51:17">a̱yi ɗa okolo a sa'ani,</para>
  <para style="q1" vid="PSA 51:17">A̱sula̱ va 'yuwan okolo a sa'ani</para>
  <para style="q2" vid="PSA 51:17">a na a vadalai shi.<verse eid="PSA 51:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18" />Vu yuwaan Sihiyona</para>
  <para style="q2" vid="PSA 51:18">isa'ani cine vu cigai,</para>
  <para style="q2" vid="PSA 51:18">vu suwisa kari va̱ Urishelima.<verse eid="PSA 51:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19" />Ne ɗa va uwwa uyo'o u kucci va̱ a̱ɓula̱,</para>
  <para style="q2" vid="PSA 51:19">na̱ kucci vu ukula̱tosu suru</para>
  <para style="q1" vid="PSA 51:19">a̱vu a ca kucci vo ogono e inan</para>
  <para style="q2" vid="PSA 51:19">a masa'a ma̱ wu.<verse eid="PSA 51:19" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" sid="PSA 52" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. A cana yi nu uɗyo wa̱ Da̱wuda. A mantsa ma na Dowe vuma va̱ Edom ka̱ra̱i a̱ tyo ya Shawulu a̱vu u damma yi, &lt;&lt;Da̱wuda ka̱ra̱ ta̱ a̱ tyo o u'wa wa Ahimele.&gt;&gt;</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1" />Adama a̱ nye va yuwusan</para>
  <para style="q2" vid="PSA 52:1">uvaɗu ni iwuya,</para>
  <para style="q2" vid="PSA 52:1">a̱vu vuma gbain?</para>
  <para style="q1" vid="PSA 52:1">Adama a̱ nye vaa yuwusan</para>
  <para style="q2" vid="PSA 52:1">uvaɗu urana ma̱ɓula̱,</para>
  <para style="q1" vid="PSA 52:1">a̱vu na vaa yuwusan</para>
  <para style="q2" vid="PSA 52:1">ili i wono elime a̱ A̱sula̱?<verse eid="PSA 52:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2" />Eelentsu a̱ wu</para>
  <para style="q2" vid="PSA 52:2">a̱ ta̱ e ifoɓi yi iwuya,</para>
  <para style="q1" vid="PSA 52:2">cine vu revei utanu u sa'avu,</para>
  <para style="q2" vid="PSA 52:2">a̱vu na vaa yuwusan epen.<verse eid="PSA 52:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3" />Vu la'a ta̱ ciga iwuya</para>
  <para style="q2" vid="PSA 52:3">ula'awu ni isa'ani,</para>
  <para style="q2" vid="PSA 52:3">ne epen o una̱ wa amayun.<char style="qs">Wivuwun</char><verse eid="PSA 52:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4" />Vu la'a ta̱ ciga idanshi yu ukototosu,</para>
  <para style="q2" vid="PSA 52:4">a̱vu e eelentsu a̱ wulumu!<verse eid="PSA 52:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5" />Adama o ndolo A̱sula̱,</para>
  <para style="q2" vid="PSA 52:5">a̱ ta̱ o kototo wu suru suru.</para>
  <para style="q1" vid="PSA 52:5">U te reme wu</para>
  <para style="q2" vid="PSA 52:5">a̱vu wu kara wu</para>
  <para style="q2" vid="PSA 52:5">diga o oogodo a̱ wu,</para>
  <para style="q1" vid="PSA 52:5">u ta tawa wu e iɗa</para>
  <para style="q2" vid="PSA 52:5">ya aza a wuma.<char style="qs">Wivuwun</char><verse eid="PSA 52:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6" />Na̱ a̱za̱ a̱ a̱ɓula̱ e ene</para>
  <para style="q2" vid="PSA 52:6">ili i wovon i nda</para>
  <para style="q1" vid="PSA 52:6">O to zo'oso yi,</para>
  <para style="q2" vid="PSA 52:6">a dansa,<verse eid="PSA 52:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7" />&lt;&lt;Apa vuma na kuɗa̱i,</para>
  <para style="q2" vid="PSA 52:7">na wa zuwa A̱sula̱</para>
  <para style="q2" vid="PSA 52:7">wo o'wo uba̱ta̱ wu upa'atan</para>
  <para style="q2" vid="PSA 52:7">wu ucira wa̱ yi.</para>
  <para style="q1" vid="PSA 52:7">Amma a̱vu u zuwa</para>
  <para style="q2" vid="PSA 52:7">ucira o utsuru</para>
  <para style="q2" vid="PSA 52:7">wa̱ a̱bunda̱ a̱ yi,</para>
  <para style="q1" vid="PSA 52:7">a yuwusan ukadu</para>
  <para style="q2" vid="PSA 52:7">o kototosu ozo o ro!&gt;&gt;<verse eid="PSA 52:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8" />Amma a̱mu n ta̱ tsu uɗanga u zetun wu uta̱nu</para>
  <para style="q2" vid="PSA 52:8">u na wa balasa o u'wa wa̱ A̱sula̱,</para>
  <para style="q1" vid="PSA 52:8">n zuwa ta̱ ucira u va̱ uba̱ta̱ wi icigi ya̱ A̱sula̱</para>
  <para style="q2" vid="PSA 52:8">i na i tsu vadala shi</para>
  <para style="q2" vid="PSA 52:8">hali hali hali.<verse eid="PSA 52:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9" />N ta cuwa wu hali hali</para>
  <para style="q2" vid="PSA 52:9">adama e ili i na vu yuwain,</para>
  <para style="q1" vid="PSA 52:9">a ala a̱ wu a ɗa maa zuwa okolo,</para>
  <para style="q2" vid="PSA 52:9">adama a na ala a̱ wu a̱ tu ulobonu.</para>
  <para style="q1" vid="PSA 52:9">N ta cuwa wu elime</para>
  <para style="q2" vid="PSA 52:9">a ama a akiza a̱ wu.<verse eid="PSA 52:9" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" sid="PSA 53" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. A cana yi nu uɗyo wa̱ Da̱wuda. O una̱ wa Mahala.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1" />Ulo u tsu damma ta̱ o okolo a̱ yi,</para>
  <para style="q2" vid="PSA 53:1">&lt;&lt;Babu A̱sula̱.&gt;&gt;</para>
  <para style="q1" vid="PSA 53:1">A̱ la̱nga̱ ta̱ suru nle,</para>
  <para style="q2" vid="PSA 53:1">re le a̱za̱ e idaba ɗa.</para>
  <para style="q2" vid="PSA 53:1">Babu zana aa yuwusan ili ya̱ a̱ɓula̱.<verse eid="PSA 53:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2" />A̱sula̱ a̱ ka̱lyuwa̱ ta̱ vaɗilima̱ diga zuva</para>
  <para style="q2" vid="PSA 53:2">tsa̱ra̱ we ene ko a̱ ta̱ tsura̱</para>
  <para style="q2" vid="PSA 53:2">aza a na a̱ ri nu urevu,</para>
  <para style="q2" vid="PSA 53:2">aza a na a zama A̱sula̱.<verse eid="PSA 53:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3" />Za suru lyawa ta̱ ure,</para>
  <para style="q2" vid="PSA 53:3">suru nle o o'wo ta̱ babu a̱ɓula̱.</para>
  <para style="q1" vid="PSA 53:3">Babu vuma na aa yuwusan</para>
  <para style="q2" vid="PSA 53:3">ili yu ulobonu, ko za ta̱.<verse eid="PSA 53:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4" />A̱za̱ e iwuya a yuwan ugbozu shi?</para>
  <para style="q2" vid="PSA 53:4">Aza a na a tamusa ama a̱ va̱</para>
  <para style="q2" vid="PSA 53:4">cine a tsu tamusa opopofu,</para>
  <para style="q2" vid="PSA 53:4">waru e ɗesu A̱sula̱ shi.<verse eid="PSA 53:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5" />Ele ɗa nda o o'woi</para>
  <para style="q2" vid="PSA 53:5">wuda'un adama o wovon,</para>
  <para style="q1" vid="PSA 53:5">ko na wo o'woi babu ili i wovon,</para>
  <para style="q2" vid="PSA 53:5">adama a na A̱sula̱ e bete'we ta̱</para>
  <para style="q2" vid="PSA 53:5">etele aza a na a 'yuwan nuwu,</para>
  <para style="q1" vid="PSA 53:5">a ta uwwa wono,</para>
  <para style="q2" vid="PSA 53:5">adama a na A̱sula̱ a 'yuwan nle.<verse eid="PSA 53:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6" />O'o a damma iwawi i ta̱ ta̱wa̱</para>
  <para style="q2" vid="PSA 53:6">aza a Isra'ila diga Sihiyona!</para>
  <para style="q1" vid="PSA 53:6">Mantsa ma na A̱sula̱</para>
  <para style="q2" vid="PSA 53:6">a̱ ka̱mbuwa̱a̱ ama a̱ yi na aba'un,</para>
  <para style="q1" vid="PSA 53:6">ugundo wa Yakubu u ta yuwan ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 53:6">ama Isra'ila waru a yuwan mere.<verse eid="PSA 53:6" /></para>
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" sid="PSA 54" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. A cana yi uɗyo wa̱ Da̱wuda. A wa'a yi na̱ kumburu. A mantsa ma na ama a Zif a̱ 'ya̱wa̱i uba̱ta̱ wa Shawulu a̱vu a damma, &lt;&lt;A she Da̱wuda ri upa'awun a̱tsuma̱ a̱ tsu shi?&gt;&gt;</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1" />A̱sula̱, vu wawa mu</para>
  <para style="q2" vid="PSA 54:1">nu ucira wa ala a̱ wu,</para>
  <para style="q1" vid="PSA 54:1">vu ka̱mba̱to mu za babu unusu</para>
  <para style="q2" vid="PSA 54:1">nu ucira wa̱ wu.<verse eid="PSA 54:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2" />A̱sula̱, vu uwwa avasa a̱ va̱,</para>
  <para style="q2" vid="PSA 54:2">vu polo atsuvu a̱ wu e</para>
  <para style="q2" vid="PSA 54:2">idanshi yu una̱ i va̱.<verse eid="PSA 54:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3" />Omocin a̱ ta̱ a̱ nla̱ngi na̱ a̱mu,</para>
  <para style="q2" vid="PSA 54:3">aza a na a̱ ri ni iliyali shi a ciga ta̱ o una mu,</para>
  <para style="q2" vid="PSA 54:3">ele aza a na a tarai A̱sula̱ ili shi. <char style="qs">Wivuwun</char><verse eid="PSA 54:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4" />Amayun, A̱sula̱ a ɗa ikambi i va̱,</para>
  <para style="q2" vid="PSA 54:4">A̱sulazuva a ɗa a̱ ri uguzu na̱ mu.<verse eid="PSA 54:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5" />Lyawa iwuya i ka̱mba̱ a aci aza a na</para>
  <para style="q2" vid="PSA 54:5">a yuwusan adanshi a vama a aci a̱ va̱,</para>
  <para style="q2" vid="PSA 54:5">a̱tsuma̱ a̱ɓula̱ a̱ wu vu kototo le.<verse eid="PSA 54:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6" />A̱sulazuva, n ta ca wu</para>
  <para style="q2" vid="PSA 54:6">kucci vu ucigu wo okolo</para>
  <para style="q1" vid="PSA 54:6">n ta cuwa ala a̱ wu,</para>
  <para style="q2" vid="PSA 54:6">adama a na u tu ulobonu.<verse eid="PSA 54:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7" />Adama a na u wawa mu ta̱</para>
  <para style="q2" vid="PSA 54:7">a̱tsuma̱ a̱tsuma̱lima̱ a̱ va̱ suru,</para>
  <para style="q1" vid="PSA 54:7">waru esu a̱ va̱ e ene ta̱ ulyuwu waa aci</para>
  <para style="q2" vid="PSA 54:7">a aci a n'yuwatan n va̱.<verse eid="PSA 54:7" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" sid="PSA 55" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. A cana yi nu uɗyo wa̱ Da̱wuda. A wa'a yi na̱ kumburu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1" />A̱sula̱, vu uwwa avasa a̱ va̱,</para>
  <para style="q2" vid="PSA 55:1">she vu kuɗa̱ a uwwa ipati i va̱ wan.<verse eid="PSA 55:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 55:2" />Vu poloo mu atsuvu, vu usu mu.</para>
  <para style="q1" vid="PSA 55:2">Adama a na addama a̱ va̱</para>
  <para style="q2" vid="PSA 55:2">a zuwa mu ta̱ n kuna̱ ta̱ka̱.<verse eid="PSA 55:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 55:3" />Ugbozu u va̱ u 'yon ta̱</para>
  <para style="q1" vid="PSA 55:3">adama a̱bunda̱ e elemu a n'yuwatan n va̱,</para>
  <para style="q2" vid="PSA 55:3">adama o ule'e wu n'yuwatan.</para>
  <para style="q1" vid="PSA 55:3">Adama a na a̱ tsu ronusoo mu ta̱ addama,</para>
  <para style="q2" vid="PSA 55:3">waru a 'yuwan mu ta̱ a̱tsuma̱ o upan u le.<verse eid="PSA 55:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4" />O okolo a̱ va̱ a̱ ta̱ pe a̱ a̱tsuma̱lima̱,</para>
  <para style="q2" vid="PSA 55:4">wovon wu ukwisa̱ u reme mu ta̱.<verse eid="PSA 55:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5" />Wovon na̱ meje'en ma̱ lipu</para>
  <para style="q2" vid="PSA 55:5">me reme mu ta̱,</para>
  <para style="q2" vid="PSA 55:5">mu da'wan ta̱ a̱bunda̱ lon.<verse eid="PSA 55:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6" />N damma ta̱,</para>
  <para style="q2" vid="PSA 55:6">&lt;&lt;A damma n ta̱ ne evelu tsa muɗa!</para>
  <para style="q2" vid="PSA 55:6">N shi ta̱ a 'yawan a̱ ka̱ra̱ mi ivuwan,<verse eid="PSA 55:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7" />n shi ta̱ a 'yawan</para>
  <para style="q2" vid="PSA 55:7">n ka̱ra̱ a alanga,</para>
  <para style="q2" vid="PSA 55:7">n yuwaan aciya̱va̱ u'wa a̱ a̱tsumona. <char style="qs">Wivuwun</char><verse eid="PSA 55:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8" />N ta̱ jika̱ a̱ tyo uba̱ta̱ wu upa'anta u va̱,</para>
  <para style="q2" vid="PSA 55:8">alanga nu upepu na̱ wunla̱ u vama.&gt;&gt;<verse eid="PSA 55:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9" />A̱sulazuva, ra̱pula̱ n'yuwatan n va̱,</para>
  <para style="q2" vid="PSA 55:9">a̱vu vu ne'eshen elentsu e le,</para>
  <para style="q1" vid="PSA 55:9">adama a na n te inda</para>
  <para style="q2" vid="PSA 55:9">u'ya̱susa̱n wu ugbozu na̱ nla̱ngi a̱tsuma̱ a̱ lyuci.<verse eid="PSA 55:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10" />Urana na ayin a̱ tsu da̱na̱ ta̱ a agara</para>
  <para style="q2" vid="PSA 55:10">a̱ ka̱nda̱ruwusa̱ kari va̱ yi.</para>
  <para style="q2" vid="PSA 55:10">Iwuya na addama a shiwan ta̱ a̱ lyuci'i.<verse eid="PSA 55:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11" />A̱ lungusa̱ ta̱ lyuci'i suru,</para>
  <para style="q2" vid="PSA 55:11">ibili ne epen a shiwan ta̱ e re va̱ yi.<verse eid="PSA 55:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12" />A damma ma'yuwatan ma ɗa me isulusa mu,</para>
  <para style="q2" vid="PSA 55:12">n shi ta̱ a kaɓa asuvu.</para>
  <para style="q1" vid="PSA 55:12">A damma za na ciga numu ɗa shi</para>
  <para style="q2" vid="PSA 55:12">ri a̱ nla̱ngi na̱ a̱mu,</para>
  <para style="q2" vid="PSA 55:12">n shi ta̱ a pa'an yi.<verse eid="PSA 55:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13" />Amma i'utsa̱ i zuzu i va̱ i ɗa</para>
  <para style="q2" vid="PSA 55:13">za na n cayi okolo,<verse eid="PSA 55:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14" />za na tsu uwwulai lon</para>
  <para style="q2" vid="PSA 55:14">mantsa ma na tsu ri a mmalu oɓolo</para>
  <para style="q2" vid="PSA 55:14">a̱tsuma̱ e iɓolo ya ama o u'wa wa̱ A̱sula̱.<verse eid="PSA 55:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15" />Lyawa ukwa̱ u tara n'yuwatan n va̱ babu urevu,</para>
  <para style="q2" vid="PSA 55:15">lyawa a̱ ka̱ra̱ a̱ tyo a ason ele wuma,</para>
  <para style="q1" vid="PSA 55:15">adama a na iwuya i tsura̱ ta̱</para>
  <para style="q2" vid="PSA 55:15">uba̱ta̱ wu nden a̱tsuma̱ e le.<verse eid="PSA 55:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16" />Amma n ɗe ta̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 55:16">a̱vu A̱sulazuva a wawa mu.<verse eid="PSA 55:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17" />Urana na ayin n tsu shon ta̱ na̱ ma̱nga̱,</para>
  <para style="q2" vid="PSA 55:17">a̱vu wu uwwa uɗyo u va̱.<verse eid="PSA 55:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18" />U ta wawa mu</para>
  <para style="q2" vid="PSA 55:18">diga o uvon u na a yuwusan na̱ mu,</para>
  <para style="q2" vid="PSA 55:18">ko na wo o'woi na̱ a̱bunda̱ a 'yuwan mu ta̱.<verse eid="PSA 55:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19" />A̱sula̱ a na a yuwusan tsugono hali hali,</para>
  <para style="q2" vid="PSA 55:19">u ta uwwa a̱vu u ca le a̱tsuma̱lima̱, <char style="qs">wivuwun</char></para>
  <para style="q1" vid="PSA 55:19">ama a na a tsu vadala diga e re le shi</para>
  <para style="q2" vid="PSA 55:19">waru a uwwusa wovon wa̱ A̱sula̱ shi.<verse eid="PSA 55:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20" />I'utsa̱ i va̱ i ndolo gba</para>
  <para style="q2" vid="PSA 55:20">u riya̱a̱ ta̱ i'utsa̱ ya̱ yi,</para>
  <para style="q2" vid="PSA 55:20">reve u kuɗa akucunu a̱ yi.<verse eid="PSA 55:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21" />U ta̱ nu una̱ wu uyo'o a adanshi a̱ yi,</para>
  <para style="q2" vid="PSA 55:21">na̱ ne suru uvon u to o okolo a̱ yi,</para>
  <para style="q1" vid="PSA 55:21">idanshi yu una̱ ya̱ yi i ta̱ pete,</para>
  <para style="q2" vid="PSA 55:21">na̱ ne suru a̱ ta̱ tsa̱ aya a na o ronoi.<verse eid="PSA 55:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22" />I lyawaa A̱sulazuva ili i na ya̱a̱ ɓa̱la̱ ɗu,</para>
  <para style="q2" vid="PSA 55:22">a̱yi waru u ta e idana ɗu,</para>
  <para style="q2" vid="PSA 55:22">waa lyawa za va̱ a̱ɓula̱ riya̱ shi ko ke'en.<verse eid="PSA 55:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23" />Amma a̱vu, A̱sula̱,</para>
  <para style="q2" vid="PSA 55:23">vu ta tawa a̱za̱ e iwuya,</para>
  <para style="q2" vid="PSA 55:23">a̱ tyo a̱ a̱a̱ka̱ri o ukototosu</para>
  <para style="q1" vid="PSA 55:23">a̱za̱ wocosu wu mpasa na̱ a̱za̱ epen,</para>
  <para style="q2" vid="PSA 55:23">babu za na a rawa uɓatsulai wu rana wuma wa̱ yi.</para>
  <para style="q2" vid="PSA 55:23">Amma a̱mu gba, n zuwa ta̱ ucira u va̱ ya̱'a̱ wu.<verse eid="PSA 55:23" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" sid="PSA 56" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Nu uɗyo &lt;&lt;U Muɗa Zuva vu uɗanga u Oku ɗe Alanga.&gt;&gt; Wa̱ Da̱wuda. A mantsa ma na aza a Filistiya e reme niyi a̱tsuma̱ a̱ lyuci va Gat.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1" />A̱sula̱, vee ene iliyali i va̱,</para>
  <para style="q2" vid="PSA 56:1">adama a na ama a zuwa mu ta̱ elime,</para>
  <para style="q2" vid="PSA 56:1">urana suru a ta zuwusa mu elime.<verse eid="PSA 56:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2" />N'yuwatan n va̱ nta saɓusa mu urana ma̱ɓula̱,</para>
  <para style="q2" vid="PSA 56:2">na̱ a̱bunda̱ e le a̱ ta̱ a̱ nla̱ngi na̱ mu</para>
  <para style="q2" vid="PSA 56:2">o u'ya̱susa̱n wa aci le.<verse eid="PSA 56:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3" />Mantsa ma na mu uwwai wovon,</para>
  <para style="q2" vid="PSA 56:3">n ta zuwa ucira ya̱'a̱ wu.<verse eid="PSA 56:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 56:4" />Uba̱ta̱ wa̱ A̱sula̱ a na maa cuwusa idanshi ya̱ yi,</para>
  <para style="q2" vid="PSA 56:4">uba̱ta̱ wa̱ A̱sula̱ a ɗa n zuwai ucira u va̱.</para>
  <para style="q1" vid="PSA 56:4">Maa uwwa wovon shi,</para>
  <para style="q2" vid="PSA 56:4">nye ɗa vaɗilima̱ aa yuwaan mu?<verse eid="PSA 56:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5" />Urana ma̱ɓula̱ a ta vadalasa adanshi a̱ va̱,</para>
  <para style="q2" vid="PSA 56:5">a̱ ta̱ e ifoɓi i na a amaton mu kuci.<verse eid="PSA 56:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6" />O ɓolo ta̱ aci upa'awun</para>
  <para style="q2" vid="PSA 56:6">a̱ ka̱lyuwusa̱ udasuwu u va̱,</para>
  <para style="q2" vid="PSA 56:6">a̱ tu ufoɓu o una mu.<verse eid="PSA 56:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7" />A̱sula̱, ko ke'en</para>
  <para style="q2" vid="PSA 56:7">she vu lyawa le a la'a wan,</para>
  <para style="q1" vid="PSA 56:7">a̱tsuma̱ o upan wa̱ wu</para>
  <para style="q2" vid="PSA 56:7">vu ka̱ɗa̱to nɗa.<verse eid="PSA 56:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8" />Vu ɗana ta̱ a̱tsuma̱lima̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 56:8">vu kece ta̱ a̱bunda̱ a aɓara a̱ va̱,</para>
  <para style="q2" vid="PSA 56:8">ashe a̱ ri a aatagada a̱ wu shi?<verse eid="PSA 56:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9" />Ne ɗa n'yuwatan n va̱</para>
  <para style="q2" vid="PSA 56:9">ma̱a̱ ka̱mba̱ na̱ a̱ca̱pa̱</para>
  <para style="q2" vid="PSA 56:9">a mantsa ma na n ɗe yi adama e ikambishi.</para>
  <para style="q1" vid="PSA 56:9">Na̱ tsun ndolo tsa ɗa me reve,</para>
  <para style="q2" vid="PSA 56:9">A̱sula̱ o to oɓolo na̱ mu.<verse eid="PSA 56:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10" />Uba̱ta̱ wa̱ A̱sula̱ a na maa cuwusa idanshi ya̱ yi,</para>
  <para style="q2" vid="PSA 56:10">uba̱ta̱ wa̱ A̱sulazuva a na maa cuwusa idanshi ya̱ yi.<verse eid="PSA 56:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11" />Uba̱ta̱ wa̱ wu u ɗa maa zuwusa ucira,</para>
  <para style="q2" vid="PSA 56:11">maa uwwa wovon shi.</para>
  <para style="q2" vid="PSA 56:11">Nye ɗa vaɗilima̱ a gura yuwaan mu?<verse eid="PSA 56:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12" />A̱sula̱, n ta̱ shiton akucunu ana n yuwaan nuwu,</para>
  <para style="q2" vid="PSA 56:12">n ta̱ ta̱wa̱a̱ na̱ kucci vu ugodyusho uba̱ta̱ wa̱ wu.<verse eid="PSA 56:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13" />Adama a na vu wawa mu ta̱ diga o ukwa̱,</para>
  <para style="q2" vid="PSA 56:13">oɓolo na ana a̱ va̱ diga o uta̱ɗa̱tsa̱sa̱,</para>
  <para style="q1" vid="PSA 56:13">adama n yuwan mmalu e elime a̱ wu,</para>
  <para style="q2" vid="PSA 56:13">a̱tsuma̱ e ekan i wuma.<verse eid="PSA 56:13" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" sid="PSA 57" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. A cana yi nu uɗyo &lt;&lt;She vu kototo wan.&gt;&gt; Wa̱ Da̱wuda. A mantsa ma na u sumaa yi Shawulu a̱ tyo a̱ a̱ba̱nu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1" />A̱sula̱, vee ene iliyali i va̱,</para>
  <para style="q2" vid="PSA 57:1">vee ene iliyali i va̱,</para>
  <para style="q1" vid="PSA 57:1">adama a na ya̱'a̱ wu ɗa</para>
  <para style="q2" vid="PSA 57:1">wuma u va̱ wa̱ tsurusa̱ upa'atan.</para>
  <para style="q1" vid="PSA 57:1">N ta̱ tsura̱ upa'anta</para>
  <para style="q2" vid="PSA 57:1">o ululu we evelu a̱ wu,</para>
  <para style="q2" vid="PSA 57:1">hali she na̱ meleshe ma̱ ndolo ma̱ ka̱ra̱.<verse eid="PSA 57:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2" />N ɗe ta̱ uba̱ta̱ Mogono ma̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 57:2">uba̱ta̱ wa̱ A̱sula̱ a na o tsu shiton</para>
  <para style="q2" vid="PSA 57:2">ili i na u cigai a wuma u va̱.<verse eid="PSA 57:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3" />U ta̱ lyungu ni ikambishi diga zuva</para>
  <para style="q2" vid="PSA 57:3">reve u wawa mu,</para>
  <para style="q1" vid="PSA 57:3">a ɓarasa aza a na a zuwa numu elime.<char style="qs">Wivuwun</char></para>
  <para style="q2" vid="PSA 57:3">A̱sula̱ a̱ tsu roco mu ta̱ icigi ya̱ yi na̱ a̱ɓula̱ a̱ yi.<verse eid="PSA 57:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4" />Wuma u va̱ u ta̱ memere me ikamu,</para>
  <para style="q2" vid="PSA 57:4">n ta̱ nven e memere me inama yu una</para>
  <para style="q2" vid="PSA 57:4">i na i tsu tamusa ama,</para>
  <para style="q1" vid="PSA 57:4">ama a na anga e le tan ɗa na aya,</para>
  <para style="q2" vid="PSA 57:4">aza a na elentsu e le a̱ ri u tewun tsa̱ mutsun mu pe'eni.<verse eid="PSA 57:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5" />A̱sula̱, lyawa a cuwa wu ɗe zuva,</para>
  <para style="q2" vid="PSA 57:5">lyawa tsugbain tsa̱ wu tsa̱ da̱na̱ o uvaɗi ma̱ɓula̱!<verse eid="PSA 57:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6" />N'yuwatan n va̱ azuwaa mu ta̱ maza</para>
  <para style="q2" vid="PSA 57:6">adama e reme ana a̱va̱,</para>
  <para style="q2" vid="PSA 57:6">usa̱n u la'a ta̱ ucira u va̱.</para>
  <para style="q1" vid="PSA 57:6">A̱ ka̱pa̱ ta̱ a̱a̱ka̱ri o ure u va̱,</para>
  <para style="q2" vid="PSA 57:6">amma a̱vu u ka̱mba̱ aciya̱le.<char style="qs">Wivuwun</char><verse eid="PSA 57:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7" />A̱sula̱, Okolo a̱ va̱ a kuɗa shi</para>
  <para style="q2" vid="PSA 57:7">okolo a̱ va̱ a̱ ta̱ lo u kuɗa shi.</para>
  <para style="q2" vid="PSA 57:7">N ta cana ishipa n yuwan tsuwe'e.<verse eid="PSA 57:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8" />Juwan, wuma u va̱!</para>
  <para style="q2" vid="PSA 57:8">Juwan, igaraya na̱ kumburu va̱!</para>
  <para style="q2" vid="PSA 57:8">N ta jisan usana ni ishipa i va̱.<verse eid="PSA 57:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9" />A̱sulazuva, n ta cuwa wu,</para>
  <para style="q2" vid="PSA 57:9">a̱tsuma̱ a nɗa,</para>
  <para style="q1" vid="PSA 57:9">n ta canaa wu ishipa</para>
  <para style="q2" vid="PSA 57:9">a̱tsuma̱ a ama.<verse eid="PSA 57:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10" />Adama a na a̱bunda̱ e icigi ya̱ wu</para>
  <para style="q2" vid="PSA 57:10">i rawa ta̱ zuva,</para>
  <para style="q1" vid="PSA 57:10">a̱ɓula̱ a̱ wu</para>
  <para style="q2" vid="PSA 57:10">a rawa ta̱ e eleshe.<verse eid="PSA 57:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11" />A̱sula̱, lyawa a cuwa wu ɗe zuva,</para>
  <para style="q2" vid="PSA 57:11">lyawa tsugbain tsa̱ wu tsa̱ da̱na̱ o uvaɗi ma̱ɓula̱.<verse eid="PSA 57:11" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" sid="PSA 58" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. A cana yi nu uɗyo wa̱ Da̱wuda, &lt;&lt;She vu kototo wan.&gt;&gt;</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1" />A̱ɗu a̱za̱ o tsugono,</para>
  <para style="q2" vid="PSA 58:1">i ta casu udammu u na u ri mejege gba?</para>
  <para style="q1" vid="PSA 58:1">I ta yuwusaan vaɗilima̱</para>
  <para style="q2" vid="PSA 58:1">uge'etosu wa amayun gba?<verse eid="PSA 58:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2" />Suru suru, o okolo a̱ ɗu</para>
  <para style="q2" vid="PSA 58:2">i ta̱ foɓuso ulambu wa̱ a̱ɓula̱!</para>
  <para style="q1" vid="PSA 58:2">Ne ekere a̱ ɗu ɗa ya̱a̱ foɓuso</para>
  <para style="q2" vid="PSA 58:2">u'ya̱susa̱n wu ugbozu a̱tsuma̱ o uvaɗi.<verse eid="PSA 58:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3" />Diga pe a̱a̱tsuma̱ a ɗa,</para>
  <para style="q2" vid="PSA 58:3">a̱za̱ e iwuya a tsu lyawa ure u mejege.</para>
  <para style="q1" vid="PSA 58:3">Babu na a matsan le,</para>
  <para style="q2" vid="PSA 58:3">a̱za̱ e epen a lyawa ta̱ ure u mejege.<verse eid="PSA 58:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4" />Tsukono tsa̱ le tsa̱ ta̱ tsa̱ tsukono tso yo,</para>
  <para style="q2" vid="PSA 58:4">tsa̱ ruku na ulai atsuvu a̱ yi,<verse eid="PSA 58:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 58:5" />na tsa̱ kuɗa̱ a uwwa uɗyo</para>
  <para style="q2" vid="PSA 58:5">wu za na a yuwusaan yi a̱guma̱.</para>
  <para style="q1" vid="PSA 58:5">Ko ishipa yi za</para>
  <para style="q2" vid="PSA 58:5">tsu tsuboci.<verse eid="PSA 58:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6" />A̱sula̱, vu kuɗa</para>
  <para style="q2" vid="PSA 58:6">anga a̱ na̱ le!</para>
  <para style="q1" vid="PSA 58:6">A̱sulazuva, vu foɗo</para>
  <para style="q2" vid="PSA 58:6">anga e ikamu!<verse eid="PSA 58:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7" />Lyawa a̱ puwa̱n</para>
  <para style="q2" vid="PSA 58:7">tsa mini ma na me yeneshe,</para>
  <para style="q1" vid="PSA 58:7">mantsa ma na o ronoi tan le,</para>
  <para style="q2" vid="PSA 58:7">lyawa aya e le o mongolo.<verse eid="PSA 58:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8" />Lyawa o o'wo tsa̱ ma̱tsa̱n mo ookoto</para>
  <para style="q2" vid="PSA 58:8">ma na ma̱ tsu jeruwe wo o'wo ederi</para>
  <para style="q2" vid="PSA 58:8">a mantsa ma na a̱ ri a mmalu,</para>
  <para style="q1" vid="PSA 58:8">tsa̱ mereɓu ma na a matsain ukwa̱,</para>
  <para style="q2" vid="PSA 58:8">she e ene ekan wan.<verse eid="PSA 58:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9" />Kafu e reve o kototo le ta̱ tsa a awanda</para>
  <para style="q2" vid="PSA 58:9">A̱sula̱ a̱tsuma̱ o upan wu usuɗuwu wa̱ wu</para>
  <para style="q2" vid="PSA 58:9">vu kototo le, ele u ubuwu wuma.<verse eid="PSA 58:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10" />A̱za̱ a̱ a̱ɓula̱ a ta yuwan ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 58:10">a mantsa ma na e enei a tsupusaa le.</para>
  <para style="q1" vid="PSA 58:10">Na amantsa ma na</para>
  <para style="q2" vid="PSA 58:10">o kototoi n'yuwatan le suru suru.<verse eid="PSA 58:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11" />A mantsa mo ndolo ma ɗa a ama a damma,</para>
  <para style="q2" vid="PSA 58:11">&lt;&lt;Amayun hali n gogo a buwa ta̱ a tsupusaa a̱za̱ a̱ɓula̱,</para>
  <para style="q2" vid="PSA 58:11">na amayun A̱sula̱ o tu lo na e ge'etosu uvaɗi.&gt;&gt;<verse eid="PSA 58:11" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" sid="PSA 59" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. A cana yi nu uɗyo wa̱ Da̱wuda,&lt;&lt;She vu kototo wan.&gt;&gt; A mantsa ma na Shawulu lyunguyi ama a̱ ka̱lyuwa̱ u'wa̱ wa̱ Dawuda tsura̱ o una yi.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1" />A̱sula̱ a̱ va̱, wawa mu</para>
  <para style="q2" vid="PSA 59:1">diga e ekere a n'yuwatan n va̱,</para>
  <para style="q1" vid="PSA 59:1">vu yuwaan mu mapari</para>
  <para style="q2" vid="PSA 59:1">e ekere aza a na a zuwa numu e elime mantsa suru.<verse eid="PSA 59:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2" />Vu wawa mu</para>
  <para style="q2" vid="PSA 59:2">e ekere aza a na a yuwusan iwuya,</para>
  <para style="q1" vid="PSA 59:2">vu wawa mu</para>
  <para style="q2" vid="PSA 59:2">e ekere a̱za̱ o wocosu wu mpasa.<verse eid="PSA 59:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3" />A̱sulazuva, ka̱lyuwa̱ cine o voyin</para>
  <para style="q2" vid="PSA 59:3">a vawan numu.</para>
  <para style="q1" vid="PSA 59:3">A̱za̱ e iwuya oɓolo ta̱ una̱ a aci a̱ va̱,</para>
  <para style="q2" vid="PSA 59:3">agba adama e ili ro i ɗa shi, waru n nusan shi.<verse eid="PSA 59:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4" />N yuwan unusu u ro shi,</para>
  <para style="q2" vid="PSA 59:4">na̱ ne suru a̱ tu ufoɓu u na a̱ riya̱a̱ mu.</para>
  <para style="q1" vid="PSA 59:4">'Yon, vu kamba mu,</para>
  <para style="q2" vid="PSA 59:4">ka̱lyuwa̱ ili i na i cina numu!<verse eid="PSA 59:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5" />A̱sulazuva A̱sula̱ o oɓolo a̱ a̱soja a zuva,</para>
  <para style="q2" vid="PSA 59:5">A̱sula̱ a Isra'ila.</para>
  <para style="q1" vid="PSA 59:5">'Yon vu ca nɗa suru oforo,</para>
  <para style="q2" vid="PSA 59:5">she vu roco a̱za̱ e iwuya</para>
  <para style="q2" vid="PSA 59:5">aza a yipalishi iliyali wan. <char style="qs">Wivuwun</char><verse eid="PSA 59:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6" />A̱ tsu ka̱mba̱ ta̱ nu ulivu,</para>
  <para style="q2" vid="PSA 59:6">a tsuɓari cine vu revei musa̱n,</para>
  <para style="q2" vid="PSA 59:6">e igaru a̱tsuma̱ a̱ lyuci.<verse eid="PSA 59:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7" />Uwwa ne'e ili i na yoo u uta̱sa̱ a̱ na̱ le,</para>
  <para style="q2" vid="PSA 59:7">a̱ ta̱ tsuwusa̱n adanshi tsa mutsun mu pe'eni a dansa,</para>
  <para style="q2" vid="PSA 59:7">&lt;&lt;Zane ɗa a uwwa tsu?&gt;&gt;<verse eid="PSA 59:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8" />Amma a̱vu A̱sulazuva,</para>
  <para style="q2" vid="PSA 59:8">vu tsu zo'oso le ta̱,</para>
  <para style="q2" vid="PSA 59:8">aa yuwusaan nɗa ndolo suru ulamu.<verse eid="PSA 59:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9" />A̱vu ucira u va̱,</para>
  <para style="q2" vid="PSA 59:9">n zuwaa wu ta̱ ucira,</para>
  <para style="q2" vid="PSA 59:9">A̱sula̱ a ɗa uba̱ta̱ wu upa'atan wu ucira u va̱.<verse eid="PSA 59:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 59:10" />A̱sula̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 59:10">a na tsu roco icigi i na i tsu vadala shi,</para>
  <para style="q2" vid="PSA 59:10">u ta walaa mu e elime.</para>
  <para style="q1" vid="PSA 59:10">U ta zuwa mu n zo'oso aza a na</para>
  <para style="q2" vid="PSA 59:10">a yuwusan adanshi a vama aciya̱va̱.<verse eid="PSA 59:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11" />Amma she vu una le wan,</para>
  <para style="q2" vid="PSA 59:11">A̱sulazuva uba̱ta̱ wu upa'atan wu ucira u tsu,</para>
  <para style="q2" vid="PSA 59:11">nna̱ ne shi ama a̱ va̱ a̱ ta̱ e icina.</para>
  <para style="q1" vid="PSA 59:11">A̱tsuma̱ o ucira wa̱ wu</para>
  <para style="q2" vid="PSA 59:11">vu zuwa le a̱ da̱na̱ a agara e iwau,</para>
  <para style="q2" vid="PSA 59:11">a̱vu vu kototo le.<verse eid="PSA 59:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12" />Adama a̱ nusu vu na̱ le,</para>
  <para style="q2" vid="PSA 59:12">ni idanshi ye elentsu e le,</para>
  <para style="q1" vid="PSA 59:12">lyawa ugbawu u le</para>
  <para style="q2" vid="PSA 59:12">wo o'wo le maza.</para>
  <para style="q1" vid="PSA 59:12">Adama a wisulusa u le</para>
  <para style="q2" vid="PSA 59:12">ne epen a na a yuwusan,<verse eid="PSA 59:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 59:13" />vu kototo le nu upan,</para>
  <para style="q2" vid="PSA 59:13">vu kototo le hali she no koto.</para>
  <para style="q1" vid="PSA 59:13">Ne ɗa e reve a na A̱sula̱ a̱ ri o tsugono aci a Yakubu</para>
  <para style="q2" vid="PSA 59:13">hali acina ukosu wu uvaɗi. <char style="qs">Wivuwun</char><verse eid="PSA 59:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14" />A̱ tsu ka̱mba̱ ta̱ nu ulivu,</para>
  <para style="q2" vid="PSA 59:14">a tsuɓari cine vu revei musa̱n,</para>
  <para style="q2" vid="PSA 59:14">e igaru a̱tsuma̱ a̱ lyuci.<verse eid="PSA 59:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15" />A ta agara e izami yi ilyalya,</para>
  <para style="q2" vid="PSA 59:15">agba a tsu yuwan ta̱ upan na̱ a̱ cuwa̱n shi.<verse eid="PSA 59:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16" />Amma n ta cana ishipa adama o ucira wa̱ wu,</para>
  <para style="q2" vid="PSA 59:16">nu usana n ta cana ishipa</para>
  <para style="q2" vid="PSA 59:16">adama e icigi ya̱ wu i na i tsu vadala shi,</para>
  <para style="q1" vid="PSA 59:16">adama a na a̱vu ɗa</para>
  <para style="q2" vid="PSA 59:16">uba̱ta̱ wu upa'atan wu ucira u va̱</para>
  <para style="q2" vid="PSA 59:16">a mantsa ma̱ a̱tsuma̱lima̱.<verse eid="PSA 59:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17" />A̱sula̱, a̱vu ɗa ucira u va̱,</para>
  <para style="q2" vid="PSA 59:17">n ta canaa wu ishipa yi ica,</para>
  <para style="q1" vid="PSA 59:17">a̱vu ɗa upa'atan wu ucira u va̱,</para>
  <para style="q2" vid="PSA 59:17">za na o rocosu mu icigi i na i tsu vadala shi.<verse eid="PSA 59:17" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" sid="PSA 60" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. A cana yi nu uɗyo wa̱ Da̱wuda wa̱, &lt;&lt;Lili wu Nzuwulai.&gt;&gt; Adama o uritosu. A mantsa ma na u lyuwai Aram Naharayim na̱ Aram Zoba nu uvon oɓolo na amantsa ma na Yowab ka̱mba̱i na wu unai a̱ a̱za̱ a̱ Edom ukpakukupa kupa ne ejere o uka̱ri wa Akpaɗi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1" />A̱sula̱, vu vari tsu ta̱,</para>
  <para style="q2" vid="PSA 60:1">a̱vu vu lyawa a lyuwa tsu nu uvon.</para>
  <para style="q1" vid="PSA 60:1">Vu yuwan ta̱ upan na̱ a̱tsu,</para>
  <para style="q2" vid="PSA 60:1">gogo vu ka̱mba̱to tsu!<verse eid="PSA 60:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2" />A̱vu ɗa vu jinga̱ɗa̱i iɗa,</para>
  <para style="q2" vid="PSA 60:2">a̱vu vu ɓatsa yi.</para>
  <para style="q1" vid="PSA 60:2">Gogo vu ciɗo yi</para>
  <para style="q2" vid="PSA 60:2">adama a na u ta̱ e meje'en.<verse eid="PSA 60:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3" />Vu zuwa ta̱ a ama a̱ wu e ene</para>
  <para style="q2" vid="PSA 60:3">mantsa ma̱ a̱tsuma̱lima̱ lon,</para>
  <para style="q1" vid="PSA 60:3">vu ca tsu ta̱ masayan ma̱ ina̱bi</para>
  <para style="q2" vid="PSA 60:3">za na tsura̱to ntsu.<verse eid="PSA 60:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4" />Amma e ekere aza a na a uwwusa wovon wa̱ wu,</para>
  <para style="q2" vid="PSA 60:4">vu 'ya̱sa̱n ta̱ atuta</para>
  <para style="q2" vid="PSA 60:4">tsa̱ra̱ a la'a o una̱ wi ibata. <char style="qs">Wivuwun</char><verse eid="PSA 60:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5" />Vu wawa tsu,</para>
  <para style="q2" vid="PSA 60:5">a̱vu vu kamba tsu</para>
  <para style="q2" vid="PSA 60:5">nu ukere wa̱ wu.</para>
  <para style="q1" vid="PSA 60:5">Adama aza a na vu ri e icigi</para>
  <para style="q2" vid="PSA 60:5">a̱ tsura̱ iwawi.<verse eid="PSA 60:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6" />A̱sula̱ a yuwan ta̱ adanshi</para>
  <para style="q2" vid="PSA 60:6">diga uba̱ta̱ wa akiza a̱ yi,</para>
  <para style="q1" vid="PSA 60:6">u damma &lt;&lt;Nu ulyuwu wa aci u ɗa me ne'eshe Shekem</para>
  <para style="q2" vid="PSA 60:6">a̱vu n rito woo a ama a̱ va̱ Uka̱ri wa̱ Sukot.<verse eid="PSA 60:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7" />Upasu wa Giliyadu za va̱ ɗa,</para>
  <para style="q2" vid="PSA 60:7">Manase fo za va̱ ɗa,</para>
  <para style="q1" vid="PSA 60:7">Ifiramu ɗa eegbezu a̱ rumu a̱ va̱,</para>
  <para style="q2" vid="PSA 60:7">Yahuza waru aaɗanga o tsugono tsa̱ va̱.<verse eid="PSA 60:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8" />Amma n to o'wo oto iɗa ya Mowa asa'atsu a̱ va̱,</para>
  <para style="q2" vid="PSA 60:8">Edom waru uba̱ta̱ u na maa varishi atan a̱ va̱,</para>
  <para style="q1" vid="PSA 60:8">n ta yuwan yisaali yu ulyuwu wa aci</para>
  <para style="q2" vid="PSA 60:8">a aci aza a Filistiya.&gt;&gt;<verse eid="PSA 60:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9" />Zane ɗa a̱ 'ya̱wa̱to mu</para>
  <para style="q2" vid="PSA 60:9">a̱ lyuci vu ukari vu ucira?</para>
  <para style="q1" vid="PSA 60:9">Zane ɗa o rono mu aɗanga</para>
  <para style="q2" vid="PSA 60:9">a̱ tyo e iɗa ya̱ Edom?<verse eid="PSA 60:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10" />A̱sula̱, a̱vu ɗa vu 'yuwan ntsu,</para>
  <para style="q2" vid="PSA 60:10">a̱vu vu 'yuwan o uta̱ oɓolo na̱ a̱soja a̱ tsu shi?<verse eid="PSA 60:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11" />Vu yuwaan tsu ikambishi</para>
  <para style="q2" vid="PSA 60:11">e ekere a n'yuwatan,</para>
  <para style="q1" vid="PSA 60:11">adama a na ikambishi yi vaɗilima̱</para>
  <para style="q2" vid="PSA 60:11">ili ye pere i ɗa.<verse eid="PSA 60:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12" />Ni ikambishi ya̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 60:12">tsu ta lyuwa a aci,</para>
  <para style="q2" vid="PSA 60:12">waru u ta dadasa n'yuwatan n tsu.<verse eid="PSA 60:12" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" sid="PSA 61" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Na̱ kumburu. Wa̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1" />A̱sula̱, vu uwwa mesun ma̱ va̱,</para>
  <para style="q2" vid="PSA 61:1">vu usu avasa a̱ va̱.<verse eid="PSA 61:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2" />N ɗewu ta̱ diga o ukosu wu uvaɗi,</para>
  <para style="q2" vid="PSA 61:2">n ɗewu ta̱ a mantsa ma na okolo a̱ va̱ a kuɗai.</para>
  <para style="q1" vid="PSA 61:2">Vu ronoo mu aɗanga a̱ tyo aatali</para>
  <para style="q2" vid="PSA 61:2">a na a la'a numu uga'an.<verse eid="PSA 61:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3" />Adama a na a̱vu ɗa upa'atan u va̱,</para>
  <para style="q2" vid="PSA 61:3">atsura o ucira a aci a n'yuwatan n va̱.<verse eid="PSA 61:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4" />N ta maluwa ma na ma̱ da̱nu</para>
  <para style="q2" vid="PSA 61:4">o Oogodo a̱ wu hali hali,</para>
  <para style="q1" vid="PSA 61:4">tsura̱ n tsura̱ upa'atan</para>
  <para style="q2" vid="PSA 61:4">a̱tsuma̱ o ululu we evelu a̱ wu.</para>
  <para style="q2" vid="PSA 61:4">Za̱la̱ ve evelu a̱ wu.<char style="qs">Wivuwun</char><verse eid="PSA 61:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5" />A̱sula̱, adama a na vu uwwa ta̱ akucunu a̱ va̱,</para>
  <para style="q2" vid="PSA 61:5">vu ca mu agadu aza a na</para>
  <para style="q2" vid="PSA 61:5">a uwwusa wovon wa ala a̱ wu.<verse eid="PSA 61:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6" />Vu da̱shi rana wuma u mogono,</para>
  <para style="q2" vid="PSA 61:6">lyawa a'wan a̱ yi a̱ da̱na̱</para>
  <para style="q2" vid="PSA 61:6">mantsa a̱a̱ a̱bunda̱.<verse eid="PSA 61:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7" />Lyawa u yuwan tsugono e elime A̱sula̱ hali hali,</para>
  <para style="q2" vid="PSA 61:7">vu zuwa icigi ya̱ wu na amayun a yuwaan yi mapari.<verse eid="PSA 61:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8" />Ɗaɗa ma̱a̱ da̱na̱ a cuwusa ala a̱ wu</para>
  <para style="q2" vid="PSA 61:8">waru n shiton akucunu a̱ va̱ urana suru.<verse eid="PSA 61:8" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" sid="PSA 62" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Adama a Yedutun. Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1" />Uba̱ta̱ wa̱ A̱sula̱ a ɗa goon</para>
  <para style="q2" vid="PSA 62:1">wuma u va̱ wa̱ tsura̱ wivuwun,</para>
  <para style="q2" vid="PSA 62:1">iwawi i va̱ i ta̱ o uta̱sa̱ uba̱ta̱ wa̱ yi.<verse eid="PSA 62:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2" />A̱sula̱ a ɗa goon aatali a̱ va̱</para>
  <para style="q2" vid="PSA 62:2">ni iwawi i va̱,</para>
  <para style="q1" vid="PSA 62:2">uba̱ta̱ wu upa'atan wu ucira u va̱,</para>
  <para style="q2" vid="PSA 62:2">babu ili i na ya̱a̱ jinga̱ɗa̱ mu.<verse eid="PSA 62:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3" />Hali mantsa ma̱ ne ma ɗa</para>
  <para style="q2" vid="PSA 62:3">a̱ɗu n'yuwatan yaa yuwan nla̱ngi na̱ vuma ta̱?</para>
  <para style="q1" vid="PSA 62:3">Hali mantsa ma̱ ne i cigai yu una,</para>
  <para style="q2" vid="PSA 62:3">za na ri nu ucira shi</para>
  <para style="q2" vid="PSA 62:3">tsu ukari u na u cigai wo oco?<verse eid="PSA 62:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4" />O foɓo ta̱ lon tsa̱ra̱ a̱ mula̱ yi</para>
  <para style="q2" vid="PSA 62:4">diga uba̱ta̱ u tsugbain tsa̱ yi.</para>
  <para style="q1" vid="PSA 62:4">A ta uwwusa uyo'o we epen,</para>
  <para style="q2" vid="PSA 62:4">a tsu zuwaa ta̱ za aba'un nu una̱ u le,</para>
  <para style="q2" vid="PSA 62:4">amma o okolo e le una̱ u ɗa a yuwusan. <char style="qs">Wivuwun</char><verse eid="PSA 62:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5" />Okolo a̱ va̱ vu zami wivuwun goon uba̱ta̱ wa̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 62:5">adama a na a̱ yi ɗa goon waa casu mu ukadu.<verse eid="PSA 62:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6" />A̱sula̱ a ɗa goon aatali a̱ va̱</para>
  <para style="q2" vid="PSA 62:6">ni iwawi i va̱,</para>
  <para style="q1" vid="PSA 62:6">uba̱ta̱ wu upa'atan wu ucira u va̱,</para>
  <para style="q2" vid="PSA 62:6">babu ili i na ya̱a̱ jinga̱ɗa̱ mu.<verse eid="PSA 62:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7" />Iwawi i va̱ na̱ tsugbain tsa̱ va̱</para>
  <para style="q2" vid="PSA 62:7">a̱ ta̱ uba̱ta̱ wa̱ A̱sula̱ goon,</para>
  <para style="q1" vid="PSA 62:7">A̱yi ɗa aatali o ucira a̱ va̱,</para>
  <para style="q2" vid="PSA 62:7">nu upa'atan u va̱.<verse eid="PSA 62:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8" />A̱ɗu ama i ca A̱sula̱</para>
  <para style="q2" vid="PSA 62:8">okolo a̱ɗu mantsa suru.</para>
  <para style="q1" vid="PSA 62:8">I damma yi okolo a̱ ɗu,</para>
  <para style="q2" vid="PSA 62:8">adama a na a̱yi ɗa upa'atan u tsu.<char style="qs">Wivuwun</char><verse eid="PSA 62:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9" />Ozo o ulambu a̱ ta̱ tsu upepu u wivuwun,</para>
  <para style="q2" vid="PSA 62:9">a̱za̱ o utsuru fo a̱ ri nu urana shi.</para>
  <para style="q1" vid="PSA 62:9">Ko shi no o rito le</para>
  <para style="q2" vid="PSA 62:9">ni ili yu uritosu wu ume,</para>
  <para style="q2" vid="PSA 62:9">a̱ ri nu ume wi ili i ro shi,</para>
  <para style="q2" vid="PSA 62:9">suru nle a la'a ta̱ upepu venwun.<verse eid="PSA 62:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10" />She i zuwa okolo a̱ɗu</para>
  <para style="q2" vid="PSA 62:10">o ulinga u yipalishi wan,</para>
  <para style="q2" vid="PSA 62:10">ko i zuwa okolo uba̱ta̱ wi iliyinkapa wi ili i wivu wan.</para>
  <para style="q1" vid="PSA 62:10">Ko na̱ shi utsuru u ɗu u da̱shi,</para>
  <para style="q2" vid="PSA 62:10">she i zuwaa yi ucira wan.<verse eid="PSA 62:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11" />Uta̱ u ɗa A̱sula̱ a yuwain adanshi,</para>
  <para style="q2" vid="PSA 62:11">ili ire i ɗa mu uwwai, ana,</para>
  <para style="q1" vid="PSA 62:11">&lt;&lt;Ucira za va̱ A̱sula̱ a ɗa,<verse eid="PSA 62:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 62:12" />waru a̱vu A̱sulazuva icigi i na i tsu vadala ɗa shi.<note caller="-" style="x"><char style="xo" closed="false">62:12 </char><char style="xt" closed="false"><ref loc="JER 17:20">Irm 17:20</ref>; <ref loc="MAT 16:27">Mat 16:27</ref>; <ref loc="ROM 2:6">Rom 2:6</ref>; <ref loc="REV 2:23">Wen 2:23</ref>.</char></note></para>
  <para style="q1" vid="PSA 62:12">Na amayun vu ta tsupaa za suru</para>
  <para style="q2" vid="PSA 62:12">o una̱ wi ili i na u yuwain.&gt;&gt;<verse eid="PSA 62:12" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" sid="PSA 63" />
  <para style="s">Mazuwa mo okolo uba̱ta̱ wa̱ A̱sula̱</para>
  <para style="d">Ica ya̱ Da̱wuda. A mantsa ma na u da̱na̱i a̱tsumona a Yahuda.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1" />A̱sula̱, a̱vu ɗa A̱sula̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 63:1">n te izami ya̱ wu babu uro,</para>
  <para style="q1" vid="PSA 63:1">okolo a̱ va̱ a ta uwwusa akuli a̱ wu,</para>
  <para style="q2" vid="PSA 63:1">waru n ta̱ maluwa ma̱ wu,</para>
  <para style="q1" vid="PSA 63:1">tse e iɗa yu u'yewu,</para>
  <para style="q2" vid="PSA 63:1">i na i ri babu mini waru babu ili.<verse eid="PSA 63:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2" />Mee ene wu ta̱ uba̱ta̱ wa akiza,</para>
  <para style="q2" vid="PSA 63:2">waru mi idana ta̱ ucira wa̱ wu</para>
  <para style="q2" vid="PSA 63:2">na̱ tsugbain tsa̱ wu.<verse eid="PSA 63:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3" />Adama a na icigi ya̱ wu i na i tsu vadala shi</para>
  <para style="q2" vid="PSA 63:3">i la'a ta̱ wuma ulobonu,</para>
  <para style="q2" vid="PSA 63:3">una̱ u va̱ u ta yuwaan wu ica.<verse eid="PSA 63:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4" />N ta cuwa wu a rana wuma u va̱,</para>
  <para style="q2" vid="PSA 63:4">waru a̱tsuma̱ a ala a̱ wu a ɗa</para>
  <para style="q2" vid="PSA 63:4">ma̱a̱ 'ya̱sa̱n e ekere a̱ va̱.<verse eid="PSA 63:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5" />Wuma u va̱ u ta̱ cuwa̱n</para>
  <para style="q2" vid="PSA 63:5">cine vu revei ilyalya i sa'ani,</para>
  <para style="q2" vid="PSA 63:5">una̱ u va̱ u ta cuwa wu ni ishipa i ma̱za̱nga̱.<verse eid="PSA 63:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6" />A mantsa ma na n ri nven a̱a̱ga̱da̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 63:6">n tsu da̱na̱ ta̱ a majiyan ma̱ wu,</para>
  <para style="q2" vid="PSA 63:6">ayin ma̱ɓula̱ a cuwusan na̱ a̱vu.<verse eid="PSA 63:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7" />Adama a na a̱vu ɗa za vi ikambishi i va̱,</para>
  <para style="q2" vid="PSA 63:7">n ta canasa ishipa i ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 63:7">za̱la̱ vu ululu ve evelu a̱ wu.<verse eid="PSA 63:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8" />Wuma u va̱ u suraa wu ta̱,</para>
  <para style="q2" vid="PSA 63:8">ukere u sa'ani wa̱ wu u guza̱ mu ta̱.<verse eid="PSA 63:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9" />Aza a na gba a cigai o kototo mu a̱ ta̱ kuwa̱,</para>
  <para style="q2" vid="PSA 63:9">a̱ ta̱ ka̱ra̱ a̱ cipa̱ uba̱ta̱ wa̱ a̱kwa̱kwa̱.<verse eid="PSA 63:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10" />Oto o una le na̱ matsun me pe'eni,</para>
  <para style="q2" vid="PSA 63:10">o to o'wo ilyalya i musa̱n mu una.<verse eid="PSA 63:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11" />Amma mogono ma ta yuwan ma̱za̱nga̱ na̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 63:11">aza a na a kucinai na Aala a̱ A̱sula̱</para>
  <para style="q2" vid="PSA 63:11">a ta yuwan ma̱za̱nga̱,</para>
  <para style="q1" vid="PSA 63:11">amma A̱sula̱ a̱ ta̱ ɓa̱ru</para>
  <para style="q2" vid="PSA 63:11">na̱ va̱ a̱za̱ e epen.<verse eid="PSA 63:11" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" sid="PSA 64" />
  <para style="s">Vu soko mu e ekere a̱za̱ e iwuya</para>
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Ica ya̱ Da̱wuda.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1" />A̱sula̱, vu uwwa uɗyo u va̱,</para>
  <para style="q2" vid="PSA 64:1">a mantsa ma na n ri</para>
  <para style="q2" vid="PSA 64:1">adansa ili i na ya̱a̱ ɓa̱la̱ mu,</para>
  <para style="q1" vid="PSA 64:1">vu geshe wuma u va̱</para>
  <para style="q2" vid="PSA 64:1">e ekere o ulamu wu n'yuwatan n va̱.<verse eid="PSA 64:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2" />Vu soko mu e ekere e ifoɓi</para>
  <para style="q2" vid="PSA 64:2">yu usokowu wa̱ a̱za̱ e iwuya,</para>
  <para style="q1" vid="PSA 64:2">na̱ diga e iɓolo ya aza a na</para>
  <para style="q2" vid="PSA 64:2">a yuwusan ulinga wi iwuya.<verse eid="PSA 64:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3" />E tewen ta̱ elentsu e le</para>
  <para style="q2" vid="PSA 64:3">cine vu revei matsun me pe'eni,</para>
  <para style="q1" vid="PSA 64:3">e tewushen idanshi i le cine vu revei</para>
  <para style="q2" vid="PSA 64:3">aya i na i ri na̱ tsukono.<verse eid="PSA 64:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4" />A tsu pa'an ta̱ a tawan</para>
  <para style="q2" vid="PSA 64:4">vuma na ri nu unusu shi,</para>
  <para style="q2" vid="PSA 64:4">babu usa̱n a tsu tawan ta̱ babu wovon.<verse eid="PSA 64:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5" />A̱ tsu bula̱ a̱tsuma̱ a linga vi iwuya i le shi,</para>
  <para style="q2" vid="PSA 64:5">a tsu calai ta̱ adanshi a̱tsuma̱ a maza me iwuya i le.</para>
  <para style="q1" vid="PSA 64:5">Usokowu u ɗa a̱ tsu foɓo maza me le,</para>
  <para style="q2" vid="PSA 64:5">adansa, &lt;&lt;Zane ɗa a gura e ene le?&gt;&gt;<verse eid="PSA 64:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6" />A mantsa ma na o foɓoi iwuya i le,</para>
  <para style="q2" vid="PSA 64:6">a tsu damma ta̱,</para>
  <para style="q1" vid="PSA 64:6">&lt;&lt;Tsu yuwan ta̱ ifoɓi yi iwuya</para>
  <para style="q2" vid="PSA 64:6">i na i ri ulobonu!&gt;&gt;</para>
  <para style="q1" vid="PSA 64:6">Amayun okolo a vuma</para>
  <para style="q2" vid="PSA 64:6">oɓolo na̱ majiyan ma̱ yi,</para>
  <para style="q2" vid="PSA 64:6">a̱ ta̱ usa̱n u mereve.<verse eid="PSA 64:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7" />Amma A̱sula̱ a ta tawan le na aya ya̱ yi,</para>
  <para style="q2" vid="PSA 64:7">babu usa̱n a ta amaton le.<verse eid="PSA 64:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8" />U ta vadala elentsu ele a aci e le</para>
  <para style="q2" vid="PSA 64:8">waru u ta̱wa̱a̱ le nu ukototosu,</para>
  <para style="q2" vid="PSA 64:8">aza a na e ene nle suru a̱ ta̱ je'en lipu.<verse eid="PSA 64:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9" />Ama suru a ta uwwa wovon,</para>
  <para style="q2" vid="PSA 64:9">a̱vu a damma ili i na A̱sula̱ a yuwain,</para>
  <para style="q1" vid="PSA 64:9">reve fo a yuwan majiyan</para>
  <para style="q2" vid="PSA 64:9">me ili i na u yuwain.<verse eid="PSA 64:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10" />Lyawa a̱za̱ a̱ a̱ɓula̱ a yuwan ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 64:10">a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva,</para>
  <para style="q1" vid="PSA 64:10">Waru a zami yu upa'atan ya̱'a̱ yi!</para>
  <para style="q2" vid="PSA 64:10">Lyawa aza a amayun o okolo suru a cuwa yi!<verse eid="PSA 64:10" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" sid="PSA 65" />
  <para style="s">Ishipa yu ugodyusho</para>
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Ica ya̱ Da̱wuda. Ishipa i ro.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1" />Vu ntsaa ta̱ a cuwa wu A̱sula̱,</para>
  <para style="q2" vid="PSA 65:1">a̱tsuma̱ a̱ Sihiyona,</para>
  <para style="q2" vid="PSA 65:1">ya̱'a̱ wu ɗa tso o shiton akucunu a̱ tsu.<verse eid="PSA 65:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2" />A̱vu na vaa uwwusa avasa,</para>
  <para style="q2" vid="PSA 65:2">vaɗilima̱ suru ta̱ ta̱wa̱ ya̱'a̱ wu.<verse eid="PSA 65:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3" />A mantsa ma na nusu la'ai ucira u tsu,</para>
  <para style="q2" vid="PSA 65:3">vu yuwaan tsu gafura vu nusu tsu.<verse eid="PSA 65:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4" />A̱za̱ a̱ ma̱za̱nga̱ a ɗa aza a na vu ɗangwai,</para>
  <para style="q2" vid="PSA 65:4">a̱vu vu ta̱wa̱to le zuzu</para>
  <para style="q2" vid="PSA 65:4">tsa̱ra̱ a̱ da̱nu o ukowo wa̱ wu!</para>
  <para style="q1" vid="PSA 65:4">Tsu cuwa̱n ta̱ ni ili i sa'ani yu u'wa ya̱ wu,</para>
  <para style="q2" vid="PSA 65:4">na̱ a̱za̱ a̱ A̱a̱'isamapaɗa a akiza a̱ wu.<verse eid="PSA 65:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5" />Vu usu tsu na̱ linga va asalama va̱ a̱ɓula̱,</para>
  <para style="q2" vid="PSA 65:5">A̱sula̱ za vi iwawi i tsu.</para>
  <para style="q1" vid="PSA 65:5">A̱vu ɗa uzuwu wo okolo o uvaɗi ma̱ɓula̱,</para>
  <para style="q2" vid="PSA 65:5">hali fo na aza a na</para>
  <para style="q2" vid="PSA 65:5">a̱ ri ɗe o upasalai u mala.<verse eid="PSA 65:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6" />Za na yuwain nsasan nu ucira wa̱ yi,</para>
  <para style="q2" vid="PSA 65:6">wotowu na̱ a̱ra̱ga̱ o ucira.<verse eid="PSA 65:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7" />A̱vu ɗa vi isawatoin ma̱gugwa̱ ma mala,</para>
  <para style="q2" vid="PSA 65:7">ni ilama yi ikeɗu i le</para>
  <para style="q2" vid="PSA 65:7">oɓolo na̱ yisali yi nɗa.<verse eid="PSA 65:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8" />Aza a na a̱ ri nden o ukosu wu uvaɗi</para>
  <para style="q2" vid="PSA 65:8">a ta uwwusa wovon</para>
  <para style="q2" vid="PSA 65:8">wi iroci yi linga va asalama a̱ wu.</para>
  <para style="q1" vid="PSA 65:8">Diga asana a̱ tyo a̱livu</para>
  <para style="q2" vid="PSA 65:8">vu ta zuwusa le a̱ 'ya̱sa̱sa̱n uɗyo u ma̱za̱nga̱.<verse eid="PSA 65:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9" />Vu ta̱ e idanasa iɗa</para>
  <para style="q2" vid="PSA 65:9">ana va̱a̱ lyungusa̱a̱ yi ni iro'i,</para>
  <para style="q2" vid="PSA 65:9">waru vu tsu zuwai ta̱ ulobono lon.</para>
  <para style="q1" vid="PSA 65:9">Muko'o ma̱ A̱sula̱ n shiwan ta̱ na̱ mini,</para>
  <para style="q2" vid="PSA 65:9">tsa̱ra̱ a ca ama itana yu uɗuma̱,</para>
  <para style="q2" vid="PSA 65:9">adama a na ne ɗa vu foɓoi.<verse eid="PSA 65:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10" />Vu tsu ca ta̱ a̱ɗuma̱ mini,</para>
  <para style="q2" vid="PSA 65:10">vu tsu re'weto ta̱ ikeɗu,</para>
  <para style="q1" vid="PSA 65:10">wo o'wo pati ni iro'i,</para>
  <para style="q2" vid="PSA 65:10">reve fo vu zuwaa ili i na a̱ cu'wa̱in aba'un.<verse eid="PSA 65:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11" />A̱sula̱, adama e isa'ani ya̱ wu,</para>
  <para style="q2" vid="PSA 65:11">a̱ tsura̱ ta̱ lyushi sa'ani</para>
  <para style="q1" vid="PSA 65:11">hali fo ikeke ya̱ wu i shunwa</para>
  <para style="q2" vid="PSA 65:11">a̱ ka̱ra̱ o moco.<verse eid="PSA 65:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12" />Anlya a̱tsumona a shunwa ta̱ lon,</para>
  <para style="q2" vid="PSA 65:12">nsasan n ɓa̱ru ta̱ na̱ ma̱za̱nga̱.<verse eid="PSA 65:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13" />Uba̱ta̱ wa aguɓa a̱ a̱rumbu</para>
  <para style="q2" vid="PSA 65:13">u shunwa ta̱ no oɓolo e ikyon.</para>
  <para style="q1" vid="PSA 65:13">Waru ka̱ri shunwa ta̱</para>
  <para style="q2" vid="PSA 65:13">ni itana yu uɗuma̱,</para>
  <para style="q1" vid="PSA 65:13">a̱ 'ya̱susa̱n uɗyo wi ishipa</para>
  <para style="q2" vid="PSA 65:13">adama a̱ ma̱za̱nga̱.<verse eid="PSA 65:13" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" sid="PSA 66" />
  <para style="s">Ishipa yi ica adama e isa'ani ya̱ A̱sula̱</para>
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Ishipa yi Ica.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1" />Uvaɗi ma̱ɓula̱ i yuwaan A̱sula̱ yorori i ma̱za̱nga̱!<verse eid="PSA 66:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 66:2" />I cana ishipa i tsugbain a̱ tyo ala a̱ yi,</para>
  <para style="q2" vid="PSA 66:2">i zuwa ica ya̱ yi i da̱na̱ na̱ tsugbain!<verse eid="PSA 66:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3" />I damma A̱sula̱,</para>
  <para style="q2" vid="PSA 66:3">&lt;&lt;A te ɗa iroci yi linga wovon va̱ wu ya asalama!</para>
  <para style="q1" vid="PSA 66:3">Ucira wa̱ wu u ta̱ mgbain lon,</para>
  <para style="q2" vid="PSA 66:3">hali na n'yuwatan ma̱ wu n tsu kingyo</para>
  <para style="q2" vid="PSA 66:3">elime a̱ wu na̱ wovon!<verse eid="PSA 66:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4" />Uvaɗi ma̱ɓula̱ a̱ kingyo ta̱ elime a̱ wu</para>
  <para style="q2" vid="PSA 66:4">a canasa wu ishipa yi ica,</para>
  <para style="q2" vid="PSA 66:4">a canasaa a ala a̱ wu ishipa yi ica.&gt;&gt; <char style="qs">Wivuwun</char><verse eid="PSA 66:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5" />Ta̱wa̱i ye ene ili i na A̱sula̱ a yuwain,</para>
  <para style="q2" vid="PSA 66:5">linga wovon va asalama a̱ yi</para>
  <para style="q2" vid="PSA 66:5">aza a na u yuwain e ekere a vaɗilima̱.<verse eid="PSA 66:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6" />U ka̱mba̱to ta̱ mala iɗa yu u'yewu,<note caller="-" style="x"><char style="xo" closed="false">66:6 </char><char style="xt" closed="false"><ref loc="EXO 14:21">Mta̱ 14:21</ref>; <ref loc="JOS 3:14-17">Jos 3:14-17</ref>.</char></note></para>
  <para style="q2" vid="PSA 66:6">a̱vu ama a pasa uɗolu'u na ana,</para>
  <para style="q2" vid="PSA 66:6">lyawa tsu yuwain ma̱za̱nga̱ a̱tsuma̱ a̱ yi.<verse eid="PSA 66:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7" />U ta yuwusan tsugbain tsa babu ukotu</para>
  <para style="q2" vid="PSA 66:7">o una̱ wu ucira wa̱ yi,</para>
  <para style="q2" vid="PSA 66:7">esu a̱ yi a̱ ta̱ a̱ a̱ka̱nla̱ a nɗa,</para>
  <para style="q1" vid="PSA 66:7">tsa̱ra̱ a̱za̱ o ugbawu</para>
  <para style="q2" vid="PSA 66:7">a cuwa aciyele wan. <char style="qs">Wivuwun</char><verse eid="PSA 66:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8" />I cuwa A̱sula̱ a̱ tsu, a̱ɗu ama suru!</para>
  <para style="q2" vid="PSA 66:8">Lyawa a uwwa uɗyo wi ica ya̱ yi.<verse eid="PSA 66:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9" />A̱yi ɗa za na e idanai wuma u tsu,</para>
  <para style="q2" vid="PSA 66:9">waru wi idanai ana a̱ tsu a na e derece.<verse eid="PSA 66:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10" />Adama a na a̱vu A̱sula̱ vu lyungwa̱ tsu ta̱,</para>
  <para style="q2" vid="PSA 66:10">reve vo o'woto tsu cece tsa azurufa.<verse eid="PSA 66:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11" />Vu ta̱wa̱to tsu ta̱ o u'wa wa ali,</para>
  <para style="q2" vid="PSA 66:11">a̱vu vu zuwaa tsu</para>
  <para style="q1" vid="PSA 66:11">itana yu ume a̱ cina̱ tsu.<verse eid="PSA 66:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12" />Vu lyawa ta̱ ama a kumba aaci a̱tsu,</para>
  <para style="q2" vid="PSA 66:12">tsu kuru ta̱ a̱tsuma̱ a akina na̱ mini,</para>
  <para style="q1" vid="PSA 66:12">amma a̱vu vu ta̱wa̱to tsu</para>
  <para style="q2" vid="PSA 66:12">uba̱ta̱ wu utsuru wa̱ a̱bunda̱.<verse eid="PSA 66:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13" />N ta̱ ta̱wa̱ o u'wa wa̱ wu</para>
  <para style="q2" vid="PSA 66:13">na̱ kucci vu ukula̱tosu</para>
  <para style="q1" vid="PSA 66:13">reve n shiton nzuwulai</para>
  <para style="q2" vid="PSA 66:13">n na n yuwain uba̱ta̱ wa̱ wu,<verse eid="PSA 66:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14" />nzuwulai n na elentsu a̱ va̱ a yuwain,</para>
  <para style="q2" vid="PSA 66:14">na̱ za na una̱ u va̱ u dammai</para>
  <para style="q2" vid="PSA 66:14">a mantsa ma na n da̱na̱i a̱tsuma̱ a̱tsuma̱lima̱.<verse eid="PSA 66:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15" />N ta ca kucci va a̱ba̱jini</para>
  <para style="q2" vid="PSA 66:15">e iliyamunga uba̱ta̱ wa̱ wu,</para>
  <para style="q1" vid="PSA 66:15">oɓolo na̱ kucci va̱ a̱a̱giri'i</para>
  <para style="q2" vid="PSA 66:15">n ta ca ogono e inan na̱ nga̱ji. <char style="qs">Wivuwun</char><verse eid="PSA 66:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16" />Ta̱wa̱i i zuwa atsuvu,</para>
  <para style="q2" vid="PSA 66:16">a̱ɗu na yaa uwwusa wovon wa̱ A̱sula̱,</para>
  <para style="q1" vid="PSA 66:16">lyawa n damma ɗu</para>
  <para style="q2" vid="PSA 66:16">ili i na u yuwaan numu.<verse eid="PSA 66:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17" />N showen yi ta̱ nu una̱ u va̱,</para>
  <para style="q2" vid="PSA 66:17">waru ica ya̱ yi i ta̱ eelentsu a̱ va̱.<verse eid="PSA 66:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18" />Na̱ shi adamma mu uwwa ta̱ uyo'o</para>
  <para style="q2" vid="PSA 66:18">wu unusu o okolo a̱ va̱,</para>
  <para style="q2" vid="PSA 66:18">A̱sulazuva a̱ shi a zuwaa mu atsuvu shi.<verse eid="PSA 66:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19" />Amma na amayun</para>
  <para style="q2" vid="PSA 66:19">A̱sula̱ a uwwa mu ta̱,</para>
  <para style="q2" vid="PSA 66:19">wu uwwa ta̱ uɗyo wa avasa a̱ va̱.<verse eid="PSA 66:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20" />Ica a̱ tyo uba̱ta̱ wa̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 66:20">za na 'yuwain avasa a̱ va̱ shi,</para>
  <para style="q2" vid="PSA 66:20">ko u tawa icigi ya̱ yi i na i tsu vadala shi</para>
  <para style="q2" vid="PSA 66:20">a̱ tyo ya̱'a̱ va̱!<verse eid="PSA 66:20" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" sid="PSA 67" />
  <para style="s">Ishipa yu ugodyusho</para>
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Oɓolo ni itana i tsuwe'e ya akiza. Ica. Ishipa.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1" />Lyawa A̱sula̱ a yuwaan tsu isa'ani</para>
  <para style="q2" vid="PSA 67:1">a̱vu u zuwaa tsu aba'un,</para>
  <para style="q2" vid="PSA 67:1">waru u zuwa urewesu wa̱ yi wi ikana tsu, <char style="qs">Wivuwun</char><verse eid="PSA 67:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2" />tsa̱ra̱ e reve re va̱ wu a̱tsuma̱ o uvaɗi,</para>
  <para style="q2" vid="PSA 67:2">iwawi ya̱ wu waru a̱tsuma̱ a nɗa suru.<verse eid="PSA 67:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3" />A̱sula̱, lyawa a ama a cuwa wu,</para>
  <para style="q2" vid="PSA 67:3">lyawa a ama suru a cuwa wu.<verse eid="PSA 67:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4" />Lyawa nɗa n yuwan mere</para>
  <para style="q2" vid="PSA 67:4">a cana ishipa adama a̱ ma̱za̱nga̱,</para>
  <para style="q1" vid="PSA 67:4">adama a na vu ta yuwusan</para>
  <para style="q2" vid="PSA 67:4">tsugono tsa a ama a̱ wu na̱ a̱ɓula̱,</para>
  <para style="q1" vid="PSA 67:4">waru vu to ronusoo</para>
  <para style="q2" vid="PSA 67:4">nɗa mu uvaɗi aɗanga. <char style="qs">Wivuwun</char><verse eid="PSA 67:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5" />A̱sula̱, lyawa a ama a cuwa wu,</para>
  <para style="q2" vid="PSA 67:5">lyawa a ama suru a cuwa wu.<verse eid="PSA 67:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6" />Iɗa i ca ta̱ ugasa,</para>
  <para style="q2" vid="PSA 67:6">A̱sula̱ za na a̱ yi ɗa A̱sula̱ a̱tsu</para>
  <para style="q2" vid="PSA 67:6">a zuwaa tsu ta̱ aba'un.<verse eid="PSA 67:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7" />Lyawa A̱sula̱ a zuwaa tsu aba'un,</para>
  <para style="q2" vid="PSA 67:7">lyawa ama o ukosu wu uvaɗi ma̱ɓula̱</para>
  <para style="q2" vid="PSA 67:7">a uwwa wovon wa̱ yi.<verse eid="PSA 67:7" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" sid="PSA 68" />
  <para style="s">Ica nu ugodyusho</para>
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Ica ya̱ Da̱wuda. Ishipa. Ica.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1" />Lyawa A̱sula̱ a̱ 'yon,</para>
  <para style="q2" vid="PSA 68:1">lyawa e bete'we n'yuwatan ma̱ yi,</para>
  <para style="q1" vid="PSA 68:1">lyawa aza a na a 'yuwan niyi</para>
  <para style="q2" vid="PSA 68:1">a suma a̱ ma̱ka̱ka̱n ma̱ yi.<verse eid="PSA 68:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2" />Cine vu revei upepu</para>
  <para style="q2" vid="PSA 68:2">u tsi ivula̱ mikyon,</para>
  <para style="q2" vid="PSA 68:2">lyawa vi ivula̱ le ne.</para>
  <para style="q1" vid="PSA 68:2">Cine abaji a mani'in</para>
  <para style="q2" vid="PSA 68:2">ma̱ tsu jeruwe e elime a akina,</para>
  <para style="q1" vid="PSA 68:2">lyawa o kototo a̱za̱ e iwuya</para>
  <para style="q2" vid="PSA 68:2">a̱ ma̱ka̱ka̱n ma̱ A̱sula̱.<verse eid="PSA 68:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3" />Amma lyawa a̱za̱ a̱ a̱ɓula̱ a yuwan ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 68:3">waru a yuwan mere a̱ ma̱ka̱ka̱n ma̱ A̱sula̱,</para>
  <para style="q1" vid="PSA 68:3">lyawa a shunwa na̱</para>
  <para style="q2" vid="PSA 68:3">ma̱za̱nga̱ na̱ mere ma̱ a̱bunda̱!<verse eid="PSA 68:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4" />I canaa A̱sula̱ ishipa,</para>
  <para style="q2" vid="PSA 68:4">i canaa ala a̱ yi ica,</para>
  <para style="q1" vid="PSA 68:4">i ciɓala za na tsu katsa e eleshe.</para>
  <para style="q1" vid="PSA 68:4">A̱sulazuva a ɗa aala a̱ yi,</para>
  <para style="q2" vid="PSA 68:4">waru i yuwan ma̱za̱nga̱ elime a̱ yi!<verse eid="PSA 68:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5" />A̱sula̱ a ɗa dada vu mkpa'an</para>
  <para style="q2" vid="PSA 68:5">za na tsi idanasa nruna̱,</para>
  <para style="q2" vid="PSA 68:5">A̱sula̱ za na ri nden uba̱ta̱ wa Akiza a̱ yi.<verse eid="PSA 68:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6" />U tsu ca ta̱ aza a̱ ri nu u'wa shi uba̱ta̱ wu nde,</para>
  <para style="q2" vid="PSA 68:6">u tsu uta̱a̱ ta̱ aza a na a̱ ri o u'wa</para>
  <para style="q2" vid="PSA 68:6">reve u ca le ulyuwu we elime.</para>
  <para style="q1" vid="PSA 68:6">Amma aza a na a̱ ri na aciyogbamu</para>
  <para style="q2" vid="PSA 68:6">a̱ ta̱ da̱nu e iɗa i na i ri babu za.<verse eid="PSA 68:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7" />A̱sula̱, a mantsa ma na vu ronoyi a ama a̱ wu aaɗanga,</para>
  <para style="q2" vid="PSA 68:7">a mantsa ma na vu toniyi na̱ a̱tsumona, <char style="qs">Wivuwun</char><verse eid="PSA 68:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8" />uvaɗi u jinga̱ɗa̱ ta̱,</para>
  <para style="q2" vid="PSA 68:8">a̱vu zuva yuwan iro'i, <note caller="-" style="x"><char style="xo" closed="false">68:8 </char><char style="xt" closed="false"><ref loc="EXO 19:18">Mta̱ 19:18</ref>.</char></note></para>
  <para style="q1" vid="PSA 68:8">adama o uta̱wu wa̱ A̱sula̱ a Sinai</para>
  <para style="q2" vid="PSA 68:8">o uta̱wu wa̱ A̱sula̱ a Isra'ila.<verse eid="PSA 68:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9" />A̱sula̱, vu ca ta̱ iro'i ya̱ a̱bunda̱,</para>
  <para style="q2" vid="PSA 68:9">a̱vu vu lapula agadu a̱ wu</para>
  <para style="q2" vid="PSA 68:9">a na a̱ da̱na̱i a̱tsuma̱lima̱.<verse eid="PSA 68:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10" />Ama a̱ wu a̱ da̱nu ta̱ a̱tsuma̱ e iɗa'a,</para>
  <para style="q2" vid="PSA 68:10">waru a̱tsuma̱ a̱ a̱bunda̱ e isa'ani ya̱ wu,</para>
  <para style="q2" vid="PSA 68:10">vu tsu zamiya ta̱ alambi ili i na a cigai.<verse eid="PSA 68:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11" />A̱sulazuva a ca ta̱ udammu,</para>
  <para style="q2" vid="PSA 68:11">a̱vu a̱ma̱ci a̱ a̱bunda̱ a tara ikaka'a a̱ tyo ba̱ta̱ ro.<note caller="-" style="x"><char style="xo" closed="false">68:11 </char><char style="xt" closed="false"><ref loc="EXO 15:20-21">Mta̱ 15:20-21</ref>; <ref loc="1SA 18:6-7">1 Sam 18:6-7</ref>.</char></note><verse eid="PSA 68:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12" />A̱vu a damma,</para>
  <para style="q2" vid="PSA 68:12">&lt;&lt;Ngono na̱ a̱soja e le a suma ta̱ keɗu!</para>
  <para style="q1" vid="PSA 68:12">A̱ma̱ci a na a̱ ri a 'wa</para>
  <para style="q2" vid="PSA 68:12">a̱ ta̱ e ne'eshe itana</para>
  <para style="q2" vid="PSA 68:12">i na a̱ pura̱i uba̱ta̱ o uvon.<verse eid="PSA 68:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13" />Hali fo na̱ a̱ɗu na i ri nden</para>
  <para style="q2" vid="PSA 68:13">a̱tsuma̱ e iɓolo e ikyon,</para>
  <para style="q1" vid="PSA 68:13">i ta gura pupala aciya̱ɗu</para>
  <para style="q2" vid="PSA 68:13">ni itana i zinariya na̱ azurufa,</para>
  <para style="q2" vid="PSA 68:13">cine evelu a muɗa a tsu pupala yi.&gt;&gt;<verse eid="PSA 68:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14" />Mantsa ma na Mogono me Ili Suru</para>
  <para style="q2" vid="PSA 68:14">me bete'wei ngono e iɗa'a</para>
  <para style="q2" vid="PSA 68:14">u to o'wo va damma mini ma atayan</para>
  <para style="q2" vid="PSA 68:14">mo oco ta̱ a̱tsuma̱ a Zalumo.<verse eid="PSA 68:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15" />Masasan ma̱ Bashan, masasan ma A̱sula̱,</para>
  <para style="q2" vid="PSA 68:15">a̱vu masasan mo o uga'an,</para>
  <para style="q2" vid="PSA 68:15">masasan ma Bashan.<verse eid="PSA 68:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16" />Adama a̱ nye i ɗa vu ri a̱ a̱ka̱nla̱ na̱ tsushu'un,</para>
  <para style="q2" vid="PSA 68:16">a̱vu masasan mo o uga'an,</para>
  <para style="q1" vid="PSA 68:16">masasan ma na A̱sula̱ a ɗangwai</para>
  <para style="q2" vid="PSA 68:16">mo o'wo uba̱ta̱ wu nden ma̱ yi,</para>
  <para style="q2" vid="PSA 68:16">uba̱ta̱ u na A̱sulazuva a̱ da̱nu babu ukotu?<verse eid="PSA 68:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17" />Ikeke yi ido ya̱ A̱sula̱ ukpakukupa kupa ɗa,</para>
  <para style="q2" vid="PSA 68:17">oɓolo nu ukpakukupa ukpakukupa,</para>
  <para style="q1" vid="PSA 68:17">A̱sulazuva a̱ cipa̱ ta̱ diga a Masasan ma Sinai</para>
  <para style="q2" vid="PSA 68:17">a̱ tyo a̱ a̱a̱'isa̱ Akiza a̱ yi.<verse eid="PSA 68:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18" />A mantsa ma na vu kumbai zuva,</para>
  <para style="q2" vid="PSA 68:18">vu tarai aza a na a̱ shi e remei,</para>
  <para style="q2" vid="PSA 68:18">vu ka̱ra̱ ne le ugeru ugeru,</para>
  <para style="q1" vid="PSA 68:18">vu ushi ta̱ ne'e gbain gbain va̱ a̱bunda̱</para>
  <para style="q2" vid="PSA 68:18">diga e ekere a vaɗilima̱,</para>
  <para style="q1" vid="PSA 68:18">hali fo na̱ diga e ekere</para>
  <para style="q2" vid="PSA 68:18">a̱za̱ o 'ya̱susa̱n wu ugbozu.</para>
  <para style="q1" vid="PSA 68:18">Na amayun A̱sulazuva A̱sula̱</para>
  <para style="q2" vid="PSA 68:18">a̱ ta̱ da̱nu uba̱ta̱'a̱.<verse eid="PSA 68:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19" />Ica a̱ tyo uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 68:19">a̱ tyo uba̱ta̱ wa̱ A̱sula̱ za vi iwawi i tsu,</para>
  <para style="q1" vid="PSA 68:19">za na a tanusu a̱tsuma̱lima̱ a̱tsu</para>
  <para style="q2" vid="PSA 68:19">wa ana'an na̱ nfa'an suru. <char style="qs">Wivuwun</char><verse eid="PSA 68:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20" />A̱sula̱ a̱tsu, A̱sula̱ a ɗa</para>
  <para style="q2" vid="PSA 68:20">za na tsu wawa,</para>
  <para style="q1" vid="PSA 68:20">diga uba̱ta̱ wa̱ A̱sulazuva zagbain a ɗa,</para>
  <para style="q2" vid="PSA 68:20">za tsu la'a diga o ukwa̱.<verse eid="PSA 68:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21" />Amayun A̱sula̱ oto o ɓoso</para>
  <para style="q2" vid="PSA 68:21">aci a n'yuwatan ma̱ yi,</para>
  <para style="q1" vid="PSA 68:21">u minjira okoluwo aza a na</para>
  <para style="q2" vid="PSA 68:21">a lyuwusa elime o unusu u le.<verse eid="PSA 68:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22" />A̱sulazuva a damma ta̱,</para>
  <para style="q2" vid="PSA 68:22">&lt;&lt;N ta̱ ta̱wa̱to le diga Bashan,</para>
  <para style="q2" vid="PSA 68:22">n ta̱ ta̱wa̱to le diga a̱ru'un a mala,<verse eid="PSA 68:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23" />adama yi za̱'wa̱ ana a̱ ɗu</para>
  <para style="q2" vid="PSA 68:23">a̱tsuma̱ a mpasa mu n'yuwatan nɗu,</para>
  <para style="q1" vid="PSA 68:23">hali na musa̱n n ɗu</para>
  <para style="q2" vid="PSA 68:23">ma̱a̱ tsura̱ akunda e le fo.&gt;&gt;<verse eid="PSA 68:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24" />A̱sula̱, ama suru e ene ta̱</para>
  <para style="q2" vid="PSA 68:24">cu'un vu mmalu wu ulyuwu we elime a̱ wu,</para>
  <para style="q1" vid="PSA 68:24">cu'un vu mmalu ma̱ A̱sula̱ mogono ma̱ va̱,</para>
  <para style="q2" vid="PSA 68:24">a̱ tyo Uba̱ta̱ wa Akiza.<verse eid="PSA 68:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25" />Ndobiya n ɗa elime,</para>
  <para style="q2" vid="PSA 68:25">Ndaniya waru o tono,</para>
  <para style="q1" vid="PSA 68:25">a̱tsuma̱ e le a̱ da̱na̱ ta̱ na̱ muwun me esheli</para>
  <para style="q2" vid="PSA 68:25">a wa'asa aganga.<verse eid="PSA 68:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26" />Cuwai A̱sula̱ a̱tsuma̱ a̱ba̱jini e iɓolo,</para>
  <para style="q2" vid="PSA 68:26">cuwai A̱sulazuva a̱tsuma̱ e iɓolo,</para>
  <para style="q2" vid="PSA 68:26">ya aza a Isra'ila.<verse eid="PSA 68:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27" />Apa ugundo wa̱ Banyami,</para>
  <para style="q2" vid="PSA 68:27">u na u la'ai uka̱la̱mu a̱tsuma̱ e le</para>
  <para style="q2" vid="PSA 68:27">o ronoso le aɗanga,</para>
  <para style="q1" vid="PSA 68:27">she azagbain a Yahuda</para>
  <para style="q2" vid="PSA 68:27">oɓolo na azagbain a̱ Zebulun</para>
  <para style="q2" vid="PSA 68:27">oɓolo na azagbain a Nafutali o tono.<verse eid="PSA 68:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28" />A̱sula̱, vu roco ucira wa̱ wu,</para>
  <para style="q2" vid="PSA 68:28">vu roco ucira wa̱ wu</para>
  <para style="q2" vid="PSA 68:28">cine vu rocoyi nu ufaru.<verse eid="PSA 68:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29" />Adama a na A̱a̱'isamapaɗa a̱ wu</para>
  <para style="q2" vid="PSA 68:29">a na a̱ ri a̱tsuma̱ a̱ Urishelima,</para>
  <para style="q2" vid="PSA 68:29">ngono n ta̱ ta̱wa̱a̱ wu na̱ ne'e ɗe.<verse eid="PSA 68:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30" />Vu ɓara nɗa n na n ri a̱ tsushu'un na̱ a̱tsu,</para>
  <para style="q2" vid="PSA 68:30">nama na tsu pa'an</para>
  <para style="q2" vid="PSA 68:30">apumpu o una̱ wu uɗolu.</para>
  <para style="q1" vid="PSA 68:30">Vu ɓara oɓolo e inan i ndolo</para>
  <para style="q2" vid="PSA 68:30">aza a na a̱ ri nden a̱tsuma̱ a̱ ma̱dindim,</para>
  <para style="q1" vid="PSA 68:30">hali she na̱ a̱ ta̱wa̱ elime a̱ wu</para>
  <para style="q2" vid="PSA 68:30">na̱ meje'en ma̱ lipu</para>
  <para style="q2" vid="PSA 68:30">a casu wu azurufa.</para>
  <para style="q1" vid="PSA 68:30">Vu bete'we nɗa n na n cigai uvon!<verse eid="PSA 68:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31" />Azagbain a̱ ta̱ ta̱wa̱ diga Masar,</para>
  <para style="q2" vid="PSA 68:31">Kush fo ta̱ ta̱wa̱to aciya̱yi uba̱ta̱ wa̱ A̱sula̱.<verse eid="PSA 68:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32" />Canayi A̱sula̱ ishipa a̱ɗu ozo o tsugono tsu uvaɗi,</para>
  <para style="q2" vid="PSA 68:32">cayi A̱sulazuva ica.<char style="qs">Wivuwun</char><verse eid="PSA 68:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33" />Canai ishipa a̱ tyo uba̱ta̱ wu za na</para>
  <para style="q2" vid="PSA 68:33">tsu kumba zuva diga ufaru,</para>
  <para style="q1" vid="PSA 68:33">a̱yi na u tsu ɓara</para>
  <para style="q2" vid="PSA 68:33">na̱ a̱ba̱jini o uɗyo.<verse eid="PSA 68:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34" />I yuwan adanshi o ucira wa̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 68:34">za na tsugbain tsa̱ yi tsa̱ ri aci a Isra'ila,</para>
  <para style="q2" vid="PSA 68:34">za na ucira wa̱ yi u ri zuva.<verse eid="PSA 68:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35" />A̱sula̱, a̱vu ili ya asalama a ɗa</para>
  <para style="q2" vid="PSA 68:35">a̱tsuma̱ o uba̱ta̱ wa Akiza a̱ wu.</para>
  <para style="q1" vid="PSA 68:35">A̱sula̱ a Isra'ila a tsu ca ta̱ ucira nu ukadu,</para>
  <para style="q2" vid="PSA 68:35">a̱ tyo uba̱ta̱ wa ama a̱ yi.</para>
  <para style="b" vid="PSA 68:35" />
  <para style="q1" vid="PSA 68:35">Ica a̱ tyo uba̱ta̱ wa̱ A̱sula̱!<verse eid="PSA 68:35" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" sid="PSA 69" />
  <para style="s">A̱sula̱ vu wawa mu</para>
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Nu uɗyo u &lt;&lt;Lili.&gt;&gt; Wa̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1" />A̱sula̱, vu wawa mu</para>
  <para style="q2" vid="PSA 69:1">adama a na mini</para>
  <para style="q2" vid="PSA 69:1">ma rawa mu ta̱ a̱ yinlu.<verse eid="PSA 69:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2" />N liɓa ta̱ a̱tsuma̱ a̱ yilyo'o ya̱ a̱ru'un,</para>
  <para style="q2" vid="PSA 69:2">uba̱ta̱ u na babu uba̱ta̱ u na a zuwa ana.</para>
  <para style="q1" vid="PSA 69:2">N uwa ta̱ a̱ mini ma̱ a̱ru'un,</para>
  <para style="q2" vid="PSA 69:2">ikeɗu i mini i la'a ta̱ ucira u va̱.<verse eid="PSA 69:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3" />N kuna̱ ta̱ e mesun me izami yi ikambishi,</para>
  <para style="q2" vid="PSA 69:3">hali uɗyo u va̱ u fula,</para>
  <para style="q1" vid="PSA 69:3">esu a̱ va̱ a tsutsa ta̱,</para>
  <para style="q2" vid="PSA 69:3">e izami ya̱ A̱sula̱ a̱ va̱.<verse eid="PSA 69:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4" />Aza a na a 'yuwan numu babu unusu,</para>
  <para style="q2" vid="PSA 69:4">a la'a ta̱ a̱bunda̱ a̱nji aaci a̱ va̱,</para>
  <para style="q1" vid="PSA 69:4">aza a na a 'yuwan numu</para>
  <para style="q2" vid="PSA 69:4">babu unusu a̱ ta̱ a̱bunda̱,</para>
  <para style="q2" vid="PSA 69:4">ele na a zama o kototo mu ne epen.</para>
  <para style="q1" vid="PSA 69:4">A zuwa mu ta̱ n ka̱mbuwa̱</para>
  <para style="q2" vid="PSA 69:4">ili i na mi iva̱i shi nu ucira.<verse eid="PSA 69:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5" />A̱sula̱, vu reve ta̱ tsulo tsa̱ va̱,</para>
  <para style="q2" vid="PSA 69:5">waru unusu u va̱ u ri usokowu</para>
  <para style="q2" vid="PSA 69:5">a̱ ma̱ka̱ka̱n ma̱ wu shi!<verse eid="PSA 69:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6" />She vu lyawa aza a na a zuwai</para>
  <para style="q2" vid="PSA 69:6">ucira u le ya̱'a̱ wu,</para>
  <para style="q2" vid="PSA 69:6">a uwwa wono adama a̱ va̱ wan.</para>
  <para style="q1" vid="PSA 69:6">A̱sulazuva, A̱sulazuva o oɓolo a̱ a̱soja a zuva,</para>
  <para style="q2" vid="PSA 69:6">lyawa aza a na a zama wu,</para>
  <para style="q2" vid="PSA 69:6">a uwwa wono adama a̱ va̱ wan,</para>
  <para style="q2" vid="PSA 69:6">a̱ A̱sula̱ aza a Isra'ila.<verse eid="PSA 69:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7" />Adama a na n kaɓa ta̱ asuvu</para>
  <para style="q2" vid="PSA 69:7">na̱ tsuzo'o adama a̱ wu,</para>
  <para style="q2" vid="PSA 69:7">waru wono u ɓa̱ru ta̱ urewesu u va̱.<verse eid="PSA 69:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8" />A̱mu mocin ɗa e ekere a̱za̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 69:8">mocin e ekere a̱ muwun ma̱ a̱na̱wun n va̱.<verse eid="PSA 69:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9" />Adama a na icigi i na</para>
  <para style="q2" vid="PSA 69:9">maa yuwusaan u'wa wa̱ wu,</para>
  <para style="q2" vid="PSA 69:9">wu una mu ta̱,</para>
  <para style="q1" vid="PSA 69:9">waru wisulusa wa aza a na a̱ ri e isulusa wu</para>
  <para style="q2" vid="PSA 69:9">a̱ ta̱ riya̱sa̱ aci a̱ va̱.<note caller="-" style="x"><char style="xo" closed="false">69:9 </char><char style="xt" closed="false"><ref loc="JHN 2:17">Yah 2:17</ref>; <ref loc="ROM 15:3">Rom 15:3</ref>.</char></note><verse eid="PSA 69:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10" />Mantsa ma na n shoyin a̱vu n yuwan akuli,</para>
  <para style="q2" vid="PSA 69:10">ko n 'yuwan n ciga</para>
  <para style="q2" vid="PSA 69:10">n kaɓa asuvu nu ulamu,<verse eid="PSA 69:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11" />mantsa ma na mo otoyi</para>
  <para style="q2" vid="PSA 69:11">itana ya̱ a̱tsumola̱ngu,</para>
  <para style="q1" vid="PSA 69:11">ama a̱ tsu ka̱mba̱to mu ta̱ ili yi izo'oshi.<verse eid="PSA 69:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12" />Aza a na a̱ ri nden eden</para>
  <para style="q2" vid="PSA 69:12">a̱ ta̱ e idami i va̱,</para>
  <para style="q1" vid="PSA 69:12">mo o'wo ta̱ ili yi ishipa</para>
  <para style="q2" vid="PSA 69:12">e ekere o ososowi.<verse eid="PSA 69:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13" />Amma a̱mu, n yuwan ta̱ avasa</para>
  <para style="q2" vid="PSA 69:13">a̱ tyo ya̱'a̱ wu A̱sulazuva,</para>
  <para style="q1" vid="PSA 69:13">a mantsa ma na ve enei wuntsa nuwu,</para>
  <para style="q2" vid="PSA 69:13">a̱tsuma̱ e icigi ya̱ wu i na i tsu vadala shi,</para>
  <para style="q2" vid="PSA 69:13">vu usu mu ni iwawi ya amayun a̱ wu.<verse eid="PSA 69:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14" />Vu wawa mu a̱tsuma̱ o yilyo'o,</para>
  <para style="q2" vid="PSA 69:14">she vu lyawa mu n liɓa wan,</para>
  <para style="q1" vid="PSA 69:14">vu wawa mu e ekere aza a na a 'yuwan numu,</para>
  <para style="q2" vid="PSA 69:14">vu papa mu diga a̱tsuma̱ a̱ mini ma̱ a̱ru'un.<verse eid="PSA 69:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15" />She vu lyawa ikeɗu i mini</para>
  <para style="q2" vid="PSA 69:15">i kpa̱to mu wan,</para>
  <para style="q2" vid="PSA 69:15">ko mala ma lyuwa mu wan,</para>
  <para style="q2" vid="PSA 69:15">ko n liɓa a̱tsuma̱ aason wan.<verse eid="PSA 69:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16" />A̱sulazuva, vu usu mu,</para>
  <para style="q2" vid="PSA 69:16">a̱tsuma̱ e icigi ya̱ wu i na i tsu vadala shi,</para>
  <para style="q1" vid="PSA 69:16">a̱tsuma̱ a̱ba̱jini e iliyali ya̱ wu</para>
  <para style="q2" vid="PSA 69:16">vu vadala ya̱'a̱ va̱.<verse eid="PSA 69:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17" />She vu sokowo aagbashi a̱ wu</para>
  <para style="q2" vid="PSA 69:17">urewesu wa̱ wu wan.</para>
  <para style="q1" vid="PSA 69:17">Vu usu mu keɗu,</para>
  <para style="q2" vid="PSA 69:17">adama a na n ta̱ pe</para>
  <para style="q2" vid="PSA 69:17">a̱tsuma̱ a addama.<verse eid="PSA 69:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18" />Rawa zuzu vu wawa mu,</para>
  <para style="q2" vid="PSA 69:18">vu wawa mu adama a n'yuwatan n va̱.<verse eid="PSA 69:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19" />Vu reve ta̱ cine</para>
  <para style="q2" vid="PSA 69:19">aa yuwusaan mu ulamu,</para>
  <para style="q2" vid="PSA 69:19">na̱ cine aa casu mu wono,</para>
  <para style="q1" vid="PSA 69:19">na̱ cine o zo'osuso mu,</para>
  <para style="q2" vid="PSA 69:19">n'yuwatan n va̱ suru a̱ ta̱ elime a̱ wu.<verse eid="PSA 69:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20" />Ookolo a̱ va̱ a kuɗa ta̱</para>
  <para style="q2" vid="PSA 69:20">adama a wisulusa u na aa yuwusaan mu,</para>
  <para style="q2" vid="PSA 69:20">agba n ri na̱ za na a kamba mu shi,</para>
  <para style="q1" vid="PSA 69:20">n zuwa ta̱ okolo adama n tsura̱ ikambishi,</para>
  <para style="q2" vid="PSA 69:20">agba babu.</para>
  <para style="q1" vid="PSA 69:20">N zuwa ta̱ okolo a na a ca mu adanshi,</para>
  <para style="q2" vid="PSA 69:20">agba n tsura̱ shi.<verse eid="PSA 69:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21" />A̱ tsuwa̱a̱n ta̱ ilyalya i va̱ yaza,</para>
  <para style="q2" vid="PSA 69:21">reve fo a ca mu</para>
  <para style="q2" vid="PSA 69:21">masayan ma̱ ina̱bi ma alamu</para>
  <para style="q1" vid="PSA 69:21">a mantsa ma na</para>
  <para style="q2" vid="PSA 69:21">ma uwwusa akuli.<note caller="-" style="x"><char style="xo" closed="false">69:21 </char><char style="xt" closed="false"><ref loc="MAT 27:48">Mat 27:48</ref>; <ref loc="MRK 15:36">Mak 15:36</ref>; <ref loc="LUK 23:26">Luk 23:26</ref>; <ref loc="JHN 19:28">Yah 19:28</ref>,<ref loc="JHN 19:29">29</ref>.</char></note><verse eid="PSA 69:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22" />Lyawa apada e le wo o'wo le maza,</para>
  <para style="q2" vid="PSA 69:22">lyawa asuvu a̱ nden e le</para>
  <para style="q2" vid="PSA 69:22">wo o'wo le ure wa̱ a̱risa̱.<verse eid="PSA 69:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23" />Lyawa esu e le a̱ rumba̱na̱</para>
  <para style="q2" vid="PSA 69:23">hali a̱ kuɗa ene ure,</para>
  <para style="q2" vid="PSA 69:23">waru ucina̱ u le wo o'wo uka̱nzu hali hali.<verse eid="PSA 69:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24" />Vu tsuwa̱a̱n le upan wa̱ wu,</para>
  <para style="q2" vid="PSA 69:24">lyawa upan wu usuɗuwu wa̱ wu,</para>
  <para style="q2" vid="PSA 69:24">u la'a ucira u le.<verse eid="PSA 69:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25" />Lyawa uba̱ta̱ wu nden nle</para>
  <para style="q2" vid="PSA 69:25">wo o'wo okongo,</para>
  <para style="q1" vid="PSA 69:25">she vu lyawa nanza da̱nu</para>
  <para style="q2" vid="PSA 69:25">a̱tsuma̱ ogodo le wan.<note caller="-" style="x"><char style="xo" closed="false">69:25 </char><char style="xt" closed="false"><ref loc="ACT 1:20">Ajy 1:20</ref>.</char></note><verse eid="PSA 69:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26" />Adama a na a ta suɗatosu</para>
  <para style="q2" vid="PSA 69:26">aza a na vu ge'eto yi,</para>
  <para style="q1" vid="PSA 69:26">waru a ta yuwusan adanshi</para>
  <para style="q2" vid="PSA 69:26">a aci a̱ aza a na</para>
  <para style="q2" vid="PSA 69:26">vu uwwato yi usa̱n.<verse eid="PSA 69:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27" />Vu da̱shi le oforo</para>
  <para style="q2" vid="PSA 69:27">e ekere a̱ nusu le,</para>
  <para style="q1" vid="PSA 69:27">she vu lyawa le</para>
  <para style="q2" vid="PSA 69:27">a uwwa uyo'o,</para>
  <para style="q2" vid="PSA 69:27">a̱tsuma̱ e iwawi ya̱ wu wan.<verse eid="PSA 69:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28" />Lyawa a̱ kimusa̱ ala e le</para>
  <para style="q2" vid="PSA 69:28">a̱tsuma̱ a aatagada a wuma,</para>
  <para style="q1" vid="PSA 69:28">waru she e kece le</para>
  <para style="q2" vid="PSA 69:28">a̱tsuma̱ o ugeru wa̱ a̱za̱ a̱ a̱ɓula̱ wan.<verse eid="PSA 69:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29" />N ta̱ pe a̱tsuma̱ a̱ mɓa̱la̱ na̱ a̱tsuma̱lima̱,</para>
  <para style="q2" vid="PSA 69:29">A̱sula̱, lyawa iwawi ya̱ wu i papa mu.<verse eid="PSA 69:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30" />N ta cuwa aala a̱ A̱sula̱ a̱tsuma̱ e ishipa,</para>
  <para style="q2" vid="PSA 69:30">a̱vu n ca yi tsugbain nu ugodyusho.<verse eid="PSA 69:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31" />Ili i nda i ta zuwa</para>
  <para style="q2" vid="PSA 69:31">A̱sulazuva a uwwa uyo'o,</para>
  <para style="q1" vid="PSA 69:31">ula'awu na̱ nan,</para>
  <para style="q2" vid="PSA 69:31">ula'awu no oogono a nan</para>
  <para style="q2" vid="PSA 69:31">na avana a̱ yi no okotsu.<verse eid="PSA 69:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32" />Alambi e te ene a̱vu a uwwa uyo'o,</para>
  <para style="q2" vid="PSA 69:32">a̱ɗu na i ri e izami ya̱ A̱sula̱</para>
  <para style="q2" vid="PSA 69:32">lyawa okolo a̱ ɗu a̱ ushi adanshi!<verse eid="PSA 69:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33" />A̱sulazuva a tsu uwwa ta̱ avasa</para>
  <para style="q2" vid="PSA 69:33">a̱za̱ e izami yi ikambishi,</para>
  <para style="q1" vid="PSA 69:33">waru u tsu rungwa̱ ama a̱ yi</para>
  <para style="q2" vid="PSA 69:33">a na e remei shi.<verse eid="PSA 69:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34" />Lyawa uvaɗi na̱ zuva cuwa yi,</para>
  <para style="q2" vid="PSA 69:34">mala ni ili i wuma</para>
  <para style="q2" vid="PSA 69:34">i na i ri a̱tsuma̱ e le suru!<verse eid="PSA 69:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35" />Adama a na A̱sula̱</para>
  <para style="q2" vid="PSA 69:35">a ta wawa Sihiyona,</para>
  <para style="q1" vid="PSA 69:35">reve waru u suwisa</para>
  <para style="q2" vid="PSA 69:35">ilyuci ya Yahuda.</para>
  <para style="q1" vid="PSA 69:35">Ɗaɗa ama a̱ da̱nu ɗe</para>
  <para style="q2" vid="PSA 69:35">a̱vu a usa uba̱ta̱'a̱.<verse eid="PSA 69:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 69:36" />Muwun ma agbashi a̱ yi n ta guza̱ yi,</para>
  <para style="q2" vid="PSA 69:36">aza a na waru a̱ ri e icigi ya ala a̱ yi</para>
  <para style="q2" vid="PSA 69:36">a̱ ta̱ da̱nu pe a̱tsuma̱ a̱ yi.<verse eid="PSA 69:36" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" sid="PSA 70" />
  <para style="s">Mesun me izami yi iwawi</para>
  <para style="r">(<ref loc="PSA 40:13-17">Ica 40:13-17</ref>)</para>
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Wa̱ Da̱wuda. Ipati.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1" />A̱sula̱, vu jika̱ vu wawa mu!</para>
  <para style="q2" vid="PSA 70:1">A̱sulazuva ta̱wa̱ gogo vu kamba mu!<verse eid="PSA 70:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2" />Lyawa aza a na a zama wuma u va̱</para>
  <para style="q2" vid="PSA 70:2">a uwwa wono, a̱vu a̱ ra̱pula̱.</para>
  <para style="q1" vid="PSA 70:2">Lyawa aza a na a uwwusa uyo'o wa atakaci a̱ va̱</para>
  <para style="q2" vid="PSA 70:2">a̱ ka̱mba̱ o sowo wono.<verse eid="PSA 70:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3" />Lyawa aza a na a dansaa mu &lt;&lt;Kushi!&gt;&gt;</para>
  <para style="q2" vid="PSA 70:3">A̱ ka̱mba̱ na̱ a̱ca̱pa̱ adama o wono u le.<verse eid="PSA 70:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4" />Amma lyawa aza a na a zama wu suru</para>
  <para style="q2" vid="PSA 70:4">a yuwan ma̱za̱nga̱ na̱ mere!</para>
  <para style="q1" vid="PSA 70:4">Lyawa aza a na a̱ ri e icigi yi iwawi ya̱ wu</para>
  <para style="q2" vid="PSA 70:4">mantsa suru a damma,</para>
  <para style="q2" vid="PSA 70:4">&lt;&lt;Lyawa A̱sulazuva a̱a̱ tsura̱ tsugbain!&gt;&gt;<verse eid="PSA 70:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5" />A̱sula̱, na̱ ne suru a̱mu za vu ulambu ɗa</para>
  <para style="q2" vid="PSA 70:5">za na cigai ikambishi,</para>
  <para style="q2" vid="PSA 70:5">vu ta̱wa̱ ya̱'a̱ va̱ gogo!</para>
  <para style="q1" vid="PSA 70:5">A̱vu ɗa zavi ikambishi i va̱</para>
  <para style="q2" vid="PSA 70:5">na̱ za vi iwawi i va̱,</para>
  <para style="q2" vid="PSA 70:5">A̱sulazuva! She vu jima wan.<verse eid="PSA 70:5" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" sid="PSA 71" />
  <para style="s">Avasa e izami i mapari i wuma</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1" />A̱sulazuva ya̱'a̱ wu ɗa n tsura̱i</para>
  <para style="q2" vid="PSA 71:1">uba̱ta̱ wu upa'atan wu ucira.</para>
  <para style="q1" vid="PSA 71:1">She vu lyawa mu,</para>
  <para style="q2" vid="PSA 71:1">mu uwwa wono wan ko ke'en.<verse eid="PSA 71:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2" />Vu wawa mu,</para>
  <para style="q2" vid="PSA 71:2">a̱vu vu kamba mu a̱tsuma̱ a̱ a̱ɓula̱ a̱ wu.</para>
  <para style="q1" vid="PSA 71:2">Vu zuwaa mu atsuvu,</para>
  <para style="q2" vid="PSA 71:2">a̱vu vu papa mu.<verse eid="PSA 71:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3" />Vo o'wo mu aatali o upa'atan wu ucira,</para>
  <para style="q2" vid="PSA 71:3">uba̱ta̱ u na ma̱a̱ da̱na̱ a̱a̱ 'ya̱wusa̱ kuci.</para>
  <para style="q1" vid="PSA 71:3">Vu ca udammu a wawa mu,</para>
  <para style="q2" vid="PSA 71:3">adama a na a̱vu ɗa aatali a̱ va̱,</para>
  <para style="q2" vid="PSA 71:3">nu ukari wu ucira u va̱.<verse eid="PSA 71:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4" />A̱sula̱ a̱ va̱, wawa mu, e ekere a̱za̱ e iwuya,</para>
  <para style="q2" vid="PSA 71:4">no o ucira wa ama a vama</para>
  <para style="q2" vid="PSA 71:4">aza a na e tse ene iliyali shi.<verse eid="PSA 71:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5" />A̱sulazuva Zagbain, ya̱'a̱ wu ɗa n zuwai okolo.</para>
  <para style="q1" vid="PSA 71:5">Ya̱'a̱ wu ɗa maa zuwusa ucira</para>
  <para style="q2" vid="PSA 71:5">diga a̱mu o tsulolobo.<verse eid="PSA 71:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6" />Diga a mantsa ma na a matsan numu,</para>
  <para style="q2" vid="PSA 71:6">n zuwa ta̱ ucira u va̱ ya̱'a̱ wu.</para>
  <para style="q1" vid="PSA 71:6">Vu zuwa ta̱ a matsan mu,</para>
  <para style="q2" vid="PSA 71:6">a̱vu ɗa maa yuwaan ica mantsa suru.<verse eid="PSA 71:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7" />Mo o'wo ta̱ iroci e ekere ama a̱bunda̱,</para>
  <para style="q2" vid="PSA 71:7">amma a̱vu ɗa uba̱ta̱ wu upa'atan wu ucira u va̱.<verse eid="PSA 71:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8" />Una̱ u va̱ u shiwan ta̱ ni ica ya̱ wu,</para>
  <para style="q2" vid="PSA 71:8">aa yuwusan adanshi a tsugbain tsa̱ wu urana suru.<verse eid="PSA 71:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9" />She vu vari mu a mantsa ma na n kutsai wan,</para>
  <para style="q2" vid="PSA 71:9">she vu kasa na̱ mu a mantsa ma na ucira u va̱ u kotoi wan.<verse eid="PSA 71:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10" />Adama a na n'yuwatan n va̱</para>
  <para style="q2" vid="PSA 71:10">n yuwan ta̱ adanshi a aci a̱ va̱,</para>
  <para style="q2" vid="PSA 71:10">aza a na a pura o una mu o ɓolo ta̱ aci.<verse eid="PSA 71:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11" />A dansa, &lt;&lt;A̱sula̱ a vari yi ta̱,</para>
  <para style="q2" vid="PSA 71:11">tsu saɓa niyi, tsu reme niyi.</para>
  <para style="q2" vid="PSA 71:11">Adama a na za lo na a wawa yi shi.&gt;&gt;<verse eid="PSA 71:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12" />A̱sula̱, she vu yuwan alanga na̱ mu wan.</para>
  <para style="q2" vid="PSA 71:12">A̱sula̱ a̱ va̱, jika̱ vu kamba mu!<verse eid="PSA 71:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13" />Lyawa aza a na aa yuwusan adanshi e epen a aci a̱ va̱</para>
  <para style="q2" vid="PSA 71:13">a̱ kuwa̱ na̱ wono.</para>
  <para style="q1" vid="PSA 71:13">Lyawa aza a na a cigai a amaton mu,</para>
  <para style="q2" vid="PSA 71:13">a uwwa wono waru o rono le e iɗa.<verse eid="PSA 71:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14" />Agba a̱mu n ta̱ zuwa okolo a̱ va̱ ya̱'a̱ wu kuci,</para>
  <para style="q2" vid="PSA 71:14">n ta̱ da̱na̱ a yuwusaan wu ica babu ukotu.<verse eid="PSA 71:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15" />N ta damma za suru, adama a̱ a̱ɓula̱ a̱ wu,</para>
  <para style="q2" vid="PSA 71:15">ni iwawi ya̱ wu urana suru,</para>
  <para style="q2" vid="PSA 71:15">ko na wo o'woi n reve a̱bunda̱ e le shi.<verse eid="PSA 71:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16" />A̱sulazuva Zagbain, n ta̱ ta̱wa̱ n damma</para>
  <para style="q2" vid="PSA 71:16">linga gbagbain va̱ wu,</para>
  <para style="q1" vid="PSA 71:16">n ta damma a̱ɓula̱ a wu,</para>
  <para style="q2" vid="PSA 71:16">za va̱ wu goon.<verse eid="PSA 71:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17" />A̱sula̱, a̱vu ɗa vu rito numu</para>
  <para style="q2" vid="PSA 71:17">diga a̱mu o tsulolobo,</para>
  <para style="q1" vid="PSA 71:17">waru hali a̱ tyo ana'an n ta yuwusan adanshi</para>
  <para style="q2" vid="PSA 71:17">a linga va asalama a̱ wu.<verse eid="PSA 71:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18" />A̱sula̱, ko na̱ n shi n kutsa na̱ yono,</para>
  <para style="q2" vid="PSA 71:18">she vu vari mu wan,</para>
  <para style="q1" vid="PSA 71:18">hali she na̱ n damma</para>
  <para style="q2" vid="PSA 71:18">mantsa ma na ma̱ ta̱wa̱ a ɗa a linga gbagbain va̱ wu</para>
  <para style="q2" vid="PSA 71:18">nu ucira wa̱ wu e ekere aza a na a̱ ri lo a̱ ta̱wa̱.<verse eid="PSA 71:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19" />A̱sula̱, a̱ɓula̱ a̱ wu a rawa ta̱ zuva,</para>
  <para style="q2" vid="PSA 71:19">a̱vu na vu yuwain linga gbagbain.</para>
  <para style="q2" vid="PSA 71:19">Zane ɗa ri tsa̱ wu?<verse eid="PSA 71:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20" />Ko na wo o'woi vu zuwa me enei</para>
  <para style="q2" vid="PSA 71:20">addama na̱ meleshe ma̱ a̱bunda̱,</para>
  <para style="q1" vid="PSA 71:20">vu ta̱ ka̱mbuwa̱a̱ mu na̱ wuma u va̱,</para>
  <para style="q2" vid="PSA 71:20">vaa lyawa mu n kuwa̱ shi.<verse eid="PSA 71:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21" />Vu ta̱ da̱shi mu tsugbain,</para>
  <para style="q2" vid="PSA 71:21">a̱vu vu cayisa mu asuvu nden.<verse eid="PSA 71:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22" />A̱sula̱ a̱ va̱, n ta cuwa wu</para>
  <para style="q2" vid="PSA 71:22">ni igaraya, adama a amayun a̱ wu.</para>
  <para style="q1" vid="PSA 71:22">N ta canaa wu ishipa yi ica ni ikumburu,</para>
  <para style="q2" vid="PSA 71:22">a̱vu Za va Akiza a Isra'ila.<verse eid="PSA 71:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23" />N ta̱ 'ya̱sa̱n uɗyo u yisaali i ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 71:23">a mantsa ma na ma yuwusaan wu ishipa yi ica,</para>
  <para style="q2" vid="PSA 71:23">adama a na vu wawa numu.<verse eid="PSA 71:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24" />N ta yuwan adanshi a linga va̱ a̱ɓula̱ a̱ wu urana suru,</para>
  <para style="q2" vid="PSA 71:24">adama a na aza a na a zama na amaton mu</para>
  <para style="q2" vid="PSA 71:24">a uwwa ta̱ wono reve a uwwa lipu.<verse eid="PSA 71:24" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" sid="PSA 72" />
  <para style="s">Tsugono tsa̱ mogono za va̱ a̱ɓula̱</para>
  <para style="d">Ica ya̱ Sulemanu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1" />A̱sula̱, vu kamba mogono</para>
  <para style="q2" vid="PSA 72:1">na waa yuwan uge'etosu wa amayun,</para>
  <para style="q2" vid="PSA 72:1">vu ca yi a̱ɓula̱ a̱ wu,<verse eid="PSA 72:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2" />na wee ge'eto ama a̱ wu na̱ a̱ɓula̱,</para>
  <para style="q2" vid="PSA 72:2">aza a na oo ɓongishi na̱ mejege.<verse eid="PSA 72:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3" />Lyawa nsasan n ta̱wa̱a̱ ama nu ulyuwu we elime,</para>
  <para style="q2" vid="PSA 72:3">agaɗi waru o uta̱a̱ ili ya̱ a̱ɓula̱.<verse eid="PSA 72:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4" />Lyawa mogono me isawaan aza a na oo ɓongishi a̱tsuma̱ a ama,</para>
  <para style="q2" vid="PSA 72:4">waru u wawa muwun ma aza a na a cigai ikambishi,</para>
  <para style="q2" vid="PSA 72:4">a̱vu u kototo a̱za̱ o ule'e.<verse eid="PSA 72:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5" />Lyawa a uwwa wovon wa̱ wu</para>
  <para style="q2" vid="PSA 72:5">nna̱ urana na̱ woto a̱ ri zuva,</para>
  <para style="q2" vid="PSA 72:5">diga mantsa a̱ tyo mantsa.<verse eid="PSA 72:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6" />Lyawa mogono mo o'wo tse e iro'i a anlya a na oo topuso</para>
  <para style="q2" vid="PSA 72:6">tsa̱ yiji'in i na yo ocusho e iɗa.<verse eid="PSA 72:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7" />Lyawa a̱tsuma̱ a rana va̱ yi a̱za̱ a̱ɓula̱ a bala,</para>
  <para style="q2" vid="PSA 72:7">waru ulyuwu we elime u da̱na̱ lo</para>
  <para style="q2" vid="PSA 72:7">hali she na̱ woto u puwa̱a̱n.<verse eid="PSA 72:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8" />Lyawa u yuwan tsugono diga a mala a̱ tyo a mala,</para>
  <para style="q2" vid="PSA 72:8">diga o Uɗolu wa̱ Yufiriti a̱ tyo o ukosu wu uvaɗi.<note caller="-" style="x"><char style="xo" closed="false">72:8 </char><char style="xt" closed="false"><ref loc="ZEC 9:10">Zak 9:10</ref>.</char></note><verse eid="PSA 72:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9" />Lyawa gundo na ri a̱tsumona a̱ kingyowa̱ yi,</para>
  <para style="q2" vid="PSA 72:9">waru n'yuwatan ma̱ yi o kototo le.<verse eid="PSA 72:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10" />Lyawa ngono ma Tarshishi</para>
  <para style="q2" vid="PSA 72:10">na aza a na a̱ ri a pasu vu nge'en m mala,</para>
  <para style="q2" vid="PSA 72:10">a̱ ta̱wa̱a̱ yi nu utafa ule.</para>
  <para style="q1" vid="PSA 72:10">Lyawa ngono ma Sheba na̱ Seba</para>
  <para style="q2" vid="PSA 72:10">a̱ ta̱wa̱a̱ yi na̱ ne'e.<verse eid="PSA 72:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11" />Lyawa ngono suru a̱ ka̱ɗa̱towa̱ yi,</para>
  <para style="q2" vid="PSA 72:11">waru nɗa n yuwaan yi a̱ga̱nda̱ suru.<verse eid="PSA 72:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12" />Adama a na u ta wawa aza a na a cigai ikambishi</para>
  <para style="q2" vid="PSA 72:12">a na a̱ showen niyi,</para>
  <para style="q1" vid="PSA 72:12">aza a na oo ɓongishi</para>
  <para style="q2" vid="PSA 72:12">agba a̱ ri na̱ za na aa kamba le shi.<verse eid="PSA 72:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13" />U te ene iliyali ya aza a na a̱ ri babu ucira na̱ a̱za̱ o ulambu,</para>
  <para style="q2" vid="PSA 72:13">waru u wawa wuma wa aza a na a cigai ikambishi.<verse eid="PSA 72:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14" />U ta wawa le diga e ekere aza a na oo ɓongishi le</para>
  <para style="q2" vid="PSA 72:14">na aza a na ee le'eshe le,</para>
  <para style="q2" vid="PSA 72:14">adama a na wuma u le u tu ulobonu uba̱ta̱ wa̱ yi.<verse eid="PSA 72:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15" />Wuma u mogono u jima!</para>
  <para style="q2" vid="PSA 72:15">Lyawa a ca yi zinariya diga Sheba.</para>
  <para style="q1" vid="PSA 72:15">Lyawa ama a yuwaan yi avasa mantsa suru,</para>
  <para style="q2" vid="PSA 72:15">a pati A̱sula̱ a zuwaa yi aba'un urana suru.<verse eid="PSA 72:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16" />Lyawa a̱ tsura̱ ishina ya̱a̱ a̱bunda̱ a̱tsuma̱ e iɗa'a.</para>
  <para style="q2" vid="PSA 72:16">Lyawa itana yu una i shiton agaɗi,</para>
  <para style="q2" vid="PSA 72:16">a matsan muwun tsa ɗanga m Masasan ma Lebanon.</para>
  <para style="q1" vid="PSA 72:16">Lyawa ama a shiwan e ilyuci,</para>
  <para style="q2" vid="PSA 72:16">tsa anlya a atsusa.<verse eid="PSA 72:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17" />Lyawa ala o mogono a̱ da̱na̱ lo hali hali,</para>
  <para style="q2" vid="PSA 72:17">lyawa u lyuwa elime nnu urana u ri lo.</para>
  <para style="b" vid="PSA 72:17" />
  <para style="q1" vid="PSA 72:17">Lyawa nɗa suru n tsura̱ aba'un o una̱ wa̱ yi,</para>
  <para style="q2" vid="PSA 72:17">a̱vu e ɗe yi za va aba'un.<verse eid="PSA 72:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18" />Lyawa tsu cuwayi</para>
  <para style="q2" vid="PSA 72:18">A̱sulazuva A̱sula̱ aza a Isra'ila,</para>
  <para style="q2" vid="PSA 72:18">za na a̱yi ɗa goon tsu yuwan linga va asalama!<verse eid="PSA 72:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19" />Lyawa tsu cuwayi ala a tsugbain tsa̱ yi babu ukotu.</para>
  <para style="q2" vid="PSA 72:19">Lyawa uvaɗi ma̱ɓula̱ u shiwan na̱ tsugbain tsa̱ yi.</para>
  <para style="qc" vid="PSA 72:19">Ami! Ami!<verse eid="PSA 72:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20" />A̱yi ɗa ukosu wa avasa a̱ Da̱wuda ulobo wa̱ Yese.<verse eid="PSA 72:20" /></para>
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" sid="PSA 73" />
  <para style="ms">Aatagada a ta'atsu</para>
  <para style="mr">(<ref loc="PSA 73">Ica 73</ref>)</para>
  <para style="d">Ishipa ya Asaf.</para>
  <para style="s">Ukosu wa̱ a̱za̱ e iwuya</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1" />Amayun, A̱sula̱ za vi isa'ani ɗa e ekere aza a Isra'ila,</para>
  <para style="q2" vid="PSA 73:1">aza a na okolo e le a̱ ri cece.<verse eid="PSA 73:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2" />Amma n shi ta̱ n yuwan zuzu na moo uta̱a̱ okolo,</para>
  <para style="q2" vid="PSA 73:2">waru uzuwu wo okolo a̱ va̱ o koto ta̱,<verse eid="PSA 73:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3" />adama a na n yuwain tsushu'un na̱ a̱za̱ o uvaɗu</para>
  <para style="q2" vid="PSA 73:3">mantsa ma na me enei a̱za̱ e iwuya a lyuwusa elime.<verse eid="PSA 73:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4" />Babu ili i na ya̱ ɓa̱la̱ le,</para>
  <para style="q2" vid="PSA 73:4">lipu le ta̱ gbaga.<verse eid="PSA 73:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5" />Oo sowuso a̱tsuma̱lima̱ tsa akapi a ama shi,</para>
  <para style="q2" vid="PSA 73:5">waru a̱ ri ni ili i na ya̱a̱ ɓa̱la̱ le tsa akapi a ama shi.<verse eid="PSA 73:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6" />Adama o ndolo uvaɗu u ɗa wo o'wo le iliyinlu,</para>
  <para style="q2" vid="PSA 73:6">reve o otowo aciyele u'ya̱susa̱n ugbozu.<verse eid="PSA 73:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7" />Okolo e le a̱ ta̱ tapu ni iwuya</para>
  <para style="q2" vid="PSA 73:7">majiyan me iwuya i le u ri nu utyo shi.<verse eid="PSA 73:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8" />A ta yuwusaan ozo o ro ulamu adansa iwuya a aci e le,</para>
  <para style="q2" vid="PSA 73:8">a̱tsuma̱ adanshi o uvaɗu u le u ɗa oo ɓongishi ozo o ro.<verse eid="PSA 73:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9" />A ta dansa iwuya e ekere A̱sula̱ a na a̱ ri zuva,</para>
  <para style="q2" vid="PSA 73:9">waru adanshi e iwuya i le o uvaɗi ma̱ɓula̱.<verse eid="PSA 73:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10" />Adama o ndolo ama a̱ A̱sula̱ a̱ ka̱mba̱ ta̱ uba̱ta̱ u le,</para>
  <para style="q2" vid="PSA 73:10">a̱ ususu ili i na a dansa suru.<verse eid="PSA 73:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11" />A̱za̱ e iwuya a̱ tsu damma ta̱,</para>
  <para style="q2" vid="PSA 73:11">&lt;&lt;Cine A̱sula̱ ee reve?</para>
  <para style="q2" vid="PSA 73:11">Mogono ma̱ A̱sula̱ ma̱ ta̱ nu urevu?&gt;&gt;<verse eid="PSA 73:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12" />Apa cine a̱za̱ e iwuya a̱ ri,</para>
  <para style="q2" vid="PSA 73:12">mantsa suru asuvu e le a̱ ta̱ nden,</para>
  <para style="q2" vid="PSA 73:12">utsuru u le waru a̱ da̱shishi.<verse eid="PSA 73:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13" />Amayun, pere ɗa n guza̱i aciya̱va̱ cece,</para>
  <para style="q2" vid="PSA 73:13">pere ɗa n sa'ai ekere a̱ va̱ o ulambu wu unusu.<verse eid="PSA 73:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14" />Adama a na vu ta casu mu a̱tsuma̱lima̱ urana suru,</para>
  <para style="q2" vid="PSA 73:14">usana suru vu ta casu mu oforo.<verse eid="PSA 73:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15" />Na̱ shi n damma, &lt;&lt;N ta yuwan adanshi tsa̱ le,&gt;&gt;</para>
  <para style="q2" vid="PSA 73:15">n shi ta̱ a wina ama a̱ wu.<verse eid="PSA 73:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16" />Amma na n yuwain ukadu u na mee reve ili i nda suru</para>
  <para style="q2" vid="PSA 73:16">wo o'wo mu ta̱ usa̱n lon,<verse eid="PSA 73:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17" />she na n uwai a̱ a̱a̱'isa̱ a̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 73:17">ɗaɗa n revei cine a̱za̱ e iwuya oo koso.<verse eid="PSA 73:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18" />Amayun, vu zuwa le ta̱ uba̱ta̱ u na u ri ederi,</para>
  <para style="q2" vid="PSA 73:18">vu zuwa ta̱ a̱ riya̱ a̱ tyo uba̱ta̱ wu ukototosu kpa̱ra̱.<verse eid="PSA 73:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19" />Ka̱lyuwa̱, cine o kototo nle nu uta̱,</para>
  <para style="q2" vid="PSA 73:19">wovon u kototo le ta̱ suru suru.<verse eid="PSA 73:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20" />Cine alavu a̱ tsu ka̱ra̱ a mantsa ma na vuma juwain,</para>
  <para style="q2" vid="PSA 73:20">ne ɗa a̱vu Zagbain voo kototo le a mantsa ma na vu 'yoyin.<verse eid="PSA 73:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21" />Mantsa ma na okolo a̱ va̱ a̱ la̱nga̱i,</para>
  <para style="q2" vid="PSA 73:21">waru ugbozu u va̱ u 'yoyin,<verse eid="PSA 73:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 73:22" />mo o'wo ta̱ ulo za na revei ili shi,</para>
  <para style="q2" vid="PSA 73:22">mo o'wo ta̱ cine vu revei nama vu una a̱ ma̱ka̱ka̱n ma̱ wu.<verse eid="PSA 73:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23" />Na̱ ne suru n to oɓolo na̱ a̱vu kuci,</para>
  <para style="q2" vid="PSA 73:23">vu guza̱ ta̱ ukere usa'ani u va̱.<verse eid="PSA 73:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24" />Vu toni mu ta̱ na̱ a̱sa̱la̱ a̱ wu,</para>
  <para style="q2" vid="PSA 73:24">o ukosu vu ta tara mu a̱ tyo uba̱ta̱ u tsugbain.<verse eid="PSA 73:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25" />Zane ɗa n ri na̱ a̱yi ɗe zuva na ka̱ra̱i a̱vu?</para>
  <para style="q2" vid="PSA 73:25">Waru uvaɗi u ri ni ili i na n cigai na ka̱ra̱i a̱vu shi.<verse eid="PSA 73:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26" />Lipu va̱ no okolo a̱ va̱ a ta gura o o'wo babu ucira,</para>
  <para style="q2" vid="PSA 73:26">amma A̱sula̱ a ɗa ucira wo okolo a̱ va̱</para>
  <para style="q2" vid="PSA 73:26">na agadu a̱ va̱ hali hali.<verse eid="PSA 73:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27" />Aza a na a̱ ri alanga na̱ a̱vu a̱ ta̱ kuwa̱,</para>
  <para style="q2" vid="PSA 73:27">vu to kototo aza a na a̱ ri na amayun shi e ekere a̱ wu.<verse eid="PSA 73:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28" />Amma a̱mu gba, u la'aa mu ta̱ n da̱na̱ zuzu na̱ A̱sula̱.</para>
  <para style="q2" vid="PSA 73:28">N zuwa wu ta̱ A̱sulazuva Zagbain vo o'wo upa'atan u va̱</para>
  <para style="q2" vid="PSA 73:28">n ta damma linga na vu yuwain suru.<verse eid="PSA 73:28" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" sid="PSA 74" />
  <para style="s">Avasa e izami yi iwawi yi iɗa</para>
  <para style="d">Ishipa yu uyo'o ya Asaf</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1" />A̱sula̱, adama a̱ nye vu vari ntsu hali hali?</para>
  <para style="q2" vid="PSA 74:1">Adama a̱ nye upan wa̱ wu u ri a aci a ama a̱ wu ikyon ya aguɓa a̱ wu?<verse eid="PSA 74:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2" />Vu cuwan na ama a̱ wu na vu wawai ɗe nu ujimu,</para>
  <para style="q2" vid="PSA 74:2">elentsu agadu a̱ wu na vu tsupayi.</para>
  <para style="q1" vid="PSA 74:2">Vu cuwan na̱ Masasan ma̱ Sihiyona</para>
  <para style="q2" vid="PSA 74:2">uba̱ta̱ wu nden ma̱ wu.<verse eid="PSA 74:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3" />Ta̱wa̱ ve ene okongo a nda,</para>
  <para style="q2" vid="PSA 74:3">n'yuwatan n lungusa̱ ta̱ ili i na i ri pe a̱ a̱a̱'isa̱ a nda suru.<verse eid="PSA 74:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4" />N'yuwatan ma̱ wu n yuwan ta̱ yisaali yu ulyuwu wa a aci,</para>
  <para style="q2" vid="PSA 74:4">uba̱ta̱ u na vu tsu ga'asan na̱ a̱tsu.</para>
  <para style="q1" vid="PSA 74:4">Reve a̱ shuwa̱ atuta e le</para>
  <para style="q2" vid="PSA 74:4">o una̱ wi iroci yu ulyuwu wa a aci.<verse eid="PSA 74:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5" />A̱ ta̱ cine vu revei ozo o koɗo a ɗanga</para>
  <para style="q2" vid="PSA 74:5">oo koɗuso ɗanga a̱ a̱a̱rumbu na aɓau e le.<verse eid="PSA 74:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6" />Reve o ɓoso she'en na a yuwain na akpata,</para>
  <para style="q2" vid="PSA 74:6">na aɓau na̱ ma̱ka̱ta̱.<verse eid="PSA 74:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7" />A̱ kula̱to ta̱ a̱a̱'isa̱ a̱ wu</para>
  <para style="q2" vid="PSA 74:7">hali she na wo ocoi,</para>
  <para style="q2" vid="PSA 74:7">reve a̱ ka̱mba̱to uba̱ta̱ wu nden wa ala a̱ wu idaba.<verse eid="PSA 74:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8" />A̱vu a jiyan o okolo e le,</para>
  <para style="q2" vid="PSA 74:8">&lt;&lt;Tsu ta̱ rukutsa̱ le suru suru!&gt;&gt;</para>
  <para style="q2" vid="PSA 74:8">A̱vu a̱ kuloto uba̱ta̱ u na ama a yuwusaan A̱sula̱ a̱ga̱nda̱ e iɗa'a suru.<verse eid="PSA 74:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9" />Tsu da̱shi ene iroci ya asalama i ro waru shi,</para>
  <para style="q2" vid="PSA 74:9">agba vumava̱sula̱ buwa shi,</para>
  <para style="q2" vid="PSA 74:9">waru a̱tsuma̱ a̱ tsu babu za na revei urana u na ili i nda yoo koto.<verse eid="PSA 74:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10" />A̱sula̱, hali mantsa ma̱ ne ma ɗa</para>
  <para style="q2" vid="PSA 74:10">n'yuwatan maa yuwaan wu ulamu?</para>
  <para style="q2" vid="PSA 74:10">N'yuwatan n ta lyuwa elime o goroso ala a̱ wu hali hali?<verse eid="PSA 74:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11" />Adama nye vu ronoi ukere wu ucira wa̱ wu?</para>
  <para style="q2" vid="PSA 74:11">Ba̱ruwa̱ yi adama vu kototo le!<verse eid="PSA 74:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12" />Amma a̱vu A̱sula̱, a̱vu ɗa mogono ma̱ va̱ nu ujumu,</para>
  <para style="q2" vid="PSA 74:12">vu ta̱wa̱ ta̱ ni iwawi a̱tsuma̱ o uvaɗi.<verse eid="PSA 74:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13" />Vu ne'eshen ta̱ mala nu ucira wa̱ wu,</para>
  <para style="q2" vid="PSA 74:13">reve vu ɓoso aci o ododo a na a̱ ri pe a̱ mini.<note caller="-" style="x"><char style="xo" closed="false">74:13 </char><char style="xt" closed="false"><ref loc="EXO 14:21">Mta̱ 14:21</ref>.</char></note><verse eid="PSA 74:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14" />A̱vu ɗa vu rukutsa̱i aci o a̱dodo Leviyatan,<note caller="-" style="x"><char style="xo" closed="false">74:14 </char><char style="xt" closed="false"><ref loc="JOB 41:1">Ayb 41:1</ref>; <ref loc="PSA 104:26">Ica 104:26</ref>; <ref loc="ISA 27:1">Ish 27:1</ref>.</char></note></para>
  <para style="q2" vid="PSA 74:14">a̱vu vu ka̱mba̱to yi ilyalya e ekere inama yu una.<verse eid="PSA 74:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15" />A̱vu ɗa vu kpa̱tu'wa̱i esu a̱ mini na̱ ɗolu,</para>
  <para style="q2" vid="PSA 74:15">reve vu ukwaton ɗolu gbagbain.<verse eid="PSA 74:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16" />Urana na ayin a̱za̱ a̱ wu a ɗa,</para>
  <para style="q2" vid="PSA 74:16">a̱vu ɗa vu shuwa̱i urana na̱ woto.<verse eid="PSA 74:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17" />A̱vu ɗa vu zuwai tyo vu uvaɗi suru,</para>
  <para style="q2" vid="PSA 74:17">a̱vu vu zuwa mantsa ma̱ lyushi ni irana.<verse eid="PSA 74:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18" />A̱sulazuva, vu cuwan cine n'yuwatan ma̱ wu</para>
  <para style="q2" vid="PSA 74:18">maa yuwusaan wu ulamu,</para>
  <para style="q2" vid="PSA 74:18">cine olo o a̱ lungususa̱ ala a̱ wu.<verse eid="PSA 74:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19" />She vu lyawa ama a̱ wu na a̱ ri ni ikambishi shi</para>
  <para style="q2" vid="PSA 74:19">e ekere a̱za̱ a̱ e iwuya wan.</para>
  <para style="q1" vid="PSA 74:19">She vi icina na aza a na a casu</para>
  <para style="q2" vid="PSA 74:19">a̱tsuma̱lima̱ hali hali wan.<verse eid="PSA 74:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20" />Vu cuwan na̱ nzuwulai ma̱ wu,</para>
  <para style="q2" vid="PSA 74:20">adama a na u'ya̱susa̱n wu ugbozu u shiton ta̱ oboguzu e irumbu biti e iɗa'a.<verse eid="PSA 74:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21" />She vu lyawa aza a na oo ɓongishi a uwwa wono wan.</para>
  <para style="q2" vid="PSA 74:21">Lyawa alambi na aza a na a cigai ikambishi a cuwa ala a̱ wu.<verse eid="PSA 74:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22" />'Yon, A̱sula̱, vi isawaan aciya̱wu!</para>
  <para style="q2" vid="PSA 74:22">Vu cuwan cine olo a yuwusaan wu ulamu urana suru!<verse eid="PSA 74:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23" />She vi icina nu u'ya̱susa̱n wu uɗyo wu n'yuwatan ma̱ wu wan.</para>
  <para style="q2" vid="PSA 74:23">She vi icina na̱ a̱gidi'ya̱ a na n'yuwatan ma̱ wu n tsu yuwusan wan.<verse eid="PSA 74:23" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" sid="PSA 75" />
  <para style="s">A̱sula̱ o uge'etosu</para>
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya: Ica ya Asaf, a cana yi nu uɗyo &lt;&lt;She o kototo wan.&gt;&gt; Ishipa i ɗa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1" />A̱sula̱ tsu godyowo wu ta̱,</para>
  <para style="q2" vid="PSA 75:1">na amayun tsu godyowo wu ta̱</para>
  <para style="q2" vid="PSA 75:1">adama a na Ala a̱ wu a̱ ta̱ zuzu!</para>
  <para style="q1" vid="PSA 75:1">Tsu ta yuwusan adanshi</para>
  <para style="q2" vid="PSA 75:1">e ili ya asalama i na vaa yuwusan.<verse eid="PSA 75:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2" />Vu damma ta̱, &lt;&lt;N ɗangula ta̱ mantsa ma na wuntsayi wu uge'etosu.</para>
  <para style="q2" vid="PSA 75:2">A̱mu ɗa za na a yuwusan uge'etosu wa amayun.<verse eid="PSA 75:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3" />Mantsa ma na uvaɗi na ama a̱ yi a̱ jinga̱ɗa̱i suru,</para>
  <para style="q2" vid="PSA 75:3">a̱mu ɗa za na isawatoin atsura a̱ yi. <char style="qs">Wivuwun</char><verse eid="PSA 75:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4" />N damma ta̱ a̱za̱ o uvaɗu,</para>
  <para style="q2" vid="PSA 75:4">&lt;She i da̱shi yuwan uvaɗu wan.&gt;</para>
  <para style="q1" vid="PSA 75:4">A̱za̱ e iwuya fo n damma le ta̱,</para>
  <para style="q2" vid="PSA 75:4">&lt;She i 'ya̱sa̱n avangaci wan.<verse eid="PSA 75:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5" />She i 'ya̱sa̱n avangaci i yuwan nla̱ngi na̱ zuva wan,</para>
  <para style="q2" vid="PSA 75:5">she i yuwan adanshi na̱ ma̱ka̱ga̱ wan.&gt; &gt;&gt;<verse eid="PSA 75:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6" />Babu vuma ro diga asana ko a̱livu</para>
  <para style="q2" vid="PSA 75:6">ko diga a̱tsumona na waa ca aciya̱yi tsugbain.<verse eid="PSA 75:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7" />Amma A̱sula̱ a ɗa za vu uge'etosu,</para>
  <para style="q2" vid="PSA 75:7">a̱ yi ɗa u tsu ka̱ɗa̱to vuma</para>
  <para style="q2" vid="PSA 75:7">waru a̱ yi ɗa u tsu ca tsugbain.<verse eid="PSA 75:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8" />A̱sulazuva a̱ ta̱ uɓa̱nu na̱ mokkoto</para>
  <para style="q2" vid="PSA 75:8">tapu na̱ masayan ma̱ inabi ma sa'avu</para>
  <para style="q2" vid="PSA 75:8">uja̱mba̱ru ni itana yu ucita.</para>
  <para style="q1" vid="PSA 75:8">U tso ocosu yi ta̱, waru a̱za̱ e iwuya o uvaɗi suru</para>
  <para style="q2" vid="PSA 75:8">o tsu sowo yi ta̱ suru.<verse eid="PSA 75:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9" />Agba a̱mu, n ta yuwan adanshi a nda hali hali.</para>
  <para style="q2" vid="PSA 75:9">N ta canaa A̱sula̱ a Yakubu ica,<verse eid="PSA 75:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10" />za na aa dansa, &lt;&lt;N ta kuɗa ucira wa̱ a̱za̱ e iwuya suru,</para>
  <para style="q2" vid="PSA 75:10">amma n ta̱ da̱shi 'ya̱sa̱n ucira wa̱ a̱za̱ a̱ a̱ɓula̱.&gt;&gt;<verse eid="PSA 75:10" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" sid="PSA 76" />
  <para style="s">A̱sula̱ o ulyuwu wa a aci</para>
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Ica ya Asaf, a wa'a yi na̱ kumburu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1" />A̱tsuma̱ a Yahuda e reve ta̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 76:1">ala a̱ yi a̱ ta̱ na̱ tsugbain a̱tsuma̱ a Isra'ila.<verse eid="PSA 76:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2" />U shuwa̱ ta̱ oogodo a̱ yi a̱tsuma̱ a Salem,</para>
  <para style="q2" vid="PSA 76:2">uba̱ta̱ u na u ri nden a̱tsuma̱ a̱ Sihiyona.<verse eid="PSA 76:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3" />Ɗe ɗa wu kuɗai aya akina a n'yuwatan,</para>
  <para style="q2" vid="PSA 76:3">na̱ a̱a̱ra̱ga̱ oɓolo na̱ mutsun mu pe'eni, ni itana yu uvon i le. <char style="qs">Wivuwun</char><verse eid="PSA 76:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4" />A̱sula̱, tsugbain tsa̱ wu nu ucira wa̱ wu a la'a ta̱ tsugbain tsa̱ nsasan,</para>
  <para style="q2" vid="PSA 76:4">uba̱ta̱ u na vu lyuwai a aci a n'yuwatan ma̱ wu!<verse eid="PSA 76:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5" />O una ta̱ ali e le na a gurai uvon,</para>
  <para style="q2" vid="PSA 76:5">reve aza a na o una nle a̱ pura̱ itana yu uvon i le.</para>
  <para style="q2" vid="PSA 76:5">Agba babu za na gura yuwain ulinga ni itana yu uvon ya̱ yi.<verse eid="PSA 76:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6" />A̱sula̱ a Yakubu, a tsuɓari tsa̱ wu</para>
  <para style="q2" vid="PSA 76:6">ido oɓolo na akumbi e ido a̱ riya̱ ta̱ a̱ kuwa̱.<verse eid="PSA 76:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7" />A̱vu ɗa goon aa uwwa wovon!</para>
  <para style="q2" vid="PSA 76:7">Zane ɗa a gura isawan a̱ ma̱ka̱ka̱n ma̱ wu,</para>
  <para style="q2" vid="PSA 76:7">a mantsa ma na vu ri o upan?<verse eid="PSA 76:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8" />Diga zuva a uwwa ta̱ ugana wu uge'etosu u na vu paɗai,</para>
  <para style="q2" vid="PSA 76:8">iɗa yu uwwa ta̱ wovon, reve u rungwa̱ kpen.<verse eid="PSA 76:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9" />A yuwan ta̱ ne a mantsa ma na a̱vu A̱sula̱ vu 'yoyin na vaa paɗa ugana,</para>
  <para style="q2" vid="PSA 76:9">adama vu wawa aza a na o sowuso a̱tsuma̱lima̱ a̱tsuma̱ o uvaɗi. <char style="qs">Wivuwun</char><verse eid="PSA 76:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10" />Amayun, upan wa̱ wu a aci a vaɗilima̱</para>
  <para style="q2" vid="PSA 76:10">u tsu ta̱wa̱a̱ wu ta̱ ni ica,</para>
  <para style="q1" vid="PSA 76:10">akapi a ama a na a la'ai diga o upan wa̱ wu</para>
  <para style="q2" vid="PSA 76:10">o to o'wo wu gbakala.<verse eid="PSA 76:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11" />Yuwayin A̱sulazuva A̱sula̱ a̱ ɗu akucunu</para>
  <para style="q2" vid="PSA 76:11">waru i shiton le.</para>
  <para style="q1" vid="PSA 76:11">Lyawa nɗa n na n ri nden uka̱nda̱ruwu na̱ a̱yi suru</para>
  <para style="q2" vid="PSA 76:11">a̱ ta̱wa̱a̱ Za na a uwwusa wovon na̱ ne'en.<verse eid="PSA 76:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12" />U ka̱ɗa̱to ta̱ a̱za̱ o tsugono,</para>
  <para style="q2" vid="PSA 76:12">ngono mu uvaɗi n ta uwwusa wovon wa̱ yi.<verse eid="PSA 76:12" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" sid="PSA 77" />
  <para style="s">Izami yi ikambishi e ekere a̱ A̱sulazuva a rana va̱ A̱tsuma̱lima̱</para>
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. A cana yi o una̱ wi ishipa ya̱ Yedutun. Ica ya Asaf.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1" />N showen ta̱ A̱sula̱ adama e ikambishi,</para>
  <para style="q2" vid="PSA 77:1">n showen ta̱ A̱sula̱ adama wu uwwa mu.<verse eid="PSA 77:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2" />A rana va̱ a̱tsuma̱lima̱ a̱ va̱ n zami ta̱ Zagbain,</para>
  <para style="q2" vid="PSA 77:2">na ayin n 'ya̱sa̱n ta̱ ekere a̱ va̱ zuva a avasa,</para>
  <para style="q1" vid="PSA 77:2">amma suru na̱ ne,</para>
  <para style="q2" vid="PSA 77:2">wuma u va̱ u tsura̱ asuvu nden shi.<verse eid="PSA 77:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3" />N cuwan ta̱ na̱ a̱vu A̱sula̱ reve mi ivuwan ogbolo.</para>
  <para style="q2" vid="PSA 77:3">Na n ri a majiyan, reve okolo a̱ va̱ a kuɗa. <char style="qs">Wivuwun</char><verse eid="PSA 77:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4" />Vu lyawa mu n lantsa shi.</para>
  <para style="q2" vid="PSA 77:4">N dama ta̱ hali n lamba a yuwan adanshi.<verse eid="PSA 77:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5" />N cuwan ta̱ na̱ rana na ka̱ra̱i ɗe,</para>
  <para style="q2" vid="PSA 77:5">na a'wan a̱ a̱bunda̱ a na a̱ ka̱ra̱i ɗe nu ujumu.<verse eid="PSA 77:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6" />N cuwan ta̱ ni ishipa i na n tsu yuwusan na ayin,</para>
  <para style="q2" vid="PSA 77:6">n yuwusan ta̱ majiyan me le, a̱vu n zami urevu.<verse eid="PSA 77:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7" />N damma ta̱, &lt;&lt;Ko Zagbain ta kasa na̱ a̱mu hali hali?</para>
  <para style="q2" vid="PSA 77:7">Wa̱a̱ da̱shi roco mu isa'ani waru shi?<verse eid="PSA 77:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8" />Hali icigi ya̱ yi i na i tsu vadala shi i puwa̱n ta̱ hali hali?</para>
  <para style="q2" vid="PSA 77:8">Hali nzuwulai ma̱ yi n kuɗa̱ ta̱ a shiwan mantsa suru?<verse eid="PSA 77:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9" />Ko A̱sula̱ e icina ta̱ naa wo roco iliyali?</para>
  <para style="q2" vid="PSA 77:9">Ko a̱tsuma̱ o upan wa̱ yi woo roco isa'ani shi?&gt;&gt; <char style="qs">Wivuwun</char><verse eid="PSA 77:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10" />Ɗaɗa n dammai, &lt;&lt;Ili i na i la'a suɗuwa numu lon a̱yi ɗa</para>
  <para style="q2" vid="PSA 77:10">ukere u Mogono ma̱ A̱sula̱ ma lyawa ta̱ ikambi i va̱.&gt;&gt;<verse eid="PSA 77:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11" />N ta cuwan na̱ linga va̱ A̱sulazuva.</para>
  <para style="q2" vid="PSA 77:11">Amayun, n ta cuwan na̱ linga va asalama na vu yuwain ɗe nu ujimu.<verse eid="PSA 77:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12" />N ta̱ da̱na̱ a majiyan ma linga na vu yuwain suru,</para>
  <para style="q2" vid="PSA 77:12">e petelyuwushe linga gbagbain na vu yuwain suru.<verse eid="PSA 77:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13" />A̱sula̱, re va̱ wu aza a akiza a ɗa.</para>
  <para style="q2" vid="PSA 77:13">Ma̱sula̱ ma̱ ne ma ɗa ma̱ ri mgbain tsa̱ A̱sula̱ a̱ tsu?<verse eid="PSA 77:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14" />A̱vu ɗa A̱sula̱ a na a yuwusan linga va asalama,</para>
  <para style="q2" vid="PSA 77:14">vu roco ta̱ ucira wa̱ wu a̱tsuma̱ a ama.<verse eid="PSA 77:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15" />Nu ukere wu ucira wa̱ wu u ɗa vu tsupayi ama a̱ wu,</para>
  <para style="q2" vid="PSA 77:15">limatan va Yakubu na̱ Isuhu.<char style="qs">Wivuwun</char><verse eid="PSA 77:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16" />A̱sula̱, ana mini me ene nuwu wu uwwa ta̱ wovon,</para>
  <para style="q2" vid="PSA 77:16">reve mini ma̱ a̱ru'un me je'en.<verse eid="PSA 77:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17" />Eleshe o oco ta̱ mini,</para>
  <para style="q2" vid="PSA 77:17">a̱vu zuva yuwan tsata,</para>
  <para style="q2" vid="PSA 77:17">aya a̱ wu a maɗatsa ta̱ uba̱ta̱ suru.<verse eid="PSA 77:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18" />A uwwa ta̱ uɗyo u tsata tsa̱ wu a̱tsuma̱ a̱ lipa̱,</para>
  <para style="q2" vid="PSA 77:18">waru imaɗatsu ya̱ wu yi ikana ta̱ uvaɗi suru.</para>
  <para style="q2" vid="PSA 77:18">Uvaɗi u je'en ta̱ a̱vu u jinga̱ɗa̱.<verse eid="PSA 77:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19" />Ure wa̱ wu u ka̱ra̱la̱i ta̱ a mala,</para>
  <para style="q2" vid="PSA 77:19">ure wa̱ wu u ka̱ra̱la̱i ta̱ a̱ mini ma gbain,</para>
  <para style="q2" vid="PSA 77:19">na̱ ne suru ene uzuɓa̱ wa̱ wu shi.<verse eid="PSA 77:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20" />Vu rono ta̱ ama a̱ wu aɗanga tsa za va aguɓa,</para>
  <para style="q2" vid="PSA 77:20">e ekere a Musa na̱ Haruna.<verse eid="PSA 77:20" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" sid="PSA 78" />
  <para style="s">A̱sula̱ na ama a̱ yi</para>
  <para style="d">Ishipa yu uyo'o ya Asaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1" />A̱ɗu ama a̱ va̱, poloi atsuvu ulobonu o uritosu u va̱,</para>
  <para style="q2" vid="PSA 78:1">i ka̱mbuwa̱ ugbozu e ili i na maa dansa.<verse eid="PSA 78:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2" />N ta yuwaan ɗu adanshi ni iroci,<note caller="-" style="x"><char style="xo" closed="false">78:2 </char><char style="xt" closed="false"><ref loc="MAT 13:35">Mat 13:35</ref>.</char></note></para>
  <para style="q2" vid="PSA 78:2">n damma ili i na i ri usokowu diga o ufaru,<verse eid="PSA 78:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3" />ili i na tsu uwwai waru tsu revei,</para>
  <para style="q2" vid="PSA 78:3">ili i na nkaya n tsu n damma ntsu.<verse eid="PSA 78:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4" />Tsoo sokowo muwun n tsu ili i nda shi,</para>
  <para style="q2" vid="PSA 78:4">tsu ta damma limatan ve elime linga na da̱na̱i ica ya̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 78:4">nu ucira wa̱ yi na̱ linga va asalama a na u yuwain.<verse eid="PSA 78:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5" />U ca ta̱ udammu na̱ wila̱ e ekere a aza a Isra'ila,</para>
  <para style="q2" vid="PSA 78:5">aza a na e le ɗa ugundo wa Yakubu,</para>
  <para style="q1" vid="PSA 78:5">aza a na u dammai nkaya n tsu</para>
  <para style="q2" vid="PSA 78:5">o rito muwun nle,<verse eid="PSA 78:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6" />tsa̱ra̱ limatan ve elime reve le,</para>
  <para style="q2" vid="PSA 78:6">hali na̱ muwun n na koto a matsain shi</para>
  <para style="q2" vid="PSA 78:6">ele fo o rito muwun n le.<verse eid="PSA 78:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7" />Ne ɗa a zuwa okolo e le uba̱ta̱ wa̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 78:7">e icina na̱ linga va̱ yi shi,</para>
  <para style="q2" vid="PSA 78:7">amma a ta a yuwan tsutoni nu udammu wa̱ yi.<verse eid="PSA 78:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8" />O o'wo tsa a nkaya nle</para>
  <para style="q2" vid="PSA 78:8">aza a aciyogbamu na̱ limatan vu u'ya̱susa̱n a aci shi,</para>
  <para style="q1" vid="PSA 78:8">aza a na okolo e le a̱ ri uba̱ta̱ wa̱ A̱sula̱ shi,</para>
  <para style="q2" vid="PSA 78:8">aza a na okolo e le a yuwaan A̱sula̱ a̱ɓula̱ shi.<verse eid="PSA 78:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9" />Ko na wo o'woi ali o uvon a Ifiramu a̱ ta̱ na̱ tan na aya,</para>
  <para style="q2" vid="PSA 78:9">a vadala ta̱ a suma o urana wu uvon.<verse eid="PSA 78:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10" />A yuwan tsutoni na̱ nzuwulai ma̱ A̱sula̱ shi,</para>
  <para style="q2" vid="PSA 78:10">a̱vu a 'yuwan a yuwan wuma u le a̱tsuma̱ a̱ wila̱ wa̱ yi.<verse eid="PSA 78:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11" />A 'yuwan ta̱ a cuwan na̱ linga na u yuwain,</para>
  <para style="q2" vid="PSA 78:11">na̱ linga va asalama na u roco nle.<verse eid="PSA 78:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12" />U yuwan ta̱ linga va asalama elime a nkaya nle,</para>
  <para style="q2" vid="PSA 78:12">e iɗa ya Masar a̱ lyuci va Zowa.<note caller="-" style="x"><char style="xo" closed="false">78:12 </char><char style="xt" closed="false"><ref loc="EXO 7:8-12:32">Mta̱ 7:8-12:32</ref>.</char></note><verse eid="PSA 78:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13" />U ne'eshen ta̱ mala a̱vu u pasa ne e le pe,</para>
  <para style="q2" vid="PSA 78:13">u zuwa ta̱ mini me isawan uba̱ta̱ u ta̱, cine vu revei aganga.<note caller="-" style="x"><char style="xo" closed="false">78:13 </char><char style="xt" closed="false"><ref loc="EXO 14:21-22">Mta̱ 14:21-22</ref>.</char></note><verse eid="PSA 78:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14" />U ronoo le ta̱ aɗanga ne eleshe nu urana</para>
  <para style="q2" vid="PSA 78:14">ne ekan diga akina ayin suru.<note caller="-" style="x"><char style="xo" closed="false">78:14 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">Mta̱ 13:21-22</ref>.</char></note><verse eid="PSA 78:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15" />Wu ɓatsa ta̱ atali a̱ a̱tsumona</para>
  <para style="q2" vid="PSA 78:15">waru u ca le ta̱ mini ma̱ a̱bunda̱, she damma mala.<note caller="-" style="x"><char style="xo" closed="false">78:15-16 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">Mta̱ 17:1-7</ref>; <ref loc="NUM 20:2-13">Mkc 20:2-13</ref>.</char></note><verse eid="PSA 78:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16" />U zuwa ta̱ mini mo uta̱ diga a aatali a na u ɓatsai,</para>
  <para style="q2" vid="PSA 78:16">u zuwa ta̱ mini me yene tsu uɗolu.<verse eid="PSA 78:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17" />Amma a lyuwa ta̱ elime a yuwusan yi unusu,</para>
  <para style="q2" vid="PSA 78:17">a̱ 'ya̱sa̱sa̱a̱n Mogono ma̱ A̱sula̱ a aci ɗe a̱tsumona.<verse eid="PSA 78:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18" />Gayin ɗa a̱ lyungwa̱i A̱sula̱,</para>
  <para style="q2" vid="PSA 78:18">o una̱ wi izami yi ilyalya i na aa uwwusa maluwa.<note caller="-" style="x"><char style="xo" closed="false">78:18 </char><char style="xt" closed="false"><ref loc="EXO 16:2-15">Mta̱ 16:2-15</ref>; <ref loc="NUM 11:4-23">Mkc 11:4-23</ref>; <ref loc="NUM 4:31-35">Mkc 4:31-35</ref>.</char></note><verse eid="PSA 78:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19" />A̱vu a yuwaan A̱sula̱ adanshi a vama</para>
  <para style="q2" vid="PSA 78:19">a dansa, &lt;&lt;A̱sula̱ a ta gura foɓoo tsu a̱buki a̱ a̱tsumona?<verse eid="PSA 78:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20" />Ko na wo o'woi u faba ta̱ aatali,</para>
  <para style="q2" vid="PSA 78:20">a̱vu mini mo uta̱,</para>
  <para style="q2" vid="PSA 78:20">hali ɗolu shiwan lon,</para>
  <para style="q1" vid="PSA 78:20">u ta gura lyuwato tsu?</para>
  <para style="q2" vid="PSA 78:20">U ta gura ca ama a̱ yi inama?&gt;&gt;<verse eid="PSA 78:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21" />Ana A̱sulazuva a uwwa nle, a̱vu u yuwan upan lon,</para>
  <para style="q2" vid="PSA 78:21">u lyunguwa̱a̱ ugundo wa Yakubu na akina,</para>
  <para style="q2" vid="PSA 78:21">na amayun, upan wa̱ yi u 'yon ta̱ a aci aza a Isra'ila,<verse eid="PSA 78:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22" />adama a na a̱ usu A̱sula̱ shi,</para>
  <para style="q2" vid="PSA 78:22">ko a zuwa okolo u ta a wawa le shi.<verse eid="PSA 78:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23" />Amma A̱sula̱ a yuwan ta̱ adanshi na̱ zuva,</para>
  <para style="q2" vid="PSA 78:23">reve u zuwai u kpa̱tu'wa̱ tsu na̱ntsu,<verse eid="PSA 78:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24" />a̱vu ilyalya yo oco tsi iro'i adama a ama a̱ yi,</para>
  <para style="q2" vid="PSA 78:24">ilyalya i na e ɗeyi &lt;&lt;mana&gt;&gt;,</para>
  <para style="q2" vid="PSA 78:24">u ca le ta̱ ishina diga zuva.<note caller="-" style="x"><char style="xo" closed="false">78:24 </char><char style="xt" closed="false"><ref loc="JHN 6:31">Yah 6:31</ref>.</char></note><verse eid="PSA 78:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25" />Reve a tama cu'un vi ilyalya i na nlingata ma̱ A̱sula̱ ntsu tamusa,</para>
  <para style="q2" vid="PSA 78:25">u lyunguwa̱ le ta̱ ni ilyalya ya̱a̱ a̱bunda̱</para>
  <para style="q2" vid="PSA 78:25">na a gura lyuwa biti.<verse eid="PSA 78:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26" />A̱ tyo ɗe, reve u zuwa upepu wa asana u lapa diga zuva,</para>
  <para style="q2" vid="PSA 78:26">reve waru u zuwa upepu wu uyagi u lapa a̱tsuma̱ o ucira wa̱ yi.<verse eid="PSA 78:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27" />Reve upepu'u u ta̱wa̱a̱ na̱ nnunu ma̱ a̱bunda̱,</para>
  <para style="q2" vid="PSA 78:27">cine vu revei wuyun wu nge'en m mala.<verse eid="PSA 78:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28" />A̱sula̱ a zuwa ta̱ nnunu ndolo o oco</para>
  <para style="q2" vid="PSA 78:28">e memere mo uva̱la̱ta̱ u le,</para>
  <para style="q2" vid="PSA 78:28">uka̱nda̱ruwu no ogodo e le suru.<verse eid="PSA 78:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29" />Reve a tama a̱ cuwa̱n cine a cigai,</para>
  <para style="q2" vid="PSA 78:29">adama a na u ca le ta̱ ili i na a̱ ri o utsa̱n.<verse eid="PSA 78:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30" />Amma kafu a̱ cuwa̱n,</para>
  <para style="q2" vid="PSA 78:30">a̱ yi ubuwu a̱ na̱ le,<verse eid="PSA 78:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31" />ɗaɗa upan wa̱ A̱sula̱ a̱ riya̱a̱ nle.</para>
  <para style="q2" vid="PSA 78:31">Reve wu una aza a na a la'ai ucira a̱tsuma̱ e le,</para>
  <para style="q2" vid="PSA 78:31">oɓolo no o olobo a Isra'ila.<verse eid="PSA 78:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32" />Na̱ ne suru, reve aa lyuwa elime na̱ mayan mo unusu.</para>
  <para style="q2" vid="PSA 78:32">Na̱ linga va asalama na u yuwain suru, a ca okolo shi.<verse eid="PSA 78:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33" />Adama o ndolo a ɗa u zuwai wuma u le u kotoi pere,</para>
  <para style="q2" vid="PSA 78:33">waru na addama acina le a̱ tsu la̱pa̱ kuwa̱ shi.<verse eid="PSA 78:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34" />A mantsa ma na A̱sula̱ o unai ozo o ro le biti,</para>
  <para style="q2" vid="PSA 78:34">a̱vu akapi'i a zami yi a̱ ka̱mba̱ uba̱ta̱ wa̱ yi no okolo a̱ta̱.<verse eid="PSA 78:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35" />A cuwan ta̱ na A̱sula̱ a ɗa, a̱ da̱na̱i Aatali o Upa'atan ule,</para>
  <para style="q2" vid="PSA 78:35">na Mogono ma̱ A̱sula̱ ma ɗa Za vi Iwawi i le.<verse eid="PSA 78:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36" />Amma a̱vu a yuwusan yi una̱ wu uyo'o</para>
  <para style="q2" vid="PSA 78:36">a yuwusaan yi epen.<verse eid="PSA 78:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37" />Okolo e le aa yuwusan yi tsutoni shi,</para>
  <para style="q2" vid="PSA 78:37">a̱ ri na̱ a̱ɓula̱ a nzuwulai ma̱ yi shi.<verse eid="PSA 78:37" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38" />Na̱ ne suru, a̱yi za na tse ene iliyali i ɗa,</para>
  <para style="q2" vid="PSA 78:38">u yuwan ta̱ gafura vu nusu le,</para>
  <para style="q2" vid="PSA 78:38">agba u kototo le shi.</para>
  <para style="q1" vid="PSA 78:38">Mantsa na̱ a̱bunda̱ u tsu kaɓa ta̱ asuvu o upan wa̱ yi,</para>
  <para style="q2" vid="PSA 78:38">agba u zuwa upan wa̱ yi suru u puna̱ shi.<verse eid="PSA 78:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39" />U cuwan ta̱ na e le lipu na̱ mpasa ɗa goon,</para>
  <para style="q2" vid="PSA 78:39">upepu u na wa lapusa na tsu ka̱mba̱ shi.<verse eid="PSA 78:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40" />A̱ 'ya̱susa̱a̱n yi ta̱ a aci na̱ a̱bunda̱ a̱tsuma̱ a̱tsumona,</para>
  <para style="q2" vid="PSA 78:40">reve a̱ lungusa̱ yi okolo!<verse eid="PSA 78:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41" />Na̱ a̱bunda̱ a̱ lyungwa̱ ta̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 78:41">reve a zuwa Za va Akiza a Isra'ila a yuwan a̱tsumola̱ngu.<verse eid="PSA 78:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42" />A cuwan nu ucira wa̱ yi shi,</para>
  <para style="q2" vid="PSA 78:42">nu urana u na u wawa nle</para>
  <para style="q2" vid="PSA 78:42">diga e ekere a n'yuwatan nle,<verse eid="PSA 78:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43" />na u yuwain linga va asalama ni iroci</para>
  <para style="q2" vid="PSA 78:43">e iɗa ya Masar a̱ lyuci va Zowa shi.<verse eid="PSA 78:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44" />U ka̱mba̱to ta̱ ɗolu va Masar mpasa,</para>
  <para style="q2" vid="PSA 78:44">a gura sowo mini mo ɗolu le shi.<note caller="-" style="x"><char style="xo" closed="false">78:44 </char><char style="xt" closed="false"><ref loc="EXO 7:17-21">Mta̱ 7:17-21</ref>.</char></note><verse eid="PSA 78:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45" />U lyunguwa̱a̱ le ta̱ fo no oɓolo a ayun</para>
  <para style="q2" vid="PSA 78:45">aza a na a ca nle a̱tsuma̱lima̱,</para>
  <para style="q2" vid="PSA 78:45">no opoɗo a na a̱ lungusa̱i iɗa i le.<note caller="-" style="x"><char style="xo" closed="false">78:45 </char><char style="xt" closed="false"><ref loc="EXO 8:1-6">Mta̱ 8:1-6</ref>; <ref loc="EXO 8:20-24">8:20-24</ref>.</char></note><verse eid="PSA 78:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46" />U ca ta̱ apapari itana ya̱ a̱ɗuma̱ i le,</para>
  <para style="q2" vid="PSA 78:46">akyun waru umatsun wa̱ a̱ɗuma̱ e le.<note caller="-" style="x"><char style="xo" closed="false">78:46 </char><char style="xt" closed="false"><ref loc="EXO 10:12-15">Mta̱ 10:12-15</ref>.</char></note><verse eid="PSA 78:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47" />U lungusa̱ ta̱ ataci a̱ ina̱bi e le na atayan,</para>
  <para style="q2" vid="PSA 78:47">ɗanga vu ubiri le ni iro'i ya atayan.<note caller="-" style="x"><char style="xo" closed="false">78:47-48 </char><char style="xt" closed="false"><ref loc="EXO 9:22-25">Mta̱ 9:22-25</ref>.</char></note><verse eid="PSA 78:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48" />Wu una ta̱ inan i le na atayan,</para>
  <para style="q2" vid="PSA 78:48">iliyamunga i le na̱ tsata.<verse eid="PSA 78:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49" />U tsuwa̱a̱n le ta̱ upan wu usuɗuwu wa̱ yi,</para>
  <para style="q2" vid="PSA 78:49">na asuvu usuɗu na addama,</para>
  <para style="q2" vid="PSA 78:49">no oɓolo a nlingata ma̱ A̱sula̱ a̱za̱ o ukototosu.<verse eid="PSA 78:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50" />U foɓoo ta̱ upan wa̱ yi ure.</para>
  <para style="q2" vid="PSA 78:50">U lyawa le wuma shi,</para>
  <para style="q2" vid="PSA 78:50">agba u tsuwa̱n le ta̱ mɓa̱la̱.<verse eid="PSA 78:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51" />Wu ga̱la̱ ta̱ muwun ma ali mu ufaru wa aza a Masar suru,</para>
  <para style="q2" vid="PSA 78:51">umatsun wu ufaru u na a matsain</para>
  <para style="q2" vid="PSA 78:51">a̱tsuma̱ o ucira u le o ogodo a Ham.<note caller="-" style="x"><char style="xo" closed="false">78:51 </char><char style="xt" closed="false"><ref loc="EXO 12:29">Mta̱ 12:29</ref>.</char></note><verse eid="PSA 78:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52" />Amma wu uta̱a̱ ta̱ ama a̱ yi tso oɓolo e ikyon,</para>
  <para style="q2" vid="PSA 78:52">reve u kuru ne le a̱ a̱tsumona tsi iliyamunga.<note caller="-" style="x"><char style="xo" closed="false">78:52 </char><char style="xt" closed="false"><ref loc="EXO 13:17-22">Mta̱ 13:17-22</ref>.</char></note><verse eid="PSA 78:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53" />U kuru ta̱ ne le gbaga, adama she a uwwa wovon wan,</para>
  <para style="q2" vid="PSA 78:53">amma a̱vu mala ma lyuwa n'yuwatan nle.<note caller="-" style="x"><char style="xo" closed="false">78:53 </char><char style="xt" closed="false"><ref loc="EXO 14:26-28">Mta̱ 14:26-28</ref>.</char></note><verse eid="PSA 78:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54" />Ne ɗa u ta̱wa̱to nle o utyo wi iɗa ya akiza a̱ yi,</para>
  <para style="q2" vid="PSA 78:54">a masasan ma na u lyuwai nu uvon na aciya̱yi.<note caller="-" style="x"><char style="xo" closed="false">78:54 </char><char style="xt" closed="false"><ref loc="JOS 3:14-17">Jos 3:14-17</ref>.</char></note><verse eid="PSA 78:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55" />U gba̱ra̱ ta̱ nɗa elime e le,</para>
  <para style="q2" vid="PSA 78:55">a̱vu u ne'eshen le iɗa'a wo o'wo le agadu,</para>
  <para style="q2" vid="PSA 78:55">a̱vu u zuwa gundo va Isra'ila a da̱nu a 'wa le.<note caller="-" style="x"><char style="xo" closed="false">78:55 </char><char style="xt" closed="false"><ref loc="JOS 11:16-23">Jos 11:16-23</ref>.</char></note><verse eid="PSA 78:55" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56" />Amma a̱vu a̱ lyungwa̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 78:56">a̱vu a̱ 'ya̱sa̱a̱n Mogono ma̱ A̱sula̱ a aci,</para>
  <para style="q2" vid="PSA 78:56">a yuwan tsutoni nu udammu wa̱ yi shi.<note caller="-" style="x"><char style="xo" closed="false">78:56 </char><char style="xt" closed="false"><ref loc="JDG 2:11-15">A̱.Ug 2:11-15</ref>. </char></note><verse eid="PSA 78:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57" />Cine vu revei nkaya nle</para>
  <para style="q2" vid="PSA 78:57">ne ɗa a̱ da̱na̱i nu ulambu wa amayun</para>
  <para style="q2" vid="PSA 78:57">nu ulambu wa̱ a̱ɓula̱,</para>
  <para style="q2" vid="PSA 78:57">tsu utan u na u la̱nga̱i.<verse eid="PSA 78:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58" />A zuwa yi ta̱ u yuwan upan na̱ ba̱ta̱ va̱ a̱ga̱nda̱ le,</para>
  <para style="q2" vid="PSA 78:58">a̱vu a zuwa yi tsushu'un na̱ a̱ma̱li e le.<verse eid="PSA 78:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59" />Ana A̱sula̱ a uwwa nle, u yuwan ta̱ upan lon,</para>
  <para style="q2" vid="PSA 78:59">ɗaɗa gba u 'yuwain aza a Isra'ila suru suru.<verse eid="PSA 78:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60" />U lyuwa ta̱ oogodo a̱ nda̱na̱ta̱ ma̱ yi a̱tsuma̱ a̱ Shilo,</para>
  <para style="q2" vid="PSA 78:60">oogodo a na u shuwa̱i a̱tsuma̱ a ama.<note caller="-" style="x"><char style="xo" closed="false">78:60 </char><char style="xt" closed="false"><ref loc="JOS 18:1">Jos 18:1</ref>; <ref loc="JER 7:12-14">Irm 7:12-14</ref>.</char></note><verse eid="PSA 78:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61" />U lyawa ta̱ n'yuwatan n le a usa Aakpati a Nzuwulai,</para>
  <para style="q2" vid="PSA 78:61">iroci yu ucira wa̱ yi na̱ tsugbain tsa̱ yi.<note caller="-" style="x"><char style="xo" closed="false">78:61 </char><char style="xt" closed="false"><ref loc="1SA 4:4-22">1 Sam 4:4-22</ref>.</char></note><verse eid="PSA 78:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62" />U lyawa ta̱ matsun me pe'eni maa lyuwa a ama a̱yi,</para>
  <para style="q2" vid="PSA 78:62">u yuwan ta̱ upan lon na agadu a̱yi.<verse eid="PSA 78:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63" />Uvon u lyuwa ta̱ muwun mo olobo n le,</para>
  <para style="q2" vid="PSA 78:63">reve esheli e le a lamba ali.<verse eid="PSA 78:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64" />O una ta̱ fo nan ganu e le na̱ matsun me pe'eni,</para>
  <para style="q2" vid="PSA 78:64">agba a lyawa a̱ma̱ci e le shon shi.<verse eid="PSA 78:64" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65" />Reve Zagbain 'yon ngashi nlavu n ɗa u shi a yuwusan,</para>
  <para style="q2" vid="PSA 78:65">tsa vali vu uvon na 'yoyin diga usowu u masayan ma̱ ina̱bi.<verse eid="PSA 78:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66" />U gba̱ra̱ ta̱ n'yuwatan ma̱ yi,</para>
  <para style="q2" vid="PSA 78:66">a̱vu u zuwa le a uwwa wono u na u ri n koto shi.<verse eid="PSA 78:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67" />Ɗaɗa gba u 'yuwain limatan va̱ Isuhu,</para>
  <para style="q2" vid="PSA 78:67">agba u ɗangwa ugundo wa Ifiramu shi.<verse eid="PSA 78:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68" />Amma u ɗangwa ta̱ ugundo wa Yahuza,</para>
  <para style="q2" vid="PSA 78:68">Masasan ma̱ Sihiyona, za na u cigai.<verse eid="PSA 78:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69" />U suwa ta̱ Uba̱ta̱ wa Akiza a̱yi,</para>
  <para style="q2" vid="PSA 78:69">cine vu revei u'wa wa̱ yi ɗe zuva,</para>
  <para style="q2" vid="PSA 78:69">za vu ucira za na waru shuwa̱i tsu uvaɗi hali hali.<verse eid="PSA 78:69" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70" />U ɗangwa ta̱ Da̱wuda aagbashi a̱yi,</para>
  <para style="q2" vid="PSA 78:70">a̱vu u tawai uba̱ta̱ wa aguɓa e ikyon.<note caller="-" style="x"><char style="xo" closed="false">78:70-71</char><char style="xt" closed="false"><ref loc="1SA 16:11-12">1 Sam 16:11-12</ref>; <ref loc="2SA 7:8">2 Sam 7:8</ref>; <ref loc="1CH 17:7">1 Alb 17:7</ref>. </char></note><verse eid="PSA 78:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71" />U tara yi ta̱ diga uba̱ta̱ wa aguɓa e ikyon na̱ mukyokyon,</para>
  <para style="q2" vid="PSA 78:71">adama wo o'wo za na o rono ama a̱yi a Yakubu aɗanga, Isra'ila agadu a̱ yi.<verse eid="PSA 78:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72" />Da̱wuda rono le ta̱ aɗanga no okolo a̱ ta̱,</para>
  <para style="q2" vid="PSA 78:72">nu uguru u ɗa u rono nle aɗanga.<verse eid="PSA 78:72" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" sid="PSA 79" />
  <para style="s">Avasa adama e iwawi yi iɗa</para>
  <para style="d">Ica ya Asaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1" />A̱sula̱, nɗa m ɓa̱ru ta̱ iɗa ya̱ wu.</para>
  <para style="q2" vid="PSA 79:1">A̱ lungusa̱ ta̱ A̱a̱'isa̱mapaɗa a akiza a̱ wu,</para>
  <para style="q2" vid="PSA 79:1">reve a̱ ka̱mba̱to Urishelima okongo.<note caller="-" style="x"><char style="xo" closed="false">79:1 </char><char style="xt" closed="false"><ref loc="2KI 25:8-10">2 Ngo 25:8-10</ref>; <ref loc="2CH 36:17-19">2 Alb 36:17-19</ref>; <ref loc="JER 52:12-14">Irm 52:12-14</ref>.</char></note><verse eid="PSA 79:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2" />A̱vu a lyawaa nnunu ma zuva a̱kwa̱kwa̱ a̱ lipu va ama a̱ wu o o'wo ilyalya i le,</para>
  <para style="q2" vid="PSA 79:2">lipu va ama a̱ a̱ɓula̱ a̱ wu ilyalya yi inama yu una.<verse eid="PSA 79:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3" />O oco ta̱ mpasa ma ama a̱ wu cine vu revei mini,</para>
  <para style="q2" vid="PSA 79:3">a̱tsuma̱ e iɗa ya Urishelima suru.</para>
  <para style="q2" vid="PSA 79:3">Babu vuma na la'ai a na wa̱ ciɗo a̱kwa̱kwa̱'a̱.<verse eid="PSA 79:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4" />Tso o'wo ta̱ ili yi izo'oshi uba̱ta̱ wu nron mu nden ntsu,</para>
  <para style="q2" vid="PSA 79:4">tso o'wo ta̱ ili ya avandaru uba̱ta̱ wa ama a na a̱ ri uka̱nda̱ruwu na̱ a̱tsu.<verse eid="PSA 79:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5" />A̱sulazuva, hali a̱ tyo a mantsa ma̱ ne ma ɗa va̱a̱ da̱na̱ o upan na̱ a̱tsu?</para>
  <para style="q2" vid="PSA 79:5">Hali hali ɗa?</para>
  <para style="q1" vid="PSA 79:5">Hali a̱ tyo a mantsa ma̱ ne ma ɗa tsushu'un tsa̱ wu</para>
  <para style="q2" vid="PSA 79:5">tsa̱a̱ da̱na̱ a̱ ma̱kula̱ tsa a akina?<verse eid="PSA 79:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6" />Vu tsuwa̱a̱n nɗa n na n reve nuwu shi upan wa̱ wu,</para>
  <para style="q2" vid="PSA 79:6">na̱ tsugono tsa na tse ɗesu ala a̱ wu shi!<verse eid="PSA 79:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7" />Adama a na a lyuwa ta̱ limatan va Yakubu nu uvon,</para>
  <para style="q2" vid="PSA 79:7">reve a̱ lungusa̱ uba̱ta̱ wu nden wa̱ yi.<verse eid="PSA 79:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8" />She vu ge'eto tsu adama a̱ nusu vu nkaya n tsu wan.</para>
  <para style="q2" vid="PSA 79:8">Lyawa ve ene iliyali i tsu gogo,</para>
  <para style="q2" vid="PSA 79:8">adama a na okolo a̱ tsu a kuɗa ta̱.<verse eid="PSA 79:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9" />A̱sula̱ Za vi Iwawi i tsu, vu yuwaan tsu ikambishi,</para>
  <para style="q2" vid="PSA 79:9">adama a tsugbain tsa ala a̱ wu.</para>
  <para style="q1" vid="PSA 79:9">Vu wawa tsu, vu yuwaan tsu gafura vu nusu tsu</para>
  <para style="q2" vid="PSA 79:9">adama a ala a̱ wu.<verse eid="PSA 79:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10" />Adama a̱ nye nɗa me ece tsu, &lt;&lt;Te ɗa A̱sula̱ a̱ ɗu?&gt;&gt;</para>
  <para style="q2" vid="PSA 79:10">Lyawa tse ene vu tsupaa ta̱ agbashi a̱ wu</para>
  <para style="q2" vid="PSA 79:10">e ekere a nɗa n na mo ocoi mpasa n le e esu a̱ tsu.<verse eid="PSA 79:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11" />Lyawa ma̱nga̱ ma aza a na a̱ ri o u'wa wa ali</para>
  <para style="q2" vid="PSA 79:11">a̱ ta̱wa̱ a̱ ma̱ka̱ka̱n ma̱ wu.</para>
  <para style="q1" vid="PSA 79:11">Nu ucira wu ukere wa̱ wu,</para>
  <para style="q2" vid="PSA 79:11">vu wawa aza a na e ge'etoi ɗe na oo una.<verse eid="PSA 79:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12" />Zagbain, vu tsupa nron mu nden ntsu hali toto cindere,</para>
  <para style="q2" vid="PSA 79:12">adama a wisulusa u na e isula nuwu.<verse eid="PSA 79:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13" />Amma a̱tsu ama a̱ wu, ikyon ya aguɓa a̱ wu,</para>
  <para style="q2" vid="PSA 79:13">tsu to godyowo wu hali hali,</para>
  <para style="q1" vid="PSA 79:13">diga mantsa a̱ tyo mantsa,</para>
  <para style="q2" vid="PSA 79:13">tsu ta yuwaan wu ica kuci.<verse eid="PSA 79:13" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" sid="PSA 80" />
  <para style="s">Avasa a na a̱ ka̱mbuwa̱ aza a Isra'ila cece</para>
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. A cana yi nu uɗyo &lt;&lt;Yipa̱lu yu una yu nzuwulai.&gt;&gt; Ica ya Asaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1" />Vu uwwa tsu, a̱vu Za va Aguɓa a Isra'ila,</para>
  <para style="q2" vid="PSA 80:1">a̱vu na vu ronoi ugundo wa̱ Isuhu aɗanga cine vu revei oɓolo e ikyon.</para>
  <para style="q2" vid="PSA 80:1">A̱vu na vu ri nden e memere ma nan kerobobi vu ca ekan.<note caller="-" style="x"><char style="xo" closed="false">80:1 </char><char style="xt" closed="false"><ref loc="EXO 25:22">Mta̱ 25:22</ref>.</char></note><verse eid="PSA 80:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 80:2" />Vu ca ugundo wa Ifiramu na̱ Banyami na̱ Manase ekan a̱ wu!</para>
  <para style="q2" vid="PSA 80:2">Vu 'ya̱sa̱n ucira wa̱ wu vu ta̱wa̱ vu wawa tsu.<verse eid="PSA 80:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3" />A̱sula̱, vu ka̱mbuwa̱ tsu,</para>
  <para style="q2" vid="PSA 80:3">vu zuwa urewesu wa̱ wu wi ikana tsu</para>
  <para style="q2" vid="PSA 80:3">adama tsu tsura̱ iwawi!<verse eid="PSA 80:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4" />A̱sulazuva A̱sula̱ o oɓolo a̱ a̱soja a zuva,</para>
  <para style="q2" vid="PSA 80:4">hali mantsa ma̱ ne ma ɗa va̱a̱ da̱na̱ o upan</para>
  <para style="q2" vid="PSA 80:4">na avasa a ama a̱ wu?<verse eid="PSA 80:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5" />Vu lyuwato le ta̱ opopofu a aɓara,</para>
  <para style="q2" vid="PSA 80:5">vu zuwa le ta̱ o sowo aɓara a̱ a̱ba̱jini a yanda.<verse eid="PSA 80:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6" />Vu zuwa ta̱ nron mu nden n tsu,</para>
  <para style="q2" vid="PSA 80:6">a yuwan nla̱ngi adama e iɗa i tsu,</para>
  <para style="q2" vid="PSA 80:6">a̱vu n'yuwatan n tsu n yuwaan tsu ulamu.<verse eid="PSA 80:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7" />Ka̱mba̱to tsu, A̱sula̱ o oɓolo a̱ a̱soja a zuva</para>
  <para style="q2" vid="PSA 80:7">lyawa urewesu wa̱ wu wi ikana tsu</para>
  <para style="q2" vid="PSA 80:7">adama tsu tsura̱ iwawi.<verse eid="PSA 80:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8" />A̱vu ɗa vu uta̱a̱ ntsu, a̱tsu ataci a inabi a̱tsuma̱ a Masar,</para>
  <para style="q2" vid="PSA 80:8">reve vu loso nɗa a̱vu vu shuwa̱ tsu.<verse eid="PSA 80:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9" />Vu lapula ta̱ uba̱ta̱ adama a̱ tsu</para>
  <para style="q2" vid="PSA 80:9">reve tsu yuwan aralu tsu shiton iɗa'a.<verse eid="PSA 80:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10" />Ululu wa ataci'i u pala ta̱ nsasan,</para>
  <para style="q2" vid="PSA 80:10">na̱ ɗanga gbagbain sida na ataci a̱ yi.<verse eid="PSA 80:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11" />Ataci a̱ yi a̱ ba̱ruwa̱ ta̱ a̱ tyo a Mala ma Gbain,</para>
  <para style="q2" vid="PSA 80:11">hali fo a̱ tyo o Uɗolu wa̱ Yufireti.<verse eid="PSA 80:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12" />Adama a̱ nye a ɗa vu ɓosoi ɓaɓu va̱ yi,</para>
  <para style="q2" vid="PSA 80:12">tsa̱ra̱ aza a na a̱ ka̱ra̱sa̱ lo a taɓa umatsun wa̱ yi?<verse eid="PSA 80:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13" />Ijima i lungususa̱ ta̱ ataci'i,</para>
  <para style="q2" vid="PSA 80:13">waru inama yu una i ta tamusa a̱ yi.<verse eid="PSA 80:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14" />A̱sula̱ o oɓolo a̱ a̱soja a zuva, vadala uba̱ta̱ u tsu!</para>
  <para style="q2" vid="PSA 80:14">Vu ka̱lyuwa̱ diga zuva vu kamba ataci a nda,<verse eid="PSA 80:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 80:15" />aralu a na ukere wu ucira wa̱ wu u shuwa̱i,</para>
  <para style="q2" vid="PSA 80:15">mataci ma na vu kungwatoi adama a aciya̱wu.<verse eid="PSA 80:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16" />O koɗo ta̱ ataci a̱ wu a̱ kula̱to yi na akina,</para>
  <para style="q2" vid="PSA 80:16">vu roco upan wa̱ wu vu kototo le.<verse eid="PSA 80:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17" />Lyawa ukere wu ucira wa̱ wu u da̱na̱ a vuma na vu ɗangwai,</para>
  <para style="q2" vid="PSA 80:17">mawun ma vuma ma na vu kungwatoi adama aciya̱wu.<verse eid="PSA 80:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18" />Adama o ndolo tsaa vadalaa wu ucina̱ shi.</para>
  <para style="q2" vid="PSA 80:18">Vu cayisa tsu ucira, tsu ta̱ gba ɗe ala a̱ wu.<verse eid="PSA 80:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19" />A̱sulazuva A̱sula̱ o oɓolo a̱ a̱soja a zuva, vu ka̱mba̱to tsu,</para>
  <para style="q2" vid="PSA 80:19">lyawa urewesu wa̱ wu wi ikana tsu</para>
  <para style="q2" vid="PSA 80:19">adama tsu tsura̱ iwawi.<verse eid="PSA 80:19" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" sid="PSA 81" />
  <para style="s">Ishipa ya̱a̱ a̱buki</para>
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. O una̱ wa &lt;&lt;Giti<note caller="+" style="f"><char style="fr" closed="false">81:0 </char><char style="fq" closed="false">Giti </char><char style="ft" closed="false">Danshi i nda za vu uɗyo wi ishipa i ɗa, ko za tsuwe'e tso o ro.</char></note>.&gt;&gt; Ica ya Asaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1" />Canaa yi A̱sula̱ ishipa i ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 81:1">za na a̱yi ɗa ucira u tsu,</para>
  <para style="q2" vid="PSA 81:1">sala yi lon a̱ tyo uba̱ta̱ wa̱ A̱sula̱ a Yakubu!<verse eid="PSA 81:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2" />'Ya̱sa̱in ishipa i lapa muganga,</para>
  <para style="q2" vid="PSA 81:2">i yuwan tsuwe'e tsu uyo'o na̱ kumburu ni igaraya.<verse eid="PSA 81:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3" />Yi ivula̱ avana o Woto u Sa'avu,</para>
  <para style="q2" vid="PSA 81:3">na amantsa ma na woto u kotoi,</para>
  <para style="q2" vid="PSA 81:3">o urana wa̱ A̱buki a̱ tsu.<note caller="-" style="x"><char style="xo" closed="false">81:3 </char><char style="xt" closed="false"><ref loc="NUM 10:10">Mkc 10:10</ref>.</char></note><verse eid="PSA 81:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4" />A̱yi nda wila̱ u ɗa e ekere aza a Isra'ila,</para>
  <para style="q2" vid="PSA 81:4">udammu u ɗa wa̱ A̱sula̱ a Yakubu.<verse eid="PSA 81:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5" />U ca ta̱ udammu u nda</para>
  <para style="q2" vid="PSA 81:5">adama o ugundo wa̱ Isuhu,</para>
  <para style="q1" vid="PSA 81:5">a mantsa ma na wu uta̱i</para>
  <para style="q2" vid="PSA 81:5">u riya̱a̱ yi iɗa ya Masar.</para>
  <para style="b" vid="PSA 81:5" />
  <para style="q1" vid="PSA 81:5">Mu uwwa ta̱ uɗyo u ro</para>
  <para style="q2" vid="PSA 81:5">u na n revei shi, a dansa,<verse eid="PSA 81:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6" />&lt;&lt;N tawa ta̱ itana yu ume i na i ri a̱ nlyungu nɗu,</para>
  <para style="q2" vid="PSA 81:6">waru n tawa ta̱ a̱tsuma̱lima̱ diga e ekere a̱ ɗu.<verse eid="PSA 81:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7" />Mantsa ma na i ri a̱tsuma̱lima̱</para>
  <para style="q2" vid="PSA 81:7">i ɗe mu ta̱ a̱vu n wawa ɗu.</para>
  <para style="q1" vid="PSA 81:7">A̱vu n usu ɗu diga uba̱ta̱ u na n ri a̱tsuma̱ o upepu.</para>
  <para style="q2" vid="PSA 81:7">N lyungwa̱ ɗu ta̱ ɗe a̱ mini ma Meriba.<note caller="-" style="x"><char style="xo" closed="false">81:7 </char><char style="xt" closed="false"><ref loc="EXO 17:7">Mta̱ 17:7</ref>; <ref loc="NUM 20:13">Mkc 20:13</ref>.</char></note> <char style="qs">Wivuwun</char><verse eid="PSA 81:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8" />Uwwai, a̱ɗu ama a̱ va̱, n to rono ɗu atsuvu,</para>
  <para style="q2" vid="PSA 81:8">a she a damma i ta zuwaa mu atsuvu, a̱ɗu Isra'ila!<verse eid="PSA 81:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9" />She i da̱na̱ na̱ ma̱sula̱ mo omocin a̱tsuma̱ a̱ ɗu wan,<note caller="-" style="x"><char style="xo" closed="false">81:9 </char><char style="xt" closed="false"><ref loc="EXO 20:2-3">Mta̱ 20:2-3</ref>; <ref loc="DEU 5:6-7">U.Wl 5:6-7</ref>.</char></note></para>
  <para style="q2" vid="PSA 81:9">waru she i ka̱ɗa̱towa̱ ma̱sula̱ mo ro wan.<verse eid="PSA 81:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10" />A̱mu ɗa A̱sulazuva A̱sula̱ a̱ ɗu,</para>
  <para style="q2" vid="PSA 81:10">za na uta̱a̱ nɗu e iɗa ya Masar.</para>
  <para style="q1" vid="PSA 81:10">I kpa̱tu'wa̱ una̱ u ɗu,</para>
  <para style="q2" vid="PSA 81:10">a̱mu waru n ta lyuwato ɗu.<verse eid="PSA 81:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11" />&lt;&lt;Amma ama a̱ va̱ a zuwaa mu atsuvu shi,</para>
  <para style="q2" vid="PSA 81:11">Isra'ila ca aciya̱yi ya̱'a̱ va̱ shi.<verse eid="PSA 81:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12" />Ɗaɗa n lyawa nle a lyuwa elime na aciyogbamu e le,</para>
  <para style="q2" vid="PSA 81:12">a yuwan ili i na a cigai.<verse eid="PSA 81:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13" />A damma ama a̱ va̱ a ta zuwaa mu atsuvu!</para>
  <para style="q2" vid="PSA 81:13">Na a damma aza a Isra'ila a̱ shi ta̱ o toni re va̱!<verse eid="PSA 81:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14" />N shi ta̱ a̱a̱ riya̱a̱ n'yuwatan nle,</para>
  <para style="q2" vid="PSA 81:14">a̱vu n lyuwa aci e le babu usa̱n!<verse eid="PSA 81:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15" />Aza a na a 'yuwain A̱sulazuva a̱ ta̱ ka̱ɗa̱to elime a̱yi adama o wovon,</para>
  <para style="q2" vid="PSA 81:15">waru oforo e le a̱ ta̱ da̱na̱ lo hali hali.<verse eid="PSA 81:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16" />Amma a ta lyuwato ɗu no oroci a yitabo a na a la'ai ulobonu,</para>
  <para style="q2" vid="PSA 81:16">ni ishiki diga aatali a na a̱ cuwa̱ton ɗu.&gt;&gt;<verse eid="PSA 81:16" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" sid="PSA 82" />
  <para style="s">Tsuɓari adama o uge'etosu u vama</para>
  <para style="d">Ica ya Asaf.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1" />A̱sula̱ a tara ta̱ tsugbain tsa̱ yi,</para>
  <para style="q2" vid="PSA 82:1">uba̱ta̱ e iɓolo i musula̱ ɗe zuva,</para>
  <para style="q2" vid="PSA 82:1">reve u yuwan uge'etosu a̱tsuma̱ a̱ musula̱'a̱.<note caller="+" style="f"><char style="fr" closed="false">82:1 </char><char style="ft" closed="false">Urevu wu uba̱ta̱ u nda wu uta̱ ta̱ koko'o, ozo o ro a tara ta̱ a ta yuwusan adanshi a nlingata ma̱ A̱sula̱, ozo o ro gba a tara ta̱ u ta yuwusan adanshi a̱ musula̱ mu nɗa n ro.</char></note><verse eid="PSA 82:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2" />U damma,&lt;&lt;Hali mantsa ma̱ ne ma ɗa yaa yuwan uge'etosu u vama,</para>
  <para style="q2" vid="PSA 82:2">e isawusaan a̱za̱ e iwuya? <char style="qs">Wivuwun</char><verse eid="PSA 82:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3" />Yi isawaan aza a na a̱ ri nu ucira shi, oɓolo na̱ mkpa'an,</para>
  <para style="q2" vid="PSA 82:3">yi isawaan alambi na aza a na o ɓongishi.<verse eid="PSA 82:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4" />I kamba alambi na aza a na a cigai ikambishi,</para>
  <para style="q2" vid="PSA 82:4">i wawa le e ekere a̱za̱ e iwuya.&gt;&gt;<verse eid="PSA 82:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5" />E reve ili shi, a̱ ri nu urevu shi.</para>
  <para style="q2" vid="PSA 82:5">A ta a mmalu a̱tsuma̱ e irumbu.</para>
  <para style="q2" vid="PSA 82:5">A̱ jinga̱ɗa̱ ta̱ ikyun i mayan ma amayun o uvaɗi suru.<verse eid="PSA 82:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6" />N damma ta̱, &lt;&lt;A̱ɗu musula̱ n ɗa,</para>
  <para style="q2" vid="PSA 82:6">a̱ɗu muwun m Mogono ma̱ A̱sula̱ n ɗa suru.<note caller="-" style="x"><char style="xo" closed="false">82:6 </char><char style="xt" closed="false"><ref loc="JHN 10:34">Yah 10:34</ref>.</char></note><verse eid="PSA 82:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7" />Amma i ta̱ kuwa̱ tsa vaɗilima̱,</para>
  <para style="q2" vid="PSA 82:7">i ta rawa ukosu tsa akapi o ngono.&gt;&gt;<verse eid="PSA 82:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8" />'Yon A̱sula̱, vu ge'eto wu uvaɗi,</para>
  <para style="q2" vid="PSA 82:8">adama a na nɗa suru ili ya agadu a̱ wu a ɗa.<verse eid="PSA 82:8" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" sid="PSA 83" />
  <para style="s">Avasa adama o kototo n'yuwatan ma Isra'ila</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1" />A̱sula̱, she vu rungwa̱ kpaku wan,</para>
  <para style="q2" vid="PSA 83:1">she vu rungwa̱ wan,</para>
  <para style="q2" vid="PSA 83:1">A̱sula̱, she vi isawan kpen wan.<verse eid="PSA 83:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2" />Ka̱lyuwa̱ cine n'yuwatan ma̱ wu a lapusa ma̱ka̱nka̱</para>
  <para style="q2" vid="PSA 83:2">ka̱lyuwa̱ cine n'yuwatan ma̱ wu a̱ 'ya̱sa̱sa̱n aci e le.<verse eid="PSA 83:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3" />Nu ugbozu ugbozu aa ta yuwusan ifoɓi a aci a ama a̱ wu,</para>
  <para style="q2" vid="PSA 83:3">o to foɓuso maza e ekere aza a na vu cigai.<verse eid="PSA 83:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4" />A dansa &lt;&lt;Ta̱wa̱i, lyawa tsu kototo nle cece o una̱ wu nɗa,</para>
  <para style="q2" vid="PSA 83:4">adama she da̱shi cuwan na aala a Isra'ila wan.&gt;&gt;<verse eid="PSA 83:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5" />No okolo a̱ta̱ a ɗa a yuwain ifoɓi oɓolo,</para>
  <para style="q2" vid="PSA 83:5">o ɓolo ta̱ a aci a yuwan nla̱ngi na̱ a̱vu.<verse eid="PSA 83:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6" />Ele ɗa a̱za̱ Edom na aza a Isma'ila,</para>
  <para style="q2" vid="PSA 83:6">oɓolo na ama a̱ Mowa na aza a Hagara,<verse eid="PSA 83:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7" />na ama a Geba na ama a Amon na aza a Amaleka,</para>
  <para style="q2" vid="PSA 83:7">na aza a Filistiya, oɓolo na ama a Taya.<verse eid="PSA 83:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8" />Aza a Asuriya fo o ɓolo ta̱ aci ne ele,</para>
  <para style="q2" vid="PSA 83:8">tsa̱ra̱ a̱ da̱shi ugundo wa̱ Lutu ucira.<verse eid="PSA 83:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9" />Vu yuwan ne ele cine shi vu yuwain na aza a Midiya,</para>
  <para style="q2" vid="PSA 83:9">na̱ cine shi vu yuwain na aza a Sisera na aza a Jabin o Uɗolu wa̱ Kishon,<note caller="-" style="x"><char style="xo" closed="false">83:9 </char><char style="xt" closed="false"><ref loc="JDG 7:1-23">A̱.Ug 7:1-23</ref>; <ref loc="JDG 4:6-22">A̱.Ug 4:6-22</ref>.</char></note><verse eid="PSA 83:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10" />aza a na a̱ gba̱ra̱i a̱ lyuci va En Do,</para>
  <para style="q2" vid="PSA 83:10">reve wo o'wo cine vu revei edemu e everi e iɗa.<verse eid="PSA 83:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11" />Vu ka̱mbuwa̱ azagbain e le tsa̱ Ore na̱ Zeye,</para>
  <para style="q2" vid="PSA 83:11">a̱za̱ o tsugono tsa̱ a̱ yi tsa̱ Zeba na̱ Zalumuna,<note caller="-" style="x"><char style="xo" closed="false">83:11 </char><char style="xt" closed="false"><ref loc="JDG 7:25">A̱.Ug 7:25</ref>; <ref loc="JDG 8:12">A̱.Ug 8:12</ref>.</char></note><verse eid="PSA 83:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12" />aza a na a dammai, &lt;&lt;Lyawa tsu usai</para>
  <para style="q2" vid="PSA 83:12">uba̱ta̱ wa aguɓa wa̱ A̱sula̱, wo o'wo za tsu.&gt;&gt;<verse eid="PSA 83:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13" />A̱sula̱ a̱ va̱, vu ka̱mba̱to le tsa̱ lipa̱</para>
  <para style="q2" vid="PSA 83:13">tso owopo uba̱ta̱ o upepu.<verse eid="PSA 83:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14" />Cine akina a̱ tsu kula̱to a̱rumbu,</para>
  <para style="q2" vid="PSA 83:14">ko cine akina a tsu dala a masasan,<verse eid="PSA 83:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15" />vu gba̱ra̱ le na̱ wunla̱ wu upepu wa̱ wu,</para>
  <para style="q2" vid="PSA 83:15">a̱vu vu ca le wovon nu upepu wu ucira wa̱ wu.<verse eid="PSA 83:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16" />A̱sulazuva vu zuwa wono u ɓa̱ru le,</para>
  <para style="q2" vid="PSA 83:16">adama ama a zami aala a̱ wu.<verse eid="PSA 83:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17" />Vu zuwa a uwwa wono, a da'waton le hali hali,</para>
  <para style="q2" vid="PSA 83:17">lyawa a̱ kuwa̱ a̱tsuma̱ o wono.<verse eid="PSA 83:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18" />Vu zuwa le e reve a na a̱vu ɗa A̱sulazuva goon,</para>
  <para style="q2" vid="PSA 83:18">ana a̱vu ɗa goon Mogono me Ili Suru o uvaɗi ma̱ɓula̱.<verse eid="PSA 83:18" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" sid="PSA 84" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. O una̱ wa &lt;&lt;Giti<note caller="+" style="f"><char style="fr" closed="false">84:0 </char><char style="fq" closed="false">Giti </char><char style="ft" closed="false">Danshi i nda za vu uɗyo wi ishipa i ɗa, ko za tsuwe'e tso o ro.</char></note>.&gt;&gt; Ica yo olobo a Kora.</para>
  <para style="s">Mazuwa mo okolo a̱ A̱a̱'isamapaɗa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1" />A̱sulazuva Mogono me ili suru!</para>
  <para style="q2" vid="PSA 84:1">N te e icigi ya̱ A̱a̱'isa̱mapaɗa a̱ wu lon.<verse eid="PSA 84:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2" />Ɗe ɗa n cigai n da̱na̱!</para>
  <para style="q2" vid="PSA 84:2">A̱sulazuva n ta maluwa mo ukowo wa̱ a̱ a̱a̱'isa̱ a̱ wu.</para>
  <para style="q1" vid="PSA 84:2">Na̱ ma̱za̱nga̱ ma̱ a̱bunda̱ ma ɗa ma cana ishipa</para>
  <para style="q2" vid="PSA 84:2">a̱ tyo a̱ A̱sula̱ a wuma.<verse eid="PSA 84:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3" />Ko matali ma̱ tsura̱ ta̱ u'wa,</para>
  <para style="q2" vid="PSA 84:3">ko manunu ma̱ ta̱ ni nkinda adama aciya̱yi,</para>
  <para style="q1" vid="PSA 84:3">uba̱ta̱ u na wa̱a̱ da̱nu na̱ muwun ma̱ yi,</para>
  <para style="q2" vid="PSA 84:3">uba̱ta̱ zuzu na̱ masa'a ma̱ wu,</para>
  <para style="q1" vid="PSA 84:3">A̱sulazuva Mogono me ili suru,</para>
  <para style="q2" vid="PSA 84:3">Mogono ma̱ va̱ na̱ A̱sula̱ a̱ va̱.<verse eid="PSA 84:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4" />A̱za̱ a̱ ma̱za̱nga̱ a ɗa aza a na a̱ ri nden o u'wa wa̱ wu,</para>
  <para style="q2" vid="PSA 84:4">mantsa suru a ta yuwusan wu ishipa yi ica.<verse eid="PSA 84:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5" />A̱za̱ a̱ ma̱za̱nga̱ a ɗa, aza a na a̱ tsura̱i ucira diga uba̱ta̱ wa̱ wu,</para>
  <para style="q2" vid="PSA 84:5">aza a na majiyan me le a̱ ka̱ra̱ a̱ ya̱wa̱ Sihiyona.<verse eid="PSA 84:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6" />Mantsa ma na a̱ ka̱ra̱la̱i o Uka̱ri u babu mini,</para>
  <para style="q2" vid="PSA 84:6">a̱ ka̱mba̱to yi ta̱ uba̱ta̱ wu n ɓula n mini,</para>
  <para style="q2" vid="PSA 84:6">cine mini mo ufaru, ma̱ tsu ɓa̱ru ba̱ta̱ na̱ ɗolu.<verse eid="PSA 84:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7" />A̱ ta̱ da̱shishi ucira,</para>
  <para style="q2" vid="PSA 84:7">hali she na̱ za suru roco aciya̱yi</para>
  <para style="q2" vid="PSA 84:7">elime a̱ A̱sula̱ a̱ Sihiyona.<verse eid="PSA 84:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8" />A̱sulazuva, A̱sula̱ Mogono me ili suru, uwwa avasa a̱ va̱,</para>
  <para style="q2" vid="PSA 84:8">vu zuwaa mu atsuvu A̱sula̱ a Yakubu!<verse eid="PSA 84:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9" />A̱sula̱ vu ka̱lyuwa̱ a̱a̱ra̱ga̱ a̱ tsu mogono,</para>
  <para style="q2" vid="PSA 84:9">vee ene iliyali yi za na vu tawai.<verse eid="PSA 84:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10" />Urana uta̱ o u'wa wa̱ wu,</para>
  <para style="q2" vid="PSA 84:10">u la'a ta̱ rana ukpakukupa uba̱ta̱ u ro.</para>
  <para style="q1" vid="PSA 84:10">Uta la'a mu n da̱na̱ za vi ipiri o una̱ntsu wu u'wa wa̱ A̱sula̱</para>
  <para style="q2" vid="PSA 84:10">a na ma̱a̱ da̱nu, o ogodo a̱za̱ e iwuya.<verse eid="PSA 84:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11" />Adama a na A̱sulazuva A̱sula̱, a̱yi ɗa urana na̱ a̱a̱ra̱ga̱ a̱ tsu,</para>
  <para style="q2" vid="PSA 84:11">u tsu ta̱wa̱ ta̱ na aba'un, ni isa'ani na̱ tsugbain.</para>
  <para style="q2" vid="PSA 84:11">Babu ili i sa'ani, i na A̱sulazuva u tsu putsaa,</para>
  <para style="q2" vid="PSA 84:11">aza a na a yuwusan mmalu, na amayun o okolo ele.<verse eid="PSA 84:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12" />A̱sulazuva Mogono me ili suru,</para>
  <para style="q2" vid="PSA 84:12">za ma̱za̱nga̱ ɗa vuma na zuwai okolo a̱ yi uba̱ta̱ wa̱ wu.<verse eid="PSA 84:12" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" sid="PSA 85" />
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Wo olobo a Kora. Ica i ɗa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1" />A̱sulazuva, vu roco iɗa ya̱ wu isa'ani,</para>
  <para style="q2" vid="PSA 85:1">vu ka̱mbuwa̱a̱ Isra'ila na̱ tsugbain tsa̱ yi.<verse eid="PSA 85:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2" />Vu yuwaan ama a̱ wu gafura vu nusu le,</para>
  <para style="q2" vid="PSA 85:2">reve vu tawa nusu le suru.<verse eid="PSA 85:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3" />Vu bula̱ upan wa̱ wu ya̱'a̱ le,</para>
  <para style="q2" vid="PSA 85:3">vu lyawa upan wu usuɗuwu wa̱ wu.<verse eid="PSA 85:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4" />A̱sula̱ za vi iwawi i tsu vu ka̱mbuwa̱ tsu,</para>
  <para style="q2" vid="PSA 85:4">a̱vu vu tawa tsu ulambu u mawwa mo uyo'o.<verse eid="PSA 85:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5" />Vu ta̱ da̱na̱ o upan na̱ a̱tsu, babu ukotu?</para>
  <para style="q2" vid="PSA 85:5">Vu ta̱ da̱na̱ o upan hali a̱ tyo a mantsa suru?<verse eid="PSA 85:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6" />Va̱a̱ ka̱mbuwa̱ tsu wuma waru shi?</para>
  <para style="q2" vid="PSA 85:6">Adama ama a yuwan ma̱za̱nga̱ na̱ vu.<verse eid="PSA 85:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7" />A̱sulazuva, vu roco tsu icigi ya̱ wu i na i tsu vadala shi,</para>
  <para style="q2" vid="PSA 85:7">a̱vu vu roco tsu iwawi ya̱ wu.<verse eid="PSA 85:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8" />N ta̱ polo atsuvu e ili i na A̱sula̱, A̱sulazuva a damma,</para>
  <para style="q2" vid="PSA 85:8">adama a na u yuwan ta̱ nzuwulai mu nden ma asuvu na ama a̱ yi,</para>
  <para style="q2" vid="PSA 85:8">ama a̱ɓula̱ a̱ yi, amma she a̱ ka̱mba̱ a̱ tsulo tse le wan.<verse eid="PSA 85:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9" />Amayun, iwawi ya̱ yi i ta̱ lo, zuzu na aza a na a uwwusa wovon wa̱ yi,</para>
  <para style="q2" vid="PSA 85:9">adama tsugbain tsa̱ yi tsa̱ da̱nu, e iɗa i tsu.<verse eid="PSA 85:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10" />Icigi na amayun a ta ga'asan,</para>
  <para style="q2" vid="PSA 85:10">a̱ɓula̱ na̱ nden ma asuvu, a ta katalalai aciyele.<verse eid="PSA 85:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11" />Amayun a̱ ta̱ uta̱ diga e iɗa,</para>
  <para style="q2" vid="PSA 85:11">a̱ɓula̱ waru diga zuva.<verse eid="PSA 85:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12" />Amayun A̱sulazuva a ta ca ili i na i ri yu ulobonu</para>
  <para style="q2" vid="PSA 85:12">waru iɗa i tsu i ta matsan itana yu uɗuma̱ ya̱ a̱bunda̱.<verse eid="PSA 85:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13" />A̱ɓula̱ a uwa ta̱ elime yi,</para>
  <para style="q2" vid="PSA 85:13">u lapula ure u na wo toni.<verse eid="PSA 85:13" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" sid="PSA 86" />
  <para style="s">Avasa Adama e Izami yi Ikambishi</para>
  <para style="d">Avasa a̱ Da̱wuda.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1" />A̱sulazuva, vu uwwa mu, a̱vu vu usu mu</para>
  <para style="q2" vid="PSA 86:1">adama a na a̱mu za vu ulambu ɗa za na cigai ikambishi.<verse eid="PSA 86:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2" />Vu wawa wuma u va̱,</para>
  <para style="q2" vid="PSA 86:2">adama a na n ca ta̱ aciya̱va̱ ya̱'a̱ wu.</para>
  <para style="q1" vid="PSA 86:2">A̱vu ɗa A̱sula̱ a̱ va̱, vu wawa aagbashi a̱ wu,</para>
  <para style="q2" vid="PSA 86:2">zana zuwai ucira wa̱ yi ya̱'a̱ wu.<verse eid="PSA 86:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3" />A̱sulazuva, ene iliyali i va̱,</para>
  <para style="q2" vid="PSA 86:3">adama a na n ɗewu wu ta̱ urana ma̱ɓula̱.<verse eid="PSA 86:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4" />Ta̱wa̱a̱ aagbashi a̱ wu, na̱ ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 86:4">adama a na avasa a̱ va̱ a gawan ta̱ ya̱'a̱ wu.<verse eid="PSA 86:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5" />A̱sulazuva, a̱vu za na tsu yuwusan gafura ɗa</para>
  <para style="q2" vid="PSA 86:5">na̱ mayan me isa'ani, ni icigi ya̱ a̱bunda̱,</para>
  <para style="q2" vid="PSA 86:5">a̱ tyo uba̱ta̱ wa aza a na e ɗesu ya̱ a̱ wu.<verse eid="PSA 86:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6" />A̱sulazuva, vu uwwa avasa a̱ va̱,</para>
  <para style="q2" vid="PSA 86:6">vu uwwa mesun me izami yi ikambishi i va̱.<verse eid="PSA 86:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7" />A mantsa ma̱ a̱tsuma̱lima̱ n ta̱ ɗe wu,</para>
  <para style="q2" vid="PSA 86:7">adama a na vu ta uwwa mu.<verse eid="PSA 86:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8" />A̱sulazuva, a̱tsuma̱ a̱ musula̱ babu tsa̱ wu,</para>
  <para style="q2" vid="PSA 86:8">babu linga na ri lo na a kurato na̱ linga va̱ wu.<verse eid="PSA 86:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9" />A̱sulazuva, nɗa nna vu yuwain suru,</para>
  <para style="q2" vid="PSA 86:9">a̱ ta̱ ta̱wa̱ a̱ kingyo a yuwaan wu a̱ga̱nda̱,</para>
  <para style="q2" vid="PSA 86:9">a ta ca a ala a̱ wu tsugbain.<verse eid="PSA 86:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10" />Adama a na a̱vu zagbain ɗa,</para>
  <para style="q2" vid="PSA 86:10">waru vu yuwan ta̱ linga va asalama,</para>
  <para style="q2" vid="PSA 86:10">a̱vu ɗa goon A̱sula̱.<verse eid="PSA 86:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11" />A̱sulazuva, rito mu ure wa̱ wu,</para>
  <para style="q2" vid="PSA 86:11">adama n wala a̱tsuma̱ amayun a̱ wu.</para>
  <para style="q1" vid="PSA 86:11">Ca mu okolo a̱ ta̱,</para>
  <para style="q2" vid="PSA 86:11">tsa̱ra̱ mu uwwa wovon wa aala a̱ wu.<verse eid="PSA 86:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12" />A̱sulazuva A̱sula̱ a̱ va̱, n ta yuwaan wu ica no okolo a̱ va̱ suru,</para>
  <para style="q2" vid="PSA 86:12">n ta ca aala a̱ wu tsugbain hali hali.<verse eid="PSA 86:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13" />Adama a na icigi ya̱ wu i na i tsu vadala shi, e ekere a̱ va̱ u ta̱ a̱bunda̱.</para>
  <para style="q2" vid="PSA 86:13">Vu wawa ta̱ wuma u va̱, diga a̱ru'un</para>
  <para style="q2" vid="PSA 86:13">o uba̱ta̱ wu nden ma̱ a̱kwa̱kwa̱.<verse eid="PSA 86:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14" />A̱sula̱, aza aciyogbamu a̱ 'ya̱sa̱a̱n mu ta̱,</para>
  <para style="q2" vid="PSA 86:14">o oɓolo aza a na a̱ tse ene iliyali shi,</para>
  <para style="q2" vid="PSA 86:14">a̱ ta̱ e izami i wuma i va̱,</para>
  <para style="q2" vid="PSA 86:14">aza a na a tara nuwu ili shi.<verse eid="PSA 86:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15" />Amma a̱vu, A̱sulazuva, A̱sula̱ a ɗa za vi iliyali ni isa'ani,</para>
  <para style="q2" vid="PSA 86:15">vu tsu yuwan upan go'o shi,</para>
  <para style="q2" vid="PSA 86:15">za vi icigi ya̱ a̱bunda̱ na amayun.<verse eid="PSA 86:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16" />Vu vadala a̱ ta̱wa̱ uba̱ta̱ u va̱ vu yuwaan mu isa'ani,</para>
  <para style="q2" vid="PSA 86:16">vu ca aagbashi a̱ wu ucira,</para>
  <para style="q2" vid="PSA 86:16">a̱vu vu wawa ulobo wa aagbashi a ka va̱ wu.<verse eid="PSA 86:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17" />A̱sulazuva vu roco mu iroci yi isa'ani ya̱ wu,</para>
  <para style="q2" vid="PSA 86:17">tsa̱ra̱ n'yuwatan n va̱ ene a uwwa wono,</para>
  <para style="q1" vid="PSA 86:17">adama a na a̱vu ɗa vu kamba numu</para>
  <para style="q2" vid="PSA 86:17">a̱vu vu ca mu adanshi.<verse eid="PSA 86:17" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" sid="PSA 87" />
  <para style="s">Ishipa i Ma̱za̱nga̱ ma̱ Nden a̱tsuma̱ a̱ Sihiyona</para>
  <para style="d">Ishipa i muwun mo olobo ma Kora. Ishipa i ɗa.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1" />A̱sulazuva a̱ shuwa̱ ta̱ ikyun i lyuci va̱ yi,</para>
  <para style="q2" vid="PSA 87:1">zuva va aatali a akiza.<verse eid="PSA 87:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2" />U ciga ta̱ na̱ntsu lyuci va̱ yi,</para>
  <para style="q2" vid="PSA 87:2">ula'awu na̱ nda̱na̱ta̱ ma Yakubu.<verse eid="PSA 87:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3" />A yuwan ta̱ adanshi a sa'ani a aci a̱ wu,</para>
  <para style="q2" vid="PSA 87:3">a̱vu lyuci va̱ A̱sula̱.<verse eid="PSA 87:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4" />&lt;&lt;N ta̱ kece Rahapu a̱tsuma̱ aza a na e reve numu,</para>
  <para style="q2" vid="PSA 87:4">oɓolo na̱ Filistiya na̱ Taya na̱ Kush,</para>
  <para style="q2" vid="PSA 87:4">waru a ta damma, &lt;A matsan yi ta̱ a̱tsuma̱ a̱ Sihiyona.&gt; &gt;&gt;<verse eid="PSA 87:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5" />Na amayun adama a̱ Sihiyona a ta damma,</para>
  <para style="q2" vid="PSA 87:5">&lt;&lt;A̱yi nda na̱ a̱yi ndeɗe, a matsan le ta̱ a̱tsuma̱ a̱ yi,&gt;&gt;</para>
  <para style="q2" vid="PSA 87:5">a̱yi Mogono ma̱ A̱sula̱ na aciya̱yi a ɗa wa̱ shuwa̱ yi.<verse eid="PSA 87:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6" />A̱sulazuva a ta ɗana, o udaru wa aala ama a̱ yi,</para>
  <para style="q2" vid="PSA 87:6">ele nda a matsan le ta̱ Sihiyona.<verse eid="PSA 87:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7" />Ndobiya na̱ a̱za̱ o uje'en a ta cana,</para>
  <para style="q2" vid="PSA 87:7">&lt;&lt;Ya̱'a̱ wu ɗa ufaru u va̱ wu uta̱i.&gt;&gt;<verse eid="PSA 87:7" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" sid="PSA 88" />
  <para style="s">Mesun me Izami yi Ikambishi</para>
  <para style="d">Udammu a̱tyo ya̱ ma̱dobiya. A yuwain a cana yi, &lt;&lt;Nu uɗyo wa̱ a̱tsuma̱lima̱.&gt;&gt; I ca yo olobo a Kora. &lt;&lt;Ishipa yu uyo'o&gt;&gt; Wa Heman edenge a̱ Ezura. Ishipa i ɗa.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1" />A̱sulazuva, A̱sula̱ e iwawi i va̱, urana na ayin n ta̱wa̱ ta̱</para>
  <para style="q2" vid="PSA 88:1">na̱ mesun ma̱ va̱, a̱ ma̱ka̱ka̱n ma̱ wu.<verse eid="PSA 88:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2" />Lyawa avasa a̱ va̱ a rawa a̱ ma̱ka̱ka̱n ma̱ wu,</para>
  <para style="q2" vid="PSA 88:2">vu poloo mesun ma̱ va̱ atsuvu!<verse eid="PSA 88:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3" />Adama a na wuma u va̱ u ta̱ tapu na addama,</para>
  <para style="q2" vid="PSA 88:3">wuma u va̱ u ta̱ zuzu nu ukwa̱.<verse eid="PSA 88:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4" />E kece mu ta̱ a̱tsuma̱ aza a na a̱a̱ ka̱ra̱ a̱ tyo a aason,</para>
  <para style="q2" vid="PSA 88:4">mo o'wo ta̱ tsa vuma na ri nu ucira shi.<verse eid="PSA 88:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5" />A kasa mu ta̱ oɓolo nu ukwa̱,</para>
  <para style="q2" vid="PSA 88:5">cine vu revei aza a na o unai, a na a̱ ri nven a aason,</para>
  <para style="q1" vid="PSA 88:5">aza a na a buwai a na a cuwan ne ele shi,</para>
  <para style="q2" vid="PSA 88:5">aza a na a kasai, ni ikambishi ya̱ wu.<verse eid="PSA 88:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6" />Vu vari mu ta̱ a̱a̱ka̱ri a̱ a̱ru'un,</para>
  <para style="q2" vid="PSA 88:6">uba̱ta̱ u na u la'ai a̱ru'un ni irumbu.<verse eid="PSA 88:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7" />Upan wa̱ wu u ta̱ a̱bunda̱ a aci a̱ va̱,</para>
  <para style="q2" vid="PSA 88:7">hali u la'a ucira u va̱ tse e ikeɗu i mini.<verse eid="PSA 88:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8" />Vu zuwa ta̱ n'utsa̱ n va̱ n suma mu,</para>
  <para style="q2" vid="PSA 88:8">vu zuwa mu ta̱ mo o'wo ili yi idaba e ekere e le.</para>
  <para style="q2" vid="PSA 88:8">A̱ ɓa̱ru mu ta̱ n ri n cine maa gura uta̱ shi.<verse eid="PSA 88:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 88:9" />Esu a̱ va̱ e inda ulobonu shi,</para>
  <para style="q2" vid="PSA 88:9">adama a̱bunda̱ a̱tsuma̱lima̱.</para>
  <para style="b" vid="PSA 88:9" />
  <para style="q1" vid="PSA 88:9">A̱sulazuva, n ta̱ e ɗewu va̱ wu usana suru,</para>
  <para style="q2" vid="PSA 88:9">a̱ 'ya̱susa̱n ekere a̱ va̱ a̱ tyo uba̱ta̱ wa̱ wu.<verse eid="PSA 88:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10" />Vu tsu roco ta̱ a̱kwa̱kwa̱, linga va asalama a̱ wu?</para>
  <para style="q2" vid="PSA 88:10">Ko aza a na a̱ kuwa̱i ɗe, a̱ tsu 'yon ta̱ a yuwaan wu ica?<verse eid="PSA 88:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11" />A tsu yuwan ta̱ adanshi e icigi ya̱ wu a̱tsuma̱ a aason?</para>
  <para style="q2" vid="PSA 88:11">Ko amayun a̱ wu uba̱ta̱ wu ukototosu?<verse eid="PSA 88:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12" />A̱ tse ene ta̱ ili ya asalama a̱ wu, a̱tsuma̱ e irumbu?</para>
  <para style="q2" vid="PSA 88:12">Ko linga va̱ a̱ɓula̱ va̱ wu, e iɗa ya̱ a̱kwa̱kwa̱?<verse eid="PSA 88:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13" />A̱sulazuva, n showen wu ta̱ adama e ikambishi,</para>
  <para style="q2" vid="PSA 88:13">usana suru avasa a̱ va̱ a̱ ta̱ 'ya̱wusa̱ ya̱ wu.<verse eid="PSA 88:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14" />A̱sulazuva, adama a̱ nye ɗa vu vari numu?</para>
  <para style="q2" vid="PSA 88:14">Adama a̱ nye vu tawai urewesu wa̱ wu uba̱ta̱ u va̱?<verse eid="PSA 88:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15" />Diga a̱mu o ulobo n ta̱ na̱ a̱tsuma̱lima̱,</para>
  <para style="q2" vid="PSA 88:15">hali n shi n ciga ma̱kuwa̱a̱.</para>
  <para style="q1" vid="PSA 88:15">Vu zuwa ta̱ wovon wa̱ wu u reme mu,</para>
  <para style="q2" vid="PSA 88:15">uba̱ta̱ una n vadalai biti.<verse eid="PSA 88:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16" />Upan wa̱ a̱bunda̱ u la'a ta̱ ucira u va̱</para>
  <para style="q2" vid="PSA 88:16">wovon wa̱ wu u kototo mu ta̱.<verse eid="PSA 88:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17" />A̱ ka̱nda̱ruwa̱ mu ta̱, tsi ikeɗu i mini urana ma̱ɓula̱,</para>
  <para style="q2" vid="PSA 88:17">a̱ ka̱nda̱ruwa̱ mu ta̱ uba̱ta̱ suru.<verse eid="PSA 88:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18" />Vu zuwa ta̱ n'utsa̱ n va̱ na aza a na a ciga numu a suma mu,</para>
  <para style="q2" vid="PSA 88:18">irumbu i ɗa goon i'utsa̱ i va̱.<verse eid="PSA 88:18" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" sid="PSA 89" />
  <para style="s">Nzuwulai ma̱ A̱sula̱ na̱ Da̱wuda</para>
  <para style="d">Ishipa yu uyo'o ya̱ Etan vu ugundo wa̱ Ezura</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1" />A̱sulazuva n ta cana ishipa</para>
  <para style="q2" vid="PSA 89:1">adama e icigi ya̱ wu i na i tsu vadala shi kuci,</para>
  <para style="q1" vid="PSA 89:1">nu una̱ u va̱ u ɗa maa damma a ɗa a amayun a̱ wu,</para>
  <para style="q2" vid="PSA 89:1">a̱ tyo mantsa suru.<verse eid="PSA 89:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2" />N ta damma a na icigi ya̱ wu i na i tsu vadala shi</para>
  <para style="q2" vid="PSA 89:2">i ta̱ lo hali hali,</para>
  <para style="q2" vid="PSA 89:2">adansa vu shuwa̱ ta̱ amayun a̱ wu ɗe zuva.<verse eid="PSA 89:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3" />Vu damma ta̱,</para>
  <para style="q2" vid="PSA 89:3">&lt;&lt;N yuwan ta̱ nzuwulai na̱ za na n ɗangwai,</para>
  <para style="q2" vid="PSA 89:3">n kucinaa ta̱ Da̱wuda aagbashi a̱ va̱,<verse eid="PSA 89:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4" />adansa, &lt;N ta̱ shuwa̱ ugundo wa̱ wu hali hali,</para>
  <para style="q2" vid="PSA 89:4">waru n zuwa ugundo wa̱ wu u yuwan tsugono,</para>
  <para style="q2" vid="PSA 89:4">diga a mantsa a̱ tyo mantsa.<note caller="-" style="x"><char style="xo" closed="false">89:4 </char><char style="xt" closed="false"><ref loc="2SA 7:12-16">2 Sam 7:12-16</ref>; <ref loc="1CH 17:11-14">1 Alb 17:11-14</ref>; <ref loc="PSA 132:11">Ica 132:11</ref>; <ref loc="ACT 2:30">Ajy 2:30</ref>.</char></note>&gt; &gt;&gt; <char style="qs">Wivuwun</char><verse eid="PSA 89:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5" />A̱sulazuva, lyawa zuva cuwa linga va asalama a̱ wu,</para>
  <para style="q2" vid="PSA 89:5">na amayun a̱ wu a̱tsuma̱ e iɓolo ya aza a akiza ɗe zuva.<verse eid="PSA 89:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6" />A̱sulazuva, zane ɗa ɗe zuva na a kurato na̱ a̱vu?</para>
  <para style="q2" vid="PSA 89:6">Zane ɗa ri tsa̱ wu, a̱tsuma̱ a̱ musula̱?<verse eid="PSA 89:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7" />A̱tsuma̱ e iɓolo ya aza a akiza ɗe zuva,</para>
  <para style="q2" vid="PSA 89:7">a̱vu ɗa a la'a uwwai wovon,</para>
  <para style="q1" vid="PSA 89:7">a̱vu ɗa vu la'ai ili i wovon a̱tsuma̱ aza a na a̱ ri</para>
  <para style="q2" vid="PSA 89:7">uka̱nda̱ruwu na̱ a̱vu suru.<verse eid="PSA 89:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8" />A̱sulazuva A̱sula̱ o oɓolo a̱ a̱soja a zuva,</para>
  <para style="q2" vid="PSA 89:8">zane ɗa ri tsa̱ wu?</para>
  <para style="q1" vid="PSA 89:8">A̱sulazuva, a̱vu za vu ucira ɗa</para>
  <para style="q2" vid="PSA 89:8">waru amayun a̱ wu a̱ tu uka̱nda̱ruwu na̱ a̱vu.<verse eid="PSA 89:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9" />Vu ta yuwusan tsugbain tsa mala mo ujaru.</para>
  <para style="q2" vid="PSA 89:9">Mantsa ma na ikeɗu ya̱ yi i 'yon yi, vu tsu voton le ta̱.<verse eid="PSA 89:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10" />Vu rukutsa̱ ta̱ Rahapu<note caller="+" style="f"><char style="fr" closed="false">89:10 </char><char style="fq" closed="false">Rahapu </char><char style="ft" closed="false">Rahapu aala a̱ ododo a̱ mini a ɗa.</char></note> tsa a aza a na o unai.</para>
  <para style="q2" vid="PSA 89:10">Nu ukere wu ucira wa̱ wu u ɗa,</para>
  <para style="q2" vid="PSA 89:10">vu bete'wei n'yuwatan ma̱ wu.<verse eid="PSA 89:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11" />Zuva za va̱ wu ɗa, oɓolo nu uvaɗi.</para>
  <para style="q2" vid="PSA 89:11">Vu shuwa̱ ta̱ uvaɗi,</para>
  <para style="q2" vid="PSA 89:11">oɓolo ni ili i na i ri pe a̱tsuma̱ a̱ yi.<verse eid="PSA 89:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12" />A̱vu ɗa vu yuwain ugana nu uyagi.</para>
  <para style="q2" vid="PSA 89:12">Masasan ma Tabo na̱ Hamon,</para>
  <para style="q2" vid="PSA 89:12">a ta canasa ishipa ya aala a̱ wu adama a̱ ma̱za̱nga̱.<verse eid="PSA 89:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13" />Ukere wa̱ wu u ta̱ nu ucira,</para>
  <para style="q2" vid="PSA 89:13">ukere wa̱ wu u ta̱ nu ukadu,</para>
  <para style="q2" vid="PSA 89:13">ukere wa̱ wu u tsura̱ ta̱ tsugbain.<verse eid="PSA 89:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14" />A̱ɓula̱ nu uge'etosu wa amayun,</para>
  <para style="q2" vid="PSA 89:14">ele ɗa ikyun i tsugono tsa̱ wu.</para>
  <para style="q1" vid="PSA 89:14">Icigi i na i tsu vadala shi na amayun</para>
  <para style="q2" vid="PSA 89:14">ele ɗa a̱ ri elime a̱ wu.<verse eid="PSA 89:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15" />A̱sulazuva, a̱za̱ a̱ ma̱za̱nga̱ a ɗa aza a na</para>
  <para style="q2" vid="PSA 89:15">a yuwusaan wu a̱ga̱nda̱ a canasa ishipa,</para>
  <para style="q1" vid="PSA 89:15">aza a na a̱ ri a mmalu e ekan</para>
  <para style="q2" vid="PSA 89:15">a na a̱ ri elime a̱ wu!<verse eid="PSA 89:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16" />A ta yuwusan ma̱za̱nga̱ na ala a̱ wu urana ma̱ɓula̱,</para>
  <para style="q2" vid="PSA 89:16">adama a̱ a̱ɓula̱ a̱ wu a̱ ta̱ tsura̱sa̱ tsugbain.<verse eid="PSA 89:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17" />A̱vu ɗa vu tsu ca le tsugbain nu ucira,</para>
  <para style="q2" vid="PSA 89:17">waru a̱tsuma̱ e isa'ani ya̱ wu vu ca le ta̱ ulyuwu wa aci.<verse eid="PSA 89:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18" />Amayun, A̱sulazuva a ɗa a̱a̱ra̱ga̱ a̱ tsu,</para>
  <para style="q2" vid="PSA 89:18">za va Akiza a Isra'ila, a̱yi ɗa mogono ma̱ tsu.<verse eid="PSA 89:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19" />Nu ujumu ɗe vu yuwan ta̱ adanshi a̱tsuma̱ alavu alavu,</para>
  <para style="q2" vid="PSA 89:19">a̱ tyo uba̱ta̱ wa̱ a̱za̱ a̱ a̱ɓula̱ a̱ wu.</para>
  <para style="q1" vid="PSA 89:19">Vu damma, &lt;&lt;N ca ta̱ a̱soja a na gurai uvon ucira,</para>
  <para style="q2" vid="PSA 89:19">n 'ya̱sa̱n ta̱ ulobo a̱tsuma̱ a ama.<verse eid="PSA 89:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20" />N tsura̱ ta̱ Da̱wuda aagbashi a̱ va̱,</para>
  <para style="q2" vid="PSA 89:20">n tsuwa̱a̱n yi ta̱ mani'in ma akiza ma̱ va̱.<verse eid="PSA 89:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21" />Ukere u va̱ u ta̱ da̱na̱ oɓolo na̱ a̱yi.</para>
  <para style="q2" vid="PSA 89:21">Amayun, ukere u va̱ u ta ca yi ucira.<verse eid="PSA 89:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22" />N'yuwatan ma lyuwa aci a̱ yi shi,</para>
  <para style="q2" vid="PSA 89:22">babu vuma wuya na a gura ɓongi yi.<verse eid="PSA 89:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23" />N ta̱ rukutsa̱ n'yuwatan ma̱ yi elime a̱yi,</para>
  <para style="q2" vid="PSA 89:23">a̱vu mu una aza a na a 'yuwan niyi.<verse eid="PSA 89:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24" />Amayun a̱ va̱ ni icigi i va̱ i na i tsu vadala shi,</para>
  <para style="q2" vid="PSA 89:24">a̱ ta̱ da̱na̱ oɓolo na̱ a̱yi,</para>
  <para style="q2" vid="PSA 89:24">ucira wa̱ yi u ta̱ tsura̱ tsugbain adama a ala a̱ va̱.<verse eid="PSA 89:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25" />N ta zuwa tsugono tsa̱ yi</para>
  <para style="q2" vid="PSA 89:25">tsa bala a aci a mala,</para>
  <para style="q2" vid="PSA 89:25">a̱ tyo zuva vu ɗolu.<verse eid="PSA 89:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26" />U ta̱ ɗe mu u damma, &lt;A̱vu ɗa Dada va̱,</para>
  <para style="q2" vid="PSA 89:26">A̱sula̱ a̱ va̱ na Aatali e iwawi i va̱!&gt;<verse eid="PSA 89:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27" />N ta ɗangwa yi wo o'wo ulobo wu ufaru u va̱,</para>
  <para style="q2" vid="PSA 89:27">za na a la'ai tsugbain a̱tsuma̱ o ngono mu uvaɗi.<verse eid="PSA 89:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28" />N ta lyuwa elime o rocosu yi</para>
  <para style="q2" vid="PSA 89:28">icigi i va̱ i na i tsu vadala shi hali hali.</para>
  <para style="q1" vid="PSA 89:28">Nzuwulai n va̱ na̱ a̱yi,</para>
  <para style="q2" vid="PSA 89:28">n ta̱ da̱na̱ lo hali hali.<verse eid="PSA 89:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29" />N ta̱ shuwa̱ ugundo wa̱ yi hali hali,</para>
  <para style="q2" vid="PSA 89:29">tsugono tsa̱ yi waru nna̱ zuva ri lo.<verse eid="PSA 89:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30" />&lt;&lt;No olobo a̱ yi a lyawa wila̱ u va̱,</para>
  <para style="q2" vid="PSA 89:30">agba a̱ kuru udammu u va̱ shi,<verse eid="PSA 89:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31" />nna̱ a kuɗa ili i na n zuwai,</para>
  <para style="q2" vid="PSA 89:31">a̱vu a 'yuwan o toni ili i na n dammai,<verse eid="PSA 89:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32" />n ta̱ ge'eto le adama o u'ya̱susa̱n wa aci e le</para>
  <para style="q2" vid="PSA 89:32">n ta a faba le na asuɗu adama a̱ nusu le.<verse eid="PSA 89:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33" />Amma ma tawa icigi i va̱ i na i tsu vadala shi ya̱'a̱ yi shi,</para>
  <para style="q2" vid="PSA 89:33">agba ma̱a̱ kuɗa̱ o roco yi amayun a̱ va̱ shi.<verse eid="PSA 89:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34" />Maa kuɗa akucunu a̱ va̱ shi,</para>
  <para style="q2" vid="PSA 89:34">ko n vadala ili i na una̱ u va̱ u dammai shi.<verse eid="PSA 89:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35" />Uta̱ u ɗa goon n kucinai na akiza a̱ va̱,</para>
  <para style="q2" vid="PSA 89:35">agba maa yuwaan Da̱wuda epen shi.<verse eid="PSA 89:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36" />Ugundo wa̱ yi u ta̱ da̱na̱ lo hali hali,</para>
  <para style="q2" vid="PSA 89:36">waru tsugono tsa̱ yi tsa̱ ta̱ da̱na̱ lo,</para>
  <para style="q2" vid="PSA 89:36">a̱ ma̱ka̱ka̱n ma̱ va̱ nnu urana wu lo.<verse eid="PSA 89:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37" />Tsugono'o u ta̱ shuwa̱ tso woto hali hali,</para>
  <para style="q2" vid="PSA 89:37">cine woto'o u ri lyusu va amayun ɗe zuva.&gt;&gt; <char style="qs">Wivuwun</char><verse eid="PSA 89:37" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38" />Agba gogo A̱sulazuva, a̱vu ɗa nda</para>
  <para style="q2" vid="PSA 89:38">vu 'yuwan niyi a̱vu vu vari yi,</para>
  <para style="q1" vid="PSA 89:38">reve vu yuwan upan lon</para>
  <para style="q2" vid="PSA 89:38">na̱ mogono ma na vu tsuwa̱a̱n yi mani'i'in.<verse eid="PSA 89:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39" />Vu kuɗa ta̱ akucunu a na vu yuwain</para>
  <para style="q2" vid="PSA 89:39">na aagbashi a̱ wu,</para>
  <para style="q1" vid="PSA 89:39">reve vu vari ookokolo a̱ yi</para>
  <para style="q2" vid="PSA 89:39">vu lungusa̱ yi e iɗa.<verse eid="PSA 89:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40" />Vu ɓoso ta̱ kari lyuci va̱ yi suru,</para>
  <para style="q2" vid="PSA 89:40">a̱vu vu ka̱mba̱to ba̱ta̱ vu pa'atan vu ucira va̱ yi okongo.<verse eid="PSA 89:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41" />Aza a na a̱ ka̱ra̱i lo suru,</para>
  <para style="q2" vid="PSA 89:41">a̱ tsi iva̱ ta̱ itana ya̱ yi.</para>
  <para style="q1" vid="PSA 89:41">Wo o'wo ta̱ ili yi izo'oshi,</para>
  <para style="q2" vid="PSA 89:41">e ekere o nron mu nden ma̱ yi.<verse eid="PSA 89:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42" />Vu ca ta̱ n'yuwatan ma̱ yi</para>
  <para style="q2" vid="PSA 89:42">ulyuwu wa a aci,</para>
  <para style="q1" vid="PSA 89:42">vu zuwa le ta̱ suru</para>
  <para style="q2" vid="PSA 89:42">a yuwan ma̱za̱nga̱.<verse eid="PSA 89:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43" />Vu vadala ta̱ una̱ u matsun me pe'eni ma̱ yi</para>
  <para style="q2" vid="PSA 89:43">wo o'wo ili ye pere,</para>
  <para style="q2" vid="PSA 89:43">agba vu kamba yi a̱tsuma̱ o uvon shi.<verse eid="PSA 89:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44" />Vu ta̱wa̱a̱ ta̱ nu ukosu u tsugbain tsa̱ a̱ yi,</para>
  <para style="q2" vid="PSA 89:44">a̱vu vu vari tsugono tsa̱ yi e iɗa.<verse eid="PSA 89:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45" />Vu kutsato yi ta̱ go'o,</para>
  <para style="q2" vid="PSA 89:45">a̱vu vu ɓa̱ru yi na̱ wono. <char style="qs">Wivuwun</char><verse eid="PSA 89:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46" />A̱sulazuva, hali mantsa ma̱ ne ma ɗa waa tara?</para>
  <para style="q2" vid="PSA 89:46">Vu ta̱ soko aciya̱wu hali hali ɗa?</para>
  <para style="q1" vid="PSA 89:46">Hali mantsa ma̱ ne ma ɗa</para>
  <para style="q2" vid="PSA 89:46">upan wa̱ wu wa̱a̱ da̱na̱ a suɗuwusa tsa akina?<verse eid="PSA 89:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47" />Vu cuwan a na wuma u va̱ u ri alanga shi.</para>
  <para style="q2" vid="PSA 89:47">Vu yuwan ta̱ vaɗilima̱ pere ɗa?<verse eid="PSA 89:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48" />Zane ɗa a̱a̱ da̱na̱ wuma,</para>
  <para style="q2" vid="PSA 89:48">agba wa̱ kuwa̱ shi?</para>
  <para style="q1" vid="PSA 89:48">Ko u wawa wuma wa̱ yi</para>
  <para style="q2" vid="PSA 89:48">diga uba̱ta̱ wu nden wa̱ a̱kwa̱kwa̱? <char style="qs">Wivuwun</char><verse eid="PSA 89:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49" />Zagbain, te ɗa icigi yu ufaru ya̱ wu i na i tsu vadala shi,</para>
  <para style="q2" vid="PSA 89:49">za na vu kucinaa yi Da̱wuda a̱tsuma̱ a amayun a̱ wu?<verse eid="PSA 89:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50" />Zagbain, vu cuwan na̱ cine a yuwayin aagbashi a̱ wu ulamu,</para>
  <para style="q2" vid="PSA 89:50">cine n kaɓai asuvu ni izo'oshi i na nɗa suru maa yuwusaan mu.<verse eid="PSA 89:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51" />A̱sulazuva, n'yuwatan ma̱ wu</para>
  <para style="q2" vid="PSA 89:51">a ta yuwusaan mogono ma na vu tsuwa̱a̱n yi mani'in ulamu,</para>
  <para style="q2" vid="PSA 89:51">uba̱ta̱ u na u tyoi suru.<verse eid="PSA 89:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52" />Lyawa tsu cuwayi A̱sulazuva hali hali!</para>
  <para style="qc" vid="PSA 89:52">Ami! Ami!<verse eid="PSA 89:52" /></para>
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" sid="PSA 90" />
  <para style="ms">Aatagada a̱ na̱shi</para>
  <para style="mr">(<ref loc="PSA 90-106">Ica 90-106</ref>)</para>
  <para style="s">A̱sula̱ a̱ ri nu ukosu shi vaɗilima̱ gba ta̱ nu ukosu</para>
  <para style="d">Avasa a Musa vuma va̱ A̱sula̱.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1" />A̱sulazuva<note caller="+" style="f"><char style="fr" closed="false">90:1 </char><char style="fq" closed="false">A̱sulazuva </char><char style="ft" closed="false">Na̱ Tsuyahuda a yuwan ta̱ ulinga na̱ Zagbain pa nda.</char></note>, a̱vu ɗa uba̱ta̱ wu nden n tsu,</para>
  <para style="q2" vid="PSA 90:1">diga a mantsa a̱ tyo a mantsa mo ro.<verse eid="PSA 90:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2" />Kafu a yuwan nsasan,</para>
  <para style="q2" vid="PSA 90:2">kafu vu yuwan uvaɗi,</para>
  <para style="q1" vid="PSA 90:2">a̱vu ɗa A̱sula̱ a na a̱ ri</para>
  <para style="q2" vid="PSA 90:2">nu ufaru ko ukosu shi.<verse eid="PSA 90:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3" />Vu ka̱mba̱to ta̱ vaɗilima̱ ma̱buta̱,</para>
  <para style="q2" vid="PSA 90:3">a dansa, &lt;&lt;Ka̱mba̱i ma̱buta̱ a̱ɗu muwun ma ama.&gt;&gt;<verse eid="PSA 90:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4" />Adama a na a'wan ukpakukupa<note caller="-" style="x"><char style="xo" closed="false">90:4 </char><char style="xt" closed="false"><ref loc="2PE 3:8">2 Bit 3:8</ref>.</char></note> uba̱ta̱ wa̱ wu,</para>
  <para style="q2" vid="PSA 90:4">u ta̱ tsu urana uta̱ u na u ka̱ra̱i ɗe,</para>
  <para style="q2" vid="PSA 90:4">ko mantsa wa'a na ayin.<verse eid="PSA 90:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5" />Vu kototo ta̱ vaɗilima̱ babu usa̱n,</para>
  <para style="q2" vid="PSA 90:5">wuma u le u ta̱ tsa alavu,</para>
  <para style="q1" vid="PSA 90:5">waru a̱ ta̱ cine vu revei</para>
  <para style="q2" vid="PSA 90:5">anlya nu usana.<verse eid="PSA 90:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6" />Ko na wo o'woi u tsu</para>
  <para style="q2" vid="PSA 90:6">ɓoso ta̱ yipa̱lu nu usana,</para>
  <para style="q1" vid="PSA 90:6">amma nu ulivu u tsu</para>
  <para style="q2" vid="PSA 90:6">kpanla ta̱ reve u 'yewe.<verse eid="PSA 90:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7" />O kototo tsu ta̱</para>
  <para style="q2" vid="PSA 90:7">a̱tsuma̱ o upan wa̱ wu,</para>
  <para style="q1" vid="PSA 90:7">waru tsu da'wan ta̱</para>
  <para style="q2" vid="PSA 90:7">adama asuvu o usuɗu wa̱ wu.<verse eid="PSA 90:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8" />Vu gere ta̱ nusu tsu</para>
  <para style="q2" vid="PSA 90:8">a̱ ma̱ka̱ka̱n ma̱ wu,</para>
  <para style="q1" vid="PSA 90:8">nusu vu usokowu tsu</para>
  <para style="q2" vid="PSA 90:8">waru vu zuwa le ta̱ elime a̱ wu.<verse eid="PSA 90:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9" />Rana tsu suru a̱ ka̱ra̱ ta̱</para>
  <para style="q2" vid="PSA 90:9">a̱tsuma̱ o upan wa̱ wu,</para>
  <para style="q2" vid="PSA 90:9">tsu koto ta̱ a'wan a̱ tsu na̱ ma̱nga̱.<verse eid="PSA 90:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10" />A̱bunda̱ a'wan a̱ tsu</para>
  <para style="q2" vid="PSA 90:10">a̱a̱ ka̱ra̱ kupocindere shi,</para>
  <para style="q2" vid="PSA 90:10">nna̱ tsu buwa nu ucira kupakunla̱.</para>
  <para style="q1" vid="PSA 90:10">Na̱ ne suru ili i na</para>
  <para style="q2" vid="PSA 90:10">a'wan o ndolo a̱a̱ ta̱wusa̱a̱ tsu</para>
  <para style="q2" vid="PSA 90:10">a̱yi ɗa a̱tsuma̱lima̱ na̱ a̱tsumola̱ngu,</para>
  <para style="q1" vid="PSA 90:10">a̱ tsu koto ta̱ babu usa̱n,</para>
  <para style="q2" vid="PSA 90:10">waru za tsu koto ta̱.<verse eid="PSA 90:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11" />Zane ɗa aa gura reve</para>
  <para style="q2" vid="PSA 90:11">ucira wu upan wa̱ wu?</para>
  <para style="q1" vid="PSA 90:11">Zane revei cu'un va̱ a̱ba̱jini o wovon</para>
  <para style="q2" vid="PSA 90:11">u na upan wa̱ wu wa̱a̱ ta̱wa̱a̱?<verse eid="PSA 90:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12" />Vu roco tsu a na</para>
  <para style="q2" vid="PSA 90:12">rana wuma tsu wa'a a ɗa a̱ ri,</para>
  <para style="q2" vid="PSA 90:12">adama tsu da̱na̱ na̱ majiyan.<verse eid="PSA 90:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13" />A̱sulazuva, hali mantsa ma̱ ne ma ɗa va̱a̱ da̱na̱ o upan?</para>
  <para style="q2" vid="PSA 90:13">Vu vadala diga o upan wa̱ wu,</para>
  <para style="q2" vid="PSA 90:13">vee ene iliyali ya agbashi a̱ wu!<verse eid="PSA 90:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14" />Vu cuwa̱ton tsu nu usana,</para>
  <para style="q2" vid="PSA 90:14">ni icigi ya̱ wu i na i tsu vadala shi,</para>
  <para style="q1" vid="PSA 90:14">tsa̱ra̱ tsu yuwan ishipa na̱ ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 90:14">tsu yuwan mere a rana wuma tsu.<verse eid="PSA 90:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15" />Vu yo'onoto tsu okolo</para>
  <para style="q2" vid="PSA 90:15">tsa̱ a̱bunda̱ a rana na vu caa ntsu a̱tsuma̱lima̱,</para>
  <para style="q2" vid="PSA 90:15">tsa̱ a̱bunda̱ a'wan a na tse enei a̱tsuma̱lima̱.<verse eid="PSA 90:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16" />Lyawa agbashi a̱ wu ene</para>
  <para style="q2" vid="PSA 90:16">linga gbagbain va̱ wu,</para>
  <para style="q1" vid="PSA 90:16">na̱ tsugbain tsa̱ wu</para>
  <para style="q2" vid="PSA 90:16">e ekere a̱ muwun nle.<verse eid="PSA 90:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17" />Lyawa isa'ani yi Zagbain A̱sula̱ a̱ tsu</para>
  <para style="q2" vid="PSA 90:17">u da̱nu oɓolo na̱ a̱tsu.</para>
  <para style="q1" vid="PSA 90:17">Vu zuwaa linga ve ekere a̱ tsu aba'un.</para>
  <para style="q2" vid="PSA 90:17">Amayun, vu zuwaa linga ve ekere a̱ tsu aba'un.<verse eid="PSA 90:17" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" sid="PSA 91" />
  <para style="s">A̱sula̱ a ɗa mapari ma̱ tsu</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1" />Za na suru 'ya̱wa̱i uba̱ta̱</para>
  <para style="q2" vid="PSA 91:1">u Mogono ma̱ A̱sula̱ adama a mapari,</para>
  <para style="q1" vid="PSA 91:1">u ta̱ e ivuwan, za̱la̱ vu ululu</para>
  <para style="q2" vid="PSA 91:1">u Mogono me ili suru.<verse eid="PSA 91:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2" />N ta damma A̱sulazuva,</para>
  <para style="q2" vid="PSA 91:2">&lt;&lt;A̱vu ɗa upa'atan</para>
  <para style="q2" vid="PSA 91:2">nu uɓaɓu wu ucira u va̱,</para>
  <para style="q1" vid="PSA 91:2">a̱vu ɗa A̱sula̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 91:2">ya̱'a̱ wu ɗa n zuwai ucira u va̱.&gt;&gt;<verse eid="PSA 91:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3" />Amayun u ta wawa wu,</para>
  <para style="q2" vid="PSA 91:3">diga a maza ma za vu ugenge,</para>
  <para style="q2" vid="PSA 91:3">na̱ mɓa̱la̱ nna ma̱a̱ ta̱wa̱a̱ wu nu ukwisa̱.<verse eid="PSA 91:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4" />U ta pala wu ne evelu a̱yi,</para>
  <para style="q2" vid="PSA 91:4">za̱la̱ va̱ e evelu a̱yi waru,</para>
  <para style="q2" vid="PSA 91:4">vu ta̱ tsura̱ upa'atan.</para>
  <para style="q1" vid="PSA 91:4">Waru amayun a̱ yi</para>
  <para style="q2" vid="PSA 91:4">a̱ tu uka̱nda̱ruwu na̱ vu,</para>
  <para style="q2" vid="PSA 91:4">a yuwusan wu mapari.<verse eid="PSA 91:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5" />Vaa uwwa wovon wi ili i wovon i na</para>
  <para style="q2" vid="PSA 91:5">i tsu ta̱wa̱ na ayin shi,</para>
  <para style="q2" vid="PSA 91:5">ko aya a na a tsu tewin nu urana shi,<verse eid="PSA 91:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6" />ko mɓa̱la̱ n na ntsu da̱na̱</para>
  <para style="q2" vid="PSA 91:6">aa agara a̱tsuma̱ e irumbu,</para>
  <para style="q1" vid="PSA 91:6">ko meleshe ma na ma̱ tsu ta̱wa̱</para>
  <para style="q2" vid="PSA 91:6">nu ukototosu nu urana shi.<verse eid="PSA 91:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7" />Amma ko na̱ shi ama ukpakukupa</para>
  <para style="q2" vid="PSA 91:7">a̱ riya̱ upasu wa̱ wu,</para>
  <para style="q1" vid="PSA 91:7">ama ukpakukupa kupa</para>
  <para style="q2" vid="PSA 91:7">a̱ riya̱ o ukere u sa'ani wa̱ wu,</para>
  <para style="q2" vid="PSA 91:7">babu ili i na yaa rawa zuzu na̱ a̱vu.<verse eid="PSA 91:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8" />Amma ne esu a̱ wu a ɗa vee ene,</para>
  <para style="q2" vid="PSA 91:8">cine aa ca a̱za̱ e iwuya oforo.<verse eid="PSA 91:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9" />Adama a na vo o'wotoi ka̱mba̱toi,</para>
  <para style="q2" vid="PSA 91:9">Mogono ma̱ A̱sula̱ uba̱ta̱ wu nden ma̱ wu,</para>
  <para style="q2" vid="PSA 91:9">A̱sulazuva waru upa'atan wa̱ wu,<verse eid="PSA 91:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10" />babu iwuya i na yaa cina wu,</para>
  <para style="q2" vid="PSA 91:10">ko mɓa̱la̱ n ro n na maa rawa</para>
  <para style="q2" vid="PSA 91:10">zuzu no oogodo a̱ wu.<verse eid="PSA 91:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11" />Adama a na u ta damma</para>
  <para style="q2" vid="PSA 91:11">nlingata ma̱ A̱sula̱ adama a̱ wu,<note caller="-" style="x"><char style="xo" closed="false">91:11 </char><char style="xt" closed="false"><ref loc="MAT 4:6">Mat 4:6</ref>; <ref loc="LUK 4:10">Luk 4:10</ref>.</char></note></para>
  <para style="q1" vid="PSA 91:11">a yuwaan wu mapari</para>
  <para style="q2" vid="PSA 91:11">e re va̱ wu suru.<verse eid="PSA 91:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12" />E te keɗe wu e ekere e le,<note caller="-" style="x"><char style="xo" closed="false">91:12 </char><char style="xt" closed="false"><ref loc="MAT 4:6">Mat 4:6</ref>; <ref loc="LUK 4:11">Luk 4:11</ref>.</char></note></para>
  <para style="q2" vid="PSA 91:12">adama she vu ta̱ɗa̱tsa̱</para>
  <para style="q2" vid="PSA 91:12">anana a̱ wu a aatali wan.<verse eid="PSA 91:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13" />Vu ta dasa ikamu ni iyo,<note caller="-" style="x"><char style="xo" closed="false">91:13 </char><char style="xt" closed="false"><ref loc="LUK 10:19">Luk 10:19</ref>.</char></note></para>
  <para style="q2" vid="PSA 91:13">vu ta dasa ikamu yu ucira,</para>
  <para style="q2" vid="PSA 91:13">ni iyo i tsukono.<verse eid="PSA 91:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14" />A̱sula̱ a damma ta̱,</para>
  <para style="q2" vid="PSA 91:14">&lt;&lt;Adama a na u ri e icigi i va̱,</para>
  <para style="q2" vid="PSA 91:14">n ta wawa yi,</para>
  <para style="q1" vid="PSA 91:14">n ta yuwaan yi mapari,</para>
  <para style="q2" vid="PSA 91:14">adama a na u reve numu.<verse eid="PSA 91:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15" />U ta̱ ɗe mu,</para>
  <para style="q2" vid="PSA 91:15">agba n ta̱ usu yi,</para>
  <para style="q1" vid="PSA 91:15">n ta̱ da̱na̱ oɓolo na̱ a̱yi</para>
  <para style="q2" vid="PSA 91:15">a mantsa ma̱ a̱tsuma̱lima̱,</para>
  <para style="q2" vid="PSA 91:15">n wawa yi, a̱vu n ca yi tsugbain.<verse eid="PSA 91:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16" />N ta ca yi wuma u sa'ani</para>
  <para style="q2" vid="PSA 91:16">u na waa jima,</para>
  <para style="q2" vid="PSA 91:16">a̱vu n roco yi iwawi i va̱.&gt;&gt;<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" sid="PSA 92" />
  <para style="s">Ishipa yu ugodyusho</para>
  <para style="d">Ica. Ishipa adama o urana wa Ashibi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1" />U tu ulobonu o godyoo A̱sulazuva,</para>
  <para style="q2" vid="PSA 92:1">a canaa ala a̱ wu ica,</para>
  <para style="q2" vid="PSA 92:1">Mogono ma̱ A̱sula̱.<verse eid="PSA 92:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2" />A ca ucuɗuwu,</para>
  <para style="q2" vid="PSA 92:2">wi icigi ya̱ wu nu usana,</para>
  <para style="q2" vid="PSA 92:2">na amayun a̱ wu na ayin,<verse eid="PSA 92:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3" />na̱ malapa me igaraya va a'yin kupa</para>
  <para style="q2" vid="PSA 92:3">nu uɗyo wu uyo'o wu kumburu.<verse eid="PSA 92:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4" />A̱sulazuva, linga va̱ wu va asalama,</para>
  <para style="q2" vid="PSA 92:4">a zuwa mu ta̱ ma̱za̱nga̱.</para>
  <para style="q1" vid="PSA 92:4">N cana ta̱ ishipa i ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 92:4">adama a linga ve ekere a̱ wu.<verse eid="PSA 92:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5" />A̱sulazuva, linga va̱ wu a̱ ta̱ gbagbain,</para>
  <para style="q2" vid="PSA 92:5">majiyan ma̱ wu ma̱ ta̱ a̱ru'un lon!<verse eid="PSA 92:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6" />Ulo waa gura reve ili shi.</para>
  <para style="q2" vid="PSA 92:6">A̱ta̱mu waru a gura reve</para>
  <para style="q2" vid="PSA 92:6">ili i nda shi,<verse eid="PSA 92:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7" />ko na wo o'woi a̱za̱ e iwuya</para>
  <para style="q2" vid="PSA 92:7">a ta balasa tsa anlya,</para>
  <para style="q1" vid="PSA 92:7">aza mayan me iwuya waru</para>
  <para style="q2" vid="PSA 92:7">aa lyuwusa elime,</para>
  <para style="q2" vid="PSA 92:7">na̱ ne suru o to kototo le hali hali.<verse eid="PSA 92:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8" />Amma a̱vu A̱sulazuva,</para>
  <para style="q2" vid="PSA 92:8">a̱vu ɗa za na a yuwusan</para>
  <para style="q2" vid="PSA 92:8">tsugbain hali hali.<verse eid="PSA 92:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9" />A̱sulazuva, ka̱lyuwa̱ n'yuwatan ma̱ wu</para>
  <para style="q2" vid="PSA 92:9">na amayun n'yuwatan ma̱ wu n ta̱ kuwa̱,</para>
  <para style="q2" vid="PSA 92:9">a̱za̱ e iwuya suru a̱ ta̱ bete'we.<verse eid="PSA 92:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10" />Amma vu ca mu ta̱ ucira tsa yacin,</para>
  <para style="q2" vid="PSA 92:10">vu zuwaa mu ta̱ aba'un na̱ ma̱za̱nga̱.<verse eid="PSA 92:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11" />Esu a̱ va̱ e ene ta̱</para>
  <para style="q2" vid="PSA 92:11">ukototosu wu n'yuwatan n va̱,</para>
  <para style="q1" vid="PSA 92:11">atsuvu a̱ va̱ a uwwa ta̱</para>
  <para style="q2" vid="PSA 92:11">yisaali yu ukototosu u le.<verse eid="PSA 92:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12" />A̱za̱ a̱ a̱ɓula̱ a ta bala,</para>
  <para style="q2" vid="PSA 92:12">tsu uɗanga wu ushuwa,</para>
  <para style="q1" vid="PSA 92:12">a ta yuwan mgbain,</para>
  <para style="q2" vid="PSA 92:12">tsu uɗanga u sida wa Lebanon,<verse eid="PSA 92:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13" />na a̱ shuwa̱i o u'wa wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 92:13">a ta bala o ukowo wa̱ A̱sula̱ a̱ tsu.<verse eid="PSA 92:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14" />Na̱ tsukutsa tsa̱ le</para>
  <para style="q2" vid="PSA 92:14">a̱a̱ ta̱ da̱na̱ a mamatsan,</para>
  <para style="q2" vid="PSA 92:14">a̱a̱ ta̱ da̱na̱ uta̱nu kuci.<verse eid="PSA 92:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15" />Nda roco ta̱ A̱sulazuva za va̱ a̱ɓula̱ a ɗa,</para>
  <para style="q2" vid="PSA 92:15">a̱yi ɗa aatali a̱ va̱,</para>
  <para style="q2" vid="PSA 92:15">babu iwuya a̱tsuma̱ a̱ yi.<verse eid="PSA 92:15" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" sid="PSA 93" />
  <para style="s">A̱sula̱ Mogono ma ɗa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1" />A̱sulazuva Mogono ma ɗa!</para>
  <para style="q2" vid="PSA 93:1">U ta̱ wotowu na̱ tsugbain,</para>
  <para style="q2" vid="PSA 93:1">A̱sulazuva a̱ tu wotowu na̱ tsugbain,</para>
  <para style="q2" vid="PSA 93:1">u tu wotowu nu ucira.</para>
  <para style="q1" vid="PSA 93:1">Amayun, u shuwa̱ ta̱ uvaɗi,<note caller="-" style="x"><char style="xo" closed="false">93:1 </char><char style="xt" closed="false"><ref loc="PSA 96:10">Ica 96:10</ref>.</char></note></para>
  <para style="q2" vid="PSA 93:1">waru wa̱ jinga̱ɗa̱ shi.<verse eid="PSA 93:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2" />Ootogu o tsugono tsa̱ wu</para>
  <para style="q2" vid="PSA 93:2">a̱ tu ushuwu ɗe nu ujumu,</para>
  <para style="q2" vid="PSA 93:2">kafu a yuwan ili suru vu ta̱ lo.<verse eid="PSA 93:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3" />A̱sulazuva, ikeɗu i mala i 'yon ta̱,</para>
  <para style="q2" vid="PSA 93:3">ikeɗu i mala i 'ya̱sa̱n ta̱ ɗyo le,</para>
  <para style="q2" vid="PSA 93:3">a̱ 'ya̱sa̱n ta̱ ɗyo le a̱ ma̱gugwa̱.<verse eid="PSA 93:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4" />A̱sulazuva a ta tsugbain ɗe zuva,</para>
  <para style="q2" vid="PSA 93:4">tsugbain tsa̱ yi tsa̱ ta̱ nu ucira</para>
  <para style="q1" vid="PSA 93:4">u na u la'ai ma̱gugwa̱ ma̱ mini ma mala,</para>
  <para style="q2" vid="PSA 93:4">ucira wa̱ yi u la'a ta̱ ikeɗu i mini i mala.<verse eid="PSA 93:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5" />A̱sulazuva, wila̱ wa̱ wu amayun a ɗa,</para>
  <para style="q2" vid="PSA 93:5">waru u'wa wa̱ wu akiza a ɗa</para>
  <para style="q2" vid="PSA 93:5">hali hali.<verse eid="PSA 93:5" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" sid="PSA 94" />
  <para style="s">Avasa e izami ya atsupu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1" />A̱sulazuva, a̱vu ɗa A̱sula̱</para>
  <para style="q2" vid="PSA 94:1">a na a tsu ca oforo,</para>
  <para style="q2" vid="PSA 94:1">vu roco upan wa̱ wu.<verse eid="PSA 94:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2" />'Yon, a̱vu za na vee ge'eto uvaɗi,</para>
  <para style="q2" vid="PSA 94:2">vu tsupaa aza a na a yuwusan aciyogbamu,</para>
  <para style="q2" vid="PSA 94:2">ili i na yi ntsaayi!<verse eid="PSA 94:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3" />A̱sulazuva, hali mantsa ma ne ma ɗa?</para>
  <para style="q2" vid="PSA 94:3">Hali mantsa ma ne ɗa,</para>
  <para style="q2" vid="PSA 94:3">a̱za̱ e iwuya a̱a̱ da̱na̱ a̱ ma̱za̱nga̱?<verse eid="PSA 94:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4" />Hali mantsa ma ne a̱a̱ da̱na̱</para>
  <para style="q2" vid="PSA 94:4">a yuwusan adanshi a afalu,</para>
  <para style="q1" vid="PSA 94:4">a lapusa ma̱ka̱ka̱n suru</para>
  <para style="q2" vid="PSA 94:4">adama mayan me iwuya?<verse eid="PSA 94:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5" />A̱sulazuva, a̱ ta̱ rukutsusa̱ ama a̱ wu,</para>
  <para style="q2" vid="PSA 94:5">o to ɓongishi ama a agadu a̱ wu.<verse eid="PSA 94:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6" />A̱ ta̱ o unusa nruna̱ no omocin,</para>
  <para style="q2" vid="PSA 94:6">waru o unusa mkpa'an.<verse eid="PSA 94:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7" />Ata dansa,</para>
  <para style="q2" vid="PSA 94:7">&lt;&lt;A̱sulazuva e eneshe tsu shi,</para>
  <para style="q2" vid="PSA 94:7">A̱sula̱ a Yakubu u dama shi.&gt;&gt;<verse eid="PSA 94:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8" />I ka̱mbuwa̱ ugbozu,</para>
  <para style="q2" vid="PSA 94:8">a̱ɗu a̱za̱ o ulambu</para>
  <para style="q2" vid="PSA 94:8">u majiyan a̱tsuma̱ a ama,</para>
  <para style="q1" vid="PSA 94:8">a̱ɗu olo, mantsa ma̱ ne ma ɗa</para>
  <para style="q2" vid="PSA 94:8">yaa yuwan ugbozu?<verse eid="PSA 94:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9" />A̱yi na u yuwain atsuvu,</para>
  <para style="q2" vid="PSA 94:9">waa uwwusa shi?</para>
  <para style="q1" vid="PSA 94:9">A̱yi na u yuwain esu</para>
  <para style="q2" vid="PSA 94:9">we eneshe shi?<verse eid="PSA 94:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10" />Za na tsu ɓara nɗa,</para>
  <para style="q2" vid="PSA 94:10">waa ca oforo shi?</para>
  <para style="q1" vid="PSA 94:10">Za na tsu rito vuma,</para>
  <para style="q2" vid="PSA 94:10">u ri nu urevu shi?<verse eid="PSA 94:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11" />A̱sulazuva e reve ta̱ majiyan ma vuma,<note caller="-" style="x"><char style="xo" closed="false">94:11 </char><char style="xt" closed="false"><ref loc="1CO 3:20">1 Kor 3:20</ref>.</char></note></para>
  <para style="q2" vid="PSA 94:11">u reve ta̱ a na majiyan me le pere ɗa.<verse eid="PSA 94:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12" />A̱sulazuva, za ma̱za̱nga̱ ɗa,</para>
  <para style="q2" vid="PSA 94:12">za na vu ronoi atsuvu,</para>
  <para style="q1" vid="PSA 94:12">vuma na vu ritoyi diga,</para>
  <para style="q2" vid="PSA 94:12">a̱ wila̱ wa̱ wu,<verse eid="PSA 94:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13" />za na vu ca yi wivuwun,</para>
  <para style="q2" vid="PSA 94:13">a rana va̱ a̱tsuma̱lima̱.</para>
  <para style="q1" vid="PSA 94:13">Hali urana u na a̱a̱ ka̱pa̱a̱</para>
  <para style="q2" vid="PSA 94:13">a̱za̱ e iwuya aason.<verse eid="PSA 94:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14" />Adama a na A̱sulazuva,</para>
  <para style="q2" vid="PSA 94:14">aa vari ama a̱yi shi,</para>
  <para style="q2" vid="PSA 94:14">waa 'yuwan agadu a̱ yi shi.<verse eid="PSA 94:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15" />Amayun a̱ ta̱ ka̱mba̱</para>
  <para style="q2" vid="PSA 94:15">uba̱ta̱ wa̱ a̱za̱ o uge'etosu,</para>
  <para style="q1" vid="PSA 94:15">aza a amayun o okolo</para>
  <para style="q2" vid="PSA 94:15">a ta yuwan ma̱za̱nga̱.<verse eid="PSA 94:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16" />Zane ɗa a̱ 'yon wi isawaan mu,</para>
  <para style="q2" vid="PSA 94:16">e ekere aza a iwuya?</para>
  <para style="q1" vid="PSA 94:16">Zane ɗa e isawaan mu,</para>
  <para style="q2" vid="PSA 94:16">a aci aza na a yuwusan iwuya?<verse eid="PSA 94:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17" />Na̱ shi A̱sulazuva a ɗa</para>
  <para style="q2" vid="PSA 94:17">a̱ da̱na̱i ikambishi i va̱ shi,</para>
  <para style="q1" vid="PSA 94:17">wuma u va̱ u shi ta̱ a̱ ka̱ra̱</para>
  <para style="q2" vid="PSA 94:17">a̱ tyo uba̱ta̱ wa̱ a̱kwa̱kwa̱.<verse eid="PSA 94:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18" />A̱sulazuva, ana n dammai,</para>
  <para style="q2" vid="PSA 94:18">&lt;&lt;Ana a̱ va̱ a̱ ta̱ dereceshe,&gt;&gt;</para>
  <para style="q1" vid="PSA 94:18">icigi ya̱ wu i na i tsu vadala shi</para>
  <para style="q2" vid="PSA 94:18">i guza̱ mu ta̱.<verse eid="PSA 94:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19" />Ana majiyan ma yuwan numu a̱bunda̱,</para>
  <para style="q2" vid="PSA 94:19">ucawu wa adanshi a̱ wu,</para>
  <para style="q2" vid="PSA 94:19">a ca mu ta̱ asuvu nden.<verse eid="PSA 94:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20" />Vu ta gura ɓolo aci na̱ azagbain e iwuya,</para>
  <para style="q2" vid="PSA 94:20">aza a na a̱ ka̱mbuwa̱i ulambu wa amayun</para>
  <para style="q2" vid="PSA 94:20">wo oꞌwo amayun e le?<verse eid="PSA 94:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21" />A̱ tso ɓoloo ta̱</para>
  <para style="q2" vid="PSA 94:21">a̱za̱ a̱ a̱ɓula̱ aci,</para>
  <para style="q1" vid="PSA 94:21">a̱vu a paɗaa aza a babu unusu</para>
  <para style="q2" vid="PSA 94:21">ugana wu ukwisa̱.<verse eid="PSA 94:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22" />Amma A̱sulazuva a ɗa</para>
  <para style="q2" vid="PSA 94:22">upa'atan wu ucira u va̱,</para>
  <para style="q1" vid="PSA 94:22">A̱sula̱ a̱ va̱ a̱ yi ɗa</para>
  <para style="q2" vid="PSA 94:22">aatali o upa'atan u va̱.<verse eid="PSA 94:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23" />U ta̱ ge'eto le</para>
  <para style="q2" vid="PSA 94:23">adama a̱ nusu le,</para>
  <para style="q1" vid="PSA 94:23">reve u kototo le</para>
  <para style="q2" vid="PSA 94:23">adama e iwuya i le,</para>
  <para style="q2" vid="PSA 94:23">A̱sulazuva, A̱sula̱ a̱ tsu o to kototo le.<verse eid="PSA 94:23" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" sid="PSA 95" />
  <para style="s">Ishipa yi ica na̱ A̱ga̱nda̱</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1" />Ta̱wa̱i tsu canayi ishipa i ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 95:1">a̱ tyo uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q1" vid="PSA 95:1">lyawa tsu yuwain yisaali i ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 95:1">a̱ tyo a Aatali e iwawi i tsu.<verse eid="PSA 95:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2" />Lyawa tsu ta̱wa̱i a̱ ma̱ka̱ka̱n ma̱ yi</para>
  <para style="q2" vid="PSA 95:2">nu ugodyusho,</para>
  <para style="q1" vid="PSA 95:2">tsu yuwain ishipa i ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 95:2">ni ishipa yi ica uba̱ta̱ wa̱ yi!<verse eid="PSA 95:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3" />Adama a na A̱sulazuva, A̱sula̱ a gbain a ɗa,</para>
  <para style="q2" vid="PSA 95:3">Mogono ma gbain ma na ma la'ai musula̱ suru.<verse eid="PSA 95:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4" />Ncilecile yi nsasan a̱za̱ a̱ yi a ɗa</para>
  <para style="q2" vid="PSA 95:4">waru za̱la̱ vu uvaɗi suru u ta̱ e ekere a̱ yi.<verse eid="PSA 95:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5" />Mala za va̱ yi ɗa,</para>
  <para style="q2" vid="PSA 95:5">a̱yi ɗa u yuwan niyi,</para>
  <para style="q1" vid="PSA 95:5">waru ekere a̱ yi a ɗa</para>
  <para style="q2" vid="PSA 95:5">a yuwain iɗa yu u'yewu.<verse eid="PSA 95:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6" />Ta̱wa̱i, tsu ka̱ɗa̱toi</para>
  <para style="q2" vid="PSA 95:6">tsu yuwaan niyi a̱ga̱nda̱,</para>
  <para style="q1" vid="PSA 95:6">lyawa tsu kingyoyi,</para>
  <para style="q2" vid="PSA 95:6">a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva</para>
  <para style="q2" vid="PSA 95:6">za na yuwan ntsu!<verse eid="PSA 95:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7" />Adama a na a̱yi ɗa A̱sula̱ a̱ tsu,</para>
  <para style="q2" vid="PSA 95:7">a̱tsu waru ama a na waa guɓusa ɗa,</para>
  <para style="q1" vid="PSA 95:7">oɓolo e ikyon i na wa̱a̱</para>
  <para style="q2" vid="PSA 95:7">ka̱lyuwusa̱ na aciya̱yi.</para>
  <para style="b" vid="PSA 95:7" />
  <para style="q1" vid="PSA 95:7">Ana'an na̱ yu uwwa uɗyo wa̱ yi,<note caller="-" style="x"><char style="xo" closed="false">95:7 </char><char style="xt" closed="false"><ref loc="HEB 3:15">M.Ib 3:15</ref>; <ref loc="HEB 4:7">4:7</ref>.</char></note><note caller="-" style="x"><char style="xo" closed="false">95:7-11 </char><char style="xt" closed="false"><ref loc="HEB 3:7-11">M.Ib 3:7-11</ref>.</char></note><verse eid="PSA 95:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 95:8" />she i yuwan okolo o ugbamu,<note caller="-" style="x"><char style="xo" closed="false">95:8 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">Mta̱ 17:1-7</ref>; <ref loc="NUM 20:2-13">Mkc 20:2-13</ref>.</char></note></para>
  <para style="q2" vid="PSA 95:8">cine nkaya nɗu n yuwain ɗe Meriba<note caller="+" style="f"><char style="fr" closed="false">95:8 </char><char style="fq" closed="false">Meriba </char><char style="ft" closed="false">Urevu wu danshi nda a̱ yi ɗa nwasanlai. </char></note> wan,</para>
  <para style="q1" vid="PSA 95:8">na̱ cine a yuwain,</para>
  <para style="q2" vid="PSA 95:8">o urana u ndolo a Masa<note caller="+" style="f"><char style="fr" closed="false">95:8 </char><char style="fq" closed="false">Masa </char><char style="ft" closed="false">Urevu wu danshi nda a̱ yi ɗa ulyungusa̱.</char></note> a̱tsumona wan,<verse eid="PSA 95:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9" />uba̱ta̱ u na nkaya nɗu</para>
  <para style="q2" vid="PSA 95:9">n lyungwa̱ numu,</para>
  <para style="q1" vid="PSA 95:9">ko na wo o'woi ene ta̱</para>
  <para style="q2" vid="PSA 95:9">ili i na n yuwain esu e le.<verse eid="PSA 95:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10" />A'wan amunga o ndolo,</para>
  <para style="q2" vid="PSA 95:10">n da̱na̱ ta̱ o upan na ama'a.</para>
  <para style="q1" vid="PSA 95:10">Reve n damma,</para>
  <para style="q2" vid="PSA 95:10">&lt;&lt;Ama a nda a̱za̱ o ulambu u tsutoni a ɗa,</para>
  <para style="q1" vid="PSA 95:10">adama a na a 'yuwan ta̱</para>
  <para style="q2" vid="PSA 95:10">a yuwan tsutoni nu udammu u va̱!&gt;&gt;<verse eid="PSA 95:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11" />N kucina ta̱,</para>
  <para style="q2" vid="PSA 95:11">a̱tsuma̱ o upan u va̱ n damma,<note caller="-" style="x"><char style="xo" closed="false">95:11 </char><char style="xt" closed="false"><ref loc="NUM 14:20-23">Mkc 14:20-23</ref>; <ref loc="DEU 1:34-36">U.Wl 1:34-36</ref>; <ref loc="DEU 12:9-10">12:9-10</ref>; <ref loc="HEB 4:3-5">M.Ib 4:3-5</ref>.</char></note></para>
  <para style="q2" vid="PSA 95:11">&lt;&lt;A uwa a wivuwun u va̱ shi!&gt;&gt;<verse eid="PSA 95:11" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" sid="PSA 96" />
  <para style="s">A̱sula̱ Mogono ma gbain</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1" />Canaa yi A̱sulazuva ishipa i sa'avu,</para>
  <para style="q2" vid="PSA 96:1">canaa yi A̱sulazuva ishipa,</para>
  <para style="q2" vid="PSA 96:1">a̱ɗu uvaɗi ma̱ɓula̱!<verse eid="PSA 96:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2" />Canai ishipa uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 96:2">i cuwa ala a̱ yi!</para>
  <para style="q1" vid="PSA 96:2">Urana suru i damma alabari</para>
  <para style="q2" vid="PSA 96:2">e iwawi ya̱ yi.<verse eid="PSA 96:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3" />Dammai tsugbain tsa̱ yi</para>
  <para style="q2" vid="PSA 96:3">a̱tsuma̱ a nɗa,</para>
  <para style="q1" vid="PSA 96:3">na̱ linga va asalama va̱ yi</para>
  <para style="q2" vid="PSA 96:3">uba̱ta̱ wa ama suru.<verse eid="PSA 96:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4" />Adama a na A̱sulazuva zagbain ɗa,</para>
  <para style="q2" vid="PSA 96:4">wu ntsaa ta̱ a ca yi tsugbain lon,</para>
  <para style="q1" vid="PSA 96:4">waru u rawa ta̱ a uwwa wovon wa̱ yi,</para>
  <para style="q2" vid="PSA 96:4">ula'awu na̱ musula̱ suru.<verse eid="PSA 96:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5" />Adama a na musula̱ mu nɗa suru a̱ma̱li a ɗa,</para>
  <para style="q2" vid="PSA 96:5">amma A̱sulazuva a ɗa a yuwain zuva.<verse eid="PSA 96:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6" />Tsugbain na̱ a̱ɓula̱,</para>
  <para style="q2" vid="PSA 96:6">a̱ tu uka̱nda̱ruwu na̱ a̱yi,</para>
  <para style="q1" vid="PSA 96:6">ucira na̱ tsugbain,</para>
  <para style="q2" vid="PSA 96:6">a̱ ta̱ a̱ a̱a̱'isa̱ a̱ yi.<verse eid="PSA 96:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7" />I cuwa A̱sulazuva,</para>
  <para style="q2" vid="PSA 96:7">a̱ɗu a ama o uvaɗi.<note caller="-" style="x"><char style="xo" closed="false">96:7 </char><char style="xt" closed="false"><ref loc="PSA 29:1-2">Ica 29:1-2</ref>.</char></note></para>
  <para style="q1" vid="PSA 96:7">I cuwa tsugbain tsa̱ yi</para>
  <para style="q2" vid="PSA 96:7">nu ucira wa̱ yi!<verse eid="PSA 96:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8" />I cuwa tsugbain tsa ala a̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 96:8">a̱vu i uwa o ukowo wa̱ a̱a̱'isa̱ a̱ yi,</para>
  <para style="q2" vid="PSA 96:8">nu une'e u na i ta̱wa̱a̱ yi.<verse eid="PSA 96:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9" />I kingyo elime a̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 96:9">adama a tsugbain tsa akiza a̱ yi.</para>
  <para style="q1" vid="PSA 96:9">I je'en lipu a̱ ma̱ka̱ka̱n ma̱ yi,</para>
  <para style="q2" vid="PSA 96:9">a̱ɗu uvaɗi ma̱ɓula̱!<verse eid="PSA 96:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10" />I damma nɗa suru,</para>
  <para style="q2" vid="PSA 96:10">&lt;&lt;A̱sulazuva Mogono ma ɗa!&gt;&gt;</para>
  <para style="q1" vid="PSA 96:10">U shuwa̱ ta̱ uvaɗi,</para>
  <para style="q2" vid="PSA 96:10">waru wa̱ jinga̱ɗa̱ shi.</para>
  <para style="q1" vid="PSA 96:10">U ta yuwaan ama</para>
  <para style="q2" vid="PSA 96:10">uge'etosu wa̱ a̱ɓula̱.<verse eid="PSA 96:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11" />Lyawa zuva yuwan ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 96:11">lyawa uvaɗi u yuwan mere,</para>
  <para style="q1" vid="PSA 96:11">lyawa mala ma yuwan</para>
  <para style="q2" vid="PSA 96:11">ma̱gugwa̱ ma̱ ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 96:11">ni ili i na i ri pe a̱tsuma̱ a̱yi suru.<verse eid="PSA 96:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12" />Lyawa atsusa suru</para>
  <para style="q2" vid="PSA 96:12">a yuwan ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 96:12">oɓolo ni ili i na i ri pe a̱tsuma̱ a̱yi suru!</para>
  <para style="q1" vid="PSA 96:12">A̱vu fo ɗanga va̱ a̱rumbu suru,</para>
  <para style="q2" vid="PSA 96:12">a cana ishipa i ma̱za̱nga̱,<verse eid="PSA 96:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 96:13" />a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva!</para>
  <para style="q1" vid="PSA 96:13">Adama a na u ta̱ lo a̱ ta̱wa̱,</para>
  <para style="q2" vid="PSA 96:13">u ta̱ lo a̱ ta̱wa̱ u ge'eto uvaɗi.</para>
  <para style="q1" vid="PSA 96:13">U ta̱ ge'eto ama o uvaɗi suru,</para>
  <para style="q2" vid="PSA 96:13">na amayun na̱ a̱ɓula̱.<verse eid="PSA 96:13" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" sid="PSA 97" />
  <para style="s">A̱sulazuva Mogono me ili suru</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1" />A̱sulazuva Mogono ma ɗa!</para>
  <para style="q2" vid="PSA 97:1">Lyawa uvaɗi u yuwan ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 97:1">lyawa nɗa m memere ma mala fo n za̱nga̱na̱.<verse eid="PSA 97:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2" />Eleshe ni irumbu pici,</para>
  <para style="q2" vid="PSA 97:2">a palai ta̱,</para>
  <para style="q1" vid="PSA 97:2">a̱ɓula̱ nu uge'etosu wa amayun,</para>
  <para style="q2" vid="PSA 97:2">a ɗa ikyun i tsugono tsa̱ yi.<verse eid="PSA 97:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3" />Akina a̱ ta̱ elime a̱ yi,</para>
  <para style="q2" vid="PSA 97:3">a̱ kula̱tosu n'yuwatan ma̱ yi,</para>
  <para style="q2" vid="PSA 97:3">nna n ri uka̱nda̱ruwu na̱ a̱yi.<verse eid="PSA 97:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4" />Imaɗatsu ya̱ yi, i ta̱ e ikanasa uvaɗi,</para>
  <para style="q2" vid="PSA 97:4">uvaɗi we ene ta̱ reve u jinga̱ɗa̱.<verse eid="PSA 97:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5" />Nsasan mu jeruwe ta̱,</para>
  <para style="q2" vid="PSA 97:5">tsa abaji e ishiki,</para>
  <para style="q1" vid="PSA 97:5">a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 97:5">a̱ ma̱ka̱ka̱n ma Zagbain vu uvaɗi suru.<verse eid="PSA 97:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6" />Zuva ta adanshi a̱ a̱ɓula̱ a̱ yi,</para>
  <para style="q2" vid="PSA 97:6">nɗa suru me ene ta̱ tsugbain tsa̱ yi.<verse eid="PSA 97:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7" />Aza a na aa yuwusaan ruma a̱ga̱nda̱ suru</para>
  <para style="q2" vid="PSA 97:7">a uwwa ta̱ wono,</para>
  <para style="q1" vid="PSA 97:7">ne ɗa fo aza a na a yuwusan uvaɗu na̱ a̱ma̱li.</para>
  <para style="q2" vid="PSA 97:7">Musula̱ suru a̱ ta̱ kingyo a̱ ma̱ka̱ka̱n ma̱ yi.<verse eid="PSA 97:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8" />A̱sulazuva, ama a Sihiyona a uwwa ta̱,</para>
  <para style="q2" vid="PSA 97:8">reve a yuwan ma̱za̱nga̱,</para>
  <para style="q1" vid="PSA 97:8">reve mulyuci ma Yahuda,</para>
  <para style="q2" vid="PSA 97:8">n yuwan mere,</para>
  <para style="q2" vid="PSA 97:8">adama o uge'etosu wa amayun a̱ wu.<verse eid="PSA 97:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9" />A̱vu A̱sulazuva,</para>
  <para style="q2" vid="PSA 97:9">a̱vu ɗa vu la'ai tsugbain a̱tsuma̱ o uvaɗi suru,</para>
  <para style="q2" vid="PSA 97:9">vu la'a ta̱ musula̱ suru tsugbain.<verse eid="PSA 97:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10" />Lyawa aza a na a cigai A̱sulazuva</para>
  <para style="q2" vid="PSA 97:10">a 'yuwan iwuya.</para>
  <para style="q1" vid="PSA 97:10">U tsu yuwan ta̱ mapari</para>
  <para style="q2" vid="PSA 97:10">uba̱ta̱ waa ama a̱ a̱ɓula̱ a̱ yi,</para>
  <para style="q2" vid="PSA 97:10">a̱vu u wawa le e ekere a̱za̱ e iwuya.<verse eid="PSA 97:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11" />Ekan a̱ ta̱ e ikanasa a̱za̱ a̱ a̱ɓula̱,</para>
  <para style="q2" vid="PSA 97:11">ma̱za̱nga̱ waru, uba̱ta̱ wa aza a amayun o okolo.<verse eid="PSA 97:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12" />I yuwan ma̱za̱nga̱ a̱ɗu a̱za̱ a̱ɓula̱,</para>
  <para style="q2" vid="PSA 97:12">adama e ili i na A̱sulazuva a yuwain!</para>
  <para style="q1" vid="PSA 97:12">I cuwan ili i na za va a Akiza a yuwain,</para>
  <para style="q2" vid="PSA 97:12">a̱vu i godyoo yi.<verse eid="PSA 97:12" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" sid="PSA 98" />
  <para style="s">A̱sula̱ o tsugono tsu uvaɗi</para>
  <para style="d">Ica.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1" />Canayi A̱sulazuva ishipa i sa'avu,</para>
  <para style="q2" vid="PSA 98:1">adama a na u yuwan ta̱ linga va asalama!</para>
  <para style="q1" vid="PSA 98:1">Ucira wu ukere wa̱ yi,</para>
  <para style="q2" vid="PSA 98:1">nu ucira wu ukere wa akiza a̱ yi,</para>
  <para style="q2" vid="PSA 98:1">u tsura̱ ta̱ ulyuwu wa aci.<verse eid="PSA 98:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2" />A̱sulazuva a lyawa ta̱ e reve</para>
  <para style="q2" vid="PSA 98:2">ni iwawi ya̱ yi,</para>
  <para style="q2" vid="PSA 98:2">reve u roco a̱ɓula̱ a̱ yi esu a nɗa.<verse eid="PSA 98:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3" />U cuwan ta̱ ni icigi ya̱ yi</para>
  <para style="q2" vid="PSA 98:3">i na i tsu vadala shi,</para>
  <para style="q1" vid="PSA 98:3">na̱ a̱ɓula̱ a̱ yi</para>
  <para style="q2" vid="PSA 98:3">a̱ tyo uba̱ta̱ wa ama a Isra'ila.</para>
  <para style="q1" vid="PSA 98:3">Ama o uvaɗi suru,</para>
  <para style="q2" vid="PSA 98:3">e ene ta̱ iwawi ya̱ A̱sula̱ a̱ tsu.<verse eid="PSA 98:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4" />I yuwan yisaali i ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 98:4">a̱ tyo uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 98:4">a̱ɗu uvaɗi ma̱ɓula̱!</para>
  <para style="q1" vid="PSA 98:4">I ɓosho ni ishipa i ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 98:4">na̱ mesun me e itana i tsuwe'e!<verse eid="PSA 98:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5" />Canayi A̱sulazuva ica ni igaraya,</para>
  <para style="q2" vid="PSA 98:5">ni igaraya i 'ya̱sa̱n uɗyo wi ishipa yu uyo'o!<verse eid="PSA 98:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6" />Ivula̱i abulu na avana,</para>
  <para style="q2" vid="PSA 98:6">i yuwan yisaali i ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 98:6">a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva Mogono.<verse eid="PSA 98:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7" />Lyawa mala ma yuwan</para>
  <para style="q2" vid="PSA 98:7">ma̱gugwa̱ ma̱ ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 98:7">ni ili i na i ri pe a̱tsuma̱ a̱yi suru.</para>
  <para style="q1" vid="PSA 98:7">Uvaɗi waru na aza a na a̱ ri</para>
  <para style="q2" vid="PSA 98:7">na̱ nden a̱tsuma̱ a̱yi.<verse eid="PSA 98:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8" />Lyawa ɗolu ɓasa ekere e le,</para>
  <para style="q2" vid="PSA 98:8">lyawa agaɗi a cana ishipa i ma̱za̱nga̱ oɓolo,<verse eid="PSA 98:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 98:9" />lyawa a cana ishipa</para>
  <para style="q2" vid="PSA 98:9">a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva.</para>
  <para style="q1" vid="PSA 98:9">Adama a na u ta̱ lo a̱ ta̱wa̱</para>
  <para style="q2" vid="PSA 98:9">u ge'eto uvaɗi.</para>
  <para style="q1" vid="PSA 98:9">U ta̱ ge'eto ama o uvaɗi suru</para>
  <para style="q2" vid="PSA 98:9">na amayun na̱ a̱ɓula̱.<verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" sid="PSA 99" />
  <para style="s">A̱sula̱ a na a la'ai tsugbain</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1" />A̱sulazuva Mogono ma ɗa!<note caller="-" style="x"><char style="xo" closed="false">99:1 </char><char style="xt" closed="false"><ref loc="EXO 25:22">Mta̱ 25:22</ref>.</char></note></para>
  <para style="q2" vid="PSA 99:1">Lyawa ama e je'en lipu,</para>
  <para style="q1" vid="PSA 99:1">u ta̱ nden uba̱ta̱ u tsugono tsa yi,</para>
  <para style="q2" vid="PSA 99:1">zuva e memere ma nan kerobobi,</para>
  <para style="q2" vid="PSA 99:1">lyawa uvaɗi u jinga̱ɗa̱.<verse eid="PSA 99:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2" />A̱sulazuva a na a̱ ri Sihiyona zagbain ɗa,</para>
  <para style="q2" vid="PSA 99:2">za tsugbain ɗa a aci a nɗa suru.<verse eid="PSA 99:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3" />Lyawa le a cuwa a̱ba̱jini ala a̱ wu</para>
  <para style="q2" vid="PSA 99:3">a na a̱ ri wovon.</para>
  <para style="q2" vid="PSA 99:3">A̱yi za va akiza ɗa.<verse eid="PSA 99:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4" />Mogono ma gbain,</para>
  <para style="q2" vid="PSA 99:4">vu ciga ta̱ mejege,</para>
  <para style="q2" vid="PSA 99:4">vu shuwa̱ ta̱ ili i na i ri mejege,</para>
  <para style="q1" vid="PSA 99:4">vu yuwan ta̱ mejege na̱ a̱ɓula̱,</para>
  <para style="q2" vid="PSA 99:4">e ekere a Isra'ila.<verse eid="PSA 99:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5" />I cuwa A̱sulazuva A̱sula̱ a̱ tsu,</para>
  <para style="q2" vid="PSA 99:5">i yuwan a̱ga̱nda̱ a̱ ma̱ka̱ka̱n ma̱ yi.</para>
  <para style="q2" vid="PSA 99:5">A̱yi za va akiza ɗa.<verse eid="PSA 99:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6" />Musa na̱ Haruna,</para>
  <para style="q2" vid="PSA 99:6">a̱ da̱na̱ ta̱ a̱tsuma̱ a nan ganu a̱ yi,</para>
  <para style="q1" vid="PSA 99:6">Sama'ila waru da̱na̱ ta̱,</para>
  <para style="q2" vid="PSA 99:6">a̱tsuma̱ aza a na a̱ ɗesu ala a̱ yi,</para>
  <para style="q1" vid="PSA 99:6">e ɗe ta̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 99:6">waru u usu le ta̱.<verse eid="PSA 99:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7" />U yuwan ta̱ adanshi ne ele,</para>
  <para style="q2" vid="PSA 99:7">a̱tsuma̱ oɓolo e eleshe,<note caller="-" style="x"><char style="xo" closed="false">99:7 </char><char style="xt" closed="false"><ref loc="EXO 33:9">Mta̱ 33:9</ref>.</char></note></para>
  <para style="q1" vid="PSA 99:7">a̱vu a yuwan tsutoni na̱ wila̱ wa̱ yi,</para>
  <para style="q2" vid="PSA 99:7">oɓolo nu udammu u na u ca nle.<verse eid="PSA 99:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8" />A̱sulazuva A̱sula̱ a̱ tsu,</para>
  <para style="q2" vid="PSA 99:8">vu usu le ta̱.</para>
  <para style="q1" vid="PSA 99:8">Vu roco ta̱ Isra'ila,</para>
  <para style="q2" vid="PSA 99:8">a̱vu A̱sula̱ a na a tsu yuwan gafura ɗa,</para>
  <para style="q1" vid="PSA 99:8">ko na wo o'woi vu tsu ca le ta̱ oforo,</para>
  <para style="q2" vid="PSA 99:8">adama a̱ nusu le.<verse eid="PSA 99:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9" />Cuwai A̱sulazuva A̱sula̱ a̱ tsu,</para>
  <para style="q2" vid="PSA 99:9">a̱vu i yuwaan yi a̱ga̱nda̱</para>
  <para style="q2" vid="PSA 99:9">a masasan ma akiza a̱ yi,</para>
  <para style="q1" vid="PSA 99:9">adama a na A̱sulazuva A̱sula̱ a̱ tsu,</para>
  <para style="q2" vid="PSA 99:9">za va akiza ɗa.<verse eid="PSA 99:9" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" sid="PSA 100" />
  <para style="s">Ishipa yu ugodyusho</para>
  <para style="d">Ica yu ugodyusho.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1" />Yuwain yisaali i ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 100:1">a̱ tyo uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 100:1">a̱ɗu uvaɗi ma̱ɓula̱.<verse eid="PSA 100:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 100:2" />I yuwaan A̱sulazuva a̱ga̱nda̱ na̱ mere!</para>
  <para style="q2" vid="PSA 100:2">I ta̱wa̱ a̱ ma̱ka̱ka̱n ma̱ yi</para>
  <para style="q2" vid="PSA 100:2">ni ishipa i ma̱za̱nga̱!<verse eid="PSA 100:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3" />I reve A̱sulazuva A̱sula̱ a ɗa,</para>
  <para style="q2" vid="PSA 100:3">a̱yi ɗa u yuwan ntsu</para>
  <para style="q2" vid="PSA 100:3">a̱tsu a̱za̱ a̱ yi a ɗa.</para>
  <para style="q1" vid="PSA 100:3">A̱tsu ama a̱yi a ɗa,</para>
  <para style="q2" vid="PSA 100:3">ikyon i na waa guɓusa.<verse eid="PSA 100:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4" />I uwa a̱ na̱ntsu va̱ a̱a̱'isa̱ a̱ yi nu ugodyusho,</para>
  <para style="q2" vid="PSA 100:4">i uwa o ukowo wa̱ a̱a̱'isa̱ a̱ yi ni ica,</para>
  <para style="q2" vid="PSA 100:4">i godyowo A̱sulazuva waru i cuwa ala a̱ yi.<verse eid="PSA 100:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5" />Adama a na A̱sulazuva</para>
  <para style="q2" vid="PSA 100:5">za vi isa'ani ɗa,<note caller="-" style="x"><char style="xo" closed="false">100:5 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 Alb 16:34</ref>; <ref loc="2CH 5:13">2 Alb 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Ezr 3:11</ref>; <ref loc="PSA 106:1">Ica 106:1</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Irm 33:11</ref>.</char></note></para>
  <para style="q1" vid="PSA 100:5">icigi ya̱ yi i na i tsu vadala shi</para>
  <para style="q2" vid="PSA 100:5">za hali hali ɗa,</para>
  <para style="q2" vid="PSA 100:5">amayun a̱ yi waru a̱ ri nu ukosu shi.<verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" sid="PSA 101" />
  <para style="s">Ishipa yi nzuwulai m mogono</para>
  <para style="d">Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1" />A̱sulazuva, n ta canaa wu</para>
  <para style="q2" vid="PSA 101:1">ishipa yi icigi oɓolo na amayun,</para>
  <para style="q1" vid="PSA 101:1">n ta cana ishipa</para>
  <para style="q2" vid="PSA 101:1">yi ica uba̱ta̱ wa̱ wu.<verse eid="PSA 101:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2" />N ta̱ ka̱mbuwa̱ ugbozu</para>
  <para style="q2" vid="PSA 101:2">n yuwan ili i mejege.</para>
  <para style="q1" vid="PSA 101:2">Mantsa ma ne va̱a̱ ta̱wa̱ uba̱ta̱ u va̱</para>
  <para style="q2" vid="PSA 101:2">vu kamba mu?</para>
  <para style="b" vid="PSA 101:2" />
  <para style="q1" vid="PSA 101:2">N ta yuwan mmalu</para>
  <para style="q2" vid="PSA 101:2">o u'wa u va̱ na̱ a̱ɓula̱.<verse eid="PSA 101:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3" />Maa zuwa esu a̱ va̱</para>
  <para style="q2" vid="PSA 101:3">e ili yi idaba shi.</para>
  <para style="q1" vid="PSA 101:3">Waru n 'yuwan ta̱ linga yipaalishi,</para>
  <para style="q2" vid="PSA 101:3">babu ili i na yoo ɓolo mu ne ele.<verse eid="PSA 101:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4" />N ta yuwan alanga</para>
  <para style="q2" vid="PSA 101:4">na ama a na a̱ ri na̱ okolo a wuya,</para>
  <para style="q1" vid="PSA 101:4">n ri ni ili i na</para>
  <para style="q2" vid="PSA 101:4">maa yuwan ni iwuya shi.<verse eid="PSA 101:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5" />Za na a̱ lungususa̱</para>
  <para style="q2" vid="PSA 101:5">moron ma̱ nden ma̱ yi aala usokowu,</para>
  <para style="q2" vid="PSA 101:5">n to kototo yi.</para>
  <para style="q1" vid="PSA 101:5">Za va aciyogbamu</para>
  <para style="q2" vid="PSA 101:5">za na tsu tara za ili i ro shi,</para>
  <para style="q2" vid="PSA 101:5">maa gura da̱nu na̱ yi shi.<verse eid="PSA 101:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6" />Esu a̱ va̱ a̱ ta̱ da̱na̱ e idanasa</para>
  <para style="q2" vid="PSA 101:6">a̱za̱ a̱ a̱ɓula̱ e iɗa'a ni isa'ani,</para>
  <para style="q1" vid="PSA 101:6">tsa̱ra̱ a̱ da̱na̱</para>
  <para style="q2" vid="PSA 101:6">oɓolo na̱ a̱mu.</para>
  <para style="q1" vid="PSA 101:6">Za na mmalu ma̱ yi</para>
  <para style="q2" vid="PSA 101:6">n ri na addama shi,</para>
  <para style="q2" vid="PSA 101:6">u ta yuwaan mu ulinga.<verse eid="PSA 101:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7" />Babu za va̱ A̱lumu</para>
  <para style="q2" vid="PSA 101:7">na a̱ da̱nu o u'wa u va̱.</para>
  <para style="q1" vid="PSA 101:7">Za na aa yuwusan epen</para>
  <para style="q2" vid="PSA 101:7">e isawan a̱ ma̱ka̱ka̱n ma̱ va̱ shi.<verse eid="PSA 101:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8" />Usana biti n to kototo</para>
  <para style="q2" vid="PSA 101:8">a̱za̱ e iwuya e iɗa'a suru.</para>
  <para style="q1" vid="PSA 101:8">N ta̱ loso waru aza a na</para>
  <para style="q2" vid="PSA 101:8">aa yuwusan iwuya suru</para>
  <para style="q2" vid="PSA 101:8">a̱tsuma̱ a̱ lyuci va̱ A̱sulazuva.<verse eid="PSA 101:8" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" sid="PSA 102" />
  <para style="s">Avasa a za na o sowuso a̱tsuma̱lima̱</para>
  <para style="d">Avasa a za na o sowuso a̱tsuma̱lima̱ a mantsa ma na u lambai ucira e mesun a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1" />A̱sulazuva, uwwa avasa a̱ va̱,</para>
  <para style="q2" vid="PSA 102:1">lyawa mesun ma̱ va̱ ma̱a̱ ta̱wa̱ uba̱ta̱ wa̱ wu.<verse eid="PSA 102:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2" />She vu sokowo mu urewesu wa̱ wu</para>
  <para style="q2" vid="PSA 102:2">a mantsa ma na n ri pe a̱tsuma̱lima̱ wan!</para>
  <para style="q1" vid="PSA 102:2">Vu poloo mu atsuvu a̱ wu</para>
  <para style="q2" vid="PSA 102:2">a mantsa ma na n ɗeyi,</para>
  <para style="q2" vid="PSA 102:2">vu usu keɗu!<verse eid="PSA 102:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3" />Adama a na rana va̱ ta a mmalu</para>
  <para style="q2" vid="PSA 102:3">cine vu revei mikyon,</para>
  <para style="q1" vid="PSA 102:3">etele a̱ va̱ a̱ ta̱ ma̱kula̱</para>
  <para style="q2" vid="PSA 102:3">cine vu revei akina.<verse eid="PSA 102:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4" />Ookolo a̱ va̱ a banakan ta̱,</para>
  <para style="q2" vid="PSA 102:4">reve u kpanla cine vu revei anlya,</para>
  <para style="q2" vid="PSA 102:4">hali n kuɗa̱ a uwwa maluwa me e ilyalya.<verse eid="PSA 102:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5" />Adama a̱ ma̱nga̱ ma̱ a̱bunda̱ ma̱ va̱</para>
  <para style="q2" vid="PSA 102:5">n ramba ta̱ hali mo o'wo etele can.<verse eid="PSA 102:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6" />N rotso ta̱ vori vu una,</para>
  <para style="q2" vid="PSA 102:6">cine vu revei vori o okongo.<verse eid="PSA 102:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7" />N tsa asa ta̱ wuma,</para>
  <para style="q2" vid="PSA 102:7">n tso o'wo ta̱ a̱ nde'en</para>
  <para style="q2" vid="PSA 102:7">cine vu revei manunu zuva vu ukwa̱'a̱.<verse eid="PSA 102:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8" />N'yuwatan n va̱ n tee isulusa mu urana ma̱ɓula̱.</para>
  <para style="q2" vid="PSA 102:8">Aza a na a yuwusaan mu ulamu</para>
  <para style="q2" vid="PSA 102:8">a̱ ka̱mbuwa̱ ta̱ ala a̱ va̱ ili ya avandaru.<verse eid="PSA 102:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9" />Adama a na n ta lyuwusa okomo tsi ilyalya,</para>
  <para style="q2" vid="PSA 102:9">reve m ɓolo ili yo oso a̱ va̱ na aɓara.<verse eid="PSA 102:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10" />Adama o upan na asuvu usuɗuwu a̱ wu a ɗa,</para>
  <para style="q2" vid="PSA 102:10">vu tara numu a̱vu vu vari mu.<verse eid="PSA 102:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11" />Rana va̱ ta mmalu</para>
  <para style="q2" vid="PSA 102:11">cine vu revei ululu wu ulivu,</para>
  <para style="q2" vid="PSA 102:11">m kpanla ta̱ tsa anlya.<verse eid="PSA 102:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12" />Amma a̱vu, A̱sulazuva,</para>
  <para style="q2" vid="PSA 102:12">vu ta̱ lo babu ukotu,</para>
  <para style="q1" vid="PSA 102:12">a ta cuwan na ala a̱ wu</para>
  <para style="q2" vid="PSA 102:12">diga a mantsa a tyo mantsa.<verse eid="PSA 102:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13" />Vu ta̱ 'yon ve ene iliyali ya̱ Sihiyona,</para>
  <para style="q2" vid="PSA 102:13">adama a na mantsa ma ɗa ma na voo roco isa'ani uba̱ta̱ wa̱ yi,</para>
  <para style="q2" vid="PSA 102:13">mantsa'a ma rawa ta̱.<verse eid="PSA 102:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14" />Adama a na agbashi a̱ wu</para>
  <para style="q2" vid="PSA 102:14">a ta maluwa ma atali a̱ wu,</para>
  <para style="q2" vid="PSA 102:14">a̱ ta̱ e enishe iliyali i ma̱buta̱ ma̱ yi.<verse eid="PSA 102:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15" />A̱sulazuva, nɗa n ta uwwa wovon wa ala a̱ wu,</para>
  <para style="q2" vid="PSA 102:15">ngono mu uvaɗi suru n ta uwwa wovon u tsugbain tsa̱ wu.<verse eid="PSA 102:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16" />Adama a na A̱sulazuva a ta suwisa Sihiyona,</para>
  <para style="q2" vid="PSA 102:16">reve u roco tsugbain tsa̱ yi.<verse eid="PSA 102:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17" />U ta uwwa avasa aza a na a̱ ri nu ucira shi,</para>
  <para style="q2" vid="PSA 102:17">wa̱a̱ kuɗa̱ zuwaa le atsuvu shi.<verse eid="PSA 102:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18" />Lyawa a ɗana ili i nda</para>
  <para style="q2" vid="PSA 102:18">adama aza a na a̱ ri lo a̱ ta̱wa̱ a̱ca̱pa̱,</para>
  <para style="q1" vid="PSA 102:18">tsa̱ra̱ aza a na koto a matsain shi</para>
  <para style="q2" vid="PSA 102:18">a̱ ta̱wa̱ a cuwa A̱sulazuva.<verse eid="PSA 102:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19" />&lt;&lt;A̱sulazuva a̱ ka̱lyuwa̱ ta̱ diga ɗe a̱a̱'isa̱ a̱ yi,</para>
  <para style="q2" vid="PSA 102:19">diga zuva ɗaɗa u ka̱lyuwa̱i uvaɗi,<verse eid="PSA 102:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20" />tsa̱ra̱ wu uwwa ma̱nga̱ ma aza a na a̱ ri o u'wa wa ali,</para>
  <para style="q2" vid="PSA 102:20">u wawa aza a na a paɗaa yi ugana wu ukwisa̱.&gt;&gt;<verse eid="PSA 102:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21" />Tsa̱ra̱ a ca udammu</para>
  <para style="q2" vid="PSA 102:21">wa ala a̱ A̱sulazuva</para>
  <para style="q1" vid="PSA 102:21">a̱tsuma̱ a̱ Sihiyona,</para>
  <para style="q2" vid="PSA 102:21">ica ya̱ yi waru a̱tsuma̱ a̱ Urishelima,<verse eid="PSA 102:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22" />a mantsa ma na ama na̱ a̱za̱ o tsugono o ɓolotoi</para>
  <para style="q2" vid="PSA 102:22">tsa̱ra̱ a yuwaan A̱sulazuva a̱ga̱nda̱.<verse eid="PSA 102:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23" />Wu kuɗa ta̱ ucira u va̱ o ure,</para>
  <para style="q2" vid="PSA 102:23">reve u jiba rana va̱.<verse eid="PSA 102:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24" />Ɗaɗa n dammai,</para>
  <para style="q2" vid="PSA 102:24">&lt;&lt;A̱sula̱ a̱ va̱, she vu tara wuma u va̱ gogo wan,</para>
  <para style="q2" vid="PSA 102:24">a na wo o'woi koto n kutsa shi!</para>
  <para style="q2" vid="PSA 102:24">A̱vu na a'wan a̱ wu a̱ ri diga mantsa a tyo mantsa.<verse eid="PSA 102:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25" />Ɗe nu ujumu vu shuwa̱ ta̱ ikyun yu uvaɗi,<note caller="-" style="x"><char style="xo" closed="false">102:25-27 </char><char style="xt" closed="false"><ref loc="HEB 1:10-12">M.Ib 1:10-12</ref>.</char></note></para>
  <para style="q2" vid="PSA 102:25">zuva waru ulinga we ekere wu a ɗa.<verse eid="PSA 102:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26" />A̱ ta̱ puwa̱n,</para>
  <para style="q2" vid="PSA 102:26">a̱vu gba vu ta̱ lo,</para>
  <para style="q1" vid="PSA 102:26">o to kporo cine vu revei itana i wotosu.</para>
  <para style="q2" vid="PSA 102:26">Cine vu revei a̱tugu a ɗa</para>
  <para style="q2" vid="PSA 102:26">vaa vadala le waru a̱ ta̱ puwa̱n.<verse eid="PSA 102:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27" />Amma a̱vu vu tsu vadala shi,</para>
  <para style="q2" vid="PSA 102:27">a'wan a̱ wu o koto shi.<verse eid="PSA 102:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28" />Muwun ma agbashi a̱ wu a̱ ta̱ da̱nu</para>
  <para style="q2" vid="PSA 102:28">a̱ ma̱ka̱ka̱n ma̱ wu gbaga,</para>
  <para style="q2" vid="PSA 102:28">limatan le ta bala a̱ ma̱ka̱ka̱n ma̱ wu.&gt;&gt;<verse eid="PSA 102:28" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" sid="PSA 103" />
  <para style="s">Ishipa yi ica adama e isa'ani ya̱ A̱sula̱</para>
  <para style="d">Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1" />Vu cuwa A̱sulazuva,</para>
  <para style="q2" vid="PSA 103:1">wuma u va̱!</para>
  <para style="q1" vid="PSA 103:1">Ili i na i ri a̱tsuma̱ a̱ va̱ suru,</para>
  <para style="q2" vid="PSA 103:1">i cuwa ala a akiza a̱ yi.<verse eid="PSA 103:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2" />Vu cuwa A̱sulazuva,</para>
  <para style="q2" vid="PSA 103:2">wuma u va̱!</para>
  <para style="q2" vid="PSA 103:2">Vi icina ni isa'ani ya̱ yi wan,<verse eid="PSA 103:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3" />za na yuwaan nuwu gafura vu nusu va̱ wu suru,</para>
  <para style="q2" vid="PSA 103:3">reve u yuwaan wu opocino a banakun va̱ wu.<verse eid="PSA 103:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4" />Za na wawai wuma wa̱ wu diga a̱ a̱a̱ka̱ri o ukwa̱,</para>
  <para style="q2" vid="PSA 103:4">reve u katala wu no okokolo e icigi ni iliyali.<verse eid="PSA 103:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5" />Za na cuwa̱ton nuwu ni ili i sa'ani</para>
  <para style="q2" vid="PSA 103:5">adama a̱ ka̱mba̱to ucira wa̱ wu</para>
  <para style="q2" vid="PSA 103:5">tsa̱ a̱a̱kuru.<verse eid="PSA 103:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6" />A̱sulazuva a ta yuwusan ulinga wa̱ a̱ɓula̱ na amayun</para>
  <para style="q2" vid="PSA 103:6">e ekere aza a na a tsutsugbusa.<verse eid="PSA 103:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7" />U lyawa ta̱ Musa reve re va̱ yi,</para>
  <para style="q2" vid="PSA 103:7">linga va̱ yi waru uba̱ta̱ wa aza a Isra'ila.<verse eid="PSA 103:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8" />A̱sulazuva a̱ ta̱ tapu</para>
  <para style="q2" vid="PSA 103:8">ni iliyali ni isa'ani,<note caller="-" style="x"><char style="xo" closed="false">103:8 </char><char style="xt" closed="false"><ref loc="JAS 5:11">Yak 5:11</ref>.</char></note></para>
  <para style="q1" vid="PSA 103:8">u tsu yuwan upan keɗu shi,</para>
  <para style="q2" vid="PSA 103:8">o rocosu icigi ya̱ yi</para>
  <para style="q2" vid="PSA 103:8">i na i tsu vadala shi.<verse eid="PSA 103:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9" />U tsu ɓarasa mantsa suru shi,</para>
  <para style="q2" vid="PSA 103:9">waru wa̱a̱ da̱na̱ a yuwusan upan hali hali shi.<verse eid="PSA 103:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10" />U ca tsu oforo wuntsa wu na̱ nusu tsu shi,</para>
  <para style="q2" vid="PSA 103:10">ko u tsupa tsu o una̱ wu nusu na tsu yuwain shi.<verse eid="PSA 103:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11" />Adama a na cine vu revei zuva ri alanga ni iɗa,</para>
  <para style="q2" vid="PSA 103:11">ne ɗa icigi ya̱ yi i na i tsu vadala shi i ri mgbain</para>
  <para style="q2" vid="PSA 103:11">e ekere aza a na a uwwusa wovon wa̱ yi.<verse eid="PSA 103:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12" />Cine vu revei asana a̱ ri alanga na̱ a̱livu,</para>
  <para style="q2" vid="PSA 103:12">ne ɗa waa tawusa nusu tsu alanga na̱ a̱tsu.<verse eid="PSA 103:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13" />Cine dada tse ene iliyali i mawun ma̱ yi,</para>
  <para style="q2" vid="PSA 103:13">ne ɗa A̱sulazuva e enishe iliyali</para>
  <para style="q2" vid="PSA 103:13">ya aza a na a uwwusa wovon wa̱ yi.<verse eid="PSA 103:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14" />U reve ta̱ cine tsu ri,</para>
  <para style="q2" vid="PSA 103:14">u tsu cuwan ta̱ a na a̱tsu ma̱buta̱ ma ɗa.<verse eid="PSA 103:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15" />Rana vu vaɗilima̱,</para>
  <para style="q2" vid="PSA 103:15">ta̱ tsa anlya,</para>
  <para style="q2" vid="PSA 103:15">u tsu bala ta̱ tsa yipa̱lu ya atsusa,<verse eid="PSA 103:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16" />upepu u tsu lapa yi ta̱ a̱vu u puwa̱a̱n,</para>
  <para style="q2" vid="PSA 103:16">a̱a̱ da̱shi ene iroci ya̱ yi shi.<verse eid="PSA 103:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17" />Amma icigi ya̱ A̱sulazuva</para>
  <para style="q2" vid="PSA 103:17">i na i tsu vadala shi</para>
  <para style="q1" vid="PSA 103:17">u ri nu ukotu shi</para>
  <para style="q2" vid="PSA 103:17">uba̱ta̱ wa aza a na a uwwusa wovon wa̱ yi.</para>
  <para style="q1" vid="PSA 103:17">A̱ɓula̱ a̱ yi waru a̱ tyo</para>
  <para style="q2" vid="PSA 103:17">uba̱ta̱ u muwun n tsukaya n le,<verse eid="PSA 103:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18" />aza a na a yuwusan tsutoni na̱ wila̱ wa̱ yi</para>
  <para style="q2" vid="PSA 103:18">reve a cuwan a yuwan ili i na u dammai.<verse eid="PSA 103:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19" />A̱sulazuva a̱ shuwa̱ ta̱</para>
  <para style="q2" vid="PSA 103:19">ootogu o tsugono tsa̱ yi zuva,</para>
  <para style="q1" vid="PSA 103:19">reve tsugono tsa̱ yi</para>
  <para style="q2" vid="PSA 103:19">tsa yuwusan tsugbain tsi ili suru.<verse eid="PSA 103:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20" />I cuwa A̱sulazuva,</para>
  <para style="q2" vid="PSA 103:20">a̱ɗu nlingata ma̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 103:20">a̱ɗu na i ri nu ucira,</para>
  <para style="q1" vid="PSA 103:20">aza a na a yuwusan ili i na u cigai,</para>
  <para style="q2" vid="PSA 103:20">a yuwusan tsutoni na adanshi a̱ yi.<verse eid="PSA 103:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21" />I cuwa A̱sulazuva,</para>
  <para style="q2" vid="PSA 103:21">a̱ɗu oɓolo a a̱soja a zuva suru,</para>
  <para style="q1" vid="PSA 103:21">a̱ɗu agbashi a̱ yi,</para>
  <para style="q2" vid="PSA 103:21">aza a na aa yuwusan ili i na u dammai.<verse eid="PSA 103:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22" />I cuwa A̱sulazuva</para>
  <para style="q2" vid="PSA 103:22">a̱ɗu linga va̱ yi a̱tsuma̱ o tsugono tsa̱ yi suru.</para>
  <para style="q2" vid="PSA 103:22">Vu cuwa A̱sulazuva wuma u va̱.<verse eid="PSA 103:22" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" sid="PSA 104" />
  <para style="s">A̱sulazuva a̱ ta̱ idanasa ili i na u yuwain</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1" />Vu cuwa A̱sulazuva,</para>
  <para style="q2" vid="PSA 104:1">wuma u va̱!</para>
  <para style="q1" vid="PSA 104:1">A̱sulazuva A̱sula̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 104:1">zagbain ɗa vu ri lon,</para>
  <para style="q2" vid="PSA 104:1">vu ta̱ wupalu na̱ tsugbain na̱ a̱ɓula̱.<verse eid="PSA 104:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2" />A̱sulazuva a pala ta̱ aciya̱yi ne ekan</para>
  <para style="q2" vid="PSA 104:2">cine vu revei umuna,</para>
  <para style="q1" vid="PSA 104:2">wu ba̱ruwa̱ ta̱ zuva va zuva</para>
  <para style="q2" vid="PSA 104:2">cine vu revei oogodo,<verse eid="PSA 104:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 104:3" />u shuwa̱ ta̱ ikyun yu usaa</para>
  <para style="q2" vid="PSA 104:3">wu u'wa wa̱ yi zuva mini.</para>
  <para style="q1" vid="PSA 104:3">U ka̱mba̱to ta̱ eleshe</para>
  <para style="q2" vid="PSA 104:3">keke vi ido yu uvon ya̱ yi</para>
  <para style="q2" vid="PSA 104:3">a kumbusa e evelu o upepu.<verse eid="PSA 104:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4" />U ka̱mba̱to ta̱ upepu o'wo ajiya a̱ yi,</para>
  <para style="q2" vid="PSA 104:4">elentsu a akina waru nlingata ma̱ yi.<verse eid="PSA 104:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5" />U shuwa̱ ta̱ uvaɗi e ikyun ya̱ yi,</para>
  <para style="q2" vid="PSA 104:5">wa̱a̱ jinga̱ɗa̱ shi.<verse eid="PSA 104:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6" />Vu zuwa ta̱ mala</para>
  <para style="q2" vid="PSA 104:6">ma pala uvaɗi tsu umuna,</para>
  <para style="q1" vid="PSA 104:6">reve mini ma̱ da̱nu</para>
  <para style="q2" vid="PSA 104:6">zuva vu nsasan.<verse eid="PSA 104:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7" />Amma tsuɓari tsa̱ wu tsa zuwa ta̱ a suma,</para>
  <para style="q2" vid="PSA 104:7">ana a uwwai uɗyo u tsata tsa̱ wu</para>
  <para style="q2" vid="PSA 104:7">ɗaɗa a sumai,<verse eid="PSA 104:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8" />a kumbai a nsasan,</para>
  <para style="q2" vid="PSA 104:8">reve a̱ cipa̱ a̱ tyo o uka̱ri,</para>
  <para style="q2" vid="PSA 104:8">uba̱ta̱ u na vu foɓoo nle.<verse eid="PSA 104:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9" />Vu zuwaa le ta̱ utyo u na a pasa shi,</para>
  <para style="q2" vid="PSA 104:9">tsa̱ra̱ a̱ da̱shi ta̱wa̱ a pala uvaɗi wan.<verse eid="PSA 104:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10" />Vu zuwa ta̱ esu a̱ mini o o'wo ɗolu,</para>
  <para style="q2" vid="PSA 104:10">e yeneshe e memere ma nsasan.<verse eid="PSA 104:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11" />A ta casu inama yu una suru mini,</para>
  <para style="q2" vid="PSA 104:11">ɗe ɗa nloli mu una n tsu tawa akuli e le.<verse eid="PSA 104:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12" />Nnunu ma zuva n tsu yuwan ta̱</para>
  <para style="q2" vid="PSA 104:12">nkinda zuzu na̱ mini'i,</para>
  <para style="q2" vid="PSA 104:12">reve a̱ da̱na̱ a canasa ishipa ɗe e eten.<verse eid="PSA 104:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13" />Diga ɗe zuva</para>
  <para style="q2" vid="PSA 104:13">uba̱ta̱ wu nden ma̱ wu u ɗa,</para>
  <para style="q2" vid="PSA 104:13">vaa casu nsasan mini,</para>
  <para style="q1" vid="PSA 104:13">waru uvaɗi u tsu shiwan ta̱</para>
  <para style="q2" vid="PSA 104:13">na aba'un a̱ wu.<verse eid="PSA 104:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14" />Vu tsu zuwa ta̱ anlya a kungwa</para>
  <para style="q2" vid="PSA 104:14">adama e iliyamunga,</para>
  <para style="q1" vid="PSA 104:14">ototopi adama a vuma,</para>
  <para style="q2" vid="PSA 104:14">tsa̱ra̱ u tsura̱ ilyalya o uvaɗi,<verse eid="PSA 104:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15" />oɓolo na̱ masayan ma na</para>
  <para style="q2" vid="PSA 104:15">ma tsu zuwa okolo ma̱za̱nga̱,</para>
  <para style="q1" vid="PSA 104:15">na̱ mani'in adama u zuwa</para>
  <para style="q2" vid="PSA 104:15">urewesu wa̱ yi u dala,</para>
  <para style="q2" vid="PSA 104:15">no opopofu a na aa ca yi ucira.<verse eid="PSA 104:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16" />Ɗanga va̱ A̱sulazuva a̱ tsura̱ ta̱ mini lon,</para>
  <para style="q2" vid="PSA 104:16">ɗanga sida va Lebanon na u shuwa̱i.<verse eid="PSA 104:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17" />Uba̱ta̱ u na nnunu</para>
  <para style="q2" vid="PSA 104:17">n tsu yuwan nkinda n le,</para>
  <para style="q1" vid="PSA 104:17">aashamuwa a̱ ta̱ na̱ 'wa le</para>
  <para style="q2" vid="PSA 104:17">a ɗanga fir.<verse eid="PSA 104:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18" />Zuva vu nsasan mu uga'an n ɗa</para>
  <para style="q2" vid="PSA 104:18">mgbele mu una n tsu da̱nu,</para>
  <para style="q1" vid="PSA 104:18">a̱ba̱nu waru adama a magima</para>
  <para style="q2" vid="PSA 104:18">a̱ tsura̱ upa'atan.<verse eid="PSA 104:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19" />Vu zuwa ta̱ woto</para>
  <para style="q2" vid="PSA 104:19">tsa̱ra̱ vu roco mantsa,</para>
  <para style="q1" vid="PSA 104:19">waru urana u reve ta̱</para>
  <para style="q2" vid="PSA 104:19">mantsa ma na wa̱a̱ riya̱.<verse eid="PSA 104:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20" />Vu yuwan ta̱ irumbu, wo o'wo ayin</para>
  <para style="q2" vid="PSA 104:20">mantsa ma na inama yu una i tsu uta̱ igaru.<verse eid="PSA 104:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21" />Ikamu i tsu gugwa̱ ta̱ na̱ o uta̱</para>
  <para style="q2" vid="PSA 104:21">igaru yi izami yi ilyalya,</para>
  <para style="q1" vid="PSA 104:21">a zamishi ilyalya i le</para>
  <para style="q2" vid="PSA 104:21">diga uba̱ta̱ wa̱ A̱sula̱.<verse eid="PSA 104:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22" />Nu usana u tawa,</para>
  <para style="q2" vid="PSA 104:22">reve a̱ ka̱mba̱ o von a̱ a̱a̱ka̱ri</para>
  <para style="q2" vid="PSA 104:22">uba̱ta̱ u na a̱ tsi ivuwan.<verse eid="PSA 104:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23" />Vaɗilima̱ tsu uta̱ ta̱</para>
  <para style="q2" vid="PSA 104:23">u 'ya̱wa̱ uba̱ta̱ o ulinga wa̱ yi,</para>
  <para style="q2" vid="PSA 104:23">u yuwan ulinga wa̱ yi hali ulivu.<verse eid="PSA 104:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24" />A̱sulazuva, vu yuwan ta̱</para>
  <para style="q2" vid="PSA 104:24">ili ya̱ a̱bunda̱!</para>
  <para style="q1" vid="PSA 104:24">Nu ugbozu wa̱ a̱bunda̱ u ɗa vu yuwan nle.</para>
  <para style="q1" vid="PSA 104:24">Uvaɗi u ta̱ tapu</para>
  <para style="q2" vid="PSA 104:24">ni ili i na vu yuwain.<verse eid="PSA 104:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25" />Apa uɗolu u washin wa̱ a̱ru'un</para>
  <para style="q2" vid="PSA 104:25">tapu ni ili i wuma i mini ya̱ a̱bunda̱</para>
  <para style="q2" vid="PSA 104:25">na ri n kece shi,</para>
  <para style="q1" vid="PSA 104:25">aza a wuma,</para>
  <para style="q2" vid="PSA 104:25">aza a gbagbain na̱ muwun.<verse eid="PSA 104:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26" />Nlo antsun a̱ mini,</para>
  <para style="q2" vid="PSA 104:26">aza a na a̱ 'ya̱wusa̱ na̱ a̱ ta̱wi.</para>
  <para style="q1" vid="PSA 104:26">Nlo a̱a̱dodo Leviyatan<note caller="-" style="x"><char style="xo" closed="false">104:26 </char><char style="xt" closed="false"><ref loc="JOB 41:1">Ayb 41:1</ref>; <ref loc="PSA 74:14">Ica 74:14</ref>; <ref loc="ISA 27:1">Ish 27:1</ref>.</char></note> na vu yuwain</para>
  <para style="q2" vid="PSA 104:26">tsa̱ra̱ u yuwan uro a̱tsuma̱ a̱ mini.<verse eid="PSA 104:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27" />A ta zuwusaa wu ucira suru</para>
  <para style="q2" vid="PSA 104:27">tsa̱ra̱ a̱ tsura̱ ilyalya</para>
  <para style="q2" vid="PSA 104:27">a mantsa ma na a cigai.<verse eid="PSA 104:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28" />Na̱ vu ca le o tsu ɓoloto ta̱,</para>
  <para style="q2" vid="PSA 104:28">na̱ vu kpa̱tu'wa̱ ekere a̱ wu,</para>
  <para style="q2" vid="PSA 104:28">reve a̱ cuwa̱n ulobonu.<verse eid="PSA 104:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29" />Na̱ vu soko urewesu wa̱ wu</para>
  <para style="q2" vid="PSA 104:29">a tsu uwwa ta̱ wovon lon,</para>
  <para style="q1" vid="PSA 104:29">na̱ vu tawa wivuwun u le,</para>
  <para style="q2" vid="PSA 104:29">a̱ tsu kuwa̱ ta̱</para>
  <para style="q2" vid="PSA 104:29">reve a̱ ka̱mba̱ ma̱buta̱.<verse eid="PSA 104:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30" />Amma a mantsa ma na vu zuwaa nle wivuwun</para>
  <para style="q2" vid="PSA 104:30">a̱ tsu tsura̱ ta̱ wuma,</para>
  <para style="q1" vid="PSA 104:30">vu tsu lapula ta̱</para>
  <para style="q2" vid="PSA 104:30">urewesu wu uvaɗi.<verse eid="PSA 104:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31" />Lyawa tsugbain tsa̱ A̱sulazuva</para>
  <para style="q2" vid="PSA 104:31">tsa̱ da̱na̱ lo hali hali,</para>
  <para style="q1" vid="PSA 104:31">lyawa A̱sulazuva a yuwan</para>
  <para style="q2" vid="PSA 104:31">ma̱za̱nga̱ a linga va̱ yi.<verse eid="PSA 104:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32" />Za na tsu ka̱lyuwa̱ uvaɗi</para>
  <para style="q2" vid="PSA 104:32">a̱vu u jinga̱ɗa̱,</para>
  <para style="q1" vid="PSA 104:32">za na tsu ju'wa̱n nsasan</para>
  <para style="q2" vid="PSA 104:32">a̱vu o uta̱ mikyon.<verse eid="PSA 104:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33" />N ta canaa A̱sulazuva ishipa</para>
  <para style="q2" vid="PSA 104:33">a wuma u va̱ suru,</para>
  <para style="q1" vid="PSA 104:33">na̱ n ri wuma n ta canaa A̱sula̱ a̱ va̱</para>
  <para style="q2" vid="PSA 104:33">ishipa yi ica.<verse eid="PSA 104:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34" />Lyawa majiyan ma̱ va̱</para>
  <para style="q2" vid="PSA 104:34">ma zuwa yi ma̱za̱nga̱,</para>
  <para style="q1" vid="PSA 104:34">adama n yuwan mere</para>
  <para style="q2" vid="PSA 104:34">uba̱ta̱ wa̱ a̱ A̱sulazuva.<verse eid="PSA 104:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35" />Lyawa a̱za̱ o unusu</para>
  <para style="q2" vid="PSA 104:35">a̱ puwa̱n a̱tsuma̱ o uvaɗi</para>
  <para style="q2" vid="PSA 104:35">waru a̱a̱ da̱shi ee ene a̱za̱ e iwuya wan!</para>
  <para style="q1" vid="PSA 104:35">Vu cuwa A̱sulazuva,</para>
  <para style="q2" vid="PSA 104:35">wuma u va̱.</para>
  <para style="q2" vid="PSA 104:35">Cuwa A̱sulazuva!<verse eid="PSA 104:35" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" sid="PSA 105" />
  <para style="s">A̱sula̱ na Ama a̱ yi</para>
  <para style="r">(<ref loc="1CH 16:8-22">1 Alb 16:8-22</ref>)</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1" />I godyoo A̱sulazuva,</para>
  <para style="q2" vid="PSA 105:1">i ɗe a ala a̱ yi,</para>
  <para style="q2" vid="PSA 105:1">i lyawa nɗa n reve linga va̱ yi.<verse eid="PSA 105:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2" />I canaa yi ishipa,</para>
  <para style="q2" vid="PSA 105:2">i cuwa yi,</para>
  <para style="q2" vid="PSA 105:2">i damma linga va asalama a̱ yi suru.<verse eid="PSA 105:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3" />I yuwan uvaɗu na ala a akiza a̱ yi,</para>
  <para style="q2" vid="PSA 105:3">lyawa okolo aza a na a zama A̱sulazuva</para>
  <para style="q2" vid="PSA 105:3">a yuwan ma̱za̱nga̱.<verse eid="PSA 105:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4" />I zami A̱sulazuva nu ucira wa̱ yi,</para>
  <para style="q2" vid="PSA 105:4">i zami urewesu wa̱ yi kuci.<verse eid="PSA 105:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 105:5" />I cuwan na̱ linga va asalama a na u yuwain,</para>
  <para style="q2" vid="PSA 105:5">ni iroci ya asalama a̱ yi,</para>
  <para style="q2" vid="PSA 105:5">nu uge'etosu u na u dammai.<verse eid="PSA 105:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 105:6" />A̱ɗu ugundo wa Ibrahim aagbashi a̱ yi,</para>
  <para style="q2" vid="PSA 105:6">a̱ɗu muwun ma Yakubu,</para>
  <para style="q2" vid="PSA 105:6">aza a na u ɗangwai.<verse eid="PSA 105:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7" />A̱yi ɗa A̱sulazuva A̱sula̱ a̱ tsu,</para>
  <para style="q2" vid="PSA 105:7">uge'etosu wa̱ yi u ta̱ uba̱ta̱ suru o uvaɗi.<verse eid="PSA 105:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8" />U ta cuwusan na akucunu a̱ yi a babu ukotu,</para>
  <para style="q2" vid="PSA 105:8">na̱ nzuwulai n na u yuwayin gundo ukpakukupa,<verse eid="PSA 105:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9" />na akucunu a na u yuwayin Ibrahim,</para>
  <para style="q2" vid="PSA 105:9">na̱ nzuwulai a̱ tyo ya Ishiyaku,<verse eid="PSA 105:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10" />na u shitoyin uba̱ta̱ wa Ishiyaku</para>
  <para style="q2" vid="PSA 105:10">wo o'wo ili i na a yuwan,</para>
  <para style="q2" vid="PSA 105:10">uba̱ta̱ wa Yakubu tsa akucunu a na a̱ ri babu ukotu,<verse eid="PSA 105:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11" />adansa &lt;&lt;A̱vu ɗa maa ca iɗa ya Ka'ana</para>
  <para style="q2" vid="PSA 105:11">wo o'wo agadu a̱ wu.&gt;&gt;<verse eid="PSA 105:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12" />Mantsa ma na a̱ da̱na̱i ama wa'a,</para>
  <para style="q2" vid="PSA 105:12">omocin a̱tsuma̱ a̱ yi,<verse eid="PSA 105:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13" />a̱ da̱na̱ ta̱ e igaru diga iɗa i nda a̱ tyo e iɗa i ndeɗe,</para>
  <para style="q2" vid="PSA 105:13">diga o tsugono tsa nda a̱ tyo o tsugono tsa̱ ndeɗe.<verse eid="PSA 105:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14" />U lyawa ozoro a tsugba le shi,</para>
  <para style="q2" vid="PSA 105:14">u ɓara̱ ta̱ ngono waru adama e le,<verse eid="PSA 105:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15" />adansa,</para>
  <para style="q2" vid="PSA 105:15">&lt;&lt;She i ju'wa̱n aza a na n ɗangulai wan,</para>
  <para style="q2" vid="PSA 105:15">ko i yuwaan ama̱sula̱ a̱ va̱ i iwuya wan.&gt;&gt;<verse eid="PSA 105:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16" />U zuwa ta̱ ambulu a̱ ta̱wa̱ e iɗa'a,</para>
  <para style="q2" vid="PSA 105:16">reve waru a̱ lungusa̱</para>
  <para style="q2" vid="PSA 105:16">uba̱ta̱ u na ilyalya i le ya̱a̱ ta̱wusa̱.<verse eid="PSA 105:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17" />U lyungu ta̱ vuma ro elime e le,</para>
  <para style="q2" vid="PSA 105:17">Isuhu vuma na a winai tsa aagbashi.<verse eid="PSA 105:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18" />A amaton ta̱ ana a̱ yi na̱ malapa,</para>
  <para style="q2" vid="PSA 105:18">reve a zuwaa yinlu ya̱ yi rumu,<verse eid="PSA 105:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19" />hali mantsa ma na ili i na u dammai i shiwain,</para>
  <para style="q2" vid="PSA 105:19">she mantsa ma na adanshi A̱sulazuva</para>
  <para style="q2" vid="PSA 105:19">o uta̱a̱ niyi babu unusu.<verse eid="PSA 105:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20" />Mogono ma̱ lyungu ta̱ a̱ ba̱ɗa̱ yi,</para>
  <para style="q2" vid="PSA 105:20">zagbain va akapi a ama</para>
  <para style="q2" vid="PSA 105:20">a zuwa ta̱ a lyawa yi fa̱a̱n.<verse eid="PSA 105:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21" />U zuwa yi ta̱ wo o'wo zagbain vu u'wa'a,</para>
  <para style="q2" vid="PSA 105:21">u yuwan tsugbain tsi ili i na u ri na̱ a̱yi suru,<verse eid="PSA 105:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22" />u yuwan na̱ ngono ma̱ yi suru cine u cigai,</para>
  <para style="q2" vid="PSA 105:22">u rito ta̱ mbara ugbozu.<verse eid="PSA 105:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23" />Ɗaɗa Isra'ila uwai a Masar,</para>
  <para style="q2" vid="PSA 105:23">Yakubu waru u da̱na̱ tso mocin e iɗa ya Ham.<verse eid="PSA 105:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24" />A̱sulazuva a zuwa ta̱ ama a̱ yi</para>
  <para style="q2" vid="PSA 105:24">a yuwan a̱bunda̱ lon,</para>
  <para style="q1" vid="PSA 105:24">u yuwan le ta̱ a̱bunda̱ a na a la'ai</para>
  <para style="q2" vid="PSA 105:24">n'yuwatan n le a̱bunda̱.<verse eid="PSA 105:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25" />U vadala ta̱ okolo e le</para>
  <para style="q2" vid="PSA 105:25">a 'yuwan ama a̱ yi,</para>
  <para style="q2" vid="PSA 105:25">waru a suɗato agbashi a̱ yi.<verse eid="PSA 105:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26" />U lyungu ta̱ aagbashi a̱ yi Musa,</para>
  <para style="q2" vid="PSA 105:26">oɓolo na̱ Haruna,</para>
  <para style="q2" vid="PSA 105:26">aza a na u ɗangwai.<verse eid="PSA 105:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27" />A yuwan ta̱ ili ya asalama a̱yi,</para>
  <para style="q2" vid="PSA 105:27">reve a yuwan ulinga wa asalama</para>
  <para style="q2" vid="PSA 105:27">e iɗa ya Ham.<verse eid="PSA 105:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28" />U lyungu ta̱ irumbu</para>
  <para style="q2" vid="PSA 105:28">reve u zuwa iɗa i rumba̱na̱.</para>
  <para style="q1" vid="PSA 105:28">Adama a na aza a Masar a yuwan tsutoni</para>
  <para style="q2" vid="PSA 105:28">na adanshi a̱ yi shi.<verse eid="PSA 105:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29" />U ka̱mba̱to ta̱ mini me le mpasa,</para>
  <para style="q2" vid="PSA 105:29">reve u zuwa mugula nle n kuwa̱.<verse eid="PSA 105:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30" />Iɗa i le i shiwan ta̱ no opoɗo,</para>
  <para style="q2" vid="PSA 105:30">hali nu ukobu u mogono me le.<verse eid="PSA 105:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31" />U yuwan ta̱ adanshi,</para>
  <para style="q2" vid="PSA 105:31">reve oɓolo ayun a shiwan,</para>
  <para style="q2" vid="PSA 105:31">reve ikurukuta i shiwan iɗa'a ma̱ɓula̱.<verse eid="PSA 105:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32" />U lyunguwa̱a̱ le ta̱ na atayan diga zuva,</para>
  <para style="q2" vid="PSA 105:32">na̱ imaɗatsu e iɗa'a ma̱ɓula̱.<verse eid="PSA 105:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33" />Wu faba ta̱ ataci e le na̱ ɗanga vu biri,</para>
  <para style="q2" vid="PSA 105:33">reve u kototo a akapi</para>
  <para style="q2" vid="PSA 105:33">a ɗanga vi iɗa'a suru.<verse eid="PSA 105:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34" />U yuwan ta̱ adanshi,</para>
  <para style="q2" vid="PSA 105:34">reve apapari a̱ ta̱wa̱ babu utyo,<verse eid="PSA 105:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35" />reve a tama a̱vu'un a na a̱ ri e iɗa suru,</para>
  <para style="q2" vid="PSA 105:35">a tama itana yu a̱ɗuma̱ yi iɗa i le.<verse eid="PSA 105:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36" />Wu ga̱la̱ ta̱ muwun mu ufaru mi iɗa'a suru,</para>
  <para style="q2" vid="PSA 105:36">muwun mu ufaru n lipu vali.<verse eid="PSA 105:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37" />Wu uta̱a̱ ta̱ aza a Isra'ila,</para>
  <para style="q2" vid="PSA 105:37">utanuwu na̱ azurufa na̱ zinariya,</para>
  <para style="q2" vid="PSA 105:37">babu arambi a̱tsuma̱ e elentsu e le.<verse eid="PSA 105:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38" />Masar yuwan ta̱ ma̱za̱nga̱ a na a̱ ka̱ra̱i,</para>
  <para style="q2" vid="PSA 105:38">adama a na wovon wa aza a Isra'ila u reme le ta̱.<verse eid="PSA 105:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39" />Wu ba̱ruwa̱ ta̱ eleshe tsa apalutsu,</para>
  <para style="q2" vid="PSA 105:39">akina waru adama u ca ekan na ayin.<verse eid="PSA 105:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40" />A pati ta̱ a̱vu a ca le nroni</para>
  <para style="q2" vid="PSA 105:40">reve waru a̱ cuwa̱ton le no opopofu diga zuva.<verse eid="PSA 105:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41" />U kpa̱tu'wa̱ ta̱ aatali,</para>
  <para style="q2" vid="PSA 105:41">reve mini mo o uta̱,</para>
  <para style="q1" vid="PSA 105:41">e ilaɗi cine vu revei uɗolu</para>
  <para style="q2" vid="PSA 105:41">u tsu yene a̱ a̱tsumona.<verse eid="PSA 105:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42" />Adama a na u cuwain na akucunu a akiza a̱ yi</para>
  <para style="q2" vid="PSA 105:42">a na u yuwayin aagbashi a̱ yi Ibrahim.<verse eid="PSA 105:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43" />Wu uta̱a̱ ta̱ ama a̱ yi na̱ ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 105:43">aza a na u ɗangwai ni ishipa i mere.<verse eid="PSA 105:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44" />U ca le ta̱ nɗa ma atakpaci,</para>
  <para style="q2" vid="PSA 105:44">a̱vu a̱ pura̱ utsuru wa̱ a̱tsuma̱lima̱</para>
  <para style="q2" vid="PSA 105:44">a na ozo o ro o sowoi.<verse eid="PSA 105:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45" />Tsa̱ra̱ o toni ili i na u dammai</para>
  <para style="q2" vid="PSA 105:45">na̱ wila̱ wa̱ yi.</para>
  <para style="b" vid="PSA 105:45" />
  <para style="q" vid="PSA 105:45">I cuwa A̱sulazuva.<verse eid="PSA 105:45" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" sid="PSA 106" />
  <para style="s">Isa'ani ya̱ A̱sulazuva a̱ tyo uba̱ta̱ wa ama a̱ yi</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1" />I cuwa A̱sulazuva!</para>
  <para style="q2" vid="PSA 106:1">I godyo A̱sulazuva,</para>
  <para style="q2" vid="PSA 106:1">adama e isa'ani ya̱ yi,</para>
  <para style="q1" vid="PSA 106:1">adama a na icigi ya̱ yi i na i tsu vadala shi</para>
  <para style="q2" vid="PSA 106:1">i ta̱ lo hali hali.<verse eid="PSA 106:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2" />Zane ɗa a gura damma</para>
  <para style="q2" vid="PSA 106:2">linga gbagbain va̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 106:2">ko u gura cuwa yi?<verse eid="PSA 106:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3" />A̱za̱ a̱ ma̱za̱nga̱ a ɗa</para>
  <para style="q2" vid="PSA 106:3">aza a na e isawaan yi a amayun,</para>
  <para style="q2" vid="PSA 106:3">aza a na a yuwusan mejege mantsa suru.<verse eid="PSA 106:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4" />A̱sulazuva, vu cuwan na̱ a̱mu</para>
  <para style="q2" vid="PSA 106:4">na̱ vu roco isa'ani a̱ tyo uba̱ta̱ wa ama a̱ wu,</para>
  <para style="q1" vid="PSA 106:4">vu kamba mu A̱sulazuva</para>
  <para style="q2" vid="PSA 106:4">na̱ vu wawa le,<verse eid="PSA 106:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5" />tsa̱ra̱ mu uwwa uyo'o wu ulyuwu wa aci</para>
  <para style="q2" vid="PSA 106:5">wa aza a na vu ɗangwai,</para>
  <para style="q1" vid="PSA 106:5">n yuwan ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 106:5">oɓolo na ama a̱ wu,</para>
  <para style="q1" vid="PSA 106:5">reve n uwa a̱ a̱tsuma̱</para>
  <para style="q2" vid="PSA 106:5">a agadu a̱ wu ni ica.<verse eid="PSA 106:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6" />Tsu yuwan ta̱ unusu</para>
  <para style="q2" vid="PSA 106:6">cine nkaya n tsu n yuwain,</para>
  <para style="q1" vid="PSA 106:6">tsu yuwan ta̱ ili i babu ulobonu,</para>
  <para style="q2" vid="PSA 106:6">reve tsu yuwan iwuya.<verse eid="PSA 106:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7" />Ana nkaya ntsu n da̱na̱i a Masar,</para>
  <para style="q2" vid="PSA 106:7">a̱ ka̱mbuwa̱ ugbozu e ili ya asalama a̱ wu shi.</para>
  <para style="q1" vid="PSA 106:7">Waru a cuwan,</para>
  <para style="q2" vid="PSA 106:7">ni icigi ya̱ wu i na i tsu vadala shi.</para>
  <para style="q1" vid="PSA 106:7">Reve a̱ 'ya̱sa̱a̱n wu aci,</para>
  <para style="q2" vid="PSA 106:7">zuzu na̱ Mala ma̱ Shili.<verse eid="PSA 106:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8" />Na̱ ne suru u wawa le ta̱</para>
  <para style="q2" vid="PSA 106:8">adama a ala a̱ yi,</para>
  <para style="q1" vid="PSA 106:8">tsa̱ra̱ u revetyo</para>
  <para style="q2" vid="PSA 106:8">a̱a̱ba̱jini ucira wa̱ yi.<verse eid="PSA 106:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9" />U ɓara ta̱ Mala ma̱ Shili,</para>
  <para style="q2" vid="PSA 106:9">reve u 'yewe,</para>
  <para style="q1" vid="PSA 106:9">reve u pasato le a mala</para>
  <para style="q2" vid="PSA 106:9">cine vu revei iɗa yu u'yewu.<verse eid="PSA 106:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10" />U wawa le ta̱</para>
  <para style="q2" vid="PSA 106:10">e ekere a n'yuwatan,</para>
  <para style="q1" vid="PSA 106:10">diga e ekere a n'yuwatan n ɗa</para>
  <para style="q2" vid="PSA 106:10">u wawa nle.<verse eid="PSA 106:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11" />Reve mini ma lyuwa n'yuwatan n le,</para>
  <para style="q2" vid="PSA 106:11">ko vuma ta̱ la'a shi.<verse eid="PSA 106:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12" />Ɗaɗa a̱ usuyi nzuwulai ma̱ yi,</para>
  <para style="q2" vid="PSA 106:12">reve a canaa yi ishipa yi ica.<verse eid="PSA 106:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13" />A jima shi</para>
  <para style="q2" vid="PSA 106:13">ɗaɗa e icinai na̱ linga va̱ yi,</para>
  <para style="q2" vid="PSA 106:13">waru o puro a̱sa̱la̱ a̱ yi shi.<verse eid="PSA 106:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14" />Reve utsa̱n u tsura̱ le a̱ a̱tsumona,</para>
  <para style="q2" vid="PSA 106:14">ɗaɗa gba a̱ lyungwa̱i A̱sula̱ uba̱ta̱'a̱.<verse eid="PSA 106:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15" />Ɗaɗa u ca nle</para>
  <para style="q2" vid="PSA 106:15">ili i na a patiyi,</para>
  <para style="q1" vid="PSA 106:15">amma a̱vu u lyunguwa̱a̱ le</para>
  <para style="q2" vid="PSA 106:15">na̱ mɓa̱la̱ n wuya.<verse eid="PSA 106:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16" />A̱vu a uwa tsushu'un na̱ Musa o uva̱la̱ta̱,</para>
  <para style="q2" vid="PSA 106:16">oɓolo na̱ Haruna za na a̱ A̱sulazuva a tawai.<verse eid="PSA 106:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17" />Reve iɗa i kpa̱tu'wa̱ una̱ u soɗu Datan,</para>
  <para style="q2" vid="PSA 106:17">reve u ciɗo oɓolo a ama a Abiram.<verse eid="PSA 106:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18" />Reve waru akina a̱ cipa̱ a̱ kula̱to</para>
  <para style="q2" vid="PSA 106:18">aza a na a̱ da̱na̱i oɓolo ne le,</para>
  <para style="q2" vid="PSA 106:18">a̱vu u kula̱to a̱za̱ e iwuya o ndolo.<verse eid="PSA 106:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19" />A yuwan ta̱ iroci</para>
  <para style="q2" vid="PSA 106:19">i ma̱dindim ɗe Horeb,</para>
  <para style="q1" vid="PSA 106:19">reve a yuwaan a̱ma̱li</para>
  <para style="q2" vid="PSA 106:19">a na a̱ zuɗa̱i a̱ga̱nda̱.<verse eid="PSA 106:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20" />A vadala ta̱ tsugbain tsa̱ A̱sula̱</para>
  <para style="q2" vid="PSA 106:20">a̱ tyo o ogono a nan na a rumai,</para>
  <para style="q2" vid="PSA 106:20">na tsu tama anlya.<verse eid="PSA 106:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21" />E icina ta̱ na̱ A̱sula̱</para>
  <para style="q2" vid="PSA 106:21">a na a wawa nle,</para>
  <para style="q1" vid="PSA 106:21">za na yuwain a̱ba̱jini a̱ba̱jini e ili</para>
  <para style="q2" vid="PSA 106:21">a̱tsuma̱ a Masar,<verse eid="PSA 106:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22" />ili ya asalama e iɗa ya Ham</para>
  <para style="q2" vid="PSA 106:22">reve waru u yuwan ili i wovon</para>
  <para style="q2" vid="PSA 106:22">o una̱ u Mala ma̱ Shili.<verse eid="PSA 106:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23" />Ɗaɗa u dammai u to kototo le,</para>
  <para style="q2" vid="PSA 106:23">ana Musa za na A̱sula̱ a ɗangwai</para>
  <para style="q1" vid="PSA 106:23">e isawaan nle e memere</para>
  <para style="q2" vid="PSA 106:23">ɗaɗa u bula̱i upan u na woo kototo le.<verse eid="PSA 106:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24" />Reve a 'yuwan iɗa i sa'ani'i,</para>
  <para style="q2" vid="PSA 106:24">agba a̱ usu nzuwulai ma̱ yi shi.<verse eid="PSA 106:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25" />A̱vu fo a yuwan adanshi</para>
  <para style="q2" vid="PSA 106:25">a awuya o ogodo e le,</para>
  <para style="q2" vid="PSA 106:25">waru a yuwan tsutoni na̱ A̱sulazuva shi.<verse eid="PSA 106:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26" />Ɗaɗa gba u 'ya̱sa̱in ukere wa̱ yi</para>
  <para style="q2" vid="PSA 106:26">a̱vu u kucinaa le,</para>
  <para style="q1" vid="PSA 106:26">ana u ta zuwa le,</para>
  <para style="q2" vid="PSA 106:26">a̱ kuwa̱ a̱tsumona.<verse eid="PSA 106:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27" />Waru u ta bete'we le</para>
  <para style="q2" vid="PSA 106:27">a nɗa n na n ri a̱za̱ le shi,</para>
  <para style="q1" vid="PSA 106:27">a̱vu u zuwa gundo le</para>
  <para style="q2" vid="PSA 106:27">kuwa̱ a̱tsuma̱ a nɗa.<verse eid="PSA 106:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28" />A̱vu o oɓolo aci e teme a yuwusaan</para>
  <para style="q2" vid="PSA 106:28">Ba'al va Peyo a̱ga̱nda̱,</para>
  <para style="q1" vid="PSA 106:28">reve a lyuwa kucci</para>
  <para style="q2" vid="PSA 106:28">na a cayi musula̱.<verse eid="PSA 106:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29" />A̱vu a zuwa A̱sulazuva a yuwan upan</para>
  <para style="q2" vid="PSA 106:29">adama e iwuya i na a yuwain,</para>
  <para style="q2" vid="PSA 106:29">reve mɓa̱la̱ n uwa a̱tsuma̱ e le.<verse eid="PSA 106:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30" />Agba Finiha 'yon ta̱</para>
  <para style="q2" vid="PSA 106:30">wi isawan mishin,</para>
  <para style="q2" vid="PSA 106:30">avu mɓa̱la̱'a̱ n koto.<verse eid="PSA 106:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31" />Adama o ndolo a ɗa</para>
  <para style="q2" vid="PSA 106:31">aa cuwusan na̱ a̱ɓula̱ yi</para>
  <para style="q2" vid="PSA 106:31">diga mantsa a̱ tyo a mantsa hali hali.<verse eid="PSA 106:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32" />A zuwa ta̱ A̱sulazuva a yuwan upan</para>
  <para style="q2" vid="PSA 106:32">o uɗolu wa Meriba,</para>
  <para style="q1" vid="PSA 106:32">reve addama</para>
  <para style="q2" vid="PSA 106:32">a cina Musa adama e le,<verse eid="PSA 106:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33" />adama a na a̱ 'ya̱sa̱a̱n ta̱</para>
  <para style="q2" vid="PSA 106:33">Ruhu va̱ A̱sula̱ a aci,</para>
  <para style="q1" vid="PSA 106:33">reve adanshi a babu uyo'o</para>
  <para style="q2" vid="PSA 106:33">o uta̱ o una̱ wa Musa.<verse eid="PSA 106:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34" />O kototo nɗa'a</para>
  <para style="q2" vid="PSA 106:34">cine A̱sulazuva a damma nle shi,<verse eid="PSA 106:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35" />amma a yuwan ta̱</para>
  <para style="q2" vid="PSA 106:35">muwwulai na̱ nɗa,</para>
  <para style="q2" vid="PSA 106:35">reve waru a tara agadu e le.<verse eid="PSA 106:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36" />A yuwaan ta̱ a̱ma̱li a nɗa'a a̱ga̱nda̱,</para>
  <para style="q2" vid="PSA 106:36">a̱vu wo o'wo le maza.<verse eid="PSA 106:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37" />A ca ta̱ olobo ne esheli le kucci</para>
  <para style="q2" vid="PSA 106:37">uba̱ta̱ u musula̱ mu nɗa'a.<verse eid="PSA 106:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38" />O oco ta̱ mpasa m babu unusu,</para>
  <para style="q2" vid="PSA 106:38">mpasa mo olobo e le ne esheli e le,</para>
  <para style="q1" vid="PSA 106:38">za na a cayi kucci</para>
  <para style="q2" vid="PSA 106:38">uba̱ta̱ wa̱ a̱ma̱li wa aza a Ka'ana,</para>
  <para style="q2" vid="PSA 106:38">waru a̱ lungusa̱ ta̱ iɗa'a na̱ mpasa n le.<verse eid="PSA 106:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39" />A̱ lungusa̱ ta̱ aciyele</para>
  <para style="q2" vid="PSA 106:39">a̱tsuma̱ e ili i na a yuwusan,</para>
  <para style="q1" vid="PSA 106:39">linga le vo o'wo ta̱</para>
  <para style="q2" vid="PSA 106:39">tsushakala e ekere e le.<verse eid="PSA 106:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40" />Reve A̱sulazuva a yuwan</para>
  <para style="q2" vid="PSA 106:40">upan na ama a̱ yi</para>
  <para style="q1" vid="PSA 106:40">a̱vu o o'wo ili yi idaba</para>
  <para style="q2" vid="PSA 106:40">e ekere a̱ yi.<verse eid="PSA 106:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41" />A̱vu u ca le e ekere a nɗa,</para>
  <para style="q2" vid="PSA 106:41">a̱vu n'yuwatan n le</para>
  <para style="q2" vid="PSA 106:41">n yuwan tsugbain a aci e le.<verse eid="PSA 106:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42" />A̱vu n'yuwatan n le n ɓongi le</para>
  <para style="q2" vid="PSA 106:42">reve a zuwa le za̱la̱ vu ucira u le.<verse eid="PSA 106:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43" />U tsu wawa le ta̱ mantsa na̱ a̱bunda̱,</para>
  <para style="q2" vid="PSA 106:43">amma a la'a ta̱ ciga a̱ 'ya̱sa̱sa̱n aci,</para>
  <para style="q2" vid="PSA 106:43">a̱vu a ca le oforo adama o unusu u le.<verse eid="PSA 106:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44" />Na̱ ne suru u tsee ene ta̱ atakaci e le</para>
  <para style="q2" vid="PSA 106:44">mantsa ma na wu uwwai mesun me le,<verse eid="PSA 106:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45" />a̱vu u cuwan na akucunu a̱ yi ne le,</para>
  <para style="q2" vid="PSA 106:45">waru a̱tsuma̱ e icigi ya̱ yi i na i tsu vadala shi</para>
  <para style="q2" vid="PSA 106:45">u tsa̱ e ene ta̱ iliyali i le.<verse eid="PSA 106:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46" />U zuwa ta̱ aza a na</para>
  <para style="q2" vid="PSA 106:46">a̱ guza̱ nle tsa agbashi,</para>
  <para style="q2" vid="PSA 106:46">e ene iliyali i le.<verse eid="PSA 106:46" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47" />A̱sulazuva A̱sula̱ a̱ tsu,</para>
  <para style="q2" vid="PSA 106:47">wawa tsu,</para>
  <para style="q1" vid="PSA 106:47">reve vu ɓoloto tsu diga a nɗa,</para>
  <para style="q2" vid="PSA 106:47">tsa̱ra̱ tsu godyoo ala a akiza a̱ wu</para>
  <para style="q2" vid="PSA 106:47">waru tsu yuwaan wu ica.<verse eid="PSA 106:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48" />Tsu yuwayin A̱sulazuva ica,</para>
  <para style="q2" vid="PSA 106:48">A̱sula̱ aza a Isra'ila,</para>
  <para style="q1" vid="PSA 106:48">diga gogo a̱ tyo hali hali.</para>
  <para style="q2" vid="PSA 106:48">Lyawa ama suru a damma, &lt;&lt;Ami!&gt;&gt;</para>
  <para style="b" vid="PSA 106:48" />
  <para style="q1" vid="PSA 106:48">Cuwai A̱sulazuva!<verse eid="PSA 106:48" /></para>
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" sid="PSA 107" />
  <para style="ms">Aatagada a tawun</para>
  <para style="mr">(<ref loc="PSA 107-150">Ica 107-150</ref>)</para>
  <para style="s">Ishipa yu ugodyusho adama e isa'ani ya̱ A̱sula̱</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1" />I godyoo A̱sulazuva,</para>
  <para style="q2" vid="PSA 107:1">adama e isa'ani ya̱ yi,</para>
  <para style="q1" vid="PSA 107:1">adama a na icigi ya̱ yi i na i tsu vadala shi</para>
  <para style="q2" vid="PSA 107:1">i ta̱ lo hali hali.<verse eid="PSA 107:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2" />Lyawa aza a na A̱sulazuva</para>
  <para style="q2" vid="PSA 107:2">a tsupayi a damma,</para>
  <para style="q1" vid="PSA 107:2">ele na a wawai</para>
  <para style="q2" vid="PSA 107:2">diga e ekere a n'yuwatan,<verse eid="PSA 107:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3" />aza a na u ɓolotoi diga a nɗa,</para>
  <para style="q2" vid="PSA 107:3">diga asana na̱ a̱livu, ugana nu uyagi.<verse eid="PSA 107:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4" />Aza a Isra'ila a̱ da̱na̱ ta̱</para>
  <para style="q2" vid="PSA 107:4">e igaru a̱tsumona,</para>
  <para style="q1" vid="PSA 107:4">a̱ tsura̱ ure a̱ 'ya̱wa̱</para>
  <para style="q2" vid="PSA 107:4">a̱ lyuci na a̱ da̱nu shi.<verse eid="PSA 107:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5" />A uwwusa ta̱ ambulu na akuli,</para>
  <para style="q2" vid="PSA 107:5">hali a̱ ciga ma̱kuwa̱a̱.<verse eid="PSA 107:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6" />A̱vu e showen A̱sulazuva</para>
  <para style="q2" vid="PSA 107:6">adama a̱tsuma̱lima̱ e le,</para>
  <para style="q1" vid="PSA 107:6">ɗaɗa u wawa nle</para>
  <para style="q2" vid="PSA 107:6">a addama e le.<verse eid="PSA 107:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7" />U toni ta̱ ne ele nu ure u na wuntsayi</para>
  <para style="q2" vid="PSA 107:7">a̱ tyo a̱ lyuci uba̱ta̱ u na a̱a̱ da̱nu.<verse eid="PSA 107:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8" />Lyawa le o godyowo A̱sulazuva</para>
  <para style="q2" vid="PSA 107:8">adama e icigi ya̱ yi i na i tsu vadala shi,</para>
  <para style="q2" vid="PSA 107:8">na̱ linga va asalama a̱ yi uba̱ta̱ wa ama,<verse eid="PSA 107:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9" />adama a na u tsu ca ta̱</para>
  <para style="q2" vid="PSA 107:9">ama na a̱ ri na akuli mini,</para>
  <para style="q1" vid="PSA 107:9">waru u cuwa̱ton aza a</para>
  <para style="q2" vid="PSA 107:9">ambulu ni ili i sa'ani.<verse eid="PSA 107:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10" />Aza a Isra'ila a̱ da̱nu ta̱ e irumbu</para>
  <para style="q2" vid="PSA 107:10">no o ululu wu ukwisa̱,</para>
  <para style="q2" vid="PSA 107:10">agbashi a̱tsuma̱ a̱tsuma̱lima̱ na akani,<verse eid="PSA 107:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11" />adama a na a̱ 'ya̱sa̱a̱n ta̱ adanshi a̱ A̱sula̱ a aci,</para>
  <para style="q2" vid="PSA 107:11">a̱vu o goro a̱sa̱la̱ o Mogono ma̱ A̱sula̱.<verse eid="PSA 107:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12" />A̱vu A̱sulazuva a zuwa le</para>
  <para style="q2" vid="PSA 107:12">ulinga wu usa̱n lon,</para>
  <para style="q2" vid="PSA 107:12">a̱vu a̱ riya̱,</para>
  <para style="q2" vid="PSA 107:12">agba babu za na a kamba le.<verse eid="PSA 107:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13" />A̱vu e showen A̱sulazuva</para>
  <para style="q2" vid="PSA 107:13">adama a̱tsuma̱lima̱ e le,</para>
  <para style="q1" vid="PSA 107:13">ɗaɗa u wawa nle</para>
  <para style="q2" vid="PSA 107:13">a addama e le.<verse eid="PSA 107:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14" />A̱vu wu uta̱a̱ le a̱tsuma̱ e irumbu</para>
  <para style="q2" vid="PSA 107:14">no o ure wu ukwa̱</para>
  <para style="q2" vid="PSA 107:14">reve wu kasa akani e le.<verse eid="PSA 107:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15" />Lyawa le o godyowo A̱sulazuva</para>
  <para style="q2" vid="PSA 107:15">adama e icigi ya̱ yi i na i tsu vadala shi,</para>
  <para style="q2" vid="PSA 107:15">na̱ linga va asalama a̱ yi uba̱ta̱ wa ama,<verse eid="PSA 107:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16" />adama a na wu kuɗa ta̱</para>
  <para style="q2" vid="PSA 107:16">na̱ntsu vi irumushili</para>
  <para style="q1" vid="PSA 107:16">reve fo wu kuɗa</para>
  <para style="q2" vid="PSA 107:16">irumu i megeshe vu na̱ntsu.<verse eid="PSA 107:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17" />Aza a Isra'ila o o'wo ta̱ olo</para>
  <para style="q2" vid="PSA 107:17">adama aciyogbamu e le,</para>
  <para style="q1" vid="PSA 107:17">a̱vu o sowo awuya</para>
  <para style="q2" vid="PSA 107:17">adama a̱ nusu le.<verse eid="PSA 107:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18" />Waru a buwa a maluwa me ilyalya shi,</para>
  <para style="q2" vid="PSA 107:18">hali a rawa zuzu nu ukwa̱.<verse eid="PSA 107:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19" />A̱vu e showen A̱sulazuva</para>
  <para style="q2" vid="PSA 107:19">adama a̱tsuma̱lima̱ e le,</para>
  <para style="q1" vid="PSA 107:19">ɗaɗa u wawa nle</para>
  <para style="q2" vid="PSA 107:19">a addama e le.<verse eid="PSA 107:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20" />A̱vu u lyungu danshi va̱ yi,</para>
  <para style="q2" vid="PSA 107:20">a̱vu u yuwaan le opocino,</para>
  <para style="q2" vid="PSA 107:20">a̱vu u wawa le diga o ukototosu.<verse eid="PSA 107:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21" />Lyawa le o godyowo A̱sulazuva</para>
  <para style="q2" vid="PSA 107:21">adama e icigi ya̱ yi i na i tsu vadala shi,</para>
  <para style="q2" vid="PSA 107:21">na̱ linga va asalama a̱ yi uba̱ta̱ wa ama,<verse eid="PSA 107:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22" />lyawa le a ca kucci vu ugodyusho,</para>
  <para style="q2" vid="PSA 107:22">waru a damma linga va̱ yi</para>
  <para style="q2" vid="PSA 107:22">ni ishipa i ma̱za̱nga̱.<verse eid="PSA 107:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23" />Ozo o ro a̱ da̱na̱ ta̱ a mmalu</para>
  <para style="q2" vid="PSA 107:23">a mala a antsun,</para>
  <para style="q1" vid="PSA 107:23">a yuwusan atsulu na awina</para>
  <para style="q2" vid="PSA 107:23">a̱ mini ma gbain.<verse eid="PSA 107:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24" />E ene ta̱ linga va̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 107:24">na̱ linga va asalama a̱ yi a̱ mini,<verse eid="PSA 107:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25" />u yuwan ta̱ adanshi</para>
  <para style="q2" vid="PSA 107:25">a̱vu upepu wu ucira u 'yon,</para>
  <para style="q2" vid="PSA 107:25">u 'ya̱sa̱n ikeɗu i mala,<verse eid="PSA 107:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26" />a̱ 'yon ta̱ zuva</para>
  <para style="q2" vid="PSA 107:26">reve a̱ riya̱ uba̱ta̱ wa̱ a̱ru'un</para>
  <para style="q1" vid="PSA 107:26">okolo e le a kuɗa ta̱</para>
  <para style="q2" vid="PSA 107:26">adama a̱ a̱tsuma̱lima̱.<verse eid="PSA 107:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27" />A̱vu a̱ ka̱ra̱ a̱ ta̱ɗa̱tsa̱sa̱ a takalyusa</para>
  <para style="q2" vid="PSA 107:27">cine vu revei aza a na a̱ ri usowu,</para>
  <para style="q1" vid="PSA 107:27">nu ugbozu u le suru</para>
  <para style="q2" vid="PSA 107:27">e reve ili i na a yuwusan shi.<verse eid="PSA 107:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28" />A̱vu e showen A̱sulazuva</para>
  <para style="q2" vid="PSA 107:28">adama a̱tsuma̱lima̱ e le,</para>
  <para style="q2" vid="PSA 107:28">ɗaɗa wu uta̱a̱ nle a addama e le.<verse eid="PSA 107:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29" />U zuwa ta̱ upepu wu ucira'a wi isawan kwin</para>
  <para style="q2" vid="PSA 107:29">oɓolo ni ikeɗu i mini i mala.<verse eid="PSA 107:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30" />A yuwan ta̱ ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 107:30">a na uba̱ta̱ u fa̱la̱i,</para>
  <para style="q2" vid="PSA 107:30">a̱vu u tyewoto le a̱ nge'en m mala.<verse eid="PSA 107:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31" />Lyawa le o godyowo A̱sulazuva</para>
  <para style="q2" vid="PSA 107:31">adama e icigi ya̱ yi i na i tsu vadala shi,</para>
  <para style="q2" vid="PSA 107:31">na̱ linga va asalama a̱ yi uba̱ta̱ wa ama,<verse eid="PSA 107:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32" />lyawa a ca yi tsugbain</para>
  <para style="q2" vid="PSA 107:32">e iɓolo ya ama,</para>
  <para style="q1" vid="PSA 107:32">waru a cuwa yi a̱tsuma̱</para>
  <para style="q2" vid="PSA 107:32">e iɓolo ya azagbain.<verse eid="PSA 107:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33" />U ka̱mba̱to ta̱ ɗolu</para>
  <para style="q2" vid="PSA 107:33">o o'wo a̱tsumona,</para>
  <para style="q2" vid="PSA 107:33">esu a̱ mini waru iɗa yu u'yewu,<verse eid="PSA 107:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34" />iɗa yu umili waru iɗa ya akpaɗi</para>
  <para style="q2" vid="PSA 107:34">adama e iwuya ya aza a na a̱ ri na̱ nden pe.<verse eid="PSA 107:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35" />U ka̱mba̱to ta̱ a̱tsumona o o'wo ɗolu</para>
  <para style="q2" vid="PSA 107:35">iɗa yu u'yewu waru esu a̱ mini.<verse eid="PSA 107:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36" />A̱vu u lyawa aza a ambulu a̱ da̱nu pe,</para>
  <para style="q2" vid="PSA 107:36">a̱vu a̱ shuwa̱ lyuci na a̱a̱ da̱nu pe.<verse eid="PSA 107:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37" />A̱ tsu cu'wa̱n ta̱ a̱ɗuma̱ a̱ inabi a atsusa</para>
  <para style="q2" vid="PSA 107:37">a̱vu a matsan ulobonu.<verse eid="PSA 107:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38" />U zuwaa le ta̱ aba'un</para>
  <para style="q2" vid="PSA 107:38">a̱vu a yuwan a̱bunda̱ lon,</para>
  <para style="q2" vid="PSA 107:38">u lyawa iliyamunga i le i ka̱mba̱ a̱ca̱pa̱ shi.<verse eid="PSA 107:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39" />A mantsa ma na a̱bunda̱ e le e jebe yi</para>
  <para style="q2" vid="PSA 107:39">reve n'yuwatan n le n ka̱ɗa̱to le</para>
  <para style="q2" vid="PSA 107:39">ni ɓongishi i iwuya na̱ a̱tsuma̱lima̱,<verse eid="PSA 107:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40" />reve A̱sula̱ a ca aza a na o ɓongi yi</para>
  <para style="q2" vid="PSA 107:40">ama a̱ yi'i wono,</para>
  <para style="q1" vid="PSA 107:40">a̱vu u lyawa le a̱ da̱na̱ e igaru</para>
  <para style="q2" vid="PSA 107:40">a̱tsumona uba̱tu u na babu ure.<verse eid="PSA 107:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41" />Agba u 'ya̱sa̱n ta̱ alambi</para>
  <para style="q2" vid="PSA 107:41">a̱tsuma̱ a̱tsuma̱lima̱ e le</para>
  <para style="q1" vid="PSA 107:41">a̱vu waru u da̱shi limatan le a̱bunda̱</para>
  <para style="q2" vid="PSA 107:41">cine vu revei o oɓolo e inan.<verse eid="PSA 107:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42" />A̱za̱ a̱ a̱ɓula̱ a̱ tse ene ta̱</para>
  <para style="q2" vid="PSA 107:42">a̱vu a yuwan ma̱za̱nga̱,</para>
  <para style="q1" vid="PSA 107:42">amma a̱za̱ e iwuya suru</para>
  <para style="q2" vid="PSA 107:42">a̱ tsu ɓa̱ru ta̱ na̱ le.<verse eid="PSA 107:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43" />Za na ri nu ugbozu suru,</para>
  <para style="q2" vid="PSA 107:43">lyawa u zuwa atsuvu e ili i nda</para>
  <para style="q1" vid="PSA 107:43">waru u ka̱mbuwa̱ ugbozu</para>
  <para style="q2" vid="PSA 107:43">e icigi ya̱ A̱sulazuva a na a tsu vadala shi.<verse eid="PSA 107:43" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" sid="PSA 108" />
  <para style="s">Avasa e izami yi ikambishi ya̱ A̱sula̱</para>
  <para style="d">Ica ya̱ Da̱wuda. Ishipa i ɗa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1" />A̱sula̱, Okolo a̱ va̱ a kuɗa shi,</para>
  <para style="q2" vid="PSA 108:1">n ta cana reve n yuwan tsuwe'e</para>
  <para style="q2" vid="PSA 108:1">na̱ wuma u va̱ suru.<verse eid="PSA 108:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2" />Juwan, igaraya na̱ kumburu!</para>
  <para style="q2" vid="PSA 108:2">Tsu jisan usana.<verse eid="PSA 108:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3" />A̱sulazuva, n ta cuwa wu,</para>
  <para style="q2" vid="PSA 108:3">a̱tsuma̱ a nɗa,</para>
  <para style="q1" vid="PSA 108:3">n ta canaa wu ishipa</para>
  <para style="q2" vid="PSA 108:3">a̱tsuma̱ a ama.<verse eid="PSA 108:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4" />Adama a na a̱bunda̱</para>
  <para style="q2" vid="PSA 108:4">e icigi ya̱ wu i na i tsu vadala shi</para>
  <para style="q2" vid="PSA 108:4">i rawa ta̱ zuva,</para>
  <para style="q1" vid="PSA 108:4">a̱ɓula̱ a̱ wu</para>
  <para style="q2" vid="PSA 108:4">a rawa ta̱ eleshe.<verse eid="PSA 108:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5" />A̱sula̱, lyawa a cuwa wu ɗe zuva,</para>
  <para style="q2" vid="PSA 108:5">lyawa tsugbain tsa̱ wu tsa̱ da̱na̱ o uvaɗi ma̱ɓula̱.<verse eid="PSA 108:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6" />Vu wawa tsu,</para>
  <para style="q2" vid="PSA 108:6">a̱vu vu kamba tsu</para>
  <para style="q2" vid="PSA 108:6">nu ukere wa̱ wu.</para>
  <para style="q1" vid="PSA 108:6">Adama aza a na vu ri e icigi</para>
  <para style="q2" vid="PSA 108:6">a̱ tsura̱ iwawi.<verse eid="PSA 108:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7" />A̱sula̱ a yuwan ta̱ adanshi</para>
  <para style="q2" vid="PSA 108:7">diga uba̱ta̱ wa akiza a̱ yi,</para>
  <para style="q1" vid="PSA 108:7">u damma &lt;&lt;Nu ulyuwu wa aci u ɗa</para>
  <para style="q2" vid="PSA 108:7">me ne'eshe Shekem</para>
  <para style="q2" vid="PSA 108:7">a̱vu n rito Uka̱ri wa̱ Sukot.<verse eid="PSA 108:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8" />Upasu wa Giliyadu za va̱ ɗa,</para>
  <para style="q2" vid="PSA 108:8">Manase fo za va̱ ɗa,</para>
  <para style="q1" vid="PSA 108:8">Ifiramu ɗa eegbezu a̱ rumu a̱ va̱,</para>
  <para style="q2" vid="PSA 108:8">Yahuza waru aɗanga o tsugono tsa̱ va̱.<verse eid="PSA 108:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9" />Amma n to o'wo oto iɗa ya Mowa asa'atsu a̱ va̱,</para>
  <para style="q2" vid="PSA 108:9">Edom waru uba̱ta̱ u na maa varishi atan a̱ va̱,</para>
  <para style="q1" vid="PSA 108:9">n ta yuwan yisaali yu ulyuwu wa aci</para>
  <para style="q2" vid="PSA 108:9">a aci aza a Filistiya.&gt;&gt;<verse eid="PSA 108:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10" />Zane ɗa a̱ 'ya̱wa̱to mu</para>
  <para style="q2" vid="PSA 108:10">a̱ lyuci vu ukari wu ucira?</para>
  <para style="q1" vid="PSA 108:10">Zane ɗa o rono mu aɗanga</para>
  <para style="q2" vid="PSA 108:10">a̱ tyo e iɗa ya̱ Edom?<verse eid="PSA 108:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11" />A̱sula̱, a̱vu ɗa vu 'yuwan ntsu,</para>
  <para style="q2" vid="PSA 108:11">a̱vu vu 'yuwan o uta̱</para>
  <para style="q2" vid="PSA 108:11">oɓolo na̱ a̱soja a̱ tsu shi?<verse eid="PSA 108:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12" />Vu yuwaan tsu ikambishi</para>
  <para style="q2" vid="PSA 108:12">e ekere a n'yuwatan,</para>
  <para style="q1" vid="PSA 108:12">adama a na ikambishi yi vaɗilima̱</para>
  <para style="q2" vid="PSA 108:12">ili ye pere i ɗa.<verse eid="PSA 108:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13" />Ni ikambishi ya̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 108:13">tsu ta lyuwa aci,</para>
  <para style="q2" vid="PSA 108:13">waru u ta dadasa n'yuwatan n tsu.<verse eid="PSA 108:13" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" sid="PSA 109" />
  <para style="s">Avasa adama A̱sula̱ a ca a̱za̱ e iwuya oforo</para>
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Ica ya̱ Da̱wuda. Ica i ɗa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1" />A̱sula̱ a na maa yuwusaan ica,</para>
  <para style="q2" vid="PSA 109:1">she vu rungwa̱ kpaku wan!<verse eid="PSA 109:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2" />Adama a na a̱za̱ e iwuya</para>
  <para style="q2" vid="PSA 109:2">na̱ a̱za̱ a̱ a̱lumu</para>
  <para style="q1" vid="PSA 109:2">a̱ kpa̱tu'wa̱ ta̱ na̱ le</para>
  <para style="q2" vid="PSA 109:2">a̱ nla̱ngi na̱ a̱mu,</para>
  <para style="q1" vid="PSA 109:2">a ta yuwusan adanshi avama a aci a̱ va̱</para>
  <para style="q2" vid="PSA 109:2">ne elentsu e epen.<verse eid="PSA 109:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3" />A̱ ka̱nda̱ruwa̱ mu ta̱</para>
  <para style="q2" vid="PSA 109:3">na adanshi a n'yuwunlai,</para>
  <para style="q2" vid="PSA 109:3">a̱vu a̱ riya̱a̱ mu babu ufaru.<verse eid="PSA 109:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4" />N roco le ta̱ icigi</para>
  <para style="q2" vid="PSA 109:4">agba a 'yuwan mu ta̱</para>
  <para style="q2" vid="PSA 109:4">amma a̱mu za va avasa a ɗa.<verse eid="PSA 109:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5" />A̱ tsu ka̱mbuwa̱ mu ta̱ ni iwuya</para>
  <para style="q2" vid="PSA 109:5">o una̱ wi isa'ani,</para>
  <para style="q1" vid="PSA 109:5">reve a 'yuwan mu</para>
  <para style="q2" vid="PSA 109:5">o una̱ wi icigi.<verse eid="PSA 109:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6" />A dansa, &lt;&lt;Vu ɗangwa za vi iwuya</para>
  <para style="q2" vid="PSA 109:6">na a yuwan nla̱ngi na̱ a̱yi.</para>
  <para style="q1" vid="PSA 109:6">Lyawa za na isawan niyi</para>
  <para style="q2" vid="PSA 109:6">'yuwan a damma mejege.<verse eid="PSA 109:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7" />Mantsa ma na e ge'eto niyi,</para>
  <para style="q2" vid="PSA 109:7">lyawa e reme yi nu unusu,</para>
  <para style="q1" vid="PSA 109:7">waru lyawa avasa a̱ yi</para>
  <para style="q2" vid="PSA 109:7">wo o'wo yi unusu.<verse eid="PSA 109:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8" />Lyawa rana va̱ yi</para>
  <para style="q2" vid="PSA 109:8">vo o'wo meketeci,</para>
  <para style="q1" vid="PSA 109:8">lyawa za ro tara</para>
  <para style="q2" vid="PSA 109:8">tsugbain tsa̱ yi.<verse eid="PSA 109:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9" />Lyawa muwun ma̱ yi</para>
  <para style="q2" vid="PSA 109:9">mo o'wo mkpa'an</para>
  <para style="q1" vid="PSA 109:9">ka va̱ yi fo</para>
  <para style="q2" vid="PSA 109:9">wo o'wo ma̱runa̱!<verse eid="PSA 109:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10" />Lyawa muwun ma̱ yi</para>
  <para style="q2" vid="PSA 109:10">mo o'wo aza a agara e ipati,</para>
  <para style="q1" vid="PSA 109:10">lyawa a̱ gba̱ra̱ le a 'wa le na ri okongo.<verse eid="PSA 109:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11" />Lyawa za na o tonoi utan</para>
  <para style="q2" vid="PSA 109:11">u usa ili i na u ri na̱ a̱ yi suru,</para>
  <para style="q1" vid="PSA 109:11">lyawa omocin a usa</para>
  <para style="q2" vid="PSA 109:11">melen ma̱ yi.<verse eid="PSA 109:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12" />She a̱ tsura̱ za na</para>
  <para style="q2" vid="PSA 109:12">o roco yi isa'ani wan,</para>
  <para style="q1" vid="PSA 109:12">ko a̱ ka̱lyuwa̱ mkpa'an ma̱ yi</para>
  <para style="q2" vid="PSA 109:12">ni iliyali wan.<verse eid="PSA 109:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13" />Lyawa ugundo wa̱ yi suru u koto,</para>
  <para style="q2" vid="PSA 109:13">hali e icina na ala e le a mantsa me elime.<verse eid="PSA 109:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14" />Lyawa a cuwan</para>
  <para style="q2" vid="PSA 109:14">na̱ nusu vu nkaya ma̱ yi</para>
  <para style="q2" vid="PSA 109:14">a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva,</para>
  <para style="q1" vid="PSA 109:14">waru she e icina na̱ nusu</para>
  <para style="q2" vid="PSA 109:14">va mma va̱ yi wan.<verse eid="PSA 109:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15" />Lyawa A̱sulazuva a cuwan</para>
  <para style="q2" vid="PSA 109:15">na̱ nusu nda mantsa suru,</para>
  <para style="q1" vid="PSA 109:15">tsa̱ra̱ u tawa majiyan ma̱ le</para>
  <para style="q2" vid="PSA 109:15">a̱tsuma̱ o uvaɗi.<verse eid="PSA 109:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16" />Adama a na u tsu cuwan</para>
  <para style="q2" vid="PSA 109:16">na waa yuwan isa'ani shi,</para>
  <para style="q1" vid="PSA 109:16">amma u tsu saɓa ta̱ alambi</para>
  <para style="q2" vid="PSA 109:16">na aza a na a cigai ikambishi</para>
  <para style="q1" vid="PSA 109:16">na aza a na okolo e le a kuɗai,</para>
  <para style="q2" vid="PSA 109:16">tsa̱ra̱ wu una le.<verse eid="PSA 109:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17" />U ciga ta̱ mayan mo una̱,</para>
  <para style="q2" vid="PSA 109:17">lyawa una̱ u toni yi,</para>
  <para style="q1" vid="PSA 109:17">u tsu yuwan ma̱za̱nga̱ na aba'un shi,</para>
  <para style="q2" vid="PSA 109:17">lyawa u yuwan alanga na̱ a̱ yi.<verse eid="PSA 109:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18" />Wo o'woto ta̱ wisulusa</para>
  <para style="q2" vid="PSA 109:18">cine vu revei utugu,</para>
  <para style="q1" vid="PSA 109:18">lyawa u re'weto yi</para>
  <para style="q2" vid="PSA 109:18">cine vu revei mini,</para>
  <para style="q1" vid="PSA 109:18">u uwa e etele a̱ yi</para>
  <para style="q2" vid="PSA 109:18">cine vu revei mani'in.<verse eid="PSA 109:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19" />Na amayun wisulusa wo o'woi yi ta̱ a̱tugu</para>
  <para style="q2" vid="PSA 109:19">o to o'wo tsa gbakala na wu nla̱i urana biti.&gt;&gt;<verse eid="PSA 109:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20" />Lyawa a̱yi nda wo o'wo</para>
  <para style="q2" vid="PSA 109:20">akunda atsupu a za na 'yuwan numu</para>
  <para style="q2" vid="PSA 109:20">diga uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q1" vid="PSA 109:20">a̱ tyo uba̱ta̱ wa aza a na a yuwusan</para>
  <para style="q2" vid="PSA 109:20">adanshi a avama a aci a̱ va̱.<verse eid="PSA 109:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21" />Amma a̱vu A̱sulazuva Zagbain,</para>
  <para style="q2" vid="PSA 109:21">vu toni na̱ a̱mu mejege</para>
  <para style="q2" vid="PSA 109:21">adama a ala a̱ wu,</para>
  <para style="q1" vid="PSA 109:21">a̱tsuma̱ e icigi ya̱ wu i na i tsu vadala shi,</para>
  <para style="q2" vid="PSA 109:21">vu wawa mu!<verse eid="PSA 109:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22" />Adama a na a̱mu</para>
  <para style="q2" vid="PSA 109:22">za vu ulambu ɗa</para>
  <para style="q2" vid="PSA 109:22">za na cigai ikambishi,</para>
  <para style="q1" vid="PSA 109:22">n ta uwwusa mɓa̱la̱</para>
  <para style="q2" vid="PSA 109:22">o okolo a̱ va̱.<verse eid="PSA 109:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23" />M puwa̱n ta̱ cine vu revei</para>
  <para style="q2" vid="PSA 109:23">ululu u tsu puwa̱n nu ulivu,</para>
  <para style="q1" vid="PSA 109:23">a̱ za̱ka̱tsa̱ mu ta̱</para>
  <para style="q2" vid="PSA 109:23">cine vu revei aapapari a na uta̱nu u guza̱i.<verse eid="PSA 109:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24" />A̱lu a̱ va̱ a̱ ɗa̱mba̱ ta̱</para>
  <para style="q2" vid="PSA 109:24">adama a akuli,</para>
  <para style="q1" vid="PSA 109:24">a̱vu lipu va̱ ramba</para>
  <para style="q2" vid="PSA 109:24">wo o'wo babu ucira.<verse eid="PSA 109:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25" />Mo o'wo ta̱ ili yi izo'oshi</para>
  <para style="q2" vid="PSA 109:25">uba̱ta̱ wa ama a na</para>
  <para style="q2" vid="PSA 109:25">a yuwusaan mu ulamu,</para>
  <para style="q1" vid="PSA 109:25">ne e ene mu</para>
  <para style="q2" vid="PSA 109:25">a̱vu a gbaɗatsasa aci e le.<verse eid="PSA 109:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26" />Kamba mu, A̱sulazuva A̱sula̱ a̱ va̱!</para>
  <para style="q2" vid="PSA 109:26">Vu wawa mu a̱tsuma̱ e icigi ya̱ i na i tsu vadala shi!<verse eid="PSA 109:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27" />A̱sulazuva! Lyawa n'yuwatan n va̱</para>
  <para style="q2" vid="PSA 109:27">n reve a na a̱vu ɗa</para>
  <para style="q2" vid="PSA 109:27">vu wawa numu.<verse eid="PSA 109:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28" />A ta gura yuwaan mu una̱,</para>
  <para style="q2" vid="PSA 109:28">amma vu ta zuwaa mu aba'un,</para>
  <para style="q1" vid="PSA 109:28">a mantsa ma na a̱ riya̱a̱ numu,</para>
  <para style="q2" vid="PSA 109:28">a ta uwwa wono,</para>
  <para style="q1" vid="PSA 109:28">amma aagbashi a̱ wu</para>
  <para style="q2" vid="PSA 109:28">a ta yuwan ma̱za̱nga̱.<verse eid="PSA 109:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29" />Wono u ta̱ ɓa̱ru</para>
  <para style="q2" vid="PSA 109:29">n'yuwatan n va̱.</para>
  <para style="q1" vid="PSA 109:29">Reve wu pala le</para>
  <para style="q2" vid="PSA 109:29">tsu umuna.<verse eid="PSA 109:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30" />Nu una̱ u va̱ u ɗa</para>
  <para style="q2" vid="PSA 109:30">ma̱a̱ godyowo</para>
  <para style="q2" vid="PSA 109:30">A̱sulazuva a̱bunda̱ lon,</para>
  <para style="q1" vid="PSA 109:30">n ta cuwa yi e memere</para>
  <para style="q2" vid="PSA 109:30">ma ama a̱ a̱bunda̱.<verse eid="PSA 109:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31" />Adama a na u tsu isawaan ta̱</para>
  <para style="q2" vid="PSA 109:31">za na cigai ikambishi,</para>
  <para style="q1" vid="PSA 109:31">adama u wawa wuma wa̱ yi,</para>
  <para style="q2" vid="PSA 109:31">e ekere aza a na</para>
  <para style="q2" vid="PSA 109:31">a cigai o kototo yi.<verse eid="PSA 109:31" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" sid="PSA 110" />
  <para style="s">A̱sulazuva oɓolo na̱ mogono ma na u ɗangwai</para>
  <para style="d">Ica ya̱ Da̱wuda.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1" />A̱sulazuva a damma ta̱ Zagbain va̱,</para>
  <para style="q2" vid="PSA 110:1">&lt;&lt;Da̱nu o ukere usa'ani u va̱,</para>
  <para style="q1" vid="PSA 110:1">she na̱ n zuwa n'yuwatan ma̱ wu</para>
  <para style="q2" vid="PSA 110:1">a apata a ana a̱ wu.&gt;&gt;<verse eid="PSA 110:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2" />A̱sulazuva a ta zuwa</para>
  <para style="q2" vid="PSA 110:2">tsugono tsa̱ wu tsa bala diga Sihiyona,</para>
  <para style="q1" vid="PSA 110:2">vu ta yuwan tsugono</para>
  <para style="q2" vid="PSA 110:2">a̱tsuma̱ a n'yuwatan ma̱ wu.<verse eid="PSA 110:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3" />Urana u na vo rono ali o uvon a̱ wu</para>
  <para style="q2" vid="PSA 110:3">aɗanga uba̱ta̱ o uvon,</para>
  <para style="q2" vid="PSA 110:3">ama a̱ wu na̱ a̱bunda̱ a ta ca aciyele</para>
  <para style="q2" vid="PSA 110:3">adama oɓolo ekere na̱ ali o uvon a̱ wu.</para>
  <para style="q1" vid="PSA 110:3">Cine a'iza a̱ tsu 'yon nu usana,</para>
  <para style="q2" vid="PSA 110:3">ne ɗa olobo a ca wu ukadu</para>
  <para style="q2" vid="PSA 110:3">adama a̱ ta̱wa̱ a kamba wu.<verse eid="PSA 110:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4" />A̱sulazuva a yuwan ta̱ akucunu</para>
  <para style="q2" vid="PSA 110:4">waru waa vadala okolo a̱ yi shi,</para>
  <para style="q1" vid="PSA 110:4">&lt;&lt;A̱vu ganu ɗa hali hali,</para>
  <para style="q2" vid="PSA 110:4">o ure wa Malkisada.&gt;&gt;<verse eid="PSA 110:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5" />A̱sulazuva a̱ ta̱ o ukere</para>
  <para style="q2" vid="PSA 110:5">u sa'ani wa̱ wu,</para>
  <para style="q1" vid="PSA 110:5">u ta̱ rukutsa̱ ngono</para>
  <para style="q2" vid="PSA 110:5">o urana wu upan wa̱ yi.<verse eid="PSA 110:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6" />U ta̱ ge'eto nɗa,</para>
  <para style="q2" vid="PSA 110:6">o ɓolotosu a̱kwa̱kwa̱,</para>
  <para style="q1" vid="PSA 110:6">nu u rukutsa̱i ngono</para>
  <para style="q2" vid="PSA 110:6">mu uvaɗi ma̱ɓula̱.<verse eid="PSA 110:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7" />U to sowo mini</para>
  <para style="q2" vid="PSA 110:7">o uka̱ri u na u ri a̱ nge'en mu ure,</para>
  <para style="q2" vid="PSA 110:7">reve wi isawan mishin</para>
  <para style="q2" vid="PSA 110:7">adama o ulyuwu wa aci.<verse eid="PSA 110:7" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" sid="PSA 111" />
  <para style="s">Ishipa yi Ica ya̱ A̱sula̱</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1" />Cuwai A̱sulazuva!</para>
  <para style="b" vid="PSA 111:1" />
  <para style="q1" vid="PSA 111:1">N ta̱ godyowo A̱sulazuva,</para>
  <para style="q2" vid="PSA 111:1">no okolo a̱ va̱ suru,</para>
  <para style="q1" vid="PSA 111:1">a̱tsuma̱ e iɓolo ya ama</para>
  <para style="q2" vid="PSA 111:1">a amayun a̱yi.<verse eid="PSA 111:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2" />Linga va̱ A̱sulazuva aza a gbagbain ɗa,</para>
  <para style="q2" vid="PSA 111:2">aza a na a uwwusa u yo'o u le</para>
  <para style="q2" vid="PSA 111:2">a ta majiyan ma̱ le.<verse eid="PSA 111:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3" />Linga va̱ yi tapu ɗa a̱ ri,</para>
  <para style="q2" vid="PSA 111:3">nu ucira na̱ tsugbain,</para>
  <para style="q2" vid="PSA 111:3">a̱ɓula̱ a̱ yi waru, a̱ ta̱ lo hali hali.<verse eid="PSA 111:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4" />U zuwa ta̱ a cuwan</para>
  <para style="q2" vid="PSA 111:4">na̱ linga va̱ yi va asalama,</para>
  <para style="q1" vid="PSA 111:4">A̱sulazuva za vi isa'ani ɗa,</para>
  <para style="q2" vid="PSA 111:4">waru za vi iliyali.<verse eid="PSA 111:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5" />U tsu ca ta̱ ilyalya uba̱ta̱ wa</para>
  <para style="q2" vid="PSA 111:5">aza a na a uwwusa wovon wa̱ yi,</para>
  <para style="q1" vid="PSA 111:5">u tsu cuwan ta̱</para>
  <para style="q2" vid="PSA 111:5">na akucunu a̱ yi mantsa suru.<verse eid="PSA 111:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6" />U roco ta̱ ama a̱ yi</para>
  <para style="q2" vid="PSA 111:6">ucira wu linga va̱ yi,</para>
  <para style="q1" vid="PSA 111:6">ana u ca nle iɗa</para>
  <para style="q2" vid="PSA 111:6">yo omocin wo o'wo agadu e le.<verse eid="PSA 111:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7" />Linga ve e ekere a̱ yi,</para>
  <para style="q2" vid="PSA 111:7">aza amayun a ɗa na̱ mejege,</para>
  <para style="q1" vid="PSA 111:7">udammu wa̱ yi suru,</para>
  <para style="q2" vid="PSA 111:7">ili i na a zuwaa ucira u ɗa,<verse eid="PSA 111:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8" />a̱ ta̱ ushuwu hali hali hali,</para>
  <para style="q2" vid="PSA 111:8">a yuwan le ta̱ a̱tsuma̱</para>
  <para style="q2" vid="PSA 111:8">amayun na̱ mejege.<verse eid="PSA 111:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9" />U tsupaa ta̱ ama a̱ yi,</para>
  <para style="q2" vid="PSA 111:9">wi isawaton ta̱ nzuwulai ma̱ yi hali hali.</para>
  <para style="q1" vid="PSA 111:9">Ala a̱ yi za va akiza ɗa,</para>
  <para style="q2" vid="PSA 111:9">ni ili i wovon.<verse eid="PSA 111:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10" />Wovon wa̱ A̱sulazuva a ɗa,</para>
  <para style="q2" vid="PSA 111:10">ufaru wu ugbozu,</para>
  <para style="q1" vid="PSA 111:10">aza a na o toniyi udammu wa̱ yi suru,</para>
  <para style="q2" vid="PSA 111:10">a̱ tsu tsura̱ ta̱ urevu u sa'ani.</para>
  <para style="q2" vid="PSA 111:10">A̱yi ɗa yaa yuwaan ica hali hali.<verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" sid="PSA 112" />
  <para style="s">Aba'un a za va̱ A̱ɓula̱</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1" />Cuwai A̱sulazuva!</para>
  <para style="b" vid="PSA 112:1" />
  <para style="q1" vid="PSA 112:1">Za ma̱za̱nga̱ ɗa vuma na,</para>
  <para style="q2" vid="PSA 112:1">a uwwusa wovon wa̱ A̱sulazuva,</para>
  <para style="q1" vid="PSA 112:1">za na a uwwusa uyo'o,</para>
  <para style="q2" vid="PSA 112:1">wu udammu wa̱ yi!<verse eid="PSA 112:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2" />Muwun ma za va̱ a̱ɓula̱</para>
  <para style="q2" vid="PSA 112:2">n ta yuwan ucira e iɗa'a,</para>
  <para style="q2" vid="PSA 112:2">limatan va̱ yi ta̱ tsa̱ra̱ aba'un.<verse eid="PSA 112:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3" />Limatan va̱ yi ta̱ da̱na̱</para>
  <para style="q2" vid="PSA 112:3">nu utsuru ni ikebe,</para>
  <para style="q1" vid="PSA 112:3">linga va̱ a̱ɓula̱ a̱ yi waru</para>
  <para style="q2" vid="PSA 112:3">o ta̱ lo hali hali.<verse eid="PSA 112:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4" />A̱yi ekan a ɗa na e ikanasa</para>
  <para style="q2" vid="PSA 112:4">e ekere aza amayun okolo</para>
  <para style="q2" vid="PSA 112:4">ni isa'ani ni iliyali na̱ a̱ɓula̱.<verse eid="PSA 112:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5" />Za ma̱za̱nga̱ ɗa vuma na tsu ca une'e</para>
  <para style="q2" vid="PSA 112:5">no okopu no okolo a̱ ta̱,</para>
  <para style="q1" vid="PSA 112:5">za na a yuwusan wuma wa̱ yi</para>
  <para style="q2" vid="PSA 112:5">a̱tsuma̱ e mejege.<verse eid="PSA 112:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6" />Amayun u ri n jinga̱ɗa̱ shi,</para>
  <para style="q2" vid="PSA 112:6">a ta cuwan na̱</para>
  <para style="q2" vid="PSA 112:6">za va a̱ɓula̱ hali hali.<verse eid="PSA 112:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7" />U tsu uwwa wovon</para>
  <para style="q2" vid="PSA 112:7">wa alabari a vama shi,</para>
  <para style="q1" vid="PSA 112:7">okolo a̱ yi a̱ ta̱ mishin,</para>
  <para style="q2" vid="PSA 112:7">a zuwusaa A̱sulazuva ucira.<verse eid="PSA 112:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8" />Okolo a̱ yi a̱ ta̱ ushuwu</para>
  <para style="q2" vid="PSA 112:8">waa uwwa wovon shi,</para>
  <para style="q1" vid="PSA 112:8">o ukosu u ta̱ ene ulyuwu wa aci,</para>
  <para style="q2" vid="PSA 112:8">a aci a n'yuwatan ma̱ yi.<verse eid="PSA 112:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9" />U tsu ca ta̱ uba̱ta̱ wa̱ a̱za̱ o ulambu</para>
  <para style="q2" vid="PSA 112:9">na̱ o okolo a̱ ta̱,</para>
  <para style="q1" vid="PSA 112:9">a̱ɓula̱ a̱ yi a̱ ta̱ lo hali hali,</para>
  <para style="q2" vid="PSA 112:9">u ta̱ da̱na̱ za vu ucira na a ca tsugbain.<verse eid="PSA 112:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10" />Za vi iwuya te ene a̱vu u yuwan upan</para>
  <para style="q2" vid="PSA 112:10">a wuma wa̱ yi suru.</para>
  <para style="q2" vid="PSA 112:10">Ifoɓi yi za vi iwuya u to o'wo pere.<verse eid="PSA 112:10" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" sid="PSA 113" />
  <para style="s">Ishipa yi ica ya̱ A̱sulazuva</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1" />Cuwai A̱sulazuva!</para>
  <para style="b" vid="PSA 113:1" />
  <para style="q1" vid="PSA 113:1">Cuwai A̱sulazuva, a̱ɗu agbashi a̱ yi!</para>
  <para style="q2" vid="PSA 113:1">Cuwai a ala A̱sulazuva!<verse eid="PSA 113:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2" />Lyawa a cuwa a ala a̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 113:2">diga gogo na̱ hali hali.<verse eid="PSA 113:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3" />Diga a̱ mota̱a̱ mo urana a̱ tyo ma̱ riya̱a̱ ma̱ yi,</para>
  <para style="q2" vid="PSA 113:3">wuntsaa ta̱ a cuwa a ala A̱sulazuva!<verse eid="PSA 113:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4" />Tsugbain tsa̱ A̱sulazuva</para>
  <para style="q2" vid="PSA 113:4">tsa la'a ta̱ nɗa suru,</para>
  <para style="q2" vid="PSA 113:4">tsugbain tsa̱ yi tsa la'a ta̱ zuva.<verse eid="PSA 113:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5" />Zane ɗa ri tsa̱ A̱sulazuva A̱sula̱ a̱ tsu,</para>
  <para style="q2" vid="PSA 113:5">za na ri ootogu o tsugono nden ɗe zuva?<verse eid="PSA 113:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6" />Zane ɗa ri tsa̱ wu na tsu ka̱lyuwa̱ za̱la̱,</para>
  <para style="q2" vid="PSA 113:6">we ene ili i na i ri zuva nu uvaɗi?<verse eid="PSA 113:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7" />U tsu 'ya̱sa̱n ta̱ a̱za̱ o ulambu</para>
  <para style="q2" vid="PSA 113:7">diga o ulambu u le,</para>
  <para style="q1" vid="PSA 113:7">a̱vu u 'ya̱sa̱n</para>
  <para style="q2" vid="PSA 113:7">aza a na a cigai ikambishi diga e iza̱,<verse eid="PSA 113:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8" />u zuwa le a lyuwa</para>
  <para style="q2" vid="PSA 113:8">oɓolo na̱ muwun mu ngono,</para>
  <para style="q2" vid="PSA 113:8">na̱ muwun mu ngono ma ama e le.<verse eid="PSA 113:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9" />U tsu ca ta̱ idari yi ka</para>
  <para style="q2" vid="PSA 113:9">tsugbain o u'wa wa̱ yi,</para>
  <para style="q1" vid="PSA 113:9">u tsu zuwai ta̱ ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 113:9">tsa mma muwun.</para>
  <para style="b" vid="PSA 113:9" />
  <para style="q1" vid="PSA 113:9">Cuwai a̱ A̱sulazuva.<verse eid="PSA 113:9" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" sid="PSA 114" />
  <para style="s">Ishipa ya̱ A̱buki a Mapasa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1" />Ana aza a Isra'ila,</para>
  <para style="q2" vid="PSA 114:1">o uta̱i diga Masar,</para>
  <para style="q1" vid="PSA 114:1">ana u'wa wa Yakubu,</para>
  <para style="q2" vid="PSA 114:1">u lyawai iɗa ya omocin i ndolo,<verse eid="PSA 114:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2" />Yahuda o o'wo ta̱,</para>
  <para style="q2" vid="PSA 114:2">uba̱ta̱ wu nden wa akiza wa̱ A̱sula̱,</para>
  <para style="q2" vid="PSA 114:2">Isra'ila waru agadu a̱ yi.<verse eid="PSA 114:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3" />Mala ma̱ shili me ene yi ta̱</para>
  <para style="q2" vid="PSA 114:3">reve u suma,</para>
  <para style="q1" vid="PSA 114:3">uɗolu wa Yahuda</para>
  <para style="q2" vid="PSA 114:3">u lyawa ta̱ mmalu,<verse eid="PSA 114:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4" />nsasan n da̱na̱ ta̱ a tsu'yan,</para>
  <para style="q2" vid="PSA 114:4">tsa̱ a̱giri'i,</para>
  <para style="q1" vid="PSA 114:4">agaɗi waru,</para>
  <para style="q2" vid="PSA 114:4">tsu mukyokyon.<verse eid="PSA 114:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5" />Nye i ɗa i yuwan nuwu</para>
  <para style="q2" vid="PSA 114:5">a̱vu mala a na vu sumai?</para>
  <para style="q1" vid="PSA 114:5">A̱vu uɗolu wa Yahuda,</para>
  <para style="q2" vid="PSA 114:5">a na vu lyawai mmalu?<verse eid="PSA 114:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6" />A̱ɗu nsasan,</para>
  <para style="q2" vid="PSA 114:6">a na i ri a tsu'yan tsa̱ a̱giri'i?</para>
  <para style="q2" vid="PSA 114:6">A̱ɗu agaɗi waru, tsu mukyokyon?<verse eid="PSA 114:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7" />Je'en lipu a̱vu uvaɗi,</para>
  <para style="q2" vid="PSA 114:7">a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 114:7">a̱ ma̱ka̱ka̱n ma̱ A̱sula̱ a Yakubu,<verse eid="PSA 114:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8" />za na ka̱mba̱toi aatali oko'o a̱ mini,</para>
  <para style="q2" vid="PSA 114:8">aatali o ugbamu waru esu a̱ mini.<verse eid="PSA 114:8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" sid="PSA 115" />
  <para style="s">A ca ta̱ Aala a̱ wu Tsugbain</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1" />Ya̱ a̱ wu goon, A̱sulazuva,</para>
  <para style="q2" vid="PSA 115:1">ya̱ a̱ wu goon,</para>
  <para style="q2" vid="PSA 115:1">agba uba̱ta̱ u tsu shi,</para>
  <para style="q1" vid="PSA 115:1">ko a 'yuwan a ciga a ca ala a̱ wu tsugbain</para>
  <para style="q2" vid="PSA 115:1">adama e icigi ya̱ wu i na i tsu vadala shi</para>
  <para style="q2" vid="PSA 115:1">na amayun a̱ wu.<verse eid="PSA 115:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2" />Nye i zuwai nɗa n dammai,</para>
  <para style="q2" vid="PSA 115:2">&lt;&lt;Te ɗa A̱sula̱ e le?&gt;&gt;<verse eid="PSA 115:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3" />A̱sula̱ a̱ tsu a̱ ta̱ zuva,</para>
  <para style="q2" vid="PSA 115:3">u tsu yuwan ta̱ ili i na u cigai.<verse eid="PSA 115:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4" />Amma musula̱ n le</para>
  <para style="q2" vid="PSA 115:4">zinariya na̱ azurufa ɗa,</para>
  <para style="q1" vid="PSA 115:4">aza a na a yuwain</para>
  <para style="q2" vid="PSA 115:4">ne ekere a ama.<verse eid="PSA 115:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5" />A̱ ta̱ na̱ una̱,</para>
  <para style="q2" vid="PSA 115:5">amma a tsu yuwan adanshi shi,</para>
  <para style="q1" vid="PSA 115:5">a̱ ta̱ ne esu,</para>
  <para style="q2" vid="PSA 115:5">amma a̱ tse ene shi,<verse eid="PSA 115:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6" />a̱ ta̱ na atsuvu,</para>
  <para style="q2" vid="PSA 115:6">amma a tsu uwwa shi,</para>
  <para style="q1" vid="PSA 115:6">a̱ ta̱ na̱ vunu,</para>
  <para style="q2" vid="PSA 115:6">amma a tsu uwwa a̱ꞌya̱n shi,<verse eid="PSA 115:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7" />a̱ ta̱ ne ekere,</para>
  <para style="q2" vid="PSA 115:7">amma a tsu gura guza̱ ili shi,</para>
  <para style="q1" vid="PSA 115:7">a̱ ta̱ na ana</para>
  <para style="q2" vid="PSA 115:7">amma a tsu gura wala shi,</para>
  <para style="q1" vid="PSA 115:7">a tsu gura waru uta̱a̱ uɗyo</para>
  <para style="q2" vid="PSA 115:7">a̱la̱kutsu e le shi.<verse eid="PSA 115:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8" />Ele aza a na a yuwan le,</para>
  <para style="q2" vid="PSA 115:8">na aza a na a̱ usu n le suru,</para>
  <para style="q2" vid="PSA 115:8">o to o'wo tsa̱ le.<verse eid="PSA 115:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9" />A̱ɗu aza a Isra'ila,</para>
  <para style="q2" vid="PSA 115:9">zuwai okolo a̱ ɗu</para>
  <para style="q2" vid="PSA 115:9">uba̱ta̱ wa̱ A̱sulazuva!</para>
  <para style="q1" vid="PSA 115:9">A̱yi ɗa ikambi i ɗu,</para>
  <para style="q2" vid="PSA 115:9">na̱ a̱a̱ra̱ga̱ a̱ ɗu.<verse eid="PSA 115:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10" />A̱ɗu u'wa wa Haruna,</para>
  <para style="q2" vid="PSA 115:10">zuwai okolo a̱ ɗu</para>
  <para style="q2" vid="PSA 115:10">uba̱ta̱ wa̱ A̱sulazuva!</para>
  <para style="q1" vid="PSA 115:10">A̱yi ɗa ikambi i ɗu,</para>
  <para style="q2" vid="PSA 115:10">na̱ a̱a̱ra̱ga̱ a̱ ɗu.<verse eid="PSA 115:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11" />A̱ɗu na yaa uwwusa</para>
  <para style="q2" vid="PSA 115:11">wovon wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 115:11">zuwai okolo a̱ ɗu uba̱ta̱ wa̱ yi!</para>
  <para style="q1" vid="PSA 115:11">A̱yi ɗa ikambi i ɗu,</para>
  <para style="q2" vid="PSA 115:11">na̱ a̱a̱ra̱ga̱ a̱ ɗu.<verse eid="PSA 115:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12" />A̱sulazuva a cuwan ta̱ na̱ a̱tsu,</para>
  <para style="q2" vid="PSA 115:12">waru u ta zuwaa tsu aba'un,</para>
  <para style="q1" vid="PSA 115:12">u ta zuwaa u'wa wa Isra'ila aba'un,</para>
  <para style="q2" vid="PSA 115:12">u ta zuwaa u'wa wa Haruna aba'un,<verse eid="PSA 115:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13" />u ta zuwaa aza a na</para>
  <para style="q2" vid="PSA 115:13">a uwwusa wovon wa̱ yi aba'un,</para>
  <para style="q2" vid="PSA 115:13">zagbain na̱ mawun.<verse eid="PSA 115:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14" />Lyawa A̱sulazuva</para>
  <para style="q2" vid="PSA 115:14">a̱a̱ da̱shi ɗu a̱bunda̱,</para>
  <para style="q2" vid="PSA 115:14">a̱ɗu oɓolo na̱ muwun nɗu.<verse eid="PSA 115:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15" />Lyawa A̱sulazuva a zuwaa ɗu aba'un,</para>
  <para style="q2" vid="PSA 115:15">a̱yi za na yuwain zuva nu uvaɗi!<verse eid="PSA 115:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16" />Zuva va zuva</para>
  <para style="q2" vid="PSA 115:16">za va̱ A̱sulazuva a ɗa,</para>
  <para style="q1" vid="PSA 115:16">amma uvaɗi</para>
  <para style="q2" vid="PSA 115:16">u ca ta̱ vaɗilima̱.<verse eid="PSA 115:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17" />A̱kwa̱kwa̱ aa cuwa</para>
  <para style="q2" vid="PSA 115:17">A̱sulazuva shi,</para>
  <para style="q2" vid="PSA 115:17">ele na a̱ ka̱ra̱i a̱ cipa̱ a aason.<verse eid="PSA 115:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18" />Amma a̱tsu,</para>
  <para style="q2" vid="PSA 115:18">tsu ta cuwa A̱sulazuva,</para>
  <para style="q2" vid="PSA 115:18">diga gogo na̱ hali hali.</para>
  <para style="b" vid="PSA 115:18" />
  <para style="q1" vid="PSA 115:18">Cuwai A̱sulazuva!<verse eid="PSA 115:18" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" sid="PSA 116" />
  <para style="s">Ugodyusho adama e iwawi</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1" />N ta̱ e icigi ya̱ a̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 116:1">adama a na wu uwwa ta̱ uɗyo u va̱</para>
  <para style="q2" vid="PSA 116:1">wi izami yi ikambishi.<verse eid="PSA 116:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2" />N ta̱ ɗe a ala a̱ yi a wuma u va̱ suru</para>
  <para style="q2" vid="PSA 116:2">adama a na u tsu zuwaa mu ta̱ atsuvu.<verse eid="PSA 116:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3" />Meleshe mo o ukwa̱ ma̱ nla̱ mu ta̱,</para>
  <para style="q2" vid="PSA 116:3">usa̱n wa a aason u katala mu ta̱.</para>
  <para style="q2" vid="PSA 116:3">Addama na̱ a̱tsumola̱ngu a cina mu ta̱.<verse eid="PSA 116:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4" />A̱vu n ɗe a ala a̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 116:4">&lt;&lt;A̱sulazuva, wawa mu!&gt;&gt;<verse eid="PSA 116:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5" />A̱sulazuva za vi isa'ani na̱ a̱ɓula̱ a ɗa,</para>
  <para style="q2" vid="PSA 116:5">A̱sula̱ a̱ tsu za vi iliyali ɗa.<verse eid="PSA 116:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6" />A̱sulazuva a̱ ta̱ ka̱lyuwusa̱,</para>
  <para style="q2" vid="PSA 116:6">za na ka̱ɗa̱to yi aciya̱yi.</para>
  <para style="q1" vid="PSA 116:6">Mantsa ma na n shi addama,</para>
  <para style="q2" vid="PSA 116:6">u wawa mu ta̱.<verse eid="PSA 116:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7" />Ka̱mba̱ vu von,</para>
  <para style="q2" vid="PSA 116:7">okolo a̱ va̱,</para>
  <para style="q1" vid="PSA 116:7">adama a na A̱sulazuva,</para>
  <para style="q2" vid="PSA 116:7">a yuwaan wu ta̱ isa'ani lon.<verse eid="PSA 116:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8" />Adama a na A̱sulazuva a wawa ta̱,</para>
  <para style="q2" vid="PSA 116:8">wuma u va̱ diga o ukwisa̱,</para>
  <para style="q2" vid="PSA 116:8">esu a̱ va̱ diga a aɓara,</para>
  <para style="q2" vid="PSA 116:8">ana a̱ va̱ diga o uta̱ɗa̱tsa̱sa̱.<verse eid="PSA 116:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9" />Adama n wala a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 116:9">o uvaɗi wa aza a wuma.<verse eid="PSA 116:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10" />Ko na n dammai,</para>
  <para style="q2" vid="PSA 116:10">&lt;&lt;Mu uwwa ta̱ lipu lon.&gt;&gt;</para>
  <para style="q2" vid="PSA 116:10">N ta̱ u ɓanu na̱ amayun a̱ va̱.<verse eid="PSA 116:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11" />O urupulu u va̱ n damma ta̱,</para>
  <para style="q2" vid="PSA 116:11">&lt;&lt;Ama suru a̱za̱ e epen a ɗa.&gt;&gt;<verse eid="PSA 116:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12" />Nye maa ca A̱sulazuva,</para>
  <para style="q2" vid="PSA 116:12">adama e isa'ani i na</para>
  <para style="q2" vid="PSA 116:12">u yuwaan numu suru?<verse eid="PSA 116:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13" />N ta̱ 'ya̱sa̱n mokotto me ili yo oso yi iwawi</para>
  <para style="q2" vid="PSA 116:13">a̱vu n ɗe ala a̱ A̱sulazuva.<verse eid="PSA 116:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14" />N to shiton nzuwulai n va̱</para>
  <para style="q2" vid="PSA 116:14">uba̱ta̱ wa̱ a̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 116:14">a̱ ma̱ka̱ka̱n ma ama a̱ yi suru.<verse eid="PSA 116:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15" />A̱sulazuva a tara ta̱ wuma</para>
  <para style="q2" vid="PSA 116:15">wa̱ a̱za̱ a̱ a̱ɓula̱ ili isa'ani lon.<verse eid="PSA 116:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16" />Na amayun, A̱sulazuva,</para>
  <para style="q2" vid="PSA 116:16">a̱mu aagbashi a̱ wu a ɗa,</para>
  <para style="q1" vid="PSA 116:16">a̱mu aagbashi a̱ wu a ɗa</para>
  <para style="q2" vid="PSA 116:16">mawun ma aagbashi a̱ wu a ka,</para>
  <para style="q2" vid="PSA 116:16">a̱vu ɗa vu ba̱ɗa̱ numu diga a akani.<verse eid="PSA 116:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17" />N ta ca kucci</para>
  <para style="q2" vid="PSA 116:17">vu ugodyusho uba̱ta̱ wa̱ wu,</para>
  <para style="q2" vid="PSA 116:17">a̱vu n ɗe a ala a̱ A̱sulazuva.<verse eid="PSA 116:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18" />N to shiton nzuwulai n va̱</para>
  <para style="q2" vid="PSA 116:18">uba̱ta̱ wa̱ a̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 116:18">a̱ ma̱ka̱ka̱n ma a ama a̱ yi suru.<verse eid="PSA 116:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19" />O ukowo wu u'wa wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 116:19">a̱ memere ma̱ Urishelima.</para>
  <para style="b" vid="PSA 116:19" />
  <para style="q1" vid="PSA 116:19">Cuwai A̱sulazuva!<verse eid="PSA 116:19" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" sid="PSA 117" />
  <para style="s">Ica a̱ tyo uba̱ta̱ wa̱ A̱sulazuva</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1" />Cuwai A̱sulazuva,</para>
  <para style="q2" vid="PSA 117:1">a̱ɗu nɗa suru!</para>
  <para style="q1" vid="PSA 117:1">Ca niyi tsugbain,</para>
  <para style="q2" vid="PSA 117:1">a̱ɗu ama suru!<verse eid="PSA 117:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2" />Adama a na icigi ya̱ yi i na i tsu vadala shi</para>
  <para style="q2" vid="PSA 117:2">e ekere a̱ tsu, u ta̱ a̱bunda̱ lon,</para>
  <para style="q2" vid="PSA 117:2">waru a̱ɓula̱ a̱ A̱sulazuva a̱ ta̱ lo hali hali.</para>
  <para style="b" vid="PSA 117:2" />
  <para style="q2" vid="PSA 117:2">Cuwai A̱sulazuva!<verse eid="PSA 117:2" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" sid="PSA 118" />
  <para style="s">Avasa o ugodyusho adama o ulyuwu wa aci</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1" />Godyoyi A̱sulazuva,</para>
  <para style="q2" vid="PSA 118:1">adama a na a̱yi za vi isa'ani ɗa,</para>
  <para style="q2" vid="PSA 118:1">icigi ya̱ yi i na i tsu vadala shi i ta̱ lo hali hali.<verse eid="PSA 118:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2" />Lyawa aza Isra'ila a damma,</para>
  <para style="q2" vid="PSA 118:2">&lt;&lt;Icigi ya̱ yi i na i tsu vadala shi i ta̱ lo hali hali!&gt;&gt;<verse eid="PSA 118:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3" />Lyawa u'wa wa Haruna u damma,</para>
  <para style="q2" vid="PSA 118:3">&lt;&lt;Icigi ya̱ yi i na i tsu vadala shi i ta̱ lo hali hali!&gt;&gt;<verse eid="PSA 118:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4" />Lyawa aza a na a uwwusa</para>
  <para style="q2" vid="PSA 118:4">wovon wa̱ A̱sulazuva a damma,</para>
  <para style="q2" vid="PSA 118:4">&lt;&lt;Icigi ya̱ yi i na i tsu vadala shi i ta̱ lo hali hali!&gt;&gt;<verse eid="PSA 118:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5" />A̱tsuma̱ addama a̱ va̱,</para>
  <para style="q2" vid="PSA 118:5">n ɗe ta̱ A̱sulazuva,</para>
  <para style="q1" vid="PSA 118:5">A̱sulazuva waru a̱ usu mu ta̱,</para>
  <para style="q2" vid="PSA 118:5">a̱vu u wawa mu.<verse eid="PSA 118:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6" />A̱sulazuva o to oɓolo na̱ a̱mu,</para>
  <para style="q2" vid="PSA 118:6">maa uwwa wovon shi.</para>
  <para style="q1" vid="PSA 118:6">Nye i ɗa vuma</para>
  <para style="q2" vid="PSA 118:6">aa gura yuwan na̱ a̱mu?<verse eid="PSA 118:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7" />A̱sulazuva o to oɓolo na̱ a̱mu,</para>
  <para style="q2" vid="PSA 118:7">a̱ yi ɗa ikambishi i va̱.</para>
  <para style="q1" vid="PSA 118:7">N ta̱ ene a̱risa̱</para>
  <para style="q2" vid="PSA 118:7">a n'yuwatan n va̱.<verse eid="PSA 118:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8" />U la'a ta̱ a zami upa'atan,</para>
  <para style="q2" vid="PSA 118:8">uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 118:8">a na a zuwaa vuma ucira.<verse eid="PSA 118:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9" />U la'a ta̱ a zami upa'atan,</para>
  <para style="q2" vid="PSA 118:9">uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 118:9">a na a zuwaa azagbain a ama ucira.<verse eid="PSA 118:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10" />Nɗa suru a̱ ka̱nda̱ruwa̱ mu ta̱,</para>
  <para style="q2" vid="PSA 118:10">agba n kototo le ta̱ a ala A̱sulazuva!<verse eid="PSA 118:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11" />A̱ ka̱nda̱ruwa̱ mu ta̱ mɓa̱nga̱ suru,</para>
  <para style="q2" vid="PSA 118:11">agba n kototo le ta̱ a ala A̱sulazuva!<verse eid="PSA 118:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12" />A̱ ka̱nda̱ruwa̱ mu ta̱ tsi ishiki,</para>
  <para style="q2" vid="PSA 118:12">amma a̱vu a̱ kula̱ babu usa̱n</para>
  <para style="q2" vid="PSA 118:12">tsa akina a awanda,</para>
  <para style="q1" vid="PSA 118:12">amma n kototo le ta̱</para>
  <para style="q2" vid="PSA 118:12">a ala A̱sulazuva!<verse eid="PSA 118:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13" />A̱ riya̱a̱ mu ta̱ nu ucira,</para>
  <para style="q2" vid="PSA 118:13">hali n yuwan n ga shi n ta̱ riya̱,</para>
  <para style="q2" vid="PSA 118:13">amma A̱sulazuva a kamba mu ta̱.<verse eid="PSA 118:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14" />A̱sulazuva a ɗa ucira u va̱</para>
  <para style="q2" vid="PSA 118:14">ni ishipa i va̱,</para>
  <para style="q2" vid="PSA 118:14">a̱yi ɗa wo o'woi iwawi i va̱.<verse eid="PSA 118:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15" />Yisali i ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 118:15">nu ulyuwu wa aci</para>
  <para style="q2" vid="PSA 118:15">a̱ ta̱ 'yosun,</para>
  <para style="q2" vid="PSA 118:15">o ogodo a̱za̱ a̱ a̱ɓula̱ adansa,</para>
  <para style="q1" vid="PSA 118:15">&lt;&lt;Ukere wa̱ a̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 118:15">u yuwan ta̱ a̱ba̱jini e ili!<verse eid="PSA 118:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 118:16" />Ukere wa̱ a̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 118:16">u ca ta̱ ulyuwu wa aci,</para>
  <para style="q1" vid="PSA 118:16">ukere wa̱ a̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 118:16">u yuwan ta̱ a̱ba̱jini e ili!&gt;&gt;<verse eid="PSA 118:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17" />Ma̱a̱ kuwa̱ shi,</para>
  <para style="q2" vid="PSA 118:17">amma n ta̱ da̱na̱ wuma,</para>
  <para style="q2" vid="PSA 118:17">n cuɗuwa linga va̱ A̱sulazuva.<verse eid="PSA 118:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18" />A̱sulazuva a ca mu ta̱ oforo lon,</para>
  <para style="q2" vid="PSA 118:18">amma u lyawa mu n kuwa̱ shi.<verse eid="PSA 118:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19" />Kpa̱tu'wa̱a̱ mu</para>
  <para style="q2" vid="PSA 118:19">na̱ntsu va̱ a̱ɓula̱,</para>
  <para style="q1" vid="PSA 118:19">a̱vu n uwa</para>
  <para style="q2" vid="PSA 118:19">n godyowo A̱sulazuva.<verse eid="PSA 118:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20" />Nda una̱ntsu wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 118:20">uba̱ta̱ u na a̱za̱ a̱ a̱ɓula̱</para>
  <para style="q2" vid="PSA 118:20">a ɗa goon a uwa pe.<verse eid="PSA 118:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21" />N to godyo wu</para>
  <para style="q2" vid="PSA 118:21">adama a na vu usu mu ta̱,</para>
  <para style="q2" vid="PSA 118:21">waru vo o'wo ta̱ iwawi i va̱.<verse eid="PSA 118:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22" />Aatali a na asuwi a 'yuwain,</para>
  <para style="q2" vid="PSA 118:22">a̱yi ɗa wo o'woi ikyun yu ucira a̱tsuma̱ o usaa.<verse eid="PSA 118:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23" />Ulinga wa̱ A̱sulazuva a ɗa nda,</para>
  <para style="q2" vid="PSA 118:23">ili ya asalama i ɗa esu a̱ tsu.<verse eid="PSA 118:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24" />A̱yi nda ɗa urana u na</para>
  <para style="q2" vid="PSA 118:24">A̱sulazuva a yuwain,</para>
  <para style="q1" vid="PSA 118:24">tsu yuwain ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 118:24">na̱ mere a̱tsuma̱ a̱ yi!<verse eid="PSA 118:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25" />A̱sulazuva, wawa tsu!</para>
  <para style="q2" vid="PSA 118:25">A̱sulazuva, ca tsu ulyuwu wa aci.<verse eid="PSA 118:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26" />Za va aba'un ɗa,</para>
  <para style="q2" vid="PSA 118:26">za na ta̱wa̱i na ala a̱ A̱sulazuva!</para>
  <para style="q1" vid="PSA 118:26">Tsu zuwaa ɗu ta̱ aba'un,</para>
  <para style="q2" vid="PSA 118:26">diga o u'wa wa̱ A̱sulazuva.<verse eid="PSA 118:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27" />A̱sulazuva A̱sula̱ a ɗa,</para>
  <para style="q2" vid="PSA 118:27">u zuwa ta̱ ekan e ikana a aci a̱tsu,</para>
  <para style="q1" vid="PSA 118:27">tara yi kucci ɗu va̱ a̱buki,</para>
  <para style="q2" vid="PSA 118:27">i zuwa le avana a masa'a.<verse eid="PSA 118:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28" />A̱vu ɗa A̱sula̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 118:28">n to godyo wu,</para>
  <para style="q1" vid="PSA 118:28">a̱vu ɗa A̱sula̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 118:28">n ta ca wu tsugbain.<verse eid="PSA 118:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29" />Godyoyi A̱sulazuva,</para>
  <para style="q2" vid="PSA 118:29">adama a na a̱yi za vi isa'ani ɗa,</para>
  <para style="q2" vid="PSA 118:29">adama a na icigi ya̱ yi i na i tsu vadala shi</para>
  <para style="q2" vid="PSA 118:29">i ta̱ lo hali hali!<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" sid="PSA 119" />
  <para style="qa">Alef.</para>
  <para style="s">A̱za̱ a̱ ma̱za̱nga̱ a ɗa aza a na aa yuwusan tsutoni na̱ wila̱ wa̱ A̱sulazuva</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1" />A̱za̱ a̱ ma̱za̱nga̱ a ɗa,</para>
  <para style="q2" vid="PSA 119:1">aza a na re le ri mejege,</para>
  <para style="q2" vid="PSA 119:1">aza na o toniyi wila̱ wa̱ A̱sulazuva.<verse eid="PSA 119:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2" />A̱za̱ a̱ ma̱za̱nga̱ a ɗa,</para>
  <para style="q2" vid="PSA 119:2">aza a na e icinai ni ili i na u yuwain shi,</para>
  <para style="q2" vid="PSA 119:2">aza a na a zamishi yi no okolo e le suru.<verse eid="PSA 119:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3" />A tsu yuwan unusu shi,</para>
  <para style="q2" vid="PSA 119:3">waru a ta a mmalu</para>
  <para style="q2" vid="PSA 119:3">o ure wa̱ A̱sulazuva.<verse eid="PSA 119:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4" />A̱sulazuva vu zuwa ta̱,</para>
  <para style="q2" vid="PSA 119:4">ili i na a̱ kuru</para>
  <para style="q2" vid="PSA 119:4">tsa̱ra̱ tsu toni le ulobonu.<verse eid="PSA 119:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5" />A̱ she a damma</para>
  <para style="q2" vid="PSA 119:5">n shi ta̱ na̱ a̱ɓula̱</para>
  <para style="q2" vid="PSA 119:5">e itoni yu udammu wa̱ wu!<verse eid="PSA 119:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6" />Mantsa ma na n toniyi</para>
  <para style="q2" vid="PSA 119:6">udammu wa̱ wu suru,</para>
  <para style="q2" vid="PSA 119:6">Maa uwwa wono shi.<verse eid="PSA 119:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7" />N ta cuwa wu</para>
  <para style="q2" vid="PSA 119:7">no okolo a̱ ta̱,</para>
  <para style="q1" vid="PSA 119:7">mantsa ma na</para>
  <para style="q2" vid="PSA 119:7">n ritoyi uge'etosu wa̱ a̱ɓula̱ a̱ wu.<verse eid="PSA 119:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8" />N ta yuwan tsutoni</para>
  <para style="q2" vid="PSA 119:8">nu udammu wa̱ wu,</para>
  <para style="q1" vid="PSA 119:8">she vu vari mu</para>
  <para style="q2" vid="PSA 119:8">suru suru wan.<verse eid="PSA 119:8" /></para>
  <para style="qa">Bet.</para>
  <para style="s">Tsutoni na̱ wila̱ wa̱ A̱sulazuva</para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9" />Cine ulobo waa gura guza̱</para>
  <para style="q2" vid="PSA 119:9">aciya̱yi ulobonu?</para>
  <para style="q1" vid="PSA 119:9">She nu u kuru</para>
  <para style="q2" vid="PSA 119:9">idanshi ya̱ A̱sulazuva.<verse eid="PSA 119:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10" />N zami wu ta̱ no okolo a̱ ta̱,</para>
  <para style="q2" vid="PSA 119:10">she vu lyawa mu n takatsuwa</para>
  <para style="q2" vid="PSA 119:10">o udammu wu wan!<verse eid="PSA 119:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11" />N zuwa ta̱ idanshi ya̱ wu okolo a̱ va̱,</para>
  <para style="q2" vid="PSA 119:11">tsa̱ra̱ n yuwaan wu unusu wan.<verse eid="PSA 119:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12" />A̱sulazuva aba'un za va̱ wu ɗa,</para>
  <para style="q2" vid="PSA 119:12">rito mu udammu wa̱ wu.<verse eid="PSA 119:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13" />Nu una̱ u va̱ u ɗa maa damma uge'etosu</para>
  <para style="q2" vid="PSA 119:13">u na wu uta̱i o una̱ wa̱ wu suru.<verse eid="PSA 119:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14" />N ta yuwusan ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 119:14">ni itoni yi ili i na vu yuwain,</para>
  <para style="q2" vid="PSA 119:14">ula'awu nu utsuru wa̱ a̱bunda̱.<verse eid="PSA 119:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15" />N tsu yuwusan ta̱ majiyan</para>
  <para style="q2" vid="PSA 119:15">mee e ili i na vu zuwai na̱ a̱ kuru,</para>
  <para style="q2" vid="PSA 119:15">waru n rito re va̱ wu.<verse eid="PSA 119:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16" />N ta yuwusan ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 119:16">nu udammu wa̱ wu,</para>
  <para style="q2" vid="PSA 119:16">mee icina na adanshi a̱ wu shi.<verse eid="PSA 119:16" /></para>
  <para style="qa">Gimel.</para>
  <para style="s">Ma̱za̱nga̱ a̱tsuma̱ a̱ wila̱ wa̱ a̱ A̱sulazuva</para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17" />Vu yuwaan aagbashi a̱ wu isa'ani,</para>
  <para style="q2" vid="PSA 119:17">tsura̱ n da̱na̱ wuma</para>
  <para style="q2" vid="PSA 119:17">n yuwan tsutoni na adanshi a̱ wu.<verse eid="PSA 119:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18" />Kpa̱tu'wa̱ esu a̱ va̱</para>
  <para style="q2" vid="PSA 119:18">tsura̱ me ene,</para>
  <para style="q1" vid="PSA 119:18">ili ya asalama</para>
  <para style="q2" vid="PSA 119:18">a̱tsuma̱ a̱ wila̱ wa̱ wu.<verse eid="PSA 119:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19" />A̱mu mocin ɗa o uvaɗi,</para>
  <para style="q2" vid="PSA 119:19">she vu soko udammu wa̱ wu</para>
  <para style="q2" vid="PSA 119:19">uba̱ta̱ u va̱ wan!<verse eid="PSA 119:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20" />Ookolo a̱ va̱ a̱ ta̱ tapu,</para>
  <para style="q2" vid="PSA 119:20">na̱ a̱bunda̱ a maluwa</para>
  <para style="q2" vid="PSA 119:20">mo uge'etosu wa̱ wu mantsa suru.<verse eid="PSA 119:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21" />Vu tsu ɓara ta̱ aza aciyogbamu,</para>
  <para style="q2" vid="PSA 119:21">aza a na a yuwayin una̱,</para>
  <para style="q1" vid="PSA 119:21">aza a na a 'yuwain</para>
  <para style="q2" vid="PSA 119:21">a̱ kuru udammu wa̱ wu.<verse eid="PSA 119:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22" />Wawa mu diga o wono</para>
  <para style="q2" vid="PSA 119:22">nu ulamu u le,</para>
  <para style="q1" vid="PSA 119:22">adama a na n yuwan ta̱ tsutoni</para>
  <para style="q2" vid="PSA 119:22">ni ili i na vu zuwai a̱ kuru.<verse eid="PSA 119:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23" />Ko na wo o'woi azagbain,</para>
  <para style="q2" vid="PSA 119:23">m ɓolo a aci e le</para>
  <para style="q2" vid="PSA 119:23">adama a tama inama i va̱,</para>
  <para style="q1" vid="PSA 119:23">aagbashi a̱ wu a̱ ta̱ da̱na̱ a majiyan</para>
  <para style="q2" vid="PSA 119:23">mo o udammu wa̱ wu.<verse eid="PSA 119:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24" />Ili i na vu zuwai a̱ kuru</para>
  <para style="q2" vid="PSA 119:24">o yo'ono to mu ta̱ ookolo,</para>
  <para style="q2" vid="PSA 119:24">e le ɗa ili ya̱ a̱sa̱la̱ a̱ va̱.<verse eid="PSA 119:24" /></para>
  <para style="qa">Dalet.</para>
  <para style="s">Uzuwu wo okolo adama a yuwan tsutoni na̱ wila̱ wa̱ A̱sulazuva</para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25" />N yuwan ta̱ zuzu nu ukwa̱,</para>
  <para style="q2" vid="PSA 119:25">vu ca mu wuma u sa'avu</para>
  <para style="q2" vid="PSA 119:25">cine vu yuwain nzuwulai.<verse eid="PSA 119:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26" />N damma ta̱ re va̱</para>
  <para style="q2" vid="PSA 119:26">reve vu usu mu,</para>
  <para style="q2" vid="PSA 119:26">vu rito mu udammu wa̱ wu.<verse eid="PSA 119:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27" />Lyawa mu n reve</para>
  <para style="q2" vid="PSA 119:27">ili i na vu zuwai na̱ a̱ kuru,</para>
  <para style="q1" vid="PSA 119:27">adama n da̱na̱ a majiyan</para>
  <para style="q2" vid="PSA 119:27">ma linga va asalama a̱ wu.<verse eid="PSA 119:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28" />Ookolo a̱ va̱ a̱ ta̱ tapu</para>
  <para style="q2" vid="PSA 119:28">na̱ a̱tsumola̱ngu,</para>
  <para style="q1" vid="PSA 119:28">vu ca mu ucira</para>
  <para style="q2" vid="PSA 119:28">cine adanshi a̱ wu a dammai.<verse eid="PSA 119:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29" />Vu uta̱a̱ mu diga e re ve epen,</para>
  <para style="q2" vid="PSA 119:29">vu roco mu isa'ani</para>
  <para style="q2" vid="PSA 119:29">o ure u wila̱ wa̱ wu.<verse eid="PSA 119:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30" />N ɗangwa ta̱ ure wa amayun,</para>
  <para style="q2" vid="PSA 119:30">n zuwa ta̱ okolo a̱ va̱</para>
  <para style="q2" vid="PSA 119:30">o uge'etosu wa̱ wu.<verse eid="PSA 119:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31" />A̱sulazuva n suraa ta̱</para>
  <para style="q2" vid="PSA 119:31">ili i na vu zuwai na̱ a̱ kuru,</para>
  <para style="q1" vid="PSA 119:31">she vu lyawa mu,</para>
  <para style="q2" vid="PSA 119:31">mu uwwa wono wan.<verse eid="PSA 119:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32" />Nu ukadu u ɗa</para>
  <para style="q2" vid="PSA 119:32">n toniyi udammu wa̱ wu,</para>
  <para style="q1" vid="PSA 119:32">adama a na vu zuwa ta̱</para>
  <para style="q2" vid="PSA 119:32">okolo a̱ va̱ wo o'wo fa̱a̱n.<verse eid="PSA 119:32" /></para>
  <para style="qa">He.</para>
  <para style="s">Avasa adama a̱ reve wila̱ wa̱ A̱sulazuva</para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33" />A̱sulazuva vu roco mu</para>
  <para style="q2" vid="PSA 119:33">udammu wa̱ wu,</para>
  <para style="q2" vid="PSA 119:33">adama n toni le a̱ tyo o ukosu.<verse eid="PSA 119:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34" />Vu ca mu urevu,</para>
  <para style="q2" vid="PSA 119:34">adama n kuru wila̱ wa̱ wu,</para>
  <para style="q1" vid="PSA 119:34">waru n toni le,</para>
  <para style="q2" vid="PSA 119:34">no okolo a̱ ta̱.<verse eid="PSA 119:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35" />Vu zuwa mu n yuwan mmalu</para>
  <para style="q2" vid="PSA 119:35">o ure wu udammu wa̱ wu,</para>
  <para style="q1" vid="PSA 119:35">adama a na a̱tsuma̱ e le ɗa</para>
  <para style="q2" vid="PSA 119:35">n tsu tsura̱ ma̱za̱nga̱.<verse eid="PSA 119:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36" />Vu ca mu okolo a na ma yuwan</para>
  <para style="q2" vid="PSA 119:36">tsutoni ni ili i na vu zuwai na̱ a̱ kuru</para>
  <para style="q2" vid="PSA 119:36">ula'awu ni icigi yu utsuru.<verse eid="PSA 119:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37" />Vu tawa esu a̱ va̱</para>
  <para style="q2" vid="PSA 119:37">a linga ve pere,</para>
  <para style="q1" vid="PSA 119:37">vu yuwaan mu isa'ani</para>
  <para style="q2" vid="PSA 119:37">ununa vu yuwain nzuwulai.<verse eid="PSA 119:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38" />Vu shiton nzuwulai ma̱ wu</para>
  <para style="q2" vid="PSA 119:38">na vu yuwayin aagbashi a̱ wu,</para>
  <para style="q2" vid="PSA 119:38">tsura̱ a uwwa wovon wa̱ wu.<verse eid="PSA 119:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39" />Tawa mu wono</para>
  <para style="q2" vid="PSA 119:39">u na maa uwwusa wovon,</para>
  <para style="q1" vid="PSA 119:39">adama a na uge'etosu wa̱ wu</para>
  <para style="q2" vid="PSA 119:39">u ta̱ mejege.<verse eid="PSA 119:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40" />N ciga ta̱ n yuwan tsutoni</para>
  <para style="q2" vid="PSA 119:40">ni ili i na vu zuwai a̱ kuru,</para>
  <para style="q1" vid="PSA 119:40">vu wawa wuma u va̱</para>
  <para style="q2" vid="PSA 119:40">a̱tsuma̱ a̱ a̱ɓula̱ a̱ wu.<verse eid="PSA 119:40" /></para>
  <para style="qa">Vav.</para>
  <para style="s">Ucawu wo okolo a̱ wila̱ wa̱ A̱sulazuva</para>
  <para style="b" />
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41" />A̱sulazuva, lyawa</para>
  <para style="q2" vid="PSA 119:41">icigi ya̱ wu i na i tsu vadala shi,</para>
  <para style="q1" vid="PSA 119:41">ni iwawi ya̱ wu</para>
  <para style="q2" vid="PSA 119:41">i ta̱wa̱ uba̱ta̱ u va̱,</para>
  <para style="q2" vid="PSA 119:41">cine vu yuwain nzuwulai,<verse eid="PSA 119:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42" />tsura̱ n ka̱mbuwa̱a̱</para>
  <para style="q2" vid="PSA 119:42">aza a na o goro numu na adanshi a̱ va̱,</para>
  <para style="q2" vid="PSA 119:42">adama a na n zuwaa ta̱ adanshi a̱ wu ucira.<verse eid="PSA 119:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43" />She vu tawa adanshi amayun,</para>
  <para style="q2" vid="PSA 119:43">diga o una̱ u va̱ wan,</para>
  <para style="q1" vid="PSA 119:43">adama a na n zuwa ta̱</para>
  <para style="q2" vid="PSA 119:43">okolo a̱ va̱ o uge'etosu wa̱ wu.<verse eid="PSA 119:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44" />N ta̱ kuru wila̱ wa̱ wu mantsa suru,</para>
  <para style="q2" vid="PSA 119:44">hali hali hali.<verse eid="PSA 119:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45" />N ta yuwan mmalu</para>
  <para style="q2" vid="PSA 119:45">okolo nven,</para>
  <para style="q1" vid="PSA 119:45">adama a na n ta̱ kurusu</para>
  <para style="q2" vid="PSA 119:45">ili i na vu zuwai na̱ a̱ kuru.<verse eid="PSA 119:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46" />N ta damma ili i na vu yuwain,</para>
  <para style="q2" vid="PSA 119:46">elime o ngono,</para>
  <para style="q2" vid="PSA 119:46">agba maa uwwa wono shi.<verse eid="PSA 119:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47" />Udammu wa̱ wu u ta casu mu ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 119:47">adama a na n te e icigi i le.<verse eid="PSA 119:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48" />N ta casu udammu wa̱ wu tsugbain,</para>
  <para style="q2" vid="PSA 119:48">n te e icigi i le,</para>
  <para style="q1" vid="PSA 119:48">waru n ta̱ da̱na̱ a majiyan,</para>
  <para style="q2" vid="PSA 119:48">me ili i na vu zuwai na̱ a̱ kuru.<verse eid="PSA 119:48" /></para>
  <para style="qa">Zayin.</para>
  <para style="s">Mazuwa mo ucira a̱ wila̱ wa̱ A̱sulazuva</para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49" />Cuwan na adanshi</para>
  <para style="q2" vid="PSA 119:49">a na vu yuwayin aagbashi a̱ wu,</para>
  <para style="q2" vid="PSA 119:49">na zuwa numu n zuwa ookolo.<verse eid="PSA 119:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50" />Ucasu wa adanshi a na n tsu tsura̱</para>
  <para style="q2" vid="PSA 119:50">a̱tsuma̱ a̱tsuma̱lima̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 119:50">a̱ yi ɗa nzuwulai ma̱ wu,</para>
  <para style="q2" vid="PSA 119:50">n na n tsu kambusa wuma u va̱.<verse eid="PSA 119:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51" />Aza aciyogbamu o goro mu ta̱ lon,</para>
  <para style="q2" vid="PSA 119:51">na̱ ne suru n vadalaa</para>
  <para style="q2" vid="PSA 119:51">wila̱ wa̱ wu ucina̱ shi.<verse eid="PSA 119:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52" />A̱sulazuva n cuwan ta̱ nu uge'etosu wa̱ wu</para>
  <para style="q2" vid="PSA 119:52">na vu ɗanai ɗe nu ujumu,</para>
  <para style="q1" vid="PSA 119:52">waru n tsura̱ ta̱</para>
  <para style="q2" vid="PSA 119:52">okolo nven a̱tsuma̱ e le.<verse eid="PSA 119:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53" />N tsu yuwan ta̱ upan lon,</para>
  <para style="q2" vid="PSA 119:53">mantsa ma na me enei</para>
  <para style="q2" vid="PSA 119:53">a̱za̱ e iwuya a lyawai</para>
  <para style="q2" vid="PSA 119:53">wila̱ wa̱ wu.<verse eid="PSA 119:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54" />Udammu wa̱ wu wo o'wo mu ta̱ tsi ishipa,</para>
  <para style="q2" vid="PSA 119:54">uba̱ta̱ u na n cu'wain suru.<verse eid="PSA 119:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55" />A̱sulazuva na ayin</para>
  <para style="q2" vid="PSA 119:55">n tsu cuwan ta̱ na aala a̱ wu,</para>
  <para style="q2" vid="PSA 119:55">waru n tsu yuwusan ta̱ tsutoni na̱ wila̱ wa̱ wu.<verse eid="PSA 119:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56" />A̱yi ɗa wo o'woi ulinga u va̱,</para>
  <para style="q2" vid="PSA 119:56">n yuwan tsutoni</para>
  <para style="q2" vid="PSA 119:56">ni ili i na vu zuwai na̱ a̱ kuru.<verse eid="PSA 119:56" /></para>
  <para style="qa">Chet.</para>
  <para style="s">Icigi i wila̱ wa̱ A̱sulazuva</para>
  <para style="b" />
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57" />A̱sulazuva, a̱vu ɗa</para>
  <para style="q2" vid="PSA 119:57">ili i na n ri na̱ yi,</para>
  <para style="q1" vid="PSA 119:57">n yuwan ta̱ nzuwulai</para>
  <para style="q2" vid="PSA 119:57">na mo toni adanshi a̱ wu.<verse eid="PSA 119:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58" />N ta̱ e ipati ya̱ wu</para>
  <para style="q2" vid="PSA 119:58">no okolo a̱ ta̱,</para>
  <para style="q1" vid="PSA 119:58">vu yuwaan mu isa'ani</para>
  <para style="q2" vid="PSA 119:58">cine vu yuwain nzuwulai.<verse eid="PSA 119:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59" />N petelyuwe ta̱ re va̱,</para>
  <para style="q2" vid="PSA 119:59">a̱vu n vadala a̱ tyo</para>
  <para style="q2" vid="PSA 119:59">e ili i na vu yuwain.<verse eid="PSA 119:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60" />N ta̱ jika̱,</para>
  <para style="q2" vid="PSA 119:60">waru ma̱a̱ lungusa̱ mantsa shi,</para>
  <para style="q2" vid="PSA 119:60">na maa yuwan tsutoni nu udammu wa̱ wu.<verse eid="PSA 119:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61" />Ko na̱ shi a̱za̱ e iwuya</para>
  <para style="q2" vid="PSA 119:61">a̱ nla̱ mu na amunga,</para>
  <para style="q2" vid="PSA 119:61">mee e icina na̱ wila̱ wa̱ wu shi.<verse eid="PSA 119:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62" />N ta̱ 'yon na ayin uɓatsu</para>
  <para style="q2" vid="PSA 119:62">n godyo wu,</para>
  <para style="q1" vid="PSA 119:62">adama o uge'etosu</para>
  <para style="q2" vid="PSA 119:62">wa̱ a̱ɓula̱ a̱ wu.<verse eid="PSA 119:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63" />A̱mu i utsa̱ ya aza a na</para>
  <para style="q2" vid="PSA 119:63">a uwwusa wovon wa̱ wu suru ɗa,</para>
  <para style="q1" vid="PSA 119:63">i utsa̱ ya aza a na o toniyi</para>
  <para style="q2" vid="PSA 119:63">ili i na vu zuwai a̱ kuru suru.<verse eid="PSA 119:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64" />A̱sulazuva, uvaɗi u shiwan ta̱</para>
  <para style="q2" vid="PSA 119:64">ni icigi ya̱ wu i na i tsu vadala shi suru,</para>
  <para style="q2" vid="PSA 119:64">vu rito mu udammu wa̱ wu.<verse eid="PSA 119:64" /></para>
  <para style="qa">Tet.</para>
  <para style="s">Ulobonu u wila̱ wa̱ A̱sulazuva</para>
  <para style="b" />
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65" />A̱sulazuva, vu yuwaan ta̱</para>
  <para style="q2" vid="PSA 119:65">aagbashi a̱ wu isa'ani</para>
  <para style="q2" vid="PSA 119:65">o una̱ wa adanshi a̱ wu.<verse eid="PSA 119:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66" />Vu ca mu ugbozu nu urevu,</para>
  <para style="q2" vid="PSA 119:66">adama a na n zuwaa ta̱</para>
  <para style="q2" vid="PSA 119:66">udammu wa̱ wu ucira.<verse eid="PSA 119:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67" />Kafu vu ca mu</para>
  <para style="q2" vid="PSA 119:67">oforo n tsu nusan ta̱,</para>
  <para style="q1" vid="PSA 119:67">amma gogo n ta yuwusan</para>
  <para style="q2" vid="PSA 119:67">tsutoni na adanshi a̱ wu.<verse eid="PSA 119:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68" />A̱vu za vi isa'ani ɗa,</para>
  <para style="q2" vid="PSA 119:68">a̱yi ɗa i zuwai vaa yuwusan isa'ani,</para>
  <para style="q2" vid="PSA 119:68">vu rito mu udammu wa̱ wu.<verse eid="PSA 119:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69" />Aza aciyogbamu a ta dansa epen aciya̱va̱,</para>
  <para style="q2" vid="PSA 119:69">amma n toni ta̱ ili i na vu zuwai a̱ kuru,</para>
  <para style="q2" vid="PSA 119:69">no okolo a̱ va̱ suru.<verse eid="PSA 119:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70" />Ookolo e le a gbawa ta̱,</para>
  <para style="q2" vid="PSA 119:70">agba a̱mu n ta̱ ma̱za̱nga̱ na̱ wila̱ wa̱ wu.<verse eid="PSA 119:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71" />Oforo a na a ca numu u lobono mu ta̱,</para>
  <para style="q2" vid="PSA 119:71">adama a na u zuwa ta̱ n rito udammu wa̱ wu.<verse eid="PSA 119:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72" />Wila̱ u na wu uta̱i diga o una̱ wa̱ wu,</para>
  <para style="q2" vid="PSA 119:72">ili isa'ani i ɗa uba̱ta̱ u va̱,</para>
  <para style="q2" vid="PSA 119:72">ula'awu na̱ ukpakukupa kupa u zinariya na̱ azurufa.<verse eid="PSA 119:72" /></para>
  <para style="qa">Yud.</para>
  <para style="s">Uge'etosu wa̱ a̱ɓula̱ a̱ A̱sulazuva</para>
  <para style="b" />
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73" />Ekere a̱ wu a ɗa</para>
  <para style="q2" vid="PSA 119:73">a yuwan numu</para>
  <para style="q2" vid="PSA 119:73">a̱vu o foɓo mu,</para>
  <para style="q1" vid="PSA 119:73">vu ca mu urevu,</para>
  <para style="q2" vid="PSA 119:73">adama n rito</para>
  <para style="q2" vid="PSA 119:73">udammu wa̱ wu.<verse eid="PSA 119:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74" />Lyawa aza a na</para>
  <para style="q2" vid="PSA 119:74">a uwwusa wovon wa̱ wu</para>
  <para style="q2" vid="PSA 119:74">a yuwan ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 119:74">a mantsa ma na ene numu,</para>
  <para style="q1" vid="PSA 119:74">adama a na n zuwa ta̱ ucira u va̱</para>
  <para style="q2" vid="PSA 119:74">adanshi a̱ wu.<verse eid="PSA 119:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75" />A̱sulazuva, n reve ta̱</para>
  <para style="q2" vid="PSA 119:75">a na uge'etosu wa̱ wu a̱ɓula̱ a ɗa</para>
  <para style="q1" vid="PSA 119:75">a̱tsuma̱ amayun a̱ wu,</para>
  <para style="q2" vid="PSA 119:75">vu ca mu ta̱ a̱tsuma̱lima̱.<verse eid="PSA 119:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76" />Lyawa icigi ya̱ wu i na i tsu vadala shi,</para>
  <para style="q2" vid="PSA 119:76">i kamba mu,</para>
  <para style="q1" vid="PSA 119:76">cine vu yuwaayin</para>
  <para style="q2" vid="PSA 119:76">aagbashi a̱ wu nzuwulai.<verse eid="PSA 119:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77" />Lyawa isa'ani ya̱ wu i ta̱wa̱ ya̱'a̱ va̱,</para>
  <para style="q2" vid="PSA 119:77">adama n da̱na̱ wuma,</para>
  <para style="q1" vid="PSA 119:77">adama a na wila̱ wa̱ wu u ɗa</para>
  <para style="q2" vid="PSA 119:77">ma̱za̱nga̱ ma̱ va̱.<verse eid="PSA 119:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78" />Lyawa aza aciyogbamu</para>
  <para style="q2" vid="PSA 119:78">a uwwa wono,</para>
  <para style="q1" vid="PSA 119:78">adama a na a damma ta̱</para>
  <para style="q2" vid="PSA 119:78">ili i na e revei shi a aci a̱ va̱,</para>
  <para style="q1" vid="PSA 119:78">agba a̱mu n ta̱ da̱na̱ a majiyan,</para>
  <para style="q2" vid="PSA 119:78">me ili i na vu zuwai a̱ kuru.<verse eid="PSA 119:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79" />Lyawa aza a na</para>
  <para style="q2" vid="PSA 119:79">a uwwusa wovon wa̱ wu,</para>
  <para style="q1" vid="PSA 119:79">aza a na e revei ili i na vu yuwain,</para>
  <para style="q2" vid="PSA 119:79">a̱ da̱na̱ oɓolo na̱ mu.<verse eid="PSA 119:79" /></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80" />Lyawa okolo a̱ va̱</para>
  <para style="q2" vid="PSA 119:80">a̱ da̱na̱ na amayun,</para>
  <para style="q2" vid="PSA 119:80">o udammu wa̱ wu,</para>
  <para style="q1" vid="PSA 119:80">adama mu uwwa</para>
  <para style="q2" vid="PSA 119:80">wono wan.<verse eid="PSA 119:80" /></para>
  <para style="qa">Kaf.</para>
  <para style="s">Avasa e izami yi iwawi</para>
  <para style="b" />
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81" />A̱sulazuva wuma u va̱</para>
  <para style="q2" vid="PSA 119:81">u ta maluwa me iwawi ya̱ wu lon,</para>
  <para style="q1" vid="PSA 119:81">waru n zuwa ta̱ okolo a̱ va̱</para>
  <para style="q2" vid="PSA 119:81">a danshi a̱ wu.<verse eid="PSA 119:81" /></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82" />Esu a̱ va̱ a̱ kuna̱ ta̱,</para>
  <para style="q2" vid="PSA 119:82">e ipiri yi nzuwulai ma̱ wu,</para>
  <para style="q1" vid="PSA 119:82">a̱vu n damma,&lt;&lt;Mantsa ma ne ma ɗa</para>
  <para style="q2" vid="PSA 119:82">vaa ca mu adanshi?&gt;&gt;<verse eid="PSA 119:82" /></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83" />Ko na wo o'woi,</para>
  <para style="q2" vid="PSA 119:83">mo o'wo ta̱ tsa̱ tsa̱n vu ukwan</para>
  <para style="q2" vid="PSA 119:83">u masayan ma̱ ina̱bi ma na a variyi,</para>
  <para style="q1" vid="PSA 119:83">na̱ ne suru mi icina,</para>
  <para style="q2" vid="PSA 119:83">nu udammu wa̱ wu shi.<verse eid="PSA 119:83" /></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84" />Hali mantsa ma̱ ne</para>
  <para style="q2" vid="PSA 119:84">aagbashi a̱ wu o puro?</para>
  <para style="q1" vid="PSA 119:84">Mantsa ma̱ ne vee ge'eto,</para>
  <para style="q2" vid="PSA 119:84">aza a na e le'eshe numu?<verse eid="PSA 119:84" /></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85" />Aza aciyogbamu,</para>
  <para style="q2" vid="PSA 119:85">a̱ ka̱pa̱a̱ mu ta̱ a̱ka̱ri e iwuya,</para>
  <para style="q1" vid="PSA 119:85">aza a na aa yuwusan</para>
  <para style="q2" vid="PSA 119:85">tsutoni na̱ wila̱ wa̱ wu shi.<verse eid="PSA 119:85" /></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86" />Udammu wa̱ wu suru</para>
  <para style="q2" vid="PSA 119:86">ili i na aa zuwaa ucira u ɗa,</para>
  <para style="q1" vid="PSA 119:86">vu kamba mu,</para>
  <para style="q2" vid="PSA 119:86">adama a na a 'yuwan mu ta̱</para>
  <para style="q2" vid="PSA 119:86">babu ufaru!<verse eid="PSA 119:86" /></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87" />Ke'en ɗa shi buwai</para>
  <para style="q2" vid="PSA 119:87">o kototo mu o uvaɗi,</para>
  <para style="q1" vid="PSA 119:87">agba n lyawa</para>
  <para style="q2" vid="PSA 119:87">ili i na vu zuwai a̱ kuru shi.<verse eid="PSA 119:87" /></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88" />Vu yuwaan mu isa'ani,</para>
  <para style="q2" vid="PSA 119:88">adama e icigi ya̱ wu i na i tsu vadala shi,</para>
  <para style="q1" vid="PSA 119:88">adama n yuwan tsutoni</para>
  <para style="q2" vid="PSA 119:88">ni ili i na vu yuwain, nu una̱ wa̱ wu.<verse eid="PSA 119:88" /></para>
  <para style="qa">Lamed.</para>
  <para style="s">Uzuwu wo okolo a̱ wila̱ wa̱ a̱ A̱sulazuva</para>
  <para style="b" />
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89" />A̱sulazuva, adanshi a̱ wu</para>
  <para style="q2" vid="PSA 119:89">a̱ ri nu ukosu shi</para>
  <para style="q2" vid="PSA 119:89">u shuwa̱ ta̱ ɗe zuva.<verse eid="PSA 119:89" /></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90" />Amayun a̱ wu a̱ ta̱ lo</para>
  <para style="q2" vid="PSA 119:90">diga a mantsa a̱ tyo a mantsa,</para>
  <para style="q1" vid="PSA 119:90">vu shuwa̱ ta̱ uvaɗi</para>
  <para style="q2" vid="PSA 119:90">reve wu uwwa ushuwu.<verse eid="PSA 119:90" /></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91" />Uge'etosu wa̱ wu u ta̱ lo,</para>
  <para style="q2" vid="PSA 119:91">hali acina ana'an</para>
  <para style="q1" vid="PSA 119:91">adama a na ili suru</para>
  <para style="q2" vid="PSA 119:91">i ta yuwusan wu a̱ga̱nda̱.<verse eid="PSA 119:91" /></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92" />Na̱ shi wila̱ wa̱ wu u ɗa</para>
  <para style="q2" vid="PSA 119:92">u zuwa numu ma̱za̱nga̱ shi,</para>
  <para style="q1" vid="PSA 119:92">n shi ta̱ a̱ kuwa̱</para>
  <para style="q2" vid="PSA 119:92">a̱tsuma̱ a̱tsuma̱lima̱ a̱ va̱.<verse eid="PSA 119:92" /></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93" />Mee e icina ni ili i na</para>
  <para style="q2" vid="PSA 119:93">vu zuwai a̱ kuru shi,</para>
  <para style="q1" vid="PSA 119:93">adama a na e ekere e le ɗa</para>
  <para style="q2" vid="PSA 119:93">vu wawai wuma u va̱.<verse eid="PSA 119:93" /></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94" />Wawa mu,</para>
  <para style="q2" vid="PSA 119:94">adama a na a̱mu za va̱ wu ɗa,</para>
  <para style="q1" vid="PSA 119:94">adama a na n yuwan ta̱ ukadu</para>
  <para style="q2" vid="PSA 119:94">e itoni yi ili i na vu zuwai a̱ kuru.<verse eid="PSA 119:94" /></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95" />A̱za̱ e iwuya a ta pura</para>
  <para style="q2" vid="PSA 119:95">o kototo mu,</para>
  <para style="q1" vid="PSA 119:95">amma n ta̱ da̱na̱ a majiyan</para>
  <para style="q2" vid="PSA 119:95">mee e ili i na vu yuwain.<verse eid="PSA 119:95" /></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96" />Mee ene ta̱ ukosu wi ili biti,</para>
  <para style="q2" vid="PSA 119:96">agba udammu wa̱ wu</para>
  <para style="q2" vid="PSA 119:96">u ri nu ukosu shi.<verse eid="PSA 119:96" /></para>
  <para style="qa">Mem.</para>
  <para style="s">Icigi i wila̱ wa̱ a̱ A̱sulazuva</para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97" />Apa cine n ri e icigi</para>
  <para style="q2" vid="PSA 119:97">i wila̱ ya̱ wu!</para>
  <para style="q1" vid="PSA 119:97">N ta majiyan ma̱ yi</para>
  <para style="q2" vid="PSA 119:97">urana ma̱ɓula̱.<verse eid="PSA 119:97" /></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98" />Wila̱ wa̱ wu u zuwa mu ta̱</para>
  <para style="q2" vid="PSA 119:98">n yuwan ugbozu</para>
  <para style="q2" vid="PSA 119:98">ula'awu na̱ n'yuwatan n va̱</para>
  <para style="q1" vid="PSA 119:98">adama a na u ta̱ oɓolo na̱ mu</para>
  <para style="q2" vid="PSA 119:98">mantsa suru.<verse eid="PSA 119:98" /></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99" />N la'a ta̱ munlu n va̱ suru urevu,</para>
  <para style="q2" vid="PSA 119:99">adama a na n ta majiyan</para>
  <para style="q2" vid="PSA 119:99">mee e ili i na vu yuwain.<verse eid="PSA 119:99" /></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100" />N la'a ta̱ mbara urevu,</para>
  <para style="q2" vid="PSA 119:100">adama a na n ta yuwusan tsutoni</para>
  <para style="q2" vid="PSA 119:100">ni ili i na vu zuwai a̱ kuru.<verse eid="PSA 119:100" /></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101" />N 'yuwan ta̱ iɓolo</para>
  <para style="q2" vid="PSA 119:101">ya̱ a̱za̱ e iwuya suru,</para>
  <para style="q1" vid="PSA 119:101">adama n guza̱</para>
  <para style="q2" vid="PSA 119:101">adanshi a̱ wu.<verse eid="PSA 119:101" /></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102" />N vadalaa uge'etosu</para>
  <para style="q2" vid="PSA 119:102">wa̱ wu ucina̱ shi,</para>
  <para style="q1" vid="PSA 119:102">adama a na a̱vu ɗa</para>
  <para style="q2" vid="PSA 119:102">vu rito numu.<verse eid="PSA 119:102" /></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103" />Cine m peɗei idanshi ya̱ wu a̱ ta̱ a̱limu lon,</para>
  <para style="q2" vid="PSA 119:103">ula'awu na̱ a̱limu e ishiki</para>
  <para style="q2" vid="PSA 119:103">o una̱ u va̱!<verse eid="PSA 119:103" /></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104" />N tsura̱ ta̱ urevu,</para>
  <para style="q2" vid="PSA 119:104">e ili i na vu zuwai a̱ kuru,</para>
  <para style="q1" vid="PSA 119:104">adama o ndolo n 'yuwan ta̱,</para>
  <para style="q2" vid="PSA 119:104">ure wi iwuya suru.<verse eid="PSA 119:104" /></para>
  <para style="qa">Nun.</para>
  <para style="s">Wila̱ wa̱ a̱ A̱sulazuva ekan i ɗa</para>
  <para style="b" />
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105" />Adanshi a̱ wu fitila ɗa,</para>
  <para style="q2" vid="PSA 119:105">na tsu casu ekan</para>
  <para style="q2" vid="PSA 119:105">uba̱ta̱ u na n tyo yi biti.<verse eid="PSA 119:105" /></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106" />N yuwan ta̱ akucunu,</para>
  <para style="q2" vid="PSA 119:106">agba ma̱a̱ ka̱mba̱ a̱ca̱pa̱ shi,</para>
  <para style="q1" vid="PSA 119:106">n to toni uge'etosu</para>
  <para style="q2" vid="PSA 119:106">wa̱ a̱ɓula̱ a̱ wu.<verse eid="PSA 119:106" /></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107" />A̱sulazuva, n sowo ta̱</para>
  <para style="q2" vid="PSA 119:107">a̱tsuma̱lima̱ a̱bunda̱,</para>
  <para style="q1" vid="PSA 119:107">vu ca mu wuma u sa'avu,</para>
  <para style="q2" vid="PSA 119:107">ununa adanshi a̱ wu a dammai.<verse eid="PSA 119:107" /></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108" />A̱sulazuva, vu usu akucunu a na n tarai</para>
  <para style="q2" vid="PSA 119:108">reve fo vu rito mu uge'etosu wa̱ wu.<verse eid="PSA 119:108" /></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109" />Ko na wo o'woi</para>
  <para style="q2" vid="PSA 119:109">n tsu tarasa ta̱ wuma u va̱</para>
  <para style="q2" vid="PSA 119:109">e ekere a̱ va̱,</para>
  <para style="q1" vid="PSA 119:109">mee e icina</para>
  <para style="q2" vid="PSA 119:109">na̱ wila̱ wa̱ wu shi.<verse eid="PSA 119:109" /></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110" />A̱za̱ e iwuya</para>
  <para style="q2" vid="PSA 119:110">o foɓoo mu ta̱ maza,</para>
  <para style="q1" vid="PSA 119:110">amma na̱ ne suru,</para>
  <para style="q2" vid="PSA 119:110">n lyawa itoni</para>
  <para style="q2" vid="PSA 119:110">yi ili i na vu zuwai a̱ kuru shi.<verse eid="PSA 119:110" /></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111" />Ili i na vu yuwain ɗa</para>
  <para style="q2" vid="PSA 119:111">ili ya agadu a̱ va̱ hali hali,</para>
  <para style="q1" vid="PSA 119:111">ele ɗa ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 119:111">mo okolo a̱ va̱.<verse eid="PSA 119:111" /></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112" />N zuwa ta̱ okolo a̱ va̱</para>
  <para style="q2" vid="PSA 119:112">na moo toni udammu wa̱ wu,</para>
  <para style="q2" vid="PSA 119:112">hali ukwisa̱ u va̱.<verse eid="PSA 119:112" /></para>
  <para style="qa">Sameck.</para>
  <para style="s">Mapari a̱tsuma̱ a̱ wila̱ wa̱ a̱ A̱sulazuva</para>
  <para style="b" />
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113" />N 'yuwan ta̱ aza a na a̱ ri na̱ na̱ re re,</para>
  <para style="q2" vid="PSA 119:113">amma n te e icigi i wila̱ ya̱ wu.<verse eid="PSA 119:113" /></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114" />A̱vu ɗa upa'atan u va̱</para>
  <para style="q2" vid="PSA 119:114">na̱ a̱a̱ra̱ga̱ a̱ va̱,</para>
  <para style="q1" vid="PSA 119:114">n zuwa ta̱ okolo a̱ va̱</para>
  <para style="q2" vid="PSA 119:114">adanshi a̱ wu.<verse eid="PSA 119:114" /></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115" />Kakasa yi na̱ a̱mu</para>
  <para style="q2" vid="PSA 119:115">a̱ɗu a̱za̱ e iwuya,</para>
  <para style="q1" vid="PSA 119:115">adama n kuru</para>
  <para style="q2" vid="PSA 119:115">udammu wa̱ A̱sula̱ a̱ va̱.<verse eid="PSA 119:115" /></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116" />Vu ca mu adanshi</para>
  <para style="q2" vid="PSA 119:116">cine vu yuwain nzuwulai,</para>
  <para style="q1" vid="PSA 119:116">tsa̱ra̱ n da̱na̱ wuma,</para>
  <para style="q2" vid="PSA 119:116">she vu lyawa ucawu wo okolo a̱ va̱</para>
  <para style="q2" vid="PSA 119:116">wo o'wo pere wan.<verse eid="PSA 119:116" /></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117" />Vu guza̱ mu,</para>
  <para style="q2" vid="PSA 119:117">adama n tsura̱ iwawi,</para>
  <para style="q1" vid="PSA 119:117">n ta̱ ka̱mbuwa̱</para>
  <para style="q2" vid="PSA 119:117">ugbozu u va̱ suru,</para>
  <para style="q2" vid="PSA 119:117">o udammu wa̱ wu.<verse eid="PSA 119:117" /></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118" />Vu 'yuwan ta̱</para>
  <para style="q2" vid="PSA 119:118">aza a na a vadalaa yi</para>
  <para style="q2" vid="PSA 119:118">udammu wa̱ wu suru ucina̱,</para>
  <para style="q1" vid="PSA 119:118">adama a na a̱lumu le</para>
  <para style="q2" vid="PSA 119:118">epen a ɗa.<verse eid="PSA 119:118" /></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119" />Vu tsu vari ta̱</para>
  <para style="q2" vid="PSA 119:119">aza a na a yuwusan iwuya o uvaɗi,</para>
  <para style="q2" vid="PSA 119:119">cine vu revei everi,</para>
  <para style="q1" vid="PSA 119:119">adama o ndolo a ɗa</para>
  <para style="q2" vid="PSA 119:119">n cigai ili i na vu yuwain.<verse eid="PSA 119:119" /></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120" />Lipu va̱ ta̱ e meje'en</para>
  <para style="q2" vid="PSA 119:120">adama o wovon wa̱ wu,</para>
  <para style="q1" vid="PSA 119:120">n ta uwwusa wovon</para>
  <para style="q2" vid="PSA 119:120">wu uge'etosu wa̱ wu.<verse eid="PSA 119:120" /></para>
  <para style="qa">Ayin.</para>
  <para style="s">Tsutoni na̱ wila̱ wa̱ A̱sulazuva</para>
  <para style="b" />
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121" />N yuwan ta̱ ili ya̱ a̱ɓula̱ oɓolo na amayun,</para>
  <para style="q2" vid="PSA 119:121">she vu lyawa mu e ekere</para>
  <para style="q2" vid="PSA 119:121">aza na o ɓongishi mu wan.<verse eid="PSA 119:121" /></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122" />Vu lyawa aagbashi a̱ wu,</para>
  <para style="q2" vid="PSA 119:122">a̱ da̱na̱ gbaga,</para>
  <para style="q1" vid="PSA 119:122">she vu lyawa aza aciyogbamu,</para>
  <para style="q2" vid="PSA 119:122">o ɓongi mu wan.<verse eid="PSA 119:122" /></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123" />Esu a̱ va̱ a̱ kuna̱ ta̱</para>
  <para style="q2" vid="PSA 119:123">a pura iwawi ya̱ wu,</para>
  <para style="q1" vid="PSA 119:123">e idanasa nzuwulai</para>
  <para style="q2" vid="PSA 119:123">ma̱ a̱ɓula̱ a̱ wu.<verse eid="PSA 119:123" /></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124" />Vu kuru na̱ a̱mu aagbashi a̱ wu,</para>
  <para style="q2" vid="PSA 119:124">o una̱ wi icigi ya̱ wu i na i tsu vadala shi,</para>
  <para style="q2" vid="PSA 119:124">vu rito mu udammu wa̱ wu.<verse eid="PSA 119:124" /></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125" />A̱mu aagbashi a̱ wu a ɗa,</para>
  <para style="q2" vid="PSA 119:125">adama o ndolo vu ca mu urevu,</para>
  <para style="q2" vid="PSA 119:125">adama n reve ili i na vu yuwain.<verse eid="PSA 119:125" /></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126" />A̱sulazuva, mantsa ma yuwan ta̱</para>
  <para style="q2" vid="PSA 119:126">na va yuwan ili i ro,</para>
  <para style="q2" vid="PSA 119:126">adama a na a kuɗa ta̱ wila̱ wa̱ wu.<verse eid="PSA 119:126" /></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127" />N ta̱ e icigi yu udammu ya̱ wu,</para>
  <para style="q2" vid="PSA 119:127">ula'awu na̱ zinariya,</para>
  <para style="q2" vid="PSA 119:127">na amayun, ula'awu na̱ zinariya can.<verse eid="PSA 119:127" /></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128" />Adama o ndolo a ɗa mo tono</para>
  <para style="q2" vid="PSA 119:128">ili i na vu zuwai a̱ kuru,</para>
  <para style="q2" vid="PSA 119:128">reve n 'yuwan ure we epen suru.<verse eid="PSA 119:128" /></para>
  <para style="qa">Pe.</para>
  <para style="s">Maluwa ma̱ tsutoni na̱ wila̱ wa̱ a̱ A̱sulazuva</para>
  <para style="b" />
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129" />Ili i na vu yuwain ili ya asalama a ɗa,</para>
  <para style="q2" vid="PSA 119:129">adama o ndolo a ɗa okolo a̱ va̱</para>
  <para style="q2" vid="PSA 119:129">aa yuwusan tsutoni ne le.<verse eid="PSA 119:129" /></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130" />Ucuɗuwu wa adanshi a̱ wu</para>
  <para style="q2" vid="PSA 119:130">u tsu ca ta̱ ekan,</para>
  <para style="q1" vid="PSA 119:130">reve u zuwa aza a na e revei ili shi,</para>
  <para style="q2" vid="PSA 119:130">a yuwan ugbozu.<verse eid="PSA 119:130" /></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131" />N kpa̱tu'wa̱ ta̱ una̱ u va̱,</para>
  <para style="q2" vid="PSA 119:131">e ivuwusan zuva zuva</para>
  <para style="q1" vid="PSA 119:131">adama a maluwa</para>
  <para style="q2" vid="PSA 119:131">mo udammu wa̱ wu.<verse eid="PSA 119:131" /></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132" />Vadala ya̱'a̱ va̱</para>
  <para style="q2" vid="PSA 119:132">vee ene iliyali i va̱,</para>
  <para style="q1" vid="PSA 119:132">cine wila̱ wa̱ wu u ri</para>
  <para style="q2" vid="PSA 119:132">e ekere aza a na a̱ ri</para>
  <para style="q2" vid="PSA 119:132">e icigi ya aala a̱ wu.<verse eid="PSA 119:132" /></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133" />Idana udasuwu u va̱,</para>
  <para style="q2" vid="PSA 119:133">o una̱ wa adanshi a̱ wu,</para>
  <para style="q1" vid="PSA 119:133">she vu lyawa unusu</para>
  <para style="q2" vid="PSA 119:133">u lyuwa a aci a̱ va̱ wan.<verse eid="PSA 119:133" /></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134" />Wawa mu</para>
  <para style="q2" vid="PSA 119:134">diga aza a na</para>
  <para style="q2" vid="PSA 119:134">e le'eshe mu,</para>
  <para style="q1" vid="PSA 119:134">adama n kuru</para>
  <para style="q2" vid="PSA 119:134">ili i na vu zuwai a̱ kuru.<verse eid="PSA 119:134" /></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135" />Vu zuwa urewesu wa̱ wu</para>
  <para style="q2" vid="PSA 119:135">wi ikana aagbashi a̱ wu.</para>
  <para style="q1" vid="PSA 119:135">Reve vu rito mu</para>
  <para style="q2" vid="PSA 119:135">wila̱ wa̱ wu.<verse eid="PSA 119:135" /></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136" />Moo oco ta̱</para>
  <para style="q2" vid="PSA 119:136">aɓara lon tsa̱ oko'o,</para>
  <para style="q1" vid="PSA 119:136">adama a na a̱ kuru,</para>
  <para style="q2" vid="PSA 119:136">wila̱ wa̱ wu shi.<verse eid="PSA 119:136" /></para>
  <para style="qa">Tsadik.</para>
  <para style="s">Amayun a̱ wila̱ wa̱ a̱ A̱sulazuva</para>
  <para style="b" />
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137" />A̱sulazuva a̱vu,</para>
  <para style="q2" vid="PSA 119:137">za va̱ a̱ɓula̱ a ɗa,</para>
  <para style="q1" vid="PSA 119:137">waru uge'etosu wa̱ wu</para>
  <para style="q2" vid="PSA 119:137">mejege ma ɗa.<verse eid="PSA 119:137" /></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138" />Ili i na vu yuwain</para>
  <para style="q2" vid="PSA 119:138">a̱za̱ a̱ a̱ɓula̱ a ɗa</para>
  <para style="q2" vid="PSA 119:138">waru aza a amayun a ɗa suru.<verse eid="PSA 119:138" /></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139" />N tsu yuwan ta̱ a̱tsumola̱ngu lon</para>
  <para style="q2" vid="PSA 119:139">adama a na n'yuwatan n va̱</para>
  <para style="q2" vid="PSA 119:139">n 'yuwain adanshi a̱ wu.<verse eid="PSA 119:139" /></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140" />A kurato ta̱</para>
  <para style="q2" vid="PSA 119:140">nzuwulai ma̱ wu suru,</para>
  <para style="q1" vid="PSA 119:140">waru aagbashi a̱ wu</para>
  <para style="q2" vid="PSA 119:140">a̱ ta̱ e icigi i le lon.<verse eid="PSA 119:140" /></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141" />Ko na wo o'woi</para>
  <para style="q2" vid="PSA 119:141">a̱mu ili i ɗa shi,</para>
  <para style="q2" vid="PSA 119:141">waru o goro mu ta̱,</para>
  <para style="q1" vid="PSA 119:141">na̱ ne suru, mee e icina</para>
  <para style="q2" vid="PSA 119:141">ni ili i na vu zuwai a̱ kuru shi.<verse eid="PSA 119:141" /></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142" />A̱ɓula̱ a̱ wu a̱ ta̱ na̱ a̱ɓula̱, hali hali,</para>
  <para style="q2" vid="PSA 119:142">waru wila̱ wa̱ wu amayun a ɗa.<verse eid="PSA 119:142" /></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143" />Meleshe na̱ a̱tsuma̱lima̱</para>
  <para style="q2" vid="PSA 119:143">aa cina mu ta̱,</para>
  <para style="q1" vid="PSA 119:143">amma udammu wa̱ wu u ɗa</para>
  <para style="q2" vid="PSA 119:143">ma̱za̱nga̱ ma̱ va̱.<verse eid="PSA 119:143" /></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144" />Ili i na vu yuwain</para>
  <para style="q2" vid="PSA 119:144">a̱za̱ a̱ a̱ɓula̱ a ɗa hali hali,</para>
  <para style="q2" vid="PSA 119:144">a ta casu mu urevu adama n da̱na̱ wuma.<verse eid="PSA 119:144" /></para>
  <para style="qa">Kof.</para>
  <para style="s">Avasa adama e iwawi</para>
  <para style="b" />
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145" />A̱sulazuva n ɗe ta̱</para>
  <para style="q2" vid="PSA 119:145">no okolo a̱ ta̱</para>
  <para style="q2" vid="PSA 119:145">vu usu mu,</para>
  <para style="q1" vid="PSA 119:145">waru n ta̱ kuru</para>
  <para style="q2" vid="PSA 119:145">udammu wa̱ wu.<verse eid="PSA 119:145" /></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146" />N ɗewu ta̱,</para>
  <para style="q2" vid="PSA 119:146">vu wawa mu!</para>
  <para style="q1" vid="PSA 119:146">Waru n ta̱ kuru</para>
  <para style="q2" vid="PSA 119:146">ili i na vu yuwain.<verse eid="PSA 119:146" /></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147" />Kafu usana n tsu 'yon ta̱ n showen wu,</para>
  <para style="q2" vid="PSA 119:147">adama e izami yi ikambishi,</para>
  <para style="q1" vid="PSA 119:147">waru n zuwa ta̱ okolo a̱ va̱</para>
  <para style="q2" vid="PSA 119:147">adanshi a̱ wu.<verse eid="PSA 119:147" /></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148" />Ayin ma̱ɓula̱ n lantsa shi,</para>
  <para style="q2" vid="PSA 119:148">a majiyan ma nzuwulai ma̱ wu.<verse eid="PSA 119:148" /></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149" />A̱sulazuva, vu uwwa uɗyo u va̱,</para>
  <para style="q2" vid="PSA 119:149">o una̱ wi icigi ya̱ wu i na i tsu vadala shi,</para>
  <para style="q1" vid="PSA 119:149">vu wawa wuma u va̱</para>
  <para style="q2" vid="PSA 119:149">o una̱ wu uge'etosu wa̱ wu.<verse eid="PSA 119:149" /></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150" />A̱za̱ e ifoɓi yi iwuya a̱ ta̱ zuzu na̱ a̱mu,</para>
  <para style="q2" vid="PSA 119:150">waru a ta alanga nu udammu wa̱ wu.<verse eid="PSA 119:150" /></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151" />Na̱ ne suru, A̱sulazuva vu ta̱ zuzu,</para>
  <para style="q2" vid="PSA 119:151">waru udammu wa̱ wu suru amayun a ɗa.<verse eid="PSA 119:151" /></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152" />Ɗe nu ujumu n rito ta̱</para>
  <para style="q2" vid="PSA 119:152">diga a̱tsuma̱ e ili i na vu yuwain,</para>
  <para style="q2" vid="PSA 119:152">waru a̱vu ɗa vu shuwa̱ nle hali hali.<verse eid="PSA 119:152" /></para>
  <para style="qa">Resh.</para>
  <para style="s">Ipati adama e ikambishi</para>
  <para style="b" />
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153" />Ka̱lyuwa̱ a̱tsuma̱lima̱ a̱ va̱</para>
  <para style="q2" vid="PSA 119:153">vu wawa mu,</para>
  <para style="q1" vid="PSA 119:153">adama a na mi icina</para>
  <para style="q2" vid="PSA 119:153">na̱ wila̱ wa̱ wu shi.<verse eid="PSA 119:153" /></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154" />Vi isawaan mu</para>
  <para style="q2" vid="PSA 119:154">vu tsupaa mu,</para>
  <para style="q1" vid="PSA 119:154">vu wawa wuma u va̱</para>
  <para style="q2" vid="PSA 119:154">cine vu yuwain adanshi.<verse eid="PSA 119:154" /></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155" />Iwawi i yuwan ta̱</para>
  <para style="q2" vid="PSA 119:155">alanga na̱ a̱za̱ e iwuya,</para>
  <para style="q1" vid="PSA 119:155">adama a na a zami</para>
  <para style="q2" vid="PSA 119:155">e reve udammu wa̱ wu shi.<verse eid="PSA 119:155" /></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156" />A̱sulazuva, iliyali ya̱ wu</para>
  <para style="q2" vid="PSA 119:156">i ta̱ a̱bunda̱ lon,</para>
  <para style="q1" vid="PSA 119:156">vi idana wuma u va̱</para>
  <para style="q2" vid="PSA 119:156">o una̱ wu uge'etosu wa̱ wu.<verse eid="PSA 119:156" /></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157" />Aza a na e le'eshe mu</para>
  <para style="q2" vid="PSA 119:157">a̱ ta̱ a̱bunda̱ lon,</para>
  <para style="q1" vid="PSA 119:157">amma n vadalaa</para>
  <para style="q2" vid="PSA 119:157">ili i na vu yuwain ucina̱ shi.<verse eid="PSA 119:157" /></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158" />Mantsa ma na me enei</para>
  <para style="q2" vid="PSA 119:158">a̱za̱ o ulambu wa̱ a̱ɓula̱,</para>
  <para style="q2" vid="PSA 119:158">n tsa̱ ene ta̱ idaba i le lon.</para>
  <para style="q1" vid="PSA 119:158">Adama a na a̱ kuru</para>
  <para style="q2" vid="PSA 119:158">adanshi a̱ wu shi.<verse eid="PSA 119:158" /></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159" />A̱sulazuva, ka̱lyuwa̱ cine n ri e icigi</para>
  <para style="q2" vid="PSA 119:159">yu udammu ya̱ wu,</para>
  <para style="q1" vid="PSA 119:159">vi idana mu o una̱ wi icigi</para>
  <para style="q2" vid="PSA 119:159">ya̱ wu i na i tsu vadala shi.<verse eid="PSA 119:159" /></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160" />Idanshi ya̱ wu suru amayun a ɗa,</para>
  <para style="q2" vid="PSA 119:160">waru uge'etosu wa̱ wu suru,</para>
  <para style="q2" vid="PSA 119:160">a̱za̱ a̱ɓula̱ a ɗa hali hali.<verse eid="PSA 119:160" /></para>
  <para style="qa">Shin.</para>
  <para style="s">Uka̱mbusa̱ wu ugbozu a̱ wila̱ a̱ A̱sulazuva</para>
  <para style="b" />
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161" />Ozo o tsugono e le'e mu ta̱</para>
  <para style="q2" vid="PSA 119:161">babu ufaru,</para>
  <para style="q1" vid="PSA 119:161">agba okolo a̱ va̱</para>
  <para style="q2" vid="PSA 119:161">a̱ ta̱ o wovon</para>
  <para style="q2" vid="PSA 119:161">wa adanshi a̱ wu.<verse eid="PSA 119:161" /></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162" />N ta̱ ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 119:162">na adanshi a̱ wu,</para>
  <para style="q1" vid="PSA 119:162">tsa za na tsura̱i</para>
  <para style="q2" vid="PSA 119:162">utsuru wa̱ a̱bunda̱ diga uba̱ta̱ wu uvon.<verse eid="PSA 119:162" /></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163" />N 'yuwan ta̱ epen,</para>
  <para style="q2" vid="PSA 119:163">waru n ta̱ eneshe yi idaba,</para>
  <para style="q1" vid="PSA 119:163">amma n ta̱ e icigi</para>
  <para style="q2" vid="PSA 119:163">i wila̱ ya̱ wu.<verse eid="PSA 119:163" /></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164" />N tsu cuwa wu ta̱</para>
  <para style="q2" vid="PSA 119:164">ucindere o urana suru,</para>
  <para style="q1" vid="PSA 119:164">adama o uge'etosu</para>
  <para style="q2" vid="PSA 119:164">wa̱ a̱ɓula̱ a̱ wu.<verse eid="PSA 119:164" /></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165" />Aza a na a cigai</para>
  <para style="q2" vid="PSA 119:165">wila̱ wa̱ wu,</para>
  <para style="q2" vid="PSA 119:165">a̱ ta̱ na̱ asuvu nden,</para>
  <para style="q1" vid="PSA 119:165">agba ili yi lo na yaa zuwa le</para>
  <para style="q2" vid="PSA 119:165">a̱ ta̱ɗa̱tsa̱ shi.<verse eid="PSA 119:165" /></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166" />A̱sulazuva, n zuwa ta̱</para>
  <para style="q2" vid="PSA 119:166">okolo a̱ va̱ e iwawi ya̱ wu,</para>
  <para style="q2" vid="PSA 119:166">waru n kuru ta̱ udammu wa̱ wu.<verse eid="PSA 119:166" /></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167" />N yuwan ta̱ tsutoni</para>
  <para style="q2" vid="PSA 119:167">ni ili i na vu yuwain</para>
  <para style="q2" vid="PSA 119:167">adama a na n ciga le ta̱ lon.<verse eid="PSA 119:167" /></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168" />N kuru ta̱ udammu wa̱ wu</para>
  <para style="q2" vid="PSA 119:168">ni ili i na vu yuwain,</para>
  <para style="q2" vid="PSA 119:168">adama a na vu reve ta̱ re va̱ suru.<verse eid="PSA 119:168" /></para>
  <para style="qa">Tav.</para>
  <para style="s">Avasa adama e ikambishi</para>
  <para style="b" />
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169" />A̱sulazuva, lyawa mesun ma̱ va̱</para>
  <para style="q2" vid="PSA 119:169">ma rawa a̱ ma̱ka̱ka̱n ma̱ wu,</para>
  <para style="q1" vid="PSA 119:169">ca mu urevu</para>
  <para style="q2" vid="PSA 119:169">cine adanshi a̱ wu a dammai.<verse eid="PSA 119:169" /></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170" />Lyawa avasa a̱ va̱</para>
  <para style="q2" vid="PSA 119:170">a rawa a̱ ma̱ka̱ka̱n ma̱ wu,</para>
  <para style="q1" vid="PSA 119:170">vu wawa mu</para>
  <para style="q2" vid="PSA 119:170">cine vu yuwain nzuwulai.<verse eid="PSA 119:170" /></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171" />Lyawa una̱ u va̱</para>
  <para style="q2" vid="PSA 119:171">u shiwan ni ica,</para>
  <para style="q1" vid="PSA 119:171">adama a na vu rito mu ta̱</para>
  <para style="q2" vid="PSA 119:171">udammu wa̱ wu.<verse eid="PSA 119:171" /></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172" />Lyawa elentsu a̱ va̱,</para>
  <para style="q2" vid="PSA 119:172">a cana ishipa ya adanshi a̱ wu,</para>
  <para style="q1" vid="PSA 119:172">adama a na udammu wa̱ wu suru,</para>
  <para style="q2" vid="PSA 119:172">a̱za̱ a̱ɓula̱ a ɗa.<verse eid="PSA 119:172" /></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173" />Lyawa ukere wa̱ wu</para>
  <para style="q2" vid="PSA 119:173">u da̱na̱ ufoɓu,</para>
  <para style="q2" vid="PSA 119:173">u na wa kamba mu,</para>
  <para style="q1" vid="PSA 119:173">adama a na n ɗangula ta̱</para>
  <para style="q2" vid="PSA 119:173">udammu wa̱ wu.<verse eid="PSA 119:173" /></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174" />A̱sulazuva, n ta maluwa</para>
  <para style="q2" vid="PSA 119:174">me iwawi ya̱ wu,</para>
  <para style="q1" vid="PSA 119:174">waru wila̱ wa̱ wu ili i ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 119:174">i ɗa uba̱ta̱ u va̱.<verse eid="PSA 119:174" /></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175" />Lyawa n da̱na̱ wuma</para>
  <para style="q2" vid="PSA 119:175">adama n cuwa wu,</para>
  <para style="q1" vid="PSA 119:175">Lyawa uge'etosu wa̱ wu fo</para>
  <para style="q2" vid="PSA 119:175">u kamba mu.<verse eid="PSA 119:175" /></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176" />N puwa̱a̱n ta̱,</para>
  <para style="q2" vid="PSA 119:176">tsu kyon na puwa̱yin,</para>
  <para style="q2" vid="PSA 119:176">zami mu, a̱mu aagbashi a̱ wu,</para>
  <para style="q1" vid="PSA 119:176">adama a na mi icina</para>
  <para style="q2" vid="PSA 119:176">nu udammu wa̱ wu shi.<verse eid="PSA 119:176" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" sid="PSA 120" />
  <para style="s">Avasa e izami yi ikambishi</para>
  <para style="d">Ishipa a agawan a̱ tyo uba̱ta̱ wa̱ a̱ga̱nda̱.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1" />A̱tsuma̱ A̱tsuma̱lima̱ a̱ va̱,</para>
  <para style="q2" vid="PSA 120:1">n ɗe ta̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 120:1">waru u usu mu ta̱.<verse eid="PSA 120:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2" />&lt;&lt;A̱sulazuva, wawa mu,</para>
  <para style="q2" vid="PSA 120:2">diga a̱ na̱ va a̱za̱ e epen,</para>
  <para style="q2" vid="PSA 120:2">na̱ elentsu a̱za̱ a̱ a̱lumu.&gt;&gt;<verse eid="PSA 120:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3" />Nye waa yuwaan ɗu?</para>
  <para style="q2" vid="PSA 120:3">Cu'un vu uge'etosu u ne ɗa waa yuwaan ɗu</para>
  <para style="q2" vid="PSA 120:3">a̱ɗu a̱za̱ a̱ a̱lumu?<verse eid="PSA 120:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4" />U ta̱ ge'eto ɗu,</para>
  <para style="q2" vid="PSA 120:4">na aya a wali ali o uvon,</para>
  <para style="q2" vid="PSA 120:4">na̱ akinkina a madala!<verse eid="PSA 120:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5" />Wo yo'ono mu shi!</para>
  <para style="q2" vid="PSA 120:5">A na n ri na̱ nden ɗe Meshek,</para>
  <para style="q2" vid="PSA 120:5">a na n ri na̱ nden a̱tsuma̱ ogodo a Keda.<verse eid="PSA 120:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6" />N juma ta̱ na̱ nden lon,</para>
  <para style="q2" vid="PSA 120:6">oɓolo na ama a na a cigai</para>
  <para style="q2" vid="PSA 120:6">asuvu nden shi!<verse eid="PSA 120:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7" />A̱mu vuma va asuvu nden a ɗa,</para>
  <para style="q2" vid="PSA 120:7">agba na̱ n yuwan adanshi,</para>
  <para style="q2" vid="PSA 120:7">a̱vu aza a na a cigai asuvu nden shi</para>
  <para style="q2" vid="PSA 120:7">e reme uvon.<verse eid="PSA 120:7" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" sid="PSA 121" />
  <para style="s">A̱sulazuva a ɗa mapari tsu</para>
  <para style="d">Ishipa i na a ɗanayi aza a na a gawusan a̱ 'ya̱wa̱ uba̱ta̱ wa̱ a̱ga̱nda̱.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1" />N 'ya̱sa̱n ta̱ urewesu u va̱ a̱ ka̱lyuwusa̱ nsasan,</para>
  <para style="q2" vid="PSA 121:1">a̱ te ɗa ikambishi i va̱ yoo uta̱?<verse eid="PSA 121:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2" />Ikambishi i va̱ i ta̱ o uta̱</para>
  <para style="q2" vid="PSA 121:2">uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 121:2">za na yuwain zuva ni iɗa.<verse eid="PSA 121:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3" />Waa lyawa wu vu ta̱ɗa̱tsa̱ shi,</para>
  <para style="q2" vid="PSA 121:3">za na e idanasa wu a̱ gba̱ɗi shi!<verse eid="PSA 121:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4" />Na amayun, za na e idanasa aza a Isra'ila,</para>
  <para style="q2" vid="PSA 121:4">wa yuwan mgba̱ɗa̱ ko u lantsa shi!<verse eid="PSA 121:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5" />A̱sulazuva a ɗa mapari ma̱ wu,</para>
  <para style="q2" vid="PSA 121:5">a̱yi ɗa ululu e ekere a̱ wu.<verse eid="PSA 121:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6" />Usuɗuwu wu urana waa faba wu shi,</para>
  <para style="q2" vid="PSA 121:6">ko woto u ta̱wa̱a̱ wu na̱ meleshe na ayin shi.<verse eid="PSA 121:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7" />A̱sulazuva a ta yuwaan wu mapari</para>
  <para style="q2" vid="PSA 121:7">a̱tsuma̱ a̱ cu'un meleshe biti,</para>
  <para style="q2" vid="PSA 121:7">waru u ta wawa wuma wa̱ wu.<verse eid="PSA 121:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8" />A̱sulazuva e te idana mota̱a̱ ma̱ wu</para>
  <para style="q2" vid="PSA 121:8">na̱ ma̱ka̱mba̱a̱ ma̱ wu,</para>
  <para style="q2" vid="PSA 121:8">diga gogo na̱ hali hali.<verse eid="PSA 121:8" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" sid="PSA 122" />
  <para style="s">Ica adama a̱ Urishelima</para>
  <para style="d">Ishipa i na a ɗanayi aza a na a gawusan a̱ 'ya̱wa̱ uba̱ta̱ wa̱ a̱ga̱nda̱. Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1" />N yuwan ta̱ ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 122:1">mantsa ma na a damma numu,</para>
  <para style="q2" vid="PSA 122:1">&lt;&lt;'Yon, tsu ka̱ra̱ a̱ tyo A̱a̱'isamapaɗa a̱ A̱sulazuva!&gt;&gt;<verse eid="PSA 122:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2" />Agba gogo tsu rawa ta̱,</para>
  <para style="q2" vid="PSA 122:2">a̱tsu ɗa nda mishin a̱ na̱ntsu va̱ wu,</para>
  <para style="q2" vid="PSA 122:2">a̱vu Urishelima.<verse eid="PSA 122:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3" />Urishelima tsura̱ ta̱ usuwu,</para>
  <para style="q2" vid="PSA 122:3">lyuci ɗa na ri usuwu uɓoluloi uba̱ta̱ uta̱.<verse eid="PSA 122:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4" />Ɗe ɗa elentsu a̱ tsu 'ya̱wa̱,</para>
  <para style="q2" vid="PSA 122:4">elentsu a Isra'ila,</para>
  <para style="q1" vid="PSA 122:4">adama o godyowo ala a̱ A̱sulazuva</para>
  <para style="q2" vid="PSA 122:4">ununa a damma nle,<verse eid="PSA 122:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5" />uba̱ta̱ u na oɓolo a̱za̱ o uge'etosu a̱ ri,</para>
  <para style="q2" vid="PSA 122:5">a̱za̱ o tsugono diga o u'wa wa Da̱wuda.<verse eid="PSA 122:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6" />Yuwayin Urishelima avasa adama asuvu nden!</para>
  <para style="q2" vid="PSA 122:6">&lt;&lt;Lyawa aza a na a ciga nuwu</para>
  <para style="q2" vid="PSA 122:6">a̱ da̱na̱ na asuvu nden!<verse eid="PSA 122:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7" />Lyawa asuvu nden a̱ da̱na̱ a kari va̱ wu,</para>
  <para style="q2" vid="PSA 122:7">na̱ nden ma alafiya</para>
  <para style="q2" vid="PSA 122:7">a ɓaɓu vu ucira va̱ wu.&gt;&gt;<verse eid="PSA 122:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8" />Adama a̱ a̱za̱ a̱ va̱ na̱ n'utsa̱ n va̱,</para>
  <para style="q2" vid="PSA 122:8">n ta yuwusan avasa</para>
  <para style="q2" vid="PSA 122:8">adama asuvu nden a̱ Urishelima.<verse eid="PSA 122:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9" />Adama o u'wa wa̱ A̱sulazuva A̱sula̱ a̱ tsu,</para>
  <para style="q2" vid="PSA 122:9">n te e izami yi isa'ani ya̱ yi.<verse eid="PSA 122:9" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" sid="PSA 123" />
  <para style="s">Avasa adama e ene iliyali i va̱</para>
  <para style="d">Ishipa i na a ɗanayi aza a na a gawusan a̱ 'ya̱wa̱ uba̱ta̱ wa̱ a̱ga̱nda̱.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1" />A̱sulazuva, n ta zuwusa esu a̱ va̱ ya̱ a̱ wu,</para>
  <para style="q2" vid="PSA 123:1">ɗe zuva uba̱ta̱ u na vu ri o tsugono.<verse eid="PSA 123:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2" />Cine agbashi a tsu zuwa ucira</para>
  <para style="q2" vid="PSA 123:2">uba̱ta̱ wu zagbain le,</para>
  <para style="q1" vid="PSA 123:2">na̱ cine aagbashi o usheli</para>
  <para style="q2" vid="PSA 123:2">a tsu yuwaan mma va asula va̱ yi,</para>
  <para style="q1" vid="PSA 123:2">ne ɗa fo esu a̱ tsu a̱ ri</para>
  <para style="q2" vid="PSA 123:2">uba̱ta̱ wa̱ A̱sulazuva A̱sula̱ a̱ tsu</para>
  <para style="q2" vid="PSA 123:2">hali she na̱ we ene iliyali i tsu.<verse eid="PSA 123:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3" />Vee ene iliyali i tsu, A̱sulazuva!</para>
  <para style="q2" vid="PSA 123:3">Vee ene iliyali i tsu,</para>
  <para style="q2" vid="PSA 123:3">adama a na ama a tara tsu ili i ro shi!<verse eid="PSA 123:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4" />A̱za̱ o utsuru a jima ta̱</para>
  <para style="q2" vid="PSA 123:4">e izo'oshi i tsu,</para>
  <para style="q1" vid="PSA 123:4">a̱za̱ a yipalishi</para>
  <para style="q2" vid="PSA 123:4">aza aciyogbamu a tara tsu ili i ro shi!<verse eid="PSA 123:4" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" sid="PSA 124" />
  <para style="s">A̱sula̱ a ɗa zavi iwawi ya ama a̱ yi</para>
  <para style="d">Ishipa i na a ɗanayi aza a na a gawusan a̱ 'ya̱wa̱ uba̱ta̱ wa̱ a̱ga̱nda̱. Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1" />Na̱ shi adamma A̱sulazuva a̱ ri oɓolo na̱ tsu shi,</para>
  <para style="q2" vid="PSA 124:1">Nye i shi a cina tsu?</para>
  <para style="q2" vid="PSA 124:1">Lyawa Isra'ila usu a damma!<verse eid="PSA 124:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2" />&lt;&lt;Na̱ shi a damma A̱sulazuva a̱ ri oɓolo na̱ tsu shi,</para>
  <para style="q2" vid="PSA 124:2">a mantsa ma na n'yuwatan n riya̱a̱ ntsu,<verse eid="PSA 124:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3" />a̱ shi ta̱ o soɗu tsu wuma a mantsa mo ndolo,</para>
  <para style="q2" vid="PSA 124:3">adama o upan wu usuɗuwu u na</para>
  <para style="q2" vid="PSA 124:3">a̱ da̱na̱i a yuwusan na̱ tsu,<verse eid="PSA 124:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4" />a̱ shi ta̱ a̱ da̱na̱ tsu upan u mini ma gbain a̱ purusa̱ tsu,</para>
  <para style="q2" vid="PSA 124:4">a̱ shi ta̱ o soɗu tsu tsa̱ mini,<verse eid="PSA 124:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5" />waru upan u le u shi ta̱ o soɗu tsu</para>
  <para style="q2" vid="PSA 124:5">tsa̱ mini ma na ma yuwain upan.&gt;&gt;<verse eid="PSA 124:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6" />Ica a̱ tyo uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 124:6">za na kuɗa̱i a ca tsu e ekere le</para>
  <para style="q1" vid="PSA 124:6">na a kakara tsu na anga le</para>
  <para style="q2" vid="PSA 124:6">tsi inama yu una wan.<verse eid="PSA 124:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7" />Wuma u tsu u ta̱ tsa manunu,</para>
  <para style="q2" vid="PSA 124:7">manunu ma na ma̱ fa̱tsa̱i a maza.</para>
  <para style="q1" vid="PSA 124:7">Diga a maza ma na ma kasai,</para>
  <para style="q2" vid="PSA 124:7">reve a̱ tsu gba tsu fa̱tsa̱.<verse eid="PSA 124:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8" />Ikambishi i tsu i ta̱</para>
  <para style="q2" vid="PSA 124:8">a̱tsuma̱ a ala a̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 124:8">za na yuwain zuva ni iɗa.<verse eid="PSA 124:8" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" sid="PSA 125" />
  <para style="s">A̱sula̱ a ta yuwaan ama a̱ yi mapari</para>
  <para style="d">Ishipa i na a ɗanayi aza a na a gawusan a̱ 'ya̱wa̱ uba̱ta̱ wa̱ a̱ga̱nda̱.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1" />Aza a na zuwai ucira u le uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 125:1">a̱ ta̱ tsa masasan ma̱ Sihiyona,</para>
  <para style="q2" vid="PSA 125:1">za na a̱ jinga̱ɗa̱ shi ko ke'en,</para>
  <para style="q2" vid="PSA 125:1">u ta̱ da̱na̱ ushuwu hali hali.<verse eid="PSA 125:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2" />Cine nsasan n ka̱nda̱ruwa̱i Urishelima,</para>
  <para style="q2" vid="PSA 125:2">ne fo A̱sulazuva a̱ ri uka̱nda̱ruwu na ama a̱ yi,</para>
  <para style="q2" vid="PSA 125:2">diga gogo a̱ tyo hali hali.<verse eid="PSA 125:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3" />A̱za̱ e iwuya aa yuwan tsugono</para>
  <para style="q2" vid="PSA 125:3">tsi iɗa i na a cayi a̱za̱ a̱ a̱ɓula̱ shi,</para>
  <para style="q1" vid="PSA 125:3">adama a na nna a yuwan ne,</para>
  <para style="q2" vid="PSA 125:3">u ta gura o'wo a̱za̱ a̱ a̱ɓula̱'a̱ fo</para>
  <para style="q2" vid="PSA 125:3">a yuwan iwuya.<verse eid="PSA 125:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4" />A̱sulazuva, vu roco aza a na aa yuwusan isa'ani isa'ani,</para>
  <para style="q2" vid="PSA 125:4">aza a amayun okolo.<verse eid="PSA 125:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5" />Amma vu ge'eto aza a na a vadalai</para>
  <para style="q2" vid="PSA 125:5">o tono linga vi iwuya yo okolo e le,</para>
  <para style="q1" vid="PSA 125:5">a mantsa ma na vu ri a casu</para>
  <para style="q2" vid="PSA 125:5">a̱za̱ e iwuya a̱tsuma̱lima̱!</para>
  <para style="b" vid="PSA 125:5" />
  <para style="q2" vid="PSA 125:5">Lyawa asuvu nden a̱ da̱na̱ oɓolo na̱ Isra'ila!<verse eid="PSA 125:5" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" sid="PSA 126" />
  <para style="s">Ishipa ya aza a na a̱ ka̱mba̱i diga a tsugbashi</para>
  <para style="d">Ishipa i na a ɗanayi aza a na a gawusan a̱ 'ya̱wa̱ uba̱ta̱ wa̱ a̱ga̱nda̱.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1" />Ana A̱sulazuva a̱ ka̱mbuwa̱ n tsu Sihiyona,</para>
  <para style="q2" vid="PSA 126:1">reve ili'i yo o'wo tsu tsa alavu!<verse eid="PSA 126:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2" />A̱vu tsu ɓosho ni izo'oshi,</para>
  <para style="q2" vid="PSA 126:2">reve tsu cana ishipa i ma̱za̱nga̱!</para>
  <para style="q1" vid="PSA 126:2">Ɗaɗa akapi a nɗa a yuwain</para>
  <para style="q2" vid="PSA 126:2">adanshi a aci a̱ tsu ana,</para>
  <para style="q2" vid="PSA 126:2">&lt;&lt;A̱sulazuva a yuwan ta̱ a̱ba̱jini a̱ba̱jini e ili adama e le!&gt;&gt;<verse eid="PSA 126:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3" />Ee, A̱sulazuva a yuwan ta̱</para>
  <para style="q2" vid="PSA 126:3">a̱ba̱jini a̱ba̱jini e ili adama a̱ tsu,</para>
  <para style="q2" vid="PSA 126:3">waru tsu yuwan ta̱ ma̱za̱nga̱ lon.<verse eid="PSA 126:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4" />A̱sulazuva, vu ka̱mbuwisa̱ tsu</para>
  <para style="q2" vid="PSA 126:4">na̱ tsugbain tsa̱ tsu,</para>
  <para style="q1" vid="PSA 126:4">cine iro'i i tsu ta̱wa̱a̱ na̱ mini</para>
  <para style="q2" vid="PSA 126:4">e iɗa yu u'yewu.<verse eid="PSA 126:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5" />Aza a na a yuwain ca̱'a̱n na̱ mesun</para>
  <para style="q2" vid="PSA 126:5">a ta yuwan ugasa ni ishipa i ma̱za̱nga̱!<verse eid="PSA 126:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6" />Aza a na o uta̱i a̱ mesun uguzu ni icu'un,</para>
  <para style="q2" vid="PSA 126:6">a̱ ta̱ ka̱mba̱ utanuwu na akatalu akatalu,</para>
  <para style="q2" vid="PSA 126:6">a canasa ishipa i ma̱za̱nga̱.<verse eid="PSA 126:6" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" sid="PSA 127" />
  <para style="s">Ica yi isa'ani ya̱ A̱sulazuva</para>
  <para style="d">Ishipa i na a ɗanayi aza a na a gawusan a̱ 'ya̱wa̱ uba̱ta̱ wa̱ a̱ga̱nda̱. Ica ya̱ Sulemanu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1" />N na̱ A̱sulazuva ɗa a suwai u'wa shi,</para>
  <para style="q2" vid="PSA 127:1">pere ɗa suwi a yuwusan usaa.</para>
  <para style="q1" vid="PSA 127:1">N na̱ A̱sulazuva a ɗa a̱ piriyi lyuci shi,</para>
  <para style="q2" vid="PSA 127:1">ulinga wa̱ pere u ɗa</para>
  <para style="q2" vid="PSA 127:1">a zuwaa yi a̱za̱ e ipiri.<verse eid="PSA 127:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2" />Ulinga wa̱ pere u ɗa vu 'yon na̱ wasasa,</para>
  <para style="q2" vid="PSA 127:2">agba va̱a̱ ka̱mba̱ go'o shi,</para>
  <para style="q2" vid="PSA 127:2">a̱ a̱ga̱nda̱ e izami yi ili i na va lyuwa,</para>
  <para style="q1" vid="PSA 127:2">adama a na A̱sulazuva a tsu zuwa ta̱</para>
  <para style="q2" vid="PSA 127:2">aza a na u ri e icigi a lantsa e ivuwan.<verse eid="PSA 127:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3" />Muwun mo olobo</para>
  <para style="q2" vid="PSA 127:3">une'e wa̱ A̱sulazuva a ɗa,</para>
  <para style="q2" vid="PSA 127:3">aba'un a ɗa a̱ la̱nga̱.<verse eid="PSA 127:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4" />Muwun mo olobo na vuma matsain</para>
  <para style="q2" vid="PSA 127:4">o tsulobo tsa̱ yi,</para>
  <para style="q2" vid="PSA 127:4">a̱ ta̱ tsa aya e ekere a za vu uvon.<verse eid="PSA 127:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5" />Za ma̱za̱nga̱ ɗa vuma na</para>
  <para style="q2" vid="PSA 127:5">ujin wa̱ yi u ri tapu na aya!</para>
  <para style="q1" vid="PSA 127:5">Ko ke'en, a lyuwa aci a̱ yi shi,</para>
  <para style="q2" vid="PSA 127:5">a mantsa ma na u ga'asain</para>
  <para style="q2" vid="PSA 127:5">na̱ n'yuwatan ma̱ yi uba̱ta̱ o ge'etosu.<verse eid="PSA 127:5" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" sid="PSA 128" />
  <para style="s">Aba'un a̱ tyo a za na aa uwwusa wovon wa̱ A̱sulazuva</para>
  <para style="d">Ishipa i na a ɗanayi aza a na a gawusan a̱ 'ya̱wa̱ uba̱ta̱ wa̱ a̱ga̱nda̱.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1" />Za ma̱za̱nga̱ ɗa za na</para>
  <para style="q2" vid="PSA 128:1">aa uwwusa wovon wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 128:1">za na aa yuwusan mmalu a̱tsuma̱ o ure wa̱ yi.<verse eid="PSA 128:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2" />Vu ta̱ lyuwa melen mo ulinga wa̱ wu,</para>
  <para style="q2" vid="PSA 128:2">vu ta yuwan ma̱za̱nga̱</para>
  <para style="q2" vid="PSA 128:2">reve vu tsura̱ ulyuwu we elime.<verse eid="PSA 128:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3" />Ka va̱ wu to o'wo tsa a ataci a̱ inabi</para>
  <para style="q2" vid="PSA 128:3">na a matsusan o u'wa wa̱ wu,</para>
  <para style="q1" vid="PSA 128:3">muwun ma̱ wu waru tsa ɗanga Zetun</para>
  <para style="q2" vid="PSA 128:3">uka̱nda̱ruwu na̱ mapara ma̱ wu.<verse eid="PSA 128:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4" />Ne ɗa a zuwaa vuma aba'un,</para>
  <para style="q2" vid="PSA 128:4">za na a uwwusa wovon wa̱ A̱sulazuva.<verse eid="PSA 128:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5" />Lyawa A̱sulazuva a zuwaa wu aba'un,</para>
  <para style="q2" vid="PSA 128:5">diga Sihiyona a wuma wa̱ wu suru,</para>
  <para style="q2" vid="PSA 128:5">lyawa ve ene ulyuwu we elime wa̱ Urishelima.<verse eid="PSA 128:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6" />Lyawa vu da̱na̱ wuma</para>
  <para style="q2" vid="PSA 128:6">ve ene muwun n tsukaya ma̱ wu.</para>
  <para style="b" vid="PSA 128:6" />
  <para style="q1" vid="PSA 128:6">Lyawa nden ma asuvu n da̱na̱ oɓolo na̱ Isra'ila.<verse eid="PSA 128:6" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" sid="PSA 129" />
  <para style="s">Avasa a aci a n'yuwatan ma Isra'ila</para>
  <para style="d">Ishipa i na a ɗanayi aza a na a gawusan a̱ 'ya̱wa̱ uba̱ta̱ wa̱ a̱ga̱nda̱.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1" />Isra'ila, vu damma</para>
  <para style="q2" vid="PSA 129:1">cu'un vi iwuya ni iɓongi</para>
  <para style="q2" vid="PSA 129:1">i na n'yuwatan ma̱ wu n yuwaan nuwu,</para>
  <para style="q2" vid="PSA 129:1">diga a̱vu o molobo!<verse eid="PSA 129:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2" />N'yuwatan n va̱</para>
  <para style="q2" vid="PSA 129:2">m ɓongi mu ta̱ ni iwuya, diga a̱mu a̱ tsulolobo,</para>
  <para style="q2" vid="PSA 129:2">agba a̱ tsura̱ ulyuwu wa a aci uba̱ta̱ u va̱ shi.<verse eid="PSA 129:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3" />A ɓatsa mu ta̱ ucina̱</para>
  <para style="q2" vid="PSA 129:3">reve o o'woto yi tsu uɗuma̱ u na a lumai.<verse eid="PSA 129:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4" />Amma A̱sulazuva za va̱ a̱ɓula̱ ɗa,</para>
  <para style="q2" vid="PSA 129:4">u wawa mu ta̱ diga amunga a̱za̱ e iwuya.<verse eid="PSA 129:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5" />Lyawa aza a na suru a 'yuwain Sihiyona,</para>
  <para style="q2" vid="PSA 129:5">a vadala a̱ ka̱mba̱ na̱ wono.<verse eid="PSA 129:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6" />Lyawa o o'wo tsa anlya</para>
  <para style="q2" vid="PSA 129:6">a na o uta̱i zuva vu ukwa̱'a̱,</para>
  <para style="q2" vid="PSA 129:6">za na tsu 'yewe babu na u kungwai,<verse eid="PSA 129:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7" />za na a gura rawa mazina<note caller="+" style="f"><char style="fr" closed="false">129:7 </char><char style="fq" closed="false">mazina </char><char style="ft" closed="false">A̱yi ɗa cine za vu kya'an tsu gere imon o ukere a̱yi a kya'an.</char></note> ma za vu ugasa,</para>
  <para style="q2" vid="PSA 129:7">ko o shiton ekere a̱za̱ o uɓolotosu wa akatalu shi.<verse eid="PSA 129:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8" />Ta̱wa̱ aza a na a̱ ri a mmalu a̱ ka̱ra̱sa̱</para>
  <para style="q2" vid="PSA 129:8">a yuwan ica̱su a damma,</para>
  <para style="q1" vid="PSA 129:8">&lt;&lt;Lyawa aba'un a̱ A̱sulazuva</para>
  <para style="q2" vid="PSA 129:8">a̱ da̱na̱ aci a̱ ɗu,</para>
  <para style="q1" vid="PSA 129:8">tsu ta zuwusaa ɗu aba'un</para>
  <para style="q2" vid="PSA 129:8">a̱tsuma̱ a ala A̱sulazuva!&gt;&gt;<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" sid="PSA 130" />
  <para style="s">Uzuwu wo okolo e iwawi ya̱ A̱sula̱</para>
  <para style="d">Ishipa i na a ɗanayi aza a na a gawusan a̱ 'ya̱wa̱ uba̱ta̱ wa̱ a̱ga̱nda̱.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1" />A̱sulazuva, a̱tsuma̱ o usa̱n wa̱ a̱tsuma̱lima̱ a̱ va̱</para>
  <para style="q2" vid="PSA 130:1">n ta̱ a̱ mesun uba̱ta̱ wa̱ wu.<verse eid="PSA 130:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 130:2" />A̱sulazuva, vu uwwa mesun ma̱ va̱!</para>
  <para style="q2" vid="PSA 130:2">Vu polo atsuvu</para>
  <para style="q2" vid="PSA 130:2">a̱ mesun ma na ma yuwusan</para>
  <para style="q2" vid="PSA 130:2">me izami yi ikambishi!<verse eid="PSA 130:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3" />Nna̱ a̱vu A̱sulazuva, vee kecishe nusu,</para>
  <para style="q2" vid="PSA 130:3">zane ɗa a la'a?<verse eid="PSA 130:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4" />Amma vu tsu yuwaan tsu ta̱ gafura,</para>
  <para style="q2" vid="PSA 130:4">adama tso o'wo aza a na</para>
  <para style="q2" vid="PSA 130:4">a uwwusa wovon wa̱ wu.<verse eid="PSA 130:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5" />N jima ta̱ a zuwusa okolo uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 130:5">waru n zuwa ta̱ okolo e idanshi ya̱ yi.<verse eid="PSA 130:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6" />Wuma u va̱ u ta̱ maluwa ma̱ A̱sulazuva</para>
  <para style="q2" vid="PSA 130:6">ula'awu na̱ cine a̱za̱ e ipiri</para>
  <para style="q2" vid="PSA 130:6">a̱ tsa̱ da̱na̱ a maluwa ma na ee ene usana,</para>
  <para style="q1" vid="PSA 130:6">Ee, ula'awu na̱ cine a̱za̱ e ipiri</para>
  <para style="q2" vid="PSA 130:6">a uwwusa maluwa ma na ee ene usana.<verse eid="PSA 130:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7" />A̱vu Isra'ila,</para>
  <para style="q2" vid="PSA 130:7">vu zuwa ucira uba̱ta̱ wa̱ A̱sulazuva,</para>
  <para style="q1" vid="PSA 130:7">adama a na uba̱ta̱ wa̱ A̱sulazuva a̱ tsu tsa̱ra̱ ta̱</para>
  <para style="q2" vid="PSA 130:7">icigi i na i tsu vadala shi,</para>
  <para style="q2" vid="PSA 130:7">mantsa suru u tu ufoɓu u na waa yuwan gafura.<verse eid="PSA 130:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8" />U ta wawa ama a̱ yi aza a Isra'ila</para>
  <para style="q2" vid="PSA 130:8">diga a̱tsuma̱ a̱ nusu le suru.<verse eid="PSA 130:8" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" sid="PSA 131" />
  <para style="s">Avasa a za na tarai aciya̱yi ili i ro shi</para>
  <para style="d">Ishipa i na a ɗanayi aza a na a gawusan a̱ 'ya̱wa̱ uba̱ta̱ wa̱ a̱ga̱nda̱. Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1" />A̱sulazuva,</para>
  <para style="q2" vid="PSA 131:1">n tara aciya̱va̱ ili i ro shi,</para>
  <para style="q1" vid="PSA 131:1">n ri o uvaɗu shi,</para>
  <para style="q2" vid="PSA 131:1">n zuwa okolo a̱ va̱ e ili i gbagbain shi</para>
  <para style="q2" vid="PSA 131:1">ko ili i na i la'ai ucira u va̱ shi.<verse eid="PSA 131:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2" />Amma n yuwan ta̱ ankuri</para>
  <para style="q2" vid="PSA 131:2">reve n voton okolo a̱ va̱,</para>
  <para style="q1" vid="PSA 131:2">tsa mawun ma na a kasai maani</para>
  <para style="q2" vid="PSA 131:2">tsa mawun ma na ma̱ ri nven</para>
  <para style="q2" vid="PSA 131:2">oɓolo na̱ mma va̱ yi,</para>
  <para style="q2" vid="PSA 131:2">ne ɗa asuvu a̱ va̱ a̱ ri nven.<verse eid="PSA 131:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3" />Isra'ila,</para>
  <para style="q2" vid="PSA 131:3">vu zuwa okolo a̱ wu uba̱ta̱ wa̱ A̱sulazuva</para>
  <para style="q2" vid="PSA 131:3">diga gogo hali hali.<verse eid="PSA 131:3" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" sid="PSA 132" />
  <para style="s">Ica adama a̱ A̱a̱'isa̱mapaɗa</para>
  <para style="d">Ishipa a agawan a̱ tyo uba̱ta̱ wa̱ a̱ga̱nda̱.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1" />A̱sulazuva, vu cuwan na̱ Da̱wuda,</para>
  <para style="q2" vid="PSA 132:1">na̱ a̱tsuma̱lima̱ a na u sowoi suru.<verse eid="PSA 132:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2" />U yuwaan ta̱ A̱sulazuva akucunu,</para>
  <para style="q2" vid="PSA 132:2">a̱vu waru u yuwan nzuwulai e ekere</para>
  <para style="q2" vid="PSA 132:2">a Za vu Ucira wa Yakubu adansa,<verse eid="PSA 132:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3" />&lt;&lt;Maa uwa o u'wa u va̱ shi,</para>
  <para style="q2" vid="PSA 132:3">ko n von a̱ a̱a̱ga̱da̱ a̱ va̱ shi,<verse eid="PSA 132:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 132:4" />maa ca esu a̱ va̱ nlavu shi,</para>
  <para style="q2" vid="PSA 132:4">ko mgba̱ɗa̱ a̱ a̱ga̱pa̱na̱ a̱ va̱ shi.<verse eid="PSA 132:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5" />She na̱ n tsura̱a̱ A̱sulazuva</para>
  <para style="q2" vid="PSA 132:5">uba̱ta̱ u mayan ma̱ a̱ga̱nda̱,</para>
  <para style="q2" vid="PSA 132:5">oɓolo nu uba̱ta̱ wu nden adama a Za vu Ucira wa Yakubu.&gt;&gt;<verse eid="PSA 132:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6" />A̱tsu a̱tsuma̱ a Efarata tsu uwwa ta̱</para>
  <para style="q2" vid="PSA 132:6">aɗa a Akpati a Nzuwulai,<note caller="-" style="x"><char style="xo" closed="false">132:6-10 </char><char style="xt" closed="false"><ref loc="1SA 7:1-2">1 Sam 7:1-2</ref>; <ref loc="2SA 6:2-15">2 Sam 6:2-15</ref>; <ref loc="1CH 13:5-8">1 Alb 13:5-8</ref>. </char></note></para>
  <para style="q2" vid="PSA 132:6">reve tsu cina yi ɗe atsusa a Ja'ari.<verse eid="PSA 132:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7" />Reve tsu damma,</para>
  <para style="q2" vid="PSA 132:7">&lt;&lt;Lyawai tsu 'ya̱wa̱i uba̱ta̱ wu nden wa̱ yi,</para>
  <para style="q2" vid="PSA 132:7">lyawai tsu yuwain a̱ga̱nda̱ a̱ ma̱ka̱ka̱n ma̱ yi.<verse eid="PSA 132:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8" />'Yon, A̱sulazuva vu ta̱wa̱,</para>
  <para style="q2" vid="PSA 132:8">uba̱ta̱ u wivuwun wa̱ wu,<note caller="-" style="x"><char style="xo" closed="false">132:8 </char><char style="xt" closed="false"><ref loc="2CH 6:41-42">2 Alb 6:41-42</ref>.</char></note></para>
  <para style="q1" vid="PSA 132:8">a̱vu na Akpati a nzuwulai ma̱ wu</para>
  <para style="q2" vid="PSA 132:8">na vu tsu roco ucira wa̱ wu.<verse eid="PSA 132:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9" />Lyawa nan ganu a̱ wu</para>
  <para style="q2" vid="PSA 132:9">a̱ da̱na̱ wotowu na̱ a̱ɓula̱ tsi itana,</para>
  <para style="q1" vid="PSA 132:9">lyawa aza a akiza a̱ wu</para>
  <para style="q2" vid="PSA 132:9">a cana ishipa i ma̱za̱nga̱.&gt;&gt;<verse eid="PSA 132:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10" />Adama aagbashi a̱ wu Da̱wuda,</para>
  <para style="q2" vid="PSA 132:10">she vu vadalaa za na vu tawai urewesu wan.<verse eid="PSA 132:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11" />A̱sulazuva a kucinaa ta̱ Da̱wuda,<note caller="-" style="x"><char style="xo" closed="false">132:11 </char><char style="xt" closed="false"><ref loc="2SA 7:12-16">2 Sam 7:12-16</ref>; <ref loc="1CH 17:11-14">1 Alb 17:11-14</ref>; <ref loc="PSA 89:3-4">Ica 89:3-4</ref>; <ref loc="ACT 2:30">Ajy 2:30</ref>.</char></note></para>
  <para style="q2" vid="PSA 132:11">akucunu a amayun a na waa vadala shi u damma,</para>
  <para style="q1" vid="PSA 132:11">&lt;&lt;N ta̱ shuwa̱ za ta̱ a̱tsuma̱ a̱ muwun ma̱ wu</para>
  <para style="q2" vid="PSA 132:11">o ootogu o tsugono tsa̱ wu,<verse eid="PSA 132:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12" />Nna̱ olobo a̱ wu</para>
  <para style="q2" vid="PSA 132:12">a̱ guza̱ akucunu a̱ va̱</para>
  <para style="q1" vid="PSA 132:12">ni ili i na n zuwai a̱ kuru, na moo rito le,</para>
  <para style="q2" vid="PSA 132:12">muwun n le olobo fo</para>
  <para style="q1" vid="PSA 132:12">a̱ ta̱ da̱nu ootogu o tsugono tsa̱ wu</para>
  <para style="q2" vid="PSA 132:12">hali hali.&gt;&gt;<verse eid="PSA 132:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13" />Adama a na A̱sulazuva</para>
  <para style="q2" vid="PSA 132:13">a ɗangwa ta̱ Sihiyona,</para>
  <para style="q2" vid="PSA 132:13">u yuwan ta̱ maluwa ma na woo o'wo uba̱ta̱ wu nden wa̱ yi.<verse eid="PSA 132:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14" />U damma ta̱ fo,</para>
  <para style="q2" vid="PSA 132:14">&lt;&lt;A̱yi nda a̱yi ɗa uba̱ta̱ u wivuwun u va̱ hali hali,</para>
  <para style="q1" vid="PSA 132:14">lo ɗa ma̱a̱ da̱nu,</para>
  <para style="q2" vid="PSA 132:14">adama a na n ta maluwa ma̱ yi.<verse eid="PSA 132:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15" />N ta zuwaa Sihiyona aba'un lon,</para>
  <para style="q2" vid="PSA 132:15">a̱vu n cuwa̱ton alambi a̱ yi ni ilyalya.<verse eid="PSA 132:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16" />N ta wawa nan ganu a̱yi,</para>
  <para style="q2" vid="PSA 132:16">a̱za̱ a̱ a̱ɓula̱ a̱yi waru</para>
  <para style="q2" vid="PSA 132:16">a̱ ta̱ 'ya̱sa̱n uɗyo u ma̱za̱nga̱.<verse eid="PSA 132:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17" />Ɗe ɗa ma̱a̱ da̱shi ucira wa̱ Da̱wuda,</para>
  <para style="q2" vid="PSA 132:17">tsa̱ fitila na ri a madala hali hali,</para>
  <para style="q2" vid="PSA 132:17">n foɓo ta̱ mogono ma na n tawai.<verse eid="PSA 132:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18" />N ta̱ kpa̱to n'yuwatan ma̱ yi na̱ wono,</para>
  <para style="q2" vid="PSA 132:18">waru a aaci a̱ yi ɗa maa zuwa</para>
  <para style="q2" vid="PSA 132:18">ookokolo o tsugono tse e ikana.&gt;&gt;<verse eid="PSA 132:18" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" sid="PSA 133" />
  <para style="s">Ulobonu u Muwwulai</para>
  <para style="d">Ishipa a agawan a̱ tyo uba̱ta̱ wa̱ a̱ga̱nda̱. Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1" />Uwwai nda,</para>
  <para style="q2" vid="PSA 133:1">nye i la'ai nda ulobonu nu uyo'o,</para>
  <para style="q2" vid="PSA 133:1">ama a̱ A̱sula̱ a yuwan nden m muwwulai!<verse eid="PSA 133:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2" />U ta̱ tsa mani'in ma sa'ani ma na a̱ tsuyin a aaci,</para>
  <para style="q2" vid="PSA 133:2">e meyene a̱ cipa̱ a̱ ntsuka̱,</para>
  <para style="q1" vid="PSA 133:2">e meyene a̱ cipa̱ a̱ ntsuka̱ ma Haruna,</para>
  <para style="q2" vid="PSA 133:2">a̱ cipa̱ a̱ yinlu yu utugu wa̱ yi.<verse eid="PSA 133:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3" />U ta̱ tsa̱ a'iza tsa na ri a masasan ma Hamon</para>
  <para style="q2" vid="PSA 133:3">na tsu da̱na̱ o ocusho a Nsasan ma̱ Sihiyona.</para>
  <para style="q1" vid="PSA 133:3">Adama a na ɗe ɗa A̱sulazuva a yuwain</para>
  <para style="q2" vid="PSA 133:3">nzuwulai ma aba'un a̱ yi,</para>
  <para style="q2" vid="PSA 133:3">a wuma u babu ukotu.<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" sid="PSA 134" />
  <para style="s">Ica yu Ulivu</para>
  <para style="d">Ishipa a agawan a̱ tyo uba̱ta̱ wa̱ a̱ga̱nda̱.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1" />Ta̱wa̱i, i ciɓala A̱sulazuva,</para>
  <para style="q2" vid="PSA 134:1">suru nɗu agbashi A̱sulazuva,</para>
  <para style="q1" vid="PSA 134:1">a̱ɗu na yaa yuwusan a̱ga̱nda̱</para>
  <para style="q2" vid="PSA 134:1">a̱tsuma̱ o u'wa wa̱ A̱sulazuva na ayin!<verse eid="PSA 134:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2" />'Ya̱sa̱yin ekere a̱ ɗu a̱ tyo Uba̱ta̱ u na u la'ai Akiza</para>
  <para style="q2" vid="PSA 134:2">a̱vu i ciɓala A̱sulazuva.<verse eid="PSA 134:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3" />Lyawa A̱sulazuva,</para>
  <para style="q2" vid="PSA 134:3">za na yuwain zuva ni iɗa,</para>
  <para style="q2" vid="PSA 134:3">zuwaa ɗu aba'un diga Sihiyona.<verse eid="PSA 134:3" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" sid="PSA 135" />
  <para style="s">Ica adama A̱sula̱ a na a la'ai Ucira Suru</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1" />Ciɓalai A̱sulazuva!</para>
  <para style="b" vid="PSA 135:1" />
  <para style="q1" vid="PSA 135:1">Ciɓalai ala a̱ A̱sulazuva!</para>
  <para style="q2" vid="PSA 135:1">Ciɓala niyi, a̱ɗu agbashi a̱ A̱sulazuva.<verse eid="PSA 135:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2" />A̱ɗu na yaa yuwusan a̱ga̱nda̱ o u'wa wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 135:2">a̱tsuma̱ o ukowo wu u'wa wa̱ A̱sula̱ a̱ tsu!<verse eid="PSA 135:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3" />Ciɓalai A̱sulazuva,</para>
  <para style="q2" vid="PSA 135:3">adama a na A̱sulazuva a̱ tu ulobonu!</para>
  <para style="q1" vid="PSA 135:3">Canayi ala a̱ yi ishipa yi ica,</para>
  <para style="q2" vid="PSA 135:3">adama a na A̱sulazuva a̱ tu ulobonu.<verse eid="PSA 135:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4" />Adama a na A̱sulazuva a ɗangwaa ta̱ aciya̱yi Yakubu,</para>
  <para style="q2" vid="PSA 135:4">Isra'ila waru wo o'wo itana ya̱ yi.<verse eid="PSA 135:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5" />N reve ta̱ A̱sulazuva a̱ ta̱ na̱ tsugbain,</para>
  <para style="q2" vid="PSA 135:5">A̱sulazuva a̱tsu a la'a ta̱ musula̱ suru.<verse eid="PSA 135:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6" />A̱sulazuva a tsu yuwan ta̱</para>
  <para style="q2" vid="PSA 135:6">ili i na i lobono niyi,</para>
  <para style="q1" vid="PSA 135:6">a̱tsuma̱ a zuva no o uvaɗi,</para>
  <para style="q2" vid="PSA 135:6">na̱ a̱tsuma̱ a mala na̱ a̱tsuma̱ a a̱ru'un e le suru.<verse eid="PSA 135:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7" />U tsu 'ya̱sa̱n ta̱ eleshe diga o ukosu wu uvaɗi,<note caller="-" style="x"><char style="xo" closed="false">135:7 </char><char style="xt" closed="false"><ref loc="JER 10:13">Irm 10:13</ref>; <ref loc="JER 51:16">51:16</ref>.</char></note></para>
  <para style="q2" vid="PSA 135:7">u tsu lyungu ta̱ ni imaɗatsu adama a̱ mini,</para>
  <para style="q1" vid="PSA 135:7">waru u tsu uta̱a̱ ta̱ upepu</para>
  <para style="q2" vid="PSA 135:7">diga o u'wa wi izuwa ya̱ yi.<verse eid="PSA 135:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8" />A̱yi ɗa u kototoi</para>
  <para style="q2" vid="PSA 135:8">muwun mu ufaru ma Masar<note caller="-" style="x"><char style="xo" closed="false">135:8 </char><char style="xt" closed="false"><ref loc="EXO 12:29-30">Mta̱ 12:29-30</ref>.</char></note>,</para>
  <para style="q1" vid="PSA 135:8">muwun mu ufaru ma ama</para>
  <para style="q2" vid="PSA 135:8">na̱ a̱za̱ e iliyamunga suru.<verse eid="PSA 135:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9" />U lyungu ta̱ iroci ni ili ya asalama</para>
  <para style="q2" vid="PSA 135:9">e memere ma̱ wu, a̱vu Masar,</para>
  <para style="q2" vid="PSA 135:9">a aci a Firi'awuna na agbashi a̱ yi suru.<verse eid="PSA 135:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10" />U kototo ta̱ nɗa na̱ a̱bunda̱<note caller="-" style="x"><char style="xo" closed="false">135:10 </char><char style="xt" closed="false"><ref loc="JOS 11:23">Jos 11:23</ref>; <ref loc="JOS 12:24">12:24</ref>.</char></note>,</para>
  <para style="q2" vid="PSA 135:10">a̱vu wu una ngono mu ucira,<verse eid="PSA 135:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11" />Sihon mogono ma aza a Amoriya</para>
  <para style="q2" vid="PSA 135:11">na̱ Og mogono ma Bashan,</para>
  <para style="q2" vid="PSA 135:11">na̱ ngono ma Ka'ana suru,<verse eid="PSA 135:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12" />a̱vu u ca nɗa n le mo o'wo agadu,</para>
  <para style="q2" vid="PSA 135:12">ili ya agadu uba̱ta̱ wa ama a̱ yi aza a Isra'ila.<verse eid="PSA 135:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13" />A̱sulazuva, ala a̱ wu a̱ ri nu ukosu shi,</para>
  <para style="q2" vid="PSA 135:13">A̱sulazuva ala a̱ wu a̱ ta̱ lo hali mantsa suru.<verse eid="PSA 135:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14" />Adama a na A̱sulazuva</para>
  <para style="q2" vid="PSA 135:14">o to roco a na ama a̱yi a̱ ri nu unusu shi,</para>
  <para style="q2" vid="PSA 135:14">a̱vu we ene iliyali ya agbashi a̱yi.<verse eid="PSA 135:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15" />A̱ma̱li a nɗa n ro azurufa ɗa na̱ zinariya<note caller="-" style="x"><char style="xo" closed="false">135:15-18 </char><char style="xt" closed="false"><ref loc="PSA 115:4-8">Ica 115:4-8</ref>; <ref loc="REV 9:20">Wen 9:20</ref>. </char></note>,</para>
  <para style="q2" vid="PSA 135:15">i na ekere a vaɗilima̱ a yuwain.<verse eid="PSA 135:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16" />A̱ ta̱ na̱ na̱ agba a tsu yuwan adanshi shi.</para>
  <para style="q2" vid="PSA 135:16">A̱ ta̱ ne esu agba e tse ene shi.<verse eid="PSA 135:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17" />A̱ ta̱ na atsuvu, agba a tsu uwwa shi,</para>
  <para style="q2" vid="PSA 135:17">waru a̱ ri nu wivuwun a̱ na̱ le shi.<verse eid="PSA 135:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18" />Aza a na aa yuwusan musula̱'a̱</para>
  <para style="q2" vid="PSA 135:18">o to o'wo tsa̱ le,</para>
  <para style="q1" vid="PSA 135:18">ne ɗa waru aza a na aa zuwusaa le ucira</para>
  <para style="q2" vid="PSA 135:18">a̱ ta̱ o o'wo tsa̱ le.<verse eid="PSA 135:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19" />A̱ɗu U'wa wa Isra'ila, ciɓala A̱sulazuva!</para>
  <para style="q1" vid="PSA 135:19">U'wa wa Haruna ciɓala A̱sulazuva!<verse eid="PSA 135:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20" />U'wa̱ wa̱ Levi ciɓala A̱sulazuva!</para>
  <para style="q2" vid="PSA 135:20">A̱ɗu aza a na yaa uwwusa wovon wa̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 135:20">ciɓalai A̱sulazuva!<verse eid="PSA 135:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21" />Ica a̱ tyo e ekere a̱ A̱sulazuva</para>
  <para style="q2" vid="PSA 135:21">diga Sihiyona,</para>
  <para style="q2" vid="PSA 135:21">a̱ yi na u ri nden a̱tsuma̱ a̱ Urishelima!</para>
  <para style="b" vid="PSA 135:21" />
  <para style="q1" vid="PSA 135:21">Ciɓalai A̱sulazuva!<verse eid="PSA 135:21" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" sid="PSA 136" />
  <para style="s">Ishipa yu ugodyusho yi icigi ya̱ A̱sula̱</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1" />I Godyoo A̱sulazuva,</para>
  <para style="q2" vid="PSA 136:1">adama a na a̱yi za̱ a̱ɓula̱ a ɗa<note caller="-" style="x"><char style="xo" closed="false">136:1 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 Alb 16:34</ref>; <ref loc="2CH 5:13">2 Alb 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Ezr 3:11</ref>; <ref loc="PSA 100:5">Ica 100:5</ref>; <ref loc="PSA 106:1">106:1</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="JER 33:11">Irm 33:11</ref>.</char></note>,</para>
  <para style="qr" vid="PSA 136:1">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2" />Godyowo yi A̱sula̱</para>
  <para style="q2" vid="PSA 136:2">za na la'ai musula̱,</para>
  <para style="qr" vid="PSA 136:2">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3" />Godyowo yi A̱sulazuva,</para>
  <para style="q2" vid="PSA 136:3">Zagbain va azagbain,</para>
  <para style="qr" vid="PSA 136:3">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4" />Godyowo yi za na a̱yi a̱ nden ɗa</para>
  <para style="q2" vid="PSA 136:4">u tsu yuwan linga va asalama,</para>
  <para style="qr" vid="PSA 136:4">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5" />Godyowo yi za na</para>
  <para style="q2" vid="PSA 136:5">o urevu wa̱ yi u ɗa u yuwain zuva<note caller="-" style="x"><char style="xo" closed="false">136:5 </char><char style="xt" closed="false"><ref loc="GEN 1:1">Ufr 1:1</ref>.</char></note>,</para>
  <para style="qr" vid="PSA 136:5">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6" />Godyowo yi za na</para>
  <para style="q2" vid="PSA 136:6">shuwa̱i iɗa zuva mini,</para>
  <para style="qr" vid="PSA 136:6">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7" />Godyowo yi</para>
  <para style="q2" vid="PSA 136:7">za na yuwain ekan a gbain e re<note caller="-" style="x"><char style="xo" closed="false">136:7 </char><char style="xt" closed="false"><ref loc="GEN 1:16">Ufr 1:16</ref>.</char></note>,</para>
  <para style="qr" vid="PSA 136:7">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8" />Urana adama u yuwan</para>
  <para style="q2" vid="PSA 136:8">tsugbain tsu urana,</para>
  <para style="qr" vid="PSA 136:8">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9" />Woto ni italyo'o waru</para>
  <para style="q2" vid="PSA 136:9">a yuwan tsugbain tsa ayin,</para>
  <para style="qr" vid="PSA 136:9">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10" />Godyowo yi za na ga̱la̱i</para>
  <para style="q2" vid="PSA 136:10">muwun mu ufaru ma Masar<note caller="-" style="x"><char style="xo" closed="false">136:10 </char><char style="xt" closed="false"><ref loc="EXO 12:29">Mta̱ 12:29</ref>.</char></note>,</para>
  <para style="qr" vid="PSA 136:10">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11" />Reve wu uta̱a̱ aza a Isra'ila</para>
  <para style="q2" vid="PSA 136:11">diga a̱tsuma̱ e le<note caller="-" style="x"><char style="xo" closed="false">136:11 </char><char style="xt" closed="false"><ref loc="EXO 12:51">Mta̱ 12:51</ref>.</char></note>,</para>
  <para style="qr" vid="PSA 136:11">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12" />Nu ukere wu ucira</para>
  <para style="q2" vid="PSA 136:12">na̱ linga va asalama,</para>
  <para style="qr" vid="PSA 136:12">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13" />Godyowo yi za na</para>
  <para style="q2" vid="PSA 136:13">ne'eshein Mala ma̱ Shili,</para>
  <para style="qr" vid="PSA 136:13">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14" />Reve u zuwa aza a Isra'ila</para>
  <para style="q2" vid="PSA 136:14">pasalai o uta̱ e memere ma̱ yi,</para>
  <para style="qr" vid="PSA 136:14">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15" />Amma a̱vu u liɓato Firi'awuna</para>
  <para style="q2" vid="PSA 136:15">na̱ a̱soja a̱ yi a̱tsuma̱ a Mala ma̱ Shili,</para>
  <para style="qr" vid="PSA 136:15">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16" />Godyowo yi za na ronoi</para>
  <para style="q2" vid="PSA 136:16">a ama a̱ yi aɗanga a̱tsuma̱ a̱tsumona,</para>
  <para style="qr" vid="PSA 136:16">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17" />Godyowo yi za na</para>
  <para style="q2" vid="PSA 136:17">ga̱la̱i ngono m gbagbain,</para>
  <para style="qr" vid="PSA 136:17">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18" />Wu una ta̱ ngono mu ucira</para>
  <para style="q2" vid="PSA 136:18">n na e revei ne e le,</para>
  <para style="qr" vid="PSA 136:18">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19" />Sihon mogono</para>
  <para style="q2" vid="PSA 136:19">ma aza Amoriya<note caller="-" style="x"><char style="xo" closed="false">136:19 </char><char style="xt" closed="false"><ref loc="NUM 21:21-30">Mkc 21:21-30</ref>.</char></note>,</para>
  <para style="qr" vid="PSA 136:19">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20" />Na̱ Og mogono</para>
  <para style="q2" vid="PSA 136:20">ma Bashan<note caller="-" style="x"><char style="xo" closed="false">136:20 </char><char style="xt" closed="false"><ref loc="NUM 21:31-35">Mkc 21:31-35</ref>.</char></note>,</para>
  <para style="qr" vid="PSA 136:20">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21" />Reve u ca nɗa n le mo o'wo</para>
  <para style="q2" vid="PSA 136:21">ili ya agadu ya ama a̱ yi,</para>
  <para style="qr" vid="PSA 136:21">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22" />Ili yaa agadu e ekere</para>
  <para style="q2" vid="PSA 136:22">a Isra'ila aagbashi a̱yi,</para>
  <para style="qr" vid="PSA 136:22">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23" />Godyowo yi za na cuwain na̱ tsu,</para>
  <para style="q2" vid="PSA 136:23">a̱tsuma̱ o ulambu wu ucira u tsu,</para>
  <para style="qr" vid="PSA 136:23">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24" />Reve u wawa tsu</para>
  <para style="q2" vid="PSA 136:24">e ekere a n'yuwatan ntsu,</para>
  <para style="qr" vid="PSA 136:24">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25" />Godyowo yi za na aa casu</para>
  <para style="q2" vid="PSA 136:25">ili i wuma suru ilyalya,</para>
  <para style="qr" vid="PSA 136:25">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26" />Godyowo yi A̱sula̱</para>
  <para style="q2" vid="PSA 136:26">a na a̱ ri zuva,</para>
  <para style="qr" vid="PSA 136:26">
    <char style="tl">Icigi ya̱ i na i tsu vadala shi, i ta̱ lo hali hali.</char><verse eid="PSA 136:26" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" sid="PSA 137" />
  <para style="s">Mesun ma aza a Isra'ila e iɗa i tsugbashi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1" />A̱ kyun vu ɗolu va Babila,</para>
  <para style="q2" vid="PSA 137:1">ɗe ɗa tsu da̱nuyi a̱vu tsu shon,</para>
  <para style="q2" vid="PSA 137:1">a mantsa ma na tsu cuwain Sihiyona.<verse eid="PSA 137:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2" />A̱vu tsu sa̱ga̱do ikumburu i tsu</para>
  <para style="q2" vid="PSA 137:2">e eten a ɗanga.<verse eid="PSA 137:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3" />Adama a na ɗe ɗa aza a na e reme ntsu</para>
  <para style="q2" vid="PSA 137:3">a zuwa ntsu tsu canaa le ishipa,</para>
  <para style="q1" vid="PSA 137:3">aza a na a casu tsu a̱tsuma̱lima̱</para>
  <para style="q2" vid="PSA 137:3">a cigai ishipa i ma̱za̱nga̱ ya̱'a̱ tsu,</para>
  <para style="q1" vid="PSA 137:3">a dansa, &lt;&lt;Canaa ntsu ishipa i ta̱</para>
  <para style="q2" vid="PSA 137:3">a̱tsuma̱ e ishipa ya̱ Sihiyona!&gt;&gt;<verse eid="PSA 137:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4" />Cine tsaa cana ishipa ya̱ A̱sulazuva</para>
  <para style="q2" vid="PSA 137:4">a̱tsuma̱ e iɗa i limocin?<verse eid="PSA 137:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5" />A̱vu Urishelima, n na̱ mi icina na̱ a̱vu,</para>
  <para style="q2" vid="PSA 137:5">lyawa ukere usa'ani u va̱ wi icina nu uguru wa̱ yi.<verse eid="PSA 137:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6" />Lyawa eelentsu a̱ va̱ a kaɓalai nu una̱ wo gon u va̱</para>
  <para style="q2" vid="PSA 137:6">na̱ n cuwan na̱ a̱vu shi,</para>
  <para style="q1" vid="PSA 137:6">na̱ n tara Urishelima</para>
  <para style="q2" vid="PSA 137:6">ili i na i la'aa numu ma̱za̱nga̱ shi.<verse eid="PSA 137:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7" />A̱sulazuva vu cuwan,</para>
  <para style="q2" vid="PSA 137:7">ni ili i na a̱za̱ a̱ Edom a yuwain</para>
  <para style="q2" vid="PSA 137:7">o urana u na Urishelima riya̱i.</para>
  <para style="q1" vid="PSA 137:7">Ununa a dammai,</para>
  <para style="q2" vid="PSA 137:7">&lt;&lt;Oco niyi e iɗa! Oco niyi e iɗa,</para>
  <para style="q2" vid="PSA 137:7">hali she e ikyun ya̱ yi.&gt;&gt;<verse eid="PSA 137:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8" />A̱vu Babila</para>
  <para style="q2" vid="PSA 137:8">o to kototo wu!<note caller="-" style="x"><char style="xo" closed="false">137:8 </char><char style="xt" closed="false"><ref loc="REV 18:6">Wen 18:6</ref>.</char></note></para>
  <para style="q1" vid="PSA 137:8">Za ma̱za̱nga̱ ɗa,</para>
  <para style="q2" vid="PSA 137:8">zana a tsupa aciya̱wu,</para>
  <para style="q2" vid="PSA 137:8">o una̱ wi ili i na vu yuwaan ntsu!<verse eid="PSA 137:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9" />Za ma̱za̱nga̱ ɗa</para>
  <para style="q2" vid="PSA 137:9">za a na aa usa nreɓu ma̱ wu</para>
  <para style="q2" vid="PSA 137:9">reve a kpukpasu'wa le a atali.<verse eid="PSA 137:9" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" sid="PSA 138" />
  <para style="s">Ishipa yu Ugodyusho</para>
  <para style="d">Ica ya̱ Da̱wuda.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1" />N ta̱ godyowo wu A̱sulazuva,</para>
  <para style="q2" vid="PSA 138:1">no okolo a̱ va̱ ma̱ɓula̱,</para>
  <para style="q2" vid="PSA 138:1">n ta canaa wu ishipa yi ica a̱ ma̱ka̱ka̱n m musula̱.<verse eid="PSA 138:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2" />N ta̱ kingyo a̱ ka̱lyuwusa̱</para>
  <para style="q2" vid="PSA 138:2">a̱ A̱a̱'isamapaɗa akiza a̱ wu,</para>
  <para style="q1" vid="PSA 138:2">n ta̱ godyowo ala a̱ wu</para>
  <para style="q2" vid="PSA 138:2">adama e icigi ya̱ wu i na i tsu vadala shi na̱ a̱ɓula̱ a̱ wu,</para>
  <para style="q1" vid="PSA 138:2">adama a na vu ca ta̱ ala a̱ wu na adanshi a̱ wu tsugbain</para>
  <para style="q2" vid="PSA 138:2">ula'awu ni ili biti.<verse eid="PSA 138:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3" />Urana u na n ɗeyi, vu usu mu,</para>
  <para style="q2" vid="PSA 138:3">reve vu gbamato okolo a̱ va̱ nu ucira.<verse eid="PSA 138:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4" />A̱sulazuva, lyawa ngono</para>
  <para style="q2" vid="PSA 138:4">mu uvaɗi suru n ciɓala wu,</para>
  <para style="q2" vid="PSA 138:4">a mantsa ma na aa uwwa adanshi o una̱ wa̱ wu.<verse eid="PSA 138:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5" />A ta cana ishipa yi ica</para>
  <para style="q2" vid="PSA 138:5">yi re va̱ A̱sulazuva,</para>
  <para style="q1" vid="PSA 138:5">adama a na tsugbain tsa̱ A̱sulazuva</para>
  <para style="q2" vid="PSA 138:5">tsa̱ ta̱ mgbain.<verse eid="PSA 138:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6" />Ko na wo o'woi A̱sulazuva a̱ ta̱ zuva,</para>
  <para style="q2" vid="PSA 138:6">u ta̱ ka̱lyuwusa̱ aza a na a tarai aciyele ili i ro shi.</para>
  <para style="q1" vid="PSA 138:6">Amma aza aciyogbamu</para>
  <para style="q2" vid="PSA 138:6">u tsu reve le ta̱ diga alanga.<verse eid="PSA 138:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7" />Ko na̱ shi n ri a mmalu a̱tsuma̱ a̱tsuma̱lima̱,</para>
  <para style="q2" vid="PSA 138:7">vu tsu wawa mu ta̱,</para>
  <para style="q1" vid="PSA 138:7">vu tsu ba̱ruwa̱ ta̱ ukere wa̱ wu</para>
  <para style="q2" vid="PSA 138:7">a̱ nla̱ngi na̱ n'yuwatan n va̱ a̱tsuma̱ o upan ule,</para>
  <para style="q2" vid="PSA 138:7">waru ukere usa'ani wa̱ wu u tsu wawa mu ta̱.<verse eid="PSA 138:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8" />A̱sulazuva o to shiton ifoɓi ya̱ yi aci a̱ va̱.</para>
  <para style="q2" vid="PSA 138:8">Adama a na icigi ya̱ wu i na i tsu vadala shi i ta̱ lo hali hali</para>
  <para style="q1" vid="PSA 138:8">A̱sulazuva, she vi icina</para>
  <para style="q2" vid="PSA 138:8">nu ulinga we ekere a̱ wu wan.<verse eid="PSA 138:8" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" sid="PSA 139" />
  <para style="s">Avasa uba̱ta̱ wa̱ A̱sula̱ za na revei ili biti</para>
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Ica ya̱ Da̱wuda.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1" />A̱sulazuva, vu ka̱lyuwa̱ ta̱ okolo a̱ va̱,</para>
  <para style="q2" vid="PSA 139:1">waru vu reve mu ta̱.<verse eid="PSA 139:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2" />A̱vu ɗa vu revei nden n va̱</para>
  <para style="q2" vid="PSA 139:2">nu u u'yosun u va̱,</para>
  <para style="q2" vid="PSA 139:2">waru vu tsu reve ta̱ majiyan ma̱ va̱ diga alanga.<verse eid="PSA 139:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3" />Vu tsi idana ta̱ mmalu n va̱,</para>
  <para style="q2" vid="PSA 139:3">vu reve ta̱ na̱ wu utusa̱ u va̱,</para>
  <para style="q2" vid="PSA 139:3">na̱ nven n va̱ suru.<verse eid="PSA 139:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4" />Babu na adanshi o uta̱i o una̱ u va̱, A̱sulazuva,</para>
  <para style="q2" vid="PSA 139:4">vu reve ta̱ ɗe na̱ a̱yi suru.<verse eid="PSA 139:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5" />Vu tsu ka̱nda̱ruwa̱ mu ta̱ elime na̱ a̱ca̱pa̱,</para>
  <para style="q2" vid="PSA 139:5">reve vu yuwaan mu mapari nu ukere wa̱ wu.<verse eid="PSA 139:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6" />Cu'un vu urevu u ndolo</para>
  <para style="q2" vid="PSA 139:6">u la'a ta̱ ucira u va̱,</para>
  <para style="q1" vid="PSA 139:6">ili yu usokowu wa̱ a̱ru'un a ɗa</para>
  <para style="q2" vid="PSA 139:6">a na u la'ai urevu u va̱.<verse eid="PSA 139:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7" />Te ɗa mee tyo n sumaa Ruhu va̱ wu?</para>
  <para style="q2" vid="PSA 139:7">Te ɗa mee tyo m pa'an urewesu wa̱ wu?<verse eid="PSA 139:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8" />Na̱ n kumba a gawan zuva, vu ta̱ ɗe.</para>
  <para style="q2" vid="PSA 139:8">Na̱ m polo aavalu a̱ va̱</para>
  <para style="q2" vid="PSA 139:8">e iɗa uba̱ta̱ wa̱ a̱kwa̱kwa̱, vu ta̱ pe.<verse eid="PSA 139:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9" />Ko na̱ mu 'yawan na̱ wasasa,</para>
  <para style="q2" vid="PSA 139:9">reve n da̱nu o ukosu u mala,<verse eid="PSA 139:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10" />ko ɗe'e fo ukere wa̱ wu u ta̱ kuru na̱ a̱mu,</para>
  <para style="q2" vid="PSA 139:10">ukere usa'ani wa̱ wu u ta̱ guza̱ mu ugbamu.<verse eid="PSA 139:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11" />Nna̱ n damma,&lt;&lt;Amayun irumbu i ta̱ ɓa̱ru mu,</para>
  <para style="q2" vid="PSA 139:11">ekan a na a̱ ri uka̱nda̱ruwu na̱ a̱mu o o'wo ta̱ ayin,&gt;&gt;<verse eid="PSA 139:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12" />Ko irumbu'u gba irumbu i ɗa e ekere a̱ wu shi,</para>
  <para style="q2" vid="PSA 139:12">waru ayin e te ikanasa tsu urana,</para>
  <para style="q2" vid="PSA 139:12">adama a na irumbu ne ekan ili i ta̱ i ɗa e ekere a̱ wu.<verse eid="PSA 139:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13" />A̱vu ɗa vu yuwain ili ya̱ a̱a̱tsuma̱ i va̱,</para>
  <para style="q2" vid="PSA 139:13">vu ɓolulo numu a̱ a̱a̱tsuma̱ a mma va̱.<verse eid="PSA 139:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14" />N ta ciɓalasa wu,</para>
  <para style="q2" vid="PSA 139:14">adama a na cine vu yuwan numu ili i wovon i ɗa ni ili ya asalama.</para>
  <para style="q1" vid="PSA 139:14">Linga va̱ wu ili ya asalama i ɗa,</para>
  <para style="q2" vid="PSA 139:14">n reve ta̱ na̱ ele ulobonu.<verse eid="PSA 139:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15" />Uruma u va̱ u ri usokowu e ekere a̱ wu shi,</para>
  <para style="q2" vid="PSA 139:15">mantsa ma na a yuwan numu usokowu,</para>
  <para style="q2" vid="PSA 139:15">a mantsa ma na a rumusa mu a̱tsuma̱ a̱ a̱ru'un o uvaɗi.<verse eid="PSA 139:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 139:16" />Esu a̱ wu e ene ta̱ pasu lipu va̱</para>
  <para style="q2" vid="PSA 139:16">kafu a shiwan.</para>
  <para style="q1" vid="PSA 139:16">A̱tsuma̱ aatagada a̱ wu a ɗana ta̱</para>
  <para style="q2" vid="PSA 139:16">a̱bunda̱ a rana na o foɓoi adama a̱ va̱,</para>
  <para style="q2" vid="PSA 139:16">kafu ko za ta̱ a̱tsuma̱ le o o'wo.<verse eid="PSA 139:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17" />A̱sula̱, majiyan ma̱ wu</para>
  <para style="q2" vid="PSA 139:17">adama a̱ va̱ a̱ ri ni iroci shi!</para>
  <para style="q2" vid="PSA 139:17">A gura kece le shi.<verse eid="PSA 139:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18" />Na̱ maa gura kece le</para>
  <para style="q2" vid="PSA 139:18">a ta la'a wuyun a̱bunda̱.</para>
  <para style="q1" vid="PSA 139:18">Mantsa ma na n juwain</para>
  <para style="q2" vid="PSA 139:18">n to oɓolo na̱ a̱vu waru.<verse eid="PSA 139:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19" />A̱sula̱, na̱ shi de a damma</para>
  <para style="q2" vid="PSA 139:19">vu ta̱ kototo a̱za̱ e iwuya</para>
  <para style="q1" vid="PSA 139:19">aza a na a cigai wocosu wu mpasa waru</para>
  <para style="q2" vid="PSA 139:19">a kasa na̱ a̱mu.<verse eid="PSA 139:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20" />Aza a na a yuwusan adanshi</para>
  <para style="q2" vid="PSA 139:20">e iwuya a aci a̱ wu,</para>
  <para style="q1" vid="PSA 139:20">n'yuwatan ma̱ wu aza a na a yuwusan adanshi,</para>
  <para style="q2" vid="PSA 139:20">a avama adama ala a̱ wu.<verse eid="PSA 139:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21" />A̱sulazuva, maa 'yuwusan</para>
  <para style="q2" vid="PSA 139:21">aza a na a 'yuwan nuwu shi?</para>
  <para style="q1" vid="PSA 139:21">Waru maa uwwusa upan wa aza a na</para>
  <para style="q2" vid="PSA 139:21">aa yuwusan nla̱ngi na̱ a̱vu shi?<verse eid="PSA 139:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22" />N 'yuwan le ta̱ suru suru,</para>
  <para style="q2" vid="PSA 139:22">na amayun n tara le ta̱ n'yuwatan n va̱.<verse eid="PSA 139:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23" />Gbangaɗa mu A̱sula̱,</para>
  <para style="q2" vid="PSA 139:23">vu ta̱ reve okolo a̱ va̱,</para>
  <para style="q1" vid="PSA 139:23">lyungwa̱ mu, vu ta̱ gba reve</para>
  <para style="q2" vid="PSA 139:23">majiyan ma̱ va̱.<verse eid="PSA 139:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24" />Vu ka̱lyuwa̱ ve ene,</para>
  <para style="q2" vid="PSA 139:24">ko ure wi iwuya i ro</para>
  <para style="q2" vid="PSA 139:24">i ta̱ pe a̱tsuma̱ a̱ va̱,</para>
  <para style="q1" vid="PSA 139:24">vu toni na̱ mu o ure</para>
  <para style="q2" vid="PSA 139:24">u wuma u na u ri hali hali.<verse eid="PSA 139:24" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" sid="PSA 140" />
  <para style="s">Avasa e ibingi i mapari adama a n'yuwatan</para>
  <para style="d">Udammu a̱ tyo a̱ ma̱dobiya. Ica ya̱ Da̱wuda.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1" />A̱sulazuva, wawa mu</para>
  <para style="q2" vid="PSA 140:1">diga e ekere a̱za̱ e iwuya,</para>
  <para style="q1" vid="PSA 140:1">vu yuwaan mu mapari diga e ekere</para>
  <para style="q2" vid="PSA 140:1">a̱za̱ o 'ya̱susa̱n wu ugbozu,<verse eid="PSA 140:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2" />aza a na oo foɓuso ifoɓi yi iwuya o okolo e le,</para>
  <para style="q2" vid="PSA 140:2">a̱ ta̱ ta̱wa̱sa̱ nu uvon mantsa suru.<verse eid="PSA 140:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3" />Elentsu e le waru a̱ ta̱ tsi iyo i tsukono,<note caller="-" style="x"><char style="xo" closed="false">140:3 </char><char style="xt" closed="false"><ref loc="ROM 3:13">Rom 3:13</ref>.</char></note></para>
  <para style="q2" vid="PSA 140:3">idanshi yi na̱ le fo a̱ ta̱ tsa tsukono tsa apili. <char style="qs">Wivuwun</char><verse eid="PSA 140:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4" />A̱sulazuva, vu wawa mu</para>
  <para style="q2" vid="PSA 140:4">diga e ekere a̱ a̱za̱ e iwuya,</para>
  <para style="q1" vid="PSA 140:4">vu yuwaan mu mapari,</para>
  <para style="q2" vid="PSA 140:4">e ekere a̱za̱ o 'ya̱susa̱n ugbozu,</para>
  <para style="q2" vid="PSA 140:4">aza a na o foɓoo numu a̱risa̱.<verse eid="PSA 140:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5" />Aza a aciyogbamu aa azuwa mu ta̱ maza,</para>
  <para style="q2" vid="PSA 140:5">ni igolo i ɗa aa azuwa numu maza,</para>
  <para style="q1" vid="PSA 140:5">a̱tsuma̱ o ure aa azuwa mu ta̱ maza</para>
  <para style="q2" vid="PSA 140:5">adama e reme mu. <char style="qs">Wivuwun</char><verse eid="PSA 140:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6" />N damma ta̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 140:6">&lt;&lt;A̱vu ɗa A̱sula̱ a̱ va̱.&gt;&gt;</para>
  <para style="q1" vid="PSA 140:6">A̱sulazuva vu uwwa mesun ma̱ va̱,</para>
  <para style="q2" vid="PSA 140:6">vu roco mu iliyali.<verse eid="PSA 140:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7" />A̱sulazuva, zagbain,</para>
  <para style="q2" vid="PSA 140:7">za vi iwawi i va̱,</para>
  <para style="q1" vid="PSA 140:7">za na yuwayin aaci a̱ va̱ a̱a̱ra̱ga̱,</para>
  <para style="q2" vid="PSA 140:7">o urana wu uvon.<verse eid="PSA 140:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8" />A̱sulazuva, she vu shitowon a̱za̱ e iwuya</para>
  <para style="q2" vid="PSA 140:8">ili i na a cigai wan,</para>
  <para style="q1" vid="PSA 140:8">She vu lyawa ifoɓi i le i shiwan wan,</para>
  <para style="q2" vid="PSA 140:8">ta̱wa̱ a yuwan uvaɗu wan.<char style="qs">Wivuwun</char><verse eid="PSA 140:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9" />Lyawa aza a na a̱ ka̱nda̱ruwa̱ numu</para>
  <para style="q2" vid="PSA 140:9">addama a na na̱ le ta̱wa̱ a̱ ɓa̱ru le.<verse eid="PSA 140:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10" />Lyawa akinkina a madala</para>
  <para style="q2" vid="PSA 140:10">o oco a aci e le.</para>
  <para style="q1" vid="PSA 140:10">Lyawa a vari le a̱tsuma̱ a akina,</para>
  <para style="q2" vid="PSA 140:10">a̱tsuma̱ o oko'o a̱ a̱ru'un uba̱ta̱ u na a̱a̱ da̱shi uta̱ shi.<verse eid="PSA 140:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11" />She a̱za̱ o ulungusu wa ala a yuwan ucira</para>
  <para style="q2" vid="PSA 140:11">a̱tsuma̱ o uvaɗi wan,</para>
  <para style="q1" vid="PSA 140:11">Lyawa iwuya i saɓa aza a na a̱ 'ya̱sa̱sa̱n ugbozu</para>
  <para style="q2" vid="PSA 140:11">hali u kototo le.<verse eid="PSA 140:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12" />N reve ta̱ A̱sulazuva a ta kamba a̱za̱ o ulambu,</para>
  <para style="q2" vid="PSA 140:12">n reve ta̱ u ta yuwan a̱ɓula̱ uba̱ta̱ wa aza a na a cigai ikambishi.<verse eid="PSA 140:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13" />Amayun a̱za̱ a̱ a̱ɓula̱ a ta ciɓala ala a̱ wu,</para>
  <para style="q2" vid="PSA 140:13">waru aza a na a yuwusan ili i na i ri mejege,</para>
  <para style="q2" vid="PSA 140:13">a̱ ta̱ da̱nu a̱ ma̱ka̱ka̱n ma̱ wu.<verse eid="PSA 140:13" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" sid="PSA 141" />
  <para style="s">Avasa e izami i mapari diga e iwuya</para>
  <para style="d">Ica ya̱ Da̱wuda.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1" />A̱sulazuva, n te ɗewu uba̱ta̱ wa̱ wu,</para>
  <para style="q2" vid="PSA 141:1">ta̱wa̱ uba̱ta̱ u va̱ gogogo,</para>
  <para style="q2" vid="PSA 141:1">vu uwwa uɗyo u va̱, a mantsa ma na n ɗeyi!<verse eid="PSA 141:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2" />Lyawa avasa a̱ va̱ o'wo,</para>
  <para style="q2" vid="PSA 141:2">cine vu revei ukula̱tosu wi ili i ma̱guru,<note caller="-" style="x"><char style="xo" closed="false">141:2 </char><char style="xt" closed="false"><ref loc="REV 5:8">Wen 5:8</ref>.</char></note></para>
  <para style="q1" vid="PSA 141:2">lyawa u'ya̱susa̱n we ekere a̱ va̱</para>
  <para style="q2" vid="PSA 141:2">o o'wo tsa̱ kucci vu ulivu.<verse eid="PSA 141:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3" />A̱sulazuva vu zuwa mu n reme una̱ u va̱,</para>
  <para style="q2" vid="PSA 141:3">vi idana gan vu una̱ u va̱.<verse eid="PSA 141:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4" />She vu lyawa okolo a̱ va̱ a vadala</para>
  <para style="q2" vid="PSA 141:4">a̱ tyo o ure wi iwuya wan,</para>
  <para style="q1" vid="PSA 141:4">ko n zuwa ukere o ulinga wi iwuya</para>
  <para style="q2" vid="PSA 141:4">oɓolo na aza a na a yuwusan iwuya wan,</para>
  <para style="q1" vid="PSA 141:4">she vu lyawa mu n lyuwa</para>
  <para style="q2" vid="PSA 141:4">a̱tsuma̱ e ilyalya yu uyo'o i le wan.<verse eid="PSA 141:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5" />Lyawa vuma va̱ a̱ɓula̱ ɓara mu,</para>
  <para style="q2" vid="PSA 141:5">isa'ani i ɗa.</para>
  <para style="q1" vid="PSA 141:5">Lyawa u rono mu atsuvu,</para>
  <para style="q2" vid="PSA 141:5">a̱yi tsa mani'in ma ɗa a aaci a̱ va̱.</para>
  <para style="q2" vid="PSA 141:5">Aaci a̱ va̱ aa 'yuwan yi shi.</para>
  <para style="q1" vid="PSA 141:5">Suru na̱ ne avasa a̱ va̱ a̱ ta̱ a̱ nla̱ngi,</para>
  <para style="q2" vid="PSA 141:5">nu ulinga wi iwuya i le.<verse eid="PSA 141:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6" />A mantsa ma na a variyi</para>
  <para style="q2" vid="PSA 141:6">a̱za̱ o tsugono tsa̱ le</para>
  <para style="q2" vid="PSA 141:6">diga a̱ ncilecile ma aatali,</para>
  <para style="q1" vid="PSA 141:6">ɗaɗa a̱za̱ e iwuya aa uwwa adanshi a̱ va̱,</para>
  <para style="q2" vid="PSA 141:6">a̱vu e reve amayun a ɗa.<verse eid="PSA 141:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7" />A ta damma, &lt;&lt;Cine a tsu luma reve a ɓatsa iɗa,</para>
  <para style="q2" vid="PSA 141:7">ne ɗa etele a̱ tsu a bazai uba̱ta̱ wu nden wa̱ a̱kwa̱kwa̱.&gt;&gt;<verse eid="PSA 141:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8" />Amma esu a̱ va̱ a̱ ta̱ uba̱ta̱ wa̱ wu,</para>
  <para style="q2" vid="PSA 141:8">Mogono ma̱ A̱sulazuva,</para>
  <para style="q1" vid="PSA 141:8">uba̱ta̱ wa̱ wu u ɗa maa zama upa'atan,</para>
  <para style="q2" vid="PSA 141:8">she vu lyawa wuma u va̱,</para>
  <para style="q2" vid="PSA 141:8">a̱tsuma̱ e meleshe wan.<verse eid="PSA 141:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9" />Vu yuwaan mu mapari</para>
  <para style="q2" vid="PSA 141:9">na̱ maza ma na a azuyi adama a̱ va̱,</para>
  <para style="q2" vid="PSA 141:9">na̱ maza ma̱ a̱za̱ e iwuya.<verse eid="PSA 141:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10" />Lyawa a̱za̱ e iwuya a̱ riya̱</para>
  <para style="q2" vid="PSA 141:10">a̱tsuma̱ e igolo i le,</para>
  <para style="q2" vid="PSA 141:10">amma a̱mu gba n ka̱ra̱ gbaga.<verse eid="PSA 141:10" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" sid="PSA 142" />
  <para style="s">Avasa e izami yi ikambishi a̱tsuma̱ a̱tsuma̱lima̱</para>
  <para style="d">Ica ya̱ Da̱wuda. Udammu a̱ tyo a̱ ma̱dobiya. &lt;&lt;Ishipa yu uyo'o&gt;&gt; A mantsa ma na u da̱na̱i a̱ a̱a̱ba̱nu.<note caller="-" style="x"><char style="xo" closed="false">142:0 </char><char style="xt" closed="false"><ref loc="1SA 22:1">1 Sam 22:1</ref>; <ref loc="1SA 24:3">24:3</ref>.</char></note> Avasa a ɗa.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1" />N 'yasan ta̱ uɗyo u va̱</para>
  <para style="q2" vid="PSA 142:1">a̱ tyo uba̱ta̱ wa̱ A̱sulazuva.</para>
  <para style="q1" vid="PSA 142:1">Nu uɗyo u va̱ u ɗa n ri e ipati</para>
  <para style="q2" vid="PSA 142:1">yi isa'ani uba̱ta̱ wa̱ wu.<verse eid="PSA 142:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2" />N ta̱wa̱a̱ ta̱ ni ili i na ya̱a̱ ɓa̱la̱ mu suru a̱ ma̱ka̱ka̱n ma̱ yi,</para>
  <para style="q2" vid="PSA 142:2">a̱ ma̱ka̱ka̱n ma̱ yi ma ɗa maa dansa addama a̱ va̱.<verse eid="PSA 142:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3" />A mantsa ma na okolo a̱ va̱ a cigai makuɗaa,</para>
  <para style="q2" vid="PSA 142:3">a̱vu ɗa vu revei ure u na ma̱a̱ kuru.</para>
  <para style="b" vid="PSA 142:3" />
  <para style="q1" vid="PSA 142:3">A̱tsuma̱ o ure u na ma̱a̱ kurusu</para>
  <para style="q2" vid="PSA 142:3">n'yuwatan n va̱ mazuwa mu ta̱ maza.<verse eid="PSA 142:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4" />Ka̱lyuwa̱ upasu wu ukere usa'ani u va̱ vee ene,</para>
  <para style="q2" vid="PSA 142:4">ko za ri lo aɗa a̱ va̱ shi.</para>
  <para style="q1" vid="PSA 142:4">N ri nu uba̱ta̱ u na maa suma m pa'an shi,</para>
  <para style="q2" vid="PSA 142:4">ko za ri lo aɗa a wuma u va̱ shi.<verse eid="PSA 142:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5" />N showen ta̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 142:5">n damma, &lt;&lt;A̱vu ɗa upa'atan u va̱,</para>
  <para style="q2" vid="PSA 142:5">a̱vu ɗa ili i na n ri na̱ yi</para>
  <para style="q2" vid="PSA 142:5">a̱tsuma̱ o uvaɗi wa aza a wuma.&gt;&gt;<verse eid="PSA 142:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6" />Poloo mesun ma̱ va̱ atsuvu,</para>
  <para style="q2" vid="PSA 142:6">adama a na n ta̱ pe a̱tsuma̱ a̱tsuma̱lima̱ lon.</para>
  <para style="q1" vid="PSA 142:6">Vu wawa mu e ekere a aza a na oo ɓongishi mu,</para>
  <para style="q2" vid="PSA 142:6">adama a na a la'a ta̱ ucira u va̱.<verse eid="PSA 142:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7" />Uta̱a̱ wuma u va̱ diga a̱tsuma̱ o u'wa wa ali,</para>
  <para style="q2" vid="PSA 142:7">adama n ciɓala ala a̱ wu.</para>
  <para style="q1" vid="PSA 142:7">A̱za̱ a̱ a̱ɓula̱ a̱ ta̱ ka̱nda̱ruwa̱ mu,</para>
  <para style="q2" vid="PSA 142:7">adama a na vu ta yuwaan mu isa'ani lon.<verse eid="PSA 142:7" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" sid="PSA 143" />
  <para style="s">Avasa e izami yi ikambishi na̱ mapari</para>
  <para style="d">Ica ya̱ Da̱wuda.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1" />A̱sulazuva uwwa avasa a̱ va̱,</para>
  <para style="q2" vid="PSA 143:1">vu poloo ipati i va̱ atsuvu</para>
  <para style="q2" vid="PSA 143:1">vee ene iliyali i va̱,</para>
  <para style="q1" vid="PSA 143:1">vu usu mu a̱tsuma̱ a amayun a̱ wu,</para>
  <para style="q2" vid="PSA 143:1">na̱ a̱tsuma̱ a̱ɓula̱.<verse eid="PSA 143:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2" />She vu ge'eto aagbashi<note caller="-" style="x"><char style="xo" closed="false">143:2 </char><char style="xt" closed="false"><ref loc="ROM 3:20">Rom 3:20</ref>; <ref loc="GAL 2:16">Gal 2:16</ref>.</char></note> a̱ wu wan,</para>
  <para style="q2" vid="PSA 143:2">adama a na babu za wuma na ri</para>
  <para style="q2" vid="PSA 143:2">na̱ a̱ɓula̱ a̱ ma̱ka̱ka̱n ma̱ wu.<verse eid="PSA 143:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3" />Ma'yuwatan ma̱ va̱ ma gbagba mu ta̱,</para>
  <para style="q2" vid="PSA 143:3">u minjira mu ta̱ e iɗa.</para>
  <para style="q1" vid="PSA 143:3">U zuwa mu ta̱ n da̱nu a̱tsuma̱ e irumbu</para>
  <para style="q2" vid="PSA 143:3">tsa aza a na a jimai ɗe ukwa̱.<verse eid="PSA 143:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4" />Adama o ndolo mu uta̱a̱ ta̱ ookolo,</para>
  <para style="q2" vid="PSA 143:4">okolo a̱ va̱ a dama ta̱ lon.<verse eid="PSA 143:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5" />N cuwusan ta̱ na̱ rana na ka̱ra̱i,</para>
  <para style="q2" vid="PSA 143:5">n ta̱ majiyan ma linga va̱ wu suru,</para>
  <para style="q2" vid="PSA 143:5">n ta majiyan e ekere a linga ve ekere a̱ wu.<verse eid="PSA 143:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6" />N 'ya̱sa̱n ta̱ ekere a̱ va̱ a̱ tyo ya̱'a̱ wu,</para>
  <para style="q2" vid="PSA 143:6">wuma u va̱ u ta maluwa ma̱ wu</para>
  <para style="q2" vid="PSA 143:6">tse e iɗa yu u'yewu i na i ri na akuli.<char style="qs">Wivuwun</char><verse eid="PSA 143:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7" />A̱sulazuva, jika̱ vu usu mu,</para>
  <para style="q2" vid="PSA 143:7">okolo a̱ va̱ a kuɗa ta̱!</para>
  <para style="q1" vid="PSA 143:7">She vu sokowo mu urewesu wa̱ wu wan,</para>
  <para style="q2" vid="PSA 143:7">ta̱wa̱ mo o'wo tsa aza a na a̱a̱ zurusa̱ a̱ tyo o ukwisa̱ wan.<verse eid="PSA 143:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8" />Lyawa usana suru mu uwwa aɗa</para>
  <para style="q2" vid="PSA 143:8">e icigi ya̱ wu i na i tsu vadala shi,</para>
  <para style="q2" vid="PSA 143:8">adama a na n zuwa ta̱ ucira u va̱ ya̱'a̱ wu.</para>
  <para style="q1" vid="PSA 143:8">Roco mu ure u na ma̱a̱ kuru,</para>
  <para style="q2" vid="PSA 143:8">adama a na ya̱'a̱ wu ɗa n zuwai wuma u va̱.<verse eid="PSA 143:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9" />A̱sulazuva, vu wawa mu</para>
  <para style="q2" vid="PSA 143:9">e ekere a n'yuwatan n va̱,</para>
  <para style="q2" vid="PSA 143:9">uba̱ta̱ wa̱ wu u ɗa maa zamishi upa'atan.<verse eid="PSA 143:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10" />Roco mu n yuwan ili i na vu cigai,</para>
  <para style="q2" vid="PSA 143:10">adama a na a̱vu ɗa A̱sula̱ a̱ va̱.</para>
  <para style="q1" vid="PSA 143:10">Lyawa Ruhu vi isa'ani va̱ wu u ronoo mu aɗanga</para>
  <para style="q2" vid="PSA 143:10">a̱tsuma̱ o ure u na u ri mejege.<verse eid="PSA 143:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11" />A̱sulazuva, adama a tsugbain tsa aala a̱ wu,</para>
  <para style="q2" vid="PSA 143:11">vu wawa wuma u va̱,</para>
  <para style="q1" vid="PSA 143:11">a̱tsuma̱ a̱ a̱ɓula̱ a̱ wu,</para>
  <para style="q2" vid="PSA 143:11">vu uta̱a̱ wuma u va̱ a̱tsuma̱ a addama.<verse eid="PSA 143:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12" />A̱tsuma̱ e icigi ya̱ wu i na i tsu vadala shi,</para>
  <para style="q2" vid="PSA 143:12">vu kototo n'yuwatan n va̱,</para>
  <para style="q1" vid="PSA 143:12">vu kototo aza a na a 'yuwan numu,</para>
  <para style="q2" vid="PSA 143:12">adama a na a̱mu aagbashi a̱ wu a ɗa.<verse eid="PSA 143:12" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" sid="PSA 144" />
  <para style="s">Avasa e izami yi iwawi nu utsuru</para>
  <para style="d">Ica ya̱ Da̱wuda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1" />Aba'un za va̱ a̱ A̱sulazuva ɗa,</para>
  <para style="q2" vid="PSA 144:1">aatali o upa'atan u va̱,</para>
  <para style="q1" vid="PSA 144:1">za na ritoi ekere a̱ va̱, a yuwan uvon,</para>
  <para style="q2" vid="PSA 144:1">akatsu a̱ va̱ waru adama a̱ nla̱ngi.<verse eid="PSA 144:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2" />Za na a̱yi ɗa icigi i va̱</para>
  <para style="q2" vid="PSA 144:2">na̱ uɓaɓu wu ucira u va̱,</para>
  <para style="q2" vid="PSA 144:2">upa'atan u va̱ ni iwawi i va̱,</para>
  <para style="q1" vid="PSA 144:2">a̱a̱ra̱ga̱ a̱ va̱ uba̱ta̱ u na n tsu pa'an,</para>
  <para style="q2" vid="PSA 144:2">za na tsu zuwa nɗa za̱la̱ va̱.<verse eid="PSA 144:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3" />A̱sulazuva, nye i ɗa vaɗilima̱ ri</para>
  <para style="q2" vid="PSA 144:3">hali na vu ri aɗa a̱ yi?<note caller="-" style="x"><char style="xo" closed="false">144:3 </char><char style="xt" closed="false"><ref loc="JOB 7:17-18">Ayb 7:17-18</ref>; <ref loc="PSA 8:4">Ica 8:4</ref>.</char></note></para>
  <para style="q1" vid="PSA 144:3">Ko nye i ɗa mawun ma vuma hali na vu ri</para>
  <para style="q2" vid="PSA 144:3">a majiyan ma̱ yi?<verse eid="PSA 144:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4" />Vaɗilima̱ tsa̱ wivuwun tsa ɗa,</para>
  <para style="q2" vid="PSA 144:4">rana va̱ yi tsu ululu u na wa̱a̱ ka̱ra̱sa̱ ɗa.<verse eid="PSA 144:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5" />A̱sulazuva, kpa̱tu'wa̱ zuva va wu,</para>
  <para style="q2" vid="PSA 144:5">a̱vu vu cipa̱,</para>
  <para style="q1" vid="PSA 144:5">ju'wa̱n nsasan,</para>
  <para style="q2" vid="PSA 144:5">adama o uta̱a̱ mikyon.<verse eid="PSA 144:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6" />Zuwa imaɗatsu yi ikana u bete'we n'yuwatan,</para>
  <para style="q2" vid="PSA 144:6">tewin aya a̱ wu vu zuwa e bete'we ni ilaɗi.<verse eid="PSA 144:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7" />Vu canana ukere wa̱ wu diga zuva,</para>
  <para style="q2" vid="PSA 144:7">vu papa mu waru vu wawa mu,</para>
  <para style="q1" vid="PSA 144:7">diga a̱ mini ma gbain,</para>
  <para style="q2" vid="PSA 144:7">ne e ekere o omocin,<verse eid="PSA 144:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8" />aza a na na̱ le ri tapu na̱ e epen,</para>
  <para style="q2" vid="PSA 144:8">a yuwusan akucunu e epen.<verse eid="PSA 144:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9" />A̱sula̱, n ta canaa wu ishipa i sa'avu,</para>
  <para style="q2" vid="PSA 144:9">na̱ kumburu va a'yin kupa,</para>
  <para style="q2" vid="PSA 144:9">n ta canaa wu ishipa yi ica.<verse eid="PSA 144:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10" />A̱vu za na tsu ca ngono ulyuwu wa aci,</para>
  <para style="q2" vid="PSA 144:10">za na wawai aagbashi a̱ yi Da̱wuda,</para>
  <para style="q2" vid="PSA 144:10">diga a matsun me pe'eni mo ukwisa̱.<verse eid="PSA 144:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11" />Papa mu a̱vu vu wawa mu,</para>
  <para style="q2" vid="PSA 144:11">diga e ekere o omocin,</para>
  <para style="q1" vid="PSA 144:11">aza a na na̱ le ri tapu na̱ epen,</para>
  <para style="q2" vid="PSA 144:11">aza a na a yuwusan akucunu epen.<verse eid="PSA 144:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12" />Lyawa olobo a̱ tsu a̱tsuma̱ o tsulolobo tse le,</para>
  <para style="q2" vid="PSA 144:12">o o'wo tsa ɗanga na kungwai nu ucira,</para>
  <para style="q1" vid="PSA 144:12">lyawa esheli a̱ tsu,</para>
  <para style="q2" vid="PSA 144:12">o o'wo tsa atsura,</para>
  <para style="q1" vid="PSA 144:12">a na e she'ein adama o lobonoto,</para>
  <para style="q2" vid="PSA 144:12">ukobu u mogono.<verse eid="PSA 144:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13" />Lyawa mpon n tsu n shiwan,</para>
  <para style="q2" vid="PSA 144:13">na̱ cu'un vi itana yu uɗuma̱ suru.</para>
  <para style="q1" vid="PSA 144:13">Ikyon i tsu waru a̱ da̱shi a̱bunda̱,</para>
  <para style="q2" vid="PSA 144:13">nu ukpakukupa,</para>
  <para style="q2" vid="PSA 144:13">nu ukpakukupa kupa a̱tsuma̱ a atsusa a̱ tsu.<verse eid="PSA 144:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 144:14" />Lyawa inan i tsu i yuwan a̱bunda̱ lon,</para>
  <para style="q2" vid="PSA 144:14">she a̱a̱tsuma̱ o uta̱ le ko a̱ puwa̱n wan.</para>
  <para style="q1" vid="PSA 144:14">She a uwwa mesun mo a̱tsumola̱ngu,</para>
  <para style="q2" vid="PSA 144:14">a̱tsuma̱ e re tsu wan.<verse eid="PSA 144:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15" />A̱za̱ a̱ ma̱za̱nga̱ a ɗa,</para>
  <para style="q2" vid="PSA 144:15">aza a na a̱ ri na̱ cu'un vu nden ndolo'o.</para>
  <para style="q1" vid="PSA 144:15">A̱za̱ a̱ ma̱za̱nga̱ ɗa</para>
  <para style="q2" vid="PSA 144:15">aza a na A̱sulazuva a ɗa A̱sula̱ e le.<verse eid="PSA 144:15" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" sid="PSA 145" />
  <para style="s">Tsugbain za va A̱sulazuva ɗa</para>
  <para style="d">Ica ya̱ Da̱wuda.</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1" />N ta cuwa wu, A̱sula̱ a̱ va̱ Mogono ma̱ va̱,</para>
  <para style="q2" vid="PSA 145:1">n ta ca ala a̱ wu tsugbain hali hali hali.<verse eid="PSA 145:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2" />N ta cuwa wu urana suru,</para>
  <para style="q2" vid="PSA 145:2">n ta ca ala a̱ wu tsugbain hali hali hali.<verse eid="PSA 145:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3" />A̱sulazuva Zagbain ɗa, za na rawai a cuwa yi lon!</para>
  <para style="q2" vid="PSA 145:3">Tsugbain tsa̱ yi za gura cuɗuwa yi shi!<verse eid="PSA 145:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4" />A ta cuwa linga va̱ wu</para>
  <para style="q2" vid="PSA 145:4">diga a mantsa a̱ tyo mantsa mo ro,</para>
  <para style="q2" vid="PSA 145:4">a ta cuɗuwa linga gbagbain va̱ wu.<verse eid="PSA 145:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5" />A ta yuwan adanshi</para>
  <para style="q2" vid="PSA 145:5">o ucira u tsugbain tsa̱ wu,</para>
  <para style="q1" vid="PSA 145:5">a̱mu waru n ta yuwan majiyan</para>
  <para style="q2" vid="PSA 145:5">ma linga va asalama a̱ wu.<verse eid="PSA 145:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6" />Ama a ta yuwan adanshi,</para>
  <para style="q2" vid="PSA 145:6">adama a linga gbagbain wovon va̱ wu,</para>
  <para style="q1" vid="PSA 145:6">reve a̱mu n damma a̱bunda̱,</para>
  <para style="q2" vid="PSA 145:6">a̱ tsugbain tsa̱ wu.<verse eid="PSA 145:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7" />O to ɓosho na adanshi a̱ ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 145:7">a̱bunda̱ e isa'ani ya̱ wu,</para>
  <para style="q1" vid="PSA 145:7">reve a cana ishipa i ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 145:7">adama a̱ɓula̱ a̱ wu.<verse eid="PSA 145:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8" />A̱sulazuva za vi isa'ani ɗa,</para>
  <para style="q2" vid="PSA 145:8">ni iliyali,</para>
  <para style="q1" vid="PSA 145:8">za na tsu yuwan upan go'o shi,</para>
  <para style="q2" vid="PSA 145:8">tapu ɗa u ri ni icigi i na i tsu vadala shi.<note caller="-" style="x"><char style="xo" closed="false">145:8 </char><char style="xt" closed="false"><ref loc="EXO 34:6">Mta̱ 34:6</ref>; <ref loc="PSA 103:8">Ica 103:8</ref>.</char></note><verse eid="PSA 145:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9" />A̱sulazuva za vi isa'ani ɗa</para>
  <para style="q2" vid="PSA 145:9">a̱ tyo e ekere a vuma suru,</para>
  <para style="q1" vid="PSA 145:9">waru u to rocosu</para>
  <para style="q2" vid="PSA 145:9">ili i na u yuwain suru iliyali.<verse eid="PSA 145:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10" />A̱sulazuva, ili i na vu yuwain suru</para>
  <para style="q2" vid="PSA 145:10">a̱ ta̱ godyowo wu,</para>
  <para style="q1" vid="PSA 145:10">a̱za̱ a̱ɓula̱ a̱ wu suru</para>
  <para style="q2" vid="PSA 145:10">a ta cuwa wu.<verse eid="PSA 145:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11" />A ta yuwan adanshi</para>
  <para style="q2" vid="PSA 145:11">a tsugbain tso tsugono tsa̱ wu,</para>
  <para style="q2" vid="PSA 145:11">a̱vu a yuwan adanshi o ucira wa̱ wu.<verse eid="PSA 145:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12" />Adama vaɗilima̱ suru reve,</para>
  <para style="q2" vid="PSA 145:12">na̱ linga gbagbain va̱ wu,</para>
  <para style="q2" vid="PSA 145:12">na̱ tsugbain tso tsugono tsa̱ wu.<verse eid="PSA 145:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13" />Tsugono tsa̱ wu, tsugono tsa hali hali ɗa,</para>
  <para style="q2" vid="PSA 145:13">waru tsugbain tsa̱ wu,</para>
  <para style="q2" vid="PSA 145:13">diga mantsa a̱ tyo mantsa mo ro ɗa.</para>
  <para style="q1" vid="PSA 145:13">A̱sulazuva za va̱ a̱ɓula̱ a ɗa</para>
  <para style="q2" vid="PSA 145:13">a̱tsuma̱ a nzuwulai ma̱ yi suru,</para>
  <para style="q2" vid="PSA 145:13">za vi icigi waru e ekere e ili i na u yuwain biti.<verse eid="PSA 145:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14" />A̱sulazuva a̱ tsu kamba ta̱,</para>
  <para style="q2" vid="PSA 145:14">aza a na a̱ riya̱i suru,</para>
  <para style="q1" vid="PSA 145:14">reve u 'ya̱sa̱n,</para>
  <para style="q2" vid="PSA 145:14">aza a na suru a̱ ka̱ɗa̱toi.<verse eid="PSA 145:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15" />Ama suru a zuwa ta̱ okolo e le uba̱ta̱ wa̱ wu,</para>
  <para style="q2" vid="PSA 145:15">vu tsu ca le ta̱ ilyalya,</para>
  <para style="q2" vid="PSA 145:15">a mantsa ma na wuntsayi.<verse eid="PSA 145:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16" />Vu tsu ca ta̱ na̱ okolo a̱ ta̱,</para>
  <para style="q2" vid="PSA 145:16">a̱vu vu cuwa̱ton ili i na i ri wuma suru,</para>
  <para style="q2" vid="PSA 145:16">o una̱ wi ili i na a cigai.<verse eid="PSA 145:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17" />A̱sulazuva za va̱ a̱ɓula̱ ɗa,</para>
  <para style="q2" vid="PSA 145:17">a̱tsuma̱ e re va̱ yi suru,</para>
  <para style="q1" vid="PSA 145:17">za vi isa'ani ɗa,</para>
  <para style="q2" vid="PSA 145:17">a̱tsuma̱ a linga va̱ yi suru.<verse eid="PSA 145:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18" />A̱sulazuva a̱ ta̱ zuzu,</para>
  <para style="q2" vid="PSA 145:18">na aza a na ee ɗesu ya̱'a̱ yi,</para>
  <para style="q2" vid="PSA 145:18">na aza a na ee ɗesu yi a̱tsuma̱ a amayun.<verse eid="PSA 145:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19" />U tsu shitowon ta̱ aza a na aa uwwusa wovon wa̱ yi</para>
  <para style="q2" vid="PSA 145:19">ni ili i na a cigai,</para>
  <para style="q1" vid="PSA 145:19">waru u tsu uwwa ta̱ mesun me le,</para>
  <para style="q2" vid="PSA 145:19">reve u wawa le.<verse eid="PSA 145:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20" />A̱sulazuva aa tsu yuwaan ta̱</para>
  <para style="q2" vid="PSA 145:20">aza a na a ciga niyi suru mapari,</para>
  <para style="q2" vid="PSA 145:20">amma u to kototo a̱za̱ e iwuya suru.<verse eid="PSA 145:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21" />Una̱ u va̱ u ta yuwan</para>
  <para style="q2" vid="PSA 145:21">adanshi e ica ya̱ A̱sulazuva,</para>
  <para style="q1" vid="PSA 145:21">aza a wuma suru a ta cuwa</para>
  <para style="q2" vid="PSA 145:21">ala a Akiza a̱ yi hali hali hali.<verse eid="PSA 145:21" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" sid="PSA 146" />
  <para style="s">Ica ya̱ A̱sula̱ za vi iwawi</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1" />Cuwa A̱sulazuva!</para>
  <para style="b" vid="PSA 146:1" />
  <para style="q2" vid="PSA 146:1">Cuwa A̱sulazuva, wuma u va̱!<verse eid="PSA 146:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2" />N ta cuwa a̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 146:2">a wuma u va̱ suru.</para>
  <para style="q1" vid="PSA 146:2">N ta canaa A̱sula̱ a̱ va̱ ica,</para>
  <para style="q2" vid="PSA 146:2">a wuma u va̱ suru.<verse eid="PSA 146:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3" />She vuma zuwaa azagbain ucira wan,</para>
  <para style="q2" vid="PSA 146:3">ko vaɗilima̱ za na aa gura wawa shi.<verse eid="PSA 146:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4" />A mantsa ma na wivuwun u le u ka̱ra̱i,</para>
  <para style="q2" vid="PSA 146:4">a̱ tsu ka̱mba̱ ta̱ ma̱bula̱ uba̱ta̱ u na o uta̱i,</para>
  <para style="q1" vid="PSA 146:4">o urana u ndolo ifoɓi i le,</para>
  <para style="q2" vid="PSA 146:4">i tso o'wo ta̱ pere.<verse eid="PSA 146:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5" />Za ma̱za̱nga̱ ɗa,</para>
  <para style="q2" vid="PSA 146:5">za na A̱sula̱ a Yakubu a ɗa,</para>
  <para style="q2" vid="PSA 146:5">ikambishi ya̱ yi,</para>
  <para style="q1" vid="PSA 146:5">Za ma̱za̱nga̱ ɗa,</para>
  <para style="q2" vid="PSA 146:5">za na uzuwu wo okolo a̱ yi</para>
  <para style="q2" vid="PSA 146:5">A̱sulazuva A̱sula̱ a ɗa,<verse eid="PSA 146:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6" />za na yuwain zuva nu uvaɗi,<note caller="-" style="x"><char style="xo" closed="false">146:6 </char><char style="xt" closed="false"><ref loc="ACT 4:24">Ajy 4:24</ref>; <ref loc="ACT 14:15">14:15</ref>.</char></note></para>
  <para style="q2" vid="PSA 146:6">na̱ mala ni ili i na i ri pe suru,</para>
  <para style="q2" vid="PSA 146:6">za na tsu yuwusan amayun hali hali,<verse eid="PSA 146:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7" />za na tsu yuwan uge'etosu,</para>
  <para style="q2" vid="PSA 146:7">adama aza a na oo ɓongiyi,</para>
  <para style="q2" vid="PSA 146:7">za na tsu ca aza ambulu ilyalya.</para>
  <para style="b" vid="PSA 146:7" />
  <para style="q1" vid="PSA 146:7">A̱sulazuva a tsu wawa ta̱</para>
  <para style="q2" vid="PSA 146:7">aza a na a̱ ri o u'wa wa ali fa̱a̱n.<verse eid="PSA 146:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 146:8" />A̱sulazuva a tsu zuwa ta̱</para>
  <para style="q2" vid="PSA 146:8">nrumba̱ me ene.</para>
  <para style="q1" vid="PSA 146:8">A̱sulazuva a̱a̱ tsu 'ya̱sa̱n ta̱,</para>
  <para style="q2" vid="PSA 146:8">aza a na o ɓongiyi,</para>
  <para style="q1" vid="PSA 146:8">A̱sulazuva a ciga ta̱</para>
  <para style="q2" vid="PSA 146:8">a̱za̱ a̱ a̱ɓula̱.<verse eid="PSA 146:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9" />A̱sulazuva a̱ ta̱ ka̱lyuwusa̱ omocin,</para>
  <para style="q2" vid="PSA 146:9">u tsu kamba ta̱ mkpa'an na̱ nruna̱,</para>
  <para style="q1" vid="PSA 146:9">agba u tsu lungusa̱ ta̱</para>
  <para style="q2" vid="PSA 146:9">ifoɓi ya̱ a̱za̱ e iwuya.<verse eid="PSA 146:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10" />A̱sulazuva a ta yuwan</para>
  <para style="q2" vid="PSA 146:10">tsugono hali hali,</para>
  <para style="q1" vid="PSA 146:10">a̱vu Sihiyona, A̱sula̱ a̱ wu</para>
  <para style="q2" vid="PSA 146:10">a ta yuwan tsugono</para>
  <para style="q2" vid="PSA 146:10">diga a mantsa a̱ tyo mantsa mo ro.</para>
  <para style="b" vid="PSA 146:10" />
  <para style="q1" vid="PSA 146:10">Cuwai A̱sulazuva!<verse eid="PSA 146:10" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" sid="PSA 147" />
  <para style="s">Ishipa yi Ica uba̱ta̱ wa̱ A̱sula̱ za vi ili biti</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1" />Cuwai A̱sulazuva!</para>
  <para style="b" vid="PSA 147:1" />
  <para style="q1" vid="PSA 147:1">Amayun, ili i sa'ani i ɗa,</para>
  <para style="q2" vid="PSA 147:1">a canaa A̱sula̱ a̱ tsu ishipa yi ica.</para>
  <para style="q1" vid="PSA 147:1">Amayun, ili yu ulobonu i ɗa,</para>
  <para style="q2" vid="PSA 147:1">waru wu ntsaa ta̱ a cuwa yi!<verse eid="PSA 147:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2" />A̱sulazuva a̱ ta̱ da̱shi suwusa Urishelima,</para>
  <para style="q2" vid="PSA 147:2">u to ɓolotosu aza a Isra'ila</para>
  <para style="q2" vid="PSA 147:2">a na a̱ 'ya̱wa̱i tsugbashi.<verse eid="PSA 147:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3" />U tsu ka̱mba̱to ta̱</para>
  <para style="q2" vid="PSA 147:3">aza a na okolo e le a kuɗai gbaga,</para>
  <para style="q2" vid="PSA 147:3">reve wu nla̱ antsu e le.<verse eid="PSA 147:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4" />U tsu kece ta̱ a̱bunda̱ e italyo'o,</para>
  <para style="q2" vid="PSA 147:4">a̱vu u ɗe koyan suru na aala a̱ yi.<verse eid="PSA 147:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5" />A̱sulazuva a̱ tsu zagbain ɗa,</para>
  <para style="q2" vid="PSA 147:5">waru u ta̱ nu ucira lon,</para>
  <para style="q2" vid="PSA 147:5">urevu wa̱ yi u ri na̱ a̱ tyo shi.<verse eid="PSA 147:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6" />A̱sulazuva a̱ tsu 'ya̱sa̱n ta̱ aza a na</para>
  <para style="q2" vid="PSA 147:6">a tarai aciyele ili i ro shi,</para>
  <para style="q2" vid="PSA 147:6">amma u tso oco ta̱ a̱za̱ e iwuya e iɗa.<verse eid="PSA 147:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7" />Canaa yi A̱sulazuva ishipa yu ugodyusho,</para>
  <para style="q2" vid="PSA 147:7">canaa yi A̱sula̱ a̱ tsu</para>
  <para style="q2" vid="PSA 147:7">ishipa yi ica na̱ kumburu.<verse eid="PSA 147:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8" />U tsu ɓa̱ru ta̱ zuva ne eleshe,</para>
  <para style="q2" vid="PSA 147:8">u tsu ca ta̱ uvaɗi iro'i,</para>
  <para style="q1" vid="PSA 147:8">reve u zuwa anlya,</para>
  <para style="q2" vid="PSA 147:8">a kungwa a agaɗi.<verse eid="PSA 147:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9" />U tsu ca ta̱ inama ilyalya i le,</para>
  <para style="q2" vid="PSA 147:9">na̱ muwun ma akakan waru,</para>
  <para style="q2" vid="PSA 147:9">a mantsa ma na a̱ ri a yisali.<verse eid="PSA 147:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10" />U zuwa ucira wa̱ yi o ucira wu do shi,</para>
  <para style="q2" vid="PSA 147:10">ko u zuwa ucira wa̱ yi uba̱ta̱ u vuma shi.<verse eid="PSA 147:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11" />A̱sulazuva a tsu uwwa ta̱ uyo'o</para>
  <para style="q2" vid="PSA 147:11">wa aza a na a uwwusa wovon wa̱ yi,</para>
  <para style="q1" vid="PSA 147:11">aza a na a zuwusa ucira u le,</para>
  <para style="q2" vid="PSA 147:11">uba̱ta̱ wi icigi ya̱ yi i na i tsu vadala shi.<verse eid="PSA 147:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12" />Vu ca A̱sulazuva tsugbain, a̱vu Urishelima!</para>
  <para style="q2" vid="PSA 147:12">Vu cuwa A̱sula̱ a̱ wu a̱vu Sihiyona!<verse eid="PSA 147:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13" />Adama a na u zuwa ta̱,</para>
  <para style="q2" vid="PSA 147:13">irumu yu una̱ntsu va̱ wu a̱ da̱na̱ nu ucira,</para>
  <para style="q2" vid="PSA 147:13">u tsu zuwaa ta̱ ama a̱ wu aba'un.<verse eid="PSA 147:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14" />U tsu ta̱wa̱a̱ ta̱ na̱ asuvu nden o utyo wi iɗa ya̱ wu,</para>
  <para style="q2" vid="PSA 147:14">a̱vu u cuwa̱ton wu no oroci a yitabo i sa'ani.<verse eid="PSA 147:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15" />U tsu lyungu ta̱ nu udammu wa̱ yi o uvaɗi,</para>
  <para style="q2" vid="PSA 147:15">babu usa̱n adanshi a̱ yi a tsu rawa o uvaɗi.<verse eid="PSA 147:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16" />U tsu lyungu ta̱ na̱ atayan tsi iro'i</para>
  <para style="q2" vid="PSA 147:16">cine vu revei tsikilu,</para>
  <para style="q2" vid="PSA 147:16">reve u baza a'iza tso okomo.<verse eid="PSA 147:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17" />U tso oco ta̱ atayan a̱ yi,</para>
  <para style="q2" vid="PSA 147:17">tsa atali e keke'en.</para>
  <para style="q2" vid="PSA 147:17">Zane ɗa aa gura kaɓa asuvu nu uta̱nu wa̱ yi?<verse eid="PSA 147:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18" />U tsu lyungu ta̱ na adanshi a̱ yi,</para>
  <para style="q2" vid="PSA 147:18">reve wu jeruweto le,</para>
  <para style="q1" vid="PSA 147:18">u tsu zuwa ta̱ upepu wa̱ yi wi ivula̱,</para>
  <para style="q2" vid="PSA 147:18">a̱vu mini ma suma.<verse eid="PSA 147:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19" />U ca ta̱ Yakubu ikaka ya̱ yi,</para>
  <para style="q2" vid="PSA 147:19">ili i na u zuwai na̱ wila̱ wa̱ yi</para>
  <para style="q2" vid="PSA 147:19">a̱ tyo ya Isra'ila.<verse eid="PSA 147:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20" />U yuwaan iɗa i ro tsunda shi,</para>
  <para style="q2" vid="PSA 147:20">waru e reve wila̱ wa̱ yi shi.</para>
  <para style="b" vid="PSA 147:20" />
  <para style="q1" vid="PSA 147:20">Cuwai A̱sulazuva!<verse eid="PSA 147:20" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" sid="PSA 148" />
  <para style="s">Ishipa yi Ica yi ili i wuma suru</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1" />Cuwai A̱sulazuva!</para>
  <para style="b" vid="PSA 148:1" />
  <para style="q1" vid="PSA 148:1">Cuwai A̱sulazuva diga zuva,</para>
  <para style="q2" vid="PSA 148:1">a cuwa yi diga ɗe zuva va alanga.<verse eid="PSA 148:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2" />Cuwa niyi, a̱ɗu nlingata ma̱ yi suru!</para>
  <para style="q2" vid="PSA 148:2">Cuwa niyi a̱ɗu oɓolo a̱ a̱soja a zuva a̱ yi suru!<verse eid="PSA 148:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3" />Cuwa niyi, a̱ɗu urana na̱ woto,</para>
  <para style="q2" vid="PSA 148:3">cuwa niyi, a̱ɗu italyo'o i na ye ikanasa suru!<verse eid="PSA 148:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4" />Cuwa niyi, a̱ɗu zuva va zuva suru suru,</para>
  <para style="q2" vid="PSA 148:4">na̱ a̱ɗu mini ma na ma̱ ri zuva va zuva!<verse eid="PSA 148:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5" />Lyawa le a cuwa ala A̱sulazuva,</para>
  <para style="q2" vid="PSA 148:5">adama a na u ca ta̱ udammu,</para>
  <para style="q2" vid="PSA 148:5">reve gba o o'wo.<verse eid="PSA 148:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6" />U shuwa̱ le ta̱ hali hali hali,</para>
  <para style="q2" vid="PSA 148:6">u zuwaa le ta̱ wila̱,</para>
  <para style="q2" vid="PSA 148:6">u na n ri koto shi.<verse eid="PSA 148:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7" />Cuwayi A̱sulazuva diga pa o uvaɗi,</para>
  <para style="q2" vid="PSA 148:7">a̱ɗu inama i mini i gbagbain</para>
  <para style="q2" vid="PSA 148:7">na̱ a̱za̱ a̱ru'un a mala suru.<verse eid="PSA 148:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8" />Imaɗatsu na atayan,</para>
  <para style="q2" vid="PSA 148:8">iro'i na atayan a̱ uri,</para>
  <para style="q1" vid="PSA 148:8">wunla̱ wu upepu u na</para>
  <para style="q2" vid="PSA 148:8">u tsu uwwa adanshi a̱ yi,<verse eid="PSA 148:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9" />a̱ɗu nsasan na agaɗi suru,</para>
  <para style="q2" vid="PSA 148:9">ɗanga na tsu matsan,</para>
  <para style="q2" vid="PSA 148:9">na̱ ɗanga sida suru!<verse eid="PSA 148:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10" />A̱ɗu inama yu una</para>
  <para style="q2" vid="PSA 148:10">ni iliyamunga suru,</para>
  <para style="q2" vid="PSA 148:10">ni ili yi ika̱ta̱pu na̱ nnunu n tsu'yan!<verse eid="PSA 148:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11" />Ngono mu uvaɗi na̱ nɗa suru,</para>
  <para style="q2" vid="PSA 148:11">a̱za̱ o tsugono na aza a tsugbain tsu uvaɗi suru!<verse eid="PSA 148:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12" />Olobo ne esheli,</para>
  <para style="q2" vid="PSA 148:12">mbara na̱ muwun!<verse eid="PSA 148:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13" />Lyawa le a cuwa ala a̱ A̱sulazuva,</para>
  <para style="q2" vid="PSA 148:13">adama a na ala a̱ yi a ɗa goon a la'ai tsugbain.</para>
  <para style="q2" vid="PSA 148:13">Waru a̱ɓula̱ a̱ yi a pala ta̱ uvaɗi na̱ zuva.<verse eid="PSA 148:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14" />U 'ya̱sa̱n ta̱ mogono mo ucira adama a ama a̱ yi,</para>
  <para style="q2" vid="PSA 148:14">adama a̱za̱ a̱ɓula̱ a̱ yi suru a cuwa yi,</para>
  <para style="q2" vid="PSA 148:14">ama a Isra'ila aza a na a̱ ri zuzu na̱ a̱yi.</para>
  <para style="b" vid="PSA 148:14" />
  <para style="q1" vid="PSA 148:14">Cuwayi A̱sulazuva!<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" sid="PSA 149" />
  <para style="s">Lyawa aza a Isra'ila a Cuwa A̱sulazuva</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1" />Cuwai A̱sulazuva!</para>
  <para style="b" vid="PSA 149:1" />
  <para style="q1" vid="PSA 149:1">Canaa yi A̱sulazuva ishipa i sa'avu,</para>
  <para style="q2" vid="PSA 149:1">i canaa yi ica a̱tsuma̱ e iɓolo ya ama a̱ɓula̱ a̱ yi.<verse eid="PSA 149:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2" />Lyawa Isra'ila yuwan ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 149:2">adama a za na Yuwan niyi,</para>
  <para style="q1" vid="PSA 149:2">yuwain ma̱za̱nga̱ a̱ɗu muwun ma Sihiyona,</para>
  <para style="q2" vid="PSA 149:2">adama o Mogono ma̱ ɗu!<verse eid="PSA 149:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3" />Lyawa a cuwa ala a̱ yi nu uje'en,</para>
  <para style="q2" vid="PSA 149:3">a lapaa yi ili tsuwe'e,</para>
  <para style="q2" vid="PSA 149:3">maganga na̱ kumburu.<verse eid="PSA 149:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4" />Adama a na A̱sulazuva</para>
  <para style="q2" vid="PSA 149:4">a ta uwwusa uyo'o wa ama a̱ yi,</para>
  <para style="q1" vid="PSA 149:4">u tsu ca ta̱ aza a na a tarai</para>
  <para style="q2" vid="PSA 149:4">aciyele ili i ro shi ulyuwu wa aci.<verse eid="PSA 149:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5" />Lyawa a̱za̱ a̱ a̱ɓula̱ a yuwan ma̱za̱nga̱,</para>
  <para style="q2" vid="PSA 149:5">adama a tsugbain tsa a na u ca nle,</para>
  <para style="q2" vid="PSA 149:5">a ta cana ishipa i ma̱za̱nga̱ zuva va̱ a̱ga̱da̱ e le.<verse eid="PSA 149:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6" />Lyawa ica yu ucira ya̱ A̱sula̱ i da̱na̱ a̱ na̱ le,</para>
  <para style="q2" vid="PSA 149:6">na̱ matsun me pe'eni ma̱ na̱ re e ekere e le,<verse eid="PSA 149:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7" />adama a̱ tsura̱ ulyuwu wa aci e ekere a nɗa,</para>
  <para style="q2" vid="PSA 149:7">reve a ca oforo e ekere a ama.<verse eid="PSA 149:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8" />A̱ nla̱ ngono n le na akani,</para>
  <para style="q2" vid="PSA 149:8">azagbain e le waru na̱ akani e irumu,<verse eid="PSA 149:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9" />a yuwaan le uge'etosu,</para>
  <para style="q2" vid="PSA 149:9">cine u ri uɗanu.</para>
  <para style="q1" vid="PSA 149:9">A̱yi nda a̱ yi ɗa tsugbain,</para>
  <para style="q2" vid="PSA 149:9">tsa ama a̱ a̱ɓula̱ a̱ yi suru.</para>
  <para style="b" vid="PSA 149:9" />
  <para style="q1" vid="PSA 149:9">Cuwai A̱sulazuva.<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" sid="PSA 150" />
  <para style="s">Cuwai A̱sulazuva a Gbain</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1" />Cuwai A̱sulazuva!</para>
  <para style="b" vid="PSA 150:1" />
  <para style="q1" vid="PSA 150:1">Cuwai A̱sula̱ a̱tsuma̱ a̱ A̱a̱'isa̱ a̱ yi,</para>
  <para style="q2" vid="PSA 150:1">cuwa niyi ɗe zuva, vu ucira va̱ yi.<verse eid="PSA 150:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2" />A cuwa yi adama a linga gbagbain va̱ yi,</para>
  <para style="q2" vid="PSA 150:2">cuwa niyi adama mgbain n tsugbain tsa̱ yi!<verse eid="PSA 150:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3" />A cuwa yi na̱ wivulu wa abulu,</para>
  <para style="q2" vid="PSA 150:3">a cuwa yi ni igaraya na̱ kumburu!<verse eid="PSA 150:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4" />A cuwa yi na̱ maganga nu uje'en,</para>
  <para style="q2" vid="PSA 150:4">cuwa niyi ni ili tsuwe'e,</para>
  <para style="q2" vid="PSA 150:4">na abulu!<verse eid="PSA 150:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5" />A cuwa yi na̱ mupalu m malapa,</para>
  <para style="q2" vid="PSA 150:5">a cuwa yi na̱ mupalu m malapa a̱za̱ mesun ma̱ a̱bunda̱!<verse eid="PSA 150:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6" />Lyawa ili i na i ri e ivuwusan suru,</para>
  <para style="q2" vid="PSA 150:6">u cuwa A̱sulazuva!</para>
  <para style="b" vid="PSA 150:6" />
  <para style="q1" vid="PSA 150:6">Cuwai A̱sulazuva!<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
</usx>