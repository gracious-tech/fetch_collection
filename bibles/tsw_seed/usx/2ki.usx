<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2KI" style="id">- Tsishingini (tsw)</book>
  <para style="h">2 NGONO</para>
  <para style="toc3">2 Ngo</para>
  <para style="toc2">2 Ngono</para>
  <para style="toc3">2 Ngono</para>
  <para style="toc1">2 Ngono</para>
  <para style="mt2">2 Ngono</para>
  <para style="mt1">2 Ngono</para>
  <para style="is">Ucuɗuwu wa aatagada a nda</para>
  <para style="ipi">A̱ yi aatagada a̱ ire o Ngono n nda, u lyuwa ta̱ elime a casu a labari o tsugono tsa Isra'ila na̱ Yahuda, diga uba̱ta̱ u na aatagada o ufaru wu Ngono mi isawain. A ta gura ne'eshe aatagada a nda tsun nda:</para>
  <para style="imi">1 A̱ yi upasu wu ufaru u nda u ca ta̱ alabari o tsugono tsa Isra'ila na̱ za va a Yahuda diga a̱tsuma̱ aa'wan ukpakukupa kunla̱ na̱ kupoton (850) kafu limatan va̱ Yesu a̱ tyo ma̱riya̱ ma Samariya, za na a̱ yi ɗa ukosu u tsugono tsa a Isra'ila vu upasu wu ugana, a̱tsuma̱ aa'wan ukpakukupa ucindere na̱ ushin ne ejere kafu a matsan Yesu.</para>
  <para style="imi">2 A̱ yi upasu u nda u ca ta̱ alabari o tsugono tsa a Yahuda diga ma̱riya̱a̱ mo tsugono tsa a Isra'ila a̱ tyo wu ukototosu Urishelima e ekere o Mogono Nebukanaza mogono ma Babila a̱tsuma̱ aa'wan ukpakukupa o uton na̱ kupa kunla̱ na̱ a̱za̱ a̱ ta̱li 586 kafu a matsan Yesu. Reve aatagada'a u koso na alabari Gedaliya gwamna va a Yahuda za̱la̱ va a Babila, oɓolo nu ucuɗuwu adama a malyawa ma Mogono Yehoyakin va a Yahuda diga a̱tsuma̱ o u'wa wa ali a̱tsuma̱ a Babila.</para>
  <para style="ip">Wuntsa ta̱ a na e ɗenuna̱ a̱tsuma̱ aatagada o Ngono ununa a ɗana a le, e ekere alabari e iwawi. Na̱ ulambu wa̱ a̱ɓula̱ wa ama A̱sula̱ a na a ɗangulai na̱ ukototosu u tsugono tsa le, reve wo o'wo she damma u putsaa ta̱ ifoɓi i na A̱sula̱ a yuwain a adama e iwawi. Amma A̱sula̱ a buwa ta̱ ama ke'en a na, &lt;&lt; A̱ kuɗa̱i a na a̱ kingyo wo musula̱ ma Ba'al.&gt;&gt; A̱ɓula̱ a akapi a ama a na a̱ shi a buwai u roco ta̱ amayun a nzuwulai ma̱ A̱sula̱ oɓolo na ama a̱ yi a̱ tyo elime. Aatagada'a u roco ta̱ cu'un vi ili i na a ama'a a yuwain, a gura a na a putsaa ifoɓi ya̱ A̱sula̱ adama e iwawi ya ama a̱ yi a na wa̱ lyungu zamawawa.</para>
  <para style="is">Ili i na i ri pe a̱tsuma̱ a aatagada a nda</para>
  <para style="io">1 Cine une'esun u tsugono u da̱na̱i 1:1-17:41</para>
  <para style="io">Elisha vumava̱sula̱ 1:1-8:15</para>
  <para style="io">Ngono ma a Yahuda na aza a Isra'ila 8:16-17:4</para>
  <para style="io">Ma̱riya̱ ma Samariya 17:5-41</para>
  <para style="io">Tsugono tsa a Yahuda 18:1-25:30</para>
  <para style="io">Diga ya Hezekiya a̱ tyo ya Josiya 18:1-21:26</para>
  <para style="io">Tsugono tsa Josiya 22:1-23:30</para>
  <para style="io">Ngono mu ukosu ma a Yahuda 23:31-24:2</para>
  <para style="io">Ma̱riya̱ ma̱ Urishelima 25:1-30.</para>
  <para style="ib" />
  <chapter number="1" style="c" sid="2KI 1" />
  <para style="s">Iliya na̱ mogono Ahaziya</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 1:1" />Ana Ahabu kuwa̱i, a̱vu Mowa 'ya̱sa̱a̱n Isra'ila aci.<verse eid="2KI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 1:2" />Urana u ro Mogono Ahaziya ma Isra'ila ma̱ fa̱tsa̱ ta̱ diga uba̱ta̱ wu usowoto wu upepu wa aasula a zuva va̱ yi va Samariya, a̱vu wu uwwa usa̱n lon. Ɗaɗa u lyunguyi nlingata u damma le, &lt;&lt;'Ya̱wa̱i ye ece Ba'al Zebu, ma̱sula̱ ma Ekuron ma aza a Filistiya, ko n ta̱ ka̱mba̱ gbaga diga o usa̱n u nda.&gt;&gt; <verse eid="2KI 1:2" /><verse number="3" style="v" sid="2KI 1:3" />Amma a̱vu malingata ma̱ A̱sulazuva ma damma Iliya vuma va Tishibe, &lt;&lt;'Yon, vu ka̱ra̱ vu ga'an na̱ nlingata m mogono ma Samariya a̱vu ve ece le, &lt;Uwwai ne'e, babu pa A̱sula̱ a̱tsuma̱ a Isra'ila a ɗa, a na ya̱a̱ 'ya̱wusa̱ ye ece uba̱ta̱ wa̱ Ba'al Zebu ma̱sula̱ ma Ekuron?&gt; <verse eid="2KI 1:3" /><verse number="4" style="v" sid="2KI 1:4" />To, adama o ndolo apa a nda ili i na A̱sulazuva a dammai, &lt;Va̱a̱ 'yon a̱ a̱ga̱da̱ a na vu ri nven shi. Ili i ro yi lo shi vu ta̱ kuwa̱!&gt; &gt;&gt; Ɗaɗa Iliya ka̱ra̱i.<verse eid="2KI 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 1:5" />A na nlingata'a n ka̱mba̱i uba̱ta̱ u mogono, a̱vu we ece le, &lt;&lt;Adama a̱ nye i ka̱mba̱i?&gt;&gt;<verse eid="2KI 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 1:6" />A̱vu a̱ usu yi, &lt;&lt;Vuma ro ɗa tsu ga'ain na̱ a̱yi, reve u damma tsu, &lt;Ka̱mba̱i uba̱ta̱ u mogono za na lyungu nɗu a̱vu i damma yi, &lt;&lt;Apa a nda ili i na A̱sulazuva a dammai, Uwwai ne'e, babu pa A̱sula̱ a̱tsuma̱ a Isra'ila a ɗa, a na ya̱a̱ 'ya̱wusa̱ ye ece uba̱ta̱ wa̱ Ba'al Zebu ma̱sula̱ ma Ekuron? Adama o ndolo va̱a̱ 'yon a̱ a̱ga̱da̱ a na vu ri nven shi. Ili i ro yi lo shi vu ta̱ kuwa̱!&gt;&gt; &gt; &gt;&gt;<verse eid="2KI 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 1:7" />A̱vu mogono me ece le, &lt;&lt;Cine vuma na ga'ain na̱ a̱ɗu'u u ri, a̱vu u damma a̱ ɗu cu'un vi ili ya nda suru?&gt;&gt;<verse eid="2KI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 1:8" />A̱vu a̱ usu yi, &lt;&lt;Vuma ɗa na da̱na̱i wotowu nu utugu we eleme na̱ gbakala vu ukwan e ikyun ya̱ yi.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">Ka̱lyuwa̱: Mat 3:4; Mak 1:6.</char></note></para>
  <para style="p" vid="2KI 1:8">A̱vu mogono ma damma, &lt;&lt;Iliya ɗa vuma va Tishibe.&gt;&gt;<verse eid="2KI 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 1:9" />A̱vu u lyunguwa̱a̱ Iliya yali ya̱ a̱soja no oɓolo a̱ a̱soja a̱ yi kupoton a na e reme yi. Reve yali ya̱ a̱soja'a u ka̱ra̱ a gawan ya Iliya za na shi nden zuva va aagaɗi, a̱vu u damma yi, &lt;&lt;Vuma va̱ A̱sula̱, mogono ma damma vu cipa̱ a̱ ta̱wa̱!&gt;&gt; <verse eid="2KI 1:9" /><verse number="10" style="v" sid="2KI 1:10" />A̱vu Iliya usu yali ya̱ a̱soja'a, &lt;&lt;Na̱ a̱mu vuma va A̱sula̱ ɗa, lyawa akina a̱ cipa̱ diga zuva u lyuwa wu oɓolo na ama kupoton a̱ wu!&gt;&gt; Reve gba akina a̱ cipa̱ shi diga zuva a̱vu u lyuwa yali ya̱ a̱soja'a na̱ a̱soja a̱ yi.<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">Ka̱lyuwa̱: Luk 9:54.</char></note><verse eid="2KI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 1:11" />A̱vu mogono ma̱a̱ lyunguwisa̱a̱ Iliya yali ya̱ a̱soja na̱ a̱soja kupoton a̱yi. A̱vu yali ya̱ a̱soja'a u damma yi, &lt;&lt;Vuma va̱ A̱sula̱, apa nda ili i na mogono ma dammai, &lt;Vu cipa̱ gogogo!&gt; &gt;&gt; <verse eid="2KI 1:11" /><verse number="12" style="v" sid="2KI 1:12" />A̱vu Iliya damma yi, &lt;&lt;Nna̱ a̱mu vuma va A̱sula̱ ɗa, lyawa akina a̱ cipa̱ diga zuva reve u lyuwa wu oɓolo na̱ a̱soja kupoton a̱ wu!&gt;&gt; Ɗaɗa gba akina a̱ cipa̱ shi diga zuva a̱vu u lyuwa yali ya̱ a̱soja'a na̱ a̱soja a̱ yi.<verse eid="2KI 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 1:13" />A̱vu mogono ma̱ da̱shi lyunguwisa̱ yali ya̱ a̱soja va ta'atsu oɓolo na̱ a̱soja kupoton a̱ yi. Reve yali ya̱ a̱soja'a u ka̱ra̱ a gawan, a̱vu u kingyo a̱ ma̱ka̱ka̱n ma Iliya a̱vu u pati yi u damma, &lt;&lt;A̱vu vuma va̱ A̱sula̱, vu yuwan ankuri vu tara wuma u va̱ na̱ wuma wa ama kupoton a nda agbashi a̱ wu ili ya̱ a̱ɓula̱. <verse eid="2KI 1:13" /><verse number="14" style="v" sid="2KI 1:14" />Agba a̱yi ɗa nda akina o uta̱i ɗe diga zuva reve u lyuwa nan yali ya̱ a̱soja e re e elime oɓolo na̱ a̱soja e le suru. Amma gogo vu tara wuma u va̱ ili ya̱ a̱ɓula̱!&gt;&gt; <verse eid="2KI 1:14" /><verse number="15" style="v" sid="2KI 1:15" />A̱vu malingata ma̱ A̱sulazuva ma damma Iliya, &lt;&lt;She vu uwwa wovon wan. Cipa̱ vu ka̱ra̱ oɓolo na̱ a̱yi.&gt;&gt; Ɗaɗa Iliya 'yoyin a̱vu ka̱ra̱ oɓolo na̱ a̱yi a̱ tyo uba̱ta̱ u mogono. <verse eid="2KI 1:15" /><verse number="16" style="v" sid="2KI 1:16" />A̱vu Iliya damma mogono, &lt;&lt;Apa nda ili i na A̱sulazuva a dammai, &lt;Ana o o'woi vu lyunguyi nlingata a yuwan wu yeci uba̱ta̱ wa Ba'al Zebu ma̱sula̱ ma Ekuron, she damma babu A̱sula̱ a̱tsuma̱ a Isra'ila za na vaa zami urevu uba̱ta̱ wa̱ yi? O una̱ u na vu yuwain tsunda, va̱a̱ 'yon a̱ a̱ga̱da̱ a na vu ri nven shi ko ke'en. Vu ta̱ gba a̱ kuwa̱.&gt; &gt;&gt;<verse eid="2KI 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 1:17" />Reve gba Ahaziya kuwa̱ cine adanshi a̱ A̱sulazuva a dammai o una̱ wa Iliya. Ana wo o'woi Ahaziya da̱na̱ nu ulobo shi, reve Jehoram mawun ma̱ a̱na̱wun ma̱ yi ma lyuwa tsugono o una̱ wa̱ yi, a̱tsuma̱ a aa'wan e ire a Yowash ulobo wa Jehoshafa mogono ma Yahuda. <verse eid="2KI 1:17" /><verse number="18" style="v" sid="2KI 1:18" />Akapi a linga tsugbain tsa na Ahaziya yuwain suru a ɗana le ta̱ a̱tsuma̱ a aatagada a labari o ngono ma aza a Isra'ila.<verse eid="2KI 1:18" /></para>
  <chapter eid="2KI 1" />
  <chapter number="2" style="c" sid="2KI 2" />
  <para style="s">A̱sulazuva a tara ta̱ Iliya a̱ ka̱ra̱ zuva</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 2:1" />Ana mantsa ma na A̱sulazuva aa tara Iliya a̱ tyo zuva a̱tsuma̱ a̱ lipa̱ ma rawai zuzu, Iliya na̱ Elisha a̱ da̱na̱ ta̱ a mmalu diga Gilgal. <verse eid="2KI 2:1" /><verse number="2" style="v" sid="2KI 2:2" />Reve Iliya damma Elisha, &lt;&lt;Isawan pa, A̱sulazuva a̱ lyungu mu ta̱ Betel.&gt;&gt;</para>
  <para style="p" vid="2KI 2:2">Amma a̱vu Elisha damma, &lt;&lt;N kucina ta̱ na̱ A̱sulazuva a na a̱ ri wuma na̱ wuma wa̱ wu waru, maa lyawa wu shi.&gt;&gt; Ɗaɗa a̱ ka̱ra̱i a̱ cipa̱ a̱ tyo Betel.<verse eid="2KI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 2:3" />Reve oɓolo a ama̱sula̱ a na a̱ ri Betel o uta̱ reve e ece Elisha, &lt;&lt;Ko vu reve ta̱ a na ana'an A̱sulazuva a ta tara zagbain va̱ wu a̱a̱ ka̱ra̱?&gt;&gt;</para>
  <para style="p" vid="2KI 2:3">Reve Elisha usu, u damma, &lt;&lt;Ee, n reve ta̱, amma she i da̱shi yuwan adanshi adama o ndolo wan.&gt;&gt;<verse eid="2KI 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 2:4" />Reve Iliya damma Elisha, &lt;&lt;Isawan pa nda Elisha, adama a na A̱sulazuva a̱ lyungu mu ta̱ Jeriko.&gt;&gt;</para>
  <para style="p" vid="2KI 2:4">Reve Elisha usu yi, &lt;&lt;N kucina ta̱ na̱ A̱sulazuva a na a̱ ri wuma na̱ wuma wa̱ wu waru, maa lyawa wu shi.&gt;&gt; Reve a̱ ka̱ra̱ a̱ tyo Jeriko.<verse eid="2KI 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 2:5" />Reve oɓolo a ama̱sula̱ a na a̱ ri Jeriko a rawa zuzu reve e ece Elisha, &lt;&lt;Ko vu reve ta̱ a na ana'an A̱sulazuva a ta tara zagbain va̱ wu a̱ ka̱ra̱?&gt;&gt;</para>
  <para style="p" vid="2KI 2:5">Reve u usu, &lt;&lt;Ee, n reve ta̱, amma she i da̱shi yuwan adanshi adama o ndolo wan.&gt;&gt;<verse eid="2KI 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 2:6" />Reve Iliya damma Elisha, &lt;&lt;Isawan pa nda, A̱sulazuva a̱ lyungu mu ta̱ o Uɗolu wa̱ Urudu.&gt;&gt;</para>
  <para style="p" vid="2KI 2:6">Reve Elisha usu, &lt;&lt;N kucina ta̱ na̱ A̱sulazuva a na a̱ ri wuma na̱ wuma wa̱ wu waru, maa lyawa wu shi.&gt;&gt; Ɗaɗa a̱ ka̱ra̱i ele ra.<verse eid="2KI 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 2:7" />Reve a ama kupoton a̱tsuma̱ o oɓolo a ama̱sula̱'a̱ a̱ 'ya̱wa̱ e isawain makasu nu uba̱ta̱ u na Iliya na̱ Elisha e isawain a̱ nge'en mu Uɗolu wa̱ Urudu. <verse eid="2KI 2:7" /><verse number="8" style="v" sid="2KI 2:8" />Reve Iliya foɗo utugu wa̱ yi, reve u punda̱ra̱ yi reve u fabaa mini na̱ a̱yi. Reve mini'i me ne'eshenlei upasu wu usa'ani nu ugula̱, a̱vu ele ra a pasa e iɗa yu u'yewu.<verse eid="2KI 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 2:9" />Ana a pasai, a̱vu Iliya damma Elisha, &lt;&lt;Damma mu ili i na maa yuwaan wu, kafu a tara mu a̱ ka̱ra̱ n lyawa wu.&gt;&gt;</para>
  <para style="p" vid="2KI 2:9">A̱vu Elisha usu, &lt;&lt;Lyawa n tsura̱ agadu a akunda a̱ ruhu va̱ wu toto ure.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">agadu a akunda a̱ ruhu va̱ wu toto ure: Uba̱ta̱ u nda Elisha ta patishi a akunda a agadu o ulobo wu ufaru o una̱ wa agadu. Ka̱lyuwa̱: U. Wl 21:17.</char></note><verse eid="2KI 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 2:10" />Reve Iliya damma, &lt;&lt;Vu pati ta̱ ili yu usa̱n. Suru na̱ ne, na̱ ve ene mu yashi i na aa tara mu a̱ ka̱ra̱ n lyawa wu, u to o za va̱ wu, na̱ ne ɗa gba shi, to, woo o'wo ne shi.&gt;&gt;<verse eid="2KI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 2:11" />Ele a̱tsuma̱ a mmalu na a yuwin adanshi, babu usa̱n a̱vu keke vi ido va akina ni ido ya akina i ta̱wa̱ reve u uwa e memere me ele wu kasa le, a̱vu a tara Iliya a̱ tyo zuva a̱tsuma̱ a̱ lipa̱. <verse eid="2KI 2:11" /><verse number="12" style="v" sid="2KI 2:12" />Ana Elisha enei ili i nda reve u saala, &lt;&lt;Dada va̱! Dada va̱! Ikeke yi ido, na akumbi e ikeke yi ido ya Isra'ila!&gt;&gt; Elisha da̱shi ene yi waru shi. Reve Elisha reme a̱tugu a̱ yi reve u karalai nle.<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Ngo 13:14.</char></note><verse eid="2KI 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 2:13" />Reve u tara umuna u na u riya̱i za va Iliya, reve u ka̱mba̱ wi isawan a̱ nge'en mu Uɗolu wa̱ Urudu. <verse eid="2KI 2:13" /><verse number="14" style="v" sid="2KI 2:14" />Reve u tara umuna wa Iliya u na u riya̱i'i, reve u fabaa mini na̱ a̱yi. Reve u damma, &lt;&lt;Te ɗa A̱sulazuva, A̱sula̱ a Iliya?&gt;&gt; Ana u fabai mini'i, reve u ne'eshenlei ure upasu wu usa'ani nu upasu wu ugula̱, ɗaɗa u pasai.<verse eid="2KI 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 2:15" />Reve oɓolo a ama̱sula̱ a̱ Jeriko a na enei ili i na i farai, a damma, &lt;&lt;Ruhu va Iliya ta̱ nden a aci a Elisha gogo.&gt;&gt; Reve a̱ 'ya̱wa̱ a ga'aton yi, reve a̱ ka̱ɗa̱to hali she e iɗa a̱ ma̱ka̱ka̱n ma̱ yi. <verse eid="2KI 2:15" /><verse number="16" style="v" sid="2KI 2:16" />A̱vu a damma yi, &lt;&lt;Ka̱lyuwa̱ nda, a̱tsu agbashi a̱ wu tsu ta̱ na ama o ucira kupoton. Lyawa a̱ 'ya̱wa̱ a zami zagbain va̱ wu. U ta gura o'wo Ruhu va̱ A̱sulazuva a tara yi ta̱ reve u vari yi a masasan mo o ro ko a̱tsuma̱ o uka̱ri u ro.&gt;&gt;</para>
  <para style="p" vid="2KI 2:16">A̱vu Elisha usu, &lt;&lt;O'o, she i lyungu le wan.&gt;&gt;<verse eid="2KI 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 2:17" />Amma a̱vu a gbagba a lyawa shi hali she na u lyawa nle a̱ 'ya̱wa̱. Ɗaɗa u damma le, &lt;&lt;Lyungu nle a̱ 'ya̱wa̱.&gt;&gt; Ɗaɗa a̱ lyunguyi ama kupoton aza a na a zami niyi hali rana ta'atsu agba a̱ tsura̱ yi shi. <verse eid="2KI 2:17" /><verse number="18" style="v" sid="2KI 2:18" />Ana a̱ ka̱mba̱i ya Elisha za na shi Jeriko, a̱vu u damma le, &lt;&lt;N damma ɗu she i 'ya̱wa̱ wan shi?&gt;&gt;<verse eid="2KI 2:18" /></para>
  <para style="s">Elisha temei linga va asalama</para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 2:19" />A̱vu ama a̱ lyuci va̱ Jeriko a damma Elisha, &lt;&lt;Ka̱lyuwa̱, zagbain tsu, vu ta gura ene lyuci nda tu ulobonu wa̱ a̱ka̱nla̱. Amma mini ma̱ lyuci'i ma̱ ri yu ulobonu shi, iɗa'a waru waa matsasan itana yu uɗuma̱ ya̱ a̱ɓula̱ shi.&gt;&gt;<verse eid="2KI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 2:20" />A̱vu Elisha damma, &lt;&lt;Ta̱wa̱a̱ numu na aasa'atsu a sa'avu a̱vu a̱ tsun akpaɗi pe.&gt;&gt; Ɗaɗa a̱ ta̱wa̱a̱ niyi.<verse eid="2KI 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 2:21" />A̱vu u ka̱ra̱ a̱ 'ya̱wa̱ uba̱ta̱ we esu a̱ mini'i a̱vu u tsun pe akpaɗi'i a̱vu u damma, &lt;&lt;Apa ili i na A̱sulazuva a dammai, &lt;N ka̱mbuwa̱ ta̱ mini ma nda gbaga. Wa̱a̱ da̱shi ta̱wa̱ nu ukwa̱ shi, ko u da̱shi zuwa iɗa'a u kuɗa̱ a matsan ili ya̱ a̱ɓula̱ shi.&gt; &gt;&gt; <verse eid="2KI 2:21" /><verse number="22" style="v" sid="2KI 2:22" />A̱vu gba mini'i mo lobono hali a̱ tyo ana'an, cine Elisha dammai.<verse eid="2KI 2:22" /></para>
  <para style="s">A yuwaan ta̱ Elisha ulamu</para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 2:23" />Diga lo, reve Elisha gawan a̱ tyo Betel. A̱yi a̱tsuma̱ a mmalu o ure, a̱vu olobo o ro o u ta̱ a̱tsuma̱ a̱ lyuci reve a yuwaan yi ulamu, a dansa, &lt;&lt;Ka̱ra̱ a gawan, a̱vu za vu ukparu!&gt;&gt;<verse eid="2KI 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 2:24" />A̱vu u vadala u ka̱lyuwa̱ le, reve u yuwaan le una̱ na ala a̱ A̱sulazuva. A̱vu nan biya e re o uta̱ a̱tsuma̱ e iɗanga a̱vu a kara olobo amunga ne ejere a̱tsuma̱ o olobo'o.<verse eid="2KI 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 2:25" />Reve Elisha ka̱ra̱ a̱ tyo a Masasan ma Kame reve diga ɗe u ka̱mba̱ Samariya.<verse eid="2KI 2:25" /></para>
  <chapter eid="2KI 2" />
  <chapter number="3" style="c" sid="2KI 3" />
  <para style="s">Uvon wa aza a Isra'ila na̱ a̱za̱ a̱ Mowa</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 3:1" />Jehoram ulobo wa Ahabu wo o'wo ta̱ mogono ma Isra'ila a̱tsuma̱ a Samariya, a a'wan a kupa na̱ kunla̱ o tsugono tsa Jehoshafa mogono ma Yahuda, a̱vu u yuwan tsugono a'wan kupa ne ejere. <verse eid="2KI 3:1" /><verse number="2" style="v" sid="2KI 3:2" />Agba u yuwan ta̱ iwuya e ekere a̱ A̱sulazuva, amma u rawa cina dada va̱ yi na̱ mma va̱ yi yuwain shi. Wu tawa ta̱ atali a̱ a̱ga̱nda̱ a Ba'al a na dada va̱ yi yuwain. <verse eid="2KI 3:2" /><verse number="3" style="v" sid="2KI 3:3" />Amma suru na̱ ne wu kasa nu unusu wa Yerobowam ulobo wa Neba shi, za na u zuwai Isra'ila yuwain, u lyawa le shi.<verse eid="2KI 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 3:4" />Mesha mogono ma̱ Mowa gba za va aguɓa e ikyon i ɗa. U shi ta̱ u tsu ca mogono ma Isra'ila ikyon ukpakukupa ukpaku (100,000) na̱ eleme a̱ a̱giri'i ukpakukupa ukpaku (100,000). <verse eid="2KI 3:4" /><verse number="5" style="v" sid="2KI 3:5" />Amma a na Ahabu mogono ma Isra'ila ma̱ kuwa̱i, a̱vu mogono ma̱ Mowa ma̱ 'ya̱sa̱a̱n mogono ma Isra'ila aci. <verse eid="2KI 3:5" /><verse number="6" style="v" sid="2KI 3:6" />Ɗaɗa a mantsa'a mogono Jehoram mo uta̱i diga Samariya reve u ɓoloto a̱soja a Isra'ila suru adama o uvon. <verse eid="2KI 3:6" /><verse number="7" style="v" sid="2KI 3:7" />A̱vu waru u lyunguwa̱ Jehoshafa mogono ma Yahuda ni ikaka u damma, &lt;&lt;Mogono ma̱ Mowa ma̱ 'ya̱sa̱a̱n mu ta̱ aci. Vu ta̱ 'ya̱wa̱ oɓolo na̱ a̱mu tsu yuwan uvon na̱ Mowa?&gt;&gt;</para>
  <para style="p" vid="2KI 3:7">A̱vu usu, &lt;&lt;N ta̱ 'ya̱wa̱ oɓolo na̱ a̱vu. A̱mu na̱ a̱vu ili i ta̱ i ɗa. A̱soja a̱ va̱, a̱soja a̱ wu a ɗa, ido i va̱, ido ya̱ wu i ɗa.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 22:4.</char></note><verse eid="2KI 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 3:8" />A̱vu Jehoshafa ece, &lt;&lt;Nu ure u ne u ɗa tsoo toni?&gt;&gt;</para>
  <para style="p" vid="2KI 3:8">A̱vu Yehoram usu, &lt;&lt;Na̱ a̱tsumona a Edom.&gt;&gt;<verse eid="2KI 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 3:9" />Ɗaɗa mogono ma Isra'ila na̱ mogono ma Yahuda na̱ mogono ma Edom o uta̱i. Ana a yuwain rana cindere a̱ a̱ka̱nda̱riya̱ reve mini mo koto a̱soja'a oɓolo ni iliyamunga i le. <verse eid="2KI 3:9" /><verse number="10" style="v" sid="2KI 3:10" />A̱vu mogono ma Isra'ila ma damma, &lt;&lt;Nye! A̱sulazuva o ɓoloto tsu ta̱ ngono n ta'atsu n nda adama u ca tsu e ekere a̱ Mowa?&gt;&gt;<verse eid="2KI 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 3:11" />Amma a̱vu Jehoshafa ece, &lt;&lt;Vumava̱sula̱ va̱ A̱sulazuva pa za na tsa zami urewesu wa̱ A̱sulazuva e ekere a̱ yi shi?&gt;&gt;</para>
  <para style="p" vid="2KI 3:11">A̱vu za ta̱ a̱tsuma̱ a agbashi o mogono ma Isra'ila u damma, &lt;&lt;Elisha ulobo wa Shafa u ta̱ pa. A̱yi kambi va Iliya ɗa shi.&gt;&gt; <verse eid="2KI 3:11" /><verse number="12" style="v" sid="2KI 3:12" />A̱vu Jehoshafa damma, &lt;&lt;Adanshi a̱ A̱sulazuva a̱ ta̱ oɓolo na̱ a̱yi.&gt;&gt; Adama o ndolo reve mogono ma Isra'ila na̱ mogono ma Yahuda na̱ mogono ma Edom a̱ ka̱ra̱ a̱ 'ya̱wa̱ uba̱ta̱ wa̱ yi.<verse eid="2KI 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 3:13" />A̱vu Elisha damma mogono ma Isra'ila, &lt;&lt;Nye i bura numu na̱ a̱vu? Ka̱ra̱ a̱ 'ya̱wa̱ uba̱ta̱ wa ama̱sula̱ a dada va̱ wu na ama̱sula̱ a mma va̱ wu.&gt;&gt;</para>
  <para style="p" vid="2KI 3:13">Amma a̱vu mogono ma Isra'ila ma damma yi, &lt;&lt;O'o, adama a na A̱sulazuva a ɗa e ɗe ntsu ngono n ta'atsu adama u ca tsu e ekere a̱ Mowa.&gt;&gt;<verse eid="2KI 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 3:14" />A̱vu Elisha damma, &lt;&lt;N kucina ta̱ wuma wa̱ A̱sulazuva oɓolo a̱ a̱soja a zuva, za na maa yuwusaan a̱ga̱nda̱, na a damma adama a na maa casu Jehoshafa mogono ma Yahuda tsugbain shi, n shi a̱ ka̱lyuwa̱ wu shi, ko gba n reve a na vu ri lo shi. <verse eid="2KI 3:14" /><verse number="15" style="v" sid="2KI 3:15" />Gogo ta̱wa̱a̱ na̱ numu za na gurai tsuwe'e tsa̱ kumburu.&gt;&gt; A mantsa ma na za tsuwe'e vu kumburu'u u ri a wa'asa kumburu'u, a̱vu ukere wa̱ A̱sulazuva u cipa̱a̱ Elisha, <verse eid="2KI 3:15" /><verse number="16" style="v" sid="2KI 3:16" />A̱vu u damma, &lt;&lt;Apa nda ili i na A̱sulazuva a dammai, &lt;Ka̱pa̱i oko'o o uka̱ri u nda suru.&gt; &gt;&gt; <verse eid="2KI 3:16" /><verse number="17" style="v" sid="2KI 3:17" />Adama a na apa ili i na A̱sulazuva a dammai, &lt;&lt;Ye ene upepu ko iro'i shi, suru na̱ ne uka̱ri u nda u ta shiwan na̱ mini, a̱vu a̱ɗu ni inan i ɗu na akapi e iliyamunga i na i buwai i sowo. <verse eid="2KI 3:17" /><verse number="18" style="v" sid="2KI 3:18" />A̱yi nda ili yu usa̱n u ɗa shi e ekere a̱ A̱sulazuva. Waru u ta ca ɗu Mowa e ekere a̱ ɗu. <verse eid="2KI 3:18" /><verse number="19" style="v" sid="2KI 3:19" />I ta lyuwa lyuci vu ukari suru na̱ lyuci sa'ani suru. I to koɗo uɗanga wu ulobonu suru, reve i gulu esu a̱ mini suru, a̱vu i lungusa̱ uɗuma̱ u sa'ani suru na atali.&gt;&gt;<verse eid="2KI 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 3:20" />Ana usana u tawai nu usana, a mantsa ma na a tsu ca kucci, a̱vu mini me yene diga o upasu wa Edom! A̱vu iɗa'a i shiwan na̱ mini.<verse eid="2KI 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 3:21" />A̱za̱ a̱ Mowa gba suru a uwwa ta̱ a na ngono'o n ta̱wa̱i adama a yuwan uvon ne ele, ɗaɗa ali suru aza a na a rawai a na a̱ guza̱ itana yu uvon, zagbain na̱ za ke'en, reve e ɗe le a zuwa le a dara o utyo wu upasu wi iɗa i le. <verse eid="2KI 3:21" /><verse number="22" style="v" sid="2KI 3:22" />Ana a̱ 'yoyin nu usana usana, urana u shi ta̱ e ikanasa mini'i. Uba̱ta̱ wa̱ a̱za̱ a̱ Mowa mavada ma̱ mini'i mo rotso ta̱ ushili tsa mpasa. <verse eid="2KI 3:22" /><verse number="23" style="v" sid="2KI 3:23" />Reve a ama Mowa oruwo, &lt;&lt;Mpasa n ɗa! U ta gura o'wo ngono ndolo n yuwan ta̱ nla̱ngi a̱vu a paɗalai va̱ni le. A̱za̱ Mowa, lyawai tsu 'ya̱wa̱i tsu pura̱i itana i le!&gt;&gt;<verse eid="2KI 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 3:24" />Agba a mantsa ma na a rawai o uva̱la̱ta̱ wa aza a Isra'ila, reve aza a Isra'ila a̱ 'yon a̱vu a yuwan uvon ne ele hali she na a sumai. A̱vu aza a Isra'ila a uwa iɗa'a a̱vu o una a̱za̱ a̱ Mowa. <verse eid="2KI 3:24" /><verse number="25" style="v" sid="2KI 3:25" />A̱vu a̱ lungusa̱ ilyuci'i. A̱vu vuma suru vari aatali o uɗuma̱ u sa'ani suru hali she na a shiwain na atali. A̱vu waru a̱ gulu esu a̱ mini suru a̱vu o koɗo uɗanga u sa'ani biti. Kir Harese ɗa goon shi buwai na atali a̱ yi, amma reve a̱soja a̱ shi ufoɓu na̱ a̱bitsutsu a̱ ka̱nda̱ruwa̱ yi a̱vu a̱ riya̱a̱ yi nu uvon.<verse eid="2KI 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 3:26" />A mantsa ma na mogono ma̱ Mowa me enei uvon u vadala ta̱ a̱ tyo ya̱'a̱ yi, ɗaɗa u tarai a̱soja a na a̱ ri na̱ mutsun mu pe'eni a̱soja ukpaku ucindere (700) adama o utula̱i a̱ tyo uba̱ta̱ u mogono ma Edom, agba a gura shi. <verse eid="2KI 3:26" /><verse number="27" style="v" sid="2KI 3:27" />Reve gba u tara ulobo wa̱ yi mawun mo ufaru ma na ma lyuwa tsugono o una̱ wa̱ yi, a̱vu u yuwan kucci vu ukula̱tosu na̱ yi o uɓaɓu u lyuci'i. Reve aza a Isra'ila a uwwa wovon lon, ɗaɗa a vadalai a̱ ka̱mba̱i e iɗa i le.<verse eid="2KI 3:27" /></para>
  <chapter eid="2KI 3" />
  <chapter number="4" style="c" sid="2KI 4" />
  <para style="s">Elisha kamba ta̱ ma̱runa̱</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 4:1" />Ka vuma ro a̱tsuma̱ o oɓolo a ama̱sula̱ 'ya̱wa̱ ta̱ uba̱ta̱ wa Elisha u damma, &lt;&lt;Vali va̱ aagbashi a̱ wu a̱ kuwa̱ ta̱, agba vu reve ta̱ a na a̱yi vuma ɗa na shi a uwwusa wovon wa̱ A̱sulazuva. Amma gogo a̱yi ɗa nda za ro na oo tono yi utan u ta̱wa̱i adama u tara olobo e re a̱ va̱ o o'wo yi agbashi.&gt;&gt;<verse eid="2KI 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 4:2" />A̱vu Elisha damma ka'a, &lt;&lt;Nye maa yuwaan wu? Damma mu, nye vu ri na̱ a̱yi o u'wa wa̱ wu?&gt;&gt;</para>
  <para style="p" vid="2KI 4:2">A̱vu ka'a u damma, &lt;&lt;Aagbashi a̱ wu a̱ ri ni ili i ro pe shi, she mamani'in ma̱ zetun goon.&gt;&gt;<verse eid="2KI 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 4:3" />A̱vu Elisha damma ka'a, &lt;&lt;'Ya̱wa̱ uba̱ta̱ wu nron mu nden ma̱ wu vu kopo nden m mani'in n na n ri ni ili pe shi. She vu kopo wa'a wan. <verse eid="2KI 4:3" /><verse number="4" style="v" sid="2KI 4:4" />Reve vu uwa a aasula vu ɓa̱ru una̱ntsu a̱vu no olobo a̱ wu. Vu tsun mani'in a̱ nde'en suru, za na shiwan vu zuwa yi a̱ nge'en.&gt;&gt;<verse eid="2KI 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 4:5" />A̱vu gba ka'a u ka̱ra̱ u lyawa yi. A̱vu u ɓa̱ru una̱ntsu a̱yi no olobo a̱yi. Reve o olobo a̱yi ta̱wusa̱a̱ yi na̱ nde'en a̱vu u uwa a̱ tsusun pe mani'in. <verse eid="2KI 4:5" /><verse number="6" style="v" sid="2KI 4:6" />Ana nde'en suru a shiwain, a̱vu u damma ulobo wa̱ yi, &lt;&lt;Ta̱wa̱a̱ mu na̱ za ro.&gt;&gt;</para>
  <para style="p" vid="2KI 4:6">Amma a̱vu u usu, &lt;&lt;Ko meden ma̱ ta̱ ma buwa shi.&gt;&gt; Ɗaɗa mani'in ma lyawai mota̱. <verse eid="2KI 4:6" /><verse number="7" style="v" sid="2KI 4:7" />A̱vu u 'ya̱wa̱ u damma vuma va̱ A̱sula̱'a̱, reve a̱yi u damma yi, &lt;&lt;'Ya̱wa̱ vu wina mani'i'in vu tsupa utan wa̱ wu, ili i na i buwai gba a̱vu no olobo a̱ wu i tsura̱ ili i na yaa lyuwa.&gt;&gt;<verse eid="2KI 4:7" /></para>
  <para style="s">Elisha ka̱mba̱toi ulobo wu ka vuma va Shunem wuma</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 4:8" />Urana u ro, reve Elisha 'ya̱wa̱ a̱ lyuci va̱ Shunem. Ka vu utsuru ro da̱na̱ ta̱ pe, a̱vu u banu Elisha wi isawan u lyuwa ilyalya o u'wa wa̱ yi. Diga lo, nu u kuru na̱ nlo suru, u tsi isawan ta̱ lo u lyuwa ilyalya. <verse eid="2KI 4:8" /><verse number="9" style="v" sid="2KI 4:9" />A̱vu ka'a u damma vali va̱ yi, &lt;&lt;N reve ta̱ a na vuma na a̱ ta̱wusa̱ pa kuci vuma va akiza va̱ A̱sula̱ ɗa. <verse eid="2KI 4:9" /><verse number="10" style="v" sid="2KI 4:10" />Lyawa tsu suwa masula ɗe zuva, a̱vu tsu zuwaa yi a̱a̱ga̱da̱ na apada no ootogu na̱ fitila ɗe. Nu u ta̱wa̱ uba̱ta̱ u tsu biti u ta gura da̱nu pe.&gt;&gt;<verse eid="2KI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 4:11" />Urana u ro a na Elisha ta̱wa̱i lo, a̱vu u kumba a aasula a̱ yi a̱vu u von. <verse eid="2KI 4:11" /><verse number="12" style="v" sid="2KI 4:12" />A̱vu u damma aagbashi a̱ yi Gehazi, &lt;&lt;Ɗewe mu ka va Shune'um.&gt;&gt; Ɗaɗa u ɗe niyi, reve wisawan elime a̱ yi. <verse eid="2KI 4:12" /><verse number="13" style="v" sid="2KI 4:13" />Ɗaɗa Elisha dammai aagbashi a̱ yi Gehazi, &lt;&lt;Damma ka'a, &lt;A̱yi ɗa nda vu yuwaan tsu a̱ga̱nda̱ a nda suru, nye aa yuwaan wu? A yuwaan adanshi o una̱ wa̱ wu uba̱ta̱ u mogono ko uba̱ta̱ wa yali va̱ a̱soja?&gt; &gt;&gt;</para>
  <para style="p" vid="2KI 4:13">A̱vu ka'a u usu, &lt;&lt; O'o n ta̱ nden a̱tsuma̱ a ama a̱ va̱, n ciga ili i ro shi.&gt;&gt;<verse eid="2KI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 4:14" />A̱vu Elisha ece Gehazi, &lt;&lt;Nye aa yuwaan yi?&gt;&gt;</para>
  <para style="p" vid="2KI 4:14">Reve Gehazi damma, &lt;&lt;To, u ri nu ulobo shi agba vali va̱ yi ɗa nda kutsai ɗe.&gt;&gt;<verse eid="2KI 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 4:15" />Reve Elisha damma, &lt;&lt;Ɗe yi u ta̱wa̱.&gt;&gt; Ɗaɗa Gehazi ɗe niyi, reve u rawa wi isawan o una̱ntsu wa aasula'a. <verse eid="2KI 4:15" /><verse number="16" style="v" sid="2KI 4:16" />Reve Elisha damma yi, &lt;&lt;Acina mantsa ma nda nkoli, vu te sheɗe ulobo ne e ekere a̱ wu.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:16 </char><char style="ft" closed="false">Ka̱lyuwa̱: Ufr 18:14.</char></note></para>
  <para style="p" vid="2KI 4:16">Reve ka'a u damma, &lt;&lt;O'o, zagbain va̱, she vu luluma̱ mu wan!&gt;&gt;<verse eid="2KI 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 4:17" />Reve gba ka'a u yuwan a̱tsuma̱, reve a na aa'wan a tawai a mantsa mo ndolo gan, a̱vu u matsan ulobo, cine Elisha damma niyi.<verse eid="2KI 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 4:18" />A na ulobo'o u kungwai, reve urana u ro wu uta̱ a̱ 'ya̱wa̱ uba̱ta̱ wa dada va̱ yi o uɗuma̱ za na shi oɓolo na̱ a̱za̱ o ugasa. <verse eid="2KI 4:18" /><verse number="19" style="v" sid="2KI 4:19" />Reve u saala dada va̱ yi, &lt;&lt;Aaci a̱ va̱! Aci a̱ va̱!&gt;&gt;</para>
  <para style="p" vid="2KI 4:19">Reve dada va̱ yi damma aagbashi a̱ ta̱, &lt;&lt;Sheɗe yi a̱ tyo o u'wa ya mma va̱ yi.&gt;&gt; <verse eid="2KI 4:19" /><verse number="20" style="v" sid="2KI 4:20" />Ana aagbashi'i u sheɗe niyi a̱ tyo ya mma va̱ yi, a̱vu ulobo'o u von a aagutsu a mma va̱ yi hali urana u rawa a aci, reve gba u kuwa̱. <verse eid="2KI 4:20" /><verse number="21" style="v" sid="2KI 4:21" />A̱vu ka'a u kumba zuva a̱vu u voton yi a̱ a̱a̱ga̱da̱ a vuma va̱ A̱sula̱, a̱vu u ɓa̱ru una̱ntsu a̱vu u ka̱ra̱ o uta̱. <verse eid="2KI 4:21" /><verse number="22" style="v" sid="2KI 4:22" />Reve u ɗe vali va̱ yi u damma, &lt;&lt;Yuwan ankuri lyunguwa̱ mu na aagbashi a̱ ta̱ na̱ mololi adama n 'ya̱wa̱ uba̱ta̱ u vuma va̱ A̱sula̱ gogogo a̱vu n ka̱mba̱.&gt;&gt;<verse eid="2KI 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 4:23" />A̱vu vali'i we ece yi, &lt;&lt;Adama a̱ nye va̱a̱ 'ya̱wa̱ ya̱'a̱ yi ana'an? Ana'an Woto u Sa'avu wa̱ a̱buki a ɗa shi ko gba Ashibi shi.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:23 </char><char style="ft" closed="false">Woto u Sa'avu wa̱ a̱buki a ɗa shi ko gba Ashibi shi: A ta tara ta̱ cu'un mantsa ma ɗaɗa ma ntsaa yi a na a zamiyi a̱sa̱la̱ diga uba̱ta̱ vuma va̱ A̱sula̱.</char></note></para>
  <para style="p" vid="2KI 4:23">A̱vu u usu, &lt;&lt;Babu ili i ro gbaga ɗa.&gt;&gt;<verse eid="2KI 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 4:24" />A̱vu u zuwaa mololi urutsu a̱vu u damma aagbashi a̱ yi, &lt;&lt;Gba̱ra̱ mololi, she vu yuwan ben adama a̱ va̱ wan she na̱ n damma wu.&gt;&gt; <verse eid="2KI 4:24" /><verse number="25" style="v" sid="2KI 4:25" />Ɗaɗa u remei ure a̱vu u rawa uba̱ta̱ u vuma va̱ A̱sula̱ a Masasan ma Kame. Ana vuma va̱ A̱sula̱ ene niyi diga makasu, a̱vu u damma aagbashi a̱ yi Gehazi, &lt;&lt;Ka̱lyuwa̱! Ndeɗe ka va Shunem! <verse eid="2KI 4:25" /><verse number="26" style="v" sid="2KI 4:26" />Suma vu ga'an na̱ a̱yi ve ece yi, &lt;Vu ta̱ gbaga? Vali va̱ wu ta̱ gbaga? Mawun ma̱ wu ma̱ ta̱ gbaga?&gt; &gt;&gt;</para>
  <para style="p" vid="2KI 4:26">A̱vu ka'a u usu, &lt;&lt;Babu ili i ro gbaga ɗa.&gt;&gt;<verse eid="2KI 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 4:27" />Ana u rawai uba̱ta̱ wa Elisha a masasan, reve u gbagbala ana a̱ yi. A̱vu Gehazi rawa zuzu tsa̱ra̱ u ca̱co yi, amma reve Elisha damma yi, &lt;&lt;Lyawa yi! U ta̱ na̱ a̱tsumola̱ngu lon, agba A̱sulazuva o sokoo mu ta̱ aɗa a nda agba u damma mu ili i na i zuwai shi.&gt;&gt;<verse eid="2KI 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 4:28" />Reve Ka'a u damma, &lt;&lt;Zagbain, m pati wu ta̱ vu ca mu ulobo? N damma she vu luluma̱ mu wan shi?&gt;&gt;<verse eid="2KI 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 4:29" />A̱vu Elisha damma Gehazi, &lt;&lt;Nla̱ utugu wa̱ wu a gbakala va̱ wu, vu tara aaɗanga a̱ va o ukere wa̱ wu a̱vu vu suma. Na̱ vu ga'an na̱ nanza she vu ca̱sa̱ yi wan, waru na̱ nanza ca̱sa̱ wu, she vu usu yi wan. 'Ya̱wa̱ vu kuru aaɗanga a̱ va̱ o urewesu wu ulobo'o.&gt;&gt;<verse eid="2KI 4:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 4:30" />Reve mma mawu'un u damma Elisha, &lt;&lt;N kucina ta̱ na̱ A̱sulazuva a na a̱ ri wuma, oɓolo na̱ wuma wa̱ wu, maa lyawa wu shi.&gt;&gt; Ɗaɗa Elisha 'yoyin reve u kuru yi.<verse eid="2KI 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 4:31" />Reve Gehazi uwa elime, reve u kuru aaɗanga a Elisha o urewesu wu ulobo'o, agba babu ilama ko oroci a̱ wivuwun. Ɗaɗa Gehazi ka̱mba̱i ya Elisha, reve u damma yi, &lt;&lt;Ulobo'o u 'yon shi.&gt;&gt;<verse eid="2KI 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 4:32" />Ana Elisha rawai o u'wa'a, ulobo u ɗaɗa gba ndolo nven ukwa̱ a̱ a̱a̱ga̱da̱ a̱ yi. <verse eid="2KI 4:32" /><verse number="33" style="v" sid="2KI 4:33" />Reve u uwa, a̱vu u ɓa̱ru una̱ntsu diga a̱yi she ulobo'o, reve u yuwan avasa a̱ tyo e ekere a̱ A̱sulazuva. <verse eid="2KI 4:33" /><verse number="34" style="v" sid="2KI 4:34" />Reve u von a̱ lipu vu ulobo'o, reve u ɓolo una̱ wa̱ yi nu una̱ wu ulobo'o, esu a̱ yi ne esu o ulobo'o, ekere a̱ yi ne ekere o ulobo'o. Ana wu ba̱ruwa̱i lipu va̱ yi a̱ lipu vu ulobo'o, a̱vu lipu vu ulobo'o u teme a̱ ka̱mba̱sa̱ sheshen.<note caller="+" style="f"><char style="fr" closed="false">4:34 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 17:21.</char></note> <verse eid="2KI 4:34" /><verse number="35" style="v" sid="2KI 4:35" />Reve Elisha 'yon u ka̱ra̱ a mmalu, nu u 'ya̱wi nu u ka̱mbi a̱tsuma̱ a aasula'a. Reve u kumba a̱ga̱da̱'a̱ reve u vowison a̱ lipu vu ulobo'o. Reve ulobo'o wu disha toto ucindere a̱vu u kpa̱tu'wa̱ esu a̱ yi!<verse eid="2KI 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 4:36" />Reve Elisha ɗe Gehazi a̱vu u damma, &lt;&lt;Ɗewe mu ka va Shune'um.&gt;&gt; A̱vu u ɗe yi. Ana u uwai, reve Elisha damma yi, &lt;&lt;Tara ulobo wa̱ wu!&gt;&gt; <verse eid="2KI 4:36" /><verse number="37" style="v" sid="2KI 4:37" />A̱vu u uwa u kingyo a̱ ma̱ka̱ka̱n ma̱ yi. Reve u tara ulobo wa̱ yi u ka̱ra̱ o uta̱.<verse eid="2KI 4:37" /></para>
  <para style="s">Elisha tawa ta̱ tsukono diga a̱tsuma̱ e ilyalya</para>
  <para style="p">
    <verse number="38" style="v" sid="2KI 4:38" />A̱vu Elisha ka̱mba̱ Gilgal, agba a̱ da̱na̱ ta̱ a yuwusan ambulu upasu wi iɗa'a. A mantsa ma na oɓolo a ama̱sula̱ a̱ da̱na̱i e iɓolo na̱ a̱yi, a̱vu damma aagbashi a̱ yi, &lt;&lt;Punga̱ upondo u gbain vu yuwaan ama̱sula̱ a nda usa'an.&gt;&gt;<verse eid="2KI 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="2KI 4:39" />Za ta̱ a̱tsuma̱ e le 'ya̱wa̱ ta̱ atsusa adama u zami a̱vu'un reve u tsura̱ otopino ataci a̱ ina̱bi. A̱vu wu taɓa umatsun wa̱ yi a̱vu u shiton utugu wa̱ yi. Ana u ka̱mba̱i a̱vu wu paɗa le a̱vu u tsun le a̱tsuma̱ o upondo wu usa'an ko na wo o'woi ko za reve nye i ɗa shi. <verse eid="2KI 4:39" /><verse number="40" style="v" sid="2KI 4:40" />A̱vu e kenee ama'a usa'an, reve gba a na e temei alya, a̱vu a saala, &lt;&lt;Vuma va̱ A̱sula̱, tsukono tsa̱ ta̱ pe a̱tsuma̱ o upondo'o!&gt;&gt; Agba a gura lyuwa yi shi. <verse eid="2KI 4:40" /><verse number="41" style="v" sid="2KI 4:41" />A̱vu Elisha damma, &lt;&lt;Ta̱wa̱i na̱ yira.&gt;&gt; A̱vu u tsun pe a̱tsuma̱ o upondo'o, reve u damma, &lt;&lt;Cayi ama a lyuwa.&gt;&gt; A̱vu gba wo o'wo babu pe tsukono a̱tsuma̱ o upondo'o.<verse eid="2KI 4:41" /></para>
  <para style="s">Elisha lyuwato ta̱ ama ukpaku (100)</para>
  <para style="p">
    <verse number="42" style="v" sid="2KI 4:42" />Vuma ro uta̱ ta̱ diga Ba'al Shalisha, a̱vu ta̱wa̱a̱ vuma va̱ A̱sula̱ na akpatali o opopofu a na a yuwain ni icu'un i muwun mu ufaru no oroci a yitabo ushin, na akita e ishina i sa'ani a̱tsuma̱ a̱ a̱buhu a̱ yi. Reve Elisha damma, &lt;&lt;I ca ama'a adama a lyuwa.&gt;&gt;<verse eid="2KI 4:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="2KI 4:43" />Amma a̱vu aagbashi a̱ yi a damma, &lt;&lt;Vu ta majiyan u ta rawa ama ukpaku (100)?&gt;&gt;</para>
  <para style="p" vid="2KI 4:43">Amma a̱vu Elisha usu yi, &lt;&lt;Ca ama'a a lyuwa, adama a na A̱sulazuva a ɗa a dammai, &lt;A ta lyuwa hali akapi a buwa.&gt; &gt;&gt; <verse eid="2KI 4:43" /><verse number="44" style="v" sid="2KI 4:44" />A̱vu u ca ama'a, a̱vu a lyuwa hali akapi a pasa, cine adanshi a̱ A̱sulazuva a dammai.<verse eid="2KI 4:44" /></para>
  <chapter eid="2KI 4" />
  <chapter number="5" style="c" sid="2KI 5" />
  <para style="s">A̱ ka̱mba̱to ta̱ Na'ama gbaga</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 5:1" />Na'ama yali ya̱ a̱soja o mogono ma Suriya ma ɗa shi. Vuma gbain ɗa u shi e ekere a zagbain va̱ yi waru u shi ta̱ u tara yi na̱ tsugbain lon, adama a na e ekere a̱ yi a ɗa A̱sulazuva a cayi aza a Suriya ulyuwu wa aci. A̱yi soja vu ucira ɗa, amma u ta̱ na̱ mɓa̱la̱ mu ukutu.<note caller="+" style="f"><char style="fr" closed="false">5:1-14 </char><char style="ft" closed="false">Ka̱lyuwa̱: Luk 4:27. </char></note> <verse eid="2KI 5:1" /><verse number="2" style="v" sid="2KI 5:2" />Aza a Suriya a̱tsuma̱ a agara o uvon u le a̱ shi ta̱ e reme mesheli diga Isra'ila, reve u yuwusaan ka va Na'ama a̱ga̱nda̱. <verse eid="2KI 5:2" /><verse number="3" style="v" sid="2KI 5:3" />Uranu u ro a̱vu mesheli'i u damma ka va Na'ama, &lt;&lt;Na a damma zagbain va̱ shi te ene vumava̱sula̱ na ri Samariya! U shi ta̱ a̱ ka̱mba̱to yi gbaga diga mɓa̱la̱ mu ukutu wa̱ yi.&gt;&gt;<verse eid="2KI 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 5:4" />A̱vu gba Na'ama 'ya̱wa̱ uba̱ta̱ wu zagbain va̱ yi, a̱vu u damma yi ili i na mesheli'i ma Isra'ila'a u dammai. <verse eid="2KI 5:4" /><verse number="5" style="v" sid="2KI 5:5" />A̱vu mogono ma Suriya ma̱ usu, &lt;&lt;Ko cine aa yuwan suru, vu 'ya̱wa̱, n ta̱ lyunguwa̱a̱ mogono ma Isra'ila na̱ mepepelime.&gt;&gt;</para>
  <para style="p" vid="2KI 5:5">Ɗaɗa Na'ama ka̱ra̱i a̱ 'ya̱wa̱ a̱vu u tara ukunzuwu u azurufa kupa na̱ ukunzuwu ukpakukupa uta̱li (6,000) u zinariya na̱ a̱tugu koko'o a zinariya kupa. <verse eid="2KI 5:5" /><verse number="6" style="v" sid="2KI 5:6" />Mepepelime ma na u 'ya̱wa̱yi'i u shi ta̱ adansa, &lt;&lt;Na̱ mepepelime ma nda ma ɗa ma̱a̱ lyungusu aagbashi a̱ va̱ Na'ama ya̱'a̱ wu, adama vu ka̱mba̱to yi gbaga diga mɓa̱la̱ mu ukutu wa̱ yi.&gt;&gt;<verse eid="2KI 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 5:7" />Ana mogono ma Isra'ila me ɗeyi mepepelime'e nu una̱, a̱vu wu kara a̱tugu a̱ yi a̱vu u damma, &lt;&lt;A̱mu A̱sula̱ a ɗa, a na maa gura una reve waru n ka̱mba̱to wuma? Adama a̱ nye vuma nda lyunguyi vuma ro ya̱'a̱ va̱, adama a̱ ka̱mba̱to yi gbaga diga mɓa̱la̱ mu ukutu wa̱ yi? Ka̱lyuwa̱i cine u cigai u zami mu nla̱ngi!&gt;&gt;<verse eid="2KI 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 5:8" />Ana Elisha vuma va̱ A̱sula̱ uwwai a na mogono ma Isra'ila ma kakara ta̱ a̱tugu a̱ yi, a̱vu u lyunguwa̱ yi ni ikaka i nda, &lt;&lt;Adama nye vu kakarai a̱tugu a̱ wu? Zuwa a̱ ta̱wa̱ mu na̱ vuma'a agba u ta̱ reve a na vumava̱sula̱ a̱ tu pa a̱tsuma̱ a Isra'ila.&gt;&gt;<verse eid="2KI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 5:9" />Ɗaɗa Na'ama ka̱ra̱i a̱ 'ya̱wa̱ oɓolo ni ido ya̱ yi ni ikeke yi ido, a̱vu wi isawan o una̱ntsu wu u'wa wa Elisha. <verse eid="2KI 5:9" /><verse number="10" style="v" sid="2KI 5:10" />A̱vu Elisha lyungu malingata ma̱ 'ya̱wa̱ ma damma yi, &lt;&lt;Wala a̱ 'ya̱wa̱ vu sumba̱ toto ucindere o Uɗolu wa̱ Urudu, lipu va̱ wu gba ta̱ ka̱mba̱ gbaga, reve waru vo o'wo cece.&gt;&gt;<verse eid="2KI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 5:11" />Amma a̱vu Na'ama ka̱ra̱ nu upan a̱vu u damma, &lt;&lt;N tara ta̱ a na u to uta̱ u ta̱wa̱ ya̱'a̱ va̱ wi isawan a̱vu u ɗe a ala a̱ A̱sulazuva A̱sula̱ a̱ yi, u ya̱sa̱n ukere wa̱ yi uba̱ta̱ wa abasa'a reve u ka̱mba̱to mu gbaga o ukutu u va̱. <verse eid="2KI 5:11" /><verse number="12" style="v" sid="2KI 5:12" />Ashe Abana na̱ Farfa ɗolu va Dimaska a la'a mini ma Isra'ila suru shi? Ma gura sumba̱ a̱tsuma̱ e le a̱vu n ka̱mba̱ cece shi?&gt;&gt; Ɗaɗa u vadalai u ka̱ra̱i nu upan.<verse eid="2KI 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 5:13" />Amma a̱vu agbashi a̱ yi a̱ 'ya̱wa̱ ya̱'a̱ yi a̱vu a damma, &lt;&lt;Dada tsu, n na̱ vumava̱sula̱'a̱ gba u shi u damma wu vu yuwan ili i gbain, vu shi a yuwan yi shi? Bele ma a na u dammai, &lt;Vu 'ya̱wa̱ vu sumba̱ vu to o'wo cece?&gt; &gt;&gt; <verse eid="2KI 5:13" /><verse number="14" style="v" sid="2KI 5:14" />Ɗaɗa u 'ya̱wa̱ u sumba̱i o Uɗolu wa̱ Urudu toto ucindere cine vuma va̱ A̱sula̱ damma niyi, reve gba lipu va̱ yi ka̱mba̱ gbaga wo o'wo cece cine vu revei za molobo.<verse eid="2KI 5:14" /></para>
  <para style="s">Oforo a Gehazi adama o utsa̱n wa̱ yi</para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 5:15" />A̱vu Na'ama oɓolo na ama a̱ yi a̱ ka̱mba̱ uba̱ta̱ vuma va̱ A̱sula̱'a̱. A̱vu wi isawan a̱ ma̱ka̱ka̱n ma vuma va̱ A̱sula̱'a̱ u damma, &lt;&lt;Gogo n reve ta̱ a na A̱sula̱ o ro o lo a̱tsuma̱ o uvaɗi suru shi she a̱tsuma̱ a Isra'ila. Yuwan ankuri ushi une'e diga e ekere a aagbashi a̱ wu.&gt;&gt;<verse eid="2KI 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 5:16" />A̱vu Elisha usu yi, &lt;&lt;N kucina ta̱ na̱ A̱sulazuva a na a̱ ri wuma za na maa yuwusaan a̱ga̱nda̱, ma̱a̱ ushi ko ili shi.&gt;&gt; Agba ko na Na'ama gbagbaa niyi, u 'yuwan ta̱.<verse eid="2KI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 5:17" />A̱vu Na'ama damma, &lt;&lt;Na̱ va̱a̱ ushi shi, yuwan ankuri vu lyawa a̱mu a na me kene ma̱bula̱ me e iɗa i ɗu, aza a na nloli mi ido n re n va̱ a gura tanu wa mu a̱ 'ya̱wa̱ mu o u'wa. Adama a na diga gogo m buwa a ca kucci ko kucci vu ukula̱tosu uba̱ta̱ ma̱sula̱ mo ro shi she A̱sulazuva goon.<note caller="+" style="f"><char style="fr" closed="false">5:17 </char><char style="ft" closed="false">kene ma̱bula̱ me e iɗa i ɗu: Ɗe nu ufaru, a ca ta̱ okolo a na a̱ cu'un ma̱bula̱ ma ɗaɗa goon a gura yuwan yi a̱ga̱nda̱. </char></note> <verse eid="2KI 5:17" /><verse number="18" style="v" sid="2KI 5:18" />Amma lyawa A̱sulazuva a yuwaan aagbashi a̱ wu gafura adama e ili i ta̱ i nda. A mantsa ma na zagbain va̱ uwai a̱ a̱a̱'isa̱ a Rimon adama u ka̱ɗa̱to u yuwan a̱ga̱nda̱ a̱yi, uraɓatowu ne ekere a̱ va̱ reve a̱mu fo n ka̱ɗa̱to pe, a mantsa ma na n ka̱ɗa̱toi a̱tsuma̱ a̱ a̱a̱'isa̱ a Rimon, lyawa A̱sulazuva a yuwaan aagbashi a̱ wu gafura adama e ili i nda.&gt;&gt;<verse eid="2KI 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 5:19" />A̱vu Elisha damma yi, &lt;&lt;Vu rawa lafiya.&gt;&gt; A̱vu Na'ama ka̱ra̱. Amma babu Na'ama yuwan alanga lon, <verse eid="2KI 5:19" /><verse number="20" style="v" sid="2KI 5:20" />a̱vu Gehazi aagbashi a Elisha a damma aciya̱yi, &lt;&lt;Zagbain va̱ lyawa ta̱ Na'ama va Suriya nda ka̱ra̱ fa̱a̱n, agba u ushiyi ko ili i ta̱ diga a̱tsuma̱ e ili i na u ta̱wa̱yi shi. N kucina ta̱ na̱ A̱sulazuva a na a̱ ri wuma, n ta̱ kuru yi n tsura̱ ili i ro e ekere a̱ yi.&gt;&gt;<verse eid="2KI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 5:21" />A̱vu Gehazi toni Na'ama ni ilaɗi. Ana Na'ama ene niyi a̱ ta̱wa̱ ya̱'a̱ yi ni ilaɗi, u cipa̱ ta̱ e keke vi ido adama u ga'aton yi. A̱vu we ece yi, &lt;&lt;N damma de lafiya ɗa?&gt;&gt;<verse eid="2KI 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 5:22" />A̱vu Gehazi usu, &lt;&lt;Lafiya ɗa. Zagbain va̱ ɗa lyungu numu n damma wu, &lt;Olobo e re diga o oɓolo a ama̱sula̱ a̱ ta̱wa̱ ta̱ ya̱'a̱ va̱ gogo diga e iɗa ya agaɗi ya Ifiramu. Yuwan ankuri vu ca le ukunzuwu uta̱ u azurufa na̱ a̱tugu e re.&gt; &gt;&gt;<verse eid="2KI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 5:23" />A̱vu Na'ama damma, &lt;&lt; Ko cine aa yuwan de, ushi ukunzuwu u azurufa u re.&gt;&gt; A̱vu gba Gehazi ushi le, a̱vu wu nla̱ ukunzuwu u azurufa'a e itsa̱n i re, na̱ wotowu wa̱ a̱tugu e re. A̱vu u ca agbashi e re a̱ yi ele, a̱vu a tanu a uwa elime a Gehazi. <verse eid="2KI 5:23" /><verse number="24" style="v" sid="2KI 5:24" />Ana Gehazi rawai a aagaɗi a̱vu u ushi itana'a e ekere a agbashi'i a̱vu u zuwa le o u'wa. Reve u lyawa ama'a a̱ ka̱ra̱. <verse eid="2KI 5:24" /><verse number="25" style="v" sid="2KI 5:25" />A̱vu u wi isawan a̱ ma̱ka̱ka̱n ma zagbain va̱ yi Elisha, A̱vu Elisha ece yi, &lt;&lt;Te shi vu 'ya̱wa̱i gba Gehazi?&gt;&gt;</para>
  <para style="p" vid="2KI 5:25">A̱vu u usu, &lt;&lt;Aagbashi a̱ wu a̱ 'ya̱wa̱ ko uba̱ta̱ shi.&gt;&gt;<verse eid="2KI 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 5:26" />Amma a̱vu Elisha damma yi, &lt;&lt;Ruhu va̱ shi oɓolo na̱ a̱vu a na vuma'a u cipa̱i e keke vi ido va̱ yi tsa̱ra̱ u ga'an na̱ a̱vu shi? Gogo mantsa ma ɗa a na a̱a̱ ushi ikebe, ko a̱tugu ko a̱ɗuma̱ a zetun na̱ ina̱bi ko ikyon na̱ mgbele ko inan na agbashi ali na̱ a̱ma̱ci? <verse eid="2KI 5:26" /><verse number="27" style="v" sid="2KI 5:27" />Adama o ndolo mɓa̱la̱ mu ukutu ma Na'ama n ta̱ suraa wu a̱vu nu ugundo wa̱ wu babu ukotu.&gt;&gt;</para>
  <para style="p" vid="2KI 5:27">A̱vu Gehazi uta̱ u lyawa Elisha na̱ mɓa̱la̱ mu ukutu u'uri puwu.<verse eid="2KI 5:27" /></para>
  <chapter eid="2KI 5" />
  <chapter number="6" style="c" sid="2KI 6" />
  <para style="s">A papa ta̱ rumu vo aɓau</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 6:1" />Reve oɓolo a ama̱sula̱ a damma Elisha, &lt;&lt;Ka̱lyuwa̱, uba̱ta̱ u na tsu tsu ga'an na̱ a̱vu u ka̱la̱ma̱ tsu ta̱. <verse eid="2KI 6:1" /><verse number="2" style="v" sid="2KI 6:2" />Lyawa tsu 'ya̱wa̱i o Uɗolu wa̱ Urudu adama koyan ɗa gasa uɗanga tsa̱ra̱ tsu suwai uba̱ta̱ u na tsa̱ da̱nuyi ɗe.&gt;&gt;</para>
  <para style="p" vid="2KI 6:2">Reve u damma le, &lt;&lt;Walai.&gt;&gt;<verse eid="2KI 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 6:3" />A̱vu za ta̱ a̱tsuma̱ ama̱sula̱'a̱ u damma Elisha, &lt;&lt;Zagbain ko vu ta yuwan ankuri vu 'ya̱wa̱ oɓolo na agbashi a̱ wu.&gt;&gt;</para>
  <para style="p" vid="2KI 6:3">&lt;&lt;A̱vu u usu u toni le.&gt;&gt; <verse eid="2KI 6:3" /><verse number="4" style="v" sid="2KI 6:4" />A̱vu u ka̱ra̱ oɓolo na̱ le. Ana a rawai upasu wu Uɗolu wa̱ Urudu, a̱vu e teme mokoɗo ma ɗanga. <verse eid="2KI 6:4" /><verse number="5" style="v" sid="2KI 6:5" />A mantsa ma na za ta̱ ri a magasa mo uɗanga, a̱vu rumu vo aɓau va̱ yi sa̱nga̱ a̱vu u riya̱ a̱ mini. A̱vu vuma'a u saala u damma, &lt;&lt;O'o zagbain va̱! Agba apa aɓau a nda n kopoi ta̱ ɗa.&gt;&gt;<verse eid="2KI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 6:6" />A̱vu vuma va̱ A̱sula̱'a̱ we ece yi u damma, &lt;&lt;A te ɗa gba uriya̱ yi?&gt;&gt; Ana u roco yi Elisha uba̱ta̱'a̱, a̱vu Elisha kuɗa maɗanga a̱vu u vari yi lo uba̱ta̱'a̱, a̱vu rumu vo aɓau ndolo mo 'yon zuva mini'i. <verse eid="2KI 6:6" /><verse number="7" style="v" sid="2KI 6:7" />A̱vu Elisha damma yi, &lt;&lt;Zuwa ukere adama a na va a tara.&gt;&gt; A̱vu u zuwa u kere wa yi u tara.<verse eid="2KI 6:7" /></para>
  <para style="s">Elisha reme ta̱ a̱soja a Suriya o ro</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 6:8" />Ele lo a mantsa ma na mogono ma Suriya me teme yi uvon na aza Isra'ila, a̱vu u zami a̱sa̱la̱ uba̱ta̱ u nan yali ya̱ a̱soja a̱ yi u damma, &lt;&lt; Va̱la̱ta̱ va̱ to o nda na̱ nda.&gt;&gt; <verse eid="2KI 6:8" /><verse number="9" style="v" sid="2KI 6:9" />Amma vuma va̱ A̱sula̱ lyungu ta̱ nu u dammu uba̱ta̱ mogono ma aza a Isra'ila, &lt;&lt; A ɓarasa yi she u 'ya̱wa̱ zuzu nu uba̱ta̱ u ndolo wan, adama a na aza a Suriya a̱ tu lo ufoɓu ni itana yu uvon.&gt;&gt; <verse eid="2KI 6:9" /><verse number="10" style="v" sid="2KI 6:10" />A̱vu mogono ma Isra'ila ma̱ lyungu wa ama a na a tawa utyo, adama o uba̱ta̱ u na vuma va̱ A̱sula̱'a̱ u rono niyi atsuvu'u ulobonu. Elisha tsu rono so ta̱ mogono'o atsuvu a mantsa suru.<verse eid="2KI 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 6:11" />A̱vu mogono ma Suriya ma uwa u dammu lon adama o ndolo. A̱vu u ɓoloto nan yali ya̱ a̱soja a̱ yi we ece le u damma, &lt;&lt; Damma nu mu a̱tsuma̱ a̱ɗu za ne ɗa tsu pa̱lu'wa̱sa̱ mu ekere mogono ma a Isra'ila?&gt;&gt;<verse eid="2KI 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 6:12" />A̱vu za ta̱ a̱tsuma̱ ele damma, &lt;&lt;Zagbain wuma wa wu u jima, ko za. Amma Elisha ɗa vumava̱sula̱ va Isra'ila ɗa adansa mogono ma Isra'ila adanshi a na va yuwusan, ko vu tu pe a̱tsuma̱ asula e nven u a̱ wu ɗa.&gt;&gt;<verse eid="2KI 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 6:13" />A̱vu mogono ma ca u dammu adama a na a zami uba̱ta̱ u na Elisha ri ereme yi. A̱vu a̱tsura̱ u dammu a na u ri pe a̱tsuma̱ Dotan. <verse eid="2KI 6:13" /><verse number="14" style="v" sid="2KI 6:14" />A̱vu u lyungu ni ido ni ikeke yi ido na̱ a̱soja a̱bunda̱ ɗe uba̱ta̱'a̱. A̱vu a̱ ka̱ra̱ naa ayin a̱ ka̱nda̱ruwa̱ lyuci'i.<verse eid="2KI 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 6:15" />Ana aagbashi a vuma va̱ A̱sula̱ 'yon yi wu uta̱i na̱ wasasa, reve we ene a̱soja ni ido ni ikeke yi ido i ka̱nda̱ruwa̱ lyuci'i. A̱vu za na a yuwusan Elisha a̱ga̱nda̱ aa yuwan yisali u damma, &lt;&lt;Aya, zagbain! Nye ɗa tsa yuwan gogo nda?&gt;&gt; <verse eid="2KI 6:15" /><verse number="16" style="v" sid="2KI 6:16" />A̱vu Elisha usu u damma, &lt;&lt;She vu uwwa wovon wan, adama a na a aza na a̱ ri yo oɓolo na̱ tsu, a la'a ta̱ a aza a na a̱ ri yo oɓolo na̱ le.&gt;&gt; <verse eid="2KI 6:16" /><verse number="17" style="v" sid="2KI 6:17" />A̱vu Elisha vasa uba̱ta̱ wa̱ A̱sulazuva u damma, &lt;&lt;A̱sulazuva n ta pati shi wu, lyawa a na va̱ kpa̱tu'wa̱ esu a̱yi adama a na we ene.&gt;&gt; A̱vu A̱sulazuva a̱ kpa̱tu'wa̱ e esu o ulobo u na wa yuwusan a̱ga̱nda̱'a̱, a̱vu we ene masasan ma gbain ma na ma̱ ri yu uka̱nda̱ruwu na̱ Elisha oɓolo na̱ ido na̱ ikeke yi ido ya akina.<note caller="+" style="f"><char style="fr" closed="false">6:17 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Ngo 2:11.</char></note><verse eid="2KI 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 6:18" />A mantsa ma na aa aza a Suriya a̱ zura̱i a̱ cipa̱ adama a na a̱ riya̱ yi nu uvon, a̱vu Elisha pati ya̱ A̱sulazuva u damma, &lt;&lt;A̱sulazuva lyawa vu zuwa o'o nrumba̱!&gt;&gt; A̱vu gba u usu avasa yi a̱vu u zuwa le o'o nrumba̱. <verse eid="2KI 6:18" /><verse number="19" style="v" sid="2KI 6:19" />A̱vu Elisha damma le, &lt;&lt;Uba̱ta̱ u nda ɗa ure'e shi, agba pa ɗa lyuci'i shi. Kuru nu mu adama a na ma tara ɗu a̱ tyo uba̱ta̱ u vuma na yaa zama.&gt;&gt; Adama o ndolo a̱vu u tara le a̱ tyo a̱ lyuci va Samariya.<verse eid="2KI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 6:20" />A mantsa ma a uwai a̱tsuma̱ aa Samariya, a̱vu Elisha vasa uba̱ta̱ wa̱ A̱sulazuva u damma, &lt;&lt;Lyawa a na va̱ kpa̱tu'wa̱ le esu adama a na ene.&gt;&gt; A̱vu A̱sulazuva a̱ kpa̱tu'wa̱ le esu a̱vu ene aciya le e memere ma a aza aa Samariya.<verse eid="2KI 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 6:21" />Ana mogono ma Isra'ila me ene nle a̱vu u damma Elisha, &lt;&lt;Dada va̱, mu una le? Mu una le gogo?&gt;&gt;<verse eid="2KI 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 6:22" />A̱vu Elisha damma, &lt;&lt;She vu una le wan. Cine vo una a̱soja a na vu remei uba̱ta̱ wu uvon na̱ Matsun me pe'eni na aya a̱ wu? Vu ca le ilyalya na̱ mini mo oso a na a lyuwa a̱vu o sowo, adama o ndolo a̱vu vu lyawa le a̱ ka̱ra̱ adama a na a̱ ka̱mba̱ uba̱ta̱ wu zagbain le.&gt;&gt; <verse eid="2KI 6:22" /><verse number="23" style="v" sid="2KI 6:23" />A̱vu u foɓoo le a̱buki a gbain. A mantsa ma na o kotoi alya no o sowoi, a̱vu u lyawa le a na a̱ ka̱ra̱, a̱vu a̱ ka̱ra̱ a̱ tyo uba̱ta̱ wu zagbain le. Diga a mantsa mo ndolo, aza a Suriya a̱ da̱shi 'ya̱wa̱a̱ na aza a Isra'ila nu uvon shi.<verse eid="2KI 6:23" /></para>
  <para style="s">Ben Hada ka̱nda̱ruwa̱ ta̱ lyuci va Isra'ila adama o uvon</para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 6:24" />Ele lo a̱vu Ben Hada mogono ma Suriya mo ɓoloto a̱soja a̱yi, a̱vu a̱ ka̱ra̱ a̱ tyo adama a na a̱ ka̱nda̱ruwa̱ iɗa ya Samariya adama a na a yuwan uvon na̱ yi. <verse eid="2KI 6:24" /><verse number="25" style="v" sid="2KI 6:25" />Adama a na a jima ta̱ a na a̱ ka̱nda̱ruwa̱i iɗa'a, reve ambulu a uwa a̱ ilyuci'i, hali na a winai aaci o mololi azurufa kupakunla̱, etele a muɗa waru a ta wina san le azurufa ton.<verse eid="2KI 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 6:26" />Uranu u ro mogono ma Isra'ila ma̱ da̱na̱ ta̱ a mmalu o ukari u lyuci, a̱vu ka ro saala u damma, &lt;&lt;Zagbain wuma wa wu u jima! Vu kamba mu, mogono!&gt;&gt;<verse eid="2KI 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 6:27" />A̱vu mogono ma̱ usuyi u damma, &lt;&lt;Nna̱ A̱sulazuva aa kamba wu shi, cine maa gura kamba wu? Diga o osoroto, ko diga uba̱ta̱ u kpoko u mini ma̱ ina̱bi?&gt;&gt; <verse eid="2KI 6:27" /><verse number="28" style="v" sid="2KI 6:28" />A̱vu mogono ma̱ da̱shi damma ka'a, &lt;&lt;Nye ɗa vu cigai?&gt;&gt;</para>
  <para style="p" vid="2KI 6:28">A̱vu ka'a usu u damma, &lt;&lt;Ka nda ɗa dammai tsu una mawun ma va adama a na tsa tama yi ana'an, a̱vu nu usana u tawa a̱vu tsu tama za va yi. <verse eid="2KI 6:28" /><verse number="29" style="v" sid="2KI 6:29" />Ne ɗa tsu su'wain mawun ma̱ va̱ a̱vu tsu tama. Amma a na usana u tawai a na'an n damma niyi tsu una za va̱ yi tsu tama, a̱vu u soko yi.&gt;&gt;<verse eid="2KI 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 6:30" />Ana mogono ma uwwai ne a̱vu wu kara a̱tugu a̱yi. Adama a na mogono ma̱ da̱na̱ ta̱ a mmalu o ukari u lyuci'i, a̱vu ama ene yi u oto wu na̱ a̱tugu a̱tsuma̱la̱ngu a̱ lipu va̱ yi. <verse eid="2KI 6:30" /><verse number="31" style="v" sid="2KI 6:31" />A̱vu mogono ma damma, &lt;&lt;Lyawa A̱sula̱ a ca mu oforo o usuɗu lon, n na̱ n koɗo aciya Elisha ulobo wa Shafa a na'an shi!&gt;&gt; <verse eid="2KI 6:31" /><verse number="32" style="v" sid="2KI 6:32" />A̱vu mogono ma̱ lyungu nanza a na wa̱ 'ya̱wa̱ u reme Elisha.</para>
  <para style="p" vid="2KI 6:32">Elisha gba da̱na̱ ta̱ nden a̱tsuma̱ o u'wa wa̱ yi oɓolo na̱ mbara ma Isra'ila. Amma babu malingata'a u rawa, a̱vu Elisha damma mbara'a, &lt;&lt;Ye ene ta̱ ko, za mo una ma nda ma̱ lyungu ta̱ a na a̱ ta̱wa̱ o koɗo mu aci. To, amma n na̱ malingata'a ma rawa, a̱vu i ɓa̱ru wu una̱ntsu i ɓa̱ru yi ugbamu adama a̱yi. Babu ujumu za na lyungu ni yi u to toni yu ure.&gt;&gt;<verse eid="2KI 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2KI 6:33" />Babu Elisha uɓa̱ruwu una̱ wa̱ yi, a̱vu malingata'a ma rawa a̱vu mogono ma damma, &lt;&lt;A̱sulazuva a ɗa a̱ ta̱wa̱a̱ n tsu na̱ cu'un va̱ a̱tsuma̱lima̱ a nda. Adama nye ɗa ma zuwa okolo va̱ uba̱ta̱ wa̱ A̱sulazuva waru?&gt;&gt;<verse eid="2KI 6:33" /></para>
  <chapter eid="2KI 6" />
  <chapter number="7" style="c" sid="2KI 7" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 7:1" />A̱vu Elisha usu u damma, &lt;&lt;Uwwai a adanshi A̱sulazuva, A̱sulazuva a damma &lt;Nfa'an nda a mantsa ma nda a ta wina makundatsu ma yira i lashi azurufa ta̱, na̱ waru makundatsu ma yitabo i re azurufa ta̱ o uwata wa Samariya.&gt; &gt;&gt;<verse eid="2KI 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 7:2" />A̱vu yali ya̱ a̱soja za na a kambusa mogono u damma vuma va̱ A̱sulazuva'a, &lt;&lt;Ko na̱ shi wo o A̱sulazuva a ɗa na aciya̱yi a na a̱ kpa̱tu'wa̱ na̱ntsu va zuva, ili ya nda yaa a gura fara shi ko ke'en!&gt;&gt;</para>
  <para style="p" vid="2KI 7:2">A̱vu Elisha damma yi, &lt;&lt;Vu ta ene ne esu a̱ wu, amma va lyuwa shi.&gt;&gt;<verse eid="2KI 7:2" /></para>
  <para style="s">Nkutu n 'ya̱wa̱ ta̱ a̱ va̱la̱ta̱ va aza a Suriya</para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 7:3" />A̱ da̱na̱ ta̱ na ama a̱ na̱shi, aza a na a da̱na̱i na̱ mɓa̱la̱ mu ukutu a̱ lipu, aza a na a̱ da̱na̱i lo o una̱ntsu u lyuci va Samariya. A̱vu a damma la yi aciya̱ le, &lt;&lt;Adama nye ɗa tsu ri pa e ipiri pa aa nda she nu tsu kuwa̱ pa? <verse eid="2KI 7:3" /><verse number="4" style="v" sid="2KI 7:4" />N na̱ tsu damma tsu ta uwa pe a̱tsuma̱ a̱ lyuci ambulu a ɗa a una tsu pe. Agba waru nu tsu da̱nu pa tsu ta kuwa̱. Adama o ndolo lyawa tsu 'ya̱wa̱ naa a aciya̱ tsu uba̱ta̱ wa aza a Suriya. Na̱ a lyawa tsu wuma, u ta da̱na̱ ulobonu. Na̱ waru o una tsu ta̱, wo o ta̱ a na tsa kuwa̱.&gt;&gt; <verse eid="2KI 7:4" /><verse number="5" style="v" sid="2KI 7:5" />A̱vu a̱ 'yon nu ulivu e reme ure acina uba̱ta̱ u na a̱za̱ o upasu wa Suriya a̱ da̱na̱i na̱ nde. Amma a mantsa ma na a rawai uba̱ta̱ u na aza a Suriya a̱ da̱na̱i na̱ nde'en, agba acina lo za uba̱ta̱'a̱ shi. <verse eid="2KI 7:5" /><verse number="6" style="v" sid="2KI 7:6" />A̱vu A̱sulazuva a zuwa aza a Suriya a na a uwwai ilama va damma oɓolo a̱soja a̱bunda̱ ɗa na̱ ikeke yi ido yu uvon, a̱vu a damma la yi va̱ni le, &lt;&lt;Apa nda mogono ma Isra'ila mo kopoi ngono ma aza a Hitiya na̱ aza a Masar adama a na a̱ riya̱ tsu nu uvon!&gt;&gt; <verse eid="2KI 7:6" /><verse number="7" style="v" sid="2KI 7:7" />Adama o ndolo a ɗa a sumai nu ulivu, a̱vu a lyawa lo ogodo le na̱ ido i le na̱ nloli nle. A̱vu a lyawa uva̱la̱ta̱ ununa u ri a̱vu a suma adama a wuma u le.<verse eid="2KI 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 7:8" />A mantsa ma na a̱za̱ a̱ mɓa̱la̱ mu ukutu n na̱shi ndolo'o a rawai o una̱ wu uva̱la̱ta̱, uba̱ta̱ u na a̱ da̱na̱i uva̱lu a̱vu a uwa oogodo a̱ ta̱. A̱vu a lyuwa a̱vu o sowo, a̱vu a̱ pura̱ azurufa na̱ zinariya na̱ a̱tugu, a̱vu a̱ ka̱ra̱ adama a na o soko le. A̱vu waru a̱ ka̱mba̱ a uwa a̱tsuma̱ oogodo o ro, a̱vu a̱ pura̱ itana i ro diga pe a̱tsuma̱ yi, a̱vu waru o soko le. <verse eid="2KI 7:8" /><verse number="9" style="v" sid="2KI 7:9" />Diga lo ɗaɗa a damma yi aciya̱ le, &lt;&lt;Tsu yuwan ili i na i ri yu ulobonu shi. Ana'an aa nda uranu wa a labari o uyo'o u ɗa, n na̱ tsu rungwa̱ kpen acina usana, iwuya i ta cipa̱ aciya̱ a̱ tsu. Adama o ndolo lyawa tsa 'ya̱wa̱ tsu damma ukobu u mogono.&gt;&gt;<verse eid="2KI 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 7:10" />A̱vu a̱ ta̱wa̱ o una̱ntsutsu u lyuci a̱vu e ɗe a̱za̱ e ipiri ilyuci,&lt;&lt;Tsu 'ya̱wa̱ ta̱ o uva̱la̱ta̱ wa aza a Suriya agba tsu cina pe vuma shi, ko ilama i vuma va uwwa shi, ido i ɗa na̱ nloli goon va cina wunlu, agba waru ogodo le a̱ tu lo babu pe vuma ununa a aza a Suriya a lyawa n le lo.&gt;&gt;<verse eid="2KI 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 7:11" />A̱vu a̱za̱ e ipiri yu una̱ntsu a̱ ya̱sa̱n uɗyo le aa asala, hali adanshi a rawa o ukobu u mogono. <verse eid="2KI 7:11" /><verse number="12" style="v" sid="2KI 7:12" />A̱vu mogono mo 'yon naa ayin ndolo, a̱vu u damma azagbain a̱yi, &lt;&lt;Lyawa n damma ɗu ili i na aza aa Suriya a yuwain adama a̱ tsu. E reve ta̱ naa ambulu a na a̱ ri pa tsu, adama o ndolo a̱vu a lyawa uva̱la̱ta̱ u na a̱ ri na̱ nden a uwa a̱tsuma̱ o una a pa'an, a ta majiyan, &lt;A mantsa ma na tsu u uta̱i a̱vu tsu ka̱ra̱ izami yi ilyalya, a̱vu e teme uvon na̱ tsu, a̱vu e reme tsu na̱ wuma, a̱vu a usa lyuci tsu.&gt; &gt;&gt;<verse eid="2KI 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 7:13" />A̱vu za ta̱ a̱tsuma̱ azagbain o mogono ma damma, &lt;&lt;Lyawa a na tsa lyungu ama o ton adama a na aa tara ido i na i buwai pe a̱ lyuci. Ana a̱ ka̱ra̱ adama a na a̱ka̱lyuwa̱ ili i na tsu uwwai. Adama a na na̱ ili i ro i fara na̱ ele, wo o ili yu usa̱n i ro shi a na e isawan a̱tsuma̱ a̱ lyuci oɓolo na̱ tsu, adama a na suru ntsu nden mu ukwa̱ ɗa tsa yuwusan.&gt;&gt;<verse eid="2KI 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 7:14" />A̱vu a ɗangula ama o ro, a̱vu mogono ma̱ lyungu le na̱ ikeke yi ido ejere a na 'ya̱wa̱ ka̱lyuwa̱ ili i na i farai na̱ a̱soja a Suriya. <verse eid="2KI 7:14" /><verse number="15" style="v" sid="2KI 7:15" />A̱vu ama o ndolo o toni le acina upasu wu Uɗolu wa̱ Urudu, suru a̱tsuma̱ o ure a̱vu acina a̱tugu ni itana yu uvon wo cu, a zana a aza a Suriya o ocoyi a mantsa ma na a̱ da̱na̱i a zama a na a suma. A̱vu nlingata a̱ ka̱mba̱ adama a na a ca alabari uba̱ta̱ u mogono. <verse eid="2KI 7:15" /><verse number="16" style="v" sid="2KI 7:16" />A̱vu ama e iɗa ya Samariya o uta̱ ni ilaɗi, a̱vu a̱ ka̱ra̱ a̱ tyo o uva̱la̱ta̱ wa aza a Suriya a̱vu a̱ pura̱ itana. A̱vu a wina makundatsu ma yira i lashi azurufa ta̱, na̱ waru makundatsu ma yira i yitabo i re azurufa ta̱, cine A̱sulazuva a dammai.<verse eid="2KI 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 7:17" />A̱vu mogono ma zuwa yali ya̱ a̱soja kambi va̱ yi, a̱vu a zuwa yi a na wa piri yu una̱ntsu u lyuci'i. Adama a̱bunda̱ a ama a na a ɓoloto yi lo o una̱ntsu u lyuci, a̱vu e keɓe yi u riya̱ a̱vu aa a dadasa yi hali u kuwa̱, cine Elisha vuma va A̱sulazuva damma yi a mantsa ma na mogono ma̱ 'ya̱wa̱i adama a na we ene yi. <verse eid="2KI 7:17" /><verse number="18" style="v" sid="2KI 7:18" />A̱vu gba wo o'wo cine vuma va A̱sula̱ dammai mogono, &lt;&lt;A na acina a mantsa ma nda nfa'an, a ta wina makundatsu ma yira i lashi azurufa ta̱, na̱ waru makundatsu ma yitabo i re i azurufa ta̱ o uwata wa Samariya.&gt;&gt;<verse eid="2KI 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 7:19" />A̱vu yali ya̱ a̱soja'a usu vuma va̱ A̱sula̱ u damma, &lt;&lt;N na̱ A̱sulazuva a ta̱ kpa̱tu'wa̱ na̱ntsutsu va zuva, iliya o ndolo ya fara shi ko ke'en!&gt;&gt; A̱vu Elisha damma, &lt;&lt;Vu ta ene ne esu a̱ wu, amma va lyuwa shi!&gt;&gt; <verse eid="2KI 7:19" /><verse number="20" style="v" sid="2KI 7:20" />Ne ɗa ili yo ndolo i farai na̱ yi, a̱vu ama a dadasa yi lo o uwata u lyuci'i, hali u kuwa̱.<verse eid="2KI 7:20" /></para>
  <chapter eid="2KI 7" />
  <chapter number="8" style="c" sid="2KI 8" />
  <para style="s">Elisha da̱shi ta̱ kamba ka va Shunem</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 8:1" />Elisha damma ta̱ ka na u ka̱mbuwa̱ yi ulobo wa̱ yi wuma a na, &lt;&lt;'Yon a̱vu na̱ limatan va̱ wu a̱ tyo uba̱ta̱ u na vu tsura̱i biti, adama a na A̱sulazuva a̱ ta̱ ta̱wa̱ na ambulu a̱tsuma̱ e iɗa hali a'wan e cindere.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Ngo 4:8-37.</char></note> <verse eid="2KI 8:1" /><verse number="2" style="v" sid="2KI 8:2" />A̱vu ka'a u yuwan cine vuma va̱ A̱sulazuva damma niyi. A̱vu u ka̱ra̱ oɓolo na̱ limatan va̱ yi suru a̱ tyo e iɗa ya Filistiya a̱vu a̱ da̱nu ɗe hali a'wan e cindere.<verse eid="2KI 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 8:3" />Ana a yuwain a'wan a cindere, a̱vu ka'a u ka̱mba̱ diga e iɗa ya Filistiya. A̱vu u 'ya̱wa̱ uba̱ta̱ mogono na̱ mesun adama a na a̱ ka̱mbuwa̱ yi nu u'wa wa̱ yi nu uɗuma̱ wa̱ yi. <verse eid="2KI 8:3" /><verse number="4" style="v" sid="2KI 8:4" />A mantsa'a mogono ma yuwusan ta̱ adanshi na̱ Gehazi, aagbashi a vuma va̱ A̱sula̱, a̱vu u damma, &lt;&lt;Damma mu ili ya asalama a na Elisha yuwain suru.&gt;&gt; <verse eid="2KI 8:4" /><verse number="5" style="v" sid="2KI 8:5" />A mantsa ma na waa dansaa mogono ununa Elisha 'ya̱sa̱in a̱kwa̱kwa̱, a̱vu ka na Elisha ka̱mbuwa̱i ulobo wa̱ yi wuma rawa shi u ta̱wa̱ uba̱ta̱ mogono, na̱ mesun a na a̱ ka̱mbuwa̱ yi nu u'wa wa̱ yi nu uɗuma̱ wa̱ yi. A̱vu Gehazi usu, &lt;&lt;Zagbain va̱ mogono, apa ka nu ulobo wa̱ yi a na Elisha ka̱mbuwa̱ yi wuma'a!&gt;&gt; <verse eid="2KI 8:5" /><verse number="6" style="v" sid="2KI 8:6" />Ana mogono me ecei ka'a, a̱vu ka'a u cuɗuwa yi.</para>
  <para style="p" vid="2KI 8:6">A̱vu mogono ma zuwa za ta̱ a̱tsuma̱ azagbain a yuwan adanshi adama adanshi'i a̱vu u damma yi, &lt;&lt;I ka̱mbuwa̱ ka'a suru ili i na i ri za va̱ yi, oɓolo na̱ itana yu uɗuma̱ wa̱ yi suru, diga urana u na u lyawai iɗa'a hali a̱ tyo urana u na u ka̱mba̱i.&gt;&gt;<verse eid="2KI 8:6" /></para>
  <para style="s">Haziyel una ta̱ Ben Hada</para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 8:7" />&lt;&lt;A̱vu Elisha ka̱ra̱ a̱ tyo Dimaska a mantsa ma na mogono Ben Hada va Suriya da̱na̱i babu lafiya. A̱vu nanza damma Ben Hada mogono, Elisha vuma va̱ A̱sula̱ ta̱wa̱ ta̱ pa a̱tsuma̱ a̱ lyuci nda,&gt;&gt; <verse eid="2KI 8:7" /><verse number="8" style="v" sid="2KI 8:8" />a̱vu mogono ma damma Hazayel a na, &lt;&lt;Vu tara une'e vu 'ya̱wa̱a̱ uba̱ta̱ u vuma va A̱sula̱. Vu damma yi u patiya mu A̱sulazuva, &lt;Ko n ta̱ tsura̱ lafiya diga a̱ mɓa̱la̱ nda?&gt; &gt;&gt; <verse eid="2KI 8:8" /><verse number="9" style="v" sid="2KI 8:9" />A̱vu Hazayel ka̱ra̱ a̱ tyo uba̱ta̱ wa̱ Elisha oɓolo na̱ ne'e icu'un icu'un diga Dimaska, aza a na arakumi amunga a tanuyi. Ana u rawai wi isawain elime a̱ Elisha a̱vu u damma, &lt;&lt;Ulobo wa̱ wu Ben Hada mogono ma Suriya ma ɗa ma̱a̱ lyungu numu uba̱ta̱ wa̱ wu, adama a na u ciga ta̱ wu uwwa, ko u ta̱ ka̱mba̱ gbaga o ubanakun u na n ri na̱ yi?&gt;&gt;<verse eid="2KI 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 8:10" />A̱vu Elisha damma, &lt;&lt;Ka̱ra̱ vu damma yi u ta̱ tsura̱ lafiya, amma A̱sulazuva o roco mu ta̱ na amayun u ta̱ kuwa̱.&gt;&gt; <verse eid="2KI 8:10" /><verse number="11" style="v" sid="2KI 8:11" />A̱vu Elisha varaa Hazayel esu hali she na Hazayel uwwai wono. Adama o ndolo a̱vu Elisha ɓosho na̱ mesun.<verse eid="2KI 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 8:12" />A̱vu Hazayel ece yi, &lt;&lt;Nye i zuwai zagbain va̱ ri a̱ mesun?&gt;&gt;</para>
  <para style="p" vid="2KI 8:12">A̱vu Elisha damma, &lt;&lt;Adama a na n reve ta̱ iwuya i na vaa yuwaan ama a Isra'ila. Vu ta̱ kula̱to ɓaɓu vu ucira le na akina, a̱vu vu una olobo e le na̱ matsun me pe'eni, waru vu to o ɓoso aci muwun n keke'en n le e iɗa, a̱vu vu ɗa̱ra̱ a̱ma̱ci e le a na a̱ ri na̱ a̱tsuma̱.&gt;&gt;<verse eid="2KI 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 8:13" />A̱vu Hazayel damma, &lt;&lt;Cine a̱mu aagbashi a̱ wu ma gura yuwan a̱ba̱jini e ili tsu nda, a̱mu na n ri musa̱n me pere?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">8:13 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 19:15.</char></note></para>
  <para style="p" vid="2KI 8:13">A̱vu Elisha damma yi, &lt;&lt;A̱sulazuva o roco mu ta̱ a na voo o'wo mogono ma Suriya.&gt;&gt;<verse eid="2KI 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 8:14" />A̱vu Hazayel lyawa Elisha a̱vu u ka̱mba̱ uba̱ta̱ wu zagbain va̱ yi. Ana Ben Hada ece niyi, &lt;&lt;Nye ɗa Elisha damma nuwu?&gt;&gt;</para>
  <para style="p" vid="2KI 8:14">A̱vu Hazayel damma, &lt;&lt;Elisha damma amayun ɗa vu ta̱ tsura̱ lafiya.&gt;&gt; <verse eid="2KI 8:14" /><verse number="15" style="v" sid="2KI 8:15" />Amma a na usana u tawai, a̱vu Hazayel tara umuna wu ugba̱mu u tsupu yi a̱tsuma̱ a̱ mini a̱vu wu pala o urewesu u mogono, hali u kuwa̱. Na̱ ne ɗa Hazayel wo o'woi mogono o una̱ wa̱ yi.<verse eid="2KI 8:15" /></para>
  <para style="s">Yehoram mogono ma Yahuda</para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 8:16" />A̱tsuma̱ a'wan a tawun o tsugono tsa mogono Jehoram ulobo wa Ahabu va Isra'ila, a na Jehoshafa da̱na̱i mogono ma Yahuda, ɗaɗa Yowash ulobo wa Jehoshafa me temei tsugono a̱tsuma̱ a Yahuda. <verse eid="2KI 8:16" /><verse number="17" style="v" sid="2KI 8:17" />Yehoram da̱na̱ ta̱ na a'wan mata'atsu ne ejere a mantsa ma na wo o'woi mogono, a̱vu waru u yuwan tsugono tsa a Urishelima a'wan kula̱. <verse eid="2KI 8:17" /><verse number="18" style="v" sid="2KI 8:18" />U toni ta̱ a hali o ngono ma Isra'ila, cine u'wa wa Ahabu yuwain, adama a na u zuwa ta̱ usheli wa Ahabu. U yuwan ta̱ ili i iwuya a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva. <verse eid="2KI 8:18" /><verse number="19" style="v" sid="2KI 8:19" />Amma na̱ ne suru A̱sulazuva o kototo iɗa ya Yahuda shi adama aagbashi a̱ yi Da̱wuda, adama a na u yuwan ta̱ nzuwulai a na waa ca yi ekan nu ugundo wa̱ yi babu ukotu.<note caller="+" style="f"><char style="fr" closed="false">8:19 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 11:36.</char></note><verse eid="2KI 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 8:20" />A mantsa ma na mogono Yehoram ma̱ da̱na̱i o tsugono e iɗa ya Yahuda, reve a ama a Edom a̱ 'ya̱sa̱yin aci, ɗaɗa a katala yi aciya̱ le mogono.<note caller="+" style="f"><char style="fr" closed="false">8:20 </char><char style="ft" closed="false">Ka̱lyuwa̱: Ufr 27:40.</char></note> <verse eid="2KI 8:20" /><verse number="21" style="v" sid="2KI 8:21" />Adama o ndolo a̱vu Joram ka̱ra̱ a̱ tyo Zayi ni ikeke yi ido ya̱ yi suru. A̱vu a̱soja Edom a̱ ka̱nda̱ruwa̱ yi oɓolo na̱ nan yali yi ikeke yi ido ya̱ yi, amma na ayin u tsura̱ ta̱ ure u na wu uta̱i, a̱vu a̱soja a̱ yi a suma a̱ tyo a 'wa le. <verse eid="2KI 8:21" /><verse number="22" style="v" sid="2KI 8:22" />Hali a cina ana'an Edom ri na̱ nden ma a lafiya na̱ Yahuza shi. A̱tsuma̱ a mantsa'a aza a Libina a̱ 'ya̱sa̱a̱n ta̱ aza a Yahuza aci.<verse eid="2KI 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 8:23" />Akapi o ulinga u na Joram yuwain suru a̱ da̱na̱ ta̱ pe uɗanu a̱tsuma̱ aatagada a labari o ngono ma aza a Yahuda. <verse eid="2KI 8:23" /><verse number="24" style="v" sid="2KI 8:24" />A̱vu Joram kuwa̱ ucina nkaya ma̱ yi a̱vu a̱ ciɗo yi a̱tsuma̱ a̱ lyuci va̱ Da̱wuda. A̱vu ulobo wa̱ yi Ahaziya wo o'wo mogono o una̱ wa̱ yi.<verse eid="2KI 8:24" /></para>
  <para style="s">Ahaziya yuwan ta̱ tsugono tsa aza a Yahuda</para>
  <para style="r">(<ref loc="2CH 22:1-6">2 Alb 22:1-6</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 8:25" />A̱tsuma̱ a'wan kupa ne ejere o tsugono tsa̱ Jehoram ulobo wa Ahabu mogono ma Isra'ila, Ahaziya ulobo u mogono Yowash mogono ma Yahuda ma lyuwa ta̱ tsugono. <verse eid="2KI 8:25" /><verse number="26" style="v" sid="2KI 8:26" />Ahaziya da̱na̱ ta̱ na a a'wan ushin ne ejere a mantsa ma na wo o'woi mogono, a̱vu u yuwan tsugono tsa Urishelima aa'wan a̱ ta̱. Aala a mma va̱ yi a ɗa Ataliya, mawun ma tsukaya mo mogono Omri va Isra'ila. <verse eid="2KI 8:26" /><verse number="27" style="v" sid="2KI 8:27" />U toni ta̱ a hali o u'wa wa Ahabu. A̱vu u yuwan ili iwuya a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva cine u'wa wa Ahabu u yuwain, adama a na a̱yi toto vu u'wa ɗaɗa.<verse eid="2KI 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 8:28" />A̱vu Ahaziya 'ya̱wa̱ oɓolo na̱ Yoram ulobo wa Ahabu tsa̱ra̱ a yuwan uvon na̱ Hazayel, mogono ma Suriya a̱tsuma̱ a Ramot Giliyadu. A̱vu gba aza a Suriya a uwwato Jehoram usa̱n. <verse eid="2KI 8:28" /><verse number="29" style="v" sid="2KI 8:29" />A̱vu mogono Jehoram ka̱mba̱ a̱tsuma̱ e iɗa ya Yezireyel, adama u yuwan opocino a̱ wuntsu u na u tsura̱i diga e ekere aza a Suriya ɗe Rama, a na a̱ da̱na̱i a yuwusan uvon na̱ Hazayel mogono ma Suriya.</para>
  <para style="p" vid="2KI 8:29">A̱vu Ahaziya ulobo wa Yowash mogono ma a Yahuda 'ya̱wa̱ u ka̱lyuwa̱ Jehoram ulobo wa Ahabu, a̱tsuma̱ Yezireyel adama a na u da̱na̱i nu usa̱n.<verse eid="2KI 8:29" /></para>
  <chapter eid="2KI 8" />
  <chapter number="9" style="c" sid="2KI 9" />
  <para style="s">A katala ta̱ Yehu mogono ma Isra'ila</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 9:1" />A̱vu Vumava̱sula̱ Elisha ɗe vuma ta̱ diga oɓolo agbashi ama̱sula̱ a̱vu u damma yi, &lt;&lt;Vu foɓo a̱vu vu nla̱ gbakala, vu tara medele ma mani'in, a̱vu vu ka̱ra̱ a̱ tyo Ramot Giliyadu. <verse eid="2KI 9:1" /><verse number="2" style="v" sid="2KI 9:2" />A mantsa ma na vu rawai ɗe, a̱vu vu zami Yehu ulobo wa Jehoshafa ulobo wa̱ Nimishi. A̱vu vu zuwa yi u 'yon u lyawa a̱za̱ a̱ yi a̱vu i uwa a̱tsuma̱ a aasula. <verse eid="2KI 9:2" /><verse number="3" style="v" sid="2KI 9:3" />A̱vu vu tara medele ma mani'i'in vu tsuwa̱n yi a aaci vu damma, &lt;Apa ili i na A̱sulazuva a damma yi, n tsuwa̱n wu ta̱ mani'in vo o'wo mogono ma aza a Isra'ila.&gt; Reve vu kpa̱tu'wa̱ una̱ntsu vu suma, she vu lungusa̱ mantsa wan!&gt;&gt;<verse eid="2KI 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 9:4" />A̱vu ulobo u ndolo, za na ri vumava̱sula̱, ka̱ra̱ a̱ tyo Ramot Giliyadu. <verse eid="2KI 9:4" /><verse number="5" style="v" sid="2KI 9:5" />Ana u rawai a̱vu u cina oɓolo a nan yali ya̱ a̱soja e iɓolo. A̱vu u damma, &lt;&lt;N ta̱ ni ikaka adama a̱ wu, yali ya a̱soja,&gt;&gt;</para>
  <para style="p" vid="2KI 9:5">A̱vu Yehu usu u damma, &lt;&lt;Ikaka'a gba za va zane ɗa a̱tsuma̱ a̱ tsu?&gt;&gt;</para>
  <para style="p" vid="2KI 9:5">A̱vu u usu &lt;&lt;A̱ ta̱wa̱ uba̱ta̱ wa̱ wu u ɗa yali zagbain.&gt;&gt; <verse eid="2KI 9:5" /><verse number="6" style="v" sid="2KI 9:6" />A̱vu Yehu 'yon a̱vu a uwa a̱tsuma̱ aasula. Reve u tsuwa̱a̱n Yehu mani'in a aaci u damma yi, &lt;&lt;Apa ili i na A̱sulazuva A̱sula̱ a Isra'ila a dammai,&lt;N tsuwa̱n wu ta̱ mani'in vo o'wo mogono ma aza a Isra'ila.<note caller="+" style="f"><char style="fr" closed="false">9:6 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 19:16.</char></note> <verse eid="2KI 9:6" /><verse number="7" style="v" sid="2KI 9:7" />Vu to kototo u'wa wa Ahabu zagbain va̱ wu, adama n tsupa e ekere a Yezebel mpasa ma agbashi a̱ va̱ ama̱sula̱, na̱ mpasa ma ama A̱sulazuva agbashi a̱ va̱. <verse eid="2KI 9:7" /><verse number="8" style="v" sid="2KI 9:8" />N to kototo u'wa wa Ahabu suru. N ta̱ o una ulobo wa Ahabu suru ko aagbashi a ɗa ko aagbashi a ɗa shi, a̱tsuma̱ a Isra'ila. <verse eid="2KI 9:8" /><verse number="9" style="v" sid="2KI 9:9" />N ta zuwa u'wa wa Ahabu wo o'wo tsu u'wa wa Yerobowam ulobo wa Neba na̱ waru tsu u'wa wa Basha ulobo wa Ahija. <verse eid="2KI 9:9" /><verse number="10" style="v" sid="2KI 9:10" />Musa̱n n ɗa ma tama lipu va̱ Yezebel a̱tsuma̱ o upasu wi iɗa ya Yezireyel, a̱a̱ tsura̱ za na a̱ ciɗo yi shi,&gt; &gt;&gt; A̱vu u kpa̱tu'wa̱ una̱ntsu a̱vu wu uta̱ u suma.<verse eid="2KI 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 9:11" />A mantsa ma na Yehu uta̱i a̱ tyo uba̱ta̱ u nan yali ya̱ a̱soja, a̱vu e ece yi, &lt;&lt;Lafiya ɗa gba? Nye ɗa i ta̱wa̱ to yi ajarata ndolo na u ta̱wa̱i ya̱'a̱ wu?&gt;&gt;</para>
  <para style="p" vid="2KI 9:11">Reve Yehu usu le, &lt;&lt;A̱ɗu i gura ta̱ reve cu'un vuma ndolo na̱ cu'un va adanshi a̱ yi.&gt;&gt;<verse eid="2KI 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 9:12" />A̱vu a damma yi, &lt;&lt;Epen a ɗa vaa yuwusan!&gt;&gt; &lt;&lt;Damma tsu ili i na u damma nuwu!&gt;&gt;</para>
  <para style="p" vid="2KI 9:12">A̱vu Yehu damma le, &lt;&lt;Nda ili i na A̱sulazuva a dammai, n tsuwa̱n wu ta̱ mani'in vo o'wo mogono ma aza a Isra'ila.&gt;&gt;<verse eid="2KI 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 9:13" />A̱vu o foɗo a̱tugu a tsugbain tsa e le a̱vu o polo le e iɗa adama a na Yehu a wala ɗe zuva le. A̱vu e ivula̱ avana na a saali&lt;&lt;Yehu ɗa mogono!&gt;&gt;<verse eid="2KI 9:13" /></para>
  <para style="s">Yehu una ta̱ Yoram na̱ Ahaziya</para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 9:14" />Ɗaɗa Yehu ulobo wa Jehoshafa ulobo wa Nimishi yuwain ifoɓi cine o una mogono Jehoram. A mantsa mo ndolo Jehoram na aza a Isra'ila suru a̱ da̱na̱ ta̱ ɗe Ramot Giliyadu a yuwusan ipiri yi iɗa'a, adama she Hazayel mogono ma Suriya ma̱ riya̱ yi nu uvon wan. <verse eid="2KI 9:14" /><verse number="15" style="v" sid="2KI 9:15" />Amma Jehoram mogono u ka̱mba̱ ta̱ ɗe Yezireyel adama u yuwan opocino a antsu a na aza a Suriya amaton niyi uba̱ta̱ wu uvon u na a yuwain na̱ Hazayel mogono ma Suriya. A̱vu Yehu damma, &lt;&lt;Nna̱ tsunda tsa ɗa i cigai, she i lyawa nanza wu uta̱ a̱ lyuci a̱vu u 'ya̱wa̱ u ca ucuɗuwu u nda ɗe Yezireyel wan. &gt;&gt; <verse eid="2KI 9:15" /><verse number="16" style="v" sid="2KI 9:16" />A̱vu Yehu kumba ikeke yi ido ya̱ yi a̱vu u ka̱ra̱ a̱ tyo Yezireyel, uba̱ta̱ u na Jehoram da̱na̱i e ivuwusan, Ahaziya mogono ma Yahuda ma̱ ka̱ra̱ ta̱ a̱ 'ya̱wa̱ ɗe adama u ca̱sa̱ yi.<verse eid="2KI 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 9:17" />Ana za na a yuwusan ipiri i lyuci zuva va atsura vu ukari wa Yezireyel, we enei Yehu na̱ a̱soja a̱ yi a̱ ta̱wa̱, a̱vu u ya̱sa̱n uɗyo u damma &lt;&lt;Apa a̱soja a̱ ta̱wa̱.&gt;&gt;</para>
  <para style="p" vid="2KI 9:17">A̱vu mogono Jehoram damma, &lt;&lt;A̱ lyungu nanza za na tsu kumba ido a na wa̱ 'ya̱wa̱ we ece le, &lt;lafiya ɗa? &gt; &gt;&gt; <verse eid="2KI 9:17" /><verse number="18" style="v" sid="2KI 9:18" />Za na kumbai do a̱vu u ka̱ra̱ a̱ tyo ya Yehu a̱vu u damma yi, &lt;&lt;Mogono ma damma ta̱, &lt;U ta̱ wu wa̱ wu lafiya ɗa gba?&gt; &gt;&gt;</para>
  <para style="p" vid="2KI 9:18">A̱vu Yehu usu yi u damma, &lt;&lt;A̱ te ɗa i mini ma̱ wu ko lafiya ɗa? Ka̱mba̱ a̱ca̱pa̱ vu kuru mu.&gt;&gt;</para>
  <para style="p" vid="2KI 9:18">A̱vu za na aa yuwusan ipiri'i u damma, &lt;&lt;Za na a̱ lyunguyi a̱ tyo uba̱ta̱ wa ama ndolo u rawa ta̱, amma u ka̱mba̱ shi.&gt;&gt;<verse eid="2KI 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 9:19" />A̱vu mogono ma̱ da̱shi lyungu nanza wa̱ ire za na tsu kumbusa ido adama a na wa̱ 'ya̱wa̱. Ana u rawai ya̱ a̱ le a̱vu damma, &lt;&lt;Apa ili i na Mogono ma dammai, &lt;Lafiya ɗa?&gt; &gt;&gt;</para>
  <para style="p" vid="2KI 9:19">A̱vu Yehu dammisa, &lt;&lt;A̱ te ɗa i mini ma̱ wu ko lafiya ɗa? Ka̱mba̱ a̱ca̱pa̱ vu kuru mu.&gt;&gt;<verse eid="2KI 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 9:20" />A̱vu za na aa yuwusan ipiri i lyuci'i u da̱shi damma, &lt;&lt;U rawa ta̱ ye'e ele, agba a̱ yi fo u ka̱mba̱ shi. Zagbain le gba ta a mmalu ununa vu revei Yehu ulobo wa Nimishi, adama a na ilaɗi yi ido ya̱ yi i ta̱ ununa vu revei ajarata.&gt;&gt;<verse eid="2KI 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 9:21" />A̱vu Jehoram mogono u ca u dammu, &lt;&lt;Foɓo nu mu ikeke yi ido i va̱,&gt;&gt; Ana a foɓo ni yi, a̱vu Joram mogono ma Isra'ila na̱ Ahaziya mogono Yahuda o uta̱, za suru e ikeke vi ido ya̱ yi, adama a na aa ga'an na̱ Yehu. A̱vu waru gba a ga'an na̱ yi ɗe atsusa a Nabot vuma va Yezireyel. <verse eid="2KI 9:21" /><verse number="22" style="v" sid="2KI 9:22" />Ana Jehoram ene yi Yehu a̱vu we ece yi, &lt;&lt;Yehu lafiya ɗa vu ta̱wa̱i pa?&gt;&gt;</para>
  <para style="p" vid="2KI 9:22">A̱vu Yehu usu yi u damma, &lt;&lt;Cine tsu ɗa wo o'wo lafiya,&gt;&gt; &lt;&lt;Ana wo o'woi ama suru a̱tsuma̱ a nɗa o o'woi a yuwusan tsipere na̱ nkunu na̱ a̱ga̱nda̱ a̱ tyo wu uba̱ta̱ u musula̱ ma mma va wu Yezebel.&gt;&gt;<verse eid="2KI 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 9:23" />A̱vu Jehoram vadala ido ya̱ yi a̱vu u suma wa aa adansa Ahaziya, &lt;&lt;A̱ yi nda ifoɓi i ɗa, Ahaziya!&gt;&gt; <verse eid="2KI 9:23" /><verse number="24" style="v" sid="2KI 9:24" />A̱vu Yehu rono utan wa̱ yi a̱vu u lyawa yi a̱vu u tawan Jehoram e memere maa avangaci ma̱ yi. A̱vu liya uwa acina okolo a̱ yi a̱vu Jehoram riya̱ a̱tsuma̱ keke vi ido ya̱ yi. <verse eid="2KI 9:24" /><verse number="25" style="v" sid="2KI 9:25" />A̱vu Yehu damma Bidika, za na a yuwusan yi a̱ga̱nda̱, &lt;&lt;Vu uta̱a̱ lipu va̱ yi a na va vari yi a̱tsuma̱ atsusa a Nabot vuma va Yezireyel. Ko vu ta cuwan nu uranu u na tsu da̱na̱i a mmalu e ikeke yi ido na̱ dada va yi Ahabu, a na A̱sulazuva a yuwain adanshi adama yi. <verse eid="2KI 9:25" /><verse number="26" style="v" sid="2KI 9:26" />&lt;Yon da me ene ta̱ mpasa ma Nabot na̱ mpasa mo o olobo a̱ yi, a̱mu A̱sulazuva, Adama o ndolo vu ta tsupa yi pa e iɗa i nda, A̱sulazuva a dammai.&gt; Tara yi a̱vu vu va ri yi pe a̱tsuma̱ atsusa a nda, ununa adanshi A̱sulazuva a dammai.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:26 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 21:19.</char></note><verse eid="2KI 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 9:27" />Ana Ahaziya mogono ma Yahuda me enei ne, a̱vu u suma o ure a̱ tyo Bet Haga. A̱vu Yehu toni yi u sala u damma, &lt;&lt;Una niyi fo!&gt;&gt; A̱vu a amaton yi e ikeke yi ido ya̱ yi a mantsa ma na u ri a̱ tyo Gur za na ri zuzu na̱ Ibileyam, amma a̱vu u la'a u suma a̱ tyo Megido ɗe ɗa u kuwa̱i. <verse eid="2KI 9:27" /><verse number="28" style="v" sid="2KI 9:28" />A̱vu agbashi a̱ yi a tara yi a̱tsuma̱ e ikeke yi ido a̱ tyo Urishelima, a̱vu a̱ ciɗo yi a̱tsuma̱ o oso a̱ yi oɓolo na̱ nkaya ma̱ yi a̱tsuma̱ lyuci va Da̱wuda.<verse eid="2KI 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 9:29" />A̱tsuma̱ a aa'wan kupa na̱ za ta̱ o tsugono tsa Jehoram mogono ulobo wa Ahabu, a̱vu Ahaziya teme tsugono tsa a Yahuda.<verse eid="2KI 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 9:30" />A mantsa ma na Yezebel uwwai a na Yehu ta̱wa̱ ta̱ Yezireyel, a̱vu u yuwan yisukumishi o urewesu wa̱ yi, a̱vu u lapula a̱nji aaci a̱ yi a̱vu wi idana yi nu usowoto wu upepu. <verse eid="2KI 9:30" /><verse number="31" style="v" sid="2KI 9:31" />A mantsa ma na Yehu rawai uba̱ta̱ wu una̱ntsu u na wa uwa, a̱vu Yezebel ya̱sa̱n uɗyo wa yi a̱vu u damma yi &lt;&lt;A̱vu za na tsu una zagbain va̱ yi, tsa Zimri, lafiya ɗa vu ta̱wa̱i?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:31 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 16:8-12.</char></note><verse eid="2KI 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 9:32" />A̱vu Yehu ya̱sa̱n esu a̱ yi zuva a̱vu we enei, a̱vu u damma, &lt;&lt;Zane ɗa ri upasu u va̱? Zane ɗa?&gt;&gt; A̱vu mbara n re ko ama ta'atsu a̱vu o roco aciya le ya̱ a̱ yi. <verse eid="2KI 9:32" /><verse number="33" style="v" sid="2KI 9:33" />A̱vu Yehu damma le, &lt;&lt;Vari ni yi e iɗa!&gt;&gt; A̱vu a vari yi nu usowoto wu upepu a̱ tyo e iɗa, a̱vu Yehu zuwa ido ya̱ yi a dasa mpasa ma̱ yi.<verse eid="2KI 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 9:34" />A̱vu Yehu cu'wan o u'wa u mogono u lyuwa ilyalya u sowo. Ana a yuwain ne a̱vu u damma, &lt;&lt;Tara yi ka ndolo za naa a yuwayin una̱, adama a na ya̱ ciɗo yi, adama a na a̱ yi usheli u mogono u ɗa.&gt;&gt; <verse eid="2KI 9:34" /><verse number="35" style="v" sid="2KI 9:35" />Amma ama a na a̱ 'ya̱wa̱i a̱ ciɗo yi, agba acina lipu va yi shi she Ookoluwo goon na̱ etele ana na̱ ekere a̱ yi. <verse eid="2KI 9:35" /><verse number="36" style="v" sid="2KI 9:36" />Avu a̱ ka̱mba̱ a damma Yehu, za na dammai, &lt;&lt;Apa adanshi a̱ A̱sulazuva na u dammai o una̱ wa aagbashi a̱ yi Iliya vuma va Tishibe, uba̱ta̱ wu upasu wa Yezireyel musa̱n ɗa ma tama lipu va Yezebel.<note caller="+" style="f"><char style="fr" closed="false">9:36 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 21:23.</char></note> <verse eid="2KI 9:36" /><verse number="37" style="v" sid="2KI 9:37" />Lipu va̱ Yezebel to o'wo tsa̱ a̱ everi, e iɗa ya Yezireyel, hali na babu za na a gura damma, &lt;Yezebel ɗa gba.&gt; &gt;&gt;<verse eid="2KI 9:37" /></para>
  <chapter eid="2KI 9" />
  <chapter number="10" style="c" sid="2KI 10" />
  <para style="s">O kototo ta̱ u'wa wa Ahabu</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 10:1" />Ahabu da̱na̱ ta̱ no olobo kupocindere aza a na a̱ da̱na̱i nden a̱tsuma̱ a Samariya. A̱vu Yehu ɗana mepepelime a̱vu u lyungu a̱ tyo Samariya a̱ 'ya̱wa̱a̱ azagbain e iɗa ya Yezireyel, a̱ tyo we mbara, na̱ waru aza a na a idanusan olobo a Ahabu. A̱vu u damma le,<verse eid="2KI 10:1" /></para>
  <para style="b" />
  <para style="pi">
    <verse number="2" style="v" sid="2KI 10:2" />&lt;&lt; A mantsa ma na mepepelime ma nda ma rawai o ukere u ɗu biti, a na wo woi olobo a zagbain ɗu o to oɓolo na̱ a̱ ɗu agba i ta̱ na̱ ikeke yi ido ni ido, na̱ lyuci naa ri nu ukari oɓolo na̱ itana yu uvon, <verse eid="2KI 10:2" /><verse number="3" style="v" sid="2KI 10:3" />a̱vu i ɗangula za na la'ai a̱ɓula̱ a̱tsuma̱ olobo a zagbain ɗu a̱vu i katala yi okokolo ootogu a dada va̱ yi. Adama o ndolo a̱vu i yuwan uvon adama o u'wa u mogono ma̱ ɗu.&gt;&gt;<verse eid="2KI 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 10:4" />Amma a̱vu wovon u reme le lon, a̱vu a damma, &lt;&lt;N na̱ n ngono n re n gurai shi, cine tsu ɗa a̱ tsu tsa gura na̱ yi?&gt;&gt; <verse eid="2KI 10:4" /><verse number="5" style="v" sid="2KI 10:5" />Adama o ndolo a̱vu azagbain o u'wa u mogono, na̱ nan gwamna a̱ lyuci'i, na̱ mbara na̱ aza naa a tsu idanusan olobo o mogono a̱vu oɓoloto adama a na a̱ lyunguwa̱ Yehu ni ikaka a̱vu a damma, &lt;&lt;A̱tsu agbashi a̱ wu ɗa. Tsu ta yuwan ili i na vu damma n tsu tsu yuwan suru. Tsa katala nanza mogono shi, vu yuwan suru ili i na ve enei u lobono nu wu.&gt;&gt;<verse eid="2KI 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 10:6" />A̱vu Yehu ɗanaa le mepepelime me ire u damma, &lt;&lt;N na̱ i ta yuwusan tsutoni na̱ a̱mu, waru i ta toni mu, a̱vu i ta̱wa̱ mu naa aci olobo a zagbain ɗu, a̱vu i ta̱wa̱ mu na̱ le ɗe Yezireyel acina mantsa ma nda nfa'an.&gt;&gt;</para>
  <para style="b" vid="2KI 10:6" />
  <para style="p" vid="2KI 10:6">Olobo o mogono kupocindere, a̱ da̱na̱ ta̱ oɓolo na azagbain a̱ lyuci'i a̱ ɓa̱na̱sa̱ le. <verse eid="2KI 10:6" /><verse number="7" style="v" sid="2KI 10:7" />A mantsa ma na mepepelime'e ma rawai o ukere u le, a̱vu e reme olobo o mogono kupocindere'e a̱vu a paɗa le, a̱vu o koɗo aciya le a̱ tsu le a̱tsuma̱ asaka a̱vu a̱ lyungu na̱ le a̱ tyo ya̱ Yehu a̱tsuma̱ a̱ Yezireyel.<verse eid="2KI 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 10:8" />Ana malingata ma̱ ta̱wa̱i ma damma yi Yehu a̱ tu ɗe a̱ ta̱wa̱yi na aci olobo o mogono, a̱vu u damma, &lt;&lt;Izuwa le oɓolo e re lo elime o una̱ntsu u lyuci, i lyawa le lo she nfa'an nu usana.&gt;&gt; <verse eid="2KI 10:8" /><verse number="9" style="v" sid="2KI 10:9" />Nu usana reve Yehu uta̱ alanga. A̱vu wi isawan elime a ama a̱vu u damma, &lt;&lt;A̱ɗu ozo o unusu ɗa shi. A̱mu ɗa za na yuwain ifoɓi yi iwiya aciya zagbain ɗu a̱vu mu unai, amma nan za ne ɗa o unai suru aza a nda? <verse eid="2KI 10:9" /><verse number="10" style="v" sid="2KI 10:10" />I gura ta̱ reve na adanshi a na A̱sulazuva a yuwain adama o u'wa Ahabu amayun ɗa a na u shunwai. A̱sulazuva o shiton ta̱ adanshi yi a na u yuwain diga o una̱ wa aagbashi yi Iliya za naa u dammai ne ɗa wa fara.&gt;&gt; <verse eid="2KI 10:10" /><verse number="11" style="v" sid="2KI 10:11" />Adama o ndolo a̱vu Yehu una suru akapi a ama o u'wa wa Ahabu a̱tsuma̱ Yezireyel, oɓolo na̱ azagbain a̱ yi, na̱ n utsa̱n n zuzu ma̱ yi, oɓolo na̱ nan ganu a̱ yi, a lyawa yi ko aaci a̱ ta̱ wuma shi.<note caller="+" style="f"><char style="fr" closed="false">10:11 </char><char style="ft" closed="false">Ka̱lyuwa̱: Hos 1:4. </char></note><verse eid="2KI 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 10:12" />A̱vu Yehu reme ure a̱ tyo Samariya. A̱tsuma̱ Bet Eke va a aza a aguɓa, <verse eid="2KI 10:12" /><verse number="13" style="v" sid="2KI 10:13" />a̱vu u ga'an na̱ ozo o ro a̱tsuma̱ mmaci ma Ahaziya mogono ma Yahuda, a̱vu we ece le u damma, &lt;&lt;A̱ɗu nan za ne ɗa gba?&gt;&gt;</para>
  <para style="p" vid="2KI 10:13">A̱vu usu yi, &lt;&lt;A̱tsu mmaci mu u'wa wa Ahaziya ɗa, tsu ta̱wa̱ ta̱ adama a na tsa yuwan ica̱su yu u'wa u mogono oɓolo no olobo e egbere.&gt;&gt;<verse eid="2KI 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 10:14" />A̱vu Yehu damma, &lt;&lt;E reme le na̱ wuma u le!&gt;&gt; A̱vu e reme le wuma reve a paɗa le zuzu na̱ a̱ka̱ri Bet Eke, ama amunga na̱ a̱za̱ na̱shi ɗa a̱ shi. Babu za a na a lyawai na̱ wuma wa̱ yi.<verse eid="2KI 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 10:15" />A mantsa ma na u yoyin diga lo, a̱vu u ga'an na̱ Yehonada ulobo wa Rekab, za na da̱na̱i a̱ ta̱wa̱ adama a na a ga'an. A̱vu Yehu ca̱sa̱ yi u damma, &lt;&lt;Ko vu tara mu ta̱ diga okolo a̱ wu na amayun ununa n tara nu wu a̱tsuma̱ okolo a̱ va̱ gba?&gt;&gt;</para>
  <para style="p" vid="2KI 10:15">A̱vu Yehonada usu yi u damma yi, &lt;&lt;N usu wu ta̱!&gt;&gt;</para>
  <para style="p" vid="2KI 10:15">A̱vu Yehu damma yi, &lt;&lt;N na̱ ne ɗa, vu ca mu ukere wa̱ wu.&gt;&gt; A̱vu u ca Yehu ukere wa̱ yi. A̱vu Yehu rono yi ukere u kumba to yi e ikeke yi ido ya̱ yi. <verse eid="2KI 10:15" /><verse number="16" style="v" sid="2KI 10:16" />A̱vu Yehu damma yi, &lt;&lt;Ta̱wa̱ oɓolo na̱ a̱mu, adama a na ve ene ukadu u na n ri na̱ yi a̱ tyo wu uba̱ta̱ wa̱ A̱sulazuva.&gt;&gt; A̱vu Yehonada ka̱ra̱ oɓolo na̱ yi a̱tsuma̱ e ikeke vi ido ya̱ yi.<verse eid="2KI 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 10:17" />A mantsa ma na Yehu rawai Samariya, a̱vu wu una suru za na buwai diga a̱tsuma̱ o u'wa wa Ahabu, reve u kototo le, ununa adanshi A̱sulazuva a dammai a̱tsuma̱ o una̱ wa Iliya.<verse eid="2KI 10:17" /></para>
  <para style="s">O una ta̱ aza a na a yuwusaan Ba'al a̱ga̱nda̱</para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 10:18" />A̱vu Yehu ɓoloto ama a Samariya a̱vu u damma le, &lt;&lt;Ahabu yuwaan ta̱ Ba'al a̱ga̱nda̱ ke'en, amma Yehu ta yuwaan Ba'al a̱ga̱nda̱ kpara. <verse eid="2KI 10:18" /><verse number="19" style="v" sid="2KI 10:19" />Ɗe nu mu ama̱sula̱ a̱ musula̱ ma Ba'al suru, na̱ suru aza a na a yuwusaan yi a̱ga̱nda̱ oɓolo na̱ nan ganu a̱ yi. Yi idana ulobonu babu za na a lamba, adama a na n ta̱ ta̱wa̱ a na ma ca kucci gbain a̱ tyo ya Ba'al. Suru za na 'yuwain a̱ ta̱wa̱ a̱ ta̱ o unai.&gt;&gt; Amma Yehu yuwan ta̱ ugbozu adama a na wo o kototo aza a na a yuwusan a̱ga̱nda̱ a̱ tyo ya Ba'al. <verse eid="2KI 10:19" /><verse number="20" style="v" sid="2KI 10:20" />A̱vu Yehu ca u dammu u damma, &lt;&lt;Lyawa a na a tawa urana ko'o adama a na a yuwaan Ba'al a̱ga̱nda̱.&gt;&gt; A̱vu waru gba a tawa urana. <verse eid="2KI 10:20" /><verse number="21" style="v" sid="2KI 10:21" />A̱vu Yehu lyungu na̱ mepepelime suru a̱tsuma̱ Isra'ila, oɓolo na̱ suru a za na a yuwusaan Ba'al a̱ga̱nda̱ a̱ ta̱wa̱, a̱vu suru n le a̱ ta̱wa̱, babu za na kuɗa̱i a na wa̱ ta̱wa̱, hali a shiwan a̱tsuma̱ o u'wa wa Ba'al tapu diga o ufaru a̱ tyo okosu. <verse eid="2KI 10:21" /><verse number="22" style="v" sid="2KI 10:22" />A̱vu Yehu damma a aza a na tsu idanusan a̱tugu a na a tsu yuwusaan a̱ga̱nda̱ a na a̱ ta̱wa̱a̱ na̱ a̱tugu suru aza a na a yuwusaan Ba'al a̱ga̱nda̱. A̱vu u ca suru n le a̱tugu.<verse eid="2KI 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 10:23" />&lt;&lt;A̱vu Yehu na̱ Yehonada ulobo wa Rekab a̱ ka̱ra̱ a uwa pe a̱tsuma̱ masa'a ma Ba'al. A̱vu Yehu damma aza a na a yuwusaan Ba'al a̱ga̱nda̱, i ka̱lyuwa̱ uba̱ta̱ suru i reve babu lo agbashi A̱sulazuva oɓolo na̱ a̱ɗu, a̱ɗu ɗa goon aza a na yaa yuwusan Ba'al a̱ga̱nda̱.&gt;&gt; <verse eid="2KI 10:23" /><verse number="24" style="v" sid="2KI 10:24" />A̱vu a uwa pe adama a na a ca kucci vu ukula̱tosu wu une'e u le. Yehu gba zuwaa le ta̱ lo ama kupa kunla̱ adama a na a̱ ka̱nda̱ruwa̱ uba̱ta̱'a̱, a̱vu u ca le u dammu, &lt;&lt;N na̱ za ta̱ ɗu lyawa suru nanza a̱tsuma̱ a za na n zuwai pa ekere a̱ɗu u suma, wuma wa̱ yi ɗa ne!&gt;&gt;<verse eid="2KI 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 10:25" />A mantsa ma na Yehu kotoi u ca su kucci vu ukula̱tosu, a̱vu u damma aza a na a yuwusan ipiri i nan yali ya̱ a̱soja, &lt;&lt;Uwa yi pe a̱tsuma̱ a̱vu yu una le kpa̱ra̱, She i lyawa nanza la'a wan.&gt;&gt; A̱vu o una le na̱ matsun me pe'eni, a̱vu aza a na a yuwusan ipiri i nan yali ya̱ a̱soja o uta̱a̱ lipu le alanga, a̱vu a uwa pe a̱tsuma̱ a masa'a ma Ba'al. <verse eid="2KI 10:25" /><verse number="26" style="v" sid="2KI 10:26" />A̱vu o uta̱a̱ aatali a̱ga̱nda̱ a̱tsuma̱ a masa'a ma Ba'al alanga a̱vu a̱ kula̱to yi. <verse eid="2KI 10:26" /><verse number="27" style="v" sid="2KI 10:27" />A̱vu o kototo aatsura a̱ga̱nda̱ a Ba'al, a̱vu oɓoso masa'a ma Ba'al, a̱vu a ama a̱ ka̱mbuwa̱ yi uba̱ta̱ u na a tsu yuwusan rulu hali acina na'an.<verse eid="2KI 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 10:28" />Na̱ ne ɗa Yehu kototo yi uba̱ta̱ u na a tsu yuwusan Ba'al a̱ga̱nda̱ a̱tsuma̱ a Isra'ila. <verse eid="2KI 10:28" /><verse number="29" style="v" sid="2KI 10:29" />Amma Yehu vadala diga o unusu wa Yerobowam ulobo wa Neba shi, a na Yerobowam zuwai a aza a Isra'ila a yuwaan musula̱ n zinariya n na a̱ zuɗa̱i a̱ga̱nda̱, aza a na u zuwai a̱tsuma̱ Betel na̱ Dan.<note caller="+" style="f"><char style="fr" closed="false">10:29 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 12:28-30.</char></note><verse eid="2KI 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 10:30" />A̱vu A̱sulazuva a damma Yehu, &lt;&lt;Ko na wo o'woi vu yuwan ta̱ ili i na i ri mejege esu va̱ ni ili i na vu yuwain nu u'wa wa Ahabu suru, ili i na i da̱na̱i pe a̱tsuma̱ okolo a̱ va̱ a na ma yuwan, ugundo wa wu ta yuwaan tsugono tsa Isra'ila aa acina mantsa ma̱a̱ na̱shi.&gt;&gt; <verse eid="2KI 10:30" /><verse number="31" style="v" sid="2KI 10:31" />Amma Yehu yuwan tsutoni ulobonu nu wila̱ wa̱ A̱sulazuva A̱sula̱ a Isra'ila shi, no okolo yi suru shi. U lyawa unusu u na Yerobowam zuwai aza a Isra'ila a yuwain shi.<verse eid="2KI 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 10:32" />A̱tsuma̱ a mantsa mo ndolo a̱vu A̱sulazuva e teme a jibusa upasu u ro wa aza a Isra'ila wa'a wa'a. A̱vu Hazayel usa upasu wa Isra'ila nu uvon. <verse eid="2KI 10:32" /><verse number="33" style="v" sid="2KI 10:33" />Diga upasu wu Uɗolu wa̱ Urudu, na̱ a̱tsuma̱ e iɗa ya Giliyadu upasu wa Gadu suru, na̱ Roben na̱ Manase, za na ri ɗe asana hali a cina lyuci va Arowa, za na ri pe a̱tsuma̱ Uɗolu wa Anon acina Giliyadu na̱ Bashan.<verse eid="2KI 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 10:34" />Akapi o ulinga u na Yehu yuwain a̱ tsugono tsa̱ a̱ yi, na̱ suru ulyuwu we elime a̱ yi, a̱ da̱na̱ ta̱ tu pe uɗanu a̱tsuma̱ aatagada a labari o ngono ma aza a Isra'ila.<verse eid="2KI 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 10:35" />A̱vu Yehu kuwa̱ ucina nkaya ma̱ yi, a̱vu a̱ ciɗo yi a̱tsuma̱ a Samariya. A̱vu ulobo wa̱ yi Jehoha mo o mogono o una̱ wa̱ yi. <verse eid="2KI 10:35" /><verse number="36" style="v" sid="2KI 10:36" />A mantsa ma na Yehu yuwain tsugono ekere a aza a Isra'ila a̱tsuma̱ a Samariya u da̱na̱ ta̱ na a'wan ushin na̱ kunla̱.<verse eid="2KI 10:36" /></para>
  <chapter eid="2KI 10" />
  <chapter number="11" style="c" sid="2KI 11" />
  <para style="s">Ataliya e Egbere va Yahuda</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 11:1" />A mantsa ma na Ataliya mma va Ahaziya enei a na ulobo wa̱ yi u kuwa̱ ta̱, a̱vu u 'yon adama a na wo o kototo muwun n na n ri pe a̱tsuma̱ o u'wa u tsugono suru. <verse eid="2KI 11:1" /><verse number="2" style="v" sid="2KI 11:2" />Amma a̱vu Yehosheba, usheli u Mogono Joram mawun ma̱ a̱na̱wun ma Ahaziya, tara Yowash ulobo wa Ahaziya adama a na wa suma na̱ yi a̱tsuma̱ akapi olobo a na a̱ da̱na̱i pe a̱tsuma̱ o u'wa u tsugono, a za na a cigai a na o kototo le. A̱vu u zuwa yi oɓolo na̱ za na a̱ da̱na̱ e idanusan yi a̱tsuma̱ asula e nven adama a na wa pa'an to yi diga e ekere a Ataliya, adama o ndolo a̱tsura̱ o unai shi. <verse eid="2KI 11:2" /><verse number="3" style="v" sid="2KI 11:3" />A̱vu u da̱na̱ usokowu oɓolo na̱ za na kungwatoi ni yi a̱tsuma̱ A̱a̱'isamapaɗa a̱ A̱sulazuva a cina a'wan a̱ ta̱li, a mantsa ma na Ataliya da̱na̱i o tsugono a̱tsuma̱ e iɗa'a.<verse eid="2KI 11:3" /></para>
  <para style="s">Yowash wo u ta̱ Mogono</para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 11:4" />A̱tsuma̱ a'wan e cindere a̱vu Yehoyida ganu lyungu na e ɗe nan yali a̱soja o ukpaku ukpaku, aza a na a yuwusan ipiri i mogono oɓolo na̱ a̱soja a na a yuwusan ipiri yu u'wa u mogono, a na a̱ ta̱wa̱ uba̱ta̱ wa̱ yi a̱tsuma̱ A̱a̱'isamapaɗa a̱ A̱sulazuva. Lo ɗa u zuwa n le a yuwain nzuwulai oɓolo na akucunu ana, a̱ ta̱ usu ifoɓi i na u ri na̱ yi. Lo ɗa u roco n le Yowash ulobo u mogono Ahaziya. <verse eid="2KI 11:4" /><verse number="5" style="v" sid="2KI 11:5" />A̱vu u yuwan adanshi na̱ le u damma, &lt;&lt;Apa ili i na ya yuwan, a mantsa ma na i ta̱wa̱i uba̱tu wu ulinga a̱tsuma̱ o uranu wa Ashibi. Reve i ne'eshen aciya a̱ ɗu oɓolo a ta'atsu. Oɓolo o ufaru a ta yuwan ipiri yu u'wa i mogono. <verse eid="2KI 11:5" /><verse number="6" style="v" sid="2KI 11:6" />Oɓolo e ire waru a ta yuwan ipiri yu una̱ntsu wa Sur, wa̱ ta'atsu o ndolo waru a ta isawan a̱ca̱pa̱ akapi a̱soja a na a̱ ri a yuwusan ipiri yu ukobu mogono. <verse eid="2KI 11:6" /><verse number="7" style="v" sid="2KI 11:7" />Oɓolo i re waru fo aza a na a̱ 'yon ulinga o urana wa ashibi, a ta yuwan ipiri ya̱ A̱a̱'isamapaɗa a̱ A̱sulazuva adama a̱ piri wuma u mogono. <verse eid="2KI 11:7" /><verse number="8" style="v" sid="2KI 11:8" />A̱vu i ka̱nda̱ruwa̱ suru uba̱ta̱ u mogono, vuma suru ni itana yu uvon ya̱ yi o ukere wa̱ yi. Suru za na ta̱wa̱i zuzu na̱ ɗu a̱vu yu unai, a̱vu i da̱na̱ zuzu na̱ mogono suru uba̱ta̱ u na u 'ya̱wa̱i biti.&gt;&gt;<verse eid="2KI 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 11:9" />A̱vu nan yali a̱soja a yuwan ununa Yehoyida ganu cuɗuwa n le. Suru nan yali ya̱ a̱soja a̱ ta̱wa̱ ta̱ na a ama le aza a na a fara ulinga o urana wa Ashibi, oɓolo na aza a̱ 'yon ulinga o urana'a. Suru n le a̱ ta̱wa̱ ta̱ uba̱ta̱ wa Yehoyida ganu.<verse eid="2KI 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 11:10" />A̱vu ganu'u u ca nan yali a̱soja'a ibata na̱ a̱ra̱ga̱ a aza a na a̱ shi a̱za̱ Mogono Da̱wuda, aza a na a zuwai pe a̱tsuma̱ A̱a̱'isamapaɗa a̱ A̱sulazuva. <verse eid="2KI 11:10" /><verse number="11" style="v" sid="2KI 11:11" />A̱soja e ipiri'i, za suru ni itana yu uvon ekere yi a̱vu a̱ ka̱nda̱ruwa̱ mogono, zuzu na̱ masa'a oɓolo na̱ A̱a̱'isamapaɗa, diga o upasu wu uyagi acina upasu wu ugana wa̱ A̱a̱'isamapaɗa.<verse eid="2KI 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 11:12" />A̱vu Yehoyida uta̱ na̱ ulobo u mogono, a̱vu wo oto yi okokolo o tsugono aaci ya̱ yi. A̱vu u ca yi aatagada a̱ wila̱, a̱vu u damma le apa mogono. A̱vu a̱ tsuwa̱yin mani'in, a̱vu a ama a ɓasa ekere e le na̱ ma̱za̱nga̱ a dansa, &lt;&lt;Wuma wa̱ wu u jima, mogono!&gt;&gt;<verse eid="2KI 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 11:13" />A mantsa ma na Ataliya uwwai a̱gidi'ya̱ diga uba̱ta̱ wa̱ a̱soja aza a na a yuwusan ipiri oɓolo na̱ akapi ama, a̱vu u ka̱ra̱ a̱ tyo uba̱ta̱ wa akapi a ama a na a̱ ri pe a̱tsuma̱ A̱a̱'isamapaɗa a̱ A̱sulazuva. <verse eid="2KI 11:13" /><verse number="14" style="v" sid="2KI 11:14" />A mantsa ma na u ka̱lyuwa̱i a̱vu we ene mogono mishin lo uba̱ta̱ wa aatsura, ununa a tsu yuwusan. A̱vu waru we ene azagbain a̱soja na̱ aza a na a tsu ivula̱ avana lo zuzu na̱ mogono'o, ama e iɗa'a suru a̱ da̱na̱ ta̱ a̱ ma̱za̱nga̱ na̱ a̱ ivulusa̱ yi avana. A̱vu Ataliya a kara a̱tugu yi a̱vu u saala a dansa, &lt;&lt;Ili ya nda yipaalishi i ɗa, yipaalishi i ɗa!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">11:14 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Ngo 23:13.</char></note><verse eid="2KI 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 11:15" />A̱vu Yehoyida ganu damma nan yali a̱soja o ukpaku aza a na a̱ da̱na̱i yali ya̱ oɓolo a̱soja u damma, &lt;&lt;U ta̱ yi na̱ yi diga e memere ma̱ a̱soja, a̱vu yu una za na cigai wawa yi suru na̱ matsun me pe'eni.&gt;&gt; Adama a na ganu damma ta̱, &lt;&lt;She o unai a̱tsuma̱ A̱a̱'isamapaɗa a̱ A̱sulazuva wan.&gt;&gt; <verse eid="2KI 11:15" /><verse number="16" style="v" sid="2KI 11:16" />A̱vu e remei a tara yi nu una̱ntsu wi ido a̱ tyo o ure wu u'wa u mogono, a̱vu o unai ɗe.<verse eid="2KI 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 11:17" />Yehoyida gba yuwan ta̱ nzuwulai a̱ tyo wu uba̱ta̱ wa̱ A̱sulazuva na̱ mogono oɓolo na ama, adama a na o'wo ama a̱ A̱sulazuva. A̱vu fo u zuwa mogono ma yuwan nzuwulai na a ama. <verse eid="2KI 11:17" /><verse number="18" style="v" sid="2KI 11:18" />A̱vu ama e iɗa'a suru a̱ ka̱ra̱ a̱ tyo a̱a̱'isa̱ a Ba'al, a̱vu o kototo yi. A̱vu waru o kototo musa'a, a̱vu o kototo fo iroci musula̱, a̱vu o una Matan ganu va Ba'al aza a na da̱na̱i lo elime a masa'a ma Ba'al. Yehoyida ganu zuwa ta̱ aza a na a yuwan ipiri ya̱ A̱a̱'isamapaɗa a̱ A̱sulazuva. <verse eid="2KI 11:18" /><verse number="19" style="v" sid="2KI 11:19" />A̱vu u tara oɓolo a nan yali ya̱ a̱soja ukpaku, oɓolo na̱ a̱soja a na a yuwusan ipiri i mogono, na aza a na a yuwusan ipiri yu ukobu u mogono, oɓolo na akapi a ama'a suru adama a̱sha̱wu Yowash diga a̱tsuma̱ A̱a̱'isamapaɗa a̱ A̱sulazuva a̱ tyo o u'wa u mogono. A̱vu a uwa na̱ mogono diga o na̱tsutsu wa aza a na a yuwusan ipiri a̱ tyo o a̱tsuma̱ o u'wa wa̱ yi. A̱vu mogono ma kumba ootogu o tsugono reve u da̱nu. <verse eid="2KI 11:19" /><verse number="20" style="v" sid="2KI 11:20" />A̱vu suru ama e iɗa'a a yuwan ma̱za̱nga̱. Lyuci'i gba u da̱na̱ ta̱ na̱ nden ma asuvu, adama a na a paɗa ta̱ Ataliya na̱ matsun me pe'eni a̱tsuma̱ o u'wa u mogono.<verse eid="2KI 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 11:21" />Yowash da̱na̱ ta̱ na aa'wan e cindere a mantsa ma na u temei tsugono a̱tsuma̱ a Yahuda.<verse eid="2KI 11:21" /></para>
  <chapter eid="2KI 11" />
  <chapter number="12" style="c" sid="2KI 12" />
  <para style="s">Yowash lapula ta̱ A̱a̱'isamapaɗa</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 12:1" />A̱tsuma̱ aa'wan cindere o tsugono tsa̱ Yehu ɗa, Yowash wo woi mogono, a̱vu u yuwan tsugono tsa Urishelima a'wan amunga. Aala aa mma va yi ɗa Zibiya, diga a̱tsuma̱ e iɗa ya Biyasheba. <verse eid="2KI 12:1" /><verse number="2" style="v" sid="2KI 12:2" />Yowash yuwan ta̱ ili i na i ri mejege elime A̱sulazuva, ununa Yehoyida ganu cuɗuwa ni yi. <verse eid="2KI 12:2" /><verse number="3" style="v" sid="2KI 12:3" />Amma suru na̱ tsu ndolo fo, u kototo wu uba̱ta̱ musula̱ shi, a̱vu a ama a lyuwa elime a ca su kucci le na̱ une'e u le ba̱ta̱ va̱ a̱ga̱nda̱.<verse eid="2KI 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 12:4" />A̱vu Yowash damma nan ganu, &lt;&lt;ɓoloto yi suru ikebe i na a̱ ta̱wa̱ yi a̱tsuma̱ A̱a̱'isamapaɗa a̱ A̱sulazuva ni ikebe i na oɓoloto yi uba̱ta̱ mekece, ni ikebe i na a̱ ushiyi uba̱ta̱ wa ama adama a akucunu a na a yuwain, na̱ suru ikebe i na a ca yi nu ucigu wo okolo ele a na a̱ ta̱wa̱a̱ yi A̱a̱'isamapaɗa a̱ A̱sulazuva.<note caller="+" style="f"><char style="fr" closed="false">12:4 </char><char style="ft" closed="false">Ka̱lyuwa̱: Mta̱ 30:11-16.</char></note> <verse eid="2KI 12:4" /><verse number="5" style="v" sid="2KI 12:5" />Lyawa ikebe i na nan ganu a̱ ushiyi e ekere a ama, u da̱na̱ ulobonu u na a tara pe a̱tsuma̱ e ikebe i ndolo, adama a na a yuwan ulapulu wu uba̱ta̱ u na ucigai ulapulu a̱tsuma̱ a̱ A̱a̱'isamapaɗa a̱ A̱sulazuva.&gt;&gt;<verse eid="2KI 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 12:6" />Amma hali a cina a'wan ushin na̱ aza a ta'atsu o tsugono tsa mogono Yowash, nan ganu a gura lapula A̱a̱'isamapaɗa'a shi. <verse eid="2KI 12:6" /><verse number="7" style="v" sid="2KI 12:7" />Adama o ndolo a̱vu mogono Yowash ɗe Yehoyida ganu na̱ akapi a nan ganu suru a̱vu we ece le, &lt;&lt;Adama nye ɗa i kuɗa̱i a na yaa lapula A̱a̱'isamapaɗa? To, diga gogo she i da̱shi ushi ikebe diga o ukere wa̱ ozo o ucasu adama aa aciya a̱ɗu wan. O una̱ o ndolo i ca ikebe'e tsura̱ a yuwan ulapulu wa̱ A̱a̱'isamapaɗa a̱ A̱sulazuva.&gt;&gt; <verse eid="2KI 12:7" /><verse number="8" style="v" sid="2KI 12:8" />A̱vu nan ganu a̱ usu a na a buwa a na a̱ da̱shi ushi yi ikebe diga o ukere wa aa ama adama aciya̱ le waru shi, waru a buwa a yuwan ulapulu wa̱ A̱a̱'isamapaɗa naa aciya le shi.<verse eid="2KI 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 12:9" />A̱vu Yehoyida ganu tara akpati, a̱vu u yuwaan yi una̱ e ikpa̱ta̱tsu u zuwai zuzu na̱ masa'a lo o ukere usa'ani, n na̱ vuma ta uwa a̱tsuma̱ A̱a̱'isamapaɗa a̱ A̱sulazuva. A̱vu nan ganu a na a yuwusan ipiri ya̱ A̱a̱'isamapaɗa a̱ A̱sulazuva a̱ ta̱wa̱ ni ikebe'e adama a na a zuwa le pe a̱tsuma̱ akpati'i. <verse eid="2KI 12:9" /><verse number="10" style="v" sid="2KI 12:10" />Suru mantsa ma na e enei ikebe i yuwan ta̱ a̱bunda̱ a̱tsuma̱ akpati'i, a̱vu za vi iɗana i mogono na̱ ganu gbain a̱ tsu ta̱wa̱ ta̱ adama a na e kece ikebe i na a̱ ta̱wa̱ yi a̱tsuma̱ A̱a̱'isamapaɗa a A̱sulazuva'a, reve a̱ nla̱ le a zuwa le a̱tsuma̱ e tsa̱n. <verse eid="2KI 12:10" /><verse number="11" style="v" sid="2KI 12:11" />A̱vu a ca ikebe'e ekere aza na a̱ ka̱lyusa̱n ulinga wa̱ A̱a̱'isamapaɗa'a. Ni ikebe i ndolo ɗa a tsupusaa yi ozo o ulinga wa̱ A̱a̱'isamapaɗa a̱ A̱sulazuva, na̱ nan kafinta, na̱ aza a na a yuwusan usaa, <verse eid="2KI 12:11" /><verse number="12" style="v" sid="2KI 12:12" />na̱ aza a na a yuwusan ikunku, na̱ a̱za̱ wu uɓosu wa atali. Agba a ta yuwusan ulinga na̱ ikebe adama a na a tsula akpata na̱ atali a na a lapula A̱a̱'isamapaɗa a̱ A̱sulazuva, na̱ waru adama a na a cina a na a tsupa suru ili i na a tsulai adama o ulapulu wa̱ A̱a̱'isamapaɗa. <verse eid="2KI 12:12" /><verse number="13" style="v" sid="2KI 12:13" />Ikebe i na a̱ ta̱wa̱sa̱ a̱tsuma̱ A̱a̱'isamapaɗa'a o una le adama a na a yuwan akwanu a azurufa shi, ko ili i na a̱ ri a na a kimusa̱ fitila shi, ko a akwanu azurufa, ko abulu, ko itana i zinariya na̱ aza a azurufa adama A̱a̱'isamapaɗa a̱ A̱sulazuva shi. <verse eid="2KI 12:13" /><verse number="14" style="v" sid="2KI 12:14" />A yuwan ta̱ ulinga ni ikebe'e adama a na a tsupa aza a na a yuwusaan ulapulu wa̱ A̱a̱'isamapaɗa a̱ A̱sulazuva. <verse eid="2KI 12:14" /><verse number="15" style="v" sid="2KI 12:15" />Agba a zami aza a na e idanusan ulinga'a shi, ekere aza a na a ca yi ikebe'e ko a tsupa ozo o ulinga'a shi, adama a na a yuwan ta̱ ulinga u le na̱ mejege na a amayun.<note caller="+" style="f"><char style="fr" closed="false">12:15 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Ngo 22:7.</char></note> <verse eid="2KI 12:15" /><verse number="16" style="v" sid="2KI 12:16" />Ikebe i na a̱ ta̱wa̱ yi adama a kucci makuɗa ma̱ wila̱, na̱ kucci vu unusu a̱tsuma̱ A̱a̱'isamapaɗa a̱ A̱sulazuva aza a nan ganu a ɗa.<note caller="+" style="f"><char style="fr" closed="false">12:16 </char><char style="ft" closed="false">Ka̱lyuwa̱: Mta̱ 5:15-16; 7:7.</char></note><verse eid="2KI 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 12:17" />A mantsa o ndolo, Mogono Hazayel va Suriya ma̱ ka̱ra̱ ta̱ adama a na wa̱ 'ya̱wa̱ yuwan uvon na̱ Gat a̱vu u lyuwai. A̱vu u vadala a adama u riya̱a̱ Urishelima nu uvon. <verse eid="2KI 12:17" /><verse number="18" style="v" sid="2KI 12:18" />Amma a̱vu mogono Yowash va Yahuda ma̱ pura̱ suru une'e u na a ca yi nkaya nle Jehoshafa na̱ Jehoram na̱ Ahaziya, ngono ma a Yahuda na̱ ne'e n na a̱yi na aciya yi u tawai u zinariya, na a̱ tsura̱i a̱tsuma̱ asula e izuwa A̱a̱'isamapaɗa a̱ A̱sulazuva, na̱ za vu u'wa u mogono suru, a̱vu u lyungu le a̱ tyo ya mogono Hazayel va Suriya, a̱vu u lyawa Urishelima.<verse eid="2KI 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 12:19" />Akapi o ulinga u tsugono tsa Yowash, na̱ suru ulinga u na u yuwain, a̱ da̱na̱ ta̱ tu pe uɗanu a̱tsuma̱ a aatagada a alabari o ngono ma Yahuda. <verse eid="2KI 12:19" /><verse number="20" style="v" sid="2KI 12:20" />A̱vu ozo o ro diga a̱tsuma̱ azagbain a̱ yi o oɓolo una̱ o unai a̱tsuma̱ o u'wa u ro a Bet Milo, o ure u na u zura̱i a̱ tyo wu upasu wa Sila. <verse eid="2KI 12:20" /><verse number="21" style="v" sid="2KI 12:21" />Azagbain a na o una ni yi ele ɗa, Yozaba ulobo wa Shimeya na̱ Yehozaba ulobo wa Shome. A̱vu a̱ ciɗo yi oɓolo na̱ nkaya ma̱ yi a̱tsuma̱ a̱ lyuci gbain va̱ Da̱wuda. A̱vu ulobo wa̱ yi Amaziya wo o mogono o una̱ wa̱ yi.<verse eid="2KI 12:21" /></para>
  <chapter eid="2KI 12" />
  <chapter number="13" style="c" sid="2KI 13" />
  <para style="s">Jehoha Mogono ma Isra'ila</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 13:1" />A̱tsuma̱ a aa'wan ushin na aza ta'atsu o tsugono tsa mogono Yowash ulobo wa Ahaziya mogono ma a Yahuda, Jehoha ulobo wa Yehu me temei tsugono tsa Isra'ila a̱tsuma̱ a Samariya. A̱vu u yuwan tsugono tsa a aa'wan kupa na̱ a̱za̱ cindere. <verse eid="2KI 13:1" /><verse number="2" style="v" sid="2KI 13:2" />Amma u yuwan ta̱ iwuya esu A̱sulazuva a na u yuwain mmalu a̱tsuma̱ o ure wi iwuya ya Yerobowam ulobo wa Neba, za na zuwai ama a Isra'ila a yuwain unusu agba u vadala diga uba̱ta̱ wi i toni i le shi. <verse eid="2KI 13:2" /><verse number="3" style="v" sid="2KI 13:3" />A̱vu A̱sulazuva a yuwan upan na aza a Isra'ila, a̱vu u lyuwa elime a ca su le e ekere mogono Hazayel ma Suriya ne e ekere o ulobo wa̱ yi Ben Hada. <verse eid="2KI 13:3" /><verse number="4" style="v" sid="2KI 13:4" />Reve Jehoha patiya ya̱ A̱sulazuva, a̱vu A̱sulazuva a̱ usu yi, adama a na we ene'e ta̱ a̱tsuma̱lima̱ a na Mogono ma Suriya ma aa ca su aza a Isra'ila. <verse eid="2KI 13:4" /><verse number="5" style="v" sid="2KI 13:5" />Reve A̱sulazuva a ca aza a Isra'ila za vi iwawi, a̱vu a la'a diga e ekere aza a Suriya. A̱vu ama Isra'ila a̱tsura̱ nden ma asuvu ununa a̱ da̱na̱i ɗe nu ufaru. <verse eid="2KI 13:5" /><verse number="6" style="v" sid="2KI 13:6" />Suru na̱ ne a vadala diga uba̱ta̱ wu unusu u le za vu u'wa wa Yerobowam shi, aza a na u zuwai ama a Isra'ila o toni shi, a̱vu a lyuwa elime na̱ le. Amma a̱vu a lyawa musula̱ ma Ashera a̱tsuma̱ a Samariya. <verse eid="2KI 13:6" /><verse number="7" style="v" sid="2KI 13:7" />Babu ili i na i buwai ya aza a Jehoha she a̱soja a na a tsu kumbusa ido kupoton goon, ni ikeke yi ido yu uvon kupa, na̱ a̱soja e iɗa ukpakukupa (10,000). Adama a na mogono ma Suriya ma̱ kototo ta̱ ili'i suru suru, reve wo o ununa vu revei ma̱buta̱ ma̱ tsu lapa.<verse eid="2KI 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 13:8" />Akapi o ulinga u na Jehoha yuwain, na̱ suru linga va̱ yi nu ulyuwu we elime, a̱ da̱na̱ ta̱ tu pe uɗanu a̱tsuma̱ a aatagada a alabari o ngono ma Isra'ila. <verse eid="2KI 13:8" /><verse number="9" style="v" sid="2KI 13:9" />A̱vu Jehoha kuwa̱ ucina nkaya ma̱ yi, a̱vu a̱ciɗyo yi a̱tsuma̱ a Samariya. A̱vu ulobo wa̱ yi Yowash mo o mogono o una̱ wa̱ yi.<verse eid="2KI 13:9" /></para>
  <para style="s">Yowash Mogono ma a Isra'ila</para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 13:10" />A̱tsuma̱ a aa'wan mata'atsu na̱ a̱za̱ cindere o tsugono tsa mogono Yowash va Yahuda, reve Yehowash ulobo wa Jehoha teme tsugono tsa aza a Isra'ila a̱tsuma̱ a Samariya, a̱vu u yuwan tsugono tsa aa'wan kupa na̱ a̱za̱ ta̱li. <verse eid="2KI 13:10" /><verse number="11" style="v" sid="2KI 13:11" />U yuwan ta̱ iwuya elime A̱sulazuva. Agba u vadala diga a̱tsuma̱ o unusu u na Yerobowam ulobo wa Neba ma a zuwai ama a Isra'ila a yuwain shi. Amma a̱vu u lyuwa elime na̱ le.<verse eid="2KI 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 13:12" />Akapi o ulinga wa Yowash, na̱ suru ili i na u yuwain nu ulyuwu we elime wa̱ yi, oɓolo nu uvon u na u yuwain na̱ Amaziya mogono ma a Yahuda, a̱ da̱na̱ ta̱ tu pe uɗanu a̱tsuma̱ a aatagada a alabari o ngono ma a Isra'ila. <verse eid="2KI 13:12" /><verse number="13" style="v" sid="2KI 13:13" />A̱vu Yowash kuwa̱ ucina nkaya ma̱ yi, a̱vu a̱ ciɗo yi a̱tsuma̱ a Samariya oɓolo na̱ ngono ma aza a Isra'ila. Reve Yerobowam ulobo wa̱ yi u da̱nu ootogu o tsugono tsa a̱ yi o una̱ wa̱ yi.<verse eid="2KI 13:13" /></para>
  <para style="s">Ukwa̱ wa̱ Elisha</para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 13:14" />A mantsa ma na Elisha remei ubanakun u na u kuwa̱i. A̱vu Yowash mogono ma aza a Isra'ila ma̱ ka̱ra̱ a̱ tyo uba̱ta̱ wa̱ yi, a̱vu u yuwan mesun elime a̱ yi. A̱vu u damma &lt;&lt;Dada va̱! Dada va̱! Ikeke yi ido, na akumbi e ikeke yi ido ya Isra'ila!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">13:14 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Ngo 2:12.</char></note><verse eid="2KI 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 13:15" />A̱vu Elisha damma yi, &lt;&lt;Tara utan ni iliya.&gt;&gt; Reve u tara. <verse eid="2KI 13:15" /><verse number="16" style="v" sid="2KI 13:16" />A̱vu u damma mogono ma aza a Isra'ila vu tara utan e ekere a̱ wu, a mantsa ma na u tarai, a̱vu Elisha kuru ekere a̱ yi ekere mogono.<verse eid="2KI 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 13:17" />A̱vu u damma yi, &lt;&lt;Vu kpa̱tu'wa̱ usowoto wu upepu u na we idanusan asana.&gt;&gt; A̱vu u kpa̱tu'wa̱ usowoto wu upepu'u. A̱vu Elisha damma yi, &lt;&lt;Vu tewin liya'a!&gt;&gt; A̱vu gba u tewiyin. A̱vu Elisha damma, &lt;&lt;A̱yi nda ɗa iroci yi iliya wu ulyuwu wa aci a̱ A̱sulazuva ekere aza a Suriya! Vu to kototo aza a Suriya a̱tsuma̱ Afe suru suru.&gt;&gt;<verse eid="2KI 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 13:18" />A̱vu u dammai yi, &lt;&lt;Tara iliya &gt;&gt; A̱vu mogono ma tara le. A̱vu Elisha damma mogono ma Isra'ila, &lt;&lt;Sapa iɗa.&gt;&gt; A̱vu u sapa yi toto u ta'atsu reve u lyawa ne. <verse eid="2KI 13:18" /><verse number="19" style="v" sid="2KI 13:19" />A̱vu vuma va̱ A̱sula̱ yuwan upan na̱ yi, a̱vu u damma, &lt;&lt;Vu shi ta̱ a sapa iɗa'a toto ton ko gbashi uta̱li, na̱ tsun ndolo tsa ɗa vu shi o kototo aza a Suriya suru suru. Amma gogo gba vu ta lyuwa yi u ta'atsu ɗa goon.&gt;&gt;<verse eid="2KI 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 13:20" />A̱vu Elisha kuwa̱ a̱vu a̱ ciɗo yi.</para>
  <para style="p" vid="2KI 13:20">Agba aza a Mowa a̱ tsu ta̱wa̱sa̱ ta̱ nu uvon a̱tsuma̱ a Isra'ila suru aa'wan. <verse eid="2KI 13:20" /><verse number="21" style="v" sid="2KI 13:21" />Ele lo a̱tsuma̱ o uranu u ro a mantsa ma na aza a Isra'ila a̱ ri ya̱ ciɗosu vuma ro, a̱vu ene oɓolo ama a na a̱ tsu ta̱wusa̱ le nu uvon, babu usa̱n reve a vari lo vuma'a a̱tsuma̱ ason a Elisha. Amma a mantsa ma na lipu vuma'a u ju'wa̱in etele Elisha, a̱vu vuma'a u ka̱mbisa̱ wuma reve u yon mishin wisawan na ana yi.<verse eid="2KI 13:21" /></para>
  <para style="s">Uvon wa Isra'ila na aza a Suriya</para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 13:22" />A̱vu mogono Hazayel va Suriya ca aza a Isra'ila a̱tsuma̱lima̱ suru a rana tsugono tsa mogono Jehoha.<note caller="+" style="f"><char style="fr" closed="false">13:22 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Ngo 8:12.</char></note> <verse eid="2KI 13:22" /><verse number="23" style="v" sid="2KI 13:23" />Amma a̱vu A̱sulazuva o roco le icigi ni isa'ani ya̱ yi. A̱vu wu uwwa iliyali i le adama a nzuwulai n naa u yuwain na̱ Ibrahim na̱ Ishiyaku na̱ Yakubu. Agba acina a na'an u yuwan majiyan ma na wo kototo le ko u vari le diga elime yi shi.<verse eid="2KI 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 13:24" />Ana Hazayel mogono ma aza a Suriya ma̱ kuwa̱i a̱vu Ben Hada ulobo wa̱ yi mo o mogono o una̱ wa̱ yi. <verse eid="2KI 13:24" /><verse number="25" style="v" sid="2KI 13:25" />A̱vu Yowash ulobo wa Jehoha ma̱ tsura̱ ulyuwu we elime aciya a Ben Hada ulobo wa Hazayel a na u usai uba̱ta̱ wa dada va̱ yi Jehoha uba̱ta̱ wu uvon. Toto u ta'atsu u ɗa u lyuwa ni yi, a̱vu u ka̱mbuwisa̱ ilyuci i na a̱ shi a usai a aza a Isra'ila i ɗa suru.<verse eid="2KI 13:25" /></para>
  <chapter eid="2KI 13" />
  <chapter number="14" style="c" sid="2KI 14" />
  <para style="s">Amaziya Mogono ma Yahuda</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 14:1" />A̱tsuma̱ a aa'wan a̱ i re o tsugono tsa Yehowaha ulobo wa Jehoha mogono ma Isra'ila, Amaziya ulobo wa Yowash mogono ma a Yahuda me temei tsugono. <verse eid="2KI 14:1" /><verse number="2" style="v" sid="2KI 14:2" />U da̱na̱ ta̱ na a'wan ushin no ozo o ton a na wo woi mogono, a̱vu u yuwan a'wan ushin na̱ kuci a yuwusan tsugono tsa Urishelima. Aala mma va yi ɗa Yehowadi, diga Urishelima. <verse eid="2KI 14:2" /><verse number="3" style="v" sid="2KI 14:3" />U yuwan ta̱ ili i na i ri mejege elime A̱sulazuva, amma suru na̱ tsu ndolo u rawa ununa dada va̱ yi Da̱wuda yuwain shi. A̱vu u toni suru i ili i na dada va̱ yi Yowash yuwain. <verse eid="2KI 14:3" /><verse number="4" style="v" sid="2KI 14:4" />Agba suru na̱ ne a tawa uba̱ta̱ u na u ri idaba shi, ama a lyuwa ta̱ elime a ca su kucci le nu u kula̱tosu ni itana i ma̱guru ɗe.<verse eid="2KI 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 14:5" />A mantsa ma na tsugono'o tsa shuwa̱i, a̱vu wu una a azagbain a na o unai dada va̱ yi mogono. <verse eid="2KI 14:5" /><verse number="6" style="v" sid="2KI 14:6" />Amma wu una muwun ma aza a na o una ni shi, ununa u ri yu uɗanu a̱tsuma̱ a aatagada a̱ wila̱ wa Musa uba̱ta̱ u na A̱sulazuva a dammai, &lt;&lt;Aa una Dada adama o unusu mawun ma̱ yi shi, ko waru a na o una muwun adama o unusu wa Dada le shi. Suru vuma na yuwain unusu a̱ yi ɗa wa̱ kuwa̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">14:6 </char><char style="ft" closed="false">Ka̱lyuwa̱: U. Wl 24.16.</char></note><verse eid="2KI 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 14:7" />A̱yi ɗa vuma na kototo yi a aza a Edom ukpaku kupa (10,000), o uka̱ri wa akpaɗi, a̱vu u reme Sela uba̱ta̱ wu uvon, a̱vu ɗe yi Yokteye, naa ala o ndolo ɗa e tsu ɗe yi hali na na'an.<verse eid="2KI 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 14:8" />A̱vu Amaziya lyungu nlingata a̱ tyo ya Jehoha ulobo wa Yowash, ulobo wa Yehu, mogono ma Isra'ila, ni izami yi nla̱ngi, u damma, &lt;&lt;Vu uta̱ adama a na tsa ga'an esu na̱ esu.&gt;&gt;<verse eid="2KI 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 14:9" />Amma a̱vu mogono Yowash va Isra'ila lyunguwa̱ Amaziya mogono ma Yahuda, u damma &lt;&lt;Ɗanga va awanda ro va Lebanon lyunguwa̱ ta̱ ɗanga gbain va Sida a̱tsuma̱ a Lebanon, nu udammu u damma, &lt;Vu ca mawun ma wu mo usheli adama a na ulobo u va̱ wa zuwa yi.&gt; Amma a̱vu nama vu una u ro u ta̱wa̱ adama a na wa̱ ka̱ra̱ a̱vu wu dadasa awanda'a. <verse eid="2KI 14:9" /><verse number="10" style="v" sid="2KI 14:10" />Amayun ɗa a na vu kototo yi a aza a Edom, ɗaɗa vu temei uvaɗu. Gogo a̱vu vu yuwan ma̱za̱nga̱ a na vu tsura̱i u lyuwu we elime, vu da̱nu a̱tsuma̱ o u'wa! Adama nye ɗa vu cigai a na va̱ ta̱wa̱ nu ulambu wu nden n lafiya za na a̱ ta̱wa̱ wu na̱ a̱risa̱, a̱vu ni i iɗa ya Yahuda fo?&gt;&gt;<verse eid="2KI 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 14:11" />Amaziya 'yuwan ta̱ a na wa uwwa adanshi, a̱vu mogono Yowash va Isra'ila ma̱ ka̱ra̱ adama a na a wa yuwan uvon na̱ Amaziya mogono ma Yahuda a̱tsuma̱ a Bet Shemesh va Yahuda. <verse eid="2KI 14:11" /><verse number="12" style="v" sid="2KI 14:12" />A̱vu a aza a Isra'ila lyuwa a aza a Yahuda nu uvon, a̱vu suru ama a̱ ka̱ra̱ a̱ tyo a 'wa le. <verse eid="2KI 14:12" /><verse number="13" style="v" sid="2KI 14:13" />A̱vu mogono Yehowash va Isra'ila reme mogono Amaziya va Yahuda, ulobo wa Yowash za vu ugundo wa Ahaziya, a̱tsuma̱ Bet Shemesh. A̱vu Yehowash ka̱ra̱ a̱ tyo Urushalima a̱vu u kototo ukari wa Urishelima diga o una̱ntsutsu wa Ifiramu a̱ tyo o una̱ntsutsu wu usokowu. <verse eid="2KI 14:13" /><verse number="14" style="v" sid="2KI 14:14" />A̱vu u pura̱ suru zinariya na̱ azurufa, na̱ suru itana yu ulinga u na a̱ tsura̱i a̱tsuma̱ A̱a̱'isamapaɗa a̱ A̱sulazuva, oɓolo na̱ a aza a na a̱ ri pe a̱tsuma̱ e itana yi izuwa a̱tsuma̱ o ukobu mogono. A̱vu waru u tara a ama a na a̱ shi a pura̱i a̱vu u ka̱mba̱ na̱ le Samariya.<verse eid="2KI 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 14:15" />Akapi o ulinga u na Yowash yuwain, ni ili i na u yuwain biti oɓolo nu ulyuwu we elime, nu uvon u na u yuwain na̱ mogono Amaziya va Yahuda, a̱ da̱na̱ ta̱ pe uɗanu a̱tsuma̱ aatagada alabari ngono ma Isra'ila. <verse eid="2KI 14:15" /><verse number="16" style="v" sid="2KI 14:16" />A̱vu Yowash kuwa̱ ucina nkaya ma̱ yi, a̱vu a̱ciɗyo yi a̱tsuma̱ a Samariya oɓolo na̱ ngono ma Isra'ila. A̱vu ulobo wa̱ yi Yerobowam mo o mogono o una̱ wa̱ yi.<verse eid="2KI 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 14:17" />Amaziya ulobo wa Yowash mogono ma a Yahuda ma yuwan ta̱ a'wan gendu a mantsa ma na Yehowash ulobo wa Jehoha mogono ma Isra'ila ma̱ kuwa̱i. <verse eid="2KI 14:17" /><verse number="18" style="v" sid="2KI 14:18" />Akapi o ulinga u na Amaziya yuwain, a̱ da̱na̱ ta̱ tu pe uɗanu a̱tsuma̱ aatagada alabari o ngono ma Yahuda.<verse eid="2KI 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 14:19" />A̱vu a yuwan ifoɓi i na o unai a̱tsuma̱ a̱ Urishelima, a̱vu u suma a̱ tyo Lakish, amma a̱vu a̱ lyungu na a ama a̱ tyo Lakish reve o unai ɗe. <verse eid="2KI 14:19" /><verse number="20" style="v" sid="2KI 14:20" />A̱vu a̱ ta̱wa̱ na̱ yi zuva vi ido a̱vu a̱ciɗyo yi a̱tsuma̱ a̱ Urishelima oɓolo na̱ nkaya ma̱ yi, a̱tsuma̱ a̱ lyuci gbain va Da̱wuda.<verse eid="2KI 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 14:21" />A̱vu suru ama a Yahuda a tara Azariya, za na da̱na̱i na a'wan kupa na̱ a̱za̱ ta̱li, a̱vu a katala yi okokolo o mogono o una̱ wa dada va yi Amaziya. <verse eid="2KI 14:21" /><verse number="22" style="v" sid="2KI 14:22" />A̱yi ɗa za na suwisa yi lyuci va Ela, a̱vu u ka̱mbuwa̱i a̱ tyo Yahuda a mantsa ma na Dada va̱ yi mogono Amaziya ma̱ kuwa̱i.<verse eid="2KI 14:22" /></para>
  <para style="s">Yerobowam va̱ ire mo o ta̱ Mogono ma Isra'ila</para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 14:23" />A̱tsuma̱ aa'wan kupa na̱ ozo o ton o tsugono tsa mogono Amaziya ulobo wa Yowash, mogono ma Yahuda, a̱vu Yerobowam ulobo wa Yehowash mogono ma Isra'ila mo wo o mogono a̱tsuma̱ Samariya, A̱vu u yuwan tsugono tsa aa'wan amunga na̱ za ta̱. <verse eid="2KI 14:23" /><verse number="24" style="v" sid="2KI 14:24" />U yuwan ta̱ iwuya elime A̱sulazuva. U vadala diga a̱tsuma̱ e iwuya i na Yerobowam ulobo wa Neba ma yuwain shi, za na u zuwai aza a Isra'ila a yuwain unusu. <verse eid="2KI 14:24" /><verse number="25" style="v" sid="2KI 14:25" />A̱yi ɗa za na ka̱mbuwa̱ yi iɗa ya Isra'ila u ununa u da̱na̱i ɗe nu ufaru diga Lebo Hamat, a̱ tyo a mala ma Araba, ununa adanshi A̱sulazuva A̱sula̱ a Isra'ila a dammai, o una̱ wa aagbashi yi Yunana ulobo wa Amita, za na da̱na̱i vumava̱sula̱ diga a Gat Hefa<note caller="+" style="f"><char style="fr" closed="false">14:25 </char><char style="ft" closed="false">Ka̱lyuwa̱: Yah 1:1.</char></note>. <verse eid="2KI 14:25" /><verse number="26" style="v" sid="2KI 14:26" />A̱sulazuva ene ta̱ a̱tsuma̱lima̱ a na suru vuma a̱tsuma̱ Isra'ila o sowuso, agbashi na̱ aza a na a̱ ri fa̱a̱n, suru nle a̱ da̱na̱ ta̱ a̱tsuma̱lima̱ lon. Waru babu za na a kamba le. <verse eid="2KI 14:26" /><verse number="27" style="v" sid="2KI 14:27" />Agba A̱sulazuva a damma a na wa tasa ala aza a Isra'ila diga o uvaɗi shi, a̱vu u wawa le diga ekere Yerobowam ulobo wa Yowash.<verse eid="2KI 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 14:28" />Akapi o ulinga u tsugono tsa Yerobowam, na̱ suru ili i na u yuwain, na̱ suru u lyuwu wa̱ elime wa a̱soja a̱ yi, nu ununa u ka̱mbuwa̱a̱ yi a aza a Isra'ila na̱ lyuci va Dimaska na̱ Hamat, a aza a na a̱ ri a aza a Yahuda, suru ili ya nda a̱ da̱na̱ ta̱ pe uɗanu a̱tsuma̱ aatagada alabari o ngono ma Isra'ila. <verse eid="2KI 14:28" /><verse number="29" style="v" sid="2KI 14:29" />A̱vu Yerobowam kuwa̱ ucina nkaya ma̱ yi ngono ma aza a Isra'ila. A̱vu Zakariya ulobo wa̱ yi mo o mogono o una̱ wa̱ yi.<verse eid="2KI 14:29" /></para>
  <chapter eid="2KI 14" />
  <chapter number="15" style="c" sid="2KI 15" />
  <para style="s">Azariya Mogono ma Yahuda</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 15:1" />A̱tsuma̱ a aa'wan o ushin na̱ a̱za̱ e cindere o tsugono tsa Yerobowam Mogono ma Isra'ila, a̱vu Azariya ulobo wa Amaziya mogono ma Yahuda ma̱ teme tsugono. <verse eid="2KI 15:1" /><verse number="2" style="v" sid="2KI 15:2" />U da̱na̱ ta̱ na aa'wan kupa na̱ a̱za̱ ta̱li a mantsa ma na u temei tsugono'o, agba a̱vu u yuwan aa'wan kupoton na̱ ejere a yuwusan tsugono a̱tsuma̱ a Urushelima. Aala a mma va yi ɗa Yekoliya, diga Urishelima. <verse eid="2KI 15:2" /><verse number="3" style="v" sid="2KI 15:3" />U yuwan ta̱ ili i na i ri mejege elime A̱sulazuva, ununa Dada va yi Amaziya yuwain. <verse eid="2KI 15:3" /><verse number="4" style="v" sid="2KI 15:4" />Amma suru na̱ ne, o kototo ba̱ta̱ va̱ a̱ga̱nda̱ shi, a̱vu a ama a̱ da̱na̱ a yuwusan ukula̱tosu le na̱ ili ma̱guru ba̱ta̱'a̱.<verse eid="2KI 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 15:5" />A̱vu A̱sulazuva a lyunguwa̱ mogono'o na̱ mɓa̱la̱ mu ukutu ma̱ lipu hali u kuwa̱, u da̱na̱ ta̱ utakatsuwu nu u'wa wa̱ yi e nde'en. Ulobo wa̱ yi Yotam ɗa da̱na̱i e idanusan ukobu u mogono nu u yuwusan yi tsugbain tsa ama e iɗa'a.<verse eid="2KI 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 15:6" />Akapi o ulinga u na Azariya yuwain suru a̱ da̱na̱ ta̱ pe uɗanu a̱tsuma̱ aatagada alabari o ngono ma a Yahuda. <verse eid="2KI 15:6" /><verse number="7" style="v" sid="2KI 15:7" />A̱vu Azariya kuwa̱ ucina nkaya ma̱ yi, a̱vu a̱ciɗyo yi a̱tsuma̱ a̱ lyuci gbain va̱ Da̱wuda. A̱vu Yotam ulobo wa̱ yi mo o mogono o una̱ wa̱ yi.<note caller="+" style="f"><char style="fr" closed="false">15:7 </char><char style="ft" closed="false">Ka̱lyuwa̱: Isha 6:1.</char></note><verse eid="2KI 15:7" /></para>
  <para style="s">Zakariya mogono ma Isra'ila</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 15:8" />A̱tsuma̱ a aa'wan mata'atsu na̱ kunla̱ tsa tsugono tsa mogono Azariya va Yahuda, Zakariya ulobo wa Yerobowam mo o'woi mogono ma Isra'ila a̱tsuma̱ Samariya, a̱vu u yuwan tsugono tsa woto ta̱li. <verse eid="2KI 15:8" /><verse number="9" style="v" sid="2KI 15:9" />Agba u yuwan ta̱ iwuya elime A̱sulazuva, ununa nkaya ma̱ yi n yuwain. U vadala diga o unusu wa Yerobowam ulobo wa Neba shi, a aza a na u zuwai a aza a Isra'ila a yuwain.<verse eid="2KI 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 15:10" />A̱vu Shalum ulobo wa Jabesh yuwan ifoɓi i na wo o una Zakariya. A̱vu a̱ ga̱la̱i o unai elime a ama, reve a̱yi wo o mogono. <verse eid="2KI 15:10" /><verse number="11" style="v" sid="2KI 15:11" />Akapi o ulinga u na Zakariya yuwain, da̱na̱ ta̱ pe uɗanu a̱tsuma̱ aatagada alabari ngono ma Isra'ila. <verse eid="2KI 15:11" /><verse number="12" style="v" sid="2KI 15:12" />Adama o ndolo ɗa a adanshi a na A̱sulazuva a yuwain o una̱ wa Yehu shiwain. Za na u dammai, &lt;&lt;Ugundo wa wu u ta yuwan tsugono tsa a Isra'ila acina a mantsa ma̱a̱ na̱shi.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:12 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Ngo 10:30.</char></note><verse eid="2KI 15:12" /></para>
  <para style="s">Shalum mogono ma Isra'ila</para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 15:13" />Shalum ulobo wa Jabesh mo o ta̱ mogono a̱tsuma̱ aa'wan mata'atsu na̱ kucci o tsugono tsa mogono Uziya va Yahuda, waru u yuwan ta̱ tsugono tsa a Samariya woto uta̱.<verse eid="2KI 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 15:14" />A̱vu Menahem ulobo wa Gadi ma̱ ka̱ra̱ a̱ tyo Tirza ɗe Samariya. A̱vu u riya̱ Shalum ulobo wa Jabesh nu uvon ɗe Samariya, a̱vu wu u unai wo o mogono. <verse eid="2KI 15:14" /><verse number="15" style="v" sid="2KI 15:15" />Akapi o ulinga u na Shalum yuwain, na̱ suru ifoɓi i na u yuwain, a̱ da̱na̱ ta̱ pe uɗanu a̱tsuma̱ aatagada alabari o ngono ma Isra'ila.<verse eid="2KI 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 15:16" />A mantsa ma na Menahem da̱na̱i a mmalu a̱ tyo Tirza, a na wa̱ ta̱wa̱ u kototo iɗa ya Tifsa, a̱vu a ama a lyuci'i a 'yuwan a na a̱ kpa̱tu'wa̱ una̱ntsutsu u lyuci. A̱vu u kototo Tifsa hali wu ɗa̱ra̱ a̱ma̱ci a na a̱ shi na̱ a̱tsuma̱.<verse eid="2KI 15:16" /></para>
  <para style="s">Menahem mogono ma Isra'ila</para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 15:17" />A̱tsuma̱ aa'wan mata'atsu na̱ kucci o tsugono tsa Azariya mogono ma Yahuda, Menahem ulobo wa Gadi va Isra'ila me temei yi tsugono, a̱vu u yuwan tsugono tsa a Samariya aa'wan kupa.<verse eid="2KI 15:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 15:18" />U yuwan ta̱ iwiya elime A̱sulazuva. Suru a rana wuma wa̱ yi u vadala diga o unusu wa Yerobowam ulobo wa Neba shi, a aza a na u zuwai a aza a Isra'ila a yuwain.<verse eid="2KI 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 15:19" />A̱vu Pul mogono ma a Asuriya ma̱ ta̱wa̱ nu uvon a̱tsuma̱ e iɗa'a, a̱vu Menahem ca yi ukunzuwu u azurufa ukpakukupa (1,000) adama a na wa a kamba yi ununa tsugono tsa yi tsa e isawan nu ucira lon.<note caller="+" style="f"><char style="fr" closed="false">15:19 </char><char style="ft" closed="false">Ful mogono: Waru e revei ta̱ na aala fo &lt;&lt;Mogono Tigla Filesa.&gt;&gt;</char></note> <verse eid="2KI 15:19" /><verse number="20" style="v" sid="2KI 15:20" />Menahem tsura̱ ta̱ ikebe diga uba̱ta̱ wa ozo utsuru wa a aza a Isra'ila. Za vu utsuru biti ta̱wa̱ ta̱ nu utafu wa̱ yi uba̱ta̱ mogono Asuriya azurufa kupoton. A̱vu mogono ma Asuriya ma̱ ka̱mba̱, agba u ta̱wa̱ nu uvon a̱tsuma̱ e iɗa'a waru shi.<verse eid="2KI 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 15:21" />Akapi o ulinga u na mogono Menahem ma yuwain, na̱ suru ili i na u yuwain a̱ da̱na̱ ta̱ pe uɗanu a̱tsuma̱ aatagada alabari o ngono ma Isra'ila. <verse eid="2KI 15:21" /><verse number="22" style="v" sid="2KI 15:22" />A̱vu Menahem kuwa̱ ucina nkaya ma̱ yi. A̱vu ulobo wa̱ yi Pekahiya mo o'wo mogono o una̱ wa̱ yi.<verse eid="2KI 15:22" /></para>
  <para style="s">Fekahiya mogono ma Isra'ila</para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 15:23" />A̱tsuma̱ a aa'wan kupoton o tsugono tsa mogono Azariya va Yahuda, Pekahiya ulobo wa Menahem ma temei tsugono tsa Isra'ila a̱tsuma̱ a Samariya, a̱vu u yuwan tsugono tsa a'wan e re. <verse eid="2KI 15:23" /><verse number="24" style="v" sid="2KI 15:24" />Pekahiya yuwan ta̱ ulinga wi iwuya e ekere A̱sulazuva. Agba u vadala diga o unusu wa Yerobowam ulobo wa Neba shi, a aza a na u zuwai a aza a Isra'ila a yuwain. <verse eid="2KI 15:24" /><verse number="25" style="v" sid="2KI 15:25" />A̱vu yali ya̱ a̱ a̱soja a̱yi Peka ulobo wa Remaliya u zami yu ure u na wa una yi. A̱vu u tara a̱soja kupoton diga Giliyadu oɓolo na̱ yi, a̱vu wu una Pekahiya, oɓolo na̱ Argo na̱ Ariya, a̱ yi pe o ukobu u tsugono tsa Samariya. A̱vu Peka una Pekahiya a̱vu wo o mogono.<verse eid="2KI 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 15:26" />Akapi o ulinga u na Pekahiya yuwain, na̱ suru u linga u na u yuwain a̱ da̱na̱ ta̱ pe uɗanu a̱tsuma̱ aatagada alabari o ngono ma Isra'ila.<verse eid="2KI 15:26" /></para>
  <para style="s">Feka mogono ma Isra'ila</para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 15:27" />A̱tsuma̱ aa'wan kupoton na̱ ejere o tsugono tsa mogono Azariya va Yahuda, Peka ulobo wa Remaliya me temei tsugono tsa a Isra'ila a̱tsuma̱ a Samariya, a̱vu u yuwan tsugono tsa aa'wan ushin. <verse eid="2KI 15:27" /><verse number="28" style="v" sid="2KI 15:28" />A̱vu u yuwan iwuya ekere a̱ A̱sulazuva. Agba u vadala diga o unusu u na Yerobowam ulobo wa Neba ma yuwain shi, a aza a na u zuwai a aza a Isra'ila a yuwain.<verse eid="2KI 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 15:29" />A mantsa ma tsugono tsa mogono Peka va Isra'ila, Tigla Pilesa mogono ma Asuriya ma̱ ta̱wa̱ ta̱ usa lyuci va Iyon, na̱ za va Abel Bet Ma'aka na̱ Yanowa na̱ Kedesh na̱ Hazo. A̱vu u usa Giliyadu na̱ Ga̱lili, oɓolo na̱ suru upasu wa Nafutali, a̱vu u tara ama'a a̱ 'ya̱wa̱ tsugbashi a̱ lyuci va Asuriya. <verse eid="2KI 15:29" /><verse number="30" style="v" sid="2KI 15:30" />A̱vu Hosiya ulobo wa Ela ma yuwaan ifoɓi adama a na wa una Peka ulobo wa Remaliya. A̱vu u ga̱la̱i yi wu u unai, a̱vu wo o'wo mogono a̱tsuma̱ aa'wan o ushin u tsugono tsa Yotam ulobo wa Uziya. <verse eid="2KI 15:30" /><verse number="31" style="v" sid="2KI 15:31" />Suru akapi o ulinga wa Peka na̱ suru ili i na u yuwain a̱ da̱na̱ ta̱ pe uɗanu a̱tsuma̱ aatagada alabari o ngono ma Isra'ila.<verse eid="2KI 15:31" /></para>
  <para style="s">Yotam mogono ma Yahuda</para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 15:32" />A̱tsuma̱ a aa'wan e ire o tsugono tsa Peka ulobo wa Remaliya mogono ma Isra'ila, Yotam ulobo wa Uziya mogono me temei tsugono tsa Yahuda. <verse eid="2KI 15:32" /><verse number="33" style="v" sid="2KI 15:33" />U da̱na̱ ta̱ na aa'wan ushin na̱ ejere a mantsa ma na wo o yi mogono, a̱vu u yuwan tsugono tsa Urishelima aa'wan kupa na̱ a̱za̱ ta̱li. Aala a mma va yi ɗa Yerusha usheli wa Saduku. <verse eid="2KI 15:33" /><verse number="34" style="v" sid="2KI 15:34" />A̱vu u yuwan ili i na i ri mejege uba̱ta̱ wa̱ A̱sulazuva, ununa Dada va yi Uziya yuwain. <verse eid="2KI 15:34" /><verse number="35" style="v" sid="2KI 15:35" />Amma suru na̱ ne, o kototo ba̱ta̱ va̱ a̱ga̱nda̱ shi, a̱vu a ama a̱ da̱na̱ a yuwusan ukula̱tosu u le ni ili i ma̱guru uba̱ta̱'a̱. Yotam suwisa ta̱ una̱ntsutsu wa zuva wa̱ A̱a̱'isamapaɗa a̱ A̱sulazuva.<verse eid="2KI 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 15:36" />Suru akapi o ulinga u na Yotam yuwain o tsugono tsa yi, na̱ suru ili i na u yuwain a̱ da̱na̱ ta̱ pe uɗanu a̱tsuma̱ aatagada alabari o ngono ma a Yahuda. <verse eid="2KI 15:36" /><verse number="37" style="v" sid="2KI 15:37" />A̱tsuma̱ a rana ndolo ɗa A̱sulazuva a fara a̱ lyungusa̱ yi mogono Rezin va Suriya na̱ mogono Peka ulobo wa Remaliya uvon a̱tsuma̱ a Yahuda. <verse eid="2KI 15:37" /><verse number="38" style="v" sid="2KI 15:38" />A̱vu Yotam kuwa̱ ucina nkaya ma̱ yi, a̱vu a̱ciɗyo yi a̱tsuma̱ a̱ lyuci gbain va̱ kaka va̱ yi Da̱wuda. A̱vu ulobo wa̱ yi Ahaz mo o mogono o una̱ wa̱ yi.<verse eid="2KI 15:38" /></para>
  <chapter eid="2KI 15" />
  <chapter number="16" style="c" sid="2KI 16" />
  <para style="s">Ahaz Mogono ma Yahuda</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 16:1" />A̱tsuma̱ aa'wan kupa na̱ a̱za̱ cindere o tsugono tsa Peka ulobo wa Remaliya, Ahaz ulobo wa Yotam mogono ma Yahuda me temei tsugono. <verse eid="2KI 16:1" /><verse number="2" style="v" sid="2KI 16:2" />Ahaz da̱na̱ ta̱ na a aa'wan ushin a na wo o yi mogono, a̱vu u yuwan tsugono tsa Urishelima aa'wan kupa na̱ a̱za̱ ta̱li. U yuwan ununa Da̱wuda yuwain shi, agba u yuwan ili i na i ri mejege elime A̱sulazuva A̱sula̱ a̱yi shi. <verse eid="2KI 16:2" /><verse number="3" style="v" sid="2KI 16:3" />Amma u yuwan ta̱ mmalu a̱tsuma̱ o u re wu ngono ma aza a Isra'ila, hali u ca olobo a̱ yi kucci vu ukula̱tosu, a̱vu u da̱na̱ a yuwusan ili yi idaba oɓolo na̱ nɗa n na A̱sulazuva a̱ gba̱ra̱i elime aza a Isra'ila.<note caller="+" style="f"><char style="fr" closed="false">16:3 </char><char style="ft" closed="false">Ka̱lyuwa̱: U.Wl 12:31.</char></note> <verse eid="2KI 16:3" /><verse number="4" style="v" sid="2KI 16:4" />U ca ta̱ kucci vu ukula̱tosu na̱ kucci vi ili i ma̱guru ba̱ta̱ masa'a, na̱ zuva va agaɗi, na̱ suru a̱tsuma̱ aa ɗanga na ri kpa̱la̱m.<verse eid="2KI 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 16:5" />A̱vu mogono Rezin va Suriya na̱ Peka ulobo wa Remaliya mogono ma Isra'ila ma̱ ka̱ra̱ adama a na a yuwan uvon a̱tsuma̱ a Urishelima a̱vu a̱ ka̱nda̱ruwa̱ Ahaz nu uvon, amma a gura lyuwai nu uvon shi.<note caller="+" style="f"><char style="fr" closed="false">16:5 </char><char style="ft" closed="false">Ka̱lyuwa̱: Isha 7:1.</char></note> <verse eid="2KI 16:5" /><verse number="6" style="v" sid="2KI 16:6" />A mantsa mo ndolo mogono Rezin va Suriya ma̱ ushi ta̱ iɗa ya Ela adama a Suriya, a̱vu a̱ gba̱ra̱ a ama a Yahuda diga Ela, reve aza a Edom a̱ ka̱ra̱ a̱ tyo Ela a̱vu a̱ da̱nu ɗe hali acina a na'an nda.<verse eid="2KI 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 16:7" />A̱vu Ahaz lyungu na̱ nlingata a̱ tyo ya̱ mogono Tigla Pilesa vi iɗa ya a Asuriya, &lt;&lt;A̱mu aagbashi a̱ wu a ɗa, ulobo wa̱ wu waru. Ta̱wa̱ adama a na va wawa mu diga o ukere u mogono ma Asuriya na̱ waru diga o ukere u mogono ma aza a Isra'ila, aza a na a̱ riya̱sa̱ mu nu uvon.&gt;&gt; <verse eid="2KI 16:7" /><verse number="8" style="v" sid="2KI 16:8" />A̱vu Ahaz pura̱ azurufa na̱ zinariya diga a̱tsuma̱ A̱a̱'isamapaɗa a̱ A̱sulazuva na̱ diga uba̱ta̱ wi izuwa yu ukobu u tsugono, a̱vu u lyungu ne le une'e a̱ tyo ya mogono ma Asuriya. <verse eid="2KI 16:8" /><verse number="9" style="v" sid="2KI 16:9" />A̱vu mogono ma Asuriya mo foɓo adama a na wa̱ riya̱a̱ Dimaska nu uvon, a̱vu gba u lyuwai nu uvon. A̱vu u pura̱ suru ama a̱ yi a̱ tyo Kir tsugbashi, a̱vu wu una Rezin ɗe.<verse eid="2KI 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 16:10" />A̱vu Mogono Ahaz ma̱ ka̱ra̱ a̱ tyo Dimaska adama a na wa a ga'an na̱ mogono Tigla Pilesa va Asuriya. A̱vu we ene'e Masa'a a̱tsuma̱ Dimaska, a̱vu u lyunguwa̱a̱ Uriya ganu u rono masa'a'a ni iɗana agalaci ununa aa suwa ni yi. <verse eid="2KI 16:10" /><verse number="11" style="v" sid="2KI 16:11" />A̱vu Uriya ganu u suwa masa'a'a ununa mogono Ahaz ma damma ni yi za na u lyunguwa̱a̱ niyi diga Dimaska, a̱vu waru u kotoi kafu mogono Ahaz ma vadala a̱ ka̱mba̱. <verse eid="2KI 16:11" /><verse number="12" style="v" sid="2KI 16:12" />A mantsa ma na mogono ma̱ ka̱mba̱i diga Dimaska, a̱vu we ene'e masa'a'a, a̱vu u ta̱wa̱ zuzu, a̱vu u ca ɗe kucci. <verse eid="2KI 16:12" /><verse number="13" style="v" sid="2KI 16:13" />A̱vu u ca kucci vu ukula̱tosu na̱ za vi ishina, a̱vu u tsun ɗe kucci vi ili yo oso, a̱vu wu kyo'onu mpasa kucci muwwulai zuva masa'a'a. <verse eid="2KI 16:13" /><verse number="14" style="v" sid="2KI 16:14" />Masa'a ma̱ rumushili ma na ma̱ ri mishin elime A̱sulazuva, a̱vu a̱ ta̱wa̱ na̱ yi zuzu na̱ A̱a̱'isamapaɗa diga masa'a ma sa'avu ma̱ A̱a̱'isamapaɗa a̱ A̱sulazuva, a̱vu a zuwai o upasu wu ugana u masa'a ma sa'avu.<note caller="+" style="f"><char style="fr" closed="false">16:14 </char><char style="ft" closed="false">Ka̱lyuwa̱: Mta̱ 27:1-2; 2 Alb 4:1.</char></note><verse eid="2KI 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 16:15" />A̱vu mogono Ahaz ma damma Uriya ganu, &lt;&lt;Zuva masa'a ma sa'avu'u, vu ca kucci vu ukula̱tosu vu usana ɗe, na̱ kucci vi ishina yu ulivu, na̱ kucci vu ukula̱tosu na̱ vi ishina i mogono, na̱ kucci vu ukula̱tosu wa a ama suru wi iɗa'a, na̱ kucci vi ishina na̱ za vi ili yo oso. A̱vu waru wu kyo'onu mpasa n kucci vu ukula̱tosu na̱ i kucci suru zuva va Masa'a. Amma n ta yuwan ulinga na̱ masa'a ma̱ rumushili, adama a na a̱mu me e reve ili i na yaa fara.&gt;&gt; <verse eid="2KI 16:15" /><verse number="16" style="v" sid="2KI 16:16" />A̱vu Uriya ganu yuwan u ununa Ahaz mogono ma damma ni yi.<verse eid="2KI 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 16:17" />A̱vu mogono Ahaz ma paɗa suru ukosu wu uba̱ta̱ wa̱ yi, a̱vu wu uta̱a̱ pe aakwanu a gbain diga pe. A̱vu a tawa pe akwanu a gbai'in, za na da̱na̱i lo a̱ mɓa̱nga̱ mi inan yi rumushili, a̱vu u zuwa yi zuva va aatali.<note caller="+" style="f"><char style="fr" closed="false">16:17 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 7:23-39; 2 Ngo 4:2-6.</char></note> <verse eid="2KI 16:17" /><verse number="18" style="v" sid="2KI 16:18" />A̱vu u tawa ili i na a̱ ɓa̱ru yi ure za na a suwai pe a̱tsuma̱ A̱a̱'isamapaɗa o uranu wa ashibi, a̱vu waru u tawa itana i na i ri o una̱ntsutsu u ma uwa ma̱ A̱a̱'isamapaɗa a̱ A̱sulazuva za mogono. Adama a na mogono Asuriya me e ne'e le wan.<verse eid="2KI 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 16:19" />Akapi o ulinga u na Ahaz yuwain o tsugono tsa yi, na̱ ili i na u yuwain biti, a̱ da̱na̱ ta̱ pe uɗanu a̱tsuma̱ aatagada alabari o ngono ma a Yahuda. <verse eid="2KI 16:19" /><verse number="20" style="v" sid="2KI 16:20" />A̱vu Ahaz kuwa̱ ucina nkaya ma̱ yi, a̱vu a̱ciɗyo yi a̱tsuma̱ lyuci va Da̱wuda. A̱vu Hezekiya ulobo wa̱ yi mo o mogono o una̱ wa̱ yi.<note caller="+" style="f"><char style="fr" closed="false">16:20 </char><char style="ft" closed="false">Ka̱lyuwa̱: Isha 14:28.</char></note><verse eid="2KI 16:20" /></para>
  <chapter eid="2KI 16" />
  <chapter number="17" style="c" sid="2KI 17" />
  <para style="s">Hosheya Mogono ma Isra'ila</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 17:1" />A̱tsuma̱ aa'wan kupa ne ejere o tsugono tsa mogono Ahaz va Yahuda, Hosheya ulobo wa Ela va Isra'ila me temei tsugono a̱tsuma̱ a Samariya, A̱vu u yuwan tsugono tsa aa'wan kucci. <verse eid="2KI 17:1" /><verse number="2" style="v" sid="2KI 17:2" />Agba u yuwan ta̱ iwuya elime a̱ A̱sulazuva, agba u yuwan ununa ozo tsugono tsa Isra'ila aza a na a̱ da̱na̱i elime yi a yuwain shi.<verse eid="2KI 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 17:3" />A̱vu mogono Shalmanesa va Asuriya ma̱ 'ya̱wa̱a̱ mogono Hosheya nu uvon, za na da̱na̱i aagbashi aza a Shalmanesa a̱vu waru gba u tsupisa le utafa. <verse eid="2KI 17:3" /><verse number="4" style="v" sid="2KI 17:4" />Amma mogono ma aza a Asuriya me e reve ta̱ a na Hosheya za va aciyogbamu u ɗa, adama a na u lyungu yi na̱ nlingata a̱ tyo uba̱ta̱ mogono So va Masar adama a na wa a kamba yi, agba u tsupisa utafa a̱ tyo ya Shalmanesa mogono ma Asuriya shi, ununa u tsu yuwusan a'wan a'wan. Adama o ndolo reve Shalmanesa me remei a̱vu zuwai a̱tsuma̱ o u'wa wa ali. <verse eid="2KI 17:4" /><verse number="5" style="v" sid="2KI 17:5" />A̱vu mogono ma aza a Asuriya ma̱ ta̱wa̱ nu uvon suru uba̱ta̱'a̱ a̱tsuma̱ e iɗa'a, hali u rawa a̱tsuma̱ aza a Samariya a lyuwusa yi nu uvon hali acina aa'wan a ta'atsu. <verse eid="2KI 17:5" /><verse number="6" style="v" sid="2KI 17:6" />A̱tsuma̱ aa'wan a̱ kuci tsa tsugono tsa Hosheya mogono ma Asuriya, ma lyuwa ta̱ Samariya nu uvon, a̱vu u tara ama a Isra'ila a̱ tyo a̱tsuma̱ e iɗa ya Asuriya. A̱vu u zuwa le a na a̱ da̱nu pe a̱tsuma̱ Hala, na̱ a̱tsuma̱ Goza vu Uɗolu wa̱ Habo na̱ a̱tsuma̱ e i lyuci ya Midiya.<verse eid="2KI 17:6" /></para>
  <para style="s">Ili i na i zuwai a aza a Isra'ila a̱ riya̱i</para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 17:7" />Suru ili ya nda i fara ta̱ adama a na aza a Isra'ila a yuwain unusu u ɗa a̱ tyo ekere A̱sulazuva A̱sula̱ ele, za na uta̱ nle diga a̱tsuma̱ a Masar ekere mogono Firi'awuna mogono ma Masar. A̱vu waru aa yuwusaan musula̱ n ro a̱ga̱nda̱. <verse eid="2KI 17:7" /><verse number="8" style="v" sid="2KI 17:8" />A̱vu a yuwusan mmalu a̱tsuma̱ o ure we iɗa i na A̱sulazuva a̱ gba̱ra̱i yi pe a̱tsuma̱ e iɗa'a, adama a na ama a Isra'ila a̱ da̱nu pe uba̱ta̱'a̱, a̱vu a̱ da̱na̱ a yuwusan mmalu a̱tsuma̱ e ili i na ngono ma Isra'ila n rito su yi<note caller="+" style="f"><char style="fr" closed="false">17:8 </char><char style="ft" closed="false">Ka̱lyuwa̱: Josh 24:14-24; Mta̱ 18:3. </char></note>. <verse eid="2KI 17:8" /><verse number="9" style="v" sid="2KI 17:9" />A̱vu ama a Isra'ila a yuwusan ili i ro yu usokowu i na i da̱na̱i babu ulobonu a̱ tyo uba̱ta̱ wa̱ A̱sulazuva A̱sula̱ ele. Reve a suwusaa aciya ele uba̱ta̱ wa̱ a̱ga̱nda̱ a̱tsuma̱ e lyuci i le, na̱ a̱tsuma̱ mulyuci hali a̱ tyo e ilyuci i gbain yu ukari vu ucira. <verse eid="2KI 17:9" /><verse number="10" style="v" sid="2KI 17:10" />A̱vu a̱ a̱shiwa̱ atali a̱ a̱ga̱nda̱ na̱ a̱shuwutsu a Ashera zuva va aagaɗi suru, na̱ za̱la̱ vu uɗanga u kpa̱la̱m suru.<note caller="+" style="f"><char style="fr" closed="false">17:10 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 14:23.</char></note> <verse eid="2KI 17:10" /><verse number="11" style="v" sid="2KI 17:11" />A̱vu a casu ukula̱tosu wi ili i ma̱guru uba̱ta̱ wa̱ a̱ga̱nda̱ suru, ununa n nɗa n na A̱sulazuva a̱ gba̱ra̱i diga elime le a yuwusain. A yuwan ta̱ ili i iwuya za na a zuwai A̱sulazuva a yuwain upan. <verse eid="2KI 17:11" /><verse number="12" style="v" sid="2KI 17:12" />A̱vu a yuwusan musula̱ n ro a̱ga̱nda̱, agba waru A̱sulazuva a damma ta̱, &lt;&lt;She i yuwan ne wan.&gt;&gt; <verse eid="2KI 17:12" /><verse number="13" style="v" sid="2KI 17:13" />Mantsa suru A̱sulazuva a tsuɓarasa ta̱ Isra'ila na̱ Yahuda o una̱ wa a ama̱sula̱, na̱ o una̱ wa̱ a̱za̱ a̱ yindi suru u damma, &lt;&lt;I vadala a̱tsuma̱ o ure wi iwuya i ɗu! A̱vu i yuwan tsutoni na̱ wila̱ u va̱, nu uritosu u va̱, aza na n cayi nkaya nɗu, na aza a na n lyunguwa̱a̱ nɗu a̱tsuma̱ o una̱ wa agbashi a̱ va̱ ama̱sula̱.&gt;&gt; <verse eid="2KI 17:13" /><verse number="14" style="v" sid="2KI 17:14" />A̱vu ama a Isra'ila a̱ kuɗa̱ a na uwwa, a̱vu a yuwan aciyogbamu, ununa nkaya nle n yuwain, aza a na a̱ kuɗa̱i na a ca okolo ele uba̱ta̱ wa̱ A̱sulazuva A̱sula̱ e le. <verse eid="2KI 17:14" /><verse number="15" style="v" sid="2KI 17:15" />A̱vu a 'yuwan wila̱ wa̱ yi, oɓolo na̱ nzuwulai n na u yuwain na̱ nkaya nle, na̱ tsuɓari tsa yi a na u yuwaan le. A̱vu a yuwan tsutoni na̱ musula̱ me pere, reve le fo wo o ama e pere, a̱vu o uritosu i ili i na nɗa n ro n tsu yuwusan, aza a na a̱ ri uka̱nda̱ruwu na̱ le agba A̱sulazuva a damma le ta̱, &lt;&lt;She i yuwan ununa e le a tsu yuwusan wan,&gt;&gt; reve a yuwusan ili i na A̱sulazuva a damma n le a yuwan wan.<verse eid="2KI 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 17:16" />Ama Isra'ila a 'yuwan ta̱ a na a yuwan tsutoni na̱ A̱sulazuva A̱sula̱ e le. A̱vu a̱ zuɗa̱ aciya le iroci mudindim n re oɓolo na̱ musula̱ ma Ashera. A̱vu ama a yuwusan a̱ga̱nda̱ a̱ tyo wu uba̱ta̱ wu urana na̱ woto na̱ italyo'o, a̱vu waru a yuwusan Ba'al a̱ga̱nda̱.<note caller="+" style="f"><char style="fr" closed="false">17:16 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 12:28.</char></note> <verse eid="2KI 17:16" /><verse number="17" style="v" sid="2KI 17:17" />A̱vu a ca kucci vu ukula̱tosu muwun mo olobo n le na̱ esheli. A̱vu a yuwusan yindi, a̱vu a yuwusan nkunu a̱vu a ca aciya̱le ekere e ili i na i ri iwuya uba̱ta̱ wa̱ A̱sulazuva, za na a zuwa ni yi u yuwain upa'an.<note caller="+" style="f"><char style="fr" closed="false">17:17 </char><char style="ft" closed="false">Ka̱lyuwa̱: U.Wl 18:10.</char></note><verse eid="2KI 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 17:18" />Adama o ndolo A̱sulazuva a̱ da̱na̱ ta̱ a yuwusan upan na̱ aza a Isra'ila, hali u tawa le a̱tsuma̱ o urewesu wa̱ yi. Ugundo wa Yahuda ɗa goon a lyawai.<verse eid="2KI 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 17:19" />Yahuda fo a yuwan tsutoni na̱ wila̱ wa̱ A̱sulazuva A̱sula̱ e le shi. A̱vu a yuwan tsutoni a̱tsuma̱ o ure u na aza a Isra'ila a̱ ta̱wa̱ yi. <verse eid="2KI 17:19" /><verse number="20" style="v" sid="2KI 17:20" />Adama o ndolo ɗa A̱sulazuva a 'yuwain suru a ama a Isra'ila, a̱vu u zuwa le a̱tsuma̱lima̱, hali acina mantsa ma na u ca le e ekere a n'yuwatan nle, acina mantsa ma na a tawa nle elime yi.<verse eid="2KI 17:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 17:21" />A mantsa ma na wu kasai Isra'ila diga o u'wa wa Da̱wuda, reve a katala Yerobowam ulobo wa Neba mogono me le. Amma a̱vu Yerobowam putsa aza a Isra'ila adama a na a yuwan tsutoni na̱ A̱sulazuva, a̱vu u zuwa le a na a yuwan ulinga wu unusu gbain. <verse eid="2KI 17:21" /><verse number="22" style="v" sid="2KI 17:22" />Ama Isra'ila a lyuwa ta̱ elime a yuwusan ulinga wu unusu u na Yerobowam yuwain agba a vadala diga uba̱ta̱ u le shi. <verse eid="2KI 17:22" /><verse number="23" style="v" sid="2KI 17:23" />Acina mantsa ma na A̱sulazuva u tawa nle diga elime yi, ununa u yuwain adanshi diga a̱tsuma̱ o una̱ wa ama̱sula̱. Adama o ndolo a̱vu a tara a aza a Isra'ila diga o uba̱ta̱ wu nden n le a̱ tyo Asuriya, agba a buwa ta̱ ɗe hali acina a na'an.<verse eid="2KI 17:23" /></para>
  <para style="s">Aza Asuriya a̱ va̱la̱ta̱ a̱tsuma̱ a Samariya</para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 17:24" />A̱vu mogono ma Asuriya ma̱ ta̱wa̱ na a ama diga a Babila, na̱ aza a Kuta na̱ Awwa na̱ Hamat na̱ Sefarwayim a̱vu a̱ da̱nu lo a̱tsuma̱ lyuci va Samariya o una̱ wa aza a Isra'ila. A̱vu a usa Samariya a̱vu a̱ da̱nu pe a̱tsuma̱ e ilyuci ya̱ yi. <verse eid="2KI 17:24" /><verse number="25" style="v" sid="2KI 17:25" />A̱tsuma̱ a̱ nden mu ufaru nle uba̱ta̱'a̱, agba a awwa wovon wa̱ A̱sulazuva shi, adama o ndolo ɗa u lyungu yi ni ikamu a̱tsuma̱ le, reve o una ozo o ro le. <verse eid="2KI 17:25" /><verse number="26" style="v" sid="2KI 17:26" />A̱vu a̱ ta̱wa̱a̱ mogono ma Asuriya nu u dammu, &lt;&lt;Ama a na vu zuwai a̱tsuma̱ e ilyuci ya Samariya e reve na̱ wila̱ u musula̱ mi iɗa'a shi. Adama o ndolo musula̱ mi iɗa'a ma̱ lyunguwa̱ le ta̱ ni ikamu a aza a na a̱ ri mo una ma̱ le.&gt;&gt;<verse eid="2KI 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 17:27" />Reve Mogono ma Asuriya ma ca le u dammu u damma, &lt;&lt;Lyungu yi ganu ta̱ uba̱ta̱'a̱ diga a̱tsuma̱ a ama a Isra'ila, a̱tsuma̱ aza a na a̱ pura̱i diga Samariya u ka̱mba̱ ɗe, adama a na wo rito ama'a ili i na musula̱ mi iɗa'a n cigai.&gt;&gt; <verse eid="2KI 17:27" /><verse number="28" style="v" sid="2KI 17:28" />Adama o ndolo a̱vu za ta̱ a̱tsuma̱ nan ganu aza a na a tarai diga Samariya, a̱vu u ka̱mba̱ u da̱nu a̱tsuma̱ Betel. A̱vu u rito le ununa a uwwa wovon wa̱ A̱sulazuva.<verse eid="2KI 17:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 17:29" />Amma iɗa suru a yuwan ta̱ musula̱ ma aciya̱ le a̱vu a zuwa le a̱tsuma̱ a̱ a̱'isa̱ ba̱ta̱ va̱ a̱ga̱nda̱, a aza a na aza a Samariya a̱ zuɗa̱i, iɗa suru u yuwan ta̱ ne a̱tsuma̱ e ilyuci na u ri na̱ nden. <verse eid="2KI 17:29" /><verse number="30" style="v" sid="2KI 17:30" />A̱vu a ama diga Babila a yuwan Suko Beno, a̱vu a ama a Kuta a yuwan Nerga, a̱vu a ama diga Hamat waru a yuwan Ashima, <verse eid="2KI 17:30" /><verse number="31" style="v" sid="2KI 17:31" />reve ama a Awwa a yuwan Nibha na̱ Tarta na a ama Sefarwayim a ca muwun nle adama a kucci vu ukula̱tosu a̱ tyo ya Adramele na̱ Anamale musula̱ ma Sefarwayim.<verse eid="2KI 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 17:32" />A̱vu a uwwa wovon wa̱ A̱sulazuva, reve a ɗangula a̱tsuma̱ ama ele e iwau aza a na a̱ da̱na̱ e idanasa le, nan ganu adama a na a ca ukula̱tosu u le ba̱ta̱ va̱ a̱ga̱nda̱'a̱.<note caller="+" style="f"><char style="fr" closed="false">17:32 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 12:31.</char></note> <verse eid="2KI 17:32" /><verse number="33" style="v" sid="2KI 17:33" />A̱vu a uwwa wovon wa̱ A̱sulazuva, suru na̱ ne a yuwusaan ta̱ musula̱ nle a̱ga̱nda̱, ununa nɗa n na n tara nle a̱ tyo tsugbashi a tsu yuwusan.<verse eid="2KI 17:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 17:34" />Sapu acina ana'an a nda a uwwa wovon wa̱ A̱sulazuva shi, agba a yuwusan tsutoni na̱ nzuwulai ma̱ yi shi, ko wila̱ wa̱ yi, ko uritosu wa̱ yi shi, ko wila̱ u na A̱sulazuva a ca yi ugundo wa Yakubu, za na u vadalai aala yi a̱ tyo Isra'ila.<note caller="+" style="f"><char style="fr" closed="false">17:34 </char><char style="ft" closed="false">Ka̱lyuwa̱: Ufr 32:28; 35:10.</char></note> <verse eid="2KI 17:34" /><verse number="35" style="v" sid="2KI 17:35" />A mantsa ma na A̱sulazuva a yuwain nzuwulai na aza a Isra'ila, a̱vu u damma le, &lt;&lt;She yu uwwa wovon u musula̱ n ro wan, ko na ya̱ kingyowa̱ le, ko na ya yuwan le tsugbashi, ko waru a na ya ca le kucci.<note caller="+" style="f"><char style="fr" closed="false">17:35 </char><char style="ft" closed="false">Ka̱lyuwa̱: Mta̱ 20:5; U.Wl 5:9.</char></note> <verse eid="2KI 17:35" /><verse number="36" style="v" sid="2KI 17:36" />Amma A̱sulazuva za na uta̱a̱ n ɗu a̱tsuma̱ e iɗa ya Masar nu ukere wu ukadu wa̱ yi nu ulinga wa asalama, a̱yi ɗa goon yaa awwa wovon. A̱yi ɗa goon ya̱a̱ kingyowa̱a̱, a̱yi ɗa goon ya ca kucci ɗu.<note caller="+" style="f"><char style="fr" closed="false">17:36 </char><char style="ft" closed="false">Ka̱lyuwa̱: U.Wl 6:13.</char></note> <verse eid="2KI 17:36" /><verse number="37" style="v" sid="2KI 17:37" />A̱vu i reve na a amayun i ta yuwusan tsutoni na̱ nzuwulai na̱ wila̱ na̱ uritosu wa̱ yi, nu uritosu u na u ɗanaa nɗu. Waru she yu uwwa wovon u musula̱ n ro wan. <verse eid="2KI 17:37" /><verse number="38" style="v" sid="2KI 17:38" />She yi icina na̱ nzuwulai n na n yuwain na̱ a̱ɗu wan. A na she yu uwwa wovon u musula̱ n ro wan. <verse eid="2KI 17:38" /><verse number="39" style="v" sid="2KI 17:39" />Amma, yu uwwa wovon wa̱ A̱sulazuva A̱sula̱ a̱ ɗu, a̱yi ɗa za na a̱ ta̱wa̱ u wawa a̱ ɗu ekere a n'yuwatan nɗu suru.&gt;&gt;<verse eid="2KI 17:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="2KI 17:40" />Amma suru na̱ ne, a̱vu a̱ kuɗa̱ adama a na uwwa, a̱vu a lyuwa elime na̱ tsutoni tsu ure u na u ri babu mejege.<verse eid="2KI 17:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="2KI 17:41" />Amma a̱vu nɗa nda a awwa wovon wa̱ A̱sulazuva, waru a̱vu a yuwusaan musula̱ n na a̱ zuɗa̱i a̱ga̱nda̱ fo. Sapu acina a ana'an muwun nle na̱ muwun n tsukaya nle a lyuwa ta̱ elime a yuwusan ununa nkaya nle n yuwusain.<verse eid="2KI 17:41" /></para>
  <chapter eid="2KI 17" />
  <chapter number="18" style="c" sid="2KI 18" />
  <para style="s">Hezekiya Mogono ma a Yahuda</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 18:1" />A̱tsuma̱ aa'wan a ta'atsu o tsugono tsa Hosheya ulobo wa Ela mogono ma Isra'ila, Hezekiya ulobo u mogono Ahaz va Yahuda me temei tsugono. <verse eid="2KI 18:1" /><verse number="2" style="v" sid="2KI 18:2" />U da̱na̱ ta̱ na aa'wan ushin na̱ ozo o ton a mantsa ma na wo o woi mogono, a̱vu u yuwan tsugono tsa Urishelima aa'wan ushin na̱ kucci. Aala a mma va yi ɗa da̱na̱i Abi, usheli wa Zakariya. <verse eid="2KI 18:2" /><verse number="3" style="v" sid="2KI 18:3" />A̱vu u yuwan ulinga u na u da̱na̱i mejege elime A̱sulazuva, ununa akaya a̱ yi Da̱wuda yuwain. <verse eid="2KI 18:3" /><verse number="4" style="v" sid="2KI 18:4" />A̱vu u kototo ba̱ta̱ va̱ a̱ga̱nda̱ na̱ atali a̱ga̱nda̱, a̱vu wu ɓuɓoso a̱shuwutsu a Ashera. A̱vu u kototo yo vu rumushili za na Musa yuwain, za na hali a acina a mantsa mo ndolo aza a Isra'ila a̱ da̱na̱i a yuwusan ukula̱tosu wi ili i ma̱guru ɗe. Za na a ca yi ala Nahushtan.<note caller="+" style="f"><char style="fr" closed="false">18:4 </char><char style="ft" closed="false">Mkc 21:9.</char></note> <verse eid="2KI 18:4" /><verse number="5" style="v" sid="2KI 18:5" />Hezekiya zuwa ta̱ okolo yi uba̱ta̱ wa̱ A̱sulazuva A̱sula̱ a Isra'ila. Adama o ndolo ɗa a̱tsura̱ mogono mo ro a̱tsuma̱ aza a tsugono tsa Yahuda tsa yi shi, elime yi ko a̱ca̱pa̱ yi shi. <verse eid="2KI 18:5" /><verse number="6" style="v" sid="2KI 18:6" />Hezekiya ɓana ta̱ A̱sulazuva. Agba u vadala diga a̱tsuma̱ e itoni ya̱ yi shi, amma a̱vu u yuwan tsutoni na̱ wila̱ u na A̱sulazuva a ca yi Musa. <verse eid="2KI 18:6" /><verse number="7" style="v" sid="2KI 18:7" />Waru A̱sulazuva a̱ da̱na̱ ta̱ oɓolo na̱ yi. Suru uba̱ta̱ u na Hezekiya 'ya̱wa̱i, u tsu tsura̱ ta̱ ulyuwu wa aci. U 'ya̱sa̱a̱n ta̱ mogono ma Asuriya aci, a̱vu 'yuwan a na wa yuwan yi a̱ga̱nda̱. <verse eid="2KI 18:7" /><verse number="8" style="v" sid="2KI 18:8" />A̱vu u lyuwa aza a Filistiya nu uvon a̱ tyo Gaza na̱ mulyuci ma̱ yi na acina ilyuci na̱ ri nu ukari.<verse eid="2KI 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 18:9" />A̱tsuma̱ aa'wan a̱ na̱shi o tsugono tsa mogono Hezekiya, za na da̱na̱i aa'wan cindere o tsugono tsa Hosheya ulobo wa Ela mogono ma Isra'ila, a̱vu mogono Shalmanesa va Asuriya ma̱ ta̱wa̱ nu uvon a̱tsuma̱ Samariya, a̱vu uka̱nda̱ruwa̱ lyuci'i. <verse eid="2KI 18:9" /><verse number="10" style="v" sid="2KI 18:10" />Ana aa'wan a ta'atsu o ndolo o kotoi a̱vu Asuriya usai. A usa ta̱ Samariya a̱tsuma̱ aa'wan a̱ ta̱li va Hezekiya, a̱tsuma̱ aa'wan a̱ kucci o tsugono tsa mogono Hosheya mogono ma Isra'ila. <verse eid="2KI 18:10" /><verse number="11" style="v" sid="2KI 18:11" />Mogono ma Asuriya ma̱ pura̱ ta̱ ama Isra'ila a̱ tyo Asuriya, a̱vu u da̱na̱to le a̱tsuma̱ a̱ lyuci va Hala, a̱tsuma̱ Goza za na da̱na̱i upasu wu uɗolu wa Habo, na̱ waru a̱tsuma̱ e ilyuci ya Midiya. <verse eid="2KI 18:11" /><verse number="12" style="v" sid="2KI 18:12" />Ili ya nda icina le ta̱ adama na a̱ kuɗa̱i a na a uwwa uɗyo wa̱ A̱sulazuva A̱sula̱ e le, a̱vu a kuɗa akucunu a̱yi, suru ili i na Musa aagbashi A̱sulazuva a dammai, reve ama'a a 'yuwan a na uwwa, a̱vu a 'yuwan a na a yuwan tsutoni na̱ wila̱ wa̱ yi.<verse eid="2KI 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 18:13" />A̱tsuma̱ a aa'wan kupa na̱ a̱za̱ na̱shi o tsugono tsa mogono Hezekiya, Senakerib mogono ma Asuriya ma̱ 'ya̱wa̱ ta̱ nu uvon a̱tsuma̱ e ilyuci i na i ri nu ukari a̱tsuma̱ a Yahuda suru, reve usa le. <verse eid="2KI 18:13" /><verse number="14" style="v" sid="2KI 18:14" />A̱vu Hezekiya mogono ma Yahuda ma̱ lyungu nu u dammu uba̱ta̱ mogono ma Asuriya a̱tsuma̱ lyuci va Lakish u damma, &lt;&lt;N yuwan wu ta̱ unusu, vu lyawa mu. Waru n ta tsupa wu suru ili i na vu damma nu mu.&gt;&gt;Adama o ndolo a̱vu mogono ma Asuriya ma zuwaa Hezekiya a na wa lyungwa̱ yi nu ukunzu ukpakukupa kupa (10,000) u azurufa na̱ ukunzu ukpakukupa (1,000) u zinariya. <verse eid="2KI 18:14" /><verse number="15" style="v" sid="2KI 18:15" />Hezekiya ɓolotowo yi ta̱ suru azurufa na da̱na̱i a̱tsuma̱ A̱a̱'isamapaɗa A̱sulazuva na̱ waru suru a aza na a̱ da̱na̱i a̱tsuma̱ asula e izuwa i mogono. <verse eid="2KI 18:15" /><verse number="16" style="v" sid="2KI 18:16" />A̱tsuma̱ a mantsa mo o ndolo Hezekiya mogono ma Yahuda ma kukura ta̱ zinariya na da̱na̱i o una̱ntsutsu nu usowoto wu upepu wa̱ A̱a̱'isamapaɗa A̱sulazuva, a̱vu u ca mogono ma Asuriya le.<verse eid="2KI 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 18:17" />A̱vu mogono ma Asuriya ma̱ lyungu nan yali ya̱ a̱soja a̱ yi, na̱ zagbain a̱ yi na azagbain o uvon a̱ yi, na̱ a̱soja a̱bunda̱, diga Lakish a̱ tyo ya mogono Hezekiya a̱tsuma̱ a Urishelima. A̱vu a̱ ka̱ra̱ a̱ tyo upasu wa̱ Urishelima a̱vu e isawan uba̱ta̱ u na mini ma̱ tsu utusa̱ aagaɗi, zuzu nu uba̱ta̱ u na a tsu yuwusan wuza̱'u.<note caller="+" style="f"><char style="fr" closed="false">18:17 </char><char style="ft" closed="false">Ka̱lyuwa̱: Isa 7:1-7. </char></note> <verse eid="2KI 18:17" /><verse number="18" style="v" sid="2KI 18:18" />Reve e ɗe mogono, na̱ Eliyakim ulobo wa Hilikiya zagbain vu u'wa mogono, na̱ Shebena za vi iɗana mogono, na̱ Jowa ulobo wa Asa za vi iɗana ya alabari reve o uta̱.<verse eid="2KI 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 18:19" />A̱vu zagbain vo ozo o uvon u damma le, damma yi Hezekiya, &lt;&lt;Apa nda ili i na mogono ma gbain mogono ma a aza a Asuriya ma a dammai, &lt;A̱ nye ɗa vu zuwai ucira wa̱ wu? <verse eid="2KI 18:19" /><verse number="20" style="v" sid="2KI 18:20" />Vu ta majiyan adanshi a ɗa uvon, nu ucira wu uvon? Ekere za ne ɗa vu zuwai ucira wa̱ wu gogo, hali na va̱ 'ya̱sa̱a̱n a̱mu aci? <verse eid="2KI 18:20" /><verse number="21" style="v" sid="2KI 18:21" />Ka̱lyuwa̱ gogo a na vu zuwai ucira wa̱ wu uba̱ta̱ wa Masar, za na ri ununa vu revei akunku a apumpu, za na tsu paɗa vuma o ukere, ko gba shi na̱ vu gbasato wo yi reve wamatowun! Na̱ ne ɗa mogono Firi'awuna ri na̱ suru aza a na a zuwa yi ucira u le ya̱ a̱ yi. <verse eid="2KI 18:21" /><verse number="22" style="v" sid="2KI 18:22" />Agba n ni i damma mu ta̱, &lt;&lt;Tsu zuwa ta̱ ucira u tsu uba̱ta̱ wa̱ A̱sulazuva A̱sula̱ a̱ tsu,&gt;&gt; a̱yi ɗa za na ri nu uba̱ta̱ wa̱ a̱ga̱nda̱ a̱ musula̱ na̱ musa'a a na Hezekiya kototo yi shi? A̱vu u damma Yahuda na̱ Urushalima,&lt;&lt;I reve gba i yuwan ta̱ a̱ga̱nda̱ a̱ tyo uba̱ta̱ masa'a ma nda a̱tsuma̱ Urishelima shi&gt;&gt;?<verse eid="2KI 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 18:23" />&lt;&lt; &lt;Ta̱wa̱ gogo, vu yuwan n dammulai na̱ zagbain a̱ va̱, mogono ma Asuriya. N ta ca wu ido ukpakukupa ure (2,000), na̱ vaa gura zuwa akumbi zuva le! <verse eid="2KI 18:23" /><verse number="24" style="v" sid="2KI 18:24" />Cine vaa gura lyuwa aaci a yali a̱tsuma̱ a aza a na a la'ai uka̱la̱mu a̱tsuma̱ a agbashi a zagbain va̱, ko na vaa zuwusaa Masar ucira adama e ikeke yi ido ya̱ yi oɓolo na akumbi e le? <verse eid="2KI 18:24" /><verse number="25" style="v" sid="2KI 18:25" />Suru na̱ ne fo, oɓolo nu ucira wa̱ A̱sulazuva ɗa a na u damma na̱ a̱mu tsu ka̱ra̱ agawan adama a na kototo yi shi? A̱vu A̱sulazuva a damma mu, ka̱ra̱ adama a na va yuwan uvon ni iɗa nda, vu kototo yi.&gt; &gt;&gt;<verse eid="2KI 18:25" /></para>
  <para style="b" />
  <para style="p">
    <verse number="26" style="v" sid="2KI 18:26" />A̱vu Eliyakim ulobo wa Hilikiya, na̱ Shebena na̱ Jowa a damma yali vu uvo'on, &lt;&lt;Tsu pati wu ta̱ a na va yuwan adanshi na agbashi a̱ wu na̱ elentsu a Arama, adama a na tsu ta uwusa yi. She vu yuwan adanshi na̱ tsu ne elentsu a Yahuda atsuvu a ama a wan, aza a na a̱ ri zuva vu ukari u lyuci a ta uwusa wu.&gt;&gt;<verse eid="2KI 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 18:27" />Amma a̱vu yali'i usu u damma, &lt;&lt;Ekere a zagbain ɗu ɗa na̱ a̱ɗu goon a na zagbain va̱ lyungu numu a na ma damma ili i yaa nda shi, amma hali na a ama a na a̱ ri na̱ nden upasu wu ukari fo, a aza na a vari yi tsa a̱ɗu a na a lyuwa a̱ya̱n le, a̱vu waru o sowo mazara ma̱ e le.&gt;&gt;<verse eid="2KI 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 18:28" />Amma a̱vu yali'i u 'yon mishin u ya̱sa̱n uɗyo wa̱ yi nu ucira lon u yuwan a adanshi ne elentsu aza a Yahuda u damma,</para>
  <para style="p" vid="2KI 18:28">&lt;&lt;Uwwa yi adanshi azagbain mogono, mogono ma Asuriya! <verse eid="2KI 18:28" /><verse number="29" style="v" sid="2KI 18:29" />Mogono ma damma ta̱, &lt;She i lyawa Hezekiya pala ɗu wan, adama a na wa gura wawa ɗu diga ekere a̱ va̱ shi.&gt; &gt;&gt; <verse eid="2KI 18:29" /><verse number="30" style="v" sid="2KI 18:30" />She i lyawa Hezekiya zuwa ɗu a na ya zuwa ucira u ɗu uba̱ta̱ wa̱ A̱sulazuva a na u dammai, &lt;&lt;Amayun gba A̱sulazuva a ta wawa tsu, lyuci nda a ca yi ekere mogono ma Asuriya shi.&gt;&gt;<verse eid="2KI 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 18:31" />&lt;&lt;Ili i na mogono'o ma dammai, to, a̱ yi ɗa, &lt;She i zuwa atsuvu ɗu uba̱ta̱ wa Hezekiya wan. Amma i zami yi nden n lafiya na̱ a̱mu a̱vu yu uta̱ i ta̱wa̱ uba̱tu u va. Suru nɗu za ta a gura lyuwa diga a̱tsuma̱ ataci a̱ ina̱bi a̱ yi nu ubiri, a̱vu u sowo mini diga o ura'atsu wa̱ yi. <verse eid="2KI 18:31" /><verse number="32" style="v" sid="2KI 18:32" />Hali a cina mantsa ma na ma̱a̱ ta̱wa̱ a̱vu n tara ɗu a̱ tyo e iɗa i na i ri za ɗu, iɗa i na i ri ni ishina na̱ masayan ma̱ inabi, ni ilyalya na̱ a̱ɗuma̱ a̱ inabi na̱ ɗanga mani'in ma̱ zetun, ni ishiki. Ɗangulai wuma a̱vu i lyawa ukwa̱! She izuwa atsuvu a̱ɗu uba̱ta̱ wa Hezekiya wan, a na wa pala ɗu u damma, A̱sulazuva a ta wawa tsu.&gt; &gt;&gt; <verse eid="2KI 18:32" /><verse number="33" style="v" sid="2KI 18:33" />A ta gura tsura̱ musula̱ mi nɗa i ro a na u wawa yi nɗa diga o ukere mogono ma Asuriya? <verse eid="2KI 18:33" /><verse number="34" style="v" sid="2KI 18:34" />A tee ɗa musula̱ ma Hamat na̱ Afa? A tee ɗa gba musula̱ ma Sefarwayim na̱ Hena na̱ Iva? A gura ta̱ wawa aza a Samariya diga ekere a̱ va̱? <verse eid="2KI 18:34" /><verse number="35" style="v" sid="2KI 18:35" />A̱tsuma̱ musula̱ mu uvaɗi nda suru, ma̱sula̱ ma̱ ne ɗa ma gura a na wa wawa ɗu ekere a̱ va̱? Sapu a na a damma A̱sulazuva a ta gura wawa Urishelima diga ekere a̱ va̱?<verse eid="2KI 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 18:36" />Amma reve a ama'a a̱ rungwa̱, agba a usu yi ko nu u dammu uta̱ shi, adama a na mogono ma damma ta̱, &lt;&lt;She a̱ usu yi wan.&gt;&gt; <verse eid="2KI 18:36" /><verse number="37" style="v" sid="2KI 18:37" />A̱vu Eliyakim ulobo wa Hilikiya zagbain vu u'wa mogono, na̱ Shebena za vi iɗana i mogono, na̱ Jowa ulobo wa Asa za vi iɗana yi ili i na i farai, suru nle a̱vu a̱ ta̱wa̱ uba̱ta̱ wa Hezekiya, na̱ a̱tugu le wukaru, a̱vu a damma yi adanshi a na zagbain va yali ya̱ a̱soja'a u dammai.<verse eid="2KI 18:37" /></para>
  <chapter eid="2KI 18" />
  <chapter number="19" style="c" sid="2KI 19" />
  <para style="s">Mogono Hezekiya zami ta̱ a̱sa̱la̱ diga uba̱ta̱ vumava̱sula̱ Ishaya</para>
  <para style="r">(<ref loc="ISA 37:1-7">Ish 37:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 19:1" />Ana Hezekiya Mogono ma uwwai adanshi'i, reve wu kara a̱tugu yi, a̱vu woto a̱tugu a̱tsuma̱la̱ngu. A̱vu uwwa a̱tsuma̱ A̱a̱'isa̱mapaɗa a̱ A̱sulazuva. <verse eid="2KI 19:1" /><verse number="2" style="v" sid="2KI 19:2" />Reve u lyungu Eliyakim zagbain vu u'wa u mogono, na̱ Shebena za vi iɗana oɓolo na zagbain nan ganu, suru le wotowu na̱ a̱tugu a̱tsuma̱la̱ngu, a̱ tyo u uba̱ta̱ u vumava̱sula̱ Ishaya ulobo wa Amoz. <verse eid="2KI 19:2" /><verse number="3" style="v" sid="2KI 19:3" />A̱vu a damma yi, &lt;&lt;Nda ili i na Hezekiya dammai, ana'an urana wa atakaci a ɗa, urana u tsuɓari nu wu casu u wono. Ununa muwun n tsu rawa mantsa ma limatan agba babu ucira una a matsan le. <verse eid="2KI 19:3" /><verse number="4" style="v" sid="2KI 19:4" />U ta gura wo o A̱sulazuva A̱sula̱ a̱ ɗu a uwwa ta̱ suru adanshi a yali vu uvo'on, za na zagbain va yi, mogono ma Asuriya, ma lyunguyi u yuwaan A̱sulazuva a wuma tsu zo'o, agba u ta yuwaan yi tsuɓari adanshi a na A̱sulazuva A̱sula̱ a̱ ɗu a uwwai. Waru vu vasa adama akapi ama a na abuwai wuma.&gt;&gt;<verse eid="2KI 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 19:5" />A mantsa ma na Ishaya uwwai ikaka i mogono Hezekiya diga uba̱ta̱ wa azagbain a̱ yi, <verse eid="2KI 19:5" /><verse number="6" style="v" sid="2KI 19:6" />a̱vu Ishaya damma le, &lt;&lt;Damma yi zagbain ɗu, &lt;Nda ili i na A̱sulazuva a damma yi, she vu uwwa wovon wa adanshi a na vu uwwai o una̱ mogono ma Asuriya a na u yuwain tsu zo'o aciya va̱ wan. <verse eid="2KI 19:6" /><verse number="7" style="v" sid="2KI 19:7" />Uwwa! n ta zuwa ruhu a̱tsuma̱ yi a na nu uwwa adanshi o ro, u ta̱ ka̱mba̱ e iɗa ya̱ yi, ɗe ɗa ma zuwa a na o unai na̱ matsun me pe'eni.&gt; &gt;&gt;<verse eid="2KI 19:7" /></para>
  <para style="s">Senakerib isula ta̱ A̱sulazuva</para>
  <para style="r">(<ref loc="ISA 37:8-20">Ish 37:8-20</ref>; <ref loc="2CH 32:17-20">2 Alb 32:17-20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 19:8" />Ana yali ya̱ a̱soja o mogono u ka̱mba̱i, reve u ga'an na̱ mogono ma Asuriya a yuwusan uvon na̱ Libina, adama a na yali'i wu uwwa ta̱ ɗe alabari a na mogono'o ma lyawa ta̱ ɗe lyuci va Lakish. <verse eid="2KI 19:8" /><verse number="9" style="v" sid="2KI 19:9" />Gogo a na mogono ma uwwa n le adanshi adama a ɗa a Tirhaka mogono ma̱ Itiyofiya,<note caller="+" style="f"><char style="fr" closed="false">19:9 </char><char style="ft" closed="false">Itiyofiya: Na̱ Tsuyahuda a ɗa ta̱ &lt;&lt;Kush&gt;&gt; ɗa pa nda'a. A̱yi aala a nda'a u tu uɓolo nu upasu wa̱ a̱livu Masar, nu upasu wa Sudan, nu upasu wa Itiyofiya, za na a̱ yi ɗa Habasha.</char></note> reve wu uta̱ na̱ a̱soja a̱ yi adama a na a̱ riya̱ yi nu uvon. A̱vu mogono ma̱ lyungu nlingata a̱ tyo wu uba̱ta̱ wa Hezekiya a dansa, <verse eid="2KI 19:9" /><verse number="10" style="v" sid="2KI 19:10" />&lt;&lt;Damma yi Hezekiya mogono ma Yahuda, she vu lyawa A̱sula̱ a̱ wu a̱ luma̱ luma̱ wu wan, u damma &lt;A ca Urishelima ekere mogono ma Asuriya shi.&gt; &gt;&gt; <verse eid="2KI 19:10" /><verse number="11" style="v" sid="2KI 19:11" />&lt;&lt;Amayun ɗa vu uwwa ta̱ ili i na mogono ma Asuriya ma yuwain na̱ nɗa, a na u kototo le suru suru. Agba a̱vu vu ta majiyan ma na vu ta la'a? <verse eid="2KI 19:11" /><verse number="12" style="v" sid="2KI 19:12" />Musula̱ mu nɗa i na nkaya n va̱ o kototo yi n wawa le ta̱, musula̱ ma̱ Goza na̱ Haran na̱ Reze na̱ ama Adini aza a na a̱ da̱na̱i Telasa? <verse eid="2KI 19:12" /><verse number="13" style="v" sid="2KI 19:13" />A tee ɗa mogono ma Hamat na̱ mogono ma Afa, a̱ tee ɗa mogono ma̱ lyuci va Sefarwayim na̱ mogono ma Hena ko za va Iva?&gt;&gt;<verse eid="2KI 19:13" /></para>
  <para style="s">Avasa a Hezekiya</para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 19:14" />Hezekiya ushi ta̱ mepepelime uba̱ta̱ wu nlingata'a a̱vu ɗe nu una̱. Avu u ka̱ra̱ na̱ yi a̱ tyo A̱a̱'isa̱mapaɗa a̱ A̱sulazuva a̱vu pa̱lu'wa̱ yi a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva. <verse eid="2KI 19:14" /><verse number="15" style="v" sid="2KI 19:15" />A̱vu Hezekiya yuwan avasa a̱ tyo uba̱ta̱ wa̱ A̱sulazuva u damma,</para>
  <para style="b" vid="2KI 19:15" />
  <para style="p" vid="2KI 19:15">&lt;&lt;A̱sulazuva, A̱sula̱ a Isra'ila, mogono ma na ma̱ ri yi nden zuva vi ikerobobi,<note caller="+" style="f"><char style="fr" closed="false">19:15 </char><char style="ft" closed="false">ikerobobi: Ikerobobi a aza a na a yuwain na̱ zinariya reve a̱shiwa̱ le zuva va̱ Akpati a Nzuwulai. Iroci i ɗa yo ootogu o tsugono tsa̱ A̱sulazuva a̱tsuma̱ o uvaɗi. Ka̱lyuwa̱: Mta̱ 25:28; 2 Sam 6:2. </char></note> a̱vu ɗa A̱sula̱ a aza a tsugono tsu vu uvaɗi suru. A̱vu ɗa vu yuwain zuva ni iɗa.<note caller="+" style="f"><char style="fr" closed="false">19:15 </char><char style="ft" closed="false">Ka̱lyuwa̱: Mta̱ 25:22; Irm 32:17; Ajy 4:24.</char></note> <verse eid="2KI 19:15" /><verse number="16" style="v" sid="2KI 19:16" />Zuwa atsuvu A̱sulazuva, a na va uwwa mu, kpa̱tu'wa̱ esu wu, A̱sulazuva a na ve ene, uwwa adanshi o tsu zo'o a na mogono Senakerib lyungu yi a na wi isulai A̱sula̱ a na a̱ ri wuma. <verse eid="2KI 19:16" /><verse number="17" style="v" sid="2KI 19:17" />Amayun ɗa A̱sulazuva, ngono ma Asuriya n ɗa n kototo yi nɗa ya̱ a̱bunda̱ ni iɗa i le. <verse eid="2KI 19:17" /><verse number="18" style="v" sid="2KI 19:18" />Adama a na oco ta̱ musula̱ a̱tsuma̱ akina tsura̱ o kototo le, adama a na musula̱ n ɗa uruma wu vaɗilima̱ va aakpata na aatali, adama ndolo ɗa a gura kototo n le.<note caller="+" style="f"><char style="fr" closed="false">19:18 </char><char style="ft" closed="false">Ka̱lyuwa̱: Ish 44:9-20.</char></note> <verse eid="2KI 19:18" /><verse number="19" style="v" sid="2KI 19:19" />Gogo, A̱sulazuva A̱sula̱ a̱ tsu, wawa tsu ekere a̱yi, adama a na suru tsugono tsu o uvaɗi e reve a na a̱vu ɗa A̱sulazuva A̱sula̱ goon.&gt;&gt;<verse eid="2KI 19:19" /></para>
  <para style="s">Ishaya yuwan ta̱ udammu u ma̱riya̱a̱ ma Senakerib</para>
  <para style="r">(<ref loc="ISA 37:21-34">Ish 37:21-34</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 19:20" />A̱vu Ishaya ulobo wa Amoz u lyungu wa̱ Hezekiya ni ikaka u damma, &lt;&lt; Apa ili i na A̱sulazuva, A̱sula̱ a Isra'ila, a dammai, &lt;Mu uwwa ta̱ avasa a̱ wu adama Senakerib mogono ma Asuriya.&gt; &gt;&gt; <verse eid="2KI 19:20" /><verse number="21" style="v" sid="2KI 19:21" />Apa adanshi a na A̱sulazuva a yuwain adama a̱ yi,</para>
  <para style="b" vid="2KI 19:21" />
  <para style="q1" vid="2KI 19:21">&lt;&lt;Usheli wa̱ Sihiyona</para>
  <para style="q2" vid="2KI 19:21">u tara wu ili shi,</para>
  <para style="q2" vid="2KI 19:21">waru u ta yuwusaan wu ulamu.</para>
  <para style="q1" vid="2KI 19:21">Usheli wa Urishelima</para>
  <para style="q2" vid="2KI 19:21">u ta̱ ga̱ɗishi aaci a̱ yi a̱ca̱pa̱ a̱ wu.<verse eid="2KI 19:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="2KI 19:22" />Za ne ɗa ve isulusa na̱ vu yuwusain ulamu?</para>
  <para style="q2" vid="2KI 19:22">Waru za ne ɗa va̱ 'ya̱susa̱a̱n uɗyo?</para>
  <para style="q1" vid="2KI 19:22">Agba za ne ɗa va̱ kpa̱tu'usa̱ esu?</para>
  <para style="q2" vid="2KI 19:22">e ekere A̱sula̱ za va Akiza a Isra'ila!&gt;&gt;<verse eid="2KI 19:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="2KI 19:23" />A̱tsuma̱ a nlingata ma̱ wu vu isula ta̱ A̱sulazuva.</para>
  <para style="q2" vid="2KI 19:23">A̱vu vu damma, &lt;&lt;Na̱ a̱bunda̱ e ikeke yi ido i va̱ i ɗa,</para>
  <para style="q1" vid="2KI 19:23">n kumbai zuva vu nsasan mu ugaɗi,</para>
  <para style="q2" vid="2KI 19:23">acina ukosu wa agaɗi a Lebanon.</para>
  <para style="q1" vid="2KI 19:23">Mu koɗo ta̱ ɗanga vu uga'an va sida,</para>
  <para style="q2" vid="2KI 19:23">a aza a na ala'a yi uga'an,</para>
  <para style="q2" vid="2KI 19:23">oɓolo na̱ ɗanga Fir na la'a yi ulobonu.</para>
  <para style="q1" vid="2KI 19:23">N rawa ta̱ o tyo wa agaɗi a Lebanon,</para>
  <para style="q2" vid="2KI 19:23">a̱vu vu uwa pe pe a̱tsuma̱ a̱rumbu a̱ yi.<verse eid="2KI 19:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="2KI 19:24" />N ka̱pa̱ ta̱ oko'o</para>
  <para style="q2" vid="2KI 19:24">reve n sowo mini ma na ma̱ ri za vi iɗa ya̱ a̱ wu shi,</para>
  <para style="q1" vid="2KI 19:24">na̱ wu dasu wa ana a̱ va̱ mu kwan ta̱</para>
  <para style="q2" vid="2KI 19:24">suru ɗolu va Masar.&gt;&gt;<verse eid="2KI 19:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="2KI 19:25" />&lt;&lt;Koto vu uwwa shi?</para>
  <para style="q2" vid="2KI 19:25">ɗe nu ufaru ne ɗa n zuwai a na wa a fara.</para>
  <para style="q1" vid="2KI 19:25">Ɗe arana vu ufaru n foɓoi ta̱ ne,</para>
  <para style="q2" vid="2KI 19:25">ili i na mo shiton su gogo,</para>
  <para style="q1" vid="2KI 19:25">ununa va̱ ka̱mbuwa̱,</para>
  <para style="q2" vid="2KI 19:25">ilyuci i naa ri nu ukari ookongo.<verse eid="2KI 19:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="2KI 19:26" />Ununa nda̱na̱ta̱ mu nɗa'a ma lamba ucira,</para>
  <para style="q2" vid="2KI 19:26">a ta uwwa wovon reve a̱ ra̱pula̱.</para>
  <para style="q1" vid="2KI 19:26">A̱vu a̱ da̱na̱ tso ogozo a̱tsuma̱ a atsusa,</para>
  <para style="q2" vid="2KI 19:26">tsa̱ a̱vu'un e ke'en ke'en,</para>
  <para style="q1" vid="2KI 19:26">ko tsa anlya a na o topoi zuva vu ukwa̱'a̱,</para>
  <para style="q2" vid="2KI 19:26">za na upepu u tsu 'yeweto yi babu u kungwa.<verse eid="2KI 19:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="2KI 19:27" />&lt;&lt;Agba n reve ta̱ na̱ nda̱na̱ta̱ ma̱ wu,</para>
  <para style="q2" vid="2KI 19:27">na̱ mantsa ma̱ mo uta̱ ma̱ wu na̱ ma̱ ka̱mba̱ ma̱ wu,</para>
  <para style="q2" vid="2KI 19:27">nu upan u na va yuwusan aci a̱ va̱.<verse eid="2KI 19:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="2KI 19:28" />Ana wo o'woi vu yuwan ta̱ upan lon aci a̱ va̱,</para>
  <para style="q2" vid="2KI 19:28">agba alabari aciyogbamu wa̱ wu a rawa ta̱ atsuvu a̱ va̱,</para>
  <para style="q1" vid="2KI 19:28">to, n ta zuwa wu gon a̱ vunu,</para>
  <para style="q2" vid="2KI 19:28">naa amunga o una̱ wa wu,</para>
  <para style="q1" vid="2KI 19:28">waru n ta vadala to wu,</para>
  <para style="q2" vid="2KI 19:28">a̱ tyo wu o ure u na vu uta̱i.&gt;&gt;<verse eid="2KI 19:28" /></para>
  <para style="b" />
  <para style="p">
    <verse number="29" style="v" sid="2KI 19:29" />A̱vu Ishaya damma mogono Hezekiya, &lt;&lt;Apa ili i na yo o wu iroci. A̱tsuma̱ a aa'wan nda a̱ 'ya̱wa̱ i ta̱ tsura̱ a̱ta̱pa̱shi a̱tsuma̱ e ili i na yu uta̱i diga e iɗa naa aciya yi a na ya lyuwa, aa'wan ire i ta lyuwa ili i na a̱ta̱pa̱shi'i a matsain, amma a̱tsuma̱ a aa'wan a ta'atsu i ta̱ cuwa̱n ishina i ɗu hali i gasa i le, a̱vu i shuwa̱ inabi a̱ uɗuma̱ ɗu, a̱vu i lyuwa muwun le. <verse eid="2KI 19:29" /><verse number="30" style="v" sid="2KI 19:30" />Akapi ama a na abuwai a̱tsuma̱ o u'wa wa Yahuda a ta̱ yuwan aralu, waru a̱ ta̱ shuwa̱ reve a bala, tsu uɗanga u naa aralu a̱ yi, a̱ ka̱ra̱i a̱cipa̱ a̱tsuma̱ e iɗa, waru eten a̱ yi a na a̱ ri zuva a ca a̱ yi muwun. <verse eid="2KI 19:30" /><verse number="31" style="v" sid="2KI 19:31" />Adama a na diga a̱tsuma̱ Urishelima, akapi a ama a̱ to o uta̱, diga masasan ma Sihiyona, a̱ ta̱ tsura̱ oɓolo akapi a ama a na ala'a. Adama a̱ tsushu'un tsi icigi ya̱ A̱sulazuva o oɓolo a̱ a̱soja a zuva a ɗa a yuwan tsundolo.&gt;&gt;<verse eid="2KI 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 19:32" />&lt;&lt;Adama o ndolo apa ili i na A̱sulazuva a dammai a aci ya̱ o mogono ma Asuriya, &lt;Waa uwa a̱tsuma̱ lyuci gbain n da shi, ko gba u tewin iliya pe shi, ko gba shi u ta̱wa̱a̱ yi na̱ a̱a̱ra̱ga̱ shi, ko gba u ɓoloto ma̱bula̱ adama a na wa kumba ukari wa̱ yi shi. <verse eid="2KI 19:32" /><verse number="33" style="v" sid="2KI 19:33" />A̱tsuma̱ o ure u na wo o toni a̱ ta̱wa̱ pa o ure u ɗaɗa wo toni ya̱ a̱ ka̱mba̱, waru wa uwa pe a̱tsuma̱ a̱ lyuci gbai'in shi. A̱mu A̱sulazuva n damma ta̱. <verse eid="2KI 19:33" /><verse number="34" style="v" sid="2KI 19:34" />Adama a na n ta para lyuci gbai'in waru n wawa a̱ yi, adama a̱ba̱jini aala a̱ va̱, na waru adama aagbashi a̱ va̱ Da̱wuda.&gt; &gt;&gt;<verse eid="2KI 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 19:35" />A̱tsuma̱ ayin o ndolo a̱vu malingata ma̱ A̱sulazuva ma̱ ka̱ra̱ a̱ 'ya̱wa̱ o uva̱la̱ta̱ wa aza a Asuriya reve wu una ama ukpakukupa kupa nu kpakukupa kunla̱ na̱ ozo ton (185,000). Ana a ama a̱ 'yon yi usana, a̱vu acina a̱kwa̱kwa̱ uba̱ta̱ biti.<note caller="+" style="f"><char style="fr" closed="false">19:35 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Ngo 19:7; 2 Ngo 32:21-22; Ish 37:36-38.</char></note> <verse eid="2KI 19:35" /><verse number="36" style="v" sid="2KI 19:36" />A̱vu mogono Senakerib va Asuriya ma̱ 'yon a̱vu u ka̱mba̱ a̱tsuma̱ e iɗa ya yi a̱tsuma̱ a Niniva. <verse eid="2KI 19:36" /><verse number="37" style="v" sid="2KI 19:37" />Urana u lo a̱yi pe a yuwusaan ma̱sula̱ ma̱ yi Nisiro a̱ga̱nda̱, a̱vu olobo a̱ yi Adaramalek na̱ Shareza o unai na̱ matsun me pe'eni, a̱vu asuma a̱ tyo a̱ lyuci va Arara. Adama o ndolo a̱vu ulobo wa̱ yi za na a̱ tsu ɗe Esahadon wo o mogono.<verse eid="2KI 19:37" /></para>
  <chapter eid="2KI 19" />
  <chapter number="20" style="c" sid="2KI 20" />
  <para style="s">U banakun wa Hezekiya</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 20:1" />A mantsa mo ndolo Hezekiya da̱na̱ ta̱ nu ubanakun hali u yuwan zuzu a na wa̱ kuwa̱. A̱vu Ishaya vumava̱sula̱ ulobo wa Amoz 'ya̱wa̱ uba̱ta̱ wa̱ yi a̱vu u damma yi, &lt;&lt;Apa ili i na A̱sulazuva a dammai, &lt;Vu foɓo u'wa wa̱ wu, adama a na va la'a shi vu ta̱ kuwa̱.&gt; &gt;&gt;<verse eid="2KI 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 20:2" />A̱vu Hezekiya vadala urewesu wa yi a̱ tyo o uɓaɓu a̱vu u pati ya̱ A̱sulazuva u damma, <verse eid="2KI 20:2" /><verse number="3" style="v" sid="2KI 20:3" />&lt;&lt;A̱sulazuva vu cuwan, na̱ cine n yuwain mmalu elime a̱ wu, a̱tsuma̱ amayun na̱ suru okolo a̱ va̱ waru n yuwan ta̱ ulinga u na u ri mejege elime a̱ wu.&gt;&gt; A̱vu Hezekiya shon a̱bunda̱ nu usa̱n lon.<verse eid="2KI 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 20:4" />Kafu Ishaya u ta̱ u lyawa memere mo ukobu u mogono, a̱vu adanshi A̱sulazuva a̱ ta̱wa̱ ya̱ a̱ yi u damma, <verse eid="2KI 20:4" /><verse number="5" style="v" sid="2KI 20:5" />&lt;&lt;Ka̱mba̱, vu damma Hezekiya mogono ma ama a̱ va̱, &lt;Apa ili i na A̱sulazuva, A̱sula̱ a dada va̱ wu Da̱wuda dammai, mu uwwa ta̱ ipati ya̱ wu waru me ene ta̱ aɓara a̱ wu, n ta ca wu lafiya. A̱tsuma̱ o urana wa ta'atsu vu ta gawan a̱ 'ya̱wa̱ a̱tsuma̱ A̱a̱'isa̱mapaɗa a̱ A̱sulazuva vu yuwan a̱ga̱nda̱. <verse eid="2KI 20:5" /><verse number="6" style="v" sid="2KI 20:6" />N ta̱ da̱shi wu a aa'wan kupa na̱ ozo ton a̱tsuma̱ a wuma wa̱ wu. A̱vu n wawa wu a̱tsuma̱ a̱ lyuci e ekere mogono ma Asuriya. N ta geshe iɗa i nda adama a̱ va̱, na̱ waru adama aagbashi a̱ va̱ Da̱wuda.&gt; &gt;&gt;<verse eid="2KI 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 20:7" />A̱vu Ishaya damma, &lt;&lt;Lyawa a tara a̱a̱kutsu o ubiri reve a sukuma yi a aamici'in, tsa̱ra̱ u ka̱mba̱ gbaga.&gt;&gt;<verse eid="2KI 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 20:8" />A̱vu mogono Hezekiya e ece Ishaya, &lt;&lt;Nye ɗa ya̱ da̱na̱ iroci i na A̱sulazuva o roco mu a na ma̱ tsura̱ lafiya, a̱vu waru a̱tsuma̱ o urana wa a ta'atsu, a na ma gawan n ka̱ra̱ a̱ tyo A̱a̱'isa̱mapaɗa a̱ A̱sulazuva?&gt;&gt;<verse eid="2KI 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 20:9" />A̱vu Ishaya usu yi u damma, &lt;&lt;Apa iroci ya̱ A̱sulazuva a̱ tyo ya̱ a̱ wu a na A̱sulazuva a̱ ta̱ o shiton nzuwulai ma̱ yi, to, vu ɗangula ko vu ta ciga a na ululu wa̱ a̱ ka̱mba̱ a̱ca̱pa̱ udasuwu kupa, ko u 'ya̱wa̱ elime udasuwu kupa?&gt;&gt;<verse eid="2KI 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 20:10" />A̱vu Hezekiya usu &lt;&lt;Ili yu usa̱n iɗa shi a na ululu wa̱ 'ya̱wa̱ elime udasuwu kupa a na gba wa̱ ka̱mba̱ a̱ca̱pa̱ udasuwu kupa.&gt;&gt;<verse eid="2KI 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 20:11" />A̱vu Ishaya vumava̱sula̱ pati ya̱ A̱sulazuva, a̱vu A̱sulazuva a zuwa ululu u ka̱mba̱ a̱ca̱pa̱ udasu wu kupa, a na u ka̱ra̱la̱i pe a̱tsuma̱ uba̱ta̱ u na mogono Ahaz udasu yi.<verse eid="2KI 20:11" /></para>
  <para style="s">Nlingata diga Babila</para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 20:12" />A mantsa mo o ndolo Meroda Balada ulobo wa Baladan mogono ma Babila ma lyunguwa̱a̱ ta̱ Hezekiya na̱ mepepelime na̱ ne'e, adama a na wu uwwai a na Hezekiya ta̱ ubanakun. <verse eid="2KI 20:12" /><verse number="13" style="v" sid="2KI 20:13" />A̱vu Hezekiya raba le. Reve u roco le suru asula e izuwa yu utsuru wa̱ yi, na̱ azurufa na̱ zinariya na̱ ili i ma̱guru na̱ mani'in ma sa'ani na̱ itana yu uvon ya̱ yi, na̱ utsuru u na u ri na̱ yi suru, a̱tsuma̱ asula e izuwa ya̱ yi. Babu ni ili i na i da̱na̱i o ukobu wa̱ yi suru, ko a̱ tsugono tsa yi a na Hezekiya kuɗa̱i a na wo roco le. <verse eid="2KI 20:13" /><verse number="14" style="v" sid="2KI 20:14" />A̱vu Ishaya vumava̱sula̱ ta̱wa̱ uba̱ta̱ u Mogono Hezekiya a̱vu we ece yi u damma, &lt;&lt;Nye ɗa ama a nda adamma nuwu? Diga te ɗa waru o uta̱i?&gt;&gt;</para>
  <para style="p" vid="2KI 20:14">&lt;&lt;A̱vu Hezekiya usu o uta̱ ta̱ diga e iɗa yaa alanga, diga e iɗa ya Babila.&gt;&gt;<verse eid="2KI 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 20:15" />A̱vu Ishaya vumava̱sula̱ da̱shi ece u damma &lt;&lt;Nye ɗa enei a̱tsuma̱ o ukobu wa̱ wu?&gt;&gt;</para>
  <para style="p" vid="2KI 20:15">&lt;&lt;Avu Hezekiya usu ene ta̱ ili i na i ri pe o ukobu suru babu ili i na i ri pe a̱tsuma̱ asula e izuwa yu utsuru i va̱ a na n roco n le shi.&gt;&gt;<verse eid="2KI 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 20:16" />A̱vu Ishaya damma Hezekiya, &lt;&lt;Vu uwwa adanshi A̱sulazuva. <verse eid="2KI 20:16" /><verse number="17" style="v" sid="2KI 20:17" />&lt;Amayun a ɗa mantsa ma̱ tu lo a̱ ta̱wa̱ a na a̱ pura̱ suru ili i na vu ri na̱ yi a̱tsuma̱ o ukobu wa̱ wu, ili i na nkaya ma̱ wu n yuwain izuwa acina ana'an, a ta pura̱ le suru a̱ tyo Babila. Babu ili i na a lyawa. A̱mu A̱sulazuva n damma ta̱.<note caller="+" style="f"><char style="fr" closed="false">20:17 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Ngo 24:13; 2 Alb 36:10.</char></note> <verse eid="2KI 20:17" /><verse number="18" style="v" sid="2KI 20:18" />Waru a̱ ta̱ pura̱ olobo a̱ wu o ro, a̱za̱ a̱ lipu na̱ mpasa ma̱ a̱ wu. Aza a na a matsan nuwu a̱vu a̱ ka̱ra̱ na̱ le, reve o'o to le ali a na a gura von na̱ a̱ma̱ci shi o ukobu u mogono ma Babila.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">20:18 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Ngo 24:14-15; Dan 1:1-7.</char></note> <verse eid="2KI 20:18" /><verse number="19" style="v" sid="2KI 20:19" />Avu Hezekiya damma Ishaya vumava̱sula̱, &lt;&lt;Adanshi a̱ A̱sulazuva a na vu ta̱wa̱ nu mu u tu ulobonu.&gt;&gt; Adama a na u da̱na̱ ta̱ a majiyan u damma, &lt;&lt;A̱ da̱na̱ na̱ nden ma lafiya a̱tsuma̱ a mantsa ma̱ va̱ shi?&gt;&gt; <verse eid="2KI 20:19" /><verse number="20" style="v" sid="2KI 20:20" />Akapi o ulinga u na mogono Hezekiya yuwain, o ucira u tsugono tsa yi, nu ununa suru u suwa yi esu a̱ mini aza a na a̱ ta̱wusa̱ na̱ mini a̱tsuma̱ a̱ lyuci, a̱ da̱na̱ ta̱ pe uɗanu a̱tsuma̱ aatagada alabari o ngono ma a Yahuda. <verse eid="2KI 20:20" /><verse number="21" style="v" sid="2KI 20:21" />Avu Hezekiya kuwa̱ ucina nkaya ma yi a̱vu ulobo wa yi Manase wo o mogono o una̱ wa̱ yi.<verse eid="2KI 20:21" /></para>
  <chapter eid="2KI 20" />
  <chapter number="21" style="c" sid="2KI 21" />
  <para style="s">Manase mogono ma a Yahuda</para>
  <para style="r">(<ref loc="2CH 33:1-20">2 Alb 33:1-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 21:1" />Manase da̱na̱ ta̱ na aa'wan kupa na̱ ejere a mantsa ma na wo o yi mogono, u yuwan ta̱ tsugono tsa yi aa'wan kupoton na̱ ozo o ton a̱tsuma̱ a̱ Urishelima. Aala a mma va yi ɗa Hefiziba. <verse eid="2KI 21:1" /><verse number="2" style="v" sid="2KI 21:2" />U yuwan ta̱ iwuya a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva, a yuwusan ili yi idaba i na nɗa n na A̱sulazuva a̱ gba̱ra̱i elime ama a Isra'ila.<note caller="+" style="f"><char style="fr" closed="false">21:2 </char><char style="ft" closed="false">Ka̱lyuwa̱: Irm 15:4.</char></note> <verse eid="2KI 21:2" /><verse number="3" style="v" sid="2KI 21:3" />A̱vu mogono Manase ma̱ suwisa ba̱ta̱ va̱ a̱ga̱nda̱ na dada va yi Hezekiya o ɓosoi, a̱vu waru u suwaa Ba'al musa'a, avu u yuwisan ma̱sula̱ ma Ashera, ununa Mogono Ahabu va Isra'ila yuwain. A̱vu u kingyo a̱ tyo uba̱ta̱ wu urana na̱ woto na̱ italyo'o ya zuva avu u yuwan le a̱ga̱nda̱. <verse eid="2KI 21:3" /><verse number="4" style="v" sid="2KI 21:4" />A̱vu Manase suwa musa'a a̱ A̱a̱'isamapaɗa a̱ A̱sulazuva, a na A̱sulazuva dammai, &lt;&lt;A̱tsuma̱ a̱ Urishelima ɗa ma zuwa aala a̱ va̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">21:4 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Sam 7:13.</char></note> <verse eid="2KI 21:4" /><verse number="5" style="v" sid="2KI 21:5" />A̱vu u suwa musa'a adama a na a yuwaan urana na̱ woto na̱ italyo'o ya zuva a̱ga̱nda̱, a̱tsuma̱ asula a̱ re A̱a̱'isa̱mapaɗa a̱ A̱sulazuva. <verse eid="2KI 21:5" /><verse number="6" style="v" sid="2KI 21:6" />Manase ca ta̱ ulobo wa̱ yi kucci vu ukula̱tosu. Waru u ta yuwusan yindi na̱ u ɓoloso ya aci na̱ ruhu va̱ a̱kwa̱kwa̱. Agba u ta yuwusan tsuboci fo. U yuwan ta̱ ulinga wi iwuya elime A̱sulazuva, za na u zuwai A̱sulazuva a yuwain upan na̱ yi lon.<verse eid="2KI 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 21:7" />A̱vu u tara uruma u Ashera u ma̱sula̱ ma na u yuwain a̱vu u zuwai pe a̱tsuma̱ A̱a̱'isa̱mapaɗa, za na A̱sulazuva a dammai Da̱wuda na̱ ulobo wa̱ yi Sulemanu, &lt;&lt;A̱tsuma̱ A̱a̱'isa̱mapaɗa a nda pe Urishelima, na n ɗangulai a̱tsuma̱ o gundo va aza a Isra'ila suru, a na ma zuwa aala a̱ va̱ hali hali.<note caller="+" style="f"><char style="fr" closed="false">21:7 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 9:3-5; 2 Alb 7:12-18.</char></note> <verse eid="2KI 21:7" /><verse number="8" style="v" sid="2KI 21:8" />Ma̱ da̱shi lyawa ama a Isra'ila o uta̱ diga a̱tsuma̱ e iɗa i na n ca yi nkaya n le shi, n na a yuwan tsutoni reve a̱kuru ili i na n damma nle, na̱ wila̱ u na aagbashi a va Musa ca nle.&gt;&gt; <verse eid="2KI 21:8" /><verse number="9" style="v" sid="2KI 21:9" />Amma ama'a a uwwa shi. A̱vu Manase ra̱pula̱ le, u zuwa le a na a yuwan iwuya i na i la'a yi ama a na A̱sulazuva o kototo yi a̱tsuma̱ e iɗa'a i na u ca yi ama a Isra'ila a̱ da̱nu pe.<verse eid="2KI 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 21:10" />A̱vu A̱sulazuva a yuwan adanshi o una̱ wa agbashi a̱ yi ama̱sula̱ u damma, <verse eid="2KI 21:10" /><verse number="11" style="v" sid="2KI 21:11" />&lt;&lt;Manase Mogono ma Yahuda ma yuwan ta̱ ulinga wi ili yi idaba i nda. U yuwan ta̱ iwuya lon i na i la'a yi aza a Amoriya, a aza a na a̱ da̱na̱i pe kafu a mantsa ma̱ yi, avu u zuwa ama a Yahuda a yuwan unusu e itoni i musula̱ ma̱ yi. <verse eid="2KI 21:11" /><verse number="12" style="v" sid="2KI 21:12" />Adama o ndolo apa ili i na a̱mu A̱sulazuva, A̱sula̱ a aza Isra'ila, n dammai, n ta̱ ta̱wa̱ na̱ a̱tsuma̱lima̱ aciya a Urishelima na̱ Yahuda na vuma naa uwwai biti u ta̱ lima̱.<note caller="+" style="f"><char style="fr" closed="false">21:12 </char><char style="ft" closed="false">Ka̱lyuwa̱: Irm 19:3.</char></note> <verse eid="2KI 21:12" /><verse number="13" style="v" sid="2KI 21:13" />Adama o ndolo waru a̱vu n kunzu aza a Urishelima na̱ amunga o u kimusa̱sa̱ u na n yuwain ulinga na̱ yi ekere aza a Samariya, na̱ waru za naa n yuwain ulinga na̱ yi a̱tsuma̱ o u'wa wa Ahabu. Na̱ ne ɗa ma tasa aza a Urishelima ununa vuma tsu tasa akwanu, a̱vu u kpa̱to yi mavada. <verse eid="2KI 21:13" /><verse number="14" style="v" sid="2KI 21:14" />A̱vu n vari a agadu a̱ va̱ a zana a buwai, reve waru n ca le ekere aa n'yuwatan n le. Waru ele oto o aza a na e remei tsu itana yu uvon yi n'yuwatan n le, <verse eid="2KI 21:14" /><verse number="15" style="v" sid="2KI 21:15" />adama a na a yuwan ta̱ iwuya esu a̱ va̱ a̱vu a zuwa mu n yuwan upan diga o urana u na nkaya n le mu uta̱i a̱tsuma̱ a Masar hali acina ana'an nda.&gt;&gt;<verse eid="2KI 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 21:16" />Na̱ ne suru, Manase gba una ta̱ aza a na a̱ ri nu unusu shi lon, a̱vu u shiton Urishelima na̱ mpasa n le diga upasu u nda acina upasu u de ɗe, ba nu unusu u na u zuwai aza a Yahuda a yuwain, a̱vu a yuwan iwuya elime A̱sulazuva.<verse eid="2KI 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 21:17" />Akapi o ulinga wa Manase, na̱ suru linga naa u yuwain, na̱ suru unusu u na u yuwain, a̱ da̱na̱ ta̱ pe uɗanu a̱tsuma̱ aatagada alabari o ngono ma a Yahuda. <verse eid="2KI 21:17" /><verse number="18" style="v" sid="2KI 21:18" />Manase kuwa̱ ta̱ ucina nkaya ma̱ yi a̱vu a̱ ciɗo yi pe a̱tsuma̱ a̱a̱rumbu o u'wa wa̱ yi, a̱a̱rumbu a Uza. A̱vu ulobo wa̱ yi Amon mo o mogono o una̱ wa̱ yi.<verse eid="2KI 21:18" /></para>
  <para style="s">Amon Mogono ma Yahuda</para>
  <para style="r">(<ref loc="2CH 33:21-25">2 Alb 33:21-25</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 21:19" />Amon da̱na̱ ta̱ na a aa'wan ushin na̱ ejere a mantsa ma na wo o'woi mogono, a̱vu waru u yuwan tsugono tsa Urishelima a aa'wan e re. Aala mma va̱ yi ɗa Meshuleme usheli wa Haru diga a̱tsuma̱ a Yoba. <verse eid="2KI 21:19" /><verse number="20" style="v" sid="2KI 21:20" />A̱vu u yuwan iwuya elime A̱sulazuva ununa dada va yi Manase yuwain. <verse eid="2KI 21:20" /><verse number="21" style="v" sid="2KI 21:21" />A̱vu yuwan suru mmalu ma̱ yi a̱tsuma̱ o ure wa dada va̱ yi, u yuwusan a̱ga̱nda̱ a̱ tyo uba̱ta̱ musula̱ naa dada va̱ yi yuwusaan yi a̱ga̱nda̱, reve u kingyo wa̱ le. <verse eid="2KI 21:21" /><verse number="22" style="v" sid="2KI 21:22" />A̱vu u lyawa A̱sulazuva, A̱sula̱ a nkaya ma̱ yi, a̱vu u 'yuwan a yuwan mmalu o ure wa̱ A̱sulazuva. <verse eid="2KI 21:22" /><verse number="23" style="v" sid="2KI 21:23" />Azagbain o mogono Amon oɓolo ta̱ una̱ u le reve o unai a̱tsuma̱ o u'wa wa̱ yi. <verse eid="2KI 21:23" /><verse number="24" style="v" sid="2KI 21:24" />Amma a̱vu ama e iɗa'a suru o una aza a na o ɓoloi aci o unai Amon, reve a ɗangula Josiya ulobo wa̱ yi o una̱ wa̱ yi. <verse eid="2KI 21:24" /><verse number="25" style="v" sid="2KI 21:25" />Suru akapi o ulinga u na Amon yuwain, na̱ linga va̱ yi, a̱ da̱na̱ ta̱ pe uɗanu a̱tsuma̱ aatagada alabari o ngono ma a Yahuda. <verse eid="2KI 21:25" /><verse number="26" style="v" sid="2KI 21:26" />A̱vu a̱ ciɗo yi ason a̱yi pe a̱tsuma̱ a̱a̱rumbu a Uza. A̱vu ulobo wa̱ yi Josiya wo o mogono o una̱ wa̱ yi.<verse eid="2KI 21:26" /></para>
  <chapter eid="2KI 21" />
  <chapter number="22" style="c" sid="2KI 22" />
  <para style="s">Mogono Josiya va a Yahuda</para>
  <para style="r">(<ref loc="2CH 33:1-20">2 Alb 33:1-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 22:1" />Josiya da̱na̱ ta̱ na a aa'wan kunla̱ a na wo o yi Mogono, a̱vu u yuwan tsugono a aa'wan mata'atsu na̱ za ta̱ a̱tsuma̱ Urishelima. Aala a mma va yi ɗa Yedida usheli wa Adaya vuma va Bozuka. <verse eid="2KI 22:1" /><verse number="2" style="v" sid="2KI 22:2" />A̱vu u yuwan ili i na i ri mejege elime A̱sulazuva u yuwan ta̱ mmalu suru a̱tsuma̱ o ure wa dada va̱ yi Da̱wuda, agba u vadala ugula̱ ko u sa'ani shi.<verse eid="2KI 22:2" /></para>
  <para style="s">A̱ tsura̱ ta̱ aatagada o uritosu wa Musa</para>
  <para style="r">(<ref loc="2CH 34:8-28">2 Alb 34:8-28</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 22:3" />A̱tsuma̱ aa aa'wan kupa na̱ kunla̱ o tsugono tsa Mogono Josiya, a̱vu u lyungu Shafa a̱ tyo a̱ A̱a̱'isa̱mapaɗa a̱ A̱sulazuva. Shafa ulobo wa Azaliya ulobo wa Meshulam za na da̱na̱i za vi iɗana i mogono. Reve Josiya damma, <verse eid="2KI 22:3" /><verse number="4" style="v" sid="2KI 22:4" />&lt;&lt;Ka̱ra̱ a gawan a̱ 'ya̱wa̱ ya Hilikiya ganu gbain vu zuwai a na we kece ikebe i na a̱ ta̱wa̱ yi A̱a̱'isa̱mapaɗa a̱ A̱sulazuva, a aza a na a̱ a̱za̱ e ipiri yu una̱ntsu o oɓoloto yi diga ekere a ama. <verse eid="2KI 22:4" /><verse number="5" style="v" sid="2KI 22:5" />Adama le a ca ikebe'e ekere aza a na a̱ ka̱lyuwusa̱ a aza na a yuwusan ulinga a̱ A̱a̱'isa̱mapaɗa. A̱vu ama'a a tsupa a̱ a̱za̱ o ulinga a na a lapulusa A̱a̱'isamapaɗa a̱ A̱sulazuva, <verse eid="2KI 22:5" /><verse number="6" style="v" sid="2KI 22:6" />na̱ nan kafinta na̱ ozo o ulinga na̱ ozo o usaa. Reve a tsula akpata na̱ atali a sa'ani adama a na a lapula A̱a̱'isa̱mapaɗa a̱ A̱sulazuva. <verse eid="2KI 22:6" /><verse number="7" style="v" sid="2KI 22:7" />Agba a̱ ri ne ece le cine o una yi ikebe i na a ca n le shi, adama a na a ta yuwusan ulinga u le na amayun.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">22:7 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Ngo 12:15.</char></note><verse eid="2KI 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 22:8" />A̱vu Hilikiya ganu gbain damma Shafa za vi iɗana, &lt;&lt;N tsura̱ ta̱ Aatagada a̱ Wila̱ a̱ A̱a̱'isa̱mapaɗa a̱ A̱sulazuva.&gt;&gt; A̱vu u ca Shafa, za na ɗe yi nu una̱. <verse eid="2KI 22:8" /><verse number="9" style="v" sid="2KI 22:9" />Avu Shafa za vi iɗana ka̱ra̱ a̱ ka̱mba̱ uba̱ta̱ mogono a̱vu u damma yi, &lt;&lt;Agbashi a̱ wu a tara ta̱ ikebe i na i da̱na̱i a̱tsuma̱ A̱a̱'isa̱mapaɗa a̱ A̱sulazuva, a̱vu a ca aza a na a̱ ri o ulinga nu ka̱lyuwusa̱ wa̱ A̱a̱'isa̱mapaɗa.&gt;&gt; <verse eid="2KI 22:9" /><verse number="10" style="v" sid="2KI 22:10" />A̱vu Shafa za vi iɗana damma mogono, &lt;&lt;Hilikiya ganu ca mu ta̱ aatagada.&gt;&gt; A̱vu Shafa ɗe nu una̱ elime mogono.<verse eid="2KI 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 22:11" />A mantsa ma na mogono ma uwwai adanshi Aatagada a̱ Wila̱, a̱vu wu kara a̱tugu yi. <verse eid="2KI 22:11" /><verse number="12" style="v" sid="2KI 22:12" />A̱vu u damma Hilikiya ganu, na̱ Ahikam ulobo wa Shafa na̱ Akbo ulobo wa Mikaya, Shafa za vi iɗana na̱ Asaya aagbashi a̱ mogono, <verse eid="2KI 22:12" /><verse number="13" style="v" sid="2KI 22:13" />&lt;&lt;Ka̱ra̱ yi adama a na ya̱ ece A̱sulazuva adama a̱ va̱ na adama ama waru na̱ suru Yahuda, adama adanshi a na a̱ ri uɗanu aatagada na a̱ tsura̱i. Adama a na upan wa̱ A̱sulazuva a̱ tu usuɗu aci a̱ tsu, adama a na nkaya n tsu a yuwan tsutoni na adanshi a aatagada a nda shi. A yuwan ko ili i ta̱ i na suru i ri uɗanu pe adama a̱ tsu shi.&gt;&gt;<verse eid="2KI 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 22:14" />A̱vu Hilikiya ganu, na̱ Ahikam na̱ Akbo na̱ Shafa na̱ Asaya a̱ 'ya̱wa̱ uba̱ta̱ wa Hulda ka ro vumava̱sula̱, za na da̱na̱i ka va Shalum ulobo wa Tikiva, ulobo wa Harha, za na tsu idanusan asula a̱ a̱tugu. U da̱na̱ ta̱ na̱ nden Urishelima, a̱ lyuci sa'avu. <verse eid="2KI 22:14" /><verse number="15" style="v" sid="2KI 22:15" />A̱vu u damma le, &lt;&lt;Apa ili i na A̱sulazuva a̱ A̱sula̱ a Isra'ila a dammai, &lt;Damma yi vuma na lyungu ɗu ya̱ a̱ va̱, <verse eid="2KI 22:15" /><verse number="16" style="v" sid="2KI 22:16" />Na amayun A̱sulazuva a damma ta̱, n ta̱ ta̱wa̱ na̱ a̱tsuma̱lima̱ uba̱ta̱ u nda oɓolo na ama a̱ yi, cine u ri uɗanu suru a aatagada a na mogono ma Yahuda me ɗe yi nu una̱. <verse eid="2KI 22:16" /><verse number="17" style="v" sid="2KI 22:17" />Adama a na a 'yuwan numu avu a̱ kuloto wa̱ musula̱ n ro ili i ma̱guru, reve a zuwa mu n yuwan upan adama a̱ma̱li a na a yuwan yi na̱ ekere ele, upan u va̱ u ta̱ kula̱ uba̱ta̱ u nda agba wa̱ koto shi.&gt; &gt;&gt; <verse eid="2KI 22:17" /><verse number="18" style="v" sid="2KI 22:18" />Amma vu damma mogono ma a Yahuda, za na lyungu nɗu adama a na ya ece yi uba̱ta̱ wa̱ A̱sulazuva, apa ili i na A̱sulazuva A̱sula̱ a Isra'ila a dammai, adama adanshi a na vu uwwai, i damma, <verse eid="2KI 22:18" /><verse number="19" style="v" sid="2KI 22:19" />&lt;&lt;Ana wo o'woi Ookolo a̱ wu a vadala shi, agba vu tara aciya̱ wu ili i ro uba̱ta̱ wa̱ A̱sulazuva shi, a na vu uwwai ununa n yuwain adanshi adama o uba̱ta̱ nda na ama a̱ yi, a na a̱ ka̱mba̱ okongo nu una, a̱vu vu kakara a̱tugu a̱ wu na̱ mesun elime a̱ va̱, to, a̱mu fo A̱sulazuva mu uwwa ta̱ avasa a̱yi <verse eid="2KI 22:19" /><verse number="20" style="v" sid="2KI 22:20" />Adama o ndolo n ta zuwa wu a na va̱ kuwa̱ vu toni nkaya ma̱ wu, waru a̱vu a̱ ciɗo wu gbaga. Esu a̱ wu ene a̱tsuma̱lima̱ a na ma̱ ta̱wa̱a̱ uba̱ta̱ u nda shi.&gt;&gt;</para>
  <para style="p" vid="2KI 22:20">A̱vu a̱ ta̱wa̱a̱ mogono ni ikaka i nda.<verse eid="2KI 22:20" /></para>
  <chapter eid="2KI 22" />
  <chapter number="23" style="c" sid="2KI 23" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 23:1" />A̱vu mogono ma̱ lyungu wa̱a̱ mbara ma a Yahuda na̱ Urishelima a̱vu o ɓoloto uba̱ta̱ wa̱ yi suru. <verse eid="2KI 23:1" /><verse number="2" style="v" sid="2KI 23:2" />A̱vu mogono ma̱ ka̱ra̱ a̱ 'ya̱wa̱ a̱tsuma̱ a̱ A̱a̱'isa̱mapaɗa a̱ A̱sulazuva oɓolo na ama a Yahuda, na a aza a Urishelima, na̱ nan ganu na ama̱sula̱, na a ama suru zagbain na̱ za ke'en. A̱vu u ɗe nu una̱ atsuvu le suru adanshi a na a̱ ri a̱tsuma̱ aatagada a nzuwulai, za na a̱ tsura̱i pe a̱tsuma̱ a̱ A̱a̱'isa̱mapaɗa a̱ A̱sulazuva. <verse eid="2KI 23:2" /><verse number="3" style="v" sid="2KI 23:3" />A̱vu mogono me e isawan zuzu na atsura a̱vu u yuwisan nzuwulai n sa'avu elime a̱ A̱sulazuva, a na wo toni A̱sulazuva a̱vu u kuru udammu wa̱ yi, nu uritosu wa yi na̱ wila̱ na̱ Ookolo a̱ yi na̱ wuma wa̱ yi suru, a̱vu u yuwan ulinga ni ili i na a ɗana yi pe a̱tsuma̱ aatagada nzuwulai'i. A̱vu ama suru a̱ kuru yi adama nzuwulai'i. <verse eid="2KI 23:3" /><verse number="4" style="v" sid="2KI 23:4" />A̱vu mogono ma damma Hilikiya ganu gbain, na̱ ganu na ri na̱ tsugbain ire na̱ aza e piri yu una̱ntsutsu o uta̱a̱ itana i na i ri pe a̱tsuma̱ A̱a̱'isa̱mapaɗa a̱ A̱sulazuva na̱ suru itana ya Ba'al na aza a Ashera, na̱ ozo o urana na̱ woto na̱ a̱za̱ a̱ italyo'o ya zuva. A̱vu u kuloto le alanga Urishelima atsusa o uka̱ri wa Kidron a̱vu u pura̱ okomo le a̱ tyo Betel.<note caller="+" style="f"><char style="fr" closed="false">23:4 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Ngo 21:3; 2 Alb 33:3.</char></note> <verse eid="2KI 23:4" /><verse number="5" style="v" sid="2KI 23:5" />Reve u gba̱ra̱ nan ganu a̱ musula̱ aza a na ngono ma a Yahuda n zuwai a na a̱ kuloto ili i ma̱guru ba̱ta̱ va̱ a̱ga̱nda̱, a̱tsuma̱ e ilyuci ya a Yahuda na̱ suru Urishelima, aza a na a̱ kula̱tosu ili i ma̱guru a̱ tyo ya Ba'al, na̱ a̱ tyo o urana na̱ woto na̱ italyo'o ya zuva na̱ suru ili i na a yuwain zuva. <verse eid="2KI 23:5" /><verse number="6" style="v" sid="2KI 23:6" />A̱vu u tara a̱ma̱li Ashera diga a̱tsuma̱ A̱a̱'isa̱mapaɗa a̱ A̱sulazuva a̱ tyo o uka̱ri wa Kidron, alanga a Urishelima a̱vu u kuloto yi ɗe. Reve wu ira yi tsa okomo avu u baza ma̱buta̱'a̱ zuva vo oso ama e pere. <verse eid="2KI 23:6" /><verse number="7" style="v" sid="2KI 23:7" />A̱vu wu mura asula ashakala a̱ a̱a̱'isa̱ a̱ma̱ci na ali aza a na a̱ da̱na̱i a̱tsuma̱ a̱ A̱a̱'isa̱mapaɗa a̱ A̱sulazuva, uba̱ta̱ u na a̱ma̱ci a̱ tsu ɗava sa itana adama a yuwan Ashera a̱ga̱nda̱.<note caller="+" style="f"><char style="fr" closed="false">23:7 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 14:24.</char></note><verse eid="2KI 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 23:8" />A̱vu wu uta̱a̱ suru nan ganu aza a na a̱ da̱na̱i a̱tsuma̱ e lyuci ya Yahuda, a̱vu u lungusa̱ uba̱ta̱ e idaba ya̱ a̱ga̱nda̱ a̱ a̱ma̱li e le, diga Geba a̱ tyo Biyasheba, uba̱ta̱ u na nan ganu a̱ tsu kuloto ili i ma̱guru. Reve wu ɓoso a̱ma̱li a na a̱ ri o na̱ntsutsu wu uwata wa Josuwa, gwamna lyuci'i, za na ri o ukere wu ugula̱ wu uwata wi iɗa'a. <verse eid="2KI 23:8" /><verse number="9" style="v" sid="2KI 23:9" />Suru na̱ ne, nan ganu aza a na a̱ da̱na̱i uba̱ta̱ wa̱ a̱ga̱nda̱, a̱ 'ya̱wa̱ a yuwan a̱ a̱ga̱nda̱ a masa'a ma̱ A̱sulazuva a̱tsuma̱ Urishelima shi, amma a gura ta̱ a tama opopofu a na a̱ ri na̱ wolilo shi oɓolo na̱ a̱za̱ le nan ganu.<verse eid="2KI 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 23:10" />A̱vu mogono mo o to Tofe idaba, uba̱ta̱ wa̱ a̱ a̱ga̱nda̱ a na a̱ ri yu upasu wu Uka̱ri wa̱ Hinom, ununa babu za na a gura ca ulobo wa̱ yi ko usheli wa̱ yi kucci vu ukula̱tosu uba̱ta̱ wa Mole.<note caller="+" style="f"><char style="fr" closed="false">23:10 </char><char style="ft" closed="false">Ka̱lyuwa̱: Mta̱ 18:21; Irm 7:31; 19:1-6; Irm 32:35. </char></note> <verse eid="2KI 23:10" /><verse number="11" style="v" sid="2KI 23:11" />A̱vu u tawa uruma wi ido aza a na mogono ma a Yahuda ma zuwai ɗe adama a̱ a̱ga̱nda̱ a̱ tyo uba̱ta̱ o urana, diga o una̱ntsutsu wa̱ A̱a̱'isamapaɗa a̱ A̱sulazuva. A̱ da̱na̱ ta̱ pe a̱tsuma̱, zuzu na aasula a zagbain na a̱ tsu ɗe Natan Mele. A̱vu Josiya kuloto ikeke yi ido aza a na a yuwan yi urana. <verse eid="2KI 23:11" /><verse number="12" style="v" sid="2KI 23:12" />A̱vu wu ɓoso musa'a aza a na ngono ma a Yahuda n suwai zuva va aasula o u'wa u mogono Ahaz, na̱ musa'a aza a na Manase suwai a asula re a na ri pe A̱a̱'isa̱mapaɗa a̱ A̱sulazuva. Avu u tawa le pe, wu ɓoso le miri miri a̱vu wo oco le a̱tsuma̱ o Uka̱ri wa̱ Kidron.<note caller="+" style="f"><char style="fr" closed="false">23:12 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Ngo 21:5; 2 Alb 33:5.</char></note> <verse eid="2KI 23:12" /><verse number="13" style="v" sid="2KI 23:13" />A̱vu mogono mo o to uba̱ta̱ a̱ma̱li idaba a na a̱ ri asana a Urishelima a̱ tyo wu uyagi a aagaɗi o ukototosu, aza a na Sulemanu Mogono ma Isra'ila ma suwayi Ashitore musula̱ mi idaba ya̱ aza a Sidon na̱ Kemosh a̱ma̱li a̱ Mowa na̱ Mole a̱ma̱li a Amon.<note caller="+" style="f"><char style="fr" closed="false">23:13 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 11:7. </char></note> <verse eid="2KI 23:13" /><verse number="14" style="v" sid="2KI 23:14" />A̱vu Josiya mumura atsura uba̱ta̱ wa̱ a̱ a̱ga̱nda̱ le, a̱vu wu gasa a̱shuwutsu a Ashera, a̱vu u ɓa̱ru uba̱ta̱'a̱ na̱ etele ama.<verse eid="2KI 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 23:15" />Waru fo na̱ masa'a ma na ma̱ a̱ ri a Betel, uba̱ta̱ wa̱ a̱ a̱ga̱nda̱ a na Yerobowam ulobo wa Neba ma suwai. Za na zuwai ama a Isra'ila a yuwain unusu, oɓolo nu masa'a mo o uba̱ta̱ wa̱ a̱ a̱ga̱nda̱ aagaɗi suru wu ɓoso le ta̱. Avu u kuloto u ba̱ta̱ wa̱ a̱ a̱ga̱nda̱ wo o okomo, a̱vu u kuloto a̱a̱shuwutsu a̱ a̱ma̱li a ka Ashera.<note caller="+" style="f"><char style="fr" closed="false">23:15 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 12:30-33.</char></note> <verse eid="2KI 23:15" /><verse number="16" style="v" sid="2KI 23:16" />Ana mogono Josiya vadala yi, a̱vu we e ne oso a na a̱ ri ɗe aatali. A̱vu u zuwa adama a na a̱ ta̱wa̱a̱ na̱ etele ele zuva Masa'a avu a̱ kuloto le ɗe, adama o'o to yi idaba, cine adanshi A̱sulazuva a dammai o una̱ u vuma va A̱sula̱ za na dammai ili i nda.<note caller="+" style="f"><char style="fr" closed="false">23:16 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 13:2.</char></note> <verse eid="2KI 23:16" /><verse number="17" style="v" sid="2KI 23:17" />A̱vu mogono ma damma, &lt;&lt;Cu'un vo oso ne ɗa me enei nda?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">23:17 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 13:20-32.</char></note></para>
  <para style="p" vid="2KI 23:17">A̱vu ama lyuci'i a̱ usu a damma, &lt;&lt;Oso a za vuma va̱ A̱sula̱ ɗa za na ta̱wa̱i diga a Yahuda a na u dammai cu'un vi ili i na vu yuwain a Masa'a ma̱ Betel.&gt;&gt; <verse eid="2KI 23:17" /><verse number="18" style="v" sid="2KI 23:18" />A̱vu u damma, &lt;&lt; Lyawa niyi, She vuma tara etele yi wan.&gt;&gt; A̱vu a lyawa etele yi lo goon, oɓolo na̱ etele a vumava̱sula̱ za na o uta̱i diga Samariya.<verse eid="2KI 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 23:19" />A̱vu Josiya lungusa̱ masa'a oɓolo na̱ ba̱ta̱ va̱ a̱ga̱nda̱ aza a na a̱ da̱na̱i e ilyuci ya Samariya, aza a na ngono ma aza a Isra'ila n yuwain, na a zuwai A̱sulazuva a yuwain upan. Reve u yuwan ne ele una̱ uta̱ na̱ cine u yuwain ɗe Betel. <verse eid="2KI 23:19" /><verse number="20" style="v" sid="2KI 23:20" />A̱vu wu una nan ganu a̱ a̱za̱ a̱ a̱ma̱li a na a̱ ri uba̱ta̱ wa̱ a̱ga̱nda̱ ɗe a musa'a ma na ma̱ a̱ ri ɗe, reve u kuloto ɗe etele ama zuva le. A̱vu u ka̱mba̱ Urishelima.<verse eid="2KI 23:20" /></para>
  <para style="s">Josiya foɓo ta̱ a̱buki a mapasa</para>
  <para style="r">(<ref loc="2CH 35:1-19">2 Alb 35:1-19</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 23:21" />A̱vu mogono ma damma ama suru, &lt;&lt;Yuwain A̱buki a Mapasa adama A̱sulazuva A̱sula̱ a̱ ɗu, ununa u ri uɗanu a̱tsuma̱ Aatagada a Nzuwulai.&gt;&gt; <verse eid="2KI 23:21" /><verse number="22" style="v" sid="2KI 23:22" />Adama na ko to a̱ da̱shi yuwan A̱buki a Mapasa tsun nda shi, acina mantsa ma na a̱ tsura̱i a̱za̱ o uge'etosu a Isra'ila, ko a mantsa ma̱ ngono ma Isra'ila na̱ Yahuda shi. <verse eid="2KI 23:22" /><verse number="23" style="v" sid="2KI 23:23" />A̱tsuma̱ a aa'wan kupa na̱ kunla̱ tsa tsugono mogono Josiya, a yuwan ta̱ na̱ a̱buki a Mapasa uba̱ta̱ wa̱ A̱sulazuva a̱tsuma̱ a̱ Urishelima. <verse eid="2KI 23:23" /><verse number="24" style="v" sid="2KI 23:24" />Adama o ndolo, Josiya tawa ta̱ aza na o ɓoloso aci na̱ ruhu va̱ a̱kwa̱kwa̱ na̱ yindi, na̱ musula̱ mu u'wa, na̱ suru ili i na i ri idaba a na a suwai a̱tsuma̱ e iɗa ya Yahuda na̱ a̱tsuma̱ a̱ Urishelima. U yuwan ta̱ ne adama a na wa̱ shiton uritosu u wila̱ u na a ɗanai a̱tsuma̱ aatagada na Hilikiya ganu tsura̱i a̱tsuma̱ A̱a̱'isa̱mapaɗa a̱ A̱sulazuva. <verse eid="2KI 23:24" /><verse number="25" style="v" sid="2KI 23:25" />Ko ta̱ a̱tsura̱ ko a̱ca̱pa̱ ko elime a̱ yi mogono tsa Josiya shi, za na vadala yi uba̱ta̱ wa̱ A̱sulazuva na̱ Ookolo yi suru na̱ wuma wa̱ yi suru nu ucira wa yi, cine wila̱ wa Musa u dammai.<verse eid="2KI 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 23:26" />Suru na̱ ne, A̱sulazuva a vadala diga a̱tsuma̱ o upan wu usuɗu wa̱ yi shi, za na upan wa̱ yi u da̱na̱i goon uba̱ta̱ wa aza a Yahuda, adama e ili i na suru Manase yuwain za na u zuwai A̱sulazuva a yuwain upan.<note caller="+" style="f"><char style="fr" closed="false">23:26 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Ngo 21:11-16.</char></note> <verse eid="2KI 23:26" /><verse number="27" style="v" sid="2KI 23:27" />A̱vu A̱sulazuva a damma, &lt;&lt;N ta̱ tawa Yahuda diga elime a̱ va̱, ununa n tawai Isra'ila, a̱vu waru n tawa urewesu u va̱ uba̱ta̱ wa Urishelima, lyuci na n ɗangulai, na̱ A̱a̱'isa̱mapaɗa a nda, na n dammai, &lt;Aala a̱ va̱ a̱ ta̱ da̱na̱.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">23:27 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 8:28.</char></note><verse eid="2KI 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 23:28" />Gogo suru linga na Josiya yuwain a tsugono tsa yi, nu suru ili i na u yuwain, a̱ da̱na̱ ta̱ pe uɗanu a̱tsuma̱ aatagada alabari o ngono ma a Yahuda. <verse eid="2KI 23:28" /><verse number="29" style="v" sid="2KI 23:29" />A mantsa ma ndolo ma ɗa Firi'awuna Neko mogono ma Masar ma̱ ka̱ra̱i a̱ tyo uba̱ta̱ o Uɗolu wa Yufiriti tsura̱ u kamba Mogono ma Asuriya uvon. A̱vu mogono Josiya ma̱ ka̱ra̱ adama a na wa yuwan uvon na̱ yi, ɗaɗa Firi'awuna Neko cina ni yi avu wu una yi uba̱ta̱ o uvon ɗe Megido. <verse eid="2KI 23:29" /><verse number="30" style="v" sid="2KI 23:30" />A̱vu agbashi a̱ yi a tara lipu va̱ yi a̱tsuma̱ e ikeke yi ido yu uvon ya̱ yi diga Megido a̱ tyo Urishelima uba̱ta̱ u na a̱ ciɗo ni yi oso a̱ yi.</para>
  <para style="p" vid="2KI 23:30">A̱vu ama e iɗa'a a̱ tsuwa̱a̱n Jehoha ulobo wa Josiya mani'in na wo o'wo mogono me ele o una̱ wa dada va̱ yi.<verse eid="2KI 23:30" /></para>
  <para style="s">Jehoha Mogono ma a Yahuda</para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 23:31" />Jehoha da̱na̱ ta̱ na a aa'wan ushin na̱ aza a ta'atsu a mantsa ma na wo o yi mogono, a̱vu yuwan tsugono tsa woto ta'atsu a̱tsuma̱ a Urishelima. Aala mma va yi ɗa Hamuta, usheli wa Irimiya, vuma va Libina. <verse eid="2KI 23:31" /><verse number="32" style="v" sid="2KI 23:32" />A̱vu Jehoha yuwan iwuya elime a̱ A̱sulazuva, cine nkaya ma̱ yi n yuwain.<verse eid="2KI 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2KI 23:33" />A̱vu Firi'awuna Neko mogono ma Masar me remei a̱vu u ɓa̱ru yi a̱tsuma̱ lyuci va Ribla e iɗa ya Hamat, adama a na wa̱ kuɗa̱ a yuwan tsugono tsa Urishelima, a̱vu u zuwa iɗa'a adama a na a tsupa utafa ukpaku azurufa oɓolo na̱ zinariya. <verse eid="2KI 23:33" /><verse number="34" style="v" sid="2KI 23:34" />A̱vu Firi'awuna Neko mogono ma Masar ma̱ zuwa Eliyakim ulobo wa Josiya mogono una̱ wa dada va̱ yi. A̱vu u vadala aala a̱ yi a̱ tyo Yehoyakim. Amma a̱vu u tara Jehoha a̱ tyo Masar, ɗe ɗa u kuwa̱i.<note caller="+" style="f"><char style="fr" closed="false">23:34 </char><char style="ft" closed="false">Ka̱lyuwa̱: Irm 22:11-12.</char></note><verse eid="2KI 23:34" /></para>
  <para style="s">Yehoyakim mogono ma a Yahuda</para>
  <para style="r">(<ref loc="2CH 36:5-8">2 Alb 36:5-8</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 23:35" />Yehoyakim tsupa ta̱ Firi'awuna Neko azurufa na̱ zinariya cine u cigai. Adama u gura tsupa, a̱vu u paɗaa ama e iɗa a̱ yi utafa adama a na wa̱ tsura̱ azurufa na̱ zinariya u tsupa Firi'awuna ili i na u damma yi.<verse eid="2KI 23:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 23:36" />Yehoyakim da̱na̱ ta̱ na a aa'wan ushin no ozo o ton a mantsa ma na wo o yi mogono, a̱vu yuwain tsugono tsa Urishelima a aa'wan kupa na̱ za̱ ta̱. Aala mma va yi ɗa Zebida, usheli wa Fedaya za va Ruma.<note caller="+" style="f"><char style="fr" closed="false">23:36 </char><char style="ft" closed="false">Ka̱lyuwa̱: Irm 22:18-19; 26:1-6; 35:1-19. </char></note> <verse eid="2KI 23:36" /><verse number="37" style="v" sid="2KI 23:37" />A̱vu u yuwan iwuya elime a̱ A̱sulazuva, cine nkaya ma̱ yi n yuwain.<verse eid="2KI 23:37" /></para>
  <chapter eid="2KI 23" />
  <chapter number="24" style="c" sid="2KI 24" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 24:1" />A mantsa ma tsugono tsa Yehoyakim, reve Nebukanaza mogono ma Babila ma̱ ta̱wa̱ ta̱ nu uvon e iɗa'a, a̱vu Yehoyakim wo o aagbashi a̱yi a aa'wan ata'atsu. Adama o ndolo a̱vu u vadala okolo a̱ yi a̱vu u 'ya̱susa̱a̱n mogono ma Babila aci.<note caller="+" style="f"><char style="fr" closed="false">24:1 </char><char style="ft" closed="false">Ka̱lyuwa̱: Irm 25:1-38; Dan 1:1-2.</char></note> <verse eid="2KI 24:1" /><verse number="2" style="v" sid="2KI 24:2" />A̱vu A̱sulazuva a lyungu aza a Kaldiya na̱ Asuriya na̱ Mowa na̱ a aza a Amon uba̱ta̱ wa̱ yi a yuwan uvon na̱ yi. U lyungu le ta̱ adama a na o kototo iɗa ya a Yahuda, ununa adanshi a A̱sulazuva a dammai a̱tsuma̱ o una wa agbashi a̱ yi ama̱sula̱. <verse eid="2KI 24:2" /><verse number="3" style="v" sid="2KI 24:3" />Amayun ili ndolo cina ta̱ aza a Yahuda ununa A̱sulazuva a dammai, a na o kototo le diga elime a̱ yi, adama o unusu wa Manase, na̱ suru ulinga u naa u yuwain, <verse eid="2KI 24:3" /><verse number="4" style="v" sid="2KI 24:4" />adama a na wu una ta̱ a aza a na a̱ ri nu unusu shi. A̱vu u shiton Urishelima na̱ mpasa ma a aza a babu unusu, agba A̱sulazuva a ciga u yuwaan le gafura shi.<note caller="+" style="f"><char style="fr" closed="false">24:4 </char><char style="ft" closed="false">Ka̱lyuwa̱: U.Wl 29:19.</char></note><verse eid="2KI 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 24:5" />Akapi o ulinga u na Yehoyakim yuwain na̱ suru ili i na u yuwain o tsugono tsa yi, a̱ da̱na̱ ta̱ pe uɗanu a̱tsuma̱ aatagada alabari o ngono ma a Yahuda. <verse eid="2KI 24:5" /><verse number="6" style="v" sid="2KI 24:6" />A̱vu Yehoyakim kuwa̱ ucina nkaya ma̱ yi. A̱vu Yehoyakin ulobo wa̱ yi wo o mogono o una̱ wa̱ yi.<verse eid="2KI 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 24:7" />Mogono ma Masar ma̱ da̱shi uta̱ diga a̱tsuma̱ e iɗa ya̱ yi shi, adama a na mogono ma Babila ma usa ta̱ upasu wi iɗa ya Masar, diga o Uɗolu wa Masar a̱ tyo wu upasu Uɗolu wa Yufiriti.<verse eid="2KI 24:7" /></para>
  <para style="s">Yehoyakin Mogono ma a Yahuda</para>
  <para style="r">(<ref loc="2CH 36:9-10">2 Alb 36:9-10</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 24:8" />Yehoyakin da̱na̱ na ta̱ na a aa'wan kupa na̱ kunla̱ a mantsa ma na wo o'woi mogono, a̱vu u yuwan tsugono tsa woto ta'atsu a̱tsuma̱ a Urishelima. Aala mma va̱ yi ɗa Nehushata usheli wa Elinata va Urushalima. <verse eid="2KI 24:8" /><verse number="9" style="v" sid="2KI 24:9" />A̱vu u yuwan iwuya elime A̱sulazuva, ununa dada va̱ yi yuwain.<verse eid="2KI 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 24:10" />A mantsa mo ndolo agbashi a Nebukanaza mogono ma Babila a̱ ta̱wa̱ ta̱ Urishelima, a̱vu a̱ ka̱nda̱ruwa̱ lyuci'i adama o uvon. <verse eid="2KI 24:10" /><verse number="11" style="v" sid="2KI 24:11" />A̱vu Nebukanaza mogono ma Babila na̱ aciya̱yi u rawa a̱ lyuci'i a mantsa ma na a̱soja yi a̱ ka̱nda̱ruwa̱i lyuci'i adama o uvon. <verse eid="2KI 24:11" /><verse number="12" style="v" sid="2KI 24:12" />Yehoyakin Mogono ma a Yahuda, u ca ta̱ aciya̱yi e ekere mogono ma Babila, na̱ mma va yi na̱ agbashi a̱ yi na̱ azagbain o ukobu wa̱ yi suru. A̱vu mogono ma Babila ma tara yi a̱tsuma̱ aa aa'wan a̱ kunla̱ o tsugono tsa yi, a̱vu Yehoyakin wo o'wo aagbashi.<note caller="+" style="f"><char style="fr" closed="false">24:12 </char><char style="ft" closed="false">Ka̱lyuwa̱: Irm 22:24-30; Irm 24:1-10; Irm 29:1-2.</char></note> <verse eid="2KI 24:12" /><verse number="13" style="v" sid="2KI 24:13" />A̱vu Nebukanaza pura̱ suru utsuru wa̱ A̱a̱'isa̱mapaɗa a̱ A̱sulazuva na̱ za vu ukobu u mogono, a̱vu waru wu ta̱ ili i na i ri na̱ zinariya a aza a na Sulemanu Mogono ma Isra'ila ma yuwain adama A̱a̱'isa̱mapaɗa a̱ A̱sulazuva, cine A̱sulazuva a dammai.<note caller="+" style="f"><char style="fr" closed="false">24:13 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Ngo 20:17.</char></note> <verse eid="2KI 24:13" /><verse number="14" style="v" sid="2KI 24:14" />Nebukanaza pura̱ ta̱ ama a Urishelima reve u ka̱ra̱ na̱ le suru. U ɓolo ta̱ pe na azagbain na̱ nan yali ya̱ a̱soja, na aza a linga ve ekere na̱ a̱za̱ o uruma, ama ukpaku kupa (10,000). A̱za̱ o ulambu a ɗa goon u lyawai pe.<verse eid="2KI 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 24:15" />A̱vu u tara Yehoyakin a̱ tyo Babila. Oɓolo na̱ mma va̱ yi egbere na̱ a̱ma̱ci a̱ yi na azagbain a̱ yi, na a azagbain e iɗa'a. Suru n le u pura̱ le ta̱ diga Urishelima a̱ tyo e iɗa ya Babila tsugbashi. <verse eid="2KI 24:15" /><verse number="16" style="v" sid="2KI 24:16" />A̱vu mogono ma Babila ma̱ ta̱wa̱ na agbashi a aza a na a gurai uvon a̱tsuma̱ Babila a̱bunda̱ ele ukpaku kupocindere (7,000) a ɗa, aza o ucira na̱ aza a na a gurai uvon, a̱vu waru u tara aza a na a gurai ulinga wu ukere na̱ a ruma ukpaku uta̱ (1,000). <verse eid="2KI 24:16" /><verse number="17" style="v" sid="2KI 24:17" />A̱vu mogono ma Babila ma zuwa Mataniya, za wa'a va dada va Yehoyakin wo o'wo mogono o una̱ wa̱ yi, a̱vu u vadala aala a̱ yi a̱ tyo Zedekiya.<note caller="+" style="f"><char style="fr" closed="false">24:17 </char><char style="ft" closed="false">Ka̱lyuwa̱: Irm 37:1; Izk 17:13. </char></note><verse eid="2KI 24:17" /></para>
  <para style="s">Zedekiya Mogono ma a Yahuda</para>
  <para style="r">(<ref loc="2CH 36:11-12">2 Alb 36:11-12</ref>; <ref loc="JER 52:1-3">Irm 52:1-3</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 24:18" />Zedekiya da̱na̱ ta̱ na̱ aa'wan ushin na̱ za ta̱ a mantsa ma na u temei tsugono. U yuwa ta̱ tsugono a̱tsuma̱ a̱ Urishelima a'wan kupa na̱ za ta̱. Aala mma va̱ yi ɗa Hamuta usheli wa̱ Irimiya vuma va Libina.<note caller="+" style="f"><char style="fr" closed="false">24:18 </char><char style="ft" closed="false">Ka̱lyuwa̱: Irm 27:1-22; 28:1-17.</char></note> <verse eid="2KI 24:18" /><verse number="19" style="v" sid="2KI 24:19" />U yuwan ta̱ iwuya elime a̱ A̱sulazuva, ununa mogono Yehoyakim yuwain. <verse eid="2KI 24:19" /><verse number="20" style="v" sid="2KI 24:20" />Adama o upan wa̱ A̱sulazuva a ɗa ili i nda suru u cinai aza a Urishelima na̱ Yahuda, a̱vu u kototo le elime yi. A̱vu Zedekiya 'ya̱sa̱a̱n mogono ma Babila aci.</para>
  <para style="s" vid="2KI 24:20">A̱risa̱ aza a Urushalima</para>
  <para style="r" vid="2KI 24:20">(<ref loc="2CH 36:13-21">2 Alb 36:13-21</ref>; <ref loc="JER 39:1-7">Irm 39:1-7</ref>; <ref loc="JER 52:3b-11">Irm 52:3b-11</ref>)</para>
  <para style="p" vid="2KI 24:20">Ɗaɗa Zedekiya 'ya̱sa̱a̱n yi mogono ma Babila aci.<verse eid="2KI 24:20" /></para>
  <chapter eid="2KI 24" />
  <chapter number="25" style="c" sid="2KI 25" />
  <para style="p">
    <verse number="1" style="v" sid="2KI 25:1" />A̱tsuma̱ a aa'wan a̱ kucci o tsugono tso o mogono Zedekiya, o urana wa kupa o woto wa kupa, a̱vu Nebukanaza mogono ma Babila u ta̱wa̱ na̱ a̱soja a̱ yi suru adama a na a yuwan uvon a̱tsuma̱ a̱ Urishelima. A̱vu u uka̱nda̱ruwa̱ lyuci'i nu uvon, a̱vu a suwa ukari a̱ ka̱nda̱ruwa̱ adama o uvon.<note caller="+" style="f"><char style="fr" closed="false">25:1 </char><char style="ft" closed="false">Ka̱lyuwa̱: Irm 21:1-10; Irm 34:1-5; Izk 24:2.</char></note> <verse eid="2KI 25:1" /><verse number="2" style="v" sid="2KI 25:2" />A̱vu u kandara i lyuci'i nu uvon hali acina a aa'wan kupa na̱ za ta̱ o tsugono tsa mogono Zedekiya. <verse eid="2KI 25:2" /><verse number="3" style="v" sid="2KI 25:3" />A̱tsuma̱ o urana wa̱ kucci o woto wa̱ na̱shi, a mantsa ma na ambulu a yuwain lon a̱tsuma̱ e ilyuci'i, agba babu ilyalya i na ama a lyuwa, <verse eid="2KI 25:3" /><verse number="4" style="v" sid="2KI 25:4" />a̱vu o ɓoso upasu u ro wu ukari u lyuci'i, a̱vu suru a̱soja'a a suma naa ayin nu una̱ntsu u na u ri e memere ma ɓaɓu na ri ejere, za na ri zuzu na̱ a̱a̱rumbu o mogono. A mantsa ma na a̱soja a Babila<note caller="+" style="f"><char style="fr" closed="false">25:4 </char><char style="ft" closed="false">a̱soja a Babila: Na̱ Tsuyahuda a ɗana ta̱ &lt;&lt;Kaldiya&gt;&gt; pa nda. Ne ɗa waru u ri 25:5,13,25,26.</char></note> a̱ da̱na̱i uka̱nda̱ruwu na̱ lyuci'i, a̱vu a suma a̱ tyo wu upasu wa a Araba. <verse eid="2KI 25:4" /><verse number="5" style="v" sid="2KI 25:5" />A̱vu a̱soja a Babila a saɓa mogono Zedekiya a̱vu e reme yi agalaci a Jeriko. A̱vu a̱soja a̱ yi suru e bete'we a lyawai. <verse eid="2KI 25:5" /><verse number="6" style="v" sid="2KI 25:6" />A̱vu a̱soja a Babila e remei a̱ ta̱wa̱ na̱ yi uba̱ta̱ u mogono ma Babila za na ri na̱ nden Ribla, ɗe ɗa mogono ma Babila ma paɗa ni yi ili na a yuwan na̱ yi. <verse eid="2KI 25:6" /><verse number="7" style="v" sid="2KI 25:7" />A̱vu a paɗa o olobo a Zedekiya esu a̱ yi. Reve a foɗo esu a̱ yi a̱vu a̱ nla̱yi na akani a̱ rumushili a tara yi a̱ tyo Babila.<note caller="+" style="f"><char style="fr" closed="false">25:7 </char><char style="ft" closed="false">Ka̱lyuwa̱: Izk 12:13.</char></note><verse eid="2KI 25:7" /></para>
  <para style="s">Ukototosu wa̱ A̱a̱'isamapaɗa</para>
  <para style="r">(<ref loc="2CH 36:17-21">2 Alb 36:17-21</ref>; <ref loc="JER 39:8-10">Irm 39:8-10</ref>; <ref loc="JER 52:12-23">Irm 52:12-23</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 25:8" />O urana wa cindere o woto wa tawun, za na da̱na̱i a aa'wan kupa na̱ kucci o tsugono tsa Nebukanaza mogono ma Babila, Nebuzarada, yali ya aza a na a yuwusan ipiri zagbain mogono ma Babila, ma̱ ta̱wa̱ ta̱ Urishelima. <verse eid="2KI 25:8" /><verse number="9" style="v" sid="2KI 25:9" />A̱vu u kuloto A̱a̱'isa̱mapaɗa a̱ A̱sulazuva nu u'wa u mogono, na̱ suru 'wa va Urishelima. Reve fo u kuloto u'wa u sa'ani suru.<verse eid="2KI 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 25:10" />A̱vu suru a̱soja a Babila aza a na a̱ da̱na̱i za̱la̱ vu zagbain va̱ a̱za̱ e ipiri ya Nebuzarada, o ɓoso kari n na a̱ da̱na̱i uka̱nda̱ruwu na̱ Urishelima. <verse eid="2KI 25:10" /><verse number="11" style="v" sid="2KI 25:11" />A̱vu Nebuzarada tara akapi a ama a na a buwai a̱tsuma̱ a̱ lyuci a̱ ka̱ra̱ a̱ tyo Babila, na aza a na a gurai ulinga wu ukere, oɓolo na aza a na a ca yi aciya̱ le e ekere o mogono ma aza a Babila. <verse eid="2KI 25:11" /><verse number="12" style="v" sid="2KI 25:12" />Reve u lyawa pe aza a na a̱ ri nu ulambu a̱tsuma̱ e iɗa'a adama a na a cimba a̱vu waru e idana uɗuma̱ u inabi.<verse eid="2KI 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 25:13" />A̱vu a̱ a̱soja a Babila o ɓuɓoso atsura e irumushili na ri pe a̱tsuma̱ o u'wa wa̱ A̱sulazuva, oɓolo na̱ wisawatan na ri pe a̱tsuma̱ o u'wa'a, na̱ a̱a̱ba̱jini o ura'atsu wu rumushili a na a̱ tsu ɗe Mala. Reve a̱ a̱soja'a a̱ pura̱ le a̱ tyo Babila.<note caller="+" style="f"><char style="fr" closed="false">25:13 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 7:15-26; 2 Alb 3:15-17.</char></note> <verse eid="2KI 25:13" /><verse number="14" style="v" sid="2KI 25:14" />A̱vu a̱ pura̱ mpondo na̱ isheburu, na̱ ili i na a̱ tsu zuwusa ifitila, na̱ ntaɗa na̱ suru ili i na a yuwain na̱ rumushili na yuwusan ulinga na̱ le pe a̱tsuma̱ A̱a̱'isa̱mapaɗa a̱ A̱sulazuva.<note caller="+" style="f"><char style="fr" closed="false">25:14 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 7:45; 2 Alb 4:16.</char></note> <verse eid="2KI 25:14" /><verse number="15" style="v" sid="2KI 25:15" />A̱vu waru a̱ pura̱ mpara aza a na a̱ tsu purusa̱ akinkina na̱ ntaɗa, na̱ suru ili i na a yuwain za zinariya na̱ suru ili i na i ri za azurufa, Yali ya soja i pura̱ le ta̱ a̱vu u ka̱ra̱ na̱ le. <verse eid="2KI 25:15" /><verse number="16" style="v" sid="2KI 25:16" />Rumushili na a yuwayin atsura e re, na aakwanu a gbain na̱ a̱shuwutsu a̱ mishin, aza a na Sulemanu yuwain adama A̱a̱'isa̱mapaɗa a̱ A̱sulazuva, a la'a ta̱ ucira u na a̱ kunzu le. <verse eid="2KI 25:16" /><verse number="17" style="v" sid="2KI 25:17" />Suru atsura u da̱na̱ ta̱ udasuwu mishin ushin na̱ aza cindere. Rumushili na ri zuva va atsura'a suru u da̱na̱ ta̱ udasuwu una̱shi naa akapi, waru u da̱na̱ ta̱ wupalu na̱ yironishi u muwun mu uɗanga m peme suru va̱ yi. Akapi atsura, a̱ da̱na̱ ta̱ fo u na̱ uta̱.<verse eid="2KI 25:17" /></para>
  <para style="s">A̱ purisa̱ ta̱ aza a Yahuda wa̱ i re a̱ tyo tsugbashi</para>
  <para style="r">(<ref loc="JER 52:24-27">Irm 52:24-27</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 25:18" />Yali ya̱ a̱za̱ e ipiri yu u'wa u mogono ma Babila u tara ta̱ Seraya zagbain nan ganu na̱ Zafaniya za na o to yi, oɓolo na̱ ama a ta'atsu a aza a na a yuwusan ipiri yu una̱ntsutsu wa̱ A̱a̱'isamapaɗa a̱ A̱sulazuva. <verse eid="2KI 25:18" /><verse number="19" style="v" sid="2KI 25:19" />Diga a̱tsuma̱ ama a na a buwai a̱tsuma̱ a̱ lyuci'i, a̱vu u tara yali ya̱ a̱soja, na̱ azagbain o ton o mogono, a̱vu waru u tara za vi iɗana i na nan yali ya̱ a̱soja za na ɓoloto yi ama a̱ lyuci'i, oɓolo na ama o ro kupota̱li aza a na a cina yi pe a̱tsuma̱ lyuci'i. <verse eid="2KI 25:19" /><verse number="20" style="v" sid="2KI 25:20" />Nebuzarada pura̱ ta̱ a ama a nda suru u ta̱wa̱ na̱ le uba̱ta̱ u mogono ma Babila a Ribla. <verse eid="2KI 25:20" /><verse number="21" style="v" sid="2KI 25:21" />A̱vu mogono ma Babila mo una le a̱tsuma̱ o upasu wa̱ Ribla wi iɗa ya Hamat. Ne ɗa o uta̱yi a ama a Yahuda diga e iɗa i le.<verse eid="2KI 25:21" /></para>
  <para style="s">Gedaliya gwamna va aza a Yahuda</para>
  <para style="r">(<ref loc="JER 40:7-9">Irm 40:7-9</ref>; <ref loc="JER 41:1-3">41:1-3</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 25:22" />A̱vu Nebukanaza mogono ma Babila u zuwa Gedaliya ulobo wa Ahikam, ulobo wa Shafa, wo o'wo zagbain va aza a na a buwai a Yahuda. <verse eid="2KI 25:22" /><verse number="23" style="v" sid="2KI 25:23" />Ana suru nan yali ya̱ a̱soja a uwwai a na mogono ma Babila u ɗangula ta̱ Gedaliya gwamna, a̱vu a̱ ta̱wa̱ uba̱ta̱ wa̱ yi a Mizfa. Ele ɗa Ishma'ila ulobo wa Netaniya na̱ Yohanan ulobo wa Kareya na̱ Seraya ulobo wa Tahume vuma va Netofa na̱ Yazaniya ulobo u vuma va Ma'aka, na̱ ama a̱ le. <verse eid="2KI 25:23" /><verse number="24" style="v" sid="2KI 25:24" />A̱vu Gedaliya kucinaa le na akapi a̱soja'a u damma, &lt;&lt;Shi uwwa wovon wa azagbain a Babila wan. I da̱nu pe a̱tsuma̱ e iɗa'a, a̱vu i yuwaan mogono ma Babila a̱ga̱nda̱, i ta̱ a̱ da̱na̱ na̱ asuvu nden. &gt;&gt;<verse eid="2KI 25:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 25:25" />A̱tsuma̱ woto wa̱ cindere, ɗaɗa Ishma'ila ulobo wa Netaniya, ulobo wa Elishama, za na da̱na̱i diga o u'wa u mogono, ta̱wa̱i na ama kupa a̱vu wu una Gedaliya a̱vu waru wu una ama a Yahuda na aza a Babila a aza a na a̱ da̱na̱i oɓolo na̱ Gedaliya a̱tsuma̱ a Mizfa. <verse eid="2KI 25:25" /><verse number="26" style="v" sid="2KI 25:26" />A̱vu suru ama'a, za ke'en na̱ zagbain, oɓolo na̱ nan yali ya̱ a̱soja a suma a̱ tyo e iɗa ya Masar, adama o wovon wa̱ a̱soja a Babila.<verse eid="2KI 25:26" /></para>
  <para style="s">A lyawa ta̱ Yehoyakin diga o u'wa wa ali</para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 25:27" />Mogono Yehoyakin va Yahuda yuwan ta̱ a'wan mata'atsu na̱ a̱za̱ e cindere o u'wa wa ali a Babila. A̱tsuma̱ o urana wu ushin no ozo o ton o woto wa kupa ne ejere aa'wan a na Ebilmeroda wo o'woi mogono ma Babila, reve u roco mogono Yehoyakin va Yahuda isa'ani wu uta̱ yi diga a̱tsuma̱ o u'wa wa ali.<note caller="+" style="f"><char style="fr" closed="false">25:27 </char><char style="ft" closed="false">Yehoyakin: E revei ta̱ na aala waru &lt;&lt;Yekoniya&gt;&gt;. Ka̱lyuwa̱: Mat 1:11.</char></note> <verse eid="2KI 25:27" /><verse number="28" style="v" sid="2KI 25:28" />Mogono Ebilmeroda maa yuwaan yi ta̱ adanshi a sa'ani, reve u ca yi tsugono ula'awu na̱ ngono n na n da̱na̱i e ekere a̱ yi a̱tsuma̱ a Babila. <verse eid="2KI 25:28" /><verse number="29" style="v" sid="2KI 25:29" />Reve a̱ usu wa̱ mogono Yehoyakin foɗo itana ya̱ yi yu u'wa wa ali. Diga a mantsa mo ndolo ɗa u temei a lyuwusa ilyalya apada oɓolo na̱ Mogono Ebilmeroda hali acina ukosu wu rana wuma va̱ yi suru. <verse eid="2KI 25:29" /><verse number="30" style="v" sid="2KI 25:30" />Reve mogono Ebilmeroda va Babila ma zuwa a casu Yehoyakin mu kebe wa'a wa'a wa ana'an na̱ nfa'an, acina ukosu wu rana wuma va̱ yi suru.<verse eid="2KI 25:30" /></para>
  <chapter eid="2KI 25" />
</usx>