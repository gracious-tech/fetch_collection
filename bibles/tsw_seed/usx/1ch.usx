<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CH" style="id">- Tsishingini (tsw)</book>
  <para style="h">Alabari</para>
  <para style="toc3">1 Alb</para>
  <para style="toc2">1 Alabari</para>
  <para style="toc1">1 Alabari</para>
  <para style="mt2">1 Alabari</para>
  <para style="mt1">1 Alabari</para>
  <para style="is">Ucuɗuwu wa aatagada a nda</para>
  <para style="ip">Aatagada o ufaru na̱ za ire wa Alabari, na̱ a̱bunda̱ e le alabari a ɗa na̱ a̱a̱ tsura̱ a̱tsuma̱ atagada a Sama'ila na̱ za vu Ngono, amma a ca ta̱ alabari a nda nu urevetyowu u ro ko'o. A̱ ta̱ pe ni ili i re i na i ri a mmalu a̱tsuma̱ a alabari o tsugono tsa Isra'ila a̱tsuma̱ a aatagada o ufaru na̱ za ire wa Alabari.</para>
  <para style="ip">1. Adama a na o roco suru na addama a na a̱ riya̱a̱ yi tsugono tsa Isra'ila na̱ za va a Yahuda, hali n gogo A̱sula̱ a̱ ta̱ mishin e ekere a nzuwulai n na u yuwayin iɗa'a, u to shitosun ifoɓi ya̱ yi adama a ama a̱ yi e ekere a aza a na a̱ ri na̱ nden a̱tsuma̱ a Yahuda. Za vi iɗana i nda u ca ta̱ urevetyowu wu ulyuwu wa aci a gbain a̱ Da̱wuda na̱ Sulemanu, na̱ yilapulishi yo Mogono Yehoshafa, na̱ za Mogono Hezekiya, na̱ za Mogono Yosiya, oɓolo na ama a na a̱ da̱na̱i na̱ a̱ɓula̱ uba̱ta̱ wa̱ A̱sula̱.</para>
  <para style="ip">2. Adama o roco ununa a̱a̱ da̱na̱ a yuwusaan A̱sula̱ a̱ga̱nda̱ a̱tsuma̱ a Urishelima, na̱ cine o foɓoi ulinga u nan ganu na̱ aza a nan Levi. Ekere e ifoɓi i nda ɗa o toni shi na̱ mayan ma̱ a̱ga̱nda̱ a̱tsuma̱ A̱a̱'isa̱mapaɗa. Atagada alabari o roco ta̱ a na Da̱wuda ɗa shuwa̱i A̱a̱'isa̱mapaɗa ni ifoɓi yu ulinga wa̱ yi, ko wo o'woi Sulemanu ɗa ta̱ koso suwai A̱a̱'isamapaɗa'a.</para>
  <para style="is">Ili i na i ri pe a̱tsuma̱ a aatagada a nda</para>
  <para style="io1">Ala o gundo 1:1-9:44</para>
  <para style="io1">Ukwa̱ wa Shawulu Mogono 10:1-14</para>
  <para style="io1">Tsugono tsa̱ Da̱wuda mogono 11:1-29:30</para>
  <para style="io2">a. A̱tsuma̱lima̱ nu ulyuwu wa aci 11:1-22:1</para>
  <para style="io2">b. Ifoɓi adama o usa wa̱ A̱a̱'isa̱mapaɗa</para>
  <para style="ib" />
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s1">Aatagada a Alabari diga Ada̱mu a̱ tyo ya Ibrahim</para>
  <para style="s2">Ugundo wa̱ Nuhu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 1:1" />Ada̱mu ɗa matsain Shitu, a̱vu Shitu matsan Enosh, <verse eid="1CH 1:1" /><verse number="2" style="v" sid="1CH 1:2" />a̱vu Enosh matsan Kena, Kena ɗa matsain Mahalale, Mahalale ɗa matsain Jare, <verse eid="1CH 1:2" /><verse number="3" style="v" sid="1CH 1:3" />Jare ɗa matsain Anuhu, a̱vu Anuhu matsan Metusela, Metusela gba a̱yi ɗa u matsain Lame na̱ Nuhu. <verse eid="1CH 1:3" /><verse number="4" style="v" sid="1CH 1:4" />Olobo a̱ Nuhu ele ɗa: Shem na̱ Ham na̱ Jafe.<verse eid="1CH 1:4" /></para>
  <para style="s2">Ugundo wa Jafe</para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 1:5" />Olobo a Jafe ele ɗa: Goma na̱ Mago na̱ Madai na̱ Javan na̱ Tuba na̱ Meshe na̱ Tira. <verse eid="1CH 1:5" /><verse number="6" style="v" sid="1CH 1:6" />Olobo a̱ Goma ele ɗa: Ashekena na̱ Rifa na̱ Togarama. <verse eid="1CH 1:6" /><verse number="7" style="v" sid="1CH 1:7" />Olobo a Javan ele ɗa: Elishaha Tarshishi na̱ Kitim na̱ Rodanim.<verse eid="1CH 1:7" /></para>
  <para style="s2">Ugundo wa Ham</para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 1:8" />Olobo a Ham ele ɗa,</para>
  <para style="li2" vid="1CH 1:8">Kush na̱ Mizirayim na̱ Fut na̱ Ka'ana.<verse eid="1CH 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 1:9" />Olobo a̱ Kush ele ɗa,</para>
  <para style="li2" vid="1CH 1:9">Seba na̱ Havila na̱ Sabta na̱ Ra'ama na̱ Sabteka.</para>
  <para style="li1" vid="1CH 1:9">Olobo a Rama ele ɗa,</para>
  <para style="li2" vid="1CH 1:9">Sheba na̱ Dedan.<verse eid="1CH 1:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 1:10" />Kush ɗa matsain Nimro.</para>
  <para style="li2" vid="1CH 1:10">Nimro kungwa ta̱ a̱vu wo o'wo za na gurai uvon lon a̱tsuma̱ o uvaɗi.<verse eid="1CH 1:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 1:11" />Mizirayim matsan ta̱</para>
  <para style="li2" vid="1CH 1:11">aza a Lud na aza a Anam na aza a Leha na aza a Nafutuhim, <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" />na aza a Faturu na aza a Kiri na aza a Kaslu ugundo u na aza a Filistiya o uta̱i.<verse eid="1CH 1:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 1:13" />Ka'ana ɗa matsain</para>
  <para style="li2" vid="1CH 1:13">Sidon ulobo wu ufaru wa̱ yi, zagbain vu ugundo wa Sidon na aza a Hitiya, <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />waru na aza a Jebusiya, na aza a Amoriya na a aza a Girigashiya, <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" />na aza a Hiviya, na aza Arikiya na Siniya, <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" />na aza a Arvadiya na aza a Zemariya, na Hamatiya.<verse eid="1CH 1:16" /></para>
  <para style="s2">Ugundo wa Shem</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 1:17" />Olobo a Shem ele ɗa,</para>
  <para style="li2" vid="1CH 1:17">Elam na̱ Ashu na̱ Arafakashada na̱ Lud na̱ Aram. Olobo a Aram ele ɗa, Uz na̱ Hul na̱ Gete na̱ Meshe.<verse eid="1CH 1:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 1:18" />Arafakashada ɗa matsain Shela,</para>
  <para style="li2" vid="1CH 1:18">a̱vu Shela matsan Eba.<verse eid="1CH 1:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 1:19" />A matsaan ta̱ Eba olobo e re</para>
  <para style="li2" vid="1CH 1:19">za ta̱ ndolo a̱ tsu ɗe a̱ yi ta̱ Pele,<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">Ka̱lyuwa̱: Urevu wa aala a nda Fele na̱ Tsuyahuda cine a̱ tsu damma aala'a, vu tsu uwwai ta̱ gashi idanshi i ɗa i na i ri nu urevu she damma &lt;&lt;Une'esun u ɗa&gt;&gt;. </char></note></para>
  <para style="li1" vid="1CH 1:19">adama a na a mantsa mo ndolo ma ɗa e ne'eshein uvaɗi, mawun ma̱ a̱na̱wun ma̱ yi a̱ tsu ɗe yi ta̱ Yokatan.<verse eid="1CH 1:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 1:20" />Yokatan ɗa matsain</para>
  <para style="li2" vid="1CH 1:20">Almoda na̱ Shelefa na̱ Hazamawe na̱ Jera, <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" />na̱ Hadoram na̱ Uzalu na̱ Dikala, <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" />na̱ Eba na̱ Abimayel na̱ Sheba, <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" />na̱ Ofi na̱ Havila na̱ Yoba. Suru nle ndolo gba olobo a Yokatan a ɗa.<verse eid="1CH 1:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="1CH 1:24" />Ugeru u limatan diga ya Shem a̱ tyo ya Ibrahim ele ɗa:</para>
  <para style="li2" vid="1CH 1:24">Shem na̱ Arafakashada na̱ Shela, <verse eid="1CH 1:24" /><verse number="25" style="v" sid="1CH 1:25" />na̱ Eba na̱ Pele na̱ Reyu, <verse eid="1CH 1:25" /><verse number="26" style="v" sid="1CH 1:26" />na̱ Seru na̱ Naho na̱ Tera, <verse eid="1CH 1:26" /><verse number="27" style="v" sid="1CH 1:27" />na̱ Aburam, za na a̱ tsu ɗe Ibrahim.<verse eid="1CH 1:27" /></para>
  <para style="s2">Limatan va Ibrahim</para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 1:28" />Olobo a Ibrahim ele ɗa: Ishiyaku na̱ Isma'ila.<note caller="+" style="f"><char style="fr" closed="false">1:28 </char><char style="ft" closed="false">Ka̱lyuwa̱: Ufr 25:12-16.</char></note><verse eid="1CH 1:28" /></para>
  <para style="s2">Limatan va Isma'ila</para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 1:29" />Mpa nda limatan va Isma'ila:</para>
  <para style="li1" vid="1CH 1:29">Nebayo ulobo wu ufaru wa Isma'ila, na̱ Keda na̱ Adibeyel na̱ Mibisam <verse eid="1CH 1:29" /><verse number="30" style="v" sid="1CH 1:30" />na̱ Mishima na̱ Duma na̱ Masa na̱ Hada na̱ Tema <verse eid="1CH 1:30" /><verse number="31" style="v" sid="1CH 1:31" />na̱ Yetu na̱ Nafi na̱ Kedema. Ele nda ele ɗa limatan va Isma'ila.<verse eid="1CH 1:31" /></para>
  <para style="s2">Limatan va̱ Ketura</para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 1:32" />Olobo a na Ketura matsain, ka vu nge'en ma Ibrahim ele ɗa:</para>
  <para style="li2" vid="1CH 1:32">Zimran na̱ Yokushan na̱ Medan na̱ Midiya na̱ Ishiba na̱ Shuwa. Olobo a Jokushan ele ɗa: Sheba na̱ Dedan.<verse eid="1CH 1:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 1:33" />Olobo a Midiya ele ɗa: Efa na̱ Efe na̱ Hano na̱ Abida na̱ Elda'a. Ele nda suru olobo a Ketura ɗa. <verse eid="1CH 1:33" /><verse number="34" style="v" sid="1CH 1:34" />Ibrahim ɗa matsain Ishiyaku.</para>
  <para style="li1" vid="1CH 1:34">Olobo a Ishiyaku ele ɗa:</para>
  <para style="li2" vid="1CH 1:34">Isuwa na̱ Isra'ila.<verse eid="1CH 1:34" /></para>
  <para style="s">Olobo a Isuwa</para>
  <para style="r">(<ref loc="GEN 36:1-19">Ufr 36:1-19</ref>)</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 1:35" />Olobo a Isuwa ele ɗa:</para>
  <para style="li2" vid="1CH 1:35">Elifaza na̱ Reyuwe na̱ Yewush na̱ Yalam na̱ Kora.<verse eid="1CH 1:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 1:36" />Olobo a Elifaza ele ɗa:</para>
  <para style="li2" vid="1CH 1:36">Teman na̱ Oma na̱ Zefi na̱ Gata na̱ Kena na̱ Timna na̱ Amaleka.<verse eid="1CH 1:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 1:37" />Olobo a Reyuwe ele ɗa:</para>
  <para style="li2" vid="1CH 1:37">Naha na̱ Zera na̱ Shama na̱ Miza.<verse eid="1CH 1:37" /></para>
  <para style="s">Ama a Seyi a̱tsuma̱ a Edom</para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 1:38" />Olobo a Seyi ele ɗa:</para>
  <para style="li2" vid="1CH 1:38">Lotan na̱ Shoba na̱ Zibiyon na̱ Ana na̱ Dishon na̱ Eze na̱ Disha.<verse eid="1CH 1:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 1:39" />Olobo a Lotan ele ɗa:</para>
  <para style="li1" vid="1CH 1:39">Hori na̱ Homa. Timna mawun ma̱ a̱na̱wun mo usheli ma Lotan ma ɗa.<verse eid="1CH 1:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 1:40" />Olobo a Shoba ele ɗa:</para>
  <para style="li2" vid="1CH 1:40">Aluwa na̱ Manaha na̱ Eba na̱ Shefo na̱ Onam.</para>
  <para style="li1" vid="1CH 1:40">Olobo a Zibiyon ele ɗa:</para>
  <para style="li2" vid="1CH 1:40">A'iya na̱ Ana.<verse eid="1CH 1:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 1:41" />Ulobo wa Ana a̱yi ɗa:</para>
  <para style="li2" vid="1CH 1:41">Dishon.</para>
  <para style="li1" vid="1CH 1:41">Olobo a Dishon ele ɗa:</para>
  <para style="li2" vid="1CH 1:41">Hemdan na̱ Eshban na̱ Itira na̱ Kera.<verse eid="1CH 1:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 1:42" />Olobo a Eze ele ɗa:</para>
  <para style="li2" vid="1CH 1:42">Bilihan na̱ Zayawa na̱ Ya'akan.</para>
  <para style="li1" vid="1CH 1:42">Olobo a Dishon ele ɗa:</para>
  <para style="li2" vid="1CH 1:42">Uz na̱ Aran.<verse eid="1CH 1:42" /></para>
  <para style="s">Ngono ma aza a Edom</para>
  <para style="r">(<ref loc="GEN 36:31-43">Ufr 36:31-43</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 1:43" />Ele nda ele ɗa aza na a yuwain tsugono tsi iɗa ya̱ Edom kafu aza a Isra'ila a̱ ta̱wa̱ a̱ tsura̱ mogono:</para>
  <para style="li1" vid="1CH 1:43">Bela ulobo wa Beyo, aala a̱ lyuci va̱ yi a̱ yi ɗa Dinhaba.<verse eid="1CH 1:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 1:44" />Ana Bela kuwa̱i a̱vu Yoba ulobo wa Zera diga a̱ lyuci va Bozura lyuwa tsugono o una̱ wa̱ yi.<verse eid="1CH 1:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 1:45" />Ana Yoba kuwa̱i a̱vu Husham a̱tsuma̱ e iɗa ya Tema lyuwa tsugono o una̱ wa̱ yi.<verse eid="1CH 1:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 1:46" />Ana Husham kuwa̱i, a̱vu Hada ulobo wa Beda, za na lyuwai aza Midiya a̱tsuma̱ e iɗa ya Mowa nu uvon, u lyuwa tsugono o una̱ wa̱ yi. Aala a̱ lyuci va̱ yi ɗa Avit.<verse eid="1CH 1:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 1:47" />Ana Hada kuwa̱i a̱vu Samla diga e iɗa ya̱ Masreka lyuwa tsugono o una̱ wa̱ yi.<verse eid="1CH 1:47" /></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 1:48" />Ana Samla kuwa̱i a̱vu Shawulu diga Rehobot a̱ nge'en mu uɗolu wa̱ Yufireti u lyuwa tsugono o una̱ wa̱ yi.<verse eid="1CH 1:48" /></para>
  <para style="li1">
    <verse number="49" style="v" sid="1CH 1:49" />Ana Shawulu kuwa̱i a̱vu Ba'al Hanan ulobo wa Akubo u lyuwa tsugono o una̱ wa̱ yi.<verse eid="1CH 1:49" /></para>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 1:50" />Ana Ba'al Hanan kuwa̱i a̱vu Hada lyuwa tsugono o una̱ wa̱ yi. Aala a̱ lyuci va̱ yi ɗa Pawu. Aala a ka va̱ yi ɗa Mehetabe, usheli wa Matre. Matre waru a̱yi ɗa usheli wa Mezaha.<verse eid="1CH 1:50" /></para>
  <para style="li1">
    <verse number="51" style="v" sid="1CH 1:51" />Hada waru u kuwa̱ ta̱.</para>
  <para style="b" vid="1CH 1:51" />
  <para style="li1" vid="1CH 1:51">Ngono ma Edom ele ɗa a̱ shi:</para>
  <para style="li2" vid="1CH 1:51">Timna na̱ Alwa na̱ Yete, <verse eid="1CH 1:51" /><verse number="52" style="v" sid="1CH 1:52" />na̱ Oholibama na̱ Ela na̱ Fino, <verse eid="1CH 1:52" /><verse number="53" style="v" sid="1CH 1:53" />na̱ Kena na̱ Teman na̱ Mibiza, <verse eid="1CH 1:53" /><verse number="54" style="v" sid="1CH 1:54" />na̱ Magudiye na̱ Iram. Ele nda ele ɗa a̱ shi ngono ma Edom.<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="s">Olobo a Isra'ila</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 2:1" />Apa nda olobo a Isra'ila:</para>
  <para style="li2" vid="1CH 2:1">Roben na̱ Saminu na̱ Levi na̱ Yahuda na̱ Isaka na̱ Zebulun <verse eid="1CH 2:1" /><verse number="2" style="v" sid="1CH 2:2" />na̱ Dan na̱ Isuhu na̱ Banyami na̱ Nafutali na̱ Gadu na̱ Asha.<verse eid="1CH 2:2" /></para>
  <para style="s">Ugundo wa Yahuda</para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 2:3" />Olobo a Yahuda ele ɗa:</para>
  <para style="li2" vid="1CH 2:3">Er na̱ Onan na̱ Shela. Mata'atsu me le suru ka va Ka'ana usheli wa Shuwa u ɗa u matsaan niyi ele. Amma Er ulobo wu ufaru wa Yahuda ma̱ shi ta̱ ni iwuya e ekere a̱ A̱sulazuva, ɗaɗa gba A̱sulazuva o una niyi.<verse eid="1CH 2:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 2:4" />Tamar jene va Yahuda matsaan yi ta̱ Pere na̱ Zera. Yahuda shi ta̱ no olobo o ton suru suru.<verse eid="1CH 2:4" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="5" style="v" sid="1CH 2:5" />Olobo a Pere ele ɗa:</para>
  <para style="li2" vid="1CH 2:5">Hezeron na̱ Hamu.<verse eid="1CH 2:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 2:6" />Olobo a Zera ele ɗa:</para>
  <para style="li2" vid="1CH 2:6">Zimri na̱ Etan na̱ Hema na̱ Kalko na̱ Darda, ele ɗa ama o ton suru suru.<verse eid="1CH 2:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 2:7" />Ulobo wa Karmi a̱yi ɗa:</para>
  <para style="li2" vid="1CH 2:7">Akan, za na ronoyi aza a Isra'ila a̱tsuma̱lima̱, a na u kuɗai wila̱ e ekere e ili i na a tawai adama o ukototosu.<verse eid="1CH 2:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 2:8" />Ulobo wa Etan a̱yi ɗa:</para>
  <para style="li2" vid="1CH 2:8">Azariya.<verse eid="1CH 2:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 2:9" />Olobo a na a matsayin Hezeron ele ɗa:</para>
  <para style="li2" vid="1CH 2:9">Yerameye na̱ Ram na̱ Keleb.<verse eid="1CH 2:9" /></para>
  <para style="s">Ugundo wa Ram</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 2:10" />Ram ɗa matsain Aminada,</para>
  <para style="li2" vid="1CH 2:10">reve Aminada matsan Nashon, zagbain va aza a Yahuda. <verse eid="1CH 2:10" /><verse number="11" style="v" sid="1CH 2:11" />Nashon ɗa matsain Salmon, Salmon ɗa matsain Buwaza. <verse eid="1CH 2:11" /><verse number="12" style="v" sid="1CH 2:12" />Buwaza ɗa matsain Obe, reve Obe matsan Yese. <verse eid="1CH 2:12" /><verse number="13" style="v" sid="1CH 2:13" />Yese ɗa matsain Eliyabu ulobo wu ufaru wa̱ yi. Za va ire a̱yi ɗa Abinada, za va ta'atsu waru Shima <verse eid="1CH 2:13" /><verse number="14" style="v" sid="1CH 2:14" />Za va̱ na̱shi a̱yi ɗa Netane, za va tawun waru Radai. <verse eid="1CH 2:14" /><verse number="15" style="v" sid="1CH 2:15" />Za va̱ ta̱li a̱yi ɗa Ozem na̱ Da̱wuda za ve cindere. <verse eid="1CH 2:15" /><verse number="16" style="v" sid="1CH 2:16" />Aza a wawa'a ele e esheli ele ɗa Zeruya na̱ Abigel. Olobo a ta'atsu a Zuriya ele ɗa: Abishai na̱ Yowab na̱ Asahe. <verse eid="1CH 2:16" /><verse number="17" style="v" sid="1CH 2:17" />Abigel ɗa mma va Amasa, za na dada va̱ yi ɗa Yeta vuma va Isma'ila.<verse eid="1CH 2:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 2:18" />Keleb ulobo wa Hezeron matsan ta̱ muwun na̱ Azuba ka va̱ yi, na̱ Yeriyo waru. Apa nda olobo a̱ yi: Yeshe na̱ Shoba na̱ Ardon. <verse eid="1CH 2:18" /><verse number="19" style="v" sid="1CH 2:19" />Ana Azuba kuwa̱i, a̱vu Keleb zuwa Efarata za na matsaan niyi Huru. <verse eid="1CH 2:19" /><verse number="20" style="v" sid="1CH 2:20" />Huru ɗa matsain Uri, Uri ɗa matsain Bezale. <verse eid="1CH 2:20" /><verse number="21" style="v" sid="1CH 2:21" />Na̱ a̱ca̱pa̱ reve Hezeron von nu usheli wa Maki dada va Giliyadu, za na u zuwai a̱yi na a'wan kupota̱li, reve u matsaan yi Segu. <verse eid="1CH 2:21" /><verse number="22" style="v" sid="1CH 2:22" />Segu ɗa matsain Jayi za na yuwain tsugbain tsi ilyuci ushin na aza a ta'atsu a̱tsuma̱ a Giliyadu. <verse eid="1CH 2:22" /><verse number="23" style="v" sid="1CH 2:23" />Amma Geshu na̱ Aram e reme ta̱ upasu wa Havot Jayi oɓolo na̱ Kena, oɓolo na̱ mulyuci n na n ri uka̱nda̱ruwu na̱ a̱yi, ele ilyuci kupota̱li. Ele nda suru limatan va Maki ɗa dada va Giliyadu. <verse eid="1CH 2:23" /><verse number="24" style="v" sid="1CH 2:24" />Ana Hezeron kuwa̱i a̱ a̱tsuma̱ a Keleb va Efarata, a̱vu Abija ka va Hezeron matsaan yi Ashu dada va Tekowa.<verse eid="1CH 2:24" /></para>
  <para style="s">Ugundo wa Yerameye ulobo wa Hezuron</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 2:25" />Olobo a Yerameye ulobo wu ufaru wa Hezeron ele ɗa:</para>
  <para style="li2" vid="1CH 2:25">Ram ulobo wu ufaru na̱ Buna na̱ Oren na̱ Ozem na̱ Ahija. <verse eid="1CH 2:25" /><verse number="26" style="v" sid="1CH 2:26" />Yerameye shi ta̱ na̱ ka ro waru za na a̱ tsu ɗe Atara, a̱yi ɗa mma va Onam.<verse eid="1CH 2:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 2:27" />Olobo a Ram ulobo wu ufaru wa Yerameye ele ɗa:</para>
  <para style="li2" vid="1CH 2:27">Ma'aza na̱ Yamin na̱ Eke.<verse eid="1CH 2:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 2:28" />Olobo a Onam ele ɗa:</para>
  <para style="li2" vid="1CH 2:28">Shamai na̱ Yada.</para>
  <para style="li1" vid="1CH 2:28">Olobo a Shamai ele ɗa:</para>
  <para style="li2" vid="1CH 2:28">Nadab na̱ Abishu.<verse eid="1CH 2:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 2:29" />Aala a ka va Abishu a̱yi ɗa Abihayil, za na matsaan niyi Ahaba na̱ Moli.<verse eid="1CH 2:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 2:30" />Olobo a Nadab ele ɗa:</para>
  <para style="li2" vid="1CH 2:30">Sele na̱ Afayim. Sele kuwa̱ ta̱ babu limatan.<verse eid="1CH 2:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 2:31" />Ulobo wa Afayim a̱yi ɗa:</para>
  <para style="li2" vid="1CH 2:31">Ishi za na matsain Sheshan.</para>
  <para style="li2" vid="1CH 2:31">Sheshan ɗa matsain Alai.<verse eid="1CH 2:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 2:32" />Olobo a Yada mawun ma̱ a̱na̱wun ma Shamai ele ɗa:</para>
  <para style="li2" vid="1CH 2:32">Yete na̱ Jonata. Amma Yeta kuwa̱ ta̱ babu limatan.<verse eid="1CH 2:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 2:33" />Olobo a Jonata ele ɗa:</para>
  <para style="li2" vid="1CH 2:33">Pele na̱ Zaza. Ele nda ele ɗa limatan va Yerameye.<verse eid="1CH 2:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 2:34" />Sheshan shi na̱ muwun mo olobo shi, she esheli goon.</para>
  <para style="li2" vid="1CH 2:34">U da̱na̱ ta̱ na aagbashi o ro za va Masar za va aala Yarha. <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" />Sheshan ca ta̱ aagbashi a̱ yi Yarha usheli wa̱ yi lolo, reve u matsaan yi Atai.<verse eid="1CH 2:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 2:36" />Atai ɗa matsain Natan,</para>
  <para style="li2" vid="1CH 2:36">a̱vu Natan matsan Zabad.<verse eid="1CH 2:36" /></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 2:37" />Zabad ɗa matsain Efala,</para>
  <para style="li2" vid="1CH 2:37">reve Efala matsan Obed.<verse eid="1CH 2:37" /></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 2:38" />Obed ɗa matsain Yehu,</para>
  <para style="li2" vid="1CH 2:38">a̱vu Yehu matsan Azariya.<verse eid="1CH 2:38" /></para>
  <para style="li2">
    <verse number="39" style="v" sid="1CH 2:39" />Azariya ɗa matsain Hele,</para>
  <para style="li2" vid="1CH 2:39">reve Hele matsan Eleyasa.<verse eid="1CH 2:39" /></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 2:40" />Eleyasa ɗa matsain Sismai,</para>
  <para style="li2" vid="1CH 2:40">reve Sismai matsan Shalum.<verse eid="1CH 2:40" /></para>
  <para style="li2">
    <verse number="41" style="v" sid="1CH 2:41" />Shalum ɗa matsain Yekamiya,</para>
  <para style="li2" vid="1CH 2:41">reve Yekamiya matsan Elishama.<verse eid="1CH 2:41" /></para>
  <para style="s">Akapi o ugundo wa Keleb</para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 2:42" />Olobo e Keleb mawun ma̱ a̱na̱wun ma Yerameye ele ɗa: Meshe ulobo wu ufaru, za na a̱yi ɗa dada va Zif. A̱vu Zif matsan Maresha, zagbain va aza a Heburon.<verse eid="1CH 2:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 2:43" />Olobo a Heburon ele ɗa:</para>
  <para style="li2" vid="1CH 2:43">Kora na̱ Tafuwa na̱ Rekem na̱ Shema. <verse eid="1CH 2:43" /><verse number="44" style="v" sid="1CH 2:44" />Shema ɗa matsain Raham, reve Raham matsan Yokmeyam, reve Rekem matsan Shamai. <verse eid="1CH 2:44" /><verse number="45" style="v" sid="1CH 2:45" />Ulobo wa Shamai Mawon ɗa, Mawon waru a̱yi ɗa u matsain Bet Zur.<verse eid="1CH 2:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 2:46" />Ka vu nge'en va Keleb, Efa a̱yi ɗa mma va Haran na̱ Moza na̱ Gaze. Reve Haran matsan Gaze.<verse eid="1CH 2:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 2:47" />Olobo a Jadai ele ɗa:</para>
  <para style="li2" vid="1CH 2:47">Regem na̱ Yotam na̱ Geshan na̱ Pele na̱ Efa na̱ Sha'af.<verse eid="1CH 2:47" /></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 2:48" />Ka vu nge'en na Keleb zuwai, Ma'aka a̱yi ɗa mma va Shebe na̱ Tirhana. <verse eid="1CH 2:48" /><verse number="49" style="v" sid="1CH 2:49" />A̱yi ɗa waru mma va Sha'af zana matsain Madamana na̱ Sheva. Sheva ɗa matsain Makabena na̱ Gibiya. Usheli wa Keleb a̱yi ɗa Akasa.<verse eid="1CH 2:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CH 2:50" />Ele nda ele ɗa limatan va Keleb:</para>
  <para style="b" vid="1CH 2:50" />
  <para style="li1" vid="1CH 2:50">Hur ɗa ulobo wu ufaru wa Efarata ka va Keleb. Olobo a̱ Huru ele ɗa:</para>
  <para style="li2" vid="1CH 2:50">Shoba ɗa zagbain va aza a Kiriyat Jeyarim <verse eid="1CH 2:50" /><verse number="51" style="v" sid="1CH 2:51" />na̱ Saluma zagbain aza a Batalami na̱ Haref zagbain va aza a Bet Geda.<verse eid="1CH 2:51" /></para>
  <para style="li1">
    <verse number="52" style="v" sid="1CH 2:52" />Ugundo wa Shoba zagbain va aza a Kiriyat Jeyarim ele ɗa:</para>
  <para style="li2" vid="1CH 2:52">Haro na akapi aza a na a̱ ri Manaha. <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" />Na̱ gundo va Kiriyat Jeyarim: aza a Itiri na aza a Put na aza a Shumati na aza a Misharaya. O gundo nda ɗa a̱za̱ a̱ Zora na aza a Eshitayola o uta̱i.<verse eid="1CH 2:53" /></para>
  <para style="li1">
    <verse number="54" style="v" sid="1CH 2:54" />Limatan va Saluma zagbain va aza a Batalami ele ɗa:</para>
  <para style="li2" vid="1CH 2:54">ama a Netofa na̱ Atorot Bet Yowab, na̱ akapi o ugundo wa Manaha, na aza a Zora. <verse eid="1CH 2:54" /><verse number="55" style="v" sid="1CH 2:55" />Gundo va̱ a̱za̱ e iɗana aza a na a̱ shi na̱ nden Jabe ele ɗa: aza a Tira na aza a Shimeyati na aza a Sukati. Ele nda ele ɗa aza a Kena a na o uta̱i diga Hama akaya o u'wa wa Rekab.<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s">Ugundo wa̱ Da̱wuda</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 3:1" />Ele nda ele ɗa olobo a̱ Da̱wuda aza a na a matsaan niyi a̱tsuma̱ Heburon. Ulobo wu ufaru a̱yi ɗa Amnon, za na mma va̱ yi ɗa Ahinowam za va Yezireyel. Za va ire a̱yi ɗa Daniya za na mma va̱ yi ɗa Abigel za va Kame. <verse eid="1CH 3:1" /><verse number="2" style="v" sid="1CH 3:2" />Za va ta'atsu a̱yi ɗa Absalom za na mma va̱ yi ɗa Ma'aka usheli wa Talmai mogono ma Geshu. Za va̱ na̱shi Adonija ulobo wa Hagit. <verse eid="1CH 3:2" /><verse number="3" style="v" sid="1CH 3:3" />Za va tawun a̱yi ɗa Shefatiya za na mma va̱ yi ɗa Abital. Za va̱ ta̱li a̱yi ɗa Itireyam za na Egila matsaan niyi. <verse eid="1CH 3:3" /><verse number="4" style="v" sid="1CH 3:4" />Muwun n ta̱li nda n ɗa a matsayin Da̱wuda a̱tsuma̱ a̱ Heburon, uba̱ta̱ u na u yuwain tsugono a'wan a cindere na̱ woto ta̱li.<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Sam 5:4-5; 1 Ngo 2:11; 1 Alb 29:27.</char></note></para>
  <para style="p" vid="1CH 3:4">Da̱wuda yuwan ta̱ tsugono tsa̱ Urishelima a'wan mata'atsu na aza a ta'atsu. <verse eid="1CH 3:4" /><verse number="5" style="v" sid="1CH 3:5" />Apa aala a muwun n na a matsan niyi ɗe Urishelima:</para>
  <para style="li2" vid="1CH 3:5">Shimeya na̱ Shoba na̱ Natan na̱ Sulemanu. Suru ma̱a̱ na̱shi me le Bashaba usheli wa Amiye ɗa matsan nle. <verse eid="1CH 3:5" /><verse number="6" style="v" sid="1CH 3:6" />U da̱na̱ ta̱ fo na̱ Ibha na̱ Elishama na̱ Elifele <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" />na̱ Noga na̱ Nefe na̱ Yafiya <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" />na̱ Elishama na̱ Eliyada na̱ Elifele ele ɗa ama kucci goon. <verse eid="1CH 3:8" /><verse number="9" style="v" sid="1CH 3:9" />Suru nle ndolo ele ɗa olobo Da̱wuda, agba babu pe olobo muwun ma̱ a̱ma̱ci a̱ nge'en ma̱ yi. Tamar ɗa da̱na̱i zawa'a le vu usheli.<verse eid="1CH 3:9" /></para>
  <para style="s">Ngono ma Yahuda</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 3:10" />Ugundo wa Sulemanu ɗa</para>
  <para style="li1" vid="1CH 3:10">Rehobowam</para>
  <para style="li2" vid="1CH 3:10">na̱ Abija na̱ Asa na̱ Jehoshafa <verse eid="1CH 3:10" /><verse number="11" style="v" sid="1CH 3:11" />na̱ Joram na̱ Ahaziya na̱ Yowash <verse eid="1CH 3:11" /><verse number="12" style="v" sid="1CH 3:12" />na̱ Amaziya na̱ Azariya na̱ Yotam <verse eid="1CH 3:12" /><verse number="13" style="v" sid="1CH 3:13" />na̱ Ahaz na̱ Hezekiya na̱ Manase <verse eid="1CH 3:13" /><verse number="14" style="v" sid="1CH 3:14" />na̱ Amon na̱ Josiya.<verse eid="1CH 3:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 3:15" />Olobo Josiya ele ɗa:</para>
  <para style="li2" vid="1CH 3:15">Ulobo wu ufaru wa̱ a̱yi ɗa Yohanan,</para>
  <para style="li2" vid="1CH 3:15">za va ire Yehoyakim,</para>
  <para style="li2" vid="1CH 3:15">za va ta'atsu Zedekiya,</para>
  <para style="li2" vid="1CH 3:15">za va̱ na̱shi Shalum.<verse eid="1CH 3:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 3:16" />Olobo a̱ Yehoyakim ele ɗa:</para>
  <para style="li2" vid="1CH 3:16">Yekoniya na̱ Zedekiya.<verse eid="1CH 3:16" /></para>
  <para style="s">Ngono diga o ugundo wa Jekoniya</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 3:17" />Mpa nda limatan vo olobo a̱ Yekoniya za na e remei a̱ tyo uba̱ta̱ u tsugbashi,</para>
  <para style="li2" vid="1CH 3:17">Sheyatiye <verse eid="1CH 3:17" /><verse number="18" style="v" sid="1CH 3:18" />na̱ Malkiram na̱ Pedaya na̱ Shenaza na̱ Yekamiya na̱ Hoshama na̱ Nedabiya.<verse eid="1CH 3:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 3:19" />Olobo a Pedaya ɗa:</para>
  <para style="li2" vid="1CH 3:19">Zerubabe na̱ Shimai.</para>
  <para style="li1" vid="1CH 3:19">Olobo a Zerubabe ɗa:</para>
  <para style="li2" vid="1CH 3:19">Meshulam na̱ Hananiya.</para>
  <para style="li2" vid="1CH 3:19">Shelomi ɗa da̱na̱i mawun ma̱ a̱na̱wun me le mo usheli.<verse eid="1CH 3:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 3:20" />U da̱na̱ ta̱ lo fo no olobo o tawun o ro,</para>
  <para style="li2" vid="1CH 3:20">Hashuba na̱ Ohel na̱ Berekiya na̱ Hasadiya na̱ Yushab Hese.<verse eid="1CH 3:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 3:21" />Olobo a Hananiya ɗa:</para>
  <para style="li2" vid="1CH 3:21">Pelatiya na̱ Yeshaya. Yeshaya ɗa matsain Refaya, a̱vu Refaya matsan Arnan, a̱vu Arnan matsan Obadiya. Obadiya matsan ta̱ Shekaniya.<verse eid="1CH 3:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 3:22" />Limatan va Shekaniya ɗa:</para>
  <para style="li2" vid="1CH 3:22">Shemaya no olobo a̱ yi, aza a na ele ɗa:</para>
  <para style="li2" vid="1CH 3:22">Hatush na̱ Iga na̱ Bariya na̱ Neyariya na̱ shafat suru nle a̱za̱ a̱ ta̱li ɗa.<verse eid="1CH 3:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 3:23" />Olobo a Neyariya ɗa:</para>
  <para style="li2" vid="1CH 3:23">Eliyoyenai na̱ Hezekiya na̱ Azirikam suru nle ama a ta'atsu ɗa.<verse eid="1CH 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 3:24" />Olobo Eliyoyenai ɗa:</para>
  <para style="li2" vid="1CH 3:24">Hodaviya na̱ Eliyashi na̱ Pelaya na̱ Aku na̱ Yohanan na̱ Delaya na̱ Anani ele ɗa a ama a cindere suru suru.<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s">Ugundo wa Yahuda</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 4:1" />Ugundo wa Yahuda ele ɗa:</para>
  <para style="li2" vid="1CH 4:1">Pere na̱ Hezeron na̱ Karmi na̱ Huru na̱ Shoba.<verse eid="1CH 4:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 4:2" />Reyaya ulobo wa Shoba a̱yi ɗa u matsain Yaha, a̱vu Yaha matsan Ahuma na̱ Laha. Ele ɗa ugundo wa Zora.<verse eid="1CH 4:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 4:3" />Ele nda ele ɗa olobo a Etam:</para>
  <para style="li2" vid="1CH 4:3">Yezireyel na̱ Ishma na̱ Idba.</para>
  <para style="li2" vid="1CH 4:3">Mawun ma a̱na̱wun mo usheli ma̱ le a̱yi ɗa Hazelefoni.<verse eid="1CH 4:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 4:4" />Penuwe ɗa matsain Gedo</para>
  <para style="li1" vid="1CH 4:4">na̱ Eze waru za na matsain Husha.</para>
  <para style="li1" vid="1CH 4:4">Ele nda ele ɗa ugundo wa Huru, ulobo wu ufaru wa Efarata za na matsain Batalami.<verse eid="1CH 4:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 4:5" />Ashu dada va Tekowa u da̱na̱ ta̱ na̱ a̱ma̱ci e re, ala ele ɗa: Hela na̱ Na'ara.<verse eid="1CH 4:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 4:6" />Na'ara ɗa matsaan niyi Ahuzam na̱ Hefe na̱ Temeni na̱ Ha'ashatari. Ele nda ele ɗa olobo a Na'ara.<verse eid="1CH 4:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 4:7" />Olobo a Hela ele ɗa:</para>
  <para style="li2" vid="1CH 4:7">Zere na̱ Zoha na̱ Izha na̱ Etna <verse eid="1CH 4:7" /><verse number="8" style="v" sid="1CH 4:8" />na̱ Koz. Koz ɗa matsain Anub na̱ Zobeba nu ugundo wa Ahahel ulobo wa Harum.<verse eid="1CH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9" />A casu ta̱ Jabe tsugbain tsa na tsa la'ai a̱za̱ a̱ yi. Mma va̱ yi ɗe yi ta̱ na̱ ala Jabe,<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">Na̱ Tsuyahuda cine a̱ tsu ɗe aala a nda, a tsu uwwai ta̱ she damma ɗewu va̱ &lt;&lt;a̱tsuma̱lima̱&gt;&gt;.</char></note> adansa &lt;&lt;M matsan yi ta̱ na̱ a̱tsuma̱lima̱ lon.&gt;&gt; <verse eid="1CH 4:9" /><verse number="10" style="v" sid="1CH 4:10" />Jabe showen ta̱ A̱sula̱ a Isra'ila a dansa, &lt;&lt;Zuwaa mu aba'un a̱vu vu da̱shi pasu vi iɗa i va̱ a̱bunda̱! Lyawa ukere wa̱ wu u da̱na̱ aaci a̱ va̱, vu kasa mu ni iwuya i na ya̱ ta̱wa̱ adama n da̱na̱ babu a̱tsuma̱lima̱.&gt;&gt; Reve A̱sula̱ a̱ usu i pati ya̱ yi.<verse eid="1CH 4:10" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="11" style="v" sid="1CH 4:11" />Kelub mawun ma̱ a̱na̱wun ma Shuha ma ɗa ma matsain Mehi, waru Mehi ɗa matsain Eshto. <verse eid="1CH 4:11" /><verse number="12" style="v" sid="1CH 4:12" />Eshto ɗa matsain Bet Rafa na̱ Paseya na̱ Tehina waru Tehina ɗa matsain Ir Nahas. Ele nda ɗa ama a Reka.<verse eid="1CH 4:12" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="13" style="v" sid="1CH 4:13" />Olobo a Kena ele ɗa:</para>
  <para style="li2" vid="1CH 4:13">Otiniye na̱ Seraya.</para>
  <para style="li1" vid="1CH 4:13">Olobo a Otiniye ele ɗa:</para>
  <para style="li2" vid="1CH 4:13">Hata na̱ Meyonota. <verse eid="1CH 4:13" /><verse number="14" style="v" sid="1CH 4:14" />Meyonota ɗa matsain Ofura.</para>
  <para style="li1" vid="1CH 4:14">Seraya ɗa matsain Yowab, dada va Ge Harashi. E ɗe ta̱ aala o uba̱ta̱'a̱ ne adama a na ama'a a zo o ulinga wa̱ e ekere ɗa.<verse eid="1CH 4:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 4:15" />Olobo a Keleb ulobo wa Jefune ele ɗa:</para>
  <para style="li2" vid="1CH 4:15">Iru na̱ Ela na̱ Na'am.</para>
  <para style="li1" vid="1CH 4:15">Ulobo wa Ela a̱yi ɗa Kena.<verse eid="1CH 4:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 4:16" />Olobo a Yehalele ele ɗa:</para>
  <para style="li2" vid="1CH 4:16">Zif na̱ Zifa na̱ Tiriya na̱ Asare.<verse eid="1CH 4:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 4:17" />Olobo a Ezura ele ɗa:</para>
  <para style="li2" vid="1CH 4:17">Yeta na̱ Mere na̱ Efe na̱ Yalon. Mere zuwa ta̱ Bitiya usheli wa mogono Firi'awuna va Masar, waru u matsaan yi ta̱ Maryamu na̱ Shamai na̱ Ishaba. Ishaba ɗa dada va Eshitemo. <verse eid="1CH 4:17" /><verse number="18" style="v" sid="1CH 4:18" />Mere zuwisa ta̱ ka diga Yahuda. Waru u matsaan yi ta̱ Yere dada va Gedo na̱ Hebe dada va Soko na̱ Yekutiyel dada va Zanowa.<verse eid="1CH 4:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 4:19" />Olobo a ka va Hodiya, mawun ma a̱na̱wun mo usheli ma Naha ele ɗa:</para>
  <para style="li2" vid="1CH 4:19">Dada va aza a Kayila za va Garim na̱ Eshitemo za va Ma'aka.<verse eid="1CH 4:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 4:20" />Olobo a Shimon ele ɗa:</para>
  <para style="li2" vid="1CH 4:20">Amnon na̱ Rina na̱ Ben Hanan na̱ Tilon.</para>
  <para style="li1" vid="1CH 4:20">Ugundo wa Ishi ele ɗa:</para>
  <para style="li2" vid="1CH 4:20">Zohe na̱ Ben Zohe.<verse eid="1CH 4:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 4:21" />Olobo a Shela ulobo wa Yahuda ele ɗa:</para>
  <para style="li2" vid="1CH 4:21">Er dada va Leka na̱ La'ada dada va Maresha nu ugundo wa̱ ozo o ulinga wa okoro a̱ lyuci va Bet Ashibeya, <verse eid="1CH 4:21" /><verse number="22" style="v" sid="1CH 4:22" />na̱ Yokim na̱ ama a Kozeba na̱ Yowash na̱ Sara, aza a na yuwain tsugono tsa̱ Mowa na̱ Yabushi Lehem. Alabari a nda a̱ tsura̱ yi ta̱ diga uba̱ta̱ a nkaya. <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />Ele a̱za̱ o uma'an a ɗa, a na a̱ da̱na̱i nden Netalim na̱ Gedera, a̱ da̱nu ta̱ ɗe a yuwusaan mogono ulinga.<verse eid="1CH 4:23" /></para>
  <para style="s">Ugundo wa Saminu</para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 4:24" />Ugundo wa Saminu ele ɗa:</para>
  <para style="li2" vid="1CH 4:24">Nemuwe na̱ Yamin na̱ Yari na̱ Zera na̱ Shawulu.<verse eid="1CH 4:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 4:25" />Shawul ɗa matsain Shalum. A̱vu Shalum matsan Mibisam. A̱vu fo Mibisam matsan Mishima.<verse eid="1CH 4:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 4:26" />Limatan va Mishima ele ɗa:</para>
  <para style="li2" vid="1CH 4:26">Hamuwe na̱ Zaku ulobo wa̱ yi na̱ Shimai ulobo wa Zaku.<verse eid="1CH 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27" />Shimai da̱na̱ ta̱ na̱ olobo kupa na̱ a̱za̱ a̱ ta̱li, na̱ muwun me esheli n ta̱li. Agba muwun ma̱ a̱na̱wun ma̱ yi a̱ ri na̱ muwun a̱bunda̱ tsa yi shi, waru ugundo u le u yuwan a̱bunda̱ tsa ama a Yahuda shi. <verse eid="1CH 4:27" /><verse number="28" style="v" sid="1CH 4:28" />A̱vu a̱ da̱nu e iɗa ya Biyasheba na̱ Molada na̱ Haza Shuwa<note caller="+" style="f"><char style="fr" closed="false">4:28-33 </char><char style="ft" closed="false">Ka̱lyuwa̱: Jos 19:2-8. </char></note> <verse eid="1CH 4:28" /><verse number="29" style="v" sid="1CH 4:29" />na̱ Biliha na̱ Ezem na̱ Tola <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" />na̱ Betuwe na̱ Homa na̱ Ziklag <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" />na̱ Bet Makabo na̱ Haza susi na̱ Bet Biri na̱ waru Sha'arayim. Ilyuci i le i ɗa i da̱na̱i hali a cina mantsa ma tsugono tsa Da̱wuda. <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />Waru mulyuci n na n da̱na̱i uka̱nda̱ruwu na̱ le ele ɗa: Etam na̱ Ayin na̱ Rimon na̱ Token na̱ Ashan, ele ɗa mulyuci n ton suru suru. <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />A̱ da̱na̱ ta̱ waru na̱ mulyuci n ro n na i da̱na̱i uka̱nda̱ruwu le hali a̱ tyo a̱ lyuci va Ba'al. Uba̱ta̱ wu nden le n ɗa. Agba a zuwa ta̱ ucuɗuwu wi iɗana vu gundo le.<verse eid="1CH 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 4:34" />Ugundo suru u da̱na̱ ta̱ na̱ zagbain, waru ele ɗa: Meshoba na̱ Yamle na̱ Yosha ulobo wa Amaziya <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" />na̱ Juwe na̱ Yehu ulobo wa Yoshibiya na̱ ulobo wa Seraya na̱ ulobo wa Asiyel <verse eid="1CH 4:35" /><verse number="36" style="v" sid="1CH 4:36" />waru na̱ Eliyonai na̱ Ya'akoba na̱ Yeshohaya na̱ Asaya na̱ Adiyel na̱ Yesimiyel na̱ Benaya <verse eid="1CH 4:36" /><verse number="37" style="v" sid="1CH 4:37" />na̱ Ziza ulobo wa Shifi na̱ ulobo wa Alon na̱ ulobo wa Jedeya na̱ ulobo wa Shimri na̱ ulobo wa Shemaya.<verse eid="1CH 4:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 4:38" />Suru ama a nda a na a ɗanai ala e le, azagbain o gundo le ɗa. Limatan le da̱shishi ta̱ a̱bunda̱ lon. <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />A̱vu a yuwan agara hali a̱ tyo zuzu na̱ lyuci va Gedo, za na ri asana o uka̱ri na a zamishi uba̱ta̱ wa aguɓa adama e iliyamunga i le. <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />Ɗe ɗa a̱ tsura̱i uba̱ta̱ wa aguɓa o ulobonu, iɗa i sa'ani, waru iɗa'a u da̱na̱ ta̱ mgbain, uba̱ta̱ u ɗa kpen, na̱ nden ma a lafiya. Ɗe nu ufaru uba̱ta̱ wu nden wa aza a Ham ɗa.<verse eid="1CH 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41" />Ama a na a ɗanai ala e le, ele ɗa a̱ da̱na̱i a mantsa mo tsugono tsa Hezekiya Mogono ma̱ Yahuda. A̱vu o kototo ogodo e le a̱vu aza a Manuti a na a̱ da̱na̱i pe, a̱vu fo a tawa le adama o ukototosu hali a cina cine u ri ana'an,<note caller="+" style="f"><char style="fr" closed="false">4:41 </char><char style="ft" closed="false">Hali acina ana'an: U ta rocosu hali acina mantsa ma na a ɗanai Aatagada Alabari o Ufaru. </char></note> a̱vu a̱ da̱nu pe a̱tsuma̱ e iɗa'a, adama a na u ri nu uba̱ta̱ wa aguɓa adama e iliyamunga i le. <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" />Ozo o ro a̱tsuma̱ e le, ama ukpakuton (500) a na a̱ ri diga o ugundo wa Saminu, a̱vu a̱ ka̱ra̱ a̱ tyo agaɗi a Seyi adama a yuwan uvon. Aza a na o rono n le aɗanga ele ɗa: olobo a̱ Ishi, Pelatiya na̱ Neyariya na̱ Refaya na̱ Uzi. <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" />A̱vu o una akapi Amaleka aza a na a̱ shi a la'ai, reve a̱ da̱nu pe hali acina a na'an.<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s">Roben</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 5:1" />Roben ɗa mawun mo ufaru ma Isra'ila, amma a mantsa ma na uvon yi a̱a̱ga̱da̱ na̱ ka va Dada va̱ a̱ yi a na u zuwai, a̱vu u lamba agadu a̱yi a̱ nden n mawun mo ufaru a̱vu a ca Isuhu mawun ma Isra'ila, adama o ndolo e kecei a̱tsuma̱ a̱ muwun mo o ufaru shi,<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">Ka̱lyuwa̱: Ufr 35:22; 49:3-4.</char></note> <verse eid="1CH 5:1" /><verse number="2" style="v" sid="1CH 5:2" />Ko na wo o'woi Yahuda la'a ta̱ a̱za̱ yi ucira suru, agba za na a yuwan tsugono tsu uta̱ ta̱ diga ya̱'a̱ yi, suru na̱ ne agadu a mawun mo ufaru ma̱ da̱na̱ ta̱ za va Isuhu.<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">Ka̱lyuwa̱: Ufr 49:8-10.</char></note><verse eid="1CH 5:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 5:3" />Olobo a̱ Roben ulobo wu ufaru wa Isra'ila ele ɗa:</para>
  <para style="li2" vid="1CH 5:3">Hano na̱ Palu na̱ Hezeron na̱ Karmi.<verse eid="1CH 5:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 5:4" />Olobo a̱ Juwe ele ɗa:</para>
  <para style="li2" vid="1CH 5:4">Shemaya na̱ Gog na̱ Shimai <verse eid="1CH 5:4" /><verse number="5" style="v" sid="1CH 5:5" />na̱ Mika na̱ Reyaya na̱ Ba'al <verse eid="1CH 5:5" /><verse number="6" style="v" sid="1CH 5:6" />na̱ Bera za na mogono Tiglat Filesa ma Asuriya ma tarai a̱ tyo tsugbashi. Bera zagbain ɗa da̱na̱i a̱tsuma̱ o ugundo wa̱ a̱za̱ a̱ Roben.<verse eid="1CH 5:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 5:7" />Mpa nda ala a mmaci le nu gundo le, na̱ limatan le a mantsa me le.</para>
  <para style="li2" vid="1CH 5:7">Yeyiyel ɗa da̱na̱i zagbain, waru a̱ da̱na̱ ta̱ fo na̱ Zakariya <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" />na̱ Bela ulobo wa Aza na̱ Shema ulobo wa Juwe. A̱ da̱nu ta̱ upasu wa Arowa a̱ tyo Nebo na̱ Ba'al Meyo. <verse eid="1CH 5:8" /><verse number="9" style="v" sid="1CH 5:9" />U da̱nu ta̱ upasu wa asana acina ukosu wa̱ a̱tsumona za na da̱na̱i upasu wu Uɗolu wi iɗa ya Yufiriti, adama a na iliyamunga i le i da̱shishi ta̱ a̱bunda̱ a̱tsuma̱ Giliyadu. <verse eid="1CH 5:9" /><verse number="10" style="v" sid="1CH 5:10" />A mantsa mo mogono Shawulu a̱za̱ a̱ Roben a yuwan ta̱ uvon na aza a Hagara, a̱vu o kototo le, a̱vu a̱ da̱nu pe a̱tsuma̱ e iɗa i le acina suru nda̱na̱ta̱ ma asana wa aza a Giliyadu.<verse eid="1CH 5:10" /></para>
  <para style="s">Ugundo wa Gadu</para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 5:11" />Ugundo wa Gadu a̱ da̱nu ta̱ upasu wu ugana wa̱ a̱za̱ a̱ Roben a̱tsuma̱ e iɗa ya Bashan, hali acina Saleka.<verse eid="1CH 5:11" /></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 5:12" />Juwe ɗa da̱na̱i zagbain na̱ Shafam za va ire na̱ Yanai na̱ Shafa a̱tsuma̱ a Bashan.<verse eid="1CH 5:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 5:13" />Mmaci n le na̱ limatan le ɗa: Mika na̱ Meshulam na̱ Sheba na̱ Yorai na̱ Yakan na̱ Ziya na̱ Eba ele ɗa aza a cindere goon.<verse eid="1CH 5:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 5:14" />Ele nda e le ɗa Olobo Abihayi ulobo wa Huri ulobo wa Yarowa ulobo wa̱ Giliyadu ulobo wa Mika ulobo wa̱ Yeshishai ulobo wa Yado za na a̱yi ɗa ulobo wa̱ Buz.<verse eid="1CH 5:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 5:15" />Ahi ulobo wa Abidiye, mawun ma tsukaya ma Guni za na da̱na̱i zagbain vu gundo le.<verse eid="1CH 5:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 5:16" />Aza a Gadu a̱ da̱nu ta̱ Giliyadu a̱tsuma̱ o upasu wa Bashan na̱ mulyuci n na n ri uka̱nda̱ruwu ne ele, na̱ suru iɗa ya aguɓa ya Sharon hali acina ukosu wa̱ yi.<verse eid="1CH 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 5:17" />A ɗana ta̱ suru ili i ndolo a̱tsuma̱ a adanshi o ucuwusan a mantsa mo tsugono tsa̱ Yotam mogono ma Yahuda na̱ mogono Yerobowam ma Isra'ila.<verse eid="1CH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18" />Ugundo u nan Roben, na aza a Gadu, nu uɓatsulai wu ugundo wa Manase a̱ da̱na̱ ta̱ na̱ a̱soja ukpaku kupa amunga na̱ a̱za̱ a̱ na̱shi nu ukpakucindere na̱ kupota̱li (44,760) aza a na a̱ da̱na̱i ufoɓu adama o uvon, ali a ɗa a na a̱ da̱na̱i nu ucira lon, aza a na a gura ɓana a̱ra̱ga̱ na̱ matsun me pe'eni, aza a na a gura waru a yuwan ulinga ni ibata, aza a na a gurai uvon lon. <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />A̱vu a yuwan uvon na̱ Hagara na̱ Yetu na̱ Nafi na̱ Noda. <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />A zuwa ta̱ ucira u le uba̱ta̱ wa̱ A̱sula̱ reve a yuwan avasa uba̱ta̱ wa̱ yi adama u kamba le, a̱vu A̱sula̱ a uwwa avasa e le a̱vu u ca le ulyuwu wa aci e ekere a aza a Hagara na aza a na a̱ ri oɓolo ne ele suru. <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />A̱ pura̱ ta̱ iliyamunga ya Hagara arakumi ukpakukupa uton (50,000) ni ikyon ukpakukupa ure na̱ kupa uton (250,000) na̱ nloli ukpaku ure (2,000). A̱vu a̱ pura̱ ama ukpakukupa ukpaku (100,000) a̱ tyo tsugbashi. <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />Ama na̱ a̱bunda̱ a̱ kuwa̱ ta̱ adama a na uvo'on za va̱ A̱sula̱ ɗa. A̱vu a̱ da̱nu pe a̱tsuma̱ e iɗa i le acina mantsa ma na a̱ pura̱ nle a̱ tyo tsugbashi.<verse eid="1CH 5:22" /></para>
  <para style="s">Uɓatsulai wu ugundo wa Manase</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />Uɓatsulai wu ugundo wa Manase wa asana a̱ da̱na̱ ta̱ a̱bunda̱ lon. A̱ da̱nu ta̱ a̱tsuma̱ e iɗa ya Bashan a̱ tyo Ba'al Hamon, hali a̱ tyo Seni masasan ma Hamon. <verse eid="1CH 5:23" /><verse number="24" style="v" sid="1CH 5:24" />Mpa nda a ala a zagbain vu mmaci n le: Efe na̱ Ishi na̱ Eliyel na̱ Aziriye na̱ Irimiya na̱ Hodaviya na̱ Yadiyel. Aza a na a gurai uvon lon ɗa, a̱soja a na e revei ɗa azagbain a 'wa le. <verse eid="1CH 5:24" /><verse number="25" style="v" sid="1CH 5:25" />Amma a̱vu a yuwan ulambu wa̱ a̱ɓula̱ a̱ tyo uba̱ta̱ wa̱ A̱sula̱ a nkaya n le, a̱vu e reme tsushakala uba̱ta̱ u musula̱ wa ama e iɗa'a, aza a na A̱sula̱ o kototo yi elime e le. <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />A̱vu A̱sula̱ a Isra'ila a zuwa mogono Pul va Asuriya Tiglat Filesa, u tara a̱za̱ a̱ Roben na̱ Gadu nu uɓatsulai wu ugundo wa Manase wa asana a̱ tyo tsugbashi. Reve u tara le a̱ tyo a̱ lyuci va Hala na̱ Habo na̱ Hara nu Uɗolu wa Goza, uba̱ta̱ u na a̱ ri acina ana'an nda.<verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s">Ugundo u nan Ganu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 6:1" />Olobo a̱ Levi ele ɗa:</para>
  <para style="li2" vid="1CH 6:1">Gashon na̱ Koha na̱ Merari.<verse eid="1CH 6:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 6:2" />Olobo a Koha ele ɗa:</para>
  <para style="li2" vid="1CH 6:2">Amuram na̱ Izaha na̱ Heburon na̱ Uziye.<verse eid="1CH 6:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 6:3" />Olobo a Amuram ele ɗa:</para>
  <para style="li2" vid="1CH 6:3">Haruna na̱ Musa na̱ Maryamu.</para>
  <para style="li1" vid="1CH 6:3">Olobo a Haruna ele ɗa:</para>
  <para style="li2" vid="1CH 6:3">Nadab na̱ Abihu na̱ Eliyaza na̱ Itama.<verse eid="1CH 6:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 6:4" />Eliyaza ɗa matsain Finiha,</para>
  <para style="li2" vid="1CH 6:4">reve Finiha matsan Abishuwa.<verse eid="1CH 6:4" /></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 6:5" />Abishuwa ɗa matsain Buki,</para>
  <para style="li2" vid="1CH 6:5">reve Buki matsan Uzi.<verse eid="1CH 6:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 6:6" />Uzi ɗa matsain Zerahiya,</para>
  <para style="li2" vid="1CH 6:6">reve Zerahiya matsan Merayo.<verse eid="1CH 6:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 6:7" />Merayo ɗa matsain Amariya,</para>
  <para style="li2" vid="1CH 6:7">reve Amariya matsan Ahitu.<verse eid="1CH 6:7" /></para>
  <para style="li2">
    <verse number="8" style="v" sid="1CH 6:8" />Ahitu ɗa matsain Saduku,</para>
  <para style="li2" vid="1CH 6:8">reve Saduku matsan Ahima'az.<verse eid="1CH 6:8" /></para>
  <para style="li2">
    <verse number="9" style="v" sid="1CH 6:9" />Ahima'az ɗa matsain Azariya,</para>
  <para style="li2" vid="1CH 6:9">reve Azariya matsan Yohanan.<verse eid="1CH 6:9" /></para>
  <para style="li2">
    <verse number="10" style="v" sid="1CH 6:10" />Yohanan ɗa matsain Azariya. Reve Azariya yuwan ulinga u tsuganu a̱tsuma̱ A̱a̱'isamapaɗa a na Sulemanu suwai a̱tsuma̱ a̱ Urishelima.<verse eid="1CH 6:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 6:11" />Azariya ɗa matsain Amariya,</para>
  <para style="li2" vid="1CH 6:11">reve Amariya matsan Ahitu.<verse eid="1CH 6:11" /></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 6:12" />Ahitu ɗa matsain Saduku,</para>
  <para style="li2" vid="1CH 6:12">reve Saduku matsan Shalum.<verse eid="1CH 6:12" /></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 6:13" />Shalum ɗa matsain Hilikiya,</para>
  <para style="li2" vid="1CH 6:13">reve Hilikiya matsan Azariya.<verse eid="1CH 6:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 6:14" />Azariya ɗa matsain Seraya,</para>
  <para style="li2" vid="1CH 6:14">reve Seraya matsan Jehozada.<verse eid="1CH 6:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 6:15" />E reme ta̱ Jehozada a̱ 'ya̱wa̱ tsugbashi a mantsa ma na A̱sulazuva a zuwai aza a Yahuda na̱ Urishelima a̱ 'ya̱wa̱ tsugbashi nu ukere wa̱ Nebukanaza.<verse eid="1CH 6:15" /></para>
  <para style="s">Ugundo u nan Levi</para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 6:16" />Olobo a̱ Levi ele ɗa,</para>
  <para style="li2" vid="1CH 6:16">Gashon na̱ Koha na̱ Merari.<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">Ka̱lyuwa̱: Mta̱ 6:16-19.</char></note><verse eid="1CH 6:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 6:17" />Apa ala o olobo a Gashon,</para>
  <para style="li2" vid="1CH 6:17">Libini na̱ Shimeyi.<verse eid="1CH 6:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 6:18" />Olobo a Koha ele ɗa:</para>
  <para style="li2" vid="1CH 6:18">Amuram na̱ Izaha na̱ Heburon na̱ Uziye.<verse eid="1CH 6:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 6:19" />Olobo a Merari ele ɗa:</para>
  <para style="li2" vid="1CH 6:19">Mali na̱ Mushi.</para>
  <para style="li1" vid="1CH 6:19">Apa nda ala o gundo a nan Levi ugere o una̱ wu nkaya n le:<verse eid="1CH 6:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 6:20" />Olobo a Gashon ele ɗa:</para>
  <para style="li2" vid="1CH 6:20">Libini na̱ Yaha na̱ Zima<verse eid="1CH 6:20" /></para>
  <para style="li2">
    <verse number="21" style="v" sid="1CH 6:21" />na̱ Yowa na̱ Ido na̱ Zera na̱ Yewaterai.<verse eid="1CH 6:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 6:22" />Olobo a̱ Koha ele ɗa:</para>
  <para style="li2" vid="1CH 6:22">Aminada na̱ Kora na̱ Asir<verse eid="1CH 6:22" /></para>
  <para style="li2">
    <verse number="23" style="v" sid="1CH 6:23" />na̱ Elikana na̱ Ebiyasa na̱ Asir<verse eid="1CH 6:23" /></para>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 6:24" />na̱ Taha na̱ Uriyel na̱ Uziya na̱ Shawulu.<verse eid="1CH 6:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 6:25" />Olobo a Elikana ele ɗa:</para>
  <para style="li2" vid="1CH 6:25">Amasai na̱ Ahimo.<verse eid="1CH 6:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 6:26" />Olobo a Ahimo ele ɗa:</para>
  <para style="li2" vid="1CH 6:26">Elikana na̱ Zofai na̱ Naha<verse eid="1CH 6:26" /></para>
  <para style="li2">
    <verse number="27" style="v" sid="1CH 6:27" />na̱ Eliyabu na̱ Yeroham na̱ Elikana.<verse eid="1CH 6:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 6:28" />Olobo a Sama'ila ele ɗa:</para>
  <para style="li2" vid="1CH 6:28">Juwe<note caller="+" style="f"><char style="fr" closed="false">6:28 </char><char style="ft" closed="false">Urevu wa aala Juwe: Na̱ Tsuyahuda a̱ yi babu idanshi i ro pa nda.</char></note> mawun mo ufaru na̱ Abija mawun me ire.<verse eid="1CH 6:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 6:29" />Olobo a Merari ele ɗa:</para>
  <para style="li2" vid="1CH 6:29">Mali na̱ Libni na̱ Shimai na̱ Uza.<verse eid="1CH 6:29" /></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 6:30" />Na̱ Shimeya na̱ Hagiya na̱ Asaya.<verse eid="1CH 6:30" /></para>
  <para style="s">Ashipi a̱ A̱a̱'isamapaɗa</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />Ele nda ele ɗa aza a na Da̱wuda zuwai azagbain e ishipa o u'wa wa̱ A̱sulazuva cina a̱ ta̱wa̱a̱ na Akpati a̱ A̱sulazuva u da̱na̱ lo. <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />A̱ da̱na̱ ta̱ a yuwusan ulinga wi ishipa a̱ ma̱ka̱ka̱n mo oogodo a agalaci vo Oogodo o Uga'asusan acina mantsa ma na Sulemanu suwai A̱a̱'isamapaɗa A̱sulazuva a̱tsuma̱ a̱ Urishelima, a̱vu a yuwan ulinga u le cine a zuwai.<verse eid="1CH 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 6:33" />Apa ala a ama a na a yuwain a̱ga̱nda̱ oɓolo no olobo e le.</para>
  <para style="li1" vid="1CH 6:33">Umatsun wa a̱za̱ a̱ Koha ele ɗa:</para>
  <para style="li2" vid="1CH 6:33">Heman za vi ishipa nu ulobo wa̱ Juwe na̱ ulobo wa Sama'ila.<verse eid="1CH 6:33" /></para>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 6:34" />Sama'ila ulobo wa Elikana ulobo wa Yeroham</para>
  <para style="li2" vid="1CH 6:34">ulobo wa Eliyel ulobo wa̱ Towa <verse eid="1CH 6:34" /><verse number="35" style="v" sid="1CH 6:35" />ulobo wa Zuf</para>
  <para style="li2" vid="1CH 6:35">ulobo wa Elikana ulobo wa Maha ulobo wa Amasai<verse eid="1CH 6:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 6:36" />ulobo wa Elikana ulobo wa̱ Juwe ulobo wa Azariya</para>
  <para style="li2" vid="1CH 6:36">ulobo wa Zafaniya <verse eid="1CH 6:36" /><verse number="37" style="v" sid="1CH 6:37" />ulobo wa Taha, ulobo wa Asir</para>
  <para style="li2" vid="1CH 6:37">ulobo wa Ebiyasa ulobo wa̱ Kora <verse eid="1CH 6:37" /><verse number="38" style="v" sid="1CH 6:38" />ulobo wa Izaha</para>
  <para style="li2" vid="1CH 6:38">ulobo wa̱ Koha nu ulobo wa̱ Levi ulobo wa Isra'ila.<verse eid="1CH 6:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 6:39" />Oɓolo na̱ Asaf imaci ya Heman, za na yuwusain a̱ga̱nda̱ o ukere u sa'ani wa̱ yi.</para>
  <para style="li2" vid="1CH 6:39">Asaf ulobo wa Berekiya ɗa ulobo wa Shimeya<verse eid="1CH 6:39" /></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 6:40" />ulobo wa Mika'ilu ulobo wa Ba'aseya ulobo wa Malkiya<verse eid="1CH 6:40" /></para>
  <para style="li2">
    <verse number="41" style="v" sid="1CH 6:41" />ulobo wa Etini ulobo wa Zera ulobo wa Adaya<verse eid="1CH 6:41" /></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 6:42" />ulobo wa Etan ulobo wa Zima ulobo wa Shimai<verse eid="1CH 6:42" /></para>
  <para style="li2">
    <verse number="43" style="v" sid="1CH 6:43" />ulobo wa Yaha ulobo wa Gashon ulobo wa̱ Levi.<verse eid="1CH 6:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 6:44" />Waru a̱za̱ e le o umatsun wa Merari a na a̱ da̱na̱i o ukere wu ugula̱ ele ɗa:</para>
  <para style="li1" vid="1CH 6:44">Etan ulobo wa̱ Kishi ulobo wa Abidi ulobo wa Maluk<verse eid="1CH 6:44" /></para>
  <para style="li2">
    <verse number="45" style="v" sid="1CH 6:45" />ulobo wa Hashabiya ulobo wa Amaziya ulobo wa Hilikiya<verse eid="1CH 6:45" /></para>
  <para style="li2">
    <verse number="46" style="v" sid="1CH 6:46" />ulobo wa Amzi ulobo wa Bani ulobo wa Sheme,<verse eid="1CH 6:46" /></para>
  <para style="li2">
    <verse number="47" style="v" sid="1CH 6:47" />ulobo wa Mali ulobo wa Mushi ulobo wa Merari ulobo wa̱ Levi.<verse eid="1CH 6:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48" />Akapi a̱ a̱za̱ e le a nan Levi a zuwa le ta̱ ulinga wa akapi o ulinga u na u buwai suru wo oogodo a agalaci, o u'wa̱ wa̱ A̱sula̱.<verse eid="1CH 6:48" /></para>
  <para style="s">Limatan va Haruna</para>
  <para style="p">
    <verse number="49" style="v" sid="1CH 6:49" />Amma Haruna no olobo a̱ yi ele ɗa aza a na a casuyi kucci a masa'a ma̱ kucci vu ukula̱tosu oɓolo na a masa'a ma̱ a̱tsuka̱ a ma̱guru uɓolu ni ili i na suru a yuwusain a̱tsuma̱ o Upasu u na u La'ai Akiza. A yuwusaan ta̱ aza a Isra'ila kucci matara mo ume mo unusu cine Musa aagbashi a̱ A̱sula̱ a zuwai a yuwan.<verse eid="1CH 6:49" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="50" style="v" sid="1CH 6:50" />Apa aala olobo a Haruna:</para>
  <para style="li2" vid="1CH 6:50">Eliyaza na̱ Finiha na̱ Abishuwa<verse eid="1CH 6:50" /></para>
  <para style="li2">
    <verse number="51" style="v" sid="1CH 6:51" />na̱ Buki na̱ Uzi na̱ Zerahiya<verse eid="1CH 6:51" /></para>
  <para style="li2">
    <verse number="52" style="v" sid="1CH 6:52" />na̱ Merayo na̱ Amariya na̱ Ahitu<verse eid="1CH 6:52" /></para>
  <para style="li2">
    <verse number="53" style="v" sid="1CH 6:53" />na̱ Saduku na̱ Ahima'az.<verse eid="1CH 6:53" /></para>
  <para style="s">Iɗa i nan Levi</para>
  <para style="p">
    <verse number="54" style="v" sid="1CH 6:54" />Apa uba̱ta̱ u na a ca nle wu nden n le, a̱tsuma̱ a pasu le, a na a cayi olobo a Haruna o ugundo wa̱ Koha u ɗa, adama a na akunda o ufaru za le ɗa a zuwai agita.<verse eid="1CH 6:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="1CH 6:55" />A ca le ta̱ Heburon a̱tsuma̱ e iɗa ya Yahuda nu uba̱ta̱ wa alyuna u na u ri uka̱nda̱ruwu na̱ yi. <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" />Amma atsusa na̱ mulyuci n na n ri uka̱nda̱ruwu a ca ta̱ Keleb ulobo wa Jefune.<verse eid="1CH 6:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="1CH 6:57" />Adama o ndolo a ca ta̱ umatsun wa Haruna Heburon, ilyuci mapa'an na̱ Libina na̱ Yati na̱ Eshitemowa <verse eid="1CH 6:57" /><verse number="58" style="v" sid="1CH 6:58" />na̱ Hilen na̱ Debi <verse eid="1CH 6:58" /><verse number="59" style="v" sid="1CH 6:59" />na̱ Ashan na̱ Bet Shemesh oɓolo nu uba̱ta̱ wa alyuna u le.<verse eid="1CH 6:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="1CH 6:60" />Diga o ugundo wa Banyami a ca le ta̱ Gibiyon na̱ Geba na̱ Aleme na̱ Anato oɓolo nu uba̱ta̱ wa alyuna u le. Ilyuci i nda i na e ne'eshein ugundo wa̱ Koha ele ɗa a̱ shi kupa na aza a ta'atsu suru suru.<verse eid="1CH 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="1CH 6:61" />Akapi o olobo a̱ Koha a ca le ta̱ ilyuci kupa na̱ mazuwa ma agita diga a akapi o umatsun wu ugundo wa Manase.<verse eid="1CH 6:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="1CH 6:62" />A ca ta̱ limatan va Gashon umatsun umatsun ilyuci kupa na aza a ta'atsu, o ugundo wa Isaka na̱ Asha na̱ Nafutali nu upasu u na diga o ugundo wa Manase a̱tsuma̱ a Bashan.<verse eid="1CH 6:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="1CH 6:63" />Waru olobo a Merari umatsun umatsun, a ca le ta̱ ilyuci kupa ne ejere na̱ mazuwa ma agita diga oo ugundo wa̱ Roben na̱ Gadu na̱ Zebulun.<verse eid="1CH 6:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="1CH 6:64" />Ne ɗa aza a Isra'ila a cayi nan Levi ilyuci i nda na̱ ba̱ta̱ va alyuna nle. <verse eid="1CH 6:64" /><verse number="65" style="v" sid="1CH 6:65" />Diga a̱tsuma̱ o ugundo wa Yahuda na̱ Saminu na̱ za va Banyami a ca ta̱ ilyuci i na e kecei'i na̱ mazuwa ma agita.<verse eid="1CH 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="1CH 6:66" />A̱tsuma̱ o umatsun wa̱ Koha a ca le ta̱ upasu u le diga a̱tsuma̱ e ilyuci yu ugundo wa Ifiramu.<verse eid="1CH 6:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="1CH 6:67" />A̱tsuma̱ e iɗa ya agaɗi ya Ifiramu a ca le ta̱ ilyuci ya Shekem na̱ Geza ni ilyuci i mapa'an <verse eid="1CH 6:67" /><verse number="68" style="v" sid="1CH 6:68" />na̱ Yokimeyam na̱ Bet Horon <verse eid="1CH 6:68" /><verse number="69" style="v" sid="1CH 6:69" />na̱ Ajalon na̱ Gat Rimon oɓolo na̱ ba̱ta̱ va alyuna le.<verse eid="1CH 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="1CH 6:70" />A̱tsuma̱ a akapi o ugundo wa Manase aza a Isra'ila a ca ta̱ akapi o umatsun wa̱ a̱za̱ a̱ Koha, Ane na̱ Bileyam oɓolo nu uba̱ta̱ wa alyuna u le. <verse eid="1CH 6:70" /><verse number="71" style="v" sid="1CH 6:71" />Aza a Gashon a̱ ushi ta̱ ili i nda: Diga o uɓatsulai wu ugundo wa Manase a̱ ushi ta̱ Golan a̱tsuma̱ a Bashan oɓolo na̱ Ashitaro oɓolo nu uba̱ta̱ wa alyuna u le. <verse eid="1CH 6:71" /><verse number="72" style="v" sid="1CH 6:72" />Diga o ugundo wa Isaka a̱ ushi ta̱ Kedesh na̱ Dabera <verse eid="1CH 6:72" /><verse number="73" style="v" sid="1CH 6:73" />na̱ Ramo na̱ Anem oɓolo nu uba̱ta̱ wa alyuna u le suru.<verse eid="1CH 6:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="1CH 6:74" />Diga a̱tsuma̱ o ugundo wa Asha a̱ ushi ta̱ Masha oɓolo na̱ Abadon <verse eid="1CH 6:74" /><verse number="75" style="v" sid="1CH 6:75" />na̱ Huko na̱ Reho, oɓolo nu uba̱ta̱ wa alyuna wa alyuna u le.<verse eid="1CH 6:75" /></para>
  <para style="p">
    <verse number="76" style="v" sid="1CH 6:76" />Diga a̱tsuma̱ o ugundo wa Nafutali a ca le ta̱ Kedesh a̱tsuma̱ a̱ Ga̱lili na̱ Hamon na̱ Kiriyatayim oɓolo nu uba̱ta̱ wa alyuna u le suru.<verse eid="1CH 6:76" /></para>
  <para style="b" />
  <para style="p">
    <verse number="77" style="v" sid="1CH 6:77" />Adama akapi aza a Merari a tawa le ta̱ na̱ mazuwa ma agita diga o ugundo wa̱ Zebulun: Rimo na̱ Tabo oɓolo nu uba̱ta̱ wa alyuna u le. <verse eid="1CH 6:77" /><verse number="78" style="v" sid="1CH 6:78" />Diga a̱tsuma̱ o ugundo wa̱ Roben, mavada mo Uɗolu wa̱ Urudu asana a̱ Jeriko, a̱ ushi ta̱ Beza a̱tsumona na̱ Yaza <verse eid="1CH 6:78" /><verse number="79" style="v" sid="1CH 6:79" />na̱ Kedemo na̱ Mefa'a oɓolo nu uba̱ta̱ wa alyuna u le. <verse eid="1CH 6:79" /><verse number="80" style="v" sid="1CH 6:80" />Diga a̱tsuma̱ o ugundo wa Gadu a ca le ta̱ Ramot a̱tsuma̱ a Giliyadu na̱ Mahanayim <verse eid="1CH 6:80" /><verse number="81" style="v" sid="1CH 6:81" />na̱ Heshibon na̱ Jaza oɓolo nu uba̱ta̱ wa alyuna u le.<verse eid="1CH 6:81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 7:1" />Isaka da̱na̱ ta̱ na̱ olobo a̱ na̱shi ele ɗa:</para>
  <para style="li2" vid="1CH 7:1">Tola na̱ Fuwa na̱ Jashu na̱ Shimiron.<verse eid="1CH 7:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 7:2" />Olobo a̱ Tola ele ɗa:</para>
  <para style="li2" vid="1CH 7:2">Uzi na̱ Refaya na̱ Yeriyel na̱ Yamai na̱ Ibsam na̱ Sama'ila. Suru nle azagbain a 'wa va Tola ɗa a̱ shi. Oɓolo na̱ a̱soja a na a̱ shi a gurai uvon. A mantsa mo tsugono tsa̱ Da̱wuda limatan va̱ Tola na e kecei ali o uvon o ugeru wu nkaya n le a rawa ta̱ ama ukpakukupa ushin ne ejere nu ukpaku uta̱li (22,600).<verse eid="1CH 7:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 7:3" />Ulobo wa̱ Uzi a̱yi ɗa:</para>
  <para style="li2" vid="1CH 7:3">Izirahiya.</para>
  <para style="li1" vid="1CH 7:3">Olobo a Izirahiya ele ɗa:</para>
  <para style="li2" vid="1CH 7:3">Mika'ilu na̱ Obadiya na̱ Juwe na̱ Ishiya. Matawun me ele suru azagbain a ama a ɗa a̱ shi. <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />O ugeru wu 'wa vu nkaya n le, a̱ shi ta̱ na ali o uvon ukpakukupa mata'atsu nu ukpakukupa uta̱li (36,000) a na a̱ shi ufoɓu adama o uvon, adama a na a̱ shi ta̱ na̱ a̱ma̱ci na̱ muwun ma̱ a̱bunda̱.<verse eid="1CH 7:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 7:5" />Mmaci n na n shi a̱za̱ o uvon aza a na a̱ shi a̱za̱ o ugundo wa Isaka suru, cine e gere nle a nkaya n le, a̱ shi ta̱ ama ukpakukupa kupakunla̱ nu ukpakukupa ucindere (87,000) suru suru.<verse eid="1CH 7:5" /></para>
  <para style="s">Ugundo wa Banyami</para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 7:6" />Olobo a ta'atsu a Banyami ele ɗa:</para>
  <para style="li2" vid="1CH 7:6">Bela na̱ Beka na̱ Yediyayel.<verse eid="1CH 7:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 7:7" />Olobo a Bela ele ɗa:</para>
  <para style="li2" vid="1CH 7:7">Ezbon na̱ Uzi na̱ Uziyel na̱ Yerimo na̱ Iri. Matawun me le suru azagbain a 'wa vu nkaya n le ɗa, aza a na a gurai uvon. Ele ɗa a̱ shi ama ukpakukupa ushin nu ukpakukupa ure na̱ mata'atsu na̱ a̱za̱ a̱ na̱shi (22,034).<verse eid="1CH 7:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 7:8" />Olobo a Beka ele ɗa:</para>
  <para style="li2" vid="1CH 7:8">Zemira na̱ Yowash na̱ Eliyaza na̱ Eliyonai na̱ Omri na̱ Yeremo na̱ Abija na̱ Anato oɓolo na̱ Aleme. Suru nle olobo a Beka ɗa a̱ shi. <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />E kece le ta̱ o ugeru wa azagbain vu 'wa vu nkaya n le ali o uvon a na a rawai ukpakukupa ushin nu ukpaku ure (20, 200).<verse eid="1CH 7:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 7:10" />Ulobo wa Yediyayel a̱yi ɗa:</para>
  <para style="li2" vid="1CH 7:10">Bilhan.</para>
  <para style="li1" vid="1CH 7:10">Olobo a Bilhan gba ele ɗa:</para>
  <para style="li2" vid="1CH 7:10">Yewush na̱ Banyami na̱ Ehud na̱ Kena'ana na̱ Zetan na̱ Tarshishi na̱ Ahishaha. <verse eid="1CH 7:10" /><verse number="11" style="v" sid="1CH 7:11" />Olobo a Yediyayel a nda suru azagbain a 'wa vu nkaya n le n ɗa a̱ shi. Waru a̱da̱na̱ ta̱ na ali o uvon ufoɓu u na a̱a̱ 'ya̱wa̱ uvon a na a rawai ukpakukupa kupa nu ukpakukupa ucindere nu ukpaku ure (17,200).<verse eid="1CH 7:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 7:12" />Shufim na̱ Hufim olobo a Ir ɗa. Waru Hushim ulobo wa Ahe ɗa.<verse eid="1CH 7:12" /></para>
  <para style="s">Ugundo wa Nafutali</para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 7:13" />Olobo a Nafutali ele ɗa:</para>
  <para style="li2" vid="1CH 7:13">Yahziyel na̱ Guni na̱ Yeza na̱ Shalum, suru nle ugundo wa Biliha ka va Yakubu ɗa.<verse eid="1CH 7:13" /></para>
  <para style="s">Ugundo wa Manase</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 7:14" />Umatsun wa Manase ele ɗa:</para>
  <para style="li2" vid="1CH 7:14">Asiriyel umatsun wa̱ yi u ɗa na ka vu nge'en va̱ yi za na za va Suriya matsaan niyi. A̱yi ɗa u matsain Maki dada va Giliyadu. <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" />Maki zamiya ta̱ Hufim na̱ Shufim a̱ma̱ci adama a zuwa. Maki ta̱ na̱ zawa'a vu ka va aala Ma'aka.</para>
  <para style="li2" vid="1CH 7:15">Waru a̱ da̱na̱ ta̱ na̱ za ro diga a̱tsuma̱ a mmaci ma̱ yi za va aala Zelofeha za na shi na̱ muwun me esheli goon.<verse eid="1CH 7:15" /></para>
  <para style="li2">
    <verse number="16" style="v" sid="1CH 7:16" />Ka va Maki, Ma'aka matsan ta̱ ulobo reve u ca yi aala Peresh. Aala a zawa'a va̱ yi ɗa Sheresh. Ala o olobo a na Peresh matsain ele ɗa, Ulam na̱ Rakem.<verse eid="1CH 7:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 7:17" />Ulobo wa Ulam a̱yi ɗa:</para>
  <para style="li2" vid="1CH 7:17">Bedan.</para>
  <para style="li1" vid="1CH 7:17">Ele nda ele ɗa a̱ shi olobo a Giliyadu ulobo wa Maki ulobo wa Manase. <verse eid="1CH 7:17" /><verse number="18" style="v" sid="1CH 7:18" />Hamoleke mawun ma̱ a̱na̱wun ma̱ yi mo usheli ɗa matsain Ishiho na̱ Abiyeza na̱ Mala.<verse eid="1CH 7:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 7:19" />Olobo a Shemida ele ɗa:</para>
  <para style="li2" vid="1CH 7:19">Ahiyan na̱ Shekem na̱ Liki na̱ Aniyam.<verse eid="1CH 7:19" /></para>
  <para style="s">Ugundo wa Ifiramu</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 7:20" />Olobo a Ifiramu ele ɗa:</para>
  <para style="li2" vid="1CH 7:20">Shutela na̱ Bere na̱ Taha</para>
  <para style="li2" vid="1CH 7:20">na̱ Eliyada na̱ Taha<verse eid="1CH 7:20" /></para>
  <para style="li2">
    <verse number="21" style="v" sid="1CH 7:21" />na̱ Zabad na̱ Shutela.</para>
  <para style="li2" vid="1CH 7:21">Olobo a Ifiramu a za aala Eze na̱ Elad aza a na aza a Gat umatsun wi iɗa'a o unai, a mantsa ma na a̱ 'ya̱wa̱i adama e iva̱ iliyamunga i le. <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />A̱vu dada le Ifiramu yuwan nden n wiruta̱ vu rana va̱ a̱bunda̱ adama e le. Reve a̱za̱ a̱ yi a̱ ta̱wa̱ adama a ca yi adanshi. <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />Reve u vowison na̱ ka va̱ yi, a̱vu u reme a̱tsuma̱ u matsan ulobo. Reve u ca yi aala Beriya,<note caller="+" style="f"><char style="fr" closed="false">7:23 </char><char style="ft" closed="false">Urevu wa aala Beriya: Na̱ Tsuyahuda cine a̱ tsu ɗe aala'a, a tsu uwwai ta̱ she damma &lt;&lt;addama&gt;&gt;.</char></note> adama a na u'wa wa̱ yi u ga'an ta̱ na addama. <verse eid="1CH 7:23" /><verse number="24" style="v" sid="1CH 7:24" />Aala o usheli wa̱ yi ɗa Sheyera, za na suwai Za̱la̱ na̱ Bet Horon vo Gon oɓolo na̱ Uzen Sheyera waru.<verse eid="1CH 7:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 7:25" />Ifiramu da̱na̱ ta̱ nu ulobo u ro u na a̱ tsu ɗe Refa. Olobo Refa ele ɗa:</para>
  <para style="li2" vid="1CH 7:25">Reshef na̱ Tela na̱ Tahan,<verse eid="1CH 7:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 7:26" />na̱ Ladan na̱ Amihu na̱ Elishama<verse eid="1CH 7:26" /></para>
  <para style="li2">
    <verse number="27" style="v" sid="1CH 7:27" />na̱ Nun na̱ Josuwa.<verse eid="1CH 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 7:28" />Iɗa i le nu uba̱ta̱ wu nden n le u ɓolo ta̱ na̱ Betel na̱ mulyuci n na n ri uka̱nda̱ruwu na̱ a̱yi, na̱ Naran wu upasu wa asana na̱ Geza na̱ mulyuci ma̱ yi wu upasu wa̱ a̱livu oɓolo na̱ Shekem na̱ mulyuci ma̱ yi suru hali a rawa Aya na̱ mulyuci ma̱ yi.<verse eid="1CH 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 7:29" />Zuzu na̱ a̱tyo a Manase ilyuci ya Bet Shan na̱ Ta'ana na̱ Megido na̱ Dor oɓolo na̱ mulyuci n le n da̱na̱ ta̱ lo. Ugundo wa̱ Isuhu ulobo wa Isra'ila u ɗa a̱ da̱na̱i nden e ilyuci i nda.<verse eid="1CH 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 7:30" />Olobo a Asha ele ɗa:</para>
  <para style="li2" vid="1CH 7:30">Imna na̱ Ishva na̱ Ishvi na̱ Beriya. Sera ɗa da̱na̱i mawun ma̱ a̱na̱wun me le mo usheli.<verse eid="1CH 7:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 7:31" />Olobo a Beriya ele ɗa:</para>
  <para style="li2" vid="1CH 7:31">Heba na̱ Malikiye za na a̱yi ɗa dada va Birzayi.<verse eid="1CH 7:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 7:32" />Heba ɗa matsain Yafile na̱ Shoma na̱ Hotam na̱ Shuwa mawun ma̱ a̱na̱wun ma̱ le mo usheli.<verse eid="1CH 7:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 7:33" />Olobo a Yafile ele ɗa:</para>
  <para style="li2" vid="1CH 7:33">Pasak na̱ Bimha na̱ Ashiva.<verse eid="1CH 7:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 7:34" />Olobo a Sheme ele ɗa:</para>
  <para style="li2" vid="1CH 7:34">Ahi na̱ Roga na̱ Yehuba na̱ Aram.<verse eid="1CH 7:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 7:35" />Olobo a Helem mawun ma̱ a̱na̱wun ma̱ yi ele ɗa:</para>
  <para style="li2" vid="1CH 7:35">Zofa na̱ Imna na̱ Shelesh na̱ Ama.<verse eid="1CH 7:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 7:36" />Olobo a Zofa ele ɗa:</para>
  <para style="li2" vid="1CH 7:36">Suwa na̱ Hanefa na̱ Shuwa na̱ Beri na̱ Imra <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" />na̱ Beza na̱ Hod na̱ Shama na̱ Shilsha na̱ Itira oɓolo na̱ Beyera.<verse eid="1CH 7:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 7:38" />Olobo a Yeta ele ɗa: Yefune na̱ Pispa na̱ Ara.<verse eid="1CH 7:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 7:39" />Olobo o Ula ele ɗa:</para>
  <para style="li2" vid="1CH 7:39">Ara na̱ Haniyel na̱ Riziya.<verse eid="1CH 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CH 7:40" />Suru nle nda ugundo wa Asha u ɗa. Azagbain a 'wa vu nkaya nle aza a na a ɗangulai, aza a na a gurai uvon waru azagbain a na o uta̱i ala. A̱bunda̱ a ama a na a̱ ri ufoɓu adama o uvon, cine e gere nle a nkaya n le a̱ shi ta̱ ama ukpakukupa ushin nu ukpakukupa uta̱li (26,000).<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s">Ugundo wa Banyami</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 8:1" />Olobo a Banyami ele ɗa:</para>
  <para style="li2" vid="1CH 8:1">Bela ulobo wu ufaru wa̱ yi na̱ Ashebel ulobo u ire na̱ Ahara ulobo wa ta'atsu,<verse eid="1CH 8:1" /></para>
  <para style="li2">
    <verse number="2" style="v" sid="1CH 8:2" />na̱ Noha za va̱ na̱shi na̱ Rafa za va tawun.<verse eid="1CH 8:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 8:3" />Olobo a Bela ele ɗa:</para>
  <para style="li2" vid="1CH 8:3">Ada na̱ Gera na̱ Abihu <verse eid="1CH 8:3" /><verse number="4" style="v" sid="1CH 8:4" />na̱ Abishuwa na̱ Na'ama na̱ Ahowa <verse eid="1CH 8:4" /><verse number="5" style="v" sid="1CH 8:5" />na̱ Gera na̱ Shefufan na̱ Huram.<verse eid="1CH 8:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 8:6" />Ele nda ele ɗa olobo Ehud, aza a na a̱ shi azagbain a 'wa vu nkaya nle aza a na a̱ shi na̱ nden a Geba. Waru ele ɗa a̱ shi a̱ pura̱i a̱ tyo tsugbashi a̱tsuma̱ a Manaha, ele ɗa:<verse eid="1CH 8:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 8:7" />Na'ama na̱ Ahiya na̱ Gera. Gera ɗa shi da̱na̱i zagbain le a mantsa ma na a̱ pura̱ n le. A̱yi ɗa waru u shi dada va Uza na̱ Ahihu.<verse eid="1CH 8:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 8:8" />A matsaan ta̱ Shaharayim olobo a̱tsuma̱ a̱ Mowa cina wu kasa na̱ a̱ma̱ci a̱ yi Hushim na̱ Ba'ara. <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />Hodesh ka va̱ yi matsaan yi ta̱ Yoba na̱ Zibiya na̱ Mesha na̱ Malkam <verse eid="1CH 8:9" /><verse number="10" style="v" sid="1CH 8:10" />na̱ Yewu na̱ Sakiya na̱ Mirma. Ele ɗa olobo a̱ yi azagbain a 'wa vu nkaya nle.<verse eid="1CH 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 8:11" />Hushim ka va̱ yi waru matsaan yi ta̱ olobo, Abitu na̱ Elpa'al.<verse eid="1CH 8:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 8:12" />Olobo a Elpa'al ele ɗa:</para>
  <para style="li2" vid="1CH 8:12">Ebe na̱ Misham na̱ Sheme. Sheme ɗa za na suwai ilyuci ya̱ Ono na̱ Lod oɓolo na̱ mulyuci n na n ri uka̱nda̱ruwu ne ele. <verse eid="1CH 8:12" /><verse number="13" style="v" sid="1CH 8:13" />Waru a̱ da̱na̱ ta̱ na̱ Beriya na̱ Shema, aza a na a̱ shi azagbain a 'wa vu nkaya n le a aza a na a̱ ri nden a̱tsuma̱ a Ajalon, waru ele ɗa aza a na a̱ gba̱ra̱i aza a na a̱ shi nden Gat.<verse eid="1CH 8:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 8:14" />Olobo Beriya ele ɗa:</para>
  <para style="li2" vid="1CH 8:14">Ahiyo na̱ Shashak na̱ Yeremo <verse eid="1CH 8:14" /><verse number="15" style="v" sid="1CH 8:15" />na̱ Zebadiya na̱ Arad na̱ Ede, <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" />Mika'ilu na̱ Ishipa na̱ Yoha ele ɗa olobo a̱ Beriya.<verse eid="1CH 8:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 8:17" />Olobo a Elpa'al ele ɗa:</para>
  <para style="li1" vid="1CH 8:17">Zebadiya na̱ Meshulam na̱ Hizki na̱ Heba <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" />na̱ Ishimerai na̱ Iziliya na̱ Yoba ele ɗa olobo a Elipa'al.<verse eid="1CH 8:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 8:19" />Olobo a Shimai ele ɗa:</para>
  <para style="li2" vid="1CH 8:19">Yakim na̱ Zikiri na̱ Zabdi <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" />na̱ Eliyenai na̱ Ziletai na̱ Eliyel <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" />na̱ Adaya na̱ Beraya na̱ Shimai.<verse eid="1CH 8:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 8:22" />Olobo a Shashak ele ɗa:</para>
  <para style="li2" vid="1CH 8:22">Ishfan na̱ Ebe na̱ Eliyel <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" />na̱ Abadon na̱ Zikiri na̱ Hanan <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" />na̱ Hananiya na̱ Elam na̱ Antotiya <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" />na̱ Ifideya na̱ Penuwe.<verse eid="1CH 8:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 8:26" />Olobo a Jeroham ele ɗa:</para>
  <para style="li2" vid="1CH 8:26">Shamsherai na̱ Shehariya na̱ Ataliya <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" />na̱ Ya'areshiya na̱ Iliya na̱ Zikiri.<verse eid="1CH 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 8:28" />Ele nda suru azagbain a 'wa vu nkaya n le a ɗa cine e gere n le, a̱ shi ta̱ nden Urishelima.<verse eid="1CH 8:28" /></para>
  <para style="b" />
  <para style="p">
    <verse number="29" style="v" sid="1CH 8:29" />Jeye dada va Gibiyon da̱nu ta̱ Gibiyon.</para>
  <para style="li2" vid="1CH 8:29">Aala a ka va̱ yi ɗa Ma'aka. <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />Aala a mawun mo ufaru ma̱ yi mo ulobo a̱ yi ɗa Abadon reve Zur kuru na̱ Kish na̱ Ba'al na̱ Ner na̱ Nadab <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" />na̱ Gedo na̱ Ahiyo na̱ Zeker <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" />na̱ Mikalo za na matsain Shimeya. Ele fo a̱ da̱nu ta̱ zuzu na̱ mmaci n le a̱tsuma̱ a̱ Urishelima.<verse eid="1CH 8:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 8:33" />Ner ɗa matsain Kish, reve Kish matsan Shawulu, Shawulu ɗa matsain Jonata na̱ Malkishuwa na̱ Abinada na̱ Eshba'al.<verse eid="1CH 8:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 8:34" />Ulobo wa̱ Jonata a̱yi ɗa: Meriba'al,<note caller="+" style="f"><char style="fr" closed="false">8:34 </char><char style="ft" closed="false">Urevu wa aala Meriba'al: Waru e revei ta̱ na aala waru Mefiboshe.</char></note> za na a̱yi ɗa dada va Mika.<verse eid="1CH 8:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 8:35" />Olobo a Mika ele ɗa:</para>
  <para style="li2" vid="1CH 8:35">Piton na̱ Mele na̱ Tareya na̱ Aha.<verse eid="1CH 8:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 8:36" />Aha ɗa matsain Yehoyada, reve Jehoyada matsan Aleme na̱ Azimawe na̱ Zimri, reve Zimri matsan Moza. <verse eid="1CH 8:36" /><verse number="37" style="v" sid="1CH 8:37" />Moza ɗa matsain Bineya, reve Bineya matsan Rafa, reve Rafa matsan Eleyasa, Eleyasa ɗa matsain Aze.<verse eid="1CH 8:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 8:38" />Aze matsan ta̱ olobo a̱ ta̱li. Apa nda ala e le:</para>
  <para style="li2" vid="1CH 8:38">Azirikam na̱ Bokeru na̱ Isma'ila na̱ Sheyariya na̱ Obadiya na̱ Hanan.<verse eid="1CH 8:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 8:39" />Olobo a Eshe mawun ma̱ a̱na̱wun ma̱ yi ele ɗa:</para>
  <para style="li2" vid="1CH 8:39">Ulam ulobo wu ufaru wa̱ yi na̱ Yewush za ve ire na̱ Elifele za va ta'atsu. <verse eid="1CH 8:39" /><verse number="40" style="v" sid="1CH 8:40" />Olobo a Ulam a̱ shi ta̱ a gura uvon lon, aza a na a gurai utan lon. A̱ shi ta̱ no olobo a̱bunda̱ na̱ muwun n tsukaya kpara, ama ukpaku na̱ kupoton (150) suru suru.</para>
  <para style="li1" vid="1CH 8:40">Suru nle olobo o ugundo wa Banyami a ɗa.<verse eid="1CH 8:40" /></para>
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />E kece ta̱ aza a Isra'ila suru o ugeru wu nkaya n le uɗanu a̱tsuma̱ a aatagada o ngono ma Isra'ila.</para>
  <para style="s" vid="1CH 9:1">Ama a na a̱ ka̱mba̱i Urishelima</para>
  <para style="p" vid="1CH 9:1">A̱ pura̱ ta̱ ama a Yahuda a̱ tyo Babila adama o ulambu wa̱ a̱ɓula̱ e le e ekere a̱ A̱sulazuva. <verse eid="1CH 9:1" /><verse number="2" style="v" sid="1CH 9:2" />Ama a na a fara da̱nuwisa̱i e iɗa i le a̱tsuma̱ e ilyuci i le ele ɗa aza a Isra'ila o ro, na̱ nan ganu na̱ nan Levi na aagbashi a̱ A̱a̱'isamapaɗa.<note caller="-" style="x"><char style="xo" closed="false">9:2-3 </char><char style="xt" closed="false"><ref loc="EZR 2:27">Ezr 2:27</ref>; <ref loc="NEH 7:73">Neh 7:73</ref>. </char></note><verse eid="1CH 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 9:3" />A̱ da̱na̱ ta̱ na ama o ro diga o ugundo wa Yahuda na̱ diga Banyami na̱ diga Ifiramu na̱ Manase aza a na a̱ da̱nuyi a̱tsuma̱ a̱ Urishelima. Ele ɗa:<verse eid="1CH 9:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 9:4" />Utai ulobo wa Amihud ulobo wa Omri ulobo wa Imri ulobo wa Bani umatsun wa Pere ulobo wa Yahuda.<verse eid="1CH 9:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 9:5" />Na aza a Shilo ele ɗa:</para>
  <para style="li2" vid="1CH 9:5">Asaya mawun mo ufaru oɓolo na̱ olobo a̱ yi.<verse eid="1CH 9:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 9:6" />Olobo Zera ele ɗa:</para>
  <para style="li1" vid="1CH 9:6">Yewuye oɓolo ni mmaci ya̱ yi, a̱bunda̱ e le a ɗa ama ukpaku uta̱li na̱ kupa kuci (690).<verse eid="1CH 9:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 9:7" />Olobo a Banyami ele ɗa:</para>
  <para style="li2" vid="1CH 9:7">Salu ulobo wa Meshulam ulobo wa Hodaviya ulobo wa Hasenuwa<verse eid="1CH 9:7" /></para>
  <para style="li2">
    <verse number="8" style="v" sid="1CH 9:8" />na̱ Ibneya ulobo wa Yeroham. Ela ulobo wa̱ Uzi ulobo wa Mikri na̱ Meshulam ulobo wa Shefatiya ulobo wa Reyuwe ulobo wa Ibniya.<verse eid="1CH 9:8" /></para>
  <para style="li2">
    <verse number="9" style="v" sid="1CH 9:9" />Na ama diga Banyami, e kece le ta̱ na̱ n nkaya n le ukpakukupa kuci na̱ kupoton na̱ a̱za̱ ta̱li (956). Suru ama nda azagbain vu 'wa vu nkaya n le ɗa.<verse eid="1CH 9:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 9:10" />A̱tsuma̱ a nan ganu a̱ da̱na̱ ta̱ na̱,</para>
  <para style="li2" vid="1CH 9:10">Yedaya na̱ Yehoyari na̱ Yakin<verse eid="1CH 9:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 9:11" />na̱ Azariya ulobo wa Hilikiya ulobo wa Meshulam ulobo wa Zadok ulobo wa Merayo ulobo wa Ahitu za na da̱na̱ zagbain a̱tsuma̱ a̱za̱ a̱ga̱nda̱ o u'wa wa̱ A̱sula̱.<verse eid="1CH 9:11" /></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 9:12" />Oɓolo na̱ Adaya ulobo wa Yeroham ulobo wa Pashu ulobo wa Malkiya</para>
  <para style="li2" vid="1CH 9:12">na̱ Ma'asai ulobo wa Adiyel ulobo wa Yazera ulobo wa Meshulam ulobo wa Meshilemi ulobo wa Ima.<verse eid="1CH 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 9:13" />Nan ganu a na a̱ da̱na̱i azagbain a 'wa vu nkaya n le a̱bunda̱ e le a ɗa a̱ shi ama ukpakukupa nu ukpaku ucindere na̱ kupota̱li (1,760). Ama a ɗa a na a̱ shi a gurai ulinga wa̱ a̱ga̱nda̱ a̱tsuma̱ o u'wa wa̱ A̱sula̱.<verse eid="1CH 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 9:14" />Nan Levi a na a̱ ka̱mba̱i ele ɗa: Shemaya ulobo wa Hashub ulobo wa Azirikam ulobo wa Hashabiya vuma va Merari. <verse eid="1CH 9:14" /><verse number="15" style="v" sid="1CH 9:15" />Oɓolo na̱ Bakbaka na̱ Heresh na̱ Gala na̱ Mataniya ulobo wa Mika ulobo wa Zikiri ulobo wa Asaf <verse eid="1CH 9:15" /><verse number="16" style="v" sid="1CH 9:16" />na̱ Obadiya ulobo wa Shemaya ulobo wa Gala ulobo wa Yedutun oɓolo na̱ Berekiya ulobo wa Asaf ulobo wa Elikana aza a na a̱ shi da̱nuyi a̱ mulyuci ma aza a Netofa.<verse eid="1CH 9:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 9:17" />A̱za̱ e ipiri yu una̱ntsu ele ɗa:</para>
  <para style="li2" vid="1CH 9:17">Shalum na̱ Akub na̱ Talmon na̱ Ahima oɓolo na̱ a̱za̱ e le, Shalum ɗa shi zagbain le. <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />Ele ɗa aza a na e isawusain o Una̱ntsu u Mogono na asana, hali a̱ tyo ana'an. Waru ele ɗa a̱ shi a̱za̱ e ipiri yu una̱ntsu wu uva̱la̱ta̱ u nan Levi. <verse eid="1CH 9:18" /><verse number="19" style="v" sid="1CH 9:19" />Shalum ulobo wa Kore ulobo wa Ebiyasa ulobo wa Kora oɓolo na̱ a̱za̱ a̱ yi a̱za̱ e ipiri yu una̱ntsu diga a̱tsuma̱ a̱za̱ a̱ Kora, ele ɗa a̱ shi a̱za̱ e ipiri yu una̱ntsu yu u'uwata wo oogodo, cine nkaya n le n yuwusain ipiri yu u'uwata wu nda̱na̱ta̱ ma̱ A̱sulazuva. <verse eid="1CH 9:19" /><verse number="20" style="v" sid="1CH 9:20" />Ɗe nu ufaru Finiha ulobo wa Eliyaza a̱ yi ɗa u shi zagbain va̱ a̱za̱ e ipiri yu una̱ntsu, waru A̱sulazuva gba a̱ shi ta̱ oɓolo na̱ a̱yi. <verse eid="1CH 9:20" /><verse number="21" style="v" sid="1CH 9:21" />Zakariya ulobo wa Meshelemiya a̱yi ɗa u shi za vi ipiri yu una̱ntsu wu u'uwata a̱ tyo o Oogodo o Uga'asusan.<verse eid="1CH 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 9:22" />Suru suru, aza a na a ɗangulai a̱ da̱na̱ a yuwusan ipiri yu na̱ntsu, ele ɗa a̱ shi ama ukpaku ure na̱ kupa ne ejere (212). A ɗana le ta̱ o ugeru wu nkaya u mulyuci n le. Da̱wuda na̱ Sama'ila za yindi ɗa zuwa nle ulinga u le u na a zuwaa nle ucira. <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />Ele na̱ limatan le ɗa a̱ da̱na̱i a̱za̱ e ipiri yu una̱ntsu wu u'wa wa̱ A̱sulazuva za na a̱yi ɗa oogodo. <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />A̱za̱ e ipiri a tsu isawan ta̱ pasu na̱shi va asana na̱ a̱livu nu ugana nu upasu wu uyagi. <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />A̱za̱ e le a na a̱ shi a̱ mulyuci a̱ tsu ta̱wusa̱ ta̱ mantsa mantsa a yuwan ulinga wi ipiri u le ayin e cindere, reve ozo o ro a kita'wan le. <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" />Amma azagbain a̱ na̱shi e ipiri yu una̱ntsu aza a na nan Levi a ɗa, ele ɗa a̱ shi a zuwayi ucira wu ulinga wa asula ni izuwa a̱tsuma̱ o u'wa wa̱ A̱sula̱. <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />A̱ shi ta̱ a tsa asa mishin uka̱nda̱ruwu nu u'wa wa̱ A̱sula̱ adama a na ele ɗa a̱ ri e piri. Waru ele ɗa a̱ shi na̱ kpa̱tu'utsu vu ukpa̱tu'usa̱ wa̱ yi usana biti.<verse eid="1CH 9:27" /></para>
  <para style="s">Akapi a nan Levi</para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28" />A̱tsuma̱ e le ozo o ro a̱ shi ta̱ e idanasa itana yu ulinga a̱tsuma̱ a̱ A̱a̱'isamapaɗa. A̱ tsu kece le ta̱ na̱ a̱ ta̱wa̱ ne ele pe, na̱ mantsa ma na waru o uta̱a̱ nle. <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />Ozo ro waru a zuwa le ta̱ e idanasa itana ni itana yu ulinga ya̱ a̱a̱'isa̱ suru oɓolo na̱ yira na̱ masayan na̱ mani'in ni ili i ma̱guru i furenkisen ni itana yu ucita. <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" />Amma akapi a nan ganu ele ɗa a̱ tsu ja̱mba̱ra̱ itana yu ucita. <verse eid="1CH 9:30" /><verse number="31" style="v" sid="1CH 9:31" />Vuma ta̱ a̱tsuma̱ a nan Levi za na a̱ tsu ɗe Matitiya mawun mo ufaru mo ulobo ma Shalum vuma va̱ a̱ɓula̱ va Kora a̱yi ɗa a cayi ulinga wu uzusun wo opopofu a̱ kucci. <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" />Ozo o ro le a̱tsuma̱ a̱ a̱za̱ e le a̱za̱ a̱ Koha ele ɗa a̱ shi nu ulinga wi ifoɓi yo opopofu i na a tsu zuwa a apada Ashibi biti.<verse eid="1CH 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33" />Aza a na a̱ shi azagbain a ashipi a limatan nan Levi a̱ shi ta̱ a̱ tsi isawan a̱tsuma̱ a asula a̱ A̱a̱'isamapaɗa, agba a̱ shi a tsu ca le ulinga u ro shi adama a na a̱ shi ta̱ a̱ tsu da̱na̱ o ulinga urana na ayin.<verse eid="1CH 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34" />Ele nda suru ele ɗa a̱ shi azagbain a limatan nan Levi, azagbain cine e gere n le diga a nkaya n le, waru a̱ shi ta̱ na̱ nden Urishelima.<verse eid="1CH 9:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 9:35" />Yeyiyel dada va Gibiyon u da̱nu ta̱ Gibiyon.</para>
  <para style="li2" vid="1CH 9:35">Ma'aka ɗa aala a ka va̱ yi. <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />Mawun mo ufaru ma̱ yi mo ulobo a̱yi ɗa Abadon, reve Zur kuru na̱ Kish na̱ Ba'al na̱ Ner na̱ Nadab <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" />na̱ Gedo na̱ Ahiyo na̱ Zakariya na̱ Mikalo. <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" />Mikalo ɗa matsain Shimeya. Ele fo a̱ shi ta̱ a̱ da̱nu zuzu na̱ a̱za̱ e le a̱tsuma̱ a̱ Urishelima.<verse eid="1CH 9:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 9:39" />Ner ɗa matsain Kish, reve Kish matsan Shawulu. A̱vu Shawulu matsan Jonata na̱ Malkishuwa na̱ Abinada na̱ Eshba'al.<note caller="+" style="f"><char style="fr" closed="false">9:39 </char><char style="ft" closed="false">Eshba'al: E revei ta̱ na aala waru Ishboshe. </char></note><verse eid="1CH 9:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 9:40" />Ulobo wa Jonata ɗa:</para>
  <para style="li2" vid="1CH 9:40">Meriba'al,<note caller="+" style="f"><char style="fr" closed="false">9:40 </char><char style="ft" closed="false">Meriba'al: E revei ta̱ na aala waru Mefiboshe.</char></note> za na matsain Mika.<verse eid="1CH 9:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 9:41" />Olobo a Mika ele ɗa:</para>
  <para style="li2" vid="1CH 9:41">Piton na̱ Mele na̱ Tareya na̱ Aha.<verse eid="1CH 9:41" /></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 9:42" />Aha ɗa matsain Yada, reve Yada matsan ta̱ Aleme na̱ Azimawe na̱ Zimri. Reve Zimri matsan Moza. <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" />Moza ɗa matsain Bineya reve Bineya matsan Refaya, reve Refaya matsan Eleyasa, a̱vu Eleyasa matsan Aze.<verse eid="1CH 9:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 9:44" />Aze ta̱ no olobo a̱ ta̱li, apa nda ala e le:</para>
  <para style="li2" vid="1CH 9:44">Azirikam na̱ Bokeru na̱ Isma'ila na̱ Sheyariya na̱ Obadiya na̱ Hanan. Suru nle olobo a Aze ɗa.<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s">Shawulu una ta̱ aciya̱yi</para>
  <para style="r">(<ref loc="1SA 31:1-3">1 Sam 31:1-3</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />Reve aza a Filistiya a yuwan uvon na̱ Isra'ila, a̱vu aza a Isra'ila a sumaa le. A̱vu o una a̱soja a Isra'ila na̱ a̱bunda̱ a Masasan ma Gilbowa. <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" />Reve aza a Filistiya a gbagba Shawulu no olobo a̱ yi Jonata na̱ Abinada na̱ Malkishuwa. <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" />Uvo'on u suɗuwa ta̱ Shawulu, reve ana a̱za̱ a̱ tewin a cina niyi a amaton yi. <verse eid="1CH 10:3" /><verse number="4" style="v" sid="1CH 10:4" />A̱vu u damma soja na a̱a̱ guzusa̱a̱ yi itana yu uvon, &lt;&lt;Tala matsun me pe'eni ma̱ wu a̱vu vu sapa mu, adama a̱za̱ o ufoɗyo a nda a̱ ta̱wa̱ a yuwaan mu ulamu wan.&gt;&gt;Agba za na a̱a̱ guzusa̱a̱ yi itana yu uvo'on wu uwwa ta̱ wovon u gura yuwan yi shi, ɗaɗa gba Shawulu tarai matsun me pe'eni ma̱ yi a̱vu u riya̱a̱ yi. <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />Ana za na a̱a̱ guzusa̱a̱ yi itana yu uvo'on we enei Shawulu kuwa̱i, a̱vu a̱yi fo u riya̱a̱ matsun me pe'eni ma̱ yi reve u kuwa̱. <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />Ne tsundolo tsa ɗa Shawulu no olobo a ta'atsu a̱ yi a̱ kuwa̱i nu u'wa wa̱ yi suru ne ɗa a̱ kuwa̱i oɓolo.<verse eid="1CH 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7" />Ana aza a Isra'ila suru a na a̱ ri a̱tsuma̱ o uka̱ri e enei a na a̱soja a sumai waru Shawulu oɓolo no olobo a̱ yi a̱ kuwa̱ ta̱, reve a lyawa ilyuci i le a̱vu a suma. Reve gba aza a Filistiya a̱ ta̱wa̱ a̱ da̱nu pe.<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8" />Ana usana u tawai, a na aza a Filistiya a̱ ta̱wa̱i a̱ pura̱ itana ya̱ a̱kwa̱kwa̱'a̱, a̱vu a cina Shawulu no olobo a̱ yi nven ukwa̱ zuva Masasan ma Gilbowa. <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />A̱vu o foɗo yi itana a̱vu a tara aaci a̱ yi ni itana yu uvon ya̱ yi. Reve a̱ lyungu ni ikaka a̱tsuma̱ e iɗa ya aza a Filistiya suru a baza alabari'i a̱tsuma̱ a̱ a̱ma̱li e le na ama e le. <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />A̱vu a zuwa itana yu uvon ya̱ yi a̱tsuma̱ a̱ a̱a̱'isa̱ a̱ musula̱ n le, reve a̱ sa̱ga̱do aaci a̱ yi a̱tsuma̱ a̱ a̱a̱'isa̱ a Dagon. <verse eid="1CH 10:10" /><verse number="11" style="v" sid="1CH 10:11" />Mantsa ma na ama a Jabe Giliyadu suru a uwwai ili na aza a Filistiya a yuwain na̱ Shawulu suru, <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />a̱vu ali e le o ucira suru a̱ 'ya̱wa̱ a tara lipu va Shawulu na̱ za vo olobo a̱ yi a̱ ta̱wa̱ ne ele Jabe. A̱vu a̱ ciɗo etele e le o ululu wu uɗanga wo oku a̱tsuma̱ a Jabesh, reve a yuwan akuli hali rana cindere.<verse eid="1CH 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13" />Shawulu kuwa̱ ta̱ adama a na u yuwain ulambu wa̱ a̱ɓula̱ e ekere a̱ A̱sulazuva, u kuru adanshi a̱ A̱sulazuva shi, hali gba waru u zami a̱sa̱la̱ uba̱ta̱ wa̱ a̱za̱ a̱ yindi.<note caller="+" style="f"><char style="fr" closed="false">10:13 </char><char style="ft" closed="false">Ka̱lyuwa̱: Ufr 19:31; 20:6; 1 Sam 13:8-14; 15:1-24; 28:7-8.</char></note> <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />U zami a̱sa̱la̱ e ekere a̱ A̱sulazuva shi. Adama o ndolo a ɗa gba A̱sulazuva o una niyi, a̱vu u vadala tsugono tsa̱ yi u ca Da̱wuda ulobo wa̱ Yese.<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s">Da̱wuda o'wo ta̱ mogono ma Isra'ila</para>
  <para style="r">(<ref loc="2SA 5:1-10">2 Sam 5:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />A̱vu ama a Isra'ila suru o ɓoloto uba̱ta̱ wa̱ Da̱wuda a Heburon a̱vu a damma, &lt;&lt;A̱tsu lipu va̱ wu ɗa na̱ mpasa ma̱ wu. <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />Ɗe a̱ca̱pa̱, ko a mantsa ma na Shawulu shi mogono a̱vu ɗa za na shi ronoi Isra'ila aaɗanga a̱tsuma̱ a agara o uvon u le. Reve A̱sulazuva A̱sula̱ a̱ wu a damma wu, &lt;Vu to o'wo za va aguɓa va ama a̱ va̱ Isra'ila, waru vu ta yuwan tsugbain tsa̱ le.&gt; &gt;&gt;<verse eid="1CH 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3" />Ana mbara ma Isra'ila suru n ta̱wa̱i uba̱ta̱ u Mogono Da̱wuda a Heburon, u yuwan ta̱ nzuwulai ne ele a Heburon a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva. A̱vu a̱ tsuwa̱a̱n Da̱wuda mani'in a katala yi mogono ma Isra'ila cine a adanshi A̱sulazuva a dammai o una̱ wa Sama'ila.<verse eid="1CH 11:3" /></para>
  <para style="s">Da̱wuda lyuwai Urishelima nu uvon</para>
  <para style="r">(<ref loc="2SA 5:6-10">2 Sam 5:6-10</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />Da̱wuda na aza a Isra'ila suru a̱ ka̱ra̱ ta̱ a̱ 'ya̱wa̱ Urishelima za na a̱yi ɗa Jebusiya, uba̱ta̱ u na aza a Jebusiya a̱ ri aza a na a̱ ri ni iɗa'a.<note caller="+" style="f"><char style="fr" closed="false">11:4 </char><char style="ft" closed="false">Ka̱lyuwa̱: Jos 15:63; A̱.Ug 1:21. </char></note> <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" />Reve aza a Jebusiya a na a̱ ri nden ɗe a damma Da̱wuda, &lt;&lt;Vaa uwa pa shi.&gt;&gt; Suru na̱ ne Da̱wuda gba lyuwa ta̱ lyuci vu uɓaɓu vu ucira wa̱ Sihiyona, Lyuci Gbain va̱ Da̱wuda. <verse eid="1CH 11:5" /><verse number="6" style="v" sid="1CH 11:6" />Da̱wuda damma ta̱ ɗe, &lt;&lt;Za na suru ronoi aaɗanga a̱ 'ya̱wa̱ uvon na aza a Jebusiya u to o'wo yali ya̱ a̱soja suru suru.&gt;&gt; Reve Yowab za na mma va̱ yi ɗa Zeruya fara uta̱, a̱vu gba u ushi tsugbai'in.<verse eid="1CH 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 11:7" />Reve Da̱wuda ka̱mba̱ na̱ nden a̱ lyuci'i, ɗaɗa e ɗe niyi Lyuci Gbain va̱ Da̱wuda. <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" />A̱vu u ka̱mba̱to lyuci'i lyuci gbain na̱ yisuwishi a̱ ka̱nda̱ruwa̱, diga Milo a̱ tyo o uɓaɓu u na u ka̱nda̱ruwa̱ niyi. Reve Yowab koso lapula lyuci'i. <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" />A̱vu Da̱wuda reme a yuwusan ucira adama a na A̱sulazuva o oɓolo a̱ a̱soja a zuva a̱ ri oɓolo na̱ a̱yi.<verse eid="1CH 11:9" /></para>
  <para style="s">Ali o uvon a̱ Da̱wuda</para>
  <para style="r">(<ref loc="2SA 23:8-39">2 Sam 23:8-39</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />Ele nda ele ɗa azagbain ali o uvon a̱ Da̱wuda, aza a na a kamba niyi tsugono tsa yi tsa yuwain ucira lon, oɓolo na aza a Isra'ila suru, adama a na wo o'wo mogono, cine A̱sulazuva a yuwain adanshi adama a aza a Isra'ila.<verse eid="1CH 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 11:11" />Apa ugeru wa ala a ali o uvon a̱ Da̱wuda:</para>
  <para style="p" vid="1CH 11:11">Yashobeyam za va Hakimoni, a̱yi ɗa u shi zagbain vi iɓolo i na a̱ tsu damma &lt;&lt;Aza a ta'atsu o ndolo.&gt;&gt; U 'ya̱sa̱n ta̱ ibata ya̱ yi u yuwan uvon na ama ukpaku uta'atsu (300), reve wu una le wutu u ta̱.<verse eid="1CH 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12" />Za na ri o tono yi a̱yi ɗa Eliyaza ulobo wa Dodo vuma va Ahohi, vuma ta̱ a̱tsuma̱ a ama ta'atsu a na a gurai uvon o ndolo. <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />U shi ta̱ oɓolo na̱ Da̱wuda a Pas Damim a mantsa ma na aza a Filistiya o ɓolotoi adama a yuwan uvon o uɗuma̱ u yitabo, a mantsa ma na a̱za̱ o uvon a Isra'ila a sumayi aza a Filistiya. <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />Amma a̱vu e isawan e memere mo uɗuma̱'a̱. A̱vu e geshe uɗuma̱'a̱ reve gba a̱ dukwa̱ aza a Filistiya, reve gba A̱sulazuva a ca le ulyuwu wa aci lon.<verse eid="1CH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15" />Reve ama a ta'atsu a̱tsuma̱ a azagbain mata'atsu'u a̱ zura̱ a̱ cipa̱ ya̱ Da̱wuda a aatali a Adulam a mantsa ma na oɓolo a̱ a̱soja a aza a Filistiya a̱ va̱la̱i o Uka̱ri wa Refaya. <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />A mantsa mo ndolo Da̱wuda da̱na̱ ta̱ pe o upa'atan wu ucira. A̱soja a Filistiya gba a̱ da̱na̱ ta̱ Batalami. <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" />A̱vu Da̱wuda uwwa akuli a̱ mini, reve u damma, &lt;&lt;A damma nanza shi ta̱ a̱ ta̱wa̱a̱ mu na̱ mini mo oso diga o ooko'o a na a̱ ri zuzu nu una̱ntsu wa Batalami!&gt;&gt; <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />Ɗaɗa a̱soja a ta'atsu'u a uwulai o uva̱la̱ta̱ wa aza a Filistiya, a̱vu o rono mini o ooko'o a na a̱ ri zuzu nu una̱ntsu wa Batalami, reve a tanu e tewe Da̱wuda. Agba reve u 'yuwan o sowo, a̱vu wo oco yi e iɗa a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva. <verse eid="1CH 11:18" /><verse number="19" style="v" sid="1CH 11:19" />A̱vu u damma, &lt;&lt;A̱sula̱ a paraa mu a na moo sowo mini ma nda! To, u to wo o'wo mu she damma mpasa ma ama o ndolo n ɗa mo sowuso, adama a na a zuwai wuma u le e meleshe ɗaɗa a̱ ta̱wa̱i na̱ a̱yi.&gt;&gt; Adama o ndolo Da̱wuda sowo mini'i shi.</para>
  <para style="p" vid="1CH 11:19">A̱yi ɗa ili ya̱ a̱ɓula̱ i na a̱soja a ta'atsu o ucira a nda a yuwain.<verse eid="1CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20" />Abishai mawun ma̱ a̱na̱wun ma̱ Yowab a̱yi ɗa u shi zagbain va aza a ta'atsu'u<note caller="+" style="f"><char style="fr" closed="false">11:20 </char><char style="ft" closed="false">&lt;&lt;Mata'atsu: Na̱ Tsuyahuda a ɗana ta̱ &lt;ta'atsu&gt; ne pa nda.&gt;&gt;</char></note>. U 'ya̱sa̱n ta̱ ibata ya̱ yi u yuwan uvon na ama ukpaku uta'atsu (300) a̱vu wu una le, ɗaɗa gba e revei na̱ a̱yi tsa ama a Ta'atsu o ndolo. <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />A da̱shi yi ta̱ tsugbain ure nu uta̱ ula'awu na aza a Ta'atsu o ndolo reve gba wo o'wo zagbain le, ko na wo o'woi o ɓolo yi a̱tsuma̱ e le shi.<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22" />Benaya ulobo wa Yehoyida vuma ɗa na gurai uvon lon diga a̱ lyuci va Kabuzeye, u yuwan ta̱ linga gbagbain. Wu una ta̱ ama a Mowa ejere aza a na a gurai uvon lon. Urana u ro a mantsa mo uta̱nu a̱vu u cipa̱ a̱ a̱a̱ka̱ri o ro wu una kamu. <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />A̱vu waru u ga̱la̱ vuma va Masar za na shi uga'an ana e cindere na akapi. Ko na za va Masar u shi ni ibata tsa aaɗanga o uɗava o ukere wa̱ yi, Benaya zura̱ yi ta̱ na̱ a̱a̱kpa̱mkpa̱la̱. A̱vu usa yi ibata'a, reve wu una yi ni ibata ya̱ yi. <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />A̱yi ɗa linga gbagbain na Benaya ulobo wa Yehoyida yuwain, a̱yi fo u shi ta̱ u yuwan ala tsa ama o ucira a Ta'atsu o ndolo. <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />U yuwan ta̱ ala ula'awu na̱ koyan ɗa a̱tsuma̱ a ama Mata'atsu o ndolo, amma u ri a̱tsuma̱ a ama a Ta'atsu o ndolo shi. Reve Da̱wuda zuwa yi wo o'wo zagbain va̱ a̱za̱ e ipiri ya̱ yi.<verse eid="1CH 11:25" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="26" style="v" sid="1CH 11:26" />Apa ala ali a na a la'a gurai uvon lon,</para>
  <para style="li2" vid="1CH 11:26">Asahe mawun ma̱ a̱na̱wun ma̱ Yowab</para>
  <para style="li2" vid="1CH 11:26">na̱ Elhanan ulobo wo Dodo vuma va Batalami<verse eid="1CH 11:26" /></para>
  <para style="li2">
    <verse number="27" style="v" sid="1CH 11:27" />na̱ Shamo vuma va Haro</para>
  <para style="li2" vid="1CH 11:27">na̱ Helez vuma va Pelon,<verse eid="1CH 11:27" /></para>
  <para style="li2">
    <verse number="28" style="v" sid="1CH 11:28" />na̱ Ira ulobo wa Ikesh vuma va Tekowa</para>
  <para style="li2" vid="1CH 11:28">na̱ Abiyeza vuma va Anato<verse eid="1CH 11:28" /></para>
  <para style="li2">
    <verse number="29" style="v" sid="1CH 11:29" />na̱ Sibekai vuma va Husha</para>
  <para style="li2" vid="1CH 11:29">na̱ Ilai vuma va Ahohi<verse eid="1CH 11:29" /></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 11:30" />na̱ Maharai vuma va Netofa na̱ Hele ulobo wa Ba'ana vuma va Netofa<verse eid="1CH 11:30" /></para>
  <para style="li2">
    <verse number="31" style="v" sid="1CH 11:31" />na̱ Itai ulobo wa Ribai vuma va Gibiya a̱tsuma̱ e iɗa ya Banyami</para>
  <para style="li2" vid="1CH 11:31">na̱ Benaya vuma va Piraton<verse eid="1CH 11:31" /></para>
  <para style="li2">
    <verse number="32" style="v" sid="1CH 11:32" />na̱ Hurai diga o ɗolu va Ga'ash,</para>
  <para style="li2" vid="1CH 11:32">na̱ Abiye vuma va Arba.<verse eid="1CH 11:32" /></para>
  <para style="li2">
    <verse number="33" style="v" sid="1CH 11:33" />na̱ Azimawe vuma va Bahurim,</para>
  <para style="li2" vid="1CH 11:33">na̱ Eliyabu vuma va Sha'albon.<verse eid="1CH 11:33" /></para>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 11:34" />Olobo a Hashem vuma va Gizon ele ɗa:</para>
  <para style="li2" vid="1CH 11:34">Jonata ulobo wa Shageye vuma va Harari <verse eid="1CH 11:34" /><verse number="35" style="v" sid="1CH 11:35" />na̱ Ahiyam ulobo wa Saka vuma va Harari na̱</para>
  <para style="li2" vid="1CH 11:35">Elifa ulobo wa̱ Ur<verse eid="1CH 11:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 11:36" />na̱ Hefa vuma va Mekera</para>
  <para style="li2" vid="1CH 11:36">na̱ Ahiya vuma va Pelon<verse eid="1CH 11:36" /></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 11:37" />na̱ Hezro vuma va Kame</para>
  <para style="li2" vid="1CH 11:37">na̱ Na'arai ulobo wa Ezibai<verse eid="1CH 11:37" /></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 11:38" />na̱ Juwe mawun ma̱ a̱na̱wun ma Natan</para>
  <para style="li2" vid="1CH 11:38">na̱ Mibha ulobo wa Hagiri<verse eid="1CH 11:38" /></para>
  <para style="li2">
    <verse number="39" style="v" sid="1CH 11:39" />na̱ Zele vuma va Amon</para>
  <para style="li2" vid="1CH 11:39">na̱ Naharai vuma va Berot, za na ɓanasayi Yowab za na mma va̱ yi ɗa Zeruya itana yu uvon,<verse eid="1CH 11:39" /></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 11:40" />na̱ Ira vuma va Itiri</para>
  <para style="li2" vid="1CH 11:40">na̱ Gare vuma va Itiri<verse eid="1CH 11:40" /></para>
  <para style="li2">
    <verse number="41" style="v" sid="1CH 11:41" />na̱ Uriya vuma va Hitiya</para>
  <para style="li2" vid="1CH 11:41">na̱ Zabad ulobo wa Alai<verse eid="1CH 11:41" /></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 11:42" />na̱ Adina ulobo wa Shiza vuma va̱ Roben, za na shi zagbain vu ugundo wa̱ Roben oɓolo na ama mataꞌatsu ma na ma̱ shi oɓolo na̱ yi,<verse eid="1CH 11:42" /></para>
  <para style="li2">
    <verse number="43" style="v" sid="1CH 11:43" />na̱ Hanan ulobo wa Ma'aka</para>
  <para style="li2" vid="1CH 11:43">na̱ Yoshafa vuma va Mitna<verse eid="1CH 11:43" /></para>
  <para style="li2">
    <verse number="44" style="v" sid="1CH 11:44" />na̱ Uziya vuma va Ashitore</para>
  <para style="li2" vid="1CH 11:44">na̱ Shama na̱ Yeyiyel olobo a Hotam vuma va Arowa,<verse eid="1CH 11:44" /></para>
  <para style="li2">
    <verse number="45" style="v" sid="1CH 11:45" />na̱ Yediyayel ulobo wa Shimri</para>
  <para style="li2" vid="1CH 11:45">na̱ mawun ma̱ a̱na̱wun ma̱ yi Yoha vuma va Tiz<verse eid="1CH 11:45" /></para>
  <para style="li2">
    <verse number="46" style="v" sid="1CH 11:46" />na̱ Eliyel vuma va Mahawa</para>
  <para style="li2" vid="1CH 11:46">na̱ Yeribai na̱ Yoshaviya olobo wa̱ Elna'am</para>
  <para style="li2" vid="1CH 11:46">na̱ Itma vuma va̱ Mowa<verse eid="1CH 11:46" /></para>
  <para style="li2">
    <verse number="47" style="v" sid="1CH 11:47" />oɓolo na̱ Eliyel na̱ Obe na̱ Ya'asiyel vuma va Mezoba.<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s">A̱soja a na a kambai Da̱wuda</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 12:1" />Apa ama a na a̱ ta̱wa̱i uba̱ta̱ wa̱ Da̱wuda a̱tsuma̱ a Ziklag, a mantsa ma na u pa'ayin Mogono Shawulu ulobo wa̱ Kish. A̱ ta̱ pe a̱tsuma̱ a aza a na a gurai uvon a na a kambai Da̱wuda uvon. <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />Ama a ɗa a na gurai uvon ni ibata lon waru a gura ta̱ utewishin va aya na̱ a̱bitsutsu nu ukere wu usa'ani ko ugula̱. Ele ama a Banyami a ɗa o ugundo wa Shawulu, waru ele ɗa:<verse eid="1CH 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 12:3" />Ahiyeza zagbain le na̱ Yowash olobo a Shema vuma va Gibiya,</para>
  <para style="li2" vid="1CH 12:3">na̱ Yeziyel na̱ Pele olobo a Azimave</para>
  <para style="li2" vid="1CH 12:3">na̱ Beraka na̱ Yehu va Anato<verse eid="1CH 12:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 12:4" />na̱ Ishimaya vuma va Gibiyon vuma vu ucira a̱tsuma̱ a Mata'atsu, za na da̱na̱i zagbain va Mata'atsu'u,</para>
  <para style="li2" vid="1CH 12:4">Irimiya na̱ Yahaziyel na̱ Yohanan na̱ Yozaba vuma va Gedera<verse eid="1CH 12:4" /></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 12:5" />na̱ Eluzai na̱ Yerimo na̱ Beyaliya na̱ Shemariya na̱ Shefatiya vuma va Hari<verse eid="1CH 12:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 12:6" />na̱ Elikana na̱ Ishiya na̱ Azare na̱ Yoweze na̱ Yashobeyam za va Kora<verse eid="1CH 12:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 12:7" />na̱ Yowela na̱ Zebadiya ulobo wa Yeroham vuma va Gedo.<verse eid="1CH 12:7" /></para>
  <para style="s">A̱soja o ugundo wa Gadu a na o toniyi Da̱wuda</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8" />Apa a nda aza a Gadu a na a̱ ka̱mba̱i ya̱ Da̱wuda a̱tsuma̱ o uba̱ta̱ wu upa'atan wu ucira a̱tsumona. Ele aza a na a gurai uvon lon ɗa, waru a̱ da̱na̱ ta̱ ufoɓu adama o uvon a̱ tu fo nu uguru wu u ɓana̱sa wa̱ a̱ra̱ga̱ ni ibata. Urewesu u le u rotso ta̱ urewesu wi ikamu, agba a̱ tsu da̱na̱ ta̱ a sumusa tsu na vu revei mere'on a̱tsuma̱ a masasan.<verse eid="1CH 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 12:9" />Eze ɗa da̱na̱i zagbain</para>
  <para style="li2" vid="1CH 12:9">na̱ Obadiya za na da̱na̱i zagbain va̱ ire na̱ Eliyabu za va ta'atsu<verse eid="1CH 12:9" /></para>
  <para style="li2">
    <verse number="10" style="v" sid="1CH 12:10" />na̱ Mishmana za va̱ na̱shi na̱ Irimiya za va tawun<verse eid="1CH 12:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 12:11" />na̱ Atayi za va̱ ta̱li na̱ Eliyel za va̱ cindere<verse eid="1CH 12:11" /></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 12:12" />na̱ Yohanan za va̱ kunla̱ na̱ Elzaba za va̱ kuci<verse eid="1CH 12:12" /></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 12:13" />na̱ Irimiya za va kupa na̱ Makbanai za va kupa na̱ za ta̱.<verse eid="1CH 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14" />Aza a Gadu a nda ele ɗa nan yali ya̱ a̱soja, za na ka̱la̱ma̱ n le ucira urawa ta̱ ucira wa̱ a̱soja ukpaku (100), waru ucira wu za na la'a n le ucira u rawa ta̱ ucira wa̱ a̱soja ukpakukupa (1,000). <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" />Ele ɗa aza a na a pasai Uɗolu wa̱ Urudu a̱tsuma̱ o woto wu ufaru a mantsa ma na a̱ da̱na̱i a yuwusan mini mo ucira, a̱vu a̱ gba̱ra̱ ama a na a̱ ri na̱ nden o uka̱ri, diga o upasu wa asana a̱ tyo wa̱ a̱livu.<verse eid="1CH 12:15" /></para>
  <para style="s">A̱soja o ugundo wa Banyami na̱ Yahuda o toni ta̱ Da̱wuda</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16" />Ozo oro a̱tsuma̱ o ugundo wa Banyami na akapi a ama a Yahuda a̱ ta̱wa̱ ta̱ uba̱ta̱ wa Da̱wuda a̱tsuma̱ o uba̱ta̱ wu upa'atan wa̱ yi. <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" />A̱vu Da̱wuda uta̱ adama u ga'aton le a̱vu u damma le, &lt;&lt;N na̱ i ta̱wa̱ ta̱ uba̱ta̱ u va̱ na̱ nden ma asuvu na adama a na ya kamba mu, n tu ufoɓu u na maa lyawa ɗu i ɓolo aci na̱ a̱mu. Amma n na̱ i ta̱wa̱ ta̱ adama a na ya̱ luluma̱ mu reve i ca mu e ekere a n'yuwatan n va̱ agba a̱mu waru n yuwan ɗu unusu shi, lyawa A̱sula̱ a nkaya n tsu ee ene a̱vu u ge'eto ɗu.&gt;&gt;<verse eid="1CH 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18" />A̱vu Ruhu va̱ A̱sula̱ cipa̱a̱ Amasa, zagbain va mata'atsu, a̱vu u damma,</para>
  <para style="b" vid="1CH 12:18" />
  <para style="q1" vid="1CH 12:18">&lt;&lt; A̱tsu a̱za̱ a̱ wu ɗa Da̱wuda!</para>
  <para style="q2" vid="1CH 12:18">Tsu to oɓolo na̱ a̱vu, ulobo wa̱ Yese!</para>
  <para style="q1" vid="1CH 12:18">Asuvu nden, asuvu nden n da̱na̱ oɓolo na̱ a̱ vu,</para>
  <para style="q2" vid="1CH 12:18">waru asuvu nden n da̱na̱ oɓolo na aza a na a kambusa wu!</para>
  <para style="q1" vid="1CH 12:18">Adama a na A̱sula̱ a̱ wu a ta kambusa wu.&gt;&gt;</para>
  <para style="b" vid="1CH 12:18" />
  <para style="p" vid="1CH 12:18">A̱vu Da̱wuda ushi le reve u zuwa le o o'wo azagbain a̱ a̱soja o uvon a̱ yi.<verse eid="1CH 12:18" /></para>
  <para style="s">A̱soja o ugundo wa Manase a na o toniyi Da̱wuda</para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19" />A̱soja o ro a Manase a̱ ka̱mba̱ ta̱ ya̱ Da̱wuda adama a na aa kamba yi a mantsa ma na wu uta̱i na aza a Filistiya a na a yuwan uvon na̱ Shawulu. A̱yi na ama a̱ yi a 'yuwan ta̱ a na a kamba aza a Filistiya adama a na, ana o kotoi a̱sa̱la̱, azagbain a Filistiya a̱ gba̱ra̱ yi ta̱. A̱vu a damma, &lt;&lt;U ta̱ da̱na̱ o una̱ u wuma u tsu n na̱ tsu lyawa Da̱wuda yuwan uvon na̱ a̱tsu u ta̱ ta̱wa̱ u gura ka̱mba̱ tsu o ucina̱ a̱vu u kamba zagbain va̱ yi Shawulu.&gt;&gt; <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" />A mantsa ma na Da̱wuda ka̱ra̱i a̱ tyo Ziklag, ele nda ele ɗa a̱soja a Manase aza a na a̱ ka̱mba̱i uba̱ta̱ wa̱ yi: Adna na̱ Yozaba na̱ Yediyayel na̱ Mikayel na̱ Yozaba na̱ Elihu na̱ Ziletai, azagbain a̱ a̱soja o ukpakukupa kupa ɗa ozo o ugundo wa Manase. <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" />A kamba ta̱ Da̱wuda adama a na wa̱a̱ gba̱ra̱ aza a na a̱ ta̱wusa̱ yi nu uvon, adama a na suru nle aza a na a gurai uvon lon ɗa, agba ele azagbain a ɗa a̱tsuma̱ a̱ a̱soja o uvon a̱ yi. <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />A̱tsuma̱ a rana suru a̱soja a̱ tsu ta̱wusa̱ ta̱ adama a na aa kamba Da̱wuda, hali acina mantsa ma na u ɓolotoi a̱soja a̱bunda̱, ununa a̱soja a̱ A̱sula̱ a̱ ri.<verse eid="1CH 12:22" /></para>
  <para style="s">A̱soja o ro a na o toniyi Da̱wuda a̱tsuma̱ a̱ Heburon</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 12:23" />Apa nda ala a̱soja a na o foɓoi adama o uvon aza a na a̱ ta̱wa̱i uba̱ta̱ wa̱ Da̱wuda a̱tsuma̱ a̱ Heburon a na avadala tsugono tsa Shawulu a̱ tyo e ekere a̱yi, ununa adanshi A̱sulazuva a dammai.<verse eid="1CH 12:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 12:24" />A̱soja a Yahuda a̱ da̱na̱ ta̱ na ali o uvon a na a̱ ri uɓa̱nu na̱ a̱ra̱ga̱ ni ibata ukpakukupa uta̱li nu ukpakukunla̱ (6,800) adama o uvon.<verse eid="1CH 12:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 12:25" />A̱soja a Saminu, aza a na o foɓoi adama o uvon ukpakukupa ucindere nu ukpaku (7,100) u ɗa.<verse eid="1CH 12:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 12:26" />A̱soja a̱ Levi ele ɗa ukpakukupa una̱shi na̱ ukpakuta̱li (4,600). <verse eid="1CH 12:26" /><verse number="27" style="v" sid="1CH 12:27" />oɓolo na̱ Yehoyida, zagbain vu u'wa wa Haruna, za na ri na̱ a̱soja ukpakukupa uta'atsu na̱ ukpakucindere (3,700). <verse eid="1CH 12:27" /><verse number="28" style="v" sid="1CH 12:28" />oɓolo na̱ Saduku, za na gurai uvon lon, oɓolo na azagbain a̱soja diga o u'wa wa̱ a̱yi.<verse eid="1CH 12:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 12:29" />A̱soja a Banyami ama a Shawulu, a̱soja ukpakukupa uta'atsu (3,000), aza a na a raɓatoi a̱tsuma̱ o u'wa wa Shawulu hali mantsa ma nda.<verse eid="1CH 12:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 12:30" />A̱soja a Ifiramu, aza a na a gurai uvon lon ɗa, aza a na revei lon, diga a̱tsuma̱ a 'wa le ukpakukupa ushin na̱ ukpakukunla̱ (20,800).<verse eid="1CH 12:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 12:31" />Uɓatsulai wa a ama o ugundo wa Manase, a na a ca yi aala ele adama a na a̱ ta̱wa̱ a na a katala Da̱wuda mogono okokolo, a̱bunda̱ le ɗa ukpakukupa na̱ kunla̱ (18,000).<verse eid="1CH 12:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 12:32" />A̱soja a Isaka, aza a na e revei mantsa ni ili i na i lobonoi aza a Isra'ila a yuwan azagbain ukpakukupa ure (200) u ɗa, oɓolo na̱ mmaci ma̱ yi na a yuwusan tsutoni na̱ a̱yi.<verse eid="1CH 12:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 12:33" />A̱soja a̱ Zebulun, a̱soja o urevu o ufoɓu adama o uvon na̱ cu'un vi itana yu uvon suru, a na a kamba Da̱wuda no okolo a̱ ta̱ ukpakukupa kupa uton (50,000).<verse eid="1CH 12:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 12:34" />A̱soja a Nafutali azagbain ukpakukupa (1,000) ɗa, oɓolo na̱ a̱soja ukpakukupa mataꞌatsu na̱ a̱za̱ a̱ cindere (37,000) a̱soja a na a̱ ɓa̱na̱sa̱ a̱ra̱ga̱ ni ibata.<verse eid="1CH 12:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 12:35" />A̱soja a Dan, aza a na a̱ ri ufoɓu adama o uvon ukpakukupa ushin na̱ kula̱ nu ukpaku uta̱li (28,600) ɗa.<verse eid="1CH 12:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 12:36" />A̱soja a Asha ukpakukupa amunga (40,000) ɗa, waru a̱ tu ufoɓu adama o uvon.<verse eid="1CH 12:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="1CH 12:37" />Diga o upasu wa asana o Uɗolu wa̱ Urudu, a̱soja a̱ Roben na̱ Gadu nu uɓatsulai wu ugundo wa Manase, ufoɓu na̱ cu'un vi itana yu uvon suru ukpakukupa ukpaku nu ushin (120,000).<verse eid="1CH 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 12:38" />Suru nle a̱soja a ɗa aza a na a̱ ri ufoɓu a na a ca yi aciyele adama o uvon. A̱ ta̱wa̱ ta̱ a̱tsuma̱ a̱ Heburon na̱ okolo a̱ ta̱ adama a na a katala mogono Da̱wuda okokolo a̱tsuma̱ a Isra'ila. Suru fo akapi aza a Isra'ila a̱ da̱na̱ ta̱ na̱ majiyan ma̱ a̱ ta̱ a na a katala Da̱wuda mogono. <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />Ama'a a yuwan ta̱ rana ta'atsu na̱ Da̱wuda ɗe, a lyuwusa no osowi, adama a na aza a 'wa le oɓoloto ta̱ ilyalya adama e le. <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />Mmaci n le diga a̱tsuma̱ e iɗa ya alanga ele ɗa Isaka na̱ Zebulun na̱ Nafutali. A̱vu a̱ ta̱wa̱a̱ le ni ilyalya zuva vu nloli na arakumi na̱ nloli mi ido no ogono e inan. A̱ da̱na̱ ta̱ na̱ yira ya̱ a̱bunda̱, nu ubiri wu ɗewu, na emeshen o ukangalu, na̱ masayan na̱ mani'in, ni inan ni ikyon, adama a na a̱ da̱na̱ ta̱ na̱ ma̱za̱nga̱ a̱tsuma̱ a Isra'ila.<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s">Uka̱mba̱tosu wa Akpati a Nzuwulai diga Kiriyat Jeyarim</para>
  <para style="r">(<ref loc="2SA 6:1-11">2 Sam 6:1-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />Da̱wuda yuwan ta̱ a̱sa̱la̱ na̱ azagbain a̱soja a̱ yi, nan yali o ukpakukupa kupa na̱ nan yali ukpakukupa. <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />A̱vu u damma suru ama a Isra'ila a na o ɓolotoi,&lt;&lt;N na̱ u yuwan ɗu ta̱ ulobonu waru n na̱ a̱yi ɗa ifoɓi ya̱ A̱sulazuva A̱sula̱ a̱ tsu, lyawa tsu lyungu suru ikaka a̱ tyo ya akapi a ama a tsu aza a na a̱ ri pa zuzu na alanga a̱tsuma̱ o upasu wi iɗa ya Isra'ila, hali acina nan ganu na̱ nan Levi aza a na a̱ ri oɓolo na̱ ele a̱tsuma̱ e ilyuci i le nu uba̱ta̱ wa aguɓa, ana a̱ ta̱wa̱ oɓolo ukere na̱ a̱tsu. <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />Reve tsu ka̱mba̱toi Akpati a Nzuwulai A̱sula̱ uba̱ta̱ u tsu, adama a na tsu yuwan aɗa a̱ yi a mantsa mo tsugono tsa mogono Shawulu shi.&gt;&gt; <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" />A̱vu suru oɓolo a ama a̱ usu a yuwan ne, adama a na a̱sa̱la̱'a̱ ulobono le ta̱.<verse eid="1CH 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5" />Reve Da̱wuda ɓoloto ama a Isra'ila suru, diga o Uɗolu wa Shiho a̱tsuma̱ a Masar acina Lebo Hamat, a na a̱ ta̱wa̱a̱ na a Akpati a Nzuwulai A̱sula̱ diga Kiriyat Jeyarim.<note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Sam 7:2.</char></note> <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" />A̱vu Da̱wuda oɓolo na a ama a Isra'ila suru a̱ ka̱ra̱ a agawan a̱ tyo ya Ba'ala va Yahuda a̱tsuma̱ Kiriyat Jeyarim a na a̱ ta̱wa̱ na a Akpati a Nzuwulai A̱sula̱, za na a̱ tsu ɗe na a aala A̱sulazuva, za na a̱ shuwa̱i e memere me ikerobobi.<note caller="+" style="f"><char style="fr" closed="false">13:6 </char><char style="ft" closed="false">Ka̱lyuwa̱: Mta̱ 25:18-20; Izk 1:5-13; Wen 4:6-9.</char></note><verse eid="1CH 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 13:7" />A tara ta̱ Akpati a Nzuwulai A̱sula̱ diga o u'wa wa Abinada zuva vi ikeke i sa'avu vi inan, Uza na̱ Ahiyo ele ɗa aza a na a walai elime. <verse eid="1CH 13:7" /><verse number="8" style="v" sid="1CH 13:8" />Da̱wuda oɓolo na̱ aza a Isra'ila suru waru a̱ da̱na̱ ta̱ a yuwusan ma̱za̱nga̱ nu ucira le suru elime A̱sula̱, ni ishipa ni igaraya na̱ kumburu na aganga na̱ mupalu m malapa na̱ wivulusa̱ wa avana.<verse eid="1CH 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9" />A mantsa ma na a rawai o osoroto a Kidon, a̱vu Uza canana ukere wa̱ a̱yi adama a na wee reme Akpati'i adama a na na'an u shi ta̱ uta̱ɗa̱tsa̱. <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" />A̱vu A̱sulazuva a yuwan upan na̱ Uza, a̱vu wu unai adama a na u canana ta̱ ukere wa̱ a̱yi uba̱ta̱ wa Akpati'i. Reve u kuwa̱ lo elime A̱sula̱. <verse eid="1CH 13:10" /><verse number="11" style="v" sid="1CH 13:11" />Reve Da̱wuda yuwan upan adama a na upan wa̱ A̱sulazuva a̱cipa̱ yi Uza, hali acina ana'an nda uba̱ta̱'a̱ a̱ tsu ɗe yi ta̱ Pere Uza.<verse eid="1CH 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12" />Da̱wuda da̱na̱ ta̱ a uwwusa wovon wa̱ A̱sula̱ o uranu u ndolo reve we ece, &lt;&lt;Cine ma a gura yuwan a̱vu n ta̱wa̱ na̱ Akpati a Nzuwulai A̱sula̱ uba̱ta̱ u va̱?&gt;&gt; <verse eid="1CH 13:12" /><verse number="13" style="v" sid="1CH 13:13" />Adama o ndolo u gura tara Akpati a Nzuwulai a na wa̱ da̱na̱ oɓolo na̱ a̱yi a̱tsuma̱ lyuci va̱ Da̱wuda shi. Adama o ndolo, a̱vu tewetoyi o u'wa wa Obed Edom vuma va Gat. <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />Akpati a Nzuwulai a̱ da̱nu ta̱ pe o u'wa wa Obed Edom hali woto ta'atsu, reve A̱sulazuva a zuwaa u'wa wa̱ yi aba'un na̱ suru ili i na u ri na̱ a̱yi. <note caller="+" style="f"><char style="fr" closed="false">13:14 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Alb 26:4-5.</char></note><verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s">Ulinga wa̱ Da̱wuda a̱tsuma̱ a̱ Urishelima</para>
  <para style="r">(<ref loc="2SA 5:11-16">2 Sam 5:11-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />A̱vu mogono Hiram va Taya lyungu nlingata a̱ tyo ya̱ Da̱wuda, oɓolo na akpata a Sida na aza na a yuwusan usa na aatali na̱ ozo o ushe'en wa akpata adama a na a suwaa yi ukobu. <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" />Da̱wuda gura ta̱ reve a na A̱sulazuva a ɗa a̱ shuwa̱ niyi wo o'wo mogono a aci a aza a Isra'ila waru tsugono tsa yi tsa̱ tsura̱ ta̱ ulyuwu we elime lon adama a ama a̱ yi aza a Isra'ila.<verse eid="1CH 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3" />Da̱wuda tara ta̱ a̱ma̱ci a̱bunda̱ diga a̱tsuma̱ a̱ Urishelima reve o o'wo dada vo olobo ne esheli a̱ a̱bunda̱. <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />Apa nda ala a̱ muwun n na a matsaan niyi ɗe: Shamuwa na̱ Shoba na̱ Natan na̱ Sulemanu <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" />na̱ Ibha na̱ Elishuwa na̱ ElPele <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" />na̱ Noga na̱ Nefe na̱ Yafiya <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" />na̱ Elishama na̱ Beyeliyada na̱ Elifele.<verse eid="1CH 14:7" /></para>
  <para style="s">Da̱wuda lyuwa ta̱ aza a Filistiya nu uvon</para>
  <para style="r">(<ref loc="2SA 5:17-25">2 Sam 5:17-25</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />A mantsa ma na aza a Filistiya a uwwai a na a̱ tsuwa̱a̱n ta̱ Da̱wuda mani'in a na wo o'wo mogono ma aza a Isra'ila, reve o uta̱ nu ucira izami ya̱ yi, amma Da̱wuda uwwa ta̱ adama aɗa e le, a̱vu wu uta̱ adama a na waa ga'an ne ele. <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" />Agba aza a Filistiya a̱ ta̱wa̱ ta̱ nu uvon, a̱vu a̱ pura̱ itana yu Uka̱ri wa aza a Refaya. <verse eid="1CH 14:9" /><verse number="10" style="v" sid="1CH 14:10" />A̱vu Da̱wuda pati ya̱ A̱sula̱: &lt;&lt;N 'ya̱wa̱ n yuwan uvon na aza a Filistiya? Vu ta ca le e ekere a̱ va̱?&gt;&gt;</para>
  <para style="p" vid="1CH 14:10">Reve A̱sulazuva a̱ usu yi, &lt;&lt;Wala, n ta ca wu ele e ekere a̱ wu.&gt;&gt;<verse eid="1CH 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11" />A̱vu Da̱wuda oɓolo na̱ a̱soja a̱yi a̱ ka̱ra̱ a̱ tyo Ba'al Perazim, ɗe ɗa u tsura̱i ulyuwu wa aci e ekere ele. A̱vu u damma, &lt;&lt; Ununa mini ma̱ tsu ɓoso, A̱sula̱ oɓoso ta̱ n'yuwatan n va̱ e ekere a̱ va̱.&gt;&gt; Adama o ndolo reve e ɗe ala o uba̱ta̱'a̱ Ba'al Perazim, adansa A̱sulazuva a ɗa o ɓosoi. <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" />Aza a Filistiya a lyawa ta̱ musula̱ n le lo uba̱ta̱'a̱, a̱vu Da̱wuda ca u dammu na a̱ kula̱to e le a̱tsuma̱ a akina.<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13" />A̱vu waru aza a Filistiya a̱da̱shi ta̱wa̱ nu uvon a̱tsuma̱ o uka̱ri, <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" />a̱vu Da̱wuda patiyisa A̱sula̱ waru, a̱vu A̱sula̱ a̱ usu yi, &lt;&lt;She vu 'ya̱wa̱ mejege wan, amma vu ka̱nda̱ruwa̱ le a̱vu vu riya̱ le nu uvon elime aɗanga vu ujan. <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />A mantsa ma na vu uwwai ilama ya a̱soja a̱ mota̱ uba̱ta̱ wu ɗanga vu ujan, vu uta̱ adama o uvon, adama a na u rotso ta̱ a na A̱sula̱ a wala ta̱ elime a na wo kototo a̱soja a Filistiya.&gt;&gt; <verse eid="1CH 14:15" /><verse number="16" style="v" sid="1CH 14:16" />Da̱wuda yuwan ta̱ ununa A̱sula̱ a damma niyi, a̱vu o kototo a̱soja a Filistiya, diga a̱tsuma̱ a Gibiyon a̱ tyo Geza.<verse eid="1CH 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17" />Da̱wuda yuwan ta̱ ala a̱tsuma̱ a nɗa suru, a̱vu A̱sulazuva a zuwa suru nɗa mu uwwa wovon wa̱ yi.<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s">A̱ ta̱wa̱to ta̱ Akpati a Nzuwulai a̱ A̱sula̱ a̱tsuma̱ a̱ Urishelima</para>
  <para style="r">(<ref loc="2SA 6:12-23">2 Sam 6:12-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />A mantsa ma na Da̱wuda suwaa yi aciya̱yi 'wa a̱tsuma̱ a̱ lyuci va̱ Da̱wuda, a̱vu u foɓo uba̱ta̱ adama a Akpati a Nzuwulai a̱ A̱sula̱ na̱ masa'a adama a̱yi. <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />A̱vu Da̱wuda damma, &lt;&lt;She nanza tanu Akpati a Nzuwulai wan she nan Levi goon, adama a na A̱sulazuva a ɗangula le ta̱ ɗe adama a tanu Akpati a̱ A̱sulazuva, na̱ waru a yuwaan yi a̱ga̱nda̱ hali hali.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:2 </char><char style="ft" closed="false">Ka̱lyuwa̱: U.Wl 10:8.</char></note><verse eid="1CH 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3" />A̱vu Da̱wuda ɓoloto ama a Isra'ila a̱tsuma̱ a̱ Urishelima suru adama a na a̱ ta̱wa̱ na Akpati a Nzuwulai A̱sulazuva uba̱ta̱ u na o foɓo niyi. <verse eid="1CH 15:3" /><verse number="4" style="v" sid="1CH 15:4" />A̱vu u ɓoloto ugundo wa Haruna nan Levi uba̱ta̱ uta̱.<verse eid="1CH 15:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 15:5" />Diga o ugundo wa Koha,</para>
  <para style="li2" vid="1CH 15:5">ama ukpaku nu ushin (120), Uriya ɗa da̱na̱i zagbain le.<verse eid="1CH 15:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 15:6" />Diga o ugundo wa Merari,</para>
  <para style="li2" vid="1CH 15:6">ama ukpakure nu ushin (220), Asaya ɗa da̱na̱i zagbain le.<verse eid="1CH 15:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 15:7" />Diga o ugundo wa Gashon,</para>
  <para style="li2" vid="1CH 15:7">ama ukpaku na̱ mata'atsu (130), Juwe ɗa da̱na̱i zagbain le.<verse eid="1CH 15:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 15:8" />Diga o ugundo wa Elizafan,</para>
  <para style="li2" vid="1CH 15:8">ama ukpakure (200), Shemaya ɗa da̱na̱i zagbain le.<verse eid="1CH 15:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 15:9" />Diga o ugundo wa Heburon,</para>
  <para style="li2" vid="1CH 15:9">ama Kupa kula̱, Eliyel ɗa da̱na̱i zagbain le.<verse eid="1CH 15:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 15:10" />Diga o ugundo wa Uziye,</para>
  <para style="li2" vid="1CH 15:10">ama ukpaku na̱ kupa ne ejere (112), Aminada ɗa da̱na̱i zagbain le.<verse eid="1CH 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11" />A̱vu Da̱wuda ɗe Saduku na̱ Abiyata nan ganu, oɓolo na̱ Uriyel na̱ Asaya na̱ Juwe na̱ Shemaya na̱ Eliyel na̱ Aminada nan Levi. <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />A̱vu u damma le, &lt;&lt;A̱ɗu ɗa azagbain va aza 'wa va nan Levi, a̱ɗu oɓolo na̱ a̱za̱ a̱ɗu nan Levi i ta tawa aciya̱ a̱ɗu yo'o cece adama a na ya̱ ta̱wa̱a̱ na Akpati a nzuwulai a̱ A̱sulazuva A̱sula̱ a Isra'ila, a̱ tyo wu uba̱ta̱ u na n foɓo niyi. <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />Adama a na a̱ɗu nan Levi a̱ɗu ɗa i kuɗa̱i a na ya tara yi ɗe nu ufaru a na i zuwai upan wa̱ A̱sulazuva A̱sula̱ a̱ tsu a̱ riya̱a̱ n tsu. Adama a na tse ecei ununa tsa yuwan na̱ yi shi ununa u zuwai.&gt;&gt; <verse eid="1CH 15:13" /><verse number="14" style="v" sid="1CH 15:14" />A̱vu nan ganu na̱ nan Levi a tawa aciyele adama a na a̱ ta̱wa̱ na Akpati a nzuwulai A̱sulazuva, A̱sula̱ a Isra'ila. <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" />A̱vu nan Levi a tara Akpati a Nzuwulai A̱sula̱'a̱ na aɗanga e le nlyungu, ununa Musa dammai a̱tsuma̱ adanshi A̱sulazuva.<note caller="+" style="f"><char style="fr" closed="false">15:15 </char><char style="ft" closed="false">Mta̱ 25:14.</char></note><verse eid="1CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16" />A̱vu Da̱wuda damma azagbain a nan Levi a ɗangula diga a̱tsuma̱ e imaci i le ashipi a na a cana ishipa i ma̱za̱nga̱, oɓolo ni itana yi ishipa: Igaraya na̱ ikumburu ni igoge. <verse eid="1CH 15:16" /><verse number="17" style="v" sid="1CH 15:17" />A̱vu nan Levi a ɗangula Heman ulobo wa Juwe a̱tsuma̱ a̱za̱ a̱ yi na̱ Asaf ulobo wa Berekiya, a̱tsuma̱ a̱za̱ a Merari a ɗangula ta̱ Etan ulobo wa Kushaya. <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />Oɓolo ne ele a̱vu a ɗangula aza a na a kamba ele, Zakariya na̱ Ya'aziyel na̱ Shemiramo na̱ Yehiyel na̱ Uni na̱ Eliyabu na̱ Benaya na̱ Ma'aseya na̱ Matitiya na̱ Elifele na̱ Mikneya na̱ Obed Edom na̱ Jeyiyel aza a na a yuwusan ipiri yu una̱ntsu.<verse eid="1CH 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19" />A̱za̱ e ishipa ele ɗa Heman na̱ Asaf na̱ Etan. Ele ɗa aza a na a ɗangulai a na a yuwusan mataɗa ma kumburu na̱ maganga ma̱ rumushili. <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" />Zakariya na̱ Aziyel na̱ Shemiramo na̱ Yehiyel na̱ Uni na̱ Eliyabu na̱ Ma'aseya na̱ Benaya ele ɗa aza a na a wa'a ikumburu na̱ mesun zuva, <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" />na̱ Matitiya na̱ Elifele na̱ Mikneya na̱ Obed Edom na̱ Yehiyel na̱ Azaziya ele ɗa a taɗa igaraya na̱ mesun wa'a wa'a. <verse eid="1CH 15:21" /><verse number="22" style="v" sid="1CH 15:22" />Kenaniya zagbain va nan a Levi ɗa da̱na̱i zagbain va̱ a̱za̱ e ishipa, a̱yi ɗa u da̱na̱i ulinga wa̱ a̱yi adama a na a̱yi ma̱dobiya ma ɗa.<verse eid="1CH 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 15:23" />Berekiya na̱ Elikana ele ɗa a̱za̱ e ipiri yu una̱ntsu wu uba̱ta̱ u na a zuwusa Akpati a Nzuwulai. <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" />Shebaniya na̱ Yehoshafa na̱ Nataniya na̱ Amasai na̱ Zakariya na̱ Benaya na̱ Eliyaza ganu ele ɗa aza na a̱ da̱na̱ ivulusa̱ avana elime Akpati a Nzuwulai A̱sula̱. Obed Edom na̱ Yehiya ele ɗa a̱za̱ e ipiri yu una̱ntsu wu uba̱ta̱ u na a zuwusa Akpati a Nzuwulai.<verse eid="1CH 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25" />A̱vu Da̱wuda na̱ mbara ma aza a Isra'ila na̱ nan yali a̱soja o ukpakukupa kupa a̱ ka̱ra̱ adama a na a̱ ta̱wa̱ na Akpati a Nzuwulai A̱sulazuva diga a̱tsuma̱ o u'wa wa Obed Edom. Reve a̱ ta̱wa̱ na̱ yi na̱ ma̱za̱nga̱ ma̱ a̱bunda̱ lon. <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />A na wo o'woi A̱sula̱ a kamba ta̱ nan Levi ozo o utanusu wa Akpati a Nzuwulai A̱sulazuva, reve a ca kucci vo ogono e inan e cindere na̱ a̱giri'i e cindere. <verse eid="1CH 15:26" /><verse number="27" style="v" sid="1CH 15:27" />Da̱wuda da̱na̱ ta̱ wotowu nu utugu wo okoro, ununa nan Levi aza a na a̱ da̱na̱i utanuwu na Akpati a Nzuwulai a̱ da̱na̱i, na ashipi na̱ Kenaniya za na da̱na̱i zagbain va aza a na a yuwusan ishipa. Waru Da̱wuda oto ta̱ epo vo okoro. <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />A̱vu aza a Isra'ila suru a̱ ta̱wa̱ na Akpati a Nzuwulai A̱sulazuva ni yisali, e ivulusa̱ avana na abulu, ni igoge na̱ mataɗa ma̱ kumburu ni igaraya.<verse eid="1CH 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29" />A mantsa ma na Akpati a Nzuwulai A̱sulazuva a̱ ri a ma uwwa ma lyuci va Da̱wuda, a̱vu Mikal usheli wa Shawulu u ka̱lyuwa̱ nu uba̱ta̱ wu usowoto wu upepu. A na we enei mogono Da̱wuda o uje'en nu u yuwusain ma̱za̱nga̱ ma̱ a̱bunda̱, a̱vu u goro yi ookolo.<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1" />A̱vu a̱ ta̱wa̱ na Akpati a Nzuwulai a̱ A̱sula̱ reve a zuwa yi a̱tsuma̱ o oogodo uba̱ta̱ u na Da̱wuda foɓoo niyi, a̱vu a ca kucci vu ukula̱tosu na̱ kucci muwwulai elime a̱ A̱sula̱. <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" />A mantsa ma na Da̱wuda kotoi kucci vu ukula̱tosu na̱ kucci muwwulai'i, a̱vu u zuwaa ama aba'un a̱tsuma̱ a ala a̱ A̱sulazuva. <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />A̱vu u ne'eshen ama a Isra'ila ali na̱ a̱ma̱ci za suru akpatali o oopopofu na apaɗi a nama ne emeshen.<verse eid="1CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4" />Da̱wuda ɗangula ta̱ a̱tsuma̱ a nan Levi aza a na a yuwan a̱ga̱nda̱ elime a Akpati a Nzuwulai a̱ A̱sulazuva, a̱vu a yuwusan ipati, nu ugodyusho, na a casuyi ala A̱sulazuva A̱sula̱ a Isra'ila ica. <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />Asaf ɗa da̱na̱i zagbain le na̱ Zakariya o tono na̱ Yeyiyel na̱ Shemiramo na̱ Yehiyel na̱ Matitiya na̱ Eliyabu na̱ Benaya na̱ Obed Edom na̱ Yeyiyel. Ele ɗa aza a na a taɗa kumburu ni igaraya. Asaf ɗa za na a̱ da̱na̱ a lapusa mupalu m malapa. <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" />Benaya na̱ Yahaziyel nan ganu ele ɗa a̱a̱ da̱na̱ e ivulusa̱ avana kuci elime a Akpati a Nzuwulai a̱ A̱sula̱.<verse eid="1CH 16:6" /></para>
  <para style="s">Ishipa yu ugodyusho ya̱ Da̱wuda</para>
  <para style="r">(<ref loc="PSA 105:1-15">Ica 105:1-15</ref>; <ref loc="PSA 96:1-13">96:1-13</ref>; <ref loc="PSA 106:1">106:1</ref>,<ref loc="PSA 106:47-48">47-48</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7" />O urana u ndolo ɗa Da̱wuda fara zuwai Asaf oɓolo na̱ a̱za̱ a̱ yi a na a̱a̱ da̱na̱ a yuwusan ishipa yu ugodyusho a̱ tyo uba̱ta̱ wa̱ A̱sulazuva.<verse eid="1CH 16:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8" />I godyushoo A̱sulazuva,</para>
  <para style="q2" vid="1CH 16:8">i ɗe a̱tsuma̱ a ala a̱ yi,</para>
  <para style="q2" vid="1CH 16:8">i damma ulinga wa̱ yi a̱tsuma̱ a nɗa.<verse eid="1CH 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9" />Canaa niyi ishipa,</para>
  <para style="q2" vid="1CH 16:9">i canaa yi ica!</para>
  <para style="q1" vid="1CH 16:9">waru i yuwan adanshi a linga va̱ yi,</para>
  <para style="q2" vid="1CH 16:9">linga va asalama a na u yuwain suru.<verse eid="1CH 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10" />Tsugbain a̱tsuma̱ a ala akiza a̱ yi,</para>
  <para style="q2" vid="1CH 16:10">lyawa okolo a aza a na a zamiyi A̱sulazuva,</para>
  <para style="q2" vid="1CH 16:10">a yuwan ma̱za̱nga̱.<verse eid="1CH 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11" />I zami A̱sulazuva nu ucira wa̱ yi,</para>
  <para style="q2" vid="1CH 16:11">waru i zami urewesu wa̱ yi fo mantsa suru.<verse eid="1CH 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 16:12" />I cuwan na̱ linga va̱ yi va asalama,</para>
  <para style="q2" vid="1CH 16:12">ni ili ya asalama,</para>
  <para style="q2" vid="1CH 16:12">nu uge'etosu u na u cayi nu una̱ wa̱ yi,<verse eid="1CH 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 16:13" />A̱ɗu limatan va Isra'ila agbashi a̱ yi,</para>
  <para style="q2" vid="1CH 16:13">a̱ɗu muwun ma Yakubu, aza a na u ɗangulai.<verse eid="1CH 16:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14" />A̱yi ɗa A̱sulazuva a̱ A̱sula̱ a̱ tsu,</para>
  <para style="q2" vid="1CH 16:14">uge'etosu wa̱ yi u ta̱ pe a̱tsuma̱ o uvaɗi suru.<verse eid="1CH 16:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15" />Waru i cuwan na̱ Nzuwulai ma̱ yi hali hali,</para>
  <para style="q2" vid="1CH 16:15">na adanshi a na u dammai,</para>
  <para style="q2" vid="1CH 16:15">a̱ tyo mantsa ukpakukupa kupa,<verse eid="1CH 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16" />nzuwulai n na u yuwain na̱ Ibrahim,</para>
  <para style="q2" vid="1CH 16:16">na akucunu a na u yuwayin Ishiyaku,<note caller="+" style="f"><char style="fr" closed="false">16:16 </char><char style="ft" closed="false">Ka̱lyuwa̱: Ufr 12:7; 26:3.</char></note><verse eid="1CH 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17" />za na u shitoyin e ekere a Yakubu ununa u dammai,</para>
  <para style="q2" vid="1CH 16:17">e ekere a Isra'ila nzuwulai n na n ri nu ukosu shi,<note caller="+" style="f"><char style="fr" closed="false">16:17 </char><char style="ft" closed="false">Ka̱lyuwa̱: Ufr 28:13.</char></note><verse eid="1CH 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18" />adansa,&lt;&lt;E ekere a̱ wu a ɗa maa ca iɗa ya Ka'ana,</para>
  <para style="q2" vid="1CH 16:18">wo o'wo akunda a agadu a̱ wu.&gt;&gt;<verse eid="1CH 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19" />A mantsa ma na i da̱na̱i meketeci,</para>
  <para style="q2" vid="1CH 16:19">uka̱la̱mu waru, waru omocin e iɗa'a,<verse eid="1CH 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 16:20" />a̱ da̱na̱ ta̱ agara diga e iɗa a̱ tyo e iɗa,</para>
  <para style="q2" vid="1CH 16:20">diga o tsugono a̱ tyo tsugono tso ro.<verse eid="1CH 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21" />U lyawa nanza goro le shi,</para>
  <para style="q2" vid="1CH 16:21">waru u ɓara ta̱ ngono adama e le,<note caller="+" style="f"><char style="fr" closed="false">16:21 </char><char style="ft" closed="false">Ka̱lyuwa̱: Ufr 20:3-7.</char></note><verse eid="1CH 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22" />adansa,</para>
  <para style="q2" vid="1CH 16:22">&lt;&lt;She i ju'wa̱n aza a na n ɗangulai wan,</para>
  <para style="q2" vid="1CH 16:22">ko i yuwaan ama̱sula̱ a̱ va̱ iwuya wan!&gt;&gt;<verse eid="1CH 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23" />I canaa A̱sulazuva ishipa,</para>
  <para style="q2" vid="1CH 16:23">a̱ɗu ama o uvaɗi suru!</para>
  <para style="q2" vid="1CH 16:23">a̱vu i yuwan adanshi e iwawi i na u tsu yuwusan urana suru.<verse eid="1CH 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24" />A̱vu i yuwan adanshi a tsugbain tsa̱ yi a̱tsuma̱ a nɗa,</para>
  <para style="q2" vid="1CH 16:24">na̱ linga va asalama a̱ yi,</para>
  <para style="q2" vid="1CH 16:24">a̱tsuma̱ a ama suru!<verse eid="1CH 16:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25" />Adama a na A̱sulazuva zagbain ɗa,</para>
  <para style="q2" vid="1CH 16:25">agba u rawa ta̱ a na a ca yi ica lon.</para>
  <para style="q1" vid="1CH 16:25">A 'yuwan a ciga a la'a uwwa wovon wa̱ yi,</para>
  <para style="q2" vid="1CH 16:25">ula'awu na̱ musula̱ suru.<verse eid="1CH 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26" />Adama a na suru musula̱ mu nɗa a̱ma̱li a ɗa,</para>
  <para style="q2" vid="1CH 16:26">amma A̱sulazuva a ɗa a yuwain zuva.<verse eid="1CH 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27" />Tsugbain nu ulobonu,</para>
  <para style="q2" vid="1CH 16:27">a̱ ta̱ utusa̱ diga ya̱'a̱ yi,</para>
  <para style="q1" vid="1CH 16:27">ucira na̱ ma̱za̱nga̱,</para>
  <para style="q2" vid="1CH 16:27">a̱ ta̱ pe uba̱ta̱ wu nden ma̱ yi.<verse eid="1CH 16:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28" />Yuwain ica ya̱ A̱sulazuva,</para>
  <para style="q2" vid="1CH 16:28">a̱ɗu limatan vu nɗa,</para>
  <para style="q1" vid="1CH 16:28">cayi A̱sulazuva ica,</para>
  <para style="q2" vid="1CH 16:28">na̱ tsugbain tsa̱ yi!<verse eid="1CH 16:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 16:29" />Cayi A̱sulazuva ica,</para>
  <para style="q2" vid="1CH 16:29">i tsugbain tsa aala a̱ yi!</para>
  <para style="q1" vid="1CH 16:29">I ta̱wa̱ na̱ kucci elime a̱ yi,</para>
  <para style="q2" vid="1CH 16:29">waru i kingyo elime a̱ yi,</para>
  <para style="q1" vid="1CH 16:29">i yuwaan A̱sulazuva a̱ga̱nda̱</para>
  <para style="q2" vid="1CH 16:29">a̱tsuma̱ a tsugbain tsa akiza a̱ yi.<verse eid="1CH 16:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="1CH 16:30" />I je'en lipu elime a̱ yi,</para>
  <para style="q2" vid="1CH 16:30">a̱ɗu ama o uvaɗi suru!</para>
  <para style="q1" vid="1CH 16:30">Uvaɗi u shuwa̱ ta̱ ulobonu,</para>
  <para style="q2" vid="1CH 16:30">agba wa̱a̱ jinga̱ɗa̱ shi.<verse eid="1CH 16:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31" />Lyawa zuva yuwan ma̱za̱nga̱,</para>
  <para style="q2" vid="1CH 16:31">uvaɗi waru i yuwan ma̱za̱nga̱ mo okolo.</para>
  <para style="q1" vid="1CH 16:31">Lyawa a damma nɗa suru,</para>
  <para style="q2" vid="1CH 16:31">&lt;&lt; A̱sulazuva ɗa mogono!&gt;&gt;<verse eid="1CH 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32" />Lyawa uɗolu yuwan ilama,</para>
  <para style="q2" vid="1CH 16:32">ni ili i na suru i ri pe a̱tsuma̱ a̱ yi!</para>
  <para style="q1" vid="1CH 16:32">Lyawa agalaci a yuwan tsu'yan na̱ ma̱za̱nga̱,</para>
  <para style="q2" vid="1CH 16:32">ni ili i na suru i ri pe a̱tsuma̱ e le!<verse eid="1CH 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33" />Lyawa ɗanga va̱ a̱rumbu,</para>
  <para style="q2" vid="1CH 16:33">a̱ 'ya̱sa̱n uɗyo wi ishipa i ma̱za̱nga̱!</para>
  <para style="q1" vid="1CH 16:33">A ta yuwan ishipa i ma̱za̱nga̱ e ekere a̱ A̱sulazuva,</para>
  <para style="q2" vid="1CH 16:33">adama a na u ta̱ lo a̱ ta̱wa̱,</para>
  <para style="q2" vid="1CH 16:33">a na wee ge'eto o uvaɗi.<verse eid="1CH 16:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34" />Godyoyi A̱sulazuva,</para>
  <para style="q2" vid="1CH 16:34">adama a na a̱yi za vi isa'ani ɗa,</para>
  <para style="q1" vid="1CH 16:34">icigi ya̱ yi waru u tsu vadala shi,</para>
  <para style="q2" vid="1CH 16:34">hali hali!<note caller="+" style="f"><char style="fr" closed="false">16:34 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Alb 5:13; 7:3; Ezr 3:11; Ica 100:5; 106:1; 107:1; 118:1; 136:1; Irm 33:11.</char></note><verse eid="1CH 16:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35" />A̱vu i damma yi,</para>
  <para style="q1" vid="1CH 16:35">&lt;&lt; Wawa tsu, A̱sula̱ a̱ tsu,</para>
  <para style="q2" vid="1CH 16:35">Za vi iwawi i tsu!</para>
  <para style="q1" vid="1CH 16:35">vu ɓoloto tsu, reve vu wawa tsu,</para>
  <para style="q2" vid="1CH 16:35">e ekere a nɗa,</para>
  <para style="q1" vid="1CH 16:35">adama tsu godyo aala a akiza a̱ wu,</para>
  <para style="q2" vid="1CH 16:35">a̱vu waru tsu yuwan afalu a̱tsuma̱ e ica ya̱ wu.<verse eid="1CH 16:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36" />Ica za va wu ɗa A̱sulazuva,</para>
  <para style="q2" vid="1CH 16:36">A̱sula̱ a Isra'ila,</para>
  <para style="q1" vid="1CH 16:36">za na ri nu ufaru ko ukosu shi.&gt;&gt;</para>
  <para style="b" vid="1CH 16:36" />
  <para style="p" vid="1CH 16:36">A̱vu ama a̱ usu, &lt;&lt;Lyawa wo o'wo ne&gt;&gt; A̱vu a cuwa a̱ A̱sulazuva.<verse eid="1CH 16:36" /></para>
  <para style="s">A̱ga̱nda̱ a̱tsuma̱ a̱ Urishelima na̱ Gibiyon</para>
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37" />A̱vu Da̱wuda lyawa lo Asaf na̱ a̱za̱ a̱ yi uba̱ta̱ wa Akpati a Nzuwulai a̱ A̱sula̱, adama a na a̱ da̱na̱ a yuwusan a̱ga̱nda̱ lo kuci, ununa a zuwai a̱ da̱na̱ a yuwusan urana suru. <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />Waru u lyawa ta̱ lo Obed Edom na̱ a̱za̱ a̱ yi kupota̱li na̱ kula̱ a na a̱ da̱na̱ a yuwusan a̱ga̱nda̱ oɓolo ne ele. Obed Edom ulobo wa Yedutun na̱ Hosa ele ɗa aza a na a yuwusan ipiri yu una̱ntsu.<verse eid="1CH 16:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39" />Da̱wuda lyawa ta̱ lo Saduku ganu, oɓolo na̱ a̱za̱ a̱ yi nan ganu uba̱ta̱ wa Akpati a Nzuwulai a̱ A̱sulazuva uba̱ta̱ u na a casu kucci a̱tsuma̱ a Gibiyon. <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />Ele ɗa a̱ da̱na̱ a casu kucci vu ukula̱tosu uba̱ta̱ wa̱ A̱sulazuva zuva masa'a kuci, usana nu ulivu ununa wila̱ wa̱ A̱sulazuva a dammai, aza a na u cayi aza a Isra'ila suru. <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />Oɓolo ne ele a̱ da̱na̱ ta̱ na̱ Heman na̱ Yedutun na akapi aza a na a ɗangulai ko'o na a aala adama a̱ da̱na̱ a yuwusan ishipa nu ugodyusho uba̱ta̱ wa̱ A̱sulazuva, adama e icigi ya̱ yi i na i tsu vadala shi mantsa suru. <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" />Heman na̱ Yedutun ele ɗa aza a na a̱a̱ da̱na̱ e ivulusa̱ avana na̱ malapa ma mupalu m malapa na̱ malapa ma akapi e itana yu ugodyusho ya̱ A̱sula̱ adama e ishipa ya Akiza. Olobo Yedutun ɗa a zuwai a̱ da̱na̱ o una̱ntsu.<verse eid="1CH 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43" />A̱vu akapi a ama suru a̱ ka̱ra̱, za suru tyo ta̱ o u'wa wa̱ yi, reve Da̱wuda fo ka̱mba̱ o u'wa adama a na waa a zuwaa u'wa yi aba'un.<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s">Nzuwulai ma̱ A̱sula̱ a̱ tyo ya̱ Da̱wuda</para>
  <para style="r">(<ref loc="2SA 7:1-17">2 Sam 7:1-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />A mantsa ma na Da̱wuda da̱nuyi o ukobu wa̱ yi, reve u damma Natan vumava̱sula̱, &lt;&lt;A̱mu ɗa nda gogo, n da̱nuyi o ukobu u na a yuwain na akpata a sida, a̱yi ɗa nda Akpati a Nzuwulai a̱ A̱sulazuva a ɗa ɗe a̱tsuma̱ o oogodo.&gt;&gt;<verse eid="1CH 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2" />A̱vu Natan usu Da̱wuda u damma, &lt;&lt;Suru ili i na vu ri na̱ a̱yi o okolo, vu yuwan yi, adama a na A̱sula̱ o to oɓolo na̱ a̱vu.&gt;&gt;<verse eid="1CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3" />A̱tsuma̱ a ayin o ndolo reve A̱sula̱ a yuwan adanshi na̱ Natan, u damma, <verse eid="1CH 17:3" /><verse number="4" style="v" sid="1CH 17:4" />Ka̱ra̱ a̱ 'ya̱wa̱ vu damma aagbashi a̱ va̱ Da̱wuda,</para>
  <para style="b" vid="1CH 17:4" />
  <para style="pi" vid="1CH 17:4">Apa ili i na A̱sulazuva a dammai, &lt;&lt;A̱vu ɗa za na aa suwaa mu u'wa u na ma̱a̱ da̱nu shi. <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />N shi nden a̱tsuma̱ o u'wa shi diga mantsa ma na mu uta̱yi aza a Isra'ila diga e iɗa ya Masar hali acina ana'an. Amma n da̱na̱ ta̱ a mmalu diga o oogodo a̱ tyo o oogodo, diga o oogodo agalaci a̱ tyo o oogodo agalaci. <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />A̱tsuma̱ a mmalu n va̱ na ama a Isra'ila suru, koto me ece ko vuma ta̱ a̱tsuma̱ azagbain e le, aza a na n zuwai wo o'wo aza a aguɓa a ama a̱ va̱, adama a nye ɗa i kuɗa̱i a na ya suwaa mu aasula akpata a sida shi?&gt;&gt;<verse eid="1CH 17:6" /></para>
  <para style="pi">
    <verse number="7" style="v" sid="1CH 17:7" />&lt;&lt;Adama o ndolo gogo vu damma Da̱wuda aagbashi a̱ va̱, apa ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva a dammai, &lt;N ɗangula wu ta̱ diga o uba̱ta̱ wa aguɓa e mgbele, a na vo o'wo zagbain e ekere a ama a̱ va̱ aza a Isra'ila. <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />N da̱na̱ ta̱ oɓolo na̱ a̱vu uba̱ta̱ u na vu tyoi biti, waru n kototo ta̱ n'yuwatan ma̱ a̱ wu elime a̱ wu suru. Gogo n ta zuwa ala a̱ wu wo o'wo tsa ala a azagbain ama o uvaɗi. <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />Waru n ta a ɗangulaa ama a̱ va̱ aza a Isra'ila uba̱ta̱, waru n ta̱ shuwa̱ le, adama a̱ tsura̱ 'wa va aciyele waru adama o ɓongi le wan. Ama a wuya a̱ da̱shi zuwa le a̱tsuma̱lima̱ ununa a yuwain ɗe nu ufaru shi, <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />agba n yuwan ta̱ ne ɗe nu ufaru a mantsa ma na n ɗangulai zagbain e ekere a ama a̱ va̱ aza a Isra'ila. Waru n ta̱ kototo n'yuwatan n ɗu.</para>
  <para style="p" vid="1CH 17:10">&lt;&lt; &lt;Suru na̱ ne, a̱mu A̱sulazuva n yuwan ta̱ nzuwulai a na ma̱a̱ shuwa̱ u'wa wa̱ wu. <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />Na̱ vu kuwa̱, a̱vu a̱ ciɗo wu oɓolo na̱ nkaya ma̱ a̱ wu, n ta zuwa za ta̱ a̱tsuma̱ a limatan va̱ a̱ wu a na wo o'wo mogono o una̱ wa̱ a̱ wu, za ta̱ a̱tsuma̱ olobo a̱ wu, waru n ta shuwa̱ tsugono tsa̱ yi. <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />A̱yi ɗa za na aa suwaa mu u'wa, waru n ta̱ shuwa̱ tsugono tsa̱ yi babu ukotu. <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />N to o'wo dada va̱ yi, a̱yi waru u to o'wo ulobo u va̱. Maa tawa icigi i va̱ uba̱ta̱ wa̱ yi ununa n tawai za va Shawulu za na yuwain tsugono elime a̱ wu shi.<note caller="+" style="f"><char style="fr" closed="false">17:13 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Kor 6:18; M.Ib 1:5.</char></note> <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />N ta zuwa yi a̱tsuma̱ o u'wa u va̱ na̱ tsugono tsa̱ a̱ va̱ babu ukotu, waru ootogu o tsugono tsa̱ yi tsa̱ ta̱ shuwa̱ babu ukotu.&gt; &gt;&gt;<verse eid="1CH 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15" />A̱vu Natan ka̱mbuwa̱ Da̱wuda idanshi ya alavu alavu a na A̱sulazuva o roco niyi suru.<verse eid="1CH 17:15" /></para>
  <para style="s">Avasa a̱ Da̱wuda</para>
  <para style="r">(<ref loc="2SA 7:18-29">2 Sam 7:18-29</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />A̱vu Mogono Da̱wuda ka̱ra̱ a uwa pe a̱tsuma̱ o oogodo uba̱ta̱ u na a zuwai Akpati a Nzuwulai a̱ A̱sulazuva, reve u da̱nu a̱ ma̱ka̱nka̱ ma̱ A̱sulazuva, a̱vu u damma,</para>
  <para style="b" vid="1CH 17:16" />
  <para style="pi" vid="1CH 17:16">&lt;&lt;Zane ɗa a̱mu, A̱sulazuva A̱sula̱, waru nye i ɗa u'wa u va̱, hali na vu ta̱wa̱to na̱ mu diga alanga? <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />Waru vu tara yi ili i ro ya̱'a̱ wu shi A̱sula̱, vu yuwan ta̱ adanshi a̱ a̱ba̱jini e ili i na yaa fara o u'wa wa aagbashi a̱ wu. Vu tara mu ta̱ she damma vuma gbain ro ɗa a̱tsuma̱ a ama, A̱sulazuva A̱sula̱.<verse eid="1CH 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 17:18" />&lt;&lt;Nye waru a̱mu Da̱wuda maa damma wu adama a tsugbain tsa a na vu cayi aagbashi a̱ wu? Adama a na vu reve ta̱ aagbashi a̱ wu. <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />A̱sulazuva, adama a aagbashi wu ni icigi yo okolo a̱ wu, vu yuwan ta̱ a̱ba̱jini e ili ya nda reve vu roco suru a̱ba̱jini a Nzuwulai.&gt;&gt;<verse eid="1CH 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 17:20" />&lt;&lt;A̱sulazuva, za lo tsa̱ wu shi, waru babu lo A̱sula̱ o ro she a̱vu goon, ununa tsu uwwai na atsuvu a̱ tsu. <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />Waru nan zane ɗa a̱ ri lo tsa ama wu Isra'ila, nɗa mu uvaɗi aza a na A̱sula̱ o uta̱i adama u wawa le, adama a aciya ya̱ yi o o'wo ama a̱ yi, waru vu zami ala adama a̱ wu, waru vu yuwan a̱ba̱jini e ili, ni ili ya asalama ni ili i wovon a na vu gba̱ra̱i nɗa elime a ama a̱ wu, aza a na vu wawai a̱tsuma̱ a Masar? <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />Reve vo o'woto Isra'ila ama a amayun a̱ wu babu ukotu. A̱vu na aciya a̱ wu A̱sulazuva, vo o'wo ta̱ A̱sula̱ e le.&gt;&gt;<verse eid="1CH 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 17:23" />&lt;&lt;Gogo A̱sulazuva, lyawa Nzuwulai n na vu yuwain adama aagbashi a̱ wu, oɓolo nu u'wa wa̱ yi u shuwa̱ babu ukotu. Lyawa vu shiton ili i na vu dammai. <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />Adama wo o'wo ushuwu babu ukotu waru aala a̱ wu a̱ ta̱ da̱na̱ na̱ tsugbain babu ukotu. Waru ama a ta damma, &lt;A̱sulazuva o oɓolo a̱ a̱soja a zuva, A̱sula̱ a aza a Israꞌila, A̱sula̱ a Isra'ila a ɗa!&gt; Waru u'wa wa̱ Da̱wuda aagbashi a̱ wu u to o'wo ushuwu a̱ ma̱ka̱ka̱n ma̱ a̱ wu.<verse eid="1CH 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 17:25" />&lt;&lt;A̱sula̱ a̱ va̱, vu roco ta̱ aagbashi a̱ wu a na vu ta suwa yi u'wa, adama o ndolo aagbashi a̱ wu a̱ tsura̱ ta̱ ugbamu wo okolo a na waa yuwan avasa a̱ tyo uba̱ta̱ wa̱ wu. <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />A̱sulazuva, a̱vu ɗa A̱sula̱, vu yuwaan ta̱ aagbashi a̱ wu nzuwulai mi ili i sa'ani. <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />Gogo u yo'ono wu ta̱ vu zuwaa u'wa wa aagbashi a̱ wu aba'un, tsura̱ wo o'wo ushuwu babu ukotu e esu a̱ wu, adama a na a̱vu A̱sulazuva vu zuwaa yi ta̱ aba'un, waru u ta̱ da̱na̱ na aba'un babu ukotu.&gt;&gt;<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s">Ulyuwu wa̱ aci wa̱ Da̱wuda</para>
  <para style="r">(<ref loc="2SA 8:1-14">2 Sam 8:1-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />Ana a yuwain tsundolo, a̱vu Da̱wuda lyuwa aza a Filistiya nu uvon a̱vu u ka̱mba̱to le agbashi a̱ yi, reve u usa lyuci va Gat na̱ mulyuci n na n ri uka̱nda̱ruwu na̱ a̱yi e ekere a tsugbain tsa aza a Filistiya.<verse eid="1CH 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 18:2" />Da̱wuda lyuwa ta̱ waru a̱za̱ a̱ Mowa, reve o o'wo agbashi a̱ yi, a̱vu a̱ ta̱wusa̱a̱ yi nu utafa.<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3" />Da̱wuda waru lyuwa ta̱ Mogono Hadadeza va̱ Zoba nu uvon hali a rawa Hamat, a mantsa ma na u 'ya̱wa̱i u shuwa̱i tsugono tsa̱ yi a̱tsuma̱ o upasu wu Uɗolu wa̱ Yufiriti. <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" />Da̱wuda pura̱ ta̱ ikeke yi ido ya̱ yi ukpakukupa (1,000) na̱ a̱soja ukpakukupa ucindere (7,000) aza a na a tsu kumbusa ido, na̱ a̱soja ukpakukupa ushin (20,000) aza a na a̱ ri a mmalu e iɗa. U kutsuma̱to ta̱ ido i na i tsu ronuso ikeke yi ido amma u lyawa ta̱ ukpaku.<verse eid="1CH 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5" />A mantsa ma na ama a Suriya a Dimaska a̱ ta̱wa̱i a na a kamba Mogono Hadadeza va Zoba, Da̱wuda una ta̱ a̱soja e le ukpakukupa ushin nu ukpakukupa ure (22,000). <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" />A̱vu u zuwa uba̱ta̱ wu nda̱na̱ta̱ wa̱ a̱soja a̱ yi a̱tsuma̱ a Dimaska va Suriya. A̱vu aza a Suriya o o'wo agbashi a̱ yi a̱vu a̱ ta̱wusa̱ yi nu utafa. A̱sulazuva a ca ta̱ Da̱wuda ulyuwu wa a aci suru uba̱ta̱ u na u 'ya̱wa̱i biti.<verse eid="1CH 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7" />Da̱wuda pura̱ ta̱ a̱ra̱ga̱ a zinariya aza a na azagbain a̱ a̱soja a Hadadeza a̱ ta̱wa̱yi, a̱vu u ta̱wa̱to le a̱tsuma̱ a̱ Urishelima. <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" />Diga Teba na̱ Kun, ilyuci ya Hadadeza, Da̱wuda pura̱ ta̱ irumushili ya̱ a̱bunda̱. Aza a na Sulemanu yuwayin ulinga a na yuwain ara'atsu a̱ rumushili, na atsura na̱ cu'un vu ntaɗa vu rumushili suru.<note caller="+" style="f"><char style="fr" closed="false">18:8 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 7:40-47; 2 Alb 4:11-18.</char></note><verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9" />A mantsa ma na Mogono Toyi va Hamat ma uwwai a na Da̱wuda lyuwa ta̱ a̱soja o Mogono Hadadeza va̱ Zoba nu uvon, <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />a̱vu u lyungu ulobo wa̱ yi Hadoram uba̱ta̱ u Mogono Da̱wuda na wa̱ ca̱sa̱ yi adama o ulyuwu wa a aci a na u tsura̱i e ekere a Hadadeza uba̱ta̱ wu uvon, za na da̱na̱i a yuwusan uvon na̱ Toyi. Hadoram ta̱wa̱ ta̱ na̱ cu'un vu ntaɗa n zinariya na̱ azurufa na̱ rumushili. <verse eid="1CH 18:10" /><verse number="11" style="v" sid="1CH 18:11" />A̱vu mogono Da̱wuda tawaa A̱sulazuva itana i nda, ununa u yuwain na̱ zinariya na̱ azurufa aza a na u pura̱i e ekere a nɗa nda suru: Edom na̱ Mowa na̱ Amon na̱ Filistiya na̱ Amaleka.<verse eid="1CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12" />Abishai za na mma va̱ yi ɗa Zeruya una ta̱ a̱za̱ a̱ Edom ukpakukupa kupa nu ukpakukupa kunla̱ (18,000) uba̱ta̱ wu Uka̱ri wa Akpaɗi.<note caller="+" style="f"><char style="fr" closed="false">18:12 </char><char style="ft" closed="false">Ka̱lyuwa̱: Ica 60 Aciya Adanshi.</char></note> <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" />Da̱wuda suwa ta̱ uba̱ta̱ wa̱ a̱soja a̱tsuma̱ a Edom, a̱vu a̱za̱ a̱ Edom o o'wo agbashi a̱ yi suru. A̱sulazuva a ca ta̱ Da̱wuda ulyuwu wa a aci suru uba̱ta̱ u na u 'ya̱wa̱i biti.<verse eid="1CH 18:13" /></para>
  <para style="s">Azagbain a̱ a̱soja a̱ Da̱wuda</para>
  <para style="r">(<ref loc="2SA 8:15-18">2 Sam 8:15-18</ref>; <ref loc="2SA 20:23-26">20:23-26</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14" />Da̱wuda yuwan ta̱ tsugono tsa aza a Isra'ila suru, agba u yuwusan ta̱ ili i na i ri mejege na̱ a̱ɓula̱ a̱ tyo e ekere a ama a̱ yi suru. <verse eid="1CH 18:14" /><verse number="15" style="v" sid="1CH 18:15" />Yowab za na mma va̱ yi ɗa Zeruya ɗa da̱na̱i zagbain va̱ a̱soja, Jehoshafa ulobo wa Ahilu za maɗana ma alabari, <verse eid="1CH 18:15" /><verse number="16" style="v" sid="1CH 18:16" />Saduku ulobo wa Ahitu na̱ Abimele ulobo wa Abiyata ele ɗa nan ganu na̱ Shavisha za vi iɗana. <verse eid="1CH 18:16" /><verse number="17" style="v" sid="1CH 18:17" />Benaya ulobo wa Yehoyida a̱yi ɗa zagbain va̱ a̱soja aza a Keretiya na̱ aza a Feletiya. Olobo a̱ Da̱wuda ele ɗa azagbain a na a̱ ri zuzu na̱ mogono.<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s">Da̱wuda lyuwa ta̱ aza a Amon na aza a Suriya nu uvon</para>
  <para style="r">(<ref loc="2SA 10:1-19">2 Sam 10:1-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />Ana a̱yi ndolo kotoi, a̱vu Nahash mogono ma a aza a Amon ma̱ kuwa̱, reve ulobo wa̱ a̱ yi mo o mogono o una̱ wa̱ yi. <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" />A̱vu Da̱wuda damma, &lt;&lt;N ta roco wi isa'ani aciya a Hanun ulobo wa Nahash, adama a na Dada va̱ yi roco a̱mu ta̱ isa'ani.&gt;&gt; Da̱wuda lyungu ta̱ nlingata ma̱ yi uba̱ta̱ wa Hanun tsura̱ a̱ 'ya̱wa̱ a̱ ca̱sa̱ yi na̱ wiruta̱ wa Dada va̱ yi. Amantsa ma na nlingata ma̱ Da̱wuda n ta̱wa̱i uba̱ta̱ wa Hanun a̱tsuma̱ e iɗa ya Amon a na a̱ ca̱sa̱ yi na̱ wirota̱, <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />a̱vu azagbain a Amon a damma Hanun, &lt;&lt;Vu ta majiyan Da̱wuda ta casu dada va̱ wu tsugbain hali a na u lyungu wa̱ nuwu aza a na a̱ ca̱sa̱ wu na̱ wiruta̱? Ashe ugbozu u ɗa u yuwain nda'a tsura̱ e idana lyuci tsu, waru a tawa yi utyo, na we e reve ucira u tsu adama a lyuwa tsu nu uvon shi?&gt;&gt;<verse eid="1CH 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 19:4" />Ɗaɗa Hanun remei nlingata ma̱ Da̱wuda'a a̱vu u puna le ntsuka̱ upasu u ta̱ a̱vu wu paɗa le a̱tugu o ugundo. Reve u lyawa le a̱ ka̱ra̱.<verse eid="1CH 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 19:5" />Ana a dammai Da̱wuda mogono aɗa a nda, reve u lyungu nlingata a cina ama'a, adama a na a zuwa ta̱ ama'a a uwwa wono lon. Mogono ma damma ta̱, &lt;&lt;Yi isawan Jeriko hali ntsuka̱ n ɗu n kungwa, reve i ka̱mba̱ a̱ wa̱ta̱.&gt;&gt;<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6" />Ana aza a Amon e revei o o'wo ta̱ ili yu upan e ekere a̱ Da̱wuda adama e ili i na a yuwain, reve Hanun na aza a Amon a̱ lyungu na̱ azurufa ukpakukupa kupa (1,000) adama a na o okopo a̱ a̱soja na aza a na a kumbusa ido diga Mesopotamiya nu upasu wa Ma'aka va Suriya na̱ Zoba. <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />O okopo ta̱ ikeke yi ido ukpakukupa mata'atsu na̱ ejere (32,000), oɓolo na̱ mogono ma Ma'aka oɓolo na̱ a̱soja a̱ yi. A̱vu a̱ ta̱wa̱ a̱ va̱la̱ zuzu na̱ Medeba. Reve aza a Amon o oɓoloto diga e ilyuci i le adama a na a yuwan uvon.<verse eid="1CH 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8" />Ana Da̱wuda uwwai ne a̱vu u lyungu Yowab na̱ a̱soja a na a gurai uvon suru adama a yuwan uvon ne ele. <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" />Reve aza a Amon o uta̱ a dara adama o uvon o una̱ntsu u lyuci gbain u le, ngono n na a banuyi gba a dara ta̱ ɗe agalaci adama a na a yuwan uvon.<verse eid="1CH 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10" />Ana Yowab e enei u ta yuwan uvon elime na̱ a̱ca̱pa̱, reve u ɗangula a̱soja o ro aza a na a la'a gurai uvon diga a̱tsuma̱ a ali a Isra'ila adama a yuwan uvon na aza a Suriya. <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />A̱vu u zuwa akapi a̱soja za̱la̱ tsugbain tsa Abishai mawun ma̱ a̱na̱wun ma̱ yi adama u rono le aaɗanga, avu Abishai dara le adama a na a yuwan uvon na aza a Amon. <verse eid="1CH 19:11" /><verse number="12" style="v" sid="1CH 19:12" />A̱vu Yowab damma Abishai, &lt;&lt;Na aza a Suriya a la'a ucira u va̱, to, vu ta̱wa̱ vu kamba mu, amma n na a ama a Amon a la'a ucira wa̱ wu, to, n ta̱ ta̱wa̱ n kamba wu. <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />Tsu kaɓa asuvu, tsu yuwan nla̱ngi nu ucira adama a ama a̱ tsu, na̱ lyuci va̱ A̱sula̱ a̱ tsu. Lyawa A̱sulazuva a yuwan ili i na i lobono niyi.&gt;&gt;<verse eid="1CH 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14" />Ana Yowab na̱ a̱soja a̱yi a̱ zura̱i zuzu adama e teme uvon, reve gba a̱soja a Suriya a suma elime a̱yi. <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" />Ana aza a Amon enei aza a Suriya e ilaɗi, reve ele fo a suma a̱ ma̱ka̱ka̱n ma Abishai reve a uwa a̱tsuma̱ a̱ lyuci. Ɗaɗa Yowab ka̱mba̱i Urishelima diga uba̱ta̱ o uvon na aza a Amon.<verse eid="1CH 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16" />Ana a aza a Suriya e enei a aza a Isra'ila a lyuwa le ta̱ nu uvon reve a̱ lyungu nlingata a na o uta̱a̱ aza a Suriya a na a̱ da̱na̱i upasalai wu Uɗolu wa̱ Yufiriti, na̱ Shoba zagbain va̱ a̱soja a Hadadeza za na o ronuso le aaɗanga.<verse eid="1CH 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17" />Ana a dammai Da̱wuda aɗa a nda, reve u ɓoloto a̱soja a Isra'ila suru uba̱ta̱ u ta̱, reve a pasalai Uɗolu wa̱ Urudu, a dara adama a yuwan uvon ne ele. Reve aza a Suriya e reme uvon na̱ Da̱wuda. <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" />Amma a̱soja a Suriya a sumaa ta̱ a̱soja a Isra'ila. A̱vu Da̱wuda una a̱soja a Suriya akumbi e ikeke yi ido ukpakukupa ucindere (7,000) na̱ a̱soja ana ukpakukupa amunga (40,000). Reve fo wu una Shoba yali ya̱ a̱soja a Suriya.<verse eid="1CH 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 19:19" />Ana ngono n na n ri za̱la̱ tsugono tsa Hadadeza suru e enei aza a Isra'ila a lyuwa ta̱ aci ele nu uvon, reve a zami nden n lafiya na̱ Da̱wuda, a̱vu o o'wo agbashi a̱ yi. Adama o ndolo aza a Suriya a̱ da̱shi usu a na a kamba aza a Amon waru shi.<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s">Da̱wuda lyuwa ta̱ lyuci va Raba</para>
  <para style="r">(<ref loc="2SA 12:26-31">2 Sam 12:26-31</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />Ana a'wan a̱ ka̱nda̱ruwa̱i a mantsa ma na ngono n tsu 'ya̱wa̱ uba̱ta̱ o uvon, a̱vu Da̱wuda lyungu Yowab oɓolo na a azagbain a̱ yi na̱ a̱soja a Isra'ila suru a̱ 'ya̱wa̱ uvon. O kototo ta̱ aza a Amon, a̱vu a̱ ka̱nda̱ruwa̱ lyuci va Raba nu uvon. Amma Da̱wuda gba da̱na̱ ta̱ a̱tsuma̱ a̱ Urishelima. <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" />A̱vu u foɗo okokolo o tsugono a aaci o mogono me ele. Waru ume wa̱ yi u rawa ta̱ makundatsu ma zinariya mata'atsu na̱ za ta̱, waru u ta̱ pe na atali e ikebe a̱tsuma̱ a̱ yi. Reve o oto Da̱wuda okokolo'o a aaci a̱ yi. A̱vu u pura̱ itana ya̱ a̱bunda̱ i lyuci'i. <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />A̱vu Da̱wuda uta̱a̱ ama a̱ lyuci'i, reve u zuwa le a yuwan ulinga na̱ n'inutsu nu ucira, na̱ nshe'en m ma̱ka̱pa̱, na aɓau. Ne ɗa Da̱wuda yuwain ni ilyuci ya aza a Amon suru. Reve Da̱wuda na̱ a̱soja a̱yi suru a̱ ka̱mba̱ Urishelima.<verse eid="1CH 20:3" /></para>
  <para style="s">Uvon u ro u na aza a Isra'ila a yuwain na aza a Filistiya</para>
  <para style="r">(<ref loc="2SA 21:15-22">2 Sam 21:15-22</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />Ana a̱yi ndolo kotoi, reve uvon u ro u 'yowisa̱n e ekere a aza a Filistiya na a aza a Isra'ila a̱tsuma̱ a Geza, a̱vu Sibekai vuma va Husha una Sifa umatsun wa Refaya. A̱vu o kototo aza a Filistiya.<verse eid="1CH 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5" />A̱vu uvon u ro u 'yowisa̱n e ekere a Isra'ila na aza Filistiya, a̱vu Elhanan ulobo wa Jayi una Lami mawun ma̱ a̱na̱wun ma̱ Goliya vuma va Gat, za na aaci e ibata ya̱ yi a rawai aaɗanga o uɗava.<note caller="+" style="f"><char style="fr" closed="false">20:5 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Sam 17:4-7.</char></note><verse eid="1CH 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6" />A̱vu a̱ da̱shi yuwisan uvon u ro waru a Gat. Vuma gbain ro shi ta̱ lo na akatsu a̱ ta̱li a̱ ta̱li o ukere na akatsu a̱ ta̱li a̱ ta̱li a ana, akatsu ushin na̱ a̱za̱ a̱ na̱shi suru suru. A̱yi fo limatan va Rafa ɗa. <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />A mantsa ma na u yuwayin aza a Isra'ila ulamu, a̱vu Jonata za na a̱yi ɗa ulobo wa Shimeya mawun ma̱ a̱na̱wun ma̱ Da̱wuda mo una yi.<verse eid="1CH 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8" />Ama a ta'atsu a nda a na Da̱wuda unai na ama a̱ yi, umatsun wa Rafa a ɗa diga a̱tsuma̱ a Gat.<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s">Da̱wuda kece ta̱ a̱ a̱soja a̱ yi</para>
  <para style="r">(<ref loc="2SA 24:1-25">2 Sam 24:1-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />Mekerenkesu ma̱ 'yon ta̱ nla̱ngi na a aza a Isra'ila, a̱vu u zuwa Da̱wuda kece ama a Isra'ila. <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" />A̱vu Da̱wuda damma Yowab na̱ nan yali ya̱ a̱soja,&lt;&lt;Walai i 'ya̱wa̱ i kece a aza a Isra'ila diga Biyasheba a̱ tyo Dan. A̱vu i ta̱wa̱ i ka̱mbuwa̱ mu adama a na me reve a̱bunda̱ e le.&gt;&gt;<verse eid="1CH 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3" />Amma a̱vu Yowab usu, &lt;&lt;Lyawa a̱ A̱sulazuva a̱ da̱shi doɓonu ama a̱ yi a̱bunda̱ hali ukpaku u la'a cine a̱ ri gogo. Zagbain va̱ mogono, suru nle a̱ a̱za̱ a̱ wu ɗa shi? Adama a̱ nye a ɗa zagbain va̱ cigai a na wa yuwan ili i nda? Adama a̱ nye a ɗa voo ronoo ama a Isra'ila unusu u nda?&gt;&gt;<verse eid="1CH 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4" />Amma suru na̱ ne adanshi o mogono a la'a ta̱ za va Yowab ucira, a̱vu Yowab 'yon u ka̱ra̱ uka̱nda̱ruwa̱ Isra'ila suru a̱vu u ka̱mba̱ Urishelima. <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" />A̱vu Yowab ka̱mbuwa̱ Da̱wuda a̱bunda̱ a̱soja a na u kecei: A̱tsuma̱ a Isra'ila suru a̱ da̱na̱ ta̱ na̱ a̱soja ukpakukupa udoɓonuwu nu ukpakukupa ukpaku (1,100,000) aza a na a rawai a̱ guza̱ matsun me pe'eni, oɓolo nu ukpakukupa amunga nu ukpakukupa ucindere (470,000) a̱tsuma̱ a Yahuda.<verse eid="1CH 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 21:6" />Amma Yowab zuwa pe nan Levi na̱ Banyami a̱tsuma̱ e mekece shi, adama a na u dammu u mogono u yo'ono yi shi. <verse eid="1CH 21:6" /><verse number="7" style="v" sid="1CH 21:7" />A̱sulazuva a uwwa uyo'o wi ili ya ndolo shi, a̱vu u ge'eto aza a Isra'ila.<verse eid="1CH 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 21:8" />A̱vu Da̱wuda damma A̱sula̱, &lt;&lt;N yuwan ta̱ unusu lon a na n yuwain ili i nda. Amma gogo, n ta patishi wu vu yuwaan aagbashi a̱ wu gafura vu unusu wa̱ yi. N yuwan ta̱ a̱ba̱jini a̱ tsulo.&gt;&gt;<verse eid="1CH 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9" />A̱vu A̱sulazuva a damma Gadu za na a yuwusaan Da̱wuda yindi, <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />&lt;&lt;'Ya̱wa̱ vu damma Da̱wuda,&lt;Mpa ili i na A̱sulazuva a dammai, n cawu ta̱ aɗangulu a ta'atsu. Ɗangula za ta̱ a̱tsuma̱ e le a na ma yuwan aciya a̱ wu.&gt; &gt;&gt;<verse eid="1CH 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11" />A̱vu Gadu ka̱ra̱ a̱ 'ya̱wa̱ ya̱ Da̱wuda u damma yi, &lt;&lt;Mpa ili i na A̱sulazuva a dammai, &lt;Ɗangwa za na yuwan nuwu. <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />Ko vu ɗangula a'wan a ta'atsu ambulu, ko woto ta'atsu na n'yuwatan ma̱ wu mo kototo wu na̱ matsun me pe'eni me e le, ko rana ta'atsu ma matsun me pe'eni ma̱ A̱sulazuva, na̱ mɓa̱la̱ a̱tsuma̱ e iɗa, oɓolo na̱ malingata ma̱ A̱sulazuva o kototosu suru pasu va Isra'ila.&gt; To, gogo vu yuwan majiyan vu damma mu adama a na ma̱ tsura̱ u usuwu wi ili i na ma ka̱mbuwa̱ za na lyungu numu.&gt;&gt;<verse eid="1CH 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13" />A̱vu Da̱wuda damma Gadu, &lt;&lt;N uwa ta̱ uta'atsu. Lyawa mu n riya̱ e ekere A̱sulazuva, adama a na iliyali ya̱ yi i ta̱ a̱bunda̱, amma she vu lyawa mu a na ma̱ riya̱ e ekere a ama wan.&gt;&gt;<verse eid="1CH 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14" />A̱vu A̱sulazuva a lyungu na̱ mɓa̱la̱ a̱ a̱tsuma̱ e iɗa ya Isra'ila, A̱vu ama ukpakukupa kupocindere (70,000) a̱ riya̱ a̱vu a̱ kuwa̱. <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" />A̱vu A̱sula̱ a̱ lyungu malingata a na wo o kototo Urishelima. Amma a mantsa ma na malingata'a ma̱ a̱ ri a yuwusan tsu ndolo, a̱vu A̱sulazuva e ene, reve u ɓa̱li yi adama e meleshe a̱vu u damma malingata za na da̱na̱i o kototosu wa ama'a, &lt;&lt;Urawa ta̱ ne! Vu tawa e ekere a̱ wu.&gt;&gt; Malingata ma̱ A̱sulazuva u da̱na̱ ta̱ lo mishin o osoroto a Aruna vuma va Jebusiya.<verse eid="1CH 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16" />Ana Da̱wuda 'ya̱sa̱in e esu a̱ yi zuva a̱vu we ene malingata ma̱ A̱sulazuva mishin e memere ma zuva ni iɗa, na̱ matsun me pe'eni ma̱ yi utalu o ukere wa̱ yi ucananu a̱ tyo Urishelima. Avu Dawuda oɓolo na̱ mbara, wotowu ni itana ya̱ a̱tsuma̱la̱ngu, a̱ riya̱ nu urewesu u le uka̱ɗa̱ta̱wu e iɗa. <verse eid="1CH 21:16" /><verse number="17" style="v" sid="1CH 21:17" />Avu Da̱wuda damma A̱sula̱, &lt;&lt;Ashe a̱mu ɗa n dammai e kece a̱soja o uvon shi? A̱mu ɗa za vu unusu waru za na yuwain iwuya. Ele nda ili i ro i ɗa shi amma ikyon. Nye i ɗa a yuwain? A̱sulazuva a̱ A̱sula̱ a̱ va̱, lyawa ukere wa̱ wu u cipa̱ a̱mu nu u'wa wa dada va̱, amma she vu lyawa mɓa̱la̱ nda a̱tsuma̱ a ama a̱ wu wan.&gt;&gt;<verse eid="1CH 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />A̱vu malingata ma̱ A̱sulazuva ma damma Gadu, u damma Da̱wuda u ka̱ra̱ a gawan a na wa suwaa A̱sulazuva masa'a o osoroto a Aruna vuma va Jebusiya. <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" />Avu Da̱wuda ka̱ra̱ a gawan nu udammu u na Gadu dammai na aala a̱ A̱sulazuva. <verse eid="1CH 21:19" /><verse number="20" style="v" sid="1CH 21:20" />A mantsa ma na Aruna da̱na̱i a fabusa oroci a yitabo, reve u vadala we ene malingata, olobo a̱ na̱shi a̱ yi na a̱ da̱na̱i oɓolo na̱ yi reve a suma a pa'an. <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" />Ana Da̱wuda rawai uba̱ta̱'a, ɗaɗa Aruna ka̱lyuwa̱i a̱vu we ene yi, a̱vu u lyawa o osoroto'o reve u kingyo elime a̱ Da̱wuda nu urewesu wa̱ yi a̱ tyo e iɗa.<verse eid="1CH 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22" />A̱vu Da̱wuda damma yi, &lt;&lt;Vu wina mu upasu wo o osoroto a̱ wu adama a na ma suwaa A̱sulazuva masa'a, adama a na a tawa mɓa̱la̱ a̱tsuma̱ a ama. N ciga ta̱ vu wina ma̱ yi o una̱ wi ikebe ya̱ yi.&gt;&gt;<verse eid="1CH 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23" />A̱vu Aruna damma Da̱wuda, &lt;&lt;Tara yi! Lyawa zagbain va̱ mogono ma yuwan suru ili i na i lobono niyi. Ka̱lyuwa̱, n ta ca inan adama a̱ kucci vu ukula̱tosu, na aɗanga a faba adama aɗanga no oroci a yitabo adama kucci vi ishina. Nda suru n ca wu ele ta̱.&gt;&gt;<verse eid="1CH 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24" />Amma mogono Da̱wuda usu ta̱ Aruna, &lt;&lt;Ne ɗa shi, n ta tsula uba̱ta̱'a̱ o una̱ wi ikebe ya̱ yi. Ma̱a̱ 'ya̱wa̱a̱ A̱sulazuva ni ili i na i ri za va̱ wu shi, ko waru na ma ca kucci vu ukula̱tosu vi ili i na i tara numu ili shi.&gt;&gt;<verse eid="1CH 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25" />Da̱wuda tsupa ta̱ Aruna zinariya na rawai ukunzuwu ukpakuta̱li (600) adama o uba̱ta̱'a̱. <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" />Da̱wuda suwaa ta̱ A̱sulazuva masa'a lo, a̱vu u ca kucci vu ukula̱tosu na̱ kucci muwwulai. A̱vu u yuwan avasa a̱ tyo uba̱ta̱ wa̱ A̱sulazuva, a̱vu A̱sulazuva a̱ usu yi na akina diga zuva a̱ tyo masa'a ma̱ kucci vu ukula̱tosu.<verse eid="1CH 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27" />A̱vu A̱sulazuva a yuwan adanshi na̱ malingata'a, a̱vu u ka̱mbuwa̱ matsun me pe'eni ma̱ yi a̱tsuma̱ e ibici ya̱ yi. <verse eid="1CH 21:27" /><verse number="28" style="v" sid="1CH 21:28" />A mantsa mo ndolo, ana Da̱wuda enei A̱sulazuva a̱ usu ta̱ avasa a̱ yi o osoroto a Aruna za va Jebusiya, reve u ca kucci lo uba̱ta̱'a̱. <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" />A mantsa'a Oogodo a agalaci a̱ A̱sulazuva za na Musa yuwain a̱tsumona, waru na̱ masa'a ma̱ kucci vu ukula̱tosu ma̱ da̱na̱ ta̱ uba̱ta̱ wa̱ a̱ga̱nda̱ a Gibiyon. <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />Amma Da̱wuda uwwa ta̱ wovon u na wa̱ 'ya̱wa̱ ɗe a na we ece A̱sula̱, adama a na u da̱na̱ ta̱ a uwwusa wovon u matsun me pe'eni ma malingata ma̱ A̱sulazuva.<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1" />A̱vu Da̱wuda damma, &lt;&lt;Mpa nda uba̱ta̱ u na u'wa wa̱ A̱sulazuva A̱sula̱ wuntsa yi u da̱na̱, oɓolo na̱ masa'a mo ucasu u kucci vu ukula̱tosu adama a aza a Isra'ila,&gt;&gt;<verse eid="1CH 22:1" /></para>
  <para style="s">Da̱wuda foɓo ta̱ adama o usaa wa̱ A̱a̱'isamapaɗa</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />A̱vu Da̱wuda ca udammu adama a na o ɓoloto suru omocin a na a̱ ri na̱ nden a̱tsuma̱ a Isra'ila, waru a̱tsuma̱ e le u ɗangula ta̱ aza a na a̱a̱ da̱na̱ o ɓuɓosuso atali e she'en atali adama o usaa wu u'wa wa̱ A̱sula̱. <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" />U ca le ta̱ irumu ya̱ a̱bunda̱ adama a na a yuwan ikusa yi na̱ntsu gbain uba̱ta̱ u ma'uwa ni ili i ma̱nla̱, ni irumushili aza a na a la'ai ucira u na a̱ kunzu le. <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />Agba u ta̱wa̱ ta̱ na akpata a sida aza na a la'ai ucira u na e kece le, adama a na aza a Sidon na̱ Taya a̱ ta̱wa̱ ta̱ ne ele a̱bunda̱ uba̱ta̱ wa̱ Da̱wuda.<verse eid="1CH 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5" />A̱vu Da̱wuda damma,&lt;&lt;Ulobo u va̱ Sulemanu molobo ma ɗa, ugbozu wa̱ yi koto u rawa ne'e shi, agba u'wa u na a cigai aa suwaa A̱sulazuva u ta̱ da̱na̱ mgbain lon, na ala nu ulobonu e esu nɗa suru. Adama o ndolo n ta yuwan ifoɓi adama o usa'a.&gt;&gt; Adama o ndolo a̱vu Da̱wuda yuwan ifoɓi ya̱ a̱bunda̱ kafu ukwisa̱ wa̱ yi.<verse eid="1CH 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6" />Reve u ɗe ulobo wa̱ yi Sulemanu a̱vu u damma yi u suwaa A̱sulazuva A̱sula̱ a aza a Isra'ila u'wa. <verse eid="1CH 22:6" /><verse number="7" style="v" sid="1CH 22:7" />Reve Da̱wuda damma Sulemanu, &lt;&lt;Ulobo u va̱, n da̱na̱ ta̱ na̱ a̱yi o okolo na ma suwa u'wa adama a ala a̱ A̱sulazuva A̱sula̱ a̱ va̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">22:7-10 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Sam 7:1-16; 1 Alb 17:1-14. </char></note> <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />Amma a̱vu adanshi A̱sulazuva a nda a̱ ta̱wa̱ ya̱'a̱ va̱, &lt;&lt;Vo oco ta̱ mpasa ma̱ a̱bunda̱, waru vu yuwan ta̱ uvon kpara. A̱vu ɗa za na aa suwaa mu u'wa adama a ala a̱ va̱ shi, adama a na vo oco ta̱ mpasa ma̱ a̱bunda̱ a̱ ma̱ka̱ka̱n ma̱ va̱ a̱tsuma̱ o uvaɗi. <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />Amma vu ta matsan ulobo za na wo o'wo vuma va asuvu nden na̱ wivuwun, waru n ta ca yi wivuwun e ekere a n'yuwatan ma̱ yi uba̱ta̱ suru. Aala a̱ yi a ɗa Sulemanu, waru n ta ca aza a Isra'ila asuvu nden na̱ nden n lafiya a mantsa ma̱ yi. <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />A̱yi ɗa za na aa suwaa mu u'wa adama Aala a̱ va̱. &lt;U to o'wo ulobo u va̱, a̱mu waru n to o'wo dada va̱ yi. Waru n ta̱ shuwa̱ ootogu o tsugono tsa yi a aci a aza a Isra'ila babu ukotu.&gt;<verse eid="1CH 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11" />&lt;&lt;Gogo ulobo u va̱, lyawa A̱sulazuva a̱ da̱na̱ oɓolo na̱ a̱vu, u zuwa vu tsura̱ ulyuwu we elime, lyawa vu suwa u'wa wa̱ A̱sulazuva A̱sula̱ a̱ wu, cine u dammai adama a̱ wu. <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" />Lyawa A̱sulazuva a ca wu ugbozu nu urevu a mantsa ma na u zuwa nuwu zagbain e ekere aza a Isra'ila, waru vu yuwan tsutoni na̱ Wila̱ wa̱ A̱sulazuva A̱sula̱ a̱ wu. <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />Na̱ vu yuwan tsutoni nu udammu na̱ Wila̱ u na A̱sulazuva a cayi Musa adama a aza a Isra'ila, vu ta̱ tsura̱ ulyuwu we elime. Waru vu kapanu vi isawan nu ucira. She vu uwwa wovon ko okolo a kuɗa wu wan.<note caller="+" style="f"><char style="fr" closed="false">22:13 </char><char style="ft" closed="false">Ka̱lyuwa̱: Jos 1:6-9.</char></note><verse eid="1CH 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14" />&lt;&lt;A̱tsuma̱ o usa̱n m ɓolotowo ta̱ A̱a̱'isamapaɗa a̱ A̱sulazuva ili i na i rawai ukunzuwu u zinariya ukpakukupa ukpaku (100,000), nu ukpakukupa udoɓonuwu u azurufa (1,000,000), ni irumushili ni irumu ya̱ a̱bunda̱ a aza a na a la'ai ucira u na e kece, na akpata na atali. Amma vu da̱shi ɗe a aci e le. <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />Vu ta̱ na aza a na aa yuwaan wu ulinga na̱ a̱bunda̱. Aza a na oo ɓoso wu aatali, na̱ a̱za̱ o usaa na aza a mavara, na aza a na a gurai cu'un vu ulinga vu ukere biti. <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />Vu ta̱ na̱ nruma n na maa gura ruma zinariya na̱ azurufa, ni irumushili ni irumu aza a na aa gura kece le shi. 'Yon vu reme ulinga, lyawa A̱sulazuva a̱ da̱na̱ oɓolo na̱ a̱vu.&gt;&gt;<verse eid="1CH 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17" />A̱vu Da̱wuda yuwan adanshi na azagbain a Isra'ila a kamba ulobo wa̱ yi Sulemanu. <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" />A̱vu u damma le, &lt;&lt;A̱yi A̱sulazuva A̱sula̱ a̱ ɗu u ri oɓolo na̱ a̱ɗu shi? Ashe u ca ɗu wivuwun uba̱ta̱ suru shi? Adama a na u ca ta̱ aza a na a̱ ri nden e iɗa'a e ekere a̱ va̱, waru iɗa'a A̱sulazuva na ama a̱ yi a la'a ta̱ ucira wa̱ yi. <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />Gogo i zuwa okolo a̱ ɗu na asuvu a̱ ɗu uba̱ta̱ wi izami yu ure wa̱ A̱sulazuva A̱sula̱ a̱ ɗu. A̱vu i teme usaa wa̱ a̱a̱'isa̱ adama a̱ A̱sulazuva A̱sula̱, adama i ta̱wa̱a̱ na Akpati a Nzuwulai a̱ A̱sulazuva na akwanu a Akiza a̱ tyo o u'wa u na aa suwa adama a aala a̱ A̱sulazuva.&gt;&gt;<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />A mantsa ma na Da̱wuda kutsai u da̱na̱ ta̱ na a'wan a̱bunda̱, a̱vu u katala ulobo wa̱ yi Sulemanu mogono ma Isra'ila.<note caller="+" style="f"><char style="fr" closed="false">23:1 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 1:1-40.</char></note><verse eid="1CH 23:1" /></para>
  <para style="s1">Nan Levi</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2" />A̱vu Da̱wuda ɓoloto azagbain a Isra'ila suru, na̱ nan ganu oɓolo na̱ nan Levi. <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />A̱vu e kece nan Levi aza a na a rawai a'wan mata'atsu a̱ 'ya̱wa̱ zuva, a̱vu a̱ tsura̱ ama a na a rawai ukpakukupa mata'atsu nu ukpakukupa kunla̱ (38,000). <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />A̱vu Da̱wuda damma, &lt;&lt;Ama ukpakukupa ushin nu ukpakukupa una̱shi (24,000) a̱ɗu ɗa ya̱a̱ ka̱lyuwa̱ ulinga wa̱ A̱a̱'isamapaɗa a̱ A̱sulazuva, ukpakukupa uta̱li (6,000) ele ɗa azagbain na̱ a̱za̱ o uge'etosu. <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />Ukpakukupa una̱shi (4,000) ele ɗa a̱za̱ e ipiri yu una̱ntsu, a̱vu ukpakukupa una̱shi (4,000) waru a yuwan ica a̱ tyo uba̱ta̱ wa̱ A̱sulazuva ni itana yi ishipa aza a na n foɓoi adama a yuwan ulinga u ndolo ne ele.&gt;&gt; <verse eid="1CH 23:5" /><verse number="6" style="v" sid="1CH 23:6" />A̱vu Da̱wuda ne'eshen nan Levi oɓolo oɓolo ununa olobo a̱ Levi a̱ ri, Gashon na̱ Koha na̱ Merari.<verse eid="1CH 23:6" /></para>
  <para style="s1">Aza a Gashon</para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 23:7" />Olobo a Gashon ele ɗa:</para>
  <para style="li2" vid="1CH 23:7">Ladan na̱ Shimeyi.<verse eid="1CH 23:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 23:8" />Olobo a Ladan ele ɗa:</para>
  <para style="li2" vid="1CH 23:8">Yehiyel ulobo wu ufaru na̱ Zetam na̱ Juwe ele ɗa olobo a ta'atsu suru suru.<verse eid="1CH 23:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 23:9" />Olobo a Shimeyi ele ɗa:</para>
  <para style="li2" vid="1CH 23:9">Shelomi na̱ Haziyel na̱ Haran, ele ɗa olobo a ta'atsu suru suru.</para>
  <para style="li2" vid="1CH 23:9">Ele ɗa waru azagbain a 'wa va Ladan.<verse eid="1CH 23:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 23:10" />Olobo a Shimeyi ele ɗa:</para>
  <para style="li2" vid="1CH 23:10">Yaha na̱ Zina na̱ Yewush na̱ Beriya.</para>
  <para style="li2" vid="1CH 23:10">Olobo a Shimai ele ɗa olobo a̱ na̱shi suru suru.<verse eid="1CH 23:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 23:11" />Yaha ɗa ulobo wu ufaru na̱ Ziza o tono ire. Amma Yewush na̱ Beriya a̱ ri na̱ muwun mo olobo lon shi, adama o ndolo ɗa e kece nle a̱tsuma̱ o ugundo u ta̱.<verse eid="1CH 23:11" /></para>
  <para style="s1">Aza a Koha</para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 23:12" />Olobo a Koha ele ɗa:</para>
  <para style="li2" vid="1CH 23:12">Amuram na̱ Izaha na̱ Heburon na̱ Uziye, ele ɗa olobo a̱ na̱shi suru suru.<verse eid="1CH 23:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 23:13" />Olobo a Amuram ele ɗa:</para>
  <para style="li2" vid="1CH 23:13">Haruna na̱ Musa.</para>
  <para style="li2" vid="1CH 23:13">A̱vu a tawa Haruna na̱ limatan va̱ yi, adama a tawa ili i na i la'ai akiza hali hali, na aa ca kucci a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva, na aa yuwaan yi a̱ga̱nda̱ a̱vu waru a zuwusa aba'un na aala a̱ yi hali hali.<note caller="+" style="f"><char style="fr" closed="false">23:13 </char><char style="ft" closed="false">Ka̱lyuwa̱: 28:1.</char></note><verse eid="1CH 23:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 23:14" />A̱vu e kece olobo a Musa vuma va̱ A̱sula̱ a̱tsuma̱ o ugundo wa̱ Levi.<verse eid="1CH 23:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 23:15" />Olobo a Musa ele ɗa:</para>
  <para style="li2" vid="1CH 23:15">Gashon na̱ Eliyaza.<verse eid="1CH 23:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 23:16" />Olobo a Gashon ele ɗa:</para>
  <para style="li2" vid="1CH 23:16">Shebuwe ulobo wu ufaru.<verse eid="1CH 23:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 23:17" />Olobo wa Eliyaza ele ɗa:</para>
  <para style="li2" vid="1CH 23:17">Rehabiya ɗa ulobo wu ufaru.</para>
  <para style="li2" vid="1CH 23:17">Eliyaza da̱na̱ no olobo o ro shi, amma Rehabiya da̱na̱ ta̱ no olobo a̱bunda̱ lon.<verse eid="1CH 23:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 23:18" />Olobo a Izaha ele ɗa:</para>
  <para style="li2" vid="1CH 23:18">Shelomi ɗa ulobo wu ufaru.<verse eid="1CH 23:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 23:19" />Olobo a Heburon ele ɗa:</para>
  <para style="li2" vid="1CH 23:19">Yeriya ulobo wu ufaru na̱ Amariya za va ire na̱ Yahaziyel za va ta'atsu na̱ Yokimeyam za va̱ na̱shi.<verse eid="1CH 23:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 23:20" />Olobo a Uziye ele ɗa:</para>
  <para style="li2" vid="1CH 23:20">Mika ulobo wu ufaru na̱ Ishiya za va̱ ire.<verse eid="1CH 23:20" /></para>
  <para style="s1">Aza a Merari</para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 23:21" />Olobo a Merari ele ɗa:</para>
  <para style="li2" vid="1CH 23:21">Mali na̱ Mushi.</para>
  <para style="li1" vid="1CH 23:21">Olobo a Mali ele ɗa:</para>
  <para style="li2" vid="1CH 23:21">Eliyaza na̱ Kish.<verse eid="1CH 23:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 23:22" />Eliyaza kuwa̱ ta̱ babu muwun mo olobo, muwun me esheli n ɗa goon u da̱na̱i ne ele. A̱za̱ a̱ le olobo a̱ Kish, ele ɗa a zuwa nle.<verse eid="1CH 23:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 23:23" />Olobo a̱ Mushi ele ɗa:</para>
  <para style="li2" vid="1CH 23:23">Mali na̱ Eda na̱ Yeremo, ele ɗa olobo a ta'atsu suru suru.<verse eid="1CH 23:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="1CH 23:24" />Ele nda ele ɗa olobo a̱ Levi na̱ limatan le, azagbain a na a ɗanai ala e le na̱ cine e kece nle koko'o. Aza a na a rawai a'wan ushin a gawan a na aa yuwan a̱ga̱nda̱ a̱ A̱a̱'isa̱mapaɗa a̱ A̱sulazuva.<verse eid="1CH 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 23:25" />Adama a na Da̱wuda damma ta̱, &lt;&lt;A̱sulazuva A̱sula̱ a Isra'ila, a̱ ta̱wa̱a̱ ta̱ na̱ wivuwun e ekere a ama a̱ yi, a̱vu u ta̱wa̱ a na wa̱a̱ da̱nu Urishelima hali hali. <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" />Adama o ndolo nan Levi a̱a̱ da̱shi tanu Oogodo a agalaci a̱ A̱sulazuva shi, ko itana i na a tsu yuwan ulinga ne ele a mantsa ma̱ a̱ga̱nda̱ shi.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">23:26 </char><char style="ft" closed="false">Ka̱lyuwa̱: U.Wl 10:8.</char></note> <verse eid="1CH 23:26" /><verse number="27" style="v" sid="1CH 23:27" />E ekere o udammu wu ukosu wa̱ Da̱wuda, e kece ta̱ nan Levi fo aza a na a̱ ri na a'wan ushin a gawan.<verse eid="1CH 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 23:28" />Ulinga u nan Levi a̱yi ɗa a kamba limatan va Haruna ulinga wa̱ A̱a̱'isa̱mapaɗa a̱ A̱sulazuva, a̱ ka̱lyuwusa̱ a̱tsuma̱ o u'wa na asula a̱ nge'en a̱ yi, a̱vu a̱ ka̱mba̱to itana ya akiza suru cece, na aa yuwusain linga ro suru o u'wa wa̱ A̱sula̱.<note caller="+" style="f"><char style="fr" closed="false">23:28-32 </char><char style="ft" closed="false">Ka̱lyuwa̱: Mkc 3:5-9.</char></note> <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />Ele ɗa aza a na a tsu zuwusa opopofu a akiza a apada, ni yira i lashi adama a̱ kucci vi ishina, ne emeshen a aza a na a̱ ri na̱ wolilo shi, na̱ waru uzusun nu uja̱mba̱ru u yira na̱ suru nkundatsu nna a̱a̱ kunzusu ume na̱ mgbain. <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />Usana suru a tsi isawan ta̱ o godyo, a̱vu a yuwan ica e ekere a̱ A̱sulazuva. Ne ɗa waru a tsu yuwan nu ulivu, <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />na̱ mantsa ma na suru a ca kucci vu ukula̱tosu va ashibi e ekere a̱ A̱sulazuva, na̱ A̱buki o Woto u sa'avu na̱ a̱buki a na a zuwai. A ta yuwan a̱ga̱nda̱ a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva mantsa suru cine a̱ ri a̱bunda̱ e le na̱ cine a damma nle a yuwan.<verse eid="1CH 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 23:32" />A̱vu nan Levi aa yuwan linga le wo Oogodo o Uga'asusan, na̱ a̱a̱'isa̱, waru aa kamba a̱za̱ e le olobo a Haruna, adama a̱ a̱ga̱nda̱ o u'wa wa̱ A̱sulazuva.<verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="s">Linga nan Ganu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />Apa cine e ne'eshein olobo a Haruna.</para>
  <para style="p" vid="1CH 24:1">Olobo a Haruna ele ɗa: Nadab na̱ Abihu na̱ Eliyaza na̱ Itama. <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" />Amma Nadab na̱ Abihu a̱ kuwa̱ ta̱ kafu dada le kuwa̱, agba a̱ ri no olobo shi, adama o ndolo a̱vu Eliyaza na̱ Itama a uwa ulinga u tsuganu.<note caller="+" style="f"><char style="fr" closed="false">24:2 </char><char style="ft" closed="false">Ka̱lyuwa̱: Mta̱ 10:1-2.</char></note> <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" />Ni ikambi ya Saduku ulobo wa Eliyaza na̱ Ahimele ulobo wa Itama, Da̱wuda ne'eshen ta̱ ugundo wa Haruna oɓolo oɓolo o una̱ wu ulinga u le. <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />Ana wo o'woi ugundo wa Eliyaza u shi ta̱ na azagbain a̱bunda̱ ula'awu nu ugundo wa Itama, e ne'eshen yi ta̱ tsunda: azagbain kupa na̱ a̱za̱ a̱ ta̱li wu umatsun wu u'wa wa Eliyaza, na̱ kunla̱ waru o umatsun wu u'wa wa Itama. <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />A ca ta̱ oɓolo suru ulinga wa̱ yi o una̱ u mazuwa ma agita babu roco aɗangulu, adama a na a̱ da̱na̱ ta̱ na azagbain a̱ a̱ga̱nda̱ a̱tsuma̱ o u'wa wa̱ A̱sula̱ na azagbain a̱ A̱sula̱ a̱tsuma̱ o umatsun wa Eliyaza na̱ Itama.<verse eid="1CH 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6" />A̱vu Shemaya ulobo wa Nataniya za vi iɗana vuma va̱ Levi ɗana ala e le elime o mogono na̱ azagbain: Saduku ganu, na̱ Ahimele ulobo wa Abiyata na̱ azagbain a 'wa nan ganu na̱ nan Levi. Reve a ɗangula umatsun u ta̱ diga o ugundo wa Eliyaza za ta̱ waru diga ya Itama.<verse eid="1CH 24:6" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="7" style="v" sid="1CH 24:7" />Agita o ufaru a̱ riya̱ ta̱ ya̱ Jehoyari,</para>
  <para style="li1" vid="1CH 24:7">za va ire waru ya̱ Jedaya,<verse eid="1CH 24:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 24:8" />za va ta'atsu ya Harim za̱ va̱ na̱shi ya̱ Seyorim,<verse eid="1CH 24:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 24:9" />za va tawun ya Malkiya,</para>
  <para style="li1" vid="1CH 24:9">za̱ va̱ ta̱li ya Mijamin,<verse eid="1CH 24:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 24:10" />za̱ va̱ cindere ya Hako, za̱ va̱ kunla̱ ya Abiya,<verse eid="1CH 24:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 24:11" />za̱ va̱ kucci ya̱ Jeshuwa,</para>
  <para style="li1" vid="1CH 24:11">za va kupa ya̱ Shekaniya.<verse eid="1CH 24:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 24:12" />Za va kupa na̱ za ta̱ ya̱ Eliyashi,</para>
  <para style="li1" vid="1CH 24:12">za va kupa ne ejere ya̱ Jakim,<verse eid="1CH 24:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 24:13" />za va kupa na aza a ta'atsu ya Hupa,</para>
  <para style="li1" vid="1CH 24:13">za va kupa na̱ a̱za̱ a̱ na̱shi ya̱ Jeshebe,<verse eid="1CH 24:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 24:14" />za va kupa no ozo o ton ya̱ Bilga,</para>
  <para style="li1" vid="1CH 24:14">za va kupa na̱ a̱za̱ a̱ ta̱li ya Ima,<verse eid="1CH 24:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 24:15" />za va kupa na̱ a̱za̱ e cindere ya̱ Hezi,</para>
  <para style="li1" vid="1CH 24:15">za va kupa na̱ kunla̱ ya Hapize,<verse eid="1CH 24:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 24:16" />za va kupa na̱ kuci ya̱ Petahiya,</para>
  <para style="li1" vid="1CH 24:16">za vu ushin ya̱ Jehezikel,<verse eid="1CH 24:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 24:17" />za vu ushin na̱ za ta̱ ya̱ Jakin, za vu ushin ne ejere ya Gamu,<verse eid="1CH 24:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 24:18" />za vu ushin na̱ a̱za̱ ata'atsu ya̱ Delaya,</para>
  <para style="li1" vid="1CH 24:18">za vu ushin na̱ a̱za̱ a̱ na̱shi ya Ma'aziya.<verse eid="1CH 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19" />Oɓolo suru a tara ta̱ ulinga wa̱ yi a̱tsuma̱ o u'wa wa̱ A̱sulazuva ununa akaya e le Haruna zuwaa nle, cine A̱sulazuva a̱ A̱sula̱ a Isra'ila a damma niyi.<verse eid="1CH 24:19" /></para>
  <para style="s">Akapi a nan Levi</para>
  <para style="m">
    <verse number="20" style="v" sid="1CH 24:20" />Adama a akapi o olobo a nan Levi ele ɗa:</para>
  <para style="li1" vid="1CH 24:20">diga o olobo a Amuram a̱ da̱na̱ ta̱ na̱ Shubaye,</para>
  <para style="li2" vid="1CH 24:20">diga o olobo a Shubaye a̱ da̱na̱ ta̱ na̱ Jedeyiya.<verse eid="1CH 24:20" /></para>
  <para style="li2">
    <verse number="21" style="v" sid="1CH 24:21" />Diga ya Rehabiya a̱ da̱na̱ ta̱ na̱ Ishiya ulobo wu ufaru.<verse eid="1CH 24:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 24:22" />Diga ya Izaha a̱ da̱na̱ ta̱ na̱ Shelomo,</para>
  <para style="li2" vid="1CH 24:22">diga o olobo a̱ Shelomo a̱ da̱na̱ ta̱ na̱ Jaha.<verse eid="1CH 24:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 24:23" />Olobo a Heburon ele ɗa: Yeriya za vu ufaru, na̱ Amariya za va ire na̱ Yahaziyel za va a ta'atsu na̱ Yokimeyam za̱ va̱ na̱shi.<verse eid="1CH 24:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 24:24" />Ulobo wa Uziye a̱yi ɗa: Mika,</para>
  <para style="li2" vid="1CH 24:24">diga a̱tsuma̱ o olobo a Mika a̱ da̱na̱ ta̱ na̱: Shami.<verse eid="1CH 24:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 24:25" />Mawun ma a̱na̱wun ma Mika aala a̱ yi a ɗa: Ishiya,</para>
  <para style="li2" vid="1CH 24:25">diga a̱tsuma̱ o olobo a Ishiya a̱ da̱na̱ ta̱ na̱: Zakariya.<verse eid="1CH 24:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 24:26" />Olobo a Merari ele ɗa: Mali na̱ Mushi.</para>
  <para style="li2" vid="1CH 24:26">Ulobo wa Yaziya a̱yi ɗa: Beno.<verse eid="1CH 24:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 24:27" />Olobo a Merari,</para>
  <para style="li2" vid="1CH 24:27">diga ya Yaziya a̱ da̱na̱ ta̱ na̱: Beno na̱ Shoham na̱ Zaku na̱ Ibiri.<verse eid="1CH 24:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 24:28" />Diga ya Mali a̱ da̱na̱ ta̱ na̱: Eliyaza, za na ri no olobo shi.<verse eid="1CH 24:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 24:29" />Diga ya̱ Kish a̱ da̱na̱ ta̱ na̱: Jerameyel.<verse eid="1CH 24:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 24:30" />Olobo a̱ Mushi ele ɗa: Mali na̱ Eda na̱ Yerimo.</para>
  <para style="p" vid="1CH 24:30">Ele nda ele ɗa nan Levi o una̱ u limatan le. <verse eid="1CH 24:30" /><verse number="31" style="v" sid="1CH 24:31" />Ele fo a yuwan ta̱ mazuwa ma agita ununa mmaci mu ugundo wa Haruna n yuwain, elime o Mogono Da̱wuda na̱ Saduku na̱ Ahimele na azagbain a limatan nan ganu na̱ nan Levi. A yuwan ta̱ na̱ limatan vu zakpara suru una̱ta̱ na̱ za vu zawa'a.<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s">A̱za̱ e ishipa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />Reve Da̱wuda oɓolo na̱ nan yali ya̱ a̱ a̱soja, a ɗangula ama o ro diga a̱tsuma̱ o olobo a Asaf na̱ Heman na̱ Yedutun aza a na aa yuwan adanshi e ikaka i na yaa fara o una̱ wi kumburu ni igaraya na̱ mupalu m malapa. Apa ala a aza a na a ɗangulai adama a yuwan ulinga wa̱ a̱ga̱nda̱:<verse eid="1CH 25:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 25:2" />A̱tsuma̱ o olobo a Asa ele ɗa: Zaku na̱ Isuhu na̱ Nataniya na̱ Asarela. Olobo a Asaf a̱ da̱na̱ ta̱ e ekere a Asaf, aza a na aa yuwan adanshi e ikaka i na yaa fara o una̱ wu udammu u mogono.<verse eid="1CH 25:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 25:3" />A̱tsuma̱ o olobo a Yedutun ele ɗa: Gedaliya na̱ Zeri na̱ Yeshaya na̱ Shimeyi na̱ Hashabiya na̱ Matitiya, ele ɗa ama a̱ ta̱li suru suru. A yuwan ta̱ ulinga za̱la̱ tsugbain tsa dada le Yedutun za na yuwain adanshi e ikaka yi ili i na yaa fara o una̱ wi igaraya nu ugodyusho ni ica ya̱ A̱sulazuva.<verse eid="1CH 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 25:4" />A̱tsuma̱ o olobo a Heman ele ɗa: Bukiya na̱ Mataniya na̱ Uziyel na̱ Shebuwe na̱ Yerimo na̱ Hananiya na̱ Hanani na̱ Eliyata na̱ Gidaliti na̱ Romati Eze na̱ Joshebeka na̱ Maloti na̱ Hoti na̱ Mahaziyo. <verse eid="1CH 25:4" /><verse number="5" style="v" sid="1CH 25:5" />Suru nle nda o olobo a Heman ɗa za na a yuwusaan Mogono yindi, A̱sula̱ a ca yi ta̱ olobo kupa na̱ a̱za̱ a̱ na̱shi ne esheli a ta'atsu.<verse eid="1CH 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 25:6" />Ama a nda suru a̱ da̱na̱ ta̱ za̱la̱ tsugbain tsa nan dada le adama e ishipa a̱tsuma̱ o u'wa a̱ A̱sulazuva, ulinga u le uɓolo ta̱ na̱ malapa m mupalu m malapa na̱ kumburu ni igaraya o u'wa wa̱ A̱sula̱. Asaf na̱ Yedutun na̱ Heman a̱ da̱na̱ ta̱ za̱la̱ tsugbain tsa̱ mogono. <verse eid="1CH 25:6" /><verse number="7" style="v" sid="1CH 25:7" />A̱bunda̱ a ashipi a na aa cana ishipa a̱ ma̱ka̱ka̱n ma̱ A̱sulazuva oɓolo na̱ mmaci n le aza a na o ritoyi tsuwe'e adama A̱sulazuva, ele ɗa ama ukpakure na̱ kupa kunla̱ na̱ kunla̱ (288).<verse eid="1CH 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 25:8" />Reve a yuwan matawa ma agita adama za suru da̱na̱ nu urevu wu ulinga u na waa yuwan, za ke'en na̱ zagbain, manlu na̱ mawun mo uritosu.<verse eid="1CH 25:8" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="9" style="v" sid="1CH 25:9" />Agita o ufaru, za va Asaf ɗa, waru u riya̱ ta̱ ya̱ Isuhu.</para>
  <para style="li1" vid="1CH 25:9">Za va̱ ire riya̱ ta̱ ya Gedaliya no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 25:10" />Za va ta'atsu riya̱ ta̱ ya Zaku no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 25:11" />Za va̱ na̱shi riya̱ ta̱ ya Izri no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 25:12" />Za va tawun riya̱ ta̱ ya Nataniya no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 25:13" />Za va̱ ta̱li riya̱ ta̱ ya Bukiya no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 25:14" />Za va̱ cindere riya̱ ta̱ ya Jesarela no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 25:15" />Za va̱ kunla̱ riya̱ ta̱ ya Yeshaya no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 25:16" />Za va̱ kuci riya̱ ta̱ ya Mataniya no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 25:17" />Za va kupa riya̱ ta̱ ya Shimai no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 25:18" />Za va kupa na̱ za ta̱ riya̱ ta̱ ya Azare no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 25:19" />Za va kupa ne ejere riya̱ ta̱ ya Hashabiya no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 25:20" />Za va kupa na aza ata'atsu riya̱ ta̱ ya Shubaye no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 25:21" />Za va kupa na̱ a̱za̱ a̱ na̱shi riya̱ ta̱ ya Matitiya no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 25:22" />Za va kupa no ozo o ton riya̱ ta̱ ya Jeremo no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 25:23" />Za va kupa na̱ a̱za̱ a̱ ta̱li riya̱ ta̱ ya Hananiya no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 25:24" />Za va kupa na̱ a̱za̱ e cindere riya̱ ta̱ ya Joshebeka no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 25:25" />Za va kupa na̱ kunla̱ riya̱ ta̱ ya Hanani no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 25:26" />Za va kupa na̱ kucci riya̱ ta̱ ya Maloti no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 25:27" />Za vu ushin riya̱ ta̱ ya Eliyata no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 25:28" />Za vu ushin na̱ za ta̱ riya̱ ta̱ ya̱ Hoti no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 25:29" />Za vu ushin ne ejere riya̱ ta̱ ya̱ Gidaliti no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 25:30" />Za vu ushin na aza a ta'atsu riya̱ ta̱ ya̱ Mahaziyo no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 25:31" />Za vu ushin na̱ a̱za̱ a̱ na̱shi riya̱ ta̱ ya̱ Romati Eze no o olobo a̱ yi na̱ mmaci ma̱ yi, kupa ne ejere.<verse eid="1CH 25:31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" sid="1CH 26" />
  <para style="s">A̱za̱ e ipiri yu una̱ntsu wa̱ A̱a̱'isamapaɗa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 26:1" />Apa cine e ne'eshein aza a na aa yuwan ipiri yu una̱ntsu,</para>
  <para style="b" vid="1CH 26:1" />
  <para style="li1" vid="1CH 26:1">diga nan Kora a̱yi ɗa: Meshelemiya ulobo wa Kore, za ta̱ diga o olobo a Asaf.<verse eid="1CH 26:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 26:2" />Olobo a̱ Meshelemiya ele ɗa:</para>
  <para style="li2" vid="1CH 26:2">Zakariya ulobo wu ufaru, Jediyayel za va̱ ire, Zebadiya za va ta'atsu, Jatniyel za va̱ na̱shi, <verse eid="1CH 26:2" /><verse number="3" style="v" sid="1CH 26:3" />na̱ Elam za va tawun na̱ Jehohana za va̱ ta̱li na̱ Eliyehonai za va̱ cindere.<verse eid="1CH 26:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 26:4" />Olobo o Obed Edom ele ɗa:</para>
  <para style="li2" vid="1CH 26:4">Shemaya ulobo wu ufaru na̱ Jehozaba za ve ire na̱ Yowa za va ta'atsu na̱ Saka za va̱ na̱shi na̱ Nataniya za va tawun,<note caller="+" style="f"><char style="fr" closed="false">26:4-5 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Sam 6:11; 1 Alb 13:14.</char></note> <verse eid="1CH 26:4" /><verse number="5" style="v" sid="1CH 26:5" />na̱ Amiyel za va̱ ta̱li na̱ Isaka za va̱ cindere na̱ Peleti za va̱ kunla̱. Adama na A̱sula̱ a zuwaa ta̱ Obed Edom aba'un.<verse eid="1CH 26:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 26:6" />Shemaya ulobo wu ufaru wa̱ Obed Edom matsan ta̱ olobo aza a na a̱ da̱na̱i azagbain a 'wa le adama a na a gura ta̱ uvon lon.<verse eid="1CH 26:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 26:7" />Olobo a Shemaya ele ɗa: Otini na̱ Refaya na̱ Obed na̱ Elizaba. Mmaci ma̱ yi n ɗa Elihu na̱ Semakiya ele fo ali a ɗa a na a gurai uvon lon.<verse eid="1CH 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 26:8" />Suru aza a nda limatan va̱ Obed Edom ɗa, e le na̱ muwun n le na̱ mmaci n le kupota̱li ne ejere suru suru waru a̱ da̱na̱ ta̱ nu ucira u na aa yuwan ulinga'a.<verse eid="1CH 26:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 26:9" />Meshelemiya da̱na̱ ta̱ no olobo kupa na̱ kunla̱ na̱ mmaci n na a gurai uvon lon.<verse eid="1CH 26:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 26:10" />Hosa za va Merari da̱na̱ ta̱ no olobo: Shimri ɗa za vu ufaru, ko na wo o'woi a̱yi ɗa za na a fara a matsain shi, suru na̱ ne, dada va yi ka̱mba̱to yi ta̱ za vu ufaru. <verse eid="1CH 26:10" /><verse number="11" style="v" sid="1CH 26:11" />Za ve ire a̱yi ɗa Hilikiya za va ta'atsu a̱yi ɗa Tabaliya za va̱ na̱shi a̱yi ɗa Zakariya. Olobo a Hosa na̱ mmaci ma̱ yi ele ɗa kupa na̱ aza a ta'atsu suru suru.<verse eid="1CH 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 26:12" />A̱vu e ne'eshen le a̱za̱ e ipiri yu una̱ntsu oɓolo oɓolo, o una̱ wa azagbain a 'wa le, aza a na a yuwan a̱ga̱nda̱ o u'wa wa̱ A̱sulazuva, cine e ne'eshein akapi a mmaci n le a̱za̱ a̱ Levi. <verse eid="1CH 26:12" /><verse number="13" style="v" sid="1CH 26:13" />A̱vu a yuwan matawa ma agita adama o una̱ntsu o una̱ wu nkaya n le, za ke'en na̱ zagbain. <verse eid="1CH 26:13" /><verse number="14" style="v" sid="1CH 26:14" />Agita o una̱ntsu wa asana a̱ riya̱ ta̱ ya̱ Shelemiya. Reve waru a vari agita adama a Zakariya ulobo wa̱ yi za na a casu a̱sa̱la̱ a sa'ani, a̱vu agita o una̱ntsu wu ugana a̱ riya̱ ya̱'a̱ yi. <verse eid="1CH 26:14" /><verse number="15" style="v" sid="1CH 26:15" />Agita o na̱ntsu wu uyagi u riya̱ ta̱ ya̱ Obed Edom, a̱vu a zuwa olobo a̱ yi e idana asula e zuwa suru. <verse eid="1CH 26:15" /><verse number="16" style="v" sid="1CH 26:16" />Agita o una̱ntsu wa̱ a̱livu o Una̱ntsu wa̱ Shaleke vu ure u na u ka̱ra̱i a agawan a̱ riya̱ ta̱ e ekere a Shufim na̱ Hosa. Avu e ne'eshen ipiri'i o una̱ u mantsa ma na a zuwai itoni itoni. <verse eid="1CH 26:16" /><verse number="17" style="v" sid="1CH 26:17" />A̱tsuma̱ o urana biti a̱ da̱na̱ ta̱ na̱ nan Levi a̱ ta̱li aza a na a yuwusan ipiri yu una̱ntsu wa asana, a̱za̱ a̱ na̱shi o upasu wu ugana, a̱za̱ a̱ na̱shi waru o upasu wu uyagi, a̱vu a zuwa ama e re re upasu wa asula e izuwa. <verse eid="1CH 26:17" /><verse number="18" style="v" sid="1CH 26:18" />Masula ma na ma̱ ri a̱ tyo a̱livu, a̱ da̱na̱ ta̱ na̱ a̱za̱ e ipiri a̱ na̱shi o ure, ama e re waru a masula'a. <verse eid="1CH 26:18" /><verse number="19" style="v" sid="1CH 26:19" />Ele nda ele ɗa oɓolo a̱ a̱za̱ e ipiri vu na̱ntsu diga a̱tsuma̱ o umatsun wa̱ a̱za̱ a̱ Kora na̱ Merari.<verse eid="1CH 26:19" /></para>
  <para style="s">Akapi a linga va̱ A̱a̱'isamapaɗa</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20" />A̱tsuma̱ a akapi a nan Levi fo, Ahiya ka̱lyuwusa̱ ta̱ uba̱ta̱ e izuwa a̱tsuma̱ o u'wa wa̱ A̱sula̱, oɓolo na̱ uba̱ta̱ wi izuwa yi itana ya Akiza i na a tawai. <verse eid="1CH 26:20" /><verse number="21" style="v" sid="1CH 26:21" />Diga o umatsun wa Ladan wu ugundo wa Gashon, Jehiyel ɗa da̱na̱i zagbain. <verse eid="1CH 26:21" /><verse number="22" style="v" sid="1CH 26:22" />Olobo a Jehiyel ele ɗa: Zetam na̱ Juwe. Ele ɗa a aza a na e idanasa asula e izuwa a̱ A̱a̱'isamapaɗa a̱ A̱sulazuva.<verse eid="1CH 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 26:23" />A̱vu waru a ca ugundo wa Amuram na̱ Izaha na̱ Heburon na̱ a̱za̱ a̱ Uziye ulinga u na a yuwan.<verse eid="1CH 26:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="1CH 26:24" />Diga a̱tsuma̱ o ugundo wa Gashon ulobo wa̱ Musa a̱ da̱na̱ ta̱ na̱ Shebuwe. A̱yi ɗa zagbain na e idanasa asula e izuwa. <verse eid="1CH 26:24" /><verse number="25" style="v" sid="1CH 26:25" />Mmaci ma̱ yi e ekere Eliyaza ele ɗa: Rehabiya na̱ Jeshaya na̱ Joram na̱ Zikiri na̱ Shelomi. <verse eid="1CH 26:25" /><verse number="26" style="v" sid="1CH 26:26" />Shelomi na̱ mmaci ma̱ yi ele ɗa aza a na a̱a̱ ka̱lyuwusa̱ asula e izuwa suru e ili i na Mogono Da̱wuda tawayi A̱sula̱, na azagbain a 'wa na azagbain a nan yali o ukpakukupa kupa, na̱ nan yali o kpaku kpaku, na akapi a nan yali ya̱ a̱soja. <verse eid="1CH 26:26" /><verse number="27" style="v" sid="1CH 26:27" />Diga a̱tsuma̱ e ili i na a̱ pura̱i uba̱ta̱ wu uvon, a̱vu a tawa le adama o ulapulu wa̱ A̱a̱'isamapaɗa a̱ A̱sulazuva. <verse eid="1CH 26:27" /><verse number="28" style="v" sid="1CH 26:28" />Suru waru ili i na Sama'ila za yindi na̱ Shawulu ulobo wa̱ Kish na̱ Abna ulobo wa̱ Ner na̱ Yowab za na mma va̱ yi ɗa Zeruya a tawai, a zuwa le ta̱ e ekere a Shelomi na̱ mmaci ma̱ yi.<verse eid="1CH 26:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 26:29" />Diga o ugundo wa Izaha, a tawa ta̱ Kenaniya no o olobo a̱ yi adama a na a yuwan tsugbain tsa a ama na̱ a̱za̱ o uge'etosu wa aza a Isra'ila.<verse eid="1CH 26:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 26:30" />Diga o ugundo wa Heburon, a tawa ta̱ Hashabiya na̱ mmaci ma̱ yi, ama ukpakukupa na̱ kupocindere (1,700) aza a na a gurai ulinga lon a aza a na a zuwai zagbain e iɗa ya̱ a̱livu wu upasu wu Uɗolu wa̱ Urudu. Ele ɗa aza a na e idanasa suru aɗa A̱sulazuva nu ulinga u mogono o upasu u ndolo. <verse eid="1CH 26:30" /><verse number="31" style="v" sid="1CH 26:31" />Diga a̱tsuma̱ o ugundo wa̱ Heburon, Yeriya ɗa zagbain le cine ucuɗuwu wu umatsun u le u ri. A̱tsuma̱ a a'wan amunga o tsugono tsa̱ Da̱wuda, e idana ta̱ alabari, reve acina ama o ugundo wa̱ Heburon diga Jaza a̱tsuma̱ e iɗa ya Giliyadu aza a na a gurai ulinga lon. <verse eid="1CH 26:31" /><verse number="32" style="v" sid="1CH 26:32" />Yeriya da̱na̱ ta̱ na̱ mmaci aza a na a gurai ulinga lon, ama ukpakukupa kupa ure nu ukpaku kupocindere (2,700), aza a na a̱ ri azagbain vu 'wa le. A̱vu Da̱wuda Mogono lyungu le a̱ 'ya̱wa̱ upasu wa asana o Uɗolu wa̱ Urudu, reve u zuwa azagbai'in azagbain vu ugundo wa̱ Roben na̱ Gadu nu uɓatsulai wu ugundo wa Manase. Ele ɗa aza a na a̱ da̱na̱ e idanasa aɗa a̱ A̱sula̱ suru na̱ za mogono.<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" sid="1CH 27" />
  <para style="s">Une'esun u nan yali ya̱ a̱soja</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 27:1" />Apa nda a̱bunda̱ aza a Isra'ila, azagbain a matsun na̱ nan yali ya̱ a̱soja o ukpakukupa kupa na̱ nan yali o ukpaku ukpaku, na azagbain e le, a aza a na a yuwayin mogono ulinga e ili i na i burai une'esun wa̱ a̱soja woto woto a̱tsuma̱ a'wan ma̱ɓula̱ oɓolo suru u ta̱ na ama ukpakukupa ushin nu ukpakukupa una̱shi (24,000).<verse eid="1CH 27:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="1CH 27:2" />O woto wu ufaru Yashobeyam ulobo wa Zabdiyel a̱yi ɗa u da̱na̱i zagbain vo oɓolo a ama ukpakukupa ushin nu ukpakukupa una̱shi (24,000). <verse eid="1CH 27:2" /><verse number="3" style="v" sid="1CH 27:3" />A̱yi diga o umatsun wa̱ Pere u ɗa, waru a̱yi ɗa u da̱na̱i zagbain vo oɓolo a̱ a̱soja e ipiri o woto wu ufaru.<verse eid="1CH 27:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 27:4" />Dodai vuma va Ahohi ɗa da̱na̱i zagbain vo oɓolo e ire, o woto wa̱ ire a̱tsuma̱ a aa'wan, Mikalo ɗa da̱na̱i yali ya̱ a̱soja yo oɓolo ama ukpakukupa ushin nu ukpakukupa una̱shi (24,000).<verse eid="1CH 27:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 27:5" />Benaya ulobo wa̱ Yehoyida ganu ɗa da̱na̱i yali vo oɓolo a ta'atsu ama ukpakukupa ushin nu ukpakukupa una̱shi (24,000). Aza a na a̱ da̱na̱i o ulinga o woto wa ta'atsu. <verse eid="1CH 27:5" /><verse number="6" style="v" sid="1CH 27:6" />Benaya vuma vu ukadu ɗa a̱tsuma̱ a ama mata'atsu waru zagbain va ama mata'atsu. Ulobo wa̱ yi Amizaba ɗa zagbain vo oɓolo'o.<verse eid="1CH 27:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 27:7" />Asahe mawun ma̱ a̱na̱wun ma̱ Yowab ɗa da̱na̱i yali ya̱ a̱soja oɓolo ama ukpakukupa ushin nu ukpakukupa una̱shi (24,000), aza a na a̱ da̱na̱i o ulinga o woto wa̱ na̱shi. Reve Zebadiya ulobo wa Asahel o o'wo zagbain o una̱ wa̱ yi.<verse eid="1CH 27:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 27:8" />Shamhu vuma va Izirahiya ɗa da̱na̱i yali ya̱ a̱soja oɓolo ama ukpakukupa ushin nu ukpakukupa una̱shi (24,000), aza a na a̱ da̱na̱i o ulinga o woto wa tawun.<verse eid="1CH 27:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 27:9" />Ira ulobo wa Ikesh vuma va Tekowa ɗa da̱na̱i yali ya̱ a̱soja oɓolo ama ukpakukupa ushin na̱ a̱za̱ a̱ na̱shi (24,000), aza a na a̱ da̱na̱i o ulinga o woto wa̱ ta̱li.<verse eid="1CH 27:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 27:10" />Helez vu ugundo wa Ifiramu vuma va̱ Pelon ɗa da̱na̱i yali ya̱ a̱soja oɓolo ama ukpakukupa ushin nu ukpakukupa una̱shi (24,000), aza a na a̱ da̱na̱i o ulinga o woto we cindere.<verse eid="1CH 27:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 27:11" />Sibekai vu ugundo wa Zera vuma va Husha ɗa da̱na̱i yali ya̱ a̱soja oɓolo ama ukpakukupa ushin nu ukpakukupa una̱shi (24,000), aza a na a̱ da̱na̱i o ulinga o woto wa̱ kunla̱.<verse eid="1CH 27:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 27:12" />Abiyeza vu ugundo wa Anato vuma va Banyami ɗa da̱na̱i yali ya̱ a̱soja oɓolo ama ukpakukupa ushin nu ukpakukupa una̱shi (24,000), aza a na a̱ da̱na̱i o ulinga o woto wa̱ kuci.<verse eid="1CH 27:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 27:13" />Maharai vu ugundo wa Zera vuma va Netofa ɗa da̱na̱i yali ya̱ a̱soja oɓolo ama ukpakukupa ushin nu ukpakukupa una̱shi (24,000), aza a na a̱ da̱na̱i o ulinga o woto wa kupa. <verse eid="1CH 27:13" /><verse number="14" style="v" sid="1CH 27:14" />Benaya vuma va̱ Piraton diga a̱tsuma̱ a Ifiramu ɗa da̱na̱i yali ya̱ a̱soja oɓolo ama ukpakukupa ushin nu ukpakukupa una̱shi (24,000), aza a na a̱ da̱na̱i o ulinga o woto wa kupa na̱ za ta̱.<verse eid="1CH 27:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 27:15" />Helda vu ugundo wa̱ Otiniye vuma va Netofa ɗa da̱na̱i yali ya̱ a̱soja oɓolo ama ukpakukupa ushin nu ukpakukupa una̱shi (24,000), aza a na a̱ da̱na̱i o ulinga o woto wa kupa ne ejere.<verse eid="1CH 27:15" /></para>
  <para style="s">Azagbain o Gundo</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 27:16" />Apa gundo va aza a Isra'ila na a azagbain ele:</para>
  <para style="b" vid="1CH 27:16" />
  <para style="li1" vid="1CH 27:16">Zagbain vu ugundo wa̱ Roben a̱yi ɗa Eliyaza ulobo wa Zikiri.</para>
  <para style="li1" vid="1CH 27:16">Zagbain vu ugundo wa Saminu a̱yi ɗa Shefatiya ulobo wa Ma'aka.<verse eid="1CH 27:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 27:17" />Zagbain vu ugundo wa̱ Levi a̱yi ɗa Hashabiya ulobo wa Kemuwe.</para>
  <para style="li1" vid="1CH 27:17">Zagbain vu ugundo wa Haruna a̱yi ɗa Saduku.<verse eid="1CH 27:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 27:18" />Zagbain vu ugundo wa Yahuda a̱yi ɗa Elihu mawun ma̱ a̱na̱wun ma̱ Da̱wuda.</para>
  <para style="li1" vid="1CH 27:18">Zagbain vu ugundo wa Isaka a̱yi ɗa Omri ulobo wa Mika'ilu.<verse eid="1CH 27:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 27:19" />Zagbain vu ugundo wa Zebulun a̱yi ɗa Ishmaya ulobo wa Obadiya.</para>
  <para style="li1" vid="1CH 27:19">Zagbain vu ugundo wa Nafutali a̱yi ɗa Yerimo ulobo wa Aziriyel.<verse eid="1CH 27:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 27:20" />Zagbain vu ugundo wa Ifiramu a̱yi ɗa Hosiya ulobo wa Azaziya.</para>
  <para style="li1" vid="1CH 27:20">Zagbain vu uɓatsulai wu ugundo wa Manase a̱yi ɗa Juwe ulobo wa Fedaya.<verse eid="1CH 27:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 27:21" />Zagbain vu uɓatsulai wu ugundo wa Manase ɗe Giliyadu, a̱yi ɗa Ido ulobo wa Zakariya.</para>
  <para style="li1" vid="1CH 27:21">Zagbain vu ugundo wa Banyami a̱yi ɗa Jasiyel ulobo wa Abna.<verse eid="1CH 27:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 27:22" />Zagbain vu ugundo wa Dan a̱yi ɗa Azare ulobo wa Yeroham.</para>
  <para style="p" vid="1CH 27:22">Ele nda ele ɗa azagbain o gundo va aza a Isra'ila.<verse eid="1CH 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23" />A mantsa ma na Da̱wuda kecei ama, u kece aza a na a̱ ka̱la̱ma̱i a'wan ushin shi, adama a na A̱sulazuva a yuwan ta̱ nzuwulai u ta zuwa ama a Isra'ila a na a yuwan a̱bunda̱ tsa̱ italyo'o ya zuva.<note caller="+" style="f"><char style="fr" closed="false">27:23 </char><char style="ft" closed="false">Ka̱lyuwa̱: Ufr 15:5; 22:17; 26:4.</char></note> <verse eid="1CH 27:23" /><verse number="24" style="v" sid="1CH 27:24" />Yowab za na mma va̱ yi ɗa Zeruya ɗa farai mekece ma ama agba u koto shi. Adama a na upan wa̱ A̱sulazuva a̱ da̱na̱i aciya a aza a Isra'ila. A̱bunda̱ e mekece'e a̱ da̱na̱ a̱tsuma̱ a aatagada o tsugono tsa̱ Mogono Da̱wuda shi.<note caller="+" style="f"><char style="fr" closed="false">27:24 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Sam 24:1-15; 1 Alb 21:1-14.</char></note><verse eid="1CH 27:24" /></para>
  <para style="s">A̱za̱ o uka̱lyuwusa̱ wu utsuru u mogono</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 27:25" />Azimawe ulobo wa Adiyel a̱yi ɗa za vu uka̱lyuwusa̱ wa asula e izuwa yi itana i mogono.</para>
  <para style="p" vid="1CH 27:25">Jonata ulobo wa Uziya a̱yi ɗa za na tsu uka̱lyuwusa̱ asula e izuwa yi itana i mogono aza a na a̱ ri e lyuci i na i ri e nge'en, na̱ ɗe e ilyuci ni ilyuci i keke'en na̱ waru saa vu ugaɗi aza a na a suwai adama a̱za̱ e ipiri.<verse eid="1CH 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 27:26" />Eziri ulobo wa Kelub a̱yi ɗa za vu uka̱lyuwusa̱ wa̱ a̱za̱ o ulinga wu uɗuma̱ u mogono.<verse eid="1CH 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 27:27" />Shimai vuma va Rama a̱yi ɗa za vu uka̱lyuwusa̱ wa̱ a̱ɗuma̱ a̱ inabi.</para>
  <para style="p" vid="1CH 27:27">Zabdi vuma va Shefam a̱yi ɗa za vu uka̱lyuwusa̱ wu uba̱ta̱ u na a zuwusa mini ma̱ inabi.<verse eid="1CH 27:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 27:28" />Ba'al Hanan vuma va Geda a̱yi ɗa za vu uka̱lyuwusa̱ vu ɗanga zetun na̱ ɗanga vu ubiri e iɗa i mugaɗi vu upasu wa̱ a̱livu.</para>
  <para style="p" vid="1CH 27:28">Yowash ɗa za na tsu ka̱lyuwusa̱ uba̱ta̱ u na a tsu zuwusa mani'in ma̱ zetun.<verse eid="1CH 27:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 27:29" />Shitirayi vuma va Sharon a̱yi ɗa u tsu ka̱lyuwusa̱ oɓolo e inan a na i ri ɗe Sharon.</para>
  <para style="p" vid="1CH 27:29">Shafa ulobo wa Adilayi a̱yi ɗa za na tsu ka̱lyuwusa̱ oɓolo e inan i na i ri ya̱a̱ a̱tsuma̱ a̱ ka̱ri.<verse eid="1CH 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 27:30" />Obi va Isma'ila a̱yi ɗa za na tsu ka̱lyuwusa̱ arakumi.</para>
  <para style="p" vid="1CH 27:30">Jedeyiya vuma va Merono a̱yi ɗa za na tsu ka̱lyuwusa̱ nloli.<verse eid="1CH 27:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 27:31" />Yazi vuma va Hagara a̱yi ɗa za na tsu ka̱lyuwusa̱ mgbele.</para>
  <para style="p" vid="1CH 27:31">Suru nle nda ele ɗa azagbain o uka̱lyuwusa̱ wi itana ya̱ Mogono Da̱wuda.<verse eid="1CH 27:31" /></para>
  <para style="s">Aza a na a casu Mogono a̱sa̱la̱</para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 27:32" />Jonata dada ke'en va̱ Da̱wuda, a̱yi ɗa za vu casu wa̱ a̱sa̱la̱, a̱yi za vu ugbozu ɗa waru za vi iɗana. Jeyiyel ulobo wa Hakimoni ɗa za na o ritosu olobo o mogono.<verse eid="1CH 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 27:33" />Ahitofe ɗa za na tsu casu ukobu u mogono a̱sa̱la̱. Hushai vuma va Arki a̱yi ɗa i'utsa̱ i mogono. <verse eid="1CH 27:33" /><verse number="34" style="v" sid="1CH 27:34" />A̱vu Yehoyida ulobo wa̱ Benaya na̱ Abiyata o o'wo o una̱ u tsugbain tsa̱ Ahitofe.</para>
  <para style="p" vid="1CH 27:34">Yowab ɗa da̱na̱i yali ya̱ a̱soja o mogono.<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" sid="1CH 28" />
  <para style="s">Da̱wuda yuwan ta̱ ifoɓi i na wa suwa A̱a̱'isamapaɗa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1" />Da̱wuda zuwa ta̱ azagbain a Isra'ila suru o ɓoloto a̱tsuma̱ a̱ Urishelima. A̱tsuma̱ e le a̱ da̱na̱ ta̱ na azagbain o gundo na̱ nan yali vo oɓolo a̱ a̱soja a na a yuwusaan mogono a̱ga̱nda̱ na̱ nan yali vu ukpakukupa kupa na̱ nan yali vu ukpaku ukpaku na azagbain a na a̱ tsu ka̱lyuwusa̱ itana ni iliyamunga i Mogono no olobo a̱ yi suru, na̱ mbara mu ukobu u mogono na ama o ukadu e iɗa'a na̱ a̱soja a na a gurai uvon suru.<verse eid="1CH 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2" />A̱vu Da̱wuda Mogono 'yon mishin e elime e le a̱vu u damma, &lt;&lt;Uwwai nda, a̱ɗu a̱za̱ a̱ va̱ na ama a̱ va̱! N tara ta̱ o okolo a̱ va̱ na masuwa u'wa u wivuwun adama a akpati a nzuwulai a̱ A̱sulazuva, waru uba̱ta̱ u na A̱sula̱ a̱ tsu a zuwa anana a̱ yi, agba n yuwan ta̱ ifoɓi i na maa suwa yi.<note caller="+" style="f"><char style="fr" closed="false">28:2 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Sam 7:1-16; 1 Alb 17:1-14.</char></note> <verse eid="1CH 28:2" /><verse number="3" style="v" sid="1CH 28:3" />Amma a̱vu A̱sula̱ a damma mu, a̱vu ɗa za na aa suwaa mu u'wa'a shi, adama a na a̱vu za vu uvon ɗa, agba vo oco ta̱ mpasa ma̱ a̱bunda̱.<verse eid="1CH 28:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 28:4" />&lt;&lt;Amma suru na̱ ne, A̱sulazuva a̱ A̱sula̱ a Isra'ila, u ɗangwa mu ta̱ a̱tsuma̱ o umatsun u tsu a na mo o'wo mogono ma Isra'ila hali hali. Waru u ɗangula ta̱ ugundo wa Yahuda u yuwan tsugono, a̱tsuma̱ o u'wa wa Yahuda u ɗangula ta̱ umatsun wa dada va̱. Waru diga a̱tsuma̱ o olobo a dada va̱ u yo'ono ta̱ A̱sulazuva a na mo o'wo mogono e ekere a aza a Isra'ila suru. <verse eid="1CH 28:4" /><verse number="5" style="v" sid="1CH 28:5" />A̱tsuma̱ o olobo a̱ va̱ suru waru, adama a na A̱sulazuva a ca mu ta̱ o olobo a̱bunda̱, reve u ɗangula Sulemanu a na wa kumba o ootogu o tsugono tsa̱ A̱sulazuva aciya aza a Isra'ila. <verse eid="1CH 28:5" /><verse number="6" style="v" sid="1CH 28:6" />A̱vu u damma mu, &lt;Ulobo wa̱ wu Sulemanu ɗa a suwaa mu u'wa nu ukowo wa̱ a̱yi, n ɗangula yi ta̱ a na wo o'wo ulobo u va̱, a̱mu waru mo o'wo dada va̱ yi. <verse eid="1CH 28:6" /><verse number="7" style="v" sid="1CH 28:7" />N nu u lyuwa e eleme a yuwusan tsutoni nu udammu u va̱ na̱ wila̱ u va̱ cine wa yuwusan gogo, n ta zuwa tsugono tsa̱ yi tsa̱ shuwa̱ hali hali.&gt;<verse eid="1CH 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8" />&lt;&lt;Adama o ndolo gogo, elime a ama a Isra'ila a nda suru no oɓolo a ama a̱ A̱sulazuva, na̱ waru e elime a̱ A̱sula̱ a̱ tsu, i toni udammu na̱ wila̱ wa̱ A̱sulazuva a̱ A̱sula̱ a̱ ɗu, adama a na ya gura usa iɗa i sa'ani i nda hali i lyawaa limatan va̱ a̱ca̱pa̱ wo o'wo le agadu hali hali.<verse eid="1CH 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9" />&lt;&lt;A̱vu waru ulobo u va̱ Sulemanu, vu reve A̱sula̱ a nkaya ma̱ wu vu yuwan yi a̱ga̱nda̱ no okolo a̱ ta̱ oɓolo nu ucigu wo okolo. Adama a na A̱sulazuva e tse ene ta̱ okolo suru, waru u reve ta̱ ifoɓi na̱ majiyan mo okolo. Amma n na̱ vu vadalaa yi ucina̱, u ta̱ gba a 'yuwan wu hali hali. <verse eid="1CH 28:9" /><verse number="10" style="v" sid="1CH 28:10" />Vu reve vu tara ta̱ ili ya nda ekere e re. A̱sulazuva a ɗangula wu ta̱ a na vaa suwaa yi A̱a̱'isamapaɗa u'wa wa̱ yi. Vu kaɓa asuvu vu yuwan ulinga'a.&gt;&gt;<verse eid="1CH 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11" />A̱vu Da̱wuda ca Sulemanu ifoɓi yu ukobu wu u'uwata wa̱ A̱a̱'isamapaɗa'a na̱ saa va̱ yi, na aza a asula e izuwa ya̱ yi na asula a zuva na asula a̱ a̱tsuma̱ nu uba̱ta̱ wa akiza u matara mo ume mo unusu. <verse eid="1CH 28:11" /><verse number="12" style="v" sid="1CH 28:12" />A̱vu u ca yi ifoɓi suru yi ili i na i ri niyi o okolo, adama o ukowo wa̱ A̱a̱'isamapaɗa a̱ A̱sulazuva na̱ suru asula a na a̱ ri uka̱nda̱ruwu na̱ yi, na adama e izuwa ya̱ A̱a̱'isamapaɗa a̱ A̱sulazuva na asula e izuwa yi itana yu une'e i na a tawayi A̱sulazuva. <verse eid="1CH 28:12" /><verse number="13" style="v" sid="1CH 28:13" />A̱vu u ca yi udammu wi ili i na waa yuwan adama a wuɓatsu u nan ganu na̱ nan Levi. Waru u damma ta̱ Sulemanu suru linga na a yuwan a̱tsuma̱ a̱ A̱a̱'isamapaɗa a̱ A̱sulazuva, oɓolo ni itana i na aa yuwan ulinga ne ele pe. <verse eid="1CH 28:13" /><verse number="14" style="v" sid="1CH 28:14" />A̱vu Da̱wuda ca a̱bunda̱ o ume u zinariya u na aa yuwan ulinga ne ele uba̱ta̱ u na a yuwan na̱ zinariya. Nu ume u azurufa vu uba̱ta̱ u na a yuwan ulinga na̱ azurufa adama a yuwan cu'un vi itana suru adama a̱ a̱ga̱nda̱. <verse eid="1CH 28:14" /><verse number="15" style="v" sid="1CH 28:15" />Nu ume u zinariya u na a yuwan ulinga na̱ a̱yi a wisawatan u zinariya vi ifitila, ni ifitila'a, nu ume u zinariya u wisawatan suru ni ifitila i le, nu ume u azurufa u wisawatan u fitila u azurufa suru ni ifitila'a, o una̱ wu ulinga u wisawatan suru. <verse eid="1CH 28:15" /><verse number="16" style="v" sid="1CH 28:16" />Nu ume wa apada a zinariya za mazuwa mo o opopofu a na a tawai, nu ume u azurufa u na a yuwan apada a azurufa. <verse eid="1CH 28:16" /><verse number="17" style="v" sid="1CH 28:17" />Nu ume u zinariya can na a yuwaan ikune ya akatsu, na akwanu na ara'atsu, nu ume u zinariya u na a yuwan aakwanu a zinariya, nu ume u azurufa u na a yuwan aakwanu a azurufa suru, <verse eid="1CH 28:17" /><verse number="18" style="v" sid="1CH 28:18" />nu ume u zinariya u na a yuwan masa'a mo ukula̱tosu wi ili i ma̱guru. Avu waru u ca Sulemanu ifoɓi i zinariya na wa yuwan ikerobobi i zinariya i na i tsu ba̱ruwa̱ evelu na a palaa Akpati a Nzuwulai a̱ A̱sulazuva. <verse eid="1CH 28:18" /><verse number="19" style="v" sid="1CH 28:19" />A̱vu Da̱wuda damma Sulemanu, &lt;&lt;Ili i nda suru n ta̱ ne ele uɗanu a na a ca numu diga e kere A̱sulazuva, waru u ca mu ta̱ urevu wi ifoɓi wi ili i nda suru.&gt;&gt;<verse eid="1CH 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20" />A̱vu Da̱wuda damma ulobo wa̱ yi Sulemanu, &lt;&lt;A̱vu de vu kapanu vi isawan nu ucira, a̱vu vu yuwan ulinga'a. She vu uwwa wovon wan gba vu kuɗa okolo wan, adama a na A̱sulazuva A̱sula̱, A̱sula̱ a̱ va̱, u to oɓolo na̱ a̱vu. Waa vari wu shi, ko u 'yuwain wu shi, hali she nu ulinga wa̱ a̱ga̱nda̱ wa̱ A̱a̱'isamapaɗa a̱ A̱sulazuva o koto. <verse eid="1CH 28:20" /><verse number="21" style="v" sid="1CH 28:21" />Wuɓatsu u nan ganu na̱ nan Levi u ta̱ lo ufoɓu adama o ulinga wa̱ A̱a̱'isamapaɗa A̱sula̱, waru za na cigai na gurai ulinga wu ukere u ta kamba wu a̱tsuma̱ o ulinga'a suru. Azagbain na akapi a ama a ta yuwan tsutoni nu udammu wa̱ wu suru.&gt;&gt;<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" sid="1CH 29" />
  <para style="s">Une'e adama o usaa wa̱ A̱a̱'isamapaɗa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1" />A̱vu Mogono Da̱wuda yuwan adanshi no oɓolo a ama suru u damma, &lt;&lt;Ulobo u va̱ Sulemanu, za na A̱sula̱ a ɗangulai, mawun ma ɗa, u ri nu urevu ne'e shi. Agba ulinga'a u ta̱ a̱bunda̱ lon, adama a na A̱a̱'isamapaɗa ma nda uba̱ta̱ u na vuma a̱a̱ da̱nu ɗa shi, amma uba̱ta̱ u ɗa a na A̱sulazuva A̱sula̱ a̱ da̱na̱ kuci.<note caller="+" style="f"><char style="fr" closed="false">29:1-2 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Alb 22:5.</char></note> <verse eid="1CH 29:1" /><verse number="2" style="v" sid="1CH 29:2" />Na̱ a̱tyo o ucira u va̱ suru m ɓoloto ta̱ itana adama a̱ A̱a̱'isamapaɗa a̱ A̱sula̱ a̱ va̱. N ɓoloto ta̱ zinariya adama o ulinga u zinariya na̱ azurufa waru adama o ulinga u azurufa, na̱ rumushili adama o ulinga wu rumushili, ni irumu adama o ulinga wi irumu, na akpata adama o ulinga wa akpata. Na atali e ikebe fo, na atali onis na̱ a̱za̱ o ufoɓu na aza a na a̱ ri ni ika̱rika̱ri icu'un icu'un, waru itana i nda'a a̱ da̱na̱ ta̱ a̱bunda̱ lon. <verse eid="1CH 29:2" /><verse number="3" style="v" sid="1CH 29:3" />Babu ni ili i na n foɓoi ɗe adama o ulinga wa̱ A̱a̱'isamapaɗa a̱ A̱sula̱ a̱ va̱, n ta ca zinariya na̱ azurufa na n ri ne ele, adama a na n te e icigi ya̱ A̱a̱'isamapaɗa a̱ A̱sula̱ a̱ va̱ lon. <verse eid="1CH 29:3" /><verse number="4" style="v" sid="1CH 29:4" />N ca ta̱ zinariya va̱ aza na a la'ai ukunzuwu ukpakukupa uta'atsu (3,000) u Ofi, na̱ azurufa can ukpakukupa ucindere (7,000), adama a na a yuwan iroci i sa'ani o uɓaɓu wu u'wa, <verse eid="1CH 29:4" /><verse number="5" style="v" sid="1CH 29:5" />na adama o ulinga u zinariya na̱ azurufa adama a na a̱za̱ o ulinga wu ukere a yuwan ulinga u le suru. To, gogo za ne ɗa ri ufoɓu u na waa a ca no okolo a̱ ta̱ adama o ulinga wa̱ A̱sulazuva ana'an?&gt;&gt;<verse eid="1CH 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6" />A̱vu azagbain a 'wa, na azagbain o gundo va aza a Isra'ila, na̱ nan yali ya̱ a̱soja o ukpakukupa kupa na̱ ozo o ukpaku ukpaku, na azagbain a na e idanasa ulinga u mogono reve a ca no okolo a̱ ta̱. <verse eid="1CH 29:6" /><verse number="7" style="v" sid="1CH 29:7" />Reve a ca adama a na a yuwan ulinga wa̱ A̱a̱'isamapaɗa a̱ A̱sula̱ zinariya ukpakukupa uton (5,000) na̱ dariki ukpakukupa kupa (10,000) na̱ azurufa ukpakukupa kupa (10,000) na̱ rumushili ukpakukupa kupa nu ukpakukupa kunla̱ (18,000) ni irumu ukpakukupa ukpaku (100,000). <verse eid="1CH 29:7" /><verse number="8" style="v" sid="1CH 29:8" />Suru aza a na a̱ ri na atali e ikebe a ca le ta̱ a̱ tyo wu uba̱ta̱ wi izuwa yi itana ya̱ A̱a̱'isamapaɗa a̱ A̱sulazuva o ukere wa Yehiyel za va Gashon diga o ugundo wa̱ Levi. <verse eid="1CH 29:8" /><verse number="9" style="v" sid="1CH 29:9" />Ama'a a yuwan ta̱ ma̱za̱nga̱ ana e enei ili i na azagbain e le a cayi nu ucawu wo okolo a̱ ta̱ e ekere a̱ A̱sulazuva, Da̱wuda mogono fo yuwan ta̱ ma̱za̱nga̱ lon.<verse eid="1CH 29:9" /></para>
  <para style="s">Avasa a̱ Da̱wuda</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10" />Da̱wuda yuwaan ta̱ A̱sulazuva ica e elime oɓolo a ama suru u damma,</para>
  <para style="q1" vid="1CH 29:10">&lt;&lt;Ica za va wu ɗa A̱sulazuva, A̱sula̱ a akaya a̱ tsu Isra'ila,</para>
  <para style="q2" vid="1CH 29:10">a̱vu za va aba'un ɗa A̱sulazuva,</para>
  <para style="q2" vid="1CH 29:10">diga o ufaru a̱ tyo o ukosu!<verse eid="1CH 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 29:11" />A̱vu A̱sulazuva,</para>
  <para style="q2" vid="1CH 29:11">tsugbain nu ucira za va wu ɗa!</para>
  <para style="q1" vid="1CH 29:11">waru tsugbain ni isa'ani nu ulyuwu wa a aci za va wu ɗa,</para>
  <para style="q2" vid="1CH 29:11">adama a na suru ili na i ri zuva ni iɗa za va wu ɗa suru.</para>
  <para style="q1" vid="1CH 29:11">Waru tsugono za vu ɗa A̱sulazuva, a̱vu A̱sulazuva,</para>
  <para style="q2" vid="1CH 29:11">a̱vu ɗa za na a ca tsugbain suru a̱tsuma̱ e ili biti.<note caller="+" style="f"><char style="fr" closed="false">29:11 </char><char style="ft" closed="false">Ka̱lyuwa̱ Mat 6:13.</char></note><verse eid="1CH 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 29:12" />Utsuru na̱ tsugbain diga ya̱'a̱ wu ɗa a̱ tsu uta̱,</para>
  <para style="q2" vid="1CH 29:12">a̱vu ɗa za na a yuwusan tsugono tse ili biti.</para>
  <para style="q1" vid="1CH 29:12">O ukere wa̱ wu u ɗa ucira na̱ tsugbain tsa̱ ri,</para>
  <para style="q2" vid="1CH 29:12">a na va̱ 'ya̱sa̱n vuma vu ca yi ucira suru.<verse eid="1CH 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 29:13" />Gogo A̱sula̱ a̱ tsu,</para>
  <para style="q2" vid="1CH 29:13">tsu godyowo wu ta̱,</para>
  <para style="q2" vid="1CH 29:13">waru tsu cuwa ta̱ a̱ba̱jini a ala a̱ wu.<verse eid="1CH 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14" />&lt;&lt;Amma gogo a̱mu zane ɗa n ri, waru nan zane ɗa ama a̱ va̱, a na tsa gura ucasu no okolo a̱ ta̱ tsu nda? Adama a na suru ili biti ya̱'a̱ wu ɗa u tsu uta̱, waru diga a̱tsuma̱ o une'e u na tsu ushiyi ya̱'a̱ wu ɗa tsu ca nuwu. <verse eid="1CH 29:14" /><verse number="15" style="v" sid="1CH 29:15" />A̱tsu aza a agara a ɗa no omocin e esu a̱ wu, tsa a nkaya n tsu fo. Rana tsu a̱tsuma̱ o uvaɗi u nda tsu ululu u ɗa u ri, agba a tsa zuwa okolo ya̱'a̱ le shi. <verse eid="1CH 29:15" /><verse number="16" style="v" sid="1CH 29:16" />A̱sulazuva A̱sula̱ a̱ tsu, na̱ suru itana i na tsu ɓolotoi nda adama a na tsa suwaa wu A̱a̱'isamapaɗa adama a Aala Akiza a̱ wu, diga o ukere wa̱ wu u ɗa o uta̱i, waru suru nle a̱za̱ a̱ wu a ɗa. <verse eid="1CH 29:16" /><verse number="17" style="v" sid="1CH 29:17" />Ana wo o'woi n reve ta̱ A̱sula̱ a̱ va̱, za na tsu rito okolo a ama ɗa, agba waru vu tsu uwwa ta̱ uyo'o wi ili i na i ri mejege. Suru itana i nda n ca le ta̱ no okolo a̱ ta̱ na amayun waru fo. Agba waru gogo me ene ta̱ cine ama a casu no okolo a̱ ta̱ na̱ ma̱za̱nga̱ ununa a cayi a̱ tyo ya̱'a̱ wu. <verse eid="1CH 29:17" /><verse number="18" style="v" sid="1CH 29:18" />A̱sulazuva A̱sula̱ a nkaya n tsu Ibrahim na̱ Ishiyaku na̱ Isra'ila, lyawa vu zuwa icigi i nda a̱tsuma̱ o okolo a ama a̱ wu babu ukotu, a̱vu vu zuwa okolo e le a yuwan tsutoni na̱ a̱vu. <verse eid="1CH 29:18" /><verse number="19" style="v" sid="1CH 29:19" />Vu ca ulobo u va̱ Sulemanu uzuwu wo okolo a na wa yuwan suru ili i na vu damma niyi, a na wa yuwan tsutoni na̱ a̱vu na̱ wila̱ wa̱ wu na̱ cine wa yuwan suru biti a na wa suwa A̱a̱'isamapaɗa ni itana i na n foɓoi ɗe nda.&gt;&gt;<verse eid="1CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20" />A̱vu Da̱wuda damma oɓolo ama'a suru, &lt;&lt;I cuwan A̱sulazuva A̱sula̱ a̱ɗu.&gt;&gt;Reve ama suru a cuwa A̱sulazuva a̱ A̱sula̱ a nkaya n le. A̱vu a̱ kingyo o von e iɗa ma̱kpa̱ɓa̱ elime a̱ A̱sulazuva na̱ mogono.<verse eid="1CH 29:20" /></para>
  <para style="s">Sulemanu wo o'wo ta̱ Mogono</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21" />Ana usana u tawai a̱vu a ca kucci na̱ kucci vu ukula̱tosu a̱ tyo uba̱ta̱ wa̱ A̱sulazuva vo ogono e inan ukpakukupa (1,000), ni ikyon ukpakukupa (1,000), na̱ mukyokyon ukpakukupa (1,000), oɓolo na̱ kucci vu ukula̱tosu vi ili yo oso e le, na akapi a̱ kucci va̱ a̱bunda̱ vu ukula̱tosu wa̱ a̱bunda̱ aza a na a yuwain adama ama a Isra'ila suru. <verse eid="1CH 29:21" /><verse number="22" style="v" sid="1CH 29:22" />Reve a lyuwa o osowo na̱ ma̱za̱nga̱ ma̱ a̱bunda̱ uba̱ta̱ wa̱ A̱sulazuva o urana u ndolo.</para>
  <para style="p" vid="1CH 29:22">A̱vu a̱ da̱shi zuwa Sulemanu ulobo wa̱ Da̱wuda da̱shi wo o'wo mogono me e le wa̱ ire, a̱vu a̱ tsuwa̱a̱n yi mani'in wo o'wo zagbain elime a̱ A̱sulazuva a na wa yuwan tsugono, na̱ Saduku waru wo o'wo ganu. <verse eid="1CH 29:22" /><verse number="23" style="v" sid="1CH 29:23" />A̱vu Sulemanu da̱nu ootogu o tsugono tsa̱ A̱sulazuva tsa̱ mogono o una̱ wa dada va̱ yi Da̱wuda. U tsura̱ ta̱ ulyuwu we elime waru aza a Isra'ila aa yuwaan yi ta̱ tsutoni suru.<note caller="+" style="f"><char style="fr" closed="false">29:23 </char><char style="ft" closed="false">Ka̱lyuwa̱: 1 Ngo 2:12.</char></note> <verse eid="1CH 29:23" /><verse number="24" style="v" sid="1CH 29:24" />Suru azagbain na̱ a̱soja o ucira na akapi o olobo o mogono Da̱wuda suru, a yuwan ta̱ akucunu a na a yuwan tsutoni na̱ mogono Sulemanu. <verse eid="1CH 29:24" /><verse number="25" style="v" sid="1CH 29:25" />A̱sulazuva a̱ 'ya̱sa̱n ta̱ Sulemanu a̱vu u ca yi ulyuwu we elime e esu aza a Isra'ila suru, reve u ca tsugono tsa̱ yi tsugbain za na la'ai suru akapi o ngono ma aza a Isra'ila a na a̱ ka̱ra̱i ɗe.<verse eid="1CH 29:25" /></para>
  <para style="s">Ukwa̱ wa̱ Da̱wuda</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26" />Da̱wuda ulobo wa̱ Yese yuwan ta̱ tsugono aciya aza a Isra'ila suru. <verse eid="1CH 29:26" /><verse number="27" style="v" sid="1CH 29:27" />U yuwan ta̱ a'wan amunga a yuwusan tsugono tsa aza a Isra'ila. A̱vu pe a̱tsuma̱ a̱ yi u yuwan tsugono tsa Heburon a'wan e cindere, reve waru u yuwan a'wan mata'atsu na aza a ta'atsu a̱tsuma̱ a̱ Urishelima.<note caller="+" style="f"><char style="fr" closed="false">29:27 </char><char style="ft" closed="false">Ka̱lyuwa̱: 2 Sam 5:4-5; 1 Alb 3:4.</char></note> <verse eid="1CH 29:27" /><verse number="28" style="v" sid="1CH 29:28" />Agba u kuwa̱ ta̱ a̱tsuma̱ a tsu kutsa ulobonu, waru wu uwwa ta̱ uyo'o u wuma wa̱ a̱yi, nu utsuru na̱ tsugbain. Ulobo wa̱ yi Sulemanu wo o'wo ta̱ mogono o una̱ wa̱ yi.<verse eid="1CH 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 29:29" />Akapi o ulinga u tsugono tsa̱ mogono Da̱wuda, diga o ufaru a̱ tyo o ukosu, a̱ da̱na̱ ta̱ uɗanu a̱tsuma̱ aatagada o ucuwusan wa Sama'ila za yindi na̱ Natan vumava̱sula̱ na̱ Gadu za yindi. <verse eid="1CH 29:29" /><verse number="30" style="v" sid="1CH 29:30" />Ucuɗuwu wa alabari'i u roco ta̱ cu'un tsugono tsa na u yuwain, nu ucira wa̱ yi, na̱ suru ili i na icina niyi na̱ Isra'ila waru, na akapi o tsugono tsa akapi e iɗa i na a̱ ri uka̱nda̱ruwu ne le suru.<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>