<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Tsishingini (tsw)</book>
  <para style="h">Shipa va̱ Sulemanu</para>
  <para style="toc3">Shp</para>
  <para style="toc2">Shipa va̱ Sulemanu</para>
  <para style="toc1">Shipa va̱ Sulemanu</para>
  <para style="mt2">Shipa va̱ Sulemanu</para>
  <para style="mt1">Shipa va̱ Sulemanu</para>
  <para style="is">Ucuɗuwu wa aatagada a nda</para>
  <para style="ip">Urevu wa aatagada a nda a̱yi ɗa ishipa i na i la'ai uyo'o a̱tsuma̱ a nshipa. Aatagada a nda a̱ ta̱ ni ishipa i na usheli nu ulobo a tsu yuwan adanshi va̱ni le adama e icigi i na aa yuwusaan aciyele. Mantsa mo ro a tsu yuwaan ta̱ adanshi a aci e le, mantsa mo ro waru a yuwan adanshi a aci n'utsa̱.</para>
  <para style="ip">Ishipa nda a ca ta̱ ucuɗuwu u le a̱ re koko'o. A ta gura tara ulobo'o a̱ yi ɗa Mogono Suleimanu na aciya̱yi. A ta gura yuwan ɗesununa̱ wa aatagada a nda she damma uro u ɗa, ana, a tara ta̱ usheli a̱ 'ya̱wa̱ o u'wa u Mogono Suleimanu, amma usheli'i u ta̱ e icigi yi za ro ɗe a̱ mpulu nle, acina ukosu mawun ma ka'a u ga'an ta̱ nu ulobo wa̱ yi wu mpulu'u. Waru a ta gura ca ucuɗuwu wa alabari a nda tsi iroci i muwwulai e ekere a̱ A̱sula̱ na ama a̱ yi, ko A̱sulazuva na ama e itoni ya̱ yi.</para>
  <para style="ip">Amma u ta gura yuwan e ɗenuna̱ wa aatagada a nda tsi ishipa za na o rocosu icigi yu ucira na̱ a̱ru'un za na ntsayi da̱na̱ ekere a vali na̱ ka. Na̱ ne suru a ta majiyan ma na a yuwain ulinga ni ishipa i nda'a uba̱ta̱ wa̱ a̱buki o lolo e iɗa ya Isra'ila ɗe nu ufaru.</para>
  <para style="ip">Amma u ta gura o'wo a yuwan ɗesununa̱ a̱tsuma̱ aatagada a nda tsi ishipa za na o rocosu icigi yu ucira na̱ a̱ru'un za na ntsayi da̱na̱ ekere a vali na̱ ka. Na̱ ne suru a ta majiyan ma na a yuwain ulinga ni ishipa i nda'a uba̱ta̱ wa̱ a̱buki o lolo e iɗa ya Isra'ila ɗe nu ufaru.</para>
  <para style="ip">Iliyamunga na̱ yipa̱lu aza a na a yuwain adanshi e le a̱tsuma̱ a aatagada a nda iroci i ɗa yi ili yi ikebe, aza a sa'ani, aza a na a zuwai a ama a yuwan majiyan mo ngono, na̱ tsugbain tsa̱ musula̱, nu u rocosu wi icigi.</para>
  <para style="ib" />
  <para style="iot">Ili i na i ri pe a̱tsuma̱ a aatagada a nda</para>
  <para style="io1">Upasu wu ufaru 1:1-2:7</para>
  <para style="io1">Upasu wa̱ ire 2:8; 3:5</para>
  <para style="io1">Upasu wa ta'atsu 3:6; 5:1</para>
  <para style="io1">Upasu wa̱ na̱shi 5:2; 6:3</para>
  <para style="io1">Upasu wa tawun 6:4-8:14</para>
  <para style="is">Shipa va̱ Sulemanu</para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />Ishipa ya̱ Sulemanu i na i la'ai uyo'o.<verse eid="SNG 1:1" /></para>
  <para style="s">Upasu wu ufaru</para>
  <para style="sp">Usheli'i u yuwan ta̱ adanshi</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2" />Lyawa vu co'omo mu nu una̱ wa̱ wu,</para>
  <para style="q2" vid="SNG 1:2">adama a na icigi ya̱ wu i la'a ta̱ masayan ma inabi uyo'o.<verse eid="SNG 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3" />Mani'in ma na vu putalai a̱ lipu va̱ wu u ta̱ na̱ ma̱guru lon,</para>
  <para style="q2" vid="SNG 1:3">aala a̱ wu a̱ ta̱ ma̱guru tsa aturare.</para>
  <para style="q2" vid="SNG 1:3">Ili yi lo shi a̱ yi ɗa i zuwai esheli a̱ ri e icigi ya̱ wu!<verse eid="SNG 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4" />Tara mu a̱ tyo ya̱'a̱ wu, lyawa tsu suma!</para>
  <para style="q2" vid="SNG 1:4">Mogono ma̱ va̱, a̱ tyo a̱tsuma̱ a aasula a̱ wu.</para>
  <para style="q1" vid="SNG 1:4">Lyawa n yuwan ma̱za̱nga̱ lon a̱tsuma̱ e icigi ya̱ wu,</para>
  <para style="q2" vid="SNG 1:4">ma uwwa mo uyo'o ma na icigi ya̱ wu i ca numu</para>
  <para style="q2" vid="SNG 1:4">u la'a ta̱ za masayan ma̱ inabi.</para>
  <para style="q1" vid="SNG 1:4">Ee, ili i ro yi lo shi a̱ yi ɗa i zuwai</para>
  <para style="q2" vid="SNG 1:4">esheli a̱ ri e icigi ya̱ wu!<verse eid="SNG 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5" />A̱ɗu esheli a̱ Urishelima,</para>
  <para style="q2" vid="SNG 1:5">ulima̱ u ɗa n ri, agba ili yi icigi!</para>
  <para style="q1" vid="SNG 1:5">A̱ɗu esheli a̱ Urishelima,</para>
  <para style="q2" vid="SNG 1:5">ulima̱ u ɗa n ri tso ogodo a Keda,</para>
  <para style="q2" vid="SNG 1:5">tsa amuna a̱ Sulemanu.<verse eid="SNG 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6" />She i yuwan mu a̱ka̱nla̱ e pere wan</para>
  <para style="q2" vid="SNG 1:6">o una̱ u na n ri ulima̱,</para>
  <para style="q2" vid="SNG 1:6">adama a na urana u ɗa u lima̱na̱to numu.</para>
  <para style="q1" vid="SNG 1:6">Muwun mo olobo ma mma va̱ a yuwan ta̱ upan na̱ a̱mu,</para>
  <para style="q2" vid="SNG 1:6">reve a zuwa mu za vu cimba vu uɗuma̱ u inabi,</para>
  <para style="q2" vid="SNG 1:6">agba n tsura̱ mantsa ma na maa lapula lipu va̱ shi.<verse eid="SNG 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7" />Damma mu, macigata ma̱ va̱</para>
  <para style="q2" vid="SNG 1:7">te ɗa vaa tara oɓolo e ikyon ya̱ wu a̱ 'ya̱wa̱ alyuna,</para>
  <para style="q2" vid="SNG 1:7">te ɗa vaa zuwa le o von e ivuwan nu urana usuɗuwa?</para>
  <para style="q1" vid="SNG 1:7">Adama a̱ nye mo o'wo ka vi igaru e izami ya̱ wu</para>
  <para style="q2" vid="SNG 1:7">a̱tsuma̱ e iliyamunga yi n'utsa̱ ma̱ wu?<verse eid="SNG 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8" />A̱vu na vu la'ai ulobonu a̱tsuma̱ a̱ma̱ci,</para>
  <para style="q2" vid="SNG 1:8">na̱ vu reve shi, to,</para>
  <para style="q2" vid="SNG 1:8">vu kuru uzuɓa̱ wi ikyon</para>
  <para style="q1" vid="SNG 1:8">vu yuwan aguɓa a̱ mugbgbele ma̱ wu</para>
  <para style="q2" vid="SNG 1:8">zuzu no ogodo a aza a aguɓa.<verse eid="SNG 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9" />Macigata ma̱ va̱,</para>
  <para style="q2" vid="SNG 1:9">ulobonu wa̱ wu u pura̱ ta̱ ugbozu u va̱</para>
  <para style="q2" vid="SNG 1:9">tsu ulobonu yi ikeke yi ido yu uvon wa̱ Firi'awuna.<verse eid="SNG 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10" />Iliyatsuvu i da̱shi ta̱ agbaguzu a̱ wu ulobonu,</para>
  <para style="q2" vid="SNG 1:10">yinlu ya̱ wu i ta̱ ni iliyinlu yi ikebe.<verse eid="SNG 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11" />Tsu ta yuwaan wu iliyinlu i zinariya</para>
  <para style="q2" vid="SNG 1:11">wukalu na̱ azurufa.<verse eid="SNG 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12" />A mantsa ma na mogono ma̱ ri a apada a̱ yi,</para>
  <para style="q2" vid="SNG 1:12">aturare a̱ va̱ a̱ tsu kpoto yi ta̱ na̱ ma̱guru.<verse eid="SNG 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13" />Ana macigata ma̱ va̱ mo voyin a̱ ma̱ka̱ka̱n ma̱ va̱</para>
  <para style="q2" vid="SNG 1:13">u yuwan ta̱ tsa̱ ma̱buhu ma̱ mur ma̱ ma̱guru</para>
  <para style="q2" vid="SNG 1:13">e memere ma agaɓa a̱ va̱.<verse eid="SNG 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14" />Macigata ma̱ va̱ ma̱ ta̱ tsa̱ a̱kutsu a̱ yipa̱lu e ekere a̱ va̱,</para>
  <para style="q2" vid="SNG 1:14">tsa̱ yipa̱lu i ma̱guru a̱tsuma̱ o uɗuma̱ u inabi a̱tsuma̱ En Gedi.<verse eid="SNG 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15" />Vu tu ulobonu macigata ma̱ va̱,</para>
  <para style="q2" vid="SNG 1:15">amayun vu tu ulobonu!</para>
  <para style="q2" vid="SNG 1:15">Esu a̱ wu a̱ ta̱ rocosu ugbozu wa̱ wu tsa aza a muɗa.<verse eid="SNG 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16" />Vu tu ulobonu lon macigata ma̱ va̱,</para>
  <para style="q2" vid="SNG 1:16">amayun vu tu ulobonu!</para>
  <para style="q1" vid="SNG 1:16">Uba̱ta̱ wu nven n tsu</para>
  <para style="q2" vid="SNG 1:16">u ta̱ tsa anlya o uta̱nu.<verse eid="SNG 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17" />Atsura o u'wa u tsu akpata a ɗanga sida a ɗa,</para>
  <para style="q2" vid="SNG 1:17">usatsa u tsu waru akpata a ɗanga fir ɗa.<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="sp">Macigata ma̱ va̱</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1" />A̱mu yipa̱lu i ɗa a̱tsumona a Sharon,</para>
  <para style="q2" vid="SNG 2:1">yipa̱lu yu uka̱ri.<verse eid="SNG 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2" />Tsa̱ yipa̱lu a̱tsuma̱ a awanda</para>
  <para style="q2" vid="SNG 2:2">ne ɗa macigata ma̱ va̱ ma̱ ri a̱tsuma̱ e esheli.<verse eid="SNG 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3" />Cine uɗanga u apulu u ri a̱tsuma̱ a ɗanga va̱ a̱rumbu</para>
  <para style="q2" vid="SNG 2:3">ne ɗa macigata ma̱ va̱ ma̱ ri a̱tsuma̱ o olobo.</para>
  <para style="q1" vid="SNG 2:3">N da̱nu ta̱ na̱ ma̱za̱nga̱ o ululu wa̱ yi,</para>
  <para style="q2" vid="SNG 2:3">muwun ma̱ yi n ta̱ peme o una̱ u va̱.<verse eid="SNG 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4" />U tara mu ta̱ a uwa a aasula o oso a masayan,</para>
  <para style="q2" vid="SNG 2:4">Icigi ya̱ yi a̱ tyo ya̱'a̱ va̱ atuta a ɗa.<verse eid="SNG 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5" />Vu gbamato mu no ogbodolu a̱ ina̱bi,</para>
  <para style="q2" vid="SNG 2:5">vu ca mu ucira na̱ apulu,</para>
  <para style="q2" vid="SNG 2:5">adama a na n ta̱ o ukwa̱ wi icigi ya̱ wu.<verse eid="SNG 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6" />Ukere wu ugula̱ wa̱ yi u ta̱ za̱la̱ va a aaci a̱ va̱,</para>
  <para style="q2" vid="SNG 2:6">ukere u sa'ani wa̱ yi waru u katala mu ta̱!<verse eid="SNG 2:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7" />Esheli a̱ Urishelima,</para>
  <para style="q2" vid="SNG 2:7">kucinayi na ala a̱ nre'on na̱ nshon mu una<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="fq" closed="false">na ala a̱ nre'on na̱ nshon mu una </char><char style="ft" closed="false">Akucunu a ɗa a na a yuwain agba a ciga e ɗe ala a̱ A̱sula̱ alanga e eteshe shi.</char></note>,</para>
  <para style="q2" vid="SNG 2:7">na ya damaton icigi i tsu shi,</para>
  <para style="q2" vid="SNG 2:7">mantsa ma na tsu ri a uwwusa uyo'o u tsu.<verse eid="SNG 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8" />Mu uwwa ta̱ uɗyo u macigata ma̱ va̱,</para>
  <para style="q2" vid="SNG 2:8">a̱ ta̱wa̱ e ilaɗi diga a nsasan,</para>
  <para style="q2" vid="SNG 2:8">u zarana ta̱ a̱ ta̱wa̱ uba̱ta̱ u va̱ diga a agaɗi.<verse eid="SNG 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9" />Macigata ma̱ va̱ ma̱ ta̱ tsa̱ mere'on</para>
  <para style="q2" vid="SNG 2:9">ko tsa mawun me meshon.</para>
  <para style="q1" vid="SNG 2:9">A̱ yi ɗa ndeɗe mishin o ucina̱ wu uɓaɓu,</para>
  <para style="q2" vid="SNG 2:9">a̱ ka̱lyuwusa̱ mu nu usowoto wu upepu,</para>
  <para style="q2" vid="SNG 2:9">a̱ ka̱lyuwusa̱ mu na̱ a̱tsuma̱ o umuna.<verse eid="SNG 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10" />Macigata ma̱ va̱ maa damma mu ta̱,</para>
  <para style="q2" vid="SNG 2:10">'Yon macigata ma̱ va̱, ta̱wa̱ oɓolo na̱ mu</para>
  <para style="q2" vid="SNG 2:10">za vu ulobonu u va̱.<verse eid="SNG 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11" />Uwwa nda, lyushi ka̱ra̱ ta̱,</para>
  <para style="q2" vid="SNG 2:11">iro'i i koto ta̱.<verse eid="SNG 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12" />Yipa̱lu yu uta̱ ta̱ o uvaɗi ma̱ɓula̱,</para>
  <para style="q2" vid="SNG 2:12">mantsa me ishipa ma rawa ta̱.</para>
  <para style="q2" vid="SNG 2:12">A ta uwwusa ɗyo muɗa e iɗa i tsu.<verse eid="SNG 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13" />Ɗanga vu biri vu uta̱a̱ ta̱ muwun n le,</para>
  <para style="q2" vid="SNG 2:13">ataci a̱ ina̱bi waru o to ɓosuso yipa̱lu,</para>
  <para style="q2" vid="SNG 2:13">a ta bazasa ma̱guru me le.</para>
  <para style="q1" vid="SNG 2:13">'Yon tsu ka̱ra̱ macigata ma̱ va̱,</para>
  <para style="q2" vid="SNG 2:13">ulobonu u va̱, vu ta̱wa̱ oɓolo na̱ mu.<verse eid="SNG 2:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14" />Muɗa ma̱ va̱,</para>
  <para style="q2" vid="SNG 2:14">ma na ma̱ ri nden a̱ a̱ba̱nu a aatali,</para>
  <para style="q2" vid="SNG 2:14">upa'un o uzuru wa atali,</para>
  <para style="q1" vid="SNG 2:14">lyawa me ene urewesu wa̱ wu.</para>
  <para style="q2" vid="SNG 2:14">Waru lyawa mu uwwa uɗyo wa̱ wu!</para>
  <para style="q1" vid="SNG 2:14">Adama a na uɗyo wa̱ wu u tu uyo'o,</para>
  <para style="q2" vid="SNG 2:14">urewesu wa̱ wu waru u tu ulobonu wa̱ a̱ka̱nla̱.<verse eid="SNG 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15" />I remee tsu musa̱n mu una,</para>
  <para style="q2" vid="SNG 2:15">musa̱n n wawa'a n na n tsu lungusa̱ a̱ɗuma̱ a̱ ina̱bi,</para>
  <para style="q2" vid="SNG 2:15">a̱ɗuma̱ a ina̱bi a̱ tsu a na o ɓosoi yipa̱lu.<verse eid="SNG 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16" />Macigata ma̱ va̱ za va̱ ɗa,</para>
  <para style="q2" vid="SNG 2:16">a̱mu waru za va̱ yi ɗa,</para>
  <para style="q2" vid="SNG 2:16">u ta aguɓa a̱tsuma̱ a̱ yipa̱lu.<verse eid="SNG 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17" />Kafu ekan o usana o uta̱,</para>
  <para style="q2" vid="SNG 2:17">reve irumbu i puwa̱a̱n,</para>
  <para style="q1" vid="SNG 2:17">macigata ma̱ va̱ vu vadala,</para>
  <para style="q2" vid="SNG 2:17">vu suma tsa̱ mere'on,</para>
  <para style="q2" vid="SNG 2:17">tsa̱ meshon zuva vu nsasan.<verse eid="SNG 2:17" /></para>
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="s">Majiyan ma ka sa'avu</para>
  <para style="p">
    <verse number="1" style="v" sid="SNG 3:1" />Na ayin a̱mu nven a̱ a̱a̱ga̱da̱ a̱ va̱,</para>
  <para style="q2" vid="SNG 3:1">n zami yi ta̱ za na asuvu a̱ va̱ a̱ ri e icigi.</para>
  <para style="q2" vid="SNG 3:1">N zami yi ta̱ agba n tsura̱ yi shi.<verse eid="SNG 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2" />N ta̱ 'yon gogo n uwa a̱tsuma̱ a̱ lyuci,</para>
  <para style="q2" vid="SNG 3:2">n kuru re re, na̱ mɓa̱nga̱ mɓa̱nga̱.</para>
  <para style="q1" vid="SNG 3:2">N zami za na asuvu a̱ va̱ a cigai.</para>
  <para style="q2" vid="SNG 3:2">N bunga̱ yi ta̱ agba me ene yi shi.<verse eid="SNG 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3" />A̱za̱ e ipiri e ene mu ta̱</para>
  <para style="q2" vid="SNG 3:3">e le a mabura a̱tsuma̱ a̱ lyuci, a̱vu me ece le,</para>
  <para style="q2" vid="SNG 3:3">&lt;&lt;Yee ene ta̱ za na asuvu a̱ va̱ a cigai?&gt;&gt;<verse eid="SNG 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4" />A jima shi a na mu kasai ne e le,</para>
  <para style="q2" vid="SNG 3:4">ɗaɗa me enei za na asuvu a̱ va̱ a cigai,</para>
  <para style="q2" vid="SNG 3:4">a̱vu n reme yi, agba n lyawa yi u ka̱ra̱ shi.</para>
  <para style="q1" vid="SNG 3:4">Hali she na n ta̱wa̱i na̱ a̱yi o u'wa wa mma va̱,</para>
  <para style="q2" vid="SNG 3:4">a aasula a za na matsan numu.<verse eid="SNG 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5" />Esheli a̱ Urishelima,</para>
  <para style="q2" vid="SNG 3:5">kucinayi na ala a̱ nre'on na̱ nshon mu una,</para>
  <para style="q2" vid="SNG 3:5">aza a na a̱ ri ulobonu wa̱ a̱ka̱nla̱ a agaɗi</para>
  <para style="q2" vid="SNG 3:5">cine a tsu yuwan akucunu na̱ A̱sula̱ o oɓolo a̱ a̱soja a zuva.</para>
  <para style="q1" vid="SNG 3:5">Kucuna yi i damma yaa damaton tsu shi,</para>
  <para style="q2" vid="SNG 3:5">mantsa ma na tsu ri a uwwusa uyo'o u tsu.<verse eid="SNG 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6" />Zane ɗa ndeɗe'e za na ri o utusa̱ a̱tsumona</para>
  <para style="q2" vid="SNG 3:6">she damma ogbodolu a̱ mikyon,</para>
  <para style="q1" vid="SNG 3:6">na̱ ma̱guru ma̱ mur na̱ aturare,</para>
  <para style="q2" vid="SNG 3:6">i na a yuwain ni itana yu ucita</para>
  <para style="q2" vid="SNG 3:6">ya aza a atsulu na awina?<verse eid="SNG 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7" />Ka̱lyuwa̱, ootogu a matara mo mogono ma̱ va̱ Sulemanu ɗa!</para>
  <para style="q2" vid="SNG 3:7">U da̱na̱ ta̱ uka̱nda̱ruwu na̱ nan yali yu uvon kupota̱li,</para>
  <para style="q2" vid="SNG 3:7">nan yali yu uvon ya Isra'ila.<verse eid="SNG 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8" />Za suru tu uguzu na̱ matsun me pe'eni,</para>
  <para style="q2" vid="SNG 3:8">nan yali o uvon ɗa,</para>
  <para style="q1" vid="SNG 3:8">za suru na̱ matsun me pe'eni a aagutsu a̱ yi,</para>
  <para style="q2" vid="SNG 3:8">ufoɓu adama meleshe ma ayin.<verse eid="SNG 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9" />Mogono Sulemanu yuwaan ta̱ aciya̱yi</para>
  <para style="q2" vid="SNG 3:9">Ootogu a matara mo mogono,</para>
  <para style="q2" vid="SNG 3:9">za na a yuwain na akpata a sa'ani a Lebanon.<verse eid="SNG 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10" />U yuwan ta̱ aɗanga a matara ma̱ yi na̱ azurufa,</para>
  <para style="q2" vid="SNG 3:10">reve a palai nu umuna u zinariya.</para>
  <para style="q2" vid="SNG 3:10">Uba̱ta̱ wu nda̱na̱ta̱ ma̱ yi waru nu ushili u ma̱ɗiya̱,</para>
  <para style="q2" vid="SNG 3:10">a̱vu e esheli a̱ Urishelima a kala yi no oroci e icigi.<verse eid="SNG 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 3:11" />Uta̱yi a̱ɗu esheli a̱ Sihiyona,</para>
  <para style="q2" vid="SNG 3:11">yee ene Mogono Sulemanu</para>
  <para style="q1" vid="SNG 3:11">wotowu no okokolo o tsugono,</para>
  <para style="q2" vid="SNG 3:11">okokolo a na mma va̱ yi katala niyi o urana u lolo va̱ yi,</para>
  <para style="q2" vid="SNG 3:11">urana u na asuvu a̱ yi a yuwain ma̱za̱nga̱.<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="sp">Ulobo'o u yuwan ta̱ adanshi</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1" />Macigata ma̱ va̱ vu tu ulobonu!</para>
  <para style="q1" vid="SNG 4:1">Esu a̱ wu a̱ ta̱ tsa za muɗa,</para>
  <para style="q2" vid="SNG 4:1">e te ikanasa a̱tsuma̱ a apalutsu.</para>
  <para style="q1" vid="SNG 4:1">A̱nji a̱ wu a̱ ta̱ cine vu revei oɓolo e mgbele</para>
  <para style="q2" vid="SNG 4:1">a̱ zurusa̱ a̱ cipa̱ a masasan ma Giliyadu.<verse eid="SNG 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2" />Anga a̱ wu a̱ tu uri cine vu revei oɓolo e ikyon</para>
  <para style="q2" vid="SNG 4:2">a na a̱ sumba̱i gogo.</para>
  <para style="q1" vid="SNG 4:2">A̱ tu ugeru suru, za na̱ mawun ma̱ a̱na̱wun ma̱ yi,</para>
  <para style="q2" vid="SNG 4:2">ko za ta̱ a̱tsuma̱ e le, u lamba za va̱ yi shi.<verse eid="SNG 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3" />Una̱ wa̱ wu u ta̱ maluwa ma̱a̱ a̱ka̱nla̱</para>
  <para style="q2" vid="SNG 4:3">she damma vu yuwaan le ta̱ yisukumishi,</para>
  <para style="q2" vid="SNG 4:3">una̱ wa̱ wu ili i maluwa i ɗa.</para>
  <para style="q1" vid="SNG 4:3">Agbaguzu a̱ wu a̱ ta̱ cece</para>
  <para style="q2" vid="SNG 4:3">she damma ucina̱ wu umatsun</para>
  <para style="q2" vid="SNG 4:3">u muwun mu uɗanga m peme.<verse eid="SNG 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4" />Yinlu yu uga'an ya̱ wu u ta̱ maluwa ma̱ a̱ka̱nla̱,</para>
  <para style="q2" vid="SNG 4:4">tsu Usaa wu Uga'an wa̱ Da̱wuda.</para>
  <para style="q1" vid="SNG 4:4">Iliyinlu yu ulobonu ya̱ wu</para>
  <para style="q2" vid="SNG 4:4">a̱ tu ugeru a̱ yinlu ya̱ wu,</para>
  <para style="q1" vid="SNG 4:4">tsa̱ a̱ra̱ga̱ ukpakukupa ugeru ugeru,</para>
  <para style="q2" vid="SNG 4:4">tsu utan u nan yali yu uvon.<verse eid="SNG 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5" />Maani ma̱ wu ma̱ ta̱ tsa̱ nre'on n re,</para>
  <para style="q2" vid="SNG 4:5">tsa̱ mpishe n mere'on</para>
  <para style="q2" vid="SNG 4:5">nna n ri a alyuna a̱tsuma̱ a̱ yipa̱lu.<verse eid="SNG 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6" />Kafu ekan o usana o uta̱,</para>
  <para style="q2" vid="SNG 4:6">reve irumbu i puwa̱a̱n,</para>
  <para style="q1" vid="SNG 4:6">n ta̱ 'ya̱wa̱ a masasan ma mur</para>
  <para style="q2" vid="SNG 4:6">na agaɗi a furenkisen.<verse eid="SNG 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7" />Vu tu ulobonu macigata ma̱ va̱,</para>
  <para style="q2" vid="SNG 4:7">ko ili i ka̱la̱ma̱ wu shi.<verse eid="SNG 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8" />Ta̱wa̱ oɓolo na̱ a̱mu diga a Lebanon, kasa'avu va̱,</para>
  <para style="q2" vid="SNG 4:8">ta̱wa̱ oɓolo na̱ a̱mu diga a Lebanon.</para>
  <para style="q1" vid="SNG 4:8">Cipa̱ diga e ncilecile ma aatali ma Amana,</para>
  <para style="q2" vid="SNG 4:8">diga zuva va Seni na̱ Hamon,</para>
  <para style="q2" vid="SNG 4:8">diga a̱ a̱ba̱nu e ikamu,</para>
  <para style="q2" vid="SNG 4:8">na̱ nsasan mu ta̱su.<verse eid="SNG 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9" />Vu reme ta̱ okolo a̱ va̱ vawun va̱, kasa'avu va̱,</para>
  <para style="q2" vid="SNG 4:9">na̱ a̱ka̱nla̱ e esu a̱ wu uta̱,</para>
  <para style="q2" vid="SNG 4:9">vu reme ta̱ okolo a̱ va̱.</para>
  <para style="q1" vid="SNG 4:9">Ni iliyinlu i ta̱ ya̱ wu,</para>
  <para style="q2" vid="SNG 4:9">vu reme ta̱ okolo a̱ va̱.<verse eid="SNG 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10" />Icigi ya̱ wu ili yu uyo'o i ɗa,</para>
  <para style="q2" vid="SNG 4:10">vawun va̱, kasa'avu va̱!</para>
  <para style="q2" vid="SNG 4:10">Icigi ya̱ wu i la'a ta̱ masayan uyo'o.</para>
  <para style="q1" vid="SNG 4:10">Ma̱guru ma aturare ma̱ wu,</para>
  <para style="q2" vid="SNG 4:10">ma la'a ta̱ cu'un ma̱guru ma aturare biti.<verse eid="SNG 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11" />A̱limu o una̱ wa̱ wu u ta̱ tse e ishiki, kasa'avu va̱,</para>
  <para style="q2" vid="SNG 4:11">uba̱ta̱ u va̱ elentsu a̱ wu maani ma ɗa ni ishiki.</para>
  <para style="q1" vid="SNG 4:11">A̱tugu a̱ wu a̱ ta̱ ma̱guru</para>
  <para style="q2" vid="SNG 4:11">tsa aturare a na a̱ ri pe atali a Lebanon.<verse eid="SNG 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12" />Vawun va̱, kasa'avu va̱,</para>
  <para style="q2" vid="SNG 4:12">vu ta̱ tsa̱ a̱a̱rumbu a na a tawai adama a̱ va̱,</para>
  <para style="q1" vid="SNG 4:12">a̱a̱rumbu a na a̱ ka̱nda̱ruwa̱i nu ukari,</para>
  <para style="q2" vid="SNG 4:12">lyusu mini na a putsayi za suru.<verse eid="SNG 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13" />E memere ma agutsu a̱ wu</para>
  <para style="q2" vid="SNG 4:13">uɗuma̱ u tu lo tsa Adini,</para>
  <para style="q1" vid="SNG 4:13">uɗuma̱ u muwun n sa'ani</para>
  <para style="q2" vid="SNG 4:13">zana ri nu uɗanga muwun m peme,</para>
  <para style="q2" vid="SNG 4:13">za vi itana i ma̱guru tsa nad na̱ lali.<verse eid="SNG 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 4:14" />Nad na̱ safron na̱ kalamu</para>
  <para style="q2" vid="SNG 4:14">na̱ sinamon na̱ cu'un vu ɗanga na ri ma̱guru suru,</para>
  <para style="q2" vid="SNG 4:14">na̱ mur na̱ alos, na̱ cu'un va aturare na la'ai ma̱guru.<verse eid="SNG 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15" />A̱vu ɗa lyusu mini a̱tsuma̱ a̱a̱rumbu,</para>
  <para style="q2" vid="SNG 4:15">oko'o a̱ mini ma na ma casu wuma,</para>
  <para style="q2" vid="SNG 4:15">mini ma na mee yeneshe diga a Lebanon.<verse eid="SNG 4:15" /></para>
  <para style="sp">Usheli'i u yuwan ta̱ adanshi</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16" />Jiwan, upepu wu ugana,</para>
  <para style="q2" vid="SNG 4:16">vu ta̱wa̱ upepu wu uyagi!</para>
  <para style="q1" vid="SNG 4:16">Vi ivula̱ a̱a̱rumbu a̱ va̱</para>
  <para style="q2" vid="SNG 4:16">ununa ma̱guru ma̱ yi ma̱a̱ kpa̱to uba̱ta̱ suru.</para>
  <para style="q1" vid="SNG 4:16">Lyawa macigata ma̱ va̱ ma̱ ta̱wa̱ a̱ a̱a̱rumbu a̱ yi,</para>
  <para style="q2" vid="SNG 4:16">u lyuwa umatsun wa̱ yi u na u la'ai uyo'o.<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="sp">Ulobo'o u yuwan ta̱ adanshi</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1" />Vawun va̱, kasa'avu va̱,</para>
  <para style="q2" vid="SNG 5:1">a̱mu ɗa nda n uwai a̱tsuma̱ a̱a̱rumbu a̱ va̱!</para>
  <para style="q1" vid="SNG 5:1">Reve m ɓoloto mur ni itana i ma̱guru i va̱,</para>
  <para style="q2" vid="SNG 5:1">o sowuso ishiki na abaji a̱ yi,</para>
  <para style="q2" vid="SNG 5:1">a̱vu fo n sowo masayan ma̱ ina̱bi ma̱ va̱ na̱ maani ma̱ va̱.</para>
  <para style="sp" vid="SNG 5:1">Esheli'i a yuwan ta̱ adanshi</para>
  <para style="q1" vid="SNG 5:1">A̱ɗu na i ri a n cigalai,</para>
  <para style="q2" vid="SNG 5:1">i lyuwa i sowo,</para>
  <para style="q2" vid="SNG 5:1">yoo o'wo usowu na̱ a̱bunda̱ e icigi i ɗu!<verse eid="SNG 5:1" /></para>
  <para style="s">Upasu wa̱ Na̱shi</para>
  <para style="sp">Usheli'i u yuwan ta̱ adanshi</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2" />N lantsa ta̱ agba okolo a̱ va̱ a̱ ta̱ wuma.</para>
  <para style="q2" vid="SNG 5:2">Uwwai! Macigata ma̱ va̱</para>
  <para style="q2" vid="SNG 5:2">ma ta gugulusa una̱ntsu.</para>
  <para style="sp" vid="SNG 5:2">Ulobo'o u yuwan ta̱ adanshi</para>
  <para style="q1" vid="SNG 5:2">&lt;&lt;Kpa̱tu'wa̱a̱ mu n uwa,</para>
  <para style="q2" vid="SNG 5:2">vawun va̱, macigata ma̱ va̱,</para>
  <para style="q2" vid="SNG 5:2">muɗa ma̱ va̱, za na ri nu unusu shi.</para>
  <para style="q1" vid="SNG 5:2">Aaci a̱ va̱ e re'we ta̱ na a'iza,</para>
  <para style="q2" vid="SNG 5:2">a̱nji a̱ va̱ na̱ a̱ta̱ni a ayin.&gt;&gt;<verse eid="SNG 5:2" /></para>
  <para style="sp">Usheli'i u yuwan ta̱ adanshi</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3" />N foɗo ta̱ ɗe itana i va̱,</para>
  <para style="q2" vid="SNG 5:3">cine moo otowiso le?</para>
  <para style="q1" vid="SNG 5:3">N sa'a ta̱ ɗe ana a̱ va̱,</para>
  <para style="q2" vid="SNG 5:3">cine tsa ɗa ma̱a̱ sukutisa̱ le?<verse eid="SNG 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4" />Macigata ma̱ va̱ ma zuwa ta̱</para>
  <para style="q2" vid="SNG 5:4">ukere u kpa̱tu'wa̱ una̱ntsu u va̱,</para>
  <para style="q1" vid="SNG 5:4">a̱vu lipu va̱ suru,</para>
  <para style="q2" vid="SNG 5:4">reme a uwwusa maluwa ma̱ yi.<verse eid="SNG 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5" />Reve n 'yon adama m kpa̱tu'wa̱a̱ macigata ma̱ va̱,</para>
  <para style="q2" vid="SNG 5:5">a̱vu ekere a̱ va̱ e reme ma̱ɗa̱wa̱ ma mani'i ma̱ mur,</para>
  <para style="q1" vid="SNG 5:5">akatsu a̱ va̱ waru a̱ ɗa̱wusa̱ mani'in,</para>
  <para style="q2" vid="SNG 5:5">a mantsa ma na n remei ukpa̱tu'wa̱ta̱ wu ukatsuwata'a.<verse eid="SNG 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6" />M kpa̱tu'wa̱a̱ ta̱ macigata ma̱ va̱ una̱ntsu,</para>
  <para style="q2" vid="SNG 5:6">agba a̱ yi ɗa nda u ka̱ra̱i ɗe!</para>
  <para style="q2" vid="SNG 5:6">Ookolo a̱ va̱ a̱ la̱nga̱ ta̱ adama o uka̱ru wa̱ yi.</para>
  <para style="q1" vid="SNG 5:6">N zami yi ta̱, agba n tsura̱ yi shi,</para>
  <para style="q2" vid="SNG 5:6">n ɗesu ta̱ aala a̱ yi,</para>
  <para style="q2" vid="SNG 5:6">agba u usu mu shi.<verse eid="SNG 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7" />A̱za̱ e ipiri a̱ lyuci'i a ga'an ta̱ na̱ mu,</para>
  <para style="q2" vid="SNG 5:7">a mantsa ma na a̱ ri a mabura ma̱ lyuci'i</para>
  <para style="q2" vid="SNG 5:7">reve a̱ ru'wa̱ mu a uwwato mu usa̱n.</para>
  <para style="q1" vid="SNG 5:7">Reve a usa apalutsu a̱ va̱,</para>
  <para style="q2" vid="SNG 5:7">e le a̱za̱ e ipiri yu ukari'i!<verse eid="SNG 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8" />Esheli a̱ Urishelima,</para>
  <para style="q2" vid="SNG 5:8">kucinaa numu i damma,</para>
  <para style="q1" vid="SNG 5:8">nna̱ yee ene macigata ma̱ va̱,</para>
  <para style="q2" vid="SNG 5:8">i damma yi n ta̱ ma̱kuwa̱ mee icigi ya̱ yi.<verse eid="SNG 5:8" /></para>
  <para style="sp">Esheli'i a yuwan ta̱ adanshi</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9" />A̱vu na vu la'ai ulobonu a̱tsuma̱ a̱ a̱ma̱ci,</para>
  <para style="q2" vid="SNG 5:9">icigi ya̱ wu i la'a ta̱ akapi a na a buwai?</para>
  <para style="q1" vid="SNG 5:9">Nye i zuwai vu ri e ipati i tsu,</para>
  <para style="q2" vid="SNG 5:9">tsu damma yi ili i na vaa uwwusa?<verse eid="SNG 5:9" /></para>
  <para style="sp">Usheli'i u yuwan ta̱ adanshi</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10" />Macigata ma̱ va̱ ma̱ tu ulobonu,</para>
  <para style="q2" vid="SNG 5:10">waru na̱ gbaga lipu,</para>
  <para style="q2" vid="SNG 5:10">za na la'ai ulobonu a̱tsuma̱ o ukpakukupa kupa (10,000).<verse eid="SNG 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11" />A̱nji a aaci a̱ yi a ta madala tsa zinariya,</para>
  <para style="q2" vid="SNG 5:11">a̱nji a̱ yi a̱ tu ulima̱ da̱n cine vu revei akakan.<verse eid="SNG 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12" />Esu a̱ yi a̱ ta̱ tsa madara,</para>
  <para style="q2" vid="SNG 5:12">tsi imuɗa i uri</para>
  <para style="q2" vid="SNG 5:12">zuzu na̱ nge'en n lyusu mini.<verse eid="SNG 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13" />Agbaguzu a̱ yi a̱ tu ulobonu</para>
  <para style="q2" vid="SNG 5:13">wa̱ a̱ka̱nla̱ tsa̱ a̱a̱rumbu,</para>
  <para style="q2" vid="SNG 5:13">a na a̱ ri tapu no ototopi e itana yu ucita.</para>
  <para style="q1" vid="SNG 5:13">Una̱ wa̱ yi u ta̱ tsa̱ yipa̱lu,</para>
  <para style="q2" vid="SNG 5:13">a̱ ɗuɗa̱wusa̱ tsa̱ mur.<verse eid="SNG 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14" />Ekere a̱ yi a̱ ta̱ tsa aɗanga a zinariya,</para>
  <para style="q2" vid="SNG 5:14">na a suraa nle atali e ikebe.</para>
  <para style="q1" vid="SNG 5:14">Lipu va̱ yi yuwan ta̱ she damma,</para>
  <para style="q2" vid="SNG 5:14">anga a agiwa a na o gboroi,</para>
  <para style="q2" vid="SNG 5:14">wukalu na atali a safaya.<verse eid="SNG 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15" />Ana a̱ yi a̱ ta̱ cine vu revei,</para>
  <para style="q2" vid="SNG 5:15">nda̱na̱ta̱ n na a yuwain na atali a onis,</para>
  <para style="q2" vid="SNG 5:15">reve a̱ shuwa̱ le e ikyun ya atsura a zinariya.</para>
  <para style="q1" vid="SNG 5:15">Iroci ya̱ yi i rotso ta̱ ulobonu wa̱ Lebanon,</para>
  <para style="q2" vid="SNG 5:15">tsu ɗanga sida na la'ai ulobonu.<verse eid="SNG 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16" />Una̱ wa̱ yi u ta̱ a̱limu,</para>
  <para style="q2" vid="SNG 5:16">suru va̱ yi ili yi icigi i ɗa!</para>
  <para style="b" vid="SNG 5:16" />
  <para style="q1" vid="SNG 5:16">A̱yi nda a̱ yi ɗa macigata ma̱ va̱,</para>
  <para style="q2" vid="SNG 5:16">waru i'utsa̱ i va̱,</para>
  <para style="q2" vid="SNG 5:16">a̱ɗu esheli a̱ Urishelima!<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="sp">Esheli'i a yuwan ta̱ adanshi</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1" />A̱vu na vu la'ai ulobonu a̱tsuma̱ a̱ a̱ma̱ci,</para>
  <para style="q2" vid="SNG 6:1">a te ɗa macigata ma̱ wu ma̱ tyoyi?</para>
  <para style="q1" vid="SNG 6:1">Ure u ne u ɗa macigata ma̱ wu ma̱ kuruyi?</para>
  <para style="q2" vid="SNG 6:1">Tsu ta kamba wu izami ya̱ yi.<verse eid="SNG 6:1" /></para>
  <para style="sp">Esheli'i a yuwan ta̱ adanshi</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2" />Macigata ma̱ va̱ ma̱ zura̱ ta̱</para>
  <para style="q2" vid="SNG 6:2">a̱ tyo a̱ a̱a̱rumbu a̱ yi,</para>
  <para style="q2" vid="SNG 6:2">uba̱ta̱ u na a̱a̱rumbu e itana yu ucita ya̱ yi i ri.</para>
  <para style="q1" vid="SNG 6:2">U ta̱ tsura̱sa̱ mawwa mo uyo'o a̱tsuma̱ a̱a̱rumbu a̱ yi,</para>
  <para style="q2" vid="SNG 6:2">o ɓolotosu yipa̱lu i na i ri ulobonu wa̱ a̱ka̱nla̱.<verse eid="SNG 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3" />Macigata ma̱ va̱ za va̱ ɗa, a̱mu waru za va̱ yi ɗa,</para>
  <para style="q2" vid="SNG 6:3">u ta guɓusa oɓolo e ikyon ya̱ yi a̱tsuma̱ a̱ yipa̱lu.<verse eid="SNG 6:3" /></para>
  <para style="s">Upasu wa tawun</para>
  <para style="sp">Ulobo'o u yuwan ta̱ adanshi</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4" />Macigata ma̱ va̱, ma̱ tu ulobonu wa̱ a̱ka̱nla̱,</para>
  <para style="q2" vid="SNG 6:4">cine vu revei Tirza,</para>
  <para style="q2" vid="SNG 6:4">ulobonu waru cine vu revei Urishelima,</para>
  <para style="q1" vid="SNG 6:4">ili i maluwa i na i tsu ju'wa̱n okolo a̱ va̱,</para>
  <para style="q2" vid="SNG 6:4">cine vu revei oɓolo a̱ a̱soja na atuta e le.<verse eid="SNG 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5" />Vu tawa e esu a̱ wu uba̱ta̱ u va̱,</para>
  <para style="q2" vid="SNG 6:5">adama a na a la'a ta̱ ucira u va̱.</para>
  <para style="q1" vid="SNG 6:5">A̱nji a̱ wu a̱ ta̱ cine vu revei oɓolo e mgbele</para>
  <para style="q2" vid="SNG 6:5">a na a̱ zurusa̱ a̱ cipa̱ a̱ tyo a Masasan ma Giliyadu.<verse eid="SNG 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6" />Anga a̱ wu a̱ tu uri puwu,</para>
  <para style="q2" vid="SNG 6:6">cine vu revei oɓolo e ikyon</para>
  <para style="q2" vid="SNG 6:6">a na a̱ za̱'wa̱i cece.</para>
  <para style="q1" vid="SNG 6:6">A̱ tu ugeru suru nle,</para>
  <para style="q2" vid="SNG 6:6">za suru na̱ mawun ma̱ a̱na̱wun ma̱ yi,</para>
  <para style="q2" vid="SNG 6:6">babu za na ri nde'en.<verse eid="SNG 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7" />Agbaguzu a̱ wu a̱ ta̱ cece</para>
  <para style="q2" vid="SNG 6:7">she damma ucina̱ wu umatsun</para>
  <para style="q2" vid="SNG 6:7">u muwun mu uɗanga m peme.<verse eid="SNG 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8" />Ko na̱ shi a damma nan egbere kupota̱li a̱ ta̱ lo,</para>
  <para style="q1" vid="SNG 6:8">na̱ a̱ma̱ci a̱ nge'en kupakunla̱,</para>
  <para style="q2" vid="SNG 6:8">oɓolo na̱ esheli a̱bunda̱ lon,</para>
  <para style="q2" vid="SNG 6:8">na aa gura kece shi,<verse eid="SNG 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9" />amma za ta̱ ɗa goon n ri e icigi,</para>
  <para style="q2" vid="SNG 6:9">waru u tu ulobonu tsa muɗa.</para>
  <para style="q1" vid="SNG 6:9">A̱yi ɗa a̱ nde'en ya mma va̱ yi,</para>
  <para style="q2" vid="SNG 6:9">za na mma va̱ yi la'a cigai.</para>
  <para style="q1" vid="SNG 6:9">Esheli e tse ene yi ta̱,</para>
  <para style="q2" vid="SNG 6:9">reve e ɗe yi za va aba'un,</para>
  <para style="q2" vid="SNG 6:9">nan egbere na̱ a̱ma̱ci a̱ nge'en a tsu ciɓalai ta̱.<verse eid="SNG 6:9" /></para>
  <para style="sp">Esheli'i a yuwan ta̱ adanshi</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10" />Zane ɗa nda'a uta̱i she damma ekan o usana,</para>
  <para style="q2" vid="SNG 6:10">ulobonu tso woto, e ikanasa tsu urana,</para>
  <para style="q2" vid="SNG 6:10">cine vu revei oɓolo a̱ a̱soja na atuta e le?<verse eid="SNG 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11" />N zura̱ ta̱ a̱ cipa̱ a̱tsuma̱ a ɗanga alumon</para>
  <para style="q2" vid="SNG 6:11">adama me ene ɗanga na ɓatsai o uka̱ri,</para>
  <para style="q1" vid="SNG 6:11">adama me ene ko ataci a̱ ina̱bi a kutsa ta̱ ɗe,</para>
  <para style="q2" vid="SNG 6:11">ko uɗanga u muwun m peme n yuwan ta̱ ɗe yipa̱lu.<verse eid="SNG 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12" />Kafu n reve,</para>
  <para style="q2" vid="SNG 6:12">majiyan me icigi ma zuwa ta̱ me ne aciya̱va̱ nden</para>
  <para style="q2" vid="SNG 6:12">oɓolo na̱ mogono e ikeke yi ido ya̱ yi.<verse eid="SNG 6:12" /></para>
  <para style="sp">Esheli'i a yuwan ta̱ adanshi</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13" />Ka̱mba̱, vu ka̱mba̱, usheli wa Shulam!</para>
  <para style="q2" vid="SNG 6:13">Vu ka̱mba̱, vu ka̱mba̱, adama tsu da̱shi ka̱lyuwa̱ wu!</para>
  <para style="sp" vid="SNG 6:13">Usheli'i u yuwan ta̱ adanshi</para>
  <para style="q1" vid="SNG 6:13">Adama a̱ nye yaa zama</para>
  <para style="q2" vid="SNG 6:13">i ka̱lyuwa̱ usheli wa Shulam,</para>
  <para style="q1" vid="SNG 6:13">a mantsa ma na u ri o uje'en</para>
  <para style="q2" vid="SNG 6:13">e memere mo ugeru ure wa̱ a̱za̱ o uje'en?<verse eid="SNG 6:13" /></para>
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="sp">Ulobo'o u yuwan ta̱ adanshi</para>
  <para style="p">
    <verse number="1" style="v" sid="SNG 7:1" />Ana a̱ wu a̱ tu ulobonu na atan,</para>
  <para style="q2" vid="SNG 7:1">usheli u mogono!</para>
  <para style="q1" vid="SNG 7:1">Cine a yuwain agutsu a̱ wu,</para>
  <para style="q2" vid="SNG 7:1">she damma atali e ikebe,</para>
  <para style="q2" vid="SNG 7:1">ulinga wu za vu ushe'en.<verse eid="SNG 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2" />Eben a̱ wu a̱ ta̱ tsa̱ yanda,</para>
  <para style="q2" vid="SNG 7:2">za na tsu lamba masayan ma inabi</para>
  <para style="q2" vid="SNG 7:2">ma na a̱ ja̱mba̱ra̱i shi.</para>
  <para style="q1" vid="SNG 7:2">A̱a̱tsuma̱ a̱ wu a̱ ta̱ tso oɓolo oroci a yitabo,</para>
  <para style="q2" vid="SNG 7:2">na a̱ ka̱nda̱ruwa̱i na̱ yipa̱lu i sa'ani ya̱ a̱ka̱nla̱.<verse eid="SNG 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3" />Agaɓa a̱ wu tsa̱ nre'on n re ɗa a̱ ri,</para>
  <para style="q2" vid="SNG 7:3">mpishe m mere'on.<verse eid="SNG 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4" />Yinlu yu uga'an ya̱ wu i tu ulobonu wa̱ a̱ka̱nla̱</para>
  <para style="q2" vid="SNG 7:4">tsu usaa u na u ri wukalu na anga a agiwa.</para>
  <para style="q1" vid="SNG 7:4">Esu a̱ wu tsa abata a Heshibon,</para>
  <para style="q2" vid="SNG 7:4">zuzu nu una̱ntsu wa Bat Rabim.</para>
  <para style="q1" vid="SNG 7:4">Vunu va̱ wu tsa atsura a Lebanon,</para>
  <para style="q2" vid="SNG 7:4">za na ri a̱ nka̱la̱la̱i na̱ Dimaska.<verse eid="SNG 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5" />Aaci a̱ wu a katala wu ta̱ okokolo</para>
  <para style="q2" vid="SNG 7:5">tsa Masasan ma Kame,</para>
  <para style="q1" vid="SNG 7:5">maɗava ma aaci ma̱ wu ma̱ ta̱ tsa̱ a̱tugu ve egbere,</para>
  <para style="q2" vid="SNG 7:5">ili i maluwa uba̱ta̱ u mogono.<verse eid="SNG 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6" />Vu tu ulobonu, macigata ma̱ va̱.</para>
  <para style="q2" vid="SNG 7:6">Vu ta zuwusa mu ma̱za̱nga̱ o ookolo.<verse eid="SNG 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7" />Uruma wa̱ wu u ta̱ tsu uɗanga u dabino,</para>
  <para style="q2" vid="SNG 7:7">agaɓa a̱ wu waru tsa̱ muwun n dabino.<verse eid="SNG 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8" />N damma ta̱, &lt;&lt;Lyawa n kumba uɗanga'a n taɓa umatsu'un.</para>
  <para style="q2" vid="SNG 7:8">Lyawa agaɓa a̱ wu o o'wo mu ataci a̱ ina̱bi,</para>
  <para style="q2" vid="SNG 7:8">wivuwun wa̱ wu waru tsa ma̱guru ma apulu.<verse eid="SNG 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 7:9" />Una̱ wa̱ wu u tu uyo'o,</para>
  <para style="q2" vid="SNG 7:9">tsa masayan ma na ma la'ai uyo'o.&gt;&gt;</para>
  <para style="sp" vid="SNG 7:9">Usheli'i u yuwan ta̱ adanshi</para>
  <para style="q1" vid="SNG 7:9">Lyawa masayan ma inabi u yene mejege</para>
  <para style="q2" vid="SNG 7:9">a̱ tyo uba̱ta̱ macigata ma̱ va̱,</para>
  <para style="q2" vid="SNG 7:9">u yene ben o una̱ na a anga a̱ yi.<verse eid="SNG 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10" />A̱mu za macigata ma̱ va̱ ma ɗa,</para>
  <para style="q2" vid="SNG 7:10">waru u ta uwwusa maluwa ma̱ va̱.<verse eid="SNG 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11" />Ta̱wa̱, macigata ma̱ va̱,</para>
  <para style="q2" vid="SNG 7:11">lyawa tsu uta̱ a̱ tyo a atsusa,</para>
  <para style="q2" vid="SNG 7:11">lyawa tsa asa a̱ mulyuci.<verse eid="SNG 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12" />Lyawa tsu uta̱ nu usana tsu uwa o uɗuma̱ u ina̱bi,</para>
  <para style="q2" vid="SNG 7:12">tse ene ko ɗanga ina̱bi matsan ta̱ ɗe,</para>
  <para style="q1" vid="SNG 7:12">ko yipa̱lu i le i ɓoso ta̱ ɗe,</para>
  <para style="q2" vid="SNG 7:12">waru ko ɗanga muwun m peme</para>
  <para style="q2" vid="SNG 7:12">n yuwan ta̱ ɗe yipa̱lu.</para>
  <para style="q2" vid="SNG 7:12">Ɗe ɗa moo roco wu icigi i va̱.<verse eid="SNG 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13" />Ɗe ɗa va uwwa ma̱guru me ili i na a̱ cu'wa̱in.</para>
  <para style="q2" vid="SNG 7:13">Na̱ ɗanga na ri uyo'o suru.</para>
  <para style="q1" vid="SNG 7:13">N sokowo wu ta̱ mawwa mo uyo'o</para>
  <para style="q2" vid="SNG 7:13">mo ufaru na̱ za va gogo,</para>
  <para style="q2" vid="SNG 7:13">macigata ma̱ va̱.<verse eid="SNG 7:13" /></para>
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1" />A̱ shi a damma a̱vu mawun ma̱ a̱na̱wun ma̱ va̱ ma ɗa,</para>
  <para style="q2" vid="SNG 8:1">za na apai maani ma mma va̱!</para>
  <para style="q1" vid="SNG 8:1">Na̱ shi n cina wu a alanga,</para>
  <para style="q2" vid="SNG 8:1">n shi ta a katala wu,</para>
  <para style="q2" vid="SNG 8:1">agba babu za na o goro mu.<verse eid="SNG 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2" />N shi ta a tara wu</para>
  <para style="q2" vid="SNG 8:2">n ta̱wa̱ na̱ a̱vu o u'wa wa mma va̱,</para>
  <para style="q2" vid="SNG 8:2">a̱ yi na u rito numu.</para>
  <para style="q1" vid="SNG 8:2">Lo ɗa maa ca wu masayan ma̱ ina̱bi</para>
  <para style="q2" vid="SNG 8:2">ma̱ va̱ mo uyo'o vu sowo,</para>
  <para style="q2" vid="SNG 8:2">masayan mo uɗanga u muwun m peme n va̱ vu sowo.<verse eid="SNG 8:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3" />Ukere wu ugula̱ wa̱ yi</para>
  <para style="q2" vid="SNG 8:3">u ta̱ za̱la̱ va aaci a̱ va̱,</para>
  <para style="q2" vid="SNG 8:3">ukere u sa'ani wa̱ yi</para>
  <para style="q2" vid="SNG 8:3">waru ukatalu na̱ mu.<verse eid="SNG 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4" />A̱ɗu esheli a̱ Urishelima,</para>
  <para style="q2" vid="SNG 8:4">kucuna numu i damma,</para>
  <para style="q1" vid="SNG 8:4">yaa damaton tsu shi,</para>
  <para style="q2" vid="SNG 8:4">mantsa ma na tsu ri a uwwusa uyo'o u tsu.<verse eid="SNG 8:4" /></para>
  <para style="sp">Esheli'i a yuwan ta̱ adanshi</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5" />Zane ɗa ndeɗe a̱ ta̱wa̱ diga o ogozo,</para>
  <para style="q2" vid="SNG 8:5">a raɓatosu uba̱ta̱ macigata ma̱ yi?</para>
  <para style="sp" vid="SNG 8:5">Usheli'i u yuwan ta̱ adanshi</para>
  <para style="q1" vid="SNG 8:5">N jisan wu ta̱ za̱la̱ vu uɗanga wa apulu,</para>
  <para style="q2" vid="SNG 8:5">uba̱ta̱ u na mma va̱ wu tarai a̱a̱tsuma̱ a̱ wu,</para>
  <para style="q2" vid="SNG 8:5">uba̱ta̱ u na mma va̱ wu matsan nuwu.<verse eid="SNG 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6" />Vu zuwa mu tsu urotsu o okolo a̱ wu,</para>
  <para style="q2" vid="SNG 8:6">tsu urotsu o ukere wa̱ wu,</para>
  <para style="q1" vid="SNG 8:6">adama a na icigi i ta̱ nu ucira tsu ukwisa̱,</para>
  <para style="q2" vid="SNG 8:6">na̱ tsushu'un tsu usuɗuwu tsa aason.</para>
  <para style="q1" vid="SNG 8:6">U tsu dala ta̱ tsa akina,</para>
  <para style="q2" vid="SNG 8:6">u tsu kula̱ ta̱ tsa akina a madala nu ucira.<verse eid="SNG 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7" />Mini ma̱ a̱bunda̱ maa gura kimusa̱ icigi shi,</para>
  <para style="q2" vid="SNG 8:7">ko ɗolu gura pura̱ yi shi.</para>
  <para style="q1" vid="SNG 8:7">Ko na̱ vuma ca utsuru wu u'wa wa̱ yi suru,</para>
  <para style="q2" vid="SNG 8:7">adama e icigi,</para>
  <para style="q2" vid="SNG 8:7">o to zo'oso yi nu ulamu.<verse eid="SNG 8:7" /></para>
  <para style="sp">Esheli'i a yuwan ta̱ adanshi</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8" />Tsu ta̱ na̱ zawa'a vu usheli,</para>
  <para style="q2" vid="SNG 8:8">u na koto wu uta̱i agaɓa shi.</para>
  <para style="q1" vid="SNG 8:8">Nye tsaa yuwan adama a zawa'a tsu</para>
  <para style="q2" vid="SNG 8:8">na̱ vali ro damma u ciga yi ta̱?<verse eid="SNG 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9" />Na damma a̱ yi uɓaɓu u ɗa,</para>
  <para style="q2" vid="SNG 8:9">tsu ta suwaa yi atsura a azurufa,</para>
  <para style="q1" vid="SNG 8:9">na damma a̱ yi una̱ntsu u ɗa,</para>
  <para style="q2" vid="SNG 8:9">tsu shi ta̱ a yuwaan yi uɓa̱ruwa̱ta̱ wa akpata a sida.<verse eid="SNG 8:9" /></para>
  <para style="sp">Usheli'i u yuwan ta̱ adanshi</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10" />A̱mu uɓaɓu u ɗa,</para>
  <para style="q2" vid="SNG 8:10">agaɓa a̱ va̱ waru e le ɗa atsura,</para>
  <para style="q2" vid="SNG 8:10">mo o'wo ta̱ a̱ ta̱wusa̱a̱ macigata ma̱ va̱ na asuvu nden.<verse eid="SNG 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11" />Sulemanu ta̱ nu uɗuma̱ u ina̱bi a Ba'al Hamon,</para>
  <para style="q2" vid="SNG 8:11">u lyawai ta̱ e ekere a̱za̱ e ipiri yu uɗuma̱'a̱.</para>
  <para style="q1" vid="SNG 8:11">Koyan ɗa ta̱ ta̱wa̱a̱ yi ni ikebe i azurufa ukpakukupa (1,000),</para>
  <para style="q2" vid="SNG 8:11">adama o umatsun wu uɗuma̱'a̱.<verse eid="SNG 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12" />A̱mu n ta̱ nu uɗuma̱ u ina̱bi wa aci u va̱,</para>
  <para style="q2" vid="SNG 8:12">a̱vu Sulemanu n ta ca wu ikebe i azurufa ukpakukupa (1,000),</para>
  <para style="q2" vid="SNG 8:12">aza a na a̱a̱ ka̱lyuwusa̱a̱ wu uɗuma̱'a̱ waru n ta ca koyan ukpaku ure (200).<verse eid="SNG 8:12" /></para>
  <para style="sp">Ulobo'o u yuwan ta̱ adanshi</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13" />Macigata ma̱ va̱ a̱vu na vu ri nden a̱ a̱a̱rumbu,</para>
  <para style="q2" vid="SNG 8:13">a̱vu na n utsa̱ n va̱ maa uwwusa uyo'o wu uɗyo wa̱ wu,</para>
  <para style="q2" vid="SNG 8:13">lyawa a̱mu fo mu uwwa uɗyo wa̱ wu!<verse eid="SNG 8:13" /></para>
  <para style="sp">Usheli'i u yuwan ta̱ adanshi</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14" />Jika̱ a̱ ta̱wa̱, macigata ma̱ va̱,</para>
  <para style="q2" vid="SNG 8:14">ta̱wa̱ ya̱'a̱ va̱ gogo tsa̱ mere'on,</para>
  <para style="q1" vid="SNG 8:14">tsa̱ mawun me meshon</para>
  <para style="q2" vid="SNG 8:14">a nsasan uba̱ta̱ e itana yu ucita i ma̱guru.<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>