<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">EMOS - Tsishingini (tsw)</book>
  <para style="h">Emos</para>
  <para style="toc3">Emo</para>
  <para style="toc2">Emos</para>
  <para style="toc1">Emos</para>
  <para style="mt2">Emos</para>
  <para style="mt1">Emos</para>
  <para style="is">Ucuɗuwu wa aatagada a nda</para>
  <para style="ip">Emos ɗa vumava̱sula̱ vu ufaru na a ɗanai alajiya a̱ yi a̱tsuma̱ a Aatagada a Akiza uga'an. Ko na wo o'woi wu uta̱ ta̱ diga a̱ lyuci ro ɗa a̱tsuma̱ a Yahuda, suru na̱ ne u yuwan ta̱ alajiya a̱ yi o tsugono tsa Isra'ila wu upasu wu ugana. U yuwan ta̱ alajiya a̱ yi a̱tsuma̱ a a'wan ukpakucindere na̱ kupoton (750) kafu a matsan Yesu. Mantsa mo ndolo mantsa ma mawwa mo uyo'o ma ɗa ma̱ da̱na̱i lon, na̱ a̱bunda̱ a linga vi itoni, oɓolo na̱ nden lafiya. Amma Emos gura ta̱ idana mawwa mo uyo'o'o u ta̱ e ekere a̱za̱ o utsuru ɗa goon. Waru ozo o utsuru o ndolo a̱ tsura̱ ta̱ utsuru u le a̱tsuma̱ o ure wu ule'e nu ulambu wa amayun ni iɓongishi. Ikpa'a i ɗa i shunwai a̱tsuma̱ e itoni i le, waru nden n lafiya ya̱'a̱ le za vu urewesu u ɗa goon. A̱tsuma̱ a̱tsumola̱ngu no okolo ugbamu a ɗa u rono n le atsuvu a dansa A̱sula̱ a̱ ta̱ ge'eto iɗa'a. Reve u ɗe le na̱ a̱ ka̱mba̱ o toni amayun, u ta gura wo o'wo A̱sula̱ e ene iliyali ya aza a na a lyawai a̱tsuma̱ e iɗa'a.</para>
  <para style="iot">Ili i na i ri pe a̱tsuma̱ a aatagada a nda</para>
  <para style="io1">Uge'etosu adama aza a na a̱ ri na̱ nden a̱tsuma̱ a Isra'ila 1:1-2:5</para>
  <para style="io1">Uge'etosu aci aza a Isra'ila 2:6-6:14</para>
  <para style="io1">Alavu alavu o ton 7:1-9:15</para>
  <para style="ib" />
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />Nda adanshi a̱ Emos, za va aguɓa o ro vi iɗa ya Tekowa, alavu alavu na we enei a'wan e re kafu iɗa i jinga̱ɗa̱, a yashi i na Uziya shi mogono ma Yahuda, Yerobowam ulobo wa Yowash waru mogono ma Isra'ila.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 15:1-7">2 Ngo 15:1-7</ref>; <ref loc="2CH 26:1-23">2 Alb 26:1-23</ref>; <ref loc="2KI 14:23-29">2 Ngo 14:23-29</ref>.</char></note><verse eid="AMO 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 1:2" />A̱vu u damma,<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="JOL 3:16">Juw 3:16</ref>.</char></note></para>
  <para style="q1" vid="AMO 1:2">&lt;&lt;Diga Sihiyona A̱sulazuva a̱ ta̱ ma̱gugwa̱,</para>
  <para style="q2" vid="AMO 1:2">Uɗyo wa̱ yi u ta̱ tsa tsata diga Urishelima.</para>
  <para style="q1" vid="AMO 1:2">Agalaci aza a aguɓa a kpanla ta̱,</para>
  <para style="q2" vid="AMO 1:2">waru ncilecile n Masasan ma Kame n 'yewe ta̱.&gt;&gt;<verse eid="AMO 1:2" /></para>
  <para style="s">Uge'etosu wi iɗa ya Suriya</para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 1:3" />Apa nda ili i na A̱sulazuva a dammai:</para>
  <para style="q2" vid="AMO 1:3">&lt;&lt;O una̱ wu nusu wa̱ a̱bunda̱ a na Dimaska a yuwusan kuci,</para>
  <para style="q2" vid="AMO 1:3">ma̱a̱ bula̱ upan u va̱ shi.</para>
  <para style="q1" vid="AMO 1:3">Adama a na a faba ta̱</para>
  <para style="q2" vid="AMO 1:3">ama a Giliyadu na aaɗanga a̱ rumu.<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="ISA 17:1-3">Ish 17:1-3</ref>; <ref loc="JER 49:23-27">Irm 49:23-27</ref>; <ref loc="ZEC 9:1">Zak 9:1</ref>.</char></note><verse eid="AMO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4" />Adama o ndolo n ta̱ lyungu na akina</para>
  <para style="q2" vid="AMO 1:4">a̱ tyo o u'wa wa Hazayel,</para>
  <para style="q1" vid="AMO 1:4">akina a na a lyuwa ba̱ta̱ vu upa'atan wu ucira</para>
  <para style="q2" vid="AMO 1:4">wa̱ Mogono Ben Hada.<verse eid="AMO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5" />Reve A̱sulazuva a damma,</para>
  <para style="q2" vid="AMO 1:5">n ta kuɗa una̱ntsu wu rumu wa Dimaska,</para>
  <para style="q2" vid="AMO 1:5">a̱vu n kototo mogono ma na ma̱ ri o Uka̱ri wa Aven,</para>
  <para style="q1" vid="AMO 1:5">oɓolo na̱ za na ri uguzu na aaɗanga diga Bet Eden.</para>
  <para style="q2" vid="AMO 1:5">Waru ama a Suriya a̱ ta̱ 'ya̱wa̱ tsugbashi e iɗa ya Kir.&gt;&gt;<verse eid="AMO 1:5" /></para>
  <para style="s">Uge'etosu wi iɗa ya Filistiya</para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 1:6" />Apa nda ili i na A̱sulazuva a dammai:</para>
  <para style="q2" vid="AMO 1:6">&lt;&lt;O una̱ wu nusu wa̱ a̱bunda̱ a na Gaza a yuwusan kuci,</para>
  <para style="q2" vid="AMO 1:6">ma̱a̱ bula̱ upan u va̱ shi.</para>
  <para style="q1" vid="AMO 1:6">Adama a na u pura̱i ama suru a̱ 'ya̱wa̱ tsugbashi,</para>
  <para style="q2" vid="AMO 1:6">a̱vu a winaa Edom.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">Ish 14:29-31</ref>; <ref loc="JER 47:1-7">Irm 47:1-7</ref>; <ref loc="EZK 25:15-17">Izk 25:15-17</ref>; <ref loc="JOL 3:4-8">Juw 3:4-8</ref>; <ref loc="ZEP 2:4-7">Zaf 2:4-7</ref>; <ref loc="ZEC 9:5-7">Zak 9:5-7</ref>.</char></note><verse eid="AMO 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7" />Adama o ndolo n ta̱ lyunguwa̱ ukari wa Gaza na akina</para>
  <para style="q2" vid="AMO 1:7">na aa tama uba̱ta̱ wu upa'atan wu ucira wa̱ yi.<verse eid="AMO 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8" />N ta̱ kototo mogono ma aza a Ashido,</para>
  <para style="q2" vid="AMO 1:8">oɓolo na̱ za na ri uguzu na aaɗanga a̱tsuma̱ a Ashikelon.</para>
  <para style="q1" vid="AMO 1:8">Waru ukere u va̱ u ta yuwan nla̱ngi na̱ Ekuron,</para>
  <para style="q2" vid="AMO 1:8">waru akapi a aza a Filistiya fo a̱ ta̱ kuwa̱!</para>
  <para style="q1" vid="AMO 1:8">A̱mu A̱sulazuva A̱sula̱ a ɗa n dammai ne.&gt;&gt;<verse eid="AMO 1:8" /></para>
  <para style="s">Uge'etosu wi iɗa wa Taya</para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 1:9" />Apa nda ili i na A̱sulazuva a dammai:</para>
  <para style="q2" vid="AMO 1:9">&lt;&lt;O una̱ wu nusu wa̱ a̱bunda̱ a na Taya a yuwusan kuci,</para>
  <para style="q2" vid="AMO 1:9">ma̱a̱ bula̱ upan u va̱ shi.</para>
  <para style="q1" vid="AMO 1:9">Adama a na a winai lyuci ma̱ɓula̱ e ekere a Edom,</para>
  <para style="q2" vid="AMO 1:9">agba a cuwan na̱ nzuwulai n muwun n tsuna̱wu shi.<note caller="-" style="x"><char style="xo" closed="false">1:9-10 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">Ish 23:1-18</ref>; <ref loc="EZK 26:1">Izk 26:1</ref>; <ref loc="EZK 28:19">28:19</ref>; <ref loc="JOL 3:4-8">Juw 3:4-8</ref>; <ref loc="ZEC 9:1-4">Zak 9:1-4</ref>; <ref loc="MAT 11:21-22">Mat 11:21-22</ref>; <ref loc="LUK 10:13-14">Luk 10:13-14</ref>.</char></note><verse eid="AMO 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10" />Adama o ndolo n ta̱ lyunguwa̱ ukari wa Taya na akina</para>
  <para style="q2" vid="AMO 1:10">reve u tama uba̱ta̱ wu upa'atan wu ucira wa̱ yi.&gt;&gt;<verse eid="AMO 1:10" /></para>
  <para style="s">Uge'etosu wi iɗa ya̱ Edom</para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 1:11" />Apa nda ili i na A̱sulazuva a dammai:</para>
  <para style="q2" vid="AMO 1:11">&lt;&lt;O una̱ wu nusu wa̱ a̱bunda̱ a na Edom a yuwusan kuci,</para>
  <para style="q2" vid="AMO 1:11">ma̱a̱ bula̱ upan u va̱ shi.</para>
  <para style="q1" vid="AMO 1:11">Adama a na a saɓa ta̱ a̱za̱ le na̱ matsun me pe'eni,</para>
  <para style="q2" vid="AMO 1:11">waru a saɓa ta̱ Isra'ila babu ene iliyali.</para>
  <para style="q1" vid="AMO 1:11">Upan wa ama a̱ Edom ma̱ da̱na̱ ta̱ a̱ ma̱puna̱,</para>
  <para style="q2" vid="AMO 1:11">Waru a̱ fa̱la̱ shi.<note caller="-" style="x"><char style="xo" closed="false">1:11-12 </char><char style="xt" closed="false"><ref loc="ISA 34:5-17">Ish 34:5-17</ref>; <ref loc="ISA 63:1-6">63:1-6</ref>; <ref loc="JER 49:7-22">Irm 49:7-22</ref>; <ref loc="EZK 25:12-14">Izk 25:12-14</ref>; <ref loc="EZK 35:1-15">35:1-15</ref>; <ref loc="OBA 1:1-14">Oba 1-14</ref>; <ref loc="MAL 1:2-5">Mal 1:2-5</ref>.</char></note><verse eid="AMO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12" />Adama o ndolo n ta̱ lyunguwa̱ Teman na akina,</para>
  <para style="q2" vid="AMO 1:12">agba u ta lyuwa uba̱ta̱ wu upa'atan wu ucira wa Bozura.&gt;&gt;<verse eid="AMO 1:12" /></para>
  <para style="s">Uge'etosu wi iɗa ya Giliyadu</para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 1:13" />Apa nda ili i na A̱sulazuva a dammai:</para>
  <para style="q2" vid="AMO 1:13">&lt;&lt;O una̱ wu nusu wa̱ a̱bunda̱ a na aza Amon a yuwusan kuci,</para>
  <para style="q2" vid="AMO 1:13">ma̱a̱ bula̱ upan u va̱ shi.</para>
  <para style="q1" vid="AMO 1:13">Adama a na a̱ ɗa̱ra̱ ta̱ a̱ma̱ci a̱a̱tsuma̱</para>
  <para style="q2" vid="AMO 1:13">a na a̱ ri a̱tsuma̱ o upasu wa Giliyadu,</para>
  <para style="q2" vid="AMO 1:13">adama a̱ da̱shi a̱tyo e iɗa i le.<note caller="-" style="x"><char style="xo" closed="false">1:13-15 </char><char style="xt" closed="false"><ref loc="JER 46:1-6">Irm 46:1-6</ref>; <ref loc="EZK 21:28-32">Izk 21:28-32</ref>; <ref loc="EZK 25:1-7">25:1-7</ref>; <ref loc="ZEP 2:8-11">Zaf 2:8-11</ref>.</char></note><verse eid="AMO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14" />Adama o ndolo n ta̱ lyunguwa̱ ukari wa Raba na akina,</para>
  <para style="q2" vid="AMO 1:14">agba u ta lyuwa uba̱ta̱ wu upa'atan wu ucira wa̱ yi,</para>
  <para style="q1" vid="AMO 1:14">a ta yuwan yorori o urana wu uvon,</para>
  <para style="q2" vid="AMO 1:14">tso o upepu na̱ lipa̱ vu ulungusu o urana u ndolo.<verse eid="AMO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15" />A̱vu A̱sulazuva a damma,</para>
  <para style="q2" vid="AMO 1:15">Mogono me le ma̱ ta̱ 'ya̱wa̱ tsugbashi,</para>
  <para style="q2" vid="AMO 1:15">a̱yi na azagbain a̱ yi suru.&gt;&gt;<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="s">Uge'etosu wi iɗa ya̱ Mowa</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 2:1" />Apa nda ili i na A̱sulazuva a dammai:</para>
  <para style="q2" vid="AMO 2:1">&lt;&lt;O una̱ wu nusu wa̱ a̱bunda̱ a na Mowa a yuwusan kuci,</para>
  <para style="q2" vid="AMO 2:1">maa bula̱ upan u va̱ shi.</para>
  <para style="q1" vid="AMO 2:1">Adama a na u kula̱toi etele o ngono ma Edom</para>
  <para style="q2" vid="AMO 2:1">hali o'wo okomo.<note caller="-" style="x"><char style="xo" closed="false">2:1-3 </char><char style="xt" closed="false"><ref loc="ISA 15:1-16:14">Ish 15:1-16:14</ref>; <ref loc="ISA 25:10-12">25:10-12</ref>; <ref loc="JER 48:1-47">Irm 48:1-47</ref>; <ref loc="EZK 25:8-11">Izk 25:8-11</ref>; <ref loc="ZEP 2:8-11">Zaf 2:8-11</ref>.</char></note><verse eid="AMO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2" />N ta̱ lyunguwa̱a̱ Mowa na akina</para>
  <para style="q2" vid="AMO 2:2">na aa lyuwa uba̱ta̱ wu upa'atan wu ucira wa Keriyot.</para>
  <para style="q1" vid="AMO 2:2">O to kototo a ama a Mowa</para>
  <para style="q2" vid="AMO 2:2">a̱tsuma̱ a̱ba̱jini o urupulu,</para>
  <para style="q2" vid="AMO 2:2">na̱ a̱tsuma̱ a yisali a̱soja na̱ mesun ma avana.<verse eid="AMO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3" />A̱vu A̱sulazuva a damma,</para>
  <para style="q2" vid="AMO 2:3">n to kototo mogono ma̱ yi,</para>
  <para style="q2" vid="AMO 2:3">reve fo mu una azagbain a̱ yi suru oɓolo na̱ yi.&gt;&gt;<verse eid="AMO 2:3" /></para>
  <para style="s">Uge'etosu wi iɗa ya Yahuda</para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 2:4" />Apa nda ili i na A̱sulazuva a dammai:</para>
  <para style="q2" vid="AMO 2:4">&lt;&lt;O una̱ wu nusu wa̱ a̱bunda̱ a na aza a Yahuda a yuwusan kuci,</para>
  <para style="q2" vid="AMO 2:4">maa bula̱ upan u va̱ shi.</para>
  <para style="q1" vid="AMO 2:4">Adama a na a 'yuwain wila̱ wa̱ A̱sulazuva,</para>
  <para style="q2" vid="AMO 2:4">agba a̱ kuru ili i na u zuwai shi,</para>
  <para style="q1" vid="AMO 2:4">musula̱ nle me epen mu luluma̱ le ta̱,</para>
  <para style="q2" vid="AMO 2:4">cine a̱ luluma̱i nkaya nle.<verse eid="AMO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5" />Adama o ndolo n ta̱ lyunguwa̱ Yahuda na akina</para>
  <para style="q2" vid="AMO 2:5">na aa lyuwa uba̱ta̱ wu upa'atan wu ucira wa̱ Urishelima.&gt;&gt;<verse eid="AMO 2:5" /></para>
  <para style="s">Uge'etosu wa aza a Isra'ila</para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="AMO 2:6" />Apa nda ili i na A̱sulazuva a dammai,</para>
  <para style="q2" vid="AMO 2:6">&lt;&lt;O una̱ wu nusu wa̱ a̱bunda̱ a na aza a Isra'ila a yuwusan kuci,</para>
  <para style="q2" vid="AMO 2:6">maa bula̱ upan u va̱ shi.</para>
  <para style="q1" vid="AMO 2:6">Adama a na a ta winasa za va̱ a̱ɓula̱ o una̱ u azurufa,</para>
  <para style="q2" vid="AMO 2:6">za vu ulambu waru o una̱ u wotowu wa atan a̱ ta̱.<verse eid="AMO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7" />A ta dasasa a aci a̱ a̱za̱ o ulambu</para>
  <para style="q2" vid="AMO 2:7">tsa̱ ma̱buta̱ me iɗa</para>
  <para style="q2" vid="AMO 2:7">reve a putsaa aza a na o ɓongiyi na amayun.</para>
  <para style="q1" vid="AMO 2:7">Dada nu ulobo wa̱ yi o to vosun nu usheli u ta̱,</para>
  <para style="q2" vid="AMO 2:7">ne ɗa a̱ lungusa̱i ala a akiza a̱ va̱.<verse eid="AMO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8" />O to vosun elime masa'a suru</para>
  <para style="q2" vid="AMO 2:8">o una̱ wa̱ a̱tugu a na a̱ ushiyi o una̱ wo okopu.</para>
  <para style="q1" vid="AMO 2:8">A̱tsuma̱ o u'wa u ma̱sula̱ me e le o to sowuso masayan</para>
  <para style="q2" vid="AMO 2:8">ma na a̱ ushiyi</para>
  <para style="q2" vid="AMO 2:8">o una̱ wu ugana.&gt;&gt;<verse eid="AMO 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9" />&lt;&lt;Agba a̱ yi ɗa nda adama e le ɗa</para>
  <para style="q2" vid="AMO 2:9">n kototoi aza a Amoriya,</para>
  <para style="q1" vid="AMO 2:9">aza a na uga'an u le u shi tsa ɗanga a̱ sida,</para>
  <para style="q2" vid="AMO 2:9">ucira u le waru tsu ɗanga vo Oku.</para>
  <para style="q1" vid="AMO 2:9">N kototo ta̱ umatsun wa̱ yi u na u ri ɗe zuva</para>
  <para style="q2" vid="AMO 2:9">na aralu a̱ yi na ri za̱la̱.<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="DEU 3:8-11">U.Wl 3:8-11</ref>.</char></note><verse eid="AMO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10" />Waru a̱mu ɗa mu uta̱a̱ nɗu diga a̱tsuma̱ e iɗa ya Masar,</para>
  <para style="q2" vid="AMO 2:10">a̱vu n rono ɗu aɗanga a'wan amunga a̱tsumona,</para>
  <para style="q2" vid="AMO 2:10">adama i usa iɗa ya aza a Amoriya wo o'wo a̱ɗu agadu.&gt;&gt;<verse eid="AMO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11" />Reve A̱sulazuva a damma,</para>
  <para style="q2" vid="AMO 2:11">&lt;&lt;N 'ya̱sa̱n ta̱ muwun nɗu n ro</para>
  <para style="q2" vid="AMO 2:11">a na o'wo ama̱sula̱,</para>
  <para style="q1" vid="AMO 2:11">oɓolo na aza a Isra'ila o ro na tawai aciyele adama a̱ va̱.</para>
  <para style="q2" vid="AMO 2:11">Ama a Isra'ila ne ɗa shi?&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="NUM 6:1-8">Mkc 6:1-8</ref>.</char></note><verse eid="AMO 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 2:12" />Agba a̱vu i reme i zuwa aza a Isra'ila na tawai aciyele o ndolo'o,</para>
  <para style="q2" vid="AMO 2:12">o sowo masayan ma̱ ina̱bi,</para>
  <para style="q1" vid="AMO 2:12">a̱vu waru i damma ama̱sula̱'a̱</para>
  <para style="q2" vid="AMO 2:12">she a yuwan adanshi e ikaka ya̱ A̱sula̱ wan.<verse eid="AMO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13" />Gogo gba, n ta tsugba ɗu e iɗa uba̱ta̱ u na i ri,</para>
  <para style="q2" vid="AMO 2:13">cine akatalu a̱bunda̱ a tsu tsugba keke matara me itana.<verse eid="AMO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 2:14" />To, za na ri ni ilaɗi lon waa la'a shi,</para>
  <para style="q2" vid="AMO 2:14">za vu ucira waru waa buwa nu ucira shi,</para>
  <para style="q2" vid="AMO 2:14">za na gurai uvon waru waa gura wawa wuma shi.<verse eid="AMO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15" />Za vu utan aa gura isawan uvon shi,</para>
  <para style="q2" vid="AMO 2:15">waru soja na gurai ilaɗi waa wawa aciya̱yi shi.</para>
  <para style="q1" vid="AMO 2:15">Za na fo aa kumbusa ido</para>
  <para style="q2" vid="AMO 2:15">waa gura wawa wuma wa̱ yi shi.<verse eid="AMO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16" />Reve A̱sulazuva a damma,</para>
  <para style="q2" vid="AMO 2:16">&lt;&lt;O urana u ndolo ko soja vo okolo o ugbamu u ta zuwa itana yu uvon ya̱ yi, a̱vu u suma ataɓu.&gt;&gt;<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="s">Oforo a Isra'ila nu uge'etosu</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />A̱ɗu ama a Isra'ila, a̱ɗu ɗa goon umatsun u na A̱sulazuva o uta̱a̱ yi diga a̱tsuma̱ e iɗa ya Masar. Gogo poloi atsuvu yu uwwa adanshi a na A̱sulazuva a yuwain aciya̱ɗu.<verse eid="AMO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 3:2" />&lt;&lt;I gura cuwan,</para>
  <para style="q2" vid="AMO 3:2">diga a̱tsuma̱ o umatsun wu uvaɗi suru,</para>
  <para style="q2" vid="AMO 3:2">a̱ɗu ɗa goon n revei,</para>
  <para style="q2" vid="AMO 3:2">waru n ɗangula ɗu ta̱ yo o'wo a̱za̱ a̱ va̱.</para>
  <para style="q1" vid="AMO 3:2">Adama o ndolo n ta ca ɗu oforo</para>
  <para style="q2" vid="AMO 3:2">adama a̱ nusu ɗu.&gt;&gt;<verse eid="AMO 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3" />Ama e re a ta gura yuwan mmalu oɓolo,</para>
  <para style="q2" vid="AMO 3:3">she na̱ a̱ usu a yuwan shi?<verse eid="AMO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4" />Kamu ta̱ gugwa̱ a̱tsumona</para>
  <para style="q2" vid="AMO 3:4">nu u ri ni ili i na u remei shi?</para>
  <para style="q1" vid="AMO 3:4">Makamu ma̱ ta̱ gugwa̱ a̱tsuma̱ a̱ a̱a̱ba̱nu a̱ yi</para>
  <para style="q2" vid="AMO 3:4">babu u reme ili?<verse eid="AMO 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5" />Manunu ma̱ ta̱ riya̱ a̱tsuma̱ a maza e iɗa</para>
  <para style="q2" vid="AMO 3:5">uba̱ta̱ u na a zuwaa niyi maza shi?</para>
  <para style="q1" vid="AMO 3:5">Maza ma ta taɗi</para>
  <para style="q2" vid="AMO 3:5">agba u reme ili shi?<verse eid="AMO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6" />A̱ te ivula̱ avana a̱tsuma̱ a̱ lyuci</para>
  <para style="q2" vid="AMO 3:6">a̱vu ama a̱ kuɗa̱ a da'wan?</para>
  <para style="q1" vid="AMO 3:6">A̱tsuma̱lima̱ a̱ tsu ta̱wa̱ ta̱ a̱ lyuci</para>
  <para style="q2" vid="AMO 3:6">agba A̱sulazuva a ɗa a̱ ta̱wa̱i na̱ yi shi?<verse eid="AMO 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7" />Amayun A̱sulazuva Mogono me Ili Suru waa yuwan ili,</para>
  <para style="q2" vid="AMO 3:7">babu na u revetyoi agbashi a̱yi ama̱sula̱ ifoɓi ya̱ yi shi.<verse eid="AMO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8" />Ana'an kamu gugwa̱ ta̱,</para>
  <para style="q2" vid="AMO 3:8">zane ɗa aa uwwa wovon shi?</para>
  <para style="q1" vid="AMO 3:8">A̱sulazuva Mogono me Ili Suru ma yuwan ta̱ adanshi,</para>
  <para style="q2" vid="AMO 3:8">zane ɗa a 'yuwan a yuwan adanshi e ikaka ya̱ yi?<verse eid="AMO 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 3:9" />A̱vu A̱sulazuva a damma Emos vumava̱sula̱,</para>
  <para style="q2" vid="AMO 3:9">&lt;&lt;Vu yuwan adanshi a̱ tyo ba̱ta̱ a cira va Ashido,</para>
  <para style="q2" vid="AMO 3:9">na̱ ba̱ta̱ a cira va Masar, vu damma le,</para>
  <para style="q1" vid="AMO 3:9">&lt;Ɓolotoi a nsasan ma Samariya,</para>
  <para style="q2" vid="AMO 3:9">ye ene udamu u na u ri pe</para>
  <para style="q2" vid="AMO 3:9">ni iɓongi i na i ri e memere ma̱ yi.&gt;<verse eid="AMO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 3:10" />A̱vu A̱sulazuva a damma,</para>
  <para style="q2" vid="AMO 3:10">adama a na e reve cine aa yuwan</para>
  <para style="q2" vid="AMO 3:10">ili i na i ri mejege shi!</para>
  <para style="q1" vid="AMO 3:10">O ɓoloto ta̱ itana i wivu</para>
  <para style="q2" vid="AMO 3:10">a̱ ba̱ta̱ vu upa'atan wu ucira u le?&gt;&gt;<verse eid="AMO 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 3:11" />Reve A̱sulazuva a damma,</para>
  <para style="q2" vid="AMO 3:11">&lt;&lt;Na amayun n'yuwatan n ta̱ ka̱nda̱ruwa̱ lyuci'i,</para>
  <para style="q1" vid="AMO 3:11">a ta kasa ɗu nu uɓaɓu wu ucira u ɗu,</para>
  <para style="q2" vid="AMO 3:11">waru a̱ pura̱ itana yu uba̱tu wu upa'atan wu ucira u ɗu.&gt;&gt;<verse eid="AMO 3:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 3:12" />Apa nda ili i na A̱sulazuva a dammai:</para>
  <para style="q2" vid="AMO 3:12">&lt;&lt;Cine za va aguɓa tsu wawa</para>
  <para style="q2" vid="AMO 3:12">ana e re ko utsuvu u ta̱ diga o una̱ wu kamu,</para>
  <para style="q1" vid="AMO 3:12">ne ɗa aa wawa aza a Isra'ila aza a na a̱ ri nden a̱tsuma̱ a Samariya</para>
  <para style="q2" vid="AMO 3:12">aza a na a̱ ri nden n mawwa mo uyo'o a ta la'a.&gt;&gt;<verse eid="AMO 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 3:13" />A̱vu A̱sulazuva o oɓolo a̱ a̱soja a zuva damma,</para>
  <para style="q2" vid="AMO 3:13">&lt;&lt;Uwwa nda vu rono u'wa wa Yakubu atsuvu.&gt;&gt;<verse eid="AMO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14" />&lt;&lt;O urana u ndolo n ta ca Isra'ila oforo</para>
  <para style="q2" vid="AMO 3:14">adama a̱ nusu va̱ yi.</para>
  <para style="q1" vid="AMO 3:14">N to kototo musa'a me Betel,</para>
  <para style="q2" vid="AMO 3:14">o to koɗo avana a masa'a'a</para>
  <para style="q2" vid="AMO 3:14">oco le e iɗa.<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="2KI 23:15">2 Ngo 23:15</ref>.</char></note><verse eid="AMO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15" />Reve A̱sulazuva a damma,</para>
  <para style="q2" vid="AMO 3:15">n ta̱ ɓoso 'wa le vi irana na̱ a̱za̱ a̱ lyushi,</para>
  <para style="q2" vid="AMO 3:15">'wa le na a lapulai na anga a agiwa,</para>
  <para style="q2" vid="AMO 3:15">suru o to oco.</para>
  <para style="q2" vid="AMO 3:15">Waru o to kototo a̱ba̱jini a̱ba̱jini a 'wa le.&gt;&gt;<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="s">Aza a Isra'ila o gbozo shi</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 4:1" />Uwai adanshi a nda,</para>
  <para style="q2" vid="AMO 4:1">a̱ɗu inan ya Bashan i na i ri a Masasan ma Samariya,</para>
  <para style="q1" vid="AMO 4:1">a̱ɗu na yoo ɓongishi alambi</para>
  <para style="q2" vid="AMO 4:1">reve i minjira aza a na a̱ ri ni ili shi.</para>
  <para style="q1" vid="AMO 4:1">A̱vu i damma ali a̱ɗu,</para>
  <para style="q2" vid="AMO 4:1">&lt;&lt;Ta̱wa̱a̱ ntsu ni ili yo oso!&gt;&gt;<verse eid="AMO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 4:2" />A̱sulazuva A̱sula̱,</para>
  <para style="q2" vid="AMO 4:2">a kucina ta̱ na akiza a̱ yi adansa,</para>
  <para style="q2" vid="AMO 4:2">&lt;&lt;Na amayun rana ta̱ lo a̱ ta̱wa̱ ɗu,</para>
  <para style="q1" vid="AMO 4:2">na̱ a̱ pura̱ ɗu a̱ tyo tsugbashi ni igon,</para>
  <para style="q2" vid="AMO 4:2">za suru a̱tsuma̱ ɗu a̱ ta̱ ronoyi na̱ gon a̱ ka̱ra̱.<verse eid="AMO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 4:3" />Reve A̱sulazuva a damma,</para>
  <para style="q2" vid="AMO 4:3">I ta̱ uta̱la̱i nu uba̱ta̱ u na uɓaɓu u karai,</para>
  <para style="q2" vid="AMO 4:3">za suru to uta̱ mejege.</para>
  <para style="q1" vid="AMO 4:3">A ta vari ɗu a Masasan ma Hamon.<verse eid="AMO 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="AMO 4:4" />&lt;&lt;Ta̱wa̱i Betel uba̱ta̱ wa akiza,</para>
  <para style="q2" vid="AMO 4:4">i lyuwa elime na̱ mayan mo unusu wo o'wo.</para>
  <para style="q1" vid="AMO 4:4">'Ya̱wa̱i Gilga i da̱shi yuwan linga vu nusu ɗu.</para>
  <para style="q1" vid="AMO 4:4">Ta̱wa̱yi na̱ kucci ɗu usana suru,</para>
  <para style="q2" vid="AMO 4:4">na̱ za ta̱ a̱tsuma̱ a kupa a'wan a ta'atsu suru.<verse eid="AMO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5" />A̱vu A̱sulazuva a damma,</para>
  <para style="q2" vid="AMO 4:5">i ca kucci vu ugodyusho wo opopofu a na a̱ ri na̱ wolilo shi,</para>
  <para style="q2" vid="AMO 4:5">reve i yuwan adanshi o ucasu wu ucigu wo okolo!</para>
  <para style="q1" vid="AMO 4:5">A̱yi ɗa ili i na okolo a̱ ɗu a cigai,</para>
  <para style="q2" vid="AMO 4:5">a̱ɗu aza a Isra'ila!&gt;&gt;<verse eid="AMO 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="AMO 4:6" />Reve A̱sulazuva a damma,</para>
  <para style="q2" vid="AMO 4:6">&lt;&lt;N zuwa ta̱ a yuwan ambulu a̱tsuma̱ e ilyuci i ɗu suru,</para>
  <para style="q2" vid="AMO 4:6">nu ulambu wi ilyalya a̱ lyuci suru,</para>
  <para style="q2" vid="AMO 4:6">suru na̱ ne i ka̱mba̱ ya̱'a̱ va̱ shi!&gt;&gt;<verse eid="AMO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 4:7" />&lt;&lt;Waru n 'yasan ɗu ta̱ ni iro'i</para>
  <para style="q2" vid="AMO 4:7">kafu ugasa u rawa na̱ woto ta'atsu.</para>
  <para style="q1" vid="AMO 4:7">N lyunguwa̱ ta̱ lyuci ro ni iro'i</para>
  <para style="q2" vid="AMO 4:7">agba a̱vu m putsa lyuci ro.</para>
  <para style="q1" vid="AMO 4:7">Uɗuma̱ u ro u tsura̱ ta̱ iro'i</para>
  <para style="q2" vid="AMO 4:7">za ro gba tsura̱ shi a̱vu u 'yewe.<verse eid="AMO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 4:8" />Reve A̱sulazuva a damma,</para>
  <para style="q2" vid="AMO 4:8">Ama a̱ tsu yuwan ta̱ agara diga a̱ lyuci ro a̱ tyo a̱ lyuci ro</para>
  <para style="q2" vid="AMO 4:8">e izami i mini mo oso,</para>
  <para style="q1" vid="AMO 4:8">amma a̱ tsura̱ mini ma na ma rawa nle shi,</para>
  <para style="q2" vid="AMO 4:8">suru na̱ ne avadala uba̱ta̱ u va̱ shi.&gt;&gt;<verse eid="AMO 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 4:9" />Reve A̱sulazuva a damma,</para>
  <para style="q2" vid="AMO 4:9">&lt;&lt;N faba ta̱ a̱rumbu a̱ ɗu na̱ mɓa̱la̱ nu upa̱luwusa̱,</para>
  <para style="q2" vid="AMO 4:9">oɓolo na̱ a̱ɗuma̱ a̱ ɗu na̱ a̱ɗuma̱ a̱ ina̱bi a̱ ɗu,</para>
  <para style="q2" vid="AMO 4:9">na̱ ɗanga vu biri ɗu na̱ a̱za̱ a̱ zetun a̱ ɗu,</para>
  <para style="q2" vid="AMO 4:9">n zuwa ta̱ apapari a tama le suru.</para>
  <para style="q1" vid="AMO 4:9">Suru na̱ ne i vadala uba̱ta̱ u va̱ shi.&gt;&gt;<verse eid="AMO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 4:10" />A̱vu A̱sulazuva a damma,</para>
  <para style="q2" vid="AMO 4:10">&lt;&lt;N lyungu ta̱ na addama a̱tsuma̱ a̱ ɗu,</para>
  <para style="q2" vid="AMO 4:10">ununa n yuwain ni iɗa ya Masar.</para>
  <para style="q1" vid="AMO 4:10">Mu una ta̱ olobo a̱ ɗu na̱ matsun me pe'eni,</para>
  <para style="q2" vid="AMO 4:10">a̱vu m pura̱ ido i ɗu.</para>
  <para style="q1" vid="AMO 4:10">A̱vu n shiton vunu ɗu nu ushamu wa̱ a̱kwa̱kwa̱</para>
  <para style="q2" vid="AMO 4:10">wa ama a̱ ɗu na a̱ kuwa̱i.</para>
  <para style="q2" vid="AMO 4:10">Suru na̱ ne i vadala uba̱ta̱ u va̱ shi.&gt;&gt;<verse eid="AMO 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 4:11" />Reve A̱sulazuva a damma,</para>
  <para style="q2" vid="AMO 4:11">&lt;&lt;N kototo ta̱ ozo o ro a̱ ɗu</para>
  <para style="q2" vid="AMO 4:11">cine n kototoi Sodom na̱ Gomora.</para>
  <para style="q1" vid="AMO 4:11">Yo o'wo ta̱ tsa aaɗanga a̱ ma̱kula̱ a na a usai diga a akina.</para>
  <para style="q2" vid="AMO 4:11">Suru na̱ ne i vadala uba̱ta̱ u va̱ shi.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="GEN 19:24">Ufr 19:24</ref>.</char></note><verse eid="AMO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12" />&lt;&lt;Adama o ndolo apa nda ili i na maa yuwan na̱ a̱ ɗu aza a Isra'ila!</para>
  <para style="q2" vid="AMO 4:12">Ana wo o'woi n ta yuwaan wu tsun ndolo,</para>
  <para style="q1" vid="AMO 4:12">she vu foɓo na va ga'an na̱ A̱sula̱ a̱ wu,</para>
  <para style="q2" vid="AMO 4:12">a̱vu Isra'ila.&gt;&gt;<verse eid="AMO 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13" />&lt;&lt;A̱yi za na yuwain nsasan,</para>
  <para style="q2" vid="AMO 4:13">waru u yuwain upepu,</para>
  <para style="q1" vid="AMO 4:13">za na pa̱lu'wa̱i majiyan uba̱ta̱ wu vaɗilima̱,</para>
  <para style="q2" vid="AMO 4:13">za na ka̱mba̱toi alanzu irumbu,</para>
  <para style="q1" vid="AMO 4:13">za na ka̱mba̱toi ba̱ta̱ vu uga'an vu uvaɗi</para>
  <para style="q2" vid="AMO 4:13">udasata wa̱ yi,</para>
  <para style="q2" vid="AMO 4:13">A̱sulazuva A̱sula̱ o oɓolo a̱ a̱soja a zuva ɗa ala a̱yi!&gt;&gt;<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s">Zamiyi A̱sulazuva adama i da̱na̱ wuma</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 5:1" />Uwwai nda Isra'ila, poloi atsuvu</para>
  <para style="q2" vid="AMO 5:1">e idanshi yi ishipa ya̱ a̱tsumola̱ngu a na maa yuwusan adama a̱ ɗu!<verse eid="AMO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2" />&lt;&lt;Usheli u va̱ Isra'ila riya̱ ta̱,</para>
  <para style="q2" vid="AMO 5:2">waru waa gura 'yon shi.</para>
  <para style="q1" vid="AMO 5:2">A lyawa yi ta̱ nven e iɗa,</para>
  <para style="q2" vid="AMO 5:2">babu za na a̱a̱ 'ya̱sa̱n yi.&gt;&gt;<verse eid="AMO 5:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="AMO 5:3" />Apa ili i na A̱sulazuva Mogono me Ili Suru ma dammai Isra'ila:</para>
  <para style="q2" vid="AMO 5:3">&lt;&lt;Lyuci gbain na a̱soja ukpakukupa (1,000) o uta̱i,</para>
  <para style="q2" vid="AMO 5:3">ukpaku (100) u ɗa goon aa pasa,</para>
  <para style="q2" vid="AMO 5:3">lyuci gbain na ukpaku (100) wu uta̱i,</para>
  <para style="q1" vid="AMO 5:3">kupa ɗa goon aa pasa!&gt;&gt;<verse eid="AMO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 5:4" />Apa ili i na A̱sulazuva a dammai Isra'ila:</para>
  <para style="q2" vid="AMO 5:4">&lt;&lt;Zami numu adama i la'a.<verse eid="AMO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 5:5" />Amma she i zami mu e ekere a̱ma̱li a Betel wan,</para>
  <para style="q2" vid="AMO 5:5">ko gba i 'ya̱wa̱ Gilga wan,</para>
  <para style="q2" vid="AMO 5:5">ko i pasa a̱ tyo Biyasheba wan.</para>
  <para style="q1" vid="AMO 5:5">Adama a na ama a Gilga a̱ ta̱ pura̱ le a̱ tyo tsugbashi</para>
  <para style="q2" vid="AMO 5:5">waru Betel to o'wo ili ye pere.&gt;&gt;<verse eid="AMO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6" />&lt;&lt;I zami A̱sulazuva adama i la'a,</para>
  <para style="q2" vid="AMO 5:6">na̱ ne ɗa shi u ta lyawa ɗu</para>
  <para style="q2" vid="AMO 5:6">n ta lyuwa u'wa wa̱ Isuhu cine revei akina,</para>
  <para style="q1" vid="AMO 5:6">akina'a u ta lyuwa Betel.</para>
  <para style="q2" vid="AMO 5:6">Waru babu za na aa gura kimusa̱ yi!<verse eid="AMO 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7" />Wo yo'ono ɗu shi, a̱ɗu naa i vadalayi uge'etosu u mejege ucina̱,</para>
  <para style="q2" vid="AMO 5:7">u to o'wo okono e ekere alambi,</para>
  <para style="q2" vid="AMO 5:7">i ta tsugbisa mejege hali a̱ tyo e iɗa!&gt;&gt;<verse eid="AMO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8" />A̱yi na u yuwain o oɓolo e italyo'o o ndolo</para>
  <para style="q2" vid="AMO 5:8">Moton na̱ muwun ma̱ yi</para>
  <para style="q2" vid="AMO 5:8">na̱ meten na̱ musa̱n na̱ mozomu,<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="JOB 9:9">Ayb 9:9</ref>; <ref loc="JOB 38:31">38:31</ref>.</char></note></para>
  <para style="q1" vid="AMO 5:8">za na ka̱mbuwa̱i irumbu alanzu,</para>
  <para style="q2" vid="AMO 5:8">za na ka̱mbuwa̱i urana irumbu,</para>
  <para style="q2" vid="AMO 5:8">za na tsu rono mini ma mala reve wo oco yi</para>
  <para style="q1" vid="AMO 5:8">o urewesu wu uvaɗi o una̱ wi iro'i,</para>
  <para style="q1" vid="AMO 5:8">A̱sulazuva a ɗa ala a̱yi!<verse eid="AMO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9" />U tsu ta̱wa̱a̱ ta̱ nu ukototosu uba̱ta̱ wu upa'atan wu ucira,</para>
  <para style="q2" vid="AMO 5:9">adama ilyuci yi kari o oco.<verse eid="AMO 5:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10" />A̱ɗu ama a Isra'ila,</para>
  <para style="q2" vid="AMO 5:10">i 'yuwan ta̱ za na tsi isawaan amayun</para>
  <para style="q2" vid="AMO 5:10">uba̱ta̱ wu uge'etosu o una̱ntsu u lyuci,</para>
  <para style="q2" vid="AMO 5:10">oɓolo na̱ za na adansa ili i ro shi she mejege.<verse eid="AMO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11" />Amayun,</para>
  <para style="q1" vid="AMO 5:11">i ta tsugbusa alambi,</para>
  <para style="q2" vid="AMO 5:11">a zuwusa le na a ca ɗu ilyalya i le babu ucigu.</para>
  <para style="q1" vid="AMO 5:11">Ko na wo o'woi i suwai saa</para>
  <para style="q2" vid="AMO 5:11">na atali a na e she'ein,</para>
  <para style="q2" vid="AMO 5:11">Amma ya̱ da̱nu pe a̱tsuma̱ e le shi.</para>
  <para style="q1" vid="AMO 5:11">Ko na i cu'wa̱in a̱ɗuma̱ a̱ ina̱bi a sa'ani a sa'ani,</para>
  <para style="q2" vid="AMO 5:11">yoo sowo masayan me le shi.<verse eid="AMO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12" />Adama a na n reve ta̱ a̱bunda̱ a̱ nusu ɗu</para>
  <para style="q2" vid="AMO 5:12">na̱ cine nusu ɗu ri uwuyanu.</para>
  <para style="q1" vid="AMO 5:12">I to ɓongishi a̱za̱ a̱ a̱ɓula̱,</para>
  <para style="q2" vid="AMO 5:12">a̱ ushishi utowusu wu una̱.</para>
  <para style="q1" vid="AMO 5:12">A̱vu i putsaa a yuwaan za vu ulambu wu ucira</para>
  <para style="q2" vid="AMO 5:12">uge'etosu wa amayun uba̱ta̱ o una̱ntsu u lyuci.<verse eid="AMO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13" />Ashe, ili ya asalama i ɗa shi,</para>
  <para style="q2" vid="AMO 5:13">na a̱za̱ o ugbozu a̱ ɓa̱ruyi na̱ le</para>
  <para style="q2" vid="AMO 5:13">a̱tsuma̱ a mantsa me e iwuya ma nda.<verse eid="AMO 5:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 5:14" />Zamiyi isa'ani o una̱ wi iwuya,</para>
  <para style="q2" vid="AMO 5:14">adama i la'a.</para>
  <para style="q1" vid="AMO 5:14">Adama A̱sulazuva A̱sula̱ o oɓolo a̱ a̱soja a zuva</para>
  <para style="q2" vid="AMO 5:14">da̱na̱ oɓolo na̱ a̱ɗu,</para>
  <para style="q2" vid="AMO 5:14">ununa i dammai u ri.<verse eid="AMO 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 5:15" />I suma iwuya, i guza̱ isa'ani,</para>
  <para style="q2" vid="AMO 5:15">i yuwan uge'etosu u mejege</para>
  <para style="q2" vid="AMO 5:15">uba̱ta̱ wu uɓolotosu o ukobu u lyuci.</para>
  <para style="q1" vid="AMO 5:15">U ta gura wo o'wo A̱sulazuva A̱sula̱ o oɓolo a̱ a̱soja a zuva</para>
  <para style="q2" vid="AMO 5:15">to roco akapi a limatan va̱ Isuhu icigi.<verse eid="AMO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 5:16" />Adama o ndolo apa ili i na A̱sulazuva A̱sula̱ o oɓolo a̱ a̱soja a zuva a dammai,</para>
  <para style="q2" vid="AMO 5:16">za na a̱ yi ɗa A̱sulazuva,</para>
  <para style="q1" vid="AMO 5:16">&lt;&lt;A ta yuwan mesun e re,</para>
  <para style="q2" vid="AMO 5:16">a ta uwwa yisali ya̱ a̱tsuma̱lima̱ ba̱ta̱ suru a̱tsuma̱ a̱ lyuci.</para>
  <para style="q1" vid="AMO 5:16">E te ɗe acimbi a̱ ta̱wa̱ a yuwan mesun,</para>
  <para style="q2" vid="AMO 5:16">aza a na a gurai mesun lon a̱ ta̱ ta̱wa̱ a̱ da̱na̱ a̱ga̱nda̱ e mesun.<verse eid="AMO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17" />Reve A̱sulazuva a damma,</para>
  <para style="q2" vid="AMO 5:17">mesun ma̱ ta̱ da̱na̱ a̱tsuma̱ a̱ a̱ɗuma̱ a̱ ina̱bi a̱ ɗu suru.</para>
  <para style="q2" vid="AMO 5:17">Adama a na n to utula̱i e memere ma̱ ɗu, n ca ɗu oforo.<verse eid="AMO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18" />A̱tsuma̱lima̱ a ta cina ɗu, a̱ɗu na yaa pura urana wa̱ A̱sulazuva!</para>
  <para style="q2" vid="AMO 5:18">Nye ɗa urana wa̱ A̱sulazuva aa yuwan ɗu?</para>
  <para style="q2" vid="AMO 5:18">Urana u ndolo u ta̱ da̱na̱ irumbu agba ekan shi.<verse eid="AMO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19" />U to o'wo she damma vuma na sumayi kamu,</para>
  <para style="q2" vid="AMO 5:19">reve u riya̱ e ekere a biya.</para>
  <para style="q1" vid="AMO 5:19">Ko waru tsu za na uwai o u'wa,</para>
  <para style="q2" vid="AMO 5:19">u zuwai ekere a̱yi o uɓaɓu,</para>
  <para style="q2" vid="AMO 5:19">a̱vu yo ka̱ɗa̱ yi.<verse eid="AMO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20" />Urana wa̱ A̱sulazuva urana wi irumbu ɗa, agba ekan shi,</para>
  <para style="q2" vid="AMO 5:20">irumbu pici, babu ko ekan ko keꞌen shi?&gt;&gt;<verse eid="AMO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21" />Reve A̱sulazuva a damma,</para>
  <para style="q2" vid="AMO 5:21">&lt;&lt;N 'yuwan ta̱ a̱buki e itoni e idaba a̱ ɗu</para>
  <para style="q2" vid="AMO 5:21">waru maa uwwusa uyo'o wi iɓolo i la̱nga̱ i ɗu shi!<note caller="-" style="x"><char style="xo" closed="false">5:21-22 </char><char style="xt" closed="false"><ref loc="ISA 1:11-14">Ish 1:11-14</ref>.</char></note><verse eid="AMO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22" />Ko na̱ shi i ta̱wa̱a̱ mu</para>
  <para style="q2" vid="AMO 5:22">na̱ kucci vu ukula̱tosu ɗu,</para>
  <para style="q2" vid="AMO 5:22">na̱ kucci vi ishina ɗu, ma̱a̱ ushi le shi.</para>
  <para style="q1" vid="AMO 5:22">Waru ma̱a̱ ushi iliyamunga i ɗu i na i ri na̱ lipu shi</para>
  <para style="q2" vid="AMO 5:22">aza a na i ca numu</para>
  <para style="q2" vid="AMO 5:22">kucci muwwulai.<verse eid="AMO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="AMO 5:23" />I tawa mu ure nu uɗyo wu ishipa n ɗu!</para>
  <para style="q2" vid="AMO 5:23">Moo poloo mesun me ikumburu i ɗu atsuvu shi.<verse eid="AMO 5:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24" />Amma lyawa a yuwan uge'etosu u mejege,</para>
  <para style="q2" vid="AMO 5:24">waru u da̱na̱ uba̱ta̱ suru tsa̱ mini mo uɗolu ma na mee yeneshe.</para>
  <para style="q2" vid="AMO 5:24">A̱ɓula̱ waru tsu uɗolu u na wee 'yewe shi!<verse eid="AMO 5:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="AMO 5:25" />&lt;&lt;Isra'ila i ta̱wa̱a̱ mu ta̱ na̱ kucci nu ucasu</para>
  <para style="q2" vid="AMO 5:25">a̱tsuma̱ a a'wan amunga a̱tsumona?<verse eid="AMO 5:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="AMO 5:26" />Amma a̱vu i 'ya̱sa̱n ruma musula̱ n ɗu</para>
  <para style="q2" vid="AMO 5:26">aza a na i yuwayin aciya̱ɗu,</para>
  <para style="q1" vid="AMO 5:26">va Sikot a̱ma̱li a na i ɗeyi mogono,</para>
  <para style="q2" vid="AMO 5:26">na̱ Kaiwan a̱ma̱li a̱ ɗu yi iroci italyo'o.<verse eid="AMO 5:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="AMO 5:27" />Amma a̱vu A̱sulazuva a damma,</para>
  <para style="q2" vid="AMO 5:27">za na ala a̱ yi a ɗa A̱sula̱ o oɓolo a̱ a̱soja a zuva,</para>
  <para style="q1" vid="AMO 5:27">adama o ndolo n ta̱ ca̱co ɗu a̱ tyo e iɗa i ro tsugbashi asana na̱ Dimaska.&gt;&gt;<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s">Ukototosu wa aza a Isra'ila</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="AMO 6:1" />&lt;&lt;A̱tsuma̱lima̱ a ta cina aza a na a̱ ri a̱ nden m mawwa mo uyo'o</para>
  <para style="q2" vid="AMO 6:1">a̱tsuma̱ a̱ Sihiyona,</para>
  <para style="q1" vid="AMO 6:1">na aza a na e inda a̱ ta̱</para>
  <para style="q2" vid="AMO 6:1">a̱ nden n lafiya a Masasan ma Samariya,</para>
  <para style="q1" vid="AMO 6:1">a̱ɗu na i ri ama a gbagbain</para>
  <para style="q2" vid="AMO 6:1">a nɗa n na e revei nda,</para>
  <para style="q1" vid="AMO 6:1">a̱ɗu na aza a Isra'ila a̱ 'ya̱wusa̱</para>
  <para style="q2" vid="AMO 6:1">izami yi ikambishi ya̱'a̱ ɗu!<verse eid="AMO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 6:2" />Gawain i 'ya̱wa̱ a̱ lyuci va Kalne ye ene yi,</para>
  <para style="q2" vid="AMO 6:2">diga ɗe reve i 'ya̱wa̱ Hamat lyuci gbain.</para>
  <para style="q2" vid="AMO 6:2">Reve i zura̱ a̱ cipa̱ a̱ lyuci va Gat a Filistiya.</para>
  <para style="q1" vid="AMO 6:2">A la'a ta̱ ba̱ta̱ re tsugono tsa̱ ɗu?</para>
  <para style="q2" vid="AMO 6:2">Iɗa i le i la'a ta̱ za ɗu mgbain?<verse eid="AMO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 6:3" />Wo yo'ono ɗu shi,</para>
  <para style="q2" vid="AMO 6:3">a̱ɗu na i dammai urana wa̱ a̱tsuma̱lima̱ a̱ ta̱wa̱ shi,</para>
  <para style="q1" vid="AMO 6:3">amma linga vi iwuya i ɗu</para>
  <para style="q2" vid="AMO 6:3">ta̱ ca̱cosu urana'a u ta̱wa̱ zuzu!<verse eid="AMO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 6:4" />Wo yo'ono ɗu, a̱ɗu na i ri o vosun</para>
  <para style="q2" vid="AMO 6:4">a̱ a̱ga̱da̱ a na a yuwain na anga a agiwa shi,</para>
  <para style="q1" vid="AMO 6:4">reve yi ba̱ruwa̱</para>
  <para style="q2" vid="AMO 6:4">a apada o uga'an.</para>
  <para style="q1" vid="AMO 6:4">A tamasa inama yi ikyon diga a̱tsuma̱ o oɓolo a̱ ɗu</para>
  <para style="q2" vid="AMO 6:4">na̱ ma̱dindim n na n ri na̱ lipu.<verse eid="AMO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 6:5" />A canasa ishipa na̱ maɗata ma̱ kumburu,</para>
  <para style="q2" vid="AMO 6:5">a majiyan tsuwe'e tsa̱ ɗu cu'un va̱ Da̱wuda ɗa.<verse eid="AMO 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 6:6" />I to sowuso masayan ma̱ ina̱bi</para>
  <para style="q2" vid="AMO 6:6">a munda,</para>
  <para style="q2" vid="AMO 6:6">waru i ta putalasa mani'in me ikebe,</para>
  <para style="q1" vid="AMO 6:6">agba i yuwan a̱tsumola̱ngu adama o ulungusu wu ugundo wa̱ Isuhu shi.<verse eid="AMO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7" />Ili yi lo shi a̱ɗu ɗa aza a na a fara</para>
  <para style="q2" vid="AMO 6:7">pura̱ a̱ tyo tsugbashi,</para>
  <para style="q1" vid="AMO 6:7">a̱buki a̱ɗu na̱ mawwa mo uyo'o u ɗu</para>
  <para style="q2" vid="AMO 6:7">o to koto.&gt;&gt;<verse eid="AMO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 6:8" />A̱sulazuva mogono me Ili Suru ma kucina ta̱ na aciya̱yi,</para>
  <para style="q2" vid="AMO 6:8">a̱yi A̱sula̱ o oɓolo a̱ a̱soja a zuva a damma ta̱,</para>
  <para style="q1" vid="AMO 6:8">&lt;&lt;N ciga uvaɗu wu ugundo wa Yakubu shi,</para>
  <para style="q2" vid="AMO 6:8">n 'yuwan ta̱ ba̱ta̱ vu ucira va̱ yi.</para>
  <para style="q1" vid="AMO 6:8">N ta ca lyuci'i</para>
  <para style="q2" vid="AMO 6:8">oɓolo ni ili i na i ri pe suru e ekere a n'yuwatan.&gt;&gt;<verse eid="AMO 6:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />Ko na̱ shi ama kupa a ɗa a buwai a̱tsuma̱ o u'wa u ta̱, a̱ ta̱ kuwa̱. <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />Waru na̱ mmaci n na ma̱a̱ ciɗo lipu le a̱ ta̱wa̱ adama a tanu lipu le o uta̱ a alanga a̱vu e ece za na buwai pe upa'awun, &lt;&lt;Nanza buwa ta̱ pe oɓolo na̱ a̱vu?&gt;&gt; N na̱ a̱ usu, &lt;&lt;O'o,&gt;&gt; za yeci'i u damma, &lt;&lt;Rungwa̱i! She ɗe ala a̱ A̱sulazuva wan adama she ili i ro i cina wan.&gt;&gt;<verse eid="AMO 6:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 6:11" />Agba a̱ yi ɗa nda A̱sulazuva a cayi udammu,</para>
  <para style="q2" vid="AMO 6:11">o ɓoso u'wa u gbain wo o'wo ma̱buta̱,</para>
  <para style="q2" vid="AMO 6:11">u'wa u ke'en waru a̱ ka̱mba̱to yi okomo.<verse eid="AMO 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12" />Ido i tsu suma ta̱ a atali?</para>
  <para style="q2" vid="AMO 6:12">Ko a ta gura cimba mala ni inan yi iluma?</para>
  <para style="q1" vid="AMO 6:12">Amma i tsu vadala ta̱ uge'etosu u mejege wo o'wo tsukono,</para>
  <para style="q2" vid="AMO 6:12">wuma wa̱ a̱ɓula̱ waru okono.<verse eid="AMO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 6:13" />A̱ɗu na i ri a̱ ma̱za̱nga̱</para>
  <para style="q2" vid="AMO 6:13">adama a na i lyuwai a aci</para>
  <para style="q2" vid="AMO 6:13">e ekere a̱ lyuci va Lo Deba, za na a tarai ili shi,</para>
  <para style="q1" vid="AMO 6:13">a dansa, &lt;&lt;Nu ucira u tsu u ɗa</para>
  <para style="q2" vid="AMO 6:13">tsu lyuwai Karmayim shi?&gt;&gt;<verse eid="AMO 6:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 6:14" />Reve A̱sulazuva a damma,</para>
  <para style="q2" vid="AMO 6:14">&lt;&lt;A̱yi ɗa nda, n ta̱ 'ya̱sa̱n nɗa n ro</para>
  <para style="q2" vid="AMO 6:14">na a yuwan tsushu'un na̱ ɗu aza a Isra'ila.</para>
  <para style="q2" vid="AMO 6:14">Nɗa n ta̱ ɓongi ɗu</para>
  <para style="q2" vid="AMO 6:14">diga o uwata wu upasu wa Lebo Hamat</para>
  <para style="q2" vid="AMO 6:14">a̱ tyo o Uka̱ri wa Araba.&gt;&gt;<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s">Alavu alavu a apapari</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />Apa nda ili i na A̱sulazuva Mogono me Ili Suru mo roco numu a alavu alavu. Me enei ta̱ o foɓuso oɓolo a apapari a na ri wa'a shi a mantsa ma na o kotoi ugasa adama o mogono, una̱ta̱ na mantsa ma na wunlya wo utusa̱. <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />A̱tsuma̱ alavu alavu'u, me ene ta̱ apapari'i a tamai a̱vu'un o uta̱nu suru a̱tsuma̱ e iɗa'a, reve n damma,</para>
  <para style="q1" vid="AMO 7:2">&lt;&lt; A̱sulazuva Mogono me Ili Suru, n te e ipati ya̱ wu,</para>
  <para style="q2" vid="AMO 7:2">vu yuwaan ama a̱ wu gafura!</para>
  <para style="q1" vid="AMO 7:2">Cine a yuwan limatan va Yakubu la'a?</para>
  <para style="q2" vid="AMO 7:2">Ele na ri wa'a!&gt;&gt;<verse eid="AMO 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 7:3" />Reve A̱sulazuva a̱ bula̱ ifoɓi ya̱ yi,</para>
  <para style="q2" vid="AMO 7:3">u damma, &lt;&lt;Ili i nda yaa fara shi.&gt;&gt;<verse eid="AMO 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />Reve A̱sulazuva Mogono me Ili Suru ma̱ da̱shi roco mu alavu alavu o ro. A̱vu me ene A̱sulazuva zagbain e ɗesu akina u ge'eto a ama a̱yi. A̱vu akina'a a lyuwa mala ma na ma̱ ri a̱ru'un lon, hali fo a lyuwusa iɗa'a. <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />Ɗaɗa n dammai,</para>
  <para style="q1" vid="AMO 7:5">&lt;&lt;A̱sulazuva zagbain, yuwan ankuri</para>
  <para style="q2" vid="AMO 7:5">vu lyawa!</para>
  <para style="q1" vid="AMO 7:5">Cine a yuwan limatan va Yakubu la'a?</para>
  <para style="q2" vid="AMO 7:5">Ele na ri wa'a!&gt;&gt;<verse eid="AMO 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 7:6" />A̱vu A̱sulazuva a vadala ifoɓi ya̱ yi,</para>
  <para style="q2" vid="AMO 7:6">&lt;&lt;Ili ya̱ ndolo ya fara shi.</para>
  <para style="q1" vid="AMO 7:6">A̱mu A̱sulazuva a ɗa n dammai ne.&gt;&gt;<verse eid="AMO 7:6" /></para>
  <para style="s">Alavu alavu amunga o ritosu wu usaa</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />Apa nda ili i na A̱sulazuva a̱ da̱shi roco numu: A̱tsuma̱ alavu'u, me enei ta̱ mishin zuzu nu uɓaɓu u ro u na a suwai na amunga o uritosu wu usaa. A̱sulazuva'a u da̱na̱ ta̱ uguzu na amunga o uritosu wu usa'a o ukere wa̱ yi.<verse eid="AMO 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 7:8" />Reve A̱sulazuva a damma mu,</para>
  <para style="q2" vid="AMO 7:8">&lt;&lt;Emos, nye vee enei?&gt;&gt;</para>
  <para style="q1" vid="AMO 7:8">Reve n usu, &lt;&lt;Amunga o uritosu wu usaa.&gt;&gt;</para>
  <para style="q2" vid="AMO 7:8">Reve A̱sulazuva a damma,</para>
  <para style="q1" vid="AMO 7:8">&lt;&lt;Na amayun na amunga o uritosu wu usaa u nda u ɗa</para>
  <para style="q2" vid="AMO 7:8">mo roco cine ama a̱ va̱ aza a Isra'ila</para>
  <para style="q1" vid="AMO 7:8">e remei uɓaɓu u na u ka̱ra̱i mejege shi.</para>
  <para style="q2" vid="AMO 7:8">Ma̱a̱ da̱shi rungwa̱ nusu le shi.<verse eid="AMO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 7:9" />O to ɓoso ba̱ta̱ va̱ a̱ga̱nda̱</para>
  <para style="q2" vid="AMO 7:9">vu ugundo wa̱ Ishiyaku,</para>
  <para style="q2" vid="AMO 7:9">na̱ ba̱ta̱ va̱ a̱ga̱nda̱ a Isra'ila</para>
  <para style="q2" vid="AMO 7:9">waru o to o'wo okongo.</para>
  <para style="q1" vid="AMO 7:9">N ta̱ 'ya̱sa̱n matsun me pe'eni mo uvon</para>
  <para style="q1" vid="AMO 7:9">nla̱ngi nu u'wa wa Yerobowam.&gt;&gt;<verse eid="AMO 7:9" /></para>
  <para style="s">Emos na̱ Amaziya</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />Reve Amaziya ganu ve Betel lyungu ni ikaka uba̱ta̱ wa̱ Yerobowam mogono ma Isra'ila adansa, &lt;&lt;Apa Emos a yuwusan ifoɓi a aci a̱ wu a̱tsuma̱ o u'wa wa Isra'ila. Ili i na wa dansa ta̱ 'ya̱sa̱n ugbozu wi iɗa'a. <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />Adama a na Emos ta dansa,</para>
  <para style="q1" vid="AMO 7:11">&lt;&lt; &lt;Yerobowam ta̱ kuwa̱ a̱tsuma̱ o uvon,</para>
  <para style="q2" vid="AMO 7:11">waru a̱ ta̱ pura̱ ama a Isra'ila a̱ tyo tsugbashi</para>
  <para style="q2" vid="AMO 7:11">diga e iɗa i le a̱ tyo iɗa i ro.&gt; &gt;&gt;<verse eid="AMO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />Reve Amaziya damma Emos, &lt;&lt;A̱vu za yindi! Suma a̱ tyo e iɗa ya Yahuda, vu zami ɗe ilyalya ya̱ wu, a̱vu vu yuwan adanshi e ikaka ya̱ A̱sula̱ a̱ wu ɗe. <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />Amma she vu da̱shi yuwan adanshi e ikaka ya̱ A̱sula̱ a̱tsuma̱ e Betel wan. Adama a na Betel uba̱ta̱ wa̱ a̱ga̱nda̱ o mogono ma ɗa, waru pa ɗa A̱a̱'isamapaɗa o tsugono tsa̱ yi tsa̱ ri.&gt;&gt;<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />A̱vu Emos usu Amaziya u damma, &lt;&lt;A̱mu vumava̱sula̱ ɗa shi, waru ulinga u nda ulinga u va̱ u ɗa shi. A̱mu za va aguɓa ɗa n shi, waru n shi ta̱ a̱ ka̱lyuwusa̱ ɗanga vu ubiri. <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />Reve A̱sulazuva a tara mu diga uba̱ta̱ wa aguɓa e ikyon, a̱vu u damma mu, &lt;'Ya̱wa̱ vu yuwaan ama a̱ va̱ aza a Isra'ila adanshi e ikaka ya̱ A̱sula̱.&gt;<verse eid="AMO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 7:16" />&lt;&lt;To, gogo vu uwwa adanshi A̱sulazuva,</para>
  <para style="q2" vid="AMO 7:16">a̱vu na va dansa</para>
  <para style="q1" vid="AMO 7:16">she n yuwan adanshi e ikaka ya̱ A̱sula̱ a aci o u'wa wa Isra'ila wan,</para>
  <para style="q2" vid="AMO 7:16">waru she n yuwan alajiya a aci o u'wa wa Ishiyaku wan.<verse eid="AMO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 7:17" />Adama o ndolo apa nda ili i na A̱sulazuva dammai,</para>
  <para style="q2" vid="AMO 7:17">&lt;Ka va̱ wu to o'wo aashakala a̱tsuma̱ a̱ lyuci,</para>
  <para style="q1" vid="AMO 7:17">muwun ma̱ wu olobo ne esheli,</para>
  <para style="q2" vid="AMO 7:17">oto o una le na̱ matsun me pe'eni.</para>
  <para style="q1" vid="AMO 7:17">Waru e te e ne'eshen iɗa ya̱ wu na amunga o uritosu,</para>
  <para style="q2" vid="AMO 7:17">a̱vu na aciya̱wu waru vu ta̱ kuwa̱ e iɗa yi idaba.</para>
  <para style="q1" vid="AMO 7:17">Waru ama a Isra'ila itamaha yi lo shi a̱ ta̱ pura̱ le</para>
  <para style="q2" vid="AMO 7:17">diga a̱tsuma̱ e iɗa i le a̱ tyo e iɗa i ro tsugbashi.&gt; &gt;&gt;<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s">Alavu alavu a Aasaka o umatsun wu ɗanga</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />Apa nda alavu alavu o ro na A̱sulazuva Mogono me Ili Suru o rocowiso numu: A̱tsuma̱ a̱ yi me ene ta̱ aasaka o ro tapu nu umatsun wu ɗanga winu. <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />Reve A̱sulazuva a damma,</para>
  <para style="q1" vid="AMO 8:2">&lt;&lt;Emos nye ve enei?&gt;&gt;</para>
  <para style="p" vid="AMO 8:2">A̱vu n usu, &lt;&lt;Aasaka nu umatsun wu ɗanga winu.&gt;&gt;</para>
  <para style="p" vid="AMO 8:2">Reve u damma mu,</para>
  <para style="q1" vid="AMO 8:2">&lt;&lt;A̱tyo ama a̱ va̱ aza a Isra'ila rawa ta̱,</para>
  <para style="q2" vid="AMO 8:2">ma̱a̱ da̱shi rungwa̱ le shi.<verse eid="AMO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 8:3" />A̱tsuma̱ o urana u ndolo ishipa i le a̱tsuma̱ A̱a̱'isamapaɗa</para>
  <para style="q2" vid="AMO 8:3">o to o'wo mesun ma̱ a̱tsumola̱ngu.&gt;&gt;</para>
  <para style="q2" vid="AMO 8:3">A̱vu A̱sulazuva Mogono me Ili Suru damma,</para>
  <para style="q1" vid="AMO 8:3">&lt;&lt;A̱kwa̱kwa̱ a ta yuwan a̱bunda̱,</para>
  <para style="q2" vid="AMO 8:3">a̱ ta̱ da̱na̱ uba̱ta̱ biti!</para>
  <para style="q2" vid="AMO 8:3">Ko ilama aa uwwa shi!&gt;&gt;<verse eid="AMO 8:3" /></para>
  <para style="s">Ukosu wa Isra'ila</para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4" />Uwwai nda,</para>
  <para style="q2" vid="AMO 8:4">a̱ɗu aza a na yo ɓongishi alambi</para>
  <para style="q2" vid="AMO 8:4">i to kototosu alambi e iɗa'a.<verse eid="AMO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 8:5" />I ta dansa aciya̱ɗu,</para>
  <para style="q2" vid="AMO 8:5">&lt;&lt;Mantsa ma̱ ne ma ɗa A̱buki o Woto u Sa'avu a̱ ka̱ra̱,</para>
  <para style="q2" vid="AMO 8:5">adama tsu wina itana ya̱ a̱ɗuma̱ a̱ tsu?</para>
  <para style="q1" vid="AMO 8:5">Hali urana u ne ɗa urana u wivuwun wa Ashibi o koto,</para>
  <para style="q2" vid="AMO 8:5">adama tsu tsura̱ mantsa ma na tsa̱ 'ya̱wa̱ na̱ yitabo awina?</para>
  <para style="q1" vid="AMO 8:5">A̱tsuma̱ atsulu a̱ tsu na a wina, tsu ta yuwan akunda nu ugbozu,</para>
  <para style="q1" vid="AMO 8:5">tsu lapa ugundo makundatsu</para>
  <para style="q2" vid="AMO 8:5">cine tsa paala za va atsulu.<verse eid="AMO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6" />Tsu ta gura tsula za vu ulambu</para>
  <para style="q2" vid="AMO 8:6">na̱ azurufa wo o'wo aagbashi a̱ tsu,</para>
  <para style="q2" vid="AMO 8:6">za na fo ili ya damatosun o una̱ wa atan a̱ta̱.</para>
  <para style="q1" vid="AMO 8:6">Waru tsu wina itana yu uɗuma̱ i na i ri ulobonu shi ni ikebe lon.&gt;&gt;<verse eid="AMO 8:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 8:7" />A̱sulazuva za na Yakubu ri a yuwusan uvaɗu na̱ a̱yi,</para>
  <para style="q2" vid="AMO 8:7">kucina ta̱ u damma,</para>
  <para style="q1" vid="AMO 8:7">&lt;&lt;Na amayun me icina na̱ linga vi iwuya i ɗu shi ko ke'en.&gt;&gt;<verse eid="AMO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 8:8" />&lt;&lt;Iɗa i ta̱ je'en lipu adama a̱ nusu ɗu,</para>
  <para style="q2" vid="AMO 8:8">za na ri pe a̱tsuma̱ a̱ yi suru ta yuwan a̱tsumola̱ngu,</para>
  <para style="q1" vid="AMO 8:8">u ta̱ 'yon u usuɗuwa</para>
  <para style="q2" vid="AMO 8:8">u cipa̱ tsu Uɗolu wa̱ Nilu,</para>
  <para style="q2" vid="AMO 8:8">babu asuvu nden.&gt;&gt;<verse eid="AMO 8:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 8:9" />A̱vu A̱sulazuva a damma,</para>
  <para style="q2" vid="AMO 8:9">&lt;&lt;O urana u ndolo,</para>
  <para style="q1" vid="AMO 8:9">n ta zuwa urana uriya̱ nu urana aci,</para>
  <para style="q2" vid="AMO 8:9">nu urana uvaɗi u ta̱ rumba̱na̱.&gt;&gt;<verse eid="AMO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 8:10" />N ta vadala a̱buki a̱ ɗu</para>
  <para style="q2" vid="AMO 8:10">wo o'wo a̱tsumola̱ngu.</para>
  <para style="q1" vid="AMO 8:10">Ishipa i ɗu suru</para>
  <para style="q2" vid="AMO 8:10">o to o'wo mesun ma̱ wiruta̱.</para>
  <para style="q1" vid="AMO 8:10">N ta zuwa akashi amuna o'wo ɗu itana yu otosu,</para>
  <para style="q2" vid="AMO 8:10">a̱vu mo o'woto aaci ɗu suru no ogbondo.</para>
  <para style="q1" vid="AMO 8:10">I ta yuwan mesun tsa a ama a na a lambai</para>
  <para style="q2" vid="AMO 8:10">mawun ma̱ ta̱ gba̱ɗa̱ gba̱ɗa̱ a na ri na̱ yi.</para>
  <para style="q2" vid="AMO 8:10">A cina ukosu, urana'a u to o'wo okono lon!<verse eid="AMO 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 8:11" />A̱vu A̱sulazuva Mogono me Ili Suru damma,</para>
  <para style="q2" vid="AMO 8:11">&lt;&lt;Na amayun rana ndolo ta̱ lo a̱ ta̱wa̱</para>
  <para style="q2" vid="AMO 8:11">na ma̱a̱ lyungu ambulu e iɗa'a.</para>
  <para style="q1" vid="AMO 8:11">Agba ambulu e ilyalya a ɗa shi ko gba akuli a̱ mini shi,</para>
  <para style="q2" vid="AMO 8:11">amma ambulu a mawwa ma adanshi a̱ A̱sulazuva.<verse eid="AMO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12" />Ama e te reme agara</para>
  <para style="q2" vid="AMO 8:12">diga a mala a̱ tyo a mala,</para>
  <para style="q2" vid="AMO 8:12">diga ugana a̱ tyo asana.</para>
  <para style="q1" vid="AMO 8:12">A̱ ta̱ da̱na̱ e ilaɗi elime na̱ a̱ca̱pa̱,</para>
  <para style="q2" vid="AMO 8:12">e izami ya adanshi a̱ A̱sulazuva,</para>
  <para style="q2" vid="AMO 8:12">agba a̱ tsura̱ yi shi.<verse eid="AMO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 8:13" />O urana u ndolo,</para>
  <para style="q2" vid="AMO 8:13">esheli a sa'ani no olobo</para>
  <para style="q2" vid="AMO 8:13">a̱ ta̱ lima̱ adama a akuli.<verse eid="AMO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14" />Aza a na a yuwain akucunu</para>
  <para style="q2" vid="AMO 8:14">o una̱ wu unusu wa aza a Samariya, a dansa,</para>
  <para style="q1" vid="AMO 8:14">&lt;N kucina ta̱ na̱ ma̱sula̱ ma Dan,&gt;</para>
  <para style="q2" vid="AMO 8:14">ko, &lt;N kucina ta̱ na̱ ma̱sula̱ ma Biyasheba,&gt;</para>
  <para style="q1" vid="AMO 8:14">i cu'un ya ama o ndolo a̱ ta̱ riya̱</para>
  <para style="q2" vid="AMO 8:14">agba a̱a̱ da̱shi 'yon shi ko ke'en.&gt;&gt;<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s">O to kototo aza a Isra'ila</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />Me ene ta̱ A̱sulazuva mishin zuzu na̱ masa'a,</para>
  <para style="q1" vid="AMO 9:1">a̱vu u damma,</para>
  <para style="q1" vid="AMO 9:1">&lt;&lt;Ga̱la̱ zuva va atsura'a</para>
  <para style="q2" vid="AMO 9:1">hali she na̱ nkyun ma̱ yi n jinga̱ɗa̱.</para>
  <para style="q1" vid="AMO 9:1">Vu ɓoso le adama usa'a u riya̱</para>
  <para style="q2" vid="AMO 9:1">a aci a ama suru.</para>
  <para style="q1" vid="AMO 9:1">Ama a na a la'ai,</para>
  <para style="q2" vid="AMO 9:1">matsun me pe'eni mo to una le.</para>
  <para style="q1" vid="AMO 9:1">Babu za na aa suma reve u la'a,</para>
  <para style="q2" vid="AMO 9:1">ko za aa la'a shi.<verse eid="AMO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2" />Ko na̱ ka̱pa̱ a̱ka̱ri</para>
  <para style="q2" vid="AMO 9:2">a̱ cipa̱ a̱ tyo uba̱ta̱ wa̱ a̱kwa̱kwa̱,</para>
  <para style="q2" vid="AMO 9:2">n ta zuwa ukere u va̱ u reme le pe.</para>
  <para style="q1" vid="AMO 9:2">Ko na a kumba a gawan zuva,</para>
  <para style="q2" vid="AMO 9:2">diga ɗe n ta̱ cipa̱to le.<verse eid="AMO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3" />Ko na a pa'aton aciyele</para>
  <para style="q2" vid="AMO 9:3">a̱ ncilecile m Masasan ma Kame,</para>
  <para style="q2" vid="AMO 9:3">n ta̱ bunga̱ le ɗe a̱vu n reme le.</para>
  <para style="q1" vid="AMO 9:3">Ko na a pa'aton aciyele diga uba̱ta̱ u va̱</para>
  <para style="q2" vid="AMO 9:3">o ugundo u mala,</para>
  <para style="q2" vid="AMO 9:3">ɗe ɗa maa zuwa yo vu ka̱ɗa̱ le.<verse eid="AMO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4" />Ko na̱ n'yuwatan n le n shi m pura̱ le a 'ya̱wa̱ tsugbashi,</para>
  <para style="q2" vid="AMO 9:4">ɗe'e n ta zuwa matsun me pe'eni mo una le.</para>
  <para style="q1" vid="AMO 9:4">N ta varaa le esu a̱ va̱</para>
  <para style="q2" vid="AMO 9:4">adama e iwuya agba adama e isa'ani shi.&gt;&gt;<verse eid="AMO 9:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5" />A̱sulazuva A̱sula̱ o oɓolo a̱ a̱soja a zuva,</para>
  <para style="q2" vid="AMO 9:5">a̱yi ɗa za na tsu ju'wa̱n uvaɗi a̱vu wu jeruwe,</para>
  <para style="q1" vid="AMO 9:5">reve aza a na a̱ ri pe nden a yuwan a̱tsumola̱ngu,</para>
  <para style="q2" vid="AMO 9:5">reve suru va̱ yi u 'yon</para>
  <para style="q2" vid="AMO 9:5">a̱vu u cipa̱ tsu Uɗolu wa̱ Nilu va Masar,<verse eid="AMO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6" />a̱yi za na suwai dasata va zuva,</para>
  <para style="q2" vid="AMO 9:6">reve u yuwan ikyun ya̱ yi o uvaɗi,</para>
  <para style="q1" vid="AMO 9:6">za na tsu ɗe mini ma mala</para>
  <para style="q2" vid="AMO 9:6">reve wo oco le o urewesu wu uvaɗi,</para>
  <para style="q1" vid="AMO 9:6">A̱sulazuva a ɗa ala a̱yi.<verse eid="AMO 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 9:7" />A̱vu A̱sulazuva a damma, &lt;&lt;A̱ɗu aza a Isra'ila,</para>
  <para style="q2" vid="AMO 9:7">una̱ta̱ u ɗa i ri na̱ a̱za̱ a̱ Kush e ekere a̱ va̱ shi?</para>
  <para style="q1" vid="AMO 9:7">Na amayun mu uta̱ ɗu aza a Isra'ila diga e iɗa ya Masar,</para>
  <para style="q2" vid="AMO 9:7">na aza a Filistiya diga e iɗa ya Karita</para>
  <para style="q2" vid="AMO 9:7">na aza a Suriya diga e iɗa ya Kir shi?<verse eid="AMO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8" />A̱yi ɗa nda, esu A̱sulazuva Mogono me Ili Suru</para>
  <para style="q2" vid="AMO 9:8">ta̱ ka̱lyuwusa̱ tsugono tsu ulambu wa̱ a̱ɓula̱ a nda.</para>
  <para style="q1" vid="AMO 9:8">N to kototo tsugono tsa nda diga o urewesu wu uvaɗi,</para>
  <para style="q2" vid="AMO 9:8">she de moo kototo u'wa wa Yakubu suru suru shi,&gt;&gt;</para>
  <para style="q1" vid="AMO 9:8">A̱mu A̱sulazuva a ɗa n dammai ne.<verse eid="AMO 9:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9" />A̱yi ɗa nda ma ca udammu,</para>
  <para style="q2" vid="AMO 9:9">n'yuwatan n ɗu a̱ susa̱ u'wa wa Isra'ila</para>
  <para style="q1" vid="AMO 9:9">cine a̱ tsu susa̱ wuyun</para>
  <para style="q2" vid="AMO 9:9">a̱tsuma̱ a atali,</para>
  <para style="q2" vid="AMO 9:9">babu aatali a na a̱ riya̱ a̱tsuma̱ a̱ wuyun.</para>
  <para style="q1" vid="AMO 9:9">A ta vari a̱za̱ e iwuya,</para>
  <para style="q2" vid="AMO 9:9">a̱za̱ a̱ a̱ɓula̱ fo a ta bete'we le</para>
  <para style="q2" vid="AMO 9:9">a̱tsuma̱ a nɗa.<verse eid="AMO 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10" />A̱za̱ o unusu a̱tsuma̱ a ama a̱ va̱ suru</para>
  <para style="q2" vid="AMO 9:10">a̱ ta̱ kuwa̱ o una̱ u matsun me pe'eni,</para>
  <para style="q1" vid="AMO 9:10">aza a na aa dansa,</para>
  <para style="q2" vid="AMO 9:10">&lt;&lt;Babu lo a̱tsuma̱lima̱ a na aa cina tsu</para>
  <para style="q2" vid="AMO 9:10">ko u reme tsu shi.&gt;&gt;<verse eid="AMO 9:10" /></para>
  <para style="s">Uka̱mba̱tosu wa aza a Isra'ila</para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 9:11" />&lt;&lt;O urana u ndolo n ta̱ 'ya̱sa̱n</para>
  <para style="q2" vid="AMO 9:11">Oogodo a̱ Da̱wuda a na a̱ shi a̱ riya̱i.</para>
  <para style="q1" vid="AMO 9:11">Reve n lapula ba̱ta̱ na la̱nga̱i,</para>
  <para style="q2" vid="AMO 9:11">a̱vu n da̱shi suwisa yi cine u shi nu ufaru.<note caller="-" style="x"><char style="xo" closed="false">9:11-12 </char><char style="xt" closed="false"><ref loc="ACT 15:16-18">Ajy 15:16-18</ref>. </char></note><verse eid="AMO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 9:12" />Ama a Isra'ila a ta usa suru</para>
  <para style="q2" vid="AMO 9:12">akapi e ili ya̱ Edom i na i buwai,</para>
  <para style="q1" vid="AMO 9:12">a̱vu fo a usa akapi a nɗa</para>
  <para style="q2" vid="AMO 9:12">na a̱ shi ee ɗesu na ala a̱ va̱.</para>
  <para style="q1" vid="AMO 9:12">A̱mu A̱sulazuva a ɗa n dammai ne, waru n to shiton yi.&gt;&gt;<verse eid="AMO 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 9:13" />A̱vu A̱sulazuva a damma,</para>
  <para style="q2" vid="AMO 9:13">&lt;&lt;Yashi i ta̱ lo a̱ ta̱wa̱ na za vu cimba</para>
  <para style="q2" vid="AMO 9:13">o toni a̱ca̱pa̱ a za vu ugasa.</para>
  <para style="q1" vid="AMO 9:13">Za mokpoko ma masayan ma̱ ina̱bi waru</para>
  <para style="q2" vid="AMO 9:13">a̱ca̱pa̱ a za vu ca̱'a̱n.</para>
  <para style="q1" vid="AMO 9:13">Nsasan n ta̱ da̱na̱ yenetosu</para>
  <para style="q2" vid="AMO 9:13">masayan ma sa'avu,</para>
  <para style="q1" vid="AMO 9:13">nsasan n wa'a wa'a waru a̱ ta̱ da̱na̱ o yenetosu</para>
  <para style="q2" vid="AMO 9:13">masayan ma̱ ina̱bi uba̱ta̱ suru.<verse eid="AMO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 9:14" />N ta̱ ka̱mbuwa̱ ama a̱ va̱ aza a Isra'ila na aba'un e le,</para>
  <para style="q2" vid="AMO 9:14">A ta suwisa ilyuci i na yo o'woi okongo,</para>
  <para style="q2" vid="AMO 9:14">a̱vu a̱ da̱nu pe.</para>
  <para style="q1" vid="AMO 9:14">A̱ ta̱ cu'wa̱n a̱ɗuma̱ a̱ ina̱bi a̱vu gba o sowo masayan me le,</para>
  <para style="q2" vid="AMO 9:14">a ta yuwan a̱rumbu a̱vu a lyuwa muwun mu ɗanga le.<verse eid="AMO 9:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="AMO 9:15" />N ta̱ shuwa̱ le e iɗa i le,</para>
  <para style="q2" vid="AMO 9:15">agba a̱a̱ da̱shi mula̱ le diga e iɗa i na n ca nle shi.&gt;&gt;</para>
  <para style="q1" vid="AMO 9:15">A̱sulazuva A̱sula̱ a̱ ɗu a ɗa a dammai ne.<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>