<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="OBA" style="id">- Tsishingini (tsw)</book>
  <para style="h">Obadiya</para>
  <para style="toc3">Oba</para>
  <para style="toc2">Obadiya</para>
  <para style="toc1">Obadiya</para>
  <para style="mt2">Obadiya</para>
  <para style="mt1">Obadiya</para>
  <para style="is">Ucuɗuwu wa aatagada a nda</para>
  <para style="ip">Mokoɗi ma atagada a nda a ɗanai ta̱ a mantsa ma addama cina Urishelima riya̱ a'wan ukpakuton na̱ kupakunla̱ na̱ a̱za̱ a̱ ta̱li (586) kafu limatan va̱ Yesu. A̱za̱ Edom na ri asana na̱ Urishelima, ele n'yuwatan ma̱ aza a Yahuda nɗa. A mantsa ma̱ a̱risa̱ a Urishelima reve a yuwan ma̱za̱nga̱ adama a̱tsuma̱lima̱ a̱za̱ e le, ko na she ene iliyali i le. Suru na̱ ne reve a uwa a̱ pura̱ itana i wa̱ta̱'a̱, a̱vu waru a kamba aza a na a̱ riya̱yi wa̱ta̱'a̱ nu uvon. Obadiya yuwan ta̱ adanshi e ikaka i na e ge'eto lyuci va̱ Edom, waru a lyuwai nu uvon cine a yuwan na akapi a n'yuwatan ma aza a Isra'ila.</para>
  <para style="iot">Ili i na i ri pe a̱tsuma̱ a aatagada a nda</para>
  <para style="io1">Uge'etosu wa̱ a̱za̱ Edom 1-14</para>
  <para style="io1">Urana wa̱ A̱sulazuva Zagbain 15-21</para>
  <para style="ib" />
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />Apa ikaka ya̱ A̱sulazuva zagbain na Obadiya enei a̱tsuma̱ alavu alavu adama e iɗa ya Edom.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="ISA 34:5-17">Ish 34:5-17</ref>; <ref loc="ISA 63:1-6">63:1-6</ref>; <ref loc="JER 49:7-22">Irm 49:7-22</ref>; <ref loc="EZK 25:12-14">Izk 25:12-14</ref>; <ref loc="EZK 35:1-15">35:1-15</ref>; <ref loc="AMO 1:11-12">Emo 1:11-12</ref>; <ref loc="MAL 1:2-5">Mal 1:2-5</ref>.</char></note></para>
  <para style="s" vid="OBA 1:1">Adanshi e ikaka ya̱ a̱risa̱ a̱ Edom</para>
  <para style="q1" vid="OBA 1:1">A̱ lyungu ta̱ na̱ malingata uba̱ta̱ wu nɗa,</para>
  <para style="q2" vid="OBA 1:1">waru tsu uwwa ta̱ wovon wi ikaka'a diga uba̱ta̱ wa̱ A̱sulazuva Zagbain adansa,</para>
  <para style="q2" vid="OBA 1:1">&lt;&lt;'Yon! Tsu ka̱ra̱ a gawan tsu yuwan uvon na̱ Edom!&gt;&gt;<verse eid="OBA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2" />A̱vu A̱sulazuva a damma,</para>
  <para style="q2" vid="OBA 1:2">&lt;&lt;Ka̱lyuwa̱, n ta̱ ka̱mba̱to wu lyuci ke'en suru suru</para>
  <para style="q1" vid="OBA 1:2">a̱tsuma̱ akapi a nɗa,</para>
  <para style="q2" vid="OBA 1:2">waru aa tara wu ili i ro shi ko ke'en.<verse eid="OBA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3" />Uvaɗu wo okolo a̱ wu a̱ luluma̱ wu ta̱,</para>
  <para style="q2" vid="OBA 1:3">a̱vu na vu ri upa'awun a̱tsuma̱ a atali,</para>
  <para style="q2" vid="OBA 1:3">waru za na ri nden a̱tsuma̱ a nsasan.</para>
  <para style="q1" vid="OBA 1:3">A̱tsuma̱ a majiyan vu ta dansa,</para>
  <para style="q2" vid="OBA 1:3">&lt;Zane ɗa aa gura cipa̱to mu e iɗa?&gt;<verse eid="OBA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4" />A̱vu A̱sulazuva a damma,</para>
  <para style="q1" vid="OBA 1:4">ko na̱ shi vu 'yon zuva tsa̱ a̱a̱kuru,</para>
  <para style="q2" vid="OBA 1:4">ko na̱ shi vu suwa ta̱ 'wa va̱ wu a̱tsuma̱ italyo'o n ɗa,</para>
  <para style="q2" vid="OBA 1:4">diga ɗe ɗa moo rono wu a̱cipa̱ e iɗa.&gt;&gt;<verse eid="OBA 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5" />&lt;&lt;Nna̱ evu a uwa ta̱ a̱tsuma̱ o u'wa wa̱ wu,</para>
  <para style="q2" vid="OBA 1:5">waru nna̱ a̱za̱ a̱ nga̱la̱la̱i a̱ ta̱wa̱ ta̱ na ayin,</para>
  <para style="q2" vid="OBA 1:5">ili i na a cigai goon ɗa a tara shi?</para>
  <para style="q1" vid="OBA 1:5">Nna̱ ozo o uta'an u muwun ina̱bi a yuwan uta'an,</para>
  <para style="q2" vid="OBA 1:5">to, a tsu lyawa ozo o ro adama a̱za̱ o u'yanlu shi?<verse eid="OBA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6" />Amma a̱ɗu ama a̱ Edom a̱za̱ o ugundo wa Isuwa,</para>
  <para style="q2" vid="OBA 1:6">a̱ ta̱ kototo ɗu,</para>
  <para style="q2" vid="OBA 1:6">utsuru u ɗu suru a̱ ta̱ pura̱ le!<verse eid="OBA 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7" />Ama a na i yuwulai nzuwulai suru</para>
  <para style="q2" vid="OBA 1:7">a ta vadala wu ucina̱.</para>
  <para style="q2" vid="OBA 1:7">O to loso wu hali a̱ tyo o utyo wi iɗa ya̱ wu.</para>
  <para style="q1" vid="OBA 1:7">N'utsa̱ ma̱ wu na vu la'a soɗuwoyi ma̱tsa̱n,</para>
  <para style="q2" vid="OBA 1:7">a̱ ta̱ pusa̱n ugbozu wa̱ wu a̱vu a lyuwa wu nu uvon,</para>
  <para style="q2" vid="OBA 1:7">aza a na a lyuwa ilyalya oɓolo na̱ a̱vu,</para>
  <para style="q2" vid="OBA 1:7">a ta azu wu agba ve reve na̱ yi shi.&gt;&gt;<verse eid="OBA 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8" />Reve A̱sulazuva Zagbain damma,</para>
  <para style="q2" vid="OBA 1:8">&lt;&lt;O urana u ndolo, n ta̱ kototo a̱za̱ a̱ Edom,</para>
  <para style="q2" vid="OBA 1:8">waru n kototo a̱za̱ o urevu wa̱ yi.</para>
  <para style="q1" vid="OBA 1:8">Nta̱ fo kototo ozo o ugbozu wa̱ yi</para>
  <para style="q2" vid="OBA 1:8">diga a masasan ma Isuwa.<verse eid="OBA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9" />A̱vu lyuci va Teman,</para>
  <para style="q2" vid="OBA 1:9">ali o uvon a̱ wu na la'a gurai uvon a̱ ta̱ je'en lipu,</para>
  <para style="q2" vid="OBA 1:9">waru a̱ ta̱ o una za suru a masasan ma Isuwa.&gt;&gt;<verse eid="OBA 1:9" /></para>
  <para style="s">Unusu wa̱ Edom</para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10" />&lt;&lt;Adama o okolo a vama a na vu rocoyi</para>
  <para style="q2" vid="OBA 1:10">moron ma̱ wu Yakubu,</para>
  <para style="q1" vid="OBA 1:10">Wono u ta̱ kpa̱to wu,</para>
  <para style="q2" vid="OBA 1:10">waru o to kototo wu hali hali.<verse eid="OBA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11" />A rana ndolo vu rono ta̱ a̱ca̱pa̱ diga uba̱ta̱ u moron ma̱ nden ma̱ wu,</para>
  <para style="q2" vid="OBA 1:11">a mantsa ma na omocin a uwai a̱ na̱ntsu va̱ yi.</para>
  <para style="q1" vid="OBA 1:11">A̱vu Edom vo o'wo ta̱ tsa za ta̱</para>
  <para style="q2" vid="OBA 1:11">a̱tsuma̱ a n'yuwatan</para>
  <para style="q2" vid="OBA 1:11">a mantsa ma na a̱ pura̱i utsuru wa̱ Urishelima</para>
  <para style="q2" vid="OBA 1:11">a̱vu fo a yuwan mazuwa ma agita aciya̱yi!<verse eid="OBA 1:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12" />&lt;&lt;Mejege ma ɗa vu yuwain shi,</para>
  <para style="q2" vid="OBA 1:12">na vi isawain e izo'oshi i moron ma̱ wu,</para>
  <para style="q2" vid="OBA 1:12">a̱tsuma̱ o urana u na a tara nle a̱ tyo e iɗa i ro tsugbashi.</para>
  <para style="q1" vid="OBA 1:12">Mejege ma ɗa vu yuwain shi,</para>
  <para style="q2" vid="OBA 1:12">reve vu yuwan ma̱za̱nga̱</para>
  <para style="q2" vid="OBA 1:12">o una̱ wa̱ a̱tsuma̱lima̱ a na ama a Yahuda o sowuso,</para>
  <para style="q1" vid="OBA 1:12">Mejege ma ɗa vu yuwain shi,</para>
  <para style="q2" vid="OBA 1:12">a na vu zo'oso niyi o urana wa̱ a̱tsuma̱lima̱ a̱ yi.<verse eid="OBA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13" />Mejege ma ɗa vu yuwain shi,</para>
  <para style="q2" vid="OBA 1:13">a na vu uwai a̱tsuma̱ lyuci va ama a̱ va̱ aza a Isra'ila,</para>
  <para style="q2" vid="OBA 1:13">reve vu pura̱ itana a mantsa ma addama me e le.</para>
  <para style="q1" vid="OBA 1:13">Mejege ma ɗa vu yuwain shi,</para>
  <para style="q2" vid="OBA 1:13">reve vu pura̱ itana a mantsa ma addama me e le.<verse eid="OBA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14" />Mejege ma ɗa vu yuwain shi,</para>
  <para style="q2" vid="OBA 1:14">a na vi isawain uba̱ta̱ wu nsanji</para>
  <para style="q2" vid="OBA 1:14">na vu unai aza a na a zama ala'a.</para>
  <para style="q1" vid="OBA 1:14">Mejege ma ɗa vu yuwain shi,</para>
  <para style="q2" vid="OBA 1:14">na vu cayi aza a na a zama la'a</para>
  <para style="q1" vid="OBA 1:14">e ekere a n'yuwatan nle,</para>
  <para style="q2" vid="OBA 1:14">a̱tsuma̱ o urana u na addama a cina nle.&gt;&gt;<verse eid="OBA 1:14" /></para>
  <para style="s">A̱ ta̱ ge'eto wu nɗa</para>
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15" />&lt;&lt;Urana u na a̱mu A̱sulazuva Zagbain</para>
  <para style="q2" vid="OBA 1:15">me ge'eto wu nɗa suru n yuwan ta̱ zuzu.</para>
  <para style="q1" vid="OBA 1:15">Cine vu yuwayin Isra'ila ne ɗa a yuwan wu,</para>
  <para style="q2" vid="OBA 1:15">waru iwuya ya̱ wu suru i ta̱ ka̱mba̱ aci a̱ wu.<verse eid="OBA 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16" />Cine ama a̱ va̱</para>
  <para style="q2" vid="OBA 1:16">o sowoi ugana wo okono</para>
  <para style="q2" vid="OBA 1:16">a Masasan ma Akiza,</para>
  <para style="q1" vid="OBA 1:16">ne ɗa akapi a nɗa o sowo a̱tsuma̱lima̱,</para>
  <para style="q2" vid="OBA 1:16">a̱ ta̱ da̱na̱ usowu hali o kototo le diga a̱tsuma̱ o uvaɗi.&gt;&gt;<verse eid="OBA 1:16" /></para>
  <para style="s">Ulyuwu wa aci wa aza a Isra'ila</para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17" />&lt;&lt;Amma zuva Masasan ma̱ Sihiyona,</para>
  <para style="q2" vid="OBA 1:17">akapi a ama a ta la'a,</para>
  <para style="q2" vid="OBA 1:17">waru u to o'wo uba̱ta̱ wa aza a akiza.</para>
  <para style="q1" vid="OBA 1:17">A̱za̱ o ugundo a Yakubu a ta usisa</para>
  <para style="q2" vid="OBA 1:17">ili ya agadu e le.<verse eid="OBA 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18" />Amma A̱sulazuva Zagbain damma ta̱, ugundo wa̱ Yakubu a̱ ta̱ da̱na̱ tsa akina,</para>
  <para style="q2" vid="OBA 1:18">u'wa wa Isuhu ta̱ da̱na̱ tsa e elentsu a akina.</para>
  <para style="q1" vid="OBA 1:18">Amma Edom ta̱ da̱na̱ tsa anlya o u'yewu,</para>
  <para style="q2" vid="OBA 1:18">Isra'ila ta̱ kula̱to le reve a tama le.</para>
  <para style="q2" vid="OBA 1:18">Babu vuma na a buwa diga a̱tsuma̱ o u'wa wa Isuwa.&gt;&gt;<verse eid="OBA 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19" />&lt;&lt;Amma ama a Nege o uyagi</para>
  <para style="q2" vid="OBA 1:19">o to o'wo na̱ Masasan ma Isuwa.</para>
  <para style="q1" vid="OBA 1:19">Aza a na a̱ ri e iɗa i mugaɗi ma Yahuda,</para>
  <para style="q2" vid="OBA 1:19">o to o'wo ni iɗa ya aza a Filistiya,</para>
  <para style="q2" vid="OBA 1:19">oɓolo ni iɗa ya Ifiramu na̱ Samariya.</para>
  <para style="q1" vid="OBA 1:19">Ugundo wa Banyami</para>
  <para style="q2" vid="OBA 1:19">u to o'wo nu upasu wi iɗa ya Giliyadu.<verse eid="OBA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20" />Ama a̱bunda̱ a Isra'ila</para>
  <para style="q2" vid="OBA 1:20">a na a̱ pura̱i a̱ 'ya̱wa̱ tsugbashi,</para>
  <para style="q1" vid="OBA 1:20">a̱ ta̱ ka̱mba̱ reve a usa iɗa ya Ka'ana</para>
  <para style="q2" vid="OBA 1:20">hali a̱ tyo o upasu wi iɗa ya Zarefat.</para>
  <para style="q1" vid="OBA 1:20">Waru ama a̱ Urishelima</para>
  <para style="q2" vid="OBA 1:20">aza a na a̱ pura̱i a̱ tyo tsugbashi a̱tsuma̱ a Sefarada</para>
  <para style="q2" vid="OBA 1:20">a̱ ta̱ ka̱mba̱ na a usa mulyuci ma Nege wu uyagi.<verse eid="OBA 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21" />A̱za̱ e iwawi</para>
  <para style="q2" vid="OBA 1:21">a ta kumba masasan ma Sihiyona ma̱ Urishelima</para>
  <para style="q2" vid="OBA 1:21">a usa masasan ma Isuwa.</para>
  <para style="q1" vid="OBA 1:21">A̱sulazuva Zagbain na aciya̱yi a ɗa</para>
  <para style="q2" vid="OBA 1:21">wa yuwan tsugono tsa le.&gt;&gt;<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>