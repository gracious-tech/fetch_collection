<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HAG" style="id">- Tsishingini (tsw)</book>
  <para style="h">Hagai</para>
  <para style="toc3">Hag</para>
  <para style="toc2">Hagai</para>
  <para style="toc1">Hagai</para>
  <para style="mt2">Hagai</para>
  <para style="mt1">Hagai</para>
  <para style="is">Ucuɗuwu wa aatagada a nda</para>
  <para style="ip">Aatagada a Hagai aatagada a ɗa a na o ɓolotoi ikaka i ke'en i ke'en a na a̱ ta̱wa̱i diga uba̱ta̱ wa̱ A̱sulazuva diga o una̱ u vumava̱sula̱ Hagai a̱tsuma̱ aa'wan ukpakukupa uton nu ushin kafu limatan va̱ Yesu. A mantsa'a, ama'a a̱ ka̱mba̱ ta̱ ɗe diga uba̱ta̱ u tsugbashi reve a̱ da̱nu a̱tsuma̱ a̱ Urishelima o una̱ wa a'wan meketeci, amma a̱vu a lyawa u'wa wa̱ A̱sulazuva a̱ nden mo okongo. Ikaka'a i ta̱ da̱shishi azagbai'in ukadu adama a na a̱ da̱shi suwisa U'wa wa̱ A̱sulazuva. Waru A̱sulazuva a yuwan ta̱ nzuwulai ma aba'un na̱ nden ma asuvu e ekere a ama a̱ yi, aza a na waa lapula nden nle a̱tyo elime.</para>
  <para style="iot">Ili i na i ri pe a̱tsuma̱ a aatagada a nda</para>
  <para style="io1">Udammu u na a suwisa U'wa wa̱ A̱sulazuva 1:1-15</para>
  <para style="io1">Ikaka yi nden ma asuvu nu uzuwu wo okolo 2:1-23.</para>
  <chapter number="1" style="c" sid="HAG 1" />
  <para style="s">Ɗewu adama o usaa wu u'wa wa̱ A̱sulazuva</para>
  <para style="p">
    <verse number="1" style="v" sid="HAG 1:1" />A̱tsuma̱ a aa'wan a̱ ire o mogono Dariyu, o woto wa̱ ta̱li o urana wu ufaru u woto'o, adanshi a̱ A̱sulazuva a̱ ta̱wa̱ ta̱ ya Hagai vumava̱sula̱ a̱ tyo ya Zerubabe ulobo wa Sheyatiye gwamna va Yahuda na̱ Josuwa ulobo wa Jehozada ganu gbain. <verse eid="HAG 1:1" /><verse number="2" style="v" sid="HAG 1:2" />Apa nda ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva a dammai, &lt;&lt;Ama a nda a ta dansa, &lt;Yashi koto i rawa a na aa suwa u'wa wa̱ A̱sulazuva shi.&gt; &gt;&gt;<verse eid="HAG 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HAG 1:3" />Reve adanshi a̱ A̱sulazuva a̱ ta̱wa̱ o una̱ wa vumava̱sula̱ Hagai. <verse eid="HAG 1:3" /><verse number="4" style="v" sid="HAG 1:4" />&lt;&lt;Mantsa ma ɗa a na a̱ɗu ya̱a̱ da̱nu a 'wa na a lapulai ulobonu, agba u'wa wa̱ A̱sulazuva a ɗa nda a̱ nden mo okongo?&gt;&gt;<verse eid="HAG 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HAG 1:5" />Gogo apa nda ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva dammai, &lt;&lt;Ka̱lyuwa̱i ili i na ya yuwusan a wuma u ɗu. <verse eid="HAG 1:5" /><verse number="6" style="v" sid="HAG 1:6" />I yuwan ta̱ ca̱'a̱n va̱ a̱bunda̱, a̱vu gba i gasa wa'a. I ta lyuwusa, agba i cuwa̱n shi. I to sowuso, agba u rawa ɗu shi. I to otosu itana, agba yaa uwwusa shen shen shi. Waru i ta̱ ushishi atsupu, adama i zuwa yi o oosonu a na a̱ ri uba̱mu.&gt;&gt;<verse eid="HAG 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HAG 1:7" />Apa nda ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva a dammai, &lt;&lt;Ka̱lyuwa̱i ili i na ya yuwusan a wuma u ɗu. <verse eid="HAG 1:7" /><verse number="8" style="v" sid="HAG 1:8" />Gawain zuva masasan i ta̱wa̱a̱ na akpata i suwisa u'wa'a, adama mu uwwa uyo'o a̱vu waru n tsura̱ tsugbain a̱tsuma̱ a̱yi,&gt;&gt; A̱sulazuva a ɗa dammai ne. <verse eid="HAG 1:8" /><verse number="9" style="v" sid="HAG 1:9" />&lt;&lt;I ta zuwusa okolo i tsura̱ na̱ a̱bunda̱, agba a̱yi ɗa nda wo o'woi wa'a. Waru ili i na i ta̱wa̱yi o u'wa, a̱vu mi ivula̱ yi. Adama a̱ nye?&gt;&gt; A̱sulazuva o oɓolo a̱ a̱soja a zuva a ɗa a dammai ne. &lt;&lt;Adama o u'wa u va̱ u na u ri okongo, a̱ɗu ɗa nda gba koyan o mpolo mu u'wa wa̱ yi. <verse eid="HAG 1:9" /><verse number="10" style="v" sid="HAG 1:10" />Adama o ndolo, zuva putsaa ta̱ na a'iza, reve uvaɗi u putsaa ni itana yu uɗuma̱. <verse eid="HAG 1:10" /><verse number="11" style="v" sid="HAG 1:11" />Reve gba n ta̱wa̱a̱ nu ulambu wi iro'i e iɗa'a na̱ nsasan, ne e ishina, ne e ili i na iɗa i tsu matsan suru, nu uba̱ta̱ wa ama ni inama, no o ulinga we ekere ɗu suru.&gt;&gt;<verse eid="HAG 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HAG 1:12" />Reve Zerubabe ulobo wa Sheyatiye na̱ Josuwa ulobo wa Jehozada ganu gbain, oɓolo na akapi a ama suru a yuwan tsutoni nu uɗyo wa̱ A̱sulazuva A̱sula̱ e le, na adanshi a Hagai vumava̱sula̱ za na A̱sulazuva A̱sula̱ e le a̱ lyunguyi. Reve ama a uwwa wovon wa̱ A̱sulazuva.<verse eid="HAG 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HAG 1:13" />Reve Hagai malingata ma̱ A̱sulazuva ma damma ama ikaka ya̱ A̱sulazuva, &lt;&lt;N to oɓolo na̱ a̱ɗu,&gt;&gt; A̱sulazuva a ɗa a dammai ne. <verse eid="HAG 1:13" /><verse number="14" style="v" sid="HAG 1:14" />Reve A̱sulazuva a̱ 'ya̱sa̱n ruhu va Zerubabe ulobo wa Sheyatiye gwamna va Yahuda na̱ ruhu va̱ Josuwa ganu gbain ulobo wa Jehozada, oɓolo na̱ ruhu va akapi a ama a na a pasai suru. Ɗaɗa a̱ ta̱wa̱i e temei ulinga wu u'wa wa̱ A̱sulazuva o oɓolo a̱ a̱soja a zuva, A̱sula̱ e le. <verse eid="HAG 1:14" /><verse number="15" style="v" sid="HAG 1:15" />E teme ta̱ ulinga o urana wu ushin na̱ a̱za̱ a̱ na̱shi u woto wa̱ ta̱li a aa'wan e ire o tsugono tso mogono Dariyu.<verse eid="HAG 1:15" /></para>
  <chapter eid="HAG 1" />
  <chapter number="2" style="c" sid="HAG 2" />
  <para style="s">Tsugbain tsu u'wa u sa'avu</para>
  <para style="p">
    <verse number="1" style="v" sid="HAG 2:1" />A̱tsuma̱ o woto we cindere, o urana wu ushin na̱ za ta̱ u woto'o, adanshi a̱ A̱sulazuva a̱ ta̱wa̱ ta̱ o una̱ wa Hagai vumava̱sula̱, <verse eid="HAG 2:1" /><verse number="2" style="v" sid="HAG 2:2" />&lt;&lt;Vu yuwan adanshi na̱ Zerubabe ulobo wa Sheyatiye gwamna va Yahuda, na̱ Josuwa ulobo wa Jehozada ganu gbain, oɓolo na akapi a ama suru. Vee ece le, <verse eid="HAG 2:2" /><verse number="3" style="v" sid="HAG 2:3" />&lt;Zane ɗa a̱tsuma̱ a̱ ɗu buwai wuma za na shi enei u'wa u nda a̱tsuma̱ o ulobonu wa̱ yi wu ufaru? Cine ye ene niyi gogo? U rotso ta̱ ili ya̱ a̱ɓula̱ e yeni i ɗu? <verse eid="HAG 2:3" /><verse number="4" style="v" sid="HAG 2:4" />Agba gogo vu kaɓa asuvu, Zerubabe,&gt; A̱sulazuva a ɗa a dammai ne. &lt;Vu kaɓa asuvu Josuwa ulobo wa Jehozada, ganu gbain. I kaɓa asuvu a̱ɗu ama e iɗa'a suru i yuwan ulinga,&gt; A̱sulazuva a ɗa a dammai ne. &lt;Adama a na n to oɓolo na̱ a̱ɗu,&gt; A̱sulazuva o oɓolo a̱ a̱soja a zuva a ɗa a dammai ne. <verse eid="HAG 2:4" /><verse number="5" style="v" sid="HAG 2:5" />&lt;Ne ɗa n yuwaan nɗu akucunu a mantsa ma na yu uta̱i e iɗa ya Masar. Ruhu va̱ buwa ta̱ e memere ma̱ ɗu. She yu uwwa wovon wan.&gt;<verse eid="HAG 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HAG 2:6" />&lt;&lt;Adama a na apa nda ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva a dammai, &lt;A̱tsuma̱ a mantsa wa'a, n ta̱ da̱shi jinga̱ɗa̱ zuva nu uvaɗi oɓolo na̱ mala ni iɗa yu u'yewu. <verse eid="HAG 2:6" /><verse number="7" style="v" sid="HAG 2:7" />N ta̱ jinga̱ɗa̱ nɗa suru, adama utsuru wu nɗa suru u ta̱wa̱ pe, reve n shiton u'wa u nda na̱ tsugbain,&gt; A̱sulazuva o oɓolo a̱ a̱soja a zuva a ɗa a dammai ne. <verse eid="HAG 2:7" /><verse number="8" style="v" sid="HAG 2:8" />&lt;Azurufa za va̱ ɗa zinariya waru za va̱ ɗa,&gt; A̱sulazuva o oɓolo a̱ a̱soja a zuva a ɗa a dammai ne. <verse eid="HAG 2:8" /><verse number="9" style="v" sid="HAG 2:9" />&lt;Tsugbain tsu u'wa tso gogo tsa ta la'a tsu za vu ufaru,&gt; A̱sulazuva o oɓolo a̱ a̱soja a zuva a ɗa a dammai ne. &lt;Waru pa uba̱ta̱ u nda n ta ca nden ma asuvu,&gt; A̱sulazuva o oɓolo a̱ a̱soja a zuva a ɗa a dammai ne.&gt;&gt; <verse eid="HAG 2:9" /><verse number="10" style="v" sid="HAG 2:10" />O urana wu ushin na̱ a̱za̱ a̱ na̱shi o woto wa̱ kucci, a aa'wan e ire o tsugono tsa Dariyu, adanshi a̱ A̱sulazuva a̱ ta̱wa̱ ta̱ o una̱ wa Hagai vumava̱sula̱ ana, <verse eid="HAG 2:10" /><verse number="11" style="v" sid="HAG 2:11" />&lt;&lt;Apa nda ili i na A̱sulazuva o oɓolo a̱ a̱soja a zuva a dammai, &lt;Ece nan ganu adama a̱ wila̱'a̱. <verse eid="HAG 2:11" /><verse number="12" style="v" sid="HAG 2:12" />Na̱ vuma tanu inama ya akiza ukutsuluwu o utugu wa̱ yi, reve utugu'u u ju'wa̱n opopofu ko mayan ko masayan ko mani'in ko cu'un vi ilyalya suru, wo o'wo ta̱ na akiza?&gt; &gt;&gt; Nan ganu a̱ usu ta̱, &lt;&lt;O'o.&gt;&gt;<verse eid="HAG 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HAG 2:13" />Reve Hagai damma, &lt;&lt;Na̱ vuma na o'woi idaba o una̱ u na u ju'wa̱in a̱kwa̱kwa̱ u ju'wa̱n za ta̱ a̱tsuma̱ e ili i nda, ili'i wo o'wo ta̱ idaba?&gt;&gt; Reve nan ganu'u a̱ usu, &lt;&lt;wo o'wo ta̱ idaba.&gt;&gt;<verse eid="HAG 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HAG 2:14" />Ɗaɗa Hagai usuyi u dammai, &lt;&lt; &lt;Ne ɗa u ri na ama a nda ni iɗa i nda e esu a̱ va̱, A̱sulazuva a ɗa a dammai ne, ne ɗa fo u ri nu ulinga we ekere e le, waru ne ɗa u ri ni ili i na biti a cayi kucci wo o'wo ta̱ idaba.<verse eid="HAG 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HAG 2:15" />&lt;&lt; &lt;Gogo nda i yuwan majiyan diga ana'an a̱ 'ya̱wa̱. Kafu a̱ shi a̱ kuru aatali zuva va aatali a̱tsuma̱ a̱ a̱a̱'isa̱ a̱ A̱sulazuva, cine wuma u ɗu u shi? <verse eid="HAG 2:15" /><verse number="16" style="v" sid="HAG 2:16" />Cine i tsu uwwa? Na̱ nanza 'ya̱wa̱ o oɓolo a na a̱a̱ kunzu makundatsu ushin, reve u cina kupa goon. Na̱ vuma 'ya̱wa̱ uba̱ta̱ u na ee kene masayan makundatsu kupoton, reve u cina ushin goon. <verse eid="HAG 2:16" /><verse number="17" style="v" sid="HAG 2:17" />N faba ta̱ ulinga we ekere a̱ ɗu suru na̱ mɓa̱la̱ a̱vu a̱ pa̱luwa̱ na atayan, agba suru na̱ ne i ka̱mba̱ ya̱'a̱ va̱ shi,&gt; A̱sulazuva a ɗa a dammai ne. <verse eid="HAG 2:17" /><verse number="18" style="v" sid="HAG 2:18" />&lt;Ka̱lyuwa̱i, diga ana'an a̱ 'ya̱wa̱, diga o urana wu ushin na̱ a̱za̱ a̱ na̱shi o woto wa̱ kucci, diga o urana u na a varai ikyun ya̱ a̱a̱'isa̱ a̱ A̱sulazuva, i yuwan majiyan ulobonu. <verse eid="HAG 2:18" /><verse number="19" style="v" sid="HAG 2:19" />Icu'un i buwa ta̱ pe o mopon? Na amayun ataci nu ubiri na̱ muwun mu uɗanga m peme na̱ ɗanga zetun a matsan ili shi. Amma diga ana'an a̱ 'ya̱wa̱ n ta zuwaa ɗu aba'un.&gt; &gt;&gt;<verse eid="HAG 2:19" /></para>
  <para style="s">Zerubabe makawani mo urotsu wa̱ A̱sulazuva</para>
  <para style="p">
    <verse number="20" style="v" sid="HAG 2:20" />Adanshi a̱ A̱sulazuva a̱ ta̱wisa̱ ta̱ ya Hagai we ire o urana wu ushin na̱ a̱za̱ a̱ na̱shi o woto'o, <verse eid="HAG 2:20" /><verse number="21" style="v" sid="HAG 2:21" />&lt;&lt;Vu yuwan adanshi na̱ Zerubabe gwamna va Yahuda, vu damma, n ciga ta̱ n jinga̱ɗa̱ zuva nu uvaɗi. <verse eid="HAG 2:21" /><verse number="22" style="v" sid="HAG 2:22" />Reve m mumula̱ otogu o tsugono, a̱vu n kototo ucira u tsugono wu nɗa n ro. N ta̱ mula̱ ikeke yi ido na akumbi e le. Ido na akumbi e le a̱ ta̱ riya̱, za suru a matsun me pe'eni ma za va̱ yi.<verse eid="HAG 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HAG 2:23" />&lt;&lt; &lt;O urana u ndolo,&gt; A̱sulazuva o oɓolo a̱ a̱soja a zuva a damma ta̱, &lt;N ta tara wu Zerubabe ulobo wa Sheyatiye aagbashi a̱ va̱,&gt; A̱sulazuva a ɗa a dammai ne, &lt;Reve n ka̱mba̱to wu tsa makawani mo urotsu wu ukere u va̱, adama a na n ɗangwa wu ta̱,&gt; A̱sulazuva o oɓolo a̱ a̱soja a zuva a ɗa a dammai ne.&gt;&gt;<verse eid="HAG 2:23" /></para>
  <chapter eid="HAG 2" />
</usx>