<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Alkitab Bahasa Biak</book>
  <para style="h">Wos Ananun</para>
  <para style="toc3">WosAn.</para>
  <para style="toc2">Ananun</para>
  <para style="toc1">Wos Ananun</para>
  <para style="mt1">WOS ANANUN</para>
  <para style="is">WOS VEKFIN</para>
  <para style="im">Sas <char style="bk">Wos Ananun </char> irya farkarkor vebor vekur rari kenem vepyum. Farkarkor annane svaryarna ve wos ananun, wos sarver ma wos peper. Vebor kaku ro wos farkakor annane isoine roi vekur kenem kovena ro rasras. Sas ine vye rak kuker wos swarapepen ine, “Insa kosmai fawawi, vepon rawer kaku snonkaku ivye sve syowi ma siraryof faro <char style="nd">Manseren Allah</char> ” Ivye ro rari kenem vepyumya, sas ine fyarkor snonkaku fa sna swaruser venapes ma rari vepyum. Wos sarver vyena nabor ma nfasnai vadir fawawi nanem vefnakva ro mankurari Israel ro fafis iwarasya vekur rari ma frur snonkaku vefirnanem ro fafisu ono. Ananun annane nkur roi ri veso, isoine kenem vepyum ro kina, vekur farvavyan, vave syowi fandu kawasa, fandun kako kofara ser mankunko, Nererva, sas ine vyadir nabor kako rari vepyumna, isoine sne vekakiva, sne vekwan, vave syowi faro snonkaku vesavarar ma kavavav faro manivov.</para>
  <para style="iot">Fasfas ro syap ine</para>
  <para style="io1">Firnanemya isma ararer <char style="ior"><ref loc="PRO 1:1-9:18">1:1—9:18</ref></char></para>
  <para style="io1">Ananun Salomo vyena <char style="ior"><ref loc="PRO 10:1-29:27">10:1—29:27</ref></char></para>
  <para style="io1">Agur wawos vyena <char style="ior"><ref loc="PRO 30:1-33">30:1-33</ref></char></para>
  <para style="io1">Lemuel wawos vyena <char style="ior"><ref loc="PRO 31:1-9">31:1-9</ref></char></para>
  <para style="io1">Ararer faro vin/swa eve syowi <char style="ior"><ref loc="PRO 31:10-31">31:10-31</ref> </char></para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s1">Fandun ro wos ananun nane</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />Nane kada wos ananun ro Salomo rumkun Daud, wairek Israel.<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="1KI 4:32">1Raj. 4:32</ref> </char></note> <verse eid="PRO 1:1" /><verse number="2" style="v" sid="PRO 1:2" />Fandun ro wos ananun nane isoine insa nfarkor snonkakusya fa sifawi firnanem, sifawi sikenem pyum ma svavirpyum kaku wos vararyar. <verse eid="PRO 1:2" /><verse number="3" style="v" sid="PRO 1:3" />Wos ananun nane nfarkor mov risai snonkakusya sikenem kuker swaruser veknon, napnapes, kenem veyavyover ma vavekakaku. <verse eid="PRO 1:3" /><verse number="4" style="v" sid="PRO 1:4" />Snonkaku vefawi karyonbasya sfarkor insa siwasen nanem, ma romawa-inai babo sismai fawawi insa sifawi navye ma skara vevarpon. <verse eid="PRO 1:4" /><verse number="5" style="v" sid="PRO 1:5" />Kuker wos ananun nane, snonkaku vena firnanemsya fawawi sena nevefanfon, ma snonkaku vefawi nanem kwar sya sismai farkankin. <verse eid="PRO 1:5" /><verse number="6" style="v" sid="PRO 1:6" />Rarirya sifawi sper wos vararyar ro wos ananun na ma sifawi mnis wawos ro snonkaku swaruser veknonsya ro fafisu sawos yov si.<verse eid="PRO 1:6" /></para>
  <para style="s1">Wos farkarkor faro romawa inai babo</para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 1:7" />Insa sismai fawawi vekakur, veponya snonkakusya ivye skunem ma siraryof faro <char style="nd">Manseren Allah</char> I. Snonkaku vefawi nanembasya simewer firnanem ma farkarkor ri.<note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="JOB 28:28">Ayb. 28:28</ref>; <ref loc="PSA 111:10">Mzm. 111:10</ref>; <ref loc="PRO 9:10">WosAn. 9:10</ref> </char></note><verse eid="PRO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 1:8" />Romawa yedi, wamnaf pyum farkarkor kmami ma snami suvena. <verse eid="PRO 1:8" /><verse number="9" style="v" sid="PRO 1:9" />Snar farkarkor suvena nfanfon rari vepyum bena imnis raris afyamankor ro vrumri ma irai vefamankor ro sasukor bedi.<verse eid="PRO 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 1:10" />Ne, romawa yedi, snonkaku vesasarsya sidif au ve nyan sasar ido waso awer si. <verse eid="PRO 1:10" /><verse number="11" style="v" sid="PRO 1:11" />Waso awer, fafisu sikofen ve au radine, “Indo, rwama koseref snonkakuno ma koryur koprer si. Mkorama kofarmun snonkaku vesasarva siwa infa nafrur doryav monda ko. <verse eid="PRO 1:11" /><verse number="12" style="v" sid="PRO 1:12" />Kur ine sikenem kuker andeidi ma pararei, vape nari sfarsyoar ma sive simar namuk kaku. <verse eid="PRO 1:12" /><verse number="13" style="v" sid="PRO 1:13" />Kofasyar nana eve maeja sena insa rumrido kovena nafo kuker nana kofasyar anna. <verse eid="PRO 1:13" /><verse number="14" style="v" sid="PRO 1:14" />Rwama waso! Nari roi kofasyar anna korwasna ra namnisko!”<verse eid="PRO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 1:15" />Romawa yedi! Waso awer snonkaku veradiryansya, vinkwan bur si. <verse eid="PRO 1:15" /><verse number="16" style="v" sid="PRO 1:16" />Sifrur roi vevyeva vaim ido, nari skain fasisva. Imboi sisawsaw kaku fa smamun. <verse eid="PRO 1:16" /><verse number="17" style="v" sid="PRO 1:17" />Man risai nari vesawer ro pamya fafisu myam snonkakuyo nyap pamya ro varpon vyedi? <verse eid="PRO 1:17" /><verse number="18" style="v" sid="PRO 1:18" />Imbape snonkaku vevarvor ansyama snap denem fa nfor mankunsi, denem nari eve ninyan si. <verse eid="PRO 1:18" /><verse number="19" style="v" sid="PRO 1:19" />Kakuvavoi, snonkaku vesasewar faro kenem ine kuker nyan pakakrek nari vyak kuker rur ma kenem vyedi.<verse eid="PRO 1:19" /></para>
  <para style="s1">Mkarem firnanemya</para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 1:20" />Wamnaf navye! Firnanemya isya dor ro nyan swafna ma ifyow ro buvesna! <note caller="+" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="PRO 8:1-3">WosAn. 8:1-3</ref> </char></note> <verse eid="PRO 1:20" /><verse number="21" style="v" sid="PRO 1:21" />Kyaru kako ro kerwa veba vebor vero kota ma mov kawasa sibor siraryur ro: <verse eid="PRO 1:21" /><verse number="22" style="v" sid="PRO 1:22" />“Ne snonkaku venawnower mkoiya! Mkoswar kaker kenem veradinenya? Ras risai nari mkomnai mkokorwef fawawiya ma mkokurpum farkarkorna nya? <verse eid="PRO 1:22" /><verse number="23" style="v" sid="PRO 1:23" />Mkomnaf ve aya fafisu yasonek mko, rarirya nari yakofen vadir faro mko sneri dori ma yafarkor ve mko fawawi yena. <verse eid="PRO 1:23" /><verse number="24" style="v" sid="PRO 1:24" />Yor mko kwar, vape mkokurpum ma mkaser ayava. <verse eid="PRO 1:24" /><verse number="25" style="v" sid="PRO 1:25" />Wos ananun yenakam mkove rer na ma wos sansonek ayena mkokurpum na. <verse eid="PRO 1:25" /><verse number="26" style="v" sid="PRO 1:26" />Rarirya fafis mkosma marindi nari yambrif mko. Makakakya inyanem mkonido na yave aiswos mko. <verse eid="PRO 1:26" /><verse number="27" style="v" sid="PRO 1:27" />Kakudam, nari yave aiswos mko ro fafis mkove virvar ma mkove kandera snar marindi nari venyanem mko imnis raris wam dover vemun. <verse eid="PRO 1:27" /><verse number="28" style="v" sid="PRO 1:28" />Fafis evesya anya mkor aya mbape yakaremba. Mkoseref aya ro mov nakam vape mkosrow ayava. <verse eid="PRO 1:28" /><verse number="29" style="v" sid="PRO 1:29" />Mkomnis raris snonkaku vemewer vesmai fawawi nanemya ma vemewer vesoyuser faro <char style="nd">Manseren Allah</char> indi. <verse eid="PRO 1:29" /><verse number="30" style="v" sid="PRO 1:30" />Iyawer ido mkomewer kaku mkomnaf wos ananun yena ndi mboi mkokurpum wos sansonek vebor ayena. <verse eid="PRO 1:30" /><verse number="31" style="v" sid="PRO 1:31" />Inja, nari roi vevyeva nanyanem mko snar frur ma aw vebor vekarfiva mkovena. <verse eid="PRO 1:31" /><verse number="32" style="v" sid="PRO 1:32" />Snonkaku vefawi karyonbasya nari simar snar saser ayava, ma snonkaku venawnowersya nari semompraf kaku snar sefandun ayava. <verse eid="PRO 1:32" /><verse number="33" style="v" sid="PRO 1:33" />Mbape mundiri vemnaf aya nari vyevefaduru. Nari ikenem kuker kananon ma ipokfa imkakva.”<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s1">Fandun ro firnanem</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 2:1" />Romawa yedi, wakin epen farkarkor yenane, ma waswarepen navye ananun yavuk faro au. <verse eid="PRO 2:1" /><verse number="2" style="v" sid="PRO 2:2" />Faduru pyum firnanemya ma sweref fa wafawi navye kaku. <verse eid="PRO 2:2" /><verse number="3" style="v" sid="PRO 2:3" />Sye, romawa yedi au, sweref insa wasmai swaruser vesar ma wor insa wasmai swarnanemya. <verse eid="PRO 2:3" /><verse number="4" style="v" sid="PRO 2:4" />Swewari raris swewar brawen, ma wayomi raris wayom nana vevayek. <verse eid="PRO 2:4" /><verse number="5" style="v" sid="PRO 2:5" />Rarirya nari wafawi mnuk vekur araryof faro <char style="nd">Manseren Allah</char> I ma nari wasmai fawawi nanem vekur Allah I. <verse eid="PRO 2:5" /><verse number="6" style="v" sid="PRO 2:6" /><char style="nd">Manseren Allah</char> I vevuk firnanemya; ro I monda snonkaku sya sismai fawawi ma swarnanem. <verse eid="PRO 2:6" /><verse number="7" style="v" sid="PRO 2:7" />Faro snonkaku venapes ma eve pusmarva, Vyuk fanfnovek ma kadaun. <verse eid="PRO 2:7" /><verse number="8" style="v" sid="PRO 2:8" /><char style="nd">Manseren Allah </char> iwaren warek snonkaku vena rari veyavyover, ma kyadiren snonkaku veswar Insya.<verse eid="PRO 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 2:9" />Romawa yedi, wasoyuser ayanido, nari wafawi kenem veyavyover, venapes ma vekakuya. Nari wafawi kako mov risai wakenem raya. <verse eid="PRO 2:9" /><verse number="10" style="v" sid="PRO 2:10" />Nari wasmai firnanemya ma fawawi bena nafrur raryav snembri. <verse eid="PRO 2:10" /><verse number="11" style="v" sid="PRO 2:11" />Swarnanem ma fawawi nanem bena nari nakadaun au, <verse eid="PRO 2:11" /><verse number="12" style="v" sid="PRO 2:12" />ma nadwarek au insa waso awer rari vevyevaya, ma kako nun au fa vinkwanbur snonkaku veyankarkarsya. <verse eid="PRO 2:12" /><verse number="13" style="v" sid="PRO 2:13" />Simewer siso rari kenem vepyumya ndi; siso neyan pampan ma vefo kuker vavyevaya. <verse eid="PRO 2:13" /><verse number="14" style="v" sid="PRO 2:14" />Siryav rodo frur varvor sena. <verse eid="PRO 2:14" /><verse number="15" style="v" sid="PRO 2:15" />Sifo kuker ankarkar ma rari kenem sena nabyaser.<verse eid="PRO 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 2:16" />Romawa yedi au, nari kwurpum sambrav vin veknonba sya wos ponsasye sena ma eve sewar fa veyaw ninyan au kuker wos vemarnden sena. <verse eid="PRO 2:16" /><verse number="17" style="v" sid="PRO 2:17" />Vin evesya ansi sve syowi swa sesyava ma svefnder rosai skaremkwar ro varpon Allah I. <verse eid="PRO 2:17" /><verse number="18" style="v" sid="PRO 2:18" />Rwave rum vyeja ido, irya wambran yov marmari. Rwamura ido irya imnis rwa ve mun aivuiya. <verse eid="PRO 2:18" /><verse number="19" style="v" sid="PRO 2:19" />Snonkaku vera yov insya ono fa skaver ve nyan vesoyov kankenemyava. <verse eid="PRO 2:19" /><verse number="20" style="v" sid="PRO 2:20" />Rarirya, romawa yedi, waso rari vepyum na ma wakenem raris Allah marisen Vyena. <verse eid="PRO 2:20" /><verse number="21" style="v" sid="PRO 2:21" />Snar snonkaku vekenem raris Allah marisen vyena, isoine snonkaku sne venapes, sikada nari sikenem ro sup <char style="nd">Manseren Allah </char> fyasos kwar. <verse eid="PRO 2:21" /><verse number="22" style="v" sid="PRO 2:22" />Imboi snonkaku vevarvor ma vesasar nari Allah isawen si vinkwan bur sup ani, imnis raris avris knam vepas bur sapropya bori.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s1">Wos ananun faro romawa-inai babo</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 3:1" />Romawa yedi, befnder awer rosai yafarkor kwar faro au, waswar epen vesyakwar rosai yanunkwar faro au, <verse eid="PRO 3:1" /><verse number="2" style="v" sid="PRO 3:2" />insa ras kenem bedi ikwan ma wakenem kuker aski. <verse eid="PRO 3:2" /><verse number="3" style="v" sid="PRO 3:3" />Ivyekada wakyar nako ma waso asuser faro Allah ma faro min besi. Waswarepen kakuna ma wakramna ro snembrido, <verse eid="PRO 3:3" /><verse number="4" style="v" sid="PRO 3:4" />insa wasmai marasrisen ma syowi ro Allah I ma snonkakusya.<note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="LUK 2:52">Luk. 2:52</ref> </char></note><verse eid="PRO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 3:5" />Wakyar faro <char style="nd">Manseren Allah</char> kuker snembri kasiper, ma wakansandenm faro swaruser mankundaw bena awer. <verse eid="PRO 3:5" /><verse number="6" style="v" sid="PRO 3:6" />Waswarepen monda faro <char style="nd">Manseren Allah</char> I ro roi vebor wafrur na, rarirya nari Kyur fasna ve au neyan kankenem vepyumya. <verse eid="PRO 3:6" /><verse number="7" style="v" sid="PRO 3:7" />Kwara mankundaw ve snonkaku vefawi nanem syadi awer; wararyof faro <char style="nd">Manseren Allah</char> I ma vinkwan bur vavyevaya.<note caller="+" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="ROM 12:16">Rm. 12:16</ref></char></note> <verse eid="PRO 3:7" /><verse number="8" style="v" sid="PRO 3:8" />Frur banna nari namnis aryawin vevuk pararei faro baken bedi ma nbuk andeidi faro rur bedi. <verse eid="PRO 3:8" /><verse number="9" style="v" sid="PRO 3:9" />Buk som faro <char style="nd">Manseren Allah </char> I, farser faro I roi vepyum kaku ro nana bena kam ma roi wasmai ro yaf bena, <verse eid="PRO 3:9" /><verse number="10" style="v" sid="PRO 3:10" />rarirya sar adadu bena nari nafo kuker pokem, ma war anggur besya nari sifo ra sisaravriv isof rosaser bena naser napakpok siva.<verse eid="PRO 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 3:11" />Romawa yedi, rofyor <char style="nd">Manseren Allah</char> isonek au, nwana ve swarapepen, ma snembri fyafayaf awer faro farkarkor Vyena.<note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="JOB 5:17">Ayb. 5:17</ref></char></note><note caller="+" style="x"><char style="xo" closed="false">3:11-12 </char><char style="xt" closed="false"><ref loc="HEB 12:5-6">Ibr. 12:5-6</ref></char></note> <verse eid="PRO 3:11" /><verse number="12" style="v" sid="PRO 3:12" /><char style="nd">Manseren Allah</char> isonek snonkaku Iswarsya, imnis sinan kma veprer romawa iswarya.<note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="REV 3:19">Why. 3:19</ref></char></note> <verse eid="PRO 3:12" /><verse number="13" style="v" sid="PRO 3:13" />Fainda isya faro snonkaku vesma firnanem ma swarnanemya. <verse eid="PRO 3:13" /><verse number="14" style="v" sid="PRO 3:14" />Fainda vyedi iba syadi ro rosai kosmai ro sarak, ma vye maeja syadi ro brawen. <verse eid="PRO 3:14" /><verse number="15" style="v" sid="PRO 3:15" />Firnanem kyakur syadi ro kerui vesnaper, roi snembri pyoser faro nakam namnis kuker iva. <verse eid="PRO 3:15" /><verse number="16" style="v" sid="PRO 3:16" />Firnanemya vyuk ve au ras kenem vekwan, nana ma snonsnon vesmai som. <verse eid="PRO 3:16" /><verse number="17" style="v" sid="PRO 3:17" />Firnanem ifrur fa kenem bedi ifo kuker marisen ma aski. <verse eid="PRO 3:17" /><verse number="18" style="v" sid="PRO 3:18" />Snonkaku veserepen kaku faro firnanemya nari ismai vok ma ras kenem vekwan.<verse eid="PRO 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />Kuker firnanem, <char style="nd">Manseren Allah</char> syarmur supswan ine;</para>
  <para style="q2" vid="PRO 3:19">ma kuker kakara Vyena iryer sansorenya ro mov Vyedi.<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />Kuker fawawi Vyena ifrur war mkamor vero sapropya bavdi narvaren ma nadaf</para>
  <para style="q2" vid="PRO 3:20">ma kako mandif vero mandep nasabu mekem ve supya bori.<verse eid="PRO 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 3:21" />Inja romawa yedi, wakifepen nako faro firnanemya ma faro kakara vepyum, wapok rwir awerna, <verse eid="PRO 3:21" /><verse number="22" style="v" sid="PRO 3:22" />rarirya kenem bedi nari ismai fadaduru, ipyum bos kaku ma ifrur marisen. <verse eid="PRO 3:22" /><verse number="23" style="v" sid="PRO 3:23" />Nari wambran kuker kananon, ma wapok kwarkarva. <verse eid="PRO 3:23" /><verse number="24" style="v" sid="PRO 3:24" />Nari wenef kuker makakakva, ma wenef moser kaku ro rovna rao isof meser. <verse eid="PRO 3:24" /><verse number="25" style="v" sid="PRO 3:25" />Wapok wamkak awer marindi nari verama kuker kanandor imnis dover veriref snonkaku vevarvorsya. <verse eid="PRO 3:25" /><verse number="26" style="v" sid="PRO 3:26" /><char style="nd">Manseren Allah</char> nari Iwaren warek au. Nari Myam monda au fa wasbu ro denemba. <verse eid="PRO 3:26" /><verse number="27" style="v" sid="PRO 3:27" />Rofyor wasmai fafisu fa wafrur pyum yov snonkaku eve fandun frur pyum bena ido, kwurpum awer imboi wafrurna. <verse eid="PRO 3:27" /><verse number="28" style="v" sid="PRO 3:28" />Wawan fa min bedi iwaf awer ra meser, roi vye fandunya isya ro au ido fafisuya wafnoveki veri. <verse eid="PRO 3:28" /><verse number="29" style="v" sid="PRO 3:29" />Kwara awer aw vevyeva faro snonkaku min besya vekain so au ma vekyar au. <verse eid="PRO 3:29" /><verse number="30" style="v" sid="PRO 3:30" />Famfavri waworek awer kuker snonkaku vefrur sasarva yov au. <verse eid="PRO 3:30" /><verse number="31" style="v" sid="PRO 3:31" />Snembri fyawe awer snonkaku vefrur pakakreksya, ma waso awer rari sena. <verse eid="PRO 3:31" /><verse number="32" style="v" sid="PRO 3:32" />Snar, snonkaku vefrur varvorsya <char style="nd">Manseren Allah</char> imarisen siva, imboi ikenem fanam snonkaku kenem venapes sya. <verse eid="PRO 3:32" /><verse number="33" style="v" sid="PRO 3:33" />Fras ro<char style="nd">Manseren Allah</char> isya ro rumrido snonkaku vevarvorsya, imboi Vye vok rum snonkaku venapessya. <verse eid="PRO 3:33" /><verse number="34" style="v" sid="PRO 3:34" /><char style="nd">Manseren Allah</char> vye mbrov snonkaku veyow mankunsya, imboi vye vok snonkaku verun mankunsya.<note caller="+" style="x"><char style="xo" closed="false">3:34 </char><char style="xt" closed="false"><ref loc="JAS 4:6">Yak. 4:6</ref>; <ref loc="1PE 5:5">1Ptr. 5:5</ref></char></note> <verse eid="PRO 3:34" /><verse number="35" style="v" sid="PRO 3:35" />Snonkaku swaruser veknonsya nari snonsnon sena nadiref pyum, imboi snonkaku venawnowersya sismai anonef.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s1">Fainda kosmai ro firnanemya</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 4:1" />Ne, romawa yena mko, mkomnaf navye wos farkarkor ro sinan kma mkovesi! Mkomamepen na, insa nari mko swarnanem. <verse eid="PRO 4:1" /><verse number="2" style="v" sid="PRO 4:2" />Roi yafarkor faro mko nane navye napyum, inja mko kurpum awerna. <verse eid="PRO 4:2" /><verse number="3" style="v" sid="PRO 4:3" />Fafisu yave kapira, romawa bonjos ro sinan ayesuya, <verse eid="PRO 4:3" /><verse number="4" style="v" sid="PRO 4:4" />kamam fyarkor aya. Ikofen, “Waswarepen wos ananun ayena, wapok befnderna vaveri. Waserepen nako akyurfasna ayena, insa kenem bedi ifo kuker aski. <verse eid="PRO 4:4" /><verse number="5" style="v" sid="PRO 4:5" />Ivye wasmai firnanem ma wafawi nanem! Waswarepen navye kaku wos ananun ayena ma wasawen awerna.” <verse eid="PRO 4:5" /><verse number="6" style="v" sid="PRO 4:6" />Besyowi firnanemya, rarirya firnanemya nari ikadaun au; waswar kuf i, irya nari iwaren warek au insa kenem bedi iknon. <verse eid="PRO 4:6" /><verse number="7" style="v" sid="PRO 4:7" />Roi eve fandun kaku insa wafrur veponya isoine besewar insa wasmai firnanemya. Rosai wayomna, vepon kakuya isoine besewar fa wasmai swarnanemya. <verse eid="PRO 4:7" /><verse number="8" style="v" sid="PRO 4:8" />Besyowi firnanemya, irya nari ikanow nakaki kaku au. Waurepen i, irya nari idaw som faro au. <verse eid="PRO 4:8" /><verse number="9" style="v" sid="PRO 4:9" />Nari vyuk ve au wower ai pampen vedoser ro vrumri.<verse eid="PRO 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 4:10" />Wamnaf ve aya, romawa yedi! Mamepen pyum wos ananun ayena, irya nari ras kenem bedi ikwan kaku. <verse eid="PRO 4:10" /><verse number="11" style="v" sid="PRO 4:11" />Yafarkor ve au kwar firnanemya ma rari kenem venapesya. <verse eid="PRO 4:11" /><verse number="12" style="v" sid="PRO 4:12" />Waso pyum na ido, royo nari idadwarek auva ro fafisu wambranya ma nari kwarkarva ro fafisu wafrarya. <verse eid="PRO 4:12" /><verse number="13" style="v" sid="PRO 4:13" />Waswarepen vesyakwar wos farkarkor rosai wasmai kwar ro aya. Mamwarek pyum na, snar kuker wos farkarkor annane, irya nari nadaw kenem vepyum faro au. <verse eid="PRO 4:13" /><verse number="14" style="v" sid="PRO 4:14" />Waso awer rari snonkaku vevarvorsya, ma waso farari awer frur sena. <verse eid="PRO 4:14" /><verse number="15" style="v" sid="PRO 4:15" />Waryar bur nyan evesyani. Waso awer si. Vinkwan bur si ma wambran pdef! <verse eid="PRO 4:15" /><verse number="16" style="v" sid="PRO 4:16" />Snonkaku vevarvorsya senef fasawva rofyor sifrur roi vevyeva vaim. Sivor senef rari rofyor sifrur fanor snonkaku vese vaim. <verse eid="PRO 4:16" /><verse number="17" style="v" sid="PRO 4:17" />Varvor ma frur pakakrekya imnis raris anan ma aninem faro si.<verse eid="PRO 4:17" /></para>
  <para style="p">
    <verse number="18-19" style="v" sid="PRO 4:18-19" />Neyan snonkaku vevyevasya pyampan imnis remaryai. Skarkar ma sisapi imboi sifawiva. Ro varya, snonkaku vekenem pyumsya nyan simbran roya imnis ori vesampir; iyar fawas rao favye muma ido fyadameser.<verse eid="PRO 4:18-19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 4:20" />Romawa yedi, mamepen wos ayenane! Wamnaf wos ananun ayena. <verse eid="PRO 4:20" /><verse number="21" style="v" sid="PRO 4:21" />Wasawen awerna, imboi wadu na ro snembrido. <verse eid="PRO 4:21" /><verse number="22" style="v" sid="PRO 4:22" />Snonkaku vekarapyum na sya nari sikenem ma sismai pararei. <verse eid="PRO 4:22" /><verse number="23" style="v" sid="PRO 4:23" />Wepenpyum snembri, snar snembri iso vefaraser marandan kenem bedi. <verse eid="PRO 4:23" /><verse number="24" style="v" sid="PRO 4:24" />Wawos roi vekakuva awer. Wasawen vinkwan bur au wos ankarkar ma wawos vefrur fa snonkakusya sivoryayena. <verse eid="PRO 4:24" /><verse number="25" style="v" sid="PRO 4:25" />Ivyekada makabesuya susoyov monda roi venapes, ma mam kako faro roi vepyum. <verse eid="PRO 4:25" /><verse number="26" style="v" sid="PRO 4:26" />Kwara pyum kaku rofyor wafrur vaim, irya roi kwara fa wafrurna nari wasmaina.<note caller="+" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="HEB 12:13">Ibr. 12:13</ref></char></note> <verse eid="PRO 4:26" /><verse number="27" style="v" sid="PRO 4:27" />Vinkwan bur vavyevaya, ma wakenem kuker snevenapes. Wambransar bur awer nyan venapesya.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s1">Vinkwan bur frur sonei</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 5:1" />Romawa yedi, wamnaf ve aya! Mamepen pyum kaku firnanem ayena ma swarnanem yafarkor kwar faro au, <verse eid="PRO 5:1" /><verse number="2" style="v" sid="PRO 5:2" />insa wafawi navye mov faraser au raya ma wawos raris snonkaku vesmai fawawi. <verse eid="PRO 5:2" /><verse number="3" style="v" sid="PRO 5:3" />Vin vevyeva,<note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="fq" closed="false">Vin vevyeva </char><char style="ft" closed="false">orovaido: vin vefarvuk kwar.</char></note> sisvasna nmarnden raris umber ma wos sena nposer snewar, <verse eid="PRO 5:3" /><verse number="4" style="v" sid="PRO 5:4" />imbape rofyor nakam nasyonde kwar ido, varpurya isoine sarmar ma kenem vefo kuker marindi. <verse eid="PRO 5:4" /><verse number="5" style="v" sid="PRO 5:5" />Ismer au fa wasabu ve mun aivuiya; nyan marandan vin ani vyedi syoyov marmari. <verse eid="PRO 5:5" /><verse number="6" style="v" sid="PRO 5:6" />Imbran ro nyan vesoyov kankenemyava; ifawiva vo imbransar bur nyan ani.<verse eid="PRO 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 5:7" />Rarirya, romawa mkoine, mkomnaf wos ayenane, ma mkove rer awerna. <verse eid="PRO 5:7" /><verse number="8" style="v" sid="PRO 5:8" />Vinkwan bur vin evesya ani! Isyadadi rwafa fanam awer rum vyedi. <verse eid="PRO 5:8" /><verse number="9" style="v" sid="PRO 5:9" />Rofyor wakenemso vin anya ido, snonsnon vepyum bedi nari ryo. Swa vyedi nari myam monda auva ma nari myun au fa wamar ro fafisu babo kakerya. <verse eid="PRO 5:9" /><verse number="10" style="v" sid="PRO 5:10" />Nana bena nari snonkaku vese san presna, ma roi wasmairo marmor domes bena nari snonkaku vese wafawivasya sun nafa sna na. <verse eid="PRO 5:10" /><verse number="11" style="v" sid="PRO 5:11" />Varpurya nari besoso, rofyor dafdufya dan kavkev baken bedi. <verse eid="PRO 5:11" /><verse number="12" style="v" sid="PRO 5:12" />Mura nari wakofen, “Ae, rosai evewar yamewer yamnaf wos farkarkor ri, rosai evewar yamewer yamnaf wos sansonek ri? <verse eid="PRO 5:12" /><verse number="13" style="v" sid="PRO 5:13" />Yamewer yamnaf mankurari ayesi ma yamewer yasoyuser sindi. <verse eid="PRO 5:13" /><verse number="14" style="v" sid="PRO 5:14" />Ineno yasapi kwar ma yamai kaku ro varpon mamam kawasa.”<verse eid="PRO 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 5:15" />Inja, ivye be sne oser kuker swambri ma syowi bena faro i monda. <verse eid="PRO 5:15" /><verse number="16" style="v" sid="PRO 5:16" />Faindayo vaveri fa swewar andeidi ro vin nwave swava. <verse eid="PRO 5:16" /><verse number="17" style="v" sid="PRO 5:17" />Andeidiya wasmai i monda ro swa bedi, imboi kuker vin veseva. <verse eid="PRO 5:17" /><verse number="18" style="v" sid="PRO 5:18" />Rarirya, ivye wakenem kuker aski kuker swambri monda; swewar andeidi monda ro vin farvuk kuker kwar, <verse eid="PRO 5:18" /><verse number="19" style="v" sid="PRO 5:19" />I monda inai vedoser ma vra vesanyenem. Ivye baken bedoser vyedi snembri isararan ker i ma diref vespum vyedi ifrurfa wamser kaku i. <verse eid="PRO 5:19" /><verse number="20" style="v" sid="PRO 5:20" />Romawa yedi, fanduno fa snembri isararan faro vin veseva, fainda rosai wasmai fafis wenef kuker vin evyeva syani? <verse eid="PRO 5:20" /><verse number="21" style="v" sid="PRO 5:21" /><char style="nd">Manseren Allah</char> myam fafewa roi vebor snonkakusya sifrurna. Mov risai simbran raya <char style="nd">Manseren Allah</char> myamepen nakam. <verse eid="PRO 5:21" /><verse number="22" style="v" sid="PRO 5:22" />Sasar snonkaku vevarvor imnis denem vefor mankundi. <verse eid="PRO 5:22" /><verse number="23" style="v" sid="PRO 5:23" />Imar snar ryower wos farkarkorva. Fawi nanemba vyena nun i fa vye fromo.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s1">Wos farkarkor evese na</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 6:1" />Romawa yedi, imbude ausya wap ve snonkakuyo fa nari bak pyan nyaki min bedi vyena ndi. <verse eid="PRO 6:1" /><verse number="2" style="v" sid="PRO 6:2" />Irya wos banna nfes au raris denem ma wasinanjar snar ap wakofen kwar ani. <verse eid="PRO 6:2" /><verse number="3" style="v" sid="PRO 6:3" />Kaku radirya nido, romawa yedi, ausya ro bav papoik vyedi. Imbape ine irya nyan insa faspar bur i; rwa fasaw yov i ma wor samsom kaku ve i insa pyer au. <verse eid="PRO 6:3" /><verse number="4" style="v" sid="PRO 6:4" />Wenef awer ari, ma wamnaisar awer. <verse eid="PRO 6:4" /><verse number="5" style="v" sid="PRO 6:5" />Faspar mankundaw ro denem nari vefor au imnis raris man rovaido randip vekfisbur snonkaku vesamnaf.<verse eid="PRO 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 6:6" />Snonkaku vemananonsya ivye smamepen ma sfarkor ro anirsya. <verse eid="PRO 6:6" /><verse number="7" style="v" sid="PRO 6:7" />Anirsya oso fa vye vukor ve siva, sna snoporova ma oso fa myam wareksiva, <verse eid="PRO 6:7" /><verse number="8" style="v" sid="PRO 6:8" />vesyavo fafis aninek, siryur nanan fa sikram faro si ro fafisu ananjar. <verse eid="PRO 6:8" /><verse number="9" style="v" sid="PRO 6:9" />Snonkaku vemananonya ive denef vesyakwar? Fafis risai nari ikvokya? <verse eid="PRO 6:9" /><verse number="10" style="v" sid="PRO 6:10" />Kyain daper vramin fa ive imnaisu, ma ikofen, “Ae, yavarek fasaw resari, ave yenef.”<note caller="+" style="x"><char style="xo" closed="false">6:10-11 </char><char style="xt" closed="false"><ref loc="PRO 24:33-34">WosAn. 24:33-34</ref></char></note> <verse eid="PRO 6:10" /><verse number="11" style="v" sid="PRO 6:11" />Rarirya fafisu denef kakerya, ananjar ma savararya ifyafer i imnis snonkaku verama vefasyari kuker romamun. <verse eid="PRO 6:11" /><verse number="12" style="v" sid="PRO 6:12" />Snonkaku vevyeva ma vevarvor ikofen rokakuva ro mov vebor kam. <verse eid="PRO 6:12" /><verse number="13" style="v" sid="PRO 6:13" />Isaravreves mkamorsya, wemin ma vrampin vyesya fa vyuki iyofek ankarkar vyena. <verse eid="PRO 6:13" /><verse number="14" style="v" sid="PRO 6:14" />Swaruser vekarfiva vyena nafo kuker au vevyeva vesyakwar ma nafnai vedar mbris ro mov vebor nakam. <verse eid="PRO 6:14" /><verse number="15" style="v" sid="PRO 6:15" />Nanekam nari nafnai kandera venyanem i kuker kanandor, isof vyemompraf kaku.<verse eid="PRO 6:15" /></para>
  <para style="p">
    <verse number="16-19" style="v" sid="PRO 6:16-19" />Roi ri fik <char style="nd">Manseren Allah </char> imarisenba ma myam mondava na:</para>
  <para style="li" vid="PRO 6:16-19">Sane vemarares,</para>
  <para style="li" vid="PRO 6:16-19">Swadon vewos rokakuva,</para>
  <para style="li" vid="PRO 6:16-19">Vramin vesbawer rik snonkaku vesasarva,</para>
  <para style="li" vid="PRO 6:16-19">Wawuk vekara aw vevyeva,</para>
  <para style="li" vid="PRO 6:16-19">Wemin vespak fa vefrar yov varvorna,</para>
  <para style="li" vid="PRO 6:16-19">Snonkaku veyawos sararer vesyakwar, ma</para>
  <para style="li" vid="PRO 6:16-19">Snonkaku vekain rakrok fandu kina.<verse eid="PRO 6:16-19" /></para>
  <para style="s1">Wos swarepen vekur frur sonei</para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 6:20" />Romawa yedi, wafrur rosai kmam pyaisoser kwar ve au, ma befnder awer wos ananun snami vyena. <verse eid="PRO 6:20" /><verse number="21" style="v" sid="PRO 6:21" />Waswarepen pdef wos suvena ma wakramna ro snembrido. <verse eid="PRO 6:21" /><verse number="22" style="v" sid="PRO 6:22" />Wos farkarkor suvena nari nfarkin au ro marandan, nawaren warek au ro fafis wenef ro rov, ma ne akyurfasna ve au rofyor wakvok ro anenef. <verse eid="PRO 6:22" /><verse number="23" style="v" sid="PRO 6:23" />Wos asyoser ma farkarkor ro sinan besuya irya padamara vesnai; wos sansonek suvena nfasnai ve au rari kenem vepyum. <verse eid="PRO 6:23" /><verse number="24" style="v" sid="PRO 6:24" />Rarirya nari newari vinkwanbur vin vevyevasya, ma ro wos vemarnden vemun sayaryur ro snonkakusya swa sesi. <verse eid="PRO 6:24" /><verse number="25" style="v" sid="PRO 6:25" />Wasararan awer padakduk sena, ma snembri pyoser awer mkamor esaravrevs vyesi. <verse eid="PRO 6:25" /><verse number="26" style="v" sid="PRO 6:26" />Vin vevov vinkunya svak i kuker rovean na posren oser monda, imboi wenef kuker vin vefarvukya nari bak i kuker kraf ma rur bedi. <verse eid="PRO 6:26" /><verse number="27" style="v" sid="PRO 6:27" />Ras risai snonkakuyo fyoraven apyamo vo nari inanembaya? <verse eid="PRO 6:27" /><verse number="28" style="v" sid="PRO 6:28" />Ras risai snonkakuyo darfepen fondes vefafarya vo nari wevamya inanemba i? <verse eid="PRO 6:28" /><verse number="29" style="v" sid="PRO 6:29" />Rarirya kako snonkaku veyenef kuker vin vefarvukya. Mansei vefrur radirya nari ikfis bur marindi venyanem inyava. <verse eid="PRO 6:29" /><verse number="30" style="v" sid="PRO 6:30" />Snonkakuyo kyarau rovean, snar ibiserbos kaku, nari ismai anonefva. <verse eid="PRO 6:30" /><verse number="31" style="v" sid="PRO 6:31" />Mboi fafisu sfor inido nari vyak kaver na apaper ri fik; ma kako kuker nana vebor vyenakam. <verse eid="PRO 6:31" /><verse number="32" style="v" sid="PRO 6:32" />Imboi rariso kuker snon eve sonei kuker vin vefarvuk kwar? Ifrur ninyan mankundi! Ifawi nanemba veri! <verse eid="PRO 6:32" /><verse number="33" style="v" sid="PRO 6:33" />Nari sewayam i ma sonef i. Snonsnon vyedi nari isnarem ro fyoro ve fyoro. <verse eid="PRO 6:33" /><verse number="34" style="v" sid="PRO 6:34" />Snar, frur vyedi vyedar vin ani swari myam fadir i, rarirya masasor vyena namsinba. Ma rofyor kyara fa myunsu ido, nari vyuk saneraro ve iva. <verse eid="PRO 6:34" /><verse number="35" style="v" sid="PRO 6:35" />Nari sifyar i kuker kumpan rova sasuref nabor rariso wero, nfasye masasor vyenava.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 7:1" />Romawa yedi, wakifepen pyum kaku wawos ayena ma befnder awer asyoser yavuk kwar faro au. <verse eid="PRO 7:1" /><verse number="2" style="v" sid="PRO 7:2" />Waso pyum wos ananun ayena, insa wakenem kawan kuker aski. Wasopyum kaku farkarkor ayena raris mov mamwarek pyum mkamor besuyara i. <verse eid="PRO 7:2" /><verse number="3" style="v" sid="PRO 7:3" />Waswarepen vesyakwar farkarkor ayanna, ma warduna ro snembrido. <verse eid="PRO 7:3" /><verse number="4" style="v" sid="PRO 7:4" />Nwa firnanemya ve naek ma fawawiya ve bati bedi. <verse eid="PRO 7:4" /><verse number="5" style="v" sid="PRO 7:5" />Firnanemya nari dun au fa wandebur vin veknonbasya, ro vin evesewar kuker wos vemarnden.<verse eid="PRO 7:5" /></para>
  <para style="s1">Vin vekakuva</para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 7:6" />Ras oso yakiki ro kovkir vero rum ayedi. <verse eid="PRO 7:6" /><verse number="7" style="v" sid="PRO 7:7" />Fafis anya yamam romawa snonkbor vemarkboisya; mkasi syo-epenkaku faro romawa snonkbor vefawinanemba oso ro fandu si. <verse eid="PRO 7:7" /><verse number="8-9" style="v" sid="PRO 7:8-9" />Fyor mandira murvav fafisu pampanya dunkwar, snonkbor anya imbran isof fyanam nyan vrapur veso yov mov vin oso vyarek roya. <verse eid="PRO 7:8-9" /><verse number="10-12" style="v" sid="PRO 7:10-12" />Vin anya vin veknon pyum ro rum risyava. Kero isya ro nyan andir, posa wer ido isya ro buves, fyor fyornoido dores iwaf ro nyan farsamna. Vin ani fyarmku ma ifawi imaiva. Yamam syaye kuker sansun imnis vin vevov vinkun, ma isrow kuker snonkbor anya kuker swaruser vevyeva vyena. <verse eid="PRO 7:10-12" /><verse number="13" style="v" sid="PRO 7:13" />Vin anya dawrepen snonkbor ani ma isyumi. Ifawi imaiva ma ikofen, <verse eid="PRO 7:13" /><verse number="14" style="v" sid="PRO 7:14" />“Ras ine yavuk farsarserkwar faro Allah I infa vyak ap ayedi, ma aiwan farsarser ansya kraf vedawersya sisyakaker. <verse eid="PRO 7:14" /><verse number="15" style="v" sid="PRO 7:15" />Evewar yasasyar fa yasewar au, insa wanan ro rum ayedi. Fafis ine yasrow au kwar! <verse eid="PRO 7:15" /><verse number="16" style="v" sid="PRO 7:16" />Kamboi anenef ayedi yakawef i kwar kuker kruven vefarawriwek veraker Mesir, <verse eid="PRO 7:16" /><verse number="17" style="v" sid="PRO 7:17" />ma yasepeki kuker maniy vespum ro rokaker vediref pyum.<figure style="fig" file="HK00118C.TIF" size="col" ref="7:17">Rokaker vediref pyum</figure> <verse eid="PRO 7:17" /><verse number="18" style="v" sid="PRO 7:18" />Kurine, rwama kurafnak ma kuyenef kayam ro rov mankwan ine. <verse eid="PRO 7:18" /><verse number="19" style="v" sid="PRO 7:19" />Swa ayedi isyaro rumba, isyaro marandan vevinkwan kaku. <verse eid="PRO 7:19" /><verse number="20" style="v" sid="PRO 7:20" />Dun kumpansya sibor kaku, ma nari ibur ro paekya faduri.” <verse eid="PRO 7:20" /><verse number="21" style="v" sid="PRO 7:21" />Rarirya vin ani dembuk snonkbor ani kuker wos vemarnden; wos anna nposer snewar isof snonkbor ani isoyuser i. <verse eid="PRO 7:21" /><verse number="22" style="v" sid="PRO 7:22" />Kyara resariva vo iso monda vin ani imnis sapi sfes sasukor vo sun ra sive skaruk. Imnis snonkaku vefawi nanemba sfesepen vo sun fa ismai mamun sfasoskwar; <verse eid="PRO 7:22" /><verse number="23" style="v" sid="PRO 7:23" />kero monda ikoiya myun pansar sneri. Imnisra man verov yov denem, rarirya snonkbor anya ifawiva rur vyedi isyaro marindi.<verse eid="PRO 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 7:24" />Rarirya, romawa yenamko, mkomnaf ve aya. Mkomamepen wos ananun ayenane. <verse eid="PRO 7:24" /><verse number="25" style="v" sid="PRO 7:25" />Buk swaf awer ve vin vera diryanya fa ifrowes au; rwa swewar awer i, <verse eid="PRO 7:25" /><verse number="26" style="v" sid="PRO 7:26" />snar ifrurfa snonsya sibor kenem sena nemompraf. Snon ifrowes fa vemarsya skor napoksiva. <verse eid="PRO 7:26" /><verse number="27" style="v" sid="PRO 7:27" />Rwave rum vyedi imnis waso nyan veknampu vesoyov marmari.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s1">Mkarem Firnanem</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />Mkomnaf kada! Swarnanemya kyaru,</para>
  <para style="q2" vid="PRO 8:1">firnanemya iwawos.<note caller="+" style="x"><char style="xo" closed="false">8:1-3 </char><char style="xt" closed="false"><ref loc="PRO 1:20-21">WosAn. 1:20-21</ref> </char></note><verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />Dores ro urek kapis ro nyan andir ma nyan farsamna.<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />Dores kako ro ris kerwa veba vesun mundum ve kota,</para>
  <para style="q2" vid="PRO 8:3">ro diwa komnaf mkarem vyedi.<verse eid="PRO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4" />Ne, snonkaku mkoya, yavaryas faro mko;</para>
  <para style="q2" vid="PRO 8:4">kawasa vero supswan ine, mkorower wawos ayenane!<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />Vefawi mankunba mkoya, mkofarkor insa mkowasen nanem;</para>
  <para style="q2" vid="PRO 8:5">snonkaku venawnower mkoya, mkofarkor insa mkosmai swar nanem.<verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />Mkofaduru pyum wawos nane,</para>
  <para style="q2" vid="PRO 8:6">snar wos vekaku nairya ma ne fainda.<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />Roi yakofen nanekam nkaku,</para>
  <para style="q2" vid="PRO 8:7">snar yamarisen kaku ankarkarnava.<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />Wos vebor ayenakam nkaku,</para>
  <para style="q2" vid="PRO 8:8">oso vaveri fa pyaparek rova ido syasar.<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />Faro snonkaku vefawi nanemsya, wos ayenane nkaku;</para>
  <para style="q2" vid="PRO 8:9">faro snonkaku vekara pyumsya, wos ayenane nkuksrow kaku.<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />Mkove syowi kaku wos anun nane fa naba syadi ro sarak vekaku,</para>
  <para style="q2" vid="PRO 8:10">fawawiya vye fandun syadi ro brawen vekakur.<verse eid="PRO 8:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />Ayaine kada firnanem, vekakur syadi ro keru besnaper;</para>
  <para style="q2" vid="PRO 8:11">roi snembri isararan na oso vaveri fa kyakur syadi ro i.<verse eid="PRO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />Ayaine kada firnanem; swarnanem,</para>
  <para style="q2" vid="PRO 8:12">swaruser veknon ma fawawi nanem naisya ro aya.<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />Araryof faro <char style="nd">Manseren Allah</char> isoine vinkwanbur varvor na;</para>
  <para style="q2" vid="PRO 8:13">yamarisen faro ararer ma awow nava. Yave mbrov rari</para>
  <para style="q2" vid="PRO 8:13">evarvorna ma wos ankar srerwanan na yamarisen nava<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />Ayaiso vevuk wos ananun.</para>
  <para style="q2" vid="PRO 8:14">Ma vevuk swarnanem faro au ro roi vebor wafrurna.</para>
  <para style="q2" vid="PRO 8:14">Aya vena fawawi nanem ma papoikya.<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />Waireksya yasarampersi fa simbran pyum vave sasoserya,</para>
  <para style="q2" vid="PRO 8:15">mampapoksya yafnovek si fa srawser vavekakakuya fa davyover.<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />Aya vefrurfa snopor ma Mampapok sya</para>
  <para style="q2" vid="PRO 8:16">sikif vavesasoserya ma simbranpyum napnapesya fa dores avyover.<verse eid="PRO 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />Yave syowi kaku mundiri veryav faro aya;</para>
  <para style="q2" vid="PRO 8:17">vesewar aya, nari sisrow kuker aya.<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />Fasasos nana vebor naisya ro aya,</para>
  <para style="q2" vid="PRO 8:18">kako snonsnon vesmai som ma ankamayai.<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />Roivebor wasmairo aya nasyadi ro brawen vekakur;</para>
  <para style="q2" vid="PRO 8:19">ne maeja syadi ro sarak vekaku.<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />Yaso neyan venapes,</para>
  <para style="q2" vid="PRO 8:20">yambran ro neyan veyavyover.<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />Snonkaku eve syowi ayansya, yafrur fa snana;</para>
  <para style="q2" vid="PRO 8:21">yafanfon rum sena ra nafo kuker arasai.<verse eid="PRO 8:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22" />“Ayaiso <char style="nd">Manseren Allah </char> syarmur vepon rak kakuya,</para>
  <para style="q2" vid="PRO 8:22">aya vraur Vyedi vepon randak kakuro awar-madero.<note caller="+" style="x"><char style="xo" closed="false">8:22 </char><char style="xt" closed="false"><ref loc="REV 3:14">Why. 3:14</ref></char></note><verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />Ayaiso syarmur ro awar madero,</para>
  <para style="q2" vid="PRO 8:23">ro randak, syarmur supswan ine vaim.<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />Ayaisyakwar ro vepon soren iraya isyavaim,</para>
  <para style="q2" vid="PRO 8:24">war mkamor vebor nakavavyai vaim.<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />Ayaisya kwar fafis bon naisya vaim,</para>
  <para style="q2" vid="PRO 8:25">ma urekna neveyofer vaim,<verse eid="PRO 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26" />rofyor <char style="nd">Manseren Allah</char> syarmur supswan ine ma maper na vaim,</para>
  <para style="q2" vid="PRO 8:26">kako dofer saprop mnuk randakya vaim.<verse eid="PRO 8:26" /></para>
  <para style="q2">
    <verse number="27" style="v" sid="PRO 8:27" />Yamampumbo mandep iyasyafa vye verer, ma farsyos sansorenya ryeri ra mundi syo epen,<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />fafis anya <char style="nd">Manseren Allah</char> ryir mandifna ro farsyos sansoren,</para>
  <para style="q2" vid="PRO 8:28">ma vyas war mkamor vebor vero swanyado fa narvaren ma nadaf,<verse eid="PRO 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29" />fafis anya vyuk sasoser faro masenya</para>
  <para style="q2" vid="PRO 8:29">insa fyarso ro vonda isyap syadi yen sare na awer.</para>
  <para style="q1" vid="PRO 8:29">Ayaisya kako rodiwa</para>
  <para style="q2" vid="PRO 8:29">fafis supswan ine <char style="nd">Manseren Allah</char> ryir araref vyedi ro fafisu myarari.<verse eid="PRO 8:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 8:30" />Ayaisya ro ris Vyedi ve rumkun saneraro Vyedi,</para>
  <para style="q2" vid="PRO 8:30">ras nakam ayaiso vefrur fa sneri iryav,</para>
  <para style="q2" vid="PRO 8:30">yafnak vesyakwar ro varpon Vyedi.<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />Yaryavyamarisen kaku ro sup swan Vyedine,</para>
  <para style="q2" vid="PRO 8:31">ma saneri ifo kuker doryav rofandu snonkaku sya.<verse eid="PRO 8:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />Rarirya, romawa inai babo mkomnaf ve aya!</para>
  <para style="q2" vid="PRO 8:32">Mkoso akyur fasna ayena, rarirya nari mkosmai aski.<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />Mkomnaf pyum wos ananun ma ivye mkona swaruser veknon,</para>
  <para style="q2" vid="PRO 8:33">mkomamkyof awer na.<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />Aski marisen faro snonkaku vemnaf aya</para>
  <para style="q2" vid="PRO 8:34">ma ras nakam vekain waf ro kerwa rum ayedi,</para>
  <para style="q2" vid="PRO 8:34">ma vewaren warek ro kerwa aidoran ayedi.<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />Mansei vemarisen vesrow kuker aya, ismai kankenem,</para>
  <para style="q2" vid="PRO 8:35">ma isyus faro <char style="nd">Manseren Allah</char> I.<verse eid="PRO 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36" />Mundiri vesrow kuker ayava, ifrur kandera mankundi;</para>
  <para style="q2" vid="PRO 8:36">mundiri eve mbrov aya, irya vye syowi marmarya.”<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s1">Firnanem ma fawi nanemba</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 9:1" />Firnanem vyawes rum vyeja kwar, ma iwar kov kakyar ri fik vyeskoya.<figure style="fig" file="LB00248C.TIF" size="col" ref="9:1">Kov rum vesambrav</figure> <verse eid="PRO 9:1" /><verse number="2" style="v" sid="PRO 9:2" />Kyaruk kwar rofanfan fa ifrur munara, fyasos kako war anggur ma nanan. <verse eid="PRO 9:2" /><verse number="3" style="v" sid="PRO 9:3" />Vin veyuf farmyan vyesi iwansi fa sores ro mov vekaki ma skaru ve kotaya kasiper, <verse eid="PRO 9:3" /><verse number="4" style="v" sid="PRO 9:4" />“Mansei vefawi mankunba, ivye kada isnefer muma!” Faro mansei veswar nanemba, firnanem dawos ra dine, <verse eid="PRO 9:4" /><verse number="5" style="v" sid="PRO 9:5" />“Mkorama mkan nanan nane ma mkinem war anggur yafasos kwar sine. <verse eid="PRO 9:5" /><verse number="6" style="v" sid="PRO 9:6" />Wabur fawi nanembaya, insa wakenem kuker aski marisen. Waso monda neyan kenem snonkaku vefawinanemsya.”<verse eid="PRO 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 9:7" />Snonkaku vemewer vesma farkakorsya kwurfasnai sasar sena ido nari simbrif au. Snonkaku evarvorsya wamsorsi, nari sifover sifyak au. <verse eid="PRO 9:7" /><verse number="8" style="v" sid="PRO 9:8" />Wasonek snonkaku vemewer vemnaf farkarkorsya nawer, snar nari sembrov au. Imboi snonkaku swaruser veknonsya kwurfasnai sasar sena ido, nari sve syowi kaku au. <verse eid="PRO 9:8" /><verse number="9" style="v" sid="PRO 9:9" />Wakofen farkakor snonkaku swaruser venapesya ido nari ismai swaruser veknon nasyadiwer. Farkor snonkaku vesoyuser Allah i nsya nari fawawi sena nfanfanfon.<verse eid="PRO 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 9:10" />Insa wasmai firnanemya ido, veponya besyowi ma wararyof faro <char style="nd">Manseren Allah</char>. Mambir Allah Vesrenya nido, nari wasmai fawawi.<note caller="+" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="JOB 28:28">Ayb. 28:28</ref>; <ref loc="PSA 111:10">Mzm. 111:10</ref>; <ref loc="PRO 1:7">WosAn. 1:7</ref> </char></note> <verse eid="PRO 9:10" /><verse number="11" style="v" sid="PRO 9:11" />Firnanemya nari vyuk ve au kankenem vekwan kaku. <verse eid="PRO 9:11" /><verse number="12" style="v" sid="PRO 9:12" />Fafisu nwa firnanemya ido, nari nwa vayayeya. Imbape kwurpum firnanemya ido, nari wakenem fromo monda. <verse eid="PRO 9:12" /><verse number="13" style="v" sid="PRO 9:13" />Fawi royovaya imnis raris vin svardip eve prepre ma vefawi vemaiva. <verse eid="PRO 9:13" /><verse number="14" style="v" sid="PRO 9:14" />Mov vyedi isoine kerwa rum vyedi rova kerwa veba ro kota. <verse eid="PRO 9:14" /><verse number="15" style="v" sid="PRO 9:15" />Ro diya dor ve kawasa vembranuksya. Snonkaku sne venapes sya kako dembuksi, <verse eid="PRO 9:15" /><verse number="16" style="v" sid="PRO 9:16" />“Snonkaku vefawi karyonba auya, rwama wamnai sar resari!” Ma faro snonkaku vewasen nanemba ikofen ra dine, <verse eid="PRO 9:16" /><verse number="17" style="v" sid="PRO 9:17" />“War kinem karaw nakada nmarnden, ma roveyan kan fasasisna nanbye syadi.” <verse eid="PRO 9:17" /><verse number="18" style="v" sid="PRO 9:18" />Snonkaku daw ninyansya sifawiva vo snonkaku vera yov insya nari simar ro diya; ma mundiri vesun ro rum vyedi, fafis anya kako isya ro mun aivuiya kwar.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s">Wos Anun Salomo vyena</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />Nane kada wos ananun ro Salomo:</para>
  <para style="q1" vid="PRO 10:1">Romawa-inai vena swaruser veknon sifrur doryav kma sedi;</para>
  <para style="q2" vid="PRO 10:1">romawa-inai venawnower sifrur sneduf snari.<verse eid="PRO 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2" />Nana kosmai kuker snefawe ne faindava,</para>
  <para style="q2" vid="PRO 10:2">imboi kenem venapesya nari fyaspar snonkaku bur marmar.<verse eid="PRO 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3" />
    <char style="nd">Manseren Allah</char> myam monda snonkaku kenem venapessya vo sibiserva;</para>
  <para style="q2" vid="PRO 10:3">imbape fandun snonkaku vevarvorsya Kyurpumna.<verse eid="PRO 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4" />Snonkaku vemananonya nari syavarar;</para>
  <para style="q2" vid="PRO 10:4">snonkakuyo imyaren ido nari ismai nana nabor kaku.<verse eid="PRO 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5" />Snonkaku swaruser veknonya dan bo ikram ro fafisu aninek,</para>
  <para style="q2" vid="PRO 10:5">mboi snonkaku veyenef ker ro fafisu aninekya ifrur mamyai mankundi.<verse eid="PRO 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6" />Snonkaku venapesya nari ismai vok,</para>
  <para style="q2" vid="PRO 10:6">imbape wawos snonkaku vevyeva nayofek frur vekarfiva.<verse eid="PRO 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7" />Sane beswar be snonkaku kenem venapesya idaw vok,</para>
  <para style="q2" vid="PRO 10:7">mbape snonkaku vevarvorya sefnder fasau i.<verse eid="PRO 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8" />Snonkaku vefawi nanemya imarisen imnaf wos farkarkor;</para>
  <para style="q2" vid="PRO 10:8">imboi snonkaku vefawi nanemba vo vewos pusmar nari ivorwaworek.<verse eid="PRO 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9" />Snonkaku rari venapes kenem vyedi iknon;</para>
  <para style="q2" vid="PRO 10:9">snonkaku veyankarkarya komambirbosi veri.<verse eid="PRO 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10" />Mundiri vefamyunepen vavekakakuya nari kenem vyedi ifo marindi;</para>
  <para style="q2" vid="PRO 10:10">mundiri veyawos kuker sananai, irya syeref aski.<verse eid="PRO 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11" />Wawos snonkaku venapes namnis raris marei vevuk kankenem,</para>
  <para style="q2" vid="PRO 10:11">imbape wawos snonkaku vevyeva nayofek frur vekarfiva sena.<verse eid="PRO 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12" />Mbrovya ifnai mbris;</para>
  <para style="q2" vid="PRO 10:12">Imbape saswar ma syowiya fyambrum sasar vebor.<verse eid="PRO 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13" />Snonkaku veswar nanem wawos vyena nafo kuker firnanem;</para>
  <para style="q2" vid="PRO 10:13">snonkaku vefawi nanemba ivyekada ismai parader.<verse eid="PRO 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14" />Snonkaku vefirnanem iryur fawawi faro i;</para>
  <para style="q2" vid="PRO 10:14">snonkaku vefawi nanemba, wawos vyena neninyan mankundi.<verse eid="PRO 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15" />Snokaku venana fyaduru kenem vyedi kuker nana vyena,</para>
  <para style="q2" vid="PRO 10:15">sobararya idaw vavemompraf ma marindi.<verse eid="PRO 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16" />Frurpyum snonkaku venapes, vavyak vyedi isoine kenem andei-marasrisen;</para>
  <para style="q2" vid="PRO 10:16">frur snonkaku vevarvor nvedar sasar nabor kaku.<verse eid="PRO 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17" />Mundiri vemnaf wos sansonek nari ikenempyum,</para>
  <para style="q2" vid="PRO 10:17">mundiri vevaryas sasar vyenava ido nari ismai marindi.<verse eid="PRO 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18" />Snonkaku vekram fasis masasorya irya snonkaku veyankarkar.</para>
  <para style="q2" vid="PRO 10:18">Snonkaku vefawar roi vekakuva vekur snonkaku vese irya snonkaku venawnower dirya.<verse eid="PRO 10:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19" />Wos nabor voken, mun nawara sasar nairi;</para>
  <para style="q2" vid="PRO 10:19">snonkaku veyepen ramar vyedi ikada snonkaku swaruser veknon.<verse eid="PRO 10:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20" />Snonkaku venapes wawos vyena namnisra sarak bekakur;</para>
  <para style="q2" vid="PRO 10:20">snonkaku vevarvorya kakara vyena nefaindava.<verse eid="PRO 10:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21" />Wawos snonkaku rari venapes, nadaw vok faro kawasa vebor;</para>
  <para style="q2" vid="PRO 10:21">mboi snonkaku vefawi nanembaya imar snar iswar nanemba.<verse eid="PRO 10:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22" />Vok ro <char style="nd">Manseren Allah</char> I monda evewar snonkakusya sismai nana;</para>
  <para style="q2" vid="PRO 10:22">fararur marvakya monda fyamfon arasai nava.<verse eid="PRO 10:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23" />Snonkaku venawnower imarisen ifrur sasar;</para>
  <para style="q2" vid="PRO 10:23">mboi snonkaku vefawi nanem iryav kaku syeref firnanemya.<verse eid="PRO 10:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24" />Snonkaku venapes nari ismai roi imarisen na;</para>
  <para style="q2" vid="PRO 10:24">mbape snonkaku vevarvor nari ismai roi imkak syadi kakuna.<verse eid="PRO 10:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25" />Fafis wam dover imyow kenem ine ido, snonkaku vevarvorsya nari sirwu simufer;</para>
  <para style="q2" vid="PRO 10:25">mbape snonkaku venapesya nari kyain fioro-fioro.<verse eid="PRO 10:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26" />Famyan awer snonkaku vemyarenba si, sifrur fafayaf monda au,</para>
  <para style="q2" vid="PRO 10:26">simnis raris ansfus vefrur mananir rova for pau vefrur praper mkamor.<verse eid="PRO 10:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27" />Wararyof faro <char style="nd">Manseren Allah</char> I rarirya nari wakenem kawan;</para>
  <para style="q2" vid="PRO 10:27">mbape snonkaku vevarvorsya nari simar kafadu.<verse eid="PRO 10:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28" />Sanekayar snonkaku venapesya nari vyuk marasrisen;</para>
  <para style="q2" vid="PRO 10:28">sanekayar snonkaku vevarvorya nefromo monda.<verse eid="PRO 10:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29" />
    <char style="nd">Manseren Allah</char> kyadaun snonkaku rari vepyum,</para>
  <para style="q2" vid="PRO 10:29">imbape myun pres snonkaku vefrur sasarsya.<verse eid="PRO 10:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30" />Snonkaku venapes nari ikenem kuker aski marisen;</para>
  <para style="q2" vid="PRO 10:30">snonkaku vevarvorsya nari sikenem ro sup mankun sejava.<verse eid="PRO 10:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31" />Snonkaku venapesya svari isasyar wos firnanem;</para>
  <para style="q2" vid="PRO 10:31">imbape Allah nari Isisen snonkaku vevarvorsya sisvasna.<verse eid="PRO 10:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32" />Snonkaku kenem venapessya wos sena nafrur sneprei;</para>
  <para style="q2" vid="PRO 10:32">snonkaku vevarvorsya wos sena nafrur sneduf.<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1" />
    <char style="nd">Manseren Allah</char> imsor snonkaku vekif wankyara veradadu</para>
  <para style="q2" vid="PRO 11:1">imbape iryav kaku faro snonkaku veyuf wankyara vekakudam.<verse eid="PRO 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2" />Snonkaku vemarares nari sisma anonef;</para>
  <para style="q2" vid="PRO 11:2">snonkaku verun mankunsya sirya snonkaku vena firnanem.<verse eid="PRO 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3" />Snonkaku rari vepyumsya napnapesya fyarkinsi;</para>
  <para style="q2" vid="PRO 11:3">snonkaku veyawos ankarkar nari vye mompraf snar ankarkar vyena.<verse eid="PRO 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4" />Fafis komar, arasai vebor ne faindava;</para>
  <para style="q2" vid="PRO 11:4">imbape kakakuya nari fyaspar snonkaku bur marmar.<verse eid="PRO 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5" />Snonkaku kenem venapessya imbran ro neyan vepyom snar napnapes vyena,</para>
  <para style="q2" vid="PRO 11:5">imbape snonkaku vevarvorya kenem vyedi vyemomprafe.<verse eid="PRO 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6" />Snonkaku venapes ismai faspar snar saso asuser vyena;</para>
  <para style="q2" vid="PRO 11:6">snonkaku veyankarkar isapi ro denem snar an nambri vyena.<verse eid="PRO 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7" />Snonkaku vevarvorya imarido, sanekayar vyenakam namar;</para>
  <para style="q2" vid="PRO 11:7">naba syadi kyara fa nari ismai nana nabor.<verse eid="PRO 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8" />Snonkaku kenem venapes nari dande bur samswenya;</para>
  <para style="q2" vid="PRO 11:8">imbape snonkaku vevarvor ismai ananjar.<verse eid="PRO 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9" />Fawar snonkaku vevarvor nafnai marmar faro snonkaku min vyesi,</para>
  <para style="q2" vid="PRO 11:9">imbape snonkaku venapes ismai faspar snar fawinanem vyena.<verse eid="PRO 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10" />Kotaya ifo kuker doryav marisen rofyor snonkaku kenem venapesya ismai kamayai;</para>
  <para style="q2" vid="PRO 11:10">imbape snonkaku vevarvorya imar ido kawasasya simarisen syadi.<verse eid="PRO 11:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11" />Vok snonkaku venapes nbawes kotaya fa iryewen ma imbrar ve varpon;</para>
  <para style="q2" vid="PRO 11:11">imbape wawos snonkaku vevarvor sya sena nafrur mkok kota.<verse eid="PRO 11:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12" />Mansei vekoryaye min vyedi, ifawi nanemba veri;</para>
  <para style="q2" vid="PRO 11:12">snonkaku vefawi nanem, kyain fasis monda, iwos famfnomba.<verse eid="PRO 11:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13" />Snonkaku vefamfayai abar vekakuva ikram woskunes nava,</para>
  <para style="q2" vid="PRO 11:13">imbape snonkaku vesmai kayaryarya ikada fyamrum wos vevyeva.<verse eid="PRO 11:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14" />Manfarkinya isyava ido er vebaya nari ivesisye,</para>
  <para style="q2" vid="PRO 11:14">imboi snonkaku vevuk wos ananun sibor ido, kankenem vepyumya isya kako.<verse eid="PRO 11:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15" />Wafrur ap fa nari bak pyan snonkakuyo nyaki vyena ido, nari vyedar fa wasmai marindi.</para>
  <para style="q2" vid="PRO 11:15">ipyum syadi wafrur radirya nawer insa wakenem kuker kananon.<verse eid="PRO 11:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16" />Vin vevesyowi ismai ararer;</para>
  <para style="q2" vid="PRO 11:16">snonkaku vevarvor iryur monda arasai.<verse eid="PRO 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17" />Snonkaku evenavye vesyakwar nari ismai sasuref;</para>
  <para style="q2" vid="PRO 11:17">imbape snonkaku evarvor vye ninyan mankundi.<verse eid="PRO 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18" />Snonkaku vevarvor iryur arasai vemyomen,</para>
  <para style="q2" vid="PRO 11:18">mbape snonkaku vevuver kakaku ismai sasuref vekain fiorobis.<verse eid="PRO 11:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19" />Mundiri vefrurpyum vesyakwar, nari ikenem kuker aski;</para>
  <para style="q2" vid="PRO 11:19">imbape mansei veyom vavyevaya, imbran yov marmar.<verse eid="PRO 11:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20" />
    <char style="nd">Manseren Allah</char> vye mbrov snonkaku sne vevarvor sya,</para>
  <para style="q2" vid="PRO 11:20">imboi iswar snonkaku sne venapes sya.<verse eid="PRO 11:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21" />Kakudam, snonkaku vevarvorsya sikfisbur vave ninyanyava;</para>
  <para style="q2" vid="PRO 11:21">snonkaku kenem venapes nari sismai faspar.<verse eid="PRO 11:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22" />Vin vedoser imboi rari vepyumba</para>
  <para style="q2" vid="PRO 11:22">imnis rofafyai brawen ro randip snonipoi.<verse eid="PRO 11:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23" />Snonkaku venapes fandun sena nadaw roi vepyum,</para>
  <para style="q2" vid="PRO 11:23">imbape snonkaku vevarvorsya roi sefandun isoine masasorya monda.<verse eid="PRO 11:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24" />Snonkaku veyan bo vevov, nana vyena nfanfanfon vesyakwar,</para>
  <para style="q2" vid="PRO 11:24">Snonkaku veyardu nana vyena nari syovarar.<verse eid="PRO 11:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25" />Mundiri verarwas vok vyena ido nari ismai kamayai,</para>
  <para style="q2" vid="PRO 11:25">snonkaku vemarisen vefnovek min vyesi nari ismai fanfnovek kako.<verse eid="PRO 11:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26" />Mansei veyardu fasis pokem, isma fras ro snonkakusya;</para>
  <para style="q2" vid="PRO 11:26">imboi snonkaku vevovya, nari iser ararer.<verse eid="PRO 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27" />Mansei vefrur pyum vesyakwar nari kawasa vebor simariseni;</para>
  <para style="q2" vid="PRO 11:27">mbape mansei vesewar vavyevaya nari samswenya inyanem i<verse eid="PRO 11:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28" />Mansei vekyar faro nana vyena nari irwu imnis airam vemas;</para>
  <para style="q2" vid="PRO 11:28">snonkaku rari venapes nari isur imnis kpiwer babo.<verse eid="PRO 11:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29" />Mundiri vefrur mkok kina vyedi, nari daksmai royova ro nana kina vyedi;</para>
  <para style="q2" vid="PRO 11:29">snonkaku vefawi nanemba nari vye manfyan faro snokaku vefawi nananemya.<verse eid="PRO 11:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30" />Snonkaku venapes imnis aiknam kankenem;</para>
  <para style="q2" vid="PRO 11:30">snonkaku vefirnanem kawasa sibor nari siso i.<verse eid="PRO 11:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31" />Snonkaku venapes sya nari sismai sasuref kako fafis sisya kaker ro supswan ine,</para>
  <para style="q2" vid="PRO 11:31">snonkaku vevarvor ma vesasarsya nari sismai kandera naba syadi wer.<note caller="+" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="1PE 4:18">1Ptr. 4:18</ref></char></note><verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1" />Snonkaku veswar kuf faro fawawi, imarisen fa ismai wos sansonek;</para>
  <para style="q2" vid="PRO 12:1">mbape snonkaku vemewer vemnaf wos sansonek irya snonkaku vefawi rorova.<verse eid="PRO 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2" />Snonkaku vena rari vepyumsya sisyus faro <char style="nd">Manseren Allah</char>,</para>
  <para style="q2" vid="PRO 12:2">mbape snonkaku veyankarkar nari sismai marindi.<verse eid="PRO 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3" />Oso vaveri fa nari syambrav pdef kuker rari varvor vyena;</para>
  <para style="q2" vid="PRO 12:3">mboi snonkaku venapes nari idworem, ma imyowva.<verse eid="PRO 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4" />Vin vefawinanem iser sanandik ma sane vemarisen ro swa vyedi,</para>
  <para style="q2" vid="PRO 12:4">vin vefrur mamyai swa vyedi imnis kaku dafduf veyanakuk kor sinan.<verse eid="PRO 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5" />Snonkaku kenem venapes skara roi veyun payamyum;</para>
  <para style="q2" vid="PRO 12:5">snonkaku vevarvor sya saw monda ankar frowes wanan.<verse eid="PRO 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6" />Wawos snonkaku vevarvor nafnai marmar;</para>
  <para style="q2" vid="PRO 12:6">wawos snonkaku venapes nfaspar snonkaku.<verse eid="PRO 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7" />Snonkaku vevarvor nari simufer ma simar ra sefromo;</para>
  <para style="q2" vid="PRO 12:7">imbape snonkaku venapes nari skain nako sikapar siryewen.<verse eid="PRO 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8" />Snonkaku sismai ararer snar swarnanem sena;</para>
  <para style="q2" vid="PRO 12:8">snonkaku sismai anonef snar fawi rorova sena.<verse eid="PRO 12:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9" />Ivye komnis snonkaku vemankasva imboi kofararur faro mankun ko,</para>
  <para style="q2" vid="PRO 12:9">ipyum syadi ro kofrur ve snonkaku eve nasan mboi kananjar nanan.<verse eid="PRO 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10" />Snonkaku venapes fyadurupyum rofanfan vyesi;</para>
  <para style="q2" vid="PRO 12:10">imbape snonkaku evarvor vyeninyan si.<verse eid="PRO 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11" />Manamom vefararur marvak ro yaf vyena ismai roveyan nabor,</para>
  <para style="q2" vid="PRO 12:11">vape snonkaku vesawen fafisu faro roi eve faindava irya snonkaku vefawi nanemba.<verse eid="PRO 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12" />Snonkaku evarvor sneri fyawe nana snonkaku kenem vekarfiva sena;</para>
  <para style="q2" vid="PRO 12:12">snonkaku venapesya imnis raris ai knam vemarem vevuk bon.<verse eid="PRO 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13" />Snonkaku evarvorsya wos vekarfiva sena namnis denem vefor mankun si;</para>
  <para style="q2" vid="PRO 12:13">snonkaku venapes sikfisbur neyan samswen.<verse eid="PRO 12:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14" />Snonkakusya sismai sasuref raris wawos ma frur sena;</para>
  <para style="q2" vid="PRO 12:14">vavyak faro si namnis raris roi sifrur kwarna.<verse eid="PRO 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15" />Snonkaku vefawi nanembaya vyavir mankundi ve snonkaku vefrur sasarva,</para>
  <para style="q2" vid="PRO 12:15">imboi snonkaku vemarisen vemnaf farkarkor, irya snonkaku vefirnanem.<verse eid="PRO 12:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16" />Snonkaku vefawi nanembaya sneri ipraper ido, fafis anya veri dawos sneduf vyena;</para>
  <para style="q2" vid="PRO 12:16">imboi snonkaku swaruser veknon vye fandunba fafisu ismai anonef.<verse eid="PRO 12:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17" />Snonkaku venapes, fyawar roi vekaku ro varpon mankakara,</para>
  <para style="q2" vid="PRO 12:17">imboi snonkaku kenem venapesva, fyawar monda wos ankarkar.<verse eid="PRO 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18" />Wawos pusmar imnis rorabi vewanuk sane;</para>
  <para style="q2" vid="PRO 12:18">wawos vekaku namnis raris aryawin vevuk pararei.<verse eid="PRO 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19" />Wawos vekaku nari nkain fioro-fioro,</para>
  <para style="q2" vid="PRO 12:19">imboi wos ankarkar nari fyorova namyomen.<verse eid="PRO 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20" />Snonkaku veyau frur vevyeva sneri ifo kuker ankarkar;</para>
  <para style="q2" vid="PRO 12:20">mbape snonkaku veyau payamyum sisma marasrisen.<verse eid="PRO 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21" />Snonkaku venapesya nari ismai marindiva ,</para>
  <para style="q2" vid="PRO 12:21">snonkaku vevarvor ismai ananjar vesyakwar.<verse eid="PRO 12:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22" />Manseren Allah vye mbrov snonkaku veyankarkarsya;</para>
  <para style="q2" vid="PRO 12:22">imbape Imarisen faro snonkaku rari venapessya.<verse eid="PRO 12:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23" />Snonkaku swaruser veknon ikram fasis fawawi vyena;</para>
  <para style="q2" vid="PRO 12:23">mbape snonkaku venawnower fyasnai bos fawi nanemba vyena.<verse eid="PRO 12:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24" />Wafararur nasrawen ido, irya nari besnopor;</para>
  <para style="q2" vid="PRO 12:24">imbape mananonya ifnai vedar vave manfyan.<verse eid="PRO 12:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25" />Sane vekamanen pyankar samambrav,</para>
  <para style="q2" vid="PRO 12:25">wos vemyaren nbuk doryav.<verse eid="PRO 12:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26" />Snonkaku venapes myam farfir manivov vyesi;</para>
  <para style="q2" vid="PRO 12:26">imbape snonkaku evarvorya dun snonkaku ve nyan vesunkarkir.<verse eid="PRO 12:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27" />Snonkaku vemananonya nari ismai roi syewar nava;</para>
  <para style="q2" vid="PRO 12:27">kuker fararur marvak snonkaku sismai arasai nabor.<verse eid="PRO 12:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28" />Snonkaku vembran ro neyan venapes nari ikenem kuker aski;</para>
  <para style="q2" vid="PRO 12:28">snonkaku vembran ro neyan vevyeva imbranyov marmar.<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1" />Romawa vefawi nanem imnaf ma vye asuser farkarkor ro kmari;</para>
  <para style="q2" vid="PRO 13:1">snonkaku vemararesya imewer imnaf wos farkarkordi.<verse eid="PRO 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2" />Wawos snonkaku rari vepyum nun faro payamyum;</para>
  <para style="q2" vid="PRO 13:2">imbape snonkaku veyawos ankarkar imarisen ifrur roi vekarfiva.<verse eid="PRO 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3" />Snonkaku vesasorpyum wawos vyena nari ikenem kuker kananon;</para>
  <para style="q2" vid="PRO 13:3">snonkaku veyawos pusmar nari ismai marindi nabor kaku.<verse eid="PRO 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4" />Snonkaku vemyarenba, fandun vyena nabor kaku imbape ismai osova veri;</para>
  <para style="q2" vid="PRO 13:4">Snonkaku vefararur nasrawen kaku ismai roi vevor vye fandun na.<verse eid="PRO 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5" />Snonkaku venapes imarisen wos ankarkar nava,</para>
  <para style="q2" vid="PRO 13:5">snonkaku vevarvor ifrur mamyai ma ifrur anonef mankundi.<verse eid="PRO 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6" />Kakakuya ikadaun snonkaku kenem veyavyoversya;</para>
  <para style="q2" vid="PRO 13:6">vavyevaya ifrurfa snonkaku vesasarsya se mompraf.<verse eid="PRO 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7" />Snonkaku ono sisya sifrur ve snonkaku venana, imbape sna rorova,</para>
  <para style="q2" vid="PRO 13:7">ono sisya kako sifrurve snonkaku vesavarar, imbape nana sena nabor kaku.<verse eid="PRO 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8" />Snonkaku vesmai nana nabor ivye isasyar kumpan sibor infa vyak snonkaku eve mbrov i insamaido kenem vyedi iknon;</para>
  <para style="q2" vid="PRO 13:8">snonkaku vesavarar semkei ro faimakakna.<verse eid="PRO 13:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9" />Snonkaku venapes imnis sonai vefadameser;</para>
  <para style="q2" vid="PRO 13:9">snonkaku vevarvor imnis padamara vembrer.<figure style="fig" file="HK00151C.TIF" size="col" ref="13:9">Padamara</figure><verse eid="PRO 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10" />Awowya idaw monda rakrok;</para>
  <para style="q2" vid="PRO 13:10">imbape snonkaku vefirnanemya imarisen imnaf wos farkarkor.<verse eid="PRO 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11" />Nana kosmai fasaw kuker nyan vepyan nari namyomen fasawdam monda;</para>
  <para style="q2" vid="PRO 13:11">mbape nana kermkun koryur fawas na fyoro muma ido nari nfanfanfon ra nabor kaku.<verse eid="PRO 13:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12" />Roi kove fandun kakuna kosmai fasawnava ido nafrur sne fafardun,</para>
  <para style="q2" vid="PRO 13:12">mboi roi kove fandun anna naisya kwarido kosnesna namarisen.<verse eid="PRO 13:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13" />Snonkaku vekorwef ananun <char style="nd">Manseren Allah </char> vyena, ifrur ninyan mankundi;</para>
  <para style="q2" vid="PRO 13:13">snonkaku vesoyuser faro sasoser Allah Vyena nari sismai sasuref.<verse eid="PRO 13:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14" />Farkarkor snonkaku vefirnanem irya knam vave aski;</para>
  <para style="q2" vid="PRO 13:14">fafis sismai roi vevyeva nari venyanemsi, wos ananun anna nfaspar si.<verse eid="PRO 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15" />Snonkaku veswar nanem nari sismai ararer;</para>
  <para style="q2" vid="PRO 13:15">snonkaku veyankarkar nari ismai marindi.<verse eid="PRO 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16" />Snonkaku kakara veknon kyara vepon fafisu ifrur vaim;</para>
  <para style="q2" vid="PRO 13:16">snonkaku venawnower vyavdas fawi nanemba vyena.<verse eid="PRO 13:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17" />Manwawan evarvor ifnai vedar vavyeva;</para>
  <para style="q2" vid="PRO 13:17">manwawan vesmai kayaryarya ifrur fa roi vebor nakam napyum navye.<verse eid="PRO 13:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18" />Snonkaku vemewer vesmai farkarkor sisavarar ma sismai anonef;</para>
  <para style="q2" vid="PRO 13:18">snonkaku veyaser wos farkarkor nari sismai ararer.<verse eid="PRO 13:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19" />Marisen vefnakva rofyor mkosmai rosai mkovefandun na!</para>
  <para style="q2" vid="PRO 13:19">Snonkaku venawnower imewer vyoyarbur vavyevayandi.<verse eid="PRO 13:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20" />Mundiri vekenemso snonkaku swaruser veknon, nari ismai swaruser veknon;</para>
  <para style="q2" vid="PRO 13:20">Mundiri eve manivov kuker snonkaku venawnower, nari ismai marindi.<verse eid="PRO 13:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21" />Snonkaku vesasarya ananjarya iyom i vesyakwar</para>
  <para style="q2" vid="PRO 13:21">snonkaku kenem venapesya isma aski vesyakwar.<verse eid="PRO 13:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22" />Snonkaku kenem venapes fyasos arasai faro romawa ma kpu vyesi;</para>
  <para style="q2" vid="PRO 13:22">nana snonkaku vesasar ne vekram faro snonkaku kenem veyavyoversya.<verse eid="PRO 13:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23" />Rovean nabor kaku sismai na ro saprop snonkaku vesavarar;</para>
  <para style="q2" vid="PRO 13:23">mbape snonkaku vesesya sfasyarker na.<verse eid="PRO 13:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24" />Snonkakuyo fyarkor romawa vyejava ido, irya iswar iva;</para>
  <para style="q2" vid="PRO 13:24">imboi iswar i nido nari fyarkor i ma isonek i.<verse eid="PRO 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25" />Snonkaku venapes ipok dananjarva;</para>
  <para style="q2" vid="PRO 13:25">Snonkaku vevarvor dananjar vesyakwar.<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1" />Vin vefawi nanem vyawes rum ma kina vyedi,</para>
  <para style="q2" vid="PRO 14:1">mbape vin vefawi nanemba vramin vyesuya susyov kakek.<verse eid="PRO 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2" />Snonkaku rari veyavyover iraryof ma kyunem faro <char style="nd">Manseren Allah</char> I;</para>
  <para style="q2" vid="PRO 14:2">Snonkaku kenem veyavyoverva irya donef I.<verse eid="PRO 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3" />Snonkaku vefawi rorovaya imarares ma dow mankundi;</para>
  <para style="q2" vid="PRO 14:3">Snonkaku vefirnanem ismai kadaun ro wos vyena.<verse eid="PRO 14:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4" />Snonkaku vemananon imewer fyan sapiri insa ifron awer padwar;</para>
  <para style="q2" vid="PRO 14:4">mbape kuker sapi vesambrav, nari pokem sibor kaku.<verse eid="PRO 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5" />Snonkaku vemam karyer ma rari veyavyover ikada dawos kakaku ro varpon mankakara,</para>
  <para style="q2" vid="PRO 14:5">snonkaku vemam karyer imboi veyawos sararer ismai kayaryarva.<verse eid="PRO 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6" />Snonkaku vemarares syewar firnanemya, fama ismaiva,</para>
  <para style="q2" vid="PRO 14:6">mbape snonkaku veswar nanem ipyan kaku fa ismai fawawiya.<verse eid="PRO 14:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7" />Vinkwanbur snonkaku venawnowerya;</para>
  <para style="q2" vid="PRO 14:7">snar nari wasmai farkarkor vepyumno ro iva.<verse eid="PRO 14:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8" />Snonkaku vefirnanem ifawi rosai nari ifrurya,</para>
  <para style="q2" vid="PRO 14:8">snonkaku venawnower ivor famfnom snar fawi nanemba vyena.<verse eid="PRO 14:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9" />Snonkaku vefawi nanemba sasar vyena ne vefakman ke rova vye fandunva;</para>
  <para style="q2" vid="PRO 14:9">snonkaku kenem venapes imarisen sasar vyena ne vefakman.<verse eid="PRO 14:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10" />Marisen rova marindi nakam nevekram ro sane;</para>
  <para style="q2" vid="PRO 14:10">snonkaku vesesya sakfawinava.<verse eid="PRO 14:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11" />Snonkaku venapes rum vyedi kyain nadworem pdef;</para>
  <para style="q2" vid="PRO 14:11">snonkaku vevarvor rum vyedi nari kyarvaken.<verse eid="PRO 14:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12" />Nyanya isya komam ido davyover,</para>
  <para style="q2" vid="PRO 14:12">vape varpurya syo yov mun aivuiya.<note caller="+" style="x"><char style="xo" closed="false">14:12 </char><char style="xt" closed="false"><ref loc="PRO 16:25">WosAn. 16:25</ref></char></note><verse eid="PRO 14:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13" />Sava vembrif fyorno ido ikram kanes ro sane;</para>
  <para style="q2" vid="PRO 14:13">marasrisenya fyorno ido fyarwe kako ve marindi.<verse eid="PRO 14:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14" />Snonkaku vevarvor nari dinek bon vevyeva ro varvor vyena,</para>
  <para style="q2" vid="PRO 14:14">snonkaku venapes nari dinek bon vepyum ro frurpyum vyena.<verse eid="PRO 14:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15" />Snonkaku vefawi karyonba ikyar wos snonkakusya,</para>
  <para style="q2" vid="PRO 14:15">snonkaku swaruser veknon kyara user rosai ifrurna.<verse eid="PRO 14:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16" />Snonkaku vefirnanem syasor i ma vyinkwan bur varvorna,</para>
  <para style="q2" vid="PRO 14:16">vape snonkaku venawnower fyasnai beri dormomen vyena ma kyara roi ifrurna napyum.<verse eid="PRO 14:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17" />Snonkaku vemasasor fasawya ifawi napyomba;</para>
  <para style="q2" vid="PRO 14:17">snonkaku swaruser veknonya vye avaven.<verse eid="PRO 14:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18" />Snonkaku vefawi karyonbaya nari ifawi nanemba;</para>
  <para style="q2" vid="PRO 14:18">snonkaku swaruser veknon nari fawawi vyena nfanfanfon.<verse eid="PRO 14:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19" />Snonkaku vevarvor nari kyunem faro snonkaku kenem venapesya,</para>
  <para style="q2" vid="PRO 14:19">ma dor insa ismai syowi ro i.<verse eid="PRO 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20" />Snonkaku vesavarar, manivov vyesya monda simarisen iva;</para>
  <para style="q2" vid="PRO 14:20">imboi snonkaku venana bati vyesya sibor kaku.<verse eid="PRO 14:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21" />Mundiri vekoryaye snonkaku vese, ifrur sasar;</para>
  <para style="q2" vid="PRO 14:21">Mundiri vefrur pyum faro snonkaku vesavarar, nari ismai aski.<verse eid="PRO 14:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22" />Mundiri vekara fa vefrur roi vepyum, nari ismai kayaryar ma sve syowi i;</para>
  <para style="q2" vid="PRO 14:22">mundiri vekara frur vevyeva isya ro neyan sunkarkir.<verse eid="PRO 14:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23" />Ro sasewar ma marmor kanderana nari kosmai bon;</para>
  <para style="q2" vid="PRO 14:23">mbape wawos eve beidi nadaw ananjar ma sovarar.<verse eid="PRO 14:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24" />Snonkaku vefirnanem ismai ararer ro kawasa vebor snar fawawi nanem vyena,</para>
  <para style="q2" vid="PRO 14:24">snonkaku venawnowerya sifawi bos i ro fawiroyova vyena.<verse eid="PRO 14:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25" />Snonkaku vemam karyer ma veyawos kakaku ro varpon mankakara, fyaspar kenem;</para>
  <para style="q2" vid="PRO 14:25">imbo iwos sararer ido irya vye ninyan min vyesi.<verse eid="PRO 14:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26" />Snonkaku veyararyof faro <char style="nd">Manseren Allah </char> I ikenem kuker kananon,</para>
  <para style="q2" vid="PRO 14:26">ma kina vyedi ismai kadaun.<verse eid="PRO 14:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27" />Araryof faro <char style="nd">Manseren Allah </char> I irya rakrak ro vave aski;</para>
  <para style="q2" vid="PRO 14:27">ma neyan veyun fa kovoyar bur marmari.<verse eid="PRO 14:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28" />Wairekya isma ararer ma syowi snar fyarkin kawasa sibor;</para>
  <para style="q2" vid="PRO 14:28">imboi kawasa nova ido isma papoik fa vyuki vye parensava.<verse eid="PRO 14:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29" />Snokaku veswar nanem imsor sawsawva;</para>
  <para style="q2" vid="PRO 14:29">Snonkaku vemsor sawsaw irya ifawi rorova.<verse eid="PRO 14:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30" />Sane veknon vyuk pararei faro bakenya;</para>
  <para style="q2" vid="PRO 14:30">Sne vevyeva imnis dafduf veyun marmar.<verse eid="PRO 14:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31" />Mundiri vefrur pyum faro snonkaku vesavarar, irya vye syowi Allah I;</para>
  <para style="q2" vid="PRO 14:31">mundiri veyarefepen snonkaku veryarva, irya kyoryaye Allah vesarmurinya.<verse eid="PRO 14:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32" />Snonkaku vevarvor ryo ra idawer snar frur vevyeva vyena,</para>
  <para style="q2" vid="PRO 14:32">snonkaku venapes ismai kadaun ro kenem venapes vyena.<verse eid="PRO 14:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33" />Firnanemya isya ro sane snonkaku veswar nanem;</para>
  <para style="q2" vid="PRO 14:33">mbape isyava ro swaruser snonkaku venawnowerya.<verse eid="PRO 14:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34" />Kakaku ma payamyumya ikanow sif er vebaya,</para>
  <para style="q2" vid="PRO 14:34">imboi sasarna nafrur fa er veba ani isma anonef.<verse eid="PRO 14:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35" />Wairek imarisen faro manfamyan vesbik, veyuf farmyani kuker pyum;</para>
  <para style="q2" vid="PRO 14:35">imboi imsor faro manfamyan vefararur pyumba.<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1" />Kankarem vemyaren, vyedar dormomen na namyomen;</para>
  <para style="q2" vid="PRO 15:1">imboi wos vesam nbawes masasor.<verse eid="PRO 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2" />Snonkaku vefirnanem wos vyena nasasyar fawawi;</para>
  <para style="q2" vid="PRO 15:2">mbape wawos snonkaku venawnower ne fromo monda.<verse eid="PRO 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3" />
    <char style="nd">Manseren Allah</char> myam fafewa roi vebor ro mov nakam;</para>
  <para style="q2" vid="PRO 15:3">Myamepen snonkaku rari venapes ma snonkaku rari vevyeva.<verse eid="PRO 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4" />Wawos vepyum namnis raris aiknam vevuk kankenem,</para>
  <para style="q2" vid="PRO 15:4">imboi ramar veyankarkar nafrur sneduf.<verse eid="PRO 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5" />Romawa vefawinanemba kyurpum kmar wos farkarkor vyena,</para>
  <para style="q2" vid="PRO 15:5">romawa swaruser veknon imarisen imnaf wos farkarkor.<verse eid="PRO 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6" />Ro rum snonkaku rari venapes arasai naisya nabor kaku;</para>
  <para style="q2" vid="PRO 15:6">imboi snonkaku rari vevyeva nana ismaina nadaw payamyumba.<verse eid="PRO 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7" />Wawos snonkaku vefirnanem nafo kuker fawawi,</para>
  <para style="q2" vid="PRO 15:7">imboi swaruser snonkaku venawnower ne fromo monda.<verse eid="PRO 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8" />
    <char style="nd">Manseren Allah</char> imarisen imnaf nadi snonkaku venapessya,</para>
  <para style="q2" vid="PRO 15:8">imboi aiwan farsarser snonkaku rari vevyevasya sena Imarisen nava.<verse eid="PRO 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9" />
    <char style="nd">Manseren Allah </char> vye mbrov snonkaku rari vevyevasya,</para>
  <para style="q2" vid="PRO 15:9">imboi Vye syowi snonkaku evesewar fa vefrur kakakuya.<verse eid="PRO 15:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10" />Snonkaku vefrur roi vevyeva nari sve ninyan si;</para>
  <para style="q2" vid="PRO 15:10">snonkaku vemewer vemnaf farkarkorsya nari simar.<verse eid="PRO 15:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11" />
    <char style="nd">Manseren Allah</char> ifawi pres roi vebor kam vero mun aivuiya;</para>
  <para style="q2" vid="PRO 15:11">isyadadi ifawi kako roi kokara ro kosnesna.<verse eid="PRO 15:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12" />Snonkaku vemarares imewer sisonek indi;</para>
  <para style="q2" vid="PRO 15:12">imewer ismai farkarkor ro snonkaku veswar nanemsya ndi.<verse eid="PRO 15:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13" />Sane veryav ifnai vedar mkamor vemam mayar;</para>
  <para style="q2" vid="PRO 15:13">imboi sane vefafardun pyankar sasbik.<verse eid="PRO 15:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14" />Snonkaku veswar nanem vyesewar monda fa ismai fawawiya;</para>
  <para style="q2" vid="PRO 15:14">snonkaku venawnower syombirek kuker fawi nanemba vyena.<verse eid="PRO 15:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15" />Snonkaku vesinanjarsya sikenem ro do marindi vesyakwar,</para>
  <para style="q2" vid="PRO 15:15">imbape snonkaku sane veryav kenem vyedi ifo aski vesyakwar.<verse eid="PRO 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16" />Arasai kermkun nasosif araryof faro <char style="nd">Manseren Allah</char> I,</para>
  <para style="q2" vid="PRO 15:16">ipyum syadi ro arasai nabor imboi kenemya ifo kuker virvar.<verse eid="PRO 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17" />Ipyum syadi wan wei ram monda kuker vave syowi,</para>
  <para style="q2" vid="PRO 15:17">ivye ro wan manfnai kraf vemafen kuker vave mbrov.<verse eid="PRO 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18" />Snonkaku vemasasor fasaw vyawes wos fanfavri,</para>
  <para style="q2" vid="PRO 15:18">snonkaku sane vekwan fyasye mbris.<verse eid="PRO 15:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19" />Snonkaku vemananon nari ismai ker awaw ananjar;</para>
  <para style="q2" vid="PRO 15:19">imboi snonkaku venapes imbran ro nyan vepyom.<verse eid="PRO 15:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20" />Romawa veswarnanem, ifrur doryav kmari;</para>
  <para style="q2" vid="PRO 15:20">imboi romawa venawnower vye syowi snariva.<verse eid="PRO 15:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21" />Snonkaku vefawi nanembaya imarisen ifrur roi eve faindava,</para>
  <para style="q2" vid="PRO 15:21">imbape snonkaku vefawinanem, kenem vyeja davyover.<verse eid="PRO 15:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22" />Aw snonkaku nari nefromo, fyor naser karkara asuser ro snonkaku veseva;</para>
  <para style="q2" vid="PRO 15:22">imboi nari navye napyum rofyor snonkaku sibor svuk swaruser.<verse eid="PRO 15:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23" />Snonkakuyo imarisen kaku snar kankarem vyukna nkaku,</para>
  <para style="q2" vid="PRO 15:23">wawos vyena vekyuk ro fafisu anna napyum fafayava.<verse eid="PRO 15:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24" />Snonkaku veswarnanem imbran ro neyan vesoyov kankenem fioro;</para>
  <para style="q2" vid="PRO 15:24">imboi imbran ro nyan veso murvav ve marmaryava.<verse eid="PRO 15:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25" />
    <char style="nd">Manseren Allah</char> nari Imkok rum snonkaku vemararessya,</para>
  <para style="q2" vid="PRO 15:25">imboi Fyadiren was saprop vin kabomya vyeja.<verse eid="PRO 15:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26" />Aw vevyevana <char style="nd">Manseren Allah </char> imarisen nava;</para>
  <para style="q2" vid="PRO 15:26">imboi wawos vepyumna nafrur marisen I.<verse eid="PRO 15:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27" />Snonkaku vesewar arasai vesyadadi kuker nyan vevyeva,</para>
  <para style="q2" vid="PRO 15:27">ifrur fa kina vyedi syampurnak.</para>
  <para style="q2" vid="PRO 15:27">Mansei vekurpum faferes fasasisna, nari ikenem kuker payamyum.<verse eid="PRO 15:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28" />Snonkaku rari venapes kyara user wawos vyena;</para>
  <para style="q2" vid="PRO 15:28">snonkaku vevarvor dawos wos vevyeva.<verse eid="PRO 15:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29" />
    <char style="nd">Manseren Allah</char> imnaf nadi ro snonkaku rari venapessya,</para>
  <para style="q2" vid="PRO 15:29">imbape Vyinkwan bur snonkaku rari vevarvorsya.<verse eid="PRO 15:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30" />Maka vemam mayar ifrur sne marisen snonkaku,</para>
  <para style="q2" vid="PRO 15:30">abar veyun marisen ifrur sneprei rurya.<verse eid="PRO 15:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31" />Snonkaku vemnaf pyum wos sansonek veyun faro kankenem</para>
  <para style="q2" vid="PRO 15:31">nari skor ive snonkaku vefirnanem.<verse eid="PRO 15:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32" />Snonkaku vemewer verower wos farkarkor, vye syowi mankundiva ;</para>
  <para style="q2" vid="PRO 15:32">snonkaku vemarisen vemnaf wos sansonek vepyum, nari ismai firnanem.<verse eid="PRO 15:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33" />Araryof faro <char style="nd">Manseren Allah</char> I irya farkarkor vedaw firnanem;</para>
  <para style="q2" vid="PRO 15:33">snonkaku verun mankundi nari isma som.<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1" />Snonkakusya skara monda aw ro sisnesna,</para>
  <para style="q2" vid="PRO 16:1">imbape <char style="nd">Manseren Allah</char> vevuk wos namukya.<verse eid="PRO 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />Frur vebor sena soverada napyum raris mamam sena,</para>
  <para style="q2" vid="PRO 16:2">imbape <char style="nd">Manseren Allah </char> I monda vemam sane snonkaku.<verse eid="PRO 16:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />Rwir monda faro <char style="nd">Manseren Allah</char> I aw vebor bena,</para>
  <para style="q2" vid="PRO 16:3">rarirya fararur bena nari namawes.<verse eid="PRO 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />Roi vebor <char style="nd">Manseren Allah </char> ifrurna fandun naisya ro na oser-oser;</para>
  <para style="q2" vid="PRO 16:4">ma fandun vekur snonkaku rari vevyevasya isoine sismai marindi.<verse eid="PRO 16:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />Snonkaku vemararessya <char style="nd">Manseren Allah</char> imarisen siva veri;</para>
  <para style="q2" vid="PRO 16:5">kakudam, Myam monda sivo sikfis bur marindiyava.<verse eid="PRO 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />Snonkaku eve syowi ma veso asuser faro <char style="nd">Manseren Allah</char> I nari ismai fakamaman;</para>
  <para style="q2" vid="PRO 16:6">ma snonkaku veyararyof faro I nari vyinkwan bur vavyevaya.<verse eid="PRO 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />Rofyor kenem bedi ifrur marisen <char style="nd">Manseren Allah</char> I,</para>
  <para style="q2" vid="PRO 16:7">irya nari mbrov besi Vyuk si fa nwa sive manivov.<verse eid="PRO 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />Arasai kermkun kosmai kuker nyan venapes,</para>
  <para style="q2" vid="PRO 16:8">ipyum syadi ro nana vebor kosmai kuker nyan ankarkar.<verse eid="PRO 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />Snonkaku sifrur aw ro mankunsi,</para>
  <para style="q2" vid="PRO 16:9">imbape <char style="nd">Manseren Allah</char> I vefaraser ras kenem sena.<verse eid="PRO 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10" />Wairek ismai papoik ro Allah I fa vyuki dawawos,</para>
  <para style="q2" vid="PRO 16:10">inja, wos ikofen na nsasarva rofyor dun wos namuk.<verse eid="PRO 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11" />
    <char style="nd">Manseren Allah</char> imarisen kaku insa snonkakusya sfarvavyan kuker napnapes, ma</para>
  <para style="q2" vid="PRO 16:11">wankyara sena kako wankyara venapes.<verse eid="PRO 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12" />Varvorna irya roi vefrur ayin faro mampapokya,</para>
  <para style="q2" vid="PRO 16:12">vavesasoser vyeja dores nako snar isya ro nyan kakakuya.<verse eid="PRO 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13" />Wosuser vekaku nafrur doryav Mampapok,</para>
  <para style="q2" vid="PRO 16:13">vyenavye faro snonkaku veyawos kuker napnapes.<verse eid="PRO 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14" />Masasor wairek vyena namnisra abar veyunbe marmar;</para>
  <para style="q2" vid="PRO 16:14">snonkaku veswarnanem nari siwos pamper snerifa ipnunek!<verse eid="PRO 16:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15" />Rari vepyum wairek vyena nadaw kenem vefo andei-marisen,</para>
  <para style="q2" vid="PRO 16:15">namananis rep vesabu mekem rofafisu dares.<verse eid="PRO 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16" />Mundiri vesmai firnanemya irya ipyum syadi ro ismai brawen;</para>
  <para style="q2" vid="PRO 16:16">ma ismai fawawi nanemya eve maija syadi ro ismai sarak.<verse eid="PRO 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17" />Snonkaku kenem venapes vyinkwan bur vavyevaya;</para>
  <para style="q2" vid="PRO 16:17">snonkaku vemam warek pyum mov ikenem raya irya fyaduru mankundi.<verse eid="PRO 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18" />Mararesya vyedar vave momprafya;</para>
  <para style="q2" vid="PRO 16:18">awawowya vyedar farsapiya.<verse eid="PRO 16:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19" />Korun mankunko fnovek snonkaku sne vekakiva,</para>
  <para style="q2" vid="PRO 16:19">ipyum syadi ro koso snonkaku vemararessya ma kosmai rarwas ro nana sfasyarna.<verse eid="PRO 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20" />Mamepen pyum kaku wos farkarkor wasmai kwar, rarirya nari wasmai roi vepyum.</para>
  <para style="q2" vid="PRO 16:20">Wakyar faro <char style="nd">Manseren Allah</char> I, rarirya nari wasmai aski.<verse eid="PRO 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21" />Snonkaku veswar nanemya kofawi i ro swaruser vesar vyena;</para>
  <para style="q2" vid="PRO 16:21">wawos vyena nposer snewar, wos vefrur snekin.<verse eid="PRO 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22" />Swaruser veknon imnis marei vevuk kankenem faro snonkaku vefawi nanem;</para>
  <para style="q2" vid="PRO 16:22">snonkaku vefawi nanemba sismai marindi kuker fawawiva sena.<verse eid="PRO 16:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23" />Snonkaku veswar nanem kyara vepon wawos vyena insape dawos na;</para>
  <para style="q2" vid="PRO 16:23">ma wos farkakor vyanna nafrur snekin.<verse eid="PRO 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24" />Wos mayaryer namananis umber;</para>
  <para style="q2" vid="PRO 16:24">nmarnden ro sane ma nafrur pararei baken.<verse eid="PRO 16:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25" />Snonkakusya skara sisya ro neyan veyavyover,</para>
  <para style="q2" vid="PRO 16:25">imbape varpurya nyan ani syo yov marmar.<note caller="+" style="x"><char style="xo" closed="false">16:25 </char><char style="xt" closed="false"><ref loc="PRO 14:12">WosAn. 14:12</ref></char></note><verse eid="PRO 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26" />Snewar vebiser idif snonkaku fa sifararur;</para>
  <para style="q2" vid="PRO 16:26">snar sasop vyedi, idifi fa ifararur.<verse eid="PRO 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27" />Snonkaku vevarvorya ifrowes min vyesi fa sifrur sasar;</para>
  <para style="q2" vid="PRO 16:27">wawos vyena namnis for vesber.<verse eid="PRO 16:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28" />Snonkaku rari vevyeva vyawes rakrok;</para>
  <para style="q2" vid="PRO 16:28">mundiri verakafkofen pyer rarwas bati vyesi.<verse eid="PRO 16:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29" />Snonkaku kenem vekarfiva daw ninyan manivov vyesi,</para>
  <para style="q2" vid="PRO 16:29">ma dun si ve nyan vevyeva.<verse eid="PRO 16:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30" />Swasor au ro snonkaku vemarafrif ma vefnak mkamor,</para>
  <para style="q2" vid="PRO 16:30">isya iwasen nyan varvor ro snerido.<verse eid="PRO 16:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31" />Snonkaku venapes nari ismai ras kenem vekwan kaku;</para>
  <para style="q2" vid="PRO 16:31">pik vepyoper vyena namnis wower vedoser.<verse eid="PRO 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32" />Snonkaku vemasasor fasawva isyadi ro snon mambri;</para>
  <para style="q2" vid="PRO 16:32">snonkaku veyepen mankundi isyadi ro snonkaku vemun diwer kotaya ma vemerkar mbrov vyesi.<verse eid="PRO 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33" />Snonkakusya simnasen ras varpon sena,</para>
  <para style="q2" vid="PRO 16:33">imbape kankarem vekaku ryama ro <char style="nd">Manseren Allah</char> I monda.<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1" />Mamami ker vepnasya kuker sne veknon,</para>
  <para style="q2" vid="PRO 17:1">ipyum syadi ro rovean ma manfnai vemafen vesararir kuker rakrok.<verse eid="PRO 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2" />Manfamyan vefawi nanem nari fyara epen amber vyedi romawa karyer vyedi vefrur mamyai;</para>
  <para style="q2" vid="PRO 17:2">ma manfamyan ani nari ismai kako var rarwas arasai warpu romawa ani naek vyesi.<verse eid="PRO 17:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3" />Brawen ma sarak sikunsi fa sijaren ro for insa sisren,</para>
  <para style="q2" vid="PRO 17:3">imbape <char style="nd">Manseren Allah</char> I myam fafewa rari vepyum ma vevyeva ro snonkakusya sisnesna.<verse eid="PRO 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4" />Snonkaku vevarvorya iso monda wawos vevyevana,</para>
  <para style="q2" vid="PRO 17:4">snonkaku vekofen rokakuva imarisen imnaf wos ankarkar.<verse eid="PRO 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5" />Mundiri vekoryaye snonkaku vesavarar,</para>
  <para style="q2" vid="PRO 17:5">irya donef Allah vefanir inya.</para>
  <para style="q1" vid="PRO 17:5">Mundiri veryav vemarisen ro bo snonkaku vesmai marindi,</para>
  <para style="q2" vid="PRO 17:5">nari ismai vave ninyan.<verse eid="PRO 17:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6" />Wower ro sinansya isoine romawa kpu sesi;</para>
  <para style="q2" vid="PRO 17:6">romawasya sararer up sesi.<verse eid="PRO 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7" />Snonkaku venawnower isyusva fa dawos wos vekaku;</para>
  <para style="q2" vid="PRO 17:7">isyadadi snonkaku vesmai syowi isyusva fa dawos wos ankarkar.<verse eid="PRO 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8" />Faferes fasasisya imnis keru brawen;</para>
  <para style="q2" vid="PRO 17:8">kuker faferes fasasis anna roi vebor nakam nari namawes.<verse eid="PRO 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9" />Insa snonkakusya sesyowi au ido</para>
  <para style="q2" vid="PRO 17:9">fakman sasar sifrurna.</para>
  <para style="q1" vid="PRO 17:9">Imbape mundiri vefawarker sasar snonkaku</para>
  <para style="q2" vid="PRO 17:9">irya kyaruk vave manivovya.<verse eid="PRO 17:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10" />Wos sansonek oser monda faro snonkaku veswar nanem vye fainda syadi</para>
  <para style="q2" vid="PRO 17:10">ro aprer usin oser faro snonkaku venawnower.<verse eid="PRO 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11" />Snonkaku rari vevyeva isampampum vebararaya vesyakwar,</para>
  <para style="q2" vid="PRO 17:11">imbape nari vebarara anya iwan snonkaku vesambrav kaku oso fa rya vyeninyan snonkaku ani kuker vaveninyan vemarvak kaku.<verse eid="PRO 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12" />Ipyum syadi kosrow aiwan verafdi vevrikaku snar mkun vyedi idawer,</para>
  <para style="q2" vid="PRO 17:12">isyadi ro kosrow snonkaku venawnower imboi vesombirek kuker fawi royova vyena.<verse eid="PRO 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13" />Mundiri vemunsu payamyumya kuker vavyeva,</para>
  <para style="q2" vid="PRO 17:13">irya vavyevaya nari syae bur rum vyejava.<verse eid="PRO 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14" />Mundiri eve randak rakrok irya vyas nyan faro marei vedaf;</para>
  <para style="q2" vid="PRO 17:14">rarirya wasusu rofyor rakrokya isya vaim.<verse eid="PRO 17:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15" />
    <char style="nd">Manseren Allah</char> vyembrov snonkaku vevuk kakaku faro snonkaku vevarvor,</para>
  <para style="q2" vid="PRO 17:15">ma kako vevuk sasar faro snonkaku venapes.<verse eid="PRO 17:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16" />Snonkaku venawnower syewar firnanem kuker kumpan vebor vyesya imboi nari vye fromo monda,</para>
  <para style="q2" vid="PRO 17:16">snar ismai swaruser vepyum nova.<verse eid="PRO 17:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17" />Bati vekaku iswar vesyakwar faro manivov vyedi,</para>
  <para style="q2" vid="PRO 17:17">ma vye naek fa isonem fafisu marindi.<verse eid="PRO 17:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18" />Snonkaku vefrur ap fa nari vevak pyan nyaki min vyedi</para>
  <para style="q2" vid="PRO 17:18">irya ifawi nanemba veri.<verse eid="PRO 17:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19" />Mundiri vemarisen vefrur mbris,</para>
  <para style="q2" vid="PRO 17:19">imarisen kako fanfavriya.</para>
  <para style="q1" vid="PRO 17:19">Mundiri vemarares,</para>
  <para style="q2" vid="PRO 17:19">syeref vave momprafya.<verse eid="PRO 17:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20" />Snonkaku veyankarkarya ismai payamyumova ,</para>
  <para style="q2" vid="PRO 17:20">snonkaku vepambarmbar wose nari ismai marindi.<verse eid="PRO 17:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21" />Mundiri vekapar romawa venawnower ismai fafardun;</para>
  <para style="q2" vid="PRO 17:21">sinan kma vena romawa vefawi nanemba, sane veryav isya ro iva.<verse eid="PRO 17:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22" />Sane vefo doryav irya aryawin vevuk pararei;</para>
  <para style="q2" vid="PRO 17:22">sane vefafardun vyedar dafduf.<verse eid="PRO 17:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23" />Mananwir vena swaruser vevyeva ismai faferes fasasis</para>
  <para style="q2" vid="PRO 17:23">insa imbran napnapesyava.<verse eid="PRO 17:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24" />Snonkaku vena swar nanem vyesewar monda fa ismai firnanem,</para>
  <para style="q2" vid="PRO 17:24">imbape snonkaku venawnower kyara famfnom monda.<verse eid="PRO 17:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25" />Romawa venawnower ifrur sneduf kmari,</para>
  <para style="q2" vid="PRO 17:25">ma ifrur sne fafardun snari.<verse eid="PRO 17:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26" />Snonkaku vesasarva</para>
  <para style="q2" vid="PRO 17:26">ipok vyavyak fromo;</para>
  <para style="q1" vid="PRO 17:26">rarirya kako snonkaku veswar nanem kopok kopreri.<verse eid="PRO 17:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27" />Snonkaku vena fawawi, dawos naborva.</para>
  <para style="q2" vid="PRO 17:27">Snonkaku swaruser veknon, rari vyedi iknon.<verse eid="PRO 17:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28" />Snonkaku vefawi nanembaya nari skara i ve snonkaku vefawi nanem fyor vye fasis</para>
  <para style="q2" vid="PRO 17:28">ma skara kako i ve snonkaku veswar nanem fyor depen svari.<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1" />Snonkaku vekenem ro mankundi</para>
  <para style="q1" vid="PRO 18:1">kyara monda fandun vyena;</para>
  <para style="q2" vid="PRO 18:1">swaruser vebor ro snonkaku vese vevuk swaruser isawen pum na.<verse eid="PRO 18:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2" />Snonkaku venawnowerya imewer ismai fawawi</para>
  <para style="q2" vid="PRO 18:2">imarisen dawos monda rosai kyarana.<verse eid="PRO 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3" />Kofrur sasar ido nari kosmai koryaye ro snokaku;</para>
  <para style="q2" vid="PRO 18:3">kofrur roi vefrur mamyai ido nari kosmai anonef.<verse eid="PRO 18:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4" />Wawos snonkaku imnis raris soren veramen,</para>
  <para style="q2" vid="PRO 18:4">imbape wos firnanemya imnis marei vedaf.<verse eid="PRO 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5" />Mankakaraya syasar rofyor iwaira snonkaku rari vevyeva,</para>
  <para style="q2" vid="PRO 18:5">ma vyuk samamyai faro snonkaku vesasarvaya.<verse eid="PRO 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6" />Snonkaku venawnower dawawos ido ifnai monda mbriwer,</para>
  <para style="q2" vid="PRO 18:6">awawos vyena newari snonkaku sya ave smuni,<verse eid="PRO 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7" />Wawos snonkaku venawnower nun vavyeva ve i;</para>
  <para style="q2" vid="PRO 18:7">roi ikofenna nfes mankundi.<verse eid="PRO 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8" />Fawar vekakuva nrok pyum kaku,</para>
  <para style="q2" vid="PRO 18:8">snonkakusya simarisen srowerna.<verse eid="PRO 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9" />Snonkaku eve rer fararur vyena,</para>
  <para style="q2" vid="PRO 18:9">kyarfiva imnis snonkaku vemarisen vekakok.<verse eid="PRO 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10" />
    <char style="nd">Manseren Allah</char> irya kaderen vekaki ma vedworem;</para>
  <para style="q2" vid="PRO 18:10">snonkaku venapessya sra mura ro diwa ma sismai mov veknon.<verse eid="PRO 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11" />Imbape snokaku venanasya skara vo sovo nana senaiso vekadaun si</para>
  <para style="q2" vid="PRO 18:11">imnis ayar keru vekaki veyar warek kota.<verse eid="PRO 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12" />Snonkaku vemararessya nari sisapi,</para>
  <para style="q2" vid="PRO 18:12">snonkaku sne vekakivasya nari sismai som.<verse eid="PRO 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13" />Wamnaf vaimbo kwarem vepon</para>
  <para style="q2" vid="PRO 18:13">irya wafawi royova ma nari waser anonef.<verse eid="PRO 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14" />Snonkaku kenem veryav, nari vyarsonem marindi venyanem i;</para>
  <para style="q2" vid="PRO 18:14">imbape kenem veryavya isyava ido, snekyar vebor vyenakam nadawer kako.<verse eid="PRO 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15" />Sane snonkaku veswar nanem ismai fawawiya,</para>
  <para style="q2" vid="PRO 18:15">ma kneram snonkaku swaruser veknon iryav ismai farkarkor.<verse eid="PRO 18:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16" />Faferesya vyuk mkei faro snonkaku</para>
  <para style="q2" vid="PRO 18:16">fa isrow kuker snonkaku veba eve nasan.<verse eid="PRO 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17" />Snonkaku veyawos rawer kaku ro raryur vave mankara, kyara vo dovo wawos vyenaiso vekakuna,</para>
  <para style="q2" vid="PRO 18:17">imbape wawos vyena nari nevekara user fafisu mbrov vyedi ryama.<verse eid="PRO 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18" />Kuker mnasen, fanfavriya imbrore,</para>
  <para style="q2" vid="PRO 18:18">kako mbrov fandu snokaku vena papoiksya nari nambror kaku.<verse eid="PRO 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19" />Naek kofrur fa sne fedufya syamswen kaku fa kofanam i isyadi ro kota vesambrav kaku;</para>
  <para style="q2" vid="PRO 18:19">fanfavriya imnis asyopder ro kerwa veba kota siyar warek kuker fofen kerui.<verse eid="PRO 18:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20" />Wawos vesasyar ro kosvasna</para>
  <para style="q2" vid="PRO 18:20">nari nawarye ve mankunko.<verse eid="PRO 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21" />Ramarya ismai papoik fa fyaspar kenem ine rova imkok i;</para>
  <para style="q2" vid="PRO 18:21">snonkakuyo irya nari ismai sasuref ro rosai dawoskwar.<verse eid="PRO 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22" />Mundiri vesmai vin kenem vepyum, irya ismai roi vepyum,</para>
  <para style="q2" vid="PRO 18:22">swa vyedi <char style="nd">Manseren Allah</char> vin Vyuk ve i ndirya.<verse eid="PRO 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23" />Snonkaku vesavarar fyararyor kuker sne vekakiva;</para>
  <para style="q2" vid="PRO 18:23">snonkaku venana kyarem kuker marares.<verse eid="PRO 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24" />Manivov vevyevasya sisya,</para>
  <para style="q2" vid="PRO 18:24">imboi manivov kona ve karyersya sisyadi ro naek kovesi.<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1" />Snonkaku vesavarar imboi kenem venapes,</para>
  <para style="q2" vid="PRO 19:1">ipyum syadi ro snonkaku veyankarkar ma venawnower.<verse eid="PRO 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2" />Mayaryarenya ifranser fawawiyava ido, ipyumba;</para>
  <para style="q2" vid="PRO 19:2">snonkaku vesawsaw nari ifrur sasar.<verse eid="PRO 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3" />Snonkaku simbran sasar snar sifawi rorova,</para>
  <para style="q2" vid="PRO 19:3">varpurya svuk sasar ve <char style="nd">Manseren Allah</char> I.<verse eid="PRO 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4" />Snonkaku venana, manivov vyesya sibor kaku;</para>
  <para style="q2" vid="PRO 19:4">snonkaku vesavarar manivov vyesya sibur i.<verse eid="PRO 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5" />Snonkaku veyawos kakuva ro varpon mankakara, nari ismai samamyai,</para>
  <para style="q2" vid="PRO 19:5">snonkaku veyawos ankarkar vesyakwar nari dande bur samamyaiva.<verse eid="PRO 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6" />Snonkaku sibor sve sewar fa sifrur marisen snonkaku eve nasan;</para>
  <para style="q2" vid="PRO 19:6">snonkaku sibor sve sewar fa se manivov snonkaku veyan navye.<verse eid="PRO 19:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7" />Snonkaku vesavarar naek vyesya smamkyof i,</para>
  <para style="q2" vid="PRO 19:7">naba syadi manivov vyesi.</para>
  <para style="q1" vid="PRO 19:7">Vyesewar fa dakawos si,</para>
  <para style="q2" vid="PRO 19:7">imbape sefanduniva.<verse eid="PRO 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8" />Mundiri vesewar fawawi nanemya, irya iswar mankundi;</para>
  <para style="q2" vid="PRO 19:8">ma mundiri vewasen epen rosai fyarkor kwar, nari ikenem kuker aski.<verse eid="PRO 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9" />Snonkaku veyawos kakuva ro varpon mankakara nari ikfis bur samamyaiyava,</para>
  <para style="q2" vid="PRO 19:9">snonkaku veyawos ankarkar vesyakwar nari imar.<verse eid="PRO 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10" />Snonkaku venawnower isyusva fa ikenem kuker kamayai,</para>
  <para style="q2" vid="PRO 19:10">ma kako mamfamyanya isyusva fa vyeparensa snoporya.<verse eid="PRO 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11" />Snonkaku veswar nanem imasasor fasawva.</para>
  <para style="q2" vid="PRO 19:11">Ismai ararer snar fyakman snonkaku vefrur sasar faro i.<verse eid="PRO 19:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12" />Masasor wairek ifrur makak imnis singa kuv babo vesnirem;</para>
  <para style="q2" vid="PRO 19:12">imboi frurpyum vyena namnis wawur vefamasi rokaker.<verse eid="PRO 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13" />Romawa venawnower vyedar sinan kmari vye mompraf.</para>
  <para style="q2" vid="PRO 19:13">Vin vefarvuk bekain rakrok imnis mekem vepaporem vemananaiva ro rum rido.<verse eid="PRO 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14" />Rum ma arasai nairya var rarwas kosmai ro sinan kovesi,</para>
  <para style="q2" vid="PRO 19:14">imboi swa veswarnanem irya vin<char style="nd">Manseren Allah</char> vyuk ma ve ko.<verse eid="PRO 19:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15" />Snonkaku vemananon imarisen denef vesyakwar,</para>
  <para style="q2" vid="PRO 19:15">varpur mura snonkaku anya nari ibiser.<verse eid="PRO 19:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16" />Snonkaku vesoyuser Allah sasoser Vyena, irya fyaduru kenem vyedi,</para>
  <para style="q2" vid="PRO 19:16">imboi snonkaku eve rer na nari imar.<verse eid="PRO 19:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17" />Mundiri vefnovek snonkaku vesavarar irya ifrur nyaki faro <char style="nd">Manseren Allah</char> I;</para>
  <para style="q2" vid="PRO 19:17">nari <char style="nd">Manseren Allah</char> myunsu na faro i.<verse eid="PRO 19:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18" />Waprer romawa bedi fafis ibava,</para>
  <para style="q2" vid="PRO 19:18">mbaido nari ras nawama kenem vyedi vye mompraf.<verse eid="PRO 19:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19" />Snonkaku vemasasor fasaw, nari ismai vavyevaya.</para>
  <para style="q2" vid="PRO 19:19">Rofyor wafnovek i rarwan oser, nari vye fandun wafnovek i vesyakwar.<verse eid="PRO 19:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20" />Rofyor wamarisen farkor ma wamnaf wos ananun,</para>
  <para style="q2" vid="PRO 19:20">irya varpurya nari wafo kuker firnanem.<verse eid="PRO 19:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21" />Snonkakusya skara aw nabor kaku ro sisnesna,</para>
  <para style="q2" vid="PRO 19:21">imbape <char style="nd">Manseren Allah</char> aw Vyena naiso nari Ifrurna.<verse eid="PRO 19:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22" />Rari vepyum nafnai-vedar fa snonkaku sibor simarisen.</para>
  <para style="q2" vid="PRO 19:22">Savararya ipyum syadi ro ankarkarya.<verse eid="PRO 19:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23" />Wararyof faro <char style="nd">Manseren Allah </char> I, nari wakenem kuker payamyum,</para>
  <para style="q2" vid="PRO 19:23">nari wasmai kananon ma wakfis bur marindi.<verse eid="PRO 19:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24" />Snonkaku vemananon bos kakuya;</para>
  <para style="q2" vid="PRO 19:24">isu rovean ro svari monda pyapum bos kaku.<verse eid="PRO 19:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25" />Snonkaku vemararesya sipreri inido, snonkaku vefawi karyonbaya ismai farkarkor.</para>
  <para style="q2" vid="PRO 19:25">Snonkaku veswar nanemya sisonek inido nari iswar nanem syadi wer.<verse eid="PRO 19:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26" />Romawa veprer ma veyau sinan vyesuya,</para>
  <para style="q2" vid="PRO 19:26">irya romawa vefrur mamyai ma rari vyedi ivyeva.<verse eid="PRO 19:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27" />Romawa yedi, rofyor wamewer wasmai farkarkor werdi,</para>
  <para style="q2" vid="PRO 19:27">nari befnder rosai farkor kwar an na.<verse eid="PRO 19:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28" />Snonkaku veyawos kakuva ro varpon mankakara, irya myamkyof sasoserya;</para>
  <para style="q2" vid="PRO 19:28">frur ninyan snonkaku, irya marasrisen faro snonkaku rari vevyeva.<verse eid="PRO 19:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29" />Samamyaiya fyasoskwar faro snonkaku vemarares,</para>
  <para style="q2" vid="PRO 19:29">snonkaku venawnower nari ismai parader.<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1" />War anggursya sifnai fa snonkakusya sifrur mbris.</para>
  <para style="q2" vid="PRO 20:1">Fawi nanembaya isya ro snonkaku veyinem ra vemsersi.<verse eid="PRO 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2" />Masasor wairekya imnis singa vesnirem;</para>
  <para style="q2" vid="PRO 20:2">snonkaku vefrurfa imsorya, irya vye ninyan mankundi.<verse eid="PRO 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />Snonkaku vefawi nanembasya siso vemarisen vefanfavri;</para>
  <para style="q2" vid="PRO 20:3">rari vesmai ararer isoine kovinkwan bur fanfavriya.<verse eid="PRO 20:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />Manamom vemananon kyer yaf vyenava ro fafisu skakerya;</para>
  <para style="q2" vid="PRO 20:4">inja fafisu aninekya yaf vyan na nbuk royo ve iva.<verse eid="PRO 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5" />Sane snonkaku imnis raris war veyer veramen;</para>
  <para style="q2" vid="PRO 20:5">imboi snonkaku veswarnanemya iso nari vefawi mnis kakara snonkaku anya vyena.<verse eid="PRO 20:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />Snonkaku sibor skarem mankunsi ve manivov,</para>
  <para style="q2" vid="PRO 20:6">imboi eve syowi ma vesmai kayaryar, syamswen kaku fa kosrowsi.<verse eid="PRO 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />Romawa inai sismai aski rofyor sna sinan kma</para>
  <para style="q2" vid="PRO 20:7">kenem vepyum ma venapesya.<verse eid="PRO 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />Rofyor wairekya kyain ro karapesa vave mankakaraya</para>
  <para style="q2" vid="PRO 20:8">roi vevyevana myam ma ifawi pres na.<verse eid="PRO 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />Snonkakuyo isyafa nari ikofen,</para>
  <para style="q2" vid="PRO 20:9">“Yafrur sren snerikwar, yave mkei bur sasarnakwar?”<verse eid="PRO 20:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />Wankyara ma kanau vekakuva</para>
  <para style="q2" vid="PRO 20:10">
    <char style="nd">Manseren Allah</char> imarisen nava.<verse eid="PRO 20:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />Ro romawasya sifrur na nfasnai vadir</para>
  <para style="q2" vid="PRO 20:11">rariso kenem sena napyum nanapes ke rova.<verse eid="PRO 20:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12" />Kneramsya insa kovuki ryower ma mkamorsya infa kovuki myame,</para>
  <para style="q2" vid="PRO 20:12">sukame <char style="nd">Manseren Allah</char> I vefrur sunya.<verse eid="PRO 20:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13" />Snonkaku vemarisen veyenef vesyakwar nari isapi ro savarar</para>
  <para style="q2" vid="PRO 20:13">snonkaku vemyaren vefararur ismai nanan nabor kaku.<verse eid="PRO 20:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14" />Manfarvyan vekoves ikofenker, ipyumba, dek mankenem.</para>
  <para style="q2" vid="PRO 20:14">Imbape fafisu ismai roi vyefandun anya kwar, dararer mankundi snar dek mankenemba.<verse eid="PRO 20:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15" />Wawos veveknam ro fawawiya,</para>
  <para style="q2" vid="PRO 20:15">Ne maeja syadi ro brawen ma kerui vesnaper.<verse eid="PRO 20:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16" />Mundiri veyap fa vevak pyan nyaki snonkaku vese,</para>
  <para style="q2" vid="PRO 20:16">ivye nana vyena ne veyun fa ne vekram isof vye user ap vyedi.<verse eid="PRO 20:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17" />Arasai kosmai kuker ankarkar randakya nanbye kaku,</para>
  <para style="q2" vid="PRO 20:17">imbape favye muma ido kan na namnis raris keru morem.<verse eid="PRO 20:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18" />Aw wafrurna nari namawes fafisu snonkaku vese svuk swaruser;</para>
  <para style="q2" vid="PRO 20:18">rarirya rwa mamun awer fyor aw bena namnis vaim.<verse eid="PRO 20:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19" />Snonkaku vemarisen vefawar min vyesi, sikram wos kankunesva;</para>
  <para style="q2" vid="PRO 20:19">mkokenem so awer snonkaku veyawos naborsya.<verse eid="PRO 20:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20" />Mundiri vefras sinan vyesi, kenem vyedi nari vye fromo</para>
  <para style="q2" vid="PRO 20:20">imnis padamara vembrer ro rov fafis remaryai.<verse eid="PRO 20:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21" />Arasai var rarwas wasmai fasaw ro randakya kuker nyan vepyan,</para>
  <para style="q2" vid="PRO 20:21">favye muma vok naisyava.<verse eid="PRO 20:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22" />Mkomunsu awer vavyevaya kuker vavyeva;</para>
  <para style="q2" vid="PRO 20:22">mkokyar monda faro <char style="nd">Manseren Allah</char>, iso nari vesaramper au.<verse eid="PRO 20:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23" />Wankyara ma kanau vekakuva</para>
  <para style="q2" vid="PRO 20:23">
    <char style="nd">Manseren Allah</char> imarisen nava.<verse eid="PRO 20:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24" />
    <char style="nd">Manseren Allah</char> vye asas kwar nyan kankenem snokaku ro supswan ine;</para>
  <para style="q2" vid="PRO 20:24">evewari snonkakusya sifawi mnis nyan kenem mankunsi senava.<verse eid="PRO 20:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25" />Kwara vepon resari rofyor wafrur ap fa buk farsarser faro <char style="nd">Manseren Allah</char> I.</para>
  <para style="q2" vid="PRO 20:25">Mbaido nari fafko ro varpurya.<verse eid="PRO 20:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26" />Wairek vena firnanemya ifawi snonkaku mundiri rari vevyevasya;</para>
  <para style="q2" vid="PRO 20:26">nari fyakman siva mboi vye ninyansi.<verse eid="PRO 20:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27" />Rur snonkaku irya sananai ro <char style="nd">Manseren Allah</char></para>
  <para style="q2" vid="PRO 20:27">vesnaiser snewarya kasiper.<verse eid="PRO 20:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28" />Rofyor wairek vye parensa kuker vave syowi, vave asuser ma kakaku ido,</para>
  <para style="q2" vid="PRO 20:28">irya nari ikif pdef vavesasoserya.<verse eid="PRO 20:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29" />Romawa baboya smander i snar samamvrav vyena,</para>
  <para style="q2" vid="PRO 20:29">ma sinan eve mansarkwarya ismai syowi snar pik vepyoper vyena.<verse eid="PRO 20:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30" />Aprer vemarvak fyor no ido ipyos roi vevyevana</para>
  <para style="q2" vid="PRO 20:30">ma parader vera diryanya vyan sren snewar snonkaku.<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1" />
    <char style="nd">Manseren Allah</char> fyarkin wairekya swaruser vyena</para>
  <para style="q2" vid="PRO 21:1">imnis fyaraser warya fa idaf raris marisen vyedi.<verse eid="PRO 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2" />Frur snonkakusya sena soverada napyum raris mamam sena,</para>
  <para style="q2" vid="PRO 21:2">mbape <char style="nd">Manseren Allah</char> I monda vekara user rosai siwasen ro sisnesna.<verse eid="PRO 21:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3" />
    <char style="nd">Manseren Allah</char> imarisen kaku faro rari venapes ma veyavyover</para>
  <para style="q2" vid="PRO 21:3">isyadiro aiwan farsarserna.<verse eid="PRO 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4" />Maka veyawow ma sane vemarares,</para>
  <para style="q2" vid="PRO 21:4">eve padamara faro snonkaku evarvorsya, irya sasar nairi.<verse eid="PRO 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5" />Aw snonkaku vemyaren vefararur idaw kamayai;</para>
  <para style="q2" vid="PRO 21:5">fararur sawsawya idaw ananjar.<verse eid="PRO 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6" />Nana wasmai kuker ramar veyankarkar</para>
  <para style="q2" vid="PRO 21:6">nari ne fromo fasaw ma nun snonkaku ve marmar.<verse eid="PRO 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7" />Snonkaku evarvor simewer siso sasoseryandi;</para>
  <para style="q2" vid="PRO 21:7">frur vevyeva sena neninyan mankunsi.<verse eid="PRO 21:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8" />Snonkaku vevarvorya, nyan kankenem vyedi ifo yuvyav;</para>
  <para style="q2" vid="PRO 21:8">snonkaku vepyumya ikenem kuker napnapes.<verse eid="PRO 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9" />Barek vardi ro mankundau ro aren</para>
  <para style="q2" vid="PRO 21:9">ipyum syadiro barek us vin buk, vekain rakrok vesyakwar.<verse eid="PRO 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10" />Snonkaku evarvor imarisen kaku ifrur nyan varvor;</para>
  <para style="q2" vid="PRO 21:10">faro manseiryawer vye syowi siva.<verse eid="PRO 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11" />Snonkaku vemararesya siprer inido insape snonkaku vefawi karyonbaya ismai farkarkor.</para>
  <para style="q2" vid="PRO 21:11">Snonkaku veswar nanemya sisonek inido, nari fyirnanem syadi wer.<verse eid="PRO 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12" />Allah Ima Inapes, Ifawi rosai vero rumrido snonkaku vevarvorsya.</para>
  <para style="q2" vid="PRO 21:12">Nari Vye ninyan si fa sismai marindi.<verse eid="PRO 21:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13" />Mansei vemewer vemnaf vavesoso snonkaku veyananjar</para>
  <para style="q2" vid="PRO 21:13">nari ikako vye vemam farander ro fafis dor famfnovek.<verse eid="PRO 21:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14" />Faferes fasasisna nafrur fa msorna nambrusen,</para>
  <para style="q2" vid="PRO 21:14">ma faferes fasasisna npandun dormomenna.<verse eid="PRO 21:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15" />Napnapesya simbran inido,</para>
  <para style="q2" vid="PRO 21:15">snonkaku vepyumsya simarisen,</para>
  <para style="q2" vid="PRO 21:15">mbape snonkaku vevarvorsya simkake.<verse eid="PRO 21:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16" />Snonkaku vevoyarbur nyan kenem venapesya,</para>
  <para style="q2" vid="PRO 21:16">nari ifyafer ro mun aivuiya.<verse eid="PRO 21:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17" />Snonkaku vesewar monda anfnak marisen nari isapi ro ananjar;</para>
  <para style="q2" vid="PRO 21:17">snonkaku vemarisen monda an ma aninem vemafen nari syavarar.<verse eid="PRO 21:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18" />Snonkaku vevarvor nari ismai marindi ro roi iwasen fa ifrur yov snonkaku venapesya,</para>
  <para style="q2" vid="PRO 21:18">ma snonkaku vevarvor ismai ninyan fadwer snonkaku venapesya.<verse eid="PRO 21:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19" />Wakenem ro mankundau ro maper veve ursva,</para>
  <para style="q2" vid="PRO 21:19">ipyum syadi ro wakenem so vinbuk svadon eve prepre ma vekain rakrok.<verse eid="PRO 21:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20" />Snonkaku befirnanem ikenem pyum kuker kamayai ma nana vyena;</para>
  <para style="q2" vid="PRO 21:20">snonkaku venawnower arasai vyena navro fasau bur i.<verse eid="PRO 21:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21" />Mundiri veyom kakakuya ma saswarya,</para>
  <para style="q2" vid="PRO 21:21">nari ikenem pyum, ismai som ma kenem vyedi ikwane.<verse eid="PRO 21:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22" />Snon mambri veswar nanemya ismai papoik fa fyasyar kota snon mamun vesambrav sya siwaren warekya;</para>
  <para style="q2" vid="PRO 21:22">ma imer karvaken ayar mamun sikyarna.<verse eid="PRO 21:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23" />Insa wande bur kenem vesamswenya,</para>
  <para style="q2" vid="PRO 21:23">ivyekada swasor au ro wawos bena.<verse eid="PRO 21:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24" />Snonkaku vemarares ma veyow mankunsya</para>
  <para style="q2" vid="PRO 21:24">simarisen sawos yaye ma sikenem karfiva.<verse eid="PRO 21:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25" />Snonkaku vemananon; myun mankundi kuker marasrisen vyena.</para>
  <para style="q2" vid="PRO 21:25">snar imyaren ifararurva.<verse eid="PRO 21:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26" />Ras mankwanya kyain kyara monda rosai vye fandun na.</para>
  <para style="q2" vid="PRO 21:26">Imboi, snonkaku rari vepyum vyuk ra nabor nasararir faro snonkaku vese.<verse eid="PRO 21:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27" />Aiwan farsarser snonkaku rari vevyevasya sena <char style="nd">Manseren Allah</char> imarisen nava,</para>
  <para style="q2" vid="PRO 21:27">isyadadi sfarser na kuker sne venapesva.<verse eid="PRO 21:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28" />Snonkaku veyawos kakuva ro varpon mankakara wawos vyena nari sikyarnava;</para>
  <para style="q2" vid="PRO 21:28">imbape snonkaku veyawos kakaku ro varpon mankakara, rosai ikofenna snonkakusya sikyarna.<verse eid="PRO 21:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29" />Snonkaku vevarvor ifawi imaiva;</para>
  <para style="q2" vid="PRO 21:29">snonkaku venapes fyaraser mankundi.<verse eid="PRO 21:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30" />Fawinanem, swarnanem ma firnanem snonkaku</para>
  <para style="q2" vid="PRO 21:30">osovaveri fa dores nako ro varpon <char style="nd">Manseren Allah</char> I.<verse eid="PRO 21:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31" />Farmamunya sraki kuker romamun ma kuda vesambrav kaku,</para>
  <para style="q2" vid="PRO 21:31">imbape <char style="nd">Manseren Allah</char> iso nari vemerkar mbrov syani.<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1" />Snonsnon vepyum vye maeja syadi ro arasai vebor;</para>
  <para style="q2" vid="PRO 22:1">snonkaku se syowi au ipyum syadi ro svuk brawen ma sarak.<verse eid="PRO 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2" />Snonkaku venana ma vesavarar sikam simniskam:</para>
  <para style="q2" vid="PRO 22:2">
    <char style="nd">Manseren Allah</char> vraur vye siryakam.<verse eid="PRO 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3" />Snonkaku swaruser veswar nanem nari ikanden fafisu myam roi vevyeva nari venyanemi na;</para>
  <para style="q2" vid="PRO 22:3">snonkaku vefawi karyonba nari imbran pdef rao ismai marindi.<verse eid="PRO 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4" />Snonkaku veyararyof faro <char style="nd">Manseren Allah</char> ma verun mankundi,</para>
  <para style="q2" vid="PRO 22:4">nari ismai kenem vepyum, inanjarva, ma ismai syowi.<verse eid="PRO 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5" />Barwei ma denem naisya ro nyan snonkaku kenem bekarfiva;</para>
  <para style="q2" vid="PRO 22:5">wove insama wavyeido vinkwanbur na.<verse eid="PRO 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6" />Romawaya farkori kuker rari kenem vepyum,</para>
  <para style="q2" vid="PRO 22:6">rarirya isof vye mansaro nari ikenem pdef ra dirya.<verse eid="PRO 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7" />Snonkaku vesavarar sve women faro snonkaku benanasya;</para>
  <para style="q2" vid="PRO 22:7">snonkaku vena nyaki sve women faro snonkaku vevuk nyaki.<verse eid="PRO 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8" />Snonkaku vevuver varvorido nari dinek bon marindi;</para>
  <para style="q2" vid="PRO 22:8">ro papupesya papoik vyuk ifrur famfnom nakam nari namyomen.<verse eid="PRO 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9" />Snonkaku vefrurpyum sya <char style="nd">Manseren Allah</char> vye vok si,</para>
  <para style="q2" vid="PRO 22:9">snar sirarwas anan sena faro snonkaku veyananjarsya.<verse eid="PRO 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10" />Snonkaku veyawos ker wos anonefsya wayau si ra sibur,</para>
  <para style="q2" vid="PRO 22:10">insamaido famfavri, mbrov ma wos anonef nari naisya werva.<verse eid="PRO 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11" />Snonkaku sne venapes ma veyawos pyum</para>
  <para style="q2" vid="PRO 22:11">nari vye manivov wairek i.<verse eid="PRO 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12" />
    <char style="nd">Manseren Allah</char> fyaduru snonkaku vena fawawi vekaku,</para>
  <para style="q2" vid="PRO 22:12">mboi syampurnak aw snonkaku veyankarkar sena.<verse eid="PRO 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13" />Snonkaku vemananonya iryav monda vyarek ro rum;</para>
  <para style="q2" vid="PRO 22:13">inja ikofen, “Singaya isriwa, nari myun aya ro nyandifadu.”<verse eid="PRO 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14" />Wos embakvuk vin vevov vinkunya imnis raris denem;</para>
  <para style="q2" vid="PRO 22:14">snonkaku <char style="nd">Manseren Allah</char> imsor sya nari sisapi ro dori.<verse eid="PRO 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15" />Romawa babosya sifawi nanemba,</para>
  <para style="q2" vid="PRO 22:15">imbape aprer-farkarkorya iso nari vefarwe rari kenem sena.<verse eid="PRO 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16" />Mundiri eve sewar fa venana ma ifrirepen snonkaku vesavarar,</para>
  <para style="q2" vid="PRO 22:16">orovaido vevuk faferes faro snonkaku venana varpurya nari syavarar.<verse eid="PRO 22:16" /></para>
  <para style="s1">Wos ananun samfur di kior ro snon vefirnanem</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17" />Wamnaf navye wos farkakor snonkaku vefirnanem.</para>
  <para style="q2" vid="PRO 22:17">Mamepen pyum kaku farkarkor ayena.<verse eid="PRO 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18" />Raryav isya ro au fafis wakram pyum farkarkor ayena ro snembri do.</para>
  <para style="q2" vid="PRO 22:18">Rarirya fasos kwar fa buki nakenem.<verse eid="PRO 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19" />Yafarkorna ve au ro fafis ine</para>
  <para style="q2" vid="PRO 22:19">Insa rwir kakyar bena faro <char style="nd">Manseren Allah </char>I.<verse eid="PRO 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20" />Wos farkarkor samfur di kyor yafasna ve au kwar</para>
  <para style="q2" vid="PRO 22:20">wos farkarkor anna nadaw fawawi ma ananun vepyum,<verse eid="PRO 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21" />ma nfarkor au rosai bepyum ma vekaku</para>
  <para style="q2" vid="PRO 22:21">insa buk kankarem vekaku faro snonkaku vewan au fa farkorya.<verse eid="PRO 22:21" /></para>
  <para style="s2">--1--</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22" />Fasrisen awer snonkaku vesavararya, snar iryarva;</para>
  <para style="q2" vid="PRO 22:22">ma wafrirepen awer snonkaku veyawauya vena snonkakuyova fa vye sano warek i.<verse eid="PRO 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23" />Snar, <char style="nd">Manseren Allah</char> nari Ivriwarek i</para>
  <para style="q2" vid="PRO 22:23">ma pyosuk kenem snonkaku vefrir epen ani.<verse eid="PRO 22:23" /></para>
  <para style="s2">--2--</para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24" />Be manivov awer kuker snonkaku vemasasor,</para>
  <para style="q2" vid="PRO 22:24">ma rik vesam,<verse eid="PRO 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25" />insa wamnis awer i</para>
  <para style="q2" vid="PRO 22:25">wafrur ra dirya ido, imnisra wafrur denem fa isin au.<verse eid="PRO 22:25" /></para>
  <para style="s2">--3--</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26" />Wafrur awer ap fa</para>
  <para style="q2" vid="PRO 22:26">bak pyan nyaki snonkaku vese sena.<verse eid="PRO 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27" />Nari bak napoknava ido,</para>
  <para style="q2" vid="PRO 22:27">kamboi anenef beja kako vye vefasyar.<verse eid="PRO 22:27" /></para>
  <para style="s2">--4--</para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28" />Wamiser awer yawek vekwar ro saprop</para>
  <para style="q2" vid="PRO 22:28">up siwara srir kwar.<verse eid="PRO 22:28" /></para>
  <para style="s2">--5--</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29" />Mam snonkaku vra vesanyanemya fararur vyenakwar?</para>
  <para style="q2" vid="PRO 22:29">Snonkaku evesya anya nari duf farmyan snonkaku famfnom sya rum senava, mboi ro aidoran waireksya.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="s2">--6--</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1" />Fafisu kwain wanan so snonkaku vebarara oso ido,</para>
  <para style="q2" vid="PRO 23:1">mamepen pyum roivebor vero varpon bedi.<verse eid="PRO 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2" />Wanambri rarisowero,</para>
  <para style="q2" vid="PRO 23:2">rwun fandun bena.<verse eid="PRO 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3" />Snembri isararan awer anan vemafen fyasos na,</para>
  <para style="q2" vid="PRO 23:3">imbude ive vye na fa nafrowes au ndi.<verse eid="PRO 23:3" /></para>
  <para style="s2">--7--</para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4" />Wamor vekandera awer fa nwa nana.</para>
  <para style="q2" vid="PRO 23:4">Wambrer kakara banine.<verse eid="PRO 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5" />Snar, kumpan besya nari korpeser monda vo sipromes,</para>
  <para style="q2" vid="PRO 23:5">kumpan besya ryari prer sya sisur ro si, inja siswor ve nank iwaryas imnis mankankan.<verse eid="PRO 23:5" /></para>
  <para style="s2">--8--</para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6" />Wanan so awer snonkaku veyanfarmbramsya.</para>
  <para style="q2" vid="PRO 23:6">Snembri isararan awer rovean vemafen vyena.<verse eid="PRO 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7" />Snar snonkaku evesya ani kyor epen fasis na ro sneri do.</para>
  <para style="q2" vid="PRO 23:7">Ikofen ve au, “indo wan ma winem wer,” imboi sneri kyarfiva yov au.<verse eid="PRO 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8" />Rosai wan kwar anna nari bai kaver na,</para>
  <para style="q2" vid="PRO 23:8">ma wos vemarnden bena faro i ne faindava.<verse eid="PRO 23:8" /></para>
  <para style="s2">--9--</para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9" />Wakofen farkor awer snonkaku venawnowerya;</para>
  <para style="q2" vid="PRO 23:9">snar nari kyorwef wos vepyum bena.<verse eid="PRO 23:9" /></para>
  <para style="s2">--10--</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10" />Wamiser awer was vekwar ro saprop,</para>
  <para style="q2" vid="PRO 23:10">ma fasyar awer saprop mnuk awak param sena.<verse eid="PRO 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11" />Snar <char style="nd">Manseren Allah</char> irya mambewarek vepoik syadi,</para>
  <para style="q2" vid="PRO 23:11">iso nari eve sano warek si.<verse eid="PRO 23:11" /></para>
  <para style="s2">--11--</para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12" />Mamepen pyum kaku wos farkarkor na,</para>
  <para style="q2" vid="PRO 23:12">ma wamnaf pyum farkarkor veyun fawawi.<verse eid="PRO 23:12" /></para>
  <para style="s2">-- 12--</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13" />Kwambru awer fa farkor romawa bedi.</para>
  <para style="q2" vid="PRO 23:13">Nari imarva fafisu mun i kuker aprer.<verse eid="PRO 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14" />Kakudam, muni kuker aprer,</para>
  <para style="q2" vid="PRO 23:14">irya faspar rur vyedi bur mun aivuiya.<verse eid="PRO 23:14" /></para>
  <para style="s2">--13--</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15" />Romawa yedi au, firnanemya isya ro au ido</para>
  <para style="q2" vid="PRO 23:15">sneri iryav kaku.<verse eid="PRO 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16" />Yaryav kaku</para>
  <para style="q2" vid="PRO 23:16">fafisu yamnaf wawos wos venapes.<verse eid="PRO 23:16" /></para>
  <para style="s2">--14--</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17" />Snembri fyawe awer faro snonkaku vesasarsya.</para>
  <para style="q2" vid="PRO 23:17">Wararyof monda faro <char style="nd">Manseren Allah</char> I<verse eid="PRO 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18" />insa ras varpon bedi imawes,</para>
  <para style="q2" vid="PRO 23:18">ma kayaryar bena nadawer monda awer.<verse eid="PRO 23:18" /></para>
  <para style="s2">--15--</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19" />Wamnaf ve aya, romawa yedi! Ivyekada wafo kuker firnanem.</para>
  <para style="q2" vid="PRO 23:19">Waknon ser au ma waso pyum kaku rari kenem venapesya.<verse eid="PRO 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20" />Wakenem so awer snonkaku vemasarser</para>
  <para style="q2" vid="PRO 23:20">ma venambri sya.<verse eid="PRO 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21" />Snar nari sisapi ro sovararya.</para>
  <para style="q2" vid="PRO 23:21">Wenef ra dirya kwar ido, fyorova ido nari wafmar sansun eve kinak.<verse eid="PRO 23:21" /></para>
  <para style="s2">--16--</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22" />Wasoyuser sinan kmami, i evewar au sya ni.</para>
  <para style="q2" vid="PRO 23:22">Rofyor sinan snami vye vinsar kwar, fasnai syowi bena faro i.<verse eid="PRO 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23" />Ananun vekaku, firnanem, farkarkor,</para>
  <para style="q2" vid="PRO 23:23">ma swarnanem nakame fandunfa ne vekoves, imbape ivye ne vevov awer.<verse eid="PRO 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24" />Sinan kma oso iryav snar romawa vyedi ikenem kuker napnapes;</para>
  <para style="q2" vid="PRO 23:24">romawa vesmai firnanem ifrur doryav kmari.<verse eid="PRO 23:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25" />Ivye kada wafrur doryav sinan besuya;</para>
  <para style="q2" vid="PRO 23:25">ivye kada vin vekapar aunya ifo kuker aski marisen.<verse eid="PRO 23:25" /></para>
  <para style="s2">--17--</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26" />Romawa yedi! Mam epen pyum kaku wawos ayena</para>
  <para style="q2" vid="PRO 23:26">ma wakenem raris mov yakenem raya.<verse eid="PRO 23:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27" />Vin vevyeva vevov vinkundi</para>
  <para style="q2" vid="PRO 23:27">irya denem veyun ve marindi.<verse eid="PRO 23:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28" />Dores waf imnis manfasyar</para>
  <para style="q2" vid="PRO 23:28">ma ifrur fa snon sya sibor sefnder vin svuk si.<verse eid="PRO 23:28" /></para>
  <para style="s2">--18--</para>
  <para style="q1">
    <verse number="29-30" style="v" sid="PRO 23:29-30" />Wafawike roi vekur snonkaku veyinem war anggur sibor kaku,</para>
  <para style="q2" vid="PRO 23:29-30">ma verepen ker swan vepakrek?</para>
  <para style="q1" vid="PRO 23:29-30">Snonkaku anya ismai samswen ma marindi.</para>
  <para style="q2" vid="PRO 23:29-30">Kyain rakrok ma fyafko vesyakwar.</para>
  <para style="q1" vid="PRO 23:29-30">Mkassu sufanandik ma baken vyedi vye parpar,</para>
  <para style="q2" vid="PRO 23:29-30">imboi roi nane kyara pyum riryakada nari dande bur na.<verse eid="PRO 23:29-30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31" />Mam mura ve war anggursya nawer,</para>
  <para style="q2" vid="PRO 23:31">sisnai pyum kaku ma sposer sne ro syobis,</para>
  <para style="q2" vid="PRO 23:31">seveyinem kuker andeidi.<verse eid="PRO 23:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32" />Arwori fyas ido ryari ikako isos au,</para>
  <para style="q2" vid="PRO 23:32">ifrur fa wasyur.<verse eid="PRO 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33" />Mkamsi pyawe, swaruser bena narvaren</para>
  <para style="q2" vid="PRO 23:33">ma wawos sadadworek.<verse eid="PRO 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34" />Ryari ausya ri pum padaren kapal ro sorenya faduri;</para>
  <para style="q2" vid="PRO 23:34">vrumbri vye diwawai ma wambran farsapi.<verse eid="PRO 23:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35" />Mura ido nari wakofen, “Rya ono siprer ma svaser aya,</para>
  <para style="q2" vid="PRO 23:35">imboi yaswar kaver roi evesya annava.</para>
  <para style="q1" vid="PRO 23:35">Ae, mkasi myarvak kaku!</para>
  <para style="q2" vid="PRO 23:35">Yave fandun yinem anggur no wer!”<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="s2">--19--</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1" />Snembri fyawe awer faro snonkaku vevarvor,</para>
  <para style="q2" vid="PRO 24:1">ma be manivov awer kuker si.<verse eid="PRO 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2" />Skara fa sifrir epen snonkaku vese</para>
  <para style="q2" vid="PRO 24:2">ma sawos monda roi vefnai marindi.<verse eid="PRO 24:2" /></para>
  <para style="s2">--20--</para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3" />Kinaya vye vevawes kuker firnanem ma fawawi</para>
  <para style="q2" vid="PRO 24:3">irya nari syambrav.<verse eid="PRO 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4" />Kuker fawawiya, sim vyena siserna</para>
  <para style="q2" vid="PRO 24:4">kuker arasai vekakur ma eve maeja.<verse eid="PRO 24:4" /></para>
  <para style="s2">--21--</para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5" />Snonkaku vesmai firnanemya papoik vyedi isyadi snonkaku vesambravya;</para>
  <para style="q2" vid="PRO 24:5">fawawiya isyadi ro samamvravi.<verse eid="PRO 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6" />Farmamunya imbran baim iser kakara vemawes kaku resari,</para>
  <para style="q2" vid="PRO 24:6">ma snonkaku vevuk swarusersya sibor ido, nari mbrovsya simufer.<verse eid="PRO 24:6" /></para>
  <para style="s2">--22--</para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7" />Snonkaku vefawi rorova, firnanemya syamswen kaku faro i.</para>
  <para style="q2" vid="PRO 24:7">Vye fasis monda fafisu eve vukorsya siryur fa sawos roi eve fandun.<verse eid="PRO 24:7" /></para>
  <para style="s2">--23--</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8" />Snonkaku vekara ker aw roi vevyeva</para>
  <para style="q2" vid="PRO 24:8">nari sap i ve snonkaku vefrur mbriwer.<verse eid="PRO 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9" />Aw snonkaku vefawi nanemba vefrowes snonkaku fa sisapi irya sasar nairi,</para>
  <para style="q2" vid="PRO 24:9">Snonkaku vefanfayaiker snonkaku vese, oserovaveri fa imariseni.<verse eid="PRO 24:9" /></para>
  <para style="s2">--24--</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10" />Swaruser bena namar ro fafisu marindi ido,</para>
  <para style="q2" vid="PRO 24:10">nfasna vadir auma snonkaku vesambrav mankunba risau.<verse eid="PRO 24:10" /></para>
  <para style="s2">--25--</para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11" />Kwor wanan awer fa per snonkaku vesasarva sun fa sive smun;</para>
  <para style="q2" vid="PRO 24:11">faspar snonkaku sismer fa sun be mov sive smun ra imar.<verse eid="PRO 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12" />Fyor wakofen vo wove, “Ayama yakna fanduno kukriva.”</para>
  <para style="q2" vid="PRO 24:12">Imbape Allah myam epen au. Ifawi ma Kyara user swaruser bena. Myunsu faro snonkaku raris frur sena.<verse eid="PRO 24:12" /></para>
  <para style="s2">--26--</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13" />Romawa yedi, wan umber no, snar sipyum kaku.</para>
  <para style="q2" vid="PRO 24:13">Snar umber vero naremsya san marnden kaku.<verse eid="PRO 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14" />Rarirya firnanemya ipyum faro rur bedi.</para>
  <para style="q2" vid="PRO 24:14">Fyor wasmai i kwar ido, ras varpon bedi iyarpyum.<verse eid="PRO 24:14" /></para>
  <para style="s2">--27--</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15" />Wamnis awer snokaku rari vevyeva veyaw fa</para>
  <para style="q2" vid="PRO 24:15">vefasyar snonkaku kenem venapesya rum vyedi;<verse eid="PRO 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16" />snar, snonkaku kenem venapesya isapi rarwan ri fumo wero, nari ikvawes kaver wer,</para>
  <para style="q2" vid="PRO 24:16">imboi snonkaku rari vevyevaya nari kyarvaken ma vye mompraf kaku.<verse eid="PRO 24:16" /></para>
  <para style="s2">--28--</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17" />Waryav awer rofyor mbrov bedi ismai marindi,</para>
  <para style="q2" vid="PRO 24:17">ma wamarisen awer rofyor isapi;<verse eid="PRO 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18" />snar, <char style="nd">Manseren Allah</char> nari myam frur banine ma kyara au ve snonkaku vevyeva,</para>
  <para style="q2" vid="PRO 24:18">muraido nari Imsor mbrov banya werva.<verse eid="PRO 24:18" /></para>
  <para style="s2">--29--</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19" />Wamsor awer faro snonkaku vefrur vavyevaya.</para>
  <para style="q2" vid="PRO 24:19">Snembri fyawe awer faro snonkaku rari vekarfivasya;<verse eid="PRO 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20" />snar snonkaku rari vekarfivasya ras varpon isya ve siva,</para>
  <para style="q2" vid="PRO 24:20">imnis ra padamara vembrer.<verse eid="PRO 24:20" /></para>
  <para style="s2">--30--</para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21" />Romawa yedi, wararyof monda faro <char style="nd">Manseren Allah</char> I, ma swom faro wairekya,</para>
  <para style="q2" vid="PRO 24:21">Waso awer snonkaku eve mbrov si,<verse eid="PRO 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22" />snar marindi Allah i orovaido wairek vyuk faro i imsinba,</para>
  <para style="q2" vid="PRO 24:22">ma snonkaku evesya anya korpeser monda nari vye mompraf.<verse eid="PRO 24:22" /></para>
  <para style="s1">Wos ananun evesena</para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 24:23" />Snonkaku vefirnanem sikofen radine:</para>
  <para style="q2" vid="PRO 24:23">Mankakaraya ipok myarvak ra var oser awer.<verse eid="PRO 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24" />Rofyor vyuk sasar ve snonkaku vevarvoryava,</para>
  <para style="q2" vid="PRO 24:24">nari snonkakusya sifrasi ma sawos ninyani.<verse eid="PRO 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25" />Imboi mankakara vevuk sasar faro snonkaku vesasar ido</para>
  <para style="q2" vid="PRO 24:25">nari ismai aski ma sve syowi i.<verse eid="PRO 24:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26" />Mundiri vevuk kankarem kuker wos venapes</para>
  <para style="q2" vid="PRO 24:26">irya manivov vevye.<verse eid="PRO 24:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27" />Fasos yaf bena vaim ma wasmai fararur vaim ido,</para>
  <para style="q2" vid="PRO 24:27">farvuk awer ari.<verse eid="PRO 24:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28" />Wawos kakuva awer faro min bedi kuker wawos veveknamba;</para>
  <para style="q2" vid="PRO 24:28">wawos awer wos ankarkar vekur i.<verse eid="PRO 24:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29" />Wakofen awer radine, “Raris ifrur yov aya, rarirya kako yakfrur yov i.</para>
  <para style="q2" vid="PRO 24:29">Yamunsu faro snonkakuyo raris frur vyena ve aya.”<verse eid="PRO 24:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30" />Ras oso yambranuk ro snonkaku vemyarenbaya yaf vyedi</para>
  <para style="q2" vid="PRO 24:30">ma snonkaku vefawi nanembaya yaf anggur vyedi.<verse eid="PRO 24:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31" />Ro yamam rodiyanya isoine asr borek ma ampyampumber</para>
  <para style="q2" vid="PRO 24:31">ma ayar vyena nkarvaken.<verse eid="PRO 24:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32" />Yamam ma yakara user na ra posa ido</para>
  <para style="q2" vid="PRO 24:32">yasmai farkarkorya ra dine:<verse eid="PRO 24:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33" />Yakain yaper vramin fa yamnaisu, ma yakofen,</para>
  <para style="q2" vid="PRO 24:33">“Ae, yavarek fasaw resari, ave yenef.”<note caller="+" style="x"><char style="xo" closed="false">24:33-34 </char><char style="xt" closed="false"><ref loc="PRO 6:10-11">WosAn. 6:10-11</ref> </char></note><verse eid="PRO 24:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34" />Rarirya fafisu yenef kakerya, ananjarya ma savararya ifyafer aya,</para>
  <para style="q2" vid="PRO 24:34">imnis snonkaku verama vefasyar aya kuker romamun.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s1">Wos ananun evesena ro Salomo</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />Ine ido wos ananun evese ro Salomo. Hiskia wairek Yehuda manfasfas vyesya siryur na.<verse eid="PRO 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2" />Allah ismai sanandik snar frur Vyena nafo kuker kankunes;</para>
  <para style="q2" vid="PRO 25:2">wairekya ismai som snar dawos isnai roi vekankunes na fa nfababa.<verse eid="PRO 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3" />Imnis soren veramen ma nank vekaki,</para>
  <para style="q2" vid="PRO 25:3">rarirya swaruser wairek vyena kokara papumna.<verse eid="PRO 25:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4" />Mamas vero sarak ne vefrur sren resari,</para>
  <para style="q2" vid="PRO 25:4">insa isnai pyum fa kamasanya vye kamara i.<verse eid="PRO 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5" />Mkokurpum ro vandi manwawos vevyevasya ro varpon wairekya,</para>
  <para style="q2" vid="PRO 25:5">rarirya vave sasoser vyedi nari kyaku ma idworem.<verse eid="PRO 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6" />Rofyor ausya ro varpon wairekya ivye kada rwun mankundaw,</para>
  <para style="q2" vid="PRO 25:6">wafrur awer ve snonkaku vesmai nasan veba.<note caller="+" style="x"><char style="xo" closed="false">25:6-7 </char><char style="xt" closed="false"><ref loc="LUK 14:8-10">Luk. 14:8-10</ref></char></note><verse eid="PRO 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7" />Ivye syadi wasmai syowi ma siwan fa wek ra kwain ro mov vekaki</para>
  <para style="q2" vid="PRO 25:7">ipyum syadi ro siwan fa buk mov kwainroya faro snonkaku eve nasan syadi.<verse eid="PRO 25:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 25:8" />Wun sawsaw awer wos fanfavri bena ve mankakaraya;</para>
  <para style="q2" vid="PRO 25:8">snar rofyor kyara userna ma varpurya au vesasarya nido</para>
  <para style="q2" vid="PRO 25:8">rosai nari wafrur werya?<verse eid="PRO 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9" />Wos vekfis fandu au kuker min bedi, muyawos userna fa navro fandu mu,</para>
  <para style="q2" vid="PRO 25:9">mboi roi snonkaku vese sekunsna ivye bas awerna.<verse eid="PRO 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10" />Snar nari sap au ve snonkaku swadon vewos pusmar</para>
  <para style="q2" vid="PRO 25:10">ma snonsnon bedi ivyeva ro ras kenem bedi kasiper.<verse eid="PRO 25:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11" />Swaruser sawos ro fafisu vepyum</para>
  <para style="q2" vid="PRO 25:11">imnis aibon brawen vekakur srir ro rosaser sarak.<verse eid="PRO 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12" />Wos sansonek ro snonkaku rari vepyum faro snonkaku vemarisen vemnaf,</para>
  <para style="q2" vid="PRO 25:12">namnis sarak brampin brawen rovaido afyamankor venyaser.<verse eid="PRO 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13" />Manwawan veve asuser, ifrur fa vewaninya imarisen,</para>
  <para style="q2" vid="PRO 25:13">imnis war vepnunek faro snonkaku veyaninek ro yafe.<verse eid="PRO 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14" />Eren sap kwar voi sifrurva,</para>
  <para style="q2" vid="PRO 25:14">imnis mandif ma wam vesabu mekemba.<verse eid="PRO 25:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15" />Kavavavya vyuk snekin faro snoporya.</para>
  <para style="q2" vid="PRO 25:15">wos vemyaren pyankar sne vepakrek.<verse eid="PRO 25:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16" />Wasmai umbersya nido wan mankenem awer;</para>
  <para style="q2" vid="PRO 25:16">imbude warbor mankenem ido, nari vayoremsi.<verse eid="PRO 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17" />Bedakam saswek awer min bedi,</para>
  <para style="q2" vid="PRO 25:17">nari fyafayaf ma imarisen auva.<verse eid="PRO 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18" />Wos vewarki</para>
  <para style="q2" vid="PRO 25:18">imnis rorabi, kamkam rova ikoi vesar.<verse eid="PRO 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19" />Kayaryar faro snonkaku veyawos ankarkar ro fafisu awaw ananjar</para>
  <para style="q2" vid="PRO 25:19">imnis nakor veyow rova wemin veradadai.<verse eid="PRO 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20" />Dow sidisen faro snonkaku eve varop</para>
  <para style="q2" vid="PRO 25:20">imnis sansun vyena ne veper ro fafis supya ipnunek</para>
  <para style="q2" vid="PRO 25:20">ryari sisar karwof ro par vyedi.<verse eid="PRO 25:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21" />Mbrov bedi ibiser ido fan i;</para>
  <para style="q2" vid="PRO 25:21">imbrow ido buk war fa dinem.<note caller="+" style="x"><char style="xo" closed="false">25:21-22 </char><char style="xt" closed="false"><ref loc="ROM 12:20">Rm. 12:20</ref></char></note><verse eid="PRO 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22" />Rarirya wafrur fa imai</para>
  <para style="q2" vid="PRO 25:22">ma <char style="nd">Manseren Allah</char> nari Vye vok au.<verse eid="PRO 25:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23" />Wambrurya nari dun mekem;</para>
  <para style="q2" vid="PRO 25:23">rarirya kako wos fawar pampyam nafnai masasor.<verse eid="PRO 25:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24" />Barek ro snur aren ipyum syadi</para>
  <para style="q2" vid="PRO 25:24">ro wakenem ro rum oser so swa vemarisen vekain rakrok.<verse eid="PRO 25:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25" />Wamnaf abar vepyum veraker sup vevinkwan</para>
  <para style="q2" vid="PRO 25:25">imnis winem war vepnunek ro fafisu wambrowe.<verse eid="PRO 25:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26" />Snonkaku kenem venapes vekunem faro snonkaku kenem vevyeva</para>
  <para style="q2" vid="PRO 25:26">imnis war sun vefmei rova war veyer vekakusem.<verse eid="PRO 25:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27" />Wan umber sibor mankenem dun payamyum faro baken bejava,</para>
  <para style="q2" vid="PRO 25:27">rarirya swewar ararer nabor mankenem ido navyeva kako.<verse eid="PRO 25:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28" />Snonkaku vefaraser mankundiva</para>
  <para style="q2" vid="PRO 25:28">imnis kota ayar keru vemkok.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1" />Raris duv-duv ro fafisu dares, ma mekem ro fafisu aninek,</para>
  <para style="q2" vid="PRO 26:1">rarirya kako snonkaku venawnowerya isyusva fa ismai som.<verse eid="PRO 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2" />Raris manesu ma mandorofya veswor farma ro farsyos,</para>
  <para style="q2" vid="PRO 26:2">rarirya kako snonkaku vesasarvaya, fras veve knamba myun iva.<figure style="fig" file="HK00070C.TIF" size="col" ref="26:2">Manesu</figure> <figure style="fig" file="HK00083C.TIF" size="col" ref="26:2">Mandorofya</figure><verse eid="PRO 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3" />Keledaiya, ivye fes kavrai vefaraser i, kudaya waprer indiso,</para>
  <para style="q2" vid="PRO 26:3">rarirya kako snonkaku venawnowerya ivye vyeveprer.<figure style="fig" file="HK00029C.TIF" size="col" ref="26:3">Kavrai vefaraser keledai</figure><verse eid="PRO 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4" />Kwarem awer ve snonkaku venawnowerya raris fawi nanemba vyena</para>
  <para style="q2" vid="PRO 26:4">insa mankundaw wamnis awer i.<verse eid="PRO 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5" />Kwarem be snonkaku venawnowerya raris fawi nanemba vyena,</para>
  <para style="q2" vid="PRO 26:5">insa kyara awer mankundi ve snonkaku vefirnanem.<verse eid="PRO 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6" />Mundiri vewan snonkaku venawnowerya fa dun ankinem,</para>
  <para style="q2" vid="PRO 26:6">imnis pyankar wemin mankundi vyedi ma syeref marindi.<verse eid="PRO 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7" />Raris snonkaku veyapaperya nari imbranva,</para>
  <para style="q2" vid="PRO 26:7">rarirya kako snonkaku venawnower vevuk wos ananun.<verse eid="PRO 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8" />Wasom snonkaku venawnowerya,</para>
  <para style="q2" vid="PRO 26:8">imnis ikoi vefes epen ra veko kaku ro wansnei maryai.<verse eid="PRO 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9" />Raris snonkaku vemasarser isasyar borek ro vrasi,</para>
  <para style="q2" vid="PRO 26:9">rarirya kako snonkaku venawnower vevuk wos ananun.<verse eid="PRO 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10" />Mansei vevuk fararur faro snonkaku venawnower rovaido snonkaku famfnom</para>
  <para style="q2" vid="PRO 26:10">nari ifrur fromo snonkaku sibor.<verse eid="PRO 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11" />Raris makei beyan vayorem vyena.</para>
  <para style="q2" vid="PRO 26:11">rarirya snonkaku venawnowerya ifrur pdef fawi nanemba vyena.<note caller="+" style="x"><char style="xo" closed="false">26:11 </char><char style="xt" closed="false"><ref loc="2PE 2:22">2Ptr. 2:22</ref></char></note><verse eid="PRO 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12" />Snonkaku venawnower ipyum syadi</para>
  <para style="q2" vid="PRO 26:12">ro snonkaku vekara mankundi ve vefawi nanem.<verse eid="PRO 26:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13" />Snonkaku vemyarenba imarisen kyain ro rum;</para>
  <para style="q2" vid="PRO 26:13">ikofen “Singa snomanya isya, nari myun aya ro nyandi fadu.”<verse eid="PRO 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14" />Imnis kedwai veseven ma veken,</para>
  <para style="q2" vid="PRO 26:14">rarirya snonkaku vemyarenba pyamambar baken byeja ro kamboy vyeja bori.<verse eid="PRO 26:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15" />Snonkaku vemyarenba bos kakuya;</para>
  <para style="q2" vid="PRO 26:15">isu rovean ro swadon vyeja monda pyapum bos kaku.<verse eid="PRO 26:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16" />Snonkaku vemyarenba kyaravir ro mankundi ismai firnanem syadi</para>
  <para style="q2" vid="PRO 26:16">ro snonkaku ri fik vevuk kankarem vekaku.<verse eid="PRO 26:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17" />Snonkaku veso fanfavri snonkaku vese</para>
  <para style="q2" vid="PRO 26:17">imnis snonkaku vefor makei verafdi ro kneram vyedi.<verse eid="PRO 26:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18" />Snonkaku veyawos ankar, ramnai vekofen, “Ayama yawos farfnak monda,”<verse eid="PRO 26:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19" />imnis snonkaku vesawo vefnak kuker romamun vefrur marmar.<verse eid="PRO 26:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20" />Ai vekaven navro ido, forya imbrer;</para>
  <para style="q2" vid="PRO 26:20">mboi svadon veve prepre isyava kwar ido, fanfavriya kako imnai.<verse eid="PRO 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21" />Imnis fondes ma ai vekaven forya fa isak pdef,</para>
  <para style="q2" vid="PRO 26:21">rarirya snokaku vemarisen vekain rakrok ison for vefnai mbris.<verse eid="PRO 26:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22" />Fawar vekakuva nrok pyum kaku;</para>
  <para style="q2" vid="PRO 26:22">snonkaku simarisen srowerna.<verse eid="PRO 26:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23" />Imnis kvir saprop sisvu kuker sarak,</para>
  <para style="q2" vid="PRO 26:23">rarirya kako snonkaku svadon vemarnden, imbape snewar vevyeva.<verse eid="PRO 26:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24" />Snonkaku eve mbrov au, ifrowes au kuker wos vemarnden</para>
  <para style="q2" vid="PRO 26:24">imbape snewar vyedi ifo ankarkar.<verse eid="PRO 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25" />Dawos pyum yov au wero wakyar aweri</para>
  <para style="q2" vid="PRO 26:25">snar sneri ifo kuker swaruser vevyeva.<verse eid="PRO 26:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26" />Iyofek vave embrov vyenano,</para>
  <para style="q2" vid="PRO 26:26">snonkakusya kam nari smam rari vevyeva vyena.<verse eid="PRO 26:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27" />Mansei vevai der faro snonkaku vese,</para>
  <para style="q2" vid="PRO 26:27">nari mankundi syomnof ro dori.</para>
  <para style="q1" vid="PRO 26:27">Mansei vekris karui insama ikris epen snonkaku vese,</para>
  <para style="q2" vid="PRO 26:27">nari karui anya ikris epen mankundi.<verse eid="PRO 26:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28" />Wankar snonkaku imnis be mrov i.</para>
  <para style="q2" vid="PRO 26:28">Svadon vemarnden dun marindi.<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1" />Warer awer mankundaw snar ras meser iyamyase,</para>
  <para style="q2" vid="PRO 27:1">snar wafawi mnis rosai nari vekur au ro ras anyava.<note caller="+" style="x"><char style="xo" closed="false">27:1 </char><char style="xt" closed="false"><ref loc="JAS 4:13-16">Yak. 4:13-16</ref></char></note><verse eid="PRO 27:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2" />Ivye snonkaku vesesi veyararer au,</para>
  <para style="q2" vid="PRO 27:2">isyadadi kaku snonkaku wafawivasya.<verse eid="PRO 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3" />Karuiya myarvak ma karyenya kako myarvak,</para>
  <para style="q2" vid="PRO 27:3">imboi sneduf snonkaku vefawi rorovaya ifrurya myarvak syadi.<verse eid="PRO 27:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4" />Masasorya ivyeva kaku ma vyedar vave momprafya,</para>
  <para style="q2" vid="PRO 27:4">mamfadadirya ivyeva syadi.<verse eid="PRO 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5" />Wos sansonek fababa</para>
  <para style="q2" vid="PRO 27:5">ipyum syadi ro syowi eve fasasis.<verse eid="PRO 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6" />Manivovya iprer kuker saswar,</para>
  <para style="q2" vid="PRO 27:6">imbape mbrovya dawrepen kuker swaruser vevyeva.<verse eid="PRO 27:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7" />Snonkaku veyarborya, umber syano fyamnersi;</para>
  <para style="q2" vid="PRO 27:7">mboi ibiser ido, roi vesarmar na nanpyum.<verse eid="PRO 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8" />Snonkaku vebur rum byeja,</para>
  <para style="q2" vid="PRO 27:8">imnis man vebur narem byedi.<verse eid="PRO 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9" />Raris mani vespum ma vediref pyum nafrur marisen snewar,</para>
  <para style="q2" vid="PRO 27:9">rarirya kako manivovya frur pyum vyena nafrur sneprei.<verse eid="PRO 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10" />Befnder awer manivov bedi rova manivov kmam vyedi.</para>
  <para style="q2" vid="PRO 27:10">Fafisu ausya ro ananjar wor awer fanfnovek ro naek bedi;</para>
  <para style="q1" vid="PRO 27:10">snonkaku vekenem fanam au sve fandun syadi</para>
  <para style="q2" vid="PRO 27:10">ro naek vevinkwanya.<verse eid="PRO 27:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11" />Romawa yedi, ivye kada firnanemya isya ro au, wafrur fa sneri iryav</para>
  <para style="q2" vid="PRO 27:11">insa yavuk kankarem faro snonkaku veyawos ninyan ayansya.<verse eid="PRO 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12" />Snonkaku veswar nanem ikandenbur rofyor myam roi nari veyun marmar;</para>
  <para style="q2" vid="PRO 27:12">snonkaku vefawi nanemba imbran pdef rao ismai vavyevaya.<verse eid="PRO 27:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13" />Mundiri vekara fa vevak pyan nyaki snonkaku vese,</para>
  <para style="q2" vid="PRO 27:13">ivye nana vyena neveyun fa ne vekram isof vyak ap vyedi.<verse eid="PRO 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14" />Mundiri vekofen arwo vevye faro manivov vyedi kuker mkarem veba fafis arwo prim kaku,</para>
  <para style="q2" vid="PRO 27:14">skara ive snonkaku veyor fras.<verse eid="PRO 27:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15" />Vin vekain rakrok</para>
  <para style="q2" vid="PRO 27:15">imnis war vepaporem ro rum rido vemananaiva ro fafisu imyun.<verse eid="PRO 27:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16" />Ivor kyain fasis rari,</para>
  <para style="q2" vid="PRO 27:16">imnis wam kodwarek napokva</para>
  <para style="q2" vid="PRO 27:16">ma mani koserepen ro vrabamba.<verse eid="PRO 27:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17" />Imnis mankarmomenya iyas mankarmomen,</para>
  <para style="q2" vid="PRO 27:17">rarirya kako snonkakusya sfarkor ro min sesi.<verse eid="PRO 27:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18" />Mansei vefaduru ai knam, nari dan bon vyena.</para>
  <para style="q2" vid="PRO 27:18">Manfamyan vewaren pyum amber vyedi nari ismai syowi.<figure style="fig" file="LB00085C.TIF" size="col" ref="27:18">Aiknam vevebon</figure><verse eid="PRO 27:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19" />Imnis varpon bedi syonin ro war veknon,</para>
  <para style="q2" vid="PRO 27:19">rarirya kako snembri fyasnai vadir mankundau.<verse eid="PRO 27:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20" />Raris mun aivuiya doren snonkaku vemarsyano isyopenba;</para>
  <para style="q2" vid="PRO 27:20">rarirya kako fandun snonkaku napok namananaiva.<verse eid="PRO 27:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21" />Brawen ma sarak sikunsi ro for fa sijaren insa sisren;</para>
  <para style="q2" vid="PRO 27:21">snonkakuyo smambir i ro rari vyedi fyor ismai ararer.<verse eid="PRO 27:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22" />Snonkaku vefawi nanembaya siprer marvak kaku i,</para>
  <para style="q2" vid="PRO 27:22">imbape fawawiva vyeja ipok imyomenba.<verse eid="PRO 27:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23" />Mambavir pyum kaku kambing domba besya,</para>
  <para style="q2" vid="PRO 27:23">faduru pyum rofanfan besi.<verse eid="PRO 27:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24" />snar kayan na nari nkain fyorova.</para>
  <para style="q2" vid="PRO 27:24">Rarirya kako wower snoporya nari kyain fyoro-fyorova.<verse eid="PRO 27:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25" />Avris ro maper ma vero urek se vekaruk ma siryursi faro rofanfan besi,</para>
  <para style="q2" vid="PRO 27:25">mbape fafisu anya kako avris babo sisur wer.<verse eid="PRO 27:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26" />Wasmai sansun ro domba bansya bur sesya,</para>
  <para style="q2" vid="PRO 27:26">ma kumpan wasmai ro kambing bov ansya buki skoves saprop vebabo.<verse eid="PRO 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27" />Ro kambing bansya vedawersya wasmai sus dur faro mankundau ma kina bedi,</para>
  <para style="q2" vid="PRO 27:27">kako faro mamfamyan infamyan besi.<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1" />Snonkaku rari vevyevaya ifrar, imboi osofa iyomiva ,</para>
  <para style="q2" vid="PRO 28:1">imbape snonkaku venapes, syambrav imnis singa kuv babo.<verse eid="PRO 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2" />Fyor er vebaya sembrov yayesi rarirya mampapoksya nari sfadadwer vesyakwar;</para>
  <para style="q2" vid="PRO 28:2">mboi mampapokya fyirnanem ido, er anya nari kyain nako ma syambrav.<verse eid="PRO 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3" />Mampapok vefrirepen snonkaku vesavarar,</para>
  <para style="q2" vid="PRO 28:3">imnis mekem beba vefrur fa rokaker napokem.<verse eid="PRO 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4" />Mansei eve rer sasoserya, iwaira snonkaku rari vevyevasya;</para>
  <para style="q2" vid="PRO 28:4">mansei vekifepen sasoserya vye mbrov snonkaku vekarfivasya.<verse eid="PRO 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5" />Snonkaku vevarvor ifawi mnis kenem veyavyoveryava,</para>
  <para style="q2" vid="PRO 28:5">imbape snonkaku veyararyof faro <char style="nd">Manseren Allah </char> I ifawi pres roi vebor nakam.<verse eid="PRO 28:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6" />Snonkaku vesavarar vape sne venapes</para>
  <para style="q2" vid="PRO 28:6">ipyum syadi ro snonkaku venana mboi veyankarkar.<verse eid="PRO 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7" />Romawa babo vesopyum sasoserya irya romawa vefirnanem.</para>
  <para style="q2" vid="PRO 28:7">mboi romawa eve manivov kuker snonkaku venambri ifrur mamyai kmari.<verse eid="PRO 28:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8" />Mundiri veryur nana kuker nyan ankarkar ma vyesewar fa ismai nabor kaku,</para>
  <para style="q2" vid="PRO 28:8">nana anna nari nasapi faro snonkaku vefrur pyum faro snonkaku vesavarar sya.<verse eid="PRO 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9" />Wasoyuser Allah sasoser vyenava ido,</para>
  <para style="q2" vid="PRO 28:9">Allah i kako nari dayin nadi bena.<verse eid="PRO 28:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10" />Mundiri vefrowes snonkaku kenem venapesya fa imbran ve nyan vevyeva,</para>
  <para style="q2" vid="PRO 28:10">nari isapi ro der mankundi vyai.</para>
  <para style="q1" vid="PRO 28:10">Imbape snonkaku sne vesren</para>
  <para style="q2" vid="PRO 28:10">nari ismai marasrisen.<verse eid="PRO 28:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11" />Snonkaku venana kyara mankundi ve vefirnanem,</para>
  <para style="q2" vid="PRO 28:11">imbape snonkaku vesavarar imboi vefirnanem ifawi snonkaku venana ani rari vyedi.<verse eid="PRO 28:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12" />Rofyor snonkaku kenem vepyumya vye manfarkin, kawasasya kam simarisen,</para>
  <para style="q2" vid="PRO 28:12">imboi snonkaku rari vevyevaya vye parensa, kawasa vyesi siyofek.<verse eid="PRO 28:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13" />Mansei veyofek sasar vyena nari kenem vyedi vye fromo.</para>
  <para style="q2" vid="PRO 28:13">Mansei vevaryas sasar vyena ma ikandenburna, nari <char style="nd">Manseren Allah</char> iswari.<verse eid="PRO 28:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14" />Wararyof faro <char style="nd">Manseren Allah</char> I besyakwar, rarirya nari wasmai aski.</para>
  <para style="q2" vid="PRO 28:14">Mboi wasoyuser Iva ido, nari wasmai marindi.<verse eid="PRO 28:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15" />Snonkaku rari vevyevaya vye manfarkin faro snonkaku vesamvravva,</para>
  <para style="q2" vid="PRO 28:15">imnis raris aiwan verafdi vesnirem ma vevri.<note caller="+" style="f"><char style="fr" closed="false">28:15 </char><char style="ft" closed="false">aiwan verafdi ro do TB ma BIMK isoine singa ma beruang </char></note><verse eid="PRO 28:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16" />Manfarkin vena swaruser vemnisva nari fasyar nana snonkaku vese,</para>
  <para style="q2" vid="PRO 28:16">imbape snonkaku vemewer vesewar nana kuker ankarkar ikada nari ras kenem vyedi ikwan.<verse eid="PRO 28:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17" />Snonkaku vemamun nari kyara vo dovo siyom keri ra isof ras marmar vyedi;</para>
  <para style="q2" vid="PRO 28:17">snonkaku oserova fa idwarek.<verse eid="PRO 28:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18" />Snonkaku vekenem kuker kakaku nari ismai aski.</para>
  <para style="q2" vid="PRO 28:18">Snonkaku kenem veyavyoverva nari isapi.<verse eid="PRO 28:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19" />Manamom vefararur marvak nari ismai rovean nabor kaku;</para>
  <para style="q2" vid="PRO 28:19">snonkaku vemyaren vefarurva nari dananjar.<verse eid="PRO 28:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20" />Snonkaku kenem venapes ismai vok ro <char style="nd">Manseren Allah</char> I,</para>
  <para style="q2" vid="PRO 28:20">mboi snonkaku vesawon kaku fa vesmai fasau arasai, nari dandebur vave ninyanva.<verse eid="PRO 28:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21" />Mankakara vemarvak ra var oserya ipyumba;</para>
  <para style="q2" vid="PRO 28:21">imboi mankakara vefararur pyumvaya isya kako,</para>
  <para style="q2" vid="PRO 28:21">vyesewar monda fa ismai kumpan.<verse eid="PRO 28:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22" />Snonkaku veyanfarmbram vye sewar fa ismai arasai fasau;</para>
  <para style="q2" vid="PRO 28:22">ifawiva savararya inyanemi.<verse eid="PRO 28:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23" />Snonkaku vevuk wos farkarkor ismai syowi syadi</para>
  <para style="q2" vid="PRO 28:23">ro snonkaku vevuk ker sanandik.<verse eid="PRO 28:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24" />Mansei vekarau ro sinan vyesya mboi kyara sasar risyava,</para>
  <para style="q2" vid="PRO 28:24">imnis kuker mankaraurau vese sya.<verse eid="PRO 28:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25" />Swarmankunya vyedar rakrok;</para>
  <para style="q2" vid="PRO 28:25">imboi mansei vekyar faro <char style="nd">Manseren Allah</char> ismai kamayai nabor kaku.<verse eid="PRO 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26" />Mansei vekyar mankundi swaruser vyena, irya snonkaku venawnower.</para>
  <para style="q2" vid="PRO 28:26">Mansei veso farkarkor snonkaku swaruser veknon nari ismai kankenem vepyum.<verse eid="PRO 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27" />Mansei vevuk faro snonkaku vesavarar nari ipok fa dananjarva.</para>
  <para style="q2" vid="PRO 28:27">Mansei vemam karis faro fandun snonkaku vesavarar, nari ismai farasras.<verse eid="PRO 28:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28" />Rofyor snonkaku rari vevyeva vye manfarkin,</para>
  <para style="q2" vid="PRO 28:28">kawasa fyarkinsya siyofek;</para>
  <para style="q1" vid="PRO 28:28">mboi fafisu snonkaku vevyeva anya isabu ro nasan vyedi,</para>
  <para style="q2" vid="PRO 28:28">snonkaku benapessya nari sfanfon ra sibor kaku ma se manfarkin.<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1" />Snonkaku vemewer vemnaf wos farkarkor,</para>
  <para style="q2" vid="PRO 29:1">nari fafisu oso vye mompraf ma vye vefadurupyum werva.<verse eid="PRO 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2" />Rofyor snonkaku kenem venapesya vye parensa, kawasasya simarisen.</para>
  <para style="q2" vid="PRO 29:2">Mboi fyor snonkaku rari vevyevaya vye parensa, kawasasya sismai marindi.<verse eid="PRO 29:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3" />Mansei vemarisen firnanemya, ifrur marisen kmari.</para>
  <para style="q2" vid="PRO 29:3">Mansei vekenemso vin vevov vinkun ifnak monda kumpan vyesi.<verse eid="PRO 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4" />Wairekya vye parensa kuker rari veyavyover ido, supmnuk vye parensaya nari kyain nako,</para>
  <para style="q2" vid="PRO 29:4">imboi sneri ryo kumpan ido nari supmnuk vye parensaya kyakok ra ivesisye.<verse eid="PRO 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5" />Snonkaku veyararer min vyeja,</para>
  <para style="q2" vid="PRO 29:5">ryir denem faro mankundi.<verse eid="PRO 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6" />Snonkaku rari vevyeva sasar vyena nfesepeni,</para>
  <para style="q2" vid="PRO 29:6">snonkaku kenem venapes ismai marisen ma aski.<verse eid="PRO 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7" />Snonkaku rari venapes ifawimnis kaku snonkaku vesambravvasya fandun sena</para>
  <para style="q2" vid="PRO 29:7">imboi snonkaku rari vevyeva ifawi mnisnava.<verse eid="PRO 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8" />Snonkaku vemarisen vefarkor ninyan ifrur virvar kota,</para>
  <para style="q2" vid="PRO 29:8">imboi snonkaku vefirnanem ifrur fa kawasasya siknon.<verse eid="PRO 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9" />Snonkaku swaruser veknon ma snonkaku vefawi nanembaya sufamfavri,</para>
  <para style="q2" vid="PRO 29:9">snonkaku vefawinanembaya dawos napnap ma imbrif isof ifnai mbrise<verse eid="PRO 29:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10" />Snonkaku vemamun vye mbrov snonkaku kenem venapesya,</para>
  <para style="q2" vid="PRO 29:10">imbape snonkaku kenem venapesya ismai fadadiren ro snonkaku vepyumya.<verse eid="PRO 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11" />Snonkaku venawnowerya fyasnai dormomen vyena ro varpon,</para>
  <para style="q2" vid="PRO 29:11">snonkaku vefirnanem vye avaven ma fyaraser i.<verse eid="PRO 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12" />Rofyor manfarkinya imarisen imnaf abar vekakuva,</para>
  <para style="q2" vid="PRO 29:12">faker vyesyakam nari rari sena navyeva.<verse eid="PRO 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13" />Snonkaku eve nyaki ma snonkaku vevuk nyaki sumnis kame;</para>
  <para style="q2" vid="PRO 29:13">faro sukame <char style="nd">Manseren Allah</char> vyuk fa sumam sonai kankenemya.<verse eid="PRO 29:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14" />Wairek eve sano warek snonkaku veryarva,</para>
  <para style="q2" vid="PRO 29:14">nari vye parensa pasivarek nabor kaku.<verse eid="PRO 29:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15" />Aprer ma wos sansonek nafrur fa snonkakusya kenem sena naknon.</para>
  <para style="q2" vid="PRO 29:15">Romawa sve manwinmya nari ifrur mamyai snari.<verse eid="PRO 29:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16" />Snonkaku kenem vevyevaya vye manfarkin ido, varvorna nari nabor kaku.</para>
  <para style="q2" vid="PRO 29:16">Imbape snonkaku rari vepyum nari myam vave mompraf snonkaku kenem vevyevasya.<verse eid="PRO 29:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17" />Farkor romawa bedi, rarirya ido nari vyuk kananon faro au,</para>
  <para style="q2" vid="PRO 29:17">ma vyuk sneprei ve au.<verse eid="PRO 29:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18" />Er veba vesmai farkankin ro <char style="nd">Manseren Allah</char> iva vye er veba vefo kuker sampurnak.</para>
  <para style="q2" vid="PRO 29:18">Aski isya faro snonkaku vesoyuser <char style="nd">Manseren Allah</char> sasoser Vyena.<verse eid="PRO 29:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19" />Manfamyanya vyevefarkor kuker wos mondava.</para>
  <para style="q2" vid="PRO 29:19">Imnaf pyumna, vape nari vye rer na.<verse eid="PRO 29:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20" />Snonkaku venawnowerya ismai kayaryarpyum syadi ro,</para>
  <para style="q2" vid="PRO 29:20">snonkaku veyawos nabor imboi vekara veponba.<verse eid="PRO 29:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21" />Manfamyan sve manwinm ro fyor byaboya,</para>
  <para style="q2" vid="PRO 29:21">varpurya nari vruri pyakrek.<verse eid="PRO 29:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22" />Snonkaku vemasasor fasau vyedar kawasa vebor srakrok</para>
  <para style="q2" vid="PRO 29:22">ma sifrur sasar nabor.<verse eid="PRO 29:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23" />Snonkaku veyawow nari vye vepandun;</para>
  <para style="q2" vid="PRO 29:23">snonkaku verun mankun nari ismai ararer.<verse eid="PRO 29:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24" />Snonkaku vesmai var rarwas ro snonkaku vekarau,</para>
  <para style="q2" vid="PRO 29:24">irya vye mbrov mankundi.</para>
  <para style="q1" vid="PRO 29:24">Rofyor dawos kakaku ro varpon mankakara,</para>
  <para style="q2" vid="PRO 29:24">nari ismai samamyai.</para>
  <para style="q1" vid="PRO 29:24">Imboi vye fasis monda ido,</para>
  <para style="q2" vid="PRO 29:24">nari ismai farasras ro Allah.<verse eid="PRO 29:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25" />Wamkak faro snonkaku, vyedar vave marindi.</para>
  <para style="q2" vid="PRO 29:25">Wararyof faro <char style="nd">Manseren Allah</char> I, rarirya nari wasmai kananon.<verse eid="PRO 29:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26" />Snonkaku sibor sve sewar insa sismai kayaryar ro snoporya,</para>
  <para style="q2" vid="PRO 29:26">mbape vevuk napnapesya demir monda <char style="nd">Manseren Allah</char> I.<verse eid="PRO 29:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27" />Snonkaku venapes simarisenba faro snonkaku kenem vevyeva sya;</para>
  <para style="q2" vid="PRO 29:27">snonkaku rari vevyevasya sembrov snonkaku kenem vepyumsya.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="s1">Wawos Agur vyena</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />Ine irya wawos vefo firnanem ro Agur, Yake romawa vyedi:</para>
  <para style="q1" vid="PRO 30:1">Ikofen radine: “Yamor rape, sye Allah,</para>
  <para style="q2" vid="PRO 30:1">yamor kaku! Samambrav ayena navro!<verse eid="PRO 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2" />Snar ayaine yafawi nanemba syadi snonkaku vesesya,</para>
  <para style="q2" vid="PRO 30:2">swarnanem snonkaku naisya ro ayava.<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />Firnanemya yafarkori vaveri,</para>
  <para style="q2" vid="PRO 30:3">yafawi royovaveri vekur Allah Vesren Venapes.<verse eid="PRO 30:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />Snonkaku mundiri veyek ve nanki ramnai vedo kaver?</para>
  <para style="q2" vid="PRO 30:4">Mundiri vekifepen wamya ro vrasi?</para>
  <para style="q1" vid="PRO 30:4">Mundiri vekpan epen vedokya kuker kruven?</para>
  <para style="q2" vid="PRO 30:4">Mundiri verirepen supswan ine was vyena?</para>
  <para style="q1" vid="PRO 30:4">Inido snoriso, ma romawa vyedi snoriso?</para>
  <para style="q2" vid="PRO 30:4">Auma na wafawi!”<verse eid="PRO 30:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5" />Allah svayo vyenakam navye nanapes.</para>
  <para style="q2" vid="PRO 30:5">Vye adai mamun faro snonkaku vefadiren ro I.<verse eid="PRO 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6" />Wawos pam awer rosai Ikofen na,</para>
  <para style="q2" vid="PRO 30:6">insa Isonek awer au ma Myam au ve vekofen rokakuva.<verse eid="PRO 30:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7" />Sye Allah, yor yov Au,</para>
  <para style="q2" vid="PRO 30:7">rofyor yamar vaim, Buk ve aya roi ri suru, susoine:<verse eid="PRO 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8" />Pampum ro vandi bur aya frur vekarfiva ma wos ankarkar.</para>
  <para style="q2" vid="PRO 30:8">Buk fa yasavarar awer rovaido yanana awer.</para>
  <para style="q2" vid="PRO 30:8">Buk ve aya rosai yave fandun na monda.<verse eid="PRO 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9" />Insa, rofyor yarbor ido yafamyun awer Au</para>
  <para style="q2" vid="PRO 30:9">ma yafuken sei: <char style="nd">Manseren Allah</char> inido?</para>
  <para style="q1" vid="PRO 30:9">Rovaido, rofyor yasavarar ido nari yakarau,</para>
  <para style="q2" vid="PRO 30:9">isof yafrur anonef Allah yedi snosnon vyedi.<verse eid="PRO 30:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10" />Wakofen awer wos vekakuva vekur manfyan oso faro amber vyedi,</para>
  <para style="q2" vid="PRO 30:10">insa ifras awer au ma kyor au ve vesasar.<verse eid="PRO 30:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11" />Snonkaku ono sifras kma sesya</para>
  <para style="q2" vid="PRO 30:11">ma se vok sna sesyava.<verse eid="PRO 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12" />Snonkaku ono kako skara vo sovo sisren,</para>
  <para style="q2" vid="PRO 30:12">orovavoi smamas kaku.<verse eid="PRO 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13" />Snonkaku ono skara vo sovo sikada sipyum syadi</para>
  <para style="q2" vid="PRO 30:13">ma snonkaku evesesya sefaindava.<verse eid="PRO 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14" />Snonkaku ono sisya sinambri ma skarfiva simnis aiwan verafdi ma sinas nasar,</para>
  <para style="q2" vid="PRO 30:14">ma sifrirepen snonkaku vesavarar ma veryarvasya ra sirisem rofandu snonkakusya.<verse eid="PRO 30:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15" />Wepoiya nya inai ri suru;</para>
  <para style="q2" vid="PRO 30:15">suna snonsnon oser isoine “Ayenairi”!</para>
  <para style="q1" vid="PRO 30:15">Roi ri fyak i vesyopenba isoine:<verse eid="PRO 30:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="PRO 30:16" />Mun aivuiya ma vin vepasnasem vesararan romawa,</para>
  <para style="q2" vid="PRO 30:16">saprop eve fandun mekem vesyakwar ma for vesber kakek ve mov nakam.<verse eid="PRO 30:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17" />Romawa vefankoryaye kmari</para>
  <para style="q2" vid="PRO 30:17">orovaido snari eve mansar insar kwar,</para>
  <para style="q1" vid="PRO 30:17">vye vesawen ve bondi insa</para>
  <para style="q2" vid="PRO 30:17">manwawasya sisos mkamor vyesi ma mankankansya san baken vyedi.<verse eid="PRO 30:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 30:18" />Roi ri fyak vesamswen kaku yafawi mnisva:<verse eid="PRO 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19" />mankankan verov ro farsyos,</para>
  <para style="q1" vid="PRO 30:19">ikak ve saves ro bo karui wonon,</para>
  <para style="q1" vid="PRO 30:19">karures veyayun ro soren bro,</para>
  <para style="q1" vid="PRO 30:19">ma romawa inai babo veswar yayesu.<figure style="fig" file="HK00077C.TIF" size="col" ref="30:19">Mankankan</figure><verse eid="PRO 30:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20" />Ine irya rari vin vefarvuk eve sonei:</para>
  <para style="q2" vid="PRO 30:20">dan raposa isvuyar svari ma ikofen: “Ayama yafrur royova!”<verse eid="PRO 30:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 30:21" />Roi ri fyak vefrur kanandor snonkaku ro supswan ine:<verse eid="PRO 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22" />Manfamyan vesmai nasan wairek,</para>
  <para style="q2" vid="PRO 30:22">snonkaku venawnower vesmananem roi vebor vye fandun na,<verse eid="PRO 30:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 30:23" />vinfyan oso snonkakusya simariseniba, vesyavo varpurya fyarvuk,</para>
  <para style="q2" vid="PRO 30:23">vinfyan vefasyar kankon vin amber vyedi.<verse eid="PRO 30:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 30:24" />Ro supswan ine aiwan rifyak vebava syadi sisya,</para>
  <para style="q2" vid="PRO 30:24">imbape sifawi nanem kaku:<verse eid="PRO 30:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25" />Anirsya, aiwan kasun veryarva sirya,</para>
  <para style="q2" vid="PRO 30:25">imbape sfasos anan sena ro fafis supya idares.<verse eid="PRO 30:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26" />Rambav sop<note caller="+" style="f"><char style="fr" closed="false">30:26 </char><char style="ft" closed="false">Wos Ibrani ya ido Safan, imnisra Rambav sop</char></note>, aiwan veryarva,</para>
  <para style="q2" vid="PRO 30:26">imbape vefrur nas vyedi ro urek kapis veve kerui.<figure style="fig" file="HK00055C.TIF" size="col" ref="30:26">Rambav sop</figure><verse eid="PRO 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27" />Mankampam, aiwan vena manfarkinva,</para>
  <para style="q2" vid="PRO 30:27">imbape sve maran oser.<verse eid="PRO 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28" />Kanfnar aiwan sfor kako kuker vramin,</para>
  <para style="q2" vid="PRO 30:28">imbape isya kako ro waireksya aidoran sena.<verse eid="PRO 30:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 30:29" />Roi rifyak vefrur kamanen rofyor komam mov simbran raya, isoine:<verse eid="PRO 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30" />Singa, aiwan vesambrav kaku imkak faro royova veri;<verse eid="PRO 30:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 30:31" />kambing snoman ma mankoko snoman vembran ararer,</para>
  <para style="q2" vid="PRO 30:31">wairek vembran ro varpon rak mamun vyesi.<verse eid="PRO 30:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32" />Inja snar fawi nanemba ma kuker marares bena kwara fa wafrur roi vevyeva,</para>
  <para style="q2" vid="PRO 30:32">waswarepen!<verse eid="PRO 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33" />Snar fafisu wun srai masya fa rwawri ra myawai ma wakafos inido, nari wasmai papraf vyedi.</para>
  <para style="q2" vid="PRO 30:33">Rofyor waprer snonkakuyo ro snonisi, nari snonisi irike.</para>
  <para style="q2" vid="PRO 30:33">Rofyor wasurvawes dormomen, irya wafnai vedar mbrise.<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s1">Ananun vebor faro wairek</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />Nane ido wos ananun faro wairek Lemuel, sna vyedi fyarkor ve i.<verse eid="PRO 31:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 31:2" />“Romawa saneraro ayedi, romawa yakapar snar kankarem ro nadi ayena. Rwower navye wos ananun ayenane: <verse eid="PRO 31:2" /><verse number="3" style="v" sid="PRO 31:3" />Rwir awer samambrav bena faro vinsya. Wairek sibor semompraf snar vine. <verse eid="PRO 31:3" /><verse number="4" style="v" sid="PRO 31:4" />Waswarepen, Lemuel, Aninem anggur ma farandinem, nasyusva faro wairek. <verse eid="PRO 31:4" /><verse number="5" style="v" sid="PRO 31:5" />Snar wairekya fyarandinem ido, nari vye fnder sasoserya ma snonkaku veryarvasya vye fandunsiva. <verse eid="PRO 31:5" /><verse number="6" style="v" sid="PRO 31:6" />Buk swan vesarmarsya faro snonkaku veduf ra fanam vemar ma snonkaku sne vefafardunsya fa sinem. <verse eid="PRO 31:6" /><verse number="7" style="v" sid="PRO 31:7" />Sinem si fa sefnder sovarar ma vavemarindi sena.<verse eid="PRO 31:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 31:8" />Besano warek snonkaku eve sano warek mankundiva. Wakadaun snonkaku vebor veryarvasya. <verse eid="PRO 31:8" /><verse number="9" style="v" sid="PRO 31:9" />Wasaran warek si, ma be mankakara veyores avyover. Kwadaun snonkaku vesavarar ma snonkaku sarf apepensya.”<verse eid="PRO 31:9" /></para>
  <para style="s1">Sanandik faro swa vra vesanyanem</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10" />Vin vra vesanyanem syamswen kaku fa kosrow i;</para>
  <para style="q2" vid="PRO 31:10">vye maija syadi ro keru brawen.<verse eid="PRO 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11" />Snon vyukya nari dananjar royova,</para>
  <para style="q2" vid="PRO 31:11">snar ikyar kaku faro i.<verse eid="PRO 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12" />Rasofa ifrur roi vevyeva faro swariva;</para>
  <para style="q2" vid="PRO 31:12">ras kenem vyeja kasiper ifrur pyum faro i. <verse eid="PRO 31:12" /><verse number="13" style="v" sid="PRO 31:13" />Imyaren iryur ampyampumber ma domba bur</para>
  <para style="q2" vid="PRO 31:13">ma imarisen ifararur kuker vramin vyesi.<verse eid="PRO 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14" />Imnis manfarvyansya kapal sena,</para>
  <para style="q2" vid="PRO 31:14">vevyawen rovean ker sup vevinkwan,<verse eid="PRO 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15" />Vyir ro arwo prim kaku fa fyasos anan aninem faro kina vyesi,</para>
  <para style="q2" vid="PRO 31:15">ra posa irarwas fararur faro mamfamyan vyesi.<verse eid="PRO 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16" />Syewar saprop mnuk oso fa kyoves;</para>
  <para style="q2" vid="PRO 31:16">ma ro nana ismai kwar na vyuki frur yaf anggurya.<verse eid="PRO 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17" />Fyasos vinkundi</para>
  <para style="q2" vid="PRO 31:17">fa ifararur marvak kaku.<verse eid="PRO 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18" />Ifawi kaku roi vebor ifrur nakam nari ismai kraf ro na;</para>
  <para style="q2" vid="PRO 31:18">ifararur isof rovya faduri.<verse eid="PRO 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19" />Ryip mandwam na</para>
  <para style="q2" vid="PRO 31:19">ma ryorem nafa ne sansun.<verse eid="PRO 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20" />Dan navye faro veyananjarsya;</para>
  <para style="q2" vid="PRO 31:20">ma vyenavye faro snonkaku eve fandun fanfnoveksya.<verse eid="PRO 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21" />Fafisu pnunkya ifyafer ido vye virvarva,</para>
  <para style="q2" vid="PRO 31:21">snar sansun vesamna fyasos na kwar faro kina vyesi.<verse eid="PRO 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22" />Syarmur yar anenef faro vinkundi;</para>
  <para style="q2" vid="PRO 31:22">sansun vyena kako isipna ro kruven veyafuk worem vemawai ma vedoser kaku.<verse eid="PRO 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23" />Swa vyedi vye sno,</para>
  <para style="q2" vid="PRO 31:23">manfarkin kota oso irya kako.<verse eid="PRO 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24" />Ifrur sansun ma riv vevovek</para>
  <para style="q2" vid="PRO 31:24">fa vyov faro manfarvyansya.<verse eid="PRO 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25" />Vin vesambrav rirya ma ismai syowi ro snonkaku;</para>
  <para style="q2" vid="PRO 31:25">ma ipok vye virvarva snar rosai nari vero ras varponya.<verse eid="PRO 31:25" /></para>
  <para style="q2">
    <verse number="26" style="v" sid="PRO 31:26" />Wos vyena namyaren kaku;</para>
  <para style="q2" vid="PRO 31:26">wawos vyena nafo kuker firnanem.<verse eid="PRO 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27" />Ifararur nasrawen kaku</para>
  <para style="q2" vid="PRO 31:27">ma myamepen pyum kaku fararur vero rum rido vyedi.<verse eid="PRO 31:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28" />Romawa inai vyesi se syowi i,</para>
  <para style="q2" vid="PRO 31:28">ma ismai ararer ro swari.<verse eid="PRO 31:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29" />Swa vyedi ikofen, “Vin vefrur pyumsya sibore,</para>
  <para style="q2" vid="PRO 31:29">imbape au vepyum syadadi ro sikaem.”<verse eid="PRO 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30" />Mam mayarna nafrowes ma baken vedoser nari nefromo;</para>
  <para style="q2" vid="PRO 31:30">imbape vin vesoyuser faro <char style="nd">Manseren Allah </char> I ikada ismai ararer.<verse eid="PRO 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31" />Swurf i raris fararur vyena;</para>
  <para style="q2" vid="PRO 31:31">isyusfa ismai syowi ro mov nakam!<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>