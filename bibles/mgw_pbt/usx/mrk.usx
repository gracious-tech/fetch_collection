<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Matumbi Bible Version</book>
  <para style="h">Maluko</para>
  <para style="toc3">Mal</para>
  <para style="toc2">Maluko</para>
  <para style="toc1">Injili ya Maluko</para>
  <para style="mt1">Maluko</para>
  <para style="mt2">Injili ya Yesu Mwaiandikilwe na Maluko</para>
  <chapter number="1" style="c" sid="MRK 1"/>
  <para style="s">Maalo ga Yoani Ywabatisage</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mat 3:1-12</ref>, <ref loc="LUK 3:1-18">Luk 3:1-18</ref>, <ref loc="JHN 1:19-28">Yoa 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1"/>Pano nga paitumbwa abali inannoga ya Yesu Kilisitu, Mwana wa Nnu'ngu'. <verse eid="MRK 1:1"/><verse number="2" style="v" sid="MRK 1:2"/>Yaatumbwi kati mwaiandikilwe mukitabu sa nnondoli ywa Nnu'ngu' Isaya.</para>
  <para style="q1" vid="MRK 1:2">“Nnu'ngu' aatibaya, ‘Lola, nintuma ntumisi wangu' akulongoli,</para>
  <para style="q2" vid="MRK 1:2">ywaalu'a kubi'kya wiso ndi'la yako.’<verse eid="MRK 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3"/>Lilobe lya mundu liyu'wanika kulupu'ngu'ti',</para>
  <para style="q2" vid="MRK 1:3">‘Mummi'ki wiso Bwana ndi'la yake,</para>
  <para style="q1" vid="MRK 1:3">mugolwe simbasimba yake.’”<verse eid="MRK 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4"/>Yoani Ywabatisage aabonekine kulupu'ngu'ti', ngaala panga bandu banng'alambuki Nnu'ngu' no batisilwa li'nga basamilwe masambi gabe. <verse eid="MRK 1:4"/><verse number="5" style="v" sid="MRK 1:5"/>Bandu bu'ka ku nni'ma wa Yudea yoti na benekaya boti ba ku Yelusalemu baatikunnyendelya, ngabaungama masambi gabe, naywembe ngaabatisa mulibi'ndi' lya Yordani.<verse eid="MRK 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6"/>Yoani aabile aweti ngu'bo yaitengenesilwe kwa mandenga ga ngamia na lunga lwa liki'ngo. Kilyo sake saai njige na busi wa mmwitu. <verse eid="MRK 1:6"/><verse number="7" style="v" sid="MRK 1:7"/>Naywembe aatiala kabaya, “Bu'ka pangu', aaisa mwene makakala kulikoni nenga, ata ne nipwaikali lita undwa ngoi ya ilatu yake. <verse eid="MRK 1:7"/><verse number="8" style="v" sid="MRK 1:8"/>Nenga nimmatisa kwa masi', lakini ywembe alu'a kummatisa kwa Loo Mpeleteu.”<verse eid="MRK 1:8"/></para>
  <para style="s">Batisilwa no payilwa kwa Yesu</para>
  <para style="r">(<ref loc="MAT 3:13-4:11">Mat 3:13-4:11</ref>, <ref loc="LUK 3:21-22">Luk 3:21-22</ref>, <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9"/>Masu'ba go, Yesu aaisi bu'ka ku Nasaleti kunkoa wa Galilaya, ngabatisilwa na Yoani mulibi'ndi' lya Yordani. <verse eid="MRK 1:9"/><verse number="10" style="v" sid="MRK 1:10"/>Paapitike mumasi' bai, ngaakubona kunani kupuwanike na Loo Mpeleteu kamuulukya panani yake kati ngunda. <verse eid="MRK 1:10"/><verse number="11" style="v" sid="MRK 1:11"/>Lilobe ngaliyu'wanika bu'ka kunani, “Wenga nga wa Mwana wangu' wanikupendile, ninogelilwe nawenga.”<verse eid="MRK 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12"/>Popopo Loo Mpeleteu ngannongoya ayende kulupu'ngu'ti', <verse eid="MRK 1:12"/><verse number="13" style="v" sid="MRK 1:13"/>ngatama kwo masu'ba alubaini kapayilwa na Ibilisi. Aabile kwo pamope na inyama ya mmwitu, nabembe malaika ngababaa kabantumikia.<verse eid="MRK 1:13"/></para>
  <para style="s">Yesu akema alobi nsese</para>
  <para style="r">(<ref loc="MAT 4:12-22">Mat 4:12-22</ref>, <ref loc="LUK 4:14-15">Luk 4:14-15</ref>, <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14"/>Yoani paabile muutabilwe, Yesu aayi'i ku Galilaya ala abali inannoga ya Nnu'ngu' kabaya, <verse eid="MRK 1:14"/><verse number="15" style="v" sid="MRK 1:15"/>“Nsimu wawalondolilwe utimile, na Ukulungwa wa Nnu'ngu' wegelile. Munng'alambuki Nnu'ngu' na kwiu'bi'lya abali inannoga!”<verse eid="MRK 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16"/>
    <figure style="fig" alt="Fishers fishing with a net" file="07 Fishing.jpg" size="col" ref="1:16">Alobi kabaloba omba kwa lupi'li'li'</figure>Yesu paabile kapi'ta mbwega ya litanda liku'lu' lya ku Galilaya, aabweni alobi abi'li' Simoni na Andelea nnunawe kabaloba omba kwa lupi'li'li'. <verse eid="MRK 1:16"/><verse number="17" style="v" sid="MRK 1:17"/>Yesu ngaabakia, “Mungi'ngame nane nalu'a kumpanga mwaalobi ba bandu.” <verse eid="MRK 1:17"/><verse number="18" style="v" sid="MRK 1:18"/>Popopo ngabaileka mbi'li'li' yabe na kunki'ngama. <verse eid="MRK 1:18"/><verse number="19" style="v" sid="MRK 1:19"/>Paayi'i nnu'ngi' pasene aabweni Yakobi na Yoani, bana ba Zebedayo. Nabembe baai mungalaba kabanogeya mbi'li'li' yabe.<verse eid="MRK 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 1:20"/>Popopo Yesu ngaakema, nabembe ngabaaleka tati' babe mungalaba pamope na apangakasi na kunki'ngama.<verse eid="MRK 1:20"/></para>
  <para style="s">Mundu mwene moka</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luk 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21"/>Ngabaika kukilambo sa Kapernaumu, na palyaaikite lisu'ba lya Sabato, Yesu ayingi munyumba ya kunnu'ba Nnu'ngu' no tumbwa yi'gana. <verse eid="MRK 1:21"/><verse number="22" style="v" sid="MRK 1:22"/>Bandu boti pabannyu'wine baatisangala muno kwa mayi'gano gake, mwanjaa aayi'gineli kati balimu ba salya ya Musa, ila kati ntawala.<verse eid="MRK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23"/>Popopo mu'lu' munyumba ya kunnu'ba Nnu'ngu' ngapitya mundu mwene moka katu'ndu'bi'ya lilobe, <verse eid="MRK 1:23"/><verse number="24" style="v" sid="MRK 1:24"/>“Ubile na ki'li' na twenga, wenga wa Yesu wa ku Nasaleti? Buli, wisi? Nikutangite wenga wanyai. Wenga nga wa Mpeleteu wa Nnu'ngu'!” <verse eid="MRK 1:24"/><verse number="25" style="v" sid="MRK 1:25"/>Yesu ngaankalipya yu'lu' moka kabaya, “Ndu'ti! Ummu'ke mundu yu'.” <verse eid="MRK 1:25"/><verse number="26" style="v" sid="MRK 1:26"/>Bai, aywo moka ngaantikatika mundu ywo, bu'kapo ngali'la kwa lilobe liku'lu', ngammu'ka. <verse eid="MRK 1:26"/><verse number="27" style="v" sid="MRK 1:27"/>Bandu boti baatisangala, ngabalaluyana, “Aga nga makowe gani? Buli, nga mayi'gano gayambi'? Mundu yu' abi na amuli yo amulisa ata moka, nagembe gendakunnyu'wa!” <verse eid="MRK 1:27"/><verse number="28" style="v" sid="MRK 1:28"/>Abali ya Yesu ngaiyu'wanika kwa kiyu'ngu'ya mu Galilaya yoti.<verse eid="MRK 1:28"/></para>
  <para style="s">Yesu atepwa bandu baingi</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mat 8:14-17</ref>, <ref loc="LUK 4:38-41">Luk 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29"/>Ngabapita munyumba ya kunnu'ba Nnu'ngu' no yenda ntawalia mpaka kasabe ki Simoni na Andelea, Yakobi na Yoani baayi'i pamope nabo. <verse eid="MRK 1:29"/><verse number="30" style="v" sid="MRK 1:30"/>Bai, mau' yumo, nkiwe Simoni aai pakindanda kaminya oma ngali'. Yesu paikite bai, ngabammakia abali yo. <verse eid="MRK 1:30"/><verse number="31" style="v" sid="MRK 1:31"/>Yesu ngannyendelya aywo mau' na kunkamwa luboko, ngantu'ndu'bi'ya. Yi'lu' oma ngayu'yu'ki'lwa, ngatumbwa kwatumikia.<verse eid="MRK 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32"/>Kitamwiyo, lisu'ba paliswikite, ngabannetya Yesu atamwe boti na bandu babaalobi moka. <verse eid="MRK 1:32"/><verse number="33" style="v" sid="MRK 1:33"/>Bandu boti ba kilambo si'lu' ngabakongolekana paniango. <verse eid="MRK 1:33"/><verse number="34" style="v" sid="MRK 1:34"/>Naywembe Yesu ngaatepwa bandu bambone babaabile na matamwe mbali'mbali', agabi'ngite moka maingi. Lakini aagayi'ki'tiyeli longela kili'be kwa mwanjaa baai bantangite panga ywembe nga nyai.<verse eid="MRK 1:34"/></para>
  <para style="s">Yesu aala ku Galilaya</para>
  <para style="r">(<ref loc="LUK 4:42-44">Luk 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35"/>Pammalau' yake bulabula, Yesu aatiyumuka no bu'ka yenda pandu pakiyi'ki'ya li'nga sali. <verse eid="MRK 1:35"/><verse number="36" style="v" sid="MRK 1:36"/>Simoni na aine ngabayenda kumpala. <verse eid="MRK 1:36"/><verse number="37" style="v" sid="MRK 1:37"/>Pabankolile, ngabammakia, “Bandu boti bendakupala.” <verse eid="MRK 1:37"/><verse number="38" style="v" sid="MRK 1:38"/>Yesu ngaabakia, “Tubu'ke kuilambo yi'ngi' ya papipi nikaale kwo kai', kwa mwanjaa niisi kwa kitumbu so.” <verse eid="MRK 1:38"/><verse number="39" style="v" sid="MRK 1:39"/>Bai, ngayenda kila pandu akwo ku Galilaya kaala mumayumba ga kunnu'ba Nnu'ngu' no bi'nga moka.<verse eid="MRK 1:39"/></para>
  <para style="s">Yesu antepwa mundu mwene matana</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mat 8:1-4</ref>, <ref loc="LUK 5:12-16">Luk 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40"/>Mundu yumo mwene matana annyendeli Yesu, ngakilikita, ngannu'ba, “Mana upendile, wendakombwa kunitepwa li'nga nipeleteke!” <verse eid="MRK 1:40"/><verse number="41" style="v" sid="MRK 1:41"/>Yesu ngammi'kya kiya, ngagolwa luboko lwake, ngankunywa na kummakia, “Mbala upeleteke.” <verse eid="MRK 1:41"/><verse number="42" style="v" sid="MRK 1:42"/>Popopo mundu ywo ngayu'yu'ki'lwa galu' matana, naywembe ngapeleteka. <verse eid="MRK 1:42"/><verse number="43" style="v" sid="MRK 1:43"/>Bu'kapo Yesu ngankwi'li'ka abu'ke kiyu'ngu'ya kwa kummakia, <verse eid="MRK 1:43"/><verse number="44" style="v" sid="MRK 1:44"/>“Pi'kania, kaneummakie mundu ywoywoti likowe li'no. Ila uyende ukailaye kwa mpi'ndo ywa dini na ukapiye salaka kwo peleteka kwako, kati mwaamulise Musa kong'ondelya panga utepulilwe.” <verse eid="MRK 1:44"/><verse number="45" style="v" sid="MRK 1:45"/>Lakini aywo mundu ngayenda no tumbwa bambia makowe go kila pandu no baya makowe gambone. Kwa nyo, Yesu akombwili kai' yingya mukilambo sosoti mpu'la, aapalikwe tama panja pandu pakiyi'ki'ya. Ata nyo, bandu ngabannyendelya bu'ka kila lwingo.<verse eid="MRK 1:45"/></para>
  <chapter eid="MRK 1"/>
  <chapter number="2" style="c" sid="MRK 2"/>
  <para style="s">Yesu antepwa mundu ywatombolwike</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mat 9:1-8</ref>, <ref loc="LUK 5:17-26">Luk 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1"/>Bu'ka pa masu'ba nsi'si', Yesu aki'li'bu'ki ku Kapernaumu, bandu ngabayu'wa panga aabile pakaya. <verse eid="MRK 2:1"/><verse number="2" style="v" sid="MRK 2:2"/>Bandu bambone ngabakongolekana palu', tumbulya nnyumba mpaka paniango. Yesu paabile kaalya mayi'gi'yo ga Nnu'ngu', <verse eid="MRK 2:2"/><verse number="3" style="v" sid="MRK 2:3"/>bandu nsese bannetike mundu yumo ywatombolwike abile mpu'tu'lwa mulikai. <verse eid="MRK 2:3"/><verse number="4" style="v" sid="MRK 2:4"/>Kwa kitumbu sa uyolou wa bandu, bakombwili kumpeleka papipi na Yesu. Bai, ngabaotwa mwagala wawaabile panani ya Yesu. Pabaabile bapatike lipala, ngabamweleya aywo mundu. <verse eid="MRK 2:4"/><verse number="5" style="v" sid="MRK 2:5"/>Yesu paabweni imani yabe ngangamau, ngammakia yu'lu' mundu ywatombolwike, “Mwana wangu', usamilwe masambi gako.”<verse eid="MRK 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6"/>Bi'ngi' ba balimu ba salya ya Musa babaabile batami palu' ngabagania mumyoyo yabe, <verse eid="MRK 2:6"/><verse number="7" style="v" sid="MRK 2:7"/>“Akombwabuli baya nyo? Ankupulu Nnu'ngu'! Ntu'pu' mundu ywakombwa samya sambi ila Nnu'ngu' kisake.” <verse eid="MRK 2:7"/><verse number="8" style="v" sid="MRK 2:8"/>Popopo Yesu ngakwipwa maganiyo gabe, ngaabakia, “Mboni mugania nyo mumyoyo yinu? <verse eid="MRK 2:8"/><verse number="9" style="v" sid="MRK 2:9"/>Nga lyaku' lyalibile kwani muno, kummakia mundu yu' ywatombolwike, ‘Usamilwe masambi gako,’ au kummakia, ‘Uyi'me! Utole likai lyako utyange’? <verse eid="MRK 2:9"/><verse number="10" style="v" sid="MRK 2:10"/>Bai, mbala mutange panga Mwana wa Mundu abile na utawala wa kwasamya bandu sambi padunia.” Apo ngammakia aywo mundu ywatombolwike, <verse eid="MRK 2:10"/><verse number="11" style="v" sid="MRK 2:11"/>“Nikubakia uyi'me, utole likai lyako uyende kasako!” <verse eid="MRK 2:11"/><verse number="12" style="v" sid="MRK 2:12"/>Popopo, bandu boti baabile kabannola aywo mundu mwayi'ma, tola likai lyake no bu'ka. Boti ngabasangala na kunkwi'ya Nnu'ngu' kababaya, “Tunalibonali likowe kati li'no.”<verse eid="MRK 2:12"/></para>
  <para style="s">Lawi endakemelwa</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mat 9:9-13</ref>, <ref loc="LUK 5:27-32">Luk 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13"/>Yesu ayi'i kai' mbwega ya litanda liku'lu' lya Galilaya. Lipi'nga lya bandu ngalinnyendelya, naywembe ngatumbwa kwayi'gana.<verse eid="MRK 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 2:14"/>Paabile kapi'ta, ngammona Lawi, mwana wa Alufayo, atami muopisi ya alonga koli. Yesu ngammakia, “Ungi'ngame.” Lawi ngayi'ma, nganki'ngama.<verse eid="MRK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15"/>Yesu paabile kalya munyumba ya Lawi, alonga koli baingi na bene sambi baabile kabalya pamope naywembe na banamasi' bake, kwa mwanjaa kwai na bandu baingi babaabile kabanki'ngama. <verse eid="MRK 2:15"/><verse number="16" style="v" sid="MRK 2:16"/>Bai, bi'ngi' ba balimu ba salya babaabile Mafalisayo baamweni Yesu kalya pamope na alonga koli na bene sambi. Ngabaalaluya banamasi' bake, “Kwa mwanjaa buli alya pamope na alonga koli na bene sambi?” <verse eid="MRK 2:16"/><verse number="17" style="v" sid="MRK 2:17"/>Yesu paayu'wine, ngaabakia, “Bandu bene ukoto bapalali nng'anga, babampala nng'anga balu' bababile atamwe. Niisili kwakema bandu anogau ila bene sambi.”<verse eid="MRK 2:17"/></para>
  <para style="s">Likowe lyo bu'kana no punga</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mat 9:14-17</ref>, <ref loc="LUK 5:33-39">Luk 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18"/>Banamasi' ba Yoani Ywabatisage na Mafalisayo baabile kabapunga. Bai, bandu ngabaisa kunnaluya Yesu, “Kwa mwanjaa buli banamasi' ba Yoani na ba Mafalisayo bendapunga lakini banamasi' bako bapungali?” <verse eid="MRK 2:18"/><verse number="19" style="v" sid="MRK 2:19"/>Yesu ngayangwa, “Buli, babakokilwe kulisengele bapalikwa punga ku'no babile pamope na nkobeki? Pababaa pamope na nkobeki bapalikwali punga. <verse eid="MRK 2:19"/><verse number="20" style="v" sid="MRK 2:20"/>Lakini nsimu walu'a ika wo bu'yi'lwa nkobeki kwa akokelwe, na nsimu wo ngapabalu'a punga.<verse eid="MRK 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21"/>“Ntu'pu' mundu ywabi'ka kibamba sayambi' mungu'bo ngona. Mana apangite nyo kibamba sayambi' sapopwana ayo ngu'bo ngona, no popwanika kwake kwamambulya muno. <verse eid="MRK 2:21"/><verse number="22" style="v" sid="MRK 2:22"/>Wala bandu bayi'yali divai yayambi' mumapu'tu' magona. Mana bapangite nyo divai yalu'a puwana ago mapu'tu', na yembe divai pamope na mapu'tu' yaalabika. Divai yayambi' iyi'yi'lwa mumapu'tu' gayambi'!”<verse eid="MRK 2:22"/></para>
  <para style="s">Makowe ga Lisu'ba lya Sabato</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mat 12:1-8</ref>, <ref loc="LUK 6:1-5">Luk 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23"/>Lisu'ba limo lya Sabato ya Ayahudi, Yesu aabile kapi'ta mumigunda ya ngano. Banamasi' bake ngabatumbwa ti'kwa yeyo ya ngano. <verse eid="MRK 2:23"/><verse number="24" style="v" sid="MRK 2:24"/>Bai, Mafalisayo ngabammakia Yesu, “Lola, mwanjaa namani banamasi' bako bapanga likowe lyalikanilwa lisu'ba lya Sabato?” <verse eid="MRK 2:24"/><verse number="25" style="v" sid="MRK 2:25"/>Yesu ngaayangwa, “Buli, munasomali mwaapangite Daudi pamope na aine pabaabile na njala? <verse eid="MRK 2:25"/><verse number="26" style="v" sid="MRK 2:26"/>Abiatali paabile mpi'ndo nku'lu' ywa dini, Daudi aayingi munyumba ya Nnu'ngu' no lya makati mapeleteu na kwapeya aine. Yayi'ki'tilweli mundu lya makati go, ila api'ndo ba dini bai.” <verse eid="MRK 2:26"/><verse number="27" style="v" sid="MRK 2:27"/>Bai Yesu ngaabakia, “Lisu'ba lya Sabato lyabi'kilwe kwa bandu, na kwenda bandu baabi'kilwe kwa lisu'ba lyo lili. <verse eid="MRK 2:27"/><verse number="28" style="v" sid="MRK 2:28"/>Kwa nyo, Mwana wa Mundu nga Bwana wa Sabato.”<verse eid="MRK 2:28"/></para>
  <chapter eid="MRK 2"/>
  <chapter number="3" style="c" sid="MRK 3"/>
  <para style="s">Yesu antepwa mwene luboko lwalutombolwike</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mat 12:9-14</ref>, <ref loc="LUK 6:6-11">Luk 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1"/>Yesu aayingi kai' munyumba ya kunnu'ba Nnu'ngu' na amo kwaabile na mundu yumo mwene luboko lutomboloka. <verse eid="MRK 3:1"/><verse number="2" style="v" sid="MRK 3:2"/>Mafalisayo baabile kabanni'nda bammone kantepwa mundu ywo lisu'ba lya Sabato ya Ayahudi, li'nga kunsitakya. <verse eid="MRK 3:2"/><verse number="3" style="v" sid="MRK 3:3"/>Yesu ngammakia yu'lu' mundu mwene luboko lutomboloka, “Wise pano pakatikati.” <verse eid="MRK 3:3"/><verse number="4" style="v" sid="MRK 3:4"/>Bu'kapo ngaalaluya, “Salya yendayi'ki'ti'a panga manogau au maakau lisu'ba lya Sabato? Tepwa au bulaga?” Lakini bembe baayangwili kikowe. <verse eid="MRK 3:4"/><verse number="5" style="v" sid="MRK 3:5"/>Yesu ngaabu'nju'lya minyo kwa nyongo kanyopa kwa kitumbu sa unonopau wa myoyo yabe, ngammakia yu'lu' mundu, “Golwa luboko lwako.” Ngalugolwa na lwembe ngalupanga lukoti. <verse eid="MRK 3:5"/><verse number="6" style="v" sid="MRK 3:6"/>Popopo Mafalisayo ngabapita panja, panga kitamo pamope na bandu ba kipi'nga sa Helode li'nga pala ndi'la ya kummulaga Yesu.<verse eid="MRK 3:6"/></para>
  <para style="s">Kipi'nga sa bandu mbwega ya litanda liku'lu'</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7"/>Yesu pamope na banamasi' bake ngababu'ka yenda mbwega ya litanda liku'lu' lya Galilaya, na kipi'nga kiku'lu' sa bandu satikunki'ngama. Bandu bo baaumi Galilaya, Yudea, <verse eid="MRK 3:7"/><verse number="8" style="v" sid="MRK 3:8"/>Yelusalemu, Idumea, kwiyi' ya libi'ndi' lya Yordani, Tilo na Sidoni. Bandu bo baingi bannyendeli Yesu kwa kitumbu baayu'wine makowe maingi gaagapangite. <verse eid="MRK 3:8"/><verse number="9" style="v" sid="MRK 3:9"/>Yesu ngaabakia banamasi' bake bammi'ki wiso ngalaba yimo li'nga kipi'nga sa bandu sakane kumpapania. <verse eid="MRK 3:9"/><verse number="10" style="v" sid="MRK 3:10"/>Aatikwatepwa bandu baingi, na atamwe bambone babaabile kabampapania li'nga bankunywe. <verse eid="MRK 3:10"/><verse number="11" style="v" sid="MRK 3:11"/>Na bandu babaalobi moka baatu'i pai' kila pabaamweni Yesu kabau'bu'ya malobe, “Wenga nga wa Mwana wa Nnu'ngu'.” <verse eid="MRK 3:11"/><verse number="12" style="v" sid="MRK 3:12"/>Lakini Yesu ngagaamulisa kwa ukali' panga kanebannyu'waniye kwa bandu.<verse eid="MRK 3:12"/></para>
  <para style="s">Yesu asawa atumilwe ku'mi na abi'li'</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mat 10:1-4</ref>, <ref loc="LUK 6:12-16">Luk 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13"/>Yesu au'bwike kukitu'mbi', ngaakema bandu baapalike nabembe ngabannyendelya. <verse eid="MRK 3:13"/><verse number="14" style="v" sid="MRK 3:14"/>Ngaasawa bandu ku'mi na abi'li' nkati yabe, li'nga atame nabo na kwatuma ala, <verse eid="MRK 3:14"/><verse number="15" style="v" sid="MRK 3:15"/>na kwapeya uweso wo bi'nga moka. <verse eid="MRK 3:15"/><verse number="16" style="v" sid="MRK 3:16"/>Bai, ku'mi na abi'li' babaasaulilwe nga aba Simoni (ywaapeyilwe na Yesu lina lya Petili), <verse eid="MRK 3:16"/><verse number="17" style="v" sid="MRK 3:17"/>Yakobi na Yoani bana ba Zebedayo (Yesu aapei lina lya Boanerge lombolya kwake, “Bana ba njai”), <verse eid="MRK 3:17"/><verse number="18" style="v" sid="MRK 3:18"/>Andelea, Pilipi, Batolomayo, Matei, Tomasi, Yakobi mwana wa Alufayo, Tadei, Simoni wa kipi'nga sa Mazeloti na <verse eid="MRK 3:18"/><verse number="19" style="v" sid="MRK 3:19"/>Yuda Isikalioti yu'lu' ywaansongi Yesu.<verse eid="MRK 3:19"/></para>
  <para style="s">Yesu na Belisebuli</para>
  <para style="r">(<ref loc="MAT 12:22-32">Mat 12:22-32</ref>, <ref loc="LUK 11:14-23">Luk 11:14-23</ref>, <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20"/>Bu'kapo Yesu ayi'i kasake. Bandu bambone baatikongolekana kai', kwa kitumbu so ywembe na banamasi' bake baakombwili ata lya kilyo. <verse eid="MRK 3:20"/><verse number="21" style="v" sid="MRK 3:21"/>Bai, alongo bake pabaayu'wine makowe go ngabayenda kuntola kwa mwanjaa babayage panga ai na lilalu'.<verse eid="MRK 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22"/>Nabembe balimu ba salya babaabu'i ku Yelusalemu ngababaya, “Ai na Belisebuli! Agabi'nga moka kwa makakala ga mpi'ndo wa moka.” <verse eid="MRK 3:22"/><verse number="23" style="v" sid="MRK 3:23"/>Apo Yesu ngaakema na kwabakia kwa ngongo, “Ibilisi akombwabuli kwibi'nga mwene? <verse eid="MRK 3:23"/><verse number="24" style="v" sid="MRK 3:24"/>Mana ipangite utawala gumo ubaganike iku'ta iku'ta, utawala wo waalu'a kondali. <verse eid="MRK 3:24"/><verse number="25" style="v" sid="MRK 3:25"/>Kai' mana ipangite alongo bamo babaganike iku'ta iku'ta, ulongo wo waalu'a kondali. <verse eid="MRK 3:25"/><verse number="26" style="v" sid="MRK 3:26"/>Bai manaitei utawala wa Ibilisi ubaganike iku'ta iku'ta waalu'a kondali, na wayomoka.<verse eid="MRK 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27"/>“Lakini ntu'pu' mundu ywakombwa kuitangya nyumba ya mwene makakala na kumpokonywa mali yake, ila ipalikwa wi'ti' antabe aywo mundu mwene makakala, bu'kapo ngapaalu'a kombwa kumpokonywa ili'be yake.<verse eid="MRK 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28"/>“Kakape nimmakianga, bandu baasamilwanga masambi gabe goti na ata mayi'gi'yo gabe ga kupulu, <verse eid="MRK 3:28"/><verse number="29" style="v" sid="MRK 3:29"/>lakini ywalongela maakau kwa Loo Mpeleteu, asamilwali katu, aywo ai na ukumu ya sambi yangayomoka.” <verse eid="MRK 3:29"/><verse number="30" style="v" sid="MRK 3:30"/>(Yesu aalongei go kwa kitumbu baabile kababaya panga, “Ai na moka.”)<verse eid="MRK 3:30"/></para>
  <para style="s">Mau' na anunabe Yesu</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mat 12:46-50</ref>, <ref loc="LUK 8:19-21">Luk 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31"/>Mau' bake Yesu na anunabe baaikite palu', ngabayi'ma panja na kuntuma mundu yenda kunkema. <verse eid="MRK 3:31"/><verse number="32" style="v" sid="MRK 3:32"/>Bandu bambone baatami po kabanti'li'ta. Bai, ngabammakia, “Lola, mau' bako na anunabo bai panja, bapala kukubona.” <verse eid="MRK 3:32"/><verse number="33" style="v" sid="MRK 3:33"/>Yesu ngaayangwa, “Mau' bangu' na anunangu' nga kinyai?” <verse eid="MRK 3:33"/><verse number="34" style="v" sid="MRK 3:34"/>Apo ngaalola bandu babanti'li'tike kabaya, “Lolange, mwenga nga mwakina mau' bangu' na mwakina nnunangu'! <verse eid="MRK 3:34"/><verse number="35" style="v" sid="MRK 3:35"/>Mundu ywoywoti ywapanga gapala Nnu'ngu', aywo nga nku'lwangu', nnu'mbwangu' na mau' bangu'.”<verse eid="MRK 3:35"/></para>
  <chapter eid="MRK 3"/>
  <chapter number="4" style="c" sid="MRK 4"/>
  <para style="s">Lukongo lwa mpandi</para>
  <para style="r">(<ref loc="MAT 13:1-9">Mat 13:1-9</ref>, <ref loc="MAT 8:4-8">8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1"/>Yesu atumbwi yi'gana kai' abile mbwega ya litanda liku'lu' lya Galilaya. Lipi'nga liku'lu' lya bandu baakongolekine papipi nakwe, kwa nyo ngayingya mungalaba no tama. Bandu boti ngababa batami kuuyu'mu', mbwega ya litanda liku'lu'. <verse eid="MRK 4:1"/><verse number="2" style="v" sid="MRK 4:2"/>Yesu aayi'ganie makowe gambone kwa ngongo, na mumayi'gano gake aabakiye, <verse eid="MRK 4:2"/><verse number="3" style="v" sid="MRK 4:3"/>“Mupi'kaniange! Mpandi yumo aayi'i panda mbeyu. <verse eid="MRK 4:3"/><verse number="4" style="v" sid="MRK 4:4"/>Paabile kamisa, mbeyu yi'ngi' yaatu'mbu'ki mundi'la na iyuni ngabaisa sonywa. <verse eid="MRK 4:4"/><verse number="5" style="v" sid="MRK 4:5"/>Yi'ngi' yaatu'mbu'ki pamaliwe pangali ukando wambone, mbeyu yo yasi'yiteli balika kwa mwanjaa ukando wo wayendekiyeli. <verse eid="MRK 4:5"/><verse number="6" style="v" sid="MRK 4:6"/>Lilumu palyaibalile muno mitombo yo ngaiyu'ma, kwa mwanjaa ngi'ga yake yatotili mubwi'. <verse eid="MRK 4:6"/><verse number="7" style="v" sid="MRK 4:7"/>Yi'ngi' yaatu'mbu'ki pakatikati ya mimimwa, na mimimwa yaatiku'la na mitombo ngaitola kikolo mpaka yaakombwili yela. <verse eid="MRK 4:7"/><verse number="8" style="v" sid="MRK 4:8"/>Yi'ngi' yatu'mbu'ki paukando unannoga yaatibalika no ku'la no piya mauno, yimo nombo salasini, yimo sitini na yi'ngi' mya.” <verse eid="MRK 4:8"/><verse number="9" style="v" sid="MRK 4:9"/>Bu'kapo ngaabakia, “Mwene makutu go yu'wa na ayu'we!”<verse eid="MRK 4:9"/></para>
  <para style="s">Mabinio ga ngongo</para>
  <para style="r">(<ref loc="MAT 13:10-17">Mat 13:10-17</ref>, <ref loc="LUK 8:9-10">Luk 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10"/>Pabaabile kisabe, banamasi' ku'mi na abi'li' ba Yesu, pamope na bandu babaabile mbwega yake, ngabannaluya mwailombolya ngongo yi'lu'. <verse eid="MRK 4:10"/><verse number="11" style="v" sid="MRK 4:11"/>Naywembe ngaabakia, “Mwenga muyaliwite kugatanga makowe gangaumukulilwa ga Ukulungwa wa Nnu'ngu', lakini balu' bababile panja babakiyilwa kila kili'be kwa ngongo, <verse eid="MRK 4:11"/><verse number="12" style="v" sid="MRK 4:12"/>li'nga</para>
  <para style="q1" vid="MRK 4:12">‘Kakape balole, lakini babonali.</para>
  <para style="q2" vid="MRK 4:12">Kakape bayu'we, lakini bakwipwali.</para>
  <para style="q1" vid="MRK 4:12">Mana buli bakanng'alambukya Nnu'ngu',</para>
  <para style="q2" vid="MRK 4:12">naywembe alu'e kwasamya.’”<verse eid="MRK 4:12"/></para>
  <para style="s">Yesu aawanikia lukongo lwa mpandi</para>
  <para style="r">(<ref loc="MAT 13:18-23">Mat 13:18-23</ref>, <ref loc="LUK 8:11-15">Luk 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13"/>Bai Yesu ngaalaluya, “Buli, mwenga munatangali lukongo lu'no? Mwakombwabuli tanga lukongo lwi'ngi'? <verse eid="MRK 4:13"/><verse number="14" style="v" sid="MRK 4:14"/>Mpandi apanda liyi'gi'yo lya Nnu'ngu'. <verse eid="MRK 4:14"/><verse number="15" style="v" sid="MRK 4:15"/>Mbeyu yaitu'mbu'ki mundi'la nga kati bandu babaliyu'wa liyi'gi'yo lya Nnu'ngu', lakini popopo Ibilisi endaisa na kulibu'ya liyi'gi'yo li'lu' lyalipandilwe nkati yabe. <verse eid="MRK 4:15"/><verse number="16" style="v" sid="MRK 4:16"/>Bandu bi'ngi' nga kati mbeyu yaipandilwe pa maliwe. Pabaliyu'wa liyi'gi'yo lyo bai, balipokya kwo napusika. <verse eid="MRK 4:16"/><verse number="17" style="v" sid="MRK 4:17"/>Lakini liyingilikali no bi'ka ngi'ga nkati yabe, balikamwa kwa masu'ba masene bai, na mana kupitike tabu au ngu'su'mbu' kwa kitumbu sa liyi'gi'yo lyo, popopo baileka imani. <verse eid="MRK 4:17"/><verse number="18" style="v" sid="MRK 4:18"/>Bandu bi'ngi' nga kati mbeyu yaitu'mbu'ki pamimimwa. Nga kati balu' babaliyu'wa liyi'gi'yo lyo, <verse eid="MRK 4:18"/><verse number="19" style="v" sid="MRK 4:19"/>lakini bembe bagania muno makowe ga padunia yi'no, bautilwa no minyikia mali na tamaa mbali'mbali'. Ago goti ngagalipanga li'lu' liyi'gi'yo likombale no pu'ngwa makakala go panga kasi. <verse eid="MRK 4:19"/><verse number="20" style="v" sid="MRK 4:20"/>Lakini bi'ngi' nga kati mbeyu yaipandilwe muukando nnogau. Aba nga babaliyu'wa liyi'gi'yo, ngabalipokya no piya mauno. Bi'ngi' salasini, bi'ngi' sitini na bi'ngi' mya.”<verse eid="MRK 4:20"/></para>
  <para style="s">Lukongo lwa kimuli sakiwi'ki'lilwe</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luk 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21"/>Yesu ngayendelya kwabakia, “Buli, bandu bakoya kimuli nnyumba na kukiwi'ki'lya kitu'ndu' au kukibi'ka mmu'ngu'? Lili! Ila bakibi'ka papatu'ndu'bile. <verse eid="MRK 4:21"/><verse number="22" style="v" sid="MRK 4:22"/>Bai, kila sakiiyilwe salu'a bonekana, sakiwi'ki'lilwe salu'a umukulwa. <verse eid="MRK 4:22"/><verse number="23" style="v" sid="MRK 4:23"/>Mwene makutu go yu'wa, na ayu'we!”<verse eid="MRK 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24"/>Ngaabakia kai', “Mupi'kani wiso! Kili'ngo si'si'lu'si'lu' samwali'ngya bandu bi'ngi' nga samwalu'a li'ngi'lwa kai' no yongekeyelwa. <verse eid="MRK 4:24"/><verse number="25" style="v" sid="MRK 4:25"/>Ywabile na kili'be alu'a yongekeyelwa, ywangali kili'be ata si'lu' sabile naso saatolelwa.”<verse eid="MRK 4:25"/></para>
  <para style="s">Lukongo lwa mbeyu yaibalika</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26"/>Yesu ngayendelya longela, “Ukulungwa wa Nnu'ngu' ulandana na mundu ywapandike mbeyu munng'unda. <verse eid="MRK 4:26"/><verse number="27" style="v" sid="MRK 4:27"/>Masu'ba goti endegonja no yumuka na mbeyu yatibalika no ku'la. Lakini atangiteli panga ipangikabuli. <verse eid="MRK 4:27"/><verse number="28" style="v" sid="MRK 4:28"/>Ukando ngawipangia mitombo ku'la no piya yeyo. Ilongolya wi'ti' ipuka lyakapi, bu'kapo seyo na kuundi'la lunombo museyo. <verse eid="MRK 4:28"/><verse number="29" style="v" sid="MRK 4:29"/><figure style="fig" alt="Harvesting wheat" file="12 Sickle.jpg" size="col" ref="4:29">Kauna ngano</figure>Nombo yo mana ikelile, apo mundu atumbwa una kwa mwanjaa nsimu wo una wikite.”<verse eid="MRK 4:29"/></para>
  <para style="s">Lukongo lwa mbeyu ya aladali</para>
  <para style="r">(<ref loc="MAT 13:31-32">Mat 13:31-32</ref>,<ref loc="MAT 13:34">34</ref>, <ref loc="LUK 13:18-19">Luk 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30"/>Kai' Yesu ngabaya, “Ukulungwa wa Nnu'ngu' tuulandanie na ki'li'? Tuuawanikiye kati lukongo gani? <verse eid="MRK 4:30"/><verse number="31" style="v" sid="MRK 4:31"/>Ubile kati mbeyu ya aladali, mwaibile njene kulikoni mbeyu yi'ngi' yoyoti. <verse eid="MRK 4:31"/><verse number="32" style="v" sid="MRK 4:32"/>Lakini mana upandilwe no balika, upanga nkongo nku'lu'. Ndambi' yake ipanga ngu'lu' ata kiiyuni bendakombwa senga iyumba yabe mumwili wake.”<verse eid="MRK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33"/>Yesu aalongei na bandu mayi'gi'yo gake kwa ngongo yi'ngi' yambone yaibile kati yo, bu'kana na mwabakombwi yu'wa. <verse eid="MRK 4:33"/><verse number="34" style="v" sid="MRK 4:34"/>Aalongeili nabo sosoti wangali tumya ngongo, lakini paabile na banamasi' bake bai aabile kaawanikia kila kili'be.<verse eid="MRK 4:34"/></para>
  <para style="s">Yesu aamulisa kimbu'nga kikotoke</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mat 8:23-27</ref>, <ref loc="LUK 8:22-25">Luk 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35"/>Lisu'ba lyolyolyo kitamwiyo, Yesu ngaabakia banamasi' bake, “Tuloke litanda liku'lu' tuyende kwiyi'.” <verse eid="MRK 4:35"/><verse number="36" style="v" sid="MRK 4:36"/>Bai, ngabalileka lipi'nga li'lu' lya bandu na kumpu'twa Yesu mungalaba yaabile. Na mangalaba gi'ngi' gaatikunki'ngama. <verse eid="MRK 4:36"/><verse number="37" style="v" sid="MRK 4:37"/><figure style="fig" alt="Boat in a storm" file="09 Boat in Storm.jpg" size="col" ref="4:37">Kimbu'nga na ngalaba</figure>Kimbu'nga kikali' satumbwi pukatya, mawi'mbi' ngagaiku'mbwa yi'lu' ngalaba na ngaitumbwa twi'lya masi'. <verse eid="MRK 4:37"/><verse number="38" style="v" sid="MRK 4:38"/>Yesu aabile nsu'gu' ya ngalaba, agonjike no yegekya ntwe wake pakiyegekyo. Bai, banamasi' ngabannyumuya na kummakia, “Mwalimu, utangite panga twenga twendawaa?” <verse eid="MRK 4:38"/><verse number="39" style="v" sid="MRK 4:39"/>Bai, ngayumuka ngaukalipya gu'lu' nsunga na kugaamulisa mawi'mbi', “Tama liki! Tu'ya!” Apo kimbu'nga ngakikotoka no tama liki. <verse eid="MRK 4:39"/><verse number="40" style="v" sid="MRK 4:40"/>Bu'kapo Yesu ngaabakia banamasi' bake, “Mboni mwendayogopa? Buli, ntu'pu' imani?” <verse eid="MRK 4:40"/><verse number="41" style="v" sid="MRK 4:41"/>Nabembe ngabayogopa muno, ngababa kabalaluyana, “Ayu' nga nyai, ata nsunga na mawi'mbi' gendakunnyu'wa?”<verse eid="MRK 4:41"/></para>
  <chapter eid="MRK 4"/>
  <chapter number="5" style="c" sid="MRK 5"/>
  <para style="s">Yesu abi'nga moka kwa mundu</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mat 8:28-34</ref>, <ref loc="LUK 8:26-39">Luk 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1"/>Bai, ngabaika munni'ma wa Agelasi, kwiyi' ya litanda liku'lu'. <verse eid="MRK 5:1"/><verse number="2" style="v" sid="MRK 5:2"/>Yesu paaulwike bai mungalaba, popopo ngakwembana nakwe mundu yumo ywaalobi moka aumi kumasiko. <verse eid="MRK 5:2"/><verse number="3" style="v" sid="MRK 5:3"/>Mundu ywo atamage kumasiko na ntu'pu' mundu ywaakombwi kuntaba, ata kwa nyololo. <verse eid="MRK 5:3"/><verse number="4" style="v" sid="MRK 5:4"/>Baatikuntaba mundu ywo kwa pingwi na minyololo, lakini kila pabantaba, aatikwikutwana minyololo yo na kwiti'kwana pingwi yo, wala ntu'pu' mundu ywaakombwi kunkanikiya. <verse eid="MRK 5:4"/><verse number="5" style="v" sid="MRK 5:5"/>Kilo na muntwekati atamage kumasiko na muitu'mbi' kakemelya na kwitema kwa maliwe.<verse eid="MRK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6"/>Paamweni Yesu kwa kuutalu, aatikummutukya no kilikita nnu'ngi' yake <verse eid="MRK 5:6"/><verse number="7" style="v" sid="MRK 5:7"/>kalongela kwa lilobe liku'lu', “Ubile na ki'li' nanenga, wenga wa Yesu, Mwana wa Nnu'ngu' ywabile panani ya ili'be yoti. Kwa lina lya Nnu'ngu' nikulu'ba kaneuniku'su'mbwe!” <verse eid="MRK 5:7"/><verse number="8" style="v" sid="MRK 5:8"/>(Aalongei nyo kwa mwanjaa Yesu ammakie, “Moka, mmu'ke mundu yu'.”)<verse eid="MRK 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9"/>Yesu ngannaluya, “Lina lyako wanyai?” Naywembe ngayangwa, “Lina lyangu' na ‘Yesi,’ lombolya twenga twabambone.” <verse eid="MRK 5:9"/><verse number="10" style="v" sid="MRK 5:10"/>Bu'kapo ngannu'ba Yesu panga kaneagabi'nge moka go munni'ma gu'lu'.<verse eid="MRK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11"/>Na palu' pakitu'mbi' sa papipi paabile na lipi'nga lya magu'be kabaipalya ilyo. <verse eid="MRK 5:11"/><verse number="12" style="v" sid="MRK 5:12"/>Bai, ago moka ngagannu'ba panga, “Utuyi'ki'ti'e li'nga tukaayingi balu' magu'be.” <verse eid="MRK 5:12"/><verse number="13" style="v" sid="MRK 5:13"/>Naywembe ngagayi'ki'ti'ya. Bai, galu' moka ngagabu'ka kwa yu'lu' mundu no yingya kwa magu'be. Magu'be gagaabile elupu ibi'li' gaaeli pakitu'mbi' mpaka pa litanda liku'lu', ngagatumbukya mumasi' no swikya.<verse eid="MRK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14"/>Asungi ba galu' magu'be baatitila, ngabaliyaulya likowe lyo mukilambo na mumigunda. Bandu ngabaisa lola gagaapitike. <verse eid="MRK 5:14"/><verse number="15" style="v" sid="MRK 5:15"/>Ngabannyendelya Yesu, ngabammona na mundu yu'lu' ywaabile alobi moka atami, aweti ngu'bo na malango gake ganki'li'bu'kile, ngabayogopa. <verse eid="MRK 5:15"/><verse number="16" style="v" sid="MRK 5:16"/>Bandu babaalibweni likowe lyo, ngabaawanikia bi'ngi' makowe gagampatike aywo mundu ywaalobi moka na abali ya galu' magu'be. <verse eid="MRK 5:16"/><verse number="17" style="v" sid="MRK 5:17"/>Bai ngabatumbwa kunnu'ba abu'ke munni'ma wabe.<verse eid="MRK 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18"/>Yesu paabile kau'bu'ka mungalaba, yu'lu' mundu ywaalobi moka ngannu'ba balongwane. <verse eid="MRK 5:18"/><verse number="19" style="v" sid="MRK 5:19"/>Lakini Yesu aatikunkania. Paali pake ngammakia, “Uyende kaya kwa alongobo, ukabakiye makowe goti Bwana gakupangile na mwakubi'ki kiya.” <verse eid="MRK 5:19"/><verse number="20" style="v" sid="MRK 5:20"/>Bai, mundu ywo ngayenda awanikia akwo Dekapoli makowe goti gaapangilwe na Yesu, na bandu boti baatisangala.<verse eid="MRK 5:20"/></para>
  <para style="s">Biti Yailo na nnwawa yumo bendayu'yu'ki'lwa</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mat 9:18-26</ref>, <ref loc="LUK 8:40-56">Luk 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21"/>Yesu aloki kai' liyi' li'ngi' lya litanda liku'lu' lya Galilaya kwa ngalaba. Lipi'nga lya bandu ngalikongolekana nnu'ngi' yake, naywembe abile ayi'mi mbwega ya litanda liku'lu'. <verse eid="MRK 5:21"/><verse number="22" style="v" sid="MRK 5:22"/>Bu'kapo ngaisa mundu yumo nku'lu' ywa nyumba ya kunnu'ba Nnu'ngu' ywakemelwage Yailo. Paamweni Yesu, ngaitaikulya nnu'ngi' yake, <verse eid="MRK 5:22"/><verse number="23" style="v" sid="MRK 5:23"/>nganku'ku'li'kya kabaya, “Biti wangu' nsene endakomya. Sondesonde nikulu'ba tubu'ke ukammi'ki moko gako li'nga ayu'yu'ki'lwe no lama.” <verse eid="MRK 5:23"/><verse number="24" style="v" sid="MRK 5:24"/>Bai, Yesu ngayenda pamope nakwe. Bandu baingi baatikunki'ngama na ngababa kabapatigana kila pandu.<verse eid="MRK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25"/>Na nkati yabe kwabile na nnwawa yumo mwene utamwe wa nkongomokwa kwa myaka ku'mi na ibi'li'. <verse eid="MRK 5:25"/><verse number="26" style="v" sid="MRK 5:26"/>Nnwawa ywo aatiauka muno kwo yenda kwa mapundi bambone. Pamope no panga aatumi mali yake yoti, ayu'yu'kilweli ila ayendeli minya muno. <verse eid="MRK 5:26"/><verse number="27" style="v" sid="MRK 5:27"/>Paayu'wine abali ya Yesu, nnwawa ywo aatiisa no yingya pakatikati ya lipi'nga lya bandu kusu'gu' ya Yesu no kunywa ngu'bo yake. <verse eid="MRK 5:27"/><verse number="28" style="v" sid="MRK 5:28"/>Aapangite nyo kwa mwanjaa aabaite pamwoyo wake panga, “Mana nikunywile ngu'bo ya Yesu bai, nalu'a yu'yu'ki'lwa.”<verse eid="MRK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29"/>Popopo nkongomokwa wake ngauyu'ma na ngaibona payi'ga yake panga payu'yu'kilwe. <verse eid="MRK 5:29"/><verse number="30" style="v" sid="MRK 5:30"/>Popopo Yesu ngakwipwa panga makakala gaammu'i. Bai ngaligalambukya li'lu' lipi'nga lya bandu, ngalaluya, “Nyai ywakunywi ngu'bo yangu'?” <verse eid="MRK 5:30"/><verse number="31" style="v" sid="MRK 5:31"/>Banamasi' bake ngabannyangwa, “Wendakwabona bandu mwabakupapania! Mbona ulaluya nyai ywakukunywile?” <verse eid="MRK 5:31"/><verse number="32" style="v" sid="MRK 5:32"/>Lakini Yesu ayendeli linga, li'nga ammone nyai ywapangite nyo. <verse eid="MRK 5:32"/><verse number="33" style="v" sid="MRK 5:33"/>Apo yu'lu' nnwawa atangite gagampatike, ngapitya kwo lendema kayogopa, ngaitaikulya nnu'ngi' ya Yesu no baya ukakape woti. <verse eid="MRK 5:33"/><verse number="34" style="v" sid="MRK 5:34"/>Yesu ngammakia, “Biti, imani yako ikutepwile. Uyende kwa amani, utamwe wako uyu'yu'kilwe.”<verse eid="MRK 5:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35"/>Yesu paabile balo kalongela, bandu baaisi bu'ka kunyumba ya Yailo, ngabammakia, “Biti wako ayomwike. Kwa buli uyendelya kumwauya mwalimu?” <verse eid="MRK 5:35"/><verse number="36" style="v" sid="MRK 5:36"/>Lakini Yesu api'kanili mayi'gi'yo gabe, ngammakia Yailo, “Kaneuyogope, uu'bi'li bai.” <verse eid="MRK 5:36"/><verse number="37" style="v" sid="MRK 5:37"/>Wala annyi'ki'tiyeli mundu ywoywoti longwana nakwe ila Petili, Yakobi na Yoani nnunawe.<verse eid="MRK 5:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 5:38"/>Pabaaikite kunyumba yake, Yesu ngayu'wa ndu'ti, kili'lo no lombola muno. <verse eid="MRK 5:38"/><verse number="39" style="v" sid="MRK 5:39"/>Ngayingya nnyumba ngaabakia, “Mboni mupanga ndu'ti no li'la? Biti anawaali ila atigonja bai.” <verse eid="MRK 5:39"/><verse number="40" style="v" sid="MRK 5:40"/>Bembe ngabamweka kwa kunsalawa. Bai ngaabi'ngya panja boti, ngaatola abelei ba yu'lu' biti na balu' banamasi' bake yingya ku'lu' kuswi kwaabile aywo biti. <verse eid="MRK 5:40"/><verse number="41" style="v" sid="MRK 5:41"/>Bu'kapo ngankamwa luboko, ngammakia, “Talita, koumu,” lombolya kwake, “Biti, nikubakia, uyumuke!” <verse eid="MRK 5:41"/><verse number="42" style="v" sid="MRK 5:42"/>Popopo biti ywo ngayi'ma, tumbwa tyanga. (Aabile ywa nng'elo wa myaka ku'mi na ibi'li'.) Apo bandu baatisangala pi'ta. <verse eid="MRK 5:42"/><verse number="43" style="v" sid="MRK 5:43"/>Yesu ngaaking'indya kanebammakie mundu likowe lyo. Bu'kapo ngaabakia bampei kilyo aywo biti.<verse eid="MRK 5:43"/></para>
  <chapter eid="MRK 5"/>
  <chapter number="6" style="c" sid="MRK 6"/>
  <para style="s">Yesu endakanilwa akwo ku Nasaleti</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mat 13:53-58</ref>, <ref loc="LUK 4:16-30">Luk 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1"/>Apo Yesu ngabu'ka akwo, buyangania kukilambo sake sa ku Nasaleti pamope na banamasi' bake. <verse eid="MRK 6:1"/><verse number="2" style="v" sid="MRK 6:2"/>Paliikite lisu'ba lya Sabato ya Ayahudi, ngatumbwa yi'gana munyumba ya kunnu'ba Nnu'ngu', na bandu baingi pabannyu'wine baatisangala. Nabembe ngabalaluya, “Mundu yu' apatike kwaku' makowe aga goti? Ayi' ilimu yatumya ya sampuli yaku'? Kwa makakala gani apanga mangelongelo goti ga? <verse eid="MRK 6:2"/><verse number="3" style="v" sid="MRK 6:3"/>Buli, kanga yu'lu' selemala li, mwana wa Malia? Na alongobe nga Yakobi, Yose, Yuda na Simoni au lili? Akina alu'mbu'be boti babileli na twenga pano?” Nabembe ngabausika muno kwa kitumbu sake, ngabakana kumwu'bi'lya.<verse eid="MRK 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4"/>Yesu ngaabakia, “Nnondoli ywa Nnu'ngu' endaisimilwa kila pandu, lakini munni'ma wake na panyumba yake aisimilwali!”<verse eid="MRK 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5"/>Kwa nyo, Yesu aakombwili panga mangelongelo, ila aabi'ki maboko atamwe asene na kwatepwa. <verse eid="MRK 6:5"/><verse number="6" style="v" sid="MRK 6:6"/>Naywembe ngasangala muno kwa kitumbu sa bembe kotoka baa na imani ata pasene.</para>
  <para style="s" vid="MRK 6:6">Yesu atuma banamasi' ku'mi na abi'li'</para>
  <para style="r" vid="MRK 6:6">(<ref loc="MAT 10:5-15">Mat 10:5-15</ref>, <ref loc="LUK 9:1-6">Luk 9:1-6</ref>)</para>
  <para style="p" vid="MRK 6:6">Bu'kapo Yesu aityangili ilambo ya palu' papipi, kaayi'gana bandu. <verse eid="MRK 6:6"/><verse number="7" style="v" sid="MRK 6:7"/>Ngaakema balu' banamasi' ku'mi na abi'li', ngatumbwa kwatuma abi'li' abi'li' na kwapeya uweso wo bi'nga moka. <verse eid="MRK 6:7"/><verse number="8" style="v" sid="MRK 6:8"/>Ngaalagya panga, “Mumwanja winu kanemutole kili'be sosoti ila pimbo bai. Kanemutole likati wala utingo, wala mbanje muiwindu yinu. <verse eid="MRK 6:8"/><verse number="9" style="v" sid="MRK 6:9"/>Muwalange ilatu, lakini kanemupu'twe nganju yo galambwa.” <verse eid="MRK 6:9"/><verse number="10" style="v" sid="MRK 6:10"/>Kai' ngaabakia, “Nyumba yoyoti yabaalu'a kunkemya, mwaatame po mpaka pamwaalu'a bu'ka pandu po. <verse eid="MRK 6:10"/><verse number="11" style="v" sid="MRK 6:11"/>Na pandu popoti pabaalu'a kotoka kunkemya au kumpi'kanianga, mwaabu'ke po no kung'unda lyu'ku'mbi' mumagu'lu' ginu, kati kwakwi'li'ka panga Nnu'ngu' endakana.” <verse eid="MRK 6:11"/><verse number="12" style="v" sid="MRK 6:12"/>Kwa nyo ngababu'ka no ala panga bandu boti bapalikwa galambuka na kugaleka masambi gabe. <verse eid="MRK 6:12"/><verse number="13" style="v" sid="MRK 6:13"/>Ngababi'nga moka maingi no tepwa atamwe baingi kwa kwapakaya mauta.<verse eid="MRK 6:13"/></para>
  <para style="s">Kiwo sa Yoani Ywabatisage</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mat 14:1-12</ref>, <ref loc="LUK 9:7-9">Luk 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14"/>Bai, Nkulungwa Helode ngayu'wa abali yo, kwa mwanjaa lina lya Yesu lyaabile liyu'wanike lwingo lwoti. Bi'ngi' babe baabile kababaya, “Yoani Ywabatisage atiyu'ka bu'ka kuuwi'li, nga kitumbu sa makakala ga gagapanga kasi nkati yake.” <verse eid="MRK 6:14"/><verse number="15" style="v" sid="MRK 6:15"/>Bi'ngi' baabaite, “Mundu yu' nga Elia.” Bi'ngi' baabaite, “Ayu' nga nnondoli ywa Nnu'ngu' kati alondoli bi'ngi' ba kwai'mbu'.”<verse eid="MRK 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16"/>Lakini Helode paayu'wine abali yi', ngabaya, “Ayu' nga Yoani Ywabatisage, ywanaansinjite, atiyu'ka bu'ka kuuwi'li.”<verse eid="MRK 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17"/>Helode aapiyite amuli ya kummoywa Yoani na kummi'ka munyumba ya atabilwe. Aapangite nyo kwa kitumbu sa Helode kunkobeka Helodia ywaabile nnyumbo wa Pilipi nku'we. <verse eid="MRK 6:17"/><verse number="18" style="v" sid="MRK 6:18"/>Yoani ammakie Helode panga, “Mwilo wenga kunkobeka nnwawa ywaakobekilwe na nku'go.”<verse eid="MRK 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19"/>Bai Helodia ngaansukya muno Yoani, ngapala kummulaga lakini aakombwili, <verse eid="MRK 6:19"/><verse number="20" style="v" sid="MRK 6:20"/>Helode aannyogwipe Yoani kwa mwanjaa aatangite panga ywembe mundu mwene aki na mpeleteu, kwa nyo ngaani'ndi'la. Helode pannyu'wine Yoani, aatiauka muno pamope no panga aapulaike kumpi'kania.<verse eid="MRK 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21"/>Bai, lisu'ba limo Helodia aapatike ndi'la ya kummulaga Yoani. Lisu'ba lyo lyabile lya si'li'ku'si'li'ku' ya ngu'mbu'ku'mbu' yo belekwa kwa Helode, na Helode aakemite ayi'mi'li'ki bake, api'ndo ba asikali na api'ndo ba nkoa wa Ku Galilaya. <verse eid="MRK 6:21"/><verse number="22" style="v" sid="MRK 6:22"/>Biti wake Helodia payingile, aatiina, ngampulaisa Helode pamope na ageni bake. Nkulungwa Helode ngammakia yu'lu' biti, “Unilu'be kili'be sosoti saupala, nanenga nilu'a kupeya.” <verse eid="MRK 6:22"/><verse number="23" style="v" sid="MRK 6:23"/>Kai' ngakong'ondelya kwo lapa panga, “Nilu'a kupeya sosoti saulu'a nilu'ba, ata ikatei nusu ya ukulungwa wangu'.”<verse eid="MRK 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24"/>Yu'lu' biti ngapita panja, ngayenda kwalaluya mau' bake, “Nilu'be ki'li'?” Mau' bake ngannyangwa, “Ulu'be ntwe wa Yoani Ywabatisage.” <verse eid="MRK 6:24"/><verse number="25" style="v" sid="MRK 6:25"/>Yu'lu' biti ngaki'li'bu'ka kiyu'ngu'ya kwa nkulungwa, ngammakia, “Nipala unipei papanopano ntwe wa Yoani Ywabatisage mukyani.”<verse eid="MRK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26"/>Nkulungwa nganyopa muno, lakini kwa mwanjaa aabile alapite nnu'ngi' ya ageni bake, aapaili kunkania. <verse eid="MRK 6:26"/><verse number="27" style="v" sid="MRK 6:27"/>Papalu'palu' nkulungwa ngatuma asikali leta ntwe wa Yoani. Ngayenda kunsinja Yoani munyumba ya atabilwe, <verse eid="MRK 6:27"/><verse number="28" style="v" sid="MRK 6:28"/>ngauleta ntwe mukyani na kumpeya yu'lu' biti, naywembe ngaakamukiya mau' bake. <verse eid="MRK 6:28"/><verse number="29" style="v" sid="MRK 6:29"/>Banamasi' ba Yoani pabapatike abali, ngabayenda tola yi'ga yake no yenda sika.<verse eid="MRK 6:29"/></para>
  <para style="s">Yesu aapeya kilyo bandu babapi'ta elupu tano</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mat 14:13-21</ref>, <ref loc="LUK 9:10-17">Luk 9:10-17</ref>, <ref loc="JHN 6:1-14">Yoa 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30"/>Balu' banamasi' baabuyangani kwa Yesu na kumpeya abali ya makowe goti gabaapangite no yi'gana. <verse eid="MRK 6:30"/><verse number="31" style="v" sid="MRK 6:31"/>Bai, bandu bambone baabile kabaisa no bu'ka, kwa nyo Yesu na banamasi' bake baapatikeli ata lipala lyo lya. Na po Yesu ngaabakia banamasi' bake panga, “Mwisange, tubu'ke pandu pakiyi'ki'ya tukapu'mu'li pasene.” <verse eid="MRK 6:31"/><verse number="32" style="v" sid="MRK 6:32"/>Kwa nyo ngababu'ka kwa ngalaba bembe kisabe, yenda pandu pakiyi'ki'ya.<verse eid="MRK 6:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33"/>Lakini bandu baingi pabaabweni kababu'ka, ngabaakwipwa, nabembe ngabayenda kiyu'ngu'ya kwa magu'lu' bu'ka muilambo yoti, na abo bandu ngabalongolya ika. <verse eid="MRK 6:33"/><verse number="34" style="v" sid="MRK 6:34"/>Ngalaba paiikite kumbwani, Yesu alibweni lipi'nga liku'lu' lya bandu, ngaalibi'kya kiya kwa mwanjaa lyaabile kati ngondolo bangali nsungi. Ngatumbwa kwayi'gana makowe gambone. <verse eid="MRK 6:34"/><verse number="35" style="v" sid="MRK 6:35"/>Ata palyabile lisu'ba kalipilya, banamasi' bake Yesu baatikunnyendelya na kummakia, “Pandu pano palupu'ngu'ti' sika na lisu'ba lipilile, <verse eid="MRK 6:35"/><verse number="36" style="v" sid="MRK 6:36"/>nantali waalage bandu ba li'nga bayende kumigunda na kumisengo ya papipi bakapi'me ilyo.” <verse eid="MRK 6:36"/><verse number="37" style="v" sid="MRK 6:37"/>Lakini Yesu ngaabakia, “Mwapei ilyo mwenga.” Nabembe ngabannaluya, “Buli, tukapi'me makati kwa mbanje dinali mya ibi'li', na kwapeya ilyo?” <verse eid="MRK 6:37"/><verse number="38" style="v" sid="MRK 6:38"/>Yesu ngaalaluya, “Mubile na makati gali'nga? Muyende mukalinge.” Pabalingite, ngabammakia, “Kubile na makati matano na omba abi'li'.”<verse eid="MRK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39"/>Bai Yesu ngaamulisa banamasi' bake baatamike pai' mumanyei bandu boti muiku'ta iku'ta. <verse eid="MRK 6:39"/><verse number="40" style="v" sid="MRK 6:40"/>Nabembe ngabatama muiku'ta iku'ta ya bandu mya na ya bandu amusini. <verse eid="MRK 6:40"/><verse number="41" style="v" sid="MRK 6:41"/>Bu'kapo Yesu ngagatola galu' makati matano na balu' omba abi'li', ngalola kunani no sukulu, ngagametwa makati na kwapeya banamasi' bake baabagane bandu. Na balu' omba abi'li' nyinyonyo aabagine boti. <verse eid="MRK 6:41"/><verse number="42" style="v" sid="MRK 6:42"/>Bandu boti baatilya no yukuta. <verse eid="MRK 6:42"/><verse number="43" style="v" sid="MRK 6:43"/>Nabembe banamasi' bake ngabakongwa makombo ga makati na omba, ngabatwi'li'ya itu'ndu' ku'mi na ibi'li'. <verse eid="MRK 6:43"/><verse number="44" style="v" sid="MRK 6:44"/>Isabu ya bandu babaalile makati yaabile analu'me elupu tano.<verse eid="MRK 6:44"/></para>
  <para style="s">Yesu atyanga panani ya masi'</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mat 14:22-33</ref>, <ref loc="JHN 6:15-21">Yoa 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45"/>Popopo, Yesu ngaabakia banamasi' bake bau'bu'ke mungalaba, bannongoli yenda Betisaida, kwiyi' ya litanda liku'lu', apo ywembe aabile kailaga ipi'nga ya bandu. <verse eid="MRK 6:45"/><verse number="46" style="v" sid="MRK 6:46"/>Bu'ka pa kwalaga balu' bandu, ngayenda kukitu'mbi' lu'ba Nnu'ngu'. <verse eid="MRK 6:46"/><verse number="47" style="v" sid="MRK 6:47"/>Pakupilile yi'lu' ngalaba yaabile iikite pakatikati ya litanda liku'lu', na Yesu aabile kisake kuuyu'mu'. <verse eid="MRK 6:47"/><verse number="48" style="v" sid="MRK 6:48"/>Ngaabona banamasi' bake kabaauka endelesa ngalaba yo, kwa mwanjaa nsunga waabile kawaaki'li'bu'ya nsu'gu'. Bai kakupala saa, Yesu ngaayendelya banamasi' bake katyanga panani ya masi'. Ngapala kwapi'ta, <verse eid="MRK 6:48"/><verse number="49" style="v" sid="MRK 6:49"/>lakini pabamweni katyanga panani ya masi', baganiyage panga lyoka, ngabakemelya, <verse eid="MRK 6:49"/><verse number="50" style="v" sid="MRK 6:50"/>kwa mwanjaa boti pabaamweni baatiyogopa. Apo Yesu ngaabakia, “Mukangamale! Nga nenga, kanemuyogope!” <verse eid="MRK 6:50"/><verse number="51" style="v" sid="MRK 6:51"/>Naywembe ngau'bu'ka nkati ya ngalaba, na wu'lu' nsunga ngautama liki. Nabembe ngabasangala muno, <verse eid="MRK 6:51"/><verse number="52" style="v" sid="MRK 6:52"/>kwa mwanjaa baabile banakwipwali kitumbu sa galu' mangelongelo ga makati. Malango gabe gaai ganayu'gu'kali.<verse eid="MRK 6:52"/></para>
  <para style="s">Yesu aatepwa atamwe ku'lu' Genesaleti</para>
  <para style="r">(<ref loc="MAT 14:34-36">Mat 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53"/>Ata pabayomwi loka, ngabaika kunni'ma wa Genesaleti no tabya ngalaba yabe mulipi'pi'li'. <verse eid="MRK 6:53"/><verse number="54" style="v" sid="MRK 6:54"/>Bu'ka po uluka mungalaba, popopo bandu ngabankwipwa Yesu. <verse eid="MRK 6:54"/><verse number="55" style="v" sid="MRK 6:55"/>Ngabayenda kiyu'ngu'ya muilambo yoti, no tumbwa kwapu'twa atamwe mumakai li'nga kwapeleka pandu popoti pabaayu'wine panga Yesu abile po. <verse eid="MRK 6:55"/><verse number="56" style="v" sid="MRK 6:56"/>Kila pandu Yesu paayi'i, ibe muilambo, mumisengo au mumigunda, bandu baabi'i atamwe babe mumasoko. Ngabannu'ba aayi'ki'ti'ye abo atamwe bakunywe ata mpembo wa ngu'bo yake. Na boti babaakunywile ngabatepulwa.<verse eid="MRK 6:56"/></para>
  <chapter eid="MRK 6"/>
  <chapter number="7" style="c" sid="MRK 7"/>
  <para style="s">Mimu ya kiu'ku'lu'</para>
  <para style="r">(<ref loc="MAT 15:1-9">Mat 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1"/>Mafalisayo na bi'ngi' ba balimu ba salya ya Musa babaabile babu'kite Yelusalemu ngabakongolekana nnu'ngi' ya Yesu. <verse eid="MRK 7:1"/><verse number="2" style="v" sid="MRK 7:2"/>Ngabaabona bi'ngi' ba banamasi' bake kabalya makati kwa maboko gangali uluwa kati mwaipalikwa na salya ya dini ya Ayahudi. <verse eid="MRK 7:2"/><verse number="3" style="v" sid="MRK 7:3"/>Saai kiku'balo kwa Mafalisayo na Ayahudi boti kwa mwanjaa bembe balyali kilyo wangali uluwa kwo kotea mimu ya api'ndo babe. <verse eid="MRK 7:3"/><verse number="4" style="v" sid="MRK 7:4"/>Pababuya kusoko bawesali lya wangali uluwa. Kai' kwina mimu yi'ngi' yambone yabakotea, kati gu'lwa ikombe, iteleko na yombo ya yu'ma.<verse eid="MRK 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5"/>Bai, Mafalisayo na balimu ba salya ngabannaluya Yesu panga, “Mwanjaa namani banamasi' bako bakotali mimu ya api'ndo bitu? Balya kilyo wangali uluwa maboko!” <verse eid="MRK 7:5"/><verse number="6" style="v" sid="MRK 7:6"/>Yesu ngaayangwa, “Nnondoli ywa Nnu'ngu' Isaya alongei makowe ga kakape paalondwi kwa abali yinu mwenga, mwenga mwaanapiki. Kati mwaandike,</para>
  <para style="q1" vid="MRK 7:6">‘Nnu'ngu' abaya, bandu ba baniisimu kwa mikano bai</para>
  <para style="q2" vid="MRK 7:6">lakini mumyoyo yabe babile kuutalu nanenga.<verse eid="MRK 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7"/>Kunikilikitya kwabe kupwaikali</para>
  <para style="q2" vid="MRK 7:7">kwa mwanjaa malagyo gabagayi'gana ga Nnu'ngu' li, ila ga bandu bai.’<verse eid="MRK 7:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="MRK 7:8"/>Mwenga mwiileka amuli ya Nnu'ngu' no kamuliya mimu ya bandu.”<verse eid="MRK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9"/>Yesu ngayendelya baya, “Mwenga mubile na ndi'la inannoga yo kana kamwa amuli ya Nnu'ngu' li'nga mupate kamwa mimu yinu. <verse eid="MRK 7:9"/><verse number="10" style="v" sid="MRK 7:10"/>Mwanjaa Musa aabaite, ‘Waisimu tati' bako na mau' bako,’ na, ‘Ywoywoti ywaatukana tati' bake au mau' bake apalikwa bulagilwa.’ <verse eid="MRK 7:10"/><verse number="11" style="v" sid="MRK 7:11"/>Lakini mwenga mubaya panga mundu abe na kili'be sa kwayangatia abelei bake, lakini mana ammakie panga kili'be si'lu' sa ‘Kobane’, (lombolya kipiyilwe panga salaka mbeletau kwa Nnu'ngu'), <verse eid="MRK 7:11"/><verse number="12" style="v" sid="MRK 7:12"/>bai apalikwali kai' kwayangatia abelei bake. <verse eid="MRK 7:12"/><verse number="13" style="v" sid="MRK 7:13"/>Kwo panga nyo, ngapamulisalawa liyi'gi'yo lya Nnu'ngu' kwa kitumbu sa mimu yamupokile. Kai' mupanga makowe maingi gagalandana na ga.”<verse eid="MRK 7:13"/></para>
  <para style="s">Makowe gagannyi'a mundu usapu</para>
  <para style="r">(<ref loc="MAT 15:10-20">Mat 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14"/>Yesu ngakikema kai' si'lu' kipi'nga sa bandu, ngaabakia, “Kwa kila yumo ywinu, anipi'kani na mulitange likowe li'. <verse eid="MRK 7:14"/><verse number="15" style="v" sid="MRK 7:15"/>Ntu'pu' kili'be sakiuma panja sakikombwa kunnyi'ya mundu usapu wa loo, lakini si'lu' sakimpita bu'ka nkati ngasakilu'a kunnyi'ya usapu wa loo. <verse eid="MRK 7:15"/><verse number="16" style="v" sid="MRK 7:16"/>Mwene makutu go yu'wa, na ayu'we.”<verse eid="MRK 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17"/>Bu'ka pakukileka si'lu' kipi'nga sa bandu no yingya nnyumba, banamasi' bake ngabannaluya kilombolyo sa lukongo lu'lu'. <verse eid="MRK 7:17"/><verse number="18" style="v" sid="MRK 7:18"/>Ngaayangwa, “Buli ata mwenga munatangali? Buli, munatangali panga kili'be sakinnyingya mundu uma panja kinnyi'yali usapu wa loo? <verse eid="MRK 7:18"/><verse number="19" style="v" sid="MRK 7:19"/>Mundu mana alile kilyo, kiyingyali mumwoyo wake ila nndumbo, bu'kapo kilu'a piyilwa panja ya yi'ga yake.” (Kwo baya nyo Yesu aayi'ki'tiye panga yakulya yoti ili'li'lwe bai.)<verse eid="MRK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20"/>Ngayendelya baya, “Si'lu' sakimpita mundu, ngasakinnyi'ya usapu wa loo. <verse eid="MRK 7:20"/><verse number="21" style="v" sid="MRK 7:21"/>Kwa mwanjaa bu'ka nkati ya mwoyo wa mundu, ngakupita maganio manyatau, upege, bwii, ubulagi, <verse eid="MRK 7:21"/><verse number="22" style="v" sid="MRK 7:22"/>Ugoni, bwimi, ulau, ukongani, mila muno, bwigu, matukano, umbu'ku'su' na ulogeloge. <verse eid="MRK 7:22"/><verse number="23" style="v" sid="MRK 7:23"/>Aga malau goti gabu'ka nkati ya mundu, na gembe ngaganyi'ya mundu usapu wa loo.”<verse eid="MRK 7:23"/></para>
  <para style="s">Imani ya mau' yumo</para>
  <para style="r">(<ref loc="MAT 15:21-28">Mat 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24"/>Apo Yesu ngabu'ka yenda kuwilaya ya Tilo. Ngayingya munyumba yimo na aapaili mundu ywoywoti atange panga ai mo, lakini aakombwili yu'ba. <verse eid="MRK 7:24"/><verse number="25" style="v" sid="MRK 7:25"/>Akwo kwai na nnwawa yumo ywembe biti wake nsene aai na moka, aayu'wine abali ya Yesu. Bai ngaisa kwitaikulya pamagu'lu' gake. <verse eid="MRK 7:25"/><verse number="26" style="v" sid="MRK 7:26"/>Bai aywo nnwawa aabileli Nnyahudi, ila aabelekuli Foinike ya ku Silia. Ngannu'ba Yesu abi'nge moka kwa biti wake. <verse eid="MRK 7:26"/><verse number="27" style="v" sid="MRK 7:27"/>Yesu ngammakia, “Waleke wi'ti' bana bayukute, kwa mwanjaa inogelelyali tola kilyo sa bana na kwataikulya mapwa.” <verse eid="MRK 7:27"/><verse number="28" style="v" sid="MRK 7:28"/>Lakini yu'lu' nnwawa ngannyangwa, “Kakape Bwana, lakini ata mapwa bababile pai' ya mesa balya mbolotya yabapoloya bana.” <verse eid="MRK 7:28"/><verse number="29" style="v" sid="MRK 7:29"/>Yesu ngammakia, “Apo ulongei wiso. Tumbwelelo, uyende bai kasako, biti wako moka ammu'kite.” <verse eid="MRK 7:29"/><verse number="30" style="v" sid="MRK 7:30"/>Ngayenda kasake na kunkolya biti wake agonjike pakindanda, yu'lu' moka ammu'kite.<verse eid="MRK 7:30"/></para>
  <para style="s">Yesu antepwa mwene kimama na kiibamakutu</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31"/>Bu'kapo Yesu ngabu'ka kuwilaya ya Tilo, aapi'ti Sidoni, ngaika kulitanda liku'lu' lya Galilaya munni'ma wa Dekapoli. <verse eid="MRK 7:31"/><verse number="32" style="v" sid="MRK 7:32"/>Akwo bandu ngabannetya Yesu mundu yumo kiibamakutu, kai' mwene kimama, ngabannu'ba Yesu abi'ke maboko panani ya aywo mundu li'nga akombwe yu'wa no longela. <verse eid="MRK 7:32"/><verse number="33" style="v" sid="MRK 7:33"/>Yesu ngammu'ya yu'lu' kiibamakutu pakipi'nga sa bandu yenda nakwe pakisake, ngannyi'ya ngonji yake mumakutu gake, ngauna mmata na kunkunywa lulimi kwa galu' mmata. <verse eid="MRK 7:33"/><verse number="34" style="v" sid="MRK 7:34"/>Bu'kapo ngalingulya kunani, ngauta mbu'mwo no eleya na kummakia, “Efata” lombolya, “Yu'gu'ka.” <verse eid="MRK 7:34"/><verse number="35" style="v" sid="MRK 7:35"/>Papalu'palu' makutu na lulimi lwake ngaiyu'gu'ka. Ngatumbwa yu'wa no longela wisowiso. <verse eid="MRK 7:35"/><verse number="36" style="v" sid="MRK 7:36"/>Yesu ngaaking'indya kanebammakie mundu, lakini kwa kila mwaaking'indyage panga kanebabaye, bembe ngabayongeya yaulya abali yo. <verse eid="MRK 7:36"/><verse number="37" style="v" sid="MRK 7:37"/>Ngabasangala muno, ngababaya, “Makowe goti gaapangite manogau muno, ata aapangiye aibamakutu bayu'we na bene kimama balongele wisowiso.”<verse eid="MRK 7:37"/></para>
  <chapter eid="MRK 7"/>
  <chapter number="8" style="c" sid="MRK 8"/>
  <para style="s">Yesu aapeya sakulya bandu elupu nsese</para>
  <para style="r">(<ref loc="MAT 15:32-39">Mat 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1"/>Mumasu'ba galu' kipi'nga sa bandu saatikongolekana kai'. Nabembe pabaakosike kilyo, Yesu ngaakema banamasi' bake na kwabakia, <verse eid="MRK 8:1"/><verse number="2" style="v" sid="MRK 8:2"/>“Asi' kipi'nga sa bandu nikibi'kya kiya, kwa mwanjaa batami pamope nanenga kwa masu'ba gatatu na nambi'yambi' ntu'pu' kilyo. <verse eid="MRK 8:2"/><verse number="3" style="v" sid="MRK 8:3"/>Mana naabakiye bayende kasabe pangali lya baalu'a induka mundi'la, kwa mwanjaa bi'ngi' babe baaumi kuutalu.”<verse eid="MRK 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4"/>Banamasi' bake ngabannyangwa, “Pano patubileye palupu'ngu'ti' sika, tulwapata kwaku' makati ga kwali'ngana bandu ba boti?” <verse eid="MRK 8:4"/><verse number="5" style="v" sid="MRK 8:5"/>Yesu ngaalaluya, “Mubile na makati gali'nga?” Ngabayangwa, “Tubile na makati saba.” <verse eid="MRK 8:5"/><verse number="6" style="v" sid="MRK 8:6"/>Yesu ngaamulisa boti batame pai', ngatola galu' makati saba, ngasukulu, ngagametwana na kwapeya banamasi' bake li'nga baabagane bandu. Nabembe ngabapanga nyo. <verse eid="MRK 8:6"/><verse number="7" style="v" sid="MRK 8:7"/>Kai' kwaabile na tuomba tusini. Yesu ngasukulu, na kwaamulisa banamasi' bake baabagane bandu. <verse eid="MRK 8:7"/><verse number="8" style="v" sid="MRK 8:8"/>Balu' bandu ngabalya no yukuta. Bu'kapo banamasi' ngabakongwa makombo gagaaigile, ngabatwi'li'ya itu'ndu' saba. <verse eid="MRK 8:8"/><verse number="9" style="v" sid="MRK 8:9"/>Bandu babaalile baai pipi na elupu nsese. Bu'kapo ngaalaga. <verse eid="MRK 8:9"/><verse number="10" style="v" sid="MRK 8:10"/>Popopo Yesu ngau'bu'ka mungalaba pamope na banamasi' bake, yenda lwingo lwa Dalmanuta.<verse eid="MRK 8:10"/></para>
  <para style="s">Mafalisayo bapala mwasu</para>
  <para style="r">(<ref loc="MAT 16:1-4">Mat 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11"/>Mafalisayo ngabaisa no tumbwa taukana na Yesu li'nga kumpi'ndi'ka. Ngabannu'ba aalaye mwasu waubu'ka kunani. <verse eid="MRK 8:11"/><verse number="12" style="v" sid="MRK 8:12"/>Nganyopa pamwoyo wake na ngaabakia, “Kwa mwanjaa namani lubelekwo lu'no lupala mwasu? Kakape nimmakianga, lupeyelwali mwasu wowoti.” <verse eid="MRK 8:12"/><verse number="13" style="v" sid="MRK 8:13"/>Bai, ngaaleka, no u'bu'ka kai' ngalaba, tumbwa mwanja wo yenda liyi' lyenebi'li' lya litanda liku'lu'.<verse eid="MRK 8:13"/></para>
  <para style="s">Ulu'u wa Mafalisayo na Helode</para>
  <para style="r">(<ref loc="MAT 16:5-12">Mat 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14"/>Banamasi' baatilibalya pu'twa makati gambone, ila mungalaba yabe babile na likati limo bai. <verse eid="MRK 8:14"/><verse number="15" style="v" sid="MRK 8:15"/>Yesu ngaabakia, “Mwili'ndi'le na ulu'u wa Mafalisayo na Helode.” <verse eid="MRK 8:15"/><verse number="16" style="v" sid="MRK 8:16"/>Banamasi' baatumbwi longelya bene na bene panga, “Alongela nyo kwa kitumbu tubileli nago makati.” <verse eid="MRK 8:16"/><verse number="17" style="v" sid="MRK 8:17"/>Yesu ngagakwipwa makowe gabalongela, bai ngaalaluya, “Kwa mwanjaa namani mulongelya bu'kana no kotoka ba na makati? Buli, balo munakwipwali wala tanga? Buli, malango ginu balo ganayu'gu'kali? <verse eid="MRK 8:17"/><verse number="18" style="v" sid="MRK 8:18"/>Mubile na minyo, lakini mukibonali kili'be? Mubile na makutu, lakini muyu'wali? Buli wala muku'mbu'kyali? <verse eid="MRK 8:18"/><verse number="19" style="v" sid="MRK 8:19"/>Panaagametwi galu' makati matano na kwapeya bandu babapi'ta elupu tano, mwakongwi itu'ndu' ili'nga ya makombo?” Ngabannyangwa, “Ku'mi nebi'li'.” <verse eid="MRK 8:19"/><verse number="20" style="v" sid="MRK 8:20"/>“Na panaagametwi galu' makati saba na kwapeya bandu elupu nsese, mwakongwi itu'ndu' ili'nga ya makombo?” Ngabannyangwa, “Saba.” <verse eid="MRK 8:20"/><verse number="21" style="v" sid="MRK 8:21"/>Bai, ngaabakia, “Na balo munatangali?”<verse eid="MRK 8:21"/></para>
  <para style="s">Yesu ampanga alole mbulibuli wa ku Betisaida</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22"/>Yesu na banamasi' bake ngabaika Betisaida. Ku'lu' ngabannetya mundu yumo mbulibuli na kunnu'ba Yesu ankunywe li'nga ayu'yu'ki'lwe. <verse eid="MRK 8:22"/><verse number="23" style="v" sid="MRK 8:23"/>Yesu ngaankamwa luboko aywo mbulibuli na kumpeleka panja ya kilambo. Ngaamwunia mmata muminyo, ngaammi'kya moko, ngannaluya, “Buli, wendakombwa kukibona kili'be?” <verse eid="MRK 8:23"/><verse number="24" style="v" sid="MRK 8:24"/>Yu'lu' mbulibuli ngalola, ngabaya, “Naabona bandu, lakini babonekana kati mikongo yaityanga.” <verse eid="MRK 8:24"/><verse number="25" style="v" sid="MRK 8:25"/>Bu'kapo, Yesu ngaammi'kya kai' moko muminyo. Minyo gake ngagayu'gu'ka, ngatumbwa lola na kukibona kila kili'be wisowiso. <verse eid="MRK 8:25"/><verse number="26" style="v" sid="MRK 8:26"/>Yesu aammakie ayende kasake na kumwamulisa, “Kaneubuye mukilambo.”<verse eid="MRK 8:26"/></para>
  <para style="s">Petili annyi'ki'tya Yesu panga Kilisitu</para>
  <para style="r">(<ref loc="MAT 16:13-20">Mat 16:13-20</ref>, <ref loc="LUK 9:18-21">Luk 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27"/>Bu'kapo Yesu na banamasi' bake, ngabayabwa yenda muilambo ya Kaisalia Filipi. Pabaabile mundi'la Yesu aatikwalaluya, “Bandu babaya nenga nanyai?” <verse eid="MRK 8:27"/><verse number="28" style="v" sid="MRK 8:28"/>Ngabannyangwa, “Bi'ngi' babaya wenga wa Yoani Ywabatisage, bi'ngi' babaya wa Elia na bi'ngi' babaya wa yumo ywa alondoli ba Nnu'ngu'.” <verse eid="MRK 8:28"/><verse number="29" style="v" sid="MRK 8:29"/>Naywembe ngaalaluya, “Na mwenga buli, mubaya nenga nanyai?” Petili ngannyangwa, “Wenga ngawa Kilisitu.” <verse eid="MRK 8:29"/><verse number="30" style="v" sid="MRK 8:30"/>Bu'kapo Yesu ngaaking'indya kanebammakie mundu ywoywoti abali yake.<verse eid="MRK 8:30"/></para>
  <para style="s">Yesu alongelya bu'kana na ngu'su'mbu', kiwo na uyu'ki wake</para>
  <para style="r">(<ref loc="MAT 16:21-28">Mat 16:21-28</ref>, <ref loc="LUK 9:22-27">Luk 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31"/>Apo Yesu ngatumbwa kwayi'gana banamasi' bake kabaya, “Ipalikwa Mwana wa Mundu ateselwe no kanilwa na ayi'mi'li'ki ba bandu, api'ndo ba dini na balimu ba salya. Kai' ipalikwa abulagilwe no yu'ka lisu'ba lyenetatu.” <verse eid="MRK 8:31"/><verse number="32" style="v" sid="MRK 8:32"/>Aagabaite ga mpu'la, apo Petili ngantola Yesu no tumbwa kunkwi'li'ka. <verse eid="MRK 8:32"/><verse number="33" style="v" sid="MRK 8:33"/>Lakini Yesu ngaagalambukya na kwalingulya banamasi' bake, ngankwi'li'ka Petili kwa kummakia, “Ubu'ke nnu'ngi' yangu' wenga wa Ibilisi! Wenga uganiali gagabile ga Nnu'ngu', ila ugania gagabu'ka kwa bandu bai.”<verse eid="MRK 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34"/>Bu'kapo ngakikema si'lu' kipi'nga sa bandu pamope na banamasi' bake na kwabakia, “Mana mundu kapala kuniki'ngama, aikane mwene na aupu'twe nsalaba wake aniki'ngame. <verse eid="MRK 8:34"/><verse number="35" style="v" sid="MRK 8:35"/>Kwa mwanjaa ywoywoti ywapala kuukosopolya bwu'mi wake alu'a kuuobeya, lakini ywoywoti ywauobeya bwu'mi wake kwa kitumbu sangu' nenga na kwa abali inannoga, aalu'a kuukosopolya. <verse eid="MRK 8:35"/><verse number="36" style="v" sid="MRK 8:36"/>Buli, mundu aalu'a pata namani kwipata dunia yoti, na kuuobeya bwu'mi wake? <verse eid="MRK 8:36"/><verse number="37" style="v" sid="MRK 8:37"/>Au mundu aalu'a piya namani pandu pa bwu'mi wake? <verse eid="MRK 8:37"/><verse number="38" style="v" sid="MRK 8:38"/>Lu'no lubelekwo lwene sambi na lwangali u'bi'li'ka. Bai, mundu ywoywoti ywanibi'kya oni nenga na mayi'gano gangu', Mwana wa Adamu naywembe aammi'kya oni mundu ywo lisu'ba lya alu'a buya muutukupu wa Tati' bake abile na malaika bake apeleteu.”<verse eid="MRK 8:38"/></para>
  <chapter eid="MRK 8"/>
  <chapter number="9" style="c" sid="MRK 9"/>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1"/>Yesu ngayendelya kwabakia, “Kakape nimmakianga, babile bi'ngi' papanopano baalu'a panga banawaali pangali kuubona Ukulungwa wa Nnu'ngu' kawisa kwa makakala.”<verse eid="MRK 9:1"/></para>
  <para style="s">Galambuka kwa Yesu</para>
  <para style="r">(<ref loc="MAT 17:1-13">Mat 17:1-13</ref>, <ref loc="LUK 9:28-36">Luk 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2"/>Pagapite masu'ba sita, Yesu ngaatola Petili, Yakobi na Yoani, ngaapeleka pakitu'mbi' kilaso pandu pakiyi'ki'ya. Akwo Yesu ngagalambuka ywoti nnu'ngi' yabe. <verse eid="MRK 9:2"/><verse number="3" style="v" sid="MRK 9:3"/>Magu'bo gake gaatimelemetya, ngagapanga mauu muno, wala pano padunia ntu'pu' nkusili ywawesa kusa ipange uu kati nyo. <verse eid="MRK 9:3"/><verse number="4" style="v" sid="MRK 9:4"/>Musa na Elia ngabapitya, ngababa kabalongela na Yesu. <verse eid="MRK 9:4"/><verse number="5" style="v" sid="MRK 9:5"/>Petili ngammakia Yesu, “Mwalimu, inogelile twenga baa pano. Utuyi'ki'ti'ye tusenge isewe itatu, simo sako, si'ngi' sa Musa na si'ngi' sa Elia.” <verse eid="MRK 9:5"/><verse number="6" style="v" sid="MRK 9:6"/>Petili aatangiteli lyo longela kwa mwanjaa ywembe na aine baabile kabayogopa muno. <verse eid="MRK 9:6"/><verse number="7" style="v" sid="MRK 9:7"/>Bu'kapo lyunde ngalyaawi'ki'lya na lilobe lyayuwanike bu'ka mulyunde lyo, “Ayu' nga Mwana wangu' ywanimpendile, mumpi'kani ywembe.” <verse eid="MRK 9:7"/><verse number="8" style="v" sid="MRK 9:8"/>Papalu'palu' pabalinguli ku'no na akwo, baamwenili kai' mundu ywi'ngi' kati yabe ila Yesu kisake.<verse eid="MRK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9"/>Pabaabile kabaelya bu'ka kukitu'mbi', Yesu ngaaking'indya, “Kanemummakie mundu ywoywoti makowe gamugabweni, mpaka Mwana wa Mundu paalu'a yu'ka bu'ka kuuwi'li.” <verse eid="MRK 9:9"/><verse number="10" style="v" sid="MRK 9:10"/>Bai, ngabaliiya likowe lyo bene, lakini baabile kabalaluyana, “Yu'ka kwa awi'li kulombolya namani?” <verse eid="MRK 9:10"/><verse number="11" style="v" sid="MRK 9:11"/>Ngabannaluya Yesu, “Mboni balimu ba salya babaya panga Kilisitu abile balo isa aalongolya wi'ti' Elia?” <verse eid="MRK 9:11"/><verse number="12" style="v" sid="MRK 9:12"/>Yesu ngaayangwa, “Kakape Elia aapalikwa buya wi'ti' li'nga bi'ka wiso makowe goti. Lakini mwanjaa namani iandikilwe panga Mwana wa Mundu alu'a teselwa muno no salaulilwa? <verse eid="MRK 9:12"/><verse number="13" style="v" sid="MRK 9:13"/>Lakini nimmakianga Elia ayomwike isa, nabembe ngabampangya maakau goti gabapalage, kati mu'lu' mwayaandikilwe kwa ywembe.”<verse eid="MRK 9:13"/></para>
  <para style="s">Yesu abi'nga moka kwa mwana</para>
  <para style="r">(<ref loc="MAT 17:14-21">Mat 17:14-21</ref>, <ref loc="LUK 9:37-43">Luk 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14"/>Yesu, Petili, Yoani na Yakobi pabaabuyangine bu'ka kukitu'mbi', ngabakikolya kipi'nga kiku'lu' sa bandu. Bi'ngi' ba balimu ba salya kabataukana na banamasi' bi'ngi'. <verse eid="MRK 9:14"/><verse number="15" style="v" sid="MRK 9:15"/>Balu' bandu pabamweni Yesu baatisangala muno, popopo ngabammutukya li'nga kumpanga abali. <verse eid="MRK 9:15"/><verse number="16" style="v" sid="MRK 9:16"/>Ngaalaluya banamasi' bake, “Mutaukana nabo kwa kitumbu saku'?” <verse eid="MRK 9:16"/><verse number="17" style="v" sid="MRK 9:17"/>Mundu yumo mu si'lu' kipi'nga sa bandu ngayangwa, “Mwalimu, ninnetike mwana wangu' kasako, aina moka gagampangiya abe bubu. <verse eid="MRK 9:17"/><verse number="18" style="v" sid="MRK 9:18"/>Kila pantangya, antu'ya pai' na kumpanga apiye matutume munkano no tauna mino, bu'kapo yi'ga yake yendang'ong'onala. Naalu'bite banamasi' bako bammi'nge moka, lakini bakombwili.”<verse eid="MRK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19"/>Yesu ngaabakia, “Mwenga mwa lubelekwo lwangali u'bi'lya! Nilu'a tama na mwenga mpaka pakubawi? Nilu'a kunkomeya mpaka pakubawi? Munnete mwinsembe pano.” <verse eid="MRK 9:19"/><verse number="20" style="v" sid="MRK 9:20"/>Nabembe ngabanneta yu'lu' mwinsembe kwa Yesu. Yu'lu' moka paamweni Yesu, popopo ngannyi'ya yu'lu' mwinsembe kyundaunda, ngatu'la pai' no galabuka ku'no kapiya matutume munkano. <verse eid="MRK 9:20"/><verse number="21" style="v" sid="MRK 9:21"/>Yesu ngaalaluya tati' bake mwinsembe, “Mwana wako ngu'su'mbu' yi' intumbwi pakubawi?” Ngannyangwa, “Bu'ka kuunangu'ta wake. <verse eid="MRK 9:21"/><verse number="22" style="v" sid="MRK 9:22"/>Aywo moka akokotyage kuntu'mbu'ki'ya mumwoto au mumasi' li'nga kunnangamisa. Lakini mana kaukombwa panga kikowe sosoti, sonde utubi'ki kiya utuyangatiye.” <verse eid="MRK 9:22"/><verse number="23" style="v" sid="MRK 9:23"/>Yesu ngannyangwa panga, “Kwa mwanjaa buli ubaya panga, ‘Mana kaukombwa?’ Goti gendawesekana kwa ywembe ywau'bi'lya.” <verse eid="MRK 9:23"/><verse number="24" style="v" sid="MRK 9:24"/>Popopo, aywo tati' ywa mwinsembe ngau'bu'ya lilobe kabaya, “Nendau'bi'lya! Lakini uniyangatiye kwo kotoka u'bi'lya kwangu'.”<verse eid="MRK 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25"/>Yesu pakibweni kipi'nga sa bandu kakikongolekana pamope kiyu'ngu'ya, ngankalipya yu'lu' moka kammakia, “Wenga wa moka bubu na kiibamakutu, nikuamulisa ummu'ke na kaneunnyingi kai'!” <verse eid="MRK 9:25"/><verse number="26" style="v" sid="MRK 9:26"/>Yu'lu' moka aatikemelya, ngannyi'ya kyundaunda kwa makakala na kummu'ka. Yu'lu' mwinsembe aabile kati ntwi, kwa nyo bandu baingi ngababaya, “Ayomwike.” <verse eid="MRK 9:26"/><verse number="27" style="v" sid="MRK 9:27"/>Lakini Yesu ngankamwa luboko kunkakatuya, naywembe ngayi'ma.<verse eid="MRK 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28"/>Bai, Yesu paayingi nnyumba, banamasi' bake ngabannaluya pakisake, “Mwanjaa namani twenga tukombwili kummi'nga yu'lu' moka?” <verse eid="MRK 9:28"/><verse number="29" style="v" sid="MRK 9:29"/>Naywembe ngaabakia, “Moka ywa kubinnya awesekanali bu'ka mpaka kwo lu'ba.”<verse eid="MRK 9:29"/></para>
  <para style="s">Yesu alongelya kai' bu'kana na kiwo na uyu'ki wake</para>
  <para style="r">(<ref loc="MAT 17:22-23">Mat 17:22-23</ref>, <ref loc="LUK 9:43-45">Luk 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30"/>Yesu na banamasi' bake ngababu'ka kwo no yendelya na mwanja kwo pi'tya ku Galilaya. Yesu aapaili mundu ywoywoti atange pandu pabaabile, <verse eid="MRK 9:30"/><verse number="31" style="v" sid="MRK 9:31"/>kwa mwanjaa aai kaayi'gana banamasi' bake kaabakia, “Mwana wa Mundu aalu'a songelwa no kamukiyilwa kwa bandu. Nabembe baalu'a kummulaga, lakini lisu'ba lyenetatu bu'ka waa kwake alu'a yu'ka.” <verse eid="MRK 9:31"/><verse number="32" style="v" sid="MRK 9:32"/>Lakini banamasi' bake baatangiteli panga saakilongei saalomboli namani, nabembe ngabayogopa kunnaluya.<verse eid="MRK 9:32"/></para>
  <para style="s">Ywaku' ywabile nku'lu'?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mat 18:1-5</ref>, <ref loc="LUK 9:46-48">Luk 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33"/>Bai ngabaika Kapalanaumu no bu'ka po yingya nnyumba Yesu ngaalaluya, “Mwabile kamulongelya ki'li' mundi'la?” <verse eid="MRK 9:33"/><verse number="34" style="v" sid="MRK 9:34"/>Lakini banamasi' baayangwili, kwa mwanjaa mundi'la baabile kabataukana panga ywaku' mukipi'nga sabe ywabile nku'lu' muno kulikoni boti.<verse eid="MRK 9:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 9:35"/>Ngatama pai' na kwakema boti ku'mi na abi'li', ngaabakia, “Mundu ywoywoti mana kapala panga nku'lu' ywa boti, apalikwa apange wa kuundi'la kuliko boti na apange ntumisi ywa boti.” <verse eid="MRK 9:35"/><verse number="36" style="v" sid="MRK 9:36"/>Bu'kapo ngantola mwana nsene, ngannyi'mi'ka pakatikati yabe. Ngankumbatya na kwabakia, <verse eid="MRK 9:36"/><verse number="37" style="v" sid="MRK 9:37"/>“Mundu ywoywoti ywampokya yumo ywa aba bana asene kwa lina lyangu' anipokya nenga. Na ywaanipokya nenga anipokya nenga baili, ila ampokya ata yu'lu' ywaanitumike.”<verse eid="MRK 9:37"/></para>
  <para style="s">Ywangali taukana na twe abile kulwingo lwitu</para>
  <para style="r">(<ref loc="LUK 9:49-50">Luk 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38"/>Yoani ngammakia, “Mwalimu, tumweni mundu kabi'nga moka kwa lina lyako, na twenga ngatunkanikiya kwa mwanjaa ywembe abileli pamope na twenga.” <verse eid="MRK 9:38"/><verse number="39" style="v" sid="MRK 9:39"/>Yesu ngaabakia, “Kanemunkanikiye, kwa mwanjaa ntu'pu' ywoywoti ywapanga mangelongelo kwa lina lyangu', bu'kapo kalongela likowe linyatau kwangu' nenga. <verse eid="MRK 9:39"/><verse number="40" style="v" sid="MRK 9:40"/>Kwa mwanjaa ywakotoka taukana na twenga abile kasitu. <verse eid="MRK 9:40"/><verse number="41" style="v" sid="MRK 9:41"/>Kakape nimmakianga, ywoywoti ywampeya mwenga ata kikombe sa masi' go nywa kwa mwanjaa mwenga mwabandu ba Kilisitu kakape mundu ywo, aakosali upo yaibu'ka kwa Nnu'ngu'.”<verse eid="MRK 9:41"/></para>
  <para style="s">Iku'balo</para>
  <para style="r">(<ref loc="MAT 18:6-9">Mat 18:6-9</ref>, <ref loc="LUK 17:1-2">Luk 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42"/>Ywoywoti ywampanga yumo ywa bana ba babaniu'bi'lya aponeye, yapanga male kwake atabilwe liwe liku'lu' lya lwaga paingo na kuntaikulya mubaali. <verse eid="MRK 9:42"/><verse number="43" style="v" sid="MRK 9:43"/>Luboko lwako mana lukupangiye uponeye, ulukate! Yapanga male kwako yingya muukoto wangayomoka ubile na luboko lumo, kulikoni baa na maboko gabi'li' no yingya mumwoto wangayomoka. <verse eid="MRK 9:43"/><verse number="44" style="v" sid="MRK 9:44"/>Pandu po, matekenya gake gawaali, wala mwoto wake uimikali. <verse eid="MRK 9:44"/><verse number="45" style="v" sid="MRK 9:45"/>Mana lugu'lu' lwako lukupangiye uponeye, ulukate! Yapanga male kwako yingya muukoto wangayomoka ubile na lugu'lu' lumo, kulikoni baa na magu'lu' gabi'li' no taikulilwa mumwoto wangayomoka. <verse eid="MRK 9:45"/><verse number="46" style="v" sid="MRK 9:46"/>Pandu po, matekenya gake gawaali, wala mwoto wake uimikali. <verse eid="MRK 9:46"/><verse number="47" style="v" sid="MRK 9:47"/>Mana liyo lyako likupangiye uponeye, uliyokwe! Yapanga male kwako yingya muukulungwa wa Nnu'ngu' ubile na liyo limo kulikoni baa na minyo gabi'li' no taikulilwa mumwoto wangayomoka. <verse eid="MRK 9:47"/><verse number="48" style="v" sid="MRK 9:48"/>Pandu po matekenya gake gawaali wala mwoto wake uimikali.<verse eid="MRK 9:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49"/>“Kwa mwanjaa kila mundu aatakilwa kwa mwoto. <verse eid="MRK 9:49"/><verse number="50" style="v" sid="MRK 9:50"/>Mwinyo unogite, lakini mana uobiye kilyi'lyi' sake, mwayi'ya namani li'nga uki'li'bu'ye kilyi'lyi' kai'? Mubee na mwinyo nkati yinu na mutame pamope kwa amani kila mundu na nnyine.”<verse eid="MRK 9:50"/></para>
  <chapter eid="MRK 9"/>
  <chapter number="10" style="c" sid="MRK 10"/>
  <para style="s">Bu'kana na talaka</para>
  <para style="r">(<ref loc="MAT 19:1-12">Mat 19:1-12</ref>, <ref loc="LUK 16:18">Luk 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1"/>Yesu ngabu'ka ku'lu' yenda kunkoa wa Yudea no loka liyi' lya Yordani. Na ipi'nga yambone ya bandu yaatikongolekana kai' nnu'ngi' yake, naywembe ngatumbwa kwayi'gana kati mwayobelile. <verse eid="MRK 10:1"/><verse number="2" style="v" sid="MRK 10:2"/>Bi'ngi' ba Mafalisayo ngabaisa li'nga kumpaya kwa kunnaluya, “Buli, yendayi'ki'ti'lwa nnalu'me kupeya talaka nnyumbowe?” <verse eid="MRK 10:2"/><verse number="3" style="v" sid="MRK 10:3"/>Yesu ngaayangwa, “Musa aamwamulise namani?” <verse eid="MRK 10:3"/><verse number="4" style="v" sid="MRK 10:4"/>Ngabayangwa, “Musa aayi'ki'tiye panga nnalu'me endakombwa kumwandikya nnyumbowe talaka na kummu'ya.”<verse eid="MRK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5"/>Yesu ngaabakia, “Musa aamwandiki salya yo kwa kitumbu so nonopa kwinu kwa myoyo. <verse eid="MRK 10:5"/><verse number="6" style="v" sid="MRK 10:6"/>Lakini tangu' nsimu wa Nnu'ngu' paumbike dunia, aaumbike nnalu'me na nnwawa. <verse eid="MRK 10:6"/><verse number="7" style="v" sid="MRK 10:7"/>Kwa kitumbu si', nnalu'me aalu'a kwaleka tati' bake na mau' bake no lu'mbana na nnyumbowe, <verse eid="MRK 10:7"/><verse number="8" style="v" sid="MRK 10:8"/>na abo abi'li' baapanga yi'ga yimo. Kwa nyo, baapangali abi'li' kai', ila yi'ga yimo. <verse eid="MRK 10:8"/><verse number="9" style="v" sid="MRK 10:9"/>Bai, saakilu'mbaniye Nnu'ngu', mundu kaneakilekanganiye.”<verse eid="MRK 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10"/>Pabaabile nnyumba kai', banamasi' bake ngabannaluya abali ya likowe lyo. <verse eid="MRK 10:10"/><verse number="11" style="v" sid="MRK 10:11"/>Ngaayangwa, “Mundu ywoywoti ywanneka nnyumbowe no kobeka nnwawa ywi'ngi' apanga ugoni. <verse eid="MRK 10:11"/><verse number="12" style="v" sid="MRK 10:12"/>Nyinyonyo na nnwawa ywanneka nsengowe no ku'nda kwa nnalu'me ywi'ngi', apanga ugoni.”<verse eid="MRK 10:12"/></para>
  <para style="s">Yesu aayalya bana anangu'ta</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mat 19:13-15</ref>, <ref loc="LUK 18:15-17">Luk 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13"/>Bandu baabile kabannetya Yesu bana anangu'ta li'nga aakunywe, lakini banamasi' bake ngabaakalipya. <verse eid="MRK 10:13"/><verse number="14" style="v" sid="MRK 10:14"/>Lakini Yesu paabweni nyo, aatiusika muno, ngaabakia, “Mwayi'ki'ti'ye bana anangu'ta baisange kasangu', kanemwakanikiye, kwa mwanjaa bana kati ba Ukulungwa wa Nnu'ngu' nga wabe. <verse eid="MRK 10:14"/><verse number="15" style="v" sid="MRK 10:15"/>Kakape nimmakianga, mundu ywoywoti ywakotoka kuuyi'ki'tya Ukulungwa wa Nnu'ngu' kati mwana nnangu'ta, katu auyingyali ukulungwa wo.” <verse eid="MRK 10:15"/><verse number="16" style="v" sid="MRK 10:16"/>Bu'kapo ngaakumbatya bana balu', no bi'ka maboko panani yabe li'nga kwayalya.<verse eid="MRK 10:16"/></para>
  <para style="s">Mundu ywabile tayili</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mat 19:16-30</ref>, <ref loc="LUK 18:18-30">Luk 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17"/>Yesu paabile kabu'ka, mundu yumo aatikummutukya, ngakilikita nnu'ngi' yake ngannaluya, “Mwalimu nnogau, nipange buli li'nga niulisi ukoto wangayomoka?” <verse eid="MRK 10:17"/><verse number="18" style="v" sid="MRK 10:18"/>Yesu ngammakia, “Mbona unikema nannogau? Ntu'pu' ywoywoti ywabile nnogau ila Nnu'ngu' kisake. <verse eid="MRK 10:18"/><verse number="19" style="v" sid="MRK 10:19"/>Witangite amuli, ‘Kaneubulage, kaneupange upege, kaneupange ugoni, kaneuyibe, kaneukong'ondeli ubu'su', kaneuku'pi'ye, waisimu tati' na mau' bako.’” <verse eid="MRK 10:19"/><verse number="20" style="v" sid="MRK 10:20"/>Ngayangwa, “Mwalimu, amuli yoti yi' niikamwile bu'ka kuunangu'ta wangu'.”<verse eid="MRK 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21"/>Yesu nganningulya kwa kumpenda, ngammakia, “Upu'ngu'kilwe na kili'be simo. Uyende, ukapi'mi'ye kila kili'be saubile naso na mbanje ye ukaapei aki'ba, nawenga waapanga na amana kunani. Bu'kapo, uniki'ngame.” <verse eid="MRK 10:21"/><verse number="22" style="v" sid="MRK 10:22"/>Aywo mundu payu'wine nyo, ngaku'ku'li'ka muno, Ngabu'ka kanyopa kwa mwanjaa aabile na mali yambone.<verse eid="MRK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23"/>Yesu ngalingulya lwingo lwoti na kwabakia banamasi' bake, “Mulinguli mwainonwipe kwa bababile na mali, yingya mu Ukulungwa wa Nnu'ngu'!” <verse eid="MRK 10:23"/><verse number="24" style="v" sid="MRK 10:24"/>Banamasi' baatisangala kwa mayi'gi'yo go. Lakini Yesu ngaabakia kai', “Mwabana bangu', kunonwipe muno yingya mu Ukulungwa wa Nnu'ngu'! <verse eid="MRK 10:24"/><verse number="25" style="v" sid="MRK 10:25"/><figure style="fig" alt="Camel" file="14 Camel.jpg" size="col" ref="10:25">Ngamia</figure>Male kwa mbu'nda pi'ta mulipoyo lya singano kulikoni mundu tayili yingya mu Ukulungwa wa Nnu'ngu'.” <verse eid="MRK 10:25"/><verse number="26" style="v" sid="MRK 10:26"/>Banamasi' bake ngabasangala muno, ngabalaluyana bene na bene, “Kwa nyo nyai lelo ywawesa kosopolelwa?” <verse eid="MRK 10:26"/><verse number="27" style="v" sid="MRK 10:27"/>Yesu ngaalingulya na kwabakia, “Likowe li' kwa mundu liwesekanali, lakini kwa Nnu'ngu' makowe goti gendawesekana.”<verse eid="MRK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28"/>Apo Petili ngammakia, “Linga, na twenga tukilei kila kili'be kukuki'ngama wenga!” <verse eid="MRK 10:28"/><verse number="29" style="v" sid="MRK 10:29"/>Apo Yesu ngaabakia, “Kakape nimmakianga, mundu ywaileka nyumba yake, mwasawe, nnu'mbu'we, mau', tati', bana au migunda kwa kitumbu sangu' na kwa abali inannoga, <verse eid="MRK 10:29"/><verse number="30" style="v" sid="MRK 10:30"/>aali'pi'lwa mala mya kwa nsimu wa nambi'yambi'. Aapokya nyumba na alongo, mau' na tati', bana na migunda pamope na ngu'su'mbu'. Na nsimu wawaaisa aalu'a pokya ukoto wangayomoka. <verse eid="MRK 10:30"/><verse number="31" style="v" sid="MRK 10:31"/>Lakini baingi bababile alongoi baalu'a ba kuundi'la, na ba kuundi'la baalu'a ba alongoi.”<verse eid="MRK 10:31"/></para>
  <para style="s">Yesu alongela pampanda patatu bu'kana na kiwo na uyu'ki wake</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mat 20:17-19</ref>, <ref loc="LUK 18:31-34">Luk 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32"/>Pabaabile mundi'la kabayenda Yelusalemu Yesu aatilongolya. Banamasi' bake baatisangala muno, na bandu babaabile kabaaki'ngama ngabayogopa. Yesu ngaatola kai' banamasi' bake ku'mi na abi'li' pambwega na kwabakia gagaalu'a kumpitya. <verse eid="MRK 10:32"/><verse number="33" style="v" sid="MRK 10:33"/>Ngabaya, “Twendau'bu'ka yenda Yelusalemu, na Mwana wa Mundu aalu'a kamukiyilwa kwa api'ndo ba dini na balimu ba salya. Bembe baalu'a kumuukumu kiwo na kunkamukiya kwa bandu bangali Ayahudi, <verse eid="MRK 10:33"/><verse number="34" style="v" sid="MRK 10:34"/>abo baalu'a kunsalanga na kummunia mmata, baalu'a kunku'mbwa na kummulaga. Bu'kapo lisu'ba lyenetatu, aalu'a yu'ka.”<verse eid="MRK 10:34"/></para>
  <para style="s">Lu'ba kwa Yakobi na Yoani</para>
  <para style="r">(<ref loc="MAT 20:20-28">Mat 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35"/>Yakobi na Yoani, bana ba Zebedayo, baannyendeli Yesu na kummakia, “Mwalimu, tupala utupangi sosoti satwakulu'ba.” <verse eid="MRK 10:35"/><verse number="36" style="v" sid="MRK 10:36"/>Yesu ngaalaluya, “Mupala nimpangyange ki'li'?” <verse eid="MRK 10:36"/><verse number="37" style="v" sid="MRK 10:37"/>Ngabammakia, “Utuyi'ki'ti'ye tama yumo kummalyo na ywi'ngi' kunki'ya muutukupu wako.” <verse eid="MRK 10:37"/><verse number="38" style="v" sid="MRK 10:38"/>Lakini Yesu ngaabakia, “Mwenga mutangiteli samukilu'ba. Buli, mwendakombwa nywelya nnobo wa ngu'su'mbu' wanaalu'a nywelya nenga, au batisilwa ubatiso wa kiwo wanaalu'a batisilwa nenga?” <verse eid="MRK 10:38"/><verse number="39" style="v" sid="MRK 10:39"/>Ngabannyangwa, “Twendakombwa.” Yesu ngaabakia, “Nnobo waninywelya mwaunywelya na ubatiso wanibatisilwa mwaabatisilwa, <verse eid="MRK 10:39"/><verse number="40" style="v" sid="MRK 10:40"/>lakini tama lwingo lwa mmalyo au lwa nki'ya alyo lyengo lyangu' nengali kumpeyanga. Lipala li'no Nnu'ngu' alu'a kwapeya balu' bababi'kilwe wisowiso.”<verse eid="MRK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41"/>Balu' banamasi' bi'ngi' ku'mi pabayu'wine go, ngabatumbwa kwausikya Yakobi na Yoani. <verse eid="MRK 10:41"/><verse number="42" style="v" sid="MRK 10:42"/>Kwa nyo Yesu ngaakema banamasi' bake pamope na kwabakia, “Mutangite panga, ayi'mi'li'ki ba bandu bangali Ayahudi batawala bandu babe kwa ukali', na api'ndo babe baatumya kinyatau. <verse eid="MRK 10:42"/><verse number="43" style="v" sid="MRK 10:43"/>Lakini kwinu mwenga kaneibe nyo. Ila ywoywoti ywapala panga nku'lu' mukipi'nga sinu aapalikwa ba ntumisi winu, <verse eid="MRK 10:43"/><verse number="44" style="v" sid="MRK 10:44"/>na ywoywoti ywapala panga nnongoi apalikwa ba mmanda ywa boti. <verse eid="MRK 10:44"/><verse number="45" style="v" sid="MRK 10:45"/>Kwa mwanjaa Mwana wa Mundu aaisili li'nga tumikilwa, ila tumikia na kuupiya bwu'mi wake ube mali'po ga kwakombwa bandu baingi li'nga bakosopolelwe.”<verse eid="MRK 10:45"/></para>
  <para style="s">Yesu antepwa Batolomayo mbulibuli</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mat 20:29-34</ref>, <ref loc="LUK 18:35-43">Luk 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46"/>Bu'kapo ngabaika Yeliko. Yesu paabile kabu'ka pakilambo so na banamasi' bake pamope na kipi'nga kiku'lu' sa bandu, mbulibuli yumo lina lyake Batimayo, mwana wa Timayo, aabile atami mbwega ya ndi'la kalu'ba yangatiyilwa. <verse eid="MRK 10:46"/><verse number="47" style="v" sid="MRK 10:47"/>Paayu'wine panga Yesu ywa ku Nasaleti aabile kapi'ta, ngatumbwa u'bu'ya lilobe kabaya, “Yesu, Mwana wa Daudi, unibi'ki kiya!” <verse eid="MRK 10:47"/><verse number="48" style="v" sid="MRK 10:48"/>Bandu baingi ngabankalipya kwa kummakia atame liki, lakini ywembe ngau'bu'ya lilobe kai' kwa makakala kabaya, “Yesu, Mwana wa Daudi, unibi'ki kiya!”<verse eid="MRK 10:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49"/>Yesu ngayi'ma no baya, “Munkeme aise pano.” Bai ngabankema yu'lu' mbulibuli, ngabammakia, “Ube na mwoyo nku'lu'! Ukatuke, endakukema.” <verse eid="MRK 10:49"/><verse number="50" style="v" sid="MRK 10:50"/>Ngataikwa nganju yake no yi'ma kiyu'ngu'ya, na kunnyendelya Yesu.<verse eid="MRK 10:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51"/>Yesu ngannaluya, “Upala nikupangi ki'li'?” Yu'lu' mbulibuli ngayangwa, “Mwalimu, mbala lola.”<verse eid="MRK 10:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52"/>Yesu ngammakia, “Uyende, imani yako ikutepwile.” Popopo aakombwi lola, ngaanki'ngama Yesu kundi'la.<verse eid="MRK 10:52"/></para>
  <chapter eid="MRK 10"/>
  <chapter number="11" style="c" sid="MRK 11"/>
  <para style="s">Yesu ayingya Yelusalemu kwa kunkwi'ndilya</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mat 21:1-11</ref>, <ref loc="LUK 19:28-40">Luk 19:28-40</ref>, <ref loc="JHN 12:12-19">Yoa 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1"/>Yesu na banamasi' bake pabaabile kabaegelya ku Yelusalemu lwingo lwa kilambo sa Bethfage na Betania, papipi na Kitu'mbi' sa Minjaituni, Yesu aatumike banamasi' bake abi'li', <verse eid="MRK 11:1"/><verse number="2" style="v" sid="MRK 11:2"/>ngaabakia, “Muyende pakilambo sakibile nnu'ngi' yinu. Pamutumbwa yingya bai, mukammona mwana mbu'nda atabilwe, na anakolelelwali na mundu. Mukamundwe, munnete pano. <verse eid="MRK 11:2"/><verse number="3" style="v" sid="MRK 11:3"/>Manaitei mundu ywoywoti kannaluya panga, ‘Mboni mupanga nnya?’ Mummakie panga, ‘Bwana endakumpala na aasi'yali kunki'li'bu'ya.’”<verse eid="MRK 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4"/>Bai, pabayi'i ngabammona mwana mbu'nda, ywatabilwe mbwega ya simbasimba panja ya nniango, ngabamundwa. <verse eid="MRK 11:4"/><verse number="5" style="v" sid="MRK 11:5"/>Pabaabile kabamundwa, bandu babaayi'mi papipi nabo baatikwalaluya, “Mupanga namani? Mwanjaa namani mumundwa mwana mbu'nda yu'?” <verse eid="MRK 11:5"/><verse number="6" style="v" sid="MRK 11:6"/>Banamasi' ngabayangwa kati mu'lu' mwabaabakiyilwe na Yesu, nabembe ngabaaleka bayende. <verse eid="MRK 11:6"/><verse number="7" style="v" sid="MRK 11:7"/>Bu'kapo, ngabampelekya Yesu yu'lu' mwana mbu'nda no tandika magu'bo gabe panani yake li'nga Yesu atame. <verse eid="MRK 11:7"/><verse number="8" style="v" sid="MRK 11:8"/>Bandu baingi baatandike magu'bo gabe mundi'la, na bi'ngi' baatandike ndambi' ya mikongo yabakatike mumigunda yabe. <verse eid="MRK 11:8"/><verse number="9" style="v" sid="MRK 11:9"/>Bandu boti babaalongoli nnu'ngi' ya Yesu na babaabile nsu'gu' yake baau'bwiye malobe gabe kababaya, “Nnu'ngu' alumbilwe! Ayaliwite ywembe ywaisa kwa lina lya Bwana! <verse eid="MRK 11:9"/><verse number="10" style="v" sid="MRK 11:10"/>Uyaliwite ukulungwa wawisa wa au'ku' bitu Daudi! Nnu'ngu' wa kunani alumbilwe!”<verse eid="MRK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11"/>Yesu aayingi pakilambo sa Yelusalemu, aayi'i ntawalia mpaka munyumba ya Nnu'ngu' na kukilinga wisowiso kila kili'be. Lakini kwa mwanjaa yaai kitamwiyo, ngayenda Betania pamope na balu' ku'mi na abi'li'.<verse eid="MRK 11:11"/></para>
  <para style="s">Yesu aukosya lasi ntini</para>
  <para style="r">(<ref loc="MAT 21:18-19">Mat 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12"/>Pammalau' yake pabaabile kabauma Betania, Yesu yamminyike njala. <verse eid="MRK 11:12"/><verse number="13" style="v" sid="MRK 11:13"/>Bai, ngaubona nkongo wa ntini wene maakapi maingi kwa kuutalu. Ngauegelya li'nga aulinge, pi'ngi' kunani yake awesa pata litunda. Lakini paikite papipi nawo, aakibwenili kili'be ila maakapi sika, kwa mwanjaa nsimu wo waai wo pambikali. <verse eid="MRK 11:13"/><verse number="14" style="v" sid="MRK 11:14"/>Kwa nyo, Yesu ngaukosya lasi nkongo wu'lu' kaubakia, “Tumbulya nambi'yambi' ata milele, mundu kanealye litunda kai' bu'ka kunani yako.” Paabile kalongela go, banamasi' bake bai kabayu'wa.<verse eid="MRK 11:14"/></para>
  <para style="s">Yesu ayingya muluwa lwa nyumba ya Nnu'ngu'</para>
  <para style="r">(<ref loc="MAT 21:12-17">Mat 21:12-17</ref>, <ref loc="LUK 19:45-48">Luk 19:45-48</ref>, <ref loc="JHN 2:13-22">Yoa 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15"/>Bu'kapo, ngabaika ku Yelusalemu. Yesu paayingi muluwa lwa nyumba ya Nnu'ngu', ngatumbwa kwabi'nganga bandu babasulusage na babapi'mage ili'be muluwa lwo. Aapi'li'ngwi mamesa ga balu' babati'kwanage mbanje na iti'gu' ya asulusi ba ngunda. <verse eid="MRK 11:15"/><verse number="16" style="v" sid="MRK 11:16"/>Kai', annyi'ki'tiyeli mundu ywoywoti pi'ta apu'twile kigombo so sulusa paluwa lwa nyumba ya Nnu'ngu'. <verse eid="MRK 11:16"/><verse number="17" style="v" sid="MRK 11:17"/>Bu'kapo ngaayi'gana mayi'gi'yo gano, “Iandikilweli mu Mayi'gi'yo Mapeleteu panga, ‘Nyumba ya Nnu'ngu' yaakemelwa nyumba yo salilya kwa bandu ba mataipwa goti?’ Lakini mwenga mwiyu'yite mbango ya apokonyoli!”<verse eid="MRK 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18"/>Api'ndo ba dini na balimu ba salya pabayu'wine go, baatumbwi pala ndi'la ya kummulaga, lakini bannyogopage kwa mwanjaa kipi'nga soti sa bandu kisangalage mu'lu' mwaayi'ganage. <verse eid="MRK 11:18"/><verse number="19" style="v" sid="MRK 11:19"/>Payikite kitamwiyo, Yesu na banamasi' bake ngababu'ka pakilambo si'lu'.<verse eid="MRK 11:19"/></para>
  <para style="s">Liyi'gano bu'kana na ntini wauyu'mi</para>
  <para style="r">(<ref loc="MAT 21:20-22">Mat 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20"/>Pammalau' yake kindai' pabaabile kabapi'ta, baaubweni wu'lu' nkongo wa ntini uyu'mite woti ata ngi'ga yake. <verse eid="MRK 11:20"/><verse number="21" style="v" sid="MRK 11:21"/>Petili aaku'mbu'ki makowe gagaalongolile na ngammakia Yesu, “Mwalimu, uulinge wu'lu' nkongo wa ntini wawaaukosi lasi, uyu'mi.”<verse eid="MRK 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22"/>Yesu ngaabakia banamasi' bake, “Mupalikwa mumwu'bi'li Nnu'ngu'. <verse eid="MRK 11:22"/><verse number="23" style="v" sid="MRK 11:23"/>Kakape nimmakianga, mundu ywoywoti mana alongei kwo u'bi'lya na pangali kyukala pamwoyo wake, kakibakia kitu'mbi' si' kiyokoke pakibile kikatu'le mubaali, kakape ilu'a pangika. <verse eid="MRK 11:23"/><verse number="24" style="v" sid="MRK 11:24"/>Kwa nyo nendakummakia, gogoti gamugalu'ba kamusali, muu'bi'li panga mwendagapokya, ago gaalu'a panga ginu. <verse eid="MRK 11:24"/><verse number="25" style="v" sid="MRK 11:25"/>Na pamuyi'ma salya, mana mubile na mayu'mano na mundu ywi'ngi', munsami, li'nga Tati' binu bababile kunani bansami mwenga makosa ginu nyinyonyo.” <verse eid="MRK 11:25"/><verse number="26" style="v" sid="MRK 11:26"/>Lakini mwenga mana mukani kwasamya bi'ngi' makosa gabe, Tati' binu ba kunani bansamyali mwenga makosa ginu nyinyonyo.<verse eid="MRK 11:26"/></para>
  <para style="s">Makowe bu'kana na utawala wa Yesu</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mat 21:23-27</ref>, <ref loc="LUK 20:1-18">Luk 20:1-18</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27"/>Bai, Yesu na banamasi' bake ngabaika kai' Yelusalemu. Yesu paabile katyanga muluwa lwa nyumba ya Nnu'ngu', api'ndo ba dini, balimu ba salya na ayi'mi'li'ki ba bandu baatikunnyendelya. <verse eid="MRK 11:27"/><verse number="28" style="v" sid="MRK 11:28"/>Ngabannaluya, “Upanga makowe ga kwa utawala gani? Na nyai ywakupei utawala wu'?”<verse eid="MRK 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29"/>Yesu ngaabakia, “Nilu'a kunnaluya liswali limo, mana muniyangwile, nenga nilu'a kummakia kwa utawala gani nipanga makowe ga. <verse eid="MRK 11:29"/><verse number="30" style="v" sid="MRK 11:30"/>Yoani Ywabatisage aapatike utawala wo batisa bu'ka kwa nyai? Kwa Nnu'ngu' au kwa bandu? Muniyangwe.”<verse eid="MRK 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31"/>Nabembe ngabatumbwa laluyana bene na bene kababaya, “Mana tuyangwi panga utawala wake waabu'i kwa Nnu'ngu', aatulaluya, ‘Kwa kitumbu saku' mukotwike kumwu'bi'lya?’ <verse eid="MRK 11:31"/><verse number="32" style="v" sid="MRK 11:32"/>Kai', tuwesali baya waaumi kwa bandu.” (Baayogwipe kipi'nga sa bandu, kwa mwanjaa boti baau'bi'lile panga Yoani kakape aai nnondoli ywa Nnu'ngu'.) <verse eid="MRK 11:32"/><verse number="33" style="v" sid="MRK 11:33"/>Bai, ngabannyangwa Yesu, “Tutangiteli.” Nembe ngaabakia, “Nanenga nimmakiangali panga nipanga ga kwa utawala waku'.”<verse eid="MRK 11:33"/></para>
  <chapter eid="MRK 11"/>
  <chapter number="12" style="c" sid="MRK 12"/>
  <para style="s">Lukongo lwa nng'unda wa minjabibu na ali'mi</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mat 21:33-46</ref>, <ref loc="LUK 20:9-19">Luk 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1"/>
    <figure style="fig" alt="Winepress" file="04 Winepress.jpg" size="col" ref="12:1">Pandu po komangya minjabibu li'nga ipiye divai</figure>Bu'kapo, Yesu aatumbwi longela makowe ga kwa balu' api'ndo kwo tumya ngongo, “Mundu yumo aapandike minjabibu munng'unda wake na auti'li'ti'kiye lubi'go. Pakati yake aatengenise pandu po komangya minjabibu li'nga ipiye divai, na aasengite kisewe. Bu'kapo, ngaakolisa nng'unda wo kwa ali'mi no yabwa mwanja wa kunni'ma wi'ngi'. <verse eid="MRK 12:1"/><verse number="2" style="v" sid="MRK 12:2"/>Masu'ba go una pagatimile, ngantuma mpangakasi wake yumo kwa balu' ali'mi li'nga bampei iku'ta ya mauno gake. <verse eid="MRK 12:2"/><verse number="3" style="v" sid="MRK 12:3"/>Lakini balu' ali'mi ngabammoywa mpangakasi yu'lu', kunku'mbwa na kunki'li'bu'ya pangali kumpeya kikowe sosoti. <verse eid="MRK 12:3"/><verse number="4" style="v" sid="MRK 12:4"/>Yu'lu' mwene nng'unda ngantuma kai' mpangakasi ywi'ngi'. Yu'lu' nembe ngabanku'mbwa, ngabannumiya muntwe na kumpangya makowe malau muno. <verse eid="MRK 12:4"/><verse number="5" style="v" sid="MRK 12:5"/>Mwene nng'unda antumike kai' mpangakasi ywi'ngi', balu' ali'mi ngabammulaga. Bu'kapo ngaatuma bi'ngi' baingi, lakini balu' ali'mi baatikwalumiya na bi'ngi' kwabulaga. <verse eid="MRK 12:5"/><verse number="6" style="v" sid="MRK 12:6"/>Mwene nng'unda aaigali na mundu yumo bai, naywembe aai mwana wake ywampendile. Kuundi'la ngantuma kwa balu' ali'mi kabaya, ‘Nitangite panga balu'a kumwisimu mwana wangu'.’ <verse eid="MRK 12:6"/><verse number="7" style="v" sid="MRK 12:7"/>Lakini balu' ali'mi pabamweni kaisa, ngababakiyana, ‘Ayu' nga ywalu'a lisi nng'unda wu'. Bai, tummulage na nng'unda wu' upange witu.’ <verse eid="MRK 12:7"/><verse number="8" style="v" sid="MRK 12:8"/>Bai, ngabammoywa yu'lu' mwana na kummulaga, ntwi wake bautaikuli panja ya nng'unda wa minjabibu.”<verse eid="MRK 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9"/>Bu'kapo Yesu ngaalaluya, “Bai, yu'lu' mwene nng'unda wa minjabibu alu'a panga buli? Ywembe alu'a isa na kwabulaga balu' ali'mi. Bu'kapo, alu'a kwakolisa nng'unda wu'lu' ali'mi bi'ngi'. <verse eid="MRK 12:9"/><verse number="10" style="v" sid="MRK 12:10"/>Buli, munasomali Maandiko Mapeleteu gagabaya,</para>
  <para style="q1" vid="MRK 12:10">‘Liwe lyabalikani asengi,</para>
  <para style="q2" vid="MRK 12:10">nambi'yambi' lipangike liwe liku'lu' lya pakitumembe.<verse eid="MRK 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11"/>Likowe li' libu'i kwa Bwana,</para>
  <para style="q2" vid="MRK 12:11">nalyembe lya ayabu muno kasitu.’”<verse eid="MRK 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12"/>Bai, abo api'ndo baapalike ndi'la ya kummoywa Yesu, kwa mwanjaa baatangite panga ngongo yo aalongelyage bembe. Lakini kwa kitumbu sa kukiyogopa kipi'nga sa bandu, ngabakotoka no bu'ka.<verse eid="MRK 12:12"/></para>
  <para style="s1">Li'pa koli kwa Kaisali</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mat 22:15-22</ref>, <ref loc="LUK 20:20-26">Luk 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13"/>Bai, bi'ngi' ba Mafalisayo na bandu ba kipi'nga sa Helode baatumilwe bampi'ndi'ke Yesu kwo pi'tya milongelo yake. <verse eid="MRK 12:13"/><verse number="14" style="v" sid="MRK 12:14"/>Baatikunyendelya na kunnaluya, “Mwalimu, tutangite panga wenga wa mundu wa ukakape. Kai', unnyogopali mundu kwa mwanjaa, uyi'me wa mundu kili'be lili kasako, lakini uyi'gana ndi'la ya Nnu'ngu' kwa ukakape. Tubakiye, panga salya ya Musa yendatuyi'ki'ti'ya li'pa koli kwa Kaisali, nkulungwa wa Roma, au lili? Tupalikwa tuli'pe au lili?” <verse eid="MRK 12:14"/><verse number="15" style="v" sid="MRK 12:15"/>Lakini kwa mwanjaa aatangite panga bandu balu' anapiki, ngaabakia, “Mwanjaa namani munipi'ndi'ka? Munileti lwela lumo pano li'nga nilulinge.” <verse eid="MRK 12:15"/><verse number="16" style="v" sid="MRK 12:16"/>Ngabannetya lu'lu' lwela. Nembe ngaalaluya, “Kuminyo ku' na lina li' lyaliandikilwe, lya nyai?” Ngabannyangwa, “Kaisali.” <verse eid="MRK 12:16"/><verse number="17" style="v" sid="MRK 12:17"/>Bai, Yesu ngaabakia, “Ga Kaisali mumpei Kaisali na ga Nnu'ngu' mumpei Nnu'ngu'.” Boti baatisangala muno.<verse eid="MRK 12:17"/></para>
  <para style="s">Likowe bu'kana na uyu'ki</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mat 22:23-33</ref>, <ref loc="LUK 20:27-40">Luk 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18"/>Bu'kapo, Masadukayo, balu' babakana u'bi'lya panga kubile na lisu'ba lyo yu'yi'lwa kwa awi'li, ngabamwisilya Yesu na kunnaluya, <verse eid="MRK 12:18"/><verse number="19" style="v" sid="MRK 12:19"/>“Mwalimu, Musa aatuandiki panga mundu ywakobike mana awile pangali papa mwana, ipalikwa nnongowe ankobeke aywo nnwawa nng'wi'li'kwa li'nga ampapi nnongowe bana. <verse eid="MRK 12:19"/><verse number="20" style="v" sid="MRK 12:20"/>Bai, kwabile na alongo saba, aywo mmele aakobike nnwawa lakini yu'lu' nnalu'me awile pangali papa mwana. <verse eid="MRK 12:20"/><verse number="21" style="v" sid="MRK 12:21"/>Ywenebi'li' ngankobeka yu'lu' nnwawa, nembe ngawaa kai' pangali papa mwana. Ngaipanga nyinyo kai' kwa nnongo ywenetatu. <verse eid="MRK 12:21"/><verse number="22" style="v" sid="MRK 12:22"/>Na boti saba bankobike nnwawa yu'lu' bu'ka po waa ywi'ngi', lakini baawile pangali papa bana. Kuundi'la, yu'lu' nnwawa nembe ngawaa. <verse eid="MRK 12:22"/><verse number="23" style="v" sid="MRK 12:23"/>Bai, lisu'ba lyo yu'yi'lwa babawile, ywembe aapanga nnyumbo wa nyai, kwa mwanjaa aakobekilwe na balu' alongo boti saba?” <verse eid="MRK 12:23"/><verse number="24" style="v" sid="MRK 12:24"/>Yesu aatikwayangwa, “Mwobite kwa kitumbu so kotoka tanga mwagaandikilwe Mayi'gi'yo Mapeleteu na makakala ga Nnu'ngu'. <verse eid="MRK 12:24"/><verse number="25" style="v" sid="MRK 12:25"/>Kwa mwanjaa awi'li pabaalu'a yu'ka baakobekali wala baaku'ndali, kati mwababile malaika ba kunani. <verse eid="MRK 12:25"/><verse number="26" style="v" sid="MRK 12:26"/>No bu'kana na uyu'ki wa babawile, munasomali mukitabu sa salya ya Musa galu' maandiko gagalongelya bu'kana na si'lu' kiwi'mbi' sasaayakite mwoto? Nnu'ngu' ammakie Musa, ‘Nenga na Nnu'ngu' wa Bulaimu, Nnu'ngu' wa Isaki, na Nnu'ngu' wa Yakobi.’ <verse eid="MRK 12:26"/><verse number="27" style="v" sid="MRK 12:27"/>Ywembe Nnu'ngu' ywa bandu babawile lili, ywembe Nnu'ngu' wa bandu akoto. Mwenga mutioba muno.”<verse eid="MRK 12:27"/></para>
  <para style="s1">Amuli ngu'lu'</para>
  <para style="r">(<ref loc="MAT 22:34-40">Mat 22:34-40</ref>, <ref loc="LUK 10:25-28">Luk 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28"/>Palu' Yesu pataukanage na Masadukayo, kwabile na mwalimu yumo ywa salya ya Musa, ywembe aatangite panga Yesu aayangwi wiso. Bai, aatikumwegelya na kunnaluya, “Amuli yaku' yaibile ngu'lu' pi'ta yoti?” <verse eid="MRK 12:28"/><verse number="29" style="v" sid="MRK 12:29"/>Yesu aatiyangwa, “Amuli ngu'lu' nga yi'no, ‘Upi'kani wenga wa Isilaili, Bwana Nnu'ngu' witu nga Bwana yumo bai. <verse eid="MRK 12:29"/><verse number="30" style="v" sid="MRK 12:30"/>Umpende Bwana Nnu'ngu' wako kwa mwoyo wako woti, kwa loo yako yoti, kwa malango gako goti na kwa makakala gako goti.’ <verse eid="MRK 12:30"/><verse number="31" style="v" sid="MRK 12:31"/>Na amuli yenebi'li' nga yi'no, ‘Umpende ywa papipi yako kati mwawipenda wamwene.’ Ntu'pu' amuli yi'ngi' ngu'lu' kulikoni yi'no ibi'li'.”<verse eid="MRK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32"/>Yu'lu' mwalimu ywa salya ya Musa ngammakia Yesu, “Ulongei wiso Mwalimu, panga Nnu'ngu' yumo kisake, wala ntu'pu' Nnu'ngu' ywi'ngi' ila ywembe. <verse eid="MRK 12:32"/><verse number="33" style="v" sid="MRK 12:33"/>Na mundu apalikwa kumpenda Nnu'ngu' kwa mwoyo wake woti, kwa malango gake goti na kwa makakala gake goti. Nembe apalikwa kumpenda ywa papipi kati mu'lu' mwaipenda mwene. Makowe go gangama muno kulikoni salaka ya nyama yo langamisa pamwoto, na salaka yi'ngi' yoti.” <verse eid="MRK 12:33"/><verse number="34" style="v" sid="MRK 12:34"/>Nembe Yesu pamweni aywo mundu ayangwi kwa malango, ngammakia, “Wenga ubileli kuutalu no yingya muukulungwa wa Nnu'ngu'.” Payomwi longela go, ntu'pu' mundu ywalowite kunnaluya kai' Yesu likowe lyolyoti.<verse eid="MRK 12:34"/></para>
  <para style="s1">Likowe bu'kana na Kilisitu</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mat 22:41-46</ref>, <ref loc="LUK 20:41-44">Luk 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35"/>Yesu paabile kayi'gana muluwa lwa nyumba ya Nnu'ngu', aatilaluya, “Mboni balimu ba salya ya Musa babaya panga Kilisitu mwana wa Daudi?” <verse eid="MRK 12:35"/><verse number="36" style="v" sid="MRK 12:36"/>Daudi mwene kalongoyelwa na Loo Mpeleteu aatibaya,</para>
  <para style="q1" vid="MRK 12:36">‘Bwana Nnu'ngu' ammakie bwana wangu',</para>
  <para style="q2" vid="MRK 12:36">Utame kummalyo gangu',</para>
  <para style="q1" vid="MRK 12:36">mpaka panaalu'a kwabi'ka andumu bako pai' ya magu'lu' gako.’<verse eid="MRK 12:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 12:37"/>“Daudi mwene ankema Kilisitu ‘Bwana.’ Kwa nyo, Kilisitu apangali mwana wake bai, ila Bwana wake kai'.” Si'lu' kipi'nga sa bandu saai kakimpi'kania kwo napusika.<verse eid="MRK 12:37"/></para>
  <para style="s">Yesu aaking'indya bandu bu'kana na balimu ba salya</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mat 23:1-36</ref>, <ref loc="LUK 20:45-47">Luk 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38"/>Mumayi'gano gake aatikwabakia, “Mwili'ndi'le bu'kana na balimu ba salya ya Musa, bembe bapenda tyanga bawati makanju malaso, no penda pangilwa abali na bandu kwa isima mumasoko. <verse eid="MRK 12:38"/><verse number="39" style="v" sid="MRK 12:39"/>Kai', bembe bapendi tama muiti'gu' ya nnu'ngi' mumayumba ga kunnu'ba Nnu'ngu' no penda isimilwa muiyambo. <verse eid="MRK 12:39"/><verse number="40" style="v" sid="MRK 12:40"/>Bapokonywa mali ya alwawa awi'li'ka no salya sala ndaso li'nga bayu'wanike na bandu. Kwa kitumbu si', balu'a ukumilwa munomuno.”<verse eid="MRK 12:40"/></para>
  <para style="s">Salaka ya nnwawa nng'wi'li'kwa</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luk 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41"/>Yesu aatami papipi na lisanduku lya amana ya nyumba ya Nnu'ngu', kaalingulya bandu mwabayi'ya mbanje nkati ya lisanduku li'lu'. Matayili baingi baayi'i mbanje yambone nkati ya lisanduku. <verse eid="MRK 12:41"/><verse number="42" style="v" sid="MRK 12:42"/>Aaisi nnwawa yumo nng'wi'li'kwa nki'ba, ngapiya ela ibi'li' bai. <verse eid="MRK 12:42"/><verse number="43" style="v" sid="MRK 12:43"/>Bai, Yesu aakemite banamasi' bake na kwabakia, “Kakape nimmakianga, ayu' nnwawa nng'wi'li'kwa nki'ba, apiyite mbanje yambone muno kulikoni boti babaayi'ile nkati ya lisanduku lya salaka. <verse eid="MRK 12:43"/><verse number="44" style="v" sid="MRK 12:44"/>Kwa mwanjaa bi'ngi' baabawi bu'ka mumbanje yababile nayo, lakini ywembe kwa uki'ba wabile nawo, aapiyite ili'be yoti yabile nayo mumaisa gake.”<verse eid="MRK 12:44"/></para>
  <chapter eid="MRK 12"/>
  <chapter number="13" style="c" sid="MRK 13"/>
  <para style="s">Yesu alongelya bu'kana no bomolelwa kwa nyumba ya Nnu'ngu'</para>
  <para style="r">(<ref loc="MAT 24:1-2">Mat 24:1-2</ref>, <ref loc="LUK 21:5-6">Luk 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1"/>Yesu paabile kapita bu'ka muluwa lwa nyumba ya Nnu'ngu', yumo ywa banamasi' bake ngammakia, “Mwalimu, lingulya maliwe ga mwagagolwike na mayumba ga maku'lu'!” <verse eid="MRK 13:1"/><verse number="2" style="v" sid="MRK 13:2"/>Yesu aatiyangwa, “Mwendagabona mayumba ga maku'lu'? Lyaigalali ata liwe limo panani ya liwe li'ngi', goti gabomwanilwa.”<verse eid="MRK 13:2"/></para>
  <para style="s">Tabu na ngu'su'mbu'</para>
  <para style="r">(<ref loc="MAT 24:3-14">Mat 24:3-14</ref>, <ref loc="LUK 21:7-19">Luk 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3"/>Yesu paabile atami pa Kitu'mbi' sa Minjaituni kalingulya ku nyumba ya Nnu'ngu', Petili, Yakobi, Yoani na Andelea ngabannaluya pakiyi'ki'ya, <verse eid="MRK 13:3"/><verse number="4" style="v" sid="MRK 13:4"/>“Tulu'ba utubakiye makowe ga gaugabaite gaapangika pakubawi? Na ki'li' gani sasalu'a kutulaya twenga tutange panga makowe go gapalapitya?”<verse eid="MRK 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5"/>Yesu ngaabakia, “Mulinguli wiso, mwakane kongelwa na mundu. <verse eid="MRK 13:5"/><verse number="6" style="v" sid="MRK 13:6"/>Bandu baingi baaisa kwa lina lyangu' kababaya panga, ‘Nenga ngana Kilisitu’, na abo baalu'a kwakonga baingi. <verse eid="MRK 13:6"/><verse number="7" style="v" sid="MRK 13:7"/>Pamwayu'wa makowe ga ngondo na mayu'yu'to gake kanemwayogope. Makowe go gapalikwa gapiti wi'ti', lakini kuundi'la yene kunaikali. <verse eid="MRK 13:7"/><verse number="8" style="v" sid="MRK 13:8"/>Kwa mwanjaa nni'ma waayu'mana na nni'ma wi'ngi', na ukulungwa waayu'mana na ukulungwa wi'ngi'. Kwalu'a ba na nnendemo wa nni'ma mumatapo mbali'mbali', kai' kwalu'a ba na njala ngu'lu'. Na aga goti gaalu'a panga kati mwalupanga lwu'ngu' lwo papa mwana.”<verse eid="MRK 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9"/>“Lakini mwenga mwilinge, kwa mwanjaa bandu baalu'a kumpeleka kumankama na kunku'mbwa mumayumba ga kunnu'ba Nnu'ngu'. Mwapelekelwa kwa atawala na akulungwa kwa kitumbu sangu' li'nga munikong'ondeli kwabe. <verse eid="MRK 13:9"/><verse number="10" style="v" sid="MRK 13:10"/>Ipalikwa abali inannoga ialilwe wi'ti' kwa bandu ba kila nni'ma. <verse eid="MRK 13:10"/><verse number="11" style="v" sid="MRK 13:11"/>Na pamwalu'a boyolelwa no sitakilwa, kanemwaauke kwo wasa galu' gamwalu'a yangwa, mwenga mwalongele likowe lyolyoti lyamwapeyelwa papalu'palu'. Kwa mwanjaa mwalongelali mwenga, ila aalongela Loo Mpeleteu. <verse eid="MRK 13:11"/><verse number="12" style="v" sid="MRK 13:12"/>Nnongo aansongya nnongowe li'nga abulagilwe, na tati' kunsongya mwana wake, nabembe bana baalu'a kwagalambukya abelei babe li'nga babulagilwe. <verse eid="MRK 13:12"/><verse number="13" style="v" sid="MRK 13:13"/>Na bandu boti baalu'a kunsukwa kwa kitumbu sa lina lyangu', lakini ywaalu'a komeya mpaka kuundi'la aalu'a kosopolelwa.<verse eid="MRK 13:13"/></para>
  <para style="s">Siki ngu'lu'</para>
  <para style="r">(<ref loc="MAT 24:15-28">Mat 24:15-28</ref>, <ref loc="LUK 21:20-24">Luk 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14"/>“Lakini pamwakibona kili'be sakisukwa Nnu'ngu' na sakileta usapu kiyi'mi'kilwe pandu papeleteu (ywasoma atange), apo babaalu'a ba ku Yudea baabutuki muitu'mbi'. <verse eid="MRK 13:14"/><verse number="15" style="v" sid="MRK 13:15"/>Ywabile panani ya mwagala wa nyumba, kaneauluke yingya nnyumba yendatola kili'be. <verse eid="MRK 13:15"/><verse number="16" style="v" sid="MRK 13:16"/>Na ywabile kunng'unda kaneagalambuke tola likoti lyake, ila apalikwa atile. <verse eid="MRK 13:16"/><verse number="17" style="v" sid="MRK 13:17"/>Bakibona alwawa atopelwe na babayongeya bana masu'ba go! <verse eid="MRK 13:17"/><verse number="18" style="v" sid="MRK 13:18"/>Munnu'be Nnu'ngu' li'nga makowe go gaakane pitya nsimu wa kyuku. <verse eid="MRK 13:18"/><verse number="19" style="v" sid="MRK 13:19"/>Kwa mwanjaa masu'ba go gaapanga ga siki ngu'lu', siki kati yo inapityali apo nsu'gu' tangu' Nnu'ngu' paumbite dunia mpaka li'no, na yapityali kai' katu. <verse eid="MRK 13:19"/><verse number="20" style="v" sid="MRK 13:20"/>Ikapangage Bwana akotwike pu'ngu'ya masu'ba go, ntu'pu' ata mundu yumo ywapele kosopolelwa. Lakini kwa kitumbu sa balu' babasaulilwe na Nnu'ngu', masu'ba go gapu'ngu'yilwe.<verse eid="MRK 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21"/>“Nsimu wo manaitei mundu kammakia, ‘Lingulya, Kilisitu abile pano’ au ‘Abile palu'’, kanemwau'bi'li. <verse eid="MRK 13:21"/><verse number="22" style="v" sid="MRK 13:22"/>Kwa mwanjaa baapitya ‘Kikilisitu’ ba ubu'su' pamope na alondoli ba ubu'su', nabembe baalaya myanju na mangelongelo li'nga baakonge bandu, kai' mana iwesekine ata balu' babasaulilwe na Nnu'ngu'. <verse eid="MRK 13:22"/><verse number="23" style="v" sid="MRK 13:23"/>Lakini mwenga mwili'ndi'le, nenga nimmakie makowe goti gabile balo ganapityali.<verse eid="MRK 13:23"/></para>
  <para style="s">Isa kwa Mwana wa Mundu</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mat 24:29-31</ref>, <ref loc="LUK 21:25-28">Luk 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24"/>“Bu'ka pa siki ya masu'ba galu', lisu'ba lyabaa mulubi'ndu' na mwei wapiyali bweya wake. <verse eid="MRK 13:24"/><verse number="25" style="v" sid="MRK 13:25"/>Ndondwa yalu'a tu'mbu'ka bu'ka kumaunde, makakala go goti ga kunani gaalu'a kunyangunya. <verse eid="MRK 13:25"/><verse number="26" style="v" sid="MRK 13:26"/>Apo nga pabammona Mwana wa Mundu kaisa bu'ka kumaunde kwa makakala maku'lu' na utukupu. <verse eid="MRK 13:26"/><verse number="27" style="v" sid="MRK 13:27"/>Nembe aatuma malaika bake li'nga baakongwe baasawile bu'ka mumbande yoti nsese ya dunia, bu'ka kila pandu pa dunia, mpaka kuundi'la ya kunani.<verse eid="MRK 13:27"/></para>
  <para style="s">Mayi'gano ga nkongo wa ntini</para>
  <para style="r">(<ref loc="MAT 24:32-35">Mat 24:32-35</ref>, <ref loc="LUK 21:29-33">Luk 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28"/>“Kwa nkongo wa ntini mwiyi'gane lukongo lu'no, palu' ndambi' yake paitumbwa ipuka no piya maakapi, mutangite panga nsimu wo li'ma wendaegelya. <verse eid="MRK 13:28"/><verse number="29" style="v" sid="MRK 13:29"/>Namwenga nyinyonyo, pamugabona makowe go kagatumbwa pangika, mutange panga Mwana wa Mundu abile papipi na niango. <verse eid="MRK 13:29"/><verse number="30" style="v" sid="MRK 13:30"/>Kakape nimmakianga, lubelekwo lu'no lwaalu'a pi'tali pangali pitya makowe ago goti. <verse eid="MRK 13:30"/><verse number="31" style="v" sid="MRK 13:31"/>Kunani na padunia kwalu'a pi'ta lakini mayi'gi'yo gangu' katu gaapi'tali.<verse eid="MRK 13:31"/></para>
  <para style="s">Ntu'pu' ywatangite lisu'ba wala saa</para>
  <para style="r">(<ref loc="MAT 24:36-44">Mat 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32"/>“Lakini bu'kana na lisu'ba au saa yi'lu', ntu'pu' mundu ywatangite ata malaika ba kunani wala Mwana, ila Tati' kisabe bai. <verse eid="MRK 13:32"/><verse number="33" style="v" sid="MRK 13:33"/>Mwili'ndi'le, mukeleke, kwa mwanjaa mutangiteli nsimu wo pawatimya. <verse eid="MRK 13:33"/><verse number="34" style="v" sid="MRK 13:34"/>Yalu'a panga kati mundu ywayabwa mwanja na kwalekya apangakasi bake bayi'mi'like, kila mundu na lyengo lyake, na kummakia nni'ndi'li wa nniango abe minyo. <verse eid="MRK 13:34"/><verse number="35" style="v" sid="MRK 13:35"/>Mukeleke, kwa mwanjaa mutangiteli mwene nyumba alu'a buya pakubawi, pi'ngi' iwesa panga kitamwiyo, meku, bulabula au kindai'. <verse eid="MRK 13:35"/><verse number="36" style="v" sid="MRK 13:36"/>Mwili'ndi'le, mana aaisa kwa kimuimu aakane kunkolya mugonjike lugono. <verse eid="MRK 13:36"/><verse number="37" style="v" sid="MRK 13:37"/>Makowe ganimmakia mwenga, nabakia boti. Mwili'ndi'le!”<verse eid="MRK 13:37"/></para>
  <chapter eid="MRK 13"/>
  <chapter number="14" style="c" sid="MRK 14"/>
  <para style="s">Ndi'la ya kummulaga Yesu</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mat 26:1-5</ref>, <ref loc="LUK 22:1-2">Luk 22:1-2</ref>, <ref loc="JHN 11:45-53">Yoa 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1"/>Gaaigali masu'ba gabi'li' bai ika kusi'li'ku'si'li'ku' ya Pasika na ya Makati Gangalu'la, api'ndo ba dini na balimu ba salya ya Musa bapalage ndi'la ya kummoywa Yesu kwa kinunu na kummulaga. <verse eid="MRK 14:1"/><verse number="2" style="v" sid="MRK 14:2"/>Kwa mwanjaa baabaite, “Kanetupange likowe li' pa si'li'ku'si'li'ku', bandu baakane panga puyo.”<verse eid="MRK 14:2"/></para>
  <para style="s">Yesu apakayilwa mauta ganannungya</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mat 26:6-13</ref>, <ref loc="JHN 12:1-8">Yoa 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3"/>Yesu aabile Betania munyumba ya Simoni ywaabile na matana patumbu. Pabaabile kabalya, nnwawa yumo aayingi nnyumba. Abile na supa ya liwe yaibile na mauta ganannungya gene bei ngu'lu'. Bu'kapo ngati'kwana nkano wa yi'lu' supa no u'lu'ki'ya mauta go panani ya ntwe wa Yesu. <verse eid="MRK 14:3"/><verse number="4" style="v" sid="MRK 14:4"/>Bi'ngi' ba bandu babaabile palu' baatiusika muno kwa galu' gaagapangite yu'lu' nnwawa no bakiyana, “Kwa mwanjaa namani nyamana mali kati yi'? <verse eid="MRK 14:4"/><verse number="5" style="v" sid="MRK 14:5"/>Mauta ga galu'e pi'mi'yi'lwa kwa ela yambone yo kombwa kwapeya masikini.” Ngabammendya aywo nnwawa kwa nyongo.<verse eid="MRK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6"/>Lakini Yesu ngaabakia, “Mboni mwendakumwauya ayu' nnwawa? Munneke! Ywembe anipangi likowe linannoga muno. <verse eid="MRK 14:6"/><verse number="7" style="v" sid="MRK 14:7"/>Kwa mwanjaa masikini mwalu'a baa pamope nabo masu'ba goti, kila pamupala kwapeya mwendakwapeya, lakini nenga nalu'a baali pamope na mwenga masu'ba goti. <verse eid="MRK 14:7"/><verse number="8" style="v" sid="MRK 14:8"/>Ayu' nnwawa anipangi li'lu' lyaliwesite, aniu'lu'kiye mauta ganannungya li'nga kunibi'ka wiso kwo sikilwa kwangu'. <verse eid="MRK 14:8"/><verse number="9" style="v" sid="MRK 14:9"/>Kakape nimmakianga, kwa ngu'mbu'ku'mbu' ya nnwawa yu', likowe lyalipangite lyabayilwa kila pandu paialilwa abali inannoga mudunia yoti.”<verse eid="MRK 14:9"/></para>
  <para style="s">Yuda ayi'ki'tya kunsongya Yesu</para>
  <para style="r">(<ref loc="MAT 26:14-16">Mat 26:14-16</ref>, <ref loc="LUK 22:3-6">Luk 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10"/>Yuda Isikalioti, yumo ywa balu' banamasi' ku'mi na abi'li', aayi'i kwa api'ndo ba dini li'nga kunsongya Yesu kwabe. <verse eid="MRK 14:10"/><verse number="11" style="v" sid="MRK 14:11"/>Pabapatike abali yi'lu' baatipulaika muno, nabembe ngabayi'ki'tyana nakwe kumpeya mbanje. Bu'kapo, Yuda ngatumbwa pala lipala linannoga lya kunsongya Yesu.<verse eid="MRK 14:11"/></para>
  <para style="s1">Kwibi'ka wiso Pasika</para>
  <para style="r">(<ref loc="MAT 26:17-25">Mat 26:17-25</ref>, <ref loc="LUK 22:7-14">Luk 22:7-14</ref>, <ref loc="LUK 21:-1-23">21-23</ref>, <ref loc="JHN 13:21-30">Yoa 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12"/>Lisu'ba lyo yingilya kalamu ya si'li'ku'si'li'ku' ya Makati Gangalu'la, napo nga pabasinjike mwana ngondolo wa Pasika, banamasi' ba Yesu baatikunnaluya, “Upala tuyende kwaku' tukakubi'ki wiso kalamu ya Pasika?”<verse eid="MRK 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13"/>Bai, Yesu aatumike abi'li' ba banamasi' bake kaabakia, “Muyende kumisengo, akwo mukankolya nnalu'me yumo apu'twi kibi'ga sa masi'. Mukammi'ngi'ye, <verse eid="MRK 14:13"/><verse number="14" style="v" sid="MRK 14:14"/>mpaka panyumba yaalu'a yingya, mukammakie mwene nyumba, ‘Mwalimu alaluya panga sumba sake so li'lya kalamu ya Pasika ywembe na banamasi' bake saku?’ <verse eid="MRK 14:14"/><verse number="15" style="v" sid="MRK 14:15"/>Naywembe aalu'a kunnangya sumba kiku'lu' kugolopwa sakibi'kilwe wiso no nemekelwa, na mwenga mukabi'ke wiso ilyo.”<verse eid="MRK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16"/>Banamasi' ngababu'ka yenda kumisengo, ngabakikolya kila kili'be kibile kati mu'lu' mwababakiyilwe na Yesu. Nabembe ngababi'ka wiso kalamu ya Pasika. <verse eid="MRK 14:16"/><verse number="17" style="v" sid="MRK 14:17"/>Pakiikite kitamwiyo, Yesu na banamasi' bake ku'mi na abi'li' ngabaika pa yi'lu' nyumba. <verse eid="MRK 14:17"/><verse number="18" style="v" sid="MRK 14:18"/>Nabembe pabaabile pakitamo so lya, Yesu aatibaya, “Kakape nimmakianga, yumo pakati yinu alu'a nisongya.” <verse eid="MRK 14:18"/><verse number="19" style="v" sid="MRK 14:19"/>Apo banamasi' bake baatumbwi nyopa kabalaluyana bene na bene, “Buli, iwesapanga nenga?” <verse eid="MRK 14:19"/><verse number="20" style="v" sid="MRK 14:20"/>Yesu ngaayangwa, “Yumo pakati yinu mwenga ku'mi na abi'li', yu'lu' ywasuyite likati pamope nanenga mukibakuli. <verse eid="MRK 14:20"/><verse number="21" style="v" sid="MRK 14:21"/>Kwa mwanjaa Mwana wa Mundu endawaa kati mu'lu' Maandiko Mapeleteu mwagabaya kwo bu'kana na ywembe, lakini akibona mundu yu'lu' ywansongya! Ilu'e panga nantali kwake akakotoka belekwa.”<verse eid="MRK 14:21"/></para>
  <para style="s">Kalamu ya Bwana</para>
  <para style="r">(<ref loc="MAT 26:26-30">Mat 26:26-30</ref>, <ref loc="LUK 22:14-20">Luk 22:14-20</ref>, <ref loc="1CO 11:23-25">1Kol 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22"/>Pabaabile kabalya, Yesu aatweti likati ngasukulu Nnu'ngu', bu'kapo aatikulimetwana na kwapeya banamasi' bake kaabakia, “Mutole mulye, yi'no nga yi'ga yangu'.” <verse eid="MRK 14:22"/><verse number="23" style="v" sid="MRK 14:23"/>Bu'kapo, aatweti nnobo wa divai, ngansukulu Nnu'ngu' na kwapeya, boti ngabanywelya munnobo wo. <verse eid="MRK 14:23"/><verse number="24" style="v" sid="MRK 14:24"/>Yesu ngaabakia, “Yi'no nga myai yangu' ya lilagano lya Nnu'ngu' yaiyitanika kwa kitumbu sa baingi. <verse eid="MRK 14:24"/><verse number="25" style="v" sid="MRK 14:25"/>Kakape nimmakianga, tumbulya nambi'yambi' nanywali kai' divai ya njabibu mpaka lisu'ba li'lu' lya Ukulungwa wa Nnu'ngu' panainywa yayambi'.” <verse eid="MRK 14:25"/><verse number="26" style="v" sid="MRK 14:26"/>Nabembe pabayomwi yi'mba mwambo, ngababu'ka yenda ku Kitu'mbi' sa Minjaituni.<verse eid="MRK 14:26"/></para>
  <para style="s1">Yesu alondwa panga Petili aalu'a kunkana</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mat 26:31-35</ref>, <ref loc="LUK 22:31-34">Luk 22:31-34</ref>, <ref loc="JHN 13:36-38">Yoa 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27"/>Yesu ngaabakia, “Mwenga mwaboti mwanileka, kwa mwanjaa iandikilwe mu Maandiko Mapeleteu,</para>
  <para style="q1" vid="MRK 14:27">‘Naalu'a kummulaga nsungi,</para>
  <para style="q2" vid="MRK 14:27">na ngondolo boti baalu'a talanganika.’<verse eid="MRK 14:27"/></para>
  <para style="m">
    <verse number="28" style="v" sid="MRK 14:28"/>Lakini bu'ka pauyu'ki wangu', naalu'a kunnongolya yenda ku Galilaya.” <verse eid="MRK 14:28"/><verse number="29" style="v" sid="MRK 14:29"/>Petili ngammakia, “Ata manaitei boti baakuleka, nenga nakuleka lili.” <verse eid="MRK 14:29"/><verse number="30" style="v" sid="MRK 14:30"/>Yesu ngammakia, “Kakape nikubakia, kilo si'no sa li'no njogolo abile balo bi'ka pabi'li', wanikana mala itatu.” <verse eid="MRK 14:30"/><verse number="31" style="v" sid="MRK 14:31"/>Lakini Petili ngakong'ondelya baya, “Ata manaitei waa pamope nawenga, katu nakukanali.” Na balu' bi'ngi' boti ngababaya nyinyonyo.<verse eid="MRK 14:31"/></para>
  <para style="s">Yesu asali kukyati' sa Getisemani</para>
  <para style="r">(<ref loc="MAT 26:35-46">Mat 26:35-46</ref>, <ref loc="LUK 22:39-46">Luk 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32"/>Ngabaika pakyati' sakikemelwa Getisemani, Yesu ngaabakia banamasi' bake, “Mutame pano munili'nde, nenga nendasali.” <verse eid="MRK 14:32"/><verse number="33" style="v" sid="MRK 14:33"/>Bu'kapo ngantola Petili, Yakobi na Yoani, no tumbwa nyopa no auka. <verse eid="MRK 14:33"/><verse number="34" style="v" sid="MRK 14:34"/>Ngaabakia, “Mwoyo wangu' wenda nyopa muno, ata pipi no waa. Mutame pano, mukeleke.” <verse eid="MRK 14:34"/><verse number="35" style="v" sid="MRK 14:35"/>Bu'kapo ngaegelya nnu'ngi' pasini, ngaitu'ya pai' ukukama. Ngalu'ba kabaya panga mana iwesekine, saa yi'lu' ya ngu'su'mbu' impi'ti kuutalu. <verse eid="MRK 14:35"/><verse number="36" style="v" sid="MRK 14:36"/>Ngabaya, “Mwenga mwa Tati'! Ntu'pu' sangali kombolwa kasinu, ninnu'ba munibu'ki'ye agu' nnobo wa ngu'su'mbu'. Lakini kaneipange kati mwanipendi nenga, ila ipange kati mwamupendi mwenga.”<verse eid="MRK 14:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37"/>Paabuyangine, ngaakolya bagonjike lugono. Ngammakia Petili, “Simoni, ugonjike? Ata keleka kwa lisaa limo bai ukombwili? <verse eid="MRK 14:37"/><verse number="38" style="v" sid="MRK 14:38"/>Mukeleke no sali li'nga mwakane yingya mumapayilwo, kwa mwanjaa loo ipenda panga makowe manogau, lakini yi'ga yinu nga kigopi.” <verse eid="MRK 14:38"/><verse number="39" style="v" sid="MRK 14:39"/>Ngayenda sali kai' kaki'li'bu'kya mayi'gi'yo gaagalu'galu'.<verse eid="MRK 14:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 14:40"/>Paabuyangine kai' aakwembite bagonjike, kwa mwanjaa minyo gabe gaatopilwe na lugono, na baatangiteli saku' sa kunnyangwa.<verse eid="MRK 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41"/>Paabuyangine pampanda patatu, ngaabakia, “Balo mukagonja no pu'mu'lya? Ili'ngani lelo! Saa itimile. Mulinguli, Mwana wa Mundu akamuyilwa mumaboko ga bene sambi. <verse eid="MRK 14:41"/><verse number="42" style="v" sid="MRK 14:42"/>Muyumuke tubu'ke. Lingulyange, yu'lu' ywapala nisongya aegelile.”<verse eid="MRK 14:42"/></para>
  <para style="s1">Yesu endaboyolwa</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mat 26:47-56</ref>, <ref loc="LUK 22:47-53">Luk 22:47-53</ref>, <ref loc="JHN 18:3-12">Yoa 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43"/>Yesu paabile balo kalongela, Yuda, yumo ywa balu' banamasi' ku'mi na abi'li', ngaisa pamope na kipi'nga sa bandu babaapu'twi mapanga na mandolonga. Bandu bo baatumilwe na api'ndo ba dini, balimu ba salya ya Musa na api'ndo ba bandu. <verse eid="MRK 14:43"/><verse number="44" style="v" sid="MRK 14:44"/>Yuda yu'lu' ywansongya aayomwile kwapeya mwasu wu' kabaya, “Yu'lu' ywanannonia ngaywembe. Mummoywe na kumpeleka kwa kunni'ndi'la.”<verse eid="MRK 14:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45"/>Yuda paikite bai, ngannyendelya Yesu popopo na kummakia, “Mwalimu!” Bu'kapo ngannonia. <verse eid="MRK 14:45"/><verse number="46" style="v" sid="MRK 14:46"/>Bai, balu' bandu ngabammoywa Yesu na kuntaba. <verse eid="MRK 14:46"/><verse number="47" style="v" sid="MRK 14:47"/>Yumo ywa balu' babaayi'mi pamope na Yesu aasolomwi lipanga lyake na kumpoteka ntumisi wa mpi'ndo nku'lu' ywa dini na kummu'ya lisikilo. <verse eid="MRK 14:47"/><verse number="48" style="v" sid="MRK 14:48"/>Bu'kapo Yesu ngaabakia, “Mwisi na mapanga na mandolonga li'nga kuniboywa, baya kwake kati nenga nampokonyoli. <verse eid="MRK 14:48"/><verse number="49" style="v" sid="MRK 14:49"/>Masu'ba goti naabile pamope na mwenga kaniyi'gana muluwa lwa Nyumba ya Nnu'ngu', na mwenga muniboywili. Lakini makowe ga gapangike li'nga Maandiko Mapeleteu gatimi.”<verse eid="MRK 14:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50"/>Banamasi' bake boti ngabanneka no tila.<verse eid="MRK 14:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51"/>Lakini mwinsembe yumo ywaawati ngu'bo mukibuno, aayendeli kummi'ngi'ya Yesu. Nabembe ngabammoywa. <verse eid="MRK 14:51"/><verse number="52" style="v" sid="MRK 14:52"/>Lakini ayo ngu'bo yaatiulika, ngaileka popo no tila abile wausu.<verse eid="MRK 14:52"/></para>
  <para style="s">Yesu pa Balasa Liku'lu'</para>
  <para style="r">(<ref loc="MAT 26:57-68">Mat 26:57-68</ref>, <ref loc="LUK 22:54-55">Luk 22:54-55</ref>, <ref loc="LUK 22:63-71">22:63-71</ref>, <ref loc="JHN 18:13-14">Yoa 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53"/>Nabembe ngabampeleka Yesu kwa mpi'ndo nku'lu' ywa dini na api'ndo ba dini, na ayi'mi'li'ki ba bandu pamope na balimu ba salya ya Musa boti baakongolekine palu'. <verse eid="MRK 14:53"/><verse number="54" style="v" sid="MRK 14:54"/>Petili aami'ngi'yite Yesu kwa kuutalu, ngayingya kulua lwa nyumba ya mpi'ndo nku'lu' wa dini, ngatama pamope na ali'ndi'li kayota mwoto. <verse eid="MRK 14:54"/><verse number="55" style="v" sid="MRK 14:55"/>Api'ndo ba dini na boti ba Balasa Liku'lu' lya Ayahudi bapalage ukong'ondeli li'nga bapate kitumbu sa kummulaga Yesu, lakini baapatikeli kitumbu sosoti.<verse eid="MRK 14:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="MRK 14:56"/>Baingi baapiyite ukong'ondeli wa ubu'su' bu'kana na Yesu, lakini ukong'ondeli wabe walandineli. <verse eid="MRK 14:56"/><verse number="57" style="v" sid="MRK 14:57"/>Ata bi'ngi' baayi'mi kumpikiya ukong'ondeli wa ubu'su' kababaya, <verse eid="MRK 14:57"/><verse number="58" style="v" sid="MRK 14:58"/>“Twenga twannyu'wine kabaya, ‘Nenga nilu'a kwisengwana nyumba yi' ya Nnu'ngu' yaisengilwe kwa maboko ga bandu, na kwa masu'ba gatatu nilu'a kwisenga yi'ngi' yangali sengelwa kwa maboko ga bandu.’” <verse eid="MRK 14:58"/><verse number="59" style="v" sid="MRK 14:59"/>Lakini ata nnyo, ukong'ondeli wabe uyi'ki'tyaniyeli.<verse eid="MRK 14:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60"/>Bai, mpi'ndo nku'lu' ywa dini ngayi'ma pakatikati ya bandu na kunnaluya Yesu, “Uyangwali ata likowe? Bandu ba bakusitakilya namani?” <verse eid="MRK 14:60"/><verse number="61" style="v" sid="MRK 14:61"/>Lakini Yesu aatami liki, alongeili kikowe sosoti. Mpi'ndo yu'lu' aatikunnaluya kai', “Wenga nga wa Kilisitu, Mwana wa Nnu'ngu' ywalumbilwa?” <verse eid="MRK 14:61"/><verse number="62" style="v" sid="MRK 14:62"/>Yesu ngayangwa, “Nenga nga Naywembe! Kai', mwammona Mwana wa Mundu atami kummalyo ga yu'lu' Bwana Mwene Makakala, kaulu'ka bu'ka kumaunde ga kunani.” <verse eid="MRK 14:62"/><verse number="63" style="v" sid="MRK 14:63"/>Mpi'ndo yu'lu' paayu'wine makowe go, ngapopwana magu'bo gake no baya, “Tupalikwali yendelya pala ukong'ondeli wowoti waubu'kana na mundu yu'. <verse eid="MRK 14:63"/><verse number="64" style="v" sid="MRK 14:64"/>Mwabene munnyu'wine mu'lu' mwantukine Nnu'ngu'. Muwasa buli?” Boti ngabamuukumu panga, apalikwa abulagilwe.<verse eid="MRK 14:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65"/>Bu'kapo, bandu bi'ngi' baatumbwi kumunia mmata, baantabite kitambala kuminyo na kunku'mbwa makondi na kummakia, “Londwa, nyai ywakuku'mbwile!” Nabembe ali'ndi'li baamoywi Yesu na kunku'mbwa mbande.<verse eid="MRK 14:65"/></para>
  <para style="s">Petili ankana Yesu</para>
  <para style="r">(<ref loc="MAT 26:69-72">Mat 26:69-72</ref>, <ref loc="LUK 22:56-62">Luk 22:56-62</ref>, <ref loc="JHN 18:15-18">Yoa 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66"/>Petili paabile balo pai' kulua, yumo ywa atumisi alwawa ba mpi'ndo nku'lu' wa dini aaikite palu'. <verse eid="MRK 14:66"/><verse number="67" style="v" sid="MRK 14:67"/>Paamweni Petili kayota mwoto, aatikunningulya na kummakia, “Ata wenga nyinyonyo waabile pamope na Yesu wa ku Nasaleti.” <verse eid="MRK 14:67"/><verse number="68" style="v" sid="MRK 14:68"/>Lakini Petili aatikana kabaya, “Nigatangiteli makowe gaugabaya wenga katu!” Bu'kapo Petili aayi'i mpaka paniango wa kuluwa. Apo, njogolo ngabi'ka. <verse eid="MRK 14:68"/><verse number="69" style="v" sid="MRK 14:69"/>Yu'lu' ntumisi nnwawa, paamweni kai' Petili aatumbwi kai' kwabakia bandu babaayi'mi po, “Mundu yu' nga yumo mukipi'nga sabe!” <verse eid="MRK 14:69"/><verse number="70" style="v" sid="MRK 14:70"/>Lakini Petili aatikana kai'. Bu'ka po baliya pasene, bandu babaayi'mi po ngabammakia Petili, “Kakape wenga wa yumo ywabe, kwa mwanjaa wenga wa mundu wa Galilaya!” <verse eid="MRK 14:70"/><verse number="71" style="v" sid="MRK 14:71"/>Bai, Petili aatumbwi longela kalapangya panga, “Nintangiteli mundu yu' ywamunnongelya.” <verse eid="MRK 14:71"/><verse number="72" style="v" sid="MRK 14:72"/>Popopo, njogolo ngabi'ka pampanda pabi'li'. Bai, Petili ngaku'mbu'kya mu'lu' mwaabakiyilwe na Yesu panga, “Pangali njogolo bi'ka pabi'li', wanikana patatu.” Na, paliku'mbu'ki lyo, aatumbwi li'la muno.<verse eid="MRK 14:72"/></para>
  <chapter eid="MRK 14"/>
  <chapter number="15" style="c" sid="MRK 15"/>
  <para style="s">Yesu apelekelwa kwa Pilato</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mat 27:1-2</ref>, <ref loc="MAT 11:-1-14">11-14</ref>, <ref loc="LUK 23:1-5">Luk 23:1-5</ref>, <ref loc="JHN 18:28-38">Yoa 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1"/>Kindai' bulabula, api'ndo ba dini, ayi'mi'li'ki ba bandu, balimu ba salya ya Musa na api'ndo boti ba Balasa Liku'lu' lya Ayahudi batami kitamo no yi'ki'tyana. Bantabite Yesu, ngabampeleka na kunkamukia kwa Pilato. <verse eid="MRK 15:1"/><verse number="2" style="v" sid="MRK 15:2"/>Pilato aannalwiye Yesu, “Wenga nga wankulungwa wa Ayahudi?” Yesu ngayangwa, “Wenga ngawaubaya.”<verse eid="MRK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3"/>Nabembe api'ndo ba dini bansitaki Yesu kwa makowe gambone. <verse eid="MRK 15:3"/><verse number="4" style="v" sid="MRK 15:4"/>Bai, Pilato ngannaluya kai', “Wenga uyangwali ata likowe limo? Lingulya makowe ga goti gabakusitakilya!” <verse eid="MRK 15:4"/><verse number="5" style="v" sid="MRK 15:5"/>Lakini Yesu aayangwili ata likowe lyolyoti, na Pilato mwene aatisangala.<verse eid="MRK 15:5"/></para>
  <para style="s">Yesu aukumilwa kiwo</para>
  <para style="r">(<ref loc="MAT 27:15-26">Mat 27:15-26</ref>, <ref loc="LUK 23:13-25">Luk 23:13-25</ref>, <ref loc="JHN 18:39-19:16">Yoa 18:39-19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6"/>Yaai mimu yabe panga kila paika si'li'ku'si'li'ku' ya Pasika, Pilato aayu'gu'lyage ntabilwe yumo ywabansawi bene bandu. <verse eid="MRK 15:6"/><verse number="7" style="v" sid="MRK 15:7"/>Nsimu wo, kwabile na mundu yumo ywakemilwe Balaba, aabile ntabilwe pamope na aine bi'ngi' babaapangite makosa go bulaga bandu no kana kwiyu'wa silikali. <verse eid="MRK 15:7"/><verse number="8" style="v" sid="MRK 15:8"/>Bandu baingi bannyendeli Pilato li'nga kunnu'ba aapangi kati mwaibile mimu yake. <verse eid="MRK 15:8"/><verse number="9" style="v" sid="MRK 15:9"/>Pilato ngaalaluya, “Mupala ninnyu'gu'lyange ayu' nkulungwa wa Ayahudi?” <verse eid="MRK 15:9"/><verse number="10" style="v" sid="MRK 15:10"/>Aalongei nyo kwa mwanjaa aatangite panga api'ndo ba dini bampelike Yesu kasake kwa kitumbu sa kummi'kya bwigu bai.<verse eid="MRK 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11"/>Lakini api'ndo ba dini ngabaasopa bandu li'nga bannu'be Pilato aayu'gu'li Balaba. <verse eid="MRK 15:11"/><verse number="12" style="v" sid="MRK 15:12"/>Pilato aatikwalaluya kai', “Bai, mupala nipange namani na ayu' mundu ywamunkema nkulungwa wa Ayahudi?” <verse eid="MRK 15:12"/><verse number="13" style="v" sid="MRK 15:13"/>Ngabapanga ndu'ti kababaya, “Abambilwe munsalaba!” <verse eid="MRK 15:13"/><verse number="14" style="v" sid="MRK 15:14"/>Pilato ngaalaluya, “Aapangite likosa gani?” Lakini baayongiye panga ndu'ti kababaya, “Abambilwe!”<verse eid="MRK 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15"/>Pilato kwo pala kwapulaisa bandu, ngaayu'gu'lya Balaba no amulisa Yesu aku'batilwe mikwasu na kunkamukiya kwa asikali li'nga abambilwe munsalaba.<verse eid="MRK 15:15"/></para>
  <para style="s">Yesu asalangilwa na asikali</para>
  <para style="r">(<ref loc="MAT 27:27">Mat 27:27</ref>, <ref loc="JHN 19:2-3">Yoa 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16"/>Bu'kapo, asikali ngabampeleka Yesu kunyumba ya liwali no kema kipi'nga soti sa asikali. <verse eid="MRK 15:16"/><verse number="17" style="v" sid="MRK 15:17"/>Banng'walike Yesu ngu'bo yene lukanda lwa sambalau no lu'ka kapiya ya mimimwa na kunng'walika muntwe. <verse eid="MRK 15:17"/><verse number="18" style="v" sid="MRK 15:18"/>Ngabatumbwa kumpanga abali kwa kunsalanga, “Ukayumuka, Wankulungwa wa Ayahudi!” <verse eid="MRK 15:18"/><verse number="19" style="v" sid="MRK 15:19"/>Ngabanku'mbwa muntwe kwa nnai, kumunia mmata, na kunkilikitya nnu'ngi' yake. <verse eid="MRK 15:19"/><verse number="20" style="v" sid="MRK 15:20"/>Bu'ka pa kunsalanga, ngabammula yi'lu' ngu'bo ya sambalau na kunng'walika ngu'bo yake, bu'kapo ngabampeleka kummamba.<verse eid="MRK 15:20"/></para>
  <para style="s">Bambilwa kwa Yesu</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mat 27:32-44</ref>, <ref loc="LUK 23:26-43">Luk 23:26-43</ref>, <ref loc="JHN 19:17-27">Yoa 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21"/>Pabaabile kabampeleka, baakwembine na mundu yumo ywaakemilwe Simoni, mwenekaya wa Kulene kauma kunng'unda. Aywo aai tati' ywa Alekisanda na Rufo, ngabanni'ndi'ndi'lya aupu'twe nsalaba wa Yesu. <verse eid="MRK 15:21"/><verse number="22" style="v" sid="MRK 15:22"/>Bu'kapo ngabampeleka Yesu mpaka pandu papaakemilwe Golgotha, ilombolya Pandu pa Lipakala lya Ntwe. <verse eid="MRK 15:22"/><verse number="23" style="v" sid="MRK 15:23"/>Bampei divai yaiyangabanilwe na manemane, lakini ywembe aakani nywa. <verse eid="MRK 15:23"/><verse number="24" style="v" sid="MRK 15:24"/>Bu'kapo ngabammamba munsalaba no bagana magu'bo gake kwo ng'andya mpumbe, li'nga batange panga ngu'bo gani yaipalikwa kila mundu apate. <verse eid="MRK 15:24"/><verse number="25" style="v" sid="MRK 15:25"/>Yaai musaa itatu ya kindai' paabambilwe munsalaba. <verse eid="MRK 15:25"/><verse number="26" style="v" sid="MRK 15:26"/>Lyaandikilwe lilu'nga bu'kana no sitakilwa kwake lyalyaandikilwe, “Nkulungwa wa Ayahudi.” <verse eid="MRK 15:26"/><verse number="27" style="v" sid="MRK 15:27"/>Kai' apokonyoli abi'li' baabambilwe pamope na Yesu munsalaba, yumo kunki'ya na ywi'ngi' kummalyo.<verse eid="MRK 15:27"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29"/>Bandu babaabile kabapi'ta palu', ngabatikatika mitwe na kumpwi'wa kababaya, “Kumbe! Wenga waupalage kuibomwana nyumba ya Nnu'ngu' na kuisenga kai' kwa masu'ba gatatu, <verse eid="MRK 15:29"/><verse number="30" style="v" sid="MRK 15:30"/>wiuluye munsalaba li'nga wikosopoli wamwene!” <verse eid="MRK 15:30"/><verse number="31" style="v" sid="MRK 15:31"/>Nyinyonyo na api'ndo ba dini pamope na balimu ba salya ya Musa ngabankeneka Yesu kababakiyana, “Aakosopoli bi'ngi', lakini kwikosopolya mwene akombwali! <verse eid="MRK 15:31"/><verse number="32" style="v" sid="MRK 15:32"/>Ati' ywembe aibaya nga Kilisitu, nkulungwa wa Isilaili! Lelo, aiuluye mwene munsalaba li'nga na twenga tupate lola na kumwu'bi'lya.” Nabembe babaabambilwe nakwe mumisalaba yabe, ngabampwi'wa.<verse eid="MRK 15:32"/></para>
  <para style="s">Yesu awi'lya munsalaba</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mat 27:45-56</ref>, <ref loc="LUK 23:44-49">Luk 23:44-49</ref>, <ref loc="JHN 19:28-30">Yoa 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33"/>Na payikite saa sita ya muntwekati mpaka saa tisa, lubi'ndu' lwauwi'ki'li nni'ma woti. <verse eid="MRK 15:33"/><verse number="34" style="v" sid="MRK 15:34"/>Na paikite saa tisa, Yesu aau'bwiye lilobe kakemelya, “Eloi, Eloi, lema sabakitani?” Lombolya, “Nnu'ngu' wangu', Nnu'ngu' wangu', mboni utenileka?” <verse eid="MRK 15:34"/><verse number="35" style="v" sid="MRK 15:35"/>Bi'ngi' ba bandu babaayi'mi po pabayu'wine go, baatibaya, “Mumpi'kani, ankema Eliya.” <verse eid="MRK 15:35"/><verse number="36" style="v" sid="MRK 15:36"/>Mundu yumo ngabutuka lubi'lo yenda suya mukasiki na kwitabya munnai. Bu'kapo ngamwu'bu'ki'ya Yesu li'nga anywe, kabaya, “Munneke, tulole mana Eliya alu'a isa kumuluya bu'ka munsalaba.” <verse eid="MRK 15:36"/><verse number="37" style="v" sid="MRK 15:37"/>Lakini Yesu aau'bwiye lilobe liku'lu', ngayomoka.<verse eid="MRK 15:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38"/>Bai, panjia munyumba ya Nnu'ngu' ngaipopwanika itema ibi'li', bu'ka kunani mpaka pai'. <verse eid="MRK 15:38"/><verse number="39" style="v" sid="MRK 15:39"/>Mpi'ndo yumo ywa asikali ywaayi'mi nnu'ngi' ya Yesu paibweni mu'lu' mwayomwike, ngabaya, “Kakape mundu yu' aai Mwana wa Nnu'ngu'!”<verse eid="MRK 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40"/>Kwabile na alwawa babalingulyage kwa kuutalu. Mukipi'nga sabe aai Malia Makatalena, Malia mau' bake Yakobi nnunawe Yose, na nnwawa ywi'ngi' Salome. <verse eid="MRK 15:40"/><verse number="41" style="v" sid="MRK 15:41"/>Alwawa ba nga balu' babammi'ngi'yite Yesu na kuntumikia nsimu waabile Galilaya. Alwawa bi'ngi' baingi babammi'ngi'yite mpaka Yelusalemu baabile po nyinyonyo.<verse eid="MRK 15:41"/></para>
  <para style="s">Sikilwa kwa Yesu</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mat 27:57-61</ref>, <ref loc="LUK 23:50-56">Luk 23:50-56</ref>, <ref loc="JHN 19:38-42">Yoa 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42"/>Paikite kitamwiyo, lyaai lisu'ba lyo yingilya Sabato ya Ayahudi. <verse eid="MRK 15:42"/><verse number="43" style="v" sid="MRK 15:43"/>Kwabile na Yusupu wa Alimataya, mundu mwene isima mu Balasa Liku'lu', kai' api'kanilyage isa kwa Ukulungwa wa Nnu'ngu'. Kwa nyo, Yusupu ngayenda lu'ba ntwi wa Yesu kwa Pilato pangali yogopa. <verse eid="MRK 15:43"/><verse number="44" style="v" sid="MRK 15:44"/>Pilato aatisangala payu'wine panga Yesu awile. Ngankema yu'lu' mpi'ndo ywa asikali na kunnaluya panga kakape Yesu awile. <verse eid="MRK 15:44"/><verse number="45" style="v" sid="MRK 15:45"/>Pilato pabakiyilwe na yu'lu' mpi'ndo ywa asikali panga Yesu awile, ngannyi'ki'ti'ya Yusupu yenda kuutola ntwi wake. <verse eid="MRK 15:45"/><verse number="46" style="v" sid="MRK 15:46"/>Apo Yusupu ngapi'ma sanda uu, na kuulukiya pai' ntwi, na kuuti'li'ti'ki'ya sanda. Ngaubi'ka ntwi wo mulisiko lyalisongilwe mumpi'mbi'. Bu'kapo, ngaimbilikia liwe liku'lu' paniango wa lisiko. <verse eid="MRK 15:46"/><verse number="47" style="v" sid="MRK 15:47"/>Nabembe Malia Makatalena na Malia mau' bake Yose baapabweni pandu pabanng'onjike.<verse eid="MRK 15:47"/></para>
  <chapter eid="MRK 15"/>
  <chapter number="16" style="c" sid="MRK 16"/>
  <para style="s">Yu'ka kwa Yesu</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mat 28:1-8</ref>, <ref loc="LUK 24:1-12">Luk 24:1-12</ref>, <ref loc="JHN 20:1-10">Yoa 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1"/>Paliyomwike lisu'ba lya Sabato, Malia Makatalena, Malia mau' bake Yakobi, na nnwawa ywi'ngi' Salome baapi'mite mauta go sikya li'nga bakaupakaye ntwi wa Yesu. <verse eid="MRK 16:1"/><verse number="2" style="v" sid="MRK 16:2"/>Jumapili kindai', lisu'ba kalitumbwa pita, ngabayenda kulisiko. <verse eid="MRK 16:2"/><verse number="3" style="v" sid="MRK 16:3"/>Nabembe baai kababakiyana, “Nyai ywakombwa kulinokwa li'lu' liwe bu'ka munniango wa lisiko?” <verse eid="MRK 16:3"/><verse number="4" style="v" sid="MRK 16:4"/>Lakini pabalingulile, ngabalibona li'lu' liwe liku'lu' linokolilwe pambwega. <verse eid="MRK 16:4"/><verse number="5" style="v" sid="MRK 16:5"/>Pabaabile kabayingya mulisiko, ngabankolya mwinsembe yumo aweti nganju uu, atami kummalyo, nabembe ngabang'ang'amuka.<verse eid="MRK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6"/>Lakini mwinsembe yu'lu' ngaabakia, “Kanemung'ang'amuke! Mumpala Yesu wa ku Nasaleti ywaabambilwe munsalaba. Ywembe ayu'kite, abileli pano. Mulinguli, pano nga pandu pabammi'kite. <verse eid="MRK 16:6"/><verse number="7" style="v" sid="MRK 16:7"/>Lakini nambi'yambi' muyende mukaabakiye banamasi' bake pamope na Petili panga endalongolya yenda ku Galilaya, namwenga mukammona kwo kati mu'lu' mwaamakiye.”<verse eid="MRK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8"/>Bai, baapitike mulisiko no butuka lubi'lo ku'no kabalendema no sangala muno. Nabembe bammakiyeli mundu ywoywoti kwa mwanjaa baatiyogopa.<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">Maandiko gi'ngi' ga kwai'mbu' gayomolya Injili yi'no 8 </char></note><verse eid="MRK 16:8"/></para>
  <para style="s">Yesu ampitya Malia Makatalena</para>
  <para style="r">(<ref loc="MAT 28:9-10">Mat 28:9-10</ref>, <ref loc="JHN 20:11-18">Yoa 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9"/>Yesu paayu'kite, yaai kindai' lisu'ba lyo tumbulya yuma. Aampiti wi'ti' Malia Makatalena, yu'lu' ywammi'ngite moka saba. <verse eid="MRK 16:9"/><verse number="10" style="v" sid="MRK 16:10"/>Malia ngayenda kwabakia balu' babaabile pamope na Yesu. Na paikite aayi'i kwakolya kabalombola no li'la. <verse eid="MRK 16:10"/><verse number="11" style="v" sid="MRK 16:11"/>Lakini, pabayu'wine panga Yesu ayu'kite na Malia Makatalena aamweni, baau'bi'li lili.<verse eid="MRK 16:11"/></para>
  <para style="s">Yesu aapitya banamasi' abi'li'</para>
  <para style="r">(<ref loc="LUK 24:13-35">Luk 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12"/>Bu'kapo banamasi' abi'li' baabile kabayenda kumigunda, Yesu ngaapitya abile agalambwike kuminyo. <verse eid="MRK 16:12"/><verse number="13" style="v" sid="MRK 16:13"/>Nabembe baatibuyangana na kwabakia banamasi' bi'ngi' makowe galu', lakini nyinyonyo baau'bi'li lili.<verse eid="MRK 16:13"/></para>
  <para style="s">Banamasi' bendatumilwa</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mat 28:16-20</ref>, <ref loc="LUK 24:36-49">Luk 24:36-49</ref>, <ref loc="JHN 20:19-23">Yoa 20:19-23</ref>, <ref loc="MAT 1:6-8">Mat 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14"/>Kuundi'la, Yesu aapiti balu' banamasi' ku'mi na yumo pabaabile kabalya kilyo. Aatikwakalipya kwa kitumbu so kotoka u'bi'lya kwabe na unonopau wa myoyo yabe kwo kana kwau'bi'lya balu' babaamweni bu'ka pa uyu'ki wake. <verse eid="MRK 16:14"/><verse number="15" style="v" sid="MRK 16:15"/>Bu'kapo ngaabakia, “Muyende mudunia yoti mukaale abali inannoga kwa kila mundu. <verse eid="MRK 16:15"/><verse number="16" style="v" sid="MRK 16:16"/>Ywau'bi'lya no batisilwa aalu'a kosopolelwa, lakini ywaakotoka u'bi'lya aaukumilwa. <verse eid="MRK 16:16"/><verse number="17" style="v" sid="MRK 16:17"/>Na boti babaalu'a u'bi'lya baalaya myasu yi'no. Kwo tumya lina lyangu', baalu'a bi'nga moka, baalongela kwa luga yayambi'. <verse eid="MRK 16:17"/><verse number="18" style="v" sid="MRK 16:18"/>Kai', baakamwa nng'ambo kwa maboko gabe, ata mana banywile kili'be sene sumu baasulikali katu, baabi'ka moko gabe panani ya atamwe, nabembe baayu'yu'ki'lwa.”<verse eid="MRK 16:18"/></para>
  <para style="s">Yesu au'bu'yi'lwa kunani</para>
  <para style="r">(<ref loc="LUK 24:50-53">Luk 24:50-53</ref>, <ref loc="MAT 1:9-11">Mat 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19"/>Bwana Yesu paayomwi longela nabo makowe go, ngakatuyilwa yenda kunani no tama kummalyo ga Nnu'ngu'. <verse eid="MRK 16:19"/><verse number="20" style="v" sid="MRK 16:20"/>Nabembe banamasi' bake ngabayenda ala abali yake kila pandu. Bwana Yesu aapangite lyengo pamope nabo na kulikangamaya liyi'gi'yo lyake kwa myasu yayaayi'i pamope na liyi'gi'yo lyo.<verse eid="MRK 16:20"/></para>
  <chapter eid="MRK 16"/>
</usx>
