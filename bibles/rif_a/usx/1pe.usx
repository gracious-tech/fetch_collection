<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1PE" style="id">- TarifitABS</book>
  <para style="h">1 بطرس</para>
  <para style="toc3">1بط</para>
  <para style="toc2">1 بطرس</para>
  <para style="toc1">ثَبْرَات ثَمزْوَارُوْت ن اَرَّسُوْل بُطْرُس</para>
  <para style="mt1">ثَبْرَات ثَمزْوَارُوْت ن اَرَّسُوْل بُطْرُس</para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="s">لْمُقَدِّمَا</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />نش ذ بُطْرُس ذ اَرَّسُوْل ن عِيْسَى لْمَسِيح.</para>
  <para style="p" vid="1PE 1:1">
    <char style="it">تْسكِّيغ-د ثَبْرَات-أَ</char> إِ يِنِّي إِݣ يخْضَر أَربِّـي إِي يدْجَان ذ يعزَّابن يتمْزدْجَاعن ذِي لْإِقْلِيم ن پُـنْطُس ذ لْإِقْلِيم ن ݣَلَاطْيَا ذ لْإِقْلِيم ن كَفَدُوْسْيَا ذ لْإِقْلِيم ن آسْيَا ذ لْإِقْلِيم ن بِـيْثَانْيَا. <verse eid="1PE 1:1" /><verse number="2" style="v" sid="1PE 1:2" />أَربِّـي بَابَاثْنغ يخْضَر-يكنِّيو عْلَاحْسَاب مَامّش تُوْغَا يسّن نتَّا زِي قْبڒ، ئِسِّيصْفَا-كنِّيو س يِجّن ن ڒْخذْمث ن أَرُّوْح يقدّْسن حمَا اَذ تْطَاعم إِ عِيْسَى لْمَسِيح اَذ تْوَارُوْشّم س يذَامّن نّس <char style="it">إِي يُوْزّْڒن</char>.</para>
  <para style="p" vid="1PE 1:2">أَذَايْوم يمَارْنِي اَرْضَا ذ ڒهْنَا س وَاطَّاس.<verse eid="1PE 1:2" /></para>
  <para style="s">نتْوَاخْڒق-د ذ جْذِيذ غَار يِجّن ن لْأَمَال يدَّرن</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />أَذ يتْوَابَرك أَربِّـي، بَابَاس ن سِيذِيثْنغ عِيْسَى لْمَسِيح إِي ذَانغ يُوْشِين س اَرَّاحْمث نّس ثَمقّْرَانْت اَد نخْڒق ذ جْذِيذ غَار يِجّن ن لْأَمَال يدَّرن وَامِي د يسكَّر عِيْسَى لْمَسِيح زݣ يمتِّينن. <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />حمَا أَ نْوَارث يجّن ن وَاݣْڒَا عمَّارْص اَذ يفْنَا عمَّارْص اَذ يخْسَر عمَّارْص اَذ يكْشف ونِّي إِي ذَاوم يتْوَاخمّْڒن ذݣ وجنَّا. <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />عْلَاحْسَاب لْإِيمَان نْوم أَربِّـي يحطَّا-كنِّيو س ثْزمَّار نّس غَار يِجّن ن وسنْجم إِݣ يسوْجذ نتَّا اَثِيذ يسْمظْهَار ذِي نْهَار اَنݣَّارُو.<verse eid="1PE 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 1:6" />س وسنْجم-أَ كنِّيو ثْفَرّْحم وَاخَّا ڒبْعَاض زَّايْوم تْوَاعدَّابن ڒخُّو ذِي ڒمْحَاين شْوِيت ن ڒْوقْث. <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />ڒمْحَاين-أَ ؤُسِينْت-يد بَاش اَذ د سْمظْهَارنْت إِلَّا لْإِيمَان نْوم نتَّا اَقَاث ذ صَّح؛ نتَّا يسوَّا كْتَار زِي دّْهب إِݣ يفنَّان وَاخَّا يتْوَاسِّيصْفَا ذِي ثْمسِّي. حمَا لْإِيمَان نْوم اَث شكَّرن اَذَايس يِيڒِي شَّان ذ لْقِيمَا خْمِي د غَا يمظْهَار عِيْسَى لْمَسِيح. <verse eid="1PE 1:7" /><verse number="8" style="v" sid="1PE 1:8" />ثْحِبّم-ث وَاخَّا وَار ث ثࢲْرِيم شَا. أَقَا ثُوْمْنم زَّايس وَاخَّا وَار ث تْوِيڒِيم شَا ڒخُّو. كنِّيو ثْعمَّرم س يِجّن ن ڒفْرَاحث ذ ثَمقّْرَانْت وَار ثْزمَّرم شَا اَت ثْشَرّْحم. <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />أَقَا كنِّيو ثْقبّْڒم لْغَرَض ن لْإِيمَان نْوم يعْنِي اَذ ينْجم ڒَعْمَار نْوم.<verse eid="1PE 1:9" /></para>
  <para style="s">لْأَنْبِيَا تُوْغَا سْڒَان خ لْمَسِيح</para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10" />خ وسنْجم-أَ وَانِيتَا سِّيوْڒن خَاس لْأَنْبِيَا، يعْنِي اَرْضَا نِّي إِي تُوْغَا ذَاوم د غَا يمظْهَارن. نِثْنِي رزُّوْن خَاس مْلِيح تْفتَّاشن خَاس اَطَّاس. <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />تُوْغَا رزُّوْن خَاس بَاش اَذ سّْنن مڒْمِي د غَا يمظْهَار وسنْجم-أَ ذ ظُّرُوْف نّس. رزُّوْن اَذ سّْنن مِينْخف يسَّاوَاڒ أَرُّوْح ن لْمَسِيح إِي يدْجَان ذَايْسن وَامِي أَرُّوْح-أَ يعْڒم-اَسن زِي قْبڒ مشْحَاڒ إِي غَا يتْوَاعدّب لْمَسِيح، سّنِّي مشْحَاڒ إِي غَا يتْوَاسمْغَار منْبَعْد. <verse eid="1PE 1:11" /><verse number="12" style="v" sid="1PE 1:12" />ئِسْمظْهَار-اَسن-د إِ لْأَنْبِيَا بلِّي مَانَايَا وَار ث خدّْمن شَا إِ يِيخف نْسن، خدّْمن-ث إِ كنِّيو وَامِي سَّاوَاڒن س ثْمسْڒَايِين-أَ. أُو ڒخُّو نَّان-اَوم ثِمسْڒَايِين-أَ يِنِّي إِ كنِّيو يتْبشَّارن س لْإِنْجِيل س جّْهذ ن أَرُّوْح يقدّْسن إِي ذَاوم د يتْوَاسّكّن زݣ وجنَّا. وَاخَّا ذ لْمَلَائِكَاث ذَايْسنْت مزْڒِي اَذ خْزَرنْت ذِي ثْمسْڒَايِين-أَ.<verse eid="1PE 1:12" /></para>
  <para style="s">ئِذَامّن ن لْمَسِيح إِي ذَانغ يسنْجَامن زِي دُّنشْت-أَ</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />إِذن، سْوجْذم ڒَعْقُوْرَاث نْوم بَاش اَذ تْخذْمم. أَرّم-د ڒْبَاڒ نْوم. ݣّم لْأَمَال نْوم غِير ذِي اَرْضَا <char style="it">ن وسنْجم</char> نِّي إِي ذَاوم د غَا يمُّوْشن خْمِي د غَا يمظْهَار عِيْسَى لْمَسِيح. <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />إِڒِيم اَم ثَارْوَا يتْطَاعَان، وَار ذفَّارث شَا شّهَاوَاث نِّي ثِعفَّانِين ثِنِّي إِي ذِي تُوْغَا تْعِيشم ذِي ڒقْفَاڒث نْوم يعْذُوْن. <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />لَّا، ئِتْخصَّا اَذ تِيڒِيم ثصْفَام ذِي مَارَّا مِين تݣّم اَم مَامّش يصْفَا أَربِّـي ونِّي إِي ذَاوم د يڒَاغَان. <verse eid="1PE 1:15" /><verse number="16" style="v" sid="1PE 1:16" />أَقَا يُوْرَا ذِي لْكِتَاب: إِڒِيث كنِّيو ثصْفَام مِينْزِي نش صْفِيغ.<verse eid="1PE 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17" />مڒَا ثقَّارم-اَس "آ بَابَا" إِ ونِّي يتحْسَابن ڒخْذَايم ن كُڒ بْنَاذم بْڒَا ؤُذمَاون اَتَاف يتْخصَّا اَذ تْعِيشم س يِجّن ن ثِيݣّْوْذِي اَخْمِي غَا ثْعزّْبم <char style="it">ذِي ثْمُوْرْث-أَ</char>. <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />أَقَا ثسّْنم كنِّيو س يِجّن ن لْفِدْيَا أَربِّـي يسُّوْفغ-يكنِّيو-د زݣ يِجّن ن ثُوْذَارْث ثخْوَا إِي ذَاوم يمُّوْشن زِي ڒجْذُوْذ نْوم، وَلَكِن لْفِدْيَا-يَا إِي خَاوم يخدْجس مَاشِي ذ شَان ن ڒْحَاجث اَم دّْهب نِغ اَم نُّقَارْث إِݣ يفنَّان. <verse eid="1PE 1:18" /><verse number="19" style="v" sid="1PE 1:19" />لَّا، ئِسُّوْفغ-يكنِّيو-د س يذَامّن نِّي إِي يغْڒَان س وَاطَّاس ن لْمَسِيح يعْنِي يزْمَار نِّي يدْجَان بْڒَا ڒْعِيب بْڒَا ڒوْسخ. <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />أُو نتَّا يتْوَاخْضَر قْبڒ مَا د تْوَاخْڒق دُّنشْت-أَ، وَلَكِن يسْمظْهَار-يث-يذ أَربِّـي ذِي زْمَان-أَ اَنݣَّارُو خ سَّبَاب نْوم. <verse eid="1PE 1:20" /><verse number="21" style="v" sid="1PE 1:21" />زَّايس نتَّا إِي زِي تَامْنم زِي أَربِّـي إِي ثِيذ يسكَّرن زݣ يمتِّينن، يُوْشَا-ٱس لْعَظَمَا بَاش تِّقث نْوم ذ لْأَمَال نْوم تِيڒِين ذِي أَربِّـي.<verse eid="1PE 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22" />ڒخُّو ثسِّيصْفَام يخف نْوم وَامِي ثْطَاعم إِ لْحَقِيقَا بَاش اَذ تِيڒِي ذَايْوم يجّن ن ڒمْحِبّث جَار وَاوْمَاثن بْڒَا نِّفَاق. س مَانَايَا يتْخصَّا-كنِّيو اَذ ثخْسم اَيَاوْيَا اَطَّاس س وُوْڒَاون نْوم. <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />أَقَا تْوَاخڒْقم-د ذ جْذِيذ مَاشِي زݣ يِجّن ن زَّرِّيعث يفنَّان؛ لَّا، ثنِّي وَار يفنِّين شَا عمَّارْص، س وَاوَاڒ ن أَربِّـي يدَّرن يتْدُوْمَّان. <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />لِأَنَّا:</para>
  <para style="q1" vid="1PE 1:24">&lt;شَّان ن بْنَاذم مَارَّا،</para>
  <para style="q1" vid="1PE 1:24">أَم نْوَار ن اَرْبِيع إِݣ يدْجَا.</para>
  <para style="q1" vid="1PE 1:24">كُڒ بْنَاذم اَم اَرْبِيع نتَّا.</para>
  <para style="q1" vid="1PE 1:24">أَقَا اَرْبِيع يتِيسْرَاو نْوَار نّس يوطَّا،<verse eid="1PE 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="1PE 1:25" />مَاشَا اَوَاڒ ن أَربِّـي يتْغِيمَا إِ ڒبْدَا.&gt;</para>
  <para style="p" vid="1PE 1:25">أَوَاڒ-أَ نتَّا ذ لْإِنْجِيل إِي ذَاوم د يتْوَابشَّرن.<verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="s">ئِجّن ن وزْرُو يدَّرن ذ يِجّن ن شَّعْب اَمْقدّس</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />إِذن فَا كّْسث زݣ وُوْرَاون نْوم مَارَّا شَّرّْ ذ مَارَّا لْغذْرَان ذ نِّفَاق ذ ڒحْسذ ذ مَارَّا ڒْبَاطڒ. <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />إِڒِيث اَم يحْضِيضن، سْغُوْيِوث خ ؤُغِي نِّي يصْفَان ن أَرُّوْح يقدّْسن بَاش اَزَّايس ثمْغَرم ذِي لْإِيمَان نْوم إِݣ يسنْجَامن. <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />أَقَا ثقَّاسم سِيذِيثْنغ نتَّا مشْحَاڒ ذ اَصبْحَان.<verse eid="1PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4" />خْمِي غَارس د ثْقَارَّابم غَار نتَّا إِي يدْجَان ذ اَزْرُو نِّي يدَّرن عِيفّن-ث يرْيَازن وَلَكِن أَربِّـي يخْضَر-يث يعِيزّ خَاس، <verse eid="1PE 2:4" /><verse number="5" style="v" sid="1PE 2:5" />ؤُڒَا ذ كنِّيو عَاوذ اَم شَا ن يِزْرَا يدَّرن زَّايْوم إِي ثْبنَّا يجّن ن ثدَّارْث ن أَرُّوْح يقدّْسن. حمَا اَذ تِيڒِيم كنِّيو ذ يجّن ن جْمَاعث ن ڒْفُقَهَا صَّالِحِين، تْقدَّامم دْبِيحَاث رُّوْحِيَاث يَارْضَا خَاسنْت أَربِّـي س وفُوْس ن عِيْسَى لْمَسِيح. <verse eid="1PE 2:5" /><verse number="6" style="v" sid="1PE 2:6" />قَا مَانَايَا إِݣ يقَّار لْكِتَاب:</para>
  <para style="q1" vid="1PE 2:6">&lt;أَقَا خْضَرغ يج ن وزْرُو، سْرُوْسِيغ-ث خ وذْرَار ن لْقُدْس.</para>
  <para style="q1" vid="1PE 2:6">نتَّا يسوَّا اَطَّاس، ݣِّيغ-ث ذِي ثْغمَّارْث ن دْسَاس.</para>
  <para style="q1" vid="1PE 2:6">ونِّي إِي زَّايس غَا يَامْنن وَار يندّم شَا.&gt;<verse eid="1PE 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="1PE 2:7" />فَا اَزْرُو-يَا يسوَّا اَطَّاس إِ كنِّيو إِي يُوْمْنن، يِنِّي وَار يُوْمِينن شَا لَّا. <char style="it">أَقَا يُوْرَا ذِي لْكِتَاب</char>:</para>
  <para style="q1" vid="1PE 2:7">&lt;أَزْرُو نِّي إِي عِيفّن ئِبنَّاين،</para>
  <para style="q1" vid="1PE 2:7">يوْقع ذݣ ومْشَان اَصبْحَان ذِي ثْغمَّارْث ن دْسَاس.&gt;<verse eid="1PE 2:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="1PE 2:8" />أُو عَاوذ <char style="it">يقَّار</char>:</para>
  <para style="q1" vid="1PE 2:8">&lt;ئِج ن تِّيرْشث إِي ذِي تنْقْڒَاضن يِوْذَان،</para>
  <para style="q1" vid="1PE 2:8">ذ يجّن ن وزْرُو إِي ثن يغطّْڒن.&gt;</para>
  <para style="m" vid="1PE 2:8">قَا تنْقْڒَاضن ذَايس مِينْزِي عصَّان اَوَاڒ نّس، أَمنِّي إِي خَاسن يُوْرَا.<verse eid="1PE 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9" />فَا كنِّيو ذ يجّن ن شَّعْب يتْوَاخْضَرن ذ يجّن ن جْمَاعث ن ڒْفُقَهَا ن وزدْجِيذ ذ يجّن ن ڒْݣنْس ذ اَمْقدّس ذ يِوْذَان نِثْنِي بَابْ نْسن ذ أَربِّـي بَاش اَذ تْبشَّارم س ثْمسْڒَايِين ثِصبْحَانِين ن ونِّي إِي كنِّيو يسُّوْفْغن زݣ يِجّن ن ثَادْجسْت يَارِّي-كنِّيو-د غَار نُّوْر نّس عَاجِب. <verse eid="1PE 2:9" /><verse number="10" style="v" sid="1PE 2:10" />تُوْغَا كنِّيو ذݣ يِجّن ن ڒْوقْث مَاشِي ذ ڒْݣنْس، ڒخُّو كنِّيو ثْذوْڒم ذ شَّعْب ن أَربِّـي. تُوْغَا ذݣ يِجّن ن ڒْوقْث وَار ثسِّينم شَا اَرَّاحْمث ن أَربِّـي، ڒخُّو ثسّْنم اَرَّاحْمث نّس.<verse eid="1PE 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />آي يمْعِيزّن ينُو، نش قَّارغ-اَوم إِ كنِّيو إِي يدْجَان ذ يعزَّابن ذ يبَرَّانِيْين ذِي دُّنشْت-أَ، بعّْذث زِي شّهَاوَاث نِّي ثِعفَّانِين إِي كنِّيو يتْحَارَابن ضد ن ڒَعْمَار نْوم. <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />عِيْشث س لْمَعْقُوْل جَار ڒݣْـنُوْس. مڒَا تَهَامن-كنِّيو خ شَان ڒْحَاجث ذ ثَعفَّانْت أُوْشَا نِثْنِي ࢲرّن لْحَسَانَاث نْوم اَتَاف اَذ حمْذن أَربِّـي ذِي نْهَار نِّي إِي خَاسن د غَا يخْضڒ.<verse eid="1PE 2:12" /></para>
  <para style="s">طَاعث إِ يِنِّي خَاوم يتحْكَامن</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />خ سَّبَاب ن سِيذِيثْنغ طَاعث إِ كُڒ لْحَاكم ؤُمِي يمُّوْش ڒْحَقّ نِيْشَان اَذ يحْكم. وَاخَّا نتَّا ذ اَزدْجِيذ يتحْكَامن خ مَارَّا، <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />نِغ ذ لْحُكَّام إِي د يسّكّ <char style="it">وزدْجِيذ</char> اَذ عَاقْبن يِنِّي يتݣّن شَّرّْ اَذ تْشكَّرن يِنِّي يتݣّن مِين يدْجَان ذ اَصبْحَان. <verse eid="1PE 2:14" /><verse number="15" style="v" sid="1PE 2:15" />لِأَنَّا مَانَايَا ذ ڒْخَاضَر ن أَربِّـي يعْنِي مڒَا ثݣِّيم مِين يدْجَان ذ اَصبْحَان اَتَاف اَذ تقْضَام خ وَاوَاڒن يجَهْڒن ن يرْيَازن نِّي إِي ذِي ثدْجَا ثُوْبُّوْهْڒِيَا أُو صَافِي. <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />عِيْشث اَم يِوْذَان إِي غَار ثدْجَا لْحُرِّيَا وَلَكِن وَار سْتعْمَالث شَا لْحُرِّيَا-يَا نْوم بَاش اَذ تسْنُوْفَّرم شَّرّْ نْوم؛ لَّا، ئِتْخصَّا اَذ تْعِيْشم اَم يخدَّامن ن أَربِّـي. <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />وقَّارث مَارَّا يوْذَان. سْعِيزّث اَيثْمَاثْوم. ݣّْوْذث زِي أَربِّـي. وقَّارث اَزدْجِيذ.<verse eid="1PE 2:17" /></para>
  <para style="s">قبّْڒث اَعدّب عْلَاحْسَاب لْمَسِيح</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />آي يخدَّامن، طَاعث إِ اَيثْبَاب نْوم س لْإِحْتِرَام مَارَّا. مَاشِي غِير إِ يِنِّي يدْجَان ذ يصبْحَانن ذَايْسن تَّوَاضُع؛ لَّا، حتَّا ذ يِنِّي يقسْحن. <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />شُوْف، مڒَا يجّن يطَاع إِ أَربِّـي يصْبَر إِ وعدّب نتَّا وَار يسْذِيهدْج شَا تَمَارَا نِّي، مَا ذَايس شَان ن شُّكر؟ وَاه، ذَايس شُّكر. <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />وَلَكِن مڒَا ثعْصَام ثشِّيم خَاس اَعْمُوْذ ثصْبَرم خ مَانَاينِّي، مَا ذَايس شَان ن شُّكر؟ لَّا، وَالُو. مڒَا ثݣِّيم ڒْخِير ثتْوَاعدّْبم خَاس ثصْبَرم خَاس، أَتَاف مَانَايَا وَاه ذَايس يجّن ن شُّكر ذ اَمقّْرَان زَّاث إِ أَربِّـي. <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />ئِڒَاغَا-يَاوم-د أَربِّـي غَار مَانَايَا مِينْزِي لْمَسِيح يتْوَاعدّب عْلَاحْسَاب كنِّيو؛ ئِجَّا-ٱوم-د يجّن ن لْمِثَال اَث تْذفَّرم ذݣ يسُوْرِيفن نّس.<verse eid="1PE 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1PE 2:22" />نتَّا وَار يݣِّي ؤُڒَا ذ يجّن ن ڒْمُعْصِيّث،</para>
  <para style="q1" vid="1PE 2:22">وَار ذَاس د يكِّي ؤُڒَا ذ يج وخَرِّيق زݣ وقمُّوْم نّس.<verse eid="1PE 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1PE 2:23" />وَامِي تُوْغَا خَاس تْبُوْصَارن، نتَّا وَار خَاسن د يَارِّي شَا اَبُوْصَار نْسن. وَامِي تُوْغَا ث تْعدَّابن، نتَّا وَار ثن يهدّذ شَا؛ لَّا، نتَّا يسلّم يخف نّس ذݣ يفَاسّن ن ونِّي يتحْكَامن نِيْشَان. <verse eid="1PE 2:23" /><verse number="24" style="v" sid="1PE 2:24" />نتَّا س يِيخف نّس ييْسِي ڒْمُعْصِيَاث نّغ ذِي دَّات نّس خ ثحْنَاشْت<note caller="+" style="f"><char style="fr" closed="false">2‏.24 </char><char style="ft" closed="false">ثَحْنَاشْت-أَ نتَّاث ذ صَّلِيب نِّي إِي خف يمُّوْث سِيذِيثْنغ عِيْسَى.</char></note> نِّي حمَا أَ نمّث نشِّين <char style="it">س وُوْڒَاون نّغ</char> إِ ڒْمُعْصِيَاث، أَ ندَّر إِ مِين يدْجَان نِيْشَان. أَقَا س وجَرِّيح نّس إِي زِي ثْݣنْفَام كنِّيو. <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />تُوْغَا كنِّيو اَم يحُوْڒِيْين يتْودَّرن، ڒخُّو ثْذوْڒم-د غَار ونِّي إِي كنِّيو يرَاسّن يتْكلَّافن زِي ڒَعْمَار نْوم.<verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="s">ڒُوْصِيَاث عْلَاحْسَاب يرْيَازن ذ ثمْغَارِين نْسن</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />آ ثِمْغَارِين، أَمنِّي عَاوذ يتْخصَّا اَذ طَاعنْت إِ يرْيَازن نْكنْت. حمَا يِنِّي وَار يتݣّن شَا اَرَّاي إِ وَاوَاڒ ن أَربِّـي اَتَاف ثِمْغَارِين نْسن اَثن د اَرّنْت غَار ڒْمُوْمِنِين بْڒَا مَا ٱكِذْسن سِّيوْڒنْت س وَاوَاڒ غِير س ثِيْشْرِي نْسنْت أُو صَافِي. <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />يِـيْنَا غِير اَذ ࢲرّن ثِيْشْرِي نْكنْت ثصْفَا تْسذْحَانْت زَّايْسن <char style="it">اَتَاف اَذ اَمْنن</char>.<verse eid="1PE 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 3:3" />زِّين نْكنْت مَاشِي ذ لْمُهِم غَار بَارَّا يعْنِي اَذ تْمُوْذنْت يشوَّافن نِغ اَذ تݣّنْت ثِسنْسْڒِين ذ ثمْقيَّاسِين ن دّْهب نِغ ذ اَرُّوْض إِي يغْڒَان. <verse eid="1PE 3:3" /><verse number="4" style="v" sid="1PE 3:4" />لَّا، زِّين نْكنْت يتْخصَّا اَذ يِيڒِي غَار ذَاخڒ نْكنْت يعْنِي زِّين نِّي يتِيڒِين ينُوْفَّر ذݣ وُوْڒ. زِّين-أَ وَار يفنِّي شَا عمَّارْص، غَارس اَرُّوْح مْهدّن ذَايس تَّوَاضُع ذ يِجّن ن شَّان ذ اَمقّْرَان زَّاث إِ ثِيطَّاوِين ن أَربِّـي.<verse eid="1PE 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 3:5" />أَمُّو إِي تُوْغَا يدْجَا زِّين ن لَالَّاث ن زْمَان سْرُوْسَانْت لْأَمَال نْسنْت ذِي أَربِّـي. تْطَاعَانْت إِ يرْيَازن نْسنْت، <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />أَم سَارَا تُوْغَا يتݣّن اَرَّاي إِ <char style="it">ورْيَاز نّس</char> بْرَاهِيم تْڒَاغَا-يَاس&lt;آ سِيذِي.&gt; كنِّينْت اَذ تِيڒِينْت اَم يِسِّيس يعْنِي مڒَا تݣّنْت ڒْخِير وَار تݣّْوْذنْت شَا زِي مِين يسَاݣّْوَاذن.<verse eid="1PE 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7" />آي يرْيَازن، أَمنِّي يتْخصَّا-يَاوم اَذ تݣّم عَاوذ، أَذ تْعِيشم اَك ثمْغَارِين نْوم س يِجّن ن ڒفْهَامث جَارَاوم. ؤُشم-اَس لْقِيمَا إِ ثمْغَارْث يدْجَان نتَّاث اَم ثْغرَّافْث يتْرزَّان ذغْيَا مِينْزِي ذ نِثنْتِي يتْوَارَّاثن اَكِذْوم لْبَرَكَا ن ثُوْذَارْث. حمَا وَار ذِنِّي تِيڒِي بُو شَان ن ڒْحَاجث اَذ ترز ثْࢲَادْجِيث نْوم.<verse eid="1PE 3:7" /></para>
  <para style="s">ونِّي يتْوَاعدَّابن خ سَّبَاب ن ڒْحَقّ إِݣ يتݣّ</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />لْمُهِيم، ئِتْخصَّا-كنِّيو مَارَّا إِذْوم ڒَعْقُوْڒَاث نْوم اَذ يڒِين ذ يجّن، أَذ تسْحِيسّم اَك وَايَاوْيَا، أَغَارْوم ثِيڒِي يِجّن ن ڒمْحِبّث ن وَاوْمَاثن، أَذ تْحِينّم ذݣ وَايَاوْيَا، وَار ذَايْوم يتِيڒِي بُو تَّكبُّر. <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />وَار تَارَّاث شَا شَّرّْ س شَّرّْ نّغْنِي نِغ ڒْعِيب س ڒْعِيب نّغْنِي. لَّا، بَرْكث ينّغْنِي، مَايمِّي؟ مِينْزِي يڒَاغَا-د خَاوم إِ مَانَايَا بَاش اَذ تْخَاڒْسم س يِجّن ن لْبَرَكَا. <verse eid="1PE 3:9" /><verse number="10" style="v" sid="1PE 3:10" />لِأَنَّا <char style="it">يقَّار</char>:</para>
  <para style="q1" vid="1PE 3:10">&lt;ونِّي يرزُّوْن اَذ يحِبّ ثُوْذَارْث نّس،</para>
  <para style="q1" vid="1PE 3:10">نِغ يخس عَاوذ اَذ يࢲر ؤُسَّان ذ يصبْحَانن،</para>
  <para style="q2" vid="1PE 3:10">أَو لَابُد اَذ يحْضَا يڒس نّس زِي شَّرّْ،</para>
  <para style="q2" vid="1PE 3:10">ذ ؤُقمُّوْم نّس زݣ وَاوَاڒ ن ثحْڒَايْمِيث.<verse eid="1PE 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11" />ئِتْخصَّا اَذ يݣّْوج خ شَّرّْ اَذ يݣّ ڒْخِير،</para>
  <para style="q2" vid="1PE 3:11">أَذ يرْزُو خ سَّلَام اَث يذْفَار.<verse eid="1PE 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1PE 3:12" />أَقَا ثِيطَّاوِين ن سِيذِي أَربِّـي خزَّرنْت صَّالِحِين،</para>
  <para style="q1" vid="1PE 3:12">ئِمجَّان نّس نُوْرْزْمن إِ ثْࢲَادْجِيث نْسن.</para>
  <para style="q2" vid="1PE 3:12">مَاشَا ؤُذم ن سِيذِي أَربِّـي،</para>
  <para style="q2" vid="1PE 3:12">يَارَّا اَعْرُوْر غَار يِنِّي يتݣّن شَّرّْ.&gt;<verse eid="1PE 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />إِيوَا مڒَا ثْحَاوْڒم اَذ تݣّم ڒْخِير، مِين يعْنَا ونِّي إِي كنِّيو غَا يضَرّن؟ <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" />وَلَكِن وَاخَّا ثتْوَاعدّْبم مڒَا ثݣِّيم ڒْحَقّ، أَذ يِيڒِي ذ سَّعْذ نْوم. وَار تݣّْوْذم شَا زݣ يِوْذَان، وَار ثن تجَّام شَا اَكنِّيو سْذهْشن. <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />لَّا، سمْغَارث لْمَسِيح ذݣ وُوْڒَاون نْوم اَرّم-ث ذ سِيذِيثْوم. إِڒِيث ڒبْدَا ثْوجْذم بَاش اَذ تْدَافْعم خ يِيخف نْوم اَذ تْجَاوْبم ونِّي يرزُّوْن خ سَّبَاب ن لْأَمَال إِي ذَايْوم. وَلَكِن جَاوْبم-ث س يِجّن ن تَّوَاضُع ذ لْإِحْتِرَام <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />ذ يِجّن ن ضَّمِير مرْتَاح. أَمُّو يِنِّي خَاوم يقَّارن ڒْبَاطڒ اَتَاف اَذ سذْحَان س ثِيْشْرِي نْوم ثَصبْحَانْت إِي خَاوم تْعيَّابن نِثْنِي.<verse eid="1PE 3:16" /></para>
  <para style="s">لْمَسِيح يمُّوْث عْلَاحْسَاب يِنِّي يعصَّان</para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 3:17" />شُوْف، مڒَا يخس أَربِّـي اَتَاف حْسن اَذ تْوَاعدَّابم عْلَاحْسَاب ڒْخِير إِي تݣّم مَاشِي عْلَاحْسَاب شَّرّْ. <verse eid="1PE 3:17" /><verse number="18" style="v" sid="1PE 3:18" />أَمنِّي إِݣ يݣَّا لْمَسِيح وَامِي يتْوَاعدّب يجّن ن تْوَاڒَا إِ ڒبْدَا عْلَاحْسَاب ڒْمُعْصِيَاث. يعْنِي ونِّي يدْجَان نِيْشَان يتْوَاعدّب ذݣ ومْشَان ن يِنِّي يعصَّان حمَا اَكنِّيو يسِّيوض غَار أَربِّـي. دَّات نّس نْغِين-تث، ئِسدَّر-يت-يد أَرُّوْح يقدّْسن. <verse eid="1PE 3:18" /><verse number="19" style="v" sid="1PE 3:19" />س أَرُّوْح-أَ إِي زِي يرُوْح بَاش اَذ يبشَّر اَرُّوْحَاث <char style="it">ن يِوْذَان</char> نِّي يتْوَاحبّْسن. <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />مَايمِّي؟ لِأَنَّا مشْحَاڒ زݣ وَامِي ذِي زْمَان ن نُوْح ؤُݣِين <char style="it">يِوْذَان-أَ</char> اَذ ݣّن اَرَّاي إِ أَربِّـي وَامِي ثن تُوْغَا يتْرَاجَا س صّْبَر يتْصنَّاع اَغَرَّابُو <char style="it">ن نُوْح</char>. ذݣ وغرَّابُو-يَا ذْرُوْسْت ن يِوْذَان ثْمنْيَا وَاهَا كِّين خ وَامَان نِّي نجْمن. <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />أَمَان-أَ نِثْنِي ذ يجّن لْمِثَال خ طَّهَارث <char style="it">نّغ</char> ن وَامَان إِي كنِّيو يسنْجَامن ڒخُّو. مَاشِي اَذ يتْوَاكّس ڒوْسخ زِي دَّات نّغ؛ لَّا، طَّهَارث-أَ نتَّاث ذ يجّن ن ؤُڒَاغِي نْوم إِ أَربِّـي بَاش اَذَاوم د يُوْش يجّن ن ضَّمِير مرْتَاح. مَانَايَا خ سَّبَاب ن عِيْسَى لْمَسِيح وَامِي د يكَّر زِي ڒْموْث. <verse eid="1PE 3:21" /><verse number="22" style="v" sid="1PE 3:22" />ذ نتَّا يݣَعّْذن غَار وجنَّا اَقَاث خ وفُوْسِي ن أَربِّـي، يَارَّا لْمَلَائِيكَاث سْوَادَّاي ن لْحُكم نّس ذ يِنِّي يحكّْمن ذ يِنِّي يجهْذن.<verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="s">اَرنِّيث ذِي لْإِيمَان نْوم</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />فَا عِيْسَى لْمَسِيح يتْوَاعدّب ذِي دَّات نّس. خ مَانَايَا عَاوذ كنِّيو اَذ تسْجهْذم يخف نْوم س اَرَّاي نِّي نّس. مَايمِّي؟ مڒَا ثتْوَاعدّْبم ذِي دَّات نْوم، صَافِي ثْبعّْذم عَاوذ خ ڒْمُعْصِيّث. <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />خ مَانَايَا نْهُوْرَاث نِّي إِي ذَاوم يتْغِيمَان ذِي دَّات نْوم مَاشِي اَثن ثْسعْذُوْم عْلَاحْسَاب شّهَاوَاث ن بْنَاذم؛ لَّا، سعْذُوْم-ثن عْلَاحْسَاب ڒْخَاضَر ن أَربِّـي. <verse eid="1PE 4:2" /><verse number="3" style="v" sid="1PE 4:3" />إِيوَا صَافِي، ثجِّيْوْنم زِي مِين تُوْغَا تْعِيشم عْلَاحْسَاب مِين رزُّوْن اَذ ݣّن لْكُفَّار يعْنِي ڒقْبَاحث ذ شّهَاوَاث ثِعفَّانِين ذ وَاطَّاس ن شّْرب ذ لْفَسَاد ذ زّْهُو ذ لْعِبَادَا ن لْأَصْنَام يعِيفّن. <verse eid="1PE 4:3" /><verse number="4" style="v" sid="1PE 4:4" />تْعجِّيبن نِثْنِي يعْنِي مڒَا كنِّيو وَار كِذْسن تِيْذْفم شَا ذِي لْفَيَضَان ن ؤُفلّس-أَ اَذ قِّيمن عَاوذ تْزَوَّارن-كنِّيو. <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />وَلَكِن لْحِسَاب نْسن اَث يݣّ ونِّي يوجّْذن اَذ يحَاسب يِنِّي يدَّرن ذ يِنِّي يمُّوْثن. <verse eid="1PE 4:5" /><verse number="6" style="v" sid="1PE 4:6" />خ سَّبَاب-أَ تْوَابشَّرن س لْإِنْجِيل ؤُڒَا ذ يمتِّينن. مُّوْثن مَامّش تْمتَّان يِوْذَان مَارَّا، وَلَكِن نِثْنِي اَذ دَّرن س أَرُّوْح نْسن عْلَاحْسَاب لْغَرَض ن أَربِّـي.<verse eid="1PE 4:6" /></para>
  <para style="s">ڒْمُوْمِنِين أُو لَابُد اَذ سْتعْمَالن لْقُدْرَاث نْسن</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />أَقَا يُوْسَا-د ونݣَّارُو ن مَارَّا ثِمسْڒَايِين. إِذن يتْخصَّا اَذ د تَارّم ڒْبَاڒ نْوم اَغَارْوم يِيڒِي ڒَعْقڒ نْوم بَاش اَتَاف اَذ تْزمَّرم اَذ تْࢲَادْجم. <verse eid="1PE 4:7" /><verse number="8" style="v" sid="1PE 4:8" />مِين يدْجَان مُهِم قَاع؟ ئِتْخصَّا اَذ تْحِبّم اَيَاوْيَا زݣ وُوْڒ مِينْزِي ڒمْحِبّث ثْقطَّا خ وَاطَّاس ن دُّنُوْب. <verse eid="1PE 4:8" /><verse number="9" style="v" sid="1PE 4:9" />لَابُد اَذ تْرحّْبم زݣ وَايَاوْيَا اَم ينوْجِيون بْڒَا مَا ٱذ تْشثْشَام. <verse eid="1PE 4:9" /><verse number="10" style="v" sid="1PE 4:10" />ئِتْخصَّا-يَاس إِ مْكُڒ يجّن اَذ يسخْذم لْقُدْرَا نِّي إِي ذَاس يمُّوْشن اَك يِوْذَان. أَذ يسخْذم نِيْشَان لْبَرَكَا ن أَربِّـي إِي زِي يتْكلَّاف كُڒ نُّوْع نّس. <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />ونِّي ؤُمِي يمُّوْش اَذ يسِّيوڒ يتْخصَّا-يَاس اَذ يسِّيوڒ اَم ونِّي يسَّاوَاڒن اَوَاڒن ن أَربِّـي. ونِّي ؤُمِي يمُّوْش اَذ يخْذم يتْخصَّا-يَاس اَذ يخْذم اَم ونِّي يخدّْمن س جّْهذ إِݣ يتِيشّ أَربِّـي. حمَا س مَارَّا ثِمسْڒَايِين-أَ اَذ يتْوَاحْمذ أَربِّـي س وفُوْس ن عِيْسَى لْمَسِيح. أَغَارس ثِيڒِي لْعَظَمَا ذ ڒحْكَام إِ ڒبْدَا ن ڒبْدَاث. آمِين.<verse eid="1PE 4:11" /></para>
  <para style="s">ڒْمِحْنث ن ونِّي ييُوْمْنن س لْمَسِيح</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />آي يمْعِيزّن ينُو، وَار تْعجِّيبم شَا عْلَاحْسَاب ڒْمِحْنث-أَ إِي خَاوم د يوْضَان اَم ثْمسِّي بَاش اَكنِّيو ثْجَرّب. <char style="it">وَار تْفكَّرث شَا</char> بلِّي مَانَايَا عَاجِب. <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />لَّا، ئِتخصَّا كنِّيو اَذ تْفَرْحم وَامِي ثْشَرّْشم ذݣ وعدّب ن لْمَسِيح بَاش اَذ تْفَرْحم عَاوذ اَطَّاس خْمِي د غَا ثْمظْهَار لْعَظَمَا نّس. <verse eid="1PE 4:13" /><verse number="14" style="v" sid="1PE 4:14" />مڒَا يوْذَان تُوْكَّارن-كنِّيو عْلَاحْسَاب يسم ن لْمَسِيح اَتَاف سَّعْذ نْوم، مِينْزِي أَرُّوْح ن لْعَظَمَا ذ أَرُّوْح ن أَربِّـي يمَارْس-د خَاوم. <verse eid="1PE 4:14" /><verse number="15" style="v" sid="1PE 4:15" />حْضَام اَكِذْوم يِيڒِي يجّن جَارَاوم إِݣ يتْوَاعدَّابن مِينْزِي ينْغَا بْنَاذم نِغ يُوْشَار نِغ ذ لْمُجْرِيم نِغ يتَاذف ذِي شّْغُوْڒَاث ن مِدّن. <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />إِنَّمَا، مڒَا شَان يجّن يتْوَاعدَّاب ڒَاحقَّاش نتَّا ذ اَمَسِيحِي يتْخصَّا-ٱس وَار يتْسذْحِي شَا، أُو لَابُد اَذ يسمْغَار أَربِّـي ڒَاحقَّاش ييْسِي-د يسم نّس.<verse eid="1PE 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 4:17" />أَقَا ثُوْوض-د ڒْوقْث بَاش اَذ يبْذَا لْحِسَاب جَار اَيثْبَاب ن ثدَّارْث ن أَربِّـي. مڒَا اَذ يبْذَا لْحِسَاب-أَ جَارَانغ مِين غَا يوقْعن إِ يِنِّي وَار يتْطِيعِين شَا إِ لْإِنْجِيل ن أَربِّـي؟ <verse eid="1PE 4:17" /><verse number="18" style="v" sid="1PE 4:18" />أَقَا <char style="it">يقَّار</char>:</para>
  <para style="q1" vid="1PE 4:18">&lt;مڒَا يقْسح اَذ ينْجم شَان يِجّن</para>
  <para style="q1" vid="1PE 4:18">زݣ يِنِّي يدْجَان نِيْشَان،</para>
  <para style="q1" vid="1PE 4:18">مَامش غَا ݣّن يِنِّي يعصَّان،</para>
  <para style="q1" vid="1PE 4:18">ذ يِنِّي وَار يتْطِيعِين شَا إِ أَربِّـي؟&gt;<verse eid="1PE 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1PE 4:19" />فَالِيهَذَا يِنِّي يتْوَاعدَّابن س اَرَّاي ن أَربِّـي، ئِتْخصَّا-يَاسن اَذ سلّْمن ڒَعْمَار نْسن ذݣ يفَاسّن ن لْخَالِق نْسن نتَّا إِي ذِي ثدْجَا تِّقث، أَذ قِّيمن تݣّن مِين يدْجَان ذ اَصبْحَان.<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="s">ڒُوْصِيَاث غَار يمقّْرَانن ن ثْجُمَاع ن ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />فَا نش تْڒَاغِيغ-د خ يمقّْرَانن يدْجَان جَار ن ثْجُمَاع، نش إِي يدْجَان ذ يجّن ن ومقّْرَان اَم كنِّيو ذ يِجّن ن شَّاهذ خ مِين خف يتْوَاعدّب لْمَسِيح، نش ذ يِجّن عَاوذ إِي غَا يشَرْشن ذِي لْعَظَمَا إِي د غَا يمظْهَارن. <verse eid="1PE 5:1" /><verse number="2" style="v" sid="1PE 5:2" />اَروْسث ثْحِيْمرْث نِّي ن أَربِّـي إِي خف كنِّيو يتْكلَّاف نتَّا. حْضَام-تث س ڒْخَاضَر نْوم مَاشِي س يِجّن ن بزّز إِي خَاوم تݣّن مِينْزِي اَمُّو إِي يخس أَربِّـي. مَاشِي س طّْمَع ن ڒفْضِيحث، لَّا س وُوْڒَاون نْوم. <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />مَاشِي اَخَاسن ثْحكْمم س ؤُزِيَّار خ يِنِّي إِي خف تْكلَّافم؛ لَّا، أَذ تِيڒِيم ذ لْمِثَال إِ ثْحِيْمرْث إِي غَا تبْعن. <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />خْمِي د غَا يمظْهَار ؤُمكْسَاو اَمقّْرَان اَتَاف اَذ تْقبْڒم يجّن ن تَّاج عمَّارْص اَذ يكْشف.<verse eid="1PE 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5" />آي يحنْجِيرن، كنِّيو طَاعث عَاوذ إِ يِنِّي يدْجَان ذ يمقّْرَانن. سْوجْذث يخف نْوم مَارَّا كنِّيو س يِجّن ن اَرَّاي اَك وَايَاوْيَا وَار ذَايس بُو تَّكبُّر مِينْزِي &lt;أَربِّـي اَقَاث ضد ن يِنِّي يسمْغَارن يخف نْسن، يِنِّي يسمْزَاين يخف نْسن يتِيشّ-اَسن اَرْضَا نّس.&gt;<verse eid="1PE 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 5:6" />إِذن، سمْزَايم يخف نْوم سْوَادَّاي ن ؤُفُوْس يجهْذن ن أَربِّـي، أَكنِّيو يسمْغَار ذِي ڒْوقْث إِي يخس نتَّا. <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />مَارَّا يمْنُوْسن جّم-ثن إِ نتَّا مِينْزِي نتَّا يتْهلَّا ذَايْوم.<verse eid="1PE 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8" />أَرّم-د ڒْبَاڒ نْوم، إِڒِيث عْلَابَال. ڒَعْذُو نْوم إِبْڒِيس قَا يتْقيَّاذ-كنِّيو اَم سّْبَاع يتْهِيرِّيو يرزُّو خ ونِّي إِي غَا يسغْڒِي. <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />عَرّْضم-اَس إِ إِبْڒِيس، بدّم نِيْشَان خ دْسَاس ن لْإِيمَان نْوم مِينْزِي ثسّْنم بلِّي أَيثْمَاثْوم ذِي مَارَّا دُّنشْت-أَ اَقَا تْوَاعدَّابن اَم كنِّيو.<verse eid="1PE 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 5:10" />أَتَاف اَذ تْوَاعدّْبم شْوَايْت ن ڒْوقْث ڒخْدّنِّي اَكنِّيو يسْريّح أَربِّـي <char style="it">نّغ</char> إِي ذِي يدْجَا مَارَّا اَرْضَا ذ نتَّا إِي ذَاوم د يڒَاغَان غَار لْعَظَمَا نّس وَار يفنِّين شَا ذِي لْمَسِيح. أَكنِّيو يسْبدّ، أَكنِّيو يسجْهذ، أَكنِّيو يݣّ خ دْسَاس. <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />أَغَارس يِيڒِي ڒحْكَام إِ ڒبْدَا ن ڒبْدَاث. آمِين.<verse eid="1PE 5:11" /></para>
  <para style="s">لْخِتَام ن ثبْرَات-أَ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />ؤُرِيغ-اَوم-د ثَبْرَات-أَ ثَمزْيَانْت خ ؤُفُوْس ن سِيْلْوَان حسّْبغ-ث نش اَم ؤُمَاثْنغ ذَايس تِّقث. تْشجَّاعغ-كنِّيو، شهّْذغ مِين قَّارغ مَانَايَا ذ اَرْضَا ن أَربِّـي ذ صَّح. بدّم ذَايس نِيْشَان.<verse eid="1PE 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13" />ثْسَاوَّاض-اَوم-د سْڒَام جْمَاعث إِي يدْجَان ذِي ثنْدِينْت ن بَابِل، نِثْنِي تْوَاخْضَرن اَم كنِّيو. وَاخَّا ؤُڒَا ذ مَرْقُس <char style="it">يسَاوَّاض-اَوم-د سْڒَام</char> ونِّي يدْجَان اَم ممِّي. <verse eid="1PE 5:13" /><verse number="14" style="v" sid="1PE 5:14" />تْسدْجَامث خ وَايَاوْيَا س يِجّن ن سْڒَام ن ثمْعَشَارْث.</para>
  <para style="p" vid="1PE 5:14">أَغَارْوم يِيڒِي ڒهْنَا إِ مَارَّا كنِّيو إِي يدْجَان ذِي لْمَسِيح.<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>