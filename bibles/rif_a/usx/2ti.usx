<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- TarifitABS</book>
  <para style="h">2 تيموتاوس</para>
  <para style="toc3">2تيم</para>
  <para style="toc2">2 تيموتاوس</para>
  <para style="toc1">ثَبْرَات وِيس ثْنَاين ن اَرَّسُوْل بُوْلُس غَار تِيمُوْتَاوُس</para>
  <para style="mt1">ثَبْرَات وِيس ثْنَاين ن اَرَّسُوْل بُوْلُس غَار تِيمُوْتَاوُس</para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="s">لْمُقَدِّمَا</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />نش ذ بُوْلُس ذ يجّن ن اَرَّسُوْل ن عِيْسَى لْمَسِيح س ڒْخَاضَر ن أَربِّـي عْلَاحْسَاب لْوَعذ نِّي إِي ذَانغ يوْعذ خ ثُوْذَارْث نِّي يدْجَان ذِي عِيْسَى لْمَسِيح. <verse eid="2TI 1:1" /><verse number="2" style="v" sid="2TI 1:2" /><char style="it">تَارِيغ ثَبْرَات-أَ</char> إِ تِيْمُوْتَاوُس ونِّي إِي يدْجَان اَم ممِّي يعِيزّن خَافِي. أَكِذش يِيڒِي اَرْضَا ذ ڒهْنَا ذ اَرَّاحْمث زِي أَربِّـي بَابَاثْنغ ذ عِيْسَى لْمَسِيح سِيذِيثْنغ.<verse eid="2TI 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />تْشكَّرغ أَربِّـي ونِّي عبّْذغ زِي ڒجْذُوْذ ينُو س يِجّن ن ضَّمِير يصْفَان. تتَّارغ-اَس إِ أَربِّـي خَاش دْجِيڒث ذ نْهَار بْڒَا مَا ٱذ بدّغ. <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />خْمِي تْفكَّرغ ذݣ يمطَّاون نّش يتطّف-اَيِي-د يجّن مزْڒِي اَش ࢲرغ حمَا اَذ عمَّرغ س ڒفْرَاحث. <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" />عقْڒغ خ لْإِيمَان نّش بْڒَا نِّفَاق ونِّي يدْجَان ذ اَمزْوَارُو ذِي حنَّاش لْوِيزَا ذ يمَّاش أَنِيسَا. ڒخُّو تيّْقغ ذ صَّح بلِّي اَقَاث ذَايش ؤُڒَا ذ شك.<verse eid="2TI 1:5" /></para>
  <para style="s">لْقُدْرَا نِّي إِي يُوْشَا أَربِّـي إِ تِيمُوْتَاوُس</para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 1:6" />خ مَانَايَا اَش فكَّرغ بَاش اَذ تْسنْهزّذ لْقُدْرَا نِّي إِي ذَايش يدْجَان زِي أَربِّـي عْلَاحْسَاب وَامِي خَاش سرْسغ يفَاسّن ينُو. <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />أَقَا أَربِّـي وَار ذَانغ يُوْشِي شَا يجّن ن اَرُّوْح ن ثِيݣّْوْذِي؛ لَّا، قَا يُوْشَا-ٱنغ-د يجّن اَرُّوْح ن جّْهذ ذ ڒمْحِبّث ذ ڒحْكَام خ يِيخف نّغ س ڒَعْقڒ. <verse eid="2TI 1:7" /><verse number="8" style="v" sid="2TI 1:8" />إِذن وَار تْسذْحَا شَا اَذ تْشهْذذ خ سِيذِيثْنغ نِغ خَافِي نش إِي يدْجَان ذ اَمحْبُوْس عْلَاحْسَاب نتَّا؛ لَّا، قبّڒ اَعدَّاب نِّي يدْجَان عْلَاحْسَاب لْإِنْجِيل، س جّْهذ ن أَربِّـي. <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />ئِسنْجم-اَنغ يڒَاغَا-يَانغ-د س يِجّن ن ؤُڒَاغِي مُقدّس. وَار ذَانغ د يڒَاغِي شَا عْلَاحْسَاب لْحَسَانَاث نّغ؛ لَّا، ئِڒَاغَا-يَانغ-د عْلَاحْسَاب لْغَرَض نّس نتَّا ذ اَرْضَا نّس إِي ذَانغ د يُوْشَا ذِي عِيْسَى لْمَسِيح قْبڒ مَا ٱذ تبْذَا ڒْوقْث ن <char style="it">دُّنشْت-أَ</char> قَاع. <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />أَرْضَا-يَا قَا يمظْهَار-د ڒخُّو وَامِي د يمظْهَار عِيْسَى لْمَسِيح ونِّي إِي ذَانغ يسنْجَامن ونِّي يسْبطّْڒن ڒْموْث. ڒخُّو س وفُوْس ن لْإِنْجِيل يُوْوِي-د ثُوْذَارْث غَار نُّوْر ذ ثنِّي وَار يفنِّين شَا. <verse eid="2TI 1:10" /><verse number="11" style="v" sid="2TI 1:11" />عْلَاحْسَاب لْإِنْجِيل-أَ تْوَاخْضَرغ نش اَذ بشَّرغ اَذ يڒِيغ ذ اَرَّسُوْل ذ يجّن ن ؤُمْسڒْمَاذ. <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />خ سَّبَاب-أَ نش قَا تْعدَّابغ خ مَارَّا ثِمسْڒَايِين-أَ ثِيْنَا وَلَكِن وَار تْسذْحِيغ شَا، نش سّْنغ ونِّي إِي زِي ؤُمْنغ. تيّْقغ نتَّا يزمَّر اَذ يحْضَا لْأَمَانَا نِّي إِي كِذس جِّيغ حتَّا ٱڒ نْهَار نِّي <char style="it">اَنݣَّارُو</char>.<verse eid="2TI 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13" />مثّل تَّعْلِيم نِّي نِيشَان إِي ثسْڒِيذ زَّايِي، أَكِذس إِي غَا يِيڒِي يجّن ن لْإِيمَان ذ يِجّن ن ڒمْحِبّث إِي يدْجَان ذِي عِيْسَى لْمَسِيح. <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />حْضَا ثَمسْڒَايْث نِّي إِي ذَاش يجَّا ذ لْأَمَانَا، حْضَا-ت س أَرُّوْح يقدّْسن إِي ذَايْنغ يزدّْغن.<verse eid="2TI 1:14" /></para>
  <para style="s">لْمِثَال ن ؤُمَاثْنغ وَانِيْسْفُوْر</para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />شك ثسّْنذ بلِّي مَارَّا يِنِّي يدْجَان ذِي لْإِقْلِيم ن آسْيَا سمْحن ذَايِي ؤُڒَا ذ فِيْخُوْلُوْس ذ هِيْرْمُوْجِيْنُوْس.<verse eid="2TI 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 1:16" />أَذ يبَرك سِيذِي أَربِّـي ڒحْبَاب ن ؤُمَاثْنغ وَانِيْسْفُوْر، أَطَّاس ن ثْوَاڒَاثِين يسرْتَاح-اَيِي وَار يسذْحِي شَا خ سْنَاسڒ ينُو. <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />لَّا، نتَّا وَامِي يدْجَا ذِي ثنْدِينْت ن رُوْمَا يرزُّو خَافِي اَطَّاس اَڒ وَامِي إِي ذَايِي يُوْفَا. <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />أَث يجّ سِيذِيثْنغ حمَا اَذ يَاف اَرَّاحْمث زِي سِيذِي أَربِّـي ذِي نْهَار نِّي <char style="it">اَنݣَّارُو</char>. شك عَاوذ ثسّْنذ مشْحَاڒ ن ثْوَاڒَاثِين إِي ذَايِي يعَاون ذِي ثنْدِينْت ن ؤُفَسُوْس.<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s">أَخدَّام ن لْمَسِيح</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />إِذن فَا شك آ مِّي، سْجهّذ يخف نّش ذِي اَرْضَا نِّي يدْجَان ذِي عِيْسَى لْمَسِيح. <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />ثِمسْڒَايِين نِّي إِي ثسْڒِيذ زَّايِي زَّاث إ وَاطَّاس ن ڒشْهُوْذ، اجّ-يثنْت اَم يِجّن ن لْأَمَانَا اَك يرْيَازن اَتَاف ذَايْسن تِّقث، عَاوذ يرْيَازن نِّي زمَّرن اَذ سْڒمْذن يوْذَان نّغْنِي. <verse eid="2TI 2:2" /><verse number="3" style="v" sid="2TI 2:3" />إِڒِي <char style="it">اَكِذِي</char> ذݣ وعدّب اَم وعسْكَارِي اَصبْحَان ن عِيْسَى لْمَسِيح. <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />وَار ذِنِّي بُو شَان وعسْكَارِي إِݣ يتمْخُوْمْبُوْرن ذِي دُّوْر نّس ذِي ثْمسْڒَايِين ن دُّنشْت-أَ ڒَاحقَّاش يرزُّو اَذ يَارْضَا خ ونِّي إِي ث يَارِّين ذ اَعسْكَارِي. <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />أَمنِّي عَاوذ ونِّي يتمْعَانَاذن ذِي لْملْعَب؛ مڒَا وَار يتمْعَانَاذ شَا عْلَاحْسَاب لْقَانُوْن وَار يربّح شَا لْجَائِزَا. <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />أَفدْجَاح إِݣ يتَمَارن ذِي ڒْخذْمث أُو لَابُد اَذ ييْسِي ڒْحَقّ نّس نتَّا ذ اَمزْوَارُو زِي ثْفدْجَاحْث نِّي. <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />فكَّر ذِي مِين ذَاش قَّارغ، أَقَا ذ سِيذِي أَربِّـي نتَّا إِي ش غَا يسفْهَامن ذِي مَارَّا ثِمسْڒَايِين-أَ.<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />فكَّر ذِي عِيْسَى لْمَسِيح ونِّي إِي د يسكَّر أَربِّـي زِي ڒْموْث، نتَّا لْأَصل نّس زِي دَاود. ذ مَانَايَا إِݣ يدْجَان ذِي لْإِنْجِيل إِي تْبشَّارغ نش. <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />خ لْإِنْجِيل-أَ إِي تْوَاعدَّابغ نش قنّن-اَيِي س سْنَاسڒ اَم يِجّن ن لْمُجْرِيم. وَلَكِن اَوَاڒن ن أَربِّـي لَّا، وَار زمَّرن اَثن قنّن س سْنَاسڒ. <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />خ مَانَايَا نش صبَّارغ خ مَارَّا ثِمسْڒَايِين عْلَاحْسَاب يِنِّي يتْوَاخْضَرن حمَا ؤُڒَا ذ يِيْنَا اَذ نجّْمن س وفُوْس ن عِيْسَى لْمَسِيح، أَكِذس يجّن لْعَظَمَا إِي وَار يفنِّين شَا.<verse eid="2TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 2:11" />أَقَا يجّن وَاوَاڒ ذَايس تِّقث:</para>
  <para style="q1" vid="2TI 2:11">مڒَا نمُّوْث اَكِذس،</para>
  <para style="q2" vid="2TI 2:11">أُوْشَا أَ ندَّر اَكِذس.<verse eid="2TI 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12" />مڒَا نصْبَر،</para>
  <para style="q2" vid="2TI 2:12">أُوْشَا أَ نحْكم اَكِذس.</para>
  <para style="q1" vid="2TI 2:12">مڒَا ننْكَر-يث،</para>
  <para style="q2" vid="2TI 2:12">أَوْشَا عَاوذ نتَّا اَذَانغ ينْكَر.<verse eid="2TI 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13" />مڒَا نسْمح نشِّين ذِي لْأَمَانَا نّغ،</para>
  <para style="q2" vid="2TI 2:13">مَاشِي اَذ يسْمح نتَّا ذِي لْأَمَانَا نّس،</para>
  <para style="q2" vid="2TI 2:13">مِينْزِي وَار يزمَّر اَذ ينْكَر يخف نّس.<verse eid="2TI 2:13" /></para>
  <para style="s">أَخدَّام نِّي يدْجَان نِيشَان ن سِيذِي أَربِّـي</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />سْفكَّر ڒْمُوْمِنِين خ ثْمسْڒَاِيِين-أَ. عْڒم-اَسن زَّاث إِ أَربِّـي بَاش وَار تْمنْغِين شَا خ وَاوَاڒن. أَمنْغِي نِّي وَار ذَايس وَالُو، غِير اَذ يسُوْفغ زݣ وبْرِيذ يِنِّي يتسْڒَان. <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />اݣّ لْمجْهُوْد نّش بَاش اَذ تْسحْضَارذ يخف نّش غَار أَربِّـي اَم يِجّن غَارس يدْجَان مقْبُوْل، يعْنِي اَم يِجّن ن وخدَّام وَار غَارس مِينْخف إِي غَا يسذْحَا يتْفسَّار نِيْشَان اَوَاڒ ن لْحَقِيقَا.<verse eid="2TI 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 2:16" />فَا اَوْݣّْوج زݣ وَاوَاڒن نِّي يخْوَان ن يِوْذَان ن دُّنشْت-أَ مِينْزِي اَوَاڒن نْسن اَذ ارْنِين غِير ذِي ڒقْفَاڒث نْسن خ أَربِّـي. <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />أَوَاڒ نْسن اَذ يغزّ ذݣ ويْسُوْم اَم ڒهْرَاش ن سَّرَطَان، زَّايْسن حِمِّيْت ذ فِيْلِيْتُوْس. <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />نِثْنِي فّْغن اَبْرِيذ ن لْحَقِيقَا قَّارن قَا صَافِي يُوْم لْقِيَامَا يوْقع، تْضيَّاعن لْإِيمَان ن ڒبْعَاض ن يِوْذَان. <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />وَلَكِن دْسَاس يجهْذن ن أَربِّـي وَار يتنْهزِّي شَا، خَاس إِي نقْشنْت ثِيْرَا-يَا قَّارنْت قَا سِيذِي أَربِّـي قَا يسّن يوْذَان يدْجَان نّس. قَّارنْت عَاوذ قَا مَارَّا يِنِّي يشهّْذن س يِيسم ن سِيذِيثْنغ يتْخصَّا أُو لَابُد اَذ بعّْذن خ شَّرّْ.<verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />شُوْف، ئِجّن ن ثدَّارْث ثَصبْحَانْت وَار ذَايس شَا غِير ڒقْشُوْع ن دّْهب نِغ ذ نُّقَارْث وَاهَا؛ لَّا، ذَايس ؤُڒَا ذ ڒقْشُوْع ن ؤُكشُّوْض ذ ؤُشَاڒ. ڒبْعَاضِيث تْوَاسْتعْمَالن إِ مِين يدْجَان ذ شَّان، ڒبْعَاضِيث تْوَاسْتعْمَالن إِ مِين يدْجَان عَادِي وَاهَا. <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />ونِّي يسِّيصْفَان يخف نّس زِي مَارَّا ثِمسْڒَايِين نِّي ثِعفَّانِين اَتَاف اَذ يِيڒِي اَم ڒقْشُوْع نِّي إِي تْوَاسْتعْمَالن إِ مِين يدْجَان ذ شَّان، نتَّا اَذ يِيڒِي يصْفَا اَذ يِيڒِي ينفّع إِ بَاب نّس، أَذ يِيڒِي يوْجذ إِ كُڒ ڒْخذْمث ثَصبْحَانْت.<verse eid="2TI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22" />فَا ارْوڒ زِي شَّهَاوَاث نِّي ثِعفَّانِين ن ثمْࢲِي، ذفَّار صُّلْح ذ لْإِيمَان ذ ڒمْحِبّث ذ ڒهْنَا اَك يِنِّي إِي د يڒَاغَان خ سِيذِيثْنغ س يِجّن ن وُوْڒ يصْفَا. <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />أَوْݣّْوج زݣ ؤُمْنَاقَار نِّي إِي ذِي يدْجَا غِير ثُوْبُوْهْڒِيَا ذ ڒقْفَاڒث وَاهَا مِينْزِي ثسّْنذ بلِّي يتَارو غِير اَمنْغِي أُو صَافِي.<verse eid="2TI 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2TI 2:24" />فَا اَخدَّام ن سِيذِيثْنغ لَابُد وَار يتْمنْغِي شَا س وَاوَاڒ اَطَّاس؛ ئِتْخصَّا-ٱس اَذ يِيڒِي ضْرِيف اَك مَارَّا يوْذَان، أَتَاف يسّن اَذ يسڒْمذ، أَتَاف غَارس تَّاسِع ن ڒْخَاضَر. <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />أَذ يصحَّاح س يِجّن ن وُوْڒ يصبَّارن إِ يِنِّي إِي ذَاس يتْعَارَّاضن؛ حمَا مڒَا يخس أَربِّـي اَثن يجّ اَذ تُوْبن اَذ سّْنن لْحَقِيقَا. <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />أُوْشَا اَذ د اَرّن ڒْبَاڒ نْسن اَذ اَروْڒن زِي ثخْشبْث ن إِبْڒِيس ونِّي إِي ثن يحبّْسن حمَا اَذ ݣّن ڒْخَاضَر نّس.<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />فَا لَابُد يتْخصَّا اَذ تْفهْمذ بلِّي ؤُسَّان ينݣُّوْرَا اَذ يڒِين قصْحن. <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />قَا يوْذَان اَذ تخْسن يخف نْسن، أَذ تخْسن تْمنْيَاث، أَذَايْسن يِيڒِي تَّكبُّر، أَذ سمْغَارن يخف نْسن، أَذ سِّيوْڒن اَوَاڒ وَار يحْڒِين خ أَربِّـي. وَار تْطِيعِين شَا إِ لْوَالِدِين نْسن، وَار تْشكَّرن حَدّ، وَار تِيڒِين شَا صْفَان، <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />وَار ذَايْسن تِيڒِي ڒمْحِبّث، وَار سمّْحن شَا إِ يِوْذَان، أَذ قَّارن ڒْبَاطڒ، وَار حكّْمن شَا خ يِخف نْسن، أَذ منْغن اَم ڒُوْحُوْش، وَار تْحِبِّين شَا مِين يدْجَان ذ اَصبْحَان، <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />أَذ زّنْزن اَيثْمَاثْسن، أَذ ݣّن ثِمسْڒَايِين بْڒَا ڒَعْقڒ، أَذ ؤُفّن س نْفَاخث، أَذ حِبّن شهْوث نْسن وَار تْحِبِّين شَا أَربِّـي، <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />أَذ ݣّن يخف نْسن عبّْذن أَربِّـي وَلَكِن نكَّرن جّْهذ نّس. ئِوْذَان-أَ، أَوْݣّْوج خَاسن.<verse eid="2TI 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 3:6" />يرْيَازن-أَ ذ يِيْنَا إِي د يسْنُوْقُوْبن ثُوْذْرِين اَم يبُّوْعن تَاذْفن بَاش اَذ سَيْطَرن خ ثمْغَارِين إِي ذِي ثدْجَا نِيّث تْعمَّارنْت س ڒْمُعْصِيَاث تْوَاشمَّاثنْت س وَاطَّاس ن لْأَنْوَاع ن شَّهَوَاث. <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />ڒبْدَا تسْڒَانْت غَار تَّعْلِيم وَلَكِن عمَّارْص اَذ اَوْضنْت اَذ سّْننْت لْحَقِيقَا. <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />مَامّش يَانِيس ذ يَامْپْـرِيس نِّي تْعَارَّاضن إِ مُوْسَى، أَمنِّي عَاوذ ؤُڒَا ذ يرْيَازن-أَ تْعَارَّاضن إِ لْحَقِيقَا. ڒَعْقُوْرَاث نْسن عوّْجن، لْإِيمَان نْسن يخْوَا. <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />وَلَكِن يرْيَازن-أَ وَار تِيوْضن شَا مَانِي. قَا اَذَاسن ثوْقع مَامش ذَاسن ثوْقع إِ يَانِيس ذ يَامْپْـرِيس نِّي، ثُوْبُوْهْڒِيَا ن يرْيَازن-أَ اَذ د تْمظْهَار إِ مَارَّا يوْذَان.<verse eid="2TI 3:9" /></para>
  <para style="s">لْمِثَال نِّي يتِيشّ اَرَّسُوْل بُوْلُس إِ تِيمُوْتَاوُس</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />وَلَكِن شك ثسّْنذ مْلِيح تَّعْلِيم ينُو ذ وبْرِيذ ن ثُوْذَارْث ينُو ذ لْغَرَض ينُو ذ لْإِيمَان ينُو ذ تَّاسِع ن ڒْخَاضَر ينُو ذ ڒمْحِبّث ينُو ذ صّْبَر ينُو <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" />ذ وعدّب ينُو ذ تَمَارَا ينُو. ثسّْنذ مِين ذَايِي يوقْعن ذِي ثنْدِينْت ن وَانْطَاكْيَا ذ إِكُوْنْيَا ذ لِيْسْتْرَا ذ مِين تْوَاعدّْبغ ذݣ يمُوْشَان نِّي. إِنَّمَا، ئِسفْڒث-اَيِي-د سِيذِيثْنغ زِي مَارَّا مَانَاينِّي. <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />ذ صَّح، مَارَّا ونِّي إِي يرزُّوْن اَذ يعِيش س لْإِيمَان يدْجَان ذِي عِيْسَى لْمَسِيح قَا اَذ يتْوَاعدّب. <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />أَمَّا يرْيَازن يعفَّانن ذ يرْيَازن يشمَّاثن نِثْنِي اَذ ارْنِين ذِي ثُوْعُوْفّْنَا وَاهَا، نِثْنِي اَذ شمّْثن اَذ تْوَاشمّْثن.<verse eid="2TI 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 3:14" />شك لَّا، ارْنِي ذِي مِين ذَاش سْڒمْذن ذ مِين ش يسقْنَاعن مِينْزِي ثسّْنذ يِنِّي إِي ذَاش يسْڒمْذن مَانَاينِّي. <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />أَقَا زِي ثمْࢲِي نّش ثسّْنذ عَاوذ ثِيْرَا يدْجَان مُقدّْسِين زمَّرنْت اَش د اَرّنْت ذ مِيغِيس عْلَاحْسَاب مَامش إِي غَا ثْنجْمذ س لْإِيمَان نِّي يدْجَان ذِي عِيْسَى لْمَسِيح. <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />أَقَا مَارَّا ثِيْرَا مُقدّْسِين ؤُسِينْت-يد زِي أَرُّوْح ن أَربِّـي، نفّْعنْت حمَا اَزَّايْسنْت نْسڒْمذ اَزَّايْسنْت ننْهَا اَزَّايْسنْت نْصحّح اَزَّايْسنْت نْربَّا عْلَاحْسَاب صُّلْح. <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />حمَا اَرْيَاز ن أَربِّـي اَذ يِيڒِي يوْجذ اَذ يَاف يذبَّر-اَس س قَاع ثِمسْڒَايِين عْلَاحْسَاب كُڒ ڒْخذْمث ذ ثَصبْحَانْت.<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="s">أَرَّسُوْل بُوْلُس يتْوصَّا تِيمُوْتَاوُس ذِي ڒْخذْمث</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />أَشك وصِّيغ زَّاث إِ أَربِّـي ذ عِيْسَى لْمَسِيح ونِّي إِي غَا يحكْمن خ يِنِّي يدَّرن ذ يِنِّي يمُّوْثن، أَشك وصِّيغ عَاوذ ذِي ڒْمُلْك نّس ذ نْهَار نِّي إِي ذِي د غَا يمظْهَار: <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />بشَّر اَوَاڒ ن أَربِّـي، سوْجذ يخف نّش <char style="it">اَذ تْبشَّرذ</char> ذِي ڒْوقْث نِّي إِي تْرَاجِيذ نِغ ذِي ڒْوقْث نِّي إِي وَار تْرِيجِيذ شَا. ڒْمُوْمِنِين نْهَا-ثن، عْڒم-اَسن، شجّع-يثن س مَارَّا تَّاسِع ن ڒْخَاضَر ذ وسڒْمذ. <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />أَقَا اَذ تَاس ڒْوقْث نِّي نِثْنِي وَار تْصنِّيطن شَا غَار تَّعْلِيم نِيشَان؛ أَغَارْسن د سْمُوْنن يجّن ن لْعَدَد ن يمْسڒْمَاذن سَّاوَاڒن غِير مِين ذَاسن يعجْبن إِ يمجَّان نْسن وَاهَا. <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />يِيْنَا اَذ سْبعّْذن يمجَّان نْسن زِي لْحَقِيقَا اَثن اَوِين اَذ سْڒن إِ ثْحُوْجَا وَاهَا. <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />شك اَرّ-د ڒْبَاڒ نّش ذِي مَارَّا ثِمسْڒَايِين، صْبَر إِ تَمَارَا، اݣّ ڒْخذْمث اَم ونِّي يتْبشَّارن، اݣّ لْوَاجِب ن ڒْخذْمث نّش.<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />شُوْف، نش تْفرَّاغن-اَيِي-د اَم يِجّن ن صّذْقث ن يذَامّن خ دْبِيحث يتْوَاقدَّامن، أَقَا ثُوْوض-د ڒْوقْث ن ؤُفُوْغ ينُو <char style="it">زِي دُّنشْت-أَ</char>. <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />أَمنْغِي-يَا اَصبْحَان منْغغ-ث، ثَازّْڒَا-يَا كمّْڒغ-ت، لْإِيمَان حْضِيغ-ث. <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />سَّا ٱڒ ثْسَاونْت يتْرَاجَا-اَيِي يجّن ن تَّاج ن صُّلْح اَݣ أَربِّـي ونِّي إِي ذَايِي غَا يُوْش سِيذِيثْنغ إِي يدْجَان ذ لْقَاضِي نِيشَان؛ أَذَايِي-ث يُوْش ذِي نْهَار نِّي <char style="it">ن لْحِسَاب</char>. مَاشِي اَذَايِي-ث يُوْش إِ نش وَاهَا؛ لَّا، أَث يُوْش إِ مَارَّا يِنِّي يتخْسن نْهَار نِّي إِي ذِي د غَا يمظْهَار.<verse eid="2TI 4:8" /></para>
  <para style="s">أَوَاڒن ينݣُّوْرَا ن اَرَّسُوْل بُوْلُس إِ تِيمُوْتَاوُس</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />اݣّ لْمجْهُوْد نّش بَاش اَغَارِي د تَاسذ ذغْيَا. <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" />مِينْزِي دِيْمَاس يسْمح ذَايِي ثُوْوِي-ث ڒمْحِبّث ن دُّنشْت-أَ يرُوْح غَار ثنْدِينْت ن سَالُوْنِيك. ئِرُوْح كْرِيسْكُوْس غَار لْإِقْلِيم ن ݣَلَاطْيَا، ئِرُوْح تِيتُوْس غَار جِّهث ن دَلْمَاسْيَا. <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" />ئِقِّيم اَكِذِي غِير لُوْقَا وَاهَا. أَوِي-د اَكِذش مَرْقُوْس مِينْزِي ينفّع-اَيِي ذِي ڒْخذْمث ينُو. <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" />سّكّغ تُوْشِيق غَار ثنْدِينْت ن ؤُفَسُوْس. <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" />خْمِي د غَا ثَاسذ، أَوِي-د اَكِذش اَزدْجَاب ينُو ونِّي إِي جِّيغ اَك كَرْپُـوْس ذِي ثنْدِينْت ن تْرَاوْس ؤُڒَا ذ لْكُتُب ينُو خَاصَّتَان يِنِّي يدْجَان ن يڒمَاون.<verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />إِسْكَنْدر ونِّي يتْصنَّاعن نّحَّاس يضَرّ-اَيِي اَطَّاس، أَث يخدْجس أَربِّـي خ ڒفْعَايڒ نّس. <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />ؤُڒَا ذ شك حْضَا يخف نّش زَّايس مِينْزِي نتَّا يتْعَارَّاض اَطَّاس إِ مِين نتْبشَّار.<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />وَامِي ذَافْعغ خ يِيخف ينُو ثْوَاڒَا ثَمزْوَارُوْت ذِي لْمَحْكَامَا مَارَّا سمْحن ذَايِي ؤُڒَا ذ يجّن مَا يبدّ اَكِذِي. وَار خَاسن ت يتْحِيسِيب شَا سِيذِي أَربِّـي. <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />ذ سِيذِيثْنغ إِي كِذِي يبدّن غَار وغزْذِيس ينُو يُوْشَا-ٱيِي جّْهذ حمَا زَّايِي نش اَذ يتْوَابشَّر لْإِنْجِيل يكْمَاڒ اَث سْڒن مَارَّا يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل، سّنِّي نش فڒْثغ زݣ ؤُقمُّوْم ن سّْبَاع.<note caller="+" style="f"><char style="fr" closed="false">4‏.17 </char><char style="ft" closed="false">سّْبَاع نتَّا ذ اَيْرَاذ، س ثعْرَابْث الأَسد.</char></note> <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />أَذَايِي يسفْڒث سِيذِيثْنغ زِي مْكُڒ ثَمسْڒَايْث ذ ثَعفَّانْت اَذَايِي يسنْجم غَار ڒْمُلْك نّس يدْجَان ذݣ وجنَّا. أَغَارس ثِيڒِي لْعَظَمَا إِ ڒبْدَا ن ڒبْدَاث. آمِين.<verse eid="2TI 4:18" /></para>
  <para style="s">لْخِتَام ن ثبْرَات-أَ</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />سِيْوض-اَس سْڒَام إِ پْـرِيْسْكِيْلَا ذ وَاكِيْلَاس ذ ثدَّارْث ن وَانِيْسْفُوْر. <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" />ئِقِّيم أَرِيْسْطُوْس ذِي ثنْدِينْت ن كُوْرِيْنْث، تْرِيْفُوْمُو جِّيغ-ث نش ذِي ثنْدِينْت ن مِيْلِيْتُوْس يهْڒش. <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />اݣّ لْمجْهُوْد نّش بَاش اَذ د تَاسذ قْبڒ إِ ڒْمشْتَا-يَا. ئِسَّاوَاض-اَش-د سْڒَام يُوْبُوْلُوْس ؤُڒَا ذ بُوْدن ذ لِيْنُوْس ذ <char style="it">ؤُتْشْمَاثْنغ</char> كْلُوْدْيَا ذ مَارَّا اَيثْمَاثْنغ.<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />أَذ يِيڒِي سِيذِيثْنغ اَك اَرُّوْح نّش. أَذ يِيڒِي اَرْضَا اَكِذْوم مَارَّا.<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>