<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LUK" style="id">- TarifitABS</book>
  <para style="h">لوقا</para>
  <para style="toc3">لوق</para>
  <para style="toc2">لوقا</para>
  <para style="toc1">أَسڒْمذ ن سِيذِيثْنغ عِيْسَى لْكِتَاب ن لُوْقَا</para>
  <para style="mt1">أَسڒْمذ ن سِيذِيثْنغ عِيْسَى</para>
  <para style="mt3">لْكِتَاب ن لُوْقَا</para>
  <chapter number="1" style="c" sid="LUK 1" />
  <para style="s">لُوْقَا يتَارِي إِ يِجّن ن سِّيّد قَّارن-اَس تُوْفِيلُوْس</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1" />آ سِي تُوْفِيلُوْس، أَطّاس ن يِوْذَان ݣِّين اَذ اَرِين مِين يوقْعن غَارْنغ. <verse eid="LUK 1:1" /><verse number="2" style="v" sid="LUK 1:2" />ؤُرِين نِيشَان عْلَاحْسَاب مَامْش ذَانغ خْبَرن ڒشْهُوْذ ذ يخدَّامن ن وَاوَاڒ <char style="it">ن أَربِّـي</char> يدْجَان ذݣ ومزْوَارُو. <verse eid="LUK 1:2" /><verse number="3‏-4" style="v" sid="LUK 1:3-4" />آ سِيذِي ؤُڒَا ذ نش تْغِيڒ-اَيِي مْلِيح اَذ ݣّغ اَذ اَرِيغ مِين يوقْعن وَامِي بحْثغ ذِي مَارَّا مَانَايَا مْلِيح. أَذَاش ث اَرِيغ ثَا س ثَا حمَا اَذ تسّْنذ ڒْحَقّ ن ثْمسْڒَايِين نِّي إِي ذَاش سڒْمَاذن.<verse eid="LUK 1:3-4" /></para>
  <para style="s">لْمَلَاك يتْخبَّر مَامّش غَا د يخْڒق سِيذْنَا يَحْيَى</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5" />تُوْغَا ذِي ڒْوقْث ن وزدْجِيذ هِيرُوْدُس نتَّا يحكّْمن خ ثْمُوْرْث ن يَهُوْذِيَا ذِنِّي يجّن ن ڒفْقِي نتَّا زِي لْفِرْقَا ن أَبْيُو قَّارن-اَس زَكَرِيَا. غَارس يجّن ن ثمْغَارْث زِي دُّوْرِّيث ن هَارُوْن نتَّاث قَّارن-اَس إِلِيزَابت. <verse eid="LUK 1:5" /><verse number="6" style="v" sid="LUK 1:6" />زَكَرِيَا ذ إِلِيزَابت نِثْنِي ݣُّوْرن نِيشَان اَك أَربِّـي، ؤُڒ نْسن ذ اَشمْڒَاڒ. تݣّن مَارَّا مِين يُوْمَر ذ مَارَّا مِين يوصَّا سِيذِي أَربِّـي. <verse eid="LUK 1:6" /><verse number="7" style="v" sid="LUK 1:7" />وَلَكِن وَار غَارْسن بُو يحنْجِيرن مِينْزِي إِلِيزَابت وَار تِيرو شَا. عَاوذ نِثْنِي س ثْنَاين إِذْسن مْغَارن اَطَّاس.<verse eid="LUK 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8" />ئِجّن ن نْهَار زَكَرِيَا ثُوْوض-د نُّوْبَا نّس اَذ يخْذم ذِي ثمْزِيذَا ذ ڒفْقِي زَّاث إِ أَربِّـي اَك لْفِرْقَا نّس. <verse eid="LUK 1:8" /><verse number="9" style="v" sid="LUK 1:9" />ݣِّين لْقُرْعَا عْلَاحْسَاب تَّقَلِيد نْسن إِي تݣّن ڒْفُقَهَا. نْهَار نِّي ثُوْسَا-د لْقُرْعَا ذِي زَكَرِيَا بَاش اَذ يَاذف غَار ثمْزِيذَا ثَمقّْرَانْت ن سِيذِي أَربِّـي حمَا اَذ يشعّڒ تْبَخُوْر ذِنِّي. <verse eid="LUK 1:9" /><verse number="10" style="v" sid="LUK 1:10" />وَامِي يتْشعَّاڒ تْبَخُوْر، مَارَّا شَّعْب نِّي إِي ذِنِّي يمُوْنن قِّيمن غَار بَارَّا إِ ثمْزِيذَا تْࢲَدْجَان. <verse eid="LUK 1:10" /><verse number="11" style="v" sid="LUK 1:11" />ڒخْدّنِّي يمظْهَار-اَس-د إِ زَكَرِيَا يجّن ن لْمَلَاك ن سِيذِي أَربِّـي يبدّ خ وفُوْسِي ن ڒْمذْبَح ن تْبَخُوْر. <verse eid="LUK 1:11" /><verse number="12" style="v" sid="LUK 1:12" />زَكَرِيَا وَامِي ث يࢲْرَا ينخْڒع، ئِݣّْوذ.<verse eid="LUK 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 1:13" />ينَّا-ٱس لْمَلَاك نِّي: "آ زَكَرِيَا وَار تݣّْوذ شَا، قَا يسْتَاجب-اَش أَربِّـي ذِي مِين ذَاس ثتَّارذ. ثَمْغَارْث نّش إِلِيزَابت اَذَاش د ثجّ يجّن ن وحنْجِير، أَث ثسمِّيذ شك يَحْيَى. <verse eid="LUK 1:13" /><verse number="14" style="v" sid="LUK 1:14" />سَّعْذ نّش اَذ تْفَرْحذ. خْمِي د غَا يخْڒق اَزَّايس فَرْحن اَطَّاس ن يِوْذَان <verse eid="LUK 1:14" /><verse number="15" style="v" sid="LUK 1:15" />مِينْزِي اَذ يِيڒي ذ اَمقّْرَان غَار سِيذِي أَربِّـي. أَذ تِيڒِي لَابُد عمَّارْص اَذ يسو اَمَان ن وضِيڒ نِغ ذ وَامَان ن يمنْدِي. أَذ يِيڒِي يعمَّر س اَرُّوح يقدّْسن حتَّا ذݣ وعدِّيس ن يمَّاس. <verse eid="LUK 1:15" /><verse number="16" style="v" sid="LUK 1:16" />أَذ يَارّ اَطَّاس ن أَيْث-إِسْرَائِيل غَار سِيذِي أَربِّـي نْسن. <verse eid="LUK 1:16" /><verse number="17" style="v" sid="LUK 1:17" />أَذ يُوْيُوْر زَّاث إِ سِيذِي أَربِّـي س يِجّن ن اَرُّوْح يجْهذ اَم ونِّي ن <char style="it">نَّبِي</char> إِلْيَاس. أَذ يسْمصْڒَاح لْوَالِدِين اَك ثَارْوَا نْسن. أَذ يَارّ يِنِّي يعصَّان غَار وبْرِيذ ن يِنِّي يدْجَان نِيشَان حمَا اَذ يسوْجذ شَّعْب إِ سِيذِي أَربِّـي اَذ يڒِين وجْذن."<verse eid="LUK 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18" />ينَّا-ٱس زَكَرِيَا إِ لْمَلَاك نِّي: "مَامّش غَا سّْنغ نش مَانَايَا ذ صَّح؟ قَا نش وسَّارغ، ثَمْغَارْث ينُو ثوْسَر."<verse eid="LUK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19" />ئِنْدق-د لْمَلَاك نِّي ينَّا-ٱس: "قَا نش ذ جِبْرِيل ذ ونِّي يتْبدَّان زَّاث إِ أَربِّـي، ئِسّكّ-اَيِي-د أَربِّـي غَارش بَاش اَكِش سِّيوْڒغ اَذَاش ينِيغ ڒخْبَار-أَ يسْفَرَّاحن. <verse eid="LUK 1:19" /><verse number="20" style="v" sid="LUK 1:20" />ڒخُّو شك اَذ تِيڒِيذ ذ اَزينُوْن. وَار ثسِّيوِيڒذ شَا حتَّا اَڒ نْهَار نِّي إِي غَا يوْقع مَانَايَا مِينْزِي شك وَار ثُوْمِينذ شَا زݣ وَاوَاڒ ينُو ونِّي إِي د غَا يفّْغن نِيشَان ذِي ڒْوقْث نّس."<verse eid="LUK 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21" />شَّعْب قِّيمن تْرَاجَان زَكَرِيَا، تْعجّْبن وَامِي يعْظڒ اَطَّاس غَار ذَاخڒ ذِي ثمْزِيذَا ثَمقّْرَانْت. <verse eid="LUK 1:21" /><verse number="22" style="v" sid="LUK 1:22" />وَامِي د يفّغ سّنِّي وَار يزمَّر شَا اَكِذْسن يسِّيوڒ، ئِقِّيم يسَّاوَاڒ اَكِذْسن س يفَاسّن وَاهَا. سّنِّي فهْمن يمظْهَار-اَس-د لْوَحِي غَار ذَاخڒ ذِي ثمْزِيذَا ثَمقّْرَانْت يذْوڒ ذ اَزينُوْن.<verse eid="LUK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23" />وَامِي عْذُوْن وُوْسَّان ن ڒْخذْمث نّس يذْوڒ غَار ثدَّارْث نّس. <verse eid="LUK 1:23" /><verse number="24" style="v" sid="LUK 1:24" />منْبَعد ثيْسِي ثمْغَارْث نّس إِلِيزَابت اَعدِّيس ثقِّيم خمْس شْهُوْر ثسْنُوْفَّر يخْف نّس. <verse eid="LUK 1:24" /><verse number="25" style="v" sid="LUK 1:25" />ثقَّار: "ذ مَانَايَا إِي ذَايِي يُوْشَا سِيذِي أَربِّـي ذِي نْهَار وَامِي ذَايِي يفْقذ حمَا اَخَافِي يكّس ڒْعِيب ن يِوْذَان."<verse eid="LUK 1:25" /></para>
  <para style="s">لْمَلَاك يتْخبَّار مَامْش د غَا يخْڒق سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26" />إِلِيزَابت وَامِي ثدْجَا ذِي شْهَار وِيس ستَّا، ئِسّكّ-د أَربِّـي يجّن ن لْمَلَاك قَّارن-اَس جِبْرِيل غَار يِجّن ن وبِيلَاج ذِي ثْمُوْرْث ن لْجَلِيل قَّارْن-اَس نَاصِرَا. <verse eid="LUK 1:26" /><verse number="27" style="v" sid="LUK 1:27" />ئِرُوْح غَار يِجّن ن ثعْزْرِيث قَّارن-اَس مَرْيَم ثنِّي إِي كذ يݣَّا زُّوْجِيَا يجّن ن ورْيَاز زِي دُّوْرِّيث ن دَاود نتَّا قَّارن-اَس يُوْسف. <verse eid="LUK 1:27" /><verse number="28" style="v" sid="LUK 1:28" />يُوْذف غَارس لْمَلَاك نِّي ينَّا-ٱس: "آزُوْل يَا ثنِّي إِي خف يرْضَا أَربِّـي، أَقَا سِيذِي أَربِّـي اَقَاث اَكِذم."<verse eid="LUK 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29" />ذِنِّي مَرْيَم ثْنخْڒع وَامِي ثسْڒَا إِ وَاوَاڒن نّس. ثْرزُّو اَذ تْميّز مِين يعْنَا سْڒَام نِّي؟<verse eid="LUK 1:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 1:30" />ينَّا-ٱس لْمَلَاك نِّي: "وَار تݣّْوذ شَا آ مَرْيَم، أَقَا شم يَارْضَا خَام أَربِّـي! <verse eid="LUK 1:30" /><verse number="31" style="v" sid="LUK 1:31" />أَذ تيْسِيذ اَعدِّيس، أَذ د تجّذ يجّن ن وحنْجِير اَث تْسمِّيذ عِيْسَى. <verse eid="LUK 1:31" /><verse number="32" style="v" sid="LUK 1:32" />أَذ يِيڒِي يمْغَر، أَتَاف تْڒَغَان-اَس آ مِّيس ن ونِّي يُوْعْڒَان. أَذَاس يُوْش سِيذِي أَربِّـي نّس لْعَرْش ن جدِّيس اَمقّْرَان دَاود. <verse eid="LUK 1:32" /><verse number="33" style="v" sid="LUK 1:33" />أَذ يحْكم خ ڒْقُم ن يَعْقُوْب إِ ڒبْدَا، ڒْمُلْك نّس عمَّارْص اَذ يفْنَا."<verse eid="LUK 1:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34" />ثنَّا-ٱس مَرْيَم إِ لْمَلَاك نِّي: "مَامّش إِي غَا يِيڒِي مَانَايَا؟ أَقَا نش عَاذ ذ ثَعْزْرِيث."<verse eid="LUK 1:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35" />ئِنْدق-د لْمَلَاك نِّي ينَّا-ٱس: "أَخَام د يهْوَا اَرُّوْح يقدّْسن ذ جّْهذ ن ونِّي يُوْعْڒَان اَخَام يَارّْ ثِيڒِي. س مَانَاينِّي اَحنْجِير يقدّْسن إِي غَا د ثجّذ اَتَاف تْڒَغَان-اَس آ مِّيس ن أَربِّـي. <verse eid="LUK 1:35" /><verse number="36" style="v" sid="LUK 1:36" />إِلِيزَابت ثنِّي يدْجَان زِي ڒحْبَاب نّم، وَاخَّا نتَّاث ثمْغَار اَقَات س وعدِّيس. أَقَات ذِي شْهَار وِيس ستَّا وَاخَّا تْڒَغَان-اَس يِوْذَان آ ثنِّي وَار يتِيرْون شَا. <verse eid="LUK 1:36" /><verse number="37" style="v" sid="LUK 1:37" />وَار ثدْجِي بُو شَان ڒْحَاجث ثقْسح غَار أَربِّـي."<verse eid="LUK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38" />ثنَّا-ٱس مَرْيَم: "نش اَقَايِي ذ ثَخدَّانْت غَار سِيذِي أَربِّـي، أَرْضِيغ خ وَاوَاڒ نّش اَذَايِي يوْقع." سّنِّي يرُوْح خَاس لْمَلَاك نِّي.<verse eid="LUK 1:38" /></para>
  <para style="s">مَرْيَم ذ إِلِيزَابت</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39" />ذݣ وُوْسَّان نِّي ثكَّر مَرْيَم ثْرُوْح س ثَازّْڒَا غَار وذْرَار غَار يِجّن ن وبِيلَاج ذِي ثْمُوْرْث ن يَهُوْذِيَا. <verse eid="LUK 1:39" /><verse number="40" style="v" sid="LUK 1:40" />ثُوْذف غَار ثدَّارْث ن زَكَرِيَا ثْسدْجم خ إِلِيزَابت. <verse eid="LUK 1:40" /><verse number="41" style="v" sid="LUK 1:41" />وَامِي ثسْڒَا إِلِيزَابت إِ سْڒَام ن مَرْيَم، ئِنْهزّ وسيْمِي نِّي ذݣ وعدِّيس نّس، نتَّاث ثشُّوْر س أَرُّوْح يقدّْسن. <verse eid="LUK 1:41" /><verse number="42" style="v" sid="LUK 1:42" />ثْڒَاغَا س يِجّن ن ثْمِيجَّا ثجْهذ ثنَّا:</para>
  <para style="q1" vid="LUK 1:42">"شم تْوَابَرْكذ جَار ثمْغَارِين،</para>
  <para style="q2" vid="LUK 1:42">عَاوذ يتْوَابَرك ونِّي إِي يدْجَان ذݣ وعَدِّيس نّم!<verse eid="LUK 1:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="LUK 1:43" />نْهَارَا ذ نْهَار ذ اَمقّْرَان إِ نش وَامِي غَارِي د تُوْسَا يمَّاس ن سِيذِي!<verse eid="LUK 1:43" /></para>
  <para style="q2">
    <verse number="44" style="v" sid="LUK 1:44" />وَامِي د تُوْسِيذ سْڒِيغ إِ سْڒَام نّم، ئِنْهزّ وعدِّيس ينُو س ڒفْرَاحث.<verse eid="LUK 1:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="LUK 1:45" />آ سَّعْذ ن ثنِّي يُوْمْنن مِين ذَاس ينَّا سِيذِي أَربِّـي اَذ يِيڒِي."<verse eid="LUK 1:45" /></para>
  <para style="s">مَرْيَم ثْحمّذ أَربِّـي</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46" />أُوْشَا ثنَّا مَرْيَم:</para>
  <para style="q1" vid="LUK 1:46">"ڒَعْمَر ينُو يحمّذ سِيذِي أَربِّـي،<verse eid="LUK 1:46" /></para>
  <para style="q2">
    <verse number="47" style="v" sid="LUK 1:47" />أَرُّوح ينُو يفَرح زِي أَربِّـي إِي ذَايِي يسْنجْمن.<verse eid="LUK 1:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48" />ئِࢲْرَا-ٱيِي ذ ثَخدَّانْت نّس ذ ثَدْرِيوشْت وَاهَا.</para>
  <para style="q2" vid="LUK 1:48">سَّا اَڒ ثْسَاونْت مَارَّا يوْذَان اَذَايِي حسّْبن ذ ثَمِيمُوْنْت،<verse eid="LUK 1:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="LUK 1:49" />مِينْزِي ونِّي يزمَّرن يݣّا-ٱيِي اَطَّاس ن ثْمسْڒَايِين ثِمقّْرَانِين.</para>
  <para style="q2" vid="LUK 1:49">نتَّا يسم نّس ذ اَمقّْرَان،<verse eid="LUK 1:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50" />أَرَّحْمث نّس ثدْجَا زِي لْجِيل غَار لْجِيل إِ يِنِّي ث يتݣّْوْذن.<verse eid="LUK 1:50" /></para>
  <para style="q2">
    <verse number="51" style="v" sid="LUK 1:51" />ئِݣَّا س وفُوْس نّس ڒخْذَايم ذ ثِمقّْرَانِين،</para>
  <para style="q1" vid="LUK 1:51">ئِشتَّت يِنِّي يحسْبن يخف نْسن ذ يمقّْرَانن.<verse eid="LUK 1:51" /></para>
  <para style="q2">
    <verse number="52" style="v" sid="LUK 1:52" />ئِسهْوَا-د يزدْجِيذن زِي لْعَرْشَاث نْسن،</para>
  <para style="q1" vid="LUK 1:52">يسْݣَعّذ يِنِّي يدْجَان ذ ذْرَاوش.<verse eid="LUK 1:52" /></para>
  <para style="q2">
    <verse number="53" style="v" sid="LUK 1:53" />ئِسجِّيْون س ڒْخِير نّس يِنِّي يدْجُوْزن،</para>
  <para style="q1" vid="LUK 1:53">ئِسّكّ تْوَاجَر س يفَاسّن نْسن خْوَان.<verse eid="LUK 1:53" /></para>
  <para style="q2">
    <verse number="54" style="v" sid="LUK 1:54" />ئِعَاون أَيْث-إِسْرَائِيل إِي يدْجَان ذ ڒْعَبْذ نّس عْلَاحْسَاب اَرَّحْمث نّس،<verse eid="LUK 1:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55" />مَامْش يوْعذ ڒجْذُوْذ نّغ،</para>
  <para style="q2" vid="LUK 1:55">بْرَاهِيم ذ دُّوْرِّيث نّس إِ ڒبْدَا."<verse eid="LUK 1:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56" />ثقِّيم مَرْيَم اَك إِلِيزَابت شَان ثڒْت شْهُوْر سّنِّي ثعْقب-د غَار ثدَّارْث نّس.<verse eid="LUK 1:56" /></para>
  <para style="s">أَمُّو يخْڒق سِيذْنَا يَحْيَى</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57" />وَامِي د ثُوْوض ڒْوقْث ن إِلِيزَابت اَذ تَارو، ثجَّا-د اَحنْجِير. <verse eid="LUK 1:57" /><verse number="58" style="v" sid="LUK 1:58" />جِّيرَان نّس ذ ڒحْبَاب نّس فَرْحن اَكِذس وَامِي غَارْسن ڒخْبَار بلِّي سِيذ أَربِّـي يرْضَا خَاس اَطَّاس. <verse eid="LUK 1:58" /><verse number="59" style="v" sid="LUK 1:59" />ثعْذُو ثْمنْيَام، ؤُسِين-د يِوْذَان حمَا اَث طهَّارن. رزُّوْن اَذَاس سمَّان زَكَرِيَا خ يِيسم ن بَابَاس، <verse eid="LUK 1:59" /><verse number="60" style="v" sid="LUK 1:60" />وَلَكِن يمَّاس ثُوْݣِي ثنَّا-ٱسن: "لَّا، أَث نْسمَّا يَحْيَى."<verse eid="LUK 1:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 1:61" />نَّان-اَس: "ؤُڒَا ذ يجّن زِي ڒحْبَاب نّمْ مَا يسمَّا س يِيسم-أَ." <verse eid="LUK 1:61" /><verse number="62" style="v" sid="LUK 1:62" />سّقْسَان بَابَاس س يفَاسّن: "مَامّش ثخْسذ شك اَث تسمِّيذ؟"<verse eid="LUK 1:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 1:63" />ئِتَّار زَكَرِيَا يجّن ن ثَڒْوِيحت يُوْرَا ذَايس: "ئِسم نّس يَحْيَى." قِّيمن يِوْذَان نِّي تْعجّْبن مَارَّا إِذْسن. <verse eid="LUK 1:63" /><verse number="64" style="v" sid="LUK 1:64" />ذݣ ومْشَان ينْدق زَكَرِيَا يبْذَا يسَّاوَاڒ يحمّذ أَربِّـي. <verse eid="LUK 1:64" /><verse number="65" style="v" sid="LUK 1:65" />ݣّْوْذن مَارَّا جِّيرَان. بْذَان سَّاوَاڒن يِوْذَان خ مَارَّا مَانَايَا ذِي مَارَّا يذُوْرَار ن ثْمُوْرْث ن يَهُوْذِيَا. <verse eid="LUK 1:65" /><verse number="66" style="v" sid="LUK 1:66" />مَارَّا ؤُݣ يتسْڒَان خ ثْمسْڒَايِين-أَ قّارن ذݣ وُوْڒَاون نْسن، مِين غَا يذْوڒ وحنْجِير-أَ؟ مِينْزي فُوْس ن سِيذِي أَربِّـي اَقَاث اَكِذس.<verse eid="LUK 1:66" /></para>
  <para style="s">زَكَرِيَا يحمّذ أَربِّـي</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67" />زَكَرِيَا بَابَاس ن يَحْيَى، يشُّوْر س أَرُّوْح يقدّْسن، ئِسِّيوڒ س مِين يعْڒم زِي أَربِّـي ينَّا:<verse eid="LUK 1:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68" />"لْحَمْدُ لِلَّه إِ سِيذِي أَربِّـي ن أَيث-إِسْرَائِيل،</para>
  <para style="q2" vid="LUK 1:68">ڒَاحقَّاش يفْقذ شَّعْب نّس يفكّ-يث.<verse eid="LUK 1:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69" />ئِسْمظْهَار-اَنغ-د ونِّي ذݣ يدْجَا جّْهذ إِي ذَانغ غَا يسْنجْمن،</para>
  <para style="q2" vid="LUK 1:69">يُوْسَا-د زِي دُّوْرِّيث ن دَاود ڒْعَبْذ ن أَربِّـي.<verse eid="LUK 1:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70" />مَانَايَا يسِّيوڒ س يِيڒسَاون ن لْأَنْبِيَا صَّالِحِين اَطَّاس زݣ وَامِي،<verse eid="LUK 1:70" /></para>
  <para style="q2">
    <verse number="71" style="v" sid="LUK 1:71" />أَذَانغ يسنْجم زِي ڒْعَذْيَان نّغ،</para>
  <para style="q1" vid="LUK 1:71">عَاوذ زݣ يفَاسّن ن مَارَّا يِنِّي ذَانغ يتْعِيفَّان.<verse eid="LUK 1:71" /></para>
  <para style="q2">
    <verse number="72" style="v" sid="LUK 1:72" />أَذ د يسْمظْهَار اَرَّحْمث نّس إِي زِي يوْعذ ڒجْذُوْذ نّغ،</para>
  <para style="q1" vid="LUK 1:72">أَذ يعْقڒ خ ڒْعَهذ نّس يقدّْسن.<verse eid="LUK 1:72" /></para>
  <para style="q2">
    <verse number="73" style="v" sid="LUK 1:73" />يُوْشَا-اَس ڒْعَهذ إِ جدِّيثْنغ بْرَاهِيم،<verse eid="LUK 1:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="LUK 1:74" />أَذَانغ يسنْجم زݣ يفَاسّن ن ڒْعَذْيَان نّغ،</para>
  <para style="q2" vid="LUK 1:74">حمَا اَث نعْبذ بْڒَا ثِيݣّْوْذِي،<verse eid="LUK 1:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75" />س وُوْڒ يصْفَا ذ اَشمْڒَاڒ إِ مَارَّا ثُوْذَارْث نّغ.<verse eid="LUK 1:75" /></para>
  <para style="q2">
    <verse number="76" style="v" sid="LUK 1:76" />ئِي شك آي اَحنْجِير،</para>
  <para style="q1" vid="LUK 1:76">أَذَاش تْڒَغَان نَّبِي ن ونِّي يُوْعْڒَان،</para>
  <para style="q2" vid="LUK 1:76">مِينْزِي اَذ تُوْيُوْرذ غَار زَّاث حمَا اَذ تسْوجْذذ اَبْرِيذ إِ سِيذِي أَربِّـي.<verse eid="LUK 1:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77" />عَاوذ اَذ تسْڒمْذذ إِ شَّعْب نّس خ وسنْجم،</para>
  <para style="q2" vid="LUK 1:77">يعْنِي مَامش إِي غَا تْوَاغْفَرنْت ڒْمُعْصِيَاث نْسن.<verse eid="LUK 1:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78" />مِينْزِي أَربِّـي نّغ ذ اَرَحْمَان ذ اَرَحِيم،</para>
  <para style="q2" vid="LUK 1:78">ئِفْقذ-اَنغ-د زݣ وجنَّا خْمِي ثْغدْجِي ثْفُوْشْت.<verse eid="LUK 1:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79" />حمَا اَذ يُوْش ثْفَاوْث إِ يِنِّي يتْعِيشن ذِي ثَادْجسْت ذِي ثِيڒِي ن ڒْموْث،</para>
  <para style="q2" vid="LUK 1:79">حمَا اَذَانغ يسُوْيُوْر يضَارن نّغ غَار وبْرِيذ ن ڒهْنَا."<verse eid="LUK 1:79" /></para>
  <para style="b" />
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80" />تُوْغَا اَحنْجِير يتمْغَار يتجْهِيذ س اَرُّوْح نّس. ئِزدّغ ذِي ڒخْڒَا اَڒ وَامِي د يمظْهَار إِ أَيْث-إِسْرَائِيل.<verse eid="LUK 1:80" /></para>
  <chapter eid="LUK 1" />
  <chapter number="2" style="c" sid="LUK 2" />
  <para style="s">أَمُّو إِي د يخْڒق سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1" />ذِي ڒِيَّام نِّي اَزدْجِيذ قَيْصَر أَݣُسْطُس يُوْشَا لْأَمَار اَذ حسْبن مَارَّا يمزْذَاغ ن ثْمُوْرَا إِي ذِي يحْكم. <verse eid="LUK 2:1" /><verse number="2" style="v" sid="LUK 2:2" />أَحْسَاب-أَ اَمزْوَارُو يوْقع وَامِي يحْكم كُرِينُوْس ذِي ثْمُوْرْث ن سُوْرْيَا. <verse eid="LUK 2:2" /><verse number="3" style="v" sid="LUK 2:3" />رُوْحن مَارَّا يوْذَان حمَا اَذ سجّْلن، كُڒ يجّن يرُوْح غَار وبِيلَاج نّس.<verse eid="LUK 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4" />ئِݣَعّذ يُوْسف زِي ثْمُوْرْث ن لْجَلِيل زݣ وبِيلَاج ن نَاصِرَا يرُوْح غَار ثْمُوْرْث ن يَهُوْذِيَا غَار وبِيلَاج ن دَاود ونِّي ؤُمِي قَّارن بَيْت لَحْم مِينْزِي نتَّا زِي دُّوْرِّيث ن دَاود ذ ڒحْبَاب نّس. <verse eid="LUK 2:4" /><verse number="5" style="v" sid="LUK 2:5" />ئِݣَعّذ ذِنِّي اَذ يسجّل نتَّا ذ مَرْيَم ثنِّي إِي كذ يݣَّا زُّوْجِيَا، نتَّاث اَقَات س وعدِّيس. <verse eid="LUK 2:5" /><verse number="6" style="v" sid="LUK 2:6" />وَامِي ؤُوْضن ذِنِّي، ثُوْوض-د ڒْوقْث نّس حمَا اَذ تَارو. <verse eid="LUK 2:6" /><verse number="7" style="v" sid="LUK 2:7" />ثُوْرو مِّيس اَمنْزُو ثْصحْنُوْنّض-يث ثݣِّي-ث ذِي ڒْمذْوذ مِينْزِي وَار ؤُفِين بُو ومْشَان ذِي ثدَّارْث ن يمْسَافَرن.<verse eid="LUK 2:7" /></para>
  <para style="s">لْمَلَائِكَاث ذ يمكْسَاون</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8" />تُوْغَا ذِنِّي اَڒ جِّهث نِّي يمكْسَاون حطَّان ثِيحِيمرِيوِين نْسن س دْجِيڒث. <verse eid="LUK 2:8" /><verse number="9" style="v" sid="LUK 2:9" />ثُوْسَا-د يجّن ن لْمَلَائِكَا ن سِيذ أَربِّـي ثبدّ-د غَارْسن، ئِتْشعْشِيع نُّوْر ن لْعَظَمَا ن سِيذ أَربِّـي ينّض-د خَاسن ݣّْوْذن اَطَّاس. <verse eid="LUK 2:9" /><verse number="10" style="v" sid="LUK 2:10" />ثنَّا-ٱسن لْمَلَائِكَا نِّي: "وَار تݣّْوْذم شَا. أَقَا نش تْبشَّارغ-كنِّيو س يِجّن ن ڒخْبَار يمْغَر اَطَّاس اَزَّايس يفَرح مَارَّا شَّعْب. <verse eid="LUK 2:10" /><verse number="11" style="v" sid="LUK 2:11" />ئِخْڒق-د نْهَارَا ذݣ وبِيلَاج ن دَاود ونِّي إِي كنِّيو غَا يسْنجْمن، نتَّا ذ سِيذِيثْنغ لْمَسِيح. <verse eid="LUK 2:11" /><verse number="12" style="v" sid="LUK 2:12" />كنِّيو اَذ تَافم يجّن ن لْعَلَامَا اَذ تَافم يجّن ن وسيْمِي يحْنُوْنّض يطّس ذِي ڒْمذْوذ." <verse eid="LUK 2:12" /><verse number="13" style="v" sid="LUK 2:13" />عْلَاغَفْلَا مظْهَارن-د اَك لْمَلَائِكَا نِّي اَطَّاس ن يمزْذَاغ ن وجنَّا حمّْذن أَربِّـي قَّارن:<verse eid="LUK 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 2:14" />"لْعَظَمَا إِ أَربِّـي يُوْعْڒَان،</para>
  <para style="q1" vid="LUK 2:14">ذ ڒهْنَا ن يِنِّي ذِي ثْمُوْرْث مِيخف يرْضَا."<verse eid="LUK 2:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15" />وَامِي رُوْحنْت لْمَلَائِكَاث نِّي عقْبنْت غَار وجنَّا، سِّيوْڒن يمكْسَاون نِّي جَارَاسن نَّان: "يَالَّاهت أَ نْرَاحث غَار بَيْت لَحْم أَ نْࢲر مَانَايَا إِݣ يوقْعن مِين خَانغ يسِّيوڒ سِيذِي أَربِّـي."<verse eid="LUK 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16" />رُوْحن ذغْيَا ؤُفِين مَرْيَم ذ يُوْسف ذ وسيْمِي نِّي يطّس ذِي ڒْمذْوذ. <verse eid="LUK 2:16" /><verse number="17" style="v" sid="LUK 2:17" />وَامِي ث ؤُفِين ذِنِّي، كَّرن خْبَرن يوْذَان مِين ذَاسن ثنَّا لْمَلَائِكَا نِّي خ وحنْجِير-أَ. <verse eid="LUK 2:17" /><verse number="18" style="v" sid="LUK 2:18" />مَارَّا ونِّي يتْسْڒَان يتْعجّب ذݣ وَاوَاڒ نِّي إِي ذَاسن نَّان يمكْسَاون. <verse eid="LUK 2:18" /><verse number="19" style="v" sid="LUK 2:19" />أَمَّا مَرْيَم، ثْخمّڒ مَارَّا ثِمسْڒَايِين-أَ ذݣ وُوْڒ نّس تْخمَّام ذَايْسنْت. <verse eid="LUK 2:19" /><verse number="20" style="v" sid="LUK 2:20" />سّنِّي عقْبن يمكْسَاون نِّي سمْغَارن أَربِّـي حمّْذن-ث خ مَارَّا مِين سْڒِين ذ مِين ࢲْرِين، ؤُفِين ثِمسْڒَايِين نِّي وقْعنْت نِيشَان اَمشْنَاو مَامْش ذَاسن ثنَّا <char style="it">لْمَلَائِكَا نِّي</char>.<verse eid="LUK 2:20" /></para>
  <para style="s">طَّهَارث ن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21" />وَامِي يكمّڒ وحنْجِير نِّي ثْمنِيَّام حمَا اَذَايس يطهَّار، سمَّان-ث عِيْسَى س يِيسم نِّي مَامْش ث يسمَّا لْمَلَاك نِّي زِي قْبڒ مَا ٱذ يِيڒي ذݣ وعْدِيس ن يمَّاس.<verse eid="LUK 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22" />وَامِي كمّْڒن وُوسَّان نِّي إِي ذِي تݣّن رُوْضُو بَاش لْوَلِدِين نّس اَذ يڒِين صْفَان عْلَاحْسَاب شَّرِيعَا ن مُوْسَى، ؤُوِين-ث غَار ثنْذِينْت ن لْقُدْس حمَا اَخَاس تَّارن إِ سِيذ أَربِّـي. <verse eid="LUK 2:22" /><verse number="23" style="v" sid="LUK 2:23" />أَمُّو إِݣ يُوْرِي ذِي لْكِتَاب ن سِيذ أَربِّـي:</para>
  <para style="q" vid="LUK 2:23">&lt;مْكُڒ مِّيس اَمنْزُو اَذ يِيڒِي ذ اَمقّْرَان غَار سِيذ أَربِّـي.&gt;<verse eid="LUK 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 2:24" />عَاوذ بَاش اَذ قدّْمن يجّن ن دْبِيحث مَامْش د يُوْسَا ذِي لْكِتَاب ن سِيذ أَربِّـي:</para>
  <para style="q" vid="LUK 2:24">&lt;ثْنَاين ن ثذْبِيرِين ن ڒخْڒَا،</para>
  <para style="q" vid="LUK 2:24">نِغ ثْنَاين ن ثذْبِيرِين ذ ثِمزْيَانِين.&gt;<verse eid="LUK 2:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25" />تُوْغَا ذِنِّي ذِي ثنْدِينْت ن لْقُدْس يجّن ن بْنَاذم قَّارن-اَس شِمْعُوْن. ئِݣُّوْر نِيشَان، يتݣّْوذ أَربِّـي، ئِتْرَاجَا أَيث-إِسْرَائِيل اَذ نجْمن، أَرُّوْح يقدّْسن اَقَاث خَاس. <verse eid="LUK 2:25" /><verse number="26" style="v" sid="LUK 2:26" />تُوْغَا نتَّا يخْبَر-يث أَرُّوْح يقدّْسن وَار يتْمتِّي شَا اَڒ غَا يࢲر لْمَسِيح ن سِيذ أَربِّـي. <verse eid="LUK 2:26" /><verse number="27" style="v" sid="LUK 2:27" />ئِكَّر شِمْعُوْن يسُوْيُوْر-يث أَرُّوْح يقدّْسن غَار ثمْزِيذَا ثَمقّْرَانْت. وَامِي ؤُذْفن لْوَالِدِين ن عِيْسَى حمَا اَذَاس ݣّن مِين ثقَّار شَّرِيعَا ن مُوْسَى، <verse eid="LUK 2:27" /><verse number="28" style="v" sid="LUK 2:28" />يُوْفَا شِمْعُوْن اَحَرْمُوْش نِّي يِيسِي-ث جَار يفَاسّن نّس يشكَّر أَربِّـي ينَّا:<verse eid="LUK 2:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="LUK 2:29" />"يَا مُوْلَانَا، اجّ-اَيِي ڒْعَبْذ نّش اَذ رَاحغ ڒخُّو غَار ثدَّارْث ن ڒهْنَا،</para>
  <para style="q" vid="LUK 2:29">أَمشْنَاو مَامْش ثنِّيذ شك س وَاوَاڒ نّش.<verse eid="LUK 2:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="LUK 2:30" />مِينْزِي ثِيطَّاوِين ينُو ࢲْرِينْت اَسنْجم نّش،<verse eid="LUK 2:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="LUK 2:31" />إِي ثسْوجْذذ إِ مَارَّا يوْذَان.<verse eid="LUK 2:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="LUK 2:32" />نتَّا ذ يجّن ن نُّوْر إِي ثسْمظْهَارذ إِ ڒݣْنُوْس،</para>
  <para style="q" vid="LUK 2:32">نتَّا ذ يجّن ن لْعَظَمَا ن شَّعْب نّش ن أَيْث-إِسْرَائِيل."<verse eid="LUK 2:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33" />بَابَاس ذ يمَّاس قِّيمن تْعجّْبن ذِي مِين خَاس يتْوَانَّان. <verse eid="LUK 2:33" /><verse number="34" style="v" sid="LUK 2:34" />ئِبَرك-يثن شِمْعُوْن ينَّا-يَاس إِ يمَّاس مَرْيَم:</para>
  <para style="q1" vid="LUK 2:34">"أَقَا وَانِيتَا يݣِّي-ث سِيذِي أَربِّـي</para>
  <para style="q2" vid="LUK 2:34">أَذ د يسهْوَا اَذ يسِيڒِي اَطَّاس ن يِوْذَان ذِي أَيْث-إِسْرَائِيل.</para>
  <para style="q1" vid="LUK 2:34">نتَّا ذ يجّن ن لْعَلَامَا اَتَاف وَار ت تْخِيسن شَا،<verse eid="LUK 2:34" /></para>
  <para style="q2">
    <verse number="35" style="v" sid="LUK 2:35" />أَذ نْفضْحن لْأَفْكَار ن وَاطَّاس ن وُوْڒَاون.</para>
  <para style="q1" vid="LUK 2:35">ذ يجّن ن لْحُزن اَم سِّيف يقضْعن اَذ يشُوْكّ ڒْعَمَر نّم."<verse eid="LUK 2:35" /></para>
  <para style="b" />
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36" />تُوْغَا ذِنِّي عَاوذ يجّن ن نَّبِيَا ذ ثَوسَّارْث قَّارن-اَس حَنَان نتَّاث ذ يدْجِيس ن فَنْوِيل زِي ثقْبِيڒْث ن عَشُوْر. ثْعِيش اَك ورْيَاز نّس سبْعَا يسݣّْوُسَا. <verse eid="LUK 2:36" /><verse number="37" style="v" sid="LUK 2:37" />ڒخْدّنِّي يمُّوْث نتَّا، ثقِّيم نتَّاث ذ ثَاجَّاڒْث حتَّا وَامِي ثمُّوْث خ اَرْبعَا أُو ثْمَانِين يسݣّْوُسَا. تْغِيمَا ڒبْدَا ذِي ثمْزِيذَا ثَمقّْرَانْت، ثْعبّذ أَربِّـي تْࢲُوْمَّا تْࢲَادْجَا دْجِيڒث ذ وَاسّ. <verse eid="LUK 2:37" /><verse number="38" style="v" sid="LUK 2:38" />ذِي ڒْوقْث نِّي ثُوْسَا-د ثْحمّذ أَربِّـي ثسِّيوڒ خ وحنْجِير نِّي اَك مَارَّا يِنِّي يتْرَاجَان نْهَار نِّي ذِي غَا يفكّ أَربِّـي لْقُدْس.<verse eid="LUK 2:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39" />وَامِي يُوْسف ذ مَرْيَم صَافِي كمّْڒن مَارَّا مِين زَّايْسن ثُوْمَر شَّرِيعَا ن سِيذ أَربِّـي، ذوْڒن غَار ثْمُوْرْث ن لْجَلِيل غَار وبِيلَاج نْسن ن نَاصِرَا. <verse eid="LUK 2:39" /><verse number="40" style="v" sid="LUK 2:40" />عِيْسَى يتمْغَار يتجْهِيذ يتْشَار س ڒفْهَامث، خَاس اَرْضَا ن أَربِّـي.<verse eid="LUK 2:40" /></para>
  <para style="s">ثِيمسْڒَايِين نِّي إِي يتݣّ سِيذِيثْنغ عِيْسَى وَامِي يدْجَا ذ اَحنْجِير</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41" />لْوَالِدِين نّس تْرَاحن مْكُڒ اَسݣّْوَاس غَار لْقُدْس ذِي ڒْعِيذ اَمقّْرَان ن أَيث-إِسْرَائِيل. <verse eid="LUK 2:41" /><verse number="42" style="v" sid="LUK 2:42" />عِيْسَى وَامِي يُوْوض ثنْعَاش ن يسݣّْوُسَا، ݣَعّْذن غَار لْقُدْس عْلَاحْسَاب تَقَلِيد ن ڒْعِيذ. <verse eid="LUK 2:42" /><verse number="43" style="v" sid="LUK 2:43" />وَامِي كمّْڒن وُوْسَّان ن ڒْعِيذ روّْحن نتَّا يقِّيم ذِي لْقُدْس، وَلَكِن نِثْنِي وَار سِّينن شَا بلِّي نتَّا عَاذ يقِّيم ذِنِّي. <verse eid="LUK 2:43" /><verse number="44" style="v" sid="LUK 2:44" />تْغِير-اَسن اَقَاث اَكِذْسن اَك لْمجْمَع نْسن. ؤُيُوْرن نْهَار يكْمَاڒ، بْذَان رزُّوْن خَاس جَار فَامِلْيَا ذ يمدُّوْكَاڒ. <verse eid="LUK 2:44" /><verse number="45" style="v" sid="LUK 2:45" />وَامِي وَار ث ؤُفِين شَا، ذوْڒن غَار ثنْدِينْت رزُّوْن خَاس. <verse eid="LUK 2:45" /><verse number="46" style="v" sid="LUK 2:46" />كِّين ثڒْتِيَّام أُوْشَا ؤُفِين-ث يقِّيم ذِي ثمْزِيذَا ثَمقّْرَانْت جَار يِنِّي يسڒْمَاذن، ئِتْسْڒَا-يَاسن يتْسقْسَا-ثن. <verse eid="LUK 2:46" /><verse number="47" style="v" sid="LUK 2:47" />مَارَّا يِنِّي ذَاس يتْسْڒَان تْعجّْبن ذَايس س ڒَعْقڒ نّس ذ لْجَاوَبَاث نّس.<verse eid="LUK 2:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 2:48" />وَامِي ث ࢲْرِين لْوَلِدِين نّس تْعجّْبن ذَايس، ثنَّا-ٱس يمَّاس: "مَايْمِي ذَانغ ثݣِّيذ اَمُّو؟ أَقَا نش ذ بَابَاش نْرزُّو خَاك، ثجِّيذ-اَنغ ذِي ڒَعْذَاب."<verse eid="LUK 2:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49" />ينَّا-ٱسن عِيْسَى: "مَايْمِي خَافِي ثْرزُّوْم؟ مَا وَار ثسِّينم شَا بلِّي نش يتْخصَّا-ٱيِي اَذ يڒِيغ ذِي ثدَّارْث ن بَابَا؟"<verse eid="LUK 2:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 2:50" />وَار ذَاس فْهِيمن شَا إِ وَاوَاڒ نِّي إِي ذَاسن ينَّا. <verse eid="LUK 2:50" /><verse number="51" style="v" sid="LUK 2:51" />ئِذْوڒ-د اَكِذْسن غَار نَاصِرَا يتݣّ-اَسن اَرَّاي. يمَّاس تْخمَّام ذِي مَارَّا مَانَايَا ذݣ وُوْڒ نّس. <verse eid="LUK 2:51" /><verse number="52" style="v" sid="LUK 2:52" />عِيْسَى يَرنِّي ذِي ڒفْهَامث ذ طُّوْل، ئِتمْغَار ذِي اَرْضَا غَار أَربِّـي ذ ڒْعَبْذ.<verse eid="LUK 2:52" /></para>
  <chapter eid="LUK 2" />
  <chapter number="3" style="c" sid="LUK 3" />
  <para style="s">سِيذْنَا يَحْيَى يسوْجَاذ اَبْرِيذ إِ لْمَسِيح</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1" />أَزدْجِيذ قَيْصَر تِيبَارْيُوْس يُوْوض خمسّْطَاشَر سّْنَا زݣ وَامِي يتحْكَام، لْعَام نِّي عَاوذ بِيلَاطُوس لْبَنْطِي نتَّا ذ لْحَاكم خ يَهُوْذِيَا، هِيرُوْدُس نتَّا ذ لْوَالِي خ لْجَلِيل، ؤُمَاس فِيلِيپَّـاس نتَّا ذ لْوَالِي خ إِيْطُوْرْيَا ذ جْوَايه ن تَرْخَانِيتِيس، لَصَان نتَّا ذ لْوَالِي خ أَبِيلِينَا، <verse eid="LUK 3:1" /><verse number="2" style="v" sid="LUK 3:2" />حَنِين ذ قِيَافَا نِثْنِي ذ اَرُّوْيَاس ن ڒْفُقَهَا. ذِي ڒْوقْث نِّي يُوْسَا-د وَاوَاڒ ن أَربِّـي إِ يَحْيَى مِّيس ن زَكَرِيَا ذِي ڒخْڒَا. <verse eid="LUK 3:2" /><verse number="3" style="v" sid="LUK 3:3" />ئِكَّر نتَّا يكَّا خ مَارَّا يمُوْشَان طَّارْف ن يغْزَار ن لْأُرْدُن يبْذَا يتْبشَّر يوْذَان حمَا اَذ تُّوْبن اَذ تْوَاطهَّارن س وَامَان حمَا اَذ تْوَاغْفَرنْت ڒْمُعْصِيَاث نْسن. <verse eid="LUK 3:3" /><verse number="4" style="v" sid="LUK 3:4" />مَانَايَا عْلَاحْسَاب مِين يُوْرَا ذِي لْكِتَاب ن وَاوَاڒ ن نَّبِي إِشَعْيَا:</para>
  <para style="q1" vid="LUK 3:4">&lt;ثْمِيجَّا تْڒَاغَا ذِي ڒخْڒَا ثقَّار:</para>
  <para style="q2" vid="LUK 3:4">سْوجْذث اَبْرِيذ إِ سِيذِي أَربِّـي،</para>
  <para style="q2" vid="LUK 3:4">ݣّم يبْرِيذن نّس نِيشَان.<verse eid="LUK 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5" />أَذ يتْوَانْطُو كُڒ يغْزَار،</para>
  <para style="q2" vid="LUK 3:5">أَذ يوَاطَا كُڒ اَذْرَار ذ ثَعْرُوْرْث.</para>
  <para style="q1" vid="LUK 3:5">مِين وَار يشْنِين اَذ يشْنَا،</para>
  <para style="q2" vid="LUK 3:5">أَذ تْوَاعذْڒن يبْرِيذن يتْوَاحْفَرن.<verse eid="LUK 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6" />مَارَّا يوْذَان اَذ ࢲْرن اَسنْجم ن أَربِّـي.&gt;<verse eid="LUK 3:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7" />يَحْيَى يقَّار-اَسن إِ ڒْغَاشِي يِنِّي يفّْغن بَاش اَذ تْوَاطهَّارن س وَامَان: "يَا ثَارْوَا ن يفِيغرَان، وِي ذَاوم يعڒْمن اَذ تَروْڒم زِي لْغَضَب <char style="it">ن سِيذِي أَربِّـي</char> إِي د غَا يَاسن؟ <verse eid="LUK 3:7" /><verse number="8" style="v" sid="LUK 3:8" />مڒَا ثْتُوبم ذ صَّح، ݣّث ڒخْذَايم ذ ثِصبْحَانِين. مَاشَي اَذ تِينِيم ذِي نّفْس نْوم اَقَا نشِّين ذ ثَارْوَا ن بْرَاهِيم أُو صَافِي. مڒَا يخس أَربِّـي ثَارْوَا ن بْرَاهِين، أَتَاف اَذ ييْسِي يِزْرَا-يَا اَثن يَارّ ذ ثَارْوَا ن بْرَاهِيم! <verse eid="LUK 3:8" /><verse number="9" style="v" sid="LUK 3:9" />أَقَا شَاقُوْر يوْجذ حمَا اَذ يقسّ يࢲوْرَان ن ڒْشجُّوْر. مْكُڒ ثَشجَّارْث إِي وَار يتِيرْون شَا مِين يدْجَان ذ اَصبْحَان اَتَاف اَذ تْوَاقسّ اَذ تْمنْضَار ذِي ثْمسِّي."<verse eid="LUK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10" />نَّان-اَس ڒْغَاشِي: "ئِي نشِّين مِين غَا نݣّ؟"<verse eid="LUK 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11" />يَارَّا خَاسن يَحْيَى ينَّا-ٱسن: "ونِّي غَار دْجَانْت ثْنَاين ن ثقْمِيجَاثِين يتْخصَّا اَذ يُوْش يشْتن إِ ونِّي وَار غَار يدْجِي شَا. عَاوذ ونِّي غَار يدْجَا مِين غَا يشّ يتْخصَّا اَذ يُوْش إِ ونِّي وَار غَار يدْجِي شَا."<verse eid="LUK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12" />ؤُسِين-د غَارس ڒبْعَاض زݣ يِنِّي يجمّْعن ضَّرِيبَا بَاش اَذ تْوَاطهَّارن س وَامَان نَّان-اَس: "آ لْمُعَلِّم، مِين غَا نݣّ نشِّين؟"<verse eid="LUK 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13" />يَارَّا خَاسن ينَّا-ٱسن: "وَار جمّْعث بُو كْتَار زِي لْقَانُوْن."<verse eid="LUK 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14" />عَاوذ سّقْسَان-ث ڒْعَسْكَار نَّان-اَس: "ئِي نشِّين مِين غَا نݣّ؟"</para>
  <para style="p" vid="LUK 3:14">ينَّا-ٱسن يَحْيَى: "وَار تْكسِّيم بُو تْمنْيَاث س بسِّيف. وَار زْنُوْزَام حَدّ خ ڒْبَاطڒ. قنْعم س مِين ثْربْحم."<verse eid="LUK 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15" />قَاع يوْذَان نِّي تْرَاجَان <char style="it">لْمَسِيح</char> تْفكَّرن ذݣ وُوْڒ نْسن يَحْيَى مَا نتَّا ذ لْمَسِيح مَا لَّا.<verse eid="LUK 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 3:16" />ئِجَاوب-يثن يَحْيَى مَارَّا ينَّا-ٱسن: "قَا نش طهَّارغ-كنِّيو س وَامَان، وَلَكِن اَذ د يَاس يجّن يجْهذ خَافِي، وَار سْذِيهِيدْجغ شَا اَذَاس فسْيغ ؤُڒَا ذ يفِيڒَان ن ثْسِيڒَا نّس. نتَّا اَكنِّيو يطهَّار س أَرُّوْح يقدّْسن ذ <char style="it">يِيڒسَاون ن</char> ثْمسِّي.<note caller="+" style="f"><char style="fr" closed="false">3‏.16 </char><char style="ft" closed="false">س ثْيُوْنَانِيث ن لْأَصل يقَّار: "س أَرُّوْح يقدّْسن ذ ثْمسِّي." يمْكن يسَّاوَاڒ ذَانِيتَا خ مِين غَا يوقْعن ذِي ڒخْذَايم ن أَرُّسُل 2‏:3.</char></note> <verse eid="LUK 3:16" /><verse number="17" style="v" sid="LUK 3:17" />غَارس ثَازَّارْث ذݣ وفُوْس حمَا اَذ يزُوْزَّار ثَافَّا نّس قَاع، أَذ يسْمُوْن ثِحبَّا ن يِرْذَان اَثنْت يݣّ ذِي ثسْرَافْث. مِين وَار ينفّْعن شَا اَث يسّشْمض ذِي ثْمسِّي إِي وَار يخسِّين عمَّارْص." <verse eid="LUK 3:17" /><verse number="18" style="v" sid="LUK 3:18" />أَمنِّي يَحْيَى يسڒْمَاذ يوْذَان يتْبشَّار-يثن س وَاطَّاس ن ثْمسْڒَايِين نّغْنِي.<verse eid="LUK 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 3:19" />منْبَعْد لْوَالِي هِيرُوْدُس يُوْوِي يشْتن قَّارن-اَس هِيرُوْدْيَا أُو نتَّاث ذ ثَمْغَارْث ن وُوْمَاس. يَحْيَى ينْهَا هِيرُوْدُس خ مَانَايَا. عَاوذ ينْهَا-ث خ مَارَّا لْأَغْلَاط نّغْنِي إِي يتݣّ. <verse eid="LUK 3:19" /><verse number="20" style="v" sid="LUK 3:20" />هِيرُوْدُس نتَّا مِين يݣَّا؟ يَرْنِي ذِي شَّرّْ نّس يݣَّا يَحْيَى ذِي ڒحْبس.<verse eid="LUK 3:20" /></para>
  <para style="s">سِيذْنَا يَحْيَى يتْطهَّار إِ سِيذِيثْنغ عِيْسَى س وَامَان</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21" />وَامِي مَارَّا شَّعْب يتْتْوَاطهَّار س وَامَان، يُوْسَا-د ؤُڒَا ذ عِيْسَى يتْوَاطهَّار س وَامَان. نتَّا وَامِي يتْࢲَادْجَا، ثْنُوْرْزم ثوَّارْث ذݣ وجنَّا <verse eid="LUK 3:21" /><verse number="22" style="v" sid="LUK 3:22" />يهْوَا-د أَرُّوْح يقدّْسن ذِي صِّفث ن ثذْبِيرْث يَرْسَا-د خ عِيْسَى. ذ يجّن ن ثْمِيجَّا زݣ وجنَّا ثقَّار-اَس قَا شك ذ ممِّي يعِيزّن، نش فَرّْحغ زَّايك.<verse eid="LUK 3:22" /></para>
  <para style="s">ڒجْذُوْذ ن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23" />وَامِي يبْذَا عِيْسَى ذِي ڒْخذْمث نّس تُوْغَا غَارس شَا ن تْڒَاثِين يسݣّْوُسَا. تْغِيڒ-اَسن ذ مِّيس ن يُوْسف، ن عَلي، <verse eid="LUK 3:23" /><verse number="24" style="v" sid="LUK 3:24" />ن مَطْيُو، ن لَاوِي، ن مْلُوْكِي، ن يَانِي، ن يُوْسف، <verse eid="LUK 3:24" /><verse number="25" style="v" sid="LUK 3:25" />ن مَطْيُوْسُس، ن أَمُوْن، ن نَاحُوْم، ن حُصْنِي، ن نَاجِي، <verse eid="LUK 3:25" /><verse number="26" style="v" sid="LUK 3:26" />ن مُحِيت، ن مَطْيُوْسُس، ن شَمْعِي، ن يُوْسْكِي، ن يُوْضَا، <verse eid="LUK 3:26" /><verse number="27" style="v" sid="LUK 3:27" />ن يُوْهَان، ن رِيس، ن زَرُبَّابِل، ن شْعَالْتِيهِيل، ن نِير، <verse eid="LUK 3:27" /><verse number="28" style="v" sid="LUK 3:28" />ن مْلُوْكِي، ن أَدِي، ن قَاسم، ن لْمُوْدَام، ن عِير، <verse eid="LUK 3:28" /><verse number="29" style="v" sid="LUK 3:29" />ن يَاسُو، ن لِعَازَر، ن يُوْرِيم، ن مَطْيُو، ن لَاوِي، <verse eid="LUK 3:29" /><verse number="30" style="v" sid="LUK 3:30" />ن شِمْعُوْن، ن يَهُوْذَا، ن يُوْسف، ن يُوْنَام، ن لْيَاقِيم، <verse eid="LUK 3:30" /><verse number="31" style="v" sid="LUK 3:31" />ن مَلْيُو، ن منَّان، ن مَطْيُوْس، ن نَاثَان، ن دَاود، <verse eid="LUK 3:31" /><verse number="32" style="v" sid="LUK 3:32" />ن يَسَّى، ن عُوْبِد، ن بُوْعَزَّا، ن سَلْمُوْن، ن نَاسُّوْن، <verse eid="LUK 3:32" /><verse number="33" style="v" sid="LUK 3:33" />ن عَمِينَادَاب، ن أَدْمِي، ن عَرْنِي، ن حَصْرُوْن، ن فَارِس، ن يَهُوْذَا، <verse eid="LUK 3:33" /><verse number="34" style="v" sid="LUK 3:34" />ن يَعْقُوْب، ن إِسْحَاق، ن بْرَاهِيم، ن تَارَح، ن نَاحُوْر، <verse eid="LUK 3:34" /><verse number="35" style="v" sid="LUK 3:35" />ن سَرُوْݣ، ن رَعُو، ن فَالَج، ن عَابِر، ن صَالَح، <verse eid="LUK 3:35" /><verse number="36" style="v" sid="LUK 3:36" />ن قِينَان، ن أَرْفَكْشذ، ن سَام، ن نُوح، ن لَامَك، <verse eid="LUK 3:36" /><verse number="37" style="v" sid="LUK 3:37" />ن متُوشَالِح، ن أَخْنُوْخ، ن يَارِد، ن مُهَلِّيل، ن قِينَان، <verse eid="LUK 3:37" /><verse number="38" style="v" sid="LUK 3:38" />ن أَنُوْش، ن شُوْث، ن آدَم مِّيس ن أَربِّـي.<verse eid="LUK 3:38" /></para>
  <chapter eid="LUK 3" />
  <chapter number="4" style="c" sid="LUK 4" />
  <para style="s">إِبْڒِيس يتْجرَّاب سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1" />ئِذْوڒ-د عِيْسَى زݣ يِغْزَار ن لْأُرْدُن يشُّوْر س أَرُّوْح يقدّْسن، ڒخْدّنِّي يُوْوِي-ث أَرُّوْح نِّي غَار ڒخْڒَا. <verse eid="LUK 4:1" /><verse number="2" style="v" sid="LUK 4:2" />ئِكَّا ذِنِّي اَرْبعِين يُوْم يتْجرَّاب-يث إِبْڒِيس. ذݣ وُوْسَّان نِّي وَار يشِّي وَالُو. وَامِي كمّْڒن وُوْسَّان نِّي يدْجُوْز.<verse eid="LUK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3" />ئِكَّر إِبْڒِيس ينَّا-ٱس إِ عِيْسَى: "شك مڒَا ذ مِّيس ن أَربِّـي، إِنِي-يَاسن إِ يِزْرَا-يَا اَذ ذوْڒن ذ اَغْرُوْم."<verse eid="LUK 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4" />يَارَّا خَاس عِيْسَى ينَّا-ٱس: "لَّا، لْكِتَاب يقَّار: &lt;بْنَاذم وَار يتْعِيش شَا س وغْرُوْم وَاهَا.&gt;"<verse eid="LUK 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5" />ئِكَّر إِبْڒِيس يُوْوِي عِيْسَى غَار يِجّن ن ومْشَان يُوْعْڒَا، ئِسْمظْهَار-اَس-د مَارَّا لْممْلَاكَاث ن دُّنشْت-أَ ذݣ يِجّن ن دْقِيقث. <verse eid="LUK 4:5" /><verse number="6" style="v" sid="LUK 4:6" />ينَّا-ٱس إِبْڒِيس: "أَذَاش ؤُشغ مَارَّا جّْهذ-أَ ذ لْعَظَمَا-يَا نْسنْت ڒَاحقَّاش نش ثمُّوْش-اَيِي، أَت ؤُشغ إِ وُوْمِي مَا خْسغ. <verse eid="LUK 4:6" /><verse number="7" style="v" sid="LUK 4:7" />مڒَا ثْسجّْذذ-اَيِي، أَذ يِيڒِي قَاع مَانَايَا إِ شك."<verse eid="LUK 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8" />ينَّا-ٱس عِيْسَى: "لَّا، لْكِتَاب يقَّار: &lt;سجّذ إِ سِيذِي أَربِّـي نّش، عْبذ-يث نتَّا وَاحْذس.&gt;"<verse eid="LUK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9" />ئِكَّر إِبْڒِيس يُوْوِي عِيْسَى غَار ثنْدِينْت ن لْقُدْس، ئِسِيڒِي-ث خ ثْقِيشَّات ن ثمْزِيذَا ثَمقّْرَانْت ينَّا-ٱس: "شك مڒَا ذ مِّيس ن أَربِّـي، نْݣز سَّانِيتَا غَار ثْمُوْرْث <verse eid="LUK 4:9" /><verse number="10" style="v" sid="LUK 4:10" />أَقَا لْكِتَاب يقَّار: &lt;قَا أَربِّـي اَذ يوصَّا بَاش اَش حْضَانْت لْمَلَائِكَاث نّس.&gt; <verse eid="LUK 4:10" /><verse number="11" style="v" sid="LUK 4:11" />عَاوذ يقَّار: &lt;أَش يْسِينْت خ يفَاسّن نْسنْت بَاش وَار ثرْقِيفذ ؤُڒَا ذ يج وزْرُو س وضَار نّش.&gt;"<verse eid="LUK 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12" />ئِنْدق-د عِيْسَى ينَّا-ٱس: "لَّا، لْكِتَاب يقَّار: &lt;وَار تْجَرَّاب شَا سِيذِي أَربِّـي نّش.&gt;" <verse eid="LUK 4:12" /><verse number="13" style="v" sid="LUK 4:13" />إِبْڒِيس وَامِي يكمّڒ اَكِذس مَارَّا اَجرَّاب نِّي، ئِكَّر يبعّذ خَاس اَڒ يِجّن ن ثْوَاڒَا نّغْنِي.<verse eid="LUK 4:13" /></para>
  <para style="s">تَازّْڒن خ سِيذِيثْنغ عِيْسَى زِي ثنْدِينْت نّس</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14" />ئِذْوڒ عِيْسَى غَار ثْمُوْرْث ن لْجَلِيل س جّْهذ ن أَرُّوْح يقدّْسن، ئِتنْتَاشَر ڒخْبَار نّس مَارَّا ذِي جْوَايه نِّي. <verse eid="LUK 4:14" /><verse number="15" style="v" sid="LUK 4:15" />ئِسڒْمَاذ ذِي ثمْزِيذَاوِين نْسن سمْغَارن-ث مَارَّا يوْذَان.<verse eid="LUK 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16" />يُوْسَا-د غَار وبِيلَاج ن نَاصِرَا مَانِي يربَّا. نْهَار ن سّبْث ن لْعِبَادَا يرُوْح غَار ثمْزِيذَا اَم ڒبْدَا، ئِكَّر حمَا اَذ يغَر. <verse eid="LUK 4:16" /><verse number="17" style="v" sid="LUK 4:17" />ؤُشِين-اَس لْكِتَاب نِّي ن نَّبِي إِشَعْيَا، يرْزم-يث يُوْفَا اَمْشَان إِي ذِي يُوْرَا وَاوَڒ-أَ:<verse eid="LUK 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18" />&lt;أَقَا أَرُّوْح ن سِيذِي أَربِّـي اَقَاث خَافِي،</para>
  <para style="q2" vid="LUK 4:18">ئِخْضَر-اَيِي حمَا اَذ بشَّرغ ڒْمُسَاكِين.</para>
  <para style="q1" vid="LUK 4:18">ئِسّكّ-اَيِي-د اَذ خْبَرغ لْحُرِّيَا إِ يمحْبَاس،</para>
  <para style="q2" vid="LUK 4:18">يِنِّي يتْوَاضَرْغْڒن اَثن اَرّغ تْوَاڒَان،</para>
  <para style="q1" vid="LUK 4:18">يِنِّي يتْوَاضڒْمن اَذَاسن د رْخُوْغ.<verse eid="LUK 4:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="LUK 4:19" />أَذ خْبَرغ خ وسݣّْوَاس ن اَرْضَا ن سِيذِي أَربِّـي.&gt;<verse eid="LUK 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20" />ئِبلّع لْكِتَاب نِّي، يَارَّا-ٱس-ث إِ وخدَّام يقِّيم. مَارَّا يِنِّي يدْجَان ذِي ثمْزِيذَا قِّيمن تخزَّارن ذَايس. <verse eid="LUK 4:20" /><verse number="21" style="v" sid="LUK 4:21" />ئِبْذَا يقَّار-اَسن: "نْهَارَا قَا يفّغ-د وَاوَاڒ ن لْكِتَاب-أَ إِي ؤُمِي ثسْڒِيم."<verse eid="LUK 4:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22" />مَارَّا سَّاوَاڒن خَاس مْلِيح، تْعجّْبن ذݣ وَاوَاڒن يصبْحَانن إِي د يفّْغن زݣ وقمُّوْم نّس. نَّان خَاس: مَا وَار يدْجِي شَا وَانِيتَا ذ مِّيس ن يُوْسف؟<verse eid="LUK 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23" />ينَّا-ٱسن عِيْسَى: "بْڒَا شّكّ اَذَايِي ثِينِيم ڒْمَعْنَا-يَا: شك آي اَضْبِيب مْڒِي ثدَّاوِيذ، إِڒِي ثدَّاوِيذ يخف نّش. أَذَايِي ثِينِيم عَاوذ قَا مِين نسْڒَا يوقْعن ذݣ وبِيلَاج ن كَفرْنَاحُوْم، ڒخُّو مَانَاينِّي اݣّ-يث ؤُڒَا ذَانِيتَا ذِي ثْمُوْرْث نّش." <verse eid="LUK 4:23" /><verse number="24" style="v" sid="LUK 4:24" />ينَّا-ٱسن: "أَقَا تسْڒَام ڒْحَقّ: وَار يدْجِي شَا شَان نَّبِي قبْڒن-ث ذِي ثْمُوْرْث نّس. <verse eid="LUK 4:24" /><verse number="25" style="v" sid="LUK 4:25" />أَقَا تسْڒَام ڒْحَقّ: تُوْغَا ذِنِّي اَطَّاس ن ثَاجَّاڒِين ذِي ثْمُوْرْث ن أَيث-إِسْرَائِيل ذِي زْمَان ن نَّبِي إِلْيَاس وَامِي وَار يُوْوْثِي بُو ونْࢲَار ثڒْت سْنِين أُو ستّ شْهُوْر وَامِي يوْقع يجّن ن بُوْهيُّوْف ذِي ثْمُوْرْث ثكْمَاڒ. <verse eid="LUK 4:25" /><verse number="26" style="v" sid="LUK 4:26" />وَلَكِن ثَاجَّاڒِين نِّي وَار غَارْسنْت د يتْوَاسّكّ شَا نَّبِي إِلْيَاس، ئِتوَاسّكّ-د غِير غَار يِشْتن ن ثَاجَّاڒْث وَاهَا ذِي دْشَار ن صَرپْـتَا ذِي ثْمُوْرْث ن صَيْدَا. <verse eid="LUK 4:26" /><verse number="27" style="v" sid="LUK 4:27" />عَاوذ تُوْغَا اَطَّاس ن يِوْذَان هڒْشن ذَايْسن جْذَام ذِي ثْمُوْرْث ن أَيث-إِسْرَائِيل ذِي زْمَان نِّي ن نَّبِي أَلِيشَع. أَربِّـي وَار زَّايْسن يسْݣنْفِي ؤُڒَا ذ يجّن، ئِسْݣنْفَا إِلَّا نُعْمَان زِي سُوْرْيَا."<verse eid="LUK 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28" />يِنِّي يمُوْنن ذِي ثمْزِيذَا وَامِي سْڒِين إِ وَاوَاڒ-أَ غضْبن اَطَّاس. <verse eid="LUK 4:28" /><verse number="29" style="v" sid="LUK 4:29" />كَّرن سُوْفْغن-ث غَار بَارَّا ن ثنْدِينْت. ؤُوِين-ث غَار جَّرْف ن وذْرَار مَانِي ثبْنَا ثنْدِينْت نْسن بَاش اَث سيّْبن خ جَّرْف نِّي. <verse eid="LUK 4:29" /><verse number="30" style="v" sid="LUK 4:30" />وَلَكِن نتَّا يفْڒث-اَسن يُوْيُور.<verse eid="LUK 4:30" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسُوْفُوْغ يجّن ن جّنّ ذ اَعفَّان</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31" />ئِرُوْح عِيْسَى غَار وبِيلَاج ن كَفرْنَاحُوم إِݣ يدْجَان ذِي ثْمُوْرْث ن لْجَلِيل، ئِبْذَا يسڒْمَاذ يوْذَان ذِنِّي ذِي نْهَار ن لْعِبَادَا نْسن كُڒ سّبْث. <verse eid="LUK 4:31" /><verse number="32" style="v" sid="LUK 4:32" />قِّيمن يِوْذَان نِّي تْعجّْبن ذݣ وسڒْمذ نّس مِينْزِي غَارس سُّلْطَا إِي زِي يسڒْمَاذ.<verse eid="LUK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 4:33" />ؤُفِين ذِي ثمْزِيذَا نِّي يجّن ن ورْيَاز ذَايس يجّن ن جّنّ ذ اَعفَّان. ئِبْذَا يسْنكَّر ثْغُوْيّث س جّْهذ <verse eid="LUK 4:33" /><verse number="34" style="v" sid="LUK 4:34" />ينَّا-ٱس إِ عِيْسَى: "مِين ذَايْنغ ثْرزُّوْذ آ عِيْسَى نَاصِرِي؟ مَا ثُوْسِيذ-د اَخَانغ ثقْضِيذ؟ نش قَا سّْنغ مِين ثعْنِيذ؛ شك ذ لْعَظِيم ن أَربِّـي!" <verse eid="LUK 4:34" /><verse number="35" style="v" sid="LUK 4:35" />ئِزيَّار-يث عِيْسَى ينَّا-ٱس: "سْتُوْك شك، فّغ زَّايس!" ئِسغْضڒ جَّن اَرْيَاز نِّي غَار ثْمُوْرْث ذِي ڒْوسْط نْسن ڒخْدّنِّي يفّغ زَّايس وَار ذَاس يݣِّي وَالُو. <verse eid="LUK 4:35" /><verse number="36" style="v" sid="LUK 4:36" />قِّيمن مَارَّا يوْذَان نِّي ذهّْشن نَّان إِ وَايَاوْيَا: "مِين يعْنَا مَانَايَا؟ ئِتْأَمَر ؤُڒَا ذ جْنُوْن يعفَّانن س يِجّن ن سُّلْطَا ذ ثْزمَّار نِثْنِي تفّْغن." <verse eid="LUK 4:36" /><verse number="37" style="v" sid="LUK 4:37" />ئِتنْتَاشَر ڒخْبَار نّس ذِي مْكُڒ اَمْشَان ذِي جْوَايه نِّي.<verse eid="LUK 4:37" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا ثَذْݣّوَاڒْث ن سِمْعَان</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38" />سّنِّي عِيْسَى يفّغ-د زِي ثمْزِيذَا نِّي يُوْذف غَار ثدَّارْث ن سِمْعَان. يُوْفَا ذِنِّي ثَذْݣّوَاڒْث ن سِمْعَان قَا ثهْڒش ذَايس ثِمسِّي اَطَّاس، تَّارن زَّايس حمَا اَت يسْݣنْفَا. <verse eid="LUK 4:38" /><verse number="39" style="v" sid="LUK 4:39" />يُوْذَار اَغَارس يسْبدّ ثِمسِّي ثفّغ-يت. ذݣ ومْشَان ثكَّر ثبْذَا تْسخَّار خَاسن.<verse eid="LUK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40" />وَامِي ثغْڒِي ثْفُوْشْت غَار ثْمدِّيث، ئِوْذَان ؤُوِين غَار عِيْسَى يمهْڒَاش نْسن كُڒ يجّن مَامش يݣَّا ڒهْڒَاش نّس. مْكُڒ يجّن زَّايْسن يسْرُوْسَا خَاس فُوْس نّس يسْݣنْفَا-ث. <verse eid="LUK 4:40" /><verse number="41" style="v" sid="LUK 4:41" />زݣ وَاطَّاس ن يِوْذَان عَاوذ تفّْغن جْنُوْن سْنكَّرن ثْغُوْيّث قَّارن-اَس قَا شك ذ مِّيس ن أَربِّـي." وَلَكِن نتَّا يتْزيَّار-يثن، وَار ثن يتجِّي شَا اَذ سِّيوْڒن مِينْزِي سّْنن نتَّا ذ لْمَسِيح.<verse eid="LUK 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42" />وَامِي يصْبَح ڒْحَاڒ يفّغ عِيْسَى يرُوْح غَار يِجّن ن ومْشَان ن ڒخْڒَا. ئِوْذَان نِّي بْذَان رزُّوْن خَاس، ؤُسِين-د غَارس طّْفن-ث حمَا وَار خَاسن يݣُّوْر شَا. <verse eid="LUK 4:42" /><verse number="43" style="v" sid="LUK 4:43" />ينَّا-ٱسن: "لَّا، نش يتْخصَّا-ٱيِي اَذ بشَّرغ س ڒْمُلْك ن أَربِّـي ذِي ثْندَّام نّغْنِي مِينْزِي تْوَاسّكّغ-د إِ مَانَايَا." <verse eid="LUK 4:43" /><verse number="44" style="v" sid="LUK 4:44" />ئِرُوْح يتْحدَّاث ذِي ثمْزِيذَاوِين نْسن ن يَهُوْذِيَا.<verse eid="LUK 4:44" /></para>
  <chapter eid="LUK 4" />
  <chapter number="5" style="c" sid="LUK 5" />
  <para style="s">سِيذِيثْنغ عِيْسَى ئِتْڒَاغَا-د إِ يمحْضَارن نّس يمزْوُوْرَا</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1" />ئِجّن ن نْهَار يبدّ عِيْسَى غَار ڒبْحَر ن ݣَنِيسَارَت، مْزَاحَامن خَاس ڒْغَاشِي بَاش اَذ سْڒن إِ وَاوَاڒ ن أَربِّـي. <verse eid="LUK 5:1" /><verse number="2" style="v" sid="LUK 5:2" />يُوْفَا ثْنَاين ن ثْغَرُّوْبَا بدّنْت خ طَّارْف ن ڒبْحَر. تُوْغَا هْوَان-د زَّايْسنْت يحدْجَاقن ن يسڒْمَان بَاش اَذ عذْڒن ثِرَاشِّيوِين نْسن. <verse eid="LUK 5:2" /><verse number="3" style="v" sid="LUK 5:3" />ئِنْيَا عِيْسَى ذݣ يِشْتن زِي ثْغَرُّوْبَا نِّي ثنِّي إِي يدْجَان ن سِمْعَان، ئِطَالب زَّايس اَذ يُوْيُوْر شْوَايْت خ ڒْبَرّ أُو نتَّا يقِّيم ذَايس يبْذَا يسڒْمَاذ ڒْغَاشِي زِي ثْغَرَّابُوْت نِّي.<verse eid="LUK 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4" />وَامِي يكمّڒ اَوَاڒ نِّي ينَّا-ٱس إِ سِمْعَان: "نْده ثَغَرَّابُوْت نّش غَار مَانِي ؤُدْجْغن وَامَان ضْڒق ثِرَاشِّيوِين حمَا اَذ تْحدْجْقذ يسڒْمَان."<verse eid="LUK 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5" />ينَّا-ٱس سِمْعَان: "آ لْمُعَلِّيم، نشِّين دْجِيڒث ثكْمَاڒ نْخدّم وَار د نْسِيڒِي ؤُڒَا ذ يجّن ن وسْڒم، وَلَكِن وَامِي ت ثنِّيذ شك اَذ ضڒْقغ ثِيرَاشِّيوِين." <verse eid="LUK 5:5" /><verse number="6" style="v" sid="LUK 5:6" />وَامِي ݣِّين اَمُّو سِيڒِين-د اَطَّاس ن يسڒْمَان، ثِرَاشِّيوِين نْسن عْڒَاين اَذ قَّرْصنْت. <verse eid="LUK 5:6" /><verse number="7" style="v" sid="LUK 5:7" />شيَّارن يمدُّوْكَاڒ نْسن ذِي ثْغَرَّابُوْت نِّي نّغْنِي حمَا اَذ د اَسن اَثن عَاوْنن. ؤُسِين-د عمَّرن ثْنَاين ن ثْغَرُّوْبَا نْسن اَڒ وَامِي عْڒَاين اَذ غرْقنْت.<verse eid="LUK 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 5:8" />سِمْعَان بُطْرُس وَامِي يࢲْرا مَانَايَا يُوْسَا-د يوْضَا غَار يضَارن ن عِيْسَى ينَّا-ٱس: "آ سِيذِي، بعّذ خَافِي نش ذ لْعَاصِي." <verse eid="LUK 5:8" /><verse number="9" style="v" sid="LUK 5:9" />ئِذْهش نتَّا ذ يِنِّي اَكِذس مَارَّا ڒَاحقَّاش حدْجْقن-د اَطَّاس ن يسڒْمَان. <verse eid="LUK 5:9" /><verse number="10" style="v" sid="LUK 5:10" />عَاوذ يذْهش ؤُڒَا ذ يَعْقُوْب ذ يُوْحَنَّا ثَارْوَا ن زَبَادِي نِثْنِي ذ يمدُّوْكَاڒ ن سِمْعَان.</para>
  <para style="p" vid="LUK 5:10">ينَّا-ٱس عِيْسَى إِ سِمْعَان: "وَار تݣّْوذ شَا، شك سَّا اَڒ ثْسَاونْت اَتَاف اَذ تْحدْجْقذ يوْذَان." <verse eid="LUK 5:10" /><verse number="11" style="v" sid="LUK 5:11" />وَامِي د ذوْڒن س ثْغَرُّوْبَا غَار ڒْبَرّ سمْحن ذِي مَارَّا مِين غَارْسن ذْفَارن عِيْسَى.<verse eid="LUK 5:11" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا يجّن ذَايس جْذَام</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12" />وَامِي عِيْسَى اَقَاث ذݣ يِجّن ن ثنْدِينْت، يُوْسَا-د يجّن ن ورْيَاز ذَايس جْذَام اَطَّاس. ئِࢲْرَا عِيْسَى يوْضَا-يَاس غَار يضَارن يتَّار-اَس ينَّا-ٱس: "آ سِيذِي، شك مڒَا ثخْسذ ثزمَّرذ اَذَايِي ثسِّيصْفِيذ."<verse eid="LUK 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13" />ئِقَارّب غَارس عِيْسَى يحَاذَا-ث س وفُوْس نّس ينَّا-ٱس: "وَاه نش خْسغ، شك قَا ثݣنْفِيذ!" صَافِي ذݣ ومْشَان يرُوْح-اَس جْذَام نِّي.<verse eid="LUK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 5:14" />ئِوصَّا-ث ينَّا-ٱس: "وَار تْخبَّر حَدّ." ينَّا-ٱس: "رُوْح غَار ڒفْقِي سظْهَار-اَس يخف نّش. اݣّ صّذْقث نِّي إِي زِي يوصَّا مُوْسَى حمَا اَغَارْسن ثِيڒِي شْهَاذث خ مين يوقْعن."<verse eid="LUK 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15" />وَلَكِن سّنِّي يبْذَا يتنْتَاشَر خَاس ڒخْبَار كْتَار عَاذ. ؤُسِين-د غَارس اَطَّاس ن ڒْغَاشِي حمَا اَذَاس سْڒن حمَا اَذ ݣنْفَان زِي ڒهْڒَاشَاث نْسن. <verse eid="LUK 5:15" /><verse number="16" style="v" sid="LUK 5:16" />نتَّا تُوْغَا يتْرَاح غَار يمُوْشَان إِݣ يخْڒَان حمَا اَذ يࢲَّادْج ذِنِّي.<verse eid="LUK 5:16" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا يجّن ن ونشْرُوْف</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17" />ئِجّن ن نْهَار تُوْغَا عِيْسَى يسڒْمَاذ يوْذَان. قِّيمن ذِنِّي جَارَاسن ڒبْعَاض زِي ڒْحِزب ن يفَرِّسِيْين ذ يمْسڒْمَاذن ن شَّرِيعَا، ؤُسِين-د زِي مَارَّا ڒدْشُوْرَاث ن لْجَلِيل ذ يَهُوْذِيَا ذ لْقُدْس. جّْهذ ن سِيذِي أَربِّـي اَقَاث اَك عِيْسَى بَاش اَذ يسْݣنْفَا يمهْڒَاش. <verse eid="LUK 5:17" /><verse number="18" style="v" sid="LUK 5:18" />ؤُسِين-د شَان يِوْذَان يْسِين يجّن ن ورْيَاز يزّڒ ذِي ثَاسُّوْث نّس مُّوْثن-اَس يضَارن. رزُّوْن مَامّش غَا ݣّن اَث سِيذْفن اَث سرْسن زَّاثس. <verse eid="LUK 5:18" /><verse number="19" style="v" sid="LUK 5:19" />وَامِي ؤُفِين وَار زمَّرن اَث سِيذْفن مِينْزِي ذِنِّي اَطَّاس ن ڒْغَاشِي، ݣَعّْذن زَّايْس غَار ثْزقَّا قڒْعن يجّن ن ومْشَان ذِي سّْقف سهْوَان-ث-يد خ ثَاسُّوْث نّس غَار ڒْوسْط زَّاث إِ يضَارن ن عِيْسَى.<verse eid="LUK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 5:20" />نتَّا وَامِي يࢲْرَا لْإِيمَان نْسن ينَّا-ٱس إِ ونشْرُوف نِّي: "آي اَرْيَاز، تْوَاغْفَرنْت-اَش ڒْمُعْصِيَاث نّش."<verse eid="LUK 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21" />بْذَان يمْسڒْمَاذن ن شَّرِيعَا ذ ڒْحِزب ن يفَرِّسِيْين تْفكَّرن نَّان ذݣ وُوْڒَاون نْسن: "مِين يعْنَا وَانِيتَا يتَارَّا يخف نّس ذ أَربِّـي؟ ڒْمُعْصِيَاث وَار ثنْت يغْفَر شَا إِلَّا أَربِّـي وَاحْذس!"<verse eid="LUK 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22" />عِيْسَى يسّن مِين نْوَان ينَّا-ٱسن: "مَايْمِي تْفكَّرم اَمُّو كنِّيو ذِي ڒَعْقُوْڒَاث نْوم؟ <verse eid="LUK 5:22" /><verse number="23" style="v" sid="LUK 5:23" />مِين يسهْڒن اَطَّاس اَذَاس ينِيغ <char style="it">إِ ونشْرُوْف-أَ</char>، مَا ٱذَاس ينِيغ: تْوَاغْفَرنْت-اَش ڒْمُعْصِيَاث نّش؟ نِغ مَا ٱذَاس يينِيغ: كَّر شك ؤُيُوْر؟ <verse eid="LUK 5:23" /><verse number="24" style="v" sid="LUK 5:24" />نش خْسغ اَذ تسّْنم مِّيس ن بْنَاذم غَارس سُّلْطَا خ ثْمُوْرْث حمَا اَذ يغْفَر ڒْمُعْصِيَاث." أُوْشَا ينَّا-ٱس عِيْسَى إِ ونشْرُوْف نِّي: "أَذَاش ينِيغ، بدّ خ يضَارن نّش يْسِي ثَاسُّوْث نّش رُوْح اَذ تْروّْحذ غَار ثدَّارْث نّش!" <verse eid="LUK 5:24" /><verse number="25" style="v" sid="LUK 5:25" />ڒخْدّنِّي يكَّر ونشْرُوْف نِّي زَّاثْسن ييْسِي مِين تُوْغَا خف يزّڒ، يروّح يحمّذ أَربِّـي.<verse eid="LUK 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 5:26" />مَارَّا ذهْشن ذِي مَانَايَا حمّْذن أَربِّـي، ݣّْوْذن اَطَّاس نَّان: "نْهَارَا نࢲْرَا ثِمسْڒَايِين سذْهَاشنْت اَطَّاس!"<verse eid="LUK 5:26" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتْڒَاغَا-د إِ لَاوِي</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27" />منْبَعد يرُوْح عِيْسَى يُوْفَا يجّن يجمّع ضَّرِيبَا قَّارن-اَس لَاوِي، ئِقِّيم ذݣ ومْشَان مَانِي جمّْعن ضَّرِيبَا. ينَّا-ٱس عِيْسَى: "ذْفَار-اَيِي-د." <verse eid="LUK 5:27" /><verse number="28" style="v" sid="LUK 5:28" />أُوْشَا يكَّر لَاوِي يسْمح ذِي مَارَّا يذْفَار-يث. <verse eid="LUK 5:28" /><verse number="29" style="v" sid="LUK 5:29" />يݣَّا-ٱس لَاوِي يجّن ن زَرّْدث ذ ثَمقّْرَانْت ذِي ثدَّارْث نّس. حْضَارن اَكِذْسن اَطَّاس ن يعشَّارن ذ ينّغْنِي إِي قِّيمن اَكِذْسن اَذ شّن.<verse eid="LUK 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 5:30" />شثْشَان زَّايس ڒْحِزب ن يفَرِّسِيْين ذ يمْسڒْمَاذن ن شَّرِيعَا نَّان-اَسن إِ يمحْضَارن نّس: "مَايمِّي تتّم ثْسسّم اَك يعشَّارن<note caller="+" style="f"><char style="fr" closed="false">5‏.30 </char><char style="ft" closed="false">مِين عنَّان يعشَّارن؟ نِثْنِي زِي أَيث-إِسْرَائِيل خدّْمن اَك لْمخْزن ن اَرُّوْمَانُوْس جمّْعن ضَّرِيبَا زݣ أَيثْمَاثْسن. ئِسْرَائِيلِيْين نّضْنِي قَّارن بلِّي يعشَّارن عصَّان اَطَّاس. عَاوذ اَزْين اَمقّْرَان ن يعشَّارن اَرنِّين شِي حَجَا حمَا اَثنْت كْسِين إِ يِيخف نْسن.</char></note> ذ يِنِّي يعصَّان؟"<verse eid="LUK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31" />يَارَّا خَاسن عِيْسَى ينَّا-ٱسن: "ئِوْذَان يصحَّان وَار تحْذِيجِين بُو وضْبِيب، أَضْبِيب تحْذَاجَان-ث يمهْڒَاش." <verse eid="LUK 5:31" /><verse number="32" style="v" sid="LUK 5:32" />ينَّا-ٱسن: "نش وَار د ؤُسِيغ شَا اَذ ڒَاغِيغ إِ يِنِّي يدْجَان نِيشَان حمَا اَذ تُوْبن، ؤُسِيغ-د غَار يِنِّي يعصَّان."<verse eid="LUK 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33" />نَّان-اَس: "مَايمِّي يمحْضَارن ن يَحْيَى ذ يمحْضَارن ن ڒْحِزب ن يفَرِّسِيْين تْࢲُوْمَّان تْࢲَادْجَان اَطَّاس، ئِمحْضَارن نّش تتّن سسّن وَاهَا؟"<verse eid="LUK 5:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34" />ينَّا-ٱسن عِيْسَى: "كنِّيو مَا تجّم ئِمدُّوْكَاڒ ن مُوْڒَاي اَذ ࢲُوْمّن ذِي ڒْفَارْح نّس؟" <verse eid="LUK 5:34" /><verse number="35" style="v" sid="LUK 5:35" />ينَّا-ٱسن: "لَّا، وَلَكِن عَاذ اَذ د اَسن وُوْسَان اَذ يميْسِي مُوْڒَاي زِي ڒْوسْط نْسن، ڒخْدّنِّي اَذ ࢲُوْمّن ذݣ وُوْسَان نِّي."<verse eid="LUK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36" />ئِسِّيوڒ عَاوذ اَكِذْسن س ڒْمَعْنَا-يَا: "وَار يدْجِي حَدّ يتقْسَّاس-د ثَرقِّيعْث زݣ وَارُّوْض ن جْذِيذ حمَا س ثْرقِّيعْث نِّي اَزَّايس يرقّع اَرُّوْض ذ ڒْبَاڒِي. مَايمِّي؟ أَرُّوْض ذ جْذِيذ اَذ يقِّيم يتْشرَّاݣ وَاهَا، ونِّي ن ڒْبَاڒِي وَار خَاس د تِيس ثْرقِّيعْث نِّي ن جْذِيذ. <verse eid="LUK 5:36" /><verse number="37" style="v" sid="LUK 5:37" />ؤُڒَا ذ اَمَان ن وضِيڒ ذ جْذِيذ وَار خدْجْقن شَا ذݣ يِيڒْمَاون يقْذِيمن، حمَا وَار دُّوْقُّوْزن وَار تْزدْجِيعن شَا وَامَان ن وضِيڒ اَذ ضيّْعن يِيڒْمَاون نِّي. <verse eid="LUK 5:37" /><verse number="38" style="v" sid="LUK 5:38" />وَلَكِن اَمَان ن وضِيڒ ذ جْذِيذ خدْجْقن ذݣ يِيڒْمَاون ذ جْذِيذ. <verse eid="LUK 5:38" /><verse number="39" style="v" sid="LUK 5:39" />مڒَا يسْوَا شَان يجّن اَمَان وضِيڒ يقْذِيمن، أَتَاف وَار يتخْس شَا يِنِّي ذ جْذِيذ مِينْزِي يقَّار قَا يِنِّي يقْذِيمن ذ يصبْحَانن."<verse eid="LUK 5:39" /></para>
  <chapter eid="LUK 5" />
  <chapter number="6" style="c" sid="LUK 6" />
  <para style="s">مِين يدْجَان حَلَال ذِي نْهَار ن سّبْث ن لْعِبَادَا</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1" />ئِجّن ن نْهَار ن سّبْث ن لْعِبَادَا، يعْذُو عِيْسَى ذݣ وبْرِيذ ذِي ڒْوسْط ن يمنْدِي اَكِذس يمحْضَارن نّس. بْذَان يمحْضَارن نّس تكّْسن ثِيْذرِين، تْقشَّارن-ثنْت س يفَاسّن نْسن، تتّن-ثنْت.<verse eid="LUK 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 6:2" />نَّان-اَسن ڒبْعَاض زِي ڒْحِزب ن يفَرِّسِيْين: "مَايمِّي تݣّم مِين يدْجَان حْرَام ذِي نْهَار ن لْعِبَادَا؟"<verse eid="LUK 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "مَا وَار ثغْرِيم شَا مِين يݣَّا دَاود وَامِي تُوْغَا يدْجُوْز نتَّا ذ يِنِّي اَكِذس؟ <verse eid="LUK 6:3" /><verse number="4" style="v" sid="LUK 6:4" />يُوْذف غَار ثمْزِيذَا ن أَربِّـي، يُوْفَا ذِنِّي اَغْرُوْم نّي إِي يدْجَان ذ صّذْقث يشَّا نتَّا يُوْشَا-اَسن إِ يِنِّي اَكِذس؛ وَاخَّا مَانَاينِّي وَار يدْجِي شَا حَلَال غِير إِ ڒْفُقَهَا وَاهَا." <verse eid="LUK 6:4" /><verse number="5" style="v" sid="LUK 6:5" />ينَّا-ٱسن عِيْسَى: "مِّيس ن بْنَاذم إِݣ يدْجَان ذ لْحَاكم حتَّا خ نْهَار ن سّبْث ن لْعِبَادَا."<verse eid="LUK 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6" />يجّن ن نْهَار ن سّبْث ن لْعِبَادَا نّغْنِي، يُوْذف عِيْسَى غَار يِجّن ن ثمْزِيذَا ن أَيث-إِسْرَائِيل يبْذَا يسڒْمَاذ. ذِنِّي يجّن ن ورْيَاز فُوْس نّس اَفُوْسِي يمُّوْث. <verse eid="LUK 6:6" /><verse number="7" style="v" sid="LUK 6:7" />ئِمْسڒْمَاذن ن شَّرِيعَا ذ ڒْحِزب ن يفَرِّسِيْين تْلَاحَاضن خَاس مَا ٱث يسْݣنْفَا مَا لَّا ذِي نْهَار ن لْعِبَادَا حمَا اَث تَاهْمن.<verse eid="LUK 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 6:8" />عِيْسَى يسّن مِين غَارْسن ذِي ڒَعْقُوْڒَاث نْسن، ينَّا-ٱس إِ ورْيَاز نِّي إِي غَار يدْجَا فُوْس يمُّوث: "كَّر بدّ ذِي ڒْوسْط." أَرْيَاز نِّي يكَّر يبدّ ذِنِّي. <verse eid="LUK 6:8" /><verse number="9" style="v" sid="LUK 6:9" />ينَّا-ٱسن عِيْسَى: "أَكنِّيو سّقْسِيغ: ذِي نْهَار ن لْعِبَادَا مَا حَلَال أَ نݣّ ڒْخِير نِغ أَ نݣّ شَّرّْ؟ أَ نْسنْجم نّفْس نِغ اَث نْنغ؟" <verse eid="LUK 6:9" /><verse number="10" style="v" sid="LUK 6:10" />ئِخْزَر غَارْسن مَارَّا ئِج-يج، ينَّا-ٱس إِ ورْيَاز نِّي: "سَرّح فُوْس نّش!" ئِسَرّح-يث أُوْشَا يذْوڒ وفُوْس نّس يݣنْفَا. <verse eid="LUK 6:10" /><verse number="11" style="v" sid="LUK 6:11" />نِثْنِي مِين ݣِّين؟ غضْبن اَطَّاس مْشَاوَارن جَارَاسن مِين غَا ݣّن إِ عِيْسَى.<verse eid="LUK 6:11" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يخْضَر ثنْعَاش ن اَرُّسُل</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12" />ذݣ وُوْسَّان نِّي، ئِݣَعّذ عِيْسَى غَار وذْرَار اَذ يࢲَّادْج يقِّيم ذِنِّي دْجِيڒث ثكْمَاڒ يتْࢲَادْجَا إِ أَربِّـي. <verse eid="LUK 6:12" /><verse number="13" style="v" sid="LUK 6:13" />وَامِي يصْبَح ڒْحَاڒ، ئِڒَاغَا-د خ يمحْضَارن نّس يخْضَر ثنْعَاش زَّايْسن يݣِّي-ثن ذ اَرُّسُل. <verse eid="LUK 6:13" /><verse number="14" style="v" sid="LUK 6:14" />ذِنِّي سِمْعَان، ئِسمَّا-ث بُطْرُس، ذ وُوْمَاس أَنْدْرُوْس، ذ يَعْقُوْب، ذ يُوْحَنَّا، ذ فِيلِيپَّـاس، ذ بَارْتُوْلُوْمَاي، <verse eid="LUK 6:14" /><verse number="15" style="v" sid="LUK 6:15" />ذ مَتَّى، ذ تُوْمَا، ذ يَعْقُوْب مِّيس ن حَلْفَى، ذ سِمْعَان ؤُمِي قَّارن &lt;لْمُنَاضِل&gt;، <verse eid="LUK 6:15" /><verse number="16" style="v" sid="LUK 6:16" />ذ يَهُوْذَا مِّيس ن يَعْقُوْب، ذ يَهُوْذَا إِسْخَرِيُوْطِي يعْنِي ونِّي يزّنْزن عِيْسَى.<verse eid="LUK 6:16" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا اَطَّاس ن يِوْذَان</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17" />ئِهْوَا-د عِيْسَى يبدّ ذݣ يِجّن ن ومْشَان ذ ڒوْضَا. ذِنِّي اَطَّاس ن يمحْضَارن نّس ذ وَاطَّاس ن يِوْذَان زِي ثْمُوْرْث ن يَهُوْذِيَا ثكْمَاڒ، زِي لْقُدْس، عَاوذ زِي صُوْر ذ صَيْدَا إِݣ يدْجَان خ وغزْذِيس ن ڒبْحَر. <verse eid="LUK 6:17" /><verse number="18" style="v" sid="LUK 6:18" />ؤُسِين-د غَارس حمَا اَذ سْڒَان إِ وَاوَاڒ نّس، عَاوذ حمَا اَثن يسْݣنْفَا زِي ڒهْڒَاشَاث نْسن. يِنِّي يتْعدَّابن س جْنُوْن ذ يعفَّانن ؤُڒَا ذ نِثْنِي تْݣنْفَان. <verse eid="LUK 6:18" /><verse number="19" style="v" sid="LUK 6:19" />خْسن مَارَّا ڒْغَاشِي نِّي اَث حَاذَان مِينْزِي يجّن ن جّْهذ يتفّغ-د زَّايس، ئِسْݣنْفَا-ثن مَارَّا إِذْسن.<verse eid="LUK 6:19" /></para>
  <para style="s">سَّعْذ نْوم، ڒفْضِيحث نْوم</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20" />ئِيْسِي ثِيطَّاوِين نّس عِيْسَى غَار يمحْضَارن نّس ينَّا-ٱسن:</para>
  <para style="q1" vid="LUK 6:20">"سَّعْذ نْوم آ ڒْمُسَاكِين،</para>
  <para style="q2" vid="LUK 6:20">أَقَا ڒْمُلْك ن أَربِّـي إِ كنِّيو.<verse eid="LUK 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21" />سَّعْذ نْوم آ يِنِّي يدْجُوْزن،</para>
  <para style="q2" vid="LUK 6:21">أَقَا اَذ تجَّاوْنم.</para>
  <para style="q1" vid="LUK 6:21">سَّعْذ نْوم آ يِنِّي يتْرُوْن،</para>
  <para style="q2" vid="LUK 6:21">أَقَا اَذ تْضحْشم.<verse eid="LUK 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LUK 6:22" />سَّعْذ نْوم مڒَا تْعِيفَّان-كنِّيو يِوْذَان،</para>
  <para style="q1" vid="LUK 6:22">وَار كنِّيو قبْڒن سَّاوَاڒن ذَايْوم س ڒْعِيب،</para>
  <para style="q1" vid="LUK 6:22">تْزَوَرن-كنِّيو عْلَاحْسَاب مِّيس ن بْنَاذم.<verse eid="LUK 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 6:23" />ذِي نْهَار نِّي فَرْحم نݣْزم س ڒفْرَاحْث ڒَاحقَّاش اَغَارْوم يِيڒِي يجّن ن لْأَجَار ذ اَمقّْرَان ذݣ وجنَّا مِينْزِي اَمُّو إِي يݣِّين ڒجْذُوْذ نْسن إِ لْأَنْبِيَا.<verse eid="LUK 6:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24" />وَلَكِن، يَا ڒفْضِيحث نْوم آ تْوَاجَر،</para>
  <para style="q2" vid="LUK 6:24">مِينْزِي ثْعِيشم مِين ثْعِيشم.<verse eid="LUK 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25" />يَا ڒفْضِيحث نْوم آ يِنِّي يجِّيوْنن ڒخُّو،</para>
  <para style="q2" vid="LUK 6:25">مِينْزِي اَكنِّيو يڒْقف جُّوْع.</para>
  <para style="q1" vid="LUK 6:25">يَا ڒفْضِيحث نْوم آ يِنِّي يضحْشن ڒخُّو،</para>
  <para style="q2" vid="LUK 6:25">مِينْزِي اَذ تْخِيّْقم اَذ تْرُوْم.<verse eid="LUK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 6:26" />يَا ڒفْضِيحث نْوم مڒَا تْشكَّرن-كنِّيو يِوْذَان مِينْزِي اَمُّو إِي يݣِّين ڒجْذُوْذ نْسن إِ يِنَّي يتَارَّان يخف نْسن ذ لْأَنْبِيَا.<verse eid="LUK 6:26" /></para>
  <para style="s">خْسم ڒْعَذْيَان نْوم</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27" />أَذَاوم ينِيغ آ يِنِّي يتْسْڒَان: خْسث ڒْعَذْيَان نْوم، ݣّث ڒْخِير ذݣ يِنِّي كنِّيو يتْعِيفَّان. <verse eid="LUK 6:27" /><verse number="28" style="v" sid="LUK 6:28" />بَرْكث ونِّي إِي كنِّيو ينعْڒن، تَّارث إِ أَربِّـي خ يِنِّي كنِّيو يتْعدَّابن. <verse eid="LUK 6:28" /><verse number="29" style="v" sid="LUK 6:29" />ونِّي ش غَا يُوْوْثَان غَار ومݣِّيز نّش، ؤُش-اَس شك ؤُڒَا ذ اَمݣِّيز نّش نّغْنِي. ونِّي ذَاش غَا ييْسِين اَزدْجَاب نّش، اجّ-يث شك اَذَاش ييْسِي ؤُڒَا ذ ثَقْمِيجَات نّش. <verse eid="LUK 6:29" /><verse number="30" style="v" sid="LUK 6:30" />ونِّي ذَاش غَا يتَّارن شَان ثْمسْڒَايْث، ؤُش-اَس-ت. ونِّي ذَاش غَا يكّْسن ثِمسْڒَايِين نّش، وَار ث تتَّار شَا اَذَاش ثنْت يَارّ. <verse eid="LUK 6:30" /><verse number="31" style="v" sid="LUK 6:31" />مَامّش تخْسم اَذَاوم ݣّن يِوذَان، ؤُڒَا ذ كنِّيو ݣّم-اَسن اَمنِّي. <verse eid="LUK 6:31" /><verse number="32" style="v" sid="LUK 6:32" />مڒَا كنِّيو تخْسم غِير يِنِّي إِي كنِّيو يتخْسن، مَان لْأَجَار إِي غَارْوم؟ إِيوَا ؤُڒَا ذ يِنِّي يعصَّان تخْسن يِنِّي ثن يتخْسن. <verse eid="LUK 6:32" /><verse number="33" style="v" sid="LUK 6:33" />مڒَا تݣّم ڒْخِير غِير ذݣ يِنِّي إِي ذَايْوم يتݣّن ڒْخِير، مَان لْأَجَار إِي غَارْوم؟ ؤُڒَا ذ يِنِّي يعصَّان تݣّن مَانَايَا. <verse eid="LUK 6:33" /><verse number="34" style="v" sid="LUK 6:34" />مڒَا ثرْضْڒم إِ يِنِّي ثسّْنم اَذَاوم د اَرّن، مَان لْأَجَار إِي غَارْوم؟ ؤُڒَا ذ يِنِّي يعصَّان رطّْڒن إِ يِنِّي يعصَّان حمَا اَذ د اَرّن اَمَرْوَاس نْسن. <verse eid="LUK 6:34" /><verse number="35" style="v" sid="LUK 6:35" />وَلَكِن خْسث ڒْعَذْيَان نْوم، ݣّث ذَايْسن ڒْخِير. رضْڒث وَار تْرَاجَاث وَالُو. أُوْشَا اَغَارْوم يِيڒِي لْأَجَار ذ اَمقّْرَان، أَذ تِيڒِيم ذ ثَارْوَا ن أَربِّـي يُوْعْڒَان. مِينْزِي نتَّا ذ اَصبْحَان اَك يِنِّي وَار ث يتْشكَّرن شَا ذ يِنِّي يتݣّن شَّرّْ. <verse eid="LUK 6:35" /><verse number="36" style="v" sid="LUK 6:36" />رحْمث يوْذَان مَامْش يرحّم بَابَاثْوم.<verse eid="LUK 6:36" /></para>
  <para style="s">وَار تْعيَّابم بُو يِوْذَان</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37" />وَار تْعيَّابم حَدّ حمَا وَار كنِّيو يتْعيِّيب شَا أَربِّـي. وَار تْزَاوَاڒم حَدّ حمَا وَار كنِّيو يتْزَاوَاڒ شَا أَربِّـي. سمْحم إِ يِوْذَان، أَذَاوم يغْفَر أَربِّـي. <verse eid="LUK 6:37" /><verse number="38" style="v" sid="LUK 6:38" />ؤُشم-اَسن إِ يِوْذَان، أَتَاف اَذَاوم يمُّوْش. أَذَاوم يمُّوْش ڒَعْبَر ذ اَصبْحَان ذݣ وَاحْسِي ن وزدْجَاب نْوم، أَث سْهزّن اَث ذكّْنن حتَّا اَذ ينْفيّض. ڒَعْبَر إِي ثْسخْذَامم ذ ونِّي إِي كِذْوم غَا يسخْذم أَربِّـي."<verse eid="LUK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39" />ئِسِّيوڒ اَكِذْسن عَاوذ عِيْسَى س يِجّن ن ڒْمَعْنَا ينَّا-ٱسن: "أَضَرْغَاڒ، مَا ٱذ يجَرّ اَضَرْغَاڒ؟ مَا وَار وطِّين شَا س ثْنَاين إِذْسن ذِي شَان ثسْرَافْث؟ <verse eid="LUK 6:39" /><verse number="40" style="v" sid="LUK 6:40" />أَمحْضَار وَار يدْجِي شَا ذ اَمقّْرَان خ لْمُعَلِّم نّس. وَلَكِن مْكُڒ اَمحْضَار إِݣ يكمّْڒن ثْغُوْرِي نّس يتِيڒِي اَمشْنَاو لْمُعَلِّم نّس.<verse eid="LUK 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41" />مَايمِّي تْسحْقَارذ شْوَايْت ن وڒُوْم إِݣ يدْجَان ذِي ثِيطّ ن وُوْمَاش، شك تتُّوْذ اَكشُّوْض إِݣ يدْجَان ذِي ثِيطّ نّش؟ <verse eid="LUK 6:41" /><verse number="42" style="v" sid="LUK 6:42" />مَامّش تݣّذ ثْزعّْمذ اَذ تِينِيذ إِ وُوْمَاش: آي ؤُمَا، اجّ-اَيِي اَذَاش د كّْسغ ڒُوْم-أَ إِݣ يدْجَان ذِي ثِيطّ نّش، شك عَاذ تجِّيذ اَكشُّوْض ذِي ثِيطّ نّش؟ آ لْمُنَافِق، كّس ذ اَمزْوَارُو اَكشُّوْض نِّي زِي ثِيطّ نّش. عَاذ إِي غَا ثتْوَاڒِيذ مْلِيح حمَا اَذ تكّْسذ ڒُوْم إِݣ يدْجَان ذِي ثِيطّ ن وُوْمَاش!<verse eid="LUK 6:42" /></para>
  <para style="s">ثَشجَّارْث ذ مِين تَارو</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43" />وَار ثدْجِي ثْشجَّارْث ثَصبْحَانْت تَارو مِين يدْجَان ذ اَعفَّان. وَار ثدْجِي عَاوذ ثَشجَّارْث ثَعفَّانْت تَارو مِين يدْجَان ذ اَصبْحَان. <verse eid="LUK 6:43" /><verse number="44" style="v" sid="LUK 6:44" />مِينْزِي كُڒ ثَشجَّارْث ثْظهَّار-د س مِين تَارو. وَار د ڒقْذن بُو ثَازَارْث زݣ يسنَّانن. وَار د تكّْسن بُو وضِيڒ زِي ثْزݣّْوَارْث. <verse eid="LUK 6:44" /><verse number="45" style="v" sid="LUK 6:45" />بْنَاذم اَصبْحَان يسُوْفُوْغ-د مِين يدْجَان ذ اَصبْحَان زِي ڒْكنْز اَصبْحَان ن وُوْڒ نّس. بْنَاذم اَعفَّان يسُوْفُوْغ-د مِين يدْجَان ذ اَعفَّان زِي ڒْكنْز اَعفَّان ن وُوْڒ نّس. ڒَاحقَّاش اَقمُّوْم ن بْنَاذم يسَّاوَاڒ مِين يدْجَان ذݣ وُوْڒ نّس.<verse eid="LUK 6:45" /></para>
  <para style="s">ڒبْنِي ن صَّح</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46" />مَايمِّي ذَايِي ثقَّارم آ سِيذِي، آ سِيذِي أُو كنِّيو وَار تݣّم مِين ذَاوم قَّارغ؟ <verse eid="LUK 6:46" /><verse number="47" style="v" sid="LUK 6:47" />مَارَّا ونِّي غَارِي د يتَاسن يتسْڒَا إِ وَاوَاڒ ينُو يخدّم زَّايس اَتَاف اَذَاوم ينِيغ مِينْدِي يتْشَابَّاه. <verse eid="LUK 6:47" /><verse number="48" style="v" sid="LUK 6:48" />ئِتْشَابَّاه ذݣ يِجّن ن ورْيَاز إِݣ يبنَّان ثَدَّارْث نّس، ئِغْزَا اَطَّاس يݣَّا دْسَاس خ وزْرُو. وَامِي د يحْمڒ يغْزَار يعْذُو خ ثدَّارْث نِّي، وَار يزمَّر اَت يسنْهزّ مِينْزِي ثبْنَا مْلِيح.<verse eid="LUK 6:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 6:49" />ونِّي يتسْڒَان إِ وَاوَاڒ ينُو وَار زَّايس يخدّم شَا اَتَاف يتْشَابَّاه ذݣ يِجّن ن ورْيَاز يبْنَا ثَدَّارْث نّس خ وشَاڒ بْڒَا دْسَاس. وَامِي خَاس يعْذُو يغْزَار نِّي ثوْضَا ذغْيَا ذ اَبْرِيذ، ثقِّيم ذ ڒْخِرْبث."<verse eid="LUK 6:49" /></para>
  <chapter eid="LUK 6" />
  <chapter number="7" style="c" sid="LUK 7" />
  <para style="s">لإِيمَان ن يِجّن ن وعَسْكَارِي ذ اَمقّْرَان ن اَرُّوْمَانُوْس</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1" />وَامِي يكمّڒ عِيْسَى اَوَاڒ نّس اَك يِوْذَان إِي تُوْغَا ذَاس يتسْڒَان، يُوْذف غَار وبِيلَاج ن كَفرْنَاحُوْم. <verse eid="LUK 7:1" /><verse number="2" style="v" sid="LUK 7:2" />ذِنِّي يجّن ن وعَسْكَارِي ذ اَمقّْرَان ن اَرُّوْمَانُوْس غَارس يجّن ن وخدَّام يتْعوَّاڒ خَاس اَطَّاس، وَلَكِن اَخدَّام نِّي يهْڒش عْڒَاين اَذ يمّث. <verse eid="LUK 7:2" /><verse number="3" style="v" sid="LUK 7:3" />وَامِي يسْڒَا خ عِيْسَى يسّكّ غَارس شَا ن ڒشْيُخ ن أَيث-إِسْرَائِيل حمَا اَث حشّْمن اَذ د يَاس اَذ يسْݣنْفَا اَخدَّام نّس. <verse eid="LUK 7:3" /><verse number="4" style="v" sid="LUK 7:4" />وَامِي د ؤُسِين غَار عِيْسَى حشّْمن-ث نَّان-اَس: بْنَاذم-أَ يسْذَاهدْج اَث تْعَاوْنذ <verse eid="LUK 7:4" /><verse number="5" style="v" sid="LUK 7:5" />مِينْزِي يتخْس شَّعْب نّغ عَاوذ يبْنَا ثَمْزِيذَا نّغ. <verse eid="LUK 7:5" /><verse number="6" style="v" sid="LUK 7:6" />ئِكَّر عِيْسَى يرُوْح اَكِذْسن.</para>
  <para style="p" vid="LUK 7:6">وَامِي يقَارّب غَار ثدَّارْث نِّي يسّكّ-د غَارس وعَسْكَارِي نِّي شَان يمدُّوْكَاڒ نّس ينَّا-ٱس: "آ سِيذِي تْعدّْبذ يخف نّش وَاهَا، نش وَار سْذِيهِيدْجغ شَا اَذ تَاذْفذ غَار ثدَّارْث ينُو. <verse eid="LUK 7:6" /><verse number="7" style="v" sid="LUK 7:7" />خ مَانَايَا نش حسْبغ يخف ينُو وَار سْذِيهْدْجغ شَا اَذ د اَسغ غَارك. إِنِي غِير يجّن ن وَاوَاڒ أُو صَافِي اَتَاف اَذ يݣنْفَا وخدَّام ينُو. <verse eid="LUK 7:7" /><verse number="8" style="v" sid="LUK 7:8" />ؤُڒَا ذ نش س يِيخف ينُو غَارِي يِنِّي خَافِي يحكّْمن. غَارِي ڒْعَسْكَار خ وفُوْس ينُو حكّْمغ خَاسن. أَذ ينِيغ إِ يِجّن: رُوح، أَذ يرَاح. أَذ ينِيغ إِ يِجّن: أَرَاح-د، أَذ د يَاس. أَذ ينِيغ إِ وخدَّام ينُو: اݣّ ثَا، أَت يݣّ."<verse eid="LUK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9" />وَامِي يسْڒَا عِيْسَى إِ مَانَاينِّي يتْعجّب ذَايس اَطَّاس، ئِنقْڒب غَار ڒْغَاشِي إِي ث يذْفَارن ينَّا-ٱسن: "أَذَاوم ينِيغ: يِنِّي يدْجَان زِي أَيث-إِسْرَائِيل وَار ذَايْسن ؤُفِيغ بُو لْإِيمَان يمْغَر اَطَّاس اَم وَانِيتَا!" <verse eid="LUK 7:9" /><verse number="10" style="v" sid="LUK 7:10" />يِنِّي يسّكّ وعَسْكَارِي نِّي ذوْڒن غَار ثدَّارْث ؤُفِين اَخدَّام يݣنْفَا.<verse eid="LUK 7:10" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْنكَّر-د يجّن ن ومتِّين</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11" />ثِيوشَّا نّس يرُوْح عِيْسَى غَار يِجّن ن وبِيلَاج قَّارن-اَس نَعِين، أَكِذس يمحْضَارن نّس ذ ڒْغَاشِي اَطَّاس. <verse eid="LUK 7:11" /><verse number="12" style="v" sid="LUK 7:12" />وَامِي يقَارّب غَار ثوَّارْث ن وبِيلَاج، يُوْفَا ذِنِّي يْسِين-د يجّن ن ومتِّين اَث نضْڒن. نتَّا إِي غَارس غار يمَّاس وَاحْذس، نتَّاث ذ ثَاجَّاڒْث. أَكِذس ذِنِّي اَطَّاس ن ڒْغَاشِي زݣ وبِيلَاج نِّي.<verse eid="LUK 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 7:13" />وَامِي ت يࢲْرَا سِيذِيثْنغ ثقّس-اَس ينَّا-ٱس: "وَار تْرُو شَا!" <verse eid="LUK 7:13" /><verse number="14" style="v" sid="LUK 7:14" />ئِقَارّب غَار ڒْمحْمڒ يحَاذَا-ث، بدّن يِنِّي ث ييْسِين. ينَّا: "كَّر آي اَحنْجِير." <verse eid="LUK 7:14" /><verse number="15" style="v" sid="LUK 7:15" />ئِكَّر-د ومتِّين نِّي يبْذَا يسَّاوَاڒ، يَارِّي-ث عِيْسَى إِ يمَّاس.<verse eid="LUK 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16" />مَارَّا ݣّْوْذن سمْغَارن أَربِّـي نَّان: "ئِمظْهَار-د جَارَانغ يجّن ن نَّبِي ذ اَمقّْرَان. أَربِّـي يفْقذ شَّعْب نّس!" <verse eid="LUK 7:16" /><verse number="17" style="v" sid="LUK 7:17" />ئِفّغ ڒخْبَار-أَ خ عِيْسَى ذِي مَارَّا ثَمُوْرْث ن يَهُوْذِيَا ذ مَارَّا جْوَايه إِي ذَاس د ينّْضن.<verse eid="LUK 7:17" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى ذ سِيذْنَا يَحْيَى</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18" />يَحْيَى يَارَّا-د ڒخْبَار خ مَارَّا مَانَايَا زݣ يمحْضَارن نّس. ئِڒَاغَا-د خ ثْنَاين زَّايْسن <verse eid="LUK 7:18" /><verse number="19" style="v" sid="LUK 7:19" />يسّكّ-يثن غَار سِيذِيثْنغ حمَا اَذَاس ينِين مَا ذ شك إِي خف نتْسْڒَا اَذ د تَاسذ نِغ أَ نْرَاجَا شَان يِجّن نّغْنِي؟<verse eid="LUK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20" />وَامِي د ؤُسِين <char style="it">ثْنَاين</char> نِّي ن يرْيَازن غَار عِيْسَى، نَّان-اَس قَا يسْقَاذ-اَنغ-د غَارك يَحْيَى اَش نسّقْسَا: مَا ذ شك إِي نتْرَاجَا اَذ د تَاسذ نِغ ذ شَان يِجّن نّغْنِي؟" <verse eid="LUK 7:20" /><verse number="21" style="v" sid="LUK 7:21" />ذِي ڒْوقْث نِّي يسْݣنْفَا عِيْسَى اَطَّاس ن يمهْڒَاش ذ يِنِّي ذِي يدْجَا ڒحْڒِيق ذ يِنِّي ذِي دْجَان جْنُوْن ذ يعفَّانن. عَاوذ يَارَّا اَطَّاس ن يضَرْغَاڒن تْوَاڒَان.<verse eid="LUK 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 7:22" />ينَّا-ٱسن عِيْسَى: "عقْبث غَار يَحْيَى عَاوْذم-اَس مِين تْوَاڒَام ذ مِين تسْڒَام: ئِضَرْغَاڒن تْوَاڒَان، ئِزحَّافن ݣُوْرن، يِنِّي إِي ذِي يدْجَا جْذَام ݣنْفَان، ئِذهْشُوْرن تسْڒَان، يِنِّي يمُّوْثن تْنكَّرن-د، ڒْمُسَاكِين تْوَابشَّارن. <verse eid="LUK 7:22" /><verse number="23" style="v" sid="LUK 7:23" />سَّعْذ ن يِنِّي وَار ذَايِي يتْشكِّين شَا."<verse eid="LUK 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24" />صَافِي روّْحن يِنِّي يسّكّ يَحْيَى، عِيْسَى يبْذَا يسَّاوَاڒ خ يَحْيَى يقَّار-اَسن إِ ڒْغَاشِي نِّي: "مِينْخف ثفّْغم اَذ تࢲرم ذِي ڒخْڒَا؟ مَا غَار يِج وغَانِيم يتْهزَّا-ث اَرِّيح؟ لَّا! <verse eid="LUK 7:24" /><verse number="25" style="v" sid="LUK 7:25" />مڒَا لَّا، مِينْخف ثفّْغم اَذ تࢲرم؟ مَا ذ يجّن ن ورْيَاز يَرض اَرُّوْض ذ اَصبْحَان؟ لَّا، يِنِّي إِي غَار يدْجَا وَارُّوْض ذ اَصبْحَان تْعِيشن مْلِيح تِيڒِين ذِي ڒْقُصُوْر ن يزدْجِيذن! <verse eid="LUK 7:25" /><verse number="26" style="v" sid="LUK 7:26" />مڒَا لَّا، مِينْخف ثفّْغم اَذ تࢲرم؟ مَا ذ يجّن ن نَّبِي؟ قَّارغ-اَوم: وَاه، نتَّا كْتَار زݣ يِجّن ن نَّبِي. <verse eid="LUK 7:26" /><verse number="27" style="v" sid="LUK 7:27" />ذ يَحْيَى إِي خف يسَّاوَاڒ لْكِتَاب:</para>
  <para style="q1" vid="LUK 7:27">&lt;أَقَا تْسكِّيغ-د يجّن ن اَرَّسُوْل ينُو زَّاثش،</para>
  <para style="q1" vid="LUK 7:27">حمَا اَذَاش يسوْجذ اَبْرِيذ نّش.&gt;<verse eid="LUK 7:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="LUK 7:28" />أَقَا تسْڒَام: زِي مِين د جِّينْت ثمْغَارِين وَار يدْجِي حَدّ ذ اَمقّْرَان زِي يَحْيَى، وَلَكِن ونِّي إِي يدْجَان ذ اَمزْيَان قَاع ذِي ڒْمُلْك ن أَربِّـي نتَّا ذ اَمقّْرَان زِي يَحْيَى."<verse eid="LUK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29" />مَارَّا يوْذَان تسْڒَان خَاس، ؤُڒَا ذ يعشَّارن نِثْنِي س يِيخف نْسن عْتَرْفن بلِّي مَانَايَا يدْجَا نِيشَان مِينْزِي نِثْنِي تْوَاطهَّارن س وَامَان عْلَاحْسَاب يَحْيَى. <verse eid="LUK 7:29" /><verse number="30" style="v" sid="LUK 7:30" />وَلَكِن ڒْحِزب ن يفَرِّسِيْين ذ يِنِّي يتْشرَّاحن شَّرِيعَا وَار خِيسن شَا مِين يخس أَربِّـي، ؤُݣِين اَثن يطهَّار يَحْيَى س وَامَان.<verse eid="LUK 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31" />"خ مَانَايَا وِي ذِي غَا شَابّْهغ يوْذَان ن ڒْوقْث-أَ؟ مِينْذِي تْشَابَّاهن؟ <verse eid="LUK 7:31" /><verse number="32" style="v" sid="LUK 7:32" />نِثْنِي اَم شَا ن يحنْجِيرن إِي يقِّيمن ذِي سَّاحَا تْڒَاغَان إِ وَايَاوْيَا قَّارن: نتْصُوْض ذِي ثمْجَا، وَار ثشْضِيحم شَا. نتْعزَّا-كنِّيو، وَار ثتْرُوْم شَا. <verse eid="LUK 7:32" /><verse number="33" style="v" sid="LUK 7:33" />مِينْزِي يَحْيَى يُوْسَا-د يتْࢲُوْمَّا وَار يسسّ اَمَان ن وضِيڒ كنِّيو ثنِّيم اَقَا ذَايس جْنُوْن! <verse eid="LUK 7:33" /><verse number="34" style="v" sid="LUK 7:34" />يُوْسَا-د مِّيس ن بْنَاذم يتتّ يسسّ وَار يتْࢲُوْمِّي شَا. كنِّيو ثنِّيم اَقَا بْنَاذم-أَ يتتّ يسسّ اَطَّاس، عَاوذ نتَّا ذ اَمدُّوْكڒ ن يعشَّارن ذ يِنِّي يعصَّان. <verse eid="LUK 7:34" /><verse number="35" style="v" sid="LUK 7:35" />إِنَّمَا، ڒفْهَامث ن أَربِّـي قبّْڒن-تث مَارَّا يِنِّي يتفْهَامن."<verse eid="LUK 7:35" /></para>
  <para style="s">ئِجّن ن ثمْغَارْث تْوَاغْفَرنْت-اَس ڒْمُعْصِيَاث نّس</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36" />ئِج وفَرِّسِي يعَرض عِيْسَى حمَا اَذ يشّ اَكِذس. يُوْذف غَار ثدَّارْث ن وفَرِّسِي نِّي يقِّيم غَار مِيسَّا. <verse eid="LUK 7:36" /><verse number="37" style="v" sid="LUK 7:37" />ذِنِّي ذݣ وبِيلَاج نِّي يجّن ن ثمْغَارْث ثْعصَّا. ثَارَّا-د ڒخْبَار عِيْسَى يقِّيم اَذ يشّ ذِي ثدَّارْث ن وفَرِّسِي نِّي، ثُوْسَا-د نتَّاث غَارس يجّن ن ثْزيَّات ذَايس اَمَان ن لْوَرْذ. <verse eid="LUK 7:37" /><verse number="38" style="v" sid="LUK 7:38" />ثقِّيم غَار ذفَّار ن عِيْسَى غَار يضَارن نّس ثبْذَا ثتْرُو وْضَان-اَس يمطَّاون نّس خ يضَارن ن عِيْسَى. ثْرُوْح ثمْسح-يثن س وشوَّاف نّس، ثْسدْجم-يثن ثذْهن-يثن س وَامَان ن لْوَرْذ.<verse eid="LUK 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 7:39" />أَفَرِّسِي نِّي إِي ث يعَرْضن وَامِي يࢲْرَا مَانَايَا ينَّا ذِي نّفْس نّس: وَانِيتَا مَعْلِيك ذ نَّبِي اَتَاف اَذ يسّن مِين ثعْنَا ثمْغَارْث-أَ إِي ث يتْحَاذَان، نتَّاث ثعْصَا أَربِّـي.<verse eid="LUK 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40" />ئِنْدق-د عِيْسَى ينَّا-ٱس: "آ سِمْعَان، غَارِي يج ن ڒْحَاجث اَذَاش ت ينِيغ."</para>
  <para style="p" vid="LUK 7:40">ينَّا-ٱس سِمْعَان: "سِّيوڒ آ لْمُعَلِّم."<verse eid="LUK 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41" />"ذِنِّي يجّن ن سِّيّد يرْضڒ تْمنْيَاث إِ ثْنَاين ن يِوْذَان. ئِجّن يرْضڒ-اَس خمْسْمِيَّا دِينَار، ئِجّن يرْضڒ-اَس خمْسِين دِينَار. <verse eid="LUK 7:41" /><verse number="42" style="v" sid="LUK 7:42" />وَلَكِن وَار غَارْسن مِينْزِي غَا اَرّن، صَافِي سِّيّد نِّي يسْمح-اَسن مَارَّا. إِن-اَيِي شك: مَانْون إِي ث غَا يحِبّن اَطَّاس؟"<verse eid="LUK 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43" />ينَّا-ٱس سِمْعَان: "يمْكن ونِّي ؤُمي يسْمح ذݣ وَاطَّاس ن ومَرْوَاس."</para>
  <para style="p" vid="LUK 7:43">ينَّا-ٱس عِيْسَى: "غَارك ڒْحَقّ."<verse eid="LUK 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 7:44" />ئِنقْڒب غَار ثمْغَارْث نِّي ينَّا-ٱس إِ سِمْعَان: "أَقَا تْوَاڒِيذ ثَمْغَارْث-أَ؟ ؤُسِيغ-د غَار ثدَّارْث نّش وَار ذَايِي د ثُوْوِيذ شك ؤُڒَا ذ اَمَان إِي زِي غَا سِيرْذغ يضَارن ينُو. نتَّاث ثْسِيرذ-اَيِي يضَارن ينُو س يمطَّاون نّس ثمْسح-يثن س وشوَّاف نّس. <verse eid="LUK 7:44" /><verse number="45" style="v" sid="LUK 7:45" />شك وَار خَافِي ثْسدْجْمذ شَا. زݣ وَامِي د ؤُسِيغ نتَّاث ثْسدْجَام-اَيِي يضَارن ينُو. <verse eid="LUK 7:45" /><verse number="46" style="v" sid="LUK 7:46" />شك وَار ذَايِي ثذْهِينذ اَزدْجِيف ؤُڒَا س زّشْت. نتَّاث ثذْهن-اَيِي يضَارن ينُو س وَامَان ن لْوَرْذ. <verse eid="LUK 7:46" /><verse number="47" style="v" sid="LUK 7:47" />خ مَانَايَا اَذَاش ينِيغ، ڒْمُعْصِيَاث نِّي إِي ثݣَّا اَطَّاس تْوَاغْفَرنْت-اَس مِينْزِي نتَّاث ذَايس ڒمْحِبّث اَطَّاس. ونِّي ؤُمِي تْوَاغْفَرنْت ڒْمُعْصِيَاث ذْرُوْس، نتَّا ذَايس ڒمْحِبّث ذْرُوْس."<verse eid="LUK 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48" />ينَّا-ٱس إِ ثمْغَارْث نِّي: "ڒْمُعْصِيَاث نّمْ تْوَاغْفَرنْت-اَم."<verse eid="LUK 7:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49" />بْذَان يِنِّي إِي كِس يقِّيمن قَّارن إِ وَايَاوْيَا: "مِين يعْنَا وَانِيتَا إِݣ يغْفَرن ڒْمُعْصِيَاث-أَ؟"<verse eid="LUK 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50" />ينَّا-ٱس عِيْسَى إِ ثمْغَارْث نِّي: "شم يسنْجم-يشم لْإِيمَان نّم، رُوْح ذِي ڒهْنَا."<verse eid="LUK 7:50" /></para>
  <chapter eid="LUK 7" />
  <chapter number="8" style="c" sid="LUK 8" />
  <para style="s">ڒْمَعْنَا ن ونِّي يزرّْعن</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1" />منْبَعْد إِ مَانَايَا يݣُّوْر عِيْسَى زِي دْشَا غَار دْشَار زݣ وبِيلَّاج غَار وبِيلَاج يتحدَّاث يتْبشَّار س ڒْمُلْك ن أَربِّـي. أَكِذس ثنْعَاش ن يمحْضَارن نّس <verse eid="LUK 8:1" /><verse number="2" style="v" sid="LUK 8:2" />ذ شَان ثمْغَارِين يسْݣنْفَا-ثنْت زِي جْنُوْن ذ ڒهْڒَاشَاث. نِثنْتِي ذ مَرْيَم ؤُمِي قَّارن ثَمَݣْدَلِيث إِي زِي فّْغن سبْعَا ن جْنُوْن، <verse eid="LUK 8:2" /><verse number="3" style="v" sid="LUK 8:3" />ذ أَيُوْنَّا ثَمْغَارْث ن خُوْزِي لْوَكِيل ن هِيرُوْدُس، ذ سُوْزَانَا، ذ ثِنّضْنِي اَطَّاس إِي تْعَاوَاننْت س وَاݣْڒَا نْسنْت.<verse eid="LUK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4" />وَامِي خَاس د مُوْنن عَاوذ اَطَّاس ن ڒْغَاشِي ذ يِنِّي غَارس د يُوْسِين زِي مكُڒ اَبِيلَاج، ئِبْذَا يسَّاوَاڒ اَكِذْسن س يِجّن ن ڒْمَعْنَا ينَّا: <verse eid="LUK 8:4" /><verse number="5" style="v" sid="LUK 8:5" />"ئِفّغ وفدْجَاح اَذ يزْرع. وَامِي يزرّع، ثوْضَا-يَاس شَان زَّرِّيعث خ طَّارْف ن وبْرِيذ. عفّْسن خَاس يِوْذَان شِّين-تث يجْضَاض ن وجنَّا. <verse eid="LUK 8:5" /><verse number="6" style="v" sid="LUK 8:6" />شَان زَّرِّيعث ثوْضَا-يَاس جَار يِزْرَا. ثغْمِي-د، ڒخْدّنِّي ثْنزْڒف ثِيسْرَاو ڒَاحقَّاش وَار ثسْوِي بُو وَامَان. <verse eid="LUK 8:6" /><verse number="7" style="v" sid="LUK 8:7" />شَان زَّرِّيعث ثوْضَا جَار يسنَّانن. غْمِين-د اَكِذس يسنَّانن نِّي جيّْفن-تث. <verse eid="LUK 8:7" /><verse number="8" style="v" sid="LUK 8:8" />شَان زَّرِّيعث ثوْضَا خ ثْمُوْرْث ثَصبْحَانْت. ثُوْڒِي-د ثمْغَار ثݣَّا ثِيذرِين كُڒ يشْتن ثُوْرو مِيَا." وَامِي يكمّڒ وَاوَاڒ-أَ ينَّا س جّْهذ: "صنّط مْلِيح آ ونِّي يتْسْڒَان."<verse eid="LUK 8:8" /></para>
  <para style="s">أَسفْهم ن ڒْمَعْنَا ن ونِّي يزرّْعن</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9" />سّقْسَان-ث يمحْضَارن نّس نَّان-اَس: "مِين يخس اَذ يِينِي ڒْمَعْنَا-يَا؟"<verse eid="LUK 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 8:10" />ينَّا-ٱسن: "ئِتْوَاسْمح إِ كنِّيو اَذ تسّْنم مِين ينُوْفَّرن ذِي ڒْمُلْك ن أَربِّـي، وَلَكِن إِ يِوْذَان نّغْنِي لَّا. سَّاوَاڒغ اَكِذْسن س ڒمْعَانِي حمَا اَذ خْزَرن وَلَكِن وَار تْوِيڒِين شَا، حمَا اَذ سْڒن وَلَكِن وَار فهّْمن إِ شَا.<verse eid="LUK 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11" />ڒْمَعْنَا-يَا يخس اَذ يِينِي: زَّرِّيعث نِّي نتَّاث ذ اَوَاڒ ن أَربِّـي. <verse eid="LUK 8:11" /><verse number="12" style="v" sid="LUK 8:12" />زَّرِّيعث نِّي إِݣ يوْضَان خ وبْرِيذ نتَّاث اَم يِوْذَان إِي تسْڒَان إِ وَاوَاڒ ن أَربِّـي. ئِتْرَاح إِبْڒِيس يتكّس-اَسن-ث زݣ وُوْڒ حمَا وَار تِيمْنن شَا، وَار نجّْمن شَا. <verse eid="LUK 8:12" /><verse number="13" style="v" sid="LUK 8:13" />زَّرِّيعث نِّي إِݣ يوْضَان جَار يِزْرَا نتَّاث اَم يِوْذَان إِي تسْڒَان إِ وَاوَاڒ ن أَربِّـي، قبْڒن-ث س ڒفْرَاحث. وَامِي وَار ؤُوْثِين بُو يࢲوْرَان مْلِيح ذغْيَا تْنقْڒَاعن. تَامْنن زَّايس غِير ذݣ يِجّن ن ڒْوقْث وَاهَا، ذِي ڒْوقْث ن ڒمْحَاين ذغْيَا تفّْغن اَبْرِيذ. <verse eid="LUK 8:13" /><verse number="14" style="v" sid="LUK 8:14" />زَّرِّيعث نِّي إِݣ يوْضَان جَار يسنَّانن نتَّاث اَم يِوْذَان إِي تسْڒَان إِ وَاوَاڒ ن أَربِّـي، وَلَكِن ذغْيَا تمْجيَّافن س ومْنُوْس ذ وَاݣْڒَا ذ شّهَاوَاث ن دُّنشْت-أَ وَار نفّْعن شَا. <verse eid="LUK 8:14" /><verse number="15" style="v" sid="LUK 8:15" />وَلَكِن زَّرِّيعث نِّي إِݣ يوْضَان ذِي ثْمُوْرْث ثَصبْحَانْت نتَّاث اَم يِوْذَان إِي تسْڒَان إِ وَاوَاڒ ن أَربِّـي قبْڒن-ث س وُوْڒ نْسن اَصبْحَان ذ اَشمْڒَاڒ، صبَّارن حمَا اَذ اَرْون.<verse eid="LUK 8:15" /></para>
  <para style="s">ڒْمَعْنَا ن ڒْقنْدِيڒ</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16" />ؤُڒَا ذ يجّن وَار يتْشَعِّيڒ ڒْقنْدِيڒ حمَا اَخَاس يقْڒب اَقْنُوْش نِغ اَث يݣّ سْوَادَّاي إِ قَامَا. لَّا، ئِتݣّ-يث خ ڒْمَرْفَاع حمَا اَذَاسن يُوْش ثْفَاوْث إِ يِنِّي إِي د غَا يَاذْفن. <verse eid="LUK 8:16" /><verse number="17" style="v" sid="LUK 8:17" />مَارَّا مِين ينُوْفَّرن اَذ د يمظْهَار. مَارَّا مِين يتْوَاسْنُوْفَّرن اَذ ينفْضح اَذ يتْوَاسّن. <verse eid="LUK 8:17" /><verse number="18" style="v" sid="LUK 8:18" />أَرّم-د ڒْبَاڒ نْوم إِ مَامّش تسْڒَام. ونِّي يدْجَان غَارس يتْمَارْنِي-يَاس. وَلَكِن ونِّي وَار غَار يدْجِي شَا، يتْوَاكْسِي-يَاس ؤُڒَا ذ مِين ذَاس يتْغِير غَارس."<verse eid="LUK 8:18" /></para>
  <para style="b" />
  <para style="s">سِيذِيثْنغ عِيْسَى ذ يمَّاس ذ اَيثْمَاس</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19" />عِيْسَى ثُوْسَا-د غَارس يمَّاس ذ أَيثْمَاس، وَار زمَّرن شَا اَغَارس اَوْضن، ذِنِّي اَطَّاس ن ڒْغَاشِي.<verse eid="LUK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 8:20" />ندْقن-د شَان يِوذان نَّان-اَس: "أَقَا يمَّاش ذ أَيثْمَاش بدّن غَار بَارَّا رزُّوْن اَشك ࢲرن."<verse eid="LUK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21" />يَارَّا خَاسن ينَّا-ٱسن: "أَقَا يمَّا ذ اَيثْمَا نِثْنِي ذ يوْذَان نِّي يتْسْڒَان إِ وَاوَاڒ ن أَربِّـي خدّْمن زَّايس."<verse eid="LUK 8:21" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْبدَّا اَرِّيح ذِي ڒبْحَر</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22" />ئِجّن ن نْهَار ينْيَا عِيْسَى ذِي ثْغَرَّابُوْت اَك يمحْضَارن نّس ينَّا-ٱسن: "يَالَّاه أَ نزْوَام غَار وجمَّاض-ين ن ڒبْحَر." رُوْحن، <verse eid="LUK 8:22" /><verse number="23" style="v" sid="LUK 8:23" />وَامِي ؤُيُوْرن ذِي ڒبْحَر، عِيْسَى يكَّا خَاس يِضص. عْلَاغَفْلَا يكَّر-د يجّن ن اَرِّيح يجْهذ اَطَّاس ذِي ڒبْحَر، ثبْذَا ثْغَرَّابُوْت تْعمَّر س وَامَان ؤُوْضن-د ذݣ يِجّن ن لْخَطَر.<verse eid="LUK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 8:24" />قَارّْبن غَارس يمحْضَارن سْفَاقن-ث نَّان-اَس: "آ لْمُعَلِّم آ لْمُعَلِّم، أَقَا نشِّين نتْمتَّا!" ئِكَّر عِيْسَى يسْبدّ اَرِّيح ذ ڒمْوَاج يهدّن ڒْحَاڒ يرْسَا.<verse eid="LUK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 8:25" />ينَّا-ٱسن: "مَانِي يدْجَا لْإِيمَان نْوم؟"</para>
  <para style="p" vid="LUK 8:25">ݣّْوْذن تْعجّْبن نَّان إِ وَايَاوْيَا: "مِين يعْنَا وَانِيتَان؟ ؤُڒَا ذ اَرِّيح ذ وَامَان ن ڒبْحَر يتْأَمَر-يثن تْطَاعَان-اَس."<verse eid="LUK 8:25" /></para>
  <para style="s">ئِجّن ذَايس جْنُوْن ذِي ثْمُوْرْث ن يجَرِيثِيْين</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26" />ؤُوْضن غَار ثْمُوْرْث ن يجَرِيثِيْين زَّاث إِ ثْمُوْرْث ن لْجَلِيل. <verse eid="LUK 8:26" /><verse number="27" style="v" sid="LUK 8:27" />وَامِي يُوْوض عِيْسَى غَار ڒْبَرّ يڒْقَا-ث-يذ يجّن ن بْنَاذم زِي ثنْدِينْت ذَايس جْنُوْن. نتَّا اَطَّاس زݣ وَامِي وَار يَرّض بُو وَارُّوْض وَار يزدّغ شَا ذِي ثدَّارْث، ئِزدّغ ذݣ يمضْڒَان.<verse eid="LUK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 8:28" />وَامِي يُوْفَا عِيْسَى ذِنِّي يبْذَا يسْنكَّر ثْغُوْيّث، ئِوْضَا غَار يضَارن ن عِيْسَى ينْدق-د س يِجّن ن ثْمِيجَّا ثُوْعْڒَا ينَّا-ٱس: "آ عِيْسَى آ مِّيس ن أَربِّـي يُوْعْڒَان، مِين ثخْسذ زَّايِي؟ تتَّارغ زَّايك حمَا وَار ذَايِي تْعدِّيبذ شَا!" <verse eid="LUK 8:28" /><verse number="29" style="v" sid="LUK 8:29" />ينَّا مَانَايَا مِينْزِي عِيْسَى تُوْغَا يُوْمَر جّنّ نِّي اَعفَّان حمَا اَذ يفّغ زݣ ورْيَاز نِّي. عَاوذ مِينْزِي جّنّ نِّي يتطّف-يث اَطَّاس ن ثْوَاڒَاثِين. وَاخَّا تقّْنن-اَس يفَاسّن ذ يضَارن نّس س سْنَاسڒ حطَّان-ث، يتْرزَّا-ثنْت ينْده-يث جّنّ نِّي غَار ڒخْڒَا.<verse eid="LUK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30" />ئِسّقْسَا-ث عِيْسَى ينَّا-ٱس: "مَامّش ذَاش قَّارن؟"</para>
  <para style="p" vid="LUK 8:30">ينَّا-ٱس: "نش قَّارن-اَيِي أَبرُّو" مِينْزِي تُوْغَا ؤُذْفن ذَايس اَطَّاس ن جْنُوْن. <verse eid="LUK 8:30" /><verse number="31" style="v" sid="LUK 8:31" />حشّْمن-ث اَطَّاس جْنُوْن نِّي حمَا وَار ثن يتْسكِّي شَا غَار وَانُو بْڒَا ڒَحدّ.<verse eid="LUK 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32" />ذِنِّي يجّن ن ثْحِيمرْث ذ ثَمقّْرَانْت ن يِيڒْفَان ثَرْوس خ وذْرَار. تَّارن زَّايس حمَا اَثن يجّ اَذَايس اَذْفن. سّنِّي يجِّي-ثن. <verse eid="LUK 8:32" /><verse number="33" style="v" sid="LUK 8:33" />فّْغن جْنُوْن زِي بْنَاذم نِّي ؤُذْفن ذݣ يِيڒْفَان. ثهْوَا ثْحِيمرْث نِّي خ وذْرَار غَار ڒبْحَر ثغْرق ذِنِّي. <verse eid="LUK 8:33" /><verse number="34" style="v" sid="LUK 8:34" />يِنِّي يَروّْسن، ࢲْرِين مِين يوقْعن اَروْڒن سُوْفْغن ڒخْبَار ذِي ثنْدِينْت ذ ڒدْشُوْرَاث. <verse eid="LUK 8:34" /><verse number="35" style="v" sid="LUK 8:35" />فّْغن-د يِوْذَان حمَا اَذ ࢲرن مِين يوقْعن. ؤُسِين-د غَار عِيْسَى ؤُفِين اَرْيَاز نِّي فّْغن زَّايس جْنُوْن، ئِقِّيم غَار يضَارن ن عِيْسَى يَرض اَرُّوْض نّس يݣنْفَا يذْوڒ س ڒَعْقڒ نّس. أُوْشَا ݣّْوْذن اَطَّاس. <verse eid="LUK 8:35" /><verse number="36" style="v" sid="LUK 8:36" />خبَّرن-ثن ڒشْهُوْذ مَامّش يݣَّا عِيْسَى يسْݣنْفَا اَرْيَاز نِّي إِي ذِي تُوْغَا دْجَان جْنُوْن. <verse eid="LUK 8:36" /><verse number="37" style="v" sid="LUK 8:37" />أُوْشَا تَّارن زِي عِيْسَى مَارَّا أَيْثْبَاب ن جِّهث ن يجَرِيثِيْين حمَا اَخَاسن يبعّذ مِينْزِي ݣّْوْذن اَطَّاس. ئِنْيَا ذِي ثغَرَّابُوْت يعْقب سّنِّي.<verse eid="LUK 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 8:38" />أَرْيَاز نِّي إِي زِي فّْغن جْنُوْن يتَّار زِي عِيْسَى حمَا اَكِذس يرَاح. وَلَكِن عِيْسَى يُوْݣِي يسّكّ-يث ينَّا-ٱس: <verse eid="LUK 8:38" /><verse number="39" style="v" sid="LUK 8:39" />"عْقب غَار ثدَّارْث نّش، سْخبَّر-يثن س مِين ذَاش يݣَّا أَربِّـي." ئِرُوْح ورْيَاز نِّي يبْذَا يتْخبَّار ذِي ثنْدِينْت ثكْمَاڒ زِي مِين ذَاس يݣَّا عِيْسَى.<verse eid="LUK 8:39" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا يدْجِيس ن يَاݣْرُس</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40" />وَامِي د يذْوڒ عِيْسَى، رحّْبن زَّايس ڒْغَاشِي مِينْزِي مَارَّا إِذْسن تْرَاجَان-ث. <verse eid="LUK 8:40" /><verse number="41" style="v" sid="LUK 8:41" />يُوْسَا-د غَارس يجّن ن ورْيَاز قَّارن-اَس يَاݣْرُس. نتَّا ذ اَرَّايس ن ثمْزِيذَا إِي يدْجَان ذِنِّي. يوْضَا غَار يضَارن ن عِيْسَى يبْذَا يتْحشَّام-يث اَطَّاس حمَا اَكِذس يرَاح غَار ثدَّارْث نّس <verse eid="LUK 8:41" /><verse number="42" style="v" sid="LUK 8:42" />مِينْزِي غَارس غِير يجّن ن ثْحنْجِيرْث وَاهَا عْڒَاين اَذ تݣّ ثنْعَاش يسݣّْوُسَا، تْمتَّا.</para>
  <para style="p" vid="LUK 8:42">ئِكَّر عِيْسَى يرُوْح، تمْزَاحَامن خَاس ڒْغَاشِي.<verse eid="LUK 8:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 8:43" />ذِنِّي جَار يِوْذَان نِّي يجّن ن ثمْغَارْث ثنْعَاش يسݣّْوُسَا زݣ وَامِي إِي ثهْڒش، تَازّڒ س يذَامّن.<note caller="+" style="f"><char style="fr" closed="false">8‏.43 </char><char style="ft" closed="false">ئِذَامّن نتَّا ذ دّم.</char></note> مَارَّا مِين غَارس ذ اَݣْڒَا ثْضيّع-يث خ يضْبِيبن، وَار يزمَّر حَدّ اَت يسْݣنْفَا. <verse eid="LUK 8:43" /><verse number="44" style="v" sid="LUK 8:44" />ثذْفَار عِيْسَى، ثْحَاذَا-يَاس طَّارف ن وسڒْهَام نّس ڒخْدّنِّي ثْݣنْفَا ذݣ ومْشَان.<verse eid="LUK 8:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 8:45" />ينَّا عِيْسَى: "وِي ذَايِي يحَاذَان؟"</para>
  <para style="p" vid="LUK 8:45">مَارَّا إِذْسن نْكَرن. ينَّا-ٱس بُطْرُس: "آ لْمُعَلِّم، قَا مَارَّا يِوْذَان-أَ تمْزَاحَامن خَاش!"<verse eid="LUK 8:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46" />ينَّا عِيْسَى: "لَّا، سْحِيسّغ شَان يِجّن يحَاذَا-اَيِي مِينْزِي سّْنغ جّْهذ يفّغ زَّايِي." <verse eid="LUK 8:46" /><verse number="47" style="v" sid="LUK 8:47" />وَامِي ثُوْفَا ثمْغَارْث نِّي ثْنفْضح، ثْرُوْح غَار عِيْسَى ترْجِيجِي ثوْضَا-يَاس غَار يضَارن نّس. ثْعَاوذ-اَس زَّاث إِ مَارَّا يوْذَان نِّي مَايمِّي ث ثْحَاذَا ذ مَامّش ثْݣنْفَا ذݣ ومْشَان.<verse eid="LUK 8:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 8:48" />ينَّا-ٱس عِيْسَى: "آ يدْجِي، شم لْإِيمَان نّمْ يسْݣنْفَا-شم. رُوْح ذِي ڒهْنَا."<verse eid="LUK 8:48" /></para>
  <para style="b" />
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49" />وَامِي عَاذ يسَّاوَاڒ، يُوْسَا-د يجّن زِي ثدَّارْث ن اَرَّايس نِّي ن ثمْزِيذَا ينَّا-ٱس: "يدْجِيش شك ثمُّوْث. وَار تْعدَّاب شَا ڒخُّو لْمُعَلِّم."<verse eid="LUK 8:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50" />ئِسْڒَا-يَاس عِيْسَى ينَّا-ٱس: "وَار تݣّْوذ شَا! أَمن وَاهَا، أَقَا يدْجِيش اَذ تْݣنْفَا." <verse eid="LUK 8:50" /><verse number="51" style="v" sid="LUK 8:51" />وَامِي يُوْوض غَار ثدَّارْث ن يَاݣْرُس، وَار يجِّي ؤُڒَا ذ يجّن اَذ يَاذف إِلَّا بُطْرُس ذ يُوْحَنَّا ذ يَعْقُوْب ذ بَابَاس ذ يمَّاس ن ثْحنْجِيرْث نِّي.<verse eid="LUK 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 8:52" />مَارَّا تْرُوْن خَاس تْعزَّان. ينَّا-ٱسن عِيْسَى: "وَار خَاس تْرُوْم شَا. أَقَا ثْحنْجِيرْث-أَ وَار ثمُّوْث شَا، ثطّص وَاهَا!" <verse eid="LUK 8:52" /><verse number="53" style="v" sid="LUK 8:53" />بْذَان ضحّْشن خَاس قَا سّْنن بلِّي ثمُّوْث.<verse eid="LUK 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 8:54" />ئِطّف-اَس ذݣ وفُوْس إِ ثْحنْجِيرْث نِّي ينَّا-ٱس: "آ ثَحنْجِيرْث كَّر." <verse eid="LUK 8:54" /><verse number="55" style="v" sid="LUK 8:55" />ڒخْدّنِّي بُوْحْبڒ نّس يذْوڒ-اَس-د، ثكَّر ذݣ ومْشَان. ئِوصَّا-ثن اَذَاس ؤُشن مِين غَا ثشّ. <verse eid="LUK 8:55" /><verse number="56" style="v" sid="LUK 8:56" />بَابَاس ذ يمَّاس قِّيمن تْعجّْبن. نتَّا يوْصَّا-ثن ينَّا-ٱسن وَار تْعَاوَاذم إِ حَدّ مِين يوقْعن.<verse eid="LUK 8:56" /></para>
  <chapter eid="LUK 8" />
  <chapter number="9" style="c" sid="LUK 9" />
  <para style="s">سِيذِيثْنغ عِيْسَى يسّكّ ارُّسُل أَذ بشَّرن</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1" />ئِڒَاغَا-د عِيْسَى خ ثنْعَاش ن اَرُّسُل، يُوْشَا-ٱسن ثِزمَّار ذ سُّلْطَا اَذ حكْمن خ مَارَّا جْنُوْن أُو عَاوذ حمَا اَذ سْݣنْفَان ڒهْڒَاشَاث. <verse eid="LUK 9:1" /><verse number="2" style="v" sid="LUK 9:2" />ئِسّكّ-يثن حمَا اَذ بشَّرن س ڒْمُلْك ن أَربِّـي اَذ سْݣنْفَان يمهْڒَاش. <verse eid="LUK 9:2" /><verse number="3" style="v" sid="LUK 9:3" />ينَّا-ٱسن: "وَار كِذْوم تِيوِيم وَالُو خ وبْرِيذ. وَار كسِّيم نِي اَعكَّاز، نِي اَقْرَاب، نِي اَغْرُوْم، نِي نُّقَارْث، نِي ثْنَاين ن يتْشَامِّيرن. <verse eid="LUK 9:3" /><verse number="4" style="v" sid="LUK 9:4" />خْمِي غَا ثَاذْفم غَار شَان ثدَّارْث، قِّيمم ذِنِّي اَڒ غَا ثُوْيُوْرم سّنِّي. <verse eid="LUK 9:4" /><verse number="5" style="v" sid="LUK 9:5" />مڒَا وَار كنِّيو قْبِيڒن شَا ذِي شَان ثنْدِينْت، فّْغم سّنِّي مسْحث ثَعجَّاشْت زݣ يضَارن نْوم اَم شَا ن شْهَاذث خَاسن." <verse eid="LUK 9:5" /><verse number="6" style="v" sid="LUK 9:6" />صَافِي رُوْحن اَرُّسُل عْذُوْن ذِي ڒدْشُوْرَاث، تْبشَّارن سْݣنْفَان يوْذَان ذِي مْكُڒ اَمْشَان.<verse eid="LUK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7" />لْوَالِي هِيرُودُس يَارَّا-د ڒخْبَار خ مَارَّا مِين يتوْقِيعن، ئِذْهش مِينْزِي شَان يِوْذَان قَّارن قَا وَانِيتَا ذ يَحْيَى نِّي، ئِتْوَاسكَّر-د زِي ڒْموْث. <verse eid="LUK 9:7" /><verse number="8" style="v" sid="LUK 9:8" />ئِجّن يقَّار لَّا، قَا ذ إِلْيَاس إِي د يمظْهَارن. ئِجّن يقَّار لَّا، قَا يكَّر-د يجّن زِي لْأَنْبِيَا نِّي يقْذِيمن.<verse eid="LUK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 9:9" />هِيرُوْدُس ينَّا: "أَقَا نش قسّغ اَزدْجِيف إِ يَحْيَى نِّي، مِين يعْنَا وَانِيتَا إِي خف تسْڒِيغ مَانَايَا؟" ئِخس اَث يࢲر.<verse eid="LUK 9:9" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسشّ خمْسَاڒَاف ن يرْيَازن</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10" />وَامِي د ذوْڒن اَرُّسُل، عَوْذن-اَس إِ عِيْسَى خ مَارَّا مِين ݣِّين. يُوْوِي-ثن سّنِّي غَار جِّهث ن يِجّن ن وبِيلَاج ؤُمِي قَّارن بَيْت صَيْدَا. <verse eid="LUK 9:10" /><verse number="11" style="v" sid="LUK 9:11" />وَامِي ڒْغَاشِي سّْنن مَانَايَا ذْفَارن-ث. نتَّا يسْتقْبڒ-يثن يبْذَا يسَّاوَاڒ اَكِذْسن خ ڒْمُلْك ن أَربِّـي يسْݣنْفَا يِنِّي يخْسن اَذ ݣنْفَان.<verse eid="LUK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12" />وَامِي يعْذُو ڒْحَاڒ ؤُسِين-د غَارس ثنْعَاش <char style="it">ن يمحْضَارن نّس</char> نَّان-اَس: "سكّ يوْذَان-أَ سَّا غَار ڒدْشُوْرَاث ذ ثُوْذْرِين يُوْذْسن اَمُّو ذ وَامُّو، أَذ رْزُوْن مِين غَا شّن ذ مَانِي غَا سنْسن مِينْزِي اَمْشَان-أَ ذ ڒخْڒَا وَاهَا."<verse eid="LUK 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13" />ينَّا-ٱسن عِيْسَى: "ؤُشم-اَسن كنِّيو مِين غَا شّن."</para>
  <para style="p" vid="LUK 9:13">نَّان-اَس: "نشِّين غَارْنغ ذَا غِير خمْسَا ن ثْخبَّازِين ذ ثْنَاين ن يسڒْمَان. مَا أَ نْرَاح نشِّين أَ نْسغ مَشَّا إِ مَارَّا يوْذَان-أَ؟" <verse eid="LUK 9:13" /><verse number="14" style="v" sid="LUK 9:14" />(مِينْزِي ذِنِّي شَان خمْسَاڒَاف ن يرْيَازن).</para>
  <para style="p" vid="LUK 9:14">ينَّا-ٱسن عِيْسَى إِ يمحْضَارن نّس: "سْغِيمم-ثن ذ لْفِرْقَاث، خمْسِين خمْسِين."<verse eid="LUK 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 9:15" />ݣِّين مَانَاينِّي، سْغِيمن-ثن مَارَّا. <verse eid="LUK 9:15" /><verse number="16" style="v" sid="LUK 9:16" />ئِكَّر يطّف خمْسَا نِّي ن ثْخبَّازِين ذ ثْنَاين نِّي ن يسڒْمَان، ئِيْسِي ثِيطَّاوِين نّس غَار وجنَّا أُوْشَا يشكَّر أَربِّـي. يرْزَا اَغْرُوْم نِّي يُوْشَا-اَسن-ث إِ يمحْضَارن نّس حمَا اَث فرْقن خ يِوْذَان نِّي مَارَّا. <verse eid="LUK 9:16" /><verse number="17" style="v" sid="LUK 9:17" />شِّين مَارَّا جِّيوْنن. سّنِّي يْسِين ثنْعَاش ن ثقْرَابِين عمَّارنْت س يڒقُّوْزن نِّي يشطّن.<verse eid="LUK 9:17" /></para>
  <para style="b" />
  <para style="s">بُطْرُس يتْشهَّاذ خ لْمَسِيح</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18" />ئِجّن ن نْهَار عِيْسَى يتْࢲَادْجَا وَاحْذس طَّارْف نّس يمحْضَارن نّس. ئِكَّر يسّقْسَا-ثن ينَّا-ٱسن: "مِين خَافِي قَّارن يِوْذَان؟"<verse eid="LUK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19" />أَرِّين خَاس نَّان-اَس: "ئِجّن يقَّار شك ذ يَحْيَى. ئِجّن يقَّار شك ذ إِلْيَاس. ئِجّن يقَّار شك زِي لْأَنْبِيَا يقْذِيمن إِي د يكَّرن زِي ڒْموْث."<verse eid="LUK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20" />ينَّا-ٱسن عِيْسَى: "ئِي كنِّيو، مِين ذَايِي د تَارَّام نش؟"</para>
  <para style="p" vid="LUK 9:20">ئِنْدق-د بُطْرُس ينَّا-ٱس: "شك ذ لْمَسِيح ن أَربِّـي."<verse eid="LUK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21" />عِيْسَى يأَكّد خَاسن يُوْمَر-يثن بَاش وَار تْخبَّارن حَدّ خ مَانَاينِّي.<verse eid="LUK 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 9:22" />ينَّا-ٱسن إِ يمحْضَارن نّس: "مِّيس ن بْنَاذم لَابُد اَذ يتْوَاعدّب خ وَاطَّاس ن ثْمسْڒَايِين، اَث عِيفّن يمقّْرَانن ن أَيث-إِسْرَائِيل ذ اَرُّوْيَاس ن ڒْفُقَهَا ذ يمْسڒْمَاذن ن شَّرِيعَا. أَث نْغن، وِيس ثڒْتِيَّام اَذ د يتْوَاسكَّر <char style="it">زِي ڒْموْث</char>."<verse eid="LUK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23" />ثُمَّا ينَّا-ٱسن إِ مَارَّا يوْذَان نِّي: "ونِّي يخْسن اَذَايِي يذْفَار نش، لَابُد اَذ يسْمح ذݣ يِيخف نّس، لَابُد كُڒ نْهَار اَذ يكسِّي صَّلِيب نّس <char style="it">مِينْخف غَا يعدّب</char> اَذَايِي يذْفَار. <verse eid="LUK 9:23" /><verse number="24" style="v" sid="LUK 9:24" />ڒَاحقَّاش ونِّي يرزُّوْن اَذ يسنْجم ثُوْذَارْث نّس اَتَاف اَث يخْسَر. ونِّي غَا يخْسَرن ثُوْذَارْث نّس خ سَّبَاب ينُو اَتَاف اَث يسنْجم. <verse eid="LUK 9:24" /><verse number="25" style="v" sid="LUK 9:25" />مِينْزِي غَا ينْفع بْنَاذم مڒَا يرْبح دُّنشْت-أَ قَاع وَا يخْسَر يخف نّس نِغ يضيّع يخف نّس؟ <verse eid="LUK 9:25" /><verse number="26" style="v" sid="LUK 9:26" />ونِّي خَافِي غَا يعفَّرن نش نِغ اَذ يعفَّر خ وَاوَاڒ ينُو، أَتَاف اَخَاس يعفَّر مِّيس ن بْنَاذم خْمِي د غَا يَاس س لْعَظَمَا نّس ذ لْعَظَمَا ن بَابَاس اَك لْمَلَائِكَاث يقدّْسن. <verse eid="LUK 9:26" /><verse number="27" style="v" sid="LUK 9:27" />أَقَا تسْڒَام ڒْحَقّ: ڒبْعَاض زݣ يِنِّي يدْجَان ذَا اَكِذِي وَار تْمتِّين شَا اَڒ غَا ࢲرن ڒْمُلْك ن أَربِّـي."<verse eid="LUK 9:27" /></para>
  <para style="s">سِيذْنَا مُوْسَى ذ سِيذْنَا إِلْيَاس تْمظْهَارن-د اَك سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28" />منْبَعْد إِ وَاوَاڒ نِّي شَان ثْمنْيَام يݣَعّذ عِيْسَى غَار وذْرَار حمَا اَذ يࢲَّادْج، يُوْوِي اَكِذس بُطْرُس ذ يُوْحَنَّا ذ يَعْقُوْب. <verse eid="LUK 9:28" /><verse number="29" style="v" sid="LUK 9:29" />وَامِي يࢲُّوْدْج، ئِبدّڒ وغمْبُوْب نّس يذْوڒ ذَايس نُّوْر، يذْوڒ وَارُّوْض نّس ذ اَشمْڒَاڒ يتْشعْشِيع. <verse eid="LUK 9:29" /><verse number="30" style="v" sid="LUK 9:30" />مظْهَارن-د ثْنَاين ن يرْيَازن سَّاوَاڒن اَكِذس يجّن ذ نَّبِي مُوْسَى يجّن ذ نَّبِي إِلْيَاس. <verse eid="LUK 9:30" /><verse number="31" style="v" sid="LUK 9:31" />مظْهَارن-د اَك عِيْسَى س يِجّن ن لْعَظَمَا ذ ثَمقّْرَانْت، بْذَان سَّاوَاڒن اَكِذس خ وُوْفُوْغ نّس إِي زِي غَا يفّغ ذغْيَا زِي لْقُدْس. <verse eid="LUK 9:31" /><verse number="32" style="v" sid="LUK 9:32" />وَلَكِن بُطْرُس ذ يِنِّي اَكِذس تطّْصن تْنُوْدُّوْمن س يِيضص، وَامِي فَاقن مْلِيح ثُمَّا ؤُفِين لْعَظَمَا ن عِيْسَى، أَكِذس ثْنَاين ن يرْيَازن بدّن.<verse eid="LUK 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 9:33" />وَامِي عَاذ ݣُّوْرن زَّايس يرْيَازن نِّي، ئِنْدق-د بُطْرُس ينَّا-ٱس إِ عِيْسَى: "آ سِيذِي، ذ اَصبْحَان اَكِذش نقِّيم ذَانِيتَا. نشِّين أَ نݣّ ثْڒَاثَا ن يقِيضَان، ئِجّن إِ شك، ئِجّن إِ مُوْسَى، ئِجّن إِ إِلْيَاس."</para>
  <para style="p" vid="LUK 9:33">بُطْرُس تُوْغَا يفَجَا، وَار يُوْفِي شَا مِين غَا يِينِي. <verse eid="LUK 9:33" /><verse number="34" style="v" sid="LUK 9:34" />وَامِي نتَّا تُوْغَاث عَاذ يسَّاوَاڒ يهْوَا-د خَاسن يج وسيْنُو<note caller="+" style="f"><char style="fr" closed="false">9‏.34 </char><char style="ft" closed="false">أَسيْنُو نتَّا ذ اَسݣْنُو.</char></note> يغطَّا-ثن ݣّْوْذن.<verse eid="LUK 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 9:35" />ثنْدق-د زَّايس يجّن ن ثْمِيجَّا زݣ وسيْنُو نِّي ثنَّا-ٱسن: "قَا ذ وَانِيتَا ذ مِّي إِي يخْضَرغ، صنّْطث غَارس."<verse eid="LUK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 9:36" />وَامِي صَافِي ثْمِيجَّا نِّي ثسِّيوڒ ؤُفِين عِيْسَى وَاحْذس. ئِمحْضَارن نِّي سْنُوْفَّرن مَانَاينِّي ذݣ وُوْڒ نْسن وَار خبَّرن حَدّ ذِي لْأَيَامَاث نِّي خ مِين ࢲْرِين.<verse eid="LUK 9:36" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا يجّن ن وحنْجِير ذَايس جّنّ</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37" />ثِيوشَّا نّس هْوَان-د زݣ وذْرَار، رحّْبن زَّايْسن ڒْغَاشِي اَطَّاس.<verse eid="LUK 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 9:38" />ئِڒَاغَا يجّن ن ورْيَاز زِي ڒْغَاشِي نِّي ينَّا: "آ لْمُعَلِّم، تتَّارغ زَّايش اَذ تخْزَرذ مِّي اَقَا ذ وَا وَاهَا إِي غَارِي. <verse eid="LUK 9:38" /><verse number="39" style="v" sid="LUK 9:39" />ممِّي يخطّف-يث يجّن ن جّنّ، ذغْيَا يسْنكَّر ثْغُوْيّث. جّنّ نِّي يسرْجِيجِي-ث اَڒ د غَا يسُوْفغ نتَّا كُوْفُّو زݣ وقمُّوْم نّس، وَار ذَاس يرخُّو حتَّا ٱڒ ث غَا يسَالَا. <verse eid="LUK 9:39" /><verse number="40" style="v" sid="LUK 9:40" />تَّارغ زݣ يمحْضَارن نّش اَزَّايس سُوْفْغن جّنّ-أَ وَلَكِن نِثْنِي وَار ذَاس زمَّرن شَا."<verse eid="LUK 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41" />يَارَّا خَاسن عِيْسَى ينَّا-ٱسن: "آ يوْذَان ن ڒْوقْث-أَ إِي ذِي وَار يدْجِي بُو لْإِيمَان، آ يِنِّي يفّْغن اَبْرِيذ! مشْحَاڒ إِي كِذْوم غَا قِّيمغ أُو مشْحَاڒ ذَاوم غَا صْبَرغ؟ أَوِي-يَايِي-د مِّيش ذَانِيتَا."<verse eid="LUK 9:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42" />وَامِي د يقَارّب وحنْجِير نِّي غَار عِيْسَى، ئِسرْجِيجِي-ث جّنّ نِّي يغْضڒ-يث غَار ثْمُورْث. ئِسْبدّ عِيْسَى جّنّ نِّي اَعفَّان، ئِسْݣنْفَا اَحنْجِير نِّي يَارِّي-ث إِ بَابَاس. <verse eid="LUK 9:42" /><verse number="43" style="v" sid="LUK 9:43" />قِّيمن يِوْذَان نِّي مَارَّا تْعجّْبن ذِي جّْهذ ن أَربِّـي.</para>
  <para style="p" vid="LUK 9:43">وَامِي تْعجّْبن مَارَّا ذِي قَاع مِين يݣَّا عِيْسَى، ئِكَّر نتَّا ينَّا-ٱسن إِ يمحْضَارن نّس: <verse eid="LUK 9:43" /><verse number="44" style="v" sid="LUK 9:44" />"صنّْطث مْلِيح إِ وَاوَاڒ-أَ إِي ذَاوم غَا ينِيغ: مِّيس ن بْنَاذم عْڒَاين اَذ يتْوَاسلّم غَار يفَاسّن ن يِوْذَان." <verse eid="LUK 9:44" /><verse number="45" style="v" sid="LUK 9:45" />وَلَكِن نِثْنِي وَار فهِيمن شَا إِ وَاوَاڒ نِّي، ئِقْسح خَاسن حمَا اَذ فهْمن، ݣّْوْذن اَث سّقْسَان خ مِين ذَاسن ينَّا.<verse eid="LUK 9:45" /></para>
  <para style="s">مَانْون إِݣ يدْجَان ذ اَمقّْرَان قَاع؟</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46" />تْمنْغَان يمحْضَارن اَك وَايَاوْيَا ؤُݣ يدْجَان ذ اَمقّْرَان زَّايْسن. <verse eid="LUK 9:46" /><verse number="47" style="v" sid="LUK 9:47" />عِيْسَى يسّن مِين غَارْسن ذݣ وُوْڒَاون نْسن. ئِسْقَارّب-د غَارس يج وحنْجِير ذ اَمزْيَان، ئِسْبدّ-يث زَّاثس. <verse eid="LUK 9:47" /><verse number="48" style="v" sid="LUK 9:48" />ينَّا-ٱسن: "ونِّي غَا يقبْڒن شَان وحنْجِير اَم وَانِيتَا عْلَاحْسَاب يسم ينُو، أَخْمِي ذ نش إِݣ يقْبڒ. ونِّي ذَايِي يقبّْڒن، أَتَاف يقْبڒ ونِّي ذَايِي د يسّكّن. مِينْزِي ونِّي يدْجَان زَّايْوم ذ اَمزْيَان قَاع، ذ نتَّا إِݣ يدْجَان ذ اَمقّْرَان."<verse eid="LUK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49" />ينَّا-ٱس يُوْحَنَّا: "آ لْمُعَلِّم، قَا نࢲْرَا يجّن يسُوْفُوْغ جْنُوْن عْلَاحْسَاب يسم نّش. نشِّين نرْزُو اَث نسْبدّ وَامِي وَار يدْجِي شَا ذ اَمحْضَار اَكِذْنغ."<verse eid="LUK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50" />ينَّا-ٱس عِيْسَى: "وَار ث سْبدَّام شَا. مِينْزِي يِنِّي وَار يدْجِين شَا ضد نْوم، أَقَاثن اَكِذْوم."<verse eid="LUK 9:50" /></para>
  <para style="s">ئِجّن ن دْشَار ذِي سَامَارْيَا وَار يقبّڒ شَا سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51" />عِيْسَى وَامِي د تُوْوض ڒْوقْث نّس إِي ذِي غَا يتْوَارْفع غَار وجنَّا، ئِكَّر يوجّه اَغمْبُوْب نّس بَاش اَذ يرَاح غَار ثنْدِينْت ن لْقُدْس. <verse eid="LUK 9:51" /><verse number="52" style="v" sid="LUK 9:52" />ئِسّكّ اَرُّسُل قْبڒ مَا ٱذ يرَاح نتَّا، رُوْحن نِثْنِي ؤُذْفن غَار يِجّن ن دْشَار ذِي ثْمُوْرْث ن أَيث-سَامَارْيَا حمَا اَذَاس سْوجْذن اَمْشَان. <verse eid="LUK 9:52" /><verse number="53" style="v" sid="LUK 9:53" />وَلَكِن يوْذَان ن دْشَار نِّي وَار ث قْبِيڒن شَا مِينْزِي سّْنن يتْرَاح إِلَّا غَار لْقُدْس.<verse eid="LUK 9:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 9:54" />ئِمحْضَارن نّس يَعْقُوْب ذ يُوْحَنَّا وَامِي ؤُفِين مَانَاينِّي نَّان-اَس إِ عِيْسَى: "آ سِيذِي، مَا ثخْسذ أَ نْڒَاغَا إِ ثْمسِّي اَذ تهْوَا زݣ وجنَّا حمَا اَثن ثشّ؟"<verse eid="LUK 9:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 9:55" />ئِنْدق-د عِيْسَى ينْهَا-ثن ينَّا-ٱسن لَّا. <verse eid="LUK 9:55" /><verse number="56" style="v" sid="LUK 9:56" />صَافِي كَّرن رُوْحن غَار يِجّن ن دْشَار نّغْنِي.<verse eid="LUK 9:56" /></para>
  <para style="s">يِنِّي يخْسن اَذ ذْفَارن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57" />وَامِي ݣُّوْرن خ وبْرِيذ، يُوْسَا-د يجّن ينَّا-ٱس إِ عِيْسَى: "نش اَش ذْفَارغ مَانِي مَا ثْرُوْحذ."<verse eid="LUK 9:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58" />ينَّا-ٱس عِيْسَى: "ؤُشَّانن غَارْسن يفْرَان نْسن، ئِجْضَاض غَارْسن ڒَعْوَاش نْسن، وَلَكِن مِّيس ن بْنَاذم وَار غَارس ؤُڒَا ذ مَانِي غَا يسُوْمّث اَزدْجِيف نّس."<verse eid="LUK 9:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59" />ينَّا-ٱس عِيْسَى إِ يِجّن نّغْنِي: "ذْفَار-اَيِي-د!"</para>
  <para style="p" vid="LUK 9:59">ينَّا-ٱس ونِّي: "آ سِيذِي، سَامح-اَيِي ذ اَمزْوَارُو اَذ رَاحغ اَذ نضْڒغ بَابَا."<verse eid="LUK 9:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60" />ينَّا-ٱس عِيْسَى: "يِنِّي يمُّوْثن اجّ-يثن اَذ نضْڒن يمتِّينن نْسن. شك اَرْوَاح اَذ تْبشَّرذ س ڒْمُلْك ن أَربِّـي."<verse eid="LUK 9:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61" />يُوْسَا-د يجّن نّغْنِي ينَّا-ٱس إِ عِيْسَى: "أَشك ذْفَارغ آ سِيذِي، وَلَكِن ذ اَمزْوَارُو اجّ-اَيِي اَذ مْسَافَاضغ خ فَامِلْيَا ينُو."<verse eid="LUK 9:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62" />ينَّا-ٱس عِيْسَى: "ونِّي يسرْسن فُوْس نّس خ وسْغَار عَاذ يخزَّار غَار ذفَّار اَتَاف وَار يصدْجح شَا اَذ يخْذم ذِي ڒْمُلْك ن أَربِّـي."<verse eid="LUK 9:62" /></para>
  <chapter eid="LUK 9" />
  <chapter number="10" style="c" sid="LUK 10" />
  <para style="s">سِيذِيثْنغ عِيْسَى يسّكّ ثْنَاين أُو سبْعِين اَذ بشَّرن</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1" />منْبَعْد إِ مَانَايَا يخْضَر سِيذِيثْنغ يجّن ثْنَاين أُو سبْعِين ن يمحْضَارن، ئِسّكّ-يثن ثْنَاين ثْنَاين يزْوَارن-اَس غَار كُڒ ثنْدِينْت ذ ومْشَان إِݣ يݣَّا نتَّا اَغَارْسن يرَاح.<verse eid="LUK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 10:2" />ينَّا-ٱسن إِ يمحْضَارن نّس: "ثَفدْجَاحْث اَطَّاس وَلَكِن ذْرُوْس يشوَّارن إِي غَا يخذْمن. تَّارث زِي بَاب ن ثْفدْجَاحْث اَذ يَرْنِي يشوَّارن ذݣ ومَرْجع نّس. <verse eid="LUK 10:2" /><verse number="3" style="v" sid="LUK 10:3" />رُوْحث، أَقَا سّكّغ-كنِّيو اَمشْنَاو يزْمَارن جَار وُوْشَّانن. <verse eid="LUK 10:3" /><verse number="4" style="v" sid="LUK 10:4" />وَار كِذْوم كسِّيم نِي ثَزعْبُوْڒْث، نِي اَقْرَاب، نِي ثِسِيڒَا. وَار تْسدْجَامم شَا خ ونِّي غَا ثَافم ذݣ وبْرِيذ. <verse eid="LUK 10:4" /><verse number="5" style="v" sid="LUK 10:5" />خْمِي غَا ثَاذْفم غَار شَا ن ثدَّارْث، إِنِيم ذ اَمزْوَارُو: سْڒَام خ ثدَّارْث-أَ. <verse eid="LUK 10:5" /><verse number="6" style="v" sid="LUK 10:6" />مڒَا يقْبڒ-كنِّيو بَاب ن ثدَّارْث نِّي، أَتَاف اَكِذس تِيڒِي لْبَرَكَا نْوم. مڒَا وَار كنِّيو يقْبِيڒ شَا، أَتَاف وَار كِذس تْغِيمِي شَا لْبَرَكَا نْوم. <verse eid="LUK 10:6" /><verse number="7" style="v" sid="LUK 10:7" />قِّيمم ذِي ثدَّارْث نِّي، شّم سْوم زِي مِين غَارْسن مِينْزِي ونِّي يتْبشَّارن غَارس ڒْحَقّ اَذ يتْخَاڒس. وَار تْرَاحم شَا زِي ثدَّارْث غَار ثدَّارْث. <verse eid="LUK 10:7" /><verse number="8" style="v" sid="LUK 10:8" />خْمِي غَا ثَاذْفم شَان ثنْدِينْت، مڒَا قبْڒن-كنِّيو أَيثْبَاب نّس، شّم س مِينْزِي ذَاوم غَا ؤُشن. <verse eid="LUK 10:8" /><verse number="9" style="v" sid="LUK 10:9" />سْݣنْفَام يمهْڒَاش نْسن إِنِيم-اَسن قَا ڒْمُلْك ن أَربِّـي يُوْذس-د غَارْوم.<verse eid="LUK 10:9" /></para>
  <para style="p">
    <verse number="10‏-11" style="v" sid="LUK 10:10-11" />مڒَا ثُوْذْفم غَار شَا ن ثنْدِينْت وَار كنِّيو قْبِيڒن شَا أَيثْبَاب نّس، فّْغم سّنِّي غَار يبْرِيذن نّس إِنِيم-اَسن قَا ؤُڒَا ذ ثَعجَّاشْت ن ثنْدِينْت نْوم ذَايْنغ يڒصْقن ذݣ يضَارن نّغ اَت نمْسح. وَلَكِن يتْخصَّا-كنِّيو اَذ تسّْنم بلِّي ڒْمُلْك ن أَربِّـي يُوْذس-د. <verse eid="LUK 10:10-11" /><verse number="12" style="v" sid="LUK 10:12" />أَذَاوم ينِيغ: ذِي يُوْم لْحِسَاب ذ لْعِقَاب اَذ يِيڒِي لْعِقَاب ن ثنْدِينْت نِّي كْتَار زِي لْعِقَاب ن ثنْدِينْت ثَعفَّانْت ن سَدُوْم.<verse eid="LUK 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13" />يَا ڒفْضِيحث نّش يَا أَبِيلَاج ن كُوْرَزِيم! يَا ڒفْضِيحث نّش يَا أَبِيلَاج ن بَيْت صَيْدَا! مَعْلِيك لْمُعْجِزَاث-أَ إِي ذَايْوم يوقْعن، وقْعنْت ذِي ثْندَّام ثِعفَّانِين ن صُوْر ذ صَيْدَا، أَتَاف أَيْثْبَاب نْسنْت تُوْبن مشْحَاڒ زݣ وَامِي، إِڒِي ݣِّين اَرُّوْض ن لْحُزن قِّيمن خ يِيغّذ<note caller="+" style="f"><char style="fr" closed="false">10‏.13 </char><char style="ft" closed="false">ئِغّذ قَّارن-ث إِ ثْنِيْفسْت.</char></note> حمَا اَذ د تْبَان تُوْبَا نْسن. <verse eid="LUK 10:13" /><verse number="14" style="v" sid="LUK 10:14" />أَقَا ثِندَّام <char style="it">ثِعفَّانِين</char> نِّي ن صُوْر ذ صَيْدَا اَذ يڒِينْت حْسن زَّايْوم ذِي يُوْم لْحِسَاب ذ لْعِقَاب. <verse eid="LUK 10:14" /><verse number="15" style="v" sid="LUK 10:15" />ئِي شك، آي اَبِيلَاج ن كَفرْنَاحُوْم! مَا تْغِير-اَش اَذ تْݣَعّْذذ غَار وجنَّا؟ لَّا، قَا شك اَذ تهْوِيذ غَار لْجَحِيم."<verse eid="LUK 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16" />ينَّا-ٱسن عِيْسَى إِ يمحْضَارن نّس: "ونِّي يتْسْڒَان إِ وَاوَاڒ نْوم، أَتَاف يتْسْڒَا-يَايِي إِ نش. ونِّي وَار كنِّيو يقْبِيڒن شَا، أَتَاف ؤُڒَا ذ نش وَار ذَايِي يقْبِيڒ شَا. ونِّي وَار ذَايِي يقْبِيڒن شَا نش، أَتَاف وَار يقْبِيڒ شَا ونِّي ذَايِي د يسّكّن."<verse eid="LUK 10:16" /></para>
  <para style="s">ثْنَاين أُو سبْعِين ن يمحْضَارن نِّي ذوّْڒن-د س ڒفْرَاحث</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17" />ذوْڒن-د ثْنَاين أُو سبْعِين نِّي ن يمحْضَارن فَرّْحن. نَّان-اَس إِ عِيْسَى: "آ سِيذِي، قَا ؤُڒَا ذ جْنُوْن تݣّن-اَنغ اَرَّاي عْلَاحْسَاب يسم نّش."<verse eid="LUK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18" />ينَّا-ٱسن عِيْسَى: "تُوْغَا تْوَاڒِيغ شِيطَان يوْضَا-د زݣ وجنَّا مَامش د يوطَّا ڒْبَرْق. <verse eid="LUK 10:18" /><verse number="19" style="v" sid="LUK 10:19" />أَقَا تِيشّغ-اَوم جّْهذ إِي زِي غَا ثْعفّْسم خ يفِيغرَان ذ ثْغِرْذمِيوِين ذ مَارَّا جّْهذ ن ڒَعْذُو، وَار كنِّيو يتْضَرِّي وَالُو. <verse eid="LUK 10:19" /><verse number="20" style="v" sid="LUK 10:20" />إِنَّمَا، وَار فَرّْحث شَا وَامِي جْنُوْن ذَاوم تݣّن اَرَّاي. لَّا، فَرْحث وَامِي يسمَاون نْوم ؤُرِين زمّن ذݣ وجنَّا."<verse eid="LUK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21" />ڒخْدّنِّي يفَرح عِيْسَى س أَرُّوْح يقدّْسن ينَّا: "حمْذغ-شك آ بَابَا آ سِيذِي أَربِّـي ن وجنَّا ذ ثْمُوْرْث ڒَاحقَّاش ثسْنُوْفَّرذ مَانَايَا خ يمِيغِيسن ذ لْعُلَامَا، ثْسظْهَارذ-ث-يد إِ يحنْجِيرن يمزْيَانن. وَاه آ بَابَا، ڒَاحقَّاش اَمُّو إِي خَاك يَارْضَا.<verse eid="LUK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22" />ئِمُّوْش-اَيِي كُڒْشِي زِي بَابَا. وَار يسِّين حَدّ مِين يعْنَا مِّيس منْغِير بَابَاس. وَار يسِّين حَدّ مِين يعْنَا بَابَاس منْغِير مِّيس. بَابَاس، أَث سّْنن غِير يِنِّي ؤُمِي يخس مِّيس اَذَاسن ثِيذ يسْمظْهَار."<verse eid="LUK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23" />ئِنقْڒب غَار يمحْضَارن نّس وَاحذْسن ينَّا-ٱسن: "سَّعْذ ن ثِيطَّاوِين نِّي يࢲْرِين مِين ثࢲْرِيم! <verse eid="LUK 10:23" /><verse number="24" style="v" sid="LUK 10:24" />مِينْزِي اَذَاوم ينِيغ: أَطَّاس ن لْأَنْبِيَا ذ يزدْجِيذن رْزُوْن اَذ ࢲرن مِين تْوَاڒَام، وَلَكِن وَار ث ࢲْرِين شَا. رْزُوْن اَذ سْڒن مِين ثسْڒَام، وَلَكِن وَار ث سْڒِين شَا."<verse eid="LUK 10:24" /></para>
  <para style="s">ڒْمِثَال ن يِج وثَرَّاس زِي أَيث-سَامَرْيَا يتݣّن ڒْخِير</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25" />يُوْسَا-د يجّن زݣ يِنِّي يتْشرَّاحن شَّرِيعَا يخس اَذ يجَرّب عِيْسَى ينَّا-ٱس: "آ لْمُعَلِّم، مِين غا ݣّغ حمَا اَغَارِي ثِيڒِي ثُوْذَارْث ن ڒبْدَا؟"<verse eid="LUK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26" />ينَّا-ٱس عِيْسَى: "مِين ثقَّار شَّرِيعَا؟ مِين ذَايس ثسّْنذ؟"<verse eid="LUK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27" />يَارَّا خَاس ونِّي ينَّا-ٱس: "ئِتْخصَّا-ٱش اَذ تخْسذ سِيذِي أَربِّـي نّش س مَارَّا ؤُڒ نّش ذ مَارَّا اَرُّوْح نّش ذ مَارَّا جّْهذ نّش ذ مَارَّا ڒَعْقڒ نّش. أَذ تخْسذ اَجَّار نّش اَمشْنَاو يخف نّش."<verse eid="LUK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28" />ينَّا-ٱس عِيْسَى: "غَارك ڒْحَقّ ذِي مِين ثنِّيذ. اݣّ زَّايس حمَا اَغَارش ثِيڒِي ثُوْذَارْث."<verse eid="LUK 10:28" /></para>
  <para style="b" />
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29" />وَلَكِن ونِّي يتْشرَّاحن شَّرِيعَا يرزُّو اَذ يُوْش ڒْحَقّ خ يِيخف نّس، ينَّا-ٱس إِ عِيْسَى: "مِين يعْنَا وَاجَّار ينُو؟"<verse eid="LUK 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30" />يَارَّا خَاس عِيْسَى ينَّا-ٱس: "ئِجّن ن بْنَاذم يهوَّا زِي ثنْدِينْت ن لْقُدْس يݣُّوْر غَار ثنْدِينْت ن أَرِيحَا. فّْغن-د اَكِذس يخوَّانن ذݣ وبْرِيذ كّْسن-اَس اَرُّوْض نّس، ؤُوْثِين-ث جِّين-ث جَار ثُوْذَارْث ذ ڒْموْث. <verse eid="LUK 10:30" /><verse number="31" style="v" sid="LUK 10:31" />يعْذُو سّنِّي يجّن ن ڒفْقِي ذݣ وبْرِيذ نِّي، ئِࢲْرِي-ث يَرْوڒ زَّايس. <verse eid="LUK 10:31" /><verse number="32" style="v" sid="LUK 10:32" />ڒخْدّنِّي يعْذُو-د سّنِّي يجّن زِي شُّرْفَا ن أَيْث-لَاوِي، عَاوذ يخْزَر ذَايس يَرْوڒ. <verse eid="LUK 10:32" /><verse number="33" style="v" sid="LUK 10:33" />وَلَكِن يج وثَرَّاس زِي ثْمُوْرْت ن أَيث-سَامَارْيَا يتْسَفَر يعْذُو-د سّنِّي، ئِࢲْرِي-ث يقّس-اَس. <verse eid="LUK 10:33" /><verse number="34" style="v" sid="LUK 10:34" />ئِقَارّب غَارس ييْسِي زّشْت ذ وَامَان ن وضِيڒ يذْهن-اَس س يجَارِيحن نّس يشّد-اَس-ثن. ڒخْدّنِّي يسْني-ث خ وغْيُوْڒ نّس، يُوْوِي-ث غَار يِجّن ن ثدَّارْث ن يمْسَافَرن يتْهلَّا ذَايس يݣَّا ذَايس ڒْخِير. <verse eid="LUK 10:34" /><verse number="35" style="v" sid="LUK 10:35" />ثِيوشَّا نّس ييْسِي-د ثْنَاين ن دِينَار يُوْشَا-اَس-ثن إِ بَاب ن ثدَّارْث ن يمْسَافَرن ينَّا-ٱس: تْهِلَا ذَايس، شْحَاڒ مَا خَاس ثْغَسْطَارذ نّغْنِي، أَتَاف نش خْمِي د غَا اَسغ اَذَاش ثن اَرّغ." <verse eid="LUK 10:35" /><verse number="36" style="v" sid="LUK 10:36" />ينَّا-ٱس عِيْسَى إِ ونِّي: "مِين تْوَاڒِيذ شك؟ مِين يعْنَا ونِّي زِي ثْڒَاثَا نِّي إِي غَا يِيڒِين ذ اَجَّار ن بْنَاذم نِّي إِي طّْفن يخوَّانن؟"<verse eid="LUK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37" />ينَّا-ٱس ونِّي يتْشرَّاحن شَّرِيعَا قَا ذ اَثَرَّاس نِّي إِي ذَايس يݣِّين ڒْخِير."</para>
  <para style="p" vid="LUK 10:37">ينَّا-ٱس عِيْسَى: "رُوْح، اݣّ مَانَاينِّي ؤُڒَا ذ شك."<verse eid="LUK 10:37" /></para>
  <para style="s">مَرْثَا ذ مَرْيَم</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38" />عِيْسَى ذ يمحْضَارن نّس ݣُّوْرن خ وبْرِيذ. يُوْذف غَار يِجّن ن دْشَار، ثْرحّب زَّايس يجّن ن ثمْغَارْث قَّارن-اَس مَرْثَا غَار ثدَّارْث نّس. <verse eid="LUK 10:38" /><verse number="39" style="v" sid="LUK 10:39" />أَكِذس يجّن ن وتْشْمَاس نتَّاث قَّارن-اَس مَرْيَم ثْرُوْح ثقِّيم غَار يضَارن ن سِيذِيثْنغ ثبْذَا تْصنَّاط إِ وَاوَاڒ نّس.<verse eid="LUK 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 10:40" />مَرْثَا ثنُّوْغ اَطَّاس ذِي شّْغڒ ن ثدَّارْث. ثُوْسَا-د ثنَّا-ٱس إِ عِيْسَى: "آ سِيذِي، مَا وَار ذَاش ثشْقِي شَا وتْشْمَا ثقِّيم وَاهَا ثجَّا-ٱيِي وَاحْذِي خدّْمغ شّْغڒ؟ إِنِي-يَاس اَذَايِي ثْعَاون بَعْذَا!"<verse eid="LUK 10:40" /></para>
  <para style="p">
    <verse number="41‏-42" style="v" sid="LUK 10:41-42" />ينَّا-ٱس سِيذِيثْنغ: "آ مَرْثَا آ مَرْثَا، بْنَاذم يتحْذَاجَا غِير يجّن ن ڒْحَاجث. شم ذَايم اَمْنُوْس تْخيَّاقذ خ وَاطَّاس ن ثْمسْڒَايِين، مَرْيَم ثِيخْضَر مِين يصبْحَان وَار ذَاس يتْوَاكّس شَا."<verse eid="LUK 10:41-42" /></para>
  <chapter eid="LUK 10" />
  <chapter number="11" style="c" sid="LUK 11" />
  <para style="s">سِيذِيثْنغ عِيْسَى يسڒْمَاذ يمحْضَارن نّس مَامْش غَا ࢲَّادْجن</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1" />ئِجّن ن وَاسّ عِيْسَى يتْࢲَادْجَا ذݣ يِجّن ن ومْشَان. وَامِي يكمّڒ ثْࢲَادْجِيث نِّي ينَّا-ٱس يجّن زݣ يمحْضَارن نّس: "آ سِيذِي، سڒْمذ-اَنغ أَ نࢲَّادْج مَامّش يسڒْمَاذ يَحْيَى يمحْضَارن نّس."<verse eid="LUK 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2" />ينَّا-ٱسن عِيْسَى: "مڒْمِي غَا ثࢲَّادْجم إِنِيم اَمُّو:</para>
  <para style="q1" vid="LUK 11:2">آ بَابَاثْنغ، ذ اَمقّْرَان إِݣ يدْجَا يِيسم نّش.</para>
  <para style="q2" vid="LUK 11:2">أَذ د يَاس ڒْمُلْك نّش.<verse eid="LUK 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3" />ؤُش-اَنغ كُڒ نْهَار اَغْرُوْم إِي غَا نحْذَاج.<verse eid="LUK 11:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="LUK 11:4" />غْفَر-اَنغ ڒْمُعْصِيَاث نّغ إِ نشِّين،</para>
  <para style="q1" vid="LUK 11:4">مَامّش نْسمّح إِ يِنِّي إِي كِذْنغ يخطَّان.</para>
  <para style="q2" vid="LUK 11:4">وَار ذَانغ تݣّ شَا ذِي ڒمْحَاين."<verse eid="LUK 11:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5‏-6" style="v" sid="LUK 11:5-6" />ينَّا-ٱسن عِيْسَى: "مَثَالَان يجّن زَّايْوم غَارس اَمدُّوْكڒ. ذِي ڒْوسْط ن دْجِيڒث يرُوْح غَار ومدُّوْكڒ نّس ينَّا-ٱس: آي اَمدُّوْكڒ، ؤُش-اَيِي ثْڒَاثَا ن وغْرُوْم مِينْزِي يجّن ن ومدُّوْكڒ ينُو يسَفَر يكَّا-د خَافِي، نش وَار غَارِي مِين ذَاس غَا ؤُشغ. <verse eid="LUK 11:5-6" /><verse number="7" style="v" sid="LUK 11:7" />أَخَاس يَارّ ومدُّوْكڒ نِّي نّس زِي ذَاخڒ ن ثدَّارْث اَذَاس يِينِي: وَار ذَايِي تسدَّاع شَا! نش ڒخُّو ثَوَّارْث ثْبلّع ثَارْوَا ينُو طّْسن اَكِذِي، وَار زمَّرغ شَا اَذ كَّرغ اَذَاش ؤُشغ." <verse eid="LUK 11:7" /><verse number="8" style="v" sid="LUK 11:8" />ينَّا-ٱسن عِيْسَى: "أَذَاوم ينِيغ: ذ اَمزْوَارُو يُوْݣِي اَذ يكَّر اَذَاس يُوْش مِين يرزُّو وَاخَّا نتَّا ذ اَمدُّوْكڒ نّس، وَلَكِن اَذ يكَّر اَذَاس يُوْش مَارَّا مِين يحْذَاج ڒَاحقَّاش <char style="it">يُوْسَا-د غَارس ذِي ڒْوسْط ن دْجِيڒث</char> يتْرزَّا-يَاس اَزدْجِيف."<verse eid="LUK 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9" />نش اَذَاوم ينِيغ: "تَّارم، أَتَاف اَذَاوم يمُّوْش. رزُّوْم، أَتَاف اَذ تَافم. سقرْقُوْبم، أَتَاف اَذَاوم رزْمن. <verse eid="LUK 11:9" /><verse number="10" style="v" sid="LUK 11:10" />مِينْزِي مَارَّا ونِّي غَا يتَّارن اَذَاس يمُّوْش. ونِّي غَا يرْزُوْن اَذ يَاف. ونِّي غَا يسْقرْقْبن اَذَاس ثْنُوْرْزم ثوَّارْث. <verse eid="LUK 11:10" /><verse number="11" style="v" sid="LUK 11:11" />مڒَا شَان يِجّن زَّايْوم يتَّار-اَس مِّيس اَسْڒم، مَا اَذَاس يُوْش فِيغر ذݣ ومْشَان ن وسْڒم نِّي؟ لَّا! <verse eid="LUK 11:11" /><verse number="12" style="v" sid="LUK 11:12" />مَا اَذَاس يُوْش بَابَاس ثْغِيرْذنْت إِ ممِّيس مڒَا يتَّار-اَس ثَمدْجَاڒْث؟ لَّا! <verse eid="LUK 11:12" /><verse number="13" style="v" sid="LUK 11:13" />مڒَا كنِّيو ذ يعفَّانن ثسّْنم اَذ تُوْشم إِ ثَارْوَا نْوم مِين يدْجَان ذ اَصبْحَان، أَتَاف بَابَاثْوم إِݣ يدْجَان ذݣ وجنَّا يتݣّ كْتَار، يعْنِي يتِيشّ أَرُّوْح يقدّْسن إِ يِنِّي ذَاس ث يتتَّارن."<verse eid="LUK 11:13" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتْوَاجَاه يِنِّي يدْجَان ضد نّس</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14" />ئِسُوْفغ عِيْسَى يجّن ن جّنّ ذ اَزينُوْن <char style="it">زݣ يِجّن ن ورْيَاز</char>. وَامِي يفّغ جّنّ نِّي يسِّيوڒ ورْيَاز، قِّيمن تْعجّْبن ڒْغَاشِي.<verse eid="LUK 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 11:15" />وَلَكِن ڒبْعَاض زَّايْسن نَّان: "بْنَاذم-أَ يسُوْفُوْغ جْنُوْن مِينْزِي اَرَّايس ن جْنُوْن ؤُمِي قَّارن بْعَلْزَبُوْل يُوشَا-اَس جّْهذ-أَ."<verse eid="LUK 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 11:16" />ئِنّغْنِي تتَّارن زَّايس يجّن ن لْعَلَامَا ذ ثَمقّْرَانْت زݣ وجنَّا بَاش اَث جَرّْبن.<verse eid="LUK 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 11:17" />ئِسّن عِيْسَى مِين نْوَان ينَّا-ٱسن: "مْكُڒ لْممْلَكَا إِي ذِي تْمنْغَان اَيثْبَاب نّس يجّن اَك ونّغْنِي اَذ تْنهْذم. مْكُڒ ثَدَّارْث إِي ذِي تْمنْغَان اَيثْبَاب نّس يجّن اَك ونّغْنِي اَذ توْضَا. <verse eid="LUK 11:17" /><verse number="18" style="v" sid="LUK 11:18" />مڒَا شِّيطَان يكَّا اَذ يقْضَا خ شِّيطَان، مَامّش غَا ثݣّ اَذ تقِّيم لْممْلَكَا نّس؟ مِينْزِي ثقَّارم سُوْفُوْغغ جْنُوْن س جّْهذ ن بَعْلْزَبُوْل. <verse eid="LUK 11:18" /><verse number="19" style="v" sid="LUK 11:19" />نش مڒَا سُوْفُوْغغ جْنُوْن س جّْهذ ن بَعْلْزَبُول نِّي زَعْمَا، إِنِيم-اَيِي كنِّيو، مَامّش تݣّن يِوْذَان نْوم سُوْفُوْغن-ثن ؤُڒَا ذ نِثْنِي؟ نِيثْنِي س يِيخف نْسن تْبيَّانن بلِّي كنِّيو وَار غَارْوم بُو ڒحَقّ ذي مين ثقَّارم. <verse eid="LUK 11:19" /><verse number="20" style="v" sid="LUK 11:20" />نش مڒَا سُوْفُوْغغ جْنُوْن س جّْهذ ن وفُوْس ن أَربِّـي، أَقَا ڒْمُلْك ن أَربِّـي يُوْسَا-د غَارْوم.<verse eid="LUK 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21" />أَرْيَاز يجهْذن ونِّي غَار يدْجَا ڒسْنَاح يحطَّا ثَدَّارْث نّس، أَتَاف اَݣْڒَا نّس يتِيڒِي ذِي ڒَامَان. <verse eid="LUK 11:21" /><verse number="22" style="v" sid="LUK 11:22" />وَلَكِن مڒَا يهْجم خَاس ونِّي خَاس يجهْذن، أَتَاف اَث يغْڒب اَذَاس يكّس مَارَّا ڒسْنَاح إِي خف يعوّڒ اَذَاس يَاوِي اَݣْڒَا نّس مَارَّا."<verse eid="LUK 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23" />ونِّي وَار كِذِي يدْجِين شَا، أَتَاف اَقَاث ضد ينُو. ونِّي وَار كِذِي يسْمُوْنن شَا، أَتَاف نتَّا يتْزدْجَاع.<verse eid="LUK 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24" />خْمِي غَا يتْوَاسُوْفغ جّنّ اَعفَّان زِي شَان بْنَاذم، أَتَاف اَذ يݣُّوْر ذݣ يمُوْشَان يُوْزْغن يرزُّو اَمْشَان مَانِي غَا يريّح. مڒَا وَار يُوْفِي شَا، أَتَاف اَذ يِينِي اَقَا نش اَذ رَاحغ اَذ ذوْڒغ غَار ثدَّارْث ينُو مَانِيس إِي فّْغغ. <verse eid="LUK 11:24" /><verse number="25" style="v" sid="LUK 11:25" />سّنِّي اَغَارس يذْوڒ اَت يَاف ثعْذڒ، ثنْقَا. <verse eid="LUK 11:25" /><verse number="26" style="v" sid="LUK 11:26" />أُوْشَا اَذ يرَاح اَذ د يَاوِي سبْعَا ن جْنُوْن نّغْنِي ذ يعفَّانن كْتَار زَّايس حمَا اَذ ذوْڒن كُڒْشِي اَذَايس زذْغن. أَتَاف اَذ تِيڒِي لْحَالَا ثَنݣَّرُوْت ن بْنَاذم نِّي ذ ثَعفَّانْت كْتَار زِي لْحَالَا نّس ثَمزْوَارُوْت."<verse eid="LUK 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27" />وَامِي تُوْغَا يسَّاوَاڒ خ مَانَايَا، ئِجّن ن ثمْغَارْث ثْڒَاغَا ذِي ڒْوسْط ن ڒْغَاشِي ثنَّا: "سَّعْذ ن ثمْغَارْث نِّي إِي شك د يُوْرْون، ثنِّي إِي ش يسُّوْطْضن."<verse eid="LUK 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28" />وَلَكِن نتَّا ينَّا: "لَّا، سَّعْذ ن يِنِّي يتْسْڒَان إِ وَاوَاڒ ن أَربِّـي، تْطَاعَان-اَس."<verse eid="LUK 11:28" /></para>
  <para style="s">يِنِّي يرزُّوْن لْعَلَامَا ثَمقّْرَانْت زِي سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29" />وَامِي تمْزَاحَامن ڒْغَاشِي، ئِبْذَا عِيْسَى يقَّار: "ئِوْذَان ن ڒْوقْث-أَ ذ يعفَّانن. نِثْنِي تتَّارن لْعَلَامَا ثَمقّْرَانْت وَلَكِن وَار ذَاسن تِيشّ إِلَّا ثنِّي ن نَّبِي يُوْنس. <verse eid="LUK 11:29" /><verse number="30" style="v" sid="LUK 11:30" />مَامّش تُوْغَا يدْجَا نَّبِي يُوْنس ذ يجّن ن لْعَلَامَا إِ اَيْثْبَاب ن ثنْدِينْت ن نِينْوَا، أَمنِّي عَاوذ اَذ يِيڒِي مِّيس ن بْنَاذم ذ يجّن ن لْعَلَمَا إِ يِوْذَان ن ڒْوقْث-أَ. <verse eid="LUK 11:30" /><verse number="31" style="v" sid="LUK 11:31" />يُوْم لْحِسَاب ذ لْعِقَاب اَذ تكَّر لْمَلِكَا ن لْجَنُوْب اَك يِوْذَان ن ڒْوقْث-أَ اَخَاسن ثْشثْشَا، ڒَاحقَّاش ثُوْسَا-د نتَّاث زِي ثْمُوْرْث يُوْݣْجن حمَا اَذ تْصنّط إِ ڒفْهَامث ن سُلِيمَان. أُو ذَانِيتَا يجّن ذ اَمقّْرَان زِي سُلِيمَان. <verse eid="LUK 11:31" /><verse number="32" style="v" sid="LUK 11:32" />يُوْم لْحِسَاب ذ لْعِقَاب اَذ د كَّرن يمزْذَاغ ن ثنْدِينْت ن نِينْوَا اَك يِوْذَان ن ڒْوقْث-أَ اَخَاسن شثْشَان، ڒَاحقَّاش اَيْثْبَاب ن ثنْدِينْت ن نِينْوَا تُوْبن وَامِي ثن ينْهَا نَّبِي يُونس. أُو ذَانِيتَا يجّن ذ اَمقّْرَان زِي يُوْنس!<verse eid="LUK 11:32" /></para>
  <para style="s">ثْفَاوْث ن دَّات نتَّاث ذ ثِيطَّاوِين</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33" />ؤُڒَا ذ يجّن وَار يتْشَعِّيڒ ڒْقنْدِيڒ حمَا اَث يسرْس ذݣ يِج ومْشَان ينُوْفَّر نِغ اَخَاس يقْڒب اَقْنُوْش. لَّا، ئِتݣّ-يث خ ڒْمَرْفَاع حمَا اَذَاسن يُوْش ثْفَاوْث إِ يِنِّي إِي د غَا يَاذْفن. <verse eid="LUK 11:33" /><verse number="34" style="v" sid="LUK 11:34" />ثِيطّ نّش نتَّاث ذ ثْفَاوْث إِ ثُوْذَارْث نّش. مڒَا غَارك ثِيطَّاوِين صحَّانْت، أَتَاف اَغَارك ثِيڒِي ثْفَاوْث مَارَّا ذِي ثُوْذَارْث نّش. مڒَا ثِيطَّاوِين نّش وَار دْجِينْت شَا مْلِيح، أَتَاف اَذ تِيڒِي مَارَّا ثُوْذَارْث نّش ذ ثَادْجسْت. <verse eid="LUK 11:34" /><verse number="35" style="v" sid="LUK 11:35" />حْضَا يخف نّش مْلِيح حمَا نُّوْر إِي ذَايك وَار يتْذوِّيڒ شَا ذ ثَادْجسْث. <verse eid="LUK 11:35" /><verse number="36" style="v" sid="LUK 11:36" />مڒَا مَارَّا دَّات نّش ذَايس ثْفَاوْث وَار ذَايس بُو ثَادْجسْث، أَتَاف اَذ تْشعْشع اَطَّاس اَذ تݣّ ثْفَاوْث اَمشْنَاو مَامّش ذَاوم يتِيشّ ڒْقنْدِيڒ ثْفَاوْث."<verse eid="LUK 11:36" /></para>
  <para style="s">ڒفْضِيحَاث ن ڒْحِزب ن يفَرِّيسِيْين ذ يمْسڒْمَاذن ن شَّرِيعَا</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37" />وَامِي يسِّيوڒ عِيْسَى، يُوْسَا-د يجّن زِي ڒْحِزب ن يفَرِّيسِيْين يعَرض-يث حمَا اَكِذس يشّ. يُوْذف عِيْسَى يقِّيم غَار مِيسَّا، <verse eid="LUK 11:37" /><verse number="38" style="v" sid="LUK 11:38" />أَفَرِّيسِي نِّي يتْعجّب وَامِي يُوْفَا عِيْسَى وَار يسِيرذ شَا يفَاسّن نّس قْبڒ مَا ٱذ يشّ.<verse eid="LUK 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 11:39" />ينَّا-ٱس سِيذِيثْنغ: "كنِّيو يفَرِّيسِيْين ثْسِيرِيذم ڒْكَاس نْوم ذ طّبْسِي نْوم غَار بَارَّا مْلِيح، وَلَكِن غَار ذَاخڒ نْوم ثشُّوْرم س طّْمَع ذ شَّرّْ. <verse eid="LUK 11:39" /><verse number="40" style="v" sid="LUK 11:40" />آ يِنِّي وَار يفهّْمن! أَربِّـي ذ نتَّا إِݣ يݣِّين دَّات، ذ نتَّا عَاوذ إِݣ يݣِّين مِين ذَايس غَار ذَاخڒ. <verse eid="LUK 11:40" /><verse number="41" style="v" sid="LUK 11:41" />صدّْقم مِين ذَايْوم غَار ذَاخڒ، أَتَاف مَارَّا اَذ يذْوڒ يسِيرذ إِ كنِّيو.<verse eid="LUK 11:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42" />يَا ڒفْضِيحث نْوم آ ڒْحِزب ن يفَرِّيسِيْين! تِيشّم ڒَعْشُوْر ؤُڒَا خ نَعْنَاع ذ ؤُوْرَام<note caller="+" style="f"><char style="fr" closed="false">11‏.42 </char><char style="ft" closed="false">أَوْرَام نتَّا ذ يجّن ن نُّوع ن ڒَاعْشُوْب.</char></note> ذ مَارَّا ڒَاعْشُوْب، وَلَكِن وَار تهْتِيمِيم شَا زِي ڒْحَقّ ذ ڒمْحِبّث ن أَربِّـي. لَّا، ئِخصَّا-ٱوم اَذ تهْتَامم س مَانَايَا بْڒَا مَا تتُّوْم ڒَعْشُوْر.<verse eid="LUK 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43" />يَا ڒفْضِيحث نْوم آ ڒْحِزب ن يفَرِّيسِيْين! مِينْزِي تخْسم يمُوْشَان يمزْوُوْرَا ذِي ثمْزِيذَاوِين، ئِتعْجِيب-اَوم اَخَاوم سدْجْمن يِوْذَان ذِي ڒسْوَاق. <verse eid="LUK 11:43" /><verse number="44" style="v" sid="LUK 11:44" />يَا ڒفْضِيحث نْوم، كنِّيو اَمشْنَاو يمضْڒَان يودَّارن ݣُّوْرن خَاسن يِوْذَان وَار د اَرِّين شَا ڒخْبَار."<verse eid="LUK 11:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45" />ئِنْدق-د يجّن زݣ يِنِّي يتْشرَّاحن شَّرِيعَا ينَّا-ٱس: "آ لْمُعَلِّم، وَامِي ثقَّارذ مَانَايَا اَقَا ؤُڒَا ذ نشِّين تْحݣَّارذ-اَنغ!"<verse eid="LUK 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46" />يَارَّا خَاس عِيْسَى ينَّا: "يَا ڒفْضِيحث نْوم ؤُڒَا ذ كنِّيو آ يِنِّي يتْشرَّاحن شَّرِيعَا مِينْزِي تْشدَّام ڒحْمڒ يذقْڒن يقسْحن خ يِوْذَان حمَا اَث اَرْبُوْن، وَلَكِن كنِّيو وَار تْحِيذِيم بُو ڒحْمڒ نِّي ؤُڒَا س يِجّن ن وضَاض نْوم. <verse eid="LUK 11:46" /><verse number="47" style="v" sid="LUK 11:47" />يَا ڒفْضِيحث نْوم مِينْزِي كنِّيو ثْبنَّام يمضْڒَان ن لْأَنْبِيَا تَارِّيم-ثن ذ يمْرَابْذن أُو كنِّيو ڒجْذُوْذ نْوم ذ نِثْنِي إِي ثن ينْغِين. <verse eid="LUK 11:47" /><verse number="48" style="v" sid="LUK 11:48" />تَافَاقم اَك ڒجْذُوْذ نْوم، كنِّيو ذ ڒشْهُوْذ خ مِين خذْمن مِينْزِي ذ نِثْنِي إِݣ ينْغِين لْأَنْبِيَا أُو كنِّيو ثْبنَّام يمْرَابذن نْسن. <verse eid="LUK 11:48" /><verse number="49" style="v" sid="LUK 11:49" />خ مَانَايَا عَاوذ ثقَّار لْحِكْمَا ن أَربِّـي اَذَاسن سّكّغ لْأَنْبِيَا ذ اَرُّسُل، ئِجّن اَث نْغن يجّن اَخَاس اَزّْڒن. <verse eid="LUK 11:49" /><verse number="50" style="v" sid="LUK 11:50" />حمَا يوْذَان ن ڒْوقْث-أَ اَذ تْوَاعَاقْبن خ مَارَّا يذَامّن إِي يُوْزّْڒن زِي لْأَنْبِيَا زݣ وَامِي ثدْجَا دُّنشْت-أَ. <verse eid="LUK 11:50" /><verse number="51" style="v" sid="LUK 11:51" />زݣ يذَامّن ن هَابِيل اَڒ يذَامّن ن زَكَرِيَا ونِّي ينْغِين جَار ڒْمذْبَح ذ ثمْزِيذَا ثَمقّْرَانْت. وَاه، أَذَاوم ينِيغ: مَارَّا لْعِقَاب خ مَانَاينِّي ذ يوْذَان ن ڒْوقْث-أَ إِي خَاس غَا يتْوَاحَاسْبن! <verse eid="LUK 11:51" /><verse number="52" style="v" sid="LUK 11:52" />يَا ڒفْضِيحث نْوم آ يِنِّي يتْشرَّاحن شَّرِيعَا! ثطّْفم ڒْمفْتَاح ن ڒفْهَامث، كنِّيو وَار تِذْفم شَا ذَايس وَار تجِّيم وِي غَا يَاذْفن."<verse eid="LUK 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53" />وَامِي سّنِّي يفّغ، بْذَان يمْسڒْمَاذن ن شَّرِيعَا ذ ڒْحِزب ن يفَرِّيسِيْين تْاعَرَّاضن-ث كْتَار، تْسدَّاعن-ث خ وَاطَّاس ن ثْمسْڒَايِين. <verse eid="LUK 11:53" /><verse number="54" style="v" sid="LUK 11:54" />حطَّان-ث حمَا اَذ يِينِي شَان وَاوَاڒ اَث طّْفن زَّايس.<verse eid="LUK 11:54" /></para>
  <chapter eid="LUK 11" />
  <chapter number="12" style="c" sid="LUK 12" />
  <para style="s">ثِيݣّْوْذِي زِي أَربِّـي</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1" />ڒخدّْنِّي مُوْنن اَطَّاس ن ؤُڒُوْفَاث ن يِوذَان اَڒ وَامِي ذوْڒن عفّْسن خ وَايَاوْيَا. ئِبْذَا عِيْسَى يقَّار-اَسن إِ يمحْضَارن نّس: "حْضَام يخف نْوم زِي نِّفَاق ن ڒْحِزب ن يفَرِّيسِيْين يدْجَان اَم ونْتُوْن.<note caller="+" style="f"><char style="fr" closed="false">12‏.1 </char><char style="ft" closed="false">أَنْتُون نتَّا اَمْثُوْن.</char></note> <verse eid="LUK 12:1" /><verse number="2" style="v" sid="LUK 12:2" />مَارَّا مِين يتْوَاسْنُوْفَّرن اَذ ينفْضح. مَارَّا مِين ينُوْفَّرن اَذ يتْوَاسّن. <verse eid="LUK 12:2" /><verse number="3" style="v" sid="LUK 12:3" />خ مَانَايَا، مَارَّا مِين ثقَّارم ذِي ثَادْجسْت اَذَاس تسْڒَان س ؤُزِيڒ. مَارَّا مِين ثقَّارم س ڒْحسّ غَار ذَاخڒ إِ يخَامّن، أَزَّايس تْعيَّاضن خ ثْزقَّا.<verse eid="LUK 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4" />أَذَاوم ينِيغ آي يمدُّوْكَاڒ ينُو: وَار تݣّْوْذم شَا زِي يِنِّي ينقّن دَّات وَاهَا وَار غَارْسن مِين غَا ݣّن كْتَار زِي مَانَاينِّي. <verse eid="LUK 12:4" /><verse number="5" style="v" sid="LUK 12:5" />لَّا، أَذَاوم ينِيغ وِي زِي غَا ثݣّْوْذم: ݣّْوْذث زِي ونِّي إِي غَا ينْغن دَّات نْوم منْبَعْد اَغَارس يِيڒِي جّْهذ بَاش اَذ يݣّ كْتَار، أَت ينْضَر ذِي جَهنَّمَا. وَاه، قَّارغ-اَوم: ونِّي ݣّْوْذم-ث. <verse eid="LUK 12:5" /><verse number="6" style="v" sid="LUK 12:6" />مَا وَار تْمنْزِين خمْسَا ن يزَاوْجِيون س ثْنَاين ن دُوْرُو؟ وَلَكِن أَربِّـي وَار يتتُّو ؤُڒَا ذ يجّن زَّايْسن. <verse eid="LUK 12:6" /><verse number="7" style="v" sid="LUK 12:7" />ؤُڒَا ذ يزُوْطَّان إِي غَارْوم خ وزدْجِيف نْوم يحْسب-يثن أَربِّـي مَارَّا. وَار تݣّْوْذم شَا. كنِّيو ثْسݣّْوَام كْتَار س وَاطَّاس خ يزَاوْجِيون.<verse eid="LUK 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8" />أَذَاوم ينِيغ: ونِّي زَّايِي غَا يشهْذن نش زَّاث إِ يِوْذَان، أَتَاف اَزَّايس <char style="it">شهْذغ نش</char> مِّيس ن بْنَاذم زَّاث إِ لْمَلَائِكَاث ن أَربِّـي. <verse eid="LUK 12:8" /><verse number="9" style="v" sid="LUK 12:9" />ونِّي ذَايِي غَا ينْكَرن زَّاث إِ يِوْذَان، أَتَاف اَذ يتْوَانْكَر زَّاث إِ لْمَلَائِكَاث ن أَربِّـي. <verse eid="LUK 12:9" /><verse number="10" style="v" sid="LUK 12:10" />ونِّي غَا يِينِين شَان وَاوَاڒ وَار يحْڒِين خ مِّيس ن بْنَاذم اَتَاف اَخَاس يغْفَر. ونِّي غَا يِينِين شَان وَاوَاڒ وَار يحْڒِين خ أَرُّوْح يقدّْسن اَتَاف وَار خَاس يغفَّر شَا عمَّارْص.<verse eid="LUK 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11" />أَخْمِي كنِّيو غَا اَوِين غَار ثمْزِيذَاوِين ن أَيث-إِسْرَائِيل نِغ ذ لْحُكَّام ذ يمْخَازْنِيْين، بْڒَا مَا ٱذ تيْسِيم اَمْنُوْس ذِي ڒَعْقُوْڒَاث نْوم مِينْزِي غَا ثْدَافْعم خ يِيخف نْوم نِغ ذ مِين غَا ثِينِيم. <verse eid="LUK 12:11" /><verse number="12" style="v" sid="LUK 12:12" />مِينْزِي أَرُّوْح يقدّْسن اَذَاوم يُوْش مِين غَا ثِينِيم ذِي ثْسَعَّات نِّي."<verse eid="LUK 12:12" /></para>
  <para style="s">ڒْمَعْنَا ن تَّاجَر نتَّا ذ اَفْغُوْڒ</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13" />ينَّا-ٱس يجّن ن ورْيَاز زِي ڒْغَاشِي نِّي: "آ لْمُعَلِّم، إِن-اَس إِ وُوْمَا اَكِذِي يفْرق ڒْوَارْث."<verse eid="LUK 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14" />ينَّا-ٱس عِيْسَى: "آ بْنَاذم، وِي ذَايِي يݣِّين جَارَاوم ذ ڒْقَاضِي نِغ ذ ونِّي يفرْقن ڒْوَارْث؟" <verse eid="LUK 12:14" /><verse number="15" style="v" sid="LUK 12:15" />ينَّا-ٱسن: "حْضَام يخف نْوم، بعّْذث خ طّْمَع مِينْزِي ثُوْذَارْث ن بْنَاذم وَار تِيڒِي شَا س وَاطَّاس ن وَاݣْڒَا."<verse eid="LUK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16" />ئِسِّيوڒ اَكِذْسن س يِجّن ن ڒْمَعْنَا ينَّا-ٱسن: "ئِجّن ن بْنَاذم ذ تَّاجَر ثَمُوْرْث نّس ثُوْرو-اَس اَطَّاس. <verse eid="LUK 12:16" /><verse number="17" style="v" sid="LUK 12:17" />ينَّا ذِي نّفْس نّس: وَار ؤُفِيغ بُو اَمْشَان مَانِي غَا خمّْڒغ ثَفدْجَاحْث-أَ، مِين غَا ݣّغ؟ <verse eid="LUK 12:17" /><verse number="18" style="v" sid="LUK 12:18" />ينَّا: أَذ هذْمغ يخزَّانن ينُو، أَذ بنِيغ ينّغْنِي ذ جْذِيذ ذ يمقّْرَانن خَاسن، أَذَايْسن خمّْڒغ مَارَّا ثَفدْجَاحْث ذ اَرْزق ينُو. <verse eid="LUK 12:18" /><verse number="19" style="v" sid="LUK 12:19" />أَذ ينِيغ إِ يِيخف ينُو: صَافِي، غَارِي اَطَّاس ن ڒْخِير إِي ذَايِي غَا يقِيدّن إِ وَاطَّاس ن يسݣّْوُسَا، أَذ قِّيمغ وَاهَا اَذ شّغ اَذ سْوغ اَذ فَرْحغ! <verse eid="LUK 12:19" /><verse number="20" style="v" sid="LUK 12:20" />وَلَكِن ينَّا-ٱس أَربِّـي: آي اَفْغُوْڒ! ؤُمِي ثْسوْجَاذذ مَانَايَا؟ ذِي دْجِيڒث-أَ ثَانِيتَا اَذ يتْوَافّغ بُوحْبڒ نّش. <verse eid="LUK 12:20" /><verse number="21" style="v" sid="LUK 12:21" />أَمنِّي إِي غَا يِيڒِي ونِّي يجمّْعن اَݣْڒَا إِ يِيخف نّس وَاهَا وَار يجمّع شَا إِ أَربِّـي."<verse eid="LUK 12:21" /></para>
  <para style="s">وَار كسِّيم بُو س ومْنُوْس</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22" />ينَّا-ٱسن عِيْسَى إِ يمحْضَارن نّس: "خ مَانَايَا اَذَاوم ينِيغ: وَار كسِّيم شَا س ومْنُوْس إِ ثُوْذَارْث نْوم عْلَاحْسَاب مِين غَا ثشّم نِغ ذ اَرُّوْض إِي غَا ثحْذَاجم إِ دَّات نْوم. <verse eid="LUK 12:22" /><verse number="23" style="v" sid="LUK 12:23" />مِينْزِي ثُوْذَارْث-أَ تْسݣّْوَا كْتَار زِي مَشَّا. دَّات-أَ تْسݣّْوَا كْتَار زݣ وَارُّوْض. <verse eid="LUK 12:23" /><verse number="24" style="v" sid="LUK 12:24" />خْزَارم غَار يبَاغرِيون. وَار زرّْعن، وَار مجَّارن. وَار غَارْسن ثِسْرَافِين ؤُڒَا ذ مَانِي غَا خزّْنن. ذ أَربِّـي إِي ذَاسن يتِيشّن اَذ شّن. كنِّيو، مَا وَار تْسݣّْوِيم شَا اَطَّاس س وَاطَّاس خ يِيجْضَاض؟ <verse eid="LUK 12:24" /><verse number="25" style="v" sid="LUK 12:25" />ؤُݣ يزمَّرن زَّايْوم أَذ يَرْنِي س ومْنُوْس نّس غِير ثْسَعَّات وَاهَا ذِي ڒْعُمُوْر نّس؟ <verse eid="LUK 12:25" /><verse number="26" style="v" sid="LUK 12:26" />مڒَا وَار ثْزمَّرم شَا ؤُڒَا إِ مِين يدْجَان ذ اَمزْيَان، مَايمِّي ثْكسِّيم اَمْنُوْس إِ شَا ن ڒْحَاجث نّغْنِي؟<verse eid="LUK 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 12:27" />خْزَرث ذِي نْوَار ن ڒخْڒَا مَامّش يݣَّا، وَار يَربّڒ وَار يتْخيِّيض. قَّارغ-اَوم نش: ؤُڒَا ذ اَزدْجِيذ سُلِيمَان، مشْحَاڒ غَارس ذ اَݣْڒَا وَار يزمَّر شَا اَذ يَرض شَا ن وَارُّوْض يݣَّا اَم نْوَار-أَ وَانِيتَا. <verse eid="LUK 12:27" /><verse number="28" style="v" sid="LUK 12:28" />مڒَا أَربِّـي يتِيشّ اَرُّوْض زَعْمَا إِ اَرْبِيع ن ڒخْڒَا إِݣ يدْجَان نْهَارَا اَذ يحرق ثِيوشَّا ذݣ وفَارَّان، مَا وَار يتݣّ اَكِذْوم كنِّيو كْتار؟ ذَايْوم لإِيمَان نْوم ذ ؤُقْلِيل. <verse eid="LUK 12:28" /><verse number="29" style="v" sid="LUK 12:29" />وَار رزُّوْث شَا مِين غَا ثشّم نِغ ذ مِين غَا ثسْوم، وَار كسِّيث بُو س ومْنُوْس. <verse eid="LUK 12:29" /><verse number="30" style="v" sid="LUK 12:30" />مَارَّا مَانَايَا رزُّوْن-ث ڒݣْنُوْس ن دُّنشْت-أَ، كنِّيو بَابَاثْوم يسّن بلِّي تحْذَاجِيم ثِمسْڒَايِين-أَ. <verse eid="LUK 12:30" /><verse number="31" style="v" sid="LUK 12:31" />رزُّوث كنِّيو خ ڒْمُلْك ن أَربِّـي، سّنِّي ثِمسْڒَايِين-أَ اَذَاوم مَارْنِينْت. <verse eid="LUK 12:31" /><verse number="32" style="v" sid="LUK 12:32" />وَار تݣّْوْذم شَا آ ثْحِيمرْث ينُو ثَمزْيَانْت، يرْضَا بَابَاثْوم اَذَاوم يُوْش ڒْمُلْك نّس.<verse eid="LUK 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 12:33" />زنْزث اَݣْڒَا نْوم، صدّْقم-ث. ݣّث ثِشمُّوْسِين ن تْمنْيَاث إِي وَار يفنِّين شَا نِثنْتِي ذ يجّن ن ڒْكنْز ذݣ وجنَّا وَار يقطِّين شَا. وَار يتْقَارِّيب شَا ذِنِّي وشفَّار، ثِكشَّاوِين وَار ث تتّنْت شَا. <verse eid="LUK 12:33" /><verse number="34" style="v" sid="LUK 12:34" />أَقَا مَانِي يدْجَا ڒْكنْز نْوم، ذِنِّي إِي غَا يِيڒِي وُوْڒ نْوم.<verse eid="LUK 12:34" /></para>
  <para style="s">إِڒِيم ثوْجْذم خْمِي د غَا يذْوڒ سِيذِيثْنغ</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35" />إِڒِيم ثوْجْذم ݣفّْضم، أَذ يڒِين ڒقْنَاذڒ نْوم شَعّْڒن. <verse eid="LUK 12:35" /><verse number="36" style="v" sid="LUK 12:36" />إِڒِيم ثْوجْذم اَم يوْذَان إِي تْرَاجَان سِيذِيثْسن اَذ د يذْوڒ زِي ڒْفَارْح، أَذ د يَاس اَذ يسْقرْقب اَذَاس رزْمن ذغْيَا. <verse eid="LUK 12:36" /><verse number="37" style="v" sid="LUK 12:37" />سَّعْذ ن يخدَّامن نِّي مڒَا يُوْسَا-د سِيذِيثْسن يُوْفِي-ثن عَاذ وَار طِّيصن شَا. أَقَا تسْڒَام ڒْحَقّ: أَذ يݣفّض سِيذِيثْسن اَثن يسْغِيم، أَذ يبْذَا يتْسخَّار خَاسن. <verse eid="LUK 12:37" /><verse number="38" style="v" sid="LUK 12:38" />مڒَا يُوْسَا-د يُوْفِي-ثن عَاذ وَار طِّيصن شَا وَاخَّا ذِي ڒْوسْط ن دْجِيڒث نِغ قْبڒ إِ ڒفْجَر، أَتَاف سَّعْذ ن يخدَّامن نِّي. <verse eid="LUK 12:38" /><verse number="39" style="v" sid="LUK 12:39" />ئِتْخصَّا-اَوم اَذ تسّْنم مَانَايَا: مْڒِي بَاب ن ثدَّارْث يسّن ثْسَعَّات إِي ذِي د غَا يَاس وشفَّار، إِڒِي وَار ث يتِيجِّي شَا اَذ د يَاذف ثَدَّارْث نّس. <verse eid="LUK 12:39" /><verse number="40" style="v" sid="LUK 12:40" />سْوجْذم يخف نْوم مِينْزِي مِّيس ن بْنَاذم اَذ د يَاس ذݣ يِجّن ن ثْسَعَّات وَار ث تْرِيجِيم شَا."<verse eid="LUK 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41" />ئِنْدق-د بُطْرُس ينَّا-ٱس: "آ سِيذِي، ڒْمَعْنَا-يَا مَا ثقَّارذ-ث غِير إِ نشِّين مَا إِ مَارَّا يوْذَان؟"<verse eid="LUK 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42" />يَارَّا خَاس سِيذِيثْنغ ينَّا-ٱس: "إِيوَا مِين يعْنَا ؤُوقَّاف نِّي يدْجَان ذ اَمِيغِيس ذَايس ڒَامَان؟ نتَّا ذ ونِّي إِݣ يتْكلَّاف سِيذس اَذَاسن يُوْش لْمَكْلَا إِ يخدَّامن نّس ذِي ڒْوقْث نِيشَان. <verse eid="LUK 12:42" /><verse number="43" style="v" sid="LUK 12:43" />سَّعْذ ن ؤُوقَّاف نِّي خْمِي د غَا يذْوڒ سِيذس اَث يَاف يخدّم. <verse eid="LUK 12:43" /><verse number="44" style="v" sid="LUK 12:44" />أَقَا تسْڒَام ڒْحَقّ: أَث يكلّف سِيذس خ مَارَّا اَݣْڒَا نّس. <verse eid="LUK 12:44" /><verse number="45" style="v" sid="LUK 12:45" />وَلَكِن اَوقَّاف نِّي مڒَا ينوَّا ذݣ يِيخف نّس يقَّار: سِيذِي يتْعطَّاڒ اَطَّاس وَار د يتِيس شَا، ثُمَّا اَذ يبْذَا يشَّاث يخدَّامن ذ ثْخدَّامِين يتتّ يسسّ اَقَاث اَك يسْكَايْرِيْين وَاهَا، <verse eid="LUK 12:45" /><verse number="46" style="v" sid="LUK 12:46" />أَتَاف اَذ د يَاس سِيذس ن ؤُوقَّاف نِّي ذݣ يِجّن ن نْهَار وَار ث ينوِّي شَا، ذݣ يِجّن ن ثْسَعَّات وَار ت يسِّين شَا. أَث يقسّ ذ يوزْوِيزن، أَث ينْضَر ذݣ ومْشَان نِّي ن يِنِّي إِي ذِي وَار يدْجِي شَا لإِيمَان.<verse eid="LUK 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47" />أَوقَّاف نِّي نتَّا يسّن مِين يرزُّو سِيذس وَلَكِن وَار يسوْجِيذ شَا إِ سِيذس وَار يتݣّ شَا مِين يرزُّو سِيذس، أَتَاف اَذ يتْوَاعَاقب اَطَّاس. <verse eid="LUK 12:47" /><verse number="48" style="v" sid="LUK 12:48" />ونِّي وَار يسِّينن شَا مِين يرزُّو سِيذس يتݣّ ثِمسْڒَايِين يسْذَاهْدْجن اَعْمُوْذ، أَتَاف اَذ يتْوَاعَقب ذْرُوْس وَاهَا. مَارَّا ونِّي ؤُمي يمُّوْش اَطَّاس، أَزَّايس رْزُوْن اَطَّاس. ونِّي إِݣ يتْوَاكلّْفن خ وَاطَّاس، أَزَّايس رْزُوْن اَطَّاس.<verse eid="LUK 12:48" /></para>
  <para style="s">ئِوْذَان اَذ منْغن خ سَّبَاب ن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49" />ؤُسِيغ-د اَذ نْضَرغ يجّن ن ثْمسِّي يشمّْضن خ ثْمُوْرْث، أُو مشْحَاڒ تْمنِّيغ اَت اَفغ ڒخُّو ثْشعّڒ! <verse eid="LUK 12:49" /><verse number="50" style="v" sid="LUK 12:50" />ئِتْخصَّا-ٱيِي اَذ تْوَاعَدّْبغ، خيّْقغ اَطَّاس حتَّا اَڒ غَا عْذُوْغ مَانَاينِّي. <verse eid="LUK 12:50" /><verse number="51" style="v" sid="LUK 12:51" />مَا تْفكَّرم بلِّي ؤُسِيغ-د اَذ ݣّغ ڒهْنَا ذِي دُّنشْت-أَ؟ لَّا! أَذَاوم ينِيغ ؤُسِيغ-د اَذ ݣّغ اَمنْغِي. <verse eid="LUK 12:51" /><verse number="52" style="v" sid="LUK 12:52" />سَّا اَڒ ثْسَاونْت خمْسَا ن يِوْذَان اَذ منْغن اَك وَايَاوْيَا ذݣ يجّن ن ثدَّارْث: ثْڒَاثَا اَذ منْغن اَك ثْنَاين، ثْنَاين اَذ منْغن اَك ثْڒَاثَا. <verse eid="LUK 12:52" /><verse number="53" style="v" sid="LUK 12:53" />بَابَاس اَذ يمْنغ اَك مِّيس، مِّيس اَذ يمْنغ اَك بَابَاس. يمَّاس اَذ تمْنغ اَك يدْجِيس، يدْجِيس اَذ تمْنغ اَك يمَّاس. لَالَّا اَذ تمْنغ اَك ثسْڒِيث، ثَسْڒِيث اَذ تمْنغ اَك لَالَّاس."<verse eid="LUK 12:53" /></para>
  <para style="s">لْعَلَامَاث ن زْمَان-أَ</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54" />ينَّا-ٱسن عِيْسَى إِ ڒْغَاشِي نِّي: "مڒَا ثࢲْرِيم اَسيْنُو يݣَعّذ-د زِي ڒْغَرْب، ذغْيَا اَذ تِينِيم اَذ يِيڒِي ونْࢲَار. أُو ذ مَانَاينِّي إِي غَا يِيڒِين. <verse eid="LUK 12:54" /><verse number="55" style="v" sid="LUK 12:55" />مڒَا يصُوْض-د اَرِّيح زِي لْجَنُوب، أَذ تِينِيم اَذ يِيڒِي ڒحْمُو اَطَّاس. أُو ذ مَانَاينِّي إِي غَا يِيڒِين." <verse eid="LUK 12:55" /><verse number="56" style="v" sid="LUK 12:56" />ينَّا-ٱسن: "آ لْمُنَافِقِين! لْحَالَا ن وجنَّا ذ ثْمُوْرْث ثسّْنم اَثن تْشَرّْحم مَامش دْجَان. مَايمِّي وَار ثْزمَّرم شَا اَذ تْشَرّْحم لْحَالَا ن زْمَان-أَ إِي ذِي ندْجَا ڒخُّو؟"<verse eid="LUK 12:56" /></para>
  <para style="s">مصْڒَاحث اَك يِوْذَان</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57" />كنِّيو، مَايمِّي وَار تْميِّيزم شَا س يِيخف نْوم مِين يدْجَان ذ ڒْحَقّ؟ <verse eid="LUK 12:57" /><verse number="58" style="v" sid="LUK 12:58" />شُوْف، مڒَا يتْهم-يشك شَا حَدّ منْبَعْد ؤُوِين-اَش-د لْإِسْتِدْعَا حمَا اَكِذس ثْرَاحذ غَار لْمَحْكَامَا، عْذڒ اَكِذس ذغْيَا ذݣ وبْرِيذ بَاش وَار ش يسِيوِّيض شَا غَار ڒْقَاضِي، ڒْقَاضِي نِّي اَذ ئِأَمَر اَمْخَازْنِي، أمْخَازْنِي نِّي اَش ينْضَر ذِي ڒحْبس. <verse eid="LUK 12:58" /><verse number="59" style="v" sid="LUK 12:59" />نِّيغ-اَش: وَار سّنِّي د تفّْغذ شَا اَڒ غَا ثْخدْجْسذ فْرَانْك اَنݣَّارُو."<verse eid="LUK 12:59" /></para>
  <chapter eid="LUK 12" />
  <chapter number="13" style="c" sid="LUK 13" />
  <para style="s">سِيذِيثْنغ عِيْسَى يسَّاوَاڒ خ تُّوْبَا</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1" />ذِي نْهَار نِّي حْضَارن-د شَان يِوْذَان خبَّرن عِيْسَى خ شَا ن يِوْذَان زِي أَيث-لْجَلِيل تُوْغَا غَرّْصن إِ دْبِيحَاث نْسن وَامِي د يُوْسَا لْحَاكم ذ اَرُوْمَانِي بِيلَاطُوْس ينْغِي-ثن، ئِذَامّن نْسن خلّْطن اَك يذَامّن ن دْبِيحَاث نْسن.<verse eid="LUK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 13:2" />يَارَّا خَاسن عِيْسَى ينَّا-ٱسن: "مَا ثْحسْبم ڒْمُعْصِيَاث ن يجَالِيلِيْين-أَ كْتَار زِي ڒْمُعْصِيَاث ن مَارَّا أَيث-لْجَلِيل وَامِي د تهْوَا خَاسن ڒْمُصِيبَا-يَا؟ <verse eid="LUK 13:2" /><verse number="3" style="v" sid="LUK 13:3" />قَّارغ-اَوم لَّا. مڒَا وَار ثتُوْبم شَا، أَتَاف مَارَّا إِذْوم اَذ تمّْثم اَمشْنَاو نِثْنِي. <verse eid="LUK 13:3" /><verse number="4" style="v" sid="LUK 13:4" />نِغ ثْمنْطَاش نِّي إِي خف د توْضَا صُّوْمْعث ذِي حَاي-سِيلْوَام ثنْغِي-ثن، مَا تْغِير-اَوم بلِّي ݣِّين دُنُوْب كْتَار زِي مَارَّا يوْذَان يزدّْغن ذِي ثنْدِينْت ثكْمَاڒ ن لْقُدْس؟ <verse eid="LUK 13:4" /><verse number="5" style="v" sid="LUK 13:5" />قَّارغ-اَوم لَّا. مڒَا وَار ثْتُوْبم شَا، أَتَاف مَارَّا إِذْوم اَذ تمّْثم اَمشْنَاو نِثْنِي."<verse eid="LUK 13:5" /></para>
  <para style="s">ڒْمَعْنَا ن ثْشجَّارْث ن ثَازَارْث وَار يتَارْون شَا</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6" />ئِسِّيوڒ اَكِذْسن س ڒْمَعْنَا-يَا ينَّا-ٱسن: "ئِجّن ن ورْيَاز غَارس ثَشجَّارْث ن ثَازَارْث ثࢲُّو ذِي ڒَعْرَاصِي نّس، يُوْسَا-د نتَّا اَزَّايس يڒْقذ ثَازَارْث يُوْفَا وَار ذَايس وَالُو قَاع. <verse eid="LUK 13:6" /><verse number="7" style="v" sid="LUK 13:7" />ينَّا-ٱس إِ ونِّي يخدّْمن ڒَعْرَاصِي نّس: ثَشجَّارث-أَ ثڒْت سْنِين نش تَاسغ-د غَارس حمَا اَزَّايس ڒقْذغ ثَازَارْث وَار ذَايس تِيفغ وَالُو. أَرَاح-د قسّ-يت! مَايمِّي ت غَا نجّ اَذ تْضيّع ثَمُوْرْث وَاهَا؟ <verse eid="LUK 13:7" /><verse number="8" style="v" sid="LUK 13:8" />يَارَّا خَاس وخدَّام نِّي ينَّا-ٱس: آ سِيذِي، اجّ-يت غِير ڒْعَام-أَ وَاهَا اَخَاس نقْشغ اَذَاس ݣّغ ڒغْبَار. <verse eid="LUK 13:8" /><verse number="9" style="v" sid="LUK 13:9" />مڒَا ثُوْرو-د ثَازَارْث ذݣ وسݣّْوَاس-أَ إِي د غَا يَاسن، أَتَاف مْلِيح. مڒَا عَاذ وَالُو، أَتَاف صَافِي قسّ-يت."<verse eid="LUK 13:9" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا اَعْرُوْر إِ يِجّن ن ثمْغَارْث</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10" />تُوْغَا عِيْسَى يسڒْمَاذ ذݣ يِجّن ن ثمْزِيذَا ن أَيث-إِسْرَائِيل ذِي نْهَار ن سّبْث ن لْعِبَادَا. <verse eid="LUK 13:10" /><verse number="11" style="v" sid="LUK 13:11" />يُوْفَا ذِنِّي يجّن ن ثمْغَارْث ثْمنْطَاش يسݣّوُسَا زݣ وَامِي ثهْڒش ذَايس جّنّ، ثقْوس وَار ثْزمَّر شَا اَذ تْبدّ نِيشَان.<verse eid="LUK 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 13:12" />وَامِي ت يࢲْرَا عِيْسَى يڒَاغَا-د خَاس ينَّا-ٱس: "آ ثَمْغَارْث، شم ڒخُّو ثنْفكّذ زِي ڒهْڒَاش نّم." <verse eid="LUK 13:12" /><verse number="13" style="v" sid="LUK 13:13" />ئِسرْس خَاس يفَاسّن نّس ڒخْدّنِّي ثْبدّ نِيشَان ثبْذَا ثْحمّذ أَريِّي.<verse eid="LUK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14" />أَرَّايس ن ثمْزِيذَا نِّي وَار ذَاس يعْجِيب بُو ڒْحَاڒ وَامِي عِيْسَى يسْݣنْفَا ثَمْغَارْث نِّي ذِي نْهَار ن سّبْث ن لْعِبَادَا. ئِكَّر نتَّا ينَّا-ٱسن إِ يِوْذَان: "أَربِّـي يُوْشَا ستِّيَّام ن ڒْخذْمث ذِي ستِّيَّام نِّي إِي د غَا تَاسم اَذ تْݣنْفِيم، وَار يدْجِي بُو ذِي نْهَار ن لْعِبَادَا."<verse eid="LUK 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15" />ينَّا-ٱس سِيذِيثْنغ: "آ لْمُنَافِقِين، مَا وَار ثْضدْجْقم شَا يفُوْنَاسن ذ يغْيَاڒ نْوم زِي ڒْكُوْرِي ذِي نْهَار ن لْعِبَادَا حمَا اَثن ثْسسّْوم؟ <verse eid="LUK 13:15" /><verse number="16" style="v" sid="LUK 13:16" />ثَمْغَارْث-أَ مسْكِينَا يدْجَان زِي دُّوْرِّيث ن بْرَاهِيم يحبّس-يت شِّيطَان ثْمنْطَاش يسݣّْوُسَا، مَا وَار ذَاس نْرزّم شَا زِي ڒحْبس-أَ ذِي نْهَار ن لْعِبَادَا مَا لَّا؟" <verse eid="LUK 13:16" /><verse number="17" style="v" sid="LUK 13:17" />وَامِي ينَّا اَوَاڒ-أَ، مَارَّا يِنِّي اَكِذس يتْمنْغَان سذْحَان. ئِوْذَان نّغْنِي مَارَّا فَرْحن زِي ڒخْذَايم ثِمقّْرَانِين إِݣ يتݣّ.<verse eid="LUK 13:17" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسَّاوَاڒ خ ڒْمُلْك ن أَربِّـي</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18" />ينَّا-ٱسن عِيْسَى: "مِينْذِي يتْشَابَّاه ڒْمُلْك ن أَربِّـي؟ نِغ س مِينْزِي غَا ث مثّْلغ؟ <verse eid="LUK 13:18" /><verse number="19" style="v" sid="LUK 13:19" />ڒْمُلْك ن أَربِّـي يݣَّا اَم يِجّن ن زَّرِّيعث ن يجّن ن نُّوْع ن اَرْبِيع قَّارن-اَس بُوْݣَرْذَاڒ. ئِيْسِي-ت يجّن ورْيَاز يُوْوِي-ت يࢲُّو-ت ذِي ڒْعَرْسث نّس. ثمْغَار ثْذوّڒ اَم ثْشجَّارْث، ئِجْضَاض تَاسن-د تݣّن ذَايس ڒَعْوَاش نْسن."<verse eid="LUK 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20" />ينَّا-ٱسن عَاوذ: "س مِينْزِي غَا مثّْلغ ڒْمُلْك ن أَربِّـي؟ <verse eid="LUK 13:20" /><verse number="21" style="v" sid="LUK 13:21" />نتَّا اَم ونْتُوْن ثيْسِي-ث يجّن ن ثمْغَارْث ثُوْݣّْوَا زَّايس ڒْمُوْدّ ن وَارن، اَنْتُوْن نِّي يسْݣَعّذ-يث-يد مَارَّا."<verse eid="LUK 13:21" /></para>
  <para style="s">ثَوَّارْث ن ثُوْذَارْث</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22" />ئِكَّا عِيْسَى خ يبِيلَاجن ذ ڒدْشُوْرَاث، ئِسڒْمَاذ يݣُّوْر غَار ثنْدِينْت ن لْقُدْس.<verse eid="LUK 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 13:23" />ئِسّقْسَا-ث يجّن ن ورْيَاز ينَّا-ٱس: "آ سِيذِي، مَا ذْرُوْس إِي غَا يرَاحن غَار ثُوْذَارْث ن ڒبْدَا؟"</para>
  <para style="p" vid="LUK 13:23">ينَّا-ٱس عِيْسَى: <verse eid="LUK 13:23" /><verse number="24" style="v" sid="LUK 13:24" />"ݣّث مَامْش غَا ثَاذْفم زِي ثوَّارْث يحْصَارن. أَذَاوم ينِيغ: أَطَّاس ن يِوْذَان اَتَاف اَذ رْزُوْن اَذ اَذْفن وَلَكِن وَار زمَّرن. <verse eid="LUK 13:24" /><verse number="25" style="v" sid="LUK 13:25" />بَاب ن ثدَّارْث اَذ يكَّر اَذ يبلّع ثَوَّارْث صَافِي. كنِّيو مڒَا ثقِّيمم غَار بَارَّا ثسْقرْقُوْبم ذِي ثوَّارْث ثقَّارم: آ سِيذِي، اَرْزم-اَنغ! أَذَاوم يِينِي: نش وَار سِّينغ شَا زِي مَانِيس د تُوْسِيم! <verse eid="LUK 13:25" /><verse number="26" style="v" sid="LUK 13:26" />سّنِّي اَذ تبْذَام اَذ تِينِيم: نشِّين نشَّا نسْوَا اَكِذش، تُوْغَا ثْسڒْمَاذذ-اَنغ ذݣ يبْرِيذن نّغ! <verse eid="LUK 13:26" /><verse number="27" style="v" sid="LUK 13:27" />أَذَاوم يِينِي: نش وَار سِّينغ شَا زِي مَانِيس د تُوْسِيم. بعّْذم خَافِي آ يِنِّي يتݣّن شَّرّْ! <verse eid="LUK 13:27" /><verse number="28" style="v" sid="LUK 13:28" />ذِنِّي إِي غَا يِيڒِين يمطَّاون ذ وغࢲَّاࢲ ن ثغْمَاس خْمِي غَا ثࢲرم بْرَاهِيم ذ إِسْحَاق ذ يَعْقُوْب ذ مَارَّا لأَنْبِيَا غَار ذَاخڒ ذِي ڒْمُلْك ن أَربِّـي، كنِّيو تْمنْضَارم غَار بَارَّا! <verse eid="LUK 13:28" /><verse number="29" style="v" sid="LUK 13:29" />أَذ د اَسن يِوْذَان زِي شَّرْق ذ ڒْغَرْب ذ شَّمَال ذ لْجَنُوْب، أَذ قِّيمن غَار مِيسَّا ذِي ڒْمُلْك ن أَريِّي. <verse eid="LUK 13:29" /><verse number="30" style="v" sid="LUK 13:30" />يِنِّي يدْجَان ذ ينݣُّوْرَا اَذ ذوْڒن ذ يمزْوُوْرَا؛ يِنِّي إِي يدْجَان ذ يمزْوُوْرَا اَذ ذوْڒن ذ ينݣُّوْرَا."<verse eid="LUK 13:30" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يخيّق خ ثنْدِينْت ن لْقُدْس</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31" />نْهَار نِّي قَارّْبن ڒبْعَاض زِي ڒْحِزب ن يفَرِّيسِيْين غَار عِيْسَى نَّان-اَس: "فّغ سَّانِيتَا اَقَا اَزدْجِيذ هِيرُوْدُس يرزُّو اَش ينغ!"<verse eid="LUK 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32" />ينَّا-ٱسن عِيْسَى: "رُوْحث إِنِيم-اَس إِ وُوْشّن نِّي: قَا نش سُوْفُوْغغ جْنُوْن، سْݣنْفَايغ يوْذَان نْهَارَا ذ ثِيوشَّا. ذِي نْهَار وِيس ثڒْتِيَّام اَذ كمّْڒغ. <verse eid="LUK 13:32" /><verse number="33" style="v" sid="LUK 13:33" />وَلَكِن لَابُد اَذ ؤُيُوْرغ نْهَارَا ذ ثِيوشَّا ذ نْهَار إِي ثِيذ غَا يذْفَارن مِينْزِي وَار يزمَّر اَذ يمّث شَان نَّبِي إِلَّا ذِي ثنْدِينْت ن لْقُدْس.<verse eid="LUK 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34" />يَا لْقُدْس، يَا لْقُدْس! ذ شم إِݣ ينقّن لْأَنْبِيَا، ذ شم إِݣ يرجّْمن يِنِّي غَارم د يسّكّ أَربِّـي! نش مشْحَاڒ ن ثْوَاڒَاثِين خْسغ اَذ سْمُوْنغ ثَارْوَا نّمْ اَم شَان ثْيَازِيط يتحْبُوْبُوْضن خ يفِيدْجُوْسن نّس وَلَكِن كنِّيو ثُوْݣِيم. <verse eid="LUK 13:34" /><verse number="35" style="v" sid="LUK 13:35" />أَقَا ثَدَّارْث نْوم اَذ تخْڒَا! أَذَاوم ينِيغ بلِّي وَار ذَايِي ثْࢲرّم شَا عَاوذ حتَّا ٱر نْهَار نِّي إِي غَا ثِينِيم: سَّعْذ يَا ونِّي إِي د يُوسِين عْلَاحْسَاب يسم ن سِيذِي أَربِّـي."<verse eid="LUK 13:35" /></para>
  <chapter eid="LUK 13" />
  <chapter number="14" style="c" sid="LUK 14" />
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا يجّن ن ورْيَاز يهْڒش ذَايس ثُوْفّت</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1" />ئِجّن ن نْهَار ن سّبْث ن لْعِبَادَا يرُوْح عِيْسَى يُوْذف ثَدَّارْث ن يِجّن زݣ يمقّْرَانن ن ڒْحِزب ن يفَرِّيسِيْين حمَا اَذ يشّ اَغْرُوْم، نِثْنِي حطَّان-ث. <verse eid="LUK 14:1" /><verse number="2" style="v" sid="LUK 14:2" />ذِنِّي زَّاثس يجّن ن ورْيَاز يهْڒش ذَايس ثُوفّت.<verse eid="LUK 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 14:3" />ينَّا-ٱسن عِيْسَى إِ يِنِّي يتْشرَّاحن شَّرِيعَا ذ يِنِّي زِي ڒْحِزب ن يفَرِّيسِيْين: "مَا حَلَال اَذ يتْوَاسْݣنْفَا بْنَاذم ذِي نْهَار ن لْعِبَادَا مَا لَّا؟" <verse eid="LUK 14:3" /><verse number="4" style="v" sid="LUK 14:4" />نِثْنِي سْقَارن وَاهَا. أُوْشَا عِيْسَى يسْقَارّب-يث-يذ غَارس يسْݣنْفَا-ث، ينَّا-ٱس إِيوَا رُوْح.<verse eid="LUK 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 14:5" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "مڒَا شَان يِجّن زَّايْوم يوْضَا-يَاس مِّيس نِغ ذ اَينْدُوْز نّس ذݣ وَانُو ذِي نْهَار ن سّبْث ن لْعِبَادَا، مَا وَار ثِيذ يسِيڒِي شَا ذغْيَا نِغ لَّا؟" <verse eid="LUK 14:5" /><verse number="6" style="v" sid="LUK 14:6" />نِثْنِي ؤُݣِين اَث جَاوْبن خ مَانَايَا.<verse eid="LUK 14:6" /></para>
  <para style="s">ڒْمَعْنَا ن ينوْجِيون</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7" />عِيْسَى وَامِي يُوْفَا ذِنِّي يِنِّي يتْوَاعَرْضن قِّيمن رزُّوْن خ يمُوْشَان يمزْوُوْرَا غَار مِيسَّا، ئِبْذَا يسَّاوَاڒ اَكِذْسن س يِجّن ن ڒْمَعْنَا ينَّا-ٱسن: <verse eid="LUK 14:7" /><verse number="8" style="v" sid="LUK 14:8" />"مڒَا يعَرض-يش شَان يجّن غَار يِجّن ن ڒْفَارْح، وَار تْغِيمَا شَا شك ذݣ ومْشَان اَمزْوَارُو؛ لَّا، ئِمْكن عَرْضن شَان يجّن غَارس لْقِيمَا كْتَار زَّايك. <verse eid="LUK 14:8" /><verse number="9" style="v" sid="LUK 14:9" />أَغَارك د يَاس ونِّي إِي خَاوم يعَرْضن اَذَاش يِينِي ؤُش-اَس اَمْشَان نّش إِ وَانِيتَا! أَتَاف اَذ تْسذْحِيذ اَذ تكَّرذ اَذ تْرَاحذ غَار ومْشَان اَنݣَّارُو. <verse eid="LUK 14:9" /><verse number="10" style="v" sid="LUK 14:10" />لَّا، مڒَا عَرْضن خَاك، رُوْح قِّيم ذݣ ومْشَان اَنݣَّارُو. أَغَارك د يَاس ونِّي إِي ش يعَرْضن اَذَاش يِينِي آي اَمدُّوْكڒ ينُو ݣَعّذ ذِيْهَا. أَتَاف اَذ تمْغَرذ غَار مَارَّا يِنِّي يتْوَاعَرْضن. <verse eid="LUK 14:10" /><verse number="11" style="v" sid="LUK 14:11" />ڒَاحقَّاش ونِّي يسمْغَارن يخف نّس، أَتَاف اَذ يِيڒِي ذ اَمزْيَان. ونِّي يسمْزَاين يخف نّس، أَتَاف اَذ يِيڒِي ذ اَمقّْرَان."<verse eid="LUK 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12" />ينَّا-ٱس عِيْسَى إِ ونِّي إِي ث يعَرْضن: "مڒَا ثݣِّيذ اَمشْرِي نِغ ذ اَمنْسِي، وَار عَرّض شَا خ يمدُّوْكَاڒ نّش نِغ ذ اَيْثْمَاش نِغ ذ فَامِلْيَا نّش نِغ ذ جِّيرَان يدْجَان ذ تْوَاجَر مِينْزِي مڒَا عَرْضن-ش ؤُڒَا ذ نِثْنِي، أَتَاف وَار غَارك بُو لْأَجَار خ مَانَايَا. <verse eid="LUK 14:12" /><verse number="13" style="v" sid="LUK 14:13" />لَّا، مڒَا ثݣِّيذ زَرّْدث عَرض خ ڒْمُسَاكِين ذ ينشْرُوْفن ذ يزحَّافن ذ يضَرْغَاڒن. <verse eid="LUK 14:13" /><verse number="14" style="v" sid="LUK 14:14" />سَّعْذ نّش عْلَاحقَّاش وَار غَارْسن مِينْزِي ش غَا خدْجْسن. أَتَاف اَذَاش يتْوَاخْڒف ذِي نْهَار نِّي خْمِي د غَا كَّرن زِي ڒْموْث يِنِّي يدْجَان نِيشَان."<verse eid="LUK 14:14" /></para>
  <para style="s">ڒْمَعْنَا ن ومنْسِي اَمقّْرَان</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15" />ئِكَّر يجّن زݣ يِنِّي يتْوَاعَرْضن يسْڒَا إِ وَاوَاڒ نِّي ينَّا-ٱس إِ عِيْسَى: "سَّعْذ ن ونِّي إِي غَا يشّن اَغْرُوْم ذِي ڒْمُلْك ن أَربِّـي!"<verse eid="LUK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16" />ينَّا-ٱس عِيْسَى: "ئِجّن ن ورْيَاز يݣَّا اَمنْسِي ذ اَمقّْرَان يعَرض خ وَاطَّاس ن يِوْذَان. <verse eid="LUK 14:16" /><verse number="17" style="v" sid="LUK 14:17" />ئِسّكّ اَخدَّام نّس ذِي ڒْوقْث ن ومنْسِي إِ يِنِّي خف يعَرض بَاش اَذَاسن يِينِي: أَرَاحم-د اَقَا كُڒْشِي يوْجذ! <verse eid="LUK 14:17" /><verse number="18" style="v" sid="LUK 14:18" />مَارَّا إِذْسن بْذَان تݣّن سَّبَاب بَاش وَار تْرِيحن شَا. ذ اَمزْوَارُو ينَّا-ٱس يجّن: نش سْغِيغ يجّن ن ومَرْجع يتْخصَّا-ٱيِي اَذ رَاحغ اَث ࢲرغ، سَامح-اَيِي. <verse eid="LUK 14:18" /><verse number="19" style="v" sid="LUK 14:19" />ينَّا-ٱس يجّن عَاوذ: نش سْغِيغ خمْسَا ن ثْيُوْيَا ن يفُوْنَاسن. ڒخُّو اَذ رَاحغ حمَا اَثن قدْجْبغ، سَامح-اَيِي. <verse eid="LUK 14:19" /><verse number="20" style="v" sid="LUK 14:20" />ينَّا-ٱس يجّن نّغْنِي: نش ؤُوِيغ يجّن ن ثمْغَارْث، خ مَانَايَا وَار زمَّرغ اَذ د اَسغ. <verse eid="LUK 14:20" /><verse number="21" style="v" sid="LUK 14:21" />ئِذْوڒ-د وخدَّام نِّي غَار سِيذس يعَاوذ-اَس مِين يوقْعن. ڒخْدّنِّي يغْضب بَاب ن ثدَّارْث ينَّا-ٱس إِ وخدَّام نّس: فّغ ذغْيَا غَار شَّوَارِع ذ زْنَاقِي، سِيذف-د ڒْمُسَاكِين ذ ينشْرُوْفن ذ يضَرْغَاڒن ذ يزحَّافن. <verse eid="LUK 14:21" /><verse number="22" style="v" sid="LUK 14:22" />ينَّا-ٱس وخدَّام: أَقَايِي ݣِّيغ مِين ذَايِي ثنِّيذ آ سِيذِي وَلَكِن عَاذ قِّيمن يمُوْشَان خْوَان. <verse eid="LUK 14:22" /><verse number="23" style="v" sid="LUK 14:23" />ينَّا-ٱس سِيذس: فّغ غَار يبْرِيذن ذ يمسْرُوْقن، سِيذف-د يوْذَان س بزّز بَاش اَذ اَذْفن بَاش اَذ تْعمَّر ثدَّارْث ينُو. <verse eid="LUK 14:23" /><verse number="24" style="v" sid="LUK 14:24" />أَذَاوم ينِيغ: ؤُڒَا ذ يجّن زݣ يِنِّي إِي خف عَرْضغ وَار يتْقِيسِي اَمنْسِي ينُو!"<verse eid="LUK 14:24" /></para>
  <para style="s">أَمحْضَار يتْخصَّا-يَاس اَذ يسْمح ذݣ يِيخْف نّس</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25" />ذِنِّي اَطَّاس ن ڒْغَاشِي ݣُّوْرن اَك عِيْسَى، ئِنقْڒب-د غَارْسن ينَّا-ٱسن: <verse eid="LUK 14:25" /><verse number="26" style="v" sid="LUK 14:26" />"ونِّي غَارِي د يتَاسن نش، مڒَا يعِيزّ خَاس بَابَاس كْتَار زَّايِي نش نِغ ذ يمَّاس نِغ ذ ثمْغَارْث نّس نِغ ذ ثَارْوَا نّس نِغ ذ اَيْثْمَاس نِغ ذ سْوِيثْمَاس نِغ ذ يخف نّس، أَتَاف وَار يزمَّر اَذ يِيڒِي ذ اَمحْضَار ينُو.<note caller="+" style="f"><char style="fr" closed="false">14‏.26 </char><char style="ft" closed="false">خْزَر لْكِتَاب ن مَتَّى 10‏:37.</char></note> <verse eid="LUK 14:26" /><verse number="27" style="v" sid="LUK 14:27" />ونِّي يرزُّوْن اَذَايِي يذْفَار وَار يكسِّي شَا صَّلِيب نّس <char style="it">مِيخ غَا يعدّب</char>، أَتَاف وَار يزمَّر اَذ يِيڒِي ذ اَمحْضَار ينُو.<verse eid="LUK 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28" />مڒَا شَان يجّن زَّايْوم يرْزُو اَذ يبْنَا صُّوْمْعث، ئِتْخصَّا-يَاس ذ اَمزْوَارُو اَذ يݣّ ڒحْسَاب مشْحَاڒ مِينْزِي غَا ثنْقَام مَا يزمَّر-اَس ٱت يكمّڒ مَا لَّا. <verse eid="LUK 14:28" /><verse number="29" style="v" sid="LUK 14:29" />مَاشِي اَذ يݣّ دْسَاس وَاهَا، صُّوْمْعث نِّي وَار يزمَّر شَا اَت يكمّڒ. يِنِّي إِي ذَايس يخزَّارن اَتَاف مَارَّا اَخَاس ضحْشن، <verse eid="LUK 14:29" /><verse number="30" style="v" sid="LUK 14:30" />أَذ ينِين قَا اَرْيَاز-أَ يبْذَا يبنَّا وَلَكِن وَار يزمَّر شَا اَت يكمّڒ.<verse eid="LUK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31" />أَزدْجِيذ، مڒَا يرُوْح اَذ يݣّ ڒْحَرْب اَك يِجّن ن وزدْجِيذ نّغْنِي، ئِتْخصَّا-يَاس ذ اَمزْوَارُو اَذ يفكَّر مَا ٱذ يرْبح ڒْحَرْب نِّي س عشْرَاڒَاف ن ڒْعَسْكَار ڒْعَذُو نّس غَارس عِشْرِين اَڒَاف ن ڒْعَسْكَار. <verse eid="LUK 14:31" /><verse number="32" style="v" sid="LUK 14:32" />مڒَا وَار ذَاس يزمَّر شَا، أَغَارس يسّكّ نُّوْيَاب نّس نتَّا عَاذ يݣّْوج وَار د يُوْوِيض شَا بَاش اَزَّايس تَّارن مَامْش غَا ݣّن اَذ عذْڒن جَارَاسن.<verse eid="LUK 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 14:33" />أَمنِّي عَاوذ وَار يزمَّر شَا ؤُڒَا ذ يجّن زَّايْوم اَذ يِيڒِي ذ اَمحْضَار ينُو إِلَّا مڒَا يسْمح ذِي مَارَّا مِين غَارس.<verse eid="LUK 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34" />ڒمْڒح ثْصدْجَاح، وَلَكِن مڒَا يرُوْح-اَس لْمَذَاق نّس، مَامْش ذَاس غَا نݣّ اَذَاس ثِيذ نَارّ؟ <verse eid="LUK 14:34" /><verse number="35" style="v" sid="LUK 14:35" />أَتَاف وَار ثْصدْجَاح لَّا إِ ثْمُوْرْث لَّا إِ ثْزوْبَايْث، غِير اَت نْضَرن غَار بَرَّا وَاهَا. صنّط مْلِيح آ ونِّي يتْسْڒَان."<verse eid="LUK 14:35" /></para>
  <chapter eid="LUK 14" />
  <chapter number="15" style="c" sid="LUK 15" />
  <para style="s">ڒْمَعْنَا ن يِنِّي د يذوْڒن غَار وبْرِيذ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1" />مَارَّا يِنِّي يدْجَان ذ يعشَّارن ذ يِنِّي يعصَّان قَارّْبن-د غَار عِيْسَى حمَا اَذَاس صنّْطن. <verse eid="LUK 15:1" /><verse number="2" style="v" sid="LUK 15:2" />ڒْحِزب ن يفَرِّيسِيْين ذ يمْسڒْمَاذن ن شَّرِيعَا سَّاوَاڒن ذِي عِيْسَى نَّان: "أَرْيَاز-أَ يتْرحَّاب زݣ يِنِّي يعصَّان يتتّ اَكِذْسن!"<verse eid="LUK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 15:3" />ئِنْدق-د عِيْسَى ينَّا-ٱسن ڒْمَعْنَا-يَا: <verse eid="LUK 15:3" /><verse number="4" style="v" sid="LUK 15:4" />"ئِجّن زَّايْوم غَارس مِيَّا ن يحُوْڒِيْين مَثَالَان. مڒَا يودَّار-اَس يجّن زَّايْسن، أَتَاف اَذ يجّ تسْعَا أُو تسْعِين ذِي ڒخْرَا اَذ يرَاح اَذ يرْزُو خ ونِّي يودَّارن اَڒ ث غَا يَاف. أَمنِّي نِغ لَّا؟ <verse eid="LUK 15:4" /><verse number="5" style="v" sid="LUK 15:5" />خمِّي ث غَا يَاف اَث يِيسِي خ ؤُغِيڒ نّس اَذ يفَرح. <verse eid="LUK 15:5" /><verse number="6" style="v" sid="LUK 15:6" />أَذ يذْوڒ غَار ثدَّارْث نّس اَذ د يڒَاغَا خ يمدُّوْكَاڒ نّس ذ جِّيرَان نّس اَذَاسن يِينِي فَرْحم اَكِذِي اَقَا ؤُفِيغ اَحُوْڒِي نِّي إِي تُوْغَا ذَايِي يودَّارن! <verse eid="LUK 15:6" /><verse number="7" style="v" sid="LUK 15:7" />أَذَاوم ينِيغ: أَذ فَرْحن ذݣ وجنَّا اَطَّاس خ يِجّن مڒَا يذْوڒ-د غَار وبْرِيذ كْتَار زِي مِن غَا فَرْحن خ تسْعَا أُو تسْعِين نِّي وَار فِّيغن شَا اَبْرِيذ.<verse eid="LUK 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8" />نِغ، شَان ثمْغَارْث غَارس عشْرَا ن دِينَار مَثَالَان، ئِودَّار-اَس يجّن. أَتَاف اَذ تْشعّڒ ڒْقنْدِيڒ اَذ تْسكّ ذِي ثدَّارْث اَذ ترْزُو اَطَّاس خ دِينَار نِّي اَڒ ث غَا ثَاف. أَمنِّي نِغ لَّا؟ <verse eid="LUK 15:8" /><verse number="9" style="v" sid="LUK 15:9" />خْمِي ث غَا ثَاف، أَذ تْڒَاغَا خ ثْمدُّوْكَاڒ ذ ثَاجَّارِين اَذَاسنْت ثِينِي: فَرْحنْت اَكِذِي اَقَا ؤُفِيغ دِينَار نِّي إِي تُوْغَا ذَايِي يودَّارن! <verse eid="LUK 15:9" /><verse number="10" style="v" sid="LUK 15:10" />أَذَاوم ينِيغ: أَمنِّي يجّن مڒَا يعْصَا منْبَعْد يتُوْب، أَتَاف اَكِذس فَرْحنْت لْمَلَائِكَاث ن أَربِّـي."<verse eid="LUK 15:10" /></para>
  <para style="s">ڒْمَعْنَا ن وحنْجِير إِݣ يدْجَان ذ اَمْفلّس</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11" />عِيْسَى ينَّا عَاوذ: "تُوْغَا يجّن ن ورْيَاز غَارس ثْنَاين ن يحنْجِيرن. <verse eid="LUK 15:11" /><verse number="12" style="v" sid="LUK 15:12" />ونِّي اَمزْيَان ينَّا-ٱس إِ بَابَاس: آ بَابَا ؤُش-اَيِي ڒْحَقّ ينُو ذِي ڒْوَارْث. صَافِي يكَّر ورْيَاز نِّي يفْرق اَݣْڒَا إِ ثَارْوَا نّس. <verse eid="LUK 15:12" /><verse number="13" style="v" sid="LUK 15:13" />وَامِي عْذُوْن شْوَايت ن وُوْسَّان، أَحنْجِير نِّي اَمزْيَان ييْسِي مَارَّا مِين غَارس ذ اَݣْڒَا يرُوْح غَار يِجّن ن ثْمُوْرْث ثِݣّْوج يسْـپـرْذر ذِنِّي تْمنْيَاث نّس ذِي تفْلَايس. <verse eid="LUK 15:13" /><verse number="14" style="v" sid="LUK 15:14" />وَامِي يضيّع مَارَّا اَݣْڒَا نّس، ئِوْقع ذِي ثْمُوْرْث نِّي يجّن ن بُوْهيُّوْف وَار يُوْفِي مِين غَا يشّ. <verse eid="LUK 15:14" /><verse number="15" style="v" sid="LUK 15:15" />سّنِّي يبْذَا يخدّم غَار يجّن ن ورْيَاز زِي ثْمُوْرْث نِّي يسّكّ-يث اَذ يَرْوس يڒْفَان ذݣ يمَرْجعِيون نّس. <verse eid="LUK 15:15" /><verse number="16" style="v" sid="LUK 15:16" />ذَايس يمزْڒَان اَذ يجَّاون س يقَاشّْون ن ثْسْڒِيغْوَا يِنِّي إِي تتّن يِڒْفَان نِّي، وَار ث يعْثِيق حَدّ. <verse eid="LUK 15:16" /><verse number="17" style="v" sid="LUK 15:17" />ئِبْذَا ڒخْدّنِّي يتْخمَّام مْلِيح ذݣ يِيخف نّس ينَّا: مشْحَاڒ غَارس ذ يخدَّامن غَار بَابَا يتْشطَّا خَاسن وغْرُوْم، نش اَقَايِي ذَانِيتَا تْمتِّيغ س جُّوْع. <verse eid="LUK 15:17" /><verse number="18" style="v" sid="LUK 15:18" />ينَّا: أَذ كَّرغ اَذ ذوْڒغ غَار بَابَا اَذَاس ينِيغ: آ بَابَا عْصِيغ سِيذِي أَربِّـي، عْصِيغ شك. <verse eid="LUK 15:18" /><verse number="19" style="v" sid="LUK 15:19" />ڒخُّو وَار سْذِيهْدْجغ شَا اَذ يڒِيغ ذ مِّيش، اݣّ-اَيِي اَم وخدَّام نّش وَاهَا. <verse eid="LUK 15:19" /><verse number="20" style="v" sid="LUK 15:20" />ئِكَّر يرُوْح غَار بَابَاس. نتَّا اَقَاث عَاذ يݣّْوج اَطَّاس خ ثدَّارْث وَامِي ث يࢲْرَا بَابَاس يقّس-اَس. ئِرُوْح غَارس يتَازّڒ يذرّع-اَس يسدْجم خَاس. <verse eid="LUK 15:20" /><verse number="21" style="v" sid="LUK 15:21" />ينَّا-ٱس مِّيس: آ بَابَا عْصِيغ سِيذِي أَربِّـي، عْصِيغ شك. وَار سْذِيهْدْجغ شَا اَذ يڒِيغ ذ مِّيش.<verse eid="LUK 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 15:22" />ينَّا-ٱسن بَابَاس إِ يخدَّامن نّس: رُوْحم ذغْيَا اَوِيم-د تْشَامِّير ذ اَصبْحَان اَرْضم-اَس-ث. ݣّم-اَس ثْخَاذنْت ذݣ وفُوْس نّس، ݣّم-اَس ثِسِيڒَا ذݣ يضَارن نّس. <verse eid="LUK 15:22" /><verse number="23‏-24" style="v" sid="LUK 15:23-24" />أَوِيم-د اَينْدُوْز نِّي يصحّن غَرْصم-اَس. أَ نشّ أَ نْفَرح مِينْزِي مِّي تُوْغَا يمُّوْث ڒخُّو يدَّر. تُوْغَا يودَّار ڒخُّو يتْوَاف. نِثْنِي بْذَان فَرّْحن.<verse eid="LUK 15:23-24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25" />مِّيس اَمقّْرَان نتَّا تُوْغَاث عَاذ ذݣ ومَرْجع. وَامِي د يذْوڒ غَار ثدَّارْث يقَارّب-د، ئِتسْڒَا إِ لْمُوْسِيقَا ذ شْضِيح. <verse eid="LUK 15:25" /><verse number="26" style="v" sid="LUK 15:26" />ئِڒَاغَا-د خ يِجّن زݣ يخدَّامن يسّقْسَا-ث، ينَّا-ٱس مِين ذَا يوقْعن؟ <verse eid="LUK 15:26" /><verse number="27" style="v" sid="LUK 15:27" />ينَّا-ٱس وخدَّام نِّي قَا ؤُمَاش يذْوڒ-د. ڒخُّو بَابَاش يغَرص-اَس إِ وينْدُوْز يصحّن ڒَاحقَّاش يرحّب زݣ وُوْمَاش وَامِي د يذْوڒ س بُوْحْبڒ نّس. <verse eid="LUK 15:27" /><verse number="28" style="v" sid="LUK 15:28" />ئِقّس-اَس ڒْحَاڒ إِ مِّيس اَمقّْرَان يُوْݣِي اَذ يَاذف غَار ثدَّارْث. ئِفّغ-د غَارس بَابَاس غَار بَارَّا يبْذَا يتْحشَّام-يث بَاش اَذ يَاذف. <verse eid="LUK 15:28" /><verse number="29" style="v" sid="LUK 15:29" />ينَّا-ٱس إِ بَابَاس: نش مشْحَاڒ ن يسݣّوُسَا اَقَايِي خدّْمغ اَكِذش ڒبْدَا تْطَاعَاغ-اَش، عمَّارْص وَار ذَايِي ثُوْشِيذ ؤُڒَا ذ يغِيْذ حمَا اَذ فَرْحغ زَّايس اَك يمدُّوْكَاڒ ينُو. <verse eid="LUK 15:29" /><verse number="30" style="v" sid="LUK 15:30" />وَامِي د يُوْسَا مِّيش-أَ وَانِيتَا إِݣ يـسْپـرْضْرن اَݣْڒَا نّش ذِي لْفَسْدَاث وَاهَا، شك مِين ثݣِّيذ؟ ثْغَرْصذ-اَس إِ وينْدُوز يصحّن؟<verse eid="LUK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 15:31" />ينَّا-ٱس بَابَاس: لَّا آ مِّي ينُو، شك اَقَاش اَكِذِي ذَانِيتَا إِ ڒبْدَا، مَارَّا مِين غَارِي ذ اَݣْڒَا ينُو اَذ يذْوڒ إِ شك. <verse eid="LUK 15:31" /><verse number="32" style="v" sid="LUK 15:32" />ڒخُّو يتْخصَّا-ٱنغ أَ نْفَرح أَ نزْهُو اَطَّاس مِينْزِي ؤُمَاش تُوْغَا يمُّوْث، ڒخُّو يدَّر. تُوْغَا يودَّار، ڒخُّو يتْوَاف."<verse eid="LUK 15:32" /></para>
  <chapter eid="LUK 15" />
  <chapter number="16" style="c" sid="LUK 16" />
  <para style="s">ڒْمَعْنَا ن ؤُوقَّاف إِي ذِي ثدْجَا ڒفْطَانث</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1" />عِيْسَى ينَّا-ٱسن عَاوذ إِ يمحْضَارن نّس: "ئِجّن ن سِّيّد ذ تَجَّر غَارس اَوقَّاف. ؤُشِين-اَس ڒخْبَار خ ؤُوقَّاف نّس يضيّع-اَس اَطَّاس ن تْمنْيَاث. <verse eid="LUK 16:1" /><verse number="2" style="v" sid="LUK 16:2" />ئِكَّر سِّيّد نِّي يڒَاغَا-د خَاس ينَّا-ٱس: مِين خَاك تسْڒِيغ؟ ؤُش-اَيِي-د ڒحْسَاب يدْجَان جَارَانغ. زِي نْهَارَا اَڒ ثْسَاونْت وَار تْغِيمِيذ شَا اَذ تِيڒِيذ ذ اَوقَّاف ينُو. <verse eid="LUK 16:2" /><verse number="3" style="v" sid="LUK 16:3" />ينَّا ؤُوقَّاف ذِي نّفْس نّس: مِين غَا ݣّغ؟ ڒخُّو بَاب ن شِي اَذَايِي يكّس لْوَكَالَا. نش وَار ذَايِي بُو جّْهذ اَذ نقْشغ، أَذ سذْحِيغ اَذ تَّارغ. <verse eid="LUK 16:3" /><verse number="4" style="v" sid="LUK 16:4" />أُوشَا ينَّا: سّْنغ مِين غَا ݣّغ. مڒَا يكّس-اَيِي لْوَكَالَا، أَتَاف اَزَّايِي رحّْبن يِوْذَان غَار ثُوْذْرِين نْسن. <verse eid="LUK 16:4" /><verse number="5" style="v" sid="LUK 16:5" />ڒخْدّنِّي يڒَاغَا-د إِ كُڒ يجّن ؤُمِي يتَارْس بَاب ن شِي. ينَّا-ٱس إِ ومزْوَارُو: مشْحَاڒ ذَاش يتَارْس بَاب ن شِي ينُو؟<verse eid="LUK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 16:6" />يَارَّا خَاس ينَّا-ٱس: مِيَّا ن ثْبَرْمِيڒِين ن زّشْت.</para>
  <para style="p" vid="LUK 16:6">ينَّا-ٱس ؤُوقَّاف نِّي: يْسِي-د لِيسْطَا نّش قِّيم ذغْيَا، اَرِي ذَايس غِير خمْسِين!<verse eid="LUK 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 16:7" />عَاوذ ينَّا-ٱس إِ ونّغْنِي: ئِي شك، مشْحَاڒ ذَاش يتَارْس؟</para>
  <para style="p" vid="LUK 16:7">يَارَّا خَاس ينَّا-ٱس: مِيَّا ن يقنْدَارن ن يِيرْذَان.</para>
  <para style="p" vid="LUK 16:7">ينَّا-ٱس ؤُوقَّاف نِّي: يْسِي-د لِيسْطَا نّش، أَرِي ذَايس غِير ثْمَانِين!<verse eid="LUK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 16:8" />بَاب ن شِّي يشكَّر اَوقَّاف نّس ذِي يدْجَا لْحِيلَا خ ڒفْطَانث نّس.</para>
  <para style="p" vid="LUK 16:8">شُوْف، ثَارْوَا ن زْمَان-أَ ذَايْسن ڒفْطَانث جَارَاسن كْتَار زِي ثَارْوَا ن نُّوْر. <verse eid="LUK 16:8" /><verse number="9" style="v" sid="LUK 16:9" />نش اَذَاوم ينِيغ: ݣّم يمدُّوْكَاڒ زِي ڒوْسخ ن دُّنشْت-أَ. أَتَاف خْمِي غَا يتْوَاقْضَا اَذ تْوَاقبْڒم ذِي ثُوذْرِين ن ڒبْدَا.<verse eid="LUK 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 16:10" />ونِّي ذِي يدْجَا ڒَامَان خ ذْرُوْس، ذَايس ڒَامَان خ وَاطَّاس. ونِّي وَار ذِي يدْجِي ڒَامَان خ ذْرُوْس، وَار ذَايس بُو ڒَامَان خ وَاطَّاس. <verse eid="LUK 16:10" /><verse number="11" style="v" sid="LUK 16:11" />مڒَا وَار ذَايْوم بُو ڒَامَان خ ڒوْسخ ن دُّنشْت-أَ، وِي ذَايْوم غَا يݣّن ڒَامَان خ وَاݣْڒَا ن صَّح؟ <verse eid="LUK 16:11" /><verse number="12" style="v" sid="LUK 16:12" />مڒَا وَار ذَايْوم بُو ڒَامَان خ مِين وَار يدْجِين نْوم، وِي ذَايْوم غَا يُوْشن مِن يدْجَان نْوم؟<verse eid="LUK 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13" />وَار يزمَّر اَذ يِيڒِي شَان يِجّن ذ اَخدَّام غَار ثْنَاين ن سِيَاذِس. مَايمِّي؟ إِمَا يجّن اَث يعِيفّ، ئِجّن اَث يخس. نِغ يجّن اَذَايس يطّف، ئِجّن اَث يحݣَّار. أَذ تْخذْمم إ أَربِّـي نِغ اَذ تْخذْمم إِ ڒوْسخ ن دُّنشْت-أَ، وَار يدْجِي بُو س ثْنَاين."<verse eid="LUK 16:13" /></para>
  <para style="s">شَّرِيعَا وَار تْبدِّيڒ</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14" />ڒْحِزب ن يفَرِّيسِيْين نِثْنِي زݣ يِنِّي يتخْسن تْمنْيَاث، وَامِي سْڒِين إِ مَارَّا مَانَايَا ضحْشن خَاس. <verse eid="LUK 16:14" /><verse number="15" style="v" sid="LUK 16:15" />ينَّا-ٱسن عِيْسَى: "كنِّيو ذ يِنِّي إِي يرزُّوْن اَذ ؤُشن ڒْحَقّ خ يِيخف نْسن زَّاث إِ يِوْذَان، وَلَكِن أَربِّـي يسّن مِين غَارْوم ذݣ وُوْڒَاون نْوم. مِين يتَارَّان بْنَاذم غَارس لْقِيمَا، أَتَاف مَانَاينِّي ذ اَعفَّان اَطَّاس غَار أَربِّـي.<verse eid="LUK 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16" />شَّرِيعَا ن مُوْسَى ذ وسڒْمذ ن لْأَنْبِيَا تُوْغَا دْجَان اَڒ وَامِي د يُوْسَا يَحْيَى. زِي ڒْوقْث ن يَحْيَى سّنِّي اَڒ ثْسَاونْت يبْذَا يتْوَابشَّار ڒْمُلْك ن أَربِّـي، كُڒ يجّن يتمْذحَّاس حمَا اَذَايس يَاذف. <verse eid="LUK 16:16" /><verse number="17" style="v" sid="LUK 16:17" />إِنَّمَا، ئِسْهڒ اَذ يتْوَاكّس وجنَّا ذ ثْمُوْرْث قْبڒ إِي غَا تتْوَاكّس يجّن ن ثْنقِّيط زِي شَّرِيعَا.<verse eid="LUK 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18" />مَارَّا ونِّي غَا يدْجْفن إِ ثمْغَارْث نّس يُوْوِي شَان يِشْتن نّغْنِي، أَتَاف يزْنَا. مَارَّا ونِّي إِي غَا يمڒْشن اَك ثنِّي يدْجْفن، أَتَاف يزْنَا."<verse eid="LUK 16:18" /></para>
  <para style="s">تَّاجَر ذ ڒْمسْكِين ونِّي ؤُمِي قَّارن لِعَازَر</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19" />"شُوْف، تُوْغَا يجّن ذ تَّاجَر، نتَّا يتَارض اَرُّوْض يغْڒَان كُڒ نْهَار يتْعِيش ذݣ يِجّن ن نِّعْمث يزهُّو. <verse eid="LUK 16:19" /><verse number="20" style="v" sid="LUK 16:20" />ذِنِّي عَاوذ يجّن نّغْنِي نتَّا ذ ڒْمسْكِين وَاهَا قَّارن-اَس لِعَازَر، ذَايس اَطَّاس ن ثْحبَّا نتَّا يتْمنْضَار غَار ثوَّارْث ن تَّاجَر نِّي. <verse eid="LUK 16:20" /><verse number="21" style="v" sid="LUK 16:21" />ئِتْمنَّا اَذ يشّ مِين يوطَّان زِي مِيسَّا ن تَّاجَر نِّي. اَرْنِين-اَس ؤُڒَا ذ يقْزِينن تَاسن-د ڒسّْحن-اَس ثِحبَّا نّس.<verse eid="LUK 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22" />صَافِي يمُّوْث ڒْمسْكِين نِّي، يْسِينْت-ث لْمَلَائِكَاث سرْسنْت-ث خ وفُوْذ ن بْرَاهِيم. عَاوذ يمُّوْث تَّاجَر نِّي يْسِين-ث نضْڒن-ث. <verse eid="LUK 16:22" /><verse number="23" style="v" sid="LUK 16:23" />ئِسِيڒِي تَّاجَر ثِيطَّاوِين نّس يتْعدَّاب ذِي لْجَحِيم، ئِࢲْرَا بْرَاهِيم ذ لِعَازَر اَكِذس اَقَاثن ذِي ڒݣّْوَاج. <verse eid="LUK 16:23" /><verse number="24" style="v" sid="LUK 16:24" />ئِڒَاغَا-يَاس ينَّا-ٱس: آ بَابَا بْرَاهِيم رحْم-اَيِي، سكّ-د لِعَازَر حمَا اَذ يسُوْفّ يجّن ن ثِيشّط ن وضَاض ن وفُوْس نّس ذݣ وَامَان بَاش اَزَّايس سمْضغ يڒس ينُو مِينْزِي نش تْعدَّابغ ذِي ثْمسِّي-يَا.<verse eid="LUK 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25" />ينَّا-ٱس بْرَاهِيم: عْقڒ آ مِّي ينُو، شك ثيْسِيذ ڒْحَقّ نّش زِي ڒْخِير ذِي ثُوْذَارْث نّش، لِعَازَر يعِيش مْعَادّب. ڒخُّو نتَّا اَقَاث ذَا مْلِيح، شك اَقَّاش ذِي ڒَعْدَاب. <verse eid="LUK 16:25" /><verse number="26" style="v" sid="LUK 16:26" />أُو عَاوذ ذِنِّي يجّن ن ڒَادْجغ يُوْدْجغ جَارَانغ. ئِجّن سَّانِيتَا مڒَا يخس اَغَارْوم د يعْذُو وَار يزمَّر شَا. ئِجّن سّنِّي مڒَا يخس اَغَارْنغ د يعْذُو وَار يزمَّر شَا.<verse eid="LUK 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 16:27" />ينَّا-ٱس تَّاجَر نِّي: آ بَابَا بْرَاهِيم، خ مَانَايَا تتَّارغ زَّايك اَذ تسّكّذ لِعَازَر غَار ثدَّارْث ن بَابَا. <verse eid="LUK 16:27" /><verse number="28" style="v" sid="LUK 16:28" />غَارِي خمْسَا ن أَيْثْمَا خْسغ اَثن يعْڒم حمَا ؤُڒَا ذ نِثْنِي وَار تْعدِّيبن شَا ذݣ ومْشَان-أَ.<verse eid="LUK 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29" />ينَّا-ٱس بْرَاهِيم: لَّا، أَيثْمَاش غَارْسن مُوْسَى ذ لْأَنْبِيَا نّغْنِي يتْخصَّا اَذَاسن صنّْطن.<verse eid="LUK 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 16:30" />ينَّا-ٱس تَّاجَر نِّي: آ بَابَا بْرَاهِيم! مڒَا يرُوْح غَارْسن شَان يِجّن زݣ يِنِّي يمُّوْثن، أَتَاف اَذ تُوْبن.<verse eid="LUK 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 16:31" />ينَّا-ٱس بْرَاهِيم: لَّا، مڒَا نِثْنِي وَار تسْڒِين شَا إِ مُوْسَى ذ لْأَنْبِيَا، وَاخَّا يكَّر-د شَان يِجّن زِي ڒْموْث اَتَاف وَار ثن يسْنقْنِيع شَا."<verse eid="LUK 16:31" /></para>
  <chapter eid="LUK 16" />
  <chapter number="17" style="c" sid="LUK 17" />
  <para style="s">لإِيمَان ذ ڒْمُعْصِيّث</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1" />ينَّا-ٱسن عِيْسَى إِ يمحْضَارن نّس: "ڒبْدَا توْقِيعنْت ثْمسْڒَايِين إِي غَا يغضْڒن يوْذَان ذِي ڒْمُعْصِيَاث، وَلَكِن يَا تَمَارَا ن بْنَاذم نِّي إِݣ يدْجَان ذ سَّبَاب ن ڒْمُعْصِيَاث نِّي. <verse eid="LUK 17:1" /><verse number="2" style="v" sid="LUK 17:2" />نتَّا، مڒَا شدّن يجّن ن وزْرُو ن ثْسِيرْث س وسْغُوْن غَار يِيرِي نّس اَث نْضَرن ذِي ڒبْحَر، أَتَاف حْسن إِ نتَّا زِي مڒَا يُوْوِي يجّن زݣ يمزْيَانن-أَ غار ڒْمُعْصِيّث. <verse eid="LUK 17:2" /><verse number="3" style="v" sid="LUK 17:3" />حْضَام يخف نْوم.</para>
  <para style="p" vid="LUK 17:3">مڒَا يخْضَا اَكِذش ومَاش نْهَا-ث. مڒَا ينْدم سَامح-اَس. <verse eid="LUK 17:3" /><verse number="4" style="v" sid="LUK 17:4" />مڒَا يخْضَا اَكِذش سبْعَا ن ثْوَاڒَاثِين ذِي نْهَار، ئِذْوڒ-د غَارك سبْعَا ن ثْوَاڒَاثِين ينَّا-ٱش نْدمّغ خ مِين خذْمغ، أَتَاف اَذَاس ثْسَامْحذ."<verse eid="LUK 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5" />نَّان-اَس اَرُّسُل إِ سِيذِيثْنغ: "اَرْنِي ذَايْنغ لإِيمَان."<verse eid="LUK 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6" />يَارَّا خَاسن سِيذِيثْنغ ينَّا-ٱسن: "مْڒِي ذَايْوم لإِيمَان غِير اَنشْت يجّن ن ثْحبُّوْشْت ن بُوْݣَرْذَاڒ، أَتَاف اَذَاس ثِينِيم إِ ثْشجَّارْث-أَ ن تُّوْث: نقْڒع-د شم س يࢲوْرَان رُوْح اَذ تࢲُّوْذ يخْف نّمْ ذِي ڒبْحَر، أَتَاف اَذَاوم ثݣّ اَرَّاي."<verse eid="LUK 17:6" /></para>
  <para style="s">سمْزَايم يخف نْوم</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7" />"شُوْف، شَان يِجّن زَّايْوم مَثَالَان غَارس اَخدَّام يتْفدْجَاح نِغ يتْرَاسّ يحُوْڒِيْين. خْمِي غَا د يعْقب زݣ ومَرْجع، مَا ٱذَاس ثِينِيذ قِّيم ذغْيَا اَذ تشّذ؟ <verse eid="LUK 17:7" /><verse number="8" style="v" sid="LUK 17:8" />لَّا، أَذَاس ثِينِيذ سوْجذ-اَيِي-د مِين غَا شّغ. ݣفّض، سخَّار خَافِي اَڒ غَا شّغ اَذ سْوغ. عَاذ ڒخْدّنِّي إِي غَا ثشّذ شك اَذ تسْوذ. <verse eid="LUK 17:8" /><verse number="9" style="v" sid="LUK 17:9" />أَخدَّام نِّي، مَا ث ثْشكَّرذ مڒَا يݣَّا-ٱش اَرَّاي؟ لَّا. <verse eid="LUK 17:9" /><verse number="10" style="v" sid="LUK 17:10" />أَمُّو ؤُڒَا ذ كنِّيو. مڒَا ثݣِّيم مَارَّا مِينْخف كنِّيو وصَّان، أَتَاف اَذ تِينِيم نشِّين ذ يخدَّامن وَاهَا، نْتݣّ غِير لْوَاجِب نّغ يتْخصَّا اَث نݣّ."<verse eid="LUK 17:10" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا عشْرَا ن يمهْڒَاش ذَايْسن جْذَام</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11" />عِيْسَى ذݣ وبْرِيذ غَار ثنْدِينْت ن لْقُدْس، ئِكَّا خ وبْرِيذ مَانِي تْحدَّا ثْمُوْرْث ن سَامَارْيَا ذ ثْمُوْرْث ن لْجَلِيل. <verse eid="LUK 17:11" /><verse number="12" style="v" sid="LUK 17:12" />يُوْذف غَار يِجّن ن دْشَار يُوْفَا ذِنِّي عشْرَا ن يرْيَازن ذَايْسن جْذَام. بدّن غَار ڒݣّْوَاج <verse eid="LUK 17:12" /><verse number="13" style="v" sid="LUK 17:13" />تْڒَاغَان-اَس س جّْهذ قَّارن: "آ عِيْسَى آ لْمُعَلِّم، رْحم-اَنغ!"<verse eid="LUK 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14" />ئِخْزَر ذَايْسن ينَّا-ٱسن: "رُوْحم غَار ڒْفُقَهَا سظْهَارم-اَسن يخف نْوم!" نِثْنِي وَامِي يُوْيُوْرن ذݣ وبْرِيذ نْسن صَافِي ݣنْفَان.<verse eid="LUK 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 17:15" />يجّن زَّايْسن وَامِي يُوْفَا يخف نّس يݣنْفَا، ئِذْوڒ-د يحمّذ أَربِّـي س جّْهذ. <verse eid="LUK 17:15" /><verse number="16" style="v" sid="LUK 17:16" />ئِسجّذ-اَس إِ عِيْسَى غَار يضَارن نّس يبْذَا يتْشكَّر-يث. نتَّا أَرْيَاز نِّي زِي سَامَارْيَا.<verse eid="LUK 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 17:17" />ينَّا عِيْسَى: "عشْرَا نِّي، ݣنْفَان مَارَّا مَا لَّا؟ مَانِي دْجَان تسْعَا نِّي نّغْنِي؟ <verse eid="LUK 17:17" /><verse number="18" style="v" sid="LUK 17:18" />مَا اَبَرَّانِي-يَا وَاهَا إِي د يذوْڒن يحمّذ أَربِّـي؟" <verse eid="LUK 17:18" /><verse number="19" style="v" sid="LUK 17:19" />ينَّا-ٱس: "كَّر اَذ تْروّْحذ، لْإِيمَان نّش يسنْجم-يش."<verse eid="LUK 17:19" /></para>
  <para style="s">ڒْمُلْك ن أَربِّـي</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20" />ئِوْذَان زِي ڒْحِزب ن يفَرِّيسِيْين سّقْسَان عِيْسَى نَّان-اَس: مڒْمِي د غَا يَاس ڒْمُلْك ن أَربِّـي؟</para>
  <para style="p" vid="LUK 17:20">ينَّا-ٱسن عِيْسَى: "ڒْمُلْك ن أَربِّـي وَار د يتِيس شَا س لْعَلَامَاث نِّي إِي زِي غَا ثتْوَاڒَام. <verse eid="LUK 17:20" /><verse number="21" style="v" sid="LUK 17:21" />لَّا، أَتَاف يوْذَان وَار قَّارن شَا قَا خْزَرث اَقَاث ذِيهَا نِغ اَقَاث ذَا! مَايمِّي؟ أَتَاف ڒْمُلْك ن أَربِّـي اَقَاث ذَايْوم."<verse eid="LUK 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22" />ينَّا-ٱسن إِ يمحْضَارن نّس: "أَذ د اَسنْت ڒِيَّام اَذَايْسنْت ثْرزُّوْم اَذ تࢲرم يجّن ن نْهَار زي نْهُوْرَاث ن مِّيس ن بْنَاذم وَلَكِن وَار ث تْࢲرّم شَا. <verse eid="LUK 17:22" /><verse number="23" style="v" sid="LUK 17:23" />أَذَاوم ينِين يِوْذَان اَقَاث ذَا نِغ اَقَاث ذِيْهَا! وَلَكِن وَار ذِنِّي تْرِيحم شَا، وَار ثن تْذفَّارم شَا. <verse eid="LUK 17:23" /><verse number="24" style="v" sid="LUK 17:24" />مِينْزِي اَم وَاسَّام يتبْسِيسِّيقن ذِي طَّارْف ن وجنَّا اَذ يݣّ ثْفَاوْث ذِي طَّارْف نّغْنِي، أَمنِّي إِي غَا يِيڒِي مِّيس ن بْنَاذم ذِي نْهَار نّس. <verse eid="LUK 17:24" /><verse number="25" style="v" sid="LUK 17:25" />وَلَكِن يتْخصَّا-ٱس ذ اَمزْوَارُو اَذ يتْوَاعدّب اَطَّاس، أَث عِيفّن يِوْذَان ن ڒْوقْث-أَ.<verse eid="LUK 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 17:26" />أَمشْنَاو مَامش يوْقع ذِي ڒِيَّام نِّي ن نُوْح، أَمنِّي إِي غَا يوْقع ذِي ڒِيَّام ن مِّيس ن بْنَاذم: <verse eid="LUK 17:26" /><verse number="27" style="v" sid="LUK 17:27" />يوْذَان تُوْغَا تتّن سسّن، مدْجْشن تْوَاسْمدْجَاشن، حتَّا ٱڒ نْهَار نِّي وَامِي يُوْذف نُوْح ذݣ وغَرَّابُو. يُوْسَا-د طُّوْفَان ينْغِي-ثن مَارَّا إِذْسن.<verse eid="LUK 17:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 17:28" />عَاوذ مَامّش يوْقع ذِي ڒِيَّام ن لُوْط: ئِوْذَان تُوْغَا تتّن سسّن، سَّاغن زْنُوْزَان، تࢲُّوْن بنَّان. <verse eid="LUK 17:28" /><verse number="29" style="v" sid="LUK 17:29" />وَلَكِن ذِي نْهَار نِّي إِي ذِي يفّغ لُوْط زِي ثنْدِينْت ن سَدُوْم صَافِي يسهْوَا-د خَاسن أَربِّـي ثِمسِّي ذ يزْرَا يسّشْمَاضن زݣ وجنَّا، ئِنْغِي-ثن مَارَّا.<verse eid="LUK 17:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 17:30" />أَمنِّي إِي غَا يوقْعن ذِي نْهَار نِّي إِي ذِي د غَا يمظْهَار مِّيس ن بْنَاذم. <verse eid="LUK 17:30" /><verse number="31" style="v" sid="LUK 17:31" />ذِي نْهَار نِّي، ونِّي غَا يِيڒِين خ ثْزقَّا ڒحْوَايج نّس اَقَاثن سْودَّاي ذِي ثدَّارْث يتْخصَّا-ٱس وَار يهوِّي شَا غَار ثدَّارْث حمَا اَذ ييْسِي ڒحْوَايج نّس. عَاوذ ونِّي غَا يِيڒِين ذݣ ومَرْجع يتْخصَّا-ٱس وَار يتعْقِيب شَا غَار ثدَّارْث. <verse eid="LUK 17:31" /><verse number="32" style="v" sid="LUK 17:32" />فكَّرث ذِي مِين ذَاس يوقْعن إِ ثمْغَارْث ن لُوْط! <note caller="+" style="f"><char style="fr" closed="false">17‏.32 </char><char style="ft" closed="false">وَامِي أَربِّـي يسُوْفغ لُوْط ذ ثمْغَارْث نّس زِي ثنْدِينْت ثَعفَّانْت ن سَدُوْم، يعْڒم-اَسن ينَّا-ٱسن وَار خزَّارث شَا غَار ذفَّار. وَلَكِن ثَمْغَارث ن لُوْط ثعْصَا أَربِّـي، ثخْزَر غَار ذفَّار ڒخدّْنِّي يسمْسخ-يت ثذْوڒ ذ اَزْرُو ن ڒمْڒح. خْزَر ذِي لْكِتَاب ن يمزْوُوْرَا 19‏.15‏-26.</char></note><verse eid="LUK 17:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 17:33" />ونِّي يخْسن اَذ يسنْجم ثُوْذَارْث نّس اَتَاف اَت يخْسَر. ونِّي إِي غَا يخْسَرن ثُوْذَارْث نّس اَتَاف اَت يسنْجم. <verse eid="LUK 17:33" /><verse number="34" style="v" sid="LUK 17:34" />أَذَاوم ينِيغ: ذِي دْجِيڒث نِّي اَذ يڒِين ثْنَاين طّْصن ذݣ يِجّن ن ثَاسُّوْث، ئِجّن اَذ يميْسِي يجّن اَذ يقِّيم. <verse eid="LUK 17:34" /><verse number="35" style="v" sid="LUK 17:35" />أَذ يڒِينْت ثْنَاين ن ثمْغَارِين ذِي ثْسِيرْث حرِّينْت ثِحبَّا، ئِشْتن اَذ تْميْسِي يشْتن اَذ تقِّيم. <verse eid="LUK 17:35" /><verse number="36" style="v" sid="LUK 17:36" />{أَذ يڒِين ثْنَاين ن يرْيَازن ذݣ يِج ومَرْجع، ئِجّن اَذ يميْسِي يجّن اَذ يقِّيم."}<verse eid="LUK 17:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37" />سّقْسَان-ث يمحْضَارن نّس نَّان-اَس: "آ سِيذِي، مَانِي غَا يوْقع مَانَايَا؟"</para>
  <para style="p" vid="LUK 17:37">ئِنْدق-د نتَّا ينَّا-ٱسن: "مَانِي دْجَان يمُوْرْضَاس، ذِنِّي إِݣ يتْمُوْنن يبَاغرِيون."<verse eid="LUK 17:37" /></para>
  <chapter eid="LUK 17" />
  <chapter number="18" style="c" sid="LUK 18" />
  <para style="s">ڒْمِثَال ن ثَاجَّاڒْث يرزُّوْن ڒْحَقّ نّس</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1" />ئِسِّيوڒ اَكِذْسن عِيْسَى س يِجّن ن ڒْمَعْنَا بَاش اَذ سّْنن بلِّي يتْخصَّا-يَاسن اَذ تْࢲَادْجن ڒبْدَا وَار تِيحْڒن شَا. <verse eid="LUK 18:1" /><verse number="2" style="v" sid="LUK 18:2" />ينَّا-ٱسن: "ئِجّن ن تْوَاڒَا ذݣ يِجّن ن ثنْدِينْت يجّن ن ڒْقَاضِي وَار يتݣّْوذ شَا أَربِّـي، وَار يتْوقِّير شَا يوْذَان. <verse eid="LUK 18:2" /><verse number="3" style="v" sid="LUK 18:3" />ذِنِّي ذِي ثنْدِينْت نِّي يجّن ن ثَاجَّاڒْث تْرَاح غَارس ثقَّار-اَس: ؤُش-اَيِي ڒْحَقّ ينُو خ ونِّي ذَايِي يضلّْمن <verse eid="LUK 18:3" /><verse number="4" style="v" sid="LUK 18:4" />أَطَّاس زݣ وَامِي يتَاݣِي اَذَاس يُوْش مِين ذَاس تتَّار نتَّاث. وَلَكِن منْبَعْد إِ مَانَايَا ينَّا ذِي نّفْس نّس: وَاخَّا وَار تݣّْوْذغ شَا أَربِّـي، وَار تْوقِّيرغ شَا يوْذَان، <verse eid="LUK 18:4" /><verse number="5" style="v" sid="LUK 18:5" />ثَاجَّاڒْث-أَ صَافِي ثْسِيحڒ-اَيِي. أَذَاس ؤُشغ ڒْحَقّ حمَا وَار د تْعِيقِيب ثْوَاڒَا نّغْنِي اَذَايِي ثْسدّع."<verse eid="LUK 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6" />ينَّا-ٱسن سِيذِيثْنغ: "صنّْطث إِ مِين ينَّا ڒْقَاضِي-يَا يضدْجْمن. <verse eid="LUK 18:6" /><verse number="7" style="v" sid="LUK 18:7" />أَربِّـي، مَا وَار ذَاسن يتِيشّ ڒْحَقّ إِ يِوْذَان نّس إِي ث يتتَّارن دْجِيڒث ذ نْهَار؟ مَا اَخَاسن يعطَّڒ وَار ذَاسن يسْتِيجِيب شَا؟ <verse eid="LUK 18:7" /><verse number="8" style="v" sid="LUK 18:8" />أَذَاوم ينِيغ: أَذَاسن يُوْش ڒْحَقّ ذغْيَا. إِنَّمَا، مِّيس ن بْنَاذم نْهَار إِي ذِي د غَا يَاس، مَا ٱذ يَاف لإِيمَان ذِي ثْمُوْرْث؟"<verse eid="LUK 18:8" /></para>
  <para style="s">ثْࢲَادْجِيث ن صَّح</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9" />يسِّيوڒ س ڒْمَعْنَا-يَا اَك شَان يِوْذَان تُوْغَا تَارَّان يخف نْسن نِيشَان، تْحݣَّارن ينّغْنِي: <verse eid="LUK 18:9" /><verse number="10" style="v" sid="LUK 18:10" />"ئِجّن ن نْهَار رُوْحن يجّن ن ثْنَاين ن يرْيَازن غَار ثمْزِيذَا ثَمقّْرَانْت ن أَيث-إِسْرَائِيل حمَا اَذ ࢲَّادْجن، ئِجّن زِي ڒْحِزب ن يفَرِّيسِيْين، ئِجّن يجمّع ضَّرِيبَا. <verse eid="LUK 18:10" /><verse number="11" style="v" sid="LUK 18:11" />ئِبدّ وفَرِّيسِي نِّي يتْࢲَدْجَا ذِي نّفْس نّس ينَّا: يَا أَربِّـي تْشكَّرغ-شك، مِينْزِي وَار دْجِيغ شَا اَم يِوْذَان نّغْنِي يدْجَان ذ يخوَّانن نِغ ذ يِنِّي وَار يدْجِين شَا نِيشَان نِغ ذ يِنِّي يزنَّان نِغ اَم وَانِيتَا إِݣ يجمّْعن ضَّرِيبَا! <verse eid="LUK 18:11" /><verse number="12" style="v" sid="LUK 18:12" />تْࢲُوْمِّيغ يُوْمَاين ذِي سِّيمَانَا، تْعشَّارغ خ مَارَّا مِين ربْحغ ذ اَݣْڒَا.<verse eid="LUK 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13" />وَلَكِن ونِّي يجمّْعن ضَّرِيبَا يبدّ غَار ڒݣّْوَاج. وَار يزْعِيم حتَّا اَذ ييْسِي ثِيطَّاوِين نّس غَار وجنَّا، ئِشَّاث ذݣ وُوْڒ نّس ينَّا: يَا أَربِّـي، رْحم-اَيِي نش ذ لْعَاصِي!<verse eid="LUK 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 18:14" />أَذَاوم ينِيغ: ونِّي يجمّْعن ضَّرِيبَا يذْوڒ غَار ثدَّارْث نّس مْلِيح يمصْڒَاح اَك أَربِّـي، اَفَرِّيسِي نِّي لَّا. مِينْزِي ونِّي يسمْغَارن يخف نّس، أَتَاف اَذ يِيڒِي ذ اَمزْيَان. ونِّي يسمْزَاين يخف نّس، أَتَاف اَذ يِيڒِي ذ اَمقّْرَان."<verse eid="LUK 18:14" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتْبَرَك يحنْجِيرن يمزْيَانن</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15" />تُوْغَا يِوْذَان تَاوِين-اَس-د ؤُڒَا ذ يسيْمَان إِ عِيْسَى حمَا اَثن يحَاذَا. وَلَكِن يمحْضَارن نّس وَامِي ࢲْرِين مَانَاينِّي تْعَارَّاضن-اَسن. <verse eid="LUK 18:15" /><verse number="16" style="v" sid="LUK 18:16" />ئِكَّر عِيْسَى يڒَاغَا-د خ <char style="it">يحنْجِيرن</char> أُوْشَا ينَّا-ٱسن <char style="it">إِ يمحْضَارن نّس</char>: "جّم يحنْجِيرن يمزْيَانن اَغَارِي د اَسن. وَار ذَاسن تْعَارَّاضم شَا ڒَاحقَّاش ڒْمُلْك ن أَربِّـي يتِيڒِي غَار يِنِّي إِي يدْجَان اَم يِيْنَا. <verse eid="LUK 18:16" /><verse number="17" style="v" sid="LUK 18:17" />أَقَا تسْڒَام ڒْحَقّ: لَابُد إِ بْنَاذم اَذ يَامن س ڒْمُلْك ن أَربِّـي مَامْش زَّايس يتَامن وحنْجِير اَمزْيَان. مڒَا لَّا، أَتَاف بْنَاذم نِّي عمَّارْص اَذ يَاذف ذِي ڒْمُلْك ن أَربِّـي."<verse eid="LUK 18:17" /></para>
  <para style="s">أَرْيَاز يدْجَان ذ تَّاجَر</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18" />ئِسّقْسَا-ث يجّن زِي لْحُكَّام نْ أَيث-إِسْرَائِيل ينَّا-ٱس: "آ لْمُعَلِّم اَصبْحَان، مِين غَا ݣّغ حمَا اَغَارِي ثِيڒِي ثُوْذَارْث ن ڒبْدَا؟"<verse eid="LUK 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19" />يَارَّا خَاس عِيْسَى ينَّا-ٱس: "مَايمِّي ثقَّارذ قَا نش ذ اَصبْحَان؟ وَار يدْجِي حَدّ ذ اَصبْحَان إِلَّا أَربِّـي وَاحْذس. <verse eid="LUK 18:19" /><verse number="20" style="v" sid="LUK 18:20" />ثسّْنذ ڒُوْصِيَاث: وَار زنَّا، وَار نقّ، وَار تَاشَار، وَار شهّذ بُو ࢲُّوْر، وقَّار بَابَاش ذ يمَّاش."<verse eid="LUK 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21" />ينَّا-ٱس ورْيَاز نِّي: "زݣ وَامِي إِي دْجِيغ نش ذ اَمزْيَان تْوقَّارغ قَاع مَانَايَا."<verse eid="LUK 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22" />عِيْسَى وَامِي يسْڒَا إِ وَاوَاڒ نّس ينَّا-ٱس: "قَا ثقِّيم-اَش يجّن ن ڒْحَاجث وَار ت ثݣِّيذ شَا. رُوْح زنْز مَارَّا مِين غَارك ذ اَݣْڒَا صدّق-يث خ ڒْمُسَاكِين. سّنِّي اَغَارك يِيڒِي ڒْكنْز ذݣ وجنَّا، ڒخْدّنِّي اَرَاح-د شك ذْفَار-اَيِي-د." <verse eid="LUK 18:22" /><verse number="23" style="v" sid="LUK 18:23" />وَامِي يسْڒَا إِ مَانَاينِّي يخيّق اَطَّاس ڒَاحقَّاش غَارس اَطَّاس ن وَاݣْڒَا. <verse eid="LUK 18:23" /><verse number="24" style="v" sid="LUK 18:24" />ئِخْزَر ذَايس عِيْسَى ينَّا: "مشْحَاڒ يقْسح خَاسن خ تْوَاجَر اَذ اَذْفن ڒْمُلْك ن أَربِّـي. <verse eid="LUK 18:24" /><verse number="25" style="v" sid="LUK 18:25" />أَقَا يسْهڒ اَذ يعْذُو وڒْغم زِي ثِيطّ ن ثْسيْنفْث قْبڒ مَا ٱذ يَاذف تَّاجَر ذِي ڒْمُلْك ن أَربِّـي!"<verse eid="LUK 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26" />نّان يِنِّي يتسْڒَان: "خْيَار، ؤُݣ يزمَّرن اَذ ينْجم!؟"<verse eid="LUK 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "مِين وَار ذَاس زمَّرن شَا يِوْذَان، ئِزمَّر-اَس أَربِّـي."<verse eid="LUK 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28" />ينَّا-ٱس بُطْرُس: "أَقَا نشِّين نسْمح ذِي كُڒْشِي نذْفَار-يش!"<verse eid="LUK 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29" />ينَّا-ٱسن عِيْسَى: "أَقَا تسْڒَام ڒْحَقّ: مَارَّا ونِّي يسمْحن ذِي ثدَّارْث نّس نِغ ذِي ثمْغَارْث نّس نِغ ذِي اَيْثْمَاس نِغ ذِي بَابَاس نِغ ذِي يمَّاس نِغ ذِي ثَارْوَا نّس عْلَاحْسَاب ڒْمُلْك ن أَربِّـي، <verse eid="LUK 18:29" /><verse number="30" style="v" sid="LUK 18:30" />أَتَاف اَغَارس ثِيڒِي ذِي دُّنشْت-أَ كْتَار س وَاطَّاس. أُو ذِي زْمَان إِي د غَا يَاسن اَتَاف اَغَارس ثِيڒِي ثُوْذَارْث ن ڒبْدَا."<verse eid="LUK 18:30" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى عَاوذ يسَّاوَاڒ خ ڒْموْث نّس</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31" />ئِرُوْح عِيْسَى يُوْوِي ثنْعَاش نِّي <char style="it">ن يمحْضَارن نّس</char> وَاحذْسن ينَّا-ٱسن: "أَقَا نتْݣَعَّاذ غَار لْقُدْس مَانِي إِي غَا يكمّڒ مَارَّا مِين ؤُرِين لْأَنْبِيَا خ مِّيس ن بْنَاذم. <verse eid="LUK 18:31" /><verse number="32" style="v" sid="LUK 18:32" />أَث سلّْمن إِ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل، أَخَاس ضحْشن، أَث سحْقَارن، أَخَاس سُّوْسْفن. <verse eid="LUK 18:32" /><verse number="33" style="v" sid="LUK 18:33" />أَث ؤُوْثن س وسْغُوْن، أَث نْغن. نْهَار وِيس ثڒْتِيَّام اَذ د يكَّر زِي ڒْموْث."<verse eid="LUK 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34" />ئِمحْضَارن نِّي وَار فْهِيمن وَالُو زݣ وَاوَاڒن-أَ. ڒْمَعْنَا ن وَاوَاڒن-أَ ينُوْفَّر خَاسن، وَار سِّينن شَا مِينْخف يسَّاوَاڒ.<verse eid="LUK 18:34" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا يج وضَرْغَاڒ ذِي ثنْدِينْت ن أَرِيحَا</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35" />وَامِي يقَارّب عِيْسَى غَار ثنْدِينْت ن أَرِيحَا، ؤُفِين ذِنِّي يجّن ن وضَرْغَاڒ يقِّيم طَّارْف ن وبْرِيذ يتتَّار. <verse eid="LUK 18:35" /><verse number="36" style="v" sid="LUK 18:36" />وَامِي يسْڒَا إِ ڒْغَاشِي عدُّوْن ينَّا-ٱسن مِين يوقْعن؟ <verse eid="LUK 18:36" /><verse number="37" style="v" sid="LUK 18:37" />نَّان-اَس قَا عِيْسَى نَاصِرِي نتَّا إِي سَّا يعدُّوْن. <verse eid="LUK 18:37" /><verse number="38" style="v" sid="LUK 18:38" />ئِبْذَا يسْنكَّر ثْغُوْيّث يقَّار-اَس: "آ عِيْسَى آ مِّيس ن أَيث-دَاود، رْحم-اَيِي!" <verse eid="LUK 18:38" /><verse number="39" style="v" sid="LUK 18:39" />يِنِّي يزْوَارن إِ عِيْسَى نْهَان-ث نَّان-اَس سْقَار. نتَّا يُوْݣِي، ئِقِّيم يسْنكَّر ثْغُوْيّث عَاذ س جّْهذ يقَّار: "آ مِّيس ن أَيث-دَاود، رْحم-اَيِي!" <verse eid="LUK 18:39" /><verse number="40" style="v" sid="LUK 18:40" />ئِبدّ عِيْسَى يُوْمَر-يثن حمَا اَذَاس ثِيذ اَوِين. وَامِي غَارس د يقَارّب يسّقْسَا-ث ينَّا-ٱس: <verse eid="LUK 18:40" /><verse number="41" style="v" sid="LUK 18:41" />"مِين ثخْسذ اَذَاش ݣّغ؟"</para>
  <para style="p" vid="LUK 18:41">ينَّا-ٱس وضَرْغَاڒ نِّي: "آ سِيذِي، قَا نش خْسغ اَذ تْوَاڒِيغ."<verse eid="LUK 18:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42" />ئِنْدق-د عِيْسَى ينَّا-ٱس: "تْوَاڒَا، قَا لإِيمَان نّش يسْݣنْفَا-شك!" <verse eid="LUK 18:42" /><verse number="43" style="v" sid="LUK 18:43" />ڒخْدّنِّي يبْذَا يتْوَاڒَا، ئِذْفَار عِيْسَى يسمْغَار أَربِّـي. وَامِي ࢲْرِين يِوْذَان نِّي مِين يوقْعن، مَارَّا بْذَان حمّْذن أَربِّـي.<verse eid="LUK 18:43" /></para>
  <chapter eid="LUK 18" />
  <chapter number="19" style="c" sid="LUK 19" />
  <para style="s">سِيذِيثْنغ عِيْسَى ذِي ثدَّارْث ن زَكِي</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1" />يُوْذف عِيْسَى غَار ثنْدِينْت ن أَرِيحَا يعدُّو-د سّنِّي. <verse eid="LUK 19:1" /><verse number="2" style="v" sid="LUK 19:2" />ذِنِّي يجّن ن ورْيَاز ذ تَّاجَر زݣ يمقّْرَانن ن يعشَّارن قَّارن-اَس زَكِي. <verse eid="LUK 19:2" /><verse number="3" style="v" sid="LUK 19:3" />يرزُّو اَذ يسّن عِيْسَى مِين يعْنَا وَلَكِن وَار يزمَّر اَث يࢲر عْلَاحقَّاش ذِنِّي اَطَّاس ن ڒْغَاشِي أُو نتَّا ذ اَقُوْضَاض. <verse eid="LUK 19:3" /><verse number="4" style="v" sid="LUK 19:4" />يُوْزّڒ غَار زَّاث يݣَعّذ خ يِجّن ن ثْشجَّارْث ن ثَازَارْث ن يسمْغَان خ وبْرِيذ نِّي مَانِيس د غَا يكّ عِيْسَى حمَا اَث يࢲر. <verse eid="LUK 19:4" /><verse number="5" style="v" sid="LUK 19:5" />وَامِي يُوْوض عِيْسَى غَار ومْشَان نِّي، يرْفع ثِيطَّاوِين نّس يࢲْرِي-ث ينَّا-ٱس: "هْوَا-د ذغْيَا سّنِّي آ زَكِي، ئِتْخصَّا-ٱيِي نْهَارَا اَذ رَاحغ غَار ثدَّارْث نّش." <verse eid="LUK 19:5" /><verse number="6" style="v" sid="LUK 19:6" />ئِهْوَا-د ذغْيَا يرحّب زَّايس س ڒفْرَاحث.<verse eid="LUK 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 19:7" />ئِوْذَان مَارَّا ࢲْرِين مَانَايَا بْذَان تْݣمْݣُوْمن نَّان قَا يُوْذف عِيْسَى اَذ يقِّيم ذِي ثدَّارْث ن يِجّن ن ورْيَاز ذ لْعَاصِي!<verse eid="LUK 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8" />ئِبدّ زَكِي ينَّا-ٱس إِ سِيذِيثْنغ: "آ سِيذِي، أَذ ؤُشغ اَزْين ن وَاݣْڒَا ينُو إِ ڒْمُسَاكِين. مڒَا شمْثغ شَان يِجّن اَذَاس اَرْنِيغ اَرْبعَا ن ثْسقَّار."<verse eid="LUK 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9" />ينَّا-ٱس عِيْسَى إِ زَاكِي: "نْهَارَا اَيْثْبَاب ن ثدَّارْث-أَ نجْمن مِينْزِي اَرْيَاز-أَ وَانِيتَا ؤُڒَا ذ نتَّا زِي دُّوْرِّيث ن بْرَاهِيم. <verse eid="LUK 19:9" /><verse number="10" style="v" sid="LUK 19:10" />مِّيس ن بْنَاذم يُوْسَا-د حمَا اَذ يرْزُو اَذ يسنْجم يِنِّي يودَّرن."<verse eid="LUK 19:10" /></para>
  <para style="s">ڒْمَعْنَا ن ثْڒَاثَا ن يخدَّامن</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11" />وَامِي تسْڒَان إِ مَانَايَا، ئِسِّيوڒ اَكِذْسن عِيْسَى س يِجّن ن ڒْمَعْنَا نّغْنِي ڒَاحقَّاش تُوْغَاث يُوْذس غَار ثنْذِينْت ن لْقُدْس. عَاوذ تْغِير-اَسن ڒْمُلْك ن أَربِّـي اَذ د يمظْهَار ڒخْدّنِّي. <verse eid="LUK 19:11" /><verse number="12" style="v" sid="LUK 19:12" />ئِنَّا-ٱسن: "ئِجّن ن سِّيّد لْأَصل نّس زݣ يمقّْرَانن يسَفَر <char style="it">زِي ثْمُوْرْث نّس</char> غَار يِجّن ن ثْمُوْرْث ثِݣّْوج حمَا اَذ ييْسِي تسْرِيح اَذ يذْوڒ اَذ يحْكم <char style="it">خ ثْمُوْرْث نّس.</char> <verse eid="LUK 19:12" /><verse number="13" style="v" sid="LUK 19:13" />ئِڒَاغَا-د خ عشْرَا زݣ يخدَّامن نّس، كُڒ يجّن زَّايْسن يُوْشَا-ٱس عشْرَا نْ ڒُوْزْنَاث ن نُّقَارْث. ينَّا-ٱسن: ݣّم زَّايْسنْت تِّجَارَا اَڒ د غَا ذوْڒغ. <verse eid="LUK 19:13" /><verse number="14" style="v" sid="LUK 19:14" />وَلَكِن شَّعْب نّس عِيفّن-ث سذْفَارن-اَس شَا ن نُّوْيَاب اَڒ مَانِي غَا يرَاح بَاش اَذ ينِين قَا نشِّين وَار نخْس شَا اَرْيَاز-أَ اَذ يِيڒِي ذ اَزدْجِيذ خَانغ.<verse eid="LUK 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15" />وَامِي يذْوڒ ذ اَزذْجِيذ يعْقب-د، يُوْمَر حمَا اَذَاس د اَوِين يخدَّامن نِّي ؤُمِي يُوْشَا تْمنْيَاث نِّي حمَا اَذ يخْزَر مشْحَاڒ يرْبح مْكُڒ يجّن زَّايْسن.<verse eid="LUK 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 19:16" />يُوْسَا-د وخدَّام اَمزْوَارُو ينَّا-ٱس: آ سِيذِي، عشْرَا ن ڒُوْزْنَاث ن نُّقَارْث نّش كُڒ يشْتن ثَرْنِي عشْرَا نّغْنِي.<verse eid="LUK 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 19:17" />أَزدْجِيذ نِّي ينَّا-ٱس: ثݣِّيذ مْلِيح آي اَخدَّام اَصبْحَان! شك ذَايك ڒَامَان خ ذْرُوْس، ڒخُّو اَذَاش ؤُشغ اَذ تْحكْمذ خ عشْرَا ن ثْندَّام.<verse eid="LUK 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 19:18" />يُوْسَا-د ونِّي وِيس ثْنَاين ينَّا-ٱس: آ سِيذِي، عشْرَا نِّي ن ڒُوْزْنَاث ن نُّقَارْث إِي ذَايِي ثُوْشِيذ كُڒ يشْتن ثَرْنِي خمْسَا نّغْنِي.<verse eid="LUK 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 19:19" />ينَّا-ٱس وزدْجِيذ: أَذَاش ؤُشغ اَذ تْحكْمذ خ خمْسَا ن ثْندَّام.<verse eid="LUK 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 19:20" />يُوْسَا-د ونِّي وِيس ثْڒَاثَا ينَّا-ٱس: آ سِيذِي، أَقَاش عشْرَا نِّي ن ڒُوْزْنَاث ن نُّقَارْث إِي ذَايِي ثُوْشِيذ. تُوْغَا نش خمّْڒغ-ثنْت ذݣ يِجّن ن زِّيف <verse eid="LUK 19:20" /><verse number="21" style="v" sid="LUK 19:21" />مِينْزِي ݣّْوْذغ زَّايك. شك ذ يجّن ن بْنَاذم ثقْسْحذ، ثْكسِّيذ مِين وَار ثسْرُوْسِيذ ثْمجَّارذ مِين وَار ثْزرّْعذ.<verse eid="LUK 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 19:22" />ئِنْدق-د وزدْجِيذ نِّي ينَّا-ٱس: شك مِين ثنِّيذ اَخَاك حكْمغ زَّايس آي اَخدَّام اَمْشُوْم. إِيوَا ثسّْنذ بلِّي نش ذ يجّن ن ورْيَاز قسْحغ، كسِّيغ مِين وَار سْرُوْسِيغ، مجَّارغ مِين وَار زرّْعغ. <verse eid="LUK 19:22" /><verse number="23" style="v" sid="LUK 19:23" />مَايمِّي وَار ثجِّيذ تْمنْيَاث ينُو غَار يصَرَّافن اَتَاف نش اَذ د اَسغ اَذ يْسِيغ تْمنْيَاث ينُو ذ ڒفْضڒ اَكِذْسنْت؟<verse eid="LUK 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 19:24" />أُوْشَا ينَّا-ٱسن إِ يِنِّي يدْجَان ذِنِّي: كّْسم-اَس عشْرَا ن ڒُوْزْنَاث ن نُّقَارْث إِ وَانِيتَا، اَرْنِيم-ثنْت إِ ونِّي غَار يدْجَا مِيَّا ن ڒُوْزْنَاث ن نُّقَارْث.<verse eid="LUK 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 19:25" />نَّان-اَس: مَايمِّي زَعْمَا آ سِيذِي؟ أَقَا ونِّي صَافِي، غَارس مِيَّا ن ڒُوْزْنَاث ن نُّقَارْث!<verse eid="LUK 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 19:26" />أَذَاوم ينِيغ: وَاه، ونِّي يدْجَان غَارس يتْمَارْنِي-يَاس. وَلَكِن ونِّي وَار غَار يدْجِي شَا، يتْوَاكْسِي-يَاس ؤُڒَا ذ مِين غَارس. <verse eid="LUK 19:26" /><verse number="27" style="v" sid="LUK 19:27" />أَمَّا ڒْعَذْيَان ينُو يِنِّي تُوْغَا وَار يخْسن شَا اَخَاسن يڒِيغ ذ اَزدْجِيذ، أَوِيم-ثن-د ذَانِيتَا نْغم-ثن زَّاثِي."<verse eid="LUK 19:27" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتَاذَاف خ وسْنُوْس غَار ثنْدِينْت ن لْقُدْس</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28" />عِيْسَى وَامِي ينَّا اَوَاڒ-أَ يكَّر نتَّا يݣُّوْر بَاش اَذ يݣَعّذ غَار ثنْدِينْت ن لْقُدْس. <verse eid="LUK 19:28" /><verse number="29" style="v" sid="LUK 19:29" />وَامِي عْڒَاين اَذ يَاوض غَار يبِيلَاجن ؤُمِي قَّارن بَيْت فَاجِي ذ بَيْت عَنْيَا غَار وذْرَار ؤُمِي قَّارن أَذْرَار ن زِّيتُوْن، ئِكَّر نتَّا يسّكّ ثْنَاين زݣ يمحْضَارن نّس <verse eid="LUK 19:29" /><verse number="30" style="v" sid="LUK 19:30" />ينَّا-ٱسن: "رُوْحم غَار وبِيلَاج-ين إِي يدْجَان زَّاثْوم. خْمِي غَا ثَاوْضم ذِنِّي، أَذ تَافم يجّن ن وسْنُوْس يقّن عمَّارْص وَار خَاس ينْيِي حَدّ، فْسِيم-اَس اَوِيم-اَيِي-ث-يد. <verse eid="LUK 19:30" /><verse number="31" style="v" sid="LUK 19:31" />مڒَا يسِّيوڒ غَارْوم شَان يِجّن ينَّا-ٱوم مَايمِّي ذَاس ث فْسِيم، إِنِيم-اَس قَا يحْذَاج-يث سِيذِيثْنغ."<verse eid="LUK 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32" />رُوْحن يِنِّي يتْوَاسكّن غَار زَّاث ؤُفِين مَامّش ذَاسن ينَّا عِيْسَى. <verse eid="LUK 19:32" /><verse number="33" style="v" sid="LUK 19:33" />وَامِي فسِّين إِ وسْنُوْس نِّي نَّان-اَسن اَيْثْبَاب نّس: "مِين تݣّم؟ مَايمِّي ثْفسِّيم إِ وسْنُوْس-أَ؟"<verse eid="LUK 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34" />أَرِّين خَاسن نَّان-اَسن: "ئِحْذَاج-يث سِيذِيثْنغ." <verse eid="LUK 19:34" /><verse number="35" style="v" sid="LUK 19:35" />ڒخْدّنِّي ؤُوِين-ث-يذ غَار عِيْسَى، ݣِّين خَاس يزدْجُوْبَا نْسن سنْين خَاس عِيْسَى.<verse eid="LUK 19:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 19:36" />نتَّا وَامِي تُوْغَا يݣُّوْر، ئِوْذَان تْسُوْن-اَس اَبْرِيذ س يزدْجُوْبَا نْسن. <verse eid="LUK 19:36" /><verse number="37" style="v" sid="LUK 19:37" />ئِقَارّب غَار ثكْسَارْث ن وبْرِيذ زَّاث إِ ؤُذْرَار ن زِّيتُون، بْذَان اَطَّاس ن يمحْضَارن نّس فَرّْحن حمّْذن أَربِّـي س جّْهذ خ مَارَّا لْمُعْجِيزَاث نِّي إِي ࢲْرِين. <verse eid="LUK 19:37" /><verse number="38" style="v" sid="LUK 19:38" />قَّارن: "سَّعْذ ن وزدْجِيذ إِي د يُوْسِين عْلَاحْسَاب يسم ن سِيذِي أَربِّـي. ڒهْنَا ذݣ وجنَّا، لْحَمْدُو إِ أَربِّـي يُوْعْڒَان!"<verse eid="LUK 19:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39" />ڒبْعَاض زِي ڒْحِزب ن يفَرِّيسِيْين يدْجَان ذِي ڒْغَاشِي نِّي نَّان-اَس: "آ لْمُعَلِّم، نْهَا يمحْضَارن نّش."<verse eid="LUK 19:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40" />ينَّا-ٱسن: "أَذَاوم ينِيغ: مڒَا سْقَارن نِثْنِي، أَتَاف يزْرَا اَذ سْنكَّرن ثْغُوْيّث."<verse eid="LUK 19:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41" />وَامِي عْڒَاين اَذ يَاوض غَار ثنْدِينْت ن لْقُدْس، ئِࢲْرِي-ت يبْذَا يتْرُو خَاس. <verse eid="LUK 19:41" /><verse number="42" style="v" sid="LUK 19:42" />ينَّا: "<char style="it">آ ثَنْدِينْت ن لْقُدْس،</char> شم مَعْلِيك تُوْغَا ثسّْنذ نْهَارَا ثِمسْڒَايِين إِي د يتِيشّن ڒهْنَا! وَلَكِن لَّا، ڒخُّو نُوْفَّرنْت خ ثِيطَّاوِين نّم. <verse eid="LUK 19:42" /><verse number="43" style="v" sid="LUK 19:43" />أَقَا اَخَام د اَسن نْهُوْرَاث خْمِي خَام د غَا سنّْضن ڒْعَذْيَان نّمْ يجّن ن صُّوْر، أَذَام د نّْضن، أَشم سحْسَڒن زِي مْكُڒ جِّهث. <verse eid="LUK 19:43" /><verse number="44" style="v" sid="LUK 19:44" />أَشم سْهذْمن شم ذ ثَارْوَا نّمْ إِي يدْجَان غَار ذَاخڒ نّم. وَار ذَايم تجِّين بُو وزْرُو خ ونّغْنِي مِينْزِي يفْقذ-يشم أَربِّـي، شم وَار خَاس ثعْقِيڒذ."<verse eid="LUK 19:44" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى ذِي ثمْزِيذَا ثَمقّْرَانْت</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45" />سّنِّي يُوْذف غَار ثمْزِيذَا ثَمقّْرَانْت ن أَيث-إِسْرَائِيل يبْذَا يتَازّڒ خ يِنِّي يزْنُوْزَان ذِنِّي. <verse eid="LUK 19:45" /><verse number="46" style="v" sid="LUK 19:46" />ينَّا-ٱسن: "لْكِتَاب يقَّار: &lt;ثَدَّارْث ينُو اَذ تِيڒِي ذ ثَدَّارْث ن ثْࢲَادْجِيث.&gt; وَلَكِن كنِّيو ثَارِّيم-تث ذ يفْرِي ن يخوَّانن."<verse eid="LUK 19:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47" />تُوْغَا يسڒْمَاذ مْكُڒ نْهَار ذِي ثمْزِيذَا ثَمقّْرَانْت. أَرُّوْيَاس ن ڒْفُقَهَا ذ يمْسڒْمَاذن ن شَّرِيعَا ذ يمقّْرَانن ن شَّعْب رزُّوْن اَث نْغن. <verse eid="LUK 19:47" /><verse number="48" style="v" sid="LUK 19:48" />وَار ؤُفِين مَامّش غَا ݣّن مِينْزِي مَارَّا شَّعْب تُوْغَا يتسْڒَا-يَاس يقِّيم ذݣ وَاوَاڒ نّس.<verse eid="LUK 19:48" /></para>
  <chapter eid="LUK 19" />
  <chapter number="20" style="c" sid="LUK 20" />
  <para style="s">سُّلْطَا ن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1" />ئِجّن ن نْهَار ذݣ وُوْسَّان نِّي، عِيْسَى اَقَاث ذِي ثمْزِيذَا ثَمقّْرَانْت يسڒْمَاذ يوْذَان يتْبشَّار-يثن، ؤُسِين-د غَارس اَرُّوْيَاس ن ڒْفُقَهَا ذ يمْسڒْمَاذن ن شَّرِيعَا ذ يمقّْرَانن ن أَيث-إِسْرَائِيل. <verse eid="LUK 20:1" /><verse number="2" style="v" sid="LUK 20:2" />كَّرن نَّان-اَس: "إِنِي-يَانغ شك، مَانِيس ذَاش د ثكَّا سُّلْطَا نِّي إِي زِي تݣّذ ثِمسْڒَايِين-أَ؟ وِي ذَاش يُوْشِين سُّلْطَا نِّي؟"<verse eid="LUK 20:2" /></para>
  <para style="p">
    <verse number="3‏-4" style="v" sid="LUK 20:3-4" />ينَّا-ٱسن عِيْسَى: "ؤُڒَا ذ نش اَكنِّيو سّقْسِيغ خ يِجّن ن ثْمسْڒَايْث. إِنِيم-اَيِي: يَحْيَى، مَان سُّلْطَا إِي زِي يطهَّار س وَامَان، مَا زِي أَربِّـي مَا زݣ يِوْذَان؟"<verse eid="LUK 20:3-4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5" />مْشَوَارن جَارَاسن نَّان: "<char style="it">سُّلْطَا نِّي</char>، مڒَا ننَّا-اَس قَا ثكَّا-د زِي أَربِّـي، أَتَاف اَذَانغ يِينِي عِيْسَى مَايمِّي وَار زَّايس ثُوْمِينم شَا؟ <verse eid="LUK 20:5" /><verse number="6" style="v" sid="LUK 20:6" />وَلَكِن مڒَا ننَّا-اَس <char style="it">سُّلْطَا نِّي</char> قَا ثكَّا-د زݣ يِوْذَان، أَتَاف مَارَّا يوْذَان اَذَانغ رجْمن مِينْزِي ؤُمْنن بلِّي يَحْيَى ذ نَّبِي." <verse eid="LUK 20:6" /><verse number="7" style="v" sid="LUK 20:7" />أُوشَا نَّان-اَس إِ عِيْسَى: "نشِّين وَار نسِّين شَا مَانِيس د ثكَّا <char style="it">سُّلْطَا نِّي نّس</char>."<verse eid="LUK 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "إِيوَا ؤُڒَا ذ نش وَار ذَاوم قَّارغ شَا مَانِيس ذَايِي د ثكَّا سُّلْطَا-يَا إِي زِي تݣّغ ثِمسْڒَايِين-أَ."<verse eid="LUK 20:8" /></para>
  <para style="s">ڒْمَعْنَا ن يخمَّاسن إِي ذِي يدْجَا شَّرّْ</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9" />ئِبْذَا عِيْسَى يسَّاوَاڒ اَك شَّعْب س ڒْمَعْنَا-يَا ثَانِيتَا ينَّا-ٱسن: "ئِجّن ن سِّيّد يࢲُّو اَضِيڒ ذݣ يِجّن ن ومَرْجع نّس، يجَّا ذَايس يخمَّاسن صَافِي يرُوْح يسَفَر اَطَّاس ن ڒْوقْث. <verse eid="LUK 20:9" /><verse number="10" style="v" sid="LUK 20:10" />وَامِي د يُوْوض ڒْوقْث ن وڒْقض ن وضِيڒ، ئِكَّر يسّكّ يجّن ن وخدَّام نّس غَار يخمَّاسن نِّي بَاش اَذَاس د وْشن ڒْحَقّ نّس ن ومَرْجع ن وضِيڒ. وَلَكِن مِين ݣِّين يخمَّاسن نِّي؟ ؤُوْثِين-ث، سّكّن-ث-يد يخْوَا. <verse eid="LUK 20:10" /><verse number="11" style="v" sid="LUK 20:11" />ئِرُوْح يسّكّ-اَسن يجّن ن وخدَّام نّغْنِي، وَلَكِن ؤُڒَا ذ ونِّي ؤُوْثِين-ث عدّن خَاس سّكّن-ث-يد يخْوَا. <verse eid="LUK 20:11" /><verse number="12" style="v" sid="LUK 20:12" />ئِسّكّ-اَسن حتَّا ذ يج وخدَّام وِيس ثْڒَاثَا، ؤُڒَا ذ ونِّي جَرْحن-ث ؤُزّْڒن خَاس.<verse eid="LUK 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 20:13" />سّنِّي بَاب ن ومَرْجع ن وضِيڒ ينَّا، مِين غَا ݣّغ؟ صَافِي، نش اَذَاسن سّكّغ ممِّي يعِيزّن يمْكن اَث ݣّْوْذن. <verse eid="LUK 20:13" /><verse number="14" style="v" sid="LUK 20:14" />ئِخمَّاسن نِّي مِين ݣِّين؟ وَامِي ؤُفِين مِّيس يُوْسَا-د، كَّرن نَّان إِ وَايَاوْيَا: أَقَا ونِّي إِي غَا يوَارْثن! أَث نْنغ بَاش اَذَاس نَاوِي اَمَرْجع-أَ ن وضِيڒ! <verse eid="LUK 20:14" /><verse number="15" style="v" sid="LUK 20:15" />نْضَرن-ث-يذ غَار بَارَّا إِ ومَرْجع وضِيڒ نْغِين-ث.</para>
  <para style="p" vid="LUK 20:15">إِوَا، مِين ذَاسن غَا يݣّ بَاب ن ومَرْجع نِّي وضِيڒ إِ يخمَّاسن نِّي؟ <verse eid="LUK 20:15" /><verse number="16" style="v" sid="LUK 20:16" />أَذ د يَاس نتَّا س يِيخف نّس اَذ ينغ يخمَّاسن نِّي مَارَّا، أَذ يجّ اَمَرْجع نِّي وضِيڒ إِ ينّغْنِي."</para>
  <para style="p" vid="LUK 20:16">وَامِي سْڒِين إِ مَانَايَا نَّان: "أَربِّـي يسْتَر!"<verse eid="LUK 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17" />ئِخْزَر غَارْسن ينَّا: "مِين يخس اَذ يِينِي وَاوَاڒ-أَ إِي يُوْرِين ذِي لْكِتَاب؟</para>
  <para style="q1" vid="LUK 20:17">&lt;أَزْرُو إِي عِيفّن يبنَّاين،</para>
  <para style="q1" vid="LUK 20:17">يوْقع ذݣ ومْشَان اَصبْحَان ذِي ثْغمَّارْث ن دْسَاس.&gt;<verse eid="LUK 20:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LUK 20:18" />ونِّي غَا يوْضَان خ وزْرُو-يَا اَذ يرز.</para>
  <para style="q1" vid="LUK 20:18">ونِّي خف غَا يوْضَا وزْرُو-يَا اَذ ينڒْبࢲ."<verse eid="LUK 20:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19" />ڒخْدّنِّي يمْسڒْمَاذن ن شَّرِيعَا ذ اَرُّوْيَاس ن ڒْفُقَهَا رزُّوْن اَذ طّْفن عِيْسَى، فهْمن بلِّي يسَّاوَاڒ خَاسن س ڒْمَعْنَا-يَا وَلَكِن ݣّْوْذن زِي شَّعْب.<verse eid="LUK 20:19" /></para>
  <para style="s">ضَّرِيبَا ن لْمَلِك قَيْصَر</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 20:20" />بْذَان يمْسڒْمَاذن نِّي ن شَّرِيعَا ذ اَرُّوْيَاس ن ڒْفُقَهَا حطَّان عِيْسَى، رزُّوْن اَث طّْفن خ شَان وَاوَاڒن نّس حمَا اَث سلّْمن إِ لْحَاكم ذ سُّلْطَا نّس. رُوْحن سّكّن-اَس إِ عِيْسَى شَان يِوْذَان سْنعْمِيڒن اَقَاثن نِيشَان وَلَكِن نِثْنِي ذ يبرْݣَاݣن. <verse eid="LUK 20:20" /><verse number="21" style="v" sid="LUK 20:21" />سّقْسَان-ث نَّان-اَس: "آ لْمُعَلِّم، نسّن بلِّي شك ثقَّارذ ڒْحَقّ ثْسڒْمَاذذ س ڒْحَقّ. وَار تݣّذ بُو ؤُذمَاون، ثْسڒْمَاذذ س ڒْحَقّ مَامّش يخس أَربِّـي أَ نْعِيش. <verse eid="LUK 20:21" /><verse number="22" style="v" sid="LUK 20:22" />إِنِي-يَانغ، مَا ثْسمّح شَّرِيعَا نّغ أَ نْخدْجس ضَّرِيبَا إِ وزدْجِيذ قَيْصَر نِغ لَّا؟"<verse eid="LUK 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23" />ئِسّن عِيْسَى يخَرْوِيضن نِّي إِي ذَايْسن، ينَّا-ٱسن: <verse eid="LUK 20:23" /><verse number="24" style="v" sid="LUK 20:24" />"أَوِيم-د دِينَار نِّي <char style="it">ن ضَّرِيبَا</char> حمَا اَث ࢲرغ." ينَّا-ٱسن: "وِي يِيڒَان تصْوِيرْث-أَ ذ يِيسم-أَ إِي ذَايس؟"</para>
  <para style="p" vid="LUK 20:24">نَّان-اَس: "ن قَيْصَر."<verse eid="LUK 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "مِين يدْجَان ن قَيْصَر ؤُشم-اَس-ث إِ قَيْصَر، مِين يدْجَان ن أَربِّـي ؤُشم-اَس-ث إِ أَربِّـي." <verse eid="LUK 20:25" /><verse number="26" style="v" sid="LUK 20:26" />نِثْنِي وَار زمَّرن شَا اَذ شمْثن <char style="it">عِيْسَى</char> زِي شَان وَاوَاڒ نّس زَّاث إِ شَّعْب. قِّيمن تْعجّْبن ذݣ وجَاوَاب نّس، وَار ؤُفِين شَا مِين غَا ينِين.<verse eid="LUK 20:26" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتْبشَّار خ ثُوْذَارْث ن ڒبْدَا</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27" />كَّرن شَان يِوْذَان زِي ڒْحِزب ن يصَدُّوْقِيْين قَارّْبن-د غَار عِيْسَى. (قَّارن نِثْنِي بلِّي يوْذَان وَار د تكَّرن شَا زِي ڒْموْث.) سقْسَان عِيْسَى نَّان-اَس: <verse eid="LUK 20:27" /><verse number="28" style="v" sid="LUK 20:28" />"آ لْمُعَلِّم، قَا يُوْرَا-ٱنغ مُوْسَى اَرْيَاز مڒَا يمُّوْث يجَّا ثَمْغَارْث نّس وَار كِذس د يجِّي بُو ثَارْوَا، ثَاجَّاڒْث نِّي لَابُد اَت يَاوِي ؤُڒْوس نّس بَاش اَكِذس د يجّ ثَارْوَا إِ وُوْمَاس نِّي يمُّوْثن. <verse eid="LUK 20:28" /><verse number="29" style="v" sid="LUK 20:29" />نشِّين تُوْغَا اَكِذْنغ سبْعَا ن وَاوْمَاثن، ئِمْڒش ومزْوَارُو يمُّوْث وَار ذ يجِّي بُو ثَارْوَا. <verse eid="LUK 20:29" /><verse number="30‏-31" style="v" sid="LUK 20:30-31" />ثَمْغَارْث نِّي يُوْوِي-ت وِيس ثْنَاين يمُّوْث وَار د يجِّي بُو ثَارْوَا. أَمنِّي عَاوذ وِيس ثْڒَاثَا اَڒ وِيس سبْعَا. <verse eid="LUK 20:30-31" /><verse number="32" style="v" sid="LUK 20:32" />أَڒ ونݣَّارُو ؤُڒَا ذ ثَمْغَارْث نِّي ثمُّوْث. <verse eid="LUK 20:32" /><verse number="33" style="v" sid="LUK 20:33" />يُوْم لْقِيَامَا، ؤُمِي غَا ثِيڒِي ثمْغَارْث نِّي؟ أَقَا ؤُوِين-ت س سبْعَا إِذْسن."<verse eid="LUK 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34" />يَارَّا خَاسن عِيْسَى ينَّا-ٱسن: "وَاه، ثَارْوَا ن دُّنشْت-أَ مدْجْشن تْوَاسْمدْجَاشن. <verse eid="LUK 20:34" /><verse number="35" style="v" sid="LUK 20:35" />وَلَكِن ينّغْنِي يحسّب-يثن أَربِّـي اَغَارْسن ثِيڒِي ثُوْذَارْث ن ڒبْدَا، خْمِي د غَا كَّرن زِي ڒْموْث اَتَاف نِثْنِي وَار مدْجْشن شَا وَار تْوَاسْمدْجِيشن شَا. <verse eid="LUK 20:35" /><verse number="36" style="v" sid="LUK 20:36" />وَار زمَّرن شَا اَذ مّْثن، أَذ يڒِين اَمشْنَاو لْمَلَائِكَاث. نِثْنِي ذ ثَارْوَا ن أَربِّـي، خڒْقن-د ذِي يُوْم لْقِيَامَا.<verse eid="LUK 20:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 20:37" />وَلَكِن شُوْف، يِنِّي يمُّوْثن اَذ د كَّرن زِي ڒْموْث. ؤُڒَا ذ مُوْسَى يسْبيَّان-د مَانَايَا ذِي ڒْقِصَّا ن ؤُخْشَاب<note caller="+" style="f"><char style="fr" closed="false">20‏.37 </char><char style="ft" closed="false">مَاشِي مَعْرُوْف مِين يعْنَا وخْشَاب-أَ، وَلَكِن يمْكن ذ شَان اَرْبِيع اَم ثَابْغَا نِغ اَم شَان ثْشجَّارْث ثَمزْيَانْت ذَايس يسنَّانن.</char></note> وَامِي ينَّا قَا سِيذِي أَربِّـي ذ أَربِّـي ن بْرَاهِيم ذ أَربِّـي ن إِسْحَاق ذ أَربِّـي ن يَعْقُوْب.<note caller="+" style="f"><char style="fr" closed="false">20‏.37 </char><char style="ft" closed="false">سِيذْنَا مُوْسَى تُوْغَا يرَاسّ ڒبْهَايم ن وذݣّْوَاڒ نّس قَّارن-اَس يَثْرُوْن ذ ڒفْقِي ن مِدْيَان. ئِجّن ن نْهَار ينْده ڒبْهَايم غَار صَّحْرَا حتَّا اَڒ مَانِي يُوْوض غَار وذْرَار ن أَربِّـي ؤُمِي قَّارن حُوْرِيب. ذِنِّي إِي ذَاس د ثْمظْهَار لْمَلَائِكَا ن سِيذِي أَربِّـي ذݣ وشعَّار ن ثْمسِّي زِي ڒْوسْط ن يِجّن ن ؤُخْشَاب. ئِࢲْرَا مُوْسَى اَخْشَاب نِّي يحَرّق بْڒَا مَا ث تشّ ثْمسِّي. ينَّا ذِي نّفْس نّس: "أَذ رَاحغ حمَا اَذ خْزَرغ ثَمسْڒَايْث-أَ يسذْهَاشن. مَايمِّي اَخْشَاب-أَ وَار يحَرّق شَا؟" وَامِي يرُوْح ذِنِّي اَذ يخْزَر، ئِࢲْرِي-ث سِيذِي أَربِّـي يبَرّح-اَس-د زِي ڒْوسْط ن ؤُخْشَاب ينَّا-ٱس: "آ مُوْسَى آ مُوْسَى." ينَّا-ٱس مُوْسَى: "هَاقَايِي". ينَّا-ٱس أَربِّـي: "وَار تْقَارّب شَا ذَانِيتَا. كّس ثِسِيڒَا زݣ يضَارن نّش ڒَاحقَّاش اَمْشَان-أَ إِي خف ثْبدّذ نتَّا ذ يجّن ن ثْمُوْرْث مُقدّس." أُوْشَا ينَّا-ٱس: "نش ذ أَربِّـي ن ڒجْذُوْذ نّش ذ أَربِّـي ن بْرَاهِيم ذ أَربِّـي ن إِسْحَاق ذ أَربِّـي ن يَعْقُوْب." ڒخْدّنِّي يسذْحَا مُوْسَى يسَاذَار اَغمْبُوْب نّس يݣّْوذ اَذ يࢲر أَربِّـي.</char></note> <verse eid="LUK 20:37" /><verse number="38" style="v" sid="LUK 20:38" />نتَّا ذ أَربِّـي ن يِنِّي يدَّرن مَاشِي ن يِنِّي يمُّوثن، ڒَاحقَّاش نتَّا مَارَّا يوْذَان اَغَارس يڒِين دَّرن."<verse eid="LUK 20:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39" />نَّان-اَس شَان يمْسڒْمَاذن ن شَّرِيعَا: "آ سِيذِي، ثنِّيذ مْلِيح!" <verse eid="LUK 20:39" /><verse number="40" style="v" sid="LUK 20:40" />أُو سّنِّي وَار يزْعِيم حَدّ اَث يسّقْسَا عَاذ كْتَار.<verse eid="LUK 20:40" /></para>
  <para style="s">لْمَسِيح نتَّا ذ سِيذس ن دَاود</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "مَايمِّي قَّارن قَا لْمَسِيح ذ مِّيس ن دَاود؟ <verse eid="LUK 20:41" /><verse number="42" style="v" sid="LUK 20:42" />قَا دَاود ينَّا نتَّا س يِيخف نّس ذِي لْكِتَاب ن زَّابُوْر:</para>
  <para style="q1" vid="LUK 20:42">&lt;سِيذِي أَربِّـي ينَّا-ٱس إِ سِيذِي: قِّيم-د خ وفُوْسِي ينُو،<verse eid="LUK 20:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="LUK 20:43" />أَڒ د غَا ݣّغ ڒْعَذْيَان نّش سْوَادَّاي إِ يضَارن نّش.&gt;<verse eid="LUK 20:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 20:44" />مَامّش غَا يِيڒِي لْمَسِيح ذ مِّيس ن دَاود؟ نتَّا دَاود يقَّار-اَس إِ لْمَسِيح آ سِيذِي."<verse eid="LUK 20:44" /></para>
  <para style="s">لْمُنَافِقِين</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45" />ينَّا-ٱسن عِيْسَى إِ يمحْضَارن نّس أُو مَارَّا شَّعْب يتسْڒَا-يَاس: <verse eid="LUK 20:45" /><verse number="46" style="v" sid="LUK 20:46" />"حْضَام يخف نْوم زݣ يمْسڒْمَاذن ن شَّرِيعَا. نِثْنِي تخْسن اَذ ؤُيُوْرن س يسڒْهَامن نِّي نْسن، تخْسن اَخَاسن سدْجْمن ذِي ڒسْوَاق، تخْسن اَذ قِّيمن ذݣ يمُوْشَان يمزْوُوْرَا ذِي ثمْزِيذَاوِين ذ ڒفْرُوْح. <verse eid="LUK 20:46" /><verse number="47" style="v" sid="LUK 20:47" />تتّن ثَاجَّاڒِين، سْمظْهَارن-د يخف نْسن تْࢲَادْجَان اَطَّاس حمَا اَذ بيّْنن إِ يِوْذَان بلِّي نِثْنِي صبْحن اَطَّاس زَعْمَا. يِيْنَا، لْحِسَاب نْسن اَذ يِيڒِي يقْصح اَطَّاس!"<verse eid="LUK 20:47" /></para>
  <chapter eid="LUK 20" />
  <chapter number="21" style="c" sid="LUK 21" />
  <para style="s">صَّذَقَا ثَمقّْرَانْت ن يِجّن ن ثَاجَّاڒْث</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1" />ئِخْزَر عِيْسَى يتْوَاڒَا تْوَاجَر مَامّش تݣّن صَّذَقَا نْسن ذِي صّنْدُوْق <char style="it">ن ثمْزِيذَا ثَمقّْرَانْت</char>. <verse eid="LUK 21:1" /><verse number="2" style="v" sid="LUK 21:2" />ئِࢲْرَا عَاوذ يجّن ن ثَاجَّاڒْث ذ ڒْمسْكِينَا وَاهَا ثݣَّا ذِنِّي ثْنَاين يصُوْلْدَان. <verse eid="LUK 21:2" /><verse number="3" style="v" sid="LUK 21:3" />ينَّا: "أَقَا تسْڒَام ڒْحَقّ: ثَاجَّاڒْث-أَ ذ ڒْمسْكِينَا وَاهَا ثݣَّا ذِي صّنْدُوْق كْتَار زِي مِين ݣِّين مَارَّا ينّغْنِي. <verse eid="LUK 21:3" /><verse number="4" style="v" sid="LUK 21:4" />مِينْزِي مَارَّا ينّغْنِي ؤُشِين زِي مِين خَاسن يزَايْذن ذ اَݣْڒَا. نتَّاث لَّا، وَاخَّا ذ ڒْمسْكِينَا وَاهَا ثْصدّق مَارَّا مِين ثعْڒم."<verse eid="LUK 21:4" /></para>
  <para style="s">لْعَلَامَاث ن ڒفْنَا ن دُّنشْت</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5" />شَان يِوْذَان سَّاوَاڒن خ ثمْزِيذَا ثَمقّْرَانْت قَّارن مشْحَاڒ ثصْبَاح، ثْزوّق س وزْرُو اَصبْحَان أُو س صّذْقث.</para>
  <para style="p" vid="LUK 21:5">ئِنْدق-د عِيْسَى ينَّا-ٱسن: <verse eid="LUK 21:5" /><verse number="6" style="v" sid="LUK 21:6" />"ثِمسْڒَايِين-أَ إِي تْوَاڒَام قَا اَذ د يَاس يجّن ن نْهَار وَار ذَا يتْغِيمِي ؤُڒَا ذ يجّن ن وزْرُو خ ونّغْنِي، مَارَّا مَانَايَا اَذ ينهْذم."<verse eid="LUK 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7" />سّقْسَان-ث نَّان-اَس: "آ لْمُعَلِّم، مڒْمِي غَا يوْقع مَانَايَا؟ مِين ثعْنَا لْعَلَامَا نِّي خْمِي عْڒَاين غَا وقْعنْت ثْمسْڒَايِين-أَ؟"<verse eid="LUK 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8" />ينَّا-ٱسن: "حْضَام يخف نْوم حمَا وَار كنِّيو يخدّع حَدّ. أَطَّاس إِي د غَا يَاسن س يِيسم ينُو زَعْمَا اَذ ينِين قَا نش ذ لْمَسِيح! عَاوذ اَذَاوم ينِين قَا ڒْوقْث ثُوْوض-د! وَلَكِن كنِّيو يتْخصَّا وَار ثن تذْفِيرم شَا. <verse eid="LUK 21:8" /><verse number="9" style="v" sid="LUK 21:9" />خْمِي غَا ثسْڒَام خ لْحُرُوْب ذ لْفِيتْنَاث وَار تݣّْوْذم شَا مِينْزِي ثِمسْڒَايِين نِّي لَابُد اَذ وقْعنْت ذ اَمزْوَارُو. وَلَكِن دُّنشْت-أَ عَاذ وَار ثْفنِّي شَا."<verse eid="LUK 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10" />ينَّا-ٱسن: "دُّوْلَا اَذ تهْجم خ دُّوْلَا، لْممْلَكَا اَذ تهْجم خ لْممْلَكَا. <verse eid="LUK 21:10" /><verse number="11" style="v" sid="LUK 21:11" />أَذ يوْقع زِّنْزَال يمْغَر ذݣ وَاطَّاس ن يمُوشَان. أَذ يِيڒِي جُّوْع ذ ڒهْڒَاشَاث ذ وَاطَّاس ن ثْمسْڒَايِين يسَݣّْوَاذن، ذ لْعَلَامَاث ذ ثِمقّْرَانِين ذݣ وجنَّا.<verse eid="LUK 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 21:12" />قْبڒ إِ مَارَّا مَانَايَا اَكنِّيو طّْفن، أَكنِّيو عدّْبن، أَكنِّيو سلّْمن إِ ثمْزِيذَاوِين نْسن. أَكنِّيو حبْسن، أَكنِّيو جَرّن غَار يزدْجِيذن ذ لْحُكَّام عْلَاحْسَاب يسم ينُو. <verse eid="LUK 21:12" /><verse number="13" style="v" sid="LUK 21:13" />مَانَايَا اَغَارْوم يِيڒِي ذ يجّن ن لْفُوْرْصَا إِ شْهَاذث. <verse eid="LUK 21:13" /><verse number="14" style="v" sid="LUK 21:14" />بْڒَا مَا ٱذ تيْسِيم اَمْنُوْس ذ اَمزْوَارُو ذِي ڒَعْقُوْڒَاث نْوم مِينْزِي غَا ثْدَفْعم خ يِيخف نْوم. <verse eid="LUK 21:14" /><verse number="15" style="v" sid="LUK 21:15" />لَّا، أَذَاوم ؤُشغ اَوَاڒن ذ ڒفْهَامث حمَا مَارَّا يِنِّي كِذْوم يتْمنْغَان وَار زمَّرن شَا اَخَاوم د اَرّن. <verse eid="LUK 21:15" /><verse number="16" style="v" sid="LUK 21:16" />أَكنِّيو زّنْزن لْوَالِدِين نْوم ذ أَيْثْمَاثْوم ذ ڒحْبَاب نْوم ذ يمدُّوْكَاڒ نْوم، أَذ نْغن ڒبْعَاض زَّايْوم. <verse eid="LUK 21:16" /><verse number="17" style="v" sid="LUK 21:17" />أَكنِّيو عِيفّن مَارَّا يوْذَان عْلَاحْسَاب يسم ينُو. <verse eid="LUK 21:17" /><verse number="18" style="v" sid="LUK 21:18" />وَاخَّا اَمنِّي وَار يوطِّي ؤُڒَا ذ يج وزُطُّو زݣ وزدْجِيف نْوم. <verse eid="LUK 21:18" /><verse number="19" style="v" sid="LUK 21:19" />س صّْبَار نْوم اَتَاف اَذ تْنجْمم.<verse eid="LUK 21:19" /></para>
  <para style="s">لْعَلَامَاث ن وهْذَام ن ثنْدِينْت ن لْقُدْس</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20" />مڒَا ثࢲْرِيم ثَنْدِينْت ن لْقُدْس نّْضن-اَس-د ڒْعَسْكَار، أَقَا اَذ تسّْنم بلِّي عْڒَاين اَذ تْنهْذم. <verse eid="LUK 21:20" /><verse number="21" style="v" sid="LUK 21:21" />ڒخْدّنِّي يِنِّي يدْجَان ذِي ثْمُوْرْث ن يَهُوْذِيَا يتْخصَّا اَذ اَروْڒن غَار يذُوْرَار؛ ذ يِنِّي يدْجَان ذِي لْقُدْس يتْخصَّا اَذ اَروْڒن غَار بَارَّا؛ ذ يِنِّي يدْجَان ذݣ يمَرْجعِيون يتْخصَّا وَار تِيذْفن شَا غَار لْقُدْس. <verse eid="LUK 21:21" /><verse number="22" style="v" sid="LUK 21:22" />أَقَا ڒِيَّام نِّي ذ ڒِيَّام ن وعْمُوْذ، أَذَايْسن يكمّڒ مَارَّا مِين يُوْرِين ذِي لْكُتُب ن لْأَنْبِيَا. <verse eid="LUK 21:22" /><verse number="23" style="v" sid="LUK 21:23" />يَا تَمَارَا خ ثمْغَارِين نِّي إِي غَا يِيڒِين س يعدِّيسن ذݣ وُوْسَّان نِّي ذ ثِنِّي يسُّوْطُوْضن! مِينْزِي ذِي ثْمُوْرْث-أَ اَذ يوْقع يجّن ن وعدّب ذ اَمقّْرَان ذ وغْضَب خ شَّعْب-أَ. <verse eid="LUK 21:23" /><verse number="24" style="v" sid="LUK 21:24" />أَثن نْغن س ڒسْيُوْف، أَثن اَوِين ذ يمحْبَاس غَار مَارَّا ڒݣْنُوْس. سّنِّي يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل اَذ هذْمن لْقُدْس اَڒ غَا فْنَانْت لْأَوْقَات نْسن.<verse eid="LUK 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25" />أَذ د مظْهَارنْت لْعَلَامَاث ذ ثِمقّْرَانِين ذِي ثْفُوْشْت ذ ثْزِيرِي ذ يِيثْرَان. ذِي ثْمُوْرْث، ڒݣْنُوْس اَذ يِيڒِي ذَايْسن اَمْنُوْس مِينْزِي وَار فْهِيمن شَا إِ سّْدَع ن ڒْمُوْجَاث ن ڒبْحَر. <verse eid="LUK 21:25" /><verse number="26" style="v" sid="LUK 21:26" />أَذ سخْفن يِوْذَان س ثِيݣّْوْذِي ذ ومْنُوْس خ مِين يتوْقِيعن ذِي دُّنشْت مِينْزِي مَارَّا يِنِّي يجهْذن ذݣ وجنَّا اَثن يسنْهزّ أَربِّـي. <verse eid="LUK 21:26" /><verse number="27" style="v" sid="LUK 21:27" />ڒخْدّنِّي إِي غَا ࢲرن مِّيس ن بْنَاذم يهوَّا-د ذݣ وسيْنُو س لْعَظَمَا ذ جّْهذ نّس يمْغَارن. <verse eid="LUK 21:27" /><verse number="28" style="v" sid="LUK 21:28" />خْمِي غَا يبْذَا اَذ يوْقع مَانَايَا، بدّث سْݣَعّذث اَزدْجِيف نْوم مِينْزِي عْڒَاين اَذ تْنجْمم."<verse eid="LUK 21:28" /></para>
  <para style="s">ڒْمَعْنَا ن ثْشجَّارْث ن ثَازَارْث</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29" />ئِسِّيوڒ اَكِذْسن عِيْسَى س يِجّن ن ڒْمَعْنَا ينَّا-ٱسن: "خْزَرث غَار ثْشجَّارْث ن ثَازَارْث ذ مَارَّا ڒْشجُّوْر. <verse eid="LUK 21:29" /><verse number="30" style="v" sid="LUK 21:30" />غِير ڒفْرُوْع نّس اَذ حبّْبن اَذ ݣّن ثِيفْرَاي اَتَاف اَذ تسّْنم يَالَّاه اَنبْذُو يقَارّب-د. <verse eid="LUK 21:30" /><verse number="31" style="v" sid="LUK 21:31" />أَمنِّي ؤُڒَا ذ كنِّيو، خْمِي غَا ثࢲرم ثِمسْڒَايِين-أَ يتوْقِيعن اَتَاف اَذ تسّْنم إِلَّا ڒْمُلْك ن أَربِّـي يُوْذس-د. <verse eid="LUK 21:31" /><verse number="32" style="v" sid="LUK 21:32" />أَقَا تسْڒَام ڒْحَقّ: ئِوْذَان ن ڒْوقْث-أَ وَار تْمتِّين شَا اَڒ غَا يوْقع مَارَّا مَانَايَا. <verse eid="LUK 21:32" /><verse number="33" style="v" sid="LUK 21:33" />أَذ يفْنَا وجنَّا ذ ثْمُوْرْث، وَلَكِن اَوَاڒن ينُو وَار فنِّين شَا عمَّارْص.<verse eid="LUK 21:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34" />مَا ثخْسم اَذ تشّم ؤُڒ نْوم؟ حْضَاث يخف نْوم زِي لْمَدّْلَا ن سّكْرَا ذ وَاطَّاس ن شّْرب ذ ڒهْمُوْم ن دُّنشْت-أَ. قَا اَذ د يَاس نْهَار نِّي اَنݣَّارُو عْلَاغَفْلَا اَم يِجّن ن ثخْشفْث. <verse eid="LUK 21:34" /><verse number="35" style="v" sid="LUK 21:35" />نْهَار نِّي اَذ يطّف مَارَّا يِنِّي يدْجَان خ ثْمُوْرْث. <verse eid="LUK 21:35" /><verse number="36" style="v" sid="LUK 21:36" />حْضَاث، ࢲَادْجم ذِي مْكُڒ ڒْوقْث حمَا اَتَاف ثْزمَّرم اَذ تْنجْمم زِي مَارَّا مِين غَا يوقْعن اَذ تْبدّم زَّاث إِ مِّيس ن بْنَاذم."<verse eid="LUK 21:36" /></para>
  <para style="b" />
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37" />كُڒ نْهَار عِيْسَى يتْرَاح يسڒْمَاذ ذِي ثمْزِيذَا ثَمقّْرَانْت. س دْجِيڒث يتْرَاح يسْنُوْسَا ذݣ وذْرَار ن زِّيتُوْن. <verse eid="LUK 21:37" /><verse number="38" style="v" sid="LUK 21:38" />مَارَّا يوْذَان تْرَاحن غَارس زِيش غَار ثمْزِيذَا ثَمقّْرَانْت حمَا اَذ صنّْطن إِ وَاوَاڒ نّس.<verse eid="LUK 21:38" /></para>
  <chapter eid="LUK 21" />
  <chapter number="22" style="c" sid="LUK 22" />
  <para style="s">يَهُوْذَا يتَافق اَذ يزّنْز سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1" />ئِقَارّب-د ڒْعِيذ ن ثفْضِيرْث ؤُمِي قَّارن ڒْعِيذ اَمقّْرَان ن أَيث-إِسْرَائِيل. <verse eid="LUK 22:1" /><verse number="2" style="v" sid="LUK 22:2" />أَرُّوْيَاس ن ڒْفُقَهَا ذ يمْسڒْمَاذن ن شَّرِيعَا رزُّوْن مَامّش ذَاس غَا ݣّن حمَا اَذ نْغن عِيْسَى وَلَكِن ݣّْوْذن زِي شَّعْب.<verse eid="LUK 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3" />يُوْذف شِّيطَان ذݣ وُوْڒ ن يَهُوْذَا ونِّي ؤُمِي قَّارن إِسْخَرْيُوطِي، نتَّا زِي ثنْعَاش نِّي ن اَرُّسُل. <verse eid="LUK 22:3" /><verse number="4" style="v" sid="LUK 22:4" />ئِكَّر يرُوْح اَذ يتَافق اَك اَرُّوْيَاس ن ڒْفُقَهَا ذ يمقّْرَانن ن يعسَّاسن ن ثمْزِيذَا ثَمقّْرَانْت ن أَيث-إِسْرَائِيل خ مَامْش غَا يݣّ اَذَاسن يزّنْز عِيْسَى. <verse eid="LUK 22:4" /><verse number="5" style="v" sid="LUK 22:5" />فَرْحن، وعْذن-ث اَذَاس ؤُشن تْمنْيَاث. <verse eid="LUK 22:5" /><verse number="6" style="v" sid="LUK 22:6" />سّنِّي يوَافق نتَّا، يرزُّو لْفُرْصَا مَامّش إِي غَا يݣّ اَذ يزّنْز عِيْسَى بْڒَا مَا ٱكِذس يِيڒِي شَّعْب.<verse eid="LUK 22:6" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى ذ يمحْضَارن نّس تتّن اَمنْسِي ن ڒْعِيذ</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7" />يُوْوض-د نْهَار ن ڒْعِيذ ن ثفْضِيرْث نْهَار نِّي إِي ذِي غَرّْصن إِ ڒْعِيذ. <verse eid="LUK 22:7" /><verse number="8" style="v" sid="LUK 22:8" />ئِرُوْح عِيْسَى يسّكّ بُطْرُس ذ يُوْحَنَّا ينَّا-ٱسن: "رُوْحم سْوجْذم-اَنغ اَمنْسِي ن ڒْعِيذ اَمقّْرَان حمَا اَث نشّ."<verse eid="LUK 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9" />نَّان-اَس: "مَانِي ثخْسذ اَ نْرَاح اَث نْسوْجذ؟"<verse eid="LUK 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10" />ينَّا-ٱسن: "خْمِي غَا ثَاذْفم غَار ثنْدِينْت، أَكِذْوم يمڒْقَا يجّن ن ورْيَاز ييْسِي-د اَقْنُوْش ن وَامَان، ذْفَارم-ث غَار ثدَّارْث مَانِي غَا يَاذف. <verse eid="LUK 22:10" /><verse number="11" style="v" sid="LUK 22:11" />إِنِيم-اَس إِ بَاب ن ثدَّارْث نِّي: قَا ينَّا-ٱش لْمُعَلِّم، مَانِي يدْجَا وخَّام ن ينوْجِيون إِي ذِي غَا عيّْذغ نش ذ يمحْضَارن ينُو؟ <verse eid="LUK 22:11" /><verse number="12" style="v" sid="LUK 22:12" />أَكنِّيو يَاوِي غَار يِجّن ن ثْغُوْرْفَات ذ ثَمقّْرَانْت ثسُّو، ثعْذڒ. ذِنِّي إِي ذَانغ غَا ثسْوجْذم."<verse eid="LUK 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 22:13" />رُوْحن ؤُفِين نِيشَان مَامْش ذَاسن ينَّا. صَافِي سْوجْذن اَمنْسِي ن ڒْعِيذ.<verse eid="LUK 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14" />وَامِي د تُوْوض ڒْوقْث، يُوْسَا-د عِيْسَى يقِّيم غَار مِيسَّا اَذ يشّ اَك اَرُّسُل نّس. <verse eid="LUK 22:14" /><verse number="15" style="v" sid="LUK 22:15" />ينَّا-ٱسن: "مشْحَاڒ نش تُوْغَا تْرَاجِيغ اَكِذْوم مُوْنْسْوغ ذِي ڒْعِيذ اَمقّْرَان-أَ قْبڒ إِي غَا تْوَاعدّْبغ. <verse eid="LUK 22:15" /><verse number="16" style="v" sid="LUK 22:16" />أَقَا قَّارغ-اَوم: زِي سَّا اَڒ ثْسَاونْت وَار زَّايس تتّغ شَا اَڒ غَا يوْقع ذِي ڒْمُلْك ن أَريِّي." <verse eid="LUK 22:16" /><verse number="17" style="v" sid="LUK 22:17" />ئِيْسِي-د عِيْسَى ڒْكَاس يشكَّر أَربِّـي ينَّا-ٱسن: "إِيْسِيم ڒْكَاس-أَ، فرْقم-ث جَارَاوم. <verse eid="LUK 22:17" /><verse number="18" style="v" sid="LUK 22:18" />أَقَا قَّارغ-اَوم: زِي سَّا اَڒ ثْسَاونْت وَار سسّغ شَا زݣ وَامَان-أَ ن وضِيڒ اَڒ د غَا يَاس ڒْمُلْك ن أَربِّـي."<verse eid="LUK 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19" />ئِيْسِي اَغْرُوْم يشكَّر أَربِّـي يرْزِي-ث يُوْشَا-ٱسن-ث ينَّا-ٱسن: "ذ وَا إِݣ يدْجَان ذ دَّات ينُو إِي غَا يمُّوْشن عْلَاحْسَاب كنِّيو. تݣّث مَانَايَا حمَا اَذَايِي ثْفكَّرم."<verse eid="LUK 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 22:20" />أَمُّو عَاوذ منْبَعْد إِ ومنْسِي ييْسِي-د ڒْكَاس ينَّا-ٱسن: "ڒْكَاس-أَ ذ ڒْعَهذ ذ جْذِيذ إِي كِذْوم تݣّغ س يذَامّن<note caller="+" style="f"><char style="fr" closed="false">22‏.20 </char><char style="ft" closed="false">ئِذَامّن نتَّا ذ دّم.</char></note> ينُو اَذ اَزّْڒن عْلَاحْسَاب كنِّيو." <verse eid="LUK 22:20" /><verse number="21" style="v" sid="LUK 22:21" />ينَّا-ٱسن: "وَلَكِن ونِّي يرزُّوْن اَذَايِي يزّنْز فُوْس نّس اَقَاث اَكِذِي خ مِيسَّا. <verse eid="LUK 22:21" /><verse number="22" style="v" sid="LUK 22:22" />مِّيس ن بْنَاذم اَذَاس يوْقع عْلَاحْسَاب مَامْش خَاس يقَّار لْكِتَاب، وَلَكِن يَا ڒفْضِيحث ن بْنَاذم نِّي إِي ث غَا يزّنْزن." <verse eid="LUK 22:22" /><verse number="23" style="v" sid="LUK 22:23" />بْذَان يمحْضَارن سَّاوَاڒن جَارَاسن قَّارن، مَانْون زَّايْنغ إِي غَا يݣّن مَانَايَا؟<verse eid="LUK 22:23" /></para>
  <para style="s">ؤُݣ يدْجَان ذ اَمقّْرَان؟</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24" />تْمنْغَان عَاوذ اَك وَايَاوْيَا عْلَاحْسَاب ونِّي يحسّْبن زَّايْسن ذ اَمقّْرَان. <verse eid="LUK 22:24" /><verse number="25" style="v" sid="LUK 22:25" />ينَّا-ٱسن عِيْسَى: "ئِزدْجِيذن ن ڒݣْنُوْس حكّْمن خ شُّعُوْب نْسن. لْحُكَّام نْسن قَّارن-اَسن سَّادَات. <verse eid="LUK 22:25" /><verse number="26" style="v" sid="LUK 22:26" />وَلَكِن مَانَاينِّي يتْخصَّا وَار يتِيڒِي شَا جَارَاوم؛ لَّا، ونِّي يدْجَان ذ اَمقّْرَان جَارَاوم يتْخصَّا-يَاس اَذ يِيڒِي اَم ومزْيَان نْوم ذ ونِّي يحكّْمن يتْخصَّا-يَاس اَذ يِيڒِي اَم ونِّي يتْسخَّارن. <verse eid="LUK 22:26" /><verse number="27" style="v" sid="LUK 22:27" />ؤُݣ يدْجَان ذ اَمقّْرَان؟ مَا ذ ونِّي يقِّيمن اَذ يشّ نِغ ذ ونِّي إِي خَاس يتْسخَّارن؟ يَاش ذ ونِّي يقِّيمن اَذ يشّ نِغ لَّا؟ وَلَكِن نش اَقَايِي اَكِذْوم اَم ونِّي إِي خَاوم يتْسخَّارن.<verse eid="LUK 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 22:28" />ذ كنِّيو إِي كِذِي يصْبَارن ذِي ڒمْحَاين ينُو. <verse eid="LUK 22:28" /><verse number="29" style="v" sid="LUK 22:29" />مَامش ذَايِي يُوْشَا بَابَا يجّن ن ڒْمُلْك إِ نش، ؤُڒَا ذ نش اَذَاوم ؤُشغ يجّن ن ڒْمُلْك. <verse eid="LUK 22:29" /><verse number="30" style="v" sid="LUK 22:30" />يعْنِي ذِي ڒْمُلْك ينُو اَذ تقِّيمم اَكِذِي غَار مِيسَّا اَذ تشّم اَذ تسْوم. أَذ تقِّيمم خ ڒْعَرْشَاث حمَا اَذ تْحكْمم خ ثنْعَاش ن ثْقبَّاڒ ن أَيْث-إِسْرَائِل."<verse eid="LUK 22:30" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسَّاوَاڒ خ ونْكَر ن بُطْرُس</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31" />ينَّا-ٱس عِيْسَى: "خْزَر آ سِمْعَان: شِّيطَان يرْزُّو اَكنِّيو يغَرْبڒ اَم مَامّش تْغَارْبَڒن يرْذَان. <verse eid="LUK 22:31" /><verse number="32" style="v" sid="LUK 22:32" />تتَّارغ اَكِذش غَار سِيذِي أَربِّـي حمَا لإِيمَان نّش وَار ينقّص شَا. خْمِي غَارِي د غَا ثْذوْڒذ، شجّع اَيْثْمَاش."<verse eid="LUK 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33" />ينَّا-ٱس بُطْرُس: "آ سِيذِي، أَقَايِي اَكِذش وجْذغ مڒَا ثُوْذْفذ ڒحْبس اَكِذش اَذْفغ، مڒَا ثمُّوْثذ اَكِذش مّْثغ."<verse eid="LUK 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34" />يَارَّا خَاس عِيْسَى ينَّا-ٱس: "أَذَاش ينِيغ آ بُطْرُس: قْبڒ مَا ٱذ يدّن ويَازِيض نْهَارَا اَتَاف اَذَايِي ثنْكَرذ ثْڒَاثَا ن ثْوَاڒَاثِين وَار ذَايِي ثسِّينذ شَا."<verse eid="LUK 22:34" /></para>
  <para style="b" />
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35" />ڒخْدّنِّي ينَّا-ٱسن عِيْسَى إِ يمحْضَارن نّس: "وَامِي كنِّيو سّكّغ بْڒَا ثَزعْبُوْڒْث، بْڒَا اَقْرَاب، بْڒَا ثِسِيڒَا، مَا يخصِّي-كنِّيو شَا؟"</para>
  <para style="p" vid="LUK 22:35">نَّان-اَس: "لَّا."<verse eid="LUK 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36" />ينَّا-ٱسن: "ڒخُّو ونِّي غَار ثدْجَا شَان ثْزعْبُوْڒْث نِغ شَان وقْرَاب اَث ييْسِي. ونِّي وَار غَار يدْجِي شَا سِّيف، أَذ يزّنز اَرُّوْض نّس اَث يسغ. <verse eid="LUK 22:36" /><verse number="37" style="v" sid="LUK 22:37" />أَذَاوم ينِيغ: أُو لَابُد اَذَايِي يوْقع مِين يُوْرِين ذِي لْكِتَاب عْلَاحْسَاب مَامش يقَّار: &lt;حسْبن-ث اَك لْمُجْرِمِين.&gt; إِيوَا مِين خَافِي يُوْرِين صَافِي اَذ يوْقع."<verse eid="LUK 22:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38" />نَّان-اَس: "أَقَا غَارْنغ ثْنَاين ن ڒسْيُوْف آ سِيذِي."</para>
  <para style="p" vid="LUK 22:38">ينَّا-ٱسن: "وَاه، صَافِي."<verse eid="LUK 22:38" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتْࢲَادْجَا ذݣ وذْرَار ن زِّيتُوْن</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39" />ئِفّغ عِيْسَى اَم ڒبْدَا يرُوْح غَار وذْرَار ن زِّيتُوْن، ذْفَارن-ث عَاوذ يمحْضَارن نّس. <verse eid="LUK 22:39" /><verse number="40" style="v" sid="LUK 22:40" />وَامِي يُوْوض غَار ومْشَان نِّي ينَّا-ٱسن: "ࢲَّادْجم حمَا وَار تِيذْفم شَا ذِي ڒمْحَاين." <verse eid="LUK 22:40" /><verse number="41" style="v" sid="LUK 22:41" />ئِبعّذ خَاسن شْوَايْت، ئِسجّذ غَار ثْمُوْرْث يبْذَا يتتَّار إِ أَربِّـي. <verse eid="LUK 22:41" /><verse number="42" style="v" sid="LUK 22:42" />ينَّا: "آ بَابَا، مڒَا ثخْسذ سْبعّذ-يث خَافِي ڒْكَاس-أَ ن ڒَعْذَاب. مَاشِي مَامْش خْسغ نش؛ لَّا، مَامْش يخس ڒْخَاضَر نّش شك." <verse eid="LUK 22:42" /><verse number="43" style="v" sid="LUK 22:43" />ڒخْدّنِّي ثْبدّ-د غَارس يجّن ن لْمَلَائِكَا زݣ وجنَّا حمَا اَذَاس ثُوْش جّْهذ. <verse eid="LUK 22:43" /><verse number="44" style="v" sid="LUK 22:44" />ئِخيّق وُوْڒ نّس يَرْنِي يتْࢲَادْجَا كْتَر عَاذ، ثِيذِي نّس ثهْوَا-د زَّايس غَار ثْمُوْرْث ثݣَّا اَم ثْنقِّيضِين ن يذَامّن نِيشَان. <verse eid="LUK 22:44" /><verse number="45" style="v" sid="LUK 22:45" />وَامِي يكمّڒ ثْࢲَادْجِيث نّس، ئِذْوڒ غَار يمحْضَارن نّس يُوْفِي-ثن طّْصن س لْحُزن. <verse eid="LUK 22:45" /><verse number="46" style="v" sid="LUK 22:46" />ينَّا-ٱسن: "مَايمِّي تطّْصم؟ كَّرم، ࢲَّادْجم حمَا وَار تِيذْفم شَا ذِي ڒمْحَاين."<verse eid="LUK 22:46" /></para>
  <para style="s">أَيث-إِسْرَائِيل ذ يرُوْمَانِيْين تطّْفن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47" />يَالَّاه عِيْسَى يسَّاوَاڒ يُوْوض-د يَهُوْذَا، ئِجّن زِي ثنْعَاش ن اَرُّسُل نّس. يُوْوِي-د اَكِذس ڒْغَاشِي اَطَّاس، ئِقَارّب غَارس حمَا اَخَاس يسدْجم خ وغمْبُوْب نّس. <verse eid="LUK 22:47" /><verse number="48" style="v" sid="LUK 22:48" />ينَّا-ٱس عِيْسَى: "مَا س سْڒَام-أَ إِي زِي غَا ثْزّنْزذ مِّيس ن بْنَاذم آ يَهُوذَا؟"<verse eid="LUK 22:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49" />وَامِي ࢲْرِين يمحْضَارن مَانَايَا نَّان-اَس: "آ سِيذِي، مَا أَ نُوْوث س سِّيف؟" <verse eid="LUK 22:49" /><verse number="50" style="v" sid="LUK 22:50" />ئِجّن زݣ يِنِّي ذِنِّي يدْجَان يُوْوْثَا يسْمغ ن اَرَّايس ن ڒْفُقَهَا يقسّ-اَس اَمزُّوْغ اَفُوْسِي. <verse eid="LUK 22:50" /><verse number="51" style="v" sid="LUK 22:51" />ينَّا-ٱسن عِيْسَى: "صَافِي، بدّث!" ئِحَاذَا اَمزُّوْغ ن ورْيَاز نِّي يسْݣنْفَا-ث. <verse eid="LUK 22:51" /><verse number="52" style="v" sid="LUK 22:52" />ينَّا-ٱسن عِيْسَى إِ اَرُّوْيَاس ن ڒْفُقَهَا ذ يمقّْرَانن ن يعسَّاسن ن ثمْزِيذَا ثَمقّْرَانْت ذ يمقّْرَانن ن أَيث-إِسْرَائِيل إِي غَارس د يُوْسِين: "مَا تْغِير-اَوم قَا نش ذ لْمُجْرِم وَامِي د ثيْسِيم ڒسْيُوْف ذ يدبُّوْزن حمَا اَذَايِي ثطّْفم نِغ؟ <verse eid="LUK 22:52" /><verse number="53" style="v" sid="LUK 22:53" />تُوْغَا تْغِيمِيغ اَكِذْوم مْكُڒ نْهَار ذِي ثمْزِيذَا ثَمقّْرَانْت، وَار ذَايِي ثطِّيفم شَا. وَلَكِن ڒخُّو ذ ثْسَعَّات نْوم ذ جّْهذ ن ثَادْجسْث."<verse eid="LUK 22:53" /></para>
  <para style="s">بُطْرُس ينكَّر سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54" />طّْفن عِيْسَى، ؤُوِين-ث غَار ثدَّارْث ن اَرَّايس ن ڒْفُقَهَا سِيذْفن-ث. ئِذْفَار-يث بُطْرُس زي ڒݣّْوَاج. <verse eid="LUK 22:54" /><verse number="55" style="v" sid="LUK 22:55" />شعّْڒن ثِمسِّي ذِي ڒْوسْط ن ڒمْرَاح ن ثدَّارْث. قِّيمن ذِنِّي، ئِقِّيم اَكِذْسن بُطْرُس. <verse eid="LUK 22:55" /><verse number="56" style="v" sid="LUK 22:56" />ثࢲْرِي-ث يجّن ن ثْخدَّانْت يقِّيم زَّاث إِ ثْمسِّي، ثخْزَر ذَايس مْلِيح، ثنَّا-ٱسن: "بْنَاذم-أَ وَانِيتَا تُوْغَا يدْجَا اَكِذس."<verse eid="LUK 22:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57" />ئِنْكَر بُطْرُس ينَّا-ٱس: "آ ثَمْغَارْث، وَار ث سِّينغ شَا."<verse eid="LUK 22:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58" />منْبَعْد شْوَايْت يࢲْرِي-ث يجّن نّغْنِي ينَّا-ٱس: "شك ذ يجّن زَّايْسن؟"</para>
  <para style="p" vid="LUK 22:58">ينَّا-ٱس بُطْرُس: "آ بْنَاذم، نش لَّا!"<verse eid="LUK 22:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59" />وَامِي ثعْذُو شَان ثْسَعَّات ينَّا-ٱس يجّن نّغْنِي أُو نتَّا مْأَكّد: "ذ صَّح، أَثَرَّاس-أَ وَانِيتَا تُوْغَا يدْجَا اَكِذس مِينْزِي ؤُڒَا ذ نتَّا زِي لْجَلِيل."<verse eid="LUK 22:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60" />ينَّا-ٱس بُطْرُس: "آ بْنَاذم، نش وَار سِّينغ شَا مِينْخف ثسَّاوَاڒذ شك!" نتَّا وَامِي تُوْغَاث عَاذ يسَّاوَاڒ، ڒخْدّنِّي يدّن ويَازِيض. <verse eid="LUK 22:60" /><verse number="61" style="v" sid="LUK 22:61" />ئِنقْڒب-د سِيذِيثْنغ يخْزَر غَار بُطْرُس، بُطْرُس يفكَّر-د اَوَاڒ نِّي إِي ذَاس ينَّا سِيذِيثْنغ: قْبڒ مَا ٱذ يدّن ويَازِيض اَتَاف اَذَايِي ثنْكَرذ ثْڒَاثَا ن ثْوَاڒَاثِين. <verse eid="LUK 22:61" /><verse number="62" style="v" sid="LUK 22:62" />ئِفّغ غَار بَارَّا يرُو يمطَّاون ذ يمدْجَاحن اَطَّاس.<verse eid="LUK 22:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63" />بْذَان يِنِّي يحطَّان عِيْسَى ضحّْشن خَاس شَّاثن-ث. <verse eid="LUK 22:63" /><verse number="64" style="v" sid="LUK 22:64" />ڒحّْفن-اَس خ وغمْبُوْب نّس قَّارن-اَس: "إِوَا آ نَّبِي سِيوڒ، سّن ؤُو ش يُوْوْثِين زَّايْنغ!" <verse eid="LUK 22:64" /><verse number="65" style="v" sid="LUK 22:65" />اَرْنِين خ وَاوَاڒن نِّي، قَّارن-اَس ثِمسْڒَايِين نّغْنِي وَار يحْڒِين شَا.<verse eid="LUK 22:65" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى زَّاث إ جْمَاعث ن لْحُكَّام ن أَيث-إِسْرَائِيل</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66" />وَامِي يصْبح ڒْحَاڒ مُوْنن يمقّْرَانن ن أَيث-إِسْرَائِيل ذ اَرُّوْيَاس ن ڒْفُقَهَا ذ يمْسڒْمَاذن ن شَّرِيعَا، ؤُوِين عِيْسَى غَار جْمَاعث ن لْحُكَّام نْسن. <verse eid="LUK 22:66" /><verse number="67" style="v" sid="LUK 22:67" />نَّان-اَس: "مڒَا شك ذ لْمَسِيح إِنِي-يَانغ-ت!"</para>
  <para style="p" vid="LUK 22:67">ينَّا-ٱسن: "مڒَا نِيغ-اَوم-ت، كنِّيو اَتَاف وَار ذَايِي تِيمْنم شَا. <verse eid="LUK 22:67" /><verse number="68" style="v" sid="LUK 22:68" />مڒَا سّقْسِيغ-كنِّيو، أَتَاف وَار ذَايِي تْجِيوِيبم شَا. <verse eid="LUK 22:68" /><verse number="69" style="v" sid="LUK 22:69" />وَلَكِن زِي سَّا اَڒ ثْسَاونْت اَذ يقِّيم مِّيس ن بْنَاذم خ وفُوْسِي ن لْقَوِي."<verse eid="LUK 22:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70" />نَّان-اَس مَارَّا إِذْسن: "إِيوَا شك ذ مِّيس ن أَربِّـي بَعْدَا؟"</para>
  <para style="p" vid="LUK 22:70">ينَّا-ٱسن: "أَقَا ثنَّام-ث كنِّيو ذ نش."<verse eid="LUK 22:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71" />ڒخْدّنِّي نَّان: "مَا عَاذ أَ نحْذَاج شَا ن ڒشْهُوْذ؟ نشِّين مَارَّا إِذْنغ نسْڒَا-يَاس مِين ينَّا نتَّا س وقمُّوْم نّس."<verse eid="LUK 22:71" /></para>
  <chapter eid="LUK 22" />
  <chapter number="23" style="c" sid="LUK 23" />
  <para style="s">تَاوِين سِيذِيثْنغ عِيْسَى غَار لْحَاكم بِيلَاطُوْس</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1" />كَّرن مَارَّا إِذْسن ؤُوِين عِيْسَى اَث سلّْمن إِ لْحَاكم بِيلَاطُوْس. <verse eid="LUK 23:1" /><verse number="2" style="v" sid="LUK 23:2" />بْذَان تْتَاهْمن-ث نَّان: "نُوْفِي-ث يتݣّ لْبلْبَلَا ذِي شَّعْب. ئِقَّار-اَسن وَار تِيشّث بُو ضَّرِيبَا إِ وزدْجِيذ قَيْصَر. نتَّا يحسّب يخف نّس ذ لْمَسِيح يعْنِي ذ يجّن ن وزدْجِيذ."<verse eid="LUK 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3" />ئِسّقْسَا-ث بِيلَاطُوْس ينَّا-ٱس: "مَا ذ شك ذ اَزدْجِيذ ن أَيث-إِسْرَائِيل؟"</para>
  <para style="p" vid="LUK 23:3">ينَّا-ٱس عِيْسَى: "أَقَا ثنِّيذ-ت شك."<verse eid="LUK 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4" />ينَّا-ٱسن بِيلَاطُوْس إِ اَرُّوْيَاس ن ڒْفُقَهَا ذ ڒْغَاشِي نِّي: "وَار خَاس تِيفغ بُو شَان تُّهْمث خ وثَرَّاس-أَ."<verse eid="LUK 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5" />وَلَكِن نِثْنِي زيَّارن خَاس اَطَّاس نَّان-اَس: "ئِتݣّ ڒْفِتْنَا ذِي مَارَّا ثَمُوْرْث ن يَهُوْذِيَا س وسڒْمذ نّس. ئِبْذَا ذِي ثْمُوْرْث ن لْجَلِيل، ڒخُّو اَقَاث ذَا."<verse eid="LUK 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6" />وَامِي يسْڒَا بِيلَاطُوْس بلِّي نَّان لْجَلِيل ينَّا-ٱسن: "مَا اَرْيَاز-أَ زِي ثْمُوْرْث ن لْجَلِيل؟" <verse eid="LUK 23:6" /><verse number="7" style="v" sid="LUK 23:7" />وَامِي يسّن بلِّي عِيْسَى زِي ثْمُوْرْث نِّي مَانِي يتحْكَام هِيرُوْدُس، ئِكَّر يسّكّ-يث غَار هِيرُوْدُس يدْجَان نتَّا س يِيخف نّس ذِي ثنْدِينْت ن لْقُدْس ذِي ڒْوقْث نِّي.<verse eid="LUK 23:7" /></para>
  <para style="s">تَاوِين سِيذِيثْنغ عِيْسَى غَار وزدْجِيذ هِيرُوْدُس</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8" />وَامِي يࢲْرَا هِيرُوْدُس عِيْسَى يفَرح اَطَّاس. تُوْغَا يخس اَث يࢲر اَطَّاس زݣ وَامِي. وَامِي خَاس يسْڒَا يتْمنَّا اَذ يݣّ عِيْسَى شَان لْمُعْجِيزَا زَّاثس. <verse eid="LUK 23:8" /><verse number="9" style="v" sid="LUK 23:9" />ئِسّقْسَا-ث اَطَّاس وَلَكِن عِيْسَى وَار خَاس د يَارِّي شَا قَاع.<verse eid="LUK 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 23:10" />أَرُّوْيَاس ن ڒْفُقَهَا ذ يمْسڒْمَاذن ن شَّرِيعَا بدّن ذِنِّي تَهَامن-ث اَطَّاس.<verse eid="LUK 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 23:11" />ئِحݣَّار-يث هِيرُوْدُس ذ ڒْعَسْكَار نّس ضحّْشن خَاس. يݣَّا خَاس اَسڒْهَام ذ اَصبْحَان، يَارِّي-ث غَار بِيلَاطُوْس. <verse eid="LUK 23:11" /><verse number="12" style="v" sid="LUK 23:12" />قْبڒ، بِيلَاطُوْس ذ هِيرُوْدُس تُوْغَا ذِين لْعَدَاوَا جَارَاسن وَلَكِن ڒخُّو ذوْڒن ذ يمدُّوْكَاڒ ذِي نْهَار نِّي.<verse eid="LUK 23:12" /></para>
  <para style="s">لْحَاكم بِيلَاطُوْس يرزُّو اَذَاس د يضْڒق إِ سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13" />ئِڒَاغَا-د بِيلَاطُوْس خ اَرُّوْيَاس ن ڒْفُقَهَا ذ لْحُكَّام ن أَيث-إِسْرَائِيل ذ مَارَّا شَّعْب. <verse eid="LUK 23:13" /><verse number="14" style="v" sid="LUK 23:14" />ينَّا-ٱسن: "كنِّيو ثُوْوِيم-اَيِي-د بْنَاذم-أَ ثنِّيم-اَيِي قَا يتݣّ ڒْفِتْنَا جَار يِوْذَان. نش خمّْمغ ذِي ثْمسْڒَايْث-أَ زَّاثْوم. وَار ذَايس ؤُفِيغ ذݣ وثَرَّاس-أَ بُو شَان تُّهْمث عْلَاحْسَاب مِين ثقَّارم كنِّيو. <verse eid="LUK 23:14" /><verse number="15" style="v" sid="LUK 23:15" />ؤُڒَا ذ هِيرُوْدُس وَار ذَايس يُوْفِي وَالُو مِينْزِي يَارَّا-اَنغ-ث-يد. خْزَرث، عِيْسَا-يَا وَار يݣِّي مِين خف يسْذَاهدْج ڒْموْث. <verse eid="LUK 23:15" /><verse number="16‏-17" style="v" sid="LUK 23:16-17" />أَذَاس ؤُشغ اَعْمُوْذ اَذَاس د ضڒْقغ."<note caller="+" style="f"><char style="fr" closed="false">23‏.16‏-17 </char><char style="ft" closed="false">تُوْغَا بِيلَاطُوْس يعَفُّو ذِي مْكُڒ ڒْعِيذ اَمقّْرَان خ يِجّن ن ومحْبُوْس اَذ يفّغ.</char></note><verse eid="LUK 23:16-17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18" />ئِسْنكَّر ثْغُوْيّث مَارَّا شَّعْب نَّان-اَس: "إِيْسِي خَانغ وَانِيتَا، ضْڒق-اَنغ-د إِ بَارَابَاس." <verse eid="LUK 23:18" /><verse number="19" style="v" sid="LUK 23:19" />بَارَابَاس-أَ تُوْغَا ݣِّين-ث ذِي ڒحْبس عْلَاحْسَاب يِجّن ن ڒْفَوْضَا ثوْقع ذِي ثنْدِينْت، عَاوذ عْلَاحْسَاب يجّن ن لْجَرِيمَا ن ڒْموْث.<verse eid="LUK 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20" />بِيلَاطُوْس يخس اَذ د يضْڒق إِ عِيْسَى، ئِسِّيوڒ اَك شَّعْب ثْوَاڒَا نّغْنِي. <verse eid="LUK 23:20" /><verse number="21" style="v" sid="LUK 23:21" />نِثْنِي سْنكَّرن ثْغُوْيّث نَّان-اَس: "صلّب-يث! صلّب-يث!"<verse eid="LUK 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22" />ئِسِّيوڒ اَكِذْسن وِيس ثڒْت-مَرَّاث ينَّا-ٱسن: "مَايمِّي؟ مَان لْجَرِيمَا إِݣ يݣَّا وَانِيتَا؟ نش وَار ذَايس ؤُفِيغ بُو شَان تُّهْمث إِي خف غَا يسْذَاهدْج ڒْموْث. نش اَذَاس ؤُشغ اَعْمُوْذ اَذَاس د ضڒْقغ." <verse eid="LUK 23:22" /><verse number="23" style="v" sid="LUK 23:23" />نِثْنِي سْنكَّرن ثْغُوْيّث س جّْهذ حمَا اَث يصلّب، صَافِي ثْغُوْيّث نْسن ثقْڒب-اَس اَرَّاي. <verse eid="LUK 23:23" /><verse number="24" style="v" sid="LUK 23:24" />ئِكَّر بِيلَاطُوْس يحْكم س مِين خْسن نِثْنِي. <verse eid="LUK 23:24" /><verse number="25" style="v" sid="LUK 23:25" />ئِضْڒق-د إِ ونِّي يدْجَان ذِي ڒحْبس خ سَّبَاب ن ڒْفَوْضَا ذ لْجَرِيمَا ن ڒْموْث، ئِسلّم-اَسن عِيْسَى حمَا اَذَاس ݣّن مِين خْسن.<verse eid="LUK 23:25" /></para>
  <para style="s">تَاوِين سِيذِيثْنغ عِيْسَى اَث صلّْبن</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26" />وَامِي ؤُوِين عِيْسَى اَث صلّْبن، طّْفن يجّن ن ورْيَاز زِي ثنْدِينْت ن لْقُرِينَا قَّارن-اَس سِمْعَان، أَرْيَاز-أَ يكَّا-د زِي ڒْكَامْپُـو يعْذُو-د سّنِّي. سَرْبُوْن-اَس ڒْعَسْكَار صَّلِيب حمَا اَث يَرْبُو اَذ يذْفَار عِيْسَى. <verse eid="LUK 23:26" /><verse number="27" style="v" sid="LUK 23:27" />ذْفَارن-ث اَطَّاس ن ڒْغَاشِي، ثِمْغَارِين حزْننْت تْرُوْنْت خَاس. <verse eid="LUK 23:27" /><verse number="28" style="v" sid="LUK 23:28" />ئِنقْڒب-د غَارْسنْت عِيْسَى ينَّا-ٱسنْت: "آي يسِّيس ن لْقُدْس وَار خَافِي تْرُونْت شَا، رُوْنْت خ يِيخف نْكنْت ذ ثَارْوَا نْكنْت. <verse eid="LUK 23:28" /><verse number="29" style="v" sid="LUK 23:29" />أَذ د تَاس يجّن ن ڒْوقْث اَذَايس ينِين: سَّعْذ نْسنْت ن ثِنِّي وَار يزمَّرن شَا اَذ اَرْونْت ذ ثِنِّي عمَّارْص وَار ؤُرِيونْت شَا ذ ثِنِّي عَمَّارْص وَار سُّوْطْضنْت شَا. <verse eid="LUK 23:29" /><verse number="30" style="v" sid="LUK 23:30" />أَذ بْذَان اَذ ينِين إِ يذُوْرَار وْضَام-د خَانغ، أَذ ينِين إِ ثعْرُوْرِين قْبَارنْت-يد خَانغ. <verse eid="LUK 23:30" /><verse number="31" style="v" sid="LUK 23:31" />مڒَا يوْذَان-أَ يِيْنَا ݣِّين مَانَايَا إِ ثْشجَّارْث ذ ثَزيْزَاوْث، مِين ذَاس غَا يوقْعن خْمِي غَا ثَازغ؟"<verse eid="LUK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32" />عَاوذ ؤُوِين-د ثْنَاين نّغْنِي ذ لْمُجْرِمِين حمَا اَكِذس تْوَانْغن.<verse eid="LUK 23:32" /></para>
  <para style="s">ئِرُوْمَانِيْين تْصلَّابن سِيذِيثْنغ عِيْسَى خ صَّلِيب</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 23:33" />وَامِي ؤُوْضن غَار ومْشَان نِّي ؤُمِي قَّارن جُمْجُمَا، صلّْبن-ث ذِنِّي اَك ثْنَاين نِّي ن لْمُجْرِمِين، ئِجّن خ وفُوْسِي يجّن خ وࢲڒْمَاذ. <verse eid="LUK 23:33" /><verse number="34" style="v" sid="LUK 23:34" />ينَّا عِيْسَى: "آ بَابَا، غْفَر يوْذَان-أَ قَا وَار سِّينن شَا مِين تݣّن." ڒْعَسْكَار نِّي ݣِّين لْقُرْعَا خ وَارُّوْض نّس حمَا كُڒ يجّن مِين غَا ييْسِي.<verse eid="LUK 23:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 23:35" />ئِوْذَان بدّن ذِنِّي خزَّارن ذَايس، أَرُّوْيَاس تْبُوْصَارن خَاس قَّارن: "مڒَا ذ صَّح نتَّا ذ لْمَسِيح إِي يخْضَر أَربِّـي اَتَاف اَذ يسنْجم يخف نّس مِينْزِي يسنْجم ينّغْنِي." <verse eid="LUK 23:35" /><verse number="36" style="v" sid="LUK 23:36" />عَاوذ ؤُڒَا ذ ڒْعَسْكَار ضحّْشن خَاس، قَارّْبن غَارس ؤُشِين-اَس اَمَان وضِيڒ ذ يسمَّامن. <verse eid="LUK 23:36" /><verse number="37" style="v" sid="LUK 23:37" />نَّان-اَس: "مڒَا شك ذ اَزدْجِيذ ن أَيث-إِسْرَائِيل سنْجم يخف نّش." <verse eid="LUK 23:37" /><verse number="38" style="v" sid="LUK 23:38" />غَار وزدْجِيف نّس ݣِّين-اَس يجّن ن ثڒْوِيحت ثُوْرَا ذَايس: وَانِيتَا ذ اَزدْجِيذ ن أَيث-إِسْرَائِيل.<verse eid="LUK 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39" />ئِجّن زِي لْمُجْرِمِين نِّي إِي كِذس صلّْبن يبْذَا يتْزَوَر-يث يقَّار-اَس: "شك مَا ذ لْمَسِيح مَا لَّا؟ يَالَّاه، نجَّا يخف نّش نجَّا-يَانغ."<verse eid="LUK 23:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40" />ئِنْهَا-ث ونِّي نّغْنِي ينَّا-ٱس: "شك مَا وَار تݣّْوِيذذ شَا أَربِّـي؟ قَا حكّْمن خَاك اَمشْنَاو نتَّا. <verse eid="LUK 23:40" /><verse number="41" style="v" sid="LUK 23:41" />نشِّين حكّْمن خَانغ نِيشَان، نسْذَاهدْج لْحُكم-أَ عْلَاحْسَاب مِين نݣَّا. وَلَكِن اَرْيَاز-أَ وَار يݣِّي شَا مِينْخف." <verse eid="LUK 23:41" /><verse number="42" style="v" sid="LUK 23:42" />ڒخْدّنِّي ينَّا-ٱس: "عْقڒ خَافِي آ عِيْسَى خْمِي د غَا ثَاسذ غَار ڒْمُلْك نّش."<verse eid="LUK 23:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43" />ئِنْدق-د عِيْسَى ينَّا-ٱس: "أَقَا تسْڒِيذ ڒْحَقّ: نْهَارَا اَذ تِيڒِيذ اَكِذِي ذِي جّنّث."<verse eid="LUK 23:43" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يمُّوْث خ صَّلِيب</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44" />غَار ثنْعَاش ن وزِيڒ، ثهْوَا-د ثَادْجسْت خ ثْمُوْرْث اَمن-ثكْمَاڒ اَڒ وَامِي ذ ثْڒَاثَا وعشِّي. <verse eid="LUK 23:44" /><verse number="45" style="v" sid="LUK 23:45" />ثْفُوْشْت ثْرُوْح-اَس ثْفَاوْث نّس، ئِقَّارص اَرّْوَاق ن ثمْزِيذَا ثَمقّْرَانْت خ ثْنَاين. <verse eid="LUK 23:45" /><verse number="46" style="v" sid="LUK 23:46" />ئِڒَاغَا عِيْسَى س يِجّن ن ثْمِيجَّا ثجْهذ ينَّا: "آ بَابَا، نش بُوْحْبڒ ينُو سلّْمغ-اَش-ث ذݣ يفَاسّن نّش." وَامِي ينَّا مَانَايَا يَارَّا نّفْس صَافِي يمُّوْث. <verse eid="LUK 23:46" /><verse number="47" style="v" sid="LUK 23:47" />أَعَسْكَارِي نِّي اَمقّْرَان ن اَرُّوْمَانُوْس <char style="it">إِي يدْجَان ذِنِّي</char> وَامِي يࢲْرَا مِين يوقْعن يبْذَا يسمْغَار أَربِّـي ينَّا: "أَثَرَّاس-أَ ذ صَّح بَرِيء إِي يدْجَا." <verse eid="LUK 23:47" /><verse number="48" style="v" sid="LUK 23:48" />مَارَّا يوْذَان إِي ذِنِّي يمُوْنن وَامِي ࢲْرِين مِين يوقْعن، تْروَّاحن-د شَّاثن ذݣ وُوْڒَاون نْسن. <verse eid="LUK 23:48" /><verse number="49" style="v" sid="LUK 23:49" />مَارَّا يمْعَشَارن نّس ذ ثمْغَارِين إِي ث يذْفَارن زِي لْجَلِيل بدّن غَار ڒݣّْوَاج ࢲْرِين مَانَاينِّي.<verse eid="LUK 23:49" /></para>
  <para style="s">نطّْڒن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50" />ذِنِّي يجّن ن ورْيَاز قَّارن-اَس يُوْسف زِي جْمَاعث ن لْحُكَّام ن أَيث-إِسْرَائِيل، نتَّا ذ يجّن ن ورْيَاز يصْبَاح يدْجَان نِيشَان. <verse eid="LUK 23:50" /><verse number="51" style="v" sid="LUK 23:51" />وَار يقبِيڒ شَا مِينْخف ثْتَافق جْمَاعث نِّي ذ مِين ثْخدّم. نتَّا زݣ وبِيلَاج ن أَرِيمَاتْيَا إِي يدْجَان ذِي ثْمُوْرْث ن يَهُوْذِيَا. ئِتْرحَّاب عَاوذ زِي ڒْمُلْك ن أَربِّـي. <verse eid="LUK 23:51" /><verse number="52" style="v" sid="LUK 23:52" />ئِرُوْح غَار بِيلَاطُوْس يتَّار-اَس دَّات ن عِيْسَى. <verse eid="LUK 23:52" /><verse number="53" style="v" sid="LUK 23:53" />ئِرُوْح يُوْسف يسهْوَا-ت-يد.<note caller="+" style="f"><char style="fr" closed="false">23‏.53 </char><char style="ft" closed="false">ئِعْنِي، ئِسهْوَا-د دَّات ن سِيذِيثْنغ عِيْسَى زِي صَّلِيب.</char></note> ئِكفّن-يت س ڒشْفن. ئِسرْس-يت ذݣ يِجّن ن ونْضڒ يغْزِين ذݣ وزْرُو <char style="it">يݣَّا اَم يِيفْرِي</char>، عمَّارْص وَار ذَايس ينْضِيڒ حَدّ. <verse eid="LUK 23:53" /><verse number="54" style="v" sid="LUK 23:54" />نْهَار نِّي تُوْغَا ذ جّمْعَا، ئِسْرَائِيلِيْين سوْجَاذن إِ نْهَار ن سّبْث ن لْعِبَادَا إِي تُوْغَا عْڒَاين اَذ يبْذَا. <verse eid="LUK 23:54" /><verse number="55" style="v" sid="LUK 23:55" />ثِمْغَارِين نِّي إِي د يُوْسِين اَك عِيْسَى زِي لْجَلِيل ذْفَارنْت يُوْسف غَار ونْضڒ ࢲْرِينْت-ث ذ مَامْش ذَايس ينْضڒ دَّات نّس. <verse eid="LUK 23:55" /><verse number="56" style="v" sid="LUK 23:56" />ذوْڒنْت غَار ثدَّارْث سوْجَاذنْت لْعِيطَر ذ وَامَان ن لْوَرْذ. ذِي نْهَار ن لْعِبَادَا قِّيمنْت ريّْحنْت عْلَاحْسَاب ڒُوْصِيّث نِّي <char style="it">ن مُوْسَى</char>.<verse eid="LUK 23:56" /></para>
  <chapter eid="LUK 23" />
  <chapter number="24" style="c" sid="LUK 24" />
  <para style="s">سِيذِيثْنغ عِيْسَى يكَّر-د زِي ڒْموْث</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1" />نْهَار اَمزْوَارُو ن سِّيمَانَا يعْنِي ذ ڒْحَد، ثِمْغَارِين نِّي رُوْحنْت غَار صْبَاح زِيش غَار <char style="it">يِيفْرِي ن</char> ونْضڒ نِّي، ؤُوِينْت لْعِطَر إِي تُوْغَا سْوجْذنْت. <verse eid="LUK 24:1" /><verse number="2" style="v" sid="LUK 24:2" />ؤُفِينْت اَزْرُو يتْوَاكّس خ ونْضڒ. <verse eid="LUK 24:2" /><verse number="3" style="v" sid="LUK 24:3" />وَامِي ؤُذْفنْت ذَايس وَار ؤُفِينْت شَا ذِنِّي دَّات ن سِيذِيثْنغ عِيْسَى. <verse eid="LUK 24:3" /><verse number="4" style="v" sid="LUK 24:4" />نِثنْتِي وَامِي قِّيمنْت ذهّْشنْت ذِي مَانَاينِّي، بدّن-د غَارْسنْت ثْنَاين ن يثَرَّاسن ݣِّين اَرُّوْض يتْشعْشِع.<note caller="+" style="f"><char style="fr" closed="false">24‏.4 </char><char style="ft" closed="false">ئِثَرَّاسن-أَ نِثْنِي ذ لْمَلَائِكَاث، تْشَابَّاهن ذِي بْنَاذم.</char></note> <verse eid="LUK 24:4" /><verse number="5" style="v" sid="LUK 24:5" />ݣّْوْذنْت ثمْغَارِين نِّي اَطَّاس سجّْذنْت غَار ثْمُوْرْث، نَّان-اَسنْت ثْنَاين ن يثَرَّاسن نِّي: "مَايمِّي ثْرزُّوْنْت خ ونِّي يدَّرن جَار يِنِّي يمُّوْثن؟ <verse eid="LUK 24:5" /><verse number="6" style="v" sid="LUK 24:6" />نتَّا وَار ذَا يدْجِي شَا، ئِكَّر-د زِي ڒْموْث. مَا وَار ثعْقِيڒنْت شَا وَامِي كِذْوم يسِّيوڒ أُو نتَّا تُوْغَاث عَاذ ذِي ثْمُوْرْث ن لْجَلِيل؟ <verse eid="LUK 24:6" /><verse number="7" style="v" sid="LUK 24:7" />ينَّا-ٱوم قَا يتْخصَّا مِّيس ن بْنَاذم اَذ يتْوَاسلّم إِ يِنِّي يعصَّان، نِثْنِي اَث صلّْبن نتَّا اَذ د يتْوَاسكَّر ذِي نْهَار ن وِيس ثڒْتِيَّام." <verse eid="LUK 24:7" /><verse number="8" style="v" sid="LUK 24:8" />سّنِّي نِثنْتِي عقْڒنْت خ وَاوَاڒ نِّي ن عِيْسَى.<verse eid="LUK 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 24:9" />ذوْڒنْت-يد زݣ ونْضڒ سِّيوْضنْت مَارَّا ڒخْبَار-أَ غَار حِيطَاش ن اَرُّسُل ذ مَارَّا ينّغْنِي. <verse eid="LUK 24:9" /><verse number="10" style="v" sid="LUK 24:10" />ثِنِّي يسِّيوْضن ڒخْبَار-أَ غَار اَرُّسُل نِثنْتِي ذ مَرْيَم ثَمَݣْدَالِيث، ذ أَيُوْنَّا، ذ مَرْيَم يمَّاس ن يَعْقُوْب، ذ ثِنّغْنِي. <verse eid="LUK 24:10" /><verse number="11" style="v" sid="LUK 24:11" />أَرُّسُل-أَ وَار ؤُمِينن شَا ثِمْغَارِين نِّي مِينْزِي فكَّرن نِثنْتِي سَّاوَاڒنْت وَاهَا. <verse eid="LUK 24:11" /><verse number="12" style="v" sid="LUK 24:12" />وَلَكِن بُطْرُس يكَّر يُوْزّڒ غَار <char style="it">يِيفْرِي ن</char> ونْضڒ نِّي، وَامِي يسِّيج ذِنِّي يُوْفَا ڒشْفن يمَارْس وَاحْذس. ئِرُوْح نتَّا يذْوڒ غَار ثدَّارث يتْعجّب ذِي نّفْس نّس عْلَاحْسَاب مِين يوقْعن.<verse eid="LUK 24:12" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يمْظهَّار-د خ وبْرِيذ ن دْشَار ن عِينْوَاس</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13" />نْهَار نِّي، ثْنَاين ن يمحْضَارن نّس تْرَاحن غَار يِجّن ن دْشَار قَّارن-اَس عِينْوَاس. ئِݣّْوج خ ثنْذِينْت ن لْقُدْس يجّن ن حِيطَاش ن كِيلُوْمِت. <verse eid="LUK 24:13" /><verse number="14" style="v" sid="LUK 24:14" />سَّاوَاڒن جَارَاسن خ ثْمسْڒَايِين يوقْعن. <verse eid="LUK 24:14" /><verse number="15" style="v" sid="LUK 24:15" />وَامِي سَّاوَاڒن تمْنَاقَاشن يمڒْقَا اَكِذْسن عِيْسَى نتَّا س يِيخف نّس يبْذَا يݣُّوْر اَكِذْسن. <verse eid="LUK 24:15" /><verse number="16" style="v" sid="LUK 24:16" />وَلَكِن نِثْنِي وَار يتْوَاسْمِيح شَا اَث عقْڒن.<verse eid="LUK 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 24:17" />ينَّا-ٱسن عِيْسَى: "مِين يعْنَا مَانَايَا إِي خف ثسَّاوَاڒم اَمُّو وَامِي ثُوْݣُّوْرم ذݣ وبْرِيذ؟" بدّن، ئِبَان لْحُزن خ وُوْذم نْسن.<verse eid="LUK 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 24:18" />ئِنْدق-د يجّن زَّايْسن قَّارن-اَس كْلُوْپَـاس ينَّا-ٱس: "مَا ذ شك وَاحْذش ذَانِيتَا إِي د يزُوْرن غَار لْقُدْس ذݣ وُوْسَّان-أَ قَا وَار ثسِّينذ شَا مِين يوقْعن؟!"<verse eid="LUK 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19" />ينَّا-ٱسن عِيْسَى: "مِين يوقْعن ذِنِّي؟"</para>
  <para style="p" vid="LUK 24:19">نَّان-اَس: "قَا عِيْسَى نَاصِرِي تُوْغَا يدْجَا ذ يجّن ن نَّبِي غَارس جّْهذ ذِي مِين يتݣّ ذ مِين يقَّار زَّاث إِ أَربِّـي ذ مَارَّا يوْذَان. <verse eid="LUK 24:19" /><verse number="20" style="v" sid="LUK 24:20" />طّْفن-ث اَرُّوْيَاس ن ڒْفُقَهَا ذ لْحُكَّام نّغ سلّْمن-ث اَث نْغن، صلّْبن-ث. <verse eid="LUK 24:20" /><verse number="21" style="v" sid="LUK 24:21" />نشِّين تُوْغَا نتْمنَّا بلِّي ذ نتَّا إِي غَا يسْنجْمن أَيْث-إِسْرَائِيل! نْهَارَا ذ وِيس ثڒْتِيَّام زݣ وَامِي يوْقع مَانَايَا. <verse eid="LUK 24:21" /><verse number="22" style="v" sid="LUK 24:22" />عَاوذ ذِنِّي شَان ثمْغَارِين زَّايْنغ جِّينْت-اَنغ نسْتْعجّب مِينْزِي رُوْحنْت غَار ونْضڒ زِيش <verse eid="LUK 24:22" /><verse number="23" style="v" sid="LUK 24:23" />وَار ذِنِّي ؤُفِينْت شَا دَّات نّس. ذوْڒنْت-يد، نَّانْت-اَنغ بلِّي مظْهَارنْت-يذ لْمَلَائِكَاث خبَّرنْت-ثنْت بلِّي اَقَاث يدَّر. <verse eid="LUK 24:23" /><verse number="24" style="v" sid="LUK 24:24" />ڒخْدّنِّي رُوْحن شَان يوْذَان زَّايْنغ غَار ونْضڒ نّس، ؤُفِين نِيشَان مَامْش ذَانغ نَّانْت ثمْغَارِين نِّي، وَلَكِن نتَّا وَار ث ؤُفِين شَا ذِنِّي."<verse eid="LUK 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25" />ينَّا-ٱسن عِيْسَى: "آ يِنِّي وَار يفْهِيمن شَا! آ يِنِّي وَار يتِيمْنن شَا ذغْيَا ذِي مَارَّا مِين نَّان لْأَنْبِيَا! <verse eid="LUK 24:25" /><verse number="26" style="v" sid="LUK 24:26" />تُوْغَا يتْخصَّا إِ لْمَسِيح اَذ يعدّب، سّنِّي اَذ يَاذف غَار لْعَظَمَا نّس." <verse eid="LUK 24:26" /><verse number="27" style="v" sid="LUK 24:27" />ذِنِّي يبْذَا-يَاسن عِيْسَى زِي شَّرِيعَا ن مُوْسَى ذ لْكُتُب ن مَارَّا لْأَنْبِيَا يسفْهم-يثن مِين خَاس يُوْرِين ذِي مَارَّا لْكُتُب نِّي.<verse eid="LUK 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28" />قَارّْبن غَار دْشَار اِي غَار تْرَاحن، عِيْسَى يݣَّا يخف نّس اَخْمِي يخس اَذ يكمّڒ خ وبْرِيذ نّس. <verse eid="LUK 24:28" /><verse number="29" style="v" sid="LUK 24:29" />وَلَكِن بْذَان نِثْنِي تحْشَامن-ث نَّان-اَس: "قِّيم اَكِذْنغ مِينْزِي عْڒَاين ذ ثَمدِّيث قَا يرُوْح ڒْحَاڒ." سّنِّي يُوْذف غَارْسن حمَا اَكِذْسن يسنْس. <verse eid="LUK 24:29" /><verse number="30" style="v" sid="LUK 24:30" />وَامِي اَكِذْسن يقِّيم اَذ يشّ، ئِكَّر ييْسِي اَغْرُوْم يشكَّر أَربِّـي يرْزِي-ث يبْذَا يفَرّق-اَسن-ث. <verse eid="LUK 24:30" /><verse number="31" style="v" sid="LUK 24:31" />ذِنِّي إِي نُوْرْزْمنْت ثِيطَّاوِين نْسن عقْڒن-ث، وَلَكِن نتَّا ينرْفع وَار يقِّيم شَا اَث ࢲرّن. <verse eid="LUK 24:31" /><verse number="32" style="v" sid="LUK 24:32" />نَّان إِ وَايَاوْيَا: "نشِّين نسْحِسَّا شَان ڒْحَاجث ثشَّاث ذݣ وُوْڒَاون نّغ وَامِي تُوْغَاث يسَّاوَاڒ اَكِذْنغ ذݣ وبْرِيذ يسفْهم-اَنغ لْكُتُب."<verse eid="LUK 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33" />ڒخْدّنِّي كَّرن ذوْڒن غَار لْقُدْس. ؤُفِين حِيطَاش ن اَرُّسُل ذ يِنِّي إِي كِذْسن يمُوْنن ذِنِّي. <verse eid="LUK 24:33" /><verse number="34" style="v" sid="LUK 24:34" />نَّان-اَسن: "مَانَايَا ذ صَّح! ئِكَّر-د سِيذِيثْنغ زِي ڒْموْث، تُوْغَا يبَان-د إِ سِمْعَان!" <verse eid="LUK 24:34" /><verse number="35" style="v" sid="LUK 24:35" />تْخبَّرن-ثن س مِين يوقْعن ذݣ وبْرِيذ ذ مَامّش سّْنن سِيذِيثْسن وَامِي يرْزَا اَغْرُوْم.<verse eid="LUK 24:35" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يمْضهَّار-د إِ يمحْضَارن نّس</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36" />وَامِي سَّاوَاڒن خ مَانَايَا يُوْسَا-د عِيْسَى يبدّ ذِي ڒْوسْط نْسن ينَّا-ٱسن: "سْڒَام خَاوم." <verse eid="LUK 24:36" /><verse number="37" style="v" sid="LUK 24:37" />ݣّْوْذن اَطَّاس تْغِير-اَسن اَقَا تْوَاڒَان شَان ڒخْيَاڒ. <verse eid="LUK 24:37" /><verse number="38" style="v" sid="LUK 24:38" />ينَّا-ٱسن: "مِين كنِّيو يُوْغِين ثنْخڒْعم؟ مَايمِّي ؤُڒَاون نْوم ذَايْسن شّكّ؟ <verse eid="LUK 24:38" /><verse number="39" style="v" sid="LUK 24:39" />خْزَرم يفَاسّن ينُو ذ يضَارن ينُو، أَقَا ذ نّش. حَذَام-اَيِي، خْزَرم. أَقَا ڒخْيَاڒ وَار ذَايس بُو ويْسُوْم ؤُڒَا ذ يِخْسَان اَمُّو إِي ذَايِي تْوَاڒَام نش." <verse eid="LUK 24:39" /><verse number="40" style="v" sid="LUK 24:40" />ينَّا-ٱسن مَانَايَا، ئِسْبيّن-اَسن-د يفَاسّن نّس ذ يضَارن نّس. <verse eid="LUK 24:40" /><verse number="41" style="v" sid="LUK 24:41" />نِثْنِي قِّيمن عَاذ وَار ؤُمِينن شَا مِين يوقْعن مِينْزِي فَرّْحن ذهّْشن. أُوْشَا ينَّا-ٱسن: "مَا ذَا شَان لْمَكْلَا اَت شّغ؟" <verse eid="LUK 24:41" /><verse number="42" style="v" sid="LUK 24:42" />ؤُشِين-اَس شْوَايْت ن يسڒْمَان شنْفن. <verse eid="LUK 24:42" /><verse number="43" style="v" sid="LUK 24:43" />ئِيْسِي-ت، ئِشِّي-ت زَّاثْسن.<verse eid="LUK 24:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44" />ينَّا-ٱسن: "ذ وَا ذ اَوَاڒ إِي زِي كِذْوم سِّيوْڒغ وَامِي عَاذ تُوْغَا دْجِيغ اَكِذْوم، يعْنِي لَابُد اَذ يكمّڒ مَارَّا مِين خَافِي يُوْرِين ذِي شَّرِيعَا ن مُوْسَى ذ لْكُتُب ن لْأَنْبِيَا ذ زَّبُوْر." <verse eid="LUK 24:44" /><verse number="45" style="v" sid="LUK 24:45" />ڒخْدّنِّي يرْزم عِيْسَى ڒَعْقُوْڒَاث نْسن حمَا اَذ فهْمن لْكُتُب. <verse eid="LUK 24:45" /><verse number="46" style="v" sid="LUK 24:46" />ينَّا-ٱسن: "أَمُّو إِي يُوْرَا ذِي لْكِتَاب قَا يتْخصَّا إِ لْمَسِيح اَذ يتْوَاعدّب اَذ د يكَّر زِي ڒْموْث وِيس ثڒْتِيَّام. <verse eid="LUK 24:46" /><verse number="47" style="v" sid="LUK 24:47" />أَذ بشَّرن مَارَّا ڒݣْنُوْس حمَا اَذ تُوْبن اَذ تْوَاغْفَرنْت ڒْمُعْصِيَاث نْسن س يِيسم ن لْمَسِيح. أَذ يبْذَا مَانَايَا ذِي لْقُدْس. <verse eid="LUK 24:47" /><verse number="48" style="v" sid="LUK 24:48" />كنِّيو اَقَا ثشهّْذم خ مَانَايَا. <verse eid="LUK 24:48" /><verse number="49" style="v" sid="LUK 24:49" />أَتَاف مِينْذِي كنِّيو يوْعذ بَابَا اَذَاوم ثِيذ سّكّغ نش. قِّيمم ذِي ثنْدِينْت-أَ اَڒ خَاوم د غَا يهْوَا جّْهذ زݣ وجنَّا."<verse eid="LUK 24:49" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتْوَارْفع غَار وجنَّا</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50" />ئِسُوْفغ-يثن زِي ثنْدِينْت يُوْوِي-ثن غَار بَيْت عَنْيَا. ئِسْݣَعّذ يفَاسّن نّس يبَرك-يثن. <verse eid="LUK 24:50" /><verse number="51" style="v" sid="LUK 24:51" />وَامِي ثن يتْبَرَاك، ئِتْݣَعَّاذ خَاسن يتْوَارْفع غَار وجنَّا. <verse eid="LUK 24:51" /><verse number="52" style="v" sid="LUK 24:52" />سجّْذن-اَس، ذوْڒن-د غَار لْقُدْس نِثْنِي فَرّْحن اَطَّاس. <verse eid="LUK 24:52" /><verse number="53" style="v" sid="LUK 24:53" />سّنِّي قِّيمن ذِي ثمْزِيذَا ثَمقّْرَانْت حمّْذن أَريِّي.<verse eid="LUK 24:53" /></para>
  <chapter eid="LUK 24" />
</usx>