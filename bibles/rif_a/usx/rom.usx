<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ROM" style="id">Draft May 2015, revised from 2005</book>
  <para style="h">أَيث-روما</para>
  <para style="toc3">روم</para>
  <para style="toc2">أيث-روما</para>
  <para style="toc1">ثَبْرَات ن اَرَّسُوْل بُوْلُس غَار أَيث-رُوْمَا</para>
  <para style="mt1">ثَبْرَات ن اَرَّسُوْل بُوْلُس غَار أَيث-رُوْمَا</para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="s">بُوْلُس يسّكّ-اَسن سْڒَام إِ ڒْمُوْمِنِين ن رُوْمَا</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />نش ذ بُوْلُس اَخدَّام ن عِيْسَى لْمَسِيح، يݣَّا-ٱيِي-د أَربِّـي اَذ يڒِيغ ذ اَرَّسُوْل. تْوَاخْضَرغ حمَا ٱذ خْبَرغ س لْإِنْجِيل ن أَربِّـي، <verse eid="ROM 1:1" /><verse number="2" style="v" sid="ROM 1:2" />لْإِنْجِيل-أَ إِي زِي يوْعذ أَربِّـي ذِي زْمَان س يِيڒس ن لْأَنْبِيَا نّس ذِي لْكِتَاب لْمُقدّس. <verse eid="ROM 1:2" /><verse number="3‏-4" style="v" sid="ROM 1:3-4" />أُو مَانَايَا خ مِّيس سِيذِيثْنغ عِيْسَى لْمَسِيح. عْلَاحْسَاب دَّات نّس ذ بْنَاذم نتَّا زِي دُّوْرِّيث ن سِيذْنَا دَاود. وَلَكِن عْلَاحْسَاب أَرُّوح نّس يصْفَان يمظْهَار-د ذ مِّيس ن أَربِّـي س يِجّن ن جّْهذ يمْغَر وَامِي إِي د يكَّر زِي ڒْموْث. <verse eid="ROM 1:3-4" /><verse number="5" style="v" sid="ROM 1:5" />أَقَا زِي <char style="it">عِيْسَى</char> أُو خ سَّبَاب ن يِيسم نّس يݣَّا ذَايِي أَربِّـي لْبَرَكَا حمَا اَذ يڒِيغ ذ اَرَّسُوْل، أَذ بشَّرغ يوْذَان زِي مَارَّا ڒݣْنُوْس اَزَّايس اَمْنن اَذَاس طَاعن. <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />ؤُڒَا ذ كنِّيو زݣ يِنِّي يتْوَاخْضَرن اَذ تذْفَارم عِيْسَى لْمَسِيح.<verse eid="ROM 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7" />تَارِيغ إِ مَارَّا يمْعِيزّن ن أَربِّـي إِي يدْجَان ذِي ثنْدِينْت ن رُوْمَا يخْضَر-يكنِّيو اَذ تِيڒِيم ذ ڒْمُوْمِنِين صَّالِحِين. أَكِذْوم يِيڒِي اَرْضَا ذ ڒهْنَا زِي أَربِّـي بَابَاثْنغ ذ عِيْسَى لْمَسِيح سِيذِيثْنغ.<verse eid="ROM 1:7" /></para>
  <para style="s">بُوْلُس يرزُّو اَذ يࢲر ڒْمُوْمِنِين ذِي رُوْمَا</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />ذ اَمزْوَارُو، تْشكَّرغ أَربِّـي خَاوم مَارَّا إِذْوم س يِيسم ن عِيْسَى لْمَسِيح ڒَاحقَّاش لإِيمَان نْوم اَرِّين-اَس-د ڒخْبَار ذِي دُّنشْت-أَ ثكْمَاڒ. <verse eid="ROM 1:8" /><verse number="9‏-10" style="v" sid="ROM 1:9-10" />لِأَنَّا أَربِّـي إِي عبّْذغ س مَارَّا ؤُڒ ينُو تْبشَّارغ س لْإِنْجِيل ن مِّيس، نتَّا قَا يسّن تْفكَّرغ ذَايْوم ڒبْدَا ذِي ثْࢲَادْجِيث ينُو. تتَّارغ مڒَا يخس أَربِّـي اَڒ ونݣَّارُو اَذ اَفغ اَبْرِيذ اَغَارْوم د اَسغ. <verse eid="ROM 1:9-10" /><verse number="11" style="v" sid="ROM 1:11" />نش رزُّوْغ س وَاطَّاس اَكنِّيو ࢲرغ حمَا اَذَاوم ؤُشغ يجّن ن لْقُدْرَا رُوْحِيَا إِي ذَاوم غَا يُوْشن جّْهذ. <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />يعْنِي أَ نْشجّع اَيَاوْيَا س لإِيمَان إِي ذَايْنغ يشَرّْشن.<verse eid="ROM 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 1:13" />آي اَيْثْمَا، خْسغ اَذ تسّْنم بلِّي اَطَّاس ن ثْوَاڒَاثِين تݣّغ اَغَارْوم د اَسغ، وَلَكِن ڒخُّو عَاذ وَار غَارْوم د ؤُوِيضغ. نش خْسغ ڒْخذْمث ينُو اَذ تنْجح ذَايْوم مَامّش ثنْجح جَار ڒݣْنُوْس نّغْنِي. <verse eid="ROM 1:13" /><verse number="14" style="v" sid="ROM 1:14" />لِأَنَّا أُو لَابُد اَذ ݣّغ لْوَاجِب اَك ييُوْنَانِيْين ذ يِنِّي وَار يدْجِين شَا ذ ييُوْنَانِيْين، أَك يِنِّي يغْرِين ذ يِنِّي وَار يغْرِين شَا. <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />س مَانَايَا نش رزُّوْغ اَطَّاس اَكنِّيو بشَّرغ س لْإِنْجِيل ؤُڒَا ذ كنِّيو إِي يدْجَان ذِي ثنْدِينْت ن رُوْمَا.<verse eid="ROM 1:15" /></para>
  <para style="s">جّْهذ ن لإِنْجِيل</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />أَقَا نش وَار تْسذْحِيغ شَا زِي لْإِنْجِيل لِأَنَّا لْإِنْجِيل ذ جّْهذ نِّي إِݣ يسْخدَّام أَربِّـي بَاش اَذ يسنْجم مَارَّا وِي غَا يَامْنن: أَيث-إِسْرَائِيل ذ يمزْوُوْرَا ثُمَّا يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل. <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />أَربِّـي يسْبيّن-اَنغ-د ذِي لْإِنْجِيل مَامّش غَا نمْصْڒَاح اَكِذس، مَانَايَا س لإِيمَان وَاحْذس. مَامّش يقَّار لْكِتَاب: &lt;ونِّي يدْجَان نِيشَان اَذ يعِيش س لإِيمَان.&gt;<verse eid="ROM 1:17" /></para>
  <para style="s">أَغْضَاب ن أَربِّـي خ شَّرّْ ن يِوْذَان</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />فَا يمظْهَار-د وغْضَاب ن أَربِّـي زݣ وجنَّا خ مَارَّا شَّرّْ ذ ڒْبَاطڒ إِي تݣّن يِوْذَان يعْنِي يِنِّي يتْبطَّاڒن لْحَقِيقَا س شَّرّْ نْسن. <verse eid="ROM 1:18" /><verse number="19" style="v" sid="ROM 1:19" />أَقَا مِين زمَّرن يِوْذَان اَث سّْنن خ أَربِّـي يمظْهَار-اَسن-د، لِأَنَّا أَربِّـي نتَّا س يِيخف نّس إِي ذَاسن-ت-يد يسْمظْهَارن. <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />زݣ وَامِي ثدْجَا دُّنشْت-أَ، مِين وَار يتْوَاࢲرّن ن أَربِّـي يعْنِي جّْهذ نّس يتْدُوْمَان ذ طَّبِيعَا نّس يُوْعْڒَان، نْفهّم-يثنْت نْࢲرّ-يثنْت مْلِيح ذِي ثْمسْڒَايِين يتْوَاخڒْقن. عْلَاحْسَاب مَانَايَا يوْذَان وَار غَارْسن بُو لْعُدر. <verse eid="ROM 1:20" /><verse number="21" style="v" sid="ROM 1:21" />وَاخَّا نِثْنِي تُوْغَا سّْنن أَربِّـي، وَلَكِن وَار ث حمِّيذن شَا وَار ث ثْشكَّرن شَا مَامّش يتْخصَّا اَذ ݣّن اَك أَربِّـي. لْأَفْكَار نْسن ذوْڒنْت خْوَانْت، ؤُڒَاون نْسن ذ يبُوْهَاڒِيْين ذوْڒن ذ ثَادْجسْت. <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />حسّْبن خ يِيخف نْسن ذ يمِيغِيسن، نِثْنِي ذوْڒن ذ يبُوْهَاڒِيْين. <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />بدّْڒن لْعَظَمَا ن أَربِّـي يدَّرن إِ ڒبْدَا س لْأَصْنَام يتْشَابَّاهن ذݣ يِوْذَان إِي غَا يفْنَان، ذ لْأَصْنَام يتْشَابَّاهن ذݣ يِجْضَاض ذ لْحَيَوَانَاث ذ مِين يتنْحُوْرُوْذن.<verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />س مَانَاينِّي يسلّم-يثن أَربِّـي إِ مِين تْشهَّان وُوْڒَاون نْسن بَاش اَذ ݣّن لْفَسَاد بَاش اَذ سبهْدْڒن اَيَاوْيَا. <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />كَّرن بدّْڒن لْحَقِيقَا ن أَربِّـي س يخَرِّيقن. عبّْذن خدّْمن إِ مِين يتْوَاخڒْقن مَاشِي إِ أَربِّـي لْخَالِق، ونِّي إِي ذِي ثدْجَا لْبَرَكَا إِ ڒبْدَا ن ڒبْدَاث. آمِين.<verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />ثُمَّا يسلّم-يثن أَربِّـي إِ شّهَاوَاث نْسن إِي ثن يفضْحن. كَّرنْت ثمْغَارِين بدّْڒنْت يرْيَازن س ثمْغَارِين. <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />ؤُڒَا ذ يرْيَازن كَّرن سمْحن ذِي ثمْغَارِين، ثكَّر ذَايْسن ثْمسِّي يجّن خ ونّغْنِي، أَرْيَاز يفسّذ اَك ورْيَاز. س مَانَايَا جبْذن-د لْعِقَاب إِ يِيخف نْسن إِي سْذَاهدْجن خ ڒمُوْنْكَار إِي تݣّن.<verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />سّنِّي نِثْنِي وَامِي ؤُݣِين اَذ سّْنن أَربِّـي، يسلّم-يثن إِ ڒَعْقُوْڒَاث نْسن ينْفضْحن اَذ ݣّن مِين وَار يحْڒِين. <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />نِثْنِي شُّوْرن س كُڒ نُّوْع ن ڒْمُعْصِيَاث ذ شَّرّْ ذ طّْمَع ذ ڒقْبَاحث ذ ڒحْسذ. نقّن يوْذَان تْمنْغَان. شُّوْرن س ؤُغْذَار ذ مِين وَار يحْڒِين، قَّارن نَّمِيمَا. <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />قَّارن ڒْبَاطڒ، تْعِيفَّان أَربِّـي، تُوْكَّارن يوْذَان، سمْغَارن يخف نْسن، ذَايْسن تَّكبُّر. تݣّن نِّيث شَّرّْ ذ جْذِيذ، عصَّان لْوَلِدِين. <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />وَار فهّْمن شَا، وَار تطّْفن شَا ذݣ وَاوَاڒ نْسن، وَار ذَايْسن بُو لْحَنَانَا ؤُڒَا ذ أَرَّحْمث. <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />وَاخَّا سّْنن أَربِّـي يحكّم خَاسن س ڒْموْث خ يِنِّي يتݣّن ثِمسْڒَايِين-أَ، نِثْنِي كَّرن تݣّن-ثنْت. كْتَار زِي مَانَايَا، رطَّان خ يِنِّي إِي ثنْت يتݣّن.<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="s">لْحِسَاب ن أَربِّـي اَقَاث نِيشَان</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />إِذن آي اَرْيَاز، شك مڒَا تْعيَّابذ <char style="it">خ يِوْذَان</char>، أَتَاف وَار غَارك بُو ڒْحَقّ مِين مَا ثعْنِيذ. لِأَنَّا خْمِي تْعيَّابذ خ شَان يِجّن، تْعيَّابذ خ يِيخف نّش، مَايمِّي؟ لِأَنَّا شك تݣّذ كِيف-كِيف مَامّش تݣّن نِثْنِي! <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />وَاه، نشِّين نسّن قَا لْعِقَاب ن أَربِّـي يهوَّا نِيشَان خ يِنِّي يتݣّن ثِمسْڒَايِين-أَ. <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />آي اَرْيَاز، إِيوَا مِين تْفكَّرذ؟ مَا اَذ تْنجْمذ زِي لْعِقَاب ن أَربِّـي وَامِي تْعيَّابذ خ يِيْنَا أُو شك تݣّذ ثْمسْڒَايِين-أَ كِيف-كِيف اَم نِثْنِي؟ <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />نِغ ثْسحْقَارذ لْحَنَانَا يمْغَارن ن أَربِّـي ذ صّْبَر نّس ذ ڒْخَاضَر إِي غَارس؟ مَا وَار ثْسِّينذ أَربِّـي س لْحَنَانَا نّس يرزُّو اَش د يسْبيّن اَبْرِيذ بَاش اَذ تُوْبذ؟<verse eid="ROM 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 2:5" />وَلَكِن شك س ثْغنَّانْت-أَ إِي ذَايك ذ وُوْڒ نّش وَار يتُوْبن شَا تسْمُوْنِيذ اَغْضَاب إِ يِيخف نّش اَڒ يُوْم لْحِسَاب ذ لْعِقَاب، نْهَار إِي ذِي د غَا يمظْهَار ڒْحُكم ن أَربِّـي س ڒْحَقّ. <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />ثُمَّا اَذ يخدْجس أَربِّـي مْكُڒ يجّن خ ڒخْذَايم نّس. <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />أَذَاسن يُوْش ثُوْذَارْث وَار يفنِّين شَا إِ يِنِّي يصبَّارن تݣّن لْحَسَانَاث، لِأَنَّا رزُّوْن خ لْهِمَّا ذ ؤُوقَّار ذ ثُوْذَارْث نِّي يتْدُوْمَان. <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />وَلَكِن اَغَارْسن يِيڒِي لْحِسَاب ذ لْعِقَاب غَار يِنِّي يرزُّوْن إِ يِيخف نْسن وَاهَا ذ يِنِّي وَار يتْطِيعِين شَا إِ لْحَقِيقَا ذفَّارن مِين وَار يدْجِين شَا نِيشَان. <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />أَذ يِيڒِي ؤُزِيَّار ذ تَمَارَا خ كُڒ بْنَاذم يتݣَّن سَّيِّئَاث، خ يِنِّي زِي أَيث-إِسْرَائِيل ذ يمزْوُوْرَا عَاذ ذ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل. <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />وَلَكِن اَذ تِيڒِي لْهِمَّا ذ ؤُوقَّار ذ ڒهْنَا إِ مَارَّا يِنِّي يتݣَّن لْحَسَنَاث، أَيث-إِسْرَائِيل ذ يمزْوُوْرَا عَاذ ذ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل. <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />لِأَنَّا أَربِّـي وَار يتݣّ شَا س وُوْذمَاون.<verse eid="ROM 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12" />شُوْف، مَارَّا يِنِّي يعصَّان نِثْنِي وَار غَارْسن تِيڒِي بُو شَّرِيعَا، أَتَاف اَذ فْنَان بْڒَا شَّرِيعَا. وَلَكِن يِنِّي يعصَّان اَتَاف غَارْسن شَّرِيعَا، أَذ تْوَاحَاكْمن عْلَاحْسَاب شَّرِيعَا نِّي. <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />لِأَنَّا يوْذَان وَار تْمصْڒِيحن شَا اَك أَربِّـي مڒَا تْصنَّاطن وَاهَا إِ وَاوَاڒ ن شَّرِيعَا؛ لَّا، يِنِّي يتݣّن اَرَّاي س مِين ذَايس ذِي شَّرِيعَا، أَتَاف ذ يِنِّي إِي يتْمصْڒَاحن اَك أَربِّـي. <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />أُو ذ صَّح، يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِل وَار غَارْسن شَا شَّرِيعَا، مَعْلِيك تݣّن اَرَّاي س نِّيْيث نْسن مِين ذَايس ذِي <char style="it">شَّرِيعَا ن مُوْسَى</char>، أَتَاف نِثْنِي اَذ يڒِين ذ شَّرِيعَا س يِيخف نْسن وَاخَّا وَار غَارْسن شَا <char style="it">شَّرِيعَا ن مُوْسَى</char>. <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />يِيْنَا سظْهَارن-د بلِّي مِين يُوْرِين ذِي شَّرِيعَا اَقَاث غَارْسن يُوْرَا ذݣ وُوْڒَاون نْسن. ڒَعْقُوْڒَاث نْسن إِي زِي صَحّن مَانَايَا، ضَّمِير نْسن يعدْجم-اَسن خْمِي تݣَّن مِين يدْجَان ذ اَصبْحَان نِغ ذ مِين يدْجَان وَار يحْڒِين. <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />ئِقَّار لْإِنْجِيل إِي زِي تْحدَّاثغ: <char style="it">مَانَايَا اَذ يِيڒِي</char> ذِي نْهَار نِّي خْمِي غَا يحَاسب أَربِّـي خ وفُوْس ن عِيْسَى لْمَسِيح مَارَّا مِين ينُوْفَّرن ذݣ وُوْڒَاون ن يِوذَان.<verse eid="ROM 2:16" /></para>
  <para style="s">مِين يُوْرِين خ أَيث-إِسْرَائِيل ذِي شَّرِيعَا ن سِيذْنَا مُوْسَى؟</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />إِيوَا شك، مڒَا ثْحسّْبذ يخف نّش ذ اَئِسْرَائِيلِي، تْرَاجِيذ زِي شَّرِيعَا، تفْتَخَارذ س لْعَلَاقَا نّش اَك أَربِّـي. <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />مڒَا شك ثسّْنذ مِين يخس أَربِّـي، ثسّْنذ عَاوذ اَذ تِيخْضَرذ مِين يدْجَان نِيشَان لِأَنَّا <char style="it">شَّرِيعَا ن مُوْسَى</char> ثسْفهَّام-يش. <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />مڒَا شك اَقَاش متْأَكّد ثْزمَّرذ اَذ تْسُوْيُوْرذ يضَرْغَاڒن، شك عَاوذ اَقَاش ذ نُّوْر إِ يِنِّي يدْجَان ذِي ثَادْجسْت، <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />ثْنصّْحذ يِنِّي وَار يسِّينن، ثْسڒْمَاذذ يمزيَانن، لِأَنَّا غَارك ذِي <char style="it">شَّرِيعَا ن مُوْسَى</char> مَارَّا ثُوْسْنَا<note caller="+" style="f"><char style="fr" closed="false">2‏.20 </char><char style="ft" closed="false">ثُوْسْنَا نتَّاث ذ لْمَعْرِفَا.</char></note> ذ لْحَقِيقَا. <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />إِيوَا شك إِي يسڒْمَاذن يِنِّي، مَايمِّي وَار ثْسڒْمِيذذ شَا يخف نّش؟ شك تْحدَّاثذ ثقَّارذ: "وَار تَاشَار شَا." ئِي شك، مَا تَاشَارذ؟ <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />ثقَّارذ: "وَار زنَّا شَا." ئِي شك، مَا ثْزنِّيذ؟ شك تْعِيفِّيذ لأَصْنَام. ئي شك، مَا تَاشَارذ زِي ثمْزِيذَاوِين؟ <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />شك يتفْتَخَارن زِي شَّرِيعَا، مَا وَار تْوقَّرذ شَا أَربِّـي خْمِي ثْعصِّيذ مِين ذَايس ذِي <char style="it">شَّرِيعَا ن مُوْسَى</char>؟ <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />أَقَا مَامّش يقَّار لْكِتَاب: &lt;آي أَيث-إِسْرَائِيل، خ سَّبَاب نْوم مِينْزِي قَّارن اَوَاڒن وَار يحْڒِين خ يِيسم ن أَربِّـي يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل.&gt;<verse eid="ROM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25" />شك مڒَا ثْخدّْمذ س مِين ذَايس ذِي شَّرِيعَا، أَتَاف طَّهَارث<note caller="+" style="f"><char style="fr" closed="false">2‏.25 </char><char style="ft" closed="false">طَّهَارث نتَّاث ذ اَحجّم نِغ ذ اَخْثَان نِغ ذ لْخِتَام.</char></note> نّش اَذ تِيڒِي غَارس اَرْبح. وَلَكِن مڒَا ثْعصِّيذ شَّرِيعَا، أَتَاف اَذ تِيڒِيذ اَخْمِي وَار ثݣِّيذ شَا طَّهَارث. <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />إِنَّمَا، مڒَا ذِنِّي شَان يِجّن وَار يݣِّي شَا طَّهَارث، نتَّا يخدّم س مِين ذَايس ذِي <char style="it">شَّرِيعَا ن مُوْسَى</char>، أَتَاف وَانِيتَا يتْوَاحسَاب اَخْمِي يݣَّا طَّهَارث. <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />يعْنِي ونِّي يخدّْمن س مِين ذَايس ذِي <char style="it">شَّرِيعَا ن مُوْسَى</char>، وَاخَّا وَار يݣِّي شَا طَّهَارث ذِي دَّات، أَخَاش يحْكم شك إِي غَار يدْجَا لْكِتَاب نِّي ذ طَّهَارث. مَايمِّي؟ لِأَنَّا شك ثْعصِّيذ شَّرِيعَا. <verse eid="ROM 2:27" /><verse number="28" style="v" sid="ROM 2:28" />لِأَنَّا ونِّي يدْجَان ذ أَئِسْرَائِيلِي ذ صَّح، وَار يدْجِي اَم ونِّي د يتْبَانن اَم يسْرَائِيلِيْين ذِي دَّات وَاهَا. عَاوذ طَّهَارث ن صَّح وَار ثدْجِي شَا ذ ثنِّي د يتْبَانن غَار بَرَّا وَاهَا خ دَّات. <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />وَلَكِن اَئِسْرَائِيلِي يدْجَان ذ صَّح يتِيڒِي غَارس مَانَايَا غَار ذَاخڒ. أُو ذ طَّهَارث ن صَّح تِيڒِي ذݣ وُوْڒ س أَرُّوح ن أَربِّـي، وَار يدْجِي بُو س شَّرِيعَا. بْنَاذم-أَ وَار ث تْشكَّرن شَا يِوْذَان، ئِتْشكَّر-يث أَربِّـي.<verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="s">ڒْحَقّ ن أَربِّـي يسْمظْهَار-د ڒْبَاطڒ ن يِوْذَان</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />إِيوَا يسْرَائِيلِيْين، مَا غَارْسن شَان نّْفَع خ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل؟ عَاوذ طَّهَارث، مَا ذَايس شَان نّْفَع؟ <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />وَاه، اَطَّاس ن نّْفَع! ذ اَمزْوَارُو، يجَّا-ٱسن-د أَربِّـي اَوَاڒ نّس ذ لْأَمَانَا. <verse eid="ROM 3:2" /><verse number="3" style="v" sid="ROM 3:3" />إِيوَا مڒَا ڒبْعَاض زَّايْسن وَار ؤُمِينن شَا، مَا س لْكُفر نْسن إِي زِي غَا يسْبطّڒ أَربِّـي ڒْعَهذ نّس؟ <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />عمَّارْص! ڒَاحقَّاش أَربِّـي يقّار لْحَقِيقَا وَاخَّا يوْذَان مَارَّا سْخرِّيقن. مَامّش يقَّار لْكِتَاب:</para>
  <para style="q1" vid="ROM 3:4">&lt;أَوَاڒن نّش اَذ يڒِين صحَّان،</para>
  <para style="q1" vid="ROM 3:4">شك اَذ تْربْحذ خْمِي غَا تْوَاحكْمذ.&gt;<verse eid="ROM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5" />فَا مڒَا ڒْبَاطڒ نّغ إِي نْتݣّ يسْمظْهَار-د ڒْحَقّ ن أَربِّـي، مِين غَا نِينِي؟ (نش سَّاوَاڒغ عْلَاحْسَاب لْفِكْرَا ن بْنَاذم.) أَربِّـي، مَا يضدْجم-اَنغ خْمِي ذَانغ يتْعَاقَاب؟ <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />لَّا، عمَّارْص! مَعْلِيك اَمنِّي، مَامّش غَا يݣّ أَربِّـي اَذ يحَاسب دُّنشْت-أَ؟ <verse eid="ROM 3:6" /><verse number="7" style="v" sid="ROM 3:7" /><char style="it">يمْكن اَذ يِينِي شَان يِجّن:</char> مْڒِي ڒْبَاطڒ ينُو نتَّا يسْمظْهَار-د مْلِيح لْحَقِيقَا ن أَربِّـي، مْڒِي زَّايس يتْمَارْنِي أَربِّـي ذِي لْعَظَمَا نّس، إِيوَا مَايمِّي ذَايِي غَا يحْسب ذ لْعَاصِي؟ <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />نِغ <char style="it">اَذ يِينِي شَان يِجّن:</char> يَالَّاه أَ نݣّ ڒْبَاطڒ حمَا ٱزَّايس د يكّ ڒْخِير. أَمنِّي تَهَامن-اَنغ شَان يِوْذَان س ࢲُّوْر بلِّي نقَّار اَوَاڒ-أَ. ئِوْذَان-أَ نِثْنِي سْذَاهدْجن لْعِقَاب ن أَربِّـي!<verse eid="ROM 3:8" /></para>
  <para style="s">ئِوْذَان مَارَّا عصَّان أَربِّـي وَار دْجِين شَا نِيشَان</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />إِيوَا نشِّين أَيث-إِسْرَائِيل، مَا لْحَالَا نّغ حْسن زݣ يِوذَان نّغْنِي؟ لَّا، عمَّارْص! ننَّا قْبڒ قَا أَيث-إِسْرَائِيل ذ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل مَارَّا نݣَّا ڒْمُعْصِيّث. <verse eid="ROM 3:9" /><verse number="10" style="v" sid="ROM 3:10" />مَامّش يقَّار لْكِتَاب:</para>
  <para style="q1" vid="ROM 3:10">&lt;وَار يدْجِي حَدّ نِيشَان، ؤُڒَا ذ يجّن.<verse eid="ROM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ROM 3:11" />ؤُڒَا ذ يجّن مَا يفهّم.</para>
  <para style="q1" vid="ROM 3:11">وَار يرزُّو خ أَربِّـي، ؤُڒَا ذ يجّن.<verse eid="ROM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12" />فّْغن اَبْرِيذ مَارَّا إِذْسن،</para>
  <para style="q1" vid="ROM 3:12">ذوْڒن مَارَّا وَار نفّْعن.</para>
  <para style="q1" vid="ROM 3:12">وَار يدْجِي حَدّ يتݣّ مِين يصبْحَان.<verse eid="ROM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13" />ثْمِيجَّا نْسن ذ اَنْضڒ ينُوْرْزْمن،</para>
  <para style="q1" vid="ROM 3:13">ئِڒسَاون نْسن يخدّْعن.</para>
  <para style="q1" vid="ROM 3:13">سّم ن يفِيغرَان يتفّغ-د زݣ يينْشِيشن نْسن.<verse eid="ROM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ROM 3:14" />نَّعْڒث ذ ثَارْزُوݣِي يشُّوْر زَّايْسن وقمُّوْم نْسن.<verse eid="ROM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15" />تْقلِّيقن س يضَارن نْسن اَذ سِّيزْڒن يذَامّن.<verse eid="ROM 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ROM 3:16" />تجَّان اَرّْوِينَا ذ لْأَزْمَا مَانِي مَا رُوْحن،<verse eid="ROM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17" />أَبْرِيذ ن ڒهْنَا وَار ث سِّينن.<verse eid="ROM 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ROM 3:18" />ثِيݣّْوْذِي زِي أَربِّـي وَار غَارْسن ثدْجِي جَار ثِيطَّاوِين نْسن.&gt;<verse eid="ROM 3:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />فَا نشِّين نسّن بلِّي مَارَّا مِين ذَايس ذِي <char style="it">شَّرِيعَا ن مُوْسَى</char> تْوصَّا يِنِّي غَار ثدْجَا شَّرِيعَا-يَا بَاش ؤُڒَا ذ يجّن وَار غَارس يتِيڒِي بُو لْعُدر. أُو مَارَّا يِنِّي يدْجَان ذِي دُّنشْت-أَ اَذ يڒِين سْوَادَّاي ن لْحِسَاب ن أَربِّـي.<verse eid="ROM 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 3:20" />فَلِهَذَا، ؤُڒَا ذ يجّن ن بْنَاذم وَار يزمَّر اَذ يمصْڒَاح اَك أَربِّـي س ڒخْذَايم إِي ذَايس ذِي شَّرِيعَا؛ لَّا، شَّرِيعَا ثسْبيَّان-اَنغ-د مِين ثعْنَا ڒْمُعْصِيّث.<verse eid="ROM 3:20" /></para>
  <para style="s">س لإِيمَان وَاحْذس إِي زِي نتْمصْڒَاح اَك أَربِّـي</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />فَا ڒخُّو أَربِّـي يسْمظْهَار-اَنغ-د مَامّش غَا نݣّ أَ نْمصْڒَاح اَكِذس بْڒَا شَّرِيعَا. مَانَايَا صَحّن-ث لْكُتُوْب ن لأَنبِيَاء ذ <char style="it">شَّرِيعَا ن مُوْسَى</char> نِثْنِي س يِيخف نْسن. <verse eid="ROM 3:21" /><verse number="22‏-23" style="v" sid="ROM 3:22-23" />يعْنِي، أَربِّـي يسمْصْڒَاح اَكِذس مَارَّا ونِّي يتَامْنن زِي عِيْسَى لْمَسِيح، وَار يتْفرَّق جَار يِوْذَان. أَقَا مَارَّا عْصَان أَربِّـي، تْوَاحَرَّامن زِي لْعَظَمَا نّس. <verse eid="ROM 3:22-23" /><verse number="24" style="v" sid="ROM 3:24" />أَربِّـي، نتَّا يسمْصْڒَاح-يثن اَكِذس س اَرْضَا نّس بَاطڒ س وسنْجم إِي د يُوْسِين س عِيْسَى لْمَسِيح. <verse eid="ROM 3:24" /><verse number="25" style="v" sid="ROM 3:25" />أَربِّـي يقدّم-يث ذ لْفِدْيَا<note caller="+" style="f"><char style="fr" closed="false">3‏.25 </char><char style="ft" closed="false">عَدَتَان لْفِيدْيَا يتْخدْجَاس-يت بْنَاذم بَاش اَذ ينْجَا زِي ڒْمُعْصِيّث. ذَانِيتَا يقَّار سِيذِي أَربِّـي بلِّي يقدّم سِيذِيثْنغ عِيْسَى ذ لْفِدْيَا بَاش اَذ تْوَاسنْجْمن يِوْذَان زِي ڒْمُعْصِيَاث نْسن.</char></note> حمَا اَذ تْوَاغْفَارنْت ڒْمُعْصِيَاث س يذَامّن نّس، يعْنِي إِ يِنِّي يقبّْڒن مَانَاينِّي س لْإِيمَان <char style="it">نْسن</char>. س مَانَاينِّي يسْمظْهَار-د أَربِّـي ڒْحَقّ نّس. نتَّا تُوْغَا يصبَّار، وَار ت يُوْوِي شَا ذِي ڒْمُعْصِيَاث نِّي إِي يعْذُوْن، <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />حمَا ٱذ د يسْمظْهَار ذِي زْمَان-أَ ڒْحَقّ نّس. لِأَنَّا أَربِّـي نتَّا نِيشَان إِݣ يدْجَا، نتَّا يسمْصْڒَاح اَكِذس ونِّي غَا يَامْنن زِي عِيْسَى.<verse eid="ROM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27" />إِيوَا مَا أَ نفْتَخر س شَان ڒْحَاجث؟ لَّا، ممْنُوْع! مَا ممْنُوْع س شَّرِيعَا، يعْنِي س لْحَسَانَاث؟ لَّا، س لإِيمَان! <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />مَايمِّي؟ ڒَاحقَّاش نشِّين غَارْنغ بلِّي بْنَاذم يسمْصْڒَاح-يث أَربِّـي اَكِذس س لإِيمَان <char style="it">نّس</char> بْڒَا لْحَسَانَاث ن شَّرِيعَا. <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />إِيوَا أَربِّـي، مَا نتَّا ذ أَربِّـي ن أَيث-إِسْرَائِيل وَاهَا؟ لَّا! مَا وَار يدْجِي ؤُڒَا ذ أَربِّـي ن يِوْذَان وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل؟ وَاه، ذ أَربِّـي نْسن ؤُڒَا ذ نِثْنِي. <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" />لِأَنَّا أَربِّـي نتَّا ذ يجّن. ذ نتَّا إِݣ يسمْصْڒَاحن أَيث-إِسْرَائِيل اَكِذس س لإِيمَان، ذ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل س <char style="it">نّفْس</char> لْإِيمَان. <verse eid="ROM 3:30" /><verse number="31" style="v" sid="ROM 3:31" />إِذن، مَا أَ نسْبطّڒ شَّرِيعَا س لإِيمَان-أَ؟ عمَّارْص! لَّا، نشِّين نتْحَامَا شَّرِيعَا.<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="s">سِيذْنَا بْرَاهِيم ذ لْإِيمَان نّس</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />إِيوَا مِين غَا نِينِي خ جدِّيثْنغ بْرَاهِيم؟ مِين ذَاس يوقْعن إِ نتَّا؟ <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />مَعْلِيك نتَّا يسمْصْڒَاح-يث أَربِّـي اَكِذس عْلَاحْسَاب ڒخْذَايم نّس،<note caller="+" style="f"><char style="fr" closed="false">4‏.2 </char><char style="ft" closed="false">ذِي لْأَيَا-يَا ڒخْذَايم يخس اَذ يِينِي لْحَسَنَاث.</char></note> أَتَاف بْرَاهِيم غَارس ڒْحَقّ إِي زِي غَا يفْتَخر زݣ يِيخف نّس وَلَكِن زَّاث إِ أَربِّـي لَّا. <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" />مَامش يقَّار لْكِتَاب:</para>
  <para style="q1" vid="ROM 4:3">&lt;أُوْشَا يُوْمن بْرَاهِيم زِي أَربِّـي،</para>
  <para style="q1" vid="ROM 4:3">ئِكَّر أَربِّـي يسمْصْڒَاح-يث اَكِذس س لْإِيمَان نِّي.&gt;<verse eid="ROM 4:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="ROM 4:4" />فَا ونِّي غَا يݣّن شَان ڒْخذْمث، مَا يسْذَاهدْج اَخَاس يتْوَاخدْجس نِغ لَّا؟ وَاه، مَانَايَا ذ تخْڒِيسث نّس مَاشِي ذ كَادُو. <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />ونِّي وَار يتْوكِّيڒن<note caller="+" style="f"><char style="fr" closed="false">4‏.5 </char><char style="ft" closed="false">ئِتوكِّيڒن يخس اَذ يِينِي يتْڬڒ.</char></note> خ ڒخْذَايم إِݣ يتݣّ، ئِتْوكِّيڒ خ أَربِّـي يتَارَّان لْعَاصِي غَار وبْرِيذ، وَانِيتَا يسمْصْڒَاح-يث أَربِّـي اَكِذس س لإِيمَان <char style="it">إِي ذَايس</char>.<verse eid="ROM 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 4:6" />
    <char style="it">نَّبِي</char> دَاود ؤُڒَا ذ نتَّا، ئِسَّاوَاڒ خ سَّعْذ ن بْنَاذم وَامِي ث يسمْصْڒَاح أَربِّـي اَكِذس بْڒَا ڒخْذَايم. <char style="it">ئِقَّار</char>:<verse eid="ROM 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7" />&lt;سَّعْذ ن يِنِّي ؤُمي تْوَاغْفَارنْت سَّيِّئَاث نْسن،</para>
  <para style="q1" vid="ROM 4:7">تْوَامْحَانْت ڒْمُعْصِيَاث نْسن.<verse eid="ROM 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8" />سَّعْذ ن ونِّي وَار يتْحِيسِيب سِيذِي أَربِّـي</para>
  <para style="q1" vid="ROM 4:8">خ ڒْمُعْصِيَاث نّس.&gt;<verse eid="ROM 4:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9" />أُو سَّعْذ-أَ، مَا ن يِنِّي وَاحذْسن يتݣّن طَّهَارث نِغ ؤُڒَا ذ يِنِّي وَار يتݣّن شَا طَّهَارث؟ شُوْف، نشِّين نقَّار: "أَربِّـي يسمْصْڒَاح بْرَاهِيم اَكِذس س لإِيمَان <char style="it">نّس</char>." <verse eid="ROM 4:9" /><verse number="10" style="v" sid="ROM 4:10" />مڒْمِي إِي ث يسمْصْڒَاح اَكِذس؟ مَا قْبڒ مَا ٱذ يݣّ طَّهَارث نّس نِغ منْبَعْد مَا ت يݣّ؟ لَّا، مَاشِي منْبَعْد إِ طَّهَارث نّس وَلَكِين قْبڒ. <verse eid="ROM 4:10" /><verse number="11" style="v" sid="ROM 4:11" />ثُمَّا طَّهَارث-أَ ثُوْسَا-ٱس-د ذ يجّن ن لْعَلَامَا ذ يجّن ن دَّلِيل بلِّي أَربِّـي يسمْصْڒَاح-يث اَكِذس س لإِيمَان <char style="it">نِّي</char> إِي تُوْغَا ذَايس قْبڒ مَا ٱذ يطهَّار. مَايمِّي مَانَايَا؟ بَاش اَذ يِيڒِي بْرَاهِيم ذ جدِّيثْسن ن يِنِّي مَارَّا يتَامْنن وَاخَّا وَار ݣِّين شَا طَّهَارث، بَاش ؤُڒَا ذ يِنِّي اَثن يسمْصْڒَاح أَربِّـي اَكِذس. <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />أُو نتَّا ذ جدِّيثْسن عَاوذ ؤُڒَا ن يِنِّي يݣِّين طَّهَارث، وَلَكِن مَاشِي ݣِّين طَّهَارث أُو صَافِي. لَّا، ئِتْخصَّا-يَاسن اَذ ذفَّارن ڒَاثَار ن لْإِيمَان مَامش تُوْغَا يدْجَا غَار جدِّيثْنغ بْرَاهِيم وَامِي تُوْغَا عَاذ وَار يݣِّي بُو طَّهَارث.<verse eid="ROM 4:12" /></para>
  <para style="s">أَربِّـي يوْعذ سِيذْنَا بْرَاهِيم اَغَارس يِيڒِي مِّيس</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />ڒْعَهذ إِي زِي يوْعذ أَربِّـي بْرَاهِيم ذ دُّوْرِّيث نّس حمَا اَذ يوَارث نتَّا دُّنّشْت. ڒْعَهذ نِّي وَار د يُوْسِي شَا س شَّرِيعَا، يُوْسَا-د س لإِيمَان نِّي إِݣ يسمْصْڒَاحن يوْذَان اَك أَربِّـي. <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" />مَعْلِيك اَذ وَارْثن يِنِّي يذفَّارن شَّرِيعَا، أَتَاف لإِيمَان-أَ وَالُو، أَتَاف ڒْعَهذ-أَ يخْوَا. <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />أَقَا <char style="it">شَّرِيعَا ن مُوْسَى</char> تَاوِي-د لْعِقَاب ن أَربِّـي. وَلَكِن مَانِي وَار تِيڒِي شَا شَّرِيعَا وَار تِيڒِي شَا ذِنِّي ڒْمُعْصِيّث.<verse eid="ROM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16" />س مَانَاينِّي ڒْعَهذ-أَ يبْنَا خ لإِيمَان <char style="it">وَاحْذس</char>: حمَا ڒْعَهذ-أَ اَذ د يَاس زِي اَرْضَا نّس، حمَا اَث يضْمن أَربِّـي إِ مَارَّا دُّوْرِّيث ن بْرَاهِيم. أُو مَاشِي غِير ونِّي يذفَّارن <char style="it">شَّرِيعَا ن مُوْسَى</char>؛ لَّا، ؤُڒَا ذ ونِّي يشَرّْشن ذِي لإِيمَان ن بْرَاهِيم. نتَّا ذ جدِّيثْنغ مَارَّا. <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" />مَامّش يقَّار لْكِتَاب: &lt;أَرِّيغ-شك ذ جدِّيثْسن إِ وَاطَّاس ن ڒݣْنُوْس.&gt;</para>
  <para style="p" vid="ROM 4:17">ذِنِّي بْرَاهِيم زَّاث إِ أَربِّـي إِي زِي يتَامن، يعْنِي ونِّي د يسْنكَّرن يِنِّي يمُّوْثن، يعْنِي ونِّي د يخڒْقن مِين عمَّارْص وَار يدْجِين. <verse eid="ROM 4:17" /><verse number="18" style="v" sid="ROM 4:18" />وَاخَّا وَار ذِنِّي بُو لْأَمَال قَاع، يُوْمن بْرَاهِيم يݣَّا لْأَمَال. أَمنِّي إِي يذْوڒ ذ جدِّيثْسن إِ وَاطَّاس ن ڒݣْنُوْس مَامّش تُوْغَا ذَاس يتْوَانَّا زِي قْبڒ: &lt;<char style="it">مِين يدْجَان ذ يثْرَان ذݣ وجنَّا</char> اَمنِّي إِي غَا ثِيڒِي دُّوْرِّيث نّش.&gt;<verse eid="ROM 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 4:19" />ثُمَّا لإِيمَان نّس وَار ينْقِيص شَا وَاخَّا غَارس عْڒَاين مِيَّا ن يسݣّْوُسَا، وَاخَّا يسّن يخف نّس وَار يزمَّر شَا ثَمْغَارْث نّس سَارَا وَار تِيرو شَا. <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />وَاخَّا اَمنِّي وَار ينْقِيص شَا لإِيمَان نّس، وَار يتْشكِّي شَا ذِي ڒْعَهذ نِّي إِي ذَاس يُوْشَا أَربِّـي. وَلَكِن يَرنِّي ذِي لإِيمَان نّس يحمّذ أَربِّـي، <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />نتَّا أَقَاث متْأَكّد اَطَّاس أَربِّـي يزمَّر اَذ يكمّڒ خ ڒْعَهذ نّس. <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />س مَانَايَا يسمْصْڒَاح-يث أَربِّـي اَكِذس.<verse eid="ROM 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 4:23" />مَايمِّي يقَّار لْكِتَابَ قَا &lt;<char style="it">أَربِّـي</char> يسمْصْڒَاح-يث <char style="it">اَكِذس</char>&gt;؟ مَا يقَّار اَوَاڒ-أَ عْلَاحْسَاب بْرَاهِيم وَاحْذس؟ <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />لَّا، يُوْرَا عَاوذ عْلَاحْسَاب نشِّين ؤُمِي ذَانغ يسمْصْڒَاح اَكِذس وَامِي زَّايس نُوْمن زِي أَربِّـي ونِّي إِي د يسكَّرن سِيذِيثْنغ عِيْسَى زِي ڒْموث. <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />ئِتْوَاسلّم حمَا اَذ يمّث خ ڒْمُعْصِيَاث نّغ، ئِتْوَاسكَّر-د حمَا اَذَانغ يسمْصْڒَاح أَربِّـي اَكِذس.<verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="s">ڒفْرَاحث ذ ڒهْنَا اَك أَربِّـي</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />إِذن فَا وَامِي ذَانغ يسمْصْڒَاح أَربِّـي اَكِذس س لْإِيمَان <char style="it">نّغ</char> اَقَانغ ذِي ڒهْنَا اَك أَربِّـي خ وفُوْس ن سِيذِيثْنغ عِيْسَى لْمَسِيح. <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />نتَّا زَّايس إِي نُوْفَا اَبْرِيذ س لإِيمَان غَار اَرْضَا إِي ذِي ندْجَا ڒخُّو. نْفَرّح ذِي لْأَمَال ن لْعَظَمَا ن أَربِّـي. <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />وَار يدْجِي غِير مَانَايَا وَاهَا، نْفَرّح نشِّين ؤُڒَا ذِي ڒمْحَايْين. نسّن بلِّي ڒمْحَايْين-أَ تَارْونْت-يد صّْبَر. <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />صّْبَر-أَ يتَارو ذَايْنغ مِينْزِي غَا نغْڒب خ ڒمْحَايْين. س ڒغْڒَاب-أَ خ ڒمْحَاين يتَارو ذَايْنغ لْأَمَال. <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />لْأَمَال-أَ وَار ذَانغ يتْخيِّيب شَا، مَايمِّي؟ لِأَنَّا أَربِّـي يُوْشَا-ٱنغ أَرُّوْح يقدّْسن، زَّايس إِݣ يشُّوْر ؤُڒَاون نّغ س ڒمْحِبّث نّس.<verse eid="ROM 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6" />فَا ذِي ڒْوقْث نِّي نِيشَان ثنِّي تُوْغَا يخْضَر أَربِّـي نشِّين وَار غَارْنغ بُو جّْهذ، ئِمُّوْث لْمَسِيح خَانغ وَامِي نعْصَا. <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />مُوْحَاڒ اَذ يقْبڒ شَان يِجّن اَذ يمّث خ يِجّن ن بْنَاذم نّغْنِي ذ اَصبْحَان وَاهَا. مڒَا بْنَاذم اَقَاث ذ اَصبْحَان اَطَّاس، يمْكن شَان يِجّن اَخَاس يقْبڒ اَذ يمّث. <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />وَلَكِن نشِّين تُوْغَانغ عَاذ نْعصَّا أَربِّـي وَامِي يمُّوْث خَانغ لْمَسِيح. س مَانَاينِّي يسْبيّن-اَنغ-د أَربِّـي مشْحَاڒ ذَانغ يتخْس.<verse eid="ROM 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 5:9" />إِذن، أَقَانغ بَرِيئين ڒخُّو س يذَامّن<note caller="+" style="f"><char style="fr" closed="false">5‏.9 </char><char style="ft" closed="false">ئِذَامّن نتَّا ذ دّم.</char></note> ن لْمَسِيح، أُو لَابُد زَّايس إِي غَا ننْجم زݣ وغْضَاب ن أَربِّـي. <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />نشِّين نْمصْڒَاح اَك أَربِّـي س ڒْموْث ن مِّيس وَامِي تُوْغَانغ نشِّين عَاذ ذ ڒْعَذْيَان نّس. ڒخُّو وَامِي كِذس نْمصْڒَاح، أُو لَابُد زَّايس إِي غَا ننْجم س ثُوْذَارْث نّس! <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />وَار يدْجِي غِير مَانَايَا وَاهَا، نشِّين نْفَرّح زِي أَربِّـي س سِيذِيثْنغ عِيْسَى لْمَسِيح ونِّي إِي ذَانغ يسمْصْڒَاحن اَكِذس.<verse eid="ROM 5:11" /></para>
  <para style="s">ڒْفَارْق جَار سِيذْنَا آدَم ذ سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />إِذن ثْبَان-د ڒْمُعْصِيّث غَار دُّنشْت س يِجّن ن بْنَاذم، <char style="it">يعْنِي آدَم</char>. س ڒْمُعْصِيّث نِّي إِي ثدْجَا ڒْموْث. سّنِّي ثْنفْرق ڒْموْث خ يِوذَان مَارَّا لِأَنَّا يوْذَان مَارَّا عْصَان. <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />أَقَا ڒْمُعْصِيّث تُوْغَا ثدْجَا ذِي دُّنشْت قْبڒ مَا ٱذ د ثَاس شَّرِيعَا. وَلَكِن مَانِي وَار ثُوْوِيض شَا شَّرِيعَا، أَربِّـي وَار ذِنِّي يتْحِيسِيب بُو ڒْمُعْصِيّث. <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />إِنَّمَا، زِي زْمَان ن آدَم اَڒ زْمَان ن مُوْسَى ثْحكّم ڒْموْث <char style="it">خ يِوذَان</char> ؤُڒَا خ يِنِّي وَار يعْصِين شَا اَمشْنَاو ڒْمُعْصِيّث ن آدَم، أُو نتَّا ذ ڒْمِثَال ن بْنَاذم إِي د غَا يَاسن.<verse eid="ROM 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 5:15" />وَلَكِن ڒْمُعْصِيّث <char style="it">ن آدَم</char> وَار نْزمَّر اَت نْمثّل اَك لْهَادِيَا <char style="it">ن اَرْضَا ن أَربِّـي</char>. شُوْف، ئِجّن ن بْنَاذم، <char style="it">نتَّا ذ آدَم،</char> يعْصَا أَربِّـي يُوْوِي-د ڒْموْث إِ مَارَّا يوْذَان. ڒخُّو مشْحَاڒ يمْغَر اَرْضَا ن أَربِّـي ذ لْهَادِيَا إِي د ينْفيّْضن خ يِوْذَان س اَرْضَا ن يِجّن ن بْنَاذم نّغْنِي نتَّا ذ عِيْسَى لْمَسِيح. <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />شُوْف عَاوذ، لْهَادِيَا ن أَربِّـي مَاشِي اَمشْنَاو مِين يوقْعن خ سَّبَاب ن ڒْمُعْصِيّث يݣَّا بْنَاذم نِّي آدَم. لِأَنَّا ڒْحُكم إِي د ثُوْوِي يجّن ن ڒْمُعْصِيّث نتَّا ذ لْحِسَاب ذ لْعِقَاب. وَلَكِن س لْهَادِيَا-يَا أَربِّـي يسمْصْڒَاح اَكِذس بْنَاذم منْبَعْد إِ وَاطَّاس ن ڒْمُعْصِيَاث. <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />يعْنِي س سَّبَاب ن ڒْمُعْصِيّث نِّي ن يِجّن ن بْنَاذم ثبْذَا ڒْموْث ثْحكّم خ يِوْذَان س سَّبَاب ن بْنَاذم نِّي. ڒخُّو س سَّبَاب ن يِجّن ن بْنَاذم، يعْنِي س عِيْسَى لْمَسِيح، ذ ثُوْذَارْث نتَّاث ثْحكّم اَطَّاس خ يِنِّي يقبّْڒن اَرْضَا يمْغَارن ن أَربِّـي ذ لْهَدِيَا إِي ثن يسمْصْڒَاحن اَكِذس.<verse eid="ROM 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18" />إِذن يجّن ن ڒْمُعْصِيّث إِݣ يݣَّا يجّن ن بْنَاذم ثُوْوِي-د لْحِسَاب ذ لْعِقَاب إِ مَارَّا يوْذَان. أَمنِّي يجّن ن لْبَرَاءَا<note caller="+" style="f"><char style="fr" closed="false">5‏.18 </char><char style="ft" closed="false">لْبَرَاءَا-يَا يعْنِي ذ عِيْسَى لْمَسِيح وَامِي يتْوَاصلّب عْلَاحْسَاب ڒْمُعْصِيّث ن بْنَاذم.</char></note> إِݣ يݣَّا يجّن ن بْنَاذم يُوْوِي-د صُّلْح ذ ثُوْذَارْث إِ مَارَّا يوْذَان. <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />لِأَنَّا مَامّش يِعْصَا آدَم أَربِّـي يُوْوِي-د ڒْمُعْصِيّث إِ وَاطَّاس ن يِوْذَان، أَمنِّي يطَاع عِيْسَى إِ أَربِّـي سّنِّي مصْڒَاحن اَطَّاس ن يِوْذَان اَك أَربِّـي.<verse eid="ROM 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20" />أُو شَّرِيعَا نتَّاث ثُوْذف-د حمَا ٱذ كْثَارنْت ڒْمُعْصِيَاث. وَلَكِن شْحَاڒ مَا كْثَارنْت ڒْمُعْصِيَاث، أَرْضَا ن أَربِّـي يكْثَار كْتَار زَّايسنْت. <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />أُو مَامّش ثحْكم ڒْمُعْصِيّث ثُوْوِي-د ڒْموْث، أَمنِّي إِي خَانغ يحْكم اَرْضَا وَامِي ذَانغ يسمْصْڒَاح أَربِّـي اَكِذس يُوْوِي-د ثُوْذَارْث ن ڒبْدَا خ وفُوْس ن سِيذِيثْنغ عِيْسَى لْمَسِيح.<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="s">نتْمتَّا س ڒْمُعْصِيّث، نْتدَّر س لْمَسِيح</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />إِيوَا، مِين غَا نِينِي؟ مَا أَ نْسِيغِي ذِي ڒْمُعْصِيَاث حمَا ٱذ يكْثَار اَرْضَا ن أَربِّـي؟ <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />لَّا، عمَّارْص! نشِّين نمُّوْث-اَس إِ ڒْمُعْصِيّث،<note caller="+" style="f"><char style="fr" closed="false">6‏.2 </char><char style="ft" closed="false">زَعْمَا، "نمُّوْث إِ ڒْمُعْصِيّث" هِيَا ڒخُّو وَامِي نُوْمن زِي سِيذِيثْنغ عِيْسَى، ڒْمُعْصِيّث وَار غَارس بُو جّْهذ خَانغ. وَار ثْزمَّر اَذَانغ ثْضَرّ. نشِّين ڒخُّو نتْوَاڒَا ڒْمُعْصِيّث بلِّي نتَّاث ذ ثَعفَّانْت اَطَّاس، وَار نْزمَّر شَا اَزَّايس نْفَرح ؤُڒَا اَذَايس نْعِيش.</char></note> ئِخصَّا-يَانغ ڒخُّو وَار نتْسِيغِي شَا أَ نْعِيش ذَايس. <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />مَا وَار ثسِّينم شَا كنِّيو؟ نشِّين، وَامِي نتْوَاطهَّار س وَامَان حمَا أَ نِيڒِي ذ يجّن اَك لْمَسِيح، نتْوَاطهَّار اَكِذس حمَا أَ نْشَرْش ذِي ڒْموْث نّس. <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" />فَلِهَذَا وَامِي نتْوَاطهَّار اَكِذس س وَامَان، يعْنِي نتْوَانْضڒ اَكِذس ذِي ڒْموْث. مَايمِّي؟ حمَا مَامّش د يكَّر لْمَسِيح زِي ڒْموْث س لْعَظَمَا ن أَربِّـي بَابَاثْنغ، أَمنِّي ؤُڒَا ذ نشِّين اَقَا أَ نْعِيش ذݣ يِجّن ن ثُوْذَارْث ذ جْذِيذ.<verse eid="ROM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5" />شُوْف، مڒَا نْشَرش اَكِذس ذݣ يِجّن ن ڒْموْث اَم ثنِّي إِي يݣَّا نتَّا، أَمنِّي عَاوذ إِي كِذس غَا نْشَرش ذݣ يِجّن ن لْقِيَامَا اَم ثنِّي إِي يݣَّا نتَّا. <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />نشِّين نسّن بلِّي نّفْس نّغ تُوْغَا ثدْجَا قْبڒ، نتَّاث يعْنِي تْوَاصلّب اَك لْمَسِيح حمَا ٱذ تْبطّڒ نّفْس نّغ يشُّوْرن س ڒْمُعْصِيَاث، بَاش وَار نتْغِيمِي شَا سَّا اَڒ ثْسَاونْت عَاذ ذ يسمْغَان<note caller="+" style="f"><char style="fr" closed="false">6‏.6 </char><char style="ft" closed="false">ئِسمْغَان نِثْنِي ذ لْعَبِيد. ڒْمَعْنَا ذَانِيتَا يعْنِي نشِّين ذ لْعَبِيد ن ڒْمُعْصِيّث.</char></note> ن ڒْمُعْصِيّث. <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />أَقَا ونِّي يمُّوْثن يهْنَا زِي ڒْمُعْصِيّث.<verse eid="ROM 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 6:8" />فَا مڒَا نمُّوْث نشِّين اَك لْمَسِيح، نْتَامن عَاوذ اَكِذس ندَّر. <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />نشِّين نسّن قَا لْمَسِيح يكَّر-د زِي ڒْموْث، عمَّارْص اَذ يمّث عَاوذ. وَار تْغِيمِي ڒْموْث اَخَاس ثْحكّم. <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />لِأَنَّا وَامِي يمُّوْث، ئِمُّوْث يجّن ن ثْوَاڒَا وَاهَا إِ ڒبْدَا إِ مِين يدْجَان ذ ڒْمُعْصِيّث. ثُوْذَارْث نّس يدَّر ڒخُّو، يدَّر-يت إِ أَربِّـي. <verse eid="ROM 6:10" /><verse number="11" style="v" sid="ROM 6:11" />أَمُّو لَابُد اَذ تْحسّْبم كنِّيو يخف نْوم ثمُّوْثم-اَس إِ ڒْمُعْصِيّث، ثدَّرم-اَس إِ أَربِّـي س عِيْسَى لْمَسِيح.<verse eid="ROM 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12" />فَلِهَذَا يخصَّا وَار تجِّيم شَا ڒْمُعْصِيّث اَذ تحْكم خ دَّات نْوم إِي غَا يِفْنَان حمَا وَار تݣّم شَا اَرَّاي إِ شّهْوث نّس. <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />وَار تْقدَّامث ؤُڒَا ذ يجّن ن طَّارْف زِي دَّات نْوم إِ ڒْمُعْصِيّث اَذ تݣّ شَّرّْ س دَّات نْوم. قدّْمث يخف نْوم إِ أَربِّـي اَم يِوْذَان زَعْمَا إِي د يكَّرن زݣ يمتِّينن غَار ثُوْذَارْث. قدّْمث كُڒ طَّارْف زِي دَّات نْوم حمَا ٱزَّايس يتْوَاݣّ مِين يدْجَان نِيشَان. <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />أَقَا ڒْمُعْصِيّث وَار ثقِّيم شَا اَذ تحْكم خَاوم لِأَنَّا وَار ثدْجِيم شَا سْوَادَّاي ن وفُوْس ن شَّرِيعَا، أَقَاوم سْوَادَّاي ن اَرْضَا ن أَربِّـي.<verse eid="ROM 6:14" /></para>
  <para style="s">مِين يدْجَان نِيشَان، نشِّين ذ لْعِبَاد نّس</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />إِيوَا نشِّين مَا أَ نعْصَا أَربِّـي خْمِي اَقَانغ سْوَادَّاي ن اَرْضَا نّس وَار ندْجِي شَا سْوَادَّاي ن وفُوْس ن شَّرِيعَا؟ لَّا، عمَّارْص! <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />مَا وَار ثسِّينم شَا؟ مڒَا ثْسلّْمم يخف نْوم إِ شَان يِجّن ثْذوْڒم ذ يسمْغَان ثْطَاعَام-اَس، أَتَاف اَذ تْذوْڒم ذ يسمْغَان إِ ونِّي ؤُمِي ثْطَاعَام. إِمَّا اَذ تْطَاعم إِ ڒْمُعْصِيّث يتَاوِين غَار ڒْموْث، إِمَّا اَذ تْطَاعم إِ ونِّي إِي كنِّيو غَا يَاوِين غَار صُّلْح اَكِذس. <verse eid="ROM 6:16" /><verse number="17‏-18" style="v" sid="ROM 6:17-18" />وَلَكِن أَ نحْمذ أَربِّـي! وَاخَّا ثْطَاعم إِ ڒْمُعْصِيّث قْبڒ، ڒخُّو ثْطَاعَام س وُوْڒَاون نْوم إِ ؤُسڒْمذ نِّي إِي كنِّيو يسِّيوْضن. ثهْنَام زِي ڒْمُعْصِيّث، ثْذوْڒم ذ يسمْغَان إِ مِين يدْجَان نِيشَان. <verse eid="ROM 6:17-18" /><verse number="19" style="v" sid="ROM 6:19" />نش سَّاوَاڒغ اَكِذْوم س يِجّن ن وَاوَاڒ عَادِي لِأَنَّا يقْسح خ بْنَاذم اَذ يفْهم مَانَايَا. قْبڒ تُوْغَا تْقدَّامم كُڒ طَّارْف زِي دَّات نْوم بَاش اَزَّايس يتْوَاݣّ لْفَسَاد ذ شَّرّْ يتمْغُوْرن. وَلَكِن ڒخُّو تْقدَّامث دَّات نْوم اَذ تخْذم مِين يدْجَان نِيشَان حمَا اَذ تِيڒِيم ثصْفَام.<verse eid="ROM 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 6:20" />شُوْف، وَامِي تُوْغَا ثْطَاعَام إِ ڒْمُعْصِيّث، تُوْغَا غَارْوم لْحُرِّيَا اَذ تْرزُّوْم وَار تݣّم مِين يدْجَان نِيشَان. <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />ذِي ڒْوقْث نِّي، ثِمسْڒَايِين نِّي مَا ذَايْسنْت شَان نّْفَع مِينْزِي ڒخُّو تْسذْحَام؟ وَالُو، لِأَنَّا ثِمسْڒَايِين نِّي تَاوِينْت غَار ڒْموْث. <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />ڒخُّو ثْهْنَام زِي ڒْمُعْصِيّث، ثْطَاعَام إِ أَربِّـي. مَان نّْفَع إِي زَّايس غَا ثَاوِيم؟ يعْنِي اَذ تِيڒِيم ثصْفَام أُو مَانَاينِّي يتَاوِي غَار ثُوْذَارْث ن ڒبْدَا. <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />أَقَا اَخدْجس ن ڒْمُعْصِيّث نتَّا ذ ڒْموْث، وَلَكِن لْهَادِيَا ن أَربِّـي نتَّاث ذ ثُوْذَارْث ن ڒبْدَا ذِي سِيذِيثْنغ عِيْسَى لْمَسِيح.<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="s">نتْوَافكّ زِي شَّرِيعَا</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />آي اَيثْمَا، سَّاوَاڒغ اَكِذْوم ثسّْنم شَّرِيعَا. مَا وَار ثسِّينم إِلَّا شَّرِيعَا ثْحكّم خ بْنَاذم إِي يدَّرن وَاهَا؟ <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />مَثَلَان ذِي شَّرِيعَا، ثَمْغَارْث ثمْڒش مڒَا اَرْيَاز نّس اَقَاث عَاذ يدَّر، أَقَات خ يِيرِي نّس. مڒَا اَرْيَاز نّس يمُّوْث اَقَا تْوَافكّ زِي ڒْقَانُوْن ن ڒمْڒَاش. <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />س مَانَايَا، مڒَا ثْرُوْح غَار شَان يِجّن نّغْنِي، أَرْيَاز نّس اَقَاث عَاذ يدَّر، أَتَاف تْوَاحْسَاب ثزْنَا. وَلَكِن مڒَا يمُّوْث ورْيَاز نّس، أَتَاف تْوَافكّ زِي ڒْقَانُوْن-أَ. ڒخْدّنِّي مڒَا ثمْڒش اَك شَان ورْيَاز نّغْنِي اَتَاف وَار تْوِيحِيسِيب شَا ثزْنَا.<verse eid="ROM 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 7:4" />آي اَيْثْمَا، أَمنِّي إِي ثدْجَام ؤُڒَا ذ كنِّيو. يعْنِي تْوَافكّم زِي <char style="it">شَّرِيعَا ن مُوْسَى</char> وَامِي ثمُّوْث دَّات ن لْمَسِيح، أَقَاوم خ يِيرِي ن يِجّن نّغْنِي نتَّا ذ يِيرِي ن <char style="it">لْمَسِيح</char> إِي د يكَّرن زِي ڒْموْث، حمَا أَ نَارو ڒخْذَايم ثِصبْحَانِين إِ أَربِّـي. <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />لِأَنَّا قْبڒ وَامِي تُوْغَا نْتݣّ اَرَّاي إِ طَّبِيعَا ثَعفَّانْت نّغ، اَرْنِينْت ذَايْنغ شّهَاوَاث ثِعفَّانِين عْلَاحْسَاب مِين ذَانغ ثنَّا شَّرِيعَا، خدّْمنْت شّهَاوَاث نِّي ذِي دَّات نّغ أُوْشَا نْتَارو ڒخْذَايم يتَاوِين غَار ڒْموْث. <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />وَلَكِن ڒخُّو، نشِّين نتْوَافكّ زِي شَّرِيعَا-يَا إِي ذَانغ يقّْنن، نمُّوْث-اَس إِ مَانَاينِّي. نشِّين نْعبّذ س يِجّن ن وبْرِيذ ذ جْذِيذ ن اَرُّوْح ن أَربِّـي، مَاشِي س نِّظَام نِّي اَقْذِيم إِي يُوْرِين ذِي لْكِتَاب.<verse eid="ROM 7:6" /></para>
  <para style="s">ڒْمُعْصِيّث ثْسظْهَار-يت-يد شَّرِيعَا</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />إِيوَا مِين غَا نِينِي؟ مَا <char style="it">شَّرِيعَا ن مُوْسَى</char> نتَّاث س يِيخف نّس ذ يجّن ن ڒْمُعْصِيّث؟ لَّا، عمَّارْص! مَعْلِيك شَّرِيعَا وَار ثدْجِي، أَتَاف وَار سِّينغ مِين ثعْنَا ڒْمُعْصِيّث. مَعْلِيك وَار ذَايس ڒُوْصِيّث نِّي &lt;وَار عشّق&gt;، أَتَاف وَار سِّينغ مِين يعْنَا وعشَّاق. <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />ثُمَّا ڒْمُعْصِيّث ثُوْفَا ذَايِي لْفُرْصَا س ڒُوْصِيّث-أَ، ثرْنِي ذَايِي زِي كُڒ نُّوْع ن وعْشَّاق إِي يدْجَان لِأَنَّا ڒْمُعْصِيّث بْڒَا شَّرِيعَا اَخْمِي ثمُّوْث. <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />نش قْبڒ مَا ٱذ سّْنغ شَّرِيعَا، تُوْغَايِي دَّرغ. وَلَكِن وَامِي د ثُوْسَا ڒُوْصِيّث ن أَربِّـي، ڒْمُعْصِيّث اَخْمِي ثكَّر-د زِي ڒْموْث أُوْشَا نش اَخْمِي مُّوْثغ. <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />ثُمَّا ؤُفِيغ ڒُوْصِيّث نِّي إِي د يُوْسِين اَذَايِي ثُوْش ثُوْذَارْث، لَّا، قَا نش ثُوْوِي-يَايِي غَار ڒْموْث. <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" />لِأَنَّا ڒْمُعْصِيّث ثُوْفَا ذَايِي لْفُرْصَا س ڒُوْصِيّث-أَ ثشْمث-اَيِي أُو عَاوذ زَّايس زِي ڒُوْصِيّث-أَ ثْنغ-اَيِي.<verse eid="ROM 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 7:12" />س مَانَايَا <char style="it">شَّرِيعَا ن مُوْسَى</char> ثصْفَا، ڒُوْصِيّث ن أَربِّـي ثصْفَا، ثصْڒَح، ثصْبَاح.<verse eid="ROM 7:12" /></para>
  <para style="s">ئِج ومنْغِي غَار ذَاخڒ ن بْنَاذم</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 7:13" />إِيوَا، مَا يذْوڒ مِين يصبْحَان ذ سَّبَاب إِي زِي غَا مّْثغ نش؟ لَّا، عمَّارْص! لْعَكْس، ذ ڒْمُعْصِيّث إِي يݣِّين مَانَاينِّي، ثسْخدَّام مِين يصبْحَان حمَا اَذَايِي ثْنغ. مَايمِّي؟ حمَا اَذ تسْمظْهَار يخف نّس نتَّاث ذ ڒْمُعْصِيّث. ثُمَّا س <char style="it">لْفُرْصَا ن</char> ڒُوْصِيّث-أَ ڒْمُعْصِيّث ثسْمظْهَار-د بْڒَا ڒَاحدّ مشْحَاڒ يقْبح شَّرّْ نّس.<verse eid="ROM 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14" />فَا نشِّين نسّن <char style="it">شَّرِيعَا ن مُوْسَى</char> زِي أَربِّـي، وَلَكِن نش ذ بْنَاذم تْوَامّنْزغ إِ ڒْمُعْصِيّث. <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" />وَار سنْت تفْهِيمغ شَا إِ ڒخْذَايم ينُو لِأَنَّا نش وَار تݣّغ مِين خْسغ اَث ݣّغ، تݣّغ مِين تْعِيفِّيغ. <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />أُو خْمِي تݣّغ مِين وَار خْسغ شَا اَذ ݣّغ، أَتَاف وَافْقغ بلِّي <char style="it">شَّرِيعَا ن مُوْسَى</char> ثصْبَاح. <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />ثُمَّا زِي سَّا اَڒ ثْسَاونْت اَتَاف مَاشِي ذ نش يتݣّن مَانَايَا، ذ ڒْمُعْصِيّث نِّي إِي ذَايِي يزدّْغن. <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />نش طَّبِيعَا ثَعفَّانْت ينُو سّْنغ وَار ذَايس ثزْذِيغ ؤُڒَا ذ يجّن ن ثْمسْڒَايْث ذ ثَصبْحَانْت. لِأَنَّا رزُّوْغ اَذ ݣّغ ثِمسْڒَايِين ثِصبْحَانِين، وَلَكِن وَار زمَّرغ اَثنْت ݣّغ. <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />ثِمسْڒَايِين نِّي ثِصبْحَانِين إِي تخْسغ اَثنْت ݣّغ وَار ثنْت تݣّغ شَا؛ لَّا، شَّرّْ نِّي إِي وَار تخْسغ اَث ݣّغ تݣّغ-ث. <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />مڒَا تݣّغ مِين وَار تخْسغ، أَتَاف نتَّاث ذ ڒْمُعْصِيّث نِّي إِي ذَايِي يزدّْغن؛ مَاشِي ذ نش يتݣّن مَانَاينِّي.<verse eid="ROM 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21" />فَلِهَذَا نش ؤُفِيغ ذݣ يِيخف ينُو يجّن ن طَّبِيعَا، يعْنِي خْمِي تخْسغ اَذ ݣّغ شَان ثْمسْڒَايْث ذ ثَصبْحَانْت، ؤُفِيغ ذِنِّي شَّرّْ يُوْذس. <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />لِأَنَّا ذِي نّفْس ينُو نش فَرْحغ س شَّرِيعَا ن أَربِّـي، <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />وَلَكِن تَافغ يجّن ن طَّبِيعَا نّغْنِي ذݣ يخف ينُو إِݣ يتْمنْغَان اَكذ مِين غَارِي ذِي ڒَعْقڒ ينُو. س طَّبِيعَا-يَا تقّن-اَيِي ڒْمُعْصِيّث نِّي إِي ذَايِي يزدّْغن ذݣ يِيخف ينُو. <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />يَا ڒفْضِيحث ينُو نش! وِي ذَايِي غَا يسْنجْمن زِي دَّات-أَ ثَانِيتَا ن ڒْموْث؟ <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />تْشكَّرغ أَربِّـي عْلَاحْسَاب سِيذِيثْنغ عِيْسَى لْمَسِيح!</para>
  <para style="p" vid="ROM 7:25">س مَانَايَا ذِي ڒَعْقڒ ينُو نش ذ يسْمغ<note caller="+" style="f"><char style="fr" closed="false">7‏.25 </char><char style="ft" closed="false">ئِسْمغ نتَّا ذ لْعَبِيد.</char></note> ن شَّرِيعَا ن أَربِّـي، نش ذِي دَّات ينُو ذ يسْمغ ن طَّبِيعَا ن ڒْمُعْصِيّث.<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="s">جّْهذ ن اَرُّوْح ن أَربِّـي يخدّْمن ذِي ثُوْذَارْث ن ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />إِذن فَا ڒخُّو، وَار يدْجِي بُو لْحِسَاب ذ لْعِقَاب خ يِنِّي يدْجَان ذ يجَّن اَك عِيْسَى لْمَسِيح. <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />لِأَنَّا ذِي عِيْسَى لْمَسِيح، طَّبِيعَا ن اَرُّوْح إِݣ يتِيشّن ثُوذَارْث ثْفكّ-يشك-د زِي طَّبِيعَا ن ڒْمُعْصِيّث ذ ڒْموْث. <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />شُوْف، أَربِّـي يݣَّا مِين وَار ثْزمَّر اَذ تݣّ <char style="it">شَّرِيعَا ن مُوْسَى</char>، مَايمِّي؟ عْلَاحْسَاب ضُّعف ن دَّات نّغ إِي ذَاس يكّْسن جّْهذ إِ شَّرِيعَا. أَربِّـي، وَامِي إِي د يسّكّ مِّيس يمثّل-يث-يذ اَم دَّات ن بْنَاذم يعْصَان، ئِسّكّ-يث-يذ ذ لْفِدْيَا خ ڒْمُعْصِيّث نّغ. أَمُّو يحَاسب يعَاقب ڒْمُعْصِيّث إِݣ يدْجَان ذِي دَّات ن بْنَاذم <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />بَاش اَذ يتْوَاكمّڒ مِين ثْخس زَّاينغ <char style="it">شَّرِيعَا ن مُوْسَى</char>. نشِّين، يعْنِي ذ يِنِّي إِݣ يݣُّوْرن ذݣ وبْرِيذ ن اَرُّوْح، وَار نْتݣّ اَرَّاي إِ نّفْس نّغ.<verse eid="ROM 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 8:5" />شُوْف، يِنِّي يتْعِيشن عْلَاحْسَاب طَّبِيعَا ثَعفَّانْت نْسن خدّْمن س ڒْخَاضَر نْسن ذِي ثْمسْڒَايِين ن طَّبِيعَا ثَعفَّانْت نْسن. وَلَكِن يِنِّي يتْعِيشن عْلَاحْسَاب اَبْرِيذ ن اَرُّوْح خدّْمن س ڒْخَاضَر نْسن ذِي ثْمسْڒَايِين ن اَرُّوْح. <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />أَقَا يِنِّي يخدّْمن س ڒْخَاضَر نْسن ذِي ثْمسْڒَايِين ن طَّبِيعَا ثَعفَّانْت نْسن اَتَاف اَذ مّْثن. وَلَكِن يِنِّي يخدّْمن س ڒْخَاضَر نْسن ذِي ثْمسْڒَايِين ن اَرُّوْح اَتَاف اَذ دَّرن، أَغَارْسن يِيڒِي ڒهْنَا. <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />أَقَا ڒْخَاضَر يخدّْمن ذِي ثْمسْڒَايِين ن طَّبِيعَا ثَعفَّانْت ن بْنَاذم يتْعَرَّاض أَربِّـي. وَار يتْطِيعِي شَا شَّرِيعَا ن أَربِّـي، أُو ذ صَّح وَار يزمَّر شَا. <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />أُو يِنِّي يتْطَاعَان إِ طَّبِيعَا ثَعفَّانْت نْسن وَار زمَّرن شَا اَذ سَارْضَان أَربِّـي.<verse eid="ROM 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9" />أَمَّا كنِّيو، مڒَا يزدّغ ذَايْوم اَرُّوْح ن أَربِّـي، أَتَاف اَذ تْعِيشم خ وبْرِيذ ن اَرُّوْح اَتَاف وَار تݣّم اَرَّاي إِ طَّبِيعَا ثَعفَّانْت نْوم. أُو ونِّي وَار غَار يدْجِي اَرُّوْح ن لْمَسِيح، وَار يدْجِي شَا زِي لْمَسِيح. <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />ثُمَّا لْمَسِيح مڒَا اَقَاث ذَايْوم، دَّات نْوم وَاخَّا ثمُّوْث س سَّبَاب ن ڒْمُعْصِيّث، أَرُّوْح نْوم يدَّر س سَّبَاب ن صُّلْح. <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" />ثُمَّا مڒَا يزدّغ ذَايْوم اَرُّوْح ن أَربِّـي إِي د يسكَّرن عِيْسَى زِي ڒْموْث، أَتَاف ونِّي إِي د يسكَّرن عِيْسَى زِي ڒْموْث اَذَايْوم د يَارّ ثُوْذَارْث ؤُڒَا ذِي دَّات نْوم يفنَّان يعْنِي س اَرُّوْح نّس إِي ذَايْوم يزدّْغن.<verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />خ مَانَاينِّي آي اَيثْمَا، ئِتْخصَّا-يَانغ أَ نݣّ لْوَاجِب، وَلَكِن مَاشِي حمَا أَ نݣّ اَرَّاي إِ طَّبِيعَا ثَعفَّانْت نّغ. <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />لِأَنَّا كنِّيو مڒَا تݣّم اَرَّاي إِ طَّبِيعَا ثَعفَّانْت نْوم، أَذ تمّْثم. مڒَا ثْنقّم ڒفْعَاير ن دَّات نْوم س اَرُّوْح ن أَربِّـي، أَذ تدَّرم. <verse eid="ROM 8:13" /><verse number="14" style="v" sid="ROM 8:14" />أُو يِنِّي يذفَّارن اَرُّوْح ن أَربِّـي، ذ يِنِّي إِي يدْجَان ذ ثَارْوَا ن أَربِّـي. <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" />لِأَنَّا اَرُّوْح إِي ذَاوم د يمُّوْشن وَار كنِّيو يتَارِّي شَا ذ يسمْغَان حمَا اَذ تْعِيشم عَاوذ ذِي ثِيݣّْوْذِي؛ لَّا، ئِمُّوْش-اَوم-د اَرُّوْح يقدّْسن حمَا اَذ تِيڒِيم ذ ثَارْوَا ن أَربِّـي. س اَرُّوْح نِّي إِي غَا نْڒَغَا: أَبَّا، يعْنِي، أَ بَابَا ينُو. <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />يعْنِي اَرُّوْح ن أَربِّـي س يِيخف نّس إِݣ يصَّاحن ذِي اَرُّوْح نّغ بلِّي نشِّين ذ ثَارْوَا ن أَربِّـي. <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />أُو نشِّين مڒَا اَقَانغ ذ ثَارْوَا ن أَربِّـي، أَتَاف أَ نْوَارث. يعْنِي أَ نْوَارث زِي أَربِّـي، أَ نْوَارث اَك لْمَسِيح. وَلَكِن يخصَّا-يَانغ أَ نْشَرش اَكِذس ذݣ وعدّب نّس حمَا أَ نْشَرش اَكِذس عَاوذ ذِي لْعَظَمَا نّس.<verse eid="ROM 8:17" /></para>
  <para style="s">لْعَظَمَا إِي ذَانغ يتْرَاجَان</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />شُوْف، نش تْوَاڒِيغ اَعدّب-أَ إِي خَانغ يتكّن ذِي دُّنشْت-أَ نتَّا وَار يدْجِي ذ وَالُو بَاش اَذ يمثّل اَك لْعَظَمَا إِي ذَانغ د غَا يمظْهَارن. <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />أَقَا مَارَّا مِين د يتْوَاخڒْقن ذَايْسن مزْڒِي<note caller="+" style="f"><char style="fr" closed="false">8‏.19 </char><char style="ft" closed="false">مزْڒِي قَّارن-ث إِ يمزْڒِي.</char></note> ذ اَمقّْرَان تْرَاجَان اَذ ࢲرن ثْسَعَّات نِّي إِي ذِي د غَا بَانن ثَارْوَا ن أَربِّـي. <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />لِأَنَّا مَارَّا مِين د يتْوَاخڒْقن نْصَابن س لْفَشَل. وَلَكِن مَاشِي س اَرَّاي نْسن، س اَرَّاي ن ونِّي إِي ثن يصَابن. أُو مَانَاينِّي ذِي لْأَمَال. <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />لْأَمَال، يعْنِي، بلِّي مَارَّا مِين د يتْوَاخڒْقن اَذ تْوَافكّن زِي لْفَنَا ن ڒْموْث، أَذ شَرْشن ذِي لْحُرِّيَا ن لْعَظَمَا إِي غَارْسن غَار ثَارْوَا ن أَربِّـي.<verse eid="ROM 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 8:22" />شُوْف، نشِّين نسّن بلِّي مَارَّا مِين د يتْوَاخڒْقن اَقَاثن اَڒ نْهَارَا عَاذ تْنزْبَارن اَمشْنَاو ثَمْغَارْث نِّي إِي ذِي يدْجَا ڒحْرِيق ن ثَارْوَا. <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" />أُو مَاشِي نِثْنِي وَاهَا، ؤُڒَا ذ نشِّين ؤُمِي يمُّوْش اَرُّوْح يقدّْسن ذ اَمزْوَارُو نْنهّك ذݣ يِيخف نّغ. ذَايْنغ مزْڒِي، نشِّين نتْرَاجَا زِي أَربِّـي اَذ د يسْبيّن بلِّي نشِّين ذ ثَارْوَا نّس، يعْنِي اَذ يفكّ دَّات نّغ. <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />أَقَا ذِي مزْڒِي-يَا نشِّين ننْجم. شُوْف، مڒَا صَافِي نُوْفَا مزْڒِي نِّي إِي نْرزُّو، أَتَاف صَافِي وَار ذَايْنغ يتِيڒِي بُو مزْڒِي عَاذ. مَا أَ نْرَاجَا عَاذ مزْڒِي نِّي مڒَا صَافِي نُوْفِي-ث؟ <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />لَّا، وَلَكِن مڒَا عَاذ وَار ث نُوْفِي شَا اَتَاف اَث نْرَاجَا س صّْبَر.<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />فَا اَمُّو اَرُّوْح يقدّْسن يتْعَاوَان-اَنغ ذِي ضُّعف نّغ. نشِّين وَار نسِّين شَا مْلِيح مِينْخف غَا نࢲَّادْج، وَلَكِن اَرُّوْح يقدّْسن س يِيخف نّس يتْطَلَاب-اَس إِ أَربِّـي خ سَّبَاب نّغ س ونْهَاك وَار يتْسمِيعن. <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />ثُمَّا أَربِّـي نتَّا يتْوَاڒَان مِين يدْجَان ذݣ وُوْڒَاون ن بْنَاذم، ئِسّن مِين يتخْس اَرُّوْح يقدّْسن. لِأَنَّا اَرُّوْح عْلَاحْسَاب ڒْخَاضَر ن أَربِّـي يتْطَلَاب خ ڒْمُوْمِنِين صَّالِحِين.<verse eid="ROM 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28" />فَا نشِّين نسّن بلِّي مَارَّا مِين يتوْقِيعن قَاع يتَارَّا-ث أَربِّـي ذ تِّيسِير إِ يِنِّي إِي ث يتخْسن، يعْنِي ذ يِنِّي ؤُمِي إِي د يڒَغَا عْلَاحْسَاب لْغَرَض نّس. <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />لِأَنَّا يِنِّي إِي تُوْغَا يسّن-يثن زِي قْبڒ، ئِزمّم-يثن زِي قْبڒ حمَا اَذ يڒِين خ صِّيفث ن مِّيس اَذ يڒِين اَم نتَّا. أَمُّو اَذ يِيڒِي نتَّا ذ مِّيس اَمنْزُو<note caller="+" style="f"><char style="fr" closed="false">8‏.29 </char><char style="ft" closed="false">أَمنْزُو نتَّا ذ يفْخدِّي. قَّارن-ث إِ وحنْجِير إِي د غَا يخڒْقن ذ اَمزْوَارُو.</char></note> ن وَاطَّاس ن أَيثْمَاس. <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />ثُمَّا يِنِّي إِي تُوْغَا يزمّم زِي قْبڒ، ئِڒَاغَا-د خَاسن. ثُمَّا يِنِّي ؤُمِي د يڒَاغَا، ئِسمْصْڒَاح-يثن اَكِذس. ثُمَّا يِنِّي يسمْصْڒَاح اَكِذس، يُوْشَا-اَسن اَمْشَان ذِي لْعَظَمَا نّس.<verse eid="ROM 8:30" /></para>
  <para style="s">ڒمْحِبّث ن أَربِّـي ذِي لْمَسِيح</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />إِيوَا، مِين غَا نِينِي منْبَعْد إِ مَارَّا مَانَايَا؟ مڒَا أَربِّـي اَقَاث اَكِذْنغ، ؤُو يزمَّرن اَذ يِيڒِي ضد نّغ؟ <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" /><char style="it">سِيذِي أَربِّـي</char> وَار يسْعِيزّ شَا مِّيس خَانغ، ئِقدّم-يث إِ ڒْموْث خَانغ مَارَّا. مَا اَذ تقِّيم شَان ڒْحَاجث وَار ذَانغ-ت يتِيشّ شَا اَكِذس؟ <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />وِي يزمَّرن اَذ يتَاهم يِنِّي إِي يخْضَر أَربِّـي؟ <char style="it">ؤُڒَا ذ يجّن!</char> أَربِّـي س يِيخف نّس نتَّا إِݣ يسمْصْڒَاحن اَكِذس يوْذَان. <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />وِي يزمَّرن اَخَاسن يحْكم؟ <char style="it">ؤُڒَا ذ يجّن!</char> لِأَنَّا نتَّا عِيْسَى لْمَسِيح إِݣ يمُّوْثن. أُو كْتَار، يكَّر-د زِي ڒْموْث أُو ذ نتَّا إِي يدْجَان خ وفُوْسِي ن أَربِّـي، ئِتْشَافَاعن ذَايْنغ. <verse eid="ROM 8:34" /><verse number="35" style="v" sid="ROM 8:35" />وِي ذَانغ غَا يعزْڒن زِي ڒمْحِبّث ن لْمَسِيح؟ ؤُڒَا ذ يجّن! ڒَا ذ اَزيَّار، ڒَا ذ تَمَارَا، ڒَا ذ اَعدّب، ڒَا ذ بُوْهيُّوْف، ڒَا ذ ثُوْعَرْيَانْت، ڒَا ذ لْخَطَر، ؤُڒَا ذ سِّيف. <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />مَامّش يقَّار لْكِتَاب:</para>
  <para style="q1" vid="ROM 8:36">&lt;نشِّين خ سَّبَاب نّش شك نتْوَاجَاه ڒْموْث نْهَار يكْمَاڒ.</para>
  <para style="q1" vid="ROM 8:36">نشِّين نتْوَاحْسَاب اَمشْنَاو يحُوْڒِيْين ؤُمِي غَا غَرْصن.&gt;<verse eid="ROM 8:36" /></para>
  <para style="b" />
  <para style="p">
    <verse number="37" style="v" sid="ROM 8:37" />وَلَكِن ذِي مَارَّا مَانَايَا نشِّين نتْوَاحْسَاب كْتَار زِي لْأَبْطَال خ وفُوْس ن ونِّي إِي ذَانغ يخْسن. <verse eid="ROM 8:37" /><verse number="38‏-39" style="v" sid="ROM 8:38-39" />أَقَا نش متْأَكّد بلِّي ؤُڒَا ذ يجّن ن ثْمسْڒَايْث زِي مِين د يتْوَاخڒْقن وَار ثْزمَّر اَذَانغ ثعْزڒ زِي ڒمْحِبّث ن أَربِّـي إِي د يمظْهَارن ذِي سِيذِيثْنغ عِيْسَى لْمَسِيح: ڒَا ذ ڒْموْث، ڒَا ذ ثُوْذَارْث، ڒَا ذ لمَلَائِكَاث، ڒَا ذ شَّيَاطِن، ڒَا ذ جْنُوْن، ڒَا ذ مِين يدْجَان ڒخُّو، ڒَا ذ مِين د غَا يَاسن، ڒَا ذ مِين يُوْعْڒَان، ڒَا ذ مِين يُوْدْجْغن، ؤُڒَا ذ شَا ن ڒْحَاجث نّغْنِي.<verse eid="ROM 8:38-39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="s">أَرَّسُوْل بُوْلُس يتْخيَّاق خ لْأُمَّا ن سِيذْنَا مُوْسَى</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />سَّاوَاڒغ ڒْحَقّ ذِي لْمَسِيح وَار يدْجِي بُو ذ يخَرِّيقن. ڒَعْقڒ ينُو أُو ذ اَرُّوْح يقدّْسن اَذَايِي صَحّن مِين غَا ينِيغ. <verse eid="ROM 9:1" /><verse number="2‏-3" style="v" sid="ROM 9:2-3" />يعْنِي، ئِسْحرّق-اَيِي يجّن ن ڒحْرِيق اَطَّاس ذݣ وُوْڒ ينُو وَار يتْكمِّيڒ شَا خ سَّبَاب ن ڒْقُوْم ينُو، يعْنِي يِنِّي يدْجَان زِي لْأُمَّا ينُو. مَعْلِيك زمَّرغ نش، أَذ تْوَانعْڒغ اَذ تْوَاحَرّْمغ زِي لْمَسِيح بَاش نِثْنِي وَار تْوَانعِّيڒن شَا وَار تْوَاحَرِّيمن شَا زِي لْمَسِيح. <verse eid="ROM 9:2-3" /><verse number="4" style="v" sid="ROM 9:4" />نِثْنِي ذ أَيث-إِسْرَائِيل، يتْبنَّا-ثن سِيذِي أَربِّـي. ئِسْمظْهَار-اَسن-د لْعَظَمَا نّس، ئِعَاهذ-يثن، يُوْشَا-اَسن <char style="it">شَّرِيعَا ن مُوْسَى</char> ذ لْعِبَادَا، يوْعذ-يثن. <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />ؤُسِين-د زِي سَّلَف صَّالِحِين، أُو زݣ وࢲْور نْسن إِي د يُوْسَا لْمَسِيح ذ دَّات ذ بْنَاذم. أَربِّـي يتْوَاحْمذ إِ ڒبْدَا، ونِّي يحكّْمن خ مَارَّا. آمِين.<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />وَلَكِن، أَوَاڒ ن أَربِّـي مَا وَار ينْجِيح شَا؟ لَّا، ئِنْجح! فَا مَاشِي أَيث-إِسْرَائِيل قَاع إِݣ يدْجَان ذ يسْرَائِلِيْين ذ صَّح. <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />عَاوذ وَار يدْجِي مَارَّا ثَارْوَا إِي د يكِّين زِي بْرَاهِيم ذ ثَارْوَا نّس ن صَّح. <char style="it">ينَّا-ٱس أَربِّـي:</char> &lt;ذ ثَارْوَا نّش إِي د غَا يفّْغن زِي <char style="it">مِّيش</char> إِسْحَاق إِي غَا يتْوَاحسّْبن.&gt; <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />مَانَايَا يخس اَذ يِينِي ثَارْوَا ن أَربِّـي ذ صَّح تْوَاحسّْبن زِي ثَارْوَا ن ڒْعَهذ، مَاشِي زِي ثَارْوَا ن بْنَاذم. <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />لِأَنَّا ڒْعَهذ-أَ إِي ذَاس يُوْشَا أَربِّـي إِ بْرَاهِيم ذ وَانِيتَا، ينَّا: &lt;أَذ د عقْبغ اَسݣّْوَاس إِي د غَا يَاسن اَم ڒْوقْث-أَ، أَذ اَفغ يج وحنْجِير غَار سَارَا.&gt;<verse eid="ROM 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10" />وَار يدْجِي بُو مَانَاينِّي وَهَا. رَفِيقَا ثيْسِي اَعدِّيس غَارس <char style="it">اَشْنِيون</char>. بَابَاثْسن نتَّا ذ جدِّيثْنغ إِسْحَاق. <verse eid="ROM 9:10" /><verse number="11‏-12" style="v" sid="ROM 9:11-12" />ثُمَّا يكَّر أَربِّـي ينَّا-ٱس إِ رَفِيقَا قَا اَمقّْرَان اَذ يِيڒِي ذ اَخدَّام غَار ومزْيَان. ئِڒَاغَا-يَاس-د أَربِّـي إِ نتَّا وَاهَا، نِثْنِي وَار ݣِّين وَالُو. تُوْغَا عَاذ وَار د خْڒِيقن شَا عَاذ وَار ݣِّين ڒْخِير وَار ݣِّين شَّرّْ، وَلَكِن <char style="it">سِيذِي أَربِّـي</char> يخْضَر يجّن زَّايْسن يسْمظْهَار-د ڒْخَاضَر نّس إِي غَا يِيڒِين. <verse eid="ROM 9:11-12" /><verse number="13" style="v" sid="ROM 9:13" />مَامّش يقَّار لْكِتَاب: &lt;حِيْبّغ يَعْقُوْب، سحْقَرغ عَسُو.&gt;<verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />مِين غَا نِينِي خ مَانَايَا؟ مَا أَربِّـي يضدْجم؟ لَّا، عمَّارْص! <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />قَا أَربِّـي ينَّا-ٱس إِ مُوْسَى: &lt;أَذ رحْمغ ونِّي خْسغ، أَذ حِيْنّغ خ ونِّي خْسغ.&gt; <verse eid="ROM 9:15" /><verse number="16" style="v" sid="ROM 9:16" />مَانَايَا وَار يدْجِي شَا زِي ڒْخذْمث ن بْنَاذم نِغ زِي مِين يتخْس، مَانَايَا اَقَاث زِي أَربِّـي ونِّي يرحّْمن. <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />أَقَا يقَّار-اَس لْكِتَاب إِ فِيرْعُوْن: &lt;ݣِّيغ-اَش ذ اَزدْجِيذ حمَا اَذَايك د سْمظْهَارغ جّْهذ ينُو، حمَا اَذ يتْوَاسّن يِيسم ينُو ذِي مَارَّا دُّنشْت.&gt; <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />فَلِهَذَا أَربِّـي يرحّم ونِّي يخس، ئِسْغَانَّان ونِّي يخس.<verse eid="ROM 9:18" /></para>
  <para style="s">أَغْضَاب ن أَربِّـي ذ اَرَّحْمث نّس</para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />إِيوَا آ بْنَاذم، مَا ٱذَايِي ثِينِيذ مَايمِّي عَاذ إِي ذَانْغ يتْحَاسَاب أَربِّـي؟ <char style="it">مَا ٱذَايِي ثِينِيذ،</char> ؤُݣ يزمَّرن اَذ يمْغَانّن اَك مِين يخْس نتَّا؟ <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" /><char style="it">شُوْف</char> آ بْنَادم، مِين ثعْنِيذ شك بَاش ثْزمَّرذ اَذ تَارّذ اَوَاڒ خ أَربِّـي؟ مَا زمَّرن اَذ ينِين يغرَّافن إِ ونِّي إِي ثن يصنْعن، مَايمِّي ذَانغ ثݣِّيذ اَمُّو؟ <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />مَا وَار غَارس بُو ڒْحَقّ غَار لمْعَلّم اَذ يسخْذم ثْڒَاخْث<note caller="+" style="f"><char style="fr" closed="false">9‏.21 </char><char style="ft" closed="false">ثْڒَاخْث نتَّاث ذ يذقِّي.</char></note> مَامّش يخْس، يعْنِي اَذ يݣّ زݣ يِجّن ن ڒْعَجْنث يذقِّي يجّن ن وغرَّاف إِ مِين يصبْحَان، أَذ يݣّ يجّن إِ مِين يعُوْفّْنن؟<verse eid="ROM 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22" />أَمنِّي إِݣ يݣَّا أَربِّـي. وَامِي يخس اَذ د يسْمظْهَار اَغْضَاب نّس اَذ د يسْبيّن جّْهذ إِي غَارس، ئِصبَّار اَطَّاس خ <char style="it">يِنِّي إِي خف يغْضب</char>، يعْنِي يغرَّافن نِّي وجْذن اَذ تْوَارْزن. <verse eid="ROM 9:22" /><verse number="23‏-24" style="v" sid="ROM 9:23-24" />يݣَّا اَمنِّي لِأَنَّا يخس اَذ يسْمظْهَار لْعَظَمَا نّس يمْغَارن خ يِيْنَا إِݣ يرْحم، يعْنِي يغرَّافن-أَ إِݣ يسوْجذ زِي قْبڒ إِ لْعَظَمَا، يعْنِي ذ نشِّين. ئِڒَاغَا-يَانغ-د إِ نشِّين إِي د يُوْسِين زِي أَيث-إِسْرَائِيل ؤُڒَا ذ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل. <verse eid="ROM 9:23-24" /><verse number="25" style="v" sid="ROM 9:25" />مَامّش يقَّار أَربِّـي ذِي لْكِتَاب ن نَّبِي هُوْشَع:</para>
  <para style="q1" vid="ROM 9:25">&lt;يِنِّي تُوْغَا وَار يدْجِين شَا ذ شَّعْب ينُو،</para>
  <para style="q1" vid="ROM 9:25">أَسن ڒَاغِيغ آ شَّعْب ينُو.</para>
  <para style="q2" vid="ROM 9:25">ثنِّي تُوْغَا وَار يعِيزّن،</para>
  <para style="q1" vid="ROM 9:25">أَس ڒَاغِيغ آ ثَمْعِيزِّيت ينُو.&gt;<verse eid="ROM 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 9:26" />أُو ذݣ ومْشَان نِّي ونِّي مَانِي ذَاسن ينَّا أَربِّـي: كنِّيو وَار ثدْجِيم ذ شَّعْب ينُو، ذِنِّي إِي ذَاسن غَا ڒَاغَان آ ثَارْوَا ن أَربِّـي يدَّرن.<verse eid="ROM 9:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="ROM 9:27" />فَا نَّبِي إِشَعْيَا، ئِڒَاغَا نتَّا خ أَيث-إِسْرَائِيل ينَّا: &lt;وَاخَّا لْعَدَد ن أَيث-إِسْرَائِيل يݣَّا اَم يِجْذِي ن ڒبْحَر، ذْرُوْس زَّايْسن إِي غَا ينجْمن. <verse eid="ROM 9:27" /><verse number="28" style="v" sid="ROM 9:28" />أَقَا سِيذِي أَربِّـي وَار يتْعطِّيڒ شَا اَذ يخْذم ذِي دُّنشْت-أَ اَوَاڒ إِݣ ينَّا.&gt; <verse eid="ROM 9:28" /><verse number="29" style="v" sid="ROM 9:29" />أَمُّو إِݣ ينَّا نَّبِي إِشَعْيَا زِي قْبڒ: &lt;مَعْلِيك وَار يدْجِي ذ سِيذِي أَربِّـي لْعَلَامِين إِي يحفْضن شَان دُّوْرِّيث نّغ، إِڒِي يوْقع-اَنغ اَمشْنَاو مِين يوقْعن إِ ثنْدِينْت ن سَادُوْم ذ ثنْدِينْت ن عَمُوْرَا.&gt;<verse eid="ROM 9:29" /></para>
  <para style="s">أَيث-إِسْرَائِيل تَاݣِين اَذ اَمْنن</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />إِيوَا، مِين غَا نِينِي؟ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل تُوْغَا وَار رزُّوْن شَا صُّلْح اَك أَربِّـي، وَلَكِن ؤُفِين-ث وَامِي ؤُمْنن. <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />أَيث-إِسْرَائِيل وَامِي رزُّوْن يجّن ن شَّرِيعَا يتِيشّن صُّلْح اَك أَربِّـي، وَار ؤُفِين شَا شَّرِيعَا نِّي. <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />مَايمِّي؟ لِأَنَّا تُوْغَا رزُّوْن صُّلْح نِّي س ڒخْدَايم نْسن وَاهَا بْڒَا مَا ٱذ اَمْنن. نْقڒْظن ذݣ وزْرُو نِّي إِي ذِي تْنقْڒَاظن يِوْذَان. <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />مَامّش يقَّار لْكِتَاب:</para>
  <para style="q1" vid="ROM 9:33">&lt;أَقَا ݣِّيغ ذِي ثنْدِينْت ن لْقُدْس</para>
  <para style="q2" vid="ROM 9:33">يج ن تِّيرْشث إِي ذِي تنْقْڒَاظن يِوْذَان،</para>
  <para style="q2" vid="ROM 9:33">ذ يِجّن ن وزْرُو إِي ثن يغطّْڒن.</para>
  <para style="q1" vid="ROM 9:33">ونِّي إِي زَّايس غَا يَامْنن،</para>
  <para style="q2" vid="ROM 9:33">عمَّارْص اَث خيّْبغ.&gt;<verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />
    <char style="it">ينَّا-ٱسن بُوْلُس:</char> آي اَيثْمَا، مشْحَاڒ تْمنِّيغ س وُوْڒ ينُو تْࢲَادْجِيغ إِ أَربِّـي اَذ تنْجم لْأُمَّا ينُو. <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />نش شهّْذغ خَاسن رزُّوْن اَذ ݣّن لْوَاجِب اَك أَربِّـي، وَلَكِن وَار سِّينن شَا اَذ ݣّن لْوَاجِب. <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />وَامِي وَار سِّينن شَا مَامّش يݣَّا أَربِّـي يسمْصْڒَاح اَكِذس بْنَاذم، كَّرن نِثْنِي ذْفَارن اَبْرِيذ نْسن نِّيث وَار قْبِيڒن شَا اَبْرِيذ ن أَربِّـي. <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />لِأَنَّا لْمَسِيح ذَايس ذِي نتَّا إِي ثْكمّڒ شَّرِيعَا حمَا مَارَّا وِي زَّايس غَا يَامْنن اَذ يمصْڒَاح اَك أَربِّـي.<verse eid="ROM 10:4" /></para>
  <para style="s">مَارَّا يوْذَان زمَّرن اَذ نجْمن</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5" />شُوْف، مَامّش يدْجَا وبْرِيذ ن صُّلْح عْلَاحْسَاب شَّرِيعَا؟ يُوْرَا خَاس مُوْسَى ينَّا: مَارَّا وِي غَا يخذْمن س ثْمسْڒَايِين-أَ ثِيْنَا، أَتَاف اَزَّايْسنْت يعِيش. <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />وَلَكِن مِين يقَّار لْكِتَاب خ ونِّي يرزُّوْن اَذ يمصْڒَاح اَك أَربِّـي اَزَّايس يَامن؟ ئِقَّار: وَار قَّار شَا ذݣ وُوْڒ نّش: مِين يعْنَا وِي غَا يݣَعّْذن غَار وجنَّا (يعْنِي بَاش اَذ د يسهْوَا لْمَسِيح)؟ <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />نِغ: مِين يعْنَا وِي غَا يهْوَان غَار ڒَادْجغ بْڒَا ڒَاحدّ (يعْنِي بَاش اَذ د يَارّ لْمَسِيح زݣ يِنِّي يمُّوْثن)؟ <verse eid="ROM 10:7" /><verse number="8" style="v" sid="ROM 10:8" />إِيوَا مِين يقَّار لْكِتَاب؟ ئِقَّار: &lt;أَوَاڒ-أَ يُوْذس إِ شك، أَقَاث ذݣ وقمُّوْم نّش ذ وُوْڒ نّش.&gt; يعْنِي اَوَاڒ-أَ نتَّا ذ لإِيمَان إِي زِي نتْحدَّاث. <verse eid="ROM 10:8" /><verse number="9" style="v" sid="ROM 10:9" />قَا مڒَا ثْشهْذذ س وقمُّوْم نّش إِلَّا عِيْسَى ذ سِيذِيش، مڒَا ثُوْمْنذ س وُوْڒ نّش إِلَّا أَربِّـي يسكَّر-يث-يذ زِي ڒْموْث، أَتَاف اَذ تْنجْمذ. <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />لِأَنَّا س وُوْڒ نّش شك تَامْنذ، أَش يسمْصْڒَاح أَربِّـي اَكِذس. أُو س وقمُّوْم نّش شك ثْشهّْذذ، شك ثْنجْمذ. <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />أَقَا لْكِتَاب يقَّار: &lt;مَارَّا ونِّي زَّايس غَا يَامْنن وَار ث يتْخِيِّيب شَا.&gt; <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />لِأَنَّا وَار ذِنِّي بُو ڒْفَارْق جَار يئِسْرَائِيليْين ذ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل مِينْزِي سِيذِي أَربِّـي ذ يجّن، أَقَاث خَانغ مَارَّا. ئِتنْفيَّاض-د ڒْخِير نّس خ مَارَّا ونِّي خَاس يتْڒَاغَان. <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />أَقَا &lt;مَارَّا ونِّي إِي غَا يڒَاغَان س يِيسم ن سِيذِي أَربِّـي اَتَاف اَذ ينْجم.&gt;<note caller="+" style="f"><char style="fr" closed="false">10‏.13 </char><char style="ft" closed="false">خْزَر لْكِتَاب ن نَّبِي وَائِل 2‏:32.</char></note><verse eid="ROM 10:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14" />إِذن، مَامّش غَا ݣّن اَذ ڒَاغَان خ ونِّي إِي زِي وَار يُوْمِينن شَا؟ مَامّش غَا ݣّن اَذ اَمْنن زݣ ونِّي ؤُمِي وَار خَاس سْڒِين شَا؟ مَامّش غَا ݣّن اَخَاس سْڒن مڒَا وَار ذَاسن يتْحدِّيث حَدّ؟ <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />أُو مَامّش غَا ݣّن اَذ حدّْثن مڒَا وَار ذَاسن د يسّكّ حَدّ؟ أَقَا يقَّار لْكِتَاب: &lt;مشْحَاڒ صبْحَان يضَارن ن يِنِّي يتْبشَّارن س لْإِنْجِيل.&gt; <verse eid="ROM 10:15" /><verse number="16" style="v" sid="ROM 10:16" />لْإِنْجِيل وَلَكِن وَار ث قْبِيڒن شَا مَارَّا يوْذَان. أَقَا مِين يقَّار نَّبِي إِشَعْيَا <char style="it">زِي زْمَان</char>: &lt;آ سِيذِي أَربِّـي، وِي يُوْمْنن س مِينْزِي نتْبشَّار؟&gt; <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />فَلِهَذَا، لإِيمَان يتَاس-د زِي مِين نتْسْڒَا، أُو مِين نْتسْڒَا نتَّا ذ اَوَاڒ ن لْمَسِيح.<verse eid="ROM 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 10:18" />وَلَكِن نش تْسقْسِيغ، مَا وَار سْڒِين شَا؟ وَاه، سْڒِين. <char style="it">أَقَّا مِين يقَّار لْكِتَاب</char>:</para>
  <para style="q1" vid="ROM 10:18">&lt;ذِي مَارَّا ثَمُوْرْث يفّغ-د صُّوْت نْسن،<note caller="+" style="f"><char style="fr" closed="false">10‏.18 </char><char style="ft" closed="false">يعْنِي، صُّوْت ن يِنِّي يتْبشَّارن.</char></note></para>
  <para style="q1" vid="ROM 10:18">أَوَاڒن نْسن ؤُوْضن اَڒ ڒَاحدّ ن دُّنشْت.&gt;<verse eid="ROM 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 10:19" />عَاوذ نش تْسقْسِيغ، أَيث-إِسْرَائِيل مَا وَار فْهِيمن شَا؟ ذ اَمزْوَارُو ينَّا-ٱسن مُوْسَى:</para>
  <para style="q1" vid="ROM 10:19">&lt;أَكنِّيو جّغ اَذ تْحسْذم يِنِّي وَار يدْجِين شَا ذ لْأُمَّا،</para>
  <para style="q1" vid="ROM 10:19">أَكنِّو سْعصّْبغ س يِجّن ن لْأُمَّا وَار يفهّْمن.&gt;<verse eid="ROM 10:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="ROM 10:20" />منْبَعْد يزْعم نَّبِي إِشَعْيَا ينَّا:</para>
  <para style="q1" vid="ROM 10:20">&lt;يِنِّي وَار خَافي يرزُّوْن شَا ؤُفِين-اَيِي،</para>
  <para style="q1" vid="ROM 10:20">سْمظْهَارغ-د يخف ينُو إِ يِنِّي وَار خَافِي يتْسقْسِين.&gt;<verse eid="ROM 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 10:21" />وَلَكِن خ أَيث-إِسْرَائِيل يقَّار:</para>
  <para style="q1" vid="ROM 10:21">&lt;نش يفَاسّن ينُو ضڒْقغ-ثن-د نْهَار يكْمَاڒ</para>
  <para style="q1" vid="ROM 10:21">غَار يِج ن شَّعْب يعْصَان، ذَايْسن ثَغنَّانْت.&gt;<verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="s">أَربِّـي، مَا ينْكَر أَيث-إِسْرَائِيل؟</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />إِيوَا تْسقْسِيغ نش، أَربِّـي مَا ينْكَر شَّعْب نّس؟ لَّا، عمَّارْص! نش س يِيخف ينُو ذ اَئِسْرَائِيلِي، زِي دُّوْرِّيث ن بْرَاهِيم زِي أَيث-بنْيَامِين. <verse eid="ROM 11:1" /><verse number="2" style="v" sid="ROM 11:2" />أَربِّـي وَار ينْكَر شَا شَّعْب نّس تُوْغَا يسّن-يثن زِي قْبڒ. مَا وَار ثسِّينم شَا كنِّيو مِين يقَّار لْكِتَاب خ نَّبِي إِلْيَاس؟ وَامِي يشثْشَا غَار أَربِّـي زِي أَيث-إِسْرَائِيل ينَّا-ٱس: <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />&lt;آ سِيذِي أَربِّـي! نْغِين لْأَنْبِيَا، هذْمن يمُوْشَان مَانِي ذَاش نتْقدَّام دْبِيحَاث. ڒخُّو قِّيمغ غِير نش وَاحْذِي رزُّوْن اَذَايِي نْغن.&gt; <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" />إِيوَا مِينْزِي خَاس يَارَّا أَربِّـي؟ ينَّا-ٱس: &lt;جِّيغ سبْعَا اَڒَاف ن يرْيَازن إِ يِيخف ينُو وَار رْكِيعن شَا إِ لْأَصْنَام نِّي ؤُمِي قَّارن بَعْل!&gt; <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />إِذن ؤُڒَا ذِي زْمَان-أَ إِي ذِي ندْجَا، قَا ذَا ڒبْعَاض يخْضَر-يثن أَربِّـي س اَرْضَا نّس. <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />مڒَا <char style="it">يخْضَر-يثن</char> س اَرْضَا نّس، أَتَاف ڒخُّو وَار يدْجِي شَا س لْحَسَانَاث نْسن. مڒَا مَاشِي اَمنِّي، أَتَاف اَرْضَا وَار يتِيڒِي بُو ذ اَرْضَا.<verse eid="ROM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7" />إِذن، مِيخف رزُّوْن أَيث-إِسْرَائِيل وَار ث ؤُفِين شَا، يِنِّي يتْوَاخْضَرن ؤُفِين-ث. يِنِّي يقِّيمن، ؤُڒَاون نْسن تْوَاقْسْحن. <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" />إِيوَا مَامّش يقَّار لْكِتَاب:</para>
  <para style="q1" vid="ROM 11:8">&lt;يُوْشَا-اَسن أَربِّـي ڒقْفَڒث،</para>
  <para style="q2" vid="ROM 11:8">ثِيطَّاوِين وَار تْوِيڒِينْت،</para>
  <para style="q2" vid="ROM 11:8">ئِمجَّان وَار تسْڒِين اَڒ نْهَار ن يِضَا.&gt;<verse eid="ROM 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 11:9" />ئِقَّار نَّبِي دَاود:</para>
  <para style="q1" vid="ROM 11:9">&lt;أَذ يذْوڒ ڒْعِيذ نْسن ذ ثَخْشبْث ذ لْفخّ،</para>
  <para style="q2" vid="ROM 11:9">ذ اَزْرُو إِي ذِي تْنقْڒَاظن،</para>
  <para style="q2" vid="ROM 11:9">أَخَاس شّن اَعْمُوْذ.<verse eid="ROM 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10" />أَذ ضَرْغْڒنْت ثِيطَّاوِين نْسن حمَا وَار تْوِيڒِينْت،</para>
  <para style="q1" vid="ROM 11:10">أَذ يڒِين يعُوْرَار نْسن ڒبْدَا ذ يمَاقوْسن.&gt;<verse eid="ROM 11:10" /></para>
  <para style="s">أَذ نجْمن ؤُڒَا ذ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل</para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />إِيوَا تْسقْسِيغ، أَيث-إِسْرَائِيل مَا صَافِي نْقڒْظن وضَان؟ لَّا، عمَّارْص! لْعَكْس، س ڒْمُعْصِيّث-أَ ن أَيث-إِسْرَائِيل يسنْجم أَربِّـي يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل بَاش اَذ تكَّر لْغِرَا ذِي أَيث-إِسْرَائِيل. <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />ڒخُّو ڒْمُعْصِيّث نِّي إِي ݣِّين أَيث-إِسْرَائِيل مڒَا ثُوْوِي-د لْبَرَاكَا ذ ثَمقّْرَانْت إ دُّنشْت-أَ، أُو عَاوذ وطُّو نِّي إِي ݣِّين مڒَا يُوْوِي-د لْبَرَاكَا ذ ثَمقّْرَانْت إ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل، مشْحَاڒ غَا ثرْنِي لْبَرَاكَا خْمِي د غَا ذوْڒن غَار وبْرِيذ؟<verse eid="ROM 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13" />فَا نش قَّارغ-اَوم مَانَايَا إِ كنِّيو وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل. نش ذ اَرَّسُوْل غَار يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل، نش ڒْخذْمث ينُو حسّْبغ-ت غَارس يجّن ن شّان يمْغَر. <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />رزُّوْغ اَذ سْنكَّرغ لْغِرَا ذݣ أَيثْمَا يسْرَائِيلِيْين حمَا اَذ سْنجْمغ ڒبْعَاض زَّايسن. <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />أَقَا وَامِي خَاسن يُوْزّڒ أَربِّـي، ئِسمْصْڒَاح نتَّا دُّنشْت-أَ اَكِذس. عَاوذ خْمِي ثن غَا يقْبڒ، أَذ تِيڒِي اَم ثُوْذَارْث إِ يِنِّي يمُّوْثن! <verse eid="ROM 11:15" /><verse number="16" style="v" sid="ROM 11:16" />مڒَا ثْقرّْصذ شْوَايْت زݣ ورشْثِي<note caller="+" style="f"><char style="fr" closed="false">11‏.16 </char><char style="ft" closed="false">أَرشْثِي يعْنِي نتَّا ذ اَرِيْثِي.</char></note> يصْفَان ثْقدّْمذ-ث إِ أَربِّـي، أَتَاف اَذ يِيڒِي اَمنِّي يصْفَا ؤُرشْثِي نِّي اَمن-يكْمَاڒ. أُو مڒَا اَذ يڒِين يࢲوْرَان ن ثْشجَّارث صْفَان، أَتَاف اَذ يڒِين ؤُڒَا ذ ڒفْرُوْع، <char style="it">يعْنِي ثِسضْوِين</char>.<verse eid="ROM 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 11:17" />شُوْف، ڒبْعَاض ن ڒفْرُوْع <char style="it">يعْنِي ثِسضْوِين</char> تْوَاقسّنْت زِي ثْزِيتُونْت، سّنِّي شك ثتْوَاڒقّْمذ ذݣ ومْشَان نْسنْت جَار ثِنِّي يقِّيمن وَاخَّا شك ذ اَزمُّوْر، ثْشَرّْشذ ذݣ يࢲوْرَان ن ثْزِيتُونْت ثدَّرذ زَّايْسن.<note caller="+" style="f"><char style="fr" closed="false">11‏.17 </char><char style="ft" closed="false">لْأَيَا-يَا ڒْمَعْنَا نّس ڒبْعَاض ن ثْسضْوِين ن ثْزِيتُوْنْت تْوَاقسّنْت، سّنِّي ذݣ ومْشَان نْسنْت تْوَاڒقّْمنْت ڒبْعَاض ن ثْسضْوِين ن وزمُّوْر. مَاشِي ثْقسّ ثْزِيتُوْنْت قاع؛ لَّا، قسّنْت ڒبْعَاض ن ثْسضْوِين نّس وَاهَا.</char></note> <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />وَلَكِن وَار تْسمْغَار شَا يخف نّش خ ڒفْرُوْع نِّي يتْوَاقسّن. مَايمِّي؟ وَار تتُّو شَا بلِّي ذ يࢲوْرَان نِّي إِي شك ييْسِين، وَار يدْجِي بُو ذ شك إِي ثن ييْسِين.<verse eid="ROM 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 11:19" />إِذن، يمْكن شك اَذ تِينِيذ قَا ثِسضْوِين تْوَاقسّنْت بَاش نش اَذ تْوَاڒقّْمغ ذݣ ومْشَان نْسنْت. <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />وَاه، نِثنْتِي تْوَاقسّنْت سّنِّي وَامِي وَار ؤُمِيننْت شَا؛ شك ثقِّيمذ ذِنِّي وَامِي ثُوْمْنذ. وَلَكِن وَار تْسمْغَار شَا يخف نّش؛ لَّا، ݣّْوذ! <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />إِيوَا، مڒَا أَربِّـي تُوْغَا وَار يحِينّ شَا ذِي ڒفْرُوْع ن لْأَصل، ؤُڒَا ذ شك وَار ذَايك يتْحِينِّي شَا.<verse eid="ROM 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 11:22" />إِذن خْزَر مشْحَاڒ يصْبح أَربِّـي مشْحَاڒ إِي يقْسح. ئِقْسح خ يِنِّي يوْضَان؛ ئِصْبح اَكِذش شك يعْنِي مڒَا ثقِّيمذ ذِي ڒْخِير نّس. مڒَا لَّا اَتَاف اَذ تْوَاقسّذ ؤُڒَا ذ شك. <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />أُو مڒَا وَار قِّيمن شَا يسْرَائِيلِيْين خ لْكُفر نْسن، ؤُڒَا ذ نِثْنِي اَثن يڒقّم أَربِّـي لِأَنَّا غَارس جّْهذ نتَّا إِي زِي ثن غَا يڒقّم عَاوذ. <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />شُوْف، شك تْوَاقسّذ زݣ وزمُّوْر يعْنِي طَّبِيعَا نّش، سّنِّي تْوَاڒقّْمذ ذِي ثْزِيتُوْنْت يعْنِي مَاشِي طَّبِيعَا نّش. أُو نِثنْتِي، مشْحَاڒ يهْون اَذ تْوَاڒقّْمنْت يعْنِي ثِسضْوِين ن ثْزِيتُوْنْت اَذ تْوَاعقْبنْت غَار لْأَصل نْسنْت.<verse eid="ROM 11:24" /></para>
  <para style="s">أَرَّحْمث ن أَربِّـي خ مَارَّا دُّنشْت</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />آي اَيثْمَا، حمَا وَار ذَاوم يتِيڒِي شَا تَّكبُّر رزُّوْغ اَذ تْفهْمم ثَمسْڒَايْث-أَ ثَانِيتَا ينُوْفَّرن، يعْنِي أَيث-إِسْرَائِيل ذَايْسن يجّن ن ثْغنَّانْت وَار تْغِيمِي شَا إِ ڒبْدَا. أَذ تقِّيم اَڒ غَا يكمّڒ لْعَدَد نِّي ن ڒْمُوْمِنِين <char style="it">إِي غَا ينجْمن</char> زݣ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل. <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" />أَمنِّي إِي غَا نجْمن مَارَّا أَيث-إِسْرَائِيل مَامّش يقَّار لْكِتَاب:</para>
  <para style="q1" vid="ROM 11:26">&lt;زِي لْقُدْس إِي د غَا يَاس ونِّي إِي ثن غَا يسْنجْمن،</para>
  <para style="q2" vid="ROM 11:26">أَذ يسْبعّذ شَّرّْ خ ثَارْوَا ن يَعْقُوْب.<verse eid="ROM 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27" />أَذ يِيڒِي ذ وَا ذ ڒْعَهذ ينُو اَكِذْسن</para>
  <para style="q2" vid="ROM 11:27">خْمِي خَاسن غَا مْحِيغ ڒْمُعْصِيَاث نْسن.&gt;<verse eid="ROM 11:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="ROM 11:28" />س سَّبَاب ن لْإِنْجِيل، ئِسْرَائِيلِيْين ذ ڒَعْذُو عْلَاحْسَاب كنِّيو. وَلَكِن س سَّبَاب مِينْزِي تْوَاخْضَرن، نِثْنِي ذ يمْعِيزّن عْلَاحْسَاب سَّلَاف صَّلِيحِين. <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />لِأَنَّا أَربِّـي وَار يندّم شَا خ مِين يتِيشّ نِغ خ مِين يتِيخْضَر. <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />شُوْف، ذِي ڒْوقْث نِّي يعْذُوْن تُوْغَا كنِّيو ثْعصَّام أَربِّـي، يرْحم-يكنِّيو ڒخُّو س سَّبَاب ن ڒْمُعْصِيّث نِّي ن أَيث-إِسْرَائِيل. <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />أَمنِّي ؤُڒَا ذ نِثْنِي وَامِي عْصَان أَربِّـي ڒخُّو، أَثن يرْحم مَامّش إِي كنِّيو يرْحم. <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />لِأَنَّا نتَّا أَربِّـي يَارَّا يوْذَان مَارَّا ذ يمحْبَاس ن ڒْمُعْصِيّث حمَا اَثن يرْحم مَارَّا إِذْسن.<verse eid="ROM 11:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="ROM 11:33" />مشْحَاڒ يمْغَر وَاݣْڒَا ن ڒفْهَامث ذ ثُوْسْنَا<note caller="+" style="f"><char style="fr" closed="false">11‏.33 </char><char style="ft" closed="false">ثُوْسْنَا نتَّاث ذ لْمَعْرِفَا.</char></note> ن أَربِّـي!</para>
  <para style="q2" vid="ROM 11:33">وَار تْوَاشرّْحن لْأَحْكَام نّس،</para>
  <para style="q2" vid="ROM 11:33">وَار تْوَافهّْمن يبْرِيذن نّس.<verse eid="ROM 11:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="ROM 11:34" />وِيݣ يسّْنن ڒَعْقڒ ن سِيذِي أَربِّـي،</para>
  <para style="q2" vid="ROM 11:34">نِغ وِي كِس يمْشَوَارن؟<verse eid="ROM 11:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35" />وِي ذَاس يُوْشِين شَان ڒْحَاجث ذ اَمزْوَارُو،</para>
  <para style="q2" vid="ROM 11:35">بَاش نتَّا اَذَاس-ت-يذ يَارّ؟<verse eid="ROM 11:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="ROM 11:36" />أَقَا مَارَّا يُوْسَا-د يكَّا-د زَّايس، كُلْشِي نّس.</para>
  <para style="q1" vid="ROM 11:36">أَغَارس ثِيڒِي لْعَظَمَا إِ نتَّا إِ ڒبْدَا. آمِين.<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="s">ثُوْذَارْث ن جْذِيذ خ وفُوْس ن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />إِذن فَا آي اَيثْمَا، س اَرَّاحْمث ن أَربِّـي تْشجَّاعغ-كنِّيو اَذ تْقدّْمم يخف نْوم إِ أَربِّـي اَمشْنَاو يجّن ن دْبِيحث ثدَّر، ذ ثَمْقدّسْت، أَخَاس يَارْضَا نتَّا. مَانَايَا ذ لْوَاجِب ن لْعِبَادَا خَاوم. <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />وَار تݣّم شَا مِين تݣّن يِوْذَان ذِي ڒْوقْث-أَ ثَانِيتَا. ئِتْخصَّا اَغَارْوم يِيڒِي يجّن ن ڒَعْقڒ ذ جْذِيذ حمَا اَذ تْوَابدّْڒم، سّنِّي اَذ تسّْنم كنِّيو مِين يخس أَربِّـي، يعْنِي مِين يصبْحَان ذ مِين ذَاس يتعْجِيبن وَار ذَايس بُو وخطِّي.<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />فَا س لْبَرَكَا إِي ذَايِي يُوْشَا أَربِّـي قَّارغ إِ مْكُڒ يجّن زَّايْوم: وَار حسّب شَا يخف نّش كْتَار زِي مِين ثعْنِيذ. شك فكَّر س ڒَعْقڒ نّش عْلَاحْسَاب مشْحَاڒ ن لإِيمَان إِي ذَاش يُوْشَا أَربِّـي. <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" />لِأَنَّا دَّات ذَايس اَطَّاس ن طْرُوْفَاث، مْكُڒ طَّارْف يخدّم ڒْخذْمث نّس. <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />أَمنِّي إِي ندْجَا ؤُڒَا ذ نشِّين. وَاخَّا نشِّين اَطَّاس إِي إِذْنغ أَقَانغ مَارَّا إِذْنغ ذ يجّن ن دَّات ذِي لْمَسِيح، كُڒ طَّارْف يتحْذَاجَا ونّغْنِي. <verse eid="ROM 12:5" /><verse number="6" style="v" sid="ROM 12:6" />عْلَاحْسَاب لْبَرَكَا إِي ذَانغ يمُّوْشن غَارْنغ نشِّين لْقُدْرَاث، كُڒ لْقُدْرَا وَار تْشِيبِّيه شَا ذِي ثنّغْنِي. ئِجّن مڒَا يُوْشَا-اَس أَربِّـي لْوَاحِي، أُو لَابُد اَذ يسخْذم لْقُدْرَا-يَا عْلَاحْسَاب لإِيمَان نّس. <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />ئِجّن مڒَا يتْسخَّار، أُو لَابُد اَذ يسخَّار. ئِجّن مڒَا يسڒْمَاذ، أُو لَابُد اَذ يسڒْمذ. <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />ئِجّن مڒَا يتْشجَّاع، أُو لَابُد اَذ يشجّع. ئِجّن مڒَا يتْصدَّاق، أُو لَابُد اَذ يِيڒِي ذ اَسخَّاي. ئِجّن مڒَا يتْرَايَا، أُو لَابُد اَذ يرَاي س وُوْڒ نّس. ئِجّن مڒَا يرحّم، أُو لَابُد اَذ يرْحم س ڒفْرَاحث نّس.<verse eid="ROM 12:8" /></para>
  <para style="s">مَامّش يتخصَّا اَذ يعِيش ڒْمُوْمن</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />ڒمْحِبّث يتْخصَّا اَذ تِيڒِي بْڒَا نِّفَاق. عِيفّث مِين يدْجَان ذ شَّرّْ، طّْفث ذِي مِين يدْجَان ذ ڒْخِير. <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />خْسث اَيَاوْيَا اَم ثَاوْمَات. وقَّارث اَيَاوْيَا كْتَار زِي جّْهذ. <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />حَوْڒث وَار تعْݣِيزم شَا. خذْمث إِ سِيذِي أَربِّـي س وُوْڒ ذ اَرُّوْح. <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />فَرْحث ذِي لْأَمَال. صْبَارث خ تَمَارَا. دَاوّْمث خ ثْࢲَادْجِيث. <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />عَاوْنث ڒْمُوْمِنِين صَّالِحِين يِنِّي يتحْذَاجن. رحّْبث خ يِنِّي يتْسَفَارن.<verse eid="ROM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14" />بَرْكث إِ يِنِّي كنِّيو يتْعدَّابن، بَرْكث وَار ثن نعّْڒم شَا. <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />فَرْحث اَك يِنِّي يفَرّْحن، تْرُوْث اَك يِنِّي يتْرُوْن. <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" />عِيشث اَݣ وَايَاوْيَا ذِي ڒهْنَا. وَار سمْغَارث شَا يخف نْوم، مْعَشَارث اَݣ يپُـوْبْرِيثن. وَار تَارَّاث شَا يخف نْوم ذ يمِيغِيسن.<verse eid="ROM 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17" />وَار تَارَّام شَا شَّرّْ س شَّرّْ. أَرّم-د ڒْبَڒ نْوم بَاش اَذ تحْتَرْمم مَارَّا يوْذَان ذِي مِين تݣّم. <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />عْلَاحْسَاب كنِّيو، مڒَا مُمْكن ݣّث اَذ تِيڒِيم ذِي ڒهْنَا اَك يِوْذَان مَارَّا. <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />آي يمْعِيزّن ينُو، وَار تنْتَاقَامم زِي حَدّ، لْعِقَاب جّم-ث إ أَربِّـي. أَقَا لْكِتَاب يقَّار: &lt;ذ نش إِݣ يتنْتَاقَامن، ذ نش إِݣ يتْخدْجَاسن، ئِقَّار-يت سِيذِي أَربِّـي.&gt; <verse eid="ROM 12:19" /><verse number="20" style="v" sid="ROM 12:20" />لْعَكْس: ڒَعْذُو نّش مڒَا يدْجُوْز، ؤُش-اَس اَذ يشّ. مڒَا يفُّوْذ، ؤُش-اَس اَذ يسو. أُو مَايمِّي؟ مڒَا ثݣِّيذ-اَس اَمُّو، أَخْمِي ثْسرْغذ-اَس ڒفْحَم خ وزدْجِيف نّس. <verse eid="ROM 12:20" /><verse number="21" style="v" sid="ROM 12:21" />وَار تجَّا شَا شَّرّْ اَش يغْڒب، ذ شك إِي غَا يغڒْبن شَّرّْ س ڒْخِير.<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="s">لْوَاجِب نّغ عْلَاحْسَاب ڒْمخْزن</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />لَابُد اَذ يطَاع كُڒ يجّن إِ صْحَاب ن ڒْمخْزن لِأَنَّا وَار يدْجِي بُو ڒْمخْزن إِلَّا ونِّي د يكِّين زِي أَربِّـي. أُو يِنِّي يحكّْمن ذ أَربِّـي إِي ثن يݣِّين. <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />خ مَانَايَا وِي يتْعَارَّاضن إِ ڒْمخْزن، ئِتْعَارَّاض إِ مِين يݣَّا أَربِّـي. أُو يِنِّي ذَاسن يتْعَارَّاضن اَذ تْوَاعَاقْبن. <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />لِأَنَّا لْحُكَّام وَار سِّݣّْوِيذن شَا ونِّي يتݣّن ڒْخِير، سَّݣّْوَاذن ونِّي يتݣّن شَّرّْ. مڒَا ثخْسذ وَار تݣّْوْذذ شَا زِي ڒْمخْزن، تݣّ ڒْخِير اَخَاك يَرْضَا. <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />أَقَا نتَّا ذ اَخدَّام ن أَربِّـي اَش ينْفع. وَلَكِن مڒَا تݣّذ شَّرّْ ݣّْوذ زَّايس، وَار ييْسِي شَا سِّيف بْڒَا سَّبَاب. نتَّا ذ اَخدَّام ن أَربِّـي يتخدْجَاس يتْعَاقَاب ونِّي يتݣّن شَّرّْ. <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />فَلِهَذَا لَابُد اَذَاس ثْطَاعذ إِ ڒْمخْزن مَاشِي عْلَاحْسَاب لعِقَاب وَاهَا، وَلَكِن عَاوذ عْلَاحْسَاب ضَّمِير نّش إِي ذَاش يتتّن. <verse eid="ROM 13:5" /><verse number="6" style="v" sid="ROM 13:6" />عَاوذ ذ وَانِيتَا ذ سَّبَاب إِي خف تْخدْجَاسم ضَّرِيبَا لِأَنَّا يِنِّي يحكّْمن نِثْنِي ذ يخدَّامن ن أَربِّـي، خدّْمن ذِي مَانَايَا. <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />مْكُڒ يجّن ؤُشم-اَس ڒْحَقّ نّس: ضَّرِيبَا إِ بَاب ن ضَّرِيبَا، ڒَعْشُوْر إِ بَاب ن ڒَعْشُوْر، لإِحْتِرَام إِ بَاب ن لإِحْتِرَام، ڒوْقَار إِ بَاب ن ڒوْقَار.<verse eid="ROM 13:7" /></para>
  <para style="s">لْوَاجِب نّغ عْلَاحْسَاب ڒُوْصِيَاث</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />ئِتْخصَّا وَار يتِيڒِي شَا ومَارْوَاس جَارَاوم؛ لَّا، ئِتْخصَّا اَذ يِيڒِي إِلَّا ومَارْوَاس ن ڒمْحِبّث. أَقَا ونِّي يتخْسن ونّضْنِي يتْوَاحْسَاب يكمّڒ مِين يُوْرِين ذِي شَّرِيعَا. <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />لِأَنَّا ڒُوْصِيَاث نِّي إِي يقَّارن وَار زنَّا، وَار نقّ، وَار تَاشَار، وَار عشّق، ذ ڒُوْصِيَاث نّغْنِي، مَارَّا مُوْننْت ذݣ يِجّن ن ڒُوْصِيّث يقَّارن: &lt;أَذ ثخْسذ اَجَّار نّش اَمشْنَاو يخف نّش.&gt; <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />ڒمْحِبّث-أَ وَار تْضَارِّي شَا اَجَّار نّس. فَلِهَذَا، ڒمْحِبّث تْكمَّاڒ شَّرِيعَا اَمن-ثكْمَاڒ.<verse eid="ROM 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />مَايمِّي مَانَايَا؟ كنِّيو ثسّْنم مَان ڒْوقْث إِي ذِي ندْجَا نشِّين. ثُوْوض-د ثْسَعَّات حمَا اَذ تْفَاقم زݣ يِيضص. لِأَنَّا ثْسَعَّات-أَ إِي ذِي غَا ننْجم ڒخُّو اَقَا ثْقَارّب-د كْتَار زِي ثنِّي إِي ذِي نُوْمن ذ اَمزْوَارُو. <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />دْجِيڒث اَقَا ثعْذُو، نْهَار اَقَا يُوْوض-د. خ مَانَايَا لَابُد أَ نكّس ڒحْوَايج ن ثَادْجسْت، أَ نݣّ اَرُّوْض ن نُّور ن ڒحْذِيذ. <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />ئِتخصَّا لَابُد أَ نُوْيُوْر س لْإِحْتِرَام اَم ونِّي يݣُّوْرن ذِي ثْفَاوْث ن نْهَار. وَار نْتݣّ شَا لْمَدلَّا ن سّكْرَا ذ وَاطَّاس ن شّْرب ذ لْفَسَاد ذ ڒقْبَاحْث ذ ومنْغِي ذ ڒحْسذ. <verse eid="ROM 13:13" /><verse number="14" style="v" sid="ROM 13:14" />وَلَكِن، ݣّث ڒحْوَايج ن سِيذِيثْنغ عِيْسَى لْمَسِيح. وَار رهَّام شَا اَك طَّبِيعَا ثَعفَّانْت نْوم، وَار تْسعَّافث شَا شّهَاوَاث نّس.<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="s">وَار تْعيَّاب شَا خ وُوْمَاش</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />فَا ونِّي ؤُمِي يضْعف لإِيمَان نّس قبْڒم-ث جَارَاوم بْڒَا مَا اَكِذس ثْمنْغم خ لْأَفْكَار نّس. <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />ئِجّن يتْوَاڒَا لْمَكْلَا مَارَّا حَلَال. ئِجّن نّغْنِي ونِّي غَار يدْجَا لإِيمَان نّس يضْعف يتتّ غِير زِي ڒْخُضَارْث. <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />ونِّي يتْوَاڒَان مَارَّا لْمَكْلَا حَلَال يتْخصَّا-يَاس وَار يسحْقِير شَا ونِّي وَار يتتّن شَا. عَاوذ ونِّي وَار يتتّن شَا يتْخصَّا-يَاس وَار يتْعيِّيب شَا خ ونِّي يتْوَاڒَان لْمَكْلَا مَارَّا حَلَال لِأَنَّا أَربِّـي يقْبڒ-يث. <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />شك مِين ثعْنِيذ بَاش اَذ تْعيّْبذ اَخدَّام ن مِيدّن؟ ئِنْجح نِغ وَار ينْجِيح، وَانِيتَا ذ شّْغڒ ن سِيذس. أُو ذ صَّح نتَّا اَذ ينْجح لِأَنَّا سِيذِي أَربِّـي يزمَّر اَث يسنْجح.<verse eid="ROM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5" />شُوْف، ئِجّن يتْوَاڒَا يجّن ن نْهَار مُبَارَك زِي نْهُوْرَاث نّغْنِي. ئِجّن يتْوَاڒَا-ثن قَاع كِيف-كِيف. كُڒ يجّن يتْخصَّا-ٱس لَابُد اَذ يِيڒِي مقْتَنَاع مْلِيح س اَرَّاي نّس. <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />ونِّي يتْوَاڒَان يجّن ن نْهَار مُبَارَك زݣ ونّغْنِي اَذ يݣّ مَانَايَا بَاش اَذ يوقَّر سِيذِي أَربِّـي. ونِّي يتتّن زِي مَارَّا لْمَكْلَا قَا يتتّ بَاش اَذ يوقَّر سِيذِي أَربِّـي لِأَنَّا اَذ يشكَّر أَربِّـي. ونِّي وَار يتتّن شَا زِي مَارَّا لْمَكْلَا قَا يتݣّ مَانَايَا حمَا اَذ يوقَّر سِيذِي أَربِّـي، ؤُڒَا ذ نتَّا اَذ يشكَّر أَربِّـي.<verse eid="ROM 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 14:7" />شُوْف، وَار ذَايْنغ حَدّ يدَّر إِ يِيخف نّس، وَار ذَايْنغ حَدّ يتْمتَّا إِ يِيخف نّس. <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />نشِّين مڒَا ندَّر، أَ ندَّر إِ سِيذِي أَربِّـي. مڒَا نمُّوْث، أَ نمّث إِ سِيذِي أَربِّـي. فَلِهَذَا، مڒَا ندَّر نِغ نمُّوْث نشِّين ن سِيذِي أَربِّـي. <verse eid="ROM 14:8" /><verse number="9" style="v" sid="ROM 14:9" />لِأَنَّا خ مَانَايَا إِي خف يمُّوْث لْمَسِيح أُوْشَا ثعْقب-د ذَايس ثُوْذَارْث حمَا اَذ يِيڒِي نتَّا ذ سِيذِيثْسن ن يِنِّي يمُّوْثن ذ يِنِّي يدَّرن. <verse eid="ROM 14:9" /><verse number="10" style="v" sid="ROM 14:10" />إِيوَا شك مَايمِّي تْعيَّابذ ؤُمَاش؟ شك مَايمِّي ثْسحْقَرذ ؤُمَاش؟ نشِّين مَارَّا أَ نْبدّ زَّاث إِ لْعَرْش ن أَربِّـي مَانِي إِي غَا نتْوَاحْكم. <verse eid="ROM 14:10" /><verse number="11" style="v" sid="ROM 14:11" />أَقَا يُوْرَا ذِي لْكِتَاب:</para>
  <para style="q1" vid="ROM 14:11">&lt;نش تْجَادْجِيغ س ثُوْذَارْث ينُو، ئِقَّار-يت سِيذِي أَربِّـي،</para>
  <para style="q1" vid="ROM 14:11">أَقَا مَارَّا يوْذَان اَذَايِي سجّْذن خ يفَادّن نْسن،</para>
  <para style="q1" vid="ROM 14:11">مْكُڒ يڒس اَذ يشْهذ نش ذ سِيذِي أَربِّـي.&gt;<verse eid="ROM 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 14:12" />فَلِهَذَا، مْكُڒ يجّن زَّايْنغ اَذ يتْوَاحَاسب زَّاث إِ أَربِّـي.<verse eid="ROM 14:12" /></para>
  <para style="s">وَار غطّڒ شَا ؤُمَاش</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />إِذن زِي سَّا اَڒ ثْسَاونْت يتْخصَّا-يَانغ أُو لَابُد وَار نتْعيِّيب شَا خ وَايَاوْيَا؛ لَّا، ئِتْخصَّا-كنِّيو اَذ تْفكَّرم مْلِيح حمَا وَار ثْغطّْڒم شَا يجّن وُوْمَاثْوم نِغ اَث تسْفشْڒم. <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />نش سّْنغ أُو مْتيّْقن ذِي سِيذِيثْنغ عِيْسَى اَقَا مِين نتّت وَار ذَايس بُو شَان ڒْحَاجث حْرَام. وَلَكِن يتِيڒِي حْرَام خ ونِّي إِي ت يتْوَاڒَان حْرَام. <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />لِأَنَّا مڒَا يتْخيَّاق وُوْمَاش س مَشَّا نِّي إِي تتّذ، أَتَاف شك وَار ثُوْݣُّوْرذ شَا نِيشَان س ڒمْحِبّث. وَار تݣّ شَا مَشَّا نّش ذ سَّبَاب إِي زِي غَا ينهْذم وُوْمَاش ونِّي مِيخ يمُّوْث لْمَسِيح. <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />أَمنِّي وَار تجَّام شَا يِوْذَان اَذ سِّيوْڒن شَّرّْ خ مِين تْوَاڒِيم ذ اَصبْحَان. <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />لِأَنَّا ڒْمُلْك ن أَربِّـي نتَّا وَار يدْجِي شَا س مَشَّا نِغ ذ ثِيسسِّي؛ نتَّا س ؤُمْصْڒَاح اَك أَربِّـي ذ ڒهْنَا ذ ڒفْرَاحث س اَرُّوْح يقدّْسن. <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />ونِّي إِي غَا يخذْمن إِ لْمَسِيح اَمنِّي، أَقَا أَربِّـي يرطَّا خَاس يوْذَان تْشكَّرن-ث.<verse eid="ROM 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19" />إِذن فَا يتْخصَّا-يَانغ أُو لَابُد أَ نݣّ لْمجْهُوْد نّغ بَاش أَ نݣّ مِين يتَاوِين غَار ڒهْنَا ذ مِينْزِي غَا نْشجّع اَيَاوْيَا. <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />وَار هدّم شَا ڒْخذْمث ن أَربِّـي عْلَاحْسَاب لْمَكْلَا. ذ صَّح مَارَّا مِين يدْجَان نتَّا حَلَال، وَلَكِن ذ ڒْعِيب مڒَا ثْغظْڒذ شَان يِجّن س سَّبَاب ن مِين تتّذ. <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />ذ يجّن ن ڒْخِير مڒَا وَار تتّذ شَا اَيْسُوْم، نِغ وَار ثْسسّذ شَا اَمَان وضِيڒ، نِغ ذ شَان ڒْحَاجث نّغْنِي إِي غَا يغظْڒن ؤُمَاش. <verse eid="ROM 14:21" /><verse number="22" style="v" sid="ROM 14:22" />مِين مَا ثُوْمْنذ خ ثْمسْڒَايِين-أَ، اجّ-يثنْت جَارَاش-د ذ أَربِّـي. سَّعْذ ن ونِّي وَار د يتِيوِين لْحِسَاب ذ لْعِقَاب إِ يِيخف نّس خ مِين يتْوَاڒَا حَلَال. <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />وَلَكِن مڒَا يجّن يتتّ يتْشكَّا ذِي لْمَكْلَا نّس، أَخَاس يتْوَاحَاكم اَخَاس يتْوَاعَاقب لِأَنَّا وَار يتتّ شَا س لْإِيمَان نّس إِي ذَايس. أُو مَارَّا مِين وَار يتِيڒِين س لإِيمَان نِّي نتَّا ذ يجّن ن ڒْمُعْصِيّث.<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="s">ذْفَار مِين يتݣّ سِيذِيثْنغ عِيْسَى لْمَسِيح</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />فَا نشِّين إِݣ يجهْذن يتْخصَّا-يَانغ أَ نَارْبُو ضُّعف ن يِنِّي وَار يجْهِيذن شَا، مَاشِي أَ نݣّ مِين ذَانغ يتعْجِيبن إِ يِيخف نّغ أُو صَافِي. <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />مْكُڒ يجّن زَّايْنغ يتْخصَّا-يَاس اَخَاس يَارْضَا وَاجَّار نّس اَكِذس يݣّ ڒْخِير حمَا اَذ يجْهذ. <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />لِأَنَّا لْمَسِيح وَار يݣِّي شَا مِين ذَاس يتعْجِيبن إِ يِيخف نّس، يݣَّا مَامّش يقّار لْكِتَاب: &lt;ڒْبَاطڒ إِي خَاش نَّان يفْضح-اَيِي.&gt; <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />شُوْف، مَارَّا مِين يُوْرِين ذِي لْكُتُب ذِي زْمَان ؤُرِين-ث بَاش اَزَّايس نڒْمذ نشِّين. أَوَاڒ ن أَربِّـي يتْشجَّاع-اَنغ، ئِتَاوِي-يَانغ-د صّْبَر حمَا اَغَارْنغ يِيڒِي لْأَمَال. <verse eid="ROM 15:4" /><verse number="5" style="v" sid="ROM 15:5" />أَربِّـي يعْنِي ونِّي يتِيشّن صّْبَر يتْشجَّاع-يكنِّيو، أَتَاف اَكنِّيو يسْمُوْن حمَا اَذ تِيڒِيم ذ يجّن خْمِي ثْذفَّارم عِيْسَى لْمَسِيح، <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />بَاش اَذ تْحمْذم أَربِّـي بَابَاس ن سِيذِيثْنغ عِيْسَى لْمَسِيح س يِجّن ن اَرَّاي ذ يِجّن ن وقمُّوْم. <verse eid="ROM 15:6" /><verse number="7" style="v" sid="ROM 15:7" />س مَانَايَا قبْڒث اَيَاوْيَا مَامّش إِي كنِّيو يقْبڒ لْمَسِيح حمَا اَذ تْسمْغَارم أَربِّـي.<verse eid="ROM 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 15:8" />شُوْف، نش قَّارغ-اَوم لْمَسِيح يُوْسَا-د حمَا اَذ يِيڒِي ذ اَخدَّام ن أَيث-إِسْرَائِيل، بَاش اَذ د يسْمظْهَار لْحَقِيقَا ن أَربِّـي اَذ يݣّ مِين يوْعذ سَّلَف صَّالِحِين. <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />عَاوذ بَاش يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل اَذ حمْذن أَربِّـي خ اَرَّحْمث نّس. مَامّش يقَّار لْكِتَاب:</para>
  <para style="q1" vid="ROM 15:9">&lt;س مَانَايَا إِي شك غَا حمْذغ جَار ڒݣْـنُوْس،</para>
  <para style="q1" vid="ROM 15:9">أَذ غنّْجغ يزْڒَان إِ يِيسم نّش.&gt;<verse eid="ROM 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 15:10" />ئِقَّار لْكِتَاب عَاوذ:</para>
  <para style="q1" vid="ROM 15:10">&lt;فَرْحث يَا ڒݣْـنُوْس اَك شَّعْب نّس!&gt;<verse eid="ROM 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 15:11" />ئِقَّار عَاوذ:</para>
  <para style="q1" vid="ROM 15:11">&lt;حمْذث سِيذِي أَربِّـي، يَا ڒݣْـنُوْس مَارَّا إِذْوم!</para>
  <para style="q1" vid="ROM 15:11">حمْذم-ث، مَارَّا إِذْوم يَا شُّعُوْب!&gt;<verse eid="ROM 15:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="ROM 15:12" />ئِقَّار عَاوذ نَّبِي إِشَعْيَا:</para>
  <para style="q1" vid="ROM 15:12">&lt;أَذ يغْمِي وࢲْور ن يَسَّى،<note caller="+" style="f"><char style="fr" closed="false">15‏.12 </char><char style="ft" closed="false">يَسَّى نتَّا ذ بَابَاس ن سِيذْنَا دَاود.</char></note></para>
  <para style="q2" vid="ROM 15:12">نتَّا إِي غَا يكَّرن اَذ يحْكم خ ڒݣْـنُوْس،</para>
  <para style="q2" vid="ROM 15:12">ذَايس إِي غَا ݣّن ڒݣْـنُوْس لْأَمَال.&gt;<verse eid="ROM 15:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13" />أربِّي ونِّي يتِيشّن لْأَمَال، أَكنِّيو يشُّوْر س ڒفْرَاحت ذ ڒهْنَا وَامِي زَّايس ثُوْمْنم بَاش اَذ تنْفيّْضم س لْأَمَال س جّْهذ ن اَرُّوْح يقدّْسن.<verse eid="ROM 15:13" /></para>
  <para style="s">بُوْلُس نتَّا ذ اَرَّسُوْل غَار يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />آي اَيثْمَا، نش مْتيّْقن بلِّي كنِّيو ثشُّوْرم س ڒْخِير ذ مَارَّا ثُوْسْنَا،<note caller="+" style="f"><char style="fr" closed="false">15‏.14 </char><char style="ft" closed="false">ثُوْسْنَا نتَّاث ذ لْمَعْرِفَا.</char></note> ثْزمَّرم اَذ تسْڒمْذم اَيَاوْيَا. <verse eid="ROM 15:14" /><verse number="15‏-16" style="v" sid="ROM 15:15-16" />وَلَكِن زعْمغ ؤُرِيغ <char style="it">ثَبْرَات-أَ</char> غَارْوم خ ڒبْعَاض ن ثْمسْڒَايِين حمَا وَار ثنْت تتُّوْم شَا. لِأَنَّا نش تݣّغ ڒْخذْمث ن ڒفْقِي تْبشَّارغ س وَاوَاڒ ن أَربِّـي س لْبَرَاكَا نِّي إِي ذَايِي يوْشَا بَاش اَذ يڒِيغ ذ اَخدَّام ن عِيْسَى لْمَسِيح إِ كنِّيو وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل. حمَا اَكنِّيو قدّْمغ اَم يِجّن ن صّذْقث ثصْفَا س اَرُّوْح يقدّْسن حمَا اَت يقْبڒ أَربِّـي. <verse eid="ROM 15:15-16" /><verse number="17" style="v" sid="ROM 15:17" />فَلِهَذَا س عِيْسَى لْمَسِيح اَذ فْتَخَارغ س ڒْخذْمث ينُو إِ أَربِّـي.<verse eid="ROM 15:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 15:18" />شُوْف، زعْمغ اَذ سِّيوْڒغ غِير خ مِين يخدّم لْمَسِيح خ وفُوْس ينُو حمَا يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل اَذ طَاعن إِ أَربِّـي س وَاوَاڒ ذ ڒخْذَايم ينُو، <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />يعْنِي س جّْهذ ن لْمُعْجِزَاث ذ لْبُرْهَانَاث إِي د يُوْسِين س جّْهذ ن اَرُّوْح ن أَربِّـي. أَمُّو إِي بشَّرغ س لْإِنْجِيل ن لْمَسِيح ذِي مْكُڒ اَمْشَان يعْنِي زِي ثنْدِينْت ن لْقُدْس اَڒ جْوَايه ن إِلِيرْيَا. <verse eid="ROM 15:19" /><verse number="20" style="v" sid="ROM 15:20" />أُو نش رزُّوْغ اَذ تْبشَّارغ ڒبْدَا س لْإِنْجِيل ذِي ثْمُوْرَا مَانِي وَار خَاس تسْڒِين شَا خ لْمَسِيح بَاش وَار بنِّيغ شَا خ شَا ن دْسَاس إِݣ يݣَّا حَدّ نّغْنِي. <verse eid="ROM 15:20" /><verse number="21" style="v" sid="ROM 15:21" />مَامّش يقَّار لْكِتَاب:</para>
  <para style="q1" vid="ROM 15:21">&lt;يِنِّي وَار خَاس يتْوَاخبَّرن اَذ تْوَاڒَان،</para>
  <para style="q1" vid="ROM 15:21">يِنِّي وَار خَاس يتْسْڒِين اَذ فهْمن.&gt;<verse eid="ROM 15:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22" />ذ وَا ذ سَّبَاب إِي ذَايي يطّْفن اَطَّاس ن ثْوَاڒَاثِين وَار غَارْوم د ؤُسِيغ شَا.<verse eid="ROM 15:22" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس يرزُّو اَذ يرَاح غَار ثنْدِينْت ن رُوْمَا</para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 15:23" />وَلَكِن ڒخُّو وَار غَارِي بُو ومْشَان اَذ خذْمغ ذِي جْوَايه-أَ، أُو نش مشْحَاڒ زݣ وَامِي إِي رزُّوْغ اَذ د اَسغ اَكنِّيو ࢲرغ. <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />خْمِي غَا رَاحغ غَار سْپَـانْيَا تْمنِّيغ اَخَاوم د كّغ، أَكِذْوم قِّيمغ اَكِذْوم فَرْحغ شْوَايْت ن ڒْوقْث. نش تْمنِّيغ زَّايْوم اَذَايِي ثْعَاوْنم اَذ كمّْڒغ خ وبْرِيذ ينُو. <verse eid="ROM 15:24" /><verse number="25" style="v" sid="ROM 15:25" />وَلَكِن ڒخُّو اَقَا ݣُّوْرغ غَار ثنْدِينْت ن لْقُدْس بَاش اَذ عَاوْنغ ڒْمُوْمِنِين صَّالِحِين إِي ذِنِّي. <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />لِأَنَّا ڒْمُوْمِنِين إِي يدْجَان ذِي جْوَايه ن مَسِيدُوْنْيَا ذ وخَايَا تخْسن اَذ عَاوْنن يپُـوْبْرِيثن إِي يدْجَان جَار ڒْمُوْمِنِين صَّالِحِين ذِي ثنْدِينْت ن لْقُدْس. <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" />أَقَا نِثْنِي تخْسن اَذ ݣّن مَانَايَا، مَانَايَا ذ صَّح ذ يجّن ن لْوَاجِب اَقَاث خَاسن. مَايمِّي؟ لِأَنَّا يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل مڒَا يْسِين زِي لْبَرَكَا رُوْحِيَا ن يسْرَائِيلِيْين، ئِتْخصَّا-يَاسن لَابُد يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل اَذ عَاوْنن يسْرَائِيلِيْين س وَاݣْرَا نْسن. <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />إِذن خْمِي غَا كمّْڒغ شّْغڒ-أَ اَذَاسن سِّيوْضغ مَارَّا لْمُعَوَانَا-يَا، أَخَاوم د كّغ خْمِي غَا رَاحغ غَار سْپَـانْيَا. <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />أُو نش سّْنغ خْمِي غَارْوم د غَا اَسغ، أَذ د اَسغ س يِجّن ن ڒْمُوْدّ<note caller="+" style="f"><char style="fr" closed="false">15‏.29 </char><char style="ft" closed="false">ڒْمُودّ نتَّا ذ يجّن ن وقدُّوْح تُوْغَا عبَّرن ذَايس يمنْدِي نِغ يرْذَان ذ ثْمسْڒَايِين نّغْنِي ذِي زْمَان.</char></note> يشُّوْر س لْبَرَكَا ن لْمَسِيح.<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />فَا تتَّارغ زَّايْوم آي اَيثْمَا، س سِيذِيثْنغ عِيْسَى لْمَسِيح ذ ڒمْحِبّث ن اَرُّوْح ن أَربِّـي اَذ تْبدّم اَكِذِي س ثْࢲَادْجِيث نْوم غَار أَربِّـي س سَّبَاب ينُو. <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />ࢲَّادْجث حمَا نش اَذ نجْمغ زݣ يفَاسّن ن يِنِّي وَار يُوْمِيْنن شَا ذِي جْوَايه ن يَهُوْذِيَا، أُو عَاوذ بَاش ڒْخذْمث ينُو ذِي لْقُدْس اَت قبْڒن ڒْمُوْمِنِين صَّالِحِين إِي ذِنِّي. <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />ڒخْدّنِّي، مڒَا يخس أَربِّـي اَغَارْوم د اَسغ س ڒفْرَاحث أَ نْريّح اَݣ وَايَاوْيَا. <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />أَربِّـي ن ڒهْنَا اَكِذْوم يِيڒِي مَارَّا إِذْوم. آمِين.<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="s">بُوْلُس يتْسدْجَام خ شَان ڒْمُوْمِنِين ذِي ثنْدِينْت ن رُوْمَا</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />فَا تْوصِّيغ-كنِّيو خ وتْشْمَاثْنغ فِيفِي إِݣ يخدّْمن إِ جْمَاعْث ن ڒْمُوْمِنِين ذِي ثنْدِينْت ن كَنْخَرْيَا. <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />رحّْبث زَّايس عْلَاحْسَاب سِيذِيثْنغ، يعْنِي يجّن ن ورحّب إِي سْذَاهدْجن ڒْمُوْمِنِين صَّالِحِين. عَاوْنم-ت ذِي مَارَّا مِين تحْذَاج زَّايْوم ڒَاحقَّاش نتَّاث تْعَاوَان اَطَّاس ن يِوْذَان، تْعَاوَان-اَيِي ؤُڒَا ذ نش. <verse eid="ROM 16:2" /><verse number="3" style="v" sid="ROM 16:3" />سِّيوْضم-اَسن سْڒَام إِ پْـرِيسْكِيلَا ذ وَاكِيلَاس، يِنِّي اَكِذِي يخدّْمن ذِي عِيْسَى لْمَسِيح. <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />غَامَرن س ثُوْذَارْث نْسن خ سَّبَاب ينُو. وَار يدْجِي غِير نش إِي ثن يتْشكَّرن، وَلَكِن تْشكَّرنْت-ثن مَارَّا ثِجُمَاع ن ڒْمُوْمِنِين وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل. <verse eid="ROM 16:4" /><verse number="5" style="v" sid="ROM 16:5" />سِيوْضم-اَسن سْڒَام عَاوذ إِ جْمَاعْث ن ڒْمُوْمِنِين يتْمُوْنَان ذِي ثدَّارْث ن ثْنَاين-أَ. سِيوْضم-اَس سْڒَام إ ومْعِيزّ ينُو إِپَـانْتُوْس ونِّي إِي يُوْمْنن ذ اَمزْوَارُو س لْمَسِيح ذِي لْإِقْلِيم ن آسْيَا. <verse eid="ROM 16:5" /><verse number="6" style="v" sid="ROM 16:6" />سِيوْضم-اَس سْڒَام إ مَرْيَم إِݣ يخدّْمن اَطَّاس خَاوم. <verse eid="ROM 16:6" /><verse number="7" style="v" sid="ROM 16:7" />سِيوْضم-اَسن سْڒَام إ أَنْدْرُوْنِي ذ يُوْنْيَاس ڒحْبَاب ينُو، يِنِّي تُوْغَا اَكِذِي ذِي ڒحْبس. نِثْنِي مَعْرُوْفِين جَار اَرُّسُل، ؤُمْنن زِي لْمَسِيح قْبڒ مَا ٱذ اَمْنغ نش.<verse eid="ROM 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 16:8" />سِيوْضم-اَس سْڒَام إِ أَمفِلَاوُس، أَمْعِيزِّي ينُو ذِي سِيذِيثْنغ. <verse eid="ROM 16:8" /><verse number="9" style="v" sid="ROM 16:9" />سِيوْضم-اَسن سْڒَام إِ أُوْرْبَان ونِّي يخدّْمن اَكِذِي ذِي لْمَسِيح ذ ومْعِيزِّي ينُو سْتَاخِيس. <verse eid="ROM 16:9" /><verse number="10" style="v" sid="ROM 16:10" />سِيوْضم-اَس سْڒَام إِ أَپِـيلَاس، ونِّي يتْوَاملّْكن ذِي لْمَسِيح. سِيوْضم-اَسن سْڒَام عَاوذ إِ لْعَئِلَا ن أَرِسْتُوْبُوْس. <verse eid="ROM 16:10" /><verse number="11" style="v" sid="ROM 16:11" />سِيوْضم-اَس سْڒَام إ حَرُوْدِي ونِّي يدْجَان زِي ڒحْبَاب ينُو. سِيوْضم-اَسن سْڒَام إِ لْعَئِلَا ن نَرْقِيس يِنِّي يتَامْنن س سِيذِيثْنغ. <verse eid="ROM 16:11" /><verse number="12" style="v" sid="ROM 16:12" />سِيوْضم-اَسنْت سْڒَام إِ ضْرِيفُوْنَا ذ ضْرِيفِيسَا ثِنِّي يخدّْمن اَطَّاس ذِي سِيذِيثْنغ. سِيوْضم-اَس سْڒَام إِ ثَافرْسِيسْت إِي خَانغ يعِيزّن، ثْخدّم اَطَّاس ذِي سِيذِيثْنغ. <verse eid="ROM 16:12" /><verse number="13" style="v" sid="ROM 16:13" />سِيوْضم-اَسن سْڒَام إِ أَرُوْفُس ونِّي يتْوَاخْضَرن ذِي سِيذِيثْنغ ؤُڒَا ذ يمَّاس إِي حسّْبغ اَم يمَّا. <verse eid="ROM 16:13" /><verse number="14" style="v" sid="ROM 16:14" />سِيوْضم-اَسن سْڒَام إِ سِنْكْرِيتُس ذ فِيلْݣُوْن ذ هَرْمَاس ذ پَـتْرُوْبَاس ذ هِرْمِس ذ اَيثْمَاثْسن إِي كِسن يدْجَان. <verse eid="ROM 16:14" /><verse number="15" style="v" sid="ROM 16:15" />سِيوْضم-اَسن سْڒَام إِ فِيلُغِي ذ جُوْلْيَا ذ لُوْمْبَاس ذ نِيرْيُوْس اَك وتْشْمَاس ذ مَارَّا ڒْمُوْمِنِين صَّالِحِين إِي كِذْسن يدْجَان. <verse eid="ROM 16:15" /><verse number="16" style="v" sid="ROM 16:16" />سدْجْمث خ وَايَاوْيَا س يِجّن ن سْڒَام يصْفَا. قَا مَارَّا ثِجُمَاع ن لْمَسِيح تْسدْجَامنْت خَاوم.<verse eid="ROM 16:16" /></para>
  <para style="s">ڒُوْصِيّث ثَنݣَارُوْت زِي اَرَّسُوْل بُوْلُس</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />آي اَيثْمَا، تتَّارغ زَّايْوم اَذ تحْضَام يخف نْوم زݣ يِنِّي يفرّْقن ڒْمُوْمِنِين خ وَايَاوْيَا تݣّن-اَوم مِين يسفْشِيڒن، يعْنِي ضد ثْغُوْرِي نِّي إِي ثْڒمْذم كنِّيو. بعّْذث خَاسن خ يِيْنَا. <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />لِأَنَّا يِيْنَا وَار خدّْمن شَا إِ سِيذِيثْنغ عِيْسَى لْمَسِيح، خدّْمن غِير إِ وعدِّيس نْسن وَاهَا. س وَاوَاڒ يِيزِيضن ذ لْمُهَوَاضَا يزوّْقن خدّْعن ؤُڒَاون ن يِنِّي إِي ذِي ثدْجَا نِّيّث. <verse eid="ROM 16:18" /><verse number="19" style="v" sid="ROM 16:19" />كنِّيو، سْڒِين خَاوم يوْذَان مَارَّا خ طَّاعَا نْوم، نش فَرْحغ زَّايْوم خ مَانَاينِّي. وَلَكِن خْسغ كنِّيو اَذ تِيڒِيم ذ يفْطَانن خ مِين يدْجَان ذ اَصبْحَان، أَذ تْغفْڒم خ مِين يدْجَان ذ شَّرّْ. <verse eid="ROM 16:19" /><verse number="20" style="v" sid="ROM 16:20" />أَربِّـي ن ڒهْنَا نتَّا عْڒَاين اَذ يڒْبࢲ شِّيطَان سْوَادَّاي إِ يضَارن نْوم. أَكِذْوم يِيڒِي اَرْضَا ن سِيذِيثْنغ عِيْسَى لْمَسِيح.<verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />ئِسِّيوض-اَوم-د سْڒَام تِيْمُوْتَاوُس ونِّي يخدّْمن اَكِذِي، ذ ڒحْبَاب ينُو يعْنِي لُوْقْيُوْس ذ يَاسِين ذ سِبَاتْرُو.<verse eid="ROM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22" />نش تَرْتْيُوْس سِّيوْضغ-اَوم-د يجّن ن سْڒَام ذِي سِيذِيثْنغ، نش إِݣ يُوْرِين ثَبْرَات-أَ.<verse eid="ROM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23" />ئِسِّيوض-اَوم-د سْڒَام غَايُوْس، ذ نتَّا إِي زَّايِي يرحّْبن غَار ثدَّارْث نّس يرْزم-يت إِ مَارَّا جْمَاعْث ن ڒْمُوْمِنِين. ئِسِّيوض-اَوم-د سْڒَام أَرِيسْطُوْس لْأَمِين ن صّنْدُوْق ن ثنْدِينْت،<note caller="+" style="f"><char style="fr" closed="false">16‏.23 </char><char style="ft" closed="false">نتَّا يتْكلَّاف زِي تْمنْيَاث إِي يدْجَان ذِي ثْشمُّوْسِين ن ثنْدِينْت.</char></note> ذ ؤُمَاثْنغ قَرْتُوْس. <verse eid="ROM 16:23" /><verse number="24" style="v" sid="ROM 16:24" />{أَخَاوم يِيڒِي مَارَّا إِذْوم اَرْضَا ن سِيذِيثْنغ عِيْسَى لْمَسِيح. آمِين.}<verse eid="ROM 16:24" /></para>
  <para style="s">لْخِتَم ن ثبْرَات-أَ</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />ئِتْوَابَرَاك أَربِّـي! نتَّا ذ ونِّي يزمَّرن اَذَاوم يُوْش جّْهذ س لْإِنْجِيل-أَ إِي تْبشَّارغ أُو عَاوذ س ؤُحدّث ن عِيْسَى لْمَسِيح عْلَاحْسَاب مِين د يبَانن تُوْغَاث مَانَاينِّي زِي زْمَان ينُوْفَّر. <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />ڒخُّو يبَان-د مَانَايَا إِ يِوْذَان يتْوَاسّن س لْكُتُب ن لْأَنْبِيَا. أَربِّـي يعْنِي ونِّي يتْدُوْمَان إِ ڒبْدَا يُوْمَر اَزَّايس اَمْنن مَارَّا ڒݣْنُوْس اَذَاس طَاعن. <verse eid="ROM 16:26" /><verse number="27" style="v" sid="ROM 16:27" />أَربِّـي وَاحْذس إِي غَار ثدْجَا لْحِكْمَا، أَغَارس ثِيڒِي لْعَظَمَا إِ نتَّا إِ ڒبْدَا ن ڒبْدَاث س عِيْسَى لْمَسِيح! آمِين.<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>