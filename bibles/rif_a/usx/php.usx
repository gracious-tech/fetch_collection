<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- TarifitABS</book>
  <para style="h">أَيث-فيليـپـي</para>
  <para style="toc3">فلپ</para>
  <para style="toc2">أيث-فيليـپـي</para>
  <para style="toc1">ثَبْرَات ن اَرَّسُوْل بُوْلُس غَار أَيث-فِيلِيـپِّـي</para>
  <para style="mt1">ثَبْرَات ن اَرَّسُوْل بُوْلُس غَار أَيث-فِيلِيـپِّـي</para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="s">لْمُقَدِّمَا</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />نش ذ بُوْلُس اَكِذِي تِيْمُوْتَاوُس نشِّين ذ يخدَّامن ن عِيْسَى لْمَسِيح. <char style="it">نْتَارِي ثَبْرَات-أَ</char> إِ صَّالِحِين ن عِيْسَى لْمَسِيح إِي يدْجَان ذِي ثنْذِينْت ن فِيلِيـپِّـي ذ اَرُّوْيَاس نْسن ذ نُّيَاب نْسن. <verse eid="PHP 1:1" /><verse number="2" style="v" sid="PHP 1:2" />أَكِذْوم يِيڒِي اَرْضَا ذ ڒهْنَا زِي أَربِّـي بَابَاثْنغ ذ عِيْسَى لْمَسِيح سِيذِيثْنغ.<verse eid="PHP 1:2" /></para>
  <para style="s">شُّكر ذ دُّعَاء</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />تْشكَّرغ أَربِّـي كُڒ ثْوَاڒَات خْمِي ذَايْوم تْفكَّرغ. <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />كُڒ ثْوَاڒَات تْࢲَادْجِيغ خَاوم ذِي ثْࢲَادْجِيث ينُو س يِجّن ن ڒفْرَاحث ذ ثَمقّْرَانْت <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />ڒَاحقَّاش ثْشَرّْشم اَكِذِي ذِي لْإِنْجِيل زِي نْهَار اَمزْوَارُو اَڒ ڒخُّو. <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />نش اَقَايِي مْتيّْقن ذِي ثْمسْڒَايْث-أَ: ونِّي إِݣ يبْذَان ذَايْوم شَا ن شّْغڒ ذ اَصبْحَان اَخَاس يتْسِيغِي اَخَاس يتْكمَّاڒ حتَّا ٱڒ نْهَار نِّي ن عِيْسَى لْمَسِيح.<verse eid="PHP 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 1:7" />غَارِي ڒْحَقّ اَذَايْوم فكَّرغ اَمنِّي ڒَاحقَّاش اَقَا كنِّيو غَارِي ذݣ وُوْڒ ينُو. أَقَا مَارَّا ثْشَرّْشم اَكِذِي ذِي اَرْضَا <char style="it">ن ڒْخذْمث-أَ</char> وَاخَّا اَقَايِي ذِي ڒحْبس نِغ تْذَفَاعغ خ لْإِنْجِيل ذ ڒْحَقّ إِي ذَايس. <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />أَتَاف أَربِّـي ذ شَّاهذ ينُو مشْحَاڒ إِي كنِّيو تْوحَّاشغ س لْحَنَانَا ن عِيْسَى لْمَسِيح.<verse eid="PHP 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 1:9" />ذ ثَانِيتَا ذ ثْࢲَادْجِيث ينُو اَتَاف اَذ تَرْنِي ڒمْحِبّث نْوم كْتَار أُو كْتَار بَاش اَذ تسّْنم مَارَّا اَذ تْميّْزم مَارَّا. <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />حمَا اَذ تِيخْضَرم مِين يدْجَان ذ اَصبْحَان حمَا اَذ تِيڒِيم ثصْفَام بْڒَا ڒْعِيب غَار نْهَار ن لْمَسِيح. <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />زَّايس زِي عِيْسَى لْمَسِيح اَذ تِيڒِيم ثْعمَّرم س مِين د يتَارْون ڒْحَقّ. <char style="it">مَارَّا</char> مَانَايَا إِ لْعَظَمَا ن أَربِّـي ذ لْحَمْد نّس.<verse eid="PHP 1:11" /></para>
  <para style="s">لْإِنْجِيل يَرنِّي وَاخَّا حبّْسن اَرَّسُوْل بُوْلُس</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />آي أَيثْمَا رزُّوْغ اَذ تسّْنم مِين ذَايِي يوقْعن، مَانَاينِّي ذ صَّح يخدّم إِ لْإِنْجِيل بَاش اَذ يتنْتَشَر. <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />نش لْحَالَا ينُو ثذْوڒ مَعْرُوْفَا جَار مَارَّا ڒْعَسْكَار ن ڒقْصَار ذ مَارَّا يوْذَان يعْنِي نش اَقَايِي ذِي ڒحْبس عْلَاحْسَاب لْمَسِيح. <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />خ سَّبَاب ن سْنَاسڒ-أَ ينُو اَزْين اَمقّْرَان ن أَيثْمَا تْوَاشجّْعن بَاش اَذ سِّيوْڒن س وَاوَاڒ ن أَربِّـي س يِجِّن ن زْعَامث حْسن زِي قْبڒ بْڒَا ثِيݣّْوْذِي.<verse eid="PHP 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15" />ذ صَّح ذِنِّي ڒبْعَاض تْبشَّارن س لْمَسِيح س ڒحْسذ ذ لْعَدَاوَا، أُو ذِنِّي ڒبْعَاض تْبشَّارن نِيشَان س ڒْخَاضَر نْسن. <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />يِيْنَا تْبشَّارن س ڒمْحِبّث نْسن وَامِي سّْنن تْوَاخْضَرغ بَاش اَذ دَافْعغ خ لْإِنْجِيل. <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />يِنِّي نّغْنِي لَّا، تْبشَّارن س لْمَسِيح س لْأَنَانِيَا مَاشِي س وُوْڒ نْسن يصْفَا، رزُّوْن اَذَايِي ݣّن لْمَشَاكِل وَامِي دْجِيغ ذِي ڒحْبس. <verse eid="PHP 1:17" /><verse number="18" style="v" sid="PHP 1:18" />وَلَكِن مَعْلِيش، س ثْنَاين ن يبْرِيذن-أَ لْمَسِيح يتْوَابشَّار. ذ مَانَاينِّي إِي يدْجَان مُهِم وَاخَّا س وُوْڒ إِي يدْجَان ذ اَغدَّار نِغ س وُوْڒ إِي يدْجَان يصْفَان. أُو س مَانَاينِّي إِي زِي فَرْحغ نش.</para>
  <para style="p" vid="PHP 1:18">وَاه، أَذ قِّيمغ نش فَرّْحغ. <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />لِأَنَّا سّْنغ خْمِي تتَّارم خَافِي إِ أَربِّـي ذ اَرُّوْح ن سِيذِيثْنغ عِيْسَى لْمَسِيح يتْعَوَان-اَيِي اَتَاف مِين ذَايِي يتوْقِيعن اَذ يذْوڒ ذ اَسفْڒث ينُو. <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />تْرَاجِيغ س وُوْڒ ينُو نش تْمنِّيغ وَار تْسذْحِيغ شَا قَاع <char style="it">خ لْوَاجِب ينُو</char>. لَّا، نش تْزعَّمغ ڒخُّو اَذ زعْمغ منْبَعْد بَاش س دَّات ينُو اَزَّايس يمْغَر لْمَسِيح وَاخَّا اَذ مّْثغ نِغ اَذ دَّرغ. <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />مِينْزِي غَارِي لْمَسِيح نتَّا ذ ثُوْذَارْث ينُو، غَارِي ڒْموْث نتَّاث ذ لْجَائِزَا ينُو. <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />مڒَا قِّيمغ دَّرغ س دَّات-أَ ينُو، أَتَاف اَذ اَرْنِيغ مْلِيح ذِي ڒْخذْمث ينُو. وَلَكِن نش وَار سِّينغ شَا مِين غَا يخْضَرغ. <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />ڒخُّو اَقَايِي جَار ثْنَاين ن ثْمسْڒَايِين-أَ إِي غَا يخْضَرغ. ذَايِي مِيزْڒِي اَذ ؤُيُوْرغ <char style="it">زِي ثُوْذَارْث-أَ</char> اَذ يڒِيغ اَك لْمَسِيح ڒَاحقَّاش مَانَايَا قَاع حْسن زِي مَارَّا. <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />وَلَكِن لَابُد حْسن إِ كنِّيو مڒَا قِّيمغ <char style="it">دَّرغ</char> س دَّات-أَ ينُو. <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />أَقَايِي تيّْقغ س لْوَاجِب-أَ ينُو سّْنغ اَذ قِّيمغ اَذ سِيغِيغ ذَانِيتَا اَكِذْوم بَاش اَذ تَرْنِيم ذِي لْإِيمَان اَزَّايس ثْفَرْحم. <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />أَغَارْوم د عقْبغ عَاوذ. خ سَّبَاب-أَ اَتَاف ڒفْرَاحث نْوم ذِي عِيْسَى لْمَسِيح اَذ د تنْفيّض عْلَاحْسَاب نش.<verse eid="PHP 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27" />لْمُهِيم، سُوْيُورث يخف نْوم ذݣ يِجّن ن وبْرِيذ يتِيشّن لْقِيمَا إِ لْإِنْجِيل ن لْمَسِيح. ثُمَّا وَاخَّا نش ؤُسِيغ-د اَكنِّيو ࢲرغ نِغ غَابغ خَاوم اَتَاف اَخَاوم سْڒغ ڒخْبَار بلِّي ثُوْݣُّوْرم نِيشَان خ يِجّن ن اَرَّاي، ثْخدّْمم فُوْس ذݣ وفُوْس خ سَّبَاب ن لْإِيمَان إِي يدْجَان ذِي لْإِنْجِيل، <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />عَاوذ وَار تݣّْوْذم شَا قَاع زݣ يِنِّي إِي ذَاوم يتْعَارَّاضن. مَانَايَا إِي تݣّم اَغَارْسن ثِيڒِي ذ يجّن ن لْعَلَامَا إِي د يسْبيَّانن مْلِيح نِثْنِي اَذ فْنَان كنِّيو اَذ تْنجْمم. مَارَّا مَانَايَا اَذ د يَاس زِي أَربِّـي. <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />مَاشِي عْلَاحْسَاب لْمَسِيح اَزَّايس ثَامْنم وَاهَا؛ لَّا، لَابُد عَاوذ اَذ تْوَاعدّْبم عْلَاحْسَاب سَّبَاب نّس. <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />مِينْزِي كنِّيو تْمنْغَام ذݣ ومنْغِي نِّي إِي ذِي تُوْغَا تْمنْغِيغ نش أُو عَاذ تسْڒِيم بلِّي تْمنْغِيغ ذَايس.<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s">أَرَّاي نّغ اَذ يذْوڒ اَم اَرَّاي ن لْمَسِيح</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />مڒَا كنِّيو تْوَاشجّْعم س لْمَسِيح نِغ ثتْهِلَّام ذِي ڒمْحِبّث نّس نِغ ثْشَرّْشم اَك أَرُّوْح نّس، نِغ ثُوْفِيم ذَايس اَرَّحْمث ذ لْحَنَانَا، <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />أَتَاف يتْخصَّا اَذ تْكمّْڒم إِ ڒفْرَاحث ينُو اَغَارْوم يِيڒِي اَرَّاي ذ يجّن ذ ڒمْحِبّث ذ يشْتن، كنِّيو اَذ تِيڒِيم ذ يجّن اَغَارْوم ثِيڒِي يجّن ن لْفِكْرَا. <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />وَار تݣّم وَالُو زِي لْأَنَانِيَا نِغ زِي تَّكبُّر. بْڒَا تَّكبُّر وقَّرم ينّغْنِي حْسن زݣ يِيخف نْوم. <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />ئِتْخصَّا كُڒ يجّن زَّايْوم وَار يخزَّر شَا مِين ث يتْهِيمَان وَاهَا. ئِتْخصَّا-ث عَاوذ اَذ يخْزَر مِين يتْهِيمَان إِ يِنّغْنِي.<verse eid="PHP 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 2:5" />أَرَّاي نْوم يتْخصَّا اَذ يِيڒِي اَم اَرَّاي ن عِيْسَى لْمَسِيح. <verse eid="PHP 2:5" /><verse number="6" style="v" sid="PHP 2:6" />نتَّا اَقَاث ذ صِّفث ن أَربِّـي، وَلَكِن وَامِي يمْقُدَّا اَك أَربِّـي وَار ينْوِي شَا اَذ يطّف ذِي مَانَاينِّي. <verse eid="PHP 2:6" /><verse number="7" style="v" sid="PHP 2:7" />لَّا، نتَّا يَارَّا يخف نّس ذ وَالُو يطّف يجّن ن صِّفث اَم يِيسْمغ، يعْنِي يخْڒق-د اَم صِّفث ن بْنَاذم. <verse eid="PHP 2:7" /><verse number="8" style="v" sid="PHP 2:8" />وَامِي د يمظْهَار اَم صِّفث ن يِجّن ن بْنَاذم، ئِسهْوَا-د يخف نّس يطَاع حتَّا وَامِي يمُّوْث يجّن ن ڒْموْث ذِي صَّلِيب. <verse eid="PHP 2:8" /><verse number="9" style="v" sid="PHP 2:9" />خ مَانَاينِّي يسْݣَعّذ-يث أَربِّـي غَار وجنَّا قَاع، يݣَّا-ٱس يسم نِّي إِي يدْجَان ذݣ وجنَّا خ يِيسمَاون مَارَّا. <verse eid="PHP 2:9" /><verse number="10" style="v" sid="PHP 2:10" />بَاش خ يِيسم نِّي ن عِيْسَى اَذ ركْعن مَارَّا خ يفَادّن نْسن، يِنِّي يدْجَان ذݣ وجنَّا ذ يِنِّي يدْجَان ذِي ثْمُوْرْث ذ يِنِّي يدْجَان سْوَادَّاي ن ثْمُوْرْث. <verse eid="PHP 2:10" /><verse number="11" style="v" sid="PHP 2:11" />أَذ يعْتَرف كُڒ يِيڒس اَذ يِينِي خ عِيْسَى لْمَسِيح قَا نتَّا ذ سِيذِيثْنغ اَزَّايس يسمْغَار أَربِّـي بَابَاثْنغ.<verse eid="PHP 2:11" /></para>
  <para style="s">إِڒِيث اَم يِيثْرَان ن وجنَّا يرقّن خ ثْمُوْرْث</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />إِذن آي يمْعِيزّن ينُو، مَامش تُوْغَا ثتْطَاعَام ڒبْدَا زِي قْبڒ وَامِي تُوْغَايِي اَكِذْوم، أَمنِّي عَاوذ إِي غَا ذَايِي ثْطَاعم وَامِي خَاوم غَابغ. يعْنِي اَذ تقِّيمم تݣّم لْمجْهُوْد بَاش اَذ تْكمّْڒم مْلِيح ذݣ وسنْجم نْوم س يِجّن ن ثِيݣّْوْذِي ذ يِجّن ن تَرْجِيجِي. <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />مِينْزِي ذ أَربِّـي إِݣ يسْخدَّامن اَرَّاي نْوم ذ ڒخْذَايم نْوم بَاش اَذ تݣّم لْغَرَض نّس ذ اَصبْحَان.<verse eid="PHP 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14" />ݣّث مَارَّا ثِمسْڒَايِين بْڒَا مَا ٱذ تْشثْشَام بْڒَا مَا ٱذ تْمنْغم. <verse eid="PHP 2:14" /><verse number="15‏-16" style="v" sid="PHP 2:15-16" />أَمُّو اَذ تِيڒِيم بَرِئِن بْڒَا ڒْعِيب ذِي ڒْوسْط ن يِوْذَان ن ڒْوقْث-أَ يعوّْجن يخَروْضن. ذَايْسن إِي ثْرقّم اَم يِيثْرَان ذِي دُّنشْت-أَ خْمِي ذَاسن تْقدَّامم اَوَاڒ ن ثُوْذَارْث. أَمنِّي اَذ فْتَخَرغ ذِي نْهَار نِّي ن لْمَسِيح نش وَار ؤُزِّيڒغ شَا وَار خْذِيمغ شَا ذِي ڒْخَاوِي وَاهَا. <verse eid="PHP 2:15-16" /><verse number="17" style="v" sid="PHP 2:17" />نش فَرّْحغ اَكِذْوم س يِجّن ن ڒفْرَاحث مَعْلِيش مڒَا فرّْغن-اَيِي-د وَاهَا اَم يِجّن ن صّذْقث ن يذَامّن خ دْبِيحث نْوم إِي تْقدَّامم كنِّيو س لْإِيمَان نْوم. <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />أَمنِّي عَاوذ ؤُڒَا ذ كنِّيو يتْخصَّا اَكِذِي ثْفَرْحم س يِجّن ن ڒفْرَاحث.<verse eid="PHP 2:18" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس يتْوصَّا خ تِيمُوْتَاوُس ذ پَـارْفُوْلِيتُس</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />تْمنِّيغ س عِيسَى لْمَسِيح اَذَاوم د سّكّغ تِيْمُوْتَاوُس ذغْيَا بَاش خْمِي ذَايِي د غَا يَارّ ڒخْبَار خَاوم اَذَايِي يسْفَرح. <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />وَار غَارِي <char style="it">ذَا</char> حَدّ اَم نتَّا تْهِيمَا-ث لْحَالَا نْوم. <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />مَارَّا رزُّوْن مِين ذَاسن يتْهِيمَان إِ يِيخف نْسن وَاهَا، مَاشِي مِين يتْهِيمَان إِ عِيسَى لْمَسِيح. <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />أَمَّا تِيْمُوْتَاوُس نتَّا ثسّْنم-ث ملْتَازم س يِيخف نّس، ئِخدّم اَكِذِي ذِي لْإِنْجِيل اَم يِجّن ن وحَرْمُوْش يخدّم اَك بَابَاس. <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />خ مَانَايَا، تْمنِّيغ اَذَاوم ثِيذ سّكّغ وَلَكِن تْرَاجِيغ اَذ ࢲرغ مَامش غَا عْذُوْنْت لْمَشَاكِل ينُو. <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />أُو نش اَقَايِي مْتيّْقن ذِي سِيذِيثْنغ اَغَارْوم د اَسغ ذغْيَا ؤُڒَا ذ نش.<verse eid="PHP 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25" />شُوْف، تْوَاڒِيغ لَابُد اَذَاوم د اَرّغ ؤُمَا پَـارْفُوْلِيتُس ونِّي إِي كِذِي يتمْعَشَارن اَم شَا ن ومْجَاهذ. نتَّا ذ اَمسخَّار نْوم ونِّي إِي ذَايِي د تسّكّم بَاش اَذَايِي يتْهِيلَّا. <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />ئِتْوحَّاش-يكنِّيو اَطَّاس مَارَّا إِذْوم، ييْسِي خَاوم اَمْنُوْس عَاوذ وَامِي د ثَارِّيم ڒخْبَار تُوْغَا يهْڒش. <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />وَاه، تُوْغَا يهْڒش ذ صَّح. تُوْغَا عْڒَاين يمُّوْث وَلَكِن أَربِّـي يرْحم-يث. وَار يدْجِي شَا نتَّا وَاهَا، يرْحم-اَيِي ؤُڒَا ذ نش بَاش وَار خَافِي يتْمَارْنِي ڒْهمّْ خ ڒْهمّْ. <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />خ مَانَاينِّي اَذَاوم ثِيذ سّكّغ ڒخُّو ذ اَبْرِيذ بَاش اَذ تْفَرْحم خْمِي ث غَا ثࢲرم أُو عَاوذ وَار ذَايِي يتِيڒِي بُو ومْنُوْس. <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />رحّْبم-ث س سِيذِيثْنغ س يِجّن ن ڒفْرَاحث ذ تَمقّْرَانْت، وقَّرث يرْيَازن اَم نتَّا. <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />مَايمِّي؟ تُوْغَا عْڒَاين يمُّوْث عْلَاحْسَاب ڒْخذْمث ن لْمَسِيح مِينْزِي يغَامَر س ثُوْذَارْث نّس وَامِي يرزُو اَذ يخْذم مِين وَار ثْزمَّرم شَا اَذ تْخذْمم كنِّيو زِي لْوَاجِب نْوم غَارِي.<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s">أَ نمْصْڒَاح اَك أَربِّـي س عِيْسَى لْمَسِيح</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />ڒخُّو آي أَيثْمَا اَذ كمّْڒغ، فَرْحث س سِيذِيثْنغ! وَار غَارِي بُو لْمُشْكِل اَذَاوم عَوْذغ ثِمسْڒَايِين-أَ س ثِيرَا، كنِّيو عَاوذ اَزَّايْسنْت تْوَاحْضَام زِي لْخَطَر.<verse eid="PHP 3:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="PHP 3:2" />حْضَام يخف نْوم زݣ يقْزِينن نِّي، يعْنِي يرْيَازن نِّي يتݣّن شَّرّْ يتْحجَّامن إِ بْنَاذم. <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />شُوْف، ذ نشِّين إِݣ يدْجَان ذ طَّهَارث نِّي ن صَّح. يعْنِي نْعبّذ س أَرُّوْح ن أَربِّـي، غِير نْتفْتَخَر س عِيْسَى لْمَسِيح، وَار نتْرِيجِي شَا اَڒ لْحَسَانَات نّغ. <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />إِيوَا ؤُڒَا ذ نش غَارِي سَّبَاب اَذ رَاجِيغ اَڒ لْحَسَانَات ينُو زَعْمَا. مڒَا ذِنِّي شَان يجّن غَارس سَّبَاب اَذ يرَاجَا اَڒ لْحَسَانَات نّس، أَتَاف نش غَارِي كْتَار زَّايس. <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />مَايمِّي؟ نش تهَّارغ نْهَار وِيس ثْمنِيَّام. لْأَصل ينُو زِي أَيث-إِسْرَائِيل زِي أَيث-بنْيَامِين. نش ذ اَعِبْرَانِي مِّيس ن يعِبْرَانِيْين. عْلَاحْسَاب شَّرِيعَا، نش زِي ڒْحِزب نِّي ن يفَرِّيسِيْين. <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" />عْلَاحْسَاب زْعَامث ينُو نش تُوْغَا تْعدَّابغ جْمَاعث ن ڒْمُوْمِنِين ن لْمَسِيح. عْلَاحْسَاب لْقَوَانِين إِي يدْجَان ذِي شَّرِيعَا تُوْغَايِي س بْڒَا ڒْعِيب.<verse eid="PHP 3:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="PHP 3:7" />وَلَكِن خ سَّبَاب ن لْمَسِيح مِين ذَايِي ينفّْعن قْبڒ، ڒخُّو حسّْبغ-ث ذ ثَخْصَارْث. <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />ذ صَّح حسّْبغ ثِمسْڒَايِين-أَ قَاع ذ ثَخْصَارْث خ سَّبَاب ن لْقِيمَا ثَمقّْرَانْت بَاش اَذ سّْنغ عِيْسَى لْمَسِيح نتَّا ذ سِيذِي. خ سَّبَاب نّس إِي خْصَرغ ثِمسْڒَايِين-أَ قَاعِين، حسْبغ-ثنْت ذ زّْبڒ بَاش اَذ ربْحغ عِيْسَى لْمَسِيح. <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />حمَا اَذَايِي اَفن ذَايس بْڒَا شَا ن صُّلْح اَك أَربِّـي إِي د يتَاسن زَّايِي نش وَاهَا عْلَاحْسَاب شَّرِيعَا. لَّا، صُّلْح نِّي ينُو اَك أَربِّـي يتَاس-د س لْإِيمَان ينُو زِي لْمَسِيح، يعْنِي صُّلْح نِّي يتَاس-د زِي أَربِّـي يتَاس-د س لْإِيمَان. <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />رزُّوْغ اَذ سّْنغ لْمَسِيح ذ جّْهذ نّس وَامِي د يكَّر زِي ڒْموْث. أَذ سّْنغ عَاوذ ثَمْعَشَارْث نِّي خْمِي غَا نْشَرش اَكِذس س وعدّب نِّي إِي خَاس يكِّين نتَّا، أَ نذْوڒ اَمشْنَاو نتَّا س ڒْموْث نّس. <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />أَمنِّي مَامش مَا يݣَّا، نش اَذ اَفغ يُوْم لْقِيَامَا اَذ يِيڒِي ينُو.<verse eid="PHP 3:11" /></para>
  <para style="s">يَالَاهث أَ نْحَاوْڒث بَاش أَ نطّف مِين نْرزُّو</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />وَار يدْجِي شَا صَافِي طّْفغ مَارَّا ثِمسْڒَايِين نِّي نِغ صَافِي وَار ذَايِي بُو شَا ن ڒْعِيب؛ لَّا، نش عَاذ تْحَاوَاڒغ اَذ طّْفغ ثِمسْڒَايِين نِّي إِي زِي ذَايِي يطّف عِيْسَى لْمَسِيح. <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />آي أَيثْمَا، وَار حسّْبغ شَا صَافِي طّْفغ قَاع ثِمسْڒَايِين نِّي. وَلَكِن ذِنِّي يجّن ن ثْمسْڒَايْث تݣّغ-ت: تتُّوْغ مِين يتعْقَابن غَار ذفَّار، تݣّغ لْمجْهُوْد ينُو غَار مِين د يݣُّوْرن غَار زَّاث. <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />تْحَاوَاڒغ خ مَانَاينِّي إِي خف رزُّوْغ بَاش اَذ ربْحغ لْجَائِزَا نِّي إِي زِي ذَايِي د يڒَاغَا أَربِّـي غَارس غَار وجنَّا س عِيْسَى لْمَسِيح. <verse eid="PHP 3:14" /><verse number="15" style="v" sid="PHP 3:15" />فَلِيهَاذَا مَارَّا نشِّين إِݣ يتمْغُوْرن <char style="it">ذِي لْإِيمَان</char> يتْخصَّا أَ نفكَّر اَمنِّي. مڒَا كنِّيو وَار ثْفكَّرم شَا اَمنِّي ذ أَربِّـي إِي كنِّيو غَا يسْفهْمن. <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />وَلَكِن مِين نسّن عَاذ نِيشَان لَابُد اَذَايس نطّف مْلِيح.<verse eid="PHP 3:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />آي أَيثْمَا، مُوْنث اَك يِنِّي يتݣّن اَم نش. خْزَرث مْلِيح غَار يِنِّي يݣُّوْرن ذݣ وبْرِيذ نّغ. <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />لِأَنَّا ذِنِّي اَطَّاس ن يِنِّي يݣُّوْرن ذ ڒْعَذْيَان خ صَّلِيب ن لْمَسِيح. أَوَاڒ-أَ نِّيغ-اَوم-ث زِي قْبڒ، ڒخُّو تْعَوَاذغ-اَوم-ث س يمطَّاون ينُو. <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />أَنݣَّارُو نْسن اَذ يتْوَامْحَا. أَربِّـي نْسن نتَّا ذ اَعدِّيس نْسن. سمْغَارن يخف نْسن س ڒفْضَايح نْسن. ڒَعْقُوْڒَاث نْسن نُّوْغن ذِي ثْمسْڒَايِين ن دُّنشْت-أَ. <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />نشِّين لَّا، لْجِنْسِيَا نّغ اَقَات ذݣ وجنَّا. سّنِّي إِي د غَا يَاس ونِّي إِي نتْرَاجَا إِي ذَانغ غَا يسْنجْمن يعْنِي سِيذِيثْنغ عِيْسَى لْمَسِيح. <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />دَّات نّغ ن دُّنشْت-أَ اَت يسْبدّڒ لْمَسِيح بَاش اَذ تِذْوڒ اَم دَّات نّس لْعَظِيم. ئِتݣّ مَانَايَا س جّْهذ نِّي إِي زِي يزمَّر اَذ يَارّ قَاع ثِمسْڒَايِين سْوَادَّاي إِ لْحُكم نّس.<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="nb">
    <verse number="1" style="v" sid="PHP 4:1" />إِذن آي أَيثْمَا إِي خَافِي يعِيزّن إِي تْوحَّاشغ إِݣ يدْجَان ذ ڒفْرَاحث ينُو ذ تَّاج ينُو، أَمنِّي لَابُد يتْخصَّا اَذ تقِّيمم ثْبدّم ذِي سِيذِيثْنغ آي يمْعِيزّن ينُو.<verse eid="PHP 4:1" /></para>
  <para style="s">ڒُوْصِيَاث ثِنݣُّوْرَا</para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />تتَّارغ إِ سُوْيْثْمَاثْنغ ثُوْدْيَا ذ ثِينْتِيشْيَا بَاش اَذ يِيڒِي اَرَّاي نْسنْت ذ يجّن اَك سِيذِيثْنغ. <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />وَاه، تتَّارغ ؤُڒَا ذ شك آي اَمْعَشَار ينُو ن صَّح، عَون ثِمْغَارِين-أَ إِي كِذِي يخدّْمن فُوْس ذݣ وفُوْس ذِي لْإِنْجِيل، أَكِذْسنْت عَاوذ كْرِيمُو ذ يمْعَشَارن ينُو نّغْنِي. ئِسمَاون نْسن مَارَّا اَقَاثن ذِي لْكِتَاب ن ثُوْذَارْث.<verse eid="PHP 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />فَرّْحث ڒبْدَا س سِيذِيثْنغ! أَذَاوم ينِيغ اَوَاڒ-أَ عَاوذ، فَرّْحث! <verse eid="PHP 4:4" /><verse number="5" style="v" sid="PHP 4:5" />ئِتْخصَّا اَذ د يمظْهَار صّْبَر نْوم إِ مَارَّا يوْذَان، أَقَا سِيذِيثْنغ يُوْذس-د. <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />وَار كسِّيم بُو ومْنُوْس خ وَالُو. س ثْࢲَادْجِيث نْوم ذ دُّعَاء نْوم اَكِذْسن شُّكر نْوم اَذ تْقدّْمم مَارَّا ثِمسْڒَايِين س طَّلَابَاث نْوم إِ أَربِّـي. <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />ثُمَّا ڒهْنَا ن أَربِّـي إِݣ يتجْهِيذن خ مَارَّا ڒفْهَامث <char style="it">ذِي دُّنشْت-أَ</char> ذ ونِّي إِي غَا يحْضَان ؤُڒَاون نْوم ذ ڒَعْقُوْڒَاث نْوم ذِي عِيْسَى لْمَسِيح.<verse eid="PHP 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />غَار ونݣَّارُو آي أَيثْمَا، مِين يدْجَان ذ لْحَقِيقَا ذ مِينْدِي يدْجَا ڒوْقَّار ذ مِين يدْجَان يسݣّْذن ذ مِين يدْجَان يصْفَان ذ مِين يدْجَان ذ اَصبْحَان ذ مِين خَانغ يعِيزّن ذ اَيِّي ثَمسْڒَايْث ذ ثَصبْحَانْت اَطَّاس اَذَاس نُوْش لْقِيمَا يتْخصَّا كنِّيو اَذ تْفكَّرم ذِي ثْمسْڒَايِين-أَ. <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />مِين ثْڒمْذم ذ مِين ثْقبْڒم زَّايِي ذ مِين ثسْڒِيم ذ مِين ثࢲْرِيم خَافِي يتْخصَّا أُو لَابُد اَذ تسْخذْمم ثِمسْڒَاِيِين-أَ. ثُمَّا اَكِذْوم يِيڒِي أَربِّـي ن ڒهْنَا.<verse eid="PHP 4:9" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس يتْشكَّر ڒْمُوْمِنِين خ لْهَدِيَاث نْسن</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />فَا، مشْحَاڒ فَرْحغ س سِيذِيثْنغ وَامِي اَڒ ونݣَّارُو عَاوذ تُوْغَا ثْزمَّرم اَذَايِي ثْفقْذم. وَاه، تُوْغَا تْفكَّرم ذَايِي قْبڒ وَلَكِن وَار ثُوْفِيم شَا لْفُرْصَا بَاش اَذَايِي ثْعَوْنم. <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />أَوَاڒ-أَ ينُو وَار يقَّار شَا رزُّوْغ شَان ڒْحَاجث؛ لَّا، نش ڒمْذغ اَذ قنْعغ مَامّش مَا دْجَانْت ظُّرُوْف ينُو. <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />سّْنغ اَذ عِيشغ ذݣ وزيَّار، سّْنغ عَاوذ اَذ عِيشغ ذِي ڒْخِير. نش مَامش مَا دْجَانْت ظُّرُوْف ينُو ڒمْذغ سِّير اَذ وَاجْهغ ڒْخِير نِغ ذ جُّوْع، وَاخَّا غَارِي اَطَّاس نِغ شْوَايْت وَاهَا. <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />قَاع ثِمسْڒَايِين زمَّرغ-اَسنْت س ونِّي إِي ذَايِي يتشّن جّْهذ. <verse eid="PHP 4:13" /><verse number="14" style="v" sid="PHP 4:14" />وَلَكِن مْلِيح وَامِي ثْشَرْشم اَكِذِي ذِي لْمَشَاكِل ينُو.<verse eid="PHP 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 4:15" />آ أَيث-فِيلِيـپِّـي، وَامِي فّْغغ نش زِي لْإِقْلِيم ن مَسِيدُوْنْيَا ثسّْنم قَا ذ كنِّيو وَاهَا زِي مَارَّا ثِجُمَاع ن ڒْمُوْمِنِين إِي كِذِي يشَرْشن ذِي لْمُعَاوَنَا. مَانَاينِّي يوْقع وَامِي يَالَّاه بْذِيغ تْبشَّارغ س لْإِنْجِيل ذِي جْوَايه نِّي. <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />وَاخَّا وَامِي تُوْغَايِي ذِي ثنْدِنْت ن سَلُوْنِيك مِين حْذَاجغ ذِنِّي ثسّكّم-اَيِي-ث-يد اَطَّاس ن ثْوَاڒَاثِين. <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />وَلَكِن نش وَار رزُّوْغ شَا اَذَايِي ثُوْشم شَا ن ڒْحَاجث، نش رزُّوْغ مِين غَا يَرْنِين ذِي لْأَجَار نْوم <char style="it">اَك أَربِّـي</char>. <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />طّْفغ ڒْمُوْنث ثكْمَاڒ زَّايْوم أُو كْتَار عَاذ. ثْذبَّرم-اَيِي-د مْلِيح وَامِي قبْڒغ زݣ <char style="it">وُوْمَاثْنغ</char> پَـارْفُوْلِيتُس لْهَدِيَاث نِّي إِي ذَايِي د ثسّكّم. نِثنْتِي اَم يِجّن صّذْقث ثتْفُوْح ذ يِجّن ن دْبِيحث إِي غَا يقْبڒ أَربِّـي إِي ذَاس غَا يعجْبن. <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />أَقَا أَربِّـي ينُو اَذَاوم يُوْش قَاع مِين ثحْذَاجم عْلَاحْسَاب اَݣْڒَا نّس لْعَظِيم ذِي عِيْسَى لْمَسِيح. <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />لْعَظَمَا إِ أَربِّـي بَابَاثْنغ إِ ڒبْدَا ن ڒبْدَاث. آمِين.<verse eid="PHP 4:20" /></para>
  <para style="s">لْخِتَام ن ثبْرَات-أَ</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />سِيوْضم سْڒَام إِ مَارَّا صَّالِحِين س عِيْسَى لْمَسِيح. أَوْمَاثن يدْجَان اَكِذِي سَاوَّاضن-اَوم-د سْڒَام. <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />مَارَّا صَّالِحِين سَاوَّاضن-اَوم-د سْڒَام خَاصَّتَان يِنِّي يدْجَان ذِي ثدَّارْث ن وزدْجِيذ قَيْصَار.<verse eid="PHP 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23" />أَذ يِيڒِي اَك اَرُّوْح نْوم اَرْضَا ن سِيذِيثْنغ عِيْسَى لْمَسِيح.<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>