<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- TarifitABS</book>
  <para style="h">1 يوحنا</para>
  <para style="toc3">1يوح</para>
  <para style="toc2">1 يوحنا</para>
  <para style="toc1">ثَبْرَات ثَمزْوَارُوْت ن اَرَّسُوْل يُوْحَنَّا</para>
  <para style="mt1">ثَبْرَات ثَمزْوَارُوْت ن اَرَّسُوْل يُوْحَنَّا</para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s">لْمُقَدِّمَا</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />مِين تُوْغَا ذِنِّي زݣ ومزْوَارُو، نتْسْڒَا-يَاس نࢲّر-يث س ثِيطَّاوِين نّغ، نخزَّر ذَايس نتْحَاذَا-ث س يفَاسّن نّغ يعْنِي ذ اَوَاڒ ن ثُوْذَارْث. <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />ثُوْسَا-د ثُوْذَارْث ثْمظْهَار-د، نشِّين نْࢲر-يت نشْهذ خَاس. نتْبشَّار-يكنِّيو س ثُوْذَارْث-أَ وَار يفنِّين شَا عمَّارْص. تُوْغَا ثدْجَا ذِنِّي اَك بَابَاس سّنِّي ثْمظْهَار-اَنغ-د. <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />مِين نࢲْرَا ذ مِين نتْسْڒَا نتْبشَّار-يكنِّيو زَّايس حمَا ؤُڒَا ذ كنِّيو اَذ تمْعَاشَرم اَكِذْنغ. <char style="it">مَارَّا</char> نشِّين ثَمْعَاشَرْث نّغ اَقَات اَك بَابَاثْنغ ذ مِّيس عِيْسَى لْمَسِيح. <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />نْتَارِي-يَاوم-د ثِمسْڒَاِين-أَ حمَا ڒفْرَاحث نّغ اَذ تجَّاون.<verse eid="1JN 1:4" /></para>
  <para style="s">نُّوْر ن أَربِّـي يتْشعْشِيعن ذِي ثَادْجسْت</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />ذ وَا ذ اَوَاڒ إِي زَّايس نتْسْڒَا نتْبشَّار-يكنِّيو زَّايس يعْنِي أَربِّـي ذ نُّوْر وَار ذَايس بُو ثَادْجسْت. <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />مڒَا نقَّار قَا نشِّين نْتمْعَاشَر اَكِذس وَلَكِن نݣُّوْر ذݣ وبْرِيذ ن ثَادْجسْت اَتَاف نسْخَرِّيق وَاهَا وَار نسْخدِّيم شَا لْحَقِيقَا. <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />وَلَكِن مڒَا نݣُّوْر ذِي نُّوْر مَامّش يدْجَا نتَّا ذِي نُّوْر، أَتَاف نْتمْعَاشَر اَك وَايَاوْيَا اَتَاف يذَامّن ن مِّيس عِيْسَى سِّيصْفَان-اَنغ زِي مَارَّا ڒْمُعْصِيَاث.<verse eid="1JN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8" />مڒَا نقَّار وَار ذَايْنغ بُو ڒْمُعْصِيَاث اَتَاف نسْخَرِّيق خ يِيخف نّغ وَاهَا، أَتَاف لْحَقِيقَا وَار ذَايْنغ ثْزدّغ شَا. <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />وَلَكِن مڒَا نعْتَرف س ڒْمُعْصِيَاث نّغ إِ أَربِّـي، نتَّا اَقَاث نِيشَان ذَايس تِّقث، أَذَانغ يغْفَر ڒْمُعْصِيَاث نّغ اَذَانغ يسِّيصْفَا زِي مَارَّا شَّرّْ. <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />مڒَا نقَّار قَا نشِّين وَار نعْصِي شَا أَربِّـي، أَتَاف نتَّا نْتَارَّا-ث ذ بُو-يخَرِّيقن، أَتَاف اَوَاڒ نّس وَار ذَايْنغ يزدّغ شَا.<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />آ يحنْجِيرن ينُو، تَارِيغ-اَوم-د ثِمسْڒَايِين-أَ حمَا وَار ثْعصِّيم شَا أَربِّـي. وَلَكِن مڒَا نعْصَا-ث اَقَا غَارْنغ يجّن ن لْوَسِيط اَك أَربِّـي بَابَاثْنغ نتَّا ذ عِيْسَى لْمَسِيح ونِّي إِݣ يدْجَان نِيْشَان. <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />ذ نتَّا إِݣ يرُوْحن ذ لْفِدْيَا خ ڒْمُعْصِيَاث نّغ أُو مَاشِي غِير خ ڒْمُعْصِيَاث نّغ وَاهَا، حتَّا ؤُڒَا ذ ڒْمُعْصِيَاث ن دُّنشْت-أَ اَمن-ثكْمَاڒ.<verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />مَامّش غَا نݣّ نشِّين أَ نفْهم بلِّي نسّن-يث؟ قَا ث نسّن مڒَا نتْطَاعَا-ٱسنْت إِ ڒُوْصِيَاث نّس. <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />ونِّي إِي غَا ينِين قَا نش سّْنغ-ث وَار يتْطِيعِي شَا إِ ڒُوْصِيَاث نّس اَتَاف نتَّا ذ بُو-يخَرِّيقن وَاهَا، أَتَاف لْحَقِيقَا وَار ذَايس ثْزدّغ شَا. <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />وَلَكِن ونِّي إِݣ يتْطَاعَان إِ وَاوَاڒ نّس، أَقَا وَانِيتَا ذ صَّح ثجِّيون زَّايس ڒمْحِبّث ن أَربِّـي. مَامّش غَا نݣّ نشِّين أَ نسّن إِلَّا نْزدّغ ذَايس؟ <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />يعْنِي ونِّي إِي غَا ينِين قَا نش زدّْغغ ذَايس يتْخصَّا-يَاس أُو لَابُد اَذ يݣُّوْر ذݣ وبْرِيذ نِيْشَان اَم ونِّي إِي ذِي تُوْغَا يݣُّوْر عِيْسَى.<verse eid="1JN 2:6" /></para>
  <para style="s">ئِجّن ن ڒُوْصِيّث ذ جْذِيذ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />آي يمْعِيزّن ينُو، وَار ذَاوم د تَارِيغ شَا يجّن ن ڒُوْصِيّث ذ جْذِيذ؛ لَّا، نتَّاث ذ يجّن ن ڒُوْصِيّث ذ ثَقْذِينْت تُوْغَا ثدْجَا غَارْوم زݣ ومزْوَارُو. ڒُوْصِيّث-أَ ثَقْذِينْت نتَّاث ذ اَوَاڒ نِّي إِي تُوْغَا ثسْڒِيم. <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />وَلَكِن نتَّاث عَاوذ ذ يجّن ن ڒُوْصِيّث ذ جْذِيذ إِي ذَاوم د ؤُرِيغ. لْحَقِيقَا نّس نتْوَاڒَا-ت ذِي <char style="it">عِيْسَى</char> نتْوَاڒَا-ت ذَايْوم ڒَاحقَّاش ثَادْجسْت ثْعدُّو، ڒخُّو نُّوْر ن صَّح صَافِي يتْشعْشِيع-د.<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />ونِّي يقَّارن نش اَقَايِـي ذِي نُّوْر نتَّا يتْعِيفَّا ؤُمَاس، أَتَاف نتَّا يدْجَا عَاذ ذِي ثَادْجسْت. <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />وَلَكِن ونِّي يتخْسن ؤُمَاس اَتَاف نتَّا يتْعِيش ذِي نُّوْر اَتَاف وَار غَارس مِين ث غَا يغضْڒن. <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />ونِّي يتْعِيفَّان ؤُمَاس اَتَاف نتَّا عَاذ أَقَاث ذِي ثَادْجسْت اَتَاف يݣُّوْر ذِي ثَادْجسْت. وَار يسِّين شَا مَانِي يݣُّوْر ڒَاحقَّاش ثَادْجسْت نِّي ثسْضَاغڒ-يث زِي ثِيطَّاوِين نّس.<verse eid="1JN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12" />آ يحنْجِيرن، نش ؤُرِيغ-اَوم-د ڒَاحقَّاش ڒْمُعْصِيَاث نْوم تْوَاغْفَرنْت-اَوم س يِيْسم نّس.<verse eid="1JN 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 2:13" />آ يبَابَاثن، نش ؤُرِيغ-اَوم-د ڒَاحقَّاش كنِّيو ثسّْنم ونِّي إِي يدْجَان زݣ ومزْوَارُو.</para>
  <para style="p" vid="1JN 2:13">آ يعْزْرِيْين، نش ؤُرِيغ-اَوم-د ڒَاحقَّاش كنِّيو ثْغڒْبم خ لْمُفْسِد نِّي.</para>
  <para style="p" vid="1JN 2:13">آ يحنْجِيرن، نش ؤُرِيغ-اَوم-د ڒَاحقَّاش كنِّيو ثسّْنم بَابَاثْنغ.<verse eid="1JN 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 2:14" />آ يبَابَاثن، نش ؤُرِيغ-اَوم-د ڒَاحقَّاش كنِّيو ثسّْنم ونِّي إِي يدْجَان زݣ ومزْوَارُو.</para>
  <para style="p" vid="1JN 2:14">آ يعْزْرِيْين، نش ؤُرِيغ-اَوم-د ڒَاحقَّاش كنِّيو ثْجهْذم، أَوَاڒ ن أَربِّـي يزدّغ ذَايْوم، كنِّيو ثْغڒْبم خ لْمُفْسِيد نِّي.<verse eid="1JN 2:14" /></para>
  <para style="s">وَار تخْسم شَا دُّنشْت-أَ</para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />وَار تخْسم شَا دُّنشْت-أَ نِغ ذ مِين ذَايس يدْجَان. ونِّي يتخْسن دُّنشْت-أَ اَتَاف ڒمْحِبّث ن أَربِّـي وَار ذَايس ثدْجِي شَا. <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />مِينْزِي مَارَّا مِين يدْجَان ذِي دُّنشْت-أَ يعْنِي مِين ثْرزُّو طَّبِيعَا ثَعفَّانْت ن بْنَاذم ذ مِين رزُّوْنْت ثِيطَّاوِين ذ تَّكبُّر إِي زِي تفْتَخَارن يِوْذَان قَا مَانَايَا وَار د يُوْسِي شَا زِي أَربِّـي، يُوْسَا-د زِي دُّنشْت-أَ. <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />دُّنشْت-أَ اَقَا ثْعدُّو-د اَكِذس شّهَاوَاث نّس، وَلَكِن ونِّي يتݣّن ڒْخَاضَر ن أَربِّـي اَذ يقِّيم يدَّر إِ ڒبْدَا ن ڒبْدَاث.<verse eid="1JN 2:17" /></para>
  <para style="s">أَقَانغ ذِي ثْسَاعَّات ثَنݣَّارُوْت</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />آ يحنْجِيرن، أَقَا ثْسَاعَّات-أَ ثَنݣَّارُوْت ثُوْوض-د. كنِّيو ثسْڒِيم دّجَّال نِّي يݣُّوْر-د، أَمنِّي عَاوذ اَطَّاس ن يِوْذَان إِي د يُوْسِين ڒخُّو ݣِّين اَم دّجَّال نِّي. س مَانَاينِّي إِي نسّن اَقَا ثْسَاعَّات ثَنݣَّارُوْت ثُوْوض-د. <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />فّْغن زَّايْنغ وَلَكِن تُوْغَا وَار دْجِين شَا زَّايْنغ. مَعْلِيك زَّايْنغ، أَتَاف قِّيمن اَكِذْنغ. نِثْنِي فّْغن بَاش اَد د يبَان بلِّي وَار دْجِين شَا زَّايْنغ.<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />كنِّيو لَّا، تْوَاذهْنم س وفُوْس ن لْعَظِيم، مَارَّا كنِّيو ثسّْنم مِين يدْجَان. <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />تَارِيغ-اَوم-د ڒَاحقَّاش ثسّْنم لْحَقِيقَا مَاشِي وَار ت ثسِّينم شَا. أُو عَاوذ وَار يدْجِي بُو شَان وخَرِّيق إِي د يُوْسِين زِي لْحَقِيقَا. <verse eid="1JN 2:21" /><verse number="22" style="v" sid="1JN 2:22" />مِين يعْنَا ونِّي إِي يسْخَرِّيقن إِلَّا ونِّي ينكَّرن بلِّي عِيْسَى ذ لْمَسِيح؟ نتَّا ذ دّجَّال يعْنِي ونِّي إِي ينكَّرن بَابَاثْنغ ذ مِّيس. <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />ونِّي غَا ينْكَرن مِّيس اَتَاف وَار غَارس يتِيڒِي شَا بَابَاس. ونِّي إِي غَا يقبْڒن مِّيس اَتَاف اَغَارس يِيڒِي بَابَاس.<verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />إِيوَا اَرّم-د ڒْبَاڒ نْوم بَاش اَذَايْوم يقِّيم مِين ثسْڒِيم زݣ ومزْوَارُو. مڒَا يقِّيم ذَايْوم اَوَاڒ نِّي إِي ثسْڒِيم زݣ ومزْوَارُو، أَتَاف ؤُڒَا ذ كنِّيو اَذ تقِّيمم ذِي مِّيس اَك أَربِّـي بَابَاس. <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />مِينْزِي ذَانغ يوْعذ؟ ئِوْعذ-اَنغ س ثُوْذَارْث ن ڒبْدَا ن ڒبْدَاث.<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />ؤُرِيغ-اَوم-د ثِمسْڒَايِين-أَ خ يِنِّي يرزُّوْن اَكنِّيو خذْعن. <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />كنِّيو، دّهْنث نِّي إِي زَّايس ثْقبْڒم عَاذ اَقَات ذَايْوم. كنِّيو وَار ثحْذِيجم حَدّ اَكنِّيو يسڒْمذ، أَقَا دّهْنث نّس ثْسڒْمَاذ-اَوم مَارَّا ثِمسْڒَايِين. نتَّاث ذ صَّح مَاشِي ذ اَخَرِّيق. إِيوَا مَامّش إِي كنِّيو ثْسڒْمَاذ دّهْنث-أَ، أَمنِّي يتْخصَّا اَذَايس ثْعِيشم ذِي نتَّا.<verse eid="1JN 2:27" /></para>
  <para style="s">أَ نْعِيش اَم ثَارْوَا ن سِيذِي أَربِّـي</para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />آ يحنْجِيرن، ڒخُّو عِيشث ذَايس حمَا اَغَارْنغ ثِيڒِي يجّن ن تِّقث وَار زَّايس نَروّڒ شَا س وسذْحِي خْمِي د غَا يَاس اَذَانغ د يمظْهَار.<verse eid="1JN 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1JN 2:29" />خْمِي غَا ثسّْنم بلِّي نتَّا نِيْشَان إِݣ يدْجَا، أَتَاف اَذَايْوم ثِيڒِي تِّقث بلِّي بْنَاذم إِݣ يسْخدَّامن مِين يدْجَان نِيْشَان نتَّا يخْڒق-د زَّايس.<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />خْزَرث مشْحَاڒ ذ ثَمقّْرَانْت ڒمْحِبّث إِي ذَانغ د يُوْشَا بَابَاثْنغ وَامِي نتْوَاسمَّا ذ ثَارْوَا ن أَربِّـي! أُو ذ صَّح اَمُّو إِي ندْجَا. دُّنشْت-أَ، مَايمِّي وَار ذَانغ ثسِّين شَا نشِّين؟ ڒَاحقَّاش ؤُڒَا ذ نتَّا وَار ث ثسِّين شَا. <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />آي يمْعِيزّن ينُو، ڒخُّو نشِّين ذ ثَارْوَا ن أَربِّـي. عَاذ وَار د تْمظْهَار شَا صِّيفث نّغ مَامش غَا ثِيڒِي، وَلَكِن نسّن اَذ تِيڒِي اَم نتَّا خْمِي د غَا يمظْهَار ڒَاحقَّاش اَث نْࢲر نتَّا مَامش إِي يدْجَا. <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />أُو مَارَّا ونِّي غَار يدْجَا لْأَمَال-أَ اَذ يسِّيصْفَا يخف نّس اَم مَامّش يدْجَا نتَّا يصْفَا.<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />مَارَّا ونِّي يقِّيمن يعصَّا نتَّا يتْرزَّا ڒُوْصِيَاث. وَاه، ڒْمُعْصِيّث نتَّاث ذ ثَرزِّيث ن ڒُوْصِيَاث. <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />أَقَا ثسّْنم بلِّي <char style="it">عِيْسَى لْمَسِيح</char> نتَّا يمظْهَار-د بَاش اَخَانغ يكّس ڒْمُعْصِيَاث. أُو ڒْمُعْصِيّث نتَّا وَار ذَايس ثدْجِي شَا. <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />ؤُڒَا ذ يجّن إِݣ يتْعِيشن ذَايس وَار يقِّيم شَا يسْخدَّام ڒْمُعْصِيَاث. ونِّي إِݣ يقِّيمن يسْخدَّام ڒْمُعْصِيَاث نتَّا وَار ث يࢲْرِي شَا وَار ث يسِّين شَا.<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />آ يحنْجِيرن، وَار تجَّام حَدّ اَكنِّيو يخْذع. ونِّي إِݣ يقِّيمن يسْخدَّام مِين يدْجَان نِيْشَان قَا نتَّا اَقَاث نِيْشَان مَامّش إِݣ يدْجَا <char style="it">سِيذِيثْنغ</char>. <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />ونِّي إِݣ يقِّيمن يسْخدَّام ڒْمُعْصِيَاث نتَّا زݣ إِبْڒِيس ڒَاحقَّاش إِبْڒِيس يقِّيم يعصَّا زݣ ومزْوَارُو. مَايمِّي د يمظْهَار مِّيس ن أَربِّـي؟ ئِمظْهَار-د بَاش اَذ يرز ڒفْعَايڒ ن إِبْڒِيس. <verse eid="1JN 3:8" /><verse number="9" style="v" sid="1JN 3:9" />ونِّي د يخڒْقن زِي أَربِّـي وَار يقِّيم شَا يسْخدَّام ڒْمُعْصِيَاث ڒَاحقَّاش ثَقُّوْشْت ن أَربِّـي ثْزدّغ ذَايس. وَار يزمَّر شَا اَذ يقِّيم ذِي ڒْمُعْصِيَاث ڒَاحقَّاش يخْڒق-د زِي أَربِّـي. <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />مَامّش غَا نݣّ أَ نسْفرق ثَارْوَا ن أَربِّـي ذ ثَارْوَا ن إِبْڒِيس؟ قَا يِنِّي وَار يقِّيمن شَا سْخدَّامن مِين يدْجَان نِيْشَان وَار دْجِين شَا زِي أَربِّـي. عَاوذ ونِّي وَار يتخْسن شَا ؤُمَاس <char style="it">وَار يدْجِي شَا زِي أَربِّـي</char>.<verse eid="1JN 3:10" /></para>
  <para style="s">وَا لَابُد أَ نخْس اَيَاوْيَا</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />ذ وَا ذ اَوَاڒ إِي تسْڒَام زݣ ومزْوَارُو يعْنِي يتْخصَّا وَا لَابُد أَ نْتخْس اَيَاوْيَا. <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />مَاشِي أَ نِيڒِي اَم قَبِيل يدْجَان زِي لْمُفْسِيد نِّي يرُوْح ينْغَا ؤُمَاس. مَايمِّي إِي ث ينْغَا؟ ڒَاحقَّاش ڒخْذَايم نّس نتَّا ذ ثِعفَّانِين، ڒخْذَايم ن وُوْمَاس ذ ثِصبْحَانِين. <verse eid="1JN 3:12" /><verse number="13" style="v" sid="1JN 3:13" />إِيوَا آ أَيثْمَا، وَار تْعجِّيبم شَا وَامِي دُّنشْت-أَ تْعِيفَّا-كنِّيو. <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />نشِّين نسّن بلِّي نࢲْوَا زِي ڒْموْث غَار ثُوْذَارْث ڒَاحقَّاش نْتخْس أَيثْمَاثْنغ. ونِّي وَار يتخْسن شَا عَاذ اَقَاث يتْعِيش ذِي ڒْموْث. <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />مَارَّا ونِّي إِݣ يتْعِيفَّان ؤُمَاس اَم ونِّي إِݣ ينقّن بْنَاذم. أَقَا كنِّيو ثسّْنم ونِّي إِݣ ينقّن بْنَاذم وَار ذَايس تِيڒِي شَا ثُوْذَارْث ن ڒبْدَا.<verse eid="1JN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 3:16" />س مِينْزِي إِي غَا نسّن ڒمْحِبّث؟ مِينْزِي سِيذِيثْنغ يصدّق خَانغ يخف نّس. أُو اَمُّو عَاوذ إِي غَا نِيڒِي نوْجذ أَ نْصدّق يخف نّغ خ أَيثْمَاثْنغ. <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />ونِّي غَار يدْجَا وَاݣْڒَا ن دُّنشْت-أَ يتْوَاڒَا ؤُمَاس وَار غَارس شَا يتحْذَاجَا أُوْشَا يسقْسح ؤُڒ نّس خَاس، مَامّش غَا ثِيڒِي ڒمْحِبّث ن أَربِّـي ذݣ وَانِيتَا؟ <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />آ يحنْجِيرن، مَاشِي أَ نْتخْس بْنَاذم س وَاوَاڒن ذ يِيڒس وَاهَا؛ لَّا، ئِتْخصَّا اَث نخْس س ڒخْذَايم ذ ڒْحَقّ. <verse eid="1JN 3:18" /><verse number="19" style="v" sid="1JN 3:19" />أَمنِّي إِي غَا نسّن بلِّي نشِّين زِي لْحَقِيقَا، أَمنِّي عَاوذ أَ نسْريّح ؤُڒَاون نّغ زَّاث إِ أَربِّـي. <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />مڒَا عَاقْبنْت-اَنغ لْأَفْكَار ن وُوْڒَاون نّغ اَتَاف مَعْلِيش، أَقَا أَربِّـي ذ اَمقّْرَان خ لْأَفْكَار ن وُوْڒَاون نّغ قَا يفهّم مَارَّا ثِمسْڒَايِين.<verse eid="1JN 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 3:21" />آي يمْعِيزّن ينُو، مڒَا وَار ذَانغ تْعَاقِيبن شَا وُوْڒَاون نّغ اَتَاف اَغَارْنغ ثِيڒِي يجّن ن زْعَامث زَّاث إِ أَربِّـي، <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />أَتَاف اَزَّايس نقْبڒ مَارَّا مِين ذَاس غَا نتَّار نشِّين ڒَاحقَّاش نتْطَاعَا ڒُوْصِيَاث نّس نْتݣّ مِينْخف يرطَّا نتَّا. <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />أَقَا ثَانِيتَا ذ ڒُوْصِيّث نّس أَ نَامن زݣ يِيْسم ن مِّيس عِيْسَى لْمَسِيح، أَ نْتخْس اَيَاوْيَا اَم مَامّش إِي ذَانغ د يوصَّا نتَّا. <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />ونِّي إِݣ يسْخدَّامن ڒُوْصِيَاث نّس اَتَاف اَذ يعِيش ذِي أَربِّـي، أَربِّـي يزدّغ ذَايس. مَامّش غَا نݣّ نشِّين أَ نسّن بلِّي يزدّغ ذَايْنغ؟ نسّن-يث س أَرُّوْح نِّي إِي ذَانغ د يُوْشَا.<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s">تَّعْلِيم ن صَّح ذ تَّعْلِيم ن يخَرِّيقن</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />آي يمْعِيزّن ينُو، وَار تِيقِّيم شَا ذِي مَارَّا اَرُّوْحَاث، جَرّْبم-ثن بَاش اَذ تسّْنم مَا زِي أَربِّـي مَا لَّا. قَا فّْغن-د اَطَّاس ن يثَرَّاسن غَار دُّنشْت-أَ تَارَّان يخف نْسن ذ لْأَنْبِيَا. <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />مَامّش غَا نݣّ أَ نسّن أَرُّوْح نِّي إِي د يتَاسن زِي أَربِّـي؟ كُڒ أَرُّوْح إِي د يتَاسن زَّايس أُو لَابُد اَذ يشْهذ بلِّي عِيْسَى لْمَسِيح نتَّا يُوْسَا-د س دَّات ن بْنَاذم. <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />أَرُّوْح نِّي وَار يشهّْذن شَا خ عِيْسَى اَتَاف وَار د يُوْسِي شَا زِي أَربِّـي. أَرُّوْح-أَ نتَّا ذ اَرُّوْح ن دّجَّال إِي خف ثسْڒِيم كنِّيو نتَّا يتَاس-د، ڒخُّو عَاوذ اَقَاث ذَا ذِي دُّنشْت-أَ.<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />كنِّيو آ يحنْجِيرن، زِي أَربِّـي إِي ثدْجَام. ئِثَرَّاسن-أَ ثْغڒْبم-ثن ڒَاحقَّاش ونِّي يدْجَان ذَايْوم يمْغَر خ ونِّي يدْجَان ذِي دُّنشْت-أَ. <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />نِثْنِي زِي دُّنشْت-أَ. فَالِيهَذَا سَّاوَاڒن س ڒَعْقُوْڒَاث نْسن ن دُّنشْت-أَ وَاهَا، ئِوْذَان ن دُّنشْت-أَ تْصنَّاطن-اَسن. <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />نشِّين زِي أَربِّـي إِي ندْجَا. ونِّي يسّْنن أَربِّـي يتْصنَّاط-اَنغ. ونِّي وَار يدْجِين شَا زِي أَربِّـي وَار ذَانغ يتْصنِّيط شَا. س مَانَايَا إِي غَا نسّن أَرُّوْح ن لْحَقِيقَا ذ اَرُّوْح ن يخَرِّيقن.<verse eid="1JN 4:6" /></para>
  <para style="s">ڒمْحِبّث ن أَربِّـي ذ ثنِّي جَار وَاوْمَاثن</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />آي يمْعِيزّن ينُو، أُو لَّابُد أَ نْتخْس اَيَوْيَا ڒَاحقَّاش ڒمْحِبّث تكَّا-د زِي أَربِّـي. ونِّي يتخْسن نتَّا يخْڒق-د زِي أَربِّـي يسّن أَربِّـي. <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />ونِّي وَار يتخْسن شَا وَار يسِّين شَا أَربِّـي ڒَاحقَّاش أَربِّـي ذ ڒمْحِبّث إِݣ يدْجَا. <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />أَمُّو إِي د ثْمظْهَار ڒمْحِبّث ن أَربِّـي جَارَانغ وَامِي د يسّكّ مِّيس اَوحْذَانِي غَار دُّنشْت-أَ حمَا اَزَّايس ندَّر. <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />س مَانَاينِّي مِينْزِي ذَاس قَّارن ڒمْحِبّث. مَاشِي ذ نشِّين إِي يخْسن أَربِّـي، ذ نتَّا إِي ذَانغ يخْسن وَامِي د يسّكّ مِّيس اَذ يِيڒِي ذ لْفِدْيَا خ ڒْمُعْصِيَاث نّغ. <verse eid="1JN 4:10" /><verse number="11" style="v" sid="1JN 4:11" />آي يمْعِيزّن ينُو، مڒَا اَنشْتُوْيَا إِي ذَانغ يخس أَربِّـي، ئِتْخصَّا ؤُڒَا ذ نشِّين أَ نخْس اَيَاوْيَا. <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />وَار ذِنِّي حَدّ عمَّارْص يࢲْرَا أَربِّـي. وَلَكِن نشِّين مڒَا نتْخس اَيَاوْيَا اَتَاف أَربِّـي يزدّغ ذَايْنغ، ڒمْحِبّث نّس ثجِّيون زَّايْنغ.<verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />مَامّش غَا نݣّ نشِّين أَ نسّن بلِّي نتْعِيش ذَايس، نتَّا يزدّغ ذَايْنغ؟ لِأَنَّا يُوْشَا-ٱنغ زِي أَرُّوْح نّس. <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />إِيوَا نشِّين نࢲْرَا نْشهّذ بلِّي بَابَاثْنغ يسّكّ-د مِّيس حمَا اَذ يسنْجم دُّنشْت-أَ. <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />ونِّي غَا يشهْذن عِيْسَى ذ مِّيس ن أَربِّـي، أَتَاف أَربِّـي يقِّيم ذَايس اَتَاف نتَّا يقِّيم ذِي أَربِّـي. <verse eid="1JN 4:15" /><verse number="16" style="v" sid="1JN 4:16" />أَمُّو إِي د نُوْوض أَ نسّن ڒمْحِبّث ن أَربِّـي أَ نَامن زِي ثنِّي إِي ذَانغ د يُوْشَا إِ نشِّين.</para>
  <para style="p" vid="1JN 4:16">أَربِّـي ذ ڒمْحِبّث إِݣ يدْجَا. ونِّي يقِّيمن ذِي ڒمْحِبّث نتَّا يقِّيم ذِي أَربِّـي، أَربِّـي يقِّيم ذَايس. <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />أَمُّو إِي ثجِّيون زَّايْنغ ڒمْحِبّث <char style="it">نّس</char> حمَا اَغَارْنغ ثِيڒِي يجّن ن زْعَامث ذِي يُوْم لْحِسَاب ذ لْعِقَاب. ڒَاحقَّاش ذِي دُّنشْت-أَ اَم عِيْسَى اَم نشِّين. <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />يعْنِي ڒمْحِبّث وَار ثسِّين شَا ثِيݣّْوْذِي. ڒمْحِبّث إِي يدْجَان ثكْمَاڒ اَذ تَازّڒ خ ثِيݣّْوْذِي، مَايمِّي؟ ڒَاحقَّاش ثِيݣّْوْذِي تَاس-د زِي ڒْخُف ن لْعِقَاب. ونِّي يتݣّْوْذن، نتَّا ڒمْحِبّث نّس عَاذ وَار زَّايس ثجِّيون شَا.<verse eid="1JN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19" />نشِّين نْتخْس مِينْزِي نتَّا يخس-اَنغ ذ اَمزْوَارُو. <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />ونِّي يقَّارن قَا نش تخْسغ أَربِّـي نتَّا يتْعِيفَّا ؤُمَاس، أَتَاف نتَّا ذ بُو-يخَرِّيقن وَاهَا إِݣ يدْجَا. مَايمِّي؟ ونِّي وَار يتخْسن شَا ؤُمَاس إِݣ يࢲرّ، أَتَاف وَار يزمَّر شَا اَذ يخس أَربِّـي إِي وَار يࢲرّ شَا. <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />إِيوَا اَقَا ڒُوْصِيّث إِي ذَانغ يجَّا <char style="it">لْمَسِيح</char> يعْنِي ونِّي يتخْسن أَربِّـي يتْخصَّا-ث اَذ يخس ؤُڒَا ذ ؤُمَاس.<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s">مِين يعْنَا ونِّي إِي غَا يغلّْبن خ دُّنشْت-أَ؟</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />مَارَّا ونِّي غَا يَامْنن عِيْسَى نتَّا ذ لْمَسِيح اَتَاف يخْڒق-د زِي أَربِّـي. أُو مَارَّا ونِّي يتخْسن بَابَاثْنغ اَتَاف نتَّا عَاوذ يتخْس ثَارْوَا نّس إِي زَّايس د يخڒْقن. <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />مَامّش غَا نݣّ نشِّين أَ نسّن إِلَّا نْتخْس ثَارْوَا ن أَربِّـي؟ نْتسّن-يث مڒَا نْتخْس أَربِّـي نتْطَاعَا-ٱسنْت إِ ڒُوْصِيَاث نّس. <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />لِأَنَّا ذ ثَا ذ ڒمْحِبّث ن أَربِّـي يعْنِي نتْطَاعَا إِ ڒُوْصِيَاث نّس. أُو ڒُوْصِيَاث-أَ نّس وَار خَانغ تذْقِيڒنْت شَا. <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />أَقَا مَارَّا ونِّي إِي د يخڒْقن زِي أَربِّـي اَذ يغْڒب خ دُّنشْت-أَ. ذ وَا ذ اَغْڒَاب إِي زِي نغْڒب خ دُّنشْت-أَ يعْنِي لْإِيمَان نّغ. <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />مِين يعْنَا ونِّي يغلّْبن خ دُّنشْت-أَ؟ ونِّي يغلّْبن ذ ونِّي يُوْمْنن إِلَّا عِيْسَى ذ مِّيس ن أَربِّـي.<verse eid="1JN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />عِيْسَى لْمَسِيح ذ وَانِيتَا إِي د يُوْسِين س وَامَان ذ يذَامّن. نتَّا مَاشِي يُوْسَا-د س وَامَان وَاهَا، يُوْسَا-د س وَامَان ذ يذَامّن. ونِّي يشهّْذن نتَّا ذ أَرُّوْح يقدّْسن مِينْزِي أَرُّوْح-أَ نتَّا ذ لْحَقِيقَا. <verse eid="1JN 5:6" /><verse number="7‏-8" style="v" sid="1JN 5:7-8" />أَقَا ذِنِّي ثْڒَاثَا إِݣ يشهّْذن، ثْڒَاثَا-يَا ذ أَرُّوْح ذ وَامَان ذ يذَامّن. ثْڒَاثَا-يَا ذ يجّن. <verse eid="1JN 5:7-8" /><verse number="9" style="v" sid="1JN 5:9" />مڒَا نقْبڒ شْهَاذث ن بْنَاذم قَا شْهَاذث ن أَربِّـي ثمْغَر كْتَار. لِأَنَّا نتَّاث ذ شْهَاذث-أَ، ثنِّي ن أَربِّـي إِݣ يشهّْذن خ مِّيس. <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />ونِّي غَا يَامْنن زِي مِّيس ن أَربِّـي اَتَاف اَغَارس ثِيڒِي شْهَاذث-أَ ذݣ وُوْڒ نّس. ونِّي وَار يُوْمِينن شَا <char style="it">زِي شْهَاذث-أَ ن</char> أَربِّـي اَتَاف اَث يَارّ ذ بُو-يخَرِّيقن وَاهَا ڒَاحقَّاش نتَّا وَار يُوْمِين شَا زِي شْهَاذث-أَ إِݣ يشْهذ عْلَاحْسَاب مِّيس. <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" />ذ ثَانِيتَا ذ شْهَاذث-أَ يعْنِي أَربِّـي يُوْشَا-ٱنغ-د ثُوْذَارْث ن ڒبْدَا، ثُوْذَارْث-أَ اَقَات ذِي مِّيس. <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />ونِّي غَار يدْجَا مِّيس اَتَاف غَارس ثُوْذَارْث. ونِّي وَار غَار يدْجِي بُو مِّيس ن أَربِّـي اَتَاف وَار غَارس بُو ثُوْذَارْث.<verse eid="1JN 5:12" /></para>
  <para style="s">لْخِتَام ن ثبْرَات-أَ</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />نش ؤُرِيغ-اَوم-د ثِمسْڒَايِين-أَ إِ كنِّيو إِي يُوْمْنن س يِيْسم ن مِّيس ن أَربِّـي حمَا اَذ تسّْنم إِلَّا غَارْوم ثُوْذَارْث ن ڒبْدَا ن ڒبْدَاث. <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />ذ ثَا ذ تِّقث إِي غَارْنغ ذَايس يعْنِي مڒَا نتَّار-اَس شَان ثْمسْڒَايْث عْلَاحْسَاب ڒْخَاضَر نّس اَتَاف نتَّا اَغَارْنغ يصنّط. <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />مڒَا نشِّين نسّن بلِّي يتْسْڒَا غَارْنغ قَاع ثِمسْڒَايِين نِّي إِي ذَاس نْتتَّار اَتَاف أَ نسّن بلِّي مِين ذَاس غَا نتَّار اَذَانغ ث يُوْش.<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />ونِّي غَا يتْوَاڒَان يجّن ن وُوْمَاس يعْصَا يجّن ڒْمُعْصِيّث إِي وَار يتِيوِين شَا غَار ڒْموْث، نتَّا يتْخصَّا-يَاس اَخَاس يࢲَّادْج غَار أَربِّـي اَتَاف اَذَاس يُوْش ثُوْذَارْث إِ وُوْمَاس نِّي. نِّيغ-اَوم-د مَانَايَا عْلَاحْسَاب يِنِّي ڒْمُعْصِيّث نْسن وَار ثن تِيوِي شَا غَار ڒْموْث. ذِنِّي يجّن ن ڒْمُعْصِيّث إِݣ يتَاوِين غَار ڒْموْث، ثنِّي وَار ذَاوم ت قَّارغ شَا اَخَاس ثࢲَّادْجم. <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />مَارَّا شَّرّْ نتَّا ذ ڒْمُعْصِيّث، وَلَكِن ذِنِّي ڒْمُعْصِيَاث وَار ذَانغ تِيوِينْت شَا غَار ڒْموْث.<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />نشِّين نسّن بلِّي مَارَّا ونِّي د يخڒْقن زِي أَربِّـي وَار يقِّيم شَا يسْخدَّام ڒْمُعْصِيَاث. مِّيس إِي د يخڒْقن زِي أَربِّـي يحطَّا-ث، وَار ث يتْضَرِّي شَا لْمُفْسِيد. <verse eid="1JN 5:18" /><verse number="19" style="v" sid="1JN 5:19" />نسّن إِلَّا نشِّين زِي أَربِّـي، نسّن عَاوذ مَارَّا دُّنشْت-أَ اَقَات سْوَادَّاي إِ ثْزمَّار ن لْمُفْسِيد. <verse eid="1JN 5:19" /><verse number="20" style="v" sid="1JN 5:20" />نسّن عَاوذ اَقَا مِّيس ن أَربِّـي يُوْسَا-د يُوْشَا-ٱنغ ڒفْهَامث بَاش أَ نسّن ونِّي يدْجَان ذ صَّح. نشِّين اَقَانغ ذݣ ونِّي يدْجَان ذ صَّح س مِّيس عِيْسَى لْمَسِيح. وَانِيتَا إِݣ يدْجَان ذ أَربِّـي ن صَّح ذ ثُوْذَارْث ن ڒبْدَا ن ڒبْدَاث.<verse eid="1JN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21" />آ يحنْجِيرن، حْضَام يخف نْوم زِي لْأَصْنَام.<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>