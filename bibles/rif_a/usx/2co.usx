<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2CO" style="id">- TarifitABS</book>
  <para style="h">2 أَيث-كورينث</para>
  <para style="toc3">2كور</para>
  <para style="toc2">22 أيث-كورينث</para>
  <para style="toc1">ثَبْرَات وِيس ثْنَاين ن اَرَّسُوْل بُوْلُس غَار أَيث-كُوْرِينْث</para>
  <para style="mt1">ثَبْرَات وِيس ثْنَاين ن اَرَّسُوْل بُوْلُس غَار أَيث-كُوْرِينْث</para>
  <chapter number="1" style="c" sid="2CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1" />
    <char style="it">ثَبْرَات-أَ زَّايِي نش</char> بُوْلُس إِݣ يدْجَان ذ اَرَّسُوْل ن عِيْسَى لْمَسِيح س ڒْخَاضَر ن أَربِّـي، أَكِذِي ؤُمَاثْنغ تِيْمُوْتَاوُس. تَارِيغ إِ جْمَاعث ن ڒْمُوْمِنِين ن أَربِّـي يِنِّي يدْجَان ذِي ثنْدِينْت ن كُوْرِينْث ذ مَارَّا ڒْمُوْمِنِين صَّالِحِين عَاوذ إِݣ يدْجَان ذِي لْإِقْلِيم ن ؤُخَايَا اَمن-ثكْمَاڒ. <verse eid="2CO 1:1" /><verse number="2" style="v" sid="2CO 1:2" />أَكِذْوم يِيڒِي اَرْضَا ذ ڒْهْنَا زِي أَربِّـي بَابَاثْنغ ذ عِيْسَى لْمَسِيح سِيذِيثْنغ.<verse eid="2CO 1:2" /></para>
  <para style="s">صّْبَر ذِي تَمَارَا</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3" />أَذ يتْوَابَرك أَربِّـي بَابَاس ن سِيذِيثْنغ عِيْسَى لْمَسِيح. نتَّا عَاوذ ذ بَابَاس ن اَرَّحْمث ذ نتَّا ذ أَربِّـي إِݣ يتْعَاوَان مَارَّا يوْذَان. <verse eid="2CO 1:3" /><verse number="4" style="v" sid="2CO 1:4" />ئِتْعَاوَان-اَنغ ذِي مَارَّا تَمَارَا نّغ حمَا نشِّين س ومْعَاوَان-أَ إِي زِي ذَانغ يتْعَاوَان أَربِّـي نْزمَّر أَ نْعَاون يِنِّي يدْجَان ذِي كُڒ تَمَارَا. <verse eid="2CO 1:4" /><verse number="5" style="v" sid="2CO 1:5" />لِأَنَّا مَامّش اَعدّب ن لْمَسِيح يتنْفيَّاض-د يتَاذَاف ذِي ثُوْذَارْث نّغ اَمنِّي عَاوذ س لْمَسِيح يتنْفيَّاض-د ومْعَاوَان نّغ. <verse eid="2CO 1:5" /><verse number="6" style="v" sid="2CO 1:6" />مڒَا نتْوَازيَّار نشِّين اَقَا مَانَاينِّي بَاش كنِّيو اَذ تْوَاعَاوْنم بَاش اَذ تْوَاسْنجّْمم. مڒَا نتْوَاعَاون نشِّين اَقَا مَانَاينِّي بَاش عَاوذ اَذ تْوَاعَاوْنم كنِّيو. أَقَا اَمْعَاوَان-أَ يتَارو-د ذَايْوم يجّن ن صْبَار خْمِي تْعدَّابم س مِين نتْعدَّاب نشِّين. <verse eid="2CO 1:6" /><verse number="7" style="v" sid="2CO 1:7" />لْأَمَال نّغ عْلَاحْسَاب كنِّيو يجْهذ. أَقَا نسّن مَامّش ثْشَرّْشم ذِي تَمَارَا نّغ، أَمنِّي عَاوذ نسّن اَذ تْشَرّْشم ذݣ ومْعَاوَان نّغ.<verse eid="2CO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8" />آي أَيثْمَا، نخْس اَذ تسّْنم تَمَارَا إِي خَانغ يكِّين ذِي لْإِقْلِيم ن آسْيَا. تُوْغَا نتْوَازيَّار اَطَّاس نشِّين، أَزيَّار نِّي تُوْغَاث كْتَار زِي جّهذ نّغ وَار نْزمَّر اَزَّايس نصْبَر حتَّا وَامِي نفْقذ لْأَمَال بَاش أَ ندَّر. <verse eid="2CO 1:8" /><verse number="9" style="v" sid="2CO 1:9" />وَاه، نْحسَّا ذݣ يِيخف نّغ بلِّي نتْوَاحْكَام س ڒْموْث. <char style="it">يوْقع مَانَاينِّي</char> بَاش وَار نتْعوِّيڒ شَا خ يِيخف نّغ، أَ نْعوّڒ خ أَربِّـي ونِّي إِي د يسْنكَّارن يِنِّي يمُّوْثن. <verse eid="2CO 1:9" /><verse number="10‏-11" style="v" sid="2CO 1:10-11" />ئِسنْجم-اَنغ-د زݣ يِجّن ن ڒْموْث ذ ثَعفَّانْت أُو نتَّا <char style="it">عَاذ</char> اَقَا يسنْجَام-اَنغ. نْتݣّ ذَايس لْأَمَال نّغ بلِّي عَاذ اَذَانغ يسنْجم وَامِي كنِّيو ذَانغ تْعَاوَانم س ثْࢲَادْجِيث نْوم. ثُمَّا اَطَّاس ن يِوْذَان اَذ سْݣَعّْذن صُّوْت نْسن غَار أَربِّـي اَث شكَّرن خ لْبَرَكَا نِّي إِي ذَانغ غَا يُوْش خْمِي إِي غَا ثسْتَاجب اَطَّاس ن ثْࢲَادْجِيث نْسن خَانغ.<verse eid="2CO 1:10-11" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس يئَجّل زِّيَارَا نّس غَار كُوْرِينْث</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12" />أَقَا نشِّين نْتفْتَخَر زِي ضَّمِير نّغ يعْنِي يشهّذ بلِّي نُوْيُوْر مْلِيح ذِي دُّنشْت-أَ خَصَّاتَن اَكِذْوم س يِجّن ن نِّيّث ذ وُوْڒ يصْفَان زِي أَربِّـي. وَار يدْجِي بُو س يِجّن ن ڒفْهَامث ن دُّنشْت-أَ؛ لَّا، س يِجّن ن اَرْضَا ن أَربِّـي. <verse eid="2CO 1:12" /><verse number="13‏-14" style="v" sid="2CO 1:13-14" />شُوْف، كُڒ ثَمسْڒَايْث إِي ذَاوم د نْتَارِي <char style="it">ذِي ثبْرَات-أَ</char> ثْزمَّرم اَت تْغَارم اَذَاس ثْفهْمم. أُو وَاخَّا وَار ذَانغ تفْهِيمم شَا ڒخُّو ذِي مَارَّا ثِمسْڒَايِين، نش تْمنِّيغ اَذَانغ ثْفهْمم مْلِيح بَاش اَزَّايْنغ تفْتَخَرم ذِي نْهَار نِّي ن سِيذِيثْنغ عِيْسَى مَامّش اَزَّايْوم نْتفْتَخَر نشِّين.<verse eid="2CO 1:13-14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15" />أُو س <char style="it">لْإِفْتِخَر-أَ</char> تُوْغَا رزُّوْغ ذ اَمزْوَارُو اَغَارْوم د ݣّغ يجّن ن زِّيَارَا حمَا اَذَاوم دُوْبْلِيغ لْبَرَاكَا. <verse eid="2CO 1:15" /><verse number="16" style="v" sid="2CO 1:16" />يعْنِي تُوْغَا رزُّوْغ اَخَاوم د كّغ خْمِي غَا رَاحغ غَار لْإِقْلِيم ن مَاسِدُوْنْيَا، منْبَعْد اَغَارْوم د عقْبغ زِي مَاسِدُوْنْيَا بَاش اَذَايِي ثْعَاوْنم اَذ سَفَرغ غَار ثْمُوْرْث ن يَهُوْذِيَا. <verse eid="2CO 1:16" /><verse number="17" style="v" sid="2CO 1:17" />وَامِي تُوْغَا نش تْخطَّاطغ اَذ ݣّغ مَانَاينِّي، مَا ذوّْڒغ ذݣ وَاوَاڒ وَاهَا؟ نِغ مَا تْخطَّاطغ اَم يِجّن ن بْنَاذم ن دُّنشْت-أَ وَاهَا، يعْنِي اَذ ينِيغ وَاه-وَاه نِغ لَّا-لَّا ذِي نّفْس ن ڒْوقْث؟<verse eid="2CO 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CO 1:18" />أَم أَربِّـي ذَايس تِّقث نتَّا، نشِّين عَاوذ قَا اَوَاڒ نّغ إِ كنِّيو وَار يدْجِي بُو ذ وَاه اَكذ لَّا. <verse eid="2CO 1:18" /><verse number="19" style="v" sid="2CO 1:19" />لِأَنَّا مِّيس ن أَربِّـي يعْنِي عِيْسَى لْمَسِيح نْبشَّر-يث جَارَاوم نش ؤُڒَا ذ سِيلَاس ؤُڒَا ذ تِيْمُوْتَاوُس. لْمَسِيح وَار يدْجِي بُو ذ وَاه اَكذ لَّا، نتَّا يدْجَا ڒبْدَا ذ &lt;وَاه&gt; أُو صَافِي. <verse eid="2CO 1:19" /><verse number="20" style="v" sid="2CO 1:20" />لِأَنَّا نتَّا ذَايس إِي يقَّار أَربِّـي &lt;وَاه&gt; إِ مَارَّا ثِمسْڒَايِين إِي يعَاهذ أَربِّـي. س مَانَايَا زِي عِيْسَى نقَّار &lt;آمِين&gt; إِ لْعَظَمَا ن أَربِّـي. <verse eid="2CO 1:20" /><verse number="21‏-22" style="v" sid="2CO 1:21-22" />أَربِّـي نتَّا إِي ذَانغ يسْبدّن مْلِيح اَكِذْوم ذِي لْمَسِيح. ئِخْضَر-اَنغ يضْبع-اَنغ س طَّبَاع نّس يُوْشَا-ٱنغ أَرُّوْح نّس يݣِّي-ث ذݣ وُوْڒَاون نّغ اَم يجّن ن تّسْبِق.<verse eid="2CO 1:21-22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23" />إِيوَا تتَّارغ إِ أَربِّـي اَذ يِيڒِي نتَّا ذ شَّاهذ ينُو قَا نش تُوْغَا رزُّوْغ اَخَاوم حِينّغ وَامِي ؤُݣِيغ اَغَارْوم د اَسغ غَار كُوْرِينْث. <verse eid="2CO 1:23" /><verse number="24" style="v" sid="2CO 1:24" />لِأَنَّا وَار يدْجِي بُو نتْحكّم خ لْإِيمَان نْوم؛ لَّا، نْخدّم اَكِذْوم بَاش اَذ تْفَرْحم. أَقَا س لْإِيمَان نْوم إِي ثْبدَّام نِيشَان.<verse eid="2CO 1:24" /></para>
  <chapter eid="2CO 1" />
  <chapter number="2" style="c" sid="2CO 2" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1" />شُوْف، ݣِّيغ ذِي ڒْبَاڒ ينُو وَار تݣّغ بُو شَا ن زِّيَارَا نّغْنِي بَاش وَار كنِّيو سْخيِّيقغ شَا. <verse eid="2CO 2:1" /><verse number="2" style="v" sid="2CO 2:2" />لِأَنَّا مڒَا سْخيَّاقغ-كنِّيو نش، وِي غَا يقِّيمن بَاش اَذَايِي يسْفَرح إِلَّا كنِّيو إِي سْخيَّاقغ نش؟ <verse eid="2CO 2:2" /><verse number="3" style="v" sid="2CO 2:3" />تُوْغَا ؤُرِيغ <char style="it">ثَبْرَات نِّي</char> بَاش وَار ذَايِي تسْخيَّاقم شَا، رزُّوْغ اَخْمِي د غَا اَسغ غَارْوم أُو لَابُد اَذَايِي ثسْفَرْحم. مڒَا فَرْحغ اَذ يڒِيغ نش متْأَكّد اَذ تْفَرْحم ؤُڒَا ذ كنِّيو. <verse eid="2CO 2:3" /><verse number="4" style="v" sid="2CO 2:4" />لِأَنَّا ؤُرِيغ-اَوم-ت-يد س يِجّن ن ؤُزِيَّار ذ يِجّن ن وخِيّق زݣ وُوْڒ ينُو ذ وَاطَّاس ن يمطَّاون. وَار يدْجِي بُو <char style="it">نِّيغ-اَوم-ت</char> حمَا اَكنِّيو سْخيّْقغ؛ لَّا، حمَا اَذ تسّْنم مشْحَاڒ ثمْغَار ڒمْحِبّث ينُو غَارْوم.<verse eid="2CO 2:4" /></para>
  <para style="s">سمْحم-اَس إِ ونِّي يعصَّان</para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5" />فَا مڒَا يجّن تُوْغَا يسْخيَّاق-يكنِّيو، وَار يدْجِي بُو ذ نش إِݣ يسْخيّق لَّا. يمْكن يسْخيّق-يكنِّيو مَارَّا نِغ ڒبْعَاض زَّايْوم (وَار خْسغ شَا اَذ سمْغَارغ لْقَضِيَا-يَا). <verse eid="2CO 2:5" /><verse number="6" style="v" sid="2CO 2:6" />بْنَاذم-أَ، لْعِقَاب نِّي إِي ذَاس ثݣِّيم تقْڒِيبَان مَارَّا إِذْوم، بَرَكَا خَاس. <verse eid="2CO 2:6" /><verse number="7" style="v" sid="2CO 2:7" />ڒخُّو اَذَاس ثْسمْحم عَاوْنم-ث بَاش وَار يغرّق شَا س وخيّق اَطَّاس. <verse eid="2CO 2:7" /><verse number="8" style="v" sid="2CO 2:8" />س مَانَايَا تتَّارغ زَّايْوم اَذَاس ثسْبيّْنم عَاوذ ڒمْحِبّث نْوم. <verse eid="2CO 2:8" /><verse number="9" style="v" sid="2CO 2:9" />ؤُرِيغ-اَوم-د مَانَاينِّي بَاش اَكنِّيو جّرْبغ اَذ سّْنغ مَا تْطَاعَام ذِي مَارَّا مَا لَّا. <verse eid="2CO 2:9" /><verse number="10" style="v" sid="2CO 2:10" />ونِّي ؤُمِي غَا ثْسمْحم ؤُڒَا ذ نش اَذَاس سمْحغ. مڒَا ذِنِّي شَان ڒْحَاجث اَذَاس سمْحغ، قَا سمْحغ-اَس-ت. سمْحغ-اَس عْلَاحْسَاب كنِّيو، ئِشْهذ خَاس لْمَسِيح. <verse eid="2CO 2:10" /><verse number="11" style="v" sid="2CO 2:11" />مَانَايَا حمَا شِّيطَان وَار ذَانغ يخدّع شَا، أَقَا وَار نْغفّڒ شَا خ مِين يتْشِيطِين نتَّا.<verse eid="2CO 2:11" /></para>
  <para style="s">أَ نرْبح س لْمَسِيح</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12" />فَا وَامِي د ؤُوْضغ غَار ثنْدِينْت ن تْرَاوْس بَاش اَذ بشَّرغ س لْإِنْجِيل ن لْمَسِيح، ؤُفِيغ ثْنُوْرْزم-اَيِي-د يجّن ن ثوَّارْث ن سِيذِيثْنغ. <verse eid="2CO 2:12" /><verse number="13" style="v" sid="2CO 2:13" />وَلَكِن ؤُڒ ينُو وَار يدْجِي شَا مرْتَاح وَامِي وَار ؤُفِيغ شَا ذِنِّي ؤُمَا تِيتُوْس، مْصَافَاضغ خَاسن ؤُيُوْرغ غَار مَاسِدُوْنْيَا.<verse eid="2CO 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 2:14" />وَلَكِن أَ نحْمذ أَربِّـي. نتَّا ڒبْدَا يسُوْݣُّوْر-اَنغ ذݣ وبْرِيذ ن اَرْبَاح س لْمَسِيح أُو زَّايْنغ نشِّين يتنْتَاشَار ڒفْوَاح ن ثُوْسْنَا <char style="it">خ لْمَسِيح</char>. <verse eid="2CO 2:14" /><verse number="15" style="v" sid="2CO 2:15" />لِأَنَّا نشِّين ذ يجّن ن ڒفْوَاح ن لْمَسِيح غَار أَربِّـي جَار ن يِنِّي ينجّْمن ذ يِنِّي يفنَّان. <verse eid="2CO 2:15" /><verse number="16" style="v" sid="2CO 2:16" />نشِّين اَم شُّوْم ن ڒْموْث غَار يِنِّي يفنَّان، ذ شُّوْم ن ثُوْذَارْث غَار يِنِّي ينجّْمن. إِيوَا وَار ذِنِّي حَدّ إِي غَا يزمَّرن إِ ڒْخذْمث-أَ! <verse eid="2CO 2:16" /><verse number="17" style="v" sid="2CO 2:17" />أَقَا نشِّين مَاشِي اَم خَربِّي ن يِوْذَان يتݣّن تِّجَارَا ذݣ وَاوَاڒ ن أَربِّـي، نشِّين ذِي لْمَسِيح نسَّاوَاڒ س وُوْڒ يصْفَا زِي أَربِّـي أُو زَّاث إِ أَربِّـي.<verse eid="2CO 2:17" /></para>
  <chapter eid="2CO 2" />
  <chapter number="3" style="c" sid="2CO 3" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1" />نشِّين، مَا نبْذَا أَ نْشكَّر يخف نّغ عَاوذ زَعْمَا بَاش اَذَاوم نْقدّم يخف نّغ؟ مَا نشِّين اَم شَا ن يثَرَّاسن غَا يحْذَاجن ثِبْرَاثِين بَاش اَخَانغ شهّْذنْت، يعْنِي <char style="it">ثِبْرَاثِين نِّي اَذ د اَسنْت</char> زَّايْوم نِغ اَغَارْوم <char style="it">د اَسنْت</char>؟ <verse eid="2CO 3:1" /><verse number="2" style="v" sid="2CO 3:2" />لَّا، كنِّيو س يِيخف نْوم ذ ثَبْرَات نّغ يعْنِي ثْشهّْذم خَانغ. ثَبْرَات-أَ ثُوْرَا ݣ وُوْڒَاون نّغ، سّْنن-تث قَّارن-تث مَارَّا يِوْذَان. <verse eid="2CO 3:2" /><verse number="3" style="v" sid="2CO 3:3" />ثْبَانم-د بلِّي كنِّيو اَم يِجّن ن ثبْرَات زِي لْمَسِيح، نسِّيوض-يت نشِّين. وَار ثُوْرِي شَا س سْمخ،<note caller="+" style="f"><char style="fr" closed="false">3‏.3 </char><char style="ft" closed="false">سْمخ نتَّا ذ لمْدَاد نِغ ذ ڒْمِدَاد.</char></note> <char style="it">ثُوْرَا</char> س أَرُّوْح ن أَربِّـي يدَّرن. وَار <char style="it">ثنْقِيش</char> شَا ذِي ثڒْوِيحِين ن وزْرُو، <char style="it">ثنْقش</char> ذِي ثڒْوِيحِين ن وُوْڒ ن بْنَاذم.<verse eid="2CO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 3:4" />مَانَايَا نقَّار-يث س تِّقث إِي غَارْنغ ذِي أَربِّـي س لْمَسِيح. <verse eid="2CO 3:4" /><verse number="5" style="v" sid="2CO 3:5" />يعْنِي مَارَّا مَانَايَا وَار ذَاس نْزمَّر شَا نشِّين س يِيخف نّغ. وَار نتْحسِّيب شَا بلِّي ثِزمَّار-أَ تَاسنْت-يد زَّايْنغ؛ لَّا، تَاسنْت-يد زِي أَربِّـي. <verse eid="2CO 3:5" /><verse number="6" style="v" sid="2CO 3:6" />ذ نتَّا إِي ذَانغ يُوْشِين ثِزمَّار-أَ بَاش أَ نِيڒِي ذ يخدَّامن ن يِجّن ن ڒْعَهذ ذ جْذِيذ. ڒْعَهذ-أَ مَاشِي س شَّرِيعَا؛ لَّا، ڒْعَهذ-أَ س أَرُّوْح ن أَربِّـي. لِأَنَّا شَّرِيعَا ثْنقّ، أَرُّوْح ن أَربِّـي نتَّا يسدَّر.<verse eid="2CO 3:6" /></para>
  <para style="s">لْعَظَمَا ن ڒْعَهذ ذ جْذِيذ</para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7" />فَا شَّرِيعَا نِّي ن ڒْموْث، ثِيرَا نّس نقْشنْت ذِي ثڒْوِيحِين ن وزْرُو. شَّرِيعَا نِّي ثُوْسَا-د س يِجّن ن لْعَظَمَا ذ ثَمقّْرَانْت، أَتَاف أَيث-إِسْرَائِيل وَار زمَّرن اَذ قِّيمن خزَّرن ذݣ وغمْبُوْب ن مُوْسَى س لْعَظَمَا نِّي إِي ذَايس يتْشعْشِيْعن وَاخَّا تِيڒِي تْرَاح-اَس لْعَظَمَا نِّي. <verse eid="2CO 3:7" /><verse number="8" style="v" sid="2CO 3:8" />ڒخُّو ڒْعَهذ رُوْحِيَا، لْعَظَمَا نّس كْتَار اَطَّاس زِي شَّرِيعَا نِّي! <verse eid="2CO 3:8" /><verse number="9" style="v" sid="2CO 3:9" />مڒَا غَارس لْعَظَمَا غَار شَّرِيعَا نِّي إِي تُوْغَا د يتَاوِين لْحِسَاب ذ لْعِقَاب، أَتَاف ڒْعَهذ-أَ إِي د يتَاوِين صُّلْح مشْحَاڒ ثمْغَر لْعَظَمَا نّس كْتَار زِي ثنِّي نّغْنِي. <verse eid="2CO 3:9" /><verse number="10" style="v" sid="2CO 3:10" />ذ صَّح شَّرِيعَا نِّي إِي تُوْغَا غَار ثدْجَا لْعَظَمَا، ڒخُّو وَار غَارس ثقِّيم بُو لْعَظَمَا يعْنِي اَك لْعَظَمَا-يَا ثَمقّْرَانْت اَطَّاس إِي غَارس غَار <char style="it">ڒْعَهذ نِّي رُوْحِيَا</char>. <verse eid="2CO 3:10" /><verse number="11" style="v" sid="2CO 3:11" />شُوْف، مِين يتْوَاتكّْسن <char style="it">يعْنِي شَّرِيعَا نِّي</char>، مڒَا ثُوْسَا-د س يِجّن ن لْعَظَمَا، وَا لَابُد لْعَظَمَا-يَا <char style="it">ن ڒْعَهذ</char> يتْدُوْمَان اَذ تِيڒِي كْتَار اَطَّاس زِي ثن نّغْنِي!<verse eid="2CO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 3:12" />إِذن، مڒَا غَارْنغ يجّن ن لْأَمَال اَم وَانِيتَا اَتَاف غَارْنغ يجّن ن زْعَامث. <verse eid="2CO 3:12" /><verse number="13" style="v" sid="2CO 3:13" />وَار ندْجِي شَا اَم مُوْسَى يغمّس إِ وغمْبُوْب نّس س يِجّن ن لْتَام<note caller="+" style="f"><char style="fr" closed="false">3‏.13 </char><char style="ft" closed="false">لْتَام نتَّا ذ يجّن ن طَّارْف ن ثْشُوْقّت تݣّن-تث خ وغمْبُوْب يتِيڒِي زِي ثِيطَّاوِين اَڒ وَادَّاي.</char></note> بَاش وَار تْغِيمِين شَا أَيث-إِسْرَائِيل تْخزَّرن ذَايس خْمِي اَتَاف يتْرَاح-اَس وشعْشع نِّي. <verse eid="2CO 3:13" /><verse number="14" style="v" sid="2CO 3:14" />نِثْنِي ڒَعْقُوْڒَاث نْسن تْوَاقْسْحن وَار فهّْمن شَا. أَڒ نْهَارَا خْمِي غَا غَرن ذِي ڒْعَهذ نِّي اَقْذِيم تَافن لْتَام نِّي عَاذ ذَايس. لْتَام نِّي وَار يتْوَاكّس شَا، غِير س لْمَسِيح إِي غَا يتْوَاكّس. <verse eid="2CO 3:14" /><verse number="15" style="v" sid="2CO 3:15" />وَاه، أَڒ نْهَارَا خْمِي غَا غَرن أَيثْ-إِسْرَائِيل ذِي لْكِتَاب ن مُوْسَى اَتَاف ؤُڒَاون نْسن غمّْسن س يِجّن ن لْتَام. <verse eid="2CO 3:15" /><verse number="16" style="v" sid="2CO 3:16" />وَلَكِن خْمِي غَا يَامن شَان يِجّن زِي سِيذِيثْنغ، اَذَاس يتْوَاكّس لْتَام نِّي. <verse eid="2CO 3:16" /><verse number="17" style="v" sid="2CO 3:17" />شُوْف، سِيذِيثْنغ نتَّا ذ أَرُّوْح، مَانِي مَا يدْجَا أَرُّوْح ن سِيذِيثْنغ ذِنِّي لْحُرِّيَا <char style="it">رُوْحِيَا</char>. <verse eid="2CO 3:17" /><verse number="18" style="v" sid="2CO 3:18" />ڒخُّو نشِّين اَغمْبُوْب نّغ وَار يغْمِيس س وَالُو. نتْوَاڒَا لْعَظَمَا ن سِيذِيثْنغ، نتْوَابدَّاڒ بَاش أَ نِيڒِي ذ يجّن ن صِّفث نّس س يِجّن ن لْعَظَمَا يتْمَارْنِين. مَانَايَا يتَاس-د زِي سِيذِيثْنغ إِݣ يدْجَان ذ أَرُّوْح.<verse eid="2CO 3:18" /></para>
  <chapter eid="2CO 3" />
  <chapter number="4" style="c" sid="2CO 4" />
  <para style="s">لْإِنْجِيل نُّوْر نّس يتْشعْشِيع ذِي ثَادْجسْت</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1" />س مَانَايَا، وَار نْتفْشِيڒ شَا مِنْزِي غَارْنغ ڒْعَهذ-أَ وَانِيتَا س اَرَّحْمث ن أَربِّـي. <verse eid="2CO 4:1" /><verse number="2" style="v" sid="2CO 4:2" />نشِّين نتْبعَّاعذ خ ثْمسْڒَايِين ن ڒفْضِيحث إِݣ يتْوَاخدّْمن س ثْنُوْفْرَا. وَار نسْخدِّيم شَا ثَحْرَايْمِيث، وَار نتْحرِّيف شَا اَوَاڒ ن أَربِّـي. نشِّين زَّاث إِ أَربِّـي نْسڒْمَاذ لْحَقِيقَا بْڒَا مَا اَت نسْنُوْفَّر. أَمُّو غَارْسن مَارَّا يوْذَان ذِي ضَّمِير نْسن بلِّي ذَايْنغ تِّقث. <verse eid="2CO 4:2" /><verse number="3" style="v" sid="2CO 4:3" />لْإِنْجِيل نّغ مڒَا يغمّس س يِجّن ن لْتَام،<note caller="+" style="f"><char style="fr" closed="false">4‏.3 </char><char style="ft" closed="false">لْتَام نتَّا ذ يجّن ن طَّارْف ن ثْشُوْقّت تݣّن-تث خ وغمْبُوْب يتِيڒِي زِي ثِيطَّاوِين اَڒ وَادَّاي.</char></note> ئِغمّس غِير إِ يِنِّي يفنَّان. <verse eid="2CO 4:3" /><verse number="4" style="v" sid="2CO 4:4" />يِنِّي وَار يُوْمِينن شَا ڒَعْقُوْڒَاث نْسن يسْطمّص-يثن <char style="it">إِبْڒِيس ونِّي يدْجَان اَم</char> أَربِّـي ن دُّنشْت-أَ زَعْمَا. نِثْنِي وَار زمَّرن اَذ ࢲرن نُّوْر ن لْإِنْجِيل يعْنِي لْعَظَمَا ن لْمَسِيح، نتَّا يدْجَان ذ صِّفث ن أَربِّـي. <verse eid="2CO 4:4" /><verse number="5" style="v" sid="2CO 4:5" />وَار نتْبشِّير شَا س يِيخف نّغ، نتْبشَّار س عِيْسَى لْمَسِيح يعْنِي نتَّا ذ سِيذِيثْنغ. أُو نشِّين ذ يخدَّامن نْوم عْلَاحْسَاب عِيْسَى. <verse eid="2CO 4:5" /><verse number="6" style="v" sid="2CO 4:6" />ذ أَربِّـي إِݣ ينَّان: "نُّوْر اَذ يشعْشع زِي ثَادْجسْت." ذ أَربِّـي-يَا إِݣ يشعْشْعن ذݣ وُوْڒَاون نّغ بَاش أَ نسّن لْعَظَمَا ن أَربِّـي إِݣ يتْشعْشِيعن ذݣ وُوْذم ن عِيْسَى لْمَسِيح.<verse eid="2CO 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 4:7" />فَا ڒْكنْز-أَ وَانِيتَا اَقَاث غَارْنغ ذݣ يغرَّافن ن وشَاڒ <char style="it">يعْنِي ذِي دَّات نّغ،</char> بَاش اَذ د يمظْهَار بلِّي جّْهذ-أَ اَمقّْرَان اَطَّاس يتَاس-د زِي أَربِّـي مَاشِي زَّايْنغ. <verse eid="2CO 4:7" /><verse number="8" style="v" sid="2CO 4:8" />نشِّين نتْوَازيَّار زِي مْكُڒ جِّهث، وَلَكِن وَار نتْوَاحسّڒ شَا. وَار نسِّين شَا مَانِي غَا نَارّ س وزدْجِيف، وَلَكِن وَار نْتفْشِيڒ شَا. <verse eid="2CO 4:8" /><verse number="9" style="v" sid="2CO 4:9" />نتْوَاعدَّاب، وَلَكِن وَار نقِّيم شَا وَاحذْنغ. نتْوَاغْضڒ، وَلَكِن وَار نرِّيز شَا. <verse eid="2CO 4:9" /><verse number="10" style="v" sid="2CO 4:10" />ڒبْدَا نَربُّو ذِي دَّات نّغ ڒْموْث ن عِيْسَى بَاش اَذ د تْمظْهَار ؤُڒَا ذ ثُوْذَارْث ن عِيْسَى ذِي دَّات نّغ. <verse eid="2CO 4:10" /><verse number="11" style="v" sid="2CO 4:11" />لِأَنَّا نشِّين إِݣ يدَّرن نتْوَاسلَّام ڒبْدَا غَار ڒْموْث عْلَاحْسَاب عِيْسَى حمَا ثُوْذَارْث ن عِيْسَى اَذ د تْمظْهَار ذِي دَّات نّغ يتْمتَّان. <verse eid="2CO 4:11" /><verse number="12" style="v" sid="2CO 4:12" />خ مَانَايَا خْمِي نشِّين نتْوَاجَاه ڒْموْث، كنِّيو تِيڒِي ذَايْوم ثُوْذَارْث.<verse eid="2CO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 4:13" />ئِقَّار يِجّن ذِي لْكِتَاب: "ؤُمْنغ، س مَانَايَا سِّيوْڒغ." نّفْس لْإِيمَان-أَ يدْجَان ذَايْنغ، زَّايس إِي نْتَامن زَّايس إِي نسَّاوَاڒ. <verse eid="2CO 4:13" /><verse number="14" style="v" sid="2CO 4:14" />نسّن ونِّي إِي د يسكَّرن سِيذِيثْنغ عِيْسَى نتَّا عَاوذ اَذَانغ د يسكَّر اَك عِيْسَى اَذَانغ يسحْضَار اَكِذْوم زَّاث نّس. <verse eid="2CO 4:14" /><verse number="15" style="v" sid="2CO 4:15" />شُوْف، مَانَايَا يوْقع مَارَّا بَاش اَكنِّيو ينْفع. خْمِي يتنْتَاشَار اَرْضَا غَار يِوْذَان اَطَّاس س وَاطَّاس يعْنِي اَرْضَا-يَا اَذ د يسْفيّض شُّكر إِ لْعَظَمَا ن أَربِّـي.<verse eid="2CO 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 4:16" />خ مَانَايَا نشِّين وَار نْتفْشِيڒ شَا. وَاخَّا طَّبِيعَا ن دَّات نّغ غَار بَارَّا تْرَاح، طَّبِيعَا نّغ غَار ذَاخڒ تجْهِيذ نْهَار خ نْهَار. <verse eid="2CO 4:16" /><verse number="17" style="v" sid="2CO 4:17" />شُوْف، ڒمْحَاين نّغ فْسُوْسنْت تْرَاحنْت تَاسنْت-يد ذغْيَا، سوْجَاذنْت-اَنغ غَار يِجّن ن لْعَظَمَا ذ ثَمقّْرَانْت بْڒَا ڒقْيَاس. <verse eid="2CO 4:17" /><verse number="18" style="v" sid="2CO 4:18" />وَار نسْرُوْسِي شَا ثِيطَّاوِين نّغ ذِي مِن نتْوَاڒَا، نْسْرُوْسَا-ثنْت ذِي مِن وَار نتْوِيڒِي شَا. لِأَنَّا مِن نتْوَاڒَا ذغْيَا يتْرَاح، مِن وَار نتْوِيڒِي شَا ذ ونِّي إِݣ يتْدُوْمَان إِ ڒبْدَا.<verse eid="2CO 4:18" /></para>
  <chapter eid="2CO 4" />
  <chapter number="5" style="c" sid="2CO 5" />
  <para style="s">أَمْشَان نّغ ذݣ وجنَّا</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1" />شُوْف، نشِّين نسّن مڒَا يرز وقِيضُوْن-أَ <char style="it">يعْنِي دَّات نّغ</char> ن دُّنشْت-أَ، أَتَاف غَارْنغ يجّن ن ثْزدِّيغْث نّغْنِي زِي أَربِّـي. ثَدَّارْث نِّي وَار يبْنِين شَا س يفَاسّن تْدُوْمَا إِ ڒبْدَا. <verse eid="2CO 5:1" /><verse number="2" style="v" sid="2CO 5:2" />ڒخُّو نشِّين نْنهّك ذَايْنغ مزْڒِي أَ نغْمس س دَّات نّغ ن وجنَّا. <verse eid="2CO 5:2" /><verse number="3" style="v" sid="2CO 5:3" />خْمِي غَا نغْمس زَّايس، أَتَاف وَار ذَانغ تِيفن شَا ذ يعَرْيَانن. <verse eid="2CO 5:3" /><verse number="4" style="v" sid="2CO 5:4" />لِأَنَّا خْمِي نتْغمَّاس س دَّات-أَ نّغ، تْبسَّاڒ خَانغ نشِّين عَاذ نْنهّك. إِيوَا وَار نْرزُّو شَا أَ نِيڒِي بْڒَا اَرُّوْض، نْرزُّو أَ نغْمس <char style="it">س دَّات نّغ ن وجنَّا</char>، مَايمِّي؟ بَاش مِين يفنَّان اَث يسغْڒي مِين وَار يتْمتِّين. <verse eid="2CO 5:4" /><verse number="5" style="v" sid="2CO 5:5" />وِي ذَانغ يسْوجْذن إِ مَانَاينِّي؟ نتَّا ذ أَربِّـي، يُوْشَا-ٱنغ-د أَرُّوْح نّس ذ يجّن ن تّسْبِق.<verse eid="2CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 5:6" />إِذن عمَّارص أَ نفْشڒ نشِّين. نسّن مڒَا عَاذ اَقَانغ ذِي دَّات-أَ ن دُّنشْت-أَ نْتَاݣّْوَاج زِي سِيذِيثْنغ. <verse eid="2CO 5:6" /><verse number="7" style="v" sid="2CO 5:7" />أَقَا نتْعِيش س لْإِيمَان مَاشِي س مِين نتْوَاڒَا. <verse eid="2CO 5:7" /><verse number="8" style="v" sid="2CO 5:8" />وَار نْتفْشِيڒ شَا، لَّا! مَعْلِيش نشِّين مڒَا نْتَاݣّْوَاج زِي دَّات-أَ <char style="it">ن دُّنشْت-أَ</char> اَتَاف نشِّين نتْعِيش اَك سِيذِيثْنغ. <verse eid="2CO 5:8" /><verse number="9" style="v" sid="2CO 5:9" />خ مَانَاينِّي مِيخف نْرزُّو؟ نْرزُّو اَخَاس نَارْضَا وَاخَّا نْزدّغ ذِي دَّات-أَ ن دُّنشْت-أَ نِغ نْتَاݣّْوَاج زَّايس. <verse eid="2CO 5:9" /><verse number="10" style="v" sid="2CO 5:10" />لِأَنَّا لَابُد أَ نْبدّ مَارَّا إِذْنغ زَّاث إِ لْعَرْش ن لْمَسِيح مَانِي إِي غَا نتْوَاحْكم. كُڒ يجّن اَث يجَازَا خ مِين يسْذَاهدْج عْلَاحْسَاب ثِمسْڒَايِين نِّي إِݣ يݣَّا وَامِي يزْذغ ذِي دَّات، ذ ثِصبْحَانِين نِغ ذ ثِعفَّانِين. <verse eid="2CO 5:10" /><verse number="11" style="v" sid="2CO 5:11" />فَلِهَاذَا وَامِي نسّن أَ نݣّْوذ زِي سِيذِيثْنغ، نْرزُّو يوْذَان اَذ قْتَنْعن.</para>
  <para style="s" vid="2CO 5:11">ڒْعَهذ ن صُّلْح</para>
  <para style="p" vid="2CO 5:11">ئِي مِين نعْنَا نشِّين يسّن-يث أَربِّـي مْلِيح، أُو تْمنِّيغ عَاوذ ضَّمِير نْوم اَذ يسّن مَانَاينِّي. <verse eid="2CO 5:11" /><verse number="12" style="v" sid="2CO 5:12" />مَا نبْذَا أَ نْشكَّر يخف نّغ عَاوذ زَعْمَا؟ لَّا، نْتِيشّ-اَوم مِينْزِي خَانغ غَا تفْتَخَرم. مَايمِّي؟ يعْنِي حمَا اَغَارْوم يِيڒِي مِينْزِي غَا ثَارّم خ يِنِّي يتفْتَخَرن خ مِين د يتْبَانن غَار بَارَّا مَاشِي مِين يدْجَان غَار ذَاخڒ ذݣ وُوْڒ.<verse eid="2CO 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 5:13" />شُوْف، مڒَا يرُوْح-اَنغ ڒَعْقڒ زَعْمَا، مَانَايَا جَارَانغ ذ أَربِّـي. مڒَا غَارْنغ ڒَعْقڒ، أَتَاف مَانَايَا مْلِيح إِ كنِّيو. <verse eid="2CO 5:13" /><verse number="14" style="v" sid="2CO 5:14" />لِأَنَّا ڒمْحِبّث ن لْمَسِيح تْسَيْطَر خَانغ وَامِي نسّن يجّن يمُّوْث عْلَاحْسَاب مَارَّا يوْذَان. فَلِهَاذَا ڒْموْث نّس ذ ڒْموْث ن مَارَّا يوْذَان. <verse eid="2CO 5:14" /><verse number="15" style="v" sid="2CO 5:15" />يمُّوْث نتَّا عْلَاحْسَاب مَارَّا يوْذَان بَاش يِنِّي يدَّرن وَار تدَّرن شَا إِ يِيخف نْسن وَاهَا، أَذ دَّرن إِ ونِّي خَاسن يمُّوْثن ثُمَّا يتْوَاسكَّر-د زِي ڒْموْث.<verse eid="2CO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 5:16" />خ مَانَاينِّي، زِي سَّا اَڒ ثْسَاونْت نشِّين وَار نْخزَّر شَا ذِي حَدّ عْلَاحْسَاب ڒَعْقڒ ن دُّنشْت-أَ. وَاخَّا نْخزَّر قْبڒ ذِي لْمَسِيح عْلَاحْسَاب ڒَعْقڒ ن دُّنشْت-أَ، ڒخُّو وَار ث نتْوِيڒِي شَا اَمنِّي. <verse eid="2CO 5:16" /><verse number="17" style="v" sid="2CO 5:17" />س مَانَايَا، ونِّي يدْجَان ذِي لْمَسِيح اَقَا يتْوَاخْڒق-د ذ جْذِيذ؛ مِين يدْجَان ذ اَقْذِيم يعْذُو يُوْسَا-د مِين يدْجَان ذ جْذِيذ. <verse eid="2CO 5:17" /><verse number="18" style="v" sid="2CO 5:18" />مَانَايَا مَارَّا زِي أَربِّـي، يسمْصْڒَاح-اَنغ اَكِذس س لْمَسِيح يُوْشَا-ٱنغ-د أَ نْبشَّر س ڒْعَهذ ن صُّلْح. <verse eid="2CO 5:18" /><verse number="19" style="v" sid="2CO 5:19" />يعْنِي أَربِّـي يݣَّا ذِي لْمَسِيح بَاش اَذ يسمْصْڒَاح يوْذَان اَكِذس، وَار خَاسن يحسّب شَا ڒْمُعْصِيَاث نْسن. عَاوذ أَربِّـي يكلّف خَانغ اَوَاڒ-أَ وَانِيتَا ن صُّلْح. <verse eid="2CO 5:19" /><verse number="20" style="v" sid="2CO 5:20" />فَلِهَاذَا نشِّين ذ لْمُبْشِرِين ن لْمَسِيح، أَربِّـي يسّكّ طَّلَاب نّس خ وفُوْس نّغ. نْطَلَاب-يكنِّيو عْلَاحْسَاب لْمَسِيح اَذ تمْصْڒَاحم اَك أَربِّـي. <verse eid="2CO 5:20" /><verse number="21" style="v" sid="2CO 5:21" />تُوْغَا وَانِيتَا وَار غَارس بُو ڒْمُعْصِيّث يَارِّي-ث أَربِّـي ذ ڒْعِيذ نّغ حمَا اَذَانغ يَارّ نِيشَان اَك أَربِّـي.<verse eid="2CO 5:21" /></para>
  <chapter eid="2CO 5" />
  <chapter number="6" style="c" sid="2CO 6" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1" />فَا نشِّين إِݣ يخدّْمن اَك أَربِّـي نْتتَّار إِ كنِّيو نقَّار-اَوم: مَاشِي اَذ تْقبّْڒم اَرْضَا ن أَربِّـي وَار زَّايس ثْخدّْمم شَا. <verse eid="2CO 6:1" /><verse number="2" style="v" sid="2CO 6:2" />أَقَا نتَّا يقَّار:</para>
  <para style="q1" vid="2CO 6:2">&lt;وَامِي إِي خَافِي ثَارْضَا ڒْوقْث سْڒِيغ-اَش،</para>
  <para style="q1" vid="2CO 6:2">نْهَار نِّي ن وفكِّي عَاوْنغ-ش.&gt;</para>
  <para style="p" vid="2CO 6:2">هَاقَاش، ڒخُّو ذ ڒْوقْث إِݣ يَارْضَان خ أَربِّـي. هَاقَاش، ڒخُّو ذ نْهَار إِݣ يسنْجَامن.<verse eid="2CO 6:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="2CO 6:3" />وَار نسْرُوْسِي وَالُو ذݣ وبْرِيذ إِ حَدّ بَاش اَث نغْضڒ حمَا وَار تِيفن بُو ڒْعِيب ذِي ڒْخذْمث نّغ. <verse eid="2CO 6:3" /><verse number="4" style="v" sid="2CO 6:4" />إِنَّمَا، نشِّين نتْقدَّام-اَوم يخف نّغ س مَارَّا مِينْزِي نشِّين ذ يخدَّامن ن أَربِّـي: يعْنِي نْصبَّر اَطَّاس؛ تكّنْت خَانغ ڒمْحَاين ذ تَمَارَا ذ وزِيَّار؛ <verse eid="2CO 6:4" /><verse number="5" style="v" sid="2CO 6:5" />نشِّين تْمَرَّاثن-اَنغ، تْحبَّاسن-اَنغ، تݣّن-اَنغ ڒْفَوْضَا؛ نشِّين نشَّاث تَمَارَا، نقِّيم ذِي دْجِيَاڒِي بْڒَا يضص، ندْجُوْز. <verse eid="2CO 6:5" /><verse number="6" style="v" sid="2CO 6:6" /><char style="it">نتْقدَّام-اَوم يخف نّغ</char> س صّْفَا إِي غَارْنغ ذ ڒفْهَامث ذ تَّسِيع ن ڒْخَاضَر ذ ڒْخِير ذ أَرُّوْح يقدّْسن ذ يجّن ن ڒمْحِبّث بْڒَا نِّفَاق؛ <verse eid="2CO 6:6" /><verse number="7" style="v" sid="2CO 6:7" />س وَاوَاڒ ن لْحَقِيقَا ذ جّْهذ ن أَربِّـي ذ ڒسْنَاح ن ڒْحَقّ إِݣ يدْجَان ذݣ وفُوْسِي ذ وࢲرْمَاض. <verse eid="2CO 6:7" /><verse number="8" style="v" sid="2CO 6:8" /><char style="it">نتْقدَّام-اَوم يخف نّغ لِأَنَّا يوْذَان</char> تْوقَّرن-اَنغ سْبهْدَاڒن-اَنغ؛ قَّارن ذَايْنغ ڒْبَاطڒ سمْغَارن-اَنغ؛ تَارَّان-اَنغ ذ يغشَّاشن وَلَكِن نشِّين وَار ذَاينغ بُو يخَرِّيقن؛ <verse eid="2CO 6:8" /><verse number="9" style="v" sid="2CO 6:9" />نكَّرن-اَنغ وَلَكِن نشِّين نتْوَاسّن مْلِيح؛ نتْمتَّا وَلَكِن نشِّين نْتدَّر؛ تْعَاقَابن-اَنغ وَلَكِن نشِّين وَار ذَانغ نقّن شَا؛ <verse eid="2CO 6:9" /><verse number="10" style="v" sid="2CO 6:10" />نشِّين نتْوَازيَّار وَلَكِن ڒبْدَا نفَرّح؛ نشِّين ذ يپُـوْبْرِيثن نْسرْبَاح اَطَّاس ن يِوْذَان؛ وَار غَارْنغ وَالُو وَلَكِن غَارْنغ كُڒْشِي.<verse eid="2CO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 6:11" />آي أَيث-كُوْرِينْث، نسِّيوڒ اَكِذْوم س مَارَّا صَّرَاحَا، ؤُڒَاون نّغ نُّوْرْزْمن اَطَّاس إِ كنِّيو. <verse eid="2CO 6:11" /><verse number="12" style="v" sid="2CO 6:12" />ڒمْحِبّث نّغ وَار خَاوم ت نْتغْلِيق شَا نشِّين، ذ كنِّيو إِي خَانغ ت يتغْلَاقن. <verse eid="2CO 6:12" /><verse number="13" style="v" sid="2CO 6:13" />سَّاوَاڒغ اَكِذْوم اَم ثَارْوَا ينُو. إِيوَا جّث وَاخَّا ذ ؤُڒَاون نْوم اَذ نُّوْرْزْمن اَطَّاس اَم نشِّين.<verse eid="2CO 6:13" /></para>
  <para style="s">وَار شَرّْشم شَا اَك يِنِّي وَار يُوْمِينن شَا</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14" />وَار تݣّث خَاوم ثْزَايْڒُوْت<note caller="+" style="f"><char style="fr" closed="false">6‏.14 </char><char style="ft" closed="false">ثْزَايْڒُوْت نتَّاث ذ ثْزَاݣْڒُوْت. تݣّن-تث خ يِيڒَاون ن يفُوْنَاسن يجّن ن نْهَار شرّْزن زَّايس.</char></note> اَك يِنِّي وَار يُوْمِينن شَا، وَار تِيڒِيث شَا ذ ثِيُوْيَا<note caller="+" style="f"><char style="fr" closed="false">6‏.14 </char><char style="ft" closed="false">ثِيُوْيَا نتَّاث ذ ثِيُوْݣَا.</char></note> اَكِذْسن. مَا ذِنِّي شَا ن ڒْحَاجث إِݣ يشَرّش ڒْحَقّ اَك ڒْبَاطڒ؟ لَّا. مِين يشَرّش نُّوْر اَك ثَادْجسْت؟ وَالُو. <verse eid="2CO 6:14" /><verse number="15" style="v" sid="2CO 6:15" />مَا ذِنِّي شَا ن ڒْحَاجث كِيف-كِيف جَار لْمَسِيح ذ إِبْڒِيس؟ لَّا. مَا ذِنِّي شَا ن ڒْحَاجث ثشَرّش جَار ڒْمُوْمن ذ ونِّي وَار يُوْمِينن شَا؟ وَالُو. <verse eid="2CO 6:15" /><verse number="16" style="v" sid="2CO 6:16" />مِين ثْشَرّش ثمْزِيذَا ثَمقّْرَانْت ن أَربِّـي اَك لْأَصْنَام؟ وَالُو. شُوْف، نشِّين إِي يدْجَان ذ ثَمْزِيذَا ن أَربِّـي يدَّرن. أَمنِّي يقَّار أَربِّـي:</para>
  <para style="q1" vid="2CO 6:16">&lt;نش اَذ زذْغغ اَكِذْسن اَذ ؤُيُوْرغ جَارَاسن،</para>
  <para style="q1" vid="2CO 6:16">أَذ يڒِيغ ذ أَربِّـي نْسن،</para>
  <para style="q1" vid="2CO 6:16">نِثْنِي اَذ يڒِين ذ شَّعْب ينُو.<verse eid="2CO 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 6:17" />خ مَانَايَا يقَّار سِيذِي أَربِّـي:</para>
  <para style="q1" vid="2CO 6:17">فّْغم-د زِي ڒْوسْط نْسن عزْڒث يخف نْوم،</para>
  <para style="q1" vid="2CO 6:17">وَار تْحَاذَاث شَا مِين يدْجَان حَرَام.</para>
  <para style="q1" vid="2CO 6:17">أُوْشَا نش اَكنِّيو قبْڒغ،<verse eid="2CO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="2CO 6:18" />أَذ يڒِيغ ذ بَابَاثْوم،</para>
  <para style="q1" vid="2CO 6:18">كنِّيو اَذ تِيڒِيم ذ ثَارْوَا ينُو ذ يِيسِّي ينُو.</para>
  <para style="p" vid="2CO 6:18">أَمنِّي يقَّار أَربِّـي يزمَّرن إِ كُڒْشِي.&gt;<verse eid="2CO 6:18" /></para>
  <chapter eid="2CO 6" />
  <chapter number="7" style="c" sid="2CO 7" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1" />إِذن آي يمْعِيزّن ينُو، وَامِي ذَانغ يعَاهذ <char style="it">أَربِّـي</char> خ ثْمسْڒَايِين-أَ لَابُد أَ نسِّيصْفَا يخف نّغ زِي مَارَّا مِين ذَانغ يسخْنِيزن ذِي دَّات ذ اَرُّوْح حمَا أَ نِيڒِي ذ صَّالِحِين بْڒَا اَخطِّي س ثِيݣّْوْذِي ن أَربِّـي.<verse eid="2CO 7:1" /></para>
  <para style="s">أَرَّسُوْل بُلُوس ثسْفَرّح-يث جْمَاعث ن ڒْمُوْمِنِين ن أَيث-كُوْرِينْث</para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2" />اَرزْمم-اَنغ كنِّيو يمُوْشَانْ ذݣ وُوْڒَاون نْوم. ؤُڒَا ذ يجّن وَار ث نضْڒِيم شَا، وَار ث نسْعوّج شَا، وَار ث نْغشّ شَا. <verse eid="2CO 7:2" /><verse number="3" style="v" sid="2CO 7:3" />وَار قَّارغ شَا مَانَايَا بَاش اَكنِّيو عيّْبغ لَّا. ڒَاحقَّاش نِّيغ-اَوم قْبڒ قَا كنِّيو ذݣ وُوْڒَاون نّغ، أَ نمّث نِغ أَ ندَّر اَكِذْوم. <verse eid="2CO 7:3" /><verse number="4" style="v" sid="2CO 7:4" />نش تݣّغ اَكِذْوم زْعَامث اَطَّاس، لْإِفْتِخَر إِي غَارِي ذَايْوم يمْغَر. تْوَاشجّْعغ اَطَّاس، ڒفْرَاحث ينُو تمْفيَّاض-د خ مَارَّا ڒمْحَاين نّغ.<verse eid="2CO 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 7:5" />شُوْف، نشِّين وَامِي د نُوْذف غَار لْإِقْلِيم ن مَاسِدُوْنْيَا دَّات نّغ وَار ثْرِيّح شَا، نتْوَازيَّار زِي مْكُڒ جِّهث اَمنْغِي غَار بَارَّا ذ ثِيݣّْوْذِي غَار ذَاخڒ. <verse eid="2CO 7:5" /><verse number="6" style="v" sid="2CO 7:6" />وَلَكِن أَربِّـي، يعْنِى ونِّي يتْعَاوَانن يِنِّي يتْخيَّاقن يعَاون-اَنغ س ومَاثْنغ تِيتُوْس وَامِي د يُوْسَا. <verse eid="2CO 7:6" /><verse number="7" style="v" sid="2CO 7:7" />أُو مَاشِي غِير وَامِي د يُوْسَا تِيتُوْس، <char style="it">يعَاون-اَنغ أَربِّـي</char> عَاوذ وَامِي تُوْغَا ذَايس تْهِلَّام. ئِخْبَر-اَنغ تِيتُوْس قَا ثْوحّْشم-اَيِي، قَا ثْندْمم ثْرزُّوْم خَافِي اَطَّاس. أَمنِّي ڒفْرَاحث ينُو ثرْنِي كْتَار.<verse eid="2CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 7:8" />إِيوَا وَامِي كنِّيو سْخيّْقغ س ثبْرَات نِّي ينُو <char style="it">نّغْنِي</char>، ذ اَمزْوَارُو تُوْغَا ندْمغ ڒخُّو وَار نْدِيمغ شَا. يعْنِى ندْمغ وَامِي ࢲْرِيغ ثَبْرَات نِّي ينُو ثسْخيّق-يكنِّيو ذݣ يِجّن ن ڒْوقْث وَلَكِن ثعْذُو ذغْيَا. <verse eid="2CO 7:8" /><verse number="9" style="v" sid="2CO 7:9" />ڒخُّو نش فَرّْحغ. مَاشِي وَامِي ثْخيّْقم؛ لَّا، وَامِي ثْخيّْقم بَاش اَذ تْتُوْبم. ثْخيّْقم يعْنِي يجّن ن وخِيّق زِي أَربِّـي، أَمنِّي وَار كنِّيو ثڒْقِيف ؤُڒَا ذ يجّن ن ثْخسَّارْث زَّايْنغ. <verse eid="2CO 7:9" /><verse number="10" style="v" sid="2CO 7:10" />شُوْف، أَخِيّق زِي أَربِّـي يتَارو-د تُّوْبَا، تُّوْبَا-يَا ثْندّه-يكنِّيو اَذ تْنجْمم وَار تجِّي بُو نْدَامث. أَخِيّق زِي دُّنشْت-أَ لَّا، يتَارو-د ڒْموْث. <verse eid="2CO 7:10" /><verse number="11" style="v" sid="2CO 7:11" />فكَّارث كنِّيو ذِي مِين ذَايْوم د يتَارو وخِيّق-أَ زِي أَربِّـي. يعْنِي مشْحَاڒ تْحَوَاڒم س وُوْڒ ثْرزُّوْم اَذ تْحلّم مَانَايَا ذغْيَا. يعْنِي مشْحَاڒ ثْندْمم مشْحَاڒ ثنْخڒْعم، ذَايْوم يجّن ن مزْڒِي ذ ثِيݣّْوْذِي. يعْنِي مشْحَاڒ ثسْوجْذم اَذ تْحكْمم نِيشَان. مِين مَا يدْجَان ذِي ثْمسْڒَايْث-أَ كنِّيو وَار ذَايْوم بُو ڒْعِيب. <verse eid="2CO 7:11" /><verse number="12" style="v" sid="2CO 7:12" />نش ؤُرِيغ-اَوم-د ثَبْرَات نِّي، مَايمِّي؟ مَا عْلَاحْسَاب ونِّي يضڒْمن نِغ ذ ونِّي يتْوَاضڒْمن؟ لَّا، ؤُرِيغ-اَوم-ت-يد بَاش اَكنِّيو سْفهْمغ زَّاث إِ أَربِّـي مشْحَاڒ إِي ذَانغ تݣّم اَرَّاي س وُوْڒ. <verse eid="2CO 7:12" /><verse number="13" style="v" sid="2CO 7:13" />س مَارَّا مَانَايَا نتْوَاعَاون.</para>
  <para style="p" vid="2CO 7:13">مَاشِي نتْوَاعَاون نشِّين أُو صَافِي؛ لَّا، عَاوذ نْفَرح اَطَّاس وَامِي نࢲْرَا مشْحَاڒ يفَرح تِيتُوْس أَرُّوْح نّس ثسْريّْحم-ث كنِّيو مَارَّا. <verse eid="2CO 7:13" /><verse number="14" style="v" sid="2CO 7:14" />وَامِي زَّايْوم فْتَخَرغ غَار تِيْتُوْس وَار يدْجِي مَايمِّي غَا سذْحِيغ ڒخُّو. ڒَاحقَّاش مَامّش نسِّيوڒ اَكِذْوم نِيشَان ذِي مَارَّا، ؤُڒَا ذ لْإِفْتِخَر نّغ خَاوم غَار تِيتُوْس قَا يفّغ-د نِيشَان. <verse eid="2CO 7:14" /><verse number="15" style="v" sid="2CO 7:15" />نتَّا اَقَا ثقِّيمم-اَس ذݣ وُوْڒ أُو كْتَار عَاذ خْمِي يتْفكَّار ذِي اَرَّاي إِي ذَاس ثݣِّيم، يعْنِي ثْقبْڒم-ث س يِجّن ن ثِيݣّْوْذِي ترْجِيجِيم. <verse eid="2CO 7:15" /><verse number="16" style="v" sid="2CO 7:16" />فَرّْحغ وَامِي زمَّرغ اَخَاوم تْعوَّاڒغ ذِي مِين ذِي مَا.<verse eid="2CO 7:16" /></para>
  <chapter eid="2CO 7" />
  <chapter number="8" style="c" sid="2CO 8" />
  <para style="s">ئِجّن ن لْمِثَال ن صّذَاقَا زِي ڒْمُوْمِنِين إِݣ يدْجَان ذِي مَاسِدُوْنْيَا</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1" />فَا آي أَيثْمَا، نخْس اَذ تسّْنم خ اَرْضَا نِّي إِي ذَاسنْت يُوْشَا أَربِّـي إِ ثْجُوْمَاع ن ڒْمُوْمِنِين إِݣ يدْجَان ذِي لْإِقْلِيم ن مَاسِدُوْنْيَا. <verse eid="2CO 8:1" /><verse number="2" style="v" sid="2CO 8:2" />ثكَّا خَاسن يجّن ن ڒْمِحْنث ذ ثَمقّْرَانْت ثقْسح خَاسن اَطَّاس. وَاخَّا نِثْنِي ذ يپُـوْبْرِيثن وَار غَارْسن وَالُو وَلَكِن نِثْنِي ڒفْرَاحث نْسن ثمْغَر. زِي مَانَاينِّي إِي زِي تفّغ يجّن ن صَّذَاقَا ذ ثَمقّْرَانْت اَطَّاس. <verse eid="2CO 8:2" /><verse number="3" style="v" sid="2CO 8:3" />أَقَا نش شهّْذغ صدّْقن س مِين زمَّرن اَذ ؤُشن، قَا ذ صَّح صدّْقن كْتَار زِي مِين زمَّرن. ݣِّين مَانَايَا س ڒْخَاضَر نْسن وَاحذْسن، <verse eid="2CO 8:3" /><verse number="4" style="v" sid="2CO 8:4" />تَّارن زَّايْنغ س وُوْڒ نْسن اَذ عَاوْنن س ڒْخِير-أَ ڒْمُوْمِنِين صَّالِحِين <char style="it">إِي يدْجَان ذِي ثنْدِينْت ن لْقُدْس</char>. <verse eid="2CO 8:4" /><verse number="5" style="v" sid="2CO 8:5" />نشِّين نذْهش وَامِي ݣِّين مَانَاينِّي. عْلَاحْسَاب مِين يخس أَربِّـي سلّْمن ذ اَمزْوَارُو ڒْخَاضَر نْسن إِ سِيذِيثْنغ أُو عَاذ سلّْمن-ث إِ نشِّين.<verse eid="2CO 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 8:6" />أَمنِّي إِي نْوصَّا تِيتُوْس وَامِي تُوْغَا يبْذَا يجمّع زِي قْبڒ ڒْخِير ن صَّذَاقَا-يَا زَّايْوم، ڒخُّو نْوصَّا-ث اَت يكمّڒ. <verse eid="2CO 8:6" /><verse number="7" style="v" sid="2CO 8:7" />كنِّيو تݣّم زْيَادَا ذِي مَارَّا ثِمسْڒَايِين، يعْنِي ذِي لْإِيمَان نْوم ذ لْخُطْبَا نْوم ذ ثُوْسْنَا نْوم ذ مَامّش إِي تْحَوَاڒم س وُوْڒَاون نْوم أُو ذ ڒمْحِبّث نْوم إِ نشِّين. أَمُّو إِي غَا ثݣّم مْلِيح اَطَّاس ذِي ڒْخِير ن صَّذَاقَا-يَا عَاوذ. <verse eid="2CO 8:7" /><verse number="8" style="v" sid="2CO 8:8" />وَار قَّارغ شَا مَانَايَا ذ يج ن ڒُوْصِيّث؛ نش رزُّوْغ اَذ جَرّْبغ لْحَقِيقَا ن ڒمْحِبّث نْوم يعْنِي تْشَابَّاهغ مِين تݣّم كنِّيو اَك مَامّش تْحَوَاڒن يِوْذَان نّغْنِي س وُوْڒَاون نْسن <char style="it">ذِي ڒْخذْمث-أَ</char>. <verse eid="2CO 8:8" /><verse number="9" style="v" sid="2CO 8:9" />أَقَا ثسْنم اَرْضَا ن سِيذِيثْنغ عِيْسَى لْمَسِيح. تُوْغَا نتَّا غَارس كُڒْشِي، وَلَكِن عْلَاحْسَاب نشِّين يسْمح ذِي كُڒْشِي مَانَاينِّي بَاش اَغَارْنغ يِيڒِي كُڒْشِي س مَانَاينِّي إِي ذِي يسْمح.<verse eid="2CO 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 8:10" />ڒخُّو نش اَذَاوم ؤُشغ اَرَّاي ينُو ذِي مَانَايَا، أَزَّايس ثَاوِيم نّْفَع. أَزذْغَاث كنِّيو إِݣ يصدّْقن ذ يمزْوُوْرَا؛ أُو كنِّيو عَاوذ ذ يمزْوُوْڒَا إِي ثخْسم اَذ تݣّم مَانَاينِّي. <verse eid="2CO 8:10" /><verse number="11" style="v" sid="2CO 8:11" />ڒخُّو أُو لَابُد اَذ تْكمّْڒم شّْغڒ-أَ س مِين ثْزمَّرم اَذ تْصدّْقم. يعْنِي مِين ثبْذَام س وُوْڒَاون نْوم، إِيوَا عَاوذ كمّْڒم-ث. <verse eid="2CO 8:11" /><verse number="12" style="v" sid="2CO 8:12" />لِأَنَّا بْنَاذم مڒَا س ڒْخَاضَر نّس، مِين غَا يصدّق اَذ يتْوَاقْبڒ. وَلَكِن عْلَاحْسَاب مِين غَارس ذ اَݣْڒَا مَاشِي عْلَاحْسَاب مِين وَار غَارس.<verse eid="2CO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 8:13" />شُوْف، نشِّين مَا نْرزُّو اَذ تُوْشم فُوْس إِ يِوْذَان نّغْنِي، أَخَاوم يبسّڒ دْقڒ؟ لَّا، نْرزُّو مْكُڒ يجّن اَغَارس يِيڒِي ڒْحَقّ نّس نِيشَان. <verse eid="2CO 8:13" /><verse number="14" style="v" sid="2CO 8:14" />ذِي ڒْوقْث-أَ ثَانِيتَا مِين ذَاوم غَا يشطّن ذ اَݣْڒَا اَذ ينْفع إِ مِين تحْذَاجَان نِثْنِي. منْبَعْد، مِين ذَاسن غَا يشطّن اَذ ينْفع إِ مِين تحْذَاجَام كنِّيو. أَمُّو إِي غَا يِيڒِي ڒْحَقّ نّس نِيشَان إِ مْكُڒ يجّن. <verse eid="2CO 8:14" /><verse number="15" style="v" sid="2CO 8:15" />مَامّش يقَّار لْكِتَاب: "ونِّي يسْمُوْنن اَطَّاس وَار ذَاس يتْشطِّي وَالُو، ونِّي يسْمُوْنن ذْرُوْس وَار ذَاس يتْخصِّي وَالُو."<verse eid="2CO 8:15" /></para>
  <para style="s">سّكّن تِيتُوْس ذ شَان ن وَاوْمَاثن غَار ثنْدِّينْت ن كُوْرِينْث</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 8:16" />أَ نحْمذ أَربِّـي وَامِي ذَاس يݣَّا ذݣ وُوْڒ إِ تِيتُوْس نّفْس ن ڒْخَاضَر إِي غَارِي نش خَاوم. <verse eid="2CO 8:16" /><verse number="17" style="v" sid="2CO 8:17" />ئِقْبڒ تِيتُوْس طَّلَاب نّغ، أُو كْتَار يتݣّ مَارَّا ثِزمَّار نّس اَغَارْوم د يَاس س ڒْخَاضَر نّس نِّيث. <verse eid="2CO 8:17" /><verse number="18" style="v" sid="2CO 8:18" />أَك تِيتُوْس نسّكّ ؤُمَاثْنغ نِّي مَعْرُوْف غَار مَارَّا ثِجُوْمَاع ن ڒْمُوْمِنِين خ ڒْخذْمث يتݣّ عْلَاحْسَاب لْإِنْجِيل. <verse eid="2CO 8:18" /><verse number="19" style="v" sid="2CO 8:19" />مَاشِي مَانَاينِّي وَاهَا، قَا خْضَرنْت-ث-يذ ثْجُوْمَاع ن ڒْمُوْمِنِين بَاش اَكِذْنغ يسَفَر خْمِي غَا نكْسِي ڒْخِير ن صَّذَاقَا-يَا. نْكلّف خ صَّذَاقَا-يَا إِ لْعَظَمَا ن سِيذِيثْنغ س يِيخف نّس أُو بَاش اَذ د يمظْهَار مَامّش نْتݣّ ثِزمَّار أَ نْعَاون. <verse eid="2CO 8:19" /><verse number="20" style="v" sid="2CO 8:20" />أَمُّو نخْس اَخَانغ نسْبعّذ اَيَا ن ڒْعِيب إِي خَانغ غَا ينِين خ مَامّش إِي غَا نْكلّف خ صَّذَاقَا-يَا ثَمقّْرَانْت. <verse eid="2CO 8:20" /><verse number="21" style="v" sid="2CO 8:21" />نْتݣّ ثِزمَّار بَاش أَ نݣّ مِين يدْجَان ذ اَصبْحَان مَاشِي عْلَاحْسَاب سِيذِي أَربِّـي وَاهَا، نْتݣّ عَاوذ عْلَاحْسَاب مِين تْوَاڒَان يِوْذَان.<verse eid="2CO 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CO 8:22" />عَاوذ نسّكّ اَكِذْسن ؤُمَاثْنغ نّغْنِي اَطَّاس ن ثْوَاڒَاثِين نْجَرّب-يث نُوْفِي-ث يخدّم مْلِيح س وُوْڒ نّس. ڒخُّو عْلَاحْسَاب تِّقث ثَمقّْرَانْت إِي غَارس ذَايْوم يخدّم س وُوْڒ نّس عَاذ كْتَار زِي مِين تُوْغَا يخدّم قْبڒ. <verse eid="2CO 8:22" /><verse number="23" style="v" sid="2CO 8:23" />مڒَا سّقْسَان خ تِيتُوْس، نتَّا يشَرّش اَكِذِي يخدّم اَكِذِي جَارَاوم. مڒَا سّقْسَان خ أَيثْمَاثْنغ يِيْنَا، نِثْنِي سّكَّانْت-ثن ثْجُوْمَاع ن ڒْمُوْمِنِين سْبيَّانن-د لْعَظَمَا ن لْمَسِيح. <verse eid="2CO 8:23" /><verse number="24" style="v" sid="2CO 8:24" />فَلِهَاذَا، أَوِيم-اَسن إِ يرْيَازن-أَ دَّلِيل ن ڒمْحِبّث نْوم ذ سَّبَاب س مِينْزِي نْتفْتَخَر ذَايْوم بَاش مَانَايَا اَث ࢲرنْت ثِجُوْمَاع ن ڒْمُوْمِنِين.<verse eid="2CO 8:24" /></para>
  <para style="b" />
  <chapter eid="2CO 8" />
  <chapter number="9" style="c" sid="2CO 9" />
  <para style="p">
    <verse number="1‏-2" style="v" sid="2CO 9:1-2" />أَمَّا صَّذَاقَا إِ صَّالِحِين بْڒَا مَا ذَاوم د اَرِيغ، قَا نش سّْنغ ثْرزُّوْم اَذ تْعَاوْنم ذغْيَا. تفْتَخَرغ نش س مَانَايَا غَار أَيث-مَاسِدُوْنْيَا، قَّارغ-اَسن قَا زݣ وَازذْغَاث كنِّيو ذِي لْإِقْلِيم ن وخَايَا ثْسوْجَاذم-د بَاش اَذ تْصدّْقم. ڒْخَاضَر-أَ نْوم يتْشجَّاع اَزين-اَمقّْرَان اَذ صدّْقن. <verse eid="2CO 9:1-2" /><verse number="3" style="v" sid="2CO 9:3" />أُو سّكّغ-د غَارْوم أَيثْمَاثْنغ تِيتُوْس ذ ثْنَاين-أَ نّغْنِي بَاش لْإِفْتِخَر نّغ ذَايْوم وَار يتِيڒِي شَا ذ ڒْبَاطڒ وَاهَا، أَتَاف اَذ تِيڒِيم ثْسوْجَاذم مَامّش تُوْغَا ذَاسن نِّيغ نش. <verse eid="2CO 9:3" /><verse number="4" style="v" sid="2CO 9:4" />منْبَعْد مڒَا ؤُسِين-د اَكِذِي ڒبْعَاض زِي أَيث-مَاسِدُوْنْيَا ؤُفِين-كنِّيو وَار ثسْوجْذم شَا اَتَاف نشِّين أَ نْسذْحَا خ تِّقث نّغ ذَايْوم (ؤُڒَا ذ كنِّيو اَذ تْسذْحَام). <verse eid="2CO 9:4" /><verse number="5" style="v" sid="2CO 9:5" />س مَانَايَا ؤُفِيغ أُو لَابُد اَذ شجّْعغ أَيثْمَاثْنغ يِيْنَا إِي ذَايِي د يزْوَارن غَارْوم زِيش بَاش اَذ عذْڒن مَارَّا خ صَّذَاقَا-يَا ثَمقّْرَانْت إِي زِي <char style="it">ذَايِي</char> ثْعَاهْذم زِي قْبڒ. أَمُّو اَذ تِيڒِي صَّذَاقَا-يَا مُوْجُوْدَا س وُوْڒَاون نْوم مَاشِي س بسِّيف.<verse eid="2CO 9:5" /></para>
  <para style="s">صَّذَاقَا تَاس-د س ڒفْرَاحث</para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 9:6" />فكَّرث، ونِّي غَا يزرْعن ذْرُوْس اَذ يمْجَار ذْرُوْس. ونِّي غَا يزرْعن اَطَّاس اَذ يمْجَار اَطَّاس. <verse eid="2CO 9:6" /><verse number="7" style="v" sid="2CO 9:7" />كُڒ يجّن يتْخصَّا-يَاس اَذ يصدّق س مِين ينْوَا ذݣ وُوْڒ نّس مَاشِي س وخيَّاق نِغ س بسِّيف، مِينْزِي أَربِّـي يتخْس ونِّي يتْصدَّاقن س ڒفْرَاحث. <verse eid="2CO 9:7" /><verse number="8" style="v" sid="2CO 9:8" />أَربِّـي نتَّا يزمَّر اَكنِّيو يسْفيّض س لْبَرَاكَا بَاش اَتَاف ڒبْدَا اَغَارْوم يِيڒِي مِين تحْذَاجَام مَارَّا ثُمَّا اَذ تَرْنِيم اَطَّاس ذِي مَارَّا ڒْخذْمث ثَصبْحَانْت. <verse eid="2CO 9:8" /><verse number="9" style="v" sid="2CO 9:9" />مَامّش يقَّار لْكِتَاب: &lt;نتَّا يفرّق اَطَّاس أُوْشَا يُوْشَا-اَسن إِ يپُـوْبْرِيثن، ڒْحَقّ إِݣ يتݣّ نتَّا يتْدُوْمَا إِ ڒبْدَا.&gt;<verse eid="2CO 9:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="2CO 9:10" />ونِّي إِݣ يفرّْقن زَّرِّيعث إِ وفدْجَاح نِّي إِݣ يزرّْعن ئِتِيشّ-اَس عَاوذ ؤُڒَا ذ اَغْرُوْم إِي غَا يشّ، أَتَاف نتَّا عَاوذ اَذَاوم يَرْنِي ذِي زَّرِّيعث نِّي إِي ثْزرّْعم اَذ يسمْغَار مِين ثْمجَّارم زِي صَّذَاقَا-يَا نْوم. <verse eid="2CO 9:10" /><verse number="11" style="v" sid="2CO 9:11" />أَغَارْوم يِيڒِي ڒْخِير اَطَّاس ذِي مَارَّا بَاش اَتَاف اَذ تِيڒِيم صَاخِيِين. أُو خْمِي غَا نسِّيوض صَّذَاقَا-يَا نْوم اَذ تذْوڒ ذ يجّن ن شُّكر إِ أَربِّـي. <verse eid="2CO 9:11" /><verse number="12" style="v" sid="2CO 9:12" />لِأَنَّا صَّذَاقَا-يَا إِي تݣّم مَاشِي غِير تْعمَّر زَّايس يفَاسّن يخْوَان ن ڒْمُوْمِنِين صَّالِحِين <char style="it">ذِي لْقُدْس</char>؛ لَّا، نتَّاث عَاوذ ئِتنْفيَّاض زَّايس اَطَّاس ن شُّكر إِ أَربِّـي. <verse eid="2CO 9:12" /><verse number="13" style="v" sid="2CO 9:13" />صَّذَاقَا-يَا ثُوْشَا دَّلِيل خَاوم، زَّايس إِي غَا حمْذن صَّالِحِين أَربِّـي. ثُوْمْنم س لْإِنْجِيل ن لْمَسِيح، ثْطَاعم-اَس خْمِي تْصدَّاقم اَطَّاس خَاسن أُو خ مَارَّا يوْذَان. <verse eid="2CO 9:13" /><verse number="14" style="v" sid="2CO 9:14" />رزُّوْن خَاوم تْࢲَادْجَان خَاوم عْلَاحْسَاب اَرْضَا نِّي اَمقّْرَان إِي ذَاوم يُوْشَا أَربِّـي. <verse eid="2CO 9:14" /><verse number="15" style="v" sid="2CO 9:15" />أَ نحْمذ أَربِّـي خ لْهَدِيَا نِّي نّس، وَار نْزمَّر اَت نوْصف.<verse eid="2CO 9:15" /></para>
  <chapter eid="2CO 9" />
  <chapter number="10" style="c" sid="2CO 10" />
  <para style="s">أَرَّسُوْل بُوْلُس يتْذَافَاع خ ڒْخذْمث نّس</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1" />فَا نش ذ بُوْلُس، س يِيخف ينُو تْطَالَابغ-كنِّيو س تَّوَاضُع ذ لْحَنَانَا ن لْمَسِيح. وَاه، <char style="it">ثقَّارم</char> نش زَعْمَا ترْجِيجِيغ خْمِي تِيڒِيغ اَكِذْوم، خْمِي تْغَابغ خَاوم تْقسِيحغ. <verse eid="2CO 10:1" /><verse number="2" style="v" sid="2CO 10:2" />تتَّارغ-كنِّيو بَاش وَار ذَايِي تِيجِّيم شَا اَذ يڒِيغ قسْحغ اَك ڒبْعَاض زَّايْوم اَم تْرَاجِيغ نش اَذ ݣّغ، ڒبْعَاض-أَ تْفكَّارن قَا نتْعِيش س اَرَّاي ن بْنَاذم وَاهَا. <verse eid="2CO 10:2" /><verse number="3" style="v" sid="2CO 10:3" />ذ صَّح نتْعِيش اَم بْنَاذم، وَلَكِن وَار نتْحَارِيب شَا اَم بْنَاذم. <verse eid="2CO 10:3" /><verse number="4" style="v" sid="2CO 10:4" />ڒسْنَاح نّغ مَاشِي اَم ونِّي إِݣ يسْخدَّام بْنَاذم، غَارْنغ يجّن ن ڒسْنَاح نّغ زِي سِيذِي أَربِّـي زَّايس إِي نتْرزَّا يمُوْشَان يجهْذن. <verse eid="2CO 10:4" /><verse number="5" style="v" sid="2CO 10:5" />نتْرزَّا اَوَاڒن ذ كُڒ اَرَّاي إِي ذِي يدْجَا تَّكبُّر إِݣ يتْعَارَّاضن إِ مِين نسّن خ أَربِّـي. نْحبّس كُڒ لْفِكْرَا حمَا اَتَاف اَذ تْطَاع إِ لْمَسِيح. <verse eid="2CO 10:5" /><verse number="6" style="v" sid="2CO 10:6" />خْمِي غَا ثسِّيوْضم كنِّيو نِيشَان طَّاعَا نْوم، أَتَاف نشِّين أَ نِيڒِي نْسوْجَاذ بَاش أَ نْعَاقب ونِّي وَار يتْطِيعِين شَا.<verse eid="2CO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 10:7" />كنِّيو ثْخزَّرم غَار مِين د يتْبَانن خ وُوْذم وَاهَا. مڒَا شَان يِجّن متْأَكّد نتَّا زِي لْمَسِيح أُو لَابُد اَذ يفكَّر ؤُڒَا ذ نشِّين زِي لْمَسِيح أَم نتَّا. <verse eid="2CO 10:7" /><verse number="8" style="v" sid="2CO 10:8" />وَاخَّا تفْتَخَرغ شْوَايْت س صَّرَاحَا-يَا خ سُّلْطَا نِّي إِي ذَانغ يُوْشَا سِيذِيثْنغ، وَلَكِن وَار تْسذْحِيغ شَا زِي مَانَايَا. سُّلْطَا-يَا يُوْشَا-ٱنغ-ت حمَا اَكنِّيو نْسجْهذ مَاشِي حمَا اَكنِّيو نرز. <verse eid="2CO 10:8" /><verse number="9" style="v" sid="2CO 10:9" />وَار خْسغ شَا اَذَاوم تْغِيڒ بلِّي نش اَكنِّيو سِيݣّْوْذغ س ثبْرَاثِين ينُو. <verse eid="2CO 10:9" /><verse number="10" style="v" sid="2CO 10:10" />لِأَنَّا قَّارن <char style="it">خَافِي</char> ڒبْعَاض <char style="it">زَّايْوم</char> قَا ثِبْرَاثِين ن بُوْلُس جهْذنْت قسْحنْت. <char style="it">أُو قَّارن عَاوذ</char> وَلَكِن خْمِي اَكِذْنغ يتِيڒِي نتَّا س يِيخف نّس يتضْعِيف اَوَاڒن نّس خْوَان. <verse eid="2CO 10:10" /><verse number="11" style="v" sid="2CO 10:11" />لَّا! ونِّي يسَّاوَاڒن اَمنِّي يتْخصَّا-يَاس اَذ يسّن مِين نعْنَا نشِّين ذِي ثبْرَاثِين-أَ نّغ اَخْمِي نتْغَاب، أَمنِّي إِي غَا نخْذم خْمِي د نْحطَّار.<verse eid="2CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12" />شُوْف، وَار نْزمَّر أَ نْقَرَن يخف نّغ نِغ أَ نْمثّل يخف نّغ اَك يِنِّي يتْشكَّارن إِ يِيخف نْسن. يِيْنَا خْمِي تْميَّازن يخف نْسن اَك وَايَاوْيَا نِغ تْمثَّالن يخف نْسن اَك وَايَاوْيَا يعْنِي ذَايْسن ڒقْفَاڒث. <verse eid="2CO 10:12" /><verse number="13" style="v" sid="2CO 10:13" />وَلَكِن نشِّين أَ نفْتَخَر س مِين يدْجَان نِيشَان مَاشِي كْتَار، أَ نفْتَخَر س مِين ذَانغ يكلّف أَربِّـي يعِنِي خَاوم كنِّيو. <verse eid="2CO 10:13" /><verse number="14" style="v" sid="2CO 10:14" />إِيوَا كنِّيو، مَا يكلّف-اَنغ أَربِّـي خَاوم نِغ لَّا؟ وَاه، نشِّين نُوْوض-د غَارْوم، نُوْسَا-د غَارْوم ذ يمزْوُوْرَا س لْإِنْجِيل ن لْمَسِيح. <verse eid="2CO 10:14" /><verse number="15" style="v" sid="2CO 10:15" />وَار نْتفْتَخَر شَا س ڒْخذْمث إِي ݣِّين مِيدّن يعْنِى بَاش أَ نَاوِي شَّان نّس؛ لَّا، نشِّين نتْمنَّا اَذ تَرْنِيم ذِي لْإِيمَان نْوم بَاش عَاوذ لْحُدُوْد نّغ اَكِذْوم يتْمَارْنِي. <verse eid="2CO 10:15" /><verse number="16" style="v" sid="2CO 10:16" />أَمُّو نشِّين أَ نْبشَّر س لْإِنْجِيل ذݣ يمُوْشَان اَغِيڒِين نْوم، أَقَا وَار نخْس شَا أَ نفْتَخَر س ڒْخذْمث إِي ݣِّين مِيدّن. <verse eid="2CO 10:16" /><verse number="17" style="v" sid="2CO 10:17" /><char style="it">مَامش يقَّار لْكِتَاب:</char> &lt;ونِّي يرزُّوْن اَذ يفْتَاخَر، أَذ يفْتَاخَر نتَّا زِي سِيذِي أَربِّـي.&gt; <verse eid="2CO 10:17" /><verse number="18" style="v" sid="2CO 10:18" />لِأَنَّا مَاشِي ونِّي يتْقدَّامن يخف نّس إِي غَا يتْوَاقبّْڒن؛ لَّا، ونِّي إِي غَا يتْوَاقبّْڒن ذ سِيذِي أَربِّـي إِي ث غَا يقدّْمن.<verse eid="2CO 10:18" /></para>
  <chapter eid="2CO 10" />
  <chapter number="11" style="c" sid="2CO 11" />
  <para style="s">أَرَّسُوْل بُوْلُس اَقَاث ضذ إِ يِنِّي يتَارَّان يخف نْسن ذ اَرُّسُل</para>
  <para style="p">
    <verse number="1‏-2" style="v" sid="2CO 11:1-2" />إِيوَا رزُّوْغ اَذ تصْبَرم شْوَايْت اَك ثُوْبُّوْهْڒِيَا-يَا ينُو زَعْمَا. وَاه، صبَّرث اَكِذِي لِأَنَّا غَارِي يجّن ن لْغِرَا خَاوم، يعْنِي يجّن ن لْغِرَا زِي أَربِّـي. أَقَا خطْبغ-كنِّيو زَعْمَا إِ يِجّن ن ورْيَاز يعْنِي ذ لْمَسِيح اَكنِّيو اَوِيغ غَارس اَم يِجّن ن ثعْزْرِيْث وَار ذَايس بُو ڒْعِيب. <verse eid="2CO 11:1-2" /><verse number="3" style="v" sid="2CO 11:3" />وَلَكِن نش ݣّْوْذغ مَامّش ذَاس يوْقع إِ حَوَّا<note caller="+" style="f"><char style="fr" closed="false">11‏.3 </char><char style="ft" closed="false">حَوَّا نتَّاث ذ ثَمْغَارْث ن سِيذْنَا آدَم.</char></note> يشْمث-يت وفِيغَر<note caller="+" style="f"><char style="fr" closed="false">11‏.3 </char><char style="ft" closed="false">فِيغر يتْوَاحْسَاب ذ شِّيطَان ذِي لْأَيَا-يَا.</char></note> س ثحْرَايْمِيث نّس ؤُڒَا ذ كنِّيو ڒَعْقُوْڒَاث نْوم اَذ فّْغن اَبْرِيذ، وَار ذَاس تْطِيعِيم شَا إِ لْمَسِيح س وُوْڒَاون نْوم بْڒَا نِّفَاق أُو بْڒَا ڒْعِيب. <verse eid="2CO 11:3" /><verse number="4" style="v" sid="2CO 11:4" />لِأَنَّا كنِّيو ثقَّارم مَعْلِيش وَاخَّا يُوْسَا-د غَارْوم يجّن يتْبشَّارن س يِجّن ن عِيْسَى نّغْنِي مْزُوَّر مَاشِي ذ ونِّي إِي خف نتْبشَّار نشِّين زِي قْبڒ. نِغ ذغْيَا ثْقبّْڒم يجّن ن اَرُّوْح نّغْنِي مْزُوَّر مَاشِي ذ ونِّي إِي تُوْغَا ثْقبْڒم زِي قْبڒ. نِغ ذغْيَا ثْقبّْڒم يجّن ن لْإِنْجِيل نّغْنِي مْزُوَّر مَاشِي ذ ونِّي إِي تُوْغَا ثْقبْڒم زِي قْبڒ. <verse eid="2CO 11:4" /><verse number="5" style="v" sid="2CO 11:5" />شُوْف، وَار حسّْبغ شَا يخف ينُو ذ اَنقْصِي زِي اَرُّسُل يمزْوُوْرَا. لَّا وَالُو. <verse eid="2CO 11:5" /><verse number="6" style="v" sid="2CO 11:6" />أُو نش وَاخَّا وَار سِّينغ شَا لْخُطْبَا ينُو مْلِيح، وَار ذَايِي ثنْقِيص شَا ثُوْسْنَا. نشِّين ثُوْسْنَا-يَا نسْبيّن-اَوم-ت-يد نِيشَان س مَارَّا ثِمسْڒَايِين.<verse eid="2CO 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 11:7" />مَا ذ ڒْعِيب مڒَا بشَّرغ-كنِّيو س لْإِنْجِيل ن أَربِّـي بْڒَا مَا ذَايِي ثْخدْجْسم، يعْنِي سمْزَايغ يخف ينُو بَاش اَكنِّيو سْݣَعّْذغ؟ <verse eid="2CO 11:7" /><verse number="8" style="v" sid="2CO 11:8" />نش جمْعغ تْمنْيَاث زِي ثْجُوْمَع نّغْنِي ن ڒْمُوْمِنِين قبْڒغ زَّايْسن مَانَاينِّي بَاش اَكِذْوم خذْمغ. <verse eid="2CO 11:8" /><verse number="9" style="v" sid="2CO 11:9" />وَامِي حْضَارغ اَكِذْوم تُوْغَا نش تحْذَاجِيغ، وَار تْبسَّاڒغ خ حَدّ زَّايْوم؛ لَّا، ؤُشِين-اَيِي مِين تحْذَاجِيغ اَيثْمَاثْنغ ينِّي إِي د يُوْسِين زِي مَاسِدُوْنْيَا. أَمنِّي ؤُݣِيغ اَخَاوم بسّْڒغ، أَذ قِّيمغ مسْتَمّر اَمنِّي. <verse eid="2CO 11:9" /><verse number="10" style="v" sid="2CO 11:10" />س ڒْحَقّ ن لْمَسِيح إِي ذَايِي، ؤُڒَا ذ يجّن ذݣ يمُوْشَان ن ؤُخَايَا مَا ٱذ يكّس لْإِفْتِخَار-أَ ينُو.<note caller="+" style="f"><char style="fr" closed="false">11‏.10 </char><char style="ft" closed="false">يعْنِي يُوْݣِي بُوْلُس اَخَاسن يبسّڒ خ ڒْمُوْمِنِين ن أَيث-كُوْرِينْث بَاش اَث عَاوْنن ذِي ڒْخذْمث نّس ن لْإِنْجِيل س تْمنْيَاث نْسن.</char></note> <verse eid="2CO 11:10" /><verse number="11" style="v" sid="2CO 11:11" />مَايمِّي؟ مَا وَار كنِّيو تخْسغ شَا؟ قَا أَربِّـي يسّن <char style="it">بلِّي ثْعِيزّم خَافِي</char>.<verse eid="2CO 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 11:12" />فَا مِين تݣّغ اَذ قِّيمغ اَمُّو تݣّغ-ث. مَايمِّي؟ خْسغ اَذ قسّغ يضَارن إِ يِنِّي يرزُّوْن لْفُرْصَا اَذ يڒِين مْقُوْدَّان اَكِذْنغ ذِي ثْمسْڒَايِين-أَ إِي خف تفْتَخَرن. <verse eid="2CO 11:12" /><verse number="13" style="v" sid="2CO 11:13" />شُوْف، يرْيَازن اَم يِيْنَا تَارَّان يخف نْسن ذ اَرُّسُل خدّْمن ذ يغدَّارن، سْنعْمِيڒن ذ اَرُّسُل ن لْمَسِيح. <verse eid="2CO 11:13" /><verse number="14" style="v" sid="2CO 11:14" />إِيوَا وَار نسْتغْڒِيب شَا لِأَنَّا شِّيطَان نتَّا س يِيخف نّس يسْنعْمِيڒ ذ يجّن ن لْمَلَائِكَا ن نُّوْر. <verse eid="2CO 11:14" /><verse number="15" style="v" sid="2CO 11:15" />فَلِهَاذَا، وَار نسْتغْڒِيب شَا مڒَا يخدَّامن ن شِّيطَان سْنعْمِيڒن ذ يخدَّامن ن ڒْحَقّ. ڒفْنَا نْسن اَذ يِيڒِي عْلَاحْسَاب مِين سْتَاحْقنْت ڒفْعَايڒ نْسن.<verse eid="2CO 11:15" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس ذ ڒمْحَاين نّس</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16" />أَذ ينِيغ عَاوذ، وَار ذَايِي حسّْبث شَا ذ اَبُوْهَاڒِي. وَاخَّا ثْحسْبم-اَيِي ذ اَبُوْهَاڒِي، قبّْڒم-اَيِي بَاش اَذ فْتَخَرغ شْوَايْت. <verse eid="2CO 11:16" /><verse number="17" style="v" sid="2CO 11:17" />مَانَايَا إِي زِي تفْتَخَرغ قَّارغ-ث نش اَم يِجّن ن ثُوْبُّوْهْڒِيَا، وَار ث يقَّار شَا سِيذِيثْنغ. <verse eid="2CO 11:17" /><verse number="18" style="v" sid="2CO 11:18" />خْمِي تفْتَخَرن يِوْذَان-أَ اَطَّاس عْلَاحْسَاب مِين يتݣّ بْنَاذم، ؤُڒَا ذ نش اَذ فْتَخَرغ. <verse eid="2CO 11:18" /><verse number="19" style="v" sid="2CO 11:19" />مَا كنِّيو زَعْمَا ثْفهْمم مْلِيح؟ إِيوَا مَايمِّي س ڒفْرَاحث ثْصبَّرم يبُوْهَاڒِيْين؟ <verse eid="2CO 11:19" /><verse number="20" style="v" sid="2CO 11:20" />أَقَا ثْصبَّرم ؤُڒَا ذ يِنِّي إِي كنِّيو يتَارَّان ذ يسمْغَان، ذ يِنِّي إِي كنِّيو يتتّن، ذ يِنِّي إِي خَاوم يتْبُوْصَرن، ذ يِنِّي إِي ذِي يدْجَا تَّكبُّر، ذ يِنِّي إِي كنِّيو يشَّاثن س يسقِّيڒن. <verse eid="2CO 11:20" /><verse number="21" style="v" sid="2CO 11:21" />نش تْسذْحِيغ زَعْمَا، نشِّين نضْعف وَار نْزمَّر أَ نخْذم اَمنِّي!</para>
  <para style="p" vid="2CO 11:21">قَّارغ نش زَعْمَا س ثُوْبُّوْهْڒِيَا-يَا قَا مڒْمِي مَا يزْعَم حَدّ اَزَّايس يفْتَخَر ؤُڒَا ذ نش اَزَّايس فْتَخَرغ. <verse eid="2CO 11:21" /><verse number="22" style="v" sid="2CO 11:22" />مڒَا نِثْنِي ذ يعِيبْرَانِيْين، ؤُڒَا ذ نش <char style="it">ذ اَعِيبْرَانِي</char>. مڒَا نِثْنِي زِي أَيث-إِسْرَائِيل، ؤُڒَا ذ نش <char style="it">ذ اَئِسْرَائِيلِي</char>. مڒَا نِثْنِي ؤُسِين-د زِي ثَارْوَا ن بْرَاهِيم، ؤُڒَا ذ نش <char style="it">ؤُسِيغ-د زِي ثَارْوَا ن بْرَاهِيم</char>. <verse eid="2CO 11:22" /><verse number="23" style="v" sid="2CO 11:23" />مڒَا نِثْنِي ذ يخدَّامن ن لْمَسِيح، ؤُڒَا ذ نش حْسن عَاذ <char style="it">ذ اَخدَّام ن لْمَسِيح</char> (سَّاوَاڒغ زَعْمَا س ثُوْبُّوْهْڒِيَا-يَا). نش شَّاثغ تَمَارَا كْتَار زَّايْسن، حبّْسن-اَيِي كْتَار زَّايْسن، ؤُوْثِين-اَيِي س وسْغُوْن كْتَار زَّايْسن. نش مشْحَاڒ ن ثْوَاڒَاثِين تْوَاجَاهغ ڒْموْث. <verse eid="2CO 11:23" /><verse number="24" style="v" sid="2CO 11:24" />خمْسَا ن ثْوَاڒَاثِين شَّاثن-اَيِي يسْرَائِيلِيْين س اَربعِين ن ثْيِيْثَا قلّ يشْتن س وسْغُوْن. <verse eid="2CO 11:24" /><verse number="25" style="v" sid="2CO 11:25" />ثْڒَاثَا ن ثْوَاڒَاثِين تْمَارَّاثن-اَيِي س وعْمُوْذ. ئِجّن ن ثْوَاڒَا رجْمن-اَيِي س وزْرُو. ثْڒَاثَا ن ثْوَاڒَاثِين يغْرق زَّايِي وغَرَّابُو سعْذُوْغ يجّن وَاسّ ن ذ يِجّن ن دْجِيڒث ذِي ڒبْحَر. <verse eid="2CO 11:25" /><verse number="26" style="v" sid="2CO 11:26" />نش مشْحَاڒ ن ثْوَاڒَاثِين تِيڒِيغ تْسَفَرغ ذِي لْخَطَر ن يغزْرَان، ذ لْخَطَر ن يشفَّارن، ذ لْخَطَر ن ڒْقُم ينُو، ذ لْخَطَر ن ييُوْنَانِيْين، ذ لْخَطَر ذِي ثنْدِينْت، ذ لْخَطَر ذِي ڒخْڒَا، ذ لْخَطَر ذِي ڒبْحَر، ذ لْخَطَر ن يِنِّي يتَارَّان يخف نْسن ذ اَيثْمَا. <verse eid="2CO 11:26" /><verse number="27" style="v" sid="2CO 11:27" />خدّْمغ، شَّاثغ تَمَارَا، تْنُوْسغ اَطَّاس ن دْجِيَاڒِي بْڒَا يضص. فُوْذغ دْجُوْزغ، قِّيمغ اَطَّاس ن ثْوَاڒَاثِين بْڒَا لْمَكْلَا. ثْنقّ-اَيِي ثسْمض اَرُّوْض ينُو ذ ؤُقْلِيل. <verse eid="2CO 11:27" /><verse number="28" style="v" sid="2CO 11:28" />إِيوَا قَاع ثِمسْڒَايِين-أَ أُو عَاذ ذَايِي اَمْنُوْس كُڒ نْهَار عْلَاحْسَاب مَارَّا ثِجُوْمَع ن ڒْمُوْمِنِين. <verse eid="2CO 11:28" /><verse number="29" style="v" sid="2CO 11:29" />مڒَا شَان يِجّن يضْعف، نش مَا وَار تضْعِيفغ شَا؟ مڒَا شَان يِجّن يتْوَاسُوْفغ زݣ وبْرِيذ، نش مَا وَار ذَايِي يتقّس شَا وُوْڒ ينُو؟<verse eid="2CO 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2CO 11:30" />مڒَا نش أُو لَابُد اَذ فْتَخَرغ، أَذ فْتَخَرغ س مِين ذَايِي د يسْبيَّانن ضعْفغ. <verse eid="2CO 11:30" /><verse number="31" style="v" sid="2CO 11:31" />ونِّي يتْوَابَرْكن إِ ڒبْدَا يعْنِي أَربِّـي بَابَاس ن سِيذِيثْنغ عِيْسَى، ئِسّن إِلَّا نش قَّارغ لْحَقِيقَا. <verse eid="2CO 11:31" /><verse number="32" style="v" sid="2CO 11:32" />ذِي ثنْدِينْت ن دِمَشق قَا لْوَالِي ن وزدْجِيذ حَارِث يݣَّا ڒْعَسّث ذِي ثنْدِينْت حمَا اَذَايِي يطّف. <verse eid="2CO 11:32" /><verse number="33" style="v" sid="2CO 11:33" />وَلَكِن سهْوَان-اَيِي-د <char style="it">يمحْضَارن ينُو</char> ذݣ يِجّن ن وقْبُوْب س يسغْوَان زݣ يِجّن ن ثْبُوْرْجَات ن صُّوْر ن ثنْدِينْت ڒخْدّنِّي نجْمغ زݣ يفَاسّن نّس.<verse eid="2CO 11:33" /></para>
  <chapter eid="2CO 11" />
  <chapter number="12" style="c" sid="2CO 12" />
  <para style="s">جّْهذ ذ ضُّوْعف ن اَرَّسُوْل بُوْلُس</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1" />أُو لَابُد اَذ فْتَخَرغ عَاذ، وَاخَّا وَار ذَايس بُو نّْفَع. أَذ سِّيوْڒغ ڒخُّو خ ثْمسْڒَايِين إِي د يهْوَان ذِي لْوَاحِي ذ ثْمسْڒَايِين ينُّوْفَرن إِي د يسْبيّن سِيذِيثْنغ. <verse eid="2CO 12:1" /><verse number="2" style="v" sid="2CO 12:2" />ئِجّن ن ورْيَاز يدْجَان ذِي لْمَسِيح،<note caller="+" style="f"><char style="fr" closed="false">12‏.2 </char><char style="ft" closed="false">ذِي لْأَيَاث-أَ اَرَّسُوْل بُوْلُس يسَّاوَاڒ خ يِيخف نّس.</char></note> أَقَا سّْنغ-ث <char style="it">ذ نش</char>. أَرْبعْطَاش يسݣّْوُوْسَا زݣ وَامِي يتْوَاخْضف غَار وجنَّا وِيس ثْڒَاثَا. مَا يتْوَاخْضف س دَّات نِغ بْڒَا دَّات مَانَاينِّي وَار ث سِّينغ شَا نش، ئِسّن-يث إِلَّا أَربِّـي. <verse eid="2CO 12:2" /><verse number="3‏-4" style="v" sid="2CO 12:3-4" />أَرْيَاز-أَ سّْنغ يتْوَاخْضف غَار جّنّث. مَا يتْوَاخْضف س دَّات نِغ بْڒَا دَّات مَانَاينِّي وَار ث سِّينغ شَا نش، يسّن-يث إِلَّا أَربِّـي. أَرْيَاز-أَ يصنّط إِ ثْمسْڒَايِين وَار تْوَانطِّيقنْت شَا، وَار ذَاس يتْوَاسْمِيح شَا إِ بْنَاذم اَثنْت ينْطق. <verse eid="2CO 12:3-4" /><verse number="5" style="v" sid="2CO 12:5" />ئِجّن ن ورْيَاز اَم وَانِيتَا زمَّرغ نش اَزَّايس فْتَخَرغ. وَلَكِن وَار تفْتَخَرغ شَا زِي مِين ذَايِي د يُوْسِين، تفْتَخَرغ زِي ضُّوْعف ينُو أُو صَافِي. <verse eid="2CO 12:5" /><verse number="6" style="v" sid="2CO 12:6" />شُوْف، مْڒِي خْسغ اَذ فْتَخَرغ زݣ يِيخف ينُو اَتَاف سَّاوَاڒغ س ڒْحَقّ مَاشِي س ثُوْبُّوْهْڒِيَا. وَلَكِن ؤُݣِيغ اَذ ݣّغ اَمُّو، مَايمِّي؟ حمَا اَذَايِي حسْبن يِوْذَان غِير س مِين تْوَاڒَان ذَايِي س ثِيطَّاوِين نْسن أُو ذ مِين تْصنَّاطن زَّايِي س يمجَّان نْسن.<verse eid="2CO 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 12:7" />إِذن يمُّوْش-اَيِي يجّن ن وسنَّان ذݣ ويْسُوْم ينُو،<note caller="+" style="f"><char style="fr" closed="false">12‏.7 </char><char style="ft" closed="false">مَاشِي مَعْرُوْف مِين يعْنَا وسنَّان-أَ مِيخف يسَّاوَاڒ اَرَّسُوْل بُوْلُس، وَلَكِن يسَّاوَاڒ س ڒْمَعْنَا. يمْكن ذ يجّن ن لْمَرَض إِي ث يتْشُوْكَان س جّْهذ.</char></note> مَايمِّي؟ حمَا وَار سمْغَارغ شَا يخف ينُو عْلَاحْسَاب ثِمسْڒَايِين-أَ يسْتْعجِّيبن إِي ذَايِي د يسْبيّن أَربِّـي ذِي لْوَاحِي. أَسنَّان-أَ ونِّي إِي د يسّكّن شِّيطَان يتْعدَّاب-اَيِي بَاش وَار سمْغَارغ شَا يخف ينُو. <verse eid="2CO 12:7" /><verse number="8" style="v" sid="2CO 12:8" />تَّارغ-اَس إِ سِيذِيثْنغ ثْڒَاثَا ن ثْوَاڒَاثِين بَاش اَخَافِي يسْبعّذ مَانَايَا. <verse eid="2CO 12:8" /><verse number="9" style="v" sid="2CO 12:9" />نتَّا ينَّا-ٱيِي لَّا، ئِشْفَا-يَاش أَرْضَا ينُو؛ جّْهذ ينُو اَذ يذْوڒ يكْمَاڒ س ضُّوْعف-أَ. فَلِهَاذَا فَرّْحغ اَطَّاس اَذ فْتَخَرغ س ضُّوْعف ن جّْهذ ينُو بَاش جّْهذ ن لْمَسِيح اَذَايِي يزْذغ. <verse eid="2CO 12:9" /><verse number="10" style="v" sid="2CO 12:10" />س مَانَايَا عْلَاحْسَاب لْمَسِيح نش فَرّْحغ س ضُّوْعف ينُو ذ ثُوْكّْوْرَا ذ تَمَارَا ذ وعدّب ذ ؤُزِيَّار. مَايمِّي؟ مڒَا ضعْفغ ڒخْدّنِّي نش اَذ يڒِيغ جهْذغ.<verse eid="2CO 12:10" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس يكسِّي اَمْنُوْس خ ڒْمُوْمِنِين ن أَيث-كُوْرِينْث</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 12:11" />عَاذ سَّاوَاڒغ س ثُوْبُّوْهْڒِيَا-يَا زَعْمَا، ذ كنِّيو إِي خَافِي يبزّن اَمُّو. شُوْف، تُوْغَا يتْخصَّا-كنِّيو اَذَايِي ثْشكَرم، مَايمِّي؟ لِأَنَّا نش وَاخَّا ذ وَالُو إِي دْجِيغ، وَار دْجِيغ بُو ذ اَنقْصِي زِي اَرُّسُل نِّي يمزْوُوْرَا. <verse eid="2CO 12:11" /><verse number="12" style="v" sid="2CO 12:12" />ثِمسْڒَايِين نِّي إِي د يسْبِيَّانن نش ذ اَرَّسُوْل إِي دْجِيغ نِثنْتِي تُوْغَا تْوَاخڒْقنْت-يد جَارَاوم س يِجّن ن صّْبَر ذ اَمقّْرَان، يعْنِي لْعَلَامَاث ذ لْمُعْجِزَاث ذ لْبُرْهَانَاث. <verse eid="2CO 12:12" /><verse number="13" style="v" sid="2CO 12:13" />مَا ذِنِّي شَا ن ثْمسْڒَايْث مِينْخف اَرْضِيغ نش ذِي ثْجُوْمَع ن ڒْمُوْمِنِين ثِنّغْنِي وَار خَاس اَرْضِيغ شَا جَارَاوم؟ وَاه ئِشْتن، يعْنِي وَار خَاوم تْبسِّيڒغ شَا!<note caller="+" style="f"><char style="fr" closed="false">12‏.13 </char><char style="ft" closed="false">يعْنِي وَار خَاسن يبسّڒ شَا بُوْلُس ڒَاحقَّاش يُوْݣِي اَذ يقْبڒ تْمنْيَاث زَّايْسن بَاش اَث عَاوْنن نِثْنِي ذِي ڒْخذْمث نّس ذِي لْإِنْجِيل.</char></note> سمْحم-اَيِي خ فَالْطَا-يَا.<verse eid="2CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 12:14" />ڒخُّو اَقَايِي وجْذغ اَغَارْوم د اَسغ ذِي زِّيَارَا وِيس ثْڒَاثَا، وَار خَاوم تْبسِّيڒغ شَا، وَار رزُّوْغ شَا خ وَاݣْڒَا نْوم رزُّوْغ خَاوم كنِّيو. ڒَاحقَّاش وَار يتْخصِّي شَا يحنْجِيرن اَذ سْمُوْنن اَݣْڒَا إِ لْوَلِدِين نْسن، ئِتْخصَّا لْوَلِدِين نْسن إِي غَا يسْمُوْنن اَݣْڒَا إِ يحنْجِيرن. <verse eid="2CO 12:14" /><verse number="15" style="v" sid="2CO 12:15" />نش س ڒفْرَاحث اَذ هْذِيغ يخف ينُو اَذ تْوَاهْذِيغ عْلَاحْسَاب ڒَعْمَار نْوم. مڒَا تخْسغ-كنِّيو اَطَّاس، مَا ثسْنقْصم ڒمْحِبّث نْوم خَافِي؟<verse eid="2CO 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 12:16" />إِيوَا صَافِي، مڒَا وَار خَاوم بسّْڒغ شَا، مَا ثقَّارم ڒخُّو قَا نش ذ اَغشَّاش طّْفغ-كنِّيو س ثحْرَايْمِيث، اَه؟ <verse eid="2CO 12:16" /><verse number="17" style="v" sid="2CO 12:17" />مَا ثنْوِيم خوّْنغ-كنِّيو س يِجّن زݣ يِنِّي تُوْغَا غَارْوم د سّكّغ؟ لَّا، وَالُو. <verse eid="2CO 12:17" /><verse number="18" style="v" sid="2CO 12:18" />ذ نش إِي د يوصَّان تِيتُوْس اَغَارْوم د يَاس، سّكّغ-د اَكِذس ؤُمَاثْنغ نِّي. وَار يزمَّر اَكنِّيو يغشّ تِيتُوْس. نش ذ نتَّا نْخدّم س يِجّن ن ڒَعْقڒ ذ يجّن، ئِسُوْرِيفن نّغ ذ يجّن.<verse eid="2CO 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 12:19" />مشْحَاڒ زݣ وَامِي ثْنوَّام زَعْمَا نْدَافع خ يِيخف نّغ زَّاثْوم <char style="it">وَاهَا</char>؟ لَّا آي يمْعِيزّن ينُو، نسَّاوَاڒ مَارَّا مَانَايَا ذِي لْمَسِيح زَّاث إِ أَربِّـي بَاش اَكنِّيو نْسجْهذ. <verse eid="2CO 12:19" /><verse number="20" style="v" sid="2CO 12:20" />شُوْف، ݣّْوْذغ خْمِي د غَا اَوْضغ وَار كنِّيو تِيفغ شَا مَامّش تْمنِّيغ اَكنِّيو اَفغ. أُو عَاوذ وَار ذَايِي تِيفم شَا مَامّش تْمنِّيم اَذَايِي ثَافم. ݣّْوْذغ اَذ اَفغ جَارَاوم اَمنْغِي ذ ڒحْسذ ذ وعَصّب، كُڒ يجّن يرزُّو إِ يِيخف نّس وَاهَا، ذ ڒْبَاطڒ ذ نَّمِيمَا، ذَايْوم تَّكبُّور ذ ڒْفَاوْضَا. <verse eid="2CO 12:20" /><verse number="21" style="v" sid="2CO 12:21" />ݣّْوْذغ اَغَارْوم د عقْبغ اَذ سذْحِيغ زِي أَربِّـي ينُو اَذ رُوْغ اَطَّاس خ يِنِّي إِݣ يعْصَان زِي قْبڒ، عَاذ وَار تُوْبن شَا زݣ ؤُفلّس ذ لْفَسَاد ذ ڒقْبَاحث إِ تُوْغَا تݣّن.<verse eid="2CO 12:21" /></para>
  <chapter eid="2CO 12" />
  <chapter number="13" style="c" sid="2CO 13" />
  <para style="s">أَرَّسُوْل بُوْلُس يعدْجم إِ يِنِّي إِي ذَاس يتْعَارَّاضن</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1" />ثَانِيتَا ذ زِّيَارَا وِيس ثْڒَاثَا تَاسغ-د غَارْوم. <char style="it">مَامش يقَّار لْكِتَاب:</char> &lt;كُڒ تُّهْمَا اَخَاس شهْذن ذ دَّلِيل ثْنَاين ن ڒشْهُوْذ نِغ ثْڒَاثَا.&gt; <verse eid="2CO 13:1" /><verse number="2" style="v" sid="2CO 13:2" />نش ذِي زِّيَارَا إِي تُوْغَا د ݣِّيغ غَارْوم وِيس ثْنَاين عڒْمغ-اَسن إِ يِنِّي يعصَّان ذ يِوْذَان نّغْنِي مَارَّا. ڒخُّو خْمِي خَاوم تْغَابِيغ اَذَاوم عڒْمغ عَاوذ، يعْنِي خْمِي د غَا اَوْضغ ؤُڒَا ذ يجّن زݣ يِنِّي يعصَّان مَا اَخَاس حِينّغ. <verse eid="2CO 13:2" /><verse number="3" style="v" sid="2CO 13:3" />مَايمِّي؟ لِأَنَّا ثْرزُّوْم دَّلِيل لْمَسِيح يسَّاوَاڒ زَّايِي. مَا يضْعف نتَّا ذِي ڒْوسْط نْوم؟ لَّا، ئِجْهذ جَارَاوم. <verse eid="2CO 13:3" /><verse number="4" style="v" sid="2CO 13:4" />وَاه، نتَّا يتْوَاصلّب خ صَّلِيب س ضُّوْعف، وَا إِنَّمَا يتدَّر س جّْهذ ن أَربِّـي. أَمنِّي ؤُڒَا ذ نشِّين. نضْعف اَم ضُّوْعف نّس نتَّا، وَا إِنَّمَا جَارَاوم نْتدَّر اَكِذس نتَّا س جّْهذ ن أَربِّـي.<verse eid="2CO 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 13:5" />جَرّْبث يخف نْوم مَا اَقَا كنِّيو ذِي لْإِيمَان. رَاجْعث يخف نْوم. يَاش ثسّْنم قَا عِيْسَى لْمَسِيح اَقَاث ذَايْوم؟ يعْنِي مڒَا وَار ثسْقِيطم شَا. <verse eid="2CO 13:5" /><verse number="6" style="v" sid="2CO 13:6" />أُو نش تّيّْقغ إِلَّا كنِّيو اَذَانغ ثَافم نشِّين وَار نسْقِيط شَا. <verse eid="2CO 13:6" /><verse number="7" style="v" sid="2CO 13:7" />نْتتَّار-اَس إِ أَربِّـي بَاش وَار ثْعصِّيم شَا، مَاشِي بَاش اَذَانغ اَفن يِوْذَان وَار نسْقِيط شَا ذِي تُّهْمَا-يَا إِي خَاوم نْقدّم؛ لَّا، نشِّين نْرزُّو اَذ تݣّم مِين يدْجَان نِيشَان. مڒَا زْغِيڒ-اَسن إِ ڒبْعَاض قَا نسْقط زَعْمَا ذِي تُّهْمَا-يَا إِي خَاوم نْقدّم، إِيوَا مَعْلِيش. <verse eid="2CO 13:7" /><verse number="8" style="v" sid="2CO 13:8" />شُوْف، وَار نْزمَّر أَ نݣّ وَالُو ضد إِ لْحَقِيقَا؛ نْخدّم إِ لْحَقِيقَا. <verse eid="2CO 13:8" /><verse number="9" style="v" sid="2CO 13:9" />لِأَنَّا نْفَرّح مڒْمِي مَا نضْعف، كنِّيو تِيڒِيم ثْجهْذم. ذ مَانَايَا مِيخف نْرزُّو ذِي ثْࢲَادْجِيث نّغ اَذ تْصڒْحم نِيشَان. <verse eid="2CO 13:9" /><verse number="10" style="v" sid="2CO 13:10" />س مَانَايَا إِي تَارِيغ نش ثِمسْڒَايِين-أَ ذِي ثبْرَات-أَ نش غَابغ خَاوم. أَمُّو خْمِي إِي د غَا عقْبغ غَارْوم وَار خْسغ شَا اَذ يڒِيغ قسْحغ اَكِذْوم عْلَاحْسَاب سُّلْطَا نِّي إِي ذَايِي يُوْشَا سِيذِيثْنغ. يُوْشَا-ٱيِي-ت بَاش اَكنِّيو سْجهْذغ مَاشِي اَكنِّيو رْزغ.<verse eid="2CO 13:10" /></para>
  <para style="s">لْخِتَام ن ثبْرَات-أَ</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 13:11" />صَافِي آي أَيثْمَا، فَرّْحث. صڒْحث يبْرِيذن نْوم نِيشَان. تْصنَّاطث غَارِي مِين ذَاوم قَّارغ. إِڒِيث ذ يجّن ذِي اَرَّاي نْوم. تْعِيشث ذِي ڒهْنَا. أَربِّـي نّغ ن ڒمْحِبّث ذ ڒهْنَا اَذ يِيڒِي اَكِذْوم. <verse eid="2CO 13:11" /><verse number="12‏-13" style="v" sid="2CO 13:12-13" />تْسدْجَامث خ وَايَاوْيَا س يِجّن ن سْڒَام يصْفَا. تْسدْجَامن-د خَاوم مَارَّا ڒْمُوْمِنِين صَّلِحِين. <verse eid="2CO 13:12-13" /><verse number="14" style="v" sid="2CO 13:14" />أَرْضَا ن سِيذِيثْنغ عِيْسَى لْمَسِيح ذ ڒمْحِبّث ن أَربِّـي ذ ومْعَشَار ن أَرُّوْح يقدّْسن اَكِذْوم يِيڒِي مَارَّا. <char style="it">آمِين.</char><verse eid="2CO 13:14" /></para>
  <chapter eid="2CO 13" />
</usx>