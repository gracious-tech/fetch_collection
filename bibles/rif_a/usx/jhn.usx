<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id" />
  <para style="h">يوحنا</para>
  <para style="toc3">يوح</para>
  <para style="toc2">يوحنا</para>
  <para style="toc1">أَسڒْمذ ن سِيذِيثْنغ عِيْسَى لْكِتَاب ن يُوْحَنَّا</para>
  <para style="mt1">أَسڒْمذ ن سِيذِيثْنغ عِيْسَى</para>
  <para style="mt3">لْكِتَاب ن يُوْحَنَّا</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">أَوَاڒ ن أَربِّـي نتَّا ذ نُّوْر نتَّا ذ ثُوْذَارْث</para>
  <para style="q1">
    <verse number="1" style="v" sid="JHN 1:1" />ذݣ ومزْوَارُو يدْجَا وَاوَاڒ.</para>
  <para style="q2" vid="JHN 1:1">أَوَاڒ نِّي يدْجَا اَك أَربِّـي.</para>
  <para style="q1" vid="JHN 1:1">أَوَاڒ نِّي ذ نتَّا إِݣ يدْجَان ذ أَربِّـي.<verse eid="JHN 1:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="JHN 1:2" />ذݣ ومزْوَارُو يدْجَا اَك أَربِّـي.<verse eid="JHN 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JHN 1:3" />زَّايس إِي د يخْڒق أَربِّـي مَارَّا،</para>
  <para style="q2" vid="JHN 1:3">أُو بْڒَا اَوَاڒ نِّي وَار تِيڒِي ؤُڒَا ذ يجّن ن ثْمسْڒَايْث زِي مِين د يخْڒق.<verse eid="JHN 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JHN 1:4" />ذَايس إِي ثدْجَا ثُوْذَارْث،</para>
  <para style="q2" vid="JHN 1:4">أُو ثُوْذَارْث نِّي نتَّاث ذ نُّوْر إِ يِوْذَان.<verse eid="JHN 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JHN 1:5" />نُّوْر نِّي يتْشعْشِيع ذِي ثَادْجسْت،</para>
  <para style="q2" vid="JHN 1:5">ثَادْجسْت نِّي وَار ذَاس ثْزمَّر.<verse eid="JHN 1:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />يُوْسَا-د يجّن ن ورْيَاز يسّكّ-يث-يذ أَربِّـي قَّارن-اَس يَحْيَى. <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />نتَّا يُوْسَا-د ذ شَّاهذ حمَا اَذ يشْهذ إِ نُّوْر، حمَا س شْهَاذث نّس اَذ اَمْنن مَارَّا يوْذَان. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />نتَّا يَحْيَى وَار يدْجِي شَا ذ نُّوْر؛ لَّا، يُوْسَا-د اَذ يشْهذ إِ نُّوْر، <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />يعْنِي نُّوْر نِّي نِيشَان تُوْغَا د يتَاسن غَار دُّنشْت-أَ اَذ يشعْشع خ كُڒ بْنَاذم.<verse eid="JHN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10" />نُّوْر نِّي تُوْغَا ئِدْجَا ذِي دُّنشْت. وَاخَّا ذ نتَّا إِݣ يݣِّين دُّنشْت، أَيثْبَاب ن دُّنشْت وَار ث سِّينن شَا. <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />يُوْسَا-د غَار ثْمُوْرْث نّس، أَيثْبَاب ن ثْمُوْرْث نّس وَار ث قْبِيڒن شَا. <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />يِنِّي إِي ث يقبْڒن ؤُمْنن زَّايس زݣ يِيسم نّس، يُوْشَا-ٱسن نتَّا ثِزمَّار حمَا اَذ ذوْڒن ذ ثَارْوَا ن أَربِّـي. <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />يِيْنَا وَار د خْڒِيقن شَا عْلَاحْسَاب دُّوْرِّيث ؤُڒَا عْلَاحْسَاب مِين تخْس دَّات ؤُڒَا عْلَاحْسَاب ڒْخَاضَر ن ورْيَاز؛ لَّا، ذ أَربِّـي إِي ثن د يجِّين.<verse eid="JHN 1:13" /></para>
  <para style="s">أَوَاڒ ن أَربِّـي نتَّا ذ سِيذِيثْنغ عِيْسَى لْمَسِيح</para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />أَوَاڒ-أَ يذْوڒ ذ بْنَاذم، ئِزْذغ جَارَانغ. نشِّين نࢲْرَا لْعَظَمَا غَارس يدْجَان، لْعَظَمَا-يَا ثدْجَا غَار مِّيس وَاحْذس ن بَابَاس. نتَّا يشُّوْر س اَرْضَا ذ لْحَقِيقَا. <verse eid="JHN 1:14" /><verse number="15" style="v" sid="JHN 1:15" />ئِشْهذ خَاس يَحْيَى، ئِتْبرَّاح ينَّا: "ذ وَا إِي خف تُوْغَا سِّيوْڒغ نِّيغ-اَوم اَذ د يَاس يجّن منْبَعْد إِ نش، وَلَكِن نتَّا يمْغَار خَافِي مِينْزِي تُوْغَاث قْبڒ مَا ٱذ يڒِيغ نش."<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />س لْبَرَكَا نّس ثَمقّْرَانْت يبَرك-اَنغ مَارَّا س اَرْضَا خ اَرْضَا. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />شَّرِيعَا <char style="it">ن أَيث-إِسْرَائِيل</char> ثمُّوْش خ وفُوْس ن مُوْسَى. اَرْضَا ذ لْحَقِيقَا نِثنْتِي ؤُسِينْت-يد خ وفُوْس ن عِيْسَى لمَسِيح. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />ؤُڒَا ذ يجّن وَار يࢲْرِي أَربِّـي عَمَّارْص. مِّيس وَاحْذس إِݣ يدْجَان ذݣ وُوْڒ ن بَابَاس ذ نتَّا إِي ذَانغ د يسْمظْهَارن <char style="it">سِيذِي أَربِّـي</char>.<verse eid="JHN 1:18" /></para>
  <para style="s">نَّبِي يَحْيَى يسوْجَاذ اَبْرِيذ إِ لْمَسِيح</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />ذ ثَا ذ شْهَاذث ن يَحْيَى وَامِي غَارس د سّكّن يسْرَائِيلِيْين شَان ن ڒْفُقَهَا ذ شَان ن شُّرْفَا ن أَيْث-لَاوِي زِي ثنْدِينْت ن لْقُدْس حمَا اَث سّقْسَان نَّان-اَس مِين ثعْنِيذ شك؟<verse eid="JHN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20" />يَحْيَى وَار يِنْكَر شَا يخف نّس، يعْتَرف-اَسن ينَّا-ٱسن: "نش وَار دْجِيغ شَا ذ لْمَسِيح."<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />نَّان-اَس: "ئِي مِين ثعْنِيذ، مَا ذ نَّبِي إِلْيَاس؟"</para>
  <para style="p" vid="JHN 1:21">ينَّا-ٱسن: "مَاشِي ذ نش."</para>
  <para style="p" vid="JHN 1:21">نَّان-اَس: "شك، مَا ذ نَّبِي <char style="it">إِي قَّارن اَذ د يَاس</char>؟"</para>
  <para style="p" vid="JHN 1:21">ينَّا-ٱسن: "لَّا."<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />نَّان-اَس: "ئِي شك، مِين ثعْنِيذ؟ حمَا أَ نَاف مِين غَا نِينِي إِ يِنِّي إِي ذَانغ د يسّكّن، مِين ثقَّارذ خ يِيخف نّش؟"<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />يَارَّا خَاسن س وَاوَاڒ ن نَّبِي ؤُمِي قَّارن إِشَعْيَا ينَّا قْبڒ:</para>
  <para style="q1" vid="JHN 1:23">"نش ذ ثْمِيْجَّا يتْڒَغَان ذِي ڒخْڒَا ثقَّار:</para>
  <para style="q1" vid="JHN 1:23">سْوجْذث اَبْرِيذ نِيشَان إِ سِيذِي أَربِّـي."<verse eid="JHN 1:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />يِنِّي إِي غَارس د يسّكّن نِثْنِي زِي ڒْحِزب ن يفَرِّيسِيْين. <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />نَّان-اَس: "مڒَا شك وَار ثدْجِيذ شَا ذ لْمَسِيح نِغ ذ إِلْيَاس نِغ ذ نَّبِي <char style="it">إِي د غَا يَاسن</char>، مَايمِّي شك تْطهَّارذ إِ يوْذَان س وَامَان؟"<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />ئِنْدق-د يَحْيَى ينَّا-ٱسن: "نش تْطهَّارغ إِ يوْذَان س وَامَان، وَلَكِن ذَانِيتَا يجّن ذِي ڒْوسْط نْوم وَار ث ثسِّينم شَا. <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />ذ نتَّا إِي د غَا يَاسن منْبَعْد إِ نش، وَار سْذِيهِيدْجغ اَذَاس فسْيغ ؤُڒَا ذ يفِيڒَان ن ثْسِيڒَا نّس."<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />مَارَّا مَانَايَا يوْقع ذݣ وبِيلَاج ن بَيْت عَنْيَا اَجمَّاض إِ يِغْزَار ن لْأُرْدُن مَانِي إِݣ يتْطهَّار يَحْيَى إِ يِوْذَان س وَامَان.<verse eid="JHN 1:28" /></para>
  <para style="s">نَّبِي يَحْيَى يشهّذ خ سِيذِيثْنغ عِيْسَى ذ مِّيس ن أَربِّـي</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />ثِيوشَّا نّس يَحْيَى يتْوَاڒَا عِيْسَى يݣُّوْر-د غَارس، ينَّا: "خْزَرث، ذ وِين ذ يزْمَار ن أَربِّـي إي غَا يكّْسن ڒْمُعْصِيّث خ يِوْذَان مَارَّا. <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />ذ وِين إِي خف تُوْغَا سِّيوْڒغ نِّيغ-اَوم: أَذ د يَاس منْبَعْد إِ نش يجّن ن ورْيَاز، وَلَكِن نتَّا يمْغَر خَافِي مِينْزِي تُوْغَاث قْبَڒ مَا ٱذ يِڒِيغ نش. <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />تُوْغَا نش س يِيخف ينُو وَار ث سِّينغ شَا مِين يعْنَا، وَلَكِن ؤُسِيغ-د اَذ طهَّارغ إِ يوْذَان س وَامَان حمَا اَذَاسن د يبَان نتَّا إِ أَيث-إِسْرَائِيل."<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />يَحْيَى يشْهذ خَاس ينَّا: "ࢲْرِيغ أَرُّوْح ن أَربِّـي يهْوَا-د زݣ وجنَّا يݣَّا اَم يِجّن ن ثذْبِيرْث ثْمَارْس <char style="it">خ عِيْسَى</char>. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />تُوْغَا نش وَار ث سِّينغ شَا مِين يعْنَا، وَلَكِن ذ أَربِّـي إِي ذَايي د يسّكّن اَذ طهَّارغ إِ يِوْذَان س وَامَان، نتَّا ينَّا-ٱيِي: ونِّي غَا ثࢲرذ يهْوَا-د خَاس أَرُّوْح يمَارْس خَاس، ذ نتَّا إِي غَا يطهَّارن إِ يِوْذَان س أَرُّوْح يقدّْسن. <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />نش ࢲْرِيغ مَانَايَا س يِيخف ينُو، شهّْذغ خَاس بلِّي نتَّا ذ مِّيس ن أَربِّـي."<verse eid="JHN 1:34" /></para>
  <para style="s">ئِمحْضَارن يمزْوُوْرَا ن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />ثِيوشَّا نّس عَاوذ يبدّ ذِنِّي يَحْيَى اَك ثْنَاين ن يمحْضَارن نّس. <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />وَامِي يُوْفَا عِيْسَى يعْذُو سّنِّي ينَّا-ٱسن: "خْزَرم، ذ وِين ذ يزْمَار إي د يسّكّ أَربِّـي." <verse eid="JHN 1:36" /><verse number="37" style="v" sid="JHN 1:37" />كَّرن ثْنَاين نِّي ن يمحْضَارن وَامِي ذَاس سْڒِين يسَّاوَاڒ خ عِيْسَى، ذْفَارن-ث.<verse eid="JHN 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 1:38" />ئِنقْڒب عِيْسَى غَار ذفَّار يُوْفِي-ثن ذفَّارن-ث-يذ ينَّا-ٱسن: "مِين تْرزُّوم؟"</para>
  <para style="p" vid="JHN 1:38">نَّان-اَس: "آ رَاڤِي، مَانِي تِيڒِيذ؟" (أَوَاڒ-أَ رَاڤِي يخس اَذ يِينِي لْمُعَلِّم.)<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />ينَّا-ٱسن: "أَرَاحمْ-د اَذ تخْزَرم." رُوْحن اَكِذس ࢲْرِين مَانِي يتِيڒِي. ثْسَعَّات عْڒَاين ذ اَرْبعَا ن وعشِّي، سّنِّي سنْسن اَكِذس نْهَار نِّي.<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />ئِجّن زِي ثْنَاين نِّي ن يمحْضَارن قَّارن-اَس أَنْدْرُوْس، ؤُمَاس ن سِمْعَان بُطْرُس، يسْڒَا إِ وَاوَاڒ ن يَحْيَى يذْفَار عِيْسَى. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />ڒخْدّنِّي يُوْفَا ؤُمَاس سِمْعَان ينَّا-ٱس نُوْفَا لْمَسِيَا. (أَوَاڒ-أَ لْمَسِيَا يخس اَذ يِينِي لْمَسِيح.) <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />ئِسِّيوض-يث-يذ غَار عِيْسَى. وَامِي ث يࢲْرَا عِيْسَى ينَّا-ٱس: "شك ذ سِمْعَان مِّيس ن يُوْحَنَّا، زِي سَّا اَڒ ثْسَاونْت اَذَاش تْڒَغَان صِفَاس." (أَوَاڒ-أَ صِفَاس يخس اَذ يِينِي بُطْرُس.)<verse eid="JHN 1:42" /></para>
  <para style="b" />
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />ثِيوشَّا نّس عِيْسَى يخس اَذ يرَاح غَار ثْمُوْرْث ن لْجَالِيل. ئِرُوْح يُوْفَا يجّن قَّارن-اَس فِيلِيپَّـاس ينَّا-ٱس: "ذْفَار-اَيِي-د!"<verse eid="JHN 1:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 1:44" />فِيلِيپَّـاس نتَّا زِي بَيْت صَيْدَا، أَبِيلَاج ن أَنْدْرُوْس ذ بُطْرُس. <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />فِيلِيپَّـاس يُوْفَا يجّن قَّارن-اَس نَاثْنَاهِيل ينَّا-ٱس: "نُوْفَا ونِّي إِي خف يُوْرَا مُوْسَى ذِي شَّرِيعَا، مِيخف ؤُرِين لْكُتُب ن لْأَنْبِيَا. نتَّا ذ عِيْسَى زݣ وبِيلَاج ن نَّاصِيرَا ذ مِّيس ن يُوْسف."<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />ينَّا-ٱس نَاثْنَاهِيل: "مِين يصبْحَان زِي نَّاصِيرَا!؟"</para>
  <para style="p" vid="JHN 1:46">ينَّا-ٱس فِيلِيپَّـاس: "أَرَاح-د، أَذ تخْزَرذ."<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />عِيْسَى يࢲْرَا نَاثْنَاهِيل يݣُّوْر-د غَارس ينَّا: "وَانِيتَا نِيشَان زِي أَيث-إِسْرَائِيل، وَار ذَايِس بُو يخَارْوِيضن."<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />ينَّا-ٱس نَاثْنَاهِيل إِ عِيْسَى: "مِينْزِي ذَايِي ثسّْنذ؟"</para>
  <para style="p" vid="JHN 1:48">ينَّا-ٱس عِيْسَى: "ࢲْرِيغ-ش سْوَادَّاي إِ ثْشجَّارْث ن ثَازَارث، قْبڒ مَا ش د يڒَاغَا فِيلِيپَّـاس."<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />ينَّا-ٱس نَاثْنَاهِيل إِ عِيْسَى: "آ لْمُعَلِّم، قَا شك ذ مِّيس ن أَربِّـي، شك ذ اَزدْجِيذ ن أَيث-إِسْرَائِيل."<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />ينَّا-ٱس عِيْسَى: "مَا ثُوْمْنذ وَامِي ش نِّيغ ࢲْرِيغ-ش سْوَادَّاي إِ ثْشجَّارْث ن ثَازَارث؟" ينَّا-ٱس: "عَاذ اَذ تࢲرذ كْتَار زِي مَانَايَا. <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />أَقَا تسْڒَام ڒْحَقّ: أَذ تࢲرم اَجنَّا ينُوْرْزم، لْمَالَائِكَاث ن أَربِّـي تَاڒِينْت هوَّانْت-يد خ مِّيس ن بْنَاذم."<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">لْمُعْجِيزَا ثَمزْوَارُوْت ن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />ذِي نْهَار وِيس ثڒْتِيَّام ذِنِّي يجّن ن ڒْفَارْح ذݣ وبِيلَاج ن قَانَا ذِي ثْمُوْرْث ن لْجَالِيل. ذِنِّي يمَّاس ن عِيْسَى. <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />ؤُڒَا ذ عِيْسَى ذ يمحْضَارن نّس تْوَاعَرْضن غَار ڒْفَارْح نِّي. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />وَامِي وَار غَارسن قِّيمن وَامَان ن وضِيڒ، ثنَّا-ٱس يمَّاس إِ عِيْسَى قَا اَمَان ن وضِيڒ قْضَان.<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />ينَّا-ٱس عِيْسَى: "آ ثَمْغَارْث، مَاشِي ذ شّْغڒ ينُو. نش ڒْوقْث ينُو عَاذ وَار د تُوْسِي شَا."<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />ثنَّا-ٱسن يمَّاس إِ يخدَّامن: "ݣّم مِين ذَاوم يقَّار."<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />ذِنِّي ذِي <char style="it">ثدَّارْث</char> نِّي ستَّا ن يقْنُوْشن ن وَامَان عْلَاحْسَاب مَامّش نُّوْمن تݣّن زَّايْسن يسْرَائِيلِيْين ڒُوْضُو. ئِقْنُوْشن نِّي تْوَاخذْمن س وزْرُو، كُڒ يجّن يكسِّي زِي ثْمَانِين اَڒ مِيَّا أُو عِشْرِين لِيتْرُو ن وَامَان. <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />ينَّا-ٱسن عِيْسَى إِ يخدَّامن: "عمَّرم يقْنُوْشن-أَ س وَامَان." عمَّرن-ثن س وَامَان اَڒ وقمُّوْم. <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />ينَّا-ٱسن: "أَيْمم شْوَايْت اَوِيم-ثن إِ ونِّي يتْكلَّافن زِي ڒْفَارْح." أُوْشَا ؤُوِين-اَس شِي حَجَا. <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />ؤُفِين اَمَان عَادِي نِّي ذوْڒن ذ اَمَان ن وضِيڒ. ونِّي يتْكلَّافن زِي ڒْفَارْح-أَ يقَّاس-يثن وَلَكِن نتَّا وَار يِسِّين شَا مَانِيس د كِّين وَامَان-أَ ن وضِيڒ. ئِخدَّامن نّس إِي ذَاس د يُوْيمن اَمَان-أَ، ذ نِثْنِي إِݣ سّْنن مَانِيس د يكَّا مَانَايَا. ثُمَّا ونِّي يكلّْفن زِي ڒْفَارْح يسِّيْوڒ اَك مُوْڒَاي <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />ينَّا-ٱس: "عَدَتَان ذݣ ومزْوَارُو يوْذَان تِيشّن-اَسن إِ ينوْجِيْون اَمَان ن وضِيڒ يصبْحَانن. خْمِي تِيڒِي سْوِين زَّايْسن اَطَّاس، ذِي ڒْوقْث نِّي إِي ذَاسن تِيشّن اَمَان ن وضِيڒ عَادِي. شك لَّا، ثْخمّْڒذ اَمَان ن وضِيڒ يصبْحَانن اَڒ ڒخُّو."<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />ثَانِيتَا ذ لْمُعْجِيزَا ثَمزْوَارُوْت إِݣ يݣّا عِيْسَى. ئِݣِّي-ت ذݣ وبِيلَاج نْ قَانَا ذِي ثْمُوْرْث ن لْجَالِيل. ئِسْمظْهَار-د لْعَظَمَا نّس، ؤُمْنن زَّايس يمحْضَارن نّس. <verse eid="JHN 2:11" /><verse number="12" style="v" sid="JHN 2:12" />منْبَعْد إِ مَانَايَا يهْوَا غَار وبِيلَاج ن كَفرْنَاحُوْم، نتَّا ذ يمَّاس ذ أَيْثْمَاس ذ يمحْضَارن نّس، قِّيمن ذِنِّي ذْرُوْس ن وُوْسَّان.<verse eid="JHN 2:12" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتَازّڒ خ يِنِّي يتݣّن تِّجَارَا ذِي ثمْزِيذَا ثَمقّْرَانْت</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />وَامِي د يُوْوض ڒْعِيذ اَمقّْرَان ن أَيث-إِسْرَائِيل، ئِكَّر عِيْسَى يُوْڒِي غَار ثنْدِينْت ن لْقُدْس. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />يُوْفَا ذِي ثمْزِيذَا ثَمقّْرَانْت زْنُوْزَان ذَايس يفُوْنَاسن ذ يحُوْڒِيْين ذ يذْبِيرن، ؤُڒَا ذ يصَرَّافن قِّيمن ذِنِّي تْصرَّافن تْمنْيَاث. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />ئِمُوْذ يسغْوَان، س يسغْوَان نِّي يُوْزّڒ خَاسن مَارَّا زِي ثمْزِيذَا ثَمقّْرَانْت س يحُوْڒِيْين ذ يفُوْنَاسن. ئِقْڒب-اَسن مِيسَّاث ن يِنِّي يتْصَرَّافن، يزدْجع-اَسن تْمنْيَاث نِّي ذِي ثْمُوْرْث. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />ينَّا-ٱسن إِ يِنِّي يزْنُوْزَان يذْبِيرن: "إِيْسِيث مَانَايَا سَّانِيتَا. وَار تَارَّاث شَا ثَدَّارْث ن بَابَا ذ سُّوْق!"<verse eid="JHN 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 2:17" />فكَّرن يمحْضَارن نّس مَانَايَا يُوْسَا-د ذِي لْكِتَاب: "أَذ صدّْقغ ثُوْذَارْث ينُو خ ڒمْحِبّث ن ثمْزِيذَا نّش."<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />كَّرن يسْرَائِيلِيْين نَّان-اَس: "مَان لْعَلَامَا ثَمقّْرَانْت إِي غَا ثݣّذ بَاش اَغَارش يِيڒِي ڒْحَقّ اَذ تݣّذ مَانَايَا؟"<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />ينَّا-ٱسن عِيْسَى: "هذْمث ثَمْزِيذَا-يَا ثَمقّْرَانْت، نش اَتِيد سِيڒِيغ ذِي ثڒْتِيَّام!"<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />نَّان-اَس يسْرَائِيلِيْين: "شك، أَتِيد ثْسِيڒِيذ ذِي ثڒْتِيَّام؟ ثَمْزِيذَا-يَا ثَمقّْرَانْت ثبْنَا ذِي ستَّا و اَرْبعِين يسݣّْوُسَا!" <verse eid="JHN 2:20" /><verse number="21" style="v" sid="JHN 2:21" />وَلَكِن ثَمْزِيذَا ثَمقّْرَانْت مِينْخف يسَّاوَڒ عِيْسَى نتَّاث ذ دَّات نّس. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />وَامِي د يكَّر زِي ڒْموْث، فكَّرن يمحْضَارن نّس مِين ذَاسن ينَّا، ؤُمْنن زِي لْكِتَاب ذ وَاوَاڒ إِي ينَّا عِيْسَى.<verse eid="JHN 2:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />وَامِي يدْجَا ذِي ثنْدِينْت ن لْقُدْس ذِي ڒْعِيذ اَمقّْرَان ن أَيث-إِسْرَائِيل، أَطَّاس ن يِوْذَان إِي زَّايس يُوْمنن زݣ يِيسم نّس وَامِي ࢲْرِين لْمُعْجِيزَاث إِݣ يتݣّ. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />وَلَكِن نتَّا وَار ذَايْسن يتِّيقِي شَا مِينْزِي يسّن يوْذَان مَارَّا مِين ذَايْسن. <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />وَار يتحْذِيجِي بُو ڒشْهُوْذ خ يِوْذَان، نتَّا يعْڒم خ وُوْڒَاون نْسن.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">سِيذِيثْنغ عِيْسَى يسڒْمَاذ خ وبْرِيذ ن جْذِيذ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />تُوْغَا يدْجَا يجّن ن ورْيَاز قَّارن-اَس نِيْكُوْدِيم زِي ڒْحِزب ن يفَرِّسِيْين. نتَّا ذ يجّن زِي لْحُكَّام ن أَيث-إِسْرَائِيل. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />يُوْسَا-د غَار عِيْسَى س دْجِيڒث ينَّا-ٱس: "آ لْمُعَلِّم، نشِّين نسّن بلِّي شك ذ اَمْسڒْمَاذ إِي د يُوْسِين زِي أَربِّـي. وَار يزمَّر ؤُڒَا ذ يجّن اَذ يݣّ شَان لْمُعْجِيزَاث زِي مِين تݣّذ شك إِلَّا مڒَا كِذس أَربِّـي."<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />ئِنْدق-د عِيْسَى ينَّا-ٱس: "أَقَا تسْڒِيذ ڒْحَقّ: وَار يزمَّر ؤُڒَا ذ يجّن اَذ يࢲر ڒْمُلْك ن أَربِّـي إِلَّا مڒَا يخْڒق-د ذ جْذِيذ."<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />ينَّا-ٱس نِيْكُوْدِيم: "مَامّش غَا يݣّ بْنَاذم اَذ د يخْڒق ذ جْذِيذ مڒَا يوْسَار؟ مَا يزمَّر اَذ يَاذف عَاوذ ذݣ وعدِّيس ن يمَّاس اَذ د يخْڒق ذ جْذِيذ؟"<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />ينَّا-ٱس عِيْسَى: "أَقَا تسْڒِيذ ڒْحَقّ: مڒَا شَان يِجّن وَار د يخْڒِيق شَا س وَامَان ذ أَرُّوح ن أَربِّـي، وَار يزمَّر اَذ يَاذف ذِي ڒْمُلْك ن أَربِّـي. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />مِين يتْوَاخڒْقن زِي دَّات، نتَّاث ذ دَّات. مِين يتْوَاخڒْقن زِي أَرُّوْح ن أَربِّـي، نتَّا ذ أَرُّوْح. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />مڒَا نِّيغ-أَش يتخصَّا-كنِّيو اَذ د تْخڒْقم ذ جْذِيذ، وَار تْعجِّيب شَا. <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />أَرِّيح يتْصُوْض مَانِي يخس نتَّا. أَذ تسْڒِيذ إِ صُّوْت نّس، وَلَكِن وَار ثسِّينذ شَا مَانِيس د يكَّا ؤُڒَا ذ مَانِي غَا يرَاح. أَمُّو إِي ݣِّين مَارَّا يِنِّي يتْوَاخڒْقن س أَرُّوح ن أَربِّـي."<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />ينَّا-ٱس نِيكُوْدِيم: "مَامّش مَانَايَا؟"<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />يَارَّا خَاس عِيْسَى ينَّا-ٱس: "إِيوَا ثْسڒْمَاذذ شك أَيث-إِسْرَائِيل وَار ثْفهِّيمذ شَا مَانَايَا؟ <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />أَقَا تسْڒِيذ ڒْحَقّ: نشِّين نسَّاوَاڒ زِي مِين نسّن، نْشهّذ س مِين نࢲْرَا، وَلَكِن كنِّيو وَار ثقْبِيڒم شَا شْهَاذث نّغ. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />مڒَا سِّيوْڒغ غَارْوم خ ثْمسْڒَايِين ن ثْمُوْرْث كنِّيو وَار تِيمْنم شَا، مَامّش غَا ثَامْنم مڒَا سِّيوْڒغ-اَوم خ ثْمسْڒَايِين ن وجنَّا؟ <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />ؤُڒَا ذ يجّن مَا يُوڒِي غَار وجنَّا إِلَّا ونِّي د يهْوَان زݣ وجنَّا، نتَّا ذ مِّيس ن بْنَاذم.<verse eid="JHN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14" />أَمشنَاو مَامّش يسْبدّ مُوْسَى فِيغر ن نحَّاس خ ثحْنَاشْت ذِي ڒخْڒَا، أَمُّو يتْخصَّا اَذ يتْوَاسْبدّ مِّيس ن بْنَاذم ذݣ وجنَّا.<note caller="+" style="f"><char style="fr" closed="false">3‏.14 </char><char style="ft" closed="false">مَانَايَا يتَاس-د زِي لْكِتَاب ن لْأَرْقَام 21: 6‏-9. ئِضْڒق-د سِيذِي أَربِّـي يفِيغرَان مسْمُوْمِين خ شَّعْب بْذَان تقّْسن-اَسن، مُّوْثن خَربِّي زَّايْسن. يُوْسَا-د شَّعْب غَار سِيذْنَا مُوْسَى نَّان-اَس: "نخْضَا وَامِي نتْشثْشَا أُو نسِّيوڒ ذِي سِيذِي أَربِّـي ؤُڒَا ذَايش. تَّار-اَس إِ أَربِّـي حمَا اَخَانغ يسْبَعّذ يفِيغرَان-أَ." سّنِّي سِيذْنَا مُوْسَى يتَّار إِ أَربِّـي. يَارَّا-د أَربِّـي خ سِيذْنَا مُوْسَى ينَّا-ٱس: عْذڒ يج وفِيغر س نحَّاس اݣّ-يث خ يِجّن ن ثحْنَاشْت، أَغَارس خْزَرن يِنِّي ؤُمِي قّْسن يفِيغرَان حمَا اَذ دَّرن." ئِرُوْح سِيذْنَا مُوْسَى يعْذڒ فِيغر نِّي س نحَّاس يݣِّي-ث خ ثحْنَاشْت. تُوْغَا ونِّي ؤُمِي يقّس وفِيغر يخزَّر غَار وفِيغر نِّي ن نحَّاس يتدَّر.</char></note> <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />مَارَّا ونِّي زَّايس غَا يَامْنن اَغَارس ثِيڒِي ثُوْذَارْث إِ ڒبْدَا."<verse eid="JHN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16" />وَامِي يحِبّ أَربِّـي دُّنشْت-أَ، ئِهْذَا-يَاس مِّيس أَوحْذَانِي حمَا ونِّي زَّايس غَا يَامْنن وَار يفنِّي شَا اَغَارس ثِيڒِي ثُوْذَارْث ن ڒبْدَا. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />أَربِّـي وَار د يسّكّ شَا مِّيس غَار دُّنشْت حمَا اَذ يحَاسب يوْذَان؛ لَّا، يسّكّ-يث-يذ حمَا اَزَّايس يسنْجم يوْذَان. <verse eid="JHN 3:17" /><verse number="18" style="v" sid="JHN 3:18" />ونِّي زَّايس يتَامْنن اَتَاف وَار يتْوَاحَاسِيب شَا. ونِّي وَار زَّايس يتِيمْنن شَا اَقَا يتْوَاحَاسَاب مِينْزِي نتَّا وَار يُوْمِين شَا زݣ يِيسم ن مِّيس ن أَربِّـي اَوحْذَانِي. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />ذ وَا ذ لْحُكم <char style="it">إِي خَاس غَا يِيڒِين</char>: نُّوْر يُوْسَا-د غَار يِوْذَان، ئِوْذَان خْسن ثَادْجسْت حْسن زِي نُّوْر مِينْزِي تݣّن شَّرّْ. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />مَارَّا ونِّي يتݣّن مِين يدْجَان ذ اَعفَّان يتْعِيفَّا نُّوْر، وَار غَارس د يتِيس شَا غَار نُّوْر حمَا وَار تْنفْضِيحنْت شَا ڒفْعَايڒ نّس. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />ونِّي يخدّْمن نِيشَان اَذ د يَاس غَار نُّوْر. أَمُّو اَذ د يبَان بلِّي ڒخْذَايم نّس يتݣّ-يثنْت إِ أَربِّـي.<verse eid="JHN 3:21" /></para>
  <para style="s">نَّبِي يَحْيَى يشهّذ بلِّي سِيذِيثْنغ عِيْسَى يمْغَر خ كُڒْشِي</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />منْبَعْد إِ مَانَايَا عِيْسَى ذ يمحْضَارن نّس ؤُسِين-د غَار ثْمُوْرْث ن يَهُوْذِيَا يقِّيم اَكِذْسن ذِنِّي، ئِتْطهَّار إِ يِوْذَان س وَامَان. <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />ؤُڒَا ذ يَحْيَى يتْطهَّار إِ يِوْذَان س وَامَان ذِي ڒْعُنْصَر ن نُوْن ذِي طَّارف ن ثنْدِينْت ن سَالِيم مِينْزِي ذِنِّي اَمَان اَطَّاس. تَاسن-د ذِنِّي يِوْذَان حمَا اَثن يطهَّار. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />(ئِوْقع مَانَايَا قْبڒ مَا ذ ݣّن يَحْيَى ذِي ڒحْبس.) <verse eid="JHN 3:24" /><verse number="25" style="v" sid="JHN 3:25" />يوْقع لْخِلَاف جَار يمحْضَارن ن يَحْيَى ذ يِجّن ن ؤُئِسْرَائِيلِي خ مَامّش غَا يِيڒي ڒُوْضُو. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />ؤُسِين-د غَار يَحْيَى نَّان-اَس: "آ لْمُعَلِّم، ونِّي تُوْغَا اَكِذش يدْجَان اَجمَّاض إِ يِغْزَار ن لْأُرْدُن أُو شك ثْشهْذذ خَاس، نتَّا يتْطهَّار إِ يِوْذَان س وَامَان ݣُّوْرن غَارس مَارَّا."<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />ينَّا-ٱسن يَحْيَى: "وَار يزمَّر بْنَاذم اَغَارس ثِيڒِي شَان ثْمسْڒَايْث مڒَا وَار ذَاس د تُوْسِي شَا زِي أَربِّـي. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />كنِّيو س يِيخف نْوم ثْشهْذم قَا نِّيغ-اَوم: نش وَار دْجِيغ شَا ذ لْمَسِيح؛ لَّا، تْوَاسّكّغ-د قْبڒ إِ نتَّا. <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />ونِّي غَار ثدْجَا ثسْڒِيث، نتَّا ذ مُوْڒَاي. أَوْزِير ن مُولَاي<note caller="+" style="f"><char style="fr" closed="false">3‏.29 </char><char style="ft" closed="false">أَوْزِير ن مُوْڒَاي نتَّا ذ صَاحب لْعَرِيس نِغ ذ اَمدُّوْكڒ ن مُوْڒَاي.</char></note> يعْنِي ونِّي يتْبدَّان زَّاثس يتْسْڒَا-يَاس، نتَّا يفَرّح اَطَّاس إِ وَاوَاڒ ن مُوْڒَاي. أَمُّو ؤُڒَا ذ نش فَرْحغ اَطَّاس. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />أُو لَابُد نتَّا اَذ يمْغَر، نش اَذ نقْصغ."<verse eid="JHN 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />ونِّي إِي د يتَاسن زݣ وجنَّا، نتَّا يمْغَر خ كُڒْشِي. وَلَكِن ونِّي إِي د يتَاسن زِي ثْمُوْرْث نتَّا زِي ثْمُوْرْث، ئِسَّاوَاڒ اَمشْنَاو يوْذَان ن ثْمُوْرْث. ونِّي إِي د يتَاسن زݣ وجنَّا، نتَّا يمْغَر خ كُڒْشِي. <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />ئِشهّذ زِي مِين يࢲْرَا ذ مِين يسْڒَا، وَلَكِن شْهَاذث نّس وَار ت يقبّڒ ؤُڒَا ذ يجّن. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />ونِّي يقبّْڒن شْهَاذث نّس، أَتَاف يتْحَقّق بلِّي أَربِّـي ذ لْحَقِيقَا إِݣ يدْجَا. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />ونِّي إِي د يسّكّ أَربِّـي يسَّاوَاڒ س وَاوَاڒ ن أَربِّـي مِينْزِي يتِيشّ-اَس أَرُّوح نّس بْڒَا ڒقْيَاس. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />بَابَاس يعِيزّ خَاس مِّيس، يݣّا-ٱس كُڒْشِي ذݣ وفُوْس نّس. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />ونِّي يتَامْنن زِي مِّيس اَتَاف غَارس ثُوْذَارْث ن ڒبْدَا. ونِّي وَار يتْطِيعِين شَا إِ مِّيس، أَتَاف وَار غَارس بُو ثُوْذَارْث اَخَاس يغْضب أَربِّـي."<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">أَطَّاس ن يِوْذَان زِي سَمَارْيَا تَامْنن زِي سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />ئِسّن عِيْسَى بلِّي يفَرِّيسِيْين اَرِّين-د ڒخْبَار وَامِي د مَارْنِين غَارس يمحْضَارن يتْطهَّار-يثن س وَامَان كْتَار زِي يَحْيَى. <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />وَلَكِن عِيْسَى س يِيخف نّس وَار يتْطهَّار شَا إِ يِوْذَان، ذ يمحْضَارن نّس إِݣ يݣِّين مَانَاينِّي. <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />سّنِّي يفّغ زِي ثْمُوْرْث ن يَهُوْذِيَا، ئِرُوْح غَار ثْمُوْرْث ن لْجَالِيل. <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />ئِتْخصَّا-يَاس إِ نتَّا اَذ يكّ خ ثْمُوْرْث ن سَمَارْيَا. <verse eid="JHN 4:4" /><verse number="5" style="v" sid="JHN 4:5" />ئِكَّا خ يِجّن ن ثنْدِينْت زِي سَمَارْيَا قَّارن-اَس سُوْخَار، زَّاث إِ ومَرْجع نِّي إِݣ يُوْشَا يَعْقُوْب إِ مِّيس يُوْسف. <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />ذِنِّي اَنُو ن يَعْقُوْب. وَامِي عِيْسَى يُوْحڒ س وبْرِيذ اَݣ ؤُزْين ن نْهَار، ئِقِّيم غَار وَانُو نِّي ن يَعْقُوْب.<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7‏-8" style="v" sid="JHN 4:7-8" />ثُوْسَا-د يشْت ن ثمْغَارث زِي سَمَارْيَا اَذ تَايم اَمَان. ئِمحْضَارن ن عِيْسَى نِثْنِي تُوْغَا رُوْحن غَار ثنْدِينْت اَذ سْغن مِين غَا شّن. ينَّا-ٱس عِيْسَى إِ ثمْغَارْث نِّي: "ؤُش-اَيِي اَذ سْوغ."<verse eid="JHN 4:7-8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />ثنَّا-ٱس ثمْغَارْث نِّي: "شك ذ اَئِسْرَائِيلِي، نش ذ ثَسَمَارِيث. مَامّش ذَاش ثخْڒق شك ثتَّارذ-اَيِي اَذ تسْوذ؟" (إِيوَا يسْرَائِيلِيْين قَا وَار تمْصُرُوْفن شَا اَك يِوْذَان ن سَمَارْيَا.)<verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />ينَّا-ٱس عِيْسَى: "مَعْلِيك شم ثسّْنذ لْهَدِيَا ن أَربِّـي ثسّْنذ مِين عْنِيغ نش إِي ذَام يقَّارن ؤُش-اَيِي اَذ سْوغ، أَتَاف ثتَّارذ-اَيِي شم اَمَان اَذَام ؤُشغ اَمَان ن ثُوْذَارْث."<verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />ثنَّا-ٱس: "آ سِيذِي، وَار غَارك شَا مِينْزِي غَا ثَايْمذ. أَنُو-يَا يُوْدْجغ، مَانِيس د غَا ثَاوِيذ اَمَان نِّي ن ثُوْذَارْث؟ <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />جدِّيثْنغ يَعْقُوْب يُوْشَا-ٱنغ اَنُو-يَا، ئِسْوَا زَّايس نتَّا س يِيخف نّس ذ ثَارْوَا نّس ذ ڒبْهَايم نّس. مَا ثْحسّْبذ يخف نّش كْتَار زَّايس؟"<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />ئِنْدق-د عِيْسَى ينَّا-ٱس: "مَارَّا ونِّي غَا يسْون زݣ وَامَان-أَ اَتَاف اَذ يفَّاذ عَاوذ. <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />وَلَكِن ونِّي غَا يسْون اَمَان إِي ذَاس غَا ؤُشغ نش اَتَاف وَار يتْفِيذِي شَا عمَّارْص. أَمَان إِي ذَاس غَا ؤُشغ نش اَذ ذوْڒن ذَايس اَمشْنَاو يجّن ن ڒْعُنْصَر اَزَّايس ثسْفِي ثُوْذَارْث ن ڒبْدَا."<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />ثنَّا-ٱس ثمْغَارْث نِّي: "آ سِيذِي، ؤُش-اَيِي اَمَان نِّي حمَا وَار تْفِيذِيغ شَا، وَار د تِيسغ شَا وَار تَايْمغ شَا اَمَان سَّانِيتَا."<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />ينَّا-ٱس عِيْسَى: "رُوْح ڒَاغَا-د إِ ورْيَاز نّم، ذْوڒ-د ذَانِيتَا."<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />ثنَّا-ٱس ثمْغَارْث نِّي: "وَار غَاري بُو اَرْيَاز."</para>
  <para style="p" vid="JHN 4:17">ينَّا-ٱس عِيْسَى: "وَاه، شم ثسِّيوْڒذ نِيشَان وَامِي ثنِّيذ وَار غَارِي بُو اَرْيَاز، <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />مِينْزِي ثُوْوِيذ خمْسَا ن يرْيَازن. أَرْيَاز نِّي مِيكذ تْعِيشذ ڒخُّو وَار يدْجِي بُو ذ اَرْيَاز نّم. إِيوَا غَارم صَّح ذِي مِين ثنِّيذ."<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />ثنَّا-ٱس ثمْغَارْث نِّي: "آ سِيذِي، تْوَاڒِيغ شك ذ نَّبي. <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />ڒجْذُوْذ نّغ عبّْذن أَربِّـي ذݣ وذْرَار-أَ، كنِّيو يسْرَائِيلِيْين ثقَّارم قَا يتْخصَّا أَ نعْبذ ذݣ ؤُمْشَان ن لْقُدْس."<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />ينَّا-ٱس عِيْسَى: "تِيقَّا-ٱيِي آ ثَمْغَارْث، أَذ د تَاس يجّن ن ڒْوقْث اَتَاف كنِّيو وَار ثْعبّْذم شَا بَابَا ؤُڒَا ذݣ وذْرَار-أَ ؤُڒَا ذِي لْقُدْس. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />كنِّيو ثْعبّْذم ونِّي وَار ثسِّينم شَا، نشِّين نْعبّذ ونِّي إِي نسّن مِينْزِي اَسنْجم يكَّا-د زݣ يسْرَائِيلِيْين. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />وَلَكِن اَذ د تَاس ڒْوقْث اَقَا ڒخُّو ثُوْسَا-د، مَعْلِيك يِنِّي يعبّْذن نِيشَان اَتَاف اَذ عبّْذن بَابَا س لْحَقِيقَا ذ اَرُّوْح. ذ يِيْنَا إِي خف يرزُّو بَابَا. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />أَربِّـي نتَّا ذ اَرُّوْح، يِنِّي إِي ث يعبّْذن، يتْخصَّا-يَاسن اَث عبْذن س لْحَقِيقَا ذ اَرُّوْح."<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />ثنَّا-ٱس ثمْغَارْث نِّي: "نش قَا سّْنغ اَذ د يَاس لْمَسِيَا، قَّارن-اَس لْمَسِيح. خْمِي د غَا يَاس اَذَانغ يِينِي كُڒْشي."<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />ينَّا-ٱس عِيْسَى: "قَا ذ نش إِي كِذم يسَّاوَاڒن."<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />وَامِي د عقْبن يمحْضَارن نّس، تْعجّْبن وَامِي ث ؤُفِين يسَّاوَاڒ اَك يِجّن ن ثمْغَارْث. وَلَكِن وَار ذَاس ينِّي ؤُڒَا ذ يجّن مِين غَارس ثْرزُّوذ غَار ثَا؟ نِغ، مَايمِّي إِي كِذس ثسَّاوَاڒذ؟<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />ثجَّا ثمْغَارْث نِّي اَقْذِيح<note caller="+" style="f"><char style="fr" closed="false">4‏.28 </char><char style="ft" closed="false">أَقْذِيح نتَّا ذ ثَݣمْبُوْرْث نِغ ذ ثَقدْجَاڒْث. </char></note> نّس ثْرُوْح غَار ثنْدِينْت، ثنَّا-ٱسن إِ يوْذَان: <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />"أَرَاحم-د اَذ تࢲرم يجّن ن ورْيَاز ينَّا-ٱيِي مَارَّا مِين ݣِّيغ. يمْكن ذ لمَسِيح نِغ؟" <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />فّْغن يِوْذَان نِّي زِي ثنْدِينْت رُوْحن غَارس.<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />ذِي ڒْوقْث نّي قَّارن-اَس يمحْضَارن آ لْمُعَلِّم، ٱشّ!<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />وَلَكِن نتَّا ينَّا-ٱسن: "غَارِي مِين تتّغ، كنِّيو وَار ث ثسِّينم شَا."<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />ئِمحْضَارن نّس سّقْسَان اَيَاوْيَا مَا يُوْوِي-اَس-د حَدّ مِين غَا يشّ؟<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />ينَّا-ٱسن عِيْسَى: "ڒْمَكْلَا ينُو اَذ خذْمغ مِين يخس ونِّي ذَايِي د يسّكّن اَذ كمّْڒغ ڒْخذْمث نّس. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />غَارْوم يجّن ن لْمِثَال يقَّار: منْبَعْد إِ اَرْبعَا ن شْهُوْرَاث اَذ د تَاس ڒْوقْث ن ومْجَار. نش اَذَاوم ينِيغ: رزْمث ثِيطَّاوِين نْوم خْزَارث يمَرْجعِيون، ثُوْوض-د ڒْوقْث ن ومْجَار. <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />ونِّي يمجَّارن اَذ ييْسِي تخْڒِيسث نّس يجمّع ثَفدْجَاحْث إِ ثُوذَارْث ن ڒبْدَا، حمَا اَذ مُوْنن ذِي ڒفْرَاحث نْسن يِنِّي يزَرّْعن ذ يِنِّي يمجَّارن. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />يعْنِي ذ صَّح مِين يقَّار لْمِثَال: ئِجّن يزرّع، ئِجّن يمجَّار. <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />نش سّكّغ-د كنِّيو اَذ تمْجَارم مَانِي وَار ثْزرْعم شَا. ئِنّغْنِي زرْعن، كنِّيو ثسْتنْفَعم زِي ڒْخذْمث نْسن."<verse eid="JHN 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />أَطَّاس ن يِوْذَان زِي جِّهث ن سَمَارْيَا ؤُمْنن زِي عِيْسَى وَامِي ثشْهذ ثمْغَارْث نِّي ثنَّا-ٱسن قَا ينَّا-ٱيِي مَارَّا مِين ݣِّيغ. <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />وَامِي إِي غَارس د ؤُسِين يِوْذَان زِي سَمَارْيَا عَرْضن-ث اَكِذْسن يقِّيم. سّنِّي يقِّيم اَكِذْسن يُوْمَاين ذِنِّي. <verse eid="JHN 4:40" /><verse number="41" style="v" sid="JHN 4:41" />وَامِي سْڒِين اَوَاڒ ن عِيْسَى مَارْنِين يِوْذَان إِي زَّايس يُوْمْنن. <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />نَّان-اَس إِ ثمْغَارْث نِّي نشِّين وَار نْتِيمن شَا ڒخُّو غِير عْلَاحْسَاب مِين ذَانغ ثنِّيذ شم، مِينْزِي يسِّيوڒ اَكِذْنغ س يِيخف نّغ أُو نشِّين نسّن بلِّي ذ صَّح ذ وَا إِݣ يسنْجَامن دُّنشْت.<verse eid="JHN 4:42" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا مِّيس ن يِج ومْخَازْنِي</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />منْبَعْد إِ يُوْمَاين يفّغ سّنِّي عِيْسَى، ئِرُوْح غَار ثْمُوْرْث ن لْجَالِيل. <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />أُو نتَّا س يِيخف نّس يقَّار ؤُڒَا ذ يجّن ن نَّبِي مَا محْتَارم ذِي ثْمُوْرْث نّس. <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />وَامِي يُوْوض غَار لْجَالِيل رحّْبن زَّايس يِوْذَان مِينْزِي نِثْنِي ࢲْرِين مَارَّا ثِمسْڒَايِين إِݣ يݣَّا ذِي ڒْعِيذ ذِي لْقُدْس. ؤُڒَا ذ نِثْنِي تُوْغَا حْضَارن ذِنِّي ذِي ڒْعِيذ.<verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />يُوْسَا-د عَاوذ غَار وبِيلَاج ن قَانَا ذِي ثْمُوْرْث ن لْجَالِيل مَانِي تُوْغَا يَارَّا اَمَان عَادِي ذ اَمَان ن وضِيڒ. أُو ذݣ وبِيلَاج ن كَفرْنَاحُوْم ذِنِّي يِجّن زݣ يمْخَازْنِيْين ن وزدْجِيذ يهْڒش مِّيس. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />أَمْخَازْنِي نِّي وَامِي د يَارَّا ڒخْبَار عِيْسَى يُوْسَا-د زِي ثْمُوْرْث ن يَهُوْذِيَا غَار ثْمُوْرْث ن لْجَالِيل، ئِرُوْح غَارس ينَّا-ٱس مَا كِذِي ثهْوِيذ حمَا اَذ تسْݣنْفِيذ ممِّي؟ قَا عْڒَاين اَذ يمّث.<verse eid="JHN 4:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 4:48" />ينَّا-ٱس عِيْسَى: "كنِّيو، مَا وَار تِيمْنم شَا حتَّا ٱذ ثࢲرم لْمُعْجِيزَاث ذ لْبُرْهَانَاث؟"<verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />ينَّا-ٱس ومْخَازْنِي: "آ سِيذِي، يَالَّاه اَكِذِي ثهْوِيذ قْبڒ مَا ٱذ يمّث وحنْجِير ينُو."<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />ينَّا-ٱس عِيْسَى: "رُوْح، أَقَا مِّيش يدَّر."</para>
  <para style="p" vid="JHN 4:50">أَرْيَاز نِّي يُوْمن زݣ وَاوَاڒ نِّي إِي ذَاس ينَّا عِيْسَى أُوْشَا يرُوْح. <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />ئِهوَّا-د نتَّا، مْسڒْقَان اَكِذس يخدَّامن نّس نَّان-اَس قَا اَحَرْمُوْش نّش يدَّر.<verse eid="JHN 4:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52" />ئِسّقْسَا-ثن ينَّا-ٱسن: "مَان ثْسَعَّات نِّي إِݣ يݣنْفَا؟"</para>
  <para style="p" vid="JHN 4:52">نَّان-اَس: "غَار لْوَاحْذَا ن يِضنَّاظ اَݣ وعشِّي ثْرُوْح خَاس ثْمسِّي إِي ذَايس."<verse eid="JHN 4:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 4:53" />ڒخْدّنِّي يُوْفَا بَابَاس قَا ذِي ڒْوقْث نِّي إِي ذَاس ينَّا عِيْسَى مِّيش اَذ يدَّر. يُوْمن نتَّا ذ مَارَّا اَيثْبَاب ن ثدَّارْث نّس. <verse eid="JHN 4:53" /><verse number="54" style="v" sid="JHN 4:54" />ذ ثَانِيتَا ذ لْمُعْجِيزَا وِيس ثْنَاين إِݣ يݣّا عِيْسَى زݣ وَامِي إِي د يفّغ زِي ثْمُوْرْث ن يَهُوْذِيَا غَار ثْمُوْرْث ن لْجَالِيل.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا يجّن ن ونشْرُوْف</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />منْبَعْد إِ مَانَايَا يݣَعّذ عِيْسَى غَار ثنْدِينْت ن لْقُدْس ذݣ يِجّن ن ڒْعِيذ ن أَيث-إِسْرَائِيل. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />ذِي لْقُدْس زَّاث إِ ثوَّارْث وحُوْڒِي ذِنِّي طَّارْف نّس يجّن ن صَّرِيج قَّارن-اَس س وَاوَاڒ ن أَيث-إِسْرَائِيل بَيْت حِسْدَا، غَارس خمْسَا ن يسقِّيفن. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />تْغِيمَان ذِنِّي اَطَّاس ن يمهْڒَاش ذ يضَرْغَاڒن ذ يزحَّافن ذ ينشْرُوْفن،<note caller="+" style="f"><char style="fr" closed="false">5‏.3 </char><char style="ft" closed="false">أَنشْرُوْف نتَّا زݣ يِنِّي يشَرّْفن زݣ يضَارن نِغ زݣ وعْرُوْر وَار زمَّرن شَا اَذ ؤُيُوْرن.</char></note> {تْرَاجَان اَمَان ن صَّرِيج اَذ نْهزّن. <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />ثْهوَّا-د يجّن ن لْمَالَائِكَا ن أَربِّـي غَار صَّرِيج نِّي ثْسنْهزَّا اَمَان نّس. ونِّي غَا يهْوَان ذ اَمزْوَارُو ذݣ وَامَان نِّي خْمِي تنْهزَّان اَتَاف اَث سْݣنْفَان زِي ڒهْڒَاش نّس مَامّش مَا يݣَّا.}<verse eid="JHN 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 5:5" />ذِنِّي يجّن ن ومهْرُوْش ثْمنْيَا أُو ثْرَاثِين يسݣّْوُوْسَا نتَّا يهْڒش. <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />يُوْفِي-ث عِيْسَى يزّڒ ذِنِّي، ئِسّن قَا اَطَّاس ن ڒْوقْث زݣ وَامِي نتَّا يهْڒش. ينَّا-ٱس: "مَا ثخْسذ اَذ تݣنْفِيذ؟"<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />ينَّا-ٱس ومهْڒُوْش نِّي: "آ سِيذِي، وَار غَارِي وِي ذَايِي غَا يسرْسن ذِي صَّرِيج خْمِي تنْهزَّان وَامَان. نش مڒْمِي مَا رزُّوْغ اَذ هْوِيغ، تِيزْوَارن-اَيِي ينّغْنِي."<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />أُوْشَا ينَّا-ٱس عِيْسَى: "كَّر، إِيْسِي ثَاسُّوْث نّش، ؤُيُوْر." <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />ڒخْدّنِّي يݣنْفَا ورْيَاز نِّي، ييْسِي ثَاسُّوْث نّس يُويُوْر. ذِي نْهَار ن سّبْث ن لْعِبَادَا إِݣ يوْقع مَانَايَا.<verse eid="JHN 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 5:10" />كَّرن يسْرَائِيلِيْين نَّان-اَس إِ ونِّي يݣنْفَان: "نْهَارَا ذ نْهَار ن سّبْث ن لْعِبَادَا، وَار غَارك بُو ڒْحَقّ اَذ تيْسِيذ ثَاسُّوْث نّش."<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />ينَّا-ٱسن: "ونِّي ذَايِي يسْݣنْفَان ينَّا-ٱيِي إِيْسِي ثَاسُّوْث نّش، ؤُيُوْر."<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />نَّان-اَس: "وِي ذَاش ينَّان إِيْسِي ثَاسُّوْث نّش، ؤُيُوْر؟"<verse eid="JHN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13" />أَرْيَاز نِّي وَار يسِّين شَا مِين يعْنَا ونِّي إِي ث يسْݣنْفَان مِينْزِي عِيْسَى يودَّار ذِي ڒْغَاشِي نِّي.<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />منْبَعْد إِ مَانَاينِّي عِيْسَى يُوْفَا ونِّي <char style="it">يݣنْفَان</char> اَقَاث ذِي ثمْزِيذَا ثَمقّْرَانْت ن أَيث-إِسْرَائِيل ينَّا-ٱس: "أَقَاش ثْݣنْفِيذ، وَار تݣّ بُو ڒْمُعْصِيَاث عَاوذ حمَا وَار ذَاش يتوْقِيع كْتَار زِي مِين تُوْغَا ذَايش."<verse eid="JHN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15" />ئِرُوْح ورْيَاز نِّي ينَّا-ٱسن إِ يسْرَائِيلِيْين قَا ذ عِيْسَى إِي ذَايِي يسْݣنْفَان. <verse eid="JHN 5:15" /><verse number="16" style="v" sid="JHN 5:16" />س مَانَاينِّي رزُّوْن يسْرَائِيلِيْين اَذ عدّْبن عِيْسَى مِينْزِي يتݣّ مَانَايَا ذِي نْهَار ن سّبْث ن لْعِبَادَا.<verse eid="JHN 5:16" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسنْجَام يوْذَان يتِيشّ-اَسن ثُوْذَارْث</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 5:17" />ينَّا-ٱسن عِيْسَى: "بَابَا يخدّم ڒبْدَا، ؤُڒَا ذ نش خدّْمغ اَم نتَّا."<verse eid="JHN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18" />س مَانَايَا يسْرَائِيلِيْين رزُّون كْتَار اَث نْغن. وَار يدْجِي بُو خ سَّبَاب ن نْهَار ن لْعِبَادَا أُو صَافِي، وَلَكِن عَاوذ خْمِي ذَاسن يقَّار بلِّي أَربِّـي ذ بَابَاس يتمْسَاوَا يخف نّس اَك أَربِّـي.<verse eid="JHN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />ينَّا-ٱسن عِيْسَى: "أَقَا تسْڒَام ڒْحَقّ: مِّيس وَار يزمَّر اَذ يݣّ شَان ثْمسْڒَايْث س يِيخف نّس، غِير مِين يࢲرّ زِي بَابَاس اَقَا يتݣّ-يث. مِين مَا يتݣّ بَابَاس اَقَا يتݣّ-يث ؤُڒَا ذ مِّيس. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />بَابَاس يتخْس مِّيس، يسْبيَّان-اَس مَارَّا مِين يتݣّ. أَذَاس يسْبيّن ڒخْذَايم ثِمقّْرَانِين خ ثْمسْڒَايِين-أَ حمَا اَذ تْعجّْبم! <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />مَامّش د يسْنكَّر بَابَاس يِنِّي يمُّوْثن يتِيشّ-اَسن ثُوْذَارْث، ؤُڒَا ذ مِّيس يتِيشّ-اَسن ثُوْذَارْث إِ يِنِّي يخس. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />بَابَاس وَار يتْحِسِّيب حَدّ، يُوْشَا-ٱس لْحِسَاب مَارَّا إِ مِّيس <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />حمَا مَارَّا اَذ كَرْمن مِّيس اَمش تْكَرَّامن بَابَاس. ونِّي وَار يتْكَرِّيمن شَا مِّيس وَار يتْكَرِّيم شَا ؤُڒَا ذ بَابَاس إِي ثِيذ يسّكّن.<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />أَقَا تسْڒَام ڒْحَقّ: ونِّي يتْسْڒَان إِ وَاوَاڒ ينُو يتَامن زݣ ونِّي ذَايِي د يسّكّن، أَغَارس ثِيڒِي ثُوْذَارْث ن ڒبْدَا وَار يتِيذف شَا ذِي لْعِقَاب، نتَّا اَذ يمُوْتِّي زِي ڒْمُوْث غَار ثُوْذَارْث. <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />أَقَا تسْڒَام ڒْحَقّ: أَذ د تَاس ڒْوقْث اَقَا ڒخُّو ثُوْسَا-د، أَذ سْڒن يمتِّينن إِ صُّوْت ن مِّيس ن أَربِّـي أُو يِنِّي ذَاس غَا يسْڒن اَذ دَّرن. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />أَم بَابَاس غَارس ثُوْذَارْث ذݣ يِيخف نّس، أَمُّو إِي ذَاس يُوْشَا إِ مِّيس اَغَارس ثِيڒِي ثُوْذَارْث ذݣ يِيخف نّس. <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />يُوْشَا-ٱس عَاوذ جّْهذ حمَا اَذ يحَاسب مِينْزِي نتَّا ذ مِّيس ن بْنَاذم.<verse eid="JHN 5:27" /></para>
  <para style="p">
    <verse number="28‏-29" style="v" sid="JHN 5:28-29" />وَار تْعجِّيبم شَا خ مَانَايَا، قَا اَذ د تَاس ڒْوقْث ذَايس غَا سْڒن صُّوْت نّس مَارَّا يِنِّي يدْجَان ذݣ يمضْڒَان نِثْنِي اَذ د كَّرن. يِنِّي يݣِّين ثِمسْڒَايِين ثِصبْحَانِين اَذ رَاحن غَار ثُوْذَارْث. يِنِّي يݣِّين ثِمسْڒَايين ثِعفَّانِين اَذ د كَّرن اَذ رَاحن غَار لْعِقَاب. <verse eid="JHN 5:28-29" /><verse number="30" style="v" sid="JHN 5:30" />نش وَار زمَّرغ اَذ ݣّغ وَالُو زݣ يِيخف ينُو. مَامّش تسْڒِيغ، أَمُّو تْحَاسَابغ. لْحِسَاب ينُو ن ڒْحَقّ مِينْزِي نش وَار رزُّوْغ شَا مِين خْسغ؛ لَّا، رزُّوْغ مِين يخس ونِّي إِي ذَايِي-د يسّكّن."<verse eid="JHN 5:30" /></para>
  <para style="s">ئِشهّذ أَربِّـي خ سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />"مَعْلِيك شهْذغ خ يِيخف ينُو، إِڒِي شْهَاذث ينُو وَار ثدْجِي بُو نِيشَان. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />ئِجّن نّغْنِي يشهّذ خَافِي. نش سّْنغ شْهَاذث إِي خَافِي يشهّذ نتَّاث نِيشَان إِي ثدْجَا.<verse eid="JHN 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 5:33" />كنِّيو تُوْغَا ثْسّكّم-د غَار يَحْيَى، نتَّا يشْهذ خ لْحَقِيقَا. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />وَلَكِن نش وَار حْذِيجغ شَا شْهَاذث ن بْنَاذم. قَّارغ-اَوم مَانَايَا حمَا اَذ تْنجْمم. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />يَحْيَى يُوْسَا-د ذ ڒفْنَار يرقَّان يتشْرِيقن، كنِّيو ثخْسم اَذ تْفَرْحم شَان ڒِيَّام س نُّوْر نّس. <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />وَلَكِن نش غَارِي يجّن ن شْهَاذث ذ ثَمقّْرَانْت خ ثنِّي ن يَحْيَى. مِين ذَايِي د يُوْشَا بَابَا اَثِيد سْبَانغ، ثِمسْڒَايِين-أَ س يِيخف نْسنْت شهّْذنْت خَافِي بلِّي يسّكّ-اَيِي-د بَابَا. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />بَابَا ذَايِي د يسّكّن ذ نتَّا إِي خَافِي يشهْذن. كنِّيو عمَّارْص وَار ثسْڒِيم شَا صُّوْت نّس، عمَّارْص وَار ثࢲْرِيم شَا ؤُذم نّس. <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />أَوَاڒ نّس وَار ذَايوم يتْغِيمِي شَا مِينْزِي ونِّي إِي ثِيد يسّكّن وَار زَّايس تِيمْنم شَا. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />ثْرزُّوم ذِي لْكُتُب كنِّيو تْغِير-اَوم ذَايْسن ثُوْذَارْث ن ڒبْدَا. إِيوَا ؤُڒَا ذ يِيْنَا شهّْذن خَافِي. <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />وَاخَّا اَمنِّي كنِّيو وَار ثْخِيسم شَا اَغَارِي د تَاسم حمَا اَغَارْوم ثِيڒِي ثُوْذَارْث.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />وَار حْذِيجغ شَا اَذَايِي سمْغَارن يِوْذَان. <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />سّْنغ-كنِّيو بلِّي وَار ذَايْوم بُو ڒمْحِبّث ن أَربِّـي. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />نش ؤُسِيغ-د ذݣ يِيسم ن بَابَا، كنِّيو وَار ذَايِي ثقْبِيڒم شَا. وَلَكِن، مڒَا يُوْسَا-د شَان يِجّن نّغْنِي غَارْوم ذݣ يِيسم نّس نِّيث وَاهَا اَث ثْقبْڒم.<verse eid="JHN 5:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 5:44" />مَامّش غَا ثݣّم اَذ تَامْنم؟ إِيوَا كنِّيو تخْسم لْعَظَمَا ن وَايَاوْيَا، وَار ثْرزُّوْم شَا خ لْعَظَمَا ن أَربِّـي اَوحْذَانِي. <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />وَار تْفكَّرم شَا أَزَّايوم شثْشِيغ غَار بَابَا؛ لَّا، ونِّي إِي زَّايْوم غَا يشثْشَان نتَّا ذ مُوْسَى ونِّي ذِي ثݣِّيم لْأَمَال نْوم. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />مَعْلِيك كنِّيو ثُوْمْنم ذِي مُوْسَى، إِڒِي ثُوْمْنم ذَايِي ؤُڒَا ذ نش مِينْزِي نتَّا يُوْرَا خَافِي. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />مڒَا كنِّيو وَار ثُوْمِينم شَا زِي مِين يُوْرَا، مَامّش غَا ثݣّم اَذ تَامْنم ذݣ وَاوَاڒ ينُو؟"<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">سِيذِيثْنغ عِيْسَى يتِيشّ إِ خمْسَاڒَاف ن يرْيَازن اَذ شّن</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />منْبَعْد إِ مَانَايَا يرُوْح عِيْسَى اَذ يࢲْوَا ڒبْحَر ن لْجَالِيل (قَّارن-اَس إِ ڒبْحَر نِّي طَبَرْيَا). <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />ذْفَارن-ث اَطَّاس ن يِوْذَان وَامِي ࢲْرِين لْمُعْجِيزَاث نِّي وَامِي يسْݣنْفَا يمهْڒَاش. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />ئِݣَعّذ عِيْسَى غَار وذْرَار يقِّيم اَك يمحْضَارن نّس. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />ڒْعِيذ اَمقّْرَان ن أَيث-إِسْرَائِيل وَار ذَاس يقِّيم شَا اَذ د يَاوض. <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />ئِيْسِي عِيْسَى ثِيطَّاوِين نّس يُوْفَا ڒْغَاشِي ݣُّوْرن-د غَارس، ينَّا-ٱس إِ فِيلِيپَّـاس: "مَانِيس د غَا نْسغ اَغْرُوْم بَاش اَذَاسن نُوْش إِ يِيْنَا اَذ شّن؟" <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />ئِقَّار-اَس اَمُّو حمَا اَث يجَرّب ڒَاحقَّاش نتَّا يسّن مِين غَا يخْذم.<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />ينَّا-ٱس فِيلِيپَّـاس: "مڒَا نْسغ-د اَغْرُوْم س مِيَّاتَاين ن ثْپِـيَّاسِين ن نُّقَارْث، وَار يتْقِدِّي ؤُڒَا ذ يجّن ن ورمُّوْز إِ يِجّن."<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />ينَّا-ٱس يجّن زݣ يمحْضَارن نّس، نتَّا ذ أَنْدْرُوْس ؤُمَاس ن سِمْعَان بُطْرُس: <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />"أَقَا يج وحنْجِير غَارس خمْسَا ن ثْخبَّازِين ن يمنْدِي ذ ثْنَاين ن يسڒْمَان، وَلَكِن مَانَايَا وَار ذَاسن يتْقِيدِّي شَا إِ ڒْغَاشِي-يَا."<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />ينَّا-ٱسن عِيْسَى: "سْغِيمث يِوذَان-أَ." أَمْشَان نِّي مَانِي قِّيمن ذِنِّي اَطَّاس ن اَرْبِيع أُو ذِنِّي شَان خمْسَاڒَاف ن يرْيَازن. <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />ئِيْسِي-د عِيْسَى اَغْرُوْم نِّي يشكَّر أَربِّـي، يفرق-يث إِ يِنِّي إِي ذِنِّي يقِّيمن. أَمُّو يݣَّا ؤُڒَا إِ يسڒْمَان، <char style="it">ؤُشِين-اَسن</char> عْلَاحْسَاب مِين رزّْوْن.<verse eid="JHN 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 6:12" />وَامِي جِّيوْنن، ينَّا-ٱسن إِ يمحْضَارن نّس: "جمْعث يڒقُّوْزن نِّي يشطّن حمَا وَار يتمْضيِّيع وَالُو." <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />وَامِي جمْعن، ؤُفِين ثنْعَاش ن ثقْرَابِين شُّوْرنْت زݣ يڒقُّوْزن نِّي يشطّن خ يِنِّي يشِّين زِي خمْسَا ن ثْخبَّازِين ن يمنْدِي نِّي.<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />وَامِي ࢲْرِين لْمُعْجِيزَا نِّي إِي يݣّا، ئِوْذَان نَّان قَا ذ وَانِيتَا ذ نَّبي ذ صَّح تُوْغَا د غَا يَاسن اَذ يِيڒِي ذِي دُّنشْت-أَ.<verse eid="JHN 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 6:15" />يسّن عِيْسَى بلِّي رزُّوْن اَث اَرَّان ذ اَزدْجِيذ س بسِّيف. ئِكَّر يُوْيُوْر سّنِّي، ئِذْوڒ غَار يذُوْرَار وَاحْذس.<verse eid="JHN 6:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />أَݣ وعشِّي، هْوَان-د يمحْضَارن نّس غَار ڒبْحَر. <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />نْيِين ذِي ثْغَرَّابُوْت رَاحن اَذ قضْعن ڒبْحَر غَار وبِيلَاج ن كَفرْنَاحُوْم. ثُوْوض-د دْجِيڒث أُو عِيْسَى نتَّا عَاذ وَار غَارْسن د يُوْسِي. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />ئِكَّر-د اَكِذْسن ڒبْحَر، يتْصُوْض اَرِّيح اَطَّاس. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />وَامِي نِثْنِي تُوْغَا ؤُيُوْرن شَان خمْسَا نِغ ستَّا كِيلُوْمِت، ࢲْرِين عِيْسَى يݣُّوْر خ يضَارن خ وَامَان ن ڒبْحَر يقَارّب-د غَار ثْغَرَّابُوْت، نْخڒْعن س ثِيݣّْوْذِي.<verse eid="JHN 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 6:20" />ينَّا-ٱسن: "أَقَا ذ نش، وَار تݣّْوْذم شَا." <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />أُوْشَا قبْڒن-ث س ڒْخَاضَر نْسن اَذ يَاڒِي ذِي ثْغَرَّابُوْت. ڒخْدّنِّي ثَغَرَّابُوْت ثُوْوض غَار ڒْبَرّ مَانِي تُوْغَا ݣِّين اَذ رَاحن.<verse eid="JHN 6:21" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى نتَّا ذ اَغْرُوْم ن ثُوْذَارْث</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />ثِيوشَّا نّس، ڒْغَاشِي نِّي يقِّيمن اَجمَّاض إِ ڒبْحَر فقْذن بلِّي تُوْغَا ذِنِّي يجّن ن ثْغَرَّابُوْت وَاهَا وَار ت ؤُفِين شَا. نِثْنِي سّْنن عِيْسَى وَار يُوْڒِي شَا ذِي ثْغَرَّابُوْت نِّي، ئِمحْضَارن نّس ؤُيُوْرن وَاحذْسن. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />سّنِّي ؤُسِينْت-يد ثْغَرُّوْبَا نّغْنِي زِي ثنْدِينْت ن طَبَرْيَا غَار ومْشَان نِّي مَانِي شِّين اَغْرُوْم نِّي مَانِي يشكَّر عِيْسَى أَربِّـي. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />وَامِي ڒْغَاشِي نِّي وَار ࢲْرِين شَا عِيْسَى ذِنِّي ؤُڒَا ذ يمحْضَارن نّس، نْيِين ؤُڒَا ذ نِثْنِي ذِي ثْغَرُّوْبَا ؤُيُوْرن سّنِّي رُوْحن غَار كَفرْنَاحُوْم رزُّوْن خ عِيْسَى.<verse eid="JHN 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />وَامِي ث ؤُفِين غَار وجمَّاض-ين إِ ڒبْحَر نَّان-اَس: "آ لْمُعَلِّم، مڒْمِي ذَا د تُوْسِيذ ذَانِيتَا؟"<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />ينْدق-د عِيْسَى ينَّا-ٱسن: "أَقَا تسْڒَام ڒْحَقّ: كنِّيو ثْرزُّوْم خَافِي وَار يدْجِي بُو وَامِي ثࢲْرِيم لْمُعْجِيزَاث، كنِّيو ثْرزُّوْم خَافِي وَامِي ثشِّيم ثْجِّيوْنم اَغْرُوْم. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />وَار خدّْمث شَا إِ ڒْمَكْلَا يخسَّرن، خذْمث إِ ڒْمَكْلَا يتْغِيمَان إِ ثُوْذَارْث ن ڒبْدَا. ذ ثَا ذ ڒْمَكْلَا ذَاوم غَا يُوْش مِّيس ن بْنَاذم مِينْزِي وَانِيتَا يضْبع-يث أَربِّـي بَابَاس س طَّابَع نّس."<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />نَّان-اَس: "مِين يتْخصَّا أَ نݣّ حمَا أَ نْزمَّر أَ نخْذم ڒخْذَايم ن أَربِّـي؟"<verse eid="JHN 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29" />ينَّا-ٱسن عِيْسَى: "ذ ثَا ذ ڒْخذْمث ن أَربِّـي: أَذ تَامْنم زِي ونِّي إِي د يسّكّ نتَّا."<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />نَّان-اَس: "مَان لْعَلَامَا ثَمقّْرَانْت إِي غَا ثݣّذ اَت نْࢲر حمَا اَزَّايك نَامن؟ مِين غَا ثݣّذ؟ <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />ذِي ڒخْڒَا ڒجْذُوْذ نّغ شِّين اَغْرُوْم نِّي ؤُمِي قَّارن لْمَنَّا مَامّش د يُوْسَا ذِي لْكِتَاب: &lt;يُوْشَا-ٱسن-د اَغْرُوْم زݣ وجنَّا حمَا اَث شّن.&gt;"<verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />ينَّا-ٱسن عِيْسَى: "أَقَا تسْڒَام ڒْحَقّ: وَار يدْجِي بُو ذ مُوْسَى إِي ذَاوم يُوْشِين اَغْرُوْم زݣ وجنَّا؛ لَّا، ذ بَابَا إِي ذَاوم يتِيشّن اَغْرُوْم ن صَّح زݣ وجنَّا. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />مِينْزِي اَغْرُوْم ن أَربِّـي نتَّا ذ ونِّي إِي د يهوَّان زݣ وجنَّا يتِيشّ-اَس ثُوْذَارْث إِ دُّنشْت."<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />نَّان-اَس: "إِيوَا آ سِيذِي، ؤُش-اَنغ اَغْرُوْم-أَ إِ ڒبْدَا."<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />ينَّا-ٱسن عِيْسَى: "نش ذ اَغْرُوْم ن ثُوْذَارْث. ونِّي إِي غَاري د غَا يَاسن وَار يتْڒِيزِي عمَّارْص. ونِّي زَّايِي غَا يَامْنن وَار يتْفِيذِي عمَّارْص. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />وَلَكِن نِّيغ-اَوم: وَاخَّا ثࢲْرِيم-اَيِي كنِّيو، وَار تِيمْنم شَا. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />مَارَّا مِين ذَايِي د يتِيشّ بَابَا يتَاس-د غَارِي. ونِّي إِي د يتَاسن غَارِي وَار ث سِݣّوِيجغ شَا. <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />مِينْزِي نش هْوِيغ-د زݣ وجنَّا، وَار يدْجِي شَا اَذ ݣّغ مِين خْسغ؛ لَّا، هْوِيغ-د اَذ ݣّغ مِين يخس ونِّي إِي ذَايِي د يسّكّن. <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />مِين يخس ونِّي إِي ذَايِي د يسّكّن؟ يخس بلِّي زِي مَارَّا مِين ذَايِي يُوْشَا وَار ذَايِي يتْودَّار ؤُڒَا ذ يجّن، أَثن د سكَّرغ ذِي نْهَار اَنݣَّارُو. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />مِين يخس بَابَا؟ يخس بلِّي كُڒ ونِّي يࢲْرِين مِّيس يُوْمن زَّايس، أَغَارس ثِيڒِي ثُوْذَارْث ن ڒبْدَا نش اَثِيذ سكَّرغ ذِي نْهَار اَنݣَّارُو."<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />بْذَان يسْرَائِيلِيْين نِّي تْشثْشَان زَّايس وَامِي ذَاسن ينَّا قَا نش ذ اَغْرُوْم إِي د يهْوَان زݣ وجنَّا. <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />نَّان: "وَانِيتَا، مَا وَار يدْجِي شَا ذ عِيْسَى ذ مِّيس ن يُوسف نِغ؟ نشِّين نسّن بَابَاس ذ يمَّاس، مَامّش غَا يِينِي قَا نش هْوِيغ-د زݣ وجنَّا؟"<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />ينَّا-ٱسن عِيْسَى: "وَار تْشثْشَام شَا جَارَاوم. <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />وَار يزمَّر ؤُڒَا ذ يجّن اَذ د يَاس غَارِي إِلَّا مڒَا س لْإِذن ن بَابَا إِي ذَايِي د يسّكّن، نش اَثِيذ سكَّرغ ذِي نْهَار اَنݣَّارُو. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />أَمُّو إِي يُوْرَا يجّن زِي لْأَنْبِيَا: &lt;مَارَّا اَذ ڒمْذن زِي أَربِّـي.&gt; مَارَّا ؤُو إِي س يسْڒِين إِ بَابَا اَذ يڒْمذ زَّايس اَتَاف اَغَارِي د يَاس. <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />وَار يدْجِي ؤُڒَا ذ يجّن يࢲْرَا بَابَا إِلَّا ونِّي إِي د يُوْسِين زِي أَربِّـي، ذ نتَّا إِݣ يࢲْرِين بَابَا. <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />أَقَا تسْڒَام ڒْحَقّ: ونِّي إِي غَا يَامْنن اَغَارس ثِيڒِي ثُوْذَارْث ن ڒبْدَا. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />نش ذ اَغْرُوْم ن ثُوْذَارْث. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />ڒجْذُوْذ نْوم شِّين اَغْرُوْم ن وجنَّا ذِي ڒخْڒَا، وَاخَّا اَمنِّي مُّوْثن. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />مِين يعْنَا وغْرُوْم إِي د يهْوَان زݣ وجنَّا بَاش ونِّي إِي ث غَا يشّن وَار يتْمتِّي شَا؟ <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />أَقَا ذ نش ذ اَغْرُوْم يدَّرن إِي د يهْوَان زݣ وجنَّا. مَارَّا ونِّي غَا يشّن زݣ وغْرُوْم-أَ اَذ يدَّر إِ ڒبْدَا. أَغْرُوْم-أَ إِي تِيشّغ نش ذ دَّات ينُو حمَا اَذ تدَّر دُّنشْت-أَ."<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />ئِسْرَائِيلِيْين نِّي منْغن جَارَاسن نَّان: "مَامّش غَا يݣّ وَانِيتَا اَذَانغ يُوْش دَّات نّس اَت نشّ؟"<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />ينَّا-ٱسن عِيْسَى: "أَقَا تسْڒَام ڒْحَقّ: مڒَا وَار ثشِّيم شَا دَّات ن مِّيس ن بْنَاذم وَار ثْسسّم شَا يذَامّن نّس، أَذ تِيڒِي وَار غَارْوم بُو ثُوْذَارْث ذݣ يِيخف نْوم." <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" /><char style="it">ينَّا-ٱسن:</char> "ونِّي غَا يشّن دَّات ينُو اَذ يسو يذَامّن ينُو، أَغَارس ثِيڒِي ثُوْذَارْث إِ ڒبْدَا نش اَثِيذ سكَّرغ ذِي نْهَار اَنݣَّارُو. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />مِينْزِي دَّات ينُو ذ ڒْمَكْلَا ن صَّح، ئِذَامّن ينُو ذ ثِيسسِّي ن صَّح. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />مَارَّا ونِّي غَا يشّن دَّات ينُو اَذ يسو يذَامّن ينُو، أَتَاف اَذ يقِّيم ذَايِي، نش ذَايس. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />مَامّش إِي ذَايِي د يسّكّ بَابَا يدَّرن أُو نش دَّرغ زِي بَابَا، أَمنِّي ونِّي ذَايِي غَا يشّن اَزَّايِي إِي يدَّر. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />صَافِي، ذ وَانِيتَا ذ اَغْرُوْم إِي د يهْوَان زݣ وجنَّا. وَار يدْجِي شَا اَم ڒجْذُوْذ نْوم إِي شِّين اَغْرُوْم نِّي ؤُمِي قَّارن لْمَنَّا منْبَعْد مُّوْثن؛ لَّا، ونِّي غَا يشّن زݣ وغْرُوْم-أَ اَذ يدَّر إِ ڒبْدَا."<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />مَانَايَا ينَّا-ث عِيْسَى ذِي ثمْزِيذَا وَامِي تُوْغَا يسڒْمَاذ ذݣ وبِيلَاج ن كَفرْنَاحُوْم.<verse eid="JHN 6:59" /></para>
  <para style="s">أَوَاڒن ن ثُوْذَارْث ن ڒبْدَا اَقَاثن غَار سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />أَطَّاس زݣ يمحْضَارن نّس وَامِي سْڒِين مَانَاينِّي نَّان قَا اَوَار-أَ يقْسح وَار يدْجِي وِي ث غَا يقبْڒن.<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />يعْڒم عِيْسَى س وُوْڒ نّس قَا يمحْضَارن نّس تْشثْشَان ينَّا-ٱسن: "مَا س مَانَايَا إِي زِي ذَاوم يتقّس ڒْحَاڒ؟ <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />ئِي مڒَا ثࢲْرِيم مِّيس ن بْنَاذم يتْوَارْفع غَار مَانِي يقِّيم ذ اَمزْوَارُو؟ <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />أَرُّوْح ن أَربِّـي ذ نتَّا يسّدَّرن. مِين يدْجَان ذ بنَاذم وَار ينفّع إِ وَالُو. أَوَاڒن إِي ذَاوم نِّيغ، ذَايسن أَرُّوْح ذ ثُوْذَارْث. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />وَلَكِن ذَايْوم يِنِّي وَار يتِيمْنن شَا." مِينْزِي عِيْسَى يسّن زݣ ومزْوَارُو يِنِّي ذَايْسن وَار يتِيمْنن شَا ذ ونِّي إِي ث غَا يزّنْزن. <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />ينَّا-ٱسن: "س مَانَايَا نِّيغ-اَوم: وَار يزمَّر ؤُڒَا ذ يجّن اَذ د يَاس غَارِي إِلَّا مڒَا س لْإِذن ن بَابَا." <verse eid="JHN 6:65" /><verse number="66" style="v" sid="JHN 6:66" />زِي ڒْوقْث نِّي سمْحن ذَايس اَطَّاس ن يمحْضَارن نّس، وَار كِس قِّيمن شَا ݣُّوْرن اَكِذس.<verse eid="JHN 6:66" /></para>
  <para style="b" />
  <para style="p">
    <verse number="67" style="v" sid="JHN 6:67" />ئِنْدق-د عِيْسَى ينَّا-ٱسن إِ ثنْعَاش ن اَرُّسُل إِي كِس يدْجَان: "ؤُڒَا ذ كنِّيو، مَا ثخْسم اَذَايِي تْسمْحم؟"<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />ينَّا-ٱس سِمْعَان بُطْرُس: "آ سِيذِي، مِين يعْنَا ونِّي مَانِي غَا نْرَاح؟ شك غَارك اَوَاڒن ن ثُوْذَارْث ن ڒبْدَا. <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />قَا نشِّين نُوْمن، نسّن قَا شك ذ لْعَظِيم ن أَربِّـي."<verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />ينَّا-ٱسن عِيْسَى: "نش إِي كنِّيو يخْضَرن س ثنْعَاش إِذْوم، وَلَكِن يجّن زَّايْوم ذ إِبْڒِيس."<verse eid="JHN 6:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="JHN 6:71" />مَانَايَا يقَّار-يث خ يَهُوْذَا مِّيس ن سِمْعَان إِسْخَرْيُوْطِي لِأَنَّا ذ وَانِيتَا إِي ث غَا يزّنْزن أُو نتَّا ذ يجّن زِي ثنْعَاش ن اَرُّسُل.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">سِيذِيثْنغ عِيْسَى يتْݣَعَّاذ س ثْنُوْفْرَا غَار ثنْدِينْت ن لْقُدْس</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />منْبَعْد إِ مَانَايَا عِيْسَى يݣُّوْر زݣ ومْشَان غَار ومْشَان ذِي ثْمُوْرْث ن لْجَالِيل. ئِتْبعَّاذ زِي ثْمُوْرْث ن يَهُوْذِيَا مِينْزِي يسْرَائِيلِيْين نِّي رزُّوْن خَاس اَث نْغن. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />ئِقَارّب-د يجّن ن ڒْعِيذ ن أَيث-إِسْرَائِيل ؤُمِي قَّارن &lt;ثِنْوَاڒِين.&gt; <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />نَّان-اَس أَيثْمَاس <char style="it">زݣ يمَّاس</char>:<note caller="+" style="f"><char style="fr" closed="false">7‏.3 </char><char style="ft" closed="false">س ثْيُوْنَانِيث ثقَّار "أَيثْمَاس." ڒْمَعْنَا نّس يخس اَذ يِينِي أَيثْمَاس زݣ يمَّاس وَاهَا.</char></note> "ؤُيُوْر سَّانِيتَا، رُوْح غَار ثْمُوْرْث ن يَهُوْذِيَا حمَا ؤُڒَا ذ يمحْضَارن نّش اَذ ࢲْرن مَان ڒخْذَايم إِي ثْخدّْمذ. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />وَار يدْجِي حَدّ يخدّم شَان ثْمسْڒَايْث س ثْنُوْفْرَا مڒَا يرزُّو اَث سّْنن. مڒَا تݣّذ ثِمسْڒَايِين-أَ، سْمظْهَار-د يخف نّش إِ دُّنشْت." <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />أَيثْمَاس س يِيخف نْسن وَار ؤُمِينن شَا زِي عِيْسَى.<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />ينَّا-ٱسن عِيْسَى: "ڒْوقْث ينُو عَاذ وَار د تُوْوِيض شَا حمَا اَذ رَاحغ، وَلَكِن كنِّيو اَذ تْرَاحم ذِي اَيِّي ڒْوقْث. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />دُّنشْت وَار ثْزمَّر شَا اَكنِّيو ثْعِيفّ، نش تْعِيفَّا-ٱيِي دُّنشْت مِينْزِي شهّْذغ قَا ڒخْذَايم ن دُّنشْت-أَ ذ ثِعفَّانِين. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />ݣَعّْذث كنِّيو غَار ڒْعِيذ، نش وَار تْݣَعِّيذغ شَا غَار ڒْعِيذ-أَ مِينْزِي ڒْوقْث ينُو عَاذ وَار د تُوْوِيض." <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />وَامِي ذَاسن ينَّا اَوَاڒ-أَ يقِّيم ذِي ثْمُوْرْث ن لْجَالِيل.<verse eid="JHN 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />وَلَكِن وَامِي ݣَعّْذن اَيثْمَاس غَار ڒْعِيذ، منْبَعْد يݣَعّذ ؤُڒَا ذ نتَّا. يݣَّا اَخمِي ينُّوْفَّر، وَار د يسْمظْهَار شَا يخف نّس.<verse eid="JHN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 7:11" />رزُّوْن خَاس يسْرَائِيلِيْين ذِي ڒْعِيذ نَّان مَانِيس يكَّا ورْيَاز نِّي؟ <verse eid="JHN 7:11" /><verse number="12" style="v" sid="JHN 7:12" />أَطَّاس إِݣ يتْوشْوِيشن زِي ڒْغَاشِي خَاس قَّارن نتَّا ذ اَرْيَاز ن ڒْخِير. وَلَكِن ينّغْنِي زَّايْسن قَّارن لَّا، ئِسْخَرِّيق خَانغ وَاهَا. <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />وَلَكِن ؤُڒَا ذ يجّن وَار خَاس يسِّيوڒ س جّْهذ س ثِيݣّْوْذِي زݣ <char style="it">يمقّْرَانن نِّي ن</char> أَيث-إِسْرَائِيل.<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />وَامِي يعْذُو وزْين زِي ڒْعِيذ، ئِݣَعّذ عِيْسَى غَار ثمْزِيذَا ثَمقّْرَانْت ن أَيث-إِسْرَائِيل يسڒْمَاذ ذِنِّي. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />ئِسْرَائِيلِيْين ذهّْشن نَّان: "مَامّش يݣَّا نتَّا يسّن مِين ذَايْسن ذِي لْكُتُب أُو نتَّا وَار يغْرِي شَا؟"<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />ينَّا-ٱسن عِيْسَى: "مِين سڒْمَاذغ وَار يدْجِي بُو ينُو، أَسڒْمذ-أَ ن ونِّي إِي ذَايِي د يسّكّن. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />ونِّي يخْسن اَذ يݣّ زِي مِين يخس أَربِّـي اَتَاف اَذ يسّن اَسڒْمذ-أَ ينُو مَا زَّايِي نِغ زِي أَربِّـي. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />ونِّي يسَّاوَاڒن زِي غَارس يرزُّو لْعَظَمَا إِ يِيخف نّس. ونِّي يرزُّون لْعَظَمَا ن ونِّي إِي ثِيذ يسّكّن، قَا نتَّا ذَايس لْحَقِيقَا وَار ذَايس بُو ڒْغشّ. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />ذ مُوْسَى إِي ذَاوم يُوْشِين شَّرِيعَا، نِغ؟ وَلَكِن ؤُڒَا ذ يجّن زَّايْوم مَا يتݣّ زِي شَّرِيعَا نِّي. إِيوَا، مَايمِّي ثخْسم اَذَايِي ثنْغم؟"<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />نَّان-اَس ڒْغَاشِي: "مَا ذَايك جْنُوْن شك نِغ؟ ؤُو يرزُّوْن اَش ينغ؟"<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />ينَّا-ٱسن عِيْسَى: "ݣِّيغ لْمُعْجِزَا، ثْذهْشم كنِّيو مَارَّا. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />شُوْف، يجَّا-ٱوم-د مُوْسَى طَّهَارث أُو طَّهَارث-أَ وَار ثدْجِي بُو زِي مُوْسَى لَّا، زِي سَّلَاف صَّالِحِين. خ مَانَايَا كنِّيو وَاخَّا ذِي نْهَار ن سّبْث ن لعِبَادَا تْطهَّارم إِ يحَرْمُوْشن. <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />مڒَا ثْسمّْحم يحَرْمُوْشن اَذ طهَّارن ذِي نْهَار ن لْعِبَادَا حمَا وَار تخِيلِيفم شَا شَّرِيعَا ن مُوْسَى، مَا تْعَصَّابم خَافِي وَامِي سْݣنْفِيغ يجّن ن بْنَاذم قَاع ذِي نْهَار ن لْعِبَادَا؟ <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />إِيوَا، وَار تْحَاسَابث شَا خَافِي اَمُّو وَاهَا، حَاسْبث س ڒْحَقّ."<verse eid="JHN 7:24" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتْشرَّاح مَانِيس نتَّا ذ مَانِي غَا يرَاح</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />ڒبْعَاض زِي ثنْدِينْت ن لْقُدْس نَّان، ذ وَانِيتَا يمْكن إِي يرزُّوْن اَث نْغن نِغ لَّا؟ <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />إِيوَا خْزَرث، ئِسَّاوَاڒ بْڒَا مَا ٱذ يسْنُوْفَّر يخف نّس، وَار ذَاس قَّارن وَالُو. يمْكن سّْنن اَرُّوْيَاس بلِّي ذ وَانِيتَا يدْجَان ذ لْمَسِيح؟ <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />وَلَكِن خْمِي د غَا يَاس لْمَسِيح ؤُڒَا ذ يجّن وَار يتسّن مَانِيس نتَّا. وَانِيتَا لَّا، نشِّين نسّن مَانِيس نتَّا.<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />ئِكَّر عِيْسَى يتْخَاطَاب س جّْهذ ذِي ثمْزِيذَا ثَمقّْرَانْت ن أَيث-إِسْرَائِيل يسڒْمَاذ-يثن يقَّار-اَسن: "مَا ذ صَّح ثسّْنم-اَيِي مَانِيس نش، نِغ مِين عْنِيغ؟ وَار د ؤُسِيغ شَا س يِيخف ينُو لَّا. ونِّي ذَايِي د يسّكّن غَارس لْحَقِيقَا! كنِّيو وَار ث ثسِّينم شَا. <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />نش سّْنغ-ث مِينْزِي نش زَّايس أُو ذ نتَّا إِي ذَايِي د يسّكّن." <verse eid="JHN 7:29" /><verse number="30" style="v" sid="JHN 7:30" />ڒخْدّنِّي رزُّوْن اَث طّْفن، وَلَكِن وَار خَاس يسرْس فُوْس حَدّ زَّايْسن مِينْزِي ڒْوقْث نّس عَاذ وَار د تُوْوِيض.<verse eid="JHN 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 7:31" />إِنَّمَا، اَطَّاس زِي ڒْغَاشِي نِّي ؤُمْنن زَّايس. نَّان: "مَا ٱذ د يَاس عَاذ شَا ن لْمَسِيح اَذ يݣّ لْمُعْجِيزَاث كْتَار زِي ثِيْنَا يتݣّ وَانِيتَا؟"<verse eid="JHN 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />أَرِّين-د ڒخْبَار يفَرِّيسيْين بلِّي ڒْغَاشِي تْوشْوِيشن خَاس خ ثْمسْڒَايِين نِّي. أُوْشَا كَّرن اَرُّوْيَاس ن ڒْفُقَاهَا ذ يفَرِّيسيْين سّكّن يعسَّاسن بَاش اَث طّْفن.<verse eid="JHN 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 7:33" />ينَّا عِيْسَى: "نش اَكِذْوم قِّيمغ ذْرُوْسْت ن ڒْوقْث، سّنِّي اَذ عقْبغ غَار ونِّي ذَايِي د يسّكّن. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />أَخَافِي ثرْزُوْم وَار ذَايِي تِيفم شَا. وَار ثْزمَّرم اَذ د تَاسم مَانِي غَا يڒِيغ نش."<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />مْسقْسَان يسْرَائِيلِيْين جَارَاسن نَّان: "مَانِي غَا يرَاح وَانِيتَا وَار ث نْتِيف شَا؟ مَا ٱذ يرَاح غَار يسْرَائِيْلِيْين إِي يتمْزدْجَاعن ذِي ثْمُوْرَا ن ييُوْنَانِيْين بَاش اَذ يسڒْمذ ييُوْنَانِيْين؟ <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />مِين يخس اَذ يِينِّي وَاوَاڒَ-أَ إِݣ ينَّا؟ يعْنِي &lt;أَخَافِي ثرْزُوْم وَار ذَايِي تِيفم شَا. وَار ثْزمَّرم اَذ د تَاسم مَانِي غَا يڒِيغ نش.&gt;"<verse eid="JHN 7:36" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى نتَّا ذ لْمَسِيح</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />ذِي نْهَار اَنݣَّارُو اَمقّْرَان زِي ڒْعِيذ نِّي، ئِكَّر يبدّ عِيْسَى يتْخَاطَاب س جّْهذ ينَّا: "مڒَا يفُّوْذ حَدّ، ئِتْخصَّا نتَّا اَذ د يَاس غَارِي اَذ يسو. <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />مَامّش ينَّا لْكِتَاب خ ونِّي زَّايِي غَا يَامْنن: أَزَّايس اَزّْڒن يغزْرَان ن وَامَان يسدَّرن." <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />مَانَايَا ينَّا-ث خ أَرُّوْح يقدّْسن إِي غَا يقبْڒن يِنِّي زَّايس يُوْمْنن. أَرُّوْح يقدّْسن عَاذ وَار ثِيذ يُوْشِي شَا مِينْزِي عِيْسَى عَاذ وَار يتْوَارْفع شَا.<verse eid="JHN 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />سْڒِين ڒبْعَاض ن ڒْغَاشِي إِ وَاوَاڒن ن عِيْسَى نَّان: "ذ وَانِيتَا ذ صَّح ذ نَّبِي <char style="it">إِي قَّارن اَذ د يَاس</char>."<verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />ينّغْنِي نَّان: "نتَّا ذ لمَسِيح."</para>
  <para style="p" vid="JHN 7:41">وَلَكِن ڒبْعَاض زَّايسن نَّان: "مَا ٱذ د يَاس لمَسِيح زِي ثْمُوْرْث ن لْجَالِيل؟ <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />ينَّا لْكِتَاب اَقَا لْمَسِيح اَذ د يَاس زِي دُّوْرِّيث ن دَاود، يعْنِي زِي بَيْت لَحْم زِي دْشَار مَانِيس د يُوْسَا دَاود."<verse eid="JHN 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 7:43" />خ مَانَايَا يوْقع لْخِلَاف جَار ڒْغَاشِي نِّي ذِي سَّبَاب نّس. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />ڒبْعَاض رزُّوْن اَث طّْفن، وَلَكِن وَار خَاس يسرْس فُوْس حَدّ زَّايْسن.<verse eid="JHN 7:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />عقْبن-د يعسَّاسن غَار يفَرِّيسِيْين ذ اَرُّوْيَاس ن ڒْفُقَهَا. سِّيوْڒن اَك يعسَّاسن نِّي نَّان-اَسن: "مَايمِّي وَار ثِيذ تُوْوِيم؟"<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />نَّان-اَسن يعسَّاسن: "عمَّارْص وَار يسِّيوڒ شَان ن بْنَاذم اَمّش يسَّاوَاڒ ورْيَاز-أَ‍!"<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />نَّان-اَسن يفَرِّيسيْين إِ يعسَّاسن: "مَا تْوَاخذْعم ؤُڒَا ذ كنِّيو زَّايس؟ <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />مَا ثُوْفِيم شَان يِجّن زِي اَرُّوْيَاس نِغ ذ يفَرِّيسيْين يُوْمن زَّايس؟ <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />يَاك ڒْغَاشِي نِّي وَار سِّينن شَا شَّرِيعَا ن مُوْسَى، يِنِّي اَقَاثن منْعُوْڒِين إِي دْجَان."<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />ئِكَّر يجّن زِي اَرُّوْيَاس-أَ، نتَّا تُوْغَاث قْبڒ يرُوْح غَار عِيْسَى قَّارن-اَس نِيكُوْدِيم، ينَّا-ٱسن: <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />"مَا شَّرِيعَا نّغ ثْحكّم خ يِج ن بْنَاذم قْبڒ مَا ث نْࢲر نِغ أَ نسّن مِين يتݣّ؟"<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />نَّان-اَس: "مَا شك عَاوذ زِي صْحَاب ن لْجَالِيل؟ ارْزُو ذِي لْكُتُب خْزَر، ؤُڒَا ذ يجّن ن نَّبِي وَار د يُوْسِي شَا زِي ثْمُوْرْث ن لْجَالِيل."<verse eid="JHN 7:52" /></para>
  <para style="s">{سِيذِيثْنغ عِيْسَى يسْمح إِ يِجّن ن ثمْغَارْث ثفّغ اَبْرِيذ}</para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 7:53" />سّنِّي يرُوْح كُڒ يجّن غَار ثدَّارث نّس.<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="nb">
    <verse number="1" style="v" sid="JHN 8:1" />وَلَكِن عِيْسَى يُوْڒِي غَار وذْرَار ن زِّيتُوْن. <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />أَك صْبَاح زِيش يذْوڒ-د عَاوذ غَار ثمْزِيذَا ثَمقّْرَانْت ن أَيث-إِسْرَائِيل. ؤُسِين-د غَارس ڒْغَاشِي مَارَّا، ئِقِّيم يسڒْمَاذ-يثن. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />منْبَعْد يمْسڒْمَاذن ن شَّرِيعَا ؤُڒَا ذ يفَرِّيسِيْين ؤُوِين-اَس-د يجّن ن ثمْغَارْث ؤُفِين-ت ثْخدّع اَرْيَاز نّس، سْبدّن-تث زَّاثْسن. <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />نَّان-اَس إِ عِيْسَى: "آ لْمُعَلِّم، ثَمْغَارْث-أَ ؤُفِين-ت ثْخدّع اَرْيَاز نّس. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />يوصَّا-ٱنغ مُوْسَى ذِي شَّرِيعَا ينَّا-ٱنغ قَا اَمشْنَاو ثَانِيتَا اَت نرْجم س وزْرُو. ئِي شك، مِين غَا ثِينِيذ؟" <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />نَّان-اَس نِثْنِي مَانَايَا تْجَرَّابن-ث حمَا اَث تَاهْمن.</para>
  <para style="p" vid="JHN 8:6">ئِكَّر عِيْسَى يهْوَا غَار ثْمُوْرْث يبْذَا يتَارِي ذݣ وشَاڒ س وفُوْس نّس. <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />وَامِي نِثْنِي قِّيمن اَمنِّي تْسقْسَان-ث، ئِبدّ ينَّا-ٱسن: "ونِّي يدْجَان زَّايْوم عمَّارْص وَار يعْصِي اَت يُوْوث س وزْرُو نتَّا ذ اَمزْوَارُو." <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />ڒْخدّْنِي يهْوَا عَاوذ غَار ثْمُوْرْث يتَارِي ذݣ وشَاڒ. <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />وَامِي سْڒِين إِ وَاوَاڒ-أَ بْذَان ؤُݣُّوْرن ئِج-يج، ئِوسُّوْرَا ذ يمزْوُوْرَا. ئِقِّيم عِيْسَى وَاحْذس نتَّا ذ ثمْغَارْث نِّي ثْبدّ زَّاثس. <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />ئِبدّ عِيْسَى ينَّا-ٱس: "آ ثَمْغَارْث، مَانِي دْجَان؟ مَا وَار خَام يحْكِيم حَدّ؟"<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />ثنَّا-ٱس نتَّاث: "وَاه، آ سِيذِي."</para>
  <para style="p" vid="JHN 8:11">ينَّا-ٱس عِيْسَى: "ؤُڒَا ذ نش وَار خَام حكّْمغ شَا. رُوْح، زِي سَّا اَڒ ثْسَاونْت وَار تَاذَاف شَا ذِي ڒْمُعْصِيْيث."<verse eid="JHN 8:11" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى نتَّا ذ نُّوْر ن دُّنشْت</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />ئِسِّيوڒ غَارْسن عَاوذ عِيْسَى ينَّا-ٱسن: "نش ذ نُّوْر ن دُّنشْت. ونِّي ذَايِي غَا يذْفَارن عمَّارْص اَذ يُوْيُوْر ذِي ثَادْجسْت، أَغَارس يِيڒِي نُّوْر ن ثُوْذَارْث."<verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />نَّان-اَس يفَرِّيسيْين: "شك ثْشهّْذذ خ يِيخف نّش، شْهَاذث نّش وَار ثدْجِي شَا ذ صَّح."<verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "لَّا، وَاخَّا نش شهّْذغ خ يِيخف ينُو، شْهَاذث ينُو نِيشَان مِينْزِي نش سّْنغ مَانِيس إِي د ؤُسِيغ ذ مَانِي غَا رَاحغ. وَلَكِن كنِّيو وَار ثسِّينم شَا مَانِيس د ؤُسِيغ نِغ مَانِي غَا رَاحغ. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />كنِّيو تْحَاسَابم يجّن س ڒَعْقڒ وَاهَا، نش وَار تْحِيسِيبغ ؤُڒَا ذ يجّن. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />أُو نش مڒَا حَاسْبغ، لْحِسَاب ينُو نِيشَان ڒَاحقَّاش وَار تْحِيسِيبغ شَا وَاحْذِي، نتْحَاسَاب نش ذ بَابَا إِي ذَايِي د يسّكّن. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />ثُوْرَا ذِي شَّرِيعَا نْوم س يِيخف نّس بلِّي شْهَاذث ن ثْنَاين ن ڒشْهُوْذ نِيشَان. <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />نش شهّْذغ خ يِيخف ينُو، أُو عَاوذ بَابَا إِي ذَايِي د يسّكّن يشهّذ خَافِي."<verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />نَّان-اَس: "مَانِي يدْجَا بَابَاش؟"</para>
  <para style="p" vid="JHN 8:19">ينَّا-ٱسن عِيْسَى: "كنِّيو وَار ذَايِي ثسِّينم شَا، وَار ثسِّينم ؤُڒَا ذ بَابَا. مَعْلِيك ذَايِي ثسّْنم اَذ تيڒِي ثسّْنم ؤُڒَا ذ بَابَا." <verse eid="JHN 8:19" /><verse number="20" style="v" sid="JHN 8:20" />ينَّا اَوَاڒ-أَ ذِي ثمْزِيذَا ثَمقّْرَانْت نْسن مَانِي جمّْعن صَّدَقَا، ئِسڒْمَاذ ذِنِّي. وَار ث يطِّيف ؤُڒَا ذ يجّن مِينْزِي ڒْوقْث نّس عَاذ وَار د تُوْوِيض.<verse eid="JHN 8:20" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى نتَّا زݣ وجنَّا</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />ينَّا-ٱسن عَاوذ عِيْسَى: "نش اَذ ؤُيُوْرغ كنِّيو اَخَافِي ثرْزُوْم، ذِي ڒْمُعْصِيّث نْوم اَذ تمّْثم. مَانِي غَا رَاحغ نش، وَار ثْزمَّرم شَا اَذ د تَاسم ذِنِّي."<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />نَّان يسْرَائِيلِيْين نِّي: "نتَّا ينَّا قَا مَانِي غَا رَاحغ نش، وَار ثْزمَّرم شَا اَذ د تَاسم ذِنِّي. مَا ٱذ ينغ يخف نّس نِغ؟"<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />ينَّا-ٱسن عِيْسَى: "كنِّيو زݣ وَادَّاي يعْنِي زِي ثْمُوْرْث، نش زݣ وجنَّا. كنِّيو زِي دُّنشْت-أَ، نش وَار دْجِيغ شَا زِي دُّنشْت-أَ. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />نِّيغ-اَوم اَذ تمّْثم ذِي ڒْمُعْصِيَاث نْوم. أَذ تمّْثم ذِي ڒْمُعْصِيَاث نْوم يعْنِي مڒَا كنِّيو وَار ثُوْمِينم شَا بلِّي ذ نش إِݣ يدْجَان."<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />نَّان-اَس: "مِين ثعْنِيذ؟"</para>
  <para style="p" vid="JHN 8:25">ينَّا-ٱسن عِيْسَى: "نش ذ ونِّي مِيخف ذَاوم سَّاوَاڒغ زݣ ومزْوَارُو. <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />غَارِي اَطَّاس ن وَاوَاڒن زمَّرغ اَذَاوم ثن ينِيغ، زَّايْسن إِي غَا حكْمغ خَاوم. ونِّي ذَايِي د يسّكّن نتَّا ذَايس لْحَقِيقَا. مِين سْڒِيغ زَّايس قَّارغ-ث إِ دُّنشْت." <verse eid="JHN 8:26" /><verse number="27" style="v" sid="JHN 8:27" />وَار فْهِيمن شَا بلِّي نتَّا يسَّاوَاڒ-اَسن خ بَابَاس.<verse eid="JHN 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 8:28" />خ مَانَايَا ينَّا-ٱسن عِيْسَى: "أَخمِي غَا ثسْبدّم مِّيس ن بْنَاذم ذݣ وجنَّا، أَذ تسّْنم بلِّي ذ نش إِݣ يدْجَان. وَار تݣّغ شَا زِي غَاري؛ لَّا، نش سَّاوَاڒغ خ مَامّش ذَايِي يسڒْمَاذ بَابَا. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />ونِّي ذَايِي د يسّكّن اَقَاث اَكِذِي وَار ذَايِي يجِّي بُو وَاحْذِي مِينْزِي نش خدّْمغ ڒبْدَا مِين ذَاس يتعْجِيبن." <verse eid="JHN 8:29" /><verse number="30" style="v" sid="JHN 8:30" />وَامِي ينَّا نتَّا مَانَايَا، ؤُمْنن زَّايس اَطَّاس ن يِوْذَان.<verse eid="JHN 8:30" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يمْغَر خ سِيذْنَا بْرَاهِيم</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />ينَّا-ٱسن عِيْسَى إِ يسْرَائِيلِيْن يِنِّي زَّايس يُوْمْنن: "مڒَا ثقِّيمم ذݣ وَاوَاڒ ينُو، أَذ تِيڒِيم ذ صَّح ذ يمحْضَارن ينُو. <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />أَذ تسّْنم لْحَقِيقَا، أُو لْحَقِيقَا اَذَاوم د تضْڒق اَذ تِيڒِيم حُرّ."<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />نَّان-اَس: "نشِّين زِي دُّوْرِّيث ن بْرَاهِيم، عمَّارْص وَار ندْجِي ذ يسمْغَان إِ حَدّ. مَايمِّي ذَانغ ثنِّيذ اَذ تْوَاضڒْقم اَذ تِيڒِيم حُرّ؟"<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />ينَّا-ٱسن عِيْسَى: "أَقَا تسْڒَام ڒْحَقّ: مَارَّا ونِّي يتݣّن ڒْمُعْصِيّث نتَّا ذ يسْمغ، بَاب نّس ذ ڒْمُعْصِيّث. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />ئِسْمغ وَار غَارس بُو ومْشَان اَݣ لْعَئِيلَا ن ثدَّارْث إِ ڒبْدَا، وَلَكِن ممِّيثْسن وَاه غَارس اَمْشَان نّس إِ ڒبدَا. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />مڒَا يضْڒق-اَوم مِّيس يُوْشَا-ٱوم لْحُرِّيَا، أَغَارْوم ثِيڒِي ذ صَّح لْحُرِّيَا. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />نش سّْنغ قَا كنِّيو ذ دُّوْرِّيث ن بْرَاهِيم. إِنَّمَا، كنِّيو ثْرزُّوْم اَذَايِي ثنْغم مِينْزِي اَوَاڒ ينُو وَار ث ثقْبِيڒم شَا. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />نش سَّاوَاڒغ س مِين ࢲْرِيغ غَار بَابَا. ڒَا ذ كنِّيو تݣّم س مِين ثسْڒِيم زِي بَابَاثْوم."<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />أَرِّين خَاس نَّان-اَس: "بَابَاثْنغ ذ بْرَاهِيم."</para>
  <para style="p" vid="JHN 8:39">ينَّا-ٱسن عِيْسَى: "لَّا، مَعْلِيك كنِّيو ذ دُّوْرِّث ن بْرَاهِيم، إِڒِي قَا ثْخذْمم ڒخْذَايم نّس. <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />خْزَر، نش ذ يجّن ن بْنَاذم سِّيوْڒغ اَكِذْوم س لْحَقِيقَا زِي مِين سْڒِيغ زِي أَربِّـي. ڒخُّو كنِّيو ثْرزُّوْم اَذَايِي ثنْغم، مَايمِّي؟ بْرَاهِيم عمَّارْص مَا يݣَّا اَمُّو. <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />لَّا، كنِّيو ثْخذْمم ڒخْذَايم ن بَابَاثْوم."</para>
  <para style="p" vid="JHN 8:41">نَّان-اَس: "نشِّين وَار د نخْڒِيق شَا زِي لْفَسَاد. غَارْنغ يجّن ن بَابَاثْنغ نتَّا ذ أَربِّـي."<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />ينَّا-ٱسن عِيْسَى: "لَّا، مَعْلِيك بَابَاثْوم ذ أَربِّـي، أَتَاف تحِبِّيم-اَيِي مِينْزِي نش فّْغغ-د زِي أَربِّـي ؤُسِيغ-د. وَار د ؤُسِيغ شَا زݣ يِيخف ينُو؛ لَّا، ذ بَابَا إِي ذَايِي د يسّكّن. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />مَايمِّي وَار ثفْهِيمم شَا إِ مِين ذَاوم قَّارغ؟ ڒَاحقَّاش وَار ثْزمَّرم شَا اَذ تْقبْڒم اَوَاڒ ينُو. <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />بَابَاثْوم ذ إِبْڒِيس، ثْرزُّوْم اَذ تذْفَارم مِين يخس نتَّا. زݣ ومزْوَارُو نتَّا ينقّْ يوْذَان. وَار غَارس شَا لْعَلَاقَا اَك لْحَقِيقَا مِينْزِي نتَّا وَار ذَايس بُو لْحَقِيقَا. مڒْمِي مَا يسْخرَّق، أَتَاف يسَّاوَاڒ زِي مِين ذَايس مِينْزِي نتَّا ذ بُو-يخرِّيقن، ذ بَابَاثْسن ن يخرِّيقن. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />نش قَّارغ ڒْحَقّ س مَانَاينِّي كنِّيو وَار ذَايِي تِيمْنم شَا. <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />مِين يعْنَا ونِّي يزمَّرن زَّايْوم اَذَايِي يطّف ڒْمُعْصِيّث؟ مڒَا قَّارغ ڒْحَقّ، مَايمِّي وَار ذَايِي تِيمْنم شَا؟ <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />ونِّي يدْجَان ن أَربِّـي اَتَاف نتَّا يتسْڒَا إِ وَاوَاڒن ن أَربِّـي. كنِّيو وَار تسْڒِيم شَا مِينْزِي كنِّيو وَار ثدْجِيم شَا ن أَربِّـي."<verse eid="JHN 8:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />نَّان-اَس يسْرَائِيلِيْين نِّي: "غَارْنغ ڒْحَقّ نِغ لَّا مڒَا ننَّا شك زِي سَمَارْيَا، ذَايك جْنُوْن؟"<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />ينَّا-ٱسن عِيْسَى: "نش وَار ذَايِي بُو جْنُوْن تْوقَّارغ بَابَا، كنِّيو تْحݣَّارم-اَيِي. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />نش وَار رزُّوْغ شَا لْعَظَمَا إِ يِيخف ينُو. ذِنِّي ونِّي ذَايِي ت يرزُّون أُو نتَّا ذ ونِّي يحكّْمن. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />أَقَا تسْڒَام ڒْحَقّ: ونِّي يتݣّن اَرَّاي إِ وَاوَاڒ ينُو اَتَاف وَار يْتْوِيڒِي ڒْموْث عمَّارْص."<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />نَّان-اَس يسْرَائِيلِيْين: "رخُّو نسّن بلِّي شك ذَايك جْنُوْن. <char style="it">سِيذْنَا</char> بْرَاهِيم ذ لْأَنْبِيَا مَارَّا مُّوْثن. شك ثقَّارذ مڒَا شَان يِجّن اَذ يݣّ اَرَّاي إِ وَاوَاڒ ينُو عمَّارْص اَذ يقَّاس ڒْموْث. <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />مَا شك كْتَار زِي جدِّيثْنغ بْرَاهِيم ذ لْأَنْبِيَا نِّي يمُّوْثن؟ مِين ثْحسّْبذ يخف نّش؟"<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />ينَّا-ٱسن عِيْسَى: "نش مڒَا سمْغَارغ يخف ينُو، أَتَاف لْعَظَمَا ينُو وَار ثدْجِي ذ وَالُو. ذ بَابَا إِي ذَايِي يسمْغَارن، ذ ونِّي إِي ثقَّارم قَا ذ أَربِّـي نّغ. <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />كنِّيو وَار ث ثسِّينم شَا، نش سّْنغ-ث. مڒَا نِّيغ ؤُڒَا ذ نش وَار ث سِّينغ شَا، أَذ يڒِيغ اَم كنِّيو ذ بُو-يخرِّيقن. وَلَكِن نش سّْنغ-ث، تݣّغ اَرَّاي إِ وَاوَاڒ نّس. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />جدِّيثْوم بْرَاهِيم يفَرح اَطَّاس عْلَاحْسَاب خْمِي غَا يࢲر نْهَار ينُو، وَامِي ث يࢲْرَا يفَرح."<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />نَّان-اَس يسْرَائِيلِيْين نِّي: "عَاذ وَار غَارك بُو خمْسِين يسݣّْوُوْسَا، مَامّش ثݣِّيذ ثࢲْرِيذ بْرَاهِيم نِّي؟"<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "أَقَا تسْڒَام ڒْحَقّ: قْبڒ مَا ٱذ يِيڒِي بْرَاهِيم، نش دْجِيغ."<verse eid="JHN 8:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59" />كَّرن يسْرَائِيلِيْين نِّي يْسِين يزْرَا حمَا اَث رجْمن، وَلَكِن عِيْسَى ينسْڒث يفّغ زِي ثمْزِيذَا ثَمقّْرَانْت.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا يج وضَرْغَاڒ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />وَامِي تُوْغَا عِيْسَى يݣُّوْر ذݣ وبْرِيذ يُوْفَا يجّن ن ورْيَاز ذ اَضَرْغَاڒ يخْڒق-د اَمنِّي. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />نَّان-اَس يمحْضَارن نّس: "آ لْمُعَلِّم، ؤُݣ إِي يعْصَان؟ مَا ذ وَانِيتَا مَا ذ لْوَالِدِين نّس وَامِي د يخْڒق ذ اَضَرْغَاڒ؟"<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />ينَّا-ٱسن عِيْسَى: "وَار يعْصِي وَانِيتَا ؤُڒَا ذ لْوَالِدِين نّس. ئِخْڒق-د ذ اَضَرْغَاڒ بَاش مَارَّا اَذ ࢲرن مِين يزمَّر أَربِّـي اَذَايس يخْذم. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />خْمِي يتِيڒِي ذ نْهَار، ئِتْخصَّا-يَانغ أَ نخْذم ڒخْذَايم ن ونِّي إِي ذَايِي د يسّكّن. خْمِي د تَاوض دْجِيڒث، وَار يزمَّر ؤُڒَا ذ يجّن اَذ يخْذم. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />مَدَامَا عَاذ دْجِيغ ذِي دُّنشْت، نش ذ نُّوْر ن دُّنشْت."<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />وَامِي ينَّا اَمُّو، ئِسُّوْسف ذݣ وشَاڒ يݣّا زَّايس اَبدْجَاع س يكُوْفَّان نِّي يسرْس-يث خ ثِيطَّاوِين ن وضَرْغَاڒ. <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />ينَّا-ٱس عِيْسَى: "رُوْح اَذ تسِّيرْذذ ذِي صَّرِيج ن سِيلْوَام." (أَوَاڒ-أَ سِيلْوَام يخس اَذ يِينِي &lt;ونِّي إِي د يتْوَاسّكّن.&gt;) ئِرُوْح يسِّيرذ، يروّح يتْوَاڒَا.<verse eid="JHN 9:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />سِّيوْڒن جَارَاسن جِّيرَان ذ يِوْذَان إِي ث يسّْنن زِي قْبڒ نَّان، مَاشِي ذ وَانِيتَا يتْغِيمَان يتتَّار؟<verse eid="JHN 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9" />ڒبْعَاض زَّايْسن نَّان: "قَا ذ نتَّا."</para>
  <para style="p" vid="JHN 9:9">نَّان ينّغْنِي: "لَّا، ئِتَاوِي-د ذَايس وَاهَا."</para>
  <para style="p" vid="JHN 9:9">وَلَكِن نتَّا ينَّا: "قَا ذ نش."<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />نَّان-اَس: "مَامّش ݣنْفَانْت ثِيطَّاوِين نّش؟"<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />ينَّا-ٱسن: "بْنَاذم نِّي ؤُمِي قَّارن عِيْسَى ييْسِي-د اَبدْجَاع يسرْس-اَيِي-ث خ ثِيطَّاوِين ينُو. ينَّا-ٱيِي رُوْح غَار سِيلْوَام اَذ تسِّيرْذذ. رُوْحغ سِّيرْذغ، روّْحغ تْوَاڒِيغ."<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />نَّان-اَس: "مَانِي يدْجَا؟"</para>
  <para style="p" vid="JHN 9:12">ينَّا-ٱسن: "وَار سِّينغ."<verse eid="JHN 9:12" /></para>
  <para style="s">أَضَرْغَاڒ نِّي يشهّذ خ سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />ؤُوِين اَرْيَاز نِّي يذوْڒن يتْوَاڒَا غَار يفَرِّيسِيْين. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />تُوْغَا نْهَار نِّي ذ سّبْث ن لْعِبَادَا وَامِي ذَاس يسرْس عِيْسَى اَبدْجَاع خ ثِيطَّاوِين نّس يسْݣنْفَا-ث. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />نَّان-اَس ؤُڒَا ذ يفَرِّيسيْين، مِين ذَاش يوقْعن وَامِي شك تْوَاڒِيذ؟</para>
  <para style="p" vid="JHN 9:15">ينَّا-ٱسن: "ئِسرْس-اَيِي اَبدْجَاع خ ثِيطَّاوِين ينُو، سِّيرْذغ ذوْڒغ تْوَاڒِيغ."<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />نَّان ڒبْعَاض ن يفَرِّيسِيْين نِّي: "بْنَاذم نِّي وَار يدْجِي شَا زِي أَربِّـي مِينْزِي وَار يوقَّار شَا نْهَار ن لْعِبَادَا."</para>
  <para style="p" vid="JHN 9:16">وَلَكِن ڒبْعَاض نّغْنِي نَّان: "لَّا، مَامّش بْنَاذم ذ لْعَاصِي <char style="it">زَعْمَا</char> اَذ يݣّ لْمُعْجِيزَاث-أَ؟" خ مَانَايَا يوْقع لْخِلَاف جَارَاسن.<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />نَّان-اَس عَاوذ إِ وضَرْغَاڒ نِّي: "مَامّش تْوَاڒِيذ شك ونِّي إِي ش يسْݣنْفَان ثِيطَّاوِين نّش؟"</para>
  <para style="p" vid="JHN 9:17">ينَّا-ٱسن: "نتَّا ذ نَّبي."<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />وَلَكِن عَاذ وَار ؤُمِينن شَا يسْرَائِيلِيْين نِّي بلِّي نتَّا تُوغَاث ذ اَضَرْغَاڒ يذْوڒ يتْوَاڒَا حتَّا وَامِي د ڒَاغَان إِ لْوَالِدِين نّس. <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />نَّان-اَسن: "مَا ذ وَانِيتَا ذ مِّيثْوم إِي ثقَّارم يخْڒق-د ذ اَضَرْغَاڒ؟ مَامّش يݣَّا ڒخُّو نتَّا يِتْوَاڒَا؟"<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />نَّان-اَسن لْوَالِدِين نّس: "نشِّين نسّن بلِّي وَانِيتَا ذ مِّيثْنغ يخْڒق-د ذ اَضَرْغَاڒ. <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />وَار نسِّين شَا مِين ذَاس يوقْعن ڒخُّو يذْوڒ يتْوَاڒَا. وَار نسِّين شَا ونِّي إِي ث يسْݣنْفَان زِي ثِيطَّاوِين نّس. سّقْسَام-ث كنِّيو، نتَّا قَا يمْغَر اَذ يسِّيوڒ نِّيث خ يِيخف نّس." <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />نَّان لْوَالِدِين نّس اَمنِّي مِينْزِي ݣّْوْذن زݣ <char style="it">يمقّْرَانن ن</char> أَيث-إِسْرَائِيل. تُوْغَا <char style="it">يمقّْرَانن</char> نِّي تَافْقن بلِّي ونِّي غَا يشهْذن عِيْسَى ذ لْمَسِيح، أَث طرْدن زِي ثمْزِيذَا. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />خ مَانَايَا نَّان لْوَالِدِين نّس سّقْسَام-ث كنِّيو نتَّا قَا يمْغَر.<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />ڒَاغَان-د وِيس مَرّْثَاين إِ ورْيَاز نِّي تُوْغَا يدْجَان ذ اَضَرْغَاڒ نَّان-اَس: "إِيوَا حْمذ أَربِّـي شك! قَا نشِّين نسّن اَرْيَاز نِّي نتَّا ذ لْعَاصِي."<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />ينَّا-ٱسن: "نتَّا مڒَا ذ لْعَاصِي <char style="it">زَعْمَا</char> نش وَار سِّينغ شَا. سّْنغ يجّن ن ثْمسْڒَايْث: تُوْغَايي ذ اَضَرْغَاڒ ڒخُّو تْوَاڒِيغ."<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />نَّان-اَس: "مِين ذَاش يݣَّا؟ مَامّش يݣَّا يسْݣنْفَا-ش زِي ثِيطَّاوِين نّش؟"<verse eid="JHN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27" />ينَّا-ٱسن: "نِّيغ-اَوم-ت وَار ذَايي ثْصنّْطم شَا. مَايمّي ثخْسم اَذ تسْڒم عَاوذ؟ مَا ثخْسم ؤُڒَا ذ كنِّيو اَذ تِيڒِيم ذ يمحْضَارن نّس؟"<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />زَوَرن-ث نَّان-اَس: "شك إِي يدْجَان ذ اَمحْضَار نّس! قَا نشِّين ذ يمحْضَارن ن مُوْسَى. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />نشِّين نسّن بلِّي أَربِّـي يسِّيوڒ اَك مُوْسَى، وَلَكِن ونِّي وَار نسِّين شَا مَانِيس إِي د يُوْسَا."<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />ينَّا-ٱسن ورْيَاز نِّي: "مَانَايَا ذ ڒْعَجب! ئِسْݣنْفَا ثِيطَّاوِين ينُو، كنِّيو وَار ثسِّينم شَا مَانِيس نتَّا! <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />نشِّين نسّن أَربِّـي وَار يتسْڒِي شَا غَار يِنِّي يعصَّان؛ لَّا، ئِتسْڒَا غَار يِنِّي إِي ث يتْوقَّارن ذ يِنِّي يخدّْمن س مِين يخس. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />عمَّارْص وَار نسْڒِي ذِي زْمَان بْنَاذم يخْڒق-د ذ اَضَرْغَاڒ اَذ د يَاس شَان يِجّن اَذَاس يسْݣنْفَا ثِيطَّاوِين. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />أَرْيَاز-أَ، مَعْلِيك وَار يدْجِي شَا زِي أَربِّـي اَتَاف وَار يزمَّر اَذ يݣّ وَالُو!"<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />نَّان-ٱس: "شك ذ لْعَاصِي زݣ وَامِي د ثْخڒْقذ، مَا ثْرزُّوْذ اَذَانغ ثسْڒمْذذ نشِّين؟" ڒخْدّنِّي طرْدن-ث زِي ثمْزِيذَا.<verse eid="JHN 9:34" /></para>
  <para style="b" />
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />ئِسْڒَا عِيْسَى بلِّي ونِّي طرْدن-ث زِي ثمْزِيذَا. وَامِي ث يُوفَا ينَّا-ٱس: "مَا تَامْنذ زِي مِّيس ن بْنَاذم؟"<verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />ينَّا-ٱس: "مِين يعْنَا ونِّي آ سِيذِي حمَا اَزَّايس اَمْنغ؟"<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />ينَّا-ٱس عِيْسَى: "أَقَا ثࢲْرِيذ-ث، ذ ونِّي إِي كِش يسَّاوَاڒن."<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />ينَّا-ٱس: "ؤُمْنغ زَّايش آ سِيذِي." ڒخْدّنِّي يسجّذ-اَس.<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />ينَّا عِيْسَى: "ؤُسِيغ-د غَار دُّنشْت-أَ اَذ حَاسْبغ حمَا يِنِّي يدْجَان ذ يضَرْغَاڒن اَذ تْوَاڒَان، يِنِّي يتْوَاڒَان اَذ ضرْغْڒن."<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />سْڒِين-اَس ڒبْعَاض زݣ يفَرِّيسِيْين إِي يدْجَان ذِنِّي نَّان-اَس: "مَا ؤُڒَا ذ نشِّين ذ يضَرْغَاڒن نِغ؟"<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />ينَّا-ٱسن عِيْسَى: "مَعْلِيك ذ يضَرْغَاڒن إِي ثدْجَام، أَتَاف وَار ذَايْوم بُو ڒْمُعْصِيّث. وَلَكِن كنِّيو ڒخُّو ثقَّارم نشِّين نتْوَاڒَا. خ مَانَاينِّي عَاذ ذَايْوم ڒْمُعْصِيّث."<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">سِيذِيثْنغ عِيْسَى يتْصدَّاق ثُوْذَارْث نّس خ يحُوْڒِيْين نّس</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />"أَقَا تسْڒَام ڒْحَقّ: ونِّي وَار يتِيذْفن شَا زِي ثوَّارْث ن ڒْكُوْرِي ن يحُوْڒِيْين يتْݣَعَّاذ مَانِيس نّغْنِي، نتَّا يتْوَاحْسَاب ذ اَشفَّار ذ اَخوَّان. <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />وَلَكِن ونِّي د غَا يَاذْفن زِي ثوَّارْث نتَّا إِݣ يَروّْسن يحُوْڒِيْين نّس. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />أَعسَّاس ن ڒْكُوْرِي اَذَاس يرْزم ثَوَّارْث إِ ونِّي إِي يَروّْسن، ئِحُوْڒِيْين نّس تسْڒَان إِ صُّوْت نّس. ئِتْڒَاغَا خ يحُوْڒِيْين نّس س يِيسمَاون نْسن، أَثن يسُوْفغ. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />أَذ يسُوْفغ مَارَّا يحُوْڒِيْين نّس يݣُّوْر زَّاثْسن، ئِحُوْڒِيْين نِّي ذفَّارن-ث مِينْزِي سّْنن صُّوْت نّس. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />وَلَكِن اَثَرَّاس ن مِيدّن وَار ث ذفَّارن عمَّارْص، اَزَّايس اَروْڒن مِينْزِي نِثْنِي وَار سِّينن شَا صُّوْت ن وثَرَّاس ن مِيدّن." <verse eid="JHN 10:5" /><verse number="6" style="v" sid="JHN 10:6" />ينَّا-ٱسن عِيْسَى ڒمِثَال-أَ، وَلَكِن نِثْنِي وَار فْهِيمن شَا ثِمسْڒَايِين مِيخف إِي ذَاسن يسَّاوَاڒ.<verse eid="JHN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />ينَّا-ٱسن عِيْسَى عَاوذ: "أَقَا تسْڒَام ڒْحَقّ: نش ذ ثَوَّارث ن ڒْكُوْرِي. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />مَارَّا يِنِّي د يُوْسِين قْبڒ إِ نش نِثْنِي تْوَاحَاسْبن ذ يشفَّارن ذ يخوَّانن، ئِحُوْڒِيْين نِثْنِي وَار غَارْسن سْڒِين شَا. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />نش ذ ثَوَّارث، ونِّي زَّايي غَا يَاذْفن اَذ ينْجم. أَذ يِيڒِي اَمشْنَاو يجّن ن وحُوْڒِي يتَاذف يتفّغ يتَاف مِين غَا يشّ. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />نتَّا اَشفَّار يتَاس-د غِير اَذ يَاشَار اَذ ينغ اَذ يهْذم. نش ؤُسِيغ-د حمَا اَغَارْسن ثِيڒِي ثُوْذَارْث نِّي ن ثُوذَارْث بْڒَا ڒقْيَاس.<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />نش إِݣ يَروّْسن ذ صَّح. ونِّي إِݣ يَروّْسن ذ صَّح يتْصدَّاق ثُوْذَارْث نّس خ يحُوْڒِيْين نّس. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />أَخدَّام مَاشِي اَم ونِّي يَروّْسن يحُوْڒِيْين نّس نِّيث. أَخدَّام، مڒَا يࢲْرَا ؤُشَّان يُوْسَا-د اَذ يسْمح ذݣ يحُوْڒِيْين نِّي اَذ يَرْوڒ. ؤُشَّان اَذ يهْجم خ يحُوْڒِيْين اَثن يعْزڒ خ وَايَاوْيَا. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />أَخدَّام اَذ يَرْوڒ مِينْزِي نتَّا ذ اَخدَّام وَاهَا، وَار ث تْهِيمِّين شَا يحُوْڒِيْين.<verse eid="JHN 10:13" /></para>
  <para style="p">
    <verse number="14‏-15" style="v" sid="JHN 10:14-15" />نش ذ ونِّي إِي ثن يَروّْسن ذ صَّح. سّْنغ يحُوْڒِيْين ينُو يحُوْڒِيْين ينُو سّْنن-اَيي، مَامّش ذَايي يسّن بَابَا نش سّْنغ-ث. ثُوْذَارْث ينُو، تْصدَّاقغ-ت خ يحُوْڒِيْين ينُو. <verse eid="JHN 10:14-15" /><verse number="16" style="v" sid="JHN 10:16" />غَاري يحُوْڒِيْين نّغْنِي وَار دْجِين شَا ذِي ڒْكُوْرِي-يَا، ئِتخصَّا-ٱيي اَثن د اَوِيغ. أَذ سْڒن إِ صُّوْت ينُو اَذ تِيڒِي ذ يجّن ن ثْحِيمرْث ذ يجّن إِي ثن غَا يَروْسن. <verse eid="JHN 10:16" /><verse number="17" style="v" sid="JHN 10:17" />س مَانَايَا بَابَا يتْحِبَّا-ٱيي مِينْزِي نش تْصدَّاقغ ثُوْذَارْث ينُو حمَا عَاوذ اَتِيد اَرّغ. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />ؤُڒَا ذ يجّن وَار زَّايِي ت يتكّس شَا؛ لَّا، نش تْصدَّاقغ ثُوذَارْث ينُو س ڒْخَاضَر ينُو. غَاري جّْهذ حمَا اَت صدّْقغ. غَاري جّْهذ حمَا اَتِيد اَرّغ عَاوذ. أَمُّو إِي ذَايِي يوصَّا بَابَا."<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />يوْقع لْخِلَاف عَاوذ جَار يسْرَائِيلِيْين خ وَاوَاڒن-أَ. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />نَّان اَطَّاس زَّايسن: "وَانِيتَا ذَايس جْنُوْن. نتَّا ذ اَبُوْهَاڒِي، مَايمّي غَارس تسْڒَام؟"<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />نَّان ينّغْنِي: "أَوَاڒن-أَ وَار ثن يقَّار شَا ونِّي إِي ذِي دْجَان جْنُوْن. مَا يزمَّر شَان يِجّن زِي جْنُوْن اَذ يسْݣنْفَا ثِيطَّاوِين ن يضَرْغَاڒن؟"<verse eid="JHN 10:21" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى ذ بَابَاس نِثْنِي ذ يجّن</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />يُوْوض-د ڒْعِيذ لْمِلَاد ن ثمْزِيذَا ثَمقّْرَانْت ن أَيث-إِسْرَائِيل ذِي لْقُدْس. مَانَايَا ذِي ڒْمشْتَا، <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />عِيْسَى يݣُّوْر ذݣ وسقِّيف ن سُوْلِمَان ذِي ثمْزِيذَا ثَمقّْرَانْت. <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />مُوْنن خَاس يسْرَائِيلِيْين نَّان-اَس: "أَڒ مڒْمِي ش غَا نْرَاجَا؟ مڒَا شك ذ لْمَسِيح، إِنِي-يَانغ-ث نِيشَان!"<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />ينَّا-ٱسن عِيْسَى: "نِّيغ-اَوم-ث، كنِّيو وَار تِيمْنم شَا. ڒخْذَايم إِي تݣّغ عْلَاحْسَاب يسم ن بَابَا شهّْذنْت خَافِي. <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />وَلَكِن كنِّيو وَار تِيمْنم شَا مِينْزِي وَار ثدْجِيم شَا ذ يحُوْڒِيْين ينُو. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />ئِحُوْڒِيْين ينُو تسْڒَان غَار صُّوْت ينُو، سّْنغ-ثن نِثْنِي ذفَّارن-اَيي. <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />تِيشّغ-اَسن ثُوْذَارْث ن ڒبْدَا عمَّارْص وَار فنِّين شَا، وَار ثن يخطّف ؤُڒَا ذ يجّن زݣ وفُوْس ينُو. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />ذ بَابَا إِي ذَايي ثن يُوْشِين أُو نتَّا ذ اَمقّْرَان زِي كُڒْشِي. وَار يزمَّر ؤُڒَا ذ يجّن اَثن يخْضف زݣ وفُوْس ن بَابَا. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />نش ذ بَابَا ذ يجّن."<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />ئِسْرَائِيلِيْين نِّي يْسِين-د عَاوذ يزْرَا اَث رجْمن. <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />ينَّا-ٱسن عِيْسَى: "سْبيّْنغ-اَوم-د اَطَّاس ن ڒخْذَايم ثِصبْحَانِين زِي بَابَا، مَانْت ڒْخذْمث إِي ثخْسم اَذَايِي ثْرجْمم خَاس؟"<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />نَّان-اَس يسْرَائِيلِيْين: "وَار ش نْرجّم شَا خ ڒْخذْمث يصبْحَان؛ لَّا، أَش نرْجم وَامِي ثنِّيذ لْبُهْتَان خ أَربِّـي. قَا شك ذ بْنَاذم، ثَارِّيذ يخف نّش ذ أَربِّـي."<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />ينَّا-ٱسن عِيْسَى: "مَا ثُوْرَا نِغ لَّا ذِي شَّرِيعَا نْوم بلِّي أَربِّـي ينَّا: &lt;نش نِّيغ-اَوم كنِّيو ذ أَربِّـيثن&gt;!؟ <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />نتَّا إِي ذَاسن يقّارن &lt;أَربِّـيثن&gt; إِ يِنِّي ؤُمِي د يُوْسَا وَاوَاڒ ن أَربِّـي، أُو لْكِتَاب ڒبْدَا يقَّار ڒْحَقّ. <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />مَا ثقَّارم إِ ونِّي يخْضَر بَابَا يسّكّ-يث-يذ غَار دُّنشْت شك ثنِّيذ لْبُهْتَان خ أَربِّـي مِينْزِي نِّيغ نش ذ مِّيس ن أَربِّـي؟ <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />مڒَا وَار خْذِيمغ شَا ڒخْذَايم ن بَابَا، وَار زَّايي تَامْنث شَا. <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />مڒَا خذْمغ-ثنْت، أَمْنث زِي ڒخْذَايم نِّي وَاخَّا وَار زَّايِي ثُوْمِينم. أَمُّو اَذ تسّْنم قَا بَابَا اَقَاث ذَايِي، نش اَقَايِي ذِي بَابَا."<verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />رزُّوْن اَث طّْفن وَلَكِن ينُوْفْسڒ-اَسن جَار يفَاسّن نْسن. <verse eid="JHN 10:39" /><verse number="40" style="v" sid="JHN 10:40" />ئِذْوڒ عَاوذ غَار وجمَّاض-ين ن يغْزَار ن لْأُرْدُن غَار ومْشَان مَانِي تُوْغَا يتْطهَّار يَحْيَى ذݣ ومزْوَارُو، ئِقِّيم ذِنِّي. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />ؤُسِين-د غَارس اَطَّاس نَّان، يَحْيَى وَار يݣِّي ؤُڒَا ذ يجّن ن لْمُعْجِيزَا، وَلَكِن مَارَّا مِين ينَّا خ وَانِيتَا ذ صَّح. <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />ؤُمْنن زَّايس اَطَّاس ن يِوْذَان ذِنِّي.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">سِيذِيثْنغ عِيْسَى يسكَّر-د لِعَازَر زِي ڒْموْث</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />ئِجّن ن بْنَاذم قَّارن-اَس لِعَازَر يهْڒش، نتَّا زݣ وبِيلَاج نِّي ؤُمِي قَّارن بَيْت عَنْيَا. زدّْغنْت ذِنِّي سُوْيْثْمَاس، ئِشْتن قَّارن-اَس مَرْيَم يشْتن قَّارن-اَس مَرْثَا. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />مَرْيَم ذ نتَّاث إِݣ يذهْنن يضَارن ن عِيْسَى س وَامَان ن لْوَرْذ ثمْسح-اَس-ثن س وشوَّاف نّس. ؤُمَاس ن مَرْيَم لِعَازَر يهْڒش. <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />سُوْيْثْمَاس نِّي سّكّنْت-يد غَار عِيْسَى نَّانْت-اَس آ سِيذِي، قَا ونِّي خَاك يعِيزّن قَا يهْڒش.<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />وَامِي يِسْڒَا إِ مَانَاينِّي عِيْسَى ينَّا ڒهْرَاش-أَ وَار د يُوْسِي شَا حمَا اَذ يمّث؛ لَّا، يُوْسَا-د ذ سَّبَاب إِ لْعَظَمَا ن أَربِّـي حمَا اَزَّايس يتْوَاسمْغَار مّيس ن أَربِّـي. <verse eid="JHN 11:4" /><verse number="5" style="v" sid="JHN 11:5" />تُوْغَا عِيزّن خَاس خ عِيْسَى مَرْثَا ذ وتْشْمَاس ذ ومَاس لِعَازَر. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />وَامِي يسْڒَا نتَّا قَا يهْڒش، ئِقِّيم ذِنِّي يُوْمَاين مَانِي يدْجَا.<verse eid="JHN 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 11:7" />منْبَعْد إِ مَانَايَا ينَّا-ٱسن إِ يمحْضَارن نّس: "يَالَّه أَ نذْوڒ عَاوذ غَار ثْمُوْرْث ن يَهُوْذِيَا."<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />نَّان-اَس يمحْضَارن: "مَامّش آ لْمُعَلِّم؟ ئِسْرَائِيلِيْين نِّي تُوْغَا رزُّوْن اَش رجْمن، شك ثخْسذ اَذ ثْعقْبذ ذِنِّي؟"<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />ينَّا-ٱسن عِيْسَى: "ذِنِّي ثنْعَاش ن سْوَايَع ن ثْفَاوْث ذِي نْهَار. ونِّي يݣُّوْرن ذِي نْهَار وَار يتْنقْرِيض شَا مِينْزِي يتْوَاڒَا ثْفَاوْث ن دُّنشْت-أَ. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />مڒَا شَان يِجّن يݣُّوْر س دْجِيڒث يتْنقْرَاض مِينْزِي دْجِيڒث وَار ذَايس بُو ثْفَاوْث." <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />وَامِي ينَّا مَانَايَا، يَرْنِي ينَّا-ٱسن: "أَمدُّوْكّڒ نّغ لِعَازَر قَا يطّص، أَذ رَاحغ اَثِيذ سْفَاقغ."<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />نَّان-اَس يمحْضَارن: "آ سِيذِي، مڒَا نتَّا يطّص اَذ يكَّر نِّيث."<verse eid="JHN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13" />وَلَكِن عِيْسَى يسِّيوڒ خ ڒْموْث نّس، نِثْنِي تْغِير-اَسن يسَّاوَاڒ خ اَرَّاحث نِّي ن يِنِّي يطّْصن. <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />أُوْشَا ينَّا-ٱسن نِيشَان: "قَا لِعَازَر يمُّوْث. <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />نش فَرْحغ وَامِي وَار ذِنِّي دْجِيغ حمَا اَذ تَامْنم. يَالَّه اَغَارس نْرَاح."<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />تُوْمَا يعْنِي ونِّي ؤُمِي قَّارن أَشْنِيو<note caller="+" style="f"><char style="fr" closed="false">11‏.16 </char><char style="ft" closed="false">أَشْنِيو نتَّا ذ اَڬْنِيو.</char></note> ينَّا-ٱسن إِ يمحْضَارن إِي يدْجَان ذ يمدُّوْكَاڒ نّس: "أَكِس نُوْيُوْر ؤُڒَا ذ نشِّين اَكِس نمّث."<verse eid="JHN 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />وَامِي د يُوْسَا عِيْسَى، يُوْفَا ثعْذُو أَرْبعِيَّام زݣ وَامِي يتْوَانْضڒ. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />بَيْت عَنْيَا ثݣّْوج ثْڒَاثَا كِيلُوْمِت خ لْقُدْس. <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />أَطَّاس ن يسْرَائِيلِيْين ؤُسِين-د غَار مَرْثَا ذ مَرْيَم حمَا اَثنْت عزَّان خ ومَاثْسنْت. <verse eid="JHN 11:19" /><verse number="20" style="v" sid="JHN 11:20" />وَامِي ثسْڒَا مَرْثَا قَا عِيْسَى يݣُّوْر-د، ثْرُوْح اَث تڒْقَا وَلَكِن مَرْيَم ثقِّيم ذِي ثدَّارْث. <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />ثنَّا-ٱس مَرْثَا إِ عِيْسَى: "آ سِيذِي، مَعْلِيك اَقَاش ذَانِيتَا إِڒِي وَار يمُّوْث شَا ؤُمَا. <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />نش سّْنغ بلِّي عَاذ ڒخُّو قَا أَربِّـي اَذَاش يُوْش مِين مَا ثتَّارذ-اَس."<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />ينَّا-ٱس عِيْسَى: "أَذ د يكَّر عَاوذ وُوْمَام."<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />ثنَّا-ٱس مَرْثَا: "سّْنغ اَذ د يكَّر ذِي ڒْوقْث ن لْقِيَامَا ذِي نْهَار اَنݣَّارُو."<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />ينَّا-ٱس عِيْسَى: "نش ذ لْقِيَامَا نش ذ ثُوْذَارْث، ونِّي يتَامْنن زَّايي اَتَاف اَذ يدَّر وَاخَّا يمُّوْث. <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />مَارَّا ونِّي يدَّرن أُو نتَّا يتَامن زَّايِي اَتَاف وَار يتْمتِّي إِ ڒبْدَا. مَا ثُوْمْنذ زِي مَانَايَا؟"<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />ثنَّا-ٱس: "وَاه آ سِيذِي. نش ؤُمْنغ قَا شك ذ لْمَسِيح، شك ذ مِّيس ن أَربِّـي، شك ذ ونِّي إِي د يتَاسن غَار دُّنشْت." <verse eid="JHN 11:27" /><verse number="28" style="v" sid="JHN 11:28" />وَامِي ثنَّا مَانَايَا، ثْرُوْح ثْڒَاغَا-د إِ وتْشْمَاس س ڒْحسّ ثنَّا-ٱس: "لْمُعَلِّم يُوْسَا-د يرزُّو خَام."<verse eid="JHN 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 11:29" />وَامِي ثسْڒَا مَانَايَا، ثكَّر س ثَازْڒَا ثْرَاح غَارس. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />عِيْسَى عَاذ وَار د يُوْسِي شَا غَار وبِيلَاج، أَقَاث ذݣ ومْشَان مَانِي ث تڒْقَا مَرْثَا. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />ئِسْرَائِيلِيْين نِّي اَقَاثن اَك مَرْيَم ذِي ثدَّارث تْعزَّان-ت. وَامِي ࢲْرِين مَرْيَم ثكَّر س ثَازْڒَا ثفّغ نِثْنِي ذْفَارن-ت تْغِير-اَسن اَذ تْرَاح غَار ونْضڒ اَذ تْرُو ذِنِّي. <verse eid="JHN 11:31" /><verse number="32" style="v" sid="JHN 11:32" />وَامِي د تُوْسَا مَرْيَم مَانِي يدْجَا عِيْسَى، ثࢲْرِي-ث ثوْضَا-يَاس غَار يضَارن نّس ثنَّا-ٱس: "آ سِيذِي، مَعْلِيك اَقَاش ذَانِيتَا إِڒِي وَار يمُّوْث شَا ؤُمَا."<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />عِيْسَى وَامِي ت يࢲْرَا ثتْرُو حتَّا ذ يسْرَائِيلِيْين نِّي إِي كِذس د يُوْسِين ؤُڒَا ذ نِثْنِي تْرُوْن، نتَّا ؤُڒ نّس ئِغْڒب-يث يخيّق ذِي نّفْس نّس. <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />ينَّا-ٱسن: "مَانِي ث تْنضْڒم؟"</para>
  <para style="p" vid="JHN 11:34">نَّان-اَس: "أَرَاح-د آ سِيذِي اَذ تࢲرذ." <verse eid="JHN 11:34" /><verse number="35" style="v" sid="JHN 11:35" />عِيْسَى يتْرُو. <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />نَّان يسْرَائِيلِيْين نِّي خْزَرم مشْحَاڒ تُوْغَا خَاس يعِيزّ. <verse eid="JHN 11:36" /><verse number="37" style="v" sid="JHN 11:37" />نَّان ڒبْعَاض زَّايسن قَا ذ وَانِيتَا إِي يسْݣنْفَان ثِيطَّاوِين ن وضَرْغَاڒ، مَا وَار يزمَّر اَتَاف يݣَّا شَان ڒْحَاجث بَاش وَار يتْمتِّي شَا لِعَازَر؟<verse eid="JHN 11:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />عِيْسَى يزِيدْجز-اَس عَاوذ ذݣ وُوْڒ نّس، يُوْسَا-د غَار يِيفْرِي ن ونْضڒ يُوْفَا خَاس اَزْرُو. <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />ينَّا عِيْسَى: "سْبعّْذث خَاس اَزْرُو-يَا."</para>
  <para style="p" vid="JHN 11:39">ثنَّا-ٱس مَرْثَا وتْشْمَاس ن ونِّي يمُّوْثن: "آ سِيذِي، قَا يُرْصُوْض ڒَاحقَّاش ثعْذُو خَاس اَرْبعِيَّام زݣ وَامِي يمُّوْث."<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />ينَّا-ٱس عِيْسَى: "يَاش نِّيغ-اَم، مڒَا ثُوْمْنذ اَذ تࢲرذ لْعَظَمَا ن أَربِّـي؟" <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />أُوْشَا نِثْنِي سْبعّْذن اَزْرُو نِّي. ئِيْسِي عِيْسَى ثِيطَّاوِين غَار وجنَّا ينَّا: "تْشكَّرغ-شك آ بَابَا ثسْتَاجْبذ-اَيِي. <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />نش سّْنغ قَا شك ڒبْدَا تسْتَاجَابذ-اَيِي، وَلَكِن نش قَّارغ مَانَايَا عْلَاحْسَاب خ ڒْغَاشِي-يَا إِي ذَايِي د ينّْضن، حمَا اَذ اَمْنن بلِّي قَا ذ شك إِي ذَايِي د يسّكّن." <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />وَامِي ينَّا مَانَايَا، ئِڒَاغَا س جّْهذ ينَّا: "آ لِعَازَر، ٱفّْغ-د سّنِّي!" <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />ئِفّغ-د ونِّي يمُّوْثن، ئِنّض-اَس ڒشْفن خ يفَاسّن ذ يضَارن خ وغمْبُوْب نّس خَاس ڒْقَبّ. ينَّا-ٱسن عِيْسَى: "كّْسم خَاس ڒشْفن نِّي، اجّم-ث اَذ يُوْيُوْر."<verse eid="JHN 11:44" /></para>
  <para style="s">ئِسْرَائِيلِيْين تَافْقن اَذ نْغن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />أَطَّاس ن يسْرَائِيلِيْين إِي د يُوْسِين غَار مَرْيَم ࢲْرِين مِين يݣّا عِيْسَى ؤُمْنن زَّايس. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />وَلَكِن ينّغْنِي رُوْحن غَار يفَرِّيسيْين نَّان-اَسن مِين يݣّا. <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />مُوْنن اَرُّوْيَاس ن ڒْفُقَهَا ذ يفَرِّيسيْين اَك جْمَاعث ن لْحُكَّام ن أَيث-إِسْرَائِيل نَّان: "مِين غَا نݣّ؟ قَا اَرْيَاز-أَ يتݣّ اَطَّاس ن لْمُعْجِيزَاث. <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />مڒَا نجّي-ث اَمُّو، مَارَّا اَزَّايس اَمْنن. أَذ د اَسن يرُوْمَانِيْين، أَذَانغ خَرْبن ثَمْزِيذَا ثَمقّْرَانْت نّغ ذ لْأُمَّا نّغ."<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />يجّن زَّايْسن قَّارن-اَس قِيَافَا، نتَّا ذ اَرَّايس ن ڒْفُقَهَا ذݣ وسݣّْوَاس نِّي. ئِكَّر نتَّا ينَّا-ٱسن: "كنِّيو وَار ثسِّينم وَالُو، <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />وَار ثفْهِيمم شَا. حْسن إِ كنِّيو اَذ يمّث يجّن ن ورْيَاز خ شَّعْب حمَا وَار ثْفنِّي شَا لْأُمَّا نّغ مَارَّا."<verse eid="JHN 11:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 11:51" />نتَّا ذݣ وسݣّْوَاس نِّي تُوْغَاث ذ اَرَّايس ن ڒْفُقَهَا. وَار ينِّي شَا مَانَاينِّي زݣ يِيخف نّس؛ لَّا، يُوْسَا-ٱس-د مَانَاينِّي زِي أَربِّـي بلِّي عِيْسَى اَذ يمّث خ لْأُمَّا ن أَيث-إِسْرَائِيل. <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />وَار يدْجِي بُو خ لْأُمَّا ن أَيث-إِسْرَائِيل وَاهَا، ؤُڒَا ذ ثَارْوَا ن أَربِّـي يتمْزدْجَاعن ذِي ثْمُوْرَا، أَثن يسْمُوْن أَربِّـي ذ يجّن. <verse eid="JHN 11:52" /><verse number="53" style="v" sid="JHN 11:53" />زِي نْهَار نّي تَافْقن حمَا اَث نْغن.<verse eid="JHN 11:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 11:54" />خ مَانَايَا وَار يقِّيم شَا عِيْسَى يتْرَاح يتَاس-د جَار يسْرَائِيلِيْين. ئِرُوْح غَار شَان ثْمُوْرْث ثُوْذس ڒخْڒَا، غَار يِج وبِيلَاج قَّارن-اَس أَفْرَايِم يقِّيم ذِنِّي اَك يمحْضَارن نّس.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />ئِقَارّب-د ڒْعِيذ اَمقّْرَان ن أَيث-إِسْرَائِيل. ؤُسِين-د اَطَّاس ن يِوْذَان زِي ڒدْشُوْر غَار لْقُدْس حمَا اَذ طهَّارن يخف نْسن قْبڒ إِ ڒْعِيذ. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />تُوْغَا رزُّوْن خ عِيْسَى، سَّاوَاڒن وَامِي بدّن ذِي ثمْزِيذَا ثَمقّْرَانْت ن أَيث-إِسْرَائِيل قَّارن جَارَاسن، مِين تْوَاڒَام؟ مَا وَار د يتِيس شَا غَار ڒْعِيذ؟ <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />أَرُّوْيَاس ن ڒْفُقَهَا ذ يفَرِّيسيْين وصَّان ونِّي إِي غَا يࢲرن مَانِي يدْجَا عِيْسَى، أَسن ت يِينِي بَاش اَذ رَاحن اَث طّْفن.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">مَرْيَم ثْذهّن سِيذِيثْنغ عِيْسَى س وَامَان ن لْوَرْذ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />ستِّييَّام قْبڒ إِ ڒْعِيذ اَمقّْرَان، يُوْسَا-د عِيْسَى غَار بَيْت عَنْيَا مَانِي يزدّغ لِعَازَر ونِّي إِي د يسكَّر عِيْسَى زِي ڒْموْث. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />ݣّين-اَس اَمنْسِي ذِنِّي، <char style="it">ؤُتْشْمَاس</char> مَرْثَا تْسخَّار لِعَازَر يقِّيم اَكِذْسن. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />ثيْسِي-د مَرْيَم اَزْين ن لِيتْرُو ن وَامَان ن لْوَرْذ صْفَان زݣ يِنِّي يغْڒَان س وَاطَّاس، ثذْهن-اَس إِ عِيْسَى يضَارن نّس، ثمْسح-اَس يضَارن نّس س وشوَّاف نّس. ثَدَّارْث مَارَّا ثشُّوْر س اَرِّيحث ن وَامَان نِّي ن لْوَرْذ. <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />يجّن زݣ يمحْضَارن نّس، ونِّي ؤُمِي قَّارن يَهُوْذَا إِسْخَريُوْطِي أُو ذ نتَّا إِي غَا يزّنْزن عِيْسَى، ينَّا-ٱسن: <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />"مَايمِّي وَار زّنْزن شَا اَمَان نِّي ن لْوَرْذ س ثڒْتمِيَّا ن ثْپـيَّاسِين ن نُّقَارْث اَذ مُّوْشنْت إِ يمسْعَان؟" <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />وَامِي ينَّا اَمُّو مَاشِي زِيدْجْزن-اَس يمسْعَان؛ لَّا، نتَّا ذ اَشفَّار مْكلّف خ وشمُّوْس ن تْمنْيَاث يتَاشَار زِي مِين ذِن سْرُوْسَان.<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />ينَّا-ٱس عِيْسَى: "اجّ-يت، نتَّاث ثْخمّڒ اَمَان-أَ إِ نْهَار ن ثنْضڒْث ينُو. <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />ئِمسْعَان اَقَاثن اَكِذْوم ڒبْدَا، نش وَار كِذْوم تْغِيمِيغ شَا إِ ڒبْدَا."<verse eid="JHN 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />ؤُسِين-د اَطَّاس ن ڒْغَاشِي ن يسْرَائِيلِيْين وَامِي د اَرِّين ڒخْبَار بلِّي نتَّا اَقَاث ذِنِّي. وَار يدْجِي خ عِيْسَى وَاهَا، ؤُسِين-د اَذ ࢲْرن ؤُڒَا ذ لِعَازَر ونِّي إِي د يسكَّر زِي ڒْموْث. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />خ مَانَاينِّي تَافْقن اَرُّوْيَاس ن ڒْفُقَهَا اَذ نْغن ؤُڒَا ذ لِعَازَر. <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />مَايمِّي؟ ڒَاحقَّاش نتَّا ذ سَّبَاب مِينْزِي تْبعَّاذن خَاسن اَطَّاس ن يسْرَائِيلِيْين تَامْنن زِي عِيْسَى.<verse eid="JHN 12:11" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتَاذَاف خ وسْنُوْس غَار لْقُدْس</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />ثِيوشَّا نّس قَاع ڒْغَاشِي نِّي إِي د يُوْسِين غَار ڒْعِيذ سْڒِين بلِّي عِيْسَى يݣُّوْر-د غَار لْقُدْس. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />ئِيْسِين اَفْرِيون ن ثْشجُّوْرَا ن تْمَر <char style="it">بَاش اَزَّايس رحْبن</char> فّْغن اَث ڒْقَان س ڒفْرَاحث. تْعيَّاضن قَّارن لْحَمْدُو إِ أَربِّـي! سَّعْذ ن وَانِيتَا إِي د يُوْسِين عْلَاحْسَاب يسم ن سِيذِي أَربِّـي، قَا نتَّا ذ اَزدْجِيذ ن أَيث-إِسْرَائِيل!<verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />يُوْفَا عِيْسَى يجّن ن وسْنُوْس ينْيَا خَاس مَامّش إِي يُوْرَا ذِي لْكِتَاب:<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />"وَار تݣّْوذ شَا آ يدْجِيس ن لْقُدْس.</para>
  <para style="q2" vid="JHN 12:15">خْزَر، أَزدْجِيذ نّمْ اَقَا يُوْسَا-د غَارم،</para>
  <para style="q2" vid="JHN 12:15">ئِنْيَا-د خ وسْنُوْس."<verse eid="JHN 12:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />ئِمحْضَارن نّس وَار فْهِيمن شَا إِ ثْمسْڒَايِين-أَ ذݣ ومزْوَارُو. وَلَكِن وَامِي يتْوَارْفع عِيْسَى عَاذ إِي د فكَّرن مَانَايَا يُوْرَا خَاس ذِي <char style="it">لْكِتَاب</char> بلِّي يوْقع-اَس.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />ڒْغَاشِي نِّي كِذس، ࢲْرِين وَامِي د يڒَاغَا خ لِعَازَر زݣ ونْضڒ يسكَّر-يث-يذ زِي ڒْموْث، ڒْغَاشِي-يَا عَاذ قِّيمن شهّْذن خ مَانَاينِّي. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />س مَانَايَا ڒْقَان-ث-يذ ڒْغَاشِي نّغْنِي مِينْزِي ڒْغَاشِي-يَا سْڒِين بلِّي تُوْغَا يݣّا لْمُعْجِيزَا نِّي. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />نَّان يفَرِّيسيْين جَارَاسن: "أَقَا تْوَاڒَام وَار ثُوْوِّيضم غَار وَالُو! دُّنشْت مَارَّا ثْذفَّار-يث."<verse eid="JHN 12:19" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسڒْمَاذ خ مَامّش إِي غَا يتْوَارْفع</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />يِنِّي يݣَعّْذن اَذ عبْذن ذِي ڒْعِيذ اَكِذْسن ڒبْعَاض ن ييُوْنَانيْين. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />ئِيُوْنَانِيْين-أَ ؤُسِين-د غَار فِيلِيپَّـاس، فِيلِيپَّـاس نتَّا زݣ وبِيلَاج ن بَيْت صَيْدَا ذِي لْجَالِيل. تتَّارن-اَس نَّان-اَس، آ سِيذِي نخْس أَ نْࢲر عِيْسَى. <verse eid="JHN 12:21" /><verse number="22" style="v" sid="JHN 12:22" />ئِرُوْح فِيلِيپَّـاس غَار أَنْدْرُوْس بَاش اَذَاس ث يِينِي، أُوْشَا رُوْحن س ثْنَاين إِذْسن غَار عِيْسَى نَّان-اَس-ث.<verse eid="JHN 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 12:23" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "ثُوْسَا-د ڒْوقْث اَذ يتْوَارْفع مِّيس ن بْنَاذم. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />أَقَا تسْڒَام ڒْحَقّ: ثَحبُّوْشْت ن يِرْذَان مڒَا وَار تْوَاࢲُّو شَا ذِي ثْمُوْرْث يعْنِي مڒَا وَار تْوَانْضڒ شَا، اَتَاف اَذ ثقِّيم ذ ثَحبُّوْشْت وَاهَا. مڒَا تْوَانْضڒ اَذ تُوْش اَطَّاس ن ڒْحَبّ. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />ونِّي يتخْسن ثُوْذَارْث نّس، أَتَاف اَت يخْسَر. ونِّي يتْعِيفَّان ثُوْذَارْث نّس ذِي دُّنشْت-أَ، أَتَاف اَت يَاف ذِي ثُوْذَارْث ن ڒبْدَا. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />ونِّي يخْسن اَذَايِي يخْذم، ئِتْخصَّا اَذَايِي يذْفَار. مَانِي غَا يڒِيغ نش، أَذ يِيڒِي عَاوذ ذ اَخدَّام ينُو. ونِّي ذَايِي غَا يخذْمن، أَث يكَرّم بَابَا.<verse eid="JHN 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />ڒخُّو ڒَعْمَر ينُو يخيّق. مَا ٱذ ينِيغ: آ بَابَا سنْجم-اَيِي زِي ڒْوقْث-أَ؟ لَّا، خ سَّبَاب ن ڒْوقْث-أَ مِينْخف إِي د ؤُسِيغ. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />آ بَابَا، سمْغَار يسم نّش."</para>
  <para style="p" vid="JHN 12:28">أُوْشَا يُوْسَا-د يجّن ن صُّوْت زݣ وجنَّا ينَّا، سمْغَارغ-ث، أَث سمْغَارغ عَاوذ. <verse eid="JHN 12:28" /><verse number="29" style="v" sid="JHN 12:29" />ڒْغَاشِي نِّي تُوْغَا يبدّن تسْڒَان، نَّان اَقَا وَا ذ اَجَّاج. ينّغْنِي نَّان، اَقَا ثسِّيوڒ غَارس يجّن ن لْمَلَائِكَا.<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />ينَّا-ٱسن عِيْسَى: "صُّوْت-أَ وَار يدْجِي بُو إِ يِيخف ينُو لَّا، إِ كنِّيو. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />ڒخُّو اَذ تْوَاعَاقب دُّنشْت-أَ. ڒخُّو لْمُفْسِيد نِّي<note caller="+" style="f"><char style="fr" closed="false">12‏.31 </char><char style="ft" closed="false">ذِي لْكِتَاب ن لْأَصل لْحَاكم قَّارن-ث إِ لْمُفْسِيد، يعْنِي إِبْڒِيس.</char></note> اَمقّْرَان ن دُّنشْت-أَ اَخَاس اَزّْڒن. <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />خْمِي غَا تْوَاسْبدّغ ذݣ وجنَّا إِ ثْمُوْرْث، أَذ سذْفَارغ غَارِي مَارَّا يوْذَان." <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />س وَاوَاڒ-أَ يرزُّو اَسن د يسْبيّن ڒْموْث نِّي إِي غَا يمّث.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />نَّان-اَس ڒْغَاشِي نِّي: "نشِّين نسْڒَا زِي مِين يقَّار لْكِتَاب قَا لْمَسِيح اَذ يقِّيم إِ ڒبْدَا. إِيوَا، مَامّش ثقَّارذ شك قَا مِّيس ن بْنَاذم يتْخصَّا اَذ يتْوَاسْبدّ ذݣ وجنَّا؟ مِين يعْنَا مِّيس-أَ ن بْنَاذم قَاع؟"<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />ينَّا-ٱسن عِيْسَى: "ذْرُوْسْت ن ڒْوقْث إِي كِذْوم يتِيڒِي نُّوْر. ؤُيُوْرم مَدَامَا عَاذ غَارْوم نُّوْر-أَ حمَا وَار خَاوم د ثْحَرّث ثَادْجسْت. ونِّي يݣُّوْرن ذِي ثَادْجسْت وَار يسِّين مَانِي يݣُّوْر. <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />خْمِي عَاذ غَارْوم نُّوْر، أَمْنث زِي نُّوْر-أَ حمَا كنِّيو اَذ تْذوْڒم ذ ثَارْوَا ن نُّوْر." وَامِي ينَّا مَانَايَا عِيْسَى يُوْيُوْر ينُّوْفَّر زَّايسن.<verse eid="JHN 12:36" /></para>
  <para style="s">أَيْث-إِسْرَائِيل تَاݣِين اَذ اَمْنن</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />عِيْسَى وَاخَّا يݣّا اَطَّاس ن لْمُعْجِيزَاث زَّاثْسن، وَار زَّايس ؤُمِينن شَا. <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />مَانَايَا حمَا اَذ يكمّڒ إِ مِين ينَّا نَّبِي ؤُمِي قَّارن إِشَعْيَا:</para>
  <para style="q1" vid="JHN 12:38">&lt;آي أَربِّـي، وِي يُوْمْنن س وَاوَاڒ نّغ؟</para>
  <para style="q2" vid="JHN 12:38">إِ وُوْمِي د يسْبيّن جّْهذ ن وفُوْس ن أَربِّـي؟&gt;<verse eid="JHN 12:38" /></para>
  <para style="b" />
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />س مَانَايَا وَار زمَّرن شَا اَذ اَمْنن مِينْزِي إِشَعْيَا ينَّا عَاوذ:<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />&lt;ئِسْضرْغڒ-يثن زِي ثِيطَّاوِين نْسن،</para>
  <para style="q1" vid="JHN 12:40">ئِسّقْسح-اَسن ؤُڒَاون نْسن،</para>
  <para style="q1" vid="JHN 12:40">حمَا وَار تْوِيڒِين س ثِيطَّاوِين نْسن،</para>
  <para style="q1" vid="JHN 12:40">حمَا وَار فهّْمن س وُوْڒَاون نْسن،</para>
  <para style="q1" vid="JHN 12:40">بَاش وَار غَارِي د ذوِّيڒن نش اَثن سْݣنْفِيغ.&gt;<verse eid="JHN 12:40" /></para>
  <para style="b" />
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />نَّبِي إِشَعْيَا ينَّا مَانَايَا خ عِيْسَى وَامِي يࢲْرَا لْعَظَمَا نّس يسِّيوڒ خَاس نتَّا.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />إِنَّمَا، يوْذَان اَطَّاس وَاخَّا زِي اَرُّوْيَاس نِّي ؤُمْنن زَّايس. وَلَكِن خ سَّبَاب ن يفَرِّيسِيْين ؤُݣِين يِوْذَان-أَ اَت ينِين حمَا وَار ثن طرْدن شَا زِي ثمْزِيذَا. <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />أَقَا رزُّوْن اَرْضَا ن يِوْذَان كْتَار زِي اَرْضَا ن أَربِّـي.<verse eid="JHN 12:43" /></para>
  <para style="s">أَوَاڒن ن سِيذِيثْنغ عِيْسَى ذ يِنِّي إِي غَا يحَاسْبن يوْذَان</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />عِيْسَى يتْخَاطَاب س جّْهذ ينَّا: "ونِّي يتَامْنن زَّايي، مَاشِي يتَامن زَّايِي يتَامن زِي ونِّي إِي ذَايِي د يسّكّن. <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />ونِّي إِي ذَايِي يࢲْرِين، يࢲْرَا ونِّي إِي ذَايِي د يسّكّن. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />ؤُسِيغ-د غَار دُّنشْت-أَ ذ نُّوْر حمَا ونِّي إِي زَّايِي يُوْمْنن وَار يتْغِيمِي شَا ذِي ثَادْجسْت. <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />ونِّي غَا يسْڒن إِ وَاوَاڒ ينُو وَار ذَاس يتْطِيعِي شَا اَتَاف نش وَار ث تْحِسِيبغ شَا. أَقَا نش وَار د ؤُسِيغ شَا اَذ حَاسْبغ دُّنشْت؛ لَّا، ؤُسِيغ-د حمَا اَذ سنْجْمغ دُّنشْت. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />ونِّي إِي ذَايِي يتْعيَّابن نتَّا وَار يقبّڒ شَا اَوَاڒ ينُو، أَتَاف غَارس وِي ث غَا يحَاسْبن. أَوَاڒَ-أَ إِي نِّيغ ذ ونِّي إِي ث غَا يحَاسْبن ذِي نْهَار اَنݣَّارُو. <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />أَقَا وَار سِّيوْڒغ شَا زِي غَاري؛ لَّا، نش سَّاوَاڒغ نش قَّارغ زِي ڒُوْصِيّث إِي ذَايِي يُوْشَا بَابَا يعْنِي ونِّي إِي ذَايِي د يسّكّن. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />سّْنغ ڒُوْصِيّث نّس نتَّاث ذ ثُوْذَارْث ن ڒبْدَا. مِين سَّاوَاڒغ نش، سَّاوَاڒغ-ث عْلَاحْسَاب مَامّش إِي ذَايِي ينَّا بَابَا."<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">سِيذِيثْنغ عِيْسَى يسِّيرِيذ يضَارن ن يمحْضَارن نّس</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />قْبڒ إِ ڒْعِيذ اَمقّْرَان، نتَّا عِيْسَى يسّن قَا ڒْوقْث نّس ثُوْوض-د اَذ يمُوْتِّي زِي دُّنشْت-أَ غَار بَابَاس. نتَّا يحِبّ يِنِّي يدْجَان اَكِذس ذِي دُّنشْت، ئِحِبّ-يثن اَڒ ونݣَّارُو. <verse eid="JHN 13:1" /><verse number="2" style="v" sid="JHN 13:2" />قْبڒ اَمنْسِي تُوْغَا إِبْڒِيس يغَرّ يَهُوْذَا مِّيس ن سِمْعَان إِسْخَرْيُوْطِي حمَا اَذ يزّنْز عِيْسَى. <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />تُوْغَا عِيْسَى يسّن قَا بَابَاس يݣَّا-ٱس كُڒْشِي ذݣ يفَاسّن نّس، يُوْسَا-د زِي أَربِّـي اَذ يذْوڒ غَار أَربِّـي. <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />ئِكَّر خ ومنْسِي يكّس تْشَامِّير نّس، ييْسِي يجّن ن ومنْدِيڒ يصَّار يخف نّس. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />ئِفَرّغ-د اَمَان ذِي ثْبقِّيث<note caller="+" style="f"><char style="fr" closed="false">13‏.5 </char><char style="ft" closed="false">ثَبقِّيث قَّارن-ت إِ ثْحبِّيث.</char></note> يبْذَا يسِيرِيذ يضَارن ن يمحْضَارن نّس، ئِمْسح-اَسن س ومنْدِيڒ مِيزِي يصَّار يخف نّس.<verse eid="JHN 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 13:6" />وَامِي د يُوْسَا غَار سِمْعَان بُطْرُس ينَّا-ٱس إِ عِيْسَى: "مَا شك آ سِيذِي اَذَايِي ثْسِيرْذذ يضَارن ينُو؟"<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />ينَّا-ٱس عِيْسَى: "شك ڒخُّو وَار ثفْهِيمذ شَا مِين خدّْمغ، زِي سَّا اَڒ ثْسَاونْت عَاذ اَذ تْفهْمذ مَانَايَا."<verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />ينَّا-ٱس بُطْرُس: "ئِضَارن ينُو عمَّارْص اَثن ثْسِيرْذذ."</para>
  <para style="p" vid="JHN 13:8">ينَّا-ٱس عِيْسَى: "مڒَا وَار ذَاش سِيرْذغ، وَار ثْزمَّرذ شَا اَذ تِيڒِيذ ذ اَمحْضَار ينُو."<verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />ينَّا-ٱس سِمْعَان بُطْرُس: "آ سِيذِي، وَار يدْجِي شَا اَذَايِي ثْسِيڒْذذ يضَارن ينُو وَاهَا، أَذَايِي تْسِيڒْذذ ؤُڒَا ذ يفَاسّن ينُو ذ وزدْجِيف ينُو."<verse eid="JHN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10" />ينَّا-ٱس عِيْسَى: "لَّا، ونِّي يسِيرِيذن بْڒَا مَا ٱذ يسِيرذ عَاوذ. أَذ يسِيرذ يضَارن نّس وَاهَا مِينْزِي نتَّا قَاع ذ اَمنْقَاوِي. كنِّيو مَارَّا ذ يمنْقَاوِيْين إِلَّا يجّن." <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />نتَّا يسّن ونِّي إِي ث غَا يزّنْزن. س مَانَاينِّي ينَّا كنِّيو وَار ثدْجِيم شَا مَارَّا ذ يمنْقَاوِيْين.<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />وَامِي ذَاسن يسِيرذ يضَارن نْسن، ئِݣَّا تْشَامِّير نّس يقِّيم عَاوذ ينَّا-ٱسن: "مَا ثْفهْمم مِين ذَاوم ݣِّيغ؟ <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />كنِّيو ثقَّارم-اَيِي آ لْمُعَلِّم نِغ آ سِيذِي، كنِّيو غَارْوم ڒْحَقّ مِينْزِي نِيشَان قَا ذ نش. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />مڒَا نش إِݣ يدْجَان ذ سِيذِيثْوم أُو ذ لْمُعَلِّم نْوم سِيرْذغ-اَوم يضَارن نْوم، ئِتْخصَّا ؤُڒَا ذ كنِّيو اَذ تْسِيرْذم يضَارن إِ وَايَاوْيَا. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />ݣِّيغ-اَوم اَمُّو حمَا اَذ تݣّم مِين ݣِّيغ نش. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />أَقَا تسْڒَام ڒْحَقّ: أَخدَّام وَار يدْجِي شَا ذ اَمقّْرَان زݣ ؤُوقَّاف نّس. أَمْسخَّار وَار يدْجِي شَا ذ اَمقّْرَان زݣ ونِّي إِي ثِيذ يسّكّن. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />ڒخُّو ثسّْنم مَانَايَا، سَّعْذ نْوم مڒَا ثݣِّيم مِين ذَاوم نِّيغ.<verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />نش وَار سِّيوِيڒغ شَا خَاوم مَارَّا، نش سّْنغ ؤُݣ يخْضَرغ. ڒخُّو لَابُد اَذ يكمّڒ مِين د يُوْسِين ذِي لْكِتَاب: &lt;ونِّي يشِّين زݣ وغْرُوْم ينُو، يُوْوث-اَيِي س ونِيرز نّس.&gt; <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />سْخبَّارغ-كنِّيو س مَانَايَا قْبڒ مَا ٱذ يوْقع، خْمِي غَا يوْقع اَتَاف اَذ تَامْنم قَا ذ نش إِݣ يدْجَان. <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />أَقَا تسْڒَام ڒْحَقّ: ونِّي يقبّْڒن ونِّي إِي د غَا سّكّغ، أَقَا يقْبڒ-اَيِي. ونِّي ذَايِي يقبّْڒن، أَقَا يقبّڒ ؤُڒَا ذ ونِّي إِي ذَايِي د يسّكّن."<verse eid="JHN 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />وَامِي ينَّا عِيْسَى مَانَايَا، ئِخيّق ذِي نّفْس نّس ينَّا-ٱسن-ت نِيشَان: "أَقَا تسْڒَام ڒْحَقّ: ئِجّن زَّايوم اَذَايِي يزّنْز."<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />ئِمحْضَارن نّس خْزَرن ذݣ وَايَاوْيَا وَار سِّينن ونِّي مِيخف يسَّاوَاڒ. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />ذِنِّي يجّن ن ومحْضَار نّس يعِيزّ خَاس خ عِيْسَى <char style="it">اَطَّاس</char>، نتَّا يقِّيم اَك وغزْذِيس نّس. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />ئِشيَّار-اَس سِمْعَان بُطْرُس ينَّا-ٱس: "سّقْسَا-ث مِين يعْنَا ونِّي مِيخف يسَّاوَاڒ."<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />ئِميّڒ غَار عِيْسَى ينَّا-ٱس: "آ سِيذِي، مِين يعْنَا؟"<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />ينَّا-ٱس عِيْسَى: "أَذ سِّيسْنغ اَرقُّوْز-أَ ن وغْرُوْم، ونِّي ؤُمِي غَا ث ؤُشغ ذ نتَّا." ئِسِّيسن اَرقُّوْز نِّي ن وغْرُوْم، يُوْشَا-ٱس-ث إِ يَهُوْذَا مِّيس ن سِمْعَان إِسْخَرْيُوْطِي. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />وَامِي يطّف اَرقُّوْز نِّي ن وغْرُوْم يَهُوْذَا ڒخْدّنِّي يُوْذف-يث شِّيطَان. ينَّا-ٱس عِيْسَى: "ذغْيَا، ٱݣّ مين غَا ثݣّذ."<verse eid="JHN 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 13:28" />وَار يفْهِيم ؤُڒَا ذ يجّن زݣ يِنِّي إِي ذِين يحْضَارن خ مِين ذَاس ينَّا. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />تْغِيڒ-اَسن إِ ڒبْعَاض قَا ينَّا-ٱس اَذ يسغ مِين حْذَاجن ذِي ڒْعِيذ نِغ اَذ يصدّق خ يمسْعَان مِينْزِي يَهُوْذَا مْكلّف خ وشمُّوْس ن تْمنْيَاث. <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />وَامِي يطّف اَرقُّوْز نِّي ن وغْرُوْم صَافِي ئِفّغ. ڒخْدّنِّي ثُوْوض-د ثْمدِّيث.<verse eid="JHN 13:30" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسڒْمَاذ يجّن ن ڒُوْصِيّث ذ جْذِيذ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />وَامِي يفّغ يَاهُوْذَا ينَّا عِيْسَى: "ڒخُّو يتْوَاسمْغَار مِّيس ن بْنَاذم، يتْوَاسمْغَار س مِّيس ؤُڒَا ذ أَربِّـي. <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />مڒَا أَربِّـي يتْوَاسمْغَار س مِّيس، أَتَاف اَث يسمْغَار عَاوذ أَربِّـي ذݣ يِيخف نّس، أُو ذغْيَا اَث يسمْغَار. <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />آ ثَارْوَا ينُو، ثقِّيم ذْرُوْسْت ن ڒْوقْث بَاش اَذ يڒِيغ اَكِذْوم. أَخَافِي ثْرزُّوْم. مِين نِّيغ نش إِ يسْرَائِيلِيْين اَذَاوم ت ينِيغ ڒخُّو إِ كنِّيو: مَانِي غَا رَاحغ نش، وَار ثْزمَّرم شَا اَذ د تَاسم ذِنِّي. <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />ڒخُّو تِيشّغ-اَوم يجّن ن ڒُوْصِيّث ذ جْذِيذ: حِبّث اَيَاوْيَا. أُو حِبّث اَيَاوْيَا مَامّش كنِّيو حِبّغ نش. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />مڒَا كنِّيو تْحِبِّيم اَيَاوْيَا، أَتَاف اَذ سّْنن مَارَّا قَا كنِّيو ذ يمحْضَارن ينُو."<verse eid="JHN 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />ينَّا-ٱس سِمْعَان بُطْرُس: "مَانِي غَا ثْرَاحذ آ سِيذِي؟"</para>
  <para style="p" vid="JHN 13:36">ينَّا-ٱس عِيْسَى: "مَانِي غَا رَاحغ نش، ڒخُّو وَار ثْزمَّرذ شَا اَذَايِي ثذْفَارذ ذِنِّي. وَلَكِن عَاذ اَذَايِي د ثذْفَارذ."<verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />ينَّا-ٱس بُطْرُس: "آ سِيذِي، مَايمّي وَار زمَّرغ شَا اَش ذْفَارغ ڒخُّو؟ نش اَخَاك صدّْقغ ثُوْذَارْث ينُو!"<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />ينْدق-د عِيْسَى ينَّا-ٱس: "مَا ذ صَّح اَخَافِي ثْصدّْقذ ثُوْذَارْث نّش؟ أَقَا تسْڒِيذ ڒْحَقّ: أَذَايِي ثنْكَرذ ثْڒَاثَا ن ثْوَاڒَاثِين قْبڒ مَا ٱذ يدّن ويَازِيض."<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">سِيذِيثْنغ عِيْسَى نتَّا ذ اَبْرِيذ غَار أَربِّـي</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />"ئِتْخصَّا كنِّيو وَار تْخيِّيقن شَا وُوْڒَاون نْوم. أَمْنث زِي أَربِّـي، أَمْنث عَاوذ زَّايي. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />ثَدَّارْث ن بَابَا ذَايس اَطَّاس ن يخَّامن. مَعْلِيك وَار يدْجِي شَا اَمنِّي، إِڒِي نِّيغ-اَوم-ت. أَذ رَاحغ نش اَذَاوم سْوجْذغ اَمشَان. <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />خْمِي غَا رَاحغ اَذَاوم سْوجْذغ اَمشَان نِّي، أَذ د ذوْڒغ عَاوذ اَكنِّيو يْسِيغ اَكِذِي حمَا اَذ تِيڒِيم كنِّيو مَانِي غَا يڒِيغ نش. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />مَانِي غَا رَاحغ ثسّْنم اَبْرِيذ."<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />ينَّا-ٱس تُوْمَا: "آ سِيذِي، وَار نسِّين شَا مَانِي غَا ثْرَاحذ، مَامّش غَا نسّن اَبْرِيذ؟"<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />ئِنْدق-د عِيْسَى ينَّا-ٱس: "نش ذ اَبْرِيذ، نش ذ لْحَقِيقَا، نش ذ ثُوْذَارْث. وَار د يتِيس ؤُڒَا ذ يجّن غَار بَابَا إِلَّا زَّايي. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />مڒَا ثسّْنم-اَيِي، أَتَاف اَذ تسّْنم ؤُڒَا ذ بَابَا عَاوذ. قَا ڒخُّو ثسّْنم-ث ثࢲْرِيم-ث."<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />ينَّا-ٱس فِيلِيپَّـاس: "آ سِيذِي، سْمظْهَار-اَنغ-د بَابَاش أُو صَافِي يكْفَا-يَانغ."<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />ينَّا-ٱس عِيْسَى: "قَاع ڒْوقْث-أَ إِي كِوم كِّيغ عَاذ وَار ذَايِي ثسِّينذ شَا آ فِيلِيپَّـاس؟ ونِّي إِي ذَايِي يࢲْرِين، يࢲْرَا بَابَا. مَايمِّي ذَايِي ثتَّارذ اَذَاوم د سْمظْهَارغ بَابَا؟ <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />مَا وَار تِيمْنذ شَا بلِّي نش اَقَايِي ذِي بَابَا، بَابَا اَقَاث ذَايِي؟ أَوَاڒن إِي ذَاوم قَّارغ وَار ثن قَّارغ شَا نش، ذ بَابَا إِي ذَايِي إِي ثن يقَّارن. نتَّا يخدّم ڒخْذَايم نّس. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />أَمْنم-اَيِي نش اَقَايِي ذِي بَابَا، بَابَا اَقَاث ذَايي، نِغ اَمْنم زِي ڒخْذَايم نِّي س يِيخف نْسنْت. <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />أَقَا تسْڒَام ڒْحَقّ: ونِّي زَّايي يُوْمْنن، أَتَاف اَذ يݣّ ڒخْذَايم إِي خدّْمغ نِغ كْتَار مِينْزِي نش ݣُّوْرغ غَار بَابَا. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />مَارَّا مِين غَا ثتَّارم عْلَاحْسَاب يسم ينُو اَث خذْمغ حمَا اَذ يتْوَاسمْغَار بَابَا س مِّيس. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />مِين ذَايي غَا ثتَّارم عْلَاحْسَاب يسم ينُو، أَث خذْمغ.<verse eid="JHN 14:14" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسڒْمَاذ خ أَرُّوْح يقدّْسن</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />مڒَا تْحِبِّيم-اَيِي كنِّيو، ݣّث زِي ڒُوْصِيَاث ينُو. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />نش اَذ تَّارغ إِ بَابَا حمَا اَذَاوم يُوْش لْمُعَاوِن نّغْنِي حمَا اَكِذْوم يتِيڒِي إِ ڒبْدَا. <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />لْمُعَاوِن نتَّا ذ أَرُّوح ن لْحَقِيقَا. وَار ثْزمَّر دُّنشْت اَث تقْبڒ، مِينْزِي نتَّاث وَار ث تْوِيڒِي شَا وَار ث ثسِّين شَا. وَلَكِن كنِّيو ثسّْنم-ث مِينْزِي يقِّيم اَكِذْوم أُو اَذ يِيڒِي ذَايوم. <verse eid="JHN 14:17" /><verse number="18" style="v" sid="JHN 14:18" />وَار كنِّيو تِجِّيغ شَا ذ يـيُوْجِيڒن، أَغَارْوم د عقْبغ. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />شْوِيت ن ڒْوقث إِݣ يقِّيمن وَار ذَايِي ثْࢲرّ شَا دُّنشْت-أَ، وَلَكِن كنِّيو اَذَايِي ثࢲرم. وَامِي نش دَّرغ، ؤُڒَا ذ كنِّيو اَذ تدَّرم. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />ذِي نْهَار نِّي اَذ تسّْنم بلِّي نش اَقَايي ذِي بَابَا، كنِّيو ذَايِي، نش ذَايْوم. <verse eid="JHN 14:20" /><verse number="21" style="v" sid="JHN 14:21" />ونِّي غَار دْجَانْت ڒُوْصِيَاث ينُو يخدّم زَّايْسنْت، أَتَاف يتْحِبَّا-اَيِي. ونِّي ذَايي يتْحِبَّان، أَتَاف اَث يحِبّ ؤُڒَا ذ بَابَا. أَث حِبّغ ؤُڒَا ذ نش، أَذَاس د سْمظْهَارغ يخف ينُو."<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />ينَّا-ٱس يَهُوْذَا (مَاشِي يَهُوْذَا إِسْخَرْيُوْطِي): "آ سِيذِي، مَايمِّي غَا د ثْسظْهَارذ يخف نّش إِ نشِّين، دُّنشْت لَّا؟"<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />ينَّا-ٱس عِيْسَى: "ونِّي ذَايِي يتْحِبَّان، أَتَاف اَذ يخْذم زݣ وَاوَاڒ ينُو. أَث يحِبّ بَابَا، أَ نْرَاح غَارس نش ذ بَابَا، غَارس إِي غَا نزْذغ. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />ونِّي وَار ذَايِي يتْحِبِّين، أَتَاف وَار يخدّم شَا زݣ وَاوَاڒ ينُو. أَوَاڒن-أَ إِي تسْڒَام وَار دْجِين شَا ينُو لَّا، ن بَابَا إِي ذَايِي-د يسّكّن.<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />ثِمسْڒَايِين-أَ نِّيغ-اَوم-ثنْت أُو نش عَاذ اَقَايِي اَكِذْوم. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />لْمُعَاوِن نِّي نتَّا ذ أَرُّوْح يقدّْسن، أَثِيذ يسّكّ بَابَا عْلَاحْسَاب يسم ينُو اَذَاوم يسڒْمذ كُڒْشِي اَكنِّيو يسْفكَّر مَارَّا مِين ذَاوم نِّيغ.<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />تِيجّغ-اَوم ڒهْنَا، تِيشّغ-اَوم ڒهْنَا ينُو. وَار ذَاوم ث تِيشّغ شَا اَم ث تِيشّ دُّنشْت. ئِتْخصَّا ؤُڒَاون نْوم وَا تْخيِّيقن وَار تݣّْوْذن شَا. <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />ثسْڒَام قَا نِّيغ-اَوم: نش اَذ ؤُيُوْرغ، أَذ د عقْبغ غَارْوم. مڒَا ثْحِبِّيم-اَيِي، أَتَاف كنِّيو اَذ تْفَرْحم بلِّي اَذ رَاحغ غَار بَابَا مِينْزِي بَابَا ذ اَمقّْرَان خَافِي. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />نش نِّيغ-اَوم-ت ڒخُّو قْبڒ مَا ٱذ يوْقع، بَاش خْمي غَا يوْقع كنِّيو اَذ تَامْنم. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />وَار كِذْوم سِّيوِيرغ شَا نش عَاذ اَطَّاس مِينْزِي لْمُفْسِيد<note caller="+" style="f"><char style="fr" closed="false">14‏.30 </char><char style="ft" closed="false">ذِي لْكِتَاب ن لْأَصل لْحَاكم قَّارن-ث إِ لْمُفْسِيد، يعْنِي إِبْڒِيس.</char></note> نِّي اَمقّْرَان ن دُّنشْت-أَ يتَاس-د. وَار غَارس بُو ثْزمَّار خَافِي. <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />لَّا، نش تݣّغ زِي مِين ذَايِي يوصَّا بَابَا حمَا دُّنشْت-أَ اَذ تسّن قَا نش تْحِبِّيغ بَابَا. كَّرث سَّانِيتَا، يَالَّه أَ نْرَاحم."<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">سِيذِيثْنغ عِيْسَى نتَّا ذ اَࢲْوَار ن ڒفْرَاحث نّغ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />"نش ذ ثْزَايَارْث وضِيڒ ذ صَّح. بَابَا ذ بَاب ن ثْزَايَارْث وضِيڒ. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />كُڒ اَكشُّوْض إِي د يفّْغن زَّايِي وَار يتِيرو شَا يزكُّوْنن ن وضِيڒ اَث يقسّ بَابَا. أُو كُڒ اَكشُّوْض إِݣ يتَارْون يزكُّوْنن ن وضِيڒ أَث يزْبَار حمَا اَذ د يَرْنِي يزكُّوْنن نّغْنِي. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />كنِّيو ذ يمنْقَاوِيْين ذݣ وسڒْمذ إِي ذَاوم نِّيغ. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />قِّيمث ذَايِي، نش اَذ قِّيمغ ذَايْوم. أَمشْنَاو اَكشُّوْض نِّي وَار يزمَّر اَذ يَارو يزكُّوْنن زݣ يِيخف نّس إِلَّا مڒَا يقِّيم ذِي ثْزَايَارْث، ؤُڒَا ذ كنِّيو وَار ثْزمَّرم شَا إِلَّا مڒَا ثقِّيمم ذَايِي.<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />نش ذ ثْزَايَارْث وضِيڒ، كنِّيو ذ يكشُّوْضن. ونِّي يتْغِيمَان ذَايي أُو نش تْغِيمِيغ ذَايس، أَتَاف نتَّا اَذ يَارو يزكُّوْنن ن وضِيڒ اَطَّاس ڒَاحقَّاش كنِّيو بْڒَا زَّايي وَار ثْزمَّرم اَذ تݣّم وَالُو. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />مڒَا شَان يِجّن وَار يقِّيم شَا ذَايِي، أَتَاف اَذ يمنْضَار غَار بَرَّا اَمشْنَاو يكشُّوْضن يُوزْغن، أَثن سْمُوْنن اَثن ݣّن ذِي ثْمسِّي اَذ شمْضن. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />مڒَا ثقِّيمم ذَايي ثݣِّيم زݣ وَاوَاڒ ينُو، أَتَاف مِين مَا ثتَّارم اَغَارْوم يِيڒِي. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />أَذ تَارْوم يزكُّوْنن اَطَّاس، أَذ تِيڒِيم ذ يمحْضَارن ينُو. س مَانَايَا يتْوَاسمْغَار بَابَا.<verse eid="JHN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9" />نش تْحِبِّيغ-كنِّيو اَمشْنَاو مَامش ذَايِي يتْحِبَّا بَابَا. إِڒِيث ذِي ڒمْحِبّث ينُو. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />مڒَا ثخدّْمم زِي ڒُوْصِيَاث ينُو، أَتَاف اَذ تِيڒِيم ذِي ڒمْحِبّث ينُو اَمشْنَاو مَامش ݣِّيغ نش زِي ڒُوْصِيَاث ن بَابَا اَقَايِي ذِي ڒمْحِبّث نّس. <verse eid="JHN 15:10" /><verse number="11" style="v" sid="JHN 15:11" />نِّيغ-أَوم مَانَايَا حمَا اَذ تِيڒِي ذَايْوم ڒفْرَاحث ينُو، حمَا اَذ تِيڒِي ڒفْرَاحث نْوم ثْعمَّر. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />ڒُوْصِيّث ينُو ذ ثَانِيتَا: &lt;حِبّث اَيَاوْيَا مَامّش كنِّيو تْحِبِّيغ نش.&gt; <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />وَار ذِنِّي بُو ڒمْحِبّث كْتَار زِي ثنِّي ن بْنَاذم اَذ يصدّق ثُوْذَارْث نّس عْلَاحْسَاب يمدُّوْكَاڒ نّس. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />مڒَا تݣّم ڒُوْصِيَاث ينُو، أَتَاف كنِّيو ذ يمدُّوْكَاڒ ينُو. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />وَار يقِّيم عَاذ اَذَاوم سمِّيغ يخدَّامن مِينْزِي اَخدَّام وَار يسِّين شَا مِين يتݣّ ؤُوقَّاف نّس. كنِّيو اَذَاوم سمِّيغ يمدُّوْكَاڒ ينُو مِينْزِي نِّيغ-اَوم مَارَّا مِين سْڒِيغ زِي بَابَا. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />مَاشِي ذ كنِّيو إِي ذَايي يخْضَرن؛ لَّا، ذ نش إِي كنِّيو يخْضَرن. كلّْفغ-كنِّيو حمَا اَذ تْرَاحم اَذ تَارْوم يزكُّوْنن، حمَا يزكُّوْنن نْوم اَذ قِّيمن إِ ڒبْدَا. أَمُّو، أَذَاوم يُوْش بَابَا مَارَّا مِين ذَاس غَا ثتَّارم عْلَاحْسَاب يسم ينُو. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />ذ ثَا ذ ڒُوْصِيّث ينُو، يعْنِي اَذ تْحِبّم اَيَاوْيَا.<verse eid="JHN 15:17" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسزْعَام يمحْضَارن نّس</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />مڒَا دُّنشْت تْعِيفَّا-كنِّيو، فكَّرث قَا نش ثْعِيفّ-اَيي قْبڒ إِ كنِّيو. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />مَعْلِيك كنِّيو زِي دُّنشْت-أَ، إِڒِي كنِّيو ثْعِيزّم خ دُّنشْت-أَ. وَلَكِن كنِّيو وَار ثدْجِيم شَا زِي دُّنشْت. نش يخْضَرغ-كنِّيو زِي دُّنشْت-أَ، س مَانَاينِّي تْعِيفَّا-كنِّيو دُّنشْت. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />فكَّرث ذݣ وَاوَاڒ إِي ذَاوم نِّيغ يعْنِي اَخدَّام وَار يدْجِي شَا ذ اَمقّْرَان زݣ ؤُوقَّاف نّس. مڒَا عدّْبن-اَيِي، أَتَاف اَكنِّيو عدّْبن. مڒَا سْڒِين إِ وَاوَاڒ ينُو، أَتَاف اَذ سْڒن عَاوذ إِ وَاوَاڒ نْوم. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />نِثْنِي تݣّن-اَوم مَانَايَا مَارَّا خ سَّبَاب ن يِيسم ينُو مِينْزِي وَار سِّينن شَا ونِّي إِي ذَايِي د يسّكّن. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />مَعْلِيك وَار د ؤُسِيغ سِّيوْڒغ اَكِذْسن، أَتَاف وَار غَارسن بُو ڒْمُعْصِيّث. وَلَكِن ڒخُّو وَار غَارْسن بُو لْعُذر خ ڒْمُعْصِيّث نْسن. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />ونِّي إِي ذَايِي يتْعِيفَّان، أَتَاف يتْعِيفَّا ؤُڒَا ذَ بَابَا عَاوذ. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />مَعْلِيك وَار خْذِيمغ اَكِذْسن لْمُعْجِيزَاث وَار ثنْت يخْذِيم ؤُڒَا ذ يجّن إِلَّا نش، أَتَاف وَار غَارْسن بُو ڒْمُعْصِيّث. وَلَكِن ڒخُّو نِثْنِي ࢲْرِين لْمُعْجِيزَاث ينُو عِيفّن-اَيِي نش ؤُڒَا ذ بَابَا. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />مَانَايَا يوْقع حمَا اَذ يكمّڒ وَاوَاڒ إِݣ يُورِين ذِي شَّرِيعَا نْسن وَامِي ينَّا &lt;قَا عِيفّن-اَيي بْڒَا سَّبَاب.&gt;<verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />أَذ د يَاس لْمُعَاوِن يعْنِي أَرُّوْح ن لْحَقِيقَا. أَذَاوم ثِيذ سّكّغ نش زِي بَابَا أُو نتَّا يفّغ-د زِي بَابَا. خْمِي د غَا يَاس، أَخَافِي يشْهذ. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />أَذ تْشهْذم ؤُڒَا ذ كنِّيو عَاوذ مِينْزِي اَقَا كنِّيو اَكِذِي زݣ ومزْوَارُو."<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="nb">
    <verse number="1" style="v" sid="JHN 16:1" />"نِّيغ-اَوم مَانَايَا حمَا وَار ثْسمْحم شَا ذِي لْإِيمَان نْوم. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />أَكنِّيو طرْدن زِي ثمْزِيذَاوِين. عَاذ اَذ د تَاس ڒْوقْث اَذَاس يتْغِير إِ ونِّي إِي كنِّيو غَا ينْغن بلِّي يتݣّ لْأَجَار إِ أَربِّـي. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />نِثْنِي تݣّن مَانَايَا مِينْزِي وَار سِّينن شَا بَابَا، وَار ذَايِي سِّينن ؤُڒَا ذ نش. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />قَا نِّيغ-اَوم ثِمسْڒَايِين-أَ ڒخُّو بَاش مڒْمِي د غَا ثَاس ڒْوقْث، أَذ تْعَقْڒم بلِّي نِّيغ-اَوم-ثنْت نش. ذݣ ومزْوَارُو وَار ذَاوم نِّيغ شَا ثِمسْڒَايِين-أَ مِينْزِي نش اَقَايِي اَكِذْوم.<verse eid="JHN 16:4" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسڒْمَاذ خ ڒْخذْمث ن أَرُّوْح يقدّْسن</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5" />ڒخُّو نش اَذ رَاحغ غَار ونِّي إِي ذَايِي د يسّكّن، وَلَكِن كنِّيو ؤُڒَا ذ يجّن زَّايْوم وَار ذَايِي يسّقْسِي مَانِي غَا رَاحغ. <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />وَامِي ذَاوم نِّيغ مَانَايَا، ؤُڒَاون نْوم ذَايْسن ڒحْڒِيق اَطَّاس. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />أَقَا تسْڒَام ڒْحَقّ: حْسن إِ كنِّيو اَذ رَاحغ. مڒَا وَار رُوْحغ شَا، أَتَاف وَار غَارْوم د يتِيس شَا لْمُعَاوِن نِّي. وَلَكِن مڒَا رُوْحغ، أَتَاف اَذَاوم ثِيذ سّكّغ. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />خْمِي د غَا يَاس، أَذ د يسْبيّن إِ يِوْذَان ن دُّنشْت غَلْطن خ ڒْمُعْصِيّث ذ مِين يصڒْحَان ذ لْحِسَاب. <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />غَلْطن خ ڒْمُعْصِيّث نْسن مِينْزِي نِثْنِي وَار زَّايِي تِيمْنن شَا. <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />غَلْطن خ مِين يصڒْحَان مِينْزِي ݣُّوْرغ غَار بَابَا، وَار ذَايِي ثْࢲرّم شَا زِي سَّا ٱڒ ثْسَاونْت. <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />أُو غَلْطن خ لْحِسَاب مِينْزِي لْمُفْسِيد<note caller="+" style="f"><char style="fr" closed="false">16‏.11 </char><char style="ft" closed="false">ذِي لْكِتَاب ن لْأَصل لْحَاكم قَّارن-ث إِ لْمُفْسِيد، يعْنِي إِبْڒِيس.</char></note> نِّي اَمقّْرَان ن دُّنشْت-أَ يتْوَاحْكم.<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />غَارِي اَطَّاس ن ثْمسْڒَايِين اَذَاوم ثنْت ينِيغ، وَلَكِن ڒخُّو قسْحنْت خَاوم. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />خْمِي د غَا يَاس أَرُّوْح ن لْحَقِيقَا، أَتَاف اَذَاوم د يسْبيّن لْحَقِيقَا ثكْمَاڒ. أَقَا نتَّا وَار يسِّيوِيڒ شَا زݣ يِيخف نّس، يسَّاوَاڒ إِلَّا زِي مِين ذَاس غَا يِينِي أَربِّـي. أَذَاوم يخبَّر ذِي ثْمسْڒَايِين إِي د غَا يَاسن. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />نتَّا إِي ذَايِي غَا يسمْغَارن مِينْزِي يكسِّي زِي مِين غَارِي، أَذَاوم يخبَّر زَّايس. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />مَارَّا مِين غَارس غَار بَابَا، غَارِي ؤُڒَا ذ نش. س مَانَايَا نِّيغ-اَوم بلِّي نتَّا يكسِّي زِي مِين غَارِي، أَذَاوم يخبَّر زَّايس."<verse eid="JHN 16:15" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسوْجَاذ يمحْضَارن خ وُوْفُوْغ نّس</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />
    <char style="it">ينَّا-ٱسن عِيْسَى:</char> "شْوِيت ن ڒْوقْث وَار ذَايِي ثْࢲرّم شَا، شْوِيت ن ڒْوقْث عَاذ اَذَايِي ثࢲرم."<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />نَّان ڒبْعَاض ن يمحْضَارن نّس جَارَاسن: "مِين يخس اَذ يِينِي س وَاوَاڒ-أَ؟ ئِقَّار-اَنغ شْوِيت ن ڒْوقْث وَار ذَايي ثْࢲرّم شَا، شْوِيت ن ڒْوقْث عَاذ اَذَايِي ثࢲرم. عَاوذ يقَّار، ڒَاحقَّاش نش اَذ رَاحغ غَار بَابَا." <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />قَّارن: "مِين يخس اَذ يِينِي ڒْمَعْنَا ن &lt;شْوِيت ن ڒْوقْث&gt;؟ وَار نفْهِيم شَا مِين يقَّار."<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />ئِسّن عِيْسَى قَا رزُّوْن اَث سّقْسَان، أُوْشَا ينَّا-ٱسن: "مَايمِّي تْسقْسَام اَيَاوْيَا خ وَاوَاڒ إِي ذَاوم نِّيغ: &lt;شْوِيت ن ڒْوقث وَار ذَايِي ثْࢲرّم شَا، شْوِيت ن ڒْوقْث عَاذ اَذَايِي ثࢲرم&gt;؟ <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />أَقَا تسْڒَام ڒْحَقّ: كنِّيو اَذ تْرُوْم اَذ تْحزْنم، وَلَكِن دُّنشْت-أَ اَذ تْفَرح. كنِّيو اَذَايْوم يِيڒِي ڒحْڒِيق، وَلَكِن ڒحْڒِيق نْوم اَذ يذْوڒ ذ ڒفْرَاحث. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />ثَمْغَارْث خْمِي تَارو، يتِيڒِي ذَايس ڒحْڒِيق ڒَاحقَّاش ڒْوقْث نّس ثُوْوض-د. وَلَكِن خْمِي غَا ثَارو اَسيْمِي، وَار تْفكِّير شَا عَاذ ذِي ڒحْڒِيق نِّي س ڒفْرَاحث نّس مِينْزِي ثُوْرو-د يجّن ن وسيْمِي غَار دُّنشْت-أَ. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />ؤُڒَا ذ كنِّيو ذَايْوم ڒحْڒِيق ڒخُّو، وَلَكِن اَكنِّيو ࢲرغ عَاوذ. ڒخْدّنِّي اَذ تْفَرْحم س وُوْڒَاون نْوم، وَار ذَاوم يتكّس ڒفْرَاحث نْوم حَدّ.<verse eid="JHN 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23" />نْهَار نِّي <char style="it">إِي د غَا يَاسن</char> كنِّيو وَار ذَايِي تْسقْسِيم خ وَالُو. أَقَا تسْڒَام ڒْحَقّ: بَابَا اَذَاوم يُوْش مَارَّا مِين ذَاس غَا ثتَّارم عْلَاحْسَاب يسم ينُو. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />حتَّا ٱڒ ڒخُّو وَار ثتَّارم وَالُو عْلَاحْسَاب يسم ينُو. تَّارث اَذ تَافم، أَتَاف ڒفْرَاحث نْوم اَذ تِيڒِي ثكْمَاڒ.<verse eid="JHN 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />سِّيوْڒغ-اَوم مَانَايَا س ڒمْعَانِي. أَذ د تَاس يجّن ن ڒْوقْث وَار كِذْوم سِّيوِيڒغ شَا س ڒمْعَانِي. أَذَاوم خبَّرغ خ بَابَا س وَاوَاڒن نِيشَان <char style="it">بْڒَا ڒمْعَانِي</char>. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />نْهَار نِّي كنِّيو اَذ تتَّارم إِ بَابَا عْلَاحْسَاب يسم ينُو. قَّارغ-اَوم بلِّي مَاشِي ذ نش إِي غَا يتَّارن ذݣ ومْشَان نْوم. <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />مِينْزِي بَابَا س يِيخف نّس يتحِبَّا-كنِّيو وَامِي ذَايِي ثْحِبّم ثُوْمْنم بلِّي نش فّْغغ-د زِي أَربِّـي. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />فّْغغ-د زِي بَابَا وْضغ-د غَار دُّنشْت-أَ. أَذ ؤُيُوْرغ زِي دُّنشْت-أَ اَذ عقْبغ عَاوذ غَار بَابَا."<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />نَّان-اَس يمحْضَارن نّس: "ڒخُّو شك ثسَّاوَاڒذ نِيشَان، وَار يدْجِي شَا س ڒمْعَانِي. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />ڒخُّو نشِّين نتْوَاڒَا بلِّي ثسّْنذ كُڒْشِي وَار ثحْذِيجذ وِي ش غَا يسّقْسَان. س مَانَايَا نُوْمن بلِّي ثُوْسِيذ-د زِي أَربِّـي."<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "ڒخُّو إِي ثُوْمْنم نِغ؟ <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />أَذ د تَاس يجّن ن ڒْوقْث اَقَا ڒخُّو ثُوْسَا-د، أَذ تمْزدْجَاعم كنِّيو كُڒ يجّن زَّايْوم اَذ يروَّاح. أَذَايِي ثْسمْحم اَذ يڒِيغ وَاحْذِي، وَلَكِن وَار تِيڒِيغ شَا وَاحْذِي مِينْزِي بَابَا أَقَاث اَكِذِي. <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />قَّارغ-اَوم مَانَايَا حمَا اَذ تيْسِيم زَّايِي ڒهْنَا. ذِي دُّنشْت-أَ ثَانِيتَا اَخَاوم ثكّ ذَايس تَمَارَا، وَلَكِن شجّْعث يخف نْوم اَقَا نش ربْحغ دُّنشْت-أَ."<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">سِيذِيثْنغ عِيْسَى يتْࢲَادْجَا عْلَاحْسَاب يمحْضَارن نّس اَذ يڒِين ذ يجّن</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />وَامِي يسِّيوڒ عِيْسَى خ مَانَايَا، ئِيْسِي ثِيطَّاوِين نّس غَار وجنَّا ينَّا: "آ بَابَا، ثُوْوض-د ڒْوقْث. سمْغَار مِّيش حمَا اَش يسمْغَار. <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />مِينْزِي ثُوْشِيذ-اَس جّْهذ خ كُڒ بْنَاذم حمَا اَذ يُوْش ثُوْذَارْث ن ڒبْدَا إِ مَارَّا يِنِّي إِي ذَاس ثُوْشِيذ. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />ثُوْذَارْث ن ڒبدَا ذ ثَا يعْنِي اَش سّْنن بلِّي شك ذ أَربِّـي نِيشَان وَاحْذش، أَذ سّْنن عَاوذ عِيْسَى لْمَسِيح يعْنِي ونِّي إِي ثسّكّذ. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />نش سمْغَارغ-ش ذَا ذِي ثْمُوْرْث، كمّْڒغ ڒْخذْمث إِي ذَايِي ثُوْشِيذ. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />سمْغَار-اَيِي ڒخُّو اَكِذش آ بَابَا س لْعَظَمَا نِّي تُوْغَا غَارِي وَامِي دْجِيغ اَكِذش قْبڒ مَا ٱذ تِيڒِي دُّنشْت.<verse eid="JHN 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />سْبيّْنغ-د يسم نّش إِ يمحْضَارن-أَ إِي ذَايِي ثُوْشِيذ زِي دُّنشْت-أَ. شك ثدْجِيذ ذ بَاب نْسن قْبڒ، ثُوْشِيذ-اَيِي-ثن، قَا طَاعن إِ وَاوَاڒ نّش. <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />ڒخُّو سّْنن بلِّي مَارَّا مِين ذَايِي ثُوْشِيذ يُوْسَا-د زِي غَارك. <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />مِينْزِي نش سِّيوْضغ-اَسَن اَوَاڒ إِي ذَايِي ثُوْشِيذ، نِثْنِي قبْڒن-ث. سّْنن ذ صَّح بلِّي نش زِي غَارك إِي د ؤُسِيغ، ؤُمْنن عَاوذ بلِّي ذ شك إِي ذَايِي د يسّكّن.<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />تتَّارغ عْلَاحْسَاب إِ نِثْنِي. وَار تتَّارغ شَا عْلَاحْسَاب إِ دُّنشْت-أَ؛ لَّا، تتَّارغ عْلَاحْسَاب إِ يِنِّي إِي ذَايِي ثُوْشِيذ مِينْزِي نِثْنِي نّش. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />كُڒْشِي مِين غَارِي، غَارك. أُو كُڒْشِي مِين غَارك، غَارِي. نش تْوَاسمْغَارغ زَّايْسن. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />وَار تْغِيمِيغ شَا نش ذِي دُّنشْت، أَذ قِّيمن نِثْنِي ذَايس أُو نش ݣُّوْرغ-د غَارش. آ بَابَا اَمْقدّس، حْضَا-ثن س يِيسم نّش إِي ذَايِي ثُوْشِيذ حمَا اَذ يڒِين ذ يجّن اَم نشِّين. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />وَامِي كِذْسن دْجِيغ، حفْضغ خَاسن س يِيسم نّش إِي ذَايِي ثُوْشِيذ. حْضِيغ-ثن، ؤُڒَا ذ يجّن مَا يودَّر غِير ونِّي تُوْغَا يودَّرن حمَا اَذ يكمّڒ مِين يقَّار لْكِتَاب.<verse eid="JHN 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 17:13" />ڒخُّو ݣُّوْرغ-د غَارك. سَّاوَاڒغ اَوَاڒن-أَ أُو نش عَاذ اَقَايِي ذِي دُّنشْت حمَا اَغَارْسن ثِيڒِي ڒفْرَاحث ينُو ثكْمَاڒ. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />سِّيوْضغ-اَسَن اَوَاڒ نّش إِ يمحْضَارن ينُو، نِثْنِي عِيفّن-ثن يِوْذَان مِينْزِي وَار دْجِين شَا زِي دُّنشْت-أَ اَمشْنَاو نش وَار دْجِيغ شَا زِي دُّنشْت. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />نش وَار ذَاش تتَّارغ شَا اَثن ثْسُوْفْغذ زِي دُّنشْت-أَ؛ لَّا، تتَّارغ-اَش اَثن تحْضِيذ زِي شَّرّْ. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />نِثْنِي وَار دْجِين شَا زِي دُّنشْت، أَمشْنَاو نش وَار دْجِيغ شَا زِي دُّنشْت. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />صفَّا-ثن س لْحَقِيقَا، أَوَاڒ نّش نتَّا إِي يدْجَان ذ لْحَقِيقَا. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />مَامّش ذَايِي ثسّكّذ شك غَار دُّنشْت، ؤُڒَا ذ نش سّكّغ-ثن غَار دُّنشْت. <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />نش صفِّيغ يخف ينُو خ سَّبَاب نْسن حمَا اَذ تْوَاصفَّان ؤُڒَا ذ نِثْنِي عَاوذ س لْحَقِيقَا.<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />وَار تتَّارغ شَا عْلَاحْسَاب إِ نِثْنِي وَاهَا، تتَّارغ عْلَاحْسَاب إِ يِنِّي إِي غَا يقبْڒن اَوَاڒ نْسن حمَا اَذ اَمْنن زَّايِي. <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />حمَا اَذ يڒِين مَارَّا ذ يجّن آ بَابَا، أَم شك اَقَاش ذَايِي نش اَقَايِي ذَايك. حمَا اَذ يڒِين نِثْنِي عَاوذ ذ يجّن ذَايْنغ. حمَا اَذ اَمْنن يِوْذَان قَا ذ شك إِي ذَايِي د يسّكّن. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />نش ؤُشِيغ-اَسَن لْعَظَمَا إِي ذَايِي ثُوْشِيذ حمَا اَذ يڒِين ذ يجّن اَم نشِّين ذ يجّن. <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />شك اَقَاش ذَايِي نش اَقَايِي ذَايْسن، حمَا اَذ مُوْنن اَذ يڒِين ذ يجّن. حمَا اَذ سّْنن يِوْذَان قَا شك ثسّكّذ-اَيِي-د غَار يمحْضَارن-أَ، تْحِبِّيذ-ثن اَمشْنَاو مَامّش ذَايِي تْحِبِّيذ نش.<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />آ بَابَا، يِيْنَا ذَايِي ثُوْشِيذ خْسغ اَذ يڒِين اَكِذِي مَانِي مَا دْجِيغ نش حمَا اَذ ࢲرن لْعَظَمَا ينُو إِي ذَايِي ثُوْشِيذ مِينْزِي شك ثْحِبّذ-اَيِي قْبَڒ مَا ٱذ تِيڒِي دُّنشْت. <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />آ بَابَا يدْجَان نِيشَان، دُّنشْت وَار ش ثسِّين شَا وَلَكِن نش قَا سّْنغ-ش. يِيْنَا اَكِذِي سّْنن قَا ثسّكّذ-اَيِي-د شك. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />نش سْبيّْنغ-اَسن-د يسم نّش أُو عَاذ اَث سْبيّْنغ حمَا اَذَايْسن ثِيڒِي ڒمْحِبّث نِّي إِي زِي ذَايِي تْحِبِّيذ، أَذَايْسن يڒِيغْ نش س يِيخف ينُو."<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">ئِسْرَائِيلِيْين ذ يرُوْمَانِيْين تطّْفن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />منْبَعْد إِ ثْࢲَادْجِيث نِّي، ئِفّغ عِيْسَى اَك يمحْضَارن نّس ࢲْوَان يغْزَار ن قِيْدْرُوْن. ذِنِّي يجّن ن جَرْدَا، ؤُذْفن ذَايس نتَّا ذ يمحْضَارن نّس. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />تُوْغَا يَهُوْذَا ونِّي إِي ث غَا يزّنْزن يسّن اَمْشَان نِّي مِينْزِي عِيْسَى تُوْغَا يتْمڒْقَا ذِنِّي اَطَّاس اَك يمحْضَارن نّس. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />صَافِي، يُوْسَا-د يَهُوْذَا غَار جَرْدَا نِّي يُوْوِي-د اَكِذس ڒْعَسْكَار، تْوَاسّكّن اَكِذس عَاوذ شَان ن يعسَّاسن زݣ يفَرِّيسِيْين أُو زِي اَرُّوْيَاس ن ڒْفُقَهَا. ؤُسِين-د س ڒفْنَارَاث ذ يصْفضَاون ذ ڒسْنَاح. <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />ئِسّن عِيْسَى مَارَّا مِين ذَاس غَا يوقْعن، ئِفّغ-د غَارْسن ينَّا-ٱسن: "مِينْخف ثْرزُّوْم؟"<verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />نَّان-اَس: "خ عِيْسَى زِي نَاصِرَا."</para>
  <para style="p" vid="JHN 18:5">ينَّا-ٱسن: "أَقَا ذ نش."</para>
  <para style="p" vid="JHN 18:5">ئِبدّ اَكِذْسن يَهُوْذَا ونِّي إِي ث يزّنْزن. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />وَامِي ذَاسن ينَّا قَا ذ نش، ذوْڒن غَار ذفَّار وْضَان غَار ثْمُوْرْث.<verse eid="JHN 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 18:7" />ينَّا-ٱسن عَاوذ: "مِينْخف ثْرزُّوْم؟"</para>
  <para style="p" vid="JHN 18:7">نَّان-اَس: "خ عِيْسَى زِي نَاصِرَا."<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />ينَّا-ٱسن عِيْسَى: "قَا نِّيغ-اَوم-ث ذ نش. مڒَا ثْرزُّوْم خَافِي جّم يِيْنَا اَذ ؤُيُوْرن." <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />س وَاوَاڒ-أَ يكمّڒ مِين ينَّا عِيْسَى زِي قْبڒ يعْنِي &lt;وَار ذَايِي يودَّر حَدّ زݣ يِنِّي إِي ذَايِي ثُوْشِيذ.&gt;<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />سِمْعَان بُطْرُس تُوْغَا غَارس سِّيف، ئِجْبذ-يث-يذ يُوْوْثَا زَّايس يسْمغ ن اَرَّايس ن ڒْفُقَهَا يقسّ-اَس اَمزُّوْغ اَفُوْسِي. ئِسْمغ نِّي قَّارن-اَس مَڒْخُس.<verse eid="JHN 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 18:11" />ينَّا-ٱس عِيْسَى إِ بُطْرُس: "أَرّ سِّيف نّش غَار ومْشَان نّس. ڒْكَاس-أَ ن ڒَعْذَاب إِي ذَايِي يُوْشَا بَابَا، مَا وَار سسّغ شَا زَّايس؟"<verse eid="JHN 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />ڒْعَسْكَار ذ اَرَّايس نْسن ذ يعسَّاسن ن يسْرَائِيلِيْين طّْفن عِيْسَى شَرْفن-ث. <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />ذ اَمزْوَارُو ندْهن-ث غَار يجّن قَّارن-اَس حَنِّين مِينْزِي نتَّا ذ بَابَاس ن ثمْغَارْث ن قِيَافَا. قِيَافَا تُوْغَاث ذ اَرَّايس ن ڒْفُقَهَا ذݣ وسݣّْوَاس نِّي. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />نتَّا تُوْغَا ينْصح يسْرَائِيلِيْين ينَّا-ٱسن قَا حْسن اَذ يمّث يجّن ن ورْيَاز خ شَّعْب.<verse eid="JHN 18:14" /></para>
  <para style="s">سِمْعَان بُطْرُس ينكَّر سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />سِمْعَان بُطْرُس ذ يجّن ن ومحْضَار نّغْنِي ذْفَارن عِيْسَى. أَمحْضَار نِّي مَعْرُوْف غَار اَرَّايس ن ڒْفُقَهَا، يُوْذف اَك عِيْسَى غَار ڒمْرَاح ن ثدَّارْث ن اَرَّايس نِّي. <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />بُطْرُس يبدّ يتْرَاجَا بَارَّا غَار ثوَّارْث. ئِفّغ-د ومحْضَار نِّي إِݣ يدْجَان مَعْرُوْف غَار اَرَّايس ن ڒْفُقَهَا، ئِسِّيوڒ اَك ثْعسَّاسْت نِّي يتِيڒِين ذِي ثوَّارْث يسِّيذف-د بُطْرُس.<verse eid="JHN 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 18:17" />ثَعسَّاسْت نِّي يحطَّان ذِي ثوَّارْث ثنَّا-ٱس إِ بُطْرُس: "مَا وَار ثدْجِيذ شك زݣ يمحْضَارن ن بْنَاذم-أَ؟"</para>
  <para style="p" vid="JHN 18:17">ينَّا-ٱس: "نش، لَّا!"<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />ئِخدَّامن ذ يعسَّاسن بدّن ذِنِّي، ݣِّين ثِيمسِّي س ڒفْحَم زْغَارن غَارس مِينْزِي ثسْمض. ئِبدّ ؤُڒَا ذ بُطْرُس اَكِذْسن حمَا اَذ يزْغَار.<verse eid="JHN 18:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />ئِبْذَا اَرَّايس ن ڒْفُقَهَا يتْسقْسَا عِيْسَى خ يمحْضَارن نّس ذ مِين يسڒْمَاذ. <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />ينَّا-ٱس عِيْسَى: "تْبشَّارغ زَّاث إِ يِوْذَان، سْڒْمَاذغ-ثن ڒبْدَا ذِي ثمْزِيذَاوِين ؤُڒَا ذِي ثمْزِيذَا ثَمقّْرَانْت مَانِي تْمُوْنن يسْرَائِيلِيْين مَارَّا. وَار سِّيوِيڒغ وَالُو س ثنُوْفْرَا. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />نش، مَايمّي ذَايِي تْسقْسِيذ؟ سّقْسَا يِنِّي ذَايِي يسْڒِين مِين ذَاسن نِّيغ. نِثْنِي سّْنن مِين نِّيغ."<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />ينَّا-ٱس عِيْسَى مَانَايَا ڒخْدّنِّي يجّن زݣ يعسَّاسن يبدّن ذِنِّي يُوْشَا-ٱس يجّن ن وسقِّيڒ إِ عِيْسَى ينَّا-ٱس: "مَا س وَاوَاڒ-أَ إِي زِي غَا ثَارّذ خ اَرَّايس ن ڒْفُقَهَا؟"<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />ينَّا-ٱس عِيْسَى: "مڒَا خْضِيغ ذݣ وَاوَاڒ، إِن-اَيِي مِينْذِي خْضِيغ. مڒَا سِّيوْڒغ نِيشَان، مَايمّي ذَايي ثُوْوْثِيذ؟" <verse eid="JHN 18:23" /><verse number="24" style="v" sid="JHN 18:24" />سّنِّي يسّكّ-يث حَنِّين ذ اَمحْبُوْس غَار قِيَافَا اَرَّايس ن ڒْفُقَهَا.<verse eid="JHN 18:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />بُطْرُس يبدّ ذِنِّي يزْغَار غَار ثْمسِّي. نَّان-اَس: "مَا وَار ثدْجِيذ ؤُڒَا ذ شك زݣ يمحْضَارن نّس؟"</para>
  <para style="p" vid="JHN 18:25">نتَّا ينْكَر ينَّا-ٱسن: "نش، لَّا!"<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />ڒخْدّنِّي يجّن زݣ يخدَّامن ن اَرَّايس ن ڒْفُقَهَا، نتَّا يتعْنَا-د إِ ونِّي ؤُمِي يقسّ بُطْرُس اَمجُّوْن، ئِرُوْح ينَّا-ٱس إِ بُطْرُس: "مَا وَار ثدْجِيذ ذ شك إِي ࢲْرِيغ اَكِذس ذِي جَرْدَا نِّي؟"<verse eid="JHN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27" />بُطْرُس ينْكَر عَاوذ، ڒخْدّنِّي يدّن ويَازِيض.<verse eid="JHN 18:27" /></para>
  <para style="s">ئِسْرَائِيلِيْين تْهَامن سِيذِيثْنغ عِيْسَى غَار يرُوْمَانِيْين</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />ؤُوِين عِيْسَى زِي <char style="it">ثدَّارْث ن</char> قِيَافَا غَار ڒقْصَر ن لْحَاكم، تُوْغَا زِيش. ئِسْرَائِيلِيْين وَار ؤُذِيفن شَا غَار ڒقْصَر حمَا وَار سْحرِّيم شَا ڒْعِيذ خ يِيخف نْسن.<note caller="+" style="f"><char style="fr" closed="false">18‏.28 </char><char style="ft" closed="false">شَّرِيعَا ن مُوْسَى تْحرّم إِ أَيث-إِسْرَائِيل اَذ اَذْفن اَمْشَان ن لْكُفَّر ذِي ڒْعِيذ اَمقّْرَان.</char></note> <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />ئِفّغ-د غَارْسن لْحَاكم ذ اَرُوْمَانِي قَّارن-اَس بِيلَاطُوْس، ينَّا-ٱسن: "مَان تُّهْمث إِي غَارْوم خ بْنَاذم-أَ؟"<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />نَّان-اَس: "مَعْلِيك وَار يدْجِي ذ لْمُجْرِيم، أَتَاف وَار ذَاش ثِيذ نْتِيوِي شَا ذَا."<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />ينَّا-ٱسن بِيلَاطُوْس: "إِيوَا اَوِيم-ث كنِّيو، أَخَاس ثْحكْمم س شَّرِيعَا نْوم."</para>
  <para style="p" vid="JHN 18:31">نَّان-اَس يسْرَائِيلِيْين: "وَار ذَانغ ثْسمّْحم شَا كنِّيو أَ نْنغ ؤُڒَا ذ يجّن." <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />يوْقع مَانَايَا حمَا اَذ يكمّڒ وَاوَاڒ إِي ينَّا عِيْسَى خ ڒْموْث إِي غَا يمّث.<verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />سّنِّي يُوْذف-د عَاوذ بِيلَاطُوْس غَار ڒقْصَر، ئِڒَاغَا خ عِيْسَى ينَّا-ٱس: "مَا ذ شك ذ اَزدْجِيذ ن أَيث-إِسْرَائِيل؟"<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />ينَّا-ٱس عِيْسَى: "مَانَايَا، مَا ثقَّارذ-ت زِي غَارك نِغ نَّان-اَش-ث خَافِي ينّغْنِي؟"<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />ينَّا-ٱس بِيلَاطُوْس: "مَا نش ذ اَئِسْرَائِيلِي؟ لْأُمَّا نّش ذ اَرُّوْيَاس ن ڒْفُقَهَا إِي ش د يُوْوِين غَارِي، مِين ثݣِّيذ؟"<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />ينَّا-ٱس عِيْسَى: "ڒْمُلْك ينُو مَاشِي زِي دُّنشْت-أَ. مَعْلِيك ڒْمُلْك ينُو زِي دُّنشْت-أَ، أَتَاف يمحْضَارن ينُو حَرْبن حمَا وَار وطِّيغ شَا ذݣ يفَاسّن ن يسْرَائِيلِيْين؛ لَّا، ڒْمُلْك ينُو وَار يدْجِي شَا سَّانِيتَا."<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />ينَّا-ٱس بِيلَاطُوْس: "زَعْمَا، شك ذ اَزدْجِيذ؟"</para>
  <para style="p" vid="JHN 18:37">ينَّا-ٱس عِيْسَى: "ثنِّيذ شك نش ذ اَزدْجِيذ. نش خڒْقغ-د ؤُسِيغ-د غَار دُّنشْت-أَ حمَا اَذ شهْذغ إِ لْحَقِيقَا. مَارَّا ونِّي يدْجَان زِي لْحَقِيقَا اَذ يذْفَار اَوَاڒ ينُو."<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />ينَّا-ٱس بِيلَاطُوْس: "إِيوَا مِين ثعْنَا لْحَقِيقَا-يَا؟" وَامِي ينَّا اَمُّو، ئِفّغ عَاوذ غَار يسْرَائِيلِيْين ينَّا-ٱسن: "وَار ذَايس ؤُفِيغ بُو تُّهْمث. <verse eid="JHN 18:38" /><verse number="39" style="v" sid="JHN 18:39" />وَلَكِن ثْنُوْمم ضدْجْقغ-اَوم-د إِ يِجّن ن ومحْبُوْس ذِي ڒْعِيذ اَمقّْرَان. ڒخُّو، مَا ثخْسم اَذَاوم د ضڒْقغ إِ وزدْجِيذ ن أَيث-إِسْرَائِيل؟"<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />عيّْضن س جّْهذ نَّان: "وَار د ضدْجق شَا إِ وَانِيتَا، ضْڒق-اَنغ-د إِ بَرَابَاس!" تُوْغَا بَرَابَاس ذ اَقطَّاع يبْرِيذن.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="s">ئِسْرَائِيلِيْين رزُّوْن اَذ صلّْبن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />يُوْوِي بِيلَاطُوْس عِيْسَى حمَا اَث ؤُوْثن ڒْعَسْكَار س وسْغُوْن. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />مُوْذن-اَس يجّن ن تَّاج ن يسنَّانن ݣِّين-اَس-ث خ وزدْجِيف نّس. ݣِّين خَاس اَسڒْهَام ذ اَزݣّوَاغ.<note caller="+" style="f"><char style="fr" closed="false">19‏.2 </char><char style="ft" closed="false">ذَانِيتَا أُو عَاوذ ذِي لْأَيَا 5 نْزمَّر أَ نِينِي اَزݣّوَاغ نِغ ݣْرُوْنَا.</char></note> <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />تْقرَّابن غَارس شَّاثن-ث س يسقِّيڒن، قَّارن-اَس سَّلَام آي اَزدْجِيذ ن أَيث-إِسْرَائِيل. <verse eid="JHN 19:3" /><verse number="4" style="v" sid="JHN 19:4" />ئِفّغ-د عَاوذ بِيلَاطُوْس ينَّا-ٱسن: "خْزَرث، أَذَاوم ثِيذ سُوفْغغ حمَا اَذ تسّْنم بلِّي نش وَار ذَايس ؤُفِيغ بُو شَان تُّهْمث." <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />سّنِّي يفّغ عِيْسَى غَار بَارَّا س تَّاج نِّي ن يسنَّانن ذ وسڒْهَام نِّي اَزݣّوَاغ. ينَّا-ٱسن بِيلَاطُوْس: "هَاقَا بْنَاذم نِّي."<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />وَامِي ث ࢲْرِين اَرُّوْيَاس ن ڒْفُقَهَا ذ يعسَّاسن، تْعيَّاضن س جّْهذ قَّارن-اَس: "صلّب-يث! صلّب-يث!"</para>
  <para style="p" vid="JHN 19:6">ينَّا-ٱسن بِيلَاطُوْس: "إِيْسِيم-ث كنِّيو صلّْبم-ث، نش وَار ذَايس ؤُفِيغ بُو شَان تُّهْمث."<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />أَرِّين خَاس يسْرَائِيلِيْين نَّان-اَس: "غَارْنغ يجّن ن ڒْقَانُوْن. عْلَاحْسَاب ڒْقَانُوْن نِّي يتْخصَّا اَذ يمّث مِينْزِي نتَّا يتَارَّا يخف نّس ذ مِّيس ن أَربِّـي."<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />وَامِي يسْڒَا بِيلَاطُوْس اَوَاڒ-أَ يݣّْوذ كْتَار. <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />يُوْذف عَاوذ غَار ڒقْصَر نّس ينَّا-ٱس إِ عِيْسَى: "مَانِيس شك؟" عِيْسَى وَار خَاس يَارِّي شَا.<verse eid="JHN 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 19:10" />ينَّا-ٱس بِيلَاطُوْس: "مَا وَار كِذِي ثسِّيوِيڒذ شَا؟ مَا وَار ثسِّينذ بلِّي غَارِي جّْهذ اَذَاش ضڒْقغ نِغ اَش صلّْبغ؟"<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />ئِنْدق-د عِيْسَى ينَّا-ٱس: "وَار غَارك بُو جّْهذ خَافِي إِلَّا مڒَا يمُّوْش-اَش زِي أَربِّـي. عْلَاحْسَاب مَانَايَا، ونِّي إِي ذَايِي د يُوْوِين غَارش، غَارس دّْنُوْب كْتَار زَّايك."<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />سّنِّي يرزُّو بِيلَاطُوْس اَذَاس يضْڒق. وَلَكِن يسْرَائِيلِيْين تْعيَّاضن س جّْهذ قَّارن: "مڒَا ثْضڒْقذ إِ ورْيَاز-أَ اَتَاف وَار ثدْجِيذ شَا ذ اَمدُّوْكڒ ن قَيْصَر.<note caller="+" style="f"><char style="fr" closed="false">19‏.12 </char><char style="ft" closed="false">قَيْصَر نتَّا ذ اَزدْجِيذ ن يرُوْمَانِيْين. ذ نِثْنِي إِي يحكّْمن خ أَيث-إِسْرَائِيل ذِي ڒْوقْث نِّي.</char></note> مَارَّا ونِّي يتَارَّان يخف نّس ذ اَزدْجِيذ نتَّا ضد إِ قَيْصَر."<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />وَامِي يسْڒَا بِيلَاطُوْس اَوَاڒ-أَ يسُوْفغ عِيْسَى، ئِقِّيم بِيلَاطُوْس خ ڒْكُرْسِي ن ڒحْكَام ذݣ يِجّن ن ومْشَان قَّارن-اَس &lt;سَّحَا ن وزْرُو.&gt; س وَاوَاڒ ن يسْرَائِيلِيْين قّارن-اَس &lt;ݣَبَّاطَا.&gt; <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />نْهَار نِّي ذ جّمْعَا غَار جْوَايه ن ثنْعَاش، سوْجَاذن إِ ڒْعِيذ اَمقّْرَان. ينَّا-ٱسن بِيلَاطُوْس إِ يسْرَائِيلِيْين: "هَاقَاوم اَزدْجِيذ نْوم."<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />وَلَكِن تْعيَّاضن س جّْهذ قَّارن: "إِيْسِي-ث إِيْسِي-ث، صلّب-يث!"</para>
  <para style="p" vid="JHN 19:15">ينَّا-ٱسن بِيلَاطُوْس: "مَا ٱذ صلّْبغ اَزدْجِيذ نْوم؟"</para>
  <para style="p" vid="JHN 19:15">أَرِّين خَاس اَرُّوْيَاس ن ڒْفُقَهَا نَّان-اَس: "وَار غَارْنغ بُو وزدْجِيذ إِلَّا قَيْصَر!"<verse eid="JHN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />سّنِّي يسلّم-اَسن-ث حمَا اَث صلْبن خ صَّلِيب، يْسِين عِيْسَى.<verse eid="JHN 19:16" /></para>
  <para style="s">ئِرُوْمَانِيْين تْصلَّابن سِيذِيثْنغ عِيْسَى خ صَّلِيب</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />ئِفّغ عِيْسَى يَارْبُو صَّلِيب س يِيخف نّس يرُوْح غَار يِجّن ن ومْشَان قَّارن-اَس &lt;أَمْشَان ن جُمْجُمَا.&gt; س وَاوَاڒ ن يسْرَائِيلِيْين قّارن-اَس &lt;ݣُوْلْݣُوْطَا.&gt; <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />مَانِي ث صلّْبن، صلّْبن اَكِذس ثْنَاين نّغْنِي، سَّا ذ سَّا، عِيْسَى ذِي ڒْوسْط. <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />يُوْرَا بِيلَاطُوْس ذݣ يجّن ن ثڒْوِيحت، يݣِّي-ت غَار وزدْجِيف ن عِيْسَى خ صَّلِيب ثُوْرَا ذَايس: &lt;عِيْسَى زِي نَاصِرَا، أَزدْجِيذ ن أَيث-إِسْرَائِيل.&gt; <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />ثَڒْوِيحت نِّي غْرِين-ت اَطَّاس ن يسْرَائِيلِيْين مِينْزِي اَمْشَان مَانِي إِي صلّْبن عِيْسَى يُوْذس ثَنْدِينْت. ثَڒْوِيحت نِّي تُوْغَا ثُوْرَا س لْعِبْرِيَا ذ لَاتِينِيَا ذ ثْيُوْنَانِيث.<verse eid="JHN 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 19:21" />نَّان-اَس اَرُّوْيَاس ن ڒْفُقَهَا ن يسْرَائِيلِيْين إِ بِيلَاطُوْس: "وَار تَارِي شَا، &lt;أَزدْجِيذ ن أَيث-إِسْرَائِيل.&gt; أَرِي: &lt;أَرْيَاز-أَ ينَّا نش ذ اَزدْجِيذ ن أَيث-إِسْرَائِيل.&gt;"<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />ينَّا-ٱسن بِيلَاطُوْس: "نش مِين ؤُرِيغ، قَا ؤُرِيغ-ث."<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />وَامِي ڒْعَسْكَار صلّْبن عِيْسَى، يْسِين اَرُّوْض نّس بْضَان-ث خ اَرْبعَا ن ثْسقَّار كُڒ اَعسْكْرِي ييْسِي ثَسْغَارْث نّس. يْسِين عَاوذ تْشَامِّير، تْشَامِّير نِّي يصْنع-يث وذرَّاز.<note caller="+" style="f"><char style="fr" closed="false">19‏.23 </char><char style="ft" closed="false">أَذرَّاز ونِّي يزدْجْݣن ثَضُوْفْث يخدّم زَّايس.</char></note> <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />نَّان إِ وَايَاوْيَا، وَار ث نتْشَارِّيݣ شَا، أَخَاس نݣّ لْقُرْعَا بَاش أَ نسّن وِي ث غَا ييْسِين. أَمُّو يكمّڒ وَاوَاڒ ن لْكِتَاب:</para>
  <para style="b" vid="JHN 19:24" />
  <para style="q1" vid="JHN 19:24">&lt;بْضَان اَرُّوْض ينُو جَارَاسن،</para>
  <para style="q2" vid="JHN 19:24">ݣِّين لْقُرْعَا خ ڒغْضَا ينُو.&gt;</para>
  <para style="p" vid="JHN 19:24">أُو ذ مَانَايَا إِي ݣّين ڒْعَسْكَار.<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />زَّاث إِ صَّلِيب ن عِيْسَى ثْبدّ يمَّاس ذ خَاتْشس ذ مَرْيَم ثَمْغَارْث ن كْرِيفَاس ذ مَرْيَم ثَمَݣْدَالِيث. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />وَامِي يࢲْرَا عِيْسَى يمّاس يبدّ اَكِذس ومحْضَار نِّي إِي خَاس يعِيزّن <char style="it">اَطَّاس</char>، ينَّا-ٱس: "آ يمَّا، أَقَاث ذِين مِّيم!" <verse eid="JHN 19:26" /><verse number="27" style="v" sid="JHN 19:27" />ينَّا-ٱس عَاوذ إِ ومحْضَار نِّي: "أَقَات ذِين يمَّاش!" سّنِّي يُوْوِي-ت ومحْضَار نِّي غَار ثدَّارْث نّس.<verse eid="JHN 19:27" /></para>
  <para style="s">ڒْموْث ن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />منْبَعْد إِ مَانَايَا يسّن عِيْسَى بلِّي كُڒْشِي يكْمّڒ، ينَّا: "أَقَايِي فُّوْذغ." س وَاوَاڒ نِّي يفّغ مِين د يُوْسِين ذِي لْكِتَاب.<note caller="+" style="f"><char style="fr" closed="false">19‏.28 </char><char style="ft" closed="false">خْزَر لْكِتَاب ن زَّبُوْر، ئِزْڒِي وِيس 69، لْأَيَا 22. </char></note> <verse eid="JHN 19:28" /><verse number="29" style="v" sid="JHN 19:29" />ذِنِّي يجّن ن وغرَّاف يشُّوْر س وَامَان وضِيڒ ذ يسمَّامن. سْغضْصن سْپُونْخَا ذݣ وَامَان وضِيڒ نِّي، ݣّين-ت خ وكشُّوْض<note caller="+" style="f"><char style="fr" closed="false">19‏.29 </char><char style="ft" closed="false">أَكشُّوْض-أَ يُوْسَا-د زݣ يِجّن ن اَرْبِيع يݣَّا اَم ؤُزُوْي.</char></note> ؤُشِين-اَس-ت غَار وقمُّوْم نّس. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />وَامِي يقَّاس عِيْسَى اَمَان نِّي، ينَّا: "ئِتْوَاكمّڒ!" ئِسَذَار اَزدْجِيف نّس، ئِسلّم بُوْحْبڒ نّس.<verse eid="JHN 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />يوْقع مَانَاينِّي إِضنَّاظ ن ڒْعِيذ اَمقّْرَان. خ مَانَايَا يسْرَائِيلِيْين تَّارن-اَس إِ بِيلَاطُوْس اَذَاسن رْزن يضَارن إِ يِنِّي يتْوَاصلّْبن اَذ د سهْوَان دَّات نْسن زِي صَّلِيب. ݣِّين-اَسن اَمنِّي حمَا وَار تْغِيمِي دَّات نْسن خ صَّلِيب ذِي نْهَار ن سّبْث ن لْعِبَادَا مِينْزِي نْهَار ن سّبث نِّي ذ اَمقّْرَان اَطَّاس. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />ؤُسِين-د ڒْعَسْكَار رْزِين يضَارن إِ ومزْوَارُو ذ وِيس ثْنَاين إِي كِذس يتْوَاصلّْبن. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />وَامِي رُوْحن غَار عِيْسَى، وَار ذَاس رْزِين بُو يضَارن مِينْزِي ؤُفِين-ث يمُّوْث. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />وَلَكِن يجّن زِي ڒْعَسْكَار نِّي يشُوْكّ-يث غَار وغزْذِيس نّس س يِجّن ن وكشُّوْض ذَايس ثِيشّط ن وُوْزّڒ، ؤُزّْڒن-د زَّايس ذغْيَا يذَامّن ذ وَامَان اَطَّاس. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />ونِّي يࢲْرِين مَانَاينِّي يشْهذ خَاس، أُو مِين يشْهذ نِيشَان إِي يدْجَا. ئِسّن بلِّي مِين يقَّار ذ لْحَقِيقَا أُو يشهّذ بَاش اَزَّايس ثَامْنم ؤُڒَا ذ كنِّيو. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />يوْقع مَانَايَا حمَا اَذ يكمّڒ مِين د يُوْسِين ذِي لْكِتَاب: &lt;وَار زَّايس يتْرزِّي ؤُڒَا ذ يجّن ن يِيغس.&gt; <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />ثُوْسَا-د ذݣ يِجّن ن لْأَيَا نّغْنِي: &lt;أَذ خْزَرن غَار ونِّي يتْوَاشُوْكّن.&gt;<verse eid="JHN 19:37" /></para>
  <para style="s">يُوْسف ذ نِيْكُوْدِيْم نطّْڒن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />منْبَعْد إِ مَانَايَا، يجّن قَّارن-اَس يُوْسف زِي ثنْدِينْت ن أَرِيمَاتْيَا يرُوْح يتَّار-اَس إِ بِيلَاطُوْس اَذ ييْسِي دَّات ن عِيْسَى. نتَّا يُوْسف ذ اَمحْضَار ن عِيْسَى وَلَكِن وَار د يسْبيّن شَا يخف نّس يݣّْوذ زݣ يسْرَائِيلِيْين. وَامِي يقْبڒ بِيلَاطُوْس، يرُوْح يُوْسف ييْسِي دَّات ن عِيْسَى. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />يُوْسَا-د ڒَا ذ نِيْكُوْدِيْم، أَرْيَاز نِّي تُوْغَا إِݣ يݣِّين زِّيَارَا يجّن ن ثْوَاڒَا س دْجِيڒث غَار عِيْسَى. ڒخُّو يُوْوِي-د اَكِذس شَان تخْلِيطَا ذَايس أَرْبعَا و ثْڒَاثِين كِيلُو ن مُوْرّْ<note caller="+" style="f"><char style="fr" closed="false">19‏.39 </char><char style="ft" closed="false">مُوْرّْ نتَّا ذ اَمَان ن يِجّن ن ثْشجَّارْث ذَايْسن ڒفْوَاح.</char></note> ذ وكشُّوْض ن لْعُوْد<note caller="+" style="f"><char style="fr" closed="false">19‏.39 </char><char style="ft" closed="false">لْعُوْد نتَّا ذ يجّن ن ثْشجَّارْث، أَكشُّوْض نّس ذَايس ڒفْوَاح اَطَّاس.</char></note> تݣّن-ت يسْرَائِيلِيْين إ يِنِّي يمُّوْثن. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />سّنِّي يْسِين دَّات ن عِيْسَى كفّْنن-ت س ڒشْفن ذ لْعِيطَر نِّي، مَامّش تݣّن يسْرَائِيلِيْين إِ يِنِّي يمُّوْثن. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />ذݣ ومْشَان نِّي مَانِي صلّْبن عِيْسَى ذِنِّي يجّن ن جَرْدَا. ذِي جَرْدَا نِّي ذَايس يجّن ن ونْضڒ ذ جْذِيذ يݣَّا اَم يِيفْرِي، وَار ذَايس ينْضِيڒ حَدّ. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />نْهَار نِّي تُوْغَا ذ جّمْعَا، ئِسْرَائِيلِيْين سوْجَاذن إِ نْهَار ن سّبْث ن لْعِبَادَا. خ مَانَاينِّي نضْڒن عِيْسَى ذݣ يِيفْرِي نِّي ن ونْضڒ مِينْزِي يُوْذس.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">ئِمحْضَارن وَار تِيفن شَا سِيذِيثْنغ عِيْسَى ذݣ ونْضڒ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />ذِي نْهَار اَمزْوَارُو ن سِّيمَانَا، ثُوْسَا-د مَرْيَم ثَمَݣْدَالِيث<note caller="+" style="f"><char style="fr" closed="false">20‏.1 </char><char style="ft" closed="false">مَرْيَم ثَمَݣْدَالِيث نتَّاث زݣ وبِيلَاج نِّي ؤُمِي قَّارن مَݣْدَلَا.</char></note> غَار يِيفْرِي ن ونْضڒ ن عِيْسَى زِيش. تُوْغَا عَاذ ثَادْجسْت، ثُوْفَا اَزْرُو يتْوَاكّس خ يِيفْرِي ن ونْضڒ. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />ثُوْزّڒ-د ثُوْسَا-د غَار سِمْعَان بُطْرُس ذ ومحْضَار نّغْنِي ونِّي يعِيزّن خ عِيْسَى <char style="it">اَطَّاس</char>، ثنَّا-ٱسن قَا يْسِين عِيْسَى زݣ يِيفْرِي ن ونْضڒ، وَار نسِّين مَانِي ث ݣّين.<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3‏-4" style="v" sid="JHN 20:3-4" />ئِفّغ بُطْرُس ذ ومحْضَار نِّي نّغْنِي رُوْحن س ثَازّْڒَا س ثْنَاين إِذْسن غَار يِيفْرِي ن ونْضڒ. أَمحْضَار نِّي يزْوَار-اَس إِ بُطْرُس يُوْوض ذ اَمزْوَارُو غَار يِيفْرِي ن ونْضڒ. <verse eid="JHN 20:3-4" /><verse number="5" style="v" sid="JHN 20:5" />ئِسِيجّ <char style="it">خ يِيفْرِي</char> يُوْفَا ڒشْفن يمَارْس ذِنِّي وَلَكِن وَار يُوْذِيف شَا. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />ئِذفَّار-يث-يذ سِمْعَان بُطْرُس ئِخْضڒ، يُوْذف ذݣ يِيفْرِي ن ونْضڒ. ئِتْوَاڒَا ڒشْفن نِّي <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />يُوْفَا ڒْقَبّ إِي زِي تُوْغَا يغطَّا وزدْجِيف ن عِيْسَى وَار يدْجِي شَا اَݣ ڒشْفن، ئِضْفس وَاحْذس. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />ڒخْدّنِّي يُوْذف ومحْضَار نِّي يزْوَارن غَار يِيفْرِي ن ونْضڒ، يࢲْرَا مَانَاينِّي يُوْمن. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />وَلَكِن نِثْنِي عَاذ وَار فْهِيمن شَا زِي لْكِتَاب بلِّي لَابُد اَذ يكَّر عِيْسَى زِي ڒْموْث. <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />سّنِّي روّْحن يمحْضَارن.<verse eid="JHN 20:10" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتْمظْهَار-د إِ مَرْيَم ثَمَݣْدَالِيث</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />مَرْيَم ثْبدّ غَار ثوَّارْث ن يِيفْرِي ن ونْضڒ ثقِّيم ثتْرُو. وَامِي ثتْرُو ثْسِيجّ خ يِيفْرِي ن ونْضڒ <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />ثُوْفَا ثْنَاين ن لمَالَائِكَاث س وَارُّوْض ذ اَشمْڒَاڒ يشْتن ثقِّيم غَار وزدْجِيف يشْتن ثقِّيم غَار يضَارن مَانِي تُوْغَا ثدْجَا دَّات ن عِيْسَى.<verse eid="JHN 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 20:13" />نَّانْت-اَس: "آ ثَمْغَارْث مِين شم يُوْغِين ثتْرُوذ؟"</para>
  <para style="p" vid="JHN 20:13">ثنَّا-ٱسنْت: "يْسِين سِيذِي، وَار سِّينغ مَانِي ث سرْسن." <verse eid="JHN 20:13" /><verse number="14" style="v" sid="JHN 20:14" />ثنَّا مَانَاينِّي ثخْزَر غَار ذفَّار ثُوْفَا ذِنِّي عِيْسَى، وَلَكِن نتَّاث وَار ثسِّين شَا نتَّا ذ عِيْسَى.<verse eid="JHN 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 20:15" />ينَّا-ٱس عِيْسَى إِ مَرْيَم: "آ ثَمْغَارْث مِين شم يُوْغِين ثتْرُوْذ، مِيخف ثْرزُّوْذ؟"</para>
  <para style="p" vid="JHN 20:15">مَرْيَم تْغِير-اَس ذ بَاب ن جَرْدَا نِّي، ثنَّا-ٱس: "آ سِيذِي مڒَا ذ شك إِي ث ييْسِين، إِن-اَيِي مَانِي ث ثْسرْسذ حمَا اَث يْسِيغ."<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />ينَّا-ٱس عِيْسَى: "آ مَرْيَم!"</para>
  <para style="p" vid="JHN 20:16">ڒخْدّنِّي ثعْقڒ-يث ثنَّا-ٱس س وَاوَاڒ ن يسْرَائِيلِيْين: "آ رَابُنِي!" (زَعْمَا &lt;آ لْمُعَلِّم.&gt;)<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />ينَّا-ٱس عِيْسَى: "وَار ذَايِي تطّف شَا،<note caller="+" style="f"><char style="fr" closed="false">20‏.17 </char><char style="ft" closed="false">إِمْكن تُوْغَا تطّف-يث زݣ يضَارن نّس. خْزَر مَتَّى 28‏:9.</char></note> قَا نش عَاذ وَار ݣَعّْذغ شَا غَار بَابَا. رُوْح غَار اَيثْمَا ينُو، إِن-اَسن قَا نش اَذ ݣَعّْذغ غَار بَابَا ذ بَابَاثْوم، غَار أَربِّـي ينُو ذ أَربِّـي نْوم."<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />ثْرُوْح مَرْيَم ثَمَݣْدَالِيث ثسِّيوض-ٱسن ڒخْبَار إِ يمحْضَارن ثنَّا-ٱسن قَا ࢲْرِيغ سِيذِيثْنغ يسِّيوڒ-د اَكِذِي اَقَا مِين ذَايِي ينَّا...<verse eid="JHN 20:18" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتْمظْهَار-د ثْڒَاثَا ن ثْوَاڒَاثِين إِ يمحْضَارن نّس</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />نْهَار ن ڒْحَد مُوْنن يمحْضَارن غَار ثْمدِّيث، ثِوُّوْرَا قّْننْت ݣّْوْذن زݣ يسْرَائِيلِيْين. يُوْسَا-د عِيْسَى يبدّ ذِي ڒْوسْط ينَّا-ٱسن: "سْڒَام خَاوم." <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />ينَّا-ٱسن مَانَايَا، يسْبيّن-اَسن-د يفَاسّن نّس ذ وغزْذِيس نّس. فَرْحن يمحْضَارن وَامِي ࢲْرِين سِيذِيثْسن. <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />ينَّا-ٱسن عَاوذ عِيْسَى: "سْڒَام خَاوم. مَامّش ذَايِي د يسّكّ بَابَا، أَمُّو نش اَكنِّيو سّكّغ." <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />وَامِي ينَّا مَانَايَا يصُوْض خَاسن ينَّا-ٱسن: "قبْڒث اَرُّوْح يقدّْسن. <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />ونِّي ؤُمِي ثْسَمْحم إِ دّْنُوْب نّس، أَذَاس تْوَاسَمْحنْت. ونِّي ؤُمِي وَار ثسْمِيحم شَا، وَار ذَاس تْوَاسْمِيحنْت شَا."<verse eid="JHN 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />وَلَكِن يجّن زِي ثنْعَاش ن يمحْضَارن نّس ؤُمي قَّارن تُوْمَا تْڒَاغَان-اَس أَشْنِيو،<note caller="+" style="f"><char style="fr" closed="false">20‏.24 </char><char style="ft" closed="false">أَشْنِيو نتَّا ذ اَڬْنِيو.</char></note> وَار كِسن يدْجِي شَا وَامِي د يُوْسَا عِيْسَى. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />نَّان-اَس يمحْضَارن نِّي نّغْنِي قَا نࢲْرَا سِيذِيثْنغ!</para>
  <para style="p" vid="JHN 20:25">ئِكَّر تُوْمَا ينَّا-ٱسن: "مڒَا وَار ࢲْرِيغ شَا لْأَثَر ن يمسْمِيڒن ذݣ يفَاسّن نّس اَذ ݣّغ ضَاض ينُو ذݣ ومْشَان ن يمسْمِيڒن نِّي، أَذ سرْسغ فُوْس ينُو خ وغزْذِيس نّس، وَار تِيمْنغ شَا."<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />منْبَعْد إِ ثْمنيَّام، مُوْنن يمحْضَارن عَاوذ غَار ذَاخڒ، ثِوُّوْرَا قّْننْت اَكِذْسن تُوْمَا. يُوْسَا-د عِيْسَى يبدّ ذِي ڒْوسْط نْسن ينَّا-ٱسن: "سْڒَام خَاوم!" <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />ينَّا-ٱس إِ تُوْمَا: "ٱݣّ ضَاض نّش ذَانِيتَا، خْزَر يفَاسّن ينُو. سرْس فُوْس نّش خ وغزْذِيس ينُو. وَار تْشكَّا شَا؛ لَّا، أَمن."<verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />ينْدق-د تُوْمَا ينَّا-ٱس: "آ سِيذِي ينُو، آي أَربِّـي ينُو!"<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />ينَّا-ٱس عِيْسَى: "أَڒ وَامِي ذَايِي ثࢲْرِيذ، عَاذ إِي ثُوْمْنذ؟ سَّعْذ ن يِنِّي وَار ذَايِي ࢲْرِين شَا، ؤُمْنن."<verse eid="JHN 20:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />يݣّا عِيْسَى اَطَّاس ن لْمُعْجِيزَاث نّغْنِي زَّاث إِ يمحْضَارن نّس، نِثنْتِي وَار ؤُرِينْت شَا ذِي لْكِتَاب-أَ. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />ثِمسْڒَايِين-أَ ؤُرِينْت حمَا اَذ تَامْنم بلِّي عِيْسَى نتَّا ذ لْمَسِيح مِّيس ن أَربِّـي بَاش مڒَا ثُوْمْنم اَغَارْوم ثِيڒِي ثُوْذَارْث ذݣ يِيسم نّس.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />منْبَعْد إِ مَانَايَا يمظْهَار-د عِيْسَى عَاوذ إِ يمحْضَارن نّس خ شّطّ ن ڒبْحَر ن طَبَرْيَا. أَمُّو إِي يوْقع. <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />مُوْنن ذِنِّي ڒبْعَاض ن يمحْضَارن نّس: سِمْعَان بُطْرُس ذ تُوْمَا ونِّي ؤُمِي قَّارن &lt;أَشْنِيو&gt;،<note caller="+" style="f"><char style="fr" closed="false">21‏.2 </char><char style="ft" closed="false">أَشْنِيو نتَّا ذ اَڬْنِيو.</char></note> ذ نَاثْنَاهِيل نتَّا زݣ وبِيلَاج ن قَانَا ذِي ثْمُوْرْث ن لْجَالِيل، ذ ثَارْوَا ن زَبَادِي، ذ ثْنَاين نّغْنِي. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />ئِكَّر سِمْعَان بُطْرُس ينَّا-ٱسن نش اَذ رَاحغ اَذ يْمَارغ.</para>
  <para style="p" vid="JHN 21:3">نَّان-اَس اَكِش نْرَاح ؤُڒَا ذ نشِّين. فّْغن، نْيِين ذِي ثْغَارَّابُوت. ذِي دْجِيڒث نِّي وَار يْمَارن وَالُو.<verse eid="JHN 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 21:4" />وَامِي يصْبَح ڒْحَاڒ، ؤُفِين عِيْسَى يبدّ خ شّطّ ن ڒبْحَر وَلَكِن يمحْضَارن وَار ث عْقِيڒن شَا. <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />ينَّا-ٱسن: "آي يحنْجِيرن، مَا ثيْمَارم شَان يسڒْمَان؟"</para>
  <para style="p" vid="JHN 21:5">نَّان-اَس: "لَّا، وَالُو."<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />ينَّا-ٱسن عِيْسَى: "سيّْبث ثْرَاشَّا خ وفُوْسِي ن ثْغَارَّابُوت اَذ تَافم يسڒْمَان." وَامِي ت سيّْبن وَار زمَّرن اَتِيد جبْذن عْلَاحقَّاش ثْعمَّر س يسڒْمَان اَطَّاس.<verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />أَمحْضَار نِّي يعِيزّن خ عِيْسَى <char style="it">اَطَّاس</char> ينَّا-ٱس إِ بُطْرُس قَا وِين ذ سِيذِيثْنغ. وَامِي يسْڒَا سِمْعَان بُطْرُس قَا وِين ذ عِيْسَى، ئِكَّر يَرض تْشَامِّير نّس ڒَاحقَّاش تُوْغَا يكّس-يث، ڒخْدّنِّي ينْضو ذِي ڒبْحَر <char style="it">بَاش اَذ يرَاح غَار عِيْسَى</char>. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />وَلَكِن يمحْضَارن نِّي نّغْنِي إِي كِذس يدْجَان ذْفَارن-ث-يذ س ثْغَرَّابُوْت، جبّْذن-د ثْرَاشَّا نِّي ثشُّوْر س يسڒْمَان. وَار ݣّْوِيجن شَا خ ڒْبَرّ غِير شَان مِيَّات مِيتْرُو وَاهَا. <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />وَامِي د ؤُوْضن غَار ڒْبَرّ، ؤُفِين ثِمسِّي ن ڒفْحَم خَاس يسڒْمَان ذ وغْرُوْم.<verse eid="JHN 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 21:10" />ينَّا-ٱسن عِيْسَى: "أَوِيم-د شْوَايْت ن يسڒْمَان إِي د ثيْمَارم ڒخُّو." <verse eid="JHN 21:10" /><verse number="11" style="v" sid="JHN 21:11" />ئِنْيَا سِمْعَان بُطْرُس يجْبذ-د ثْرَاشَّا نِّي غَار ڒْبَرّ، ذَايس مِيَّا و ثْڒَاثَا و خمْسِين ن يسڒْمَان ذ يمقّْرَانن. قَاع مَانَايَا، وَار ثقَّارس شَا ثْرَاشَّا نِّي.<verse eid="JHN 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 21:12" />ينَّا-ٱسن عِيْسَى: "أَرَاحم-د اَذ تشّم." وَار يزْعِيم ؤُڒَا ذ يجّن زݣ يمحْضَارن اَث يسّقْسَا، مِين ثعْنِيذ شك؟ ڒَاحقَّاش سّْنن قَا ذ سِيذِيثْسن. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />يرُوْح عِيْسَى ييْسِي-د اَغْرُوْم نِّي ذ يسڒْمَان نِّي يفرق-يثن خَاسن. <verse eid="JHN 21:13" /><verse number="14" style="v" sid="JHN 21:14" />ثَانِيتَا ذ وِيس ثڒْت مَرَّاث إِي ذِي يتْمظْهَار-د عِيْسَى إِ يمحْضَارن نّس زݣ وَامِي إِي د يكَّر زِي ڒْموْث.<verse eid="JHN 21:14" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسزْعَام سِمْعَان بُطْرُس</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />وَامِي ريّْقن، ينَّا-ٱس عِيْسَى إِ سِمْعَان بُطْرُس: "آ سِمْعَان آ مِّيس ن يُوْحَنَّا، مَا تْحِبِّيذ-اَيِي كْتَار زِي يِيْنَا؟"</para>
  <para style="p" vid="JHN 21:15">ينَّا-ٱس سِمْعَان بُطْرُس: "وَاه آ سِيذِي، شَك ثسّْنذ قَا نش تخْسغ-ش."</para>
  <para style="p" vid="JHN 21:15">ينَّا-ٱس عِيْسَى: "سشّ يزْمَارن ينُو."<verse eid="JHN 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 21:16" />ينَّا-ٱس عِيْسَى وِيس مَرّْثَاين: "آ سِمْعَان آ مِّيس ن يُوْحَنَّا، مَا تْحِبِّيذ-اَيِي؟"</para>
  <para style="p" vid="JHN 21:16">ينَّا-ٱس سِمْعَان: "وَاه آ سِيذِي، شك ثسّْنذ قَا نش تخْسغ-ش."</para>
  <para style="p" vid="JHN 21:16">ينَّا-ٱس عِيْسَى: "ٱرْوس يحُوْڒِيْين ينُو."<verse eid="JHN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 21:17" />ينَّا-ٱس عِيْسَى وِيس ثڒْت مَرَّاث: "آ سِمْعَان آ مِّيس ن يُوْحَنَّا، مَا تخْسذ-اَيِي؟"</para>
  <para style="p" vid="JHN 21:17">ئِقّس-اَس ڒْحَاڒ إِ بُطْرُس ڒَاحقَّاش ينَّا-ٱس-ث وِيس ثڒْت مَرَّاث، شك مَا تخْسذ-اَيي؟ ينَّا-ٱس: "آ سِيذِي، شك ثسّْنذ كُڒْشي. ثسّْنذ قَا نش تخْسغ-ش."</para>
  <para style="p" vid="JHN 21:17">ينَّا-ٱس عِيْسَى: "سشّ يحُوْڒِيْين ينُو.<verse eid="JHN 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 21:18" />أَقَا تسْڒِيذ ڒْحَقّ: ذِي ثمْࢲِي نّش تْحزَّامذ يخف نّش تْرَاحذ مَانِي مَا ثخْسذ. وَلَكِن خْمِي غَا ثوْسَارذ، أَذ تْضڒْقذ يفَاسّن نّش اَتَاف حَدّ نّغْنِي اَش يحزّم اَش يَاوِي مَانِي وَار تخْسذ شَا." <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />ينَّا مَانَاينِّي عِيْسَى حمَا اَذ يسْبيّن مَامش غَا يمّث بُطْرُس حمَا اَذ تْمظْهَار لْعَظَمَا ن أَربِّـي. وَامِي إِي ذَاس ينَّا مَانَاينِّي، ينَّا-ٱس: "ذْفَار-اَيِي-د.‍"<verse eid="JHN 21:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />ئِنقْڒب بُطْرُس يُوْفَا يذفَّار-يثن-د ومحْضَار نِّي يعِيزّن خ عِيْسَى <char style="it">اَطَّاس</char>، يعْنِي ونِّي تُوْغَا يقِّيمن غَار وغزْذِيس ن عِيْسَى ذݣ ومنْسِي نِّي ينَّا-ٱس: آ سِيذِي، مِين يعْنَا ونِّي ش غَا يزّنْزن؟ <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />وَامِي ث يࢲْرَا بُطْرُس ينَّا-ٱس إِ عِيْسَى: "آ سِيذِي، ئِي وِين مِين ذَاس غَا يوقْعن؟"<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />ينَّا-ٱس عِيْسَى إِ بُطْرُس: "نش مڒَا خْسغ وِيْن اَذ يدَّر اَڒ غَا د ذوْڒغ، وَار ذَاش يرُوْح بُو ڒْحَاڒ. شك ذْفَار-اَيِي-د!" <verse eid="JHN 21:22" /><verse number="23" style="v" sid="JHN 21:23" />سّنِّي يفّغ ڒخْبَار غَار وَاوْمَاثن قَّارن: &lt;أَمحْضَار-أَ وَار يتْمتِّي شَا.&gt; وَلَكِن ذ صَّح عِيْسَى وَار يِينِّي شَا بلِّي اَمحْضَار-أَ وَار يتْمتِّي شَا. مِين ينَّا؟ ينَّا-ت اَمُّو: &lt;نش مڒَا خْسغ وِيْن اَذ يدَّر اَڒ غَا د ذوْڒغ، وَار ذَاش يرُوْح بُو ڒْحَاڒ.&gt; <verse eid="JHN 21:23" /><verse number="24" style="v" sid="JHN 21:24" />أَمحْضَار-أَ، مِين يعْنَا؟ ذ نتَّا إِݣ يشهّْذن خ ثْمسْڒَايِين-أَ ثُمَّا يُوْرِي-ثنْت. نشِّين نسّن قَا شْهَاذث نّس ن صَّح.<verse eid="JHN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />أَطَّاس ن ثْمسْڒَايِين نّغْنِي إِي يݣَّا عِيْسَى. مَعْلِيك ثُوْرَا كُڒ يشْتن زَّايْسنْت يشْت-ئِشْت، حسّْبغ بلِّي اَتَاف دُّنشْت-أَ مَارَّا وَار ثْزمَّر اَذ تيْسِي لْكُتُب نِّي إِي غَا يَارِين.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>