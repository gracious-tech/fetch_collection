<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="REV" style="id">- TarifitABS</book>
  <para style="h">لواحي</para>
  <para style="toc3">واح</para>
  <para style="toc2">لواحي ن يوحنا</para>
  <para style="toc1">لْوَاحِي ن اَرَّسُوْل يُوْحَنَّا</para>
  <para style="mt1">لْوَاحِي ن اَرَّسُوْل يُوْحَنَّا</para>
  <chapter number="1" style="c" sid="REV 1" />
  <para style="s">لْوَاحِي إِي د يوْحَا سِيذِيثْنغ عِيسى لْمَسِيح</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1" />وَانِيتَا ذ لْوَحِي ن عِيْسَى لْمَسِيح. يُوْشَا-اَس-ث أَربِّـي حمَا اَث يسْمظْهَار إِ يِنِّي ث يعَبّْذن. مَانَايَا يتْخصَّا أُو لَابُد اَذ يوْقع ذغْيَا. لْمَسِيح يسّكّ لْمَلَاك نّس اَذ يخبَّر مَانَايَا إِ ڒْعَبْذ نّس قَّارن-اَس يُوْحَنَّا. <verse eid="REV 1:1" /><verse number="2" style="v" sid="REV 1:2" />أُو نتَّا ذ شَّاهد خ مَارَّا مِين يࢲْرَا، يعْنِي خ وَاوَاڒ ن أَربِّـي ذ مِين خف يشْهذ عِيْسَى لْمَسِيح. <verse eid="REV 1:2" /><verse number="3" style="v" sid="REV 1:3" />سَّعْذ ن ونِّي إِي غَا يغَرن اَوَاڒن ن لْوَاحِي-يَا. سَّعْذ ن يِنِّي عَاوذ إِي غَا يصنّْطن إِ مِين يُوْرِين ذِي لْكِتَاب-أَ اَزَّايس ݣّن اَرَّاي ڒَاحقَّاش ڒْوقْث ثْقَارّب-د.<verse eid="REV 1:3" /></para>
  <para style="s">يُوْحَنَّا يتْسدْجَام خ سبْعَا ن ثْجُمَاع ن ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="4" style="v" sid="REV 1:4" />زِي يُوْحَنَّا غَار سبْعَا ن ثْجُمَاع ن ڒْمُوْمِنِين ذِي لْإِقْلِيم ن آسْيَا. أَكِذْوم يِيڒِي اَرْضَا ذ ڒهْنَا زݣ ونِّي إِݣ يدْجَان، تُوْغَا يدْجَا، عَاذ اَذ د يَاس. أَكِذْوم يِيڒِي اَرْضَا زِي سبْعَا ن اَرُّوْحَاث إِݣ يدْجَان زَّاث إِ لْعَرْش نّس. <verse eid="REV 1:4" /><verse number="5" style="v" sid="REV 1:5" />أُو عَاوذ اَكِذْوم يِيڒِي اَرْضَا زِي عِيْسَى لْمَسِيح نتَّا ذ شَّاهذ ذَايس ڒَامَان. نتَّا إِي د يخڒْقن ذ اَمزْوَارُو ن يِنِّي إِي د يتكَّرن زِي ڒْموْث، ذ نتَّا إِݣ يحكّْمن خ يزدْجِيذن ن ثْمُوْرْث. ئِحِبّ-اَنغ، ئِفكّ-اَنغ زِي ڒْمُعْصِيَاث نّغ س يذَامّن<note caller="+" style="f"><char style="fr" closed="false">1‏.5 </char><char style="ft" closed="false">ئِذَامّن نتَّا ذ دّم.</char></note> نّس. <verse eid="REV 1:5" /><verse number="6" style="v" sid="REV 1:6" />يݣَّا زَّايْنغ يجّن ن لْممْلَكَا ذ ڒْفُقَهَا إِ أَربِّـي بَابَاس. أَغَارس ثِيڒِي لْعَظَمَا ذ ڒحْكَام إِ نتَّا إِ ڒبْدَا، آمِين.<verse eid="REV 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7" />أَقَا يُوْسَا-د اَك وسيْنُو،<note caller="+" style="f"><char style="fr" closed="false">1‏.7 </char><char style="ft" closed="false">أَسيْنُو نتَّا ذ اَسݣْنُو.</char></note> أَث ࢲرنْت مَارَّا ثِيطَّاوِين ذ يِوْذَان نِّي إِي ث يشُوْكّن. أَخَاس حزْنن مَارَّا ڒْقُوْم ن ثْمُوْرْث. وَاه، آمين.<verse eid="REV 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8" />ئِقَّار سِيذِي أَربِّـي: "نش ذ لْأَلِف نش ذ لْيَاء. نش ذ ونِّي إِݣ يدْجَان، تُوْغَا دْجِيغ، عَاذ اَذ د اَسغ، زمَّرغ إِ كُڒْشِي."<verse eid="REV 1:8" /></para>
  <para style="s">أَرَّسُوْل يُوْحَنَّا يࢲرّ سِيذِيثْنغ عِيْسَى ذِي لْوَاحِي</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9" />نش ذ يُوْحَنَّا ذ ؤُمَاثْوم، شرّْشغ اَكِذْوم ذِي ڒمْحَاين ذ ڒْمُلْك ن أَربِّـي ذْ صّْبَار إِݣ يدْجَان ذِي عِيْسَى. تُوْغَا دْجِيغ ذِي ثيْزِيْرْث ن بَطْمُس عْلَاحْسَاب اَوَاڒ ن أَربِّـي ذ مِين خف يشْهذ عِيْسَى. <verse eid="REV 1:9" /><verse number="10" style="v" sid="REV 1:10" />ذِي نْهَار ن سِيذِيثْنغ تُوْغَا يهْوَا-د خَافِي أَرُّوح ن أَربِّـي، سْڒِيغ غَار ذفَّار ينُو يجّن ن ثْمِيجَّا ثمْغَار صُّوْت نّس يݣَّا اَم زَّمَّار. <verse eid="REV 1:10" /><verse number="11" style="v" sid="REV 1:11" />ثقَّار-اَيِي: "مِين تْوَاڒِيذ شك أَرِي-ث ذݣ يِجّن ن لْكِتَاب، سكّ-يث غَار سبْعَا ن ثْجُمَاع ن ڒْمُوْمِنِين ذِي ثنْدِينْت ن ؤُفَسُوْس، ذ سْمِيرْنَا، ذ بَرْغَامُوس، ذ ثِيَاتْرَا، ذ سَارْدِس، ذ فِيلَادَلْفْيَا، ذ لَاوْدُكْيَا."<verse eid="REV 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12" />نْقڒْبغ اَذ خْزَرغ غَار ثْمِيجَّا نِّي إِي كِذِي د يسَّاوَاڒن. وَامِي نْقڒْبغ ؤُفِيغ سبْعَا ن ڒقْنَاذڒ ن دّْهب. <verse eid="REV 1:12" /><verse number="13" style="v" sid="REV 1:13" />ذِي ڒْوسْط ن ڒقْنَاذڒ نِّي ؤُفِيغ ذِنِّي يجّن يتْشَابَّاه ذِي مِّيس ن بْنَاذم، غَارس تْشَامِّير ذ اَزيْرَار حتَّا اَڒ يضَارن نّس. غَارس يجّن ن وحزَّام<note caller="+" style="f"><char style="fr" closed="false">1‏.13 </char><char style="ft" closed="false">أَحزَّام-أَ نتَّا ذ لْوِسَام.</char></note> ن دّْهب يقْضع-د زݣ وغِيڒ غَار نّصّ. <verse eid="REV 1:13" /><verse number="14" style="v" sid="REV 1:14" />أَشوَّاف ن وزدْجِيف نّس ذ اَشمْڒَاڒ يݣَّا اَم ثَاضُوْفْث نِغ اَم وذْفڒ. ثِيطَّاوِين نّس ݣِّينْت اَم شَان ؤُحَذُوْق ن ثْمسِّي. <verse eid="REV 1:14" /><verse number="15" style="v" sid="REV 1:15" />ئِضَارن نّس تْشعْشِيعن ݣِّين اَم نّحَّاس يصْفَان اَم يَالَّاه إِي د يفّْغن زِي ڒْكُوْشث، ثْمِيجَّا نّس ثݣَّا اَم صُّوْت ن وَاطَّاس ن وَامَان. <verse eid="REV 1:15" /><verse number="16" style="v" sid="REV 1:16" />ذݣ وفُوْس نّس اَفُوْسِي غَارس سبْعَا ن يِيثْرَان. أَقمُّوْم نّس يتفّغ-د زَّايس يجّن ن سِّيف يقْضع خ ثْنَاين ن جِّهَاث، أَغمْبُوْب نّس يݣَّا اَم نُّوْر ن ثْفُوْشْت إِي يتْشعْشِعن اَطَّاس.<verse eid="REV 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 1:17" />وَامِي ث ࢲْرِيغ ؤُضِيغ-اَس غَار يضَارن نّس اَخْمِي مُّوْثغ. ئِسرْس-د خَافِي فُوْس نّس اَفُوْسِي ينَّا-ٱيِي: "وَار تݣّْوذ شَا!" ينَّا-ٱيِي: "قَا نش ذ اَمزْوَارُو ذ اَنكَّارُو. <verse eid="REV 1:17" /><verse number="18" style="v" sid="REV 1:18" />نش ذ ونِّي يدَّرن. تُوْغَا مُّوْثغ، ڒخُّو نش دَّرغ إِ ڒبْدَا ن ڒبْدَاث. غَارِي ڒمْفَاتَاح ن ڒْموْث ذ لْأَخِرَا. <verse eid="REV 1:18" /><verse number="19" style="v" sid="REV 1:19" />أَرِي مِين ثࢲْرِيذ، ذ مِين يتوْقِيعن ڒخُّو، ذ مِين غَا يوقْعن سَّا اَڒ ثْسَاونْت. <verse eid="REV 1:19" /><verse number="20" style="v" sid="REV 1:20" />مِين يعْنَا ڒْمَعْنَا ينُوْفّرن ن سبْعَا ن يِيثْرَان نِّي إِي ثࢲْرِيذ ذݣ وفُوْس ينُو اَفُوْسِي ذ سبْعَا نِّي ن ڒقْنَاذڒ؟ سبْعَا نِّي ن يِيثْرَان، يعْنِي نِثْنِي ذ سبْعَا ن لْمَلَائِكَاث ن ثْجُمَاع ن ڒْمُوْمِنِين. سبْعَا نِّي ن ڒقْنَاذڒ، يعْنِي نِثْنِي ذ سبْعَا ن ثْجُمَاع ن ڒْمُوْمِنِين."<verse eid="REV 1:20" /></para>
  <chapter eid="REV 1" />
  <chapter number="2" style="c" sid="REV 2" />
  <para style="s">ثَبْرَات إِ جْمَاعث ن ڒْمُوْمِنِين ذِي ثنْدِينْت ن ؤُفَسُوْس</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1" />"أَرِي-يَاس إِ لْمَلَائِكَا ن جْمَاعث ن ڒْمُوْمِنِين إِي يدْجَان ذِي ثنْدِينْت ن ؤُفَسُوْس، إِنِي-يَاس قَا ونِّي إِي يطّْفن سبْعَا ن يِيثْرَان ذݣ وفُوْس نّس اَفُوْسِي، يݣُّوْر ذي ڒْوسْط ن سبْعَا ن ڒقْنَاذڒ ن دّْهب، ئِقَّار-اَش: <verse eid="REV 2:1" /><verse number="2" style="v" sid="REV 2:2" />نش سّْنغ ڒخْذَايم نّش ذ تَمَارَا نّش ذ صّْبَار نّش. سّْنغ وَار ثْقبّْڒذ شَا يِنِّي يدْجَان ذ يعفَّانن، ثْجَرّْبذ يِنِّي يقَّارن قَا نشِّين ذ اَرُّسُل ثُوْفِيذ-ثن سْخرِّيقن وَاهَا. <verse eid="REV 2:2" /><verse number="3" style="v" sid="REV 2:3" />ثصْبَرذ، ثيْسِيذ تَمَارَا عْلَاحْسَاب يسم ينُو بْڒَا مَا ٱذ تَاحْرذ. <verse eid="REV 2:3" /><verse number="4" style="v" sid="REV 2:4" />وَلَكِن عيّْبغ خَاش وَامِي ثْسمْحذ ذِي ڒمْحِبّث نّش ثَمزْوَارُوْت. <verse eid="REV 2:4" /><verse number="5" style="v" sid="REV 2:5" />فكَّر مشْحَاڒ ثْغلْطذ، تُوْب، اݣّ ڒخْذَايم نّش ثِمزْوُوْرَا. مڒَا ثُوْݣِيذ اَذ تُوْبذ، أَذ د اَسغ غَارك اَذ يْسِيغ ڒْقنْدِيڒ نّش زݣ ومْشَان نّس. <verse eid="REV 2:5" /><verse number="6" style="v" sid="REV 2:6" />وَلَكِن ثݣِّيذ مْلِيح وَامِي ثْعِيفّذ ڒخْذَايم ن ينِيْكُوْلَاثن إِي عِيفّغ ؤُڒَا ذ نش. <verse eid="REV 2:6" /><verse number="7" style="v" sid="REV 2:7" />صنّط مْلِيح آ ونِّي يتْسْڒَان مِين يقَّار أَرُّوْح ن أَربِّـي إِ ثْجُمَاع ن ڒْمُوْمِنِين. ونِّي غَا يربْحن اَذَاس ؤُشغ اَذ يشّ زِي ثْشجَّارْث ن ثُوْذَارث إِي يدْجَان ذِي جّنّث ن أَربِّـي.<verse eid="REV 2:7" /></para>
  <para style="s">ثَبْرَات إِ جْمَاعث ن ڒْمُوْمِنِين ذِي ثنْدِينْت ن سْمِيْرْنَا</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8" />أَرِي-يَاس إِ لْمَلَائِكَا ن جْمَاعث ن ڒْمُوْمِنِين إِي يدْجَان ذِي ثنْدِينْت ن سْمِيْرْنَا، إِنِي-يَاس قَا ونِّي يدْجَان ذ اَمزْوَارُو ؤُڒَا ذ اَنݣَّارُو،<note caller="+" style="f"><char style="fr" closed="false">2‏.8 </char><char style="ft" closed="false">مِين يعْنَا "ونِّي يدْجَان ذ اَمزْوَارُو ؤُڒَا ذ اَنݣَّارُو"؟ مَانَايَا يسَّاوَاڒ خ سِيذِيثْنغ عِيْسَى. كُڒْشِي زَّايس إِݣ يبْذَا، كُڒْشِي زَّايس إِي غَا يكمّڒ. خْزَر ؤُذم وِيس 22 ذ لْأَيَا وِيس 13.</char></note> يمُّوْث أُوْشَا يكَّر-د زِي ڒْموْث، ئِقَّار-اَش: <verse eid="REV 2:8" /><verse number="9" style="v" sid="REV 2:9" />نش سّْنغ ڒمْحَاين نّش، شك ذ ڒْمسْكِين، وَلَكِن لَّا شك ذ تَّاجَر! سّْنغ ڒْبَاطڒ إِي خَاوم قَّارن يِنِّي يحسّْبن يخف نْسن زِي أَيث-إِسْرَائِيل. لَّا، نِثْنِي وَار دْجِين شَا زِي جْمَاعث ن أَيث-إِسْرَائِيل؛ نِثْنِي غِير ذ يجّن ن جْمَاعث إِݣ يعبّْذن شِّيطَان. <verse eid="REV 2:9" /><verse number="10" style="v" sid="REV 2:10" />وَار تݣّْوذ شَا زِي مَامّش إِي غَا تْوَاعدّْبذ. أَقَا إِبْڒِيس اَذ يسِيذف ڒبْعَاض زَّايْوم غَار ڒحْبس حمَا اَذ تْوَاجَرّْبم. أَذ تْسعْذُوْم ڒمْحَاين ذي عشْرَايَّام. اَرْنِي ذِي لْإيْمَان نّش وَاخَّا اَش نْغن، نش اَذَاش ؤُشغ تَّاج ن ثُوْذَارْث. <verse eid="REV 2:10" /><verse number="11" style="v" sid="REV 2:11" />صنّط مْلِيح آ ونِّي يتْسْڒَان مِين يقَّار اَرُّوْح ن أَربِّـي إِ ثْجُمَاع ن ڒْمُوْمِنِين. ونِّي غَا يربْحن، وَار ث تْضَرِّي شَا ڒْموْث نِّي وِيس ثْنَاين.<verse eid="REV 2:11" /></para>
  <para style="s">ثَبْرَات إِ جْمَاعث ن ڒْمُوْمِنِين ذِي ثنْدِينْت ن بَرْغَامُوْس</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12" />أَرِي-يَاس إِ لْمَلَائِكَا ن جْمَاعث ن ڒْمُوْمِنِين إِي يدْجَان ذِي ثنْدِينْت ن بَرْغَامُوْس، إِنِي-يَاس قَا ونِّي غَار يدْجَا سِّيف يقْضع خ ثْنَاين ن جِّهَاث، ئِقَّار-اَش: <verse eid="REV 2:12" /><verse number="13" style="v" sid="REV 2:13" />نش سّْنغ مَانِي ثْزدّْغذ، ذِنِّي لْعَرْش ن شِّيطَان. شك تطّْفذ ذݣ يِيسم ينُو. وَار ثنْكَرذ شَا لْإِيْمَان إِي زَّايِي ثݣِّيذ، وَاخَّا ذݣ وُوْسَّان نِّي إِي ذِي نْغِين يجّن ن شَّهِيذ ينُو ذَايس ڒَامَان قَّارن-اَس أَنْتِپَـاس. نْغِين-ث زَّاثْوم مَانِي يزدّغ شِّيطَان. <verse eid="REV 2:13" /><verse number="14" style="v" sid="REV 2:14" />وَلَكِن عيّْبغ خَاش شَان ثْمسْڒَايِين وَامِي اَكِذش شَان يوْذَان إِي تْبَاعن تَّعْلِيم ن بَلْعَام. نتَّا تُوْغَا يسْڒمَاذ-اَس إ بَارَاك مَامّش غا يݣّ ثَخْشبْث إِ اَيث-إِسْرَائِيل بَاش اَذ شّن دْبِيحث يتْقدَّامن إِ لْأَصْنَام اَذ فسْذن. <verse eid="REV 2:14" /><verse number="15" style="v" sid="REV 2:15" />عَاوذ اَكِذش شَان يِوْذَان إِي تْبَاعن تَّعْلِيم ن ينِيْكُوْلَاثن. <verse eid="REV 2:15" /><verse number="16" style="v" sid="REV 2:16" />تُوْب! مڒَا لَّا، أَغَارك د اَسغ ذغْيَا وَار تْعطَّاڒغ شَا، أَذ حَارْبغ يوْذَان-أَ س سِّيف إِي د يتفّْغن زݣ وقمُّوْم ينُو. <verse eid="REV 2:16" /><verse number="17" style="v" sid="REV 2:17" />صنّط مْلِيح آ ونِّي يتْسْڒَان مِين يقَّار أَرُّوْح ن أَربِّـي إِ ثْجُمَاع ن ڒْمُوْمِنِين. ونِّي غَا يربْحن، أَذَاس ؤُشغ اَذ يشّ اَغْرُوْم ن لْمَنَّا ونِّي يتْوَاسْنُوْفّرن. أَذَاس ؤُشغ اَزْرُو ذ اَشمْڒَاڒ يُوْرَا ذَايس يجّن ن يِيسم ذ جْذِيذ وَار ث يسِّين حَدّ إِلَّا ونِّي إِي ث غَا يقبْڒن.<verse eid="REV 2:17" /></para>
  <para style="s">ثَبْرَات إِ جْمَاعث ن ڒْمُوْمِنِين ذِي ثنْدِينْت ن ثِيَاتْرَا</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18" />أَرِي-يَاس إِ لْمَلَائِكَا ن جْمَاعث ن ڒْمُوْمِنِين إِي يدْجَان ذِي ثنْدِينْت ن ثِيَاتْرَا، إِنِي-يَاس قَا ونِّي يدْجَان ذ مِّيس ن أَربِّـي، ثِيطَّاوِين نّس ݣِّينْت اَم ؤُحَذُوْق ن ثْمسِّي، ئِضَارن نّس ݣِّين اَم نّحَّاس يصْفَان، ئِقَّار-اَش: <verse eid="REV 2:18" /><verse number="19" style="v" sid="REV 2:19" />نش سّْنغ ڒخْذَايم نّش ذ ڒمْحِبّث نّش ذ لإِيْمَان نّش ذ صّْبَار نّش قَا سّْنغ ڒخْذَايم نّش ثِنݣُّوْرَا كْتَار زِي ثِنِّي ثِمزْوُوْرَا. <verse eid="REV 2:19" /><verse number="20" style="v" sid="REV 2:20" />وَلَكِن عيّْبغ خَاش وَامِي ثجِّيذ إِزَابِيل ثَمْغَارْث تَارَّا يخف نّس ذ نَّبِـيَا. ثْخدّع لْعِبَاد ينُو، ثْسڒْمَاذ-يثن اَذ فسْذن، أَذ شّن زِي دْبِيحث يتْقدَّامن إِ لأَصْنَام. <verse eid="REV 2:20" /><verse number="21" style="v" sid="REV 2:21" />ؤُشِيغ-اَس ڒْوقْث اَذ تْتُوْب زِي لْفَسَاد نّس، وَلَكِن ثُوْݣِي اَذ تْتُوْب. <verse eid="REV 2:21" /><verse number="22" style="v" sid="REV 2:22" />س مَانَاينِّي اَت نضَرغ ذِي ثَاسُّوْث ن ڒحْڒِيق ذ يِنِّي اَكِذس غَا يزْنَان مڒَا وَار تُوْبن شَا زِي ڒفْعَايڒ نْسن اَتَاف اَثن نْضَرغ ذِي ڒمْحَاين. <verse eid="REV 2:22" /><verse number="23" style="v" sid="REV 2:23" />أَذ نْغغ ثَارْوَا نّس. أَذْ سّْنن مَارَّا ثِجُمَاع ن ڒْمُوْمِنِين بلِّي ذ نش إِݣ يتْميَّازن مِين ذَايس ذِي ڒَعْقڒ ذ وُوْڒ. كُڒ يجّن زَّايْوم اَذَاس ؤُشغ عْلَاحْسَاب ڒخْذَايم نّس.<verse eid="REV 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 2:24" />أَمَّا كنِّيو نّغْنِي إِي يدْجَان ذِي ثِيَاتْرَا وَار ثقْبِيڒم شَا تَّعْلِيم نِّي وَار ثسِّينم شَا مَانَاينِّي ؤُمِي قَّارن يِوْذَان &lt;لْأَسْرَار ن شِّيطَان يُودْجْغن.&gt; قَّارغ-اَوم نش وَار خَاوم تݣّغ بُو شَا ن دْقڒ نّغْنِي. <verse eid="REV 2:24" /><verse number="25" style="v" sid="REV 2:25" />إِنَّمَا، لْإِيمَان نْوم طّْفم ذَايس مْلِيح وَاهَا اَڒ د غَا اَسغ. <verse eid="REV 2:25" /><verse number="26‏-27" style="v" sid="REV 2:26-27" />ونِّي غَا يربْحن ذ ونِّي غَا يصْبَرن ذِي ڒْخذْمث ينُو حتَّا اَڒ ونݣَّارُو اَذَاس ؤُشغ نش سُّلْطَا خ ڒݣْنُوْس، أَمّش ذَايِي ثمُّوْش إِ نش زِي بَابَا: أَثن يَرْوس س وعكَّاز ن ڒحْذِيذ، أَثن يرز اَم يقْنُوْشن ن وشَاڒ. <verse eid="REV 2:26-27" /><verse number="28" style="v" sid="REV 2:28" />أَذَاس ؤُشغ يثْرِي ن ڒفْجَر. <verse eid="REV 2:28" /><verse number="29" style="v" sid="REV 2:29" />صنّط مْلِيح آ ونِّي يتْسْڒَان مِين يقَّار اَرُّوح ن أَربِّـي إِ ثْجُمَاع ن ڒْمُوْمِنِين.<verse eid="REV 2:29" /></para>
  <chapter eid="REV 2" />
  <chapter number="3" style="c" sid="REV 3" />
  <para style="s">ثَبْرَات إِ جْمَاعث ن ڒْمُوْمِنِين ذِي ثنْدِينْت ن سَرْدِيس</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1" />أَرِي-يَاس إِ لْمَلَائِكَا ن جْمَاعث ن ڒْمُوْمِنِين إِي يدْجَان ذِي ثنْدِينْت ن سَرْدِيس، إِنِي-يَاس قَا ونِّي غَار دْجَان سبْعَا ن اَرُّوْحَاث ن أَربِّـي ذ سبْعَا ن يِيثْرَان، ئِقَّار-اَش: نش سّْنغ ڒخْذَايم نّش. قَّارن قَا شك ثدَّرذ وَلَكِن لَّا شك ثمُّوْثذ. <verse eid="REV 3:1" /><verse number="2" style="v" sid="REV 3:2" />إِڒِي عْلَابَال، اݣّ جّْهذ نّش ذِي ڒخْذَايم نّش إِي ذَاش يقِّيمن قْبڒ مَا ٱذ مّْثنْت قَاع. نش ؤُفِيغ ڒخْذَايم نّش وَار كمّْڒنْت شَا زَّاث إِ أَربِّـي ينُو. <verse eid="REV 3:2" /><verse number="3" style="v" sid="REV 3:3" />عْقڒ خ تَّعْلِيم إِي ثْقبْڒذ وَامِي ذَاس ثسْڒِيذ. خْذم زِّايس، تُوْب. مڒَا وَار ثدْجِيذ شَا عْلَابَال، نش اَغَارك د اَسغ اَم يِج وشفَّار وَار ثسِّينذ شَا مَان ثْسَاعَّات إِي د غَا اَسغ.<verse eid="REV 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 3:4" />أَكِذش ذِنِّي ڒبْعَاض ن يِوْذَان ذِي سَرْدِيس وَار سْوسِيخن شَا اَرُّوْض نْسن، أَكِذِي ؤُيُوْرن س وَارُّوْض ذ اَشمْڒَاڒ ڒَاحقَّاش سْذَاهدْجن-ت. <verse eid="REV 3:4" /><verse number="5" style="v" sid="REV 3:5" />ونِّي غَا يربْحن اَذَاس ݣّن اَرُّوْض ذ اَشمْڒَاڒ. نش عمَّارْص اَذ مسْحغ يسم نّس زِي لْكِتَاب ن ثُوْذَارْث، أَخَاس شهْذغ زَّاث إِ بَابَا ذ لْمَلَائِكَاث نّس. <verse eid="REV 3:5" /><verse number="6" style="v" sid="REV 3:6" />صنّط مْلِيح آ ونِّي يتْسْڒَان مِين يقَّار أَرُّوْح ن أَربِّـي إِ ثْجُمَاع ن ڒْمُوْمِنِين.<verse eid="REV 3:6" /></para>
  <para style="s">ثَبْرَات إِ جْمَاعث ن ڒْمُوْمِنِين ذِي ثنْدِينْت ن فِيلَادَلْفْيَا</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7" />أَرِي-يَاس إِ لْمَلَائِكَا ن جْمَاعث ن ڒْمُوْمِنِين إِي يدْجَان ذِي ثنْدِينْت ن فِيلَادَلْفْيَا، إِنِي-يَاس قَا ونِّي يمْقدّْسن ذ ڒْحَقّ، غَارس ڒْمفْتَاح ن دَاود؛ مڒَا يرْزم اَتَاف وَار ث يتْبلِّيع حَدّ؛ مڒَا يبلّع اَتَاف وَار ث يرزّم حَدّ، ئِقَّار-اَش: <verse eid="REV 3:7" /><verse number="8" style="v" sid="REV 3:8" />نش سّْنغ ڒخْذَايم نّش. أَقَا ݣِّيغ زَّاثش يجّن ن ثوَّارْث ثْنُوْرْزم وَار يزمَّر حَدّ اَت يبلّع. وَاخَّا جّْهذ نّش ذ ؤُقْلِيل، ثݣِّيذ اَرَّاي إِ وَاوَاڒ ينُو وَار ثنْكَرذ شَا يسم ينُو. <verse eid="REV 3:8" /><verse number="9" style="v" sid="REV 3:9" />أَمَّا يِنِّي زِي جْمَاعث إِي يعبّْذن شِّيطَان حسّْبن يخف نْسن زِي أَيث-إِسْرَائِيل، وَلَكِن نِثْنِي وَار دْجِين شَا زِي أَيث-إِسْرَائِيل سْخرِّيقن وَاهَا. أَثن د اَرّغ س بزّز اَذ د اَسن اَذ سجّْذن غَار يضَارن نّش اَذ سّْنن نش تْحِبِّيغ-شك. <verse eid="REV 3:9" /><verse number="10" style="v" sid="REV 3:10" />ثصْبَرذ خ مِين ش وصِّيغ، س مَانَايَا اَتَاف نش اَش حْمِيغ زِي ثْسَاعَّات نِّي ن ڒمْحَاين إِي د غَا يهْوَان خ مَارَّا دُّنشْت-أَ حمَا يمزْذَاغ ن تْمُوْرْث اَزَّايس تْوَاجَرّْبن. <verse eid="REV 3:10" /><verse number="11" style="v" sid="REV 3:11" />أَقَا ؤُسِيغ-د وَار تْعطَّاڒغ شَا. طّف ذِي لْإِيْمَان نّش حمَا وَار د يتِيس حَدّ اَش ييْسِي تَّاج نّش. <verse eid="REV 3:11" /><verse number="12" style="v" sid="REV 3:12" />قَا ونِّي غَا يربْحن اَث سْبدّغ اَم يِجّن ن وپِــيلَار ذِي ثمْزِيذَا ثَمقّْرَانْت ن أَربِّـي ينُو اَذ يقِّيم ذِنِّي إِ ڒبْدَا. أَخَاس اَرِيغ يسم ن أَربِّـي ينُو ذ يِيسم ن ثنْدِينْت ن أَربِّـي ينُو، يعْنِي لْقُدْس ن جْذِيذ إِي د غَا يهْوَان زݣ وجنَّا زِي أَربِّـي ينُو. أَخَاس اَرِيغ يسم ينُو ذ جْذِيذ. <verse eid="REV 3:12" /><verse number="13" style="v" sid="REV 3:13" />صنّط مْلِيح آ ونِّي يتْسْڒَان مِين يقَّار اَرُّوْح ن أَربِّـي إِ ثْجُمَاع ن ڒْمُوْمِنِين.<verse eid="REV 3:13" /></para>
  <para style="s">ثَبْرَات إِ جْمَاعث ن ڒْمُوْمِنِين ذِي ثنْدِينْت ن لَاوْدُكْيَا</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14" />أَرِي-يَاس إِ لْمَلَائِكَا ن جْمَاعث ن ڒْمُوْمِنِين إِي يدْجَان ذِي ثنْدِينْت ن لَاوْدُكْيَا، إِنِي-يَاس قَا ونِّي ؤُمِي قَّارن آمِين، نتَّا ذ شَّاهذ ذَايس ڒَامَان ذَايس ڒْحَقّ، زَّايس إِي د يخْڒق أَربِّـي مَارَّا، ئِقَّار-اَش: <verse eid="REV 3:14" /><verse number="15" style="v" sid="REV 3:15" />نش سّْنغ ڒخْذَايم نّش، شك وَار ثسْمِيضذ وَار ثحْمِيذ. تْمنِّيغ شك اَذ تْسمْضذ نِغ اَذ تحْمِيذ! <verse eid="REV 3:15" /><verse number="16" style="v" sid="REV 3:16" />أَشك د عُوْقّغ زݣ وقمُّوْم ينُو، شك ثمْڒُوْذِيذ وَاهَا وَار ثحْمِيذ شَا وَار ثسْمِيضذ شَا. <verse eid="REV 3:16" /><verse number="17" style="v" sid="REV 3:17" />شك ثْقَّارذ زَعْمَا قَا نش ذ يجّن ن تَّاجَر ݣِّيغ اَطَّاس ن وَاݣْڒَا وَار حْذِيجغ وَالُو. إِيوَا وَار ثسِّينذ شَا قَا شك ذ اَمْقطَّاع ذ اَمغْبُوْن، ذ يمسْعِي، ذ اَذَرْغَاڒ، ذ اَعرْيَان. <verse eid="REV 3:17" /><verse number="18" style="v" sid="REV 3:18" />قَا نش نصّْحغ-شك اَخَافِي ثسْغذ دّْهب يتْوَاصْفَان س ثْمسِّي حمَا اَذ تْذوْڒذ ذ تَّاجَر. سغ عَاوذ اَرُّوْض ذ اَشمْڒَاڒ حمَا اَذ تسَرْضذ يخف نّش زِي ثُوْعَرْيَانْت نّش عَاوذ ذ شَان دّْوَا حمَا اَذ تسْݣنْفِيذ ثِيطَّاوِين نّش اَتَاف تْوَاڒِيذ. <verse eid="REV 3:18" /><verse number="19" style="v" sid="REV 3:19" />نش تْربِّيغ نهِّيغ مَارَّا ونِّي تْحِبِّيغ. شك لْإِيْمَان نّش سجْهذ-يث، تُوْب. <verse eid="REV 3:19" /><verse number="20" style="v" sid="REV 3:20" />قَا نش بدّغ زَّاث إِ ثوَّارْث سْقرْقُوْبغ. مڒَا يسْڒَا شَان يجّن إِ ثْمِيجَّا ينُو قَا اَذ يرْزم ثَوَّارْث، أَتَاف اَغَارس اَذْفغ اَكِذس شّغ اَكِذِي يشّ. <verse eid="REV 3:20" /><verse number="21" style="v" sid="REV 3:21" />ونِّي غَا يربْحن اَث جّغ اَكِذِي يقِّيم خ لْعَرْش ينُو، أَم ربْحغ ؤُڒَا ذ نش قِّيمغ اَك بَابَا خ لْعَرْش نّس. <verse eid="REV 3:21" /><verse number="22" style="v" sid="REV 3:22" />صنّط مْلِيح آ ونِّي يتْسْڒَان مِين يقَّار اَرُّوْح ن أَربِّـي إِ ثْجُمَاع ن ڒْمُوْمِنِين."<verse eid="REV 3:22" /></para>
  <chapter eid="REV 3" />
  <chapter number="4" style="c" sid="REV 4" />
  <para style="s">أَربِّـي يتْمظْهَار-د خ لْعَرْش نّس ذݣ وجنَّا</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1" />منْبَعْد إِ مَانَايَا ࢲْرِيغ يجّن ن ثوَّارْث ثْنُوْرْزم ذݣ وجنَّا، سْڒِيغ إِ ثْمِيجَّا نِّي إِي غَارِي د يسِّيوْڒن زِي قْبڒ صُّوْت نّس يݣَّا اَم زَّمَّار، ثنَّا-ٱيِي-د: "ݣَعّذ-د ذَانِيتَا اَذَاش د سْمظْهَارغ مِين لَابُد غَا يوقْعن منْبَعْد إِ مَانَايَا." <verse eid="REV 4:1" /><verse number="2" style="v" sid="REV 4:2" />ڒخْدّنِّي يهْوَا-د خَافِي أَرُّوْح ن أَربِّـي، ئِمظْهَار-د ذِنِّي يجّن ن لْعَرْش ذݣ وجنَّا يقِّيم خَاس يجّن. <verse eid="REV 4:2" /><verse number="3" style="v" sid="REV 4:3" />ونِّي خَاس يقِّيمن يتْشَابَّاه ذِي ثزْرُوْت ن لْيَشب ذ لْعَقِيق اَزݣّْوَاغ. ئِجّن ن ثسْڒِيث ن ونْࢲَار ثنّض-اَس-د إِ لْعَرْش-أَ، تْشَابَّاه ذِي ثزْرُوْت ثَزيْزَاوْث ن زُّمُرُّد. <verse eid="REV 4:3" /><verse number="4" style="v" sid="REV 4:4" />نّْضن-اَس-د إِ لْعَرْش-أَ اَرْبعَا و عِشْرِين ن لْعَرْشَاث، خَاسن اَرْبعَا و عِشْرِين ن يمْغَارن ݣِّين اَرُّوْض ذ اَشمْڒَاڒ، كُڒ يجّن زَّايْسن غَارس تَّاج ن دّْهب خ وزدْجِيف نّس. <verse eid="REV 4:4" /><verse number="5" style="v" sid="REV 4:5" />ئِتفّغ-د زِي لْعَرْش وَاسَّام<note caller="+" style="f"><char style="fr" closed="false">4‏.5 </char><char style="ft" closed="false">أَسَّام نتَّا ذ ڒبْرُوق.</char></note> ذ يغُوْيَان ذ وَاجَّاج. زَّاث إِ لْعَرْش ذِنِّي سبْعَا ن يصْفضَاون ن ثْمسِّي شعّْڒن، يِيْنَا نِثْنِي ذ سبْعَا ن اَرُّوْحَاث ن أَربِّـي. <verse eid="REV 4:5" /><verse number="6" style="v" sid="REV 4:6" />زَّاث إِ لْعَرْش ذِنِّي اَم ڒبْحَر ن جَّاج يصْفَا اَطَّاس. ذِنِّي اَربْعَا ن لْمخْلُوقَاث يدَّرن ذِي ڒْوسْط، نّْضن-اَس-د إِ لْعَرْش غَارْسن ثِيطَّاوِين غَار زَّاث ذ ذفَّار. <verse eid="REV 4:6" /><verse number="7" style="v" sid="REV 4:7" />لْمخْلُوْق اَمزْوَارُو يتْشَابَّاه ذِي سّْبَع.<note caller="+" style="f"><char style="fr" closed="false">4‏.7 </char><char style="ft" closed="false">سّْبَع نتَّا ذ اَيْرَاذ، س ثعْرَابْث الأَسَد.</char></note> وِيس ثْنَاين يتْشَابَّاه ذݣ وينْدُوْز. وِيس ثْڒَاثَا غَارس اَغمْبُوْب اَم بْنَاذم. وِيس اَرْبعَا يتْشَابَّاه ذِي نْسر يطَّاون. <verse eid="REV 4:7" /><verse number="8" style="v" sid="REV 4:8" />كُڒ يجّن زِي لْمخْلُوقَاث-أَ غَارس ستَّا ن وَافْرِيون، كُڒ اَفْرِيو يشُّوْر س ثِيطَّاوِين خ جِّهتَاين. قَّارن دْجِيڒث ذ نْهَار بْڒَا مَا ٱذ بدّن:</para>
  <para style="q1" vid="REV 4:8">"مشْحَاڒ عَظِيم، عَظِيم، عَظِيم، سِيذِي أَربِّـي يزمَّرن إِ كُڒْشِي.</para>
  <para style="q1" vid="REV 4:8">نتَّا ذ ونِّي إِي تُوْغَا يدْجَان، ذ ونِّي إِي يدْجَان، ذ ونِّي عَاذ إِي د غَا يَاسن."<verse eid="REV 4:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="REV 4:9" />لْمخْلُوْقَاث-أَ مڒْمِي مَا سمْغَارن تْوقَّارن حمّْذن-اَس إِ ونِّي يقِّيمن خ لْعَرْش إِݣ يدَّرن إِ ڒبْدَا ن ڒبْدَاث، <verse eid="REV 4:9" /><verse number="10" style="v" sid="REV 4:10" />سّنِّي عَاوذ اَرْبعَا أُو عِشْرِين نِّي ن يمْغَارن تْركَّاعن-اَس إِ ونِّي يقِّيمن خ لْعَرْش، تْسجَّاذن-اَس إِ ونِّي يدَّرن إِ ڒبْدَا ن ڒبْدَاث. كُڒ يجّن زَّايْسن ينطَّر تَّاج نّس زَّاث إِ لْعَرْش يقَّار:<verse eid="REV 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11" />"آ مَوْلَانَا آ سِيذِي أَربِّـي نّغ،</para>
  <para style="q1" vid="REV 4:11">ذ شك إِي يسْذَاهدْجن لْعَظَمَا ذ ؤُوقَّار ذ جّْهذ،</para>
  <para style="q1" vid="REV 4:11">ڒَاحقَّاش شك ثْخڒْقذ كُڒْشِي،</para>
  <para style="q1" vid="REV 4:11">س ڒْخَاضَر نّش تْوَاخڒْقنْ-د اَقَاثن دْجَان."<verse eid="REV 4:11" /></para>
  <chapter eid="REV 4" />
  <chapter number="5" style="c" sid="REV 5" />
  <para style="s">لْكِتَاب نِّي ذِي يُوْرِينْت لْمُصِيبَاث</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1" />ثُمَّا ࢲْرِيغ يجّن ن لْكِتَاب ذݣ وفُوْس اَفُوْسِي ن ونِّي يقِّيمن خ لْعَرْش يُوْرَا غَار ذَاخڒ ذ بَارَّا، ئِشمّع سبْعَا مَرَّاث. <verse eid="REV 5:1" /><verse number="2" style="v" sid="REV 5:2" />تْوَاڒِيغ يجّن ن لْمَلَاك اَمقّْرَان يڒَاغَا س جّْهذ يقَّار: "وِي غَار يدْجَا ڒْحَقّ اَذ يرْزم لْكِتَاب-أَ اَذ يكّس يشمَّاعن نّس؟" <verse eid="REV 5:2" /><verse number="3" style="v" sid="REV 5:3" />ؤُڒَا ذ يجّن ذݣ وجنَّا نِغ ذِي ثْمُوْرْث نِغ سْوَادَّاي إِ ثْمُوْرْث وَار يزمَّر اَذ يرْزم لْكِتَاب-أَ نِغ اَذ يخْزَر مِين ذَايس. <verse eid="REV 5:3" /><verse number="4" style="v" sid="REV 5:4" />تْرُوْغ<note caller="+" style="f"><char style="fr" closed="false">5‏.4 </char><char style="ft" closed="false">ئِسَّاوَاڒ ذَانِيتَا يُوْحَنَّا يعْنِي ونِّي يتَارِين ثَبْرَات-أَ.</char></note> اَطَّاس ڒَاحقَّاش وَار ؤُفِين حَدّ اَذ يسْذَاهدْج اَذ يرْزم لْكِتَاب-أَ اَذَايس يخْزَر. <verse eid="REV 5:4" /><verse number="5" style="v" sid="REV 5:5" />ڒخْدّنِّي ينْدق-د يجّن زݣ يمْغَارن نِّي ينَّا-ٱيِي: "وَار تْرُو شَا! أَقَا يرْبح سّْبَع نِّي إِݣ يدْجَان زِي أَيث-يَهُوْذَا لْأَصْل نّس زِي دَاود، ئِزمَّر اَذ يرْزم لْكِتَاب-أَ اَذ يكّس يشمَّاعن نِّي س سبْعَا."<verse eid="REV 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6" />ثُمَّا طَّارْف إِ لْعَرْش-أَ، ذِي ڒْوسْط ن اَرْبعَا ن لْمخْلُوْقَاث نِّي ذ يمْغَارن نِّي، ࢲْرِيغ ذِنِّي يجّن ن يزْمَار يبدّ وَلَكِن يتْبَان-د اَخْمِي ث نْغِين. غَارس سبْعَا ن وَاشَّاون<note caller="+" style="f"><char style="fr" closed="false">5‏.6 </char><char style="ft" closed="false">أَشَّاون نِثْنِي ذ يقَاشَّاون ن لْحَيَوَان.</char></note> ذ سبْعَا ن ثِيطَّاوِين. نِثْنِي ذ سبْعَا ن اَرُّوْحَاث ن أَربِّـي إِݣ يسّكّ غَار مَارَّا دُّنشْت-أَ. <verse eid="REV 5:6" /><verse number="7" style="v" sid="REV 5:7" />يُوْسَا-د ييْسِي لْكِتَاب-أَ زݣ وفُوْس اَفُوْسِي ن ونِّي يقِّيمن خ لْعَرْش. <verse eid="REV 5:7" /><verse number="8" style="v" sid="REV 5:8" />وَامِي ييْسِي لْكِتَاب-أَ، لْمخْلُوقَاث نِّي س اَرْبعَا ذ اَرْبعَا أُو عِشْرِين ن يمْغَارن نِّي سجّْذن-اَس إِ يِزْمَار. مْكُڒ يجّن زَّايْسن غَارس ثْݣَامْبْرِيت غَارس ثِمجْمَارِين ݣِّين-ثنْت س دّْهب عمَّارنْت س تْبَخُوْر، يعْنِي ذ ثْࢲَادْجِيث ن ڒْمُوْمِنِين صَّالِحِين. <verse eid="REV 5:8" /><verse number="9" style="v" sid="REV 5:9" />تْغنَّاجن س يِجّن ن يِزْڒْي ذ جْذِيذ قَّارن:</para>
  <para style="q1" vid="REV 5:9">"ذ شك إِي يسْذَاهدْجن اَذ تيْسِيذ لْكِتَاب</para>
  <para style="q2" vid="REV 5:9">أَذ ترْزْمذ يشمَّاعن نّس،</para>
  <para style="q1" vid="REV 5:9">ڒَاحقَّاش تْوَاغَرْصذ،</para>
  <para style="q2" vid="REV 5:9">ثسْنجْمذ يوْذَان إِ أَربِّـي س يذَامّن نّش</para>
  <para style="q1" vid="REV 5:9">زِي مْكُڒ ڒْقُوْم ذ لُّغَا ذ شَّعْب ذ ڒْݣنْس.<verse eid="REV 5:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="REV 5:10" />ثݣِّيذ زَّايْسن يجّن ن لْممْلَكَا ن ڒْفُقَهَا إِ أَربِّـي نّغ،</para>
  <para style="q1" vid="REV 5:10">أَذ حكّْمن ذِي ثْمُوْرْث."<verse eid="REV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11" />ثُمَّا خْزَرغ، سْڒِيغ إِ ثْمِيجَّا ن وَاڒَاف ن ؤُڒُوْفَاث ذ مِيلْيُوْن ن مِيلْيُوْنَاث ن لْمَلَائِكَاث تنّْضنْت-اَس-د إِ لْعَرْش ذ لْمخْلُوقَاث ذ يمْغَارن. <verse eid="REV 5:11" /><verse number="12" style="v" sid="REV 5:12" />قَّارنْت س جّْهذ:</para>
  <para style="q1" vid="REV 5:12">"ئِزْمَار يتْوَانْغن يسْذَاهدْج</para>
  <para style="q2" vid="REV 5:12">ثِزمَّار ذ وَاݣْڒَا ذ لْحِكْمَا ذ جّْهذ</para>
  <para style="q1" vid="REV 5:12">ذ ؤُوقَّار ذ لْعَظَمَا ذ لْحَمد."<verse eid="REV 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 5:13" />ثُمَّا سْڒِيغ إِ كُڒ لْمخْلُوْق يدْجَان ذݣ وجنَّا ذ ثْمُوْرْث ذ سْوَادَّاي إِ ثْمُوْرْث ذ ڒبْحَر ذ مَارَّا مِين ذَايْسن قَّارن-اَسن إِ ونِّي يقِّيمن خ لْعَرْش ؤُڒَا ذ يِزْمَار: أَغَارْوم يِيڒِي لْحَمد ذ ؤُوقَّار ذ لْعَظَمَا ذ ڒحْكَام إِ ڒبْدَا ن ڒبْدَاث!"<verse eid="REV 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 5:14" />لْمخْلُوقَاث نِّي س اَرْبعَا قَّارن: "آمِين!" ركْعن يمْغَارن نِّي اَذ سجّْذن.<verse eid="REV 5:14" /></para>
  <chapter eid="REV 5" />
  <chapter number="6" style="c" sid="REV 6" />
  <para style="s">سبْعَا نِّي ن يشمَّاعن خ لْكِتَاب ن لْمُصِيبَاث</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1" />ثُمَّا ࢲْرِيغ يزْمَار نِّي وَامِي يرْزم يجّن زِي سبْعَا ن يشمَّاعن نِّي، سْڒِيغ إِ يِجّن زِي اَرْبعَا نِّي ن لْمخْلُوْقَاث يقَّار س جّْهذ اَم وَاجَّاج: "أَرَاح-د!" <verse eid="REV 6:1" /><verse number="2" style="v" sid="REV 6:2" />وَامِي خْزَرغ، تْوَاڒِيغ يجّن ن ؤُيِيْس ذ اَشمْڒَاڒ، ونِّي خَاس ينْيِين غَارس يجّن ن نشَّاب ن فْڒِيتْشَا. ؤُشِين-اَس يجّن ن تَّاج، ئِفّغ يربّح ذِي ڒْحَرْب أُو عَاذ اَذ يرْبح.<verse eid="REV 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3" />ئِزْمَار نِّي وَامِي يرْزم اَشمَّاع وِيس ثْنَاين، سْڒيغ إِ لْمخْلُوْق وِيس ثْنَاين يقَّار: "أَرَاح-د!" <verse eid="REV 6:3" /><verse number="4" style="v" sid="REV 6:4" />ثُمَّا يفّغ-د يجّن ن ؤُيِيْس ذ اَزݣّْوَاغ، ونِّي خَاس ينْيِين ؤُشِين-اَس اَذ يكّس سَّلَام زِي ثْمُوْرْث، أَذ نْغن يِوْذَان اَيَاوْيَا. عَاوذ ؤُشِين-اَس يجّن ن سِّيف ذ اَمقّْرَان.<verse eid="REV 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5" />ئِزْمَار نِّي وَامِي يرْزم اَشمَّاع وِيس ثْڒَاثَا، سْڒِيغ إِ لْمخْلُوْق وِيس ثْڒَاثَا يقَّار: "أَرَاح-د!" وَامِي خْزَرغ، تْوَاڒِيغ يجّن ن ؤُيِيْس ذ اَبرْشَان، ونِّي خَاس ينْيِين غَارس ڒْمِيزَان ذݣ وفُوْس نّس. <verse eid="REV 6:5" /><verse number="6" style="v" sid="REV 6:6" />ثُمَّا سْڒِيغ اَمشْنَاو يجّن ن ثْمِيجَّا ثُوْسَا-د زِي جِّهث ن اَرْبعَا ن لْمخْلُوْقَاث نِّي ثقَّار: "كِيلُو ن يِرْذَان يسݣّْوَا نْهَار وفدْجَاح. عَاوذ ثْڒَاثَا كِيلُو ن يمنْدِي يسݣّْوَا نْهَار وفدْجَاح. وَلَكِن زّشْت ذ وَامَان وضِيڒ وَار ثن تْضيَّاع شَا."<verse eid="REV 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7" />ئِزْمَار نِّي وَامِي يرْزم اَشمَّاع وِيس اَرْبعَا، سْڒِيغ إِ لْمخْلُوْق وِيس اَرْبعَا يقَّار: "أَرَاح-د!" <verse eid="REV 6:7" /><verse number="8" style="v" sid="REV 6:8" />وَامِي خْزَرغ، تْوَاڒِيغ يجّن ن ؤُيِيْس ذ اَوْرَاغ، ونِّي خَاس ينْيِين سمَّان-ث ڒْموْث، ثذْفَار-يث لْأَخِرَا. ثمُّوْش-اَسن سُّلْطَا اَذ نْغن اَرْبَع ن يمزْذَاغ ن ثْمُوْرْث س سِّيف ذ جُّوْع ذ طَّاعُوْن ذ ڒُحُوُش ن ثْمُوْرْث.<verse eid="REV 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9" />ئِزْمَار نِّي وَامِي يرْزم اَشمَّاع وِيس خمْسَا، ࢲْرِيغ سْوَادَّاي إِ ڒْمذْبَح بُوْحْبڒ ن يِنِّي يتْوَانْغن عْلَاحْسَاب اَوَاڒ ن أَربِّـي ذ شْهَاذث إِي شهْذن. <verse eid="REV 6:9" /><verse number="10" style="v" sid="REV 6:10" />سْنكَّرن ثْغُويِّيث س جّْهذ نَّان: "يَا مَوْلَانَا يَا ونِّي عَظِيم يدْجَان ذ ڒْحَقّ، مشْحَاڒ غَا ثكّذ وَار تْحِيْسِيْبذ يمزْذَاغ ن دُّنشْت-أَ، أَثن ثْعَاقْبذ خ يذَامّن نّغ؟" <verse eid="REV 6:10" /><verse number="11" style="v" sid="REV 6:11" />ثُمَّا يمُّوْش-اَسن مَارَّا ئِج-يج، تْشَامِّير ذ اَشمْڒَاڒ يتْوَانَّا-يَاسن عَاذ اَذ تصْبَرم شْوَايْت اَڒ غَا يتْوَاكمّڒ لْعَدَد نِيشَان ن اَيثْمَاثْوم إِي غَا يتْوَانْغن اَمشْنَاو كنِّيو، يعْنِي يِنِّي إِي يعبّْذن اَم كنِّيو.<verse eid="REV 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12" />ࢲْرِيغ يزْمَار نِّي وَامِي يرْزم اَشمَّاع وِيس ستَّا، ڒخْدّنِّي يوْقع يجّن ن زِّنْزَال ذ اَمقّْرَان. ثْفُوْشْت ثذْوڒ ذ ثَبرْشَانْت اَم ڒفْحَم، ثَزِيرِي ثذْوڒ اَم يذَامّن. <verse eid="REV 6:12" /><verse number="13" style="v" sid="REV 6:13" />ئِثْرَان ن وجنَّا وطَّان-د غَار ثْمُوْرْث اَمشْنَاو ثَازَارْث خْمِي ثْوطَّا زِي ثْشجَّارْث خْمِي ت يسنْهزَّا اَرِّيح يجهْذن. <verse eid="REV 6:13" /><verse number="14" style="v" sid="REV 6:14" />أَجنَّا ينجْمع اَم مَامّش يتْوَابلّع يجّن ن لْكِتَاب. يذُوْرَار ذ ثيْزِيرِين مَارَّا نْهزّنْت زݣ ومْشَان نْسنْت.<verse eid="REV 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 6:15" />كَّرن يزدْجِيذن ن ثْمُوْرْث ذ يمقّْرَانن نْسن ذ اَرُّوْيَاس ن ڒْعَسْكَار ذ تْوَاجَر ذ يِنِّي يجهْذن ذ يِنِّي غَارْسن بَاب نْسن ذ يِنِّي غَارْسن لْحُرِّيَا نْسن، رُوْحن مَارَّا تْنُوْفَّرن ذݣ يِيفْرَان ذ جَار يِزْرَا ن يذُوْرَار. <verse eid="REV 6:15" /><verse number="16" style="v" sid="REV 6:16" />نِثْنِي قَّارن إِ يذُوْرَار ذ يِزْرَا: "وْضَام-د خَانغ، سْنُوْفَّرم-اَنغ زݣ وُوْذم ن ونِّي يقِّيمن خ لْعَرْش ذ لْعِقَاب إِي غَا يݣّ يِزْمَار. <verse eid="REV 6:16" /><verse number="17" style="v" sid="REV 6:17" />أَقَا يُوْسَا-د لْيَوْم اَمقّْرَان ن لْعِقَاب نْسن، ؤُݣ يزمَّرن اَذ يبدّ؟"<verse eid="REV 6:17" /></para>
  <chapter eid="REV 6" />
  <chapter number="7" style="c" sid="REV 7" />
  <para style="s">أَربِّـي يضبّع مِيَّا أُو اَرْبعَا أُو اَرْبعِين اَڒْف ن يِوْذَان</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1" />منْبَعْد إِ مَانَايَا ࢲْرِيغ اَرْبعَا ن لْمَلَائِكَاث بدّنْت خ اَرْبعَا ن ثْغمُّوْرَا ن ثْمُوْرْث، طّْفنْت اَرِّيح خ اَرْبعَا ن جِّهَاث ن ثْمُوْرْث حمَا وَار يتْصُوْض شَا خ ڒْبَرّ ؤُڒَا خ ڒبْحَر ؤُڒَا خ ڒْشجُّوْر. <verse eid="REV 7:1" /><verse number="2" style="v" sid="REV 7:2" />ࢲْرِيغ يجّن ن لْمَلَاك نّغْنِي يتْݣَعَّاذ-د زِي شَّرْق ييْسِي-د طَّابَع ن أَربِّـي يدَّرن، ئِڒَاغَا س يِجّن ن ثْمِيجَّا ثجْهذ إِ اَرْبعَا ن لْمَلَائِكَاث نِّي ثِنِّي ؤُمِي يمُّوْش جّْهذ حمَا اَذ ضيّْعنْت ڒْبَرّ ذ ڒبْحَر. <verse eid="REV 7:2" /><verse number="3" style="v" sid="REV 7:3" />ينَّا-ٱسنْت: "وَار تْضيَّاعنْت نِي ڒْبَرّ نِي ذ ڒبْحَر نِي ذ ڒْشجُّوْر حتَّا غَا نضْبع ثَنْيَارْث<note caller="+" style="f"><char style="fr" closed="false">7‏.3 </char><char style="ft" closed="false">ثَنْيَارْث نتَّاث ذ ثَوَارْنَا.</char></note> ن يِنِّي يعبّْدن أَربِّـي." <verse eid="REV 7:3" /><verse number="4" style="v" sid="REV 7:4" />سْڒِيغ إِ مشْحَاڒ يتْوَاضبْعن: مِيَّا أُو اَرْبعَا أُو اَرْبعِين اَڒَاف زِي مَارَّا ثِقبَّاڒ ن أَيث-إِسْرَائِيل. <verse eid="REV 7:4" /><verse number="5" style="v" sid="REV 7:5" />ثنْعَاشَر اَڒَاف زِي أَيث-يَهُوْذَا، ثنْعَاشَر اَڒَاف زِي أَيث-رَابِين، ثنْعَاشَر اَڒَاف زِي أَيث-جَاد، <verse eid="REV 7:5" /><verse number="6" style="v" sid="REV 7:6" />ثنْعَاشَر اَڒَاف زِي أَيث-عَشُوْر، ثنْعَاشَر اَڒَاف زِي أَيث-نَفْتَالِي، ثنْعَاشَر اَڒَاف زِي أَيث-مَنَاسِي، <verse eid="REV 7:6" /><verse number="7" style="v" sid="REV 7:7" />ثنْعَاشَر اَڒَاف زِي أَيث-شِمْعُوْن، ثنْعَاشَر اَڒَاف زِي أَيث-لَاوِي، ثنْعَاشَر اَڒَاف زِي أَيث-شَكِير، <verse eid="REV 7:7" /><verse number="8" style="v" sid="REV 7:8" />ثنْعَاشَر اَڒَاف زِي أَيث-زَفُلُوْن، ثنْعَاشَر اَڒَاف زِي أَيث-يُوْسف، ثنْعَاشَر اَڒَاف زِي أَيث-بنْيَامِين.<verse eid="REV 7:8" /></para>
  <para style="s">أَطَّاس ن ڒْغَاشِي س وَارُّوْض ذ اَشمْڒَاڒ</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9" />منْبَعْد إِ مَانَايَا خْزَرغ، تْوَاڒِيغ اَطَّاس ن ڒْغَاشِي مبْڒَا ڒحْسَاب زِي مْكُڒ ڒْݣنْس ذ ڒْقُوْم ذ شَّعْب ذ لُّغَا، بدّن زَّاث إِ لْعَرْش ذ زَّاث إِ يِزْمَار ݣِّين تْشَامِّير ذ اَشمْڒَاڒ، ذݣ يفَاسّن نْسن ثَسطَّا ن تْمَر. <verse eid="REV 7:9" /><verse number="10" style="v" sid="REV 7:10" />سْنكَّرن ثْغُويِّيث س جّْهذ قَّارن: "أَربِّـي نّغ إِݣ يقِّيمن خ لْعَرْش نتَّا ذ يِزْمَار غَارْسن ثِزمَّار اَذَانغ سْنجْمن."<verse eid="REV 7:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="REV 7:11" />مَارَّا لْمَلَائِكَاث بدّنْت نّْضنْت-يد إِ لْعَرْش ذ يمْغَارن ذ اَرْبعَا ن لْمخْلُوْقَاث نِّي. هْوَانْت خ وغمْبُوْب نْسنْت زَّاث إِ لْعَرْش سجْذنْت إِ أَربِّـي. <verse eid="REV 7:11" /><verse number="12" style="v" sid="REV 7:12" />قَّارنْت: "آمِين! لْحَمد ذ لْعَظَمَا ذ لْحِكْمَا ذ شُّكر ذ ؤُوقَّار ذ ثْزمَّار ذ جّْهذ إِ أَربِّـي نّغ إ ڒبْدَا ن ڒبْدَاث. آمِين!"<verse eid="REV 7:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13" />ينَّا-ٱيِي يِجّن زݣ يمْغَارن-أَ: "مَا ثسّْنذ يِوْذَان-أَ إِي ݣِّين تْشَامِّير ذ اَشمْڒَاڒ مِين عْنَان ذ مَانِس د ؤُسِين؟"<verse eid="REV 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14" />جَاوْبغ-ث نِّيغ-اَس: "ذ شك إِي يسّْنن آ سِيذِي."</para>
  <para style="p" vid="REV 7:14">ينَّا-ٱيِي: "يِيْنَا ذ يِنِّي ينجْمن زِي ڒْمِحْنث ثَمقّْرَانْت، صبّْنن يتْشَامِّيرن نْسن س يذَامّن ن يِزْمَار اَرِّين-ثن ذ يشمْڒَاڒن. <verse eid="REV 7:14" /><verse number="15" style="v" sid="REV 7:15" />س مَانَايَا اَقَاثن زَّاث إِ لْعَرْش ن أَربِّـي، عبّْذن-ث دْجِيرث ذ نْهَار ذِي ثمْزِيذَا ثَمقّْرَانْت نّس. ونِّي يقِّيمن خ لْعَرْش اَثن يحْضَا. <verse eid="REV 7:15" /><verse number="16" style="v" sid="REV 7:16" />وَار تْڒِيزِين وَار تْفِيذِين، وَار ثن تْسشْمِيض ثْفُوْشْت ؤُڒَا ذ ڒحْمُو. <verse eid="REV 7:16" /><verse number="17" style="v" sid="REV 7:17" />ڒَاحقَّاش يزْمَار إِي يدْجَان ذِي ڒْوسْط ن لْعَرْش اَثن يَرْوس، اَثن يَاوِي اَكِذس غَار مَانِي دْجَان ڒَعْنَاصر ن وَامَان ن ثُوْذَارْث. أَربِّـي اَذ يمْسح كُڒ اَمطَّاو زِي ثِيطَّاوِين نْسن."<verse eid="REV 7:17" /></para>
  <chapter eid="REV 7" />
  <chapter number="8" style="c" sid="REV 8" />
  <para style="s">أَشمَّاع وِيس سبْعَا</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1" />ئِزْمَار وَامِي يرْزم اَشمَّاع وِيس سبْعَا، ينقْضع ڒْحسّ ذݣ وجنَّا شَان ؤُزْين ن ثْسَعَّات. <verse eid="REV 8:1" /><verse number="2" style="v" sid="REV 8:2" />ࢲْرِيغ سبْعَا ن لْمَلَائِكَاث إِي يتْبدَّان زَّاث إِ أَربِّـي، يمُّوْش-اَسنْت سبْعَا ن زّْوَامَّار.<verse eid="REV 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3" />يُوْسَا-د يجّن ن لْمَلَاك نّغْنِي يبدّ غَار ڒْمذْبَح، ئِيْسِي-د ثِمجْمَارْث نِّي يتْوَاصنْعن س دّْهب. ئِمُّوْش-اَس اَطَّاس ن تْبَخُوْر حمَا اَذ يقدّم تْبَخُوْر نِّي اَك ثْࢲَادْجِيث ن ڒْمُوْمِنِين صَّالِحِين خ ڒْمذْبَح ن دّْهب يدْجَان زَّاث إِ لْعَرْش. <verse eid="REV 8:3" /><verse number="4" style="v" sid="REV 8:4" />دّخَان ن تْبَاخُوُر-أَ اَك ثࢲَادْجِيث ن ڒْمُوْمِنِين صَّالِحِين يݣَعّذ زݣ وفُوْس ن لْمَلَاك-أَ وَانِيتَا غَار وجنَّا زَّاث إِ أَربِّـي. <verse eid="REV 8:4" /><verse number="5" style="v" sid="REV 8:5" />ئِيْسِي لْمَلَاك-أَ ثِمجْمَارْث نِّي ن تْبَخُوْر، يعمَّر-يت س ثْمسِّي ن ڒْمذْبَح، ئِزدْجع-يت غَار ثْمُوْرْث. يوْقع وَاجَّاج ذ يغُوْيَان ذ وَاسَّام ذ زِّنْزَال.<verse eid="REV 8:5" /></para>
  <para style="s">سبْعَا ن زّْوَامَّار</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6" />سبْعَا ن لْمَلَائِكَاث نِّي إِي غَار دْجَانْت سبْعَا ن زّْوَامَّار سوْجَاذنْت يخف نْسنْت حمَا اَذَايْسن صُوْضنْت. <verse eid="REV 8:6" /><verse number="7" style="v" sid="REV 8:7" />ثكَّر لْمَلَائِكَا ثَمزْوَارُوْت ثْصُوْض ذِي زَّمَّار نّس أُوْشَا يُوْسَا-د يشَرَّا<note caller="+" style="f"><char style="fr" closed="false">8‏.7 </char><char style="ft" closed="false">ئِشَرَّا نتَّا ذ اَڬَرَّا.</char></note> ذ ثْمسِّي مْخلّْطن اَك يذَامّن منْضَارن غَار ثْمُوْرْث. ثشْمض تُلُث ن ثْمُوْرْث ذ تُلُث ن ڒْشجُّوْر ذ مَارَّا اَربِيع اَزيْزَا.<verse eid="REV 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8" />ثكَّر لْمَلَائِكَا وِيس ثْنَاين ثْصُوْض ذِي زَّمَّار نّس أُوْشَا ثمنْضَار-د شَان ڒْحَاجث ذِي ڒبْحَر اَمشْنَاو شَان وذْرَار ذ اَمقّْرَان يتْشعَّاڒ س ثْمسِّي. تُلُث ن ڒبْحَر يذْوڒ ذ يذَامّن. <verse eid="REV 8:8" /><verse number="9" style="v" sid="REV 8:9" />تُلُث ن لْمخْلُوقَاث إِݣ يتعِيشَان ذِي ڒبْحَر مُّوْثن، تُلُث ن يغَرُّوْبَا تْوَارْزن.<verse eid="REV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10" />ثكَّر لْمَلَائِكَا وِيس تْڒَاثَا ثْصُوْض ذِي زَّمَّار نّس أُوْشَا يوْضَا-د يجّن ن يِيثْرِي ذ اَمقّْرَان زݣ وجنَّا يتْشعَّاڒ اَمشْنَاو اَسْفض. ئِوْضَا-د خ تُلُث ن يِغزْرَان ذ ڒَعْنَاصر ن وَامَان. <verse eid="REV 8:10" /><verse number="11" style="v" sid="REV 8:11" />ئِثْرِي نِّي قَّارن-اَس شِّيح. تُلُث ن وَامَان نِّي ذوْڒن ذ يمرْزَاݣن. أَطَّاس زݣ يِنِّي يسْوِين زَّايْسن مُّوْثن مِينْزِي اَمَان نِّي ذ يمَرْزَاݣن.<verse eid="REV 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12" />ثكَّر لْمَلَائِكَا وِيس اَرْبعَا ثْصُوْض ذِي زَّمَّار نّس أُوْشَا تُلُث ن ثْفُوْشْت ذ ثْزِيرِي ذ يِيثْرَان تْوَاسنْهزّن حمَا تُلُث نِّي اَذ تِيڒِي ذ ثَادْجسْت، أَذ تنْقس يجّن ن تُلُث ن ثْفَاوْث ذِي نْهَار ؤُڒَا ذ دْجِيڒث. <verse eid="REV 8:12" /><verse number="13" style="v" sid="REV 8:13" />خْزَرغ، سْڒِيغ إِ يِجّن ن نْسر يطَّاو ذِي ڒْوسْط ن وجنَّا يڒَاغَا س جّْهذ ينَّا: "يَا تَمَارَا، يَا تَمَارَا، يَا تَمَارَا خ يمزْذَاغ ن ثْمُوْرْث عْلَاحْسَاب ثْڒَاثَا ن لْمَلَائِكَاث نِّي إِݣ يقِّيمن عَاذ وَار صُوْضنْت شَا ذِي زّْوَامَّار نْسنْت".<verse eid="REV 8:13" /></para>
  <chapter eid="REV 8" />
  <chapter number="9" style="c" sid="REV 9" />
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1" />ثكَّر لْمَلَائِكَا وِيس خمْسَا ثْصُوْض ذِي زَّمَّار نّس أُوْشَا ࢲْرِيغ يجّن ن يِيثْرِي تُوْغَا يوْضَا-د زݣ وجنَّا خ ثْمُوْرْث. ئِمُّوْش-اَس <char style="it">إِ يِيثْرِي نِّي</char> ڒْمفْتَاح ن وَانُو نِّي يتَاوِين غار ڒَادْجغ بْڒَا ڒَاحدّ. <verse eid="REV 9:1" /><verse number="2" style="v" sid="REV 9:2" />يرْزم اَنُو نِّي يتَاوِين غَار ڒَادْجغ بْڒَا ڒَاحدّ، يُوْڒِي-د زَّايس دّخَّان اَمشْنَاو دّخَّان ن يِجّن ن ڒْكُوْشث ذ ثَمقّْرَانْت. دّخَّان ن ڒَادْجغ نِّي يغطَّا ثْفُوْشْت ذ لْجُو. <verse eid="REV 9:2" /><verse number="3" style="v" sid="REV 9:3" />زِي دّخَان-أَ ثفّْغ-د سّنِّي ثْمُوْرْغِي غَار ثْمُوْرْث، يمُّوْش-اَسنْت جّْهذ اَم ثْغِيرْذمِيوِين ن ثْمُوْرْث. <verse eid="REV 9:3" /><verse number="4" style="v" sid="REV 9:4" />نَّان-اَسنْت وَار تْضيَّاعنْت اَربِيع ن ثْمُوْرْث ؤُڒَا ذ مِين يدْجَان ذ اَزيْزَا ؤُڒَا ذ ڒْشجُّوْر، غِير يوْذَان نِّي إِي وَار غَار يدْجِي شَا طَّابَع ن أَربِّـي خ ثنْيَارْث<note caller="+" style="f"><char style="fr" closed="false">9‏.4 </char><char style="ft" closed="false">ثَنْيَارْث نتَّاث ذ ثَوَارْنَا.</char></note> نْسن. <verse eid="REV 9:4" /><verse number="5" style="v" sid="REV 9:5" />مَاشِي مسْمُوْح اَثن نْغنْت، وَلَكِن اَثن عدّْبنْت خمْس شْهُوْر. ڒَعْذَاب-أَ إي تݣّنْت اَمشْنَاو ثِغِيرْذمِيوِين خْمِي تقّْسنْت إِ بْنَاذم. <verse eid="REV 9:5" /><verse number="6" style="v" sid="REV 9:6" />ذِي ڒْوقْث نِّي اَذ اَرْزُوْن يِوْذَان خ ڒْموْث وَار ت تِيفن شَا، أَذ تَّارن ڒْموْث اَزَّايْسن ثَرْوڒ.<verse eid="REV 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7" />ثْمُوْرْغِي-يَا تْشَابَّاه ذݣ يِيْسَان نِّي إِي وجْذن اَذ حَرْبن. غَارْسنْت خ يزدْجِيفن نْسنْت اَم تَّاج ن دّْهب، أَغمْبُوْب نْسنْت اَم وغمْبُوْب ن بْنَاذم. <verse eid="REV 9:7" /><verse number="8" style="v" sid="REV 9:8" />غَارسنْت اَشوَّاف اَمشْنَاو اَشوَّاف ن ثمْغَارِين. ثِغْمَاس نْسنْت اَمشْنَاو ثِغْمَاس ن سّْبَع. <verse eid="REV 9:8" /><verse number="9" style="v" sid="REV 9:9" />ثِيجِيلِيثِين نْسنْت ݣِّينْت اَم ثِيجِيلِيثِين ن ڒحْذِيذ. سّْدَع ن وَافْرِيْون نْسنْت يݣَّا اَم سّْدَع ن وَاطَّاس ن يكَارُّوْثن ن يِيْسَان إِي تَازّْڒن غَار ڒْحَرْب. <verse eid="REV 9:9" /><verse number="10" style="v" sid="REV 9:10" />غَارْسنْت ثِيشّط اَم ثنِّي ن ثْغِيرْذنْت، تقّْسنْت زَّايس. غَارْسنْت جّْهذ اَذ ضَرّْنت يوْذَان خمْس شْهُوْر س ثِيشّط نِّي. <verse eid="REV 9:10" /><verse number="11" style="v" sid="REV 9:11" />أَزدْجِيذ نْسنْت نتَّا ذ لْمَلَاك ن ڒَادْجغ بْڒَا ڒَاحدّ، س لْعِبْرِيَا قَّارن-اَس أَبَدُّوْن، س ثْيُوْنَانِيث قَّارن-اَس أَبُوْلْيُوْن.<verse eid="REV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12" />ثعْذُو تَمَارَا ثَمزْوَارُوْت، عَاذ اَذ د اَسنْت ثْنَاين نّغْنِي.<verse eid="REV 9:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13" />ثكَّر لْمَلَائِكَا وِيس ستَّا ثْصُوْض ذِي زَّمَّار نّس أُوْشَا سْڒِيغ إِ يِجّن ن ثْمِيجَّا ثنْدق-د زِي اَرْبعَا نِّي ن وَاشَّاون<note caller="+" style="f"><char style="fr" closed="false">9‏.13 </char><char style="ft" closed="false">أَشَّاون نِثْنِي ذ يقَاشَّاون ن لْحَيَوَان.</char></note> ن ڒْمذْبَح ن دّْهب إِي يدْجَان زَّاث إِ أَربِّـي. <verse eid="REV 9:13" /><verse number="14" style="v" sid="REV 9:14" />ثنَّا-ٱس ثْمِيجَّا نِّي إ لْمَلَائِكَا وِيس ستَّا إِي غَار ثدْجَا زَّمَّار: "ضْڒق-د إِ اَرْبعَا ن لْمَلَائِكَاث يتْوَاشدّن ذݣ يِغْزَار ن لْفُوْرَات اَمقّْرَان." <verse eid="REV 9:14" /><verse number="15" style="v" sid="REV 9:15" />أُوْشَا تْوَاضڒْقنْت-يد اَرْبعَا-يَا ن لْمَلَائِكَاث إِي تُوْغَا تْوَاسّوْجْذنْت إِ ثْسَعَّات-أَ ذ نْهَار-أَ ذ شْهَار-أَ ذ وسݣّْوَاس-أَ حمَا اَذ نْغنْت تُلُث ن يِوْذَان. <verse eid="REV 9:15" /><verse number="16" style="v" sid="REV 9:16" />سْڒِيغ خ لْعَدَد ن ڒْعَسْكَار إِي ينْيِين خ يِيْسَان: لْعَدَد نْسن مِيَّاتَاين مِلْيُوْن.<verse eid="REV 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 9:17" />ࢲْرِيغ ذي لْوَحِي-يَا ينُو ييْسَان ذ يِنِّي خَاسن ينْيِين، غَارْسن ثِيجِيلِيثِين ن ڒحْذِيذ ذ ثِزݣّْوَاغِين اَم ثْمسِّي، ذ ثِزيْزَاوِين اَم لْيَقُوْت، ذ ثِوْرَاغِين اَم ڒكْبْرِيْيث. ئِزدْجِيفن ن يِيْسَان-أَ اَم وزدْجِيف ن سّْبَاع، تفّغ-د زݣ وقمُّوْم نْسن ثْمسِّي ذ دّخَّان ذ ڒكْبْرِيْيث. <verse eid="REV 9:17" /><verse number="18" style="v" sid="REV 9:18" />مُّوْثن تُلُث ن يِوْذَان س ثْڒَاثَا ن لْمُصِيبَاث-أَ يعْنِي س ثْمسِّي ذ دّخَّان ذ ڒكْبْرِيْيث إِي د يتفّْغن زݣ وقمُّوْم نْسن. <verse eid="REV 9:18" /><verse number="19" style="v" sid="REV 9:19" />جّْهذ ن يِيْسَان-أَ اَقَاث ذݣ وقمُّوْم نْسن ذ يعنَّابن نْسن. ئِعنَّابن نْسن تْشَابَّاهن ذݣ يفِيغرَان، تْضَرَّان س يزدْجِيفن نْسن.<verse eid="REV 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20" />وَلَكِن يِوْذَان إِݣ ينجْمن زِي لْمُصِيبَاث-أَ وَار تُوْبن شَا س مِين ݣِّين س يفَّاسن نْسن. قِّيمن عَاذ عبّْذن شَّيَاطِن ذ لْأَصْنَام ن دّْهب ذ نُّقَارْث ذ نّحَّاس ذ وزْرُو ذ وكشُّوْض إِي وَار يتْوِيڒِين شَا إِي وَار يتْسْڒِين شَا إِي وَار يݣُّوْرن شَا. <verse eid="REV 9:20" /><verse number="21" style="v" sid="REV 9:21" />وَار تُوْبن شَا وَامِي نْغِين يوْذَان نِغ وَامِي ݣِّين سّْحُوْر ذ لْفَسَاد ذ ثُوْكَّارْدَا.<verse eid="REV 9:21" /></para>
  <chapter eid="REV 9" />
  <chapter number="10" style="c" sid="REV 10" />
  <para style="s">لْمَلَاك اَك لْكِتَاب اَمزْيَان</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1" />ࢲْرِيغ يجّن ن لْمَلَاك نّغْنِي يجهْذ يهْوَا-د زݣ وجنَّا، ئِنّض-اَس-د وسيْنُو. خ وزدْجِيف نّس يجّن ن ثسْڒِيث ن ونْࢲَار، أَغمْبُوْب نّس يݣَّا اَم ثْفُوْشْت، ئِضَارن نّس ݣِّين اَم يـپِــيلَارن ن ثْمسِّي. <verse eid="REV 10:1" /><verse number="2" style="v" sid="REV 10:2" />ئِيْسِي ذݣ وفُوْس نّس يجّن ن لْكِتَاب ذ اَمزْيَان يرْزم. ئِسرْس ضَار نّس اَفُوْسِي خ ڒبْحَر، عَاوذ ذ ضَار نّس أَࢲڒْمَاض خ ڒْبَرّ. <verse eid="REV 10:2" /><verse number="3" style="v" sid="REV 10:3" />ئِسْغُوْي س جّْهذ اَخْمِي يهِيرِّيو يجّن ن سّْبَاع. وَامِي يسْغُوْي، أَرِّين-د خَاس سبْعَا ن وَاجَّاجن س صُّوْت نْسن. <verse eid="REV 10:3" /><verse number="4" style="v" sid="REV 10:4" />وَامِي د اَرِّين سبْعَا نِّي ن وَاجَّاجن، نش خْسغ اَذ اَرِيغ مَانَاينِّي وَلَكِن سْڒِيغ إِ يِجّن ن ثْمِيجَّا زݣ وجنَّا ثنَّا-ٱيِي-د: "لَّا، مِين نَّان سبْعَا-يَا ن وَاجَّاجن اجّ-يث غَارك ذ سِّرّ، وَار ث تَارِي شَا."<verse eid="REV 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5" />زْرِيغ لْمَلَاك نِّي يبدّن خ ڒبْحَر ذ ڒْبَرّ ييْسِي فُوْس نّس اَفُوْسِي غَار وجنَّا. <verse eid="REV 10:5" /><verse number="6" style="v" sid="REV 10:6" />ئِجُّوْدْج س ونِّي يدَّرن إِ ڒبْدَا ن ڒبْدَاث يعْنِي ونِّي إِي د يخڒْقن اَجنَّا ذ مِين ذَايس ذ ڒْبَرّ ذ ڒبْحَر ذ مِين ذَايْسن. أُوْشَا ينَّا: "صَافِي، وَار ثقِّيم بُو ڒْوقْث عَاذ كْتَار. <verse eid="REV 10:6" /><verse number="7" style="v" sid="REV 10:7" />أَقَا ذِي نْهُوْرَاث نِّي خْمِي غَا ثْصُوْض لْمَلَائِكَا وِيس سبْعَا ذِي زَّمَّار نّس قَا صَافِي سِّرّ ن أَربِّـي يكمّڒ مَامّش ذَاسن ث يعَوذ إِ لْعِبَاد نّس لأَنْبِيَا."<verse eid="REV 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8" />ثْمِيجَّا نِّي ؤُمِي سْڒِيغ زݣ وجنَّا زِي قْبڒ ثنْدق-د عَاوذ ثسِّيوڒ-د اَكِذِي وِيس مَرّْثَاين ثنَّا-ٱيِي-د: "رُوْح، إِيْسِي لْكِتَاب نِّي يرْزْمن ذݣ وفُوْس ن لْمَلَاك إِݣ يبدّن خ ڒبْحَر ذ ڒْبَرّ."<verse eid="REV 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9" />رُوْحغ غَار لْمَلَاك نِّي نِّيغ-اَس: "ؤُش-اَيِي-د لْكِتَاب نِّي اَمزْيَان!" ينَّا-ٱيي: "أَقَاث، اشّ-يث. أَذ يِيڒِي ذݣ وعدِّيس نّش ذ اَمرْزَاݣ، وَلَكِن ذݣ وقمُّوْم نّش نتَّا ذ مِيزِيض اَم ثَامّنْت." <verse eid="REV 10:9" /><verse number="10" style="v" sid="REV 10:10" />يْسِيِغ لْكِتَاب نِّي اَمزْيَان زݣ وفُوْس نّس، شِّيغ-ث. ؤُفِيغ-ث ذݣ وقمُّوْم ينُو ذ مِيزِيض اَم ثَامّنْت. وَلَكِن وَامِي ث سغْڒِيغ يذْوڒ ذ اَمرْزَاݣ ذݣ وعدِّيس ينُو. <verse eid="REV 10:10" /><verse number="11" style="v" sid="REV 10:11" />ڒخْدّنِّي يتْوَانَّا-ٱيِي: "أُو لَابُد اَذ تسِّيوْڒذ عَاوذ س مِين يوْحَا أَربِّـي خ وَاطَّاس ن شُّعُوْب ذ ڒݣْنُوْس ذ لُّغَاث ذ يزدْجِيذن."<verse eid="REV 10:11" /></para>
  <chapter eid="REV 10" />
  <chapter number="11" style="c" sid="REV 11" />
  <para style="s">ثْنَاين ن ڒشْهُوْذ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1" />ئِمُّوْشَا-اَيِي يجّن ن وغَانِيم اَم ذ ڒَعْبَار ينَّا-ٱيِي يجّن: "كَّر، عْبَر ثَمْزِيذَا ثَمقّْرَانْت ن أَربِّـي ذ ڒْمذْبَح، حْسب شْحَاڒ إِي عبّْذن ذِنِّي. <verse eid="REV 11:1" /><verse number="2" style="v" sid="REV 11:2" />وَلَكِن ڒمْرَاح يدْجَان غَار بَرَّا إِ ثمْزِيذَا اجّ-يث وَاحْذس، وَار ث تعْبَار شَا ڒَاحقَّاش يمُّوْش-اَسن إِ ڒݣْنُوْس. أَذ عفّْسن<note caller="+" style="f"><char style="fr" closed="false">11‏.2 </char><char style="ft" closed="false">عفّس يخس اَذ يِينِي عْجن.</char></note> ثَنْدِينْت يقدّْسن ذِي ثْنَاين أُو اَرْبعِين ن شْهُوْرَاث. <verse eid="REV 11:2" /><verse number="3" style="v" sid="REV 11:3" />أَذ سّكّغ ثْنَاين ن ڒشْهُوْذ ينُو اَذ ݣّن اَرُّوْض ن لْحُزن اَذ خْبَرن يوْذَان س مِين عڒْمن زي أَربِّـي اَڒَاف أُو مِيَّاتَاين أُو ستِّين يُوْم." <verse eid="REV 11:3" /><verse number="4" style="v" sid="REV 11:4" />ڒشْهُوْذ نِّي نِثْنِي ذ ثْنَاين ن ڒْشجُّوْر ن زِّيتُوْن، أُو عَاوذ نِثْنِي ذ ثْنَاين ن ڒقْنَاذڒ إِݣ يبدّن زَّاث إِ سِيذِي أَربِّـي ن دُّنشْت-أَ. <verse eid="REV 11:4" /><verse number="5" style="v" sid="REV 11:5" />مڒَا شَان يِجّن يرْزُو اَذ يضَرّ ڒشْهُوْذ نِّي، أَتَاف اَذ تفّغ ثْمسِّي زݣ ؤُقمُّوْم نْسن اَذ تشّ ڒْعَذْيَان نْسن. مڒَا شَان يجّن يرْزُو اَثن يضَرّ، أَمنِّي إِي غَا يمّث. <verse eid="REV 11:5" /><verse number="6" style="v" sid="REV 11:6" />ذِي ڒِيَّامَاث نِّي إِي ذِي غَا خْبَرن ڒشْهُوْذ-أَ س مِين عڒْمن زِي أَربِّـي اَتَاف اَغَارْسن ثِيڒِي سُّلْطَا زِي غَا بلّْعن اَجنَّا وَار د يشِّيْث بُو ونْࢲَار قَاع. أَتَاف عَاوذ اَغَارْسن ثِيڒِي سُّلْطَا اَذ اَرّن اَمَان ذ يذَامّن اَذ ضڒْقن إِ مَارَّا لْمُصِيبَاث خ ثْمُوْرْث مڒْمِي مَا خْسن.<verse eid="REV 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7" />خْمِي غَا كمّْڒن ڒخْبَار نْسن إِي زِي غَا شهْذن، أَذ د يݣَعّذ ڒْوَحْش زِي ڒَادْجغ بْڒَا ڒَاحدّ اَثن يحَارب، أَثن يغْڒب، أَذ ينغ ڒشْهُوْذ نِّي. <verse eid="REV 11:7" /><verse number="8" style="v" sid="REV 11:8" />أَذ تقِّيم دَّات نْسن ذِي شَّارِع ن ثنْدِينْت ثَمقّْرَانْت ؤُمِي قَّارن س ڒْمَعْنَا سَدُوْم نِغ مِصْرَا يعْنِي مَانِي يتْوَاصلّب سِيذِيثْسن. <verse eid="REV 11:8" /><verse number="9" style="v" sid="REV 11:9" />ئِوْذَان زِي مْكُڒ شَّعْب ذ ڒْقُوْم ذ لُّغَا ذ ڒْݣـنُس اَذَايْسن خْزَرن ذِي دَّات نْسن ثڒْتِيَّام ذ ؤُزْين، وَار تجِّين حَدّ اَذ ينْضڒ ڒشْهُوْذ-أَ. <verse eid="REV 11:9" /><verse number="10" style="v" sid="REV 11:10" />يمزْذَاغ ن ثْمُوْرْث اَذ فَرْحن اَذ زْهُوْن س ڒْموْث نْسن. أَذ ؤُشن يكَادُوْثن إِ وَايَاوْيَا ڒَاحقَّاش لْأَنْبِيَا نِّي س ثْنَاين، <char style="it">يعْنِي ڒشْهُوْذ نِّي</char>، عدّْبن اَطَّاس يمزْذَاغ ن ثْمُوْرْث.<verse eid="REV 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 11:11" />وَامِي ثعْذُو تڒْتِيَّام ذ ؤُزْين نِّي، يُوْذف ذَايْسن يجّن ن بُوْحْبڒ زِي أَربِّـي ذِي ڒشْهُوْذ-أَ، كَّرن بدّن خ يضَارن نْسن. ينِّي ثن يࢲْرِين ثُوْذف ذَايْسن ثِيݣّْوْذِي ذ ثَمقّْرَانْت. <verse eid="REV 11:11" /><verse number="12" style="v" sid="REV 11:12" />سْڒِين إِ يِجّن ن ثْمِيجَّا ثجْهذ تْڒَاغَا-د خَاسن زݣ وجنَّا ثقَّار-اَسن: "ݣَعّْذم-د ذَانِيتَا!" ڒشْهُوْذ نِّي ݣَعّْذن غَار وجنَّا ذݣ وسيْنُو، ڒْعَذْيَان نْسن خْزَرن ذَايْسن. <verse eid="REV 11:12" /><verse number="13" style="v" sid="REV 11:13" />ذِي ڒْوقْث نِّي يوْقع يجّن ن زِّنْزَال ذ اَمقّْرَان، ثْنهْذم عشْرَا ذِي مِيَّا زِي ثنْدِينْت. مُّوْثن ذِي زِّنْزَال-أَ سبْعَاڒَاف ن يِوْذَان. يِنِّي يقِّيمن ݣّْوْذن، بْذَان سمْغَارن أَربِّـي إِݣ يدْجَان ذݣ وجنَّا. <verse eid="REV 11:13" /><verse number="14" style="v" sid="REV 11:14" />ثعْذُو تَمَارَا وِيس ثْنَاين، ثنِّي وِيس ثْڒَاثَا عْڒَاين اَذ د تَاس.<verse eid="REV 11:14" /></para>
  <para style="s">زَّمَّار وِيس سبْعَا</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15" />ثكَّر لْمَلَائِكَا وِيس سبْعَا ثْصُوْض ذِي زَّمَّار نّس، أُوْشَا ثِمِيجَّاوِين ذݣ وجنَّا قَّارنْت س جّْهذ: "ئِذْوڒ ڒحْكَام ن دُّنشْت-أَ ذݣ يفَاسّن ن سِيذِي أَربِّـي نّغ ذ لْمَسِيح نّس، اَذ يحْكم إِ ڒبْدَا ن ڒبْدَاث." <verse eid="REV 11:15" /><verse number="16" style="v" sid="REV 11:16" />كَّرن اَرْبعَا أُو عِشْرِين نِّي يمْغَارن إِي قِّيمن خ لْعَرْشَاث نْسن زَّاث إِ أَربِّـي، هْوَان خ وغمْبُوْب نْسن سجّْذن-اَس إِ أَربِّـي، <verse eid="REV 11:16" /><verse number="17" style="v" sid="REV 11:17" />قَّارن:</para>
  <para style="q1" vid="REV 11:17">"نتْشكَّر-يشك آ سِيذِي أَربِّـي إِݣ يزمَّرن إِ كُڒْشِي،</para>
  <para style="q2" vid="REV 11:17">شك إِݣ يدْجَان، شك إِي تُوْغَا يدْجَان،</para>
  <para style="q1" vid="REV 11:17">ڒَاحقَّاش ثسْخذْمذ جّْهذ نّش، ثبْذِيذ تْحكّْمذ.<verse eid="REV 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18" />ڒݣْنُوْس غضْبن، يُوْوض-د وغْضَب نّش.</para>
  <para style="q2" vid="REV 11:18">يُوْوض-د نْهَار ن لْحِسَاب ذ لْعِقَاب ن يِنِّي يمُّوْثن.</para>
  <para style="q1" vid="REV 11:18">اَذ تْجَازِيذ يِنِّي ذَاش يخدّْمن يعْنِي لأَنْبِيَا ذ ڒْمُوْمِنِين نّش صَّالِحِين،</para>
  <para style="q2" vid="REV 11:18">ذ ينِّي يتْوقَّارن يسم نّش س يمزْيَانن ذ يمقّْرَانن.</para>
  <para style="q1" vid="REV 11:18">أَذ تقْضِيذ خ يِنِّي يسفْسَاذن ثَمُوْرْث."<verse eid="REV 11:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19" />ثْنُوْرْزم ثمْزِيذَا ثَمقّْرَانْت ن أَربِّـي ذݣ وجنَّا، يمظْهَار-د تَابُوْت<note caller="+" style="f"><char style="fr" closed="false">11‏.19 </char><char style="ft" closed="false">تَابُوت نتَّا ذ يجّن ن صّنْدُوْق وكشُّوْض يشلّل س دّْهب. ذَايس شَان ثْمسْڒَايِين زِي زْمَان ن سِيذْنَا مُوْسَى.</char></note> ن ڒْعَهذ ن أَربِّـي ذِي ثمْزِيذَا نِّي. ئِوْقع وَاسَّام ذ يغُوْيَان ذ وَاجَّاج ذ زِّنْزَال ذ يشَرَّا<note caller="+" style="f"><char style="fr" closed="false">11‏.19 </char><char style="ft" closed="false">ئِشَرَّا نتَّا ذ اَڬَرَّا.</char></note> اَطَّاس.<verse eid="REV 11:19" /></para>
  <chapter eid="REV 11" />
  <chapter number="12" style="c" sid="REV 12" />
  <para style="s">ثَمْغَارْث أُو ذ يجّن ن ڒْوَحْش اَم دَّيْنَاصُوْر</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1" />ثْمظْهَار-د يجّن ن لْعَلَامَا ذݣ وجنَّا ذ ثَمقّْرَانْت، يعْنِي ثَمْغَارْث ثنّض-اَس-د ثْفُوْشْت، سْوَادَّاي يضَارن نّس ثَزِيرِي، خ وزدْجِيف نّس يجّن ن تَّاج ذَايس ثنْعَاش ن يِيثْرَان. <verse eid="REV 12:1" /><verse number="2" style="v" sid="REV 12:2" />أَقَات س وعدِّيس ثسْغُوْيِو س ڒحْرِيق ن ثَارْوَا، تْعدَّاب أُو نتَّاث تَارو. <verse eid="REV 12:2" /><verse number="3" style="v" sid="REV 12:3" />ثْمظْهَار-د ذݣ وجنَّا يجّن ن لْعَلَامَا نّغْنِي ثݣَّا اَم دَّيْنَاصُوْر ذ اَمقّْرَان ذ اَزݣّْوَاغ غَارس سبْعَا ن يزدْجِيفن ذ عشْرَا ن وَاشَّاون،<note caller="+" style="f"><char style="fr" closed="false">12‏.3 </char><char style="ft" closed="false">أَشَّاون نِثْنِي ذ يقَاشَّاون ن لْحَيَوَان.</char></note> ذ سبْعَا ن تَّاجَاث خ يزدْجِيفن نّس. <verse eid="REV 12:3" /><verse number="4" style="v" sid="REV 12:4" />ئِجَرّ س وعنَّاب نّس تُلُث ن يِيثْرَان وجنَّا، ئِنْضَر-يثن غَار ثْمُوْرْث. ئِبدّ بُو-سبْعَا-يَا-يزدْجِيفن زَّاث إِ ثمْغَارْث نِّي أُو نتَّاث تَارو حمَا خْمِي ث غَا ثَارو اَذَاس يشّ مِّيس. <verse eid="REV 12:4" /><verse number="5" style="v" sid="REV 12:5" />ثُوْرو-د اَحنْجِير ذ اَوْثم أُو ذ نتَّا إِي غَا يَروْسن مَارَّا ڒݣْنُوْس س وعكَّاز ن ڒحْذِيذ. سّنِّي يتْوَارْفع غَار أَربِّـي غَار لْعَرْش نّس. <verse eid="REV 12:5" /><verse number="6" style="v" sid="REV 12:6" />ثمْغَارْث-أَ ثَرْوڒ غَار ڒخْڒَا مَانِي ذَاس يسوْجذ أَربِّـي اَمْشَان اَت سشّن ذِنِّي اَڒَاف أُو مِيَّاتَاين أُو ستِّين يُوْم.<verse eid="REV 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7" />ئِوْقع ڒْحَرْب ذݣ وجنَّا. مِيكَائِيل ذ لْمَلَائِكَاث نّس حَارْبن بُو-سبْعَا يزدْجِيفن. بُو-سبْعَا-يَا يزدْجِيفن ذ شَّيَاطِين نّس حَارْبن عَاوذ ؤُڒَا ذ نِثْنِي. <verse eid="REV 12:7" /><verse number="8" style="v" sid="REV 12:8" />وَار ذَاسنْت زمَّرن إِ لْمَلَائِكَاث نِّي، بُو-سبْعَا-يَا يزدْجِيفن ذ شَّيَاطِين نّس ضيّْعن اَمْشَان نْسن ذݣ وجنَّا. <verse eid="REV 12:8" /><verse number="9" style="v" sid="REV 12:9" />ئِمنْضَار-د <char style="it">زݣ وجنَّا</char> بُو-سبْعَا-يَا يزدْجِيفن اَمقّْرَان، يعْنِي فِيغر نِّي ذِي زْمَان ونِّي ؤُمِي قَّارن إِبْڒِيس نِغ ذ شِّيطَان يعْنِي ونِّي يخدّْعن مَارَّا دُّنشْت. ئِمنْضَار-د غَار ثْمُوْرْث، منْضَارن-د اَكِذس شَّيَاطِين نّس.<verse eid="REV 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10" />سْڒِيغ إِ يِجّن ن ثْمِيجَّا ذݣ وجنَّا ثقَّار س جّْهذ:</para>
  <para style="p" vid="REV 12:10">"ڒخُّو أَربِّـي نّغ يسنْجَام، ئِمظْهَار جّْهذ ذ ڒْمُلْك نّس، ذ سُّلْطَا ن لْمَسِيح نّس. ڒَاحقَّاش ونِّي يتْشثْشَان زݣ اَيْثْمَاثْنغ يمنْضَار-د غَار ثْمُوْرْث، ذ نتَّا إِݣ يتْشثْشَان زَّايْسن دْجِيڒث ذ نْهَار غَار أَربِّـي نّغ.<verse eid="REV 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 12:11" />غڒْبن-ث اَيثْمَاثْنغ س يذَامّن ن يِزْمَار ذ شْهَاذث نْسن. ثُوْذَارْث نْسن وَار خَاسن ثْعِيزّ شَا، وجْذن اَذ مّْثن.<verse eid="REV 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 12:12" />خ مَانَايَا، فَرح آي اَجنَّا، ذ يِنِّي ذَايس يزدّْغن! وَلَكِن يَا تَمَارَا خ يمزْذَاغ ن ڒْبَرّ ذ ڒبْحَر! إِبْڒِيس يهْوَا-د غَارْوم يغْضب اَطَّاس، مِينْزِي يسّن ثقِّيم-اَس ذْرُوْس ن ڒْوقْث."<verse eid="REV 12:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13" />وَامِي بُو-سبْعَا يزدْجِيفن يُوْفَا يخف نّس يمنْضَار-د غَار ثْمُوْرْث، ئِكَّر يُوْزّڒ خ ثمْغَارْث نِّي إِي د يجِّين اَوْثم. <verse eid="REV 12:13" /><verse number="14" style="v" sid="REV 12:14" />ثَمْغَارْث نِّي مُّوْشن-اَس ثْنَاين ن وَافْرِيْون ن نْسر اَمقّْرَان حمَا اَزَّايْسن ثْضو غَار ڒخْڒَا غَار ؤُمْشَان نّس، مَانِي غَا تْوَاعْثق ثڒْت-سْنِين ذ ؤُزْين ذِي ڒَامَان زݣ وفِيغر نِّي. <verse eid="REV 12:14" /><verse number="15" style="v" sid="REV 12:15" />ئِسُوْفغ-د وفِيغر زݣ ؤُقمُّوْم نّس اَمَان اَمشْنَاو يغْزَار تَازّْڒن خ ثمْغَارْث حمَا اَت اَوِين وَامَان نِّي. <verse eid="REV 12:15" /><verse number="16" style="v" sid="REV 12:16" />وَلَكِن ثَمُوْرْث ثْسنْجم ثَمْغَارْث نِّي، ثرْزم اَقمُّوْم نّس ثْسغْڒِي يغْزَار إِي د يسُوْفغ بُو-سبْعَا-يزدْجِيفن زݣ ؤُقمُّوْم نّس. <verse eid="REV 12:16" /><verse number="17" style="v" sid="REV 12:17" />ئِغْضب بُو-سبْعَا-يزدْجِيفن خ ثمْغَارْث نِّي يرُوْح اَذ يحَارب س مِين يقِّيمن زِي دُّوْرِّيث نّس، يعْنِي يِنِّي يتݣّن اَرَّاي س ڒُوْصِيَاث ن أَربِّـي تطّْفن خ مِينْخف يشْهذ عِيْسَى. <verse eid="REV 12:17" /><verse number="18" style="v" sid="REV 12:18" />ثُمَّا يبدّ خ يِجْذِي ن ڒبْحَر.<verse eid="REV 12:18" /></para>
  <chapter eid="REV 12" />
  <chapter number="13" style="c" sid="REV 13" />
  <para style="s">ڒْوَحْش إِي د يتفّْغن زِي ڒبْحَر</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1" />ࢲْرِيغ يجّن ن ڒْوَحْش يفّغ-د زِي ڒبْحَر، غَارس سبْعَا ن يقيُّوْعن ذ عشْرَا ن وَاشَّاون،<note caller="+" style="f"><char style="fr" closed="false">13‏.1 </char><char style="ft" closed="false">أَشَّاون نِثْنِي ذ يقَاشَّاون ن لْحَيَوَان.</char></note> خ وَاشَّاون نّس عشْرَا ن تَّاجَاث. ؤُرِين خ يقيُّوْعن نّس يسمَاون وَار يحْڒِين خ أَربِّـي. <verse eid="REV 13:1" /><verse number="2" style="v" sid="REV 13:2" />ڒْوَحْش-أَ إِي ࢲْرِيغ يتَشَابَّاه ذݣ وغيِڒَاس،<note caller="+" style="f"><char style="fr" closed="false">13‏.2 </char><char style="ft" closed="false">أَغِيڒَاس نتَّا ذ نَّمِير.</char></note> ئِضَارن نّس ݣِّين اَم يضَارن ن دُّب، أَقمُّوْم نّس يݣَّا اَم ؤُقمُّوْم ن سّْبَع. ونِّي يدْجَان اَم دَّيْنَاصُوْر يُوْشَا-اَس إِ ڒْوَحْش-أَ جّْهذ نّس ذ لْعَرْش نّس ذ يِجّن ن سُّلْطا ثمْغَار. <verse eid="REV 13:2" /><verse number="3" style="v" sid="REV 13:3" />ئِجّن زݣ يقيُّوْعن نّس يظْهَار-د ذَايس يج وجَرِّيح اَخْمِي يمُّوْث، وَلَكِن يݣنْفَا زݣ وجَرِّيح نِّي ن ڒْموْث. أُو مَارَّا يمزْذَاغ ن ثْمُوْرْث تْعجّْبن، ذفَّارن ڒْوَحْش-أَ. <verse eid="REV 13:3" /><verse number="4" style="v" sid="REV 13:4" />سجّْذن-اَس يِوْذَان إِ ونِّي يݣِّين اَم دَّيْنَاصُوْر ڒَاحقَّاش يُوْشَا-اَس إِ ڒْوَحْش-أَ سُّلْطَا نّس. عَاوذ سجّْذن-اَس إِ ڒْوَحْش-أَ نَّان: "ؤُو غَا يِيڒِين اَم ڒْوَحْش-أَ؟ ؤُݣ يزمَّرن اَث يحَرب؟"<verse eid="REV 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5" />ئِمُّوْش-اَس ؤُقمُّوْم إِ ڒْوَحْش-أَ إِي زِي غَا يسِّيوڒ س تَّكبُّر ذ وَاوَاڒ وَار يحْڒِين خ أَربِّـي. ثمُّوْش-اَس سُّلْطَا إِي زِي غَا يخْذم ثْنَاين أُو اَرْبعِين ن شْهُوْرَاث. <verse eid="REV 13:5" /><verse number="6" style="v" sid="REV 13:6" />يبْذَا يسَّاوَاڒ س وَاوَاڒ وَار يحْڒِين خ أَربِّـي، يعْنِي س وَاوَاڒ وَار يحْڒِين خ يِيسم نّس ذ ثْزدِّيغْث نّس ذ يمزْذَاغ وجنَّا. <verse eid="REV 13:6" /><verse number="7" style="v" sid="REV 13:7" />ئِتْوَاسْمح-اَس اَذ يحَارب ڒْمُوْمِنِين صَّالِحِين، اَثن يغْڒب. ثمُوْش-اَس سُّلْطَا خ كُڒ ڒْقُوْم ذ شَّعْب ذ لُّغَا ذ ڒْݣنْس. <verse eid="REV 13:7" /><verse number="8" style="v" sid="REV 13:8" />مَارَّا يمزْذَاغ ن ثْمُوْرْث اَذَاس سجّْذن إِ ڒْوَحْش-أَ، يعْنِي كُڒ يجّن زَّايْسن يسم نّس وَار يزمّم شَا ذِي لْكِتَاب ن ثُوْذَارْث زݣ وَامِي ثدْجَا دُّنشْت-أَ، يعْنِي ذِي لْكِتَاب ن يِزْمَار يتْوَانْغن. <verse eid="REV 13:8" /><verse number="9" style="v" sid="REV 13:9" />صنّط مْلِيح آ ونِّي يتْسْڒَان.<verse eid="REV 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 13:10" />ونِّي مِيْنْخف يُوْرَا اَذ يتْوَاحبّس، أَتَاف اَذ يتْوَاحبّس.</para>
  <para style="q2" vid="REV 13:10">ونِّي مِيْنْخف يُوْرَا اَذ يتْوَانغ س سِّيف، أَتَاف اَذ يتْوَانغ س سِّيف.</para>
  <para style="q1" vid="REV 13:10">ذِي لْحَالَا نِّي يتْخصَّا ڒْمُوْمِنِين صَّالِحِين اَذ صْبَارن اَذ اَمْنن.<verse eid="REV 13:10" /></para>
  <para style="s">ڒْوَحْش إِي د يتْݣَعَّاذن زِي ثْمُوْرْث</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11" />ࢲْرِيغ يجّن ن ڒْوَحْش نّغْنِي يفّغ-د زِي ثْمُوْرْث، غَارس ثْنَاين ن وَاشَّاون اَم وَاشَّاون ن يِزْمَار وَلَكِن نتَّا يسَّاوڒ اَم دَّيْنَاصُوْر. <verse eid="REV 13:11" /><verse number="12" style="v" sid="REV 13:12" />ئِسخْذم مَارَّا سُّلْطَا ن ڒْوَحْش اَمزْوَارُو أُو نتَّا اَقَاث زَّاثس. يَارَّا مَارَّا ثَمُوْرْث ذ يمزْذَاغ نّس اَذَاس سجّْذن إِ ڒْوَحْش نِّي اَمزْوَارُو إِي يݣنْفَان زݣ وجَرِّيح نِّي ن ڒْموْث. <verse eid="REV 13:12" /><verse number="13" style="v" sid="REV 13:13" />ئِݣَّا لْمُعْجِزَاث ذ ثِمقّْرَانِين، ئِسْهوَّا-د ثِمسِّي زݣ وجنَّا غَار ثْمُوْرْث زَّاث إِ يِوْذَان. <verse eid="REV 13:13" /><verse number="14" style="v" sid="REV 13:14" />ئِخدّع يمزْذَاغ ن ثْمُورْث س لْمُعْجِزَاث نِّي إِي ذَاس يتْوَاسمْحن اَثنْت يݣّ زَّاث إِ ڒْوَحْش <char style="it">اَمزْوَارُو</char>.</para>
  <para style="p" vid="REV 13:14">يُوْمَر يمزْذَاغ ن ثْمُوْرْث اَذ صنْعن يجّن ن لْأَصْنَام اَم ڒْوَحْش نِّي إِي ذِي يدْجَا وجَرِّيح ن سِّيف وَلَكِن نتَّا يدَّر. <verse eid="REV 13:14" /><verse number="15" style="v" sid="REV 13:15" />ئِتْوَاسْمح-اَس اَذ يݣّ بُوْحْبڒ ذِي لْأَصْنَام-أَ يتْوَاصنْعن خ صِّفث ن ڒْوَحْش <char style="it">اَمزْوَارُو</char> حمَا اَذ يسِّيوڒ اَذ ينغ مَارَّا يِنِّي وَار يسجّْذن شَا إِ لْأَصْنَام-أَ اَم ڒْوَحْش نِّي. <verse eid="REV 13:15" /><verse number="16" style="v" sid="REV 13:16" />يݣَّا بزّز خ مَارَّا يوْذَان س يمقّْرَانن ذ يمزْيَانن، ذ تْوَاجَر ذ يمسْعَان، ذ يِنِّي غَارْسن بَاب نْسن ذ يِنِّي غَارْسن لْحُرِّيَا نْسن اَذ ݣّن يجّن ن طَّبَع خ وفُوْس اَفُوْسِي نْسن نِغ خ ثنْيَارْث<note caller="+" style="f"><char style="fr" closed="false">13‏.16 </char><char style="ft" closed="false">ثَنْيَارْث نتَّاث ذ ثَوَارْنَا.</char></note> نْسن. <verse eid="REV 13:16" /><verse number="17" style="v" sid="REV 13:17" />ؤُڒَا ذ يجّن وَار يزمَّر اَذ يسغ نِغ اَذ يزّنْز إِلَّا ونِّي غَار يدْجَا طَّبَع نِّي، يعْنِي يسم ن ڒْوَحْش نِّي نِغ ذ رَّقم ن يِيسم نّس. <verse eid="REV 13:17" /><verse number="18" style="v" sid="REV 13:18" />ذِي مَانَايَا تْخصَّا ڒفْهَامث. ونِّي غَار يدْجَا ڒَعْقڒ اَذ يرْزُو خ ڒْمَعْنَا ن رَّقم ن ڒْوَحْش-أَ ڒَاحقَّاش نتَّا ذ رَّقم ن يِجّن ن بْنَاذم. رَّقم نِّي نتَّا ذ ستّمِيَّا أُو ستَّا أُو سْتِّين.<verse eid="REV 13:18" /></para>
  <chapter eid="REV 13" />
  <chapter number="14" style="c" sid="REV 14" />
  <para style="s">ئِزْمَار ذ يِنِّي إِي ث يذفَّارن</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1" />وَامِي خْزَرغ، تْوَاڒِيغ يزْمَار يبدّ خ وذْرَار ن لْقُدْس اَكِذس مِيَّا أُو اَرْبعَا أُو اَرْبعِين اَڒَاف. يُوْرَا خ ثنْيَارْث<note caller="+" style="f"><char style="fr" closed="false">14‏.1 </char><char style="ft" closed="false">ثَنْيَارْث نتَّاث ذ ثَوَارْنَا.</char></note> نْسن يسم ن يِزْمَار ذ يِيسم ن بَابَاس. <verse eid="REV 14:1" /><verse number="2" style="v" sid="REV 14:2" />سْڒِيغ إِ يِجّن ن ثْمِيجَّا زݣ وجنَّا ثݣَّا اَم صُّوْت ن وَاطَّاس ن وَامَان نِغ اَم وَاجَّاج يجهْذن. عَاوذ ثْمِيجَّا نِّي ؤُمِي سْڒِيغ ثݣَّا اَم صُّوْت ن يِنِّي يشَّاثن ذِي ثْݣَامْبْرِيت. <verse eid="REV 14:2" /><verse number="3" style="v" sid="REV 14:3" />تْغنَّاجن يجّن ن يِزْڒِي ذ جْذِيذ زَّاث إِ لْعَرْش ذ اَرْبعَا نِّي ن لْمخْلُوْقَاث ذ يمْغَارن. وَار يزمَّر ؤُڒَا ذ يجّن اَذ يڒْمذ يزْڒِي نِّي إِلَّا ذ مِيَّا أُو اَرْبعَا أُو اَرْبعِين اَڒَاف نِّي إِي يتْوَاسْنجْمن زي دُّنشْت-أَ. <verse eid="REV 14:3" /><verse number="4" style="v" sid="REV 14:4" />يِـيْنَا ذ يِنِّي وَار يࢲْرِين عمَّارْص ثِمْغَارِين قِّيمن ذ يعْزْرِيْين. يِـيْنَا ذ يِنِّي يذفَّارن يزْمَار مَانِي مَا يرُوْح. تْوَاسْنجْمن نِثْنِي زِي ڒْوسْط ن يِوْذَان حمَا اَذ تْوَاقدّْمن ذ يمزْوُوْرَا إِ أَربِّـي ذ يِزْمَار. <verse eid="REV 14:4" /><verse number="5" style="v" sid="REV 14:5" />عمَّارْص وَار سْخرِّيقن، نِثْنِي اَقَاثن بْڒَا ڒْعِيب.<verse eid="REV 14:5" /></para>
  <para style="s">ڒخْبَار اَصبْحَان ن ثْڒَاثَا ن لْمَلَائِكَاث</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6" />ࢲْرِيغ يجّن ن لْمَلَائِكَا نّغْنِي ثطَّاو ذِي ڒْوسْط ن وجنَّا. غَارس لْإِنْجِيل وَار يفنِّين اَذ تْبشَّر زَّايس يمزْذَاغ ن ثْمُوْرْث زِي مْكُڒ ڒْݣنْس ذ ڒْقُوْم ذ لُّغَا ذ شَّعْب. <verse eid="REV 14:6" /><verse number="7" style="v" sid="REV 14:7" />ثقَّار س جّْهذ: "ݣّْوْذم أَربِّـي سمْغَارم-ث، أَقَا ثُوْوض-د ثْسَعَّات نّس اَذ يݣّ لْحِسَاب ذ لْعِقَاب. سجّْذث إِ ونِّي إِي د يخڒْقن اَجنَّا ذ ثْمُوْرْث ذ ڒبْحَر ذ ڒَعْنَاصر."<verse eid="REV 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8" />ثكَّر ثذْفَار-يت يجّن ن لْمَلَائِكَا نّغْنِي وِيس ثْنَاين ثقَّار: "قَا ثوْضَا قَا ثوْضَا ثنْدِينْت ن بَابِل ثَمقّْرَانْت ثنِّي إِݣ يسسّْون مَارَّا ڒݣْنُوْس س وَامَان نّس ن ؤُضِيڒ، يعْنِي لْفَسَاد نّس اَمقّْرَان."<verse eid="REV 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9" />ثكَّر ثذْفَار-يثنْت يجّن ن لْمَلَائِكَا نّغْنِي وِيس ثْڒَاثَا ثقَّار س جّْهذ: "ونِّي غَا يسجّْذن إِ ڒْوَحْش ذ لْأَصْنَام نّس، ئِقْبڒ عَاوذ طَّابَع خ ثنْيَارْث نّس نِغ خ وفُوْس نّس، <verse eid="REV 14:9" /><verse number="10" style="v" sid="REV 14:10" />أَتَاف اَذ يسو زݣ وَامَان ؤُضِيڒ يقسْحن إِݣ يدْجَان ذ اَغْضَب ن أَربِّـي يعْنِي ذ ڒْكَاس ن لْعِقَاب نّس. أَذ يعدّب س ثْمسِّي ذ ڒكْبْرِيْيث زَّاث إِ لْمَلَائِكَاث يصْفَان ذ يِزْمَار. <verse eid="REV 14:10" /><verse number="11" style="v" sid="REV 14:11" />دّخَّان ن ڒَعْذَاب نْسن يتْݣَعَّاذ إِ ڒبْدَا ن ڒبْدَاث. يِنِّي يسجّْذن إِ ڒْوَحْش ذ لْأَصْنَام نّس قبْڒن عَاوذ طَّبَع ن يِيسم نّس اَتَاف وَار غَارْسن يتِيڒِي بُو اَرَّاحث س دْجِيڒث نِغ ذ نْهَار." <verse eid="REV 14:11" /><verse number="12" style="v" sid="REV 14:12" />ذِي لْحَالَا نِّي يتْخصَّا-يَاسن إِ ڒْمُوْمِنِين صَّالِحِين اَذ صْبَرن اَذ ݣّن اَرَّاي س ڒُوْصِيَاث ن أَربِّـي اَذ اَمْنن زِي عِيْسَى. <verse eid="REV 14:12" /><verse number="13" style="v" sid="REV 14:13" />سْڒِيغ إِ يِجّن ن ثْمِيجَّا زݣ وجنَّا ثقَّار: "أَرِي مَانَايَا: سَّعْذ ن يمتِّينن إِي غَا يمّْثن سَّا اَڒ ثْسَاونْت ؤُمْنن زِي سِيذِيثْنغ." أَرُّوْح ن أَربِّـي يقَّار: "وَاه، حمَا اَذ ريّْحن زِي تَمَارَا نْسن ڒَاحقَّاش ذفَّارنْت-ثن لْحَسَانَات نْسن."<verse eid="REV 14:13" /></para>
  <para style="s">ڒْوقْث ن ومْجَار ن ثْمُوْرْث</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14" />وَامِي خْزَرغ، تْوَاڒِيغ يجّن ن ؤُسيْنُو ذ اَشمْڒَاڒ، ونِّي خَاس يقِّيمن يتْشَابَّاه ذي مِّيس ن بْنَاذم، خ وزدْجِيف نّس يجّن ن تَّاج ن دّْهب، ذݣ وفُوْس نّس يجّن ن ؤُمْجَار يقْضع. <verse eid="REV 14:14" /><verse number="15" style="v" sid="REV 14:15" />ئِكَّر يفّغ-د يجّن ن لْمَلَاك نّغْنِي زي ثمْزِيذَا ثَمقّْرَانْت، ئِقَّار-اَس س جّْهذ إِ ونِّي يقِّيمن خ ؤُسيْنُو: "يْسِي اَمْجَار نّش، مْجَر. أَقَا ثْسَعَّات ن ؤُمْجَار ثُوْوض-د، ثَفدْجَاحْث ن ثْمُوْرْث قَا ثوْجذ." <verse eid="REV 14:15" /><verse number="16" style="v" sid="REV 14:16" />ونِّي يقِّيمن خ ؤُسيْنُو يُوْوْثَا س ؤُمْجَار خ ثْمُوْرْث، ثمْجَر ثْفدْجَاحْث نّس.<verse eid="REV 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17" />ئِكَّر يفّغ-د يجّن ن لْمَلَاك نّغْنِي زِي ثمْزِيذَا ثَمقّْرَانْت يدْجَان ذݣ وجنَّا، ؤُڒَا ذ نتَّا غَارس يجّن ن ؤُمْجَار يقْضع. <verse eid="REV 14:17" /><verse number="18" style="v" sid="REV 14:18" />ئِكَّر يفّغ-د يجّن ن لْمَلَاك نّغْنِي زِي ڒْمذْبَح ن ثمْزِيذَا ثَمقّْرَانْت غَارس سُّلْطَا خ ثْمسِّي، ئِڒَاغَا س جّْهذ ينَّا-ٱس إِ لْمَلَاك نِّي غَار يدْجَا ؤُمْجَار يقْضع: "يْسِي اَمْجَار نّش، جْمع-د زَّايس يزكُّوْنن ن ثْزَايَارْث ن ثْمُوْرْث ڒَاحقَّاش اَضيڒ ثُوْوض-د ڒْوقْث نّس." <verse eid="REV 14:18" /><verse number="19" style="v" sid="REV 14:19" />لْمَلَاك نِّي يُوْوْثَا س ؤُمْجَار نّس خ ثْمُوْرْث، ئِجْمع-د يزكُّوْنن ن ؤُضِيڒ ن ثْمُوْرْث ينْضَر-يثن ذِي ثْسِيرْث ثَمقّْرَانْت إِي يدْجَان ن ؤُغْضَب ن أَربِّـي. <verse eid="REV 14:19" /><verse number="20" style="v" sid="REV 14:20" />عفّْسنْت<note caller="+" style="f"><char style="fr" closed="false">14‏.20 </char><char style="ft" closed="false">عفّس يتْوَاحْسَاب "عْجن." ذِي زْمَان اَرْوِين س يضَارن اَضِيڒ ذݣ يِجّن ن سَّرِيج حمَا اَذ د فّْغن وَامَان نّس.</char></note> ذِي ثْسِيرْث ن ؤُضِيڒ بَارَّا إِ ثنْدِينْت. حمْڒن-د زَّايس يذَامّن اَڒ وَامِي د يُوْوْضن غَار سْڒِيمث ن ؤُيِيس، ؤُيُوْرن يذَامّن نِّي شَان ثڒْتمِيَّات كِيلُوْمِت.<verse eid="REV 14:20" /></para>
  <chapter eid="REV 14" />
  <chapter number="15" style="c" sid="REV 15" />
  <para style="s">سبْعَا ن لْمَلَائِكَاث غَارْسنْت سبْعَا ن لْمُصِيبَاث</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1" />ࢲْرِيغ يجّن ن لْعَلَامَا نّغْنِي ذ ثَمقّْرَانْت ذݣ وجنَّا يسْذهَّاشن، يعْنِي سبْعَا ن لْمَلَائِكَاث غَارْسنْت سبْعَا ن لْمُصِيبَاث ثِنݣُّوْرَا، زَّايْسنْت إِي غَا يتْوَاكمّڒ ؤُغْضَب ن أَربِّـي. <verse eid="REV 15:1" /><verse number="2" style="v" sid="REV 15:2" />ࢲْرِيغ عَاوذ اَمشْنَاو ڒبْحَر ن جَّاج يخلّط اَك ثْمسِّي، بدّن خَاس يِنِّي يغڒْبن ڒْوَحْش ذ لْأَصْنَام نّس ذ رَّقم ن يِيسم نّس. كُڒ يجّن زَّايْسن يكسِّي يجّن ن ثْݣَامْبْرِيت ن أَربِّـي. <verse eid="REV 15:2" /><verse number="3" style="v" sid="REV 15:3" />تْغنَّاجن س يِيْزْڒِي ن مُوْسَى ڒْعَبْذ ن أَربِّـي ذ يِزْڒِي ن يِزْمَار قَّارن:</para>
  <para style="q1" vid="REV 15:3">"ڒخْذَايم نّش ذ ثِمقّْرَانِين يسْذهَّاشن،</para>
  <para style="q2" vid="REV 15:3">آ سِيذِي أَربِّـي نّغ إِ كُڒْشِي إِي يزمَّرن.</para>
  <para style="q1" vid="REV 15:3">ئِبْرِيذن نّش ذ ڒْحَقّ ذ نِيشَان إِݣ يدْجَان،</para>
  <para style="q2" vid="REV 15:3">آي اَزدْجِيذ ن ڒݣْنُوْس ن يِوْذَان.<verse eid="REV 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4" />آ سِيذِي، مِين عْنَان يِنِّي وَار ش يتݣّْوْذن؟</para>
  <para style="q2" vid="REV 15:4">مِين عْنَان يِنِّي يسم نّش وَار ث يسمْغَارن؟</para>
  <para style="q1" vid="REV 15:4">أَقَا شك وَاحْذش إِݣ يصْفَان.</para>
  <para style="q1" vid="REV 15:4">مَارَّا ڒݣْنُوْس اَذ د اَسن اَذاش سجّْذن،</para>
  <para style="q2" vid="REV 15:4">مِنْزِي ڒخْذَايم نّش بَاننْت-يد نِيشَان."<verse eid="REV 15:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5" />منْبَعْد إِ مَانَايَا ࢲْرِيغ ثَمزِيذَا ثَمقّْرَانْت يعْنِي اَقِيضُوْن ن شْهَاذث ينُوْرْزم ذݣ وجنَّا. <verse eid="REV 15:5" /><verse number="6" style="v" sid="REV 15:6" />فّْغنْت-يد زَّايس سبْعَا-يَا ن لْمَلَائِكَاث غَارْسنْت لْمُصِيبَاث نِّي س سبْعَا. ݣِّينْت اَرُّوْض ن ڒْكتَّان ن لُوْلَان يصْفَان يڒقّن، كُڒ يشْتن زَّايْسنْت غَارس اَحزَّام ن دّْهب يقْضع-د زݣ ؤُغِيڒ غَار نّصّ. <verse eid="REV 15:6" /><verse number="7" style="v" sid="REV 15:7" />يجّن زِي اَرْبعَا ن لْمُخْلُوْقَاث يُوْشَا-ٱسنْت إِ سبْعَا نِّي ن لْمَلَائِكَاث سبْعَا ن ثْمجْمَارِين ݣِّين-ثنْت س دّْهب، عمَّرنْت س ؤُغْضَب ن أَربِّـي يدَّرن إِ ڒبْدَا ن ڒبْدَاث. <verse eid="REV 15:7" /><verse number="8" style="v" sid="REV 15:8" />أُوْشَا ثَمْزِيذَا ثَمقّْرَانْت ثْعمَّر س دّخَّان ن لْعَظَمَا ن أَربِّـي ذ جّْهذ نّس. وَار يزمَّر حَدّ اَذ يَاذف غَار ثمْزِيذَا ثَمقّْرَانْت حتَّا اَڒ غَا كمّْڒنْت سبْعَا-يَا ن ڒْمُصِيبَاث <char style="it">إِي د غَا سهْوَانْت</char> سبْعَا ن لْمَلَائِكَاث نِّي.<verse eid="REV 15:8" /></para>
  <chapter eid="REV 15" />
  <chapter number="16" style="c" sid="REV 16" />
  <para style="s">سبْعَا ن ثْمجْمَارِين ن ؤُغْضَب ن أَربِّـي</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1" />سْڒِيغ إِ يِجّن ن ثْمِيجَّا ثنْدق-د زِي ثمْزِيذَا ثَمقّْرَانْت ثقَّار-اَسنْت إِ سبْعَا نِّي ن لْمَلَائِكَاث س جّْهذ: "رُوْحنْت زدْجْعنْت سبْعَا ن ثْمجْمَارِين ن ؤُغْضَب ن أَربِّـي خ ثْمُوْرْث." <verse eid="REV 16:1" /><verse number="2" style="v" sid="REV 16:2" />ثكَّر ثفّغ-د لْمَلَائِكَا ثَمزْوَارُوْت ثْزدْجع ثِمجْمَارْث نّس خ ثْمُوْرْث فّْغنْت-يد ثْحبَّا ذ ثِعفَّانِين ثِنِّي إِي تݣّنْت ڒحْرِيق ڒقْفنْت يوْذَان نِّي إِي ذِي يدْجَا طَّبَع ن ڒْوَحْش تْسجَّاذن إِ لْأَصْنَام نّس.<verse eid="REV 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3" />ثكَّر لْمَلَائِكَا وِيس ثْنَاين ثْزدْجع ثِمجْمَارْث نّس ذِي ڒبْحَر، ڒبْحَر يذْوڒ ذ يذَامّن اَم يذَامّن ن ونِّي يمُّوْثن، مِين يدَّرن ذي ڒبْحَر قَاع يمُّوْث.<verse eid="REV 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4" />ثكَّر لْمَلَائِكَا وِيس ثْڒَاثَا ثْزدْجع ثِمجْمَارْث نّس خ يغزْرَان ذ ڒَعْنَاصر ن وَامَان ذوْڒن ذ يذَامّن. <verse eid="REV 16:4" /><verse number="5" style="v" sid="REV 16:5" />سْڒِيغ إِ لْمَلَائِكَا ن وَامَان ثقَّار: "شك اَقَاش نِيشَان ذِي ڒحْكَامَاث نّش ذ شك ذ لْعَظِيم. ذ شك ذ ونِّي إِݣ يدْجَان، تُوْغَا ثدْجِيذ. <verse eid="REV 16:5" /><verse number="6" style="v" sid="REV 16:6" />أَقَا وَامِي سِيزّْڒن يذَامّن ن ڒْمُوْمِنِين صَّالِحِين ذ لْأَنْبِيَا، ثُوْشِيذ-اَسن اَذ سْون يذَامّن ؤُڒَا ذ نِثْنِي ڒَاحقَّاش سْذَاهدْجن مَانَاينِّي."<verse eid="REV 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 16:7" />سْڒِيغ إِ يِجّن ن صُّوْت يقَّار-د زِي ڒْمذْبَح:</para>
  <para style="q1" vid="REV 16:7">"وَاه آ سِيذِي أَربِّـي نّغ إِݣ يزمَّرن إِ كُڒْشِي،</para>
  <para style="q1" vid="REV 16:7">ڒحْكَامَاث نّش ذ ڒْحَقّ، أَقَاثنْت نِيشَان."<verse eid="REV 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8" />ثكَّر لْمَلَائِكَا وِيس اَرْبعَا ثْزدْجع ثِمجْمَارْث نّس خ ثْفُوْشْت يتْوَاسْمح-اَس إِ ثْفُوْشْت اَذ تْسشْمض يوْذَان س ثْمسِّي. <verse eid="REV 16:8" /><verse number="9" style="v" sid="REV 16:9" />شمْضن يِوْذَان س لْحَرَارَا يجهْذن. وَاخَّا اَمنِّي قَّارن اَوَاڒن وَار يحْڒِين ذݣ يِيسم ن أَربِّـي ونِّي غَار ثدْجَا سُّلْطَا خ لْمُصِيبَاث-أَ. وَار تُوْبن شَا، وَار ث سمْغَارن شَا.<verse eid="REV 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10" />ثكَّر لْمَلَائِكَا وِيس خمْسَا ثْزدْجع ثِمجْمَارْث نّس خ لْعَرْش ن ڒْوَحْش ثهْوَا-د ثَادْجسْت خ لْممْلَكَا نّس. ئِوْذَان تْغࢲَّاࢲن يڒسَاون نْسن س ڒحْرِيق. <verse eid="REV 16:10" /><verse number="11" style="v" sid="REV 16:11" />عْلَاحْسَاب ڒحْرِيق ذ ثْحبَّا إِي ذَايْسن نِثْنِي قَّارن اَوَاڒن وَار يحْڒِين خ أَربِّـي يدْجَان ذݣ وجنَّا، وَار تُوْبن شَا زِي ڒفْعَايڒ نْسن.<verse eid="REV 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12" />ثكَّر لْمَلَائِكَا وِيس ستَّا ثْزدْجع ثِمجْمَارْث نّس خ يغْزَار ن لْفُوْرَات اَمقّْرَان ؤُزْغن وَامَان إِي ذَايس، حمَا اَذ يتْوَاسّوْجذ وبْرِيذ إِ يزدْجِيذن ن شَّرْق. <verse eid="REV 16:12" /><verse number="13" style="v" sid="REV 16:13" />ࢲْرِيغ ثْڒَاثَا ن جْنُوْن يعفَّانن ݣِّين اَم يجرْوَان:<note caller="+" style="f"><char style="fr" closed="false">16‏.13 </char><char style="ft" closed="false">ئِجرْوَان نِثْنِي ذ يمزْيَانن تْشَابَّاهن ذݣ يقرْقْرِيْون.</char></note> ئِجّن يتفّغ-د زݣ وقمُّوْم ن ونِّي اَم دَّيْنَاصُوْر؛ ئِجّن يتفّغ-د زݣ وقمُّوْم ن ڒْوَحْش؛ ئِجّن يتفّغ-د زݣ وقمُّوْم ن ونِّي يتَارَّان يخف نّْس ذ نَّبِي. <verse eid="REV 16:13" /><verse number="14" style="v" sid="REV 16:14" />يِيْنَا ذ اَرُّوْحَاث ن شَّيَاطِين تݣّن لْمُعْجِزَاث <char style="it">زَعْمَا</char>. تْرَاحن غَار يزدْجِيذن ن ثْمُوْرْث مَارَّا حمَا اَثن سْمُوْنن إِ ڒْحَرْب ذِي نْهَار نِّي اَمقّْرَان ن أَربِّـي إِݣ يزمَّرن إِ كُڒْشِي.<verse eid="REV 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 16:15" />("صنّْطث، قَا نش اَذ د اَسغ اَم د يُوْسَا يج وشفَّار. سَّعْذ ن ونِّي إِي غَا يِيڒِين عْلَابَال اَذ يحْضَا اَرُّوْض نّس حمَا وَار يݣُّوْر شَا ذ اَعرْيَان اَذ ࢲرن يِوْذَان ثُوْعَرْيَنْت نّس.")<verse eid="REV 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16" />سْمُوْنن-ثن غَار يِجّن ومْشَان س لْعِبْرِيَا قَّارن-اَس &lt;هَرْمَݣِدُوْن.&gt;<verse eid="REV 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17" />ثكَّر لْمَلَائِكَا وِيس سبْعَا ثْزدْجع ثِمجْمَارْث نّس ذِي لْهَوَا سْڒِيغ إِ يِجّن ن ثْمِيجَّا زِي ثمْزِيذَا ثَمقّْرَانْت إِي د يكِّيْن زِي لْعَرْش يقَّار س جّْهذ: "صَافِي، يتْوَاكمّڒ!" <verse eid="REV 16:17" /><verse number="18" style="v" sid="REV 16:18" />ئِوْقع وَاسَّام ذ يغُوْيَان ذ وَاجَّاج ذ زِّنْزَال يجْهذ. عمَّارْص وَار يوْقِيع اَم زِّنْزَال-أَ يجهْذن زݣ وَامِي يدْجَا بْنَاذم خ ثْمُوْرْث. <verse eid="REV 16:18" /><verse number="19" style="v" sid="REV 16:19" />ثْشقّْ ثنْدِينْت ثَمقّْرَانْت خ ثْڒَاثَا، نْهذْمنْت ثْندَّام ن ڒݣْنُوْس. وَار يتُّو شَا أَربِّـي ثَنْدِينْت ن بَابِل ثَمقّْرَانْت، فَا إِنَّمَا، يُوْشَا-ٱس اَذ تْسو زِي ڒْكَاس ن وَامَان وضِيڒ يعْنِي لْعِقَاب نّس اَمقّْرَان. <verse eid="REV 16:19" /><verse number="20" style="v" sid="REV 16:20" />كُڒ ثَيْزِيرْث ثنْهزّ، فْسِين يذُوْرَار. <verse eid="REV 16:20" /><verse number="21" style="v" sid="REV 16:21" />ئِوْضَا-د يشَرَّا<note caller="+" style="f"><char style="fr" closed="false">16‏.21 </char><char style="ft" closed="false">ئِشَرَّا نتَّا ذ اَڬَرَّا.</char></note> ذ اَمقّْرَان زݣ وجنَّا خ يِوْذَان، كُڒ اَبْقُوْق يوزّن اَزْين وقنْدَار. يِوْذَان قَّارن اَوَاڒن وَار يحْڒِين خ أَربِّـي خ سَّبَاب ن لْمُصِيبَا-يَا ن يشَرَّا ڒَاحقَّاش لْمُصِيبَا-يَا ذ ثَمقّْرَانْت اَطَّاس.<verse eid="REV 16:21" /></para>
  <chapter eid="REV 16" />
  <chapter number="17" style="c" sid="REV 17" />
  <para style="s">لْفَسْدَا ثَمقّْرَانْت ذ ڒْوَحْش</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1" />يُوْسَا-د غَارِي يجّن زِي سبْعَا ن لْمَلَائِكَاث نِّي إِي غَار دْجَانْت سبْعَا ن ثْمجْمَارِين ينَّا-ٱيِي: "أَرَاح-د، أَذَاش د سْمظْهَارغ لْحِسَاب ذ لْعِقَاب ن لْفَسْدَا ثَمقّْرَانْت إِݣ يقِّيمن خ وَاطَّاس ن وَامَان. <verse eid="REV 17:1" /><verse number="2" style="v" sid="REV 17:2" />فسْذن اَكِذس يزدْجِيذن ن ثْمُوْرْث أُو عَاوذ يمزْذَاغ ن ثْمُوْرْث سْكَارن س وَامَان وضِيڒ يعْنِي لْفَسَاد نّس."<verse eid="REV 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3" />لْمَلَاك نِّي ييْسِي-اَيِي اَرُّوْح غَار ڒخْڒَا، ࢲْرِيغ يجّن ن ثمْغَارْث ثنْيَا خ يِجّن ن ڒْوَحْش ذ اَزݣّْوَاغ يحذْقن يعمَّر س يِيسمَاون وَار يحْڒِين خ أَربِّـي. غَارس سبْعَا ن يقيُّوْعن ذ عشْرَا ن وَاشَّاون.<note caller="+" style="f"><char style="fr" closed="false">17‏.3 </char><char style="ft" closed="false">أَشَّاون نِثْنِي ذ يقَاشَّاون ن لْحَيَوَان.</char></note> <verse eid="REV 17:3" /><verse number="4" style="v" sid="REV 17:4" />ثَمْغَارْث-أَ ثݣَّا اَرُّوْض ذ ݣْرُوْنَا ذ وزݣّْوَاغ يحذْقن. ثْزوّق س دّْهب ثݣَّا ثِعقَّايِين إِي يغْڒَان ذ جُّوْهَر. ذݣ وفُوْس نّس يجّن ن ڒْكَاس ن دّْهب يعمَّر س ثُوْعُوْفّْنَا ذ مِين يدْجَان حْرَام ن لْفَسَاد نّس. <verse eid="REV 17:4" /><verse number="5" style="v" sid="REV 17:5" />خ ثنْيَارْث<note caller="+" style="f"><char style="fr" closed="false">17‏.5 </char><char style="ft" closed="false">ثَنْيَارْث نتَّاث ذ ثَوَارْنَا.</char></note> نّس يُوْرَا ذِنِّي يجّن ن يِيسم: <char style="bd">بَابِل ثَمقّْرَانْت، ذ يمَّاثْسنْت ن لْفَسْدَاث ذ ثُوْعُوْفّْنَا ن ثْمُوْرْث</char>. وَلَكِن ڒْمَعْنَا نّس وَار ث يفهّم حَدّ.<verse eid="REV 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 17:6" />ࢲْرِيغ ثَمْغَارْث نِّي ثْسكَّر س يذَامّن ن ڒْمُوْمِنِين صَّالِحِين ذ يذَامّن ن يِنِّي يشهّْذن خ عِيْسَى. وَامِي ت ࢲْرِيغ ذهْشغ اَطَّاس. <verse eid="REV 17:6" /><verse number="7" style="v" sid="REV 17:7" />ينَّا-ٱيِي لْمَلَاك نِّي: "مَايمِّي تْذهَّاشذ اَمُّو؟ أَذَاش شرّْحغ ڒْمَعْنَا ينُوْفَّرن ثمْغَارْث نِّي ذ ڒْمَعْنَا ينُوْفَّرن ن ڒْوَحْش نِّي ونِّي غَار يدْجَا سبْعَا ن يقيُّوْعن ذ عشْرَا ن وَاشَّاون إِي خف ثنْيَا. <verse eid="REV 17:7" /><verse number="8" style="v" sid="REV 17:8" />ڒْوَحْش نِّي إِي ثࢲْرِيذ تُوْغَا يدْجَا، ڒخُّو وَار يدْجِي شَا، عْڒَاين اَذ د يݣَعّذ زِي ڒَادْجغ بْڒَا ڒَاحدّ اَذ يتْوَاهْذم. ئِمزْذَاغ ن ثْمُوْرْث خْمِي غَا ࢲرن ڒْوَحْش نِّي أَتَاف اَذ دهْشن يعْنِي كُڒ يجّن يسم نّس وَار يزمّم شَا زݣ وَامِي ثدْجَا دُّنشْت ذِي لْكِتَاب ن ثُوْذَارْث. ڒَاحقَّاش ڒْوَحْش نِّي تُوْغَا يدْجَا، ڒخُّو وَار يدْجِي شَا، عَاذ اَذ د يَاس.<verse eid="REV 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9" />ذِي مَانَايَا لَابُد ڒفْهَامث: سبْعَا ن يقيُّوْعن نِثْنِي ذ سبْعَا ن يذُوْرَار إِي خف ثقِّيم ثمْغَارْث-أَ، أُو عَاوذ نِثْنِي ذ سبْعَا ن يزدْجِيذن. <verse eid="REV 17:9" /><verse number="10" style="v" sid="REV 17:10" />خمْسَا زَّايْسن وْضَان، ئِجّن يدْجَا، ئِجّن عَاذ وَار د يُوْسِي شَا. خْمِي د غَا يَاس اَتَاف اَذ يقِّيم غِير شْوَايْت ن ڒْوقْث وَاهَا. <verse eid="REV 17:10" /><verse number="11" style="v" sid="REV 17:11" />ڒْوَحْش نِّي إِي تُوْغَا يدْجَان، ڒخُّو وَار يدْجِي شَا، نتَّا ذ وِيس ثْمنْيَا نتَّا عَاوذ ذ يجّن زِي سبْعَا نِّي قَا يݣُّوْر اَذ يتْوَاهْذم.<verse eid="REV 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12" />عشْرَا نِّي ن وَاشَّاون إِي ثࢲْرِيذ نِثْنِي ذ عشْرَا ن يزدْجِيذن عَاذ وَار ذَاسن ثمُّوْش شَا سُّلْطَا اَذ حكْمن. أَذَاسن ثمُّوْش سُّلْطَا اَذ حكْمن يجّن ن ڒْوقْث ذ ثَمزْيَانْت وَاهَا اَك ڒْوَحْش. <verse eid="REV 17:12" /><verse number="13" style="v" sid="REV 17:13" />يِيْنَا تَافَاقن اَذَاس ؤُشن إِ ڒْوَحْش جّْهذ نْسن ذ سُّلْطَا نْسن. <verse eid="REV 17:13" /><verse number="14" style="v" sid="REV 17:14" />نِثْنِي اَذ حَارْبن يزْمَار وَلَكِن نتَّا اَثن يغْڒب؛ قَا نتَّا ذ مَوْلَانَا ن مَوْلَانَاث ذ أَزدْجِيذ ن يزدْجِيذن، يِنِّي إِي كِذس يدْجَان يڒَاغَا-يَاسن-د أَربِّـي يخْضَر-يثن، ذَايْسن يدْجَا ڒَامَان."<verse eid="REV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15" />ينَّا-ٱيِي لْمَلَاك نِّي: "أَمَان نِّي إِي ثࢲْرِيذ مَانِي ثقِّيم لْفَسْدَا نِّي، نِثْنِي مِين عْنَان؟ نِثْنِي ذ يوْذَان زِي مْكُڒ شَّعْب ذ ڒْغَاشِي ذ ڒْݣنْس ذ لُّغَا. <verse eid="REV 17:15" /><verse number="16" style="v" sid="REV 17:16" />عشْرَا ن وَاشَّاون نِّي إِي ثࢲْرِيذ أُو ذ ڒْوَحْش نِّي اَذ عِيفّن لْفَسْدَا، أَذَاس كّْسن مَارَّا مِين غَارس اَت جّن ذ ثَعرْيَانْت. أَذ شّن اَيْسُوْم نّس، أَت سْحرْقن س ثْمسِّي. <verse eid="REV 17:16" /><verse number="17" style="v" sid="REV 17:17" />ڒَاحقَّاش ذ أَربِّـي إِݣ يسْمُوْنن ؤُڒَاون نْسن حمَا اَذَاس ݣّن ڒْخَاضَر إِ أَربِّـي، يعْنِي اَذ تَافْقن اَذَاس ؤُشن إِ ڒْوَحْش ڒحْكَام نْسن حتَّا اَڒ إِي غَا تْوَاكمّْڒن وَاوَاڒن ن أَربِّـي. <verse eid="REV 17:17" /><verse number="18" style="v" sid="REV 17:18" />ثَمْغَارْث نِّي إِي ثࢲْرِيذ نتَّاث ذ ثَنْدِينْت ثَمقّْرَانْت إِݣ يتحْكَامن خ يزدْجِيذن ن ثْمُوْرْث."<verse eid="REV 17:18" /></para>
  <chapter eid="REV 17" />
  <chapter number="18" style="c" sid="REV 18" />
  <para style="s">ثَنْدِينْت ن بَابِل ثْوطَّا</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1" />منْبَعْد إِ مَانَايَا ࢲْرِيغ يجّن ن لْمَلَاك نّغْنِي يهْوَا-د زݣ وجنَّا غَارس سُّلْطَا ذ ثَمقّْرَانْت. ثْشعْشع ثْمُوْرْث س نُّوْر ن لْعَظَمَا ن لْمَلَاك نِّي. <verse eid="REV 18:1" /><verse number="2" style="v" sid="REV 18:2" />ئِسْنكَّر ثْغُويِّث س جّْهذ ينَّا:</para>
  <para style="q1" vid="REV 18:2">"قَا ثوْضَا قَا ثوْضَا بَابِل ثَمقّْرَانْت!</para>
  <para style="q1" vid="REV 18:2">ثذْوڒ ذ ثَزدِّيغْث ن شَّيَاطِين،</para>
  <para style="q1" vid="REV 18:2">ذ ثَنْوَاڒْث إِ مْكُڒ جّنّ اَعفَّان،</para>
  <para style="q1" vid="REV 18:2">ذ اَخْبُوْش إِ مْكُڒ اَجْضِيض إِݣ يدْجَان حْرَام إِݣ يعِيفّن.<verse eid="REV 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="REV 18:3" />ڒَاحقَّاش مَارَّا ڒݣْنُوْس سْوِين</para>
  <para style="q1" vid="REV 18:3">زݣ وَامَان ن وضِيڒ ن لْفَسَاد نّس وَار يحْڒِي،</para>
  <para style="q1" vid="REV 18:3">فسْذن اَكِذس يزدْجِيذن ن ثْمُوْرْث.</para>
  <para style="q1" vid="REV 18:3">يسبَّابن ن ثْمُوْرْث ؤُوِين-د اَطَّاس ن وَاݣْڒَا</para>
  <para style="q1" vid="REV 18:3">زݣ وفلّس نّس اَمقّْرَان."<verse eid="REV 18:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4" />سْڒِيغ إِ يِجّن ن ثْمِيجَّا نّغْنِي زݣ وجنَّا ثقَّار: "فّْغم زِي ثنْدِينْت نِّي يَا شَّعْب ينُو حمَا وَار ثْشَرّْشم شَا ذِي ڒْمُعْصِيَاث نّس، حمَا وَار كنِّيو تڒْقِيفنْت شَا لْمُصِيبَاث نّس.<verse eid="REV 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 18:5" />ڒْمُعْصِيَاث نّس اَرْنِينْت حتَّا اَڒ وَامِي ؤُوْضنْت غَار وجنَّا، أَربِّـي وَار يتُّو شَا شَّرّْ نّس. <verse eid="REV 18:5" /><verse number="6" style="v" sid="REV 18:6" />أَرّم-اَس مِين ذَاوم ثݣَّا نتَّاث، دُوْبْلَام-اَس ثْنَاين ن ثْوَاڒَاثِين ڒفْعَايڒ نّس. ڒْكَاس نِّي إِي زِي ثْسسّو إِ يِوْذَان، سسّْوم-اَس-ث مَارْثَاين. <verse eid="REV 18:6" /><verse number="7" style="v" sid="REV 18:7" />مشْحَاڒ مَا ثْسمْغَار يخف نّس، مشْحَاڒ مَا ثْعِيش ذِي شّهْوث نّس، أَنشْتـنِّي إِي ت غَا ثْعدّْبم، أَنشْتـنِّي إِي ت غَا ثسْخيّْقم. لِأَنَّا نتَّاث ثقَّار ذݣ وُوڒ نّس: أَقَا قِّيمغ ذَا اَم لْمَلِكَا، نش وَار دْجِيغ شَا ذ ثَاجَّاڒْث، عمَّارْص أذ حزْنغ. <verse eid="REV 18:7" /><verse number="8" style="v" sid="REV 18:8" />خ مَانَايَا اَخَاس د مُوْننْت لْمُصِيبَاث ذݣ يِجّن ن نْهَار، يعْنِي ڒْموْث ذ لْحُزن ذ بُوْهيُّوْف. أَذ تحرق س ثْمسِّي ڒَاحقَّاش سِيذِي أَربِّـي إِي خَاس غَا يحكْمن نتَّا يجْهذ.<verse eid="REV 18:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9" />ئِزدْجِيذن ن ثْمُوْرْث إِي كِذس يفسّْذن إِي كِذس يتْعِيشن ذِي شّهْوث نّس، أَخَاس رُون اَخَاس حزْنن خْمِي غَا ࢲرن دّخَّان ن ثْمسِّي نّس. <verse eid="REV 18:9" /><verse number="10" style="v" sid="REV 18:10" />أَذ بدّن غَار ڒݣّْوَاج س ثِيݣّْوْذِي ن ڒَعْذَاب نّس نِثْنِي قَّارن: يَا لَطِيف، يَا لَطِيف! يَا ثَنْدِينْت ثَمقّْرَانْت، يَا بَابِل ثَنْدِينْت يجهْذن! ذݣ يِجّن ن ثْسَعَّات يهْوَا-د خَام لْحِسَاب ذ لْعِقَاب!<verse eid="REV 18:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11" />ئِسبَّابن ن ثْمُوْرْث اَخَاس رُوْن اَخَاس حزْنن ڒَاحقَّاش سّڒْعَث نْسن وَار تِيفن وِي ت غَا يسْغن. <verse eid="REV 18:11" /><verse number="12" style="v" sid="REV 18:12" />سّڒْعَث نِّي ن دّْهب، ذ نُّقَارْث، ذ لْوِيز، ذ جُّوْهَر، ذ ڒْكتَّان ن لُوْلَان اَصبْحَان، ذ ڒْكتَّان ݣْرُوْنَا، ذ ڒحْرِير، ذ ڒْكتَّان اَزݣّْوَاغ يحذْقن، ذ مَارَّا مِين يتْوَاصنّْعن س وكشُّوْض ن ومضْزِي،<note caller="+" style="f"><char style="fr" closed="false">18‏.12 </char><char style="ft" closed="false">أَمضْزِي نتَّا ذ ڒْعَرْعَر نِغ أَمڒْزِي. أَقَا-ث مُوْجُود ذِي لْمغْرِب.</char></note> ذ مَارَّا مِين يتْوَاصنّْعن س يغمُّوْزن ن لْفِيل، ذ مَارَّا مِين يتْوَاسنّْعن س وكشُّوْض يغْڒَان، ذ نّحَّاس، ذ ڒحْذِيذ، ذ مَارْمُو، <verse eid="REV 18:12" /><verse number="13" style="v" sid="REV 18:13" />ذ ڒْقَرْفَا، ذ لْعِطَر، ذ تْبَخُوْر، ذ مُوْرّْ،<note caller="+" style="f"><char style="fr" closed="false">18‏.13 </char><char style="ft" closed="false">مُورّْ نتَّا ذ اَمَان ن يِجّن ن ثْشجَّارْث ذَايْسن ڒفْوَاح. سْخدَّامن-ث إِ دّْوَا، تݣّن-ث عَاوذ إِ يمتِّينن خْمِي ثن نطّْڒن.</char></note> ذ تْبَخُوْر لْلُبَان، ذ وَامَان ن وضِيڒ، ذ زّشْت، ذ وَارن لْفُرْس، ذ يِرْذَان، ذ يفُوْنَاسن، ذ يحُوْڒِيْين، ذ يِيْسَان، ذ يكَارُّوْثن، ذ يسمْغَان يعْنِي يوْذَان.<verse eid="REV 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 18:14" />
    <char style="it">أَذَاس ينِين يسبَّابن:</char> مِين ثْعشّق شّهْوث نّمْ وَار ث تِيفذ شَا. مَارَّا اَݣْڒَا ذ ڒْخِير نّمْ اَذ يقْضَا، عمَّارْص اَذ د يذْوڒ. <verse eid="REV 18:14" /><verse number="15" style="v" sid="REV 18:15" />ئِسبَّابن نِّي إِي كِذس ݣِّين اَݣْڒَا س سّڒْعَاث نِّي اَذ بدّن غَار ڒݣّْوَاج س ثِيݣّْوْذِي زِي ڒَعْذَاب نِّي، أَذ رُوْن اَذ حزْنن. <verse eid="REV 18:15" /><verse number="16" style="v" sid="REV 18:16" />أَذ ينِين: يَا لَطِيف، يَا لَطِيف! قَا ثَنْذِينْت-أَ ثَمقّْرَانْت، تُوْغَا خَاس ڒْكتَّان ن لُوْلَان اَصبْحَان ذ ڒْكتَّان ݣْرُوْنَا ذ ڒْكتَّان اَزݣّْوَاغ يحذْقن، ثْزوّق يخف نّس س دّْهب ثݣَّا لْوِيز ذ جُّوْهَر! <verse eid="REV 18:16" /><verse number="17" style="v" sid="REV 18:17" />ئِرُوْح مَارَّا مَانَاينِّي ذݣ يِجّن ن ثْسَعَّات وَاهَا!</para>
  <para style="b" vid="REV 18:17" />
  <para style="p" vid="REV 18:17">أَرُّوْيَاس ن يغَرُّوْبَا ذ يِنِّي يتْسَفَارن ذݣ وغَرَّابُو ذ يبحْرِيْين ذ مَارَّا يِنِّي يتْعِيشن زِي ڒبْحَر بدّن غَار ڒݣّْوَاج، <verse eid="REV 18:17" /><verse number="18" style="v" sid="REV 18:18" />خْزَرن غَار دّخَّان ن ؤُحْرَاق نّس. قَّارن س جّْهذ: مَان ثَنْدِينْت إِݣ يدْجَان نتَّاث اَم ثنْدِينْت-أَ ثَمقّْرَانْت؟ <verse eid="REV 18:18" /><verse number="19" style="v" sid="REV 18:19" />نطَّارن شَاڒ خ يزدْجِيفن نْسن، سْغُوْيِون، تْرُوْن، حزّْنن، قَّارن: يَا لَطِيف، يَا لَطِيف ن ثنْذِينْت ثَمقّْرَانْت! أَيثْبَاب ن يغَرُّوْبَا ذِي ڒبْحَر تُوْغَا ذوْڒن ذ تْوَاجَر لِأَنَّا ثَنْدِينْت ذَايس اَݣْڒَا اَطَّاس! ذݣ يِجّن ن ثْسَعَّات كُڒْشِي يرُوْح!<verse eid="REV 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 18:20" />آي اَجنَّا، فَرح خ وهْذَام نّس، فَرْحم آ ڒْمُوْمِنِين صَّالِحِين ذ اَرُّسُل ذ لْأَنْبِيَا! أَقَا يحَاسب-يت أَربِّـي خ مِين ذَاوم ثݣَّا."<verse eid="REV 18:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21" />ئِجّن ن لْمَلَاك يجْهذ ييْسِي-د يجّن ن وزْرُو يݣَّا اَم وزْرُو ن ثْسِيرْث ثَمقّْرَانْت، ئِنْضَر-يث ذِي ڒبْحَر ينَّا: "أَمُّو س جّْهذ إِي غَا ثْمنْضَار بَابِل ثَنْدِينْت ثَمقّْرَانْت، وَار يتِيڒِي شَا عمَّارْص. <verse eid="REV 18:21" /><verse number="22" style="v" sid="REV 18:22" />زِي سَّا اَڒ ثْسَاونْت عمَّارْص اَذَايم تسْڒَان إِ صُّوْت ن يمذْيَازن ذ يِنِّي يشَّاثن ذِي ثْݣَامْبْريِت ذ يِنِّي يتْصُوْضن ذِي زَّامَّار ذ ثمْجَا.<note caller="+" style="f"><char style="fr" closed="false">18‏.22 </char><char style="ft" closed="false">ثَمْجَا نتَّاث ذ لْغِيطَا نِغ ذ ثَشبَّابْث.</char></note> عمَّارْص اَذَايم يڒِين يِنِّي يتْصنَّاعن مَامّش مَا ثݣَّا صّنْعَث نْسن. عمَّارْص اَذَايم تسْڒَان إِ صُّوْت ن ثْسِيرْث. <verse eid="REV 18:22" /><verse number="23" style="v" sid="REV 18:23" />عمَّارْص اَذَايم ثْشعّڒ ثْفَاوْث ن ڒْقنْدِيڒ. عمَّارْص اَذَايم تسْڒَان إِ صُّوْت ن مُوْڒَاي ذ ثْسْڒِيث. أَقَا يسبَّابن نّمْ تُوْغَا دْجَان ذ يمقّْرَانن ن ثْمُوْرْث، س سِّحر نّمْ ثْخذْعذ مَارَّا ڒݣْنُوْس.<verse eid="REV 18:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="REV 18:24" />إِيوَا ذِي ثنْدِينْت-أَ إِݣ ؤُفِين يذَامّن ن لْأَنْبِيَا ذ ڒْمُوْمِنِين صَّالِحِين ذ مَارَّا يِنِّي يتْوَانْغن ذِي ثْمُوْرْث."<verse eid="REV 18:24" /></para>
  <chapter eid="REV 18" />
  <chapter number="19" style="c" sid="REV 19" />
  <para style="s">سَّعْذ ن يِنِّي يتْوَاعَرْضن غَار ومنْسِي ن ڒْفَارْح ن يِزْمَار</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1" />منْبَعْد إِ مَانَايَا سْڒِيغ إِ يِجّن ن ثْمِيجَّا اَمشْنَاو صُّوْت ن وَاطَّاس ن يِوْذَان يدْجَان ذݣ وجنَّا، ثقَّار س جّْهذ: "حمْذث أَربِّـي!<note caller="+" style="f"><char style="fr" closed="false">19‏.1 </char><char style="ft" closed="false">حمْذث أَربِّـي، يعْنِى س وَاوَاڒ ن أَيث-إِسْرَائِيل هَلِّيلُويَا!</char></note> أَسنْجم ذ لْعَظَمَا ذ جّْهذ إِ أَربِّـي نّغ.<verse eid="REV 19:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 19:2" />ڒحْكَام نّس ذ ڒْحَقّ يدْجَا نِيشَان. ئِحَاسب لْفَسْدَا ثَمقّْرَانْت إِݣ يسفْسَاذن ثَمُوْرْث س لْفَسَاد نّس، ئِنْتَاقم زَّايس عْلَاحْسَاب يذَامّن ن يِنِّي يعبّْذن أَربِّـي."<verse eid="REV 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 19:3" />نَّان ثْوَاڒَا وِيس ثْنَاين: "حمْذث أَربِّـي! دّخَّان نّس يتْݣَعَّاذ إِ ڒبْدَا ن ڒبْدَاث."<verse eid="REV 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 19:4" />اَرْبعَا و عِشْرِين ن يمْغَارن ذ اَرْبعَا ن لْمخْلُوْقَاث سجّْذن إِ أَربِّـي يقِّيمن خ لْعَرْش، قَّارن: "آمِين! حمْذث أَربِّـي!"<verse eid="REV 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5" />ثُوْسَا-د يجّن ن ثْمِيجَّا زِي لْعَرْش ثقَّار: "حمْذث أَربِّـي يَا لْعِبَاد نّس مَارَّا، آ يِنِّي ث يتݣّْوْذن س ؤُمزْيَان ذ ؤُمقّْرَان!"<verse eid="REV 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 19:6" />سْڒِيغ إِ يِجّن ن صُّوْت اَم صُّوْت ن وَاطَّاس ن ڒْغَاشِي نِغ اَم صُّوْت ن وَاطَّاس ن وَامَان نِغ اَم صُّوْت ن وَاجَّاج يجهْذن، ئِقَّار: "حمْذث أَربِّـي! سِيذِي أَربِّـي نّغ إِݣ يزمَّرن إِ كُڒْشِي قَا يحكّم.<verse eid="REV 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 19:7" />يَالَّاهم أَ نْفَرْحث، أَ نزْهُوْث، أَث نْسمْغَارث! ڒْفَارْح ن يِزْمَار اَقَّا يُوْوض-د، ثَسْڒِيث نّس قَا ثْسوْجذ يخف نّس.<verse eid="REV 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 19:8" />ئِمُّوْش-اَس اَخَاس ثݣّ ڒْكتَّان ن لُوْلَان اَصبْحَان، يرقّْ، يصْفَا."</para>
  <para style="p" vid="REV 19:8">(ڒْكتَّان ن لُوْلَان اَصبْحَان يعْنِي نتَّا ذ ڒخْذَايم إِݣ يدْجَان نِيشَان ن ڒْمُوْمِنِين صَّالِحِين.)<verse eid="REV 19:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9" />ينَّا-ٱيِي لْمَلَاك ونِّي: "أَرِي مَانَايَا: سَّعْذ ن يِنِّي يتْوَاعَرْضن غَار ومنْسِي ن ڒْفَارْح ن يِزْمَار!" ينَّا-ٱيِي عَاوذ: "أَوَاڒن-أَ دْجَان ذ صَّح زِي أَربِّـي." <verse eid="REV 19:9" /><verse number="10" style="v" sid="REV 19:10" />وْضِيغ-اَس غَار يضَارن نّس حمَا اَذَاس سجّْذغ. ئِنْدق-د ينَّا-ٱيِي: "لَّا! قَا نش ذ ڒْعَبْذ اَم نش اَم شك اَم اَيْثْمَاش إِي طّْفن خ مِينْخف يشْهذ عِيْسَى. سجّذ-اَس إِ أَربِّـي! ڒَاحقَّاش مِينْخف يشْهذ عِيْسَى نتَّا ذ اَرُّوْح ن لْأَنْبِيَا."<note caller="+" style="f"><char style="fr" closed="false">19‏.10 </char><char style="ft" closed="false">لْجُمْلَا-يَا، ڒْمَعْنَا نّس ڒْحَقّ إِݣ يسْمظْهَار سِيذِيثْنغ عِيْسَى نتَّا ذ جّْهذ نِّي إِݣ يعَاوْنن يوْذَان اَذ ينِين اَوَاڒ ن أَربِّـي.</char></note><verse eid="REV 19:10" /></para>
  <para style="s">ونِّي ينْيِيْن خ ؤُيِيْس ذ اَشمْڒَاڒ</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11" />ࢲْرِيغ اَجنَّا ينُوْرْزم ذِنِّي يجّن ن ؤُيِيْس ذ اَشمْڒَاڒ، ونِّي خَاس ينْيِيْن قَّارن-اَس ڒَامَان ذ ڒْحَقّ. ئِتْحَاسَاب يتْحَرَاب س ڒْحَقّ. <verse eid="REV 19:11" /><verse number="12" style="v" sid="REV 19:12" />ثِيطَّاوِين نّس اَم ؤُحَذُوْق ن ثْمسِّي، خ ؤُزدْجِيف نّس اَطَّاس ن تَّاجَاث. يُوْرَا خَاس يجّن ن يِيسم وَار ث يسِّين حَدّ إِلَّا نتَّا. <verse eid="REV 19:12" /><verse number="13" style="v" sid="REV 19:13" />ئِݣَّا خَاس يجّن ن تْشَامِّير يغضْسن ذݣ يذَامّن، س يِيْسم تْڒَاغَان-اَس أَوَاڒ ن أَربِّـي. <verse eid="REV 19:13" /><verse number="14" style="v" sid="REV 19:14" />ڒْعَسْكَار ن وجنَّا ذفَّارن-ث نْيِيْن خ يِيْسَان ذ يشمْڒَاڒن، ݣِّين اَرُّوْض ن ڒْكتَّان ن لُوْلَان اَصبْحَان ذ اَشمْڒَاڒ ينْقَا. <verse eid="REV 19:14" /><verse number="15" style="v" sid="REV 19:15" />ئِتفّغ-د زݣ وقمُّوْم نّس يجّن ن سِّيف يقْضع، اَزَّايس يُوْوث ڒݣْنُوْس. نتَّا اَثن يَرْوس س وعكَّاز نْ ڒحْذِيذ، اَخَاسن يعفّس<note caller="+" style="f"><char style="fr" closed="false">19‏.15 </char><char style="ft" closed="false">عفّس يتْوَاحْسَاب "عْجن." ذِي زْمَان اَروِّين اَضِيڒ س يضَارن ذݣ يِجّن ن سَّرِيج حمَا اَذ د فّْغن وَامَان نّس.</char></note> ذِي ثْسِيرْث ن وَامَان ن وضِيڒ يعْنِي ذ لْعِقَاب اَمقّْرَان ن أَربِّـي إِݣ يزمَّرن إِ كُڒْشِي. <verse eid="REV 19:15" /><verse number="16" style="v" sid="REV 19:16" />يُوْرَا خ وتْشَامِّير ذ ؤُمصَّاض نّس يجّن ن يِيْسم يعْنِي ذ أَزدْجِيذ ن يزدْجِيذن ذ مَوْلَانَا ن مَوْلَانَاث.<verse eid="REV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17" />ࢲْرِيغ يجّن ن لْمَلَاك يبدّ خ ثْفُوْشْت، ئِسْنكَّر ثْغُوْيِّيْث س جّْهذ يقَّار-اَسن إِ مَارَّا يجْضَاض يطَّاون ذِي ڒْوسْط ن وجنَّا: "أَرَاحم-د، مُوْنث غَار ؤُمنْسِي اَمقّْرَان ن أَربِّـي <verse eid="REV 19:17" /><verse number="18" style="v" sid="REV 19:18" />حمَا اَذ تشّم اَيْسُوْم ن يزدْجِيذن ذ ويْسُوْم ن اَرُّوْيَاس ن ڒْعَسْكَار ذ ويْسُوْم ن يِنِّي يجهْذن ذ ويْسُوْم ن يِيْسَان ذ يِنِّي خَاسن ينْيِيْن ذ ويْسُوْم ن مَارَّا يِوْذَان يعْنِي ذ يِنِّي غَار يدْجَا بَاب نْسن ذ يِنِّي غَار ثدْجَا لْحُرِّيَا نْسن، س ؤُمزْيَان ذ ؤُمقّْرَان."<verse eid="REV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19" />ࢲْرِيغ ڒْوَحْش ذ يزدْجِيذن ن ثْمُوْرْث ذ ڒْعَسْكَار نْسن نْجمْعن حمَا اَذ حَارْبن ونِّي ينْيِيْن خ ؤُيِيْس ذ ڒْعَسْكَار نّس. <verse eid="REV 19:19" /><verse number="20" style="v" sid="REV 19:20" />يتْوَاطّف ڒْوَحْش ذ اَمحْبُوْس، أَكِذس ونِّي يتَارَّان يخف نس ذ نَّبِي إي تُوْغَا يتݣّن لْمُعْجِزَاث زَّاث إِ ڒْوَحْش. س لْمُعْجِزَاث نِّي يخْذع يِنِّي إِي ذِي يدْجَا طَّبَع ن ڒْوَحْش تْسجَّاذن-اَس إِ لْأَصْنَام نّس. ڒْوَحْش ذ ونِّي يتَارَّان يخف نّس ذ نَّبِي منْضَارن س ثْنَاين إِذْسن ذِي ڒبْحَر ن ثْمسِّي يرقّن س ڒكْبْرِيْيث أُو نِثْنِي اَقَاثن عَاذ س بُوْحْبڒ نْسن. <verse eid="REV 19:20" /><verse number="21" style="v" sid="REV 19:21" />سِّيف نِّي إِي د يفّْغن زݣ وقمُّوْم ن ونِّي ينْيِيْن خ ؤُيِيْس ينْغَا مَارَّا يِنِّي يقِّيمن، ؤُسِين-د يِجْضَاض جِّيْوْنن مَارَّا زݣ ويْسُوْم نْسن.<verse eid="REV 19:21" /></para>
  <chapter eid="REV 19" />
  <chapter number="20" style="c" sid="REV 20" />
  <para style="s">شِّيطَان يتْوَاقّن اَڒَاف ن يسݣّْوُوْسَا</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1" />ࢲْرِيغ يجّن ن لْمَلَاك يهْوَا-د زݣ وجنَّا غَارس ذݣ وفُوْس نّس ڒْمفْتَاح ن ڒَادْجغ بْڒَا ڒَاحدّ ذ يِجّن ن سّنْسْڒث ذ ثَمقّْرَانْت. <verse eid="REV 20:1" /><verse number="2" style="v" sid="REV 20:2" />ئِطّف ونِّي يݣِّين اَم دَّيْنَاصُوْر نتَّا ذ فِيغر نِّي ن زْمَان يعْنِي إِبْڒِيس نِغ ذ شِّيطَان، ئِقّن-يث يحْبس-يث اَڒَاف ن يسݣّْوُوْسَا. <verse eid="REV 20:2" /><verse number="3" style="v" sid="REV 20:3" />ئِنْضَر-يث ذِي ڒَادْجغ بْڒَا ڒَاحدّ، ئِبلّع خَاس <char style="it">ثَوَّارْث</char> يشمّع-يت بَاش سّنِّي اَڒ ثْسَاونْت وَار يخدّع شَا ڒݣْنُوْس اَڒ غَا كمّْڒن اَڒَاف ن يسݣّْوُوْسَا نِّي. منْبَعْد إِ مَانَاينِّي لَابُد اَذ يتْوَاضْڒق شْوَايْت ن ڒْوقْث.<verse eid="REV 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4" />ࢲْرِيغ لْعَرْشَاث ذ يِنِّي خَاسن يقِّيمن ثمُّوْش-اَسن سُّلْطَا اَذ حكْمن. ࢲْرِيغ بُوْحْبڒ ن يِنِّي ؤُمِي يتْوَاقسّن يزدْجِيفن لِأَنَّا ذفَّارن مِينْخف يشْهذ عِيْسَى ذ وَاوَاڒ ن أَربِّـي. نِثْنِي تُوْغَاثن وَار سجّْذن شَا إِ ڒْوَحْش نِغ إِ لْأَصْنَام نّس، تُوْغَا وَار قْبِيڒن شَا طَّبَع نّس خ ثنْيَارث<note caller="+" style="f"><char style="fr" closed="false">20‏.4 </char><char style="ft" closed="false">ثَنْيَارْث نتَّاث ذ ثَوَارْنَا.</char></note> نْسن نِغ خ وفُوْس نْسن. كَّرن-د زِي ڒْموْث حكْمن اَك عِيْسَى اَڒَاف ن يسݣّْوُوْسَا. <verse eid="REV 20:4" /><verse number="5" style="v" sid="REV 20:5" />مَانَاينِّي ذ لْقِيَامَا ثَمزْوَارُوْت. ئِمتِّينن نّغْنِي وَار د تكَّرن شَا زِي ڒْموْث حتَّا اَڒ غَا كمّْڒن اَڒَاف ن يسݣّْوُوْسَا. <verse eid="REV 20:5" /><verse number="6" style="v" sid="REV 20:6" />يِنِّي د غَا يكَّرن ذِي لْقِيَامَا ثَمزْوَارُوت سَّعْذ نْسن، أَقَاثن صْفَان. ڒْموْث وِيس ثْنَاين وَار غَارس تِيڒِي شَا سُّلْطَا خَاسن. اَذ يڒِين ذ ڒْفُقَهَا ن أَربِّـي ذ لْمَسِيح، أَكِذس حكْمن اَڒَاف ن يسݣّْوُوْسَا.<verse eid="REV 20:6" /></para>
  <para style="s">شِّيطَان يتْوَانْضَار ذِي ڒبْحَر ن ثْمسِّي</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7" />خْمِي غَا كمّْڒن اَڒَاف ن يسݣّْوُوْسَا نِّي، أَذ د يتْوَاضْڒق شِّيطَان زِي ڒحْبس نّس. <verse eid="REV 20:7" /><verse number="8" style="v" sid="REV 20:8" />أَذ د يفّغ اَذ يخْذع ڒݣْنُوْس خ اَرْبعَا ن جْوَايه ن ثْمُوْرْث، يعْنِي هَاجُوْج أُو مَاجُوْج. أَثن يسْمُوْن اَذ حَارْبن، لْعَدَد نْسن يݣَّا اَم يِيْجْذِي ن ڒبْحَر.<verse eid="REV 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 20:9" />نْفيّْضن-د <char style="it">هَاجُوْج أُو مَاجُوْج</char> خ ثْمُوْرْث اَمن-ثكْمَاڒ، نّْضن مَانِي عزّْبن ڒْمُوْمِنِين صَّالِحِين يعْنِي ثَنْدِينْت نِّي يعِيزّن. ڒخْدّنِّي ثهْوَا-د خَاسن ثْمسِّي زݣ وجنَّا ثشّ-يثن. <verse eid="REV 20:9" /><verse number="10" style="v" sid="REV 20:10" />إِبْڒِيس نِّي إِي ثن يخذْعن ئِمنْضَار-د ذِي ڒبْحَر نِّي ن ثْمسِّي ذ ڒكْبْرِيْيث مَانِي يدْجَا ڒْوَحْش نِّي ذ ونِّي يتَارَّان يخف نّس ذ نَّبِي. أَذ تْوَاعدّْبن ذِنِّي نْهَار ذ دْجِيڒث إِ ڒبْدَا ن ڒبْدَاث.<verse eid="REV 20:10" /></para>
  <para style="s">يُوْم لْحِسَاب ذ لْعِقَاب</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11" />ࢲْرِيغ يجّن ن لْعَرْش ذ اَشمْڒَاڒ ذ اَمقّْرَان. ونِّي خَاس يقِّيمن ثَرْوڒ زَّايس ثْمُوْرْث ذ وجنَّا وَار ذَاسن يقِّيم بُو ومْشَان. <verse eid="REV 20:11" /><verse number="12" style="v" sid="REV 20:12" />ࢲْرِيغ يمتِّينن بدّن زَّاث إِ لْعَرْش نِّي اَم ومزْيَان اَم ومقّْرَان. نُوْرْزْمن لْكُتُب، ئِنُوْرْزم يجّن ن لْكِتَاب نّغْنِي نتَّا ذ لْكِتَاب ن ثُوْذَارْث. تْوَاحَاسْبن يمتِّينن س مِين يُوْرِين ذِي لْكُتُب عْلَاحْسَاب ڒخْذَايم نْسن. <verse eid="REV 20:12" /><verse number="13" style="v" sid="REV 20:13" />ڒبْحَر يسلّم يمتِّينن إِݣ يشَّا. ڒْموْث ذ لْأَخِرَا سلّْمنْت يمتِّينن نْسنْت. أُوْشَا كُڒ يجّن اَذ يتْوَاحَاسب عْلَاحْسَاب ڒخْذَايم نّس. <verse eid="REV 20:13" /><verse number="14" style="v" sid="REV 20:14" />ثْمنْضَار-د ڒْموْث ذ لْأَخِرَا ذِي ڒبْحَر ن ثْمسِّي. قَا ڒبْحَر نِّي ن ثْمسِّي نتَّا إِݣ يدْجَان ذ ڒْموْث وِيس ثْنَاين. <verse eid="REV 20:14" /><verse number="15" style="v" sid="REV 20:15" />ونِّي وَار غَار ؤُفِين شَا يسم نّس يزمّم ذِي لْكِتَاب ن ثُوْذَارْث قَا يمنْضَار-د ذِي ڒبْحَر ن ثْمسِّي.<verse eid="REV 20:15" /></para>
  <chapter eid="REV 20" />
  <chapter number="21" style="c" sid="REV 21" />
  <para style="s">ئِجّن ن وجنَّا ذ ثْمُوْرْث ذ جْذِيذ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1" />ࢲْرِيغ يجّن ن وجنَّا ذ جْذِيذ ذ يجّن ن ثْمُوْرْث ذ جْذِيذ، ڒَاحقَّاش اَجنَّا اَمزْوَارُو ذ ثْمُوْرْث ثَمزْوَارُوْت صَافِي تْوَاكّْسن، ڒبْحَر وَار يقِّيم شَا. <verse eid="REV 21:1" /><verse number="2" style="v" sid="REV 21:2" />ࢲْرِيغ ثَنْدِينْت يقدّْسن نتَّاث ذ لْقُدْس ذ جْذِيذ. ثهْوَا-د زݣ وجنَّا زِي أَربِّـي ثݣَّا اَم ثسْڒِيث ثعْذڒ يخف نّس بَاش اَذ تڒْقَا مُوْڒَاي. <verse eid="REV 21:2" /><verse number="3" style="v" sid="REV 21:3" />سْڒِيغ إِ يِجّن ن ثْمِيجَّا زِي لْعَرْش ثقَّار س جّْهذ: "أَقَا ثَزدِّيغْث ن أَربِّـي اَك يِوْذَان، أَذ يزْذغ جَارَاسن اَذ يڒِين ذ شَّعْب نّس. أَربِّـي س يِيخف نّس اَكِذْسن يِيڒِي، أُو عَاوذ اَذ يِيڒِي ذ أَربِّـي نْسن. <verse eid="REV 21:3" /><verse number="4" style="v" sid="REV 21:4" />أَذ يمْسح كُڒ اَمطَّاو زِي ثِيطَّاوِين نْسن. وَار تْغِيمِي شَا عَاذ ڒْموْث نِغ ذ لْحُزن نِغ ذ يمطَّاون نِغ ذ ڒحْرِيق. أَقَا ثِمسْڒَايِين نِّي ثِمزْوُوْرَا صَافِي تْوَاكّْسنْت."<verse eid="REV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5" />ينَّا-ٱيِي ونِّي يقِّيمن خ لْعَرْش: "أَذ ݣّغ كُڒْشِي ذ جْذِيذ!" أُوْشَا ينَّا: "أَرِي مَانَايَا قَا اَوَاڒن-أَ ذَايْسن ڒَامَان ذَايْسن ڒْحَقّ." <verse eid="REV 21:5" /><verse number="6" style="v" sid="REV 21:6" />ينَّا-ٱيِي: "صَافِي، ئِتْوَاكمّڒ. نش ذ لْأَلِف نش ذ لْيَاء. نش كُڒْشِي زَّايِي إِݣ يبْذَا، نش كُڒْشِي زَّايِي إِي غَا يكمّڒ. أَذ ؤُشغ إِ ونِّي يفُوْذن زِي ڒْعُنْصَر ن وَامَان ن ثُوْذَارْث بَاطڒ. <verse eid="REV 21:6" /><verse number="7" style="v" sid="REV 21:7" />ونِّي غَا يربْحن اَذ يوَرث ذِي ثْمسْڒَايِين-أَ. نش اَذ يڒِيغ ذ أَربِّـي نّس، نتَّا اَذ يِيڒِي ذ مِّي. <verse eid="REV 21:7" /><verse number="8" style="v" sid="REV 21:8" />وَلَكِن شّْمَايث ذ يِنِّي وَار يُوْمِينن شَا ذ يِنِّي يدْجَان ذ يعفَّانن ذ يِنِّي ينقّن يوْذَان ذ يِنِّي يفسّْذن ذ يسحَّارن ذ يِنِّي يعبّْذن لْأَصْنَام ذ مَارَّا يِنِّي يسْخرِّيقن قَا اَمْشَان نْسن اَذ يِيڒِي ذِي ڒبْحَر يرقّن س ثْمسِّي ذ ڒكْبْرِيْيث. قَا ثنِّي ذ ڒْموْث وِيس ثْنَاين."<verse eid="REV 21:8" /></para>
  <para style="s">ثَنْدِينْت ن لْقُدْس ذ جْذِيذ</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9" />يُوْسَا-د غَارِي يجّن زِي سبْعَا ن لْمَلَائِكَاث نِّي إِي غَار دْجَانْت سبْعَا ن ثْمجْمَارِين إِݣ يعمَّرن س سبْعَا ن لْمُصِيبَاث نِّي ثِنْݣُّوْرَا، ينَّا-ٱيِي: "أَرَاح-د، أَذَاش د سْمظْهَارغ ثَسْڒِيث، يعْنِي ثنِّي غَا يَاوِين يزْمَار." <verse eid="REV 21:9" /><verse number="10" style="v" sid="REV 21:10" />ئِيْسِي-اَيِي اَرُّوْح غَار يِجّن ن وذْرَار ذ اَمقّْرَان يُوْعْڒَا، ئِسْمظْهَار-اَيِي-د ثَنْدِينْت يقدّْسن يعْنِي لْقُدْس، ثهْوَا-د زݣ وجنَّا زِي أَربِّـي. <verse eid="REV 21:10" /><verse number="11" style="v" sid="REV 21:11" />ذَايس لْعَظَمَا ن أَربِّـي، نُّوْر نّس اَمشْنَاو ثَزْرُوْت ثَصبْحَانْت، أَمشْنَاو ثَزْرُوْت ن لْيَشب ثصْفَا اَطَّاس. <verse eid="REV 21:11" /><verse number="12" style="v" sid="REV 21:12" />غَارس يجّن ن ڒْحِيض ذ اَمقّْرَان يُوْعْڒَا غَارس ثنْعَاش ن ثوُّوْرَا، ثنْعَاش ن ثوُّوْرَا نِّي خَاسنْت ثنْعَاش ن لْمَلَائِكَاث. يُوْرَا خ ثوُّوْرَا نِّي يسمَاون ن ثنْعَاش ن ثْقبَّاڒ ن أَيث-إِسْرَائِيل. <verse eid="REV 21:12" /><verse number="13" style="v" sid="REV 21:13" />ذِي شَّرْق ثْڒَاثَا ن ثوُّوْرَا، ذِي شَّمَال ثْڒَاثَا ن ثوُّوْرَا، ذِي لْجَنُوْب ثْڒَاثَا ن ثوُّوْرَا، ذِي ڒْغَرْب ثْڒَاثَا ن ثوُّوْرَا. <verse eid="REV 21:13" /><verse number="14" style="v" sid="REV 21:14" />ڒْحِيض ن ثنْدِينْت يبدّ خ ثنْعَاش ن دْسَاسَاث، يُوْرَا خَاسن يسمَاون ن ثنْعَاش ن اَرُّسُل ن يِزْمَار.<verse eid="REV 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 21:15" />لْمَلَاك نِّي ونِّي إِي غَارِي د يسِّيوْڒن غَارس ذݣ وفُوْس نّس يجّن ن ڒَعْبَر ن ؤُغَانِيم ن دّْهب يعبَّار زَّايس ثَنْدِينْت ذ ثِوُّوْرَا نّس ذ ڒْحِيض نّس. <verse eid="REV 21:15" /><verse number="16" style="v" sid="REV 21:16" />ثَنْدِينْت مُربَّع، أَم ثُوْزݣَّارْث نّس اَم ثِيْرِيْوْث نّس. يعْبَار ثَنْدِينْت س وغَانِيم نِّي يُوْفَا ذَايس اَڒفَاين أُو اَرْبعمِيَّات ن كِيْلُوْمِيت، أَم ثُوْزݣَّارْث نّس اَم ثِيْرِيْوْث نّس اَم ثُوْعْڒَات نّس. <verse eid="REV 21:16" /><verse number="17" style="v" sid="REV 21:17" />يعْبَار ڒْحِيض نّس يُوْفَا ذَايس مِيَّا أُو اَربعَا أُو اَرْبعِين ن ذرَّاع،<note caller="+" style="f"><char style="fr" closed="false">21‏.17 </char><char style="ft" closed="false">ئِجّن ستَّا أُو ستِّين مِيتر.</char></note> يعْنِي ڒَعْبَر لْمَلَاك نِّي اَم ڒَعْبَر ن بْنَاذم. <verse eid="REV 21:17" /><verse number="18" style="v" sid="REV 21:18" />ڒْحِيض نّس يبْنَا س ثزْرَا ن لْيَشب، ثَنْدِينْت ثبْنَا س دّْهب يصْفَان اَمشْنَاو جَّاج يصْفَان. <verse eid="REV 21:18" /><verse number="19" style="v" sid="REV 21:19" />دْسَاسَاث ن ڒْحِيض ن ثنْدِينْت زوّْقن س مْكُڒ نُّوْع ن ثزْرَا ثِصبْحَانِين. دْسَاس اَمزْوَارُو نتَّا ذ ثَزْرُوْت ن لْيَشب، دْسَاس وِيس ثْنَاين ذ لْيَقُوْت اَزيْزَا، دْسَاس وِيس ثْڒَاثَا ذ لْعَقِيق اَشمْڒَاڒ، دْسَاس وِيس أَربعَا ذ ثَزْرُوْت ثَزيْزَاوْث ن زُّمُرُّد، <verse eid="REV 21:19" /><verse number="20" style="v" sid="REV 21:20" />دْسَاس وِيس خمْسَا ذ جَّزع اَزݣّْوَاغ، دْسَاس وِيس ستَّا ذ لَعْقِيق اَزݣّْوَاغ، دْسَاس وِيس سبْعَا ذ ثَزْرُوْت ن زَّبَرْجَد، دْسَاس وِيس ثْمنْيَا ذ ثزْرُوْت ن بِيْرِّيل، دْسَاس وِيس تسْعَا ذ لْيَقُوْت اَوْرَاغ، دْسَاس وِيس عشْرَا ذ لْعَقِيق اَمرْبِيع، دْسَاس وِيس حِطَاش ذ ثَزْرُوْت ن فَيْرُوْز، دْسَاس وِيس ثنْعَاش ذ ثَزْرُوْت ن جَّمَشْت. <verse eid="REV 21:20" /><verse number="21" style="v" sid="REV 21:21" />ثنْعَاش نِّي ن ثوُّوْرَا نِثنْتِي ذ ثنْعَاش ن جُّوْهَرَاث، كُڒ ثَوَّارْث نتَّاث ذ جُّوْهَر. شَّارِع ن ثنْدِينْت نتَّا ذ دّْهب يصْفَان اَمشْنَاو جَّاج يصْفَان.<verse eid="REV 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22" />وَار ࢲْرِيغ شَا ثَمْزِيذَا ثَمقّْرَانْت ذِي ثنْدِينْت نِّي، مَايمِّي؟ لِأَنَّا سِيذِي أَربِّـي إݣ يزمَّرن إِ كُڒْشِي اَك يِزْمَار نِثْنِي إِݣ يدْجَان ذ ثَمْزِيذَا-يَا ثَمقّْرَانْت. <verse eid="REV 21:22" /><verse number="23" style="v" sid="REV 21:23" />ثَنْدِينْت-أَ وَار تحْذِيجِي شَا ثْفَاوْث ن ثْفُوْشْت نِغ ن ثْزِيرِي ڒَاحقَّاش لْعَظَمَا ن أَربِّـي نتَّاث إِي يتݣّن ذِنِّي ثْفَاوْث، ئِزْمَار ذ نتَّا ذ ڒفْنَار نّس. <verse eid="REV 21:23" /><verse number="24" style="v" sid="REV 21:24" />أَذ ؤُيُوْرن ڒݣْنُوْس ذِي ثْفَاوْث نّس، قَا يزدْجِيذن ن ثْمُوْرْث اَذ سِيذْفن لْهِمَّا نْسن ذِي <char style="it">ثنْدِينْت-أَ</char>. <verse eid="REV 21:24" /><verse number="25" style="v" sid="REV 21:25" />ثِوُّوْرَا نّس وَار تْبلِّيعنْت شَا نْهَار يكْمَاڒ قَاع ڒَاحقَّاش وَار ذِنِّي بُو دْجِيڒث. <verse eid="REV 21:25" /><verse number="26" style="v" sid="REV 21:26" />ذِنِّي اَذ سِيذْفن لْهِمَّا ذ ؤُوقَّار ن ڒݣْنُوْس. <verse eid="REV 21:26" /><verse number="27" style="v" sid="REV 21:27" />وَار ذِنِّي تَاذف ؤُڒَا ذ يجّن ن ثْمسْڒَايْث ثْوسّخ نِغ ذ يكْرُوْشَارن نِغ ذ يِنِّي يقَّارن يخرِّيقن. أَذ اَذْفن ذِنِّي غِير يِنِّي غَار دْجَان يسمَاون نْسن زمّْمن ذِي لْكِتَاب ن ثُوْذَارْث ن يِزْمَار.<verse eid="REV 21:27" /></para>
  <chapter eid="REV 21" />
  <chapter number="22" style="c" sid="REV 22" />
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1" />ئِسْمظْهَار-اَيي-د لْمَلَاك نِّي يغْزَار ن وَامَان ن ثُوْذَارْث صْفَان اَم جَّاج، ئِتفّغ-د زِي لْعَرْش ن أَربِّـي ذ يِزْمَار <verse eid="REV 22:1" /><verse number="2" style="v" sid="REV 22:2" />يتَازّڒ ذِي ڒْوسْط ن شَّارِع ن ثنْدِينْت. خ ثْنَاين ن يغزْذِيسن ن يِغْزَار-أَ ذِنِّي ثْشجَّارْث ن ثُوْذَارْث. تَارو ثنْعَاش ن ثْوَاڒَاثِين كُڒ شْهَار يجّن ن ثْوَاڒَا، أَفَر نّس ئِسْݣنْفَا ڒݣْنُوْس. <verse eid="REV 22:2" /><verse number="3" style="v" sid="REV 22:3" />زِي سّنِّي اَڒ ثْسَاونْت وَار ذِنِّي تِيڒِي بُو نَّعْڒث. لْعَرْش ن أَربِّـي ذ يِزْمَار اَذ يِيڒِي ذِي ثنْدِينْت-أَ، أَث عبْذن لْعِبَاد نّس. <verse eid="REV 22:3" /><verse number="4" style="v" sid="REV 22:4" />أَذْ ࢲرن اَغمْبُوْب نّس، ئِسم نّس اَقَاث خ ثنْيَارْث<note caller="+" style="f"><char style="fr" closed="false">22‏.4 </char><char style="ft" closed="false">ثَنْيَارْث نتَّاث ذ ثَوَارْنَا.</char></note> نْسن. <verse eid="REV 22:4" /><verse number="5" style="v" sid="REV 22:5" />زِي سّنِّي اَڒ ثْسَاونْت وَار ذِنِّي تِيڒِي بُو دْجِيڒث، وَار تحْذِيجِين شَا ثْفَاوْث ن ڒفْنَار نِغ ذ ثْفَاوْث ن ثْفُوْشْت ڒَاحقَّاش سِيذِي أَربِّـي نتَّا اَخَاسن يݣّ ثْفَاوْث نّس. أَذ حكْمن إِ ڒبْدَا ن ڒبْدَاث.<verse eid="REV 22:5" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتَاس-د</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6" />ينَّا-ٱيِي لْمَلَاك ونِّي: "أَوَاڒن-أَ ذَايْسن ڒَامَان ذَايْسن ڒْحَقّ. أَربِّـي نتَّا ذ مَوْلَانَا إِي د يسهْوَان لْوَاحِي خ لْأَنْبِيَا، ئِسّكّ-د لْمَلَاك نّس حمَا اَذ د يسْمظْهَار إِ يِنِّي ث يعبّْذن مِين لَابُد غَا يوقْعن عْڒَاين."<verse eid="REV 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7" />"نش اَقَا ؤُسِيْغ-د وَار تْعطَّاڒغ شَا! سَّعْذ ن يِنِّي يتݣّن اَرَّاي إِ وَاوَاڒن ن لْوَاحِي يدْجَان ذِي لْكِتَاب-أَ."<verse eid="REV 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8" />ذ نش يُوْحَنَّا إِي سْڒِيغ، ࢲْرِيغ ثِمسْڒَايِين-أَ. وَامِي سْڒِيغ، ࢲْرِيغ مَانَايَا، هْوِيغ اَذ سجّْذغ غَار يضَارن ن لْمَلَاك نِّي إِي ذَايِي د يسْمظْهَارن ثِمسْڒَايِين-أَ. <verse eid="REV 22:8" /><verse number="9" style="v" sid="REV 22:9" />ينَّا-ٱيِي: "لَّا! قَا نش ذ ڒْعَبْذ، أَم نش اَم شك اَم أَيثْمَاش لْأَنْبِيَا ذ مَارَّا يِنِّي يتݣّن اَرَّاي إِ وَاوَاڒن ن لْكِتَاب-أَ. سجّذ-اَس إِ أَربِّـي."<verse eid="REV 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 22:10" />ينَّا-ٱيِي: "وَار سْنُوْفَّر شَا اَوَاڒن-أَ ن لْوَاحِي ذِي لْكِتَاب-أَ، ڒَاحقَّاش ڒْوقْث ثُوْذس-د. <verse eid="REV 22:10" /><verse number="11" style="v" sid="REV 22:11" />ونِّي يتݣّن شَّرّْ اَذ يقِّيم يتݣّ شَّرّْ. ونِّي يخنْزن اَذ يقِّيم يتخْنِيز. ونِّي يدْجَان نِيشَان اَذ يقِّيم نِيشَان. ونِّي يدْجَان ذ اَمْقدّس اَذ يقِّيم ذ اَمْقدّس."<verse eid="REV 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12" />
    <char style="it">ئِنَّا عِيْسَى</char>: "نش اَقَا ؤُسِيغ-د وَار تْعطَّاڒغ شَا! أَذ د اَوِيغ تخْڒِيسث، أَذ جَازِيغ كُڒ يجّن عْلَاحْسَاب ڒخْذَايم نّس. <verse eid="REV 22:12" /><verse number="13" style="v" sid="REV 22:13" />نش ذ لْأَلِف نش ذ لْيَاء، نش ذ اَمزْوَارُو ذ اَنݣَّارُو. نش كُڒْشِي زَّايِي إِݣ يبْذَا، كُڒْشِي زَّايِي إِي غَا يكمّڒ. <verse eid="REV 22:13" /><verse number="14" style="v" sid="REV 22:14" />سَّعْذ ن يِنِّي يتْصبَّانن يتْشَامِّيرن نْسن، حمَا اَغَارْسن يِيڒِي ڒْحَقّ ذِي ثْشجَّارْث ن ثُوْذَارْث اَذ اَذْفن ثَنْدِينْت زِي ثوُّوْرَا نّس. <verse eid="REV 22:14" /><verse number="15" style="v" sid="REV 22:15" />غَار بَارَّا ن ثنْدِينْت دْجَان ذِنِّي يقْزِينن ذ يسحَّارن ذ يِنِّي يفسّْذن ذ يِنِّي ينقّن يوْذَان ذ ينِّي يعبّْذن لْأَصْنَام ذ مَارَّا يِنِّي يسْخرِّيقن إِي تْحِبَّان يخَرِّيقن.<verse eid="REV 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16" />ذ نش عِيْسَى سّكّغ-د لْمَلَاك ينُو حمَا اَذَاوم يشْهذ خ ثْمسْڒَايِين-أَ ذِي ثْجُمَاع ن ڒْمُوْمِنِين. نش ذ لْأَصْل ن دَاود أُو زِي دُّوْرِّيث نّس. نش ذ يثْرِي ن ڒفْجَر يتْشعْشِيعن."<verse eid="REV 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17" />أَرُّوْح ذ ثْسْڒِيث قَّارن: "أَرَاح-د!" ونِّي يتْسْڒَان اَذ يِينِي: "أَرَاح-د!" ونِّي يفُوْذن اَذ د يَاس، ونِّي يرزُّون اَمَان ن ثُوْذَارْث اَذ يسو بَاطڒ!<verse eid="REV 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18" />شهّْذغ نش خ مَارَّا يِنِّي يتْسْڒَان إِ وَاوَاڒن-أَ ن لْوَاحِي ذِي لْكِتَاب-أَ: ونِّي خَاسن غَا يَرْنِين، أَتَاف أَربِّـي اَس يَرْنِي لْمُصِيبَاث إِي د يُوْسِين ذِي لْكِتَاب-أَ. <verse eid="REV 22:18" /><verse number="19" style="v" sid="REV 22:19" />ونِّي غَا يكّْسن زݣ وَاوَاڒن-أَ ن لْوَاحِي ذِي لْكِتَاب-أَ، أَتَاف أَربِّـي اَس يكّْس ڒْحَقّ نّس زِي ثْمسْڒَايِين إِݣ يُوْرِين ذِي لْكِتَاب-أَ، يعْنِي ڒْحَقّ نّس ن ثْشجَّارْث ن ثُوْذَارْث ذ ڒْحَقّ نّس ن ثنْدِينْت يقدّْسن.<verse eid="REV 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20" />ئِقَّار عِيْسَى يعْنِي ونِّي يخبَّرن خ ثْمسْڒَايِين-أَ: "وَاه، نش أَقَا ؤُسِيغ-د وَار تْعطَّاڒغ شا!"</para>
  <para style="p" vid="REV 22:20">آمِين، أَرَاح-د آ سِيذِيثْنغ عِيْسَى.<verse eid="REV 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21" />أَذ يِيڒِي اَرْضَا ن سِيذِيثْنغ عِيْسَى اَك كُڒ يجّن. آمِين.<verse eid="REV 22:21" /></para>
  <chapter eid="REV 22" />
</usx>