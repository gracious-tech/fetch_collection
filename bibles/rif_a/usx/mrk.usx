<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- TarifitABS</book>
  <para style="h">مرقس</para>
  <para style="toc3">مرق</para>
  <para style="toc2">مرقس</para>
  <para style="toc1">أَسڒْمذ ن سِيذِيثْنغ عِيْسَى لْكِتَاب ن مَرْقُس</para>
  <para style="mt1">أَسڒْمذ ن سِيذِيثْنغ عِيْسَى</para>
  <para style="mt3">لْكِتَاب ن مَرْقُس</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">سِيذْنَا يَحْيَى يسوْجَاذ اَبْرِيذ إِ لْمَسِيح</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />أَمزْوَارُو ن لْإِنْجِيل ن عِيْسَى لْمَسِيح مِّيس ن أَربِّـي. <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />مَامّش يقَّار لْكِتَاب ن نَّبِي إِشَعْيَا:</para>
  <para style="q1" vid="MRK 1:2">&lt;أَقَا تْسكِّيغ-د يج ن اَرَّسُوْل ينُو زَّاثش،</para>
  <para style="q2" vid="MRK 1:2">حمَا اَذ يسوْجذ اَبْرِيذ نّش.<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />ثْمِيجَّا تْڒَاغَا ذِي ڒخْڒَا:</para>
  <para style="q2" vid="MRK 1:3">سْوجْذث اَبْرِيذ إِ سِيذِي أَربِّـي،</para>
  <para style="q2" vid="MRK 1:3">ݣّث يبْرِيذن نّس نِيشَان.&gt;<verse eid="MRK 1:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />يُوْسَا-د يَحْيَى غَار ڒخْڒَا. ئِتْبشَّر يوْذَان حمَا اَذ تُوْبن اَذ تْوَاطهَّارن س وَامَان حمَا اَذ تْوَاغْفَرنْت ڒْمُعْصِيَاث نْسن. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />تَاسن-د غَارس مَارَّا يمزْذَاغ ن ثْمُوْرْث ن يَهُوْذِيَا ذ مَارَّا يمزْذَاغ ن ثنْدِينْت ن لْقُدْس، تعْتَارَافن س ڒْمُعْصِيَاث نْسن، يَحْيَى يتْطهَّار-يثن س وَامَان ذݣ يِغْزَار ن لْأُرْدُن. <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />أَرُّوْض ن يَحْيَى خذْمن-ث س شْعَر ن وڒْغم، خ نّصّ نّس يجّن ن ؤُحزَّام ن يِيْڒم. ئِتتّ ثْمُوْرْغِي ذ ثَامَّانْت ثَحُوْرّشْت. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />ئِتْحدَّاث يقَّار: "منْبَعْد إِ نش اَذ د يَاس يجّن يجْهذ خَافِي، وَار سْذِيْهِيدْجغ نش اَذ اَذْرغ حمَا اَذَاس فسْيغ ؤُڒَا ذ يفِيْڒَان ن ثْسِيْڒَا نّس. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />نش طهَّارغ-كنِّيو س وَامَان، نتَّا اَكنِّيو يطهَّار س أَرُّوْح يقدّْسن."<verse eid="MRK 1:8" /></para>
  <para style="s">سِيذْنَا يَحْيَى يتْطهَّار إِ سِيذِيثْنغ عِيْسَى س وَامَان</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />ذِي ڒِيَّام نِّي يُوْسَا-د عِيْسَى زݣ وبِيلَاج ن نَاصِرَا إِي يدْجَان ذِي ثْمُوْرْث ن لْجَلِيل، يطهَّار-يث يَحْيَى س وَامَان ذݣ يِغْزَار ن لْأُرْدُن. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />وَامِي د يُوْڒِي زݣ وَامَان، ڒخْدّنِّي يࢲْرَا اَجنَّا ينُوْرْزم، ذ أَرُّوْح ن أَربِّـي يهوَّا-د خَاس يݣَّا اَم يِجّن ن ثذْبِيرْث. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />ذ يجّن ن ثْمِيجَّا زݣ وجنَّا ثقَّار: "شك ذ ممِّي يعِيزّن، نش فَرّْحغ زَّايَك."<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />ڒخْدّنِّ ي يُوْوِي-ث أَرُّوْح نِّي غَار ڒخْڒَا. <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />ئِكَّا ذِنِّي اَرْبعِين يُوْم يتْجرَّاب-يث شِّيطَان. أَقَاث مَانِي دْجَان ڒُوْحُوْش، تْسخَّارنْت خَاس لْمَلَائِكَاث.<verse eid="MRK 1:13" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى ئِتْڒَاغَا-د إِ يمحْضَارن نّس يمزْوُوْرَا</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />وَامِي حبّْسن يَحْيَى، يُوْيُوْر عِيْسَى يرُوْح غَار ثْمُوْرْث ن لْجَلِيل، ئِتْبشَّر ذِنِّي س لْإِنْجِيل ن أَربِّـي. <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />ئِقَّار-اَسن: أَقَا ڒْوقْث ثُوْوض-د، ڒْمُلْك ن أَربِّـي يُوْذس-د. تُوْبث، أَمْنث س لْإِنْجِيل.<verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />عِيْسَى وَامِي يݣُّوْر خ شّطّ ن ڒبْحَر ن لْجَلِيل، ئِࢲْرَا سِمْعَان ذ وُوْمَاس أَنْدْرُوُس نطَّرن ثْرَاشَّا ذِي ڒبْحَر مِينْزِي نِثْنِي ذ يحدْجَاقن ن يسڒْمَان. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />ينَّا-ٱسن عِيْسَى: "ذْفَارم-اَيِي-د، أَقَا ڒخُّو إِي كنِّيو غَا اَرّغ ذ يحدْجَاقن ن يِوْذَان." <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />ڒخْدّنِّي سمْحن ذِي ثْرَاشِّيوِين نْسن ذْفَارن-ث. <verse eid="MRK 1:18" /><verse number="19" style="v" sid="MRK 1:19" />ئِعْذُو شْوَايْت اَغِيرِين، ئِࢲْرَا يَعْقُوْب ذ يُوْحَنَّا نِثْنِي ذ ثَارْوَا ن زَبَادِي، أَقَاثن ذِي ثْغَرَّابُوْت عدّْڒن ثِرَاشِّيوِين. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />ڒخْدّنِّي يڒَغَا-يَاسن-د عِيْسَى، سمْحن ذِي بَابَاثْسن زَبَادِي إِݣ يدْجَان ذِي ثْغَرَّابُوْت اَك يخدَّامن نّس، ذْفَارن-ث.<verse eid="MRK 1:20" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسُوْفُوْغ يجّن ن جّنّ ذ اَعفَّان</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />ؤُذْفن غَار وبِيلَاج ن كَفرْنَاحُوْم. ذِي نْهَار ن سّبْث ن لْعِبَادَا يُوْذف عِيْسَى ذِي ثمْزِيذَا ن أَيث-إِسْرَائِيل يبْذَا يسڒْمَاذ ذِنِّي. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />تْعجّْبن ذݣ وسڒْمذ نّس ڒَاحقَّاش غَارس سُّلْطَا إِي زِي يسڒْمَاذ، وَار يدْجِي بُو اَمشْنَاو يمْسڒْمَاذن ن شَّرِيعَا. <verse eid="MRK 1:22" /><verse number="23" style="v" sid="MRK 1:23" />ڒخْدّنِّي ؤُفِين ذِي ثمْزِيذَا نِّي يجّن ن بْنَاذم ذَايس جّنّ ذ اَعفَّان. ئِڒَاغَا س جّْهذ جّنّ نِّي <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />ينَّا-ٱس: "مِين ثْرزُّوْذ زَّايْنغ آ عِيْسَى نَاصِرِي؟ مَا ثُوْسِيذ-د اَخَانغ ثقْضِيذ؟ نش قَا سّْنغ مِين ثعْنِيذ؛ شك ذ لْعَظِيم ن أَربِّـي!"<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />ئِنْهَا-ث عِيْسَى ينَّا-ٱس: "سْتُوْك شك، فّغ زَّايس!"<verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />ئِسرْجِيجَاي-يث جّنّ نِّي اَعفَّان يعيّض س يِجّن ن ثْمِيجَّا ثمْغَر يفّغ زَّايس. <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />ذهْشن مَارَّا يوْذَان نِّي نَّان إِ وَايَاوْيَا: "مِين يعْنَا مَانَايَا؟ أَسرْمذ-أَ ذ جْذِيذ، ذَايس سُّلْطَا! يتْأَمَر ؤُڒَا ذ جْنُون يعفَّانن، تݣّن-اَس اَرَّاي." <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />ڒخْدّنِّي ينْتَاشَر ڒخْبَار نّس ذِي مْكُڒ اَمْشَان ذِي جْوَايه ن لْجَلِيل.<verse eid="MRK 1:28" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا ثَذْݣّْوَاڒْث ن سِمْعَان</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />وَامِي د يفّغ زِي ثمْزِيذَا نِّي، يُوْسَا-د غَار ثدَّارْث ن سِمْعَان ذ أَنْدْرُوْس اَكِذس يَعْقُوْب ذ يُوْحَنَّا. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />يُوْفَا ثَذكّْوَاڒْث ن سِمْعَان ثزّڒ ذِي ثَاسُّوْث ذَايس ثِمسِّي. ڒخْدّنِّي عَاوْذن-اَس خَاس. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />ئِقَارّب غَارس يطّف-يت زݣ وفُوْس نّس يسْݣَعّذ-يت-يد. ثفّغ-يت ثْمسِّي، ثكَّر ثبْذَا تْسخَّار خَاسن.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />وَامِي ثغْڒِي ثْفُوْشْت غَار ثْمدِّيث، ؤُوِين-د غَارس مَارَّا يِنِّي يهڒْشن ذ يِنِّي ذِي دْجَان جْنُون، <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />مُوْنن مَارَّا أَيثْبَاب ن وبِيلَاج ذِنِّي غَار ثوَّارْث. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />ئِسْݣنْفَا اَطَّاس ن يمهْڒَاش ذَايْسن لْأَنْوَاع ن ڒهْڒَاشَاث. ئِسُوْفغ اَطَّاس ن جْنُوْن، وَار ثن يجِّي شَا اَذ سِّيوْڒن مِينْزِي جْنُوْن-أَ سّْنن مِين يعْنَا.<verse eid="MRK 1:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />ثِيوشَّا نّس زِيش وَامِي عَاذ وَار يصْبِيح شَا ڒْحَاڒ، ئِكَّر يفّغ يرُوْح غَار يِجّن ن ومْشَان يخْڒَا، ئِتْࢲَادْجَا ذِنِّي. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />يرْزُو خَاس سِمْعَان ذ يِنِّي كِذس يدْجَان. <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />وَامِي ث ؤُفِين نَّان-اَس: "مَارَّا رزُّون خَاك."<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />ينَّا-ٱسن: "يَالَّاهِيث اَكِذِي، أَ نْرَاح غَار ڒدْشُوْرَاث نّغْنِي يُوْذْسن حمَا اَذ حدّْثغ ؤُڒَا ذِنِّي. خ مَانَايَا مِيخف د ؤُسِيغ." <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />ئِرُوْح يتْحدَّاث ذِي ثمْزِيذَاوِين ن أَيث-إِسْرَائِيل ذِي مَارَّا ثَمُوْرْث ن لْجَلِيل يسُوْفُوْغ جْنُوْن.<verse eid="MRK 1:39" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا يجّن يهْڒش س جْذَام</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />يُوْسَا-د غَار عِيْسَى يجّن يهْڒش ذَايس جْذَام. يوْضَا خ يفَادّن نّس يحشّم-يث ينَّا-ٱس: "شك مڒَا ثخْسذ، ثْزمَّرذ اَذَايِي ثسِّيصْفِيذ."<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />ئِقّس-اَس إِ عِيْسَى، ئِحَاذَا-ث س وفُوْس نّس ينَّا-ٱس: "وَاه نش خْسغ، شك قَا ثْݣنْفِيذ!"<verse eid="MRK 1:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 1:42" />ذݣ ومْشَان يكّس-اَس جْذَام نِّي يذْوڒ يصْفَا. <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />ڒخْدّنِّي ئِسّكّ-يث عِيْسَى يوصَّا-ث اَطَّاس <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />ينَّا-ٱس: "خْزَر، وَار تْخبَّر حَدّ." ينَّا-ٱس: "رُوْح غَار ڒفْقِي سظْهَار-اَس يخف نّش. اݣّ صّذْقث نِّي إِي زِي يوصَّا مُوْسَى حمَا اَغَارْسن ثِيڒِي شْهَاذث خ مِين يوقْعن."<verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />وَلَكِن نتَّا مِين يݣَّا؟ ئِرُوْح يبْذَا يسَّاوَاڒ اَطَّاس، ئِسُوْفغ ڒخْبَار اَڒ وَامِي يذْوڒ عِيْسَى وَار يزمَّر اَذ يَاذف غَار شَا ن وبِيلَاج بْڒَا مَا ٱذ يسْنُوْفَّر يخف نّس. تُوْغَا لَابُد يتْغِيمَا ذݣ يمُوْشَان يخْوَان، وَلَكِن وَاخَّا اَمنِّي يوْذَان تَاسن-د غَارس ذِنِّي زِي مَارَّا يمُوْشَان.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا يجّن ن ونشْرُوْف</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />منْبَعْد إِ شَان وُوْسَّان، ئِذْوڒ-د عِيْسَى عَاوذ غَار وبِيلَاج ن كَفرْنَاحُوْم سْڒِين يوْذَان بلِّي اَقَاث ذِي ثدَّارْث. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />مُوْنن اَطَّاس ن ڒْغَاشِي يعمَّر ڒْحَاڒ اَڒ وَامِي وَار يقِّيم ؤُڒَا ذ يجّن ن ومْشَان وَاخَّا زَّاث إِ ثوَّارْث. ئِسَّاوَاڒ اَكِذْسن عِيْسَى س وَاوَاڒ ن أَربِّـي. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />ؤُسِين-د شَان يِوْذَان ؤُوِين-اَس-د يجّن ن ورْيَاز مُّوْثن-اَس يضَارن، يْسِين-ث اَرْبعَا إِذْسن <char style="it">خ ثَاسُّوْث نّس</char>. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />وَار زمِّيرن شَا اَث سِيذْفن غَار عِيْسَى مِينْزِي ذِنِّي اَطَّاس ن ڒْغَاشِي. قڒْعن سّْقف شْوَايْت رزْمن-ث، سهْوَان اَنشْرُوف نِّي خ ثَاسُّوْث نّس <char style="it">غَار وخَّام مَانِي يدْجَا عِيْسَى</char>.<verse eid="MRK 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 2:5" />وَامِي يࢲْرَا عِيْسَى لْإِيمَان نْسن، ينَّا-ٱس إِ ونشْرُوْف نّي: "آ مِّي تْوَاغْفَرنْت-اَش ڒْمُعْصِيَاث نّش."<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />شَان يمْسڒْمَاذن ن شَّرِيعَا إِي يقِّيمن ذِنِّي تْفكَّرن نَّان ذݣ وُوْڒَاون نْسن: <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />"مَامّش يسَّاوَاڒ بْنَاذم-أَ اَمُّو؟ ئِقَّار اَوَاڒ وَار يحْڒِين خ أَربِّـي. ؤُݣ يزمَّرن اَذ يغْفَر ڒْمُعْصِيَاث إِلَّا أَربِّـي وَاحْذس!؟"<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />ذغْيَا يسّن عِيْسَى ذِي نّفْس نّس مِين تْفكَّرن ذِي ڒَعْقُوْڒَاث نْسن ينَّا-ٱسن: "مَايمِّي تْفكَّرم اَمُّو كنِّيو ذِي ڒَعْقُوْڒَاث نْوم؟ <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />مِين يسهْڒن اَطَّاس اَذَاس ينِيغ إِ ونشْرُوْف-أَ، مَا ٱذَاس ينِيغ: تْوَاغْفَرنْت-اَش ڒْمُعْصِيَاث نّش؟ نِغ مَا ٱذَاس ينِيغ: كَّر شك، يْسِي ثَاسُّوْث نّش ؤُيُوْر؟ <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />نش خْسغ اَذ تسّْنم بلِّي مِّيس ن بْنَاذم غَارس سُّلْطَا خ ثْمُوْرْث حمَا اَذ يغْفَر ڒْمُعْصِيَاث." أُوْشَا ينَّا-ٱس عِيْسَى إِ ونشْرُوْف نِّي: <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />"أَذَاش ينِيغ، بدّ خ يضَارن نّش يْسِي ثَاسُّوْث نّش رُوْح اَذ تْروّْحذ غَار ثدَّارْث نّش!"<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />ڒخْدّنِّي يبدّ خ يضَارن نّس ييْسِي ثَاسُّوْث نّس يفّغ زَّاث إِ يِوْذَان مَارَّا. قِّيمن كُڒْشِي ذهّْشن حمّْذن أَربِّـي نَّان: "عمَّارْص مَا نࢲْرَا مَانَايَا يوْقع زِي قْبڒ."<verse eid="MRK 2:12" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى ئِتْڒَاغَا-د إِ لَاوِي</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />يفّغ عِيْسَى عَاوذ غَار طَّارْف ن ڒبْحَر، ؤُسِين-د غَارس مَارَّا ڒْغَاشِي يسڒْمَاذ-يثن ذِنِّي. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />وَامِي يعْذُو سّنِّي، يُوْفَا لَاوِي مِّيس ن حَلْفَى يقِّيم غَار مِيسَّا ذݣ ومْشَان مَانِي جمّْعن ضَّرِيبَا. ينَّا-ٱس عِيْسَى: "ذْفَار-اَيِي-د." أُوْشَا يكَّر يذْفَار-يث.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />ئِقِّيم عِيْسَى ذِي ثدَّارْث ن لَاوِي، يتتّ نتَّا ذ يمحْضَارن نّس. أَطَّاس ن يعشَّارن ذ يِنِّي يعصَّان زَعْمَا قِّيمن تتّن اَكِذس ڒَاحقَّاش اَطَّاس ن يِوْذَان إِي ث يذفَّارن. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />شَان يمْسڒْمَاذن ن شَّرِيعَا زِي ڒْحِزب ن يفَرِّيسِيّْين ؤُفِين عِيْسَى يتتّ اَك يعشَّارن<note caller="+" style="f"><char style="fr" closed="false">2‏.16 </char><char style="ft" closed="false">مِين عنَّان يعشَّارن؟ نِثْنِي زِي أَيث-إِسْرَائِيل خدّْمن اَك ڒْمخْزن ن اَرُّوْمَانُوْس جمّْعن ضَّرِيبَا زِي أَيثْمَاثْسن. ئِسْرَائِيلِيْين نّضْنِي قَّارن بلِّي يعشَّارن عصَّان اَطَّاس. عَاوذ اَزْين اَمقّْرَان ن يعشَّارن اَرنِّين شِي حَاجَا حمَا اَثنْت يْسِين إِ يِيخف نْسن.</char></note> ذ يِنِّي يعصَّان زَعْمَا، نَّان إِ يمحْضَارن نّس: "مَايمِّي يتتّ نتَّا اَك يعشَّارن ذ يِنِّي يعصَّان؟"<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />ئِسْڒَا-يَاسن عِيْسَى ينَّا-ٱسن: "ئِوْذَان يصحَّان وَار تحْذِيجِين بُو وضْبِيب، أَضْبِيب تحْذَاجَان-ث يمهْڒَاش." ينَّا-ٱسن: "نش وَار د ؤُسِيغ شَا اَذ ڒَاغِيغ إِ يِنِّي يدْجَان نِيشَان، ؤُسِيغ-د غَار يِنِّي يعصَّان."<verse eid="MRK 2:17" /></para>
  <para style="s">تْسقْسَان سِيذِيثْنغ عِيْسَى خ ثْࢲُوْمِيث</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />تُوْغَا يمحْضَارن ن يَحْيَى ذ يمحْضَارن ن ڒْحِزب ن يفَرِّسِيْين نِثْنِي تْࢲُوْمَّان. ؤُسِين-د يِوْذَان غَار عِيْسَى نَّان-اَس: "مَايمِّي يمحْضَارن ن يَحْيَى ذ يمحْضَارن ن ڒْحِزب ن يفَرِّسِيْين تْࢲُوْمَّان، ئِمحْضَارن نّش وَار تْࢲُوْمِّين شَا؟"<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />ينَّا-ٱسن عِيْسَى: "ئِمدُّوْكَاڒ ن مُوْڒَاي، مَا زمَّرن اَذ ࢲُوْمّن ذِي نْهَار نِّي ن ڒْفَارْح نّس؟ لَّا، خْمِي يتِيڒِي مُوْڒَاي اَكِذْسن وَار زمَّرن اَذ ࢲُوْمّن. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />وَلَكِن اَذ د اَسن وُوْسَّان اَذ يميْسِي مُوْڒَاي زِي ڒْوسْط نْسن، ڒخْدّنِّي اَذ ࢲُوْمّن ذي نْهَار نِّي.<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />وَار يدْجِي حَدّ يتْرقَّاع اَرُّوْض ذ ڒْبَاڒِي س يِجّن ن ثْرقِّيعْث ن تُّوْب ذ جْذِيذ، مَايمِّي؟ ڒَاحقَّاش ثَرقِّيعْث نِّي ن تُّوْب ذ جْذِيذ اَذ تْنجْمع اَذ تْوَاكّس زݣ وَارُّوْض نِّي ذ ڒْبَاڒِي. ڒخْدّنِّي اَذ يقِّيم وشَارِّيݣ يمْغَر! <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />ؤُڒَا ذ اَمَان ن وضِيڒ ذ جْذِيذ وَار خدْجْقن شَا ذݣ يِيڒمَاون يقْذِيمن، حمَا وَار دُّوْقُّوْزن وَار تْزدْجِيعن شَا وَامَان ن وضِيڒ اَذ ضيّْعن يِيڒمَاون نِّي. وَلَكِن اَمَان ن وضِيڒ ذ جْذِيذ خدْجْقن ذݣ يِيڒمَاون ذ جْذِيذ."<verse eid="MRK 2:22" /></para>
  <para style="s">مِين يدْجَان حَلَال ذِي نْهَار ن سّبْث ن لْعِبَدَا</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />ئِجّن ن نْهَار ن سّبْث ن لْعِبَدَا، ئِعْذُو عِيْسَى ذݣ وبْرِيذ ذِي ڒْوسْط ن يمنْدِي، ݣُّوْرن اَكِذس يمحْضَارن نّس بْذَان تكّْسن ثِيْذرِين. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />نَّان-اَس ڒبْعَاض زِي ڒْحِزب ن يفَرِّيسِيْين: "خْزَر! مَايمِّي يمحْضَارن نّش تݣّن مِين يدْجَان حْرَام ذِي نْهَار ن سّبْث ن لْعِبَدَا؟"<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "مَا وَار ثغْرِيم شَا مِين يݣَّا دَاود وَامِي يحْذَاج، ئِدْجُوْز نتَّا ذ يِنِّي اَكِذس؟ <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />يُوْذف غَار ثمْزِيذَا ن أَربِّـي ذِي زْمَان ن أَبْيَاثَار اَرَّايس ن ڒْفُقَهَا، يُوْفَا ذِنِّي اَغْرُوْم نِّي إِي يدْجَان ذ صّذْقث يشَّا نتَّا يُوْشَا-ٱسن إِ يِنِّي اَكِذس؛ وَاخَّا مَانَاينِّي وَار يدْجِي شَا حَلَال غِير إِ ڒْفُقَهَا وَاهَا."<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />أُوْشَا ينَّا-ٱسن: "نْهَار ن سّبْث ن لْعِبَدَا يتْوَاخْڒق إِ سَّبَاب ن بْنَاذم، مَاشِي ذ بْنَاذم يتْوَاخڒْقن إِ سَّبَاب ن نْهَار ن سّبْث ن لْعِبَدَا. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />ڒَاحقَّاش مِّيس ن بْنَاذم إِݣ يدْجَان ذ لْحَاكم حتَّا خ نْهَار ن سّبْث ن لْعِبَدَا."<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا يج ورْيَاز ذِي نْهَار ن سّبْث ن لْعِبَادَا</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />يُوْذف عِيْسَى عَاوذ غَار يِجّن ن ثمْزِيذَا ن أَيث-إِسْرَائِيل يُوْفَا ذِنِّي يجّن ن ورْيَاز فُوْس نّس يمُّوْث. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />تْلَاحَاضن خَاس مَا ٱث يسْݣنْفَا مَا لَّا ذِي نْهَار ن سّبْث ن لْعِبَادَا حمَا اَث تَاهْمن. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />ينَّا-ٱس عِيْسَى إِ ورْيَاز نِّي إِي غَار يدْجَا فُوْس يمُّوْث: "بدّ ذِي ڒْوسْط." <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />ئِسّقْسَا-ثن عِيْسَى ينَّا-ٱسن: "نْهَار ن لْعِبَادَا مَا حَلَال أَ نݣّ ڒْخِير نِغ أَ نݣّ شَّرّْ؟ أَ نْسنْجم نّفْس نِغ اَث نْنغ؟" وَلَكِن نِثْنِي سْقَارن. <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />ئِخْزَر غَارْسن يعصّب، ئِخيّق ڒَاحقَّاش ؤُڒَاون نْسن قسْحن. ينَّا-ٱس إِ ورْيَاز نِّي: "سَرّح فُوْس نّش." يسَرّح-يث أُوْشَا يذْوڒ وفُوْس نّس يݣنْفَا. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />ڒخْدّنِّي فّْغن ڒْحِزب ن يفَرِّيسِيْين مُوْنن اَك يِوْذَان زِي ڒْحِزب ن وزدْجِيذ هِيرُوْدُس، مْشَوَارن مَامّش إِي غَا ݣّن اَذ نْغن عِيْسَى.<verse eid="MRK 3:6" /></para>
  <para style="s">أَطَّاس ن يِوْذَان ذفَّارن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />ئِفّغ عِيْسَى اَك يمحْضَارن نّس يهْوَا غَار شّطّ ن ڒبْحَر، ئِذْفَار-يثن يجّن ن لْعَدَد ذ اَمقّْرَان ن يِوْذَان زِي ثْمُوْرْث ن لْجَلِيل ذ ثْمُوْرْث ن يَهُوْذِيَا، <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />ذ ثنْذِينْت ن لْقُدْس ذ ثْمُوْرْث ن إِدُوْمْيَا ذ ؤُجمَّاض-ين إِ يغْزَار ن لْأُرْدُن، عَاوذ زِي جْوَايه ن صُّوْر ذ صَيْدَا. ؤُسِين-د غَارس اَطَّاس ن ڒْغَاشِي وَامِي د اَرِّين ڒخْبَار إِ مَارَّا مِين يݣَّا.<verse eid="MRK 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 3:9" />ينَّا-ٱسن عِيْسَى إِ يمحْضَارن نّس: سْوجْذم-اَيِي يجّن ن ثْغَرَّابُوْت حمَا وَار خَافِي تمْزِيحِيمن ڒْغَاشِي-يَا. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />مِينْزِي نتَّا تُوْغَا يسْݣنْفَا اَطَّاس ن يِوْذَان اَڒ وَامِي مَارَّا يِنِّي ذِي يدْجَا ڒحْرِيق مْزَاحَامن خَاس، خْسن اَث حَاذَان. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />جْنُوْن يعفَّانن مڒْمِي مَا ࢲْرِين عِيْسَى، وطَّان غَار يضَارن نّس سْنكَّرن ثْغُوْيّث قَّارن: "آ شك ذ مِّيس ن أَربِّـي." <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />ئِوصَّا-ثن عِيْسَى اَطَّاس ينَّا-ٱسن: "وَار سَّاوَاڒث شَا حمَا وَار تْوَاسِّينغ شَا."<verse eid="MRK 3:12" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يخْضَر ثنْعَاش ن اَرُّسُل</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />ئِݣَعّذ عِيْسَى غَار وذْرَار يڒَاغَا-د خ يِنِّي يخس أُوْشَا ؤُسِين-د غَارس. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />ئِخْضَر زَّايْسن ثنْعَاش، ئِݣِّي-ثن ذ اَرُّسُل حمَا اَكِذس يڒِين اَثن يسّكّ اَذ حدّْثن، <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />اَغَارْسن ثِيڒِي سُّلْطَا حمَا اَذ سُوْفْغن جْنُوْن. <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />ثنْعَاش-أَ إِݣ يݣَّا نِثْنِي ذ سِمْعَان، يسمَّا-ث بُطْرُس، <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />ذ يَعْقُوْب ذ يُوْحَنَّا ثَارْوَا ن زَبَادِي، ئِسمَّا-ثن بُوْنَرْݣس (مَانَايَا يخس اَذ يِينِي ثَارْوَا ن وَاجَّاج)، <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />ذ أَنْدْرُوْس، ذ فِيلِيـپَّـاس، ذ بَارْتُوْلُوْمَاي، ذ مَتَّى، ذ تُوْمَا، ذ يَعْقُوْب مِّيس ن حَلْفَى، ذ تَدِّي، ذ سِمْعَان ؤُمِي قَّارن &lt;لْمُنَاضِل&gt;، <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />ذ يَهُوْذَا إِسْخَرْيُوْطِي يعْنِي ونِّي يزّنْزن عِيْسَى.<verse eid="MRK 3:19" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتْوَاجَاه يِنِّي يدْجَان ضد نّس</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />ئِروّح-د عِيْسَى غَار ثدَّارْث، مُوْنن-د عَاوذ ڒْغَاشِي اَڒ وَامِي وَار يزمَّر عِيْسَى ذ يمحْضَارن نّس اَذ شّن ؤُڒَا ذ اَغْرُوْم. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />وَامِي سْڒِين ڒحْبَاب نّس خ مَانَايَا، ؤُسِين-د حمَا اَث اَوِين اَكِذْسن نَّان قَا يرُوْح-اَس ڒَعْقڒ.<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />ئِمْسڒْمَاذن ن شَّرِيعَا إِي د يُوْسِين زِي لْقُدْس نَّان: "ذَايس بْعَلْزَبُوْل اَرَّايس ن جْنُوْن. ئِسُوْفُوْغ جْنُوْن مِينْزِي <char style="it">بْعَلْزَبُوْل</char> يُوْشَا-يَاس جّْهذ-أَ."<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />ئِڒَاغَا-د خَاسن عِيْسَى يسِّيوڒ اَكِذْسن س ڒمْعَانِي ينَّا-ٱسن: "مَامّش يݣَّا شِّيطَان اَذ يسُوْفغ شِّيطَان؟ <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />لْممْلَكَا إِي ذِي تْمنْغَان اَيْثْبَاب نّس يجّن اَك ونّغْنِي وَار ثْزمَّر اَذ تقِّيم. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />ثَدَّارْث إِي ذِي تْمنْغَان اَيثْبَاب نّس يجّن اَك ونّغْنِي وَار ثْزمَّر اَذ تقِّيم. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />مڒَا شِّيطَان يكَّر اَذ يقْضَا خ شِّيطَان، وَار يتْغِيمِي شَا، أَذ يفْنَا. <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" />وَار يزمَّر حَدّ اَذ يهْجم خ ثدَّارْث ن شَان يِجّن يجْهذ بَاش اَذ يَاشَار اَݣْڒَا نّس إِلَّا مڒَا يشدّ-يث ذ اَمزْوَارُو. أُوشَا اَذَاس يَاوِي مَارَّا مِين غَارس ذِي ثدَّارْث. <verse eid="MRK 3:27" /><verse number="28" style="v" sid="MRK 3:28" />أَقَا تسْڒَام ڒْحَقّ: أَذ تْوَاغْفَرنْت مَارَّا ڒْمُعْصِيَاث إِي تݣّن يِوْذَان ذ كُڒ اَوَاڒ نِّي وَار يحْڒِين إي قَّارن خ أَربِّـي. <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />وَلَكِن ونِّي غَا يِينِين شَان وَاوَاڒ وَار يحْڒِين خ أَرُّوْح يقدّْسن، وَار ذَاس يغفَّر لَّا ذِي دُّنشْت-أَ أُو لَّا ذِي لْأَخِيرَا." <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />مِينْزِي قَّارن قَا <char style="it">عِيْسَى</char> ذَايس يجّن ن جّنّ ذ اَعفَّان.<verse eid="MRK 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />ثُوْسَا-د غَارس يمَّاس ذ اَيْثْمَاس، بدّن بَارَّا <char style="it">إِ ثدَّارْث</char> سّكّن غَارس ڒَاغَان-د خَاس. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />ڒْغَاشِي نِّي قِّيمن نّْضن-اَس نَّان-اَس: "أَقَا يمَّاش ذ اَيْثْمَاش ذ سُوْيْثْمَاش ذِي بَارَّا رزُّوْن خَاك." <verse eid="MRK 3:32" /><verse number="33" style="v" sid="MRK 3:33" />ئِنْدق-د ينَّا-ٱسن: "مِين عْنَان يمَّا ذ اَيْثْمَا؟" <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />ئِخْزَر غَار يِنِّي يقِّيمن نّْضن-اَس أُوشَا ينَّا: "أَقَا يمَّا ذ اَيثْمَا." <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" /><char style="it">ينَّا-ٱسن:</char> "ونِّي يتݣّن س مِين يخس أَربِّـي، أَتَاف نتَّا ذ ؤُمَا ذ وتْشْمَا ذ يمَّا."<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">ڒْمَعْنَا ن ونِّي يزرّْعن</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />عَاوذ يبْذَا عِيْسَى يسڒْمَاذ خ طَّارْف ن ڒبْحَر. مُوْنن-د خَاس اَطَّاس ن ڒْغَاشِي، ئِكَّر نتَّا ينْيَا ذݣ يِجّن ن ثْغَرَّابُوت ذِي ڒْوسْط ن وَامَان يقِّيم ذَايس، ئِوْذَان قِّيمن مَارَّا ذِي ڒْبَرّ خ طَّارْف ن ڒبْحَر. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />ئِسڒْمَاذ-اَسن اَطَّاس ن ثْمسْڒَايِين س ڒمْعَانِي. ينَّا-ٱسن ذݣ وسڒْمذ نّس: <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />"صنّْطث، ئِفّغ وفدْجَاح اَذ يزْرع. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />وَامِي يزرّع، ثوْضَا-يَاس شَان زَّرِّيعث خ طَّارْف ن وبْرِيذ، ؤُسِين-د يجْضَاض شِّين-تث. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />شَان زَّرِّيعث ثوْضَا-يَاس جَار يِزْرَا وَار ذِنِّي بُو شَاڒ اَطَّاس. ثغْمِي-د ذغْيَا ڒَاحقَّاش وَار ثُوْدْجِيغ شَا ذِي ثْمُوْرْث اَطَّاس. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />وَلَكِن وَامِي ثْسُوْمَّر ثْفُوْشْت، ثْنزْڒف ڒخْدّنِّي ثِيسْرَاو ڒَاحقَّاش يࢲوْرَان نّس وَار ؤُوْثِين شَا غَار ڒَادْجغ ن ثْمُوْرْث. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />شَان زَّرِّيعث ثوْضَا جَار يسنَّانن. غْمِين-د اَكِذس يسنَّانن نِّي جيّْفن-تث وَار ثݣِّي بُو ثِيْذرِين. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />وَلَكِن شَان زَّرِّيعث ثوْضَا خ ثْمُوْرْث ثَصبْحَانْت، ثُوْڒِي-د ثمْغَر ثݣَّا ثِيْذرِين. ڒبْعَاض ݣِّينْت ثْڒَاثِين، ڒبْعَاض ݣِّينْت ستِّين، ڒبْعَاض ݣِّينْت مِيَّا." <verse eid="MRK 4:8" /><verse number="9" style="v" sid="MRK 4:9" />أُوشَا ينَّا-ٱسن عِيْسَى: "صنّط مْلِيح آ ونِّي يتْسْڒَان."<verse eid="MRK 4:9" /></para>
  <para style="s">أَسْفْهم ن ڒْمَعْنَا ن ونِّي يزرّْعن</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />وَامِي عِيْسَى يقِّيم وَاحْذس، سّقْسَان-ث يِنِّي ذَاس ينّْضن اَك ثنْعَاش ن يمحْضَارن خ ڒمْعَانِي-يَا. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />ينَّا-ٱسن: "ئِتْوَاسْمح إِ كنِّيو <char style="it">اَذ تسّْنم</char> مِين ينُوْفَّرن ذِي ڒْمُلْك ن أَربِّـي. يِنِّي زِي بَارَّا مَارَّا تَاس-اَسن-د س ڒمْعَانِي وَاهَا:<verse eid="MRK 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MRK 4:12" />&lt;وَاخَّا خزَّرن، وَار تْوِيڒِين شَا.</para>
  <para style="q1" vid="MRK 4:12">وَاخَّا تسْڒَان، وَار فهّْمن إِ شَا وَار تُوْبِين شَا،</para>
  <para style="q1" vid="MRK 4:12">وَار ذَاسن تْوَاغْفَرنْت ڒْمُعْصِيَاث نْسن.&gt;"<verse eid="MRK 4:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />ينَّا-ٱسن: "مَا وَار ثفْهِيمم ڒْمَعْنَا-يَا؟ إِيوَا، مَامّش غَا ثْفهْمم مَارَّا ڒمْعَانِي؟ <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />أَفدْجَاح نتَّا يزرّع أَوَاڒ ن أَربِّـي. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />زَّرِّيعث نِّي إِݣ يوْضَان خ وبْرِيذ نتَّاث اَم يِوْذَان إِي تسْڒَان إِ وَاوَاڒ ن أَربِّـي. ئِتْرَاح شِّيطَان ذغْيَا يتكّس اَوَاڒ نِّي يتْوَازرْعن ذَايْسن <char style="it">ذݣ وُوْڒ</char>. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />زَّرِّيعث نِّي إِݣ يوْضَان جَار يِزْرَا نتَّاث اَم يِوْذَان إِي تسْڒَان إِ وَاوَاڒ ن أَربِّـي قبْڒن-ث س ڒفْرَاحْث. <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />وَامِي وَار ؤُوْثِين بُو يࢲوْرَان مْلِيح ذغْيَا تْنقْڒَاعن. خْمِي د تَاسنْت شَان ڒمْحَاين نِغ ذ شَان وعدّب خ سَّبَاب ن وَاوَاڒ ن أَربِّـي، ذغْيَا تفّْغن اَبْرِيذ. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />زَّرِّيعث نِّي إِݣ يوْضَان جَار يسنَّانن نتَّاث اَم يِوْذَان إِي تسْڒَان إِ وَاوَاڒ ن أَربِّـي <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />ذَايْسن اَمْنُوْس ن دُّنشْت، يشمّث-يثن طّْمَع ن وَاݣْڒَا، ذَايْسن شّهَاوَاث ن ثْمسْڒَايِين نّغْنِي، سّنِّي يتْوَاجيّف وَاوَاڒ ن أَربِّـي وَار ينفّع شَا. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />وَلَكِن زَّرِّيعث نِّي إِݣ يوْضَان ذِي ثْمُوْرْث ثَصبْحَانْت نتَّاث اَم يِوْذَان إِي تسْڒَان إِ وَاوَاڒ ن أَربِّـي قبْڒن-ث تَارْون. ڒبْعَاض تَارْون ثْڒَاثِين، ڒبْعَاض ستِّين، ڒبْعَاض مِيَّا."<verse eid="MRK 4:20" /></para>
  <para style="s">ڒْمَعْنَا ن ڒْقنْدِيڒ</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />ينَّا-ٱسن: "ؤُڒَا ذ يجّن وَار د يتِّيوِي ڒْقنْدِيڒ حمَا اَخَاس يقْڒب اَقْنُوْش نِغ اَث يݣّ سْوَادَّاي إِ قَامَا؛ لَّا، ئِتݣّ-يث خ ڒْمَرْفَاع. <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />أَقَا مَارَّا مِين ينُوْفَّرن اَذ د يمظْهَار. مَارَّا مِين يتْوَاسْنُوْفَّرن اَذ ينفْضح. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />صنّط مْلِيح آ ونِّي يتسْڒَان."<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />ينَّا-ٱسن: "أَرّم-د ڒْبَاڒ نْوم إِ مِين تسْڒَام. ڒَعْبَر إِي ثْسخْذَامم ذ ونِّي إِي كِذْوم غَا يسخْذم أَربِّـي أُو عَاذ كْتَار. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />ڒَاحقَّاش ونِّي يدْجَان غَارس يتْمَارْنِي-يَاس. وَلَكِن ونِّي وَار غَار يدْجِي شَا، ئِتْوَاكْسِي-يَاس ؤُڒَا ذ مِين غَارس."<verse eid="MRK 4:25" /></para>
  <para style="s">ڒْمَعْنَا ن زَّرِّيعث يتمْغُوْرن</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />ينَّا-ٱسن عِيْسَى عَاوذ: "ڒْمُلْك ن أَربِّـي يݣَّا اَم يِجّن ن بْنَاذم يزرّع زَّرِّيعْث ذِي ثْمُوْرْث. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />ئِتطّص س دْجِيڒث يتْفَاق-د اَݣ صْبَاح يتَاف زَّرِّيعث تْݣَعَّاذ تمْغُوْر. نتَّا وَار يسِّين شَا مَامّش يوْقع مَانَاينِّي. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />مِينْزِي ثَمُوْرْث تِيشّ ثِحبَّا نّس نِّيث. ذ اَمزْوَارُو ثْغمِّي-د، ثْذوّڒ ذ ثِيْذرِين، ثِيْذرِين نِّي تْعمَّرنْت س ثْحبَّا. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />وَلَكِن غِير اَذ يوْجذ يمنْدِي، ڒخْدّنِّي اَذ يفّغ اَذ يمْجَار مِينْزِي ڒْوقْث ن ومْجَار ثُوْوض-د."<verse eid="MRK 4:29" /></para>
  <para style="s">ڒْمَعْنَا ن بُوْݣَرْذَاڒ</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />ينَّا-ٱسن عَاوذ: "مِينْذِي يتْشَابَّاه ڒْمُلْك ن أَربِّـي؟ نِغ س مِينْزِي غَا ث نْمثّل؟ <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />ڒْمُلْك ن أَربِّـي يݣَّا اَم يِجّن ن زَّرِّيعث ن يِجّن ن نُّوْع ن اَرْبِيع قَّارن-اَس بُوْݣَرْذَاڒ. خْمِي ت زرْعن ذِي ثْمُوْرْث تِيڒِي ذ ثَمزْيَانْت قَاع خ مَارَّا ثِحبَّا يدْجَان ذِي ثْمُوْرْث. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />وَلَكِن خْمِي ت زرْعن، تمْغَار ثْذوّڒ ذ تَمقّْرَانْت زِي مَارَّا اَرْبِيع ن ڒْعَرْسث تݣّ ڒفْرُوْع ذ يمقّْرَانن. ؤُڒَا ذ يجْضَاض تَاسن-د تݣّن ذَايس ڒَعْوَاش نْسن ذِي ثِيڒِي نّس."<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />ئِسَّاوَاڒ عِيْسَى اَݣ ڒْغَاشِي س وَاطَّاس ن ڒمْعَانِي اَم يِيْنَا عْلَاحْسَاب مِين زمَّرن اَذ فهْمن. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />وَار كِذْسن يسِّيوِيڒ شَا إِلَّا س ڒمْعَانِي، وَلَكِن يمحْضَارن نّس يسفْهَام-يثن مْلِيح خْمِي يتِيڒِي اَكِذْسن وَاحْذس.<verse eid="MRK 4:34" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يهدّن ڒبْحَر</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />نْهَار نِّي وَامِي د ثُوْوض ثْمدِّيث، ينَّا-ٱسن عِيْسَى إِ يمحْضَارن نّس: "يَالّه أَ نࢲْوَام غَار وجمَّاض-ين." <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />وَامِي سمْحن ذِي ڒْغَاشِي، ئِرُوْح عِيْسَى اَكِذْسن ذِي ثْغَرَّابُوْت نِّي إِي ذِي يدْجَا عَاذ. اَكِذس ذِنِّي ثِغَرُّوْبَا نّغْنِي. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />ئِكَّر-د يجّن ن اَرِّيح يجْهذ اَطَّاس ذِي ڒبْحَر، ڒمْوَاج شَّاثنْت ثَغَرَّابُوْت نِّي اَڒ وَامِي ثبْذَا تْعمَّر س وَامَان. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />ن تَّا يدْجَا غَار پُـوْپَّـا<note caller="+" style="f"><char style="fr" closed="false">4‏.38 </char><char style="ft" closed="false">پُـوْپَّـا قَّارن-ت إِ ذفَّار ن ثْغَرَّابُوت.</char></note> ن ثْغَرَّابُوْت يطّص يسُوْمّث يجّن ن ثْسُوْنْتَا.<note caller="+" style="f"><char style="fr" closed="false">4‏.38 </char><char style="ft" closed="false">ثْسُوْنْتَا نتَّاث ذ ثْسُوْمّت.</char></note> سْفَاقن-ث يمحْضَارن نَّان-اَس: "آ لْمُعَلِّم مَا وَار ش يتْهِيمِي شَا مَانَايَا؟ أَقَا نشِّين نتْمتَّا!" <verse eid="MRK 4:38" /><verse number="39" style="v" sid="MRK 4:39" />ئِكَّر يسْبدّ اَرِّيح ينَّا-ٱس إِ ڒبْحَر: "سْقَار، قْضع ڒْحِسّ!" أُوْشَا يبدّ اَرِّيح يرْسَا ڒْحَاڒ. <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />ينَّا-ٱسن: "مَايمِّي تݣّْوْذم قَاع اَمُّو؟ مَا عَاذ وَار ذَايْوم بُو لْإِيمَان؟" <verse eid="MRK 4:40" /><verse number="41" style="v" sid="MRK 4:41" />ݣّْوْذن اَطَّاس نَّان إِ وَايَاوْيَا: "مِين يعْنَا وَانِيتَان؟ ؤُڒَا ذ اَرِّيح ذ ڒبْحَر تْطَاعَان-اَس!"<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">ئِجّن ذَايس جْنُوْن ذِي ثْمُوْرْث ن يجَرِيثِيْين</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />ئِࢲْوَا عِيْسَى غَار وجمَّاض-ين ن ڒبْحَر غَار ثْمُوْرْث ن يجَرِيثِيْين. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />وَامِي يضْرَا زِي ثْغَرَّابُوْت يڒْقَا يجّن ن ورْيَاز ذَايس جّنّ ذ اَعفَّان يُوْسَا-د زݣ يمضْڒَان. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />يزدّغ ذِنِّي ذݣ يمضْڒَان. وَار يزمَّر ؤُڒَا ذ يجّن اَث يقّن وَاخَّا س سْنَاسڒ. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />أَطَّاس ن تْوَاڒَاثِين شرّْفن-ث زݣ يفَاسّن ذ يضَارن س سْنَاسڒ ذ لقْتِينَا وَلَكِن يقطّو سْنَاسڒ يتْرزَّا لقْتِينَا. وَار يزمَّر ؤُڒَا ذ يجّن اَث يطّف. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />ئِتِيڒِي دْجِيڒث ذ نْهَار ذݣ يمضْڒَان ذ يذُوْرَار يسْنكَّر ثْغُوْيّث يجَرّح يخف نّس س وزْرُو. <verse eid="MRK 5:5" /><verse number="6" style="v" sid="MRK 5:6" />وَامِي يࢲْرَا عِيْسَى زِي ڒݣّْوَاج، يُوْزّڒ غَارس يسجّذ-اَس. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />ئِنْدق-د س يِجّن ن ثْمِيجَّا ثجْهذ ينَّا-ٱس: "آ عِيْسَى آ مِّيس ن أَربِّـي يُوْعْڒَان، مِين ثخْسذ زَّايِي؟ تتَّارغ زَّايك إِ أَربِّـي حمَا وَار ذَايِي تْعدِّيبذ شَا!" <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" /><char style="it">ينَّا مَانَايَا</char> مِينْزِي عِيْسَى تُوْغَا ينَّا-ٱس: "آ جّنّ أَعفَّان فّغ زݣ ورْيَاز-أَ!"<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />ئِسقْسَا-ث عِيْسَى ينَّا-ٱس: "مَامّش ذَاش قَّارن؟"</para>
  <para style="p" vid="MRK 5:9">ينَّا-ٱس: "نش قَّارن-اَيِي أَبرُّو مِينْزِي نشِّين اَطَّاس إِذْنغ." <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />ئِحشّم-يث اَطَّاس حمَا وَار ثن يسّكِّي بَارَّا إِ جِّهث نِّي. <verse eid="MRK 5:10" /><verse number="11" style="v" sid="MRK 5:11" />ذِي ڒْوقْث نِّي ذِنِّي يجّن ن ثْحِيمرْث ذ ثَمقّْرَانْت ن يِيڒْفَان ثَرْوس خ وذْرَار. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />تَّارن زَّايس جْنُوْن نِّي نَّان-اَس: "سكّ-اَنغ غَار يِيڒْفَان-ين حمَا اَذَايْسن نَاذف." <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />وَامِي ثن يجَّا، فّْغن جْنُوْن نِّي يعفَّانن ؤُذْفن ذݣ يِيڒْفَان نِّي. ثُوْزّڒ ثْحِيمرْث نِّي ثهْوَا خ وذْرَار غَار ڒبْحَر ثغْرق ذِنِّي. تُوْغَا لْعَدَد نْسن عْڒَاين اَڒفَاين.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />يِنِّي يَروّْسن اَروْڒن سُوْفْغن ڒخْبَار ذِي ثنْدِينْت ذ ڒدْشُوْرَاث. فّْغن-د يِوْذَان حمَا اَذ خْزَرن مِين يوقْعن. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />ؤُسِين-د غَار عِيْسَى ؤُفِين اَرْيَاز نِّي إِي ذِي تُوْغَا يدْجَا اَبرُّو ن جْنُوْن يَرض اَرُّوض نّس يقِّيم يݣنْفَا س ڒَعْقڒ نّس. أُوْشَا ݣّْوْذن اَطَّاس. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />خْبَرن-ثن ڒشْهُوْذ خ مِين يوقْعن إِ ورْيَاز نِّي إِي ذِي تُوْغَا دْجَان جْنُوْن ذ مِين ذَاسن يوقْعن إِ يِيڒْفَان. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />أُوْشَا بْذَان تتَّارن زَّايس حمَا اَخَاسن يبعّذ زِي جِّهث نْسن.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />وَامِي تُوْغَا ينَّاي ذِي ثْغَرَّابُوْت، ئِتَّار زَّايس ورْيَاز نِّي إِي ذِي تُوْغَا دْجَان جْنُوْن ينَّا-ٱس: "اجّ-اَيِي اَكِش رَاحغ." <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />وَلَكِن عِيْسَى يُوْݣِي، ينَّا-ٱس: "رُوْح غَار ثدَّارْث نّش ذ ڒحْبَاب نّش سْخبَّر-يثن س مِين ذَاش يݣَّا سِيذِي أَربِّـي ذ مَامّش شك يرْحم." <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />ئِرُوْح ورْيَاز نِّي يبْذَا يتْخبَّار ذِي لْإِقْلِيم ؤُمِي قَّارن دِيكَاپْـلِس زِي مِين ذَاس يݣَّا عِيْسَى. قِّيمن يوْذَان نِّي مَارَّا ذهّْشن.<verse eid="MRK 5:20" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا يدْجِيس ن يَاݣْرُس</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />وَامِي يذْوڒ عِيْسَى ذِي ثْغَرَّابُوْت غَار جِّهث نِّي مَانِيس د يُوْسَا، مُوْنن-د خَاس ڒْغَاشِي ذ اَمقّْرَان خ شّطّ ن ڒبْحَر. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />يُوْسَا-د غَارس يجّن زِي اَرُّوْيَاس ن ثمْزِيذَا ن أَيث-إِسْرَائِيل قَّارن-اَس يَاݣْرُس. وَامِي يࢲْرَا عِيْسَى يوْضَا-يَاس غَار يضَارن نّس <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />يحشّم-يث اَطَّاس ينَّا-ٱس قَا يدْجِي ثَمزْيَانْت اَقَّا تْمتَّا. أَرَاح-د سرْس خَاس يفَاسّن نّش حمَا اَذ تْݣنْفَا اَذ تدَّر. <verse eid="MRK 5:23" /><verse number="24" style="v" sid="MRK 5:24" />ئِرُوْح اَكِذس ذْفَارن-ت اَطَّاس ن ڒْغَاشِي تمْزَاحَامن خَاس.<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />ذِنِّي يجّن ن ثمْغَارْث ثنْعَاش يسݣّْوُسَا زݣ وَامِي إِي ثهْڒش تَازّڒ س يذَامّن.<note caller="+" style="f"><char style="fr" closed="false">5‏.25 </char><char style="ft" closed="false">ئِذَامّن نتَّا ذ دّم.</char></note> <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />ثْعدّب اَطَّاس خ يفَاسّن ن وَاطَّاس ن يضْبِيبن. مَارَّا مِين غَارس ذ اَݣْڒَا ثْضيّع-يث بْڒَا نّْفَع. وَاخَّا اَمنِّي لْحَالَا نّس ثرْنِي. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />تسْڒَا خ عِيْسَى ثذْفَار-يث اَك ڒْغَاشِي ثْحَاذَا-يَاس اَسڒْهَام نّس. <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />ثنَّا ذݣ وُوْڒ نّس اَقَا مڒَا حَاذِيغ غِير اَسڒْهَام نّس اَتَاف اَذ ݣنْفِيغ. <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />ڒخْدّنِّي ثْݣنْفَا ذݣ ومْشَان ثسّن بلِّي دَّات نّس ثْݣنْفَا زِي ڒهْڒَاش نِّي.<verse eid="MRK 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 5:30" />عِيْسَى يسْحسّ ذِي نّفْس نّس بلِّي يجّن ن جّْهذ نّس يفّغ، ئِنقْڒب غَار ڒْغَاشِي نِّي ينَّا-ٱسن: "وِي ذَايِي يحَاذَان اَرُّوْض ينُو؟"<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />نَّان-اَس يمحْضَارن نّس: "خْزَر مشْحَاڒ ن يِوْذَان إِي ذَانِيتَا تمْزَاحَامن خَاك أُو شك ثقَّارذ وِي ذَايِي يحَاذَان؟"<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />وَلَكِن يقِّيم عَاذ يخزَّر اَمُّو ذ وَامُّو حمَا اَذ يࢲر وِي يݣِّين مَانَاينِّي. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />وَامِي ثسّن ثمْغَارْث نِّي مِين ذَاس يوقْعن ثݣّْوذ ترْجِيجِي، ثُوْسَا-د ثوْضَا غَار يضَارن نّس ثْعَاوذ-ٱس مَارَّا لْحَقِيقَا. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />ينَّا-ٱس: "آ يدْجِي، شم لْإِيمَان نّمْ يسْݣنْفَا-شم. رُوْح ذِي ڒهْنَا، ثݣنْفِيذ زِي ڒهْڒَاش نّم."<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />وَامِي عَاذ يسَّاوَاڒ عِيْسَى، ؤُسِين-د شَان يِوْذَان زِي ثدَّارث ن اَرَّايس نِّي ثمْزِيذَا نَّان-اَس: "يدْجِيش شك ثمُّوْث، مَايمِّي عَاذ تْسدَّاعذ لْمُعَلِّم؟" <verse eid="MRK 5:35" /><verse number="36" style="v" sid="MRK 5:36" />ئِسْڒَا-يَاسن عِيْسَى إِ مِين قَّارن، ينَّا-ٱس إِ اَرَّايس نِّي ن ثمْزِيذَا: "وَار تݣّْوذ شَا! ئِتْخصَّا اَذ تَامْنذ وَاهَا."<verse eid="MRK 5:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 5:37" />سّنِّي وَار يجِّي ؤُڒَا ذ يجّن اَث يذْفَار، يذْفَار-يث غِير بُطْرُس ذ يَعْقُوْب ذ يُوْحَنَّا يدْجَان ذ ؤُمَاس ن يَعْقُوْب. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />وَامِي ؤُوْضن غَار ثدَّارْث ن اَرَّايس نِّي ن ثمْزِيذَا، ئِتْوَاڒَا <char style="it">عِيْسَى</char> ذِنِّي لْهَرَج ذ يِوْذَان تْرُوْن سْغُوْيِيْون اَطَّاس. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />وَامِي يُوْذف ينَّا-ٱسن: "مَايمِّي ثسْغُوْيِيْوم، مَايمِّي ثتْرُوْم؟ أَقَا ثَحنْجِيرْث-أَ وَار ثمُّوْث شَا، ثطّص وَاهَا!"<verse eid="MRK 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40" />ضحْشن خَاس، ئِكَّر عِيْسَى يسُوْفغ-يثن مَارَّا سّنِّي. يُوْوِي اَكِذس ذِنِّي بَابَاس ذ يمَّاس ن ثْحنْجِيرْث نِّي ذ يِنِّي يرُوْحن اَكِذس. يُوْذف مَانِي ثدْجَا ثْحنْجِيرْث نِّي. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />ئِطّف-اَس ذݣ وفُوْس إِ ثْحنْجِيرْث نِّي ينَّا-ٱس: <char style="bd">طَلِيثَا قُوْمِي</char>، يعْنِي آ ثَحنْجِيرْث كَّر.<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />ڒخْدّنِّي ثكَّر ثْحنْجِيرْث نِّي ثبْذَا ثݣُّوْر. غَارس ثنْعَاش يسݣّْوُوْسَا. قِّيمن تْعجّْبن اَطَّاس. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />يُوْمَر-يثن عِيْسَى ينَّا-ٱسن وَار تْعَاوَاذم إِ حَدّ مِين يوقْعن. عَاوذ ينَّا-ٱسن ؤُشم-اَس اَذ تشّ.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">تَازّْڒن خ سِيذِيثْنغ عِيْسَى زݣ وبِيلَاج نّس</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />يفّغ سّنِّي عِيْسَى يذْوڒ غَار ثْمُوْرْث نّس، ذْفَارن-ث يمحْضَارن نّس. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />نْهَار ن سّبْث ن لْعِبَادَا، ئِبْذَا يسڒْمَاذ ذِي ثمْزِيذَا نِّي. مَارَّا يِنِّي ذَاس يتْسْڒَان قِّيمن تْعجّْبن ذَايس نَّان: "مَانِي يُوْفَا مَانَايَا؟ مِين ثعْنَا ڒفْهَامث-أَ إِي ذَاس يمُّوْشن؟ مَامّش يݣَّا لْمُعْجِيزَاث-أَ إِݣ يوقْعن خ يفَاسّن نّس؟ <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />مَا وَار يدْجِي شَا وَانِيتَا ذ اَنجَّار مِّيس ن مَرْيَم ؤُمَاس ن يَعْقُوْب ذ يُوْسِيس ذ يَهُوْذَا ذ سِمْعَان، سُوْيْثْمَاس اَقَاثنْت ذَانِيتَا اَكِذْنغ؟" خ مَانَاينِّي وَار ث قْبِيڒن شَا.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />ينَّا-ٱسن عِيْسَى: "نَّبي محْتَارم مَانِي مَا، وَلَكِن ذݣ وبِيلَاج نّس ذ ڒحْبَاب نّس ذ ثدَّارث نّس لَّا!" <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />وَار يزمَّر شَا اَذ يݣّ ذِنِّي لْمُعْجِيزَا، غِير يحَاذَا ذْرُوْس ن يمهْڒَاش س يفَاسّن نّس يسْݣنْفَا-ثن. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />يتْعجّب ڒَاحقَّاش لإِيمَان نْسن ذ وقْلِيل. سّنِّي يݣُّوْر يسڒْمَاذ زِي دْشَار غَار دْشَار إِي ث يُوْذْسن ذِنِّي.<verse eid="MRK 6:6" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسّكّ اَرُّسُل اَذ حدّْثن</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />ئِڒَاغَا-د عِيْسَى خ ثنْعَاش ن اَرُّسُل يسّكّ-يثن ثْنَاين ثْنَاين، يُوْشَا-اَسن سُّلْطَا اَذ حكْمن خ جْنُوْن يعفَّانن. <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />يوصَّا-ثن ينَّا-ٱسن: "وَار كِذْوم تَاوِيم وَالُو ذݣ وبْرِيذ، أَوِيم اَكِذْوم غِير اَعكَّاز. وَار كِذْوم تَاوِيم نِي اَغْرُوْم نِي اَقْرَاب نِي نّحَّاس ذݣ وحزَّام نْوم. <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />ݣّث ثِسِيڒَا، وَار تݣّم شَا ثْنَاين ن يتْشَامِّيرن." <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />ينَّا-ٱسن: "مَانِي مَا ثُوْذْفم غَار شَان ثدَّارْث، قِّيمم ذِنِّي اَڒ غَا ثُوْيُوْرم سّنِّي. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />مڒَا وَار كنِّيو قْبِيڒن شَا ذِي شَان ومْشَان نِغ وَار خْسن شَا اَغَارْوم صنّْطن، فّْغم سّنِّي مسْحث ثَعجَّاشْت زݣ يضَارن نْوم اَم شَا ن شْهَاذث خَاسن."<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />كَّرن نِثْنِي رُوْحن تْحدَّاثن إِ يِوْذَان حمَا اَذ تُوْبن. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />سُوْفْغن اَطَّاس ن جْنُوْن، ذهْنن إِ وَاطَّاس ن يمهْڒَاش س زّشْت سْݣنْفَان-ثن.<verse eid="MRK 6:13" /></para>
  <para style="s">ڒْموْث ن سِيذْنَا يَحْيَى</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />أَزدْجِيذ هِيرُوْدُس يَارَّا-د ڒخْبَار خ <char style="it">مِين يتݣّ</char> عِيْسَى مِينْزِي يسم نّس يذْوڒ مَعْرُوْف اَطَّاس. ذِنِّي شَان يِوْذَان قَّارن قَا وَانِيتَا يعْنِي ذ يَحْيَى نِّي، ئِتْوَاسكَّر-د نتَّا زِي ڒْموْث! س مَانَايَا إِي غَارس جّْهذ إِي زِي يتݣّ لْمُعْجِيزَاث-أَ.<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />ئِجّن يقَّار لَّا قَا وَانِيتَا ذ <char style="it">نَّبِي نِّي</char> إِلْيَاس.</para>
  <para style="p" vid="MRK 6:15">ئِجّن يقَّار لَّا قَا وَانِيتَا ذ يجّن ن نَّبِي اَمشْنَاو يجّن زِي لْأَنْبِيَا نِّي يقْذِيمن.<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />أَزدْجِيذ هِيرُوْدُس وَامِي يسْڒَا مَانَايَا، ينَّا قَا وَانِيتَا ذ يَحْيَى نِّي ؤُمِي قسّغ اَزدْجِيف، أَقَا يتْوَاسكَّر-د زِي ڒْموْث!<verse eid="MRK 6:16" /></para>
  <para style="p">
    <verse number="17‏-18" style="v" sid="MRK 6:17-18" />
    <char style="it">قْبڒ إِ مَانَايَا</char>، أَزدْجِيذ-أَ هِيرُوْدُس يمْڒش اَك يِجّن ن ثمْغَارْث قَّارن-أَس هِيرُوْدِيَا. هِيرُوْدُس نتَّا ذ اَڒْوس ن هِيرُوْدِيَا. تُوْغَا نتَّاث قْبڒ ذ ثَمْغَارْث ن فِيلِيـپَّـاس. ئِسّكّ هِيرُوْدُس اَذ طّْفن يَحْيَى وَامِي تُوْغَا ذَاس يقَّار: حْرَام شك اَذ تَاوِيذ ثَمْغَارْث ن وُوْمَاش. ئِحبّس-يث ذِي ڒحْبس. <verse eid="MRK 6:17-18" /><verse number="19" style="v" sid="MRK 6:19" />هِيرُوْدِيَا ثنْضَر ذَايس ثِيطَّاوِين ثْرزُّو اَث تْنغ وَلَكِن وَار ثْزمَّر. <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />مَايمِّي؟ ڒَاحقَّاش هِيرُوْدُس يتݣّْوذ زِي يَحْيَى. ئِسّن بلِّي نتَّا ذ يجّن ن ورْيَاز يدْجَا نِيشَان، ذ اَمْقدّس. ئِحمَّا-ث هِيرُوْدُس، ئِتعْجِيب-اَس خْمِي يتْحدَّاث وَلَكِن يتْغِيمَا يسْتْعجِّيب ذَايس اَطَّاس.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />ثُوْسَا-يَاس-د لْفُرْصَا إ هِيرُوْدِيَا وَامِي يݣَّا وزدْجِيذ هِيرُوْدُس ڒْعِيد لْمِيلَاد إِي يِخف نّس يݣَّا اَمنْسِي إِ يمقّْرَانن نّس ذ اَرُّوْيَاس ن ڒْعَسْكَار ذ يمقّْرَانن ن ثْمُوْرْث ن لْجَلِيل. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />ثُوْذف-د يدْجِيس ن هِيرُوْدِيَا ثشْضح، ئِعْجب-اَس ڒْحَاڒ إِ وزدْجِيذ ذ ينوْجِيْون نّس. ينَّا-ٱس وزدْجِيذ إِ ثْحنْجِيرْث نِّي: "تَّار-اَيِي مِين ثخْسذ، أَذَام ث ؤُشغ." <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />ئِجُّوْدْج-اَس ينَّا-ٱس: "مِين ذَايِي غَا ثتَّارذ اَذَام ث ؤُشغ، وَاخَّا اَزْين ن لْممْلَكَا ينُو."<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />ثفّغ ثنَّا-ٱس إِ يمَّاس: "مِين ذَاس غَا تَّارغ؟"</para>
  <para style="p" vid="MRK 6:24">ثنَّا-ٱس يمَّاس: "رزُّوْغ اَزدْجِيف ن يَحْيَى."<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />ڒخْدّنِّي ثذْوڒ ذغْيَا غَار ؤُزدْجِيذ، ثتَّار زَّايس ثنَّا-ٱس: "ڒخُّو خْسغ اَذَايِي ثُوْشذ ذَا اَزدْجِيف ن يَحْيَى خ سِّنِّيث!" <verse eid="MRK 6:25" /><verse number="26" style="v" sid="MRK 6:26" />ئِخيّق وزدْجِيذ اَطَّاس وَلَكِن يݣَّا-اَس اَرَّاي ڒَاحقَّاش يجُّودْج-اَس زَّاث إِ ينوْجِيْون نّس. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />ڒخْدّنِّي اَزدْجِيذ يسّكّ يج وعسَّاس غَار ڒحْبس، يُوْمَر-يث حمَا اَذ د يَاوِي اَزدْجِيف ن يَحْيَى. ئِرُوْح وعسَّاس نِّي يقسّ اَزدْجِيف ن يَحْيَى ذِي ڒحْبس. <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />يُوْوِي-ث-يذ خ سِّنِّيث، يُوْشَا-اَس-ث إِ ثْحنْجِيرْث نِّي، ثَحنْجِيرْث نِّي ثُوْشَا-اَس-ث إِ يمَّاس. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />وَامِي سْڒِين يمحْضَارن ن يَحْيَى مَانَايَا، ؤُسِين-د يْسِين دَّات نّس ݣِّين-ت ذݣ ونْضڒ.<verse eid="MRK 6:29" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسشّ خمْسَاڒَاف ن يرْيَازن</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />مُوْنن اَرُّسُل اَك عِيْسَى عَاوْذن-اَس خ مَارَّا مِين ݣِّين ذ مَارَّا مِين سڒْمَاذن. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />أَطَّاس ن يِوْذَان تَاسن-د تْرَاحن. <char style="it">عِيْسَى ذ يمحْضَارن نّس</char> وَار ؤُفِين ڒْوقْث وَاخَّا اَذ شّن. خ مَانَايَا ينَّا-ٱسن: "أَرَاحم-د وَاحذْوم غَار يجّن ن ومْشَان يخْڒَا اَذ تْريّْحم شْوَايت." <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />رُوْحن وَاحذْسن ذِي ثْغَرَّابُوت غَار يجّن ن ومْشَان يخْڒَا. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />ࢲْرِين-ثن اَطَّاس ن يِوْذَان وَامِي ݣُّوْرن. عقْڒن-ثن فّْغن ذغْيَا زِي مَارَّا يبِيلَاجن نِّي تَازّْڒن مَارَّا ذِنِّي خ يضَارن، ئِزْوَارن-اَسن غَار ومْشَان نِّي. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />وَامِي د يضْرَا عِيْسَى زِي ثْغَرَّابُوت يُوْفَا ذِنِّي ڒْغَاشِي نِّي، قّْسن-اَس مِينْزِي ݣِّين اَمشْنَاو يحُورِّيْين وَار غَارْسن شَا ؤُو ثن غَا يَروْسن. ئِبْذَا يسڒْمَاذ-اَسن اَطَّاس ن ثْمسْڒَايِين.<verse eid="MRK 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35" />وَامِي يعْذُو ڒْحَاڒ، قَارّْبن غَارس يمحْضَارن نّس نَّان-اَس: "ڒْوقْث ثعْذُو، أَمْشَان-أَ ذ ڒخْڒَا وَاهَا. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />سكّ يوْذَان-أَ غَار ڒدْشُوْرَاث ذ ثُوْذْرِين يُوْذْسن بَاش اَذ د سْغن مِين غَا شّن."<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />يَارَّا خَاسن عِيْسَى ينَّا-ٱسن: "ؤُشم-اَسن كنِّيو مِين غَا شّن."</para>
  <para style="p" vid="MRK 6:37">نَّان-اَس: "مَا اَ نْرَاح نشِّين أَ د نْسغ اَغْرُوْم س مِيَّاتَاين ن ثْپيَّاسِين ن نُّقَارْث، أَذَاسن ث نُوْش اَذ شّن؟"<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />ينَّا-ٱسن: "شْحَاڒ غَارْوم ن وغْرُوم؟ رُوْحث اَذ تخْزَرم."</para>
  <para style="p" vid="MRK 6:38">رُوْحن ؤُفِين شْحَاڒ نَّان-اَس: "غَارْنغ خمْسَا ن ثْخبَّازِين ذ ثْنَاين ن يسڒْمَان."<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />ئِكَّر عِيْسَى يُوْمَر-يثن حمَا اَثن سْغِيمن مَارَّا ذ لْفِرْقَاث خ اَرْبِيع اَزِيْزَا. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />ڒخْدّنِّي قِّيمن ذ لْفِرْقَاث خمْسِين خمْسِين، مِيَّا مِيَّا. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />ئِيْسِي خمْسَا نِّي ن ثْخبَّازِين ذ ثْنَاين نِّي ن يسڒْمَان ييْسِي ثِيطَّاوِين نّس غَار وجنَّا أُوشَا يشكَّر أَربِّـي. يرْزَا اَغْرُوْم نِّي يُوْشَا-اَسن-ث إِ يمحْضَارن نّس اَك ثْنَاين ن يسڒْمَان نِّي حمَا اَثن فرْقن خ يِوْذَان نِّي مَارَّا. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />شِّين جِّيوْنن مَارَّا. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />ڒخْدّنِّي يْسِين ثنْعَاش ن ثقْرَابِين عمَّرنْت س وغْرُوْم يشطّن اَك يسڒْمَان. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />لْعَدَد ن يِنِّي يشِّين اَغْرُوْم نِّي نِثْنِي خمْسَاڒَاف ن يرْيَازن.<verse eid="MRK 6:44" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يݣُّوْر خ ڒمْوَاج ن ڒبحَار</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />ڒخْدّنِّي عِيْسَى يسْني يمحْضَارن نّس ذِي ثْغَرَّابُوت بَاش اَذ زْوَان غَار وجمَّاض-ين ن ڒبْحَر غَار وبِيلَاج ن بَيْت صَيْدَا، نتَّا يتمْسَافَاض خ ڒْغَاشِي. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />وَامِي خَاسن يمْسَافَاض، نتَّا يرُوْح غَار وذْرَار اَذ يࢲَّادْج. <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />غَار ثْمدِّيث ثَغَرَّابُوت اَقَات ذِي ڒْوسْط ن ڒبْحَر، نتَّا اَقَاث ذِي ڒْبَرّ وَاحْذس. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />يࢲْرِي-ثن تْقدَّافن، تْعدَّابن مِينْزِي اَرِّيح يتْصُوْض-د زِي جِّهث نّغْنِي. عْڒَاين يقَارّب-د ڒفْجَر، ئِرُوْح عِيْسَى غَار يمحْضَارن نّس يݣُّوْر خ يضَارن خ وَامَان ن ڒبْحَر يخس اَثن يعْذُو. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />وَامِي ث ؤُفِين يݣُوْر خ يضَارن خ وَامَان ن ربْحَار، تْغِير-اَسن ذ ڒخْيَاڒ بْذَان سْنكَّرن ثْغُويِّيث. <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />مَارَّا ࢲْرِين-ث ݣّْوْذن. وَلَكِن ذغْيَا ينَّا-ٱسن: "أَهْنَام! أَقَا ذ نش، وَار تݣّْوْذم شَا!" <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />ئِنْيَا اَكِذْسن ذِي ثْغَرَّابُوت، يرْسَا اَرِّيح. تْعجّْبن اَطَّاس ذِي نّفْس نْسن <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />مِيزِي تُوْغَا وَار فْهِيمن شَا لْمُعْجِيزَا نِّي ن وغْرُوْم، ؤُڒَاون نْسن تْوَاقْسْحن.<verse eid="MRK 6:52" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا اَطَّاس ن يِوْذَان ذِي جْوَايه ن ݣَنِيسَارَت</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />ئِࢲْوَا عِيْسَى ذ يمحْضَارن نّس ڒبْحَر، ؤُوْضن غَار ثْمُوْرْث ن ݣَنِيسَارَت قّْنن ذِنِّي ثَغَرَّابُوت. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />وَامِي ضْرِين زِي ثْغَرَّابُوت، ڒخْدّنِّي اَيثْبَاب ن ثْمُوْرْث نِّي عقْڒن عِيْسَى. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />تَازّْڒن-د زِي ثَمُوْرْث نِّي مَارَّا، بْذَان تَاوِين-د يمهْڒَاش خ ثَاسُّوْث غَار مَانِي سْڒِين يقِّيم نتَّا. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />مَانِي مَا يُوْذف غَار يبِيلَاجن نِغ غَار ثْندَّام نِغ غَار ڒْكَامْپَاوَاث، ئِوْذَان سْرُوْسَان يمهْڒَاش ذِي ڒسْوَاق. تتَّارن-اَس اَثن يجّ اَذ حَاذَان غِير طَّارْف ن وَارُّوض نّس. صَافِي مَارَّا يِنِّي ث يحَاذَان ݣنْفَان.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">لْعَادَاث نِّي إِي وَار د يُوْسِين شَا زِي أَربِّـي</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />ڒْحِزب ن يفَرِّيسِيْين ذ شَان يمْسڒْمَاذن ن شَّرِيعَا زِي لْقُدْس مُوْنن-د خ عِيْسَى. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />ࢲْرِين شَان يمحْضَارن نّس تتّن اَغْرُوْم بْڒَا مَا ٱذ سِيرْذن يفَاسّن، يعْنِي بْڒَا مَا ٱذ ݣّن ڒُوْضُو نِّي. <verse eid="MRK 7:2" /><verse number="3" style="v" sid="MRK 7:3" />ڒَاحقَّاش يفَرِّيسِيْين ذ مَارَّا أَيث-إِسْرَائِيل مڒَا وَار سِيرْذن شَا يفَاسّن نْسن وَار تتّن شَا، مِينْزِي طّْفن اَطَّاس ذِي لْعَادَاث ن ڒجْذُوْذ نْسن. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />مڒْمِي مَا د ذوّْرن زِي سُّوق، مڒَا وَار سِيرْذن شَا اَتَاف وَار تتّن شَا. أَطّاس ن ڒحْوَايج نّغْنِي إِي ذْفَّارن، ڒمْذن-ثن تطّْفن-ثن <char style="it">أُو صَافِي</char>، أَمشْنَاو اَسِيرذ ن ڒْكِيسَان ذ يغَرَّافن ذ ڒقْشُوْع ن نّحَّاس ذ ثَاسُّوْث.<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />سّقْسَان-ث يفَرِّيسِيْين ذ شَان يمْسڒْمَاذن ن شَّرِيعَا نَّان-اَس: "مَايمِّي يمحْضَارن نّش وَار تݣّن شَا لْعَادَاث ن ڒجْذُوذ نّغ؟ مَايمِّي وَار سِيرِيذن شَا يفَاسّن نْسن قْبڒ مَا ٱذ شّن اَغْرُوْم؟"<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />ينَّا-ٱسن عِيْسَى: "آ لْمُنَافِقِين! قَا <char style="it">نَّبي</char> إِشَعْيَا ينَّا ڒْحَقّ وَامِي خَاوم يسِّيوڒ ذݣ يِجّن ن زْمَان:</para>
  <para style="q1" vid="MRK 7:6">&lt;شَّعْب-أَ يتْوقَّار-اَيِي س ؤُقمُّوْم وَاهَا،</para>
  <para style="q2" vid="MRK 7:6">مَاشَا ؤُڒ نّس يݣّْوج خَافِي.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />ئِوْذَان-أَ عبّْذن-اَيِي ذِي ڒْخَاوِي،</para>
  <para style="q2" vid="MRK 7:7">ڒَاحقَّاش سڒْمَاذن ثِمسْڒَايِين</para>
  <para style="q2" vid="MRK 7:7">ئِدْجَان ذ ڒُوْصِيَاث ن بْنَاذم وَاهَا.&gt;<verse eid="MRK 7:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />كنِّيو ثجِّيم ڒُوْصِيّث ن أَربِّـي، ثطّْفم ذِي لْعَادَاث ن يِوْذَان أُو صَافِي." <verse eid="MRK 7:8" /><verse number="9" style="v" sid="MRK 7:9" />ينَّا-ٱسن عَاوذ: "إِيوَا! تْبطَّاڒم ڒُوْصِيّث ن أَربِّـي حمَا اَذ قِّيمنْت لْعَادَاث نْوم! <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />مُوْسَى، مِين ينَّا؟ ينَّا: وقَّر بَابَاش ذ يمَّاش. أَقَا ونِّي غَا يُوْكَّارن بَابَاس نِغ ذ يمَّاس، أَتَاف يتْخصَّا-يَاس اَذ يمّث. <verse eid="MRK 7:10" /><verse number="11‏-12" style="v" sid="MRK 7:11-12" />وَلَكِن كنِّيو ثقَّارم بلِّي وَار يدْجِي بُو لَابُد إِ يِوْذَان اَذ وقَّرن نِغ اَذ عَاوْنن لْوَالِدِين. تْمنْيَاث نِّي إِي غَا ؤُشن إِ لْوَالِدِين نْسن اَثنْت ؤُشن إِ ثمْزِيذَا. <verse eid="MRK 7:11-12" /><verse number="13" style="v" sid="MRK 7:13" />أَمُّو كنِّيو ثْبدّْڒم ڒْمَعْنَا ن وَاوَاڒ ن أَربِّـي حمَا اَذ تݣّم مَامّش ذَاوم يعْجب ڒْحَاڒ س لْعَادَاث نْوم إي ثْڒمْذم. تݣّم اَطَّاس ن ثْمسْڒَايِين اَمشْنَاو ثِيْنَا."<verse eid="MRK 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />ئِڒَاغَا-د عِيْسَى عَاوذ خ ڒْغَاشِي-يَا ينَّا-ٱسن: "صنّْطث غَارِي مَارَّا إِذْوم، فهْمث: <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />مَا ذِنِّي شَا ن ثْمسْڒَايْث يتَاذْفن ذِي بْنَاذم زِي بَارَّا تْحَرَّام-يث؟ لَّا، وَالُو. أَقَا مِين د يتفّْغن زِي بْنَاذم اَقَا ذ مَانَاينِّي إِي ث يتْحَرَّامن. <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />{صنّط مْلِيح آ ونِّي يتْسْڒَان!}"<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />وَامِي يجَّا ڒْغَاشِي، يُوْذف غَار ثدَّارْث. سّقْسَان-ث يمحْضَارن خ ڒْمَعْنَا-يَا مِين تخْس اَذ تِينِي. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />ينَّا-ٱسن: "ؤُڒَا ذ كنِّيو عَاذ وَار ثفْهِيمم شَا؟ مَا وَار ثسِّينم بلِّي مَارَّا مِين يتَاذْفن ذِي بْنَاذم زِي بَارَّا وَار ث يتْحَرِّيم شَا؟ <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />مِينْزِي وَار يتِّيذف شَا غَار وُوْڒ نّس. لَّا، يتْرَاح غَار وعدِّيس يتفّغ زِي دَّات." (س مَانَايَا عِيْسَى يَارَّا مَارَّا لْمَكْلَا حَلَال.) <verse eid="MRK 7:19" /><verse number="20" style="v" sid="MRK 7:20" />ينَّا-ٱسن: "وَلَكِن مِين د يتفّْغن زݣ <char style="it">وقمُّوْم ن</char> بْنَاذم ذ مَانَايَا يتْحَرَّامن بْنَاذم. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />مَايمِّي؟ ڒَاحقَّاش زِي ذَاخڒ يعْنِي زݣ وُوْڒ ن بْنَاذم إِي زِي د تكَّانْت لْأَفْكَار ثِعفَّانِين ذ لْفَسَاد ذ ثُوْكَّارْذَا ذ ثْمنْغِيوْث <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />ذ زّْنَا ذ طّْمَع ذ شَّرّْ ذ ڒْبَاطڒ ذ يخَرْوِيضن ذ ڒقْبَاحث ذ ثِيطَّاوِين ن يِوْذَان ذ تَّكبُّر ذ ثِبُوْهْڒِيَا. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />مَارَّا ثِمسْڒَايِين-أَ ثِعفَّانِين تفّْغنْت-يد زِي ذَاخڒ ن بْنَاذم تْحَرَّامنْت بْنَاذم."<verse eid="MRK 7:23" /></para>
  <para style="s">لْإِيمَان ن ثمْغَارْث ن اَيْث-كَنْعَان</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />ئِكَّر عِيْسَى يُوْيُوْر سّنِّي يرُوْح غَار جْوَايه ن ثنْدِينْت ن صُوْر يُوْذف ذݣ يِجّن ن ثدَّارْث. يرزُّو وَار يتسّن حَدّ بلِّي اَقَاث ذِنِّي وَلَكِن يوْذَان اَرِّين-د ڒخْبَار. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />ذِنِّي يجّن ن ثمْغَارث يدْجِيس ذَايس جّنّ ذ اَعفَّان. وَامِي د ثَارَّا ڒخْبَار ذغْيَا ثُوْسَا-د غَار عِيْسَى ثوْضَا-يَاس غَار يضَارن نّس. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />ثَمْغَارْث نِّي ذ ثَيُوْنَانِيث، لْأَصل نّس زِي سُوْرْيَا فِنِيقْيَا. ثتَّار زَّايس اَطَّاس حمَا اَذ يسُوْفغ جّنّ نِّي اَعفَّان زݣ يدْجِيس.<verse eid="MRK 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27" />ينَّا-ٱس عِيْسَى: "اجّ بَعْدَا يحنْجِيرن اَذ جَّاوْنن. مَاشِي مَعْقُوْل اَذ يتْوَاكّس وغْرُوْم ن يحنْجِيرن اَذ يمنْضَار إِ يقْزِينن."<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />ثَارَّا خَاس ثمْغَارْث نِّي ثنَّا-ٱس: "غَارك ڒْحَقّ آ سِيذِي، وَلَكِن ؤُڒَا ذ يقْزِينن نِّي يدْجَان سْوَادَّاي ن طَبْڒَا تتّن يفتْوِيتّن ن وغْرُوْم <char style="it">إِݣ يتْوطَّان</char> زݣ يحنْجِيرن."<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />ينَّا-ٱس عِيْسَى: "عْلَاحْسَاب اَوَاڒ-أَ إِي ثنِّيذ شم، رُوْح اَقَا جّنّ نِّي يفّغ زݣ يدْجِيم." <verse eid="MRK 7:29" /><verse number="30" style="v" sid="MRK 7:30" />وَامِي ثذْوڒ غَار ثدَّارْث نّس، ثُوْفَا يدْجِيس ثࢲّڒ ذِي ثَاسُّوْث نّس يفّغ زَّايس جّنّ نِّي.<verse eid="MRK 7:30" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا يجّن ن وذهْشُوْر</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />يفّغ عِيْسَى عَاوذ زي جْوَايه نِّي ن صُوْر يكَّا خ ثْمُوْرْث ن صَيْدَا، ئِرُوْح غَار ڒبْحَر ن لْجَلِيل ذ لْإِقْلِيم نِّي ؤُمِي قَّارن دِيكَاپْـلِس. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />ؤُوِين-اَس-د يجّن ن وذهْشُوْر ذ اَزيْنُوْن، تَّارن إِ عِيْسَى اَخَاس يسرْس فُوْس نّس. <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />ئِسْبعّذ-يث عِيْسَى خ ڒْغَاشِي غَار يجّن ن جِّهث نّغْنِي، ئِݣَّا يضُوْضَان نّس ذݣ يمجُّوْنن ن ورْيَاز نّي. يسُّوْسف عِيْسَى، ئِحَاذَا-يَاس يڒس نّس. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />ئِيْسِي ثِيطَّاوِين نّس غَار وجنَّا يسُّوْحرث ينَّا: "إِفَاتَح!" (أَوَاڒ-أَ يخس اَذ يِينِي تْوَارْزْمن.) <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />ڒخْدّنِّي إِي ݣنْفَان يمجُّوْنن نّس يضْڒق يڒس نّس، ئِبْذَا يسَّاوَاڒ نِيشَان. <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />ئِوصَّا-ثن ينَّا-ٱسن وَار تْعَاوَاذم مَانَايَا إِ حَدّ. وَلَكِن نِثْنِي مشْحَاڒ مَا يوصَّا-ثن تْخبَّرن خَاس اَطَّاس. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />تْعجّْبن اَطَّاس نَّان: مَارَّا مِين يتݣّ ذ اَصبْحَان. ئِتَارَّا حتَّا ذ يذهْشُوْرن تسْڒَان، حتَّا ذ يزيْنُوْنن سَّاوَاڒن."<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">سِيذِيثْنغ عِيْسَى يسشّ اَرْبعَاڒَاف ن يِوْذَان</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />ذِي ڒِيَّام نِّي، مُوْنن-د خَاس عَاوذ ڒْغَاشِي اَطَّاس أُو نِثْنِي وَار غَارْسن مِين غَا شّن. ئِڒَاغَا-د عِيْسَى إِ يمحْضَارن نّس ينَّا-ٱسن: <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />"نش قّْسن-اَيِي يِوْذَان-أَ. ثڒْتِيَّام زݣ وَامِي اَقَاثن اَكِذِي وَار غَارْسن شَا مِين غَا شّن. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />مڒَا سّكّغ-ثن غَار ثُوْذْرِين نْسن وَار شِّين شَا اَتَاف اَذ سخْفن ذݣ وبْرِيذ، ذِنِّي شَا زَّايْسن ؤُسِين-د زِي ڒݣّْوَاج."<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />نَّان-اَس يمحْضَارن نّس: "ذِي ڒخْڒَا-يَا مَانِي غَا نَاف اَغْرُوْم إِي زِي غَا نْسشّ قَاع لْعَدَد-أَ ن يِوْذَان؟"<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />ينَّا-ٱسن عِيْسَى: "شْحَاڒ غَارْوم ن وغْرُوْم؟"</para>
  <para style="p" vid="MRK 8:5">نَّان-اَس: "غَارْنغ سبْعَا ن ثشْنِيفِين."<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />يُوْمَر عِيْسَى ڒْغَاشِي نِّي اَذ قِّيمن ذِي ثْمُوْرْث. ئِطّف سبْعَا نِّي ن ثشْنِيفِين يشكَّر أَربِّـي، يرْزِي-ثنْت يُوْشِي-ثنْت إِ يمحْضَارن نّس اَثنت فرْقن خ يِوْذَان نِّي. ڒخْدّنِّي فرْقن-ثنْت. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />غَارْسن ذِنِّي عَاوذ ڒبْعَاض ن يسڒْمَان ذ يمزْيَانن. عِيْسَى يشكَّر أَربِّـي ينَّا-ٱسن: "فرْقم ؤُڒَا ذ يِيْنَا خ يِوْذَان-أَ." <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />شِّين جِّيوْنن، شطّنْت سبْعَا ن ثقْرَابِين عمَّرنْت س يڒقُّوْزن. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />تُوغَا ذِنِّي شَان اَرْبعَاڒَاف ن يِوْذَان. سّنِّي يمْسَافَاض خَاسن ؤُيُوْرن. <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />ڒخْدّنِّي ينْيَا عِيْسَى ذݣ يِجّن ن ثْغَرَّابُوْت اَك يمحْضَارن نّس يرُوْح غَار جْوَايه ن دَلْمَانْيُوْثَا.<verse eid="MRK 8:10" /></para>
  <para style="s">ئِوْذَان وَار تفْهِيمن شَا مِين عْنَانْت لْمُعْجِيزَاث ن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />ؤُسِين-د غَارس ڒْحِزب ن يفَرِّيسِيْين بْذَان تْمنْغَان اَكِذس، تَّارن زَّايس يجّن ن لْعَلَامَا ثَمقّْرَانْت زݣ وجنَّا بَاش اَث جَرّْبن. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />ئِحْرق وُوْڒ نّس اَطَّاس ينَّا-ٱسن: "مَايمِّي يوْذَان ن ڒْوقْث-أَ تتَّارن لْعَلَامَا ثَمقّْرَانْت؟ أَقَا تسْڒَام ڒْحَقّ: ئِوْذَان ن ڒْوقْث-أَ وَار ذَاسن تِيشّ بُو لْعَلَامَا ثَمقّْرَانْت، قَاع."<verse eid="MRK 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 8:13" />ئِجِّي-ثن عِيْسَى ينْيَا ذِي ثْغَرَّابُوْت يرُوْح غَار وجمَّاض-ين ن ڒبْحَر. <verse eid="MRK 8:13" /><verse number="14" style="v" sid="MRK 8:14" />ئِمحْضَارن تُّوْن اَغْرُوْم وَار ث يْسِين شَا، غَارْسن غِير يجّن ن ثشْنِيفْث وَاهَا ذِي ثْغَرَّابُوْت. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />ئِوصَّا-ثن عِيْسَى ينَّا-ٱسن: "شُوْف! حْضَام يخف نْوم زݣ ونْتُوْن<note caller="+" style="f"><char style="fr" closed="false">8‏.15 </char><char style="ft" closed="false">أَنْتُون نتَّا ذ أَمْثُون.</char></note> ن ڒْحِزب ن يفَرِّيسِيْين ذ ونْتُوْن ن وزدْجِيذ هِيرُوْدُس."<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />بْذَان سَّاوَاڒن جَارَاسن نَّان قَا نشِّين وَار غَارْنغ ذَانِيتَا بُو وغْرُوْم.<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />ئِسّن عِيْسَى مِينْخف تُوْغَا سَّاوَاڒن ينَّا-ٱسن: "مَايمِّي ثقَّارم جَارَاوم وَار غَارْنغ بُو وغْرُوْم؟ مَا عَاذ وَار ثسِّينم؟ مَا عَاذ وَار ثفْهِيمم؟ ؤُڒَاون نْوم، مَا تْوَاقْسْحن نِغ؟ <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />غَارْوم ثِيطَّاوِين، مَا وَار تْوِيڒِيم شَا نِغ؟ غَارْوم يمجُّوْنن، مَا وَار تسْڒِيم شَا نِغ؟ مَا وَار ثعْقِيڒم شَا نِغ؟ <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />وَامِي رْزِيغ خمْسَا نِّي ن ثشْنِيفِين إِ خمْسَاڒَاف نِّي ن يِوْذَان، مشْحَاڒ ن ثقْرَابِين إِي ثشُّوْرم س يڒقُّوْزن يشطّن؟" نَّان-اَس: "ثنْعَاش <char style="it">ن ثقْرَابِين</char>." <verse eid="MRK 8:19" /><verse number="20" style="v" sid="MRK 8:20" /><char style="it">ينَّا-ٱسن:</char> "إِيوَا عَاوذ، وَامِي رْزِيغ سبْعَا نِّي ن ثشْنِيفِين إِ أَرْبعَاڒَاف نِّي ن يِوْذَان، مشْحَاڒ ن ثقْرَابِين إِي ثشُّوْرم س يڒقُّوْزن يشطّن؟" نَّان-اَس: "سبْعَا <char style="it">ن ثقْرَابِين</char>." <verse eid="MRK 8:20" /><verse number="21" style="v" sid="MRK 8:21" />ينَّا-ٱسن: "مَا عَاذ وَار ثفْهِيمم شَا؟"<verse eid="MRK 8:21" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا يجّن ن وضَرْغَاڒ ذِي بَيْت صَيْدَا</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />وَامِي ؤُوْضن غَار وبِيلَاج ن بَيْت صَيْدَا، ؤُوِين-اَس-د يجّن ن وضَرْغَاڒ إِ عِيْسَى تَّارن زَّايس اَث يحَاذَا. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />ئِطّف اَضَرْغَاڒ نِّي س وفُوْس يسُوْفغ-يث غَار بَارَّا ن وبِيلَاج نِّي. ئِسُّوْسف-اَس خ ثِيطَّاوِين نّس يݣَّا خَاس يفَاسّن نّس ينَّا-ٱس: "مَا تْوَاڒِيذ شَان ڒْحَاجث مَا لَّا؟"<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />ئِخْزَر ينَّا-ٱس: "تْوَاڒِيغ يوْذَان ݣِّين اَم ڒْشجُّوْر ݣُّوْرن-د."<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />ئِݣَّا خَاس عَاوذ يفَاسّن نّس خ ثِيطَّاوِين ن وضَرْغَاڒ نِّي. صَافِي يݣنْفَا، ثِيطَّاوِين نّس نُوْزْمنْت يبْذَا يتْوَاڒَا مْلِيح. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />يسّكّ-يث غَار ثدَّارْث نّس ينَّا-ٱس: "وَار تْروَّاح شَا غَار وبِيلَاج ن بَيْت صَيْدَا."<verse eid="MRK 8:26" /></para>
  <para style="s">أَرَّسُوْل بُطْرُس يشهّذ خ لْمَسِيح</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />ئِرُوْح عِيْسَى نتَّا ذ يمحْضَارن نّس غَار ڒدْشُوْرَاث ن ثنْدِينْت ن قَيْصَارِيَا ن فِيلِيـپَّـاس. ݣُّوْرن خ وبْرِيذ يسّقْسَا يمحْضَارن نّس ينَّا-ٱسن: "مِين خَافِي قَّارن يِوْذَان؟"<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />أَرِّين خَاس نَّان-اَس: "ئِجّن يقَّار شك ذ يَحْيَى، ئِجّن يقَّار شك ذ إِلْيَاس، ئِجّن يقَّار شك زِي لْأَنْبِيَا."<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />ينَّا-ٱسن عِيْسَى: "ئِي كنِّيو، مِين ذَايِي د تَارَّام نش؟"</para>
  <para style="p" vid="MRK 8:29">ئِنْدق-د بُطْرُس ينَّا-ٱس: "شك ذ لْمَسِيح."<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />ئِعْڒم-اَسن عِيْسَى ينَّا-ٱسن: "وَار قَّارم شَا مَانَايَا خَافِي إِ حَدّ."<verse eid="MRK 8:30" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسَّاوَاڒ خ ڒْموْث نّس</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />ئِبْذَا يسڒْمَاذ-يثن ينَّا-ٱسن: "أَقَا مِّيس ن بْنَاذم يتْخصَّا-يَاس اَذ يتْوَاعدّب خ وَاطَّاس ن ثْمسْڒَايِين، أَث عِيفّن يمقّْرَانن ن أَيث-إِسْرَائِيل ذ اَرُّوْيَاس ن ڒْفُقَهَا ذ يمْسڒْمَاذن ن شَّرِيعَا. أَث نْغن، وِيس ثڒْتِيَّام اَذ د يكَّر زِي ڒْموْث." <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />ئِسِّيوڒ اَكِسن نِيشَان خ مَانَايَا. ئِسْبعّذ-يث بُطْرُس ينْهَا-ث.<verse eid="MRK 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33" />وَلَكِن عِيْسَى ينقْڒب غَارس يخْزَر غَار يمحْضَارن نّس، ئِنْهَا بُطْرُس ينَّا-ٱس: "أَݣّْوج خَافِي غَار ذفَّار آ شِّيطَان! شك وَار تْفكَّرذ شَا اَمشْنَاو أَربِّـي؛ لَّا، شك تْفكَّرذ اَمشْنَاو بْنَاذم."<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />ئِڒَاغَا-د خ يمحْضَارن نّس ذ ڒْغَاشِي ينَّا-ٱسن: "ونِّي يخْسن اَذَايِي يذْفَار نش، لَابُد اَذ يسْمح ذݣ يِيخف نّس اَذ يكسِّي صَّلِيب نّس <char style="it">مِينْخف غَا يعدّب</char> اَذَايِي يذْفَار. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />ڒَاحقَّاش ونِّي يخْسن اَذ يسنْجم ثُوْذَارْث نّس اَتَاف اَت يخْسَر. ونِّي إِي غَا يخْسَرن ثُوْذَارْث نّس خ سَّبَاب ينُو ذ سَّبَاب ن لْإِنْجِيل اَتَاف اَت يسنْجم. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />مِيزِي غَا ثنْفع بْنَاذم مڒَا يرْبح دُّنشْت قَاع، وَا يخْسَر ڒَعْمَر نّس؟ <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />شُوْف، بْنَاذم وَار يزمَّر اَذ يبدّڒ وَالُو ذݣ ومْشَان ن ڒَعْمَر نّس. <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />ونِّي خَافِي غَا يعفَّرن نش نِغ اَذ يعفَّر خ وَاوَاڒ ينُو ذِي زْمَان-أَ اَعفَّان يخدّْعن أَربِّـي، أَتَاف اَخَاس يعفَّر مِّيس ن بْنَاذم خْمِي د غَا يَاس س لْعَظَمَا ن بَابَاس اَك لْمَلَائِكَاث يقدّْسن.<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="nb">
    <verse number="1" style="v" sid="MRK 9:1" />ينَّا-ٱسن عِيْسَى: "أَقَا تسْڒَام ڒْحَقّ: ڒبْعَاض زݣ يِنِّي يدْجَان ذَا اَكِذِي وَار تْمتِّين شَا اَڒ غَا ࢲرن ڒْمُلْك ن أَربِّـي يُوْسَا-د س جّْهذ."<verse eid="MRK 9:1" /></para>
  <para style="s">سِيذْنَا مُوْسَى ذ سِيذْنَا إِلْيَاس تْمظْهَارن-د اَك سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />ثعْذُو ستّييَّام، عِيْسَى يُوْوِي اَكِس بُطْرُس ذ يَعْقُوْب ذ يُوْحَنَّا يُوْوِي-ثن وَاحذْسن غَار يجّن ن وذْرَار يُوْعْڒَا. ذِنِّي زَّاث إِ ثِيطَّاوِين نْسن يذْوڒ اَم يِجّن ن نُّوْر. <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />ئِذْوڒ وَارُّوْض نّس ذ اَشمْڒَاڒ يرقّ، وَار يزمَّر ؤُڒَا ذ يجّن خ ثْمُوْرْث اَذ يَرّ اَرُّوْض ذ اَشمْڒَاڒ اَم ونِّي. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />ئِمظْهَار-اَسن-د ذِنِّي <char style="it">نَّبِي</char> إِلْيَاس ذ <char style="it">نَّبِي</char> مُوْسَى. <char style="it">تْوَاڒَان-ثن</char> سَّاوَاڒن اَك عِيْسَى.<verse eid="MRK 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5" />ئِنْدق-د بُطْرُس ينَّا-ٱس إِ عِيْسَى: "آ سِيذِي، ذ اَصبْحَان اَكِذش نقِّيم ذَانِيتَا. نشِّين أَ نݣّ ثْڒَاثَا ن يقِيضَان، ئِجّن إِ شك، ئِجّن إِ مُوْسَى، ئِجّن إِ إِلْيَاس." <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />بُطْرُس تُوْغَا يفَجَا، وَار يُوْفِي شَا مِين غَا يِينِي، نِثْنِي ݣّْوْذن. <verse eid="MRK 9:6" /><verse number="7" style="v" sid="MRK 9:7" />يُوْسَا-د يجّن ن وسيْنُو<note caller="+" style="f"><char style="fr" closed="false">9‏.7 </char><char style="ft" closed="false">أَسيْنُو نتَّا ذ اَسݣْنُو.</char></note> يهْوَا-د خَاسن. ثنْدق-د زَّايس يجّن ن ثْمِيجَّا ثنَّا-ٱسن: "قَا ذ وَانِيتَا ذ مِّي يعِيزّن، صنّْطث غَارس." <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />وَامِي خْزَرن يمحْضَارن اَمُّو ذ وَامُّو، عْلَاغَفْلَا وَار اَكِذْسن ؤُفِين حَدّ إِلَّا عِيْسَى.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />وَامِي د هوَّان زݣ وذْرَار يوصَّا-ثن عِيْسَى ينَّا-ٱسن: "وَار تْعَاوَاذم إِ حَدّ مِين ثࢲْرِيم اَڒ د غَا يكَّر مِّيس ن بْنَاذم زِي ڒْموْث." <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />جِّين اَوَاڒ نِّي جَارَاسن، سِّيوْڒن اَك وَايَاوْيَا نَّان: كِيفَاش، مِين يخس اَذ يِينِي اَذ د يكَّر زِي ڒْموْث؟<verse eid="MRK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11" />سّقْسَان-ث يمحْضَارن نّس نَّان-اَس: "مَايمِّي يمْسڒْمَاذن ن شَّرِيعَا قَّارن يتْخصَّا <char style="it">نَّبِي</char> إِلْيَاس اَذ د يَاس نتَّا ذ اَمزْوَارُو؟"<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />ينَّا-ٱسن عِيْسَى: "ذ صَّح يتْخصَّا اَذ د يَاس إِلْيَاس ذ اَمزْوَارُو اَذ يعْذڒ كُڒْشِي. وَلَكِن مَايمِّي يقَّار لْكِتَاب بلِّي يتْخصَّا-يَاس إِ مِّيس ن بْنَاذم اَذ يتْوَاعدّب، أَث عِيفّن؟ <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />أَذَاوم ينِيغ: أَقَا إِلْيَاس نِّي يُوْسَا-د، خذْمن ذَايس مِين خْسن مَامّش خَاس يُوْرَا ذِي لْكِتَاب."<verse eid="MRK 9:13" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا يجّن ن وحنْجِير ذَايس جْنُوْن</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />
    <char style="it">عِيْسَى ذ يِنِّي اَكِذس</char> ذوْڒن-د غَار يمحْضَارن ؤُفِين ذِنِّي ڒْغَاشِي ذ اَمقّْرَان مُوْنن-د خَاسن. ؤُفِين عَاوذ شَان يمْسڒْمَاذن ن شَّرِيعَا تْمنْغَان اَك يمحْضَارن نِّي. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />وَامِي ࢲْرِين عِيْسَى، مَارَّا ڒْغَاشِي نِّي ذهْشن ؤُزّْڒن غَارس اَخَاس سدْجْمن.<verse eid="MRK 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 9:16" />ينَّا-ٱسن عِيْسَى: "مِينْخف تْمنْغَام؟"<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />ئِنْدق-د يِجّن زِي ڒْغَاشِي نِّي ينَّا-ٱس: "آ لْمُعَلِّم، أَقَا ؤُوِيغ-اَش-د مِّي ذَايس جّنّ ذ اَزيْنُوْن. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />مَانِي ما يطّف-يث يغطَّاڒ-يث غَار ثْمُوْرْث، ئِسُوْفُوْغ-د نتَّا كُوْفُّو زݣ وقمُّوْم نّس يتْغࢲَّاࢲ ثِغْمَاس نّس يذوّڒ وَار يتنْهزِّي. تَّارغ زݣ يمحْضَارن نّش اَزَّايس سُوْفْغن جّنّ نِّي وَلَكِن نِثْنِي وَار ذَاس زمَّرن شَا."<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />يَارَّا خَاسن عِيْسَى ينَّا-ٱسن: "آ يوْذَان ن ڒْوقْث-أَ إِي ذِي وَار يدْجِي بُو لْإِيمَان! مشْحَاڒ إِي كِذْوم غَا قِّيمغ أُو مشْحَاڒ ذَاوم غَا صْبَرغ؟ أَوِيم-اَيِي-ث-يد إِ نش." <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />ؤُوِين-ث-يد غَار عِيْسَى، جّنّ نِّي يَالَّاه يࢲْرَا عِيْسَى يسرْجِيجِي اَحنْجِير نِّي يوْضَا غَار ثْمُورْث، ئِترْجِيجِي يتكّ-اَس-د كُوْفُّو زݣ وقمُّوْم.<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />ينَّا-ٱس عِيْسَى إِ بَابَاس ن وحنْجِير نِّي: "مشْحَاڒ زݣ وَامِي إِي ذَايس مَانَايَا؟"</para>
  <para style="p" vid="MRK 9:21">ينَّا-ٱس: "زݣ وَامِي يدْجَا ذ اَمزْيَان. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />أَطَّاس ن ثْوَاڒَاثِين ينطَّر-يث ذِي ثْمسِّي نِغ ذݣ وَامَان بَاش اَث ينغ. شك مڒَا ثْزمَّرذ، عَاون-اَنغ رْحم-اَنغ."<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />ينَّا-ٱس عِيْسَى: "مَايمِّي إِي غَا ثِينِيذ مڒَا زمَّرغ؟ إِيوَا ونِّي يُوْمْنن يزمَّر إِ كُڒْشِي."<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />ڒخْدّنِّي يسِّيوڒ س جّْهذ بَابَاس ن وحنْجِير نِّي ينَّا-ٱس: "نش ؤُمْنغ! عَاون لْإِيمَان ينُو ذ وقْلِيل."<note caller="+" style="f"><char style="fr" closed="false">9‏.24 </char><char style="ft" closed="false">لْجُمْلَا-يَا س تَّرْجَمَا حَرْفِيَا "عَاون شّكّ ينُو." تَّرْجَمَا نّس ثقْسح س ثْمَازِيغْث. ئِتْخصَّا أَ نْفكَّر مْلِيح ذِي ڒْمَعْنَا نّس حمَا أَ نفْهم نِيشَان مِين يخس اَذ يِينِي بَابَاس ن وحَرْمُوش-أَ.</char></note><verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />وَامِي يُوْفَا عِيْسَى ڒْغَاشِي ذغْيَا مُوْنن-د خَاس، ئِسْبدّ جّنّ نِّي اَعفَّان ينَّا-ٱس: "آ جّنّ اَزينُوْن آ جّنّ اَذهْشُوْر، تَمَرغ شك فّغ زَّايس وَار ذَايس تَاذَاف شَا عمَّارس عَاوذ!" <verse eid="MRK 9:25" /><verse number="26" style="v" sid="MRK 9:26" />ئِسْنكَّر ثْغُوْيّث جّنّ نِّي يسرْجِيجِي اَحنْجِير نِّي اَطَّاس ڒخْدّنِّي يفّغ زَّايس. أَحنْجِير نِّي يذْوڒ اَخْمِي يمُّوْث، نَّان اَطَّاس ن يِوْذَان اَقَا يمُّوْث صَافِي. <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />وَلَكِن عِيْسَى يطّف-يث زݣ وفُوْس نّس يسْبدّ-يث يكَّر.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />يُوْذف عِيْسَى غَار ثدَّارْث، سّقْسَان-ث يمحْضَارن نّس وَاحْذس نَّان-اَس: "مَايمِّي زَعْمَا نشِّين تُوْغَا وَار نْزمَّر اَث نْسُوْفغ؟"<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />يَارَّا خَاسن ينَّا-ٱسن: "نُّوْع ن <char style="it">جّن-أَ</char> اَث نْسُوْفغ غِير س ثْࢲَادْجِيث."<verse eid="MRK 9:29" /></para>
  <para style="b" />
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />رُوْحن كِّين سّنِّي خ ثْمُوْرْث ن لْجَلِيل. عِيْسَى وَار يخس حَدّ اَذ يسّن <char style="it">اَقَاثن ذِنِّي</char> <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />مِينْزِي يرزُّو اَذ يسڒْمَاذ إِ يمحْضَارن نّس. ينَّا-ٱسن: "مِّيس ن بْنَاذم اَذ يتْوَاسلّم غَار يفَاسّن ن يِوْذَان. أَث نْغن، نْهَار وِيس ثڒْتِيَّام منْبَعْد إِ ڒْموْث نّس اَذ د يكَّر." <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />وَلَكِن نِثْنِي وَار فْهِيمن شَا إِ وَاوَاڒ نِّي، ݣّْوْذن اَث سّقْسَان خ مِين ذَاسن ينَّا.<verse eid="MRK 9:32" /></para>
  <para style="s">مَانْون إِݣ يدْجَان ذ اَمقّْرَان؟</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />ؤُسِينْد غَار وبِيلَاج ن كَفرْنَاحُوْم. أَقَاثن ذِي ثدَّارْث يسّقْسَا يمحْضَارن نّس ينَّا-ٱسن: "مِينْخف تْمنْغَام ذݣ وبْرِيذ؟" <verse eid="MRK 9:33" /><verse number="34" style="v" sid="MRK 9:34" />وَار خَاس اَرِّين شَا <char style="it">سذْحَان</char> مِينْزِي تْمنْغَان خ وبْرِيذ اَك وَايَاوْيَا ؤُݣ يدْجَان ذ اَمقّْرَان زَّايْسن.<verse eid="MRK 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 9:35" />ئِقِّيم، ئِڒَاغَا-د خ ثنْعَاش نِّي ن يمحْضَارن نّس ينَّا-ٱسن: "ونِّي يرزُّوْن اَذ يذْوڒ ذ اَمزْوَارُو <char style="it">جَارَاوم</char> يتْخصَّا-يَاس اَذ يِيڒِي ذ اَنݣَّارُو يعْنِي ذ اَخدَّام ن مَارَّا." <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />ئِسْقَارّب-د غَارس يج وحنْجِير ذ اَمزْيَان، ئِسْبدّ-يث ذِي ڒْوسْط نْسن يذرّع-اَس ينَّا-ٱسن: <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />"ونِّي غَا يقبْڒن شَان وحنْجِير اَم وَانِيتَا عْلَاحْسَاب يسم ينُو، أَخْمِي ذ نش إِݣ يقْبڒ. ونِّي ذَايِي غَا يقبْڒن، مَاشِي ذ نش إِݣ يقْبڒ؛ لَّا، يقْبڒ ونِّي ذَايِي د يسّكّن."<verse eid="MRK 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />ينَّا-ٱس يُوْحَنَّا: "آ لْمُعَلِّم، قَا نࢲْرَا يجّن يسُوْفُوْغ جْنُوْن عْلَاحْسَاب يسم نّش. نشِّين نرْزُو اَث نسْبدّ وَامِي وَار يدْجِي شَا ذ اَمحْضَار اَكِذْنغ."<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />ينَّا-ٱس عِيْسَى: "وَار ث سْبدَّام شَا. وَار يزمَّر شَان يجّن اَذ يݣّ لْمُعْجِيزَا عْلَاحْسَاب يسم ينُو ڒخْدّنِّي ذغْيَا اَخَافِي يِينِي اَوَاڒ ذ اَعفَّان. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />ونِّي وَار يدْجِين شَا ضد نّغ، اَقَاث اَكِذْنغ. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />اَقَا تسْڒَام ڒْحَقّ: ونِّي ذَاوم غَا يُوْشن ڒْكَاس ن وَامَان ڒَاحقَّاش تذْفَارم لْمَسِيح اَتَاف اَذ يَاوِي لْأَجَر نّس وَار ث يتْضيِّيع شَا."<verse eid="MRK 9:41" /></para>
  <para style="s">لإِيمَان ذ ڒْمُعْصِيّث</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />ونِّي إِي غَا يَاوِين يجّن زݣ يمزْيَانن-أَ إِي زَّايِي يتَامْنن غار ڒْمُعْصِيّث، حْسن إِ نـتَّا اَذَاس شدّن يجّن ن وزْرُو ن ثْسِيرْث س وسْغُوْن غَار يِيرِي نّس، أَث نْضَرن ذِي ڒبْحَر. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />شك فُوس نّش مڒَا يتْسبَّاب-اَش ذِي شَان ڒفْضِيحث، قسّ-يث زَعْمَا. حْسن إِ شك اَذ تَاذْفذ جّنّث س يِجّن ن وفُوْس زِي مڒَا قِّيمن غَارك ثْنَاين ن يفَاسّن اَذ تْمنْضَارذ ذِي جَهنَّمَا غَار ثْمسِّي إِي وَار يخسِّين شَا عمَّارْص. <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />{قَا ذِنِّي يكشَّاون وَار تْمتِّين شَا، ثِمسِّي وَار ثْخسِّي شَا.} <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />مڒَا ضَار نّش يتْسبَّاب-اَش ذِي شَان ڒفْضِيحث، قسّ-يث زَعْمَا. حْسن إِ شك اَذ تَاذْفذ جّنّث س يِجّن ن وضَار زِي مڒَا قِّيمن غَارك ثْنَاين ن يضَارن اَذ تْمنْضَارذ ذِي جَهنَّمَا. <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />{قَا ذِنِّي يكشَّاون وَار تْمتِّين شَا، ثِمسِّي وَار ثْخسِّي شَا.} <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />مڒَا ثِيطّ نّش تْسبَّاب-اَش ذِي شَان ڒفْضِيحث، قْڒع-يت زَعْمَا. حْسن إِ شك اَذ تَاذْفذ جّنّث س يِجّن ن ثِيطّ زِي مڒَا قِّيمنْت غَارك ثْنَاين ثِيطَّاوِين اَذ تْمنْضَارذ ذِي جَهنَّمَا. <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />قَا ذِنِّي يكشَّاون وَار تْمتِّين شَا، ثِمسِّي وَار ثْخسِّي شَا. <verse eid="MRK 9:48" /><verse number="49" style="v" sid="MRK 9:49" />مِينْزِي مَارَّا يوْذَان اَذ تْوَامدْجْحن س ثْمسِّي. <verse eid="MRK 9:49" /><verse number="50" style="v" sid="MRK 9:50" />ڒمْڒح ثْصدْجَاح، وَلَكِن مڒَا يرُوْح-اَس لْمَذَاق نّس، مَامْش ذَاس غَا نݣّ اَذَاس ثِيذ نَرّ؟ أَغَارْوم ثِيڒِي ڒمْڒح ذِي نّفْس نْوم، ئِڒِيم ذِي ڒهْنَا اَك وَايَاوْيَا."<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">طَّلَاق عْلَاحْسَاب مامّش إِي ذَانغ يقّار سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />ئِكَّر عِيْسَى يفّغ سّنِّي يرُوْح غَار جْوَايه ن يَهُوْذِيَا ذ وجمَّاض-ين ن يغْزَار ن لْأُرْدُن. مُوْنن-د خَاس ذِنِّي ڒْغَاشِي عَاوذ، يبْذَا يسڒْمَاذ-يثن اَمشْنَاو ڒبْدَا.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />قَارّْبن-د غَارس شَان يِوْذَان زِي ڒْحِزب ن يفَرِّيسِيْين حمَا اَث جَرّْبن نَّان-اَس: "مَا حَلَال اَذ يدْجف شَان ورْيَاز إِ ثمْغَارْث نّس؟"<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />ينَّا-ٱسن عِيْسَى: "مِينْخف كنِّيو يوصَّا مُوْسَى؟"<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />نَّان-اَس يفَرِّيسِيْين: "مُوْسَى يسْمح إِ ورْيَاز اَذ يَارِي ثَبْرَات ن وَادْجَاف اَذَاس ت يُوْش إِ ثمْغَارْث نّس اَذَاس يدْجف."<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />ينَّا-ٱسن عِيْسَى: "مُوْسَى يُوْرَا ڒُوْصِيّث نِّي إِ كنِّيو مِينْزِي غَارْوم ؤُڒ يقْسح. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />وَلَكِن زݣ وَامِي ثبْذَا دُّنشْت أَربِّـي يخْڒق-د اَرْيَاز ذ ثمْغَارْث. <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />س مَانَاينِّي اَرْيَاز اَذ يسْمح ذِي بَابَاس ذ يمَّاس اَذ يمُوْن اَك ثمْغَارْث نّس، <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />أَذ ذوْڒن س ثْنَاين إِذْسن ذ يجّن. خ مَانَايَا وَار تِيڒِين شَا ذ ثْنَاين؛ لَّا، أَذ يڒِين ذ يجّن. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />إِذن، مِين يسْمُوْن أَربِّـي وَار ث يسْفَرّق شَا بْنَاذم."<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />ذِي ثدَّارْث سّقْسَان-ث يمحْضَارن نّس عَاوذ خ مَانَاينِّي. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />ينَّا-ٱسن عِيْسَى: "مَارَّا ونِّي غَا يدْجْفن إِ ثمْغَارْث نّس يُوْوِي شَان يشْتن نّغْنِي، أَتَاف يزْنَا. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />ثَمْغَارْث مڒَا ثدْجف إِ ورْيَاز نّس ثُوْوِي شَان يجّن نّغْنِي، أَتَاف ثزْنَا."<verse eid="MRK 10:12" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتْبَرك يحنْجِيرن يمزْيَانن</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />ؤُوِين-د يِوْذَان شَان يحنْجِيرن ذ يمزْيَانن غَار عِيْسَى حمَا اَثن يحَاذَا، وَلَكِن عَارّْضن-اَسن يمحْضَارن نّس. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />يࢲْرَا عِيْسَى مَانَايَا، وَار ذَاس يعْجِيب بُو ڒْحَاڒ ينّا-اَسن: "جّم يحنْجِيرن يمزْيَانن اَغَارِي د اَسن وَار ذَاسن تْعَارَّاضم شَا ڒَاحقَّاش ڒْمُلْك ن أَربِّـي يتِيڒِي غَار يِنِّي إِي يدْجَان اَم يِيْنَا. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />أَقَا تسْڒَام ڒْحَقّ: لَابُد إِ بْنَاذم اَذ يَامن س ڒْمُلْك ن أَربِّـي مَامْش زَّايس يتَامن وحنْجِير اَمزْيَان. مڒَا لَّا، أَتَاف بْنَاذم نِّي عمَّارص اَذ يَاذف ذِي ڒْمُلْك ن أَربِّـي." <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />ئِذرّع-اَسن عِيْسَى يݣَّا خَاسن يفَاسّن نّس يبَرك-يثن.<verse eid="MRK 10:16" /></para>
  <para style="s">أَرْيَاز إِݣ يدْجَان ذ تَّاجَر</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />عِيْسَى وَامِي يݣُّوْر خ وبْرِيذ، يُوْسَا-د غَارس يجّن يتَازّڒ يوْضَا خ يفَادّن زَّاثس ينَّا-ٱس: "آ لْمُعَلِّم اَصبْحَان، مِين غَا ݣّغ حمَا اَغَارِي ثِيڒِي ثُوْذَارْث ن ڒبْدَا؟"<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />ينَّا-ٱس عِيْسَى: "مَايمِّي ثقَّارذ قَا نش ذ اَصبْحَان؟ وَار يدْجِي حَدّ ذ اَصبْحَان إِلَّا أَربِّـي وَاحْذس. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />ثسّْنذ ڒُوْصِيَاث: وَار نقّ، وَار زنَّا، وَار تَاشَار، وَار شهّذ بُو ࢲُّوْر، وَار شمّث، وقَّر بَابَاش ذ يمَّاش."<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />ينَّا-ٱس ورْيَاز نِّي: "آ لْمُعَلِّم، زݣ وَامِي إِي دْجِيغ نش ذ اَمزْيَان تْوقَّارغ قَاع مَانَايَا."<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />ئِخْزَر غَارس عِيْسَى يُوْذف-اَس غَار وُوْڒ نّس ينَّا-ٱس: "قَا ثقِّيم-اَش يجّن ن ڒْحَاجث وَار ت ثݣِّيذ شَا." ينَّا-ٱس: "رُوْح زنْز مَارَّا مِين غَارك ذ اَݣْڒَا صدّق-يث خ ڒْمُسَاكِين اَغَارك يِيڒِي ڒْكنْز ذݣ وجنَّا، ڒخْدّنِّي اَرَاح-د شك ذْفَار-اَيِي-د." <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />وَامِي يسْڒَا إ مَانَاينِّي يرُوْح يخيّق اَطَّاس ڒَاحقَّاش غَارس اَطَّاس ن وَاݣْڒَا.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />ئِخْزَر غَارْسن عِيْسَى ينَّا-ٱسن إ يْمحْضَارن نّس: "مشْحَاڒ يقْسح خَاسن خ تْوَاجَر اَذ اَذْفن ڒْمُلْك ن أَربِّـي." <verse eid="MRK 10:23" /><verse number="24" style="v" sid="MRK 10:24" />ذهْشن يمحْضَارن نّس خ وَاوَاڒ نِّي. ينَّا-ٱسن عِيْسَى عَاوذ: "آ ثَارْوَا ينُو، مشْحَاڒ يقْسح اَذ يَاذف بْنَاذم ڒْمُلْك ن أَربِّـي! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />أَقَا يسْهڒ اَذ يعْذُو يجّن ن وڒْغم زِي ثِيطّ ن ثْسيْنفْث قْبڒ مَا ٱذ يَاذف يجّن ن تَّاجَر ذِي ڒْمُلْك ن أَربِّـي!"<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />ئِمحْضَارن تْعجّْبن اَطَّاس نَّان إِ وَايَاوْيَا: "خْيَار، أُوْݣ يزمَّرن اَذ ينْجم!؟"<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />ئِخْزَر غَارْسن عِيْسَى ينَّا-ٱسن: "ئِوْذَان وَار زمَّرن شَا إِ مَانَايَا. وَلَكِن أَربِّـي وَاه، ئِزمَّر إِ كُڒْشِي."<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />ئِنْدق-د بُطْرُس ينَّا-ٱس: "أَقَا نشِّين نسْمح ذِي كُڒْشِي نذْفَار-يش!"<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />ينَّا-ٱسن عِيْسَى: "أَقَا تسْڒَام ڒْحَقّ: مَارَّا ونِّي يسمْحن ذِي ثدَّارْث نّس نِغ ذِي أَيْثْمَاس نِغ ذِي سُوْيْثْمَاس نِغ ذِي يمَّاس نِغ ذِي بَابَاس نِغ ذِي ثَارْوَا نّس نِغ ذݣ يمَرْجعِيون نّس خ سَّبَاب ينُو نش أُو عْلَاحْسَاب لْإِنْجِيل، <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />أَتَاف اَغَارس ثِيڒِي مِيَّا ن ثْسقَّار زِي ثُوْذْرِين ذ أَيثْمَاس ذ سُوْيْثْمَاس ذ يمَّاس ذ ثَارْوَا نّس ذ يمَرْجعِيون نّس. أَغَارس يِيڒِي وعدّب ذي زْمَان-أَ، وَلَكِن ذِي زْمَان إِي د غَا يَاسن اَغَارس ثِيڒِي ثُوْذَارْث ن ڒبْدَا. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />أَطَّاس إِي يدْجَان ذ يمزْوُوْرَا اَذ ذوْڒن ذ ينݣُّوْرَا؛ يِنِّي يدْجَان ذ ينݣُّوْرَا اَذ ذوْڒن ذ يمزْوُوْرَا."<verse eid="MRK 10:31" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسَّاوَاڒ عَاوذ خ ڒْموْث نّس</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />أَقَاثن خ وبْرِيذ تْݣَعَّاذن غَار ثنْدِينْت ن لْقُدْس، عِيْسَى اَقَاث زَّاث. ئِمحْضَارن نّس ذهْشن، يِنِّي ث يذْفَارن ݣّْوْذن. ئِرُوْح يُوْوِي ثنْعَاش نِّي ن يمحْضَارن نّس ثْوَاڒَا نّغْنِي وَاحذْسن، ئِبْذَا يسَّاوَاڒ اَكِذْسن خ مِين ذَاس غَا يوقْعن ينَّا: <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />"أَقَا نتْݣَعَّاذ غَار لْقُدْس مَانِي غَا يتْوَاخْذع مِّيس ن بْنَاذم إِ اَرُّوْيَاس ن ڒْفُقَهَا ذ يمْسڒْمَاذن ن شَّرِيعَا. أَخَاس حكْمن س ڒْموْث، أَث سلّْمن إِ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل. <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />أَخَاس ضحْشن، أَخَاس سُّوْسْفن، أَث ؤُوْثن س وسْغُوْن، أَث نْغن. نْهَار وِيس ثڒْتِيَّام اَذ د يكَّر زِي ڒْموْث."<verse eid="MRK 10:34" /></para>
  <para style="s">طَّلب ن ثَارْوَا ن زَبَادِي</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />يَعْقُوْب ذ يُوْحَنَّا يدْجَان ذ ثَارْوَا ن زَبَادِي قَارّْبن غَار عِيْسَى نَّان-اَس: "آ لْمُعَلِّم، نْرزُّو اَذَانغ ثْذبَّرذ مِين غَا نتَّار زَّايك."<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />ينَّا-ٱسن عِيْسَى: "مِين ثْرزُّوم اَذَاوم ذبَّرغ؟"<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />نَّان-اَس: "اجّ-اَنغ أَ نقِّيم ذِي لْعَظَمَا نّش يجّن خ وفُوْسِي يجّن خ وࢲڒْمَاض نّش."<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />ينَّا-ٱسن عِيْسَى: "كنِّيو وَار ثسِّينم شَا مِين ثتَّارم. مَا ثْزمَّرم اَذ تسْوم زِي ڒْكَاس نِّي إِي زِي غَا سْوغ نش؟ نِغ اَذ تْغضْسم ذِي ڒَعْذَاب نِّي إِي ذِي غَا غضْسغ نش؟"<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />نَّان-اَس: "وَاه، نْزمّر-اَس!"</para>
  <para style="p" vid="MRK 10:39">ينَّا-ٱسن عِيْسَى: "وَاه، أَتَاف اَذ تسْوم زِي ڒْكَاس نِّي إي زِّي غَا سْوغ نش، أَذ تْغضْسم ذِي ڒَعْذَاب نِّي إِي ذِي غَا غضْسغ نش. <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />وَلَكِن اَغِيمِي خ وفُوْسِي ينُو نِغ خ وࢲڒْمَاض ينُو وَار يدْجِي بُو ذ نش إِي ث غَا يُوْشن، أَذ يمُّوْش إِ يِنِّي ؤُمِي يتْوَاسّوْجذ."<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />عشْرَا نِّي ن يمحْضَارن وَامِي سْڒِين خ مِين رزُّوْن يَعْقُوب ذ يُوْحَنَّا وَار ذَاسن يعْجِيب شَا ڒْحَاڒ. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />ئِڒَاغَا-يَاسن-د عِيْسَى مَارَّا إِذْسن ينَّا-ٱسن: "قَا ثسّْنم اَرُّوْيَاس ن ڒݣْنُوْس حكّْمن خ شُّعُوْب نْسن، يِنِّي يمقّْرَانن زَّايْسن تْزيَّارن خَاسن. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />وَلَكِن مَانَاينِّي يتْخصَّا وَار يتِيڒِي شَا جَارَاوم؛ لَّا، ونِّي يرزُّوْن اَذ يذْوڒ ذ اَمقّْرَان جَارَاوم يتْخصَّا-يَاس اَذ يِيڒِي ذ اَخدَّام نْوم. <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />ونِّي يرزُّوْن اَذ يذْوڒ ذ اَمزْوَارُو جَارَاوم يتْخصَّا-يَاس اَذ يِيڒِي ذ يسْمغ ن مَارَّا. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />مِّيس ن بْنَاذم ؤُڒَا ذ نتَّا وَار د يُوْسِي شَا حمَا اَخَاس خذْمن يِوْذَان؛ لَّا، نتَّا يُوْسَا-د حمَا اَخَاسن يخْذم، أَخَاسن يصدّق ثُوذَارْث نّس حمَا اَذ يسنْجم اَطَّاس زَّايْسن."<verse eid="MRK 10:45" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا بَرْتِيمُوْس ونِّي يدْجَان ذ اَضَرْغَاڒ</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />ؤُوْضن غَار ثنْدِينْت ن اَرِيحَا. منْبَعْد يفّغ عِيْسَى زِي أَرِيحَا اَك يمحْضَارن نّس ذ وَاطَّاس ن ڒْغَاشِي. ؤُفِين ذِنِّي يجّن ن وضَرْغَاڒ يقِّيم طَّارْف ن وبْرِيذ يتتَّار، قَّارن-اَس بَرْتِيمُوْس مِّيس ن تِمُوْس. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />ئِتسْڒَا بلِّي عِيْسَى نَاصِرِي إي يعدُّوْن سّنِّي يبْذَا يسْنكَّر ثْغُوْيّث يقَّار: "آ عِيْسَى آ مِّيس ن اَيث-دَاود، رحْم-اَيِي!" <verse eid="MRK 10:47" /><verse number="48" style="v" sid="MRK 10:48" />زيَّارن خَاس اَطَّاس ن يِوْذَان قَّارن-اَس سْقَار. نتَّا يُوْݣِي، ئِقِّيم يسْنكَّر ثْغُوْيّث عَاذ س جّْهذ يقَّار: "آ مِّيس ن أَيث-دَاود، رحْم-اَيِي!"<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />ئِبدّ عِيْسَى ينَّا-اَسن: "ڒَاغَام-د خَاس."</para>
  <para style="p" vid="MRK 10:49">ڒَاغَان-د خ وضَرْغَاڒ نِّي نَّان-اَس: "فَرح شك كَّر، أَقَا يتْڒَاغَا-د خَاك <char style="it">عِيْسَى</char>." <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />ئِكّس اَزدْجَاب نّس ينْضَر-يث، ئِنخْضف ذغْيَا يبدّ خ يضَارن نّس يُوْسَا-د غَار عِيْسَى.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />ينَّا-ٱس عِيْسَى: "مِين ثخْسذ اَذَاش ݣّغ؟"</para>
  <para style="p" vid="MRK 10:51">ينَّا-ٱس وضَرْغَاڒ نِّي: "آ سِيذِي، قَا نش خْسغ اَذ تْوَاڒِيغ."<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />ئِنْدق-د عِيْسَى ينَّا-ٱس: "رُوْح، قَا لإِيمَان نّش يسْݣنْفَا-شك!" ڒخْدّنِّي يبْذَا يتْوَاڒَا يذْفَار عِيْسَى ذݣ وبْرِيذ.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">سِيذِيثْنغ عِيْسَى يتَاذَاف خ وسْنُوْس غَار ثنْدِينْت ن لْقُدْس</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />وَامِي قَارّْبن غَار ثنْدِينْت ن لْقُدْس، غَار يبِيلَاجن ن بَيْت فَاجِي ذ بَيْت عَنْيَا زَّاث إِ وذْرَار ن زِّيتُون، ئِكَّر عِيْسَى يسّكّ ثْنَاين زݣ يمحْضَارن نّس <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />ينَّا-ٱسن: "رُوْحم غَار وبِيلَاج-ين إِي يدْجَان زَّاثْوم. خْمِي غَا ثَاوْضم ذِنِّي، أَذ تَافم يجّن ن وسْنُوْس يقّن عمَّارْص وَار خَاس ينْيِي ؤُڒَا ذ يجّن، فْسِيم-اَس اَوِيم-ث-يذ. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />مڒَا يسِّيوڒ-د غَارْوم شَان يِجّن ينَّا-ٱوم مَايمِّي تݣّم اَمُّو، ئِنِيم-اَس قَا يحْذَاج-يث سِيذِيثْنغ، وَلَكِن اَذَاوم ثِيذ يَرّْ ذَانِيتَا ذغْيَا."<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />رُوْحن ؤُفِين يجّن ن وسْنُوْس ذِي زّنْقث يقّن غَار يِجّن ن ثوَّارْث، فسْين-اَس. <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />نَّان-اَسن ڒبْعَاض زݣ يِنِّي يبدّن ذِنِّي: "مِين تݣّم؟ مَايمِّي ثْفسِّيم إِ وسْنُوْس-أَ؟" <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />جَاوْبن-ثن عْلَاحْسَاب مَامّش ثن يوصَّا عِيْسَى، أُوشَا جِّين-ثن. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />ؤُوِين-ث-يذ غَار عِيْسَى ݣِّين خَاس يزدْجُوْبَا نْسن، نتَّا ينْيَا خَاس.<verse eid="MRK 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 11:8" />أَطَّاس ن يِوْذَان سُّوْن-اَس اَبْرِيذ س يزدْجُوْبَا نْسن. ڒبْعَاض زَّايْسن قسّن زݣ يمَرْجعِيون ڒفْرُوْع ن ڒْشجُّوْر سُّوْن-اَس زَّايْسن اَبْرِيذ. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />يِنِّي يݣُّوْرن زَّاثس ذ يِنِّي إِي ث يذفَّارن قَّارن:</para>
  <para style="q1" vid="MRK 11:9">"لْحَمْدُو إِ أَربِّـي!</para>
  <para style="q1" vid="MRK 11:9">سَّعْذ ن وَانِيتَا إِي د يُوْسِين عْلَاحْسَاب يسم ن سِيذِي أَربِّـي.<verse eid="MRK 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10" />سَّعْذ ن ڒْمُلْك نِّي إِي د يتَاسن ن جدِّيثْنغ دَاود.</para>
  <para style="q1" vid="MRK 11:10">لْحَمْدُو إِ أَربِّـي يُوْعْڒَان."<verse eid="MRK 11:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />يُوْذف عِيْسَى غَار ثنْدِينْت ن لْقُدْس غَار ثمْزِيذَا ثَمقّْرَانْت ن أَيث-إِسْرَائِيل، ئِخْزَر مِين ذِنِّي مَارَّا. وَلَكِن تُوْغَا يعْذُو ڒْحَاڒ، ئِفّغ اَك ثنْعَاش ن يمحْضَارن نّس يرُوْح غَار بَيْت عَنْيَا.<verse eid="MRK 11:11" /></para>
  <para style="s">ثَشجَّارْث ن ثَازَارْث إِي يُوْزْغن</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />ثِيوشَّا نّس تفّْغن زِي بَيْت عَنْيَا، عِيْسَى يدْجُوْز. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />ئِࢲْرَا زِي ڒݣّْوَاج يجّن ن ثْشجَّارْث ن ثَازَارْث ذَايس ثِيفْرَاي، ئِقَارّب غَارس يرزُّو خ ثَازَارْث. وَامِي غَارس يُوْوض يُوْفَا ذَايس ثِيفْرَاي وَاهَا مِينْزِي عَاذ وَار د ثُوْوِيض شَا ڒْوقْث ن ثَازَارْث. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />ينَّا-ٱس: "شم زِي سَّا اَڒ ثْسَاونْت عمَّارْص وَار زَّايم يتتّ حَدّ." ئِمحْضَارن نّس سْڒَان-اَس إِ مِين ينَّا.<verse eid="MRK 11:14" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى اَقَاث ذِي ثمْزِيذَا ثَمقّْرَانْت ن أَيث-إِسْرَائِيل</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />صَافِي ؤُوْضن غَار ثنْدِينْت ن لْقُدْس. يُوْذف عِيْسَى غَار ثمْزِيذَا ثَمقْرَانْت يبْذَا يتَازّڒ خ يِنِّي يسَّاغن ذ يِنِّي يزْنُوْزَان ذِنِّي ذِي ثمْزِيذَا. ئِقْڒب-اَسن مِيسَّاث ن يِنِّي يتْصَرَّافن تْمنْيَاث ذ ڒكْرَاسَا ن يِنِّي يزْنُوْزَان يذْبِيرن. <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />وَار يتِيجِّي ؤُڒَا ذ يجّن اَذ يكّ خ ثمْزِيذَا مڒَا غَارس سّڒْعَاث. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />ئِسڒْمَاذ-يثن ينَّا-ٱسن: "مَا يقَّار لْكِتَاب مَا لَّا بلِّي &lt;ثَدَّارْث ينُو اَذ تِيڒِي ذ ثَدَّارْث ن ثْࢲَادْجِيث إِ مَارَّا ڒݣْنُوس&gt;؟ وَلَكِن كنِّيو ثَارِّيم-تث ذ يفْرِي ن يخوَّانن." <verse eid="MRK 11:17" /><verse number="18" style="v" sid="MRK 11:18" />سْڒِين-اَس اَرُّوْيَاس ن ڒْفُقَهَا ذ يمْسڒْمَاذن ن شَّرِيعَا، بْذَان تْفكَّرن مَامّش ث غَا نْغن. ݣّْوْذن زَّايس وَامِي مَاَّرا ڒْغَاشِي قِّيمن ذهّْشن س وسڒْمذ نّس. <verse eid="MRK 11:18" /><verse number="19" style="v" sid="MRK 11:19" />غَار ثْمدِّيث تفّْغن غَار بَارَّا ن ثنْدِينْت.<verse eid="MRK 11:19" /></para>
  <para style="s">أَسْفْهم ن ثْشجَّارْث ن ثَازَارْث نِّي إِي يُوْزْغن</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />غَار صْبَاح زِيش وَامِي ݣُّوْرن خ وبْرِيذ ࢲْرِين ثَشجَّارْث نِّي ن ثَازَارْث ثُوْزغ س يࢲوْرَان نّس. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />ئِفكَّر ذَايس بُطْرُس ينَّا-ٱس إِ عِيْسَى: "خْزَر آ لْمُعَلِّم، ثَشجَّارْث نِّي ن ثَازَارْث إِي ثخْزِيذ اَقَا ثُوْزغ!"<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "أَمْنم زِي أَربِّـي! <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />أَقَا تسْڒَام ڒْحَقّ: مڒَا شَان يجّن ينَّا-ٱس إِ وذْرَار-أَ: نقْڒع-د شك سَّانِيتَا ثْمنْضَارذ ذِي ڒبْحَر أُو ذݣ وُوْڒ نّس وَار ذَايس بُو شّكّ يُوْمن اَذ يوْقع مَانَاينِّي، أَتَاف مَانَاينِّي اَذ يِيڒِي. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />خ مَانَايَا اَذَاوم ينِيغ: قَاع مِين غَا ثتَّارم إِ أَربِّـي ذِي ثْࢲَادْجِيث نْوم، أَمْنم بلِّي اَذ تِيڒِي اَغَارْوم د ثَاوض اَتَاف اَغَارْوم د تِيڒِي. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />كنِّيو خْمِي غَا ثْبدّم اَذ تࢲَّادْجم، مڒَا غَارْوم شَا ن لْعَدَاوَا اَك شَان يِجّن سمْحم-اَس حمَا بَابَاثْوم يدْجَان ذݣ وجنَّا اَذَاوم يغْفَر دّْنُوْب نْوم. <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />{مڒَا وَار ثْسمْحم شَا إِ يِوْذَان، بَابَاثْوم يدْجَان ذݣ وجنَّا وَار ذَاوم يغفَّر شَا دّْنُوْب نْوم.}"<verse eid="MRK 11:26" /></para>
  <para style="s">سُّلْطَا ن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />صَافِي ذوْڒن غَار لْقُدْس. عِيْسَى يݣُّوْر ذِي ثمْزِيذَا ثَمقْرَانْت، ؤُسِين-د غَارس اَرُّوْيَاس ن ڒْفُقَهَا ذ يمْسڒْمَاذن ن شَّرِيعَا ذ يمقّْرَانن ن أَيث-إِسْرَائِيل. <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />كَّرن نَّان-اَس: "شك مَانِيس ذَاش د ثكَّا سُّلْطَا نِّي إِي زِي تݣّذ ثِمسْڒَايِين-أَ؟ وِي ذَاش يُوْشِين سُّلْطَا نِّي إِي زِي ثنْت تݣّذ؟"<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />ئِجَاوب-يثن عِيْسَى ينَّا-ٱسن: "ؤُڒَا ذ نش اَكنِّيو سّقْسِيغ خ يِجّن ن ثْمسْڒَايْث. مڒَا ثْجَاوْبم-اَيِي-د خَاس، أَتَاف اَذَاوم ينِيغ زِي مَانِيس ذَايِي د ثكَّا سُّلْطَا-يَا إِي زِي تݣّغ ثِمسْڒَايِين-أَ." <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />ينَّا-ٱسن عِيْسَى: "يَحْيَى، مَان سُّلْطَا إِي زِي يطهَّار س وَامَان، مَا زِي أَربِّـي مَا زݣ يِوْذَان؟ جَاوْبم-اَيِي-د."<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />سِّيوْڒن جَارَاسن نَّان: "مڒَا ننَّا-اَس <char style="it">سُّلْطَا نِّي</char> قَا ثكَّا-د زِي أَربِّـي، أَتَاف اَذَانغ يِينِي عِيْسَى مَايمِّي وَار زَّايس ثُوْمِينم؟ <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />وَلَكِن مڒَا ننَّا-ٱس <char style="it">سُّلْطَا نِّي</char> قَا ثكَّا-د زݣ يِوْذَان؟؟؟"</para>
  <para style="m" vid="MRK 11:32">ݣّْوْذن نِثْنِي زِي شَّعْب <char style="it">اَذ ينِين اَمنِّي</char> مِينْزِي قَاع تْوَاڒَان بلِّي يَحْيَى نتَّا ذ نَّبِي. <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />أُوشَا نَّان-اَس إِ عِيْسَى: "نشِّين وَار نسِّين شَا."</para>
  <para style="p" vid="MRK 11:33">ئِنْدق-د عِيْسَى ينَّا-ٱسن: "إِيوَا ؤُڒَا ذ نش وَار ذَاوم قَّارغ شَا مَانِيس ذَايِي د تكَّا سُّلْطَا-يَا إِي زِي تݣّغ ثِمسْڒَايِين-أَ."<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">ڒْمَعْنَا ن يخمَّاسن إِي ذِي يدْجَا شَّرّْ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />ئِبْذَا عِيْسَى يسَّاوَاڒ اَكِذْسن س ڒمْعَانِي ينَّا-ٱسن: "ئِجّن ن سِّيّد يࢲُّو اَضِيڒ ذݣ يِجّن ن ومَرْجع نّس. ئِنّض-اَس-د ڒْحِيض، يݣَّا ذَايس ثَسِيرْث وضِيڒ. ئِبْنَا ذَايس يجّن ن ثْسُوْمْعث إِ ڒْعَسّث. يجَّا ذَايس يخمَّاسن صَافِي يرُوْح يسَفر. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />وَامِي د يُوْوض ڒْوقْث ن وڒْقض ن وضِيڒ، ئِكَّر يسّكّ يجّن ن وخدَّام غَار يخمَّاسن نِّي بَاش اَذَاس د ؤُشن ڒْحَقّ نّس ن ومَرْجع ن وضِيڒ. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />وَلَكِن مِين ݣِّين يخمَّاسن نِّي؟ طّْفن-ث ؤُوْثِين-ث، سّكّن-ث-يد يخْوَا. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />ئِسّكّ-اَسن عَاوذ يجّن ن وخدَّام نّغْنِي، مرْزن-اَس عدّن خَاس. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />ئِسّكّ-اَسن يجّن نّغْنِي، نْغِين-ث. <char style="it">ئِسّكّ-اَسن</char> ينّغْنِي اَطَّاس، ئِجّن ؤُوْثِين-ث يجّن نْغِين-ث. <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" />ئِقِّيم-اَس ممِّيس يعِيزّن وَاحْذس. غَار ونݣَّارُو يسّكّ-يث غَارْسن ينَّا: أَقَا اَذ ݣّْوْذن ممِّي. <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />ئِخمَّاسن نِّي مِين ݣِّين؟ كَّرن نَّان إِ وَايَاوْيَا: أَقَا ونِّي إِي غَا يوَرْثن! أَث نْنغ بَاش اَذَاس نَاوِي اَمَرْجع-أَ ن وضِير! <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />طّْفن-ث نْغِين-ث، نْضَرن-ث-يذ غَار بَارَّا إِ ومَرْجع وضِيڒ. <verse eid="MRK 12:8" /><verse number="9" style="v" sid="MRK 12:9" />إِيوَا، مِين ذَاسن غَا يݣّ بَاب ن ومَرْجع نِّي وضِيڒ؟ أَذ د يَاس نتَّا س يِيخف نّس اَذ ينغ يخمَّاسن نِّي مَارَّا اَذ يجّ اَمَرْجع نِّي وضِيڒ إِ ينّغْنِي. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />مَا عمَّارْص وَار ثغْرِيم مين يُوْرِين ذي لْكِتَاب؟</para>
  <para style="q1" vid="MRK 12:10">&lt;أَزْرُو إِي عِيفّن يبنَّاين،</para>
  <para style="q1" vid="MRK 12:10">يوْقع ذݣ ومْشَان اَصبْحَان ذِي ثْغمَّارْث ن دْسَاس.<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />ذ سِيذِي أَربِّـي إِݣ يݣِّين مَانَايَا،</para>
  <para style="q1" vid="MRK 12:11">ذ يجّن ن ڒْحَاجث ذ ثَمقّْرَانْت!&gt;"<verse eid="MRK 12:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />لْحُكَّام ن أَيث-إِسْرَائِيل رزُّوْن اَذ طّْفن عِيْسَى، وَلَكِن ݣّْوْذن زِي شَّعْب. فهْمن بلِّي يسَّاوَاڒ خَاسن عِيْسَى س ڒْمَعْنَا-يَا. جِّين-ث ؤُيُوْرن سّنِّي.<verse eid="MRK 12:12" /></para>
  <para style="s">ضَّرِيبَا ن قَيْصَر</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />كَّرن <char style="it">لْحُكَّام نِّي</char> سّكّن غَار عِيْسَى شَان يفَرِّسِيْين ذ شَان يِوْذَان زِي ڒْحِزب ن وزدْجِيذ هِيرُوْدُس، رْزُون اَث طّْفن خ شَا ن وَاوَاڒ نّس. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />وَامِي د ؤُسِين غَار عِيْسَى نَّان-اَس: "آ لْمُعَلِّم قَا نسّن بلِّي شك نِيشَان إِي ثدْجِيذ. وَار تݣّْوْذذ شَا زݣ يِوْذَان ڒَاحقَّاش وَار تݣّذ بُو س وُوْذمَاون. ثْسڒْمَاذذ س ڒْحَقّ مَامّش يخس أَربِّـي أَ نْعِيش. إِنِي-يَانغ: مَا ثْسمّح شَّرِيعَا نّغ أَ نْخدْجس ضَّرِيبَا إِ وزدْجِيذ قَيْصَر نِغ لَّا؟ مَا ذَاس ت نْخدْجس نِغ لَّا؟"<verse eid="MRK 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15" />ئِسّن عِيْسَى يخَرْوِيضن نِّي إِي ذَايْسن ينَّا-ٱسن: "مَايمِّي ذَايِي ثْسوْجَاذم ثَخْشبْث؟ أَوِيم-اَيِي-د دِينَار نِّي <char style="it">ن ضَّرِيبَا</char> حمَا اَث ࢲرغ." <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />ؤُشِين-اَس-ث-يذ. ينَّا-ٱسن: "وِي يِڒَان تصْوِيرْث-أَ ذ يِيسم-أَ إِي ذَايس؟"</para>
  <para style="p" vid="MRK 12:16">نَّان-اَس: "ن قَيْصَر."<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "مِين يدْجَان ن قَيْصَر ؤُشم-اَس-ث إِ قَيْصَر. مِين يدْجَان ن أَربِّـي ؤُشم-اَس-ث إِ أَربِّـي." أُوْشَا قِّيمن تْعجّْبن ذَايس.<verse eid="MRK 12:17" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتْبشَّار خ ثُوْذَارْث ن ڒبْدَا</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />قَارّْبن-د غَار عِيْسَى شَان يِوْذَان زِي ڒْحِزب ن يصَدُّوْقِيْين (قَّارن نِثْنِي بلِّي يوْذَان وَار د تْنكَّرن شَا زِي ڒْموْث). كَّرن نَّان-اَس: <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />"آ لْمُعَلِّم، قَا يُوْرَا-ٱنغ مُوْسَى اَرْيَاز مڒَا يمُّوْث يجَّا ثَمْغَارْث نّس وَار كِذس د يجِّي بُو ثَارْوَا، ثَاجَّاڒْث نِّي لَابُد اَت يَاوِي وڒْوس نّس بَاش اَكِذس د يجّْ ثَارْوَا إِ وُوْمَاس نِّي يمُّوْثن. <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />نشِّين تُوْغَا اَكِذْنغ سبْعَا ن وَاوْمَاثن، ئِمْڒش ومزْوَارُو يمُّوْث وَار د يجِّي بُو ثَارْوَا. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />ثَمْغَارْث نِّي يُوْوِي-ت وِيس ثْنَاين يمُّوْث وَار د يجِّي بُو ثَارْوَا. أَمنِّي عَاوذ وِيس ثْڒَاثَا. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />أَمنِّي عَاوذ اَڒ وِيس سبْعَا، مُّوْثن مَارَّا وَار كِس د جِّين بُو دُّوْرِّيث. أَڒ ونݣَّارُو ؤُڒَا ذ ثَمْغَارْث نِّي ثمُّوْث. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />يُوْم لْقِيَامَا، خْمِي د غَا كَّرن يِنِّي يمُّوْثن، ؤُمِي غَا ثِيڒِي ثمْغَارْث نِّي؟ أَقَا ؤُوِين-ت س سبْعَا إِذْسن."<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "كنِّيو ثخْضَام ڒَاحقَّاش وَار ثسِّينم شَا لْكِتَاب وَار ثسِّينم شَا ؤُڒَا ذ جّْهذ ن أَربِّـي. <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />خْمِي د غَا كَّرن يِنِّي يمُّوْثن <char style="it">يرْيَازن ذ ثمْغَارِين</char> وَار مدْجْشن شَا وَار تْوَاسْمدْجِيشن شَا. لَّا، أَذ يڒِين اَمشْنَاو لْمَلَائِكَاث إِݣ يدْجَان ذݣ وجنَّا. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />وَلَكِن شُوْف، يِنِّي يمُّوْثن اَذ د كَّرن زِي ڒْموْث. مَا عمَّارْص وَار ثغْرِيم مِين يُوْرِين ذِي لْكِتَاب ن مُوْسَى؟ ذِي ڒْقِصَّا ن ؤُخْشَاب،<note caller="+" style="f"><char style="fr" closed="false">12‏.26 </char><char style="ft" closed="false">مَاشِي مَعْرُوْف مِين يعْنَا وخْشَاب-أَ، وَلَكِن يمْكن ذ شَان اَرْبِيع اَم ثَابْغَا نِغ اَم شَان ثْشجَّارْث ثَمزْيَانْت ذَايس يسنَّانن.</char></note> وَامِي يسِّيوڒ أَربِّـي اَك <char style="it">مُوْسَى</char> ينَّا-ٱس قَا نش ذ أَربِّـي ن بْرَاهِيم، ذ أَربِّـي ن إِسْحَاق، ذ أَربِّـي ن يَعْقُوْب."<note caller="+" style="f"><char style="fr" closed="false">12‏.26 </char><char style="ft" closed="false">سِيذْنَا مُوْسَى تُوْغَا يرَسّ ڒبْهَايم ن وذݣّْوَاڒ نّس نتَّا قَّارن-اَس يَثْرُون، نتَّا ذ ڒفْقِي ن مِدْيَان. ئِجّن ن نْهَار ينْده ڒبْهَايم غَار صَّحْرَا حتَّا اَڒ مَانِي يُوْوض غَار وذْرَار ن أَربِّـي ؤُمِي قَّارن حُوْرِيب. ذِنِّي إِي ذَاس د يمظْهَار لْمَلَائِكَا ن سِيذِي أَربِّـي ذݣ وشعَّاڒ ن ثْمسِّي زِي ڒْوسْط ن يجّن ن ؤُخْشَاب. يُوْفَا مُوْسَى اَخْشَاب نِّي يرقّ بْڒَا مَا ٱث ثشّ ثْمسِّي. ينَّا ذِي نّفْس نّس: "أَذ رَاحغ حمَا اَذ خْزَرغ ثَمسْڒَايْث-أَ إِݣ يسذْهَاشن. مَايمِّي اَخْشَاب-أَ وَار يحرّق شَا؟" وَامِي يرُوْح ذِنِّي بَاش اَذ يخْزَر، ئِࢲْرِي-ث سِيذِي أَربِّـي ئِبَرّح-اَس-د زِي ڒْوسْط ن ؤُخْشَاب نِّي ينَّا-ٱس: "آ مُوْسَى آ مُوْسَى." ينَّا-ٱس: "هَاقَايِي". ينَّا-ٱس أَربِّـي: "وَار تْقَارّب شَا ذَانِيتَا. كّس ثِسِيڒَا زݣ يضَارن نّش ڒَاحقَّاش اَمْشَان-أَ إِي خف ثْبدّذ نتَّا ذ يجّن ن ثْمُوْرْث مُقدَّاسَا." أُوشَا ينَّا-ٱس: "نش ذ أَربِّـي ن ڒجْذُوْذ نّش ذ أَربِّـي ن بْرَاهِيم ذ إِسْحَاق ذ يَعْقُوْب." ڒخْدّنِّي يسَاذَار مُوْسَى اَغمْبُوْب نّس يݣّْوذ اَذ يࢲر أَربِّـي.</char></note> <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" /><char style="it">ينَّا-ٱسن عِيْسَى:</char> "نتَّا ذ أَربِّـي ن يِنِّي يدَّرن مَاشِي ن يِنِّي يمُّوْثن. أَقَا كنِّيو ثخْضَام اَطَّاس!"<verse eid="MRK 12:27" /></para>
  <para style="s">ڒُوْصِيّث ثَمقّْرانْت</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />يُوْسَا-د يجّن زݣ يمْسڒْمَاذن ن شَّرِيعَا يسْڒَا-يَاسن تمْنَاقَاشن، يُوْفَا بلِّي <char style="it">عِيْسَى</char> يجَاوب-يثن مْلِيح. ئِكَّر نتَّا ينَّا-ٱس إِ عِيْسَى: "مِين ثعْنَا ڒُوْصِيّث إِي يدْجَان ذ ثَمقّْرَانْت قَاع ذِي شَّرِيعَا؟"<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />ينَّا-ٱس عِيْسَى: "ڒُوْصِيّث ثَمقّْرَانْت ذ ثَانِيتَا: صنّْطث آي أَيْث-إِسْرَائِيل، سِيذِي أَربِّـي ذ لْإِلَه نّغ، سِيذِي أَربِّـي ذ يجّن. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />أَذ تخْسذ سِيذِي أَربِّـي نّش، س مَارَّا ؤُڒ نّش، س مَارَّا اَرُّوْح نّش، س مَارَّا ڒَعْقڒ نّش، س مَارَّا جّْهذ نّش. <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />ڒُوْصِيّث وِيس ثْنَاين ذ ثَانِيتَا: أَذ تخْسذ اَجَّار نّش اَمشْنَاو يخْف نّش. وَار ذِنِّي بُو شَان ڒُوْصِيّث كْتَار زِي ثِيْنَا."<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />ينَّا-ٱس ومْسڒْمَاذ نِّي ن شَّرِيعَا: "آ لْمُعَلِّم مْلِيح، مِين ثنِّيذ ذ ڒْحَقّ. سِيذِي أَربِّـي ذ يجّن، وَار ذِنِّي ؤُڒَا ذ يجّن إِلَّا نتَّا. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />أُو عَاوذ مڒَا بْنَاذم يتخْس سِيذِي أَربِّـي س مَارَّا وُڒ نّس ذ ڒَعْقڒ نّس ذ جّْهذ نّس اَذ يخس ؤُڒَا ذ اَجَّار نّس اَمشْنَاو يخْف نّس، مَانَايَا حْسن زِي <char style="it">بْنَاذم مڒَا يغَرص</char> دْبِيحث يسّشْمَاض-يت قَاع ذِي ثْمسِّي نِغ اَذ يقدّم مَانَا كْتَار <char style="it">إِ أَربِّـي</char>."<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />يُوْفَا عِيْسَى اَرْيَاز نِّي يجَاوب-يث س ڒفْهَامث، ينَّا-ٱس: "وَار ثݣّْوِيجذ شَا اَطَّاس خ ڒْمُلْك ن أَربِّـي." سّنِّي وَار يزْعِيم حَدّ اَث يسّقْسَا عَاذ كْتَار.<verse eid="MRK 12:34" /></para>
  <para style="s">لْمَسِيح ذ سِيذس ن سِيذْنَا دَاود</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />عِيْسَى اَقَاث ذِي ثمْزِيذَا ثَمقّْرَانْت يسڒْمَاذ ذِنِّي. ئِنْدق-د ينَّا-ٱسن: "مَايمِّي قَّارن يمْسڒْمَاذن ن شَّرِيعَا قَا لْمَسِيح ذ مِّيس ن دَاود؟"<note caller="+" style="f"><char style="fr" closed="false">12‏.35 </char><char style="ft" closed="false">&lt;مِّيس ن دَاود&gt; وَار يدْجِي بُو ذ يجّن ن مِّيس ذ صَّح ن سِيذْنَا دَاود؛ لَّا، نتَّا زِي دُّورِّيث ن سِيذْنَا دَاود.</char></note> <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />ينَّا-ٱسن: "قَا دَاود ينَّا نتَّا س يِيخف نّس س أَرُّوْح يقدّْسن:</para>
  <para style="q1" vid="MRK 12:36">&lt;سِيذِي أَربِّـي ينَّا-ٱس إِ سِيذِي: قِّيم-د خ وفُوْسِي ينُو،</para>
  <para style="q2" vid="MRK 12:36">أَڒ د غَا ݣّغ ڒْعَذْيَان نّش سْوَادَّاي إِ يضَارن نّش.&gt;<verse eid="MRK 12:36" /></para>
  <para style="b" />
  <para style="p">
    <verse number="37" style="v" sid="MRK 12:37" />مَامّش غَا يِيڒِي لْمَسِيح ذ مِّيس ن دَاود؟ نتَّا دَاود يقَّار-اَس إِ لْمَسِيح آ سِيذِي."</para>
  <para style="b" vid="MRK 12:37" />
  <para style="p" vid="MRK 12:37">أَطَّاس ن ڒْغَاشِي تسْڒَان-اَس، فَرْحن.<verse eid="MRK 12:37" /></para>
  <para style="s">لْمُنَافِقِين</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />ئِسڒْمَاذ-يثن عِيْسَى ينَّا-ٱسن: "حْضَام يخف نْوم زݣ يمْسڒْمَاذن ن شَّرِيعَا. نِثْنِي تخْسن اَذ ؤُيُوْرن س يسڒْهَامن نِّي نْسن، تخْسن اَخَاسن سدْجْمن ذِي ڒسْوَاق، <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />تخْسن اَذ قِّيمن ذݣ يمُوْشَان يمزْوُوْرَا ذِي ثمْزِيذَاوِين ذ ڒفْرُوْح. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />تتّن ثَاجَّاڒِين، سْمظْهَارن-د يخف نْسن تْࢲَادْجَان اَطَّاس حمَا اَذ بيّْنن إِ يِوْذَان بلِّي نِثْنِي صبْحن اَطَّاس زَعْمَا. يِيْنَا، لْحِسَاب نْسن اَذ يِيڒِي يقْسح اَطَّاس!"<verse eid="MRK 12:40" /></para>
  <para style="s">ثَاجَّاڒْث ثْصدّق صَّذَقَا كْتَار زِي تْوَاجَر</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />ئِقِّيم عِيْسَى <char style="it">ذِي ثمْزِيذَا ثَمقّْرَانْت</char> زَّاث إِ صّنْدُوْق نّس. ئِࢲْرَا مَامّش ڒْغَاشِي سْرُوْسَان صَّذَقَا نْسن ذي صّنْدُوْق نِّي. أَطَّاس ن تْوَاجَر تݣّن ذِنِّي اَطَّاس ن تْمنْيَاث. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />ثُوْسَا-د يجّن ن ثَاجَّاڒْث ذ ڒْمسْكِينَا وَاهَا ثݣَّا ذِنِّي ثْنَاين يصُوْلْدَان، يعْنِي يجّن ن فْرَنْك. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />ئِڒَاغَا-د عِيْسَى خ يمحْضَارن نّس ينَّا-ٱسن: "أَقَا تسْڒَام ڒْحَقّ: ثَاجَّاڒْث-أَ ذ ڒْمسْكِينَا وَاهَا ثݣَّا ذِي صّنْدُوْق كْتَار زِي مِين ݣِّين مَارَّا ينّغْنِي. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />مِينْزِي مَارَّا ينّغْنِي ؤُشِين زِي مِين خَاسن يزَايْذن ذ اَݣْڒَا. نتَّاث لَّا، وَاخَّا ذ ڒْمسْكِينَا وَاهَا ثْصدّق مَارَّا مِين ثعْڒم."<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">لْعَلَامَاث ن ڒْفَنَا ن دُّنشْت</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />وَامِي د يفّغ عِيْسَى زِي ثمْزِيذَا ثَمقّْرَانْت <char style="it">يقَارّب-د غَارس</char> يجّن ن زݣ يمحْضَارن نّس ينَّا-ٱس: "آ لْمُعَلِّم، خْزَر يزْرَا-يَا ذ ڒبْنِي-يَا مشْحَاڒ ذ يصبْحَانن!"<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />ئِنْدق-د عِيْسَى ينَّا-ٱس: "تْوَاڒِيذ ڒبْنِي-يَا مشْحَاڒ د يتَاس ذ اَصبْحَان، يَاش؟ وَلَكِن وَار ذَا يتْغِيمِي ؤُڒَا ذ يجّن ن وزْرُو خ ونّغْنِي، مَارَّا مَانَايَا اَذ ينهْذم."<verse eid="MRK 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />وَامِي يقِّيم عِيْسَى ذݣ وذْرَار ن زِّيتُون زَّاث إِ ثمْزِيذَا ثَمقّْرَانْت، سّقْسَان-ث بُطْرُس ذ يَعْقُوب ذ يُوْحَنَّا ذ أَنْدْرُوْس وَاحْذس نَّان-اَس: <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />"إِينِي-يَانغ شك، مڒْمِي غَا يوْقع مَانَايَا؟ مِين ثعْنَا لْعَلَامَا نِّي خْمِي عْڒَاين غَا وقْعنْت مَارَّا ثِمسْڒَايِين-أَ؟"<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />ئِجَاوب-يثن عِيْسَى ينَّا-ٱسن: "حْضَام يخف نْوم حمَا وَار كنِّيو يخدّع حَدّ. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />أَطَّاس إِي د غَا يَاسن س يِيسم ينُو زَعْمَا اَذ ينِين قَا نش <char style="it">ذ لْمَسِيح</char>! أَذ خذْعن اَطَّاس ن يِوْذَان. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />خْمِي غَا ثسْڒَام خ لْحُرُوْب ذ ڒخْبَار ن لْحُرُوْب وَار تݣّْوْذث شَا، لَابُد زِي مَانَايَا. وَلَكِن دُّنشْت-أَ عَاذ وَار ثْفنِّي شَا. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />دُّوْلَا اَذ تهْجم خ دُّوْلَا، لْممْلَكَا اَذ تهْجم خ لْممْلَكَا. أَذ يِيڒِي جُّوْع اَذ يوْقع زِّنْزَال ذݣ وَاطَّاس ن يمُوْشَان. مَانَايَا اَذ يِيڒِي اَمشْنَاوڒحْرِيق اَمزْوَارُو ن ثمْغَارْث إِي يتَارْون.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />حْضَام يخف نْوم! أَكنِّيو سلّْمن إِ لْمَحْكَمَاث، أَكنِّيو ؤُوْثن ذِي ثمْزِيذَاوِين نْسن. أَذ تْبدّم زَّاث إِ لْحُكَّام ذ يزدْجِيذن عْلَاحْسَاب يسم ينُو حمَا اَخَافِي ثْشهْذم. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />أَقَا ذ اَمزْوَارُو يتْخصَّا اَذ يتْوَابشَّر لْإِنْجِيل إِ مَارَّا ڒݣْنُوْس. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />خْمِي كنِّيو غَا اَوِين حمَا اَكنِّيو سلّْمن غَار شّْرَع، بْڒَا مَا ٱذ تيْسِيم اَمْنُوْس ذ اَمزْوَارُو ذِي ڒَعْقُوْڒَاث نْوم مين غَا ثِينِيم؛ لَّا، أَوَاڒن نِّي إِي غَا ثِينِيم ذ أَربِّـي إِي ذَاوم ثن غَا يُوْشن ذِي ثْسَعَّات نِّي. وَار يدْجِي بُو ذ كنِّيو إي غَا يسِّيوْڒن؛ لَّا، أَذ يسِّيوڒ أَرُّوْح يقدّْسن. <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />ؤُمَاس اَذ يسلّم ؤُمَاس إِ ڒْموْث. بَابَاس اَذ يسلّم مِّيس. ثَارْوَا اَذ رَاحن ضد إ لْوَلِدِين نْسن، أَثن سلّْمن إِ يِنِّي إِي ثن غَا نْغن. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />أَكنِّيو عِيفّن مَارَّا يوْذَان عْلَاحْسَاب يسم ينُو، وَلَكِن ونِّي غَا يصْبَرن غَار ونݣَّارُو اَتَاف اَذ ينْجم.<verse eid="MRK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />خْمِي غَا ثࢲرم &lt;مِين يدْجَان ذ اَعفَّان اَطَّاس يهدّْمن&gt;، نتَّا يبدّ مَانِي يخصَّا وَار يتْبدِّي شَا، ڒخْدّنِّي يِنِّي يدْجَان ذِي ثْمُورْث ن يَهُوْذِيَا يتْخصَّا اَذ اَروْڒن غَار يذُوْرَار. (أَ فْهم آ ونِّي يغْرِين <char style="it">مَانَايَا</char>!) <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />ونِّي غَا يِڒِين خ ثْزقَّا<note caller="+" style="f"><char style="fr" closed="false">13‏.15 </char><char style="ft" closed="false">ثَزقَّا نتَّاث ذ سّْظَاح.</char></note> نّس يتْخصَّا-ٱس وَار يهوِّي شَا غَار ثدَّارْث وَار ذَايس يتِّيذف شَا حمَا اَذ ييْسِي شَان ڒْحَاجث. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />ونِّي غَا يِڒِين ذݣ ومَرْجع يتْخصَّا-ٱس وَار يتعْقِيب شَا غَار ثدَّارْث اَذ ييْسِي تْشَامِّير نّس. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />يَا تَمَارَا إِي غَا يِيڒِين خ ثمْغَارِين نِّي س يعدِّيسن ذݣ وُوْسَّان نِّي ذ ثِنِّي يسُّوْطُوْضن! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />تَّارث إِ أَربِّـي بَاش مَانَايَا وَار يتِّيڒِي شَا ذِي ڒْمشْتَا. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />ذِي ڒْوقْث نِّي اَتَاف اَذ توْقع يجّن ن تَمَارَا ذ ثَمقّْرَانْت إِي وَار يوْقِيعن عمَّارْص زݣ وَامِي ثدْجَا دُّنشْت-أَ إِي د يخْڒق أَربِّـي اَڒ ڒخُّو، أُو عمَّارْص اَذ توْقع عَاوذ. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />مَعْلِيك سِيذِي أَربِّـي وَار يسنْقِيس شَا ذِي ڒِيَّام نِّي ن تَمَارَا-يَا إِي د غَا يَاسن، أَتَاف وَار ينجّم ؤُڒَا ذ يجّن. خ سَّبَاب ن يِنِّي يخْضَر أَربِّـي، أَتَاف اَذ يسنْقس ڒِيَّام نِّي إِي د غَا يَاسن.<verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21" />سّنِّي مڒَا ينَّا-ٱوم شَان يِجّن: خْزَرم! أَقَاث ذَانِيتَا لْمَسِيح! نِغ، أَقَاث ذِيهَا! وَار ث تَامْنم شَا. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />أَقَا اَطَّاس إِي د غَا يمظْهَارن س يخَرِّيقن اَذ ينِين اَقَا نش ذ لْمَسِيح نِغ نش زِي لْأَنْبِيَا. أَذ ݣّن لْمُعْجِزَاث ذ ثِمقّْرَانِين ذ ڒَعْجَايب <char style="it">زَعْمَا</char> حمَا اَذ خذْعن يوْذَان. مَعْلِيك زمَّرن إِڒِي خذْعن ؤُڒَا ذ يِنِّي يخْضَر أَربِّـي. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />إِڒِيم عْلَابَال كنِّيو! أَقَا نش عڒْمغ-اَوم خ مَارَّا مَانَايَا قْبڒ مَا ٱذ يوْقع.<verse eid="MRK 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />منْبَعْد إِ تَمَارَا ن ڒِيَّام نِّي، ڒخْدّنِّي ثْفُوْشْت اَذ تذْوڒ ذ ثَادْجسْت، ثَزِيرِي وَار تِيشّ بُو ثْفَاوْث. <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />ئِثْرَان اَذ د وْضَان زݣ وجنَّا، يِنِّي يجهْذن ذݣ وجنَّا اَثن يسنْهزّ أَربِّـي. <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" />ڒخْدّنِّي إِي غَا ࢲرن مِّيس ن بْنَاذم يهوَّا-د ذݣ وسيْنُو س لْعَظَمَا ذ جّْهذ نّس يمْغَارن. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />أَذ د يسّكّ لْمَلَائِكَاث نّس غَار اَرْبعَا ن يمُوْشَان ن ثْمُورْث مَانِيس د يتكّ اَرِّيح: <char style="it">زِي شَّرْق ذ لْغَرْب ذ لْجَنُوب ذ شَّمَال</char>. أَذ د يسْمُوْن يِنِّي يخْضَر زِي ڒَاحدّ ن دُّنشْت-أَ اَڒ ڒَاحدّ ن وجنَّا.<verse eid="MRK 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />ڒمْذم يجّن ن ڒْمَعْنَا زِي ثْشجَّارْث ن ثَازَارْث. غِير ڒفْرُوْع نّس اَذ حبّْبن اَذ ݣّن ثِيفْرَاي، أَتَاف اَذ تسّْنم يَالَّاه اَنبْذُو يقَارّب-د. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />أَمنِّي ؤُڒَا ذ كنِّيو. خْمِي غَا ثࢲرم ثِمسْڒَايِين-أَ يتوْقِيعن اَتَاف اَذ تسّْنم إِلَّا مَانَايَا يُوْذس-د، أَقَاث زَّاث إِ ثوَّارْث. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />أَقَا تسْڒَام ڒْحَقّ: يوْذَان ن ڒْوقْث-أَ وَار تْمتِّين شَا اَڒ غَا يوْقع مَارَّا مَانَايَا. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />أَذ يفْنَا وجنَّا ذ ثْمُوْرْث، وَلَكِن اَوَاڒن ينُو وَار فنِّين شَا عمَّارْص.<verse eid="MRK 13:31" /></para>
  <para style="b" />
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />شُوْف، نْهَار نِّي نِغ ثْسَعَّات نِّي وَار ت يسِّين ؤُڒَا ذ يجّن، لَّا لْمَلَائِكَاث ذݣ وجنَّا ؤُڒَا ذ مِّيس. ئِسّن-يت غِير بَابَا وَاحْذس. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />حْضَام يخْف نْوم، إِڒِيم عْلَابَال ڒَاحقَّاش وَار ثسِّينم شَا مڒْمِي د غَا ثَاس ڒْوقْث نِّي.<verse eid="MRK 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 13:34" />نْهَار نِّي اَذ يِيڒِي اَم يِجّن ن سِّيّد يرزُّو اَذ يسَفر. ئِفّغ زِي ثدَّارْث نّس، ئِخدَّامن نّس يكلّف-يثن خ وَاݣْڒَا نّس كُڒ يجّن خ ڒْخذْمث نّس. ئِوصَّا اَعسَّاس ن ثوَّارْث اَذ يقِّيم يفَاق. <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />خ مَانَايَا فَاقم بَعْدَا، قَا وَار ثسِّينم مڒْمِي د غَا يذْوڒ بَاب ن ثدَّارْث. وَار ثسِّينم مَا اَݣ وعشِّي نِغ غَار ڒْوسْط ن دْجِيڒث نِغ خْمِي غَا يدّن ويَازِيض نِغ غَار ڒفْجَر. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />غَارْوم اَذ د يَاس عْلَاغَفْلَا اَكنِّيو يَاف ثطّْصم! <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />مِين ذَاوم قَّارغ، قَّارغ-ث إِ مَارَّا: ئِڒِيم عْلَابَال!"<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">ئِجّن ن ثمْغَارْث ثْذهّن سِيذِيثْنغ عِيْسَى س وَامَان ن لْوَرْذ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />ئِقِّيم-اَس يُوْمَاين إِ ڒْعِيذ اَمقّْرَان ن أَيث-إِسْرَائِيل ذ ڒْعِيذ نِّي ؤُمِي قَّارن ڒْعِيذ ن ثفْضِيرْث. أَرُّوْيَاس ن ڒْفُقَهَا ذ يمْسڒْمَاذن ن شَّرِيعَا رزُّوْن مَامّش ذَاس غَا ݣّن حمَا اَذ طّْفن عِيْسَى س ثحْرَايْمِيث اَث نْغن. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />نَّان جَارَاسن: "ئِتْخصَّا وَار ث نْتطّف شَا ذِي ڒْعِيذ حمَا شَّعْب وَار يتݣّ شَا ڒْفَوْضَا."<verse eid="MRK 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />عِيْسَى اَقَاث ذݣ وبِيلَاج ن بَيْت عَنْيَا ذِي ثدَّارْث ن يِجّن قَّارن-اَس سِمْعَان بُو-جْذَام. وَامِي يقِّيم ذِنِّي يتتّ، ثقَارّب-د غَارس يجّن ن ثمْغَارْث غَارس يجّن ن ثْزيَّات ذَايس اَمَان ن لْوَرْذ يصْفَان، ئِغْڒَان س وَاطَّاس. ثرْزم-يت ثْفرّغ-اَس-ثن خ وزدْجِيف نّس. <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />شَان إِذْسن زَّايْسن يقّس-اَسن ڒْحَاڒ نَّان جَارَاسن: "مَايمِّي قَاع اَضيّع-أَ ن وَامَان ن لْوَرْذ؟ <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />أَتَاف اَمَان نِّي يڒِي منْزن س يِجّن ن تَّمَان ذ اَمقّْرَان كْتَار زِي ثڒْتمِيَّا ن ثْپيَّاسِين ن نُّقَارْث اَذ مُّوْشنْت إِ يمسْعَان!" قِّيمن نِثْنِي نهَّان-ت اَطَّاس.<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />ينَّا-ٱسن عِيْسَى: "اجّم-ت! مَايمِّي ت ثسْخيَّاقم؟ أَقَا مِين ذَايِي ثݣَّا ذ اَصبْحَان اَطَّاس. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />ئِمسْعَان اَقَاثن اَكِذْوم ڒبْدَا. مڒْمِي مَا ثخْسم ثْزمَّرم اَذَايْسن ثݣّم ڒْخِير، نش وَار كِذْوم تْغِيمِيغ شَا إِ ڒبْدَا. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />ثݣَّا مِين خَاس. ثْفرّغ-اَيِي اَمَان-أَ ن لْوَرْذ خ دَّات ينُو حمَا اَذَايِي ثْسوْجذ إِ ثنْضڒْث ينُو. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />أَقَا تسْڒَام ڒْحَقّ: مَانِي مَا يُوْوض لْإِنْجِيل ذِي دُّنشْت-أَ اَمن-ثكْمَاڒ، أَتَاف اَذ عَاوْذن خ ثمْغَارْث-أَ ذ مِين ذَايِي ثݣَّا اَم يِجّن ن ذِكْرَا خَاس."<verse eid="MRK 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />أُوْشَا يكَّر يَهُوْذَا إِسْخَريُوْطِي ونِّي زِي ثنْعَاش ن اَرُّسُل يرُوْح نتَّا غَار أَرُّوْيَاس ن ڒْفُقَهَا حمَا اَذَاسن يزّنْز عِيْسَى. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />سْڒِين مَانَايَا فَرْحن وعْذن-ث اَذَاس ؤُشن تْمنْيَاث. سّنِّي يرزُّو يَهُوْذَا لْفُرْصَا مَامّش إِي غَا يݣّ اَذَاسن ث يزّنْز.<verse eid="MRK 14:11" /></para>
  <para style="s">أَمنْسِي ن ڒْعِيذ اَمقّْرَان ن أَيث-إِسْرَائِيل</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />نْهَار اَمزْوَارُو ن ڒْعِيذ ن ثفْضِيرْث، نْهَار نِّي إِي ذِي غَرّْصن ڒْعِيذ، سّقْسَان يمحْضَارن عِيْسَى نَّان-اَس: "مَانِي ثخْسذ أَ نْرَاح اَذَاش نْسوْجذ اَمنْسِي ن ڒْعِيذ اَمقّْرَان؟"<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />ئِكَّر عِيْسَى <char style="it">يخْضَر</char> ثْنَاين زݣ يمحْضَارن نّس يسّكّ-يثن ينَّا-ٱسن: "رُوْحم غَار ثنْدِينْت، أَكِذْوم يمڒْقَا يجّن ن ورْيَاز ييْسِي-د اَقْنُوْش ن وَامَان، ذْفَارم-ث. <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />مَانِي مَا يُوْذف إِنِيم-اَس إِ بَاب ن ثدَّارْث نِّي، قَا ينَّا-ٱش لْمُعَلِّم: مَانِي يدْجَا وخَّام ينُو إِي ذِي غَا عيّْذغ نش ذ يمحْضَارن ينُو؟ <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />أَكنِّيو يَاوِي غَار يِجّن ن ثْغُوْرْفَات ذ ثَمقّْرَانْت ثسُّو، ثعْذڒ. ذِنِّي إِي ذَانغ غَا ثسْوجْذم." <verse eid="MRK 14:15" /><verse number="16" style="v" sid="MRK 14:16" />رُوْحن يمحْضَارن نّس ؤُذْفن غَار ثنْدِينْت، ؤُفِين نِيشَان مَامش ذَاسن ينَّا. صَافِي سْوجْذن اَمنْسِي ن ڒْعِيذ.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />ثُوْوض-د ثْمدِّيث، يُوْسَا-د عِيْسَى اَك ثنْعَاش ن اَرُّسُل نّس. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />قِّيمن تتّن ينَّا-ٱسن عِيْسَى: "أَقَا تسْڒَام ڒْحَقّ: ئِجّن زَّايْوم يتتّ اَكِذِي اَذَايِي يزّنْز."<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />ئِقِّيم ذَايْسن ڒْحَاڒ يمحْضَارن نّس تْسقْسَان-ث ئِج-يج نَّان-اَس: "وَار يدْجِي بُو ذ نّش، يَاش؟"<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "ئِجّن زِي كنِّيو زِي ثنْعَاش إِذْوم، ونِّي إِي كِذِي يسِّيسْنن ذِي طّبْصِي." <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />ينَّا-ٱسن: "مِّيس ن بْنَاذم اَذَاس يوْقع عْلَاحْسَاب مَامش خَاس يقَّار لْكِتَاب، وَلَكِن يَا ڒفْضِيحث ن بْنَاذم نِّي إِي ث غَا يزّنْزن! حْسن إِ نتَّا مْڒِي وَار د يخْڒِيق شَا."<verse eid="MRK 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />وَامِي عَاذ تتّن، ئِيْسِي-د اَغْرُوْم يشكَّر أَربِّـي يرْزَا اَغْرُوْم نِّي يُوْشَا-ٱسن-ث إِ يمحْضَارن نّس ينَّا-ٱسن: "يْسِيم-ث، ذ وَا إِݣ يدْجَان ذ دَّات ينُو." <verse eid="MRK 14:22" /><verse number="23" style="v" sid="MRK 14:23" />ئِيْسِي-د ڒْكَاس يشكَّر أَربِّـي يُوْشَا-اَسن-ث، سْوِين زَّايس مَارَّا إِذْسن. <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />ينَّا-ٱسن: "<char style="it">ڒْكَاس-أَ</char> ذَايس يذَامّن<note caller="+" style="f"><char style="fr" closed="false">14‏.24 </char><char style="ft" closed="false">ئِذَامّن نتَّا ذ دّم.</char></note> ن ڒْعَهذ، يعْنِي ذ يذَامّن ينُو إِي غَا يَازّْڒن عْلَاحْسَاب اَطَّاس ن يِوْذَان. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />أَقَّا تسْڒَام ڒْحَقّ: زِي سَّا اَڒ ثْسَاونْت وَار سسّغ شَا زݣ وَامَان-أَ وضِيڒ حتَّا اَڒ نْهَار نِّي إِي ثن غَا سْوغ زِي جْذِيذ ذِي ڒْمُلْك ن أَربِّـي." <verse eid="MRK 14:25" /><verse number="26" style="v" sid="MRK 14:26" />غنّْجن يجّن ن يِزْڒِي ن ڒْعِيذ، سّنِّي فّْغن رُوْحن غَار وذْرَار ن زِّيتُوْن.<verse eid="MRK 14:26" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسَّاوَاڒ خ ونْكَر ن بُطْرُس</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />ينَّا-ٱسن عِيْسَى إِ يمحْضَارن نّس: "أَذَايِي ثْسمْحم مَارَّا إِذْوم مِينْزِي يقَّار لْكِتَاب:</para>
  <para style="q1" vid="MRK 14:27">&lt;أَذ ؤُوْثغ ونِّي يرَاسّن يحُوْڒِيْين،</para>
  <para style="q2" vid="MRK 14:27">كُڒ يجّن زِي ثْحِيمرْث مَانِي غَا يَرْوڒ.&gt;<note caller="+" style="f"><char style="fr" closed="false">14‏.27 </char><char style="ft" closed="false">خْزَار زَكَرِيَا 7‏:13.</char></note><verse eid="MRK 14:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="MRK 14:28" />وَلَكِن خْمِي د غَا كَّرغ زِي ڒْموْث، أَذَاوم يزْوَارغ غَار ثْمُوْرْث ن لْجَلِيل."<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />ينَّا-ٱس بُطْرُس: "وَاخَّا اَذَايش غَا سمْحن مَارَّا، نش وَار ذَايش سمْحغ شَا."<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />يَارَّا خَاس عِيْسَى ينَّا-ٱس: "أَقَا تسْڒِيذ ڒْحَقّ: ثَا، دْجِيڒث-أَ قْبڒ مَا ٱذ يدّن ويَازِيض مَرّْثَاين اَتَاف اَذَايِي ثنْكَرذ ثْڒَاثَا ن ثْوَاڒَاثِين."<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />ينَّا-ٱس بُطْرُس نتَّا متْأَكَّاد: "نش وَار ش نكَّرغ شَا وَاخَّا اَكِذش إِي غَا مّْثغ." أَمنِّي إِي نَّان مَارَّا يمحْضَارن.<verse eid="MRK 14:31" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتْࢲَادْجَا ذݣ وذْرَار ن زِّيتُوْن</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />يُوْسَا-د عِيْسَى اَك يمحْضَارن نّس غَار يِجّن ن ومْشَان قَّارن-اَس &lt;ݣَتْسِمَانِي.&gt; ينَّا-ٱسن: "قِّيمم ذَا، نش اَذ رَاحغ ذِيهَا اَذ ࢲَّادْجغ." <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />يُوْوِي اَكِذس بُطْرُس ذ يَعْقُوْب ذ يُوْحَنَّا، ئِبْذَا يتْنخْڒع يتْخيَّاق. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />ينَّا-ٱسن: "ڒَعْمَر ينُو عْڒَاين اَذ يدُّوْقّز س لْحُزن. قِّيمم ذَا ثْفَاقم." <verse eid="MRK 14:34" /><verse number="35" style="v" sid="MRK 14:35" />ئِبعّذ خَاسن شْوَايْت، ئِسجّذغَار ثْمُوْرْث يبْذَا يتتَّار إِ أَربِّـي يرزُّو اَخَاس تْوَاكّس ثْسَعَّات نِّي. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />ينَّا: "آ بَابَا، شك كُڒْشِي ثْزمَّرذ-اَس، سْبعّذ-يث خَافِي ڒْكَاس-أَ ن ڒَعْذَاب. مَاشِي مَامش خْسغ نش؛ لَّا، مَامّش يخس ڒْخَاضَر نّش شك."<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />ئِذْوڒ غَار يمحْضَارن-أَ يُوْفِي-ثن طّْصن، ينَّا-ٱس إِ بُطْرُس: "مَا تطّْصذ آ سِمْعَان؟ مَا وَار ثْزمَّرذ شَا اَكِذِي ثْفَاقذ وَاخَّا ذ يجّن ن ثْسَعَّات وَاهَا؟ <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />إِڒِيم عْلَابَال ࢲَّادْجم حمَا وَار تِيذْفم شَا ذِي ڒمْحَاين. ؤُڒ ن بْنَاذم يوْجذ وَلَكِن دَّات نّس ثضْعف." <verse eid="MRK 14:38" /><verse number="39" style="v" sid="MRK 14:39" />ئِبعّذ خَاسن عَاوذ يتَّار إِ أَربِّـي اَمشْنَاو اَمزْوَارُو. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />ئِذْوڒ-د عَاوذ غَارْسن يُوْفِي-ثن طّْصن ڒَاحقَّاش يغلّب خَاسن يِضص. نِثْنِي عَاوذ وَار ؤُفِين مِين ذَاس غَا ينِين. <verse eid="MRK 14:40" /><verse number="41" style="v" sid="MRK 14:41" />ئِذْوڒ-د غَارْسن وِيس ثڒْت-مَرَّاث ينَّا-ٱسن: "عَاذ ثطّْصم، عَاذ ثْريّْحم؟ صَافِي، بَرَكَا! أَقَا ثُوْوض-د ڒْوقْث نِّي إِي ذِي غَا يتْوَاسلّم مِّيس ن بْنَاذم غَار يفَاسّن ن يِنِّي يعصَّان. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />كَّرم أَ نُوْيُوْرم، قَا ونِّي إِي ذَايِي غَا يزّنْزن اَقَاث يُوْسَا-د."<verse eid="MRK 14:42" /></para>
  <para style="s">ئِسْرَائِيلِيْين ذ يرُوْمَانِيْين تطّْفن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />يَالَّه عِيْسَى يسَّاوَاڒ يُوْوض-د يَهُوْذَا، يجّن زِي ثنْعَاش نِّي ن اَرُّسُل نّس. يُوْوِي-د اَكِذس ڒْغَاشِي اَطَّاس يْسِين ڒسْيُوْف ذ يْدبُّوْزن. سّكّن-ثن-د اَرُّوْيَاس ن ڒْفُقَهَا ذ يمْسڒْمَاذن ن شّرِيعَا ذ يمقّْرَانن ن أَيث-إِسْرَائِيل.<verse eid="MRK 14:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MRK 14:44" />ونِّي إِي ث غَا يزّنْزن يعْنِي يَهُوْذَا قْبڒ تُوْغَا يتَافق اَكِذْسن خ يِجّن ن لْعَلَامَا ينَّا-ٱسن: "ونِّي خف غَا سدْجْمغ ذ ونِّي إِي خف ثْرزُّوْم. طّْفم-ث، أَوِيم-ث يحْضَا." <verse eid="MRK 14:44" /><verse number="45" style="v" sid="MRK 14:45" />صَافِي يُوْسَا-د يَهُوْذَا يقَارّب غَار عِيْسَى ينَّا-ٱس: "آ سِيذِي." أُوْشَا يسدْجم خَاس. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />ڒخْدّنِّي سرْسن خَاس يفَاسّن نْسن طّْفن-ث. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />ئِجّن زݣ يِنِّي ذِنِّي يدْجَان يجْبذ-د سِّيف يُوْوْثَا زَّايس يسْمغ ن اَرَّايس ن ڒْفُقَهَا يقسّ-اَس اَمزُّوْغ.<verse eid="MRK 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48" />ينَّا-ٱسن عِيْسَى: "مَا تْغِير-اَوم قَا نش ذ لْمُجْرِم وَامِي د ثيْسِيم ڒسْيُوْف ذ يدبُّوْزن حمَا اَذَايِي ثطّْفم نِغ؟ <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />تُوْغَا تْغِيمِيغ اَكِذْوم مْكُڒ نْهَار ذِي ثمْزِيذَا ثَمقّْرَانْت سڒْمَاذغ ذِنِّي، وَار ذَايِي ثطِّيفم شَا. وَلَكِن مَارَّا مَانَايَا يوْقع حمَا اَذ يكمّڒ مِين يُوْرِين ذِي لْكُتُب." <verse eid="MRK 14:49" /><verse number="50" style="v" sid="MRK 14:50" />أُوْشَا سمْحن ذَايس مَارَّا اَروْڒن.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />يذْفَار-يث يجّن ن وحنْجِير، خَاس تْشَامِّير وَاهَا. طّْفن-ث <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />وَلَكِن نتَّا يَرْوڒ-اَسن ذ اَعرْيَان يجَّا ذِنِّي تْشَامِّير نّس.<verse eid="MRK 14:52" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى زَّاث إِ لْحُكَّام ن أَيث-إِسْرَائِيل</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />ؤُوِين عِيْسَى غَار اَرَّايَس ن ڒْفُقَهَا. مُوْنن اَكِذس مَارَّا اَرُّوْيَاس ن ڒْفُقَهَا، ذ يمقّْرَانن ن أَيث-إِسْرَائِيل، ذ يمْسڒْمَاذن ن شَّرِيعَا. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />ئِذْفَار-يث بُطْرُس زِي ڒݣّْوَاج، يُوْذف غَار ڒمْرَاح ن ثدَّارْث ن اَرَّايس نِّي. ئِقِّيم اَك يعسَّاسن يزْغَار غَار ثْمسِّي. <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />أَرُّوْيَاس ن ڒْفُقَهَا ذ مَارَّا جْمَاعث ن لْحُكَّام ن أَيث-إِسْرَائِيل رزُّوْن شْهَاذث ضد إِ عِيْسَى حمَا اَث نْغن وَلَكِن وَار ؤُفِين وَالُو. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />أَطَّاس إِي خَاس يشهّْذن ࢲُّوْر، وَلَكِن غَارْسن تَنَاقُض ذِي شْهَادث نْسن كُڒ يجّن مِين يقَّار. <verse eid="MRK 14:56" /><verse number="57" style="v" sid="MRK 14:57" />كَّرن ڒبْعَاض شهْذن خَاس ࢲُّوْر نَّان: <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />"نتْسْڒَا-يَاس يقَّار قَا نش اَذ هذْمغ ثَمْزِيذَا-يَا ثَمقّْرَانْت إِي بْنَان يِوْذَان س يفَاسّن، أَذ بْنِيغ يجّن ن ثمْزِيذَا ذِي ثڒْتِيَّام وَار ت بْنِين يِوْذَان س يفَاسّن." <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />وَلَكِن عَاوذ غَارْسن تَنَاقُض ذِي شْهَادث نِّي نْسن كُڒ يجّن مِين يقَّار. <verse eid="MRK 14:59" /><verse number="60" style="v" sid="MRK 14:60" />أُوْشَا يبدّ اَرَّايس ن ڒْفُقَهَا ذِي ڒْوسْط ن جْمَاعث ينَّا-ٱس إِ عِيْسَى: "مَا وَار ثقَّارذ وَالُو شك؟ مِين خَاش شهّْذن يِوْذَان-أَ؟" <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />ئِقِّيم عِيْسَى يسْقَار وَار خَاس يَارِّي شَا. ئِكَّر يسّقْسَا-ث عَاوذ اَرَّايس ن ڒْفُقَهَا ينَّا-ٱس: "مَا شك ذ لْمسِيح مِّيس ن أَربِّـي إِي يدْجَان مُبَارِك؟"<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />ينَّا-ٱس عِيْسَى: "وَاه، ذ نّش. كنِّيو اَذ تࢲرم مِّيس ن بْنَاذم يقِّيم خ وفُوْسِي ن لْقَوِي. أَث ثࢲرم عَاوذ يهوَّا-د اَك وسيْنُو وجنَّا."<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />أَرَّايس نِّي ن ڒْفُقَهَا يغَرص اَرُّوض خ يِيخف نّس ينَّا-ٱسن: "وَار نحْذِيج بُو ڒشْهُوْذ! <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />ما ثسْڒِيم-اَس يقَّار لْمُنْكَر خ سِيذِي أَربِّـي؟ مِين ذَاوم يمظْهَارن؟" مَارَّا حكْمن خَاس بلِّي ئِسْذَاهدْج ڒْموْث.<verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />سّنِّي بْذَان ڒبْعَاض زَّايْسن سُّوْسُوْفن خَاس. ڒحّْفن-اَس خ وغمْبُوْب نّس شَّاثن-ث س ڒْپُوْنْيَاث قَّارن-اَس: إِيوَا آ نَّبِي سِيوڒ! ؤُوِين-ث-يد يعسَّاسن شَّاثن-ث س يسقِّيڒن.<verse eid="MRK 14:65" /></para>
  <para style="s">بُطْرُس ينكَّر سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />بُطْرُس يقِّيم غَار بَارَّا اَودَّاي ذِي ڒمْرَاح. ثْقَارّب غَارس يجّن ن ثْخدَّانْت ن اَرَّايس ن ڒْفُقَهَا. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />ثࢲْرِي-ث يزْغَار غَار ثْمسِّي، ثخْزَار ذَايس مْلِيح ثنَّا-ٱس: "ؤُڒَا ذ شك ثدْجِيذ اَك عِيْسَى زِي نَاصِرَا."<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />ينْكَر بُطْرُس ينَّا-ٱس: "وَار فْهِيمغ شَا وَار سِّينغ شَا مِينْخف ثْسَّاوَارذ!" ئِفّغ بُطْرُس يرُوْح طَّارْف ن ثوَّارْث ن ڒمْرَاح. {ڒخْدّنِّي يدّن ؤُيَازِيض.}<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />ثࢲْرِي-ث ثْخدَّانْت نِّي ذِنِّي ثنَّا-ٱسن عَاوذ إِ يِنِّي يبدّن ذݣ ومْشَان نِّي: "قَا اَرْيَاز-أَ وَانِيتَا زَّايْسن."<verse eid="MRK 14:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MRK 14:70" />ئِنْكَر بُطْرُس عَاوذ. منْبَعْد شْوَايْت نَّان-اَس يِنِّي يبدّن ذݣ ومْشَان نِّي: "إِيوَا نِيشَان، شك ذ يجّن زَّايْسن مِينْزِي شك زِي لْجَلِيل."<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />ئِكَّر بُطْرُس يبْذَا يتْحَرّم يخف نّس يتْجَادْجَا يقَّار-اَسن: "أَرْيَاز-أَ إِي خف ثْسَّاوَاڒم نش وَار ث سِّينغ شَا!" <verse eid="MRK 14:71" /><verse number="72" style="v" sid="MRK 14:72" />ڒخْدّنِّي يدّن ويَازِيض ثْوَاڒَا وِيس ثْنَاين، ئِفكَّر-د بُطْرُس اَوَاڒ نِّي ن عِيْسَى وَامِي ذَاس ينَّا: قْبڒ مَا ٱذ يدّن ويَازِيض مَرّْثَاين اَذَايِي ثنْكَرذ تْڒَاثَا ن ثْوَاڒَاثِين. وَامِي يفكَّر ذِي مَانَاينِّي يرُو يمطَّاون ذ يمدْجَاحن اَطَّاس.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">تَاوِين سِيذِيثْنغ عِيْسَى غَار لْحَاكم بِيلَاطُس</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />وَامِي يصْبح ڒْحَاڒ، مُوْنن اَرُّوْيَاس ن ڒْفُقَهَا، ذ يمقّْرَانن ن أَيث-إِسْرَائِيل، ذ يمْسڒْمَاذن ن شَّرِيعَا، ذ مَارَّا جْمَاعث ن لْحُكَّام نْسن مْشَوَارن جَارَاسن. شَرْفن عِيْسَى ؤُوِين-ث اَث سلّْمن إِ <char style="it">لْحَاكم اَرُّوْمَانِي ؤُمِي قَّارن</char> بِيلَاطُس.<verse eid="MRK 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2" />ئِسّقْسَا-ث بِيلَاطُس ينَّا-ٱس: "مَا ذ شك ذ اَزدْجِيذ ن أَيث-إِسْرَائِيل؟"</para>
  <para style="p" vid="MRK 15:2">ينَّا-ٱس عِيْسَى: "أَقَا ثنِّيذ-ت شك."<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />قِّيمن ذِنِّي اَرُّوْيَاس ن ڒْفُقَهَا تَهَامن-ث اَطَّاس.<verse eid="MRK 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 15:4" />ينَّا-ٱس بِيلَاطُس إِ عِيْسَى: "مَا وَار ثْقَّارذ وَالُو؟ قَا خْزَر مشْحَاڒ خَاك تْشثْشَان!" <verse eid="MRK 15:4" /><verse number="5" style="v" sid="MRK 15:5" />ئِقِّيم بِيلَاطُس يتْعجّب وَامِي وَار خَاسن يَارِّي بُو وَاوَاڒ عِيْسَى.<verse eid="MRK 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />ذِي مْكُڒ ڒْعِيذ اَمقّْرَان ينُوْم بِيلَاطُس يضدْجق-اَسن-د إِ يجّن ن ومحْبُوْس عْلَاحْسَاب ونِّي يخس شَّعْب. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />ئِجّن ن ومحْبُوْس قَّارن-اَس بَارَابَاس، ݣِّين-ث ذِي ڒحْبس اَك يِنِّي يتْحرَّابن ضد إِ ڒْمخْزن مِينْزِي نْغِين يجّن ن بْنَاذم ذِي ڒْفَوْضَا. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />ݣَعّْذن ڒْغَاشِي غَار بِيلَاطُس، بْذَان تتَّارن زَّايس اَذَاسن يݣّ مِين ينُوْم يتݣّ-اَسن.<verse eid="MRK 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 15:9" />ينَّا-ٱسن بِيلَاطُس: "مَا ثخْسم اَذَاوم د ضڒْقغ إِ وزدْجِيذ ن أَيث-إِسْرَائِيل؟" <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />ئِسّن بِيلَاطُس بلِّي اَرُّوْيَاس نِّي ن ڒْفُقَهَا سلّْمن-اَس عِيْسَى ڒَاحقَّاش حسْذن-ث. <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />كَّرن اَرُّوْيَاس نِّي ن ڒْفُقَهَا قڒْبن اَزدْجِيف إِ ڒْغَاشِي نِّي حمَا اَذَاسن د يضْڒق إِ بَارَابَاس. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />ئِنْدق-د بِيلَاطُس ينَّا-ٱسن: "إِيوَا مِين ذَاس غَا ݣّغ إِ بْنَاذم-أَ ؤُمِي ثقَّارم قَا نتَّا ذ اَزدْجِيذ ن أَيث-إِسْرَائِيل؟"<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />سْنكَّرن ثْغُوْيّث س جّْهذ قَّارن: "صلّْب-يث!"<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />ينَّا-ٱسن بِيلَاطُس: "مَايمِّي؟ مَان لْجَرِيمَا إِݣ يݣّا وَانِيتَا؟"</para>
  <para style="p" vid="MRK 15:14">وَلَكِن اَرنِّين سْنكَّرن ثْغُوْيّث س جّْهذ قَّارن: "صلّْب-يث!"<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />بِيلَاطُس وَامِي يرزُّو اَذ يسعّف ڒْغَاشِي نِّي، يضْڒق-اَسن-د إِ بَارَابَاس. سّنِّي ؤُوْثِين عِيْسَى س وسْغُوْن يسلّْم-اَسن-ث حمَا اَث صلّْبن خ صَّلِيب.<verse eid="MRK 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />ؤُوِين-ث ڒْعَسْكَار غَار ذَاخڒ، غَار ڒمْرَاح ن ڒقْصَار ن لْحَاكم، سْمُوْنن-د ذِنِّي مَارَّا لْفِرْقَا ن ڒْعَسْكَار نِّي. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />ݣِّين خَاس اَسڒْهَام ذ اَزݣّْوَاغ.<note caller="+" style="f"><char style="fr" closed="false">15‏.17 </char><char style="ft" closed="false">ذَا ذ لْأَيَا 20، نْزمَّر اَ نِينِي اَزݣّوَاغ نِغ ݣْرُوْنَا.</char></note> مُوْذن-اَس يجّن ن تَّاج ن يسنَّانن ݣِّين-اَس-ث خ وزدْجِيف نّس. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />بْذَان تْسدْجَامن خَاس قَّارن-اَس سَّلَام آي اَزدْجِيذ ن أَيث-إِسْرَائِيل. <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />شَّاثن-ث س يِجّن ن وغَانِيم غَار وزدْجِيف نّس، سُّوْسُوْفن خَاس، ترْكَاعن-اَس، تْسجَّاذن-اَس.<verse eid="MRK 15:19" /></para>
  <para style="s">تَاوِين سِيذِيثْنغ عِيْسَى حمَا اَث صلّْبن</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 15:20" />وَامِي خَاس كمّْڒن اَبُوْصَار، كّْسن-اَس اَسڒْهَام نِّي اَزݣّْوَاغ ݣِّين-اَس اَرُّوْض نّس ؤُوِين-ث حمَا اَث صلّْبن.<verse eid="MRK 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />ئِجّن ن ورْيَاز يكَّا-د زِي ڒْكَامْپُو يعْذُو-د سّنِّي. أَرْيَاز نِّي زِي ثنْدِينْت ن لْقُرِينَا قَّارن-اَس سِمْعَان، نتَّا ذ بَابَاس ن إِسْكَنْدر اَك أَرُوْفُس. ݣِّين خَاس ڒْعَسْكَار صَّلِيب س بزّز حمَا اَث يَرْبُو.<verse eid="MRK 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 15:22" />ؤُوِين عِيْسَى غَار يِجّن ن ومْشَان قَّارن-اَس &lt;ݣُلْݣُوْطَا.&gt; (ڒْمَعْنَا ن يِيسم-أَ: أَمْشَان ن جُمْجُمَا.) <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />ؤُشِين-اَس اَمَان وضِيڒ يخلّط ذَايْسن يجّن ن دّْوَا ذ اَمرْزَاݣ قَّارن-اَس مُوْرّْ، وَلَكِن يُوْݣِي عِيْسَى اَثن يسو. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />صلّْبن-ث، فرْقن اَرُّوْض نّس جَارَاسن. ݣِّين لْقُرْعَا حمَا كُڒ يجّن مين غَا ييْسِي. <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />تُوغَات ذ تسْعَا ن صْبَاح وَامِي ث صلّْبن. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" /><char style="it">غَار وزدْجِيف نّس</char> ݣِّين-اَس يجّن ن ثڒْوِيحت ثُوْرَا ذَايس تُّهْمَا نِّي يقَّارن: "وَانِيتَا ذ اَزدْجِيذ ن أَيث-إِسْرَائِيل." <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />صلّْبن اَكِذس ثْنَاين ن يشفَّارن، ئِجّن خ وفُوْسِي يجّن خ وࢲڒْمَاض نّس. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />{س مَانَاينِّي يكمّڒ مِين يُوْرِين ذِي لْكِتَاب قَا حسْبن-ث زِي لْمُجْرِمِين.}<verse eid="MRK 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />ئِوْذَان إِي تكّن سّنِّي تُوْكَّارن-ث تْهزَّان اَزدْجِيف نْسن قَّارن-اَس: "مَا ذ شك إِي غَا يهذْمن ثَمْزِيذَا ثَمقّْرَانْت اَت تبْنِيذ ذِي ثڒْتِيَّام!؟ <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />نجَّا يخف نّش هْوَا-د زݣ وجنَّا زِي صَّلِيب-أَ!"<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />ؤُڒَا ذ اَرُّوْيَاس ن ڒْفُقَهَا ذ يمْسڒْمَاذن ن شَّرِيعَا تْبُوْصَرن خَاس عَاوذ قَّارن إِ وَايَاوْيَا: "ئِسنْجم ينّغْنِي وَلَكِن وَار يزمَّر شَا ڒخُّو اَذ يسنْجم يخْف نّس! <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />هْوَا-د آ لْمَسِيح آي اَزدْجِيذ ن أَيث-إِسْرَائِيل ڒخُّو زݣ وجنَّا زِي صَّلِيب-أَ حمَا أَ نࢲر مَانَايَا اَزَّايك نَامن!" أَمنِّي عَاوذ إِي ث زَوَرن لْمُجْرِمِين نِّي إِي كِذس صلّْبن.<verse eid="MRK 15:32" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يمُّوْث</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />غَار ثنْعَاش ؤُزِيڒ، ثهْوَا-د ثَادْجسْت خ ثْمُوْرْث اَمن-ثكْمَاڒ اَڒ وَامِي ذ ثْڒَاثَا وعشِّي. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />غَار ثْڒَاثَا وعشِّي يڒَاغَا عِيْسَى س جّْهذ ينَّا: "إِيْلِي، إِيْلِي، لْمَا سْبَاقْثَانِي؟" ڒْمَعْنَا ن وَاوَاڒ-أَ: "يَا أَربِّـي، يَا أَربِّـي، مَايمِّي ذَايِي ثْسمْحذ؟" <verse eid="MRK 15:34" /><verse number="35" style="v" sid="MRK 15:35" />سْڒِين-اَس ڒبْعَاض زݣ يِنِّي يحْضَارن ذِنِّي نَّان: "أَقَا يتْڒَاغَا خ نَّبِي إِلْيَاس." <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />ڒخْدّنِّي يرُوْح يجّن زَّايْسن يقْڒع يتَازّڒ، ييْسِي يجّن ن سْپُوْنْخَا يسغْذص-يت ذݣ وَامَان وضِيڒ ذ يسمَّامن، ئِݣِّي-ت خ يِج وكشُّوْض يُوْشَا-اَس اَذ يسو. ينَّا: "ڒخُّو جّم-ث، أَ نْࢲر مَا ٱذ د يَاس نَّبِي إِلْيَاس اَثِيذ يسِيهْوَا!"<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />يڒَاغَا عِيْسَى س يِجّن ن ثْمِيجَّا ثمْغَر يَارَّا نّفْس صَافِي يمُّوْث. <verse eid="MRK 15:37" /><verse number="38" style="v" sid="MRK 15:38" />ڒخْدّنِّي إِݣ يقَّارْص اَرّْوَاق ن ثمْزِيذَا ثَمقّْرَانْت خ ثْنَاين، زݣ وجنَّا اَڒ ثْمُوْرْث. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />ئِجّن ن وعَسْكَارِي ذ اَمقّْرَان ن اَرُّوْمَانُوْس يبدّ ذِنِّي زَّاثس يࢲْرَا ڒْموْث إِݣ يݣَّا عِيْسَى ينَّا: "أَثرَّاس-أَ ذ صَّح ذ مِّيس ن أَربِّـي."<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />ذِنِّي شَان ن ثمْغَارِين خزَّرنْت-يد زِي ڒݣّْوَاج، ذَايْسنْت مَرْيَم ثَمَݣْدَالِيث، ذ سَالُوْمِي، ذ مَرْيَم يمَّاس ن يَعْقُوْب اَمزْيَان ذ يُوْسِيس. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />نِثنْتِي تُوْغَا ذفَّارن-ث، تْسخَّارنْت خَاس وَامِي تُوْغَاث يدْجَا ذِي ثْمُوْرْث ن لْجَلِيل. عَاوذ حْضَارنْت اَكِس اَطَّاس ن ثمْغَارِين نّغْنِي زِي ثِنِّي كِس يݣَعّْذن غَار لْقُدْس.<verse eid="MRK 15:41" /></para>
  <para style="s">نطّْڒن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />نْهَار نِّي سوْجَاذن إِ نْهَار ن سّبْث ن لْعِبَادَا. وَامِي د ثُوْوض ثْمدِّيث، <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />يُوْسَا-د يجّن ن ورْيَاز قَّارن-اَس يُوْسف، زِي دْشَار ن أَرِيْمَاتْيَا. نتَّا ذ يجّن ن ورْيَاز مُهِم جَار جْمَاعث ن لْحُكَّام ن أَيث-إِسْرَائِيل، ئِتْرحَّاب عَاوذ زِي ڒْمُلْك ن أَربِّـي. ئِزْعم يُوْذف غَار لْحَاكم بِيلَاطُس يتَّار-اَس دَّات ن عِيْسَى. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />بِيلَاطُس يذْهش وَامِي يسْڒَا عِيْسَى ذغْيَا يمُّوْث. ئِڒَاغَا-د خ وعَسْكَارِي نِّي اَمقّْرَان ينَّا-ٱس مَا يمُّوْث مَا عَاذ؟ <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />وَامِي يسّن بِيلَاطُس زݣ وعَسْكَارِي نِّي عِيْسَى يمُّوْث، ئِسلّم دَّات نّس إِ يُوْسف. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />يُوْسف يسْغَا-د ڒشْفن، ئِسهْوَا-د دَّات نّس<note caller="+" style="f"><char style="fr" closed="false">15‏.46 </char><char style="ft" closed="false">يعْنِي، ئِسهْوَا-د دَّات ن سِيذِيثْنغ عِيْسَى زِي صَّلِيب.</char></note> يكفّن-يت س ڒشْفن. ئِسرْس-يت ذݣ يِجّن ن ونْضڒ يغْزِين ذݣ وزْرُو <char style="it">يݣَّا اَم يِيفْرِي</char>. ئِسقْنُوْنِّي يجّن ن وزْرُو ذ اَمقّْرَان يَارِّي-ث خ وقمُّوْم ن ونْضڒ نِّي. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />مَرْيَم ثَمَݣْدَالِيث ذ مَرْيَم يمَّاس ن يُوْسِيس خزَّرنْت مَانِي ينْضڒ.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">سِيذِيثْنغ عِيْسَى يكَّر-د زِي ڒْموْث</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />وَامِي يعْذُو نْهَار ن سّبْث ن لْعِبَادَا، مَرْيَم ثَمَݣْدَالِيث، ذ سَالُوْمِي، ذ مَرْيَم يمَّاس ن يَعْقُوب رُوْحنْت سْغِينْت لْعِطَر ؤُوِينْت-ث-يد اَذَاس ذهْننْت. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />نْهَار اَمزْوَارُو ن سِّيمَانَا زِيش اَك ڒفْجَر رُوْحنْت غَار ونْضڒ نّس. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />سَّاوَاڒنْت جَارَاسنْت <char style="it">اَك وبْرِيذ</char> قَّارنْت: "وِي ذَانغ غَا يكّْسن اَزْرُو خ وقمُّوْم ن ونْدڒ اَث يسقْنُوْنِّي؟" <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />وَامِي خْزَرنْت، ؤُفِينْت اَزْرُو نِّي يتْوَاكّس أُو نتَّا ذ اَمقّْرَان اَطَّاس. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />ؤُذْفنْت غَار <char style="it">يِيفْرِي</char> ن ونْضڒ نِّي ؤُفِينْت يج وحنْجِير يقِّيم خ جِّهث ثَفُوْسِيث، يݣَّا اَرُّوْض ذ اَشمْڒَار أُو قِّيمنْت ذهْشنْت اَطَّاس.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />ينَّا-ٱسنْت: "وَار ذهّْشنْت شَا! كنِّينْت ثْرزُّونْت خ عِيْسَى نَاصِرِي يتْوَاصلّْبن. نتَّا وَار ذَا يدْجِي شَا، ئِكَّر-د زِي ڒْموْث. هَاقَا اَمْشَان نّس مَاني تُوْغَا ث سرْسن. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />رُوْحنْت كنِّينْت <char style="it">ڒخُّو</char> غَار يمحْضَارن نّس ذ بُطْرُس إِنِينْت-اَسن اَقَا عِيْسَى يرُوْح اَذَاوم يزْوَار غَار ثْمُوْرْث ن لْجَلِيل اَكنِّيو يرَجَا ذِنِّي. أَث تَافم اَمشْنَاو مَامّش غَارْوم د يوصَّا زِي قْبڒ." <verse eid="MRK 16:7" /><verse number="8" style="v" sid="MRK 16:8" />ثِمْغَارِين نِّي ترْجِيجِينْت ذهّْشنْت، كَّرنْت رُوْحنْت ذغْيَا زݣ ونْضڒ نِّي اَروْڒنْت. وَار عَاوْذنْت مَانَاينِّي إِ حَدّ مِينْزِي نِثنْتِي ݣّْوْذنْت.<verse eid="MRK 16:8" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتْوَارْفع غَار وجنَّا</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />{عِيْسَى وَامِي د يكَّر زِي ڒْموْث زِيش نْهَار اَمزْوَارُو ن سِّيمَانَا يمظْهَار-د ذ اَمزْوَارُو إِ مَرْيَم ثَمَݣْدَالِيث ثنِّي إِي زِي تُوْغَا يسُوْفغ سبْعَا ن جْنُوْن. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />ثْرُوْح نتَّاث اَذ تْسِيْوض ڒخْبَار-أَ إِ يِنِّي تُوْغَا يدْجَان اَك عِيْسَى، ثُوْفِي-ثن حزْنن تْرُوْن. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />وَامِي ذَاسن ثْعَاوذ ثنَّا-ٱسن قَا ࢲْرِيغْ-ث يدَّر، وَار ت ؤُمِينن شَا.<verse eid="MRK 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />منْبَعْد إِ مَانَايَا يمظْهَار-اَسن-د عِيْسَى س يِجّن ن صِّفْث نّغْنِي إِ ثْنَاين إِذْسن وَامِي تُوْغَا ݣُّوْرن غَار ڒْكَامْپُو. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />ذوْڒن-د اَذ عَاوْذن ڒخْبَار-أَ إِ أَيثْمَاثْسن، وَار ثن ؤُمِيْنن شَا.<verse eid="MRK 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />منْبَعْد وَامِي قِّيْمن تتّن حِطَاش ن اَرُّسُل نّس، ئِمظْهَار-اَسن-د ينْهَا-ثن مِينْزي لإِيمَان نْسن ذ وقْلِيل ؤُڒَاون نْسن قسْحن. تُوْغَا نِثْنِي عَاوذ وَار ؤُمِيْنن شَا يِنِّي إِي ث يࢲْرِين وَامِي د يكَّر زِي ڒْموْث.<verse eid="MRK 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15" />ينَّا-ٱسن: "رُوْحم غَار مَارَّا دُّنشْت، بشَّرم مَارَّا ڒݣْنُوْس س لْإِنْجِيل. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />ونِّي يُوْمْنن اَذ يتْوَاطهَّار س وَامَان اَتَاف اَذ ينْجم. ونِّي وَار يُوْمِيْنن شَا اَتَاف اَذ يتْوَاحْكم. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />ذ ثِيْنَا ذ لْعَلَامَاث إِي د غَا يمظْهَارن اَك يِنِّي يتَامْنن: أَقَّا نِثْنِي اَذ سُوْفْغن جْنُوْن عْلَاحْسَاب يسم ينُو، أَذ سِّيوْڒن س يِيڒسَاون ذ جْذِيذ. <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />أَذ يْسِين يفِيْغرَان س يفَاسّن نْسن. مڒَا سْوِين مِين ينقّن، أَتَاف وَار ثن يضَرِّي شَا. أَذ سرْسن يفَاسّن نْسن خ يمهْڒَاش اَذ ݣنْفَان."<verse eid="MRK 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />ئِسِّيوڒ اَكِذْسن سِيذِيثْنغ عِيْسَى سّنِّي يتْوَارْفع غَار وجنَّا يقِّيم خ وفُوْسِي ن أَربِّـي. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />نِثْنِي فّْغن بشَّرن يوْذَان ذِي مْكُڒ اَمْشَان. سِيذِيثْنغ اَقَاث اَكِذْسن، ئِسْمظْهَار-د ڒْحَقّ ن يِنِّي يتْبشَّارن س وَاطَّاس ن لْعَلَامَاث إِي ثن يذفَّارن.}<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>