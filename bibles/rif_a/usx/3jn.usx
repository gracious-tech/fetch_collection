<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- TarifitABS</book>
  <para style="h">3 يوحنا</para>
  <para style="toc3">3يوح</para>
  <para style="toc2">3 يوحنا</para>
  <para style="toc1">ثَبْرَات وِيس ثْڒَاثَا ن اَرَّسُوْل يُوْحَنَّا</para>
  <para style="mt1">ثَبْرَات وِيس ثْڒَاثَا ن اَرَّسُوْل يُوْحَنَّا</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="s">لْمُقَدِّمَا</para>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />نش ذ اَمْغَار، <char style="it">تَارِيغ ثَبْرَات-أَ</char> إِ غَايُوْس ونِّي إِي خَافِي يعِيزّن ذِي لْحَقِيقَا. <verse eid="3JN 1:1" /><verse number="2" style="v" sid="3JN 1:2" />آي ؤُمَا ينُو يعِيزّن، تْࢲَادْجِيغ اَخَاك يسّقْسَا ڒْخِير اَغَارك ثِيڒِي صَّاحث نّش وَامِي ثدْجِيذ مْلِيح ذِي ڒَعْمَر نّش. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />مِينْزِي نش فَرْحغ اَطَّاس وَامِي د ؤُسِين ڒبْعَاض ن وَاوْمَاثن شهْذن خَاك خ لْحَقِيقَا إِي ذَايش ذ مَامّش شك عَاذ ثݣُّوْرذ نِيْشَان ذِي لْحَقِيقَا. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />فَرّْحغ اَطَّاس س وَاطَّاس وَار زمَّرغ اَذ اَرْنِيغ خْمِي تسْڒِيغ ثَارْوَا ينُو ݣُّوْرن نِيْشَان خ وبْرِيذ ن لْحَقِيقَا.<verse eid="3JN 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />آي ؤُمَا ينُو يعِيزّن، شك ذَايش تِّقث وَامِي تݣّذ لْمجْهُوْد نّش عْلَاحْسَاب اَوْمَاثن-أَ وَاخَّا نِثْنِي تَاسن-د غَارك ذ يبَرَّانِيْين.<note caller="+" style="f"><char style="fr" closed="false">1‏.5 </char><char style="ft" closed="false">أَوْمَاثن-أَ اَذ يڒِين شَان ن وَاوْمَاثن إِي د يتْوَاسّكّن زِي جْمَاعث ن ؤُمْغَار-أَ بَاش اَذ رَاحن غَار ثْجُمَاع ن ڒْمُوْمِنِين اَذَايْسنْت حدّْثن اَذَايْسنْت شجّْعن ڒْمُوْمِنِين.</char></note> <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />شهْذن خَاك ذَانِيتَا زَّاث إِ جْمَاعث خ ڒمْحِبّث نّش. أَذ تݣّذ مْلِيح <char style="it">عَاوذ</char> مڒَا ثْذبَّارذ خَاسن خ وبْرِيذ نْسن عْلَاحْسَاب مِين يتحْذَاجَا أَربِّـي. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />يِيْنَا تْوَاسّكّن-د عْلَاحْسَاب يسم نِّي <char style="it">يُوْعْڒَان</char>، وَار جمّْعن بُو لْمُعَاوَنَا زݣ يِنِّي وَار يذفَّارن شَا أَربِّـي. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />س مَانَايَا يتْخصَّا أُو لَابُد أَ نْعَاون اَوْمَاثن-أَ اَم يِيْنَا بَاش أَ نخْذم اَك وَايَاوْيَا عْلَاحْسَاب لْحَقِيقَا.<verse eid="3JN 1:8" /></para>
  <para style="s">أَشثْشِي خ دِيُوْتْرِيف</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />ؤُرِيغ يجّن ن وَاوَاڒ إِ جْمَاعث وَلَكِن يُوْݣِي دِيُوْتْرِيف إِ سُّلْطَا نّغ ڒَاحقَّاش نتَّا يتعْجِيب-اَس اَذ يِيڒِي ذ اَمزْوَارُو. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />س مَانَايَا مڒَا ؤُسِيغ-د نش، أَذ فضْحغ مِين يتݣّ نتَّا يسَّاوَاڒ س وَاوَاڒ ن ثُوْبُّوْهْڒِيَا وَار يحْڒِين ضذ نّغ. وَار يقْنِيع شَا س مَانَاينِّي، نتَّا يتَاݣِي اَذ يتْرحَّاب س وَاوْمَاثن يسْبدَّا ؤُڒَا ذ يِنِّي يتْرحَّابن زَّايْسن يتَازّڒ خَاسن زِي جْمَاعث.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />آي ؤُمَا ينُو يعِيزّن، وَار تْقلَّاد شَا مِين يدْجَان ذ اَعفَّان؛ لَّا، قلّد مِين يدْجَان ذ اَصبْحَان. ونِّي يتݣّن مِين يدْجَان ذ اَصبْحَان نتَّا زِي أَربِّـي؛ ونِّي يتݣّن مِين يدْجَان ذ اَعفَّان نتَّا وَار يتْوِيڒِي شَا أَربِّـي. <verse eid="3JN 1:11" /><verse number="12" style="v" sid="3JN 1:12" />أَمَّا دِيمِيتْرِيُوْس شهّْذن خَاس مْلِيح قَاع يوْذَان وَاخَّا ؤُڒَا ذ لْحَقِيقَا ثْشهّذ خَاس س يِيخف نّس. أَخَاس نَرْنِي وَاخَّا ذ شْهَاذث نّغ أُو كنِّيو ثسّْنم بلِّي شْهَاذث نّغ نشِّين ذ صَّح.<verse eid="3JN 1:12" /></para>
  <para style="s">لْخِتَام ن ثبْرَات-أَ</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />ئِتْغِيمَا-ٱيِي عَاذ اَطَّاس من ذَاش د غَا اَرِيغ وَلَكِن حْسن وَار ذَاش ثِيذ تَارِيغ شَا س سْتِيلُو ذ سّْمخ. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />لَّا، تْمنِّيغ اَش ࢲْرغ ذغْيَا ڒخْدّنِّي أَ نسِّيوڒ اَغمْبُوْب ذݣ وغمْبُوْب. <verse eid="3JN 1:14" /><verse number="15" style="v" sid="3JN 1:15" />أَغَارك يِيڒِي ڒهْنَا. تْسَاوَّاضن-اَش-د سْڒَام صّْحَابَا. سدْجم خَاسن خ صّْحَابَا كُڒ يجّن س يِيسم نّس.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>