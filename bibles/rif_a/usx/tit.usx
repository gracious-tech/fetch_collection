<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="TIT" style="id">- TarifitABS</book>
  <para style="h">تيتوس</para>
  <para style="toc3">تيت</para>
  <para style="toc2">ثبرات غار تيتوس</para>
  <para style="toc1">ثَبْرَات ن اَرَّسُوْل بُوْلُس غَار تِيْتُوْس</para>
  <para style="mt1">ثَبْرَات ن اَرَّسُوْل بُوْلُس غَار تِيْتُوْس</para>
  <chapter number="1" style="c" sid="TIT 1" />
  <para style="s">لْمُقَدِّمَا</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1" />نش ذ بُوْلُس ذ اَخدَّام ن أَربِّـي ذ اَرَّسُوْل ن عِيْسَى لْمَسِيح <char style="it">خدّْمغ</char> عْلَاحْسَاب يِنِّي إِݣ يخْضَر أَربِّـي بَاش اَذ اَمْنن اَذ سّْنن لْحَقِيقَا إِي ثن يسݣُّوْرن غَار مِين يدْجَان نِيشَان ذِي لْإِيمَان. <verse eid="TIT 1:1" /><verse number="2" style="v" sid="TIT 1:2" />لْإِيمَان-أَ ذ ثُوْسْنَا-يَا<note caller="+" style="f"><char style="fr" closed="false">1‏.2 </char><char style="ft" closed="false">ثُوْسْنَا نتَّاث ذ لْمَعْرِيفَا.</char></note> ثْبدَّا خ لْأَمَال ن ثُوْذَارْث نِّي وَار يفنِّين عمَّارْص، ثنِّي إِي زِي يوْعذ أَربِّـي يعْنِي ونِّي وَار يسْخرِّيقن شَا. ئِوْعذ س ثُوْذَارْث نِّي قْبڒ مَا ٱذ بْذَان زْمَانَاث قَاع. <verse eid="TIT 1:2" /><verse number="3" style="v" sid="TIT 1:3" />أُو ذِي لْوقْت نِّي إِݣ يخْضَر نتَّا يسْمظْهَار-د لْوَاعد-أَ س تّبْشِير نِّي إِي زِي ذَايِي يتْوَاكلّف س لْأَمَر ن أَربِّـي ونِّي إِي ذَانغ يسْنجْمن.<verse eid="TIT 1:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4" />
    <char style="it">تَارِيغ ثَبْرَات-أَ</char> إِ تِيتُوْس ونِّي إِي يدْجَان اَم ممِّي ذ صَّح ذِي لْإِيمَان-أَ إِي ذِي نْشَرّش. أَكِذش يِيڒِي اَرْضَا ذ ڒهْنَا زِي أَربِّـي بَابَاثْنغ ذ عِيْسَى لْمَسِيح ونِّي إِي ذَانغ يسْنجْمن.<verse eid="TIT 1:4" /></para>
  <para style="s">ڒُوْصِيَاث خ يمقّْرَانن ن جْمَاعث ن ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5" />خ مَانَاينِّي جِّيغ-شك ذِي <char style="it">ثيْزِيرْث ن</char> كْرِيت، أَذ تْعذْڒذ مِين تُوْغَا رزُّوْغ نش اَذ عذْڒغ وَار ؤُوِيضغ شَا أُو عَاوذ بَاش اَذ تِخْضَرذ يمقّْرَانن <char style="it">ن جْمَاعث ن ڒْمُوْمِنِين</char> ذِي مْكُڒ اَبِيلَاج اَم مَامّش إِي ش وصِّيغ. <verse eid="TIT 1:5" /><verse number="6" style="v" sid="TIT 1:6" />أَمقّْرَان-أَ مَاشِي اَذ يِيڒِي ذ يجّن ن بْنَاذم تْعيَّابن-ث يِوْذَان. أَغَارس ثِيڒِي يجّن ن ثمْغَارْث وَاهَا اَذ يڒِين يحنْجِيرن نّس ذ ڒْمُوْمِنِين. مَاشِي اَخَاسن ينِين يِوْذَان تݣّن لْمَدلَّا ن سّكْرَا نِغ وَار تْسذْحِين شَا. <verse eid="TIT 1:6" /><verse number="7" style="v" sid="TIT 1:7" />أَقَا اَرَّايس ن جْمَاعث يتْكلَّاف نتَّا س لْمسْؤُلِيَا زِي أَربِّـي أُو لَابُد اَذ يِيڒِي بْڒَا ڒْعِيب، وَار ذَايس يتِيڒِي بُو تَّكبُّر، وَار يتْعصِّيب شَا ذغْيَا، وَار يسكَّر شَا س شّْرب، وَار يشِّيث شَا، وَار يضمّع شَا ذِي تْمنْيَاث. <verse eid="TIT 1:7" /><verse number="8" style="v" sid="TIT 1:8" />وَاه، ئِتخصَّا اَذ يتْرحَّاب زݣ ينوْجِيون، أَذَاس يتعْجِيب مِين يدْجَان ذ اَصبْحَان، أَذ يحْكم خ ثْنفْسِيث نّس، أَذَايس يِيڒِي لْمَعْقُوْل، أَذ يِيڒِي يصْفَا، أَذ يربَّا يخف نّس. <verse eid="TIT 1:8" /><verse number="9" style="v" sid="TIT 1:9" />ئِتْخصَّا أُو لَابُد اَذ يطّف مْلِيح ذݣ وَاوَاڒ نِّي إِي ذِي ثدْجَا تِّقث إِي ذَاس يتْوَاسْڒمْذن حمَا اَذ يشجّع يوْذَان س يِجّن ن تَّعْلِيم نِيشَان اَذ ينْهَا يِنِّي يتْعَارَّاضن إِ تَّعْلِيم-أَ.<verse eid="TIT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10" />لِأَنَّا يِنِّي إِي ذِي ثدْجَا ثْغنَّانْت اَقَاثن مُجُوْدِين، سَّاوَاڒن وَاهَا نِثْنِي ذ يغدَّارن خَاصَّتَان ذ يِنِّي يتِيشّن لْهِمَّا اَطَّاس إِ طَّهَارث.<note caller="+" style="f"><char style="fr" closed="false">1‏.10 </char><char style="ft" closed="false">طَّهَارث نتَّاث ذ اَحجّم نِغ ذ اَخْثَان نِغ ذ لْخِتَام.</char></note> <verse eid="TIT 1:10" /><verse number="11" style="v" sid="TIT 1:11" />يِيْنَا اَقمُّوْم نْسن يتْخصَّا-يَاسن اَذَاسن يتْوَاقّن. نِثْنِي مشْحَاڒ ن لْعَائِلَاث كمْڒنْت إِي سْپَـرْذْڒن وَامِي ذَاسن سڒْمَاذن ثِمسْڒَايِين يتْخصَّا-يَاسن وَار ذَاسن ثنْت سڒْمِيذن شَا، نِثْنِي ضمّْعن ذِي تْمنْيَاث وَاهَا. <verse eid="TIT 1:11" /><verse number="12" style="v" sid="TIT 1:12" />ئِجّن زَّايْسن حسّْبن-ث ذ نَّبِي نتَّا س يِيخف نّس ينَّا: "نِثْنِي أَيث-كْرِيت ڒبْدَا ذ أَيث-بُوْيخَرِّيقن ذ ڒُوْحُوْش يوْعَارن ذ يمَعْݣَازن ذَايْسن اَعدِّيس وَاهَا." <verse eid="TIT 1:12" /><verse number="13" style="v" sid="TIT 1:13" />أَقَا شْهَاذث نِّي إِي ينَّا نِيشَان إِي ثدْجَا. إِذن، نْهَا-ثن س ڒقْسَاحث حمَا اَذ يڒِين نِيشَان ذِي لْإِيمَان. <verse eid="TIT 1:13" /><verse number="14" style="v" sid="TIT 1:14" />مَاشِي اَذ ݣّن اَرَّاي إِ ثْحُوْجَا نِّي ن أَيث-إِسْرَائِيل نِغ اَذ ݣّن اَرَّاي إِ ڒُوْصِيَاث نِّي ن يِنِّي يسْبعَّاذن يخف نْسن زِي لْحَقِيقَا. <verse eid="TIT 1:14" /><verse number="15" style="v" sid="TIT 1:15" />أَقَا يِنِّي إِݣ يدْجَان صْفَان اَتَاف قَاع ثِمسْڒَايِين اَذَايْسن يڒِينْت صْفَانْت. وَلَكِن يِنِّي يخنْزن وَار ؤُمِينن شَا اَتَاف وَار ذَايْسن تِيڒِي ؤُڒَا ذ يجّن ن ثْمسْڒَايْث ثصْفَا. أَتَاف ڒْعَقُوْرَاث نْسن ذ ضَّمِيرَاث نْسن س ثْنَاين تخْنِيزن. <verse eid="TIT 1:15" /><verse number="16" style="v" sid="TIT 1:16" />قَّارن قَا نسّن أَربِّـي وَلَكِن نكَّرن-ث س ڒفْعَايڒ نْسن. نِثْنِي تْوَاعِيفّن، وَار تْطِيعِين شَا، وَار نفّْعن شَا ؤُڒَا ذݣ يِجّن ن ڒْخذْمث ذ ثَصبْحَانْت.<verse eid="TIT 1:16" /></para>
  <chapter eid="TIT 1" />
  <chapter number="2" style="c" sid="TIT 2" />
  <para style="s">ڒُوْصِيَاث عْلَاحْسَاب ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1" />أَمَّا شك، سڒْمَاذ مِين يمُوْنن اَك تَّعْلِيم نِيشَان. <verse eid="TIT 2:1" /><verse number="2" style="v" sid="TIT 2:2" />يِنِّي يمْغَارن اَذَايْسن يِيڒِي لْمَعْقُوْل، أَذ يڒِين مْوقّْرِين، أَذ حكْمن خ ثْنفْسِيث نْسن، أَذ يڒِين نِيشَان ذِي لْإِيمَان ذ ڒمْحِبّث ذ صّْبَر.<verse eid="TIT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="TIT 2:3" />ثِنِّي يمْغَارن عَاوذ اَذ عِيشّنْت عْلَاحْسَاب لْإِيمَان، وَار ذَايْسنْت تِيڒِي بُو نَّمِيمَا، وَار تبْلِيْيِينْت شَا اَطَّاس س بِينُو. أَذ سْڒمْذنْت مِين يدْجَان ذ اَصبْحَان. <verse eid="TIT 2:3" /><verse number="4" style="v" sid="TIT 2:4" />أَمنِّي اَذ ربَّانْت ثِمْغَارِين ثِمزْيَانِين حمَا اَذ تخْسنْت يرْيَازن نْسنْت ذ ثَارْوَا نْسنْت، <verse eid="TIT 2:4" /><verse number="5" style="v" sid="TIT 2:5" />اَذ حكْمنْت خ ثْنفْسِيث نْسنْت اَذ يڒِينْت صْفَانْت، أَذ ݣّنْت شّْغڒ ذِي ثدَّارْث نْسنْت، أَغَارْسنْت يِيڒِي وُوْڒ ذ اَشمْڒَاڒ، أَذ طَاعنْت إِ يرْيَازن نْسنْت حمَا اَوَاڒ ن أَربِّـي وَار يتْوَاعيِّيب شَا.<verse eid="TIT 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6" />أَمُّو عَاوذ إِن-اَسن إِ يحنْجِيرن اَغَارْسن يِيڒِي ڒَعْقڒ نْسن. <verse eid="TIT 2:6" /><verse number="7" style="v" sid="TIT 2:7" />ذِي مَارَّا ثِمسْڒَايِين اَغَارْسن ثِيڒِيذ شك ذ لْمِثَال س لْحَسَانَاث إِي تݣّذ. تَّعْلِيم نّش سخْذم-يث س صَّرَاحَا ذ لْمَعْقُوْل <verse eid="TIT 2:7" /><verse number="8" style="v" sid="TIT 2:8" />ذ يِجّن ن وَاوَاڒ ذ صَّح وَار ذَايس بُو ڒْعِيب. أَمُّو اَش سذْحَان يِنِّي ذَاش يتْعَارَّاضن مِنْزِي وَار غَارْسن مِين خَانغ غَا ينِين.<verse eid="TIT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9" />ئِسمْغَان اَذ طَاعن إِ أَيثْبَاب نْسن ذِي كُلْشِي، أَخَاسن اَرْضَان، وَار ذَاسن تݣّن شَا ثَغنَّانْت، <verse eid="TIT 2:9" /><verse number="10" style="v" sid="TIT 2:10" />وَار تَاشَارن شَا <char style="it">أَيثْبَاب نْسن</char> بَاش اَذ سّْنن بلِّي نِثْنِي ذَايْسن مَارَّا تِّقث بَاش س مَارَّا يبْرِيذن اَذ زوّْقن لْإِيمَان ن أَربِّـي إِي ذَانغ يسْنجْمن.<verse eid="TIT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11" />شُوْف، أَرْضَا ن أَربِّـي يتْمظْهَار-اَسن-د إِ مَارَّا يوْذَان يتَاوِي-ثن غَار مَانِي غَا تْوَاسْنجْمن. <verse eid="TIT 2:11" /><verse number="12" style="v" sid="TIT 2:12" />أَرْضَا-يَا يتْربَّا-يَانغ أَ ننْكَر شَّرّْ ذ شّهَاوَاث ن دُّنشْت-أَ، أَ نْعِيش ذِي زْمَان-أَ أَ نحْكَام خ ثْنفْسِيث نّغ اَذَايْنغ يِيڒِي لْمَعْقُوْل ذ لْإِيمَان <verse eid="TIT 2:12" /><verse number="13" style="v" sid="TIT 2:13" />أُو نشِّين غِير نتْرَاجَا لْأَمَال نِّي يتْوَابَرْكن يعْنِي نْهَار نِّي إِي ذَايس د غَا ثْمظْهَار لْعَظَامَا ن أَربِّـي اَمقّْرَان ذ وْمْسنْجم نّغ عِيْسَى لْمَسِيح. <verse eid="TIT 2:13" /><verse number="14" style="v" sid="TIT 2:14" />نتَّا يصدّق خَانغ يخف نّس ذ يجّن ن لْفِدْيَا خ مَارَّا شَّرّْ نّغ أُو عَاوذ بَاش اَذ يسِّيصْفَا يجّن ن شَّعْب إِ يِيخف نّس اَتَاف اَذ يڒِين نّس مُجُوْدِين اَذ ݣّن لْحَسَانَاث.<verse eid="TIT 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15" />سِيوڒ خ ثْمسْڒَايِين-أَ، زيَّار خ ڒْمُوْمِنِين نهَّا-ثن س مَارَّا سُّلْطَا. وَار تجَّا حَدّ اَش يسحْقَر.<verse eid="TIT 2:15" /></para>
  <chapter eid="TIT 2" />
  <chapter number="3" style="c" sid="TIT 3" />
  <para style="s">أَبْرِيذ ن يِنِّي يذفَّارن لْمَسِيح</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1" />سْفكَّر إِ ڒْمُوْمِنِين اَذ ݣّن اَرَّاي إِ ڒْحُكَّام ذ ڒْمخْزن، أَذَاسن طَاعن اَذ يڒِين وجْذن إِ كُڒ ڒْخذْمث ذ ثَصبْحَانْت. <verse eid="TIT 3:1" /><verse number="2" style="v" sid="TIT 3:2" /><char style="it">سْفكَّر-اَثن</char> حمَا وَار تْعيِّبن حَدّ، وَار تْمنْغِين شَا س وَاوَاڒن، أَذ يڒِين تْرَانْكِيڒ، أَذ سْخذْمن يجّن ن تَّوَاضُع اَك مَارَّا يوْذَان.<verse eid="TIT 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="TIT 3:3" />شُوْف، نشِّين عَاوذ تُوْغَا ذَايْنغ يجّن ن ڒقْفَاڒث، وَار نتْطِيعِي شَا، نتْوَاشمّث، حكّْمنْت خَانغ اَطَّاس ن لْأَنْوَاع ن شّهَاوَاث ذ زّْهُو. تُوْغَا نتْعِيش ذݣ يِجّن ن ڒقْبَاحث ذ ڒحْسذ، عِيفّن-اَنغ يِوْذَان، نتْعِيفَّا اَيَاوْيَا. <verse eid="TIT 3:3" /><verse number="4" style="v" sid="TIT 3:4" />وَلَكِن وَامِي د يمظْهَار ڒْخِير ذ لْحَنَانَا ن أَربِّـي ونِّي إِي ذَانغ يسْنجْمن <verse eid="TIT 3:4" /><verse number="5" style="v" sid="TIT 3:5" />ڒخْدّنِّي يسنْجم-اَنغ مَاشِي عْلَاحْسَاب لْحَسَانَاث نِّي إِي نݣَّا؛ لَّا، تُوْغَا عْلَاحْسَاب اَرَّاحْمث نّس نتَّا. ئِسِّيْرذ-اَنغ س وَامَان ن ؤُخْڒَاق ذ جْذِيذ، يَارَّا-ٱنغ ذ جْذِيذ س وفُوْس ن أَرُّوْح يقدّْسن. <verse eid="TIT 3:5" /><verse number="6" style="v" sid="TIT 3:6" />أَرُّوْح-أَ يفَرغ-يث-يذ خَانغ أَربِّـي س يِجّن ن ڒْخِير يمْغَر س وفُوْس ن عِيْسَى لْمَسِيح ونِّي إِي ذَانغ يسْنجْمن. <verse eid="TIT 3:6" /><verse number="7" style="v" sid="TIT 3:7" />حمَا أَ نْوَارث زَّايس، أَغَارْنغ يِيڒِي يجّن ن لْأَمَال ن ثُوْذَارْث ثنِّي وَار يفنِّين شَا لِأَنَّا نْمصْڒَاح اَك أَربِّـي س اَرْضَا نّس. <verse eid="TIT 3:7" /><verse number="8" style="v" sid="TIT 3:8" />أَوَاڒ-أَ إِي قَّارغ ذَايس تِّقث.</para>
  <para style="p" vid="TIT 3:8">نش خْسغ شك اَذ تْوكّْذذ خ ثْمسْڒَايِين-أَ إِ يِنِّي إِي يُوْمْنن زِي أَربِّـي بَاش اَذ د اَرّن ڒْبَاڒ نْسن اَذ طوّْعن يخف نْسن س لْحَسَانَاث. ثِمسْڒَايِين-أَ ذ ثِصبْحَانِين س وَاطَّاس نفّْعنْت يوْذَان. <verse eid="TIT 3:8" /><verse number="9" style="v" sid="TIT 3:9" />وَلَكِن سِيْݣّْوج يخف نّش زݣ يمْنَاقَارن إِي ذِي ثدْجَا غِير ثُوْبُوْهْڒِيَا أُو عَاوذ زِي لْبَحْت نِّي ن ثْشجُّوْرَا ن ڒجْذُوْذ<note caller="+" style="f"><char style="fr" closed="false">3‏.9 </char><char style="ft" closed="false">أَيث-إِسْرَائِيل تُوْغَا تݣّن اَطَّاس ن لْبَحْث ذِي ڒجْذُوْذ نْسن بَاش اَذ سّْنن مَا غَارْسن شُّرْفَا ذِي ثْشجَّارْث ن ڒجْذُوْذ نْسن. أَرَّسُوْل بُوْلُس يقَّار-اَسن لْبَحْث نِّي وَار ينفّع س وَالُو.</char></note> ذ يمنْغِيْون ذ يمْخَرْوَاضن خ شَّرِيعَا لِأَنَّا نِثْنِي ذ ڒْبَاطڒ وَاهَا وَار نفّْعن شَا قَاع. <verse eid="TIT 3:9" /><verse number="10" style="v" sid="TIT 3:10" />ونِّي يسْمنْغَان يوْذَان اَݣ وَايَاوْيَا شك عْڒم-اَس ثْوَاڒَا ثَمزْوَارُوْت ذ وِيْس ثْنَاين ڒخْدّنِّي اَوْݣّْوج زَّايس قَاع. <verse eid="TIT 3:10" /><verse number="11" style="v" sid="TIT 3:11" />ثسّْنذ إِلَّا بْنَاذم-أَ يعصَّا ذ اَمْعوَّاج، لْعِقَاب نّس خ يِيڒِي نّس.<verse eid="TIT 3:11" /></para>
  <para style="s">لْخِتَام ن ثبْرَات-أَ</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12" />خْمِي ذَاوم د غَا سّكّغ <char style="it">ؤُمَاثْنغ</char> أَرْتِيْمَاس نِغ ذ تُوْشِيق، اݣّ لْمجْهُوْد نّش اَغَارِي د ثَاسذ غَار ثنْدِينْت ن نِيكُوْپْـرِيس مِنْزِي نش تُوْغَا فكَّرغ اَذ سعْذُوْغ ذِنِّي ڒْمشْتَا. <verse eid="TIT 3:12" /><verse number="13" style="v" sid="TIT 3:13" />عْلَاحْسَاب <char style="it">أَيثْمَاثْنغ</char> أَپُـوْلُّوْس ذ زِيْنَّاس ونِّي إِي يدْجَان ذ اَوْكِيڒ، اݣّ لْمجْهُوْد نّش بَاش اَثن ثْعَاوْنذ ذݣ وبْرِيذ نْسن؛ خْزَر مَا غَارْسن مَارَّا مِين تحْذَاجَان. <verse eid="TIT 3:13" /><verse number="14" style="v" sid="TIT 3:14" />ئِوْذَان نّغ يتْخصَّا وَار تْعِيشن شَا بْڒَا نّْفَع، ئِتْخصَّا اَذ طوّْعن يخف نْسن س لْحَسَانَاث حمَا اَذ دبَّرن إِ يِيْنَا يتحْذَاجَان.<verse eid="TIT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15" />سَاوَّاضن-اَش-د سْڒَام مَارَّا يِنِّي يدْجَان اَكِذِي. سِيوض-اَسن سْڒَام إِ يِنِّي إِي ذَانغ يتخْسن ذِي لْإِيمَان.</para>
  <para style="p" vid="TIT 3:15">أَكِذْوم يِيڒِي اَرْضَا إِ مَارَّا كنِّيو.<verse eid="TIT 3:15" /></para>
  <chapter eid="TIT 3" />
</usx>