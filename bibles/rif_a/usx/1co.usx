<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- TarifitABS</book>
  <para style="h">1 أَيث-كورينث</para>
  <para style="toc3">1كور</para>
  <para style="toc2">1 أيث-كورينث</para>
  <para style="toc1">ثَبْرَات ثَمزْوَارُوْت ن اَرَّسُوْل بُوْلُس غَار أَيث-كُوْرِينْث</para>
  <para style="mt1">ثَبْرَات ثَمزْوَارُوْت ن اَرَّسُوْل بُوْلُس غَار أَيث-كُوْرِينْث</para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="s">أَرَّسُوْل بُوْلُس يتْسدْجَام خ جْمَاعث ن ڒْمُوْمِنِين ذِي ثنْدِينْت ن كُوْرِينْث</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />
    <char style="it">ثَبْرَات-أَ زَّايِي</char> نش بُوْلُس اَكِذِي ؤُمَاثْنغ سَاسْتِين. ئِڒَاغَا-ٱيِي-د أَربِّـي س ڒْخَاضَر نّس حمَا اَذ يڒِيغ ذ اَرَّسُوْل ن عِيْسَى لْمَسِيح. <verse eid="1CO 1:1" /><verse number="2" style="v" sid="1CO 1:2" />نتْسدْجَام خَاوم كنِّيو إِي يدْجَان ذ جْمَاعث ن ڒْمُوْمِنِين ن أَربِّـي ذِي ثنْدِينْت ن كُوْرِينْث. تْوَاسِّيصْفَام ذِي عِيْسَى لْمَسِيح، تْوَاخْضَرم بَاش اَذ تِيڒِيم ذ صَّالِحِين اَك مَارَّا يِنِّي يتْڒَاغَان خ يِيسم ن سِيذِيثْنغ عِيْسَى لْمَسِيح ذِي مَارَّا يمُوْشَان. نتَّا ذ سِيذِيثْنغ ذ سِيذِيثْسن. <verse eid="1CO 1:2" /><verse number="3" style="v" sid="1CO 1:3" />أَكِذْوم يِيڒِي اَرْضَا ذ ڒهْنَا زِي أَربِّـي بَابَاثْنغ ذ عِيْسَى لْمَسِيح سِيذِيثْنغ.<verse eid="1CO 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />تْشكَّارغ أَربِّـي خَاوم ڒبْدَا خ اَرْضَا إِي ذَاوم يُوْشَا ذِي عِيْسَى لْمَسِيح. <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />زِي نتَّا، يتْوَارْنِي-يَاوم ڒْخِير ذِي كُڒْشِي، يعْنِي ذِي مَارَّا اَوَاڒن ذ ثُوْسْنَا.<note caller="+" style="f"><char style="fr" closed="false">1‏.5 </char><char style="ft" closed="false">ثُوْسْنَا نتَّاث ذ لْمَعْرِيفَا.</char></note> <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />ذَايْوم كنِّيو إِي د يسْمظْهَار أَربِّـي لْحَقِيقَا خ شْهَاذث نّغ خ لْمَسِيح. <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />س مَانَايَا وَار ذَاوم ثْنقِّيص ؤُڒَا ذ يجّن ن لْقُدْرَا رُوْحِيَا خْمِي تْرَاجَام اَذ د يمظْهَار سِيذِيثْنغ عِيْسَى لْمَسِيح. <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />ذ نتَّا إِي كنِّيو غَا يسْبدّن غَار ونݣَّارُو اَتَاف وَار ذَايْوم يتِيڒِي بُو ڒْعِيب ذِي نْهَار نِّي ن سِيذِيثْنغ عِيْسَى لْمَسِيح. <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />أَربِّـي ذَايس تِّقث، زَّايس إِي ذَانغ د يُوْسَا ؤُڒَاغِي أَ نْعَاشَر ممِّيس يعْنِي سِيذِيثْنغ عِيْسَى لْمسِيح.<verse eid="1CO 1:9" /></para>
  <para style="s">ڒْمُوْمِنِين ذِي كُوْرِينْث غَارْسن لْخِلَاف جَارَاسن</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />فَا تتَّارغ زَّايْوم آي اَيثْمَا س يِيسم ن سِيذِيثْنغ عِيْسَى لْمَسِيح، مْسفْهَامث اَك وَايَاوْيَا حمَا وَار يتِيڒِي بُو لْخِلَاف جَارَاوم. ئِتْخصَّا كنِّيو اَذ تِيڒِيم كِيف-كِيف ذِي ڒَعْقُوْڒَاث نْوم ذ اَرَّاي نْوم. <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />آي اَيثْمَا، أَرِّيغ-د ڒخْبَار زِي ثدَّارْث ن كْلُوِي تْمنْغَام جَارَاوم. <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" />يعْنِي، ئِجّن يقَّار نش ذفَّارغ بُوْلُس. ئِجّن يقَّار نش ذفَّارغ أَپُّــوْلُّوْس. ئِجّن يقَّار نش ذفَّارغ بُطْرُس. ئِجّن يقَّار نش ذفَّارغ لْمَسِيح.<verse eid="1CO 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 1:13" />لْمَسِيح مَا ذَايس لْفِرْقَاث؟ لَّا! مَا ذ بُوْلُس يتْوَاصلّْبن خ صَّلِيب عْلَاحْسَاب كنِّيو؟ لَّا! مَا ثتْوَاطهَّارم كنِّيو س وَامَان س يِيسم ينُو بُوْلُس؟ لَّا! <verse eid="1CO 1:13" /><verse number="14‏-15" style="v" sid="1CO 1:14-15" />تْشكَّارغ أَربِّـي وَار طهِّيرغ ؤُڒَا ذ يجّن زَّايْوم س وَامَان إِلَّا كْرِيْسْبُوْس ذ غَايُوْس حمَا وَار يقَّار حَدّ قَا يتْوَاطهَّار س وَامَان عْلَاحْسَاب يسم ينُو. <verse eid="1CO 1:14-15" /><verse number="16" style="v" sid="1CO 1:16" />(وَاه، نش طهَّارغ س وَامَان إِ ڒحْبَاب ن سْتِيفَانُوْس. وَار عْقِيڒغ شَا مَا طهَّارغ إِ حَدّ نّغْنِي س وَامَان كْتَار زݣ يِيْنَا.) <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />لِأَنَّا لْمَسِيح وَار ذَايِي د يسّكّ شَا حمَا اَذ طهَّارغ إِ يِوْذَان س وَامَان؛ لَّا، نش يسّكّ-اَيِي-د اَذ بشَّرغ س لْإِنْجِيل وَلَكِن مَاشِي س ڒفْهَامث نِّي ن وَاوَاڒن يزوّْقن. مَايمِّي؟ بَاش جّْهذ إِي يدْجَان ذِي صَّلِيب ن لْمَسِيح وَار يتْبطِّيڒ شَا.<verse eid="1CO 1:17" /></para>
  <para style="s">لْمَسِيح نتَّا ذ ڒفْهَامث ذ جّْهذ ن أَربِّـي</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />شُوْف، أَوَاڒ ن صَّلِيب نتَّا ذ ثُوْبُّوْهْڒِيَا وَاهَا غَار يِنِّي وَار ينجّْمن شَا، وَلَكِن غَار نشِّين ينجّْمن اَوَاڒ-أَ نتَّا ذ جّْهذ ن أَربِّـي. <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" />لِأَنَّا يقَّار لْكِتَاب:</para>
  <para style="q1" vid="1CO 1:19">&lt;ڒفْهَامث ن يِنِّي يتفْهَامن اَت هذْمغ.</para>
  <para style="q1" vid="1CO 1:19">ڒفْطَانث ن يِنِّي يفطّْنن اَت سْفشْڒغ.&gt;<verse eid="1CO 1:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="1CO 1:20" />ونِّي يتفْهَامن زَعْمَا، ڒخُّو مَانِي يدْجَا؟ أَمْسڒْمَاذ ن شَّرِيعَا زَعْمَا، ڒخُّو مَانِي يدْجَا؟ لْفِيْلَسُوْف ن ڒْوقْث-أَ زَعْمَا، ڒخُّو مَانِي يدْجَا؟ يَاك أَربِّـي يسْبُوْهڒِي ڒفْهَامث ن يِوْذَان ن دُّنشْت-أَ ثَانِيتَا؟ <verse eid="1CO 1:20" /><verse number="21" style="v" sid="1CO 1:21" />ئِسْبُوْهڒِي-ت س ڒفْهَامث ن مِين نتْبشَّار نشِّين. مَامّش؟ س ڒفْهَامث-أَ ن أَربِّـي يعْجب-اَس اَذ يسنْجم يِنِّي يتَامْنن، وَلَكِن يوْذَان ن دُّنشْت-أَ وَار زمَّرن اَث سّْنن س ڒفْهَامث نْسن. <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />نِثْنِي يسْرَائِلِيْين تتَّارن لْمُعْجِيزَاث، ذ يِنِّي وَار يدْجِين زِي أَيث-ئِسْرَائِل رزُّوْن ڒفْهَامث، <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />وَلَكِن نشِّين نتْبشَّار س لْمَسِيح يتْوَاصلّْبن. ئِسْرَائِيلِيْين تْنقْڒَاضن ذِي مَانَايَا، ذ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل <char style="it">قَّارن</char> قَا مَانَايَا ذ ثُوْبُّوْهْڒِيَا وَاهَا. <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />وَلَكِن إِ يِنِّي ؤُمِي د يڒَاغَا أَربِّـي، يعْنِي يسْرَائِلِيْين ذ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل، لْمَسِيح نتَّا ذ جّْهذ ن أَربِّـي ذ ڒفْهَامث نّس. <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />مَايمِّي؟ لِأَنَّا زَعْمَا ثُوْبُّوْهْڒِيَا ن أَربِّـي نتَّاث ثْسفْهَام كْتَار زِي ڒفْهَامث ن بْنَاذم، زَعْمَا ضُّوْعف ن أَربِّـي نتَّا يجْهذ كْتَار زِي جّْهذ ن بْنَاذم.<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />آي اَيثْمَا، فكَّارث ذِي مِين تُوْغَا ثدْجَام قْبڒ وَامِي ذَاوم د يڒَاغَا إِ كنِّيو أَربِّـي. مَاشِي اَطَّاس إِذْوم إِي ذِي تُوْغَا ثدْجَا ڒفْهَامث عْلَاحْسَاب مِين قَّارن يِوْذَان. مَاشِي اَطَّاس إِذْوم كنِّيو غَار تُوْغَا ثدْجَا لْمَرْتَبَا. مَاشِي اَطَّاس إِذْوم كنِّيو لْأَصل نْوم تُوْغَاث زݣ يمقّْرَانن. <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />وَلَكِن أَربِّـي يخْضَر مِين يدْجَان ذ ثُوْبُّوهْڒِيَا غَار يِوْذَان ن دُّنشْت-أَ حمَا اَذ يفْضح يِنِّي يتفْهَامن زَعْمَا. ئِخْضَر أَربِّـي مِين يضعْفن ذِي دُّنشْت-أَ حمَا اَذ يفْضح يِنِّي يجهْذن. <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />ئِخْضَر أَربِّـي ونِّي غَار يدْجَا لْأَصل نّس ذ اَمزْيَان ذ مِين يتْوَاعِيفَّان، ئِخْضَر حتَّا ذ ثِمسْڒَايِين وَار يدْجِين شَا بَاش اَذ يسْبطّڒ ثِمسْڒَايِين نِّي إِي يدْجَان. <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />مَايمِّي؟ حمَا ؤُڒَا ذ يج ن بْنَاذم وَار يتفْتَاخَر شَا زَّاث إِ أَربِّـي. <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />أُو نتَّا ذ سَّبَاب إِي زِي ثدْجَام كنِّيو ذِي عِيْسَى لْمَسِيح. ئِݣِّي-ث أَربِّـي نتَّا ذ ڒفْهَامث نّغ، يعْنِي نتَّا ذَايس صُّلْح نّغ ذ وصفِّي نّغ ذ وفكِّي نّغ. <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />فَلِهَاذَا، مَامش يقَّار لْكِتَاب: &lt;ونِّي يرزُّوْن اَذ يفْتَاخَر، أَذ يفْتَاخَر نتَّا زِي سِيذِي أَربِّـي.&gt;<verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s">أَرَّسُوْل بُوْلُس يتْبشَّار س لْمَسِيح يتْوَاصلّْبن</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />آي اَيثْمَا، نش وَامِي د ؤُسِيغ غَارْوم، ؤُسِيغ-د اَذ بشَّرغ س ڒْمَعْنَا ينُوْفَّرن ن أَربِّـي، مَاشِي ؤُسِيغ-د اَذ بشَّرغ س وَاوَاڒن يزوّْقن نِغ س ڒفْهَامث نِّي <char style="it">ن بْنَاذم</char>. <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />وَامِي تُوْغَا دْجِيغ اَكِذْوم، ݣِّيغ اَذ سْشنْعغ غِير عِيْسَى لْمَسِيح أُو ذ نتَّا يتْوَاصلّْبن ذِي صَّلِيب. <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" />تُوْغَا اَقَايِي اَكِذْوم س يِجّن ن ضُّعف ذ يِجّن ن ثِيݣّْوْذِي، ترْجِيجِيغ اَطَّاس. <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />مِين قَّارغ ذ مِين تْحدَّاثغ وَار يدْجِي شَا س وَاوَاڒن ن ڒفْهَامث بَاش اَكنِّيو سْقنْعن ذغْيَا؛ لَّا، سْخدَّامغ جّْهذ ن اَرُّوْح ن أَربِّـي <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />حمَا لْإِيمَان نْوم وَار يتْبدِّي شَا س ڒفْهَامث ن بْنَاذم، أَذ يبدّ س ثْزمَّار ن أَربِّـي.<verse eid="1CO 2:5" /></para>
  <para style="s">ڒفْهَامث إِي د يتَاسن زِي اَرُّوْح ن أَربِّـي</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />إِنَّمَا، نشِّين نسَّاوَاض يجّن ن وَاوَاڒ ن ڒفْهَامث غَار يِنِّي وَار يقِّيمن شَا ذ يمزْيَانن ذِي لْإِيمَان نْسن. وَلَكِن ڒفْهَامث-أَ وَار د تِيس شَا زِي ڒْوقْث-أَ نِغ زِي لْحُكَّام ن ڒْوقْث-أَ إِݣ يݣُّوْرن اَذ فْنَان. <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />لَّا، نشِّين نسَّاوَاض يجّن ن ڒفْهَامث ذَايس ڒْمَعْنَا ينُوْفَّرن ن أَربِّـي ذ مِين يتْوَاسْنُوْفَّرن. ئِزمّم-يت أَربِّـي قْبڒ مَا ٱذ د ثخْڒق ڒْوقْث قَاع حمَا نشِّين أَ نتْوَاسمْغَار. <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />ڒفْهَامث-أَ وَار ت يفْهِيم ؤُڒَا ذ يجّن زِي لْحُكَّام ن ڒْوقْث-أَ. لَّا، لِأَنَّا مَعْلِيك تُوْغَا ت فهْمن، إِڒِي وَار صلِّيبن شَا سِيذِيثْنغ غَار ثدْجَا لْعَظَمَا. <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />مَامش يقَّار لْكِتَاب:</para>
  <para style="q1" vid="1CO 2:9">&lt;مَانَاينِّي وَار ذِنِّي بُو ثِيطّ إِي ث يتْوَاڒَان،</para>
  <para style="q1" vid="1CO 2:9">نِغ ذ اَمجُّوْن إِي ذَاس يتسْڒَان،</para>
  <para style="q1" vid="1CO 2:9">نِغ ذ ڒَعْقڒ إِي ث يتْخَايَاڒن،</para>
  <para style="q2" vid="1CO 2:9">مِين يسوْجذ أَربِّـي إِ يِنِّي إِي ث يتْحِبَّان.&gt;<verse eid="1CO 2:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="1CO 2:10" />ثِمسْڒَايِين نِّي يسْمظْهَار-اَنغ-ثنْت-يد أَربِّـي س اَرُّوْح نّس. لِأَنَّا اَرُّوْح ن أَربِّـي يخزَّر ذِي ثْمسْڒَايِين مَارَّا، وَاخَّا ذ مِين يُوْدْجْغن ن أَربِّـي. <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />شُوْف، مِين يعْنَا ونِّي إِݣ يسّْنن لْأَفْكَار ن بْنَاذم غَار ذَاخڒ؟ ئِسّن-يثنْت اَرُّوْح ن بْنَاذم نِّي س يِيخف نّس. كِيف-كِيف أَربِّـي، وَار ذِنِّي حَدّ يسّن لْأَفْكَار ن أَربِّـي إِلَّا اَرُّوْح ن أَربِّـي وَاحْذس. <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />وَار ذَانغ د يُوْشِي شَا اَرُّوْح ن دُّنشْت-أَ، يُوْشَا-ٱنغ-د اَرُّوْح إِي د يُوْسِين زِي أَربِّـي حمَا أَ نفْهم ثِمسْڒَايِين نِّي إِي ذَانغ د يُوْشَا أَربِّـي بَاطڒ. <verse eid="1CO 2:12" /><verse number="13" style="v" sid="1CO 2:13" />نسَّاوَاض مَانَايَا س وَاوَاڒن إِي وَار ثن ثْسڒْمِيذ شَا ڒفْهَامث ن بْنَاذم؛ لَّا، نسَّاوَاض-يث س وَاوَاڒن إِݣ يسڒْمَاذ اَرُّوْح ن أَربِّـي. <char style="it">أَوَاڒن-</char>أَ تْشَرَّاحن لْحَقِيقَاث رُوْحِيَاث إِ يِنِّي ؤُمِي غَار يدْجَا اَرُّوْح ن أَربِّـي.<verse eid="1CO 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 2:14" />بْنَاذم عَادِي يتَاݣِي اَذ يقْبڒ ثِمسْڒَايِين ن اَرُّوْح ن أَربِّـي، غَارس مَانَايَا ذ ثُوْبُّوْهْڒِيَا وَاهَا. وَار يزمَّر شَا اَثنْت يفْهم، لِأَنَّا س اَرُّوْح ن أَربِّـي وَاحْذس إِي ثنْت غَا يميّز. <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />أَمَّا بْنَاذم ونِّي غَار يدْجَا اَرُّوْح ن أَربِّـي. ئِتْميَّاز مَارَّا ثِمسْڒَايِين، نتَّا وَار ذَايس يتْمِيِّيز حَدّ. <verse eid="1CO 2:15" /><verse number="16" style="v" sid="1CO 2:16" />لِأَنَّا <char style="it">مَامش يقَّار لْكِتَاب:</char> &lt;وِيݣ يسّْنن ڒَعْقڒ ن سِيذِي أَربِّـي حمَا اَث يسفْهم؟&gt; أُو نشِّين غَارْنغ ڒَعْقڒ ن لْمَسِيح.<verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s">لْخِلَاف ذِي جْمَاعث ن ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />آي اَيثْمَا، نش تُوْغَا وَار زمَّرغ شَا اَكِذْوم سِّيوْڒغ اَم يِوْذَان يتݣّن اَرَّاي إِ اَرُّوْح ن أَربِّـي. لَّا، سِّيوْڒغ اَكِذْوم اَم يِوْذَان إِݣ يتݣّن اَرَّاي إِ نّفْس نْسن، أَم يسيْمَان وَاهَا إِي د يخڒْقن ذِي لْمَسِيح. <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" />ؤُشِيغ-اَوم اَذ تْحڒْوم اَغِي<note caller="+" style="f"><char style="fr" closed="false">3‏.2 </char><char style="ft" closed="false">أَغِي نتَّا ذ اَشفَّاي ذِي ڒبْعَاض ن يمُوْشَان ذِي أَرِّيف.</char></note> وَاهَا مَاشِي لْمَكْلَا ذ صَّح، لْمَكْلَا ذ صَّح تُوْغَا وَار ذَاس ثْزمَّرم شَا. أَقَا عَاذ ڒخُّو وَار ذَاس ثْزمَّرم شَا، <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />كنِّيو عَاذ تݣّم اَرَّاي إِ طَّبِيعَا ثَعفَّانْت نْوم. مڒَا يتِيڒِي ڒحْسذ جَارَاوم ذ ومنْغِي، أَتَاف تݣّم اَرَّاي إِ طَّبِيعَا ثَعفَّانْت نْوم اَتَاف تْعِيشم اَم يِوْذَان ن دُّنشْت-أَ وَاهَا، نِغ لَّا؟ <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" />شُوْف، مڒَا يجّن يقَّار نش ذفَّارغ بُوْلُس يجّن يقَّار نش ذفَّارغ أَپُــوْلُّوْس، أَتَاف كنِّيو تْعِيشم اَم يوْذَان ن دُّنشْت-أَ، نِغ لَّا؟<verse eid="1CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />إِيوَا مِين يعْنَا أَپُــوْلُّوْس؟ مِين يعْنَا بُوْلُس؟ نشِّين ذ يخدَّامن وَاهَا، ثُوْمْنم خ وفُوْس نّغ مَامّش ذَانغ د يُوْشَا سِيذِي أَربِّـي أَ نخْذم. <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />نش ࢲُّوْغ، أَپُـوْلُّوْس يسسّو، أُو ذ أَربِّـي إِي كنِّيو يسغْمَاين. <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />ونِّي يتࢲُّوْن ذ ونِّي يسسَّاون نِثْنِي وَار دْجِين ذ وَالُو. ونِّي يدْجَان نتَّا ذ أَربِّـي يعْنِي نتَّا يسغْمَاين.<verse eid="1CO 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 3:8" />فَا ونِّي يتࢲُّوْن ذ ونِّي يسسَّاون ڒْخذْمث نْسن ذ يجّن، كُڒ يجّن اَث يجَازَا عْلَاحْسَاب ڒْخذْمث نّس. <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />لِأَنَّا نشِّين نْشَرّش اَك أَربِّـي ذِي ڒْخذْمث-أَ. كنِّيو ذ اَمَرْجع نّس ذ ڒبْنِي نّس. <verse eid="1CO 3:9" /><verse number="10" style="v" sid="1CO 3:10" />نش عْلَاحْسَاب اَرْضَا إِي ذَايِي يُوْشَا أَربِّـي ݣِّيغ يجّن ن دْسَاس اَم يِجّن ن لمْعَلّم يفْسُوْس نتَّا. يُوْسَا-د يجّن نّغْنِي يبنَّا خ دْسَاس-أَ. وَلَكِن أُو لَابُد كُڒ يجّن اَذ يَارّ ڒْبَاڒ مَامّش غَا يبْنَا خ دْسَاس-أَ. <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />وَار ذِنِّي حَدّ يزمَّر اَذ يݣّ يج ن دْسَاس نّغْنِي خ ونِّي ذِنِّي يتْوَاݣّن، أُو <char style="it">دْسَاس-أَ وَانِيتَا </char> ذ عِيْسَى لْمَسِيح. <verse eid="1CO 3:11" /><verse number="12‏-13" style="v" sid="1CO 3:12-13" />ئِجّن، مڒَا يبْنَا خ دْسَاس-أَ س دّْهب نِغ س نُّقَارْث نِغ س ثِيزْرَا ثِصبْحَانِين نِغ س وكشُّوْض نِغ س اَرْبِيع نِغ س ورُوْم، أَتَاف ڒْخذْمث نّس اَذ د تْبَان، يعْنِي يُوْم لْحِسَاب ذ لْعِقَاب إِي د غَا يسْمظْهَار مَانَايَا. أُو عَاوذ مَانَايَا اَثِيد ثسْمظْهَار يجّن ن ثْمسِّي أُو ثِمسِّي-يَا اَذ تْصَاحّح مَان نُّوْع ن ڒْخذْمث إِي يݣَّا مْكُڒ يجّن. <verse eid="1CO 3:12-13" /><verse number="14" style="v" sid="1CO 3:14" />ونِّي يبْنَان خ دْسَاس-أَ ڒْخذْمث نّس نِيشَان وَار ت تتّ شَا ثْمسِّي، أَتَاف اَث يجَازَا. <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />ونِّي ؤُمِي غَار ثحرق ڒْخذْمث نّس، أَتَاف اَذ يخْسَر لْجَائِزَا نِّي. نتَّا س يِيخف نّس اَذ ينْجم وَلَكِن اَم ونِّي يَالَّاه د يَروْڒن زِي ثْمسِّي.<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />مَا وَار ثسِّينم شَا بلِّي ذ كنِّيو إِي يدْجَان ذ ثَمْزِيذَا ن أَربِّـي، يزدّغ ذَايْوم اَرُّوْح ن أَربِّـي؟ <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />ونِّي غَا يهذْمن ثَمْزِيذَا-يَا ن أَربِّـي، أَث يهْذم أَربِّـي. لِأَنَّا ثَمْزِيذَا-يَا ن أَربِّـي نتَّاث مُقدّس أُو ذ كنِّيو إِݣ يدْجَان ذ ثَمْزِيذَا نِّي.<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />ئِتْخصَّا وَار ذِنِّي يتِيڒِي حَدّ يخدّع يخف نّس. مڒَا ذِنِّي شَان يِجّن جَارَاوم يحسّب يخف نّس ذ اَمِيغِيس ذِي زْمَان-أَ، ئِتْخصَّا اَذ يذْوڒ ذ اَبُوْهَاڒِي زَعْمَا بَاش اَذ يِيڒِي ذ اَمِيغِس. <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />شُوْف، ڒفْهَامث ن دُّنشْت-أَ نتَّاث ذ ثُوْبُّوْهْڒِيَا وَاهَا غَار أَربِّـي. لِأَنَّا يقَّار لْكِتَاب: &lt;نتَّا يطّف يمِيغِيسن ذݣ يخَارْوِيضن نْسن.&gt; <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />ئِقَّار عَاوذ: &lt;سِيذِي أَربِّـي يسّن لْأَفْكَار ن يمِيغِيسن وَار نفّْعنْت شَا.&gt;<verse eid="1CO 3:20" /></para>
  <para style="p">
    <verse number="21‏-22" style="v" sid="1CO 3:21-22" />إِيوَا صَافِي، مَاشِي اَذ تفْتَخَرم س يرْيَازن. شُوْف، كُڒْشِي نْوم: وَاخَّا ذ بُوْلُس نِغ ذ أَپُوْلُّوْس نِغ ذ بُطْرُس، نِغ ذ دُّنشْت-أَ نِغ ذ ثُوْذَارْث نِغ ذ ڒْموْث، نِغ ذ مِين يدْجَان ڒخُّو نِغ ذ مِين غَا يِيڒِين منْبَعْد، يعْنِي كُڒْشِي نْوم. <verse eid="1CO 3:21-22" /><verse number="23" style="v" sid="1CO 3:23" />كنِّيو ن لْمَسِيح، أُو لْمَسِيح نتَّا ن أَربِّـي.<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s">ڒْخذْمث ن اَرُّسُل</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />شُوْف، أَمُّو يتْخصَّا اَذَانغ ࢲرن يِوْذَان يعْنِي نشِّين ذ يخدَّامن ن لْمَسِيح، نشِّين نتْكلَّاف خ ثْمسْڒَايِين ينُوْفَّرن ن أَربِّـي. <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />أُو لَابُد يِنِّي يتْكلَّافن يتْخصَّا اَذَايْسن ثِيڒِي تِّيقث. <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />نش وَار ذَايِي يتْهِيمِّي شَا اَطَّاس مڒَا تْحَاكَامم-اَيِي كنِّيو نِغ ذ شَان لْمَحْكَامَا نّغْنِي. ؤُڒَا ذ نش وَار دْجِيغ بُو ذ ڒْقَاضِي خ يِيخف ينُو. <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />نش ضَّمِير ينُو مرْتَاح إِي يدْجَا، وَلَكِن نش مَا بَرِيء إِي دْجِيغ عْلَاحْسَاب ضَّمِير ينُو؟ لَّا، ذ سِيذِي أَربِّـي إِي ذَايِي غَا يُوْشن ڒْحُكم-أَ. <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />خ مَانَايَا وَار قَّارم وَالُو خ ڒْحُكم قْبڒ ڒْوقْث، يعْنِي قْبڒ إِي د غَا يَاس سِيذِيثْنغ. ذ نتَّا إِي غَا يسْبيّنن ثِمسْڒَايِين نِّي غَار نُّوْر ڒخُّو نُوْفَّرنْت ذِي ثَادْجسْت، أَذ د يسْمظْهَار كُڒ لْغَرَض ن يِوْذَان إِي غَارْسن ذݣ وُوْڒَاون نْسن. ڒخْدّنِّي كُڒ يجّن اَغَارس يِيڒِي وسمْغَار نّس زِي أَربِّـي.<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />آي اَيثْمَا قَّارغ مَانَايَا خ أَپُـوْلُّوْس ذ نش، مثّْلغ مَانَايَا حمَا اَزَّايس ثَاوِيم نّْفَع. كنِّيو اَذ تْڒمْذم زَّايْنغ مِين يعْنَا لْمِثَال نِّي يقَّارن "وَار تْبعَّاذث شَا زِي مِين يُوْرِين ذِي لْكِتَاب." أَمنِّي وَار ذِنِّي حَدّ اَذ يسشْنع شَان ورْيَاز خ ونّغْنِي. <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />شك، وِي ش يسْشنْعن خ ونّغْنِي؟ كُڒ ڒْحَاجث إِي غَارك ثمُّوْش-اَش نِغ لَّا؟ ئِي شك، وَامِي يمُّوْش-اَش مَانَاينِّي مَايمِّي تفْتَخَرذ اَخْمِي وَار ذَاش يمُّوْش شَا؟<verse eid="1CO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8" />كنِّيو، مَا صَـــافِي غَارْوم مَارَّا مِين تحْذَاجِيم؟ مَا صَـــافِي كنِّيو ثْذوْڒم ذ تْوَاجَر؟ كنِّيو، مَا ذ صَّح ثْذوْڒم ذ يزدْجِيذن بْڒَا نشِّين؟! إِيوَا مشْحَاڒ خْسغ بَاش اَذ يِيڒِي ذ صَّح كنِّيو تحْكَامم حمَا اَذ تْشَرْشم اَكِذْنغ ڒحْكَام نِّي نْوم. <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />لِأَنَّا تْفكَّرغ بلِّي نشِّين اَرُّسُل يسْفُوْرُّوْج-اَنغ أَربِّـي ذ ينݣُّوْرَا ذِي لْملْعَب، يعْنِي نشِّين اَم يِوْذَان حكْمن خَاسن س ڒْموْث اَذ مّْثن ذِنِّي. ئِݣَّا-ٱنغ أَ نسْفُوْرُّوْج دُّنشْت-أَ ثكْمَاڒ، يعْنِي يوْذَان ذ لْمَلَائِكَاث. <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />نشِّين ذ يبُوْهَاڒِيْين زَعْمَا عْلَاحْسَاب لْمَسِيح، ئِي كنِّيو مَا ذ يمِيغِيسن ذِي لْمَسِيح؟ نشِّين نضْعف، ئِي كنِّيو مَا ثْجهْذم؟ كَرّْمن-كنِّيو، نشِّين سْبهْدَاڒن-اَنغ. <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />قَا عَاذ ذِي ثْسَعَّات-أَ ندْجُوْز، نْفُوْذ، أَقَانغ س يخَارْطِيطن، تْمَرَّاثن-اَنغ، وَار غَارْنغ مَانِي غَا نْدُوْرَّا. <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" />نشَّاث تَمَارَا، نْخدّم س يفَاسّن نّغ. مڒَا نِثْنِي تْزبَّاڒن ذَايْنغ، نشِّين نتْبَرَّاك-يثن. مڒَا نِثْنِي تْعدَّابن-اَنغ، نشِّين نْصبَّر. <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />مڒَا نِثْنِي قَّارن خَانغ ڒْبَاطڒ، نشِّين نْتَارَّا-د خَاسن س يِجّن ن لْإِحْسَان. قَا نشِّين عَاذ اَڒ ڒخُّو نذْوڒ اَم ثْزوْبَايْث ن دُّنشْت-أَ ذ زْبڒ ن مَارَّا يوْذَان.<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />مَاشِي ؤُرِيغ ثِمسْڒَايِين-أَ بَاش اَكنِّيو فضْحغ؛ لَّا، ؤُرِيغ-ثنْت بَاش اَكنِّيو نْهِيغ اَم شَا ن ثَارْوَا ينُو يعِيزّن. <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />وَاخَّا اَكِذْوم عشْرَاڒَاف ن لْمُربِّيِين ذِي لْمَسِيح، وَار غَارْوم شَا اَطَّاس ن بَابَاثْوم. لِأَنَّا ذِي عِيْسَى لْمَسِيح نش ذ بَابَاثْوم ذِي لْإِنْجِيل. <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" />إِذن، تْشجَّاع-كنِّيو اَذَايِي ثْقلّْدم مَامش تݣّغ نش. <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />خ مَانَاينِّي إِي خف كنِّيو د سّكِّيغ تِيْمُوْتَاوُس. نتَّا يعِيزّن خَافِي اَم شَان ممِّي، ذَايس تِّيقث ذِي سِيذِيثْنغ. أَكنِّيو يسْفكَّر خ يبْرِيذن ينُو ذِي لْمَسِيح مَامّش ثن سڒْمَاذغ ذِي مَارَّا يمُوْشَان ذ مَارَّا ثِجُمَاع ن ڒْمُوْمِنِين.<verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />فَا ڒبْعَاض زَّايْوم ذَايْسن تَّكبُّر، تْغِير-اَسن نش وَار غَارْوم د تِيسغ شَا. <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />لَّا، قَا عْڒَاين اَغَارْوم د اَسغ مڒَا يخس أَربِّـي. يِنِّي إِي ذِي يدْجَا تَّكبُّر اَثن سّْنغ نش. مَاشِي اَثن سّْنغ مِين قَّارن؛ لَّا، أَثن سّْنغ مَا ذَايْسن شَان جّْهذ مَا لَّا. <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />لِأَنَّا ڒْمُلْك ن أَربِّـي وَار يدْجِي بُو ذݣ وَاوَاڒ؛ لَّا، أَقَاث ذِي جّْهذ. <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />مَامش ثْرزُّوْم اَذ د اَسغ؟ مَا س وعْمُوْذ مَا س ڒمْحِبّث اَك يِجّن ن وُوْڒ يصبَّرن؟<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s">شَّرّْ ذِي جْمَاعث ن ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />ئِفّغ-د يجّن ن ڒخْبَار بلِّي ذِنِّي يجّن ن نُّوْع ن لْفَسَاد جَارَاوم وَار خَاس صبَّرن شَا وَاخَّا ذ لْكُفَّار! ئِجّن ن ورْيَاز غَارس ثَمْغَارْث ن بَابَاس. <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />ئِي كنِّيو، مَا ذَايْوم تَّكبُّر؟! لَّا، كنِّيو يتْخصَّا اَذ تْخيّْقم. ئِتْخصَّا اَذ تْسُوْفْغم ونِّي يݣِّين مَانَايَا زِي جْمَاعث نْوم. <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />نش، وَاخَّا غَابغ زَّايوْم س دَّات ينُو، أَقَاث ذِنِّي اَكِذْوم اَرُّوْح ينُو. صَافِي، نش اَخْمِي اَقَايِي ذِنِّي حكْمغ خ ونِّي يݣِّين ثَمسْڒَايْث-أَ. <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />خْمِي غَا ثْمُوْنم س يِيسم ن سِيذِيثْنغ عِيْسَى اَكِذْوم يِيڒِي اَرُّوْح ينُو، س جّْهذ ن سِيذِيثْنغ عِيْسَى <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />اَذ تْسُوْفْغم اَرْيَاز-أَ غَار شِّيطَان حمَا اَذ تفْنَا طَّبِيعَا ثَعفَّانْت ن نّفْس نّس اَذ ينْجم اَرُّوْح نّس ذِي يُوْم ن سِيذِيثْنغ.<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />مَاشِي مْلِيح وَامِي تفْتَخَارم. وَار ثسِّينم شَا إِلَّا غِير ذْرُوْس ن ونْتُوْن<note caller="+" style="f"><char style="fr" closed="false">5‏.6 </char><char style="ft" closed="false">أَنْتُوْن نتَّا ذ اَمْثُوْن.</char></note> إِي د يسْݣَعَّاذن مَارَّا ڒْعَاجْنث ن ورشْثِي؟<note caller="+" style="f"><char style="fr" closed="false">5‏.6 </char><char style="ft" closed="false">أَرشْثِي يعْنِي نتَّا ذ اَرِيْثِي.</char></note> <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />كّْسث اَنْتُوْن نِّي اَقْذِيم حمَا اَذ تِيڒِيم ذ يجّن ن ڒْعَاجْنث ذ جْذِيذ ن ورشْثِي بْڒَا اَنْتُوْن. لِأَنَّا اَمُّو ذ صَّح إِي ثدْجَام كنِّيو. شُوْف، ئِتْوَاغَرص ڒْعِيذ نّغ يعْنِي لْمَسِيح. <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />خ مَانَايَا أَ نْعيّذ وَلَكِن وَار نتْعيِّيذ شَا س ونْتُوْن نِّي اَقْذِيم، يعْنِي اَنْتُوْن نِّي نتَّا ذ ڒقْبَاحث ذ شَّرّْ. لَّا، نشِّين أَ نْعيّذ س ثفْضِيرْث، يعْنِي يجّن ن ؤُغْرُوْم ذَايس لْحَقِيقَا وَار ذَايس بُو يخَرِيقّن.<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />تُوْغَا ؤُرِيغ-اَوم-د ذِي ثبْرَات نِّي ينُو وَار تْعَاشَرث شَا يِنِّي يتݣّن لْفَسَاد. <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />وَلَكِن تُوْغَا وَار سِّيوِيڒغ شَا خ لْكُفَّار ن دُّنشْت-أَ يِنِّي يتݣّن لْفَسَاد نِغ ذ يضمَّاعن نِغ ذ يغشَّاشن نِغ ذ يِنِّي يعبّْذن لْأَصْنَام. مَعْلِيك اَمنِّي اَذ يِيڒِي لَابُد اَذ تفّْغم زِي دُّنشْت-أَ قَاع. <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />لَّا، وَلَكِن ڒخُّو نش ؤُرِيغ-اَوم-د بَاش وَار تْعَشَارم شَا ڒْمُوْمن ونِّي يقَّارن قَا نش ذ ؤُمَاش وَلَكِن نتَّا يتݣّ لْفَسَاد نِغ ذ اَضمَّاع نِغ يعبّذ لْأَصْنَام نِغ يقَّار ڒْبَاطڒ نِغ يسسّ اَطَّاس ن شّْرب نِغ ذ اَغشَّاش. ئِجّن اَم وَانِيتَا، وَار تتّم شَا اَكِذس قَاع.<verse eid="1CO 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12" />شُوْف، مَاشِي ذ شّْغڒ ينُو اَذ حكْمغ خ <char style="it">لْكُفَّار</char> غَار بَارَّا <char style="it">ن جْمَاعث ن ڒْمُوْمِنِين</char>؛ لَّا، وَلَكِن ذ شّْغڒ نْوم اَذ تْحكْمم خ يِوْذَان غَار ذَاخڒ <char style="it">ن جْمَاعث</char>. <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" /><char style="it">لْكُفَّار</char> غَار بَارَّا اَخَاسن يحْكم أَربِّـي. <char style="it">صَافِي، مَامّش يقَّار لْكِتَاب:</char> &lt;سُوْفْغث خَاوم بْنَاذم اَعفَّان.&gt;<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s">شِّكَايَاث جَار ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />شَان يِجّن زَّايْوم غَارس شِّكَايَا ضذ إِ يِجّن نّغْنِي. مَا ذ صَّح وَار يتْصذْحِي شَا نتَّا، ئِتْبدَّا ذِي لْمَحْكَمَا غَار زَّاث ن ينِّي وَار يُوْمِينن شَا مَاشِي غَار زَّاث ن صَّالِحِين؟ <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />مَا وَار ثسِّينم شَا بلِّي نِثْنِي صَّالِحِين إِي غَا يحكْمن خ دُّنشْت-أَ؟ ئِي كنِّيو مڒَا ثْحكْمم خ دُّنشْت-أَ، مَايمِّي وَار ثْزمَّرم شَا اَذ تْحلّم شِّكَايَاث ثِمزْيَانِين؟ <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />مَا وَار ثسِّينم شَا بلِّي أَ نحْكم خ لْمَلَائِكَاث؟ إِيوَا أُو لَابُد أَ نحْكم خ ثْمسْڒَايِين ن ثُوْذَارْث-أَ! <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />إِذن، وَامِي جَارَاوم شِّكَايَاث اَم ثِيْنَا، مَايمِّي ثنْت ثْسرْسم زَّاث إِ يِنِّي وَار غَار ثدْجِي شَا لْقِمَا اَك جْمَاعث ن ڒْمُوْمِنِين؟ <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />قَّارغ-اَوم مَانَايَا حمَا اَذ تْسذْحِيم. مَا ذ صَّح وَار ذِنِّي حَدّ جَارَاوم ذَايس ڒفْهَامث حمَا اَذ يحلّ شِّكَايَاث-أَ جَار ڒْمُوْمِنِين؟ <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />وَلَكِن مَاشِي مْلِيح اَوْمَاثن تمْشَرَّاعن اَك وَايَاوْيَا زَّاث إِ يِنِّي وَار يُوْمِينن شَا. <verse eid="1CO 6:6" /><verse number="7" style="v" sid="1CO 6:7" />خْمِي كنِّيو تمْشَرَّاعم اَك وَايَاوْيَا، أَتَاف صَافِي ثخْسَرم. إِيوَا حْسن إِ كنِّيو مڒَا تْوَاضڒْمم نِغ تْوَاغشّم. <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />لَّا، وَلَكِن كنِّيو ثْضدْجْمم تݣّم ڒْغشّ، تݣّم مَانَايَا إِ اَيثْمَاثْوم.<verse eid="1CO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 6:9" />مَا وَار ثسِّينم شَا بلِّي يِنِّي وَار يُوْمِينن شَا وَار زْمَّرن اَذ وَارْثن ڒْمُلْك ن أَربِّـي؟ وَار خدّْعم شَا يخف نْوم. يِنِّي يتݣّن لْفَسَاد، ذ يِنِّي يعبّْذن لْأَصْنَام، ذ يِنِّي يزنَّان، ذ يحَنْجِيرن يفسّْذن اَك يرْيَازن، ذ يرْيَازن يفسّْذن اَك يرْيَازن، <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />ذ يشفَّارن، ذ يضمَّاعن، ذ يِنِّي يسسّن اَطَّاس ن شّْرب، ذ يِنِّي يقَّارن ڒْبَاطڒ، ذ يغشَّاشن وَار تْوَارَاثن شَا ڒْمُلْك ن أَربِّـي. <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />أَمُّو إِي تُوْغَا تݣّن ڒبْعَاض زَّايْوم، وَلَكِن ڒخُّو تْوَاسِيرْذم، تْوَاسِّيصْفَام، تْوَاسمْصْڒَاحم اَك أَربِّـي س يِيسم ن سِيذِيثْنغ عِيْسَى لْمَسِيح أُو س اَرُّوْح ن أَربِّـي نّغ.<verse eid="1CO 6:11" /></para>
  <para style="s">بعّذث خ لْفَسَاد</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />نش غَارِي مَارَّا ثِمسْڒَايِين حدْجْڒنْت، وَلَكِن وَار نفّْعنْت شَا مَارَّا ثِمسْڒَايِين نِّي. غَارِي مَارَّا ثِمسْڒَايِين حدْجْڒنْت، وَلَكِن يتْخصَّا وَار خَافِي تْرَايِي ؤُڒَا ذ يجّن ن ثْمسْڒَايْث. <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />أَذ يِينِي يجّن: "إِيوَا لْمَكْلَا ن وعدِّيس، أَعدِّيس ن لْمَكْلَا." وَلَكِن أَربِّـي اَثن يهْذم س ثْنَاين إِذْسن. دَّات مَاشِي ن لْفَسَاد، دَّات نتَّاث ن سِيذِيثْنغ. أُو سِيذِيثْنغ يتْذبَّر إِ دَّات. <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />أَربِّـي س جّْهذ نّس يسكَّر-د سِيذِيثْنغ زِي ڒْموْث، أَذَانغ د يسكَّر زِي ڒْموْث ؤُڒَا ذ نشِّين. <verse eid="1CO 6:14" /><verse number="15" style="v" sid="1CO 6:15" />مَا وَار ثسِّينم شَا بلِّي دَّات نْوم نتَّاث ذ طْرُوْفَاث ن دَّات ن لْمَسِيح؟ إِيوَا طْرُوْفَاث-أَ، مَا ٱثنْت يْسِيغ اَثنْت سْمُوْنغ اَكذ لْفَسْدَاث؟ لَّا، عمَّارْص! <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />مَا وَار ثسِّينم ونِّي يتْمُوْنن اَكذ لْفَسْدَا اَذ يذْوڒ ذ يج ن دَّات اَكِذس؟ وَاه، لِأَنَّا يقَّار لْكِتَاب: &lt;نِثْنِي س ثْنَاين إِذْسن اَذ ذوْڒن ذ يجّن.&gt; <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />وَلَكِن ونِّي يمُوْنن اَكذ سِيذِيثْنغ اَذ يذْوڒ ذ يج ن اَرُّوْح اَكِذس. <verse eid="1CO 6:17" /><verse number="18" style="v" sid="1CO 6:18" />اَروْڒث زِي لْفَسَاد. كُڒ ڒْمُعْصِيّث نّغْنِي إِݣ يتݣّ بْنَاذم اَذ تِيڒِي غَار بَارَّا ن دَّات نّس. ونِّي يتݣّن لْفَسَاد يعصَّا دَّات نّس نِّيث. <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" />نِغ مَا وَار ثسِّينم دَّات نْوم نتَّاث ذ ثَمْزِيذَا ن اَرُّوْح يقدّْسن إِݣ يزدّْغن ذَايْوم؟ إِيوَا غَارْوم اَرُّوْح-أَ زِي أَربِّـي. كنِّيو وَار تْرَايِيم شَا خ يِيخف نْوم <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />مِينْزِي تْوَاسْغم كنِيو س يِجّن ن تَّمَن. فَلِهَاذَا، سمْغَارث أَربِّـي س دَّات نْوم.<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s">أَرَّسُوْل بُوْلُس يتْوصَّا ڒْمُوْمِنِين خ ڒمْڒَاش</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />فَا ڒخُّو أَ نْسِّيوڒ خ ثْمسْڒَايِين إِي خف ثُوْرِيم كنِّيو. <char style="it">مَثَالَان،</char> مْلِيح اَرْيَاز مڒَا وَار يتْحِيذِي شَا ثَمْغَارْث. <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />وَلَكِن حْسن مڒَا كُڒ يجّن اَغَارس ثِيڒِي ثمْغَارْث نّس، كُڒ يشْتن اَغَارس يِيڒِي ورْيَاز نّس حمَا وَار يتِيڒِي شَا لْفَسَاد. <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />أُو لَابُد اَرْيَاز اَذ يُوْش ڒْحَقّ ن ڒمْڒَاش إِ ثمْغَارْث نّس. أَمُّو عَاوذ أُو لَابُد ثَمْغَارْث اَذ تُوْشّ ڒْحَقّ ن ڒمْڒَاش إِ ورْيَاز نّس. <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />ڒَاحقَّاش ثَمْغَارْث وَار تْرَايِـي شَا خ دَّات نّس وَاحْذس، ئِتْرَايَا خَاس ؤُڒَا ذ اَرْيَاز نّس. أَمُّو عَاوذ اَرْيَاز وَار يتْرَايِي شَا خ دَّات نّس وَاحْذس، تْرَايَا خَاس ؤُڒَا ذ ثَمْغَارْث نّس.<verse eid="1CO 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 7:5" />ئِتْخصَّا وَار ثْقطّْعم شَا خ وَايَاوْيَا إِلَّا مڒَا ثْتَافْقم اَك وَايَاوْيَا يجّن ن لْمُدَّا وَاهَا حمَا اَذ تُوْشم ڒْوقْث نِّي إِ ثْࢲَادْجِيث نْوم. منْبَعْد اَذ تْمُوْنم حمَا وَار كنِّيو يتْغَارِّي شَا شِّيطَان ڒَاحقَّاش اَتَاف وَار ثْزمَّرم شَا اَذ تْحكْمم مْلِيح خ شّهْوث نْوم. <verse eid="1CO 7:5" /><verse number="6" style="v" sid="1CO 7:6" />وَلَكِن مَانَايَا مَاشِي ذ يجّن ن ڒُوْصِيّث، قَّارغ-اَوم-ت اَم يِجّن ن تّسْرِيح. <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />رزُّوْغ مَارَّا يرْيَازن اَذ يڒِين اَم نش. وَلَكِن كُڒ يجّن غَارس ثِزمَّار إِي ذَاس يُوْشَا أَربِّـي، ئِجّن غَارس ثِين، ئِجّن غَارس ثَا.<verse eid="1CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8" />فَا ڒخُّو اَذ سِّيوْڒغ خ يِنِّي وَار يمْڒِيشن شَا ذ ثَاجَّاڒِين. يعْنِي مْلِيح مڒَا قِّيمن اَم نش. <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />وَلَكِن مڒَا وَار زمَّرن شَا اَذ حكْمن خ شّهْوث نْسن أُو لَابُد اَذ مڒْشن. ڒَاحقَّاش مڒَا مڒْشن حْسن زِي مڒَا قِّيمن حرّْقن ذِي شّهْوث نْسن.<verse eid="1CO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10" />فَا يِنِّي يمڒْشن، ئِوصَّا خَاسن سِيذِيثْنغ مَاشِي ذ نش: ممْنُوْع ثَمْغَارْث اَذ تسْمح ذݣ ورْيَاز. <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />مڒَا ثَمْغَارْث ثسْمح ذݣ ورْيَاز نّس يتْخصَّا-يَاس وَار تْمدْجش شَا عَاوذ، نِغ اَذ تْمصْڒَاح اَك ورْيَاز نّس. ممْنُوْع عَاوذ اَرْيَاز اَذ يدْجف إِ ثمْغَارْث نّس.<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />فَا يِنِّي نّغْنِي، قَّارغ-اَسن نش (يعْنِي وَار ت يقَّار شَا سِيذِيثْنغ، غِير نش): مڒَا شَان ؤُمَاثْنغ غَارس ثَمْغَارْث مَاشِي ذ ڒْمُوْمنَا ثقْبڒ اَكِذس ثْعِيش، ممْنُوْع اَذَاس يدْجف. <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />عَاوذ ثَمْغَارْث، مڒَا غَارس اَرْيَاز مَاشِي ذ ڒْمُوْمن يقْبڒ اَكِذس يعِيش، ممْنُوْع اَذَاس ثدْجف. <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />شُوْف، أَرْيَاز مَاشِي ذ ڒْمُوْمن اَقَاث سْوَادَّاي إ لْعِنَايَا ن أَربِّـي س ثمْغَارْث نّس. ثَمْغَارْث مَاشِي ذ ڒْمُوْمنَا اَقَات سْوَادَّاي ن لْعِنَايَا ن أَربِّـي س ورْيَاز نّس. مڒَا مَاشِي اَمنِّي، ثَارْوَا نْوم اَذ يڒِين س بَارَّا ن لْعِنَايَا ن أَربِّـي. وَلَكِن ڒخُّو اَقَاثن سْوَادَّاي إِ لْعَنَايَا نّس.<verse eid="1CO 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 7:15" />إِنَّمَا، ونِّي نِغ ثنِّي وَار يُوْمِينن شَا مڒَا يسْمح، صَافِي اَذ يسْمح. يعْنِي ڒْمُوْمن-أَ ذ ڒْمُوْمنَا-يَا غَارْسن لْحُرِّيَا س ظُرُوْف-أَ لِأَنَّا يڒَاغَا-يَاوم-د أَربِّـي اَذ تْعِيشم ذِي ڒهْنَا. <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />شُوْف آ ثَمْغَارْث، مَانِيس ثسّْنذ شم زَعْمَا بَاش اَذ تسْنجْمذ اَرْيَاز نّم؟ ئِي شك آي اَرْيَاز، مَانِيس ثسّْنذ شك زَعْمَا بَاش اَذ تسْنجْمذ ثَمْغَارْث نّش؟<verse eid="1CO 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />كُڒ يجّن اَذ يعِيش ثُوْذَارْث نّس مَامش ذَاس ت يُوْشَا سِيذِيثْنغ، مَامش ذَاس د يڒَاغَا أَربِّـي. أَمُّو إِي تْوصِّيغ نش مَارَّا ثِجُوْمَع ن ڒْمُوْمِنِين. <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />شَان يجّن، مڒَا يڒَاغَا-يَاس-د أَربِّـي أُو نتَّا تُوْغَا ݣِّين-اَس طَّهَارث،<note caller="+" style="f"><char style="fr" closed="false">7‏.18 </char><char style="ft" closed="false">طَّهَارث نتَّاث ذ اَحجّم نِغ ذ اَخْثَان نِغ ذ لْخِتَام.</char></note> مَاشِي اَذ يرَاح اَذ يكّس طَّهَارث نِّي. شَان يجّن، مڒَا يڒَاغَا-يَاس-د أَربِّـي تُوْغَا وَار ذَاس ݣِّين شَا طَّهَارث، مَاشِي اَذ يرْزُو اَذ يݣّ طَّهَارث. <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />مڒَا يتْطهَّار نِغ وَار يتْطهِّير شَا، مَانَاينِّي يتْوَاحْسَاب ذ وَالُو. مڒَا يتݣّ س ڒُوْصِيَاث ن أَربِّـي ذ مَانَاينِّي إِݣ يتْوَاحْسَابن. <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />كُڒ يجّن اَذ يقِّيم ذِي لْحَالَا إِي ذِي تُوْغَا يدْجَا زِي قْبڒ مَا ذَاس د يڒَاغَا أَربِّـي. <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />شك مَا ذ يسْمغ وَامِي ذَاش د يڒَاغَا؟ إِيوَا بْڒَا ٱش يشْقَا مَانَايَا. وَلَكِن مڒَا غَارك لْفُرْصَا اَذ تْربْحذ لْحُرِّيَا نّش، اݣّ-يت. <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />لِأَنَّا ونِّي تُوْغَا يدْجَان ذ يسْمغ وَامِي ذَاس د يڒَاغَا سِيذِيثْنغ، نتَّا ڒخُّو غَارس يجّن ن لْحُرِّيَا زِي سِيذِيثْنغ. أَمنِّي عَاوذ ونِّي تُوْغَا يدْجَان غَارس لْحُرِّيَا، نتَّا ڒخُّو يذْوڒ ذ يسْمغ ن سِيذِيثْنغ. <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />صَافِي، يسْغِي-كنِّيو س يِجّن ن تَّمَن، وَار تَارَّام شَا يخف نْوم ذ يسمْغَان ن بْنَاذم. <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />آي اَيثْمَا، أَذ يقِّيم كُڒ يجّن ذِي لْحَالَا نِّي إِي ذِي ذَاس د يڒَاغَا أَربِّـي.<verse eid="1CO 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />فَا ڒخُّو اَذ سِّيوْڒغ خ ثْحَرْمُوْشِين وَار يمْڒِيشن شَا. وَار غَارِي بُو ڒُوْصِيّث زِي سِيذِيثْنغ؛ لَّا، قَّارغ مَانَايَا س اَرَّاي ينُو. تيّْقم ذَايِي عْلَاحْسَاب اَرَّاحْمث ن سِيذِيثْنغ. <verse eid="1CO 7:25" /><verse number="26" style="v" sid="1CO 7:26" />عْلَاحْسَاب ڒْوقْث-أَ يقسْحن، يعْنِي مْلِيح مڒَا يقِّيم بْنَاذم مَامش يدْجَا. <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />شك، مَا غَارك ثَمْغَارْث؟ وَار رزُّو شَا اَذ تْسمْحذ ذِي مَانَايَا. شك، مَا وَار غَارك بُو ثمْغَارْث؟ وَار رزُّو شَا خ ثمْغَارْث. <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />وَلَكِن شك مڒَا ثْمڒْشذ مَعْلِيش، وَار ثعْصِيذ شَا. عَاوذ ثَحَرْمُوْشْت مڒَا ثمْڒش مَعْلِيش، وَار ثعْصِي شَا. وَلَكِن يِنِّي يمڒْشن اَغَارْسن يڒِين لْمَشَاكِل ذِي دُّنشْت-أَ. نش رزُّوْغ اَخَاوم سْبعّْذغ مَانَاينِّي.<verse eid="1CO 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29" />فَا آي اَيثْمَا، مِين رزُّوْغ اَذ ينِيغ؟ ڒْوقْث اَقَا ثْقَارّب-د. سَّا ٱڒ ثْسَاونْت يِنِّي يمڒْشن اَذ عِيشن اَخْمِي وَار مْڒِيشن شَا، <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />ذ يِنِّي يتْخيَّاقن اَخْمِي وَار تْخيِّيقن شَا، ذ يِنِّي يفَرّْحن اَخْمِي وَار فَرّْحن شَا، ذ يِنِّي يسَّاغن اَخْمِي مَانَاينِّي وَار زَّايس تْملِّيكن شَا، <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />ذ يِنِّي ينفّْعن زِي دُّنشْت-أَ اَخْمِي مَانَاينِّي وَار زَّايس نفّْعن شَا. مَايمِّي؟ مِنْزِي طَّبِيعَا ن دُّنشْت-أَ وَار تْدُوْمِي شَا.<verse eid="1CO 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32" />فَا رزُّوْغ اَذ تِيڒِيم بْڒَا اَمْنُوْس. ونِّي وَار يمْڒِيشن شَا غَارس يجّن ن لْمُهِيمَا إِ شّْغڒ ن سِيذِيثْنغ، مَامّش غَا يݣّ اَخَاس يَارْضَا سِيذِيثْنغ. <verse eid="1CO 7:32" /><verse number="33‏-34" style="v" sid="1CO 7:33-34" />وَلَكِن اَرْيَاز يمڒْشن غَارس يجّن ن لْمُهِيمَا إِ شّْغڒ ن دُّنشْت-أَ، مَامّش غَا يݣّ اَخَاس ثَارْضَا ثمْغَارْث نّس. نتَّا لْمُهِيمَاث نّس فَرّْقنْت خ ثْنَاين.</para>
  <para style="p" vid="1CO 7:33-34">ثَمْغَارْث وَار يمْڒِيشن شَا ذ ثنِّي إِݣ يدْجَان ذ ثَعْزْرِيث غَارْسنْت يجّن ن لْمُهِيمَا إِ شّْغڒ ن سِيذِيثْنغ، مَامّش غَا ݣّنْت اَذ عبْذنْت سِيذِيثْنغ س دَّات نْسنْت ذ وُوْڒ نْسنْت. ثَمْغَارْث يمڒْشن غَارس يجّن ن لْمُهِيمَا إِ شّْغڒ ن دُّنشْت-أَ، مَامّش غَا ثݣّ اَخَاس يَارْضَا ورْيَاز نّس. <verse eid="1CO 7:33-34" /><verse number="35" style="v" sid="1CO 7:35" />مَانَايَا قَّارغ-ث بَاش اَكنِّيو نفْعغ، مَاشِي اَكنِّيو سْحسْڒغ. لَّا، رزُّوْغ اَذ تْعِيشم س لْمَعْقُوْل اَذ تْعبّْذم سِيذِيثْنغ مَاشِي س شَان ن لْمُهِيمَا نّغْنِي.<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />فَا ونِّي يخظْبن، مڒَا وَار يزمَّر شَا اَذ يصْبَر خ ثْحنْجِيرْث نِّي يعْنِي وَار يحكّم شَا مْلِيح خ شّهَاوَاث نّس، صَافِي يتْخصَّا-ٱس اَذ يݣّ لْوَاجِب نّس يعْنِي اَذ يمْڒش اَكِذس. مَعْلِيش نتَّا وَار يعصِّي شَا. <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />أَمَّا ونِّي يعوّْڒن مْلِيح ذݣ وُوْڒ نّس اَذ يفْسخ اَك ثنِّي إِݣ يخْظب. مڒَا يعمّذ خ مَانَايَا ذݣ وُوْڒ نّس وَار ذِنِّي حتَّا ذ شَا ن ڒْحَاجث اَخَاس ثْزيَّار يعْنِي يحكّم خ شّهْوث نّس، مَعْلِيش يݣَّا مْلِيح. <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />خ مَانَايَا ونِّي يمڒْشن اَك ثنِّي إِݣ يخْظب، مَعْلِيش يݣَّا مْلِيح. أُو ونِّي وَار كِذس يمْڒِيشن شَا، يݣَّا حْسن عَاذ.<verse eid="1CO 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39" />ثَمْغَارْث يمڒْشن نتَّاث ثقّن غَار ورْيَاز نّس مڒَا يدَّر. وَلَكِن مڒَا يمُّوْث، نتَّاث غَارس ڒْحَقّ اَذ تمْڒش اَك ونِّي ثْخس نتَّاث مڒَا <char style="it">نتَّا ذ ڒْمُوْمن</char> زِي سِيذِيثْنغ. <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />وَلَكِن مَامّش تْوَاڒِيغ نش، أَذ تْفَرح كْتَار مڒَا ثقِّيم مَامّش ثدْجَا. وَاه، تْفكَّرغ بلِّي ؤُڒَا ذ نش اَكِذِي اَرُّوْح ن أَربِّـي <char style="it">ذِي مَانَايَا</char>.<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s">أَيْسُوْم يتْقدَّامن إِ لْأَصْنَام</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />فَا لْمَكْلَا يتْقدَّامن إِ لْأَصْنَام. نشِّين مَارَّا إِذْنغ غَارْنغ ثُوْسْنَا،<note caller="+" style="f"><char style="fr" closed="false">8‏.1 </char><char style="ft" closed="false">ثُوْسْنَا نتَّاث ذ لْمَعْرِيفَا.</char></note> يعْنِي نسّن ثِمسْڒَايِين. ثُوْسْنَا-يَا إِي نسّن تْسُوْفَّا يوْذَان س تَّكبُّر، وَلَكِن ڒمْحِبّث تَرْنِي ذَايْنغ جّْهذ. <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />ئِجّن مڒَا يتْغِير-اَس يسّن، لَّا وَار يسِّين شَا. عَاذ يتْخصَّا-يَاس اَذ يسّن. <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />وَلَكِن ونِّي يتْحِبَّان أَربِّـي، أَتَاف أَربِّـي يسّن-يث نتَّا.<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />أَمَّا لْمَكْلَا يتْقدَّامن إِ لْأَصْنَام، نسّن لْأَصْنَام دْجَان ذِي دُّنشْت-أَ وَلَكِن ذ يخَرِّيقن وَاهَا. نسّن نشِّين يجّن ن أَربِّـي إِݣ يدْجَان، وَاحْذس. <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />وَاخَّا زَعْمَا قَّارن بلِّي ذِنِّي أَربِّـيثن ذݣ وجنَّا ذ ثْمُوْرْث، يعْنِي غَارْسن أَربِّـيثن نْسن مُجُوْدِين ذ سِّيَاذِيثْسن مُجُوْدِين. <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />وَلَكِن نشِّين غَارْنغ يجّن ن أَربِّـي وَاحْذس، نتَّا ذ بَابَاثْنغ. زَّايس نتَّا دْجَانْت مَارَّا ثِمسْڒَايِين، نشِّين ندْجَا إِ نتَّا. عَاوذ غَارْنغ يجّن ن سِيذِيثْنغ، يعْنِي عِيْسَى لْمَسِيح. زِي نتَّا مِيزِي خڒْقنْت مَارَّا ثِمسْڒَايِين، زَّايس مِيزِي نخْڒق نشِّين.<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />وَلَكِن مَاشِي يوْذَان قَاع سّْنن مَانَايَا. ڒبْعَاض ن يِوْذَان تُوْغَا غَارْسن لْأَصْنَام ذ دِّين نْسن يجْهذ. مڒَا تتّن لْمَكْلَا-يَا يتْقدَّامن إِ لْأَصْنَام اَتَاف يتْغِير-اَسن مَانَايَا ذ صَّح، ضَّمِير نْسن يضعْفن اَتَاف اَذ يخْنز. <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />إِيوَا مَاشِي ذ لْمَكْلَا إِي ذَانغ غَا يسْقَارّْبن غَار أَربِّـي؛ لَّا، وَار ذَانغ ينفّع شَا مڒَا نشَّا نِغ وَار نشِّي شَا. <verse eid="1CO 8:8" /><verse number="9" style="v" sid="1CO 8:9" />وَلَكِن حْضَام يخف نْوم ذِي لْحُرِّيَا-يَا نْوم ثَانِيتَا بَاش وَار ثْغطّْڒم شَا يِنِّي يضعْفن ذِي لْإِيمَان نْسن اَذ وْضَان.<verse eid="1CO 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 8:10" />شُوْف، ونِّي ؤُمِي غَار يدْجَا لْإِيمَان يضْعف. مَعْلِيك يࢲْرِي-ش شك غَارك ثُوْسْنَا زَعْمَا تتّذ ذݣ يِجّن ن زَّاوْيِث ن لْأَصْنَام، إِڒِي ثْشجّْعذ-ث شك حمَا ؤُڒَا ذ نتَّا اَذ يشّ لْمَكْلَا يتْقدَّامن إِ لْأَصْنَام، نِغ لَّا؟ <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />أُو س ثُوْسْنَا-يَا نّش زَعْمَا اَذ تْدمَّرذ ؤُمَاثْنغ وَانِيتَا يضعْفن إِي خف يمُّوْث لْمَسِيح. <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />خْمِي ثْعصِّيم اَيثْمَاثْوم تْضَرَّام ضَّمِير نْسن يضعْفن، أَتَاف ذ لْمَسِيح إِي ثْعصَّام. <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />خ مَانَايَا مڒَا لْمَكْلَا ينُو ثْغطّڒ ؤُمَا ذِي ڒْمُعْصِيّث، أَتَاف عمَّارْص اَذ شّغ اَيْسُوْم عَاوذ حمَا وَار غطّْڒغ شَا ؤُمَا.<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s">ڒْحَقّ ن شَّارْض إِي غَارْسن غَار يِنِّي يتْرَايَان خ ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />غَارِي لْحُرِّيَا <char style="it">يعْنِي نش مَاشِي ذ يسْمغ</char>. نش ذ اَرَّسُوْل، ࢲْرِيغ سِيذِيثْنغ عِيْسَى. يَاش ذ كنِّيو إِي يدْجَان ذ نَّتِيجَا ن ڒْخذْمث ينُو ذِي سِيذِيثْنغ، نِغ لَّا؟ <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />مڒَا وَار دْجِيغ ذ اَرَّسُوْل إِ شَان يِوْذَان نّغْنِي، أَتَاف إِ كنِّيو إِي غَا دْجِيغ ذ اَرَّسُوْل. لِأَنَّا كنِّيو ذ دَّلِيل يݣَّا-ٱيِي نش سِيذِيثْنغ ذ اَرَّسُوْل.<verse eid="1CO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3" />ذ وَا ذ دِّفَاع ينُو غَار يِنِّي ذَايِي يتݣّن لْإِسْتِجْوَاب. <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />يعْنِي، نشِّين مَا وَار غَارْنغ بُو ڒْحَقّ أَ نشّ أَ نْسو؟ <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />نشِّين مَا وَار غَارْنغ بُو ڒْحَقّ أَ نَاوِي اَكِذْنغ ثِمْغَارِين ڒْمُوْمِنَاث مَامّش ݣِّين اَرُّسُل نّغْنِي ذ اَيثْمَاس ن سِيذِيثْنغ ذ بُطْرُس؟ <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />مَا نش ذ بَرْنَابَا وَاحذْنغ إِي وَار غَار يدْجِي ڒْحَقّ ذِي شَّارْض، مَا يتْخصَّا-يَانغ إِ نشِّين أَ نخْذم ذِي شَان ڒْحَاجث نّغْنِي بَاش أَ نْعِيش؟<verse eid="1CO 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 9:7" />شُوْف، مَا يدْجَا شَا حَدّ اَذ يَاذف ذِي ڒْعَسْكَار اَذ يخْذم بْڒَا مَا اَذ يتْخَاڒس؟ لَّا! مَا يدْجَا شَا حَدّ اَذ يࢲُّو ثْزَايَارْث وضِيڒ بْڒَا مَا ٱذ يشّ ثِزوْرِين نّس؟ لَّا! مَا يدْجَا شَا حَدّ اَذ يَرْوس ثْحِيمرْث بْڒَا مَا اَذ يسو اَغِي نّس؟ لَّا! <verse eid="1CO 9:7" /><verse number="8" style="v" sid="1CO 9:8" />مَا قَّارغ مَانَايَا عْلَاحْسَاب اَرَّاي ن بْنَاذم وَاهَا؟ لَّا، عْلَاحْسَاب اَرَّاي ن شَّرِيعَا يقَّار كِيف-كِيف. <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" />يعْنِي يقَّار لْكِتَاب ن مُوْسَى: وَار ذَاس تݣّ بُو ثَشْمَانْت إِ وفُوْنَاس نِّي يتْصَرْوَاثن. مَا إِ يينْدُوْزن وَاهَا ؤُمِي يتِيشّ أَربِّـي لْهِمَّا؟ <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />نِغ يقَّار-يت مَارَّا عْلَاحْسَاب نشِّين؟ وَاه، ئِقَّار-يت عْلَاحْسَاب نشِّين. لِأَنَّا ونِّي يشرّْزن ذ ونِّي يصَرْوَاثن أُو لَابُد اَذ رزُّوْن اَذ شّن زِي ثْفدْجَاحْث نِّي. <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" />مڒَا تُوْغَا نزْرع جَارَاوم ثِمسْڒَايِين ن وجنَّا، مَا ذ اَطَّاس خَانغ مڒَا نمْجَار زَّايْوم ثِمسْڒَايِين ن ثْمُوْرْث؟ <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />مڒَا يوْذَان نّغْنِي غَارْسن ڒْحَقّ نِّي ن شَّارْض اَذَاسن ثُوْشم، يَاك نشِّين غَارْنغ ڒْحَقّ-أَ كْتَار نِغ لَّا؟</para>
  <para style="p" vid="1CO 9:12">وَلَكِن نشِّين نُوْݣِي أَ نْكسِّي ڒْحَقّ-أَ وَانِيتَا. نْصبَّر اَطَّاس إِ ثْمسْڒَايِين بَاش وَار نتْبلَّاع شَا ثَوَّارْث إِ لِإِنْجِيل. <verse eid="1CO 9:12" /><verse number="13" style="v" sid="1CO 9:13" />مَا وَار ثسِّينم شَا يِنِّي يخدّْمن ذِي ثمْزِيذَا كسِّين-د لْمَكْلَا نْسن زَّايس، ذ يِنِّي يخدّْمن ذِي ڒْمذْبَاح كسِّين-د ڒْحَقّ نْسن زِي مِين يتْوَاغَرّْصن ذِي ڒْمذْبَاح؟ <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" />أَمنِّي ؤُڒَا ذ يِنِّي يتْبشَّارن س لْإِنْجِيل، يُوْمَر خَاسن سِيذِيثْنغ اَذ كسِّين شَّارْض نْسن زِي لْإِنْجِيل.<verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />وَلَكِن نش وَار كْسِيغ شَا ؤُڒَا ذ يجّن زِي ڒْحُقُوْق نِّي. عَاوذ نش وَار تَارِيغ شَا ثَبْرَات-أَ ڒخُّو حمَا اَتَاف كنِّيو اَذَايِي ثُوْشم ڒْحُقُوْق نِّي؛ لَّا، نش حْسن مڒَا مُّوْثغ قْبڒ مَا ٱذَايِي يكّس حَدّ مَانَايَا مِينْزِي غَا فْتَخْرغ. <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />وَلَكِن مڒَا تْبشَّارغ، وَار زمَّرغ اَذ فْتَخْرغ لِأَنَّا يتْخصَّا-ٱيِي أُو لَابُد اَذ بشَّرغ. يَا تَمَارَا خَافِي نش مَعْلِيك وَار تْبشَّارغ شَا! <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />مڒَا بشَّرغ س ڒْخَاضَر ينُو، أَتَاف اَذَايِي يجَازَا <char style="it">أَربِّـي</char>. مڒَا وَار يدْجِي بُو س ڒْخَاضَر ينُو، يعْنِي اَتَاف تݣّغ يجّن ن لْمسْؤُلِيَا بزّز خَافِي وَاهَا. <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />إِذن، مِين يعْنَا شَّارْض ينُو؟ شَّارْض ينُو ذ وَا: خْمِي تْبشَّارغ س لْإِنْجِيل تْقدَّامغ-ث بَاطڒ يعْنِي مَاشِي عْلَاحْسَاب ڒْحَقّ ن شَّارْض-أَ إِي غَارِي ذِي لْإِنْجِيل.<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />وَاخَّا نش وَار غَارِي بُو بَاب ينُو، وَلَكِن أَرِّيغ يخف ينُو ذ يسْمغ زَعْمَا إِ مَارَّا بَاش اَذ ربْحغ اَطَّاس ن زِّيَادَا ن يِوْذَان. <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />نش اَرِّيغ يخف ينُو اَم يِجّن ذ اَئِسْرَائِيلِي غَار أَيث-إِسْرَائِيل بَاش اَتَاف اَثن ربْحغ. أَرِّيغ يخف ينُو اَم يِجّن مِينْخف ثْحكّم شَّرِيعَا ن مُوْسَى غَار يِنِّي مِينْخف ثْحكّم شَّرِيعَا ن مُوْسَى بَاش اَتَاف اَثن ربْحغ (وَاخَّا نش وَار خَافِي ثْحكّم شَا شَّرِيعَا نِّي). <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />أَرِّيغ يخف ينُو اَم يِجّن وَار غَارس ثدْجِي شَا شَّرِيعَا ن مُوْسَى غَار يِنِّي وَار غَارْسن ثدْجِي شَا شَّرِيعَا ن مُوْسَى بَاش اَتَاف اَثن ربْحغ (وَاخَّا نش وَار دْجِيغ شَا بْڒَا شَّرِيعَا ن أَربِّـي، ثْحكّم خَافِي شَّرِيعَا ن لْمَسِيح). <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />أَرِّيغ يخف ينُو اَم يِجّن يضْعف غَار يِنِّي يضعْفن بَاش اَتَاف اَثن ربْحغ. أَرِّيغ يخف ينُو ذ مَارَّا إِ مَارَّا يوْذَان بَاش اَذ ݣّغ مَارَّا لْإِمْكَانِيَاث اَذ سْنجْمغ شَا زَّايْسن. <verse eid="1CO 9:22" /><verse number="23" style="v" sid="1CO 9:23" />نش تݣّغ مَارَّا مَانَايَا عْلَاحْسَاب لْإِنْجِيل حمَا اَذ شَرْشغ ذِي لْبَرَكَاث نّس.<verse eid="1CO 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24" />مَا وَار ثسِّينم شَا ثَازْڒَا نِّي يتݣّن ذِي لْملْعَب؟ مَارَّا تَازّْڒن وَلَكِن يجّن وَاهَا إِي غَا يربْحن لْجَائِزَا. أَمنِّي ؤُڒَا ذ كنِّيو يتْخصَّا اَذ تَازْڒم بَاش اَت ثْربْحم. <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />مَارَّا يِنِّي يتمْعَانَاذن ذِي لْملْعَب حكّْمن خ دَّات نْسن ذِي مَارَّا ثِمسْڒَايِين-أَ. تݣّن مَانَايَا بَاش اَذ د اَوِين يجّن ن تَّاج وَار ذَاسن يتْدُوْمِي شَا. وَلَكِن نشِّين نْتݣّ مَانَايَا بَاش أَ د نَاوِي يجّن ن تَّاج يتْدُوْمَان إِ ڒبْدَا. <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />خ مَانَايَا وَار تِيزّْڒغ شَا بْڒَا لْإِتِجَاه، وَار شِّيثغ شَا س ڒْبُوْكْس اَم ونِّي يشَّاثن ذِي لْهَوَا وَاهَا. <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />لَّا، تْزيَّارغ خ دَّات ينُو تَارِّيغ-ت ذ ثِيسْمغْث ينُو. مَاشِي اَذ بشَّرغ اَوَاڒ إِ يِوْذَان أُو <char style="it">غَار ونݣَّارُو</char> اَذ يڒِيغ اَك يِنِّي إِي ثن يسُوْفُوْغن بْڒَا لْجَائِزَا.<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s">ثَغنَّانْت ن أَيث-إِسْرَائِيل نتَّاث ذ يجّن ن لْعِبْرَا إِ نشِّين</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />شُوْف آي اَيثْمَا، وَار خْسغ شَا اَذ تتُّوْم بلِّي ڒجْذُوْذ نّغ تُوْغَاثن قَاعِين سْوَادَّاي إِ وسيْنُو<note caller="+" style="f"><char style="fr" closed="false">10‏.1 </char><char style="ft" closed="false">أَيث-إِسْرَائِيل وَامِي اَروْڒن زِي مِصْرَا، سِيذِي أَربِّـي يݣُّوْر غَار زَّاث نْسن اَمشْنَاو يج وسيْنُو. أَسيْنُو نِّي تُوْغَاث اَم يِجّن ن وپِـيلَار يسظْهَار-اَسن-د اَبْرِيذ س وزِيڒ. س دْجِيڒث تُوْغَاث اَمشْنَاو يجّن ن ثْمسِّي، ثِمسِّي نِّي تݣّ-اَسن ثْفَاوْث حمَا اَذ ؤُيُوْرن س دْجِيڒث ذ وزِيڒ. أَسيْنُو نِّي ذ ثْمسِّي نِّي س ثْنَاين إِذْسن تُوْغَاثن قِّيمن ذِنِّي ڒبْدَا غَار زَّاث إِ أَيث-إِسْرَائِيل.</char></note> نِّي يحطَّا-ثن. مَارَّا نِثْنِي ࢲْوَان غَار ؤُجمَّاض-ين ن ڒبْحَر اَزݣّْوَاغ.<note caller="+" style="f"><char style="fr" closed="false">10‏.1 </char><char style="ft" closed="false">وَامِي اَروْڒن أَيث-إِسْرَائِيل زِي مِصْرَا، ؤُوْضن غَار ڒبْحَر اَزݣّْوَاغ اَبْرِيذ نْسن يبلّع عْڒَاين اَخَاسن د حڒْثن ڒْعَسْكَار ن مِصْرَا. ڒخْدّنِّي يكَّر سِيذْنَا مُوْسَى يسَرّح فُوْس نّس غَار وجنَّا ن ڒبْحَر نِّي يسّكّ-د سِيذِي أَربِّـي اَسمِّيض ذ شَّرْقِي يجْهذ يَارَّا ڒبْحَر اَڒ ثْشَرْمِين، س دْجِيڒث نِّي يَارِّي-ث ذ ثَمُوْرْث ثُوْزغ. ئِقِّيم ڒبْحَر نِّي ينْفْرق خ ثْنَاين، ࢲْوَان أَيث-إِسْرَائِيل ذِي ڒْوسْط خ ثْمُوْرْث نِّي يُوْزْغن. أَمَان ذوْڒن اَمشْنَاو ثْنَاين ن ڒحْيُوْض يجّن خ وࢲڒْمَاض يجّن خ وفُوْسِي. </char></note> <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />مَارَّا نِثْنِي تْوَاطهَّارن س وَامَان عْلَاحْسَاب مُوْسَى وَامِي عْذُوْن ذݣ وسيْنُو نِّي ذ ڒبْحَر نِّي. <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />مَارَّا نِثْنِي شِّين زݣ يِجّن ن لْمَكْلَا رُوْحِيَا. <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />مَارَّا نِثْنِي سْوِين زݣ يِجّن ن ثْسسِّي رُوْحِيَا. لِأَنَّا نِثْنِي سْوِين زݣ وغْبَاڒ نِّي ن وزْرُو<note caller="+" style="f"><char style="fr" closed="false">10‏.4 </char><char style="ft" closed="false">أَيث-إِسْرَائِيل وَامِي صَافِي اَروْڒن زِي مِصْرَا قِّيمن ؤُݣُّوْرن ذِي ڒخْڒَا، وَار ؤُفِين مِين غَا سْون قِّيمن يوْذَان تْشثْشَان خ سِيذِي أَربِّـي ذ سِيذْنَا مُوْسَى. ئِيْسِي سِيذْنَا مُوْسَى ثَغْرِيث نّس زَّاث إِ سِيذِي أَربِّـي مَامّش ث يُوْمَر. ئِكَّر سِيذْنَا مُوْسَى ذ ؤُمَاس هَارُوْن يجْمع-د شَّعْب زَّاث إِ يِجّن ن وزْرُو ذ اَمقّْرَان ينَّا-ٱسن سِيذْنَا مُوْسَى: "صنّْطم آ يِنِّي وَار يتݣّن شَا اَرَّاي إِ أَربِّـي، مَا يتْخصَّا-يَانغ اَذَاوم د نْسُوْفغ اَمَان زݣ وزْرُو-يَا؟" ڒخْدّنِّي يسِيڒِي سِيذْنَا مُوْسَى فُوْس نّس يُوْوْثَا اَزْرُو نِّي مَرّْثَاين يذْوڒ ذ اَغْبَاڒ. دُوْقْزن زَّايس وَامَان اَطَّاس، سْوِين شَّعْب ذ ڒكْسِيبث نْسن زݣ وغْبَاڒ ن وَامَان نِّي.</char></note> رُوْحِيَا إِي ثن يذفَّارن، أَغْبَاڒ نِّي ن وزْرُو تُوْغَاث نتَّا ذ لْمَسِيح. <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />وَاخَّا اَمنِّي ڒبْعَاض زَّايْسن وَاهَا مِيخف يَارْضَا أَربِّـي، ينّغْنِي منْضَارن ذِنِّي ذ يمُّوْرْضَاس ذِي ڒخْڒَا نِّي.<verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />ثِمسْڒَايِين-أَ وقْعنْت ذ يجّن ن لْعِبْرَا إِ نشِّين. مَايمِّي؟ بَاش وَار ذَايْنغ يتِيڒِي مزْڒِي خ شَّرّْ مَامّش تُوْغَا شهَّان نِثْنِي. <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />وَار عبّْذث شَا لْأَصْنَام مَامّش ݣِّين ڒبْعَاض زَّايْسن. مَامّش يقَّار لْكِتَاب: &lt;ئِوْذَان نِّي قِّيمن اَذ سْون اَذ شّن، أُوْشَا كَّرن اَذ زْهُوْن.&gt; <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />ئِتْخصَّا وَار نْفسّذ شَا مَامّش ݣِّين ڒبْعَاض زَّايْسن، مُّوْثن وْضَان غَار ثْمُوْرْث شَان ثْڒَاثَا أُو عِشْرِين اَڒَاف زَّايْسن ذݣ يِجّن ن نْهَار. <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />ئِتْخصَّا وَار نْزعّم شَا أَ نْࢲر مِين غَا يݣّ لْمَسِيح، مَامّش ݣِّين ڒبْعَاض زَّايْسن أُوْشَا تْوَانْغن س يفِيغرَان. <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />ئِتْخصَّا وَار نتْشثْشَا شَا مَامّش ݣِّين ڒبْعَاض زَّايْسن وَامِي خَاسن يقْضَا عَزْڒَاين.<verse eid="1CO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11" />وقْعنْت-اَسن ثِمسْڒَايِين-أَ ذ يجّن ن لْعِبْرَا إِ نشِّين. زمّْمن-ثنْت حمَا اَزَّايْسنْت نڒْمذ نشِّين، يعْنِي خضْڒنْت-يد خَانغ اَڒ ونݣَّارُو-يَا ن زْمَانَاث. <verse eid="1CO 10:11" /><verse number="12" style="v" sid="1CO 10:12" />س مَانَايَا ونِّي ؤُمِي يتْغِيڒ-اَس قَا يبدّ وَار يوطِّي شَا، ئِتْخصَّا-يَاس اَذ د يَارّ ڒْبَاڒ نّس. <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />ثِمسْڒَايِين نِّي ثِنِّي إِݣ يتِيڒِين ڒبْدَا اَك بْنَاذم ذ ثِنِّي إِي كنِّيو يتْغَارَّان. أُو أَربِّـي نتَّا ذَايس تِّقث، وَار كنِّيو يتجِّي شَا اَذ تْوَاغَارَّام س مِين وَار ثْزمَّرم اَذ تصْبَرم؛ لَّا، أَذَاوم يذبَّر يجّن ن ثوَّارْث حمَا اَذ تصْبَرم إِ مَانَاينِّي.<verse eid="1CO 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />س مَانَاينِّي آي يمْعِيزّن ينُو، اَروْڒث زِي لْأَصْنَام. <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />سَّاوَاڒغ اَكِذْوم غَارْوم ڒَعْقڒ نْوم، ميّْزث مِين قَّارغ مَا ذ صَّح مَا لَّا. <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" />ڒْكَاس نِّي ن لْبَرَكَا إِي زِي نتْبَرَاك نشِّين، زَّايس إِي نْشَرّش ذݣ يذَامّن ن لْمَسِيح. أَغْرُوْم نِّي إِي نتْرزَّا، زَّايس إِي نْشَرّش ذِي دَّات ن لْمَسِيح. <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />ذِنِّي يجّن ن ثْخبَّاسْت ن وغْرُوْم وَاحْذس، س سَّبَاب-أَ نشِّين ذ يجّن، وَاخَّا ذِنِّي اَطَّاس إِي إِذْنغ. مِينْزِي نشِّين مَارَّا إِذْنغ نْشَرّش ذݣ يِجّن ن ثْخبَّاسْت. <verse eid="1CO 10:17" /><verse number="18" style="v" sid="1CO 10:18" />فكَّرث ذِي أَيث-إِسْرَائِيل، يَاك يِنِّي يتتّن دْبِيحَاث نِثْنِي شَرّشن ذِي ڒْمذْبَاح نِّي، نِغ لَّا؟ <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />مِين خْسغ نش اَذ ينِيغ؟ مَا قَّارغ بلِّي لْمَكْلَا نِّي يتْقدَّامن إِ لْأَصْنَام نتَّاث ذ شَا ن ڒْحَاجث؟ نِغ قَّارغ بلِّي لْأَصْنَام نِثْنِي ذ شَا ن ڒْحَاجث؟ <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />لَّا، وَلَكِن قَّارغ بلِّي مِين غَرّْصن لْكُفَّار ذ دْبِيحَاث تْقدَّامن-ثنْت إِ شَّيَاطِين مَاشِي إِ أَربِّـي. نش وَار خْسغ شَا اَكِذْسن ثْشَرْشم اَك شَّيَاطِين. <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />وَار ثْزمَّرم شَا اَذ تسْوم زِي ڒْكَاس ن سِيذِيثْنغ نِغ زِي ڒْكَاس ن شَّيَاطِين س ثْنَاين إِذْسن. وَار ثْزمَّرم شَا اَذ تْشَرْشم ذِي مِيسَّا ن سِيذِيثْنغ ذ مِيسَّا ن شَّيَاطِين س ثْنَاين إِذْسنْت. <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />مَا نْرزُّو أَ نسْعصّب سِيذِيثْنغ س لْغِرَا؟ نِغ مَا نجْهذ خَاس نشِّين؟<verse eid="1CO 10:22" /></para>
  <para style="s">لْحُرِّيَا ن ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />مَارَّا ثِمسْڒَايِين حدْجْڒنْت، وَلَكِن مَاشِي مَارَّا ثِمسْڒَايِين تسْتنْفَاعنْت. مَارَّا ثِمسْڒَايِين حدْجْڒنْت، وَلَكِن مَاشِي مَارَّا ثِمسْڒَايِين اَذَانغ سْجهْذنْت. <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />وَار رزُّوْث شَا ڒْخِير إِ يِيخف نْوم، رْزُوْم-ث إِ وَاجَّار نْوم. <verse eid="1CO 10:24" /><verse number="25" style="v" sid="1CO 10:25" />شّث مِين مَا ثُوْفِيم يتْمنْزَا ذِي سُّوْق ن يݣزَّارن، وَار تْسقْسَام شَا جّث ضَّمِير نْوم مرْتَاح. <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />لِأَنَّا <char style="it">يقَّار</char>: &lt;ثَمُوْرْث-أَ نتَّاث ذ مَارَّا مِين ذَايس ن سِيذِي أَربِّـي.&gt;<verse eid="1CO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27" />مڒَا شَان يِجّن مَاشِي ذ ڒْمُوْمن يعَرض-يكنِّيو بَاش اَذ تشّم اَكِذس أُو كنِّيو ثْرزُّوْم اَذ تْرَاحم، شّث مِين مَا ثُوْفِيم سرْسن-ت زَّاث نْوم وَار تْسقْسَام شَا، جّث ضَّمِير نْوم مَرْتَاح. <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />وَلَكِن مڒَا ينَّا-ٱوم حَدّ قَا مَانَايَا قدّْمن-ث ذ دْبِيحث إِ لْأَصْنَام، وَار ت تتّم شَا. مَانَايَا عْلَاحْسَاب ونِّي إِي ذَاوم ث يقَّارن أُو عْلَاحْسَاب ضَّمِير. <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />يعْنِي ضَّمِير ن ونِّي إِي كنِّيو يعَرْضن، مَاشِي ذ ضَّمِير نْوم. ڒَاحقَّاش نش مَايمِّي ضَّمِير ن يِجّن نّغْنِي اَذ يحْكم خ لْحُرِّيَا ينُو؟ <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />مڒَا شكَّرغ أَربِّـي خ شَان لْمَكْلَا، مَايمِّي إِي ذَايِي غَا حَاسْبن خ مَانَاينِّي إِي زِي شكَّرغ أَربِّـي؟<verse eid="1CO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31" />إِذن، مڒَا ثْسسّم نِغ تتّم نِغ مِين مَا تݣّم، ݣّث مَارَّا مَانَاينِّي بَاش اَذ يتْوَاسمْغَار أَربِّـي. <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />وَار غطّْڒث حَدّ وَاخَّا نِثْنِي ذ يسْرَائِيْلِيْين نِغ ذ ييُوْنَانِيْين نِغ ذ جْمَاعث ن ڒْمُوْمِنِين ن أَربِّـي. <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />نش رزُّوْغ اَذ سَارْضِيغ مَارَّا يوْذَان ذِي مَارَّا مِين تݣّغ. وَار رزُّوْغ شَا ڒْخِير إِ يِيخف ينُو، رزُّوْغ-ث إِ مَارَّا يوْذَان بَاش اَذ نجْمن.<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="s">ڒْمُوْمِنَاث ذِي لْعِبَادَا</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />ذفَّارم-اَيِي-د مَامّش ذفَّارغ نش لْمَسِيح. <verse eid="1CO 11:1" /><verse number="2" style="v" sid="1CO 11:2" />فَا تْشكَّرغ-كنِّيو وَامِي تعْقَاڒم خَافِي ذِي مَارَّا ثِمسْڒَايِين، ثْحفّْظم تَّعْلِيم نِّي مَامّش ذَاوم ث سڒْمَاذغ نش.<verse eid="1CO 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 11:3" />وَلَكِن خْسغ اَكنِّيو سْفهْمغ مْلِيح قَا اَزدْجِيف ن مْكُڒ اَرْيَاز نتَّا ذ لْمَسِيح <char style="it">أُو ذ نتَّا إِݣ يتْرَايَان</char>. أَزدْجِيف ن مْكُڒ ثَمْغَارْث نتَّا ذ اَرْيَاز <char style="it">أُو ذ نتَّا إِݣ يتْرَايَان</char>. أَزدْجِيف ن لْمَسِيح نتَّا ذ أَربِّـي <char style="it">أُو ذ نتَّا إِݣ يتْرَايَان</char>. <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />مْكُڒ اَرْيَاز إِݣ يتْࢲَادْجَان نِغ يسَّاوَاڒ س مِين يعْڒم زِي أَربِّـي اَزدْجِيف نّس يغمّس، أَتَاف نتَّا وَار يتْوقَّر شَا اَزدْجِيف نّس. <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />مْكُڒ ثَمْغَارْث يتْࢲَادْجَان نِغ ثسَّاوَاڒ س مِين ثعْڒم زِي أَربِّـي اَزدْجِيف نّس وَار يغمّس شَا، أَتَاف نتَّاث وَار تْوقَّر شَا اَزدْجِيف نّس. ئِتْوَاحْسَاب اَخْمِي اَزدْجِيف نّس يتْوَاحفّ ذ اَقشَّار. <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />ثَمْغَارْث مڒَا ثُوْݣِي اَذ تغْمس إِ وزدْجِيف نّس حْسن مڒَا ثْحفّ اَشوَّاف نّس. وَلَكِن ذ يجّن ن ڒفْضِيحث ثَمْغَارْث مڒَا ثْحفّ نِغ ثذْوڒ ذ ثَقشَّارْث، يعْنِي يتْخصَّا-يَاس اَذ تغْمس إِ وزدْجِيف نّس. <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" />شُوْف، أَرْيَاز يتْخصَّا-يَاس وَار يغمّس شَا إِ وزدْجِيف نّس لِأَنَّا نتَّا ذ صِّفث ذ شّنْعث ن أَربِّـي، ثَمْغَارْث نتَّاث ذ شّنْعث ن ورْيَاز. <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />أَرْيَاز وَار د يتْوَاخْڒِيق شَا زِي ثمْغَارْث. لَّا، ثَمْغَارْث إِي د يتْوَاخڒْقن زݣ ورْيَاز.<note caller="+" style="f"><char style="fr" closed="false">11‏.8 </char><char style="ft" closed="false">ئِسَّاوَاڒ ذَانِيتَا خ سِيذْنَا آدَم ذ حَوَّا. ئِسُوضص سِيذِي أَربِّـي آدَم، ئِكّس-اَس يجّن ن يِيغس زݣ وغزْذِيس. ئِغس نِّي يارِّي-ث سِيذِي أَربِّـي ذ ثَمْغَارْث قَّارن-اَس حَوَّا. زِي سّنِّي يُوْوِي-ت أَربِّـي غَار سِيذْنَا آدَم. </char></note> <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />عَاوذ اَرْيَاز وَار د يتْوَاخْڒِيق شَا إِ ثمْغَارْث. لَّا، ثَمْغَارْث إِي د يتْوَاخڒْقن إِ ورْيَاز.<note caller="+" style="f"><char style="fr" closed="false">11‏.9 </char><char style="ft" closed="false">خْزَر إِمزْوُوْرَا 2‏:18، "ئِكَّر أَربِّـي يفكَّر ينَّا: وَار ثعدّڒ اَذ جّغ آدَم وَاحْذس، ئِتْخصَّا اَذَاس ݣّغ وِي ث غَا يعَاوْنن اَث يعَاشَر."</char></note> <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />س مَانَاينِّي أُو عْلَاحْسَاب لْمَلَائِكَاث يتْخصَّا-يَاس إِ ثمْغَارْث اَغَارس ثِيڒِي يجّن ن لْعَلَامَا ن سُّلْطَا خ وزدْجِيف نّس.<verse eid="1CO 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 11:11" />إِنَّمَا، ذِي سِيذِيثْنغ ثَمْغَارْث تَعْتَامَاد خ ورْيَاز، أَرْيَاز يتَعْتَامَاد خ ثمْغَارْث. <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />لِأَنَّا مَامّش ثخْڒق ثمْغَارْث زݣ ورْيَاز، أَمنِّي ڒخُّو اَرْيَاز يخدْجق-د زِي ثمْغَارْث. أُو مَارَّا زِي أَربِّـي. <verse eid="1CO 11:12" /><verse number="13" style="v" sid="1CO 11:13" />حكْمث س يِيخف نْوم. مَا مَعْقُوْل ثَمْغَارْث اَذ تࢲَّادْجْ إِ أَربِّـي بْڒَا مَا ٱذ تغْمس إِ وزدْجِيف نّس؟ <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />يَاك دُّنشْت-أَ س يِيخف نّس ثْسڒْمَاذ-يكنِّيو، أَرْيَاز مڒَا يجَّا اَشوَّاف ذ اَزيْرَار ذ ڒْعِيب نِغ لَّا؟ <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />وَلَكِن ثَمْغَارْث مڒَا ثجَّا اَشوَّاف ذ اَزيْرَار نتَّا ذ يجّن ن شَّان نّس. لِأَنَّا اَشوَّاف نّس اَزيْرَار يمُّوْش-اَس بَاش اَزَّايس ثغْمس إِ وزدْجِيف نّس. <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />مڒَا ذِنِّي شَان يِجّن يرْزُو اَذ يمْغَانّن خ مَانَايَا، نشِّين وَار ننُّوْم شَا شَان لْعَادَا نّغْنِي، ؤُڒَا ذ ثِجُمَاع ن ڒْمُوْمِنِين ن أَربِّـي وَار نُّوْمنْت شَا شَان ڒْحَاجث نّغْنِي.<verse eid="1CO 11:16" /></para>
  <para style="s">أَمنْسِي ن سِيذِيثْنغ</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />نش تْوصِّيغ-كنِّيو، ڒخُّو وَار كنِّيو تْشكَّرغ شَا. ڒَاحقَّاش ثِجُمَاع نْوم تْضَرَّانْت كْتَار زِي مِين كنِّيو نفّْعنْت. <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />ذ اَمزْوَارُو، خْمِي تْمُوْنم جْمَاعث ن ڒْمُوْمِنِين تسْڒِيغ بلِّي تِيڒِين جَارَاوم لْخِلَافَاث، أُو نش تَامْنغ مَانَايَا إِلَّا ذَايس شْوَايْت ن صَّح. <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />ڒَاحقَّاش وَا لَابُد اَذ يڒِين لْخِلَافَاث جَارَاوم بَاش اَذ د بَانن يِنِّي يدْجَان نِيشَان جَارَاوم. <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />خْمِي تْمُوْنم كنِّيو، مَا تتّم اَمنْسِي ن سِيذِيثْنغ <char style="it">نِيشَان</char>؟ لَّا، وَالُو. <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />مَايمِّي؟ لِأَنَّا كُڒ يجّن مِين يتݣّ: ئِجّن يتْرَاح يتتّ وَاهَا بْڒَا مَا ٱذ يرَاجَا ونِّي نّغْنِي، ئِجّن يدْجُوْز، ئِجّن يسسّ اَطَّاس ن وَامَان وضِيڒ. <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />شُوْف، مَا وَار غَارْوم بُو ثُوْذْرِين مَانِي إِي غَا ثشّم نِغ ذ مَانِي إِ غَا ثسْوم؟ كنِّيو، مَا تْسحْقَارم جْمَاعث ن ڒْمُوْمِنِين ن أَربِّـي تْحݣَّرم يِنِّي وَار غَار يدْجِي وَالُو؟ مِين ذَاوم غَا ينِيغ؟ مَا كنِّيو إِي غَا شكَّرغ خ مَانَايَا؟ لَّا، وَالُو.<verse eid="1CO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23" />شُوْف، نش اَقَا مِين ذَايِي يُوْشَا سِيذِيثْنغ أُو ذ مَانَايَا إِي ذَاوم د سِّيوْضغ يعْنِي ذِي دْجِيڒْث نِّي إِي ذِي يمّنْز سِيذِيثْنغ عِيْسَى ييْسِي-د نتَّا اَغْرُوْم، <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />وَامِي يشكَّر أَربِّـي يرز-يث ينَّا: "ذ وَا إِݣ يدْجَان ذ دَّات ينُو إِي غَا يمُّوْشن عْلَاحْسَاب كنِّيو. تݣّث مَانَايَا حمَا اَذَايِي تْفكَّرم." <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />أَمُّو عَاوذ وَامِي كمّْڒن اَمنْسِي، ييْسِي-د نتَّا ڒْكَاس نِّي، ينَّا: "ڒْكَاس-أَ ذ ڒْعَهذ ذ جْذِيذ إِي كِذْوم تݣّغ س يذَامّن<note caller="+" style="f"><char style="fr" closed="false">11‏.25 </char><char style="ft" closed="false">ئِذَامّن نتَّا ذ دّم.</char></note> ينُو. تݣّث مَانَايَا مڒْمِي مَا ث ثسْوِيم حمَا اَذَايِي تْفكَّرم." <verse eid="1CO 11:25" /><verse number="26" style="v" sid="1CO 11:26" />مِينْزِي مڒْمِي مَا ثشِّيم زݣ ؤُغْرُوْم-أَ ثسْوِيم زِي ڒْكَاس-أَ، أَقَا تْخبَّرم س ڒْموْث ن سِيذِيثْنغ اَڒ د غَا يَاس.<verse eid="1CO 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 11:27" />أَقَا ونِّي إِي غَا يشّن زݣ وغْرُوْم-أَ ن سِيذِيثْنغ نِغ ذ ونِّي إِي غَا يسْون زِي ڒْكَاس-أَ وَار ذَاسن يتِيشّ شَا لْقِيمَا، أَتَاف نتَّا يتݣّ ڒْمُعْصِيّث ذ ثَمقّْرَانْت اَك دَّات ذ يذَامّن ن سِيذِيثْنغ. <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />إِيوَا يتْخصَّا-يَاس إِ بْنَاذم اَذ يرَاجع يخف نّس قْبڒ مَا ٱذ يشّ زݣ وغْرُوْم-أَ، قْبڒ مَا ٱذ يسو زِي ڒْكَاس-أَ. <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />أَقَا ونِّي يتتّن يسسّن بْڒَا مَا ٱذ يعْقڒ نِيشَان خ دَّات <char style="it">ن سِيذِيثْنغ</char>، أَتَاف يتتّ يسسّ لْعِقَاب إِ يِيخف نّس. <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />س مَانَاينِّي ذِنِّي اَطَّاس جَارَاوم إِݣ يدْجَان ضعْفن هڒْشن، شَان ڒبْعَاض زَّايْوم مُّوْثن. <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />مَعْلِيك نْحكّم خ يِيخف نّغ نِيشَان، أَتَاف نشِّين وَار نتْوَاحْكَام شَا. <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />خْمِي خَانغ يتَاحْكَام سِيذِيثْنغ يعْنِي ينهَّا-يَانغ بَاش وَار نْكسِّي شَا لْعِقَاب ن دُّنشْت-أَ.<verse eid="1CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33" />خ مَانَايَا آي اَيثْمَا، خْمِي تْمُوْنم اَذ تشّم رَاجَاث اَيَاوْيَا. <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />شَان يِجّن مڒَا يدْجُوْز، ئِتْخصَّا-يَاس اَذ يشّ ذِي ثدَّارْث نّس بَاش خْمِي غَا ثْمُوْنم اَتَاف وَار كنِّيو يتْحِسِّيب شَا أَربِّـي. خْمِي د غَا اَسغ نش اَتَاف اَكنِّيو وصِّيغ خ ثْمسْڒَايِين نِّي نّغْنِي.<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s">أَرُّوْح يقدّْسن يتِيشّن لْقُدْرَاث إِ ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />فَا اَمَّا لْقُدْرَاث رُوْحِيَاث. آي اَيثْمَا، وَار خْسغ شَا اَخَاسنْت تْقفَاڒم يخف نْوم. <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />قَا ثسّْنم بلِّي وَامِي تُوْغَا كنِّيو ذ لْكُفَّار تْوَاسُوْفْغم زݣ وبْرِيذ غَار لْأَصْنَام يزيْنُوْنن. <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />س مَانَاينِّي خْسغ اَذ تْفهّْمم مْلِيح بلِّي وَار ذِنِّي حَدّ اَذ يِينِي س أَرُّوْح ن أَربِّـي &lt;قَا عِيْسَى يتْوَانْعڒ&gt;! عَاوذ وَار ذِنِّي حَدّ اَذ يِينِي &lt;قَا عِيْسَى ذ مَوْلَانَا&gt; إِلَّا س أَرُّوْح يقدّْسن.<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />فَا ذِنِّي لْأَنْوَاع ن لْقُدْرَاث، وَلَكِن أَرُّوْح ذ يجّن. <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />ذِنِّي لْأَنْوَاع ن لْمسْؤُلِيَاث، وَلَكِن سِيذِيثْنغ ذ يجّن. <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />ذِنِّي لْأَنْوَاع ن ڒخْذَايم، وَلَكِن أَربِّـي ذ يجّن ذ نتَّا إِي ثنْت يسْخدَّامن مَارَّا ذِي كُڒ بْنَاذم. <verse eid="1CO 12:6" /><verse number="7" style="v" sid="1CO 12:7" />ئِمُّوْش-اَس إِ كُڒ يجّن إِي زِي غَا يسْمظْهَار ڒْخذْمث ن أَرُّوْح يقدّْسن بَاش اَذ ينْفع مَارَّا يوْذَان. <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />ئِجّن يمُّوْش-اَس س وفُوْس ن أَرُّوْح يقدّْسن بَاش اَذ يسِّيوڒ س لْحِكْمَا. ئِجّن يمُّوْش-اَس اَوَاڒ ن ثُوْسْنَا<note caller="+" style="f"><char style="fr" closed="false">12‏.8 </char><char style="ft" closed="false">ثُوْسْنَا نتَّاث ذ لْمَعْرِيفَا.</char></note> س وفُوْس ن أَرُّوْح-أَ وَانِيتَا. <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />ئِجّن يمُّوْش-اَس لْإِيمَان يجْهذ س وفُوْس ن أَرُّوْح-أَ وَانِيتَا. ئِجّن مُّوْشنْت-اَس شَان لْقُدْرَاث بَاش اَذ يسْݣنْفَا س وفُوْس ن أَرُّوْح-أَ وَانِيتَا. <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />ئِجّن يمُّوْش-اَس اَذ يݣّ لْمُعْجِيزَاث. ئِجّن يمُّوْش-اَس اَذ يسِّيوڒ س مِين يعْڒم زِي أَربِّـي. ئِجّن مُّوْشنْت-اَس ثِزمَّار اَذ يميّز جَار ن اَرُّوْحَاث. ئِجّن يمُّوْش-اَس اَذ يسِّيوڒ س ڒبْعَاض ن لُّغَاث رُوْحِيَاث. ئِجّن يمُّوْش-اَس اَذ يسْتَرْجم لُّغَاث نِّي. <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />مَارَّا ثِمسْڒَايِين-أَ ثِيْنَا تْوَاسْخدَّامنْت س وفُوْس ن يِجّن ن أَرُّوْح وَانِيتَا. ئِفَرق-يثنْت إِ كُڒ يجّن وَاحْذس مَامّش يخس نتَّا.<verse eid="1CO 12:11" /></para>
  <para style="s">مَارَّا نشِّين ذ يجّن ن دَّات ذِي لْمَسِيح</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />شُوْف، دَّات نّغ نتَّاث ذ يشْتن غَارس اَطَّاس ن طْرُوْفَاث، وَاخَّا طْرُوْفَاث-أَ اَطَّاس إِي يدْجَان نِثْنِي ذ يجّن. أَمُّو يدْجَا لْمَسِيح. <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />لِأَنَّا نشِّين مَارَّا نتْوَاطهَّار س وَامَان س يِجّن ن أَرُّوْح بَاش أَ نِيڒِي ذ يجّن ن جْمَاعث، يعْنِي أَيث-إِسْرَائِيل نِغ ذ ييُوْنَانِيْين، ذ يِنِّي غَار يدْجَا بَاب نْسن نِغ ذ يِنِّي غَار ثدْجَا لْحُرِّيَا نْسن. نشِّين مَارَّا إِذْنغ يُوْشَا-ٱنغ أَ نْسو <char style="it">يعْنِي أَ نْشَرش</char> ذݣ يِجّن ن أَرُّوْح.<verse eid="1CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14" />ڒخُّو شُوْف، دَّات وَار غَارس شَا يجّن ن طَّارْف وَاهَا؛ لَّا، غَارس اَطَّاس ن طْرُوْفَاث. <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />مڒَا ينَّا وضَار نّس قَا نش وَار دْجِيغ شَا ذ فُوْس نش وَار دْجِيغ شَا زِي دَّات-أَ، مَاشِي س وَاوَاڒ-أَ إِي غَا يفّغ زِي دَّات-أَ. <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />مڒَا ينَّا ومجُّوْن نّس قَا نش وَار دْجِيغ شَا ذ ثِيطّ نش وَار دْجِيغ شَا زِي دَّات-أَ، مَاشِي س وَاوَاڒ-أَ إِي غَا يفّغ زِي دَّات-أَ. <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />مڒَا دَّات ثكْمَاڒ نتَّاث ذ يجّن ن ثِيطّ، مَانِيس إِي غَا ثْصنّط؟ مڒَا دَّات ثكْمَاڒ نتَّاث ذ يجّن ن ومجُّوْن، مَانِيس إِي غَا ثْشُوْمّ؟ <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />وَلَكِن ڒخُّو أَربِّـي يستّف طْرُوْفَاث ن دَّات يسّن كُڒ يشِتن مَامّش يخس اَت يݣّ. <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />إِيوَا مَعْلِيك طْرُوْفَاث-أَ مَارَّا تُوْغَا ذ يجّن، مَانِي ثدْجَا دَّات؟ <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />ڒخُّو ذِنِّي اَطَّاس ن طْرُوْفَاث وَلَكِن ذِنِّي يجّن ن دَّات وَاهَا.<verse eid="1CO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21" />فَا ثِيطّ وَار ثْزمَّر اَذَاس ثِينِي إِ وفُوْس قَا صَافِي نش وَار ش تحْذِيجِيغ شَا. نِغ عَاوذ اَزدْجِيف اَذَاسن يِينِي إِ يضَارن قَا صَافِي نش وَار كنِّيو تحْذِيجِيغ شَا. <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />لَّا، طْرُوْفَاث نِّي ن دَّات إِي ذَانغ تْغِيڒ ضعْفنْت اَتَاف نِثنْتِي تْوَاحْذَاجَانْت كْتَار. <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />طْرُوْفَاث نِّي ن دَّات إِي ذَانغ تْغِيڒ وَار غَارْسنْت بُو لْقِيمَا، أَتَاف اَذَاسنْت نݣّ لْقِيمَا كْتَار. عَاوذ طْرُوْفَاث نّغ إِي وَار د تْبِيْننْت شَا، أَتَاف نتْسذْحَا زَّايْسنْت كْتَار. <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />وَلَكِن طْرُوْفَاث نّغ إِي د تْبَاننْت وَار تحْذِيجِينْت شَا اَزَّايْسنْت نْسذْحَا. يعْنِي أَربِّـي يݣَّا لْعَكْس، ئِستّف طْرُوْفَاث ن دَّات بَاش اَذ يُوْش لْقِيمَا إِ طَّارْف نِّي يتحْذَاجَان لْقِيمَا. <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />أَمُّو وَار يدْجِي بُو لْخِلَاف ذِي دَّات، تْهلَّانْت ذݣ وَايْوَايَا كِيف-كِيف. <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />مڒَا شَان يِجّن يتْوَاعْدَّاب، أَذ تْوَاعدَّابن كُڒْشِي. مڒَا شَان يِجّن ثمُّوْش-اَس لْقِيمَا، أَكِذس فَرْحن مَارَّا.<verse eid="1CO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27" />فَا كنِّيو ذ دَّات-أَ <char style="it">يعْنِي ذ جْمَاعث</char> ن لْمَسِيح، كُڒ يجّن زَّايْوم ذ يجّن طَّارْف زَّايس. <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" />ذِي جْمَاعث-أَ ن ڒْمُوْمِنِين يرتّب أَربِّـي ذ اَمزْوَارُو أَرُّسُل، وِيس ثْنَاين لْأَنْبِيَا، وِيس ثْڒَاثَا يمْسڒْمَاذن، منْبَعْد يِنِّي يسْخدَّامن لْمُعْجِيزَاث ذ يِنِّي غَار دْجَانْت لْقُدْرَاث بَاش اَذ سْݣنْفَان يوْذَان، ذ يِنِّي يتْعَاوَانن، ذ يِنِّي يتْكلَّافن س ڒْخذْمث، ذ يِنِّي يسَّاوَاڒن س ڒبْعَاض ن لُّغَاث رُوْحِيَاث. <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />مَا زَعْمَا مَارَّا إِذْسن ذ اَرُّسُل؟ مَا مَارَّا إِذْسن ذ لْأَنْبِيَا؟ مَا مَارَّا إِذْسن ذ يمْسڒْمَاذن؟ مَا مَارَّا إِذْسن سْخدَّامن لْمُعْجِيزَاث؟ <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />مَا مَارَّا إِذْسن غَارْسن لْقُدْرَاث اَذ سْݣنْفَان؟ مَا مَارَّا إِذْسن سَّاوَاڒن س لُّغَاث رُوْحِيَاث؟ مَا مَارَّا إِذْسن سْتَرْجَامن؟<verse eid="1CO 12:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 12:31" />فَا كنِّيو ثْرزُّوْم اَطَّاس خ لْقُدْرَاث يُوْعْڒَان، نش اَذَاوم شرّْحغ يجّن ن وبْرِيذ يُوْعْڒَان خ مَارَّا يبْرِيذن.<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s">ئِزْڒِي خ وبْرِيذ إِي يُوْعْڒَان قَاع خ مَارَّا</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="1CO 13:1" />مَعْلِيك سَّاوَاڒغ س يِيڒسَاون ن يثَرَّاسن س لُّغَا،</para>
  <para style="q1" vid="1CO 13:1">مَعْلِيك سَّاوَاڒغ س لُّغَا ن لْمَلَائِكَاث <char style="it">يعْنِي رُوْحِيَا</char>،</para>
  <para style="q1" vid="1CO 13:1">مَاشَا ڒمْحِبّث وَار ذَايِـي تِيڒِي شَا،</para>
  <para style="q2" vid="1CO 13:1">إِڒِي تْسدَّاعغ اَم يِج ن دَرْبُوْݣَا،</para>
  <para style="q2" vid="1CO 13:1">تمْقرْقَابغ اَم ڒقْرَاقب<note caller="+" style="f"><char style="fr" closed="false">13‏.1 </char><char style="ft" closed="false">ڒقْرَاقب نِثْنِي ذ قْرَاپَّـاث.</char></note> وَاهَا.<verse eid="1CO 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="1CO 13:2" />نش مَعْلِيك غَارِي لْقُدْرَا اَذ سِّيوْڒغ اَم لْأَنْبِيَا،</para>
  <para style="q1" vid="1CO 13:2">مَعْلِيك فهْمغ مَارَّا مِين ينُوْفَّرن ذ مَارَّا ثُوْسْنَا،</para>
  <para style="q1" vid="1CO 13:2">مَعْلِيك سْخدَّامغ لْإِيمَان اَذ سْمُوْتِّيغ يذُوْرَار-أَ،</para>
  <para style="q2" vid="1CO 13:2">إِڒِي ذ وَالُو إِي دْجِيغ نش مڒَا وَار تْحِبِّيغ شَا.<verse eid="1CO 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="1CO 13:3" />نش مَعْلِيك صدّْقغ مَارَّا مِين غَارِي ذ اَݣْڒَا،</para>
  <para style="q1" vid="1CO 13:3">مَعْلِيك سلّْمغ يخف ينُو اَذ سْحرْقن دَّات-أَ،</para>
  <para style="q2" vid="1CO 13:3">إِڒِي نش وَار ربْحغ وَالُو مڒَا وَار تْحِبِّيغ شَا.<verse eid="1CO 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="1CO 13:4" />ڒمْحِبّث ذَايس تِّسَاع ن ڒْخَاضَر، ذَايس يج ن لْحَنَانَا.</para>
  <para style="q2" vid="1CO 13:4">نتَّاث وَار تفْتَخَر وَار ثْحسّذ شَا.</para>
  <para style="q1" vid="1CO 13:4">وَار ذَايس تَّكبُّر، <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />أَقَا نتَّاث تْسذْحَا.</para>
  <para style="q2" vid="1CO 13:5">وَار ثْرزُّو شَا خ مِين ثنْوَا نتَّاث وَاهَا.</para>
  <para style="q1" vid="1CO 13:5">وَار يسْهِيڒ اَذ تْعصّب، مڒَا عْصَان-ت تتُّو ذغْيَا.<verse eid="1CO 13:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="1CO 13:6" />وَار ثْفَرّح شَا زِي شَّرّْ، ثْفَرّح زِي لْحَقِيقَا.<verse eid="1CO 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="1CO 13:7" />وَار ثْفطَّاح عمَّارْص. تَامن شْحَاڒ مَا ثكَّا.</para>
  <para style="q2" vid="1CO 13:7">ثْصبَّر خ مِين مَا يدْجَان. س لْأَمَال ڒبْدَا تْمنَّا.<verse eid="1CO 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CO 13:8" />ڒمْحِبّث-أَ نتَّاث عمَّارْص اَذ تقْضَا،</para>
  <para style="q2" vid="1CO 13:8">مَاشَا اَذ نْتَاهَان وَاوَاڒن ن لْأَنْبِيَا،</para>
  <para style="q1" vid="1CO 13:8">ئِڒسَاون ن يثَرَّاسن وَار تْغِيمِن شَا ذ لُّغَا،</para>
  <para style="q2" vid="1CO 13:8">لْمَعْرِيفَا اَذ تْوَاكمّڒ يعْنِي ثُوْسْنَا.<verse eid="1CO 13:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CO 13:9" />أَقَا مِين نسّن مَاشِي يكْمَاڒ مَانَايَا،</para>
  <para style="q2" vid="1CO 13:9">مِين نسَّاوَاڒ نشِّين لْأَنْبِيَا ذ اَنقْصِي إِݣ يدْجَا.<verse eid="1CO 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CO 13:10" />مِين يدْجَان قَاع يكْمَاڒ اَذ د يبَان ذَانِيتَا،</para>
  <para style="q2" vid="1CO 13:10">سّنِّي مِين يدْجَان ذ اَنقْصِي اَذ يودَّر نتَّا.<verse eid="1CO 13:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="1CO 13:11" />وَامِي نش تُوْغَايِي ذ اَسيْمِي وَاهَا،</para>
  <para style="q2" vid="1CO 13:11">أَمشْنَاو اَسيْمِي سِّيوْڒغ اَم نتَّا،</para>
  <para style="q1" vid="1CO 13:11">أَمشْنَاو اَسيْمِي تْفكَّرغ اَم وَانِيتَا،</para>
  <para style="q2" vid="1CO 13:11">أَمشْنَاو اَسيْمِي وَار تْميِّيزغ س لْفِكْرَا.</para>
  <para style="q1" vid="1CO 13:11">نش وَامِي ذوْڒغ ذ اَرْيَاز بَعْدَا،</para>
  <para style="q2" vid="1CO 13:11">سمْحغ ذݣ يبْرِيذن ن وسيْمِي-يَا.<verse eid="1CO 13:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="1CO 13:12" />أَقَا ڒخُّو نْخزَّر ذݣ يِجّن ن ثِيسِيث وَار ثصْفِي شَا،</para>
  <para style="q2" vid="1CO 13:12">مَاشَا منْبَعْد أَ نمْࢲر مْلِيح قَارَا ذِي قَارَا.</para>
  <para style="q1" vid="1CO 13:12">ڒخُّو مِين سّْنغ ذ اَنقْصِي إِݣ يدْجَا،</para>
  <para style="q2" vid="1CO 13:12">منْبَعْد اَذ سّْنغ نش ثِمسْڒَايِين مَارَّا،</para>
  <para style="q1" vid="1CO 13:12">كِيف-كِيف مَامّش تْوَاسّْنغ نش ذَانِيتَا.<verse eid="1CO 13:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="1CO 13:13" />أَقَاثن ڒخُّو قِّيمن ثْڒَاثَا-يَا:</para>
  <para style="q1" vid="1CO 13:13">لْإِيمَان ذ لْأَمَال ذ ڒمْحِبّث يِيْنَا.</para>
  <para style="q2" vid="1CO 13:13">مَاشَا زِي يِيْنَا ڒمْحِبّث ثُوْعْڒَا.<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s">ثْنَاين لْقُدْرَاث رُوْحِيَاث وَار تْوَافْهِيمنْت شَا مْلِيح</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />ذْفَارث اَبْرِيذ ن ڒمْحِبّث، رْزُوْث مْلِيح خ لْقُدْرَاث رُوْحِيَاث خَاصَّتَن ثنِّي ن وَاوَاڒ يتْوَاعڒْمن زِي أَربِّـي. <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />شُوْف، ونِّي يسَّاوَاڒن س لُّغَا رُوْحِيَا، مَا يسَّاوَاڒ اَك يِوْذَان؟ لَّا، ئِسَّاوَاڒ اَك أَربِّـي. وَار ذِنِّي حَدّ إِي ذَاس يفهّْمن، ئِقَّار ثِمسْڒَايِين س أَرُّوْح يقدّْسن ذَايْسنْت ڒْمَعْنَاث ينُوْفَّرن. <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />وَلَكِن ونِّي يسَّاوَاڒن اَك يِوْذَان س مِين يعْڒم زِي أَربِّـي اَتَاف يسَّاوَاض-اَسن يجّن ن وَاوَاڒ بَاش اَذ تْوَاجهّْذن اَذ تْوَاشجّْعن اَذ تْوَاصبَّرن. <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />ونِّي يسَّاوَاڒن س لُّغَا رُوْحِيَا يسْتنْفَاع يخف نّس. ونِّي يسَّاوَاڒن س مِين يعْڒم زِي أَربِّـي يسْتنْفَاع جْمَاعث ن ڒْمُوْمِنِين. <verse eid="1CO 14:4" /><verse number="5" style="v" sid="1CO 14:5" />إِيوَا خْسغ مَارَّا كنِّيو اَذ تسِّيوْڒم س لُّغَاث رُوْحِيَاث، وَلَكِن مْلِيح عَاذ اَذ تسِّيوْڒم س وَاوَاڒن إِي ثْعڒْمم زِي أَربِّـي. ونِّي يسَّاوَاڒن س وَاوَاڒ إِݣ يعْڒم زِي أَربِّـي نتَّا يمْغَر خ ونِّي يسَّاوَاڒن س لُّغَاث رُوْحِيَاث، إِلَّا مڒَا شَان يِجّن اَذ يسْتَرْجم حمَا اَذ يسْتنْفع جْمَاعث ن ڒْمُوْمِنِين.<verse eid="1CO 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 14:6" />فَا ڒخُّو آي اَيثْمَا، مڒَا ؤُسِيغ-د غَارْوم سَّاوَاڒغ نش س لُّغَاث رُوْحِيَاث، مَان نّْفَع إِي زِي كنِّيو غَا نفْعغ إِلَّا مڒَا ؤُوِيغ-اَوم-د شَا ن لْوَاحِي نِغ شَا ن ثُوْسْنَا نِغ شَا ن وَاوَاڒ إِي عڒْمغ زِي أَربِّـي نِغ شَان ن تَّعْلِيم؟ <verse eid="1CO 14:6" /><verse number="7" style="v" sid="1CO 14:7" />أَمنِّي ؤُڒَا ذ لْأَلَاث ن لْمُسِيقَا وَار ذَايْسنْت بُو بُوْحْبڒ اَم ثمْجَا نِغ اَم ثْݣَامْبْرِيت. مڒَا وَار ثْصُوْضذ نِيشَان وَار ثْنقْطذ وَار ذَاش تِيشّن بُو نّغْمَا، وَار ثْزمَّرذ اَذ تسّْنذ لْمُوْسِيقَا نِّي مِين ثعْنَا. <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />عَاوذ اَمشْنَاو زَّمَّار، مڒَا وَار ذَايس ثْصُوْضذ شَا س يِجّن ن ثْمِيجَّا ثصْفَا، وِي غَا يسْوجْذن إِ ڒْحَارْب؟ <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />أَمُّو عَاوذ ؤُڒَا ذ كنِّيو، مڒَا تْوجْوِيجم وَاهَا س وَاوَاڒ نْوم، وِي ذَاوم غَا يفهْمن مِين ثقَّارم؟ أَتَاف اَوَاڒ نْوم كنِّيو اَم ونِّي يسَّاوَاڒن ذِي ڒهْوَا! <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />بْڒَا شّكّ دْجَان اَطَّاس ن لْأَنْوَاع ن لُّغَاث ذِي دُّنشْت-أَ، وَلَكِن كُڒ يشْت س ڒْمَعْنَا نّس. <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />إِيوَا مڒَا نش وَار سِّينغ شَا ڒْمَعْنَا ن لُّغَا نِّي، أَتَاف نش اَذ يڒِيغ اَم يِجّن ذ اَبَرَّانِي اَك ونِّي يسَّاوَاڒن اَتَاف نتَّا عَاوذ اَكِذِي يِيڒِي اَم يِج وبَرَّانِي. <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />إِيوَا كنِّيو، وَامِي ثْرزُّوْم اَطَّاس خ لْقُدْرَاث رُوْحِيَاث، ݣّث لْمجْهُوْد نْوم حمَا اَذ تَرْنُوْم ذِي ثِنِّي إِي زِي يسْتنْفَاعن جْمَاعث ن ڒْمُوْمِنِين.<verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />س مَانَاينِّي، ونِّي يسَّاوَاڒن س لُّغَاث رُوْحِيَاث يتْخصَّا-يَاس اَذ يࢲَّادْجْ حمَا اَذ يسْتَرْجم مِين يقَّار. <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />لِأَنَّا مڒَا ࢲُّوْدْجغ س لُّغَا رُوْحِيَا، أَرُّوْح ينُو يتْࢲَادْجَا وَلَكِن ڒَعْقڒ ينُو وَار يسْتنْفِيع شَا. <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />إِيوَا مِين غَا ݣّغ؟ أَذ ࢲَّادْجغ س اَرُّوْح ينُو، أَذ ࢲَّادْجغ عَاوذ س ڒَعْقڒ ينُو. أَذ غنّْجغ س اَرُّوْح ينُو، أَذ غنّْجغ عَاوذ س ڒَعْقڒ ينُو. <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />مڒَا تْشكَّرذ أَربِّـي س اَرُّوْح وَاهَا، ونِّي إِي غَارْوم د يُوْسِين س زِّيَارَا وَار يزمَّر اَذ يِينِي آمِين خ شُّكر نّش لِأَنَّا وَار يسِّين شَا مِين ثقَّارذ. <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />وَاه، يمْكن شك ثْشكَّرذ أَربِّـي وَلَكِن ونِّي نّغْنِي وَار ث ينفّع شَا.<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />تْشكَّرغ أَربِّـي نش سَّاوَاڒغ س لُّغَاث رُوْحِيَاث كْتَار زَّايْوم مَارَّا. <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />إِنَّمَا، مڒَا سِّيوْڒغ اَك جْمَاعث ن ڒْمُوْمِنِين غِير س خمْسَا ن وَاوَاڒن اَتَاف اَذَايِي فهّْمن حْسن زِي مڒَا سِّيوْڒغ س عشْرَاڒَاف ن وَاوَاڒن س يِجّن ن لُّغَا رُوْحِيَا.<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />لَّا آي اَيثْمَا، وَار تْفكَّرث شَا اَم يحنْجِيرن يمزْيَانن. إِڒِيث اَم يسيْمَان ذِي شَّرّْ؛ إِڒِيث اَم يمقّْرَانن عْلَاحْسَاب ڒَعْقڒ. <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />ئِقَّار ذِي شَّرِيعَا ن مُوْسَى: "نش اَذ سِّيوْڒغ اَڒ يِوْذَان-أَ س لُّغَاث ن يثَرَّاسن س يينْشِيشن ن يبَرَّانِيْين، وَاخَّا اَمنِّي وَار ذَايِي تْصنِّيطن شَا. مَانَايَا يقَّار-يث سِيذِي أَربِّـي." <verse eid="1CO 14:21" /><verse number="22" style="v" sid="1CO 14:22" />س وَاوَاڒ-أَ، لُّغَاث رُوْحِيَاث نِثنْتِي ذ يجّن ن لْعَلَامَا وَار ثدْجِي بُو إِ يِنِّي يُوْمْنن؛ لَّا، أَقَات إِ يِنِّي وَار يُوْمِينن شَا. وَلَكِن اَوَاڒ نِّي يتْوَاعڒْمن زِي أَربِّـي يسْتنْفَاع يِنِّي يُوْمْنن مَاشِي إِ يِنِّي وَار يُوْمِينن شَا.<verse eid="1CO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23" />إِذن، مڒَا ثْمُوْنم جْمَاعث ثكْمَاڒ ن ڒْمُوْمِنِين ثسَّاوَاڒم مَارَّا س لُّغَاث رُوْحِيَاث ؤُذْفن-د جَارَاوم يِوْذَان ن بَارَّا نِغ ذ لْكُفَّار، أَتَاف قَّارن خَاوم قَا يوْذَان-أَ ذ يبُوْهَاڒِيْين. <verse eid="1CO 14:23" /><verse number="24‏-25" style="v" sid="1CO 14:24-25" />وَلَكِن، مڒَا ثسَّاوَاڒم مَارَّا كنِّيو س وَاوَاڒن إِي ثْعڒْمم زِي أَربِّـي يُوْذف-د جَارَاوم حَدّ زِي بَارَّا نِغ ذ يجّن ن لْكَافِر، أَتَاف اَذ يحسّ ذݣ يِيخف نّس قَا اَذ يتْوَاحَاسب اَذ يقْنع زَّايْوم مَارَّا نتَّا ذ لْعَاصِي، أَتَاف اَزَّايس تْوَاسُوْفْغن مَارَّا لْأَسْرَار ن وُوْڒ نّس. ثُمَّا اَذ يسجّذ اَذ يعْبذ أَربِّـي اَذ يِينِي قَا أَربِّـي ذ صَّح اَقَاث جَارَاوم!<verse eid="1CO 14:24-25" /></para>
  <para style="s">نِّيظَام إِي يدْجَان ذِي لْعِبَادَا ذِي جْمَاعث ن ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />إِذن فَا آي اَيثْمَا، خْمِي غَا ثْمُوْنم يجّن اَغَارس يِيڒِي يجّن ن وغنِّيج، ئِجّن اَغَارس يِيڒِي يجّن ن وَاوَاڒ ن وسڒْمذ، ئِجّن اَغَارس يِيڒِي لْوَاحِي، ئِجّن اَغَارس ثِيڒِي لُّغَا رُوْحِيَا، ئِجّن اَغَارس ثِيڒِي تَّرْجَمَا. مَارَّا ثِمسْڒَايِين-أَ اَذ يڒِينْت حمَا اَذ تْجهْذم. <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />مڒَا ثسِّيوْڒم س يِجّن ن لُّغَا رُوْحِيَا، لَابُد اَذ تسِّيوْڒم ثْنَاين نِغ ثْڒَاثَا أُو صَافِي. أَذ تسِّيوْڒم ئِج-يج، أُو لَابُد اَذ يقِّيم يجّن زَّايْوم اَذ يسْتَرجم. <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />مڒَا وَار ذِنِّي حَدّ اَذ يسْتَرْجم، ونِّي يسَّاوَاڒن اَذ يسْتُوْك اَذ يسِّيوڒ ذݣ وُوْڒ نّس ذ أَربِّـي.<verse eid="1CO 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 14:29" />فَا لْأَنْبِيَا أُو لَابُد اَذ سِّيوْڒن ثْنَاين نِغ ثْڒَاثَا. ئِنّغْنِي اَذ ميّْزن اَوَاڒن نِّي. <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />مڒَا يهْوَا-د شَا ن وَاوَاڒ ن لْوَاحِي خ شَان يِجّن جَار ن يِنِّي يقِّيمن جَارَاوم، أَتَاف ونِّي يسَّاوَاڒن ذ اَمزْوَارُو اَذ يسْتُوْك. <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />لِأَنَّا ثْزمَّرم مَارَّا اَذ تسِّيوْڒم س مِين ثْعڒْمم زِي أَربِّـي ئِج-يج حمَا مَارَّا <char style="it">ڒْمُوْمِنِين</char> اَذ ڒمْذن اَذ تْوَاشجّْعن. <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />وَا لْقُدْرَاث رُوْحِيَاث ن لْأَنْبِيَا اَقَاثنْت خ يِيرِي نْسن س يِيخف نْسن. <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />لِأَنَّا أَربِّـي وَار يدْجِي بُو ن ڒْفَاوْضَا وَلَكِن ن ڒهْنَا. ذ ثَانِيتَا ذ لْعَادَا إِي ذَايْسنْت ذِي مَارَّا ثِجُمَاع ن ڒْمُوْمِنِين.<verse eid="1CO 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CO 14:34" />ثِمْغَارِين ذِي ثْجُمَاع ن ڒْمُوْمِنِين لَابُد اَذ قِّيمنْت سْتُوْكَانْت. وَار ذَاسنْت يتْوَاسْمِيح شَا اَذ سِّيوْڒنْت. لَابُد اَذ تْسذْحَانْت مَامّش ثقَّار شَّرِيعَا ن مُوْسَى. <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />مڒَا رزُّوْنْت اَذ سّْننْت شَان ثْمسْڒَايْث، لَابُد اَذ سّقْسَانْت يرْيَازن نْسنْت ذِي ثدَّارْث. لِأَنَّا ثَمْغَارْث ذ ڒْعِيب اَذ تسِّيوڒ ذِي ڒْوسْط ن جْمَاعث ن ڒْمُوْمِنِين.<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />أَوَاڒ ن أَربِّـي، مَا يفّغ-د زَّايْوم كنِّيو؟ مَا يُوْوض-د غَارْوم كنِّيو وَاهَا؟ <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />مڒَا يجّن يحسّب يخف نّس نِيشَان ذ نَّبِي نِغ ذ يجّن ن بْنَاذم رُوْحِيَا اَتَاف أُو لَابُد اَذ يقْبڒ مِين ذَاوم د تَارِيغ ذِي ثبْرَات-أَ نتَّاث ذ ڒُوْصِيّث ن سِيذِيثْنغ. <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />مڒَا وَار يقْبِيڒ شَا مَانَايَا، وَار يتْوَاقبِّيڒ شَا نتَّا. <verse eid="1CO 14:38" /><verse number="39" style="v" sid="1CO 14:39" />س مَانَايَا آي اَيثْمَا، رْزُوْث اَطَّاس حمَا اَذ تسِّيوْڒم س وَاوَاڒ يتْوَاعڒْمن زِي أَربِّـي، أُو عَاوذ وَار منَّاعْث شَا يوْذَان اَذ سِّيوْڒن س لُّغَاث رُوْحِيَاث. <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />وَلَكِن يتْخصَّا-كنِّيو اَذ تݣّم كُڒْشِي مَعْقُوْل س يِجّن ن نِّيظَام نِيشَان.<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s">لْقِيَامَا ن لْمَسِيح</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />فَا آي أَيثْمَا اَكنِّيو سْفكَّرغ خ لْإِنْجِيل إِي زِي كنِّيو بشَّرغ، يعْنِي نتَّا ثْقبْڒم-ث أُو مْتبْثِين خَاس. <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />أَقَا ثْنجّْمم زَّايس وَامِي ذَايس تطّْفم مْلِيح ذݣ وَاوَاڒ ن تّبْشِير نِّي ونِّي إِي زِي كنِّيو بشَّرغ. مڒَا لَّا، زَعْمَا لْإِيمَان نْوم ثسْبطّْڒم-ث.<verse eid="1CO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3" />شُوْف، سِيْوْضغ-اَوم-د مَانَاينِّي يدْجَان مُهِم تُوْغَا قبْڒغ-ث نش س يِيخف ينُو، يعْنِي لْمَسِيح يمُّوْث عْلَاحْسَاب ڒْمُعْصِيَاث نّغ مَامّش يقَّار لْكِتَاب. <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" />ثُمَّا يتْوَانْضڒ، ثُمَّا يتْوَاسْنكَّار-د ذݣ وَاسّ وِيس ثڒْتِيَّام مَامّش يقَّار لْكِتَاب. <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />ثُمَّا يمظْهَار-اَس-د إِ بُطْرُس،<note caller="+" style="f"><char style="fr" closed="false">15‏.5 </char><char style="ft" closed="false">بُطْرُس يسم نّس ذِي لْكِتَاب ن لْأَصل قَّارن-اَس كيْفَاص.</char></note> سّنِّي يمظْهَار-اَسن-د إِ ثنْعَاش نِّي ن اَرُّسُل. <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />منْبَعْد يمظْهَار-اَسن-د إِ كْتَار زِي خمْسْمِيَّا ن وَاوْمَاثن ذِي ثْوَاڒَا ذ يشْتن. نِثْنِي عَاذ دَّرن عْڒَاين مَارَّا إِذْسن، ڒبْعَاض زَّايْسن اَقَا طّْصن <char style="it">يعْنِي مُّوْثن</char>. <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />ثُمَّا يمظْهَار-اَس-د إِ يَعْقُوْب، منْبَعْد إِ مَارَّا اَرُّسُل. <verse eid="1CO 15:7" /><verse number="8" style="v" sid="1CO 15:8" />غَار ونݣَّارُو قَاع يمظْهَار-اَيِي-د إِ نش، اَخْمِي نش عظْڒغ وَار د خْڒِيقغ شَا ذِي زْمَان ينُو نِيشَان. <verse eid="1CO 15:8" /><verse number="9" style="v" sid="1CO 15:9" />أَقَا نش ذ اَمزْيَان قَاع ذِي اَرُّسُل. وَار سْذِيهِيدْجغ شَا اَذَايِي ڒَاغَان اَرَّسُوْل ڒَاحقَّاش تُوْغَا نش تْعدَّابغ جْمَاعث ن ڒْمُوْمِنِين. <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />وَلَكِن نش س اَرْضَا ن أَربِّـي ذوْڒغ مَامّش دْجِيغ ڒخُّو. ثُمَّا اَرْضَا نّس وَار يدْجِي بُو خَافِي س بْڒَا نّْفَع؛ لَّا، نش شَّاثغ تَمَارَا كْتَار زَّايْسن مَارَّا. مَاشِي ذ نش زَعْمَا؛ لَّا، ذ اَرْضَا ن أَربِّـي إِي كِذِي. <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />فَلِهَاذَا وَاخَّا ذ نش نِغ ذ نِثْنِي، ذ وَانِيتَا ذ تّبْشِير إِي زِي نتْبشَّار سّنِّي كنِّيو ثُوْمْنم زَّايس.<verse eid="1CO 15:11" /></para>
  <para style="s">لْقِيَامَا ن يمتِّينن</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />فَا لْمَسِيح نتْبشَّار خَاس يتْوَاسكَّر-د زِي ڒْموْث. مَامّش قَّارن ڒبْعَاض زَّايْوم وَار ثدْجِي بُو لْقِيَامَا ن يمتِّينن؟ <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />مڒَا وَالُو لْقِيَامَا ن يمتِّينن، ؤُڒَا ذ لْمَسِيح وَار د يتْوَاسكَّر شَا. <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />مَعْلِيك وَار د يتْوَاسكَّر شَا لْمَسِيح، إِڒِي تّبْشِير نّغ ذ ڒْبَاطڒ وَاهَا، إِڒِي كنِّيو لْإِيمَان نْوم ؤُڒَا ذ نتَّا ذ ڒْبَاطڒ. <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />مَعْلِيك اَمنِّي، إِڒِي نُوْفَا يخف نّغ نْشهّذ ࢲُّوْر خ أَربِّـي. مَايمِّي؟ ڒَاحقَّاش نشْهذ خ أَربِّـي بلِّي يسكَّر-د لْمَسِيح زِي ڒْموْث. وَلَكِن مَعْلِيك وَار تِيڒِي بُو لْقِيَامَا ن يمتِّينن، إِڒِي أَربِّـي زَعْمَا وَار د يسكَّر شَا لْمَسِيح زِي ڒْموْث. <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />شُوْف، مَعْلِيك يمتِّينن وَار د تْوَاسْنكَّرن شَا، إِڒِي لْمَسِيح زَعْمَا وَار د يتْوَاسكَّر شَا ؤُڒَا ذ نتَّا. <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />مَعْلِيك وَار د يتْوَاسكَّر شَا لْمَسِيح، إِڒِي كنِّيو زَعْمَا لْإِيمَان نْوم ذ ڒْبَاطڒ وَاهَا، إِڒِي عَاذ اَقَا كنِّيو ذِي ڒْمُعْصِيَاث نْوم. <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />مَعْلِيك اَمنِّي، إِڒِي يِنِّي يطّْصن <char style="it">يعْنِي يِنِّي يمُّوْثن</char> ذِي لْمَسِيح زَعْمَا صَافِي قَا فْنَان. <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />مَعْلِيك نݣَّا لْأَمَال نّغ ذِي لْمَسِيح عْلَاحْسَاب ثُوْذَارْث-أَ ثَانِيتَا وَاهَا، إِڒِي س مَانَايَا نتْزِيدْجِيز إِ يِوْذَان زَعْمَا كْتَار زݣ يِوْذَان مَارَّا.<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />فَا اَقَا ڒخُّو لْمَسِيح يتْوَاسكَّر-د زِي ڒْموْث، يعْنِي نتَّا ذ ثَفدْجَاحْث ثَمزْوَارُوْت إِي د يكَّرن زݣ يِنِّي يمُّوْثن. <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />شُوْف، س يِجّن ن بْنَاذم <char style="it">آدَم</char> ثُوْسَا-د زَّايس ڒْموْث. س يِجّن ن بْنَاذم عَاوذ ثُوْسَا-د زَّايس لْقِيَامَا ن يمتِّينن. <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />ڒَاحقَّاش اَم مَامّش إِي غَا نمّث مَارَّا س بْنَاذم نِّي آدَم، أَمُّو عَاوذ اَغَارْنغ ثِيڒِي ثُوْذَارْث إِ مَارَّا نشِّين س لْمَسِيح. <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />وَلَكِن كُڒ يجّن نُّوْبث نّس: لْمَسِيح نتَّا ذ ثَفدْجَاحْث ثَمزْوَارُوْت. خْمِي د غَا يعْقب نتَّا، أَذ د تَاس نُّوْبث ن يِنِّي يدْجَان زَّايس نتَّا.<verse eid="1CO 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 15:24" />ثُمَّا اَذ يِيڒِي ڒفْنَا ن دُّنشْت-أَ. لْمَسِيح اَذ يقْضَا خ مَارَّا ڒحْكَام ذ ڒْمخْزن ذ جّْهذ إِݣ يدْجَان، ثُمَّا اَذ يجّ ڒحْكَام نِّي نّس إِ أَربِّـي بَابَاس. <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />أَقَا يتْخصَّا اَذ يحْكم لْمَسِيح اَڒ غَا يݣّ أَربِّـي مَارَّا ڒْعَذْيَان نّس سْوَادَّاي ن سُّلْطَا ن يضَارن نّس. <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />ڒَعْذُو اَنݣَّارُو إِي غَا يبطَّڒ نتَّاث ذ ڒْموْث. <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />أَقَا أَربِّـي يݣَّا مَارَّا ثِمسْڒَايِين سْوَادَّاي إِ سُّلْطَا ن يضَارن ن لْمَسِيح. وَلَكِن خْمِي يقَّار قَا مَارَّا ثِمسْڒَايِين تْوَاݣّنْت سْوَادَّاي نّس، نسّن بلِّي أَربِّـي وَار يدْجِي بُو جَار ن ثْمسْڒَايِين نِّي ڒَاحقَّاش أَربِّـي س يِيخف نّس نتَّا إِݣ يݣِّين مَارَّا ثِمسْڒَايِين نِّي سْوَادَّاي ن سُّلْطَا ن لْمَسِيح. <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />خْمِي غَا يڒِينْت مَارَّا ثِمسْڒَايِين-أَ سْوَادَّاي ن سُّلْطَا ن لْمَسِيح، ثُمَّا مِّيس <char style="it">يعْنِي لْمَسِيح</char> س يِيخف نّس اَذ يذْوڒ ؤُڒَا ذ نتَّا سْوَادَّاي ن سُّلْطَا ن أَربِّـي إِݣ يݣِّين مَارَّا ثِمسْڒَايِين-أَ سْوَادَّاي ن سُّلْطَا ن لْمَسِيح. أَمُّو اَذ يِيڒِي أَربِّـي ذ مَارَّا ذِي مِين ذِي مَا.<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />شُوْف، يِنِّي يتْوَاطهَّارن س وَامَان عْلَاحْسَاب إِ يِنِّي يمُّوْثن، مَان نّْفَع إِي رزُّوْن نِثْنِي؟ مڒَا ذ صَّح زَعْمَا بلِّي يِنِّي يمُّوْثن وَار د تْوَاسْنكَّارن شَا، مَايمِّي يوْذَان-أَ تتْوَاطهَّارن س وَامَان عْلَاحْسَاب إِ يِنِّي يمُّوْثن؟ <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />ئِي نش، مَايمِّي دْجِيغ ذِي لْخَطَر كُڒ ثْسَعَّات؟ <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />آي أَيثْمَا، تْوَاجَاهغ ڒْموْث كُڒ نْهَار! قَّارغ-اَوم مَانَايَا س لْإِفْتِخَار-أَ إِي غَارِي ذَايْوم عْلَاحْسَاب ثُوْذَارْث-أَ نّغ إِي غَارْنغ ذ يْشْتن اَك سِيذِيثْنغ عِيْسَى لْمَسِيح. <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />نش مڒَا عْلَاحْسَاب ثِمسْڒَايِين ن دُّنشْت-أَ وَاهَا، مَايمِّي منْغغ اَك ڒُوْحُوْش ذِي ثنْدِينْت ن ؤُفَسُوْس؟ مِين غَا ربْحغ؟ ئِمتِّينن، مڒَا وَار د تْنكَّارن شَا زِي ڒْموْث، <char style="it">ئِي مَايمِّي؟</char></para>
  <para style="q2" vid="1CO 15:32">"يَالَّاه أَ نشّث أَ نسْوث،</para>
  <para style="q2" vid="1CO 15:32">قَا ثِيوشَّا أَ نمّث."<verse eid="1CO 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33" />وَار خدّْعث شَا يخف نْوم:</para>
  <para style="q2" vid="1CO 15:33">"ثَمْعَاشَارث ثَعفَّانْت،</para>
  <para style="q2" vid="1CO 15:33">تْضيَّاع تَّرْبِيَا ثَصبْحَانْت."<verse eid="1CO 15:33" /></para>
  <para style="b" />
  <para style="p">
    <verse number="34" style="v" sid="1CO 15:34" />أَرّم-د ڒْبَاڒ نْوم، وَار عصَّاث شَا. قَّارغ-اَوم مَانَايَا بَاش اَذ تْسذْحَام مِينْزِي ڒبْعَاض زَّايْوم ذَايْسن ڒقْفَاڒث خ أَربِّـي.<verse eid="1CO 15:34" /></para>
  <para style="s">دَّات نِّي إِي غَارْنغ غَا يِيڒِين ذِي لْقِيَامَا</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />وَلَكِن يجّن اَذ يِينِي: ئِمتِّينن، مَامّش غَا ݣّن اَذ د كَّرن؟ مَان صِّفث إِي زِي د غَا ذوْڒن؟ <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />آ ونِّي وَار يفْهِيمن، ثَحبُّوْيْث نِّي إِي ثْزرّْعذ اَذ تمّث زَعْمَا <char style="it">سْوَادَّاي ن وشَاڒ،</char> منْبَعْد اَذ تغْمِي. <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />أُو ثنِّي ثْزرّْعذ شك نتَّاث وَار ثدْجِي بُو ذ صِّفث نِّي إِي د غَا يغْمِين. لَّا، ثْزرّْعذ غِير يجّن ن ثْحبُّوْيْث وَاهَا ن زَّرِّيعث ن يِرْذَان نِغ ذ شَا ن زَّرِّيعث نّغْنِي. <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />ثُمَّا يتِيشّ-اَس أَربِّـي يجّن ن صِّفث إِي غَا يخْضَر نتَّا. كُڒ نُّوْع ن زَّرِّيعث يتِيشّ-اَس صِّفث نّس وَاحْذس.<verse eid="1CO 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 15:39" />أَيْسُوْم عَاوذ وَار يدْجِي بُو مَارَّا كِيف-كِيف. يرْيَازن غَارْسن يجّن ن نُّوْع ن ويْسُوْم وَاحذْسن، لْحَيَوَانَاث وَاحذْسن، ئِجْضَاض يجّن ن نُّوْع وَاحذْسن، ئِسڒْمَان عَاوذ وَاحذْسن.<verse eid="1CO 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40" />عَاوذ ذِنِّي صِّفَاث ن ثْمسْڒَايِين إِي يدْجَان ذݣ وجنَّا. عَاوذ ذِنِّي صِّفَاث ن ثْمسْڒَايِين إِي يدْجَان ذِي ثْمُوْرْث. أَشعْشع ن مِين يدْجَان ذݣ وجنَّا نتَّا ذ يجّن ن نُّوْع. أَشعْشع ن مِين يدْجَان ذِي ثْمُوْرْث نتَّا ذ يجّن ن نُّوْع. <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />ثْفُوْشْت غَارس نُّوْع ن وشعْشع نّس وَاحْذس. ثَزِيرِي غَارس نُّوْع ن وشعْشع نّس وَاحْذس. ئِثْرَان نُّوْع ن وشعْشع نْسن وَاحذْسن. كُڒ يثْرِي عَاوذ ذ اَشعْشع نّس وَاحْذس.<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />أَمُّو إِي تِيڒِي لْقِيَامَا ن يمتِّينن، مِين يتْوَازرّْعن اَذ يفْنَا. مِين د يتْوَاسْنكَّرن اَذ يذُوْم. <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />دَّات تْوَازرّع ذِي ڒفْضِيحث، تْوَاسْنكَّر-د ذِي شّنْعث. تْوَازرّع ذِي ضُّعف، تْوَاسْنكَّر-د ذِي جّْهذ. <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />تْوَازرّع ذ يجّن ن دَّات ن بْنَاذم، تْوَاسْنكَّار-د ذ يجّن ن دَّات رُوْحِيَا. مڒَا ثدْجَا دَّات ن بْنَاذم، ثدْجَا عَاوذ دَّات رُوْحِيَا. <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" />أَمُّو يقَّار لْكِتَاب: "بْنَاذم اَمزْوَارُو يعْنِي آدَم يذْوڒ ذ بُوْحْبڒ يدَّرن." آدَم اَنݣَّارُو<note caller="+" style="f"><char style="fr" closed="false">15‏.45 </char><char style="ft" closed="false">آدَم اَنݣَّارُو يعِنِي نتَّا ذ عِيْسَى لْمَسِيح.</char></note> نتَّا ذ بُوْحْبڒ يسدَّرن. <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />مِين يدْجَان رُوْحِيَا وَار د يتِيس شَا ذ اَمزْوَارُو؛ لَّا، ئِتَاس-د مِين يدْجَان ن بْنَاذم. مِين يدْجَان رُوْحِيَا يتَاس-د منْبَعْد. <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />بْنَاذم اَمزْوَارُو يتْوَاصنَّع زݣ وشَاڒ ن ثْمُوْرْث، بْنَاذم وِيس ثْنَاين يُوْسَا-د زݣ وجنَّا. <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />مَامّش إِي يدْجَا بْنَاذم نِّي يتْوَاصنّْعن زݣ وشَاڒ، أَمنِّي عَاوذ إِي دْجَان يِوْذَان يتْوَاصنَّاعن زݣ وشَاڒ. وَا مَامّش إِي يدْجَا بْنَاذم نِّي ن وجنَّا، أَمنِّي عَاوذ إِي دْجَان يِوْذَان ن وجنَّا. <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />مَامّش نتْشَابَّاه ذِي صِّفث ن ونِّي يتْوَاصنّْعن زݣ وشَاڒ، أَمنِّي عَاوذ إِي غَا نْشَابَّاه ذِي صِّفث ن ونِّي زݣ وجنَّا.<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />فَا قَّارغ-اَوم آي أَيثْمَا، قَا اَيْسُوْم ذ يذَامّن وَار زمَّرن اَذ وَارْثن ذِي ڒْمُلْك وجنَّا. مِين يفنَّان وَار يوَارّث شَا مِين وَار يفنِّين. <verse eid="1CO 15:50" /><verse number="51‏-52" style="v" sid="1CO 15:51-52" />أَقَا قَّارغ-اَوم يجّن ن ثْمسْڒَايْث ڒْمَعْنَا نّس ينُوْفَّرن: قَا وَار نتْمتِّي شَا س مَارَّا إِذْنغ. خْمِي غَا يصُوْض زَّامَّار اَنݣَّارُو اَتَاف أَ نْبدّڒ مَارَّا إِذْنغ <char style="it">ذِي صِّفث نّغْنِي</char>. مَانَايَا اَذ يِيڒِي ذغْيَا ذݣ يِجّن ن وَارْمَاش ن ثِيطّ.<note caller="+" style="f"><char style="fr" closed="false">15‏.51‏-52 </char><char style="ft" closed="false">أَرْمَاش قَّارن-ت إِ وغمّز.</char></note> أَذ يصُوْض زَّامَّار نِّي ثُمَّا اَذ د تْوَاسْنكَّرن يمتِّينن يعْنِي اَذ دُوْمَان إِ ڒبْدَا أَ نِيڒِي نْبدّڒ <char style="it">ذِي صِّفث نّغْنِي</char>.<verse eid="1CO 15:51-52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="1CO 15:53" />شُوْف، مِين يفنَّان يتْخصَّا اَذ يغْمس س مِين وَار يفنِّين، ذ مِين يتْمتَّان يتْخصَّا اَذ يغْمس س مِين وَار يتْمتِّين. <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />مِين يفنَّان خْمِي غَا يغْمس س مِين وَار يفنِّين، ذ مِين يتْمتَّان خْمِي غَا يغْمس س مِين وَار يتْمتِّين، ڒخْدّنِّي اَذ د يفّغ مِين يُوْرِين ذِي لْكِتَاب: &lt;ڒْموْث يسغْڒي-ت اَرْبَاح.&gt;<verse eid="1CO 15:54" /></para>
  <para style="q2">
    <verse number="55" style="v" sid="1CO 15:55" />&lt;هِيوَا شم آ ڒْموْث، أَرْبَاح نّمْ مَانِي يدْجَا؟</para>
  <para style="q2" vid="1CO 15:55">هِيوَا شم آ ڒْموْث، ثِيقّسْت نّمْ مَانِي ثدْجَا؟&gt;<verse eid="1CO 15:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="1CO 15:56" />أَقَا ڒْموْث ثِيقّسْت نّس تَاس-د زِي ڒْمُعْصِيّث. قَا ڒْمُعْصِيّث ثِزمَّار نّس تَاس-د زِي شَّرِيعَا. <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />نشِّين أَ نحْمذ أَربِّـي! نتَّا يتِيشّ-اَنغ-د بَاش أَ نرْبح س سِيذِيثْنغ عِيْسَى لْمَسِيح.<verse eid="1CO 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58" />س مَانَايَا آي أَيثْمَا يمْعِيزّن ينُو، بدّث نِيشَان مَاشِي اَكنِّيو سنْهزّن. ݣّث لْمجْهُوْد نْوم ڒبْدَا ذِي ڒْخذْمث ن سِيذِيثْنغ، قَا ثسّْنم بلِّي ڒْخذْمث نْوم ذِي سِيذِيثْنغ مَاشِي ذ ڒْبَاطڒ.<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s">صَّذَاقَا إِ ڒْمُوْمِنِين صَّالِحِين ذِي ثنْدِينْت ن لْقُدْس</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />عْلَاحْسَاب صَّذَاقَا إِ ڒْمُوْمِنِين صَّالِحِين، سْوجْذث كنِّيو مَامّش ثنْت وصِّيغ إِ ثْجُمَاع ن ڒْمُوْمِنِين ذِي لْإِقْلِيم ن ݣَلَاطْيَا. <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />ذِي نْهَار اَمزْوَارُو ن كُڒ سِيمَانَا، كُڒ يجّن زَّايْوم يتْخصَّا-يَاس اَذ يكّس شَا ن تْمنْيَاث عْلَاحْسَاب لْمَنْضَا نّس اَثنْت يخمّڒ. مَاشِي اَڒ د غَا اَسغ نش عَاذ اَذ تبْذَام اَذ تسْمُوْنم تْمنْيَاث-أَ. <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />منْبَعْد، يعْنِي خْمِي إِي د غَا اَوْضغ نش، أَتَاف اَذ د سّكّغ يِنِّي إِي غَا ثْسجّْلم ذِي ثبْرَاثِين بلِّي ذَايْسن تِّقث اَذ رَاحن اَذ اَوِين صَّذَاقَا-يَا إِي ثسْمُوْنم غَار ثنْدِينْت ن لْقُدْس. <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />مڒَا أُو لَابُد اَذ رَاحغ ؤُڒَا ذ نش، أَكِذِي رَاحن.<verse eid="1CO 16:4" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس ذ يِنِّي إِي كِذس يخدّْمن إِ سِيذِيثْنغ</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />فَا خْمِي غَا عْذُوْغ مَسِيدُوْنْيَا اَغَارْوم د اَسغ، قَا نش عَاذ اَذ د كّغ سّنِّي خ مَسِيدُوْنْيَا. <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />يمْكن اَكِذْوم قِّيمغ يجّن ن ڒْوقْث نِغ اَكِذْوم سعْذُوْغ ڒْمشْتَا بَاش اَذَايِي ثْعَاوْنم ذݣ وسَفَار ينُو مَانِي مَا رُوْحغ. <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />ڒخُّو وَار خْسغ شَا اَكنِّيو ࢲْرغ مِينْزِي اَخَاوم د كّغ وَاهَا؛ لَّا، تْمنِّيغ عَاذ اَكِذْوم قِّيمغ يجّن ن لْمُدَّا يعْنِي مڒَا يخس أَربِّـي. <verse eid="1CO 16:7" /><verse number="8" style="v" sid="1CO 16:8" />نش اَذ قِّيمغ ذِي ثنْدِينْت ن ؤُفَسُوْس اَڒ غَا د يَاوض ڒْعِيذ ن نْهَار وِيس خمْسِين.<note caller="+" style="f"><char style="fr" closed="false">16‏.8 </char><char style="ft" closed="false">ڒْعِيذ ن نْهَار وِيس خمْسِين ذ يجّن ن ڒْعِيذ ن أَيثْ-إِسْرَائِيل يتَاس-د خمْسِين يُوْم منْبَعْد إِ ڒْعِيذ اَمقّْرَان نْسن.</char></note> <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />أَقَا ثْنُوْرْزم-اَيِي-د يجّن ن ثوَّارْث ذ ثَمقّْرَانْت إِ ڒْخذْمث وَلَكِن يِنِّي إِݣ يتْعَارَّاضن اَقَاثن مُوْجُوْدِين.<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />مڒَا يُوْسَا-د تِيْمُوْتَاوُس تْهلَّام ذَايس مْلِيح بَاش وَار ذَايس يتِيڒِي شَا ومْنُوْس ڒَاحقَّاش نتَّا يتݣّ ڒْخذْمث ن سِيذِيثْنغ اَمشْنَاو نش. <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />ئِتْخصَّا ؤُڒَا ذ يجّن وَار ٱث يسحْقَار شَا. عَاوْنم-ث ذݣ ؤُسَفَار نّس بَاش اَغَارِي د يعْقب ذِي ڒهْنَا ڒَاحقَّاش نش تْڒَاجِيغ-ث اَك أَيثْمَاثْنغ.<verse eid="1CO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12" />أُو عْلَاحْسَاب ؤُمَاثْنغ أَپُـوْلُّوْس، تَّارغ زَّايس اَطَّاس حمَا اَغَارْوم د يَاس اَك أَيثْمَاثْنغ نّغْنِي وَلَكِن نتَّا يُوْݣِي اَغَارْوم د يَاس ڒخُّو. أَغَارْوم د يَاس اَخْمِي اَغَارس ثِيڒِي يجّن ن لْفُرْصَا. <verse eid="1CO 16:12" /><verse number="13" style="v" sid="1CO 16:13" />إِڒِيث عْلَابَال، بدّث نِيشَان ذِي لْإِيمَان، إِڒِيث ذ يرْيَازن، إِڒِيث ثْجهْذم. <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />مَارَّا مِين غَا ثݣّم كنِّيو تݣّم-ث س ڒمْحِبّث.<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15‏-16" style="v" sid="1CO 16:15-16" />أَقَا ثسّْنم سِتِيفَانُوْس ذ ڒحْبَاب نّس ذ نِثْنِي إِي يُوْمْنن زِي لْمَسِيح ذ يمزْوُوْرَا ذِي لْإِقْلِيم ن ؤُخَايَا، طوّْعن يخف نْسن اَذ سخَّارن إِ ڒْمُوْمِنِين صَّالِحِين. آي أَيثْمَا، تتَّارغ زَّايْوم اَذ تْثْطَاعم إِ يِوْذَان-أَ اَم يِيْنَا أُو ذ يِنِّي مَارَّا يشَرّْشن ذِي ڒْخذْمث-أَ تَمَارَان ذَايس اَطَّاس. <verse eid="1CO 16:15-16" /><verse number="17" style="v" sid="1CO 16:17" />نش فَرْحغ وَامِي د ؤُسِين سْتِيفَانُوْس ذ فُرْتُوْنَاوْس ذ أَخيكُوْس ڒَاحقَّاش عمَّارن يمُوْشَان نْوم. <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />نِثْنِي سْريَّاحن ؤُڒ ينُو ذ وُوْڒ نْوم. إِيوَا وقَّرث يوْذَان اَم يِيْنَا.<verse eid="1CO 16:18" /></para>
  <para style="s">لْخِتَام ن ثبْرَات-أَ</para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />ثِجُمَاع ن ڒْمُوْمِنِين ذِي لْإِقْلِيم ن آسْيَا تْسدْجَامنْت-يد خَاوم. أَكِيلَاس ذ پْـرِيسْكِيلَا ذ يِنِّي يدْجَان ذِي جْمَاعث ن ڒْمُوْمِنِين ذِي ثدَّارْث نْسن تْسَادْجَامن-د خَاوم اَطَّاس ذِي سِيذِيثْنغ. <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />تْسدْجَامن-د خَاوم مَارَّا أَيثْمَاثْنغ. سدْجَامم خ وَايَاوْيَا س يِجّن ن سْڒَام يصْفَا.<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />سْڒَام-أَ ؤُرِيغ-ث نش بُوْلُس س وفُوْس ينُو. <verse eid="1CO 16:21" /><verse number="22" style="v" sid="1CO 16:22" />ونِّي وَار يخْسن شَا سِيذِيثْنغ اَذ يتْوَاحَارّم. أَرَاح-د آ مَوْلَانَا! <verse eid="1CO 16:22" /><verse number="23" style="v" sid="1CO 16:23" />أَرْضَا ن سِيذِيثْنغ عِيْسَى اَكِذْوم يِيڒِي. <verse eid="1CO 16:23" /><verse number="24" style="v" sid="1CO 16:24" />ڒمْحِبّث ينُو اَكِذْوم ثِيڒِي كنِّيو مَارَّا ذِي عِيْسَى لْمَسِيح. آمِين.<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>