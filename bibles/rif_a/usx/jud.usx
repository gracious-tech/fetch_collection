<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JUD" style="id">- TarifitABS</book>
  <para style="h">يهوذا</para>
  <para style="toc3">يه</para>
  <para style="toc2">ثبرات زي يهوذا</para>
  <para style="toc1">ثَبْرَات زِي يَهُوْذَا غَار ڒْمُوْمِنِين</para>
  <para style="mt1">ثَبْرَات زِي يَهُوْذَا غَار ڒْمُوْمِنِين</para>
  <chapter number="1" style="c" sid="JUD 1" />
  <para style="s">لْمُقَدِّيمَا</para>
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1" />نش ذ يَهُوْذَا<note caller="+" style="f"><char style="fr" closed="false">1‏.1 </char><char style="ft" closed="false">يَهُوْذَا-يَا اَذ يِيڒِي ذ ؤُمَاس ن سِيذِيثْنغ عِيْسَى زݣ يمَّاس.</char></note> ذ اَخدَّام ن عِيْسَى لْمَسِيح، نش ذ ؤُمَاس ن يَعْقُوْب. <char style="it">تَارِيغ ثَبْرَات-أَ</char> إِ يِنِّي إِي د يتْوَارَاغَان، ئِتْحِبَّا-ثن أَربِّـي بَابَاثْنغ، ئِحطَّا-ثن عِيْسَى لْمَسِيح. <verse eid="JUD 1:1" /><verse number="2" style="v" sid="JUD 1:2" />أَذَايْوم ثْمَارْنِي اَرَّاحْمث ذ ڒهْنَا ذ ڒمْحِبّث س وَاطَّاس.<verse eid="JUD 1:2" /></para>
  <para style="s">لْعِقَاب خ يِنِّي يتَارَّان يخف نْسن ذ يمْسڒْمَاذن</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3" />آي يمْعِيزّن ينُو، تُوْغَا رْزُوْغ اَذَاوم اَرِيغ خ ؤُبْرِيذ نِّي إِي زِي نْنجّم نشِّين إِي ذِي نْشَرّش مَارَّا، وَلَكِن ؤُفِيغ أُو لَابُد اَذَاوم اَرِيغ طَّالَب-أَ حمَا اَذ تْمنْغم خ لْإِيمَان-أَ إِي زِي تْوَاكلّْفن صَّالِحِين ذݣ يِجّن ن ثْوَاڒَا إِ ڒبْدَا. <verse eid="JUD 1:3" /><verse number="4" style="v" sid="JUD 1:4" />أَقَا شَا يثَرَّاسن ؤُذْفن-د جَارَاوم وَار ذَاسن د ثَارِّيم بُو ڒخْبَار، قَا لْعِقَاب نْسن يُوْرَا خَاس مشْحَاڒ زݣ وَامِي. يِيْنَا عصَّان أَربِّـي، سْعوَّاجن اَرْضَا نّس بَاش اَغَارْسن يِيڒِي اَم شَان ن تّسْرِيح ن شّهْوث. نكَّرن عِيْسَى لْمَسِيح إِي يدْجَان ذ مَوْلَانَا نّغ قَا نتَّا ذ سِيذِيثْنغ وَاحْذس.<verse eid="JUD 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5" />وَاخَّا سّْنغ بلِّي ثسّْنم مَانَايَا، خْسغ اَكنِّيو سْفكَّرغ مْلِيح بلِّي سِيذِيثْنغ يفكّ شَّعْب نّس زِي مِصْرَا، وَلَكِن منْبَعْد يِنِّي وَار يُوْمِيْنن شَا يمْحَا-ثن قَاع. <verse eid="JUD 1:5" /><verse number="6" style="v" sid="JUD 1:6" />أَمُّو عَاوذ يوقْعن إِ لْمَالَائِكَاث نِّي إِي يُوْݣِين اَذ قِّيمنْت ذِي لْمَرْطَابَا نْسنْت ن سُّلْطَا سمْحنْت عَاوذ ذِي ثْزدِّيغْث نْسنْت. مِين ذَاسنْت يݣَّا؟ ئِقّن-يثنْت س سْنَاسڒ نِّي وَار يفنِّين شَا عمَّارْص، ئِبلّع خَاسنْت ذݣ يِجّن ن ثَادْجسْت ذ ثَبرْشَانْت اَڒ لْعِقَاب ن نْهَار نِّي اَمقّْرَان. <verse eid="JUD 1:6" /><verse number="7" style="v" sid="JUD 1:7" />أَمُّو عَاوذ إِي ݣِّين يمزْذَاغ ذِي <char style="it">ثنْدِينْت نِّي ن</char> سَادُوْم ذ <char style="it">ثنْدِينْت نِّي ن</char> عَمْمُوْرَا ذ يبِيلَاجن نِّي إِي ذَاسنْت-يد ينّضن. سلّْمن يخف نْسن إِ لْفَسَاد ذ شّهْوث نِّي مَاشِي طَّبِيعِي. يعْنِي نِثْنِي يݣِّي-ثن أَربِّي ذ لْعِبْرَا، تْوَاعَاقْبن س يِجّن ن لْعِقَاب ن ثْمسِّي وَار يفنِّين شَا عمَّارْص.<verse eid="JUD 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8" />أَمُّو عَاوذ يثَرَّاسن-أَ. عْلَاحْسَاب ثِيْرْجَا نْسن سخْنَازن دَّات نْسن، نكَّرن سُّلْطَا، قَّارن اَوَاڒن وَار يحْڒِين خ لْمخْلُوْقَاث ن ؤُجنَّا. <verse eid="JUD 1:8" /><verse number="9" style="v" sid="JUD 1:9" />وَلَكِن مِين يݣَّا لْمَلَاك اَمقّْرَان مِيْكَائِيل وَامِي يمْنغ اَك إِبْڒِيس يمْنَاقَر اَكِذس خ دَّات يمُّوْثن ن مُوْسَى؟ وَاخَّا ذ مِيْكَائِيل-أَ وَار يزْعِيم شَا اَذ يِينِي شَا ن وَاوَاڒ وَار يحْڒِين خ إِبْڒِيس، ينَّا-ٱس شك اَش ينْهَا سِيذِي أَربِّـي! <verse eid="JUD 1:9" /><verse number="10" style="v" sid="JUD 1:10" />وَلَكِن يثَرَّاسن-أَ يِيْنَا سَّاوَاڒن س وَاوَاڒ وَار يحْڒِين خ مَارَّا مِين وَار فهّْمن شَا. ثِمسْڒَايِين-أَ ؤُمِي فهّْمن إِيوَا فهّْمن-ثنْت س طَّبِيعَا نْسن وَاهَا، نِثْنِي ݣِّين اَم ڒُوْحُوْش يقفْڒن. ثِمسْڒَايِين-أَ ذ نِثنْتِي إِي ثن غَا يمْحَان!<verse eid="JUD 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JUD 1:11" />يَا ڒفْضِيحث نْسن! تبْعن اَبْرِيذ نِّي ن قَبِيل. سمْحن ذݣ يِيخف نْسن ضمْعن ذِي تْمنْيَاث ݣُّوْرن ذِي لْغَالط ن بَلْعَام. فْنَان ذِي لْحِرَاك نِّي ن قُرَاح <char style="it">وَامِي يعَارّض إِ مُوْسَى</char>. <verse eid="JUD 1:11" /><verse number="12" style="v" sid="JUD 1:12" />يثَرَّاسن-أَ يِيْنَا تْوسَّاخن يمنْسِيون نْوم ن ثمْعَاشَرْث. تتّن اَكِذْوم بْڒَا مَا ٱذ سذْحَان، نِثْنِي ݣِّين اَم شَا ن يمكْسَاون إِي عتّْقن يخف نْسن وَاهَا. نِثْنِي ذ يسيْنُوْثن بْڒَا يَانْࢲَار غِير يتَاوِي-ثن اَرِّيح يتَارَّا-ثن. نِثْنِي ݣِّين اَم ثْشجُّوْرَا ذِي ڒخْڒِيف وَار يتَارْون شَا، تْنقْڒَاعنْت-يد زݣ يࢲوْرَان نْسنْت؛ يعْنِي يبْرِيذن نْسنْت مُّوْثن س ثْنَاين. <verse eid="JUD 1:12" /><verse number="13" style="v" sid="JUD 1:13" />نِثْنِي ݣِّين اَم ڒمْوَاج ن ڒبْحَر شَّاثنْت س ڒفْضِيحث ن ؤُكُوْفُّو نْسنْت. نِثْنِي ݣِّين اَم شَان يثْرَان يفّْغن زݣ ؤُمْشَان نْسن ݣُّوْرن غَار يِجّن ن ثَادْجسْت ذ ثَبرْشَانْت إِݣ يتْوَاسْوجْذن إِ ڒبْدَا ن ڒبْدَاث.<verse eid="JUD 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14" />فَا أَخْنُوْخ ونِّي إِݣ يدْجَان ذ اَيَّاو ن آدَم زِي جدِّيثْوم وِيس سبْعَا<note caller="+" style="f"><char style="fr" closed="false">1‏.14 </char><char style="ft" closed="false">خْزَر لْكِتَاب ن لُوْقَا، ؤُذم وِيس 3 زِي لْأَيَاث 37‏-38: آدَم يجَّا-د شُوْث، شُوْث يجَّا-د أَنُوْش، أَنُوْش يجَّا-د قِيْنَان، قِيْنَان يجَّا-د مُهَلِّيل، مُهَلِّيل يجَّا-د يَارِد، يَارِد يجَّا-د أَخْنُوْخ.</char></note> نتَّا يعْڒم يجّن ن وَاوَاڒ زِي أَربِّـي ينَّا-ث خ يثَرَّاسن-أَ: "خْزَرث، أَقَا يُوْسَا-د سِيذِيثْنغ س وَاڒَاف ن ؤُڒُوْفَاث ن يمْقدّْسن نّس <verse eid="JUD 1:14" /><verse number="15" style="v" sid="JUD 1:15" />أَذ يحَاسب مَارَّا يوْذَان. مَارَّا يِنِّي يعصَّان اَذَاسن د يسْمظْهَار مَارَّا ڒفْعَايڒ نْسن ثِعفَّانِين إِي ݣِّين ذݣ ؤُبْرِيذ نْسن اَعفَّان، أَذ سّْنن عَاوذ مَارَّا اَوَاڒن نِّي وَار يحْڒِين إِي خَاس نَّان يِنِّي يعصَّان وَار ذفَّارن شَا أَربِّـي." <verse eid="JUD 1:15" /><verse number="16" style="v" sid="JUD 1:16" />شُوْف، يثَرَّاسن-أَ تْشثْشَان وَاهَا، تنْتَاقَاذن خ مِدّن، نِثْنِي ذفَّارن شّهَاوَاث نْسن ثِعفَّانِين؛ سمْغَارن يخف نْسن س ؤُقمُّوْم نْسن، تسْڒهَّان يوْذَان بَاش اَذ نفّْعن يخف نْسن.<verse eid="JUD 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17" />فَا كنِّيو آي يمْعِيزّن ينُو، فكَّرث مِين تُوْغَا قَّارن زِي قْبڒ اَرُّسُل ن سِيذِيثْنغ عِيْسَى لْمَسِيح. <verse eid="JUD 1:17" /><verse number="18" style="v" sid="JUD 1:18" />نَّان-اَوم: "ذِي ڒِيَّام نِّي ينݣُّوْرَا اَذ يڒِين مُجُوْدِين يِنِّي يذحّْشن خ يِوْذَان، ذفَّارن شّهَاوَاث نْسن ثِعفَّانِين وَاهَا." <verse eid="JUD 1:18" /><verse number="19" style="v" sid="JUD 1:19" />إِيوَا نِثْنِي ذ يِيْنَا إِي كنِّيو يفَرّْقن، ذَايْسن اَرُّوْح ن دُّوشْت-أَ وَاهَا وَار ذَايْسن شَا أَرُّوْح يقدّْسن.<verse eid="JUD 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JUD 1:20" />كنِّيو آي يمْعِيزّن ينُو، بْنَاث يخف نْوم ذِي دْسَاس ن لْإِيمَان يُوْعْڒَان إِي يدْجَان ذَايْوم، ࢲَادْجم س أَرُّوْح يقدّْسن. <verse eid="JUD 1:20" /><verse number="21" style="v" sid="JUD 1:21" />ئِتْخصَّا اَذ تقِّيمم ذِي ڒمْحِبّث ن أَربِّـي اَذ تْرَاجَام اَرَّاحْمث نِّي ن سِيذِيثْنغ عِيْسَى لْمَسِيح ثنِّي إِي كنِّيو يتَاوِين غَار ثُوْذَارْث نِّي وَار يفنِّين شَا عمَّارْص.<verse eid="JUD 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22" />سْخذْمث لْحَنَانَا اَك يِنِّي يتْشكَّان. <verse eid="JUD 1:22" /><verse number="23" style="v" sid="JUD 1:23" />فكّث ينّغْنِي، جبْذم-ثن-د زِي ثْمسِّي. ئِنّغْنِي سْبِيّْنم-اَسن-د اَرَّاحْمث ثمْخلّط اَك ثِيْݣّْوْذِي يعْنِي اَذ تْعِيفّم ؤُڒَا ذ اَرُّوْض نْسن إِݣ يخنْزن س طَّبِيعَا نْسن ثَعفَّانْت.<verse eid="JUD 1:23" /></para>
  <para style="s">لْخِتَام ن ثبْرَات-أَ</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24" />فَا ونِّي يزمَّرن اَكنِّيو يحْضَا بَاش وَار تنْذْڒِيفم شَا، ئِزمَّر عَاوذ اَكنِّيو يقدّم غَار زَّاث نّس لْعَظِيم اَذ تِيڒِيم بْڒَا ڒْعِيب اَغَارْوم ثِيڒِي يجّن ن ڒفْرَاحث ذ ثَمقّْرَانْت، <verse eid="JUD 1:24" /><verse number="25" style="v" sid="JUD 1:25" />يعْنِي أَربِّـي ونِّي يدْجَان وَاحْذس يسنْجَام-اَنغ. أَغَارس ثِيڒِي لْعَظَمَا ذ ثُوْعْڒَات ذ لْقُوَّا ذ سُّلْطَا س عِيْسَى لْمَسِيح سِيذِثْنغ يعْنِي قْبڒ إِ مَارَّا زْمَانَاث إِي يعْذُوْن أُو ذ ڒخُّو أُو ذ ڒبْدَا ن ڒبْدَاث. آمِين.<verse eid="JUD 1:25" /></para>
  <chapter eid="JUD 1" />
</usx>