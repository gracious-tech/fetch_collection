<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Bamunka NewTestament</book>
  <para style="h">Filimu</para>
  <para style="toc1">Ŋwɔʼnə ndə Bɔɔ kə nyɔ̀ʼ kɔ́ tə Filimu</para>
  <para style="toc2">Filimu</para>
  <para style="toc3">Flm</para>
  <para style="mt2">Ŋwɔʼnə ndə Bɔɔ kə nyɔ̀ʼ kɔ́ tʉ</para>
  <para style="mt1">Filimu</para>
  <para style="imt">Nchoʼtə bətʉ bənu</para>
  <para style="ip">Nɔ nyɔ̀ʼ Bɔɔ nyɔ̀ʼ ŋwɔʼnə-ɔ̄ŋ kɔ́ tʉ Filimu kə́ fʉ̀ʉtə ɔŋ mbɔ tíŋ hə bɔ̌ŋ ŋkʉ̂ʉ, ɔ la lʉ̀ Onisimu təmə lʉ̀ ɔ bɛ nə fʉə fɛ, bɔŋ bə nə liŋ-iŋ mu Nyii. Mbʉ ŋwɔʼnə nɔ tʉʼ fʉ̀ʼtə ŋkwɛnə ndə i nɔʼ gwè mu məchímbi Onisimu. Filimu nɔ nə bɛ wo ndə bə nə kɛŋ kínə ɔŋ jyujyu nə wo ndə ɔ nɔʼ bɛ́ŋ Nyii mu lɔʼɔ Kolose. Onisimu nɔ nə bɛ fʉə-e ndə ɔ nɔʼ nə nyʉ́ʉ nə wi. Ndʉʉ ndə ɔ kə nyʉ́ʉ le, ɔ bìatə Bɔɔ bɔŋleʼ bɛ́ŋ Nyii mu kəghɔ-ɔ.</para>
  <para style="iot">Nubə ndə i bɛ mu ŋwɔʼnə-fɛ̄ŋ</para>
  <para style="io1">Nchʉʉhə-bənu 1-3</para>
  <para style="io1">Məchʉ̀ʉ Filimu 4-7</para>
  <para style="io1">Məfʉ̀ʉtə yie Onisimu 8-22</para>
  <para style="io1">Liʼ-bənu 23-25</para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="s">Nchaʼtə ndə i gwè hə kəghɔ-Bɔɔ</para>
  <para style="m">
    <verse number="1" style="v" sid="PHM 1:1" />Nɔ nyɔ̀ʼ mbəŋ-ɔŋ Bɔɔ nyɔ̀ʼ ŋwɔʼnə-ɔ̄ŋ ndə mɔ bɛ wo-njaa-chaŋ bʉʼka Klai Jiso baʼa Timɔti liŋ-yʉʼʉ.</para>
  <para style="p" vid="PHM 1:1">Kə́ nyɔ̀ʼ tʉ Filimu ndə ɔ bɛ ŋkɛŋ tieŋkɔŋ-yaʼ ndə baʼa bɔŋ tʉʼ fɔ̀ʼ mɔʼɔ. <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />Kə leʼ nyɔ̀ʼ ghɔ tʉ Afia liŋ-yʉʼʉ woke leʼnə Akibu, wo bəsɔge ndə bʉ̂ʼʉ bɔŋ tʉʼ mɔ̀ʼ chɔ̂ Nyii mɔʼɔ, leʼnə chɔshi ndə i bɛ mu njaa-a.<verse eid="PHM 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />Tə Nyii mbʉ Tie-yʉʼʉ ghɔŋbə Tiekətʉ-yʉʼʉ Jiso Klai dʉ̀ʼ buuŋjyu tʉ bii bɔŋleʼ kɔ́ bii nə fyiighʉ́ənə.<verse eid="PHM 1:3" /></para>
  <para style="s">Ŋkʉ̂ʉ Filimu leʼnə məmɔʼfyii-i ndəŋ Nyii</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />Filimu liŋ-ɔŋ, ndʉʉtəmiyɔŋ ndə mɔ tʉʼ gháaNyii yie-a nɔ, mɔ kɔ́ ndɔ tʉ Nyii bʉʼka a. <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />Bʉʼka mɔ nɔ yʉ́ ntɛ ŋkʉ̂ʉ ndə a kie tʉ bʉə-Nyii leʼnə məmɔ̀ʼfyii ndə a kie tʉ Jiso Tiekətʉ. <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />Mɔ nɔ tʉʼ gháaNyii tʉ a mbɔ məgètə fɔbə ndə bʉʼʉ tʉʼ gètə ndə bʉə ndə bɔ̂ŋ nɔʼ mɔ̀ʼfyiihə-ʉə ndəŋ Nyii bu chìi ä shʉ̀tə kínə nu-jyujyu-bə inchəŋ ndə bʉʼʉ kie mu məchimbi-bʉʼʉ bʉʼka bʉʼʉ nɔʼ fúu ŋwɔŋ-yʉʼʉ bʉʼʉbə Klai. <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />Liŋ-ɔŋ, ŋkʉ̂ʉ-a nɔʼ kɔ́ tʉʉjyu tʉ mɔ daa bɔŋleʼ kwèʼhə mɔ, bʉʼka a nɔʼ chìi fʉʉkə tɔ́ ndəŋ bʉə-Nyii.<verse eid="PHM 1:7" /></para>
  <para style="s">Bɔɔ fʉ̀ʉtə Filimu bʉʼka Onisimu</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />Bʉʼka yɔ̄ŋ-yə bəkɔ mɔ kie fyii shʉ́əshʉ́ə nə liŋ-aŋ mu Klai ndə məkàhə a mbɔ ä fɔ̀ʼ nukə ndə a kie ndə məfɔ̀ʼ. <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />Bɔŋ bʉʼka mɔ kʉ̀ʉ a, mɔ nɔ tʉʼ fʉ̀ʉtəfʉ̀ʉtə. Mɔ nɔ tʉʼ fʉ̀ʉtə a nə Bɔɔ, woghəŋ ndə mɔ bɛ nduɔ mu njaa-chaŋ bʉʼka Klai Jiso.<verse eid="PHM 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PHM 1:10" />Mɔ nɔ tʉʼ fʉ̀ʉtə a bʉʼka vaa-ɔŋ, Onisimu, ndə mɔ kə bɛ tie-e ndʉʉ ndə mɔ bɛ mu njaa-chaŋ. <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />Ɔ nɔ nə fəŋ bɛ fɔ-njʉnjʉ-kə tʉ a bɔŋ nduɔ ɔ nɔ bɛ yʉʼ wo tʉ a leʼnə mbəŋ-ɔŋ. <verse eid="PHM 1:11" /><verse number="12" style="v" sid="PHM 1:12" />Mɔ nɔ tʉʼ bʉ̀nə tə́ŋ ɔŋ kɔ́ tʉ a, bɔŋ kɛŋ kə́ tə́ŋ bə vaafyii-ɔ.<verse eid="PHM 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PHM 1:13" />Tʉʉ-ɔ nɔ kə́ kʉ́ʉ bɛ jyujyu ndə məmɛ̀ʼtə ɔŋ fɛ̄ŋ, ɔ kə́ fɔ̀ʼ tʉ mɔ yie-a ndʉʉ ndə mɔ bɛ mu njaa-chaŋ bʉʼka ntəŋjyujyu. <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />Bɔŋ təmə mɔ kʉ̀ʉ ndə məchìi nukə yie-a təmə a kínə fɛ, bʉʼka məfɔ̀ʼ bʉʉ-a mə yi bɛ fi nə mɔ tʉʼ kwɛ̀ŋhə aŋ kwɛ̀ŋhə. Bɔŋ mɔ nɔ kʉ̀ʉ mbɔ ï bɛ ndə ya-yə ŋkʉʉnə tʉʉ. <verse eid="PHM 1:14" /><verse number="15" style="v" sid="PHM 1:15" />Ndʉʉbɛʼ nɔ bɛ luu-i nɔ ndə Nyii kə mɛ̀ʼtə ɔŋ ɔ̈ kwɛ̀ʼtə mbʉə-a ndəŋ kʉʉkə məniʼ mbɔ ɔ chʉʼ bʉ̀nə gwè tʉ a vɛʼ mɔʼ gɛ̀ nə shʉbə, <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />təmə leʼ bɛ bə haʼ fʉə tʉ a fɛ, bɔŋ bu chàa fʉə tə bɛ ndə ŋkɛŋ liŋ-aŋ. Mɔ nɔ kʉ̀ʉ ɔ yɔ́ŋyɔ́ŋ a bɔŋ bu kʉ̀ʉ ɔ tə chàa mɔ ndə fʉə-a leʼnə liŋ-aŋ ndə bii ɔ bɛ mu Tiekətʉ.<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />Kaʼ a nyíɛ mbɔ mɔ leʼ bɛ wo ndə bii ɔ tʉʼ fɔ̀ʼ mɔʼɔ, ä lʉ̀ ɔ haʼ ndə a lʉ̀ mɔ. <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />Kaʼ ɔ nɔʼ mɔ̀ʼ bɛ́ tʉ a, byuunɔ ŋkwo-a kə́ bɛ bətɔ-ɔ, a nyɔ̀ʼ yie-mɔ. <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />Nduɔ, mɔ bu nyɔ̀ʼ yɔ̄ŋ-yə nə yɔŋ-yə ghɔkə mbɔ, “Mbəŋ-ɔŋ, Bɔɔ, bu bʉ̀nə lɔ̀ʼ ŋkwo-a.” Təmə mɔ bɔŋ kʉʉ kwɛ́nə tʉ a mbɔ a bɛ woŋkwo tʉ mɔ nə ŋkwê kətʉ-a fɛ, bʉʼka mbɔ mɔ nɔ kwáa a ghɔ ndə məbɛ́ŋ Jiso Klai.<verse eid="PHM 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PHM 1:20" />Ɔŋ liŋ, mɔ nɔ tʉʼ kʉ́ʉ yú sii kəghɔ-a ndə wo ndə ɔ bɛ́ŋ Tiekətʉ. Chìi f̈ʉʉkə tɔ́ mbʉə-mɔ mu Klai. <verse eid="PHM 1:20" /><verse number="21" style="v" sid="PHM 1:21" />Mɔ nɔ tʉʼ nyɔ̀ʼ yɔ̄ŋ-yə tʉ a nə fyii ɔ i tə́nə kə́ kínə mbɔ a bu fɔ̀ʼ nukə ndə mɔ tʉʼ bíʼtə tʉ a, tə buŋ fɔ̀ʼ i chàa nɔ.<verse eid="PHM 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PHM 1:22" />Ndə məbìʼ chɔ, shʉ̀tə njəŋ-njaa-bʉə-mətòʼ tʉ́ʼ tʉ mɔ, bʉʼka mɔ nɔ tʉʼ chyìi nə fyii shʉ́əshʉ́ə mbɔ Nyii bu yʉ́ məghaaNyii-yii byʉ̀hə mɔ kɔ́ tʉ bii.<verse eid="PHM 1:22" /></para>
  <para style="s">Ndyiʼtə-nchaʼtə-Bɔɔ-kə</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />Ebafla ndə baʼa ɔ bɛ chaŋ mɔʼɔ bʉʼka Klai Jiso nɔ tə́ŋ nchaʼtə tʉ a, <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />ghɔŋbə Mak, Alistaku, Dɛma leʼnə Luk kə́ bɛ bʉə ndə baʼa bɔŋ tʉʼ fɔ̀ʼ mɔʼɔ. <verse eid="PHM 1:24" /><verse number="25" style="v" sid="PHM 1:25" />Tə Jiso Klai Tiekətʉ dʉ̀ʼ buuŋjyu-i tʉ bii mu fyii-bii.<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>