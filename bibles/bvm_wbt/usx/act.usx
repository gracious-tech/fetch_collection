<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- Bamunka New Testament</book>
  <para style="h">Fɔʼɔ</para>
  <para style="toc1">Ŋwɔʼnə Fɔʼɔ Vâafɔʼɔ Jiso ndə Luk kə fʉ̀ʼtə</para>
  <para style="toc2">Fɔʼɔ</para>
  <para style="toc3">Fɔʼ</para>
  <para style="mt2">Ŋwɔʼnə</para>
  <para style="mt1">Fɔʼɔ-Vâafɔʼɔ-Jiso</para>
  <para style="mt2">ndə Luk kə fʉ̀ʼtə</para>
  <para style="imt">Nchoʼtə bətʉ bənu</para>
  <para style="ip">Ŋwɔʼnə-fɔʼɔ-vâafɔʼɔ-Jiso-bɔ̄ŋ nɔ nə bɛ biitə-ŋwɔʼnə-kə ndə Luk nə nyɔ̀ʼ ndə mə-bìʼ-kə́-fʉ̀ʼtə nubə ndə ɔ nɔʼ kə chʉ́ʉhə ndə məfʉ̀ʼtə mu fəŋ ŋwɔʼnə-i. Luk nɔ kə nyɔ̀ʼ mbɔ fəŋ ŋwɔʼnə-i la nə bɛ ntəŋjyujyu ndə ɔ nə fʉ̀ʼtə. Fɔŋ-kənu ndə ɔ kə nyɔ̀ʼ ŋwɔʼnə-ɔ̄ŋ bʉʼka yɔŋ nɔ nə bɛ ndə məfʉ̀ʼtə ntɛhə ndə bəlɔntəŋ Jiso kə gɛ̀ nə shʉbə ndə məlɔ̀ʼ ntəŋjyujyu te Jiso mu Judia ghɔŋbə Samalia leʼnə yəŋbə inchəŋ mu kəwʉʉnəmbi. Luk nɔ chìi bʉʼʉ kínə mbɔ bɔ̂ŋ la fɔ̀ʼ fɔʼɔ-ɔ̄ tíŋ hə bə ndəŋ ghʉəʼ-kəLyʉʉhəNyii-kə. Ɔ fʉ̀ʼtə mbɔ Bita ghɔŋ Bɔɔ la kə fyú tə́nə ndə məbɛ bəntəŋbəshʉ mu chɔshi vɛʼ-ghɔ̄. Nɔ nə bɛ vɛʼ-ghɔ̄ chɔshi kə́ gʉ́ə daa buŋ ndə nɔ, bɔ̂ŋ nɔ nə kə́ tíŋ hə mu nu-shʉ́əshʉ́ə-bə buŋmbi hə kəghɔ-bəntəŋbəshʉ-bʉə-Juu ghɔŋbə bəntəŋbəshʉ-bʉə-Luŋ.</para>
  <para style="ip">Bəkɔ bə gyʉ̀əhə mbʉ ŋwɔʼnə ndə bəŋkwe bəvia itia. Fəŋ kəvia nɔ bɛ te ntɛhə ndə məbɛ́ŋ Jiso kə chʉ́ʉhə mu Jɛlosalɛŋ ndʉʉ ndə Jiso nɔʼ kə kóʼ gɛ̀ yuo. Biitə-kəyəŋ-kə nɔ bɛ te ntɛhə ndə məbɛ́ŋ Jiso kə tòʼ dàa ndəŋ bəbɛʼbə yəŋbə mu Balistiŋ. Ndyiʼtə-kəyəŋ-kə kə́ bɛ nubə te məmɔ̀ʼfyii ndəŋ Jiso ndə I kə tòʼ dàa ndəŋ mbia-lɔʼɔ-bətə̂ŋ-bə ndə I kə bɛ mbʉə wʉʉnəmbi-Mɛditɛlenia-kə bìʼ gɛ̀ loo tə gɛ̀ dàa mu lɔʼɔ Luŋ.</para>
  <para style="ip">Nukwɛʼtəŋkə ndə mənyíɛ mu ŋwɔʼnə-fɛ̄ŋ nɔ bɛ fɔʼɔ-kəLyʉʉhəNyii. Mbʉ kəlyʉʉhə nɔ kə shíʼ gwè nə ghʉəʼkə ndəŋ bʉə ndə bɔ̂ŋ nɔʼ kə bɛ́ŋ Nyii ndə chî-Bɛŋntaku-kə, bɔŋleʼ kə́ gɛ̀ nə shʉbə dʉ̀ʼ fia tʉ bɔŋ bɔŋleʼ kə́ kɔ́ ghʉəʼkə tʉ bɔŋ ghɔŋbə bəntəŋbəshʉ. Ntəŋ ndə bʉə ndə bɔ̂ŋ nɔʼ kə bɛ́ŋ Nyii nə kə lɔ̀ʼ nɔ bɛ mu ŋgieNyiikə ndə bɔ̂ŋ nə kə́ lɔ̀ʼ mu ŋwɔʼnə-fɛ̄ŋ. Mbʉ kəŋgie nɔ kə dʉ̀ʼ mbɔ i la kə kie ghʉəʼkə tíŋ hə bɔ̌ŋ ntɛhə ndə i kə kə̀ŋ məchimbi-mbʉ-bʉə ndə bɔŋ nɔʼ kə bɛ́ŋ Nyii.</para>
  <para style="iot">Nubə ndə i bɛ mu ŋwɔʼnə-fɛ̄ŋ</para>
  <para style="io1">Mbʉ vâafɔʼɔ shʉ̀tə ŋwɔŋ-yʉə ndə məgɛ̀ lɔʼ mbʉ ntəŋ 1:1-26</para>
  <para style="io1">1. Ndyiʼtə-ŋkahə-Jiso-kə ghɔŋbə ŋkɔʼnə 1:1-14</para>
  <para style="io1">2. Nju-Juda 1:15-26</para>
  <para style="io1">Məgɛ̀ lɔʼ mbʉ ntəŋ mu Jɛlosalɛŋ 2:1–8:3</para>
  <para style="io1">Məgɛ̀ lɔʼ mbʉ ntəŋ mu Judia ghɔŋbə Samalia 8:4–12:25</para>
  <para style="io1">Fɔʼɔ-Bɔɔ 13:1–28:31</para>
  <para style="io1">1. Fəŋ məgɛ̀ mbi ndə fɔʼɔ 13:1–14:28</para>
  <para style="io1">2. Nchəŋtə mu Jɛlosalɛŋ 15:1-35</para>
  <para style="io1">3. Vɛʼ bûu ndə məgɛ̀ mbi ndə fɔʼɔ 15:36–18:22</para>
  <para style="io1">4. Vɛʼ tia ndə məgɛ̀ mbi ndə fɔʼɔ 18:23–21:16</para>
  <para style="io1">5. Bɔɔ bɛ wo-njaa-chaŋ mu Jɛlosalɛŋ, Kasalia leʼnə Luŋ 21:17–28:31</para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="s">Ŋkɔʼnə-kəLyʉʉhəNyii</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />Tie-ɔ Tiofilo, mu fəŋ ŋwɔʼnə-ɔŋ, mɔ nɔʼ nyɔ̀ʼ nubə nchəŋnchəŋ ndə Jiso kə chʉ́ʉhə ndə məfɔ̀ʼ bɔŋleʼ dàhə, <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />tə gɛ̀ dàa ndəŋ chîkə ndə bə kə lʉ̀ ɔ, gɛ̀ nə nɔŋ yuo, ɔ nɔ nə kə̂ gɛ̀ yuo, tʉ ɔ nɔʼ kə kɔ́ bəŋkahə-bi tíŋ hə bɔ̌ŋ LyʉʉhəNyiikə tʉ bəlɔntəŋ-bi ndə ɔ nɔʼ kə séʼ bɔŋ. <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />Ndʉʉ ndə ɔ kə nyíɛ ŋgʉəʼ-ɛ liʼ, ɔ tɛ́ʼ ŋwɔŋ-ɛŋ tʉ bɔŋ ŋɛnə ndəŋ fiatə buŋmbi ndə bə mə jínə fɛ, mu chîbə wuŋ kwi, ɔ kə́ kwə́ʼ tʉ bɔŋ te Sɔ́ʼ-Nyii.<verse eid="ACT 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 1:4" />Vɛʼbɛʼ ndə ghɔŋbə Jiso kə́ chí mɔʼɔ, ɔ kàhə bɔŋ mbɔ, <char style="wj">“Kə bii mə shi lɔ̀ hə Jɛlosalɛŋ fɛ, bɔŋ b̈ii shi kʉ̀ʼ ŋkɔʼnə-Nyii ndə bii kə yʉ́ hə chu-mɔ.</char> <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" /><char style="wj">Bʉʼka, bii nɔ kə fí muu hə kəghɔ-Jɔŋ bɔŋ mbyu-bəchî-hə məniʼ bii bu fí LyʉʉhəNyiikə.”</char><verse eid="ACT 1:5" /></para>
  <para style="s">Bə lʉ̀ Jiso, kóʼ gɛ̀ nə nɔŋ yuo</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />Kʉ̂ʉ kə bɛ ndʉʉ ndə bɔ̂ŋ chə̀ŋtə kəyəŋ kəmɔʼ, bɔ̂ŋ bíʼtə tʉ Jiso mbɔ, “Tiekətʉ, bɛ ndʉʉ nɔ ndə a bu byʉ̀hə ghʉəʼkə chɔ kɔ́ kəghɔ-bʉə-Isilɛ mɛ?”<verse eid="ACT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7" />Ɔ bə̀ŋhə mbɔ, <char style="wj">“Kaa yəŋkə-ii ndə məkínə ŋgwɔʼmbi byuunɔ ndʉʉ ndə Nyii mbʉ Tie nɔʼ shʉ̀tə tʉ́ʼ nə ghʉəʼkə-i fɛ.</char> <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" /><char style="wj">Bɔŋ bə bu kɔ́ ghʉəʼkə tʉ bii, ndʉʉ ndə LyʉʉhəNyiikə bu shíʼ ndəŋ bii, ndʉʉmɛ bii bu lɔ̀ʼ wo ndə mɔ bɛ yɔŋ tʉ bʉə mu Jɛlosalɛŋ, mu Judia inchəŋ ghɔŋbə mu Samalia tə gɛ̀ dàa liʼ mbi.”</char><verse eid="ACT 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 1:9" />Ndʉʉ ndə ɔ gìe nubə-ɔ̄ŋ inchəŋ, ndə bɔ̂ŋ kə́ lɛ́nə ɔŋ, bə chɔ̀ʼhə ɔŋ, gɛ̀ nə nɔŋ yuo, mbɔʼkə lìihə ɔŋ hə shʉ-bɔŋ. <verse eid="ACT 1:9" /><verse number="10" style="v" sid="ACT 1:10" />Ndə bɔ̂ŋ kə́ bíe lɛ́nə yuo ndə ɔ kə́ gɛ̀, kə kwɔnə nyíɛ, bʉə bəbûu ndə bɔ̂ŋ mɔ̀ʼ ndyi-kəfyuʼ-hə kə́ tə́nə mbʉə bɔŋ, <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />ghɔ̀ŋ mbɔ, “Bʉə-Galili, bii tə́nə kə́ lɛ́nə yuo mbuka? Jiso-ɔ̄ ndə bə lʉ̀ ɔ kəghɔ-bii gɛ̀ nə nɔŋ yuo nɔ, bu bʉ̀nə haʼ ndə ɔ gɛ̀.”<figure style="fig" alt="Jesus taken to heaven" file="DN00497b.tif" size="col" copy="Darwin Dunham" ref="1:11">Jiso kóʼ gɛ̀ yuo</figure><verse eid="ACT 1:11" /></para>
  <para style="s">Bə séʼ Matia ndə ntyukətʉ Juda</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />Ndʉʉmɛ, bɔ̂ŋ bʉ̀nə shíʼ hə ndəŋ Kwɔŋ-bəTyʉ-Oli, gɛ̀ Jɛlosalɛŋ, ndə bɔ̂ŋ kə kie ndə mətòʼ toʼo nə bəghǔu təghyʉʉ tətaa ndə mədàa mu kəyəŋkwɛʼtəŋ. <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />Ndʉʉ ndə bɔ̂ŋ kə ŋíi mu mbʉ kəyəŋkwɛʼtəŋ, bɔ̂ŋ kóʼ gɛ̀ mu njəŋ njaa kweghɔʼ kəyəŋ ndə bɔ̂ŋ kə́ chí chɔ, nɔ kə bɛ Bita, Jɔŋ, Jɛŋ, Andolo, Fili, Tɔmɔ, Batolomiɛ, Matia, Jɛŋ vaa-Afio, Samu ndə ɔ bɛ tiɛŋ-lɔʼɔ leʼnə Juda vaa-Jɛŋ.<verse eid="ACT 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 1:14" />Bʉə-bɔ̄ŋ bənchəŋ nə gyʉʉ imɔʼ kɔ́ fyiihə-ʉə ndə məgháaNyii, ghɔŋbə bəke leʼnə Mɛli ŋkwê-Jiso leʼnə bəliŋ-Jiso bi-bələŋ-bə.<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />Mu bəchî-ghɔ̄, Bita lɔ̀ tə́nə mu vâafɔʼɔ-Jiso ndə bɛ nuɔ-bʉə ghyʉʉ nə bʉə wuŋ bûu ndə bɔ̂ŋ kə chə̀ŋtə, ghɔ̀ŋ mbɔ,<verse eid="ACT 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 1:16" />“Bəliŋ-bɔŋ, nukə ndə ŋwɔʼnə-Nyii kə gìe nɔ kie ndə məfyú shʉəŋ, ndə LyʉʉhəNyiikə kə gìe tíŋ hə bɔ̌ŋ Dɛbi lʉ̀ hə ŋgʉʼʉbɛʼ te nə Juda, ndə ɔ kə dʉ̀ʼ fia tʉ bʉə ndə bɔ̂ŋ kə yá Jiso. <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />Bʉʼka bə nɔ nə súu ɔ nuɔ-bʉʼʉ, mbɔ ɔ kie yi-yə yʉʉ mu fɔʼɔ-yʉʼʉ.”<verse eid="ACT 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18" />(Nduɔ, wo-ɔ̄ nyúɔ tɔ̂kə nə kyʉə ndə bə lɔ̀ʼ ɔ chɔ ndəŋ bʉ̂ʼʉ ndə ɔ kə chìi, ɔ gwù sê nə tʉkə-i, sáanə ntəŋntəŋ, njyii-bətɔ-mə-i inchəŋ fìetə fyú mbi. <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />Bʉə-Jɛlosalɛŋ bənchəŋ yʉ́ nukə-ɔ̄ŋ, nɔ kə chìi yɔŋ bɔ̂ŋ tíi mbʉ kətɔ̂ kəŋgie lɔʼɔbə-ɔŋ nə Akedama, ndə i bɛ mbɔ yəŋkə ndə fɔbʉəkə tyùnə chɔ.)<verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />Bita bʉ̀nə bìʼ ghɔ̀ŋ mbɔ, “Bə nɔ kə nyɔ̀ʼ mu Ŋwɔʼnə-təLyuu mbɔ, ‘Tə njaa-ɛ nə nʉ̀ʉ fuŋ, kə wo mə nə chí muŋgɔ fɛ, tə wokədɔŋ nə yú yəŋ-fɔʼɔ-kə-i.’ <verse eid="ACT 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21" />“Nduɔ, bʉʼʉ nɔ kie ndə məséʼ mbyu wo, kə́ bɛ wo ndə bʉʼʉ bɔŋ nɔʼ kə bɛ mɔʼɔ vɛʼ inchəŋ ndə bʉʼʉbə Jiso Tiekətʉ kə́ tòʼ kəwʉʉnəmbi-fɛ̄ŋ, <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />lʉ̀ hə ndəŋ chî-Jɔŋ-kə ndə ɔ̃ kɔ́ muu tə gɛ̀ dàa ndəŋ chîkə ndə bə kə lʉ̀ ɔ hə kəghɔ-bʉʼʉ, kóʼ nə nɔŋ yuo. Mbyu wo hə mu bʉə-bɔ̄ŋ nɔ kie ndə məbìa bʉʼʉ ndə məfʉ̀ʼtə məbʉ̀nə kóʼ Jiso.”<verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />Bɔ̂ŋ fyúhə bʉə bəbûu tʉ́ʼ, Jɔsɛ ndə bə kə́ tíi ɔ nə Basaba, yie-ebɛʼ kə́ bɛ Jusutu, ghɔŋbə Matia. <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />Bɔ̂ŋ gháaNyii ghɔ̀ŋ mbɔ, “Mbəŋ-aŋ Tiekətʉ, ndə a kínə fyii-bʉə-hə bənchəŋ, dʉ̀ʼ wo tʉ baʼa mu bʉə-bɔ̄ŋ bəbûu ndə a nɔʼ séʼ ɔ, <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />mbɔ ɔ chʉʼ kie yəŋkə mu fɔʼɔ-a bɔŋleʼ bɛ lɔntəŋ-aŋ ndə Juda kə chìi bʉ̂ʼʉ shìe liɛŋ-ɛŋ fyú gɛ̀ ndə yi-yə yəŋkə ndə ɔ kie ndə məbɛ chɔ.” <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />Bɔ̂ŋ mɔ̀ʼ njoʼ, mbʉ njoʼ gwù yá Matia, bə súu ɔ, bìʼ ndəŋ mbʉ bəlɔntəŋNyii njuɔ mɔʼ nə wuŋ.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s">LyʉʉhəNyiikə gwè</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />Chibɛʼkə ndə bə kə́ tíi nə Bɛŋntaku<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">Chîkə-ɔ̄ŋ nɔ nə bɛ chîbə wuŋ taa lʉ̀ hə ndə be kə yú chî-Yíɛʼsii-kə.</char></note> kʉ̂ʉ kʉ̀ʼnə, vâafɔʼɔ-Jiso chə̀ŋtə kəyəŋ kəmɔʼ. <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />Kə kwɔnə nyíɛ, yəŋbə kə́ dùŋ gwè hə yuo nə fʉ̂əŋ, gwè lə́ŋhə mbʉ mu njaa-ghɔ̄ ndə bɔ̂ŋ kə dùʼtə chɔ le. <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />Bɔ̂ŋ nyíɛ fɔbɛʼkə ndə i bɛ nə lɛɛŋhə-viʼi-bə, i gyʉ̀əhə ŋwɔŋ-ɛŋ tə́ŋtə kətʉ-bɔŋ bəmɔʼbəmɔʼ. <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />LyʉʉhəNyiikə jyʉ́ʉhə bɔŋ, bɔ̂ŋ chʉ́ʉhə ndə məkwə́ʼ ŋgie-bətə̂ŋbɛʼ-bə ndə mbʉ kəLyʉʉhə kɔ́ chu-bɔŋ ndə məkwə́ʼ.<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />Nduɔ, bʉə-Juu buŋmbi ndə bɔ̂ŋ nə kə́ fàa Nyii ndə bɔ̂ŋ lɔ̀ hə mu lɔʼɔ kətə̂ŋ təmiyɔŋ mu kəwʉʉnəmbi, nɔ kə́ chí mu Jɛlosalɛŋ. <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />Ndə bɔ̂ŋ yʉ́ gyʉʉ-ɔ̄, bʉə buŋmbi chə̀ŋtə, chutə-ʉə chíe bʉʼka wotəmiyɔŋ nɔ kə yʉ́ ndə bɔ̂ŋ tʉʼ kwə́ʼ ŋgie-lɔʼɔ-kə-i.<verse eid="ACT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 2:7" />I nɔ kə chàa bɔŋ bənchəŋ, bɔ̂ŋ jínə, kə́ ghɔ̀ŋ tʉ ŋwɔŋtə-ʉə mbɔ, “B̈ii yʉ́, bʉə-bɔ̄ŋ bənchəŋ ndə bɔ̂ŋ tʉʼ kwə́ʼ nɔ, kaa bʉə-Galili fe? <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />Chìi ka ndʉʉmɛ, bʉʼʉ bənchəŋ kə́ yʉ́ bɔŋ bə kəŋgie-lɔʼɔ-bə-ʉʼʉ? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />Bʉə nɔ bɛ fɛ̄ŋ ndə bɔ̂ŋ lɔ̀ hə Batia, Mɛdia, Elam, Mɛsobotemia, Judia, Kabadosia, Bɔŋtu leʼnə Esia, <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />Filigia, Baŋfilia, Iji, bɔŋleʼ lɔ̀ hə mu via-Libiabɛʼ-kə nə Silɛŋ leʼnə bəntoʼŋgwe ndə bɔ̂ŋ lɔ̀ hə Luŋ, <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />kə́ bɛ bʉə-Juu leʼnə bəbɛʼbʉə ndə bɔ̂ŋ bíe bɛ́ŋ Nyii-bʉə-Juu bɛ́ŋ. Bʉə-Klit ghɔŋbə bʉə-Alabia, bʉʼʉ yʉ́ ndə bɔ̂ŋ tʉʼ fʉ̀ʼtə kəŋgie lɔʼɔ-bʉʼʉ te fɔŋ-bənu ndə Nyii tʉʼ chìi.” <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />I kə́ chàa bɔŋ, bɔ̂ŋ kə́ jínə, kə́ gìe tʉ ŋwɔŋtə-ʉə mbɔ, “Yɔ̄ŋ-yə tʉʼ dʉ̀ʼ ka?” <verse eid="ACT 2:12" /><verse number="13" style="v" sid="ACT 2:13" />Bəbɛʼbʉə kə́ dʉ̀ʉhə bɔŋ ghɔ̀ŋ mbɔ, “Bʉə-bɔ̄ŋ nɔʼ búu ndʉʼmə.”<verse eid="ACT 2:13" /></para>
  <para style="s">Bita lɔ̀ʼ ŋgieNyiikə tʉ bʉə buŋmbi</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />Bɔŋ Bita ndə ɔ kə tə́nə ghɔŋbə bəʼ-bʉə-njuɔ-mɔʼ-kə nə wuŋ, chɔ̀ʼhə gyʉʉ-i ghɔʼ, ghɔ̀ŋ tʉ mbʉ bʉə mbɔ, “Bənaa-bɔŋ, bətie-bɔŋ, bʉə-Judia leʼnə bʉə bənchəŋ ndə bɔ̂ŋ tʉʼ chí Jɛlosalɛŋ, mɔ nɔ tʉʼ kʉ́ʉ chìi b̈ii kínə yɔ̄ŋ-yə, b̈ii ŋɔ́ʼhə tyunəbə-ii yʉ́ nukə ndə mɔ tʉʼ kʉ́ʉ gìe tʉ bii. <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />Bʉə-bɔ̄ŋ chʉʼ búu ndʉʼmə ndə bii tʉʼ kwɔ̀ʼtə fɛ, bɔŋ b̈ii nyíɛ, nɔ bíe haʼ bəchî bɔmɔʼ ndʉʉsɛŋkə. <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />Nɔ bɛ nukə nɔ ndə Jɔɛ yʉkəŋgieNyii nə nyɔ̀ʼ mbɔ:<verse eid="ACT 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17" />Nyii ghɔ̀ŋ mbɔ, ‘Bu yi bɛ mu ndyiʼtəbə chîbə nɔ, mɔ tə́ŋ Lyʉʉhəkə-ɔŋ mu bʉə bənchəŋ.</para>
  <para style="q1" vid="ACT 2:17">Vâa-bii, vâabələŋ ghɔŋ vâabəke bu kə́ téʼ ntəŋ ndə bɔ̂ŋ yʉ́ hə kəghɔ-Nyii, vâakəyɔwo nyíɛ nubə ndə Nyii bu dʉ̀ʼ tʉ bɔŋ ntaa, njəŋhə chí bʉə-bənduɔŋ bɔ̂ŋ bɔŋleʼ nyíɛ nubə ndə Nyii bu dʉ̀ʼ tʉ bɔŋ.<verse eid="ACT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18" />Mɔ bu buŋ kɔ́ Lyʉʉhəkə-ɔŋ mu vâafɔʼɔ-bɔŋ vâabələŋ ghɔŋbə vâafɔʼɔ-bɔŋ vâabəke mu chî-ghɔ̄-bə, bɔ̂ŋ bu téʼ ntəŋ ndə bɔ̂ŋ bu yʉ́ hə kəghɔ-mɔ.<verse eid="ACT 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19" />Mɔ bu chìi nuchíechubə yuo bɔŋleʼ chìi nubəcheʼbə kəchisê, kə́ bɛ fɔbʉəkə, viʼi leʼnə ndyʉʼkə.<verse eid="ACT 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ACT 2:20" />Chichi bu kíahə bə̀ŋ njəŋkə, chisuu kíahə ndəŋ fɔbʉəkə, chî-Tiekətʉ-kə buŋ yi gwè ndə bɛ chîkwɛʼtəŋ-ghɔ̄-kə ghɔŋ fɔŋ-kəchî.<verse eid="ACT 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21" />Ndʉʉmɛ, wotəmiyɔŋ ndə ɔ tíi Tiekətʉ mbɔ ɔ kwáa ɔ, bu kie ŋkwaaNyii.’<note caller="+" style="f"><char style="fr" closed="false">2:21 </char><char style="ft" closed="false">Joɛ 2:28-32.</char></note><verse eid="ACT 2:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="ACT 2:22" />Bənaa-bɔŋ, bətie-bɔŋ, bʉə-Isilɛ b̈ii yʉ́ ŋgiebə-ɔ̄ŋ, Jiso ndə ɔ kə lɔ̀ hə Nasalɛ, Nyii nɔ kə bɛ́ŋ ɔŋ nə nufinəbə ghɔŋbə nuchíechubə leʼnə nubəcheʼbə ndə Nyii kə fɔ̀ʼ tíŋ hə bɔ̌ŋ mbəŋ-ɛŋ. Bii nə mbəŋ-yii nɔ kínə bʉʼka i nɔ kə fyú hə mu bii. <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />Jiso-ɔ̄ ndə bə kə chɔ̀ʼhə ɔŋ kɔ́ haʼ ndə Nyii nɔʼ nə shʉ̀tə bɔŋleʼ kínə, bii lʉ̀ ɔ, kwɛ̀ŋ ɔŋ, yí nə ghɔ-bʉə-bʉ̂ʼʉ-kə. <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />Nyii bɔŋ kə bʉ̀nə kóʼhə ɔŋ, fyúhə ɔŋ hə ndə məliŋ-kwu bʉʼka kwu kə mə yá ɔ nə ghʉəʼkə-i tʉ́ʼ fɛ. <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />Dɛbi nɔ nə kwə́ʼ te ɔ mbɔ:</para>
  <para style="q1" vid="ACT 2:25">‘Mɔ nɔ nyíɛ Tiekətʉ, ɔ kə́ bɛ mbʉə mɔ təvɛʼtəvɛʼ,</para>
  <para style="q2" vid="ACT 2:25">Ɔ nɔ bɛ kwiiləŋ-mɔ, fɔkə mə nə ŋɛ̀hə mɔ fɛ.<verse eid="ACT 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26" />Bʉʼka yɔ̄ŋ-yə, tʉʉ-ɔ nɔ tʉʼ bʉ̀ʉ, mɔ kə́ kwə́ʼ nə tʉʉjyu.</para>
  <para style="q2" vid="ACT 2:26">Mɔ bu yʉ́əʼnə ndəŋ aŋ nə fyii-ɔ inchəŋ,<verse eid="ACT 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27" />bʉʼka mbɔ a kʉʉ nə lèʼnə mɔ ndʉʉ ndə mɔ kwú fɛ</para>
  <para style="q2" vid="ACT 2:27">byuunɔ mɛ̀ʼtə Wo ndə ɔ nɔʼ kɔ́ ŋwɔŋ-ɛŋ tʉ a ɔ fɛ̀ mu sê fɛ.<verse eid="ACT 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28" />A nɔʼ chìi mɔ kínə fia ndə mɔ kie ndə mə-yaʼ-tíŋ hə chɔ ndə məbʉ̀nə chí mbi.</para>
  <para style="q2" vid="ACT 2:28">A bu chìi tʉʉ-ɔ bʉ̀ʉ daa ndʉʉ ndə baʼa bu bɛ mɔʼɔ.’<note caller="+" style="f"><char style="fr" closed="false">2:28 </char><char style="ft" closed="false">Ŋwɔʼnə-təLyuu 16:8-11.</char></note><verse eid="ACT 2:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="ACT 2:29" />Bəliŋ-bɔŋ, bəkɔ mɔ gìe tʉ bii nə fyii shʉ́əshʉ́ə te nə tietie-yʉʼʉ, Dɛbi ɔ nɔ nə kwú, bə tyúu ɔ, sě-e ndə bə kə tyúu ɔ chɔ kə́ bíe fɛ̄ŋ tə dàa laa. <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />Bɔŋ bʉʼka mbɔ ɔ kə bɛ yʉkəŋgieNyii, kə́ kínə mbɔ Nyii nɔʼ kə gwìa ŋkaamə ghɔŋ ɔŋ mbɔ ɔ bu kə́ dùʼhə mbyu vaa ndə ɔ lɔ̀ hə kəlɔŋ-ɔŋ ndəŋ yetəkə-i, <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />Dɛbi yíɛʼhə nyíɛ shʉbə, te nə məbʉ̀nə kóʼ Wo ndə Nyii Kùŋ Tə́ŋ, ghɔ̀ŋ mbɔ ɔ kʉʉnə lèʼnə ɔŋ ndʉʉ ndə ɔ kwú fɛ byuunɔ mɛ̀ʼtə ɔŋ ɔ fɛ̀ mu sê fɛ.<verse eid="ACT 2:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 2:32" />“Nyii nɔʼ bʉ̀nə kóʼhə Jiso-ɔ̄, bʉʼʉ bənchəŋ nyíɛ nukə-ɔ̄ŋ nə shʉ-yʉʼʉ. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />Nyii nɔʼ chɔ̀ʼhə ɔŋ, dùʼhə kwiiləŋ-ɔŋ, kɔ́ ghʉəʼkə tʉ ɔŋ ndə mətə́ŋ Lyʉʉhəkə-i ndə ɔ nɔʼ kə kɔ̀ʼnə tʉ bʉə ndə bɔ̂ŋ bɛ́ŋ ɔŋ, nɔ bɛ yɔ̄ŋ-yə ndə bii tʉʼ nyíɛ laa bɔŋ-kə́-leʼ yʉ́ nɔ. <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />Bʉʼka Dɛbi kə gɛ̀ yuo fɛ, bɔŋ ghɔ̀ŋ mbɔ,</para>
  <para style="q1" vid="ACT 2:34">‘Mbʉ Tiekətʉ nɔ nə ghɔ̀ŋ tʉ Tiekətʉ-ɔ mbɔ,</para>
  <para style="q1" vid="ACT 2:34">“Dùʼ kwiiləŋ-mɔ<verse eid="ACT 2:34" /></para>
  <para style="q2">
    <verse number="35" style="v" sid="ACT 2:35" />tə mɔ yi mɔ̀ʼ bʉə-bàa-ba sê bəshʉ a.” ’<note caller="+" style="f"><char style="fr" closed="false">2:35 </char><char style="ft" closed="false">Ŋwɔʼnə-təLyuu 110:1.</char></note><verse eid="ACT 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />“Nduɔ, b̈ii bʉə-Isilɛ bənchəŋ kínə mbɔ Nyii nɔʼ chìi Jiso-ɔ̄, ndə bii kə kwɛ̀ŋ ɔŋ yí nɔ, mbɔ ɔ bɛ Tiekətʉ bɔŋleʼ bɛ Wo ndə Nyii Kùŋ Tə́ŋ.”<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />Ndʉʉ ndə mbʉ bʉə kə yʉ́ yɔ̄ŋ-yə, i chʉ̀ə fyiihə-ʉə, bɔ̂ŋ bíʼtə tʉ Bita ghɔŋbə bəbɛʼbə bəlɔntəŋNyii mbɔ, “Baʼa bu bɛ təka, bəliŋ-baʼa?”<verse eid="ACT 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38" />Bita bə̀ŋhə mbɔ, “Ẅotəmiyɔŋ mu bii shìe liɛŋ-ɛŋ hə ndəŋ bʉ̂ʼʉ, fí muu yie-Jiso Klai, ɔ chʉʼ sʉ̀fyii-i hə ndəŋ bʉ̂ʼtə-a. Nyii bɔŋleʼ kɔ́ Lyʉʉhəkə-i tʉ a. <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />Mbʉ ŋkɔʼnə nɔ bɛ tʉ a, tʉ ŋgwie-wo-a, leʼnə bʉə ndə bɔ̂ŋ bɛ dɔdɔ ndə Nyii Tiekətʉ-yʉʼʉ bu kɔ̀ʼnə bɔŋ bənchəŋ.” <verse eid="ACT 2:39" /><verse number="40" style="v" sid="ACT 2:40" />Ɔ bìʼ shyùu tyunəkə-ʉə nə ŋgie-yɔ́ŋyɔ́ŋ-bə, kə́ fʉ̀ʉtə bɔŋ mbɔ, “B̈ii kwáa ŋwɔŋ-yii mu mbi-bʉəbʉə-ɔ̄.”<verse eid="ACT 2:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="ACT 2:41" />Bʉə ndə bɔ̂ŋ kə bɛ́ŋ ŋgiekə-i, fí muu, bʉə bìʼ nuɔ-bɔŋ yɔ̂ŋ-ghɔ̄ tə kə́ gɛ̀ nə ŋkɔŋ-bʉə-hə itia.<verse eid="ACT 2:41" /></para>
  <para style="s">Nchəŋtə-bʉə ndə bɔŋ nɔʼ bɛ́ŋ Nyii</para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 2:42" />Bɔ̂ŋ kɔ́ ŋwɔŋ-yʉə ndə mə-kə́-yétə nubə ndə bəlɔntəŋNyii kə́ dàhə, ndə mə-kə́-yúnə, ndə mə-kə́-gyʉ̀ətə fɔyubə leʼnə mə-kə́-gháaNyii. <verse eid="ACT 2:42" /><verse number="43" style="v" sid="ACT 2:43" />Faakə yá bʉə bənchəŋ, mbʉ bəlɔntəŋNyii kə́ chìi nuchíechubə ghɔŋbə fɔŋ-bəcheʼ. <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />Bʉə bənchəŋ ndə bɔŋ kə bɛ́ŋ Nyii kə́ chə̀ŋtə kəyəŋ kəmɔʼ bəchibəchi bɔŋleʼ kə́ gyʉ̀ə fɔbə ndə bɔ̂ŋ kie tʉ ŋwɔŋtə-ʉə nə mbyu wo-imɔʼ. <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />Bɔ̂ŋ kə́ fɛ̀ŋ fɔbə-ʉə kə́ gyʉ̀əhə tʉ ŋwɔŋtə-ʉə bənchəŋ, ghʉə kənu ndə i bɛ liɛŋ-bɔŋ. <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />Bɔ̂ŋ kə́ chə̀ŋtə bəchibəchi sêfu chunjaafɛ̀ʼndɛŋNyii. Bɔ̂ŋ kə́ gyʉ̀ətə fɔyubə ndəŋ futə-ʉə kə́ yú nə tʉʉjyu leʼnə fyii imɔʼ, <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />kə́ lə̀ʼtə Nyii, tʉʉ bʉə bənchəŋ bʉ̀ʉ ndəŋ bɔŋ. Tiekətʉ kə́ bìʼ bʉə-nuɔ-bɔŋ bəchibəchi ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii.<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s">Bita chʉ́ʼ lɛŋ ndə ɔ̃ gháagháa buŋ kə́ yú</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />Yɔŋbɛʼ, Bita ghɔŋ Jɔŋ kə́ kóʼ gɛ̀ mu njaafɛ̀ʼndɛŋNyii ndə ndʉʉ ndə bɔ̂ŋ gháaNyii chɔ. Nɔ kə bɛ mu bəchî itia ndʉʉnəchî. <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />Wobɛʼ ndə ɔ kə bɛ lɛŋ lʉ̀ hə bətɔ, bə kə bɛ̀ʼ ɔ, kóʼ gwè nə nɔŋ chulɔŋ-njaafɛ̀ʼndɛŋNyii ndə bə kə́ tíi nə Lɛɛŋ, kəyəŋ ndə bɔ̂ŋ kə́ dùʼhə ɔŋ chɔ, ɔ kə́ gháa kyʉə kəghɔ-bʉə ndə bɔŋ tʉʼ ŋíi mu chunjaafɛ̀ʼndɛŋNyii. <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />Ndʉʉ ndə ɔ kə nyíɛ Bita ghɔŋ Jɔŋ, bɔ̂ŋ kə́ kʉ́ʉ ŋíi mbʉ mu chunjaafɛ̀ʼndɛŋNyii, ɔ gháa kyʉə hə kəghɔ-bɔŋ.<verse eid="ACT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 3:4" />Bita ghɔŋ Jɔŋ lɛ́nə mu shʉhə-i, Bita ghɔ̀ŋ tʉ ɔŋ mbɔ, “Lɛ́nə baʼa!” <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />Ndʉʉmɛ, ɔ chɔ̀ʼhə shʉ-i tʉ́ʼ ndəŋ bɔŋ, kə́ kʉ̀ʼ ndə məkie fɔkə kəghɔ-bɔŋ. <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />Ndʉʉmɛ, Bita ghɔ̀ŋ mbɔ, “Mɔ kie kyʉə ndə məkɔ́ tʉ a fɛ, bɔŋ nukə ndə bəkɔ mɔ fɔ̀ʼ, mɔ bu fɔ̀ʼ tʉ a. Yie-Jiso Klai ndə ɔ lɔ̀ hə Nasalɛ, lɔ̀ hə sê tòʼ!”<verse eid="ACT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 3:7" />Ɔ jɔ̀ kwiimɔʼnə-i, chɔ̀ʼhə ɔŋ, kwáa ɔ, ɔ lɔ̀ hə sê, haʼ ndʉʉmɛ fʉəŋtə-i ghɔŋ ŋgoʼ-fʉəŋ-hə-i tuŋ shʉ́ə. <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />Ɔ sɛ́ʼ tə́nə ndəŋ fʉəŋtə-i, chʉ́ʉhə kə́ tòʼ. Ndʉʉmɛ, ɔ sʉ́ʉ gɛ̀ ghɔŋ bɔŋ sêfu chunjaafɛ̀ʼndɛŋNyii, kə́ tòʼ, kə́ sɛ́ʼtə bɔŋ-kə́-leʼ lə̀ʼtə Nyii.<verse eid="ACT 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 3:9" />Ndʉʉ ndə bʉə bənchəŋ nyíɛ ɔŋ, ɔ kə́ tòʼ bɔŋleʼ kə́ lə̀ʼtə Nyii, <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />bɔ̂ŋ chèʼnə mbɔ nɔ bɛ ɔ ndə ɔ̃ kə́ dùʼ chulɔŋ-chunjaafɛ̀ʼndɛŋNyii ndə bə kə́ tíi nə Lɛɛŋ, kə́ gháa kyʉə le, i chíe chu-yʉə, bɔŋleʼ chàa bɔŋ ndə nukə ndə i nɔʼ fyú.<verse eid="ACT 3:10" /></para>
  <para style="s">Bita kwə́ʼ tʉ bʉə ndə bɔ̂ŋ kə tə́nə kə́ lɛ́nə bɔŋ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />Ndə mbʉ lɛŋ-ghɔ̄ kə chyúnə ndəŋ Bita ghɔŋ Jɔŋ, i fɛ̀ŋhə bʉə bənchəŋ, bɔ̂ŋ nyʉ́ʉ gɛ̀ bìatə bɔŋ kəyəŋ ndə bə kə́ tíi nə Chu-Kənjuuhə-Salamu ndə i kə bɛ chunjaafɛ̀ʼndɛŋNyii. <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />Ndʉʉ ndə Bita nyíɛ yɔ̄ŋ-yə, ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, “Bənaa-bɔŋ, bətie-bɔŋ, bʉə-Isilɛ, chìi ka yɔ̄ŋ-yə chíe chu-yii? Chìi ka bii kə́ lɛ́nə baʼa fi nə fɔ̀ʼ ghʉəʼkə-aʼ byuunɔ məchimbi-yaʼ ndə i tʉʼ kɔ́ kuŋhə tʉ Nyii ndə i chìi wo-ɔ̄, ɔ kə́ tòʼ? <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />Nyii-Ablahaŋ, Aisi leʼnə Jakɔ, Nyii bətietie-baʼa, nɔʼ kóʼhə kwii-Jiso vaafɔ̀ʼ-ɛ ghɔʼ, ndə bii nɔʼ kə chɔ̀ʼhə ɔŋ kɔ́ mbɔ b̈ə yí. Bale nɔʼ kə shʉ̀tə mbɔ b̈ə yɔ̀ʼ ghɔkə ndəŋ ɔŋ ɔ gɛ̀, bii tɛ́ŋ. <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />Bii nɔ kə tɛ́ŋ wo ndə ɔ bɛ ŋkʉʉ bɔŋleʼ bɛ ndyʉndyʉ, séʼ mbɔ b̈ə mɛ̀ʼtə shùɔ wo tʉ bii. <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />Bii nɔ kə yí w̃o ndə ɔ kɔ́ məchímbi, bɔŋ Nyii bʉ̀nə kóʼhə ɔŋ hə ndəŋ kwu, baʼa nyíɛ nə shʉ-yaʼ kə́ fʉ̀ʼtə.<verse eid="ACT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 3:16" />“Nɔ bɛ bʉʼka baʼabə wo-ɔ̄, ndə bii kínə ɔŋ, nɔʼ mɔ̀ʼfyiihə-aʼa-bɔŋ-hə ndəŋ Nyii yie-Jiso, bii buŋ nyíɛ ɔŋ, ɔ kə́ tə́nə laa fɛ̄ŋ shʉ́əshʉ́ə nɔ.<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />“Nduɔ, bəliŋ-bɔŋ, mɔ nɔ kínə mbɔ bii nɔ kə fɔ̀ʼ nə tʉŋkwɔŋ haʼ ndə bəntəŋbəshʉ-bii. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />Nɔ bɛ ntɛ nɔ ndə Ñyii fɔ̀ʼ nubə, ndə ɔ kə gìe lʉ̀ hə bəshʉ tíŋ hə bɔ̌ŋ bʉəyʉkəŋgie-bi mbɔ Wo ndə ɔ Kùŋ Tə́ŋ bu nyíɛ ŋgʉəʼ. <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />B̈ii shìe liɛŋtə-ii hə ndəŋ bʉ̂ʼtə-ii, bʉ̀nə gwè tʉ Nyii, ɔ chʉʼ sʉ̀fyii hə ndəŋ bʉ̂ʼtə-ii, Tiekətʉ chʉʼ chìi b̈ii kie ŋgwɔʼmbi ndə fyiihə-ii bu ghʉ́ə bʉʼka bii bɔŋ bɛ mɔʼɔ, <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />kə mbɔ ɔ bu bʉ̀nə bìʼ tə́ŋ mbʉ Wo ndə ɔ kə Kùŋ Tə́ŋ tʉ bʉʼʉ, kə́ bɛ Jiso ndə ɔ nɔʼ kə séʼ tʉ bʉʼʉ. <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />Ɔ bu káa yuo tə ndʉʉ yi kʉ̀ʼnə ndə Nyii bu bʉ̀nə shʉ̀tə nubə ï tə́nə ndyʉndyʉ, haʼ ndə ɔ nɔʼ kə kɔ̀ʼnə tíŋ hə bɔ̌ŋ bʉəyʉkəŋgie-bi ndə bɔ̂ŋ bɛ ŋkʉʉ lʉ̀ hə ŋgʉʼʉbɛʼ. <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />Ndə fʉʼkənu, Mushi nɔ nə kwə́ʼ te mbʉ Wo ndə Nyii kə Kùŋ Tə́ŋ mbɔ, ‘Nyii mbʉ Tiekətʉ-yii bu chìi woyʉkəŋgie-e fyú hə mu ŋgwie-yii nə mɔ, ndə ɔ bu kə́ yʉ́ hə kəghɔ-Nyii fʉ̀ʼtə tʉ bii. Bii nɔ kie ndə məyʉ́ nubə inchəŋ ndə ɔ bu gìe tʉ bii. <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />Wotəmiyɔŋ ndə ɔ gòʼ təmə kə́ yʉ́ hə kəghɔ-ɔ fɛ, bə bu chʉ̀ə ɔ fyúhə hə mu bʉə-Nyii, bʉ́əhə ɔŋ.’<verse eid="ACT 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 3:24" />“Kɛŋ leʼ shʉəŋ, bʉəyʉkəŋgieNyii bənchəŋ lʉ̀ hə kəghɔ-Samuɛ tə gwè dàa tʉ bʉə ndə bɔ̂ŋ kə gwè hə bɔ̌ŋ ɔŋ, nɔʼ kə kwə́ʼ te chîmbibə-ɔ̄ŋ. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />Bii bɔŋ kə́ bɛ nju-bʉəyʉkəŋgieNyii-hə, ghɔŋbə ŋkaamə ndə Nyii nɔʼ kə gwìa ghɔŋbə bətietie-bii. Ɔ nɔ nə gìe tʉ Ablahaŋ mbɔ, ‘Tíŋ hə bɔ̌ŋ ŋgwie-wo-a, biʼbə bu ŋíi chu-fu-tə inchəŋ kəchisê.’ <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />Ndʉʉ ndə Nyii kə séʼ vaafɔ̀ʼ-ɛ, ɔ fəŋ tə́ŋ ɔŋ tʉ bii mbɔ ɔ bìʼ bii, tíŋ hə bɔ̌ŋ məkíahə wotəmiyɔŋ mu bii hə ndəŋ fia-bʉəbʉə-tə.”<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s">Bə lʉ̀ Bita ghɔŋ Jɔŋ gɛ̀ nə bɔŋ mu kaŋsotə-bʉə-Juu</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />Bʉəfɛ̀ʼndɛŋNyii, wokwɛʼtəŋ-bəsɔge mu njaafɛ̀ʼndɛŋNyii leʼnə bʉə-Sadusi gwè tʉ Bita ghɔŋ Jɔŋ ndʉʉ ndə bɔ̂ŋ tʉʼ kwə́ʼ tʉ bʉə. <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />Tʉ tʉʉ-yʉə nɔʼ byʉ́ʼ daa bʉʼka mbʉ bəlɔntəŋNyii bəbûu nɔ nə kə́ dàhə bɔŋ, kə́ leʼ lɔ̀ʼ mbɔ Jiso la nɔʼ bʉ̀nə kóʼ, i dʉ̀ʼ mbɔ bʉə ndə bɔ̂ŋ tʉʼ kwútə bu yi bʉ̀nə kóʼ ghɔ. <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />Bɔ̂ŋ yá Bita ghɔŋ Jɔŋ, fʉ̀əŋ chaŋ bʉʼka nɔ nə bɛ ndʉʉbuumbi, tə mbi sɛŋ fíi ŋkəŋ. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />Bɔŋ bʉə buŋmbi ndə bɔ̂ŋ kə yʉ́ mbʉ kəŋgieNyii bɛ́ŋ, nuɔ-bələŋ bìʼ tə gɛ̀ nə ŋkɔŋhə itaa.<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />Mbi kʉ̂ʉ sɛŋ fíi, bəntəŋbəshʉ, bəbɛʼbə ŋguu-kaŋsotə-hə leʼnə bʉə dàhə nuʼ-Mushi chə̀ŋtə Jɛlosalɛŋ. <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />Anashi tiefɛ̀ʼndɛŋkwɛʼtəŋNyii nɔ nə bɛ chɔ ghɔŋbə Kaifa, Jɔŋ, Alɛsaŋnda leʼnə bəbɛʼbʉə ndə bɔ̂ŋ lɔ̀ hə kəlɔŋ-tiefɛ̀ʼndɛŋkwɛʼtəŋNyii. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />Bɔ̂ŋ gwè nə Bita ghɔŋ Jɔŋ téʼ bɔ̂ŋ tə́nə bəshʉ bɔŋ, bɔ̂ŋ chʉ́ʉhə kə́ bíʼtə nubə tʉ bɔŋ mbɔ, “Bii tʉʼ fɔ̀ʼ nubə-ɔ̄ŋ nə ghʉəʼ-ndaa-kə byuunɔ nə yie nda?”<verse eid="ACT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8" />Ndʉʉmɛ, Bita ndə ɔ nɔʼ jyʉ́ʉ hə kəghɔ-LyʉʉhəNyiikə, ghɔ̀ŋ mbɔ, “Bətie-bɔŋ, bəntəŋbəshʉ-bʉəkwɛʼtəŋ-Isilɛ, <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />kaʼ bii tíi baʼa laa fɛ̄ŋ ndə məfʉ̀ʼtə nu-jyujyu-bə ndə bə chìi tʉ wo-ɔ̄, kə́ bíʼtə ntɛ ndə bə chìi ndə məchʉ́ʼ ɔ, <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />b̈ii bəbəʼ-bʉə-Isilɛ-kə bənchəŋ kínə mbɔ nɔ bɛ ghʉəʼ-Jiso-Klai-kə ndə ɔ lɔ̀ hə Nasalɛ, ndə bii kə kwɛ̀ŋ ɔŋ yí, bɔŋ Nyii bʉ̀nə kóʼhə ɔŋ hə ndəŋ kwu, ndə i chìi wo-ɔ̄, ɔ kə́ tə́nə bəshʉ bii shʉ́əshʉ́ə nɔ. <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />Ɔ kə́ bɛ wo ndə bə kə nyɔ̀ʼ te ɔ mu ŋwɔʼnə-Nyii mbɔ,</para>
  <para style="q1" vid="ACT 4:11">‘Mbʉ ŋgoʼ ndə bii bʉə bɔ́ŋ njaa kə chɔ́ʼ mɛ̀ʼ,</para>
  <para style="q2" vid="ACT 4:11">nɔ bɛ ŋgoʼ-fûu-njaa nduɔ.’<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="ft" closed="false">Ŋwɔʼnə-təLyuu 118:22.</char></note><verse eid="ACT 4:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ACT 4:12" />Ibɛʼ-yə wo kaa ghɔ ndə ɔ kie ghʉəʼkə ndə məkwáa bʉə fɛ, bʉʼka mbɔ yiebɛʼ bɛ ghɔ kəwʉʉnəmbi-fɛ̄ŋ, ndə Nyii kɔ́ tʉ woməsʉʉ ndə bəkɔ i kɔ́ ŋkwaa tʉ bʉʼʉ fɛ.”<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />Ndʉʉ ndə bɔ̂ŋ nyíɛ ntɛ fyii ndə Bita ghɔŋ Jɔŋ kə kie, bɔŋleʼ chèʼnə mbɔ bɔ̂ŋ mə tíi shʉ ŋwɔʼnə fɛ, i chàa bɔŋ. Bɔ̂ŋ chèʼnə mbɔ ghɔŋbə Jiso nɔ nə bɛ mɔʼɔ. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />Bɔŋ bʉʼka mbɔ bɔ̂ŋ nyíɛ mbʉ wo ndə ɔ nɔʼ kə kie nchʉʼ kə́ tə́nə bəshʉ bɔŋ, təmə bɔ̂ŋ leʼ kie ŋgie-gìe-kə fɛ. <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />Ndʉʉmɛ, bɔ̂ŋ kàhə bɔŋ ndə məfyúu mbi, bɔ̂ŋ shi chúʼtə tʉbə-ʉə, kə́ bíʼtə mbɔ,<verse eid="ACT 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 4:16" />“Bʉʼʉ bu bɛ təka nə bʉə-bɔ̄ŋ? Bʉʼʉ mə tɛ́ŋ nubə ndə bɔ̂ŋ nɔʼ fɔ̀ʼ fɛ. Bʉə bənchəŋ ndə bɔ̂ŋ tʉʼ chí mu Jɛlosalɛŋ nɔ kínə mbɔ bɔ̂ŋ nɔʼ chìi fɔŋ-kəcheʼ. <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />Bɔŋ ndə məchíe nubə-ɔ̄ŋ mbɔ i mə leʼ kə́ sɛŋ gɛ̀ nə shʉbə mu bʉə fɛ, bʉʼʉ nɔ kie ndə məshyùu tyunəkə-ʉə mbɔ kə bɔ̂ŋ mə leʼ kwə́ʼ tʉ wotəmiyɔŋ te yie-Jiso fɛ.” <verse eid="ACT 4:17" /><verse number="18" style="v" sid="ACT 4:18" />Ndʉʉmɛ, bɔ̂ŋ tíi mbʉ bəlɔntəŋNyii, kàhə bɔŋ mbɔ kə bɔ̂ŋ mə leʼ kwə́ʼ byuunɔ dàhə te yie-Jiso fɛ.<verse eid="ACT 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 4:19" />Bɔŋ Bita ghɔŋ Jɔŋ bə̀ŋhə mbɔ, “Bii kwɔ̀ʼtə mbɔ i kʉ̀ʼnə tʉ Nyii mbɔ b̈aʼa yʉ́ chu-yii, chɔʼ yi-yə mɛ? <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />Bʉʼka mbɔ baʼa mə mɛ̀ʼtə ndə məfʉ̀ʼtə nuchíechubə ndə baʼa nɔʼ nyíɛ bɔŋleʼ yʉ́ fɛ.”<verse eid="ACT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 4:21" />Bɔ̂ŋ kʉ̂ʉ bìʼ fìe shʉ-yʉə tʉ bɔŋ yɔ́ŋyɔ́ŋ, yɔ̀ʼ ghɔkə-ʉə ndəŋ bɔŋ, bɔ̂ŋ gɛ̀ bʉʼka mbɔ bɔ̂ŋ kə kínə ntɛhə ndə bəkɔ bɔ̂ŋ kɔ́ ŋgʉəʼ tʉ bɔŋ təmə ntɔŋntɔŋ i fyú sê fɛ. Bʉʼka bʉə bənchəŋ nɔ kə kə́ lə̀ʼtə Nyii ndə nubə ndə i nɔʼ kə fyú, <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />bʉʼka mbʉ wo ndə ɔ kə kie nchʉʼ ndə i kə gwè hə ndəŋ nukəcheʼkə le, nɔʼ kə tíŋ ŋgʉʼhə wuŋ kwi.<verse eid="ACT 4:22" /></para>
  <para style="s">MəghaaNyii-bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />Ndʉʉ ndə bə yɔ̀ʼ ghɔkə ndəŋ Bita ghɔŋ Jɔŋ, bɔ̂ŋ bʉ̀nə gɛ̀ nyíɛ bəʼ-bʉə-kə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii, fʉ̀ʼtə nubə inchəŋ tʉ bɔŋ ndə bətiefɛ̀ʼndɛŋNyii ghɔŋbə bəntəŋbəshʉ gìe tʉ bɔŋ. <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />Ndʉʉ ndə bɔ̂ŋ yʉ́ yɔ̄ŋ-yə, bɔ̂ŋ bənchəŋ chɔ̀ʼhə gyʉʉhə-ʉə ghɔʼ gháaNyii ghɔ̀ŋ mbɔ, “Tiekətʉ-yaʼ, ndə a tʉʼ sɔ́ʼ wʉʉnəmbikə, ndə a chìi sê, chìi yuo, chìi muu ghɔŋbə fɔbə inchəŋ ndə i bɛ muŋgɔ, <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />a nɔʼ nə bʉ́ nə ghʉəʼ-kəLyʉʉhə-kə-a, tíŋ hə bɔ̌ŋ tietie-yaʼ Dɛbi vaafɔ̀ʼ-a mbɔ,</para>
  <para style="q1" vid="ACT 4:25">‘Chìi ka, lɔʼ-bətə̂ŋ-tə kə bə̀ŋtə,</para>
  <para style="q2" vid="ACT 4:25">bʉə-Juu kə́ nyíɛ ŋgʉəʼ-yʉə kə́ shʉ̀tə nubə ndə i mə tòʼ fɛ?<verse eid="ACT 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26" />Bəfɔŋ-kəwʉʉnəmbi-bɔ̄ŋ, shyʉ̀ʉ gyʉʉ ndə məmɔ̀ʼ chɔ̂,</para>
  <para style="q1" vid="ACT 4:26">bəntəŋbəshʉ chə̀ŋtə ŋwɔŋtə-ʉə</para>
  <para style="q2" vid="ACT 4:26">ndə mənyʉ́ʉ bɔ̌ŋ Tiekətʉ</para>
  <para style="q2" vid="ACT 4:26">bɔŋleʼ nyʉ́ʉ bɔ̌ŋ Wo ndə ɔ Kùŋ Tə́ŋ.’<note caller="+" style="f"><char style="fr" closed="false">4:26 </char><char style="ft" closed="false">Ŋwɔʼnə-təLyuu 2:1-2.</char></note><verse eid="ACT 4:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ACT 4:27" />M̈ɔ shyíi bii nə shʉəŋ, Hɛlo ghɔŋ Bɔŋtio Bale leʼnə bʉə ndə bɔ̂ŋ gòʼ təmə kínə Nyii fɛ ghɔŋbə bʉə-Isilɛ mu kəyəŋkwɛʼtəŋ-fɛ̄ŋ, shyʉ̀ʉ gyʉʉ ndə mənyʉ́ʉ bɔ̌ŋ Jiso, vaafɔ̀ʼ-a ndə ɔ bɛ ŋkʉʉ bɔŋleʼ kə́ bɛ wo ndə a kə kùŋ. <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />Nubə inchəŋ ndə bɔ̂ŋ tʉʼ fɔ̀ʼ, nɔ bɛ haʼ ndə a kʉ̀ʉ mbɔ i bɛ, bɔŋ-nɔʼ-leʼ kə shʉ̀tə mbɔ i bɛ lʉ̀ hə bəshʉ. <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />Tiekətʉ, kíahə shʉ-a nduɔ, lɛ́nə nubə ndə bɔ̂ŋ nɔʼ fɔ̀ʼ, kwáa vâafɔʼɔ-ba ndə məkwə́ʼ ŋgiekə-a nə fyii shʉ́əshʉ́ə. <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />Tə́ŋ ghʉəʼ-nchʉʼ-kə-a, chìi fɔŋ-bəcheʼ leʼnə nuchíechubə tíŋ hə bɔ̌ŋ vaafɔ̀ʼ-a Jiso ndə ɔ kə bɛ ŋkʉʉ.”<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />Ndʉʉ ndə bɔ̂ŋ gháaNyii liʼ, mbʉ kəyəŋ ndə bɔ̂ŋ tə́nə chɔ ŋʉ̀ʼnə. LyʉʉhəNyiikə ŋíi mu bɔŋ tə lə́ŋ, bɔ̂ŋ jyʉ́ʉ kəghɔ-ɔ, bɔ̂ŋ chʉ́ʉhə məkwə́ʼ ŋgieNyiikə nə fyii shʉ́əshʉ́ə.<verse eid="ACT 4:31" /></para>
  <para style="s">Bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii kə́ gyʉ̀ə fɔbə-ʉə</para>
  <para style="m">
    <verse number="32" style="v" sid="ACT 4:32" />Bʉə bənchəŋ ndə bɔ̂ŋ bɛ́ŋ Nyii dùʼ nə ŋgiekə imɔʼ, təmə wo kie yi-yə fɔkə ŋkʉʉ fɛ, bɔŋ bɔ̂ŋ kə́ gyʉ̀ətə fɔkə təmiyɔŋ ndə wo kie. <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />Mbʉ bəlɔntəŋNyii bìʼ lɔ̀ʼ məbʉ̀nə kóʼ Jiso Tiekətʉ shʉ́əshʉ́ə, Nyii kə́ dʉ̀ʼ buuŋjyu yɔ́ŋyɔ́ŋ tʉ bɔŋ bənchəŋ. <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />Wo kə bɛ mu bɔŋ ndə ɔ byúu fɔkə fɛ, bʉʼka mbɔ bʉə ndə bɔ̂ŋ kə kie tɔ̂bə leʼnə bʉə ndə bɔ̂ŋ kə kie njaahə nɔ nə kə́ fɛ̀ŋ gwè nə kyʉə-ɛ, <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />mɔ̀ʼ bəshʉ mbʉ bəlɔntəŋNyii, bɔ̂ŋ kə́ gyʉ̀ə tʉ bəbɛʼbʉə haʼ ghʉə kənu ndə i yá bɔŋ.<verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />Ndə fʉʼkənu, Jɔsɛ ndə ɔ kə lɔ̀ hə kəlɔŋ Lɛvi mu lɔʼɔ Siblɔ, bəlɔntəŋNyii nɔ kə tyú yie kətʉ-ɔ nə Banaba (ndə i bɛ mbɔ wo ndə ɔ kwèʼhə bʉə), <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />nɔ kə fɛ̀ŋ tɔ̂kə ndə ɔ kie, gwè nə kyʉə-ɛ, mɔ̀ʼ bəshʉ mbʉ bəlɔntəŋNyii, ndə mə-kə́-gyʉ̀ə tʉ bʉə haʼ ghʉə-kənu ndə i yá bɔŋ.<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s">Anania ghɔŋ Safelia</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />Bɔŋ wobɛʼ ghɔ, yie-e kə́ bɛ Anania ghɔŋ vi-i Safelia, fɛ̀ŋ ibɛʼ-yə tɔ̂kə-ʉə, <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />ɔ sáa via-kyʉə-kə lə̀ŋ vi kə́ kínə, gwè nə viakə gwè mɔ̀ʼ bəshʉ mbʉ bəlɔntəŋNyii.<verse eid="ACT 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 5:3" />Ndʉʉmɛ, Bita ghɔ̀ŋ tʉ ɔŋ mbɔ, “Anania, chìi ka a mɛ̀ʼtə ŋwɔŋ-aŋ tʉ Sata, ɔ jyʉ́ʉhə a? A chʉ̀ə lɛɛŋkə tʉ LyʉʉhəNyiikə, lə̀ŋ bəʼ-kyʉə-kətɔ̂-kə-a tʉ ŋwɔŋ-aŋ. <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />Mbʉ kətɔ̂ nɔ kə bɛ ya-yə a buŋ fɛ̀ŋ, ndʉʉ ndə a kə fɛ̀ŋ mbʉ kyʉə kə́ bɛ ya-yə. Chìi ka a séʼ mu fyii-a ndə məchìi ntɛ-kənu-ɔ̄ŋ? A chʉ̀ə lɛɛŋkə bə tʉ woməsʉʉ fɛ, a nɔ chʉ̀ə tʉ Nyii.”<verse eid="ACT 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 5:5" />Ndʉʉ ndə Anania kə yʉ́ yɔ̄ŋ-yə, ɔ chóʼnə gwù sê kwú. Wotəmiyɔŋ ndə ɔ̈ yʉ́ nukə-ɔ̄ŋ, faa-kwu-kə yá ɔ. <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />Vâa-kəyɔwo-bələŋ-bɛʼbə lɔ̀ hə sê gɛ̀ lʉ́əŋtə ɔŋ mu ndyi, bɛ̀ʼ ɔ gɛ̀ tyúu.<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />Ŋgwɔʼmbi kʉ̂ʉ tíŋ tə kə́ gɛ̀ ndə bəchî itia, vi-i gwè sʉ́ʉ mu njaa, təmə kínə nukə ndə i nɔʼ tíŋ fɛ. <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />Bita bíʼtə tʉ ɔŋ mbɔ, “Bɛ haʼ chuɔŋ nɔ ndə bii ləŋ-aŋ kə fɛ̀ŋ tɔ̂kə chɔ mɛ?”</para>
  <para style="p" vid="ACT 5:8">Ɔ bɛ́ŋ mbɔ, “Əŋ, nɔ bɛ haʼ yɔŋ-yə.”<verse eid="ACT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9" />Bita ghɔ̀ŋ mbɔ, “Chìi ka bii bəbûu shyʉ̀ʉ gyʉʉ ndə məmùutə LyʉʉhəTiekətʉkə? Lɛ́nə mbi nyíɛ, vâakəyɔwo bələŋ le ndə bɔ̂ŋ gɛ̀ tyúu ləŋ-aŋ, bɔ̂ŋ bu bɛ̀ʼ a haʼ ghɔ nɔ gɛ̀ tyúu.”<verse eid="ACT 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 5:10" />Haʼ ndʉʉghɔfii, ɔ gwù sê bəshʉ ɔ, kwú. Ndʉʉ ndə mbʉ vâakəyɔwo bələŋ gwè nyíɛ ndə ɔ nɔʼ kwú, bɔ̂ŋ bɛ̀ʼ ɔ fyú gɛ̀ tyúu mbʉə ləŋ-ɛŋ. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />Faa-kwu-shʉ́əshʉ́ə-kə yá bʉə-chɔshi bənchəŋ leʼnə bʉə bənchəŋ ndə bɔ̂ŋ yʉ́ nubə-ɔ̄ŋ.<verse eid="ACT 5:11" /></para>
  <para style="s">Mbʉ bəlɔntəŋNyii chʉ́ʼ bʉə buŋmbi</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />Mbʉ bəlɔntəŋNyii kə́ chìi fɔŋ-bəcheʼ leʼnə nuchíechubə mu mbʉ bʉə. Bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii kə́ chʉʼ fə́nə bìʼ fə́nə mu sêfu-njaafɛ̀ʼndɛŋNyii kəyəŋ ndə bə kə́ tíi nə Chu-Kənjuuhə-Salamu. <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />Təmə wo ndə ɔ gòʼ təmə bɛ nuɔ-yʉə fɛ leʼnə mùutə ndə məbìa bɔŋ fɛ, bɔŋ bʉə kə́ kɔ́ kuŋhə tʉ bɔŋ yɔ́ŋyɔ́ŋ daa. <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />Buŋmbi bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Tiekətʉ, bəke ghɔŋbə bələŋ, kə́ bìʼ nuɔ bɔŋ. <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />Bʉʼka fɔʼɔ-mbʉ-bəlɔntəŋNyii, bə kə́ bɛ̀ʼ bʉə-bəyɔʼ ndəŋ bɔbə ghɔŋbə bəmata, gwè mɔ̀ʼtə bəmbia fia mbɔ Bita kə́ tíŋ nɔ, l̈yʉʉhəkə-i tíŋ hə ndəŋ bɔŋ, bɔ̂ŋ chʉʼ kie nchʉʼ. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />Nuɔ-bʉə-tə kə́ gwè hə mu lɔʼ-bətə̂ŋ-tə mbʉə Jɛlosalɛŋ, kə́ gwè nə bʉə-bəyɔʼ-bʉə ghɔŋbə bʉə ndə lyʉʉhəbʉəbʉəbə kə́ chɔ́ŋhə bɔŋ, bɔ̂ŋ bənchəŋ kie nchʉʼ.<verse eid="ACT 5:16" /></para>
  <para style="s">Bə yátə bəlɔntəŋNyii bʉ̀nə yɔ̀ʼ ghɔkə ndəŋ bɔŋ</para>
  <para style="m">
    <verse number="17" style="v" sid="ACT 5:17" />Ndʉʉmɛ, mbʉ tiefɛ̀ʼndɛŋkwɛʼtəŋNyii lɔ̀ hə sê ghɔŋbə bʉə ndə ghɔŋ bɔŋ kə bɛ mɔʼɔ (bə kə́ tíi bɔŋ nə bʉə-Sadusi), bɔ̂ŋ kə́ bɛ nə ŋkwɔʼtə bəfyuʼ te mbʉ bəlɔntəŋNyii. <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />Bɔ̂ŋ yátə mbʉ bəlɔntəŋNyii fʉ̀əŋtə bɔŋ mu njaa-chaŋ-gɔməna. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />Bɔŋ bətyuʼ-ghɔ̄, wontəŋTiekətʉ ŋɔ́ʼhə chusii-njaa-chaŋ-ghɔ̄ fyúhə bɔŋ, gìe tʉ bɔŋ mbɔ, <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />“B̈ii gɛ̀ mu chunjaafɛ̀ʼndɛŋNyii, gɛ̀ shyíi bʉə nə ntəŋ-məchimbi-ɔ̄ inchəŋ.” <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />Ndʉʉ ndə mbʉ bəlɔntəŋNyii kə yʉ́ yɔ̄ŋ-yə, kʉ̂ʉ bɛ ndʉʉsɛŋkə bətyuʼbətyuʼ, bɔ̂ŋ ŋíi mu chunjaafɛ̀ʼndɛŋNyii chʉ́ʉhə kə́ dàhə.</para>
  <para style="p" vid="ACT 5:21">Ndʉʉ ndə mbʉ tiefɛ̀ʼndɛŋkwɛʼtəŋNyii ghɔŋbə bəbɛʼbə kuŋhə kə chə̀ŋtə, bɔ̂ŋ chʉ́ʉhə kaŋsotəkwɛʼtəŋ ghɔŋbə bʉəkwɛʼtəŋ-Isilɛ bənchəŋ. Bɔ̂ŋ tə́ŋ ntəŋ mu njaa-chaŋ mbɔ b̈ə gwè nə mbʉ bəlɔntəŋNyii mu njaafɛ̀ʼ. <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />Bɔŋ ndʉʉ ndə mbʉ bənchyii-njaafɛ̀ʼndɛŋNyii gɛ̀ dàa chɔ, təmə nyíɛ bɔŋ fɛ. Bɔ̂ŋ bʉ̀nə gwè fʉ̀ʼtə mu mbʉ kaŋsotə mbɔ, <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />“Baʼa gɛ̀ dàa le, nyíɛ chusii-njaa-chaŋ ifʉ̀əŋnə, bʉə chyìinə kə́ tə́ŋtə mbʉə ghɔ, bɔŋ baʼa kʉ̂ʉ chóʼ chusii sʉ́ʉ muŋgɔ, təmə nyíɛ wo fɛ.”<verse eid="ACT 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 5:24" />Ndʉʉ ndə wokwɛʼtəŋ bənchyii mu njaafɛ̀ʼndɛŋNyii leʼnə bətiefɛ̀ʼndɛŋNyii kə yʉ́ nukə-ɔ̄ŋ, i chɔ́ŋhə bɔŋ, bɔ̂ŋ kə́ kwɔ̀ʼtə ntɛ ndə i bu yi liʼ. <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />Ndʉʉmɛ, wobɛʼ gwè nə ntəŋ mbɔ, “B̈ii yʉ́! Bʉə-bīŋ ndə bii kə fʉ̀əŋ bɔŋ mu njaa-chaŋ le, tə́nə nɔ mu chunjaafɛ̀ʼndɛŋNyii kə́ dàhə bʉə.”<verse eid="ACT 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 5:26" />Mbʉ wokwɛʼtəŋ-bənchyii-njaafɛ̀ʼndɛŋNyii ghɔŋbə bʉə-bi ndə bɔ̂ŋ kə́ chyìi njaafɛ̀ʼndɛŋNyii gɛ̀ lʉ̀ bɔŋ gwè nə bɔŋ buɔbuɔ, kə́ fàa mbɔ bʉə bu túŋtə bɔŋ yi, kaʼ bɔ̂ŋ chìi nukə tə lə́ŋhə mbʉ bəlɔntəŋNyii. <verse eid="ACT 5:26" /><verse number="27" style="v" sid="ACT 5:27" />Bɔ̂ŋ gwè nə bɔŋ, bɔ̂ŋ tə́nə bəshʉ mbʉ bʉə-kaŋsotə, mbʉ Tiefɛ̀ʼndɛŋkwɛʼtəŋNyii bíʼtə mbɔ, <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />“Baʼa chʉʼ shyùu tyunəkə-ii mbɔ bii mə leʼnə dàhə yie wo-ɔ̄ fe? Bɔŋ nyíɛ! Bii nɔʼ buŋ leʼ wɔ̀ʼhə mu Jɛlosalɛŋ nə nubə ndə bii tʉʼ dàhə te yie-Jiso, kə́ mɔ̀ʼ bə liɛŋ-baʼa mbɔ la yi baʼa yí ɔ!”<verse eid="ACT 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29" />Bɔŋ Bita ghɔŋbə bəbɛʼbə bəlɔntəŋNyii bə̀ŋhə mbɔ, “Baʼa nɔ kie ndə məyʉ́ chu-Nyii kaa mə yʉ́ chu-woməsʉʉ fɛ. <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />Nyii bətietie-baʼa nɔ nə bʉ̀nə kóʼhə Jiso, ndə bii kə kwɛ̀ŋ ɔŋ ndəŋ tyʉntɔɔnəkə yi, <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />dùʼhə ɔŋ ndəŋ yəŋ-məgʉ́ə-kə nə Vaa-fɔŋkwɛʼtəŋ, ɔ bɔŋleʼ kə́ bɛ Ŋkwaa. Ɔ nɔ chìi yɔ̄ŋ-yə mbɔ Isilɛ chʉʼ kie fia ndə məshìe liɛŋ ndəŋ bʉ̂ʼtə-ʉə bʉ̀nə gwè tʉ Nyii, ɔ chʉʼ sʉ̀fyii hə ndəŋ bʉ̂ʼtə-ʉə. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />Nubə-ɔ̄ŋ nɔ mì shʉ bʉʼʉ, bʉʼʉbə LyʉʉhəNyiikə, ndə Nyii kɔ́ tʉ bʉə ndə bɔ̂ŋ tʉʼ yʉ́ chu-i.”<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />Ndʉʉ ndə bɔ̂ŋ yʉ́ yɔ̄ŋ-yə, i shùɔ bɔŋ fyii-bɔŋ, bɔ̂ŋ shyʉ̀ʉ gyʉʉ ndə məyí bɔŋ. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />Bɔŋ mbyu wobɛʼ mu bɔŋ, bə kə́ tíi ɔ nə Gamalia, kə́ bɛ wo-Falasi, bɔŋleʼ kə́ bɛ wo dàhə nuʼ-Mushi, ndə bʉə buŋmbi fàa ɔ, lɔ̀ hə sê tə́nə kàhə mbɔ b̈ə la fyúhə mbʉ bəlɔntəŋNyii hə mu kaŋsotə b̈ɔ̂ŋ kwìhə mbi məniʼ. <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />Ndʉʉmɛ, ɔ kwə́ʼ tʉ mbʉ bʉə mu kaŋsotə-ghɔ̄ mbɔ, “Bətie-bɔŋ, bʉə-Isilɛ, b̈ii láa, nukə ndə bii tʉʼ shʉ̀tə ndə məchìi nə bʉə-bɔ̄ŋ! <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />B̈ii kə́ kwɛ́nə mbɔ wobɛʼ nɔ nə kwɔnə fyú tə́nə, bə kə́ tíi ɔ nə Tioda, kə́ làhə shʉ bʉə mbɔ ɔ la bɛ wokwɛʼtəŋ. Bʉə bìa ɔ tə kə́ gɛ̀ nə təghyʉʉ kwi, bɔŋ bə kʉ̂ʉ leʼ yí ɔ, bʉə nuɔ-bi wɔ̀ʼnə bəmɔʼbəmɔʼ, fɔʼɔ-ɛ mì njʉnjʉ. <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />Ibɛʼ-yə wo bìʼ fyú gwè hə bɔ̌ŋ ɔŋ, bə kə́ tíi ɔ nə Juda, ɔ lɔ̀ hə Galili ndəŋ ŋgʉʼʉmbi ndə bə nə kə́ súu bʉə chɔ. Ɔ ghɔ́ŋ bʉə kɔ́ hə bɔ̌ŋ ɔŋ, bə kʉ̂ʉ leʼ yí ɔ ghɔ, bʉə nuɔ-bi nyʉ́ʉ wɔ̀ʼnə bəmɔʼbəmɔʼ.<verse eid="ACT 5:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 5:38" />“Nduɔ, yɔŋ-yə tʉ̂ʼ nɔ bɛ mbɔ kə bii mə chìi nukə nə bʉə-bɔ̄ŋ fɛ, b̈ii mɛ̀ʼtə bʉə-bɔŋ chɔ. Kaʼ nubə ndə bɔ̂ŋ tʉʼ dàhə bɔŋleʼ kə́ fɔ̀ʼ, gwè hə ndəŋ ŋkwɔʼtə-woməsʉʉ təmə i tʉʼ gwè mìmì njʉnjʉ. <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />Bɔŋ kaʼ bɛ nu-Nyii-kə təmə bii mə chíe fɛ. Ndʉʉbɛʼ bii buŋ kə́ gwúu byuʼu bə biibə Nyii.”<verse eid="ACT 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40" />Mbʉ bʉə-kaŋsotəkwɛʼtəŋ bɛ́ŋ tʉ̂ʼ-e, tíi mbʉ bəlɔntəŋNyii mu njaa, gwúu bɔŋ. Ndʉʉmɛ, bɔ̂ŋ kàhə bɔŋ mbɔ bɔ̂ŋ mə leʼnə kwə́ʼ te yie-Jiso fɛ, yɔ̀ʼ ghɔkə ndəŋ bɔŋ, bɔ̂ŋ gɛ̀. <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />Bɔŋ mbʉ bəlɔntəŋNyii fyú hə mu mbʉ kaŋsotə nə tʉʉjyu bʉʼka mbɔ Nyii la nyíɛ bɔŋ, bɔ̂ŋ kʉ̀ʼnə ndə bʉə ndə bəkɔ bɔ̂ŋ nyíɛ ŋgʉəʼ bɔŋleʼ fí tʉvyiikə yie-Jiso. <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />Bɔ̂ŋ kə́ lɔ̀ʼ ntəŋjyujyu bɔŋ-kə́-leʼ dàhə bəchibəchi mu chunjaafɛ̀ʼndɛŋNyii leʼnə mu njaa-bʉə-hə mbɔ, “Wo ndə Nyii Kùŋ Tə́ŋ, ndə bii tʉʼ kʉ́ʉ le, nɔ bɛ Jiso.”<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">Bə séʼ bʉə təkwiitia ndə mə-kə́-fɔ̀ʼ fɔʼɔ-Nyii</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />Nduɔ mu bəchî-ghɔ̄, ntyʉʉ vâafɔʼɔ-Jiso kə bìʼ yɔ́ŋ gɛ̀ nə shʉbə, bʉə chʉ́ʉhə kə́ luŋtə ndə nubə ndə i tʉʼ tòʼ təmə kə́ kʉ̀ʼnə fɛ. Bʉə-Juu ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii kə́ leʼ kwə́ʼ ŋgie-Gili-kə kə́ luŋtə te bʉə-Juu ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii kə́ kwə́ʼ ŋgie-Hibulu-kə. Bɔ̂ŋ kə́ kwə́ʼ te bɔŋ mbɔ bɔ̂ŋ la tʉʼ túhə shʉ tʉ bəkwuʼ bəke-bʉə ndʉʉ ndə bɔ̂ŋ tʉʼ gyʉ̀ə fɔbə bəchibəchi. <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />Ndʉʉmɛ, mbʉ bəlɔntəŋNyii njuɔ bûu nə wuŋ chə̀ŋtə vâafɔʼɔ-Jiso bənchəŋ ghɔ̀ŋ tʉ bɔŋ mbɔ,</para>
  <para style="p" vid="ACT 6:2">“I bʉ̀ʉ mbɔ baʼa mɛ̀ʼtə ndə mə-kə́-lɔ̀ʼ ŋgieNyiikə ghɔŋbə mə-kə́-dàhə, kə́ gyʉ̀ə bə fɔbə fɛ. <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />Nɔ bəliŋ-bɔŋ, b̈ii chóʼ ŋkɛŋ-bʉə-hə təkwiitia mu bii ndə bɔ̂ŋ nɔʼ jyʉ́ʉ hə kəghɔ-LyʉʉhəNyiikə, bɔŋleʼ kie ndaa. Baʼa dùʼhə bɔŋ ndəŋ fɔʼɔ-ɔ̄. <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />Ndʉʉmɛ, baʼa bu kɔ́ ŋwɔŋ-yaʼ ndə mə-kə́-gháaNyii, ndə mə-kə́-lɔ̀ʼ ŋgieNyiikə bɔŋleʼ ndə mə-kə́-dàhə.”<verse eid="ACT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5" />Nuɔ bʉə bənchəŋ bɛ́ŋ mbʉ kəŋgie, ndʉʉmɛ, chóʼ Shitifɛ̄ŋ, ndə ɔ nɔʼ kɛŋ kɔ́ ŋwɔŋ-ɛŋ, mɔ̀ʼfyii-i ndəŋ Nyii jyujyu, LyʉʉhəNyiikə bɔŋ-nɔʼ-leʼ jyʉ́ʉhə ɔŋ, leʼnə Fili, Blukolo, Nikanu, Timɔ, Bamɛna leʼnə Nikola ndə ɔ lɔ̀ hə Antiɔk ndə ɔ nɔʼ kə bɛ́ŋ nuʼ-bʉə-Juu buŋ bɛ́ŋ Jiso. <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />Bə gwè nə bʉə-bɔ̄ŋ təkwiitia kɔ́ tʉ mbʉ bəlɔntəŋNyii, bɔ̂ŋ mɔ̀ʼ ghɔkə-ʉə kətʉ-bɔŋ,<note caller="+" style="f"><char style="fr" closed="false">6:6 </char><char style="ft" closed="false">Məmɔ̀ʼ ghɔkə kətʉ wo fɛ̀ŋ nɔ kə bɛ ncheʼ mbɔ Nyii nɔʼ chóʼ wo tə́ŋ mbɔ ɔ gɛ̀ fɔ̀ʼ fɔʼɔ-ɛ.</char></note> gháaNyii tʉ bɔŋ.<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />Bə kə́ bìʼ lɔ̀ʼ ŋgieNyiikə gɛ̀ nə shʉbə. Ntyʉʉ vâafɔʼɔ-Jiso bìʼ kə́ yɔ́ŋ mu Jɛlosalɛŋ gɛ̀ nə shʉbə, buŋmbi bʉəfɛ̀ʼndɛŋNyii-bʉə-Juu kə́ bɛ́ŋ ntəŋjyujyu ghɔ.<verse eid="ACT 6:7" /></para>
  <para style="s">Bə yá Shitifɛ̄ŋ</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />Shitifɛ̄ŋ, ndə Nyii kə́ dʉ̀ʼ buuŋjyu yɔ́ŋyɔ́ŋ tʉ ɔŋ bɔŋleʼ kə́ fɔ̀ʼ mu ɔŋ shʉ́əshʉ́ə, kə́ chìi nuchíechukwɛʼtəŋbə ghɔŋ fɔŋ-bəcheʼ mu mbʉ bʉə. <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />Bɔŋ kʉ̂ʉ bɛ yɔŋbɛʼ, bʉəbɛʼbə ndə bɔ̂ŋ lɔ̀ hə mu njaagháaNyii, ndə bə kə́ tíi nə NjaagháaNyii-Fʉəhə ndə Bə nɔʼ Yɔ̀ʼ Ghɔkə ndəŋ Bɔŋ, chʉ́ʉhə mətúŋ bəŋʉʉ ghɔŋbə Shitifɛ̄ŋ. Nɔ kə bɛ bʉə-Juu ndə bɔ̂ŋ lɔ̀ hə Silɛŋ, Alɛsaŋndia, Silisia bɔŋleʼ lɔ̀ hə mu Esia. <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />Bɔŋ təmə wofuu mə bə̀ŋhə ndə ntɛ-mukətʉ-súunə ndə LyʉʉhəNyiikə kə kɔ́ tʉ Shitifɛ̄ŋ, ɔ kə́ kwə́ʼ nə yɔŋ fɛ.<verse eid="ACT 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 6:11" />Ndʉʉmɛ, bɔ̂ŋ nyáʼtə kɔ́ buŋ bəbɛʼbʉə mbɔ bɔ̂ŋ chʉ̀ə lɛɛŋkə kətʉ Shitifɛ̄ŋ mbɔ, “Baʼa nɔ yʉ́ wo-ɔ̄, kə́ bʉ́əhə yie Mushi leʼnə yie Nyii.” <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />Nɔ nukə nɔ ndə i chɔ̀ʼhə mbʉ nuɔ-bʉə, bəntəŋbəshʉ, leʼnə bʉə dàhə nuʼ-Mushi. Bɔ̂ŋ yá Shitifɛ̄ŋ gwè nə nɔŋ mu mbʉ kaŋsotəkwɛʼtəŋ. <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />Mbʉ bʉə chʉ̀ə kəlɛɛŋhə ghɔ̀ŋ mbɔ, “Baʼa nɔ yʉ́ wo-ɔ̄, kə́ dʉ̀ʉhə yəŋ-kəchɔŋ-kə-ɔ̄ŋ gɛ̀gɛ̀ ghɔŋbə nuʼ-Mushi. <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />Baʼa nɔ yʉ́ wo-ɔ̄, kə́ ghɔ̀ŋ mbɔ, Jiso ndə ɔ lɔ̀ hə Nasalɛ la bu kùu njaafɛ̀ʼndɛŋNyii, bɔŋleʼ kwɛ́nə nuʼ ndə Mushi kə kɔ́ tʉ bʉʼʉ.” <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />I kʉ̂ʉ dàa kəyəŋ-fɛ̄ŋ, bʉə bənchəŋ ndə bɔ̂ŋ kə bɛ mu mbʉ kaŋsotəkwɛʼtəŋ tʉ́ʼ shʉtə-ʉə ndəŋ Shitifɛ̄ŋ, mbe-shʉ-i nɔ nə kə́ báa nə yi-wontəŋNyii-yə.<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">Shitifɛ̄ŋ Kwə́ʼ tʉ mbʉ bʉə-kaŋsotə</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />Ndʉʉmɛ, mbʉ tiefɛ̀ʼndɛŋkwɛʼtəŋNyii bíʼtə tʉ Shitifɛ̄ŋ mbɔ, “Nubə-ɔ̄ŋ ndə bə gìe kətʉ-a inchəŋ nɔ bɛ haʼ shʉəŋ mɛ?”<verse eid="ACT 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2" />Shitifɛ̄ŋ bə̀ŋhə mbɔ, “Bəliŋ-bɔŋ ghɔŋbə bətie-bɔŋ, b̈ii yʉ́ nukə ndə mɔ kie ndə məgìe tʉ bii. Nyii-yʉʼʉ ndə ɔ gʉ́ə daa nɔ nə kɛ̀ʼ ŋwɔŋ-ɛŋ tʉ tie-yʉʼʉ Ablahaŋ vɛʼ ndə ɔ kə bɛ Mɛsobotemia, ɔ buŋ lɔ̀ gɛ̀ Halaŋ. <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />Nyii ghɔ̀ŋ tʉ ɔŋ mbɔ, ‘Mɛ̀ʼtə lɔʼɔ-a, mɛ̀ʼtə bʉə-ba, gwè ndə yəŋkə ndə mɔ bu dʉ̀ʼ tʉ a.’ <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />Ndʉʉmɛ, Ablahaŋ lɔ̀ hə lɔʼɔ Chadia gɛ̀ Halaŋ, chí chɔ tə tie-e nə sɛŋ kwú. Nyii lʉ̀ ɔ hə chɔ, gwè nə nɔŋ fɛ̄ŋ ndə bii tʉʼ chí chɔ nduɔ nɔ. <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />Nyii kə kɔ́ yi-yə fɔbə fɛ, buŋ laa ɔ, tə laa vaakəŋkʉə-sê məniʼ, bɔŋ bɛ le Nyii kɔ̀ʼnə ɔŋ mbɔ mbʉ lɔʼɔ inchəŋ la bu nə bɛ yi-yə ghɔŋbə ŋgwie-wo-e, bɔŋ nə kə buŋ bɛ vɛʼ-ghɔ̄ təmə ɔ nɔʼ kie vaa fɛ. <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />Nyii bɔŋleʼ ghɔ̀ŋ tʉ ɔŋ mbɔ ŋgwie-wo-e la bu nə bɛ bəntoʼŋgwe lɔʼɔbɛʼ, nyíɛ ŋgʉəʼ chɔ nə fʉəhə ndə ŋgʉʼhə təghyʉʉ kwi. <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />Nyii ghɔ̀ŋ mbɔ, ‘Mɔ bɔŋ bu nə kɔ́ ŋgʉəʼ tʉ mbʉ lɔʼɔ kətə̂ŋ ndə bɔ̂ŋ tʉʼ fɔ̀ʼ fʉəhə tʉ bɔŋ, bɔŋ nə kəliʼ nɔ, bɔ̂ŋ fyú chɔ, gwè kə́ lə̀ʼtə mɔ kəyəŋ-fɛ̄ŋ.’ <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />Vɛʼ-ghɔ̄, Nyii gwìa ŋkaamə ghɔŋ Ablahaŋ ndə cheʼkə-i bɛ mbɔ ɔ̈ kə́ fɔ̀ʼ vâa-bi. Vɛʼ ndə bə bí Aisi, Ablahaŋ tie-e fɔ̀ʼ ɔ, ɔ kə bɛ chîbə fɔ̂ŋ. Aisi kóʼ bí Jakɔ, Jakɔ bí vâa-bi njuɔ bûu nə wuŋ, ndə bɔ̂ŋ kóʼ mɔʼɔ lɔʼɔ-Juu.<verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />“Bəbɛʼbə vâa-Jakɔ bàa shʉ Jɔsɛ, lʉ̀ ɔ fɛ̀ŋ ndə fʉə, bə gɛ̀ nə nɔŋ Iji. Bɔŋ Nyii kə́ bɛ ghɔŋ ɔŋ mɔʼɔ, <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />chʉ̀ʼ tʉkə-i hə mu ŋgʉəʼ. Nyii kɔ́ mukətʉ súunə tʉ Jɔsɛ bɔŋleʼ chìi Fɛlo ndə ɔ kə bɛ Fɔŋ bʉə-Iji dʉ̀ʼ buuŋjyu tʉ ɔŋ, vɛʼ ndə ghɔŋ kə bɛ mɔʼɔ. Nɔ Fɛlo dùʼhə ɔŋ, ɔ kə́ lɛ́nə lɔʼɔ Iji nchəŋnchəŋ, bɔŋleʼ dùʼhə ɔŋ ndə wokwɛʼtəŋ mu ntoʼ nchəŋnchəŋ-ɛŋ.<verse eid="ACT 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 7:11" />“Bɔŋ chyʉʉ gwù mu lɔʼɔ Iji leʼnə lɔʼɔ Kana. Fɔyubə mì kəghɔ-bətietie-baʼa inchəŋ, bɔ̂ŋ nyíɛ fɔŋ-ŋgʉəʼ. <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />Bɔŋ Jakɔ yʉ́ mbɔ fɔyubə la bíe Iji, ndʉʉmɛ, ɔ tə́ŋ vâa-bi chɔ ndə məgɛ̀ nyúɔ ibɛʼ-yə. <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />Bɔ̂ŋ kʉ̂ʉ bʉ̀nə bìʼ gɛ̀ ndə biitəkə, Jɔsɛ kɛ̀ʼ ŋwɔŋ-ɛŋ tʉ bəliŋ-bi, lʉ̀ bɔŋ gɛ̀ dʉ̀ʼ tʉ Fɛlo. <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />Ndʉʉmɛ, Jɔsɛ dùhə ntəŋ mbɔ tie-e, J̈akɔ la gwè ghɔŋbə bʉə-bi bənchəŋ bìatə ɔŋ Iji. Nchəŋnchəŋ-yʉə ndə bɔ̂ŋ kə gɛ̀ nɔ kə bɛ bʉə njuɔ taa nə wuŋ təkwiitia. <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />Jakɔ gɛ̀ Iji, chí tə kwútə chɔ ghɔŋbə vâa-bi vâabələŋ bənchəŋ ndə bɛ bətietie-bʉʼʉ. <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />Bə lʉ̀ ŋkwubə-ʉə bʉ̀nə gɛ̀ nə yɔŋ Shikɛŋ, gɛ̀ tyúu bɔŋ mu sě ndə Ablahaŋ kə nyúɔ kəghɔ-vâa-Hamɔ, lɔʼɔ Shikɛŋ.<verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />“Ndʉʉ kʉ̂ʉ kə́ kʉ̀ʼnə gwè ndə Nyii bu fɔ̀ʼ nukə ndə ɔ nɔʼ kə kɔ̀ʼnə tʉ Ablahaŋ, bʉə baʼa mu Iji kɛŋ bìʼ yɔ́ŋyɔ́ŋ daa. <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />Bɔŋ ndʉʉmɛ, fɔŋ fefe kóʼ kəkʉə lɔʼɔ Iji təmə leʼ kínə Jɔsɛ fɛ. <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />Fɔŋ-ɔ̄ŋ yə̀ŋ tiɛŋ bətietie-baʼa, chɔ́ŋhə bɔŋ, kə́ kwɛ̀ŋhə bɔŋ ndə məké vâa-bʉə, bɔ̂ŋ chʉʼ kwútə.<verse eid="ACT 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 7:20" />“Nɔ kə bɛ ndʉʉ-ghɔ̄, bə bí Mushi, ndə ɔ bʉ̀ʉ shʉ-Nyii daa. Bətie-bi kie ɔ ndə bəchi itia. <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />Kəliʼ, bə bɛ ndə məmɛ̀ʼ ɔŋ, vaa-fɔŋ-bəke-Fɛlo bɛ́nə ɔŋ, chìnə ɔŋ ndə vaa-ɛ. <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />Bə dàhə Mushi nə ndaa bʉə-Iji inchəŋ, ɔ shʉ́ə ndə kwəʼ-ɛ ghɔŋ nchiinə bənu-i daa.<verse eid="ACT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23" />“Ɔ kʉ̂ʉ dàa ŋgʉʼhə wuŋ kwi, kwɔ̀ʼtə ndə məgɛ̀ mətòʼ tʉ bəliŋ-bi, bʉə-Isilɛ. <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />Ɔ kʉ̂ʉ gɛ̀ nyíɛ liŋ-iŋ, wo-Isilɛ, wo Ijibɛʼ kə́ núʼhə ɔŋ, ndʉʉmɛ Mushi gwè túunə tʉkə-i tyú mbʉ ŋgʉəʼ, yí mbʉ wo Iji. <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />Mushi kə́ kwɔ̀ʼtə mbɔ mbʉ bəliŋ-bi bu chèʼnə mbɔ Nyii bu kwáa tʉkə-ʉə tíŋ hə bɔ̌ŋ mbəŋ-ɛŋ təmə bɔ̂ŋ chèʼnə fɛ.<verse eid="ACT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 7:26" />“Mbi kʉ̂ʉ sɛŋ fíi, ɔ bìʼ gɛ̀ mətòʼ chɔ, nyíɛ bəliŋ-bi bʉə-Isilɛ bəbûu, bɔ̂ŋ kə́ gwúu byuʼu. Ɔ kɔ̀ɔtə ndə məlìʼ ntuu-yʉə bɔŋleʼ ghɔ̀ŋ mbɔ, ‘Bii nɔ bɛ bəliŋ, kə́ gwúu byuʼu ka?’<verse eid="ACT 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 7:27" />“Bɔŋ wo ndə ɔ chìi fyùufyùu tʉ́ʉhə Mushi kɔ́ bɔ̌ŋ, bíʼtə tʉ ɔŋ mbɔ, ‘Dùʼhə nda dùʼhə a ndə mə-kə́-sɔ́ʼ baʼa ndə fɔŋ bɔŋleʼ kə́ kwɛ̀ fɛʼɛ-yaʼ. <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />A tʉʼ kʉ́ʉ yí mɔ haʼ ndə a kə yí wo Iji-i yɔ̂ŋ le mɛ?’ <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />Ndʉʉ ndə Mushi yʉ́ yɔ̄ŋ-yə, ɔ nyʉ́ʉ fyú mbʉ mu lɔʼɔ gɛ̀ bɛ ntoʼŋgwe lɔʼɔ Mediaŋ, kəyəŋ ndə ɔ bí vâabələŋ-bi chɔ bəbûu.<verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />“Ŋgʉʼhə kʉ̂ʉ tíŋ wuŋ kwi, wontəŋNyii fyú tʉ ɔŋ kwɔŋkəyəŋnə mbʉə Kwɔŋ Sina nə lɛɛŋhə-viʼi-kə mu vaa-yuu ndə i tʉʼ kyʉ́ʉ. <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />Mushi nyíɛ kə́ kwɔ̀ʼtə ntɛ-kəfɔ ndə i bɛ yɔŋ. Ndʉʉ ndə ɔ kwɛ̀ʼtə gɛ̀ mbʉə ghɔ ndə mənyíɛ, gyʉʉ-Tiekətʉ gìe tʉ ɔŋ mbɔ, <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />‘Mɔ nɔ bɛ Nyii-bətietie-ba, Nyii-Ablahaŋ, Aisi, leʼnə Jakɔ.’ Mushi gwònə nə faakə təmə leʼ mùutə ndə məlɛ́nə fɛ.<verse eid="ACT 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 7:33" />“Tiekətʉ ghɔ̀ŋ tʉ ɔŋ mbɔ, ‘Shùɔ takwubə-a, bʉʼka a nɔ tə́nə ndəŋ yəŋ-kəchɔŋ-kə. <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />A nɔ kie ndə məkínə mbɔ mɔ nɔʼ nyíɛ ŋgʉəʼ ndə bʉə-bɔŋ tʉʼ nyíɛ mu Iji. Mɔ nɔʼ yʉ́ gwia-yʉə. Mɔ nɔʼ gwè ndə məchʉ̀ʼ tʉkə-ʉə. Nduɔ gwè, mɔ bu tə́ŋ aŋ, a gɛ̀ Iji.’ <verse eid="ACT 7:34" /><verse number="35" style="v" sid="ACT 7:35" />Nɔ bɛ mbʉ Mushi nɔ ndə bɔ̂ŋ kə́ tɛ́ŋ ɔŋ kə́ ghɔ̀ŋ mbɔ, ‘Dùʼhə nda dùʼhə a ndə mə-kə́-sɔ́ʼ baʼa nə fɔŋ bɔŋleʼ kwɛ̀ fɛʼɛ-yaʼ?’ Nɔ bɛ wo nɔ ndə Nyii kə tə́ŋ ɔŋ ndə məgɛ̀ bɛ fɔŋ-yʉə bɔŋleʼ bɛ ŋkwaa-yʉə tíŋ hə bɔ̌ŋ wontəŋNyii ndə ɔ kə gwè tʉ ɔŋ mu vaa-yuu ndə i kə́ kyʉ́ʉ. <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />Ɔ chìi nuchíechubə ghɔŋbə fɔŋ-bəcheʼ, ndə məfyúhə bɔŋ hə Iji, tíŋ nə bɔŋ hə mu muukwɛʼtəŋmə ndə bə tíi nə muu-kəMbuu-mə. Ɔ gɛ̀ tòʼ ghʉ́ʉ ghɔŋ bɔŋ mu kwɔŋkəyəŋnə ndə ŋgʉʼhə wuŋ kwi kə́ gɛ̀ nə shʉbə gwè nə bɔ̌ŋ.<verse eid="ACT 7:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 7:37" />“Nɔ mbʉ Mushi nɔ ndə ɔ ghɔ̀ŋ tʉ mbʉ bʉə-Isilɛ mbɔ, ‘Nyii nɔ bu nə fyúhə yʉkəŋgie-e nə mɔ hə mu bəliŋ-bii ŋgʉʼʉbɛʼ.’ <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />Nɔ bɛ mbʉ Mushi nɔ ndə ɔ kə bɛ ghɔŋbə bʉə-Nyii mu kwɔŋkəyəŋnə ndʉʉ ndə wontəŋNyii kə kwə́ʼ tʉ ɔŋ ndəŋ Kwɔŋ Sina. Nɔ kə bɛ ghɔŋbə bətie-bʉʼʉ chɔ mɔʼɔ. Ɔ nɔ kə fí mbʉ ntəŋ ndə i gwè nə məchímbi hə kəghɔ-Nyii, téʼ tʉ bʉʼʉ.<verse eid="ACT 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39" />“Bɔŋ bətietie-bʉʼʉ chɔ́ʼ chu Mushi, kíahə ŋwɔŋ-yʉə ndəŋ ɔŋ, kə́ kʉ́ʉ ndə məbʉ̀nə gɛ̀ Iji. <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />Bɔ̂ŋ gìe tʉ Alo mbɔ, ‘Chìi bənyii tʉ baʼa ndə bəkɔ bɔ̂ŋ bɛ bəntəŋbəshʉ-baʼa, bʉʼka baʼa leʼ kínə nukə ndə i nɔʼ fyú chíe Mushi-ɔ̄, ndə ɔ lʉ̀ baʼa fyú nə yɔŋ hə mu lɔʼɔ Iji fɛ.’ <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />Ndʉʉmɛ, bɔ̂ŋ bɔ́ŋ naʼ ndə məbɛ nyii-yʉə. Bɔ̂ŋ kə́ fɛ̀ʼ ɔ, tʉʉ-yʉə kə́ bʉ̀ʉ ndəŋ mbʉ kəfɔ ndə bɔ̂ŋ chìi. <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />Ndʉʉmɛ, Nyii shìe liɛŋ tʉ bɔŋ, chɔ̀ʼhə bɔ̂ŋ kɔ́ ndə mə-kə́-lɛ́ɛŋ chichi, chisuu leʼnə bəlɔʼɔ ndə nyii-yʉə. Nɔ bɛ haʼ ndə bə kə nyɔ̀ʼ mu ŋwɔʼnə-bʉəyʉkəŋgieNyii mbɔ,</para>
  <para style="q1" vid="ACT 7:42">‘Bʉə-Isilɛ, bii nə kə́ gwè nə fɔ-fɛ̀ʼndɛŋ-bə-īŋ kwɔŋkəyəŋnə,</para>
  <para style="q2" vid="ACT 7:42">mu ŋgʉʼhə-īŋ wuŋ kwi le, kə́ gwè kɔ́ bə tʉ mɔ mɛ?<verse eid="ACT 7:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43" />Mbee, bii nɔ kə bɛ̀ʼ,</para>
  <para style="q2" vid="ACT 7:43">lɛʼ-Mulɛ-kə,</para>
  <para style="q2" vid="ACT 7:43">lɔʼ-nyii-Lafɛŋ,</para>
  <para style="q2" vid="ACT 7:43">ghɔŋbə fɔ-kɔ́ŋ-bə ndə bii kə chìi ndə mə-kə́-lə̀ʼtə.</para>
  <para style="q1" vid="ACT 7:43">Mɔ bu jə̀ŋ bii kɔ́ tʉ bii gɛ̀</para>
  <para style="q2" vid="ACT 7:43">dàa lɔ̂ŋ-Babilɔŋ.’<note caller="+" style="f"><char style="fr" closed="false">7:43 </char><char style="ft" closed="false">Ɛmɔ 5:25-27.</char></note><verse eid="ACT 7:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="ACT 7:44" />Bətietie-bʉʼʉ nɔ nə bɛ̀ʼ lɛʼ-Nyii-kə ndə i dʉ̀ʼ mbɔ Nyii bɛ ghɔŋ bɔŋ, kə́ tòʼ ghʉ́ʉ nə yɔŋ mu kwɔŋkəyəŋnə. Bɔ̂ŋ nɔ kə chìi haʼ ndə Nyii kə fʉ̀ʼtə tʉ Mushi mbɔ ɔ̈ chìi, haʼ ndə ntɛhə ndə Mushi kə nyíɛ. <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />Mbi kʉ̂ʉ nə sɛŋ fíi, bətietie-bʉʼʉ ndə bɔ̂ŋ nə kie mbʉ kəlɛʼ hə kəghɔ-bətie-bʉə, bɛ̀ʼ gɛ̀ nə yɔŋ ghɔŋbə Joshua ndʉʉ ndə bɔ̂ŋ kə fí sê lɔʼ-bətə̂ŋ-tə ndə Nyii nɔʼ kə jə̀ŋ bɔŋ mu kəyəŋ-fɛ̄ŋ hə bəshʉ bətie-bʉʼʉ. I káa chɔ tə gɛ̀ dàa ndəŋ ŋgʉʼʉmbi ndə Dɛbi nə sɛŋ sɔ́ʼ Fɔŋ.<verse eid="ACT 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="ACT 7:46" />“Tʉʉ-Nyii nə sɛŋ bʉ̀ʉ ndəŋ Dɛbi, ɔ gháa fia ndə məfʉ̀ə yəŋ-chí-kə tʉ Nyii-Jakɔ. <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />Bɔŋ kəliʼ kia bɔ́ŋ bə Salamu bɔ́ŋ mbʉ njaa. <verse eid="ACT 7:47" /><verse number="48" style="v" sid="ACT 7:48" />Buŋ ndə nɔ, Chaabəfɔŋ mə chí mu njaa ndə bɔ́ŋ woməsʉʉ nə ghɔkə-i fɛ. Haʼ ndə yʉkəŋgieNyii kə nyɔ̀ʼ mbɔ,<verse eid="ACT 7:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49" />‘Tiekətʉ nɔ bʉ́ mbɔ, “Yuo nɔ bɛ yetəkə-ɔŋ,</para>
  <para style="q2" vid="ACT 7:49">chisêkə kə́ bɛ yəŋ-tʉ́ʼ-nchɔʼhə-kə-ɔŋ.</para>
  <para style="q1" vid="ACT 7:49">Bəkɔ bii bɔ́ŋ njaafɛ̀ʼndɛŋ i bʉ̀ʉ bɛ nə yɔŋ mɛ?</para>
  <para style="q1" vid="ACT 7:49">Bəkɔ bii bɔ́ŋ yəŋ-chí-kə-ɔŋ mɛ?<verse eid="ACT 7:49" /></para>
  <para style="q2">
    <verse number="50" style="v" sid="ACT 7:50" />Chìi mɔ chìi fɔbə nchəŋnchəŋ mu yuo ghɔŋbə chisêkə fe?” ’<note caller="+" style="f"><char style="fr" closed="false">7:50 </char><char style="ft" closed="false">Adaya 66:1-2.</char></note><verse eid="ACT 7:50" /></para>
  <para style="m">
    <verse number="51" style="v" sid="ACT 7:51" />Bii bʉə-kwɛ̀ŋhə! Bii nɔʼ shʉ́əhə fyiihə-ii bɔŋ-nɔʼ-leʼ fʉ̀əŋ tyunəbə-ii ndə məyʉ́ shʉəŋ. Bii bu kə́ tɛ́ŋ haʼ LyʉʉhəNyiikə ndə bətie-bii kə tɛ́ŋ, bii lʉ̀ hə kəwu-bɔŋ mɛ? <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />B̈ii núhə mbyu yʉkəŋgieNyii imɔʼ ndə bətie-bii gòʼ təmə chɔ́ŋhə ɔŋ fɛ! Bɔ̂ŋ buŋ yí wo ndə ɔ kə lɛ́ŋhə hə bəshʉ mbɔ Wo ndə ɔ bɛ Ndyʉndyʉ la tʉʼ gwè, mbʉ Wo ndə Nyii kə Kùŋ Tə́ŋ, kə́ bɛ wo ndə bii kə fɛ̀ŋ bɔŋleʼ yí ɔ. <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />Bii nɔʼ kə kie mbʉ nuʼ hə kəghɔ-bʉəntəŋNyii, bɔŋ chaachaa tɛ́ŋ ndə mətʉ́ʼ.”<verse eid="ACT 7:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />Ndʉʉ ndə bɔ̂ŋ yʉ́ yɔ̄ŋ-yə, tʉʉ-yʉə byʉ́ʼ, bɔ̂ŋ kwó gyʉəʼtə-ʉə te Shitifɛ̄ŋ. <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />Bɔŋ bʉʼka Shitifɛ̄ŋ nɔʼ jyʉ́ʉ hə kəghɔ-LyʉʉhəNyiikə, ɔ tʉ́ʼ shʉ-i lɛ́nə yuo nyíɛ məgʉə-Nyii, bɔŋleʼ nyíɛ Jiso ɔ kə́ tə́nə kwiiləŋ Nyii. <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />Ɔ gìe tʉ bɔŋ mbɔ, “B̈ii nyíɛ, mɔ nɔʼ nyíɛ njəŋ-yuo-hə i kə́ tə́nə ighʉ́ʉnə bɔŋleʼ nyíɛ Vaa-Woməsʉʉ, ɔ kə́ tə́nə kwiiləŋ Nyii.”<verse eid="ACT 7:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57" />Ndʉʉmɛ, mbʉ bʉə mu kaŋsotə tíitə bənchəŋ, chíe tyunəbə-ʉə nə ghɔbə-ʉə, nyʉ́ʉ gɛ̀ mbʉə ɔ vɛʼ mɔʼ, <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />gɛ̀ dùu ɔ, fyúhə mu lɔʼɔ, kə́ túŋtə ɔŋ nə ŋgoʼhə. Ndʉʉmɛ, mbʉ bʉə ndə bɔ̂ŋ kə bɛ sê shùɔ ndyi-fəʼə-hə-ʉə, mɔ̀ʼ bəshʉ vaakəyɔwobɛʼ ndə yie-e kə bɛ Sɔɔ.<verse eid="ACT 7:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="ACT 7:59" />Ndə bɔ̂ŋ kə́ túŋtə ɔŋ, Shitifɛ̄ŋ gháaNyii ghɔ̀ŋ mbɔ, “Tiekətʉ-ɔ Jiso, mɔ nɔ mɛ̀ʼtə lyʉʉhəkə-ɔŋ tʉ a.” <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />Ndʉʉmɛ, Shitifɛ̄ŋ bè kweʼtəbə-i sê, tíi nə ghʉəʼkə ghɔ̀ŋ mbɔ, “Tiekətʉ, kə a mə yá bʉ̂ʼʉ-ɔ̄ kətʉ-bɔ̄ŋ fɛ!” Ɔ kʉ̂ʉ gìe yɔ̄ŋ-yə le, kwú nə wi.<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />Sɔɔ nɔ nə bɛ́ŋ mbɔ b̈ə yí Shitifɛ̄ŋ.</para>
  <para style="s" vid="ACT 8:1">Bə chɔ́ŋhə bʉə ndə bɔ̂ŋ kə bɛ́ŋ Nyii bɔ̂ŋ nyʉ́ʉ wɔ̀ʼnə</para>
  <para style="p" vid="ACT 8:1">Nɔ nə bɛ mu bəchî-ghɔ̄, bə chʉ́ʉhə məchɔ́ŋhə bʉə ndə bɔ̂ŋ kə bɛ́ŋ Nyii mu chɔshi-Jɛlosalɛŋ shʉ́əshʉ́ə, bɔ̂ŋ nyʉ́ʉ wɔ̀ʼnə gɛ̀ mu lɔʼ-bətə̂ŋ-tə mu Judia leʼnə Samalia yaʼkɛŋ mbʉ bəlɔntəŋNyii. <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />Bʉəbɛʼbə ndə bɔ̂ŋ nɔʼ kə kɔ́ ŋwɔŋ-yʉə tʉ Nyii gwè tyúu Shitifɛ̄ŋ bɔŋleʼ gwía kwu-i shʉ́əshʉ́ə. <verse eid="ACT 8:2" /><verse number="3" style="v" sid="ACT 8:3" />Sɔɔ kə́ bə́ʼ kwii-chɔshi, kə́ tòʼ fyú hə mu njaa sʉ́ʉ mu njaa, tòʼ yátə bəke ghɔŋbə bələŋ ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii, dùutə bɔŋ gɛ̀ fʉ̀əŋ mu njaa-chaŋ.<verse eid="ACT 8:3" /></para>
  <para style="s">Fili lɔ̀ʼ ŋgieNyiikə mu Samalia</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />Bɔŋ bʉə ndə bɔ̂ŋ nɔʼ kə bɛ́ŋ Nyii mu Jɛlosalɛŋ nyʉ́ʉ wɔ̀ʼnə gɛ̀ bəyəŋbəyəŋ, gɛ̀ kə́ lɔ̀ʼ ntəŋjyujyu te Jiso. <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />Fili shíʼ gɛ̀ mu Samalia ndə bɛ yəŋkwɛʼtəŋkə gɛ̀ lɔ̀ʼ ntəŋjyujyu te Jiso mbɔ ɔ la bɛ mbʉ Wo ndə Nyii Kùŋ Tə́ŋ. <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />Bʉə buŋmbi kɛŋ ŋɔ́ʼhə tyunəbə-ʉə ndə məyʉ́ nukə ndə Fili kə́ gìe bʉʼka bɔ̂ŋ kə yʉ́ fɔŋ-bəcheʼ ndə ɔ kə kə́ chìi bɔŋleʼ nyíɛ nə shʉ-yʉə. <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />Lyʉʉhəbʉəbʉəbə buŋmbi kə́ tíitə ndə bə tʉʼ fyúhə bɔŋ mu mbʉə-bʉə-hə ndə bɔ̂ŋ nɔʼ kə ŋíi chɔ. Bʉə buŋmbi ndə bɔ̂ŋ nɔʼ kə kwú kəviakəmɔʼ ghɔŋbə bìbə ndə bɔ̂ŋ nɔʼ kə lɛ́ŋ, kie nchʉʼ. <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />Ndʉʉmɛ, tʉʉjyu yɔ́ŋyɔ́ŋ wɔ̀ʼnə mu mbʉ kəyəŋkwɛʼtəŋ.<verse eid="ACT 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />Wobɛʼ ndə bə kə́ tíi ɔ nə Samu, nɔ nə bɛ wo fʉ́ʉ fê ndə ŋgʉʼhə buŋmbi mu kəyəŋkwɛʼtəŋ-ghɔ̄, kə́ chíe chu bʉə-Samalia dʉ̀ʼ ŋwɔŋ-ɛŋ ndə məbɛ wo shʉ́əshʉ́ə. <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />Bʉə bənchəŋ, vâaŋgwehə ghɔŋbə vâa-fɔŋ kə́ ghɔ̀ŋ mbɔ, “Wo-ɔ̄ nɔ bɛ mbʉ kəghʉəʼ Nyii, mbʉ Fɔŋ-kəGhʉəʼ.” <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />Bɔ̂ŋ nɔ kɛŋ kə́ yʉ́ haʼ kəghɔ-ɔ bʉʼka lʉ̀ hə ŋgʉʼŋgʉʼhə ɔ nɔʼ kə chíe chu-yʉə nə fʉbə-i ndə ɔ kə́ chìi. <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />Bɔŋ nuɔ-bʉə-buŋmbi bɛ́ŋ ntəŋjyujyu ndə Fili kə́ lɔ̀ʼ te Sɔ́ʼ-Nyii bɔŋleʼ te yie-Jiso Klai. Bʉʼka yɔ̄ŋ-yə, bəke ghɔŋbə bələŋ buŋmbi fí muu. <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />Buŋ Samu ghɔ nə mbəŋ-ɛŋ bɛ́ŋ Nyii ghɔ fí muu, kə́ tòʼ ghɔŋ Fili mɔʼɔ gɛ̀ bəyəŋbəyəŋ. Ɔ kʉ̂ʉ nyíɛ nubəcheʼbə ghɔŋ nufinəkwɛʼtəŋbə ndə Fili kə́ chìi, i chíe chu-i.<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />Ndʉʉ ndə bəlɔntəŋNyii ndə bɔ̂ŋ kə káa Jɛlosalɛŋ, yʉ́ mbɔ bʉə-Samalia la nɔʼ bɛ́ŋ ŋgieNyiikə, bɔ̂ŋ tə́ŋ Bita ghɔŋ Jɔŋ kɔ́ chɔ. <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />Ndʉʉ ndə bɔ̂ŋ tuŋ dàa chɔ, bɔ̂ŋ gháaNyii tʉ mbʉ bʉə fefe ndə bɔ̂ŋ kə bɛ́ŋ Nyii mbɔ bɔ̂ŋ kie LyʉʉhəNyiikə. <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />LyʉʉhəNyiikə chʉʼ kə shíʼ ndəŋ wo hə mu bɔŋ fɛ, bʉʼka bɔ̂ŋ nɔ nə fí muu bə haʼ yie-Jiso Tiekətʉ. <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />Ndʉʉmɛ, Bita ghɔŋ Jɔŋ mɔ̀ʼ ghɔbə-ʉə ndəŋ bʉə-bɔ̄ŋ ndə bɔ̂ŋ nɔʼ kə bɛ́ŋ Nyii nɔ, bɔ̂ŋ kie LyʉʉhəNyiikə.<verse eid="ACT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />Ndʉʉ ndə Samu kə nyíɛ ndə mbʉ bəlɔntəŋNyii mɔ̀ʼ ghɔbə-ʉə ndəŋ mbʉ bʉə, bɔ̂ŋ kie LyʉʉhəNyiikə, ɔ fyúhə kyʉə ndə mənyúɔ ghʉəʼkə-ɔ̄ŋ chɔ. <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />Ghɔ̀ŋ mbɔ, “Fɛ̀ŋ ghʉəʼkə-ɔ̄ŋ tʉ mɔ ghɔ, mbɔ mɔ chʉʼ kə́ mɔ̀ʼ ghɔkə-ɔŋ ndəŋ wo nɔ, ɔ leʼ kie LyʉʉhəNyiikə ghɔ!”<verse eid="ACT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20" />Bɔŋ Bita bə̀ŋhə mbɔ, “Kwú bɛ́ biibə kyʉə-a-ghɔ̄ ndə a kwɔ̀ʼtə mbɔ bəkɔ bə fɛ̀ŋ LyʉʉhəNyiikə ndə kyʉə nɔ. <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />A kie nukə ndəŋ yɔ̄ŋ-yə fɛ, bʉʼka fyii-a bɛ ndyʉndyʉ tʉ Nyii fɛ. <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />Shìe liɛŋ-aŋ hə ndəŋ fia-bʉəbʉə-tə-ɔ̄ŋ, gwía tʉ Tiekətʉ, ndʉʉbɛʼ ɔ sʉ̀fyii-i hə ndəŋ ŋkwɔʼtə-bʉəbʉə-a, <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />bʉʼka mɔ nɔ nyíɛ kechʉʼ fyii-a ilə́ŋnə, a bɔŋleʼ kə́ bɛ fʉə mu bʉ̂ʼʉ.”<verse eid="ACT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24" />Samu gwùʼtə ghɔ̀ŋ mbɔ, “B̈ii gwía tʉ Tiekətʉ mbɔ ntɛ-kənu-bʉəbʉə-ɔ̄ mə fyú chíe mɔ fɛ!”<verse eid="ACT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25" />Ndʉʉ ndə Bita ghɔŋ Jɔŋ kə fʉ̀ʼtə nubə ndə bɔ̂ŋ kə kínə te Jiso bɔŋleʼ lɔ̀ʼ ŋgie-Tiekətʉ-kə mu Samalia liʼ, bɔ̂ŋ bʉ̀nə gɛ̀ Jɛlosalɛŋ. Ndə bɔ̂ŋ tʉʼ bʉ̀nə, bɔ̂ŋ tə́nə mu lɔʼ-bətə̂ŋ-tə mu Samalia buŋmbi ndə məlɔ̀ʼ ntəŋjyujyu-ɔ̄.<verse eid="ACT 8:25" /></para>
  <para style="s">Fili ghɔŋ wokwɛʼtəŋ-Itobia ndə bə nɔʼ yɔ́ʼhə ɔŋ</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />WontəŋTiekətʉ ghɔ̀ŋ tʉ Fili mbɔ, “Lɔ̀ hə sê shíʼ gɛ̀ byûumbɔŋ fia kwɔŋkəyəŋnə ndə i tíŋ hə Jɛlosalɛŋ gɛ̀ Gasa.” <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />Ndʉʉmɛ, Fili lɔ̀ hə sê gɛ̀. Ndə ɔ tʉʼ gɛ̀, ɔ bìatə wokwɛʼtəŋ-Itobia sêfia ndə ɔ lɔ̀ hə Jɛlosalɛŋ ndə mələ̀ʼtə Nyii. Ɔ nɔ kə bɛ wo ndə bə nɔʼ yɔ́ʼhə ɔŋ bɔŋleʼ kə́ bɛ vaafɔ̀ʼ-Wontoʼ-Itobia ndə ɔ nə kə́ lə̀ŋ kyʉə-ɛ. <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />Ɔ kə́ bɛ fia bʉ̀nə chunjaa, kə́ dùʼ mu matu ndə b̃ənyaa-bəkatə dùu, kə́ tíi ŋwɔʼnə ndə Adaya yʉkəŋgieNyii kə nyɔ̀ʼ.<verse eid="ACT 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 8:29" />LyʉʉhəNyiikə ghɔ̀ŋ tʉ Fili mbɔ, “Kwɛ̀ʼtə gɛ̀ kə́ tòʼ hə mbʉə mbʉ matu.”<figure style="fig" alt="Philip and the Ethiopian eunuch" file="CN01932C.TIF" size="col" copy="David C. Cook" ref="8:29">Fili ghɔŋ wo-Itobia ndə bə nɔʼ yɔ́ʼhə</figure><verse eid="ACT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 8:30" />Fili nyʉ́ʉ gɛ̀ mbʉə ɔ, yʉ́ ɔ kə́ tíi ŋwɔʼnə-Adaya yʉkəŋgieNyii. Ndʉʉmɛ, ɔ bíʼtə tʉ ɔŋ mbɔ, “A tʉʼ tíi nɔ bɔŋ-kə́-leʼ kínə nu-ghɔ̄-kə mɛ?”<verse eid="ACT 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31" />Mbʉ wo-ghɔ̄ bə̀ŋhə mbɔ, “Mɔ bu kínə ntɛ təka təmə wo bɛ ghɔ ndə məfʉ̀ʼtə tʉ mɔ fɛ?” Ɔ fʉ̀ʉtə Fili mbɔ ɔ̈ kóʼ mu mbʉ matu dùʼ ghɔŋ ɔŋ mɔʼɔ. <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />Mbʉ kəyəŋ ndə ɔ kə́ tíi mu ŋwɔʼnə-Nyii nɔ bɛ mbɔ,</para>
  <para style="q1" vid="ACT 8:32">“Ɔ nɔ nə bɛ ndə binjyʉʉ ndə bə kə́ gɛ̀ síi ɔ.</para>
  <para style="q2" vid="ACT 8:32">Kə́ bɛ ndə vaa-binjyʉʉ ndə bə tʉʼ shyìi nyuhə-i,</para>
  <para style="q2" vid="ACT 8:32">ɔ líitə mbɔ loʼo, təmə ŋɔ́ʼhə chu-i fɛ.<verse eid="ACT 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33" />Bə jɛ́ŋhə ɔŋ təmə wo bɛ ghɔ ndə məkwɛ̀ ŋkwɛ-ɛ jyujyu fɛ.</para>
  <para style="q1" vid="ACT 8:33">Bɛ nda kəlɔŋ-ɔŋ ndə ɔ bu nə shi fʉ̀ʼtə,</para>
  <para style="q2" vid="ACT 8:33">bʉʼka bə nɔ chʉ̀ə məchimbi-i hə kəwʉʉnəmbi.”<note caller="+" style="f"><char style="fr" closed="false">8:33 </char><char style="ft" closed="false">Adaya 53:7-8.</char></note><verse eid="ACT 8:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 8:34" />Mbʉ woyɔ́ʼhə bíʼtə tʉ Fili mbɔ, “Mbʉ yʉkəŋgieNyii kə́ kwə́ʼ te mbəŋ-ɛŋ mɛ kə wokədɔŋ?” <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />Ndʉʉmɛ, Fili chʉ́ʉhə nə mbʉ kəyəŋ-ghɔ̄ ndə məfʉ̀ʼtə bìʼ ibɛʼ-yə ŋgiebə chɔ ndə məshyíi ɔ nə ntəŋjyujyu te Jiso.<verse eid="ACT 8:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 8:36" />Ndə bɔ̂ŋ kə́ gɛ̀, bɔ̂ŋ gɛ̀ nyíɛ muubɛʼmə, mbʉ woyɔ́ʼhə gìe tʉ ɔŋ mbɔ, “Nyíɛ! Muu nɔ, bu chìi ka təmə mɔ fí muu fɛ?” <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />[Fili ghɔ̀ŋ mbɔ, “Bəkɔ a fí, kaʼ a bɛ́ŋ Nyii nə fyii-a inchəŋ.” Mbʉ wo-ghɔ̄ bə̀ŋhə mbɔ, “Mɔ nɔ bɛ́ŋ mbɔ Jiso nɔ bɛ VaaNyii.”] <verse eid="ACT 8:37" /><verse number="38" style="v" sid="ACT 8:38" />Ndʉʉmɛ, Fili téʼ mbʉ matu tə́nə, bɔ̂ŋ shíʼ mu mbʉ muu, ɔ fí muu hə kəghɔ-Fili.<verse eid="ACT 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 8:39" />Ndʉʉ ndə bɔ̂ŋ kóʼ hə mbʉ mu muu, LyʉʉhəTiekətʉkə jɔ̀ Fili gɛ̀ nə nɔŋ. Təmə mbʉ woyɔ́ʼhə leʼ nyíɛ ɔŋ fɛ, ɔ bɔŋ gɛ̀ tʉʉ-i kə́ tòʼ bʉ̀ʉ. <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />Bɔŋ Fili nyíɛ ŋwɔŋ-ɛŋ mu kəyəŋkwɛʼtəŋbɛʼ ndə bə kə́ tíi nə Asuto. Fili kə́ lɔ̀ʼ ntəŋjyujyu chɔ leʼnə mu-bəyəŋkwɛʼtəŋ-hə ndə ɔ tíŋ sêfia tə gɛ̀ dàa Kasalia.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">Sɔɔ bɛ́ŋ Jiso</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />Bɔŋ Sɔɔ kə́ kàatə haʼ bələŋ ndə məyítə vâafɔʼɔ-Tiekətʉ. Ndʉʉmɛ, ɔ gɛ̀ bìatə Tiefɛ̀ʼndɛŋkwɛʼtəŋNyii, <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />bíʼtə tʉ ɔŋ mbɔ ɔ kɔ́ bəŋwɔʼnə tʉ ɔŋ, ndə məkie ghʉəʼkə ndə məgɛ̀ mu-njaagháaNyii-hə mu kəyəŋkwɛʼtəŋ Damasiko, gɛ̀ yátə bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ mbʉ Fia-Nyii, bəke ghɔŋbə bələŋ, kɔ́ʼtə gwè nə bɔŋ Jɛlosalɛŋ gwè fʉ̀əŋ chaŋ.<verse eid="ACT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3" />Ndʉʉ ndə ɔ kə gɛ̀ tə kə́ kə́ŋhə mbʉə Damasiko, kə́ kwɔnə nyíɛ, kɛʼɛbɛʼ báa hə yuo lèʼnə mbʉə-ɔ. <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />Sɔɔ gwù sê yʉ́ gyʉʉ, i kə́ ghɔ̀ŋ mbɔ, <char style="wj">“Sɔɔ! Sɔɔ! A tʉʼ chɔ́ŋhə mɔ mbuka?”</char><verse eid="ACT 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5" />Sɔɔ bíʼtə mbɔ, “A buŋ bɛ nda lɔɔŋ, Tiekətʉ?”</para>
  <para style="p" vid="ACT 9:5">Mbʉ gyʉʉ bə̀ŋhə mbɔ, <char style="wj">“Mɔ nɔ bɛ Jiso, wo ndə a tʉʼ chɔ́ŋhə ɔŋ le.</char> <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" /><char style="wj">Nduɔ, lɔ̀ hə sê gɛ̀ mu kəyəŋkwɛʼtəŋ, bə bu shyíi a nə nukə ndə a kie ndə məchìi.”</char><verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />Mbʉ bʉə ndə ghɔŋbə Sɔɔ kə bɛ mɔʼɔ, faa-kwu-kə yá bɔŋ, chu-yʉə chíe, bʉʼka bɔ̂ŋ yʉ́ gyʉʉ-wo bɔŋ təmə kə́ nyíɛ wo fɛ.<figure style="fig" alt="Saul on his way to Damascus" file="CN02023C.TIF" size="col" copy="David C. Cook" ref="9:7">Sɔɔ fia Damasiko</figure> <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />Sɔɔ lɔ̀ hə sê, shʉ-i ŋɔ́ʼnə bɔŋ təmə ɔ kə́ nyíɛ yəŋkə fɛ. Ndʉʉghɔfii, bɔ̂ŋ yá kwii-i, gɛ̀ nə nɔŋ Damasiko. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />Ɔ chí chɔ ndə chibə itia, təmə nyíɛ yəŋkə fɛ, təmə kɔ́ fɔkə chu-ɔ fɛ.<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />Ndʉʉ-ghɔ̄, wobɛʼ nɔ kə bɛ ghɔ mu Damasiko bə kə́ tíi ɔ nə Anania ndə ɔ kə bɛ vaafɔ̀ʼ-Jiso. Mbʉ Tiekətʉ kwə́ʼ tʉ ɔŋ mu njəŋ təmə ɔ kə́ bɛ́ŋbɛ́ŋ fɛ, tíi ɔ mbɔ, <char style="wj">“Anania!”</char></para>
  <para style="p" vid="ACT 9:10">Ɔ bə̀ŋhə mbɔ, “Yʉ́, Tie-ɔ.”<verse eid="ACT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11" />Mbʉ Tiekətʉ ghɔ̀ŋ mbɔ, <char style="wj">“Gɛ̀ mu fia ndə bə tíi nə Fia Ndyʉndyʉ, gɛ̀ mu njaa-Juda. Kʉ̂ʉ gɛ̀ dàa chɔ nɔ bíʼtə Sɔɔ ndə ɔ lɔ̀ hə Taashuʼ, ɔ tʉʼ gwía tʉ mɔ nduɔnduɔ.</char> <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" /><char style="wj">Mɔ nɔʼ dʉ̀ʼ wo tʉ ɔŋ mu njəŋ təmə ɔ kə́ bɛ́ŋbɛ́ŋ fɛ, wo ndə bə tíi ɔ nə Anania, ɔ sʉ́ʉ mɔ̀ʼ ghɔkə-i ndəŋ ɔŋ, chʉ́ʼ ɔ, ɔ bʉ̀nə nyíɛ yəŋkə.”</char><verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />Bɔŋ Anania bə̀ŋhə mbɔ, “Tiekətʉ, mɔ nɔʼ yʉ́ nu-bʉəbʉə-bə ndə wo-ɔ̄ nɔʼ fɔ̀ʼ tʉ bʉə-ba mu Jɛlosalɛŋ. <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />Baʼa bɔŋleʼ yʉ́ mbɔ bətiefɛ̀ʼndɛŋNyii la nɔʼ kɔ́ ghʉəʼkə tʉ ɔŋ ndə məyátə bʉə ndə bɔ̂ŋ tʉʼ tíi yie-a fɛ̀ŋ mbɔ a kwáa bɔŋ.”<verse eid="ACT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15" />Bɔŋ Tiekətʉ ghɔ̀ŋ mbɔ, <char style="wj">“Gɛ̀ chìi nukə ndə mɔ ghɔ̀ŋ tʉ a. Bʉʼka Sɔɔ nɔ bɛ fɔ-fɔʼɔ-kə-ɔŋ ndə mɔ nɔʼ séʼ ndə məlɔ̀ʼ yie-ɔ tʉ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ ghɔŋbə bəfɔŋ leʼnə bʉə-Isilɛ.</char> <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" /><char style="wj">Bɔŋ mɔ bu leʼ dʉ̀ʼ tʉ ɔŋ ntyʉʉ ndə ɔ kie ndə mənyíɛ ŋgʉəʼ yie-mɔ.”</char><verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />Ndʉʉghɔfii, Anania gɛ̀ sʉ́ʉ mu njaa-ghɔ̄ ndə Sɔɔ kə bɛ chɔ le, mɔ̀ʼ ghɔkə-i ndəŋ ɔŋ, ghɔ̀ŋ mbɔ, “Liŋ-ɔŋ Sɔɔ, Jiso Tiekətʉ ndə ɔ fyú tʉ a sêfia ndʉʉ ndə a kə́ gwè fɛ̄ŋ le, nɔ tə́ŋ mɔ tʉ a mbɔ a chʉʼ bʉ̀nə nyíɛ yəŋkə, LyʉʉhəNyiikə bɔŋleʼ jyʉ́ʉhə a.” <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />Haʼ ndʉʉghɔfii, fɔbɛʼkə nə wuo-mbɔʼ-bə fyú gwùtə hə shʉ Sɔɔ, ɔ bʉ̀nə nyíɛ yəŋkə. Ɔ lɔ̀ hə sê, fí muu. <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />Yɔ̄ŋ-yə kʉ̂ʉ tíŋ, Sɔɔ yú fɔkə, ghʉəʼkə gwè mbʉə-ɔ.</para>
  <para style="s" vid="ACT 9:19">Sɔɔ lɔ̀ʼ ŋgieNyiikə mu Damasiko ghɔŋbə Jɛlosalɛŋ</para>
  <para style="p" vid="ACT 9:19">Sɔɔ chí ghɔŋbə vâafɔʼɔ-Jiso mu Damasiko ndə mbyu-bəchî-hə. <verse eid="ACT 9:19" /><verse number="20" style="v" sid="ACT 9:20" />Haʼ ndʉʉghɔfii, ɔ lɔ̀ʼ ŋgieNyiikə te Jiso mu-njaagháaNyii-hə, kə́ ghɔ̀ŋ mbɔ, “Ɔ nɔ bɛ VaaNyii shʉəŋ.”<verse eid="ACT 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 9:21" />Bʉə bənchəŋ ndə bɔ̂ŋ yʉ́ ɔ, i chíe chu-yʉə. Bɔ̂ŋ kə́ bíʼtə mbɔ, “Kaa wo nɔ ndə ɔ kə́ chɔ́ŋhə bʉə daa ndə bɔ̂ŋ kə́ tíi yie-Jiso ndə məbɛ ŋkwaa-yʉə mu Jɛlosalɛŋ le fe? Baʼa bɔŋleʼ kínə ghɔ mbɔ ɔ nɔ kə gwè fɛ̄ŋ ndə məyátə bɔŋ, kɔ́ bəchaŋ təkwii-bɔŋ, gɛ̀ nə bɔŋ tʉ bətiefɛ̀ʼndɛŋNyii.”<verse eid="ACT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 9:22" />Sɔɔ bìʼ lɔ̀ʼ ŋgieNyiikə i gɛ̀ nə shʉbə shʉ́əshʉ́ə. Ɔ kɛŋ dʉ̀ʼ shʉ́əshʉ́ə mbɔ Jiso la bɛ Wo ndə Nyii Kùŋ Tə́ŋ təmə bʉə-Juu ndə bɔ̂ŋ bɛ Damasiko mə tɛ́ŋ fɛ. <verse eid="ACT 9:22" /><verse number="23" style="v" sid="ACT 9:23" />Ndə chîbə kə́ tíŋ, bəntəŋbəshʉ-bʉə-Juu shʉ̀tə ndə məyí ɔ.<verse eid="ACT 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 9:24" />Bɔŋ bə shyíi Sɔɔ nə nubə ndə bɔ̂ŋ nɔʼ shʉ̀tə yie-ɔ. Bɔ̂ŋ bɔŋ-nɔ-kə́-leʼ kʉ̀ʼ Sɔɔ ndʉʉnəchî ghɔŋbə ndʉʉbətyuʼ ndəŋ chu-lɔ̂ŋ-tə ndə i ŋíi mu lɔʼɔ, ndə məyí ɔ. <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />Bɔŋ kʉ̂ʉ bɛ ndʉʉbətyuʼ, vâafɔʼɔ Sɔɔ dùʼhə ɔŋ mu kəshyii, sʉ́ʉhə ɔŋ ndəŋ mbyuu ndəŋ sɔʼ-lɔ̂ŋ-kə shúʼhə ɔŋ tʉ́ʼ mbi.<figure style="fig" alt="Saul lowered in a basket through the window gate" file="CN01937c.TIF" size="col" copy="David C. Cook" ref="9:25">Bə shúʼhə Bɔɔ mu kəshyii ndəŋ mbyuu lɔ̌ŋ tʉ́ʼ mbi</figure><verse eid="ACT 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />Ndʉʉ ndə Sɔɔ dàa Jɛlosalɛŋ, ɔ kɔ̀ɔtə ndə məbìa vâafɔʼɔ-Jiso, bɔŋ bɔ̂ŋ kə́ fàa ɔ, kə́ kwɔ̀ʼtə mbɔ ndʉʉbɛʼ ɔ bɛ vaafɔ̀ʼ-Jiso fɛ. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />Ndʉʉmɛ, Banaba lʉ̀ ɔ gwè nə nɔŋ tʉ bəlɔntəŋNyii, shyíi bɔŋ ndə Sɔɔ nɔʼ nyíɛ Tiekətʉ sêfia Damasiko. Bɔŋleʼ ndə Tiekətʉ nɔʼ kwə́ʼ tʉ Sɔɔ leʼnə ntɛ ndə ɔ lɔ̀ʼ ŋgieNyiikə yie-Jiso nə fyii tə̀ŋnə mu Damasiko. <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />Ndʉʉmɛ, Sɔɔ káa ghɔŋ bɔŋ kə́ tòʼ gɛ̀ bəyəŋbəyəŋ mu Jɛlosalɛŋ, kə́ lɔ̀ʼ ŋgieNyiikə te yie-Tiekətʉ nə fyii tə̀ŋnə. <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />Ɔ túŋ bəŋʉʉ ghɔŋbə bʉə-Juubɛʼbə ndə bɔ̂ŋ kə́ kwə́ʼ ŋgie-Gili-kə, bɔŋ bɔ̂ŋ kə́ kʉ́ʉ fia ndə məyí ɔ. <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />Ndʉʉ ndə bʉə-Nyii yʉ́ yɔ̄ŋ-yə, bɔ̂ŋ lʉ̀ ɔ, tíŋ nə nɔŋ Kasalia, tə́ŋ ɔŋ kɔ́ lɔʼɔbə-ɔŋ Taashuʼ.<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />Fyiighʉ́ənə bɛ mu-bəchɔshi-hə mu Judia, Galili leʼnə mu Samalia. LyʉʉhəNyiikə kə́ kwèʼhə chɔshi, i kə́ shʉ́ə gɛ̀ nə shʉbə, bʉə buŋmbi kə́ bìʼ bɔŋ ndə məchimbi-yʉə tʉʼ kɔ́ kuŋhə tʉ Tiekətʉ.<verse eid="ACT 9:31" /></para>
  <para style="s">Bita chʉ́ʼ Ania bɔŋleʼ byʉ̀hə Doka ndə ɔ nɔʼ kə kwú</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />Bita kə́ tòʼ gɛ̀ bəyəŋbəyəŋ ndə mənyíɛ bʉə-Nyii. Ɔ gɛ̀ bìatə bʉə-Nyii mu Lida ndə bɛ yəŋkwɛʼtəŋkə. <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />Nɔ yəŋkə nɔ ndə ɔ kə bìatə wobɛʼ chɔ ndə bə kə́ tíi ɔ nə Ania ndə ɔ nɔʼ kə kwú kəviakəmɔʼ bɔŋ-nɔʼ-leʼ kə nʉ̀ʉ kəbɔ ndə ŋgʉʼhə fɔ̂ŋ. <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />Bita ghɔ̀ŋ tʉ ɔŋ mbɔ, “Ania, Jiso Klai chìi a kie nchʉʼ-a! Lɔ̀ hə sê shʉ̀tə bɔkə-a!” Haʼ ndʉʉmɛ, ɔ kie nchʉʼ lɔ̀ hə sê. <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />Ndʉʉmɛ, i chìi bʉə-Lida ghɔŋ Shalɔŋ bənchəŋ kíahə fyiihə-ʉə tʉ Tiekətʉ ndʉʉ ndə bɔ̂ŋ kə nyíɛ Ania, ɔ lɔ̀ hə sê kə́ tòʼ.<verse eid="ACT 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />Wokebɛʼ nɔ nə bɛ ghɔ Joba ndə ɔ nɔʼ bɛ́ŋ Nyii, bə kə́ tíi ɔ nə Tabita (i kə́ bɛ kəŋgie Gili mbɔ Doka). Ɔ kə́ chʉʼ fɔ̀ʼ nu-jyujyu-bə tʉ bəbɛʼbʉə bɔŋ-kə́-leʼ kwáa bʉə-mbʉʼ. <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />Kʉ̂ʉ bɛ ndʉʉ-ghɔ̄, ɔ yɔ́ʼ tə buŋ kwú. Bəwoke-bi shʉ̀tə ɔŋ mbɔ b̈ə tyúu ɔ, mɔ̀ʼ ɔ mu njəŋ-njaa-kweghɔʼ. <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />Bɔŋ ndʉʉ ndə vâafɔʼɔ-Jiso mu Joba kə yʉ́ mbɔ Bita nɔʼ kə́ŋhə mbʉə bɔŋ Lida, ndʉʉmɛ, bɔ̂ŋ tə́ŋ bʉə bəbûu tʉ ɔŋ mbɔ b̈ɔ̂ŋ gɛ̀ fʉ̀ʉtə ɔŋ mbɔ ɔ̈ kɔ̀ɔtə gwè haʼ ndʉʉmɛ.<verse eid="ACT 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 9:39" />Bita bʉ̀nə gɛ̀ ghɔŋ bɔŋ. Kɛŋ ndə bɔ̂ŋ tuŋ dàa haʼ ndʉʉghɔfii, bɔ̂ŋ lʉ̀ ɔ kóʼ gɛ̀ nə nɔŋ mu mbʉ njəŋ-njaa-kweghɔʼ. Mbʉ njəŋ njaa kə́ bɛ ilə́ŋnə nə bəkwuʼ bəke, kə́ gwía, dʉ̀ʼ ndyi-mu-mbʉə-hə ghɔŋbə ndyi-fəʼə-hə ndə mbʉ Doka kə chìi ndʉʉ ndə ghɔŋ bɔŋ kə bɛ mɔʼɔ. <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />Bɔŋ Bita téʼ tʉ bɔŋ bənchəŋ bɔ̂ŋ fyú mbi. Ɔ bè kweʼtəbə-i sê, gháaNyii, kíahə ŋwɔŋ-ɛŋ tʉ mbʉ kəŋkwu wo, ghɔ̀ŋ mbɔ, “Tabita, lɔ̀ hə sê!” Ɔ yɔ́ʼ shʉ-i, kʉ̂ʉ nyíɛ Bita, bə̀ŋhə ŋwɔŋ-ɛŋ dùʼ. <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />Bita chɔ̀ʼhə ghɔkə-i kɔ́ tʉ ɔŋ kwáa ɔ ndə mətə́nə, ɔ lɔ̀ tə́nə. Ndʉʉmɛ, ɔ tíi bʉə-Nyii ghɔŋbə mbʉ bəkwuʼ-bəke mu njaa, dʉ̀ʼ tʉ bɔŋ mbɔ ɔ la bɛ ŋɛnə.<verse eid="ACT 9:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 9:42" />Bəsɔʼka wɔ̀ʼnə mu mbʉ kəyəŋkwɛʼtəŋ Joba inchəŋ, bʉə buŋmbi kɔ́ fyiihə-ʉə tʉ Tiekətʉ. <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />Bita chí mu Joba tə dɔ̀ŋnə, kə́ chí ghɔŋ Samu mɔʼɔ, kə́ bɛ wo ndə ɔ kə́ núʼ gwo-nyaa-hə.<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">Kɔniliɔ tíi Bita</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />Wobɛʼ nɔ nə bɛ Kasalia yie-e kə́ bɛ Kɔniliɔ. Ɔ kə́ bɛ wokwɛʼtəŋ-bəsɔge ghyʉʉ, kə́ sɔ́ʼ nuɔ bəsɔgebɛʼbə bə kə́ tíi nə Nuɔ Bəsɔge Itali. <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />Ɔ nɔʼ kə kɔ́ ŋwɔŋ-ɛŋ tʉ Nyii. Mbəŋ-ɛŋ ghɔŋbə ŋgwie-wo-e, nɔ nə kə́ fàa Nyii. Ɔ nɔ nə kə́ kɔ́ kɔkə tʉ bʉə-mbʉʼ bɔŋ-kə́-leʼ gháaNyii təvɛʼtəvɛʼ. <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />Kʉ̂ʉ bɛ yɔŋbɛʼ mu bəchî itia ndʉʉnəchî, njəŋ chí ɔ təmə ɔ kə́ bɛ́ŋbɛ́ŋ fɛ, ɔ kɛŋ nyíɛ wontəŋNyii ndə ɔ tʉʼ gwè tʉ ɔŋ nə shʉ-i isúunə. Ɔ tíi ɔ mbɔ, “Kɔniliɔ.”<verse eid="ACT 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4" />Mbʉ Kɔniliɔ lɛ́nə ɔŋ nə faakə, bíʼtə mbɔ, “Bɛ ka, tie-ɔ?”</para>
  <para style="p" vid="ACT 10:4">Mbʉ wontəŋ bə̀ŋhə mbɔ, “MəghaaNyii-aŋ, Nyii nɔʼ yʉ́ bɔŋleʼ nyíɛ kɔkə-a tʉ bʉə-mbʉʼ! <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />Nduɔ, tə́ŋ bʉə bɔ̂ŋ shíʼ gɛ̀ Joba, gɛ̀ gwè nə wo ndə bə tíi ɔ nə Samu Bita. <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />Ɔ nɔ tʉʼ chí ghɔŋ Samu wobɛʼ ndə ɔ núʼ gwohə, fu-i bɔŋ-kə́-leʼ bɛ mbʉə muukwɛʼtəŋmə.”<verse eid="ACT 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 10:7" />Haʼ ndʉʉmɛ, ndə mbʉ wontəŋNyii bʉ̀nə nə wi, Kɔniliɔ tíi vâafɔʼɔ-bi bəbûu leʼnə wo-bəsɔgebɛʼ ndə ɔ nɔʼ kɔ́ ŋwɔŋ-ɛŋ tʉ Nyii bɔŋ-kə́-leʼ bɛ mbyu wo ndə ɔ kə́ chyìi ɔ. <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />Ɔ shyíi bɔŋ nə nubə ndə i nɔʼ fyú inchəŋ, tə́ŋ bɔŋ kɔ́ Joba.<verse eid="ACT 10:8" /></para>
  <para style="s">Bita gɛ̀ mətòʼ tʉ Kɔniliɔ</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />Mbi kʉ̂ʉ sɛŋ fíi, mbʉ bʉə-ntəŋ Kɔniliɔ, gɛ̀ tə kə́ kə́ŋhə mbʉə Joba ndʉʉbeʼ, Bita kóʼ kətʉ njaa<note caller="+" style="f"><char style="fr" closed="false">10:9 </char><char style="ft" closed="false">Bʉə-Juu nɔ nə kə́ bɔŋ njaahə-ʉə nɔ bɔ̂ŋ mɔ̀ʼ ghɔ̂ʼ chɔ, lyʉ́ʉ tʉkə-i nə chiabə təmə kwɛ̀ŋkwɛ̀ŋ fɛ. Chìi yuhəbə mbi ndə məkóʼ gɛ̀ kətʉ ghɔ.</char></note> ndə məgháaNyii, <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />jyʉʉ yɔ́ʼ ɔ, ɔ kə́ kʉ́ʉ ndə məyú fɔkə, bɔŋ ndʉʉ ndə bə kə́ chìi mbʉ bəfɔ, njəŋ chí ɔ təmə ɔ kə́ bɛ́ŋbɛ́ŋ fɛ. <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />Ɔ nyíɛ yuo ndə i ŋɔ́ʼnə, fɔbɛʼkə nə kwii ndyi kə́ shíʼ, bə shíʼhə nə fuuhə-i kwi kəchisê. <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />Mu mbʉ kəfɔ-ghɔ̄ ntɛnyaantɛnyaa kə́ bɛ chɔ. Nyaahə ndə bɔ̂ŋ shyìi ndyʉndyʉ nə yɔhə ghɔŋbə nuɔ-mbi-mə kə́ bɛ muŋgɔ. <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />Ɔ yʉ́ gyʉʉ ndə i ghɔ̀ŋ tʉ ɔŋ mbɔ, “Lɔ̀ hə sê, Bita, yítə fɔbə-ɔ̄ŋ kwó.”<verse eid="ACT 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14" />Bita bə̀ŋhə mbɔ, “Mbee Tiekətʉ, mɔ chʉʼ nə kwó fɔ-nchʉʉhə-kə fɛ.”<verse eid="ACT 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15" />Mbʉ gyʉʉ bìʼ kwə́ʼ mbɔ, “Kaʼ Nyii nɔʼ chóʼ fia mbɔ b̈ə yú fɔkə kə a mə tíi nə fɔ-nchʉʉhə-kə fɛ.” <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />Ntɛ kənu-ghɔ̄ bìʼ chìi ɔ tə bɛ vɛʼ tia, ndʉʉmɛ mbʉ kəfɔ-ghɔ̄ ndə i bɛ nə kwii ndyi le, bə bʉ̀nə dùu kóʼhə, gɛ̀ nə yɔŋ-yə yuo.<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />Nu-ɔ̄-kə chɔ́ŋhə Bita daa, ɔ kə́ kwɔ̀ʼtə mbɔ bəkɔ yɔ̄ŋ-yə bɛ ŋgwɔ kənu ka. Kə nyíɛ, bʉə-bīŋ ndə Kɔniliɔ kə tə́ŋ le kə́ bíʼtə njaa ndə Samu chí chɔ, kʉ̂ʉ nyíɛ mbʉ njaa tə́nə mbi chulɔŋ, <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />tíi kə́ bíʼtə mbɔ, “Bɛ yəŋkə nɔ ndə Samu Bita tʉʼ chí chɔ mɛ?” <verse eid="ACT 10:18" /><verse number="19" style="v" sid="ACT 10:19" />Ndə Bita tʉʼ kwɔ̀ʼtə te nu-ghɔ̄-kə, LyʉʉhəNyiikə ghɔ̀ŋ tʉ ɔŋ mbɔ, “Nyíɛ! Bələŋ bətia nɔ tʉʼ lɛ́nə aŋ. <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />Lɔ̀ hə sê, shíʼ gɛ̀ bìatə bɔŋ, bii bɔŋ gɛ̀, kə a mə tɛ́ŋ fɛ. Nɔ tə́ŋ mɔ tə́ŋ bɔŋ.”<verse eid="ACT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 10:21" />Ndʉʉmɛ, Bita shíʼ gɛ̀ bìatə bɔŋ, ghɔ̀ŋ mbɔ, “Mɔ nɔ bɛ wo ndə bii tʉʼ kʉ́ʉ le, bii tʉʼ gwè yì ka?”<verse eid="ACT 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22" />Bɔ̂ŋ ghɔ̀ŋ mbɔ, “Nɔ tə́ŋ Kɔniliɔ mbyu wokwɛʼtəŋ-bəsɔge ghyʉʉ tə́ŋ baʼa. Nɔ bɛ wo ndə ɔ bɛ ndyʉndyʉ kə́ fàa Nyii, bʉə-Juu bɔŋleʼ kə́ kɔ́ kuŋhə tʉ ɔŋ. Wontəŋ ndə ɔ lɔ̀ hə bəshʉ-Nyii nɔ kə téʼ tʉ ɔŋ mbɔ ɔ tə́ŋ tíi a, ä gwè shyíi ɔ nə nukə.” <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />Ndʉʉmɛ, Bita tíi bɔŋ ndə məbɛ bʉə-mətòʼ-bi ndʉʉŋkʉʼ-ghɔ̄. Mbi kʉ̂ʉ sɛŋ fíi, ɔ lɔ̀ gɛ̀ ghɔŋ bɔŋ ghɔŋbə bəbɛʼbʉə ndə bɔ̂ŋ nɔʼ kə bɛ́ŋ Nyii mu Joba.<verse eid="ACT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 10:24" />Mbi kʉ̂ʉ sɛŋ kə bìʼ fíi, bɔ̂ŋ dàa Kasalia. Kɔniliɔ nɔʼ kɔ̀ʼnə bʉə-bi ghɔŋbə bʉə-kətoʼ-bi, ghɔŋ bɔ̂ŋ kə́ chyìi Bita. <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />Ndə Bita ŋíi chunjaa-ɔ, Kɔniliɔ bʉ́ʉnə yʉ̀əʼ shʉbə-i ndə mələ̀ʼtə ɔŋ. <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />Bɔŋ Bita chɔ̀ʼhə ɔŋ sê ghɔ̀ŋ mbɔ, “Mɔ nɔ bɛ haʼ woməsʉʉ ndə a.” <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />Ndʉʉmɛ, Kɔniliɔ lɔ̀ hə sê, ghɔŋ ɔŋ kə́ kwə́ʼ, sʉ́ʉ gɛ̀ mu njaa, gɛ̀ bìatə bəbɛʼbʉə ndə bɔ̂ŋ kə dùʼtə chɔ.<verse eid="ACT 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 10:28" />Bita ghɔ̀ŋ tʉ bɔŋ mbɔ, “Bii nɔ kínə mbɔ nɔ nu-bʉə-kə ndə nuʼ bʉə-Juu tʉ mɔ ndə məyúnə byuunɔ məŋíi mu njaa wo təmə kə́ bɛ wo-Juu fɛ. Nyii bɔŋ nɔʼ dʉ̀ʼ tʉ mɔ mbɔ, mɔ mə nə tíi wo nə wo ndə ɔ nɔʼ bʉ́əhə ŋwɔŋ-ɛŋ bəshʉ-Nyii byuunɔ bɛ nə məfɛ̀ mbʉə-ɔ fɛ. <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />Nɔ chìi yɔŋ mɔ gwè haʼ ndʉʉghɔfii ndə bə tə́ŋ tíi mɔ. Nduɔ, shyíi mɔ nə nukə ndə a kə́ tíi mɔ chɔ.”<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />Kɔniliɔ bə̀ŋhə mbɔ, “Nɔ bɛ chîbə kwi laa ndə mɔ kə́ gháaNyii mu njaa-mɔ haʼ ndə ndʉʉ-ɔ̄ mənɔ, bəchî itia ndʉʉnəchî, kə kwɔnə nyíɛ, wobɛʼ nə ndyi-kəfyuʼ-chɛŋ-hə kə́ tə́nə bəshʉ mɔ. <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />Ɔ ghɔ̀ŋ mbɔ, ‘Kɔniliɔ, Nyii nɔʼ yʉ́ gwia-a, bɔŋleʼ nyíɛ kɔkə-a tʉ bʉə-mbʉʼ. <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />Nduɔ tə́ŋ bʉə-Joba tíi Bita, ɔ nɔ tʉʼ chí fu Samu ndə ɔ tʉʼ núʼ gwohə bɔŋ-kə́-leʼ chí mbʉə muukwɛʼtəŋmə.’ <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />Nɔ chìi yɔŋ mɔ tə́ŋ tíi a haʼ ndʉʉghɔfii, i nɔ bʉ̀ʉ ndə a gwè nɔ. Baʼa nɔ tə́nə fɛ̄ŋ bəshʉ-Nyii, kə́ chyìi ndə məyʉ́ ntəŋ ndə a gwè nə yɔŋ-yə kəghɔ-Tiekətʉ.”<verse eid="ACT 10:33" /></para>
  <para style="s">Bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ yʉ́ ntəŋjyujyu</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />Ndʉʉmɛ, Bita bə̀ŋhə mbɔ, “Mɔ nɔʼ nyíɛ nduɔ shʉəŋ mbɔ Nyii kyinə túhə shʉ fɛ.” <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />Mu lɔʼ-bətə̂ŋ-tə inchəŋ ɔ nɔ tʉʼ bɛ́ŋ bʉə ndə bɔ̂ŋ tʉʼ fàa ɔ bɔŋ-kə́-leʼ fɔ̀ʼ nubə ndə i kʉ̀ʼnə. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />Bii nɔʼ kə yʉ́ ntəŋjyujyu ndə i gwè hə kəghɔ-Nyii tʉ bʉə-Isilɛ, mbɔ f̃yiighʉ́ənə nɔ gwè hə kəghɔ-Nyii tíŋ hə bɔ̌ŋ Jiso Klai, ndə ɔ bɛ Tiekətʉ bʉə bənchəŋ. <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />Bii bɔŋleʼ kínə nukə ndə i kə fyú mu Judia inchəŋ chʉ́ʉhə mu Galili, ndʉʉ ndə Jɔŋ nə kə́ lɔ̀ʼ mbɔ bʉə la shìe liɛŋ ndəŋ bʉ̂ʼtə-ʉə ɔ kɔ́ muu tʉ bɔŋ. <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />Bii nɔ kínə ntɛ ndə Nyii kə kùŋ Jiso ndə ɔ lɔ̀ hə Nasalɛ nə LyʉʉhəNyiikə ghɔŋbə ghʉəʼkə, kínə ntɛ ndə ɔ kə tòʼ yə̀ŋ yəŋbə fɔ̀ʼ nu-jyujyu-bə bɔŋleʼ chʉ́ʼ bʉə bənchəŋ ndə Debulu tʉʼ chɔ́ŋhə bɔŋ bʉʼka ghɔŋ Nyii nɔ nə bɛ mɔʼɔ.<verse eid="ACT 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 10:39" />“Mbəŋ-yaʼ, bəlɔntəŋ Jiso, nɔ nyíɛ nubə-ɔ̄ŋ nə shʉ-yaʼ ndə ɔ kə fɔ̀ʼ mu lɔʼɔ bʉə-Juu leʼnə Jɛlosalɛŋ inchəŋ. Bɔ̂ŋ nɔ nə kwɛ̀ŋ ɔŋ kwɛ̀ŋ yí ndəŋ tyʉntɔɔnəkə, <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />bɔŋ chîbə kʉ̂ʉ tíŋ itia Nyii bʉ̀nə kóʼhə ɔŋ. Ndʉʉmɛ, ɔ chìi ɔ kɛ̀ʼ ŋwɔŋ-ɛŋ bə nyíɛ ɔŋ ntaa. <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />Ɔ kə kɛ̀ʼ ŋwɔŋ-ɛŋ bə tʉ bʉə buŋmbi fɛ, ɔ nɔ nə kɛ̀ʼ haʼ tʉ mbəŋ-yaʼ ndə Nyii nɔʼ kə séʼ hə bəshʉ mbɔ baʼa shyíi bʉə nə ŋgiekə-i, tʉ mbəŋ-yaʼ ndə baʼa bɔŋ nə kə́ yú bɔŋleʼ nú mɔʼɔ, ndʉʉ ndə ɔ kə bʉ̀nə kóʼ hə ndəŋ kwu. <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />Ɔ nɔ nə kàhə baʼa mbɔ baʼa gɛ̀ lɔ̀ʼ bɔŋleʼ shyíi bʉə mbɔ Jiso la bɛ kuŋ Nyii ndə ɔ bu sɔ́ʼ bʉə bənchəŋ, bʉə ndə bɔ̂ŋ bíe mbi ghɔŋbə bʉə ndə bɔ̂ŋ nɔʼ kwútə. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />Nɔ bɛ mbəŋ-ɛŋ ndə bʉəyʉkəŋgieNyii bənchəŋ nə kwə́ʼ te ɔ, kə́ ghɔ̀ŋ mbɔ wotəmiyɔŋ ndə ɔ bɛ́ŋ ɔŋ, bə bu sʉ̀fyii ndə bʉ̂ʼʉ-e tíŋ hə bɔ̌ŋ ɔŋ.”<verse eid="ACT 10:43" /></para>
  <para style="s">Bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ kie LyʉʉhəNyiikə</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />Ndə Bita tʉʼ kwə́ʼ ŋgiebə-ɔ̄ŋ, LyʉʉhəNyiikə shíʼ ndəŋ bʉə bənchəŋ ndə bɔ̂ŋ kə́ yʉ́.<verse eid="ACT 10:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="ACT 10:45" />Bʉə-Juu ndə bɔ̂ŋ nɔʼ kə bɛ́ŋ Nyii ndə ghɔŋbə Bita kə gwè mɔʼɔ i chàa bɔŋ ndə bəkɔ kɔ-kəLyʉʉhəNyii-kə ghɔ shíʼ ndəŋ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ. <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />Bʉʼka bɔ̂ŋ nɔ kə yʉ́ ndə bɔ̂ŋ kə kə́ kwə́ʼ ŋgie-bətə̂ŋ-kədɔŋ-bə bɔŋ-kə́-leʼ lə̀ʼtə Nyii.</para>
  <para style="p" vid="ACT 10:46">Ndʉʉmɛ, Bita ghɔ̀ŋ mbɔ, <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />“Nduɔ ndə LyʉʉhəNyiikə nɔʼ shíʼ ndəŋ bɔŋ haʼ ndə ɔ kə shíʼ ndəŋ bʉʼʉ nɔ, bəkɔ wo leʼ tɛ́ŋ mbɔ bɔ̂ŋ mə fí muu fɛ mɛ?” <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />Ndʉʉmɛ, Bita kàhə bɔŋ mbɔ bɔ̂ŋ fí muu yie-Jiso Klai. Kʉ̂ʉ kə́ liʼ, bɔ̂ŋ fʉ̀ʉtə ɔŋ mbɔ ɔ chí ghɔŋ bɔŋ ndə mbyu-bəchî-hə.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s">Bita fʉ̀ʼtə fɔʼɔ-ɛ mu chɔshi</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />Kʉʉkə məniʼ, ntəŋ dàa tʉ bəlɔntəŋNyii ndə bɔ̂ŋ bɛ mu Judia, leʼnə bəbɛʼbʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii, mbɔ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ la nɔʼ bɛ́ŋ ŋgieNyiikə. <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />Bɔŋ ndʉʉ ndə Bita bʉ̀nə gɛ̀ dàa Jɛlosalɛŋ, bəbɛʼbʉə Juu ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii,<note caller="+" style="f"><char style="fr" closed="false">11:2 </char><char style="ft" closed="false">B̃ʉə-Juu-bɛʼbə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii nɔ kə́ ghɔ̀ŋ mbɔ, ndə mədʉ̀ʼ mbɔ wo nɔʼ bɛ́ŋ Nyii leʼ shʉəŋ, bə nɔ kie ndə məfɔ̀ʼ ɔ.</char></note> dʉ̀ʉhə ɔŋ, <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />kə́ ghɔ̀ŋ mbɔ, “A nɔ gɛ̀ ŋíi mu njaa-bʉə ndə bə gòʼ təmə nɔʼ fɔ̀ʼ bɔŋ fɛ, kə́ yú bii bɔŋ.”<verse eid="ACT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 11:4" />Ndʉʉmɛ, Bita chʉ́ʉhə, məfʉ̀ʼtə tʉ bɔŋ ndə nubə kə tíŋ kɛŋ haʼ ndə i kə bɛ. <verse eid="ACT 11:4" /><verse number="5" style="v" sid="ACT 11:5" />Ɔ ghɔ̀ŋ mbɔ, “Nɔ kə bɛ yɔŋbɛʼ ndə mɔ kə bɛ Joba kə́ gháaNyii, nubɛʼkə kwɔnə chìi mɔ fi nə mɔ tʉʼ bɛ́ŋbɛ́ŋ, njəŋ chí mɔ təmə mɔ kə́ bɛ́ŋbɛ́ŋ fɛ. Fɔbɛʼkə nə fuuhə-i kwi, shíʼ gwè hə yuo nə kwii-ndyi, gwè nʉ̀ʉ bəshʉ mɔ. <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />Mɔ kʉ̂ʉ lɛ́nə mu-i nyíɛ ntɛnyaantɛnyaa nə nyaa-chunjaa-hə, nyaa-muŋkɔ-hə, nyaahə ndə bɔ̂ŋ shyìi ndyʉndyʉ nə yɔhə leʼnə nuɔ-mbi-mə. <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />Mɔ yʉ́ gyʉʉ ndə i ghɔ̀ŋ mbɔ, ‘Bita, lɔ̀ hə sê, yítə fɔbə-ɔ̄ŋ, kwó.’<verse eid="ACT 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 11:8" />“Mɔ bə̀ŋhə mbɔ, ‘Mbee, Tiekətʉ! Mɔ chʉʼ nə kwó fɔ-nchʉʉhə-kə fɛ.’<verse eid="ACT 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 11:9" />“Bɔŋ mbʉ gyʉʉ bìʼ gwè hə yuo mbɔ, ‘Kaʼ Nyii nɔʼ chóʼ fia mbɔ b̈ə yú fɔkə, kə a mə tíi nə fɔ-nchʉʉhə-kə fɛ.’<verse eid="ACT 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 11:10" />“Ï bɛ haʼ nɔ tə bɛ vɛʼ tia, ndʉʉmɛ, mbʉ kwii-ndyi buŋ kóʼ yuo ghɔŋbə fɔbə ndə i bɛ muŋgɔ inchəŋ. <verse eid="ACT 11:10" /><verse number="11" style="v" sid="ACT 11:11" />Haʼ ndʉʉmɛ, bʉə bətia ndə bə kə tə́ŋ hə Kasalia, gwè dàa mbʉ chunjaa ndə baʼa kə́ chí chɔ. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />LyʉʉhəNyiikə ghɔ̀ŋ tʉ mɔ mbɔ b̈aʼa bɔŋ la gɛ̀ mɔʼɔ, kə mɔ la mə lə̀ŋnə mbɔ bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ. Bəliŋ-bɔŋ-bɔ̄ŋ ntʉʼʉ nɔ, nɔ kə lɔ̀ baʼa bɔŋ mɔʼɔ, gɛ̀ dàa mbʉ chunjaa wo ndə ɔ kə tə́ŋ tíi baʼa. <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />Ɔ fʉ̀ʼtə tʉ baʼa ndə wontəŋNyii kə kwɔnə fyú tʉ ɔŋ chunjaa-ɔ, ghɔ̀ŋ tʉ ɔŋ mbɔ, ‘Tə́ŋ bʉə-ntəŋ Joba, bɔ̂ŋ gɛ̀ gwè nə Samu Bita. <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />Ɔ bu gwè shyíi a, biibə bʉə-njaa-ba bənchəŋ, nə nukə ndə bii bu chìi ndə məkie ŋkwaa kəghɔ-Nyii.’<verse eid="ACT 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 11:15" />“Ndʉʉ ndə mɔ chʉ́ʉhə məkwə́ʼ ŋgieNyiikə tʉ bɔŋ, haʼ ndʉʉmɛ, LyʉʉhəNyiikə shíʼ ndəŋ bɔŋ, haʼ ndə ɔ kə shíʼ ndəŋ bʉʼʉ lʉ̀ hə ndəŋ nchʉʉhə. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />Ndʉʉmɛ, mɔ kwɔ̀ʼtə ŋgie-Tiekətʉ-kə ndə ɔ kə ghɔ̀ŋ mbɔ, <char style="wj">‘Jɔŋ nɔ nə kɔ́ muu tʉ bii, bə bɔŋ bu kɔ́ LyʉʉhəNyiikə.’</char> <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />Kaʼ Nyii kɔ́ mbʉ ntɛ kəkɔ tʉ bʉə-bɔ̄ŋ ndə bɔŋ gòʼ təmə bɛ bʉə-Juu fɛ, haʼ ndə ɔ kə́ kɔ́ tʉ bʉʼʉ ndə bʉʼʉ kə bɛ́ŋ Jiso Klai Tiekətʉ, mɔ kə bɛ nda ndə məchíe fia-Nyii?”<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />Ndʉʉ ndə bəbɛʼbʉə yʉ́ yɔ̄ŋ-yə, nubə ndə i bɛ mu fyii-bɔŋ ghʉ́ə, bɔ̂ŋ chʉ́ʉhə mə-kə́-lə̀ʼtə Nyii. Bɔ̂ŋ kə́ ghɔ̀ŋ mbɔ, “Nyii nɔʼ ŋɔ́ʼhə fia ghɔ tʉ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ ndə məshìe liɛŋtə-ʉə ghɔ hə ndəŋ bʉ̂ʼtə-ʉə bɔŋleʼ kie məchímbi təmə liʼ-i ghɔ fɛ.”<verse eid="ACT 11:18" /></para>
  <para style="s">Chɔshi ndə i bɛ Antiɔk mu Silia</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />Bəbɛʼbʉə ndə bɔ̂ŋ nɔʼ kə bɛ́ŋ Nyii, nyʉ́ʉ hə mu Jɛlosalɛŋ ndʉʉ ndə Shitifɛ̄ŋ kə kwú bə shi kə́ chɔ́ŋhə bɔŋ. Bɔ̂ŋ gɛ̀ mu lɔʼ-bətə̂ŋ-tə nə Fɔnishia, Siblɔ leʼnə Antiɔk ndə i bɛ mu Silia. Ndə bɔ̂ŋ kə́ gɛ̀, bɔ̂ŋ kə́ lɔ̀ʼ ŋgieNyiikə haʼ tʉ bʉə-Juu. <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />Bɔŋ bəbɛʼbʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii, lɔ̀ hə mu Siblɔ leʼnə Silɛŋ, gɛ̀ Antiɔk kə́ lɔ̀ʼ ntəŋjyujyu te nə Jiso Tiekətʉ tʉ bʉə ndə bɔ̂ŋ kə́ kwə́ʼ ŋgie-Gili-kə. <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />Tiekətʉ kə́ bɛ ghɔŋ bɔŋ mɔʼɔ, bʉə buŋmbi ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ bɛ́ŋ Nyii, kíahə ŋwɔŋtə-ʉə gɛ̀ tʉ Tiekətʉ.<verse eid="ACT 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22" />Ndʉʉ ndə chɔshi mu Jɛlosalɛŋ kə yʉ́ nukə ndə i nɔʼ fyú, bɔ̂ŋ tə́ŋ Banaba kɔ́ Antiɔk. <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />Ndʉʉ ndə ɔ dàa nyíɛ ntɛ buuŋjyu ndə Nyii nɔʼ dʉ̀ʼ tʉ bɔŋ, i bʉ̀ʉ ɔ, ɔ kwèʼhə bɔŋ ndə məlyʉ̀ʉtə́nə ndəŋ fia-Tiekətʉ nə shʉəŋ. <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />Banaba nɔ nə bɛ yʉʼ wo, LyʉʉhəNyiikə nɔʼ kɛŋ jyʉ́ʉhə ɔŋ, ɔ bɔŋleʼ kɔ́ fyii-i tʉ Nyii shʉ́əshʉ́ə, bʉə buŋmbi bìʼ gwè tʉ Tiekətʉ.<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />Ndʉʉmɛ, Banaba lɔ̀ gɛ̀ Taashuʼ ndə məgɛ̀ lɛ́nə Sɔɔ. <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />Ndʉʉ ndə ɔ nyíɛ ɔŋ, ɔ bʉ̀nə gwè nə nɔŋ Antiɔk. Bɔ̂ŋ bənchəŋ chí chɔ ghɔŋbə bʉə-chɔshi ndə ŋgʉʼʉmbi, kə́ dàhə bʉə buŋmbi. Nɔ yəŋkə nɔ ndə bə kə chʉ́ʉhə mətíi vâafɔʼɔ-Jiso chɔ nə bəKʉlʉtɛŋ.<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />Kʉ̂ʉ bɛ ndʉʉ-ghɔ̄, bəbɛʼbʉəyʉkəŋgieNyii lɔ̀ hə Jɛlosalɛŋ shíʼ gɛ̀ Antiɔk. <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />Mbyu wo mu bɔŋ bə kə́ tíi ɔ nə Agabu lɔ̀ tə́nə mu nchəŋtə-yʉə gìe nə ghʉəʼ-kəLyʉʉhəNyii-kə mbɔ chyʉʉ shʉ́əshʉ́ə la bu yi gwù mu wʉʉnəmbi-Luŋ-kə<note caller="+" style="f"><char style="fr" closed="false">11:28 </char><char style="ft" closed="false">Nɔ nə kə́ sɔ́ʼ Luŋ sɔ́ʼ mbi vɛʼ-ghɔ̄, lɔʼ-bətə̂ŋ-tə buŋmbi kə́ bɛ́ŋ ŋgəŋ-yʉə.</char></note> inchəŋ. Nukə-ɔ̄ŋ nɔ nə fyú shʉəŋ ndʉʉ ndə Kladio kə sɔ́ʼ Fɔŋ. <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />Vɛʼ-ghɔ̄, vâafɔʼɔ-Jiso mu Antiɔk lʉ̀ ntənəmə-ʉə ndə məmɔ̀ʼ fɔyubə tə́ŋ tʉ bəbɛʼbʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii ghɔ mu Judia, wotəmiyɔŋ kə́ mɔ̀ʼ haʼ ghʉə ndə bəkɔ ɔ kɔ́. <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />Bɔ̂ŋ mɔ̀ʼ mbʉ bəfɔ, tə́ŋ tʉ Banaba ghɔŋ Sɔɔ, bɔ̂ŋ gɛ̀ nə yɔŋ gɛ̀ kɔ́ tʉ bəntəŋbəshʉ ndə bɔ̂ŋ bɛ mu Jɛlosalɛŋ.<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s">Bə yí Jɛŋ, fʉ̀əŋ Bita chaŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />Nɔ kə bɛ ndʉʉ-ɔ̄, Hɛlo ndə ɔ kə bɛ Fɔŋ chʉ́ʉhə mə-kə́-chɔ́ŋhə bʉə ndə bɔ̂ŋ bɛ́ŋ Nyii mu chɔshi. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />Ɔ yí Jɛŋ liŋ-Jɔŋ nə setəkə. <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />Hɛlo kʉ̂ʉ nyíɛ ndə i bʉ̀ʉ bəntəŋbəshʉ-bʉə-Juu, ɔ yá Bita mu bəchî ndə bə kə́ yú Nchəŋtə ndə bə Kwó Bele təmə yî chɔ fɛ, <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />fʉ̀əŋ ɔŋ chaŋ, téʼ tʉ nuɔ-bəsɔge-tə kwi, ndə mbyu nuɔ imɔʼ bɛ bəsɔge kwi, ndə mə-kə́-chyìi ɔ. Hɛlo nɔ kə kie mu fyii-ɔ mbɔ mbʉ Nchəŋtə Yíɛʼsii kʉ̂ʉ tíŋ nɔ, ɔ fyúhə Bita, gwè nə nɔŋ bəshʉ bʉə, ɔ kwɛ̀ fɛʼɛ-ɛ. <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />Bɔŋ ndʉʉ ndə Bita kə bɛ chaŋ, bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii, kɛŋ gháaNyii nə fyiihə-ʉə imɔʼ shʉ́əshʉ́ə tʉ ɔŋ.<verse eid="ACT 12:5" /></para>
  <para style="s">Nyii fyúhə Bita mu njaa-chaŋ</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />Ndʉʉbətyuʼ ndə mbi bu sɛŋ fíi ndə Hɛlo kie ndə məgwè nə Bita bə kwɛ̀ fɛʼɛ-ɛ, ɔ kʉ̂ʉ nʉ̀ʉ ntəŋntəŋ bəsɔge kə́ bɛ́ŋbɛ́ŋ, bə kɔ́ʼ kwiitə-i nə bəchaŋ ibûu, bəbɛʼbə bəsɔge kə́ tə́nə chulɔŋ-njaa-chaŋ kə́ chyìi, <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />kə́ kwɔnə nyíɛ, mbʉ mu njaa-chaŋ báa, wontəŋTiekətʉ tə́nə bəshʉ Bita. Mbʉ wontəŋTiekətʉ gwúutə ŋkyii-i, ghɔ̀ŋ tʉ ɔŋ mbɔ, “Chʉʼ lɔ̀ hə sê.” Ndʉʉmɛ, mbʉ bəchaŋ fyú bətʉkwii-ɔ gwù sê. <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />Ndʉʉmɛ, mbʉ wontəŋNyii gìe tʉ ɔŋ mbɔ, “Mɔ̀ʼ ndyihə-a, kɔ́ takwubə-a.” Ɔ bìʼ ghɔ̀ŋ tʉ ɔŋ mbɔ, “Mɔ̀ʼ ndyi-fəʼə-a gwè, baʼa gɛ̀.”<verse eid="ACT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 12:9" />Ndʉʉmɛ, Bita fyú mbʉ mu njaa-chaŋ kə́ gɛ̀ hə bɔ̌ŋ mbʉ wontəŋNyii. Bɔŋ ɔ kə́ kwɔ̀ʼtə mbɔ la bɛ njəŋ ndə i tʉʼ chí ɔ, təmə kə́ kínə mbɔ bɛ nu-shʉəŋ-kə fɛ. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />Ndʉʉ ndə bɔ̂ŋ tíŋ fəŋ chulɔŋ, tíŋ biitəkə, gɛ̀ dàa ndə chulɔŋ-kətəŋ ndə i fyú hə mu kəyəŋkwɛʼtəŋ, mbʉ chulɔŋ yɔ̀ʼnə nə mbəŋ-ɛŋ, bɔ̂ŋ fyú mbi kʉ̂ʉ tíŋ ndəŋ fia imɔʼ, haʼ ndʉʉghɔfii, mbʉ wontəŋNyii kwɔnə bɛ́ hə shʉ-ɔ.<verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />Kəliʼ, shʉ Bita súunə ndə nukə ndə i kə́ tíŋ, ɔ ghɔ̀ŋ mbɔ, “Nduɔ, mɔ nɔ kínə shʉəŋshʉəŋ mbɔ nɔ tə́ŋ Tiekətʉ tə́ŋ wontəŋ-ɛŋ mbɔ ɔ gwè kwáa tʉkə-ɔŋ hə kəghɔ-Hɛlo ghɔŋbə bʉə-Juu ndəŋ nukə ndə bɔ̂ŋ kə́ kwɔ̀ʼtə te mɔ.”<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />Ɔ kʉ̂ʉ kwɔ̀ʼtə tʉkə-i, lɔ̀ gɛ̀ fu-Mɛli ŋkwê-Jɔŋ Mak, ndə bʉə buŋmbi kə́ chə̀ŋtə chɔ kə́ gháaNyii. <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />Ɔ kwɔ̀ŋ chulɔŋ, vaabəkebɛʼ ndə yie-e kə́ bɛ Luda, kə́ bɛ vaafɔ̀ʼ mu njaa-ghɔ̄, gwè ndə məchóʼ. <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />Ndʉʉ ndə ɔ chèʼnə gyʉʉ-i, tʉʉ-i bʉ̀ʉ daa, ɔ bʉ̀nə nyʉ́ʉ gɛ̀ mu njaa təmə chóʼ mbʉ chulɔŋ fɛ, gìe tʉ bʉə bənchəŋ mbɔ, “Bita tə́nə nɔ chusii!”<verse eid="ACT 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 12:15" />Bɔ̂ŋ bíʼtə tʉ ɔŋ mbɔ, “Mu kətʉ-a tʉʼ fɔ̀ʼ kʉ̀ʼnə mɛ?” Ndʉʉ ndə ɔ tʉʼ lyʉ̀ʉ, bɔ̂ŋ lìʼ mbɔ, “Kaʼ yì ka nɔ bɛ vaantie-e ndə ɔ lɔ̀ hə bəshʉ-Nyii.”<note caller="+" style="f"><char style="fr" closed="false">12:15 </char><char style="ft" closed="false">Bʉə-Juu nɔ kínə mbɔ w̃o nɔ bɛ́ŋ Nyii nɔ, Nyii tə́ŋ wontəŋ-ɛŋ ndə ɔ bu kə́ chyìi ɔ bɔŋleʼ fɔ̀ʼ tʉ ɔŋ nə vaantie-e.</char></note><verse eid="ACT 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16" />Bita lyʉ̀ʉtə́nə kə́ kwɔ̀ŋ haʼ mbʉ chulɔŋ kwɔ̀ŋ. Ndʉʉ ndə bɔ̂ŋ fyú gɛ̀ chóʼ mbʉ chulɔŋ, nyíɛ mbɔ bɛ Bita, i chàa bɔŋ. <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />Ɔ chètə bɔŋ nə ghɔkə-i mbɔ bɔ̂ŋ líitə, ɔ fʉ̀ʼtə nukə ndə i nɔʼ fyú tʉ ɔŋ ghɔŋbə ntɛ ndə Tiekətʉ kə fyúhə ɔŋ hə mu njaa-chaŋ. Ghɔ̀ŋ tʉ bɔŋ mbɔ, “B̈ii gɛ̀ fʉ̀ʼtə nubə-ɔ̄ŋ tʉ Jɛŋ ghɔŋbə bəbɛʼbʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii.” Ndʉʉmɛ, ɔ lɔ̀ gɛ̀ ndə ibɛʼ-yə yəŋkə.<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />Kʉ̂ʉ bɛ ndʉʉsɛŋkə njuɔnə-shʉ́əshʉ́ə-kə ŋɛ̀nə mu mbʉ bəsɔge te nukə ndə i nɔʼ fyú chíe Bita. <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />Fɔŋ Hɛlo Agliba kàhə mbɔ b̈ə la kɛŋ kʉ́ʉ ɔ jyujyu. Ndʉʉ ndə bə kʉ́ʉ ɔ kəŋkaa, ɔ tyúutə mbʉ bʉə ndə bɔ̂ŋ kə́ chyìi ɔ, chʉ̀ə fɛʼɛ-yʉə mbɔ b̈ə yí bɔŋ. Kəliʼ, mbʉ Hɛlo lɔ̀ hə Judia gɛ̀ chí Kasalia məniʼ.<verse eid="ACT 12:19" /></para>
  <para style="s">Fɔŋ Hɛlo Agliba byúu</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />Tʉʉ Hɛlo byʉ́ʼ yɔ́ŋyɔ́ŋ te bʉə-Taa ghɔŋ Sidɔŋ. Bɔŋ ndʉʉmɛ, bɔ̂ŋ tə́ŋ bʉə mbɔ b̈ɔ̂ŋ gɛ̀ fʉ̀ʉtə Hɛlo bʉʼka mbɔ yəŋkwɛʼtəŋbə-ʉə nɔ nə kə́ yʉ́əʼnə ndəŋ lɔʼɔ Hɛlo ndə nu-bəfɔ-yú-kə. Bɔ̂ŋ lóʼtə Balastu ndə ɔ kə bɛ lefɔŋ-ɛŋ, mbɔ bəkɔ bɔ̂ŋ tíŋ hə bɔ̌ŋ ɔŋ lìʼ ntuu-yʉə. <verse eid="ACT 12:20" /><verse number="21" style="v" sid="ACT 12:21" />Tíŋ hə bɔ̌ŋ ɔŋ, mbʉ Fɔŋ kɔ́ chîkə mbɔ ghɔŋ bɔŋ fə́nə. Yɔ̂ŋ-ghɔ̄ kʉ̂ʉ kʉ̀ʼnə, mbʉ Fɔŋ mɔ̀ʼ luɔtə-i mbʉə-ɔ, yétə ndəŋ yetəkə-i. Ɔ kʉ̂ʉ bʉ́ nukə tʉ bɔŋ, <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />mbʉ bʉə yʉ̀əʼ dyʉʼbə, ghɔ̀ŋ mbɔ, “Nɔ gyʉʉ-bənyii nɔ, kaa gyʉʉ-woməsʉʉ fɛ.”<verse eid="ACT 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 12:23" />Haʼ ndʉʉghɔfii, wontəŋTiekətʉ tuŋ ɔŋ nə yɔʼkə, bʉʼka mbɔ ɔ kə́ fí məgʉ́ə ndə i kie ndə məgɛ̀ tʉ Nyii. Ntyʉəbə chə́ŋ mbʉə-ɔ, kwó ɔ, ɔ kwú.<verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />ŊgieNyiikə bìʼ wɔ̀ʼnə nəndʉʉnəndʉʉ gɛ̀ nə shʉbə, bʉə buŋmbi kə́ bɛ́ŋ Nyii.<verse eid="ACT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25" />Ndʉʉ ndə Banaba ghɔŋ Sɔɔ kəliʼ fɔʼɔ-yʉə mu Jɛlosalɛŋ, bɔ̂ŋ lʉ̀ Jɔŋ Mak ghɔŋ bɔŋ bʉ̀nə gɛ̀ Antiɔk.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">Bə tə́ŋ Banaba ghɔŋ Sɔɔ kɔ́ mbi ndə fɔʼɔ-Nyii</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />Ndə nuɔ bʉəyʉkəŋgieNyii ghɔŋbə bʉə dàhə kəŋgieNyii mu chɔshi-Antiɔk ndə i bɛ mu Silia nɔ nə bɛ Banaba, Simiɔŋ (ndə bə kə́ tíi ɔ nə wokəfʉəŋ), Lusio (ndə ɔ lɔ̀ hə Silɛŋ), Mane (ndə ɔ nə bɛ tiekənu-Gɔməna Hɛlo Antiba vɛʼ ndə bɔ̂ŋ kə bíe vâambuɔ), leʼnə Sɔɔ. <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />Kʉ̂ʉ bɛ yɔŋbɛʼ ndə bʉə-bɔ̄ŋ kə́ lə̀ʼtə Tiekətʉ bɔŋleʼ kə́ jì muu, LyʉʉhəNyiikə ghɔ̀ŋ mbɔ, “B̈ii chóʼ Banaba kɔ́ tʉ mɔ ghɔŋ Sɔɔ ndə fɔʼɔ ndə mɔ kie tʉ bɔŋ.” <verse eid="ACT 13:2" /><verse number="3" style="v" sid="ACT 13:3" />Bɔ̂ŋ kʉ̂ʉ bìʼ jì muu gháaNyii yɔ́ŋyɔ́ŋ, mbʉ bʉə mɔ̀ʼ ghɔbə-ʉə ndəŋ bɔŋ, tə́ŋ bɔŋ kɔ́ mbi ndə fɔʼɔ-Nyii.<verse eid="ACT 13:3" /></para>
  <para style="s">Fəŋ ndə Sɔɔ fyú mbi ndə fɔʼɔ-Nyii</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />Ndʉʉmɛ, LyʉʉhəNyiikə tə́ŋ Sɔɔ ghɔŋ Banaba kɔ́ mbi, bɔ̂ŋ shíʼ gɛ̀ chʉʉ kəbuukwɛʼtəŋ Sɛlusia, lʉ̀ buukwɛʼtəŋkə<note caller="+" style="f"><char style="fr" closed="false">13:4 </char><char style="ft" closed="false">Ntɛ kəbuukwɛʼtəŋ ndə bɔ̂ŋ kə lʉ̀ nɔ bɛ yi-yə ndə i bɛ̀ʼ bʉə buŋmbi bɔŋleʼ kə́ bɛ buu-viʼi-kə.</char></note> chɔ gɛ̀ kwɔŋ ntəŋntəŋ muukwɛʼtəŋmə lɔʼɔbɛʼ bə kə́ tíi nə Siblɔ. <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />Ndʉʉ ndə bɔ̂ŋ dàa mu kəyəŋkwɛʼtəŋ Salami, bɔ̂ŋ gɛ̀ mu-njaagháaNyii-bʉə-Juu-hə, gɛ̀ lɔ̀ʼ ŋgieNyiikə chɔ. Jɔŋ Mak gɛ̀ ghɔŋ bɔŋ ndə mə-kə́-tɔ́ŋ bɔŋ.<verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />Kəliʼ, bɔ̂ŋ tòʼ lɔ̀ʼ ŋgieNyiikə yə̀ŋ mbʉ kəyəŋ-ghɔ̄ inchəŋ tə gɛ̀ dàa Bafɔ. Bɔ̂ŋ gɛ̀ bìatə wo-Juubɛʼ ndə ɔ̃ fʉ́ʉ fê, kə́ ghɔ̀ŋ mbɔ ɔ la yʉkəŋgieNyii, yie-e kə́ bɛ Baa-Jiso. <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />Ɔ yʉ́əʼnə ŋwɔŋ-ɛŋ ndəŋ gɔməna, Sɛgu Bolos, kə́ bɛ wo ndə mu kətʉ-e kə súunə daa. Mbʉ gɔməna kɔ̀ʼnə Banaba ghɔŋ Sɔɔ mbɔ b̈ɔ̂ŋ gwè mətòʼ tʉ ɔŋ, ɔ chʉʼ yʉ́ ŋgieNyiikə kəghɔ-bɔŋ. <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />Bɔŋ Ɛlɛma haʼ ndə mbʉ yie bɛ kəŋgie Gili mbɔ wo fʉ́ʉ fê, gwè dʉ̀ʉhə Banaba ghɔŋ Sɔɔ. Ɔ kə́ chìi nɔ ndə məbyùutə mbʉ gɔməna bʉʼka ɔ mə bɛ́ŋ ntəŋjyujyu.<verse eid="ACT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 13:9" />Ndʉʉmɛ, Sɔɔ ndə bə kə́ tíi ɔ ghɔ nə Bɔɔ, ndə ɔ nɔʼ jyʉ́ʉ hə kəghɔ-LyʉʉhəNyiikə, lɛ́nə mbʉ wo fʉ́ʉ fê ndəŋ mu shʉhə-i, ghɔ̀ŋ mbɔ, <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />“Mbəŋ-aŋ vaa-Debulu, ndə a bàa fɔbə ndə i bɛ ndyʉndyʉ inchəŋ, ntɛ-mənaa-hə kə́ bɛ bətɔ-a ilə́ŋnə leʼnə buuŋbʉə, a kʉ̂ʉ nə káa ndə məbyùutə fia-Tiekətʉ-tə, ndə bɛ fia shʉəŋ fe? <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />Nduɔ, Tiekətʉ nɔʼ mɔ̀ʼ ghɔkə-i ndəŋ aŋ. Shʉ-a bu fʉ̀əŋtə tə kɔ́ kʉʉkə təmə bəkɔ a buŋ leʼ nyíɛ chichi fɛ.” Haʼ ndʉʉmɛ, vaakəmbɔʼ ghɔŋ njəŋkə gwù shʉ-ɔ. Ɔ chʉ́ʉhə kə́ tòʼ ghʉ́ʉ kʉ́ʉ wo, ɔ̈ yá kwii-i gɛ̀ nə nɔŋ chunjaa. <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />Ndʉʉ ndə mbʉ gɔməna nyíɛ nukə ndə i fyú, ɔ bɛ́ŋ Nyii, bʉʼka mbɔ nubə ndə ɔ nɔʼ yʉ́ te Tiekətʉ kə́ chàa ɔ.<verse eid="ACT 13:12" /></para>
  <para style="s">Bɔɔ lɔ̀ʼ ŋgieNyiikə mu Antiɔk ndə i bɛ Bisidia</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />Ndʉʉmɛ, Bɔɔ ghɔŋbə bʉə ndə ghɔŋ bɔ̂ŋ kə bɛ mɔʼɔ, lɔ̀ Bafɔ kóʼ mu kəbuukwɛʼtəŋ gɛ̀ shùɔ chʉʉ-kəbuukwɛʼtəŋ Bɛga ndə bɛ mu Baŋfilia. Bɔŋ Jɔŋ Mak mɛ̀ʼtə bɔŋ chɔ bʉ̀nə gɛ̀ Jɛlosalɛŋ. <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />Bɔŋ Banaba ghɔŋ Bɔɔ lɔ̀ hə Bɛga bìʼ sʉ́ʉ gɛ̀ nə shʉbə mu Antiɔk ndə i bɛ mu Bisidia.</para>
  <para style="p" vid="ACT 13:14">Kʉ̂ʉ bɛ ndəŋ Chîlɔʼkə, bɔ̂ŋ gɛ̀ mu njaagháaNyii ndə məgɛ̀ lə̀ʼtə Nyii. <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />Ndʉʉ ndə bə tíi mu ŋwɔʼnə-nuʼ-Mushi ghɔŋbə bʉəyʉkəŋgieNyii liʼ, bəntəŋbəshʉ mbʉ mu njaagháaNyii ghɔ̀ŋ tʉ bɔŋ mbɔ, “Bəliŋ-baʼa, kaʼ bii kie ŋgiebə ndə məkwèʼhə baʼa nə yɔŋ, b̈ii fyú gwè bəshʉ gìe tʉ baʼa.”<verse eid="ACT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16" />Ndʉʉmɛ, Bɔɔ fyú gwè tə́nə bəshʉ, chɔ̀ʼhə ghɔkə-i chyìi bɔŋ, chʉ́ʉhə məkwə́ʼ ghɔ̀ŋ mbɔ, “Bətie-bɔŋ, bʉə-Isilɛ, ghɔŋbə bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ, bɔŋ-nɔʼ-leʼ kɔ́ fyiihə-ʉə ndə məfàa Nyii-bʉə-Isilɛ, b̈ii yʉ́.<verse eid="ACT 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 13:17" />“Nyii-lɔʼɔ-bʉə-Isilɛ-bɔ̄ŋ, nɔ nə séʼ bətietie-bʉʼʉ, chìi mbɔ bɔ̂ŋ yɔ́ŋ bɔŋleʼ shʉ́ə mu Iji. Kəliʼ, ɔ fyúhə bɔŋ nə ghʉəʼkə-i hə ndəŋ fʉəhə ndə bɔ̂ŋ kə́ fɔ̀ʼ chɔ. <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />Mu ŋgʉʼhə wuŋ kwi, ɔ yá fyii-i, tòʼ ghɔŋ bɔŋ mu kwɔŋkəyəŋnə. <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />Ndʉʉ ndə ɔ kə fyʉ́ʼhə lɔʼ-bətə̂ŋ-tə təkwiitia mu Kana, ɔ gyʉ̀əhə sê-yʉə tʉ bɔŋ ndə məbɛ yʉə-yə. <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" />Nchəŋnchəŋ bənu-ɔ̄ŋ nɔ nə lʉ̀ ŋgʉʼhə təghyʉʉ kwi nə ŋgʉʼhə wuŋ taa. Nubə-ɔ̄ŋ kʉ̂ʉ tíŋ, kə́ sɔ́ʼ bəntəŋbəshʉ sɔ́ʼ bɔŋ tə gɛ̀ lìʼ ndəŋ Samuɛ yʉkəŋgieNyii. <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />Ndʉʉmɛ, mbʉ bʉə bíʼtə fɔŋ tʉ Nyii, ɔ kɔ́ Sɔɔ vaa-Kish tʉ bɔŋ, ndə ɔ lɔ̀ hə kəlɔŋ-Bɛŋnjamɛ, ɔ sɔ́ʼ bɔŋ ndə ŋgʉʼhə wuŋ kwi. <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />Bɔŋ Nyii bʉ̀nə sə̀ʼ ɔ kəkʉə, yá Dɛbi ndəŋ fɔŋ, kə́ bɛ wo ndə Nyii nə bʉ́ te ɔ mbɔ, ‘Dɛbi vaa-Jesi nɔ bɛ vaafyii-ɔ, bʉʼka ɔ bu fɔ̀ʼ nubə nchəŋnchəŋ ndə mɔ tʉʼ kʉ́ʉ mbɔ ɔ fɔ̀ʼ.’<verse eid="ACT 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 13:23" />“Nɔ bɛ kəlɔŋ-wo-ɔ̄, Fɔŋ-Dɛbi, ndə Nyii fyúhə Ŋkwaa-bʉə-Isilɛ chɔ, kə́ bɛ Jiso, haʼ ndə ɔ nɔʼ kə kɔ̀ʼnə. <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />Bɔŋ ɔ buŋ kə̂ gwè, tʉ Jɔŋ wo ndə ɔ̃ kɔ́ muu nɔʼ kə gwè kə́ lɔ̀ʼ mbɔ, wotəmiyɔŋ mu Isilɛ la kie ndə məshìe liɛŋ-ɛŋ hə ndəŋ bʉ̂ʼʉ-e, kíahə ŋwɔŋ-ɛŋ gwè tʉ Nyii, fí muu. <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />Ndʉʉ ndə Jɔŋ kə bɛ ndə məlìʼ fɔʼɔ-ɛ, ɔ bíʼtə mbɔ, ‘Bii tʉʼ kwɔ̀ʼtə mbɔ mɔ bɛ ndaa? Bii kwɔ̀ʼtə mbɔ mɔ bɛ mbʉ Wo ndə Nyii Kùŋ Tə́ŋ mɛ? Mbee! Bɔŋ kʉʉkə məniʼ nɔ ɔ gwè, mɔ buŋ kʉ̀ʼnə wo ndə mə shùɔ takwubə-i fɛ.’<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />“Bəliŋ-bɔŋ, mbəŋ-yii vâa-Ablahaŋ ghɔŋbə mbəŋ-yii bənchəŋ ndə bii gòʼ təmə bɛ bʉə-Isilɛ fɛ kə́ fàa Nyii-bʉə-Isilɛ, ŋkwaa-ɔ̄ nɔ bɛ tʉ bʉʼʉ. <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />Təmə bʉə-Jɛlosalɛŋ ghɔŋbə bəntəŋbəshʉ-bʉə kínə wo ndə Jiso kə bɛ yɔŋ fɛ. Bɔ̂ŋ kə́ tíi ŋgieNyiikə ndə bʉəyʉkəŋgieNyii kə nyɔ̀ʼ ndəŋ Chîlɔʼbə inchəŋ, təmə bɔ̂ŋ kə́ kínə fɛ. Ndʉʉ ndə bɔ̂ŋ kə chʉ̀ə ŋkwɛ-ɛ ndə məyí ɔ, nukə ndə bʉəyʉkəŋgieNyii nɔʼ kə nyɔ̀ʼ i fyú shʉəŋ. <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />Bɔ̂ŋ nyíɛ ghɔkə-i ighʉ́ʉnə, bɔŋ lyʉ̀ʉ haʼ mbɔ B̈ale la yí ɔ.<verse eid="ACT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 13:29" />“Bɔŋ ndʉʉ ndə bɔ̂ŋ kə chìi nubə nchəŋnchəŋ ndə ŋwɔʼnə-Nyii kə ghɔ̀ŋ i fyú shʉəŋ te kwu-Jiso, bɔ̂ŋ shúʼhə ɔŋ hə ndəŋ tyʉntɔɔnəkə, tyúu ɔ. <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />Bɔŋ Nyii bʉ̀nə kóʼhə ɔŋ hə ndəŋ kwu. <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />Ɔ kɛ̀ʼ ŋwɔŋ-ɛŋ ndə chîbə buŋmbi tʉ bʉə ndə ghɔŋ bɔŋ nə kə́ tòʼ mɔʼɔ lɔ̀ hə Galili gɛ̀ Jɛlosalɛŋ. Nɔ bɛ bɔŋ nduɔ ndə bɔ̂ŋ tʉʼ fʉ̀ʼtə nubə tʉ bʉə-Isilɛ te ɔ.<verse eid="ACT 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 13:32" />“Nduɔ, baʼa Banaba nɔ bɛ fɛ̄ŋ ndə məgwè nə ntəŋjyujyu-ɔ̄ tʉ bii. Nukə ndə Nyii nɔʼ kə kɔ̀ʼnə tʉ bətietie-bʉʼʉ nɔʼ fyú shʉəŋ ndəŋ mbi-yʉʼʉ laa, <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />mbɔ Nyii la nɔʼ bʉ̀nə kóʼhə Jiso. Nɔ nukə nɔ ndə Ŋwɔʼnə-təLyuu mu kuŋkə ibûu kə kwə́ʼ te Jiso mbɔ,</para>
  <para style="q1" vid="ACT 13:33">‘A nɔ bɛ Vaa-ɔŋ.</para>
  <para style="q2" vid="ACT 13:33">Laa mɔ nɔ kɛŋ bɛ Tie-a.’<note caller="+" style="f"><char style="fr" closed="false">13:33 </char><char style="ft" closed="false">Ŋwɔʼnə-təLyuu 2:7.</char></note><verse eid="ACT 13:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 13:34" />Bʉʼka Nyii nɔʼ nə kɔ̀ʼnə ndə məbʉ̀nə kóʼhə ɔŋ ndʉʉ ndə ɔ kwú təmə ɔ leʼnə bìʼ kwú fɛ. Yɔ̄ŋ-yə nɔ bɛ mu ŋwɔʼnə-Nyii ndə i ghɔ̀ŋ mbɔ, ‘B̈ii kínə mbɔ biʼbə ndə mɔ nə kɔ̀ʼnə tʉ Dɛbi ndə i bɛ ŋkʉʉ, mɔ bu kɔ́ tʉ bii.’ <verse eid="ACT 13:34" /><verse number="35" style="v" sid="ACT 13:35" />Nɔ, i nɔ bìʼ ghɔŋ mu ibɛʼ-yə kuŋ-Ŋwɔʼnə-təLyuu-kə mbɔ, ‘Nyii, a kʉʉnə mɛ̀ʼtə Wo ndə ɔ nɔʼ kɔ́ ŋwɔŋ-ɛŋ tʉ a, ɔ fɛ̀ mu sê fɛ.’ <verse eid="ACT 13:35" /><verse number="36" style="v" sid="ACT 13:36" />Nduɔ, yɔ̄ŋ-yə kə́ kwə́ʼ te Dɛbi fɛ, bʉʼka ndʉʉ ndə Dɛbi kə bɛ mbi, ɔ nɔ nə yʉ́ chu-Nyii, kʉ̂ʉ nə sɛŋ kwú, bə gɛ̀ tyúu ɔ mu sě ndə bə tyúu bətie-bi chɔ, mbʉə-e fɛ̀ mu sê. <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />Mbee! I nɔ kə́ kwə́ʼ te wokədɔŋ, wobɛʼ ndə ɔ kə kwú, Nyii bʉ̀nə kóʼhə ɔŋ təmə mbɔʼ-mbʉə-e fɛ̀ mu sê fɛ.<verse eid="ACT 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 13:38" />“Bəliŋ-bɔŋ, b̈ii yʉ́! Baʼa nɔ tʉʼ lɔ̀ʼ tʉ bii mbɔ Jiso-ɔ̄ nɔ kie ghʉəʼkə ndə məsʉ̀fyii hə ndəŋ bʉ̂ʼtə-ii. <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />Wotəmiyɔŋ ndə ɔ bɛ́ŋ ɔŋ, nɔʼ yú fɛʼɛ-ɛ, bɛ ndyʉndyʉ bəshʉ-Nyii, nɔ kə bɛ nukə ndə nuʼ-Mushi kə mə fɔ̀ʼ fɛ. <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />B̈ii láa le mbɔ, nukə ndə bʉəyʉkəŋgieNyii nə ghɔŋ, mə yi fyú tʉ bii fɛ. Bɔ̂ŋ nɔ kə ghɔ̀ŋ mbɔ,<verse eid="ACT 13:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41" />‘B̈ii nyíɛ, bii ndə bii tʉʼ bɛ́ʼnə Nyii,</para>
  <para style="q2" vid="ACT 13:41">ï chíe chu-yii, bii gwùtə sê kwútə!</para>
  <para style="q1" vid="ACT 13:41">Bʉʼka mɔ bu chìi nukə tʉ b̈ii láa,</para>
  <para style="q2" vid="ACT 13:41">nukə ndə kaʼ wo kə gìe tʉ bii, bii bɛ́ŋ fɛ.’ ”<note caller="+" style="f"><char style="fr" closed="false">13:41 </char><char style="ft" closed="false">Habakɔ 1:5.</char></note><verse eid="ACT 13:41" /></para>
  <para style="m">
    <verse number="42" style="v" sid="ACT 13:42" />Ndʉʉ ndə Bɔɔ ghɔŋ Banaba kə fyú hə mu njaagháaNyii, mbʉ bʉə kɛŋ fʉ̀ʉtə bɔŋ mbɔ b̈ɔ̂ŋ bìʼ bʉ̀nə gwè ndəŋ Chîlɔʼkə, gwè kwə́ʼ tʉ bɔŋ te nubə-ɔ̄ŋ. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />Bʉə-Juu buŋmbi ghɔŋbə bəbɛʼbʉə ndə bɔ̂ŋ nɔʼ kə kɔ́ fyiihə-ʉə ndə nuʼ-bʉə-Juu, kə́ gɛ̀ hə bɔ̌ŋ Bɔɔ ghɔŋ Banaba, kə́ lə̀ʼtə Nyii mu njaagháaNyii. Mbʉ bʉə-bɔ̄ŋ bəbûu fʉ̀ʉtə bɔŋ ghɔ̀ŋ mbɔ, “B̈ii kɛŋ kə́ yʉ́əʼnə haʼ ndəŋ buuŋjyu-Nyii.”<verse eid="ACT 13:43" /></para>
  <para style="s">Bɔɔ kíahə ŋwɔŋ-ɛŋ gɛ̀ kə́ fɔ̀ʼ tʉ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />Kʉ̂ʉ bɛ biitə-kəChîlɔʼ-kə, mbʉ bʉə ndə bɔ̂ŋ bɛ mu mbʉ kəyəŋkwɛʼtəŋ, kóʼ tə bìa mì ndə məyʉ́ ndə bɔ̂ŋ tʉʼ lɔ̀ʼ ŋgie-Tiekətʉ-kə. <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />Bɔŋ ndʉʉ ndə bəntəŋbəshʉ-bʉə-Juu nyíɛ ntyʉʉ nuɔ-bʉə ndə bɔ̂ŋ kóʼ, bəfyuʼ ŋɛ̀nə fyii-bɔŋ. Ndʉʉmɛ, bɔ̂ŋ chʉ́ʉhə mədʉ̀ʉhə Bɔɔ, kə́ byùutə ŋgiekə təmiyɔŋ ndə i fyú hə chu-ɔ.<verse eid="ACT 13:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="ACT 13:46" />Ndʉʉmɛ, Bɔɔ ghɔŋ Banaba bə̀ŋhə tʉ bɔŋ nə fyii tə̀ŋnə mbɔ, “Baʼa nɔ kə kie ndə mə-fəŋ-gìe ŋgieNyiikə-ɔ̄ŋ ŋkəŋ tʉ bii bʉə-Juu. Bɔŋ nduɔ ndə bii tɛ́ŋ, kə́ kwɔ̀ʼtə mbɔ bii kʉ̀ʼnə ndə məkie məchímbi təmə liʼ-i ghɔ fɛ nɔ, baʼa bu lʉ̀ gɛ̀ nə yɔŋ tʉ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ. <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />Bʉʼka Tiekətʉ nɔʼ kàhə baʼa mbɔ,</para>
  <para style="q1" vid="ACT 13:47">‘Mɔ nɔ tʉ́ʼ bii ndə məbɛ kɛʼɛ tʉ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ.</para>
  <para style="q2" vid="ACT 13:47">Bii nɔ kie ndə məchìi ghʉəʼ-Nyii-kə ndə i kwáa bʉə, b̈ə kínə gɛ̀ dàa liʼ mbi.’ ”<note caller="+" style="f"><char style="fr" closed="false">13:47 </char><char style="ft" closed="false">Adaya 49:6.</char></note><verse eid="ACT 13:47" /></para>
  <para style="m">
    <verse number="48" style="v" sid="ACT 13:48" />Ndʉʉ ndə bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ yʉ́ yɔ̄ŋ-yə, tʉʉ-yʉə bʉ̀ʉ, bɔ̂ŋ kɔ́ ndɔ bɔŋleʼ kə́ kɔ́ kuŋhə tʉ Tiekətʉ ndə ŋgiekə-i ndə i gwè tʉ bɔŋ. Ndʉʉmɛ, bʉə bənchəŋ ndə Nyii nɔʼ kə séʼ bɔŋ ndə məkie məchímbi təmə liʼ-i ghɔ fɛ, bɛ́ŋ Nyii. <verse eid="ACT 13:48" /><verse number="49" style="v" sid="ACT 13:49" />Ndʉʉmɛ, ntəŋ Tiekətʉ wɔ̀ʼnə mu kəyəŋ-ghɔ̄ inchəŋ.<verse eid="ACT 13:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="ACT 13:50" />Ndʉʉmɛ, bəntəŋbəshʉ-bʉə-Juu kɔ́ buuŋ bənji-bəke ndə bɔ̂ŋ tʉʼ lə̀ʼtə Nyii bʉə-Juu ghɔŋbə bəntəŋbəshʉ mbʉ mu kəyəŋkwɛʼtəŋ, bɔ̂ŋ ŋɛ̀nə ntɔŋntɔŋ tʉ Bɔɔ ghɔŋ Banaba jə̀ŋ bɔŋ fyúhə mu mbʉ kəyəŋkwɛʼtəŋ. <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />Bɔŋ mbʉ bəlɔntəŋ kwètə bʉəkə kəwu-bɔŋ<note caller="+" style="f"><char style="fr" closed="false">13:51 </char><char style="ft" closed="false">Kaʼ bə kwètə bʉəkə kəwu te a, i bɛ cheʼkə ndə mədʉ̀ʼ mbɔ wo nɔʼ tɛ́ŋ ŋgie-Nyii-kə, bʉ̂ʼʉ-e kə́ bɛ kətʉ-ɔ.</char></note> ndə cheʼkə mbɔ bɔ̂ŋ nɔʼ nyʉ́ʉ bɔ̌ŋ-yʉə, gɛ̀ mu Ikonioŋ. <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />Bɔŋ vâafɔʼɔ-Jiso mu Antiɔk, kie tʉʉjyu bɔŋleʼ jyʉ́ʉ kəghɔ-LyʉʉhəNyiikə.<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s">Bɔɔ ghɔŋ Banaba mu Ikoniɔŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />Bɔɔ ghɔŋ Banaba gɛ̀ Ikoniɔŋ gɛ̀ kwə́ʼ ŋgieNyiikə mu njaagháaNyii haʼ nə ntɛ kəghʉəʼ ndə bɔ̂ŋ kə́ kwə́ʼ nə yɔŋ Antiɔk, bʉə-Juu ghɔŋbə bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ bɛ́ŋ Nyii buŋmbi. <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />Bɔŋ bʉə-Juu ndə bɔ̂ŋ gòʼ təmə bɛ́ŋ ŋgieNyiikə fɛ, kɔ́ buŋ bəbɛʼbʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ, bɔ̂ŋ ŋɛ̀nə ntɔŋntɔŋ tʉ bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii, kə́ gìe ntɛ-bənu-bʉəbʉə-hə kətʉ-bɔŋ inchəŋ.<verse eid="ACT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 14:3" />Mbʉ bəlɔntəŋNyii chí chɔ dɔ̀ŋnə, kə́ lɔ̀ʼ ŋgieNyiikə nə fyii shʉ́əshʉ́ə te buuŋjyu Tiekətʉ. Nyii chìi mbɔ b̈ə kínə mbɔ ntəŋ ndə bɔ̂ŋ tʉʼ téʼ bɛ shʉəŋ, ɔ kɔ́ ghʉəʼkə tʉ bɔŋ ndə məchìi nubəcheʼbə ghɔŋbə nuchíechubə. <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />Bɔŋ təmə mbʉ bʉə mu kəyəŋkwɛʼtəŋ kie ŋgiekə imɔʼ fɛ. Bəbɛʼbʉə tə́nə kəvia-bʉə-Juu, bəbɛʼbʉə tə́nə ghɔŋbə bəlɔntəŋNyii.<verse eid="ACT 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5" />Bʉəbɛʼbə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ leʼnə bʉə-Juu ghɔŋbə bəntəŋbəshʉ-bʉə shyʉ̀ʉ gyʉʉ ndə məlɔ̀ hə sê bɔ̌ŋ bɔŋ nə ntɔŋntɔŋ, túŋtə bɔŋ. <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />Mbʉ bəlɔntəŋNyii kʉ̂ʉ yʉ́, nyʉ́ʉ nə tʉkə-ʉə. Bɔ̂ŋ nyʉ́ʉ gɛ̀ kwii Likonia, mu kəyəŋkwɛʼtəŋ Lista ghɔŋ Debi leʼnə yəŋbɛʼbə mbʉə ghɔ. <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />Bɔ̂ŋ gɛ̀ lɔ̀ʼ ntəŋjyujyu chɔ.<verse eid="ACT 14:7" /></para>
  <para style="s">Bɔɔ ghɔŋ Banaba mu Lista leʼnə Debi</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />Ndʉʉ ndə Bɔɔ ghɔŋ Banaba kə bɛ mu Lista leʼnə Debi, bɔ̂ŋ gɛ̀ fyú ndəŋ wobɛʼ ndə ɔ nɔʼ lɛ́ŋ hə ndəŋ fʉəŋtə-i. Bə nɔ kə bí ɔ haʼ nɔ təmə ɔ nɔʼ nə tòʼ fɛ. <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />Mbʉ wo-ghɔ̄ dùʼ sê kə́ yʉ́ ndə Bɔɔ tʉʼ kwə́ʼ ŋgieNyiikə. Bɔɔ lɛ́nə ɔŋ ndə mu shʉhə-i, chèʼnə mbɔ ɔ nɔʼ mɔ̀ʼfyii ndəŋ Jiso ndə bəkɔ ɔ kie nchʉʼ, <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />gìe tʉ ɔŋ nə ghʉəʼkə mbɔ, “Lɔ̀ hə sê tə́nə!” Haʼ ndʉʉghɔfii, ɔ sɛ́ʼ tə́nə ndəŋ fʉəŋtə-i, chʉ́ʉhə kə́ tòʼ.<verse eid="ACT 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 14:11" />Ndʉʉ ndə bʉə ndə bɔ̂ŋ kə́ yʉ́ kwə́ʼ Bɔɔ, kə nyíɛ nukə ndə ɔ kə chìi, bɔ̂ŋ tíitə kəŋgie Likonia mbɔ, “Nɔ bənyii nɔ ndə bɔ̂ŋ nɔʼ shíʼ gwè tʉ bʉʼʉ nə bʉəməsʉʉ!” <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />Bɔ̂ŋ lìʼ ndʉʉghɔfii mbɔ, Banaba la bɛ Fɔŋ Sus, Bɔɔ ndə bɛ mbəŋ-ɛŋ bɛ wo ndə ɔ kə́ kwə́ʼ, la bɛ mbʉ Fɔŋ Hɛmɛ. <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />Njaafɛ̀ʼndɛŋ-Fɔŋ Sus nɔ nə bɛ haʼ chu-mbi mbʉ mu kəyəŋkwɛʼtəŋ. Wo ndə ɔ̃ fɛ̀ʼ Fɔŋ Sus ghɔŋbə mbʉ nuɔ-bʉə gwè nə bənaʼa-ləŋ ghɔŋbə kɔʼ-bəyii-ŋkɔ-bə, kə́ shʉ̀tə ndə məgɛ̀ fɛ̀ʼ mbʉ bəlɔntəŋNyii nə yɔŋ chulɔŋ ndə i ŋíi mu mbʉ kəyəŋkwɛʼtəŋ.<verse eid="ACT 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14" />Ndʉʉ ndə Banaba ghɔŋ Bɔɔ, ndə bɔ̂ŋ bɛ bəlɔntəŋNyii, kə yʉ́ nukə ndə i tʉʼ tíŋ, i chɔ́ŋhə bɔŋ, bɔ̂ŋ jɔ̀ʼtə ndyihə-ʉə,<note caller="+" style="f"><char style="fr" closed="false">14:14 </char><char style="ft" closed="false">Bɔ̂ŋ kə́ búubúu fɛ, nɔ nə bɛ nuʼ-yʉə mbɔ ñukə nɔ chɔ́ŋhə wo daa nɔ, ɔ jɔ̀ʼtə ndyihə-i.</char></note> nyʉ́ʉ fyú gɛ̀ mu bɔŋ, kə́ bíʼtə mbɔ, <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />“Bətieŋkɔŋ-baʼa, bii tʉʼ chìi yɔ̄ŋ-yə bʉʼka? Baʼa nɔ bɛ haʼ bʉəməsʉʉ ndə bii! Baʼa nɔ gwè bə nə ntəŋjyujyu tʉ bii, mbɔ bii shìe liɛŋtə-ii hə ndəŋ nu-bənɔ̌ʼɔ-bə-ɔ̄ŋ, gwè tʉ Nyii ndə ɔ bɛ ghɔ, ndə chìi ɔ chìi yuo ghɔŋbə chisêkə, chìi muu ghɔŋbə fɔbə ndə i bɛ chɔ inchəŋ. <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />Ndə vɛʼ bəshʉ, Nyii nɔ kə mɛ̀ʼtə lɔʼ-bətə̂ŋ-tə inchəŋ ndə məgɛ̀ hə ndəŋ yʉə-yə fiatə, <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />bɔŋ təmə ɔ mɛ̀ʼtə ŋwɔŋ-ɛŋ ndə məkɔ́ fɔ-jyujyu-bə ndə i bu chìi, bə kə́ kwɛ́nə mbɔ ɔ bɛ Nyii fɛ. Ɔ kɔ́ wyuu, leʼnə ntɔŋmə ghɔŋbə fɔyubə ndə məchìi tʉʉ-yii bʉ̀ʉ.” <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />Buŋ nə ŋgiebə-ɔ̄ŋ, bɔ̂ŋ nɔ nə kɔ̀ɔtə tə kwú ndə məbyùutə bɔŋ mbɔ bɔ̂ŋ mə fɛ̀ʼ bɔŋ fɛ.<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />Bɔŋ bʉə-Juu-bɛʼbə lɔ̀ hə Antiɔk ghɔŋbə Ikoniɔŋ, gwè kɔ́ buuŋ mbʉ bʉə, bɔ̂ŋ túŋtə Bɔɔ tə kwɔ̀ʼtə mbɔ ɔ nɔʼ kwú, dùu ɔ, fyúhə ɔŋ hə mu mbʉ kəyəŋkwɛʼtəŋ. <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />Bɔŋ ndʉʉ ndə vâafɔʼɔ-Jiso kə tə́ŋtə yə̀ŋ ɔŋ fúu, ɔ lɔ̀ hə sê bʉ̀nə gɛ̀ mu kəyəŋkwɛʼtəŋ. Mbi kʉ̂ʉ sɛŋ fíi, ghɔŋ Banaba gɛ̀ Debi.<verse eid="ACT 14:20" /></para>
  <para style="s">Bɔɔ ghɔŋ Banaba bʉ̀nə gɛ̀ Antiɔk mu Silia</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />Ndʉʉ ndə bɔ̂ŋ nɔʼ kə lɔ̀ʼ ntəŋjyujyu mu kəyəŋkwɛʼtəŋ-ghɔ̄ bɔŋleʼ chìi bʉə buŋmbi ndə məbɛ vâafɔʼɔ-Jiso, Bɔɔ ghɔŋ Banaba bʉ̀nə gɛ̀ Lista, Ikoniɔŋ, leʼnə Antiɔk mu Bisidia, <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />kə́ kɔ́ ghʉəʼkə tʉ vâafɔʼɔ-Jiso bɔŋleʼ kə́ kwèʼhə bɔ̂ŋ mbɔ b̈ɔ̂ŋ la lyʉ̀ʉtə́nə ndəŋ ntəŋjyujyu ndə bɔ̂ŋ nɔʼ bɛ́ŋ, kə́ kwɛ́nə tʉ bɔŋ mbɔ bɔ̂ŋ la kie ndə mənyíɛ ntɛ-ŋgʉəʼ-hə Nyii buŋ sɔ́ʼ bɔŋ. <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />Bɔɔ ghɔŋ Banaba séʼ bəntəŋbəshʉ mu-bəchɔshi-hə inchəŋ mu bəyəŋ-ghɔ̄-hə, bɔ̂ŋ jì muu kə́ gháaNyii, chɔ̀ʼhə bɔŋ kɔ́ kəghɔ-Tiekətʉ ndə bɔ̂ŋ nɔʼ kə mɔ̀ʼfyiihə-ʉə ndəŋ ɔŋ. <verse eid="ACT 14:23" /><verse number="24" style="v" sid="ACT 14:24" />Ndʉʉmɛ, bɔ̂ŋ tòʼ tíŋ hə Bisidia gɛ̀ Baŋfilia. <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />Ndʉʉ ndə bɔ̂ŋ kə lɔ̀ʼ ŋgieNyiikə mu Bɛga, bɔ̂ŋ shíʼ gɛ̀ Atalia, <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />lʉ̀ buukwɛʼtəŋkə hə chʉʉ kəbuukwɛʼtəŋ, gɛ̀ Antiɔk kə́ bɛ yəŋkə ndə bəntəŋbəshʉ kə mɔ̀ʼ ghɔbə-ʉə ndəŋ bɔŋ gháaNyii mbɔ ɔ̈ dʉ̀ʼ buuŋjyu-i tʉ bɔŋ, tə́ŋ bɔŋ kɔ́ mbi ndə fɔʼɔ ndə bɔ̂ŋ gòʼ təmə nɔʼ mìʼtə nduɔ fɛ. <verse eid="ACT 14:26" /><verse number="27" style="v" sid="ACT 14:27" />Ndə bɔ̂ŋ dàa Antiɔk le, bɔ̂ŋ chə̀ŋ bʉə-Nyii kəyəŋ kəmɔʼ, fʉ̀ʼtə tʉ bɔŋ nubə ndə Nyii nɔʼ fɔ̀ʼ tʉ bɔŋ bɔŋleʼ fʉ̀ʼtə ntɛ ndə Nyii nɔʼ chóʼ chulɔŋ-ntoʼ-e ghɔ tʉ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ mbɔ bɔ̂ŋ kɔ́ fyiihə-ʉə tʉ ɔŋ. <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />Bɔ̂ŋ chí chɔ ghɔŋbə vâafɔʼɔ-Jiso tə dɔ̀ŋnə.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s">Kaŋsotə mu Jɛlosalɛŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />Ndə Bɔɔ ghɔŋ Banaba kə bɛ mu Antiɔk le, bʉə-Juu-bɛʼbə gwè hə Judia chʉ́ʉhə ndə mədàhə bʉə ndə bɔ̂ŋ nɔʼ kə bɛ́ŋ Nyii mbɔ kaʼ bɔ̂ŋ gòʼ təmə tʉ́ʼ nuʼ-Mushi ndə məfɔ̀ʼ ŋwɔŋtə-ʉə fɛ, bɔ̂ŋ la kie ŋkwaaNyii fɛ. <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />Bɔɔ ghɔŋ Banaba túŋ bəŋʉʉ ghɔŋ bɔŋ tə i kɔ́ kʉʉkə. Kəliʼ, bə chóʼ Bɔɔ ghɔŋ Banaba leʼnə bəbɛʼbə bʉə ndə bɔ̂ŋ nɔʼ kə bɛ́ŋ Nyii, tə́ŋ bɔŋ mbɔ bɔ̂ŋ gɛ̀ fʉ̀ʼtə nukə-ɔ̄ŋ tʉ bəlɔntəŋNyii ghɔŋbə bəntəŋbəshʉ mu chɔshi-Jɛlosalɛŋ.<verse eid="ACT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3" />Ndə chɔshi kə tə́ŋ bɔŋ le, bɔ̂ŋ tíŋ hə Fɔnishia leʼnə Samalia, gɛ̀ mətòʼ tʉ bʉə ndə bɔ̂ŋ nɔʼ kə bɛ́ŋ Nyii, kə́ fʉ̀ʼtə tʉ bɔŋ ndə bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ tʉʼ bɛ́ŋ Nyii, i kɔ́ tʉʉjyu tʉ bɔŋ.<verse eid="ACT 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 15:4" />Ndʉʉ ndə Bɔɔ ghɔŋ Banaba kə dàa Jɛlosalɛŋ, mbʉ bʉə-chɔshi, bəlɔntəŋNyii leʼnə bəntəŋbəshʉ fí bɔŋ mu bɔŋ nə tʉʉjyu. Bɔ̂ŋ fʉ̀ʼtə nubə nchəŋnchəŋ-ɛŋ ndə Nyii fɔ̀ʼ tʉ bɔŋ. <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />Bɔŋ bəbɛʼbʉə ndə bɔ̂ŋ nɔʼ kə fəŋ bɛ bəFalasi bɔŋ-nɔʼ-leʼ bɛ́ŋ Nyii, lɔ̀ tə́nə ghɔ̀ŋ mbɔ bʉə bənchəŋ ndə bɔ̂ŋ bɛ́ŋ Nyii təmə bɛ bʉə-Juu fɛ, bə la kie ndə məfɔ̀ʼ bɔŋ bɔŋleʼ kàhə bɔŋ ndə mətʉ́ʼ nuʼ-Mushi.<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />Bʉʼka nukə-ɔ̄ŋ, i chìi mbʉ bəlɔntəŋNyii ghɔŋbə bəntəŋbəshʉ, bɔ̂ŋ chə̀ŋtə kəyəŋ kəmɔʼ ndə məjìʼtə mu i. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />Mu mbʉ nchəŋtə le, bɔ̂ŋ túŋ bəŋʉʉ yɔ́ŋyɔ́ŋ te nukə-ɔ̄ŋ. Bita lɔ̀ tə́nə ghɔ̀ŋ mbɔ, “Bəliŋ-bɔŋ, bii nɔ kínə mbɔ Nyii nɔʼ kə séʼ mɔ hə mu bii vɛʼbɛʼ ndə məgìe ŋgieNyiikə tʉ bʉə təmə bɔ̂ŋ bɛ bʉə-Juu fɛ, mbɔ b̈ɔ̂ŋ yʉ́ mbʉ ntəŋjyujyu, bɛ́ŋ Nyii. <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />Nyii ndə ɔ kínə fyiihə inchəŋ dʉ̀ʼ mbɔ ɔ nɔʼ bɛ́ŋ bɔŋ ndə məkɔ́ Lyʉʉhəkə-i tʉ bɔŋ haʼ ndə ɔ kə kɔ́ tʉ bʉʼʉ. <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />Təmə ɔ buŋ túhə shʉ tʉ bʉʼʉ bɔŋ fɛ bʉʼka mbɔ ɔ nɔ kə sʉ̀fyiihə-ʉə ghɔ tíŋ hə bɔ̌ŋ məmɔʼfyiihə-ʉə ndəŋ Nyii.<verse eid="ACT 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 15:10" />“Bɔŋ chìi ka nduɔ bii kə́ mùutə Nyii ndə məkóʼhə bɛʼkə ndəŋ vâafɔʼɔ-Jiso-bɔ̄ŋ, kə́ bɛ bɛʼkə ndə i chàa bʉʼʉ ghɔŋbə bətietie-bʉʼʉ ndə məbɛ̀ʼ? <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />Bɔŋ bʉʼʉ nɔ kínə mbɔ bʉʼʉ nɔ kie ŋkwaaNyii tíŋ hə bɔ̌ŋ buuŋjyu Jiso Tiekətʉ haʼ nə bɔŋ.”<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />Bɔ̂ŋ bənchəŋ líitə mbɔ loʼo, bɔŋleʼ kɔ́ tyunəbə-ʉə ndə məyʉ́ Bɔɔ ghɔŋ Banaba ndə bɔ̂ŋ tʉʼ fʉ̀ʼtə nubəcheʼbə ghɔŋbə nuchíechubə ndə Nyii kə́ fɔ̀ʼ mu bʉə təmə bɔ̂ŋ bɛ bʉə-Juu fɛ, tíŋ hə bɔ̌ŋ bɔŋ.<verse eid="ACT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 15:13" />Ndʉʉ ndə bɔ̂ŋ kə kwə́ʼ lí, Jɛŋ lɔ̀ hə sê ghɔ̀ŋ mbɔ, “Bəliŋ-bɔŋ, b̈ii yʉ́! <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />Simiɔŋ nɔʼ fʉ̀ʼtə tʉ bii ntɛ ndə Nyii kə fəŋ gɛ̀ mətòʼ tʉ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ, ndə məséʼ yi-yə hə mu bɔŋ. <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />Məséʼ-ɔ̄, nɔ gwù nchəŋhə te nukə ndə bʉəyʉkəŋgieNyii nɔʼ nə nyɔ̀ʼ mbɔ,<verse eid="ACT 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16" />‘Nubə-ɔ̄ŋ kʉ̂ʉ tíŋ nɔ, mbəŋ-ɔŋ, Tiekətʉ, buŋ yi bʉ̀nə gwè,</para>
  <para style="q2" vid="ACT 15:16">bɔŋ kʉ̂ʉ yi gwè nɔ, bɔ́ŋ ntoʼ-Dɛbi ndə i nɔʼ kə nʉ̀ʉ fuŋ</para>
  <para style="q1" vid="ACT 15:16">bʉ̀nə chɔ̀ʼhə mbʉ ntoʼ ndə i nɔʼ kə kùunə tʉ́ʼ,<verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17" />kə mbɔ bəʼ-bʉəməsʉʉ-kə bu bʉ̀nə gwè</para>
  <para style="q1" vid="ACT 15:17">tʉ Tiekətʉ ghɔŋbə bʉə təmə bɔ̂ŋ bɛ bʉə-Juu fɛ ghɔ,</para>
  <para style="q1" vid="ACT 15:17">bʉə bənchəŋ ndə mɔ tíi bɔŋ ndə məbɛ yɔŋ-yə.</para>
  <para style="q2" vid="ACT 15:17">Mbəŋ-ɔŋ, Tiekətʉ nɔʼ bʉ́ yɔ̄ŋ-yə.<verse eid="ACT 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 15:18" />Mɔ nɔʼ kə chìi, bə kínə yɔ̄ŋ-yə lʉ̀ hə ndəŋ ŋgwunə-mbi.’<note caller="+" style="f"><char style="fr" closed="false">15:18 </char><char style="ft" closed="false">Ɛmɔ 9:11-12.</char></note><verse eid="ACT 15:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="ACT 15:19" />Nɔ, yɔŋ-yə ŋkwɛ nduɔ nɔ bɛ mbɔ b̈ii káa məchɔ́ŋhə bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii təmə bɛ bʉə-Juu fɛ. <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />B̈ʉʼʉ bɔŋ nyɔ̀ʼ tʉ bɔŋ mbɔ bɔ̂ŋ mə kə́ yú fɔbə ndə bə nɔʼ fɛ̀ʼ bənyii nə yɔŋ-yə fɛ, təmə kə́ gháa bəsəŋ fɛ, təmə məkwó mbɔʼ nyaa ndə ɔ lʉ́ʉlʉ́ʉ fɛ, təmə kə́ nú fɔbʉəkə fɛ. <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />Bʉʼka mbɔ, bə nɔ nɔʼ kə lɔ̀ʼ nuʼ-Mushi mu yəŋkwɛʼtəŋbə təmiyɔŋ lʉ̀ hə bəshʉ bɔŋleʼ tíi mu njaaghaaNyii-bʉə-Juu-hə ndəŋ Chîlɔʼbə-ʉə təmiyɔŋ.”<verse eid="ACT 15:21" /></para>
  <para style="s">Ŋwɔʼnə tʉ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />Ndʉʉmɛ, mbʉ bəlɔntəŋNyii leʼnə bəntəŋbəshʉ ghɔŋbə bʉə bənchəŋ ndə bɔ̂ŋ kə bɛ mu chɔshi-Jɛlosalɛŋ nyíɛ i bʉ̀ʉ mbɔ bɔ̂ŋ chóʼ bʉə, tə́ŋ bɔŋ Antiɔk ndə i bɛ mu Silia ghɔŋbə Bɔɔ leʼnə Banaba, mbɔ bɔ̂ŋ gɛ̀ fʉ̀ʼtə nubə-ɔ̄ŋ. Bɔ̂ŋ tə́ŋ Juda ndə bə kə́ tíi ɔ nə Basaba ghɔŋbə Sila ndə bɔ̂ŋ kə bɛ bəntəŋbəshʉ mu bʉə ndə bɔ̂ŋ nɔʼ kə bɛ́ŋ Nyii. <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />Mbʉ ŋwɔʼnə ndə bɔ̂ŋ kə gɛ̀ nə yɔŋ nɔ kə́ ghɔ̀ŋ mbɔ,</para>
  <para style="b" vid="ACT 15:23" />
  <para style="mi" vid="ACT 15:23">“Ŋwɔʼnə-ɔ̄ŋ nɔ lɔ̀ hə kəghɔ-bəlɔntəŋNyii ghɔŋbə bəntəŋbəshʉ, bəliŋ-bii ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii, kə́ gìe tʉ bii bəliŋ-baʼa ndə bii gòʼ təmə bɛ bʉə-Juu fɛ, nɔʼ bɛ́ŋ Nyii mu Antiɔk, Silia leʼnə Silisia.<verse eid="ACT 15:23" /></para>
  <para style="pi">
    <verse number="24" style="v" sid="ACT 15:24" />“Bʉʼka baʼa nɔʼ yʉ́ mbɔ bʉəbɛʼbə la lɔ̀ hə mu baʼa gwè kə́ byùutə mu-kətʉ-hə-ii nə nubə ndə bɔ̂ŋ tʉʼ dàhə təmə tə́ŋ baʼa tə́ŋ bɔŋ fɛ. <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />Baʼa dùʼ sê jìʼtə nyíɛ i bʉ̀ʉ mbɔ baʼa chóʼ bʉə tə́ŋ tʉ bii ghɔŋbə bəmbʉətə bətieŋkɔŋ-bʉʼʉ-bɔ̄ŋ ndə bʉʼʉ kʉ̀ʉ, Banaba ghɔŋ Bɔɔ, <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />kə́ bɛ bʉə ndə bɔ̂ŋ nɔʼ kɔ́ tʉkə-ʉə tʉ kwu bʉʼka yie-Jiso Klai, Tiekətʉ-yʉʼʉ. <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />Ndʉʉghɔfii, baʼa nɔ tʉʼ tə́ŋ Juda ghɔŋ Sila mbɔ b̈ɔ̂ŋ gwè fʉ̀ʼtə mbʉ bənu-ghɔ̄ tʉ bii nə chu-yʉə.<verse eid="ACT 15:27" /></para>
  <para style="pi">
    <verse number="28" style="v" sid="ACT 15:28" />“Bʉʼka i nɔ bɛ nu-jyujyu-kə tʉ LyʉʉhəNyiikə ghɔŋbə mbəŋ-yaʼ mbɔ baʼa mə kóʼhə bɛʼkə liɛŋ-bii tə i tíŋ yɔ̄ŋ-yə fɛ: <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />mbɔ kə bii mə kə́ yú fɔkə ndə bə nɔʼ fɛ̀ʼ bənyii nə yɔ̄ŋ-yə fɛ, kə bii mə nú fɔbʉəkə fɛ, kə bii məkwó fɔ-lʉ́ʉ-kə fɛ, kə bii mə gháa bəsəŋ fɛ. Kaʼ bii fyúhə ŋwɔŋ-yii ndə nubə-ɔ̄ŋ, bii bɛ jyujyu. Bʉʼʉ bɛ́ŋ.”<verse eid="ACT 15:29" /></para>
  <para style="b" />
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />Ndʉʉ ndə bə tíŋhə bɔŋ, mbʉ bʉəntəŋNyii lɔ̀ gɛ̀ dàa Antiɔk, kʉ̂ʉ chə̀ŋtə mbʉ nuɔ-bʉə-buŋmbi kəyəŋ kəmɔʼ, téʼ mbʉ ntəŋ tʉ bɔŋ. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />Bɔ̂ŋ kʉ̂ʉ tíi liʼ, i kɔ́ tʉʉjyu tʉ bʉə-Nyii bənchəŋ, bʉʼka mbʉ ŋwɔʼnə nɔ nə kwèʼhə bɔŋ ndə fɔʼɔ-yʉə.<verse eid="ACT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 15:32" />Juda ghɔŋ Sila, bʉʼka bɔ̂ŋ kə bɛ bʉəyʉkəŋgieNyii hə mu bʉə ndə bɔ̂ŋ nɔʼ kə bɛ́ŋ Nyii, bìʼ kwèʼhə bɔŋ bɔŋleʼ kɔ́ ghʉəʼkə tʉ bɔŋ nə ŋgiebə buŋmbi ndə i fyú hə chu-bɔŋ. <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />Bɔ̂ŋ kʉ̂ʉ chí ghɔŋ bɔŋ ndə kʉʉkə məniʼ, tíŋhə bɔŋ nə fyiighʉ́ənə bʉ̀nə gɛ̀ nyíɛ mbʉ bəlɔntəŋNyii ndə bɔ̂ŋ kə tə́ŋ bɔŋ. <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />[Sila nyíɛ mbɔ ɔ bu chí chɔ ghɔŋ bɔŋ.] <verse eid="ACT 15:34" /><verse number="35" style="v" sid="ACT 15:35" />Bɔŋ Bɔɔ ghɔŋ Banaba gɛ̀ Antiɔk, kə́ dàhə bɔŋleʼ lɔ̀ʼ ŋgie-Tiekətʉ-kə ghɔŋbə bəbɛʼbʉə ghɔ.<verse eid="ACT 15:35" /></para>
  <para style="s">Bɔɔ ghɔŋ Banaba wɔ̀ʼtə</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />Mbyu-bəchî-hə kʉ̂ʉ tíŋ məniʼ, Bɔɔ ghɔ̀ŋ tʉ Banaba mbɔ, “B̈âʼa bʉ̀nə gɛ̀ mətòʼ tʉ bəliŋ-bâʼa ndə bɔ̂ŋ nɔʼ bɛ́ŋ Jiso, mu-bəyəŋkwɛʼtəŋ-hə inchəŋ ndə bâʼa nɔʼ kə lɔ̀ʼ ŋgie-Tiekətʉ-kə chɔ, chʉʼ nyíɛ ndə bɔ̂ŋ bɛ.” <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />Ndʉʉmɛ, Banaba lyʉ̀ʉ mbɔ ɔ la bu lʉ̀ Jɔŋ ndə yie lɔʼɔ-ɛ kə bɛ Mak. <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />Bɔŋ Bɔɔ kwɔ̀ʼtə mbɔ i bu bɛ yʉʼ-kənu ndə məlʉ̀ ɔ ghɔŋ bɔŋ gɛ̀ mɔʼɔ fɛ, bʉʼka mbɔ ɔ nɔ nə ké bɔŋ vɛʼ ndə bɔ̂ŋ kə bɛ Baŋfilia təmə gɛ̀ ghɔŋ bɔŋ ndə mbʉ fɔʼɔ fɛ. <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />Bɔ̂ŋ túŋ bəŋʉʉ i shʉ́ə daa tə bɔ̂ŋ wɔ̀ʼtə. Banaba lʉ̀ Mak, bɔ̂ŋ ŋíi mu kəbuukwɛʼtəŋ gɛ̀ Siblɔ. <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />Bɔɔ séʼ Sila ghɔŋ ɔŋ gɛ̀ nə wʉə ɔ, ndʉʉ ndə bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii nɔʼ kə chɔ̀ʼhə bɔŋ kɔ́ mu buuŋjyu Tiekətʉ. <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />Ndʉʉmɛ, bɔ̂ŋ tòʼ tíŋ hə Silia ghɔŋ Silisia kə́ kwèʼhə bəchɔshi ndə i bɛ chɔ.<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">Bɔɔ bìʼ gɛ̀ ndə məlɔ̀ʼ ŋgieNyiikə</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />Ndʉʉmɛ, Bɔɔ ghɔŋ Sila gɛ̀ Debi leʼnə Lista. Kə nyíɛ, mbyu wobɛʼ kə́ bɛ chɔ ndə ɔ kə bɛ vaafɔ̀ʼ-Jiso, yie-e kə́ bɛ Timɔti bɔŋleʼ kə́ bɛ vaa-wokebɛʼ ndə bɛ woke-Juu ndə ɔ nɔʼ bɛ́ŋ Nyii bɔŋ tie-e kə́ bɛ wo-Gili*. <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />Bʉə ndə bɔ̂ŋ nɔʼ kə bɛ́ŋ Nyii mu Lista ghɔŋ Ikoniɔŋ kə́ tíi yie Timɔti jyujyu. <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />Bɔɔ kʉ̀ʉ mbɔ ghɔŋ Timɔti gɛ̀ mɔʼɔ, ndʉʉghɔfii, Bɔɔ lʉ̀ ɔ, fɔ̀ʼ ɔ, bʉʼka bʉə-Juu ndə bɔ̂ŋ kə́ chí kəyəŋ-ghɔ̄, bʉə bənchəŋ nɔ kə kínə mbɔ tie-e nɔ bɛ wo Gili. <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />Ndə bɔ̂ŋ kə́ tòʼ hə mu yəŋkwɛʼtəŋbə, bɔ̂ŋ kə́ fʉ̀ʼtə nubə ndə bɔ̂ŋ kie ndə mətʉ́ʼ ndə i kə́ gwè hə kəghɔ mbʉ bəlɔntəŋNyii ghɔŋbə bəntəŋbəshʉ ndə bɔ̂ŋ bɛ Jɛlosalɛŋ. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />Nɔ bəchɔshi bìʼ shʉ́ə ndəŋ ntəŋjyujyu yɔ́ŋyɔ́ŋ, nuɔ-yʉə kə́ bìʼ bəchibəchi.<verse eid="ACT 16:5" /></para>
  <para style="s">Nyii tə́ŋ Bɔɔ Masɛdonia</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />Ndʉʉmɛ, bɔ̂ŋ tòʼ tíŋ hə Filigia ghɔŋ Galatia bʉʼka LyʉʉhəNyiikə nɔ nə chíe bɔŋ mbɔ bɔ̂ŋ mə lɔ̀ʼ ŋgieNyiikə mu Esia fɛ. <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />Ndʉʉ ndə bɔ̂ŋ kóʼ gwè dàa Maisia, bɔ̂ŋ kə́ kʉ́ʉ ndə məgɛ̀ Bitinia, bɔŋ Lyʉʉhə-Jiso-kə kyʉ̀hə bɔŋ mbɔ bɔ̂ŋ mə gɛ̀ chɔ fɛ. <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />Bɔ̂ŋ tíŋ hə mu Maisia, shíʼ gɛ̀ Tɔlɔs.<verse eid="ACT 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 16:9" />Njəŋ chí Bɔɔ ndʉʉbətyuʼ təmə ɔ kə́ bɛ́ŋbɛ́ŋ fɛ, wobɛʼ gwè tʉ ɔŋ lɔ̀ hə Masɛdonia, kə́ fʉ̀ʉtə ɔŋ ghɔ̀ŋ mbɔ, “Gwè njəŋ Masɛdonia, gwè kwáa baʼa.” <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />Ndʉʉ ndə ɔ nyíɛ nu-ghɔ̄-bə liʼ, haʼ ndʉʉmɛ baʼa bɛ ndə məgɛ̀ Masɛdonia, bʉʼka baʼa nɔ kə lìʼ haʼ mbɔ la kə́ tíi Nyii tíi baʼa ndə məgɛ̀ lɔ̀ʼ ntəŋjyujyu chɔ.<verse eid="ACT 16:10" /></para>
  <para style="s">Lidia ndə ɔ lɔ̀ hə Filibai bɛ́ŋ Jiso</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />Ndʉʉmɛ, baʼa lɔ̀ʼ buukwɛʼtəŋkə hə Tɔlɔs gɛ̀ ndyʉndyʉ tə gɛ̀ shùɔ Samɔtelesia, mbi kʉ̂ʉ sɛŋ fíi, baʼa té gɛ̀ dàa Nioboli. <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />Kʉ̂ʉ leʼ lɔ̀ hə chɔ, té gɛ̀ Filibai, kə́ bɛ fɔŋ-kəyəŋkwɛʼtəŋ mu Masɛdonia bɔŋ-kə́-leʼ bɛ yəŋkə ndə bʉə-Luŋ kə́ chí chɔ buŋmbi. Baʼa chí mu kəyəŋ-fɛ̄ŋ tə bɛ mbyu-bəchî-hə.<verse eid="ACT 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 16:13" />Kʉ̂ʉ bɛ ndəŋ Chîlɔʼkə, baʼa fyú hə chulɔŋ mbʉ lɔʼɔ, gɛ̀ ŋgwuu-muu, kəyəŋ ndə baʼa kə́ kwɔ̀ʼtə mbɔ baʼa bu nyíɛ yəŋ-gháaNyii-kə chɔ. Baʼa dùʼ sê kwə́ʼ ŋgieNyiikə tʉ bəke ndə bɔ̂ŋ chə̀ŋtə chɔ. <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />Wokebɛʼ mu bɔŋ ndə bə kə́ tíi ɔ nə Lidia, kə́ fɛ̀ŋ ndyi-kəmbuu-fʉ́əŋ-hə, ɔ lɔ̀ hə mu kəyəŋkwɛʼtəŋ bə kə́ tíi nə Tiatila bɔŋ-kə́-leʼ lə̀ʼtə Nyii. Ndə ɔ tʉʼ yíe nubə ndə Bɔɔ tʉʼ gìe, Tiekətʉ ŋɔ́ʼhə fyii-i, ɔ bɛ́ŋ nukə ndə Bɔɔ kə́ gìe. <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />Ndʉʉ ndə ɔ fí muu ghɔŋbə nchinjaa-ɛ, ɔ fʉ̀ʉtə baʼa ghɔ̀ŋ mbɔ, “Kaʼ bii nyíɛ mbɔ mɔ tʉʼ gìe shʉəŋ tʉ Tiekətʉ, b̈ii gwè chí mu njaa-mɔ.” Ɔ lóʼtə baʼa, baʼa gwù kəvia-ɔ.<verse eid="ACT 16:15" /></para>
  <para style="s">Bə fʉ̀əŋ Bɔɔ ghɔŋ Sila chaŋ</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />Chibɛʼkə, ndə baʼa kə́ gɛ̀ kəyəŋ gháaNyii, baʼa nyíɛ vaabəkebɛʼ ndə ɔ bɛ fʉə-wo tʉ ɔ nɔʼ jyʉ́ʉ mu lyʉʉhə-bəlʉʼʉ-nyii-kə, ɔ gwè tʉ baʼa. Ɔ kə́ fʉ́ʉ fê, kə́ kie kyʉə chɔ buŋmbi, kɔ́ tʉ bətiefɔʼɔ-bi. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />Mbʉ vaabəke kə́ gwè hə bɔ̌ŋ baʼabə Bɔɔ kə́ tòʼ tíi ghɔ̀ŋ mbɔ, “Bʉə-bɔ̄ŋ nɔ bɛ vâafɔʼɔ-Nyii, Fɔŋ-Wokwɛʼtəŋ ndə bɔ̂ŋ gwè ndə mədʉ̀ʼ fia tʉ bii ndə məkie ŋkwaa.”<verse eid="ACT 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 16:18" />Ɔ kə́ fɔ̀ʼ haʼ nɔ bəchibəchi, i chìi tʉʉ Bɔɔ byʉ́ʼ daa, ɔ kíahə sɔ́ʼ mbʉ kəlyʉʉhə-bəlʉʼʉ-nyii ghɔ̀ŋ mbɔ, “Mɔ nɔ kàhə a yie-Jiso Klai mbɔ ä fyú hə mbʉə-ɔ.” Ɔ fyú haʼ ndʉʉghɔfii.<verse eid="ACT 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19" />Ndʉʉ ndə bətiefɔʼɔ-bi nyíɛ mbɔ yəŋkə ndə bɔŋ kə́ yʉ́əʼnə chɔ ndə məkie sii nɔʼ mɔ̀ʼ bɔŋ sê, bɔ̂ŋ gwù ndəŋ Bɔɔ ghɔŋ Sila shyùu bɔŋ gɛ̀ nə bɔŋ vyii tʉ bʉəkwɛʼtəŋ. <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />Bɔ̂ŋ kʉ̂ʉ gɛ̀ nə bɔŋ tʉ bʉə chʉ̀ə fɛʼɛ ghɔ̀ŋ mbɔ, “Bʉə-Juu-bɔ̄ŋ nɔ tʉʼ byùutə mu kəyəŋkwɛʼtəŋ-yaʼ. <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />Bɔ̂ŋ nɔ tʉʼ dàhə nuʼ ndə i kʉ̀ʼnə tʉ baʼa bʉə-Luŋ ndə mətʉ́ʼ fɛ.”<verse eid="ACT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 16:22" />Mbʉ nuɔ-bʉə lɔ̀ hə sê bənchəŋ bɔ̌ŋ bɔŋ, mbʉ bʉə chʉ̀ə fɛʼɛ yá bɔŋ, jɔ̀ʼtə ndyihə-ʉə, téʼ mbɔ b̈ə la gwúu bɔŋ. <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />Ndʉʉ ndə bɔ̂ŋ gwúu bɔŋ nə ŋgwɔŋhə buŋmbi, bɔ̂ŋ tʉ́ʉhə bɔŋ kɔ́ mu njaa-chaŋ téʼ tʉ mbʉ wo ndə ɔ chyìi mbʉ njaa-chaŋ mbɔ ɔ̈ la kə́ chyìi bɔŋ jyujyu. <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />Ndʉʉ ndə ɔ̈ yʉ́ nubə-ɔ̄ŋ, ɔ lʉ̀ bɔŋ kɔ́ kɛŋ mu njəŋ-njaa-chaŋ-dɔdɔ, sʉ́ʉhə fʉəŋtə-ʉə mu koʼkə, fʉ̀əŋ.<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />I kʉ̂ʉ bɛ nə ndʉʉkwɔnəmbi, Bɔɔ ghɔŋ Sila kə́ gháaNyii bɔŋleʼ yùɔ lyuu lə̀ʼtə Nyii, bʉə mu njaa-chaŋ kə́ yʉ́ bɔŋ. <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />Kə kwɔnə nyíɛ, ŋkʉə-sê-kəyəŋ-ghɔ̄-kə ŋʉ̀ʼnə tə mbʉ njaa-chaŋ ŋʉ̀ʼnə hə ndə yiesê-e, haʼ ndʉʉmɛ, chusiitə yɔ̀ʼnə inchəŋ, bəchaŋ fyú hə təfʉəŋ-mbʉ-bʉə-njaa-chaŋ bənchəŋ gwùtə sê. <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />Mbʉ wo ndə ɔ̃ chyìi njaa-chaŋ kʉ̂ʉ gwùʼtə mbɛŋhə, nyíɛ chusiitə ighʉ́ʉnə, sʉ̀ʉ setəkə-i kə́ kʉ́ʉ shùɔ ŋwɔŋ-ɛŋ chɔ yí, kə́ kwɔ̀ʼtə mbɔ mbʉ bʉə-njaa-chaŋ la nɔʼ nyʉ́ʉtə nə wʉə. <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />Bɔŋ Bɔɔ tíi nə ghʉəʼkə ghɔ̀ŋ mbɔ, “Kə a mə lə́ŋhə ŋwɔŋ-aŋ fɛ, bʉʼka baʼa bənchəŋ nɔ bɛ fɛ̄ŋ.”<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />Mbʉ wo chyìi njaa-chaŋ tíi mbɔ b̈ə chúʼ kɛʼɛ, ɔ nyʉ́ʉ gɛ̀ muŋgɔ nəndʉʉnəndʉʉ, kə́ gwònə gwù bəshʉ Bɔɔ ghɔŋ Sila. <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />Ɔ kʉ̂ʉ fyúhə bɔŋ mbi bíʼtə mbɔ, “Bətie-bɔŋ, bəkɔ mɔ chìi təka ndə məkie ŋkwaa?”<verse eid="ACT 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31" />Bɔ̂ŋ ghɔ̀ŋ mbɔ, “Bɛ́ŋ Jiso Tiekətʉ, Nyii bu kwáa a, bii bənchinjaa-a.” <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />Ndʉʉmɛ, bɔ̂ŋ kwə́ʼ ŋgie-Tiekətʉ-kə tʉ ɔŋ leʼnə nchinjaa-ɛ bənchəŋ. <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />Ɔ lʉ̀ bɔŋ haʼ ndʉʉghɔfii, gɛ̀ sʉ̀ dyʉʼbə-ʉə, ɔ fí muu ghɔŋbə nchinjaa-ɛ bənchəŋ. <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />Ɔ kʉ̂ʉ lʉ̀ bɔŋ gɛ̀ nə bɔŋ mu njaa-ɔ, gɛ̀ kɔ́ fɔyubə tʉ bɔŋ, tʉʉ-i kə́ bʉ̀ʉ ndə ɔ nɔʼ bɛ́ŋ Nyii ghɔŋbə nchinjaa-ɛ inchəŋ.<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />Kʉ̂ʉ bɛ ndʉʉsɛŋkə, mbʉ bʉə chʉ̀ə fɛʼɛ tə́ŋ bʉə-shia-kəfʉəŋ nə ntəŋ mbɔ, “Mɛ̀ʼtə bʉə-bīŋ b̈ɔ̂ŋ gɛ̀.” <verse eid="ACT 16:35" /><verse number="36" style="v" sid="ACT 16:36" />Mbʉ wo chyìi njaa-chaŋ gìe tʉ Bɔɔ mbɔ, “Bʉə chʉ̀ə fɛʼɛ nɔʼ tə́ŋ wo mbɔ m̈ɔ mɛ̀ʼtə bii, b̈ii gɛ̀. Nduɔ, b̈ii fyú gɛ̀, tòʼ jyu.”<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />Bɔŋ Bɔɔ bə̀ŋhə mbɔ, “Bɔ̂ŋ nɔ kə gwúu baʼa ŋgwʉʉnə, gɛ̀ fʉ̀əŋ baʼa təmə nyíɛ mbɔ baʼa nɔʼ gwù fɛʼɛ fɛ. Baʼa kə́ bɛ bʉə-Luŋ, bɔ̂ŋ fʉ̀əŋ baʼa mu njaa-chaŋ. Nduɔ, bɔ̂ŋ kə́ kʉ́ʉ ndə məfyúhə baʼa bɔ̌ŋbɔ̌ŋ, baʼa mə bɛ́ŋ fɛ. B̈ɔ̂ŋ gwè nə mbəŋ-yʉə gwè fyúhə baʼa.”<verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />Ndʉʉ ndə mbʉ wo-shia-kəfʉəŋ gɛ̀ fʉ̀ʼtə yɔ̄ŋ-yə tʉ mbʉ bʉə chʉ̀ə fɛʼɛ, bɔ̂ŋ fàa ndʉʉ ndə bɔ̂ŋ yʉ́ mbɔ bɔ̂ŋ bɛ bʉə-Luŋ. <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />Bɔ̂ŋ gwè gwía fyùufyùu tʉ bɔŋ, fyúhə bɔŋ, gìe tʉ bɔŋ bìʼ gìe mbɔ bɔ̂ŋ fyú hə mbʉ mu kəyəŋkwɛʼtəŋ. <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />Bɔ̂ŋ fyú gɛ̀ mu njaa-Lidia, gɛ̀ bìatə bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii chɔ, kwèʼhə bɔŋ ndəŋ nu-Nyii-bə buŋ fyú nə wʉə hə mu mbʉ kəyəŋkwɛʼtəŋ.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s">Bɔɔ lɔ̀ʼ ŋgieNyiikə mu Tɛsalonika</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />Ndʉʉghɔfii, Bɔɔ ghɔŋ Sila tòʼ tíŋ hə mu Aŋfiboli leʼnə Abolonia gɛ̀ dàa Tɛsalonika, kəyəŋ ndə njaagháaNyii-bʉə-Juu bɛ chɔ. <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />Bɔɔ gɛ̀ mu mbʉ njaagháaNyii haʼ ndə ɔ̃ chìi, ɔ kə́ kɔ̀ɔtə ndə məŋɔ́ʼhə shʉ-yʉə ndə ŋgieNyiikə ndə Chîlɔʼbə itia. <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />Ɔ kə́ fʉ̀ʼtə bɔŋ-kə́-leʼ dʉ̀ʼ mbɔ Wo ndə Nyii Kùŋ Tə́ŋ la kie ndə mənyíɛ ŋgʉəʼ, bʉ̀nə kóʼ hə ndəŋ kwu, ghɔŋ ndʉʉghɔfii mbɔ, “Jiso-ɔ̄ ndə mɔ tʉʼ lɔ̀ʼ ntəŋ-ɔ̄ŋ tʉ bii te ɔ nɔ, nɔ bɛ mbʉ Wo ndə Nyii Kùŋ Tə́ŋ.” <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />Bə lóʼtə bəbɛʼbʉə, bɔ̂ŋ bɛ́ŋ Nyii bìa Bɔɔ ghɔŋ Sila, ghɔŋbə bəbɛʼbʉə-Gili buŋmbi ndə bɔ̂ŋ tʉʼ fàa Nyii ghɔŋbə ŋkɛŋ-bəke-hə buŋmbi ghɔ.<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />Bɔŋ bəntəŋbəshʉ-bʉə-Juu kie bəfyuʼ, kə́nə bʉə-mbunə ndə buuŋtə-ʉə byʉ́ʼ. Bɔ̂ŋ fúu nuɔ chʉ́ʉhə ntɔŋntɔŋ mu mbʉ kəyəŋkwɛʼtəŋ. Bɔ̂ŋ gɛ̀ ŋíi mu njaa-Jasɛŋ kə́ kʉ́ʉ ndə məyá bɔŋ fyú gwè nə bɔŋ tʉ mbʉ bʉə. <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />Ndʉʉ ndə bɔ̂ŋ kʉ̂ʉ bɔŋ kəŋkaa, bɔ̂ŋ dùu Jasɛŋ ghɔŋbə bəbɛʼbʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii, gɛ̀ nə bɔŋ tʉ mbʉ bʉə ndə bɔ̂ŋ kə́ sɔ́ʼ mbʉ mu kəyəŋkwɛʼtəŋ kə́ tíitə ghɔ̀ŋ mbɔ, “Bʉə-bɔ̄ŋ ndə bɔ̂ŋ nɔʼ bə̀ŋtə wʉʉnəmbikə, nɔʼ leʼ gwè ghɔ nduɔ fɛ̄ŋ. <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />Jasɛŋ nɔʼ lʉ̀ bɔŋ bənchəŋ kɔ́ njaa-ɔ. Bʉə-bɔ̄ŋ nɔʼ leʼ chɔ́ʼ chu Fɔŋ-Luŋ, kə́ ghɔ̀ŋ mbɔ Fɔŋbɛʼ la bɛ ghɔ, bə kə́ tíi ɔ nə Jiso.”<verse eid="ACT 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 17:8" />Ndʉʉ ndə bɔ̂ŋ yʉ́ nubə-ɔ̄ŋ, i chɔ́ŋhə mbʉ nuɔ-bʉə ghɔŋbə mbʉ bəntəŋbəshʉ mu mbʉ kəyəŋkwɛʼtəŋ. <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />Ndʉʉ ndə mbʉ bəntəŋbəshʉ fí chʉʼkətʉbə hə kəghɔ-bɔŋ, bɔ̂ŋ fyúhə Jasɛŋ leʼnə bəbɛʼbʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii, bɔ̂ŋ gɛ̀.<verse eid="ACT 17:9" /></para>
  <para style="s">Bɔɔ ghɔŋ Sila mu Bɛlia</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />Haʼ ndʉʉbətyuʼ-ghɔ̄, bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii dùhə Bɔɔ ghɔŋ Sila kɔ́ Bɛlia. Ndʉʉ ndə bɔ̂ŋ dàa chɔ, bɔ̂ŋ gɛ̀ mu njaagháaNyii-bʉə-Juu. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />Yɔ̄ŋ-yə bʉə-Juu nɔ kə kie kuŋhə mbʉə-bɔŋ chàa bìbə ndə bɔŋ bɛ Tɛsalonika, bʉʼka bɔ̂ŋ nɔ kə fí ŋgieNyiikə ndə Bɔɔ kə́ lɔ̀ʼ nə fyii jyujyu. Bɔ̂ŋ kə́ tíetə ŋgieNyiikə bəchibəchi ndə mənyíɛ mbɔ nukə ndə Bɔɔ ghɔŋ Sila tʉʼ dàhə bɛ shʉəŋ mɛɛ. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />Ndʉʉghɔfii, bʉə buŋmbi bɛ́ŋ Nyii, ŋkɛŋ-bəke-hə ndə bɔ̂ŋ lɔ̀ hə Gili leʼnə buŋmbi bələŋ.<verse eid="ACT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 17:13" />Bɔŋ ndʉʉ ndə bʉə-Juu mu Tɛsalonika chèʼnə mbɔ Bɔɔ bɛ ghɔ mu Bɛlia lɔ̀ʼ ŋgieNyiikə chɔ, bɔ̂ŋ dàa gɛ̀ chɔ kə́ ŋìitə bɔŋleʼ kɔ́ buŋ bʉə-kəyəŋ-ghɔ̄bə ndə məchʉ́ʉhə ntɔŋntɔŋ. <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />Ndʉʉghɔfii, haʼ ndʉʉmɛ, bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii tə́ŋ Bɔɔ kɔ́, ɔ gɛ̀ chu-muukwɛʼtəŋ, bɔŋ Sila ghɔŋ Timɔti shi káa chɔ. <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />Bʉə ndə bɔ̂ŋ kə gɛ̀ tíŋhə Bɔɔ, gɛ̀ tə dàa Atɛŋ. Ndʉʉ ndə ɔ byʉ̀hə ntəŋ tʉ bɔŋ mbɔ Sila ghɔŋ Timɔti yi shi chʉʼ gwè bìatə ɔŋ, bɔ̂ŋ bʉ̀nə.<verse eid="ACT 17:15" /></para>
  <para style="s">Bɔɔ lɔ̀ʼ ŋgieNyiikə mu Atɛŋ</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />Ndə Bɔɔ kə́ chyìi bɔŋ Atɛŋ, fyii-i chɔ́ŋhə ɔŋ, ndə ɔ nyíɛ mbʉ bʉə mu kəyəŋkwɛʼtəŋ, bɔ̂ŋ nɔʼ kɔ́ fyiihə-ʉə ndə bənyii kədɔŋ. <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />Bɔɔ gɛ̀ mu njaagháaNyii kə́ túŋ bəŋʉʉ ghɔŋbə bʉə-Juu leʼnə bəbɛʼbʉə ndə bɔ̂ŋ kə́ lə̀ʼtə Nyii, bɔŋleʼ túŋ bəŋʉʉ ghɔ mu yəŋ-vyii-kə ghɔŋbə bʉə ndə bɔ̂ŋ gɛ̀ bìatə bɔŋ chɔ.<verse eid="ACT 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 17:18" />Bəchichabɛʼbə ndə bə kə́ tíi bɔŋ nə bəEbikolia<note caller="+" style="f"><char style="fr" closed="false">17:18 </char><char style="ft" closed="false">BəEbikolia nɔ bɛ bʉə ndə bɔ̂ŋ kə tə́nə ndəŋ gyʉʉ Ebiko ndə ɔ kə́ dàhə mbɔ nchəŋnchəŋ kənu ndə wo kie ndə məbɛ kəwʉʉnəmbi bʉʼka yɔŋ nɔ bɛ ndə məchìi bətiekənu leʼnə məkie fyiighʉ́ənə bɔŋleʼ kə́ sàtə ŋwɔŋ-aŋ. Bɔ̂ŋ bɛ́ŋ mbɔ bənyii la bɛ ghɔ təmə bɔŋ kə́ fɔ̀ʼ mu bʉəməsʉʉ fɛ.</char></note> ghɔŋbə bəSitɔɛ <note caller="+" style="f"><char style="fr" closed="false">17:18 </char><char style="ft" closed="false">BəSitɔɛ nɔ kə bɛ bʉə ndə bɔ̂ŋ kə tə́nə ndəŋ gyʉʉ Sɛno. Bɔ̂ŋ kə́ yá mbɔ Nyii la bɛ mu fɔbə inchəŋ. Bɔŋ nɔ kə yá mbɔ ŋkwɔʼtə la bɛ nu-kwɛʼtəŋ-kə. Bɔ̂ŋ nɔ kə yá leʼ mbɔ wo la kie ndə mə yá ŋwɔŋ-ɛŋ təmə tʉʉ-i kə́ bʉ̀ʉ daa fɛ təmə bɔŋ-kə́-leʼ byʉ́ʼ daa fɛ.</char></note> kə́ túŋ bəŋʉʉ ghɔŋ ɔŋ. Bəbɛʼbə kə́ ghɔ̀ŋ mbɔ, “Wo-kənjuɔnə-ɔ̄ŋ tʉʼ ghɔ̀ŋ mbuka la?” Bəbɛʼbə kə́ ghɔ̀ŋ mbɔ, “Ɔ nɔ tʉʼ kwə́ʼ te bənyii kətə̂ŋbɛʼbə.” Bʉʼka ɔ nɔ kə́ lɔ̀ʼ ntəŋjyujyu tʉ bɔŋ te Jiso leʼnə məbʉnə-kóʼ-e.<verse eid="ACT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 17:19" />Bɔ̂ŋ lʉ̀ ɔ gɛ̀ nə nɔŋ mu kaŋsotəbɛʼ ndə bə kə́ tíi nə Alubago<note caller="+" style="f"><char style="fr" closed="false">17:19 </char><char style="ft" closed="false">Alubago nɔ bɛ kwɔŋbɛʼ ndə kaŋsotə-bəchicha kə yá nchəŋtə-yʉə chɔ.</char></note>, ghɔ̀ŋ tʉ ɔŋ mbɔ, “Bəkɔ a chìi baʼa kínə nukə te nu-fefe-kə-ɔ̄ŋ ndə a tʉʼ dàhə nɔ mɛ?” <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />Bʉʼka a nɔʼ gwè nə nu-fefe-bɛʼbə ndə baʼa tʉʼ yʉ́, baʼa kə́ kʉ́ʉ kínə nubə ndə i bɛ yɔŋ. <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />Bʉʼka bʉə-Atɛŋ ghɔŋbə bəntoʼŋgwe ndə bɔ̂ŋ bɛ chɔ nɔ nə kə́ kɔ́ ŋwɔŋ-yʉə bəchibəchi ndə mə-kə́-yʉ́ nu-fefe-bə bɔŋleʼ dàhə haʼ nu-fefe-bə ghɔ.<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />Ndʉʉmɛ, Bɔɔ lɔ̀ tə́nə ntəŋntəŋ bʉə-ghɔ̄bə ndəŋ mbʉ kwɔŋ Alubago, ghɔ̀ŋ mbɔ, “Bətie-bɔŋ, bəliŋ-bɔŋ, bʉə-Atɛŋ, mɔ nɔ nyíɛ mbɔ b̃ii nɔ kɛŋ lɛ́ɛŋ bənyii daa. <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />Ndə mɔ kə́ tíŋ, kə́ nyíɛ yəŋ-lɛ́ɛŋ-bənyii-bə-ii, mɔ nyíɛ ndə bə nyɔ̀ʼ ndəŋ tyʉəŋnyiibɛʼkə mbɔ, <char style="sc">Tʉ nyii ndə bə gòʼ təmə kinə ɔŋ fɛ</char>. Ndə bii tʉʼ lɛ́ɛŋ ɔŋ təmə kə́ kínə fɛ, nɔ bɛ ɔ ndə mɔ bu fʉ̀ʼtə tʉ bii nduɔ.<verse eid="ACT 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 17:24" />“Ɔ nɔ bɛ Nyii ndə ɔ chìi wʉʉnəmbikə ghɔŋ fɔbə ndə i bɛ muŋgɔ inchəŋ, kə́ bɛ Tiekətʉ-yuo ghɔŋbə chisêkə, nɔ, ɔ mə chí mu mbaahə ndə gə̀ŋ woməsʉʉ nə ghɔkə-i fɛ. <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />Təmə bɔŋ kə́ byúu fɔbɛʼkə ndə bəkɔ woməsʉʉ fɔ̀ʼ tʉ ɔŋ fɛ, fi nə ɔ byúu fɔkə fɛ. Bʉʼka nɔ tʉʼ kɔ́ ɔ, kɔ́ məchímbi tʉ bʉə bənchəŋ, kɔ́ bəyihə bɔŋleʼ kɔ́ fɔbə inchəŋ. <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />Hə ndəŋ mbyu wo-imɔʼ, ɔ chìi lɔʼ-bətə̂ŋ-tə inchəŋ kəwʉʉnəmbi ndə mə-kə́-chí ndəŋ yəŋbə inchəŋ chisêkə, ɔ nɔʼ kə shʉ̀tə ŋgwɔʼmbi-yʉə lʉ̀ hə bəshʉ, ghɔŋbə ŋkyʉə-bəyəŋ-bə ndə bɔ̂ŋ kie ndə məchí chɔ.<verse eid="ACT 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 17:27" />“Nyii nɔ kə chìi nɔ, mbɔ bɔ̂ŋ bu kʉ́ʉ ɔ, ndʉʉbɛʼ nɔ miɛnə ɔŋ yi nyíɛ ɔŋ, bɔŋ bɛ le ɔ dɔ̀ŋnə hə mbʉə wotəmiyɔŋ mu bʉʼʉ fɛ. <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />Bʉʼka bʉʼʉ nɔ tʉʼ chí mbi kə́ tòʼ, kə́ bɛ bʉə ndə bʉʼʉ bɛ yɔŋ bʉʼka mbəŋ-ɛŋ. Haʼ ndə bəmɔʼlyuu-bii-bɛʼbə kə ghɔ̀ŋ mbɔ, ‘Baʼa nɔ kɛŋ bɛ haʼ ŋgwie-wo-e ghɔ.’ <verse eid="ACT 17:28" /><verse number="29" style="v" sid="ACT 17:29" />Nduɔ ndə bʉʼʉ bɛ ŋgwie-wo-Nyii nɔ, kə bʉʼʉ mə kə́ kwɔ̀ʼtə mbɔ, mbʉ Nyii bɛ nə goo, siliba byuunɔ ŋgoʼhə ndə woməsʉʉ kwɔ̀ʼtə kɔ́ŋ byuunɔ chìi nə ghɔkə-i fɛ. <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />Nɔ kə bɛ ndə vɛʼ-tʉŋkwɔŋ-ghɔ̄, Nyii jyùu shʉ-i, bɔŋ nduɔ ɔ tʉʼ kàhə bʉə bənchəŋ ndə yəŋbə inchəŋ mbɔ bɔ̂ŋ shìe liɛŋtə-ʉə hə ndəŋ bʉ̂ʼtə-ʉə. <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />Bʉʼka ɔ nɔʼ shʉ̀tə chîkə tʉ́ʼ ndə məkwɛ̀ fɛʼɛ kəwʉʉnəmbi ndyʉndyʉ tíŋ hə bɔ̌ŋ wo ndə ɔ nɔʼ séʼ. Ɔ nɔʼ dʉ̀ʼ yɔ̄ŋ-yə tʉ bʉə bənchəŋ ndə məbʉ̀nə kóʼhə mbʉ wo ndʉʉ ndə ɔ kə kwú.”<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />Ndʉʉ ndə bɔ̂ŋ yʉ́ ɔ tíi yie məbʉnə-kóʼ hə ndəŋ kwu, bəbɛʼbʉə kə́ dʉ̀ʉhə ɔŋ, bɔŋ bəbɛʼbə ghɔ̀ŋ mbɔ, “Baʼa nɔ kʉ̀ʉ ndə mə-bìʼ-yʉ́ nukə-ɔ̄ŋ kəghɔ-a.” <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />Ndʉʉmɛ, Bɔɔ lɔ̀ hə mu bɔŋ gɛ̀ nə wi. <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />Bɔŋ bəbɛʼbʉə bɛ́ŋ Nyii, chə̀ŋ bɔ̌ŋ ɔŋ. Mu bɔŋ nɔ kə bɛ Dionashu ndə ɔ bɛ ŋguu-kaŋsotə-Alubago leʼnə wokebɛʼ ndə bə kə́ tíi ɔ nə Damali ghɔŋbə bəbɛʼbʉə.<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s">Bɔɔ bìatə Bilisika ghɔŋ Akwela</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />Ndʉʉmɛ, Bɔɔ lɔ̀ hə Atɛŋ gɛ̀ Kɔlɛŋ. <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />Ndə ɔ kə bɛ chɔ, ɔ nyíɛ wo-Juubɛʼ ndə bə kə́ tíi ɔ nə Akwela ndə kə bɛ wo-Bɔŋtu, ɔ bíe gwègwè hə Itali, ghɔŋ vi-i yie-e kə́ bɛ Bilisika. Bɔ̂ŋ nɔ kə gwè hə Itali bʉʼka Fɔŋ-Kladio nɔʼ kə kàhə bʉə-Juu bənchəŋ ndə məfyú hə mu Luŋ. Bɔɔ gɛ̀ ndə mənyíɛ bɔŋ. <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />Bʉʼka ghɔŋ bɔŋ kə kie ntɛ kəghɔ fɔʼɔ imɔʼ, ghɔŋ bɔŋ chí mɔʼɔ kə́ fʉ̀ə lɛʼbə nə gwo-nyaa-hə.<verse eid="ACT 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 18:4" />Kə bɛ ndəŋ Chîlɔʼkə təmiyɔŋ nɔ, Bɔɔ kə́ túŋ bəŋʉʉ mu njaagháaNyii, bɔŋleʼ kɔ̀ɔtə ndə məlóʼtə bʉə-Juu ghɔŋbə bʉə-Gili. <verse eid="ACT 18:4" /><verse number="5" style="v" sid="ACT 18:5" />Ndʉʉ ndə Sila ghɔŋ Timɔti kə shíʼ gwè hə Masɛdonia, tʉ Bɔɔ nɔʼ kɔ́ ŋwɔŋ-ɛŋ ndə məlɔ̀ʼ ŋgieNyiikə, bɔŋleʼ dʉ̀ʼ tʉ bʉə-Juu mbɔ Jiso la mbʉ Wo ndə Nyii Kùŋ Tə́ŋ. <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />Ndʉʉ ndə bɔ̂ŋ tɛ́ŋ ɔŋ bɔŋleʼ bʉ́əhə yie-e, Bɔɔ kwètə liɛŋ-ɛŋ ghɔ̀ŋ tʉ bɔŋ mbɔ, “Ŋgʉəʼ-yii nɔ nduɔ kətʉ-bii, kaʼ bii kwú bɛ́, ghɔkə-ɔŋ nɔ bɛ ighʉ́ʉnə. Lʉ̀ hə nduɔ gɛ̀ nə shʉbə, mɔ bu gɛ̀ tʉ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ.”<verse eid="ACT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 18:7" />Ɔ lɔ̀ hə chɔ gɛ̀ ŋíi mu njaa-wobɛʼ bə kə́ tíi ɔ nə Tatu Jusutu, kə́ bɛ wo ndə ɔ kə́ lə̀ʼtə Nyii. Njaa-ɛ kə́ŋhə mbʉə njaagháaNyii. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />Kilisɛbu, wokwɛʼtəŋ njaagháaNyii ghɔŋbə nchinjaa-ɛ bənchəŋ, bɛ́ŋ Tiekətʉ. Bʉə buŋmbi Kɔlɛŋ, kʉ̂ʉ yʉ́ ŋgieNyiikə nə Bɔɔ lɔ̀ʼ, bɔ̂ŋ bɛ́ŋ Nyii ghɔ bɔŋleʼ fí muu.<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />Tiekətʉ kwə́ʼ tʉ Bɔɔ ndʉʉbətyuʼ mu njəŋ təmə ɔ kə bɛ́ŋbɛ́ŋ fɛ, ghɔ̀ŋ mbɔ, <char style="wj">“Kə a mə fàa fɛ, kə́ kwə́ʼ, təmə bɔ́nə chu-a fɛ!</char> <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" /><char style="wj">Bʉʼka baʼa nɔ bɛ mɔʼɔ, wo mə ŋíi aŋ tə lə́ŋhə aŋ fɛ, bʉʼka mɔ nɔ kie bʉə buŋmbi mu kəyəŋkwɛʼtəŋ-fɛ̄ŋ ndə bɛ yɔŋ-yə.”</char> <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />Ɔ káa ghɔŋ bɔŋ ndə ŋgʉʼʉmbi nə bəchi ntʉʼʉ, kə́ dàhə ŋgieNyiikə mu bɔŋ.<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />Bɔŋ ndʉʉ ndə Galio kə́ bɛ gɔməna-Akia, bʉə-Juu nə gyʉʉ imɔʼ fúu nuɔ yá Bɔɔ, gɛ̀ nə nɔŋ mu njaafɛ̀ʼ, <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />kə́ ghɔ̀ŋ mbɔ, “Wo-ɔ̄ tʉʼ lóʼtə bʉə ndə mə-kə́-gháaNyii ntɛ ŋkʉ̂ʉ təmə bɛ ndə nuʼ-Mushi gìe fɛ.” <verse eid="ACT 18:13" /><verse number="14" style="v" sid="ACT 18:14" />Ndʉʉ ndə Bɔɔ kə bɛ ndə məŋɔ́ʼhə chu-i, Galio lɔ̀ hə sê, kwə́ʼ tʉ bʉə-Juu ghɔ̀ŋ mbɔ, “Kaʼ bii kʉ̌ʉ kə́ ghɔ̀ŋ mbɔ ɔ chìi nu-bʉəbʉə-kə, byuunɔ ntɛ ntɔŋntɔŋbɛʼ, Oo bʉə-Juu, təmə mɔ nɔ bɛ́ŋ bii. <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />Bɔŋ ndə bɛ bə nu-bəŋgie-bə ghɔŋbə yietə leʼnə nuʼ-yii nɔ, b̈ii kwɛ̀ nə mbəŋ-yii bʉʼka mɔ mə kə́ kwɛ̀ yɔŋ-yə ntɛ-bənu-hə fɛ.” <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />Ndʉʉmɛ, ɔ jə̀ŋ bɔŋ hə mu njaafɛ̀ʼ. <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />Ndʉʉmɛ, bɔ̂ŋ yá Sɔtɛni, ndə ɔ kə bɛ wokwɛʼtəŋ-mu-njaagháaNyii, gwúu ɔ bəshʉ njaafɛ̀ʼ. Təmə Galio kɛŋ bə̀ŋhə nukə chɔ fɛ.<verse eid="ACT 18:17" /></para>
  <para style="s">Bɔɔ bʉ̀nə gɛ̀ Antiɔk ndə i bɛ mu Silia</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />Yɔ̄ŋ-yə kʉ̂ʉ tíŋ, Bɔɔ bìʼ chí ghɔŋbə bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii tə kwìhə, ndʉʉmɛ, ɔ fyú hə mu bɔŋ, kóʼ buukwɛʼtəŋkə gɛ̀ Silia ghɔŋbə Bilisika leʼnə Akwela. Ndə ɔ dàa Sɛŋkala, ɔ chètə tʉkə-i, bʉʼka ɔ nɔʼ kə kàa nukə. <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />Ɔ kʉ̂ʉ gɛ̀ dàa Ɛfɛso, mɛ̀ʼtə bɔŋ chɔ, bɔŋ ɔ sʉ́ʉ mu njaagháaNyii túŋ bəŋʉʉ chɔ ghɔŋbə bʉə-Juu. <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />Bɔ̂ŋ téʼ tʉ ɔŋ mbɔ ghɔŋbə bɔŋ bìʼ chí kwìhə, ɔ tɛ́ŋ. <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />Ɔ kʉ̂ʉ tíŋhə bɔŋ, ghɔ̀ŋ tʉ bɔŋ mbɔ, “Kaʼ Nyii bɛ́ŋ, mɔ yi bʉ̀nə gwè mətòʼ tʉ bii.” Ndʉʉmɛ, ɔ kóʼ buukwɛʼtəŋkə lɔ̀ hə Ɛfɛso gɛ̀. <verse eid="ACT 18:21" /><verse number="22" style="v" sid="ACT 18:22" />Ndʉʉ ndə ɔ dàa Kasalia, ɔ kóʼ gɛ̀ Jɛlosalɛŋ chàʼtə bʉə-chɔshi, shíʼ gɛ̀ Antiɔk.<verse eid="ACT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 18:23" />Ɔ kʉ̂ʉ bɛ ghɔŋ bɔŋ ndə kʉʉkə, lɔ̀ kə́ tòʼ gɛ̀ bəyəŋbəyəŋ mu bie-Galatia-ghɔŋ-Filigia-hə ndə məkwèʼhə vâafɔʼɔ-Jiso bənchəŋ.<verse eid="ACT 18:23" /></para>
  <para style="s">Abolo mu Ɛfɛso ghɔŋbə Kɔlɛŋ</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />Wo Juubɛʼ ndə bə kə́ tíi ɔ nə Abolo, bə bí ɔ Alɛsaŋndia, gwè Ɛfɛso. Tʉ ɔ kínə kwə́ʼ daa bɔŋleʼ shʉ́ə ndəŋ ŋgieNyiikə. <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />Bə nɔʼ kə dàhə wo-ɔ̄ nə fia-Tiekətʉ, bʉʼka fyii-i tʉʼ ŋɔ̀ʼtə, ɔ kwə́ʼ bɔŋleʼ dàhə nubə jyujyu təmə mɔ̀ʼmbɛ fɛ, te Jiso, buŋ ndə nɔ, ɔ nɔ nə kínə bə haʼ nubə te məkɔ́ muu ndə Jɔŋ nə kə́ kɔ́. <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />Ɔ chʉ́ʉhə kə́ kwə́ʼ nə fyii tə̀ŋnə mu njaagháaNyii. Ndʉʉ ndə Bilisika ghɔŋ Akwela kə yʉ́ ɔ, bɔ̂ŋ lʉ̀ ɔ, shʉ̀tə fʉ̀ʼtə fia-Nyii tʉ ɔŋ jyujyu.<verse eid="ACT 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 18:27" />Ndʉʉ ndə ɔ kə́ kʉ́ʉ ndə mədàa gɛ̀ njəŋ Akia, bʉə ndə bɔ̂ŋ nɔʼ kə bɛ́ŋ Nyii kwèʼhə ɔŋ, nyɔ̀ʼ ŋwɔʼnə kɔ́ tʉ vâafɔʼɔ-Jiso ndə bɔ̂ŋ kə bɛ chɔ mbɔ b̈ɔ̂ŋ fí ɔ mu bɔŋ. Ɔ kʉ̂ʉ dàa, kwáa bʉə shʉ́əshʉ́ə ndə bɔ̂ŋ nɔʼ kə bɛ́ŋ Nyii tíŋ hə ndəŋ buuŋjyu-Nyii. <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />Bʉʼka ɔ kə́ túŋ bəŋʉʉ daa, ɔ ghɔ́ʼ bʉə-Juu mu bʉə ndə mədʉ̀ʼ tʉ bɔŋ mu ŋwɔʼnə-Nyii mbɔ Jiso la bɛ mbʉ Wo ndə Nyii Kùŋ Tə́ŋ.<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s">Bɔɔ bìʼ gɛ̀ mbi ndə fɔʼɔ-Nyii ndə vɛʼ tia</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />Ndʉʉ ndə Abolo kə bɛ Kɔlɛŋ, Bɔɔ tíŋ hə mu lɔʼɔ gɛ̀ Ɛfɛso, kʉ̂ʉ dàa chɔ, nyíɛ bəbɛʼbə vâafɔʼɔ-Jiso. <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />Bɔɔ bíʼtə tʉ bɔŋ mbɔ, “Bii kə kie LyʉʉhəNyiikə ndʉʉ ndə bii kə bɛ́ŋ Nyii mɛ?”</para>
  <para style="p" vid="ACT 19:2">Bɔ̂ŋ ghɔ̀ŋ mbɔ, “Mbee, baʼa chʉʼ nə buŋ yʉ́ mbɔ LyʉʉhəNyiikə bɛ ghɔ fɛ.”<verse eid="ACT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3" />Ndʉʉmɛ, ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, “Bɛ ntɛ muu ka ndʉʉghɔfii ndə bii kə fí?”</para>
  <para style="p" vid="ACT 19:3">Bɔ̂ŋ bə̀ŋhə mbɔ, “Yi-Jɔŋ-yə.”<verse eid="ACT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4" />Bɔɔ bə̀ŋhə mbɔ, “Jɔŋ nɔ nə kə́ kɔ́ muu bə haʼ mbɔ bʉə shìe liɛŋ hə ndəŋ bʉ̂ʼtə-ʉə, kə́ shyíi bʉə mbɔ bɔ̂ŋ la mɔ̀ʼfyiihə-ʉə ndəŋ wo ndə ɔ bu gwè hə bɔ̌ŋ, kə́ bɛ Jiso.”<verse eid="ACT 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5" />Bɔ̂ŋ kʉ̂ʉ yʉ́ yɔ̄ŋ-yə, fí muu yie-Jiso Tiekətʉ. <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />Ndʉʉ ndə Bɔɔ mɔ̀ʼ ghɔkə-i ndəŋ bɔŋ, LyʉʉhəNyiikə shíʼ ndəŋ bɔŋ, bɔ̂ŋ kə́ kwə́ʼ ŋgie-bətə̂ŋ-bədɔŋ-bə bɔŋleʼ kə́ téʼ ntəŋ ndə i gwè hə kəghɔ-Nyii. <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />Bɔ̂ŋ bənchəŋ kə́ bɛ nə bələŋ njuɔ bûu nə wuŋ.<verse eid="ACT 19:7" /></para>
  <para style="s">Fɔʼɔ-Bɔɔ mu Ɛfɛso</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />Ndʉʉmɛ, Bɔɔ gɛ̀ mu njaagháaNyii kə́ kwə́ʼ chɔ nə fyii tə̀ŋnə ndə bəchi itia kə́ túŋ bəŋʉʉ bɔŋleʼ lóʼtə bʉə nə nubə te Sɔ́ʼ-Nyii. <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />Bɔŋ ndʉʉ ndə bəbɛʼbʉə kə shʉ́əhə fyiihə-ʉə təmə kə́ bɛ́ŋ nukə ndə ɔ tʉʼ dàhə fɛ, kə́ dʉ̀ʉhə mbʉ Fia-Nyii bəshʉ bʉə buŋmbi, ɔ lʉ̀ vâafɔʼɔ-Jiso ghɔŋ bɔŋ fyúhə ŋwɔŋ-yʉə-bɔŋ, gɛ̀ mu njaaŋwɔʼnə-wobɛʼ ndə bə kə́ tíi ɔ nə Tilanu, gɛ̀ kə́ túŋ bəŋʉʉ chɔ bəchibəchi. <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />Bɔ̂ŋ fɔ̀ʼ haʼ nɔ chɔ ndə ŋgʉʼhə ibûu tʉ bʉə bənchəŋ ndə bɔ̂ŋ bɛ mu Esia yʉ́ ŋgie-Tiekətʉ-kə, bʉə-Juu ghɔŋbə bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ.<verse eid="ACT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />Nyii nɔ nə kə́ fɔ̀ʼ fɔŋ-bənu finə tíŋ hə bɔ̌ŋ Bɔɔ. <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />I bɛ tə via-ndyi-yʉ̀əʼ-shʉ-bə-i ghɔŋbə ndyi-fɔʼɔ-hə-i, bə lʉ̀ gɛ̀ nə yɔŋ, kʉ̂ʉ kə̀ŋ bʉə-bəyɔʼ chɔ nɔ, mbʉ yɔʼbə-ʉə tíŋ, lyʉʉhəbʉəbʉəbə bɔŋleʼ fyútə ghɔ mbʉə-bɔŋ.<verse eid="ACT 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 19:13" />Bʉə-Juubɛʼbə ndə bɔ̂ŋ kə́ tòʼ jə̀ŋ lyʉʉhəbʉəbʉəbə, kə́ kʉ́ʉ ghɔ ndə məlʉ̀ yie-Jiso Tiekətʉ kə́ jə̀ŋ lyʉʉhəbʉəbʉəbə nə yɔŋ mbʉə bʉə ndə bɔ̂ŋ kie, kə́ ghɔ̀ŋ mbɔ, “Baʼa nɔ tʉʼ kàhə a yie-Jiso ndə Bɔɔ tʉʼ lɔ̀ʼ mbɔ ä fyú!” <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />Vâabələŋbɛʼbə təkwiitia, ndə tie-yʉə bɛ tiefɛ̀ʼndɛŋkwɛʼtəŋNyii-bʉə-Juu, yie-e kə́ bɛ Sikifa, nɔ kə́ fɔ̀ʼ yɔ̄ŋ-yə. <verse eid="ACT 19:14" /><verse number="15" style="v" sid="ACT 19:15" />Mbʉ kəlyʉʉhəbʉəbʉə ghɔ̀ŋ mbɔ, “Mɔ nɔ kínə Jiso, kínə nubə te Bɔɔ, bɔŋ mbəŋ-aŋ bɛ nda?” <verse eid="ACT 19:15" /><verse number="16" style="v" sid="ACT 19:16" />Ndʉʉmɛ mbʉ wo-ghɔ̄ ndə lyʉʉhəbʉəbʉəkə bɛ mu mbʉə-ɔ le, sɛ́ʼ gwù ndəŋ bɔŋ gwúu bɔŋ bənchəŋ ghɔ́ʼ bɔŋ tə bɔ̂ŋ nyʉ́ʉ fyútə mu njaa-ghɔ̄ kənchiʼtʉʉ bənchəŋ nə dyʉʼbə ndəŋ bɔŋ.<verse eid="ACT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 19:17" />Bʉə bənchəŋ ndə bɔ̂ŋ bɛ mu Ɛfɛso, bʉə-Juu ghɔŋbə bʉə-Gili yʉ́ yɔ̄ŋ-yə, faakə yá bɔŋ bənchəŋ, bɔ̂ŋ kóʼhə yie-Jiso Tiekətʉ ghɔʼ. <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />Bʉə buŋmbi ghɔ ndə bɔ̂ŋ nɔʼ kə bɛ́ŋ Nyii kə́ fyú tə́nə kɛ̀ʼ nubə ndə bɔ̂ŋ kə́ chìi mu kənjəŋ. <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />Bʉə buŋmbi ndə bɔ̂ŋ kə́ fɔ̀ʼ nu-jə̀ŋ-bə gwè nə bəŋwɔʼnə-bʉə, bə tɔ̀ŋ bəshʉ bʉə bənchəŋ, bə kʉ̂ʉ súu chuɔŋtə-ii, i kóʼ nə bəmɛlɛyɔŋ wuŋ tia. <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />Ndʉʉmɛ, ŋgie-Tiekətʉ-kə bìʼ wɔ̀ʼnə yɔ́ŋyɔ́ŋ bɔŋleʼ shʉ́ə.<verse eid="ACT 19:20" /></para>
  <para style="s">Ntɔŋntɔŋ ndə i bɛ mu Ɛfɛso</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />Ndʉʉ ndə nubə-ɔ̄ŋ nɔʼ kə tíŋ, LyʉʉhəNyiikə chìi Bɔɔ séʼ ndə mətíŋ hə Masɛdonia ghɔŋbə Akia buŋ gɛ̀ Jɛlosalɛŋ, kə́ ghɔ̀ŋ mbɔ, “Ndʉʉ ndə mɔ bu lɔ̀ hə chɔ nɔ, mɔ yaʼ gɛ̀ ndə mənyíɛ bʉə-Luŋ ghɔ.” <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />Ɔ tə́ŋ bʉə bəbûu ndə bɔ̂ŋ kə́ tɔ́ŋ ɔŋ ndə fɔʼɔ, Timɔti ghɔŋ Ɛlastu, bɔ̂ŋ gɛ̀ bəshʉ mu Masɛdonia bɔŋ mbəŋ-ɛŋ bʉ̀nə shi chí Esia məniʼ.<verse eid="ACT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />Kʉ̂ʉ bɛ ndʉʉ-ghɔ̄, ntɔŋntɔŋ shʉ́əshʉ́ə ŋɛ̀nə mu Ɛfɛso te mbʉ Fia-Nyii. <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />Wobɛʼ ndə bə kə́ tíi ɔ nə Dɛmɛtolo, kə́ bɛ wo-kəlɔŋ, ɔ kə́ lɔ̀ŋ njaafɛ̀ʼndɛŋ-Fɔŋ-Atɛmi* ndə ɔ kə bɛ nyii-ke nə təŋbə fɛ̀ŋ, sii-i kə́ kɔ́ kyʉə yɔ́ŋyɔ́ŋ tʉ vâafɔʼɔ-bi. <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />Ɔ tíi bəbɛʼbə bʉə ndə bɔ̂ŋ tʉʼ fɔ̀ʼ haʼ ntɛ fɔʼɔ-ɛ, ghɔ̀ŋ tʉ bɔŋ mbɔ,</para>
  <para style="p" vid="ACT 19:25">“Bəliŋ-bɔŋ, bii nɔ kínə mbɔ kyʉə-yʉʼʉ nɔ tʉʼ gwè hə ndəŋ fia-ɔ̄. <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />Bəkɔ mbəŋ-yii yʉ́ bɔŋleʼ nyíɛ ghɔ mbɔ wo-ɔ̄ ndə bə tʉʼ tíi ɔ nə Bɔɔ nɔ, ɔ tʉʼ bə̀ŋtə bə haʼ mu Ɛfɛso fɛ, ɔ bɔŋ nɔʼ lóʼtə bʉə mu Esia tə i kə́ mì bɔŋleʼ kíahə bɔŋ ghɔ̀ŋ mbɔ, ‘Bənyii ndə bə chìi nə ghɔkə mə bɛ bənyii fɛ.’ <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />Nu-shʉ́əshʉ́ə-kə nɔ bɛ sê, kaa bə haʼ mbɔ, i bu byùutə bə haʼ vyii-yʉʼʉ-yɔ̄ŋ fɛ bɔŋ bə bu lɛ́nə njaafɛ̀ʼndɛŋ-Fɔŋ-Atɛmikwɛʼtəŋ ndə bɛ nyii-ke, mbɔ bɛ fɔkə fɛ. Bəkɔ bə shúʼhə ɔŋ hə ndəŋ məgʉə-e, kə́ bɛ nyii ndə bə tʉʼ lɛ́ɛŋ ɔŋ mu Esia ghɔŋbə wʉʉnəmbikə inchəŋ.”<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />Ndʉʉ ndə bɔ̂ŋ yʉ́ ŋgiebə-ɔ̄ŋ, tʉʉ-yʉə byʉ́ʼ, bɔ̂ŋ tíi mbɔ, “Məgʉ́ə nɔ bɛ yi-Fɔŋ-Atɛmi-yə ndə ɔ bɛ tʉ bʉə-Ɛfɛso.” <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />Mbyuutəmbyuutə gwù mu mbʉ kəyəŋkwɛʼtəŋ inchəŋ, bɔ̂ŋ nyʉ́ʉ bənchəŋ gɛ̀ kəyəŋ-nchəŋtəkwɛʼtəŋ-bɔŋ. Ndə bɔ̂ŋ tʉʼ gɛ̀ le, bɔ̂ŋ yá Gayo ghɔŋ Alistaku ndə bɛ bʉə-Masɛdonia ndə ghɔŋbə Bɔɔ kə́ tòʼ mɔʼɔ, dùu bɔŋ gɛ̀ nə bɔ̂ŋ chɔ. <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />Bɔɔ kə́ kʉ́ʉ gɛ̀ ŋíi mu mbʉ nuɔ-bʉə, bɔŋ vâafɔʼɔ-Jiso tɛ́ŋ tʉ ɔŋ. <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />Buŋ bʉəkwɛʼtəŋ-Esiabɛʼbə ndə bɔ̂ŋ bɛ bətieŋkɔŋ-Bɔɔ, dùhə ntəŋ tʉ Bɔɔ kə́ fʉ̀ʉtə ɔŋ mbɔ ɔ mə mùutə dʉ̀ʼ tʉkə-i mu mbʉ kəyəŋ-nchəŋtəkwɛʼtəŋ fɛ.<verse eid="ACT 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 19:32" />Mbyuutəmbyuutə nɔ nə bɛ mbʉ mu kəyəŋ-nchəŋtəkwɛʼtəŋ. Bəbɛʼbʉə kə́ tíitə ghɔŋ yɔ̄ŋ-yə nɔ, bəbɛʼbə kə́ tíitə gìe yīŋ-yə. Bʉə buŋmbi kə kínə nukə ndə bɔ̂ŋ kə bɛ mbʉ mu kəyəŋ-nchəŋtəkwɛʼtəŋ-ghɔ̄ bʉʼka yɔŋ-yə fɛ. <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />Bʉə-Juu tʉ́ʼ Alɛsaŋnda bəshʉ mbɔ ɔ túunə tʉkə-ʉə. Mbʉ nuɔ-bʉə kə́ tíitə kɔ́ ŋgiebə tʉ ɔŋ. Alɛsaŋnda chètə nuɔ-bʉə nə ghɔkə-i ndə məkwə́ʼ túunə tʉkə-ʉə hə kəghɔ mbʉ bʉə. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />Bɔŋ ndʉʉ ndə bɔ̂ŋ chèʼnə mbɔ ɔ bɛ wo-Juu, bɔ̂ŋ chʉ́ʉhə kə́ tíitə tə i kɔ́ kʉʉkə tə kə́ gɛ̀ nə bəchî ibûu mbɔ, “Məgʉ́ə nɔ bɛ yi-Fɔŋ-Atɛmi-yə ndə ɔ bɛ tʉ bʉə-Ɛfɛso.”<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />Ndʉʉ ndə wonyɔ̀ʼ-ŋwɔʼnə-wokwɛʼtəŋ mu mbʉ kəyəŋkwɛʼtəŋ, chyìi bɔŋ, ɔ ghɔ̀ŋ mbɔ, “Bənaa-bɔŋ, bətie-bɔŋ, bʉə-Ɛfɛso, bɛ nda ndə ɔ gòʼ təmə kínə mbɔ kie bʉə-Ɛfɛso bənchəŋ kie njaafɛ̀ʼndɛŋ-Atɛmi ndə bɛ nyiikwɛʼtəŋ, ghɔŋbə ŋgoʼ-e ndə i gwù hə yuo fɛ? <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />Bʉʼka mbɔ wo mə tɛ́ŋ nukə-ɔ̄ŋ fɛ, b̈ii líitə nduɔ mbɔ loʼo, təmə kə́ chìi nukə nə ndəŋnəkə fɛ. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />Bii nɔ gwè nə bʉə-bɔ̄ŋ fɛ̄ŋ təmə bɔ̂ŋ nɔʼ lʉ́ʼ fɔkə mu njaafɛ̀ʼndɛŋNyii fɛ, təmə bɔŋ-nɔʼ-leʼ tíi yie-nyii-yʉʼʉ bʉəbʉə fɛ. <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />Kaʼ bɛ mbɔ Dɛmɛtolo ghɔŋbə nuɔ-bʉə-kəlɔŋ-bi kie nukə te wotəmiyɔŋ, chusii-njaafɛ̀ʼ nɔ bɛ ighʉ́ʉnə, bʉə chʉ̀ə ŋkwɛ kə́ bɛ chɔ, b̈ɔ̂ŋ gwè fʉ̀ʼtə nukə ndə wofuu nɔʼ chìi. <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />Bɔŋ kaʼ bii kie nu-kədɔŋ-kə, təmə bʉʼʉ bu fɛ̀ʼ maa-yɔ̄ŋ kie-bʉʼʉ. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />Bʉʼʉ nɔ tə́nə laa chu-chɔ̂ bʉʼka bəkɔ bə yá kətʉ-bʉʼʉ mbɔ bʉʼʉ la tʉʼ byùutə mu lɔʼɔ, bʉʼka nukə ndə bəkɔ bʉʼʉ məmɔ̀ʼ luu jyujyu fɛ.” <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />Ndʉʉ ndə ɔ gìe nubə-ɔ̄ŋ liʼ, ɔ wɔ̀ʼhə bɔŋ.<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s">Bɔɔ gɛ̀ mu Masɛdonia ghɔŋbə Gili</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />Ndʉʉ ndə mbyuutəmbyuutə-ɔ̄ŋ liʼ, Bɔɔ chə̀ŋ vâafɔʼɔ-Jiso, kwèʼhə bɔŋ, tíŋhə bɔŋ lɔ̀ gɛ̀ Masɛdonia. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />Ɔ kʉ̂ʉ tòʼ tíŋ hə mu biehə-ɔ̄ŋ, kwèʼhə bɔŋ nə ŋgie-yɔ́ŋyɔ́ŋ-bə, lɔ̀ gɛ̀ Gili, <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />chí chɔ ndə bəchi itia. Ndə ɔ nɔʼ kə bɛ ndə məkóʼ buukwɛʼtəŋkə gɛ̀ Silia, ɔ chèʼnə mbɔ bʉə-Juubɛʼbə nɔ kə́ núu mənaa bɔ̌ŋ ɔŋ ndə məyí ɔ, ɔ lìʼ ndə məbʉ̀nə gɛ̀ tíŋ hə Masɛdonia.<verse eid="ACT 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 20:4" />Bʉə ndə ghɔŋ bɔŋ kə gɛ̀ mɔʼɔ nɔ nə bɛ Sobata ndə ɔ lɔ̀ hə Bɛlia kə́ bɛ vaa-Bihu, Alistaku ghɔŋ Sɛkuŋndu ndə bɔ̂ŋ lɔ̀ hə Tɛsalonika, Gayo ndə ɔ lɔ̀ hə Debi, Timɔti, leʼnə Taikiku ghɔŋ Tolofimu ndə bɔ̂ŋ lɔ̀ hə Esia. <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />Bʉə-bɔ̄ŋ gɛ̀ bəshʉ, gɛ̀ kʉ̀ʼ baʼa Tɔlɔs. <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />C̃hîkə ndə bə yú Nchəŋtə ndə bə Kwó Bele təmə yî chɔ fɛ liʼ. Baʼa sɛŋ lɔ̀ hə Filibai kóʼ buukwɛʼtəŋkə chí fia ndə chîbə itaa, bìatə bɔŋ Tɔlɔs, baʼa bɔŋ chí chɔ ndə chîbə təkwiitia.<verse eid="ACT 20:6" /></para>
  <para style="s">Ndyiʼtə mətòʼ-Bɔɔ-kə Tɔlɔs</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />Kʉ̂ʉ bɛ ndə fəŋ kəchî mu vyii mbi, baʼa chə̀ŋtə ndə məgètə fɔyu-Tiekətʉ-bə, Bɔɔ kə́ lɔ̀ʼ ŋgieNyiikə, bʉʼka mbɔ ɔ tʉʼ sɛŋ gɛ̀ nə wi ndə biitə-kəchî-kə, ɔ kwə́ʼ duhəduhə tə mbi kwɔnə ndyʉndyʉ. <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />Kɛʼtə nɔ kə́ báa yɔ́ŋyɔ́ŋ mu njəŋ-njaa-kweghɔʼ ndə baʼa chə̀ŋtə chɔ. <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />Vaabələŋbɛʼ kə́ dùʼ chu wundu, yie-e kə́ bɛ Yutəku, ɔ nɔʼ kɛŋ bɛ́ŋ tə dɔ̀ŋnə bʉʼka Bɔɔ kə́ lɔ̀ʼ ŋgieNyiikə duhəduhə. Mbɛŋhə kʉ̂ʉ fí ghʉəʼkə-i, ɔ chóʼnə ndəŋ yuhəbə itia kweghɔʼ gwù sê, bə kə̂ chɔ̀ʼhə ɔŋ tʉ ɔ nɔʼ kwú. <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />Bɔɔ shíʼ gwè, bʉ́ʉnə ndəŋ ɔŋ, bɛ̀ʼ ɔ ghɔ̀ŋ mbɔ, “Kə bii mə leʼ lə̀ŋnə fɛ, ɔ nɔ bíe ŋɛnə.” <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />Ndʉʉ ndə Bɔɔ nɔʼ kə kóʼ gɛ̀ bə́ʼtə bele ghɔŋ bɔŋ kwó, ɔ kwə́ʼ tʉ bɔŋ dùhə tə mbi fíi, ɔ gɛ̀ nə wi. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />Bɔ̂ŋ gɛ̀ chunjaa nə tʉʉjyu yɔ́ŋyɔ́ŋ ghɔŋbə mbʉ vaabələŋ-ghɔ̄, ɔ kə́ bɛ ŋɛnə.<verse eid="ACT 20:12" /></para>
  <para style="s">Bɔɔ fə́nə ghɔŋbə bʉəkwɛʼtəŋ Ɛfɛso</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />Baʼa kóʼ buukwɛʼtəŋkə gɛ̀ bəshʉ gɛ̀ dàa Aso ndə baʼa kə́ kʉ́ʉ ndə məbɛ̀ʼ Bɔɔ chɔ baʼa bɔŋ gɛ̀ bʉʼka ɔ nɔʼ kə shʉ̀tə nɔ. Ɔ nɔ kə téʼ tʉ baʼa ndə məchìi nɔ bʉʼka mbəŋ-ɛŋ nɔ kə bɛ ndə mətòʼ sê. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />Ndʉʉ ndə baʼa bɔŋ fə́nə Aso, baʼa lʉ̀ ɔ, ɔ kóʼ mu kəbuukwɛʼtəŋ, baʼa bɔŋ gɛ̀ Mitilɛŋ. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />Baʼa kóʼ buukwɛʼtəŋkə chɔ, gɛ̀ mbi kʉ̂ʉ sɛŋ fíi baʼa shùɔ kəyəŋbɛʼ ndə i bə̀ŋhə Cheo, mbi kʉ̂ʉ bìʼ sɛŋ fíi baʼa dàa Samɔŋ, kʉ̂ʉ lɔ̀ hə chɔ mbi kʉ̂ʉ bìʼ kə sɛŋ fíi baʼa dàa Mɛlitu.<verse eid="ACT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 20:16" />Bɔɔ kə́ mʉ̀ʉ ndə məgwè tíŋ Ɛfɛso tíŋ bʉʼka ɔ kə kʉ̀ʉ ndə mə-leʼ-tə́nə Esia fɛ, bʉʼka ɔ nɔ kə́ lə̀ŋnə ndə mə-chʉʼ-dàa Jɛlosalɛŋ ndəŋ chî-Bɛŋntaku-kə. <verse eid="ACT 20:16" /><verse number="17" style="v" sid="ACT 20:17" />Ndʉʉ ndə ɔ kə bɛ Mɛlitu, ɔ tə́ŋ tíi bəntəŋbəshʉ-chɔshi Ɛfɛso.<verse eid="ACT 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 20:18" />Ndʉʉ ndə bɔ̂ŋ kə gwè, ɔ ghɔ̀ŋ mbɔ, “Bəliŋ-bɔŋ, bii nɔ kínə ntɛ məchimbi-ɔ lʉ̀ hə ndəŋ fəŋ kəchî ndə mɔ gwè dàa Esia, <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />kə́ fɔ̀ʼ fɔʼɔ-Tiekətʉ nə mbuɔnəbə inchəŋ, kə́ gwía bɔŋleʼ kə́ nyíɛ ŋgʉəʼ hə kəghɔ-bʉə-Juu ndə bɔ̂ŋ kə́ kʉ́ʉ ndə mənyíɛ mɔ fɛ. <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />Bii nɔ kínə mbɔ mɔ kə lə̀ŋ nubɛʼkə kəghɔ-bii ndə bəkɔ i kɔ́ sii tʉ bii fɛ, kə́ dàhə bii mu bʉə ghɔŋbə chu-təlɔʼ-tə-ii. <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />Mɔ kə́ fʉ̀ʼtə tʉ bʉə-Juu ghɔŋbə bʉə-Gili, te məshìe liɛŋtə-ʉə hə ndəŋ bʉ̂ʼtə-ʉə, gwè tʉ Nyii bɔŋleʼ mɔ̀ʼfyiihə-ʉə ndəŋ Tiekətʉ-yʉʼʉ Jiso, Wo ndə Nyii Kùŋ Tə́ŋ.<verse eid="ACT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 20:22" />“Bɔŋ nduɔ LyʉʉhəNyiikə nɔʼ chóʼ mɔ ndə məgɛ̀ Jɛlosalɛŋ təmə mɔ kínə nukə ndə i bu fyú chíe mɔ chɔ fɛ. <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />Mɔ nɔ kínə haʼ mbɔ mu kəyəŋkwɛʼtəŋ təmiyɔŋ, LyʉʉhəNyiikə nɔ tʉʼ shyùu tyunəkə-ɔŋ mbɔ, chaŋ ghɔŋ ŋgʉəʼ la tʉʼ chyìi mɔ. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />Bɔŋ mbyu kənu kaa ghɔ mu nubə-ɔ̄ŋ ndə i tʉʼ fɛ̀ŋhə mɔ fɛ, təmə məchimbi-ɔ bɔŋ buŋ bɛ nubɛʼkə fɛ, yɔŋ-yə nɔ bɛ mbɔ mɔ mìʼtə fia-ɔ̄ ghɔŋbə fɔʼɔ ndə mɔ kie hə kəghɔ-Jiso Tiekətʉ, ndə məlɔ̀ʼ ntəŋjyujyu te buuŋjyu-Nyii.<verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />“Bɔŋ nduɔ mɔ nɔ kínə mbɔ bii bənchəŋ ndə mɔ nɔʼ lɔ̀ʼ Sɔ́ʼ-Nyii tʉ bii, bieleʼ nə bìʼ nyíɛ mbe-shʉ-ɔ fɛ. <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />Nduɔ mɔ nɔ tʉʼ kʉ́ʉ shyíi bii mbɔ ghɔkə-ɔŋ nɔ bɛ ighʉ́ʉnə te fɔbʉə-wotəmiyɔŋ-kə mu bii, <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />bʉʼka mbɔ mɔ kə bɔ́nə chu-ɔ ndə məshyíi bii nə nubə inchəŋ ndə bii kə kie ndə məkínə te Nyii fɛ.<verse eid="ACT 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 20:28" />“B̈ii láa le nduɔ nə yii-yə tʉkə leʼnə bʉə bənchəŋ ndə LyʉʉhəNyiikə nɔʼ chɔ̀ʼhə bii tʉ́ʼ ndə məbɛ bəntəŋbəshʉ-bʉə, kə́ yúʼ bʉə-Nyii ndə ɔ nɔʼ nyúɔ nə yi-yə fɔbʉəkə. <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />Bʉʼka mɔ nɔ kínə mbɔ ndʉʉ ndə mɔ bu lɔ̀ nɔ, bəbuu bu ŋíi mu bii, yítə bii təmə fɔkə gòʼ fɛ. <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />Buŋ hə mu bii, bʉə bu fyú kə́ kíahə shʉəŋ ndəŋ lɛɛŋkə ndə mədùu vâafɔʼɔ-Jiso fyúhə hə mu bii gɛ̀ nə bɔŋ kəvia-bɔŋ.<verse eid="ACT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 20:31" />“B̈ii láa le, kə́ kwɛ́nə mbɔ ndəŋ ŋgʉʼhə itia mɔ kə́ káa ndə məshyùu tyunəkə-i ndʉʉnəchî ghɔŋ ndʉʉbətyuʼ nə shʉmə shʉmə-ɔŋ fɛ.<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />“Nduɔ, mɔ nɔ mɛ̀ʼtə bii tʉ Nyii leʼnə ŋgiekə-i. I bu shyíi bii nə ntɛ buuŋjyu ndə ɔ kie, ndə bəkɔ i bɔ́ bii bɔŋleʼ chìi bii kie fʉʼkə ndə Nyii nɔʼ shʉ̀tə tʉ́ʼ tʉ bʉə-bi bənchəŋ ndə ɔ nɔʼ sʉ̀ bɔŋ, bɔ̂ŋ bɛ tʉ́ʉnə.<verse eid="ACT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 20:33" />“Ndʉʉ ndə bʉʼʉ kə bɛ mɔʼɔ, mɔ kə kʉ̀ʉ mbɔ kyʉə-wo byuunɔ ndyi-wo bɛ yɔŋ-yə fɛ. <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />Bii nɔ kínə mbɔ nɔ nə bɛ ŋiikəghɔbə-ɔŋ ndə i kə́ kwáa mɔ bɔŋleʼ kwáa bʉə ndə baʼa bɔŋ kə bɛ mɔʼɔ. <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />Ndə nchəŋnchəŋ bənu, mɔ nɔ kə dʉ̀ʼ tʉ bii mbɔ ndʉʉ ndə bii fɔ̀ʼ shʉ́əshʉ́ə, bii bu yaʼ kwáa bʉə-mbʉʼ. B̈ii kə́ kwɛ́nə ndə Jiso Tiekətʉ nə mbəŋ-ɛŋ kə ghɔ̀ŋ mbɔ, <char style="wj">‘Biʼbə nɔ tʉ bʉə ndə bɔ̂ŋ tʉʼ kɔ́ chàa bʉə ndə bɔ̂ŋ tʉʼ fífí.’</char>”<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />Ndʉʉ ndə ɔ gìe nubə-ɔ̄ŋ liʼ, ɔ bè kweʼtəbə-i sê ghɔŋ bɔŋ bənchəŋ gháaNyii. <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />Bɔ̂ŋ bənchəŋ gwíatə, yá Bɔɔ bɔ́nə. <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />I nɔ kɛŋ kə byʉ́ʼ bɔŋ bənchəŋ ndə ɔ gìe tʉ bɔŋ mbɔ bɔ̂ŋ bieleʼ nə bìʼ nyíɛ mbe-shʉ-i fɛ. Bɔ̂ŋ gɛ̀ tíŋhə ɔŋ chu-kəbuukwɛʼtəŋ.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s">Bɔɔ gɛ̀ Jɛlosalɛŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />Ndʉʉ ndə baʼa mɛ̀ʼtə bɔŋ, baʼa lʉ̀ buukwɛʼtəŋkə gɛ̀ ndyʉndyʉ gɛ̀ shùɔ Kos. Mbi kʉ̂ʉ sɛŋ fíi, baʼa dàa Lut, kʉ̂ʉ lɔ̀ hə chɔ gɛ̀ Batala. <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />Baʼa kʉ̂ʉ nyíɛ buukwɛʼtəŋkə ndə i tʉʼ gɛ̀ Fɔnishia, baʼa kóʼ chɔ kə́ gɛ̀.<figure style="fig" alt="Paul in a sheep going to Jerusalem" file="cn01958c.tif" size="col" copy="David C. Cook" ref="21:2">Bɔɔ mu kəbuukwɛʼtəŋ gɛ̀ Jɛlosalɛŋ</figure> <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />Ndʉʉ ndə baʼa kə́ dùhə nyíɛ Siblɔ, baʼa tíŋ hə byûumbɔŋ, té gɛ̀ dàa Silia gɛ̀ shùɔ Taa, kə́ bɛ yəŋkə ndə bə kie ndə məfyúhə bɛʼkə chɔ hə mu kəbuukwɛʼtəŋ-baʼa. <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />Baʼa kʉ́ʉ vâafɔʼɔ-Jiso chɔ, nyíɛ, baʼa bɔŋ chí ndə chîbə təkwiitia. LyʉʉhəNyiikə tíŋ hə bɔ̌ŋ vâafɔʼɔ-Jiso, bɔ̂ŋ shyùu tyunə-Bɔɔ-kə mbɔ ɔ mə gɛ̀ Jɛlosalɛŋ fɛ. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />Ndʉʉ ndə chîbə-aʼ kə mì, baʼa lɔ̀ hə chɔ kə́ bìʼ gɛ̀ nə shʉbə. Mbʉ bʉə ndə bɔ̂ŋ nɔʼ kə bɛ́ŋ Nyii bənchəŋ ghɔŋbə bəke-bʉə leʼnə vâa, gɛ̀ hə bɔ̌ŋ baʼa tʉ baʼa bɔŋ fyú hə mbʉ mu kəyəŋkwɛʼtəŋ. Baʼa kʉ̂ʉ dàa chʉʉ-kəbuukwɛʼtəŋ, bè kweʼtəbə-aʼ sê gháaNyii. <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />Baʼa kʉ̂ʉ tíŋhə ŋwɔŋtə-aʼ, gɛ̀ kóʼ mbʉ mu kəbuukwɛʼtəŋ, bɔ̂ŋ bʉ̀nə chunjaa.<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />Ndʉʉ ndə baʼa lɔ̀ hə Taa, baʼa ŋíi mu kəbuukwɛʼtəŋ tə gɛ̀ shùɔ Tolemi, gɛ̀ gìe tʉ bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii, baʼa bɔŋ chí ndəŋ chîmbikə. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />Baʼa kʉ̂ʉ sɛŋ lɔ̀ hə chɔ, gɛ̀ dàa Kasalia, ŋíi mu njaa-Fili, kə́ bɛ w̃o ndə ɔ nə kə́ lɔ̀ʼ ŋgieNyiikə bɔŋ-kə́-leʼ bɛ mbyu wo hə mu bʉə təkwiitia ndə chɔshi kə séʼ ndə mə-kə́-gyʉ̀ə fɔyubə. Baʼa chí mu njaa-ɔ. <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />Ɔ kie vâabəke kwii təmə bɔ̂ŋ nɔʼ kie bələŋ fɛ, ndə bɔ̂ŋ kə́ téʼ ntəŋ ndə i gwè hə kəghɔ-Nyii.<verse eid="ACT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 21:10" />Ndʉʉ ndə baʼa chí chɔ ndə mbyu-bəchî-hə, yʉkəŋgieNyiibɛʼ ndə bə kə́ tíi ɔ nə Agabu shíʼ gwè hə Judia. <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />Ɔ kʉ̂ʉ gwè bìatə baʼa, lʉ̀ kwɔ-Bɔɔ-kə, kɔ́ʼ yi-yə kwiitə ghɔŋbə fʉəŋtə-i nə yɔŋ-yə, ghɔ̀ŋ mbɔ, “LyʉʉhəNyiikə nɔʼ ghɔ̀ŋ mbɔ, ‘Wo ndə bɛ kwɔkə-i nɔ, bəntəŋbəshʉ-bʉə-Juu ndə bɔ̂ŋ bɛ mu Jɛlosalɛŋ bu kɔ́ʼtə ɔŋ haʼ mənɔ, kɔ́ tʉ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ.’ ” <verse eid="ACT 21:11" /><verse number="12" style="v" sid="ACT 21:12" />Ndʉʉ ndə baʼa yʉ́ yɔ̄ŋ-yə, baʼabə bʉə ndə bɔ̂ŋ bɛ chɔ, fʉ̀ʉtə Bɔɔ mbɔ ɔ mə kóʼ gɛ̀ Jɛlosalɛŋ fɛ.<verse eid="ACT 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 21:13" />Bɔɔ bə̀ŋhə mbɔ, “Bɛ ka bii kə́ gwía, bə́ʼtə fyii-ɔ? Mɔ nɔʼ shʉ̀tə ŋwɔŋ-ɔŋ bə haʼ ndə məgɛ̀ chaŋ Jɛlosalɛŋ fɛ, bɔŋ ndə mə-buŋ-kwú yie-Jiso Tiekətʉ ghɔ.” <verse eid="ACT 21:13" /><verse number="14" style="v" sid="ACT 21:14" />Ndʉʉ ndə baʼa byùutə ɔŋ kəŋkaa, baʼa yʉ́ʼnə ghɔbə-aʼ ndəŋ ɔŋ, ghɔ̀ŋ mbɔ, “Tə Tiekətʉ fɔ̀ʼ ŋkʉʉnə tʉʉ-i.”<verse eid="ACT 21:14" /></para>
  <para style="s">Bɔɔ dàa Jɛlosalɛŋ</para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />Chîbə-ɔ̄ŋ kʉ̂ʉ tíŋ, baʼa shʉ̀tə ŋwɔŋ-yaʼ, kóʼ gɛ̀ Jɛlosalɛŋ. <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />Vâafɔʼɔ Jiso-bɛʼbə lɔ̀ hə Kasalia bìa baʼa, lʉ̀ baʼa, baʼa bɔŋ gɛ̀ mu njaa-Mason ndə ɔ lɔ̀ hə Siblɔ, kə́ bɛ vaafɔ̀ʼ-Jiso lʉ̀ hə mbibɛʼ, ndə baʼa kə kie ndə məchí fu-ɔ. <verse eid="ACT 21:16" /><verse number="17" style="v" sid="ACT 21:17" />Ndʉʉ ndə baʼa kə dàa Jɛlosalɛŋ, bʉə ndə bɔ̂ŋ nɔʼ kə bɛ́ŋ Nyii fí baʼa chɔ nə tʉʉjyu.<verse eid="ACT 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 21:18" />Mbi kʉ̂ʉ sɛŋ fíi, baʼabə Bɔɔ gɛ̀ ndə mənyíɛ Jɛŋ. Bəntəŋbəshʉ bənchəŋ nɔ nə bɛ chɔ ghɔ. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />Bɔɔ kʉ̂ʉ gìe tʉ bɔŋ liʼ, fʉ̀ʼtə nubə tʉ bɔŋ imɔʼimɔʼ ndə Nyii nɔʼ fɔ̀ʼ tíŋ hə bɔ̌ŋ ɔŋ, tʉ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ.<verse eid="ACT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 21:20" />Bɔ̂ŋ kʉ̂ʉ yʉ́ yɔ̄ŋ-yə, lə̀ʼtə Nyii, gìe tʉ ɔŋ mbɔ, “A nyíɛ mɛ, liŋ, bɛ ntyʉʉ ŋkɔŋ-bʉə-Juu-hə bəsɛʼɛ ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii bɔŋ kie jyʉʉ ndə mətʉ́ʼ nuʼ-Mushi? <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />Bə bɔŋ nɔʼ shyíi bɔŋ mbɔ a la tʉʼ dàhə bʉə-Juu ndə bɔ̂ŋ tʉʼ chí mu bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ, mbɔ bɔ̂ŋ la shìe liɛŋtə-ʉə hə ndə nuʼ-Mushi, bɔŋ-kə́-leʼ shyíi bɔŋ mbɔ bɔ̂ŋ mə fɔ̀ʼ vâa-bʉə byuunɔ tʉ́ʼ nuʼ-yaʼ fɛ. <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />Bʉʼʉ bu bɛ təka? Bɔ̂ŋ bu yaʼ yʉ́ mbɔ a la bɛ fɛ̄ŋ.<verse eid="ACT 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 21:23" />“Fɔ̀ʼ haʼ nukə ndə baʼa bu kə́ gìe tʉ a. Baʼa nɔ kie bələŋ kwi ndə bɔ̂ŋ nɔʼ gwìa ŋkaamə. <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />Gɛ̀ lʉ̀ bʉə-bɔ̄ŋ, b̈ii bɔŋ gɛ̀ sʉ̀ ndɔŋ kətʉ-bii bɔŋ, bɔŋleʼ lɔ̀ʼ chuɔŋ-ɛŋ, bɔ̂ŋ chʉʼ chètə tʉbə-ʉə kə mbɔ bʉə bənchəŋ bu kínə mbɔ nubə ndə bə gìe kətʉ-a la bɛ lɛɛŋkə, bɔŋ mbɔ ya mbəŋ la tʉʼ leʼ tʉ́ʼ nuʼ-Mushi.<verse eid="ACT 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 21:25" />“Tʉ bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ, baʼa nɔʼ nyɔ̀ʼ nubə tʉ bɔŋ ndə baʼa nɔʼ shyʉ̀ʉ gyʉʉ chɔ mbɔ b̈ɔ̂ŋ la nyʉ́ʉ fɔbə ndə bə nɔʼ fɛ̀ʼ bənyii nə yɔŋ, ghɔŋbə mənú fɔbʉəkə leʼnə məkwó mbɔʼ nyaa ndə ɔ lʉ́ʉlʉ́ʉ leʼnə bəsəŋ.”<verse eid="ACT 21:25" /></para>
  <para style="s">Bə yá Bɔɔ</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />Mbi kʉ̂ʉ sɛŋ fíi, Bɔɔ lʉ̀ bɔŋ ghɔŋ bɔŋ kʉ̂ʉ sʉ̀ ŋwɔŋ-yʉə bɔŋ, gɛ̀ mu njaafɛ̀ʼndɛŋNyii gɛ̀ chìi bə kínə chîkə ndə ŋkaamə-ʉə bu lìʼ chɔ, bə bɔŋleʼ kɔ́ kɔkə ndə məfɛ̀ʼndɛŋ chɔ yie-bɔŋ.<verse eid="ACT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />Ndʉʉ ndə mbʉ bəchî təkwiitia kə gwè ndə məmì, bʉə-Juubɛʼbə ndə bɔ̂ŋ lɔ̀ hə Esia nyíɛ ɔŋ mu njaafɛ̀ʼndɛŋNyii. Bɔ̂ŋ kɔ́ buuŋ bʉə, bɔ̂ŋ yá ɔ, <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />kə́ tíitə ghɔ̀ŋ mbɔ, “Bʉə-Isilɛ, b̈ii kwáa baʼa! Nɔ bɛ wo nɔ ndə ɔ tʉʼ dàhə bʉə bənchəŋ ndəŋ yəŋbə inchəŋ, nə nu-bʉəbʉə-bə te bʉə-bʉʼʉ ghɔŋbə nuʼ-yʉʼʉ leʼnə yəŋkə-ɔ̄ŋ. Ndə məbìʼ chɔ, ɔ nɔʼ gwè nə bʉə-Gili, bɔ̂ŋ bʉ́əhə njaafɛ̀ʼndɛŋNyii-ɔ̄ŋ ndə i bɛ ŋkʉʉ.” <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />Bʉʼka mbɔ bɔ̂ŋ nɔʼ kə nyíɛ Tolofimu ndə ɔ lɔ̀ hə Ɛfɛso, bɔ̂ŋ kə́ kwɔ̀ʼtə mbɔ Bɔɔ la nɔʼ gwè nə nɔŋ mu njaafɛ̀ʼndɛŋNyii.<verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />Mbyuutəmbyuutə gwù mu mbʉ kəyəŋkwɛʼtəŋ, mbʉ bʉə bənchəŋ nyʉ́ʉ gɛ̀ yá Bɔɔ, dùu ɔ, fyúhə ɔŋ hə mu njaafɛ̀ʼndɛŋNyii. Haʼ ndʉʉmɛ, bə fʉ̀əŋ chulɔŋ. <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />Ndə bɔ̂ŋ kə́ kʉ̂ʉ ndə məyí ɔ, ntəŋ gwè tʉ ntəŋbəshʉ-bʉəkwɛʼtəŋ-bəsɔge mbɔ ntɔŋntɔŋ la bɛ mu Jɛlosalɛŋ. <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />Haʼ ndʉʉmɛ, ɔ lɔ̀ hə sê lʉ̀ bəbɛʼbʉəkwɛʼtəŋ bəsɔge ghyʉʉ ghɔŋbə bəbɛʼbəsɔge ghɔŋ bɔŋ, nyʉ́ʉ shíʼ, gɛ̀ bìatə bɔŋ. Ndʉʉ ndə bɔ̂ŋ nyíɛ mbʉ ntəŋbəshʉ-bʉəkwɛʼtəŋ-bəsɔge ghɔŋbə mbʉ bəsɔge, bɔ̂ŋ mɛ̀ʼtə ndə məgwúu Bɔɔ. <verse eid="ACT 21:32" /><verse number="33" style="v" sid="ACT 21:33" />Mbʉ ntəŋbəshʉ-bʉəkwɛʼtəŋ-bəsɔge kwɛ̀ʼtə gɛ̀ mbʉə Bɔɔ, kàhə mbɔ b̈ə la yá ɔ, kɔ́ʼtə ɔŋ nə bəchaŋ ibûu, ɔ bíʼtə wo ndə ɔ bɛ yɔŋ ghɔŋbə nukə ndə ɔ nɔʼ chìi. <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />Bəbɛʼbʉə kə́ tíitə gìe mbyu kənu imɔʼ nɔ, bəbɛʼbə kə́ tíitə gìe yi-kədɔŋ-yə. Ndʉʉ ndə ɔ chìi kəŋkaa ndə məkínə nukə ndə bə tʉʼ gìe bʉʼka kwə́ʼ yɔ́ŋyɔ́ŋ, ɔ kàhə mbɔ b̈ə la lʉ̀ ɔ, gwè nə nɔŋ mu njaa-bəsɔge. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />Ndʉʉ ndə ɔ gwè dàa chu-bəyuhə ndə məkóʼ gɛ̀ kweghɔʼ, bəsɔge bɛ̀ʼ ɔ bʉʼka ntɛ ntɔŋntɔŋ ndə mbʉ nuɔ-bʉə kə bɛ nə yɔŋ, <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />bʉʼka bʉə buŋmbi nɔ kə kə́ gwè hə bɔ̌ŋ, kə́ tòʼ tíitə ghɔ̀ŋ mbɔ, “B̈ii lʉ̀ ɔ, kwɛ̀ʼtə nə nɔŋ hə fɛ̄ŋ.”<verse eid="ACT 21:36" /></para>
  <para style="s">Bɔɔ kwə́ʼ tʉ mbʉ bʉə</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />Ndʉʉ ndə bə bɛ̀ʼ Bɔɔ ndə məgwè nə nɔŋ mu njaa-bəsɔge, ɔ gìe tʉ mbʉ ntəŋbəshʉ-bʉəkwɛʼtəŋ-bəsɔge mbɔ, “Bəkɔ mɔ gìe nukə tʉ a mɛ?”</para>
  <para style="p" vid="ACT 21:37">Ɔ bə̀ŋhə mbɔ, “Ã kwə́ʼ ŋgie-Gili-kə mɛ? <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />A kaa wo-Iji ndə ɔ kə bíe ŋɛ̀hə ntɔŋntɔŋ ŋɛ̀hə le fe? Ndə a ghɔ́ŋ nuɔ, biibə ŋkɔŋ-bʉə-hə kwi ndə bɔ̂ŋ kie fɔ-chɔ̂-bə, bii bɔŋ fyú gɛ̀ mu kwɔŋkəyəŋnə le fe?”<verse eid="ACT 21:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39" />Bɔɔ bə̀ŋhə mbɔ, “Mɔ nɔ bɛ wo-Juu, lɔ̀ hə Taashuʼ mu Silisia, təmə kə́ bɛ vaa kəyəŋ tîetîe fɛ. Mɔ nɔ tʉʼ fʉ̀ʉtə a, mɛ̀ʼtə mɔ, mɔ kwə́ʼ tʉ mbʉ bʉə.” <verse eid="ACT 21:39" /><verse number="40" style="v" sid="ACT 21:40" />Ndʉʉ ndə ɔ kɔ́ fia tʉ ɔŋ, Bɔɔ kóʼ tə́nə kweghɔʼ, chètə mbʉ bʉə nə ghɔkə-i. Ndʉʉ ndə yəŋbə yùtə, ɔ kwə́ʼ tʉ bɔŋ kəŋgie bʉə-Juu mbɔ,<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />“Bətie-bɔŋ, bəliŋ-bɔŋ ghɔŋbə bʉə-Juu, b̈ii yʉ́ ndə mɔ bu túu chʉʼ-ɔ tʉ bii.” <verse eid="ACT 22:1" /><verse number="2" style="v" sid="ACT 22:2" />Ndʉʉ ndə bɔ̂ŋ yʉ́ ɔ kə́ kwə́ʼ tʉ bɔŋ bɛ kəŋgie bʉə-Juu, bɔ̂ŋ kɛŋ bìʼ líitə jyujyu. Ndʉʉmɛ, ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <verse eid="ACT 22:2" /><verse number="3" style="v" sid="ACT 22:3" />“Mɔ nɔ bɛ wo-Juu, bə bí mɔ Taashuʼ mu Silisia bɔŋ mɔ kʉ̀ʼ mu kəyəŋkwɛʼtəŋ-fɛ̄ŋ. Gamalia dàhə mɔ shʉ́əshʉ́ə nə nuʼ-bətie-bʉʼʉ, mɔ kɔ́ fyii-ɔ ndə məfɔ̀ʼ tʉ Nyii shʉ́əshʉ́ə haʼ ndə bii bɛ laa nɔ. <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />Mɔ chɔ́ŋhə Fia-Nyii-ɔ̄ŋ tə kɔ́ tʉ kwu, kə́ yátə bəke ghɔŋbə bələŋ, kɔ́ʼtə bɔŋ gɛ̀ kɔ́ chaŋ. <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />Bəkɔ tiefɛ̀ʼndɛŋkwɛʼtəŋNyii ghɔŋbə bəntəŋbəshʉ-bʉə-kaŋsotə bənchəŋ fʉ̀ʼtə nukə-ɔ̄ŋ. Mɔ nɔ nə fí ŋwɔʼnə kəghɔ-bɔŋ ndə məgɛ̀ nə yɔŋ tʉ bəliŋ-bʉʼʉ bʉə-Juu, gɛ̀ nə kwii Damasiko ndə məlʉ̀ bʉə ndə bɔ̂ŋ bɛ chɔ, kɔ́ʼtə kwiitə-ʉə gwè nə bɔŋ Jɛlosalɛŋ, bə kɔ́ ŋgʉəʼ tʉ bɔŋ.<verse eid="ACT 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />“Ndə mɔ bɛ sêfia ndə məgɛ̀ Damasiko, nɔʼ gɛ̀ tə kə́ kə́ŋhə mbʉə ghɔ, kə́ bɛ nə ndʉʉbeʼ, leʼnə-shʉ́əshʉ́ə-kə kwɔnə báa hə yuo yə̀ŋhə mɔ. <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />Mɔ gwù sê yʉ́ gyʉʉ ndə i ghɔ̀ŋ tʉ mɔ mbɔ, <char style="wj">‘Sɔɔ, Sɔɔ, a tʉʼ chɔ́ŋhə mɔ mbuka?’</char><verse eid="ACT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 22:8" />“Mɔ bə̀ŋhə mbɔ, ‘A buŋ bɛ nda lɔɔŋ, Tiekətʉ?’ Ɔ bə̀ŋhə tʉ mɔ mbɔ, <char style="wj">‘Mɔ nɔ bɛ Jiso ndə ɔ lɔ̀ hə Nasalɛ ndə a tʉʼ chɔ́ŋhə.’</char> <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />Bʉə ndə baʼa bɔŋ kə́ bɛ mɔʼɔ nyíɛ mbʉ kəleʼnə bɔŋ təmə kínə mbʉ gyʉʉ ndə i tʉʼ kwə́ʼ tʉ mɔ fɛ.<verse eid="ACT 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 22:10" />“Ndʉʉmɛ, mɔ bíʼtə mbɔ, ‘Bəkɔ mɔ bɛ təka, Tiekətʉ?’</para>
  <para style="p" vid="ACT 22:10">“Mbʉ Tiekətʉ gìe tʉ mɔ mbɔ, <char style="wj">‘Lɔ̀ hə sê gɛ̀ mu Damasiko. A kʉ̂ʉ dàa chɔ nɔ, b̈ə shyíi a nə nubə inchəŋ ndə mɔ nɔʼ kə shʉ̀tə tʉ́ʼ tʉ a ndə məfɔ̀ʼ.’</char><verse eid="ACT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 22:11" />“Nduɔ, bʉʼka mbʉ kəleʼnə shʉ́əshʉ́ə ndə i kə báa shʉmə-ɔŋ le, chìi təmə mɔ mə leʼ nyíɛ yəŋkə fɛ, bʉə ndə baʼa bɔŋ kə bɛ mɔʼɔ yá kwii-ɔ, gɛ̀ nə mɔ mu Damasiko. <verse eid="ACT 22:11" /><verse number="12" style="v" sid="ACT 22:12" />Ananiabɛʼ nɔ kə bɛ chɔ, kə́ bɛ wo ndə ɔ nɔʼ kɔ́ ŋwɔŋ-ɛŋ ndə nuʼ-Mushi, bʉə-Juu ndə bɔ̂ŋ bɛ chɔ kə́ tíi yie-e jyujyu bənchəŋ. <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />Ɔ gwè tə́nə mbʉə mɔ ghɔ̀ŋ mbɔ, ‘L̈iŋ-ɔŋ Sɔɔ, bʉ̀nə kə́ nyíɛ yəŋkə.’ Haʼ ndʉʉghɔfii, mɔ nyíɛ yəŋkə, nyíɛ ɔŋ!<verse eid="ACT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 22:14" />“Ɔ ghɔ̀ŋ mbɔ, ‘Nyii-bətietie-bʉʼʉ nɔʼ kə séʼ a mbɔ ä kínə ŋkʉʉnə tʉʉ-i bɔŋleʼ nyíɛ mbʉ Wo ndə ɔ bɛ Ndyʉndyʉ bɔŋleʼ yʉ́ ŋgiekə ndə i fyú hə chu-ɔ. <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />Bʉʼka a bu bɛ wo ndə a bu lɔ̀ ntəŋ-ɛŋ tʉ bʉə bənchəŋ te nubə ndə a yʉ́ kəghɔ-ɔ bɔŋleʼ nyíɛ. <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />A tʉʼ kʉ̀ʼ ka nduɔ? Lɔ̀ hə sê tə́nə, fí muu, bɔŋleʼ sʉ̀ bʉ̂ʼʉ-a ndə a tʉʼ tíi yie-Tiekətʉ.’<verse eid="ACT 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />“Ndʉʉ ndə mɔ nɔʼ kə bʉ̀nə gɛ̀ Jɛlosalɛŋ, kʉ̂ʉ kə́ gháaNyii mu njaafɛ̀ʼndɛŋNyii, njəŋ chí mɔ təmə mɔ kə́ bɛ́ŋbɛ́ŋ fɛ. <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />Mɔ nyíɛ Tiekətʉ ɔ ghɔ̀ŋ tʉ mɔ mbɔ, <char style="wj">‘Lə̀ŋnə, chʉʼ fyú hə mu Jɛlosalɛŋ nəndʉʉnəndʉʉ bʉʼka bɔ̂ŋ kʉʉ bɛ́ŋ nubə ndə a tʉʼ kwə́ʼ tʉ bɔŋ te mɔ fɛ.’</char><verse eid="ACT 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 22:19" />“Mɔ bə̀ŋhə mbɔ, ‘Tiekətʉ, bɔ̂ŋ nə mbəŋtə-ʉə nɔ kínə mbɔ mɔ nɔ kə́ tòʼ lɔ̀ hə ndə njaagháaNyii imɔʼ dàa ndə ibɛʼ-yə kə́ tòʼ, yátə bʉə ndə bɔ̂ŋ bɛ́ŋ aŋ gwúutə bɔŋ bɔŋleʼ gɛ̀ fʉ̀əŋtə bɔŋ chaŋ. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />Ndʉʉ ndə bə kə tyù fɔbʉə-Shitifɛ̄ŋ-kə, wo ndə ɔ kə́ lɔ̀ʼ yie-a, mɔ nə mbəŋ ɔŋ nɔ kə tə́nə mbʉə bɔŋ, kə́ kɔ́ viʼi mbɔ b̈ə yí ɔ bɔŋ-kə́-leʼ chyìi ndyi-bʉə-hə ndə bɔ̂ŋ kə́ yí ɔ.<verse eid="ACT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 22:21" />“Ɔ ghɔ̀ŋ tʉ mɔ mbɔ, <char style="wj">‘Gɛ̀, bʉʼka mɔ bu tə́ŋ aŋ kɛŋ dɔdɔ tʉ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ.’</char>”<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />Bɔ̂ŋ kɔ́ tyunəbə-ʉə tʉ ɔŋ ndə məyʉ́ kwəʼ-ɛ, bɔŋ ndə ɔ dàa ndəŋ yɔ̄ŋ-yə mbyu kənu, bɔ̂ŋ chɔ̀ʼhə gyʉʉhə-ʉə ghɔʼ ghɔ̀ŋ mbɔ, “B̈ii lɔ̀ nə fɔ-maa-kə-ɔ̄ŋ hə kəwʉʉnəmbi bʉʼka ɔ kʉ̀ʼnə wo ɔ kə́ chí kəwʉʉnəmbi fɛ.” <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />Bɔ̂ŋ kə́ tíitə shùɔ ndyi-fəʼə-hə-ʉə mɛ̀ʼ, kə́ leʼ yʉ̀ʼ bʉəkə yuo.<verse eid="ACT 22:23" /></para>
  <para style="s">Bɔɔ kɛ̀ʼ ŋwɔŋ-ɛŋ mbɔ ɔ la bɛ wo Luŋ</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 22:24" />Mbʉ ntəŋbəshʉ-bʉəkwɛʼtəŋ-bəsɔge kàhə mbɔ b̈ə gwè nə nɔŋ mu njaa-bəsɔge, bə gwúu ɔ, ɔ chʉʼ kɛ̀ʼ nubə ndə i chìi nuɔ-bʉə kə́ tíitə kətʉ-ɔ. <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />Bɔŋ ndʉʉ ndə bə kə shyìi ɔ ndə məgwúu, Bɔɔ bíʼtə tʉ wokwɛʼtəŋ-bəsɔge ghyʉʉ ndə ɔ kə tə́nə mbʉə ɔ mbɔ, “Nuʼ bɛ́ŋ mbɔ ä gwúu wo-Luŋ təmə nɔʼ kwɛ̀ fɛʼɛ-ɛ, ɔ gwù fɛ mɛ?”<verse eid="ACT 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26" />Ndʉʉ ndə mbʉ wokwɛʼtəŋ-bəsɔge yʉ́ yɔ̄ŋ-yə, ɔ gɛ̀ mbʉə ntəŋbəshʉ-bʉəkwɛʼtəŋ-bəsɔge, gìe tʉ ɔŋ mbɔ, “A tʉʼ kʉ́ʉ chìi ka nɔ? Bʉʼka wo-ɔ̄ nɔ bɛ wo-Luŋ!”<verse eid="ACT 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27" />Ndʉʉmɛ, mbʉ ntəŋbəshʉ gwè ghɔ̀ŋ tʉ Bɔɔ mbɔ, “Shyíi mɔ, a bɛ wo-Luŋ la?”</para>
  <para style="p" vid="ACT 22:27">Ɔ ghɔ̀ŋ mbɔ, “Ɔŋ.”<verse eid="ACT 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28" />Mbʉ ntəŋbəshʉ-bʉəkwɛʼtəŋ-bəsɔge bə̀ŋhə mbɔ, “Mɔ nɔ nyúɔ ndə məbɛ wo-lɔʼɔ-ɔ̄ nə kyʉə yɔ́ŋyɔ́ŋ.”</para>
  <para style="p" vid="ACT 22:28">Bɔŋ Bɔɔ bə̀ŋhə mbɔ, “Mɔ nɔ bɛ wo-lɔʼɔ-ɔ̄ lʉ̀ hə vaambuɔ.”<verse eid="ACT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29" />Ndʉʉmɛ, bʉə ndə bɔ̂ŋ kə́ kʉ́ʉ tyúutə ɔŋ shùʼtə gɛ̀ bɔ̌ŋbɔ̌ŋ, mbʉ ntəŋbəshʉ-bʉəkwɛʼtəŋ-bəsɔge fàa ghɔ ndʉʉ ndə ɔ kə chèʼnə mbɔ Bɔɔ bɛ vaa-Luŋ ndə ɔ nɔʼ kɔ́ʼtə ɔŋ.<verse eid="ACT 22:29" /></para>
  <para style="s">Bə lʉ̀ Bɔɔ gɛ̀ nə nɔŋ mu kaŋsotəkwɛʼtəŋ</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />Mbi kʉ̂ʉ sɛŋ fíi, ɔ kə́ kʉ́ʉ ndə məkínə ŋkɛŋ luu ndə bʉə-Juu kə́ tíitə kətʉ-ɔ. Ɔ yɔ̀ʼtə ɔŋ, kàhə bətiefɛ̀ʼndɛŋNyii ghɔŋbə bʉə mu kaŋsotəkwɛʼtəŋ bənchəŋ mbɔ bɔ̂ŋ chə̀ŋtə, ndʉʉmɛ ɔ gwè nə Bɔɔ, tʉ́ʼ bəshʉ bɔŋ.<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />Ndʉʉ ndə Bɔɔ tʉ́ʼ shʉ-i ndəŋ mbʉ bʉə mu kaŋsotəkwɛʼtəŋ lɛ́nə mu shʉhə-ʉə shʉ́əshʉ́ə, ɔ ghɔ̀ŋ mbɔ, “Bəliŋ-bɔŋ, məchimbi-ɔ tə gwè dàa laa, ghɔŋbə ŋkwɔʼtə-ɔŋ nɔ bɛ itʉ́ʉnə bəshʉ-Nyii.”<verse eid="ACT 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 23:2" />Anania tiefɛ̀ʼndɛŋkwɛʼtəŋNyii kàhə bʉə ndə bɔ̂ŋ kə tə́ŋtə mbʉə ɔ mbɔ b̈ɔ̂ŋ la gwúu ghɔkə chu-ɔ. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />Ndʉʉmɛ, Bɔɔ ghɔ̀ŋ tʉ ɔŋ mbɔ, “Nyii bu gwúu ghɔkə chu-a, wo làhə shʉ! A dùʼ fɛ̄ŋ ndə məchʉ̀ə ŋkwɛ nə nuʼ-Nyii bɔŋ bʉ̀nə kə́ bə́ʼ mbʉ nuʼ tə kàhə mbɔ b̈ə gwúu ghɔkə chu-mɔ?”<verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />Bʉə ndə bɔ̂ŋ tə́nə mbʉə ɔ ghɔ̀ŋ mbɔ, “A tʉʼ chɛ̀ŋtə tiefɛ̀ʼndɛŋkwɛʼtəŋNyii mɛ?”<verse eid="ACT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5" />Bɔɔ bə̀ŋhə mbɔ, “Bəliŋ-bɔŋ, mɔ kínə mbɔ ɔ bɛ tiefɛ̀ʼndɛŋkwɛʼtəŋNyii fɛ, bʉʼka bə nɔ nyɔ̀ʼ mu ŋwɔʼnə-Nyii mbɔ, ‘Kə a məgìe kətʉ-ntəŋbəshʉ-bʉə-ba, bʉəbʉə fɛ.’ ”<verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />Ndʉʉ ndə Bɔɔ nyíɛ mbɔ ibɛʼ-yə via-bʉə-kə bɛ bʉə-Sadusi ibɛʼ-yə kə́ bɛ bʉə-Falasi, ɔ tíi nə ghʉəʼkə mu mbʉ kaŋsotə mbɔ, “Bəliŋ-bɔŋ, mɔ nɔ bɛ wo-Falasi, kə́ bɛ vaa-wo-Falasi. Nɔ chìi bʉʼka ndə mɔ tʉʼ chyìi nə fyii shʉ́əshʉ́ə mbɔ bʉə ndə bɔ̂ŋ nɔʼ kə kwú bu bʉ̀nə kóʼ, ndə bə gwè nə mɔ fɛ̄ŋ kə́ tyúutə mɔ nɔ.”<verse eid="ACT 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7" />Ndʉʉ ndə ɔ kə gìe yɔ̄ŋ-yə mbyuutəmbyuutə gwù mu mbʉ bʉə-Falasi ghɔŋbə bʉə-Sadusi, mbʉ nuɔ-bʉə gyʉ̀əhə. <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />Bʉʼka bʉə-Sadusi kə bɛ́ŋ mbɔ w̃o bʉ̀nə kóʼ fɛ, təmə bʉəntəŋNyii bɛ ghɔ fɛ, təmə lyʉʉhəbə bɛ ghɔ fɛ, bɔŋ bʉə-Falasi bɛ́ŋ nubə-bɔ̄ŋ inchəŋ. <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />Ndʉʉmɛ, mbyuutəmbyuutə shʉ́əshʉ́ə gwù, bəbɛʼbʉə-Falasi ndə bɔ̂ŋ kə́ dàhə nuʼ-Mushi lɔ̀ hə sê kɛŋ dùu lyʉʼʉ shʉ́əshʉ́ə kə́ ghɔ̀ŋ mbɔ, “Baʼa nyíɛ nu-bʉəbʉə-kə ndə wo-ɔ̄ chìi fɛ. Ndʉʉbɛʼ kwə́ʼ lyʉʉhəkə byuunɔ wontəŋNyii tʉ ɔŋ.” <verse eid="ACT 23:9" /><verse number="10" style="v" sid="ACT 23:10" />Ndʉʉ ndə mbʉ mbyuutəmbyuutə kə shʉ́ə daa, mbʉ ntəŋbəshʉ-bʉəkwɛʼtəŋ-bəsɔge, nɔ kə kə́ fàa mbɔ bə bu jɔ̀ʼtə Bɔɔ, ɔ kàhə mbʉ bəsɔge ndə məshíʼ gɛ̀ yá ɔ fí hə kəghɔ-bɔŋ nə ghʉəʼkə gwè nə nɔŋ mu njaa-bəsɔge.<verse eid="ACT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11" />Mbi kʉ̂ʉ bìʼ jʉ́, Tiekətʉ gwè tə́nə mbʉə ɔ, ghɔ̀ŋ tʉ ɔŋ mbɔ, <char style="wj">“Kie fyii shʉ́əshʉ́ə, bʉʼka ntɛ ndə a kwə́ʼ te mɔ tʉ bʉə-Jɛlosalɛŋ nɔ, a nɔ kie ndə məkwə́ʼ haʼ nɔ ghɔ te mɔ tʉ bʉə-Luŋ.”</char><verse eid="ACT 23:11" /></para>
  <para style="s">Bə tyúutə wu-Bɔɔ-kə ndə məyí ɔ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />Mbi kʉ̂ʉ sɛŋ fíi, bʉə-Juu shʉ̀tə kàa nukə mbɔ bɔ̂ŋ la kʉʉ kɔ́ fɔkə chu-bɔŋ fɛ, tə bɔ̂ŋ yaʼ yí Bɔɔ. <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />Bʉə ndə bɔ̂ŋ kə shyʉ̀ʉ gyʉʉ ndə nukə-ɔ̄ŋ nɔ nə tíŋ bʉə wuŋ kwi. <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />Bɔ̂ŋ gɛ̀ tʉ bətiefɛ̀ʼndɛŋNyii ghɔŋbə bəntəŋbəshʉ ghɔ̀ŋ mbɔ, “Baʼa nɔʼ kɛŋ kàa shʉ́əshʉ́ə ndə məyí Bɔɔ, fɔkə buŋ ŋíi chu-baʼa. <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />Nduɔ, b̈ii bəbʉə-mbʉ-kaŋsotə dùhə ntəŋ tʉ ntəŋbəshʉ-bʉəkwɛʼtəŋ-bəsɔge mbɔ ɔ̈ lʉ̀ Bɔɔ shíʼ gwè nə nɔŋ, kɔ́ tʉ bii, fi nə bii bu chʉ̀ə fɛʼɛ-ɛ jyujyu. Baʼa bu lìʼ lʉʉ-i sêfia ɔ buŋ dàa.”<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />Vaabələŋ, vaa-liŋ-Bɔɔ woke yʉ́ chùŋ-yʉə, gɛ̀ sʉ́ʉ mbʉ mu njaa-bəsɔge, fʉ̀ʼtə tʉ Bɔɔ. <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />Bɔɔ tíi mbyu wokwɛʼtəŋ-bəsɔge ghyʉʉ, imɔʼ gìe tʉ ɔŋ mbɔ, “Lʉ̀ vaabələŋ-ɔ̄ŋ gɛ̀ nə nɔŋ tʉ ntəŋbəshʉ-bʉəkwɛʼtəŋ-bəsɔge, bʉʼka ɔ nɔ kie nukə ndə məgìe tʉ ɔŋ.”<verse eid="ACT 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 23:18" />Ndʉʉmɛ, ɔ lʉ̀ ɔ gɛ̀ nə nɔŋ tʉ mbʉ ntəŋbəshʉ-bʉəkwɛʼtəŋ-bəsɔge ghɔ̀ŋ mbɔ, “Bɔɔ ndə ɔ bɛ mu njaa-chaŋ le, nɔ tíi mɔ ghɔ̀ŋ mbɔ m̈ɔ lʉ̀ vaabələŋ-ɔ̄ŋ gwè nə nɔŋ tʉ a bʉʼka ɔ nɔ kie nukə ndə məgìe tʉ a.”<verse eid="ACT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19" />Mbʉ ntəŋbəshʉ-bʉəkwɛʼtəŋ-bəsɔge yá kwii-i ghɔŋ fí ŋwɔŋ-yʉə-ɔ bɔ̌ŋ, ɔ bíʼtə tʉ ɔŋ mbɔ, “A kie ka ndə məgìe tʉ mɔ?”<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />Ɔ bə̀ŋhə mbɔ, “Bʉə-Juu nɔʼ shyʉ̀ʉ gyʉʉ ndə mətéʼ tʉ a mbɔ ä la shíʼ gwè nə Bɔɔ mu mbʉ kaŋsotə yɔ̂ŋ, fi nə bɔ̂ŋ tʉʼ kʉ́ʉ tyúutə jyujyu ndə məkínə nukə te ɔ. <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />Bɔŋ kə a mə mɛ̀ʼtə bɔŋ lóʼtə a fɛ, bʉʼka bʉə-bʉə tə tíŋ wuŋ kwi nɔ nʉ̀ʉ sêfia kə́ chyìi ndə məyí ɔ, nɔʼ kàa nukə mbɔ bɔ̂ŋ kʉʉ yú fɔkə byuunɔ nú fɔkə fɛ tə yaʼ yí ɔ. Nduɔ, bɔ̂ŋ nɔʼ shʉ̀tə ŋwɔŋ-yʉə, kə́ chyìi ndə məyʉ́ ŋgiekə hə kəghɔ-a.”<verse eid="ACT 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22" />Ndʉʉmɛ, mbʉ ntəŋbəshʉ-bʉəkwɛʼtəŋ-bəsɔge téʼ tʉ mbʉ vaabələŋ ɔ̈ bʉ̀nə gɛ̀ nə wi, ghɔ̀ŋ tʉ ɔŋ mbɔ, “Kə a mə chìi wo kínə mbɔ a nɔʼ shyíi mɔ nə nubə-ɔ̄ŋ fɛ.”<verse eid="ACT 23:22" /></para>
  <para style="s">Bə tə́ŋ Bɔɔ kɔ́ Kasalia</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />Ndʉʉmɛ, ɔ tíi bʉəkwɛʼtəŋ-bəsɔge bəbûu, ghɔ̀ŋ tʉ bɔŋ mbɔ, “B̈ii shʉ̀tə bəsɔge təghyʉʉ təbûu, leʼnə bəsɔge ndəŋ bənyaa-bəkatə wuŋ təkwiitia, leʼnə bʉə mɔ̀ʼ ghʉ̂ʉ təghyʉʉ təbûu ndə məgɛ̀ Kasalia ndə bəchî bɔmɔʼ ndʉʉbətyuʼ. <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />B̈ii shʉ̀tə nyaahə ghɔ tʉ Bɔɔ, ndə məbɛ̀ʼ ɔ, gwè nə nɔŋ buɔbuɔ, tə gwè dàa nə nɔŋ tʉ Gɔməna Fɛli.” <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />Ndʉʉmɛ, ɔ nyɔ̀ʼ ŋwɔʼnə-ɔ̄ŋ tʉ mbʉ gɔməna mbɔ,<verse eid="ACT 23:25" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="26" style="v" sid="ACT 23:26" />“I nɔ lɔ̀ hə kəghɔ-Kladio Lisia, tʉ tie-ɔ Gɔməna Fɛli. Mɔ chàʼtə a! <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />Bʉə-Juu nɔ nə yá wo-ɔ̄, tə kə́ kʉ́ʉ yí ɔ, ndʉʉ ndə mɔ gwè bìatə bɔŋ nə bəsɔge, chʉ̀ʼ tʉkə-i, kʉ̂ʉ yʉ́ mbɔ ɔ bɛ wo-Luŋ, <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />mɔ kə́ kʉ́ʉ ndə məkínə nukə ndə bə tʉʼ chɔ́ŋhə ɔŋ bʉʼka yɔŋ-yə, ndʉʉghɔfii, mɔ lʉ̀ ɔ shíʼ gɛ̀ nə nɔŋ mu kaŋsotəkwɛʼtəŋ-bɔŋ. <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />Mɔ chèʼnə mbɔ bə nɔ nə kə́ chɔ́ŋhə ɔŋ bʉʼka nuʼ-yʉə bɔŋ təmə i bɛ nukə ndə bəkɔ bə yí ɔ bʉʼka yɔŋ-yə byuunɔ ɔ gɛ̀ chaŋ fɛ. <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />Bɔŋ ndʉʉ ndə bə kə kɛ̀ʼ tʉ mɔ mbɔ bə tʉʼ kʉ́ʉ fia ndə məyí ɔ, mɔ tuŋ tə́ŋ ɔŋ haʼ tʉ a ndʉʉmɛ bɔŋleʼ kàhə bʉə ndə bɔ̂ŋ tʉʼ chə́ŋ bɔ̌ŋ ɛŋ ndə məgwè fʉ̀ʼtə nubə tʉ a ndə bɔ̂ŋ kie te ɔ nə mbəŋ-yʉə.”<verse eid="ACT 23:30" /></para>
  <para style="b" />
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />Ndʉʉmɛ, mbʉ bəsɔge yʉ́ chu-i, lʉ̀ Bɔɔ gwè nə nɔŋ ndʉʉbətyuʼ tʉ Antibatili. <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />Mbi kʉ̂ʉ sɛŋ fíi, bɔ̂ŋ bʉ̀nə gɛ̀ mu njaa-bəsɔge, mɛ̀ʼtə mbʉ bəsɔge bənyaa-bəkatə ndə məgɛ̀ ghɔŋ bɔŋ. <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />Ndʉʉ ndə bɔ̂ŋ gwè dàa Kasalia, kʉ̂ʉ kɔ́ mbʉ ŋwɔʼnə tʉ mbʉ gɔməna bɔŋleʼ dʉ̀ʼ Bɔɔ ghɔ tʉ ɔŋ. <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />Ndʉʉ ndə mbʉ gɔməna tíi mbʉ ŋwɔʼnə lìʼ, bíʼtə mbɔ ɔ lɔ̀ hə ndə yɔ̂ŋ-yə bie. Ɔ kʉ̂ʉ yʉ́ mbɔ ɔ lɔ̀ hə Silisia, ɔ ghɔ̀ŋ mbɔ, <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />“Mɔ bu yʉ́ ya-yə ndʉʉ ndə bʉə ndə bɔ̂ŋ tʉʼ chə́ŋ bɔ̌ŋ aŋ gwè dàa.” Ndʉʉmɛ, ɔ kàhə mbɔ b̈ə fʉ̀əŋ Bɔɔ mu chaŋ ndə i bɛ ntoʼ-Hɛlo, kə́ chyìi ɔ.<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s">Bɔɔ bəshʉ Gɔməna Fɛli</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />Chîbə kʉ̂ʉ tíŋ itaa, tiefɛ̀ʼndɛŋkwɛʼtəŋNyii shíʼ gwè Kasalia, yie kə́ bɛ Anania. Ɔ gwè ghɔŋbə bəbɛʼbə bəntəŋbəshʉ-bʉə-Juu leʼnə wobɛʼ ndə ɔ bu kwə́ʼ yie-bɔŋ, yie-e kə́ bɛ Tɛtulu. Bɔ̂ŋ fʉ̀ʼtə tʉ gɔməna nubə ndə bɔ̂ŋ kie te Bɔɔ. <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />Ndʉʉ ndə bə gwè nə Bɔɔ, Tɛtulu chʉ́ʉhə məfʉ̀ʼtə nubə te ɔ, kə́ ghɔ̀ŋ mbɔ,</para>
  <para style="p" vid="ACT 24:2">“Lʉ̀ hə ndə a dùʼ kəkʉə-baʼa, tie-ɔ Fɛli, baʼa nɔ kie fyiighʉ́ənə yɔ́ŋyɔ́ŋ daa, a bɔŋ-nɔʼ-leʼ kwɛ́nə nubə lɔʼɔ-fɛ̄ŋ yɔ́ŋyɔ́ŋ bʉʼka a nɔ tʉʼ nyíɛ hə bəshʉ. <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />Ndə yəŋbə inchəŋ ghɔŋbə fiatə inchəŋ, baʼa nɔ bɛ́ŋ yɔ̄ŋ-yə, tie-ɔ Fɛli, nə tʉʉjyu yɔ́ŋyɔ́ŋ. <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />Bɔŋ bʉʼka mbɔ baʼa kie ndə məyá a tʉ́ʼ fɛ̄ŋ i kə́ dɔ̀ŋnə fɛ, mɔ nɔ tʉʼ fʉ̀ʉtə a ndəŋ nuʼ-jyujyu-a ndə məyá fyii-a məniʼ, yʉ́ vaadyʉʼʉ kəŋgie hə chu-baʼa. <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />Bʉʼka baʼa nɔʼ nyíɛ mbɔ wo-ɔ̄ nɔ bɛ tʉ-bʉ́ʼ-kə, kə́ ŋɛ̀hə bʉə-Juu nə ntɔŋntɔŋ mu kəwʉʉnəmbi inchəŋ bɔŋ-kə́-leʼ bɛ ntəŋbəshʉkwɛʼtəŋ-nuɔ-bʉəbɛʼbə ndə bə kə́ tíi bɔŋ nə bəNasalɛ ndə bɔ̂ŋ nɔʼ fɔ̀ʼ ŋwɔŋ-yʉə fyúhə ndəŋ nuʼ bʉə-Juu. <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />Buŋ ndə məbìʼ chɔ, ɔ kə́ kɔ̀ɔtə ndə məbʉ́əhə njaafɛ̀ʼndɛŋNyii, baʼa buŋ yá ɔ. [Baʼa bɔŋ nɔ kə́ leʼ kʉ̀ʉ sɔ́ʼ ɔ nə nuʼ-yaʼ, <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />bɔŋ Lisia, ndə ɔ bɛ wokwɛʼtəŋ-njaa-chaŋ, gwè fí ɔ hə kəghɔ-baʼa nə ghʉəʼkə. <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />Ndʉʉmɛ, Lisia kàhə mbɔ b̈ʉə ndə bɔ̂ŋ nɔʼ mɔ̀ʼ nukə kətʉ-ɔ la gwè nyíɛ aŋ.] A bu tyúutə ɔŋ nə yá mbəŋ, yʉ́ hə kəghɔ-ɔ te nubə ndə baʼa gìe kətʉ-ɔ inchəŋ.” <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />Mbʉ bʉə-Juu bìa chu-yʉə chɔ ndə mədʉ̀ʼ mbɔ nchəŋnchəŋ bənu-ɔ̄ŋ nɔ kə bɛ shʉəŋ. <verse eid="ACT 24:9" /><verse number="10" style="v" sid="ACT 24:10" />Ndʉʉ ndə mbʉ gɔməna kə ŋwìɛ Bɔɔ ndə məkwə́ʼ, Bɔɔ bə̀ŋhə mbɔ,</para>
  <para style="p" vid="ACT 24:10">“Mɔ nɔ kínə mbɔ a nɔʼ sɔ́ʼ lɔʼɔ-ɔ̄ ndə ŋgʉʼhə buŋmbi, mɔ bu túu chʉʼ-ɔ tʉ a nə tʉʉjyu. <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />Bəkɔ a tyúutə nyíɛ mbɔ i chʉʼ tíŋ chîbə njuɔ bûu nə wuŋ lʉ̀ hə ndə mɔ kóʼ gɛ̀ Jɛlosalɛŋ ndə mələ̀ʼtə Nyii fɛ. <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />Təmə bɔ̂ŋ nyíɛ mɔ kə́ yá bəŋʉʉ baʼa wo fɛ, byuunɔ kə́ mɔ̀ʼ mbyuutəmbyuutə mu njaafɛ̀ʼndɛŋNyii fɛ byuunɔ mu-njaagháaNyii-hə fɛ byuunɔ mu kəyəŋkwɛʼtəŋ fɛ. <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />Bʉə-bɔ̄ŋ mə dʉ̀ʼ tʉ a mbɔ nukə ndə bɔ̂ŋ tʉʼ gìe yie-mɔ bɛ shʉəŋ fɛ.<verse eid="ACT 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 24:14" />“Mɔ nɔ bɛ́ŋ bəshʉ a mbɔ mɔ nɔ tʉʼ gɛ̀ hə ndəŋ mbʉ Fia, ndə bɔ̂ŋ tʉʼ tíi nə nuɔ-bʉə ndə bɔ̂ŋ nɔʼ fɔ̀ʼ ŋwɔŋ-yʉə fyúhə ndəŋ nuʼ bʉə-Juu. Mɔ nɔ tʉʼ lə̀ʼtə Nyii bətietie-bʉʼʉ, bɔŋ-kə́-leʼ tʉ́ʼ nubə inchəŋ haʼ ndə bə kə nyɔ̀ʼ mu ŋwɔʼnə-nuʼ-Mushi ghɔŋbə bʉəyʉkəŋgieNyii. <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />Mɔ bɔŋ-kə́-leʼ yʉ́əʼnə ndəŋ Nyii, haʼ ndə bʉə-bɔ̄ŋ nə mbəŋ-yʉə bɛ́ŋ ghɔ mbɔ bʉə ndə bɔ̂ŋ bɛ ndyʉndyʉ ghɔŋbə bʉə ndə bɔ̂ŋ gòʼ təmə bɛ ndyʉndyʉ fɛ, bu nə bʉ̀nə kóʼ. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />Nɔ, m̃ɔ nɔ kɔ̀ɔtə shʉ́əshʉ́ə ndə mənyíɛ mbɔ ŋkwɔʼtə-ɔŋ chʉʼ bɛ itʉ́ʉnə bəshʉ-Nyii ghɔŋbə bʉəməsʉʉ.<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />“Ndʉʉ ndə mɔ kə lɔ̀ hə Jɛlosalɛŋ, gɛ̀ chí ŋgʉʼhə buŋmbi, mɔ bʉ̀nə gwè nə kɔkə tʉ bʉə-mbʉʼ mu lɔʼɔ-baʼa bɔŋleʼ kɔ́ kɔ-fɛ̀ʼndɛŋ-kə tʉ Nyii. <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />Ndə mɔ kə́ chìi yɔ̄ŋ-yə, bɔ̂ŋ nyíɛ mɔ, tʉ mɔ nɔʼ búu ŋwɔŋ-ɔŋ mu chunjaafɛ̀ʼndɛŋNyii təmə kə́ bɛ chɔ baʼa wo fɛ, təmə kə́ byùutə yəŋbə fɛ. Bɔŋ bʉə-Juubɛʼbə nɔ kə bɛ ghɔ ndə bɔ̂ŋ lɔ̀ hə Esia, ndə bɔ̂ŋ kə bɛ chɔ, <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />kaʼ bɔ̂ŋ bɛ fɛ̄ŋ, kie nukə te mɔ, təmə bɔ̂ŋ nɔ fʉ̀ʼtə tʉ a nə mbəŋ-yʉə. <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />Byuunɔ, b̈ʉə-bɔ̄ŋ ndə bɔ̂ŋ bɛ fɛ̄ŋ nɔ gìe nu-bʉəbʉə-kə ndə mɔ kə chìi ndʉʉ ndə mɔ kə tə́nə bəshʉ kaŋsotəkwɛʼtəŋ, <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />tə tíŋ yɔ̄ŋ-yə mbyu kənu ndə mɔ kə́ tíi nə ghʉəʼkə mbɔ, ‘Mɔ nɔ tə́nə fɛ̄ŋ mu njaafɛ̀ʼ nɔ bʉʼka mɔ nɔ bɛ́ŋ mbɔ bʉə ndə bɔ̂ŋ nɔʼ kwú bu yi bʉ̀nə kóʼ.’ ”<verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />Bɔŋ Fɛli ndə ɔ kə kínə nubə jyujyu te mbʉ Fia-Nyii, tʉ́ʼ mbʉ fɛʼɛ, ghɔ̀ŋ mbɔ, “Lisia ntəŋbəshʉ-bʉəkwɛʼtəŋ-bəsɔge kʉ̂ʉ gwè nɔ, mɔ chʉ̀ə fɛʼɛ-a.” <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />Ndʉʉmɛ, ɔ téʼ tʉ mbʉ wokwɛʼtəŋ-bəsɔge ndə məfʉ̀əŋ ɔŋ bɔŋ kɔ́ saa tʉ ɔŋ ndə mə-kə́-chìi nubə-i, kə a məbyùutə bətieŋkɔŋ-bi ndə mə-kə́-kɔ́ fɔbə tʉ ɔŋ fɛ.<verse eid="ACT 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />Chîbə kʉ̂ʉ tíŋ, Fɛli gwè ghɔŋ vi-i Dolosila kə́ bɛ woke-Juu, ɔ tə́ŋ tíi Bɔɔ mbɔ ɔ gwè, ɔ̈ yʉ́ hə kəghɔ-ɔ te nə məmɔ̀ʼfyii ndəŋ Klai Jiso. <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />Ndə Bɔɔ tʉʼ kwə́ʼ tʉ ɔŋ te nə mə bɛ ndyʉndyʉ, məyá-ŋwɔŋ leʼnə chîkə ndə Nyii bu sɔ́ʼ wʉʉnəmbikə chɔ, Fɛli gwònə ghɔ̀ŋ mbɔ, “Gɛ̀ nə aŋ nduɔ, mɔ bu yi fʉ̀ʼ ŋgwɔʼmbi nɔ, tíi a.” <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />Haʼ ndʉʉmɛ, ɔ kə́ yʉ́əʼnə ndəŋ Bɔɔ mbɔ ɔ bu kɔ́ kyʉə tʉ ɔŋ. Ɔ kə́ chʉʼ tíi ɔ ghɔ́ŋ ɔŋ kə́ kwə́ʼ. <verse eid="ACT 24:26" /><verse number="27" style="v" sid="ACT 24:27" />Ŋgʉʼhə ibûu kʉ̂ʉ tíŋ, Bosiu Fɛsto yú yəŋ-Fɛli-kə. Bɔŋ bʉʼka ɔ kə́ kʉ́ʉ ndə mədʉ̀ʼ buuŋjyu tʉ bəntəŋbəshʉ-bʉə-Juu, Fɛli mɛ̀ʼtə Bɔɔ mu njaa-chaŋ.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">Bɔɔ tə́nə bəshʉ Fɛsto</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />Chîbə kʉ̂ʉ tíŋ itia ndə Fɛsto gɛ̀ dàa mu mbʉ bie, ɔ lɔ̀ hə Kasalia kóʼ gwè Jɛlosalɛŋ. <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />Bətiefɛ̀ʼndɛŋNyii ghɔŋbə bʉəkwɛʼtəŋ-Juu gwè kwə́ʼ tʉ ɔŋ te Bɔɔ, kə́ kwèʼhə ɔŋ, <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />kə́ fʉ̀ʉtə Fɛsto mbɔ ɔ̈ dʉ̀ʼ buuŋjyu tʉ bɔŋ, tə́ŋ Bɔɔ kɔ́ Jɛlosalɛŋ, bʉʼka bɔ̂ŋ nɔʼ kə shʉ̀tə ndə məyí ɔ sêfia. <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />Fɛsto bə̀ŋhə mbɔ Bɔɔ la káa Kasalia, mbəŋ-ɔŋ bɔŋ bɛ ndə məgwè chɔ kʉʉkə məniʼ. <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />Ndʉʉmɛ, ɔ ghɔ̀ŋ mbɔ, “Bʉəkwɛʼtəŋ ndə bɔ̂ŋ bɛ mu bii, b̈aʼa bɔŋ shíʼ gɛ̀ chɔ. Kaʼ nu-bʉə-kə bɛ ghɔ ndə ɔ nɔʼ chìi, b̈ɔ̂ŋ gìe.”<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />Ɔ chí chɔ tə i kə́ gɛ̀ nə chîbə fɔ̂ŋ byuunɔ chîbə wuŋ, ɔ lɔ̀ gɛ̀ Kasalia. Mbi kʉ̂ʉ sɛŋ fíi, ɔ dùʼ mu njaafɛ̀ʼ, kàhə mbɔ b̈ə la gwè nə Bɔɔ. <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />Ndʉʉ ndə ɔ gwè dàa, mbʉ bəntəŋbəshʉ-bʉə-Juu ndə bɔ̂ŋ shíʼ gwè hə Jɛlosalɛŋ, tə́ŋtə yə̀ŋhə ɔŋ, kə́ fyìʼ mbi kətʉ Bɔɔ təmə bɔ̂ŋ mə dʉ̀ʼ bə nyíɛ mbɔ bɛ shʉəŋ fɛ. <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />Bɔɔ túŋ bəŋʉʉ ndə mətúunə tʉkə-i kə́ ghɔ̀ŋ mbɔ, “Mɔ chʉʼ mɔ̀ʼ nuʼ-bʉə-Juu bɛ́ fɛ, təmə nɔʼ chìi bʉ̂ʼʉ ndəŋ njaafɛ̀ʼndɛŋNyii mɔ̀ʼ bɛ́ fɛ, təkɔmə Fɔŋ-Luŋ.”<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />Bɔŋ bʉʼka Fɛsto kə́ kʉ́ʉ ndə mədʉ̀ʼ buuŋjyu tʉ bʉə-Juu, ɔ bíʼtə tʉ Bɔɔ mbɔ, “A kʉ̀ʉ ndə məkóʼ gɛ̀ Jɛlosalɛŋ gɛ̀ bə kwɛ̀ fɛʼɛ-a ndə nubə-ɔ̄ŋ ndə bə gìe kətʉ-a nɔ bəshʉ mɔ mɛ?”<verse eid="ACT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10" />Bɔŋ Bɔɔ bə̀ŋhə mbɔ, “Mɔ nɔ tə́nə mu njaafɛ̀ʼ-Fɔŋ-Luŋ kəyəŋ ndə mɔ kie ndə məkwɛ̀ fɛʼɛ-ɔ chɔ. Mɔ chʉʼ chìi nu-bʉəbʉəbɛʼ-kə tʉ bʉə-Juu fɛ, mbəŋ-aŋ nɔ kínə jyujyu. <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />Kaʼ mɔ nɔʼ chìi nu-bʉəbʉə-kə ndə bəkɔ bə yí mɔ bʉʼka yɔŋ, mɔ tʉʼ tɛ́ŋ kwu fɛ. Bɔŋ kaʼ bɛ mbɔ nubə ndə bɔ̂ŋ tʉʼ gìe kətʉ-mɔ gòʼ təmə bɛ shʉəŋ fɛ, təmə wo mə byʉ̀hə mɔ kɔ́ kəghɔ-bɔŋ fɛ. Mɔ nɔ tʉʼ fʉ̀ʉtə mbɔ fɛʼɛ-ɔ̄ gɛ̀ tʉ Fɔŋ-Luŋ.”<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />Fɛsto kʉ̂ʉ jìʼtə ghɔŋbə bʉə-kaŋsotə-bi, bə̀ŋhə mbɔ, “Bʉʼka a tʉʼ fʉ̀ʉtə mbɔ f̈ɛʼɛ-a gɛ̀ tʉ Fɔŋ-Luŋ, bə bu gɛ̀ nə aŋ tʉ Fɔŋ-Luŋ.”<verse eid="ACT 25:12" /></para>
  <para style="s">Bɔɔ nduɔ bəshʉ Fɔŋ Agliba ghɔŋ Bɛni</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />Chîbə kʉ̂ʉ nɔʼ tíŋ, Fɔŋ Agliba ghɔŋ Bɛni gɛ̀ dàa Kasalia, gɛ̀ gìe tʉ Fɛsto. <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />Bɔ̂ŋ chí chɔ ndə chîbə yɔ́ŋyɔ́ŋ, Fɛsto lʉ̀ fɛʼɛ-Bɔɔ fʉ̀ʼtə tʉ mbʉ Fɔŋ, ghɔ̀ŋ mbɔ, “Wobɛʼ nɔ nə bɛ ghɔ ndə Fɛli kə fʉ̀əŋ ɔŋ chaŋ, <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />mɔ kʉ̂ʉ kə tòʼ dàa Jɛlosalɛŋ, bətiefɛ̀ʼndɛŋNyii ghɔŋbə bəntəŋbəshʉ-bʉə-Juu mɔ̀ʼ nubə sê ndə bɔ̂ŋ kie tʉ ɔŋ, kə́ fʉ̀ʉtə mɔ mbɔ m̈ɔ la chʉ̀ə ŋkwɛ mbɔ ɔ la nɔʼ gwù fɛʼɛ. <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />Mɔ ghɔ̀ŋ tʉ bɔŋ mbɔ la kaa nuʼ-bʉə-Luŋ ndə məchʉ̀ə fɛʼɛ wo mbɔ ɔ nɔʼ gwù ɔ buŋ fə́nə ghɔŋ wo ndə ɔ gwè nə nɔŋ mu njaafɛ̀ʼ bə kɔ́ saa tʉ ɔŋ ndə túu chu-i fɛ.<verse eid="ACT 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 25:17" />“Ndʉʉ ndə bɔ̂ŋ kə chə̀ŋtə fɛ̄ŋ, təmə mɔ kwìhə fɛ, bɔŋ mbi kʉ̂ʉ sɛŋ fíi, mɔ gɛ̀ dùʼ ndəŋ kʉəkə-ɔŋ mu njaafɛ̀ʼ kàhə mbɔ b̈ə téʼ ɔ gwè mu njaa. <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />Ndʉʉ ndə bʉə ndə bɔ̂ŋ kie nukə te ɔ lɔ̀ hə sê tə́nə ndə məkwə́ʼ, təmə mɔ yʉ́ bɔ̂ŋ gìe ntɛ-kənu bʉ̂ʼʉ ndə mɔ kə́ kwɔ̀ʼtə mbɔ ɔ kə chìi fɛ. <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />Bɔŋ bɔ̂ŋ buŋ leʼ kə́ gìe nubə te bɛ ntɛ ndə bɔ̂ŋ lə̀ʼtə Nyii-yʉə leʼnə Jisobɛʼ ndə ɔ nɔʼ kə́ kwú, bɔŋ ndə Bɔɔ ghɔ̀ŋ mbɔ ɔ bíe mbi. <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />I chàa mɔ ndə ntɛ ndə bəkɔ mɔ tyúutə mbiʼtə-ɔ̄ŋ, mɔ bíʼtə tʉ ɔŋ mbɔ ɔ kʉ̀ʉ ndə məgɛ̀ Jɛlosalɛŋ bə kwɛ̀ fɛʼɛ-ɛ chɔ te nubə-ɔ̄ŋ mɛɛ. <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />Bɔŋ ndʉʉ ndə Bɔɔ fʉ̀ʉtə mbɔ b̈ə gɛ̀ nə fɛʼɛ-ɛ bəshʉ, mɔ kàhə mbɔ b̈ə yá ɔ tʉ́ʼ tə mɔ yi tə́ŋ ɔŋ kɔ́ tʉ Fɔŋ-Luŋ.”<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />Ndʉʉmɛ, Agliba ghɔ̀ŋ tʉ Fɛsto mbɔ, “Mɔ bu kʉ̀ʉ ndə məyʉ́ hə chu mbʉ wo-ghɔ̄ nə mbəŋ-ɔŋ.”</para>
  <para style="p" vid="ACT 25:22">Fɛsto bə̀ŋhə mbɔ, “Yɔ̂ŋ, a bu yʉ́ hə kəghɔ-ɔ.”<verse eid="ACT 25:22" /></para>
  <para style="s">Bɔɔ kwə́ʼ tʉ Agliba</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />Mbi kʉ̂ʉ sɛŋ fíi, Agliba ghɔŋ Bɛni gwè nə kuŋkwɛʼtəŋhə mbʉə-bɔŋ, gwè ŋíi mu njaa-nchəŋtəkwɛʼtəŋ ghɔŋbə bəntəŋbəshʉ-bʉəkwɛʼtəŋ-bəsɔge leʼnə bʉəkwɛʼtəŋ mu mbʉ kəyəŋkwɛʼtəŋ. Ndʉʉmɛ, Fɛsto kàhə b̈ə gwè nə Bɔɔ mu njaa. <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />Fɛsto ghɔ̀ŋ mbɔ, “Fɔŋ Agliba ghɔŋbə bʉə bənchəŋ ndə bɔ̂ŋ bɛ fɛ̄ŋ, nɔ wo nɔ ndə bʉə-Juu bənchəŋ mu Jɛlosalɛŋ leʼnə fɛ̄ŋ fʉ̀ʉtə mɔ te ɔ, kə́ tíitə mbɔ ɔ la kie ndə mə-kə́-chí mbi fɛ. <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />Bɔŋ mɔ nyíɛ nu-bʉəbʉə-kə ndə ɔ nɔʼ chìi tə bəkɔ bə yí ɔ fɛ. Ndə mbəŋ-ɛŋ kə fʉ̀ʉtə mbɔ b̈ə gɛ̀ nə fɛʼɛ-ɛ tʉ Fɔŋ-Luŋ, mɔ gɛ̀ nə shʉbə ndə mətə́ŋ ɔŋ kɔ́ tʉ ɔŋ, <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />bɔŋ təmə kie ŋkɛŋ kənu ndə mənyɔ̀ʼ tʉ tie-ɔ te ɔ fɛ. Nɔ chìi yɔŋ-yə, mɔ gwè nə nɔŋ bəshʉ bii bənchəŋ, kɛŋ tʉ mbəŋ-aŋ, Fɔŋ Agliba, mbɔ ndʉʉ ndə bʉʼʉ bu tyúutə ɔŋ nɔ, mɔ chʉʼ kie nukə ndə mənyɔ̀ʼ. <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />Bʉʼka i nɔ bɛ nə nu-bənɔ̌ʼɔ-kə tʉ mɔ ndə mətə́ŋ wo hə njaa-chaŋ kɔ́ tʉ Fɔŋ-Luŋ, təmə gìe nukə ndə ɔ chìi fɛ.”<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">Bɔɔ túu chu-i bəshʉ Fɔŋ Agliba</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />Ndʉʉmɛ, Agliba ghɔ̀ŋ tʉ Bɔɔ mbɔ, “Bəkɔ a kwə́ʼ nə mbəŋ-aŋ.” Ndʉʉmɛ, Bɔɔ mɔ̀ʼ ghɔkə-i túu chu-i ghɔ̀ŋ mbɔ, <verse eid="ACT 26:1" /><verse number="2" style="v" sid="ACT 26:2" />“Tʉʉ-ɔ nɔ bʉ̀ʉ ndə mɔ tə́nə bəshʉ a, Fɔŋ Agliba, mɔ nɔ bu túu chu-ɔ laa tʉ a te nubə inchəŋ ndə bəntəŋbəshʉ-bʉə-Juu tʉʼ gìe kətʉ-mɔ. <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />Bʉʼka mɔ nɔ kínə mbɔ a nɔ kínə jyujyu te mbʉ nuʼ-bʉə-Juu inchəŋ leʼnə bəŋʉʉ ndə bʉə-Juu kie. Nɔʼ m̈ɔ tíŋ hə bɔ̌ŋ ghɔ, fʉ̀ʉtə a mbɔ ä yá fyii-a yʉ́ kwəʼ-ɔ.<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />“Ŋkoʼnə sê-ɔ lʉ̀ hə vaambuɔ, ndə mɔ chʉ́ʉhə nə yɔŋ mu lɔʼɔ-baʼa tə gɛ̀ dàa mu Jɛlosalɛŋ, bəntəŋbəshʉ-bʉə-Juu bənchəŋ nɔ kínə. <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />Bɔ̂ŋ nɔʼ kə kínə mɔ lʉ̀ hə mbibɛʼ, kaʼ bɔ̂ŋ kʉ̀ʉ, bəkɔ bɔ̂ŋ fʉ̀ʼtə mbɔ, ndə nuɔ-bʉə ndə bɔ̂ŋ tʉ́ʼ nuʼ-Nyii jyujyu, mɔ nɔ bɛ nuɔ-ghɔ̄, kə́ bɛ bʉə-Falasi. <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />Nduɔ, mɔ nɔ tə́nə fɛ̄ŋ kə́ túu chu-ɔ bʉʼka mɔ nɔ yʉ́əʼnə ndəŋ nukə ndə Nyii kə kɔ̀ʼnə tʉ bətie-baʼa, <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />ndə lɔŋ-lɔʼɔ-bə-aʼ njuɔ bûu nə wuŋ kə́ gháaNyii ndʉʉnəchî ghɔŋbə ndʉʉbətyuʼ, kə́ yʉ́əʼnə ndəŋ ɔŋ ndə mə-nə-sɛŋ nyíɛ ndə i bu fyú shʉəŋ. Bʉə-Juu nɔ tʉʼ yá nubə-ɔ̄ŋ kətʉ-mɔ nɔ bʉʼka ndə mɔ yʉ́əʼnə ndəŋ nubə-ɔ̄ŋ, Oo Fɔŋ! <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />Chìi ka təmə wo mu bii mə bɛ́ŋ mu fyii-ɔ mbɔ bəkɔ Nyii bʉ̀nə kóʼhə wo ndə ɔ nɔʼ kwú fɛ?<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />“Mbəŋ-ɔŋ, nə mbəŋ-ɔŋ nɔ nə kwɔ̀ʼtə mbɔ mɔ kə kie ndə məfyúhə ghʉəʼkə-ɔŋ ndə məbyùutə yie-Jiso ndə ɔ lɔ̀ hə Nasalɛ. <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />Mɔ nɔ nə fɔ̀ʼ nɔ mu Jɛlosalɛŋ. Kaa haʼ mbɔ mɔ kə fʉ̀əŋ bʉə-Nyii ndʉʉ ndə mɔ kə fí ŋwɔʼnə hə kəghɔ-bətiefɛ̀ʼndɛŋNyii fɛ, bɔŋ ndʉʉ ndə bə kə́ yítə bɔŋ, ghɔkə-ɔŋ nɔ kə bɛ chɔ. <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />Mɔ kə́ kɔ́ ŋgʉəʼ tʉ bɔŋ təvɛʼtəvɛʼ mu-njaagháaNyii-hə inchəŋ bɔŋleʼ kə́ kɔ̀ɔtə ndə məchìi bɔ̂ŋ bʉ́əhə yie Nyii. Mɔ nɔ kə kie tʉʉbʉə tʉ bɔŋ daa, chɔ́ŋhə bɔŋ tə buŋ gɛ̀ hə bɔ̌ŋ bɔŋ mu yəŋkwɛʼtəŋ-bədɔŋ-bə.<verse eid="ACT 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />“Nɔ luu-i nɔ ndə mɔ kə fyú fia Damasiko, mɔ nɔʼ kə fí hə ghʉəʼkə kəghɔ-bətiefɛ̀ʼndɛŋNyii, bɔ̂ŋ kɔ́ fia mbɔ m̈ɔ gɛ̀. <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />Kʉ̂ʉ bɛ ndʉʉbeʼ, Oo Fɔŋ, mɔ nyíɛ kɛʼɛ sêfia ndə i báa hə yuo, báa chàa chichi, ndə i báa yə̀ŋhə mɔ baʼabə bʉə ndə baʼa bɔŋ kə́ tòʼ mɔʼɔ. <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />Ndʉʉ ndə baʼa bənchəŋ gwùtə sê, mɔ yʉ́ gyʉʉ ndə i gìe tʉ mɔ kəŋgie Hibulu mbɔ, <char style="wj">‘Sɔɔ, Sɔɔ, a tʉʼ chɔ́ŋhə mɔ mbuka? A mə sʉ́ʉhə ghɔkə-a mu viʼi fɛ.’</char> <note caller="+" style="f"><char style="fr" closed="false">26:14 </char><char style="ft" closed="false">Jiso nɔ nə ghɔ̀ŋ yɔ̄ŋ-yə tʉ Bɔɔ mbɔ kaʼ ɔ tɛ́ŋ nu-fefe-kə ndə ɔ tʉʼ gwè nə yɔŋ təmə i bu lə́ŋhə bə mbəŋ-ɛŋ, Bɔɔ.</char></note><verse eid="ACT 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 26:15" />“Mɔ bíʼtə mbɔ, ‘A buŋ bɛ nda lɔɔŋ, Tiekətʉ?’</para>
  <para style="p" vid="ACT 26:15">“Mbʉ Tiekətʉ bə̀ŋhə mbɔ, <char style="wj">‘Mɔ nɔ bɛ Jiso ndə a tʉʼ chɔ́ŋhə ɔŋ.</char> <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" /><char style="wj">Lɔ̀ hə sê tə́nə təfʉəŋ-aŋ bʉʼka mɔ nɔ kɛ̀ʼ ŋwɔŋ-ɔŋ tʉ a mbɔ mɔ chʉʼ dùʼhə a ndəŋ vaantie-ɔ leʼnə wo ndə ɔ bu nú gwù bənu ndə a nɔʼ nyíɛ kəghɔ-mɔ leʼnə bibə ndə mɔ bíe ndə məkɛ̀ʼ tʉ a.</char> <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" /><char style="wj">Mɔ bu shyùu a fí hə kəghɔ-bʉə-ba ghɔŋbə bʉə ndə gòʼ təmə bɛ bʉə-Juu fɛ, ndə mɔ bu tə́ŋ aŋ tʉ bɔŋ.</char> <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" /><char style="wj">A bu ŋɔ́ʼhə shʉtə-ʉə, mbɔ bɔ̂ŋ chʉʼ shìe liɛŋtə-ʉə hə ndə njəŋkə gwè ndə mbi súunə, hə ndə ghʉəʼ-Sata-kə gwè tʉ Nyii, bə chʉʼ sʉ̀fyii hə ndəŋ bʉ̂ʼtə-ʉə, bɔŋleʼ kie yəŋkə mu bʉə ndə bə nɔʼ sʉ̀ bɔ̂ŋ bʉʼka bɔ̂ŋ mɔ̀ʼfyiihə-ʉə ndəŋ mɔ.’</char><verse eid="ACT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />“Ndə nɔ, Oo Fɔŋ Agliba, mɔ kə kwɛ̀ŋhəkwɛ̀ŋhə ndə nukə ndə mɔ nyíɛ bəshʉ-Nyii fɛ. <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />Mɔ fəŋ lɔ̀ʼ mbʉ ntəŋ tʉ bʉə-Damasiko, leʼnə bʉə-Jɛlosalɛŋ ghɔŋbə bʉə bənchəŋ ndə bɔ̂ŋ bɛ mu bie Judia leʼnə bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu ghɔ fɛ, mbɔ bɔ̂ŋ la shìe liɛŋtə-ʉə hə ndəŋ bʉ̂ʼʉ, bʉ̀nə gwè tʉ Nyii, kə́ fɔ̀ʼ nubə ndə i dʉ̀ʼ mbɔ bɔ̂ŋ nɔʼ shìe liɛŋtə-ʉə hə ndə bʉ̂ʼʉ. <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />Nɔ nukə nɔ ndə i chìi bʉə-Juu yá mɔ mu chunjaafɛ̀ʼndɛŋNyii, kə́ kʉ́ʉ yí mɔ. <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />Tə gwè dàa laa-ɔ̄ nɔ, nɔ tʉʼ kwáa Nyii kwáa mɔ, mɔ kə́ tə́nə fɛ̄ŋ kə́ fʉ̀ʼtə tʉ vâa-fɔŋ ghɔŋbə vâaŋgwehə təmə kə́ gìe nu-kədɔŋ-kə fɛ, yaʼkɛŋ nukə ndə bʉəyʉkəŋgieNyii ghɔŋbə Mushi kə ghɔ̀ŋ mbɔ i bu nə gwè, <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />mbɔ mbʉ Wo ndə Nyii Kùŋ Tə́ŋ bu yaʼ nyíɛ ŋgʉəʼ bɔŋ bʉʼka ɔ leʼ bɛ fəŋ wo ndə ɔ bʉ̀nə kóʼ hə ndəŋ kwu, ɔ bu lɔ̀ʼ ntəŋ te kɛʼɛ tʉ bʉə-baʼa ghɔŋbə bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ.”<verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />Ndə ɔ kə́ túu chu-i gìe nubə-ɔ̄ŋ, Fɛsto tíi nə ghʉəʼkə ghɔ̀ŋ mbɔ, “Bɔɔ, a nɔʼ bɛ́ ndaa-a, ŋwɔʼnə yɔ́ŋyɔ́ŋ nɔʼ lʉ̀ ndaahə-a gɛ̀ nə yɔŋ.”<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />Bɔŋ Bɔɔ ghɔ̀ŋ mbɔ, “Mɔ chʉʼ bɛ́ ndaahə-ɔŋ fɛ, tie-ɔ Fɛsto, mɔ nɔ tʉʼ kwə́ʼ shʉəŋ-ɔŋ nə mukətʉ súunə. <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />Nɔ bɛ bʉʼka mbʉ Fɔŋ nɔ kínə nubə-ɔ̄ŋ ndə mɔ tə́nə bəshʉ ɔ kə́ kwə́ʼ nə fyii shʉ́əshʉ́ə nɔ. Bʉʼka mɔ nɔ kínə jyujyu mbɔ mbyu kənu-ɔ̄ŋ bɛ ghɔ ndə ɔ gòʼ təmə kínə fɛ, bʉʼka mɔ kə chìi nubə-ɔ̄ŋ mu bəliinə fɛ. <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />Fɔŋ Agliba, a bɛ́ŋ nukə ndə bʉəyʉkəŋgieNyii kə ghɔ̀ŋ mɛ? Mɔ nɔ kínə mbɔ a nɔ bɛ́ŋ.”<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />Ndʉʉmɛ, Agliba bə̀ŋhə tʉ Bɔɔ mbɔ, “Haʼ ndə vaa kəkʉʉ mbi-ɔ̄, a bu lóʼtə mɔ, mɔ bə̀ŋ Kʉlʉtɛŋ mɛ?”<verse eid="ACT 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29" />Bɔɔ bə̀ŋhə mbɔ, “Kə bɛ haʼ nduɔ, kə bɛ yɔŋbɛʼ, mɔ nɔ tʉʼ gháaNyii mbɔ mə bɛ haʼ mbəŋ-aŋ fɛ, bɔŋ mbɔ bʉə bənchəŋ ndə bɔ̂ŋ tʉʼ yʉ́ mɔ, b̈ɔ̂ŋ bɛ haʼ ndə mɔ, tə shi káa haʼ bəchaŋ-bɔ̄ŋ ndə bə fʉ̀əŋ mɔ nə yɔŋ nɔ.”<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />Ndʉʉmɛ, mbʉ Fɔŋ dyìnə kəyetə, ghɔŋbə mbʉ gɔməna ghɔŋ Bɛni leʼnə bʉə ndə ghɔŋ bɔŋ kə dùʼ mɔʼɔ. <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />Ndʉʉ ndə bɔ̂ŋ kə fí ŋwɔŋ-yʉə bɔ̌ŋ, bɔ̂ŋ kə́ kwə́ʼ tʉ mbəŋtə-ʉə mbɔ, “Wo-ɔ̄ chʉʼ chìi nukə ndə bəkɔ bə yí ɔ chɔ byuunɔ fʉ̀əŋ ɔŋ chaŋ bʉʼka yɔŋ-yə fɛ.” <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />Ndʉʉmɛ, Agliba gìe tʉ Fɛsto mbɔ, “Bə nɔ kə kə́ kʉ̌ʉ nɔʼ kə yɔ̀ʼ ghɔkə ndəŋ wo-ɔ̄, kaʼ ɔ kʉ̌ʉ gòʼ təmə nɔʼ kə fʉ̀ʉtə mbɔ b̈ə lʉ̀ fɛʼɛ-ɛ tʉ Fɔŋ-Luŋ fɛ.”<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">Bɔɔ té buukwɛʼtəŋkə gɛ̀ Luŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />Ndʉʉ ndə bə shʉ̀tə mbɔ b̈aʼa ŋíi mu kəbuukwɛʼtəŋ gɛ̀ Itali, bə chɔ̀ʼhə Bɔɔ ghɔŋbə bəbɛʼbʉə njaa-chaŋ kɔ́ mu kəghɔ-Juliɔ ndə ɔ bɛ wokwɛʼtəŋ-bəsɔge ghyʉʉ, kə́ fɔ̀ʼ ndə nuɔ-bəsɔge-Fɔŋ-Luŋ. <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />Baʼa kóʼ mu buukwɛʼtəŋkə ndə i lɔ̀ hə Adalamituŋ ndə i kie ndə mətə́nə chʉʉ-kəbuukwɛʼtəŋ-tə ndə i bɛ ŋgwuu-muu-Esia, ndə baʼa kə kóʼ mu mbʉ kəbuukwɛʼtəŋ, baʼabə wobɛʼ ndə bə kə́ tíi ɔ nə Alistaku kə́ bɛ wo Masɛdonia ndə ɔ lɔ̀ hə Tɛsalonika, <verse eid="ACT 27:2" /><verse number="3" style="v" sid="ACT 27:3" />baʼa té buukwɛʼtəŋkə, mbi kʉ̂ʉ sɛŋ kə́ fíi, baʼa shùɔ Sidɔŋ. Juliɔ dʉ̀ʼ buuŋjyu tʉ Bɔɔ, mɛ̀ʼtə ɔŋ mbɔ ɔ̈ gɛ̀ nyíɛ bətieŋkɔŋ-bi bɔ̂ŋ chʉʼ kɔ́ fɔbə tʉ ɔŋ ndə ɔ tʉʼ byúu. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />Baʼa ŋíi mu muukwɛʼtəŋmə té gɛ̀ mbʉə kwɔŋ Siblɔ, kəyəŋ ndə fʉʉkə shʉ́ə chɔ fɛ, bʉʼka mbʉ kəfʉʉ nɔ kə́ bə̀ŋhə baʼa. <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />Ndʉʉ ndə baʼa té tɔ̀ɔnə mbʉ muukwɛʼtəŋmə tíŋ ŋgwuu-muu-Silisia ghɔŋ Baŋfilia, baʼa gwè dàa Mila ndə i bɛ mu Lisia. <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />Mbʉ wokwɛʼtəŋ-bəsɔge nyíɛ buukwɛʼtəŋkə ndə i lɔ̀ hə Alɛsaŋndia kə́ gɛ̀ Itali, ɔ sʉ́ʉhə baʼa muŋgɔ.<verse eid="ACT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7" />Baʼa kə́ té buɔbuɔ tə i kə́ gɛ̀ chîbə, baʼa kɔ̀ɔtəkɔ̀ɔtə buŋ dàa Kinidu. Bʉʼka fʉʉkə kə́ mɛ̀ʼtə mbɔ b̈aʼa gɛ̀ nə shʉbə fɛ, baʼa bìa gɛ̀ hə mbʉə kwɔŋ Klit, kəyəŋ ndə fʉʉkə kə shʉ́ə chɔ fɛ, gɛ̀ tíŋ hə kəyəŋ ndə bə kə́ tíi nə Samɔni. <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />Baʼa kɔ̀ɔtəkɔ̀ɔtə tíŋ hə ŋgwuu-muu chɔ, gɛ̀ dàa kəyəŋbɛʼ ndə bə shùɔ buukwɛʼtəŋkə chɔ təmə kə́ fàa fɛ. Bə kə́ tíi nə Chʉʉkəbuu Yùtə, ndə i kə́ŋhə mbʉə Lasia ndə bɛ yəŋkwɛʼtəŋkə. <verse eid="ACT 27:8" /><verse number="9" style="v" sid="ACT 27:9" />Bʉʼka ŋgwɔʼmbi nɔʼ kə gɛ̀, mbʉ fia bìʼ shʉ́ə daa, buŋ ndə nɔ mbʉ kəChî Jì Muukwɛʼtəŋ<note caller="+" style="f"><char style="fr" closed="false">27:9 </char><char style="ft" closed="false">Chîkə-ɔ̄ŋ nɔ nə kə́ bɛ mu ŋgʉʼʉmbibɛʼ nɔ, i gwù liʼ chi Bəŋchi byuunɔ ndə nchʉʉhə chi Kʉʼkəbyii ndʉʉ ndə mbi nɔʼ byʉ́ʼ ndə mətòʼ mu muu.</char></note> nɔʼ kə tíŋ ghɔ, Bɔɔ mɔ̀ʼ tʉ̂ʼ tʉ bɔŋ, <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />ghɔ̀ŋ mbɔ, “Bətie-bɔŋ, mɔ nɔ tʉʼ nyíɛ mbɔ toʼo-ɔ̄ nɔ bu kɔ́ ləŋtə tʉ bʉʼʉ ghɔŋbə bɛ́ yɔ́ŋyɔ́ŋ daa, kaa haʼ fɔbə ghɔŋbə mbʉ kəbuukwɛʼtəŋ ndə i bu bɛ́ fɛ, bɔŋ leʼnə məchimbi-yʉʼʉ ghɔ.” <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />Bɔŋ mbʉ wokwɛʼtəŋ-bəsɔge yʉ́ chu-mbʉ-wo-té-kəbuukwɛʼtəŋ ghɔŋbə wo ndə ɔ kie mbʉ kəbuukwɛʼtəŋ, chàa nukə ndə Bɔɔ tʉʼ gìe tʉ ɔŋ. <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />Bʉʼka mbʉ chʉʉ-kəbuukwɛʼtəŋ kə bɛ yʉʼ kəyəŋ ndə məbɛ chɔ mu shyʉʉ-fəʼə fɛ, bʉə buŋmbi lìʼ mbɔ b̈ə la gɛ̀ nə shʉbə, kə́ kwɔ̀ʼtə mbɔ bəkɔ bɔ̂ŋ kɔ̀ɔtə tə dàa Fɔni, kə́ bɛ chʉʉ-kəbuukwɛʼtəŋ ndə i bɛ Klit, bə̀ŋhə ntəŋntəŋ byûumbɔŋ ghɔŋ kwii ndə chichi sʉ́ʉ chɔ chusii-ɔ leʼnə ntəŋntəŋ byûukwe ghɔŋ kwii ndə chichi sʉ́ʉ chɔ mbɔ bɔ̂ŋ chʉʼ chí chɔ.<verse eid="ACT 27:12" /></para>
  <para style="s">Fʉ̂əŋ mu muukwɛʼtəŋmə</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />Ndʉʉ ndə fʉʉ-byûumbɔŋ-kə kə́ chʉ́ʉhə mətíŋ buɔbuɔ, bɔ̂ŋ kwɔ̀ʼtə mbɔ nukə ndə bɔ̂ŋ kə́ kwɔ̀ʼtə la bu kʉ̀ʼnə, bɔ̂ŋ chɔ̀ʼhə mbʉ kətəŋ ndə i yá buukwɛʼtəŋkə, kə́ té gɛ̀ mbʉə ŋgwuu-muu kəvia Klit. <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />Kʉʉkə məniʼ fʉ̂əŋ shʉ́əshʉ́ə ŋɛ̀nə ntəŋntəŋ byûukwe ghɔŋbə kwii ndə chichi sɔ́ʼ chɔ, shíʼ gwè hə njəŋmbi. <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />Ndʉʉ ndə i yá mbʉ kəbuukwɛʼtəŋ, təmə baʼa mə leʼ bə̀ŋhə mbʉ fʉ̂əŋ fɛ, baʼa ke ŋwɔŋ-yaʼ, i kə́ té baʼa gɛ̀ nə yɔŋ.<verse eid="ACT 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 27:16" />Ndə baʼa tʉʼ tíŋ hə tiɛŋ vaaŋkoʼbɛʼ ndə i bɛ mu mbʉ muu ndə bə kə́ tíi nə Kuda, ndə fʉʉkə kə shʉ́ə chɔ fɛ, baʼa kɔ̀ɔtəkɔ̀ɔtə buŋ kɔ́ʼtə vaakəbuu<note caller="+" style="f"><char style="fr" closed="false">27:16 </char><char style="ft" closed="false">Vâabəbuu nɔ nə bɛ vâabəbuu tîetîe ndə bə kə kɔ́ʼ bɔ̌ŋ kəbuukwɛʼtəŋ byuunɔ bə bɛ̀ʼ mu kəbuu. Bə kə shíʼ hə mu kəbuukwɛʼtəŋ nɔ tíŋ muŋgɔ byuunɔ kóʼ muŋgɔ ndʉʉ ndə bə tʉʼ kʉ́ʉ chyúu buukə kəmbia.</char></note> ndəŋ mbʉ kəbuukwɛʼtəŋ. <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />Ndʉʉ ndə baʼa chɔ̀ʼhə mbʉ vaakəbuu kɔ́ ghɔʼ, baʼa kɔ́ʼtə tiɛŋ mbʉ kəbuukwɛʼtəŋ nə ghyʉʉtə. Ndʉʉmɛ, bʉʼka bɔ̂ŋ kə́ fàa mbɔ i la bu gɛ̀ kóʼ ndəŋ yʉʉ-kəsɛ Sɛti, bɔ̂ŋ shúʼhə təŋkə ndə ĩ yá buukwɛʼtəŋkə mɔ̀ʼ muu, mɛ̀ʼtə mbɔ m̈bʉ fʉ̂əŋ kə́ bɛ̀ʼ gɛ̀ nə yɔŋ.<verse eid="ACT 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 27:18" />Bʉʼka mbʉ fʉ̂əŋ kə́ gháhə baʼa shʉ́əshʉ́ə kɔ́ bəviabəvia, mbi kʉ̂ʉ sɛŋ fíi, bɔ̂ŋ chʉ́ʉhə mətɛ́ʼtə bɛʼkə, mɛ̀ʼ mu muu. <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />Kʉ̂ʉ bɛ ndə chîbə itia, bɔ̂ŋ chɔ̀ʼhə fɔ-fɔʼɔ-mbʉ-mu-kəbuukwɛʼtəŋ-bə yíɛʼhə, mɛ̀ʼ mu muu. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />Ndə baʼa kə bɛ mu kəbuu ndə chîbə təmə baʼa mə nyíɛ chichi fɛ təkɔmə bəlɔʼɔ, mbʉ fʉ̂əŋ bìʼ shʉ́ə, təmə baʼa leʼ kə́ kwɔ̀ʼtə mbɔ baʼa bieleʼ bìi fɛ.<verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />Bʉʼka i nɔʼ kə chí dɔ̀ŋnə təmə b̈ɔ̂ŋ yú fɔbə fɛ, Bɔɔ lɔ̀ tə́nə mu bɔŋ ghɔ̀ŋ mbɔ, “Bəliŋ-bɔŋ, bii kʉ̌ʉ kə yʉ́ chu-ɔ təmə bʉʼʉ kə lɔ̀ hə Klit fɛ, təmə bʉʼʉ leʼ nyíɛ buŋmbi ŋgʉəʼ-ɔ̄ leʼnə bɛ́-ɔ̄ fɛ. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />Nduɔ, mɔ nɔ tʉʼ fʉ̀ʉtə bii mbɔ b̈ii yá fyiihə-ii, bʉʼka mbyu nyu kətʉ wo mu bii bu bɛ́ fɛ yaʼkɛŋ mbʉ kəbuukwɛʼtəŋ, <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />bʉʼka nɔ kə bɛ bətyuʼ-ɔ̄, wontəŋNyii ndə ɔ lɔ̀ hə bəshʉ-Nyii ndə mɔ bɛ yi-yə bɔŋ kə́ lə̀ʼtə ɔŋ, tə́nə bəshʉ mɔ, <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />gìe tʉ mɔ mbɔ, ‘Bɔɔ, kə a mə leʼ fàa fɛ. A bu yaʼ tə́nə bəshʉ Fɔŋ-Luŋ, Nyii bɔŋ-nɔʼ-leʼ kɔ́ bʉə-bɔ̄ŋ bənchəŋ mu kəbuukwɛʼtəŋ-fɛ̄ŋ nɔ mu kəghɔ-a.’ <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />Bəliŋ-bɔŋ, b̈ii yá fyiihə-ii bʉʼka mɔ nɔ mɔ̀ʼfyii-ɔ ndəŋ Nyii mbɔ nubə ndə ɔ gìe tʉ mɔ bu fyú shʉəŋ. <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />Bɔŋ bʉʼʉ bu nyʉ́ʉ kóʼ ndəŋ yʉʉ-kəsɛ mbʉə kwɔŋ ndə i bɛ ntəŋntəŋ muu.”<verse eid="ACT 27:26" /></para>
  <para style="s">Məkuunə-mbʉ-kəbuukwɛʼtəŋ</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />Kʉ̂ʉ bɛ nə ndʉʉkwɔnəmbi mu chîbə njuɔ kwii nə wuŋ ndə fʉ̂əŋ kə́ gháhə baʼa mu muukwɛʼtəŋ-Adala-mə, bʉə ndə bɔ̂ŋ kə́ té mbʉ kəbuu kwɔ̀ʼtə mbɔ bɔ̂ŋ la nɔʼ kə́ŋhə kwɔŋlɔʼ. <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />Ndʉʉmɛ, bɔ̂ŋ kɔ́ʼ ŋgoʼ nə ghyʉʉ, fʉ̀ʼ tyʉ mbʉ muu nə yɔŋ, nyíɛ mbɔ la bɛ bəghǔu wuŋ bûu. Kʉʉkə məniʼ, bɔ̂ŋ bìʼ mɔ̀ʼ mbʉ ghyʉʉ muu, nyíɛ mbɔ i la bɛ bəghǔu njuɔ taa nə wuŋ. <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />Bɔ̂ŋ chʉ́ʉhə kə́ fàa mbɔ bɔ̂ŋ la bu kóʼ ndəŋ ŋgoʼ, ndʉʉghɔfii, bɔ̂ŋ shúʼhə təŋkwɛʼtəŋbə kwi bɔ̌ŋ mbʉ kəbuukwɛʼtəŋ, mɔ̀ʼ mu muu ndə məyá mbʉ kəbuu tʉ́ʼ, kə́ gháaNyii mbɔ mbi chʉʼ fíi. <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />Ndə bʉə té mbʉ kəbuukwɛʼtəŋ kə́ kʉ́ʉ ndə mənyʉ́ʉ mɛ̀ʼ mbʉ kəbuu, bɔ̂ŋ fyúhə vaakəbuu mɔ̀ʼ mu muu, kə́ làhə shʉ mbɔ bɔ̂ŋ la tʉʼ kʉ́ʉ shúʼhə təŋkə mɔ̀ʼ ndə məyá mbʉ kəbuukwɛʼtəŋ bəshʉ chɔ tʉ́ʼ. <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />Bɔɔ gìe tʉ mbʉ wokwɛʼtəŋ-bəsɔge mbɔ, “Kaʼ bʉə té kəbuu-bɔ̄ŋ gòʼ təmə káa mu buukwɛʼtəŋkə-ɔ̄ŋ fɛ, bii kwútə bənchəŋ.” <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />Ndʉʉmɛ, mbʉ bəsɔge chʉ̀ə ghyʉʉ ndə i kə yá mbʉ vaakəbuu mɛ̀ʼtə i gɛ̀.<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />Kʉ̂ʉ bɛ ndʉʉ fíi mbi, Bɔɔ fʉ̀ʉtə bɔŋ mbɔ b̈ɔ̂ŋ la yú fɔkə, kə́ ghɔ̀ŋ mbɔ, “Laa nɔ bɛ chîbə njuɔ kwi nə wuŋ təmə fɔkə nyíɛ chu-yii fɛ. <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />Nduɔ, mɔ nɔ tʉʼ fʉ̀ʉtə bii mbɔ b̈ii yú fɔkə, bʉʼka i bu kɔ́ ghʉəʼkə tʉ bii, bɔŋ mbyu nyu kətʉ wo mu bii kʉʉ bɛ́ fɛ.” <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />Ndʉʉ ndə ɔ gìe nubə-ɔ̄ŋ liʼ, ɔ lʉ̀ bele kɔ́ ndɔ chɔ tʉ Nyii bəshʉ bʉə bənchəŋ, bə́ʼtə chʉ́ʉhə ndə məkwó. <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />Ndʉʉmɛ, tʉʉ-yʉə bʉ̀ʉ bənchəŋ, b̈ɔ̂ŋ yú fɔbə. <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />Baʼa nɔ nə bɛ mu mbʉ kəbuukwɛʼtəŋ bənchəŋ, bʉə təghyʉʉ təbuu nə bʉə njuɔ ntʉʼʉ nə wuŋ təkwiitia. <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />Ndʉʉ ndə bɔ̂ŋ nɔʼ yú tə yuo, bɔ̂ŋ chìi mbʉ kəbuu i yùhə ndə məfyúhə bəʼ-bəkwô-bəfɔyu-bə, mɛ̀ʼ muu.<verse eid="ACT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />Kʉ̂ʉ bɛ ndʉʉsɛŋkə, bɔ̂ŋ nyíɛ kwɔŋlɔʼ təmə bɔŋ chèʼnə mbʉ kəyəŋ fɛ, bɔŋ bɔ̂ŋ kʉ̂ʉ nyíɛ ŋgəŋkə ndə ŋgwuu-i shíʼ sê, kə́ shʉ̀tə mbɔ kaʼ i yùhə bɔ̂ŋ kíahə mbʉ kəbuukwɛʼtəŋ gɛ̀ shùɔ chɔ. <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />Ndʉʉmɛ, bɔ̂ŋ shúʼhə təŋkə ndə ĩ yá buukə tʉ́ʼ, mɔ̀ʼ muu. Haʼ ndʉʉmɛ, bɔ̂ŋ yɔ̀ʼ ghyʉʉtə ndə ĩ kɔ́ʼ fɔ-kíahə-mbʉ-kəbuukwɛʼtəŋ-kə. Bɔ̂ŋ leʼ chɔ̀ʼhə chʉəʼ-ndyi-kə ndə ĩ yá fʉʉkə kɔ́ ghɔʼ, fʉʉkə tʉ́ʉhə mbʉ kəbuu gɛ̀ shùɔ kəmbia. <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />Mbʉ kəbuu gɛ̀ kwɔ̀ŋ ndəŋ yʉʉ-kəsɛ, shʉbə-i lɔ́ʼtə sê bɔŋ bʉʼka lɛɛŋhə-muu-shʉ́əshʉ́ə-kə ndə i kə́ kwɔ̀ŋ mbʉ kəbuu, bɔ̌ŋ-bi bə́ʼnə.<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />Mbʉ bəsɔge kə́ shʉ̀tə ndə məyítə mbʉ bʉə-njaa-chaŋ bʉʼka wofuu məyíɛʼ muu nyʉ́ʉ gɛ̀ nə wi. <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />Bɔŋ mbʉ wokwɛʼtəŋ-bəsɔge kə́ kʉ́ʉ ndə məkwáa Bɔɔ, ɔ byùutə bɔ̂ŋ ndəŋ nukə ndə bɔ̂ŋ kə kwɔ̀ʼtə. Ɔ kàhə wotəmiyɔŋ ndə bəkɔ ɔ yíɛ́ʼ muu ndə mə-fəŋ-sɛ́ʼ fyú yíɛ́ʼ kóʼ mbi. <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />Bəʼkə lʉ́ʉ ndəŋ bəblaŋ byuunɔ ndəŋ via-mbʉ-kəbuukwɛʼtəŋ-bə. Nɔ bɛ nɔ ndə bɔ̂ŋ bənchəŋ kə kɔ̀ɔtə buŋ kóʼ njəŋmbi.<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">Bɔɔ ndəŋ kwɔŋ ntəŋntəŋ muu-Maləta</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />Ndʉʉ ndə baʼa kɔ̀ɔtə tə kóʼ kwɔŋlɔʼ ntəŋntəŋ muu, baʼa yʉ́ mbɔ baʼa la bɛ Maləta. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />Bʉə-lɔʼɔ-ghɔ̄bə dʉ̀ʼ ntɛ nuʼ jyujyu tʉ baʼa təmə baʼa nɔʼ nə nyíɛ fɛ, bɔ̂ŋ dyì viʼi chə̀ŋtə baʼa mbʉə ghɔ bənchəŋ, bʉʼka wyuu nɔ kə chʉ́ʉhə ndə məfyíi kə́ kɔ́ fəʼə.<verse eid="ACT 28:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 28:3" />Ndʉʉ ndə Bɔɔ kə́ chə̀ŋtə byʉʉ məŋkɔʼ gɛ̀ tɔ̀ŋ mu kyʉ, bʉʼka məyíʼhə, fɛfɛkə sʉ̀ʉnə fyú hə muŋgɔ chyúnə ndəŋ kwii-i. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />Ndʉʉ ndə mbʉ bʉə-lɔʼɔ-ghɔ̄bə nyíɛ ndə mbʉ kəfɛfɛ chyúnə ndəŋ kwii-i, bɔ̂ŋ gìe tʉ ŋwɔŋtə-ʉə mbɔ, “Wo-ɔ̄ nɔʼ yí wo. Ɔ kɔ̀ɔtə tə kóʼ hə mu muu le, təmə bɔŋ nyii-yʉʼʉ ndə bə tíi ɔ nə Fɔŋ-Ŋkwɛ-Shʉəŋ bɔŋ mə mɛ̀ʼtə ɔŋ ɔ gɛ̀ fɛ.” <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />Bɔɔ ŋwìʼtə mbʉ yɔ, ɔ chóʼnə gwù mu kyʉ təmə lə́ŋhə ɔŋ fɛ. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />Bɔ̂ŋ kə́ chyìi ndə mənyíɛ mbɔ ɔ bu wùʼ byuunɔ ɔ chóʼnə gwù sê kwú. Bɔŋ ndʉʉ ndə bɔ̂ŋ chyìi kəŋkaa ndə mənyíɛ mbɔ nukə chìi ɔ, bɔ̂ŋ kwɛ́nə ndaahə-ʉə, ghɔ̀ŋ mbɔ ɔ la bɛ nyii.<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />Tɔ̂bɛʼkə nɔ kə bɛ mu lɔʼɔ-ghɔ̄, kə́ bɛ yi-Fɔŋ-lɔʼɔ-ghɔ̄-yə ndə yie-e kə́ bɛ Bublu, ndə ɔ kə́ lʉ̀ baʼa, tía baʼa shʉ́əshʉ́ə ndə chîbə itia. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />I kwɔnə fyú mbɔ tie-Bublu la nʉ̀ʉ yɔ́ʼyɔ́ʼ nə nchyʉʼkə ghɔŋbə jisaŋtele. Bɔɔ sʉ́ʉ mu njaa ndə mənyíɛ ɔŋ, mɔ̀ʼ ghɔkə-i ndəŋ ɔŋ, gháaNyii, chʉ́ʼ ɔ. <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />Ndʉʉ ndə yɔ̄ŋ-yə fyú, bəʼ-bʉə-bəyɔʼ-bə ndə bɔ̂ŋ bɛ ndəŋ kwɔŋ-ghɔ̄ ntəŋntəŋ muu le, gwè tʉ ɔŋ, ɔ chʉ́ʼ bɔŋ. <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />Bɔ̂ŋ kɔ́ kuŋhə tʉ baʼa yɔ́ŋyɔ́ŋ ghɔ, kʉ̂ʉ bɛ ndʉʉ ndə baʼa bɛ ndə məkóʼ buukwɛʼtəŋkə gɛ̀ nə waʼ, bɔ̂ŋ mɔ̀ʼ fɔbə inchəŋ mu mbʉ kəbuukwɛʼtəŋ ndə baʼa kə́ byúu.<verse eid="ACT 28:10" /></para>
  <para style="s">Bɔɔ dàa Luŋ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />Bəchî itia kʉ̂ʉ tíŋ, baʼa kóʼ mu kəbuukwɛʼtəŋ ndə i kə lɔ̀ hə Alɛsaŋndia, nɔʼ kə́ chí ndəŋ mbʉ kwɔŋ ntəŋntəŋ muu ndə shyʉʉ-fəʼə, ndə bə kɔ́ŋ tʉ-bənyii-təfɔʼ-bə bəshʉ-ghɔ̄ ndə cheʼkə-i. <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />Baʼa kʉ̂ʉ dàa kəyəŋkwɛʼtəŋbɛʼ bə kə́ tíi nə Silakus, baʼa shíʼ chɔ, chí ndə chîbə itia. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />Baʼa kʉ̂ʉ lɔ̀ hə chɔ yə̀ŋ gɛ̀ dàa kəyəŋbɛʼ bə kə́ tíi nə Lɛgium. Chîkə imɔʼ kʉ̂ʉ tíŋ fʉʉkə kóʼ byûumbɔŋ, kʉ̂ʉ bɛ biitə-kəchî-kə baʼa dàa Botiuli. <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />Baʼa nyíɛ bəbɛʼbʉə chɔ ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii, bɔ̂ŋ yátə baʼa, baʼa chí chɔ ndə chîbə təkwiitia. Ndʉʉmɛ, baʼa lɔ̀ hə chɔ gɛ̀ Luŋ.<verse eid="ACT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 28:15" />Bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii chɔ, kʉ̂ʉ yʉ́ mbɔ baʼa tʉʼ gwè, bɔ̂ŋ lɔ̀ tə gwè bìatə baʼa vyii-Abius. Bəbɛʼbʉə gwè bìatə baʼa kəyəŋbɛʼ ndə bə kə́ tíi nə Njəŋ-chí-hə Itia. Baʼa kʉ̂ʉ nyíɛ bɔŋ, Bɔɔ kɔ́ ndɔ tʉ Nyii, kie fyii.<verse eid="ACT 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16" />Baʼa kʉ̂ʉ gwè dàa mu Luŋ, bə mɛ̀ʼtə Bɔɔ ɔ kə́ chí tətɛʼ ɔ ghɔŋ wo-bəsɔge ndə ɔ kə́ chyìi ɔ.<verse eid="ACT 28:16" /></para>
  <para style="s">Bə kə́ chyìi Bɔɔ ndʉʉ ndə ɔ tʉʼ lɔ̀ʼ ŋgieNyiikə</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />Chîbə kʉ̂ʉ tíŋ itia, Bɔɔ chə̀ŋtə bəntəŋbəshʉ-bʉə-Juu, bɔ̂ŋ kʉ̂ʉ chə̀ŋ, ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, “Bəliŋ-bɔŋ, mɔ kə chìi nu-bʉ̂ʼʉ-kə tʉ bʉə-bʉʼʉ fɛ, byuunɔ mɔ̀ʼ nuʼ-bətietie-bʉʼʉ bɛ́ fɛ, bɔ̂ŋ bɔŋ chɔ̀ʼhə mɔ kɔ́ chaŋ Jɛlosalɛŋ, mu kəghɔ-bʉə-Luŋ. <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />Bɔ̂ŋ kʉ̂ʉ tyúutə mɔ liʼ, kə́ kʉ́ʉ ndə məmɛ̀ʼtə mɔ chɔ bʉʼka mbɔ bɔ̂ŋ kə nyíɛ nukə ndə bəkɔ bə yí mɔ bʉʼka yɔŋ fɛ. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />Bɔŋ bʉʼka bəntəŋbəshʉ-bʉə-Juu kə tɛ́ŋ, mɔ kie ndə məfʉ̀ʉtə mbɔ b̈ə lʉ̀ fɛʼɛ-ɔ tʉ Fɔŋ-Luŋ, təmə mɔ bɔŋ kə́ kie nubɛʼkə ndə məgìe kətʉ bʉə-lɔʼɔ-baʼa fɛ. <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />Bʉʼka yɔ̄ŋ-yə, ndʉʉmɛ, mɔ kə́ tíi bii ndə mənyíɛ bii bʉʼʉ kwə́ʼ, bʉʼka mbɔ nɔ bɛ bʉʼka mɔ bɛ́ŋ wo ndə bʉə-Isilɛ kə́ yʉ́əʼnə ndəŋ ɔŋ, ndə i chìi mɔ kə́ tə́nə laa fɛ̄ŋ nə bəchaŋ təkwii-mɔ nɔ.”<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />Bɔ̂ŋ gìe tʉ ɔŋ mbɔ, “Baʼa chʉʼ kie ŋwɔʼnə ndə i lɔ̀ hə Judia, gwè tʉ baʼa mbɔ a nɔʼ chìi bʉ̂ʼʉ fɛ, byuunɔ təmə mbyu liŋ-yʉʼʉ bɔŋ-nɔʼ-leʼ gwè fɛ̄ŋ nə ntəŋ yie-a byuunɔ tíi yie-a bʉəbʉə fɛ. <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />Baʼa bɔŋ kə́ kʉ́ʉ ndə məyʉ́ kəghɔ-a nukə ndə i bɛ mu fyii-a, bʉʼka mbɔ bʉə bənchəŋ nɔ tʉʼ ghɔ̀ŋ mbɔ nuɔ-ɔ̄ŋ ndə a tə́nə chɔ nɔ la kaa nuɔ jyujyu fɛ.”<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />Bɔ̂ŋ kʉ̂ʉ tʉ́ʼ chîkə tʉ ɔŋ, gwè kəyəŋ ndə ɔ tʉʼ chí chɔ, kɛŋ nuɔ yɔ́ŋyɔ́ŋ. Lʉ̀ hə ndʉʉsɛŋkə tə gɛ̀ dàa ndʉʉbuumbi, ɔ kə́ fʉ̀ʼtə nubə tʉ bɔŋ te Sɔ́ʼ-Nyii, kə́ kɔ̀ɔtə ndə məlóʼtə bɔŋ te Jiso hə mu ŋwɔʼnə-nuʼ-Mushi leʼnə ŋwɔʼnə-bʉəyʉkəŋgieNyii. <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />Bɔŋ bʉəbɛʼbə leʼ bɛ́ŋ nukə ndə ɔ kə gìe, bəbɛʼbə tɛ́ŋ. <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />Bɔ̂ŋ kʉ̂ʉ kə́ túŋ bəŋʉʉ nə mbəŋtə-ʉə, bɔ̂ŋ wɔ̀ʼtə ndʉʉ ndə Bɔɔ gìe mbyu kəŋgie-ɔ̄ mbɔ, “LyʉʉhəNyiikə nɔ nə gìe shʉəŋ tʉ bətietie-bii tíŋ hə bɔ̌ŋ Adaya yʉkəŋgieNyii mbɔ,<verse eid="ACT 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 28:26" />‘Gɛ̀ tʉ bʉə-bɔ̄ŋ gɛ̀ ghɔ̀ŋ tʉ bɔŋ mbɔ,</para>
  <para style="q1" vid="ACT 28:26">bii bu kɛŋ kə́ yʉ́ haʼ yʉ́ təmə bɔŋ kə́ kínə fɛ,</para>
  <para style="q2" vid="ACT 28:26">bii bɔŋ-bu-leʼ kɛŋ kə́ nyíɛ haʼ nyíɛ təmə bɔŋ kə́ chèʼnə fɛ.<verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />Bʉʼka bɔ̂ŋ nɔʼ chíe fyiihə-ʉə,</para>
  <para style="q2" vid="ACT 28:27">təmə kə́ yʉ́ nə tyunəbə-ʉə jyujyu fɛ,</para>
  <para style="q2" vid="ACT 28:27">bɔ̂ŋ nɔʼ kwétə shʉtə-ʉə,</para>
  <para style="q1" vid="ACT 28:27">mbɔ bɔ̂ŋ mə nyíɛ nə shʉtə-ʉə</para>
  <para style="q2" vid="ACT 28:27">bɔŋleʼ yʉ́ nə tyunəbə-ʉə</para>
  <para style="q1" vid="ACT 28:27">kínə nə fyiihə-ʉə,</para>
  <para style="q2" vid="ACT 28:27">kíahə ŋwɔŋ-yʉə, mɔ chʉʼ yi chʉ́ʼ bɔŋ fɛ.’<note caller="+" style="f"><char style="fr" closed="false">28:27 </char><char style="ft" closed="false">Adaya 6:9-10.</char></note><verse eid="ACT 28:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="ACT 28:28" />Nduɔ, b̈ii kínə mbɔ ŋkwaaNyii-ɔ̄ŋ, bə nɔʼ tə́ŋ kɔ́ tʉ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ, bɔ̂ŋ bu yʉ́.” <verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" />[Ndʉʉ ndə ɔ gìe nubə-ɔ̄ŋ, mbʉ bʉə-Juu wɔ̀ʼnə gɛ̀ kə́ tòʼ túŋ bəŋʉʉ nə mbəŋtə-ʉə.]<verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />Ndə ŋgʉʼhə ibûu, Bɔɔ kə́ chí chɔ mu yi-yə njaa ndə ɔ kə́ lɔ̀ʼ. Bʉə kə́ gwètə mətòʼ chɔ tʉ ɔŋ. <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />Ɔ kə́ kwə́ʼ tʉ bɔŋ te Sɔ́ʼ-Nyii bɔŋ-kə́-leʼ dàhə bɔŋ te Jiso Klai Tiekətʉ nə fyii tə̀ŋnə təmə nukə kə́ tìahə ɔŋ fɛ.<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>