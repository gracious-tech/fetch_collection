<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Bamunka New Testament</book>
  <para style="h">Galatia</para>
  <para style="toc1">Ŋwɔʼnə ndə Bɔɔ nyɔ̀ʼ kɔ́ tə Chɔshi ndə i bɛ Galatia</para>
  <para style="toc2">Galatia</para>
  <para style="toc3">Gal</para>
  <para style="mt2">Ŋwɔʼnə ndə Bɔɔ kə nyɔ̀ʼ kɔ́ tʉ</para>
  <para style="mt2">Chɔshi ndə i bɛ</para>
  <para style="mt1">Galatia</para>
  <para style="imt">Nchoʼtə bətʉ bənu</para>
  <para style="ip">Mbʉ ntəŋ te Jiso nɔ kə kə́ gɛ̀ nə shʉbə haʼ nɔ tʉ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ chʉ́ʉhə kə́ bɛ bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii. Mbyu mbiʼtə gwè mbɔ bə kie ndə məfɔ̀ʼ wo ndə ɔ gòʼ təmə bɛ wo-Juu fɛ buŋ lʉ̀ ɔ nə wo ndə ɔ nɔʼ bɛ́ŋ Nyii mɛ? Bɔɔ nɔ shyíi bʉʼʉ mu ŋwɔʼnə-fɛ̄ŋ mbɔ bə kie məfɔ̀ʼ wo, mbɔ ɔ chʉʼ bɛ wo ndə ɔ nɔʼ bɛ́ŋ Nyii fɛ. Ɔ nɔ fʉ̀ʼtə mu ŋwɔʼnə-fɛ̄ŋ mbɔ la bɛ haʼ məmɔ̀ʼfyii ndəŋ Klai baabaa ndə ĩ chìi wo ɔ buŋ kie ŋkwaaNyii.</para>
  <para style="ip">Bɔɔ nɔ kə nyɔ̀ʼ ŋwɔʼnə-ɔ̄ŋ ndə məchìi mbɔ bʉə ndə bɔ̂ŋ nɔʼ kə mɔ̀ʼ fia bɛ́ bʉʼka mədàhə nə mbii mbɔ bɔ̂ŋ bʉ̀nə gwè ndə nukə ndə i kʉ̀ʼnə. Bɔɔ nɔ lìʼ ŋwɔʼnə-ɔ̄ŋ ndə məchìi bə kínə mbɔ ñuʼ-wo ndə ɔ bɛ́ŋ Nyii la gwè bə ndəŋ ŋkʉ̂ʉ ndə ɔ kie tʉ Nyii ghɔŋbə bʉəməsʉʉ tíŋ hə bɔ̌ŋ məmɔ̀ʼfyii ndəŋ Nyii.</para>
  <para style="iot">Nubə ndə i bɛ mu ŋwɔʼnə-fɛ̄ŋ</para>
  <para style="io1">Nchʉʉhə-bənu 1:1-10</para>
  <para style="io1">Ghʉəʼkə ndə Bɔɔ kie ndə lɔntəŋNyii 1:11–2:21</para>
  <para style="io1">Ntəŋjyujyu te buuŋjyu-Nyii 3:1–4:31</para>
  <para style="io1">Tʉ-bəKʉlʉtɛŋ-bə ndə i nɔʼ lʉ́ʉ bɔŋ, nubə ndə bɔ̂ŋ kie ndə mə-kə́-fɔ̀ʼ 5:1–6:10</para>
  <para style="io1">Liʼ-bənu 6:11-18</para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="s">Nchaʼtə ndə i gwè hə kəghɔ-Bɔɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />Nɔ nyɔ̀ʼ mbəŋ-ɔŋ Bɔɔ nyɔ̀ʼ ŋwɔʼnə-ɔ̄ŋ, lɔntəŋNyii, kaa lɔntəŋNyii ndə ɔ gwè hə kəghɔ-woməsʉʉ fɛ təmə bɔŋleʼ tíŋ hə bɔ̌ŋ woməsʉʉ fɛ, ɔ bɔŋ gwè bə hə kəghɔ-Jiso Klai ghɔŋ Nyii mbʉ Tie, ndə ɔ kə bʉ̀nə kóʼhə ɔŋ ndʉʉ ndə ɔ kə kwú. <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" />Ŋwɔʼnə-ɔ̄ŋ bɔŋleʼ gwè hə kəghɔ-bʉə bənchəŋ ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii baʼa bɔŋ kə́ bɛ mɔʼɔ. Baʼa nɔ tʉʼ nyɔ̀ʼ tʉ chɔshi ndə i bɛ mu Galatia.<verse eid="GAL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3" />Tə Nyii mbʉ Tie-yʉʼʉ ghɔŋbə Tiekətʉ-yʉʼʉ Jiso Klai, dʉ̀ʼ buuŋjyu tʉ bii bɔŋleʼ kɔ́ bii nə fyiighʉ́ənə, <verse eid="GAL 1:3" /><verse number="4" style="v" sid="GAL 1:4" />Jiso Klai nɔ kə kɔ́ ŋwɔŋ-ɛŋ ndə bʉ̂ʼtə-ʉʼʉ, ndə məfì tʉkə-ʉʼʉ ndə mbi bʉ̂ʼʉ-ɔ̄ laa nɔ, ndə ŋkʉʉnə tʉʉ-Nyii Tie-yʉʼʉ. <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />Tə məŋwɔʼ bɛ yi-yə təmə liʼ-i ghɔ fɛ. Ï bɛ haʼ nɔ.<verse eid="GAL 1:5" /></para>
  <para style="s">Nɔ bɛ haʼ mbyu ntəŋjyujyu imɔʼ</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />I nɔ tʉʼ chàa mɔ mbɔ bii nɔʼ chʉʼ nyʉ́ʉ bɔ̌ŋ mbəŋ-ɛŋ Nyii ndə ɔ kə tíi bii tíŋ hə bɔ̌ŋ buuŋjyu-Klai, kə́ kíahə ŋwɔŋ-yii gɛ̀ ndə ntəŋjyujyu kədɔŋ. <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />Kaa bɛ mbɔ ibɛʼ-yə ntɛ ntəŋjyujyu bɛ ghɔ fɛ, bɔŋ mɔ nɔ tʉʼ gìe yɔ̄ŋ-yə bʉʼka mbɔ bʉəbɛʼbə nɔ bɛ ghɔ ndə bɔ̂ŋ tʉʼ chɔ́ŋhə bii, kə́ kʉ́ʉ ndə məbyùutə ntəŋjyujyu ndə i bɛ yie-Klai. <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />Bɔŋ kaʼ buŋ bɛ bə mbəŋ-yaʼ, byuunɔ wontəŋNyii ndə ɔ gwè bə hə yuo gwè lɔ̀ʼ ntəŋ Nyii ndə i bɛ ŋkʉ̂ʉ ndəŋ yi ndə baʼa kə gwè lɔ̀ʼ tʉ bii, ɔ̈ bɛ̀ʼ ndɔŋ-ɛŋ kəghɔ-Nyii. <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />Haʼ ndə baʼa nɔʼ kə gìe, nɔ, mɔ bìʼ gìe, kaʼ wotəmiyɔŋ kə́ lɔ̀ʼ ntəŋjyujyu tʉ bii ndə i bɛ ŋkʉ̂ʉ ndəŋ yi ndə baʼa nɔʼ kə lɔ̀ʼ tʉ bii, ɔ̈ bɛ̀ʼ ndɔŋ-ɛŋ kəghɔ-Nyii.<verse eid="GAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10" />Mɔ tʉʼ kʉ́ʉ ŋkʉ̂ʉ nduɔ hə kəghɔ-bʉəməsʉʉ mɛ, kə hə kəghɔ-Nyii? Byuunɔ, mɔ tʉʼ kʉ́ʉ ndə məchìi tʉʉ-woməsʉʉ bʉ̀ʉ ndə mɔ mɛ? Kaʼ mɔ kʉ̌ʉ kə́ bíe kʉ́ʉ bɛ mbɔ kʉ̀ʉ woməsʉʉ kʉ̀ʉ mɔ, təmə mɔ mə bɛ vaantie-Klai fɛ.<verse eid="GAL 1:10" /></para>
  <para style="s">Nyii tíi Bɔɔ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />Bəliŋ-bɔŋ, mɔ nɔ tʉʼ kʉ́ʉ mbɔ bii kínə mbɔ ntəŋjyujyu ndə mɔ kə́ lɔ̀ʼ tʉ bii, kə bɛ yi ndə i kə gwè hə kəghɔ-woməsʉʉ fɛ. <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />Bʉʼka mɔ kə kie hə kəghɔ-woməsʉʉ fɛ, təmə bə bɔŋ dàhə mɔ dàhə chɔ fɛ, mɔ bɔŋ nɔ nə kie hə kəghɔ-Jiso Klai ndə ɔ kə kɛ̀ʼ tʉ mɔ.<verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />Bii nɔ nə yʉ́ ntɛ wo ndə mɔ kə bɛ yɔŋ, vɛʼ ndə mɔ kə́ tʉ́ʼ nuʼ-bʉə-Juu, ntɛ ndə mɔ kə́ chɔ́ŋhə chɔshi-Nyii shʉ́əshʉ́ə ndə məbʉ́əhə. <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />Mɔ nɔ nə kə́ gɛ̀ nə shʉbə ndə mbʉ nuʼ-bʉə-Juu tə kə́ chàa bəbɛʼbʉə mu kəyɔ-baʼa, mɔ kɛŋ kɔ́ fyii-ɔ shʉ́əshʉ́ə ndə nuʼ-bətie-baʼa.<verse eid="GAL 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15" />Bɔŋ mbəŋ-ɛŋ, Nyii ndə ɔ nɔʼ kə séʼ mɔ, lʉ̀ hə bətɔ-naa-ɔŋ, ndə ɔ kə tíi mɔ nə buuŋjyu-i, <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />tʉʉ-i nɔ kə bʉ̀ʉ ndə məkɛ̀ʼ wo ndə Vaa-ɛ bɛ yɔŋ tʉ mɔ, mbɔ mɔ chʉʼ gɛ̀ lɔ̀ʼ ntəŋjyujyu te ɔ tʉ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ, təmə mɔ gɛ̀ ndə məbíʼtə tʉ wobɛʼ təmiyɔŋ fɛ. <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />Təmə mɔ bɔŋ kóʼ gɛ̀ Jɛlosalɛŋ ndə məbíʼtə tʉ bʉə ndə bɔ̂ŋ nɔʼ kə bɛ bəlɔntəŋNyii bəshʉ mɔ fɛ, mɔ lɔ̀ gɛ̀ bə Alabia, buŋ bʉ̀nə bìʼ gɛ̀ Damasiko. <verse eid="GAL 1:17" /><verse number="18" style="v" sid="GAL 1:18" />Ndʉʉmɛ, ŋgʉʼhə itia kʉ̂ʉ tíŋ, mɔ kóʼ gɛ̀ mətòʼ Jɛlosalɛŋ tʉ Bita ndə məkínə nuʼ-i, baʼa ɔ chí ndə chîbə njuɔ taa nə wuŋ. <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />Mɔ kə nyíɛ mbyu lɔntəŋNyiibɛʼ təmiyɔŋ fɛ, yaʼkɛŋ Jɛŋ liŋ-Tiekətʉ. <verse eid="GAL 1:19" /><verse number="20" style="v" sid="GAL 1:20" />Ndə nubə ndə mɔ tʉʼ gìe tʉ bii, Nyii nɔ kínə mbɔ mɔ tʉʼ chʉ̀ə lɛɛŋkə fɛ. <verse eid="GAL 1:20" /><verse number="21" style="v" sid="GAL 1:21" />Yɔ̄ŋ-yə kʉ̂ʉ tíŋ, mɔ kóʼ gɛ̀ mu bie Silia ghɔŋbə Silisia. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />Wo chʉʼ kə kínə mɔ hə mu bʉə-Klai mu-bəchɔshi-hə mu Judia fɛ. <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />Bɔ̂ŋ nɔ nə kə́ yʉ́ haʼ yʉ́ ndə bə nə kə́ ghɔ̀ŋ mbɔ, “Wo-e ndə ɔ nə kə́ chɔ́ŋhə bʉʼʉ le, nɔ tʉʼ bʉ̀nə lɔ̀ʼ ntəŋjyujyu te məmɔ̀ʼfyii ndəŋ Jiso ndə ɔ nɔʼ nə kə́ kɔ̀ɔtə ndə məbʉ́əhə le.” <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />Ndʉʉmɛ, bɔ̂ŋ kə́ lə̀ʼtə Nyii bʉʼka mɔ.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s">BəlɔntəŋNyii lʉ̀ Bɔɔ mu bɔŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />Ndʉʉmɛ, ŋgʉʼhə kʉ̂ʉ tíŋ njuɔ kwi nə wuŋ mɔ bʉ̀nə kóʼ gɛ̀ Jɛlosalɛŋ baʼa Banaba, lʉ̀ Tatu baʼa ɔ gɛ̀ mɔʼɔ. <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />Mɔ nɔ nə kóʼ gɛ̀ chɔ bʉʼka nukə ndə Nyii kə dʉ̀ʼ tʉ mɔ. Mɔ gɛ̀ mɔ̀ʼ ntəŋjyujyu ndə mɔ tʉʼ lɔ̀ʼ bɔ̌ŋbɔ̌ŋ mu bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ, bəshʉ bʉə ndə bə kə kínə bɔŋ ndə bəntəŋbəshʉ, nə faakə mbɔ ndʉʉbɛʼ mɔ nɔʼ kə fɔ̀ʼ fɔʼɔ bɔŋleʼ kə́ fɔ̀ʼ fɔʼɔ njʉnjʉ. <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />Bɔŋ təmə bə kwɛ̀ŋhə mbɔ b̈ə fɔ̀ʼ Tatu ndə baʼa ɔ kə bɛ mɔʼɔ fɛ, tʉ ɔ bɔŋ nɔ nə bɛ wo Gili.<verse eid="GAL 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 2:4" />Bəbɛʼbʉə-bɔ̄ŋ ndə bɔ̂ŋ kə́ kʉ́ʉ mbɔ b̈ə fɔ̀ʼ ɔ bɔ̂ŋ kə́ làhə shʉ mbɔ bɔ̂ŋ la bɛ bʉə-Nyii, bɔ̂ŋ nɔ kə nyáʼtə sʉ́ʉ mu baʼa ndə mə-kə́-yəŋ tiɛŋ yaʼ, kə́ kʉ́ʉ ndə mənyíɛ ntɛ ndə tʉkə-aʼ bu lʉ́ʉ baʼa tíŋ hə bɔ̌ŋ məyúnə-yaʼbə Jiso, Wo ndə Nyii Kùŋ Tə́ŋ bɔ̂ŋ chʉʼ chìi baʼa bɛ fʉəhə. <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />Təmə baʼa yʉ́ chu-yʉə buŋ məniʼ fɛ, bʉʼka baʼa nɔ kə́ kʉ́ʉ mbɔ b̈aʼa yá shʉəŋ ndə i bɛ mu mbʉ ntəŋjyujyu tʉ́ʼ tʉ bii.<verse eid="GAL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6" />Bʉə ndə bə kə kínə bɔŋ ndə məbɛ bəntəŋbəshʉ, kə bɔ̂ŋ kə bɛ ka, i kə bɛ nubɛʼkə tʉ mɔ fɛ bʉʼka Nyii kyinə túhə shʉ fɛ, nɔʼ m̈ɔ bìʼ ghɔ̀ŋ mbɔ mbəŋ-yʉə ndə bə kə́ tíi bɔŋ nə bəntəŋbəshʉ kə bìʼ nubɛʼkə ndəŋ mɔ fɛ. <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />Bɔ̂ŋ buŋ leʼ nyíɛ bə mbɔ Nyii nɔ kə kɔ́ mbʉ ntəŋjyujyu mu kəghɔ-mɔ ndə məgɛ̀ lɔ̀ʼ tʉ bʉə ndə bə gòʼ təmə nɔʼ fɔ̀ʼ bɔŋ fɛ, haʼ ndə bə kə kɔ́ tʉ Bita ndə məgɛ̀ lɔ̀ʼ tʉ bʉə ndə bə nɔʼ fɔ̀ʼ bɔŋ.<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">Bʉə ndə bə gòʼ təmə nɔʼ fɔ̀ʼ bɔŋ fɛ nɔ bɛ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ. Bʉə ndə bə nɔʼ fɔ̀ʼ bɔŋ kə́ bɛ bʉə-Juu.</char></note> <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />Mbəŋ-ɛŋ, ndə ɔ chìi Bita ndə məbɛ lɔntəŋNyii tʉ bʉə ndə bə nɔʼ fɔ̀ʼ bɔŋ, nɔ chìi haʼ ɔ chìi mɔ ghɔ ndə məbɛ lɔntəŋNyii tʉ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ. <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />Bɔŋ ndʉʉ ndə Jɛŋ, Bita leʼnə Jɔŋ ndə bɔ̂ŋ kə bɛ nə tɛʼnəbə, kə nyíɛ buuŋjyu ndə Nyii nɔʼ dʉ̀ʼ tʉ mɔ, bɔ̂ŋ chàʼtə baʼa Banaba ndə mədʉ̀ʼ mbɔ nukə ndə baʼa tʉʼ dàhə ghɔŋbə fɔʼɔ-Nyii ndə baʼa tʉʼ fɔ̀ʼ nɔ kʉ̀ʼnə bɔŋleʼ bɛ́ŋ mbɔ b̈aʼa lʉ̀ ŋgieNyiikə gɛ̀ nə yɔŋ tʉ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ, mbəŋ-yʉə lʉ̀ gɛ̀ nə yɔŋ tʉ bʉə ndə bə nɔʼ fɔ̀ʼ bɔŋ. <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />Mbyu kənu imɔʼ ndə bɔ̂ŋ kə gìe tʉ baʼa nɔ bɛ mbɔ b̈aʼa la kwɛ́nə bʉə-mbʉʼ, kə́ bɛ haʼ nukə ndə i kə bɛ mu fyii-mɔ shʉ́əshʉ́ə ndə məfɔ̀ʼ.<verse eid="GAL 2:10" /></para>
  <para style="s">Bɔɔ sɔ́ʼ Bita</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />Ndʉʉ ndə Bita kə gwè Antiɔk, mɔ sɔ́ʼ ɔ shʉ-ɔ, bʉʼka nukə ndə ɔ kə chìi kə kʉ̀ʼnə fɛ. <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />Bʉəbɛʼbə nɔ kə gwè hə kəyəŋ ndə Jɛŋ bɛ chɔ, tʉ Bita nɔ nə kə́ fəŋ yú fɔbə ghɔŋbə bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ. Bɔŋ ndʉʉ ndə bʉə-bɔ̄ŋ kə gwè, ɔ fyúhə ŋwɔŋ-ɛŋ, kə́ fàa nuɔ-bʉə ndə bə nɔʼ fɔ̀ʼ ndə bɔ̂ŋ tʉʼ kʉ́ʉ mbɔ b̈ə kə́ fɔ̀ʼ bʉə. <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />Ndʉʉmɛ, bəbɛʼbə bəʼ-bʉə-Juu-kə, bìa Bita ndə mənaa-mi, i bɛ tə Banaba bìa bɔŋ ndə mbʉ mənaa.<verse eid="GAL 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 2:14" />Bɔŋ ndʉʉ ndə mɔ kə nyíɛ mbɔ nuʼ-yʉə kə́ tòʼ ndyʉndyʉ ghɔŋbə ŋgie-shʉəŋ-kə ndə i fyú hə mu ntəŋjyujyu fɛ, mɔ gìe tʉ Bita bəshʉ bʉə bənchəŋ mbɔ, “Kaʼ mbəŋ-aŋ, bɛ wo-Juu, kə́ chí mbi ndə wo ndə ɔ gòʼ təmə bɛ wo-Juu fɛ, a bu kwɛ̀ŋhə bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ ndə mə-kə́-chìi nubə ndə bʉə-Juu təka? <verse eid="GAL 2:14" /><verse number="15" style="v" sid="GAL 2:15" />Bə nɔ bí mbəŋ-yʉʼʉ nə bʉə-Juu, kaa ndə bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu bə bɔŋ kə́ tíi bɔŋ nə bʉə-bʉ̂ʼʉ fɛ. <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />Bʉʼʉ bɔŋ kə́ kínə mbɔ wo kyinə bɛ ndyʉndyʉ bəshʉ-Nyii bʉʼka mbɔ ɔ tʉ́ʼ nuʼ-Nyii fɛ, bɔŋ i nɔ bɛ bʉʼka mbɔ ɔ nɔ mɔ̀ʼfyii-i ndəŋ Jiso Klai,<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">Bəkɔ bə kíahə yəŋkə-ɔ̄ŋ ghɔ mbɔ </char><char style="it">nɔ kə bɛ bʉʼka məmɔ̀ʼfyii ndə Jiso kə dʉ̀ʼ ndʉʉ ndə ɔ kə yʉ́ chu Tie.</char></note> nɔ, mbəŋ-yʉʼʉ ghɔ nɔʼ bɛ́ŋ Klai Jiso, mbɔ bʉʼʉ chʉʼ bɛ ndyʉndyʉ bʉʼka mbɔ bʉʼʉ nɔʼ mɔ̀ʼfyiihə-ʉʼʉ ndəŋ Klai, kaa bə bʉʼka mbɔ bʉʼʉ tʉ́ʼ nuʼ-Nyii fɛ, bʉʼka mbɔ mətʉ́ʼ nuʼ mə nə chìi wo bɛ ndyʉndyʉ tʉ Nyii fɛ.”<verse eid="GAL 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 2:17" />Bɔŋ bʉʼka ndʉʉ ndə bʉʼʉ tʉʼ kɔ̀ɔtə ndə məbɛ ndyʉndyʉ mu Klai, bə bɔŋ kə́ nyíɛ bʉʼʉ haʼ ndə bʉə-bʉ̂ʼʉ nɔ, i dʉ̀ʼ mbɔ Klai tʉʼ fɔ̀ʼ ndə məkóʼhə kwii bʉ̂ʼʉ mɛ? I mə nə bɛ nɔ fɛ! <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />Kaʼ mɔ kə́ bʉ̀nə bɔ́ fɔkə ndə mɔ nɔʼ kə kùu, i dʉ̀ʼ mbɔ mɔ nɔ lʉ̀ ŋwɔŋ-ɔŋ ndə wo ndə ɔ tʉʼ bə́ʼ nuʼ-Nyii. <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />Nɔ nə bɛ bəshʉ, mbəŋ-ɔŋ ghɔ nɔ nə kə́ chí mbi ndəŋ ntɛ ndə nuʼ kʉ̀ʉ, bɔŋ ndʉʉ ndə bə kə fyúhə mɔ ndə mbʉ nuʼ, i chìi mɔ kie ghʉəʼkə ndə məchímbi ndə ntɛ ndə Nyii kʉ̀ʉ. <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />Bə nɔʼ kə kwɛ̀ŋ baʼa Klai mɔʼɔ yi. Məchimbi-ɔ leʼbie ntɛ ndə i kə bɛ bəshʉ fɛ, mɔ nɔ tʉʼ chí mbi nduɔ bʉʼka Klai nɔ tʉʼ chí mu mɔ. Məchi-ɔ nduɔ ndə woməsʉʉ, mɔ nɔ tʉʼ chí bʉʼka mɔ mɔ̀ʼfyii-ɔ ndəŋ VaaNyii, ndə ɔ kə kʉ̀ʉ mɔ kɔ́ ŋwɔŋ-ɛŋ yie-mɔ. <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />Mɔ mə tɛ́ŋ buuŋjyu-Nyii fɛ, bʉʼka mbɔ, kaʼ wo kʉ̌ʉ kə́ bɛ ndyʉndyʉ ghɔŋ Nyii bə bʉʼka mətʉ́ʼ nuʼ, i dʉ̀ʼ mbɔ Klai nɔ kwú njʉnjʉ.<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s">Nuʼ leʼnə məmɔ̀ʼfyii ndəŋ Jiso Klai</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />Oo bənɔ̌ʼɔ bʉə-Galatia! Kwó nda kwó bii nə loʼbə? Bii nɔ kə nyíɛ luu ndə Jiso Klai kə kwú bʉʼka yɔŋ ntaa, fi nə mɔ tʉʼ dʉ̀ʼ tʉ bii ndəŋ futu ndə bə kə kwɛ̀ŋ Jiso yi. <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />N̈ɔʼ mɔ bíʼtə haʼ mbyu kənu tʉ bii imɔʼ, bii kə kie LyʉʉhəNyiikə bʉʼka bii kə tʉ́ʼ nuʼ mɛ, kə bʉʼka bii kə yʉ́ ŋgieNyiikə mɔ̀ʼfyiihə-ii chɔ? <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />Bii nɔ̌ʼ ka mənɔ? Bii kə chʉ́ʉhə nə LyʉʉhəNyiikə, kə́ kʉ́ʉ mbɔ bii bɛ ŋkɛŋ-bʉə-hə bəshʉ-Nyii nə yi-yə ghʉəʼkə mɛ? <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />Le bɛ mbɔ bii kə́ nyíɛ buŋmbi ŋgʉəʼ-ɛ njʉnjʉ mɛ, kaʼ bɛ mbɔ i kə bɛ njʉnjʉ leʼ shʉəŋ?<verse eid="GAL 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GAL 3:5" />Mbəŋ-ɛŋ ndə ɔ kə kɔ́ Lyʉʉhəkə-i tʉ bii bɔŋleʼ fɔ̀ʼ nufinəbə mu bii, kə bɛ bʉʼka bii kə tʉ́ʼ nuʼ mɛ, mɛ kə bʉʼka bii kə mɔ̀ʼfyiihə-ii ndəŋ nubə ndə bii kə yʉ́?<verse eid="GAL 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6" />I nɔ bɛ haʼ ndə Ablahaŋ kə mɔ̀ʼfyii-i ndəŋ Nyii bə súu yie ɔ mbɔ ɔ la tə́nə ndyʉndyʉ tʉ Nyii. <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" />B̈ii kínə le mbɔ nɔ bʉə ndə bɔ̂ŋ mɔ̀ʼfyiihə-ʉə ndəŋ Nyii ndə bɔ̂ŋ bɛ ŋkɛŋ vâa-Ablahaŋ.<verse eid="GAL 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 3:8" />Ŋwɔʼnə-Nyii nɔ nə núhə bəshʉ mbɔ Nyii la bu nə chìi bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ ndə məbɛ ndyʉndyʉ bəshʉ ɔ tíŋ hə bɔ̌ŋ məmɔʼfyiihə-ʉə ndəŋ ɔŋ, ɔ lɔ̀ʼ ntəŋjyujyu tʉ Ablahaŋ bəshʉbəshʉ kə́ ghɔ̀ŋ mbɔ, “Bʉʼka mbəŋ-aŋ, lɔʼ-bətə̂ŋ-tə inchəŋ bu kie biʼbə.” <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />Nɔ bɛ haʼ nɔ, ndə bʉə ndə bɔ̂ŋ mɔ̀ʼfyiihə-ʉə ndəŋ Nyii, bu kie biʼbə ndə Nyii nɔʼ nə kɔ̀ʼnə tʉ Ablahaŋ ghɔ, wo ndə ɔ nə mɔ̀ʼfyii-i ndəŋ Nyii.<verse eid="GAL 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10" />Bʉʼka bʉə bənchəŋ ndə bɔ̂ŋ tʉʼ tʉ́ʼ nuʼ ndə məchìi bɔ̂ŋ bɛ ndyʉndyʉ bəshʉ-Nyii, ndɔŋ-Nyii nɔ ndəŋ bɔŋ, bʉʼka bə nɔ nyɔ̀ʼ mu ŋwɔʼnə-Nyii mbɔ, “Ndɔŋ-Nyii nɔ ndəŋ wotəmiyɔŋ ndə ɔ gòʼ təmə tʉʼ nubə inchəŋ ndə bə nyɔ̀ʼ mu Ŋwɔʼnə-nuʼ bɔŋ-kə́-leʼ fɔ̀ʼ fɛ.” <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />Nduɔ, i nɔ kɛŋ bɛ itʉ́ʉnə mbɔ wo mə nə bɛ ndyʉndyʉ bəshʉ-Nyii bʉʼka nuʼ fɛ, bʉʼka mbɔ, “B̃ʉə ndə bɔ̂ŋ bɛ ndyʉndyʉ tʉ Nyii, nɔ chí mbi bə nə məmɔʼfyiihə-ʉə ndəŋ Nyii.” <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />Bɔŋ ndə mətʉ́ʼ nuʼ kie nukə ndə məchìi ghɔŋ mə mɔ̀ʼfyii ndəŋ Nyii fɛ, bʉʼka ŋwɔʼnə-nuʼ nɔ ghɔ̀ŋ mbɔ, “Kaʼ bɛ mbɔ a tʉ́ʼ nuʼ-Nyii ndə məchímbi, a nɔ kie ndə mətʉ́ʼ inchəŋ.” <verse eid="GAL 3:12" /><verse number="13" style="v" sid="GAL 3:13" />Klai nɔʼ chʉ̀ʼ tʉkə-ʉʼʉ hə ndəŋ ndɔŋ ndə ĩ gwè hə ndə mətʉ́ʼ nuʼ, ndʉʉ ndə ɔ kə kwú ndəŋ tyʉntɔɔnəkə, ɔ bɛ̀ʼ mbʉ ndɔŋ ndəŋ ɔŋ ndə i kə kie ndə məgwè tʉ bʉʼʉ bʉʼka mɔ̀ʼmbɛ-yʉʼʉ, bʉʼka bə nɔ nyɔ̀ʼ mu ŋwɔʼnə-Nyii mbɔ, “Ndɔŋ Nyii nɔ ndəŋ wotəmiyɔŋ ndə ɔ lʉ́ʉ kətyʉ.” <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />Bʉʼka fɔ̀ʼ Klai Jiso, Nyii nɔʼ bìʼ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ nə biʼkə ndə ɔ nə kɔ̀ʼnə tʉ Ablahaŋ, mbɔ bʉʼʉ chʉʼ kie LyʉʉhəNyiikə ndə ɔ nə kɔ̀ʼnə bʉʼka məmɔ̀ʼfyii ndəŋ Nyii.<verse eid="GAL 3:14" /></para>
  <para style="s">Mbʉ nuʼ ghɔŋbə ŋkɔʼnə</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />Bəliŋ-bɔŋ, bʉʼʉ lʉ̀ fʉʼkənu ndə bʉəməsʉʉ laa, ndʉʉ ndə bʉə gwìa ŋkaamə tə nɔʼ kɔ́ʼ, wo leʼ byùutə nukə chɔ byuunɔ bìʼ fɛ. <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />Nduɔ, mbʉ ŋkɔʼnə nɔ nə bɛ tʉ Ablahaŋ ghɔŋ vaa-ɛ. I kə ghɔ̀ŋ mbɔ vâa-bi fɛ, ndə bʉə buŋmbi fɛ, i nɔ nə te mbyu wo-imɔʼ mbɔ, “Tʉ vaa-a,” ndə bɛ Klai. <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />Nɔ nukə nɔ ndə mɔ tʉʼ ghɔ̀ŋ mbɔ mbʉ nuʼ ndə i kə bʉ̀nə gwè hə bɔ̌ŋ ndə ŋgʉʼhə təghyʉʉ kwi nə wuŋ tia mə leʼ byùutə ŋkaamə ndə Nyii nɔʼ kə fəŋ kɔ́ʼ, ndə məchìi mbʉ ŋkɔʼnə fyú njʉnjʉ fɛ. <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />Bʉʼka mbɔ kaʼ kɔ-Nyii-kə kʉ̌ʉ kə́ gwè bə ndə mətʉ́ʼ nuʼ təmə i leʼ bɛ ŋkɔʼnə fɛ, Nyii bɔŋ kɔ́, yɔ̀ʼ ghɔkə-i tʉ Ablahaŋ bʉʼka ŋkɔʼnə.<verse eid="GAL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />Nuʼ kie məchìi ka ndʉʉmɛ? Bə nɔ kə bìʼ nuʼ bʉʼka nu-bʉəbʉə-bə, tə ndʉʉ i kʉ̀ʼnə ndə mbʉ vaa ndə mbʉ ŋkɔʼnə nə bɛ yie-ɔ nə gwè. Nyii tə́ŋ bʉəntəŋ-bi nə mbʉ nuʼ bɔ̂ŋ kɔ́ tʉ woməsʉʉ ndə ɔ bɛ lìʼ ntuu, ɔ gwè nə yɔŋ. <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />W̃o lìʼ ntuu nɔ bɛ ndə nukə ndə i kə̀ŋ bʉə bəbûu, Nyii bɔŋ bɛ tətɛʼ ɔ. <verse eid="GAL 3:20" /><verse number="21" style="v" sid="GAL 3:21" />Bɔŋ nuʼ-Nyii tʉʼ shʉ́nə ghɔŋbə bəŋkɔʼnə-Nyii mɛ? Shʉəŋshʉəŋ i mə bɛ nɔ fɛ! Bɔŋ kaʼ bə nɔʼ kə kɔ́ mbyu nuʼ ndə bəkɔ i kɔ́ məchímbi, ndʉʉmɛ, mətə́nə ndyʉndyʉ bii Nyii bu gwè hə ndə mətʉ́ʼ mbʉ mbyu nuʼ. <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />Bɔŋ ŋwɔʼnə-Nyii nɔ ghɔ̀ŋ mbɔ bʉə bənchəŋ nɔ bɛ fʉəhə ndə bʉ̂ʼʉ, kə mbɔ ŋkɔʼnə ndə Nyii kə kɔ̀ʼnə bu tíŋ hə bɔ̌ŋ məmɔ̀ʼfyii ndə Jiso Klai kə dʉ̀ʼ,<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="ft" closed="false">Bəkɔ bə kíahə yəŋkə-ɔ̄ŋ ghɔ mbɔ </char><char style="it">məmɔ̀ʼfyii ndəŋ Jiso.</char></note> bə kɔ́ tʉ bʉə ndə bɔ̂ŋ mɔ̀ʼfyii ndəŋ ɔŋ.<verse eid="GAL 3:22" /></para>
  <para style="s">Vâa-Nyii tíŋ hə bɔ̌ŋ məmɔ̀ʼfyii ndəŋ Jiso</para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />Nduɔ, məmɔ̀ʼfyii ndə Jiso kə dʉ̀ʼ, nɔ nə kə̂ gwè, bə nɔʼ chìi baʼa bɛ fʉəhə ndə nuʼ, tə bə nə kə kɛ̀ʼ məmɔ̀ʼfyii tʉ baʼa. <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />Ndʉʉghɔfii, nuʼ nɔʼ kə́ kyʉ̀hə baʼa, tʉ Klai buŋ nə gwè kə mbɔ baʼa bu bɛ ndyʉndyʉ tʉ Nyii tíŋ hə bɔŋ məmɔ̀ʼfyii. <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />Bɔŋ nduɔ ndə məmɔ̀ʼfyii nɔʼ gwè nɔ, baʼa leʼ bɛ ndə məkie ŋkyʉʉhəkə fɛ. <verse eid="GAL 3:25" /><verse number="26" style="v" sid="GAL 3:26" />Bʉʼka bii mɔ̀ʼfyiihə-ii ndəŋ Klai Jiso, bii nɔ bɛ vâa-Nyii. <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />Bʉʼka wotəmiyɔŋ ndə ɔ nɔʼ fí muu, nɔʼ fúu nuɔ ghɔŋbə Klai, nɔʼ mɔ̀ʼ məchimbi-Klai mbʉə-ɔ, ndə w̃o mɔ̀ʼ ndyi le. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />Nɔ, wo-Juu kaa ghɔ ŋkʉʉ ndəŋ wo ndə ɔ gòʼ təmə bɛ wo-Juu fɛ, fʉə bɛ ghɔ ŋkʉʉ ndəŋ wo ndə ɔ gòʼ təmə bɛ fʉə fɛ, təmə woləŋ kə bɛ ghɔ ŋkʉʉ ndəŋ woke fɛ, bʉʼka bii nɔ bɛ fɔkə imɔʼ mu Klai Jiso. <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />Kaʼ bii bɛ tʉ Klai, təmə bii nɔ bɛ ŋgwie-wo-Ablahaŋ, njuhə te ŋkɔʼnə ndə bə kə kɔ̀ʼnə tʉ Ablahaŋ.<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="m">
    <verse number="1" style="v" sid="GAL 4:1" />Nukə ndə mɔ tʉʼ gìe nɔ bɛ mbɔ kaʼ nju bɛ vaambuɔ, ɔ bɛ ŋkʉʉ ndəŋ fʉə fɛ, bɔŋ ndə nɔ, nɔ kie haʼ ɔ kie fɔbə inchəŋ <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />ɔ bɔŋ kie bʉə ndə bɔ̂ŋ tʉʼ lɛ́nə ɔŋ bɔŋleʼ lɛ́nə fɔbə-i tə chîkə yi kʉ̀ʼnə ndə tie-e nɔʼ kə kɔ̀ʼnə. <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />Nɔ bɛ haʼ nɔ, vɛʼ ndə mbəŋ-yʉʼʉ kə bíe vâambuɔ bʉʼʉ nɔ kə bɛ fʉəhə ndə ntɛhə ndə bə kə́ fəŋ chìi nubə kəwʉʉnəmbi-fɛ̄ŋ.<verse eid="GAL 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 4:4" />Bɔŋ ndʉʉ ndə mbʉ ŋgwɔʼmbi kə kʉ̀ʼnə, Nyii tə́ŋ vaa-ɛ, woke bí ɔ, vɛʼ ndə bə nə kə́ bíe tʉ́ʼ nuʼ-Mushi, <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />mbɔ ɔ chʉʼ chʉ̀ʼ tʉ-bʉə-kə hə ndəŋ nuʼ ndə i tʉʼ yá bɔŋ, mbɔ Nyii chʉʼ lʉ̀ bʉʼʉ ndə vâanchinə-bi. <verse eid="GAL 4:5" /><verse number="6" style="v" sid="GAL 4:6" />Bʉʼka bʉʼʉ bɛ vâa-bi, mbʉ Nyii nɔʼ tə́ŋ Lyʉʉhə-vaa-ɛ-kə kɔ́ mu mbʉə-bʉʼʉ, ɔ tʉʼ tíi mbɔ, “Baba, Baba-Tie-yaʼ.” <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />Nɔ, a leʼbie fʉə fɛ, bɔŋ a nɔ vaa-ɛ, kaʼ bɛ mbɔ a bɛ vaa-ɛ, təmə a nɔ bɛ nju-i tíŋ bɔ̂ŋ Nyii.<verse eid="GAL 4:7" /></para>
  <para style="s">Fyii ndə Bɔɔ kie tʉ bʉə-Galatia</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />Vɛʼ bəshʉ ndə bii kə gòʼ təmə kínə Nyii fɛ, fɔbə ndə bɔ̂ŋ gòʼ təmə bɛ bənyii fɛ, nɔ nə lʉ́əŋ bii. <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />Bɔŋ nduɔ, ndə bii nɔʼ kínə Nyii nɔ, byuunɔ mbɔ mbəŋ-ɛŋ Nyii nɔʼ kínə bii, bəkɔ bii bʉ̀nə kíahə ŋwɔŋ-yii tʉ fɔbə ndə bɔ̂ŋ lʉ́ʉtə bɔŋleʼ bɛ njʉnjʉ kəwʉʉnəmbi-fɛ̄ŋ, kə́ kʉ́ʉ mbɔ bii bʉ̀nə bìʼ bɛ fʉəhə-ʉə təka? <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />Bii nɔ tʉʼ búu chîmbibə ghɔŋbə bəchi, kə́ búu ləŋkə ghɔŋbə byʉʉkə, kə́ leʼ búu ŋgʉʼʉmbihə! <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />Mɔ nɔ tʉʼ fàa mbɔ ndʉʉbɛʼ mɔ nɔʼ nyíɛ ŋgʉəʼ kətʉ-bii njʉnjʉ.<verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />Bəliŋ-bɔŋ, mɔ nɔ tʉʼ fʉ̀ʉtə bii, b̈ii bɛ nə mɔ, bʉʼka mɔ nɔʼ bɛ nə bii. Bii chʉʼ chìi bʉ̂ʼʉ tʉ mɔ fɛ. <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />Bii nɔ kínə mbɔ nɔ bɛ bʉʼka mbʉə-ɔ kə bʉ̀ʉ fɛ, ndə i chìi mɔ buŋ lɔ̀ʼ ntəŋjyujyu tʉ bii fəŋ. <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />Buŋ ndə nɔ, ntɛhə ndə mɔ kə bɛ muŋgɔ, nɔ kə kə́ kʉ̌ʉ chìi bii kie tʉ-kwú-kə ndəŋ mɔ, bìe mɔ mɛ̀ʼ, bii bɔŋleʼ lʉ̀ mɔ nə wontəŋNyii byuunɔ nə Klai Jiso. <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />Ntɛ tʉʉjyu-i ba ndə bii kə fəŋ kie le? Mɔ nɔ nə kínə mbɔ kaʼ i kʉ̌ʉ kə yùhə təmə bii nɔ nə chóʼ shʉtə-ii kɔ́ tʉ mɔ. <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />Mɔ bʉ̀nə bə̀ŋ wobàa-yii nduɔ bʉʼka shʉəŋ ndə mɔ gìe tʉ bii mɛ? <verse eid="GAL 4:16" /><verse number="17" style="v" sid="GAL 4:17" />Bʉə-Juu-bɔ̄ŋ ndə bɔ̂ŋ tə́nə ndəŋ nuʼ nɔ, nɔ tʉʼ kʉ́ʉ bə ndə məlʉ̀ bii kɔ́ mbʉə bɔŋ, bɔŋ təmə mu fyiihə-ʉə kə bɛ jyujyu fɛ. Nukə ndə bɔ̂ŋ tʉʼ kʉ́ʉ nɔ bɛ haʼ ndə məbyùutə bii mbʉə mɔ, mbɔ bii chʉʼ kɔ́ ŋwɔŋ-yii tʉ bɔŋ. <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />I nɔ bʉ̀ʉ ndə məkie ntɛ fyii-jyujyu-maa-ɔ̄ŋ təvɛʼtəvɛʼ kaʼ luu-i bɛ jyujyu, kaa bə haʼ mbɔ i bɛ ndʉʉ ndə bʉʼʉ bɛ mɔʼɔ fɛ.<verse eid="GAL 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 4:19" />Vâa-bɔ̄ŋ, i nɔ bɛ fi nə mɔ bʉ̀nə bìʼ bɛ ndəŋ yɔʼ-Nyii-kə nə bii, ndə i bu gɛ̀ nə shʉbə tʉ nuʼ-Klai yú mu mbʉəhə-ii. <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />Mɔ nɔ tʉʼ gwìa mbɔ bʉʼʉ kʉ̌ʉ bɛ nduɔ mɔʼɔ, təmə mɔ nɔ kwɛ́nə gyʉʉ-ɔ, bʉʼka mbɔ fyii-ɔ tʉʼ chɔ́ŋhə mɔ te bii.<verse eid="GAL 4:20" /></para>
  <para style="s">Ndə məfʉ̀ʼ nukə ndəŋ Haga ghɔŋ Sala</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />B̈ii shyíi mɔ, mbəŋ-yii ndə bii kʉ̀ʉ ndə mətə́nə ndəŋ nuʼ-Mushi, bii nɔʼ kə yʉ́ nukə ndə nuʼ kə ghɔ̀ŋ fe? <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />Bə nɔ nyɔ̀ʼ mu ŋwɔʼnə-Nyii mbɔ Ablahaŋ nɔ nə kie vâabələŋ bəbûu, bí fʉə-e bí imɔʼ ibɛʼ-yə bí ŋkɛŋ vi-i. <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />Bɔŋ vaa ndə bí woke ndə ɔ kə bɛ fʉə le, bə bí ɔ ndə ŋkʉʉnə tʉʉ woməsʉʉ, bɔŋ vaa ndə bí ŋkɛŋ vi-i, bə bí ɔ bʉʼka Nyii nɔʼ kə kɔ̀ʼnə.<verse eid="GAL 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 4:24" />Nduɔ, bəkɔ bə lʉ̀ nukə-ɔ̄ŋ ndə fʉʼkənu mbɔ bəke-bɔ̄ŋ bəbûu nɔ bɛ cheʼ-məŋkaa-bə ibûu. Fəŋ woke, Haga, nɔ bɛ nə Kwɔŋ Sina, ndə ɔ kə́ bí vâa ndə bɔ̂ŋ bu bɛ fʉəhə. <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />Nduɔ, Haga nɔ bɛ nə Kwɔŋ Sina mu Alabia, kə́ bɛ nə Jɛlosalɛŋ laa, ɔ nɔ tʉʼ fɔ̀ʼ fʉəhə ghɔŋbə vâa-bi. <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />Bɔŋ Jɛlosalɛŋ ndə i bɛ yuo kaa fʉə fɛ, ɔ bɔŋ-kə́-leʼ bɛ naa-yʉʼʉ. <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />Bʉʼka bə nɔ nyɔ̀ʼ mu ŋwɔʼnə-Nyii mbɔ,</para>
  <para style="q1" vid="GAL 4:27">“T̈ʉʉ-a kə́ bʉ̀ʉ, woke ndə a gòʼ təmə kə́ bí fɛ.</para>
  <para style="q2" vid="GAL 4:27">Gwía bɔŋleʼ tíi nə ghʉəʼkə nə tʉʉjyu mbəŋ-aŋ ndə yɔʼ-Nyii-kə gòʼ təmə nɔʼ nə byùu a fɛ.</para>
  <para style="q3" vid="GAL 4:27">Bʉʼka vâa-woke ndə bə nɔʼ ké ɔ bu nə yɔ́ŋ tə chàa vâa-woke ndə ɔ fʉ̀ʼ woləŋ.”<note caller="+" style="f"><char style="fr" closed="false">4:27 </char><char style="ft" closed="false">Adaya 54:1.</char></note><verse eid="GAL 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28" />Nduɔ, bəliŋ-bɔŋ, bii nɔ bɛ nə Aisi, vâa ndə bə nɔʼ kə kɔ̀ʼnə. <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />Bɔŋ nɔ nə bɛ vɛʼ bəshʉ, vaa ndə bə kə bí ɔ ndə ŋkʉʉnə tʉʉ woməsʉʉ, chɔ́ŋhə vaa ndə bə kə bí ɔ nə LyʉʉhəNyiikə, nɔ bɛ haʼ ndə i bɛ laa. <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />Bɔŋ ŋwɔʼnə-Nyii ghɔŋ mbuka? “Jə̀ŋ woke ndə ɔ bɛ fʉə ghɔŋbə vaa-ɛ bʉʼka mbɔ vaa-woke ndə ɔ bɛ fʉə mə yú fɔ-tie-yʉə-bə ghɔŋ vaa-woke ndə ɔ gòʼ təmə bɛ fʉə fɛ.” <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />Nɔ, bəliŋ-bɔŋ, bʉʼʉ kaa vâa-woke ndə ɔ bɛ fʉə fɛ, bʉʼʉ nɔ bɛ vâa-woke ndə ɔ gòʼ təmə bɛ fʉə fɛ.<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s">Mu Jiso Klai tʉkə-ʉʼʉ nɔʼ lʉ́ʉ bʉʼʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />Nɔ kə bɛ mbɔ tʉkə-ʉʼʉ lʉ́ʉ bʉʼʉ ndə Klai kə fyúhə tʉkə-ʉʼʉ, nɔ b̈ii tə́nə shʉ́əshʉ́ə, təmə leʼ bʉ̀nə gɛ̀ mɔ̀ʼ lʉʉ-fʉəhə-kə mii-bii fɛ.<verse eid="GAL 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2" />B̈ii yʉ́, mbəŋ-ɔŋ Bɔɔ nɔ tʉʼ shyíi bii mbɔ, kaʼ a bɛ́ŋ mbɔ b̈ə fɔ̀ʼ a, i nɔ dʉ̀ʼ mbɔ Klai leʼ kie nubɛʼkə ndə məkwáa a chɔ fɛ. <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />Mɔ nɔ tʉʼ kʉ́ʉ bìʼ gìe tʉ wotəmiyɔŋ ndə ɔ bɛ́ŋ mbɔ b̈ə fɔʼɔ-ɔ, mbɔ ɔ nɔ kie ndə mətʉ́ʼ nuʼ inchəŋ. <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />Bii nɔʼ fɔ̀ʼ ŋwɔŋ-yii mbʉə-Klai, mbəŋ-yii ndə bii tʉʼ kʉ́ʉ tə́nə ndyʉndyʉ bəshʉ-Nyii bɛ nə mətʉ́ʼ nuʼ, bii nɔʼ fyúhə ŋwɔŋ-yii hə ndəŋ buuŋjyu-Nyii.<verse eid="GAL 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GAL 5:5" />Bɔŋ mbəŋ-yaʼ nɔ yʉ́əʼnə ndəŋ Nyii mbɔ ɔ bu chìi baʼa bɛ ndyʉndyʉ tʉ ɔŋ. Nɔ bɛ nukə nɔ ndə baʼa tʉʼ chyìi shʉ́əshʉ́ə nə ghʉəʼ-kəLyʉʉhəNyii-kə ndə ɔ tʉʼ fɔ̀ʼ bɛ mu mbʉə-baʼa tíŋ hə bɔ̌ŋ məmɔʼfyiihə-aʼ ndəŋ Klai. <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />Bʉʼka mbɔ ndʉʉ ndə baʼabə Klai Jiso bɛ nukə imɔʼ, bə kyinə túhə shʉ ndə wo ndə bə nɔʼ fɔ̀ʼ ɔ ndəŋ wo ndə bə gòʼ təmə nɔʼ nə fɔ̀ʼ ɔ fɛ, fɔŋ-kənu nɔ bɛ ndə məmɔ̀ʼfyii ndəŋ Jiso Klai, ndə ĩ dʉ̀ʼ ŋwɔŋ-ɛŋ ndəŋ ŋkʉ̂ʉ tʉ bəbɛʼbʉə.<verse eid="GAL 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7" />Bii nɔ fəŋ kə́ tòʼ jyujyu, bʉ̀nə byùutə nda byùutə bii ndə mətə́nə ndəŋ shʉəŋ? <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />Ntɛ ndoʼtə-ɔ̄ŋ mə gwè hə kəghɔ-Nyii ndə ɔ kə tíi bii fɛ. <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />Ñɔ bʉ́əhə haʼ mbyu kəkʉʼ bʉəbʉə imɔʼ bʉ́əhə kyʉʉ-kəkʉʼ.<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">Mu Babʉ Gili i nɔ ghɔ̀ŋ mbɔ </char><char style="it">B̃ə nɔ lʉ̀ haʼ vaadyʉʼʉ-yî məniʼ mɔ̀ʼ mu mbʉ̂ətə bobo, i chìi i kóʼ.</char></note> <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />Fyii-ɔ nɔ tə́nə ndəŋ Tiekətʉ mbɔ bii kʉʉ lʉ̀ ŋgie-kədɔŋ-kə tə tíŋ hə ndəŋ yi-yə ndə mɔ nɔʼ kə gìe tʉ bii fɛ, wotəmiyɔŋ ndə ɔ tʉʼ chɔ́ŋhə bii bu nyíɛ ŋgʉəʼ kəghɔ-Nyii kaʼ kʉ̀ʉ bɛ nda. <verse eid="GAL 5:10" /><verse number="11" style="v" sid="GAL 5:11" />Bɔŋ ndə mbəŋ-ɔŋ, bəliŋ-bɔŋ, mɔ kʉ̌ʉ kə́ bíe lɔ̀ʼ mbɔ b̈ə kə́ fɔ̀ʼ bʉə, təmə bə kə́ bíe chɔ́ŋhə mɔ mbuka? Kaʼ kʉ̌ʉ bɛ nɔ təmə ŋkyʉʉhəkə ndə tyʉntɔɔnəkə tʉ́ʼ bəshʉ bʉə nɔʼ kə chóʼnə. <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />Mɔ nɔ tʉʼ kʉ́ʉ mbɔ bʉə-bɔ̄ŋ ndə bɔ̂ŋ tʉʼ chɔ́ŋhə bii nɔ bu sáa buuhə-ʉə nə mbəŋ-yʉə fyúhə!<verse eid="GAL 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13" />Bʉʼka mbɔ bə nɔ nə tíi bii mbɔ tʉkə-ii lʉ́ʉ bii, bəliŋ-bɔŋ. Nɔ haʼ nduɔ mbɔ ndə tʉkə-ii nɔʼ lʉ́ʉ bii nɔ, kə bii məlʉ̀ yɔ̄ŋ-yə ndə mə-kə́-chìi nu-bʉəbʉə-bə ndə i bʉ̀ʉ tʉ bii fɛ. Bɔŋ b̈ii lʉ̀ ŋkʉ̂ʉ kwáa ŋwɔŋtə-ii nə yɔŋ. <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />Bʉʼka nchəŋnchəŋ bənu ndə nuʼ kə gìe nɔ bɛ mbyu kənu imɔʼ mbɔ, “Kʉ̀ʉ wo-kətoʼ-a ndə a kʉ̀ʉ ŋwɔŋ-aŋ.” <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />Bɔŋ kaʼ bii kə́ lə́ŋtə bɔŋleʼ kwó ŋwɔŋtə-ii nə nyaahə, b̈ii láa mbɔ bii məyítə ŋwɔŋtə-ii fɛ.<verse eid="GAL 5:15" /></para>
  <para style="s">Mə-kə́-chí mbi nə ghʉəʼ-kəLyʉʉhəNyii-kə</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />Bɔŋ mɔ nɔ tʉʼ ghɔ̀ŋ mbɔ b̈ii kə́ chí mbi nə ghʉəʼ-kəLyʉʉhəNyii-kə, kaʼ bii chìi nɔ, bii leʼ kə́ fɔ̀ʼ bə nubə ndə mbʉə-yii tʉʼ kʉ́ʉ fɛ. <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />Bʉʼka nubə ndə mbʉə-a kʉ̀ʉ kaa nubə ndə LyʉʉhəNyiikə kʉ̀ʉ fɛ, bɔŋ nubə ndə LyʉʉhəNyiikə kʉ̀ʉ kaa nubə ndə mbʉə-a kʉ̀ʉ fɛ, bʉʼka bɔ̂ŋ nɔ bàa nə shʉtə-ʉə, mbɔ i chʉʼ chìi a mɛ̀ʼtə ndə məchìi nubə ndə fyii-a tʉʼ kʉ́ʉ mbɔ a kə́ chìi. <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />Kaʼ a, bɔŋ kə́ tòʼ haʼ ndə LyʉʉhəNyiikə tʉʼ dʉ̀ʼ fia tʉ a, a leʼ kie ndə mə-yá nuʼ tʉ́ʼ fɛ.<verse eid="GAL 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19" />Ñubə ndə mbʉə-woməsʉʉ tʉʼ kʉ́ʉ, nɔ dʉ̀ʼ ŋwɔŋ-ɛŋ ntaa ndəŋ fia tʉ ɔŋ, bəsəŋ ntɛntɛhə, nu-nyàatəŋwɔŋ-bə leʼnə ŋkwɔʼtə-bəsəŋ, <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />məgháa bənyii, məfʉ́ʉ fê, bàa, bəfyuʼ, túunə bəfyuʼ, tʉʉbʉə, məshʉ́nə mbi, ŋkʉʉŋkʉʉ, məfúu nuɔ bʉəbʉə <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />məbàabʉʉ,<note caller="+" style="f"><char style="fr" closed="false">5:21 </char><char style="ft" closed="false">Bəbɛʼbəŋwɔʼnə kəŋgie-Gili nɔ biʼ </char><char style="it">məyí.</char></note> ndʉʼbúumə, mətʉ́ʼ kie-bəsəŋ-tə leʼnə ntɛ-bənu-hə ndə yɔ̄ŋ-yə. Mɔ nɔ tʉʼ shyùu tyunəkə-ii haʼ ndə mɔ nɔʼ kə fəŋ shyùu hə bəshʉ mbɔ bʉə ndə bɔ̂ŋ kie ntɛ məchimbi-ɔ̄, Nyii mə kə́ sɔ́ʼ bɔŋ fɛ.<verse eid="GAL 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22" />Bɔŋ L̃yʉʉhəNyiikə nɔ kʉ́ʉnə ŋkʉ̂ʉ, tʉʉjyu, fyiighʉ́ənə, məyá fyii, nuʼ jyujyu, məfɔ̀ʼ bʉʉ, məgìe shʉəŋ, <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />mbuɔnəbə leʼnə məyá ŋwɔŋ, ndəŋ nubə-ɔ̄ŋ nuʼ-Nyii kaa ghɔ ndə i tɛ́ŋ fɛ.<verse eid="GAL 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 5:24" />Bɔŋ bʉə ndə bɔ̂ŋ bɛ tʉ Klai Jiso nɔʼ kwɛ̀ŋ bɔŋleʼ yí nubə ndə mbʉə-yʉə tʉʼ kʉ́ʉ ghɔŋbə ntɔmə-i leʼnə jyʉʉ-i ndə i bɛ fyii-bɔŋ. <verse eid="GAL 5:24" /><verse number="25" style="v" sid="GAL 5:25" />Kaʼ bʉʼʉ kə́ chí mbi bʉʼka LyʉʉhəNyiikə, b̈ʉʼʉ kə́ tòʼ haʼ ndə LyʉʉhəNyiikə tʉʼ dʉ̀ʼ fia tʉ bʉʼʉ. <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />Kə bʉʼʉ mə kə́ chìi tʉʉ gʉənə fɛ, təmə kə́ chìi tʉʉ bəbɛʼbʉə kə́ byʉ́ʼ fɛ, təmə kə́ bàabʉʉ bəbɛʼbʉə fɛ.<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s">B̃ʉʼʉ nɔ kwɛ̀ fɔkə ndə bʉʼʉ bè</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />Bəliŋ-bɔŋ, kaʼ wo mu bii chìi bʉ̂ʼʉ təmiyɔŋ, m̈bəŋ-aŋ ndə a tə́nə shʉ́əshʉ́ə mu LyʉʉhəNyiikə bʉ̀nə chɔ̀ʼhə ɔŋ sê nə mbuɔnəbə, bɔŋ kə́ láa bʉʼka a məgwù ghɔ. <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />B̈ii kwáa bəliŋ-bii ndə məbɛ̀ʼ bɛʼkə-ʉə, bʉʼka kaʼ bii chìi nɔ bii tʉ́ʼ nuʼ-Klai. <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />Bʉʼka mbɔ kaʼ wo kə́ kwɔ̀ʼtə mbɔ ɔ bɛ fɔkə təmə bɔŋ bɛ yɔŋ fɛ, təmə ɔ nɔ tʉʼ fə́ʼhə ŋwɔŋ-ɛŋ. <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />Ẅo kə́ lɛ́nə yi-yə fɔ̀ʼ, kaʼ ɔ fɔ̀ʼ jyujyu ɔ kwɛ̀ŋ fyii-i bə ndə nukə ndə ɔ tʉʼ fɔ̀ʼ, təmə kə́ lɛ́nə bə yi-ibɛʼ-wo-yə fɛ. <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />Bʉʼka wotəmiyɔŋ nɔ kie ndə məbɛ̀ʼ yi-yə bɛʼkə.<verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />Wotəmiyɔŋ ndə bə tʉʼ dàhə ɔŋ nə ŋgieNyiikə, nɔ kie ndə məgyʉ̀ə fɔ-jyujyu-bə inchəŋ ndə ɔ kie ghɔŋ wo ndə ɔ tʉʼ dàhə ɔŋ. <verse eid="GAL 6:6" /><verse number="7" style="v" sid="GAL 6:7" />Kə bii mə fə́ʼhə ŋwɔŋ-yii fɛ, wo mədʉ̀ʉhə Nyii fɛ, bʉʼka ntɛ ŋgwie ndə wo shùɔ sê, nɔ bɛ haʼ yɔŋ ndə ɔ bu kwɛ̀. <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />Wo ndə ɔ tʉʼ shùɔ kə́ kʉ́ʉ mbɔ i kʉ̀ʼnə bə ndə nukə ndə mbʉə-e kʉ̀ʉ, fɔkə ndə ɔ bu kie ndəŋ ŋkʉʉnə tʉʉ-i bu bɛ kwu, bɔŋ wo ndə ɔ tʉʼ shùɔ ndə ntɛ ndə LyʉʉhəNyiikə kʉ̀ʉ bu kie məchímbi təmə liʼ-i ghɔ fɛ, kəghɔ-LyʉʉhəNyiikə. <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />Kə bʉʼʉ mə káa ndə mə-kə́-fɔ̀ʼ bʉʉ fɛ, bʉʼka mbɔ ndʉʉ bu yi kʉ̀ʼnə nɔ, bʉʼʉ kwɛ̀ ntɔŋmə-i, kaʼ bʉʼʉ gòʼ təmə káa fɛ. <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />Nɔ, kaʼ bʉʼʉ kie fia, b̈ʉʼʉ fɔ̀ʼ bʉʉ tʉ bʉə bənchəŋ, fɔŋ ɛŋ kə́ bɛ tʉ bʉə ndə bɔ̂ŋ mɔ̀ʼfyiihə-ʉə ndəŋ Nyii.<verse eid="GAL 6:10" /></para>
  <para style="s">Bɔɔ kɔ́ ndyiʼtə-tʉ̂ʼ-kə-i</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />B̈ii nyíɛ ntɛ shʉ ŋwɔʼnəkwɛʼtəŋ ndə mɔ tʉʼ nyɔ̀ʼ nə yɔŋ tʉ bii nə yɔŋ-yə ghɔkə. <verse eid="GAL 6:11" /><verse number="12" style="v" sid="GAL 6:12" />Bʉə ndə bɔ̂ŋ tʉʼ kwɛ̀ŋhə mbɔ b̈ii fɔ̀ʼ ŋwɔŋ-yii, nɔ bʉə ndə bɔ̂ŋ tʉʼ kʉ́ʉ ndə mə-kə́-dʉ̀ʼ ŋwɔŋ-yʉə nə ntɛ nuʼ-yʉə, bɔ̂ŋ nɔ tʉʼ chìi bʉʼka bə mə-yi-chɔ́ŋhə bɔŋ bʉʼka tyʉntɔɔnəkə ndə Klai kə kwú chɔ. <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />Buŋ bʉə-ghɔ̄bə ndə bə nɔʼ fɔ̀ʼ bɔŋ tʉʼ tʉ́ʼ nuʼ fɛ, bɔŋ bɔ̂ŋ kə́ kʉ́ʉ mbɔ b̈ə fɔ̀ʼ bii bɔ̂ŋ chʉʼ kə́ dʉ̀ʼ ŋwɔŋ-yʉə te nə bii ndə bə nɔʼ kə fɔ̀ʼ bii.<verse eid="GAL 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 6:14" />Tə Nyii byʉ̀hə nu-maa-kə-ɔ̄ŋ bɔ̌ŋ mɔ, mbɔ kə mɔ mə nə dʉ̀ʼ ŋwɔŋ-ɔŋ ndə nubɛʼkə fɛ, yaʼkɛŋ kwú Jiso Klai Tiekətʉ, ndəŋ tyʉntɔɔnəkə, ndə bə nɔʼ kwɛ̀ŋ nuʼ kəwʉʉnəmbi-ɔ̄ ndəŋ ghɔ yí tʉ mɔ, mbəŋ-ɔŋ bɔŋleʼ kwú ndəŋ ghɔ tʉ wʉʉnəmbikə. <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />Bʉʼka məfɔ̀ʼ wo byuunɔ məgòʼ təmə fɔ̀ʼ wo fɛ, bɛ nubɛʼkə fɛ, fɔŋ-kənu nɔ bɛ mbɔ a bɛ wo fefe mu Jiso Klai. <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />Bʉə bənchəŋ ndə bɔ̂ŋ tə́nə ndəŋ ŋgiekə-ɔ̄ŋ, Nyii kie fyiighʉ́ənə bɔŋleʼ dʉ̀ʼ buuŋjyu tʉ bɔŋ, bɔŋleʼ kie ghɔ ndəŋ bʉə-Isilɛ ndə bɛ yi-Nyii-yə.<verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />Nɔ, lʉ̀ hə nduɔ gɛ̀ nə shʉbə, kə wobɛʼ mə kə́ leʼ chɔ́ŋhə mɔ fɛ, bʉʼka cheʼ-ŋgwɔŋ-bə nɔ nʉ̀ʉtə mbʉə mɔ, yie-Jiso.<verse eid="GAL 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18" />Bəliŋ-bɔŋ, tʉ Jiso Klai Tiekətʉ-yʉʼʉ, dʉ̀ʼ buuŋjyu-i tʉ bii bənchəŋ mu fyii-bii. Ï bɛ haʼ nɔ.<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>