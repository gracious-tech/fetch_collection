<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TH" style="id">- Bamunka New Testament</book>
  <para style="h">1 Tɛsalonika</para>
  <para style="toc1">Fəŋ ŋwɔʼnə ndə Bɔɔ kə nyɔ̀ʼ kɔ́ tə Chɔshi ndə i bɛ Tɛsalonika</para>
  <para style="toc2">1 Tɛsalonika</para>
  <para style="toc3">1Tɛ</para>
  <para style="mt2">Fəŋ ŋwɔʼnə ndə Bɔɔ kə nyɔ̀ʼ kɔ́ tʉ</para>
  <para style="mt2">Chɔshi ndə i bɛ</para>
  <para style="mt1">Tɛsalonika</para>
  <para style="imt">Nchoʼtə bətʉ bənu</para>
  <para style="ip">Chɔshi ndə i kə bɛ mu Tɛsalonika nɔ nə chʉ́ʉhə Bɔɔ. Bʉə-Juubɛʼbə nɔ kə́ kwə́ʼ bʉəbʉə te fɔʼɔ Bɔɔ ndə i kə́ tòʼ jyujyu mu bʉə ndə bɔ̂ŋ kə́ gɛ̀ hə bɔ̌ŋ bʉə-Juu ndə ntɛ məghaaNyii-yʉə. Kwəʼ-bʉəbʉə-ɔ̄ chìi Bɔɔ lɔ̀ hə Tɛsalonika gɛ̀ Bɛlia. Kʉʉ-mbi-kə kʉ̂ʉ tíŋ ɔ lɔ̀ gɛ̀ Kɔlɛŋ, Timɔti fʉ̀ʼtə ntɛhə ndə nubə kə́ gɛ̀ mu Tɛsalonika tʉ ɔŋ. Ndʉʉmɛ, Bɔɔ nyɔ̀ʼ ŋwɔʼnə ndə məkwèʼhə bɔŋleʼ kɔ́ fyii tʉ bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii chɔ.</para>
  <para style="ip">Bɔɔ kɔ́ ndɔ tʉ Nyii ndə məbɛ́ŋ Nyii-yʉə leʼnə ŋkʉ̂ʉ ndə bɔ̂ŋ kie bɔŋleʼ kwɛ́nə tʉ bɔŋ te ntɛ-məchimbi-i ndə ɔ kə́ chí ndʉʉ ndə ghɔŋ bɔŋ kə bɛ mɔʼɔ, leʼ bìʼ tóʼtə mu-kətʉ-hə-ʉə te mbiʼtə ndə i kə gwè hə mu chɔshi te məbʉ̀nə bìʼ gwè Klai.</para>
  <para style="ip">Tʉ-chɔshi-kə-ɔ̄ŋ nɔ kə kwú te bʉə ndə bɔ̂ŋ kə fəŋ kwútə Jiso buŋ nə bʉ̀nə gwè, bɔŋleʼ mbɔ Jiso bu yi bʉ̀nə gwè ndə yɔ̂ŋ-yə ŋgwɔʼmbi.</para>
  <para style="ip">Ndʉʉmɛ, Bɔɔ bə̀ŋhə nubə-ɔ̄ŋ bɔŋleʼ shyíi bɔŋ mbɔ bɔ̂ŋ la gɛ̀ nə shʉbə ndə mə-kə́-fɔ̀ʼ fɔʼɔ-yʉə nə fyii tə́nə la kə́ chyìi məbʉ̀nə bìʼ gwè Jiso.</para>
  <para style="iot">Nubə ndə i bɛ mu ŋwɔʼnə-fɛ̄ŋ</para>
  <para style="io1">Nchʉʉhə-bənu 1:1</para>
  <para style="io1">Ndɔ ghɔŋbə məchʉ̀ʉ 1:2–3:13</para>
  <para style="io1">Məkwèʼhə bʉə mbɔ bɔ̂ŋ dʉ̀ʼ nuʼ bəKʉlʉtɛŋ 4:1-12</para>
  <para style="io1">Tʉ̂ʼ te məgwè-Klai 4:13–5:11</para>
  <para style="io1">Ndyiʼtə-məkwèʼhə-kə 5:12-22</para>
  <para style="io1">Liʼ-bənu 5:23-28</para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="s">Nchaʼtə ndə i gwè hə kəghɔ-Bɔɔ</para>
  <para style="m">
    <verse number="1" style="v" sid="1TH 1:1" />Nɔ nyɔ̀ʼ Bɔɔ, Sabanu<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Nɔ bɛ ibɛʼ-yə yie-wo ndə bə kə́ tíi ɔ nə Sala.</char></note> leʼnə Timɔti nyɔ̀ʼ ŋwɔʼnə-ɔ̄ŋ.</para>
  <para style="p" vid="1TH 1:1">Baʼa nɔ tʉʼ nyɔ̀ʼ tʉ bʉə-chɔshi mu Tɛsalonika ndə bɔ̂ŋ bɛ tʉ Nyii mbʉ Tie-yʉʼʉ ghɔŋbə Tiekətʉ-yʉʼʉ Jiso Klai.</para>
  <para style="p" vid="1TH 1:1">Tə buuŋjyu-Nyii ghɔŋbə fyiighʉ́ənə bɛ tʉ bii.<verse eid="1TH 1:1" /></para>
  <para style="s">Ntɛ ndə bʉə-Tɛsalonika ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii mɔ̀ʼfyiihə-ʉə ndəŋ Nyii</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />B̃aʼa nɔ chʉʼ kɔ́ ndɔ tʉ Nyii yie-bii bənchəŋ bɔŋleʼ kwɛ́nə bii təvɛʼtəvɛʼ ndʉʉ ndə baʼa tʉʼ gháaNyii. <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />Baʼa kə́ kwɛ́nə bii bəshʉ-Nyii mbʉ Tie-yʉʼʉ, te ntɛ-fɔʼɔ-yii ndə i gwè hə ndəŋ məmɔʼfyiihə-ii ndəŋ Nyii, ntɛ-fɔʼɔ ndə bii kə fɔ̀ʼ tʉ bəbɛʼbʉə bʉʼka ŋkʉ̂ʉ ndə bii kie tʉ bɔŋ leʼnə ntɛ ndə bii kə lyʉ̀ʉtə́nə ndə məyʉ́əʼnə ndəŋ Jiso Klai Tiekətʉ-yʉʼʉ.<verse eid="1TH 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 1:4" />Bʉʼka baʼa nɔ kínə mbɔ, bəliŋ-baʼa, ndə Nyii kʉ̀ʉ, mbɔ ɔ nɔʼ séʼ bii ndə məbɛ yi-yə bʉə. <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />Bʉʼka baʼa nɔ kə gwè nə ntəŋjyujyu tʉ bii təmə bɛ bə haʼ nə ŋgie-chu-kə fɛ i bɔŋ nɔ kə leʼ bɛ nə ghʉəʼkə ghɔŋbə LyʉʉhəNyiikə baʼa bɔŋleʼ kə kínə shʉəŋ-ɛŋ gɛ̀ kùu. Bii nɔ kínə ntɛ-bʉə ndə baʼa kə dʉ̀ʼ tʉ bii ndə məbɛ yɔŋ ndʉʉ ndə bʉʼʉ kə bɛ mɔʼɔ, i nɔ nə bɛ ndə bʉʉ-yii. <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" />Bii nɔ nə lʉ̀ hə kəwu-baʼabə Tiekətʉ. Buŋ ndə bii kə nyíɛ ŋgʉəʼ daa ndʉʉ ndə mbʉ kəŋgie kə gwè tʉ bii, bii nɔ kə fí nə tʉʉjyu ndə LyʉʉhəNyiikə kɔ́ tʉ bii. <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />Nɔ, bii nɔ bɛ fʉʼkənu tʉ bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii bənchəŋ mu Masɛdonia leʼnə Akia. <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />Bʉʼka ntəŋ Tiekətʉ ndə i kə gwè hə kəghɔ-bii kə bʉ́ʼ haʼ kətyunə bʉə-Masɛdonia ghɔŋbə Akia fɛ, bɔŋ bəsɔʼka te məmɔʼfyiihə-ii ndəŋ Nyii nɔʼ kə wɔ̀ʼnə gɛ̀ ndə yəŋbə inchəŋ. Nɔ, i nɔ kə chìi təmə baʼa leʼ kie nubɛʼkə ndə məgìe tʉ bʉə te bii fɛ. <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />Bʉʼka bɔ̂ŋ bənchəŋ nɔ tʉʼ kwə́ʼ te ntɛ ndə bii kə fí baʼa ndə ndʉʉ ndə baʼa kə gwè tʉ bii, leʼnə ntɛ ndə bii kə shìe liɛŋtə-ii ndəŋ bənyii, kíahə ŋwɔŋ-yii tʉ Nyii ndə mə-kə́-fɔ̀ʼ tʉ Nyii-shʉəŋ ndə ɔ bɛ ŋɛnə. <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />Bɔŋleʼ kə́ chyìi Vaa-ɛ ndə məgwè hə yuo, ndə ɔ kə bʉ̀nə kóʼhə ɔŋ ndʉʉ ndə ɔ kə kwú, Jiso ndə ɔ chʉ̀ʼ tʉkə-ʉʼʉ ndəŋ tʉʉbʉə shʉ́əshʉ́ə Nyii ndə i tʉʼ gwè.<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s">Fɔʼɔ-Bɔɔ mu Tɛsalonika</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />Bəliŋ-baʼa, mbəŋ-yii nɔ kínə mbɔ məgwè ndə baʼa kə gwè nyíɛ bii kə bɛ njʉnjʉ fɛ. <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" />Bii nɔ nə kínə ntɛ ndə bə nɔʼ kə kɔ́ ŋgʉəʼ tʉ baʼa bɔŋleʼ mɔ̀ʼ tʉvyiikə-aʼ mu Filibai baʼa buŋ gwè tʉ bii mu Tɛsalonika. Bɔŋ ndə bə kə chɔ́ŋhə baʼa yɔ́ŋyɔ́ŋ, Nyii-yʉʼʉ kɔ́ baʼa nə fyii ndə məshyíi bii nə ntəŋjyujyu ndə i gwè hə kəghɔ-ɔ. <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />Bʉʼka məkwèʼhə ndə baʼa kə kwèʼhə bʉə kə bɛ mɔ̀ʼmbɛ fɛ byuunɔ i kə bɛ ndə luu bʉəbʉə fɛ, byuunɔ baʼa nə kə́ kɔ̀ɔtə ndə məfə́ʼhə wo fɛ, <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />baʼa bɔŋ nɔ nə kə́ kwə́ʼ haʼ ndə Nyii kə kʉ̀ʉ mbɔ baʼa kwə́ʼ, bʉʼka mbɔ ɔ nɔ nə lɛ́nə baʼa, baʼa kʉ̀ʼnə ndə məkɔ́ mbʉ ntəŋjyujyu tʉ baʼa. Baʼa kə́ kwə́ʼ ndə məchìi tʉʉ woməsʉʉ bʉ̀ʉ fɛ, bɔŋ bə ndə məchìi tʉʉ-Nyii bʉ̀ʉ ndə ɔ kə kíi ŋkwɔʼtə-yaʼ. <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />Bii nɔ kínə jyujyu mbɔ baʼa kə gwè tʉ bii nə ŋgie-ndoʼtə-bə ndə məfə́ʼhə bii fɛ, byuunɔ gwè nə ŋgiebə ndə mə bɔ̀ŋ ntɔmə-aʼ chɔ fɛ. Bəkɔ Nyii nú gwù yaʼ. <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />Baʼa kə́ kʉ̀ʉ məgʉ́ə bə kəghɔ-woməsʉʉ fɛ, təkɔmə mbəŋ-yii byuunɔ bəbɛʼbʉə fɛ, <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />buŋ ndə bəlɔntəŋ-Klai, baʼa nɔ kə kie ndə məbíʼtə hə kəghɔ-bii, baʼa bɔŋ nɔ kə bɛ nə vâambuɔ mu bii. Ndə ŋkwê vaa ndə ɔ tʉʼ nyùuhə bɔŋleʼ lɛ́nə vâa-bi, <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />nɔ, bʉʼka ŋkʉ̂ʉ ndə baʼa kə kie tʉ bii daa, fyiihə-aʼ kə bʉ̀ʉ ndə məgyʉ̀ə bə haʼ ntəŋjyujyu tʉ bii ndə i gwè hə kəghɔ-Nyii fɛ, i kə bʉ̀ʉ ghɔ ndə məgyʉ̀ə məchimbi-yaʼ bʉʼʉ bʉʼka baʼa nɔ kə kʉ̀ʉ bii daa.<verse eid="1TH 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 2:9" />Ndə ŋgie-shʉəŋ-kə, bəliŋ-baʼa, bii kwɛ́nə ntɛ ndə baʼa kə fɔ̀ʼ bɔŋleʼ nyíɛ ŋgʉəʼ. Baʼa nɔ nə kə́ fɔ̀ʼ ndʉʉnəchî ghɔŋbə ndʉʉbətyuʼ bʉʼka mə yi bɛ bɛʼkə tʉ wotəmiyɔŋ, ndə baʼa kə́ lɔ̀ʼ ntəŋjyujyu-Nyii. <verse eid="1TH 2:9" /><verse number="10" style="v" sid="1TH 2:10" />Bəkɔ biibə Nyii nú gwù-yaʼ mbɔ ntɛ ndə baʼa kə lʉ̀ ŋwɔŋ-yaʼ mu bii ndə bii nɔʼ bɛ́ŋ Nyii, baʼa nɔ nə tʉ́ʼ ŋwɔŋ-yaʼ tʉ́ʉnə, bɛ ndyʉndyʉ, təmə kie kwɔtəkə mbʉə-baʼa fɛ. <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />Bii nɔ kínə mbɔ baʼa nɔ nə lʉ̀ wotəmiyɔŋ mu bii haʼ ndə tie-vaa lʉ̀ vâa-bi le. <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />Baʼa nɔ nə kə́ kwèʼhə bii, kə́ yá fyiihə-ii, kə́ lyuu bii mbɔ b̈ii kie ntɛ məchímbi ndə i bu kʉ̀ʼnə tʉ Nyii, ndə ɔ tíi bii mu sɔ́ʼ-ɛ ndə məgwè lʉ̀ yi-yə yʉʉ mu məgʉə-e.<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />Baʼa bɔŋ kə́ kɔ́ ndɔ təvɛʼtəvɛʼ mbɔ ndʉʉ ndə bii kə yʉ́ ntəŋ-Nyii, ndə bii kə yʉ́ hə kəghɔ-baʼa, bii bɛ́ŋ, təmə bɛ́ŋ bə ndə ntəŋ ndə i gwè hə kəghɔ-woməsʉʉ fɛ, bɔŋ lʉ̀ ndə ntəŋ ndə i gwè hə kəghɔ-Nyii, ndə i kɛŋ bɛ yɔŋ. Ŋgiekə-ɔ̄ŋ bɔŋ nɔ tʉʼ leʼ fɔ̀ʼ mu mbʉə-bii ndə bii nɔʼ bɛ́ŋ Nyii. <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" />Bəliŋ-baʼa, ntɛ-kənu ndə i kə fyú tʉ bii nɔ bɛ haʼ ntɛ ndə i kə fyú tʉ bəchɔshi-Nyii mu Judia ndə bɔ̂ŋ bɛ mu Klai Jiso. Bii nɔ nə nyíɛ mbʉ ntɛ-ŋgʉəʼ ndə bɔ̂ŋ kə nyíɛ kəghɔ-bʉə-Juu. <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" />Bʉə-Juu-bɔ̄ŋ, bɔ̂ŋ nɔ nə yí Tiekətʉ ndə bɛ Jiso ghɔŋbə bʉəyʉkəŋgieNyii, jə̀ŋ baʼa fyúhə mu bɔŋ bɔŋleʼ chìi tʉʉ-Nyii byʉ́ʼ. Bɔ̂ŋ bɔŋleʼ chyʉ́nə tʉ bʉə bənchəŋ. <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />Bɔ̂ŋ kə́ byùutə baʼa ndə məkwə́ʼ tʉ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ, bʉʼka Nyii mə yi kwáa bɔŋ. Nɔ bɛ ntɛ nɔ ndə bɔ̂ŋ kóʼhə bʉ̂ʼʉ ndəŋ bɔŋ tə i dìenə tə daa ndəŋ fʉʼ ndə Nyii nɔʼ kə shʉ̀tə. Bɔŋ kə̂lìʼtə, tʉʉbʉə-shʉ́əshʉ́ə-Nyii nɔʼ shíʼ ndəŋ bɔŋ ntaa.<verse eid="1TH 2:16" /></para>
  <para style="s">Timɔti kwə́ʼ jyujyu te mbʉ chɔshi</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />Ndə baʼa, bəliŋ-baʼa, ndʉʉ ndə bə kə wɔ̀ʼtə baʼa mbʉə bii ndə kʉʉkə məniʼ, nə mbʉəhə-ʉʼʉ təmə bɛ nə ŋkwɔʼtə fɛ, baʼa kə́ gwía ndə baʼa nɔʼ bɛ́ bii, kə́ kɔ̀ɔtə mbɔ bʉʼʉ bʉ̀nə bìʼ nyíɛnə shʉtə-ʉʼʉ. <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />Baʼa nɔ nə kə́ kʉ́ʉ ndə məbʉ̀nə bìʼ gwè nyíɛ bii, mɔ nə mbəŋ-ɔŋ Bɔɔ, kɔ̀ɔtə tə bìʼ kɔ̀ɔtə, təmə Sata bɔŋ mɛ̀ʼtə baʼa chɔ fɛ. <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />Bʉʼka fɔkə ndə baʼa tʉʼ yʉ́əʼnə ndəŋ ghɔ byuunɔ tʉʉjyu-yaʼ byuunɔ ŋgʉʼʉ-yaʼ ndə baʼa bu nə kwɛ̀ŋ fyiihə-aʼ chɔ ndʉʉ ndə Jiso Tiekətʉ-yʉʼʉ bu yi bʉ̀nə gwè chɔ, bɛ ka? Kaa bii fe? <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />Bʉʼka bii nɔ bɛ məgʉə-yaʼ leʼnə tʉʉjyu-yaʼ.<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />Kə̂lìʼ, ndʉʉ ndə baʼa kə mə-leʼ-bìʼ yá fyii-yaʼ gɛ̀ nə shʉbə fɛ, baʼa kwɔ̀ʼtə mbɔ nɔ bʉ̀ʉ baʼa káa Atɛŋ tətɛʼ baʼa chìi chɔ, <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />tə́ŋ Timɔti liŋ-yaʼ mu njaa-Nyii, ndə baʼa bɔŋ tʉʼ fɔ̀ʼ tʉ Nyii mɔʼɔ ndə məlɔ̀ʼ ntəŋjyujyu te Klai, mbɔ ɔ yá bii tʉ́ʼ bɔŋleʼ kwèʼhə bii ndə məmɔʼfyiihə-ii ndə bii mɔ̀ʼ ndəŋ Nyii. <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />Baʼa nɔ kə chìi mbɔ wo hə mu bii mə yi gwù bʉʼka məchɔ́ŋhə ndə bə tʉʼ chɔ́ŋhə bii fɛ. Bʉʼka bii nə mbəŋ-yii nɔ kínə ntɛ-ŋgʉəʼ-maa-ɔ̄ŋ, nɔ bɛ ntɛ-kənu ndə Nyii kʉ̀ʉ mbɔ bʉʼʉ tíŋ hə muŋgɔ. <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />Bʉʼka ndʉʉ ndə baʼa kə bɛ bʉʼʉ mɔʼɔ, baʼa kə́ shyíi bii bəshʉ mbɔ bʉʼʉ la bu yi nyíɛ ŋgʉəʼ, haʼ ndə i nɔʼ fyú sê, bii kə́ kínə.<verse eid="1TH 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1TH 3:5" />Bʉʼka yɔ̄ŋ-yə, ndʉʉ ndə mɔ kə mə leʼ bìʼ yá fyii-ɔ fɛ, mɔ tə́ŋ Timɔti tʉ bii ndə məkínə nukə te məmɔʼfyiihə-ii ndəŋ Nyii, kə́ fàa mbɔ ndʉʉbɛʼ Sata, wo ndə ɔ̃ mùutə bʉə ndə məgwù mu bʉʼʉ nɔʼ mùutə bii təmə bii leʼ kə́ mɔ̀ʼfyiihə-ii ndəŋ Klai fɛ, ŋgʉəʼ-yaʼ bɛ njʉnjʉ. <verse eid="1TH 3:5" /><verse number="6" style="v" sid="1TH 3:6" />Bɔŋ nduɔ, Timɔti nɔʼ bʉ̀nə gwè shyíi baʼa nə bəsɔʼka jyujyu te məmɔʼfyiihə-ii ndəŋ Nyii leʼnə ŋkʉ̂ʉ ndə bii kie. Ɔ nɔ shyíi baʼa mbɔ bii la tʉʼ kwɔ̀ʼtə baʼa jyujyu, kə́ kʉ́ʉ ndə mənyíɛ baʼa, haʼ ndə baʼa tʉʼ kʉ́ʉ ndə mənyíɛ bii, <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />bʉʼka yɔ̄ŋ-yə, bəliŋ-baʼa, ndə nchəŋnchəŋ ŋgʉəʼ leʼnə mbʉə liŋnə ndə baʼa bɛ muŋgɔ, bəsɔʼka-yii te məmɔʼfyiihə-ii ndəŋ Nyii nɔʼ yá fyiihə-aʼ. <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />Fyiihə-aʼ nduɔ nɔ bʉ̀nə bɛ jyujyu bʉʼka baʼa nɔ kínə mbɔ bii nɔ tə́nə shʉ́əshʉ́ə biibə Tiekətʉ.<verse eid="1TH 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 3:9" />Nduɔ bɛ ntɛ-ndɔ ka ndə bəkɔ baʼa kɔ́ tʉ Nyii yie-bii? Baʼa nɔ tʉʼ kɔ́ ndɔ ɛ bʉʼka nchəŋnchəŋ tʉʉjyu ndə baʼa kie bəshʉ ɔ yie-bii. <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />Bɔŋleʼ kə́ gwía tʉ ɔŋ shʉ́əshʉ́ə ndʉʉnəchî ghɔŋbə ndʉʉbətyuʼ mbɔ bʉʼʉ yi nyíɛnə shʉtə-ʉʼʉ, baʼa chʉʼ mìʼtə fɔkə ndə i tʉʼ byúu mu məchimbi-yii te məmɔʼfyiihə-ii ndəŋ Nyii.<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />Nduɔ, N̈yii, mbʉ Tie-yʉʼʉ nə mbəŋ-ɛŋ leʼnə Jiso Tiekətʉ-yʉʼʉ shʉ̀tə fia tʉ baʼa ndə məbʉ̀nə gwè tʉ bii. <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />Tə mbʉ Tiekətʉ chìi ŋkʉ̂ʉ-yii te ŋwɔŋtə-ii leʼnə bʉə bənchəŋ gɛ̀ nə shʉbə yɔ́ŋyɔ́ŋ, gʉ́ə tə bɛ nə yaʼ-yə ŋkʉ̂ʉ tʉ bii. <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />Baʼa nɔ tʉʼ gháa yɔ̄ŋ-yə mbɔ Nyii, mbʉ Tie-yʉʼʉ chʉʼ kwèʼhə bii, bii kɛŋ bɛ təmə kwɔtəkə fɛ bɔŋleʼ bɛ ŋkʉʉ bəshʉ ɔ ndʉʉ ndə Jiso Tiekətʉ-yʉʼʉ bu gwè ghɔŋbə bʉə-bi bənchəŋ.<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s">Kə chí mbi kɔ́ tʉʉjyu tʉ Nyii</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />Ndə məlìʼtə ndʉʉmɛ, bəliŋ-baʼa, baʼa nɔ tʉʼ fʉ̀ʉtə bii bɔŋleʼ kə́ kwèʼhə bii yie-Jiso Tiekətʉ mbɔ haʼ ndə bii nɔʼ kə yétə kəghɔ-baʼa ntɛ ndə bii kie ndə mə-kə́-chí mbi ndə məkɔ́ tʉʉjyu tʉ Nyii, haʼ ndə bii tʉʼ chìi, b̈ii kə́ fɔ̀ʼ haʼ nɔ tə buŋ biʼ fɔ̀ʼ yɔ́ŋyɔ́ŋ. <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />Bii nɔ kínə nukə ndə baʼa kə kàhə bii tíŋ hə bɔ̌ŋ Jiso Tiekətʉ. <verse eid="1TH 4:2" /><verse number="3" style="v" sid="1TH 4:3" />Nyii nɔ kʉ̀ʉ mbɔ bii bɛ ŋkʉʉ, bii kɛŋ bìa ŋwɔŋ-yii ndə ntɛ-bəsəŋ-hə inchəŋ. <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />Ɔ nɔ kʉ̀ʉ mbɔ ẅo bii təmiyɔŋ kínə ntɛ ndə ɔ kie ndə mətʉ́ʼ ŋwɔŋ-ɛŋ<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">Bəkɔ bə kíahə yəŋkə-ɔ̄ŋ ghɔ mbɔ </char><char style="it">kínə ntɛ ndə ɔ kie ndə mədùʼ ghɔŋ vi-i.</char></note> bɛ ŋkʉʉ bɔŋleʼ kie kuŋhə chɔ. <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />Ɔ kie ndə məkie ntɔmə fyii-ɔ yɔ́ŋyɔ́ŋ ndə məchí ghɔŋ ibɛʼ-yə wo ndə bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ təmə kínə Nyii fɛ. <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />Ndə nukə-ɔ̄ŋ, kə wo məmɔ̀ʼ bɛ́ tʉ liŋ-iŋ byuunɔ yú ɔ chɔ fɛ bʉʼka Tiekətʉ nɔ bɛ wo ndə ɔ bu bʉ̀nə tyú nubə-ɔ̄ŋ inchəŋ haʼ ndə baʼa nɔʼ kə́ shyíi bii, bɔŋ kə́ bìʼ shyùu tyunəkə-ii. <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />Bʉʼka Nyii kə tíi bʉʼʉ ndə mə-kə́-nyàatə ŋwɔŋ fɛ bɔŋ mbɔ b̈ʉʼʉ bɛ ŋkʉʉ. <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />Nɔ, wo ndə ɔ tɛ́ŋ nukə-ɔ̄ŋ tʉʼ tɛ́ŋ bə woməsʉʉ fɛ, ɔ nɔ tʉʼ tɛ́ŋ bə Nyii ndə ɔ kɔ́ Lyʉʉhəkə-i tʉ bii.<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />Nduɔ, te ŋkʉ̂ʉ tʉ bəliŋ-bii, wo leʼ kie ndə mə-kə́-nyɔ̀ʼ tʉ bii fɛ, bʉʼka Nyii nə mbəŋ-ɛŋ nɔʼ dàhə bii ndə məkʉ̀ʉ ŋwɔŋtə-ii. <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />Bɔŋ kə́ bɛ ntɛ ndə bii tʉʼ fɔ̀ʼ tʉ bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii bənchəŋ mu Masɛdonia, baʼa bɔŋ-kə́-leʼ kwèʼhə bii, bəliŋ-baʼa, mbɔ b̈ii bìʼ fɔ̀ʼ yɔ́ŋyɔ́ŋ, <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />kə́ kɔ̀ɔtə ndə mədùʼ məchəŋ, ẅo kə́ gwía yi-yə tʉkə, kə́ fɔ̀ʼ nə ghɔkə-i haʼ ndə baʼa kə mɔ̀ʼ tʉ̂ʼ tʉ bii. <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />Kaʼ bii kə́ chìi mənɔ, bii kie yie jyujyu kəghɔ-bʉə ndə bɔ̂ŋ gòʼ təmə nɔʼ bɛ́ŋ Nyii fɛ, bii bɔŋleʼ kie ndə mə-kə́-yʉ́əʼnə ndəŋ wo ndə məchimbi-yii fɛ.<verse eid="1TH 4:12" /></para>
  <para style="s">Məbʉ̀nə gwè Tiekətʉ</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />Bəliŋ-baʼa, baʼa nɔ tʉʼ kʉ́ʉ mbɔ bii kínə shʉəŋ te bʉə ndə bɔ̂ŋ nɔʼ kwútə bʉʼka bii mə gòʼ vínəvínə ndə bʉə ndə bɔ̂ŋ gòʼ təmə kie yəŋkə ndə məyʉ́əʼnə ndəŋ ghɔ fɛ. <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />Bʉʼka bʉʼʉ bɛ́ŋ ŋgie-shʉəŋ-kə mbɔ Jiso kə kwú bʉ̀nə kóʼ, bʉʼʉ nɔ bɛ́ŋ ghɔ mbɔ tíŋ hə bɔ̌ŋ Jiso Nyii bu bʉ̀nə gwè nə bʉə ndə bɔ̂ŋ nə kə kwútə nɔʼ kə mɔ̀ʼfyiihə-ʉə ndəŋ ɔŋ.<verse eid="1TH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 4:15" />Nukə ndə baʼa tʉʼ dàhə bii chɔ nduɔ, nɔ bɛ ŋgiekə ndə i fyú hə chu-Tiekətʉ, mbɔ bʉʼʉ ndə bʉʼʉ bu yi bíe mbi ndəŋ chîkə ndə Tiekətʉ bu bʉ̀nə gwè chɔ, kʉʉ fəŋ gɛ̀ bəshʉ bʉə ndə bɔ̂ŋ nɔʼ kwútə bɔ̂ŋ buŋ yi bìatə fɛ. <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />Bʉʼka Tiekətʉ nə mbəŋ-ɛŋ bu shíʼ gwè hə yuo nə gyʉʉ sɔ́ʼ kəyəŋ, nə gyʉʉ-wontəŋkwɛʼtəŋNyii, bə bɔŋleʼ tʉ́ʉ gyʉəʼə-Nyii. Ndʉʉ-ghɔ̄ nɔ, bʉə ndə bɔ̂ŋ kə bɛ́ŋ Klai buŋ kwú, bu fəŋ kóʼ. <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />Ndʉʉmɛ, bʉʼʉ ndə bʉʼʉ bíe ŋɛnə, bə buŋ jɔ̀ bʉʼʉ bɔŋ mɔʼɔ mu kəmbɔʼ bʉʼʉ bɔŋ bìatə Tiekətʉ mu yuo. Nɔ, bʉʼʉ bu bɛ bʉʼʉbə Tiekətʉ chɔ gɛ̀gɛ̀. <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />Nɔ, b̈ii kwèʼhə ŋwɔŋtə-ii nə ŋgiebə-ɔ̄ŋ.<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />Bəliŋ-baʼa, mɔ kie ndə mə-kə́-nyɔ̀ʼ tʉ bii te ŋgwɔʼmbi ghɔŋbə ndʉʉ ndə nubə-ɔ̄ŋ bu fyú chɔ sê fɛ. <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" />Bʉʼka bii bənchəŋ nɔ kínə jyujyu mbɔ chî-Tiekətʉ-kə bu bɔ̀ʼtə gwè nə lʉʼ ndə ɔ gwè bətyuʼ. <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />Ndʉʉ ndə bʉə bu dùʼ kə́ ghɔ̀ŋ mbɔ, “Yəŋbə inchəŋ nɔ bɛ iyùtə bɔŋleʼ kə́ bɛ jyujyu,” ndʉʉmɛ, bɔ̂ŋ bu kwɔnə nyíɛ ŋgʉəʼ shʉ́əshʉ́ə bìatə bɔŋ ndə yɔʼ-Nyii-kə byùu woke le, təmə wo bɔŋ kʉʉ nyʉ́ʉ fɛ.<verse eid="1TH 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 5:4" />Bəliŋ-baʼa, təmə bii bɔŋ kə́ bɛ mu kənjəŋ ndə yɔ̂ŋ-ghɔ̄ bu yi bɔ̀ʼtə bii nə lʉʼ fɛ. <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />Bii bənchəŋ bɔŋ kə́ bɛ bʉə ndə bii kie kɛʼɛ, kə́ bɛ mu mbi súunə. Bʉʼʉ kaa bʉə ndə bɔ̂ŋ bɛ ndʉʉbətyuʼ byuunɔ kə́ tə́nə mu kənjəŋ fɛ. <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />Nɔ, kə bʉʼʉ mə-kə́-bɛ́ŋ nə bəbɛʼbʉə fɛ, b̈ʉʼʉ bɔŋ gòʼ nə shʉtə-ʉʼʉ ighʉ́ʉnə bɔŋleʼ kə́ yá ŋwɔŋ-yʉʼʉ. <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />Bʉʼka b̃ʉə ndə bɔ̂ŋ tʉʼ bɛ́ŋbɛ́ŋ nɔ bɛ́ŋ ndʉʉbətyuʼ, bʉə búu məndʉʼ kə́ búu ndʉʉbətyuʼ. <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" />Bɔŋ ndə bʉʼʉ bɛ bʉə ndə bʉʼʉ bɛ mu mbi súunə, b̈ʉʼʉ yá ŋwɔŋ-yʉʼʉ, mɔ̀ʼ fɔ-chɔ̂-bə mbʉə bʉʼʉ ndə məkyʉ̀hə fyiihə-ʉʼʉ ndə bɛ məmɔʼfyiihə-ʉʼʉ ndəŋ Nyii ghɔŋbə ŋkʉ̂ʉ, ghʉʉkə ndə bʉʼʉ tʉʼ kyʉ̀hə tʉkə-ʉʼʉ nə yɔŋ kə́ bɛ məyʉ́əʼnə-yʉʼʉ ndəŋ ŋkwaa ndə i gwè hə kəghɔ-Nyii. <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />Bʉʼka Nyii chʉʼ kə kɔ́ŋ bʉʼʉ mbɔ bʉʼʉ bu nyíɛ ŋgʉəʼ ndə tʉʉbʉə-e fɛ, bɔŋ mbɔ bʉʼʉ bu kie ŋkwaa-ɛ tíŋ hə bɔ̌ŋ Jiso Klai Tiekətʉ-yʉʼʉ, <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />ndə ɔ kə kwú yie-bʉʼʉ mbɔ kə bʉʼʉ bu bíe mbi byuunɔ kə bʉʼʉ bu nɔʼ kwú loo..., bʉʼʉ bɔŋ bu bɛ mɔʼɔ. <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />Nɔ, b̈ii kə́ kwèʼhə ŋwɔŋtə-ii bɔŋleʼ bɔ́ ŋwɔŋtə-ii haʼ ndə bii tʉʼ fɔ̀ʼ nɔ.<verse eid="1TH 5:11" /></para>
  <para style="s">Ndyiʼtə-tʉ̂ʼ-Bɔɔ-kə</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />Baʼa nɔ tʉʼ fʉ̀ʉtə bii, bəliŋ-baʼa, mbɔ b̈ii kɔ́ yʉʼ kuŋhə tʉ bʉə ndə bɔ̂ŋ tʉʼ fɔ̀ʼ mu bii, bʉə ndə bɔ̂ŋ bɛ bəntəŋbəshʉ-bii bɔŋleʼ kə́ tʉ́ʼ bii ndəŋ fia-Tiekətʉ. <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />B̈ii kɛŋ dʉ̀ʼ ŋkʉ̂ʉ tʉ bɔŋ shʉ́əshʉ́ə bʉʼka fɔʼɔ-yʉə mu bii. B̈ii kie fyiighʉ́ənə mu bii.<verse eid="1TH 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 5:14" />Bəliŋ-baʼa, baʼa nɔ tʉʼ kwèʼhə bii mbɔ b̈ii shyùutə tyunə-bʉə-nduunə-bə, kwèʼhə bʉə kəfaa kwú, kwáa bʉə ndə bɔ̂ŋ mə kwáa bʉə ndə bɔ̂ŋ lʉ́ʉtə bɔŋleʼ kə́ yá fyiihə-ii ndəŋ bɔŋ bənchəŋ.<verse eid="1TH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 5:15" />B̈ii láa mbɔ wo mə tyú bʉ̂ʼʉ tʉ wo nə bʉ̂ʼʉ fɛ, bɔŋ b̈ii kə́ kɔ̀ɔtə ndə mə-kə́-fɔ̀ʼ bʉʉ tʉ ŋwɔŋtə-ii bɔŋleʼ fɔ̀ʼ tʉ bʉə bənchəŋ.<verse eid="1TH 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16" />T̈ʉʉtə-ii kə́ bʉ̀ʉ təvɛʼtəvɛʼ. <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />B̈ii kə́ gháaNyii təvɛʼtəvɛʼ. <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />B̈ii kə́ kɔ́ ndɔ tʉ Nyii ndə nukə təmiyɔŋ ndə i fyú tʉ bii, bʉʼka nɔ bɛ nukə nɔ ndə Nyii kʉ̀ʉ mbɔ b̈ii kə́ fɔ̀ʼ ndə bii nɔʼ tùo biibə Klai Jiso.<verse eid="1TH 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19" />Kə bii mə lʉ́əŋhə LyʉʉhəNyiikə mu mbʉə-bii ndə wo lʉ́əŋhə viʼi le fɛ. <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />Kə bii mə jɛ́ŋhə ntəŋ ndə LyʉʉhəNyiikə kɛ̀ʼ tʉ wo fɛ. <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />B̈ii bɔŋ yúotə nubə inchəŋ, yá nu-jyujyu-kə tə́nə chɔ shʉ́əshʉ́ə. <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />B̈ii shùʼ wukə-ii ndəŋ ntɛ-bʉ̂ʼʉ-hə inchəŋ.<verse eid="1TH 5:22" /></para>
  <para style="s">Ndyiʼtə-nchaʼtə-Bɔɔ-kə</para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />Nduɔ, N̈yii, ndə ɔ̃ kɔ́ bʉʼʉ nə fyiighʉ́ənə, sʉ̀ bii nə mbəŋ-ɛŋ b̈ii tʉ́ʉnə gɛ̀ kùu, bɔŋleʼ tʉ́ʼ mbʉəhə-ii nchəŋnchəŋ-ɛŋ, bəyihə, lyʉʉhəkə leʼnə ŋkwê-mbʉə-yii təmə kwɔtəkə chɔ fɛ ndəŋ chîkə ndə Jiso Klai Tiekətʉ-yʉʼʉ bu bʉ̀nə gwè chɔ. <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />Mbəŋ-ɛŋ ndə ɔ tíi bii nɔ bɛ wo gìe shʉəŋ, ɔ bu fɔ̀ʼ haʼ ndə ɔ kə ghɔŋ.<verse eid="1TH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />Bəliŋ-baʼa, b̈ii gháaNyii tʉ baʼa ghɔ.<verse eid="1TH 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26" />B̈ii gìe tʉ bʉə bəchəŋ ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii nə nchaʼtə ndə i bɛ ŋkʉʉ.<verse eid="1TH 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27" />Mɔ nɔ tʉʼ kàhə bii yie-Tiekətʉ mbɔ b̈ə tíi ŋwɔʼnə-ɔ̄ŋ tʉ bʉə bənchəŋ ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii.<verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />Tə Jiso Klai Tiekətʉ-yʉʼʉ dʉ̀ʼ buuŋjyu-i tʉ bii.<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>