<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LUK" style="id">- Bamunka New Testament</book>
  <para style="h">Luk</para>
  <para style="toc1">Bəsɔʼka jyujyu ndə Luk kə fʉ̀ʼtə</para>
  <para style="toc2">Luk</para>
  <para style="toc3">Luk</para>
  <para style="mt2">Bəsɔʼka jyujyu ndə</para>
  <para style="mt1">Luk</para>
  <para style="mt2">kə fʉ̀ʼtə</para>
  <para style="imt">Nchoʼtə bətʉ bənu</para>
  <para style="ip">Mbʉ ntəŋjyujyu ndə Luk kə fʉ̀ʼtə nɔ chìi bə kínə Jiso ndə ŋkwaa-bʉə-Isilɛ ndə Nyii nɔʼ kə kɔ̀ʼnə bɔŋleʼ kə́ bɛ wo ndə ɔ bɛ ŋkwaa-bʉə-bənchəŋ. Luk nɔ nyɔ̀ʼ mbɔ la kə séʼ LyʉʉhəNyiikə séʼ Jiso mbɔ ɔ̈ gwè lɔ̀ʼ mbʉ ntəŋjyujyu tʉ bʉə-mbʉʼ. Luk nɔ tʉ shyíi bʉʼʉ nə ŋgwɔ ntɛ fyii ndə Jiso kie tʉ bʉə te nubə inchəŋ ndə i tʉʼ chɔ́ŋhə bɔŋ. Luk nɔ nyɔ̀ʼ nubə buŋmbi ndə ĩ kɔ́ fyii jyujyu. Fɔŋ ɛŋ nɔ bɛ ndə nchʉʉhə-i ndə ɔ fʉ̀ʼtə ntɛhə ndə məgwè Jiso kə bɛ. Ɔ bʉ̀nə bìʼ dʉ̀ʼ ndə ndyiʼtə-i ndə Jiso kə bʉ̀nə kóʼ gɛ̀ yuo. Luk nɔ kə bìʼ nyɔ̀ʼ kə́ fʉ̀ʼtə ntɛhə ndə bʉə kə shi kə́ mɔ̀ʼfyiihə-ʉə ndəŋ Jiso bɔŋleʼ kʉ̀ʼ ndəŋ mbʉ fia vɛʼ ndə ɔ nɔʼ kə kóʼ gɛ̀ yuo mu ŋwɔʼnə-fɔʼɔ-vâafɔʼɔ-Jiso.</para>
  <para style="iot">Nubə ndə i bɛ mu ŋwɔʼnə-fɛ̄ŋ</para>
  <para style="io1">Nchʉʉhə bənu 1:1-4</para>
  <para style="io1">Ntɛ ndə bə nə bí Jɔŋ ghɔŋbə ntɛ ndə bə nə bí Jiso, ɔ chʉ́ʉhə kə́ kóʼ ndə vaabələŋ 1:5–2:52</para>
  <para style="io1">Fɔʼɔ-Jɔŋ ndə ɔ̃ kɔ́ muu 3:1-20</para>
  <para style="io1">Jɔŋ kɔ́ muu tʉ Jiso, Sata kə́ mùutə ɔŋ mbɔ ɔ̈ chìi bʉ̂ʼʉ 3:21–4:13.</para>
  <para style="io1">Fɔʼɔ-Jiso mu Galili 4:14–9:50</para>
  <para style="io1">Jiso lɔ̀ hə Galili gɛ̀ Jɛlosalɛŋ 9:51–19:27</para>
  <para style="io1">Nukə ndə i fyú ndə ndyiʼtə-vyii-mbi-kə-i bə buŋ kwɛ̀ŋ Jiso yí mu Jɛlosalɛŋ leʼnə mbʉə Jɛlosalɛŋ 19:28–23:56</para>
  <para style="io1">Jiso bʉ̀nə kóʼ, dʉ̀ʼ ŋwɔŋ-ɛŋ bɔŋleʼ kóʼ gɛ̀ yuo 24:1-53</para>
  <chapter number="1" style="c" sid="LUK 1" />
  <para style="s">Tʉ tie-ɔ Tiofilo</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1" />Bʉə buŋmbi nɔʼ kɔ̀ɔtə ndə mənyɔ̀ʼ ŋwɔʼnə ndə məfʉ̀ʼtə nubə ndə i nɔʼ fyú mu bʉʼʉ. <verse eid="LUK 1:1" /><verse number="2" style="v" sid="LUK 1:2" />Bɔ̂ŋ nyɔ̀ʼ kə́ fʉ̀ʼtə haʼ ndə bɔ̂ŋ kə yʉ́ hə kəghɔ-bʉə ndə bɔ̂ŋ nə nyíɛ nə shʉtə-ʉə lʉ̀ hə ndə Jiso kə chʉ́ʉhə fɔʼɔ-ɛ bɔŋleʼ kə́ bɛ vaafɔ̀ʼ-kəŋgieNyii. <verse eid="LUK 1:2" /><verse number="3" style="v" sid="LUK 1:3" />Nduɔ, bʉʼka mbɔ mɔ nɔʼ lʉ̀ shʉ-ɔ lɛ́nə mbʉ bənu ndə nchʉʉhə-i, mɔ kwɔ̀ʼtə mbɔ nɔ bʉ̀ʉ mɔ nyɔ̀ʼ mbʉ bənu haʼ ndə i fyú kɔ́ tʉ a, tie-ɔ Tiofilo. <verse eid="LUK 1:3" /><verse number="4" style="v" sid="LUK 1:4" />Mɔ nɔ tʉʼ nyɔ̀ʼ bʉʼka mbɔ mɔ nɔ tʉʼ kʉ́ʉ mbɔ ä kínə jyujyu te nubə ndə a nɔʼ kə yʉ́.<verse eid="LUK 1:4" /></para>
  <para style="s">Məbí-Jɔŋ ndə ɔ̃ kɔ́ muu</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5" />Ndʉʉ ndə Hɛlo kə bɛ fɔŋ-Judia, wofɛ̀ʼndɛŋNyiibɛʼ nɔ kə bɛ ghɔ, yie-e kə́ bɛ Sakalia, ɔ lɔ̀ hə nuɔ-bʉəfɛ̀ʼndɛŋNyii-Abija ghɔ. Yie vi-i kə́ bɛ Elisabi ndə ɔ lɔ̀ hə kəlɔŋ-bʉəfɛ̀ʼndɛŋ-Alo. <verse eid="LUK 1:5" /><verse number="6" style="v" sid="LUK 1:6" />Bɔ̂ŋ bənchəŋ nɔ kə bɛ ndyʉndyʉ tʉ Nyii, kɛŋ kə́ yʉ́ chu-Tiekətʉ jyujyu ndə bəŋkahə-bi ghɔŋbə nuʼ-i. <verse eid="LUK 1:6" /><verse number="7" style="v" sid="LUK 1:7" />Bɔŋ təmə bɔ̂ŋ kie vaa fɛ, bʉʼka Elisabi nɔ kə bɛ dəŋ, bɔ̂ŋ bənchəŋ nɔʼ kə dùɔŋ.<verse eid="LUK 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8" />Kʉ̂ʉ bɛ yɔŋbɛʼ, ndʉʉ nuɔ-Sakalia kʉ̀ʼnə ndə məfɛ̀ʼndɛŋ mu njaafɛ̀ʼndɛŋNyii, Sakalia kə́ fɔ̀ʼ tʉ Nyii nə wofɛ̀ʼndɛŋNyii. <verse eid="LUK 1:8" /><verse number="9" style="v" sid="LUK 1:9" />Ndəŋ nuʼ-bʉəfɛ̀ʼndɛŋNyii, bə nɔ kə séʼ ɔ nə njoʼ<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">Nɔ bɛ via-bətyʉ-bə ndə bə sáatə, nyɔ̀ʼ yie-bʉə-tə chɔ, mɔ̀ʼ mu kəshyii. Bə kə́ yʉ́ʼnə, yi ndə i gwù sê fəŋ nɔ, dʉ̀ʼ mbɔ nɔ bɛ ŋgɛɛ ndə mbʉ kənu yá ɔ.</char></note> mbɔ la bu gɛ̀ ɔ mu njaafɛ̀ʼndɛŋTiekətʉ ndə məgɛ̀ tɔ̀ŋ lyiikə. <verse eid="LUK 1:9" /><verse number="10" style="v" sid="LUK 1:10" />Bʉə buŋmbi ndə bɔ̂ŋ kə bɛ chɔ, káa mbi kə́ gháaNyii ndʉʉ ndə Sakalia kə́ tɔ̀ŋ mbʉ kəlyii.<verse eid="LUK 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11" />WontəŋTiekətʉ fyú tʉ ɔŋ, tə́nə kwiimɔʼnə kəyəŋfɛ̀ʼndɛŋNyii ndə b̃ə tɔ̀ŋ lyiikə chɔ. <verse eid="LUK 1:11" /><verse number="12" style="v" sid="LUK 1:12" />Sakalia kʉ̂ʉ nyíɛ ɔŋ, fyii-i chə̀nə, faa-kwu-kə yá fyii-i. <verse eid="LUK 1:12" /><verse number="13" style="v" sid="LUK 1:13" />Bɔŋ mbʉ wontəŋNyii* gìe tʉ ɔŋ mbɔ, “Kə a mə leʼ fàa fɛ, Sakalia, Nyii nɔʼ yʉ́ gwia-a, vi-a Elisabi bu bí vaabələŋ. A tyú yie-e nə Jɔŋ. <verse eid="LUK 1:13" /><verse number="14" style="v" sid="LUK 1:14" />Ɔ bu bɛ tʉʉjyu ghɔŋbə fyii sʉ́ʼnə tʉ a. Bʉə buŋmbi bu kie tʉʉjyu ndʉʉ ndə bə bí ɔ. <verse eid="LUK 1:14" /><verse number="15" style="v" sid="LUK 1:15" />Bʉʼka mbɔ ɔ bu bɛ wokwɛʼtəŋ bəshʉ Tiekətʉ. Ɔ mə nə nú ndʉʼ-shʉ́əshʉ́ə-mə fɛ. LyʉʉhəNyiikə bu bɛ mu mbʉə-ɔ lʉ̀ hə bətɔ-ŋkwê-i. <verse eid="LUK 1:15" /><verse number="16" style="v" sid="LUK 1:16" />Ɔ bu byʉ̀hə bʉə-Isilɛ buŋmbi, gwè nə bɔŋ tʉ Nyii Tiekətʉ-yʉə. <verse eid="LUK 1:16" /><verse number="17" style="v" sid="LUK 1:17" />Ɔ bu kə́ gɛ̀ hə bəshʉ Tiekətʉ, nə lyʉʉhəkə leʼnə ghʉəʼkə nə yi-Ɛlaja-yə, yʉkəŋgieNyii. Ɔ bu kíahə fyii-bətie-vâa-hə ndə məbʉ̀nə kie fyii tʉ vâa-bʉə. Ɔ bu kíahə bʉə-kwɛ̀ŋhə ndəŋ fia-bʉəbʉə-tə, bɔ̂ŋ kie ndaa nə bʉə ndə bɔ̂ŋ tə́nə ndyʉndyʉ tʉ Nyii. Ɔ bu shʉ̀tə bʉə-Tiekətʉ tʉ́ʼ tʉ ɔŋ.”<verse eid="LUK 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18" />Sakalia bə̀ŋhə tʉ mbʉ wontəŋNyii mbɔ, “Mɔ bu kínə təka mbɔ bɛ shʉəŋ? Mɔ nɔʼ dùɔŋ, vi-ɔ nɔʼ dùɔŋ.” <verse eid="LUK 1:18" /><verse number="19" style="v" sid="LUK 1:19" />Mbʉ wontəŋNyii bə̀ŋhə mbɔ, “Mɔ nɔ bɛ Gableya kə́ tə́nə bəshʉ-Nyii, ndə ɔ tə́ŋ mɔ ndə məgwè nə ntəŋjyujyu-ɔ̄ tʉ a. <verse eid="LUK 1:19" /><verse number="20" style="v" sid="LUK 1:20" />Nyíɛ! Nduɔ ndə a gòʼ təmə bɛ́ŋ ntəŋjyujyu-ɔ̄ fɛ nɔ, a bu bə̀ŋ chie tə ŋgiekə-ɔ̄ŋ yi fyú shʉəŋ ndə i bu yi fyú ndəŋ ndʉʉ-i.”<verse eid="LUK 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21" />Bɔŋ bʉə kə́ bɛ mbi chyìi Sakalia, kə́ kwɔ̀ʼtə nukə ndə i nɔʼ fyú chíe ɔ, ɔ gòʼ mu njaafɛ̀ʼndɛŋNyii. <verse eid="LUK 1:21" /><verse number="22" style="v" sid="LUK 1:22" />Ndʉʉ ndə ɔ fyú mbi, bìatə bɔŋ təmə bəkɔ ɔ kwə́ʼ tʉ bɔŋ fɛ. Bɔ̂ŋ chèʼnə mbɔ Nyii nɔʼ dʉ̀ʼ nukə tʉ ɔŋ mu njaa-ɔ. Ɔ kə́ fʉ̀ʼtə nubə tʉ bɔŋ bə nə ghɔkə-i bʉʼka mbɔ ɔ nɔʼ bə̀ŋ chie. <verse eid="LUK 1:22" /><verse number="23" style="v" sid="LUK 1:23" />Ndʉʉ ndə fɔʼɔ-ɛ mì, ɔ bʉ̀nə chunjaa-ɔ. <verse eid="LUK 1:23" /><verse number="24" style="v" sid="LUK 1:24" />Chîbə kʉ̂ʉ tíŋ Elisabi vi-i gʉ̀ʼ, lə̀ŋ ŋwɔŋ-ɛŋ ndə bəchi itaa. <verse eid="LUK 1:24" /><verse number="25" style="v" sid="LUK 1:25" />Elisabi ghɔ̀ŋ mbɔ, “Nɔ chìi Tiekətʉ chìi yɔ̄ŋ-yə tʉ mɔ, kie tʉvyiikə tʉ mɔ, ndə məfyúhə tʉvyiikə-ɔŋ mu bʉə mbɔ mɔ mə bɛ dəŋ fɛ.”<verse eid="LUK 1:25" /></para>
  <para style="s">Bə núhə məbí-Jiso</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26" />Ndʉʉghɔfii, mu bəchi ntʉʼʉ ndə Elisabi bɛ gʉʼnə, Nyii tə́ŋ wontəŋ-ɛŋ Gableya mu lɔʼɔ kətə̂ŋbɛʼ yie-e kə́ bɛ Nasalɛ ndə i bɛ mu Galili, <verse eid="LUK 1:26" /><verse number="27" style="v" sid="LUK 1:27" />tʉ vaabəke təmə ɔ nɔʼ nə kínə woləŋ fɛ, ndə bə nɔʼ bíʼtə ɔŋ ndə məkɔ́ tʉ Jɔsɛ ndə ɔ lɔ̀ hə kəlɔŋ Dɛbi. Yie-vaabəke-ghɔ̄ kə́ bɛ Mɛli. <verse eid="LUK 1:27" /><verse number="28" style="v" sid="LUK 1:28" />Mbʉ wontəŋNyii gwè tʉ ɔŋ, ghɔ̀ŋ mbɔ, “Mɔ chàʼtə a, woke-mbʉʉ tʉ. Bii Tiekətʉ nɔ bɛ mɔʼɔ.”<verse eid="LUK 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29" />Bɔŋ mbʉ kəŋgie ghɔ́ʼ ɔ, ɔ kə́ kwɔ̀ʼtə tʉkə-i mbɔ bɛ ntɛ nchaʼtə ka nɔ? <verse eid="LUK 1:29" /><verse number="30" style="v" sid="LUK 1:30" />Mbʉ wontəŋNyii ghɔ̀ŋ tʉ ɔŋ mbɔ, “Kə a mə fàa fɛ, Mɛli, Nyii nɔʼ dʉ̀ʼ buuŋjyu-i tʉ a. <verse eid="LUK 1:30" /><verse number="31" style="v" sid="LUK 1:31" />Nyíɛ! A bu gʉ̀ʼ bí vaabələŋ. A bu yaʼ tyú yie-e nə Jiso. <verse eid="LUK 1:31" /><verse number="32" style="v" sid="LUK 1:32" />Ɔ bu bɛ wokwɛʼtəŋ, bə kə́ tíi ɔ nə Vaa-Chaabəfɔŋ, Nyii Tiekətʉ bu kɔ́ yetə-tie-e-kə, Dɛbi, tʉ ɔŋ. <verse eid="LUK 1:32" /><verse number="33" style="v" sid="LUK 1:33" />Ɔ bu sɔ́ʼ fu-Jakɔ gɛ̀gɛ̀ təmə sɔ́ʼ-ɛ nə lìʼ fɛ.”<verse eid="LUK 1:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34" />Mɛli bíʼtə tʉ mbʉ wontəŋNyii mbɔ, “Bəkɔ yɔ̄ŋ-yə bɛ təka təmə mɔ kínə woləŋ fɛ?” <verse eid="LUK 1:34" /><verse number="35" style="v" sid="LUK 1:35" />Mbʉ wontəŋNyii bə̀ŋhə tʉ ɔŋ mbɔ, “LyʉʉhəNyiikə bu shíʼ ndəŋ aŋ, ghʉəʼ-Chaabəfɔŋ-kə bu bɔ̀ŋ aŋ, bʉʼka yɔ̄ŋ-yə, mbʉ vaa tʉ́ʉnə bəshʉ-Nyii, bə bu kə́ tíi ɔ nə VaaNyii. <verse eid="LUK 1:35" /><verse number="36" style="v" sid="LUK 1:36" />Nyíɛ! Elisabi liŋ-aŋ ndə ɔ nɔʼ kə dùɔŋ, bə kə́ tíi ɔ nə dəŋ, nɔ bɛ gʉʼnə nə vaabələŋ ndə bəchi ntʉʼʉ. <verse eid="LUK 1:36" /><verse number="37" style="v" sid="LUK 1:37" />Bʉʼka mbɔ nubɛʼkə bɛ ghɔ ndə i chàa Nyii fɛ.”<verse eid="LUK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38" />Mɛli bə̀ŋhə mbɔ, “Mɔ nɔ bɛ fʉə-Tiekətʉ, tə ɔ fɔ̀ʼ tʉ mɔ haʼ ndə a nɔʼ gìe nɔ.” Mbʉ wontəŋNyii gɛ̀ nə wi.<verse eid="LUK 1:38" /></para>
  <para style="s">Mɛli gɛ̀ mətòʼ tʉ Elisabi</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39" />Mu bəchî-ghɔ̄, Mɛli lə̀ŋnə chʉʼ gɛ̀ nəndʉʉnəndʉʉ mu lɔʼɔbɛʼ kətʉ kwɔŋ mu Judia, <verse eid="LUK 1:39" /><verse number="40" style="v" sid="LUK 1:40" />gɛ̀ ŋíi mu njaa-Sakalia, gìe tʉ Elisabi. <verse eid="LUK 1:40" /><verse number="41" style="v" sid="LUK 1:41" />Ndʉʉ ndə Elisabi yʉ́ ndə Mɛli gìe tʉ ɔŋ, vaa ŋɛ̀nə bətɔ-ɔ, LyʉʉhəNyiikə ŋíi mu mbʉə-Elisabi tə lə́ŋ. <verse eid="LUK 1:41" /><verse number="42" style="v" sid="LUK 1:42" />Ɔ tíi nə gyʉʉ dədə ghɔ̀ŋ mbɔ, “Nyii nɔʼ kɔ́ biʼbə tʉ a mu bəke, bɔŋ biʼbə bu leʼ bɛ yi-vaa-yə ndə ɔ fyú hə bətɔ-a. <verse eid="LUK 1:42" /><verse number="43" style="v" sid="LUK 1:43" />Buŋmbi ŋkʉ̂ʉ-ɔ̄ luu-i buŋ bɛ mbuka lɔŋ, tə ŋkwê-Tiekətʉ-ɔ gwè mətòʼ tʉ wo nə mɔ? <verse eid="LUK 1:43" /><verse number="44" style="v" sid="LUK 1:44" />Bʉʼka mbɔ ndʉʉ ndə mɔ yʉ́ nchaʼtə-a, vaa ndə ɔ bɛ bətɔ-mɔ ŋɛ̀nə nə tʉʉjyu. <verse eid="LUK 1:44" /><verse number="45" style="v" sid="LUK 1:45" />Tʉʉjyu nɔ bɛ ya-yə ndə a bɛ́ŋ nukə ndə Tiekətʉ ghɔ̀ŋ, bɛ́ŋ mbɔ i bu fyú shʉəŋ!”<verse eid="LUK 1:45" /></para>
  <para style="s">Lyuu-Mɛli</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46" />Mɛli bɔŋleʼ ghɔ̀ŋ mbɔ,</para>
  <para style="q1" vid="LUK 1:46">“Vaafyii-ɔ tʉʼ kɔ́ məŋwɔʼ tʉ Tiekətʉ.<verse eid="LUK 1:46" /></para>
  <para style="q2">
    <verse number="47" style="v" sid="LUK 1:47" />Vaafyii-ɔ tʉʼ sʉ́ʼnə tə chàa yʉʉhə, tʉ Nyii ndə ɔ bɛ Ŋkwaa-ɔ,<verse eid="LUK 1:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48" />bʉʼka ɔ kwɛ́nə mɔ fʉə-e, təmə fɛ̀ʼ yʉ́ mɔ bɛ wo njʉnjʉ fɛ,</para>
  <para style="q2" vid="LUK 1:48">lʉ̀ hə nduɔ gɛ̀ nə shʉbə kwinə-bʉə-bə bənchəŋ bu kə́ tíi mɔ nə wo kətʉjyu.<verse eid="LUK 1:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="LUK 1:49" />Bə bu gìe yɔ̄ŋ-yə bʉʼka Fɔŋ Wo Shʉəshʉə nɔʼ chìi nukwɛʼtəŋbə tʉ mɔ.</para>
  <para style="q2" vid="LUK 1:49">Ɔ nɔ bɛ ŋkʉʉ.<verse eid="LUK 1:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50" />Ɔ nɔ tʉʼ dʉ̀ʼ tʉvyiikə tʉ bʉə ndə bɔ̂ŋ tʉʼ fàa ɔ, ndə kwinə-bʉə-bə təmiyɔŋ.<verse eid="LUK 1:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51" />Ɔ nɔ tʉʼ chìi nu-bələŋ-bə nə ghɔkə-i, wɔ̀ʼhə bʉə ndə bɔ̂ŋ kie tʉʉ gʉənə mu ŋkwɔʼtə-yʉə,<verse eid="LUK 1:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52" />shúʼhə bəfɔŋ sê, chɔ̀ʼhə bʉə ndə bɔ̂ŋ lʉ̀ hə ŋwɔŋtə-ʉə sê kɔ́ ghɔʼ,<verse eid="LUK 1:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53" />yúʼ bʉə-jyʉʉ nə yʉʼ bəfɔ tʉ bɔŋ yuo, bɔŋ-nɔʼ-leʼ jə̀ŋ bʉə ndə bɔ̂ŋ kwɔ̀ʼtə mbɔ bɔ̂ŋ kie inchəŋ, bɔ̂ŋ gɛ̀ ghɔghɔ.<verse eid="LUK 1:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54" />Ɔ nɔʼ kwáa vaafɔ̀ʼ-ɛ Isilɛ, ghʉʉntoʼ búɔnə, bɔŋleʼ kwɛ́nə ndə mədʉ̀ʼ tʉvyiikə-i tʉ bɔŋ.<verse eid="LUK 1:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55" />Haʼ ndə ɔ nɔʼ kə gìe tʉ bətietie-bʉʼʉ, te ŋkɔʼnə-i, tʉ tie-yʉʼʉ Ablahaŋ ghɔŋbə ŋgwie-wo-e, təmə liʼ-i ghɔ fɛ.”<verse eid="LUK 1:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56" />Kəliʼ, Mɛli chí ghɔŋ Elisabi ndə bəchi itia, bʉ̀nə chunjaa.<verse eid="LUK 1:56" /></para>
  <para style="s">Bə bí Jɔŋ ndə ɔ̃ kɔ́ muu</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57" />Ndʉʉ kʉ̂ʉ kʉ̀ʼnə ndə Elisabi kie ndə məbí vaa-ɛ, ɔ bí vaabələŋ. <verse eid="LUK 1:57" /><verse number="58" style="v" sid="LUK 1:58" />Bʉə-kətoʼ-bi ghɔŋbə bʉə-kəlɔŋ-bʉə, yʉ́ mbɔ Tiekətʉ la nɔʼ dʉ̀ʼ fɔŋ kətʉvyiinə tʉ ɔŋ, bɔ̂ŋ gwè ghɔŋ bɔŋ kə́ nʉ́ətə.<verse eid="LUK 1:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 1:59" />Wyuu kʉ̂ʉ kə̀ŋ, bɔ̂ŋ gwè ndə məfɔ̀ʼ vaa, bɔŋleʼ tyú yie-e ndə i kie ndə məgwè hə ndəŋ yie-tie-e, Sakalia. <verse eid="LUK 1:59" /><verse number="60" style="v" sid="LUK 1:60" />Ŋkwê-i bə̀ŋhə mbɔ, “Mbee, yie-e nɔ kie ndə məbɛ Jɔŋ.” <verse eid="LUK 1:60" /><verse number="61" style="v" sid="LUK 1:61" />Bə ghɔ̀ŋ tʉ ɔŋ mbɔ, “Wo kaa ndə lɔŋkə-i, ndə ɔ kie yie-maa-ɔ̄ŋ fɛ.” <verse eid="LUK 1:61" /><verse number="62" style="v" sid="LUK 1:62" />Bɔ̂ŋ kwə́ʼ tʉ tie-e nə ghɔbə-ʉə ndə məkínə yie ndə ɔ bu kʉ̀ʉ ndə mətyú yie vaa nə yɔŋ. <verse eid="LUK 1:62" /><verse number="63" style="v" sid="LUK 1:63" />Ɔ bíʼtə via-kətyʉ-kə, nyɔ̀ʼ yie-mbʉ-vaa chɔ, mbɔ Jɔŋ. I chíe chu bʉə. <verse eid="LUK 1:63" /><verse number="64" style="v" sid="LUK 1:64" />Haʼ ndʉʉghɔfii, chu-i ŋɔ́ʼnə, lɛɛŋhəkə-i yɔ̀ʼnə, ɔ chʉ́ʉhə kwə́ʼ, kə́ lə̀ʼtə Nyii. <verse eid="LUK 1:64" /><verse number="65" style="v" sid="LUK 1:65" />I fɛ̀ŋhə bʉə bənchəŋ ndə bɔ̂ŋ bɛ mbʉə bɔŋ, bə kwə́ʼ nubə-ɔ̄ŋ mu tə̂ŋ-ndəŋ-ŋgoʼbɛʼ-bə inchəŋ mu Judia. <verse eid="LUK 1:65" /><verse number="66" style="v" sid="LUK 1:66" />Wotəmiyɔŋ ndə ɔ̈ yʉ́ nubə-ɔ̄ŋ, nyíɛ mbɔ Tiekətʉ nɔ bɛ ghɔŋ ɔŋ, bɔŋleʼ mɔ̀ʼ mu fyii-ɔ kə́ bíʼtə mbɔ, “Vaa-ɔ̄ŋ bu bɛ ntɛ vaa ka?”<verse eid="LUK 1:66" /></para>
  <para style="s">Lyuu-Sakalia</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67" />LyʉʉhəNyiikə nɔʼ kə ŋíi mu tie-e, Sakalia, tə lə́ŋ. Ɔ chʉ́ʉhə mətéʼ ntəŋ ndə i gwè hə kəghɔ-Nyii, kə́ ghɔ̀ŋ mbɔ,<verse eid="LUK 1:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68" />“Tə bʉʼʉ chʉ̀ʉ Tiekətʉ ndə ɔ bɛ Nyii-bʉə-Isilɛ,</para>
  <para style="q2" vid="LUK 1:68">bʉʼka ɔ nɔʼ gwè chʉ́ʉhə məkwáa, chʉ̀ʼ tʉ-bʉə-bi-kə Isilɛ.<verse eid="LUK 1:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69" />Ɔ nɔʼ tə́ŋ wo shʉ́əshʉ́ə ndə ɔ bu kwáa bʉʼʉ,</para>
  <para style="q2" vid="LUK 1:69">hə kəlɔŋ-vaafɔ̀ʼ-ɛ Fɔŋ-Dɛbi,<verse eid="LUK 1:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70" />haʼ ndə ɔ nɔʼ kə kɔ̀ʼnə tíŋ hə bɔ̌ŋ bʉəyʉkəŋgie-bi ndə bɔ̂ŋ bɛ ŋkʉʉ,</para>
  <para style="q2" vid="LUK 1:70">kə́ bɛ bʉəyʉkəŋgie-bi ndə bɔ̂ŋ nɔʼ nə bɛ hə ŋgʉʼŋgʉʼhə.<verse eid="LUK 1:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71" />Ɔ nɔ kə kɔ̀ʼnə mbɔ ɔ bu kwáa bʉʼʉ hə kəghɔ bʉə-bàa-bʉʼʉ,</para>
  <para style="q2" vid="LUK 1:71">kwáa bʉʼʉ ndəŋ ghʉəʼ-bʉə-bənchəŋ-kə ndə bɔ̂ŋ bàa-bʉʼʉ.<verse eid="LUK 1:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72" />Ɔ nɔ nə chìi yɔ̄ŋ-yə ndə mədʉ̀ʼ tʉvyiikə ndə ɔ kə kɔ̀ʼnə tʉ bətie-bʉʼʉ,</para>
  <para style="q2" vid="LUK 1:72">bɔŋleʼ kwɛ́nə yi-yə ŋkaamə* ndə i bɛ ŋkʉʉ ndə ɔ kə gwìa ghɔŋ bɔŋ.<verse eid="LUK 1:72" /></para>
  <para style="q2">
    <verse number="73" style="v" sid="LUK 1:73" />Ndʉʉ ndə ɔ kə gwìa ŋkaamə ghɔŋ tie-yʉʼʉ Ablahaŋ, ɔ kàa<verse eid="LUK 1:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="LUK 1:74" />ndə məchéʼ bʉʼʉ ndəŋ ghʉəʼ-bʉə-bàa-bʉʼʉ-kə,</para>
  <para style="q2" vid="LUK 1:74">mbɔ bəkɔ bʉʼʉ fɔ̀ʼ tʉ ɔŋ təmə kə́ fàa fɛ.<verse eid="LUK 1:74" /></para>
  <para style="q2">
    <verse number="75" style="v" sid="LUK 1:75" />Ɔ bu chìi bʉʼʉ, bʉʼʉ bɛ ŋkʉʉ, tə́nə ndyʉndyʉ bəshʉ ɔ ndəŋ chîmbibə-ʉʼʉ inchəŋ.<verse eid="LUK 1:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76" />Mbəŋ-aŋ ŋaʼ, a bu kə́ gɛ̀ hə bəshʉ Tiekətʉ ndə məshʉ̀tə fia tʉ ɔŋ,</para>
  <para style="q2" vid="LUK 1:76">bə bu tíi a nə woyʉkəŋgie-Chaabəfɔŋ.<verse eid="LUK 1:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77" />A bu chìi bʉə-Nyii kínə ndə bəkɔ ɔ kwáa bɔŋ,</para>
  <para style="q2" vid="LUK 1:77">ndə i gwè hə ndəŋ məsʉ̀fyii hə ndəŋ bʉ̂ʼʉ-woməsʉʉ.<verse eid="LUK 1:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78" />Bʉʼka fɔŋ-kətʉvyiinə-Nyii-yʉʼʉ,</para>
  <para style="q2" vid="LUK 1:78">tíŋ hə bɔ̌ŋ mbʉ kətʉvyiinə, chichi bu sɔ́ʼ tʉ bʉʼʉ hə bəshʉ-Nyii.<verse eid="LUK 1:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79" />I bu báa ndəŋ bʉə ndə bɔ̂ŋ bɛ mu kənjəŋ, bʉə ndə bɔ̂ŋ bɛ chu-kwú,</para>
  <para style="q2" vid="LUK 1:79">dʉ̀ʼ fia tʉ bʉʼʉ ndə məkie fyiighʉ́ənə.”<verse eid="LUK 1:79" /></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80" />Mbʉ vaa kə́ kʉ̀ʼ, kóʼ tə bɛ wo shʉ́əshʉ́ə mu Nyii. Ɔ kʉ̂ʉ kóʼ, gɛ̀ kə́ chí mu kwɔŋkəyəŋnə<note caller="+" style="f"><char style="fr" closed="false">1:80 </char><char style="ft" closed="false">Kwɔŋkəyəŋnə fɛ̀ŋ nɔ tʉʼ dʉ̀ʼ yəŋkə ndə i yə̀ŋhə daa təmə muu kə́ bɛ chɔ fɛ, təmə fɔyubə kə́ bʉ̀ʉ chɔ fɛ.</char></note> tə ndʉʉ kʉ̀ʼnə ndə ɔ kɛ̀ʼ ŋwɔŋ-ɛŋ tʉ bʉə-Isilɛ.<verse eid="LUK 1:80" /></para>
  <chapter eid="LUK 1" />
  <chapter number="2" style="c" sid="LUK 2" />
  <para style="s">Məbí-Jiso</para>
  <para style="r">(<ref loc="MAT 1:18-25">Matia 1:18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1" />Ndʉʉ ndə Agostu kə bɛ Fɔŋ-lɔʼɔ-Luŋ, ɔ bʉ́ mbɔ b̈ə la súu bʉə bənchəŋ nyɔ̀ʼ yietə-ʉə mu ŋwɔʼnə-gɔməna. <verse eid="LUK 2:1" /><verse number="2" style="v" sid="LUK 2:2" />Nɔ bɛ fəŋ vɛʼ nɔ ndə bə kə́ súu bʉə, nyɔ̀ʼ yietə-ʉə mu ŋwɔʼnə, kə́ bɛ ndʉʉ ndə Kwilinu kə́ sɔ́ʼ bie Silia. <verse eid="LUK 2:2" /><verse number="3" style="v" sid="LUK 2:3" />Bʉə bənchəŋ bʉ̀nə gɛ̀ lɔʼɔbə-ɔŋ ndə mənyɔ̀ʼ yietə-ʉə mu ŋwɔʼnə-ghɔ̄. <verse eid="LUK 2:3" /><verse number="4" style="v" sid="LUK 2:4" />Jɔsɛ ghɔ nɔ nə bɛ vaa-fu-Dɛbi. Bʉʼka yɔ̄ŋ-yə, ɔ lɔ̀ hə Nasalɛ mu Galili gɛ̀ Bɛtələhɛŋ mu Judia, bʉʼka mbɔ nɔ nə bɛ lɔʼɔ-bətietie-e ndəŋ yuhəbə buŋmbi. <verse eid="LUK 2:4" /><verse number="5" style="v" sid="LUK 2:5" />Ɔ kə́ gɛ̀ ndə mənyɔ̀ʼ yie-e mu ŋwɔʼnə-gɔməna ghɔŋ Mɛli ndə bə nɔʼ bíʼtə ɔŋ ndə vi-i. Ɔ kə́ bɛ gʉʼnə.<verse eid="LUK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 2:6" />Vɛʼ ndə bɔ̂ŋ kə bɛ Bɛtələhɛŋ, mbʉ ndʉʉ kʉ̀ʼnə ndə yɔʼ-Nyii-kə byùu ɔ. <verse eid="LUK 2:6" /><verse number="7" style="v" sid="LUK 2:7" />Ɔ bí fəŋ vaa-ɛ, kə́ bɛ vaabələŋ, bɔ́nə ɔŋ mu ndyihə, mɔ̀ʼ ɔ mu ŋkyʉʉ-bihə-kə bʉʼka mbɔ yəŋkə kə bɛ ghɔ tʉ bɔŋ mu njəŋ-njaa-bʉə-mətòʼ fɛ.<figure style="fig" alt="The birth of Jesus" file="CN01617c.tif" size="col" copy="David C. Cook" ref="2:7">Məbí-Jiso</figure><verse eid="LUK 2:7" /></para>
  <para style="s">Bənchyii-binjyʉʉhə ghɔŋbə bʉəntəŋNyii</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8" />Mu kəyəŋbɛʼ mbʉə lɔʼɔ-ghɔ̄, bʉəbɛʼbə nɔ kə bɛ chɔ kə́ chyìi binjyʉʉhə-ʉə ndʉʉbətyuʼ-ghɔ̄. <verse eid="LUK 2:8" /><verse number="9" style="v" sid="LUK 2:9" />WontəŋTiekətʉ kwɔnə fyú mu bɔŋ, məgʉə-Tiekətʉ báa yə̀ŋhə bɔŋ, faa-kwu-kə yá bɔŋ shʉ́əshʉ́ə. <verse eid="LUK 2:9" /><verse number="10" style="v" sid="LUK 2:10" />Mbʉ wontəŋNyii ghɔ̀ŋ tʉ bɔŋ mbɔ, “Kə bii mə leʼ fàa fɛ, mɔ nɔ gwè nə ntəŋjyujyu tʉ bii, ndə i bu gwè nə tʉʉjyu tʉ bʉə-lɔʼɔ-bii bənchəŋ. <verse eid="LUK 2:10" /><verse number="11" style="v" sid="LUK 2:11" />Laa mu yəŋkwɛʼtəŋ-Dɛbi-kə* bə nɔʼ bí Ŋkwaa-yii, ɔ kə́ bɛ Wo ndə Nyii Kùŋ Tə́ŋ bɔŋ-kə́-leʼ bɛ Tiekətʉ. <verse eid="LUK 2:11" /><verse number="12" style="v" sid="LUK 2:12" />Yɔ̄ŋ-yə bu bɛ cheʼkə tʉ bii, bii bu nyíɛ vaa mu ŋkyʉʉ-bihə-kə tʉ bə nɔʼ bɔ́nə ɔŋ mu ndyihə.”<verse eid="LUK 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13" />Kə kwɔnə nyíɛ, nuɔ-bʉəntəŋNyii fyú gwè hə yuo, bìa mbʉ wontəŋNyii, bɔ̂ŋ kə́ lə̀ʼtə Nyii ghɔ̀ŋ mbɔ,<verse eid="LUK 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14" />“Tə məgʉ́ə bɛ tʉ Nyii tə dàa liʼ yuo,</para>
  <para style="q2" vid="LUK 2:14">kəchisê fyiighʉ́ənə mu bʉəməsʉʉ, ndə tʉʉ-i bʉ̀ʉ tʉ bɔŋ.”<verse eid="LUK 2:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="LUK 2:15" />Ndʉʉ ndə mbʉ bʉəntəŋNyii bʉ̀nə gɛ̀ yuo, mbʉ bənchyii binjyʉʉhə ghɔ̀ŋ tʉ ŋwɔŋtə-ʉə mbɔ, “B̈ʉʼʉ lɔ̀ haʼ nduɔnduɔ gɛ̀ Bɛtələhɛŋ, gɛ̀ nyíɛ nukə-ɔ̄ŋ ndə i fyú, Tiekətʉ chìi bʉʼʉ kínə nɔ.”<verse eid="LUK 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16" />Bɔ̂ŋ lə̀ŋnə gɛ̀ nyíɛ Mɛli ghɔŋ Jɔsɛ leʼnə mbʉ vaa, ɔ kə́ nʉ̀ʉ mu ŋkyʉʉ-bihə-kə. <verse eid="LUK 2:16" /><verse number="17" style="v" sid="LUK 2:17" />Ndʉʉ ndə bɔ̂ŋ nyíɛ ɔŋ, bɔ̂ŋ chìi bə kínə nubə ndə bʉəntəŋNyii kə shyíi bɔŋ te nə mbʉ vaa-maa-ɔ̄ŋ. <verse eid="LUK 2:17" /><verse number="18" style="v" sid="LUK 2:18" />Bʉə bənchəŋ ndə bɔ̂ŋ kə yʉ́ nubə-ɔ̄ŋ, i nɔ kə chíe chu-yʉə, te nə nubə ndə mbʉ bənchyii binjyʉʉhə kə shyíi bɔŋ. <verse eid="LUK 2:18" /><verse number="19" style="v" sid="LUK 2:19" />Bɔŋ Mɛli mɔ̀ʼ nubə-ɔ̄ŋ inchəŋ mu fyii-ɔ kə́ tíetə. <verse eid="LUK 2:19" /><verse number="20" style="v" sid="LUK 2:20" />Mbʉ bənchyii binjyʉʉhə bʉ̀nə gɛ̀, kə́ kɔ́ kuŋhə bɔŋleʼ kə́ lə̀ʼtə Nyii ndəŋ nubə ndə bɔ̂ŋ kə yʉ́ bɔŋleʼ nyíɛ, kɛŋ haʼ ndə mbʉ bʉəntəŋNyii kə shyíi bɔŋ.<verse eid="LUK 2:20" /></para>
  <para style="s">Bə gɛ̀ nə Jiso mu njaafɛ̀ʼndɛŋNyii</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21" />Wyuu kʉ̂ʉ kə̀ŋ, ndʉʉ kʉ̀ʼnə ndə bə kie ndə məfɔ̀ʼ ɔ, bə tyú yie-e nə Jiso, kə́ bɛ yie ndə wontəŋNyii kə tyú bə buŋ gʉ̀ʼ ɔ.<verse eid="LUK 2:21" /></para>
  <para style="p">
    <verse number="22-23" style="v" sid="LUK 2:22-23" />I kʉ̂ʉ tíŋ nə chi, Mɛli ghɔŋ Jɔsɛ lʉ̀ ɔ gɛ̀ nə nɔŋ Jɛlosalɛŋ ndə məgɛ̀ dʉ̀ʼ ɔ mu njaafɛ̀ʼndɛŋNyii, haʼ ndə nuʼ-Tiekətʉ ghɔ̀ŋ mbɔ, “Fəŋ vaabələŋ təmiyɔŋ ndə ɔ bɛ nchoʼkətʉ, bu bɛ tʉ Tiekətʉ.” Ndʉʉ bɔŋleʼ kʉ̀ʼnə ghɔ tʉ bɔŋ ndə məsʉ̀ ŋwɔŋ-yʉə, gháaNyii haʼ ndə nuʼ-Mushi ghɔŋ. <verse eid="LUK 2:22-23" /><verse number="24" style="v" sid="LUK 2:24" />Bɔ̂ŋ bɔŋleʼ bɛ ndə məfɛ̀ʼndɛŋ haʼ ndə nuʼ-Tiekətʉ ghɔ̀ŋ, kɔ́ “vâabəŋgwɔŋ-tambʉətə ibûu, byuunɔ byuunətə ibûu.”<verse eid="LUK 2:24" /></para>
  <para style="s">Simiɔŋ kɔ́ ndɔ Nyii ndə mbʉ vaa, Jiso</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25" />Nɔ nə bɛ ndʉʉ-ghɔ̄ Jɛlosalɛŋ, wobɛʼ kə́ bɛ chɔ bə kə́ tíi ɔ nə Simiɔŋ kə́ bɛ wo ndə ɔ bɛ ndyʉndyʉ bɔŋ-nɔʼ-leʼ kɔ́ ŋwɔŋ-ɛŋ tʉ Nyii. Ɔ kə́ chyìi ndə mənyíɛ ndə Nyii bu yá fyii bʉə-Isilɛ ndə məfyúhə bɔŋ mu ŋgʉəʼ. Ɔ nɔ kə bɛ wo ndə LyʉʉhəNyiikə kə bɛ mu mbʉə-ɔ. <verse eid="LUK 2:25" /><verse number="26" style="v" sid="LUK 2:26" />Mbʉ kəLyʉʉhəNyii nɔʼ kə kɛ̀ʼ tʉ ɔŋ mbɔ ɔ la bu nyíɛ mbʉ Wo ndə Tiekətʉ Kùŋ Tə́ŋ, buŋ kwú. <verse eid="LUK 2:26" /><verse number="27" style="v" sid="LUK 2:27" />LyʉʉhəNyiikə chóʼ ɔ, ɔ lɔ̀ gɛ̀ mu chunjaafɛ̀ʼndɛŋNyii ndʉʉ ndə bətie-Jiso gwè nə nɔŋ ndə məgwè chìi nubə ndəŋ ɔŋ ndə nuʼ dʉ̀ʼ. <verse eid="LUK 2:27" /><verse number="28" style="v" sid="LUK 2:28" />Simiɔŋ bɛ̀ʼ ɔ kəghɔ-ɔ, kə́ lə̀ʼtə Nyii, ghɔ̀ŋ mbɔ,<verse eid="LUK 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29" />“Tiekətʉ, a nɔʼ fɔ̀ʼ nukə ndə a kə kɔ̀ʼnə,</para>
  <para style="q2" vid="LUK 2:29">lʉ̀ fʉə-a nduɔ hə kəwʉʉnəmbi nə fyiighʉ́ənə,<verse eid="LUK 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30" />shʉ-ɔ nɔʼ nyíɛ wo ndə ɔ bu kwáa wʉʉnəmbikə,<verse eid="LUK 2:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="LUK 2:31" />ndə a nɔʼ shʉ̀tə mbɔ bʉə bənchəŋ nyíɛ.<verse eid="LUK 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32" />Nɔ bɛ kɛʼɛ ndə mədʉ̀ʼ fia tʉ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Isilɛ fɛ,</para>
  <para style="q2" vid="LUK 2:32">kə́ bɛ məgʉ́ə tʉ bʉə-ba Isilɛ!”<verse eid="LUK 2:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="LUK 2:33" />Mbʉ tie-vaa ghɔŋ ŋkwê-i, i chíe chu-yʉə ndə nukə ndə ɔ gìe te mbʉ vaa. <verse eid="LUK 2:33" /><verse number="34" style="v" sid="LUK 2:34" />Simiɔŋ gháaNyii mbɔ ɔ̈ bìʼ bɔŋ, leʼ ghɔ̀ŋ tʉ Mɛli ŋkwê-i mbɔ, “Vaa-ɔ̄ŋ, Nyii nɔʼ séʼ ɔ, bʉʼka ɔ, bʉə-Isilɛ buŋmbi bu gwù fɛʼɛ, bəbɛʼbə yú. Ɔ bɔŋ bu bɛ cheʼkə ndə bə bu kə́ dʉ̀ʉhə. <verse eid="LUK 2:34" /><verse number="35" style="v" sid="LUK 2:35" />Nyii bu chìi yɔ̄ŋ-yə mbɔ i kɛ̀ʼ nubə ndə i bɛ mu fyii-bʉə-hə, bɔŋ ndə məbìʼ chɔ bə bu chʉ̀ə fyii-a mɔ̀ʼ muŋgɔ.”<verse eid="LUK 2:35" /></para>
  <para style="s">Ana núhə nubə ndə Nyii dʉ̀ʼ tʉ ɔŋ</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36" />Vɛʼ-ghɔ̄, wokebɛʼ nɔ kə bɛ ghɔ ndə yie-e kə bɛ Ana kə́ bɛ yʉkəŋgieNyii bɔŋ-kə́-leʼ bɛ vaa-Fanuɛl, lɔ̀ hə kəlɔŋ-Asha. Tʉ Ana nɔʼ kɛŋ shʉ̀tə dùɔŋ, ɔ nɔ kə kie ləŋ-ɛŋ, ghɔŋ ɔŋ chí ŋgʉʼhə təkwiitia, ɔ kwú. <verse eid="LUK 2:36" /><verse number="37" style="v" sid="LUK 2:37" />Ɔ nɔ nə bɛ ŋgʉʼhə njuɔ kwi nə wuŋ fɔŋ, gòʼ mu njaafɛ̀ʼndɛŋNyii ŋgɔŋŋgɔŋ, kə́ fɔ̀ʼ tʉ Nyii ndʉʉnəchî ghɔŋbə ndʉʉbətyuʼ, kə́ gháaNyii, tə kə́ leʼ jì muu. <verse eid="LUK 2:37" /><verse number="38" style="v" sid="LUK 2:38" />Haʼ ndʉʉmɛ, ɔ kwɛ̀ʼtə gwè mbʉə bɔŋ kə́ kɔ́ ndɔ ghɔ tʉ Nyii, bɔŋleʼ kwə́ʼ te mbʉ vaa tʉ bʉə bənchəŋ ndə bɔ̂ŋ kə́ lɛ́nə fia mbɔ Nyii chʉ̀ʼ tʉ-bʉə-Jɛlosalɛŋ-kə.<verse eid="LUK 2:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39" />Ndʉʉ ndə Mɛli ghɔŋ Jɔsɛ lìʼ nubə ndə nuʼ-Tiekətʉ ghɔ̀ŋ, bɔ̂ŋ bʉ̀nə gɛ̀ lɔʼɔbə-ɔŋ Nasalɛ mu Galili. <verse eid="LUK 2:39" /><verse number="40" style="v" sid="LUK 2:40" />Mbʉ vaa kə́ kʉ̀ʼ shʉ́ətə, kie mukətʉ súunə yɔ́ŋyɔ́ŋ, buuŋ-Nyii bʉ̀ʉ ndəŋ ɔŋ.<verse eid="LUK 2:40" /></para>
  <para style="s">Vɛʼ ndə Jiso kə bɛ vaambuɔ, ɔ kə́ kwə́ʼ ghɔŋbə bʉə dàhə nuʼ-Mushi mu njaafɛ̀ʼndɛŋNyii</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41" />Ŋgʉʼʉ tə mì ŋgʉʼʉ, bətie-bi gɛ̀ ndə nchəŋtə Yíɛʼsii Jɛlosalɛŋ. <verse eid="LUK 2:41" /><verse number="42" style="v" sid="LUK 2:42" />Jiso kʉ̂ʉ dàa ŋgʉʼhə njuɔ bûu nə wuŋ, bɔ̂ŋ kóʼ gɛ̀ ndə mbʉ nchəŋtə ndəŋ nuʼ. <verse eid="LUK 2:42" /><verse number="43" style="v" sid="LUK 2:43" />Bə kʉ̂ʉ yú mbʉ nchəŋtə liʼ, bətie-bi kʉ̂ʉ kə́ bʉ̀nə chunjaa, Jiso shi káa Jɛlosalɛŋ, bɔŋ təmə bɔ̂ŋ kínə fɛ. <verse eid="LUK 2:43" /><verse number="44" style="v" sid="LUK 2:44" />Bɔ̂ŋ tòʼ ndəŋ chîmbi-ŋkwɔŋ-kə, kə́ kwɔ̀ʼtə mbɔ ɔ la bɛ haʼ mu bʉə-nuɔ-bɔŋ. Ndʉʉmɛ, bɔ̂ŋ chʉ́ʉhə məkʉ́ʉ ɔ mu bʉə-bʉə ghɔŋbə bətieŋkɔŋ-bʉə.<verse eid="LUK 2:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 2:45" />Bɔ̂ŋ kʉ̂ʉ kʉ́ʉ ɔ kəŋkaa, bʉ̀nə gɛ̀ Jɛlosalɛŋ ndə məlɛ́nə ɔŋ. <verse eid="LUK 2:45" /><verse number="46" style="v" sid="LUK 2:46" />Tə kʉ̂ʉ bɛ chîbə itia, bɔ̂ŋ nyíɛ ɔŋ mu chunjaafɛ̀ʼndɛŋNyii, ɔ kə́ dùʼ mu bəchicha kə́ yíe nubə ndə bɔ̂ŋ tʉʼ gìe, bɔŋ-kə́-leʼ bíʼtə nubə tʉ bɔŋ. <verse eid="LUK 2:46" /><verse number="47" style="v" sid="LUK 2:47" />Wotəmiyɔŋ ndə ɔ̈ yʉ́ ɔ, i chàa ɔ ndə ntɛ ndə ɔ tʉʼ bə̀ŋhə nubə nə ndaa.<verse eid="LUK 2:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 2:48" />Bətie-bi kʉ̂ʉ nyíɛ ɔŋ, i chàa bɔŋ. Ŋkwê-i ghɔ̀ŋ tʉ ɔŋ mbɔ, “Ŋaʼ, a yì ka nə baʼa nɔ? Baʼa tie-a nɔʼ kʉ́ʉ a ŋgwɔŋgwɔhə kəŋkaa.”<verse eid="LUK 2:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49" />Ɔ bíʼtə tʉ bɔŋ mbɔ, <char style="wj">“Bii kə́ kʉ́ʉ mɔ mbuka? Bii kínə mbɔ mɔ kie ndə məfɔ̀ʼ fɔʼɔ-Tie-ɔ fe?”</char> <verse eid="LUK 2:49" /><verse number="50" style="v" sid="LUK 2:50" />Bɔŋ təmə bɔ̂ŋ kínə nukə ndə ɔ tʉʼ gìe tʉ bɔŋ fɛ.<verse eid="LUK 2:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51" />Ndʉʉmɛ, ɔ shíʼ gɛ̀ ghɔŋ bɔŋ Nasalɛ, gɛ̀ kə́ yʉ́ chu-yʉə. Mbʉ ŋkwê-i mɔ̀ʼ nubə-ɔ̄ŋ mu fyii-ɔ kə́ bíehə tíetə. <verse eid="LUK 2:51" /><verse number="52" style="v" sid="LUK 2:52" />Jiso kə́ kóʼ nə mukətʉ-súunə ghɔŋbə mbʉə-e. Buuŋ-Nyii bʉ̀ʉ ndə ɔŋ, bʉə bənchəŋ kʉ̀ʉ ɔ.<verse eid="LUK 2:52" /></para>
  <chapter eid="LUK 2" />
  <chapter number="3" style="c" sid="LUK 3" />
  <para style="s">Jɔŋ ndə ɔ̃ kɔ́ muu shʉ̀tə fia</para>
  <para style="r">(<ref loc="MAT 3:1-12">Matia 3:1-12</ref>; <ref loc="MRK 1:1-8">Mak 1:1-8</ref>; <ref loc="JHN 1:19-28">Jɔŋ 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1" />Ndʉʉ ndə Tibelu kə́ sɔ́ʼ fɔŋ ndəŋ ŋgʉʼhə njuɔ taa nə wuŋ, vɛʼ-ghɔ̄ Bɔŋtio Bale kə́ bɛ gɔməna Judia, Hɛlo kə́ sɔ́ʼ Galili, liŋ-iŋ Fili kə́ sɔ́ʼ Itolia ghɔŋ Talakoniti, Lisania kə́ sɔ́ʼ Abilɛŋ. <verse eid="LUK 3:1" /><verse number="2" style="v" sid="LUK 3:2" />Vɛʼ-ghɔ̄, Anashi ghɔŋ Kaifa kə́ bɛ bətiefɛ̀ʼndɛŋkwɛʼtəŋNyii, Nyii kwə́ʼ tʉ Jɔŋ vaa-Sakalia mu kwɔŋkəyəŋnə. <verse eid="LUK 3:2" /><verse number="3" style="v" sid="LUK 3:3" />Jɔŋ gɛ̀ mu lɔʼ-bətə̂ŋ-tə buŋmbi mbʉə Jodaŋ, kə́ tòʼ kwə́ʼ ŋgieNyiikə mbɔ b̈ʉə la fí muu ndə mədʉ̀ʼ mbɔ bɔ̂ŋ nɔʼ shìe liɛŋtə-ʉə ndəŋ bʉ̂ʼtə-ʉə, gwè tʉ Nyii, ɔ bɔŋleʼ sʉ̀fyii hə ndəŋ mbʉ təbʉ̂ʼ. <verse eid="LUK 3:3" /><verse number="4" style="v" sid="LUK 3:4" />Haʼ ndə bə nyɔ̀ʼ mu ŋwɔʼnə-Nyii nə ŋgie-Adaya-kə, yʉkəŋgieNyii mbɔ,</para>
  <para style="q1" vid="LUK 3:4">“Gyʉʉ-wobɛʼ nɔ tʉʼ tíi mu kwɔŋkəyəŋnə kə́ ghɔ̀ŋ mbɔ,</para>
  <para style="q1" vid="LUK 3:4">‘B̈ii shʉ̀tə fia Tiekətʉ,</para>
  <para style="q2" vid="LUK 3:4">b̈ii shʉ̀tə fiatə-i, ï tə́nə ndyʉndyʉ.<verse eid="LUK 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5" />Bə bu lə́ŋhə lʉʉnəbə inchəŋ,</para>
  <para style="q2" vid="LUK 3:5">bə bu sə̀ʼ kwɔŋhə ghɔŋbə ŋkoʼhə.</para>
  <para style="q1" vid="LUK 3:5">Fia-bəŋgəŋ-tə bu tə́nə ndyʉndyʉ,</para>
  <para style="q2" vid="LUK 3:5">fia-chə́ŋtə-tə lʉ̀ʉhə.<verse eid="LUK 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6" />Bʉə bənchəŋ bu nyíɛ ndə</para>
  <para style="q2" vid="LUK 3:6">Nyii bu kwáa bɔŋ.’ ”<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">Adaya 40:3-5.</char></note><verse eid="LUK 3:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="LUK 3:7" />Jɔŋ gìe tʉ bʉə ndə bɔ̂ŋ tʉʼ gwè fí muu mbɔ, “Mbəŋ-yii ŋgwie kəfɛfɛ! Shyùu nda shyùu tyunəkə-ii mbɔ bii líi tʉʉbʉə Nyii-ɔ̄ŋ ndə i tʉʼ gwè nɔ? <verse eid="LUK 3:7" /><verse number="8" style="v" sid="LUK 3:8" />B̈ii kʉ́ʉnə ntɔŋmə ndə mədʉ̀ʼ mbɔ bii nɔʼ shìe liɛŋtə-ii hə ndəŋ bʉ̂ʼtə-ii. Kə bii mə buŋ kə́ kwɔ̀ʼtə ndə məghɔ̀ŋ tʉ ŋwɔŋ-yii mbɔ, ‘Ablahaŋ nɔ bɛ tie-yaʼ ’ fɛ. Mɔ nɔ tʉʼ shyíi bii, bəkɔ Nyii chìi vâa tʉ Ablahaŋ ndəŋ ŋgoʼhə-ɔ̄ŋ. <verse eid="LUK 3:8" /><verse number="9" style="v" sid="LUK 3:9" />Bə nɔʼ shʉ̀tə njɔŋ tʉ́ʼ ndəŋ ghûu-bətyʉ-tə, tyʉkə təmiyɔŋ ndə i bu gòʼ təmə kʉ́ʉnə ntɔŋ-jyujyu-mə fɛ, bə bu gwìa mɔ̀ʼ sê tɔ̀ŋ mu viʼi.”<verse eid="LUK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10" />Mbʉ bʉə bíʼtə mbɔ, “Baʼa bɛ təka nduɔ le?”<verse eid="LUK 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11" />Jɔŋ bə̀ŋhə mbɔ, “Ẅo ndə ɔ kie ndyihə ibûu, kɔ́ imɔʼ tʉ wo ndə ɔ gòʼ təmə kie fɛ. Wo ndə ɔ kie fɔyubə, ɔ̈ chìi haʼ nɔ.”<verse eid="LUK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12" />Bʉə fí tashi gwè haʼ ghɔ ndə məfì muu, bíʼtə tʉ ɔŋ mbɔ, “Chicha, baʼa bɛ təka?”<verse eid="LUK 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13" />Jɔŋ ghɔ̀ŋ tʉ bɔŋ mbɔ, “Kə bii mə kə́ fí kyʉə i tíŋ ntyʉʉ ndə bii kie ndə məfì fɛ.”<verse eid="LUK 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14" />Bəsɔgebɛʼbə gwè, bíʼtə tʉ ɔŋ mbɔ, “Baʼa bɛ təka?”</para>
  <para style="p" vid="LUK 3:14">Ɔ bə̀ŋhə mbɔ, “Kə bii mə kə́ kwɛ̀ŋhə bʉə mbɔ bɔ̂ŋ kɔ́ kyʉə-yʉə tʉ bii fɛ, byuunɔ mɔʼɔ lɛɛŋkə kətʉ-bɔŋ fɛ. T̈ʉʉ-yii bʉ̀ʉ ndə lɔʼɔbə-ii.”<verse eid="LUK 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15" />Mbʉ bʉə nɔ nə gòʼ nə shʉtə-ʉə sêfia, bɔ̂ŋ kə́ kwɔ̀ʼtə mu fyii-bɔŋ mbɔ bəkɔ Jɔŋ bɛ Wo ndʉʉbɛʼ ndə Nyii Kùŋ Tə́ŋ. <verse eid="LUK 3:15" /><verse number="16" style="v" sid="LUK 3:16" />Jɔŋ bə̀ŋhə tʉ bɔŋ mbɔ, “Mɔ nɔ tʉʼ kɔ́ muu tʉ bii, bɔŋ wo tʉʼ gwè ndə ɔ bu shʉ́ə chàa mɔ, mɔ kʉ̀ʼnə ndə məyɔ̀ʼ ghyʉʉ-bətakwu-i fɛ. Ɔ bu kɔ́ LyʉʉhəNyiikə<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">Məkɔ́ LyʉʉhəNyiikə, nɔ bɛ məbáa wo mu LyʉʉhəNyiikə haʼ ndə b̃ə báa wo muu ndə məfì muu nɔ.</char></note> ghɔŋbə viʼi tʉ bii. <verse eid="LUK 3:16" /><verse number="17" style="v" sid="LUK 3:17" />Baŋ fʉ́əʼ lɛshi nɔ kəghɔ-ɔ, ndə məyʉ̀əʼ yəŋ-bʉ́ʼ-lɛshi-kə-i, ndə məbyíi yʉʼ-i kə́ŋhə mu kwo, chə̀ŋtə fʉlʉlʉbə ghɔŋbə vɛtə tɔ̀ŋ mu viʼi təmə i mə nə lʉ́əŋnə fɛ.” <verse eid="LUK 3:17" /><verse number="18" style="v" sid="LUK 3:18" />Jɔŋ shyùu tyunəkə-ʉə ntɛntɛhə ndə ɔ kə́ lɔ̀ʼ mbʉ ntəŋjyujyu.<verse eid="LUK 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 3:19" />Bɔŋ Jɔŋ kʉ̂ʉ sɔ́ʼ Gɔməna Hɛlo bʉʼka ɔ lʉ̀ Hɛlodia ndə ɔ kə bɛ vi-liŋ-iŋ ghɔŋbə nu-bʉəbʉəbɛʼ-bə ndə ɔ nɔʼ chìi, <verse eid="LUK 3:19" /><verse number="20" style="v" sid="LUK 3:20" />Hɛlo bìʼ chìi ibɛʼ-yə fɔŋ bʉ̂ʼʉ ndə məfʉ̀əŋ Jɔŋ chaŋ.<verse eid="LUK 3:20" /></para>
  <para style="s">Ntɛ ndə Jiso kə fí muu</para>
  <para style="r">(<ref loc="MAT 3:13-17">Matia 3:13-17</ref>; <ref loc="MRK 1:9-11">Mak 1:9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21" />Bə kɔ́ muu tʉ Jiso ghɔ mu vɛʼ ndə bə kə kə́ kɔ́ tʉ bʉə bənchəŋ. Ndʉʉ ndə ɔ nə kə́ gháaNyii, yúotə ŋɔ́ʼnə, <verse eid="LUK 3:21" /><verse number="22" style="v" sid="LUK 3:22" />LyʉʉhəNyiikə shíʼ gwè ndəŋ ɔŋ, kie mbʉə bɛ nə tambʉətə, gyʉʉ gwè hə yuo kə́ ghɔ̀ŋ mbɔ, “A nɔ bɛ vaa-ɔŋ ndə mɔ kʉ̀ʉ daa, tʉʉ-ɔ nɔ bʉ̀ʉ ndəŋ aŋ jyujyu.”<figure style="fig" alt="The baptism of Jesus" file="Cn01656c.tif" size="col" copy="David C. Cook" ref="3:22">Jiso fí muu</figure><verse eid="LUK 3:22" /></para>
  <para style="s">Gyʉʉ-wobɛʼ Jiso</para>
  <para style="r">(<ref loc="MAT 1:1-17">Matia 1:1-17</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23" />Jiso nɔ nə kə chʉ́ʉhə fɔʼɔ-ɛ kə́ bɛ ŋgʉʼhə wuŋ tia.</para>
  <para style="p" vid="LUK 3:23">Jiso nɔ nə bɛ vaabələŋ, bə kwɔ̀ʼtə mbɔ nɔ bɛ vaa-Jɔsɛ, vaa-Hili, <verse eid="LUK 3:23" /><verse number="24" style="v" sid="LUK 3:24" />vaa-Matat, vaa-Lɛvi, vaa-Mɛki, vaa-Jana, vaa-Jɔsɛ, <verse eid="LUK 3:24" /><verse number="25" style="v" sid="LUK 3:25" />vaa-Matatia, vaa-Ɛmɔ, vaa-Nahuŋ, vaa-Esli, vaa-Nagai, <verse eid="LUK 3:25" /><verse number="26" style="v" sid="LUK 3:26" />vaa-Mat, vaa-Matatia, vaa-Sɛmin, vaa-Jɔsɛkə, vaa-Joda, <verse eid="LUK 3:26" /><verse number="27" style="v" sid="LUK 3:27" />vaa-Juanaŋ, vaa-Lɛsa, vaa-Sɛlubabɛ, vaa-Shɛtiɛl, vaa-Nɛli, <verse eid="LUK 3:27" /><verse number="28" style="v" sid="LUK 3:28" />vaa-Mɛki, vaa-Adi, vaa-Kosam, vaa-Ɛmadam, vaa-Ɛlɛ, <verse eid="LUK 3:28" /><verse number="29" style="v" sid="LUK 3:29" />vaa-Joshua, vaa-Eliɛsa, vaa-Jolim, vaa-Matat, vaa-Lɛvi, <verse eid="LUK 3:29" /><verse number="30" style="v" sid="LUK 3:30" />vaa-Simiɔŋ, vaa-Juda, vaa-Jɔsɛ, vaa-Jonam, vaa-Ɛliakiŋ, <verse eid="LUK 3:30" /><verse number="31" style="v" sid="LUK 3:31" />vaa-Mɛlia, vaa-Mɛna, vaa-Matada, vaa-Nataŋ, vaa-Dɛbi, <verse eid="LUK 3:31" /><verse number="32" style="v" sid="LUK 3:32" />vaa-Jesi, vaa-Obɛ, vaa-Boa, vaa-Salmɔŋ, vaa-Nashɔŋ, <verse eid="LUK 3:32" /><verse number="33" style="v" sid="LUK 3:33" />vaa-Aminada, vaa-Lam, vaa-Hɛslɔŋ, vaa-Bɛlɛsh, vaa-Juda, <verse eid="LUK 3:33" /><verse number="34" style="v" sid="LUK 3:34" />vaa-Jakɔ, vaa-Aisi, vaa-Ablahaŋ, vaa-Tela, vaa-Naho, <verse eid="LUK 3:34" /><verse number="35" style="v" sid="LUK 3:35" />vaa-Sɛlu, vaa-Lɛo, vaa-Bɛlɛ, vaa-Ɛbɛ, vaa-Shɛla, <verse eid="LUK 3:35" /><verse number="36" style="v" sid="LUK 3:36" />vaa-Kana, vaa-Afasa, vaa-Shɛŋ, vaa-Nua, vaa-Lamɛ, <verse eid="LUK 3:36" /><verse number="37" style="v" sid="LUK 3:37" />vaa-Mɛtusɛla, vaa-Ɛnɔ, vaa-Jali, vaa-Mahalali, vaa-Kana, <verse eid="LUK 3:37" /><verse number="38" style="v" sid="LUK 3:38" />vaa-Ɛnɔsh, vaa-Sɛ, vaa-Adaŋ, vaa-Nyii.<verse eid="LUK 3:38" /></para>
  <chapter eid="LUK 3" />
  <chapter number="4" style="c" sid="LUK 4" />
  <para style="s">Sata mùutə Jiso</para>
  <para style="r">(<ref loc="MAT 4:1-11">Matia 4:1-11</ref>; <ref loc="MRK 1:12-13">Mak 1:12-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1" />Jiso bɛ nə LyʉʉhəNyiikə mbʉə-ɔ ilə́ŋnə, vɛʼ ndə ɔ lɔ̀ hə ŋgwɛŋ Jodaŋ, LyʉʉhəNyiikə chóʼ ɔ, ɔ gɛ̀ kwɔŋkəyəŋnə. <verse eid="LUK 4:1" /><verse number="2" style="v" sid="LUK 4:2" />Ndə chîbə wuŋ kwi Debulu kə́ mùutə ɔŋ chɔ mbɔ ɔ̈ gwù mu bʉʼʉ. Ndə chî-ghɔ̄-bə inchəŋ, təmə ɔ̈ yú fɔkə fɛ, kəliʼ jyʉʉ yɔ́ʼ ɔ.<verse eid="LUK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3" />Debulu ghɔ̀ŋ tʉ ɔŋ mbɔ, “Kaʼ bɛ mbɔ a bɛ VaaNyii, téʼ tʉ ŋgoʼ-ɔ̄ mbɔ ï la bə̀ŋ bele.”<verse eid="LUK 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4" />Ɔ bə̀ŋhə mbɔ, <char style="wj">“Bə nɔ nyɔ̀ʼ mu ŋwɔʼnə-Nyii mbɔ,</char></para>
  <para style="q1" vid="LUK 4:4">
    <char style="wj">‘Wo mə kə́ chí mbi bə haʼ nə bele fɛ.’ ”</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">4:4 </char>
      <char style="ft" closed="false">Məbìʼ Kɔ́ Nuʼ 8:3.</char>
    </note><verse eid="LUK 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5" />Debulu lʉ̀ ɔ ghɔ́ŋ ɔŋ kóʼ gɛ̀ kweghɔʼ, ɔ chìi, ɔ nyíɛ lɔʼ-bətə̂ŋ-tə inchəŋ ndə i kə bɛ kəwʉʉnəmbi haʼ ndʉʉmɛ. <verse eid="LUK 4:5" /><verse number="6" style="v" sid="LUK 4:6" />Debulu ghɔ̀ŋ tʉ ɔŋ mbɔ, “Bə nɔʼ kɔ́ ghʉəʼkə-ʉə ghɔŋbə məgʉə-yʉə tʉ mɔ, mɔ bu kɔ́ tʉ a, bɔŋ bəkɔ mɔ kɔ́ tʉ wo ndə mɔ kʉ̀ʉ. <verse eid="LUK 4:6" /><verse number="7" style="v" sid="LUK 4:7" />Kaʼ a lə̀ʼtə mɔ, mɔ kɔ́ tʉ a inchəŋ.”<verse eid="LUK 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8" />Jiso bə̀ŋhə mbɔ, <char style="wj">“Bə nɔ nyɔ̀ʼ mu ŋwɔʼnə-Nyii mbɔ,</char></para>
  <para style="q1" vid="LUK 4:8">
    <char style="wj">‘A nɔ kie ndə mələ̀ʼtə Nyii Tiekətʉ-a, kə́ fɔ̀ʼ haʼ tʉ ɔŋ tətɛʼ ɔ.’ ”</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">4:8 </char>
      <char style="ft" closed="false">Məbìʼ Kɔ́ Nuʼ 6:13.</char>
    </note><verse eid="LUK 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="LUK 4:9" />Debulu lʉ̀ ɔ gɛ̀ nə nɔŋ Jɛlosalɛŋ gɛ̀ chìi ɔ kóʼ tə́nə jɔŋ kətʉ njaafɛ̀ʼndɛŋNyii, ghɔ̀ŋ tʉ ɔŋ mbɔ, “Kaʼ a bɛ VaaNyii, ä sɛ́ʼ fɛ̄ŋ chə́ŋ sê, <verse eid="LUK 4:9" /><verse number="10" style="v" sid="LUK 4:10" />bʉʼka ŋwɔʼnə-Nyii nɔ ghɔ̀ŋ mbɔ,</para>
  <para style="q1" vid="LUK 4:10">‘Ɔ bu kàhə bʉəntəŋ-bi bɔ̂ŋ kə́ chyìi a jyujyu.’<verse eid="LUK 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LUK 4:11" />I bɔŋleʼ ghɔ̀ŋ mbɔ, ‘Bɔ̂ŋ bɔŋ-bu-leʼ bɛ̀ʼ a kəghɔ-bɔŋ bʉʼka a mə yi</para>
  <para style="q2" vid="LUK 4:11">kwɔ̀ŋ wukə-a ndəŋ ŋgoʼ.’ ”<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="ft" closed="false">Ŋwɔʼnə-təLyuu 91:11-12.</char></note><verse eid="LUK 4:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="LUK 4:12" />Jiso bə̀ŋhə tʉ ɔŋ mbɔ, <char style="wj">“Bə nɔ bìʼ nyɔ̀ʼ mu ŋwɔʼnə-Nyii mbɔ, ‘A kie ndə məyúotə Nyii Tiekətʉ-a fɛ.’ ”</char> <note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">Məbìʼ Kɔ́ Nuʼ 6:16.</char></note><verse eid="LUK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13" />Ndʉʉ ndə Debulu káa mə-kə́-yúotə Jiso mbɔ ɔ̈ gwù mu nubə ndə i chìi wo chìi bʉ̂ʼʉ, ɔ bʉ̀nə hə bɔ̌ŋ ɔŋ kə́ kʉ̀ʼ vɛʼbɛʼ.<verse eid="LUK 4:13" /></para>
  <para style="s">Bə tɛ́ŋ Jiso Nasalɛ</para>
  <para style="r">(<ref loc="MAT 4:12-17">Matia 4:12-17</ref>; <ref loc="MAT 13:53-58">13:53-58</ref>; <ref loc="MRK 1:14-15">Mak 1:14-15</ref>; <ref loc="MRK 6:1-6">6:1-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14" />Jiso bʉ̀nə gɛ̀ Galili ndə ghʉəʼ-kəLyʉʉhəNyii-kə, yie jyujyu-i yə̀ŋ lɔʼɔ fu. <verse eid="LUK 4:14" /><verse number="15" style="v" sid="LUK 4:15" />Ɔ dàhə mu-njaagháaNyii-hə, bə chʉ̀ʉ ɔ bənchəŋ.<verse eid="LUK 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16" />Ɔ gɛ̀ Nasalɛ, kəyəŋ ndə ɔ kóʼ chɔ, kʉ̂ʉ bɛ Chîlɔʼkə, ɔ gɛ̀ mu njaagháaNyii haʼ ndə ɔ̃ chìi, ɔ lɔ̀ hə sê ndə mətíi ŋwɔʼnə-Nyii. <verse eid="LUK 4:16" /><verse number="17" style="v" sid="LUK 4:17" />Bə lʉ̀ ŋwɔʼnə-Adaya yʉkəŋgieNyii kɔ́ tʉ ɔŋ, ɔ kʉ̂ʉ ŋɔ́ʼhə, nyíɛ yəŋkə ndə bə nyɔ̀ʼ chɔ mbɔ,<verse eid="LUK 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18" />
    <char style="wj">“LyʉʉhəTiekətʉkə nɔ bɛ mbʉə-mɔ,</char></para>
  <para style="q2" vid="LUK 4:18">
    <char style="wj">bʉʼka mbɔ ɔ nɔʼ kùŋ mɔ ndə məlɔ̀ʼ ntəŋjyujyu tʉ bʉə-kəbyuu.</char></para>
  <para style="q1" vid="LUK 4:18">
    <char style="wj">Ɔ nɔʼ tə́ŋ mɔ mbɔ mɔ gɛ̀ shyíi bʉə-njaa-chaŋ mbɔ,</char></para>
  <para style="q2" vid="LUK 4:18">
    <char style="wj">bɔŋ la nɔʼ fyú hə chaŋ,</char></para>
  <para style="q2" vid="LUK 4:18">
    <char style="wj">bɔŋleʼ shyíi bəfʉ̀əŋtəshʉ mbɔ,</char></para>
  <para style="q2" vid="LUK 4:18">
    <char style="wj">shʉtə-ʉə la nɔʼ ŋɔ́ʼnə,</char></para>
  <para style="q2" vid="LUK 4:18">
    <char style="wj">leʼ shyíi bənyíɛ ŋgʉəʼ mbɔ bɔŋ la nɔʼ bìi.</char><verse eid="LUK 4:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="LUK 4:19" />
    <char style="wj">Bɔŋleʼ lɔ̀ʼ tʉ bʉə mbɔ ŋgʉʼʉmbi nɔʼ kʉ̀ʼnə ndə Tiekətʉ bu kwáa bɔŋ.”</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">4:19 </char>
      <char style="ft" closed="false">Adaya 61:1-2.</char>
    </note><verse eid="LUK 4:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="LUK 4:20" />Ndʉʉmɛ, ɔ bɔ́nə mbʉ ŋwɔʼnə, kɔ́ tʉ wo ndə ɔ tʉʼ fɔ̀ʼ mbʉ mu njaa, gɛ̀ dùʼ sê. Bʉə bənchəŋ mbʉ mu njaagháaNyii tʉ́ʼ shʉ̀tə ndəŋ ɔŋ. <verse eid="LUK 4:20" /><verse number="21" style="v" sid="LUK 4:21" />Ɔ chʉ́ʉhə ndə məghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Laa, ŋgieNyiikə-ɔ̄ŋ nɔʼ fyú shʉəŋ ndə bii tʉʼ yʉ́ nɔ!”</char><verse eid="LUK 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22" />Bʉə bənchəŋ tíi yie-e jyujyu, chu-bʉə-tə chíe ndəŋ ntɛ kwə́ʼ jyujyu ndə i tʉʼ fyú hə kəwuo chu-ɔ. Bɔ̂ŋ bíʼtə mbɔ, “Ka vaa-Jɔsɛ nɔ fe?”<verse eid="LUK 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23" />Jiso ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Ndə shʉəŋ, bii bu gìe líʼnə chəŋkə-ɔ̄ŋ tʉ mɔ mbɔ, ‘Yʉ̀əʼ njaa-a buŋ yʉ̀əʼ mbi,’ fɔ̀ʼ fəŋ mu ya-yə lɔʼɔ nukə ndə baʼa kə yʉ́ mbɔ a kə fɔ̀ʼ Kabanu”</char> <verse eid="LUK 4:23" /><verse number="24" style="v" sid="LUK 4:24" />Ɔ bìʼ kə́ gɛ̀ nə shʉbə ghɔ̀ŋ mbɔ, <char style="wj">“Nɔʼ m̈ɔ shyíi bii nə shʉəŋ, yʉkəŋgieNyii kaa ghɔ ndə bə nɔʼ nə bɛ́ŋ ɔŋ mu lɔʼɔbə-ɔŋ fɛ.</char><verse eid="LUK 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 4:25" />
    <char style="wj">“M̈ɔ shyíi bii nə shʉəŋ, nɔ nə bɛ vɛʼ ndə Ɛlaja kə bɛ yʉkəŋgieNyii, bəkwuʼ bəke nɔ nə bɛ Isilɛ buŋmbi, kə́ bɛ vɛʼ ndə yəŋnəkə kə gwù mbi ndə ŋgʉʼhə itia nə bəʼkə, chyʉʉ gwù mu lɔʼɔ-ghɔ̄ inchəŋ.</char> <verse eid="LUK 4:25" /><verse number="26" style="v" sid="LUK 4:26" /><char style="wj">Təmə bə tə́ŋ Ɛlaja tʉ wo mu bɔŋ fɛ, bɔŋ bə tə́ŋ ɔŋ bə tʉ kwuʼ woke ndə ɔ kə bɛ Salafa kəvia lɔʼɔ Sidɔŋ.</char> <verse eid="LUK 4:26" /><verse number="27" style="v" sid="LUK 4:27" /><char style="wj">Bʉə-kəlɔ kə bɛ lɔʼɔ Isilɛ buŋmbi vɛʼ ndə Elisha kə bɛ yʉkəŋgieNyii təmə ɔ sʉ̀ wofuu fɛ, ɔ tíŋ gɛ̀ sʉ̀ bə Nama ndə ɔ lɔ̀ hə Silia.”</char><verse eid="LUK 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28" />Ndʉʉ ndə bʉə ndə bɔ̂ŋ bɛ mu njaagháaNyii yʉ́ nubə-ɔ̄ŋ, tʉʉtə-ʉə byʉ́ʼ. <verse eid="LUK 4:28" /><verse number="29" style="v" sid="LUK 4:29" />Bɔ̂ŋ lɔ̀ hə sê jə̀ŋ ɔŋ, fyúhə ɔŋ mu lɔʼɔbə-ɔŋ, gɛ̀ nə nɔŋ ndəŋ ŋgwuu ŋkoʼ kəyəŋ ndə bɔ̂ŋ bɔ́ŋ lɔʼɔ-yʉə ndəŋ ghɔ, ndə məmɛ̀ʼ ɔŋ mu ghuu, ɔ kwú. <verse eid="LUK 4:29" /><verse number="30" style="v" sid="LUK 4:30" />Bɔŋ ɔ tòʼ sʉʉtə tíŋ hə mu bʉə, gɛ̀ nə wi.<verse eid="LUK 4:30" /></para>
  <para style="s">Jiso jə̀ŋ lyʉʉhəbʉəbʉəkə</para>
  <para style="r">(<ref loc="MRK 1:21-28">Mak 1:21-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31" />Ndʉʉmɛ, Jiso shíʼ gɛ̀ Kabanu mu Galili, kʉ̂ʉ bɛ ndəŋ Chîlɔʼkə, ɔ chʉ́ʉhə mədàhə bʉə. <verse eid="LUK 4:31" /><verse number="32" style="v" sid="LUK 4:32" />Ntɛ ndə ɔ kə́ dàhə i chíe chutə-ʉə, bʉʼka kwəʼ-ɛ nɔ nə kie ghʉəʼkə chɔ.<verse eid="LUK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 4:33" />Wobɛʼ ndə ɔ kə bɛ mu njaagháaNyii, nə lyʉʉhənyaatəkə mu mbʉə-ɔ, ɔ tíi nə ghʉəʼkə mbɔ, <verse eid="LUK 4:33" /><verse number="34" style="v" sid="LUK 4:34" />“A tʉʼ kʉ́ʉ ka kəghɔ-baʼa, Jiso ndə a lɔ̀ hə Nasalɛ? A tʉʼ gwè yí baʼa mɛ? Mɔ nɔ kínə aŋ, a nɔ bɛ Wo Tʉʉnə ndə a gwè hə bəshʉ-Nyii.”<verse eid="LUK 4:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35" />Jiso sɔ́ʼ ɔ, ghɔ̀ŋ mbɔ, <char style="wj">“Chʉʼ líitə! Fyú hə mbʉə-ɔ!”</char> Mbʉ kəlyʉʉhəbʉəbʉə mɔ̀ʼ mbʉ wo-ghɔ̄ sê bəshʉ bɔŋ, fyú hə mbʉə-ɔ təmə lə́ŋhə ɔŋ fɛ.<verse eid="LUK 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36" />I chíe chutə-ʉə bənchəŋ, bɔ̂ŋ kə́ bíʼtə tʉ ŋwɔŋtə-ʉə mbɔ, “Yɔ̄ŋ-yə bɛ ŋgwɔ ntɛ kəŋgie ka nɔ? Bʉʼka ɔ tʉʼ kàhə lyʉʉhəbʉəbʉəbə nə ghʉəʼkə ndə məgìe kətʉ ghɔŋbə ghʉəʼkə, bɔ̂ŋ fyú!” <verse eid="LUK 4:36" /><verse number="37" style="v" sid="LUK 4:37" />Bə tíi yie-e yə̀ŋ yəŋbə inchəŋ mu lɔʼɔ-ghɔ̄.<verse eid="LUK 4:37" /></para>
  <para style="s">Jiso chʉ́ʼ bʉə buŋmbi</para>
  <para style="r">(<ref loc="MAT 8:14-17">Matia 8:14-17</ref>; <ref loc="MRK 1:29-34">Mak 1:29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38" />Jiso fyú hə mu njaagháaNyii, ŋíi mu njaa-Samu. Naachi-Samu kə́ bɛ nə nchyʉʼ-ləŋ-kə mbʉə-ɔ, bɔ̂ŋ ghɔ̀ŋ tʉ Jiso mbɔ ɔ̈ la kwáa ɔ. <verse eid="LUK 4:38" /><verse number="39" style="v" sid="LUK 4:39" />Ɔ lɔ̀ hə sê tə́nə kətʉ-ɔ, sɔ́ʼ mbʉ kənchyʉʼ, i fyú mbʉə-ɔ, mbʉ naachi-i lɔ̀ hə sê chʉ́ʉhə mətía bɔŋ.<verse eid="LUK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40" />Chichi kʉ̂ʉ kə bùu chusii-ɔ, mbʉ bʉə gwè nə bʉə-bəyɔʼ ndə bɔ̂ŋ kie yɔʼbə ntɛntɛhə tʉ Jiso, ɔ mɔ̀ʼ ghɔkə-i ndəŋ bɔŋ bəmɔʼbəmɔʼ, chʉ́ʼ bɔŋ. <verse eid="LUK 4:40" /><verse number="41" style="v" sid="LUK 4:41" />Lyʉʉhəbʉəbʉəbə bìʼ fyútə ghɔ mbʉə bʉə buŋmbi, kə́ tíitə ghɔ̀ŋ mbɔ, “A nɔ bɛ VaaNyii.” Ɔ sɔ́ʼ bɔŋ təmə bɛ́ŋ mbɔ bɔ̂ŋ kwə́ʼ fɛ, bʉʼka bɔ̂ŋ nɔ kínə mbɔ nɔ bɛ Wo ndə Nyii Kùŋ Tə́ŋ.<verse eid="LUK 4:41" /></para>
  <para style="s">Jiso kə́ bìʼ lɔ̀ʼ ŋgieNyiikə gɛ̀ nə shʉbə</para>
  <para style="r">(<ref loc="MRK 1:35-39">Mak 1:35-39</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42" />Mbi kʉ̂ʉ fíi, Jiso gɛ̀ kəyəŋ-bəliinə. Mbʉ bʉə kə́ tòʼ kʉ́ʉ ɔ, kʉ̂ʉ dàa kəyəŋ ndə ɔ bɛ chɔ, bɔ̂ŋ kə́ chíe ɔ bʉʼka ɔ mə gɛ̀ nə wi. <verse eid="LUK 4:42" /><verse number="43" style="v" sid="LUK 4:43" />Ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Mɔ nɔ kie məgɛ̀ lɔ̀ʼ ntəŋjyujyu te Sɔ́ʼ-Nyii ndəŋ bəbɛʼyəŋbə, bʉʼka mbɔ Nyii nɔ tə́ŋ mɔ shʉəŋ yɔŋ.”</char> <verse eid="LUK 4:43" /><verse number="44" style="v" sid="LUK 4:44" />Ɔ kə́ lɔ̀ʼ ntəŋjyujyu təvɛʼtəvɛʼ mu-njaagháaNyii-hə mu Judia.<verse eid="LUK 4:44" /></para>
  <chapter eid="LUK 4" />
  <chapter number="5" style="c" sid="LUK 5" />
  <para style="s">Fəŋ vâafɔʼɔ</para>
  <para style="r">(<ref loc="MAT 4:18-22">Matia 4:18-22</ref>; <ref loc="MRK 1:16-20">Mak 1:16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1" />Yɔŋbɛʼ, Jiso kə́ tə́nə mbʉə Taanə-kəghəŋ-kə Gɛnɛsɛlɛ<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">Taanə-kəghəŋ-kə Gɛnɛsɛlɛ nɔ bɛ ibɛʼ yie taanə-kəghəŋ-Galili-kə.</char></note>, bʉə buŋmbi kə́ yíʼtə ɔŋ, ndə məyʉ́ ŋgieNyiikə. <verse eid="LUK 5:1" /><verse number="2" style="v" sid="LUK 5:2" />Ɔ nyíɛ buubə ibûu ndə i tə́nə ŋgwuu mbʉ kəghəŋ, tʉ́ʼ bənjuŋgwɔŋ shíʼ kə́ sʉ̀ bəkasinɛ-bʉə. <verse eid="LUK 5:2" /><verse number="3" style="v" sid="LUK 5:3" />Ɔ kóʼ dùʼ mu imɔʼ kə́ bɛ yi-Samu-yə, téʼ tʉ ɔŋ, ɔ tʉ́ʉhə kɔ́ mu mbʉ kəghəŋ məniʼ. Ndʉʉmɛ, ɔ shíʼ dùʼ ndəŋ ghɔ, kə́ dàhə mbʉ bʉə ndəŋ kəbuu.<verse eid="LUK 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4" />Ɔ kʉ̂ʉ kwə́ʼ lìʼ ghɔ̀ŋ tʉ Samu mbɔ, <char style="wj">“Tʉ́ʉhə buukə-a gɛ̀ nə yɔŋ kəyəŋ dɔ̀ŋnə mɔ̀ʼ kasinɛ-a muu ndə məyá mbɔʼ.”</char><verse eid="LUK 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5" />Samu bə̀ŋhə mbɔ, “Tie-ɔ, baʼa nɔʼ fɔ̀ʼ shʉ́əshʉ́ə lʉ̀ hə ndʉʉbuumbi tə mbi fíi, baʼa kə́ mɔ̀ʼ təmə kə yá fɔkə fɛ. Bɔŋ bʉʼka gìe a, mɔ bu mɔ̀ʼ mbʉ kasinɛ.” <verse eid="LUK 5:5" /><verse number="6" style="v" sid="LUK 5:6" />Bɔ̂ŋ kʉ̂ʉ mɔ̀ʼ mbʉ kasinɛ, yá mbɔʼ yɔ́ŋyɔ́ŋ tə kasinɛ-yʉə kə́ sáanə. <verse eid="LUK 5:6" /><verse number="7" style="v" sid="LUK 5:7" />Bɔ̂ŋ tíi bətieŋkɔŋ-bʉə mu ibɛʼ-yə buukə mbɔ bɔ̂ŋ gwè kwáa bɔŋ. Bɔ̂ŋ gwè lə́ŋhə mbʉ bəbuu ibûu tə i kə́ bɛ́ muu.<verse eid="LUK 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 5:8" />Samu Bita kʉ̂ʉ nyíɛ yɔ̄ŋ-yə, bʉ́ʉnə bəshʉ Jiso ghɔ̀ŋ mbɔ, “Kə a mə kə́ŋhə mbʉə mɔ fɛ, tie-ɔ, mɔ nɔ bɛ wo-bʉ̂ʼʉ.” <verse eid="LUK 5:8" /><verse number="9" style="v" sid="LUK 5:9" />Bʉʼka mbɔ i chíe chu-i ghɔŋbə bətieŋkɔŋ-bi nə ntɛ mbɔʼ ndə bɔ̂ŋ yá. <verse eid="LUK 5:9" /><verse number="10" style="v" sid="LUK 5:10" />Bɔŋleʼ chíe chu bʉə-nuɔ-bi, Jɛŋ ghɔŋ Jɔŋ, vâa-Sabɛdi, ndə kə bɛ bətieŋkɔŋ-Samu.</para>
  <para style="p" vid="LUK 5:10">Ndʉʉmɛ, Jiso ghɔ̀ŋ tʉ Samu mbɔ, <char style="wj">“Kə a mə leʼ fàa fɛ, lʉ̀ hə nduɔ a bu kə́ yá bə bʉəməsʉʉ.”</char> <verse eid="LUK 5:10" /><verse number="11" style="v" sid="LUK 5:11" />Ndʉʉmɛ, bɔ̂ŋ dùu buubə-ʉə kóʼ nə yɔŋ ŋgwuu-kətaanə-kəghəŋ, mɛ̀ʼtə fɔbə-ʉə chɔ inchəŋ, gɛ̀ hə bɔ̌ŋ ɔŋ.<figure style="fig" alt="Jesus and Zebede's children in the boat" file="42_Mark1.16-20_CallingDisciples.tif" size="col" copy="Gordon Thomson" ref="5:11">Jiso ghɔŋbə vâa-Sabɛdi mu kəbuu</figure><verse eid="LUK 5:11" /></para>
  <para style="s">Jiso chʉ́ʼ wo-kəlɔ</para>
  <para style="r">(<ref loc="MAT 8:1-4">Matia 8:1-4</ref>; <ref loc="MRK 1:40-45">Mak 1:40-45</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12" />Ndə Jiso bɛ mu kəyəŋkwɛʼtəŋbɛʼ, wobɛʼ gwè nə lɔkə mbʉə-ɔ. Ndʉʉ ndə ɔ nyíɛ Jiso, ɔ bʉ́ʉnə bəshʉ ɔ, fʉ̀ʉtə ɔŋ kə́ ghɔ̀ŋ mbɔ, “Tiekətʉ, kaʼ a kʉ̀ʉ, bəkɔ a chìi mɔ tʉ́ʉnə.”<verse eid="LUK 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13" />Jiso dùhə ghɔkə-i kə̀ŋ wo-ghɔ̄ ghɔ̀ŋ tʉ ɔŋ mbɔ, <char style="wj">“Mɔ nɔ kʉ̀ʉ, tʉ́ʉnə!”</char> Haʼ ndʉʉmɛ, mbʉ kəlɔ fyú hə mbʉə-ɔ. <verse eid="LUK 5:13" /><verse number="14" style="v" sid="LUK 5:14" />Ndʉʉmɛ, Jiso kàhə ɔŋ mbɔ, <char style="wj">“Kə a mə shyíi wo fɛ, fəŋ gɛ̀ dʉ̀ʼ ŋwɔŋ-aŋ tʉ wofɛ̀ʼndɛŋNyii bɔŋleʼ fɛ̀ʼndɛŋ ndə Mushi kə kàhə, bʉə chʉʼ kínə mbɔ a bɛ tʉ́ʉnə.”</char><verse eid="LUK 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15" />Bɔŋ kəliʼ, bə buŋ bìʼ tíi yie-e yɔ́ŋyɔ́ŋ, bʉə buŋmbi gwè ndə məyʉ́ kwəʼ-ɛ bɔŋleʼ kie nchʉʼ kəghɔ-ɔ ndəŋ yɔʼbə-ʉə. <verse eid="LUK 5:15" /><verse number="16" style="v" sid="LUK 5:16" />Jiso bɔŋ nɔ nə kə́ fyúhə ŋwɔŋ-ɛŋ vɛʼbɛʼ gɛ̀ kəyəŋ-bəliinə ndə məgháaNyii.<verse eid="LUK 5:16" /></para>
  <para style="s">Jiso chʉ́ʼ wo ndə ɔ kwú kəviakəmɔʼ</para>
  <para style="r">(<ref loc="MAT 9:1-8">Matia 9:1-8</ref>; <ref loc="MRK 2:1-12">Mak 2:1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17" />Yɔŋbɛʼ ndə Jiso kə́ dàhə, bʉə-Falasi ghɔŋ bʉə dàhə nuʼ-Mushi ndə bɔ̂ŋ gwè hə mu lɔʼ-bətə̂ŋ-tə inchəŋ mu Galili ghɔŋbə Judia leʼnə Jɛlosalɛŋ, kə́ dùʼtə chɔ. Ghʉəʼ-Tiekətʉ-kə kə́ bɛ mbʉə-ɔ ndə məchʉ́ʼ bʉə-bəyɔʼ.<verse eid="LUK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 5:18" />Kə nyíɛ, bʉəbɛʼbə kə́ gwè bɛ̀ʼ wo ndə ɔ nɔʼ kwú kəviakəmɔʼ ndəŋ mbyuukə, kɔ̀ɔtə ndə məsʉ́ʉ, mɔ̀ʼ ɔŋ bəshʉ Jiso. <verse eid="LUK 5:18" /><verse number="19" style="v" sid="LUK 5:19" />Bɔ̂ŋ kʉ̂ʉ kɔ̀ɔtə ndə məsʉ́ʉ kəŋkaa, bʉʼka bʉə buŋmbi, bɔ̂ŋ kóʼ kətʉ njaa<note caller="+" style="f"><char style="fr" closed="false">5:19 </char><char style="ft" closed="false">Bʉə-Juu nɔ nə kə́ bɔŋ njaahə-ʉə nɔ bɔ̂ŋ mɔ̀ʼ ghɔ̂ʼ chɔ, lyʉ́ʉ tʉkə-i nə chiabə təmə kwɛ̀ŋkwɛ̀ŋ fɛ. Chìi yuhəbə mbi ndə məkóʼ gɛ̀ kətʉ ghɔ.</char></note>, shùʼ mbyuu chɔ, shúʼhə ɔŋ ndəŋ mbyuukə-i, mɔ̀ʼ bəshʉ Jiso ntəŋntəŋ bʉə. <verse eid="LUK 5:19" /><verse number="20" style="v" sid="LUK 5:20" />Jiso kʉ̂ʉ nyíɛ ntɛ ndə bɔ̂ŋ mɔ̀ʼfyiihə-ʉə ndəŋ ɔŋ, ɔ ghɔ̀ŋ mbɔ, <char style="wj">“Tieŋkɔŋ-ɔŋ, bə nɔʼ sʉ̀fyii hə ndəŋ bʉ̂ʼʉ-a.”</char><verse eid="LUK 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21" />Bʉə-Falasi ghɔŋbə bʉə dàhə nuʼ-Mushi chʉ́ʉhə kə́ kwɔ̀ʼtə tʉbə-ʉə mbɔ, “Wo-ɔ̄ bɛ nda kə́ kwə́ʼ chʉ̀əʼhə Nyii? Bɛ nda ndə bəkɔ ɔ sʉ̀fyii-i hə ndəŋ bʉ̂ʼʉ-wo, yaʼkɛŋ Nyii tətɛʼ ɔ?”<verse eid="LUK 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22" />Jiso kə́ kínə nukə ndə bɔ̂ŋ kə́ kwɔ̀ʼtə, bíʼtə tʉ bɔŋ mbɔ, <char style="wj">“Chìi ka bii kə́ bíʼtə nubə-ɔ̄ŋ mu fyii-bii?</char> <verse eid="LUK 5:22" /><verse number="23" style="v" sid="LUK 5:23" /><char style="wj">Yùhə yɔ̂ŋ-yə, ndə məghɔ̀ŋ mbɔ, ‘Bə nɔʼ sʉ̀fyii hə ndəŋ bʉ̂ʼʉ-a’ mɛ, kə məghɔ̀ŋ mbɔ, ‘Lɔ̀ hə sê tòʼ ’?</char> <verse eid="LUK 5:23" /><verse number="24" style="v" sid="LUK 5:24" /><char style="wj">Bɔŋ mɔ bu chìi bii kínə mbɔ mbʉ Vaa-Woməsʉʉ nɔ kie ghʉəʼkə kəchisê ndə məsʉ̀fyii-i hə ndəŋ bʉ̂ʼʉ.”</char> Ndʉʉmɛ, ɔ ghɔ̀ŋ tʉ wo-ghɔ̄ ndə ɔ nɔʼ kə kwú kəviakəmɔʼ le mbɔ, <char style="wj">“Mɔ nɔ tʉʼ ghɔ̀ŋ tʉ a mbɔ, lɔ̀ hə sê, lʉ̀ mbyuukə-a, gɛ̀ chunjaa.”</char><verse eid="LUK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 5:25" />Haʼ ndʉʉmɛ, ɔ lɔ̀ hə sê bəshʉ bɔŋ, lʉ̀ fɔbə ndə ɔ nʉ̀ʉ ndəŋ ghɔ, kə́ tòʼ lə̀ʼtə Nyii gɛ̀ chunjaa. <verse eid="LUK 5:25" /><verse number="26" style="v" sid="LUK 5:26" />I chàa bɔŋ bənchəŋ, faa-kwu-kə yá bɔŋ, bɔ̂ŋ kə́ lə̀ʼtə Nyii, ghɔ̀ŋ mbɔ, “Baʼa nyíɛ nufinəbə laa.”<verse eid="LUK 5:26" /></para>
  <para style="s">Jiso tíi Lɛvi</para>
  <para style="r">(<ref loc="MAT 9:9-13">Matia 9:9-13</ref>; <ref loc="MRK 2:13-17">Mak 2:13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27" />Yɔ̄ŋ-yə kʉ̂ʉ tíŋ, Jiso fyú mbi nyíɛ wo fí tashibɛʼ yie-e kə́ bɛ Lɛvi, ɔ kə́ dùʼ mu vaa-njaa fí tashi. Jiso ghɔ̀ŋ tʉ ɔŋ mbɔ, <char style="wj">“Gwè hə bɔ̌ŋ mɔ.”</char> <verse eid="LUK 5:27" /><verse number="28" style="v" sid="LUK 5:28" />Lɛvi lɔ̀ hə sê, mɛ̀ʼtə fɔbə inchəŋ, gɛ̀ hə bɔ̌ŋ ɔŋ.<verse eid="LUK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29" />Ndʉʉmɛ, Lɛvi shʉ̀tə nchəŋtəkwɛʼtəŋ mu njaa-ɔ bʉʼka Jiso. Buŋmbi bʉə fí tashi gwètə chɔ ghɔŋbə bəbɛʼbʉə kə́ yú. <verse eid="LUK 5:29" /><verse number="30" style="v" sid="LUK 5:30" />Bʉə-Falasi ghɔŋbə bʉə dàhə nuʼ-Mushi ndə bɛ bʉə nuɔ-bʉə kə́ luŋtə gìe tʉ vâafɔʼɔ-Jiso mbɔ, “Chìi ka bii kə́ yú fɔbə bɔŋleʼ nú ndʉʼmə biibə bʉə fí tashi ghɔŋbə bʉə-bʉ̂ʼʉ?”<verse eid="LUK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31" />Jiso bə̀ŋhə mbɔ, <char style="wj">“Kaa w̃o shʉ́əshʉ́ə ndə ɔ gɛ̀ tʉ dota fɛ, nɔ gɛ̀ wokəyɔʼ.</char> <verse eid="LUK 5:31" /><verse number="32" style="v" sid="LUK 5:32" /><char style="wj">Mɔ gwè ndə mətíi bʉə ndə bɔ̂ŋ kwɔ̀ʼtə mbɔ bɔ̂ŋ bɛ ndyʉndyʉ fɛ, mɔ nɔ gwè tʉ bʉə-bʉ̂ʼʉ mbɔ bɔ̂ŋ chʉʼ shìe liɛŋtə-ʉə ndəŋ bʉ̂ʼtə-ʉə.”</char><verse eid="LUK 5:32" /></para>
  <para style="s">Bə bíʼtə nubə tʉ Jiso te muujimə</para>
  <para style="r">(<ref loc="MAT 9:14-17">Matia 9:14-17</ref>; <ref loc="MRK 2:18-22">Mak 2:18-22</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33" />Bɔ̂ŋ gìe tʉ Jiso mbɔ, “Vâafɔʼɔ-Jɔŋ nɔ kə́ chʉʼ jì muu bɔŋleʼ gháaNyii, vâafɔʼɔ-bʉə-Falasi kə́ chìi haʼ nɔ. Bɔŋ babə gòʼ nə məyú ghɔŋ mənú muu.”<verse eid="LUK 5:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34" />Jiso bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“Bəkɔ a chìi bʉə-ŋkɔʼnə woləŋ ndə ɔ tʉʼ chìi lɔŋ, jì muu ghɔŋ bɔŋ kə́ bɛ mɔʼɔ mɛ?</char> <verse eid="LUK 5:34" /><verse number="35" style="v" sid="LUK 5:35" /><char style="wj">Bɔŋ chîbə tʉʼ gwè ndə bə bu lʉ̀ mbʉ woləŋ ndə ɔ tʉʼ chìi lɔŋ kəghɔ-bɔŋ, ndʉʉmɛ bɔ̂ŋ bu kə́ jì muu.”</char><verse eid="LUK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36" />Jiso mɔ̀ʼ chəŋkə-ɔ̄ŋ tʉ bɔŋ, <char style="wj">“Wo mə jɔ̀ʼ via-ndyi-fefe-kə gɛ̀ tɛ́nɛ ndyi kənduɔŋ nə yɔŋ fɛ. Kaʼ ɔ chìi nɔ, təmə ɔ nɔʼ jɔ̀ʼ ndyi-fefe-e təmə mbʉ kəvia ndyi fefe mətòʼ ghɔŋbə ndyi kənduɔŋ fɛ.</char> <verse eid="LUK 5:36" /><verse number="37" style="v" sid="LUK 5:37" /><char style="wj">Təmə wo bɔŋ-mə-leʼ lʉ̀ ndʉʼ-sʉ́ʼnə-mə gɛ̀ véʼ mu nduɔŋ-kəbɔʼ-kə ndə bə chìi nə gwo-nyaa fɛ. Kaʼ ɔ chìi nɔ, mbʉ məndʉʼ fyùʼ, mbʉ gwo sáanə, mbʉ məndʉʼ tyùnə sê, mbʉ kəbɔʼ byʉ́ʼ.</char> <verse eid="LUK 5:37" /><verse number="38" style="v" sid="LUK 5:38" /><char style="wj">Mbee, bə nɔ kie ndə məvéʼ ndʉʼ-sʉ́ʼnə-mə mu bɔʼ-fefe-kə.</char> <verse eid="LUK 5:38" /><verse number="39" style="v" sid="LUK 5:39" /><char style="wj">Wo bɔŋleʼ kaa ghɔ ndə bəkɔ ɔ nú ndʉʼ-tə̀ŋ-mə, bʉ̀nə kə́ bíʼtə ndʉʼ-sʉ́ʼnə-mə fɛ, bʉʼka ɔ bu ghɔ̀ŋ mbɔ nɔ bʉ̀ʉ yi-yə ndə i tə̀ŋ.”</char><verse eid="LUK 5:39" /></para>
  <chapter eid="LUK 5" />
  <chapter number="6" style="c" sid="LUK 6" />
  <para style="s">Tiekətʉ-Chîlɔʼkə</para>
  <para style="r">(<ref loc="MAT 12:1-8">Matia 12:1-8</ref>; <ref loc="MRK 2:23-28">Mak 2:23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1" />Chîlɔʼbɛʼkə, Jiso kə́ tíŋ ghɔŋbə vâafɔʼɔ-bi hə mutɔ-məntɔŋ, vâafɔʼɔ-bi chʉ́ʉhə kə́ shyìi ntɔŋmə kə́ fyʉ́ʼhə kəghɔ-bɔŋ, kwó mbʉ məntɔŋ. <verse eid="LUK 6:1" /><verse number="2" style="v" sid="LUK 6:2" />Bʉə-Falasi bíʼtə tʉ ɔŋ mbɔ, “Chìi ka bii kə́ bə́ʼ nuʼ ndəŋ Chîlɔʼkə?”<verse eid="LUK 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3" />Jiso bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“Bii chʉʼ nə tíi nukə ndə Dɛbi nə chìi vɛʼ ndə jyʉʉ nə yɔ́ʼ ɔ ghɔŋbə bʉə-bi fe?</char> <verse eid="LUK 6:3" /><verse number="4" style="v" sid="LUK 6:4" /><char style="wj">Ɔ nɔ kə sʉ́ʉ mu lɛʼ-Nyii-kə lʉ̀ bəbele ndə bə nɔʼ kɔ́ tʉ Nyii, kwó, ndə i kə kʉ̀ʼnə tʉ ɔŋ ndə məkwó fɛ, yaʼkɛŋ bʉəfɛ̀ʼndɛŋNyii tətɛʼ bɔŋ, bɔŋleʼ kɔ́ ibɛʼ-yə tʉ bʉə ndə ghɔŋ bɔŋ kə bɛ mɔʼɔ.”</char> <verse eid="LUK 6:4" /><verse number="5" style="v" sid="LUK 6:5" />Jiso ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Vaa-Woməsʉʉ nɔ bɛ Tiekətʉ-Chîlɔʼkə.”</char><verse eid="LUK 6:5" /></para>
  <para style="s">Jiso chʉ́ʼ wokəyɔʼ ndəŋ Chîlɔʼkə</para>
  <para style="r">(<ref loc="MAT 12:9-14">Matia 12:9-14</ref>; <ref loc="MRK 3:1-6">Mak 3:1-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6" />Kʉ̂ʉ bìʼ bɛ ibɛʼ-yə Chîlɔʼkə, ɔ gɛ̀ ŋíi mu njaagháaNyii kə́ dàhə, wobɛʼ kə́ bɛ chɔ ndə kwiimɔʼnə-i nɔʼ lɛ́ŋ. <verse eid="LUK 6:6" /><verse number="7" style="v" sid="LUK 6:7" />Bʉə dàhə nuʼ-Mushi ghɔŋbə bʉə-Falasi tʉ́ʼ shʉtə-ʉə, kə́ kíi ɔ mbɔ ɔ bu chʉ́ʼ wo-ghɔ̄ ndəŋ Chîlɔʼkə mɛɛ, bɔ̂ŋ chʉʼ mɔ̀ʼ nukə kətʉ-ɔ. <verse eid="LUK 6:7" /><verse number="8" style="v" sid="LUK 6:8" />Jiso kínə nukə ndə bɔ̂ŋ tʉʼ kwɔ̀ʼtə kətʉ-bɔŋ, ghɔ̀ŋ tʉ mbʉ wo-ghɔ̄ ndə kwii-i nɔʼ kwú le mbɔ, <char style="wj">“Lɔ̀ hə sê tə́nə bəshʉ bʉə bənchəŋ.”</char> Ndʉʉmɛ, ɔ lɔ̀ hə sê tə́nə bəshʉ bʉə. <verse eid="LUK 6:8" /><verse number="9" style="v" sid="LUK 6:9" />Jiso ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“M̈ɔ bíʼtə tʉ bii, bɛ yɔ̄ŋ-yə nukə, ndə nuʼ mɛ̀ʼtə mbɔ b̈ə fɔ̀ʼ ndəŋ Chîlɔʼkə, ndə məfɔ̀ʼ bʉ̀ʉ mɛ, kə məfɔ̀ʼ bʉ̂ʼʉ? Ndə məkwáa tʉ-wo-kə mɛ, kə məyí ɔ?”</char> <verse eid="LUK 6:9" /><verse number="10" style="v" sid="LUK 6:10" />Jiso lɛ́nə bɔŋ bənchəŋ, gìe tʉ wo-ghɔ̄ mbɔ, <char style="wj">“Shyìi kwii-a.”</char> Ɔ chìi haʼ le, mbʉ kwii bʉ̀nə bɛ jyujyu. <verse eid="LUK 6:10" /><verse number="11" style="v" sid="LUK 6:11" />I byʉ́ʼ bɔŋ bənchəŋ, bɔ̂ŋ chʉ́ʉhə kə́ chúʼtə tʉbə-ʉə ndə mənyíɛ nukə ndə bɔ̂ŋ bu chìi nə Jiso.<verse eid="LUK 6:11" /></para>
  <para style="s">Bəlɔntəŋ-Jiso njuɔ bûu nə wuŋ</para>
  <para style="r">(<ref loc="MAT 10:1-4">Matia 10:1-4</ref>; <ref loc="MRK 3:13-19">Mak 3:13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12" />Mu chîbə-ɔ̄ŋ, Jiso kóʼ gɛ̀ ndəŋ kwɔŋ ndə məgháaNyii lʉ̀ hə ndʉʉbuumbi tə mbi fíi. <verse eid="LUK 6:12" /><verse number="13" style="v" sid="LUK 6:13" />Kʉ̂ʉ bɛ ndʉʉsɛŋkə, ɔ tíi vâafɔʼɔ-bi, bɔ̂ŋ gwè mbʉə ɔ, ɔ séʼ bɔŋ njuɔ bûu nə wuŋ, tíi bɔŋ nə bəlɔntəŋNyii. <verse eid="LUK 6:13" /><verse number="14" style="v" sid="LUK 6:14" />Bɔ̂ŋ nɔ kə bɛ Samu, ɔ tyú yie nə Bita, liŋ-iŋ Andolo, Jɛŋ, Jɔŋ, Fili, Batolomiɛ, <verse eid="LUK 6:14" /><verse number="15" style="v" sid="LUK 6:15" />Matia, Tɔmɔ, Jɛŋ vaa-Afio, Samu ndə bə kə́ tíi ɔ nə tiɛŋ-lɔʼɔ, <verse eid="LUK 6:15" /><verse number="16" style="v" sid="LUK 6:16" />Juda vaa-Jɛŋ, leʼnə Juda Iskalo ndə ɔ kə fɛ̀ŋ Jiso.<verse eid="LUK 6:16" /></para>
  <para style="s">Jiso dàhə bɔŋleʼ chʉ́ʼ bʉə</para>
  <para style="r">(<ref loc="MAT 4:23-25">Matia 4:23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17" />Ɔ shíʼ gɛ̀ ghɔŋ bɔŋ gɛ̀ tə́nə sê kəlʉʉnə. Buŋmbi vâafɔʼɔ-bi kə́ bɛ chɔ ghɔŋbə bʉə buŋmbi ndə bɔ̂ŋ lɔ̀ hə mu Judia inchəŋ ghɔŋbə Jɛlosalɛŋ, bɔŋleʼ lɔ̀ hə mu Taa ghɔŋbə Sidɔŋ ndə i kə bɛ mbʉə muukwɛʼtəŋmə. <verse eid="LUK 6:17" /><verse number="18" style="v" sid="LUK 6:18" />Bɔ̂ŋ nɔ kə́ gɛ̀ ndə məyʉ́ ɔ, bə bɔŋleʼ chʉ́ʼ yɔʼbə-ʉə ndə bɔ̂ŋ kə gɛ̀, bʉə ndə lyʉʉhəbʉəbʉəbə kə́ chɔ́ŋhə bɔŋ nɔ kə kie nchʉʼ. <verse eid="LUK 6:18" /><verse number="19" style="v" sid="LUK 6:19" />Bʉə bənchəŋ kə́ kʉ́ʉ ndə məkə̀ŋ mbʉ Jiso bʉʼka ghʉəʼ-nchʉʼ-kə nɔ nə kə́ fyú hə kəghɔ-ɔ ndə məchʉ́ʼ bɔŋ bənchəŋ.<verse eid="LUK 6:19" /></para>
  <para style="s">Tʉʉjyu</para>
  <para style="r">(<ref loc="MAT 5:1-12">Matia 5:1-12</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20" />Ɔ chɔ̀ʼhə shʉ-i lɛ́nə vâafɔʼɔ-bi, ghɔ̀ŋ mbɔ,</para>
  <para style="q1" vid="LUK 6:20">
    <char style="wj">“Tʉʉjyu nɔ bɛ tʉ bii bʉə-kəbyuu,</char></para>
  <para style="q2" vid="LUK 6:20">
    <char style="wj">bʉʼka Sɔ́ʼ-Nyii nɔ bɛ yii-yə.</char><verse eid="LUK 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21" />
    <char style="wj">Tʉʉjyu nɔ bɛ tʉ bii ndə jyʉʉ tʉʼ yɔ́ʼ bii nduɔ</char></para>
  <para style="q2" vid="LUK 6:21">
    <char style="wj">bʉʼka bii bu yi yuo.</char></para>
  <para style="q2" vid="LUK 6:21">
    <char style="wj">Tʉʉjyu nɔ bɛ tʉ bii ndə bii tʉʼ gwía nduɔ, bʉʼka bii bu chʉ́əʼ.</char><verse eid="LUK 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LUK 6:22" />
    <char style="wj">Tʉʉjyu nɔ bɛ tʉ bii ndə bʉə-bàa-bii, fyúhə bii hə nuɔ-bɔŋ,</char></para>
  <para style="q2" vid="LUK 6:22">
    <char style="wj">bɔŋleʼ kə́ chɛ̀ŋtə bii, kə́ tíi yie-yii bʉəbʉə bʉʼka Vaa-Woməsʉʉ.</char><verse eid="LUK 6:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="LUK 6:23" />
    <char style="wj">T̈ʉʉ-yii kə́ sʉ́ʼnə yɔ̂ŋ-ghɔ̄ b̈ii bɔŋleʼ sɛ́ʼtə nə tʉʉjyu, bʉʼka kɛŋbə-ii bu yɔ́ŋ yuo. Nɔ bɛ haʼ nɔ ndə bətietie-bʉə nə kə́ fɔ̀ʼ tʉ bʉəyʉkəŋgieNyii.</char><verse eid="LUK 6:23" /></para>
  <para style="s">Məvínə</para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24" />
    <char style="wj">Bɔŋ tə ŋgʉəʼ bɛ kətʉ-bii bʉə-kəfʉʼ</char></para>
  <para style="q2" vid="LUK 6:24">
    <char style="wj">bʉʼka bii nɔʼ dùʼ jyujyu.</char><verse eid="LUK 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25" />
    <char style="wj">Tə ŋgʉəʼ bɛ kətʉ-bii, bii ndə bii tʉʼ</char></para>
  <para style="q2" vid="LUK 6:25">
    <char style="wj">yú yuo bʉʼka jyʉʉ bu yɔ́ʼ bii.</char></para>
  <para style="q1" vid="LUK 6:25">
    <char style="wj">Tə ŋgʉəʼ bɛ kətʉ-bii ndə bii tʉʼ chʉ́əʼ nduɔ,</char></para>
  <para style="q2" vid="LUK 6:25">
    <char style="wj">bii bu lí bɔŋ gwía.</char><verse eid="LUK 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="LUK 6:26" />
    <char style="wj">Tə ŋgʉəʼ bɛ kətʉ-bii ndə bʉə bənchəŋ tʉʼ tíi yie-yii jyujyu,</char></para>
  <para style="q2" vid="LUK 6:26">
    <char style="wj">bʉʼka mbɔ nɔ kə bɛ ndə bətie-bʉə nə kə́ fɔ̀ʼ tʉ bʉə ndə bɔ̂ŋ ghɔ̀ŋ mbɔ bɔ̂ŋ la tʉʼ yʉ́ ŋgieNyiikə.</char><verse eid="LUK 6:26" /></para>
  <para style="s">Kʉ̀ʉ bʉə-bàa-ba</para>
  <para style="r">(<ref loc="MAT 5:38-48">Matia 5:38-48</ref>; <ref loc="MAT 7:12">7:12</ref>a)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27" />
    <char style="wj">“M̈ɔ bɔŋ shyíi bii, bii ndə bii tʉʼ yʉ́ mɔ, b̈ii kʉ̀ʉ bʉə-bàa-bii, fɔ̀ʼ bʉ̀ʉ tʉ bʉə ndə bɔ̂ŋ bàa bii.</char> <verse eid="LUK 6:27" /><verse number="28" style="v" sid="LUK 6:28" /><char style="wj">B̈II gháa bʉ̀ʉ kɔ́ tʉ bʉə ndə bɔ̂ŋ tʉʼ túu ndɔŋ kɔ́ kətʉ-bii. B̈ii gháaNyii tʉ bʉə ndə bɔ̂ŋ tʉʼ chɔ́ŋhə bii.</char> <verse eid="LUK 6:28" /><verse number="29" style="v" sid="LUK 6:29" /><char style="wj">Kaʼ wo chʉ̀əʼhə a, gwúu ghɔkə chu-a, ä jʉhə. Kaʼ wo fí ndyi-fəʼə-a, ä shùɔ ndyi mu mbʉə-a, bìa chɔ.</char> <verse eid="LUK 6:29" /><verse number="30" style="v" sid="LUK 6:30" /><char style="wj">Kaʼ wo gháa fɔkə kəghɔ-a, ä kɔ́ tʉ ɔŋ. Kaʼ wo lʉ̀ fɔkə-a, kə a məfì nə ghʉəʼkə fɛ.</char> <verse eid="LUK 6:30" /><verse number="31" style="v" sid="LUK 6:31" /><char style="wj">Nukə ndə bii kʉ̀ʉ mbɔ bʉə-fɔʼɔ tʉ bii, b̈ii fɔ̀ʼ tʉ bɔŋ ghɔ.</char><verse eid="LUK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32" />
    <char style="wj">“Kaʼ bii kʉ̀ʉ haʼ bʉə ndə bɔ̂ŋ kʉ̀ʉ bii, kɛŋbə-ii bɛ ka? Bʉə bʉ̂ʼʉ ghɔ nɔ kʉ̀ʉ bʉə ndə bɔ̂ŋ kʉ̀ʉ bɔŋ.</char> <verse eid="LUK 6:32" /><verse number="33" style="v" sid="LUK 6:33" /><char style="wj">Kaʼ bii bɔŋ-kə́-leʼ chìi bʉ̀ʉ haʼ tʉ bʉə ndə bɔ̂ŋ tʉʼ chìi bʉ̀ʉ tʉ bii, kɛŋbə-ii bɛ ka chɔ? Bʉə bʉ̂ʼʉ nɔ chìi haʼ nɔ ghɔ.</char> <verse eid="LUK 6:33" /><verse number="34" style="v" sid="LUK 6:34" /><char style="wj">Kaʼ a kə́ chɔ́ʼhə haʼ tʉ bʉə ndə a kwɔ̀ʼtə mbɔ bɔ̂ŋ bu bʉ̀nə lɔ̀ʼ tʉ a, kɛŋbə-a bɛ ka chɔ? Bʉʼka mbɔ b̃ʉə bʉ̂ʼʉ nɔ chɔ́ʼhə haʼ nɔ tʉ bʉə-bʉ̂ʼʉ kə́ kínə mbɔ bɔ̂ŋ bu lɔ̀ʼ bɔŋ ŋkwɔŋ.</char><verse eid="LUK 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 6:35" />
    <char style="wj">“Bɔŋ b̈ii kʉ̀ʉ bʉə-bàa-bii, fɔ̀ʼ bʉ̀ʉ tʉ bɔŋ, chɔ́ʼhə tʉ bɔŋ təmə kə́ kʉ̀ʼ məbyʉ̀hə fɛ. Ndʉʉghɔfii, kɛŋbə-ii bu yɔ́ŋ, bii bu bɛ vâa-Chaabəfɔŋ bʉʼka ɔ nɔ tʉʼ fɔ̀ʼ bʉ̀ʉ tʉ bʉə ndə bɔ̂ŋ kyinə kɔ́ ndɔ fɛ ghɔŋbə bʉə buuŋbʉə.</char> <verse eid="LUK 6:35" /><verse number="36" style="v" sid="LUK 6:36" /><char style="wj">Dʉ̀ʼ tʉvyiikə haʼ ndə Tie-a tʉʼ dʉ̀ʼ.</char><verse eid="LUK 6:36" /></para>
  <para style="s">Məchʉ̀ə ŋkwɛ</para>
  <para style="r">(<ref loc="MAT 7:1-5">Matia 7:1-5</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37" />
    <char style="wj">“Kə bii mə chʉ̀ə ŋkwɛ yie bʉə-bʉəbʉə fɛ, Nyii kʉʉ chʉ̀ə yi-yə bʉəbʉə fɛ. Kə bii mə dʉ̀ʼ ghɔkə-i chu bəbɛʼbʉə fɛ, bɔŋ Nyii kʉʉ dʉ̀ʼ yi-yə ghɔkə chu-bii fɛ. B̈ii sʉ̀fyiihə-ii te nə ibɛʼ-yə wo, Nyii bu sʉ̀fyii-i te nə bii.</char> <verse eid="LUK 6:37" /><verse number="38" style="v" sid="LUK 6:38" /><char style="wj">B̈ii kɔ́, bə bu kɔ́ tʉ bii, yʉʼ fʉʼ jyujyu ndə bə nɔʼ jìehə bɔŋleʼ yʉ́ʼnə tə i kə́ tyunə, bə bu vɛʼ bəbe-bii. Bʉʼka fʉʼ ndə bii kɔ́ nɔ bɛ haʼ yɔŋ ndə bə bu kɔ́ tʉ bii.”</char><verse eid="LUK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39" />Ɔ leʼ mɔ̀ʼ chəŋkə-ɔ̄ŋ tʉ bɔŋ mbɔ, <char style="wj">“Bəkɔ fʉ̀əŋtəshʉ dʉ̀ʼ fia tʉ ibɛʼ-yə fʉ̀əŋtəshʉ mɛ? Bɔ̂ŋ bənchəŋ bu gwù mu byʉʉ fe?</char> <verse eid="LUK 6:39" /><verse number="40" style="v" sid="LUK 6:40" /><char style="wj">Vaa-sɛku mə láa chàa chicha-ɛ fɛ. Bɔŋ wotəmiyɔŋ ndə bə nɔʼ dàhə ɔŋ jyujyu bəkɔ ɔ bɛ ndə chicha-ɛ.</char><verse eid="LUK 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41" />
    <char style="wj">“Chìi ka a kə́ tʉ́ʼ shʉ-a ndəŋ vaadyʉʼʉ-kəfɔ ndə i bɛ shʉ-liŋ-aŋ bɔŋ təmə kə́ lɛ́nə mbyʉʉ-kəŋkɔʼ ndə i bɛ ndəŋ ya-yə shʉ fɛ?</char> <verse eid="LUK 6:41" /><verse number="42" style="v" sid="LUK 6:42" /><char style="wj">Bəkɔ a gìe tʉ liŋ-aŋ təka mbɔ, ‘Liŋ, n̈ɔʼ mɔ fyúhə vaa-kəfɔ hə shʉ-a,’ bɔŋ kə́ lèʼnə mbyʉʉ-kəŋkɔʼ ndə i bɛ shʉ ya-mbəŋ? Mbəŋ-aŋ wo làhə shʉ, fəŋ fyúhə mbyʉʉ-kəŋkɔʼ ndəŋ ya-yə shʉ, ndʉʉmɛ, a bu nyíɛ yəŋkə jyujyu ndə məfyúhə vaa-kəfɔ shʉ-liŋ-aŋ.</char><verse eid="LUK 6:42" /></para>
  <para style="s">Tyʉkə ghɔŋ ntɔŋmə-i</para>
  <para style="r">(<ref loc="MAT 7:16-20">Matia 7:16-20</ref>; <ref loc="MAT 12:33-35">12:33-35</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43" />
    <char style="wj">“Tyʉ-jyujyu-kə mə kʉ́ʉnə ntɔŋ-bʉəbʉə-mə fɛ haʼ ndə tyʉ-bʉəbʉə-kə mə kʉ́ʉnə ntɔŋ-jyujyu-mə fɛ.</char> <verse eid="LUK 6:43" /><verse number="44" style="v" sid="LUK 6:44" /><char style="wj">B̃ə nɔ chèʼnə tyʉkə ndə ntɔŋmə-i. A mə kwɛ̀ yɔ̌ŋ hə ndəŋ ŋkwenjʉ fɛ. Təmə bə mə kwɛ̀ lamashi hə ndəŋ sɔ̂ʼkə fɛ.</char> <verse eid="LUK 6:44" /><verse number="45" style="v" sid="LUK 6:45" /><char style="wj">W̃o jyujyu nɔ fyúhə nu-jyujyu-bə hə mu kəyəŋ lə̀ŋ bənu jyujyu mu fyii-ɔ, bɔŋ w̃o bʉəbʉə nɔ fyúhə nu-bʉəbʉə-bə hə mu kəyəŋ lə̀ŋ bənu bʉəbʉə mu fyii-ɔ, bʉʼka nubə ndə i lə̀ŋ mu fyii-ɔ nɔ bɛ yɔ́ŋ ndə ɔ bu kwə́ʼ.</char><verse eid="LUK 6:45" /></para>
  <para style="s">Bʉə bɔ́ŋ njaa nə bənɔ̌ʼɔ ghɔŋbə bʉə ndə bɔ̂ŋ tʉʼ bɔ́ŋ nə ndaa</para>
  <para style="r">(<ref loc="MAT 7:24-27">Matia 7:24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46" />
    <char style="wj">“Tʉʼ chìi ka bii kə́ tíi mɔ mbɔ, ‘Tiekətʉ, Tiekətʉ,’ təmə kə́ fɔ̀ʼ nubə ndə mɔ ghɔ̀ŋ mbɔ b̈ii kə́ fɔ̀ʼ fɛ?</char> <verse eid="LUK 6:46" /><verse number="47" style="v" sid="LUK 6:47" /><char style="wj">Mɔ bu dʉ̀ʼ tʉ bii ntɛhə ndə i bɛ te wotəmiyɔŋ ndə ɔ gwè tʉ mɔ, yʉ́ ŋgiekə-ɔŋ, mɔ̀ʼ mu məchimbi-ɔ.</char> <verse eid="LUK 6:47" /><verse number="48" style="v" sid="LUK 6:48" /><char style="wj">Ɔ nɔ bɛ nə wo ndə ɔ tʉʼ bɔ́ŋ njaa, nɔʼ tyúu yiesê-e i dɔ̀ŋnə gɛ̀ tə dàa ndəŋ ŋgoʼ mu sê. Ndʉʉ ndə ŋkenənduhə gwè, muu kwɔ̀ŋ mbʉ njaa, təmə i bɔŋ mə ŋɛ̀hə fɛ, bʉʼka bə nɔ bɔ́ŋ jyujyu.</char> <verse eid="LUK 6:48" /><verse number="49" style="v" sid="LUK 6:49" /><char style="wj">Bɔŋ wo ndə ɔ̈ yʉ́ ŋgiekə-ɔŋ təmə mɔ̀ʼ mu məchimbi-ɔ fɛ, ɔ nɔ bɛ nə wo ndə ɔ bɔ́ŋ njaa təmə yiesê-e jyujyu fɛ. Ndʉʉ ndə muu kwɔ̀ŋ mbʉ njaa, i gwù sê ŋìʼtə.”</char><verse eid="LUK 6:49" /></para>
  <chapter eid="LUK 6" />
  <chapter number="7" style="c" sid="LUK 7" />
  <para style="s">Ntɛ ndə wokwɛʼtəŋ-bəsɔge-ghyʉʉ mɔ̀ʼfyii-i tʉ Nyii</para>
  <para style="r">(<ref loc="MAT 8:5-13">Matia 8:5-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1" />Ndʉʉ ndə Jiso nɔʼ kə mìʼtə ndə məgìe nubə-ɔ̄ŋ inchəŋ tʉ bʉə-ghɔ̄bə, ɔ ŋíi mu Kabanu. <verse eid="LUK 7:1" /><verse number="2" style="v" sid="LUK 7:2" />Vaafɔ̀ʼ-wokwɛʼtəŋ-bəsɔge-ghyʉʉ mu Luŋ ndə tiefɔʼ-ɛ kə kʉ̀ʉ ɔ daa, kə́ yɔ́ʼyɔ́ʼ tə nɔʼ bɛ ndə məkwú. <verse eid="LUK 7:2" /><verse number="3" style="v" sid="LUK 7:3" />Mbʉ wokwɛʼtəŋ-bəsɔge kʉ̂ʉ yʉ́ nubə te Jiso, tə́ŋ bəntəŋbəshʉ-bʉə-Juu tʉ ɔŋ mbɔ ɔ̈ la gwè chʉ́ʼ vaafɔ̀ʼ-ɛ. <verse eid="LUK 7:3" /><verse number="4" style="v" sid="LUK 7:4" />Ndʉʉ ndə bɔ̂ŋ gwè tʉ Jiso, bɔ̂ŋ fʉ̀ʉtə ɔŋ tə nʉ̀ʉ sê, ghɔ̀ŋ mbɔ, “Wo-ɔ̄ nɔ kʉ̀ʼnə ndə məkie ŋkwaa kəghɔ-a, <verse eid="LUK 7:4" /><verse number="5" style="v" sid="LUK 7:5" />bʉʼka mbɔ, ɔ nɔ kʉ̀ʉ lɔʼɔ-yʉʼʉ bɔŋ-nɔʼ-leʼ bɔ́ŋ njaaghaaNyii-yʉʼʉ.”<verse eid="LUK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 7:6" />Jiso gɛ̀ ghɔŋ bɔŋ tə kə́ dàa mbʉə mbʉ njaa, mbʉ wokwɛʼtəŋ-bəsɔge tə́ŋ bətiekənu-bi ndə məgìe tʉ ɔŋ mbɔ, “Tiekətʉ-ɔ, kə a mə chɔ́ŋhə ŋwɔŋ-aŋ fɛ, bʉʼka mɔ kʉ̀ʼnə wo ndə bəkɔ a gwè mu njaa-mɔ fɛ. <verse eid="LUK 7:6" /><verse number="7" style="v" sid="LUK 7:7" />Nɔ bɛ yɔŋ nɔ, ndə mɔ nyíɛ ŋwɔŋ-ɔŋ mbɔ mɔ kʉ̀ʼnə wo mɔ gwè tʉ a fɛ. Bɔŋ gìe mbʉ mbyu kəŋgie, vaafɔ̀ʼ-ɔ bu kie nchʉʼ. <verse eid="LUK 7:7" /><verse number="8" style="v" sid="LUK 7:8" />Bʉʼka mbəŋ-ɔŋ ghɔ nɔ bɛ tɔʼɔ wokwɛʼtəŋ-ɔŋ, bɔŋ leʼnə bəsɔge tɔʼɔ mɔ. M̃ɔ nɔ gìe tʉ mbyu sɔge təmiyɔŋ mbɔ, ‘Gɛ̀,’ nɔ ɔ gɛ̀, tʉ ibɛʼ-yə mbɔ, ‘Gwè,’ nɔ ɔ gwè. Mɔ gìe tʉ vaafɔ̀ʼ-ɔ mbɔ, ‘Chìi mənɔ,’ ɔ chìi haʼ nɔ.”<verse eid="LUK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9" />Ndʉʉ ndə Jiso yʉ́ yɔ̄ŋ-yə, i nɔ kə chíe chu-i te nə nɔŋ. Ɔ kíahə ŋwɔŋ-ɛŋ gìe tʉ nuɔ-bʉə ndə bɔ̂ŋ kə́ gwè hə bɔ̌ŋ ɔŋ mbɔ, <char style="wj">“M̈ɔ shyíi bii, mɔ chʉʼ nyíɛ wo ndə ɔ kɔ́ fyii-i tʉ Nyii nə wo-ɔ̄ buŋ mu Isilɛ fɛ.”</char> <verse eid="LUK 7:9" /><verse number="10" style="v" sid="LUK 7:10" />Ndʉʉghɔfii, bʉə ndə bə kə tə́ŋ bɔŋ, bʉ̀nə chunjaa nyíɛ mbʉ vaafɔ̀ʼ tʉ ɔ nɔʼ kie nchʉʼ.<verse eid="LUK 7:10" /></para>
  <para style="s">Jiso byʉ̀hə vaa-kwuʼwoke ndə ɔ nɔʼ kə kwú</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11" />Ndʉʉ kʉ̂ʉ tíŋ məniʼ, Jiso gɛ̀ mu lɔʼɔbɛʼ bə kə́ tíi nə Nɛŋ, vâafɔʼɔ-bi ghɔŋbə nuɔ-bʉə-buŋmbi kə́ gɛ̀ hə bɔ̌ŋ ɔŋ. <verse eid="LUK 7:11" /><verse number="12" style="v" sid="LUK 7:12" />Ndʉʉ ndə ɔ kə gɛ̀ kə́ŋhə mbʉə chulɔŋ lɔʼɔ-ghɔ̄, bə nɔ kə bɛ̀ʼ vaa-kwuʼwoke ndə ɔ nɔʼ kwú kə́ fyú nə nɔŋ mbi, ɔ kə́ bɛ haʼ mbyu vaabələŋ imɔʼ kəghɔ-ŋkwê-i. Bʉə buŋmbi ndə bɔ̂ŋ lɔ̀ hə lɔʼɔ-ghɔ̄ nɔ kə́ gwè hə bɔ̌ŋ kwuʼ woke-ghɔ̄. <verse eid="LUK 7:12" /><verse number="13" style="v" sid="LUK 7:13" />Ndʉʉ ndə Tiekətʉ nyíɛ mbʉ woke-ghɔ̄, tʉkə-i vyíi ndəŋ ɔŋ. Ɔ gìe tʉ ɔŋ mbɔ, <char style="wj">“Kə a mə leʼ gwía fɛ.”</char> <verse eid="LUK 7:13" /><verse number="14" style="v" sid="LUK 7:14" />Ndʉʉghɔfii, Tiekətʉ kóʼ gɛ̀ kə̀ŋ mbʉ kətɔŋ-kəŋkwu-wo, bɔŋ bʉə ndə bɔ̂ŋ kə bɛ̀ʼ tə́nə kəyəŋ kəmɔʼ. Ɔ ghɔ̀ŋ mbɔ, <char style="wj">“Ŋaʼ, lɔ̀ hə sê.”</char> <verse eid="LUK 7:14" /><verse number="15" style="v" sid="LUK 7:15" />Mbʉ kəŋkwu wo bə̀ŋhə ŋwɔŋ-ɛŋ dùʼ, chʉ́ʉhə kə́ kwə́ʼ. Jiso kɔ́ ɔ tʉ ŋkwê-i.<verse eid="LUK 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16" />Faa-kwu-kə yá bʉə bənchəŋ ndə bɔŋ kə bɛ chɔ, bɔ̂ŋ kə́ lə̀ʼtə Nyii, ghɔ̀ŋ mbɔ, “WoyʉkəŋgiekwɛʼtəŋNyii nɔʼ kóʼ mu bʉʼʉ, Nyii nɔʼ gwè ndə məkwáa bʉə-bi.” <verse eid="LUK 7:16" /><verse number="17" style="v" sid="LUK 7:17" />Bəsɔʼka-ɔ̄ te Jiso wɔ̀ʼnə mu Judia inchəŋ ghɔŋbə lɔʼ-bətə̂ŋ-tə ndə i yə̀ŋ bɔŋ fúu.<verse eid="LUK 7:17" /></para>
  <para style="s">Jiso ghɔŋ Jɔŋ ndə ɔ̃ kɔ́ muu</para>
  <para style="r">(<ref loc="MAT 11:2-19">Matia 11:2-19</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18" />Vâafɔʼɔ-Jɔŋ ndə ɔ̃ kɔ́ muu shyíi ɔ te nə nubə inchəŋ ndə Jiso tʉʼ fɔ̀ʼ. Ɔ tíi bɔŋ bəbûu, <verse eid="LUK 7:18" /><verse number="19" style="v" sid="LUK 7:19" />tə́ŋ bɔŋ tʉ Tiekətʉ ndə məbíʼtə mbɔ, “A bɛ mbʉ wo ndə ɔ kie ndə məgwè le mɛ, kə b̈aʼa kə́ kʉ̀ʼ wokədɔŋ?”<verse eid="LUK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20" />Ndʉʉ ndə mbʉ vâafɔʼɔ Jɔŋ kə gwè tʉ Jiso, bɔ̂ŋ gìe tʉ ɔŋ mbɔ, “Jɔŋ wo ndə ɔ̃ kɔ́ muu nɔ tə́ŋ baʼa ndə məgwè bíʼtə tʉ a mbɔ, ‘A bɛ wo ndə ɔ kie ndə məgwè le mɛ, kə baʼa kə́ kʉ̀ʼ wokədɔŋ?’ ”<verse eid="LUK 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21" />Mu ŋgwɔʼmbi-ghɔ̄ Jiso chʉ́ʼ bʉə buŋmbi ndə bɔ̂ŋ kə kie yɔʼbə, lyʉʉhəbʉəbʉəbə, bɔŋleʼ chʉ́ʼ bʉə ndə shʉtə-ʉə nɔʼ fʉ̀əŋtə. <verse eid="LUK 7:21" /><verse number="22" style="v" sid="LUK 7:22" />Jiso bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“B̈ii gɛ̀ shyíi Jɔŋ nə nubə ndə b̈ii nyíɛ bɔŋleʼ yʉ́, mbɔ bʉə ndə shʉtə-ʉə nɔʼ kə fʉ̀əŋtə nɔ tʉʼ nyíɛ nduɔ, bʉə ndə bɔ̂ŋ nɔʼ kə lɛ́ŋ nɔ tʉʼ tòʼ nduɔ, bʉə ndə bɔ̂ŋ kə kie lɔkə mbʉə-bɔŋ, mbʉəhə-ʉə nɔʼ bɛ jyujyu nduɔ, bʉə ndə tyunəbə-ʉə nɔʼ kə fʉ̀əŋtə nɔ tʉʼ yʉ́ nukə nduɔ, bʉə ndə bɔ̂ŋ nɔʼ kə kwútə nɔʼ bʉ̀nə kóʼ, bʉə-mbʉʼ bɔŋ-nɔʼ-leʼ yʉ́ ntəŋjyujyu ndə bə lɔ̀ʼ tʉ bɔŋ.</char> <verse eid="LUK 7:22" /><verse number="23" style="v" sid="LUK 7:23" /><char style="wj">Tʉʉjyu nɔ bɛ yi-bʉə-yə ndə bɔ̂ŋ gòʼ təmə kə́ jínə mɔ fɛ.”</char><verse eid="LUK 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24" />Ndʉʉ kʉ̂ʉ tíŋ ndə vâafɔʼɔ Jɔŋ kə bʉ̀nə, Jiso chʉ́ʉhə ndə məkwə́ʼ tʉ mbʉ nuɔ-bʉə te Jɔŋ mbɔ, <char style="wj">“Bii nə kə́ gwè mu kwɔŋkəyəŋnə ndə mənyíɛ ka? Bii nə kə́ gɛ̀ ndə mənyíɛ ŋginəŋgʉəʼbə ndə fʉʉkə tʉʼ gháahə mɛ?</char> <verse eid="LUK 7:24" /><verse number="25" style="v" sid="LUK 7:25" /><char style="wj">Bii kə gɛ̀ ndə mənyíɛ ka ndʉʉghɔfii? Mɛ kə bii kə́ gɛ̀ nyíɛ bə wo ndə ɔ̃ kə mɔ̀ʼ ndyi-kyʉə-hə mbʉə-ɔ? B̈ii yʉ́, b̃ʉə ndə bɔ̂ŋ mɔ̀ʼ ndyi-kyʉə-hə mbʉə-bɔŋ, bɔŋ-kə́-leʼ yú bəfɔŋ, nɔ bɛ ntoʼ.</char> <verse eid="LUK 7:25" /><verse number="26" style="v" sid="LUK 7:26" /><char style="wj">Bii kə́ gɛ̀ ndʉʉghɔfii mbi ndə məgɛ̀ nyíɛ ka? YʉkəŋgieNyii mɛ? Ɔŋ, m̈ɔ shyíi bii nə shʉəŋ mbɔ ɔ nɔ buŋ gʉ́ə chàa yʉkəŋgieNyii.</char> <verse eid="LUK 7:26" /><verse number="27" style="v" sid="LUK 7:27" /><char style="wj">Nɔ bɛ mbəŋ-ɛŋ ndə bə kə nyɔ̀ʼ te ɔ mbɔ,</char></para>
  <para style="q1" vid="LUK 7:27">
    <char style="wj">‘B̈ii nyíɛ, mɔ bu tə́ŋ wontəŋ-ɔŋ, ɔ kə́ gɛ̀ hə bəshʉ a,</char></para>
  <para style="q2" vid="LUK 7:27">
    <char style="wj">ndə ɔ bu shʉ̀tə fia tʉ a bəshʉ.’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">7:27 </char>
      <char style="ft" closed="false">Malakai 3:1.</char>
    </note><verse eid="LUK 7:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="LUK 7:28" />
    <char style="wj">M̈ɔ shyíi bii mbɔ, hə mu bʉə ndə bɔ̂ŋ fyú hə bətɔ-bəke, wo kaa chɔ ndə ɔ gʉ́ə chàa Jɔŋ fɛ. Bɔŋ wo ndə ɔ bɛ ndyiʼtəkə mu Sɔ́ʼ-Nyii nɔ gʉ́ə chàa Jɔŋ.”</char><verse eid="LUK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29" />Ndʉʉ ndə bʉə bənchəŋ ghɔŋbə bʉə fí tashi ŋkwo kə yʉ́ kwə́ʼ Jiso, bɔ̂ŋ nɔ kə bɛ́ŋ mbɔ nukə ndə Nyii nɔʼ fɔ̀ʼ nɔ bɛ ndyʉndyʉ, bʉʼka bɔ̂ŋ nɔ kə fí muu kəghɔ-Jɔŋ. <verse eid="LUK 7:29" /><verse number="30" style="v" sid="LUK 7:30" />Bɔŋ bʉə-Falasi ghɔŋbə bʉə ndə bɔ̂ŋ kɛŋ nɔʼ yétə nuʼ-Mushi kə tɛ́ŋ nukə ndə Nyii nɔʼ kə shʉ̀tə te bɔŋ, bʉʼka bɔ̂ŋ kə fí muu kəghɔ-Jɔŋ fɛ.<verse eid="LUK 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31" />
    <char style="wj">“Bɛ ka bɛʼkə ndʉʉmɛ ndə bəkɔ mɔ fʉ̀ʼ ŋgwie-bʉə-bɔ̄ŋ laa ndəŋ ghɔ? Bɔ̂ŋ bɛ nə ka?</char> <verse eid="LUK 7:31" /><verse number="32" style="v" sid="LUK 7:32" /><char style="wj">Bɔ̂ŋ nɔ bɛ nə vâambuɔ ndə bɔ̂ŋ dùʼtə mu vyii kə́ tíi ŋwɔŋtə-ʉə, ghɔ̀ŋ mbɔ, ‘Baʼa tʉ́ʉ vâandʉ̂ʉ tʉ bii təmə bii kʉ̀ʉ fɛ, baʼa tɔ́ kwú təmə bii gwía fɛ.’</char> <verse eid="LUK 7:32" /><verse number="33" style="v" sid="LUK 7:33" /><char style="wj">Bʉʼka Jɔŋ ndə ɔ̃ kɔ́ muu nɔ kə gwè təmə kyinə yú bele fɛ təmə bɔŋ-kə́-leʼ nú ndʉʼmə ghɔ fɛ, bii bɔŋ kə́ ghɔ̀ŋ mbɔ, ‘Ɔ nɔ kie lyʉʉhəbʉəbʉəkə mu mbʉə-ɔ.’</char> <verse eid="LUK 7:33" /><verse number="34" style="v" sid="LUK 7:34" /><char style="wj">Mbʉ Vaa-Woməsʉʉ nɔʼ gwè kə́ yú bɔŋleʼ nú, bii kə́ ghɔ̀ŋ mbɔ, ‘B̈ii nyíɛ ɔŋ nyíɛ! Wo-məntɔ ghɔŋ mbuuməndʉʼ, tiekənu-bʉə-fí-tashi ghɔŋbə bʉə-bʉ̂ʼʉ!’</char> <verse eid="LUK 7:34" /><verse number="35" style="v" sid="LUK 7:35" /><char style="wj">Bɔŋ m̃ukətʉ súunə nɔ dʉ̀ʼ mbɔ i nɔ bɛ kʉ̀ʼnə nə bʉə bənchəŋ ndə bɔ̂ŋ tʉʼ gɛ̀ hə bɔ̌ŋ ghɔ.”</char><verse eid="LUK 7:35" /></para>
  <para style="s">Jiso sʉ̀fyii hə ndəŋ woke bʉ̂ʼʉ</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36" />Mbyu wo-Falasibɛʼ nɔ nə kɔ̀ʼnə Jiso ndə məgwè yú fɔbə ghɔŋ ɔŋ, ndʉʉghɔfii ɔ gɛ̀ mu njaa mbʉ wo-Falasi, bɔ̂ŋ dùʼtə yə̀ŋ tebele fúu. <verse eid="LUK 7:36" /><verse number="37" style="v" sid="LUK 7:37" />Kə nyíɛ, wokebɛʼ ndə ɔ nə bɛ wo-bʉ̂ʼʉ tʉ Nyii mu kəyəŋkwɛʼtəŋ-ghɔ̄, kʉ̂ʉ yʉ́ mbɔ Jiso tʉʼ yú fɔbə mu njaa-wo-Falasi, ɔ gwè nə vaakətəŋ-məŋgwo ndə bə chìi nə ŋgoʼbɛʼ bə kə́ tíi nə alabasta, <verse eid="LUK 7:37" /><verse number="38" style="v" sid="LUK 7:38" />gwè tə́nə mbʉə ɔ, kə́ gwía, shʉmə-i kə́ chə́ŋtə ndəŋ wukə-i. Ɔ kə́ yʉ̀əʼtə nə nyu-kətʉ-hə-i, kə́ yá wukə-i bɔ́nə<note caller="+" style="f"><char style="fr" closed="false">7:38 </char><char style="ft" closed="false">Məbɔ́nə wu-wo-kə ndəŋ nuʼ-yʉə nɔ nə kə́ dʉ̀ʼ kuŋhə, məlʉ̀ ŋwɔŋ sê leʼnə ndɔ.</char></note> fyii-ɔ, véʼ lamənda chɔ yóʼ.<verse eid="LUK 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 7:39" />Ndʉʉghɔfii, mbʉ wo-Falasi ndə ɔ kə kɔ̀ʼnə ɔŋ nyíɛ yɔ̄ŋ-yə, gìe tʉ ŋwɔŋ-ɛŋ mbɔ, “Kaʼ wo-ɔ̄ kʉ̌ʉ bɛ yʉkəŋgieNyii, təmə ɔ nɔ kínə wo ndə ɔ tʉʼ kə̀ŋ ɔŋ, bɔŋleʼ kínə ntɛ-woke-hə ndə ɔ bɛ yɔ̄ŋ-yə, mbɔ ɔ nɔ bɛ wo-bʉ̂ʼʉ.”<verse eid="LUK 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40" />Jiso bə̀ŋhə ghɔ̀ŋ mbɔ, <char style="wj">“Samu, mɔ nɔ kie nukə ndə məgìe tʉ a.”</char> Ɔ bə̀ŋhə tʉ ɔŋ mbɔ, “Gìe tʉ mɔ, chicha.”<verse eid="LUK 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41" />Jiso ghɔ̀ŋ mbɔ, <char style="wj">“Bʉə bəbûu nɔ nə kie kyʉə bətɔ-bɔŋ, ndə bɔ̂ŋ chɔ́ʼhə kəghɔ-wobɛʼ. Womɔʼ kie ŋkɔŋhə təghyʉʉ tətaa bətɔ-ɔ, ibɛʼ-yə kie ŋkɔŋhə wuŋ taa.</char> <verse eid="LUK 7:41" /><verse number="42" style="v" sid="LUK 7:42" /><char style="wj">Wo mu bɔŋ kə kie mbʉ kyʉə ndə məbyʉ̀hə fɛ. Bʉʼka tʉvyiikə-i, ɔ sʉ̀fyii-i hə ndəŋ bɔŋ, chɔʼ mbʉ ŋkwo-yʉə bəbûu mɛ̀ʼ. Nduɔ bɛ nda mu bʉə-bɔ̄ŋ ndə ɔ bu kʉ̀ʉ ɔ yɔ́ŋyɔ́ŋ?”</char><verse eid="LUK 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43" />Samu bə̀ŋhə mbɔ, “Mɔ nɔ kwɔ̀ʼtə mbɔ, nɔ wo ndə bə chɔʼ ŋkwo yɔ́ŋyɔ́ŋ bətɔ-ɔ mɛ̀ʼ le.”</para>
  <para style="p" vid="LUK 7:43">Jiso bə̀ŋhə mbɔ, <char style="wj">“A nɔ kwɛ̀ jyujyu.”</char> <verse eid="LUK 7:43" /><verse number="44" style="v" sid="LUK 7:44" />Ɔ kíahə ŋwɔŋ-ɛŋ tʉ mbʉ woke-ghɔ̄, gìe tʉ Samu mbɔ, <char style="wj">“A nyíɛ woke-ɔ̄ mɛ? Mɔ nɔ gwè mu njaa-a təmə a kɔ́ muu tʉ mɔ ndə məlíʼtə wukə-ɔŋ chɔ fɛ. Ɔ nɔ sʉ̀ wukə-ɔŋ nə shʉmə-i, bɔŋleʼ bʉ̀nə yʉ̀əʼtə nə nyu-kətʉ-hə-i.</char> <verse eid="LUK 7:44" /><verse number="45" style="v" sid="LUK 7:45" /><char style="wj">A kə bɔ́nə mɔ fɛ, bɔŋ yɔ̄ŋ-yə woke chʉʼ nə mɛ̀ʼtə ndə məbɔ́nə wukə-ɔŋ fɛ, lʉ̀ hə ndʉʉ ndə mɔ ŋíi mu njaa-a.</char> <verse eid="LUK 7:45" /><verse number="46" style="v" sid="LUK 7:46" /><char style="wj">A yóʼ ŋgwomə kətʉ-mɔ ndə nuʼ-yʉʼʉ fɛ, bɔŋ woke-ɔ̄ nɔʼ dʉ̀ʼ gyʉəʼə-chʉ́əʼ tʉ mɔ ndə məshyìi lamənda kəwu-mɔ.</char> <verse eid="LUK 7:46" /><verse number="47" style="v" sid="LUK 7:47" /><char style="wj">Nduɔ, mɔ nɔ tʉʼ shyíi a mbɔ mɔ nɔʼ kə sʉ̀fyii-ɔ ndəŋ bʉ̂ʼtə-i buŋmbi, bʉʼka yɔ̄ŋ-yə, ɔ nɔ dʉ̀ʼ mbɔ ɔ nɔ kʉ̀ʉ mɔ yɔ́ŋyɔ́ŋ, bɔŋ wo ndə mɔ sʉ̀fyii-ɔ ndəŋ bʉ̂ʼʉ-e məniʼ, nɔ kʉ̀ʉ mɔ məniʼ.”</char> <verse eid="LUK 7:47" /><verse number="48" style="v" sid="LUK 7:48" />Ndʉʉghɔfii, Jiso gìe tʉ woke-ghɔ̄ mbɔ, <char style="wj">“Mɔ nɔʼ sʉ̀fyii-ɔ ndəŋ bʉ̂ʼtə-a.”</char><verse eid="LUK 7:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49" />Bəbɛʼbʉə ŋkɔʼnə kə́ kwə́ʼ tʉ ŋwɔŋtə-ʉə mbɔ, “Bɛ nda nɔ ndə ɔ tʉʼ sʉ̀fyii-i hə ndəŋ bʉ̂ʼ-bʉə-tə?” <verse eid="LUK 7:49" /><verse number="50" style="v" sid="LUK 7:50" />Jiso gìe tʉ mbʉ woke mbɔ, <char style="wj">“Məmɔʼfyii-a ndəŋ Nyii nɔʼ kwáa a. Tòʼ jyu.”</char><verse eid="LUK 7:50" /></para>
  <chapter eid="LUK 7" />
  <chapter number="8" style="c" sid="LUK 8" />
  <para style="s">Bəke ndə bɔ̂ŋ kə́ gɛ̀ hə bɔ̌ŋ Jiso</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1" />Yɔ̄ŋ-yə kʉ̂ʉ tíŋ, Jiso kə́ tòʼ, lɔ̀ hə ndəŋ mbyu kəyəŋkwɛʼtəŋ imɔʼ ghɔŋbə lɔʼ-bətə̂ŋ-tə gɛ̀ ndəŋ bəbɛʼbə, kə́ tòʼ lɔ̀ʼ ntəŋjyujyu te Sɔ́ʼ-Nyii. Ɔ gɛ̀ ghɔŋbə bəlɔntəŋ-bi njuɔ bûu nə wuŋ, <verse eid="LUK 8:1" /><verse number="2" style="v" sid="LUK 8:2" />leʼnə bəkebɛʼbə ndə bə nɔʼ chʉ́ʼ bɔŋ ndəŋ lyʉʉhəbʉəbʉəbə ghɔŋbə yɔʼbə, Mɛli, ndə bə kə́ tíi ɔ nə Matalina, ndə lyʉʉhəbʉəbʉəbə kə fyú hə mbʉə-ɔ təkwiitia, <verse eid="LUK 8:2" /><verse number="3" style="v" sid="LUK 8:3" />Juana vi Kusa ndə ɔ kə́ lɛ́nə fɔ-Hɛlo-bə, Susana leʼnə bəbɛʼbə. Bəke-bɔ̄ŋ nɔ nə kə́ kwáa tɔ́ŋ bɔŋ nə yʉə-yə ŋkɔɔtəka.<verse eid="LUK 8:3" /></para>
  <para style="s">Chəŋkə te wo ndə ɔ tʉʼ gɛ̀ shùɔ ŋgwie</para>
  <para style="r">(<ref loc="MAT 13:1-23">Matia 13:1-23</ref>; <ref loc="MRK 4:1-20">Mak 4:1-20</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4" />Ndʉʉ ndə bʉə buŋmbi kə́nə tə yɔ́ŋ, bʉə bətə̂ŋbətə̂ŋ kə́ gwè tʉ Jiso, ɔ mɔ̀ʼ chəŋkə tʉ bɔŋ mbɔ, <verse eid="LUK 8:4" /><verse number="5" style="v" sid="LUK 8:5" /><char style="wj">“Wo-mutɔbɛʼ nɔ nə gɛ̀ mutɔ ndə məgɛ̀ mɔ̀ʼ ŋgwie-e, ndə ɔ tʉʼ mɔ̀ʼ, bəbɛʼbə gwùtə bətʉghʉʉ, bʉə tòʼtə nə wukə, nuɔ-mbi-mə chʉ́ʼtə.</char> <verse eid="LUK 8:5" /><verse number="6" style="v" sid="LUK 8:6" /><char style="wj">Bəbɛʼbə gwùtə mu ŋgoʼhə, kóʼ məniʼ yə́ŋtə, bʉʼka i kə kie muu fɛ.</char> <verse eid="LUK 8:6" /><verse number="7" style="v" sid="LUK 8:7" /><char style="wj">Ibɛʼ-yə ŋgwie gɛ̀ gwù mu təgyii, mbʉ təgyii kóʼ kwóhə i kwú.</char> <verse eid="LUK 8:7" /><verse number="8" style="v" sid="LUK 8:8" /><char style="wj">Bəbɛʼŋgwie gwùtə ndəŋ chɔʼ-jyujyu-kə kóʼ, mbʉ ŋgwie kə́ kʉ́ʉnə ntɔŋmə nə ghyʉʉ, tíŋ ndə bə kə shùɔ.”</char> J̃iso nɔ gìe nubə-ɔ̄ŋ nɔ, ɔ ghɔ̀ŋ mbɔ, <char style="wj">“Wotəmiyɔŋ ndə ɔ kie tyunəkə ndə məyʉ́, ɔ̈ yʉ́.”</char><verse eid="LUK 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9" />Ndʉʉ ndə vâafɔʼɔ-bi bíʼtə tʉ ɔŋ te nukə ndə mbʉ kəchəŋ bɛ yɔŋ, <verse eid="LUK 8:9" /><verse number="10" style="v" sid="LUK 8:10" />ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Bii nɔ kie ndaa ndə bə kɔ́ tʉ bii, ndə məkínə nubə ndə bə lə̀ŋ te Sɔ́ʼ-Nyii, bɔŋ tʉ bʉəbɛʼbə m̃ɔ nɔ mɔ̀ʼ ndəŋ chəŋkə, mbɔ bɔ̂ŋ chʉʼ kə́ nyíɛ təmə bɔ̂ŋ kə́ chèʼnə fɛ, bɔ̂ŋ chʉʼ kə́ yʉ́ təmə bɔŋ kə́ kínə fɛ.</char><verse eid="LUK 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11" />
    <char style="wj">“Nduɔ, mbʉ kəchəŋ nɔ bɛ mbɔ mbʉ ŋgwie nɔ bɛ ŋgieNyiikə.</char> <verse eid="LUK 8:11" /><verse number="12" style="v" sid="LUK 8:12" /><char style="wj">Bi ndə bɔ̂ŋ gwùtə bətʉghʉʉ, nɔ bʉə ndə bɔ̂ŋ nɔʼ yʉ́ ŋgieNyiikə, Debulu gwè fyúhə hə mbʉ kəŋgie mu fyii-bɔŋ, bʉʼka bɔ̂ŋ mə bɛ́ŋ mbʉ kəŋgie, i kwáa bɔŋ.</char> <verse eid="LUK 8:12" /><verse number="13" style="v" sid="LUK 8:13" /><char style="wj">Bi ndə bɔ̂ŋ gwùtə mu ŋgoʼhə, nɔ bɛ bʉə ndə bɔ̂ŋ yʉ́ mbʉ ŋgiekə fí nə mu fyii sʉ́ʼnə təmə ghûutə-ʉə dɔ̀ŋnə fɛ, bɔ̂ŋ bɛ́ŋ Nyii haʼ məniʼ, nubə kʉ̂ʉ kə́ shʉ́ə tʉ bɔŋ, bɔ̂ŋ yʉ̀əʼtə liɛŋ-yʉə.</char> <verse eid="LUK 8:13" /><verse number="14" style="v" sid="LUK 8:14" /><char style="wj">Ŋgwie ndə i gwùtə mu təgyii nɔ bɛ bʉə ndə bɔ̂ŋ kə yʉ́, kʉ̂ʉ fyú fia, nubə ndə i tʉʼ chɔ́ŋhə bɔŋ, fʉʼkə ghɔŋbə nu-tʉʉjyu-bə kəwʉʉnəmbi-fɛ̄ŋ kwóhə, i chìi təmə i mə tə̀ŋ mu fyii-bɔŋ fɛ.</char> <verse eid="LUK 8:14" /><verse number="15" style="v" sid="LUK 8:15" /><char style="wj">Ŋgwie ndə i gwùtə ndəŋ ŋkɛŋ sê nɔ bɛ bʉə ndə bɔ̂ŋ kie fyii tʉ́ʉnə ghɔŋbə fyii jyujyu, bɔ̂ŋ bɛ́ŋ ŋgieNyiikə tə́nə chɔ nə shʉəŋ, yá fyiihə-ʉə kə́ kʉ́ʉnə ntɔŋ-jyujyu-mə tə i tə́ŋ.</char><verse eid="LUK 8:15" /></para>
  <para style="s">Mɔ̀ʼ kɛʼɛ ndəŋ kəfɔ</para>
  <para style="r">(<ref loc="MRK 4:21-25">Mak 4:21-25</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16" />
    <char style="wj">“Wo kə chúʼ kɛʼɛ lə̀ŋ mu kəfɔ fɛ, təmə bɔŋ mətʉ́ʼ tɔʼɔ kəbɔ fɛ. A mɔ̀ʼ ndəŋ kəfɔ kə mbɔ bʉə ndə bɔ̂ŋ tʉʼ sʉ́ʉ mu njaa, bu nyíɛ məbáa-ɛ.</char> <verse eid="LUK 8:16" /><verse number="17" style="v" sid="LUK 8:17" /><char style="wj">Bʉʼka nubɛʼkə kaa ghɔ ndə bə bɔŋ ndə i bu yi gòʼ təmə kɛ̀ʼnə fɛ, byuunɔ ndə i tʉʼ líi təmə bə bu nə kínə, i bɔŋ yi gwè ŋgwʉʉnə fɛ.</char> <verse eid="LUK 8:17" /><verse number="18" style="v" sid="LUK 8:18" /><char style="wj">Kwɔ̀ʼtə tʉkə-a nə ntɛhə ndə a yʉ́ nukə. Bʉʼka mbɔ wo ndə ɔ kie bə bu bìʼ yi-yɔ́ŋyɔ́ŋ-yə chɔ, bɔŋ wo ndə ɔ gòʼ təmə kie fɛ, buŋ vaadyʉʼʉ ndə ɔ kwɔ̀ʼtə mbɔ ɔ kie, bə bu fí hə kəghɔ-ɔ.”</char><verse eid="LUK 8:18" /></para>
  <para style="s">Ŋkwê-Jiso ghɔŋbə bəliŋ-bi</para>
  <para style="r">(<ref loc="MAT 12:46-50">Matia 12:46-50</ref>; <ref loc="MRK 3:31-35">Mak 3:31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19" />Ndʉʉmɛ, ŋkwê-Jiso ghɔŋbə bəliŋ-bi gwè ndə mənyíɛ ɔŋ, bɔŋ bʉʼka bʉə kə yɔ́ŋ daa, bɔ̂ŋ chìi kəŋkaa mbɔ bɔ̂ŋ dàa mbʉə ɔ. <verse eid="LUK 8:19" /><verse number="20" style="v" sid="LUK 8:20" />Wobɛʼ ghɔ̀ŋ tʉ ɔŋ mbɔ, “Naa-aŋ ghɔŋbə bəliŋ-ba nɔ tə́nə mbi kə́ kʉ́ʉ ndə mənyíɛ aŋ.”<verse eid="LUK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21" />Bɔŋ ɔ bə̀ŋhə mbɔ, <char style="wj">“Naa-ɔŋ ghɔŋbə bəliŋ-bɔŋ nɔ bʉə ndə bɔ̂ŋ yʉ́ ŋgieNyiikə kə́ fɔ̀ʼ.”</char><verse eid="LUK 8:21" /></para>
  <para style="s">Jiso yùʼ fʉ̂əŋ mu taanə-kəghəŋ-kə</para>
  <para style="r">(<ref loc="MAT 8:23-27">Matia 8:23-27</ref>; <ref loc="MRK 4:35-41">Mak 4:35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22" />Yɔŋbɛʼ, Jiso ghɔ̀ŋ tʉ vâafɔʼɔ-bi mbɔ, <char style="wj">“B̈ʉʼʉ dàa muu gɛ̀ ndəŋ ibɛʼ-yə via-kətaanə-kəghəŋ-kə.”</char> Bɔ̂ŋ kóʼ mu kəbuu kə́ gɛ̀. <verse eid="LUK 8:22" /><verse number="23" style="v" sid="LUK 8:23" />Ndə bɔ̂ŋ tʉʼ gɛ̀, ɔ gwù mbɛŋhə. Fʉ̂əŋ shíʼ mu mbʉ taanə-kəghəŋ-kə, mbʉ kəbuu kə́ bə̀ŋtə, muu kə́ ŋíi muŋgɔ, bɔ̂ŋ kə́ tə́nə nduɔ chu-kwú.<verse eid="LUK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 8:24" />Vâafɔʼɔ-bi gɛ̀ yə̀ŋ ɔŋ ghɔ̀ŋ mbɔ, “Tiefɔʼ, Tiefɔʼ, baʼa tʉʼ nə bɛ́ muu!”</para>
  <para style="p" vid="LUK 8:24">Ɔ gwùʼtə, sɔ́ʼ mbʉ kəfʉʉ ghɔŋbə mbʉ muu ndə i kə́ bə̀ŋtə, mbʉ kəfʉʉ tə́nə, yəŋbə líitə. <verse eid="LUK 8:24" /><verse number="25" style="v" sid="LUK 8:25" />Ɔ bíʼtə tʉ vâafɔʼɔ-bi mbɔ, <char style="wj">“Məmɔʼfyii-yii-yīŋ ndəŋ mɔ ba?”</char></para>
  <para style="p" vid="LUK 8:25">Bɔ̂ŋ fàa, i chàa bɔŋ, bɔ̂ŋ kə́ bíʼtə tʉ ŋwɔŋtə-ʉə mbɔ, “Bɛ nda nɔ? Ndə ɔ kàhə fʉʉkə ghɔŋbə muu, bɔ̂ŋ yʉ́ chu-i.”<verse eid="LUK 8:25" /></para>
  <para style="s">Jiso chʉ́ʼ wobɛʼ ndə ɔ nə kie lyʉʉhəbʉəbʉəkə</para>
  <para style="r">(<ref loc="MAT 8:28-34">Matia 8:28-34</ref>; <ref loc="MRK 5:1-20">Mak 5:1-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26" />Ndʉʉmɛ, bɔ̂ŋ té buukə gɛ̀ shùɔ lɔʼɔ Galasa ndə i bɛ ndəŋ ibɛʼ-yə via-kətaanə-kəghəŋ-Galili-kə. <verse eid="LUK 8:26" /><verse number="27" style="v" sid="LUK 8:27" />Ndʉʉ ndə Jiso kə kóʼ mu kəbuu ŋgwuu mbʉ kəghəŋ, ɔ fə́nə ghɔŋ wo ndə ɔ kie lyʉʉhəbʉəbʉəbə, lɔ̀ hə kəyəŋkwɛʼtəŋ. I nɔʼ dɔ̀ŋnə təmə wo-ghɔ̄ mɔ̀ʼ ndyi bɔŋleʼ chí mu njaa fɛ. Ɔ kə́ chí bə haʼ mu sětə ndə bə sáa ndəŋ ŋgoʼ. <verse eid="LUK 8:27" /><verse number="28" style="v" sid="LUK 8:28" />Ndʉʉ ndə ɔ nyíɛ Jiso, ɔ gwía gwù bəshʉ ɔ, tíi nə gyʉʉ dədə, ghɔ̀ŋ mbɔ, “A tʉʼ kʉ́ʉ yì ka nə mɔ, Jiso, VaaNyii ndə ɔ Chaabəfɔŋ? Mɔ nɔ tʉʼ fʉ̀ʉtə a, kə a mə chɔ́ŋhə mɔ fɛ!” <verse eid="LUK 8:28" /><verse number="29" style="v" sid="LUK 8:29" />Ɔ nɔ kə gìe yɔ̄ŋ-yə bʉʼka Jiso nɔʼ kə kàhə mbʉ kəlyʉʉhəbʉəbʉə ndə məfyú hə mbʉə-wo-ghɔ̄. Ɔ nɔʼ kə́ yá ɔ vɛʼ buŋmbi mɔ̀ʼ sê. Buŋ ndə bə nɔʼ kə kɔ́ʼtə fʉəŋtə-i ghɔŋbə kwiitə-i nə bəchaŋ, bɔ̂ŋ kə́ chyìi ɔ, ɔ nɔ nə kə́ chètə mbʉ bəchaŋ, mbʉ kəlyʉʉhəbʉəbʉə tʉ́ʉhə ɔŋ, ɔ gɛ̀ bəyəŋ təmə bʉə kə́ chí chɔ fɛ.<verse eid="LUK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30" />Jiso bíʼtə tʉ ɔŋ mbɔ, <char style="wj">“Yie-a bɛ nda?”</char></para>
  <para style="p" vid="LUK 8:30">Ɔ bə̀ŋhə tʉ ɔŋ mbɔ, “Yie-ɔ nɔ bɛ Nuɔ,” bʉʼka nuɔ-bəlyʉʉhəbʉəbʉə buŋmbi nɔʼ kə sʉ́ʉ mu mbʉə-ɔ. <verse eid="LUK 8:30" /><verse number="31" style="v" sid="LUK 8:31" />Bɔ̂ŋ fʉ̀ʉtə ɔŋ təvɛʼtəvɛʼ mbɔ kə ɔ mə tə́ŋ bɔŋ mu byʉʉ ndə i gòʼ təmə kie liʼ fɛ. <verse eid="LUK 8:31" /><verse number="32" style="v" sid="LUK 8:32" />Nuɔ-bəŋkwunyaa-buŋmbi nɔ kə́ yú mbʉ mbʉə kwɔŋ-ghɔ̄. Mbʉ bəlyʉʉhəbʉəbʉə fʉ̀ʉtə Jiso ndə məmɛ̀ʼtə bɔŋ, bɔ̂ŋ sʉ́ʉ mu mbʉ bəŋkwunyaa-ghɔ̄bə, ɔ kɔ́ fia tʉ bɔŋ. <verse eid="LUK 8:32" /><verse number="33" style="v" sid="LUK 8:33" />Ndʉʉmɛ, ndə mbʉ bəlyʉʉhəbʉəbʉə fyú hə mu mbʉə-wo-ghɔ̄, bɔ̂ŋ gɛ̀ ŋíi mu mbʉ bəŋkwunyaa. Bɔ̂ŋ nyʉ́ʉ shíʼ ndəŋ ŋgwuu-mbʉ-kətaanə-kəghəŋ, gwùtə mbʉ mu muu kwútə.<verse eid="LUK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34" />Ndʉʉ ndə mbʉ bənchyii-bəŋkwunyaa nyíɛ nukə ndə i nɔʼ fyú, bɔ̂ŋ nyʉ́ʉ gɛ̀ nə wʉə, gɛ̀ fʉ̀ʼtə mbʉ bəsɔʼka mu kəyəŋkwɛʼtəŋ ghɔŋbə mu lɔʼɔ. <verse eid="LUK 8:34" /><verse number="35" style="v" sid="LUK 8:35" />Mbʉ bʉə-ghɔ̄bə fyútə gɛ̀ ndə mənyíɛ nukə ndə i nɔʼ fyú. Bɔ̂ŋ kʉ̂ʉ gwè tʉ Jiso, nyíɛ mbʉ wo-ghɔ̄ ndə mbʉ bəlyʉʉhəbʉəbʉə kə fyú hə mu mbʉə-ɔ, ɔ kə́ dùʼ mbʉə təfʉəŋ Jiso, bə nɔʼ mɔ̀ʼ ndyihə mbʉə-ɔ, ndaa-ɛ bɔŋ-nɔʼ-leʼ tə́nə, faakə yá bɔŋ. <verse eid="LUK 8:35" /><verse number="36" style="v" sid="LUK 8:36" />Bʉə ndə bɔ̂ŋ kə nyíɛ, fʉ̀ʼtə tʉ bəbɛʼbʉə ntɛhə ndə bə kə chʉ́ʼ wo-ghɔ̄ ndə lyʉʉhəbʉəbʉəbə kə bɛ mu mbʉə-ɔ le. <verse eid="LUK 8:36" /><verse number="37" style="v" sid="LUK 8:37" />Bʉə bənchəŋ ndə bɔ̂ŋ kə bɛ lɔʼɔ Galasa, fʉ̀ʉtə Jiso mbɔ ɔ̈ la lɔ̀ hə mu bie-bɔŋ, bʉʼka mbɔ faa-kwu-kə nɔʼ kə fí fyiihə-ʉə.</para>
  <para style="p" vid="LUK 8:37">Ndʉʉghɔfii, Jiso kóʼ mu kəbuu gɛ̀ nə wi. <verse eid="LUK 8:37" /><verse number="38" style="v" sid="LUK 8:38" />Wo-ghɔ̄ ndə mbʉ bəlyʉʉhəbʉəbʉə kə fyú hə mu mbʉə-ɔ fʉ̀ʉtə Jiso ndə məgɛ̀ ghɔŋ ɔŋ mɔʼɔ, bɔŋ Jiso téʼ tʉ ɔŋ mbɔ ɔ̈ la gɛ̀ nə wi, ghɔ̀ŋ mbɔ, <verse eid="LUK 8:38" /><verse number="39" style="v" sid="LUK 8:39" /><char style="wj">“Bʉ̀nə gɛ̀ chunjaa-a, gɛ̀ shyíi bʉə-ba nə nukwɛʼtəŋbə ndə Nyii nɔʼ chìi tʉ a.”</char> Ɔ gɛ̀ lɔ̀ʼ yə̀ŋ mu kəyəŋkwɛʼtəŋ te nukwɛʼtəŋkə ndə Jiso nɔʼ chìi tʉ ɔŋ.<verse eid="LUK 8:39" /></para>
  <para style="s">Jiso chʉ́ʼ wokebɛʼ leʼnə vaa-Jalu vaabəke</para>
  <para style="r">(<ref loc="MAT 9:18-26">Matia 9:18-26</ref>; <ref loc="MRK 5:21-43">Mak 5:21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40" />Ndʉʉ ndə Jiso bʉ̀nə Galili, bʉə buŋmbi fí ɔ, bʉʼka bɔ̂ŋ bənchəŋ nɔ kə́ chyìi ɔ. <verse eid="LUK 8:40" /><verse number="41" style="v" sid="LUK 8:41" />Ndʉʉghɔfii, mbyu wokwɛʼtəŋbɛʼ gwè, bə kə́ tíi ɔ nə Jalu, ɔ kə́ bɛ wokwɛʼtəŋ-mu-njaagháaNyii. Ɔ gwè kwíʼtə bəshʉ Jiso, fʉ̀ʉtə ɔŋ mbɔ, ɔ̈ gwè mu njaa-ɔ, <verse eid="LUK 8:41" /><verse number="42" style="v" sid="LUK 8:42" />bʉʼka ɔ nɔ kə kie mbyu vaabəke-e imɔʼ, ɔ kə́ bɛ nə ŋgʉʼhə njuɔ bûu nə wuŋ, nɔʼ yɔ́ʼ tə kə́ kwú.</para>
  <para style="p" vid="LUK 8:42">Jiso kʉ̂ʉ kə́ gɛ̀, bʉə kə́ bɛ bɔ̌ŋ ɔŋ yɔ́ŋ daa, kə́ fíanə ɔŋ. <verse eid="LUK 8:42" /><verse number="43" style="v" sid="LUK 8:43" />Wokebɛʼ nɔ kə bɛ chɔ ndə ɔ nɔʼ kə nyíɛ ŋgʉəʼ nə mbʉʼtəkə-i ndəŋ ŋgʉʼhə njuɔ bûu nə wuŋ, nɔʼ fɛ̀ŋ fɔbə-i inchəŋ kɔ́ tʉ bədota, bə chʉ́ʼ ɔ kəŋkaa. <verse eid="LUK 8:43" /><verse number="44" style="v" sid="LUK 8:44" />Ɔ gwè hə bɔ̌ŋ liɛŋ-ɔŋ kə̀ŋ tiɛŋ-ndyi-i, haʼ ndʉʉghɔfii, mbʉ kəmbʉʼtə chə̀nə.<verse eid="LUK 8:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 8:45" />Jiso bíʼtə mbɔ, <char style="wj">“Kə̀ŋ nda kə̀ŋ mɔ?”</char></para>
  <para style="p" vid="LUK 8:45">Bʉə bənchəŋ kʉ̂ʉ kɔ́tuu-yʉə, Bita ghɔ̀ŋ mbɔ, “Tiefɔʼ-ɔ, nɔ yɔ́ŋ bʉə kə́ fíanə a.”<verse eid="LUK 8:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46" />Mbʉ Jiso ghɔ̀ŋ mbɔ, <char style="wj">“Wobɛʼ nɔʼ kə̀ŋ mɔ, bʉʼka mɔ nɔʼ yʉ́ ndə ghʉəʼkə fyú hə mbʉə-mɔ.”</char> <verse eid="LUK 8:46" /><verse number="47" style="v" sid="LUK 8:47" />Woke-ghɔ̄ kʉ̂ʉ nyíɛ mbɔ ɔ mə líi fɛ, ɔ gwònə gwè gwù bəshʉ Jiso, núhə mu bʉə nukə ndə i chìi ɔ, ɔ kə̀ŋ Jiso leʼ shyíi bɔŋ ndə yɔʼkə-i tíŋ haʼ ndʉʉghɔfii. <verse eid="LUK 8:47" /><verse number="48" style="v" sid="LUK 8:48" />Jiso ghɔ̀ŋ tʉ ɔŋ mbɔ, <char style="wj">“Ŋaʼ, məmɔʼfyii-a ndə a mɔ̀ʼ ndəŋ mɔ, nɔʼ chìi yɔʼkə-a tíŋ. Tòʼ jyu.”</char><verse eid="LUK 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49" />Ndə ɔ kə́ bíe kwə́ʼ, wobɛʼ gwè hə fu-Jalu, ndə ɔ bɛ wokwɛʼtəŋ-mu-njaagháaNyii, ghɔ̀ŋ tʉ ɔŋ mbɔ, “Vaa-a nɔʼ kwú, kə a mə leʼ kɔ́ ŋgʉəʼ tʉ chicha fɛ.”<verse eid="LUK 8:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50" />Jiso kʉ̂ʉ yʉ́ nukə ndə ɔ tʉʼ gìe, bə̀ŋhə tʉ ɔŋ mbɔ, <char style="wj">“Kə a mə leʼ fàa fɛ, kə́ mɔ̀ʼ haʼ fyii-a ndəŋ mɔ, vaa-a bu bìi.”</char><verse eid="LUK 8:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51" />Ndʉʉ ndə bɔ̂ŋ gɛ̀ tə dàa chunjaa-ghɔ̄, Jiso kɔ́tuu mbɔ kə wo mə sʉ́ʉ mu njaa fɛ yaʼkɛŋ Bita, Jɔŋ leʼnə Jɛŋ nə mbʉ tie-vaa ghɔŋ ŋkwê-i. <verse eid="LUK 8:51" /><verse number="52" style="v" sid="LUK 8:52" />Mbʉ mu njaa kə́ bɛ ilə́ŋnə nə bʉə kə́ gwía mbʉ vaa gwù fɛ̄ŋ gwù fɛ̄ŋ. Jiso ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Kə bii mə leʼ gwía fɛ, ɔ chʉʼ kwú fɛ, mbʉ vaa nɔ tʉʼ bɛ́ŋbɛ́ŋ.”</char><verse eid="LUK 8:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53" />Bɔ̂ŋ chʉ́əʼ ɔ, kə́ kínə mbɔ mbʉ vaa nɔʼ kwú.<figure style="fig" alt="Jesus raise the dead girl" file="IB04125.tif" size="span" copy="Farid Faadill" ref="8:53">Jiso bʉ̀nə kóʼhə vaabəke ndə ɔ nɔʼ kwu</figure> <verse eid="LUK 8:53" /><verse number="54" style="v" sid="LUK 8:54" />Jiso yá kwii-i, gìe nə ghʉəʼkə mbɔ, <char style="wj">“Lɔ̀ hə sê, ŋaʼ!”</char> <verse eid="LUK 8:54" /><verse number="55" style="v" sid="LUK 8:55" />Haʼ ndʉʉghɔfii, lyʉʉhəkə-i bʉ̀nə, ɔ lɔ̀ hə sê. Jiso gìe tʉ bɔŋ mbɔ, “B̈ii kɔ́ fɔbə, ɔ̈ yú.” <verse eid="LUK 8:55" /><verse number="56" style="v" sid="LUK 8:56" />I chàa bətie-bi daa, Jiso shyùu tyunəkə-ʉə mbɔ, bɔ̂ŋ mə shyíi wo chɔ fɛ.<verse eid="LUK 8:56" /></para>
  <chapter eid="LUK 8" />
  <chapter number="9" style="c" sid="LUK 9" />
  <para style="s">Jiso tə́ŋ bəlɔntəŋ-bi njuɔ bûu nə wuŋ</para>
  <para style="r">(<ref loc="MAT 10:5-15">Matia 10:5-15</ref>; <ref loc="MRK 6:7-13">Mak 6:7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1" />Yɔŋbɛʼ Jiso tíi mbʉ bəlɔntəŋ-bi njuɔ bûu nə wuŋ mbʉə ɔ, kɔ́ ghʉəʼkə tʉ bɔŋ leʼnə ghʉəʼkə ndə məgìe kətʉ lyʉʉhəbʉəbʉəbə, leʼ chʉ́ʼ yɔʼbə. <verse eid="LUK 9:1" /><verse number="2" style="v" sid="LUK 9:2" />Ɔ leʼ tə́ŋ bɔŋ ndə məgɛ̀ lɔ̀ʼ tʉ wʉʉnəmbikə te Sɔ́ʼ-Nyii bɔŋleʼ chʉ́ʼ bʉə-bəyɔʼ. <verse eid="LUK 9:2" /><verse number="3" style="v" sid="LUK 9:3" />Ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Kə bii mə lʉ̀ fɔkə gɛ̀ nə yɔŋ fɛ, kə bii mə lʉ̀ mbuu fɛ, lʉ̀ kwo fɛ, lʉ̀ fɔ-yú-kə fɛ, lʉ̀ kyʉə fɛ, təmə lʉ̀ ndyi kwɛ́nə ŋwɔŋ fɛ.</char> <verse eid="LUK 9:3" /><verse number="4" style="v" sid="LUK 9:4" /><char style="wj">Kaʼ bii ŋíi mu njaa təmiyɔŋ, b̈ii káa chɔ tə nə lɔ̀ hə chɔ.</char> <verse eid="LUK 9:4" /><verse number="5" style="v" sid="LUK 9:5" /><char style="wj">Kaʼ bʉə gòʼ təmə fí bii fɛ, b̈ii kwètə bʉəkə kəwu-bii ndə ndʉʉ ndə bii tʉʼ fyú hə mu kəyəŋkwɛʼtəŋ, bɔŋ i bu bɛ cheʼkə mbɔ ndɔŋ-yʉə nɔ kətʉ-bɔŋ.”</char><verse eid="LUK 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 9:6" />Ndʉʉmɛ, bɔ̂ŋ fyú gɛ̀ mbi, kə́ lɔ̀ hə ndəŋ lɔʼɔ kətə̂ŋ dàa ndəŋ lɔʼɔ kətə̂ŋ, kə́ tòʼ lɔ̀ʼ ŋgieNyiikə, leʼ kə́ chʉ́ʼ bʉə ndəŋ yɔʼbə inchəŋ.<verse eid="LUK 9:6" /></para>
  <para style="s">Mbyuutəmbyuutə mu kətʉ-Hɛlo</para>
  <para style="r">(<ref loc="MAT 14:1-12">Matia 14:1-12</ref>; <ref loc="MRK 6:14-29">Mak 6:14-29</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7" />Nduɔ, Hɛlo ndə ɔ kə bɛ gɔməna-Galili, yʉ́ nubə ndə Jiso tʉʼ fɔ̀ʼ, i chɔ́ŋhə ɔŋ bɔŋleʼ chíe chu-i bʉʼka mbɔ bəbɛʼbʉə nɔ nə ghɔ̀ŋ mbɔ Jɔŋ ndə ɔ kə kwú la nɔʼ kóʼ. <verse eid="LUK 9:7" /><verse number="8" style="v" sid="LUK 9:8" />Bəbɛʼbə ghɔ̀ŋ mbɔ, la Ɛlaja ndə ɔ kwɔnə fyú, bəbɛʼbə ghɔ̀ŋ mbɔ la bɛ mbyu yʉkəŋgieNyii ndə ɔ nɔʼ kə kwú lʉ̀ hə ŋgʉʼʉbɛʼ, ndə ɔ bʉ̀nə kóʼ. <verse eid="LUK 9:8" /><verse number="9" style="v" sid="LUK 9:9" />Bɔŋ Hɛlo ghɔ̀ŋ mbɔ, “Mɔ nɔ kə chʉ̀ə tʉ-Jɔŋ-kə, bɛ nda ndʉʉmɛ ndə mɔ tʉʼ yʉ́ nubə-ɔ̄ŋ te ɔ nɔ?” Ɔ kə́ kɔ̀ɔtə ndə mənyíɛ ɔŋ.<verse eid="LUK 9:9" /></para>
  <para style="s">Jiso yúʼ ŋkɔŋ-bʉə-hə bətaa</para>
  <para style="r">(<ref loc="MAT 14:13-21">Matia 14:13-21</ref>; <ref loc="MRK 6:30-44">Mak 6:30-44</ref>; <ref loc="JHN 6:1-14">Jɔŋ 6:1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10" />Ndʉʉ ndə mbʉ bəlɔntəŋNyii bʉ̀nə, bɔ̂ŋ núhə nubə tʉ Jiso ndə bɔ̂ŋ nɔʼ kə fɔ̀ʼ. Ɔ lʉ̀ bɔŋ ghɔŋ bɔŋ fyúhə ŋwɔŋ-yʉə bɔ̌ŋ, gɛ̀ mbʉə kəyəŋkwɛʼtəŋbɛʼ ndə bə kə́ tíi nə Bɛsieda. <verse eid="LUK 9:10" /><verse number="11" style="v" sid="LUK 9:11" />Bʉə buŋmbi yʉ́ yəŋkə ndə ɔ gɛ̀ chɔ, gɛ̀ hə bɔ̌ŋ ɔŋ. Ɔ lʉ̀ bɔŋ, kwə́ʼ tʉ bɔŋ te Sɔ́ʼ-Nyii, bɔŋleʼ chʉ́ʼ bʉə ndə bɔ̂ŋ kə́ kʉ́ʉ nchʉʼ. <verse eid="LUK 9:11" /><verse number="12" style="v" sid="LUK 9:12" />Ŋgwɔʼmbi kʉ̂ʉ kə́ tíŋ, mbʉ bəlɔntəŋ-bi njuɔ bûu nə wuŋ gwè ghɔ̀ŋ tʉ ɔŋ mbɔ, “Ẅɔ̀ʼhə bɔŋ, bɔŋ gɛ̀ lɛ́nə yəŋbə mu lɔʼ-bətə̂ŋ-tə ndə i bɛ mbʉə bʉʼʉ leʼnə mu ntəʼhə ndə məkʉ́ʉ fɔyubə ghɔŋbə yəŋ-chí-bə, bʉʼka bʉʼʉ nɔ bɛ fɛ̄ŋ ndə yəŋ-mu-ŋkɔ-kə.”<verse eid="LUK 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13" />Bɔŋ ɔ bə̀ŋhə mbɔ, <char style="wj">“B̈ii kɔ́ fɔbə tʉ bɔŋ, b̈ɔ̂ŋ yú.”</char></para>
  <para style="p" vid="LUK 9:13">Bɔ̂ŋ bə̀ŋhə mbɔ, “Baʼa nɔ kie haʼ mbyu-bele-hə itaa, nə mbyu-mbɔʼ-hə ibûu, yaʼkɛŋ mbɔ baʼa gɛ̀ nyúɔ fɔbə tʉ bɔŋ bənchəŋ.” <verse eid="LUK 9:13" /><verse number="14" style="v" sid="LUK 9:14" />Ŋkɔŋ-bələŋ-hə kə́ bɛ chɔ bətaa.</para>
  <para style="p" vid="LUK 9:14">Bɔŋ ɔ leʼ ghɔ̀ŋ tʉ vâafɔʼɔ-bi mbɔ, <char style="wj">“B̈ii téʼ b̈ɔŋ dùʼtə sê tənuɔtənuɔ nə wuŋ taa wuŋ taa.”</char> <verse eid="LUK 9:14" /><verse number="15" style="v" sid="LUK 9:15" />Mbʉ vâafɔʼɔ-bi chìi haʼ nɔ, téʼ bɔŋ dùʼtə sê. <verse eid="LUK 9:15" /><verse number="16" style="v" sid="LUK 9:16" />Ndʉʉmɛ, ɔ lʉ̀ mbʉ mbyu-bele-hə itaa leʼnə mbʉ mbyu-mbɔʼ-hə ibûu, lɛ́nə yuo, kɔ́ ndɔ, bə́ʼtə, kɔ́ tʉ vâafɔʼɔ-bi mbɔ bɔ̂ŋ tʉ́ʼtə bəshʉ mbʉ nuɔ-bʉə. <verse eid="LUK 9:16" /><verse number="17" style="v" sid="LUK 9:17" />Bɔ̂ŋ bənchəŋ yú tə yúotə. Bɔ̂ŋ lɛ̀ʼtə shyiibə njuɔ bûu nə wuŋ i lə́ŋtə nə kwuʼkwuʼ-bele.<verse eid="LUK 9:17" /></para>
  <para style="s">Bita ghɔ̀ŋ mbɔ Jiso la bɛ Wo nə Nyii Kùŋ Tə́ŋ</para>
  <para style="r">(<ref loc="MAT 16:13-19">Matia 16:13-19</ref>; <ref loc="MRK 8:27-29">Mak 8:27-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18" />Ndʉʉ ndə Jiso kə́ gháaNyii kəyəŋ-bəliinə ghɔŋbə vâafɔʼɔ-bi kə́ bɛ mɔʼɔ, ɔ bíʼtə tʉ bɔŋ mbɔ, <char style="wj">“Bʉə tʉʼ ghɔ̀ŋ mbɔ mɔ bɛ nda?”</char><verse eid="LUK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19" />Bɔ̂ŋ bə̀ŋhə mbɔ, “Bəbɛʼbə nɔ ghɔ̀ŋ mbɔ a la Jɔŋ ndə ɔ̃ kɔ́ muu, bɔŋ bəbɛʼbə ghɔ̀ŋ mbɔ a la Ɛlaja, bəbɛʼbə ghɔ̀ŋ mbɔ a la bɛ mbyu yʉkəŋgieNyiibɛʼ ndə ɔ nɔʼ kə kwú ŋgʉʼʉbɛʼ bʉ̀nə kóʼ.”<verse eid="LUK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20" />Ɔ bíʼtə tʉ bɔŋ mbɔ, <char style="wj">“Bɔŋ bii tʉʼ ghɔ̀ŋ mbɔ mɔ bɛ nda?”</char></para>
  <para style="p" vid="LUK 9:20">Bita bə̀ŋhə mbɔ, “A nɔ bɛ Wo ndə Nyii Kùŋ Tə́ŋ.”<verse eid="LUK 9:20" /></para>
  <para style="s">Jiso kwə́ʼ te kwu-i</para>
  <para style="r">(<ref loc="MAT 16:20-28">Matia 16:20-28</ref>; <ref loc="MRK 8:30-9:1">Mak 8:30–9:1</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21" />Jiso shyùu tyunəkə-ʉə mbɔ bɔ̂ŋ mə yi shyíi wo nə yɔ̄ŋ-yə fɛ. <verse eid="LUK 9:21" /><verse number="22" style="v" sid="LUK 9:22" />Ɔ leʼ ghɔ̀ŋ mbɔ, <char style="wj">“Vaa-Woməsʉʉ bu yaʼ nyíɛ ŋgʉəʼ ndə nubə buŋmbi. Bəntəŋbəshʉ, bətiefɛ̀ʼndɛŋNyii leʼnə bʉə dàhə nuʼ-Mushi bu tɛ́ŋ ɔŋ, bɔŋleʼ yí ɔ, kʉ̂ʉ bɛ chîbə itia nɔ bə bʉ̀nə kóʼhə ɔŋ.”</char><verse eid="LUK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23" />Ndʉʉmɛ, ɔ ghɔ̀ŋ tʉ bɔŋ bənchəŋ mbɔ, <char style="wj">“Kaʼ wo mu bii kʉ̀ʉ ndə məgwè hə bɔ̌ŋ mɔ, ɔ nɔ kie ndə mətɛ́ŋ ŋwɔŋ-ɛŋ, bɛ̀ʼ tyʉntɔɔnəkə-i bəchibəchi, gwè hə bɔ̌ŋ mɔ.</char> <verse eid="LUK 9:23" /><verse number="24" style="v" sid="LUK 9:24" /><char style="wj">Bʉʼka wo ndə ɔ kʉ̀ʉ ndə məkwáa ŋkwiitʉ-e, bu bɛ́, bɔŋ wo ndə ɔ kɔ́ ŋkwiitʉ-e bʉʼka mɔ, bu kie ŋkwiitʉ-e.</char> <verse eid="LUK 9:24" /><verse number="25" style="v" sid="LUK 9:25" /><char style="wj">Bəkɔ wo sii ka, kaʼ ɔ kie wʉʉnəmbikə inchəŋ, bɛ́ ŋkwiitʉ-e?</char> <verse eid="LUK 9:25" /><verse number="26" style="v" sid="LUK 9:26" /><char style="wj">Bɔŋ wotəmiyɔŋ ndə tʉkə-i tʉʼ vyíi bʉʼka mɔ ghɔŋbə ŋgiekə-ɔŋ, tʉ-Vaa-Woməsʉʉ-kə bu vyíi te ɔ, ndʉʉ ndə ɔ bu gwè mu məŋwɔʼmə-i, ndəŋ məŋwɔʼ Tie-e leʼnə yi-bʉəntəŋNyii-yə ndə bɔ̂ŋ bɛ ŋkʉʉ.</char> <verse eid="LUK 9:26" /><verse number="27" style="v" sid="LUK 9:27" /><char style="wj">Nɔʼ m̈ɔ shyíi bii nə shʉəŋ, bəbɛʼbʉə mu bii ndə bɔ̂ŋ tə́nə fɛ̄ŋ, kʉʉ yúotə kwú fɛ, tə bɔ̂ŋ yaʼ yi nyíɛ Sɔ́ʼ-Nyii.”</char><verse eid="LUK 9:27" /></para>
  <para style="s">Jiso fyú hə mu məŋwɔʼmə-i</para>
  <para style="r">(<ref loc="MAT 17:1-8">Matia 17:1-8</ref>; <ref loc="MRK 9:2-8">Mak 9:2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28" />Chîbə kʉ̂ʉ tíŋ fɔ̂ŋ, ndə Jiso gìe nubə-ɔ̄ŋ, ɔ lʉ̀ Bita ghɔŋbə Jɔŋ leʼnə Jɛŋ, ghɔŋ bɔŋ kóʼ gɛ̀ ndəŋ kwɔŋ ndə məgháaNyii. <verse eid="LUK 9:28" /><verse number="29" style="v" sid="LUK 9:29" />Ndə ɔ kə́ gháaNyii mbe-shʉ-i kwɛ́nə, ndyi-i kwɛ́nə kə́ leʼnə, nə leʼnə-wyuu-kə. <verse eid="LUK 9:29" /><verse number="30" style="v" sid="LUK 9:30" />Kə kwɔnə nyíɛ, bʉə bəbûu, Mushi ghɔŋ Ɛlaja, fyú kə́ kwə́ʼ ghɔŋbə Jiso. <verse eid="LUK 9:30" /><verse number="31" style="v" sid="LUK 9:31" />Bɔ̂ŋ fyú hə mu məŋwɔʼmə-ʉə, kə́ kwə́ʼ ghɔŋbə Jiso te kwu-i ndə i bu fyú shʉəŋ Jɛlosalɛŋ, haʼ ndə Nyii nɔʼ kə shʉ̀tə.<verse eid="LUK 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 9:32" />Bita ghɔŋbə bʉə-nuɔ-bi nɔ nə kə́ bɛ́ŋbɛ́ŋ, bɔŋ ndʉʉ ndə bɔ̂ŋ gwùʼtə bɔ̂ŋ nyíɛ məgʉə-e ghɔŋbə bʉə-ghɔ̄bə bəbûu kə́ tə́nə mɔʼɔ. <verse eid="LUK 9:32" /><verse number="33" style="v" sid="LUK 9:33" />Ndʉʉ ndə bʉə-ghɔ̄bə tʉʼ gɛ̀ nə wʉə, Bita ghɔ̀ŋ tʉ Jiso mbɔ, “Tiefɔʼ-ɔ, i nɔ bʉ̀ʉ ndə bâʼa bɛ fɛ̄ŋ nɔ. B̈âʼa fʉ̀ə lɛʼbə itia, imɔʼ tʉ a, imɔʼ tʉ Mushi leʼnə imɔʼ tʉ Ɛlaja.” Ɔ kə kínə nukə ndə ɔ kə́ gìe fɛ. <verse eid="LUK 9:33" /><verse number="34" style="v" sid="LUK 9:34" />Bɔŋ ndə ɔ kə́ bíe gìe, mbɔʼkə shíʼ kwóhə bɔŋ, faakə yá bɔŋ ndə bɔ̂ŋ kə ŋíi mu mbʉ kəmbɔʼ.<verse eid="LUK 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 9:35" />Gyʉʉ gìe mu mbʉ kəmbɔʼ mbɔ, “Nɔ bɛ Vaa-ɔŋ nɔ ndə mɔ Séʼ, b̈ii yʉ́ chu-i.” <verse eid="LUK 9:35" /><verse number="36" style="v" sid="LUK 9:36" />Ndʉʉ ndə mbʉ gyʉʉ liʼ, bɔ̂ŋ nyíɛ mbɔ Jiso nɔ nə tə́nə tətɛʼ ɔ. Mbʉ vâafɔʼɔ-bi káa nə yɔ̄ŋ-yə bətɔ-bɔŋ, bɔŋ təmə shyíi wo nə yɔŋ fɛ, tə i chí dɔ̀ŋnə.<verse eid="LUK 9:36" /></para>
  <para style="s">Jiso chʉ́ʼ vaabələŋ ndə ɔ kie lyʉʉhəbʉəbʉəkə mu mbʉə-ɔ</para>
  <para style="r">(<ref loc="MAT 17:14-18">Matia 17:14-18</ref>; <ref loc="MRK 9:14-27">Mak 9:14-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37" />Mbi kʉ̂ʉ sɛŋ fíi bɔ̂ŋ shíʼ kwɔŋ, nuɔ-bʉə-buŋmbi bìatə Jiso. <verse eid="LUK 9:37" /><verse number="38" style="v" sid="LUK 9:38" />Wobɛʼ tíi ɔ mu mbʉ bʉə mbɔ, “Chicha, mɔ nɔ tʉʼ fʉ̀ʉtə a mbɔ ä lɛ́nə vaabələŋ-ɔ̄ŋ kɔ́ mɔ, bʉʼka nɔ bɛ haʼ mbyu vaa-ɔŋ imɔʼ. <verse eid="LUK 9:38" /><verse number="39" style="v" sid="LUK 9:39" />L̃yʉʉhəbʉəbʉəkə nɔ gwù ndəŋ ɔŋ, ɔ tíi, i mɔ̀ʼ ɔ sê ndə ŋgɛŋ lukə fyùʼ chu-ɔ. Ɔ chʉʼ nə mɛ̀ʼtə ɔŋ fɛ, kə́ ŋìʼtə ɔŋ gɛ̀. <verse eid="LUK 9:39" /><verse number="40" style="v" sid="LUK 9:40" />Mɔ nɔʼ fʉ̀ʉtə vâafɔʼɔ-ba mbɔ b̈ɔ̂ŋ jə̀ŋ ɔŋ, bɔŋ bɔ̂ŋ mùutə kəŋkaa.”<verse eid="LUK 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41" />Jiso bə̀ŋhə mbɔ, <char style="wj">“Oo ŋgwie-bʉə ndə bɔ̂ŋ gòʼ təmə mɔ̀ʼfyiihə-ʉə ndəŋ mɔ fɛ bɔŋleʼ kie mənaa, mɔ kie ndə məbɛ bʉʼʉ ntyʉʉ təka? Mɔ kie ndə məbɛ bʉʼʉ ntyʉʉ təka tə bii buŋ yi bɛ́ŋ mɔ? Gwè nə mbʉ vaa fɛ̄ŋ.”</char> <verse eid="LUK 9:41" /><verse number="42" style="v" sid="LUK 9:42" />Bɔŋ ndʉʉ ndə mbʉ vaa kə gwè, mbʉ kəlyʉʉhəbʉəbʉə chóʼ ɔ mɛ̀ʼ sê ndəŋ ŋgɛŋ. Jiso sɔ́ʼ mbʉ kəlyʉʉhəbʉəbʉə, chʉ́ʼ mbʉ vaa, kɔ́ ɔ tʉ tie-e. <verse eid="LUK 9:42" /><verse number="43" style="v" sid="LUK 9:43" />Bɔ̂ŋ nyíɛ ghʉəʼkwɛʼtəŋ-Nyii-kə, i chàa bɔŋ.</para>
  <para style="s" vid="LUK 9:43">Jiso bìʼ kwə́ʼ te kwu-i</para>
  <para style="r" vid="LUK 9:43">(<ref loc="MAT 17:22-23">Matia 17:22-23</ref>; <ref loc="MRK 9:30-32">Mak 9:30-32</ref>)</para>
  <para style="p" vid="LUK 9:43">Ndə bʉə kə́ bíe yie nubə ndə Jiso tʉʼ chìi, Jiso ghɔ̀ŋ tʉ vâafɔʼɔ-bi mbɔ, <verse eid="LUK 9:43" /><verse number="44" style="v" sid="LUK 9:44" /><char style="wj">“B̈ii yʉ́ jyujyu nukə ndə mɔ tʉʼ kʉ́ʉ gìe tʉ bii, bə nɔ tʉʼ gwè chɔ̀ʼhə Vaa-Woməsʉʉ kɔ́ mu kəghɔ-bʉəməsʉʉ.”</char> <verse eid="LUK 9:44" /><verse number="45" style="v" sid="LUK 9:45" />Təmə bɔ̂ŋ kínə nukə ndə yɔ̄ŋ-yə bɛ yɔŋ fɛ. Bə nɔ nə lə̀ŋ yɔ̄ŋ-yə hə kəghɔ-bɔŋ, bʉʼka bɔ̂ŋ mə yá tiɛŋ-ɛŋ, bɔ̂ŋ fàa ndə məbíʼtə.<verse eid="LUK 9:45" /></para>
  <para style="s">Bu bɛ nda bɛ wokwɛʼtəŋ?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Matia 18:1-5</ref>; <ref loc="MRK 9:33-37">Mak 9:33-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46" />Vâafɔʼɔ-bi chʉ́ʉhə bəŋʉʉ mu bɔŋ te wo ndə bəkɔ ɔ bɛ fɔŋ wokwɛʼtəŋ. <verse eid="LUK 9:46" /><verse number="47" style="v" sid="LUK 9:47" />Jiso kə́ kínə ŋkwɔʼtə-yʉə, lʉ̀ vaambuɔ tîetîe, tʉʼ ɔ mbʉə ɔ. <verse eid="LUK 9:47" /><verse number="48" style="v" sid="LUK 9:48" />Ndʉʉmɛ, ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Wotəmiyɔŋ ndə ɔ lʉ̀ vaambuɔ nə yɔ̄ŋ-yə kɔ́ mbʉə-ɔ yie-mɔ, nɔ lʉ̀ mɔ, bɔŋ wotəmiyɔŋ ndə ɔ leʼ lʉ̀ mɔ, nɔ lʉ̀ wo ndə ɔ tə́ŋ mɔ. Bʉʼka wotəmiyɔŋ ndə ɔ bɛ ndyiʼtə-wo-kə mu bii bənchəŋ nɔ bɛ fɔŋ wokwɛʼtəŋ.”</char><verse eid="LUK 9:48" /></para>
  <para style="s">Wo ndə ɔ gòʼ təmə tɛ́ŋ aŋ fɛ, nɔ bɛ kəvia-a</para>
  <para style="r">(<ref loc="MRK 9:38-40">Mak 9:38-40</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49" />Jɔŋ ghɔ̀ŋ tʉ Jiso mbɔ, “Tiefɔʼ-ɔ, baʼa nɔʼ nyíɛ wobɛʼ ɔ kə́ jə̀ŋ lyʉʉhəbʉəbʉəbə nə yie-a. Baʼa kə́ kɔ̀ɔtə ndə məkɔ́tuu tʉ ɔŋ, bʉʼka ɔ kaa mbyu wo-yʉʼʉ fɛ.”<verse eid="LUK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50" />Jiso ghɔ̀ŋ mbɔ, <char style="wj">“Kə bii mə kɔ́tuu tʉ ɔŋ fɛ, bʉʼka wo ndə ɔ gòʼ təmə tɛ́ŋ bii fɛ, nɔ bɛ kəvia-bii.”</char><verse eid="LUK 9:50" /></para>
  <para style="s">Bʉə-Samalia tɛ́ŋ Jiso</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51" />Ndʉʉ kʉ̂ʉ kə́ kʉ̀ʼnə gwè ndə bə kie ndə məlʉ̀ Jiso gɛ̀ nə nɔŋ yuo, Jiso tʉ́ʼ ndaahə-i ndə məgɛ̀ Jɛlosalɛŋ. <verse eid="LUK 9:51" /><verse number="52" style="v" sid="LUK 9:52" />Ɔ tə́ŋ bəlɔntəŋ-bi bəshʉ bɔ̂ŋ gɛ̀ mu lɔʼɔbɛʼ mu Samalia ndə məshʉ̀tə yəŋbə ɔ buŋ gwè. <verse eid="LUK 9:52" /><verse number="53" style="v" sid="LUK 9:53" />Bɔŋ təmə bʉə ndə bɔ̂ŋ bɛ mu lɔʼɔ-ghɔ̄ bɛ́ŋ ɔŋ fɛ, bʉʼka i leʼ bɛ nu-kətʉ-kwú-kə mbɔ ɔ tʉʼ gɛ̀ Jɛlosalɛŋ fɛ. <verse eid="LUK 9:53" /><verse number="54" style="v" sid="LUK 9:54" />Ndʉʉ ndə vâafɔʼɔ-bi Jɛŋ ghɔŋ Jɔŋ kə nyíɛ yɔ̄ŋ-yə, bɔ̂ŋ bíʼtə tʉ ɔŋ mbɔ, “Tiekətʉ, a kʉ̀ʉ mbɔ b̈aʼa tíi viʼi, i shíʼ hə yuo yítə bɔŋ mɛ?” <verse eid="LUK 9:54" /><verse number="55" style="v" sid="LUK 9:55" />Jiso kíahə ŋwɔŋ-ɛŋ, sɔ́ʼ bɔŋ. <verse eid="LUK 9:55" /><verse number="56" style="v" sid="LUK 9:56" />Ndʉʉmɛ, bɔ̂ŋ lɔ̀ gɛ̀ ndəŋ ibɛʼ-yə lɔʼɔ kətə̂ŋ.<verse eid="LUK 9:56" /></para>
  <para style="s">Chuɔŋ ndə məgɛ̀ hə bɔ̌ŋ Jiso</para>
  <para style="r">(<ref loc="MAT 8:19-22">Matia 8:19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57" />Ndʉʉ ndə bɔ̂ŋ tʉʼ tòʼ sêfia, wobɛʼ ghɔ̀ŋ tʉ ɔŋ mbɔ, “Mɔ bu gwè hə bɔ̌ŋ aŋ ndə yəŋkə təmiyɔŋ ndə a tʉʼ gɛ̀ chɔ.”<verse eid="LUK 9:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58" />Jiso bə̀ŋhə mbɔ, <char style="wj">“Bəsəŋyaŋgwo nɔ kie mbyuʼhə-ʉə ndə məchí chɔ, nuɔ-mbi-mə kie njaahə-ʉə, bɔŋ Vaa-Woməsʉʉ, kie yəŋ-mɔ̀ʼ-kətʉ-kə-i fɛ.”</char><verse eid="LUK 9:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59" />Ɔ gìe tʉ ibɛʼ-yə wo mbɔ, <char style="wj">“Gwè hə bɔ̌ŋ mɔ.”</char></para>
  <para style="p" vid="LUK 9:59">Mbʉ wo-ghɔ̄ bə̀ŋhə mbɔ, “Tiekətʉ, mɛ̀ʼtə m̈ɔ fəŋ gɛ̀ tyúu tie-ɔ.”<verse eid="LUK 9:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60" />Jiso ghɔ̀ŋ tʉ ɔŋ mbɔ, <char style="wj">“Mɛ̀ʼtə ŋkwu-bʉə-bə tyúu ŋkwu-bʉə-bʉə-bə. A gɛ̀ lɔ̀ʼ Sɔ́ʼ-Nyii tʉ bʉə.”</char><verse eid="LUK 9:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61" />Ibɛʼ-yə wo bìʼ ghɔ̀ŋ mbɔ, “Mɔ bu gwè hə bɔ̌ŋ aŋ, Tiekətʉ, bɔŋ fəŋ mɛ̀ʼtə m̈ɔ gɛ̀ tíŋhə bʉə-bɔŋ.”<verse eid="LUK 9:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62" />Jiso bə̀ŋhə mbɔ, <char style="wj">“Wo ndə ɔ yá sʉʉ-bənaʼa-tyúu-mutɔ-kə kə́ bʉ̀nə lɛ́nə bɔ̌ŋ liɛŋ-bi, kʉ̀ʼnə ndə məbɛ kəyəŋ ndə Nyii tʉʼ sɔ́ʼ fɛ.”</char><verse eid="LUK 9:62" /></para>
  <chapter eid="LUK 9" />
  <chapter number="10" style="c" sid="LUK 10" />
  <para style="s">Jiso tə́ŋ bʉə njuɔ bûu nə wuŋ təkwiitia mbi</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1" />Yɔ̄ŋ-yə kʉ̂ʉ tíŋ, Tiekətʉ séʼ bəbɛʼbʉə njuɔ bûu nə wuŋ təkwiitia, tə́ŋ bɔŋ bəbûubəbûu mbɔ b̈ɔ̂ŋ kə́ gɛ̀ hə bəshʉ ɔ ndə yəŋkwɛʼtəŋbə ghɔŋbə yəŋbə inchəŋ ndə ɔ bu gɛ̀ chɔ. <verse eid="LUK 10:1" /><verse number="2" style="v" sid="LUK 10:2" />Jiso ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Fɔbə nɔ yɔ́ŋ daa ndə məlʉ̀ mutɔ, bɔŋ bʉə-fɔʼɔ tə́ʼ, nɔ, b̈ii gwía shʉ́əshʉ́ə tʉ Tiekətʉ-bəfɔ-mutɔ, mbɔ ɔ̈ tə́ŋ bʉə-fɔʼɔ mutɔ-ɔ ndə məlʉ̀ fɔbə.</char> <verse eid="LUK 10:2" /><verse number="3" style="v" sid="LUK 10:3" /><char style="wj">Nduɔ, b̈ii gɛ̀! B̈ii nyíɛ! Mɔ nɔ tʉʼ tə́ŋ bii nə vâabinjyʉʉhə mu bəbuu.</char> <verse eid="LUK 10:3" /><verse number="4" style="v" sid="LUK 10:4" /><char style="wj">Kə bii mə lʉ̀ kyʉə fɛ, kə bii mə lʉ̀ kwo fɛ, təkɔmə takwubə. Kə bii mə kə́ kwə́ʼ dùhə fɛ.</char><verse eid="LUK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 10:5" />
    <char style="wj">“Ndʉʉtəmiyɔŋ ndə bii ŋíi mu njaa, b̈ii fəŋ ghɔ̀ŋ mbɔ, ‘Tə Nyii bìʼ bii nə fyiighʉ́ənə mu njaa-fɛ̄ŋ.’</char> <verse eid="LUK 10:5" /><verse number="6" style="v" sid="LUK 10:6" /><char style="wj">Kaʼ wo fyiighʉ́ənə bɛ mu njaa-ghɔ̄, məghaaNyii-yii tʉ ɔŋ te fyiighʉ́ənə káa ndəŋ ɔŋ. Bɔŋ byuunɔ i bʉ̀nə tʉ bii.</char> <verse eid="LUK 10:6" /><verse number="7" style="v" sid="LUK 10:7" /><char style="wj">Kə bii mə kə́ tòʼ chítə bəyəŋbəyəŋ fɛ. B̈ii káa mu njaa imɔʼ, kə́ nú bɔŋ yú fɔkə təmiyɔŋ ndə bə bu kɔ́ tʉ bii. Kə bii mə tɛ́ŋ fɔkə fɛ bʉʼka mbɔ wo-fɔ̀ʼ nɔ kie ndə məkie lɔʼɔbə-i.</char><verse eid="LUK 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 10:8" />
    <char style="wj">“Kaʼ bii ŋíi mu kəyəŋkwɛʼtəŋ, bɔ̂ŋ fí bii, b̈ii yú fɔkə təmiyɔŋ ndə bɔ̂ŋ kɔ́ tʉ bii.</char> <verse eid="LUK 10:8" /><verse number="9" style="v" sid="LUK 10:9" /><char style="wj">B̈ii chʉ́ʼ bʉə-bəyɔʼ ndə bɔ̂ŋ bɛ chɔ, shyíi bʉə-kəyəŋ-ghɔ̄bə mbɔ, ‘Ndʉʉ nɔʼ kʉ̀ʼnə tʉ Nyii ndə məsɔ́ʼ bii ndə fɔŋ.’</char> <verse eid="LUK 10:9" /><verse number="10" style="v" sid="LUK 10:10" /><char style="wj">Kaʼ bii bɔŋ ŋíi mu kəyəŋkwɛʼtəŋ təmə bɔ̂ŋ fí bii fɛ, b̈ii gɛ̀ mu fiatə inchəŋ chɔ ghɔ̀ŋ mbɔ,</char> <verse eid="LUK 10:10" /><verse number="11" style="v" sid="LUK 10:11" /><char style="wj">‘Baʼa nɔʼ yʉ̀əʼtə bʉə-lɔʼɔ-kə-i kəwu-baʼa, ndə mədʉ̀ʼ mbɔ ndɔŋ-yii nɔ kətʉ-bii. B̈ii bɔŋ kínə mbɔ Nyii nɔʼ gwè ndə məsɔ́ʼ bii.’</char> <verse eid="LUK 10:11" /><verse number="12" style="v" sid="LUK 10:12" /><char style="wj">M̈ɔ shyíi bii mbɔ i bu yi shʉ́ə ndəŋ chî-kwɛ̀-fɛʼɛ-kə tʉ bʉə-lɔʼɔ-ghɔ̄bə, tə chàa ndə i bu bɛ tʉ bʉə-Sodɔŋ.</char><verse eid="LUK 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13" />
    <char style="wj">“Ŋgʉəʼ ndəŋ bii bʉə-Kolasiŋ! Ŋgʉəʼ ndəŋ bii bʉə-Bɛsieda! Bʉʼka nufinəbə ndə bə kə fɔ̀ʼ mu bii, bə kʉ̌ʉ kə fɔ̀ʼ mu Taa ghɔŋ Sidɔŋ, təmə bɔ̂ŋ nɔʼ kə shìe liɛŋ ndəŋ bʉ̂ʼtə-ʉə lʉ̀ hə mbibɛʼ, nə ndyi-kəfʉəŋ-hə kùŋ bubə ndə mədʉ̀ʼ mbɔ bɔ̂ŋ la nɔʼ kɔ́ŋ lɛɛŋhəkə-ʉə, tɔ̀ŋ mu kyʉ.</char> <verse eid="LUK 10:13" /><verse number="14" style="v" sid="LUK 10:14" /><char style="wj">I bɔŋ bu yi bʉ̀ʉ tʉ bʉə-Taa ghɔŋbə bʉə-Sidɔŋ ndəŋ chî-kwɛʼ-fɛʼɛ-kə tə chàa ndə i bu bɛ tʉ bii.</char> <verse eid="LUK 10:14" /><verse number="15" style="v" sid="LUK 10:15" /><char style="wj">Bii bʉə-Kabanu, bə bɔŋ-bu-leʼ kóʼhə bii ghɔʼ mɛ? Bə bu shúʼhə bii mu viʼi.</char><verse eid="LUK 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16" />
    <char style="wj">“Wo ndə ɔ yʉ́ chu-yii, nɔ yʉ́ chu-ɔ. Wo ndə ɔ tɛ́ŋ bii, nɔ tɛ́ŋ mɔ, bɔŋ wo ndə ɔ tɛ́ŋ mɔ, nɔ tɛ́ŋ mbəŋ-ɛŋ ndə ɔ tə́ŋ mɔ.”</char><verse eid="LUK 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17" />Ndə mbi tʉʼ gɛ̀, bʉə-bīŋ njuɔ bûu nə wuŋ təkwiitia le, bʉ̀nə nə tʉʉjyu, ghɔ̀ŋ mbɔ, “Tie-yaʼ, lyʉʉhəbʉəbʉəbə nɔ buŋ bʉ́ʉnə haʼ bʉ́ʉnə ghɔ tʉ baʼa yie-a.”<verse eid="LUK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18" />Jiso bə̀ŋhə mbɔ, <char style="wj">“Mɔ nɔʼ kə nyíɛ ndə Sata gwù yuo nə ghʉəʼkə ndə leʼnə-wyuu-kə leʼnə le.</char> <verse eid="LUK 10:18" /><verse number="19" style="v" sid="LUK 10:19" /><char style="wj">Mɔ nɔʼ kɔ́ ghʉəʼkə tʉ bii, ndə bəkɔ bii tòʼ ndəŋ yɔhə ghɔŋbə bəŋɔŋ, bɔŋleʼ məghɔ́ʼ ghʉəʼ-Sata-kə, nubɛʼkə mə chìi bii fɛ.</char> <verse eid="LUK 10:19" /><verse number="20" style="v" sid="LUK 10:20" /><char style="wj">Kə bii mə sɛ́ʼ ŋgʉʼʉ mbɔ lyʉʉhəbʉəbʉəbə bʉ́ʉnə tʉ bii fɛ, b̈ii sɛ́ʼ bə mbɔ bə la nɔʼ nyɔ̀ʼ yietə-ii yuo.”</char><verse eid="LUK 10:20" /></para>
  <para style="s">Jiso gháaNyii ndə məkɔ́ ndɔ</para>
  <para style="r">(<ref loc="MAT 11:25-27">Matia 11:25-27</ref>; <ref loc="MAT 13:16-17">13:16-17</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21" />Ndʉʉ-ghɔ̄, LyʉʉhəNyiikə kɔ́ tʉʉjyu mu fyii Jiso ilə́ŋnə, ɔ ghɔ̀ŋ mbɔ, <char style="wj">“Mɔ nɔ kɔ́ ndɔ a Tie-ɔ, Tiekətʉ ndə a kie yuo ghɔŋbə chisêkə, mbɔ a nɔʼ lə̀ŋ nubə-ɔ̄ŋ kəghɔ-bʉə ndə bɔ̂ŋ kie mukətʉ súunə ghɔŋbə ndaa, kɛ̀ʼ tʉ vâambuɔ. Ɔŋ, Tie-ɔ, bʉʼka nɔ nə bɛ ŋkʉʉnə-tʉʉ-a mbɔ ï bɛ nɔ.</char><verse eid="LUK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22" />
    <char style="wj">“Tie-ɔ nɔʼ kɔ́ fɔbə inchəŋ tʉ mɔ, wo kaa ghɔ ndə ɔ kínə mbʉ Vaa fɛ yaʼkɛŋ mbʉ Tie, təmə wo bɔŋ bɛ ghɔ ndə ɔ kínə mbʉ Tie fɛ yaʼkɛŋ mbʉ Vaa, leʼnə wotəmiyɔŋ ndə mbʉ Vaa kʉ̀ʉ ndə məkɛ̀ʼ ɔ tʉ ɔŋ.”</char><verse eid="LUK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23" />Jiso kíahə ŋwɔŋ-ɛŋ, chùŋ tʉ vâafɔʼɔ-bi mbɔ, <char style="wj">“Biʼbə nɔ bɛ tʉ bʉə ndə bɔ̂ŋ nyíɛ nukə ndə b̈ii nyíɛ.</char> <verse eid="LUK 10:23" /><verse number="24" style="v" sid="LUK 10:24" /><char style="wj">Mɔ tʉʼ gìe nɔ bʉʼka mbɔ buŋmbi bʉəyʉkəŋgieNyii ghɔŋbə bəfɔŋ nɔ kə́ kʉ́ʉ ndə mənyíɛ nukə ndə b̈ii nyíɛ, təmə bɔŋ nyíɛ fɛ, kə́ kʉ́ʉ ndə məyʉ́ nukə ndə bii yʉ́, təmə bɔŋ yʉ́ fɛ.”</char><verse eid="LUK 10:24" /></para>
  <para style="s">Fɔŋ ŋkahəkwɛʼtəŋ Nyii</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25" />Kə nyíɛ, wo ndə ɔ kínə nuʼ-Mushi daa lɔ̀ hə sê ndə məmùutə Jiso, tíi ɔ mbɔ, “Chicha, mɔ kie ndə məchìi ka ndə məkie məchímbi təmə liʼ-i ghɔ fɛ?” <verse eid="LUK 10:25" /><verse number="26" style="v" sid="LUK 10:26" />Jiso bə̀ŋhə mbɔ, <char style="wj">“Bə nyɔ̀ʼ mbuka mu ŋwɔʼnə-nuʼ-Mushi? A tíi təka?”</char> <verse eid="LUK 10:26" /><verse number="27" style="v" sid="LUK 10:27" />Ɔ bə̀ŋhə ghɔ̀ŋ mbɔ, “Kʉ̀ʉ Nyii Tiekətʉ-a nə fyii-a inchəŋ, nə lyʉʉhəkə-a inchəŋ, nə ghʉəʼkə-a inchəŋ leʼnə ndaahə-a inchəŋ bɔŋleʼ kʉ̀ʉ wo-kətoʼ-a ndə a kʉ̀ʉ ŋwɔŋ-aŋ.” <verse eid="LUK 10:27" /><verse number="28" style="v" sid="LUK 10:28" />Jiso bə̀ŋhə mbɔ, <char style="wj">“A nɔ bə̀ŋhə i kʉ̀ʼnə, fɔ̀ʼ yɔ̄ŋ-yə, a bu chí mbi.”</char><verse eid="LUK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29" />Ndʉʉmɛ, mbʉ wo dàhə nuʼ kə́ kʉ́ʉ dʉ̀ʼ mbɔ ɔ la bɛ ndyʉndyʉ, bíʼtə tʉ Jiso mbɔ, “Wo-kətoʼ-ɔ bɛ nda?”<verse eid="LUK 10:29" /></para>
  <para style="s">Wo-jyujyu-Samalia</para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30" />Jiso bə̀ŋhə ndə fʉʼkənu, ghɔ̀ŋ mbɔ, <char style="wj">“Wo-Juubɛʼ nɔ nə bɛ ghɔ kə́ tòʼ fia lɔ̀ hə Jɛlosalɛŋ kə́ shíʼ gɛ̀ Jɛliko, bəlʉʼʉ shùɔ bʉə yá ɔ, shùɔ ndyihə-i, gwúu ɔ tə ɔ kə́ kʉ́ʉ kwú, bɔ̂ŋ mɛ̀ʼ ɔŋ sêfia.</char><verse eid="LUK 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 10:31" />
    <char style="wj">“Wofɛ̀ʼndɛŋNyiibɛʼ kə́ shíʼ gɛ̀ hə fia-ghɔ̄, kwɔnə kə́ tòʼ gwè fyú ndəŋ ɔŋ, kʉ̂ʉ nyíɛ ɔŋ bɛ̀nə tíŋ nə wi.</char> <verse eid="LUK 10:31" /><verse number="32" style="v" sid="LUK 10:32" /><char style="wj">Vaafɔ̀ʼbɛʼ mu njaafɛ̀ʼndɛŋNyii kə́ leʼ shíʼ gwè hə fia-ghɔ̄, kwɔnə fyú ndəŋ ɔŋ fia-ghɔ̄ bɛ̀nə haʼ bɛ̀nə.</char><verse eid="LUK 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 10:33" />
    <char style="wj">“Wo-Samaliabɛʼ kə́ gɛ̀ sêfia-ghɔ̄, kwɔnə fyú ndəŋ ɔŋ, tʉkə-i vyíi ndəŋ ɔŋ.</char> <verse eid="LUK 10:33" /><verse number="34" style="v" sid="LUK 10:34" /><char style="wj">Ɔ gɛ̀ mbʉə ɔ véʼ ŋgwomə ghɔŋ ndʉʼmə ndəŋ dyʉʼbə-i kɔ́ʼtə. Chɔ̀ʼhə ɔŋ dùʼhə ndəŋ jakashi-i, gɛ̀ nə nɔŋ mu njaa ndə bə lɔ̀ʼ chí chɔ, kə́ lɛ́nə ɔŋ.</char> <verse eid="LUK 10:34" /><verse number="35" style="v" sid="LUK 10:35" /><char style="wj">Mbi kʉ̂ʉ sɛŋ fíi, ɔ fyúhə kyʉə, kɔ́ tʉ wo ndə ɔ tʉʼ fɔ̀ʼ mu njaa-ghɔ̄ mbɔ ɔ chʉʼ shi kə́ lɛ́nə ɔŋ. Shyíi ɔ mbɔ, ‘Kaʼ i shi tə́ʼ, mɔ yi kə bʉ̀nə mɔ bìʼ.’ ”</char><verse eid="LUK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36" />Jiso ndə məlìʼ chəŋkə-ɔ̄ŋ bíʼtə mbɔ, <char style="wj">“Mu bʉə-bɔ̄ŋ bətia nɔ, bɛ nda ndə ɔ fɔ̀ʼ ndə wo-kətoʼ-wo-ɔ̄, ndə bəlʉʼʉ shùɔ bʉə gwúu ɔ le?”</char><verse eid="LUK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37" />Wo-ghɔ̄ bə̀ŋhə mbɔ, “Nɔ bɛ wo ndə ɔ dʉ̀ʼ tʉvyiikə tʉ ɔŋ.”</para>
  <para style="p" vid="LUK 10:37">Jiso ghɔ̀ŋ mbɔ, <char style="wj">“Gɛ̀ kə́ fɔ̀ʼ haʼ nɔ.”</char><figure style="fig" alt="The Good Samaritan" file="DN00479b.tif" size="col" copy="Darwin Dunham" ref="10:37">Wo buuŋjyu Samalia</figure><verse eid="LUK 10:37" /></para>
  <para style="s">Fu-bəMata ghɔŋbə Mɛli</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38" />Ndə Jiso tʉʼ gɛ̀ hə sêfia ghɔŋ vâafɔʼɔ-bi, ɔ gɛ̀ dàa lɔʼɔbɛʼ ndə wokebɛʼ bɛ chɔ yie-e kə́ bɛ Mata, mbʉ woke-ghɔ̄ kɔ̀ʼnə ɔŋ chunjaa-ɔ. <verse eid="LUK 10:38" /><verse number="39" style="v" sid="LUK 10:39" />Ɔ nɔ kə kie liŋ-iŋbɛʼ bə kə́ tíi ɔ nə Mɛli. Mɛli gwè shíʼ dùʼ sê bəshʉ Tiekətʉ kə́ yʉ́ nukə ndə ɔ tʉʼ gìe. <verse eid="LUK 10:39" /><verse number="40" style="v" sid="LUK 10:40" />Nu-bəfɔ-kə ndə Mata kə́ chìi kə́ chɔ́ŋhə ɔŋ. Ɔ gɛ̀ tʉ Jiso ghɔ̀ŋ tʉ ɔŋ mbɔ, “Tiekətʉ, a tʉʼ nyíɛ ndə liŋ-ɔŋ mɛ̀ʼtə fɔbə kətʉ-mɔ tətɛʼ mɔ fe? Téʼ tʉ ɔŋ, ɔ̈ kwáa mɔ.” <verse eid="LUK 10:40" /><verse number="41" style="v" sid="LUK 10:41" />Tiekətʉ bə̀ŋhə mbɔ, <char style="wj">“Mata, Mata, mu fyii-a tʉʼ chɔ́ŋhə aŋ, kə́ kɔ́ ŋgʉəʼ tʉ a ndə nubə buŋmbi.</char> <verse eid="LUK 10:41" /><verse number="42" style="v" sid="LUK 10:42" /><char style="wj">Nɔ bɛ haʼ mbyu kənu imɔʼ ndə a kie ndə məkɔ́ fyii-a chɔ. Mɛli nɔʼ séʼ nu-jyujyu-kə, təmə bə kʉʉnə fí hə kəghɔ ɔ fɛ.”</char><verse eid="LUK 10:42" /></para>
  <chapter eid="LUK 10" />
  <chapter number="11" style="c" sid="LUK 11" />
  <para style="s">Jiso kə́ dàhə məgháaNyii</para>
  <para style="r">(<ref loc="MAT 6:9-13">Matia 6:9-13</ref>; <ref loc="MAT 7:7-11">7:7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1" />Yɔŋbɛʼ, Jiso kə́ gháaNyii kəyəŋbɛʼ, kʉ̂ʉ liʼ, mbyu vaafɔ̀ʼ-ɛ gìe tʉ ɔŋ mbɔ, “Tiekətʉ-yaʼ, dàhə baʼa ndə məgháaNyii haʼ ndə Jɔŋ kə dàhə vâafɔʼɔ-bi le.”<verse eid="LUK 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2" />Ɔ gìe tʉ bɔŋ mbɔ, <char style="wj">“Kaʼ bii kə́ gháaNyii, b̈ii ghɔ̀ŋ mbɔ,</char></para>
  <para style="b" vid="LUK 11:2" />
  <para style="q1" vid="LUK 11:2">
    <char style="wj">‘Tie-yaʼ ndə a bɛ yuo, tə bə kóʼhə yie-a ndə i bɛ ŋkʉʉ ghɔʼ,</char></para>
  <para style="q2" vid="LUK 11:2">
    <char style="wj">baʼa tʉʼ gháa a mbɔ, n̈dʉʉ gwè ndə a bu sɔ́ʼ bʉə bənchəŋ ndə fɔŋ.</char><verse eid="LUK 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3" />
    <char style="wj">Baʼa tʉʼ gháa mbɔ, tə a kɔ́ baʼa nə fɔyubə ndə baʼa kie ndə məyú, ndəŋ chîmbikə təmiyɔŋ.</char><verse eid="LUK 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4" />
    <char style="wj">Bɔŋleʼ sʉ̀fyii-a ndəŋ bʉ̂ʼtə-aʼ,</char></para>
  <para style="q2" vid="LUK 11:4">
    <char style="wj">bʉʼka mbɔ, baʼa nɔʼ sʉ̀fyiihə-aʼ ndəŋ bʉ̂ʼtə ndə bəbɛʼbʉə chìi tʉ baʼa.</char></para>
  <para style="q1" vid="LUK 11:4">
    <char style="wj">Kə a mə mɛ̀ʼtə baʼa gwù mu nubə ndə bəkɔ i chìi baʼa chìi bʉ̂ʼʉ fɛ.’ ”</char><verse eid="LUK 11:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5" />Ndʉʉmɛ, ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Kaʼ mbyu wo mu bii kie tieŋkɔŋ-ɛŋ, gɛ̀ kwɔ̀ŋ njaa-tieŋkɔŋ-ɛŋ-ghɔ̄ ndʉʉkwɔnəmbi, ghɔ̀ŋ tʉ ɔŋ mbɔ, ‘Tieŋkɔŋ, chɔ́ʼhə mɔ nə mbyu-bele-hə itia,</char> <verse eid="LUK 11:5" /><verse number="6" style="v" sid="LUK 11:6" /><char style="wj">bʉʼka tieŋkɔŋ-ɔŋ ndə ɔ lɔ̀ hə dɔdɔ nɔʼ gwè mətòʼ tʉ mɔ, təmə mɔ kie fɔkə ndə mətía ɔ chɔ fɛ.’</char> <verse eid="LUK 11:6" /><verse number="7" style="v" sid="LUK 11:7" /><char style="wj">Ɔ bə̀ŋhə mu njaa mbɔ, ‘Kə a mə leʼ chɔ́ŋhə mɔ fɛ. Mɔ nɔʼ fʉ̀əŋ njaa, baʼabə vâa-bɔŋ, bɔŋ kə́ nʉ̀ʉ mɔ̀ʼ ndəŋ kəbɔ. Mɔ mə lɔ̀ hə sê kɔ́ fɔkə tʉ a fɛ.’</char> <verse eid="LUK 11:7" /><verse number="8" style="v" sid="LUK 11:8" /><char style="wj">M̈ɔ shyíi bii mbɔ kaʼ ɔ gòʼ təmə lɔ̀ hə sê kɔ́ fɔkə tʉ ɔŋ, bʉʼka mbɔ ɔ bɛ tieŋkɔŋ-ɛŋ fɛ, ɔ yi lɔ̀ bʉʼka məchɔ́ŋhə ndə ɔ tʉʼ chɔ́ŋhə ɔŋ, kɔ́ fɔbə inchəŋ ndə ɔ tʉʼ byúu.</char><verse eid="LUK 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9" />
    <char style="wj">“Nɔʼ m̈ɔ gìe tʉ bii mbɔ b̈ii bíʼtə bə bu kɔ́ tʉ bii, b̈ii kʉ́ʉ, bii bu nyíɛ, b̈ii kwɔ̀ŋ, bə bu ŋɔ́ʼhə chusii tʉ bii.</char> <verse eid="LUK 11:9" /><verse number="10" style="v" sid="LUK 11:10" /><char style="wj">Bʉʼka w̃otəmiyɔŋ ndə ɔ bíʼtə nɔ kie, w̃o ndə ɔ kʉ́ʉ kə́ nyíɛ, bɔŋ w̃o ndə ɔ leʼ kwɔ̀ŋ bə bu ŋɔ́ʼhə chusii tʉ ɔŋ.</char><verse eid="LUK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 11:11" />
    <char style="wj">“Bɛ nda mu bii bətie-vâa, ndə kaʼ vaa-a bíʼtə mbɔʼ mu muu tʉ a, a kɔ́ yɔ tʉ ɔŋ?</char> <verse eid="LUK 11:11" /><verse number="12" style="v" sid="LUK 11:12" /><char style="wj">Byuunɔ, kaʼ ɔ bíʼtə ghəŋ, a kɔ́ bə ŋɔŋ tʉ ɔŋ? Mɔ laa fɛ.</char> <verse eid="LUK 11:12" /><verse number="13" style="v" sid="LUK 11:13" /><char style="wj">Kaʼ mbəŋ-yii ndʉʉmɛ, ndə bii bɛ bʉə-bʉ̂ʼʉ, kínə məkɔ́ yʉʼ kəkɔ tʉ vâa-bii, ndʉʉmɛ i kɛŋ dʉ̀ʼ mbɔ Tie-yii ndə ɔ bɛ yuo bu kɔ́ LyʉʉhəNyiikə tʉ bʉə ndə bɔ̂ŋ bíʼtə tʉ ɔŋ!”</char><verse eid="LUK 11:13" /></para>
  <para style="s">Jiso ghɔŋ Bɛsɛbu</para>
  <para style="r">(<ref loc="MAT 12:22-30">Matia 12:22-30</ref>,<ref loc="MAT 12:43-45">43-45</ref>; <ref loc="MRK 3:20-27">Mak 3:20-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14" />Chibɛʼkə, Jiso jə̀ŋ lyʉʉhəbʉəbʉəkə ndə ɔ bɛ mu wobɛʼ ndə ɔ bɛ chie. Ndʉʉ ndə mbʉ kəlyʉʉhəbʉəbʉə mɛ̀ʼtə wo-ghɔ̄, ɔ kwə́ʼ, i chíe chu bʉə. <verse eid="LUK 11:14" /><verse number="15" style="v" sid="LUK 11:15" />Bəbɛʼbʉə ghɔ̀ŋ mbɔ, “Ɔ nɔ tʉʼ jə̀ŋ nə ghʉəʼ-Bɛsɛbu-kə<note caller="+" style="f"><char style="fr" closed="false">11:15 </char><char style="ft" closed="false">Bɛsɛbu nɔ bɛ ibɛʼ-yə yie Sata.</char></note>, mbʉ fɔŋ-bəlyʉʉhəbʉəbʉə.” <verse eid="LUK 11:15" /><verse number="16" style="v" sid="LUK 11:16" />Bəbɛʼbʉə ghɔ̀ŋ tʉ ɔŋ mbɔ ɔ̈ chìi nukəcheʼkə ndə i lɔ̀ hə kəghɔ-Nyii b̈ɔ̂ŋ nyíɛ, kə́ kʉ́ʉ ndə məmùutə ɔŋ.<verse eid="LUK 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 11:17" />Jiso kə́ kínə nukə ndə bɔ̂ŋ kə́ kwɔ̀ʼtə ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Lɔʼɔ kətə̂ŋ təmiyɔŋ ndə bɔ̂ŋ gyʉ̀əhə ŋwɔŋ-yʉə tənuɔtənuɔ kə́ gwúu byuʼu nə ŋwɔŋtə-ʉə bu nʉ̀ʉ fuŋ, bɔŋ chufu ndə bɔ̂ŋ leʼ dùʼ nə gyʉʉ-buubuu-hə bu gwù.</char> <verse eid="LUK 11:17" /><verse number="18" style="v" sid="LUK 11:18" /><char style="wj">Kaʼ Sata kə́ bʉ̀nə shùɔ shʉ-i nə mbəŋ-ɛŋ, lɔʼɔ-ɛ tə́nə təka? Mɔ nɔ tʉʼ ghɔ̀ŋ yɔ̄ŋ-yə, bʉʼka mbɔ bii nɔ tʉʼ ghɔ̀ŋ mbɔ mɔ la tʉʼ jə̀ŋ lyʉʉhəbʉəbʉəbə nə ghʉəʼ-Bɛsɛbu-kə.</char> <verse eid="LUK 11:18" /><verse number="19" style="v" sid="LUK 11:19" /><char style="wj">Kaʼ mɔ kə́ jə̀ŋ lyʉʉhəbʉəbʉəbə nə ghʉəʼ-Bɛsɛbu-kə, bʉə-bii jə̀ŋ bɔŋ nə ka? Ndʉʉghɔfii, bʉə-bii bu dʉ̀ʼ mbɔ bii nɔʼ mɔ̀ʼ bɛ́.</char> <verse eid="LUK 11:19" /><verse number="20" style="v" sid="LUK 11:20" /><char style="wj">Bɔŋ kaʼ mɔ kə́ jə̀ŋ lyʉʉhəbʉəbʉəbə nə ghʉəʼ-Nyii-kə, təmə i nɔ dʉ̀ʼ mbɔ Sɔ́ʼ-Nyii nɔʼ gwè mu bii.</char> <verse eid="LUK 11:20" /><verse number="21" style="v" sid="LUK 11:21" /><char style="wj">Kaʼ wo shʉ́əshʉ́ə ndə Sata, ndə ɔ nɔʼ shʉ̀tə ŋwɔŋ-ɛŋ, kə́ chyìi fu-i, fɔbə-i mə nə bɛ́ fɛ.</char> <verse eid="LUK 11:21" /><verse number="22" style="v" sid="LUK 11:22" /><char style="wj">Bɔŋ kaʼ wo ndə ɔ shʉ́ə chàa ɔ ŋíi ɔŋ, tə ghɔ́ʼ ɔ, ɔ fí fɔ-chɔ̂-bə-i ndə ɔ kə yʉ́əʼnə chɔ, gyʉ̀ə mbʉ bəfɔ ndə ɔ fí kəghɔ-ɔ.</char><verse eid="LUK 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23" />
    <char style="wj">“Wotəmiyɔŋ ndə ɔ gòʼ təmə bɛ tʉ mɔ fɛ, nɔ bɛ wobàa-ɔ, bɔŋ wo ndə ɔ gòʼ təmə leʼ kə́ chə̀ŋtə baʼa ɔ fɛ, nɔ tʉʼ wɔ̀ʼhəwɔ̀ʼhə.”</char><verse eid="LUK 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24" />Jiso kə́ bíe kwə́ʼ ghɔ̀ŋ mbɔ, <char style="wj">“Ndʉʉ ndə l̃yʉʉhəbʉəbʉəkə fyú hə mu mbʉə wo nɔ, ɔ kə́ tòʼ kwɔŋkəyəŋnə, kə́ tòʼ kʉ́ʉ yəŋkə ndə məkáa chɔ, kʉ̂ʉ gòʼ təmə nyíɛ fɛ nɔ, ghɔ̀ŋ tʉ ŋwɔŋ-ɛŋ mbɔ, ‘Mɔ bu bʉ̀nə gɛ̀ mu njaa-mɔ ndə mɔ kə lɔ̀ hə chɔ.’</char> <verse eid="LUK 11:24" /><verse number="25" style="v" sid="LUK 11:25" /><char style="wj">Ndʉʉ ndə ɔ bʉ̀nə gwè nyíɛ mbʉ njaa tʉ bə nɔʼ yʉ̀əʼ mu-i, shʉ̀tə fɔbə tʉ́ʼtə,</char> <verse eid="LUK 11:25" /><verse number="26" style="v" sid="LUK 11:26" /><char style="wj">ndʉʉmɛ, ɔ gɛ̀ lʉ̀ bəbɛʼlyʉʉhəbʉəbʉəbə təkwiitia ndə buŋtə-ʉə byʉ́ʼ chàa yi-yə, ghɔŋ bɔŋ gwè sʉ́ʉ kə́ chí chɔ, kə lìʼtə, məchimbi-wo-ghɔ̄ byʉ́ʼ tə chàa ndə i kə fəŋ bɛ.”</char><verse eid="LUK 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27" />Ndə Jiso kə́ gìe nubə-ɔ̄ŋ, wokebɛʼ tíi hə mu bʉə ghɔ̀ŋ mbɔ, “Naa-aŋ nɔ bɛ wo kətʉjyu, tɔbə ndə a hə fyú chɔ, leʼnə ŋwɔ̂ŋ ndə a nyúu.”<verse eid="LUK 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28" />Jiso bə̀ŋhə mbɔ, <char style="wj">“Fɔŋ kətʉjyu nɔ bɛ tʉ wo ndə ɔ yʉ́ ŋgieNyiikə tə́nə chɔ.”</char><verse eid="LUK 11:28" /></para>
  <para style="s">Cheʼ-Jona-kə</para>
  <para style="r">(<ref loc="MAT 12:38-42">Matia 12:38-42</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29" />Ndə bʉə kə́ yɔ́ŋ gwè, Jiso ghɔ̀ŋ mbɔ, <char style="wj">“Ŋgwie wo-ɔ̄ nɔ ŋgwie-bʉ̂ʼʉ kə́ kʉ́ʉ cheʼkə, bɔŋ təmə bə kʉʉ dʉ̀ʼ cheʼkə tʉ bɔŋ fɛ, yaʼkɛŋ haʼ cheʼ-Jona-kə.</char> <verse eid="LUK 11:29" /><verse number="30" style="v" sid="LUK 11:30" /><char style="wj">Ndə Jona kə bɛ cheʼkə tʉ bʉə-Ninɛvi, nɔ bɛ haʼ nɔ ndə Vaa-Woməsʉʉ bu bɛ tʉ yɔ̄ŋ-yə ŋgwie.</char><verse eid="LUK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 11:31" />
    <char style="wj">“Wontoʼ ndə ɔ lɔ̀ hə Byûumbɔŋ bu lɔ̀ tə́nə mu njaafɛ̀ʼ ghɔŋbə ŋgwie-wo-ɔ̄, ghɔ̀ŋ mbɔ bɔ̂ŋ nɔʼ gwù fɛʼɛ, bʉʼka ɔ nɔ nə lɔ̀ hə liʼ-mbi, gwè ndə məyʉ́ mukətʉ-súunə ndə Salamu kə kie, bɔŋ b̈ii nyíɛ, wo nɔ bɛ fɛ̄ŋ ndə ɔ gʉ́ə chàa Salamu.</char> <verse eid="LUK 11:31" /><verse number="32" style="v" sid="LUK 11:32" /><char style="wj">Bʉə-Ninɛvi bu lɔ̀ tə́nə ndəŋ chî-kwɛ̀-fɛʼɛ-kə ghɔŋbə ŋgwie-wo-ɔ̄, ghɔ̀ŋ mbɔ bɔŋ la nɔʼ gwù fɛʼɛ bʉʼka mbəŋ-yʉə bʉə-Ninɛvi nɔ nə shìe liɛŋ ndəŋ bʉ̂ʼtə-ʉə, ndʉʉ ndə Jona kə lɔ̀ʼ ŋgieNyiikə tʉ bɔŋ, bɔŋ b̈ii nyíɛ, wo nɔ bɛ fɛ̄ŋ ndə ɔ gʉ́ə chàa Jona.</char><verse eid="LUK 11:32" /></para>
  <para style="s">Kɛʼɛ-mbʉə</para>
  <para style="r">(<ref loc="MAT 5:15">Matia 5:15</ref>; <ref loc="MAT 6:22-23">6:22-23</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33" />
    <char style="wj">“Wo kə chúʼ kɛʼɛ, mɔ̀ʼ kəyəŋ-bəliinə fɛ, byuunɔ kwóhə shyiikə ndəŋ ghɔ fɛ. Ɔ chɔ̀ʼhə mɔ̀ʼ ndəŋ kəfɔ kə mbɔ bʉə ndə bɔ̂ŋ tʉʼ sʉ́ʉ mu njaa, bu nyíɛ məbáa-ɛ.</char> <verse eid="LUK 11:33" /><verse number="34" style="v" sid="LUK 11:34" /><char style="wj">Shʉ-a nɔ bɛ kɛʼɛ-mbʉə-a, haʼ ndə kɛʼɛ kɛ̀ʼ yəŋbə nɔ. Kaʼ shʉ-a bɛ jyujyu, i kɛ̀ʼ mbʉə-a inchəŋ, bɔŋ kaʼ i bɛ bʉəbʉə, mbʉə-a inchəŋ bɛ kənjəŋ.</char> <verse eid="LUK 11:34" /><verse number="35" style="v" sid="LUK 11:35" /><char style="wj">B̈ii láa le mbɔ fɔkə ndə a kwɔ̀ʼtə mbɔ bɛ kɛʼɛ mu mbʉə-a ndə bɛ shʉəŋ-Nyii, mə bʉ̀nə bɛ njəŋkə fɛ.</char> <verse eid="LUK 11:35" /><verse number="36" style="v" sid="LUK 11:36" /><char style="wj">Kaʼ a kínə shʉəŋ-Nyii gɛ̀ kùu təmə mɔ̀ʼmbɛ bɛ mu ŋkwɔʼtə-a fɛ, ndʉʉmɛ, i bɛ fi nə mbʉə-a nchəŋnchəŋ-ɛŋ tʉʼ báa, nə wo ndə kɛʼɛ tʉʼ báa ndəŋ ɔŋ.”</char><verse eid="LUK 11:36" /></para>
  <para style="s">Nchɛŋhə ntʉʼʉ</para>
  <para style="r">(<ref loc="MAT 23:1-36">Matia 23:1-36</ref>; <ref loc="MRK 12:38-40">Mak 12:38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37" />Jiso kʉ̂ʉ kwə́ʼ liʼ, wo-Falasibɛʼ kɔ̀ʼnə ɔŋ mbɔ ɔ̈ gwè ghɔŋ ɔŋ yú fɔbə. Ɔ ŋíi mu njaa ghɔŋ ɔŋ, dùʼ mbʉə tebele. <verse eid="LUK 11:37" /><verse number="38" style="v" sid="LUK 11:38" />Mbʉ wo-Falasi kʉ̂ʉ nyíɛ ndə Jiso tʉʼ yú fɔbə təmə nɔʼ fəŋ sʉ̀ ghɔkə-i fɛ, i chàa ɔ daa. <verse eid="LUK 11:38" /><verse number="39" style="v" sid="LUK 11:39" />Ndʉʉmɛ, Tiekətʉ ghɔ̀ŋ mbɔ, <char style="wj">“Bii bʉə-Falasi, b̃ii nɔ sʉ̀ ndʉ̂ʉ ghɔŋ baŋ njəŋmbi, bɔŋ muŋgɔ bii kə́ bɛ ilə́ŋnə nə ntɔmə ghɔŋbə buuŋbʉə.</char> <verse eid="LUK 11:39" /><verse number="40" style="v" sid="LUK 11:40" /><char style="wj">Bii bənɔ̌ʼɔ-bɔ̄ŋ! Wo ndə ɔ chìi mu-i, chìi haʼ ɔ chìi njəŋmbi fe?</char> <verse eid="LUK 11:40" /><verse number="41" style="v" sid="LUK 11:41" /><char style="wj">Sʉ̀ mu baŋ ndə məkɔ́ fɔkə ndə i bɛ muŋgɔ tʉ wo mbʉʼ, nubə bu bɛ tʉ a itʉ́ʉnə.</char><verse eid="LUK 11:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42" />
    <char style="wj">“Ŋgʉəʼ kətʉ-bii, bʉə-Falasi. Bii nɔ chìi i kʉ̀ʼnə ndə məgyʉ̀əhə fɔbə-i ndəŋ yəŋbə wuŋ, bii kɔ́ yəŋkə imɔʼ tʉ Nyii. Bii nɔ tʉʼ kɔ́ vaabəfɔ nùʼ mbɔʼ, kɔ́ tʉ kɔ́ fyuŋ-nchyiinchyii-bə tʉ Nyii, təmə bii bɔŋ kə́ fɔ̀ʼ nubə ndə i kʉ̀ʼnə tʉ bəbɛʼbʉə fɛ, təmə bɔŋleʼ kʉ̀ʉ Nyii ghɔ fɛ. Bii nɔ kə kə́ kʉ̌ʉ kə́ fɔ̀ʼ nubə-ɔ̄ŋ təmə mɛ̀ʼtə bəbɛʼbə fɛ.</char><verse eid="LUK 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43" />
    <char style="wj">“Ŋgʉəʼ kətʉ-bii, bʉə-Falasi, bʉʼka mbɔ bii nɔ tʉʼ kʉ́ʉ fɔŋkwɛʼtəŋbə mu njaagháaNyii ndə mədùʼ chɔ, kə́ kʉ́ʉ mbɔ b̈ə kə́ bʉ́ʉnə tʉ bii ndə yəŋ-vyii-bə.</char> <verse eid="LUK 11:43" /><verse number="44" style="v" sid="LUK 11:44" /><char style="wj">Ŋgʉəʼ kətʉ-bii, bii nɔ bɛ nə sětə ndə bə gòʼ təmə kə́ nyíɛ fɛ. Bə kə́ tòʼ ndəŋ ghɔ təmə kínə mbɔ fɔ-fɛ̀-bə bɛ muŋgɔ fɛ.”</char><verse eid="LUK 11:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45" />Mbyu wobɛʼ ndə ɔ kínə nuʼ-Mushi daa bə̀ŋhə tʉ ɔŋ mbɔ, “Chicha, a tʉʼ gìe nubə-ɔŋ nɔ kə́ chɛ̀ŋ baʼa chɛ̀ŋ ghɔ.”<verse eid="LUK 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46" />Jiso bə̀ŋhə mbɔ, <char style="wj">“Bii ndə bii kínə nuʼ-Mushi daa, tə ŋgʉəʼ bɛ ndəŋ bii bʉʼka mbɔ bii nɔ tʉʼ kóʼhə bɛʼkə ndəŋ bʉə ndə i chàa bɔŋ ndə məbɛ̀ʼ, bɔŋ təmə bii mə ŋɛ̀hə ŋwɔŋ-yii ndə məkwáa bɔŋ fɛ.</char> <verse eid="LUK 11:46" /><verse number="47" style="v" sid="LUK 11:47" /><char style="wj">Ŋgʉəʼ kətʉ-bii bʉʼka bii nɔ tʉʼ bɔŋ sě-bʉəyʉkəŋgieNyii-tə ndə bətietie-bii nə yítə bɔŋ.</char> <verse eid="LUK 11:47" /><verse number="48" style="v" sid="LUK 11:48" /><char style="wj">I nɔ tʉʼ dʉ̀ʼ mbɔ, bii nɔ bɛ́ŋ nukə ndə bətietie-bii nə chìi. Bɔ̂ŋ yítə bʉəyʉkəŋgieNyii, bii bɔ́ŋ sětə-ʉə.</char> <verse eid="LUK 11:48" /><verse number="49" style="v" sid="LUK 11:49" /><char style="wj">Bʉʼka yɔ̄ŋ-yə, Nyii nə ndaa-ɛ, ghɔ̀ŋ mbɔ, ‘Mɔ bu tə́ŋ bʉəyʉkəŋgieNyii ghɔŋbə bəlɔntəŋNyii mbɔ, bii yítə bəbɛʼbə, chɔ́ŋhə bəbɛʼbə.’</char><verse eid="LUK 11:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 11:50" />
    <char style="wj">“Bʉʼka yɔ̄ŋ-yə, ŋgwie-wo-ɔ̄ bu lɔ̀ʼ fɔbʉə-bʉəyʉkəŋgieNyii-kə ndə i nɔʼ kə fyú, lʉ̀ hə ndəŋ ŋgwunə-mbi,</char> <verse eid="LUK 11:50" /><verse number="51" style="v" sid="LUK 11:51" /><char style="wj">lʉ̀ hə ndəŋ fɔbʉə-Abɛ-kə tə gɛ̀ dàa ndə fɔbʉə-Sakalia-kə ndə bə kə yí ɔ ntəŋntəŋ kəyəŋfɛ̀ʼndɛŋNyii ghɔŋ njaafɛ̀ʼndɛŋNyii. Ɔŋ! Nɔʼ m̈ɔ shyíi bii, ŋgwie-wo-ɔ̄ bu lɔ̀ʼ nubə-ɔ̄ŋ inchəŋ.</char><verse eid="LUK 11:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52" />
    <char style="wj">“Ŋgʉəʼ kətʉ-bii, ndə bii kínə nuʼ-Mushi jyujyu bʉʼka bii nɔʼ lʉ̀ nchoʼ-ndaa-kə lə̀ŋ. Bii nə mbəŋ-yii, bii tʉʼ ŋíi fɛ, bɔŋ kə́ chíe fia kəghɔ-bʉə ndə bɔ̂ŋ tʉʼ ŋíi.”</char><verse eid="LUK 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53" />Ndʉʉ ndə Jiso kə lɔ̀, bʉə-Falasi ghɔŋbə bʉə dàhə nuʼ-Mushi chʉ́ʉhə kə́ dʉ̀ʼ chu-i shʉ́əshʉ́ə bɔŋleʼ kə́ bíʼtə nu-shʉ́əshʉ́ə-bə tʉ ɔŋ, <verse eid="LUK 11:53" /><verse number="54" style="v" sid="LUK 11:54" />kə́ chyìi ndə məyá ɔ ndə nukə ndə ɔ bu gìe.<verse eid="LUK 11:54" /></para>
  <chapter eid="LUK 11" />
  <chapter number="12" style="c" sid="LUK 12" />
  <para style="s">B̈ii láa mənaa</para>
  <para style="r">(<ref loc="MAT 10:26-33">Matia 10:26-33</ref>; <ref loc="MAT 12:32">12:32</ref>; <ref loc="MAT 10:19-20">10:19-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1" />Haʼ ndʉʉ-ghɔ̄, nuɔ-bʉə-buŋmbi tə gɛ̀ ŋkɔŋŋkɔŋhə nɔʼ chə̀ŋ yɔ́ŋ tə kə́ chúʼtə wu-bəbɛʼbʉə-bə. Jiso chʉ́ʉhə fəŋ kə́ kwə́ʼ tʉ vâafɔʼɔ-bi ghɔ̀ŋ mbɔ, <char style="wj">“B̈ii láa te yî-bʉə-Falasi ndə i bɛ mənaa, i mə ŋíi mu bii fɛ.</char> <verse eid="LUK 12:1" /><verse number="2" style="v" sid="LUK 12:2" /><char style="wj">Nubɛʼkə kaa ghɔ, ndə bə bɔŋ, ndə i bu yi gòʼ təmə kɛ̀ʼnə fɛ, byuunɔ ndə i tʉʼ líi təmə bə bu nə kínə fɛ.</char> <verse eid="LUK 12:2" /><verse number="3" style="v" sid="LUK 12:3" /><char style="wj">Nukə ndə a gìe mu kənjəŋ bə bu yʉ́ ntaa ndʉʉnəchî, nukə ndə a chùŋ kətyunə wo mu kəntoʼ, bə bu tə́nə kətʉ njaa buŋ lɔ̀ʼ.</char><verse eid="LUK 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4" />
    <char style="wj">“B̈ii yʉ́ bətieŋkɔŋ-bɔŋ, kə bii mə kə́ fàa bʉə ndə bəkɔ bɔ̂ŋ yí ŋkwê mbʉə-yii, təmə mə leʼ chìi nubɛʼkə ndə i chàa maa-yɔ̄ŋ fɛ.</char> <verse eid="LUK 12:4" /><verse number="5" style="v" sid="LUK 12:5" /><char style="wj">Mɔ bɔŋ bu dʉ̀ʼ wo tʉ bii ndə bii kie ndə məfàa ɔ. B̈ii fàa ɔ, ndə kaʼ ɔ yí ŋkwê mbʉə-a, ɔ kie ghʉəʼkə ndə məkɔ́ mu viʼi. Ɔŋ! B̈ii fàa ɔ.</char><verse eid="LUK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 12:6" />
    <char style="wj">“Bə tʉʼ fɛ̀ŋ bəghuunə itaa ndə kabaa ibûu fe? Təmə Nyii bɔŋ mə nə lèʼnə wofuu fɛ.</char> <verse eid="LUK 12:6" /><verse number="7" style="v" sid="LUK 12:7" /><char style="wj">Ndə ŋgie-shʉəŋ-kə, bə nɔʼ buŋ súu nyu-kətʉ-hə-ii inchəŋ. Kə bii mə kə́ fàa ndʉʉmɛ fɛ, bii nɔ gʉ́ə shʉ-ɔ chàa bəghuunə buŋmbi.</char><verse eid="LUK 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8" />
    <char style="wj">“B̈ii yʉ́, wotəmiyɔŋ ndə ɔ kwɛ̀ŋ fyii-i te mɔ bəshʉ bʉəməsʉʉ mbɔ ɔ bɛ vaafɔ̀ʼ-ɔ, Vaa-Woməsʉʉ bu kwɛ̀ŋ fyii-i bəshʉ bʉəntəŋNyii ghɔ mbɔ ɔ la bɛ vaafɔ̀ʼ-ɛ.</char> <verse eid="LUK 12:8" /><verse number="9" style="v" sid="LUK 12:9" /><char style="wj">Bɔŋ wo ndə ɔ tɛ́ŋ mɔ bəshʉ bʉəməsʉʉ, bə bu tɛ́ŋ ɔŋ ghɔ bəshʉ bʉəntəŋNyii.</char> <verse eid="LUK 12:9" /><verse number="10" style="v" sid="LUK 12:10" /><char style="wj">Wotəmiyɔŋ ndə ɔ bʉ́əhə yie Vaa-Woməsʉʉ, bə bu sʉ̀fyii hə ndəŋ bʉ̂ʼʉ-e, bɔŋ wo ndə ɔ bʉ́əhə yie-kəLyʉʉhəNyii, bə kʉʉ sʉ̀fyii hə ndəŋ bʉ̂ʼʉ-e fɛ.</char><verse eid="LUK 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11" />
    <char style="wj">“Kaʼ bə yá bii gɛ̀ nə bii mu njaagháaNyii tʉ bəntəŋbəshʉ, ghɔŋbə bʉəkwɛʼtəŋ, kə bii mə lə̀ŋnə ndə nukə ndə bii bu chìi buŋ fí ŋwɔŋ-yii hə kəghɔ-bɔŋ fɛ, byuunɔ nukə ndə bii bu gìe fɛ,</char> <verse eid="LUK 12:11" /><verse number="12" style="v" sid="LUK 12:12" /><char style="wj">bʉʼka mbɔ LyʉʉhəNyiikə bu dàhə bii ndʉʉ-ghɔ̄ nə nukə ndə bii bu gìe.”</char><verse eid="LUK 12:12" /></para>
  <para style="s">Chəŋ-nɔ̌ʼ-wo-kəfʉʼ-kə</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13" />Wobɛʼ ndə ɔ kə bɛ mu bʉə tíi ɔ mbɔ, “Chicha, téʼ tʉ liŋ-ɔŋ mbɔ ɔ̈ gyʉ̀ə fɔ-tie-yaʼ-ɔ-bə, kɔ́ yɔŋ-yə.”<verse eid="LUK 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14" />Jiso bə̀ŋhə mbɔ, <char style="wj">“Woləŋ, tʉ́ʼ nda tʉ́ʼ mɔ ndə wo-chʉ̀ə-ŋkwɛ-yii, ghɔŋbə mə-kə́-gyʉ̀ə fɔbə-ii?”</char> <verse eid="LUK 12:14" /><verse number="15" style="v" sid="LUK 12:15" />Ndʉʉmɛ, ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“B̈ii láa! B̈ii láa jyujyu bʉʼka mə-kə́-tʉ́ʼ shʉ-yii ndəŋ fɔ-wo-kədɔŋ-bə. Məchimbi-woməsʉʉ kaa mə kie fʉʼ-yɔ́ŋyɔ́ŋ-kə fɛ.”</char><verse eid="LUK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16" />Ndʉʉmɛ, ɔ mɔ̀ʼ chəŋkə-ɔ̄ŋ tʉ bɔŋ mbɔ, <char style="wj">“Mutɔ-wo-kəfʉʼbɛʼ nɔ nə kʉ́ʉnə ntɔŋmə buŋmbi.</char> <verse eid="LUK 12:16" /><verse number="17" style="v" sid="LUK 12:17" /><char style="wj">Ɔ bíʼtə tʉ ŋwɔŋ-ɛŋ mbɔ, ‘Mɔ bu bɛ təka nə fɔbə-ɔ̄ŋ bʉʼka mɔ kie yəŋ-mɔ̀ʼ-kə fɛ.’</char> <verse eid="LUK 12:17" /><verse number="18" style="v" sid="LUK 12:18" /><char style="wj">Ndʉʉmɛ, ɔ ghɔ̀ŋ mbɔ, ‘Nɔ nukə nɔ ndə mɔ bu chìi. Mɔ bu kùu ghɔ̂ʼ-ɔ, mɔ̀ʼ ikwɛʼtəŋ-yə, mɔ̀ʼ ntɔmə-ɔŋ, ghɔŋbə fɔbə-ɔŋ chɔ inchəŋ.</char> <verse eid="LUK 12:18" /><verse number="19" style="v" sid="LUK 12:19" /><char style="wj">Mɔ bu gìe tʉ ŋwɔŋ-ɔŋ mbɔ, “A nɔ kie fɔbə nduɔ buŋmbi ndə bəkɔ a yú ŋgʉʼŋgʉʼhə. Lʉ̀ mbi njʉnjʉ, yú, nú, bɔŋleʼ sàtə ŋwɔŋ-aŋ!” ’</char><verse eid="LUK 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 12:20" />
    <char style="wj">“Bɔŋ Nyii ghɔ̀ŋ tʉ ɔŋ mbɔ, ‘Nɔ̌ʼ! Laa ndʉʉbətyuʼ-ɔ̄ bə bu lʉ̀ məchimbi-a. Fɔbə-ɔ̄ŋ ndə a nɔʼ shʉ̀tə tʉ́ʼtə tʉ ŋwɔŋ-aŋ nɔ bu bɛ yi-nda-yə?’</char><verse eid="LUK 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21" />
    <char style="wj">“Nɔ bɛ ndə i bu bɛ tʉ bʉə ndə bɔŋ tʉʼ chə̀ŋtə fɔ-kəchisê-bə-ɔ̄ŋ tʉ́ʼtə tʉ ŋwɔŋtə-ʉə təmə kie fɔkə ntoʼ-Nyii fɛ.”</char><verse eid="LUK 12:21" /></para>
  <para style="s">Kə bii mə lə̀ŋnə fɛ</para>
  <para style="r">(<ref loc="MAT 6:25-34">Matia 6:25-34</ref>; <ref loc="MAT 6:19-21">6:19-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22" />Jiso ghɔ̀ŋ tʉ vâafɔʼɔ-bi mbɔ, <char style="wj">“Nɔ, nɔʼ m̈ɔ shyíi bii, kə bii mə kə́ lə̀ŋnə te məchimbi-yii fɛ, te fɔkə ndə bii bu yú byuunɔ te mbʉə-a, te fɔkə ndə a bu mɔ̀ʼ fɛ.</char> <verse eid="LUK 12:22" /><verse number="23" style="v" sid="LUK 12:23" /><char style="wj">Məchímbi nɔ gʉ́ə chàa fɔyubə, mbʉə-a chàa ndyihə.</char> <verse eid="LUK 12:23" /><verse number="24" style="v" sid="LUK 12:24" /><char style="wj">B̈ii lɛ́nə nuɔŋgwemə nyíɛ. Bɔ̂ŋ kyinə shùɔ ŋgwie fɛ təmə kə́ lʉ̀ fɔyubə hə mutɔ fɛ, bɔ̂ŋ kie njaa mɔ̀ʼ bəfɔ fɛ, təmə kie ghɔ̂ʼ fɛ, Nyii bɔŋ kə́ yúʼ bɔŋ. Bii bɔŋ gʉ́ə chàa nuɔmə.</char> <verse eid="LUK 12:24" /><verse number="25" style="v" sid="LUK 12:25" /><char style="wj">Bɔŋ bɛ nda mu bii ndə kaʼ fyii-a kə́ chɔ́ŋhə aŋ, bəkɔ a bìʼ vaa kəkʉʉ mbi ndəŋ məchimbi-a?</char> <verse eid="LUK 12:25" /><verse number="26" style="v" sid="LUK 12:26" /><char style="wj">Kaʼ bɛ mbɔ a mə chìi vaadyʉʼʉ kənu-ɔ̄ŋ fɛ, chìi ka a kə́ lə̀ŋnə te bəbɛʼnubə?</char><verse eid="LUK 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 12:27" />
    <char style="wj">“B̈ii lɛ́nə yii-ŋkɔ-bə, nyíɛ ntɛ ndə bɔ̂ŋ tʉʼ kóʼ, bɔ̂ŋ kyinə fɔ̀ʼ fɔʼɔ fɛ byuunɔ túŋ ndyi fɛ, bɔŋ nɔʼ m̈ɔ shyíi bii mbɔ buŋ Salamu mu məgʉə-e inchəŋ kə kɔ́ʼ ŋwɔŋ-ɛŋ tə dàa mbyu imɔʼ mu bɔŋ fɛ.</char> <verse eid="LUK 12:27" /><verse number="28" style="v" sid="LUK 12:28" /><char style="wj">Bɔŋ kaʼ Nyii kə́ shʉ̀tə ŋkɔ muŋkɔ, ndə i tʉʼ kóʼ laa, sɛŋ bɛ yɔ̂ŋ nɔ bə chʉ́ə tɔ̀ŋ mu kyʉ, ɔ bu gòʼ təmə shʉ̀tə bii daa fɛ təka? Oo bii bʉə ndə bii mɔ̀ʼfyiihə-ii ndəŋ Nyii haʼ məniʼ,</char> <verse eid="LUK 12:28" /><verse number="29" style="v" sid="LUK 12:29" /><char style="wj">kə bii mə kə́ kwɔ̀ʼtə fɔkə ndə bii bu yú fɛ, fɔkə ndə bii bu nú fɛ, kə bii mə kə́ lə̀ŋnə te yɔ̂ŋ fɛ.</char> <verse eid="LUK 12:29" /><verse number="30" style="v" sid="LUK 12:30" /><char style="wj">Bʉʼka bʉə ndə bɔ̂ŋ gòʼ təmə kínə Nyii fɛ mu kəwʉʉnəmbi nɔ tʉʼ nyʉ́ʉ bɔ̌ŋ fɔbə-ɔ̄ŋ inchəŋ, Tie-yii bɔŋ kínə mbɔ bii nɔ tʉʼ byúu fɔbə-ɔ̄ŋ.</char> <verse eid="LUK 12:30" /><verse number="31" style="v" sid="LUK 12:31" /><char style="wj">Kaʼ bii fəŋ gwía Sɔ́ʼ-Nyii bə kɔ́ fɔbə-ɔ̄ŋ tʉ bii inchəŋ ghɔ.</char><verse eid="LUK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32" />
    <char style="wj">“Bii nɔ bɛ nə vaakətia-binjyʉʉhə, kə bii mə bɔŋ fàa fɛ, bʉʼka Tie-yii nɔʼ séʼ ndə mə-yi-mɛ̀ʼtə, bii ŋíi ntoʼ-ɔ, bii bɔŋ kə́ sɔ́ʼ.</char><verse eid="LUK 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 12:33" />
    <char style="wj">“B̈ii fɛ̀ŋ fɔbə-i inchəŋ, kɔ́ kyʉə-ɛ tʉ bʉə-kəbyuu. Kaʼ bii chìi yɔ̄ŋ-yə, təmə bii nɔʼ lə̀ŋ fʉʼkə-ii mu kwo ndə i mə nə byʉ́ʼ fɛ, kə́ lə̀ŋ fʉʼkə-i yuo ndə i mə nə mì fɛ, kəyəŋ ndə lʉʼ mə nə kə́ŋhə mbʉə ghɔ fɛ, təmə ŋkɔʼhə mə nə kwó fɛ.</char> <verse eid="LUK 12:33" /><verse number="34" style="v" sid="LUK 12:34" /><char style="wj">Bʉʼka yəŋkə ndə fʉʼkə-a bɛ chɔ, nɔ yəŋkə ndə fyii-a bu bɛ ghɔ chɔ.</char><verse eid="LUK 12:34" /></para>
  <para style="s">B̈ii shʉ̀tə ŋwɔŋ-yii ndə məgwe-Tiekətʉ</para>
  <para style="r">(<ref loc="MAT 24:45-51">Matia 24:45-51</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35" />
    <char style="wj">“B̈ii shʉ̀tə ŋwɔŋ-yii ndə fɔ̀ʼ, chúʼ kɛʼɛ-yii i kə́ báa,</char> <verse eid="LUK 12:35" /><verse number="36" style="v" sid="LUK 12:36" /><char style="wj">nə bʉə ndə bɔŋ tʉʼ chyìi tiefɔʼ-yʉə mbɔ ɔ bʉ̀nə kəyəŋ yú lɔŋ, kə́ kínə mbɔ ɔ kʉ̂ʉ gwè kə̀ŋ chusii nɔ, bɔ̂ŋ lɔ̀ haʼ ndʉʉmɛ chóʼ.</char> <verse eid="LUK 12:36" /><verse number="37" style="v" sid="LUK 12:37" /><char style="wj">I bu yi bʉ̀ʉ tʉ vâafɔʼɔ ndə tiefɔʼ-yʉə bu yi kə gwè nyíɛ bɔŋ, bɔ̂ŋ kə́ tə́nə chyìichyìi. M̈ɔ shyíi bii nə shʉəŋ, ɔ bu shʉ̀tə ŋwɔŋ-ɛŋ ndə fɔ̀ʼ, téʼ bɔŋ dùʼtə mbʉə tebele, ɔ gwè gyʉ̀ə fɔbə tʉ bɔŋ.</char> <verse eid="LUK 12:37" /><verse number="38" style="v" sid="LUK 12:38" /><char style="wj">I bu yi bʉ̀ʉ tʉ maa-bīŋ vâafɔʼɔ ndə tiefɔ̀ʼ bu yi kə gwè, kə bɛ bə ndʉʉkwɔnəmbi, kə bɛ ndʉʉfiimbi, nyíɛ bɔŋ tʉ bɔ̂ŋ nɔʼ shʉ̀tə ŋwɔŋ-yʉə.</char><verse eid="LUK 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 12:39" />
    <char style="wj">“Bɔŋ b̈ii kínə yɔ̄ŋ-yə mbɔ, kaʼ ŋwɔ̌ŋ-njaa kʉ̌ʉ kínə ndʉʉ ndə lʉʼ bu gwè chɔ, təmə ɔ mə mɛ̀ʼtə njaa-ɛ bə bə́ʼ sʉ́ʉ muŋgɔ fɛ.</char> <verse eid="LUK 12:39" /><verse number="40" style="v" sid="LUK 12:40" /><char style="wj">Mbəŋ-yii ghɔ nɔ kie ndə məshʉ̀tə ŋwɔŋ-yii bʉʼka mbɔ Vaa-Woməsʉʉ bu bɔ̀ʼtə gwè ndʉʉ ndə a gòʼ təmə kínə fɛ.”</char><verse eid="LUK 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41" />Bita bíʼtə mbɔ, “Tiekətʉ, a tʉʼ mɔ̀ʼ chəŋkə-ɔ̄ŋ tʉ baʼa mɛ, kə tʉ bʉə bənchəŋ?”<verse eid="LUK 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42" />Mbʉ Tiekətʉ bə̀ŋhə mbɔ, <char style="wj">“Bɛ nda ndʉʉmɛ bɛ wo-fɔ̀ʼ gìe shʉəŋ ndə ɔ kie mukətʉ súunə? Nɔ bɛ vaafɔ̀ʼ ndə tiefɔ̀ʼ bu tʉ́ʼ ɔ ndə mə-kə́-lɛ́nə bəbɛʼbə vâafɔʼɔ, kə́ kɔ́ fɔyubə-ʉə tʉ bɔŋ ndə ndʉʉ bəfɔyu.</char> <verse eid="LUK 12:42" /><verse number="43" style="v" sid="LUK 12:43" /><char style="wj">I bu yi bʉ̀ʉ tʉ maa-yīŋ vaafɔ̀ʼ ndə tiefɔ̀ʼ bu yi kə bʉ̀nə nyíɛ ɔŋ, ɔ kə́ fɔ̀ʼ jyujyu.</char> <verse eid="LUK 12:43" /><verse number="44" style="v" sid="LUK 12:44" /><char style="wj">Nɔʼ m̈ɔ shyíi bii nə shʉəŋ, ɔ bu dùʼhə ɔŋ, ɔ bɛ wokwɛʼtəŋ ndəŋ fɔbə-i inchəŋ.</char> <verse eid="LUK 12:44" /><verse number="45" style="v" sid="LUK 12:45" /><char style="wj">Bɔŋ kaʼ vaafɔ̀ʼ-ghɔ̄ kə́ gìe tʉ ŋwɔŋ-ɛŋ mbɔ, ‘Tiefɔʼ-ɔ bu tùu buŋ gwè,’ ndʉʉmɛ, ɔ chʉ́ʉhə məgwúutə vâafɔʼɔ bələŋ ghɔŋbə vâafɔʼɔ bəke, kə́ yú bɔŋ nú búu,</char> <verse eid="LUK 12:45" /><verse number="46" style="v" sid="LUK 12:46" /><char style="wj">mbʉ tiefɔʼ-ɛ bu bɔ̀ʼtə gwè ndəŋ chîkə ndə ɔ gòʼ təmə kə́ chyìi ɔ fɛ, gwè ndəŋ ndʉʉ ndə ɔ gòʼ təmə kínə fɛ. Ɔ bu chètə ɔŋ bəŋkwutəbəŋkwutə jə̀ŋ ɔŋ, kɔ́ mu bʉə ndə bɔ̂ŋ gòʼ təmə kínə Nyii fɛ.</char> <verse eid="LUK 12:46" /><verse number="47" style="v" sid="LUK 12:47" /><char style="wj">Vaafɔ̀ʼ ndə ɔ kínə nukə ndə tiefɔʼ-ɛ tʉʼ kʉ́ʉ, təmə shʉ̀tə ŋwɔŋ-ɛŋ ndə məfɔ̀ʼ mbʉ fɔʼɔ fɛ, byuunɔ təmə kə́ fɔ̀ʼ mbʉ kənu-ghɔ̄ fɛ, bə bu gwúu ɔ nə ŋgwɔŋhə yɔ́ŋyɔ́ŋ.</char><verse eid="LUK 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 12:48" />
    <char style="wj">“Bɔŋ vaafɔ̀ʼ ndə ɔ gòʼ təmə kínə nukə ndə tiefɔ̀ʼ tʉʼ kʉ́ʉ fɛ, chìi nukə təmə i bʉ̀ʉ fɛ, bə bu gwúu ɔ məniʼ. Wo ndə bə kɔ́ tʉ ɔŋ yɔ́ŋyɔ́ŋ, bə bu kʉ́ʉ kəghɔ-ɔ yɔ́ŋyɔ́ŋ. Wo ndə bə mɛ̀ʼtə kəghɔ-ɔ yɔ́ŋyɔ́ŋ daa, bə bu bíʼtə kəghɔ-ɔ yɔ́ŋyɔ́ŋ daa.</char><verse eid="LUK 12:48" /></para>
  <para style="s">Kaa muu-ghʉ́ə-mə fɛ, nɔ setə-shùɔnə-kə</para>
  <para style="r">(<ref loc="MAT 10:34-36">Matia 10:34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49" />
    <char style="wj">“Mɔ nɔ gwè ndə mətɔ̀ŋ viʼi kəchisê, i kʉ̌ʉ nɔʼ chʉ́ʉhə məkyʉ́ʉ təmə i nɔ bʉ̀ʉ mɔ.</char> <verse eid="LUK 12:49" /><verse number="50" style="v" sid="LUK 12:50" /><char style="wj">Bɔŋ mɔ nɔ kie muu ndə məfì, kə́ bɛ ŋgʉəʼ ghɔŋbə kwú ndə i tʉʼ chɔ́ŋhə mɔ, tə i yaʼ yi gwè tə tíŋ ŋkəŋ.</char> <verse eid="LUK 12:50" /><verse number="51" style="v" sid="LUK 12:51" /><char style="wj">Bii kwɔ̀ʼtə mbɔ mɔ gwè nə fyiighʉ́ənə kəchisê mɛ? Mbee! M̈ɔ shyíi bii, nɔ setə-shùɔnə-kə.</char> <verse eid="LUK 12:51" /><verse number="52" style="v" sid="LUK 12:52" /><char style="wj">Lʉ̀ hə nduɔ gɛ̀ nə shʉbə, bʉə bu bɛ bətaa chufu-bɔŋ təmə kə́ fí viʼi fɛ, bʉə bətia kə́ bɛ mii bʉə bəbûu, bʉə bəbûu kə́ bɛ mii bʉə bətia.</char> <verse eid="LUK 12:52" /><verse number="53" style="v" sid="LUK 12:53" /><char style="wj">Bɔ̂ŋ bu wɔ̀ʼtə, tie mii vaabələŋ, vaabələŋ kə́ bɛ mii tie-e, ŋkwê vaa mii vaabəke-e, vaabəke mii ŋkwê-i, ŋkwê ləŋ mii vi vaa-ɛ, vi vaa mii ŋkwê ləŋ-ɛŋ.”</char><verse eid="LUK 12:53" /></para>
  <para style="s">Mətɔ́-ŋgwɔʼmbi</para>
  <para style="r">(<ref loc="MAT 16:2-3">Matia 16:2-3</ref>; <ref loc="MAT 5:25-26">5:25-26</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54" />Ɔ gìe tʉ mbʉ bʉə buŋmbi mbɔ, <char style="wj">“Kaʼ bii nyíɛ mbɔʼkə i kə́ kóʼ kwii ndə chichi sʉ́ʉ chɔ chusii-ɔ nɔ, bii ghɔ̀ŋ mbɔ, ‘Wyuu bu fyíi.’ Ï bɛ haʼ nɔ.</char> <verse eid="LUK 12:54" /><verse number="55" style="v" sid="LUK 12:55" /><char style="wj">Fʉʉkə kóʼ hə byûumbɔŋ nɔ, bii ghɔ̀ŋ mbɔ, ‘Mbi bu ghɔʼ laa.’ Ï bɛ haʼ nɔ.</char> <verse eid="LUK 12:55" /><verse number="56" style="v" sid="LUK 12:56" /><char style="wj">Bʉə làhə shʉ! Bii nɔ kínə ndə mətɔ́ cheʼ-kəchisê-bə-ɔ̄ŋ ghɔŋbə cheʼ-yuo-bə. Chìi ka təmə bii kínə ndə mətɔ́ nubə ndə i tʉʼ tíŋ nduɔ fɛ?</char><verse eid="LUK 12:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57" />
    <char style="wj">“Chìi ka təmə bii mə kwɔ̀ʼtə tʉkə-ii ndə nukə ndə i bɛ kʉ̀ʼnə fɛ?</char> <verse eid="LUK 12:57" /><verse number="58" style="v" sid="LUK 12:58" /><char style="wj">Kaʼ wo mɔ̀ʼ nukə kətʉ-a, bii ɔ kə́ gɛ̀ mu fɛʼɛ tʉ wo chʉ̀ə fɛʼɛ, kɔ̀ɔtə bii ɔ lìʼ sɔ́ʼ yi-ɔ sêfia, byuunɔ təmə ɔ bu tʉ́ʉhə a, gɛ̀ nə aŋ tʉ wo fɛ̀ʼ fɛʼɛ, mbʉ wo chʉ̀ə fɛʼɛ tʉ́ʉhə a, kɔ́ tʉ wokwɛʼtəŋ-bəshia-kəfʉəŋ, ɔ kɔ́ a chaŋ.</char> <verse eid="LUK 12:58" /><verse number="59" style="v" sid="LUK 12:59" /><char style="wj">M̈ɔ shyíi a nə shʉəŋ mbɔ, a mə leʼ dʉ̀ʼ tʉkə-a mbi fɛ, tə a yaʼ lɔ̀ʼ tə lɔ̀ʼ nə ŋii-kəghɔ-bə-a.”</char><verse eid="LUK 12:59" /></para>
  <chapter eid="LUK 12" />
  <chapter number="13" style="c" sid="LUK 13" />
  <para style="s">Shìe liɛŋ-aŋ hə ndəŋ bʉ̂ʼʉ byuunɔ a kwú bɛ́</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1" />Haʼ ndʉʉghɔfii, bəbɛʼbʉə ndə bɔ̂ŋ kə bɛ chɔ, shyíi Jiso ndə Bale kə yítə bʉə-Galili, fìnə fɔbʉəkə-ʉə mu fɔ-fɛ̀ʼndɛŋ-bə-ʉə. <verse eid="LUK 13:1" /><verse number="2" style="v" sid="LUK 13:2" />Jiso bə̀ŋhə, ghɔ̀ŋ mbɔ, <char style="wj">“Bii kwɔ̀ʼtə mbɔ bʉə-Galili-bɔ̄ŋ ndə bɔ̂ŋ kə nyíɛ ŋgʉəʼ-ɔ̄ nɔ, bʉ̂ʼtə-ʉə shʉ́əshʉ́ə daa tə chàa bʉ̂ʼʉ bəbɛʼbʉə-Galili mɛ?</char> <verse eid="LUK 13:2" /><verse number="3" style="v" sid="LUK 13:3" /><char style="wj">Mbee, nukə ndə bii tʉʼ kwɔ̀ʼtə kʉ̀ʼnə fɛ, kaʼ bii gòʼ təmə shìe liɛŋtə-ii ndəŋ bʉ̂ʼʉ fɛ, bii bənchəŋ kwú bɛ́.</char> <verse eid="LUK 13:3" /><verse number="4" style="v" sid="LUK 13:4" /><char style="wj">Bii nɔ kínə te nə bʉə njuɔ fɔŋ nə wuŋ ndə bɔŋ kə kwútə ndʉʉ ndə njaa bəyuhəbəyuhə Silɔŋ kə gwù ndəŋ bɔŋ. Bii kwɔ̀ʼtə mbɔ bʉ̂ʼtə-ʉə yɔ́ŋ chàa yi-bəbɛʼbʉə-yə ndə bɔ̂ŋ kə́ chí Jɛlosalɛŋ mɛ?</char> <verse eid="LUK 13:4" /><verse number="5" style="v" sid="LUK 13:5" /><char style="wj">Mbee, mɔ nɔ tʉʼ shyíi bii, kaʼ bii gòʼ təmə shìe liɛŋtə-ii ndəŋ bʉ̂ʼʉ fɛ, bii bənchəŋ kwú bɛ́.”</char><verse eid="LUK 13:5" /></para>
  <para style="s">Fʉʼkənu ndə fik ndə i bɛ dəŋ</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6" />Ndʉʉmɛ, ɔ mɔ̀ʼ chəŋkə-ɔ̄ŋ tʉ bɔŋ mbɔ, <char style="wj">“Wobɛʼ nɔ nə bɛ ghɔ ndə ɔ nə bè fik mutɔ-ɔ, ɔ gɛ̀ ndə məlɛ́nə ntɔŋmə-i, bɔŋ təmə nyíɛ fɔkə chɔ fɛ.</char> <verse eid="LUK 13:6" /><verse number="7" style="v" sid="LUK 13:7" /><char style="wj">Ɔ gìe tʉ wo ndə ɔ kə́ lɛ́nə mbʉ mutɔ mbɔ, ‘Nɔ ŋgʉʼhə-ɔ̄ŋ itia nduɔ ndə mɔ tʉʼ gwè ndə məlɛ́nə ntɔŋmə ndəŋ tyʉ-fik-kə-ɔ̄ŋ təmə bɔŋ kə́ nyíɛ fɔkə chɔ fɛ. Gwìa mɛ̀ʼ! Mɔ kʉ̀ʉ mbɔ mɔ mɛ̀ʼtə i kə́ bʉ́əhə sê-ɔ njʉnjʉ fɛ.’</char><verse eid="LUK 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 13:8" />
    <char style="wj">“Mbʉ wo lɛ́nə mutɔ bə̀ŋhə tʉ ɔŋ mbɔ, ‘Tiefɔʼ-ɔ, kə a mɛ̀ʼtə chɔ ndə ŋgʉʼʉmbi le, mɔ bu tyúutə yə̀ŋhə mbʉə-e fúu mɔ̀ʼ chʉəʼ chɔ.</char> <verse eid="LUK 13:8" /><verse number="9" style="v" sid="LUK 13:9" /><char style="wj">Kaʼ i kʉ́ʉnə ntɔŋmə shyʉʉnə, i bʉ̀ʉ, bɔŋ byuunɔ bə gwìa mɛ̀ʼ.’ ”</char><verse eid="LUK 13:9" /></para>
  <para style="s">Lɛŋ woke ndə ɔ kie nchʉʼ ndəŋ Chîlɔʼkə</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10" />Nɔ nə bɛ Chîlɔʼbɛʼkə, Jiso kə́ dàhə mu njaagháaNyii. <verse eid="LUK 13:10" /><verse number="11" style="v" sid="LUK 13:11" />Wokebɛʼ kə́ bɛ chɔ ndə lyʉʉhəbʉəbʉəkə nɔʼ lɛ́ŋhə ɔŋ ndə ŋgʉʼhə njuɔ fɔŋ nə wuŋ. Ɔ kə́ tòʼ bʉʉbʉʉ təmə bəkɔ ɔ bə̀ŋhə ŋwɔŋ-ɛŋ fɛ. <verse eid="LUK 13:11" /><verse number="12" style="v" sid="LUK 13:12" />Ndʉʉ ndə Jiso nyíɛ ɔŋ, tíi ɔ, ɔ fyú gwè bəshʉ ɔ, ɔ gìe tʉ ɔŋ mbɔ, <char style="wj">“Woke, bə nɔʼ chʉ́ʼ a ndəŋ yɔʼkə-a.”</char> <verse eid="LUK 13:12" /><verse number="13" style="v" sid="LUK 13:13" />Jiso mɔ̀ʼ ghɔkə-i ndəŋ ɔŋ, haʼ ndʉʉmɛ, ɔ kie nchʉʼ, bə̀ŋhə ŋwɔŋ-ɛŋ, tə́nə ndyʉndyʉ, chʉ́ʉhə kə́ lə̀ʼtə Nyii.<verse eid="LUK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14" />Tʉʉ wokwɛʼtəŋ-mu-njaagháaNyii byʉ́ʼ tʉ Jiso bʉʼka mbɔ ɔ nɔʼ chʉ́ʼ wo ndəŋ Chîlɔʼkə. Mbʉ wokwɛʼtəŋ gìe tʉ bʉə-ghɔ̄bə mbɔ, “Chî-fɔʼɔ-bə nɔ bɛ ntʉʼʉ, mu chî-maa-bə-ɔ̄ŋ b̈ii gwè kie nchʉʼ-yii, kaa bɛ ndəŋ Chîlɔʼkə fɛ.”<verse eid="LUK 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15" />Tiekətʉ bə̀ŋhə tʉ ɔŋ mbɔ, <char style="wj">“Bii bʉə làhə shʉ! Bii tʉʼ fyúhə bənaʼa-wada-bii ghɔŋbə bəjakashi-bii hə mu lɔ̂ŋ ndəŋ Chîlɔʼkə, gɛ̀ kɔ́ muu tʉ bɔŋ fe?</char> <verse eid="LUK 13:15" /><verse number="16" style="v" sid="LUK 13:16" /><char style="wj">Bɔŋ woke-ɔ̄, vaa-Ablahaŋ ndə Sata nɔʼ kə kɔ́ʼ ɔ ndəŋ ŋgʉʼhə njuɔ fɔŋ nə wuŋ, bəkɔ bə yɔ̀ʼtə ɔŋ ndəŋ ghyʉʉ-Sata-tə ndəŋ Chîlɔʼkə fe?”</char> <verse eid="LUK 13:16" /><verse number="17" style="v" sid="LUK 13:17" />Ndə ɔ gìe yɔ̄ŋ-yə le, bʉə-bàa-bi bənchəŋ kie tʉvyiikə. Mbʉ bʉə-ghɔ̄bə kə́ nʉ́ətə nuchíechubə ndə ɔ tʉʼ chìi.<verse eid="LUK 13:17" /></para>
  <para style="s">Chəŋ-ŋgwie-kîa-kə ghɔŋ yî</para>
  <para style="r">(<ref loc="MAT 13:31-33">Matia 13:31-33</ref>; <ref loc="MRK 4:30-32">Mak 4:30-32</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18" />Ndʉʉghɔfii, Jiso bíʼtə mbɔ, <char style="wj">“Sɔ́ʼ-Nyii bɛ ntɛ təka? Bəkɔ mɔ fʉ̀ʼ ndə ka?</char> <verse eid="LUK 13:18" /><verse number="19" style="v" sid="LUK 13:19" /><char style="wj">I nɔ bɛ nə vaa-ŋgwie-kîa ndə wo lʉ̀ gɛ̀ shùɔ mutɔ-ɔ. I kʉ̂ʉ kóʼ bə̀ŋ lɔkɔʼ kətyʉ nuɔ-mbi-mə gwè fʉ̀ə njaahə-ʉə ndəŋ ntɔŋtə-i.”</char><verse eid="LUK 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20" />Ɔ bìʼ bíʼtə mbɔ, <char style="wj">“Bəkɔ mɔ fʉ̀ʼ Sɔ́ʼ-Nyii ndə ka?</char> <verse eid="LUK 13:20" /><verse number="21" style="v" sid="LUK 13:21" /><char style="wj">I nɔ bɛ nə vaadyʉʼʉ yî ndə woke lʉ̀ mɔ̀ʼ mu mbʉ̂ətə bobo buŋmbi, i chìi mbʉ mbʉ̂ətə kóʼ nchəŋnchəŋ-ɛŋ.”</char><verse eid="LUK 13:21" /></para>
  <para style="s">Chusii fíanə</para>
  <para style="r">(<ref loc="MAT 7:13-14">Matia 7:13-14</ref>,<ref loc="MAT 7:21-23">21-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22" />Ndʉʉghɔfii, Jiso kə́ tòʼ tíŋ hə mu yəŋkwɛʼtəŋbə ghɔŋbə lɔʼ-bətə̂ŋ-tə, kə́ tòʼ dàhə bʉə, kə́ gɛ̀ nə kwii Jɛlosalɛŋ. <verse eid="LUK 13:22" /><verse number="23" style="v" sid="LUK 13:23" />Wobɛʼ bíʼtə tʉ ɔŋ mbɔ, “Tiekətʉ, bɛ haʼ mbyu-bʉə-hə məniʼ ndə Nyii bu kwáa bɔŋ mɛ?”</para>
  <para style="p" vid="LUK 13:23">Ɔ gìe tʉ bɔŋ mbɔ, <verse eid="LUK 13:23" /><verse number="24" style="v" sid="LUK 13:24" /><char style="wj">“Chìi nubə inchəŋ ndə məŋíi ntoʼ-Nyii ndə chusii fíanə, mɔ nɔ tʉʼ shyíi bii bʉʼka bʉə buŋmbi nɔ bu kə́ fʉʼ fʉʼkə ndə məŋíi chɔ, bɔŋ bu ŋíi kəŋkaa.</char> <verse eid="LUK 13:24" /><verse number="25" style="v" sid="LUK 13:25" /><char style="wj">Ndʉʉ ndə mbʉ ŋwɔ̌ŋ-njaa bu lɔ̀ hə sê fʉ̀əŋ chusii nɔ, bii ndə bii bíe mbi bu tə́nə chusii kə́ kwɔ̀ŋ bɔŋ fʉ̀ʉtə mbɔ, ‘Tiekətʉ, chóʼ chusii tʉ baʼa.’ Bɔŋ ɔ bu bə̀ŋhə mbɔ, ‘Mɔ kínə bii fɛ, təmə bɔŋ kínə yəŋkə ndə bii lɔ̀ hə chɔ fɛ.’</char> <verse eid="LUK 13:25" /><verse number="26" style="v" sid="LUK 13:26" /><char style="wj">Ndʉʉghɔfii, bii bu ghɔ̀ŋ mbɔ, ‘Bʉʼʉ nɔ nə kə́ yú bɔŋleʼ nú, a bɔŋ-nɔʼ-leʼ dàhə kəyəŋkwɛʼtəŋ-baʼa.’</char> <verse eid="LUK 13:26" /><verse number="27" style="v" sid="LUK 13:27" /><char style="wj">Bɔŋ ɔ bu bə̀ŋhə mbɔ, ‘Nɔʼ m̈ɔ shyíi bii, mɔ kínə bii fɛ, təmə bɔŋ kínə yəŋkə ndə bii lɔ̀ hə chɔ fɛ. B̈ii kwɛ̀ʼtə mbʉə mɔ, bʉə-bʉ̂ʼʉ.’</char><verse eid="LUK 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 13:28" />
    <char style="wj">“Mu kəyəŋ-ghɔ̄, gwia bu bɛ chɔ ghɔŋbə mbʉə liŋnə shʉ́əshʉ́ə ndʉʉ ndə a bu nyíɛ Ablahaŋ, Aisi ghɔŋbə Jakɔ leʼnə bʉəyʉkəŋgieNyii-ntoʼ-Nyii, bə bɔŋ mɛ̀ʼ a mbi.</char> <verse eid="LUK 13:28" /><verse number="29" style="v" sid="LUK 13:29" /><char style="wj">Bʉə bu gwè hə kwii ndə chichi tʉʼ sɔ́ʼ chɔ ghɔŋbə kwii ndə chichi tʉʼ sʉ́ʉ chɔ chusii-ɔ, byûukwe, byûumbɔŋ, lʉ̀ yəŋ-dùʼ-bə-ʉə kə́ yú fɔbə ntoʼ-Nyii.</char> <verse eid="LUK 13:29" /><verse number="30" style="v" sid="LUK 13:30" /><char style="wj">Ndə ŋgie-shʉəŋ-kə, bʉə nɔ ghɔ ndə bɔ̂ŋ bɛ ndyiʼtəbə ndə bɔ̂ŋ bu yi bɛ fəŋtə, bɔŋ bəbɛʼbə kə́ bɛ ghɔ ndə bɔ̂ŋ bɛ fəŋtə ndə bɔ̂ŋ bu yi bɛ ndyiʼtəbə.”</char><verse eid="LUK 13:30" /></para>
  <para style="s">Tʉ-Jiso-kə vyíi ndəŋ bʉə-Jɛlosalɛŋ</para>
  <para style="r">(<ref loc="MAT 23:37-39">Matia 23:37-39</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31" />Haʼ ndʉʉghɔfii, bəbɛʼbʉə-Falasi gwè tʉ Jiso gìe tʉ ɔŋ mbɔ, “Mɛ̀ʼtə yəŋkə-ɔ̄ŋ gɛ̀ kəyəŋ kədɔŋ. Hɛlo nɔ tʉʼ kʉ́ʉ mbɔ ɔ yí a.”<verse eid="LUK 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32" />Ɔ bə̀ŋhə mbɔ, <char style="wj">“Gɛ̀ gìe tʉ səŋyaŋgwo-ghɔ̄ mbɔ, ‘Mɔ bu chʉ́ʼ bʉə ndə bɔ̂ŋ kie lyʉʉhəbʉəbʉəbə ghɔŋbə bʉə-bəyɔʼ laa ghɔŋ yɔ̂ŋ, chîbə kʉ̂ʉ yi mì itia nɔ, mɔ mìʼtə fɔʼɔ-ɔ.’</char> <verse eid="LUK 13:32" /><verse number="33" style="v" sid="LUK 13:33" /><char style="wj">Kaʼ nubə kə́ ghɔʼ təka, mɔ bu kə́ gɛ̀ nə shʉbə laa, yɔ̂ŋ, leʼnə yɔ̂ŋ-ɛŋ, bʉʼka yʉkəŋgieNyii kaa ghɔ ndə ɔ gòʼ təmə kwú mu Jɛlosalɛŋ fɛ.</char><verse eid="LUK 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34" />
    <char style="wj">“A goo Jɛlosalɛŋ! A goo Jɛlosalɛŋ! Yəŋkwɛʼtəŋkə ndə bii yítə bʉəyʉkəŋgieNyii bɔŋleʼ túŋtə bʉə ndə bə tə́ŋ bɔŋ tʉ bii. Bɛ vɛʼsɛʼɛ ndə mɔ nɔʼ kʉ̀ʉ ndə məchə̀ŋtə bii ndə ŋkwê ŋgwo chə̀ŋtə vâa-bi kwóhə tɔʼɔ bəghɔnə-ɔŋ le, təmə bii bɔŋ kʉ̀ʉ fɛ.</char> <verse eid="LUK 13:34" /><verse number="35" style="v" sid="LUK 13:35" /><char style="wj">Bə nɔʼ ké njaa-yii, mɔ bɔŋleʼ kə́ shyíi bii mbɔ, bii bieleʼ nə nyíɛ mɔ fɛ, tʉ bii nə ghɔ̀ŋ mbɔ, ‘Tə Nyii bìʼ Wo ndə ɔ gwè yie-Tiekətʉ.’ ”</char><verse eid="LUK 13:35" /></para>
  <chapter eid="LUK 13" />
  <chapter number="14" style="c" sid="LUK 14" />
  <para style="s">Jiso chʉ́ʼ wokəyɔʼ ndəŋ Chîlɔʼkə</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1" />Chîlɔʼbɛʼkə, ndʉʉ ndə Jiso gɛ̀ mu njaa-wokwɛʼtəŋ-bʉə-Falasi ndə məyú fɔbə, bə tʉ́ʼ shʉ̀tə ndəŋ ɔŋ kə́ kíi ɔ. <verse eid="LUK 14:1" /><verse number="2" style="v" sid="LUK 14:2" />Kə nyíɛ, wobɛʼ kə́ tə́nə bəshʉ ɔ nə ŋkoʼtəbə mbʉə-ɔ. <verse eid="LUK 14:2" /><verse number="3" style="v" sid="LUK 14:3" />Ndʉʉmɛ, Jiso bíʼtə tʉ bʉə dàhə nuʼ-Mushi ghɔŋbə bʉə-Falasi mbɔ, <char style="wj">“Nuʼ mɛ̀ʼtə mbɔ b̈ə chʉ́ʼ wo ndəŋ Chîlɔʼkə mɛ?”</char> <verse eid="LUK 14:3" /><verse number="4" style="v" sid="LUK 14:4" />Bɔŋ təmə bɔ̂ŋ bə̀ŋhə fɛ, ɔ lʉ̀ ɔ, chʉ́ʼ ɔ, téʼ tʉ ɔŋ ɔ gɛ̀ nə wi. <verse eid="LUK 14:4" /><verse number="5" style="v" sid="LUK 14:5" />Ndʉʉmɛ, ɔ bíʼtə mbɔ, <char style="wj">“Bɛ nda mu bii ndə kaʼ vaa-ɛ byuunɔ mbʉʉ-i gwù mu byʉʉ ndəŋ Chîlɔʼkə, ɔ mɛ̀ʼtə ɔŋ chɔ təmə kóʼhə fɛ?”</char> <verse eid="LUK 14:5" /><verse number="6" style="v" sid="LUK 14:6" />Təmə bɔ̂ŋ kie ŋgiekə ndə mə bə̀ŋhə fɛ.<verse eid="LUK 14:6" /></para>
  <para style="s">Jiso dàhə ntɛ ndə bʉə kie ndə məlʉ̀ ŋwɔŋ-yʉə sê</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7" />Ndʉʉ ndə Jiso nyíɛ ndə bəbɛʼbʉə ŋkɔʼnə kə́ gwè kəyəŋ-lɔŋ, kə́ séʼ bə yəŋkwɛʼtəŋbə ndə mədùʼ ndəŋ ghɔ, ɔ mɔ̀ʼ chəŋkə tʉ bɔŋ mbɔ, <verse eid="LUK 14:7" /><verse number="8" style="v" sid="LUK 14:8" /><char style="wj">“Kaʼ wo kɔ̀ʼnə a kəyəŋ lɔŋ-ɔŋ, kə a mə gɛ̀ dùʼ ndəŋ yəŋkwɛʼtəŋkə fɛ. Ndʉʉbɛʼ ɔ kɔ̀ʼnə ibɛʼ-yə wo ndə ɔ chàa a.</char> <verse eid="LUK 14:8" /><verse number="9" style="v" sid="LUK 14:9" /><char style="wj">Ndʉʉ ndə ɔ bu gwè nɔ, mbʉ wo ndə ɔ kɔ̀ʼnə bii bu gwè ghɔ̀ŋ tʉ a mbɔ, ‘Kɔ́ yəŋkə-a tʉ wo-ɔ̄,’ tʉkə-a bu vyíi ndə a bu gɛ̀ dùʼ ndəŋ yəŋ-tîetîe-kə.</char><verse eid="LUK 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 14:10" />
    <char style="wj">“Bɔŋ bɛ le kaʼ bə kɔ̀ʼnə a, gɛ̀ dùʼ ndəŋ yəŋ-tîetîe-kə mbɔ yi gwè wo ndə ɔ kɔ̀ʼnə aŋ gwè, ghɔ̀ŋ tʉ a mbɔ, ‘Tieŋkɔŋ-ɔŋ, gwè dùʼ kəyəŋkwɛʼtəŋ.’ Ndʉʉghɔfii, a bu kie məgʉ́ə bəshʉ bʉə ndə bii bɔŋ dùʼ mɔʼɔ.</char> <verse eid="LUK 14:10" /><verse number="11" style="v" sid="LUK 14:11" /><char style="wj">Bʉʼka mbɔ wotəmiyɔŋ ndə ɔ kóʼhə ŋwɔŋ-ɛŋ ghɔʼ bu nyíɛ ŋwɔŋ-ɛŋ sê, bɔŋ wotəmiyɔŋ ndə ɔ shúʼhə ŋwɔŋ-ɛŋ sê, bə bu kóʼhə ɔŋ ghɔʼ.”</char><verse eid="LUK 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12" />Jiso kíahə ŋwɔŋ-ɛŋ tʉ wo ndə ɔ kɔ̀ʼnə ɔŋ, ghɔ̀ŋ tʉ ɔŋ mbɔ, <char style="wj">“Kaʼ a kə́ tíi bʉə ndə fɔyubə ndʉʉsɛŋkə byuunɔ ndʉʉnəchî, kə a mə tíi bətieŋkɔŋ-ba fɛ byuunɔ bəliŋ-ba byuunɔ bʉə-kəlɔŋ-bii fɛ byuunɔ bʉə-kətoʼ-ba ndə bɔ̂ŋ kie kyʉə fɛ, təmə bɔ̂ŋ bu leʼ kɔ̀ʼnə aŋ ghɔ ndə məlɔ̀ʼ ŋkwo-a.</char> <verse eid="LUK 14:12" /><verse number="13" style="v" sid="LUK 14:13" /><char style="wj">Kaʼ bɔŋ bɛ le a kie nchəŋtə, ä kɔ̀ʼnə bʉə-kəbyuu, bəlɛŋ, bəŋkwɛʼfʉəŋ, bəfʉ̀əŋtəshʉ,</char> <verse eid="LUK 14:13" /><verse number="14" style="v" sid="LUK 14:14" /><char style="wj">nə yɔŋ-yə, Nyii bu bìʼ a bʉʼka mbɔ bɔ̂ŋ kie fɔkə ndə məlɔ̀ʼ a chɔ fɛ. A bu yi kie lɔʼɔbə-a hə kəghɔ-Nyii ndʉʉ ndə bʉə-Nyii ndə bɔ̂ŋ bɛ ndyʉndyʉ bu bʉ̀nə kóʼ.”</char><verse eid="LUK 14:14" /></para>
  <para style="s">Chəŋ-nchəŋtəkwɛʼtəŋ-kə</para>
  <para style="r">(<ref loc="MAT 22:1-10">Matia 22:1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15" />Ndʉʉ ndə mbyu wobɛʼ ndə ghɔŋ bɔŋ dùʼ ndəŋ tebele mɔʼɔ kə yʉ́ yɔ̄ŋ-yə, ɔ ghɔ̀ŋ tʉ Jiso mbɔ, “Tʉʉjyu nɔ bɛ yi-wo-yə ndə ɔ kwó bele ntoʼ-Nyii.”<verse eid="LUK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16" />Jiso ghɔ̀ŋ tʉ ɔŋ mbɔ, <char style="wj">“Wobɛʼ nɔ nə kie nchəŋtəkwɛʼtəŋ, kɔ̀ʼnə bʉə buŋmbi.</char> <verse eid="LUK 14:16" /><verse number="17" style="v" sid="LUK 14:17" /><char style="wj">Ndʉʉ mbʉ nchəŋtə kʉ̂ʉ kʉ̀ʼnə, ɔ tə́ŋ vaafɔ̀ʼ-ɛ ndə məgɛ̀ gìe tʉ bʉə ndə bə kə kɔ̀ʼnə bɔŋ mbɔ, ‘B̈ii gwè, bə nɔʼ shʉ̀tə nubə liʼ.’</char> <verse eid="LUK 14:17" /><verse number="18" style="v" sid="LUK 14:18" /><char style="wj">Bɔŋ bɔ̂ŋ bənchəŋ chʉ́ʉhə məmɔ̀ʼ nubə sê. Fəŋ ghɔ̀ŋ mbɔ, ‘Mɔ nɔʼ nyúɔ tɔ̂kə, mɔ nɔ kie ndə məgɛ̀ lɛ́nə. Mɔ nɔ tʉʼ fʉ̀ʉtə a mbɔ ä mɛ̀ʼtə mɔ gɛ̀.’</char> <verse eid="LUK 14:18" /><verse number="19" style="v" sid="LUK 14:19" /><char style="wj">Ibɛʼyə ghɔ̀ŋ mbɔ, ‘Mɔ nɔʼ nyúɔ bie-bəmbʉʉ-hə itaa, mɔ kie ndə məgɛ̀ lɛ́nə bɔŋ, mɔ nɔ tʉʼ fʉ̀ʉtə a mbɔ ä mɛ̀ʼtə mɔ gɛ̀ lɛ́nə bɔŋ.’</char> <verse eid="LUK 14:19" /><verse number="20" style="v" sid="LUK 14:20" /><char style="wj">Ibɛʼyə ghɔ̀ŋ mbɔ, ‘Mɔ nɔ bíe chìi lɔŋ-ɔŋ chìi, mɔ mə gwè fɛ.’</char><verse eid="LUK 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21" />
    <char style="wj">“Ndʉʉmɛ, mbʉ vaafɔ̀ʼ bʉ̀nə gwè fʉ̀ʼtə nubə-ɔ̄ŋ tʉ tiefɔʼ-ɛ. Tʉʉ mbʉ tiefɔʼ-ɛ byʉ́ʼ, ɔ ghɔ̀ŋ tʉ ɔŋ mbɔ, ‘Fyú gɛ̀ nəndʉʉnəndʉʉ ndəŋ fia-tyúunə-tə ghɔŋbə vâatəfia mu kəyəŋkwɛʼtəŋ, gɛ̀ gwè nə bʉə-mbʉʼ, bəlɛŋ, bəfʉ̀əŋtəshʉ leʼnə bəŋkwɛʼfʉəŋ.’</char> <verse eid="LUK 14:21" /><verse number="22" style="v" sid="LUK 14:22" /><char style="wj">Mbʉ vaafɔ̀ʼ ghɔ̀ŋ mbɔ, ‘Tiefɔʼ-ɔ, nukə ndə a kàhə bə nɔʼ kə chìi, yəŋbə bɔŋ kə́ bíe.’</char> <verse eid="LUK 14:22" /><verse number="23" style="v" sid="LUK 14:23" /><char style="wj">Mbʉ tiefɔ̀ʼ ghɔ̀ŋ tʉ vaafɔ̀ʼ-ɛ mbɔ, ‘Fyú gɛ̀ mu fia-tyúunəkwɛʼtəŋ-tə ghɔŋbə lɔ̂ŋ-lɔʼɔ-tə, gɛ̀ kwɛ̀ŋhə bʉə bɔ̂ŋ gwè ŋíi mu njaa-ɔ lə́ŋ.</char> <verse eid="LUK 14:23" /><verse number="24" style="v" sid="LUK 14:24" /><char style="wj">M̈ɔ shyíi bii mbɔ mbyu wo mu fəŋ-bʉə-tə ndə mɔ kə kɔ̀ʼnə kʉʉ leʼ yúotə fɔbə-ɔŋ fɛ.’ ”</char><verse eid="LUK 14:24" /></para>
  <para style="s">Lɔʼɔbə ndə məgɛ̀ hə bɔ̌ŋ Jiso</para>
  <para style="r">(<ref loc="MAT 10:37-38">Matia 10:37-38</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25" />Buŋmbi nuɔ-bʉə-tə kə́ gɛ̀ hə bɔ̌ŋ Jiso, ɔ kíahə ŋwɔŋ-ɛŋ ghɔ̀ŋ tʉ bɔŋ mbɔ, <verse eid="LUK 14:25" /><verse number="26" style="v" sid="LUK 14:26" /><char style="wj">“Kaʼ wotəmiyɔŋ kə́ gwè hə bɔ̌ŋ mɔ, təmə bàa tie-e, bàa ŋkwê-i, bàa vi-i, bàa vâa-bi, bàa bəliŋ-bi tə buŋ kɔmə yi-yə ŋwɔŋ ghɔ fɛ, ɔ mə kʉ̀ʼnə ndə məbɛ vaafɔ̀ʼ-ɔ fɛ.</char> <verse eid="LUK 14:26" /><verse number="27" style="v" sid="LUK 14:27" /><char style="wj">Wotəmiyɔŋ ndə ɔ gòʼ təmə bɛ̀ʼ tyʉntɔɔnəkə-i, gwè hə bɔ̌ŋ mɔ fɛ, kʉ̀ʼnə ndə məbɛ vaafɔ̀ʼ-ɔ fɛ.</char><verse eid="LUK 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28" />
    <char style="wj">“Bɛ nda mu bii ndə ɔ kʉ̀ʉ ndə məbɔ́ŋ ŋkwê njaa təmə fəŋ dùʼ sê kwɔ̀ʼtə ntyʉʉ bəfɔ ndə i bu gɛ̀ chɔ, nyíɛ mbɔ ɔ kie fɔkə ndə məlìʼ mbʉ fɔʼɔ chɔ mɛ?</char> <verse eid="LUK 14:28" /><verse number="29" style="v" sid="LUK 14:29" /><char style="wj">Byuunɔ, təmə ndʉʉ ndə ɔ bu yiesê-e liʼ, mùutə ndə məmìʼtə mbʉ fɔʼɔ kəŋkaa nɔ, bʉə bənchəŋ ndə bɔ̂ŋ nyíɛ bu kə́ dʉ̀ʉhə ɔŋ,</char> <verse eid="LUK 14:29" /><verse number="30" style="v" sid="LUK 14:30" /><char style="wj">kə́ ghɔ̀ŋ mbɔ, ‘Wo-ɔ̄ chʉ́ʉhə məbɔ́ŋ njaa mùutə ndə məmìʼtə kəŋkaa.’</char><verse eid="LUK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31" />
    <char style="wj">“Byuunɔ, bɛ yɔ̂ŋ-yə fɔŋ ndə ɔ tʉʼ gɛ̀ ŋíi ibɛʼ-yə fɔŋ nə chɔ̂ bu gòʼ təmə dùʼ sê bínə mbɔ kaʼ ɔ lʉ̀ ŋkɔŋ-bʉə-hə wuŋ kə́ gɛ̀ nə yɔ̄ŋ-yə tʉ wo ndə ɔ kie ŋkɔŋ-bʉə-hə wuŋ bûu, ɔ̈ yú mɛ?</char> <verse eid="LUK 14:31" /><verse number="32" style="v" sid="LUK 14:32" /><char style="wj">Kaʼ bɔŋ byuunɔ, ɔ chóʼ bʉə, tə́ŋ tʉ ibɛʼ-yə ɔ kə bíe dɔdɔ, bɔ̂ŋ fʉ̀ʉtə ɔŋ mbɔ ɔ̈ ghʉ́əhə fyii-i.</char> <verse eid="LUK 14:32" /><verse number="33" style="v" sid="LUK 14:33" /><char style="wj">Ndʉʉmɛ, wo mu bii ndə ɔ kʉ̀ʉ ndə məbɛ vaafɔ̀ʼ-ɔ nɔ kie ndə məyɔ̀ʼ ghɔkə-i ndə fɔbə inchəŋ ndə ɔ kie.</char><verse eid="LUK 14:33" /></para>
  <para style="s">Chʉəʼ ndə i nɔʼ bɛ́ məsʉ́ʼnə-i</para>
  <para style="r">(<ref loc="MAT 5:13">Matia 5:13</ref>; <ref loc="MRK 9:50">Mak 9:50</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34" />
    <char style="wj">“Chʉəʼ nɔ bʉ̀ʉ, bɔŋ kaʼ məsʉ́ʼnə-i mì, bə chìi təka i bu bʉ̀nə kə́ sʉ́ʼnə?</char> <verse eid="LUK 14:34" /><verse number="35" style="v" sid="LUK 14:35" /><char style="wj">I leʼ kie nubɛʼkə ndə məchìi mu kəchɔʼ fɛ, byuunɔ ndə məbɛ ŋkwoŋkwo fɛ. Bə mɛ̀ʼ. Wotəmiyɔŋ ndə ɔ kie tyunəkə ndə məyʉ́, ɔ̈ yʉ́.”</char><verse eid="LUK 14:35" /></para>
  <chapter eid="LUK 14" />
  <chapter number="15" style="c" sid="LUK 15" />
  <para style="s">Mbyu binjyʉʉ bɛ́nə</para>
  <para style="r">(<ref loc="MAT 18:12-14">Matia 18:12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1" />Bʉə fí tashi ghɔŋbə bʉə-bʉ̂ʼʉ kə́ kə́nə mbʉə-Jiso ndə məyʉ́ nukə ndə ɔ bu gìe. <verse eid="LUK 15:1" /><verse number="2" style="v" sid="LUK 15:2" />Bʉə-Falasi ghɔŋbə bʉə dàhə nuʼ-Mushi kə́ luŋtə ghɔ̀ŋ mbɔ, “Wo-ɔ̄ tʉʼ fí bʉə-bʉ̂ʼʉ, kə́ yú fɔbə ghɔŋ bɔŋ.”<verse eid="LUK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 15:3" />Ndʉʉghɔfii, Jiso mɔ̀ʼ chəŋkə-ɔ̄ŋ tʉ bɔŋ mbɔ, <verse eid="LUK 15:3" /><verse number="4" style="v" sid="LUK 15:4" /><char style="wj">“Kaʼ a kie binjyʉʉhə ghyʉʉ mbyu imɔʼ fɔ̀ʼ ŋwɔŋ-ɛŋ mu bɔŋ gɛ̀ bɛ́, a bu mɛ̀ʼtə bəʼ-njuɔ-bɔmɔʼ-nə-wuŋ-bɔmɔʼ-kə muŋkɔ, gɛ̀ hə bɔ̌ŋ mbyu imɔʼ-ɛ tə i gɛ̀ nyíɛ ɔŋ fe?</char> <verse eid="LUK 15:4" /><verse number="5" style="v" sid="LUK 15:5" /><char style="wj">Ndʉʉghɔfii, a bu bɛ̀ʼ mbəʼhə-a nə tʉʉjyu gɛ̀ nə yɔŋ chunjaa.</char> <verse eid="LUK 15:5" /><verse number="6" style="v" sid="LUK 15:6" /><char style="wj">A kʉ̂ʉ dàa chunjaa nɔ, chə̀ŋ bətieŋkɔŋ-ba ghɔŋbə bʉə-kətoʼ-ba, bii bɔŋ nʉ́ətə bʉʼka mbɔ a nɔʼ nyíɛ binjyʉʉ-a ndə ɔ kə bɛ́ le.</char> <verse eid="LUK 15:6" /><verse number="7" style="v" sid="LUK 15:7" /><char style="wj">Nɔ bɛ haʼ nɔ ndə tʉʉjyu bu bɛ yuo daa, kaʼ mbyu wo-bʉ̂ʼʉ imɔʼ shìe liɛŋ-ɛŋ bʉ̀nə tʉ Nyii, tə chàa ndə i bɛ tʉ bʉə njuɔ bɔmɔʼ nə wuŋ bɔmɔʼ ndə bɔ̂ŋ bɛ bʉə-kəŋgie-shʉəŋ təmə nɔʼ fɔ̀ʼ ŋwɔŋ-yʉə ndəŋ fia-Nyii fɛ.</char><verse eid="LUK 15:7" /></para>
  <para style="s">Kyʉə bɛ́nə</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8" />
    <char style="wj">“Byuunɔ, kaʼ woke kie mbyu-kyʉə-hə wuŋ, mbyu imɔʼ bɛ́, ɔ chúʼ kɛʼɛ kʉ́ʉ tɔʼ-byûu-hə inchəŋ yʉ̀əʼ mu njaa tə yi nyíɛ fe?</char> <verse eid="LUK 15:8" /><verse number="9" style="v" sid="LUK 15:9" /><char style="wj">Ndʉʉ ndə ɔ nyíɛ, ɔ bu tíi bəwoke-bi ghɔŋbə bʉə-kətoʼ-bi, ghɔ̀ŋ tʉ bɔŋ mbɔ, ‘B̈ii gwè b̈ʉʼʉ nʉ́ətə, bʉʼka mbɔ mɔ nɔʼ nyíɛ mbʉ kyʉə ndə i kə bɛ́ le.’</char> <verse eid="LUK 15:9" /><verse number="10" style="v" sid="LUK 15:10" /><char style="wj">Tʉʉjyu nɔ bɛ haʼ nɔ bəshʉ bʉəntəŋNyii ndʉʉ ndə mbyu wo shìe liɛŋ ndəŋ bʉ̂ʼʉ-e.”</char><verse eid="LUK 15:10" /></para>
  <para style="s">Vaa bɛ́nə</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11" />Jiso bìʼ gɛ̀ nə shʉbə ghɔ̀ŋ mbɔ, <char style="wj">“Wobɛʼ nɔ nə kie vâabələŋ-bi bəbûu.</char><figure style="fig" alt="The lost son" file="cn01759C.tif" size="col" copy="David C. Cook" ref="15:11">Vaa bɛ́nə</figure> <verse eid="LUK 15:11" /><verse number="12" style="v" sid="LUK 15:12" /><char style="wj">Vaa bɔ̌ŋ gìe tʉ tie-e mbɔ, ‘Baba, kɔ́ yɔŋ-yə via-bəfɔ-kə-a nduɔ.’ Ndʉʉmɛ, tie-yʉə gyʉ̀əhə fɔbə-bi kətʉ-bɔŋ bəbûu.</char><verse eid="LUK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 15:13" />
    <char style="wj">“Mbyu-bəchî-hə tíŋ məniʼ, vaa-bɔ̌ŋ-ɛ̄ŋ fɛ̀ŋ yi-via-bəfɔ-kə, lʉ̀ kyʉə-ɛ gɛ̀ lɔʼɔ kətə̂ŋbɛʼ dɔdɔ, gɛ̀ yú bʉ́əhə nə mbunə.</char> <verse eid="LUK 15:13" /><verse number="14" style="v" sid="LUK 15:14" /><char style="wj">Ndʉʉ ndə mbʉ kyʉə mì, chyʉʉ gwù lɔʼɔ-ghɔ̄, ɔ chʉ́ʉhə mədùʼ nə jyʉʉ.</char> <verse eid="LUK 15:14" /><verse number="15" style="v" sid="LUK 15:15" /><char style="wj">Ɔ gɛ̀ kʉ́ʉ fɔ̀ʼ kəghɔ-wobɛʼ, ɔ lʉ̀ ɔ ndəŋ vaafɔ̀ʼ-ɛ, kɔ́ ɔ, ɔ gɛ̀ kə́ yúʼ bəŋkwunyaa-bi,</char> <verse eid="LUK 15:15" /><verse number="16" style="v" sid="LUK 15:16" /><char style="wj">təmə wo kə́ kɔ́ fɔkə tʉ ɔŋ fɛ. Jyʉʉ kɛŋ yɔ́ʼ vaa-ghɔ̄, tə ɔ kə́ fìnə fɔ-bəŋkwunyaa-bə nɔ, i kə́ lòʼnə ɔŋ ndə məyú.</char> <verse eid="LUK 15:16" /><verse number="17" style="v" sid="LUK 15:17" /><char style="wj">Ɔ ghɔ̀ŋ tʉ ŋwɔŋ-ɛŋ mbɔ, ‘Nyíɛ! Mɔ dùʼ nɔ fɛ̄ŋ kə́ kwú jyʉʉ, vâafɔʼɔ tie-ɔ bənchəŋ kie fɔyubə tə kə́ byúu nu-chìi-kə nə yɔŋ.</char> <verse eid="LUK 15:17" /><verse number="18" style="v" sid="LUK 15:18" /><char style="wj">Mɔ bu lɔ̀ hə sê bʉ̀nə gɛ̀ tʉ tie-ɔ ghɔ̀ŋ tʉ ɔŋ mbɔ, “Tie-ɔ, mɔ nɔʼ chìi bʉ̂ʼʉ tʉ Nyii ghɔŋbə mbəŋ-aŋ,</char> <verse eid="LUK 15:18" /><verse number="19" style="v" sid="LUK 15:19" /><char style="wj">mɔ leʼ kʉ̀ʼnə ndə məbɛ vaa-a fɛ. Tie-ɔ, lʉ̀ mɔ ndə vaafɔ̀ʼ-a.” ’</char><verse eid="LUK 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 15:20" />
    <char style="wj">“Ndʉʉmɛ, ɔ lɔ̀ hə sê bʉ̀nə gɛ̀ nyíɛ tie-e, ɔ kʉ̂ʉ gɛ̀ tə dʉ̀ʼ tʉkə-i dɔdɔ, tie-e dùhə nyíɛ ndə ɔ tʉʼ gwè, ɔ kie tʉvyiikə nyʉ́ʉ gɛ̀ yá ɔ, bɔ́nə shyìitə ɔŋ.</char> <verse eid="LUK 15:20" /><verse number="21" style="v" sid="LUK 15:21" /><char style="wj">Mbʉ vaa-ɛ gìe tʉ ɔŋ mbɔ, ‘Tie-ɔ, mɔ nɔʼ chìi bʉ̂ʼʉ tʉ Nyii ghɔŋbə mbəŋ-aŋ, mɔ leʼ kʉ̀ʼnə ndə məbɛ vaa-a fɛ.’</char><verse eid="LUK 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 15:22" />
    <char style="wj">“Tie-e bʉ̀nə leʼ ghɔŋbə tʉ vâafɔʼɔ-bi mbɔ, ‘B̈ii chʉʼ gɛ̀ kɛŋ gwè nə yʉʼ ndyi mu njaa gwè mɔ̀ʼ mbʉə-ɔ, bɔŋleʼ gwè nə vaafyîi kɔ́ kəghɔ-ɔ leʼnə takwubə kɔ́ kəwu-ɔ.</char> <verse eid="LUK 15:22" /><verse number="23" style="v" sid="LUK 15:23" /><char style="wj">Bɔŋleʼ yí yʉʼ vaa-naʼ yɔ́ʼhə. Bʉʼʉ bu yaʼ yú məgwe-e.</char> <verse eid="LUK 15:23" /><verse number="24" style="v" sid="LUK 15:24" /><char style="wj">Bʉʼka mbɔ, vaa-ɔŋ-yɔ̄ŋ nɔʼ kə kwú bɔŋ nɔʼ bʉ̀nə kóʼ, ɔ nɔʼ kə bɛ́ bə bɔŋ nyíɛ ɔŋ.’ Ndʉʉghɔfii, bɔ̂ŋ chʉ́ʉhə məyú.</char><verse eid="LUK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25" />
    <char style="wj">“Ndə bə tʉʼ fʉ̀ʼ le, fəŋ vaa-ɛ kə́ bɛ mutɔ fɔ̀ʼ fɔʼɔ. Ɔ kʉ̂ʉ bʉ̀nə tə kə́ kə́ŋhə chunjaa yʉ́ lyuukə ghɔŋbə ŋkʉʉkə.</char> <verse eid="LUK 15:25" /><verse number="26" style="v" sid="LUK 15:26" /><char style="wj">Ɔ bíʼtə tʉ ibɛʼ-yə vaafɔ̀ʼ nə nukə ndə i bɛ sê.</char> <verse eid="LUK 15:26" /><verse number="27" style="v" sid="LUK 15:27" /><char style="wj">Ɔ ghɔ̀ŋ tʉ ɔŋ mbɔ, ‘Liŋ-aŋ nɔʼ bʉ̀nə, tie-a yí yʉʼ vaa-naʼ yɔ́ʼhə kɔ́, bɔ̂ŋ kə́ yú ndə ɔ bʉ̀nə tʉ ɔŋ shʉ́əshʉ́ə.’</char><verse eid="LUK 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28" />
    <char style="wj">“Tʉʉ-i byʉ́ʼ, ɔ tɛ́ŋ məsʉ́ʉ mu njaa. Tie-e fyú mbi fʉ̀ʉtə ɔŋ.</char> <verse eid="LUK 15:28" /><verse number="29" style="v" sid="LUK 15:29" /><char style="wj">Mbʉ fəŋ vaa bə̀ŋhə tʉ tie-e mbɔ, ‘Ndəŋ ŋgʉʼhə-ɔ̄ŋ inchəŋ, mɔ nɔʼ fɔ̀ʼ tʉ a shʉ́əshʉ́ə təmə nɔʼ nə chɔ́ʼ chu-a ndəŋ mbyu kənu imɔʼ fɛ. Ndəŋ ŋgʉʼhə-ɔ̄ŋ inchəŋ təmə a nɔʼ nə kɔ́ vaabi tʉ mɔ mbɔ baʼa bətieŋkɔŋ-bɔŋ leʼ yú chîmbikə chɔ fɛ.</char> <verse eid="LUK 15:29" /><verse number="30" style="v" sid="LUK 15:30" /><char style="wj">Bɔŋ vaa-a-yɔ̄ŋ kʉ̂ʉ bʉ̀nə nɔʼ gɔ̀ kyʉə-a nə mbunə ghɔŋbə bəsɔkʉʉ, a yí yʉʼ vaa-naʼ yɔ́ʼhə-īŋ ndə mənʉ́ətə məbʉnə-i chɔ.’</char> <verse eid="LUK 15:30" /><verse number="31" style="v" sid="LUK 15:31" /><char style="wj">Tie-e bə̀ŋhə mbɔ, ‘Nyíɛ, ŋaʼ! Bâʼa nɔ bɛ mɔʼɔ, fɔbə-ɔŋ nchəŋnchəŋ-ɛŋ nɔ bɛ ya-yə.</char> <verse eid="LUK 15:31" /><verse number="32" style="v" sid="LUK 15:32" /><char style="wj">Bɔŋ bâʼa nɔ kie ndə mə-yaʼ-yú chîmbikə-ɔ̄ŋ laa, liŋ-aŋ-yɔ̄ŋ nɔʼ kə kwú bɔŋ bʉ̀nə kóʼ! Ɔ nɔʼ kə bɛ́ bə bɔŋ nɔʼ nyíɛ ɔŋ nduɔ.’ ”</char><verse eid="LUK 15:32" /></para>
  <chapter eid="LUK 15" />
  <chapter number="16" style="c" sid="LUK 16" />
  <para style="s">Chəŋ-vaafɔ̀ʼkwɛʼtəŋ-kə ndə shʉ-i súunə</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1" />Jiso ghɔ̀ŋ tʉ vâafɔʼɔ-bi mbɔ, <char style="wj">“Wo-kəfʉʼbɛʼ nɔ nə bɛ ghɔ ndə ɔ kie vaafɔ̀ʼ-ɛ, ɔ kə́ lɛ́nə fɔbə-i, bə mɔ̀ʼ nukə kətʉ mbʉ vaafɔ̀ʼkwɛʼtəŋ-ɛŋ mbɔ ɔ la tʉʼ chìi mbunə nə fɔbə-i.</char> <verse eid="LUK 16:1" /><verse number="2" style="v" sid="LUK 16:2" /><char style="wj">Mbʉ wo-kəfʉʼ tíi ɔ, bíʼtə tʉ ɔŋ mbɔ, ‘Bɛ ka ndə mɔ tʉʼ yʉ́ te nə naŋ la? Nyɔ̀ʼ, shyíi mɔ nə ntɛ ndə a tʉʼ tɛ́nɛ nubə nə kyʉə ghɔŋbə fɔbə, bʉʼka fɔʼɔ-a nɔʼ lìʼ laa.’</char><verse eid="LUK 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 16:3" />
    <char style="wj">“Mbʉ vaafɔ̀ʼkwɛʼtəŋ ghɔ̀ŋ tʉ ŋwɔŋ-ɛŋ mbɔ, ‘Mɔ bu bɛ təka? Tiefɔʼ-ɔ tʉʼ kʉ́ʉ jə̀ŋ mɔ ndə yəŋ-fɔ̀ʼ-kə-ɔŋ. Mɔ kie ghʉəʼkə ndə mələ̀ŋ ndəŋkə fɛ, tʉkə-ɔŋ bɔŋ kə́ vyíi ndə ghaabə.</char> <verse eid="LUK 16:3" /><verse number="4" style="v" sid="LUK 16:4" /><char style="wj">Mɔ nɔ kínə nukə ndə mɔ bu chìi, kaʼ mɔ bɛ́ fɔʼɔ-ɔ fɛ̄ŋ, bʉə chʉʼ fí mɔ mu njaa-bɔŋ.’</char><verse eid="LUK 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5" />
    <char style="wj">“Ɔ gyʉ̀əhə ntəŋhə tʉ bʉə-ŋkwo-tiefɔʼ-ɛ mbɔ bɔ̂ŋ la gwè nyíɛ ɔŋ. Ɔ bíʼtə tʉ fəŋ mbɔ, ‘Kyʉə-tiefɔʼ-ɔ bɛ kəghɔ-a ntyʉʉ təka?’</char> <verse eid="LUK 16:5" /><verse number="6" style="v" sid="LUK 16:6" /><char style="wj">Ɔ bə̀ŋhə mbɔ, ‘Bəjɔkə-məŋgwo ghyʉʉ.’ Mbʉ vaafɔ̀ʼkwɛʼtəŋ gìe tʉ ɔŋ mbɔ, ‘Dùʼ sê gyʉ̀əhə ŋkwo-a yəŋbə ibûu.’</char><verse eid="LUK 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 16:7" />
    <char style="wj">“Ɔ bíʼtə tʉ biitəkə mbɔ, ‘Ya-yə bɛ ntyʉʉ təka?’ Ɔ bə̀ŋhə mbɔ, ‘Bəkwo-lɛshi ghyʉʉ.’ Ɔ gìe tʉ ɔŋ mbɔ, ‘Nyɔ̀ʼ ŋwɔʼnə fefe ndə məshyʉ̀ʉ gyʉʉ mbɔ nɔ bɛ wuŋ fɔŋ.’ Ɔ fɔ̀ʼ haʼ nɔ nə bʉə bənchəŋ ndə bɔŋ kie ŋkwo tiefɔʼ-ɛ.</char><verse eid="LUK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 16:8" />
    <char style="wj">“Ndʉʉ ndə mbʉ tiefɔ̀ʼ yʉ́ yɔ̄ŋ-yə, ɔ bɛ́ŋ mbʉ wo-fɔ̀ʼ bʉəbʉə bʉʼka mbɔ ɔ fɔ̀ʼ nə shʉ súunə. Bʉə-kəwʉʉnəmbi nɔ kínə ntɛ-kənu ndə bɔŋ tʉʼ fɔ̀ʼ nə ntɛ-yʉə, bɔŋ bʉə ndə bɔ̂ŋ kínə Nyii kaa nɔ fɛ.”</char> <verse eid="LUK 16:8" /><verse number="9" style="v" sid="LUK 16:9" />Jiso gɛ̀ nə shʉbə ghɔ̀ŋ mbɔ, <char style="wj">“Lʉ̀ fɔ-kəwʉʉnəmbi-bə-ɔ̄ŋ, chìi bətiekənu chɔ kəchisê-fɛ̄ŋ, mbɔ ndʉʉ ndə i bu mì nɔ, Nyii fí a ntoʼ-ɔ təmə i mə nə lìʼ fɛ.</char><verse eid="LUK 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 16:10" />
    <char style="wj">“Wotəmiyɔŋ ndə bəkɔ ɔ gìe shʉəŋ ndəŋ vaa-kəfɔ tîetîe, bəkɔ ɔ gìe shʉəŋ ndəŋ ŋkwê kəfɔ. Wo ndə ɔ mə gìe shʉəŋ ndəŋ vaa-kəfɔ məniʼ fɛ, ɔ mə gìe shʉəŋ ndəŋ ŋkwê kəfɔ fɛ.</char> <verse eid="LUK 16:10" /><verse number="11" style="v" sid="LUK 16:11" /><char style="wj">Kaʼ bə gòʼ təmə nyíɛ bii ndə bʉə-shʉəŋ ndəŋ fɔ-kəwʉʉnəmbi-bə-ɔ̄ŋ fɛ, bii kwɔ̀ʼtə mbɔ bu kɔ́ nda kɔ́ ŋkɛŋ kəfʉʼ tʉ bii?</char> <verse eid="LUK 16:11" /><verse number="12" style="v" sid="LUK 16:12" /><char style="wj">Kaʼ bii gòʼ təmə gìe shʉəŋ ndəŋ fɔ-wo-kədɔŋ-bə fɛ, bii kwɔ̀ʼtə mbɔ bu kɔ́ nda kɔ́ fɔbə tʉ bii ndə bu bɛ yii-yə?</char><verse eid="LUK 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13" />
    <char style="wj">“Vaafɔ̀ʼ mə kie bətiefɔʼɔ bəbûu fɛ, bʉʼka ɔ bu bàa imɔʼ kʉ̀ʉ ibɛʼ-yə, byuunɔ ɔ bu kɔ́ fyii-i tʉ imɔʼ, jɛ́ŋhə ibɛʼ-yə. Nyii ghɔŋbə fɔ-kəwʉʉnəmbi-bə mə bɛ bətiefɔʼɔ-ba bənchəŋ fɛ.”</char><verse eid="LUK 16:13" /></para>
  <para style="s">Nubɛʼbə ndə Jiso kə dàhə</para>
  <para style="r">(<ref loc="MAT 11:12-13">Matia 11:12-13</ref>; <ref loc="MAT 5:31-32">5:31-32</ref>; <ref loc="MRK 10:11-12">Mak 10:11-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14" />Bʉə-Falasi ndə bɔ̂ŋ kʉ̀ʉ fɔ-kəwʉʉnəmbi-bə daa, kʉ̂ʉ yʉ́ ŋgiekə-ɔ̄ŋ, bíe chu-yʉə tʉ Jiso. <verse eid="LUK 16:14" /><verse number="15" style="v" sid="LUK 16:15" />Jiso ghɔ̀ŋ mbɔ, <char style="wj">“Nɔ, bii ndə bii tʉʼ dʉ̀ʼ ŋwɔŋ-yii mu bʉə mbɔ bii bɛ ndyʉndyʉ, bɔŋ Nyii nɔ kínə fyiihə-ii. Fɔkə ndə i gʉ́ə tʉ woməsʉʉ i nɔ byʉ́ʼ tʉ Nyii.</char><verse eid="LUK 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16" />
    <char style="wj">“Bə nɔ lɔ̀ʼ nuʼ-Mushi ghɔŋbə nubə ndə bʉəyʉkəŋgieNyii nɔʼ nə nyɔ̀ʼ tə vɛʼ kʉ̀ʼnə ndə Jɔŋ kə gwè kə́ lɔ̀ʼ ŋgieNyiikə. Lʉ̀ hə vɛʼ-ghɔ̄ bə nɔʼ téʼ ntəŋjyujyu te Sɔ́ʼ-Nyii, bʉə bənchəŋ kə́ fʉʼ fʉʼkə ndə məŋíi chɔ.</char> <verse eid="LUK 16:16" /><verse number="17" style="v" sid="LUK 16:17" /><char style="wj">Bɔŋ i nɔ yùhə tʉ yuo ghɔŋbə chisêkə ndə məmì tə chàa mbɔ vaadyʉʼʉ kəŋgie i bɛ́ ndə nuʼ-Nyii-ɔ̄ŋ.</char><verse eid="LUK 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18" />
    <char style="wj">“Wotəmiyɔŋ ndə ɔ wɔ̀ʼtə lɔŋ ghɔŋ vi-i lʉ̀ yi-kədɔŋ-yə nɔʼ gháa bəsəŋ bɔŋ woləŋ ndə ɔ leʼ lʉ̀ woke ndə ɔ nɔʼ wɔ̀ʼtə lɔŋ ghɔŋ ləŋ-ɛŋ nɔʼ gháa bəsəŋ ghɔ.</char><verse eid="LUK 16:18" /></para>
  <para style="s">Wo-kəfʉʼ ghɔŋ Lasalɔ</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19" />
    <char style="wj">“Wo-kəfʉʼbɛʼ nɔ nə bɛ ghɔ ndə ɔ kə́ mɔ̀ʼ mbʉətə ndyi kəmbuu fʉ́əŋ mbʉə-ɔ ghɔŋbə vaa-mbʉətə-ndyi mu mbʉə ndə i bʉ̀ʉ haʼ bʉ̀ʉ, kə́ yú yu-bəfɔŋ-kə bəchibəchi.</char> <verse eid="LUK 16:19" /><verse number="20" style="v" sid="LUK 16:20" /><char style="wj">Wo-mbʉʼbɛʼ ndə yie-e kə bɛ Lasalɔ ndə mbʉə-e bɛ bədyʉʼbədyʉʼ, nɔ nə kə́ dùʼ chulɔŋ fu wo-ɔ̄,</char> <verse eid="LUK 16:20" /><verse number="21" style="v" sid="LUK 16:21" /><char style="wj">kə́ chyìi ndə məlɛ̀ʼtə kwuʼkwuʼ-bəfɔ ndə i tʉʼ gwùtə hə kəghɔ mbʉ wo-kəfʉʼ. Tə bûhə kə́ gwè líatə mbʉ bədyʉʼ-ghɔ̄.</char> <verse eid="LUK 16:21" /><verse number="22" style="v" sid="LUK 16:22" /><char style="wj">Mbʉ wo mbʉʼ sɛŋ kwú, bʉəntəŋNyii lʉ̀ ɔ gɛ̀ dùʼhə ɔŋ mbʉə Ablahaŋ. Mbʉ wo-kəfʉʼ sɛŋ kwú ghɔ, bə tyúu ɔ.</char> <verse eid="LUK 16:22" /><verse number="23" style="v" sid="LUK 16:23" /><char style="wj">Ɔ dùʼ mu viʼi kə́ nyíɛ ŋgʉəʼ, kʉ̂ʉ nə sɛŋ chɔ̀ʼhə shʉ-i kweghɔʼ nyíɛ Ablahaŋ kɛŋ dɔdɔ, Lasalɔ kə́ dùʼ mbʉə ɔ.</char><verse eid="LUK 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 16:24" />
    <char style="wj">“Ɔ tíi ɔ mbɔ, ‘Tie-ɔ Ablahaŋ, kə ẗʉkə-a vyíi ndəŋ mɔ le! Tə́ŋ Lasalɔ, ɔ sʉ́ʉhə tʉ-vaa-kəghɔ-kə-i mu muu gwè nə yɔŋ, gwè yùʼ lɛɛŋhəkə-ɔŋ chɔ, bʉʼka mbɔ mɔ nɔ bɛ mu ŋgʉəʼ shʉ́əshʉ́ə mu viʼi-fɛ̄ŋ.’</char><verse eid="LUK 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25" />
    <char style="wj">“Ablahaŋ bə̀ŋhə mbɔ, ‘Ŋaʼ, kwɛ́nə mbɔ vɛʼ ndə a kə bɛ mu kəwʉʉnəmbi, a kie fɔ-jyujyu-bə-a, Lasalɔ kie yi-yə fɔ-bʉəbʉə-bə, bɔŋ nduɔ ɔ kə́ bɛ jyujyu yá mbəŋ kə́ nyíɛ ŋgʉəʼ.</char> <verse eid="LUK 16:25" /><verse number="26" style="v" sid="LUK 16:26" /><char style="wj">Bɔŋ ndə nchəŋnchəŋ bənu-ɔ̄ŋ, ntəŋntəŋ bʉʼʉ bə nɔʼ tyúu ghuu təmə wo mə lɔ̀ hə mbʉə a dàa fɛ̄ŋ fɛ, təmə bɔŋ mə lɔ̀ hə mbʉə baʼa dàa kəvia-a fɛ.’</char><verse eid="LUK 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 16:27" />
    <char style="wj">“Mbʉ wo-ghɔ̄ bə̀ŋhə mbɔ, ‘Mɔ nɔ fʉ̀ʉtə a, tie-ɔ, tə́ŋ Lasalɔ fu-bətie-ɔ,</char> <verse eid="LUK 16:27" /><verse number="28" style="v" sid="LUK 16:28" /><char style="wj">mɔ nɔ kie bəliŋ-bɔŋ bələŋ bətaa, ɔ̈ gɛ̀, shyùu tyunəkə-ʉə bʉʼka bɔ̂ŋ mə yi gwè mu ŋgʉəʼ fɛ̄ŋ ghɔ.’</char><verse eid="LUK 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29" />
    <char style="wj">“Ablahaŋ bə̀ŋhə mbɔ, ‘Bɔ̂ŋ nɔ kie nuʼ-Mushi ghɔŋbə bəŋwɔʼnə-bʉəyʉkəŋgieNyii kəghɔ-bɔŋ, b̈ɔ̂ŋ yʉ́ nukə ndə i tʉʼ gìe.’</char><verse eid="LUK 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 16:30" />
    <char style="wj">“Ɔ bə̀ŋhə mbɔ, ‘Mbee, tie-ɔ Ablahaŋ, ndʉʉbɛʼ kaʼ wo lɔ̀ hə mu bəŋkwusê gɛ̀ kwə́ʼ tʉ bɔŋ, bɔ̂ŋ shìe liɛŋ ndəŋ bʉ̂ʼtə-ʉə.’</char><verse eid="LUK 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 16:31" />
    <char style="wj">“Ablahaŋ ghɔ̀ŋ tʉ ɔŋ mbɔ, ‘Kaʼ bɔ̂ŋ gòʼ təmə yʉ́ nukə ndə Mushi ghɔŋbə bʉəyʉkəŋgieNyii nyɔ̀ʼ fɛ, wo mə yi kóʼ bə mu bəŋkwusê, kɔ̀ɔtə ndə məlóʼtə bɔŋ, bɔ̂ŋ yʉ́ ɔ fɛ.’ ”</char><verse eid="LUK 16:31" /></para>
  <chapter eid="LUK 16" />
  <chapter number="17" style="c" sid="LUK 17" />
  <para style="s">Məmùutə wo mbɔ ɔ chìi bʉ̂ʼʉ</para>
  <para style="r">(<ref loc="MAT 18:6-7">Matia 18:6-7</ref>,<ref loc="MAT 18:21-22">21-22</ref>; <ref loc="MRK 9:42">Mak 9:42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1" />Jiso ghɔ̀ŋ tʉ vâafɔʼɔ-bi mbɔ, <char style="wj">“Ndə nubə ndə i mùutə wo mbɔ ɔ chìi bʉ̂ʼʉ nɔ kie ndə məgwè, bɔŋ ŋgʉəʼ bu bɛ kətʉ wo ndə nubə-ɔ̄ŋ bu gwè hə kəghɔ-ɔ.</char> <verse eid="LUK 17:1" /><verse number="2" style="v" sid="LUK 17:2" /><char style="wj">I nɔ bʉ̀ʉ mbɔ b̈ə chyúu lɔkɔʼ tê mii-ɔ, mɛ̀ʼ ɔŋ mu muukwɛʼtəŋmə, ndə kaʼ kʉ̀ʼnə mbɔ ɔ̈ shyùu mbyu vaa mu vâa-bɔ̄ŋ ɔ chìi bʉ̂ʼʉ.</char> <verse eid="LUK 17:2" /><verse number="3" style="v" sid="LUK 17:3" /><char style="wj">B̈ii láa le!</char></para>
  <para style="p" vid="LUK 17:3">
    <char style="wj">“Kaʼ liŋ-aŋ chìi bʉ̂ʼʉ, ä sɔ́ʼ ɔ, kaʼ ɔ shìe liɛŋ-ɛŋ ndəŋ nu-ghɔ̄-kə, ä sʉ̀fyii-a.</char> <verse eid="LUK 17:3" /><verse number="4" style="v" sid="LUK 17:4" /><char style="wj">Kaʼ ɔ chìi bʉ̂ʼʉ tʉ a vɛʼ təkwiitia mu chîmbikə imɔʼ, bʉ̀nə gwè vɛʼ təkwiitia ghɔ̀ŋ tʉ a mbɔ, ‘Mɔ nɔʼ shìe liɛŋ-ɔŋ ndəŋ mbʉ bʉ̂ʼʉ,’ ä sʉ̀fyii-a ndəŋ ɔŋ.”</char><verse eid="LUK 17:4" /></para>
  <para style="s">Məmɔ̀ʼfyii</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5" />Mbʉ bəlɔntəŋNyii gìe tʉ Tiekətʉ mbɔ, “Chìi məmɔʼfyii-yaʼ ndəŋ Nyii bìʼ shʉ́ə gɛ̀ nə shʉbə.”<verse eid="LUK 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6" />Ɔ bə̀ŋhə mbɔ, <char style="wj">“Kaʼ məmɔʼfyiihə-ii ndəŋ Nyii tə́ʼ tə bɛ nə ŋgwie-kîa, bəkɔ bii gìe tʉ ŋkwê kətyʉ-ɔ̄ mbɔ, ‘Sòʼnə sê gɛ̀ bè ŋwɔŋ-aŋ mu muukwɛʼtəŋmə,’ i bɔŋ yʉ́ chu-a.</char><verse eid="LUK 17:6" /></para>
  <para style="s">Fɔʼɔ-vâafɔʼɔ</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7" />
    <char style="wj">“Lʉ̀ nduɔ mbɔ mbyu wo mu bii nɔ kie vaafɔ̀ʼ-ɛ, ɔ kə́ lə̀ŋ ndəŋkə byuunɔ kə́ chyìi binjyʉʉhə. Ɔ məghɔ̀ŋ tʉ ɔŋ vɛʼ ndə ɔ bʉ̀nə muŋkɔ mbɔ, ‘Gwè dùʼ sê yú fɔbə’ mɛ?</char> <verse eid="LUK 17:7" /><verse number="8" style="v" sid="LUK 17:8" /><char style="wj">Ɔ kʉʉ ghɔŋ bə mbɔ, ‘Chìi fɔbə, shʉ̀tə ŋwɔŋ-aŋ ndə məkɔ́ fɔbə tʉ mɔ, kwìhə m̈ɔ yú bɔŋ nú a buŋ yú ya-yə’ fe?</char> <verse eid="LUK 17:8" /><verse number="9" style="v" sid="LUK 17:9" /><char style="wj">Ɔ bu kɔ́ ndɔ tʉ vaafɔ̀ʼ-ɛ ndəŋ fɔ̀ʼ ndə ɔ kie ndə məfɔ̀ʼ mɛ? Mɔ laa fɛ.</char> <verse eid="LUK 17:9" /><verse number="10" style="v" sid="LUK 17:10" /><char style="wj">Mbəŋ-aŋ ghɔ ndʉʉ ndə a nɔʼ fɔ̀ʼ nubə nchəŋnchəŋ ndə Nyii ghɔ̀ŋ mbɔ a fɔ̀ʼ nɔ, a gìe tʉ ɔŋ mbɔ, ‘Baʼa nɔ bɛ haʼ vâafɔʼɔ-ba, kə́ fɔ̀ʼ haʼ nukə ndə kə bɛ fɔʼɔ-yaʼ.’ ”</char><verse eid="LUK 17:10" /></para>
  <para style="s">Jiso chʉ́ʼ bʉə-kəlɔ wuŋ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11" />Ndʉʉ ndə Jiso kə́ gɛ̀ Jɛlosalɛŋ, ɔ tíŋ hə ndəŋ bia Samalia ghɔŋ Galili. <verse eid="LUK 17:11" /><verse number="12" style="v" sid="LUK 17:12" />Ndə ɔ kə́ ŋíi mu ntəʼəbɛʼ, bʉə-kəlɔ wuŋ nyíɛ ɔŋ dɔdɔ, <verse eid="LUK 17:12" /><verse number="13" style="v" sid="LUK 17:13" />tíi nə gyʉʉ dədə ghɔ̀ŋ mbɔ, “Tiekətʉ! Jiso! Kə tʉkə-a vyíi ndəŋ baʼa le!”<verse eid="LUK 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14" />Ndʉʉ ndə ɔ nyíɛ bɔŋ, ɔ gìe tʉ bɔŋ mbɔ, <char style="wj">“B̈ii gɛ̀ dʉ̀ʼ ŋwɔŋ-yii tʉ bʉəfɛ̀ʼndɛŋNyii.”</char></para>
  <para style="p" vid="LUK 17:14">Ndə bɔ̂ŋ kə́ gɛ̀ le bɔ̂ŋ kie nchʉʼ. <verse eid="LUK 17:14" /><verse number="15" style="v" sid="LUK 17:15" />Wo-imɔʼ mu bɔŋ kʉ̂ʉ nyíɛ mbɔ ɔ nɔʼ kie nchʉʼ, bʉ̀nə gɛ̀ kə́ tòʼ lə̀ʼtə Nyii nə gyʉʉ dədə. <verse eid="LUK 17:15" /><verse number="16" style="v" sid="LUK 17:16" />Ɔ gɛ̀ kwíʼtə bəshʉ Jiso nə shʉ-i sê, kə́ kɔ́ ndɔ ɛ. Ɔ nɔ nə bɛ wo-Samalia. <verse eid="LUK 17:16" /><verse number="17" style="v" sid="LUK 17:17" />Jiso bə̀ŋhə mbɔ, <char style="wj">“Bii kə bɛ wuŋ, ndə bii kie nchʉʼ fe? Bəbɛʼbʉə bɔmɔʼ ba?</char> <verse eid="LUK 17:17" /><verse number="18" style="v" sid="LUK 17:18" /><char style="wj">Wobɛʼ kə bɛ ghɔ ndə bəkɔ ɔ gwè lə̀ʼtə Nyii fɛ, yaʼkɛŋ wokətə̂ŋ-ɔ̄ŋ mɛ?”</char> <verse eid="LUK 17:18" /><verse number="19" style="v" sid="LUK 17:19" />Ndʉʉghɔfii, ɔ gìe tʉ ɔŋ mbɔ, <char style="wj">“Lɔ̀ hə sê gɛ̀ nə aŋ, məmɔʼfyii-a tʉ Nyii nɔʼ chʉ́ʼ a.”</char><verse eid="LUK 17:19" /></para>
  <para style="s">Məgwe-Sɔ́ʼ-Nyii</para>
  <para style="r">(<ref loc="MAT 24:23-28">Matia 24:23-28</ref>,<ref loc="MAT 24:37-41">37-41</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20" />Nɔ nə bɛ vɛʼbɛʼ nuɔ-bʉə-Falasi bíʼtə tʉ Jiso mbɔ, “Bɛ yɔ̂ŋ-yə ndʉʉ ndə Sɔ́ʼ-Nyii bu gwè?”</para>
  <para style="p" vid="LUK 17:20">Ɔ bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“Məgwè Sɔ́ʼ-Nyii kaa fɔkə ndə bəkɔ bii nyíɛ cheʼkə-i fɛ.</char> <verse eid="LUK 17:20" /><verse number="21" style="v" sid="LUK 17:21" /><char style="wj">Bʉə mə gìe mbɔ, ‘B̈ii nyíɛ! Sɔ́ʼ-Nyii nɔ bɛ fɛ̄ŋ byuunɔ fīi!’ fɛ, bʉʼka Sɔ́ʼ-Nyii nɔ bɛ mu bii.”</char><verse eid="LUK 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22" />Ɔ gìe tʉ vâafɔʼɔ-bi mbɔ, <char style="wj">“Mbʉ bəchî tʉʼ gwè ndə bii bu kʉ̀ʉ ndə mənyíɛ mbyu kəchî Vaa-Woməsʉʉ, təmə bɔŋ kʉʉ nyíɛ fɛ.</char> <verse eid="LUK 17:22" /><verse number="23" style="v" sid="LUK 17:23" /><char style="wj">Bʉə bu gìe tʉ bii mbɔ, ‘B̈ii nyíɛ! Ɔ nɔ bɛ fɛ̄ŋ byuunɔ fīi!’ Kə bii mə gɛ̀ hə bɔ̌ŋ bɔŋ fɛ.</char> <verse eid="LUK 17:23" /><verse number="24" style="v" sid="LUK 17:24" /><char style="wj">Bʉʼka haʼ ndə leʼnə-wyuu-kə leʼnə yuo, i báa lʉ̀ hə ndəŋ viakə imɔʼ gɛ̀ tə liʼ ndəŋ ibɛʼ-yə viakə nɔ, nɔ bɛ haʼ nɔ ndə Vaa-Woməsʉʉ bu yi gwè.</char> <verse eid="LUK 17:24" /><verse number="25" style="v" sid="LUK 17:25" /><char style="wj">Ɔ bɔŋ bu fəŋ nyíɛ ŋgʉəʼ ndəŋ nubə buŋmbi, ŋgwie-wo-ɔ̄ kəchisê fɛ̄ŋ nɔ tɛ́ŋ mɔ.</char><verse eid="LUK 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 17:26" />
    <char style="wj">“Haʼ ndə i nə bɛ ndəŋ vɛʼ Nua, i bu nə bɛ haʼ nɔ, ndəŋ vɛʼ ndə Vaa-Woməsʉʉ bu yi bʉ̀nə gwè.</char> <verse eid="LUK 17:26" /><verse number="27" style="v" sid="LUK 17:27" /><char style="wj">Bʉə nɔ nə kə́ yú, kə́ nú, kə́ gɛ̀ lɔŋ, bɔŋ bə kə́ leʼ kɔ́ lɔŋ tə gɛ̀ dàa ndəŋ chîkə ndə Nua kə ŋíi chɔ mu kəbuukwɛʼtəŋ. Fɔŋ muu gwè yítə bɔŋ bənchəŋ.</char><verse eid="LUK 17:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 17:28" />
    <char style="wj">“I nɔ nə bɛ haʼ nɔ ndəŋ chî-wo-kə ndə wo ndə bə nə kə́ tíi ɔ nə Lɔt. Bʉə kə́ yú, kə́ nú, kə́ chìi mbɛʼnə, kə́ bè fɔyubə, kə́ bɔ́ŋ njaahə.</char> <verse eid="LUK 17:28" /><verse number="29" style="v" sid="LUK 17:29" /><char style="wj">Bɔŋ chîkə ndə Lɔt fyú hə mu Sodɔŋ, viʼi fyìʼnə yuo ghɔŋbə ŋgoʼ-tɔ̀ŋ-hə kyʉ́ʉ bɔŋ bənchəŋ.</char><note caller="+" style="f"><char style="fr" closed="false">17:29 </char><char style="ft" closed="false">Nyíɛ Nchʉʉhə 18:16–19:29 (bə nɔ tíi ŋwɔʼnə-ɔ̄ŋ nə Jɛnɛsi).</char></note> <verse eid="LUK 17:29" /><verse number="30" style="v" sid="LUK 17:30" /><char style="wj">Nɔ haʼ nɔ ndə i bu yi bɛ vɛʼ ndə Vaa-Woməsʉʉ bu yi bʉ̀nə gwè, bə kɛ̀ʼ ɔ.</char><verse eid="LUK 17:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 17:31" />
    <char style="wj">“Kʉ̂ʉ yi bɛ yɔ̂ŋ-ghɔ̄ nɔ, wo ndə ɔ bɛ kətʉ njaa,</char> <note caller="+" style="f"><char style="fr" closed="false">17:31 </char><char style="ft" closed="false">Bʉə-Juu nɔ nə kə́ bɔŋ njaahə-ʉə nɔ bɔ̂ŋ mɔ̀ʼ ghɔ̂ʼ chɔ, lyʉ́ʉ tʉkə-i nə chiabə təmə kwɛ̀ŋkwɛ̀ŋ fɛ. Chìi yuhəbə mbi ndə məkóʼ gɛ̀ kətʉ ghɔ.</char></note> <char style="wj">kə ɔ mə shíʼ sê ndə məlʉ̀ fɔkə mu njaa fɛ. Wo ndə ɔ bɛ mutɔ, kə ɔ məbʉ̀nə ndə məlʉ̀ fɔkə fɛ.</char> <verse eid="LUK 17:31" /><verse number="32" style="v" sid="LUK 17:32" /><char style="wj">B̈ii kwɛ́nə nukə ndə i nə fyú tʉ vi-Lɔt!</char> <verse eid="LUK 17:32" /><verse number="33" style="v" sid="LUK 17:33" /><char style="wj">Wotəmiyɔŋ ndə ɔ tʉʼ kɔ̀ɔtə ndə məkwáa ŋkwiitʉ-e bu bɛ́, bɔŋ wo ndə ɔ kɔ́ ŋkwiitʉ-e, bu kie ŋkwiitʉ-e.</char> <verse eid="LUK 17:33" /><verse number="34" style="v" sid="LUK 17:34" /><char style="wj">M̈ɔ shyíi bii, bʉə bəbûu bu nʉ̀ʉ kəbɔ ndʉʉbətyuʼ-ghɔ̄, bə lʉ̀ mbyu wo-imɔʼ, mɛ̀ʼtə ibɛʼ-yə.</char> <verse eid="LUK 17:34" /><verse number="35" style="v" sid="LUK 17:35" /><char style="wj">Bəke bəbûu bu kə́ gɔ̀ baakə, bə lʉ̀ mbyu wo-imɔʼ, mɛ̀ʼtə imɔʼ.</char> <verse eid="LUK 17:35" /><verse number="36" style="v" sid="LUK 17:36" /><char style="wj">[Bələŋ bəbûu bu kə́ fɔ̀ʼ mutɔ, bə lʉ̀ mbyu wo-imɔʼ, mɛ̀ʼtə mbyu wo-imɔʼ.]”</char><verse eid="LUK 17:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37" />Bɔ̂ŋ bíʼtə tʉ ɔŋ mbɔ, “Tiekətʉ, i bu bɛ fa?”</para>
  <para style="p" vid="LUK 17:37">Ɔ bə̀ŋhə mbɔ, <char style="wj">“Yəŋkə ndə ŋkwu-wo-kə bɛ chɔ nɔ yəŋkə ndə wuwubə bu chə̀ŋtə chɔ.”</char><verse eid="LUK 17:37" /></para>
  <chapter eid="LUK 17" />
  <chapter number="18" style="c" sid="LUK 18" />
  <para style="s">Chəŋ-kwuʼ-woke-kə ndə ɔ lyʉ̀ʉtə́nə</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1" />Yɔŋbɛʼ, Jiso mɔ̀ʼ chəŋkə tʉ vâafɔʼɔ-bi ndə məchìi bɔŋ kínə mbɔ bɔ̂ŋ nɔ kie ndə mə-kə́-gháaNyii təvɛʼtəvɛʼ təmə kə́ lʉ́ʉtə fɛ. <verse eid="LUK 18:1" /><verse number="2" style="v" sid="LUK 18:2" />Ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Mu kəyəŋkwɛʼtəŋbɛʼ, wokwɛʼtəŋ mu njaafɛʼbɛʼ nɔ nə bɛ chɔ ndə ɔ gòʼ təmə kə́ fàa Nyii fɛ, təmə bɔŋ kə́ fàa woməsʉʉ ghɔ fɛ.</char> <verse eid="LUK 18:2" /><verse number="3" style="v" sid="LUK 18:3" /><char style="wj">Kwuʼ wokebɛʼ nɔ nə bɛ mu kəyəŋ-ghɔ̄ kə́ gɛ̀ tʉ wo-ghɔ̄ sɛŋ gɛ̀, ghɔ̀ŋ tʉ ɔŋ mbɔ, ‘Kə a kwáa mɔ kwɛ̀ fɛʼɛ-ɔ ndyʉndyʉ mɔ yú wobàa-ɔ.’</char> <verse eid="LUK 18:3" /><verse number="4" style="v" sid="LUK 18:4" /><char style="wj">Mbʉ wokwɛʼtəŋ njaafɛ̀ʼ fəŋ jʉhə ɔŋ məniʼ, bɔŋ kəliʼ, ɔ kwɔ̀ʼtə tʉkə-i mbɔ, ‘Mɔ kyinə fàa Nyii fɛ, təmə bɔŋ kə́ fàa woməsʉʉ fɛ,</char> <verse eid="LUK 18:4" /><verse number="5" style="v" sid="LUK 18:5" /><char style="wj">bɔŋ bʉʼka woke-ɔ̄ nɔʼ chɔ́ŋhə mɔ daa, mɔ bu kwɛ̀ fɛʼɛ-ɛ ndyʉndyʉ ɔ̈ yú wobàa-ɛ ndəŋ fɛʼɛ-ɔ̄, byuunɔ təmə ɔ bu chɔ́ŋhə mɔ tə mɔ mì hə kəghɔ-ɔ.’ ”</char><verse eid="LUK 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6" />Tiekətʉ ghɔ̀ŋ mbɔ, <char style="wj">“B̈ii lʉ̀ ndaa ndəŋ nukə ndə wo-ɔ̄ ndə ɔ kyinə kwɛ̀ fɛʼɛ ndyʉndyʉ fɛ kə ghɔŋ.</char> <verse eid="LUK 18:6" /><verse number="7" style="v" sid="LUK 18:7" /><char style="wj">A bɔŋ kə́ kwɔ̀ʼtə nduɔ mbɔ Nyii bu kə́ kwɛ̀ nubə ndyʉndyʉ tʉ bʉə-bi ndə ɔ nɔʼ kə séʼ bɔŋ, ndə bɔ̂ŋ tʉʼ gwía gwè tʉ ɔŋ ndʉʉnəchî ghɔŋbə ndʉʉbətyuʼ fe? A kwɔ̀ʼtə mbɔ ɔ mə jʉhə gwia-yʉə tə i dɔ̀ŋnə mɛ?</char> <verse eid="LUK 18:7" /><verse number="8" style="v" sid="LUK 18:8" /><char style="wj">M̈ɔ shyíi bii mbɔ, ɔ bu kwɛ̀ nubə tʉ bɔŋ ndyʉndyʉ nəndʉʉnəndʉʉ! Buŋ ndə nɔ, ndʉʉ ndə Vaa-Woməsʉʉ bu nə bʉ̀nə gwè nɔ, nyíɛ bʉə ndə bɔ̂ŋ mɔ̀ʼfyiihə-ʉə ndəŋ Nyii kəchisê-fɛ̄ŋ mɛ?”</char><verse eid="LUK 18:8" /></para>
  <para style="s">Wo Falasi* ghɔŋ wo fí tashi</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9" />Jiso mɔ̀ʼ chəŋkə-ɔ̄ŋ tʉ bʉə ndə bɔ̂ŋ mɔ̀ʼfyii ndəŋ ŋwɔŋtə-ʉə, kə́ kwɔ̀ʼtə mbɔ bɔ̂ŋ tə́nə ndyʉndyʉ, kə́ dʉ̀ʉhə bəbɛʼbʉə. <verse eid="LUK 18:9" /><verse number="10" style="v" sid="LUK 18:10" /><char style="wj">“Bələŋbɛʼbə bəbûu nɔ nə kə́ kóʼ gɛ̀ mu njaafɛ̀ʼndɛŋNyii ndə məgɛ̀ gháaNyii. Womɔʼ kə́ bɛ wo-Falasi, ibɛʼ-yə kə́ bɛ wo fí tashi.</char> <verse eid="LUK 18:10" /><verse number="11" style="v" sid="LUK 18:11" /><char style="wj">Mbʉ wo-Falasi lɔ̀ tə́nə kə́ gháaNyii te ŋwɔŋ-ɛŋ kə́ ghɔ̀ŋ mbɔ, ‘Nyii, mɔ nɔ kɔ́ ndɔ a mbɔ mɔ kaa nə bəbɛʼbʉə fɛ, bəlʉʼʉ, bʉə-bʉ̂ʼʉ, bəŋghaa-bəsəŋ təmə bɔŋleʼ bɛ nə wo fí tashi-ɔ̄ fɛ.</char> <verse eid="LUK 18:11" /><verse number="12" style="v" sid="LUK 18:12" /><char style="wj">M̃ɔ nɔ jì muu vɛʼ bûu mu vyii mbi, m̃ɔ nɔ gyʉ̀əhə fɔbə inchəŋ ndə mɔ kie yəŋbə wuŋ, mɔ kɔ́ viakə imɔʼ tʉ Nyii.’</char><verse eid="LUK 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13" />
    <char style="wj">“Bɔŋ wo fí tashi-ghɔ̄ ndə ɔ tə́nə kwɛ̀ʼtə mbʉə ɔ, təmə ɔ kʉ̀ʉ ndə mə-buŋ-chɔ̀ʼhə shʉ-i lɛ́nə yuo fɛ, véʼ vɛŋ-ɛŋ ghɔ̀ŋ mbɔ, ‘Nyii, kə ẗʉkə-a vyíi ndəŋ mɔ le, mɔ nɔ wo-bʉ̂ʼʉ.’</char> <verse eid="LUK 18:13" /><verse number="14" style="v" sid="LUK 18:14" /><char style="wj">M̈ɔ shyíi a mbɔ wo-ɔ̄ nɔ bʉ̀nə gɛ̀ chunjaa-ɔ kə́ bɛ ndyʉndyʉ tʉ Nyii, təmə wo-Falasi kə́ bɛ nɔ fɛ. Wo ndə ɔ kóʼhə ŋwɔŋ-ɛŋ ghɔʼ bə bu shúʼhə ɔŋ sê, bɔŋ wo ndə ɔ shúʼhə ŋwɔŋ-ɛŋ sê, bə bu kóʼhə ɔŋ ghɔʼ.”</char><verse eid="LUK 18:14" /></para>
  <para style="s">Jiso túu bʉ̀ʉ kɔ́ tʉ vâambuɔ</para>
  <para style="r">(<ref loc="MAT 19:13-15">Matia 19:13-15</ref>; <ref loc="MRK 10:13-16">Mak 10:13-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15" />Bʉə kə́ leʼ gwè haʼ ghɔ nə vâa-bʉə tʉ ɔŋ mbɔ ɔ chʉʼ mɔ̀ʼ ghɔkə-i ndəŋ bɔŋ. Vâafɔʼɔ-bi kʉ̂ʉ nyíɛ, kə́ sɔ́ʼ bɔŋ. <verse eid="LUK 18:15" /><verse number="16" style="v" sid="LUK 18:16" />Jiso buŋ leʼ tíi bɔŋ kə́ ghɔ̀ŋ mbɔ, <char style="wj">“B̈ii mɛ̀ʼtə v̈âambuɔ gwè tʉ mɔ, kə bii mə leʼ chíe bɔŋ fɛ bʉʼka Sɔ́ʼ-Nyii nɔ bɛ tʉ ntɛ bʉə nə bɔ̄ŋbə.</char> <verse eid="LUK 18:16" /><verse number="17" style="v" sid="LUK 18:17" /><char style="wj">Nɔʼ m̈ɔ shyíi bii nə shʉəŋ mbɔ wotəmiyɔŋ ndə ɔ gòʼ təmə kɔ́ ŋwɔŋ-ɛŋ mbɔ N̈yii sɔ́ʼ ɔ nə vaambuɔ fɛ, ɔ mə nə ŋíi mu Sɔ́ʼ-Nyii fɛ.”</char><verse eid="LUK 18:17" /></para>
  <para style="s">Wo-kəfʉʼ</para>
  <para style="r">(<ref loc="MAT 19:16-30">Matia 19:16-30</ref>; <ref loc="MRK 10:17-31">Mak 10:17-31</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18" />Ndʉʉmɛ, wokwɛʼtəŋbɛʼ bíʼtə tʉ Jiso mbɔ, “Tie-ɔ chicha, a nɔ wo-nuʼ-jyujyu, mɔ kie ndə məchìi ka ndə məkie məchímbi təmə liʼ-i ghɔ fɛ?”<verse eid="LUK 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19" />Jiso bə̀ŋhə tʉ ɔŋ mbɔ, <char style="wj">“A tíi mɔ nə wo-nuʼ-jyujyu bʉʼka ka? Wo kaa ghɔ ndə ɔ kie nuʼ-jyujyu fɛ yaʼkɛŋ Nyii tətɛʼ ɛ.</char> <verse eid="LUK 18:19" /><verse number="20" style="v" sid="LUK 18:20" /><char style="wj">A nɔ kínə bəŋkahə Nyii ndə i ghɔ̀ŋ mbɔ, ‘Kə a mə gháa bəsəŋ fɛ, kə a mə yí wo fɛ, kə a mə lʉ́ʼ fɛ, kə a mə tɔ́ŋ bɔ̌ŋ wo ndəŋ lɛɛŋkə fɛ, kɔ́ kuŋhə tʉ naa-aŋ ghɔŋ tie-a.’ ”</char><verse eid="LUK 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21" />Ɔ bə̀ŋhə tʉ Jiso mbɔ, “Mɔ nɔʼ kɛŋ fɔ̀ʼ nubə-ɔ̄ŋ inchəŋ lʉ̀ hə vaambuɔ.”<verse eid="LUK 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22" />Jiso kʉ̂ʉ yʉ́ nubə ndə ɔ gìe, ghɔ̀ŋ mbɔ, <char style="wj">“Mbyu kənu nɔ bíe imɔʼ ndə a kie ndə məchìi. Gɛ̀ fɛ̀ŋ fɔbə inchəŋ ndə a kie, gyʉ̀ə tʉ bʉə-mbʉʼ, kaʼ a chìi nɔ, a kie lə̂ŋ-aŋ yuo, ndʉʉmɛ, gwè, kə́ gwè hə bɔ̌ŋ mɔ.”</char> <verse eid="LUK 18:22" /><verse number="23" style="v" sid="LUK 18:23" />Mbʉ wo-ghɔ̄ kʉ̂ʉ yʉ́ nukə ndə Jiso gìe, i chìi mbʉə-e dìe, bʉʼka mbɔ ɔ nɔ kə fʉ̀ʼ daa.<verse eid="LUK 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 18:24" />Jiso kʉ̂ʉ nyíɛ ndə mbʉə-e dìe daa, ɔ ghɔ̀ŋ mbɔ, <char style="wj">“I bu shʉ́ə daa tʉ bʉə-kəfʉʼ ndə məŋíi mu Sɔ́ʼ-Nyii!</char> <verse eid="LUK 18:24" /><verse number="25" style="v" sid="LUK 18:25" /><char style="wj">Bʉʼka i nɔ yùhə tʉ nyaa-bəkatə ndə məsʉ́ʉ hə ndəŋ gyii-sɔʼ-kə tə chàa ndə i bɛ tʉ wo-kəfʉʼ ndə məŋíi mu Sɔ́ʼ-Nyii.”</char><verse eid="LUK 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26" />Bʉə ndə bɔ̂ŋ yʉ́ nukə-ɔ̄ŋ bíʼtə mbɔ, “Bɛ nda ndʉʉghɔfii ndə bəkɔ ɔ kie ŋkwaaNyii?”<verse eid="LUK 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27" />Jiso bə̀ŋhə mbɔ, <char style="wj">“Nubə ndə i chàa ghʉəʼ-woməsʉʉ-kə, nɔ yùhə tʉ Nyii.”</char><verse eid="LUK 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28" />Bita ghɔ̀ŋ mbɔ, “Nyíɛ! Baʼa nɔʼ mɛ̀ʼtə futə-aʼ ndə məgwè hə bɔ̌ŋ aŋ.”<verse eid="LUK 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29" />Jiso ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Nɔʼ m̈ɔ shyíi bii nə shʉəŋ mbɔ wo kaa ghɔ ndə ɔ nɔʼ mɛ̀ʼtə fɔbə nə njaa-ɛ, byuunɔ vi-i, byuunɔ bəliŋ-bi, byuunɔ bətie-bi, byuunɔ vâa-bii, yie-Sɔ́ʼ-Nyii,</char> <verse eid="LUK 18:29" /><verse number="30" style="v" sid="LUK 18:30" /><char style="wj">ndə ɔ bu gòʼ təmə kie buŋmbi bəfɔ tə tíŋ ndə ɔ kə fəŋ kie kəchisê-fɛ̄ŋ laa ghɔŋbə wʉʉnəmbikə ndə i tʉʼ gwè, məchímbi təmə liʼ-i ghɔ fɛ.”</char><verse eid="LUK 18:30" /></para>
  <para style="s">Jiso bìʼ kwə́ʼ te kwu-i vɛʼ tia</para>
  <para style="r">(<ref loc="MAT 20:17-19">Matia 20:17-19</ref>; <ref loc="MRK 10:32-34">Mak 10:32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31" />Mbəŋ-ɛŋ ghɔŋbə mbʉ vâafɔʼɔ-bi njuɔ bûu nə wuŋ fí ŋwɔŋ-yʉə-bɔŋ bɔ̌ŋ, ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“B̈ii nyíɛ, bʉʼʉ nɔ tʉʼ kóʼ gɛ̀ Jɛlosalɛŋ, nchəŋnchəŋ bənu ndə bʉəyʉkəŋgieNyii kə nyɔ̀ʼ te Vaa-Woməsʉʉ bu fyú sê.</char> <verse eid="LUK 18:31" /><verse number="32" style="v" sid="LUK 18:32" /><char style="wj">Bə bu chɔ̀ʼhə ɔŋ kɔ́ mu kəghɔ-bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ, bə bu dʉ̀ʉhə ɔŋ, bɔŋleʼ mɔ̀ʼ tʉvyiikə-i, tyù ntɛmə mbʉə-ɔ.</char> <verse eid="LUK 18:32" /><verse number="33" style="v" sid="LUK 18:33" /><char style="wj">Bə bu kɛŋ gwúu ɔ yí, kʉ̂ʉ bɛ chîbə itia nɔ, ɔ bʉ̀nə kóʼ.”</char><verse eid="LUK 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34" />Bɔŋ kəliʼ, təmə bɔ̂ŋ kínə mbyu kənu mu nubə-bɔ̄ŋ fɛ. Bə nɔ kə lə̀ŋ mbʉ kənu kəghɔ-bɔŋ, təmə bɔŋ kínə nukə ndə bə gìe fɛ.<verse eid="LUK 18:34" /></para>
  <para style="s">Jiso chʉ́ʼ wo-bəghaa ndə ɔ bɛ fʉ̀əŋtəshʉ</para>
  <para style="r">(<ref loc="MAT 20:29-34">Matia 20:29-34</ref>; <ref loc="MRK 10:46-52">Mak 10:46-52</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35" />Ndə ɔ kə́ kə́ŋhə mbʉə Jɛliko, fʉ̀əŋtəshʉbɛʼ kə́ dùʼ kəmbia fia kə́ gháa ŋkwaa hə kəghɔ bəntiŋ fia. <verse eid="LUK 18:35" /><verse number="36" style="v" sid="LUK 18:36" />Ɔ kʉ̂ʉ kə́ yʉ́ ndə nuɔ-bʉə tʉʼ tíŋ, ɔ bíʼtə mbɔ, “Tʉʼ tíŋ ka laa?”<verse eid="LUK 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 18:37" />Bə shyíi ɔ mbɔ, “Nɔ tʉʼ tíŋ Jiso ndə ɔ lɔ̀ hə Nasalɛ.”<verse eid="LUK 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38" />Ɔ tíi ghɔ̀ŋ mbɔ, “Jiso, V̈aa-Dɛbi, kə ẗʉkə-a vyíi ndəŋ mɔ le!”<verse eid="LUK 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39" />Bʉə ndə bɔ̂ŋ tʉʼ gɛ̀ hə bəshʉ, sɔ́ʼ ɔ, kə́ ghɔ̀ŋ mbɔ ɔ̈ líitə. Bɔŋ ɔ bìʼ tíitíi nə ghʉəʼkə mbɔ, “V̈aa-Dɛbi, kə ẗʉkə-a vyíi ndəŋ mɔ le!”<verse eid="LUK 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40" />Jiso tə́nə kàhə mbɔ b̈ə la gwè nə nɔŋ tʉ ɔŋ. Bɔ̂ŋ kʉ̂ʉ gwè nə nɔŋ, tə kə́ kə́ŋhə, ɔ bíʼtə tʉ ɔŋ mbɔ, <verse eid="LUK 18:40" /><verse number="41" style="v" sid="LUK 18:41" /><char style="wj">“A tʉʼ kʉ́ʉ mbɔ mɔ bɛ təka nə aŋ?”</char></para>
  <para style="p" vid="LUK 18:41">Ɔ bə̀ŋhə mbɔ, “Tiekətʉ, mɔ nɔ tʉʼ kʉ́ʉ mə-kə́-bʉ̀nə nyíɛ yəŋkə.”<verse eid="LUK 18:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42" />Jiso bə̀ŋhə tʉ ɔŋ mbɔ, <figure style="fig" alt="Jesus heals a blind man" file="WA03865b.tif" size="col" copy="Graham Wade" ref="18:42">Jiso chʉ́ʼ fʉ̀əŋtə shʉ</figure> <char style="wj">“Nyíɛ! Bʉʼka a mɔ̀ʼfyii-a ndəŋ mɔ, mɔ nɔʼ chìi a kie nchʉʼ.”</char><verse eid="LUK 18:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 18:43" />Haʼ ndʉʉmɛ, ɔ bʉ̀nə nyíɛ yəŋkə, chʉ́ʉhə kə́ tòʼ gɛ̀ hə bɔ̌ŋ ɔŋ, kə́ kɔ́ kuŋhə tʉ Nyii. Bʉə bənchəŋ kʉ̂ʉ nyíɛ nukə ndə i fyú, bɔ̂ŋ kə́ lə̀ʼtə Nyii.<verse eid="LUK 18:43" /></para>
  <chapter eid="LUK 18" />
  <chapter number="19" style="c" sid="LUK 19" />
  <para style="s">Jiso ghɔŋ Sakio</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1" />Jiso kə́ tíŋ mu Jɛliko. <verse eid="LUK 19:1" /><verse number="2" style="v" sid="LUK 19:2" />Wo-kəfʉʼbɛʼ kə́ bɛ chɔ yie-e kə́ bɛ Sakio, bɔŋ-kə́-leʼ bɛ wokwɛʼtəŋ-bʉə-fí-tashi. <verse eid="LUK 19:2" /><verse number="3" style="v" sid="LUK 19:3" />Ɔ kə́ kʉ́ʉ ndə mənyíɛ ntɛ wo ndə Jiso bɛ yɔ̄ŋ-yə, bɔŋ bʉʼka mbɔ ɔ bɛ wo ntuŋntuŋ, kə́ bɛ mu bʉə buŋmbi, ɔ mùutə kəŋkaa. <verse eid="LUK 19:3" /><verse number="4" style="v" sid="LUK 19:4" />Mbʉ Sakio nyʉ́ʉ tíŋ mbʉ nuɔ-bʉə-buŋmbi gɛ̀ bəshʉ, kóʼ kətʉ kətyʉ mbɔ ɔ chʉʼ nyíɛ Jiso, bʉʼka mbɔ ɔ nɔ nə kínə mbɔ Jiso bu tíŋ fia-ghɔ̄.<figure style="fig" alt="Jesus called Zaccheus" file="CN01776C.TIF" size="col" copy="David C. Cook" ref="19:4">Jiso tíi Sakio</figure><verse eid="LUK 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 19:5" />Ndʉʉ ndə Jiso kə́ gwè dàa tiɛŋ kətyʉ-ghɔ̄, chɔ̀ʼhə shʉ-i lɛ́nə mbʉ kətyʉ-ghɔ̄, ghɔ̀ŋ tʉ ɔŋ mbɔ, <char style="wj">“Sakio, shíʼ sê nəndʉʉ, bʉʼka mbɔ laa mɔ bu yaʼ chí mu njaa-a.”</char><verse eid="LUK 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 19:6" />Ɔ lə̀ŋnə shíʼ chàʼtə ɔŋ jyujyu lʉ̀ ɔ, ghɔŋ ɔŋ gɛ̀ mu njaa-ɔ, ɔ dùʼhə ɔŋ sê. <verse eid="LUK 19:6" /><verse number="7" style="v" sid="LUK 19:7" />Ndʉʉ ndə bʉə bənchəŋ nyíɛ yɔ̄ŋ-yə, bɔ̂ŋ luŋtə ghɔ̀ŋ mbɔ, “Ɔ nɔʼ gɛ̀ mətòʼ mu njaa wo-bʉ̂ʼʉ.”<verse eid="LUK 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8" />Sakio lɔ̀ tə́nə ghɔ̀ŋ tʉ Tiekətʉ mbɔ, “Mɔ bu kɔ́ via-nchuɔ-kə-ɔŋ tʉ bʉə-kəbyuu. Kaʼ mɔ nɔʼ nə kwò wo, mɔ byʉ̀hə tʉ ɔŋ yəŋbə kwi.”<verse eid="LUK 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9" />Jiso ghɔ̀ŋ mbɔ, <char style="wj">“ŊkwaaNyii nɔʼ gwè laa mu njaa-fɛ̄ŋ, bʉʼka mbɔ Sakio nɔ bɛ haʼ wo-kəlɔŋ-Ablahaŋ ghɔ.</char> <verse eid="LUK 19:9" /><verse number="10" style="v" sid="LUK 19:10" /><char style="wj">Bʉʼka Vaa-Woməsʉʉ nɔ gwè ndə məkʉ́ʉ bɔŋleʼ kwáa bʉə ndə bɔ̂ŋ nɔʼ bɛ́.”</char><verse eid="LUK 19:10" /></para>
  <para style="s">Jiso mɔ̀ʼ chəŋkə te nə kɔʼ-kyʉə-bə</para>
  <para style="r">(<ref loc="MAT 25:14-30">Matia 25:14-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11" />Ndə bɔ̂ŋ kə́ yʉ́ nubə-ɔ̄ŋ, bʉʼka ɔ nɔʼ kə kə́ŋhə mbʉə Jɛlosalɛŋ, ɔ mɔ̀ʼ chəŋkə tʉ bɔŋ te nə Sɔ́ʼ-Nyii, bʉʼka ŋkwɔʼtə-yʉə nɔ kə bɛ mbɔ i bu gwè haʼ nduɔnduɔ. <verse eid="LUK 19:11" /><verse number="12" style="v" sid="LUK 19:12" />Jiso mɔ̀ʼ mbʉ kəchəŋ mbɔ, <char style="wj">“Vaa-fɔŋbɛʼ nɔ nə bɛ ghɔ ndə ɔ lɔ̀ kə́ gɛ̀ lɔʼɔ kətə̂ŋbɛʼ dɔdɔ mbɔ b̈ə kùŋ ɔŋ ndə fɔŋ, ɔ bʉ̀nə gwè.</char> <verse eid="LUK 19:12" /><verse number="13" style="v" sid="LUK 19:13" /><char style="wj">Ndə ɔ kə́ kʉ́ʉ gɛ̀, ɔ tíi vâafɔʼɔ-bi wuŋ, kɔ́ kɔʼ-kyʉə-bə</char> <note caller="+" style="f"><char style="fr" closed="false">19:13 </char><char style="ft" closed="false">Kɔʼ-kyʉə-kə ndə bə tíi nə mina, i nɔ bɛ nə kyʉə ndə bəkɔ bə lɔ̀ʼ vâafɔʼɔ chɔ ndə bəchi itia nə vyii mbi.</char></note> <char style="wj">tʉ bɔŋ ghɔ̀ŋ mbɔ, ‘B̈ii chìi mbɛʼnə nə kyʉə-ɔ̄ tə mɔ yi bʉ̀nə gwè.’</char> <verse eid="LUK 19:13" /><verse number="14" style="v" sid="LUK 19:14" /><char style="wj">Bɔŋ bʉə-lɔʼɔ-bi bàa ɔ, tə́ŋ bʉə bɔ̌ŋ ɔŋ, ghɔ̀ŋ mbɔ, ‘Baʼa kʉ̀ʉ mbɔ wo-ɔ̄ bɛ fɔŋ-yaʼ fɛ.’</char><verse eid="LUK 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15" />
    <char style="wj">“Bə kùŋ vaa-fɔŋ-ghɔ̄ ndə fɔŋ, ɔ bʉ̀nə gwè. Ndʉʉmɛ, ɔ tíi vâafɔʼɔ-bi ndə ɔ kə kɔ́ kɔʼ-kyʉə-bə-īŋ tʉ bɔŋ le, mbɔ b̈ɔ̂ŋ la gwè fʉ̀ʼtə sii tʉ ɔŋ ndə bɔ̂ŋ kə shi kie ndəŋ mbʉ mbɛʼnə.</char> <verse eid="LUK 19:15" /><verse number="16" style="v" sid="LUK 19:16" /><char style="wj">Fəŋ vaafɔ̀ʼ gwè ghɔ̀ŋ mbɔ, ‘Tie-ɔ, kɔʼ-kyʉə-kə-a-kə-īŋ nɔʼ bí kɔʼ-kyʉə-bə wuŋ.’</char> <verse eid="LUK 19:16" /><verse number="17" style="v" sid="LUK 19:17" /><char style="wj">Ɔ gìe tʉ ɔŋ mbɔ, ‘A nɔ fɔ̀ʼ jyujyu, a nɔ yʉʼ vaafɔ̀ʼ. Bʉʼka mbɔ a nɔʼ gìe shʉəŋ ndəŋ vaa bənu, mɔ bu kɔ́ ghʉəʼkə tʉ a ndə məsɔ́ʼ yəŋkwɛʼtəŋbə wuŋ.’</char><verse eid="LUK 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 19:18" />
    <char style="wj">“Biitəkə gwè ghɔ̀ŋ mbɔ, ‘Tiekətʉ, kɔʼ-kyʉə-kə-a-kə-īŋ nɔʼ bí kɔʼ-kyʉə-bə itaa.’</char> <verse eid="LUK 19:18" /><verse number="19" style="v" sid="LUK 19:19" /><char style="wj">Ɔ gìe tʉ ɔŋ mbɔ, ‘A bu sɔ́ʼ yəŋkwɛʼtəŋbə itaa.’</char><verse eid="LUK 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 19:20" />
    <char style="wj">“Ibɛʼyə vaafɔ̀ʼ gwè ghɔ̀ŋ mbɔ, ‘Tie-ɔ, kɔʼ-kyʉə-kə-a-kə-īŋ nɔ ndə mɔ shi kɔ́ʼ lə̀ŋ mu chʉəʼ-ndyi-kə.</char> <verse eid="LUK 19:20" /><verse number="21" style="v" sid="LUK 19:21" /><char style="wj">Bʉʼka mɔ nɔ kə́ fàa a, mbɔ a nɔ bɛ wo shʉ́əshʉ́ə kə́ kwó fɔbə ndə i gòʼ təmə bɛ ya-yʉə fɛ bɔŋ-kə́-leʼ lʉ̀ fɔbə HƏ mutɔ təmə lə̀ŋ fɛ.’</char><verse eid="LUK 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 19:22" />
    <char style="wj">“Ɔ gìe tʉ ɔŋ mbɔ, ‘A nɔ bɛ vaafɔ̀ʼ buuŋbʉə, mɔ bu lʉ̀ haʼ ŋgiekə-a, sɔ́ʼ a nə yɔŋ! A nɔ nə kínə mbɔ mɔ la bɛ wo shʉ́əshʉ́ə kə́ kwó fɔbə ndə i gòʼ təmə bɛ yɔŋ-yʉə fɛ bɔŋ-kə́-leʼ lʉ̀ fɔbə hə mutɔ təmə lə̀ŋ fɛ.</char> <verse eid="LUK 19:22" /><verse number="23" style="v" sid="LUK 19:23" /><char style="wj">Bɔŋ chìi ka təmə a gɛ̀ mɔ̀ʼ kyʉə-ɔ mu baŋ fɛ? Təmə mɔ nɔ kə́ gwè lʉ̀ nɔ, tʉ i nɔʼ kie sii.’</char> <verse eid="LUK 19:23" /><verse number="24" style="v" sid="LUK 19:24" /><char style="wj">Ɔ gìe tʉ bʉə ndə bɔ̂ŋ tə́nə mbʉə ɔ mbɔ, ‘B̈ii fí mbʉ kyʉə hə kəghɔ-ɔ, kɔ́ tʉ wo ndə ɔ kie kɔʼ-kyʉə-bə wuŋ.’</char><verse eid="LUK 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 19:25" />
    <char style="wj">“Bɔ̂ŋ bə̀ŋhə tʉ ɔŋ mbɔ, ‘Tiekətʉ, maa-yɔ̄ŋ wo nɔʼ kə kie kɔʼ-kyʉə-bə wuŋ.’</char><verse eid="LUK 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 19:26" />
    <char style="wj">“Mbʉ fɔŋ bə̀ŋhə mbɔ, ‘B̈ii nyíɛ! Wotəmiyɔŋ ndə ɔ kie, bə bu bìʼ yi-yɔ́ŋyɔ́ŋ-yə chɔ. Bɔŋ wo ndə ɔ gòʼ təmə kie fɛ, buŋ vaadyʉʼʉ ndə ɔ kie, bə bu fí kəghɔ-ɔ.</char> <verse eid="LUK 19:26" /><verse number="27" style="v" sid="LUK 19:27" /><char style="wj">Nduɔ, te nə bʉə-bàa-bɔŋ, ndə bɔ̂ŋ kə́ tɛ́ŋ mbɔ mɔ mə bɛ fɔŋ-yʉə fɛ, b̈ii gwè nə bɔŋ fɛ̄ŋ, yítə bɔŋ bəshʉ mɔ.’ ”</char><verse eid="LUK 19:27" /></para>
  <para style="s">Jiso sʉ̀ʉnə mu Jɛlosalɛŋ ndə məsɛ́ʼ ŋgʉʼʉ</para>
  <para style="r">(<ref loc="MAT 21:1-11">Matia 21:1-11</ref>; <ref loc="MRK 11:1-11">Mak 11:1-11</ref>; <ref loc="JHN 12:12-19">Jɔŋ 12:12-19</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28" />Ndʉʉ ndə Jiso kə gìe yɔ̄ŋ-yə, ɔ kóʼ gɛ̀ nə shʉbə mu Jɛlosalɛŋ. <verse eid="LUK 19:28" /><verse number="29" style="v" sid="LUK 19:29" />Ndʉʉ ndə ɔ kə́ kə́ŋhə mbʉə lɔʼɔ-Befe ghɔŋ Bɛtani ndə i kə bɛ mbʉə Kwɔŋ-bəTyʉ-Oli, ɔ tə́ŋ vâafɔʼɔ-bi bəbûu, <verse eid="LUK 19:29" /><verse number="30" style="v" sid="LUK 19:30" />gìe tʉ bɔŋ mbɔ, <char style="wj">“B̈ii gɛ̀ mu lɔʼɔ-fīi bəshʉ bii le, ndə bii tʉʼ sʉ́ʉ nɔ, bii bu nyíɛ vaaŋgwɔŋ-jakashi ndə bə chyúu ɔ təmə wo nɔʼ nə kóʼ ndəŋ ɔŋ fɛ. B̈ii yɔ̀ʼ ɔ, gwè nə nɔŋ.</char> <verse eid="LUK 19:30" /><verse number="31" style="v" sid="LUK 19:31" /><char style="wj">Kaʼ wo bíʼtə tʉ bii mbɔ, ‘Bii tʉʼ yɔ̀ʼ bʉʼka?’ Bii bə̀ŋhə tʉ ɔŋ mbɔ, ‘Mbʉ Tiekətʉ nɔ kie fɔ̀ʼ nə yɔŋ.’ ”</char><verse eid="LUK 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32" />Ndə bɔ̂ŋ kə lɔ̀ gɛ̀, bɔ̂ŋ nyíɛ haʼ ndə ɔ kə gìe. <verse eid="LUK 19:32" /><verse number="33" style="v" sid="LUK 19:33" />Ndə bɔ̂ŋ kə́ yɔ̀ʼ mbʉ vaaŋgwɔŋ-jakashi le, ŋwɔ̌ŋ-ɛŋ bíʼtə mbɔ, “Bii tʉʼ yɔ̀ʼ ɔ bʉʼka?”<verse eid="LUK 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34" />Mbʉ vâafɔʼɔ-bi ghɔ̀ŋ mbɔ, “Mbʉ Tiekətʉ nɔ kie fɔ̀ʼ nə yɔŋ.” <verse eid="LUK 19:34" /><verse number="35" style="v" sid="LUK 19:35" />Bɔ̂ŋ yɔ̀ʼ ɔ gwè nə nɔŋ tʉ Jiso, sɛ̀nə ndyi-fəʼə-hə-ʉə ndəŋ mbʉ vaaŋgwɔŋ-jakashi, chɔ̀ʼhə Jiso dùʼhə ɔŋ ndəŋ ghɔ.<verse eid="LUK 19:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 19:36" />Ndə ɔ tʉʼ gɛ̀ ndəŋ mbʉ nyaa, bʉə kə́ sɛ̀nə ndyi-fəʼə-hə-ʉə sêfia. <verse eid="LUK 19:36" /><verse number="37" style="v" sid="LUK 19:37" />Ɔ kʉ̂ʉ shíʼ gwè dàa tiɛŋ Kwɔŋ-bəTyʉ-Oli, mbʉ nuɔ vâafɔʼɔ-bi buŋmbi chʉ́ʉhə kə́ nʉ́ətə, bɔ̂ŋ lə̀ʼtə Nyii nə gyʉʉ-yʉə dədə te nchəŋnchəŋ nufinəbə ndə bɔ̂ŋ kə nyíɛ ndə ɔ fɔ̀ʼ, <verse eid="LUK 19:37" /><verse number="38" style="v" sid="LUK 19:38" />kə́ ghɔ̀ŋ mbɔ,</para>
  <para style="q1" vid="LUK 19:38">“Tə Nyii bìʼ Fɔŋ ndə ɔ gwè yie-Tiekətʉ,</para>
  <para style="q1" vid="LUK 19:38">fyiighʉ́ənə nɔ bɛ yuo,</para>
  <para style="q2" vid="LUK 19:38">məŋwɔʼ nɔ gɛ̀ tə dàa liʼ yuo!”<note caller="+" style="f"><char style="fr" closed="false">19:38 </char><char style="ft" closed="false">Ŋwɔʼnə-təLyuu 118:26.</char></note><verse eid="LUK 19:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39" />Bʉə-Falasibɛʼbə ndə bɔ̂ŋ kə bɛ mu nuɔ-bʉə-buŋmbi ghɔ̀ŋ tʉ Jiso mbɔ, “Chicha, kə a sɔ́ʼ vâafɔʼɔ-ba-bɔ̄ŋ kɔ́ baʼa le.”<verse eid="LUK 19:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40" />Bɔŋ Jiso bə̀ŋhə, gìe tʉ bɔŋ mbɔ, <char style="wj">“B̈ii yʉ́! Mbee, mɔ mə téʼ bɔ̂ŋ líitə fɛ bʉʼka kaʼ bɔ̂ŋ líitə, ŋgoʼhə kə́ tíitə kəyəŋ-bɔŋ!”</char><verse eid="LUK 19:40" /></para>
  <para style="s">Jiso gwía te bʉə-Jɛlosalɛŋ</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41" />Ndʉʉ ndə Jiso kə́ kə́ŋhə mbʉə Jɛlosalɛŋ tə kə́ dùhə nyíɛ, ɔ gwía te nukə ndə i bu fyú chíe bʉə-Jɛlosalɛŋ, <verse eid="LUK 19:41" /><verse number="42" style="v" sid="LUK 19:42" />ghɔ̀ŋ mbɔ, <char style="wj">“Nɔ bʉ̀ʉ bii kínə mbi laa fɛ̄ŋ te nukə ndə bəkɔ i gwè nə fyiighʉ́ənə tʉ bii. Bɔŋ bə nɔʼ lə̀ŋ shʉ-bii.</char> <verse eid="LUK 19:42" /><verse number="43" style="v" sid="LUK 19:43" /><char style="wj">Mɔ bɔŋ kə́ gwía mbɔ nɔ bʉ̀ʉ bii kínə bʉʼka chî-ghɔ̄-bə tʉʼ gwè tʉ bii ndə bʉə-bàa-bii bu kɔ́ʼ lɔ̂ŋ yə̀ŋhə bii fúu, lɛ̀ŋ bii bəviabəvia, núʼtə bii kəyəŋ kəmɔʼ.</char> <verse eid="LUK 19:43" /><verse number="44" style="v" sid="LUK 19:44" /><char style="wj">Bɔ̂ŋ bu ŋìʼtə a sê biibə vâa-ba. Bʉə-bàa-bii kʉʉ mɛ̀ʼtə mbyu kəchɔʼ i nʉ̀ʉ ndəŋ ibɛʼ-yə fɛ, bʉʼka bii chèʼnə ndʉʉ ndə Nyii kə gwè ndə məkwáa bii fɛ.”</char><verse eid="LUK 19:44" /></para>
  <para style="s">Jiso sʉ́ʉ mu njaafɛ̀ʼndɛŋNyii</para>
  <para style="r">(<ref loc="MAT 21:12-17">Matia 21:12-17</ref>; <ref loc="MRK 11:15-19">Mak 11:15-19</ref>; <ref loc="JHN 2:13-22">Jɔŋ 2:13-22</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45" />Ndʉʉmɛ, Jiso ŋíi mu chunjaafɛ̀ʼndɛŋNyii chʉ́ʉhə kə́ jə̀ŋ bʉə-mbɛʼnə, <verse eid="LUK 19:45" /><verse number="46" style="v" sid="LUK 19:46" />kə́ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Bə nɔ nyɔ̀ʼ mu ŋwɔʼnə-Nyii mbɔ, ‘Njaa-ɔ nɔ bɛ njaagháaNyii, bɔŋ bii nɔʼ lʉ̀ i bə̀ŋ chəŋ-bəlʉʼʉ-shùɔ-bʉə.’ ”</char><verse eid="LUK 19:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47" />Yɔ̄ŋ-yə kʉ̂ʉ tíŋ, ɔ kə́ dàhə ŋgieNyiikə mu njaafɛ̀ʼndɛŋNyii bəchibəchi. Bətiefɛ̀ʼndɛŋNyii, bʉə dàhə nuʼ-Mushi leʼnə bəbɛʼbəntəŋbəshʉ kə́ kʉ́ʉ fia ndə məyí ɔ. <verse eid="LUK 19:47" /><verse number="48" style="v" sid="LUK 19:48" />Bɔŋ bɔ̂ŋ kʉ́ʉ fia kəŋkaa, bʉʼka bʉə bənchəŋ nɔ kə́ yie ŋgiekə ndə i bu fyú hə chu-ɔ.<verse eid="LUK 19:48" /></para>
  <chapter eid="LUK 19" />
  <chapter number="20" style="c" sid="LUK 20" />
  <para style="s">Bə dʉ̀ʉhə ghʉəʼ-Jiso-kə</para>
  <para style="r">(<ref loc="MAT 21:23-27">Matia 21:23-27</ref>; <ref loc="MRK 11:27-33">Mak 11:27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1" />Kʉ̂ʉ bɛ ibɛʼ-yə mbyu kəchî ndə Jiso tʉʼ dàhə bʉə mu chunjaafɛ̀ʼndɛŋNyii bɔŋ-kə́-leʼ lɔ̀ʼ ntəŋjyujyu, bətiefɛ̀ʼndɛŋNyii, bʉə dàhə nuʼ-Mushi leʼnə bəntəŋbəshʉ gwè tə́ŋ kətʉ Jiso, <verse eid="LUK 20:1" /><verse number="2" style="v" sid="LUK 20:2" />kə́ bíʼtə tʉ ɔŋ mbɔ, “Shyíi baʼa, a tʉʼ fɔ̀ʼ nubə-ɔ̄ŋ nə ghʉəʼ-nda-kə? Byuunɔ, kɔ́ nda kɔ́ ghʉəʼkə tʉ a?”<verse eid="LUK 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3" />Jiso bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“Mɔ bu bíʼtə mbyu kənu tʉ bii ghɔ, b̈ii shyíi mɔ.</char> <verse eid="LUK 20:3" /><verse number="4" style="v" sid="LUK 20:4" /><char style="wj">Jɔŋ kə́ báa bʉə muu nɔ, ghʉəʼkə-i kə́ lɔ̀ hə yuo mɛ, kə kəghɔ-bʉəməsʉʉ?”</char><verse eid="LUK 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5" />Bɔ̂ŋ jìʼtə mbʉ kənu-ghɔ̄ mu bɔŋ, kə́ ghɔ̀ŋ mbɔ, “Kaʼ bʉʼʉ ghɔ̀ŋ mbɔ, ‘I kə lɔ̀ hə yuo,’ ɔ bu ghɔ̀ŋ mbɔ, ‘Kə chìi ka təmə bii bɛ́ŋ ɔŋ fɛ?’ <verse eid="LUK 20:5" /><verse number="6" style="v" sid="LUK 20:6" />Bɔŋ kaʼ bʉʼʉ ghɔ̀ŋ mbɔ, ‘I nɔ nə lɔ̀ hə kəghɔ-bʉəməsʉʉ,’ lɔʼɔ ŋkwê bɔŋ túŋtə bʉʼʉ nə ŋgoʼhə bʉʼka bɔ̂ŋ nɔ bɛ́ŋ mbɔ Jɔŋ nɔ nə bɛ yʉkəŋgieNyii.” <verse eid="LUK 20:6" /><verse number="7" style="v" sid="LUK 20:7" />Ndʉʉmɛ, bɔ̂ŋ ghɔ̀ŋ mbɔ, “Baʼa kínə yəŋkə ndə i kə lɔ̀ hə chɔ fɛ.”<verse eid="LUK 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8" />Jiso bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“Yɔŋ mbəŋ ghɔ kʉʉ shyíi bii nə yəŋkə ndə ghʉəʼkə-ɔŋ lɔ̀ hə chɔ ndə məfɔ̀ʼ nubə-ɔ̄ŋ fɛ.”</char><verse eid="LUK 20:8" /></para>
  <para style="s">Chəŋkə te bʉə-bʉ̂ʼʉ ndə bɔ̂ŋ tʉʼ fɔ̀ʼ mutɔ</para>
  <para style="r">(<ref loc="MAT 21:33-46">Matia 21:33-46</ref>; <ref loc="MRK 12:1-12">Mak 12:1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9" />Jiso bʉ̀nə bìʼ kíahə ŋwɔŋ-ɛŋ tʉ mbʉ bʉə mɔ̀ʼ chəŋkə-ɔ̄ŋ tʉ bɔŋ mbɔ, <char style="wj">“Wobɛʼ nɔ nə bè tɔ̂-təlyʉʼ-kə-i ndə i kʉ́ʉnə ntɔŋmə, chɔ̀ʼhə kɔ́ tʉ bəbɛʼbʉə-mutɔhə mbɔ b̈ɔ̂ŋ kə́ shyíi, lɔ̀ gɛ̀ lɔʼɔ kətə̂ŋbɛʼ ndə məgɛ̀ chí chɔ dɔ̀ŋnə.</char> <verse eid="LUK 20:9" /><verse number="10" style="v" sid="LUK 20:10" /><char style="wj">Ndʉʉ kwɛ̀tə məntɔŋ kʉ̂ʉ kʉ̀ʼnə, ɔ tə́ŋ vaafɔ̀ʼ-ɛ kə mbɔ bɔŋ bu kɔ́ shyîi-mutɔ-kə-i. Ɔ gɛ̀ ndə məfì shyîikə hə kəghɔ mbʉ bʉə-mutɔhə, bɔ̂ŋ bʉ̀nə leʼ lʉ̀ ɔ, gwúu ɔ, jə̀ŋ ɔŋ, ɔ gɛ̀ ghɔghɔ.</char> <verse eid="LUK 20:10" /><verse number="11" style="v" sid="LUK 20:11" /><char style="wj">Ɔ bìʼ tə́ŋ ibɛʼ-yə vaafɔ̀ʼ, bɔ̂ŋ bìʼ gwúu ɔ, lə́ŋhə ɔŋ, mɔ̀ʼ tʉvyiikə mbʉə-bɔŋ, jə̀ŋ ɔŋ, ɔ gɛ̀ ghɔghɔ.</char> <verse eid="LUK 20:11" /><verse number="12" style="v" sid="LUK 20:12" /><char style="wj">Ɔ bìʼ bìitə nə ibɛʼ-yə wo, bɔ̂ŋ bìʼ lə́ŋhə ɔŋ ghɔ leʼ jə̀ŋ ɔŋ.</char><verse eid="LUK 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 20:13" />
    <char style="wj">“Mbʉ tiefɔ̀ʼ-mutɔ bíʼtə tʉ ŋwɔŋ-ɛŋ mbɔ, ‘Mɔ bu bɛ təka loo? Mɔ bu tə́ŋ mbyu vaa-ɔŋ-yɔ̄ŋ ndə mɔ kʉ̀ʉ ɔ daa nɔ, ndʉʉbɛʼ bɔ̂ŋ bu nyíɛ ɔŋ nɔ, fàa ɔ.’</char><verse eid="LUK 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 20:14" />
    <char style="wj">“Bɔŋ ndʉʉ ndə bɔ̂ŋ nyíɛ ɔŋ, bɔ̂ŋ jìʼtə mu bɔŋ, ghɔ̀ŋ mbɔ, ‘Nɔ bɛ mbʉ nju-i nɔ, b̈ii gwè b̈ʉʼʉ yí ɔ, mbʉ bəfɔ chʉʼ bɛ yʉʼʉ-yə.’</char> <verse eid="LUK 20:14" /><verse number="15" style="v" sid="LUK 20:15" /><char style="wj">Ndʉʉmɛ, bɔ̂ŋ fyúhə ɔŋ mbʉ mutɔ mɛ̀ʼ ɔ mbi, yí ɔ.”</char></para>
  <para style="p" vid="LUK 20:15">Jiso bíʼtə mbɔ, <char style="wj">“Mbʉ ŋwɔ̌ŋ-mutɔ bu bɛ təka?</char> <verse eid="LUK 20:15" /><verse number="16" style="v" sid="LUK 20:16" /><char style="wj">Ɔ bu gwè yítə mbʉ bʉə-fɔʼɔ mutɔ, fí mbʉ mutɔ kɔ́ tʉ bʉə-kədɔŋ.”</char></para>
  <para style="p" vid="LUK 20:16">Ndʉʉmɛ, ndə mbʉ bʉə yʉ́ yɔ̄ŋ-yə, bɔ̂ŋ ghɔ̀ŋ mbɔ, “N̈yii fə́ŋhə maa-yɔ̄ŋ.”<verse eid="LUK 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17" />Ɔ chɔ̀ʼhə shʉ-i lɛ́nə bɔŋ ghɔ̀ŋ mbɔ, <char style="wj">“Yɔ̄ŋ-yə ndə bə kə nyɔ̀ʼ ndʉʉghɔfii mu ŋwɔʼnə-Nyii bɛ mbuka nduɔ?</char></para>
  <para style="q1" vid="LUK 20:17">
    <char style="wj">‘Mbʉ ŋgoʼ ndə bʉə bɔŋ njaa kə bìe mɛ̀ʼ,</char></para>
  <para style="q2" vid="LUK 20:17">
    <char style="wj">nɔ bɛ ŋgoʼ-fûu-njaa.’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">20:17 </char>
      <char style="ft" closed="false">Ŋwɔʼnə-təLyuu 118:22.</char>
    </note><verse eid="LUK 20:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="LUK 20:18" />
    <char style="wj">Wotəmiyɔŋ ndə ɔ bu wɔ̀tə ndəŋ ŋgoʼ-ghɔ̄ gwù, bu ŋìʼtə bəviabəvia. Bɔŋ kaʼ mbʉ ŋgoʼ leʼ gwù ndəŋ wo, i jìehə ɔŋ tə ɔ báʼtə.”</char><verse eid="LUK 20:18" /></para>
  <para style="s">Mbiʼtə te məmɔ̀ʼ-tashi</para>
  <para style="r">(<ref loc="MAT 22:15-22">Matia 22:15-22</ref>; <ref loc="MRK 12:13-17">Mak 12:13-17</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19" />Haʼ ndʉʉghɔfii, bʉə dàhə nuʼ-Mushi ghɔŋbə bətiefɛ̀ʼndɛŋNyii kə́ kʉ́ʉ fia ndə məyá ɔ. Bɔŋ bɔ̂ŋ nɔ kə́ fàa shʉ-bʉə, bʉʼka bɔ̂ŋ nɔ kə́ nyíɛ mbɔ ɔ nɔ kə mɔ̀ʼ chəŋkə-ɔ̄ŋ te bɔŋ.<verse eid="LUK 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 20:20" />Bʉə-bɔ̄ŋ, bʉʼka mbɔ bɔ̂ŋ kə́ yə̀ŋ tiɛŋ-ɛŋ, bɔ̂ŋ tə́ŋ bəfyuu lə́ŋ fʉ́əʼ kɔ́ bɔ̌ŋ ɔŋ. Bɔ̂ŋ gɛ̀ kə́ yie ŋgie-bʉə-kə ndə i bu fyú hə chu-ɔ, bɔ̂ŋ chʉʼ gɛ̀ fʉ̀ʼtə tʉ gɔməna Luŋ, bə yá ɔ. <verse eid="LUK 20:20" /><verse number="21" style="v" sid="LUK 20:21" />Bɔ̂ŋ ghɔ̀ŋ mbɔ, “Chicha, baʼa nɔ kínə mbɔ kwəʼ-a ghɔŋbə nubə ndə a tʉʼ dàhə nɔ bɛ kʉ̀ʼnə, a kyinə túhə shʉ fɛ. A nɔ tʉʼ kɛŋ dàhə fia-Nyii shʉəŋ. <verse eid="LUK 20:21" /><verse number="22" style="v" sid="LUK 20:22" />Nduɔ, shyíi baʼa, bɛ nu-bʉə-kə ndə məlɔ̀ʼ tashi tʉ Fɔŋ-Luŋ mɛ kə mbee?”<verse eid="LUK 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23" />Ɔ yíɛʼhə nyíɛ mənaa ndə i bɛ muŋgɔ, ghɔ̀ŋ tʉ bɔŋ mbɔ, <verse eid="LUK 20:23" /><verse number="24" style="v" sid="LUK 20:24" /><char style="wj">“Bii dʉ̀ʼ mbyu kyʉə-kətəŋ tʉ mɔ. Bɛ ŋkwutə-kətʉ-nda-kə leʼnə yie nda ndəŋ ghɔ?”</char></para>
  <para style="p" vid="LUK 20:24">Bɔ̂ŋ bə̀ŋhə mbɔ, “Yi-Fɔŋ-Luŋ-yə.”<verse eid="LUK 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25" />Ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Nɔ, b̈ii kɔ́ fɔ-Fɔŋ-Luŋ-bə tʉ Fɔŋ-Luŋ, kɔ́ yi-Nyii-yə tʉ Nyii.”</char> <verse eid="LUK 20:25" /><verse number="26" style="v" sid="LUK 20:26" />Ntɛ ndə ɔ bə̀ŋhə, i chíe chu-yʉə. Bɔ̂ŋ mùutə ɔŋ kəŋkaa ndə məyá tiɛŋ-ɛŋ hə ndəŋ kwəʼ-ɛ ndʉʉ-ghɔ̄ mu bʉə.<verse eid="LUK 20:26" /></para>
  <para style="s">Məbʉ̀nə kóʼ ghɔŋbə lɔŋ</para>
  <para style="r">(<ref loc="MAT 22:23-33">Matia 22:23-33</ref>; <ref loc="MRK 12:18-27">Mak 12:18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27" />Bʉə-Sadusi-bɛʼbə ndə bɔ̂ŋ tɛ́ŋ mbɔ məbʉ̀nə kóʼ bɛ ghɔ fɛ, gwè tʉ Jiso nə mbyu mbiʼtə, <verse eid="LUK 20:27" /><verse number="28" style="v" sid="LUK 20:28" />kə́ ghɔ̀ŋ mbɔ, “Chicha, Mushi nɔ nə nyɔ̀ʼ tʉ baʼa mbɔ, ‘Kaʼ liŋ-wo kwú mɛ̀ʼtə vi-i təmə bí vaa chɔ fɛ, mbʉ liŋ-iŋ yaʼ lʉ̀ mbʉ woke bí vaa chɔ ndə mətʉ́ʼ yie-mbʉ-ŋkwu-liŋ-iŋ.’ <verse eid="LUK 20:28" /><verse number="29" style="v" sid="LUK 20:29" />Nduɔ, vâabələŋbɛʼbə nɔ nə bɛ chu-ŋkwê-bɔŋ təkwiitia. Fəŋ lʉ̀ woke kwú təmə kie vâa fɛ. <verse eid="LUK 20:29" /><verse number="30" style="v" sid="LUK 20:30" />Biitəkə lʉ̀ mbʉ woke, kwú təmə bí fɛ. <verse eid="LUK 20:30" /><verse number="31" style="v" sid="LUK 20:31" />Ntyunə-kəntyunə-bɔ̌ŋ-kə-i bìʼ lʉ̀ ɔ, i kə́ bɛ haʼ nɔ, tə bɔ̂ŋ mì, tʉbə-ʉə təkwiitia, təmə ɔ bí fɛ. <verse eid="LUK 20:31" /><verse number="32" style="v" sid="LUK 20:32" />Kəliʼ mbʉ woke kwú ghɔ. <verse eid="LUK 20:32" /><verse number="33" style="v" sid="LUK 20:33" />Bu yi bɛ chîkə ndə bʉə ndə bɔ̂ŋ nɔʼ kwútə bu bʉ̀nə kóʼ nɔ, mbʉ woke bu bɛ vi nda mu bɔŋ? Bʉʼka bɔ̂ŋ təkwiitia bənchəŋ nɔ nə lʉ̀ ɔ ndə vi-yʉə.”<verse eid="LUK 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34" />Jiso bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“Bʉə-kəwʉʉnəmbi-bɔ̄ŋ nɔ tʉʼ lɔŋ, bɔŋ kə́ kɔ́ vâa-bʉə lɔŋ.</char> <verse eid="LUK 20:34" /><verse number="35" style="v" sid="LUK 20:35" /><char style="wj">Bɔŋ bʉə ndə bɔ̂ŋ bu nə kʉ̀ʼnə ndə məŋíi mu wʉʉnəmbi-ghɔ̄-kə ghɔŋbə məbʉ̀nə kóʼ hə ndəŋ kwú, kʉʉ yi kə́ gɛ̀ lɔŋ fɛ, təmə bɔŋ kʉʉ yi kə́ kɔ́ vâa lɔŋ fɛ.</char> <verse eid="LUK 20:35" /><verse number="36" style="v" sid="LUK 20:36" /><char style="wj">Təmə bɔŋ bieleʼ nə kwú fɛ, bʉʼka mbɔ bɔ̂ŋ nɔ bɛ ndyʉndyʉ ghɔŋbə bʉəntəŋNyii, kə́ leʼ bɛ vâa-Nyii, kə́ bɛ vâa ndə bɔ̂ŋ bʉ̀nə kóʼ.</char> <verse eid="LUK 20:36" /><verse number="37" style="v" sid="LUK 20:37" /><char style="wj">Buŋ ndə nukə ndə Mushi kə nyɔ̀ʼ te vaa-yuu ndə i kə kyʉ́ʉ, ɔ nɔ kə dʉ̀ʼ mbɔ w̃o nɔ kwú bʉ̀nə kóʼ, nɔ kə bɛ yɔŋ ndə Mushi kə tíi Tiekətʉ nə ‘Nyii-Ablahaŋ, Nyii-Aisi leʼnə Nyii-Jakɔ.’</char> <verse eid="LUK 20:37" /><verse number="38" style="v" sid="LUK 20:38" /><char style="wj">Nduɔ, ɔ kaa Nyii-bəŋkwusê fɛ, ɔ nɔ bɛ Nyii-bʉə ndə bɔ̂ŋ bíe ŋɛnə. Bʉʼka bʉə bənchəŋ nɔ tʉʼ chí mbi ndə Nyii kínə.”</char><verse eid="LUK 20:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39" />Bʉəbɛʼbə ndə bɔ̂ŋ kə́ dàhə nuʼ-Mushi bə̀ŋhə mbɔ, “Chicha, a nɔ kɛŋ gìe jyujyu.” <verse eid="LUK 20:39" /><verse number="40" style="v" sid="LUK 20:40" />Maa-yɔ̄ŋ kʉ̂ʉ tíŋ təmə bɔ̂ŋ leʼ mùutə bíʼtə nukə tʉ ɔŋ fɛ.<verse eid="LUK 20:40" /></para>
  <para style="s">Wo ndə Nyii Kùŋ Tə́ŋ bɛ vaa nda?</para>
  <para style="r">(<ref loc="MAT 22:41-46">Matia 22:41-46</ref>; <ref loc="MRK 12:35-37">Mak 12:35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41" />Jiso bíʼtə tʉ mbʉ bʉə mbɔ, <char style="wj">“Chìi ka bɔ̂ŋ ghɔ̀ŋ mbɔ, Wo ndə Nyii Kùŋ Tə́ŋ bɛ vaa-Dɛbi?</char> <verse eid="LUK 20:41" /><verse number="42" style="v" sid="LUK 20:42" /><char style="wj">Dɛbi nə mbəŋ-ɛŋ nɔ nə nyɔ̀ʼ mu Ŋwɔʼnə-təLyuu mbɔ,</char></para>
  <para style="q1" vid="LUK 20:42">
    <char style="wj">‘Mbʉ Tiekətʉ nɔ nə ghɔ̀ŋ tʉ Tiekətʉ-ɔ mbɔ,</char></para>
  <para style="q1" vid="LUK 20:42">
    <char style="wj">“Dùʼ kwiiləŋ-mɔ,</char><verse eid="LUK 20:42" /></para>
  <para style="q2">
    <verse number="43" style="v" sid="LUK 20:43" />
    <char style="wj">tə mɔ yi mɔ̀ʼ bʉə-bàa-ba sê bəshʉ a.” ’</char><verse eid="LUK 20:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44" />
    <char style="wj">Nduɔ ndə Dɛbi tíi ɔ nə Tiekətʉ nɔ, bəkɔ ɔ bʉ̀nə bɛ vaa-ɛ təka?”</char><verse eid="LUK 20:44" /></para>
  <para style="s">Jiso shyùu tyunə-bʉə-bə te bʉə dàhə nuʼ-Mushi</para>
  <para style="r">(<ref loc="MAT 23:1-36">Matia 23:1-36</ref>; <ref loc="MRK 12:38-40">Mak 12:38-40</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45" />Ɔ kíahə gìe tʉ vâafɔʼɔ-bi ghɔŋbə bʉə bənchəŋ ndə bɔ̂ŋ bɛ chɔ kə́ yʉ́, <verse eid="LUK 20:45" /><verse number="46" style="v" sid="LUK 20:46" />mbɔ, <char style="wj">“B̈ii láa bʉə dàhə nuʼ-Mushi, bɔ̂ŋ nɔ kʉ̀ʉ məmɔ̀ʼ bəgaŋ kyʉə mbʉə-bɔŋ kə́ tòʼ ghʉ́ʉ nə yɔŋ, kʉ̀ʉ mbɔ b̈ə kə́ bʉ́ʉnə tʉ bɔŋ ndəŋ yəŋ-vyii-bə, kʉ̀ʉ ndə mədùʼ ndəŋ fɔŋkwɛʼtəŋbə mu njaagháaNyii ghɔŋbə yəŋkwɛʼtəŋbə ndəŋ yəŋ-nchəŋtə-bə.</char> <verse eid="LUK 20:46" /><verse number="47" style="v" sid="LUK 20:47" /><char style="wj">Bɔ̂ŋ nɔ tʉʼ kwò fɔ-bəkwuʼ-bəke-bə. Bɔ̂ŋ nɔ tʉʼ gháaNyii duhəduhə kə́ làhə shʉ mbɔ bɔ̂ŋ bɛ ndyʉndyʉ. Bʉʼka yɔ̄ŋ-yə, fɛʼɛ-yʉə bu yi shʉ́ə daa.”</char><verse eid="LUK 20:47" /></para>
  <chapter eid="LUK 20" />
  <chapter number="21" style="c" sid="LUK 21" />
  <para style="s">Kɔ-kwuʼ-woke-kə</para>
  <para style="r">(<ref loc="MRK 12:41-44">Mak 12:41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1" />Ndʉʉ ndə Jiso kə bɛ mu njaafɛ̀ʼndɛŋNyii, ɔ chɔ̀ʼhə shʉ-i nyíɛ ndə bʉə-kəfʉʼ tʉʼ mɔ̀ʼ kɔkə-ʉə mu tɔŋ-mɔ̀ʼ-kyʉə-kə mu njaafɛ̀ʼndɛŋNyii-ghɔ̄. <verse eid="LUK 21:1" /><verse number="2" style="v" sid="LUK 21:2" />Ɔ bɔŋleʼ nyíɛ kwuʼ-wokebɛʼ ndə ɔ byúu daa, ɔ kə́ mɔ̀ʼ vâabədyʉʼ kyʉə-bi ibûu mu mbʉ kətɔŋ. <verse eid="LUK 21:2" /><verse number="3" style="v" sid="LUK 21:3" />Jiso ghɔ̀ŋ mbɔ, <char style="wj">“M̈ɔ shyíi bii nə shʉəŋ mbɔ, kwuʼ-woke-ɔ̄ nɔʼ kɔ́ kɔkə chàa bʉə bənchəŋ.</char> <verse eid="LUK 21:3" /><verse number="4" style="v" sid="LUK 21:4" /><char style="wj">Bʉʼka bɔ̂ŋ bənchəŋ nɔ tʉʼ kɔ́ kɔkə-ʉə hə mu buŋmbi ndə bɔ̂ŋ kie. Bɔŋ kwuʼ-woke-ɔ̄ ndə ɔ gòʼ təmə kie fɛ, nɔʼ kɔ́ fɔkə təmiyɔŋ ndə ɔ kie.”</char><verse eid="LUK 21:4" /></para>
  <para style="s">Jiso núhə bəshʉ ndʉʉ buŋ yi kʉ̀ʼnə ntɛ məgwù njaafɛ̀ʼndɛŋNyii</para>
  <para style="r">(<ref loc="MAT 24:1-2">Matia 24:1-2</ref>; <ref loc="MRK 13:1-2">Mak 13:1-2</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5" />Ndə bəbɛʼbʉə kə́ kwə́ʼ te njaafɛ̀ʼndɛŋNyii ndə bə shʉ̀tə nə ŋgoʼ-jyujyu-hə ghɔŋbə kɔkə ndə bə kɔ́ tʉ Nyii chɔ, Jiso ghɔ̀ŋ mbɔ, <verse eid="LUK 21:5" /><verse number="6" style="v" sid="LUK 21:6" /><char style="wj">“Fɔbə-ɔ̄ŋ ndə bii tʉʼ nyíɛ nɔ, ndʉʉ tʉʼ gwè ndə mbyu ŋgoʼ kʉʉ yi káa liɛŋ liŋ-iŋ chɔ təmə bə kùu mɛ̀ʼ sê fɛ.”</char><verse eid="LUK 21:6" /></para>
  <para style="s">Ŋgʉəʼ ndə bʉə-Nyii bu nyíɛ</para>
  <para style="r">(<ref loc="MAT 24:3-14">Matia 24:3-14</ref>; <ref loc="MRK 13:3-13">Mak 13:3-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7" />Bɔ̂ŋ bíʼtə tʉ ɔŋ mbɔ, “Chicha, bɛ ndʉʉka ndə nubə-ɔ̄ŋ inchəŋ bu yi fyú chɔ, leʼnə ntɛ kəcheʼ ka ndə i bu yi dʉ̀ʼ mbɔ mbʉ ndʉʉ nɔʼ kʉ̀ʼnə?”<verse eid="LUK 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8" />Ɔ bə̀ŋhə mbɔ, <char style="wj">“Kə bii mə mɛ̀ʼtə wo fə́ʼhə bii fɛ, bʉʼka bʉə buŋmbi bu yi gwè yie-mɔ, kə́ ghɔ̀ŋ mbɔ, ‘Mɔ nɔ bɛ mbəŋ-ɛŋ!’ leʼ kə́ ghɔ̀ŋ mbɔ, ‘Mbʉ ndʉʉ nɔʼ kʉ̀ʼnə.’ Bɔŋ kə a mə bɛ́ŋ nukə ndə bɔ̂ŋ tʉʼ gìe fɛ.</char> <verse eid="LUK 21:8" /><verse number="9" style="v" sid="LUK 21:9" /><char style="wj">Ndʉʉ ndə bii yʉ́ chɔ̂tə ghɔŋbə ntɔŋntɔŋ mu mbi, kə bii mə fàa fɛ. Nubə-ɔ̄ŋ bu yaʼ fəŋ fyú sê, bɔŋ təmə mbi kʉʉ lìʼ haʼ ndʉʉghɔfii fɛ.”</char><verse eid="LUK 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10" />Ɔ bìʼ ghɔ̀ŋ mbɔ, <char style="wj">“Lɔʼ-bətə̂ŋ-tə bu lɔ̀ tə́nə ghɔŋbə bəbɛʼlɔʼ-bətə̂ŋ-tə, bəfɔŋ bətə̂ŋ bu lɔ̀ tə́nə ghɔŋbə bəbɛʼbəfɔŋ-bətə̂ŋ.</char> <verse eid="LUK 21:10" /><verse number="11" style="v" sid="LUK 21:11" /><char style="wj">Chisêkə bu ŋʉ̀ʼnə shʉ́əshʉ́ə bəyəŋbəyəŋ, chyʉʉ bu gwù mbi ntɛntɛhə, yɔʼbə ntɛntɛhə, nu-fɛ̀ŋhə-bə ntɛntɛhə leʼnə fɔŋ-bəcheʼ ntɛntɛhə bu fyú yuo.</char><verse eid="LUK 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 21:12" />
    <char style="wj">“Bɔŋ nubə-ɔ̄ŋ inchəŋ bu yi kə fyú nɔ, tʉ bə nɔʼ mɔ̀ʼ ghɔkə ndəŋ bii chɔ́ŋhə bii. Bə bu yá bii gɛ̀ nə bii mu njaafɛ̀ʼ-njaagháaNyii, kɔ́ bii chaŋ. Bɔ̂ŋ bu lʉ̀ bii, gwè nə bii bəshʉ bəfɔŋ ghɔŋbə bəgɔməna bʉʼka bii mɔ̀ʼfyiihə-ii ndəŋ mɔ.</char> <verse eid="LUK 21:12" /><verse number="13" style="v" sid="LUK 21:13" /><char style="wj">Yɔ̄ŋ-yə bu bɛ saa tʉ bii ndə məlɔ̀ʼ ntəŋjyujyu.</char> <verse eid="LUK 21:13" /><verse number="14" style="v" sid="LUK 21:14" /><char style="wj">B̈ii shʉ̀tə ndaahə-ii mbɔ bii kʉʉ lə̀ŋnə ndə nukə ndə bii bu gɛ̀ gìe mu njaafɛ̀ʼ fɛ,</char> <verse eid="LUK 21:14" /><verse number="15" style="v" sid="LUK 21:15" /><char style="wj">bʉʼka mɔ bu kɔ́ ŋgie-tə́nə-bə chu-a ghɔŋbə ndaa təmə bʉə-bàa-ba mə bə̀ŋhə aŋ fɛ, təmə bɔ̂ŋ mə kíahə ŋgiekə-a fɛ.</char> <verse eid="LUK 21:15" /><verse number="16" style="v" sid="LUK 21:16" /><char style="wj">Bətie-bii, bəliŋ-bii, bʉə-kəlɔŋ-bii, bətieŋkɔŋ-bii bu chɔ̀ʼhə bii kɔ́ kəghɔ-bɔŋ. Bə bu leʼ yítə bəbɛʼbə hə mu bii.</char> <verse eid="LUK 21:16" /><verse number="17" style="v" sid="LUK 21:17" /><char style="wj">Bʉə bənchəŋ bu bàa bii bʉʼka bii mɔ̀ʼfyiihə-ii ndəŋ mɔ.</char> <verse eid="LUK 21:17" /><verse number="18" style="v" sid="LUK 21:18" /><char style="wj">Bɔŋ bɛ le, mbyu nyu kʉʉ gwù sê hə kətʉ-a fɛ.</char> <verse eid="LUK 21:18" /><verse number="19" style="v" sid="LUK 21:19" /><char style="wj">Kaʼ bii lyʉ̀ʉtə́nə i kɔ́ məchímbi tʉ bii.</char><verse eid="LUK 21:19" /></para>
  <para style="s">Jiso kwə́ʼ te məgwu-Jɛlosalɛŋ</para>
  <para style="r">(<ref loc="MAT 24:15-21">Matia 24:15-21</ref>; <ref loc="MRK 13:14-19">Mak 13:14-19</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20" />
    <char style="wj">“Ndʉʉ ndə bii nyíɛ bəsɔge yə̀ŋ Jɛlosalɛŋ fúu, bii kínə mbɔ ndʉʉ kùunə-i nɔʼ kʉ̀ʼnə.</char> <verse eid="LUK 21:20" /><verse number="21" style="v" sid="LUK 21:21" /><char style="wj">Ndʉʉmɛ, bʉə ndə bɔ̂ŋ bɛ mu Judia, b̈ɔ̂ŋ nyʉ́ʉ kóʼ ndəŋ kwɔŋhə. Bʉə ndə bɔ̂ŋ bɛ mu kəyəŋkwɛʼtəŋ, b̈ɔ̂ŋ nyʉ́ʉ fyú, bʉə ndə bɔ̂ŋ bɛ mbi, mə leʼ ŋíi mbɔ bɔ̂ŋ kʉ́ʉ yəŋ-chí-kə fɛ.</char> <verse eid="LUK 21:21" /><verse number="22" style="v" sid="LUK 21:22" /><char style="wj">Bʉʼka mbɔ nɔ bɛ ndʉʉ ndə Nyii kie ndə mətyú bʉ̂ʼʉ, ndə məchìi nubə ndə bə nyɔ̀ʼ mu ŋwɔʼnə-Nyii fyú shʉəŋ.</char> <verse eid="LUK 21:22" /><verse number="23" style="v" sid="LUK 21:23" /><char style="wj">I bu nə tɛ̀nə tʉ bəke gʉʼnə ghɔŋbə bəke ndə bɔ̂ŋ tʉʼ nyùuhə vâa ndəŋ chî-ghɔ̄-bə. Bʉə-Isilɛ bu nyíɛ fɔŋ ŋgʉəʼ ghɔŋbə tʉʉbʉə-Nyii ndə i bu gwè tʉ bɔŋ.</char> <verse eid="LUK 21:23" /><verse number="24" style="v" sid="LUK 21:24" /><char style="wj">Bə bu yítə bəbɛʼbə nə setəbə, yátə bəbɛʼbə gɛ̀ nə bɔŋ ndəŋ fʉəhə mu lɔʼ-bətə̂ŋ-tə nchəŋnchəŋ-ɛŋ kəwʉʉnəmbi. Bə bu ghɔ́ʼ Jɛlosalɛŋ, bʉə təmə kínə Nyii fɛ, fyʉ́ʼhə bɔŋ tə ndʉʉ bʉə ndə bɔ̂ŋ gòʼ təmə kínə Nyii fɛ yi mì.</char><verse eid="LUK 21:24" /></para>
  <para style="s">Məgwe-Vaa-Woməsʉʉ</para>
  <para style="r">(<ref loc="MAT 24:29-31">Matia 24:29-31</ref>; <ref loc="MRK 13:24-27">Mak 13:24-27</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25" />
    <char style="wj">“Nubəcheʼbə nɔ bu yi bɛ yuo ndəŋ chichi, ndəŋ chisuu leʼnə bəlɔʼɔ. Kəchisê-fɛ̄ŋ, lɔʼ-bətə̂ŋ-tə bu bɛ mu ŋgʉəʼ leʼnə mbyuutəmbyuutə bʉʼka muu ndə i tʉʼ yùɔnə leʼnə lɛɛŋhə-muu-bə ndə bɔ̂ŋ tʉʼ sɛ́ʼnə.</char> <verse eid="LUK 21:25" /><verse number="26" style="v" sid="LUK 21:26" /><char style="wj">Bʉə bu kə́ gwònə gwùtə sê bʉʼka faa-kwu-kə ndə bɔ̂ŋ tʉʼ chyìi nu-ŋkwɔŋŋkwɔŋ-bə ndə i bɛ ndə məgwè mu kəwʉʉnəmbi. Bʉʼka bə bu ŋɛ̀hə nu-shʉ́əshʉ́ə-bə ndə bɔ̂ŋ bɛ yuo.</char> <verse eid="LUK 21:26" /><verse number="27" style="v" sid="LUK 21:27" /><char style="wj">Ndʉʉmɛ, bɔ̂ŋ bu nyíɛ Vaa-Woməsʉʉ, ɔ kə́ shíʼ gwè hə mu kəmbɔʼ nə ghʉəʼkə ghɔŋbə məŋwɔ̀ʼkwɛʼtəŋ.</char> <verse eid="LUK 21:27" /><verse number="28" style="v" sid="LUK 21:28" /><char style="wj">Ndʉʉ ndə b̈ii nyíɛ nubə-ɔ̄ŋ chʉ́ʉhə məfyú sê, b̈ii kie fyii, kə́ lɛ́nə fia mbɔ nchʉʼkətʉ-yii nɔʼ tʉʼ kə́ŋhə.”</char><verse eid="LUK 21:28" /></para>
  <para style="s">Lʉ̀ ndaa ndəŋ tyʉ-fik-kə</para>
  <para style="r">(<ref loc="MAT 24:32-35">Matia 24:32-35</ref>; <ref loc="MRK 13:28-31">Mak 13:28-31</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29" />Ɔ mɔ̀ʼ chəŋkə tʉ bɔŋ ghɔ̀ŋ mbɔ, <char style="wj">“B̈ii lɛ́nə tyʉ-fik-kə ghɔŋbə bəbɛʼtyʉbə inchəŋ.</char> <verse eid="LUK 21:29" /><verse number="30" style="v" sid="LUK 21:30" /><char style="wj">Ndʉʉ ndə bɔ̂ŋ tɔ́ kə́ fyùʼtə, b̈ii nyíɛ nə mbəŋ-yii kínə mbɔ ndʉʉkəbyʉʉ nɔʼ tʉʼ kə́ŋhə.</char> <verse eid="LUK 21:30" /><verse number="31" style="v" sid="LUK 21:31" /><char style="wj">Nɔ bɛ haʼ nɔ ghɔ, ndʉʉ ndə b̈ii nyíɛ nubə-ɔ̄ŋ kə́ fyú sê, bii kínə mbɔ Sɔ́ʼ-Nyii la nɔʼ kə́ŋhə.</char> <verse eid="LUK 21:31" /><verse number="32" style="v" sid="LUK 21:32" /><char style="wj">Nɔʼ m̈ɔ shyíi bii nə shʉəŋ mbɔ, ŋgwie-wo-ɔ̄ kʉʉ mì təmə nubə-ɔ̄ŋ inchəŋ nɔʼ fyú sê fɛ.</char> <verse eid="LUK 21:32" /><verse number="33" style="v" sid="LUK 21:33" /><char style="wj">Yuo ghɔŋbə chisêkə bu mì, təmə ŋgiekə-ɔŋ bɔŋ bu nə mì fɛ.</char><verse eid="LUK 21:33" /></para>
  <para style="s">A nɔ kie ndə mə-kə́-kíi dyʉʼbə</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34" />
    <char style="wj">“B̈ii láa bʉʼka i mə dìenə ndəŋ bii, ndə bii tʉʼ nú búu, jʉ̀ŋtə kə́ bɔŋleʼ kánə mbi. Təmə bii yi kwɔnə fyú ndəŋ chî-ghɔ̄-kə nə ŋkʉʼ.</char> <verse eid="LUK 21:34" /><verse number="35" style="v" sid="LUK 21:35" /><char style="wj">Bʉʼka chî-ɔ̄-kə bu gwè tʉ bʉə bənchəŋ ndə bɔ̂ŋ bɛ kəchisê-fɛ̄ŋ inchəŋ.</char> <verse eid="LUK 21:35" /><verse number="36" style="v" sid="LUK 21:36" /><char style="wj">B̈ii ŋɔ́ʼhə shʉtə-ii ndʉʉ tə mì ndʉʉ, kə́ gháaNyii mbɔ b̈ii kie ghʉəʼkə ndə mənyʉ́ʉ nubə-ɔ̄ŋ inchəŋ ndə i bu fyú nɔ, bɔŋleʼ tə́nə bəshʉ Vaa-Woməsʉʉ.”</char><verse eid="LUK 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37" />Jiso kə́ dàhə mu njaafɛ̀ʼndɛŋNyii chîbə inchəŋ. Kʉ̂ʉ bɛ ndʉʉbətyuʼ, ɔ fyú gɛ̀ chí ndəŋ kwɔŋ ndə bə tíi nə Kwɔŋ-bəTyʉ-Oli. <verse eid="LUK 21:37" /><verse number="38" style="v" sid="LUK 21:38" />Kʉ̂ʉ bɛ ndʉʉsɛŋkə bətyuʼbətyuʼ, bʉə bənchəŋ gwè mu njaafɛ̀ʼndɛŋNyii ndə məgwè yʉ́ nukə ndə ɔ tʉʼ dàhə.<verse eid="LUK 21:38" /></para>
  <chapter eid="LUK 21" />
  <chapter number="22" style="c" sid="LUK 22" />
  <para style="s">Bə yə̀ŋ tiɛŋ Jiso</para>
  <para style="r">(<ref loc="MAT 26:1-5">Matia 26:1-5</ref>; <ref loc="MRK 14:1-2">Mak 14:1-2</ref>; <ref loc="JHN 11:45-53">Jɔŋ 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1" />Chîbə kə́ kʉ̀ʼnə gwè ndə bʉə-Juu yú Nchəŋtə ndə bə Kwó Bele təmə yî chɔ fɛ, bə kə́ tíi nə Yíɛʼsii. <verse eid="LUK 22:1" /><verse number="2" style="v" sid="LUK 22:2" />Bətiefɛ̀ʼndɛŋNyii ghɔŋbə bʉə dàhə nuʼ-Mushi, nɔ kə́ kʉ́ʉ fia ndə məyí Jiso bɔ̌ŋbɔ̌ŋ bʉʼka bɔ̂ŋ kə́ fàa bʉə-bi.<verse eid="LUK 22:2" /></para>
  <para style="s">Juda bɛ́ŋ ndə məfɛ̀ŋ Jiso</para>
  <para style="r">(<ref loc="MAT 26:14-16">Matia 26:14-16</ref>; <ref loc="MRK 14:10-11">Mak 14:10-11</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3" />Juda Iskalo, mbyu vaafɔ̀ʼ-Jiso mu vâafɔʼɔ-bi njuɔ bûu nə wuŋ, ké ŋwɔŋ-ɛŋ tʉ Sata, ɔ bʉ́ʉhə ɔŋ. <verse eid="LUK 22:3" /><verse number="4" style="v" sid="LUK 22:4" />Ɔ gɛ̀ nyíɛ bətiefɛ̀ʼndɛŋNyii ghɔŋbə bʉəkwɛʼtəŋ bənchyii-mu-njaafɛ̀ʼndɛŋNyii, ndə məshʉ̀tə ghɔŋ bɔŋ nə yʉʼ fia ndə bəkɔ ɔ fɛ̀ŋ Jiso tʉ bɔŋ. <verse eid="LUK 22:4" /><verse number="5" style="v" sid="LUK 22:5" />Tʉʉ-yʉə bʉ̀ʉ, bɔ̂ŋ kɔ̀ʼnə ndə məlɔ̀ʼ ɔ. <verse eid="LUK 22:5" /><verse number="6" style="v" sid="LUK 22:6" />Ndʉʉghɔfii, ɔ bɛ́ŋ chʉ́ʉhə məkʉ́ʉ fia ndə məchɔ̀ʼhə Jiso kɔ́ tʉ bɔŋ, mbɔ bɔ̂ŋ chʉʼ yá ɔ bɔ̌ŋbɔ̌ŋ təmə bʉə buŋmbi chɔ fɛ.<verse eid="LUK 22:6" /></para>
  <para style="s">Jiso shʉ̀tə ŋwɔŋ-ɛŋ ndə məyú fɔ-Yíɛʼsii-bə</para>
  <para style="r">(<ref loc="MAT 26:17-25">Matia 26:17-25</ref>; <ref loc="MRK 14:12-21">Mak 14:12-21</ref>; <ref loc="JHN 13:21-30">Jɔŋ 13:21-30</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7" />Nduɔ, mbʉ bəchî nchəŋtə-ghɔ̄ kʉ̀ʼnə, Nchəŋtə ndə bə Kwó Bele təmə yî chɔ fɛ le, bɔŋleʼ kə́ bɛ chîkə ndə bə kie ndə məsíi vaabinjyʉʉ ndə məyú Yíɛʼsii nə yɔŋ. <verse eid="LUK 22:7" /><verse number="8" style="v" sid="LUK 22:8" />Jiso tə́ŋ Bita ghɔŋ Jɔŋ bəshʉ, gìe tʉ bɔŋ mbɔ, <char style="wj">“B̈ii gɛ̀ shʉ̀tə fɔ-Yíɛʼsii-bə, bʉʼʉ chʉʼ yú ndə məkwɛ́nə chî-Yíɛʼsii-kə.”</char><verse eid="LUK 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9" />Bɔ̂ŋ bíʼtə mbɔ, “A tʉʼ kʉ́ʉ mbɔ b̈aʼa gɛ̀ shʉ̀tə fa?”<verse eid="LUK 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10" />Ɔ bə̀ŋhə mbɔ, <char style="wj">“B̈ii yʉ́, ndə bii tʉʼ ŋíi mu Jɛlosalɛŋ, woləŋbɛʼ bu bìatə bii ndə ɔ bɛ̀ʼ təŋ-muu-kə, b̈ii gɛ̀ hə bɔ̌ŋ ɔŋ gɛ̀ ŋíi mu njaa ndə ɔ bu sʉ́ʉ chɔ.</char> <verse eid="LUK 22:10" /><verse number="11" style="v" sid="LUK 22:11" /><char style="wj">B̈ii bɔŋleʼ gìe tʉ mbʉ ŋwɔ̌ŋ-njaa mbɔ, ‘Chicha nɔ tʉʼ bíʼtə tʉ a mbɔ, “Njəŋ-njaa-bʉə-mətòʼ ba, ndə bəkɔ mɔ yú fɔ-Yíɛʼsii-bə chɔ baʼabə vâafɔʼɔ-bɔŋ?” ’</char> <verse eid="LUK 22:11" /><verse number="12" style="v" sid="LUK 22:12" /><char style="wj">Ɔ bu dʉ̀ʼ njəŋ-njaakwɛʼtəŋ tʉ bii kweghɔʼ ndə bə nɔʼ shʉ̀tə mu-i, b̈ii shʉ̀tə chɔ tʉ bʉʼʉ”.</char><verse eid="LUK 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 22:13" />Bɔ̂ŋ gɛ̀ mu mbʉ kəyəŋkwɛʼtəŋ-ghɔ̄, gɛ̀ nyíɛ nubə kɛŋ haʼ ndə Jiso kə shyíi bɔŋ. Bɔ̂ŋ shʉ̀tə mbʉ bəfɔ Yíɛʼsii chɔ.<verse eid="LUK 22:13" /></para>
  <para style="s">Fɔyu-Tiekətʉ-bə</para>
  <para style="r">(<ref loc="MAT 26:26-30">Matia 26:26-30</ref>; <ref loc="MRK 14:22-26">Mak 14:22-26</ref>; <ref loc="1CO 11:23-25">1 Kɔlɛŋ 11:23-25</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14" />Mbʉ ndʉʉ kʉ̂ʉ kʉ̀ʼnə, Jiso ghɔŋbə mbʉ bəlɔntəŋ-bi njuɔ bûu nə wuŋ chə̀ŋtə dùʼ mbʉə tebele. <verse eid="LUK 22:14" /><verse number="15" style="v" sid="LUK 22:15" />Jiso ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Mɔ nɔ kɛŋ kə́ mʉ̀ʉ nə fyii-ɔ inchəŋ mbɔ bʉʼʉ bu chə̀ŋtə, yú nchəŋtə Yíɛʼsii, ŋgʉəʼ-ɔ buŋ chʉ́ʉhə.</char> <verse eid="LUK 22:15" /><verse number="16" style="v" sid="LUK 22:16" /><char style="wj">Mɔ nɔ tʉʼ kʉ́ʉ shyíi bii nduɔ mbɔ, mɔ bieleʼ nə yú Yíɛʼsii fɛ, tʉ nukə ndə Yíɛʼsii bɛ yɔŋ nə fyú shʉəŋ ndʉʉ ndə Nyii bu kə́ sɔ́ʼ fɔŋ.”</char><verse eid="LUK 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17" />Ndʉʉghɔfii, ɔ lʉ̀ ndʉ̂ʉ-məndʉʼ kɔ́ ndɔ tʉ Nyii chɔ ghɔ̀ŋ mbɔ, <char style="wj">“B̈ii kɔ́ yɔ̄ŋ-yə, gyʉ̀ətə mu bii.</char> <verse eid="LUK 22:17" /><verse number="18" style="v" sid="LUK 22:18" /><char style="wj">M̈ɔ shyíi bii mbɔ mɔ bieleʼ nə nú ndʉʼmə-ɔ̄ŋ fɛ, tə Nyii nə sɔ́ʼ bʉə-bi nə fɔŋ.”</char><verse eid="LUK 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19" />Ɔ lʉ̀ bele, kʉ̂ʉ kɔ́ ndɔ tʉ Nyii chɔ, bə́ʼtə kɔ́ tʉ bɔŋ ghɔ̀ŋ mbɔ, <char style="wj">“Nɔ bɛ mbɔʼ mbʉə-ɔ nɔ ndə mɔ fɛ̀ʼndɛŋ chɔ yie-bii. B̈ii kə́ chìi yɔ̄ŋ-yə ndə məkwɛ́nə mɔ.”</char> <verse eid="LUK 22:19" /><verse number="20" style="v" sid="LUK 22:20" />Ndʉʉ ndə b̈ɔ̂ŋ yú fɔ-ndʉʉbuumbi-bə liʼ, Jiso lʉ̀ ibɛʼ-yə ndʉ̂ʉ-məndʉʼ ghɔ̀ŋ mbɔ, <char style="wj">“Ndʉʼmə-ɔ̄ŋ nɔ bɛ ŋkaa-fefe-mə ndə bə kɔ́ʼ nə fɔbʉəkə-ɔŋ ndə mɔ tyù bʉʼka bii.</char><verse eid="LUK 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 22:21" />
    <char style="wj">“B̈ii nyíɛ! Bɔŋ wo ndə ɔ bu fɛ̀ŋ mɔ tʉ bʉə-bàa-bɔŋ nɔ tʉʼ yú baʼa ɔ ndəŋ tebele-fɛ̄ŋ.</char> <verse eid="LUK 22:21" /><verse number="22" style="v" sid="LUK 22:22" /><char style="wj">Vaa-Woməsʉʉ nɔ kie məkwú bʉʼka Nyii nɔʼ kə shʉ̀tə nɔ, bɔŋ ŋgʉəʼ kətʉ wo ndə ɔ bu fɛ̀ŋ ɔŋ!”</char><verse eid="LUK 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 22:23" />Mbʉ vâafɔʼɔ-bi chʉ́ʉhə kə́ bíʼtə tʉ ŋwɔŋtə-ʉə nə wo ndə bəkɔ ɔ chìi ntɛ-kənu-ɔ̄ŋ mu bɔŋ.<verse eid="LUK 22:23" /></para>
  <para style="s">Bəŋʉʉ te wo ndə bu bɛ wokwɛʼtəŋ</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24" />Ndə bɔ̂ŋ tʉʼ kwə́ʼ gɛ̀ le, bəŋʉʉ chʉ́ʉhə mu bɔŋ te wo ndə ɔ bu bɛ fɔŋ wokwɛʼtəŋ. <verse eid="LUK 22:24" /><verse number="25" style="v" sid="LUK 22:25" />Jiso shyíi bɔŋ mbɔ, <char style="wj">“B̃əfɔŋ-kəwʉʉnəmbi-bɔ̄ŋ nɔ sɔ́ʼ bʉə-bʉə nə kwɛ̀ŋhə. Bɔŋ mbʉ bəfɔŋ-kəwʉʉnəmbi kə́ leʼ kʉ́ʉ mbɔ b̈ə kə́ tíi bɔŋ nə bʉə-buuŋjyu.</char> <verse eid="LUK 22:25" /><verse number="26" style="v" sid="LUK 22:26" /><char style="wj">Bii bɔŋ kie ndə məbɛ nɔ fɛ, wokwɛʼtəŋ mu bii nɔ kie ndə məlʉ̀ ŋwɔŋ-ɛŋ nə vaambuɔ, wo ndə ɔ tʉʼ sɔ́ʼ bii, kie ndə məlʉ̀ ŋwɔŋ-ɛŋ nə vaafɔ̀ʼ.</char> <verse eid="LUK 22:26" /><verse number="27" style="v" sid="LUK 22:27" /><char style="wj">Ndə ŋkɛŋ kənu, t̃iefɔʼ nɔ dùʼ ndəŋ tebele, vâafɔʼɔ mɔ̀ʼ fɔbə kɔ́ tʉ ɔŋ. Ndə nɔ, bʉʼʉ nɔ bɛ fɛ̄ŋ, mɔ kə́ bɛ ndə vaafɔ̀ʼ mu bii.</char><verse eid="LUK 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 22:28" />
    <char style="wj">“Nɔ bɛ bii, ndə bii kə káa mbʉə mɔ lʉ̀ hə ndʉʉ ndə mɔ kə́ nyíɛ ŋgʉəʼ</char> <verse eid="LUK 22:28" /><verse number="29" style="v" sid="LUK 22:29" /><char style="wj">haʼ ndə Nyii nɔʼ kə kɔ́ ghʉəʼkə tʉ mɔ ndə məbɛ fɔŋ, mbəŋ-ɔŋ nɔ tʉʼ kɔ́ ghʉəʼkə tʉ bii,</char> <verse eid="LUK 22:29" /><verse number="30" style="v" sid="LUK 22:30" /><char style="wj">mbɔ bʉʼʉ yi kə́ yú mɔʼɔ vɛʼ ndə mɔ bu yi bɛ fɔŋ. Mɔ nɔ chìi yɔ̄ŋ-yə mbɔ bii bu dùʼtə ghɔ ndəŋ yetəbə, kə́ sɔ́ʼ lɔŋ-Isilɛ-bə njuɔ bûu nə wuŋ.”</char><verse eid="LUK 22:30" /></para>
  <para style="s">Jiso núhə tʉ Samu Bita hə bəshʉ mbɔ ɔ la bu tɛ́ŋ ɔŋ</para>
  <para style="r">(<ref loc="MAT 26:31-35">Matia 26:31-35</ref>; <ref loc="MRK 14:27-31">Mak 14:27-31</ref>; <ref loc="JHN 13:36-38">Jɔŋ 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31" />Jiso tíi Bita mbɔ, <char style="wj">“Samu, Samu! Sata nɔʼ gháa fia ndə məyúotə bii, kwètə bii ndə bə kwètə baakə le.</char> <verse eid="LUK 22:31" /><verse number="32" style="v" sid="LUK 22:32" /><char style="wj">Mɔ bɔŋ nɔʼ gháaNyii yie-a mbɔ məmɔʼfyii-a ndəŋ Nyii mə gwù fɛ. A kʉ̂ʉ bʉ̀nə lɔ̀ gwè tʉ mɔ nɔ, kwáa bəliŋ-ba, kɔ́ ghʉəʼkə tʉ bɔŋ.”</char><verse eid="LUK 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33" />Bita bə̀ŋhə tʉ bɔŋ mbɔ, “Tiekətʉ, mɔ nɔʼ shʉ̀tə ŋwɔŋ-ɔŋ ndə məgɛ̀ njaa-chaŋ baʼa a, tə buŋ kwú baʼa a!”<verse eid="LUK 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34" />Jiso bə̀ŋhə mbɔ, <char style="wj">“Bita, nɔʼ m̈ɔ shyíi a, ŋkʉəʼə bu yi kə tʉ́ʉ laa nɔ, tʉ a nɔʼ kɔ́tuu a vɛʼ tia mbɔ a la kínə mɔ fɛ.”</char><verse eid="LUK 22:34" /></para>
  <para style="s">Kwo-kyʉə, kwo leʼnə setəkə</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35" />Jiso bíʼtə mbɔ, <char style="wj">“Mɔ kə tə́ŋ bii ndə məgɛ̀ kwə́ʼ ŋgieNyiikə təmə kwo-kyʉə fɛ, təmə kwo fɛ, təmə takwubə fɛ le, tʉ bii kia byúu ka?”</char></para>
  <para style="p" vid="LUK 22:35">Bɔ̂ŋ bə̀ŋhə mbɔ, “Fɔkə fɛ.”<verse eid="LUK 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36" />Jiso ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Bɔŋ nduɔ kaʼ bii kie kyʉə, b̈ii lʉ̀, lʉ̀ bəkwo-bii, kaʼ bii gòʼ təmə kie setəkə fɛ, b̈ii fɛ̀ŋ ndyi-fəʼə-hə-ii, nyúɔ chɔ.</char> <verse eid="LUK 22:36" /><verse number="37" style="v" sid="LUK 22:37" /><char style="wj">Bʉʼka mbɔ ndʉʉ nɔʼ kʉ̀ʼnə ndə nukə ndə bə nə nyɔ̀ʼ mu ŋwɔʼnə-Nyii te mɔ bu fyú shʉəŋ, bə ghɔ̀ŋ mbɔ, ‘Bə nɔ súu ɔ mu bʉə-bʉ̂ʼʉ.’ Ɔŋ! Nukə-ɔ̄ŋ bu fyú shʉəŋ.”</char><verse eid="LUK 22:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38" />Bɔ̂ŋ tíi ɔ mbɔ, “Tie-yaʼ, baʼa nɔ kie setəbə ibûu!”</para>
  <para style="p" vid="LUK 22:38">Ɔ ghɔ̀ŋ mbɔ, <char style="wj">“I nɔʼ kʉ̀ʼnə.”</char><verse eid="LUK 22:38" /></para>
  <para style="s">Jiso gháaNyii ndəŋ Kwɔŋ-bəTyʉ-Oli</para>
  <para style="r">(<ref loc="MAT 26:36-46">Matia 26:36-46</ref>; <ref loc="MRK 14:32-42">Mak 14:32-42</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39" />Jiso shíʼ nduɔ kóʼ gɛ̀ ndəŋ Kwɔŋ-bəTyʉ-Oli, haʼ ndə ɔ̃ chìi nɔ təvɛʼtəvɛʼ, vâafɔʼɔ-bi kə́ gɛ̀ hə bɔ̌ŋ ɔŋ. <verse eid="LUK 22:39" /><verse number="40" style="v" sid="LUK 22:40" />Ndə bɔ̂ŋ bɛ ndəŋ ghɔ, ɔ gìe tʉ bɔŋ mbɔ, <char style="wj">“B̈ii gháaNyii bʉʼka bii mə yi gwù mu nubə ndə i mùutə wo mbɔ ɔ̈ gwù mu bʉʼʉ.”</char><verse eid="LUK 22:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 22:41" />Ɔ kwɛ̀ʼtə mbʉə bɔŋ tə kɔ́ kʉʉkə, kwíʼtə sê, kə́ gháaNyii, <verse eid="LUK 22:41" /><verse number="42" style="v" sid="LUK 22:42" />ghɔ̀ŋ mbɔ, <char style="wj">“Tie-ɔ, kaʼ tʉʉ-a kʉ̀ʉ, ä fí ndʉ̂ʉ ŋgʉəʼ-ɔ̄ hə kəghɔ-mɔ. Mɔ bɔŋ bu fɔ̀ʼ yi ndə tʉʉ-a kʉ̀ʉ, kaa ŋkʉʉnə-tʉʉ-ɔ fɛ.”</char> <verse eid="LUK 22:42" /><verse number="43" style="v" sid="LUK 22:43" />Ndʉʉghɔfii, wontəŋNyii gwè hə yuo, gwè kɔ́ ghʉəʼkə tʉ ɔŋ. <verse eid="LUK 22:43" /><verse number="44" style="v" sid="LUK 22:44" />Ŋgʉəʼ kɛŋ dìenə mbʉə-Jiso, ɔ bìʼ gháaNyii shʉ́əshʉ́ə tə lyʉʼnə-i kə́ chə́ŋtə sê nə ŋwia-kəfɔbʉə-mə.<verse eid="LUK 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45" />Ndʉʉ ndə ɔ lɔ̀ hə ndə məgháaNyii, ɔ bʉ̀nə gɛ̀ nyíɛ vâafɔʼɔ-bi, kə gɛ̀ nyíɛ bɔŋ, bɔ̂ŋ kə́ bɛ́ŋbɛ́ŋ, nɔʼ káa bʉʼka bɛʼkə ndə i dìenə liɛŋ-bɔŋ. <verse eid="LUK 22:45" /><verse number="46" style="v" sid="LUK 22:46" />Jiso bíʼtə tʉ bɔŋ mbɔ, <char style="wj">“Bii tʉʼ bɛ́ŋ ka? B̈ii lɔ̀ hə sê kə́ gháaNyii bʉʼka bii mə yi gwù mu nubə ndə i mùutə wo mbɔ ɔ̈ gwù mu bʉʼʉ.”</char><verse eid="LUK 22:46" /></para>
  <para style="s">Bə fɛ̀ŋ Jiso bɔŋleʼ yá ɔ</para>
  <para style="r">(<ref loc="MAT 26:47-56">Matia 26:47-56</ref>; <ref loc="MRK 14:43-50">Mak 14:43-50</ref>; <ref loc="JHN 18:3-11">Jɔŋ 18:3-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47" />Ndə ɔ kə́ bíe kwə́ʼ, nuɔ-bʉə fyú tʉ ɔŋ, wo ndə bə kə́ tíi ɔ nə Juda mu vâafɔʼɔ-bi njuɔ bûu nə wuŋ, tə́nə bəshʉ kə́ dʉ̀ʼ fia tʉ bɔŋ. Ɔ kwɛ̀ʼtə gwè mbʉə-Jiso ndə məbɔ́nə ɔŋ gìe tʉ ɔŋ. <verse eid="LUK 22:47" /><verse number="48" style="v" sid="LUK 22:48" />Jiso bíʼtə tʉ ɔŋ mbɔ, <char style="wj">“Juda, bɛ nə məbɔ́nə ndə a bu fɛ̀ŋ Vaa-Woməsʉʉ mɛ?”</char><verse eid="LUK 22:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49" />Ndə vâafɔʼɔ-Jiso nyíɛ nukə ndə i bɛ bəshʉ gwè, bɔ̂ŋ ghɔ̀ŋ mbɔ, “Tie-yaʼ, b̈aʼa gwúu nə setəbə mɛ?” <verse eid="LUK 22:49" /><verse number="50" style="v" sid="LUK 22:50" />Ndʉʉghɔfii, mbyu vaafɔ̀ʼ-Jiso síi tyunə-fʉə-tiefɛ̀ʼndɛŋkwɛʼtəŋNyii-kə kwiimɔʼnə chʉ̀ə.<verse eid="LUK 22:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51" />Bɔŋ Jiso bə̀ŋhə mbɔ, <char style="wj">“Mɔ mə leʼ nyíɛ fɛ!”</char> Ɔ kə̀ŋ tyunə-wo-ghɔ̄-kə, i yə́ŋ.<verse eid="LUK 22:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52" />Ndʉʉmɛ, Jiso ghɔ̀ŋ tʉ bətiefɛ̀ʼndɛŋNyii ghɔŋbə bʉəkwɛʼtəŋ bənchyii-njaafɛ̀ʼndɛŋNyii leʼnə bəntəŋbəshʉ ndə bɔ̂ŋ kə́ gwè tʉ ɔŋ mbɔ, <char style="wj">“Bii tʉʼ gwè tʉ mɔ nə setəbə ghɔŋbə mbuuhə təka fi nə bii tʉʼ gwè tʉ lʉʼ shùɔ wo?</char> <verse eid="LUK 22:52" /><verse number="53" style="v" sid="LUK 22:53" /><char style="wj">Ndʉʉ ndə mɔ nə kə́ bɛ bʉʼʉ mɔʼɔ mu chunjaafɛ̀ʼndɛŋNyii bəchibəchi təmə bii yá mɔ fɛ. Bɔŋ nduɔ nɔ bɛ yii-yə ndʉʉ bʉʼka njəŋkə tʉʼ sɔ́ʼ mbi.”</char><verse eid="LUK 22:53" /></para>
  <para style="s">Bita tɛ́ŋ Jiso</para>
  <para style="r">(<ref loc="MAT 26:57-58">Matia 26:57-58</ref>,<ref loc="MAT 26:69-75">69-75</ref>; <ref loc="MRK 14:53-54">Mak 14:53-54</ref>,<ref loc="MRK 14:66-72">66-72</ref>; <ref loc="JHN 18:12-18">Jɔŋ 18:12-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54" />Ndʉʉmɛ, bənchyii-njaafɛ̀ʼndɛŋNyii yá Jiso gɛ̀ nə nɔŋ mu njaa-tiefɛ̀ʼndɛŋkwɛʼtəŋNyii. Bita kə bɛ dɔdɔ gɛ̀ hə bɔ̌ŋ bɔŋ. <verse eid="LUK 22:54" /><verse number="55" style="v" sid="LUK 22:55" />Bɔ̂ŋ kʉ̂ʉ dyì viʼi ntəŋntəŋ sêfu, chə̀ŋtə chɔ kə́ yóʼ, Bita gwè dùʼ chɔ ghɔŋ bɔŋ. <verse eid="LUK 22:55" /><verse number="56" style="v" sid="LUK 22:56" />Vaabəkebɛʼ ndə ɔ bɛ vaafɔ̀ʼ-wo, nyíɛ ɔŋ ndə ɔ dùʼ mbʉə viʼi. Ɔ tʉ́ʼ shʉ-i ndəŋ ɔŋ, ghɔ̀ŋ mbɔ, “Wo-ɔ̄ nɔ nə bɛ ghɔŋ Jiso!”<verse eid="LUK 22:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57" />Bita kɔ́tuu i, ghɔ̀ŋ mbɔ, “Vaabəke, mɔ kínə ɔŋ fɛ!”<verse eid="LUK 22:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58" />Kʉʉkə məniʼ, ibɛʼ-yə wo nyíɛ ɔŋ, ghɔ̀ŋ mbɔ, “A le bɛ haʼ ibɛʼ-yə mbyu wo-ghɔ̄!”</para>
  <para style="p" vid="LUK 22:58">Bita bə̀ŋhə mbɔ, “Woləŋ, laa yɔŋ!”<verse eid="LUK 22:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59" />Ŋgwɔʼmbi kʉ̂ʉ kwɛ̀ʼtə tə bɛ ndə chí imɔʼ, ibɛʼ-yə wo gwè kwə́ʼ shʉ́əshʉ́ə ghɔ̀ŋ mbɔ, “Leʼ shʉəŋ, wo-ɔ̄ ghɔ nɔ kə bɛ ghɔŋ Jiso mɔʼɔ, bʉʼka nɔ bɛ wo-Galili ghɔ!”<verse eid="LUK 22:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60" />Bita bə̀ŋhə mbɔ, “Woləŋ, mɔ kínə nukə ndə a tʉʼ gìe fɛ̄ŋ fɛ!”</para>
  <para style="p" vid="LUK 22:60">Haʼ ndʉʉmɛ, ndə ɔ kə́ bíe kwə́ʼ, ŋkʉəʼə tʉʉ. <verse eid="LUK 22:60" /><verse number="61" style="v" sid="LUK 22:61" />Mbʉ Tiekətʉ kíahə shʉ-i lɛ́nə Bita. Ndʉʉmɛ, Bita kwɛ́nə nukə ndə Tiekətʉ nɔʼ kə shyíi ɔ mbɔ, <char style="wj">“Ŋkʉəʼə bu yi kə tʉ́ʉ laa nɔ tʉ a nɔʼ kɔ́tuu a vɛʼ tia mbɔ a la kínə mɔ fɛ.”</char> <verse eid="LUK 22:61" /><verse number="62" style="v" sid="LUK 22:62" />Bita fyú gɛ̀ mbi kɛŋ gɛ̀ gwía nə shʉəŋ.<verse eid="LUK 22:62" /></para>
  <para style="s">Bə chɛ̀ŋtə Jiso bɔŋleʼ gwúu ɔ</para>
  <para style="r">(<ref loc="MAT 26:67-68">Matia 26:67-68</ref>; <ref loc="MRK 14:65">Mak 14:65</ref>)</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63" />Bʉə ndə bɔ̂ŋ kə́ chyìi Jiso, bɔ̂ŋ chʉ́ʉhə mədʉ̀ʉhə ɔŋ bɔŋleʼ gwúu ɔ. <verse eid="LUK 22:63" /><verse number="64" style="v" sid="LUK 22:64" />Bɔ̂ŋ bɔ̀ŋ shʉ-i kə́ bíʼtə tʉ ɔŋ mbɔ, “Tɔ wo ndə ɔ kwɔ̀ŋ aŋ!” <verse eid="LUK 22:64" /><verse number="65" style="v" sid="LUK 22:65" />Bɔ̂ŋ bìʼ kɔ́ nchɛŋhə kətʉ-ɔ yɔ́ŋyɔ́ŋ.<verse eid="LUK 22:65" /></para>
  <para style="s">Bə gɛ̀ nə Jiso mu kaŋsotə</para>
  <para style="r">(<ref loc="MAT 26:57-67">Matia 26:57-67</ref>; <ref loc="MRK 14:53-65">Mak 14:53-65</ref>; <ref loc="JHN 18:19-24">Jɔŋ 18:19-24</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66" />Ndʉʉ ndə mbi lɛ́ɛŋ sê, bəntəŋbəshʉ-bʉə-Juu ghɔŋbə bətiefɛ̀ʼndɛŋNyii leʼnə bʉə dàhə nuʼ-Mushi chə̀ŋtə mu kaŋsotə, bə gwè nə Jiso bəshʉ bɔŋ. <verse eid="LUK 22:66" /><verse number="67" style="v" sid="LUK 22:67" />Bɔ̂ŋ gìe tʉ ɔŋ mbɔ, “Kaʼ a bɛ Wo ndə Nyii Kùŋ Tə́ŋ, shyíi baʼa.”</para>
  <para style="p" vid="LUK 22:67">Jiso bə̀ŋhə mbɔ, <char style="wj">“Kaʼ mɔ shyíi bii, bii bɛ́ŋ fɛ.</char> <verse eid="LUK 22:67" /><verse number="68" style="v" sid="LUK 22:68" /><char style="wj">Mɔ bɔŋ bíʼtə tʉ bii, bii bə̀ŋhə fɛ.</char> <verse eid="LUK 22:68" /><verse number="69" style="v" sid="LUK 22:69" /><char style="wj">Lʉ̀ hə nduɔ gɛ̀ nə shʉbə Vaa-Woməsʉʉ bu dùʼ kwiiləŋ Nyii wo shʉ́əshʉ́ə.”</char><verse eid="LUK 22:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70" />Bɔ̂ŋ bənchəŋ bíʼtə mbɔ, “Le bɛ mbɔ a bɛ VaaNyii mɛ?” Jiso bə̀ŋhə mbɔ, <char style="wj">“I nɔ kʉ̀ʼnə haʼ ndə bii ghɔ̀ŋ nɔ.”</char> <note caller="+" style="f"><char style="fr" closed="false">22:70 </char><char style="ft" closed="false">I nɔ dʉ̀ʼ mbɔ Jiso nɔ bɛ́ŋ nukə ndə bɔŋ gìe təmə bɔŋ bɛ́ŋ nə sɔ́ʼ fɛ.</char></note><verse eid="LUK 22:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71" />Bɔ̂ŋ bənchəŋ ghɔ̀ŋ mbɔ, “Bʉʼʉ tʉʼ kʉ́ʉ leʼ yʉ́ ka nduɔ kəghɔ-bəbɛʼbʉə te ɔ? Bʉʼʉ nɔʼ yʉ́ ndəŋ yi-yə wuochukə.”<verse eid="LUK 22:71" /></para>
  <chapter eid="LUK 22" />
  <chapter number="23" style="c" sid="LUK 23" />
  <para style="s">Bə gwè nə Jiso bəshʉ Bale</para>
  <para style="r">(<ref loc="MAT 27:1-2">Matia 27:1-2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="MRK 15:1-5">Mak 15:1-5</ref>; <ref loc="JHN 18:28-38">Jɔŋ 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1" />Ndʉʉmɛ, mbʉ nuɔ-bʉə lɔ̀ hə sê bənchəŋ lʉ̀ Jiso, gɛ̀ nə nɔŋ bəshʉ Bale. <verse eid="LUK 23:1" /><verse number="2" style="v" sid="LUK 23:2" />Bɔ̂ŋ chʉ́ʉhə mədʉ̀ʼ ghɔbə-ʉə chu-ɔ, kə́ ghɔ̀ŋ mbɔ, “Baʼa nɔ nyíɛ wo-ɔ̄, ɔ kə́ tòʼ bə̀ŋtə mu lɔʼɔ. Ɔ kə́ tɛ́ŋ mbɔ b̈ə mə leʼ lɔ̀ʼ tashi tʉ Fɔŋ-Luŋ fɛ, bɔŋ-kə́-leʼ ghɔ̀ŋ mbɔ ɔ la bɛ Wo ndə Nyii Kùŋ Tə́ŋ bɔŋ-kə́-leʼ bɛ Fɔŋ.”<verse eid="LUK 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3" />Ndʉʉmɛ, Bale bíʼtə tʉ Jiso mbɔ, “A bɛ mbʉ Fɔŋ-bʉə-Juu mɛ?”</para>
  <para style="p" vid="LUK 23:3">Jiso bə̀ŋhə mbɔ, <char style="wj">“Nɔ bɛ ndə a ghɔ̀ŋ.”</char><verse eid="LUK 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4" />Ndʉʉmɛ, Bale gìe tʉ bətiefɛ̀ʼndɛŋNyii ghɔŋbə nuɔ-bʉə ndə bɔ̂ŋ bɛ chɔ mbɔ, “Mɔ nyíɛ nu-mɔ̀ʼmbɛ-kə ndə bəkɔ mɔ ghɔ̀ŋ mbɔ ɔ chìi fɛ.”<verse eid="LUK 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5" />Bɔ̂ŋ lyʉ̀ʉ haʼ mbɔ, “Ntɛ-bənu-hə ndə ɔ tʉʼ dàhə i la tʉʼ bə̀ŋtə mu Judia. Ɔ nɔ chʉ́ʉhə Galili, nɔʼ gwè nə yɔ̄ŋ-yə nduɔ tə dàa fɛ̄ŋ.”<verse eid="LUK 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6" />Bale kʉ̂ʉ yʉ́ yɔ̄ŋ-yə, bíʼtə mbɔ, “Ɔ bɛ wo-Galili mɛ?” <verse eid="LUK 23:6" /><verse number="7" style="v" sid="LUK 23:7" />Ɔ kʉ̂ʉ yʉ́ mbɔ ɔ lɔ̀ hə kəyəŋ ndə Hɛlo tʉʼ sɔ́ʼ chɔ, ɔ tə́ŋ ɔŋ kɔ́ tʉ Hɛlo, ndə ɔ kə bɛ haʼ Jɛlosalɛŋ vɛʼ-ghɔ̄.<verse eid="LUK 23:7" /></para>
  <para style="s">Jiso bəshʉ Hɛlo</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8" />Hɛlo kʉ̂ʉ nyíɛ Jiso, tʉʉ i bʉ̀ʉ daa, bʉʼka mbɔ ɔ nɔ nə kə́ kʉ́ʉ ndə mənyíɛ ɔŋ lʉ̀ hə mbibɛʼ. Nubə ndə ɔ nɔʼ kə yʉ́ te ɔ, ɔ kə́ kʉ́ʉ ndə mənyíɛ nukəcheʼkə ndə ɔ bu chìi. <verse eid="LUK 23:8" /><verse number="9" style="v" sid="LUK 23:9" />Ɔ bíʼtə nubə tʉ ɔŋ buŋmbi. Bɔŋ təmə Jiso bə̀ŋhə nukə tʉ ɔŋ fɛ. <verse eid="LUK 23:9" /><verse number="10" style="v" sid="LUK 23:10" />Bətiefɛ̀ʼndɛŋNyii ghɔŋbə bʉə dàhə nuʼ-Mushi kə́ bɛ chɔ, nə tʉʉbʉə, bɔ̂ŋ bìʼ mɔ̀ʼ nubə kətʉ-ɔ. <verse eid="LUK 23:10" /><verse number="11" style="v" sid="LUK 23:11" />Hɛlo ghɔŋbə bəsɔge-bi kə́ chɛ̀ŋ ɔŋ, bɔŋ-kə́-leʼ dʉ̀ʉhə ɔŋ. Bɔ̂ŋ mɔ̀ʼ ndyi-kyʉə-hə mbʉə-ɔ, tə́ŋ byʉ̀hə ɔŋ, kɔ́ tʉ Bale. <verse eid="LUK 23:11" /><verse number="12" style="v" sid="LUK 23:12" />Hɛlo ghɔŋ Bale nɔ nə bàanə shʉtə-ʉə, kʉ̂ʉ bɛ yɔ̂ŋ-ghɔ̄, bɔ̂ŋ chʉ́ʉhə məbʉ̀ʉ.<verse eid="LUK 23:12" /></para>
  <para style="s">Bə chʉ̀ə ŋkwɛ mbɔ b̈ə yí Jiso</para>
  <para style="r">(<ref loc="MAT 27:15-26">Matia 27:15-26</ref>; <ref loc="MRK 15:6-15">Mak 15:6-15</ref>; <ref loc="JHN 18:39-19:16">Jɔŋ 18:39–19:16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13" />Bale chə̀ŋ bətiefɛ̀ʼndɛŋNyii ghɔŋbə bʉəkwɛʼtəŋ leʼnə bʉə-lɔʼɔ, <verse eid="LUK 23:13" /><verse number="14" style="v" sid="LUK 23:14" />ghɔ̀ŋ tʉ bɔŋ mbɔ, “Bii nɔ gwè nə wo-ɔ̄ mbɔ ɔ la tʉʼ dàhə bʉə, bɔ̂ŋ kə́ kwɛ̀ŋhə, mɔ nɔʼ tyúutə ɔŋ bəshʉ bii təmə bɔŋ nyíɛ nukə ndə bii ghɔ̀ŋ mbɔ ɔ chìi fɛ. <verse eid="LUK 23:14" /><verse number="15" style="v" sid="LUK 23:15" />Təkɔmə Hɛlo ghɔ, bii le tʉʼ nyíɛ, ɔ nɔ byʉ̀hə ɔŋ kɔ́ tʉ bʉʼʉ, bʉʼka ɔ chʉʼ chìi nu-mɔ̀ʼmbɛ-kə ndə bəkɔ bə yí ɔ bʉʼka yɔŋ fɛ. <verse eid="LUK 23:15" /><verse number="16" style="v" sid="LUK 23:16" />Mɔ bu gwúu ɔ, mɛ̀ʼtə ɔŋ, ɔ̈ gɛ̀ nə wi.” <verse eid="LUK 23:16" /><verse number="17" style="v" sid="LUK 23:17" />[Ɔ nɔ kə kie ndə mə-yaʼ-fyúhə mbyu wo-imɔʼ chaŋ, ndəŋ chî-nchəŋtə-Yíɛʼsii-kə.]<verse eid="LUK 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18" />Bɔ̂ŋ bənchəŋ tíi vɛʼ mɔʼɔ mbɔ, “Yí ɔ! Fyúhə Balaba kɔ́ tʉ baʼa!” <verse eid="LUK 23:18" /><verse number="19" style="v" sid="LUK 23:19" />Bə nɔ nə fʉ̀əŋ Balaba mu njaa-chaŋ bʉʼka ɔ gwè nə ntɔŋntɔŋ mu kəyəŋkwɛʼtəŋ tə nɔʼ yí wo. <verse eid="LUK 23:19" /><verse number="20" style="v" sid="LUK 23:20" />Bale bìʼ fʉ̀ʉtə mbʉ bʉə, bʉʼka ɔ nɔ kə́ kʉ́ʉ yɔ̀ʼ ghɔkə ndəŋ Jiso. <verse eid="LUK 23:20" /><verse number="21" style="v" sid="LUK 23:21" />Bɔ̂ŋ bìʼ tíi haʼ mbɔ, “Kwɛ̀ŋ ɔŋ ndəŋ tyʉntɔɔnəkə, kwɛ̀ŋ ɔŋ yí!”<verse eid="LUK 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22" />Ɔ bìʼ kwə́ʼ tʉ bɔŋ ndə vɛʼ tia, kə́ bíʼtə mbɔ, “Bʉʼka ka? Ɔ nɔ̂ʼ chìi ka? Mɔ nyíɛ nu-mɔ̀ʼmbɛ-kə ndə ɔ nɔ̂ʼ chìi tə bə kə́ yí ɔ fɛ. Mɔ bu gwúu ɔ, yɔ̀ʼ ghɔkə-ɔŋ hə ndəŋ ɔŋ, ɔ̈ gɛ̀.”<verse eid="LUK 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23" />Bɔ̂ŋ bìʼ lyʉ̀ʉ tíi nə ghʉəʼkə mbɔ b̈ə la kwɛ̀ŋ ɔŋ ndəŋ tyʉntɔɔnəkə. Bale yʉ́ gwia-yʉə. <verse eid="LUK 23:23" /><verse number="24" style="v" sid="LUK 23:24" />Bale bɛ́ŋ nukə ndə bɔ̂ŋ tʉʼ bíʼtə tʉ ɔŋ. <verse eid="LUK 23:24" /><verse number="25" style="v" sid="LUK 23:25" />Ɔ fyúhə wo ndə bə fʉ̀əŋ ɔŋ mu njaa-chaŋ bʉʼka məbyùutə yəŋbə ghɔŋbə məyí wo, kə́ bɛ wo ndə bɔ̂ŋ kə́ bíʼtə, bɔŋ ɔ leʼ kɔ́ bə Jiso mu kəghɔ-bɔŋ.<verse eid="LUK 23:25" /></para>
  <para style="s">Bə kwɛ̀ŋ Jiso yí</para>
  <para style="r">(<ref loc="MAT 27:32-44">Matia 27:32-44</ref>; <ref loc="MRK 15:21-32">Mak 15:21-32</ref>; <ref loc="JHN 19:17-27">Jɔŋ 19:17-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26" />Ndə bɔ̂ŋ lʉ̀ ɔ kə́ gɛ̀ nə nɔŋ, bɔ̂ŋ yá Samu ndə ɔ lɔ̀ hə Silɛŋ sêfia ɔ lɔ̀ hə mu lɔʼɔ kə́ gɛ̀ kəyəŋkwɛʼtəŋ, kwɛ̀ŋhə ɔŋ ɔ bɛ̀ʼ mbʉ kətyʉntɔɔnə, kə́ gɛ̀ hə bɔ̌ŋ Jiso.<verse eid="LUK 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 23:27" />Bʉə buŋmbi kə́ gɛ̀ hə bɔ̌ŋ liɛŋ-ɔŋ. Bəke ndə bɔ̂ŋ kə́ tòʼ gwía ɔ shʉ́əshʉ́ə kə́ bɛ muŋgɔ. <verse eid="LUK 23:27" /><verse number="28" style="v" sid="LUK 23:28" />Jiso kíahə ŋwɔŋ-ɛŋ gìe tʉ bɔŋ mbɔ, <char style="wj">“Bəke Jɛlosalɛŋ, kə bii mə kə́ gwía mɔ fɛ, b̈ii gwía ŋwɔŋ-yii bɔŋleʼ gwía vâa-bii,</char> <verse eid="LUK 23:28" /><verse number="29" style="v" sid="LUK 23:29" /><char style="wj">bʉʼka mbɔ ŋgwɔʼmbi tʉʼ gwè ndə bə bu ghɔ̀ŋ mbɔ, ‘Tʉʉjyu nɔ bɛ yi-bədəŋ-yə, tɔbə təmə nyu chɔ fɛ leʼnə ŋwɔ̂ŋ təmə bə nɔʼ nə nyúu fɛ.’</char> <verse eid="LUK 23:29" /><verse number="30" style="v" sid="LUK 23:30" /><char style="wj">Ndʉʉmɛ, bɔ̂ŋ bu ghɔ̀ŋ mbɔ, ‘Kwɔŋhə, gwù ndəŋ baʼa!’ bɔŋleʼ ghɔ̀ŋ mbɔ, ‘Ŋkoʼhə, kwóhə baʼa!’</char> <verse eid="LUK 23:30" /><verse number="31" style="v" sid="LUK 23:31" /><char style="wj">Mɔ nɔ tʉʼ gìe yɔ̄ŋ-yə bʉʼka mbɔ kaʼ bʉə-fɔʼɔ mənɔ tʉ wo ndə ɔ bɛ ndyʉndyʉ tʉ Nyii, kə́ bɛ tyʉ-nchʉnchʉ-kə, Nyii bu fɔ̀ʼ yi-yə ndə i shʉ́ə, tʉ bʉə ndə bɔ̂ŋ tʉʼ chìi bʉ̂ʼʉ, kə́ bɛ tyʉ-yəŋ-kə, təmə bɛ́ŋ ndə məshìe liɛŋtə-ʉə chɔ fɛ ntyʉʉ təka?”</char><verse eid="LUK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32" />Bə lʉ̀ bʉə-bʉ̂ʼʉbɛʼbə bəbûu kə́ gɛ̀ yí ghɔŋ bɔŋ mɔʼɔ. <verse eid="LUK 23:32" /><verse number="33" style="v" sid="LUK 23:33" />Bɔ̂ŋ kʉ̂ʉ gɛ̀ dàa kəyəŋbɛʼ bə kə́ tíi nə, “Ghʉəʼ-kəTʉ-Wo-kə”, bɔ̂ŋ kwɛ̀ŋ ɔŋ chɔ ghɔŋbə bʉə-bʉ̂ʼʉ-ghɔ̄bə mɔʼɔ, mbyu wo-imɔʼ kwiimɔʼnə ibɛʼ-yə kwiiŋkwie-ɔ.<verse eid="LUK 23:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 23:34" />Jiso ghɔ̀ŋ mbɔ, <char style="wj">“Tie-ɔ, kə ä sʉ̀fyii-a ndəŋ bɔŋ le, bʉʼka mbɔ bɔ̂ŋ kínə nukə ndə bɔŋ tʉʼ chìi fɛ.”</char> Bɔ̂ŋ mɔ̀ʼ njoʼ ndə məgyʉ̀ə ndyihə-i.<verse eid="LUK 23:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 23:35" />Bʉə tə́nə kə́ lɛ́nə ɔŋ, bʉəkwɛʼtəŋ chɛ̀ŋ ɔŋ bìʼ chɔ. Bɔ̂ŋ ghɔ̀ŋ mbɔ, “Ɔ tʉʼ kwáa bəbɛʼbʉə, ɔ̈ kwáa ŋwɔŋ-ɛŋ kaʼ bɛ mbɔ ɔ bɛ mbʉ Wo ndə Nyii Kùŋ Tə́ŋ mbʉ Wo ndə Nyii séʼ.” <verse eid="LUK 23:35" /><verse number="36" style="v" sid="LUK 23:36" />Bəsɔge gwè kɔ́ ndʉʼ-chyʉ́ʉtə-mə tʉ ɔŋ ndə məchɛ̀ŋ ɔŋ. <verse eid="LUK 23:36" /><verse number="37" style="v" sid="LUK 23:37" />Leʼ ghɔ̀ŋ mbɔ, “Kaʼ bɛ mbɔ a bɛ Fɔŋ-bʉə-Juu, ä kwáa ŋwɔŋ-aŋ.” <verse eid="LUK 23:37" /><verse number="38" style="v" sid="LUK 23:38" />Bə nɔ kə nyɔ̀ʼ via-ŋwɔʼnə-kə bíahə kətʉ-ɔ mbɔ, “Nɔ bɛ Fɔŋ-bʉə-Juu nɔ.”<verse eid="LUK 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39" />Ibɛʼyə mbyu wo-bʉ̂ʼʉ ndə bə kwɛ̀ŋ ghɔŋ ɔŋ mɔʼɔ kɔ́ nchɛŋhə ndəŋ ɔŋ ghɔ̀ŋ mbɔ, “A kaa Wo ndə Nyii Kùŋ Tə́ŋ fe? Kwáa ŋwɔŋ-aŋ, kwáa baʼa!”<verse eid="LUK 23:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40" />Ibɛʼ-yə mbyu wo-bʉ̂ʼʉ sɔ́ʼ ɔ mbɔ, “A tʉʼ fàa Nyii mbɔ, bii ɔ tʉʼ kwú ntɛ kwú imɔʼ fe? <verse eid="LUK 23:40" /><verse number="41" style="v" sid="LUK 23:41" />Bâʼa nɔ tʉʼ nyíɛ ŋgʉəʼ mɔ̀ʼ luu i, bâʼa nɔ tʉʼ nyíɛ haʼ ndə bâʼa yi. Bɔŋ wo-ɔ̄, ɔ chìi nu-bʉəbɛʼ-kə fɛ.” <verse eid="LUK 23:41" /><verse number="42" style="v" sid="LUK 23:42" />Ɔ leʼ kíahə ghɔ̀ŋ mbɔ, “Jiso, yi kə́ kwɛ́nə mɔ vɛʼ ndə a bu sɔ́ʼ Fɔŋ.”<verse eid="LUK 23:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43" />Jiso bə̀ŋhə mbɔ, <char style="wj">“M̈ɔ shyíi a nə shʉəŋ, laa bâʼa bu bɛ mɔʼɔ ntoʼ-Nyii.”</char><verse eid="LUK 23:43" /></para>
  <para style="s">Kwu-Jiso</para>
  <para style="r">(<ref loc="MAT 27:45-56">Matia 27:45-56</ref>; <ref loc="MRK 15:33-41">Mak 15:33-41</ref>; <ref loc="JHN 19:28-30">Jɔŋ 19:28-30</ref>)</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44" />Kʉ̂ʉ bɛ ndʉʉbeʼ, njəŋkə gwù mu lɔʼɔ-ghɔ̄ inchəŋ tə gɛ̀ dàa ndə bəchî itia ndʉʉnəchî, <verse eid="LUK 23:44" /><verse number="45" style="v" sid="LUK 23:45" />bʉʼka chichi tə́nə ndə məbáa. Ndyi ndə bə kə chyúu kyʉ̀hə mu njaafɛ̀ʼndɛŋNyii nə yɔŋ jɔ̀ʼnə fyú viabə ibûu. <verse eid="LUK 23:45" /><verse number="46" style="v" sid="LUK 23:46" />Jiso tíi nə gyʉʉ dədə mbɔ, <char style="wj">“Tie-ɔ, mɔ nɔ kɔ́ lyʉʉhəkə-ɔŋ mu kəghɔ-a!”</char> Ɔ kʉ̂ʉ gìe yɔ̄ŋ-yə, yìhə ndyiʼtə-bəyihə-kə-i.<verse eid="LUK 23:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47" />Wokwɛʼtəŋ-bəsɔge-ghyʉʉ, kʉ̂ʉ kə́ nyíɛ nubə ndə i tʉʼ fyú, ɔ lə̀ʼtə Nyii ghɔ̀ŋ mbɔ, “Shʉəŋ, wo-ɔ̄ nɔ nə bɛ ndyʉndyʉ!” <verse eid="LUK 23:47" /><verse number="48" style="v" sid="LUK 23:48" />Bʉə bənchəŋ ndə bɔ̂ŋ kə kə́nə, kə́ nyíɛ nubə ndə i tʉʼ tíŋ, gɛ̀ nə wʉə nə tʉʉbʉə. <verse eid="LUK 23:48" /><verse number="49" style="v" sid="LUK 23:49" />Ndə nubə-ɔ̄ŋ tʉʼ tíŋ, bʉə bənchəŋ ndə bɔ̂ŋ kʉ̀ʉ ɔ ghɔŋbə bəke ndə bɔ̂ŋ kə́ gɛ̀ hə bɔ̌ŋ ɔŋ lɔ̀ hə lɔʼɔ Galili tə́nə dɔdɔ kə́ yíɛʼhə lɛ́nə ɔŋ.<verse eid="LUK 23:49" /></para>
  <para style="s">Mətyúu-Jiso</para>
  <para style="r">(<ref loc="MAT 27:57-61">Matia 27:57-61</ref>; <ref loc="MRK 15:42-47">Mak 15:42-47</ref>; <ref loc="JHN 19:38-42">Jɔŋ 19:38-42</ref>)</para>
  <para style="p">
    <verse number="50-51" style="v" sid="LUK 23:50-51" />Wobɛʼ nɔ nə bɛ ghɔ, yie kə́ bɛ Jɔsɛ, ɔ lɔ̀ hə Alamatia mu Judia, kə́ bɛ wo jyujyu bɔŋ-kə́-leʼ bɛ ndyʉndyʉ, ɔ kə́ kʉ̀ʼ ndə mənyíɛ Sɔ́ʼ-Nyii, ɔ nɔ nə bɛ ŋguu-kaŋsotə-bʉə-Juu, təmə bɛ́ŋ nukə ndə bɔ̂ŋ kwɔ̀ʼtə kə́ chìi fɛ. <verse eid="LUK 23:50-51" /><verse number="52" style="v" sid="LUK 23:52" />Ɔ gɛ̀ tʉ Bale, bíʼtə ŋkwu-Jiso-kə. <verse eid="LUK 23:52" /><verse number="53" style="v" sid="LUK 23:53" />Ndʉʉmɛ, ɔ shúʼhə mbʉ kəŋkwu-i sê, lʉ́əŋtə mu ndyi kəfyuʼ, mɔ̀ʼ mu sě ndə bə sáa ndəŋ ŋgoʼ, kə́ bɛ yi-yə təmə bə nɔʼ nə tyúu wo chɔ fɛ. <verse eid="LUK 23:53" /><verse number="54" style="v" sid="LUK 23:54" />Nɔ kə bɛ Chî-búu-ŋwɔŋ-kə, Chîlɔʼkə kə bɛ ndə məchʉ́ʉhə.<verse eid="LUK 23:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55" />Bəke ndə bɔ̂ŋ gwè hə bɔ̌ŋ Jiso lɔ̀ hə Galili, bɔ̂ŋ gɛ̀ hə bɔ̌ŋ Jɔsɛ gɛ̀ nyíɛ mbʉ sě, bɔ̂ŋ nyíɛ ndə ɔ mɔ̀ʼ ŋkwukə-i muŋgɔ. <verse eid="LUK 23:55" /><verse number="56" style="v" sid="LUK 23:56" />Ndʉʉmɛ, bɔ̂ŋ bʉ̀nə gɛ̀ chunjaa gɛ̀ kʉ́ʉ fɔ-lùŋ-bə leʼnə ŋgwo-lùŋ-mə ndə məgwè yóʼ ŋkwukə-i chɔ. Bɔ̂ŋ yíɛʼhə Chîlɔʼkə, ndə mətʉ́ʼ nuʼ-Mushi.<verse eid="LUK 23:56" /></para>
  <chapter eid="LUK 23" />
  <chapter number="24" style="c" sid="LUK 24" />
  <para style="s">Məkoʼ-Jiso</para>
  <para style="r">(<ref loc="MAT 28:1-10">Matia 28:1-10</ref>; <ref loc="MRK 16:1-8">Mak 16:1-8</ref>; <ref loc="JHN 20:1-10">Jɔŋ 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1" />Kʉ̂ʉ bɛ ndəŋ fəŋ kəchî mu vyii mbi, mbʉ bəke lɔ̀ ndʉʉsɛŋkə bətyuʼbətyuʼ, lʉ̀ ŋgwo-lùŋ-mə ndə bɔ̂ŋ nɔʼ kə shʉ̀tə, gɛ̀ nə yɔ̄ŋ-yə chu-mbʉ-sě. <verse eid="LUK 24:1" /><verse number="2" style="v" sid="LUK 24:2" />Bɔ̂ŋ gɛ̀ nyíɛ tʉ bə nɔʼ tʉ́ʉhə mbʉ ŋgoʼ ndə bə kə chíe chu-mbʉ-sě nə yɔŋ. <verse eid="LUK 24:2" /><verse number="3" style="v" sid="LUK 24:3" />Bɔ̂ŋ kʉ̂ʉ shíʼ muŋgɔ təmə nyíɛ ŋkwu-Jiso-Tiekətʉ-kə fɛ. <verse eid="LUK 24:3" /><verse number="4" style="v" sid="LUK 24:4" />Ndə bɔ̂ŋ tʉʼ yie yɔ̄ŋ-yə, kə kwɔnə nyíɛ, bʉə bəbûu fyú tʉ bɔŋ, mɔ̀ʼ ndyi-leʼnə-hə tə́nə mbʉə bɔŋ. <verse eid="LUK 24:4" /><verse number="5" style="v" sid="LUK 24:5" />I fɛ̀ŋhə mbʉ bəke, bɔ̂ŋ bʉ́ʉnə bəshʉ bɔŋ kə́ lɛ́nə sê, mbʉ bʉə-ghɔ̄bə ghɔ̀ŋ tʉ bɔŋ mbɔ, “Bii tʉʼ kʉ́ʉ wo ŋɛnə mu bəŋkwusê təka? <verse eid="LUK 24:5" /><verse number="6" style="v" sid="LUK 24:6" />Ɔ kaa fɛ̄ŋ fɛ, ɔ nɔʼ kóʼ! B̈ii kwɛ́nə ndə ɔ kə shyíi bii vɛʼ ndə bii bɔŋ kə bɛ mɔʼɔ Galili le, <verse eid="LUK 24:6" /><verse number="7" style="v" sid="LUK 24:7" />‘Bə bu yaʼ kɔ́ Vaa-Woməsʉʉ mu kəghɔ-bʉə bʉ̂ʼʉ, bɔ̂ŋ kwɛ̀ŋ ɔŋ yí, kʉ̂ʉ bɛ chîbə itia nɔ ɔ bʉ̀nə bìʼ kóʼ.’ ”<verse eid="LUK 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 24:8" />Ndʉʉmɛ, bɔ̂ŋ kwɛ́nə ŋgie-bi. <verse eid="LUK 24:8" /><verse number="9" style="v" sid="LUK 24:9" />Bɔ̂ŋ kʉ̂ʉ bʉ̀nə kəyəŋ sě-ɔ, núhə nubə-ɔ̄ŋ inchəŋ tʉ bəʼ-bʉə-njuɔ-mɔʼ-kə nə wuŋ ghɔŋbə bəbɛʼbʉə nchəŋtə. <verse eid="LUK 24:9" /><verse number="10" style="v" sid="LUK 24:10" />Nɔ kə bɛ Mɛli Matalina, Juana, Mɛli ŋkwê-Jɛŋ leʼnə bəbɛʼbəke ndə ghɔŋ bɔŋ kə́ núhə nubə-ɔ̄ŋ tʉ bəlɔntəŋNyii. <verse eid="LUK 24:10" /><verse number="11" style="v" sid="LUK 24:11" />Təmə bɔ̂ŋ mə bɛ́ŋ nukə ndə bəke-ghɔ̄bə tʉʼ gìe fɛ, bʉʼka kwəʼ-yʉə nɔ nə bɛ kwə́ʼ bənɔ̌ʼɔ tʉ bɔŋ. <verse eid="LUK 24:11" /><verse number="12" style="v" sid="LUK 24:12" />Bita lɔ̀ hə sê, nyʉ́ʉ gɛ̀ ndəŋ mbʉ sě, gɛ̀ bʉ́ʉnə lɛ́nə mu-i, nyíɛ mbʉ ndyihə ndə bə kə tyúu ɔ nə yɔŋ kə́ nʉ̀ʉ tətɛʼ ɛ. Ɔ lɔ̀ gɛ̀ kə́ tòʼ kwɔ̀ʼtə tʉkə-i ndəŋ nukə ndə i nɔʼ tíŋ.<verse eid="LUK 24:12" /></para>
  <para style="s">Fia Emau</para>
  <para style="r">(<ref loc="MRK 16:12-13">Mak 16:12-13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13" />Haʼ yɔ̂ŋ-ghɔ̄, vâafɔʼɔ-bi bəbûu lɔ̀ kə́ gɛ̀ lɔʼbɛʼ bə kə́ tíi nə Emau ndə i bɛ nə ŋkɔŋ-bəghǔu-hə itaa nə bəghǔu təghyʉʉ tətaa ndə məlɔ̀ hə chɔ gɛ̀ dàa Jɛlosalɛŋ. <verse eid="LUK 24:13" /><verse number="14" style="v" sid="LUK 24:14" />Bɔ̂ŋ kə́ tòʼ kwə́ʼ tʉ ŋwɔŋtə-ʉə te nubə ndə i nɔʼ tíŋ. <verse eid="LUK 24:14" /><verse number="15" style="v" sid="LUK 24:15" />Ndə bɔ̂ŋ tʉʼ tòʼ kwə́ʼ bɔŋleʼ jìʼtə nubə-ɔ̄ŋ mu bɔŋ, Jiso nə mbəŋ-ɛŋ gwè bìa bɔŋ ghɔŋ bɔ̂ŋ kə́ tòʼ. <verse eid="LUK 24:15" /><verse number="16" style="v" sid="LUK 24:16" />Bɔŋ tʉ bə nɔʼ chíe shʉtə-ʉə ndə məchèʼnə ɔŋ. <verse eid="LUK 24:16" /><verse number="17" style="v" sid="LUK 24:17" />Ɔ bíʼtə tʉ bɔŋ mbɔ, <char style="wj">“Bii tʉʼ tòʼ kwə́ʼ ka gɛ̀ tə dɔ̀ŋnə muŋgɔ nɔ?”</char></para>
  <para style="p" vid="LUK 24:17">Bɔ̂ŋ tə́nə kəyəŋ kəmɔʼ, nə mbʉəhə-ʉə idìenə. <verse eid="LUK 24:17" /><verse number="18" style="v" sid="LUK 24:18" />Mbyu wo mu bɔŋ yie-e kə́ bɛ Kolioba, bíʼtə tʉ ɔŋ mbɔ, “A bɛ haʼ mbyu ntoʼŋgwe imɔʼ mu Jɛlosalɛŋ fɛ̄ŋ, təmə kínə nubə ndə i nɔʼ tíŋ ndəŋ chîbə-ɔ̄ŋ fɛ mɛ?”<verse eid="LUK 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19" />Ɔ bíʼtə mbɔ, “Ŋgwɔ ka?”</para>
  <para style="p" vid="LUK 24:19">Bɔ̂ŋ bə̀ŋhə mbɔ, “Te Jiso ndə ɔ lɔ̀ hə Nasalɛ. Ɔ nɔ kə bɛ yʉkəŋgieNyii, shʉ́ə ndə kwəʼ-ɛ ghɔŋbə njʉnə-i bəshʉ-Nyii leʼnə bʉə bənchəŋ. <verse eid="LUK 24:19" /><verse number="20" style="v" sid="LUK 24:20" />Bətiefɛ̀ʼndɛŋNyii ghɔŋbə bəntəŋbəshʉ-baʼa chɔ̀ʼhə ɔŋ kɔ́ mbɔ b̈ə yí ɔ, bɔ̂ŋ kwɛ̀ŋ ɔŋ yí. <verse eid="LUK 24:20" /><verse number="21" style="v" sid="LUK 24:21" />Bɔŋ tʉ baʼa nɔʼ nə kə́ yʉ́əʼnə ndəŋ ɔŋ mbɔ ɔ nɔ bu chʉ̀ʼ tʉ-bʉə-Isilɛ-bə. Ndə məbìʼ chɔ, nɔ chîbə nduɔ itia ndə nubə-ɔ̄ŋ tíŋ. <verse eid="LUK 24:21" /><verse number="22" style="v" sid="LUK 24:22" />Bɔŋ bəbɛʼbə bəke-baʼa bɔŋleʼ gìe fɔŋ ɛŋ tʉ baʼa laa. Bɔ̂ŋ nɔ gɛ̀ ndəŋ mbʉ sě ndʉʉfiimbi laa, <verse eid="LUK 24:22" /><verse number="23" style="v" sid="LUK 24:23" />bɔŋ təmə nyíɛ ŋkwukə-i fɛ. Bɔ̂ŋ gwè gìe tʉ baʼa mbɔ bɔ̂ŋ la nyíɛ bʉəntəŋNyii, bɔ̂ŋ ghɔ̀ŋ mbɔ ɔ la bɛ ŋɛnə. <verse eid="LUK 24:23" /><verse number="24" style="v" sid="LUK 24:24" />Bəbɛʼbʉə nuɔ-baʼa lɔ̀ gɛ̀ ndəŋ mbʉ sě, gɛ̀ nyíɛ kɛŋ haʼ ndə mbʉ bəke-ghɔ̄bə kə gìe le, bɔŋ təmə nyíɛ ɔŋ fɛ.”<verse eid="LUK 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25" />Jiso ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Bii nɔ bɛ bənɔ̌ʼɔ, fyiihə-ii shʉ́ə ndə məbɛ́ŋ nukə nə bʉəyʉkəŋgieNyii nɔʼ kə gìe.</char> <verse eid="LUK 24:25" /><verse number="26" style="v" sid="LUK 24:26" /><char style="wj">Wo ndə Nyii Kùŋ Tə́ŋ kie ndə mənyíɛ ŋgʉəʼ ndəŋ nubə-ɔ̄ŋ, buŋ ŋíi mu məgʉə-e fe?”</char> <verse eid="LUK 24:26" /><verse number="27" style="v" sid="LUK 24:27" />Ɔ chʉ́ʉhə ndəŋ Mushi gɛ̀ tə dàa ndəŋ bʉəyʉkəŋgieNyii bənchəŋ, fʉ̀ʼtə nubə ndə ŋwɔʼnə-Nyii nɔʼ kə́ gìe te mbəŋ-ɛŋ.<verse eid="LUK 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28" />Bɔ̂ŋ kʉ̂ʉ gɛ̀ tə kə́ kə́ŋhə mbʉə lɔʼɔ ndə bɔ̂ŋ kə́ gɛ̀ chɔ, Jiso chìi fí ndə ɔ bu bìʼ gɛ̀ nə shʉbə. <verse eid="LUK 24:28" /><verse number="29" style="v" sid="LUK 24:29" />Bɔ̂ŋ fʉ̀ʉtə tʉ ɔŋ shʉ́əshʉ́ə mbɔ, “B̈ʉʼʉ chí fɛ̄ŋ, ndʉʉbuumbi nɔʼ kə́ŋhə mbi nɔʼ tʉʼ jʉ́.” Ɔ gɛ̀ chí ghɔŋ bɔŋ. <verse eid="LUK 24:29" /><verse number="30" style="v" sid="LUK 24:30" />Ɔ kʉ̂ʉ dùʼ ghɔŋ bɔŋ ndəŋ tebele lʉ̀ bele kɔ́ ndɔ chɔ, bə́ʼtə gyʉ̀ə tʉ bɔŋ. <verse eid="LUK 24:30" /><verse number="31" style="v" sid="LUK 24:31" />Ndʉʉmɛ, shʉ-yʉə ŋɔ́ʼnə, bɔ̂ŋ chèʼnə ɔŋ, ɔ tuŋ bɛ́ shʉ-bɔŋ.<verse eid="LUK 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 24:32" />Bɔ̂ŋ bíʼtə tʉ ŋwɔŋtə-ʉə mbɔ, “Kaa nukə nɔ ndə i kə chìi tʉʉtə-ʉʼʉ kə́ bʉ̀ʉ vɛʼ ndə bʉʼʉ bɔŋ kə́ gwè hə sêfia, ɔ ŋɔ́ʼhə shʉ-yʉʼʉ ndəŋ nukə ndə i bɛ mu ŋwɔʼnə-Nyii fe?” <verse eid="LUK 24:32" /><verse number="33" style="v" sid="LUK 24:33" />Bɔ̂ŋ lɔ̀ hə sê haʼ ndʉʉmɛ bʉ̀nə gɛ̀ Jɛlosalɛŋ, kəyəŋ ndə bɔ̂ŋ kə nyíɛ mbʉ vâafɔʼɔ-bi chɔ njuɔ mɔʼ nə wuŋ, ghɔŋbə bʉə ndə bɔ̂ŋ kə bɛ chɔ kə́ chə̀ŋtə kəyəŋ kəmɔʼ. <verse eid="LUK 24:33" /><verse number="34" style="v" sid="LUK 24:34" />Bɔ̂ŋ ghɔ̀ŋ tʉ mbʉ b̈ʉə bəbûu mbɔ, “Nɔ shʉəŋ! Mbʉ Tiekətʉ nɔʼ kóʼ dʉ̀ʼ ŋwɔŋ-ɛŋ tʉ Samu.”<verse eid="LUK 24:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 24:35" />Ndʉʉmɛ, mbʉ b̈ʉə bəbûu fʉ̀ʼtə nukə ndə i fyú sêfia, ghɔŋbə ntɛ ndə bɔ̂ŋ chèʼnə mbʉ Jiso, ndʉʉ ndə ɔ kə bə́ʼtə bele.<verse eid="LUK 24:35" /></para>
  <para style="s">Jiso fyú tʉ vâafɔʼɔ-bi</para>
  <para style="r">(<ref loc="MAT 28:16-20">Matia 28:16-20</ref>; <ref loc="MRK 16:14-18">Mak 16:14-18</ref>; <ref loc="JHN 20:19-23">Jɔŋ 20:19-23</ref>; <ref loc="ACT 1:6-8">Fɔʼɔ 1:6-8</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36" />Ndʉʉ ndə bɔ̂ŋ kə́ bíe kwə́ʼ, kə kwɔnə nyíɛ, Jiso kə́ tə́nə mu bɔŋ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“B̈ii kie fyiighʉ́ənə.”</char> <verse eid="LUK 24:36" /><verse number="37" style="v" sid="LUK 24:37" />I fɛ̀ŋhə bɔŋ, bɔ̂ŋ gwùʼtə kə́ kwɔ̀ʼtə mbɔ bɔ̂ŋ la nɔʼ nyíɛ ŋkwusêkə. <verse eid="LUK 24:37" /><verse number="38" style="v" sid="LUK 24:38" />Ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Bii tʉʼ fàa ka, chìi ka təmə bii mə bɛ́ŋ mbɔ mɔ nɔʼ kóʼ fɛ?</char> <verse eid="LUK 24:38" /><verse number="39" style="v" sid="LUK 24:39" /><char style="wj">B̈ii lɛ́nə ghɔkə-ɔŋ ghɔŋ wukə-ɔŋ. Nɔ bɛ mbəŋ-ɔŋ! B̈ii kə̀ŋ mɔ nyíɛ, ŋkwusêkə kie mbɔʼ ghɔŋ ghʉəʼ-mbʉə-kə ndə mɔ kie nɔ fɛ.”</char> <verse eid="LUK 24:39" /><verse number="40" style="v" sid="LUK 24:40" />Ndʉʉ ndə ɔ kə gìe yɔ̄ŋ-yə, ɔ dʉ̀ʼ ghɔbə-i tʉ bɔŋ ghɔŋbə wubə-i.<verse eid="LUK 24:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 24:41" />Vɛʼ ndə i bíe chàa bɔŋ, tʉʉ-yʉə bɔŋ kə́ bʉ̀ʉ, ɔ bíʼtə tʉ bɔŋ mbɔ, <char style="wj">“Bii kie fɔkə fɛ̄ŋ ndə məyú mɛ?”</char> <verse eid="LUK 24:41" /><verse number="42" style="v" sid="LUK 24:42" />Bɔ̂ŋ kɔ́ ŋkwutə-mbɔʼ-tɔ̀ŋnə-kə tʉ ɔŋ. <verse eid="LUK 24:42" /><verse number="43" style="v" sid="LUK 24:43" />Ɔ fí kwó bəshʉ bɔŋ, <verse eid="LUK 24:43" /><verse number="44" style="v" sid="LUK 24:44" />ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Nɔ nukə nɔ ndə mɔ kə shyíi bii, nubə inchəŋ ndə bə nyɔ̀ʼ te mɔ mu ŋwɔʼnə-nuʼ-Mushi ghɔŋbə bʉəyʉkəŋgieNyii leʼnə Ŋwɔʼnə-təLyuu bu yaʼ fyú shʉəŋ.”</char> <verse eid="LUK 24:44" /><verse number="45" style="v" sid="LUK 24:45" />Ndʉʉmɛ, ɔ ŋɔ́ʼhə ndaahə-ʉə ndə məkínə ŋgieNyiikə. <verse eid="LUK 24:45" /><verse number="46" style="v" sid="LUK 24:46" />Ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Nɔ nukə nɔ ndə bə kə nyɔ̀ʼ mbɔ mbʉ Wo ndə Nyii Kùŋ Tə́ŋ bu nyíɛ ŋgʉəʼ kwú, kʉ̂ʉ bɛ chîbə itia nɔ, ɔ bʉ̀nə kóʼ.</char> <verse eid="LUK 24:46" /><verse number="47" style="v" sid="LUK 24:47" /><char style="wj">Bə bu lɔ̀ʼ yie-maa-ɔ̄ŋ mu lɔʼ-bətə̂ŋ-tə inchəŋ chʉ́ʉhə Jɛlosalɛŋ mbɔ b̈ʉə shìe liɛŋtə-ʉə ndəŋ bʉ̂ʼtə-ʉə, Nyii chʉʼ sʉ̀fyii-i hə ndəŋ bɔŋ.</char> <verse eid="LUK 24:47" /><verse number="48" style="v" sid="LUK 24:48" /><char style="wj">Nɔ bu nú bii nú gwù kənu-ɔ̄ŋ.</char><verse eid="LUK 24:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 24:49" />
    <char style="wj">“Mɔ bu tə́ŋ LyʉʉhəNyiikə ndə Tie-ɔ nɔʼ kə kɔ̀ʼnə tʉ bii. B̈ii bɔŋ káa Jɛlosalɛŋ tə b̈ə yi kɔ́ ghʉəʼkə tʉ bii ndə i gwè hə yuo.”</char><verse eid="LUK 24:49" /></para>
  <para style="s">Jiso kóʼ gɛ̀ yuo</para>
  <para style="r">(<ref loc="MRK 16:19-20">Mak 16:19-20</ref>; <ref loc="ACT 1:9-11">Fɔʼɔ 1:9-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50" />Ɔ kʉ̂ʉ lʉ̀ bɔŋ fyú gɛ̀ nə bɔŋ Bɛtani, chɔ̀ʼhə ghɔkə-i ghɔʼ túu bʉ̀ʉ kɔ́ tʉ bɔŋ. <verse eid="LUK 24:50" /><verse number="51" style="v" sid="LUK 24:51" />Ndʉʉ ndə ɔ tʉʼ túu bʉ̀ʉ ndə məkɔ́ tʉ bɔŋ, ɔ mɛ̀ʼtə bɔŋ, bə lʉ̀ ɔ gɛ̀ nə nɔŋ yuo. <verse eid="LUK 24:51" /><verse number="52" style="v" sid="LUK 24:52" />Ndʉʉmɛ bɔ̂ŋ lə̀ʼtə ɔŋ bʉ̀nə gɛ̀ Jɛlosalɛŋ nə tʉʉjyu yɔ́ŋyɔ́ŋ. <verse eid="LUK 24:52" /><verse number="53" style="v" sid="LUK 24:53" />Bɔ̂ŋ gɛ̀ káa mu njaafɛ̀ʼndɛŋNyii kə́ lə̀ʼtə Nyii gɛ̀gɛ̀.<verse eid="LUK 24:53" /></para>
  <chapter eid="LUK 24" />
</usx>