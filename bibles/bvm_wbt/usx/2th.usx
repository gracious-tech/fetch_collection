<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TH" style="id">- Bamunka New Testament</book>
  <para style="h">2 Tɛsalonika</para>
  <para style="toc1">Biitə-ŋwɔʼnə-kə ndə Bɔɔ kə nyɔ̀ʼ kɔ́ tə Chɔshi ndə i bɛ Tɛsalonika</para>
  <para style="toc2">2 Tɛsalonika</para>
  <para style="toc3">2Tɛ</para>
  <para style="mt2">Biitə-ŋwɔʼnə-kə ndə Bɔɔ kə nyɔ̀ʼ kɔ́ tʉ</para>
  <para style="mt2">Chɔshi ndə i bɛ</para>
  <para style="mt1">Tɛsalonika</para>
  <para style="imt">Nchoʼtə bətʉ bənu</para>
  <para style="ip">Fɔŋ-kənu ndə i kə́ kɔ́ ŋgʉəʼ mu chɔshi-fɛ̄ŋ nɔ bɛ tʉŋkwɔŋ te ndʉʉ ndə Jiso bu yi bìʼ bʉ̀nə gwè chɔ. Bəbɛʼbʉə nɔ nə kə́ gìe mbɔ ŋgwɔʼmbi məgwè Tiekətʉ la nɔʼ dàa.</para>
  <para style="ip">Bɔɔ shʉ̀tə ŋkwɔʼtə-ɔ̄ŋ kə́ gìe mbɔ mbʉ Tiekətʉ la bu yi kə̂ bʉ̀nə gwè nɔ, tʉ bʉ̂ʼʉ ghɔŋbə mə-kɛŋ-kə́-chìi bʉ̂ʼʉ la nɔʼ dàa fia ndə ndʉʉ ndə mbʉ wo bʉəbʉə ndə ɔ bɛ wobàa Klai tʉʼ sɔ́ʼ mbi. Bɔɔ kwə́ʼ tʉ bʉə ndə bɔ̂ŋ kə kie ndə mətíi ŋwɔʼnə-ɔ̄ŋ mbɔ kə bɔ̂ŋ la mə gwònə ndəŋ ntəŋnəmə-ʉə mu Nyii buŋ ndə nubə tʉʼ chɔ́ŋhə bɔŋ ghɔŋbə ŋgʉəʼ fɛ. Ɔ gìe tʉ bɔŋ mbɔ bɔ̂ŋ la kə́ fɔ̀ʼ shʉ́əshʉ́ə haʼ ndə ntɛhə ndə mbəŋ-ɛŋ Bɔɔ ghɔŋbə bʉə nuɔ-bʉə nə kə́ fɔ̀ʼ bɔŋleʼ lyʉ̀ʉtə́nə ndə məfɔ̀ʼ bʉʉ.</para>
  <para style="iot">Nubə ndə i bɛ mu ŋwɔʼnə-fɛ̄ŋ</para>
  <para style="io1">Nchʉʉhə-bənu 1:1-2</para>
  <para style="io1">Məchʉ̀ʉ Nyii ghɔŋbə məchʉ̀ʉ bʉə 1:3-12</para>
  <para style="io1">Tʉ̂ʼ te məgwè-Klai 2:1-17</para>
  <para style="io1">Məkwèʼhə bʉə ndə mədʉ̀ʼ nuʼ-Klai 3:1-15</para>
  <para style="io1">Liʼ-bənu 3:16-18</para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="s">Nchaʼtə</para>
  <para style="m">
    <verse number="1" style="v" sid="2TH 1:1" />Nɔ nyɔ̀ʼ Bɔɔ, Sabanu<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Nɔ bɛ ibɛʼ-yə yie-wo ndə bə kə́ tíi ɔ nə Sala.</char></note> leʼnə Timɔti nyɔ̀ʼ ŋwɔʼnə-ɔ̄ŋ.</para>
  <para style="p" vid="2TH 1:1">Baʼa nɔ tʉʼ nyɔ̀ʼ tʉ bʉə-chɔshi mu Tɛsalonika ndə bɔ̂ŋ bɛ tʉ Nyii mbʉ Tie-yʉʼʉ leʼnə Jiso Klai Tiekətʉ.<verse eid="2TH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2" />Tə buuŋjyu ghɔŋbə fyiighʉ́ənə Nyii mbʉ Tie-yʉʼʉ ghɔŋbə Jiso Klai Tiekətʉ bɛ tʉ bii.<verse eid="2TH 1:2" /></para>
  <para style="s">Məkwèʼhə bʉə ndʉʉ ndə bə tʉʼ chɔ́ŋhə bɔŋ</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />Bəliŋ-baʼa, baʼa nɔ kie ndə mə-kə́-kɔ́ ndɔ tʉ Nyii yie-bii təvɛʼtəvɛʼ. I nɔ kʉ̀ʼnə ndə məchìi nɔ bʉʼka məmɔʼfyiihə-ii ndəŋ Nyii nɔ tʉʼ kʉ̀ʼ gɛ̀ nə shʉbə leʼnə ŋkʉ̂ʉ ndə bii kie tʉ ŋwɔŋtə-ii bɔŋ-kə́-leʼ kóʼ ghɔ yɔ́ŋyɔ́ŋ. <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />Nɔ bɛ yɔŋ ndə baʼa tʉʼ kwɛ̀ŋ fyiihə-aʼ bʉʼka bii mu-bəchɔshi-Nyii-hə. Baʼa nɔ tʉʼ kwɛ̀ŋ fyiihə-aʼ bʉʼka məlyʉ̀ʉtə́nə ndə bii lyʉ̀ʉtə́nə bɔŋleʼ mɔ̀ʼfyiihə-ii ndəŋ Nyii mu məchɔ́ŋhə ndə bə tʉʼ chɔ́ŋhə bii leʼnə ŋgʉəʼ ndə bii tʉʼ tíŋ hə muŋgɔ.<verse eid="2TH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5" />Nchəŋnchəŋ bənu-ɔ̄ŋ nɔ tʉʼ dʉ̀ʼ mbɔ Nyii nɔ tʉʼ kwɛ̀ sɔ́ʼ-ɛ ndyʉndyʉ, mbɔ Nyii chʉʼ yi nyíɛ bii, bii kʉ̀ʼnə ndə məŋíi mu sɔ́ʼ-ɛ ndə bii tʉʼ nyíɛ ŋgʉəʼ bʉʼka yɔŋ. <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />Nyii bu chìi nukə ndə i bɛ kʉ̀ʼnə. Ɔ bu kɔ́ ŋgʉəʼ tʉ bʉə ndə bɔ̂ŋ tʉʼ chìi bii kə́ nyíɛ ŋgʉəʼ. <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />Ɔ bu chìi fʉʉkə tɔ́ liɛŋ-bii ndə bii tʉʼ nyíɛ ŋgʉəʼ leʼnə mbəŋ-yaʼ ghɔ. Ɔ bu chìi yɔ̄ŋ-yə ndʉʉ ndə bə bu kɛ̀ʼ Jiso Tiekətʉ hə yuo ghɔŋbə bʉəntəŋ-bi ndə bɔ̂ŋ shʉ́ə daa, <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />nə viʼi kwíinə, ndə mətyú ŋgʉəʼ tʉ bʉə ndə bɔ̂ŋ tɛ́ŋ Nyii təmə kə́ fɔ̀ʼ nukə ndə ntəŋjyujyu te Jiso Tiekətʉ-yʉʼʉ ghɔ̀ŋ fɛ. <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" />Bɔ̂ŋ bu nyíɛ ŋgʉəʼ təmə liʼ-i ghɔ fɛ, bə wɔ̀ʼtə bɔŋ mbʉə Tiekətʉ gɛ̀gɛ̀ ghɔŋbə məgʉ́ə kəghʉəʼ-ɛ. <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />Ndʉʉ ndə ɔ bu nə gwè, yɔ̂ŋ-ghɔ̄, ɔ bu fí məgʉ́ə mu bʉə-bi bənchəŋ i bɔŋ-bu-leʼ chíe chu bʉə-bi bənchəŋ ndə bɔ̂ŋ bɛ́ŋ ɔŋ. Bii bu yi bɛ nuɔ bɔŋ ghɔ bʉʼka bii nɔ kə bɛ́ŋ nubə ndə baʼa kə gìe tʉ bii te ɔ.<verse eid="2TH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11" />Nɔ bɛ luu-i le ndə baʼa tʉʼ gháaNyii tʉ bii təvɛʼtəvɛʼ. Baʼa kə́ gháaNyii mbɔ ɔ chìi bii kʉ̀ʼnə ndə ntɛ məchímbi ndə ɔ nɔʼ tíi bii chɔ. Tə ɔ kɔ́ ghʉəʼkə tʉ bii ndə məfɔ̀ʼ nu-jyujyu-bə inchəŋ ndə məmɔʼfyiihə-ii ndəŋ ɔŋ kʉ̀ʉ mbɔ bii fɔ̀ʼ. <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />Yɔ̄ŋ-yə nɔ bɛ mbɔ yie-Jiso Tiekətʉ-yʉʼʉ chʉʼ kie məgʉ́ə mu məchimbi-bii, ɔ bɔŋleʼ kɔ́ kuŋhə tʉ bii, tíŋ hə bɔ̌ŋ buuŋjyu Nyii-yʉʼʉ leʼnə mbʉ Jiso Klai Tiekətʉ.<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="s">Nubə ndə i bu fyú Tiekətʉ buŋ bʉ̀nə gwè</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />Nduɔ, te məbʉ̀nə gwè Tiekətʉ-yʉʼʉ Jiso Klai ghɔŋbə məchəŋtə-yʉʼʉ kəyəŋ kəmɔʼ ndə məbɛ bʉʼʉ bɔŋ, baʼa nɔ tʉʼ fʉ̀ʉtə bii, bəliŋ-baʼa, mbɔ <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />kə bii mə kə chʉʼ yùhə ndə məkie mbyuutəmbyuutə mu kətʉ-bii byuunɔ kə́ lə̀ŋnə te wo ndə ɔ ghɔ̀ŋ mbɔ chî-Tiekətʉ-kə nɔʼ gwè fɛ. Kə a mə bɛ́ŋ kaʼ bɔ̂ŋ ghɔ̀ŋ mbɔ LyʉʉhəNyiikə nɔʼ dʉ̀ʼ nukə tʉ baʼa fɛ byuunɔ kaʼ bɔ̂ŋ ghɔ̀ŋ mbɔ baʼa nɔ kə téʼ ntəŋ, byuunɔ baʼa nɔ kə nyɔ̀ʼ mu ŋwɔʼnə. <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />Kə bii mə mɛ̀ʼtə wotəmiyɔŋ fə́ʼhə bii ndəŋ fia təmiyɔŋ fɛ. Chî-ghɔ̄-kə kʉʉ gwè təmə ndyiʼtə-kwɛ̀ŋhə-kə nɔʼ fyú sê, bə kɛ̀ʼ mbʉ wo bʉəbʉə ndə ɔ bu tɛ́ŋ nuʼ-Nyii, kə́ bɛ wo ndə ɔ kie ndə məkwú bɛ́. <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />Ɔ bu chʉ̀əʼhə chu bəfɔ inchəŋ ndə bə tʉʼ tíi nə bənyii byuunɔ fɔbə ndə bə tʉʼ lə̀ʼtə bɔŋleʼ kə́ kóʼhə ŋwɔŋ-ɛŋ ghɔʼ gìe kətʉ-bɔŋ bənchəŋ. Ɔ bu buŋ sʉ́ʉ mu njaafɛ̀ʼndɛŋNyii dùʼ chɔ, kə́ tíi ŋwɔŋ-ɛŋ nə Nyii. <verse eid="2TH 2:4" /><verse number="5" style="v" sid="2TH 2:5" />Bii bieleʼ kwɛ́nə mbɔ mɔ nɔʼ kə shyíi bii nə nubə-ɔ̄ŋ inchəŋ vɛʼ ndə bʉʼʉ kə bɛ mɔʼɔ fe? <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />Bii bɔŋ kínə nukə ndə i tʉʼ yá yɔ̄ŋ-yə tʉ́ʼ, təmə i nɔʼ fyú sê nduɔ fɛ, mbɔ b̈ə yi kɛ̀ʼ mbʉ wo bʉəbʉə ndə ndʉʉ-i.<verse eid="2TH 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2TH 2:7" />Bʉʼka nu-bʉəbʉə-bə-ɔ̄ŋ nɔ tʉʼ fɔ̀ʼ nduɔ mu bəliinə, bɔŋ nukə ndə i kie ndə məfyú kʉʉ yi fyú fɛ, tʉ wo ndə ɔ tʉʼ yá nubə-ɔ̄ŋ tʉ́ʼ b̈ə yi fyúhə ɔŋ fia. <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" />Ndʉʉmɛ, bə kɛ̀ʼ mbʉ wo bə́ʼ nuʼ, ndə Jiso Tiekətʉ bu yí ɔ nə ŋgie-chu-kə-i, chìi ɔ bɛ njʉnjʉ nə məleʼnə ndə i bu gwè hə ndə məbáa-ɛ. <verse eid="2TH 2:8" /><verse number="9" style="v" sid="2TH 2:9" />Mbʉ wo bə́ʼ nuʼ bu gwè kə́ fɔ̀ʼ nə Sata nə ghʉəʼkə inchəŋ, kə́ chìi nubəcheʼbə ghɔŋbə nuchíechubə ndə bɛ yi-mbii-yə. <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />Ɔ bu chìi ntɛ-buuŋbʉə-hə inchəŋ ndə məfə́ʼhə bʉə ndə bɔ̂ŋ bɛ ndə məkwú bɛ́. Bɔ̂ŋ bu kwú bɛ́ bʉʼka bɔ̂ŋ nɔ kə tɛ́ŋ ndə məkʉ̀ʉ mbʉ shʉəŋ bɔŋleʼ bɛ́ŋ ï kwáa bɔŋ. <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />Bʉʼka yɔ̄ŋ-yə, Nyii bu chìi mbɔ b̈ə kɛŋ fə́ʼhə bɔŋ, mbɔ bɔ̂ŋ chʉʼ bɛ́ŋ lɛɛŋbə-ɔ̄ŋ, <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />mbɔ bə chʉʼ chʉ̀ə ŋkwɛ-yʉə bənchəŋ bʉəbʉə bʉʼka mbɔ bɔ̂ŋ kə bɛ́ŋ shʉəŋ fɛ, bɔ̂ŋ bɔŋ nɔ nə kɔ́ fyiihə-ʉə bə ndə nubə ndə i gòʼ təmə bɛ ndyʉndyʉ fɛ.<verse eid="2TH 2:12" /></para>
  <para style="s">Bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii tə́nə shʉ́əshʉ́ə</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />Bəliŋ-baʼa, ndə Tiekətʉ kʉ̀ʉ, baʼa nɔ kie ndə mə-kə́-kɔ́ ndɔ Nyii yie-bii təvɛʼtəvɛʼ, bʉʼka Nyii nɔ nə séʼ bii lʉ̀ hə ndəŋ nchʉʉhə ndə məkɔ́ ŋkwaa tʉ bii, tíŋ hə bɔ̌ŋ ghʉəʼ-kəLyʉʉhə-kə-i, chìi bii, bii bɛ ŋkʉʉ leʼnə məmɔʼfyiihə-ii ndəŋ shʉəŋ. <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />Nyii nɔ nə tíi bii ndə yɔ̄ŋ-yə tíŋ hə bɔ̌ŋ ntəŋjyujyu ndə baʼa kə lɔ̀ʼ tʉ bii. Ɔ tíi bii ndə məgwè lʉ̀ yi-yə yʉʉ mu məgʉ́ə Jiso Klai Tiekətʉ-yʉʼʉ.<verse eid="2TH 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TH 2:15" />Nɔ ndʉʉmɛ, bəliŋ-baʼa, b̈ii tə́nə shʉ́əshʉ́ə, yá shʉəŋ ndə baʼa kə dàhə bii nə yɔŋ, kə bɛ nə ŋgie-chu-kə-aʼ byuunɔ nə nubə ndə baʼa kə nyɔ̀ʼ tʉ bii, tə́nə chɔ.<verse eid="2TH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16" />Nduɔ, tə mbʉ Jiso Klai Tiekətʉ-yʉʼʉ nə mbəŋ-ɛŋ leʼnə mbʉ Nyii Tie-yʉʼʉ ndə ɔ kə kʉ̀ʉ bʉʼʉ, kwèʼhə bʉʼʉ təmə liʼ-i ghɔ fɛ bɔŋ-nɔʼ-leʼ kɔ́ yʉʼ kəyəŋ tʉ bʉʼʉ ndə məyʉ́əʼnə chɔ, tíŋ hə bɔ̌ŋ buuŋjyu-i, <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />kwèʼhə bii bɔŋleʼ kɔ́ bii nə fyii shʉ́əshʉ́ə ndə fɔ̀ʼ jyujyu bɔŋleʼ kə́ kwə́ʼ nu-jyujyu-bə.<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="s">Bii gháaNyii tʉ baʼa</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />Ndə məlìʼtə, bəliŋ-baʼa, b̈ii gháaNyii tʉ baʼa mbɔ ŋ̈gie-Tiekətʉ-kə bìʼ wɔ̀ʼnə gɛ̀ nə shʉbə, b̈ʉə bɔŋleʼ kɔ́ kuŋhə chɔ haʼ ndə i kə bɛ mu bii. <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />Bɔŋleʼ mbɔ N̈yii kwáa baʼa mu kəghɔ-bʉə buuŋbʉə leʼnə bʉə-bʉ̂ʼʉ, Bʉʼka kaa bʉə bənchəŋ ndə bɔ̂ŋ mɔ̀ʼfyiihə-ʉə ndəŋ mbʉ ntəŋjyujyu fɛ. <verse eid="2TH 3:2" /><verse number="3" style="v" sid="2TH 3:3" />Tiekətʉ bɔŋ kə́ bɛ wo gìe shʉəŋ, ɔ bu kɔ́ ghʉəʼkə tʉ bii, kyʉ̀hə bii hə kəghɔ mbʉ Wo Bʉəbʉə ndə bɛ Sata. <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />Baʼa nɔ tʉʼ kie fyii ndəŋ Tiekətʉ bʉʼka bii, mbɔ bii nɔ tʉʼ fɔ̀ʼ, bɔŋ bu kə́ fɔ̀ʼ, nubə ndə baʼa kə kàhə bii chɔ. <verse eid="2TH 3:4" /><verse number="5" style="v" sid="2TH 3:5" />T̈iekətʉ dʉ̀ʼ fia tʉ bii ndə məkie ŋkʉ̂ʉ-Nyii ghɔŋbə məlyʉ̀ʉtə́nə ndə i gwè hə kəghɔ-Klai.<verse eid="2TH 3:5" /></para>
  <para style="s">Bii nɔ kie ndə məfɔ̀ʼ</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />Nduɔ, baʼa nɔ tʉʼ kàhə bii, bəliŋ-baʼa, yie-Tiekətʉ-yʉʼʉ Jiso Klai, mbɔ b̈ii byʉ̀hə ŋwɔŋ-yii mbʉə wo-Nyii təmiyɔŋ ndə ɔ gòʼ təmə kʉ̀ʉ ndə məfɔ̀ʼ fɔʼɔ fɛ, bʉə ndə bɔ̂ŋ gòʼ təmə tə́nə ndəŋ nuʼ ndə bii kə fí kəghɔ-baʼa fɛ. <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />Bʉʼka bii nə mbəŋtə-ii nɔ kínə ntɛ ndə bii kie ndə məlʉ̀ kəghɔ-baʼa, bʉʼka baʼa nə kə́ dùʼdùʼ ndʉʉ ndə bʉʼʉ kə bɛ mɔʼɔ fɛ. <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />Baʼa nə kə́ yú fɔ-wo-kə təmiyɔŋ təmə lɔ̀ʼ fɛ bɔŋ baʼa kə́ fɔ̀ʼ bɔŋleʼ nyíɛ ŋgʉəʼ ndʉʉnəchî ghɔŋbə ndʉʉbətyuʼ mbɔ baʼa mə yi bɛ bɛʼkə tʉ wo mu bii təmiyɔŋ fɛ. <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />Baʼa nə kə́ fɔ̀ʼ yɔ̄ŋ-yə bʉʼka mbɔ baʼa kə byúu ghʉəʼkə ndə məbíʼtə fɔkə kəghɔ-bii fɛ, bɔŋ baʼa nɔ kə́ chìi mbɔ b̈aʼa dʉ̀ʼ fia tʉ bii ndə məlʉ̀ hə kəwu-baʼa, <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />bʉʼka ndʉʉ ndə bʉʼʉ kə bɛ mɔʼɔ, baʼa nɔ kə kàhə bii mbɔ, “Kaʼ wo gòʼ təmə kə́ fɔ̀ʼ fɛ, kə ɔ mə yú fɔkə fɛ.”<verse eid="2TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11" />Bʉʼka baʼa nɔ yʉ́ mbɔ bʉəbɛʼbə mu bii la tʉʼ dùʼdùʼ təmə kə́ fɔ̀ʼ fɔʼɔ fɛ, kə́ kɔ́ bə haʼ chutə-ʉə ndə nu-bəbɛʼbʉə-bə. <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />Yie Jiso Klai Tiekətʉ, baʼa nɔ tʉʼ kàhə ntɛ bʉə-maa-bɔ̄ŋ bɔŋleʼ kə́ fʉ̀ʉtə bɔŋ mbɔ b̈ɔ̂ŋ líitə mbɔ loʼo kə́ fɔ̀ʼ yʉə-yə fɔʼtə ndə məkwáa ŋwɔŋtə-ʉə. <verse eid="2TH 3:12" /><verse number="13" style="v" sid="2TH 3:13" />Bɔŋ ndə bii, bəliŋ-baʼa, kə bii məkáa ndə məfɔ̀ʼ fɔʼ-jyujyu-tə fɛ.<verse eid="2TH 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TH 3:14" />Kaʼ wo gòʼ təmə yʉ́ nukə ndə baʼa nyɔ̀ʼ mu ŋwɔʼnə-fɛ̄ŋ fɛ, b̈ii chèʼ wo-ghɔ̄, kə bii bɔŋ məfúu nuɔ ndə nubɛʼkə təmiyɔŋ fɛ, mbɔ tʉkə-i chʉʼ vyíi. <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />Kə bii mə bɔŋ lʉ̀ ɔ ndə wobàa fɛ, b̈ii shyùu tyunəkə-i ndə liŋ-yii.<verse eid="2TH 3:15" /></para>
  <para style="s">Ndyiʼtə-nchaʼtə-Bɔɔ-kə</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />Nduɔ, T̈iekətʉ ndə fyiighʉ́ənə bɛ yi-yə kɔ́ bii nə fyiighʉ́ənə təvɛʼtəvɛʼ ndə fiatə inchəŋ. T̈iekətʉ bɛ bii bɔŋ mɔʼɔ bənchəŋ.<verse eid="2TH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17" />Mbəŋ-ɔŋ Bɔɔ nɔ tʉʼ nyɔ̀ʼ nchaʼtə-ɔ̄ŋ nə yɔŋ-yə ghɔkə. Nɔ bɛ ntɛ nɔ ndə m̃ɔ jìe ghɔkə-ɔŋ ndəŋ ŋwɔʼnə təmiyɔŋ, kə́ bɛ ntɛ nɔ ndə m̃ɔ nyɔ̀ʼ.<verse eid="2TH 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18" />Tə Jiso Klai Tiekətʉ-yʉʼʉ dʉ̀ʼ buuŋjyu-i tʉ bii bənchəŋ.<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>