<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Bamunka New Testament</book>
  <para style="h">Mak</para>
  <para style="toc1">Bəsɔʼka jyujyu ndə Mak kə fʉ̀ʼtə</para>
  <para style="toc2">Mak</para>
  <para style="toc3">Mak</para>
  <para style="mt2">Bəsɔʼka jyujyu ndə</para>
  <para style="mt1">Mak</para>
  <para style="mt2">kə fʉ̀ʼtə</para>
  <para style="imt">Nchoʼtə bətʉ bənu</para>
  <para style="ip">Nɔ nyɔ̀ʼ Mak nyɔ̀ʼ ŋwɔʼnə-ɔ̄ŋ. Muŋgɔ Mak nɔ chʉ́ʉhə ndə mənyɔ̀ʼ kə́ shyíi bʉʼʉ mbɔ la bɛ ntəŋjyujyu te Jiso Klai, ndə ɔ bɛ VaaNyii. Mak nɔ chìi b̈ə kínə Jiso ndə w̃o ndə ɔ chìi nubə bɔŋ-kə́-leʼ bɛ wo ndə ɔ kie ghʉəʼkə.</para>
  <para style="ip">Jiso nɔ dʉ̀ʼ ghʉəʼkə-i ndə ntɛhə ndə ɔ kə́ dàhə, bɔŋ-kə́-leʼ jə̀ŋ lyʉʉhəbʉəbʉəbə leʼnə ntɛ ndə ɔ kə́ sʉ̀fyii hə ndəŋ bʉ̂ʼ-bʉə-tə.</para>
  <para style="ip">Jiso mu ŋwɔʼnə-ɔ̄ŋ nə mbəŋ-ɛŋ nɔ nyíɛ ŋwɔŋ-ɛŋ ndə Vaa-Woməsʉʉ ndə ɔ kə gwè ndə məkwú ndəŋ bʉ̂ʼ-bʉə-məsʉʉ-tə.</para>
  <para style="ip">Mak nɔ fʉ̀ʼtə nubə te Jiso ndə ntɛ ndə i búɔnə, bɔŋleʼ lʉ̀ yʉʼ kəkʉʉ ndə məkwə́ʼ te nubə ndə Jiso kə́ chìi, təmə kɔ́ ŋgwɔʼmbi yɔ́ŋyɔ́ŋ bə ndə mədahə-i ghɔŋbə nubə ndə ɔ kə́ gìe fɛ. Ndə Mak kə kwə́ʼ məniʼ te Jɔŋ ndə ɔ̃ kɔ́ muu ghɔŋbə məfì muu ndə Jiso kə fí leʼnə məmùutə ndə bə kə mùutə ɔŋ, ɔ gɛ̀ nə shʉbə haʼ ndʉʉmɛ kə́ fʉ̀ʼtə nubə buŋmbi te fɔʼ-Jiso-tə ghɔŋbə fɔʼɔ nchʉʼ-e ghɔŋbə mədahə-i. Ndə ŋgwɔʼmbi kə́ gɛ̀ nə shʉbə, bʉə ndə bɔ̂ŋ kə́ gɛ̀ hə bɔ̌ŋ Jiso kə́ kínə nubə yɔ́ŋyɔ́ŋ te ɔ. Bɔŋ bʉə-bàa-bi kɛŋ leʼ bàa ɔ ghɔ daa.</para>
  <para style="ip">Ŋwɔʼnə-ɔ̄ŋ bu yi kə gwè ndə məliʼ nɔ, fʉ̀ʼtə nubə te ndyiʼtə-bəchî-Jiso-bə kəwʉʉnəmbi-fɛ̄ŋ kə́ bɛ məkwɛ̀ŋ-ɔŋ ndəŋ tyʉntɔɔnəkə leʼnə məkoʼ-e.</para>
  <para style="iot">Nubə ndə i bɛ mu ŋwɔʼnə-fɛ̄ŋ</para>
  <para style="io1">Ntɛ ndə Ntəŋjyujyu kə́ chʉ́ʉhə 1:1-13</para>
  <para style="io1">Fɔʼɔ-Jiso mu Galili 1:14–9:50</para>
  <para style="io1">Jiso lɔ̀ hə Galili gɛ̀ Jɛlosalɛŋ 10:1-52</para>
  <para style="io1">Nukə ndə i fyú tʉ Jiso mu Jɛlosalɛŋ ghɔŋbə yəŋbə mbʉə Jɛlosalɛŋ ndə ndyiʼtə-vyii-mbi-kə, bə buŋ kwɛ̀ŋ ɔŋ yí 11:1–15:47</para>
  <para style="io1">Jiso bʉ̀nə kóʼ 16:1-8</para>
  <para style="io1">Jiso dʉ̀ʼ ŋwɔŋ-ɛŋ bɔŋleʼ kóʼ gɛ̀ yuo nə Tiekətʉ 16:9-20</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">Nyii nɔ kə tə́ŋ Jɔŋ ndə ɔ̃ kɔ́ muu ndə məshʉ̀tə fyii-bʉə-hə te məgwè Jiso</para>
  <para style="r">(<ref loc="MAT 3:1-12">Matia 3:1-12</ref>; <ref loc="LUK 3:1-18">Luk 3:1-18</ref>; <ref loc="JHN 1:19-28">Jɔŋ 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Nɔ bɛ nchʉʉhə ntəŋjyujyu te Jiso Klai nɔ, ndə ɔ bɛ VaaNyii.<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Bəbɛʼbəŋwɔʼnə kəŋgie-Gili nɔ mɔ̀ʼ </char><char style="it">ndə ɔ bɛ VaaNyii</char> chɔ fɛ.</note><verse eid="MRK 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 1:2" />Bə nɔ nyɔ̀ʼ mu ŋwɔʼnə-Adaya yʉkəŋgieNyii<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false">Bəbɛʼbəŋwɔʼnə kəŋgie-Gili nɔ mɔ̀ʼ </char><char style="it">tíŋ hə bɔ̌ŋ bʉəyʉkəŋgieNyii.</char></note> mbɔ,</para>
  <para style="q1" vid="MRK 1:2">“B̈ii nyíɛ, mɔ bu tə́ŋ wontəŋ-ɔŋ, ɔ kə́ gɛ̀ hə bəshʉ a,</para>
  <para style="q2" vid="MRK 1:2">ndə ɔ bu shʉ̀tə fia tʉ a bəshʉ.<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false">Malakai 3:1.</char></note><verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />Gyʉʉ-wobɛʼ nɔ tʉʼ tíi mu kwɔŋkəyəŋnə<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">Kwɔŋkəyəŋnə fɛ̄ŋ nɔ tʉʼ dʉ̀ʼ yəŋkə ndə i yə̀ŋhə daa təmə muu kə́ bɛ chɔ fɛ, təmə fɔyubə kə́ bʉ̀ʉ chɔ fɛ.</char></note> kə́ ghɔ̀ŋ mbɔ, ‘B̈ii shʉ̀tə fia Tiekətʉ, b̈ii shʉ̀tə fiatə-i, ï tə́nə ndyʉndyʉ.’ ”<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">Adaya 40:3.</char></note><verse eid="MRK 1:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MRK 1:4" />Jɔŋ nɔ nə gwè, bʉə kə́ fí muu kəghɔ-ɔ kwɔŋkəyəŋnə, ɔ bɔŋ-kə́-leʼ lɔ̀ʼ mbɔ b̈ʉə la fí muu ndə mədʉ̀ʼ mbɔ bɔ̂ŋ nɔʼ shìe liɛŋtə-ʉə ndəŋ bʉ̂ʼtə-ʉə, gwè tʉ Nyii bə bɔŋleʼ sʉ̀fyii hə ndəŋ mbʉ təbʉ̂ʼ. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Bʉə bənchəŋ mu Judia leʼnə Jɛlosalɛŋ kə́ fyútə gwè tʉ ɔŋ, gwía fyùufyùu ndəŋ bʉ̂ʼtə-ʉə, kə́ fí muu kəghɔ-ɔ mu ŋgwɛŋ Jodaŋ. <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />J̃ɔŋ nɔ kə mɔ̀ʼ ndyi mbʉə-ɔ ndə bə túŋ nə nyu-nyaabɛʼ-hə ndə bə kə́ tíi ɔ nə kamɛ, bɔŋleʼ kə́ kɔ́ʼ kwɔkə tʉʉ-ɔ ndə bə chìi nə gwo-nyaa, fɔyubə-i kə́ bɛ ŋgwehə leʼnə yʉʉ-mu-ŋkɔ-hə. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Ɔ kə́ lɔ̀ʼ ŋgieNyiikə ghɔ̀ŋ mbɔ, “Wo ndə ɔ bu gwè hə bɔ̌ŋ mɔ nɔ shʉ́ə chàa mɔ, mɔ buŋ kʉ̀ʼnə wo ndə məbʉ́ʉnə bəshʉ ɔ, yɔ̀ʼ ghyʉʉ-bətakwu-tə-i fɛ. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Bii nɔ tʉʼ fí muu kəghɔ-mɔ, bɔŋ bii bu fí bə LyʉʉhəNyiikə hə kəghɔ mbəŋ-ɛŋ.”<verse eid="MRK 1:8" /></para>
  <para style="s">Ntɛ məfì muu ndə Jiso nə fí</para>
  <para style="r">(<ref loc="MAT 3:13-17">Matia 3:13-17</ref>; <ref loc="LUK 3:21-22">Luk 3:21-22</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Nɔ nə bɛ mu bəchî-ghɔ̄, Jiso lɔ̀ hə Nasalɛ mu Galili, gwè fí muu hə kəghɔ-Jɔŋ ndə ɔ̃ kɔ́ muu mu ŋgwɛŋ Jodaŋ. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Haʼ ndʉʉmɛ, ndə ɔ kóʼ mu muu, ɔ nyíɛ yuo kə́ ŋɔ́ʼnə, LyʉʉhəNyiikə shíʼ gwè, gwè dùʼ ndəŋ ɔŋ, kie mbʉə bɛ nə tambʉətə. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Gyʉʉ fyú hə yuo ghɔ̀ŋ mbɔ, “A nɔ bɛ vaa-ɔŋ ndə mɔ kʉ̀ʉ daa, tʉʉ-ɔ nɔ bʉ̀ʉ ndəŋ aŋ jyujyu.”<verse eid="MRK 1:11" /></para>
  <para style="s">Bə mùutə Jiso nə nubə ndə ĩ chìi wo chìi bʉ̂ʼʉ</para>
  <para style="r">(<ref loc="MAT 4:1-11">Matia 4:1-11</ref>; <ref loc="LUK 4:1-13">Luk 4:1-13</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Haʼ ndʉʉmɛ, LyʉʉhəNyiikə chóʼ Jiso, ɔ fyú gɛ̀ mu kwɔŋkəyəŋnə. <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />Ɔ bɛ mu kwɔŋkəyəŋnə ndə chîbə wuŋ kwi, Sata kə́ mùutə ɔŋ chɔ mbɔ ɔ gwù mu bʉ̂ʼʉ. Ɔ bɔŋ-kə́-leʼ bɛ chɔ ghɔŋbə nyaa-muŋkɔ-hə, bʉəntəŋNyii kə́ fɔ̀ʼ tʉ ɔŋ.<verse eid="MRK 1:13" /></para>
  <para style="s">Jiso chʉ́ʉhə fɔʼɔ-ɛ</para>
  <para style="r">(<ref loc="MAT 4:12-17">Matia 4:12-17</ref>; <ref loc="LUK 4:14-15">Luk 4:14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Ndʉʉ ndə bə kə yá Jɔŋ fʉ̀əŋ chaŋ, Jiso gwè mu Galili, kə́ lɔ̀ʼ ntəŋjyujyu Nyii, <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />kə́ ghɔ̀ŋ mbɔ, <char style="wj">“Mbʉ ndʉʉ nɔʼ kʉ̀ʼnə tʉ Nyii ndə məsɔ́ʼ bii ndə fɔŋ, b̈ii shìe liɛŋtə-ii hə ndəŋ bʉ̂ʼtə-ii bɔŋleʼ bɛ́ŋ mbʉ ntəŋjyujyu.”</char><verse eid="MRK 1:15" /></para>
  <para style="s">Jiso tíi fəŋ vâafɔʼɔ</para>
  <para style="r">(<ref loc="MAT 4:18-22">Matia 4:18-22</ref>; <ref loc="LUK 5:1-11">Luk 5:1-11</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Nɔ nə bɛ yɔŋbɛʼ Jiso kə́ tòʼ ŋgwuu taanə-kəghəŋ-kə Galili, nyíɛ Samu ghɔŋ Andolo liŋ-iŋ, bɔ̂ŋ kə́ mɔ̀ʼ kasinɛ mu mbʉ kətaanə-kəghəŋ bʉʼka bɔ̂ŋ nɔ nə bɛ bənjuŋgwɔŋ. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Jiso ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“B̈ii gwè hə bɔ̌ŋ mɔ, mɔ bu dàhə bii ndə məyá bə bʉəməsʉʉ.”</char> <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Haʼ ndʉʉmɛ, bɔ̂ŋ mɛ̀ʼtə bəkasinɛ-bʉə gɛ̀ hə bɔ̌ŋ ɔŋ. <verse eid="MRK 1:18" /><verse number="19" style="v" sid="MRK 1:19" />Ɔ kʉ̂ʉ gɛ̀ kʉʉkə məniʼ, nyíɛ Jɛŋ vaa-Sabɛdi ghɔŋ Jɔŋ liŋ-iŋ, bɔ̂ŋ kə́ dùʼ mu kəbuu tɛ́nɛ bəkasinɛ-bʉə. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Haʼ ndʉʉmɛ, ɔ tíi bɔŋ, bɔ̂ŋ mɛ̀ʼtə tie-yʉə Sabɛdi mu kəbuu ghɔŋbə vâafɔʼɔ-bi ndə bɔ̂ŋ tʉʼ fɔ̀ʼ tʉ ɔŋ, gɛ̀ hə bɔ̌ŋ ɔŋ.<verse eid="MRK 1:20" /></para>
  <para style="s">Jiso jə̀ŋ lyʉʉhəbʉəbʉəkə</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luk 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Jiso ghɔŋbə vâafɔʼɔ-bi gɛ̀ mu lɔʼɔ Kabanu, kʉ̂ʉ bɛ ndəŋ Chîlɔʼkə, ɔ tuŋ gɛ̀ mu njaagháaNyii kə́ dàhə. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Ntɛ ndə ɔ kə́ dàhə, i chíe chu-yʉə, bʉʼka ɔ nɔ kə́ dàhə bɔŋ nə wo ndə ɔ kie ghʉəʼkə təmə i bɛ ndə yi bʉə dàhə nuʼ-Mushi fɛ.<verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />Haʼ ndʉʉghɔfii, wobɛʼ kə́ bɛ mu njaagháaNyii-bɔŋ nə lyʉʉhənyaatəkə mbʉə-ɔ, ɔ tíi nə ghʉəʼkə ghɔ̀ŋ mbɔ, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />“A tʉʼ kʉ́ʉ ka kəghɔ-baʼa Jiso ndə ɔ lɔ̀ hə Nasalɛ? A tʉʼ gwè yí baʼa mɛ? Mɔ nɔ kínə wo ndə a bɛ yɔŋ-yə, a nɔ bɛ Wo Tʉʉnə ndə a gwè hə bəshʉ-Nyii.”<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />Jiso sɔ́ʼ ɔ ghɔ̀ŋ mbɔ, <char style="wj">“Chʉʼ líitə, fyú mbʉə ɔ!”</char> <verse eid="MRK 1:25" /><verse number="26" style="v" sid="MRK 1:26" />Mbʉ kəlyʉʉhənyaatə ŋɛ̀hə mbʉ wo-ghɔ̄ shʉ́əshʉ́ə, tíi nə ghʉəʼkə, fyú mbʉə-ɔ.<verse eid="MRK 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 1:27" />I chíe chu-yʉə bənchəŋ, tə bɔ̂ŋ kə́ bíʼtə tʉ ŋwɔŋtə-ʉə mbɔ, “Yɔ̄ŋ-yə bɛ ŋgwɔ ka nɔ? Ntɛ mədàhə fefe ndə i kie ghʉəʼkə chɔ! Tə ɔ buŋ kə́ kàhə lyʉʉhənyaatəbə tə bɔ̂ŋ yʉ́ chu-i.” <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />Haʼ ndʉʉmɛ, bə tíi yie-jyujyu-i, i wɔ̀ʼnə bəyəŋbəyəŋ, ndə yəŋbə inchəŋ mbʉə lɔʼɔ Galili.<verse eid="MRK 1:28" /></para>
  <para style="s">Jiso chʉ́ʼ bʉə buŋmbi</para>
  <para style="r">(<ref loc="MAT 8:14-17">Matia 8:14-17</ref>; <ref loc="LUK 4:38-41">Luk 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Haʼ ndʉʉmɛ ndə ɔ<note caller="+" style="f"><char style="fr" closed="false">1:29 </char><char style="ft" closed="false">Bəbɛʼbəŋwɔʼnə kəŋgie-Gili nɔ ghɔ̀ŋ mbɔ </char><char style="it">bɔ̂ŋ.</char></note> kə fyú hə mu njaagháaNyii, ɔ gɛ̀ ghɔŋbə Jɛŋ leʼnə Jɔŋ, gɛ̀ ŋíi mu njaa bəSamu ghɔŋ Andolo. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Nduɔ, naachi Samu kə́ bɛ nə nchyʉʼkə mbʉə-ɔ, haʼ ndʉʉmɛ bɔ̂ŋ kwə́ʼ tʉ Jiso te ɔ. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Ɔ gwè yá kwii-i, bə̀ŋhə ɔŋ, mbʉ kənchyʉʼ fyú hə mbʉə-ɔ, ɔ chʉ́ʉhə mətía bɔŋ.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />Ndʉʉbuumbi yɔ̂ŋ-ghɔ̄, ndʉʉ ndə chichi nɔʼ bùu chusii-ɔ, mbʉ bʉə gwè tʉ ɔŋ nə bʉə-bəyɔʼ byuunɔ bʉə ndə lyʉʉhəbʉəbʉəbə tʉʼ chɔ́ŋhə bɔŋ. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Bʉə bənchəŋ mu kəyəŋkwɛʼtəŋ chə̀ŋtə chusii-ghɔ̄. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Ndʉʉghɔfii, ɔ chʉ́ʼ bʉə buŋmbi ndə bɔ̂ŋ kə́ yɔ́ʼ nə yɔ́ʼbə ntɛntɛhə bɔŋleʼ fyúhə lyʉʉhəbʉəbʉəbə buŋmbi mu mbʉə-bʉə-hə. Təmə ɔ mɛ̀ʼtə mbʉ bəlyʉʉhəbʉəbʉə bɔ̂ŋ kwə́ʼ fɛ, bʉʼka bɔ̂ŋ nɔ kə kínə wo ndə ɔ bɛ yɔŋ-yə.<verse eid="MRK 1:34" /></para>
  <para style="s">Jiso lɔ̀ʼ ntəŋjyujyu mu Galili</para>
  <para style="r">(<ref loc="LUK 4:42-44">Luk 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Kʉ̂ʉ sɛŋ bɛ ndʉʉsɛŋkə bətyuʼbətyuʼ, yəŋbə kə́ bíe kənjəŋ, Jiso lɔ̀ gɛ̀ kəyəŋ-bəliinə, gɛ̀ gháaNyii. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Samu ghɔŋbə bʉə ndə bɔ̂ŋ kə bɛ chɔ, kə́ kʉ́ʉ ɔ, <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />bɔ̂ŋ nyíɛ ɔŋ ghɔ̀ŋ tʉ ɔŋ mbɔ, “Bʉə bənchəŋ tʉʼ kʉ́ʉ a.”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />Ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“B̈ʉʼʉ gɛ̀ nə shʉbə mu ibɛʼ-yə yəŋkwɛʼtəŋbə, mɔ chʉʼ leʼ lɔ̀ʼ ntəŋjyujyu-ɔ̄ chɔ, bʉʼka nɔ nukə ndə mɔ kə gwè bʉʼka yɔŋ.”</char> <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />Ɔ tòʼ yə̀ŋ mu Galili inchəŋ, kə́ lɔ̀ʼ ntəŋjyujyu mu-njaaghaaNyii-hə-ʉə kə́ leʼ fyúhə lyʉʉhəbʉəbʉəbə.<verse eid="MRK 1:39" /></para>
  <para style="s">Jiso chʉ́ʼ wo-kəlɔ</para>
  <para style="r">(<ref loc="MAT 8:1-4">Matia 8:1-4</ref>; <ref loc="LUK 5:12-16">Luk 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Wo-kəlɔbɛʼ gwè kwíʼtə bəshʉ Jiso fʉ̀ʉtə ɔŋ ghɔ̀ŋ mbɔ, “Kaʼ a kʉ̀ʉ, bəkɔ a chìi mɔ tʉ́ʉnə.”<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />Jiso kie tʉvyiikə ndəŋ ɔŋ, dùhə ghɔkə-i kə̀ŋ ɔŋ, ghɔ̀ŋ tʉ ɔŋ mbɔ, <char style="wj">“Mɔ nɔ kʉ̀ʉ, tʉ́ʉnə.”</char> <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Haʼ ndʉʉmɛ mbʉ kəlɔ fyú mbʉə-ɔ, ɔ bɛ tʉ́ʉnə. <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />Haʼ ndʉʉmɛ, Jiso téʼ tʉ ɔŋ ɔ gɛ̀ nə wi, shyùu tyunəkə-i shʉ́əshʉ́ə, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />ghɔ̀ŋ tʉ ɔŋ mbɔ, <char style="wj">“Kə a mə shyíi wo fɛ, fəŋ gɛ̀ dʉ̀ʼ ŋwɔŋ-aŋ tʉ wofɛ̀ʼndɛŋNyii* bɔŋleʼ fɛ̀ʼndɛŋ* ndə Mushi kə kàhə, bʉə chʉʼ kínə mbɔ a bɛ tʉ́ʉnə.”</char><verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />Bɔŋ mbʉ wo-ghɔ̄ fyú gɛ̀ mbi chʉ́ʉhə kə́ lɔ̀ʼ mbʉ bəsɔʼka ndə yəŋbə inchəŋ. Ɔ kɛŋ wɔ̀ʼhə yɔ́ŋyɔ́ŋ i chìi təmə Jiso mə leʼ gɛ̀ ntaa mu kəyəŋkwɛʼtəŋ fɛ. Ɔ gɛ̀ káa ndə yəŋ-bəliinə-bə, bʉə kə́ gwètə chɔ tʉ ɔŋ hə bəyəŋbəyəŋ.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">Jiso chʉ́ʼ wo ndə ɔ kwú kəviakəmɔʼ</para>
  <para style="r">(<ref loc="MAT 9:1-8">Matia 9:1-8</ref>; <ref loc="LUK 5:17-26">Luk 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Ndʉʉ ndə Jiso kə bʉ̀nə gwè lɔʼɔ Kabanu, ndə mbyu-bəchî-hə tíŋ məniʼ, bə yʉ́ mbɔ ɔ la nɔʼ bʉ̀nə gwè chunjaa. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Bʉə buŋmbi chə̀ŋtə, təmə fia leʼ bɛ ghɔ ndə mətíŋ fɛ, buŋ təkɔmə mətíŋ hə chusii. Ɔ kə́ lɔ̀ʼ ŋgieNyiikə tʉ bɔŋ. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Bʉəbɛʼbə gwè tʉ Jiso nə wo ndə ɔ nɔʼ kwú kəviakəmɔʼ, bʉə kwi bɛ̀ʼ ɔ ndəŋ mbyuukə. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Bɔ̂ŋ kʉ̂ʉ mùutə məgɛ̀ dàa mbʉə ɔ kəŋkaa bʉʼka bʉə ndə bɔ̂ŋ yɔ́ŋ daa, bɔ̂ŋ shùʼ mbyuu kətʉ njaa,<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">Bʉə-Juu nɔ nə kə́ bɔ́ŋ njaahə-ʉə nɔ bɔ̂ŋ mɔ̀ʼ ghɔ̂ʼ chɔ, lyʉ́ʉ tʉkə-i nə chiabə təmə kwɛ̀ŋkwɛ̀ŋ fɛ. Chìi yuhəbə mbi ndə məkóʼ gɛ̀ kətʉ ghɔ.</char></note> shúʼhə mbʉ kəmbyuu sê ndə mbʉ wo ndə ɔ nɔʼ kə kwú kəviakəmɔʼ nʉ̀ʉ chɔ. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Jiso kʉ̂ʉ nyíɛ ntɛ ndə bɔ̂ŋ mɔ̀ʼfyiihə-ʉə ndəŋ ɔŋ, ɔ ghɔ̀ŋ tʉ mbʉ wo ndə ɔ nɔʼ kwú kəviakəmɔʼ le mbɔ, <char style="wj">“Ŋaʼ, bə nɔʼ sʉ̀fyii hə ndəŋ bʉ̂ʼʉ-a.”</char><verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />Bʉəbɛʼbə ndə b̃ɔ̂ŋ dàhə nuʼ-Mushi kə́ dùʼtə chɔ, kə́ bíʼtə mu fyii-bɔŋ mbɔ, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“Chìi ka wo-ɔ̄ kə́ kwə́ʼ mənɔ? Ɔ nɔ tʉʼ bʉ́əhə yie Nyii! Bɛ nda ndə bəkɔ ɔ sʉ̀fyii-i hə ndəŋ bʉ̂ʼʉ-wo yaʼkɛŋ Nyii tətɛʼ ɔ?” <verse eid="MRK 2:7" /><verse number="8" style="v" sid="MRK 2:8" />Haʼ ndʉʉmɛ, Jiso kínə mu mbʉə-ɔ nukə ndə bɔ̂ŋ tʉʼ kwɔ̀ʼtə, gìe tʉ bɔŋ mbɔ, <char style="wj">“Chìi ka bii kə́ bíʼtə nubə-ɔ̄ŋ hə mu fyii-bii?</char> <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" /><char style="wj">Yùhə yɔ̂ŋ-yə, ndə məgìe tʉ wo-ɔ̄ ndə ɔ nɔʼ kwú kəviakəmɔʼ nɔ mbɔ, ‘Bə nɔʼ sʉ̀fyii hə ndəŋ bʉ̂ʼʉ-a’ mɛ byuunɔ kə məghɔ̀ŋ mbɔ, ‘Lɔ̀ hə sê, lʉ̀ mbyuukə-a, tòʼ ’?</char> <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" /><char style="wj">Mɔ bu chìi bii kínə mbɔ mbʉ Vaa-Woməsʉʉ nɔ kie ghʉəʼkə kəchisê ndə məsʉ̀fyii-i hə ndəŋ bʉ̂ʼʉ.”</char> Ɔ ghɔ̀ŋ tʉ wo-ghɔ̄ ndə ɔ nɔʼ kə kwú kəviakəmɔʼ le mbɔ, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" /><char style="wj">“Mɔ nɔ tʉʼ ghɔ̀ŋ tʉ a mbɔ, lɔ̀ hə sê, lʉ̀ mbyuukə-a, gɛ̀ chunjaa.”</char> <verse eid="MRK 2:11" /><verse number="12" style="v" sid="MRK 2:12" />Haʼ ndʉʉmɛ, ɔ lɔ̀ hə sê lʉ̀ mbyuukə-i tòʼ tíŋ hə bəshʉ bʉə bənchəŋ fyú mbi, i chìi chu-yʉə chíe, bɔ̂ŋ kə́ lə̀ʼtə Nyii ghɔ̀ŋ mbɔ, “Baʼa chʉʼ nə nyíɛ nukə ndə yɔ̄ŋ-yə fɛ!”<figure style="fig" alt="Lowering a paralysed man" file="Parlyse on Roof 01.jpg" size="col" loc="1-12" copy="Mbanji Bawe Ernest" ref="2:12">Məshúʼhə wo ndə ɔ nɔʼ kwú kəviakəmɔʼ ndə mbyuukə mɔ̀ʼ bəshʉ Jiso</figure><verse eid="MRK 2:12" /></para>
  <para style="s">Jiso tíi Lɛvi</para>
  <para style="r">(<ref loc="MAT 9:9-13">Matia 9:9-13</ref>; <ref loc="LUK 5:27-32">Luk 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Ndʉʉmɛ, Jiso bìʼ fyú gɛ̀ ŋgwuu taanə-kəghəŋ-Galili-kə, nuɔ-bʉə-tə kə́ gwè tʉ ɔŋ, ɔ kə́ dàhə bɔŋ. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Ndə ɔ kə́ tòʼ tíŋ, ɔ nyíɛ Lɛvi ndə ɔ bɛ vaa-Afio, ɔ dùʼ mu vaa-njaa fí tashi, Jiso ghɔ̀ŋ tʉ ɔŋ mbɔ, <char style="wj">“Gwè hə bɔ̌ŋ mɔ.”</char> Ɔ lɔ̀ hə sê gɛ̀ hə bɔ̌ŋ ɔŋ.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Ndʉʉ ndə Jiso kə́ yú fɔbə mu njaa Lɛvi buŋmbi bʉə fí tashi ghɔŋbə bʉə-bʉ̂ʼʉ bìa ɔ ghɔŋbə vâafɔʼɔ-bi ndə məyú fɔbə, bʉʼka bɔŋ buŋmbi nɔ kə́ gɛ̀ hə bɔ̌ŋ ɔŋ. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Bʉə dàhə nuʼ-Mushi ndə bɔ̂ŋ kə bɛ bʉə-Falasi, kʉ̂ʉ nyíɛ mbɔ ɔ tʉʼ yú fɔbə<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">Bəbɛʼbəŋwɔʼnə kəŋgie-Gili nɔ bìʼ </char><char style="it">bɔŋleʼ nú.</char></note> ghɔŋbə bʉə-bʉ̂ʼʉ leʼnə bʉə fí tashi, bɔ̂ŋ kə́ bíʼtə tʉ vâafɔʼɔ Jiso mbɔ, “Chìi ka ɔ kə́ yú fɔbə ghɔŋbə bʉə fí tashi leʼnə bʉə-bʉ̂ʼʉ?” <verse eid="MRK 2:16" /><verse number="17" style="v" sid="MRK 2:17" />Ndʉʉ ndə Jiso kə yʉ́, ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Kaa w̃o shʉ́əshʉ́ə ndə ɔ gɛ̀ tʉ dota fɛ, nɔ gɛ̀ wokəyɔʼ. Mɔ gwè ndə mətíi bʉə ndə bɔ̂ŋ kwɔ̀ʼtə mbɔ bɔ̂ŋ bɛ ndyʉndyʉ fɛ, mɔ nɔ gwè ndə mətíi bʉə-bʉ̂ʼʉ.”</char><verse eid="MRK 2:17" /></para>
  <para style="s">Kwəʼ te məjì muu</para>
  <para style="r">(<ref loc="MAT 9:14-17">Matia 9:14-17</ref>; <ref loc="LUK 5:33-39">Luk 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Nduɔ, vâafɔʼɔ Jɔŋ ndə ɔ̃ kɔ́ muu ghɔŋbə bʉə-Falasi nɔ nə kə́ jì muu. Bʉəbɛʼbə gwè bíʼtə tʉ Jiso mbɔ, “Chìi ka vâafɔʼɔ Jɔŋ ghɔŋbə vâafɔʼɔ bʉə-Falasi kə́ jì muu bɔŋ təmə ya-yə vâafɔʼɔ kə́ jì fɛ?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />Jiso bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“Bəkɔ bʉə-ŋkɔʼnə woləŋ ndə ɔ tʉʼ chìi lɔŋ, jì muu ghɔŋ bɔŋ kə́ bɛ mɔʼɔ mɛ? Kaʼ ghɔŋbə mbʉ woləŋ chìi lɔŋ bɛ mɔʼɔ, bɔ̂ŋ mə jì muu fɛ.</char> <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" /><char style="wj">Bɔŋ chîbə tʉʼ gwè ndə bə bu lʉ̀ mbʉ woləŋ ndə ɔ tʉʼ chìi lɔŋ kəghɔ-bɔŋ, ndʉʉmɛ bɔ̂ŋ bu kə́ jì muu.</char> <verse eid="MRK 2:20" /><verse number="21" style="v" sid="MRK 2:21" /><char style="wj">Wo mə lʉ̀ via-ndyi-fefe-kə tɛ́nɛ ndyi kənduɔŋ nə yɔŋ fɛ. Kaʼ ɔ chìi nɔ, mbʉ kəvia ndyi fefe ŋʉ́ə, chóʼ mbyuu chɔ, mbʉ mbyuu bìʼ ghʉ́ʉnə chàa ndə i kə bɛ.</char> <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" /><char style="wj">Wo kyinə véʼ ndʉʼ-sʉ́ʼnə-mə mu bɔʼ-kənduɔŋ-kə ndə bə chìi nə gwo-nyaa fɛ. Kaʼ ɔ chìi nɔ mbʉ məndʉʼ sáa mbʉ gwo-məndʉʼ, mbʉ gwo byʉ́ʼ, mbʉ məndʉʼ tyùnə bɛ́. Bɔŋ ñdʉʼ-sʉ́ʼnə-mə nɔ ŋíi mu bɔʼ-fefe-kə.”</char> <note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">Bəbɛʼbəŋwɔʼnə kəŋgie-Gili nɔ fyúhə </char><char style="it">Bɔŋ ñdʉʼ-sʉ́ʼnə-mə nɔ ŋíi mu bɔʼ-fefe-kə.</char></note><verse eid="MRK 2:22" /></para>
  <para style="s">Tiekətʉ-Chîlɔʼkə</para>
  <para style="r">(<ref loc="MAT 12:1-8">Matia 12:1-8</ref>; <ref loc="LUK 6:1-5">Luk 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Nɔ nə bɛ Chîlɔʼbɛʼkə, Jiso kə́ tíŋ ghɔŋbə vâafɔʼɔ-bi mutɔ-məntɔŋ. Ndə bɔ̂ŋ kə́ tíŋ, vâafɔʼɔ-bi chʉ́ʉhə kə́ shyìi ntɔŋmə. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Bɔŋ bʉə-Falasi kə́ bíʼtə tʉ ɔŋ mbɔ, “Nyíɛ! Chìi ka vâafɔʼɔ-ba kə́ bə́ʼ nuʼ ndəŋ Chîlɔʼkə?” <verse eid="MRK 2:24" /><verse number="25" style="v" sid="MRK 2:25" />Ɔ bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“Bii chʉʼ nə tíi mu ŋwɔʼnə-Nyii, nukə ndə Dɛbi nə chìi, vɛʼ ndə jyʉʉ nə yɔ́ʼ ɔ ghɔŋbə bʉə-bi fe?</char> <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" /><char style="wj">Ɔ nɔ kə sʉ́ʉ mu lɛʼ-Nyii-kə vɛʼ ndə Abiata kə bɛ tiefɛ̀ʼndɛŋkwɛʼtəŋNyii, kwó bele-fɛ̀ʼndɛŋ ndə kə kie haʼ bʉəfɛ̀ʼndɛŋNyii ndə məkwó bɔŋleʼ kɔ́ ibɛʼ-yə tʉ bʉə ndə ghɔŋ bɔŋ kə́ bɛ mɔʼɔ.”</char> <verse eid="MRK 2:26" /><verse number="27" style="v" sid="MRK 2:27" />Jiso bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“Bə nɔ chìi Chîlɔʼkə bʉʼka woməsʉʉ, bə kə chìi woməsʉʉ bʉʼka Chîlɔʼkə fɛ.</char> <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" /><char style="wj">Nɔ, Vaa-Woməsʉʉ nɔ bɛ Tiekətʉ-Chîlɔʼkə ghɔ.”</char><verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">Jiso chʉ́ʼ wokəyɔʼ ndəŋ Chîlɔʼkə</para>
  <para style="r">(<ref loc="MAT 12:9-14">Matia 12:9-14</ref>; <ref loc="LUK 6:6-11">Luk 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Jiso bìʼ ŋíi mu njaagháaNyii, wobɛʼ kə́ bɛ chɔ ndə kwii-i nɔʼ kwú. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Bɔ̂ŋ kə́ kíi Jiso ndə mənyíɛ mbɔ ɔ bu chʉ́ʼ mbʉ wo-ghɔ̄ ndəŋ Chîlɔʼkə mɛɛ, bɔ̂ŋ chʉʼ mɔ̀ʼ nukə kətʉ-ɔ. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />Ɔ ghɔ̀ŋ tʉ mbʉ wo-ghɔ̄ ndə kwii-i nɔʼ kwú le mbɔ, <char style="wj">“Gwè cha fɛ̄ŋ.”</char> <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />Ɔ bíʼtə tʉ bɔŋ mbɔ, <char style="wj">“Bɛ yɔ̄ŋ-yə nukə, ndə nuʼ mɛ̀ʼtə mbɔ b̈ə fɔ̀ʼ ndəŋ Chîlɔʼkə, ndə məfɔ̀ʼ bʉ̀ʉ mɛ, kə məfɔ̀ʼ bʉ̂ʼʉ? Ndə məkwáa tʉ-wo-kə mɛ, kə məyí ɔ?”</char> Bɔ̂ŋ líitə mbɔ loʼo. <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />Jiso lɛ́nə bɔŋ nə tʉʉbʉə, mu fyii-i kə́ chɔ́ŋhə ɔŋ shʉ́əshʉ́ə ndə bɔ̂ŋ shʉ́əhə fyiihə-ʉə. Ndʉʉmɛ, ɔ ghɔ̀ŋ tʉ wo-ghɔ̄ mbɔ, <char style="wj">“Shyìi kwii-a.”</char> Ɔ shyìi mbʉ kwii, i bʉ̀nə bɛ jyujyu. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Mbʉ bʉə-Falasi fyú gɛ̀ yá nchəŋtə haʼ ndʉʉmɛ ghɔŋbə bʉə nuɔ Hɛlo te nukə ndə bɔ̂ŋ bu chìi ndə məyí Jiso.<verse eid="MRK 3:6" /></para>
  <para style="s">Nuɔ bʉə gɛ̀ hə bɔ̌ŋ Jiso</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Jiso fyúhə ŋwɔŋ-ɛŋ ghɔŋbə vâafɔʼɔ-bi gɛ̀ mbʉə taanə-kəghəŋ-kə, nuɔ-bʉə-buŋmbi gɛ̀ hə bɔ̌ŋ ɔŋ. Bɔ̂ŋ nɔ kə lɔ̀ hə Galili, Judia, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />Jɛlosalɛŋ, Idumia leʼnə bəbɛʼbə yəŋbə ndə i yíɛ́ʼ ŋgwɛŋ Jodaŋ ghɔŋbə yəŋbə ndə i bɛ mbʉə Taa ghɔŋ Sidɔŋ. Ndʉʉ ndə mbʉ nuɔ-bʉə yʉ́ nchəŋnchəŋ bənu ndə ɔ kə́ fɔ̀ʼ, bɔ̂ŋ gɛ̀ tʉ ɔŋ. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Ɔ ghɔ̀ŋ tʉ vâafɔʼɔ-bi mbɔ b̈ɔ̂ŋ la shʉ̀tə buukə tʉ́ʼ tʉ ɔŋ, bʉʼka bʉə nɔ kə yɔ́ŋ daa byuunɔ təmə bɔ̂ŋ bu yíʼtə ɔŋ. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />Bʉʼka ɔ nɔʼ kə chʉ́ʼ bʉə buŋmbi, i chìi bʉə bənchəŋ ndə bɔ̂ŋ kə kie yɔʼbə kɔ́ʼ kətʉ-ɔ ndə məkə̀ŋ ɔŋ. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Bɔŋ ndʉʉtəmiyɔŋ ndə lyʉʉhənyaatəbə nyíɛ Jiso nɔ, bɔ̂ŋ bʉ́ʉnə bəshʉ ɔ, tíi mbɔ, “A nɔ bɛ VaaNyii.” <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />Bɔŋ Jiso shyùu tyunəkə-ʉə shʉ́əshʉ́ə mbɔ bɔ̂ŋ mə chìi wo kínə wo ndə ɔ bɛ yɔŋ fɛ.<verse eid="MRK 3:12" /></para>
  <para style="s">Jiso séʼ bəlɔntəŋNyii njuɔ bûu nə wuŋ</para>
  <para style="r">(<ref loc="MAT 10:1-4">Matia 10:1-4</ref>; <ref loc="LUK 6:12-16">Luk 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Ndʉʉ ndə Jiso kóʼ gɛ̀ kwɔŋ, ɔ tíi bʉə ndə ɔ kʉ̀ʉ, bɔ̂ŋ gwè tʉ ɔŋ. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Ndʉʉmɛ, ɔ chóʼ bʉə njuɔ bûu nə wuŋ ndə ɔ tíi bɔŋ nə bəlɔntəŋNyii mbɔ ghɔŋ bɔŋ chʉʼ bɛ mɔʼɔ, ɔ chʉʼ kə́ tə́ŋ bɔŋ mbi ndə məgɛ̀ lɔ̀ʼ ntəŋjyujyu, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />bɔŋleʼ kie ghʉəʼkə ndə məjə̀ŋ lyʉʉhəbʉəbʉəbə. <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />Bʉə ndə ɔ kə séʼ bɔŋ nɔ kə bɛ Samu ndə ɔ tyú yie-e nə Bita, <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />Jɛŋ vaa-Sabɛdi leʼnə Jɔŋ liŋ-iŋ ndə Jiso tyú yie-yʉə nə Bonaji, i kə́ bɛ mbɔ bɔ̂ŋ la bɛ nə fuu-yuo, <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />Andolo, Fili, Batolomiɛ leʼnə Matia, Tɔmɔ, Jɛŋ vaa-Afio, Tadio, Samu ndə bə kə́ tíi ɔ nə tiɛŋ-lɔʼɔ, <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />leʼnə Juda Iskalo kə́ bɛ wo ndə ɔ kə fɛ̀ŋ Jiso.<verse eid="MRK 3:19" /></para>
  <para style="s">Jiso ghɔŋbə Vaa-fɔŋ Bəlyʉʉhəbʉəbʉə</para>
  <para style="r">(<ref loc="MAT 12:22-32">Matia 12:22-32</ref>; <ref loc="LUK 11:14-23">Luk 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Ndʉʉmɛ, Jiso bʉ̀nə chunjaa, mbʉ nuɔ-bʉə bìʼ chə̀ŋtə i bɛ təmə bɔ̂ŋ kie saa ndə məyú fɔkə fɛ. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Bɔŋ ndʉʉ ndə bʉə-bi kə yʉ́, bɔ̂ŋ fyú gɛ̀ ndə mədùu ɔ fyúhə, bʉʼka bə nɔ kə kə́ ghɔ̀ŋ mbɔ, “Ɔ nɔʼ bɛ ndaahə-i.”<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />Bəbɛʼbʉə dàhə nuʼ-Mushi ndə bɔ̂ŋ kə shíʼ gwè hə Jɛlosalɛŋ kə́ ghɔ̀ŋ mbɔ, “Ɔ nɔ kie Bɛsɛbu<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="ft" closed="false"><char style="it">Bɛsɛbu </char> nɔ bɛ ibɛʼ-yə yie Sata.</char></note>,” bɔŋleʼ kə́ ghɔ̀ŋ mbɔ, “Ɔ nɔ tʉʼ jə̀ŋ lyʉʉhəbʉəbʉəbə nə ghʉəʼ-fɔŋ-bəlyʉʉhəbʉəbʉə-kə.”<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />Ɔ tíi bɔŋ mbʉə ɔ, kwə́ʼ tʉ bɔŋ ndə mbɔ̂hə mbɔ, <char style="wj">“Bəkɔ Sata jə̀ŋ Sata təka?</char> <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" /><char style="wj">Kaʼ lɔʼɔ kətə̂ŋ dùʼ nə gyʉʉhə ibûu, lɔʼɔ-ghɔ̄ mə tə́nə fɛ.</char> <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" /><char style="wj">Bɔŋ kaʼ chufu dùʼ nə gyʉʉhə ibûu, chufu-ghɔ̄ mə tə́nə fɛ.</char> <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" /><char style="wj">Kaʼ Sata leʼ lɔ̀ hə sê kə́ bʉ̀nə shùɔ shʉ-i nə mbəŋ-ɛŋ, ɔ mə tə́nə fɛ, təmə məlìʼ-i nɔʼ tʉʼ gwè.</char> <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" /><char style="wj">Bɔŋ wo mə leʼ sʉ́ʉ mu njaa wo shʉ́əshʉ́ə lʉ̀ fɔbə-i təka təmə nɔʼ fəŋ kɔ́ʼ ɔ mɔ̀ʼ sê fɛ? Ndʉʉmɛ, ɔ buŋ sɔ́ʼ mbʉ njaa.</char><verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />
    <char style="wj">“Nɔʼ m̈ɔ shyíi bii nə shʉəŋ, bə bu sʉ̀fyii hə ndəŋ bʉ̂ʼ-bʉə-tə inchəŋ leʼnə ntɛ-yie-bʉəbʉə-hə inchəŋ ndə wo kɔ́ tʉ Nyii,</char> <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" /><char style="wj">bɔŋ wotəmiyɔŋ ndə ɔ bʉ́əhə yie-kəLyʉʉhəNyii, bə kʉʉ nə sʉ̀fyii hə ndəŋ bʉ̂ʼʉ-e fɛ, bʉʼka ɔ nɔʼ gwù njɔ bʉ̂ʼʉ təmə liʼ-i ghɔ fɛ.”</char> <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />Jiso nɔ nə ghɔ̀ŋ nɔ, bʉʼka bɔ̂ŋ nɔʼ kə ghɔ̀ŋ mbɔ, “Ɔ nɔ kie lyʉʉhənyaatəkə mbʉə-ɔ.”<verse eid="MRK 3:30" /></para>
  <para style="s">Ŋkwê-Jiso ghɔŋbə bəliŋ-bi</para>
  <para style="r">(<ref loc="MAT 12:46-50">Matia 12:46-50</ref>; <ref loc="LUK 8:19-21">Luk 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Ŋkwê-Jiso ghɔŋbə bəliŋ-bi bələŋ gwè tə́nə mbi tə́ŋ tíi ɔ. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Bɔŋ nuɔ-bʉə kə́ dùʼtə mbʉə ɔ yə̀ŋhə ɔŋ, kə́ ghɔ̀ŋ tʉ ɔŋ mbɔ, “Nyíɛ! Naa-aŋ ghɔŋbə bəliŋ-ba bələŋ nɔ bɛ mbi kə́ lɛ́nə aŋ.” <verse eid="MRK 3:32" /><verse number="33" style="v" sid="MRK 3:33" />Ɔ bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“Naa-ɔŋ bɛ nda ghɔŋ bəliŋ-bɔŋ bələŋ bɛ bənda?”</char> <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />Ɔ kʉ̂ʉ lɛ́nə bʉə ndə bɔ̂ŋ dùʼtə mbʉə ɔ ghɔ̀ŋ mbɔ, <char style="wj">“Nɔ bɛ naa-ɔŋ nɔ ghɔŋbə bəliŋ-bɔŋ bələŋ!</char> <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" /><char style="wj">Bʉʼka mbɔ wo ndə ɔ tʉʼ fɔ̀ʼ nukə ndə Nyii kʉ̀ʉ, ɔ nɔ bɛ liŋ-ɔŋ woləŋ ghɔŋbə liŋ-ɔŋ woke leʼnə naa-ɔŋ.”</char><verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">Chəŋkə te wo ndə ɔ tʉʼ gɛ̀ shùɔ ŋgwiehə</para>
  <para style="r">(<ref loc="MAT 13:1-23">Matia 13:1-23</ref>; <ref loc="LUK 8:4-15">Luk 8:4-15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Jiso bìʼ chʉ́ʉhə ndə mədàhə mbʉə taanə-kəghəŋ-kə. Nuɔ-bʉə-buŋmbi chə̀ŋtə mbʉə ɔ, i chìi ɔ kóʼ mu kəbuu shíʼ dùʼ ndəŋ ghɔ mu muu. Mbʉ nuɔ-bʉə bənchəŋ tə́ŋtə ŋgwuu-muu njəŋmbi. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Ɔ kə́ dàhə bɔŋ nə nubə buŋmbi ndə mbɔ̂hə, kə́ dàhə bɔŋ ghɔ̀ŋ mbɔ, <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" /><char style="wj">“B̈ii yʉ́! Wo-mutɔbɛʼ nɔ nə gɛ̀ mutɔ ndə məgɛ̀ mɔ̀ʼ ŋgwie,</char> <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" /><char style="wj">ndə ɔ tʉʼ mɔ̀ʼ, bəbɛʼbə gwùtə bətʉghʉʉ, nuɔmə gwè chʉ́ʼtə.</char> <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" /><char style="wj">Bəbɛʼŋgwie gwùtə mu ŋgoʼhə, təmə chɔʼkə bɛ chɔ yɔ́ŋyɔ́ŋ fɛ, haʼ ndʉʉmɛ ndə i kə byùʼ, bʉʼka chɔʼkə kə bɛ chɔ yɔ́ŋyɔ́ŋ fɛ,</char> <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" /><char style="wj">bɔŋ ndʉʉ ndə chichi kóʼ, i tɔ̀ŋtə. Bʉʼka i kə kie ghûutə fɛ, i yúɔnə kwútə.</char> <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" /><char style="wj">Ibɛʼ ŋgwie gɛ̀ gwù mu təgyii, mbʉ təgyii kóʼ kwóhə təmə i kʉ́ʉnə ntɔŋmə fɛ.</char> <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" /><char style="wj">Bəbɛʼŋgwie gwùtə ndəŋ chɔʼ-jyujyu-kə, kóʼ kə́ kʉ́ʉnə ntɔŋmə, mbyu tiɛŋ ŋgwie kə́ kʉ́ʉnə nə wuŋ tia, wuŋ ntʉʼʉ leʼnə ghyʉʉ tíŋ ndə bə kə shùɔ.”</char> <verse eid="MRK 4:8" /><verse number="9" style="v" sid="MRK 4:9" />Ɔ ghɔ̀ŋ ndʉʉmɛ mbɔ, <char style="wj">“Wotəmiyɔŋ ndə ɔ kie tyunəkə ndə məyʉ́, ɔ̈ yʉ́.”</char><verse eid="MRK 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Ndʉʉ ndə ɔ kə bɛ tətɛʼ ɔ, bʉə ndə bɔ̂ŋ kə bɛ mbʉə ɔ ghɔŋbə vâafɔʼɔ-bi njuɔ bûu nə wuŋ bíʼtə tʉ ɔŋ ndə məfʉ̀ʼtə mbʉ chəŋkə tʉ bɔŋ. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Jiso ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Bii nɔ kie ndaa ndə bə kɔ́ tʉ bii ndə məkínə nubə te Sɔ́ʼ-Nyii ndə bə nɔʼ kə lə̀ŋ hə kəghɔ-wʉʉnəmbikə bɔŋ tʉ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ́ŋ mɔ fɛ, bə nɔ kə́ kwə́ʼ nubə inchəŋ tʉ bɔŋ ndə mbɔ̂hə mbɔ,</char><verse eid="MRK 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MRK 4:12" />
    <char style="wj">‘Bɔ̂ŋ bu kɛŋ kə́ nyíɛ haʼ nyíɛ təmə bɔŋ kə́ chèʼnə fɛ,</char></para>
  <para style="q1" vid="MRK 4:12">
    <char style="wj">bɔ̂ŋ kə́ bu yʉ́ nubə ndə mɔ tʉʼ gìe təmə bɔŋ kínə fɛ,</char></para>
  <para style="q1" vid="MRK 4:12">
    <char style="wj">bʉʼka bɔ̂ŋ mə yi shìe liɛŋtə-ʉə bə sʉ̀fyii hə ndəŋ bʉ̂ʼtə-ʉə.’ ”</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">4:12 </char>
      <char style="ft" closed="false">Adaya 6:9-10.</char>
    </note><verse eid="MRK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Ɔ bíʼtə tʉ bɔŋ mbɔ, <char style="wj">“Bii kínə chəŋkə-ɔ̄ŋ fe? Bii bu chìi təka buŋ kínə mbʉ mbɔ̂hə inchəŋ?</char> <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" /><char style="wj">Mbʉ wo shùɔ ŋgwie nɔ bɛ wo ndə ɔ tʉʼ bè ŋgieNyiikə mu bʉə.</char> <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" /><char style="wj">Mbʉ ŋgwie ndə i gwùtə bətʉghʉʉ, nɔ bɛ nə bʉə ndə bɔ̂ŋ tʉʼ yʉ́ ŋgieNyiikə, Sata gwè haʼ ndʉʉghɔfii fyúhə mbʉ kəŋgie ndə bə nɔʼ bè mu bɔŋ.</char> <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" /><char style="wj">Ŋgwie ndə i gwùtə mu ŋgoʼhə nɔ bɛ nə bʉə ndə bɔ̂ŋ yʉ́ mbʉ kəŋgie haʼ ndʉʉmɛ tuŋ fí nə fyii sʉ́ʼnə.</char> <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" /><char style="wj">Təmə bɔ̂ŋ kie ghûutə fɛ, kwìhə məniʼ, kʉ̂ʉ bɛ ndʉʉ ndə nubə tʉʼ shʉ́ə byuunɔ bə kə́ chɔ́ŋhə bɔŋ bʉʼka mbʉ kəŋgie, haʼ ndʉʉmɛ, bɔ̂ŋ tuŋ bʉ̀nə gwù.</char> <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" /><char style="wj">Bəbɛʼbə kə́ bɛ ŋgwie ndə i gwùtə mu təgyii. Bɔ̂ŋ nɔ bɛ nə bʉə ndə bɔ̂ŋ yʉ́ mbʉ kəŋgieNyii,</char> <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" /><char style="wj">bɔŋ ŋkwɔʼtə kəwʉʉnəmbi leʼnə fə́ʼhə ndə i gwè hə ndəŋ fʉʼkə leʼnə ntɔmə te bəbɛʼbə fɔbə ŋíi muŋgɔ kwóhə mbʉ kəŋgieNyii, təmə i mə kʉ́ʉnə ntɔŋmə fɛ.</char> <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" /><char style="wj">Bɔŋ bìbə ndə bə kə shùɔ ndəŋ sê jyujyu nɔ bɛ nə bʉə ndə bɔ̂ŋ yʉ́ mbʉ kəŋgieNyii bɛ́ŋ bɔŋleʼ kʉ́ʉnə ntɔŋmə, wuŋ tia, wuŋ ntʉʼʉ, ghyʉʉ.”</char><verse eid="MRK 4:20" /></para>
  <para style="s">Fʉʼkənu te kɛʼɛ</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luk 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Jiso ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Bə mə gwè nə kɛʼɛ mu njaa kwóhə shyiikə ndəŋ ghɔ byuunɔ mɔ̀ʼ tɔʼɔ kəbɔ, təmə fùɔ bə ndəŋ kəfɔ kweghɔʼ fɛ mɛ?</char> <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" /><char style="wj">Bʉʼka nubɛʼkə kaa ghɔ ndə bə bɔ̀ŋ ndə i bu yi gòʼ təmə kɛ̀ʼnə fɛ, byuunɔ ndə i tʉʼ líi təmə i bu yi gwè ŋgwʉʉnə fɛ.</char> <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" /><char style="wj">Kaʼ wotəmiyɔŋ kie tyunəkə ndə məyʉ́, ɔ̈ yʉ́.”</char> <verse eid="MRK 4:23" /><verse number="24" style="v" sid="MRK 4:24" />Ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“B̈ii ŋɔ́ʼhə tyunəbə-ii ndə nukə ndə bii tʉʼ yʉ́. Ntɛ ndə bii ŋɔ́ʼhə tyunəbə-ii ndə məyʉ́ nukə, nɔ bu dʉ̀ʼ ntyʉʉ ndə bii bu yʉ́, tə buŋ bìʼ yi-yɔ́ŋyɔ́ŋ-yə ndəŋ ghɔ.</char> <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" /><char style="wj">Bʉʼka mbɔ wo ndə ɔ kie, bə bu bìʼ yi-yɔ́ŋyɔ́ŋ-yə chɔ, bɔŋ wo ndə ɔ gòʼ təmə kie fɛ, buŋ vaadyʉʼʉ ndə ɔ kie bə bu fí kəghɔ-ɔ.”</char><verse eid="MRK 4:25" /></para>
  <para style="s">Chəŋkə te ŋgwie ndə i tʉʼ kóʼ</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Jiso bìʼ ghɔ̀ŋ mbɔ, <char style="wj">“Sɔ́ʼ-Nyii nɔ bɛ nə wo ndə ɔ tʉʼ yʉ̀ʼ ŋgwie mutɔ.</char> <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" /><char style="wj">Ɔ kə́ nʉ̀ʉ bɛ́ŋ bɔŋleʼ lɔ̀ ndʉʉbətyuʼ ghɔŋ ndʉʉnəchî, mbʉ ŋgwie sɔ́ʼtə kə́ kóʼ, təmə ɔ kínə nukə ndə i tʉʼ chìi i buŋ kə́ kóʼ fɛ.</char> <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" /><char style="wj">Mbʉ kəchɔʼ chìi mbʉ məntɔŋ kʉ́ʉnə nə mbəŋ-ɛŋ, i fəŋ kɔ́ fyuŋbə, biitəkə i kɔ́ setəkə buŋ kɔ́ mbʉ məntɔŋ muŋgɔ.</char> <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" /><char style="wj">Bɔŋ ndʉʉ ndə mbʉ məntɔŋ tə̀ŋ nɔ, ɔ gɛ̀ haʼ ndʉʉghɔfii kə́ síi nə setəkə bʉʼka ndʉʉ síinə-i nɔʼ kʉ̀ʼnə.”</char><verse eid="MRK 4:29" /></para>
  <para style="s">Chəŋkə te ŋgwie-kîa</para>
  <para style="r">(<ref loc="MAT 13:31-32">Matia 13:31-32</ref>,<ref loc="MAT 13:34">34</ref>; <ref loc="LUK 13:18-19">Luk 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Jiso bíʼtə mbɔ, <char style="wj">“Bəkɔ bʉʼʉ fʉ̀ʼ Sɔ́ʼ-Nyii ndəŋ ka, byuunɔ bɛ ntɛ kəchəŋ ka ndə bəkɔ bʉʼʉ mɔ̀ʼ te yɔŋ?</char> <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" /><char style="wj">I nɔ bɛ nə vaa-ŋgwie-kîa, ndʉʉ ndə bə bè sê, i tə́ʼ chàa ŋgwiehə kəwʉʉnəmbi inchəŋ.</char> <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" /><char style="wj">Bɔŋ ndʉʉ ndə bə bè ɔ, i kóʼ gʉ́ə chàa tyʉbə inchəŋ mutɔ, kɔ́ ntɔŋkwɛʼtəŋtə ndə bəkɔ nuɔ-mbi-mə fʉ̀ə njaahə-ʉə tɔʼɔ ghɔ.”</char><verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />Jiso mɔ̀ʼ mbɔ̂hə tʉ bɔŋ yɔ́ŋyɔ́ŋ nə yɔ̄ŋ-yə, ɔ lɔ̀ʼ ŋgieNyiikə tʉ bɔŋ, ntyʉʉ ndə bəkɔ bɔ̂ŋ yʉ́. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />Ɔ nə kə́ kwə́ʼ tʉ bɔŋ təmə mɔ̀ʼ ndə chəŋkə fɛ, ɔ bɔŋ yə̀ŋnə bɔ̌ŋ nɔ fʉ̀ʼtə nubə nchəŋnchəŋ-ɛŋ tʉ yi-yə vâafɔʼɔ.<verse eid="MRK 4:34" /></para>
  <para style="s">Jiso yùʼ fʉ̂əŋ</para>
  <para style="r">(<ref loc="MAT 8:23-27">Matia 8:23-27</ref>; <ref loc="LUK 8:22-25">Luk 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Kʉ̂ʉ bɛ ndʉʉbuumbi yɔ̂ŋ-ghɔ̄, Jiso ghɔ̀ŋ tʉ vâafɔʼɔ-bi mbɔ, <char style="wj">“B̈ʉʼʉ dàa muu gɛ̀ ndə ibɛʼ-yə via-kətaanə-kəghəŋ-kə.”</char> <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Bɔ̂ŋ kóʼ bìatə ɔŋ mu kəbuu bɛ̀ʼ ɔ ghɔŋ bɔŋ gɛ̀ mɛ̀ʼtə mbʉ nuɔ-bʉə bɔ̌ŋ. Bə kə́ té bəbɛʼbə buubə gwè hə bɔ̌ŋ bɔŋ. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Fʉ̂əŋ shʉ́əshʉ́ə ŋɛ̀nə mu mbʉ muu tə lɛɛŋhə-muu-kə kə́ gwù mu kəbuu, i bɛ tə mbʉ kəbuu kə́ kʉ́ʉ lə́ŋ nə muu.<verse eid="MRK 4:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 4:38" />Jiso kə́ nʉ̀ʉ bɔ̌ŋ kəbuu mɔ̀ʼ tʉkə-i ndəŋ mbunə kə́ bɛ́ŋ. Vâafɔʼɔ-bi yə̀ŋ ɔŋ, ghɔ̀ŋ tʉ ɔŋ mbɔ, “Chicha, a tʉʼ fɛ̀ʼ mbɔ baʼa tʉʼ bɛ́ muu fe?”<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />Ɔ gwùʼtə, sɔ́ʼ mbʉ kəfʉʉ bɔŋleʼ ghɔ̀ŋ tʉ mbʉ muu mbɔ, <char style="wj">“Tə́nə bɔŋleʼ líitə.”</char> Mbʉ kəfʉʉ tə́nə, yəŋbə kɛŋ líitə. <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />Ɔ bíʼtə tʉ bɔŋ mbɔ, <char style="wj">“Bii tʉʼ fàa ka yɔ́ŋyɔ́ŋ nɔ? Bii bieleʼ mɔ̀ʼfyii-yii ndəŋ mɔ fe?”</char> <verse eid="MRK 4:40" /><verse number="41" style="v" sid="MRK 4:41" />Faa-kwu-kə yá bɔŋ shʉ́əshʉ́ə, bɔ̂ŋ kə́ bíʼtə tʉ ŋwɔŋtə-ʉə mbɔ, “Bɔŋ yɔ̄ŋ-yə wo bɛ nda nɔ, tə fʉʉ-shʉ́əshʉ́ə-kə ghɔŋbə lɛɛŋhə-muu-bə kə́ yʉ́ chu-i.”<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">Jiso chʉ́ʼ wo ndə ɔ kie lyʉʉhəbʉəbʉəkə</para>
  <para style="r">(<ref loc="MAT 8:28-34">Matia 8:28-34</ref>; <ref loc="LUK 8:26-39">Luk 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Ndʉʉmɛ, bɔ̂ŋ té buukə gɛ̀ shùɔ ndə ibɛʼ-yə via-kətaanə-kəghəŋ-kə lɔʼɔ Galasa. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Haʼ ndʉʉmɛ ndə Jiso kə fyú hə mu kəbuu, wobɛʼ ndə ɔ kie lyʉʉhənyaatəkə mbʉə-ɔ fyú hə mu sětə ndə bə sáa ndəŋ ŋgoʼ gɛ̀ bìatə ɔŋ. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Ɔ nɔ kə́ chí mu sětə. Wo kə mə kɔ́ʼ ɔ fɛ, tə buŋ kɔmə nə bəchaŋ fɛ, <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />bʉʼka bə nɔ nə kə́ chʉʼ kɔ́ʼtə fʉəŋtə-i ghɔŋbə kwiitə-i, ɔ bɔŋ tòʼ mbʉ chaŋ ndəŋ kwiitə-i chètə ghɔŋbə yi-təfʉəŋ-yə-i. Wo kə bɛ ghɔ ndə ɔ kie ghʉəʼkə ndə məyá ɔ tʉ́ʼ fɛ. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Bəndʉʉbətyuʼ ghɔŋbə bəndʉʉnəchî, ɔ kə́ chʉʼ tòʼ mu sětə ghɔŋbə mu kwɔŋhə, kə́ tòʼ gwía bɔŋleʼ sáatə mbʉə-e nə ŋgoʼhə.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />Bɔŋ ndʉʉ ndə ɔ kə nyíɛ Jiso dɔdɔ, ɔ nyʉ́ʉ gɛ̀ gwù bəshʉ ɔ. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />Ɔ kʉ̂ʉ tíi nə gyʉʉ dədə, ghɔ̀ŋ mbɔ, “A tʉʼ kʉ́ʉ yì ka nə mɔ Jiso, VaaNyii ndə ɔ Chàa bəfɔŋ? Mɔ nɔ tʉʼ fʉ̀ʉtə a, kàa yie Nyii mbɔ, a kʉʉ chɔ́ŋhə mɔ fɛ.” <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Bʉʼka Jiso nɔʼ kə ghɔ̀ŋ tʉ ɔŋ mbɔ, <char style="wj">“Fyú mbʉə wo-ɔ̄, mbəŋ-aŋ lyʉʉhənyaatəkə!”</char><verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />Jiso bíʼtə tʉ ɔŋ mbɔ, <char style="wj">“Yie a bɛ nda?”</char> Ɔ bə̀ŋhə mbɔ, “Yie ɔ nɔ bɛ Nuɔ, bʉʼka baʼa nɔ bɛ buŋmbi.” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />Mbʉ bəlyʉʉhəbʉəbʉə fʉ̀ʉtə Jiso shʉ́əshʉ́ə mbɔ ɔ mə fyúhə bɔŋ mu lɔʼɔ-ghɔ̄ fɛ. <verse eid="MRK 5:10" /><verse number="11" style="v" sid="MRK 5:11" />Nuɔ-bəŋkwunyaa-buŋmbi nɔ nə kə́ yú mbʉ mbʉə kwɔŋ-ghɔ̄ <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />Bɔ̂ŋ fʉ̀ʉtə ɔŋ ghɔ̀ŋ mbɔ, “Jə̀ŋ baʼa kɔ́ mu bəŋkwunyaa, baʼa sʉ́ʉ mu mbʉə-bɔŋ.” <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Nɔ, ɔ kɔ́ fia tʉ bɔŋ, mbʉ bəlyʉʉhə nyàatə fyútə gɛ̀ sʉ́ʉ mu mbʉə mbʉ bəŋkwunyaa. Mbʉ bəŋkwunyaa ndə bɔ̂ŋ bɛ nə ŋkɔŋhə ibûu nyʉ́ʉ shíʼ ndəŋ ŋgwuu-kətaanə-kəghəŋ, nú muu kwútə.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />Mbʉ bənchyii-bəŋkwunyaa nyʉ́ʉ gɛ̀ nə wʉə, gɛ̀ fʉ̀ʼtə mbʉ bəsɔʼka mu kəyəŋkwɛʼtəŋ leʼnə mu lɔʼɔ. Mbʉ bʉə fyútə gɛ̀ ndə mənyíɛ nukə ndə i nɔʼ kə fyú. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Mbʉ bʉə fyútə gɛ̀ tʉ Jiso, gɛ̀ nyíɛ mbʉ wo-ghɔ̄ ndə ɔ nɔʼ kə kie mbʉ nuɔ-bəlyʉʉhəbʉəbʉə le, kə́ dùʼ chɔ bə nɔʼ mɔ̀ʼ ndyihə mbʉə-ɔ, ndaa-ɛ bɔŋ-nɔʼ-leʼ tə́nə, faakə bɔŋleʼ yá bɔŋ. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Bʉə ndə bɔ̂ŋ kə nyíɛ, fʉ̀ʼtə nukə tʉ bɔŋ ndə i kə fyú te mbʉ wo ndə lyʉʉhəbʉəbʉəbə kə bɛ mu mbʉə-ɔ le, leʼnə mbʉ bəŋkwunyaa. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />Bɔ̂ŋ chʉ́ʉhə məfʉ̀ʉtə Jiso ndə məlɔ̀ hə mu bie-bɔŋ. <verse eid="MRK 5:17" /><verse number="18" style="v" sid="MRK 5:18" />Ndʉʉ ndə Jiso kə́ kóʼ mu kəbuu, mbʉ wo-ghɔ̄ ndə lyʉʉhəbʉəbʉəbə nɔʼ kə bɛ mu mbʉə-ɔ le, kə́ fʉ̀ʉtə ɔŋ mbɔ g̈hɔŋ ɔŋ gɛ̀ mɔʼɔ. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />Təmə Jiso bɛ́ŋ fɛ bɔŋ ghɔ̀ŋ tʉ ɔŋ mbɔ, <char style="wj">“Bʉ̀nə gɛ̀ chunjaa gɛ̀ nyíɛ bətieŋkɔŋ-ba, shyíi bɔŋ nə nukwɛʼtəŋbə ndə Tiekətʉ nɔʼ chìi tʉ a leʼnə ntɛ ndə ɔ nɔʼ kə dʉ̀ʼ tʉvyiikə tʉ a.”</char> <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />Ndʉʉmɛ, ɔ lɔ̀ gɛ̀ nə wi, chʉ́ʉhə kə́ lɔ̀ʼ mbʉ bənukwɛʼtəŋ mu kəyəŋbɛʼ bə kə́ tíi nə Dɛkaboli ndə i bɛ mbɔ Yəŋkwɛʼtəŋbə Wuŋ, ntɛ ndə Jiso nɔʼ fɔ̀ʼ tʉ ɔŋ, wotəmiyɔŋ ndə ɔ̈ yʉ́, i chíe chu-i.<verse eid="MRK 5:20" /></para>
  <para style="s">Jiso chʉ́ʼ wokebɛʼ leʼnə vaa-Jalu vaabəke</para>
  <para style="r">(<ref loc="MAT 9:18-26">Matia 9:18-26</ref>; <ref loc="LUK 8:40-56">Luk 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Ndʉʉ ndə Jiso kə bìʼ dàa muu mu kəbuu gɛ̀ ndəŋ ibɛʼ-yə viakə, nuɔ-bʉə yɔ́ŋyɔ́ŋ chə̀ŋtə mbʉə ɔ, mbʉə taanə-kəghəŋ-kə. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Wobɛʼ ndə ɔ kə bɛ mbyu wokwɛʼtəŋ-mu-njaagháaNyii gwè, bə kə́ tíi ɔ nə Jalu, ndʉʉ ndə ɔ nyíɛ Jiso ɔ kwíʼtə bəshʉ ɔ, <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />fʉ̀ʉtə ɔŋ shʉ́əshʉ́ə ghɔ̀ŋ mbɔ, “Vaa-ɔŋ vaabəke nɔ bɛ chu-kwú. Gwè kə̀ŋ ɔŋ nə ghɔkə-a, kə mbɔ ɔ bu kie nchʉʼ, bìi.”<verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />Ɔ gɛ̀ ghɔŋ ɔŋ. Nuɔ-bʉə-buŋmbi kə́ gɛ̀ hə bɔ̌ŋ ɔŋ tə kə́ yíʼtə ɔŋ. <verse eid="MRK 5:24" /><verse number="25" style="v" sid="MRK 5:25" />Wokebɛʼ nɔ kə bɛ chɔ ndə ɔ nɔʼ nyíɛ ŋgʉəʼ nə mbʉʼtəkə-i ndəŋ ŋgʉʼhə njuɔ bûu nə wuŋ. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />Ɔ nɔʼ nyíɛ ŋgʉəʼ kəghɔ-bʉə bəfʉ buŋmbi, nɔʼ fɛ̀ŋ fɔbə-i inchəŋ təmə i tíŋ fɛ, kə́ bìʼ shʉ́əshʉ́ə. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Ndʉʉ ndə ɔ kə yʉ́ nubə te Jiso, ɔ gwè hə bɔ̌ŋ liɛŋ-ɔŋ mu bʉə, gwè kə̀ŋ ndyi-i, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />bʉʼka ɔ nɔ nə ghɔ̀ŋ mbɔ, “Kaʼ mɔ buŋ kə̀ŋ bə ndyi-i, bə chìi mɔ kie nchʉʼ.” <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />Haʼ ndʉʉghɔfii, mbʉ kəfɔbʉə ndə i kə́ fyú hə mbʉə-ɔ chə̀nə, ɔ kínə mu mbʉə-ɔ mbɔ ɔ nɔʼ kie nchʉʼ ndəŋ yɔʼkə-i. <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />Haʼ ndʉʉmɛ, Jiso kínə mu mbʉə-ɔ mbɔ ghʉəʼkə nɔʼ fyú hə mbʉə-ɔ, ɔ kíahə ŋwɔŋ-ɛŋ mu mbʉ bʉə bíʼtə mbɔ, <char style="wj">“Kə̀ŋ nda kə̀ŋ ndyi-ɔ?”</char> <verse eid="MRK 5:30" /><verse number="31" style="v" sid="MRK 5:31" />Vâafɔʼɔ-bi ghɔ̀ŋ tʉ ɔŋ mbɔ, “A nɔ nyíɛ ndə bʉə tʉʼ yíʼtə a, a bʉ̀nə kə́ bíʼtə mbɔ, ‘Kə̀ŋ nda kə̀ŋ mɔ la?’ ” <verse eid="MRK 5:31" /><verse number="32" style="v" sid="MRK 5:32" />Jiso kə́ lɛ́nə ndə mənyíɛ wo ndə ɔ kə̀ŋ ɔŋ. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Bɔŋ ndʉʉ ndə mbʉ woke-ghɔ̄ kínə nukə ndə i nɔʼ fyú tʉ ɔŋ, ɔ fàa gwònə gwè gwù bəshʉ Jiso, shyíi ɔ nə mbʉ shʉəŋ inchəŋ. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Ɔ ghɔ̀ŋ tʉ ɔŋ mbɔ, <char style="wj">“Ŋaʼ, məmɔʼfyii-a ndə a mɔ̀ʼ ndəŋ mɔ, nɔʼ chìi yɔʼkə-a tíŋ. Tòʼ jyu, a nɔʼ bìi ŋgʉəʼ-a.”</char><verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Ndə Jiso kə́ bíe kwə́ʼ tʉ ɔŋ, bʉə-ntəŋ gwè hə fu-Jalu ndə ɔ bɛ wokwɛʼtəŋ-mu-njaagháaNyii ghɔ̀ŋ tʉ ɔŋ mbɔ, “Vaa-a nɔʼ kwú, kə a mə leʼ kɔ́ ŋgʉəʼ tʉ chicha nduɔ fɛ.”<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />Jiso yíɛʼhə yʉ́ kwəʼ-yʉə ghɔ̀ŋ tʉ Jalu, mbʉ wokwɛʼtəŋ-mu-njaagháaNyii mbɔ, <char style="wj">“Kə a mə leʼ fàa fɛ. Kə́ mɔʼɔ haʼ fyii-a ndəŋ mɔ.”</char> <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />Jiso kɔ́tuu mbɔ wo mə gwè hə bɔ̌ŋ ɔŋ fɛ yaʼkɛŋ Bita, Jɛŋ leʼnə Jɔŋ liŋ-Jɛŋ. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Ndʉʉ ndə bɔ̂ŋ gwè mu njaa wokwɛʼtəŋ-mu-njaagháaNyii, Jiso nyíɛ ntɛ mbyuutəmbyuutə ndə i bɛ chɔ, bʉə kə́ gwíatə bɔŋleʼ tíitə nə ghʉəʼkə. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Ndʉʉ ndə ɔ kə sʉ́ʉ mu njaa, ɔ bíʼtə tʉ bɔŋ mbɔ, <char style="wj">“Tʉʼ chɔ́ŋhə ka chɔ́ŋhə bii, bii kə́ gwíatə mənɔ? Mbʉ vaa chʉʼ kwú fɛ, ɔ nɔ tʉʼ bɛ́ŋbɛ́ŋ.”</char> <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />Bɔ̂ŋ chʉ́əʼ ɔ. Ɔ jə̀ŋ bʉə bənchəŋ kɔ́ mbi yaʼkɛŋ tie-mbʉ-vaa ghɔŋ ŋkwê-i leʼnə bʉə ndə ghɔŋ bɔŋ kə bɛ mɔʼɔ. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Jiso jɔ̀ kwii-i, ghɔ̀ŋ tʉ ɔŋ mbɔ, <char style="wj">“Talita kumi,”</char> ndə i bɛ mbɔ, <char style="wj">“Naa-ɛ, mɔ nɔ tʉʼ ghɔ̀ŋ tʉ a mbɔ lɔ̀ hə sê.”</char> <verse eid="MRK 5:41" /><verse number="42" style="v" sid="MRK 5:42" />Haʼ ndʉʉmɛ, mbʉ vaabəke lɔ̀ hə sê chʉ́ʉhə kə́ tòʼ. Ɔ nɔ nə bɛ ŋgʉʼhə njuɔ bûu nə wuŋ. Haʼ ndʉʉmɛ i ghɔ́ʼ bɔŋ bɔŋleʼ chàa bɔŋ. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Ɔ bɔŋ chíe bɔŋ mbɔ bɔ̂ŋ mə chìi wo kínə fɛ, gìe tʉ bɔŋ mbɔ b̈ɔ̂ŋ la kɔ́ fɔbə, ɔ̈ yú.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">Bə tɛ́ŋ Jiso mu Nasalɛ</para>
  <para style="r">(<ref loc="MAT 13:53-58">Matia 13:53-58</ref>; <ref loc="LUK 4:16-30">Luk 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Jiso lɔ̀ hə chɔ bʉ̀nə gwè mu lɔʼɔbə-ɔŋ, vâafɔʼɔ-bi gɛ̀ hə bɔ̌ŋ ɔŋ. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Kʉ̂ʉ bɛ ndəŋ Chîlɔʼkə, ɔ chʉ́ʉhə mədàhə mu njaagháaNyii, bʉə buŋmbi ndə bɔ̂ŋ kə yʉ́ ɔ, i chíe chutə-ʉə, bɔ̂ŋ kə́ bíʼtə mbɔ, “Wo-ɔ̄ yétə nubə-ɔ̄ŋ fa? Bɛ ntɛ-mukətʉ-súunə ka ndə ɔ kie? Bəkɔ ɔ chìi ntɛ nufinəbə-ɔ̄ŋ təka?<figure style="fig" alt="Jesus teaching in the synagogue" file="cn01738c.tif" size="col" copy="David C. Cook" ref="6:2">Jiso kə́ dahə mu njaagháaNyii</figure> <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />Yɔ̄ŋ-yə kaa vaa-kabənda nɔ fe, vaa-Mɛli bɔŋ-kə́-leʼ bɛ liŋ-Jɛŋ ghɔŋbə Josɛ leʼnə Juda nə Samu fe? Bəliŋ-bi vâabəke bɛ bʉʼʉ bɔŋ fɛ̄ŋ mɔʼɔ fe?” I byìi tʉʉ-yʉə.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />Jiso ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“B̃ə nɔ kɔ́ kuŋhə tʉ yʉkəŋgieNyii ndə yəŋbə inchəŋ yaʼkɛŋ mu lɔʼɔbə-ɔŋ, mu bʉə-bi leʼnə mu njaa-ɛ.”</char> <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />Ɔ kə mə fɔ̀ʼ nufinəbə yɔ́ŋyɔ́ŋ chɔ fɛ, yaʼkɛŋ mbyu-bʉə-bəyɔʼ-hə ndə ɔ kə mɔ̀ʼ ghɔkə-i ndəŋ bɔŋ, chʉ́ʼ bɔŋ. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />I chàa ɔ bʉʼka ntɛ ndə bɔ̂ŋ kə gòʼ təmə mɔ̀ʼfyiihə-ʉə ndəŋ ɔŋ fɛ.</para>
  <para style="s" vid="MRK 6:6">Jiso tə́ŋ mbʉ bəlɔntəŋNyii njuɔ bûu nə wuŋ kɔ́ mbi</para>
  <para style="r" vid="MRK 6:6">(<ref loc="MAT 10:5-15">Matia 10:5-15</ref>; <ref loc="LUK 9:1-6">Luk 9:1-6</ref>)</para>
  <para style="p" vid="MRK 6:6">Jiso kə́ tòʼ mu lɔʼ-bətə̂ŋ-tə tòʼ dàhə. <verse eid="MRK 6:6" /><verse number="7" style="v" sid="MRK 6:7" />Ɔ tíi mbʉ bəlɔntəŋNyii njuɔ bûu nə wuŋ chʉ́ʉhə kə́ tə́ŋ bɔŋ mbi bəbûubəbûu, kɔ́ ghʉəʼkə tʉ bɔŋ ndə məgìe kətʉ lyʉʉhənyaatəbə. <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />Ɔ kàhə bɔŋ mbɔ kə bɔŋ mə lʉ̀ fɔkə gɛ̀ nə yɔŋ fɛ, yaʼkɛŋ mbuu, təkɔmə fɔ-yú-kə, təkɔmə kwo, təkɔmə kyʉə mu kwo-kyʉə, <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />bɔŋleʼ ghɔ̀ŋ mbɔ b̈ɔ̂ŋ la kɔ́ takwubə təmə bɔŋ mɔ̀ʼ ndyihə ibûu fɛ, <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />ɔ bɔŋleʼ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Ndʉʉ ndə bii ŋíi mu njaa təmiyɔŋ, b̈ii káa chɔ tə nə lɔ̀ hə chɔ.</char> <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" /><char style="wj">Kaʼ bii gɛ̀ kəyəŋ təmə bɔ̂ŋ fí bii fɛ, təmə bɛ́ŋ ndə məyʉ́ nukə ndə bii tʉʼ gìe fɛ, ndʉʉ ndə bii tʉʼ lɔ̀ hə chɔ, b̈ii kwètə bʉəkə kəwu-bii, ndə mədʉ̀ʼ mbɔ ndɔŋ-yʉə nɔ kətʉ-bɔŋ.”</char><verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />Ndʉʉmɛ, bɔ̂ŋ fyú gɛ̀ mbi, kə́ tòʼ lɔ̀ʼ mbɔ b̈ʉə la shìe liɛŋtə-ʉə ndəŋ bʉ̂ʼtə-ʉə. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />Bɔ̂ŋ jə̀ŋ lyʉʉhəbʉəbʉəbə buŋmbi, núʼ bʉə-bəyɔʼ buŋmbi nə ŋgwomə bɔŋleʼ chʉ́ʼ bɔŋ.<verse eid="MRK 6:13" /></para>
  <para style="s">Kwú Jɔŋ ndə ɔ̃ kɔ́ muu</para>
  <para style="r">(<ref loc="MAT 14:1-12">Matia 14:1-12</ref>; <ref loc="LUK 9:7-9">Luk 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />Nɔ, Fɔŋ Hɛlo yʉ́ nubə te Jiso, bʉʼka yie-e nɔ kə́ wɔ̀ʼnə bəyəŋbəyəŋ. Bəbɛʼbʉə ghɔ̀ŋ mbɔ, “Jɔŋ ndə ɔ̃ kɔ́ muu nɔʼ kə bʉ̀nə kóʼ ndəŋ kwú, nɔ bɛ nukə ndə i chìi ɔ kie ghʉəʼkə ndə məchìi nufinəbə-ɔ̄ŋ nɔ.” <verse eid="MRK 6:14" /><verse number="15" style="v" sid="MRK 6:15" />Bɔŋ bəbɛʼbə kə́ ghɔ̀ŋ mbɔ, “Ɔ nɔ bɛ Ɛlaja.” Bəbɛʼbə kə́ ghɔ̀ŋ mbɔ, “Ɔ nɔ bɛ yʉkəŋgieNyii ndə bəbɛʼbə bʉəyʉkəŋgieNyii ndə ɔ nɔʼ nə bɛ hə bəshʉ.” <verse eid="MRK 6:15" /><verse number="16" style="v" sid="MRK 6:16" />Ndʉʉ ndə Hɛlo kə yʉ́, ɔ ghɔ̀ŋ mbɔ, “Jɔŋ ndə mɔ kə chʉ̀ə tʉkə-i le, la nɔʼ kə bʉ̀nə kóʼ.”<verse eid="MRK 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17" />Hɛlo nɔ kə gìe yɔ̄ŋ-yə bʉʼka ɔ nɔʼ kə fəŋ tə́ŋ yá Jɔŋ fʉ̀əŋ chaŋ ndə məchìi tʉʉ Hɛlodia bʉ̀ʉ, ndə ɔ kə bɛ vi-liŋ-iŋ, Fili. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Bʉʼka Jɔŋ nɔʼ kə́ ghɔ̀ŋ tʉ Hɛlo mbɔ, “I kʉ̀ʼnə mbɔ a lʉ̀ vi-liŋ-aŋ fɛ.” <verse eid="MRK 6:18" /><verse number="19" style="v" sid="MRK 6:19" />Nɔ, tʉʉ Hɛlodia nɔ nə byʉ́ʼ te Jɔŋ ɔ kə́ kʉ́ʉ fia ndə məyí ɔ, bɔŋ mùutə kəŋkaa, <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />bʉʼka Hɛlo nɔ nə kə́ fàa Jɔŋ bɔŋ-kə́-leʼ kyʉ̀hə ɔŋ, kə́ kínə mbɔ Jɔŋ nɔ nə bɛ wo ndə ɔ bɛ ndyʉndyʉ, kə́ bɛ ŋkʉʉ tʉ Nyii. Ndʉʉ ndə ɔ nə kə́ yʉ́ kwəʼ Jɔŋ nɔ, i chɔ́ŋhə ɔŋ, ɔ bɔŋ bìʼ kə́ kʉ́ʉ ndə məyʉ́ kwəʼ-ɛ.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />Bɔŋ kəliʼ, Hɛlodia kie fia ndəŋ chîkə ndə Hɛlo nə chə̀ŋtə kuŋhə, bʉəkwɛʼtəŋ bəsɔge leʼnə bəntəŋbəshʉ mu Galili ndə məyú chîkə ndə bə nə bí ɔ chɔ. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Bʉʼka ndʉʉ ndə vaa-Hɛlodia vaabəke kə gwè mu njaa gwè kʉ̀ʉ ŋkʉʉkə, i chìi tʉʉ Hɛlo ghɔŋbə bʉə-ŋkɔʼnə-bi bʉ̀ʉ. Mbʉ fɔŋ bʉ́ tʉ mbʉ vaabəke mbɔ, “Bíʼtə fɔkə tʉ mɔ təmiyɔŋ ndə a kʉ̀ʉ, mɔ bu kɔ́ tʉ a.” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Ɔ kàa tʉ ɔŋ mbɔ, “Fɔkə təmiyɔŋ ndə a bíʼtə, mɔ bu kɔ́ tʉ a, bəkɔ i bɛ via-lɔʼɔ-kə ndə mɔ tʉʼ sɔ́ʼ.” <verse eid="MRK 6:23" /><verse number="24" style="v" sid="MRK 6:24" />Mbʉ vaabəke fyú mbi bíʼtə tʉ ŋkwê-i mbɔ, “Bəkɔ mɔ bíʼtə ka?” Ɔ bə̀ŋhə mbɔ, “Bíʼtə tʉ-Jɔŋ-kə ndə ɔ̃ kɔ́ muu.” <verse eid="MRK 6:24" /><verse number="25" style="v" sid="MRK 6:25" />Ɔ nyʉ́ʉ haʼ ndʉʉghɔfii gwè mu njaa gwè gìe tʉ mbʉ fɔŋ mbɔ, “Mɔ nɔ tʉʼ kʉ́ʉ mbɔ ä kɔ́ tʉ-Jɔŋ-kə ndə ɔ̃ kɔ́ muu tʉ mɔ haʼ nduɔnduɔ mu fɔ-kwètə-kəbaa-kə.” <verse eid="MRK 6:25" /><verse number="26" style="v" sid="MRK 6:26" />I chɔ́ŋhə mbʉ fɔŋ daa bɔŋ bʉʼka mbɔ ɔ nɔʼ kə kàa tʉ ɔŋ bəshʉ bʉə-ŋkɔʼnə-bi, təmə ɔ kʉ̀ʉ ndə məbə́ʼ nukə ndə ɔ nɔʼ kə kàa fɛ. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Haʼ ndʉʉmɛ, mbʉ fɔŋ tə́ŋ wo chʉ̀ə kətʉ mbɔ ɔ gɛ̀ gwè nə tʉ-Jɔŋ-kə. Ɔ gɛ̀ chʉ̀ə tʉ-Jɔŋ-kə mu njaa-chaŋ gwè nə yɔŋ. <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />Gwè nə mbʉ kətʉ mu fɔ-kwètə-kəbaa-kə, gwè kɔ́ tʉ mbʉ vaabəke, ɔ kɔ́ tʉ ŋkwê-i. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Ndʉʉ ndə vâafɔʼɔ Jɔŋ kə yʉ́, bɔ̂ŋ gwè lʉ̀ ŋkwê mbʉə-e gɛ̀ tyúu.<verse eid="MRK 6:29" /></para>
  <para style="s">Jiso yúʼ ŋkɔŋ-bʉə-hə itaa</para>
  <para style="r">(<ref loc="MAT 14:13-21">Matia 14:13-21</ref>; <ref loc="LUK 9:10-17">Luk 9:10-17</ref>; <ref loc="JHN 6:1-14">Jɔŋ 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Ndʉʉ ndə mbʉ bəlɔntəŋNyii kə bʉ̀nə gwè tʉ Jiso bɔ̂ŋ núhə nubə tʉ ɔŋ inchəŋ ndə bɔ̂ŋ nɔʼ kə fɔ̀ʼ bɔŋleʼ dàhə. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“B̈ii fyúhə ŋwɔŋ-yii gɛ̀ kəyəŋ-bəliinə, gɛ̀ dùʼ káa məniʼ.”</char> Bʉʼka bʉə buŋmbi nɔ nə kə́ gwètə tʉ bɔŋ bʉ̀nə gɛ̀tə təmə bɔŋ kie ŋgwɔʼmbi ndə mə-buŋ-káa yú fɔbə fɛ. <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />Bɔ̂ŋ fyúhə ŋwɔŋ-yʉə kóʼ mu kəbuu gɛ̀ kəyəŋ-bəliinə. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />Bɔŋ ndʉʉmɛ, bʉə buŋmbi nyíɛ ndə bɔ̂ŋ tʉʼ gɛ̀, chèʼnə bɔŋ, bʉə lɔ̀ hə ndə yəŋkwɛʼtəŋbə inchəŋ nyʉ́ʉ kəwu gɛ̀ dàa chɔ bɔ̂ŋ buŋ gwè. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Ndʉʉ ndə ɔ gɛ̀ dàa ŋgwuu-muu, ɔ nyíɛ nuɔ-bʉə-buŋmbi, tʉkə-i vyíi ndəŋ bɔŋ, bʉʼka bɔ̂ŋ nɔ nə bɛ nə binjyʉʉhə təmə nchyii-yʉə bɛ ghɔ fɛ. Ɔ chʉ́ʉhə mədàhə bɔŋ nə nubə buŋmbi. <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />Ŋgwɔʼmbi kʉ̂ʉ kə́ tíŋ, vâafɔʼɔ-bi gwè tʉ ɔŋ ghɔ̀ŋ mbɔ, “Yɔ̄ŋ-yə nɔ bɛ yəŋ-mu-ŋkɔ-kə nɔ, ŋgwɔʼmbi bɔŋ-nɔʼ-leʼ tíŋ. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />Wɔ̀ʼhə bɔŋ kɔ́ ndə yəŋbə ndə i bɛ mbʉə fɛ̄ŋ leʼnə lɔʼ-bətə̂ŋ-tə, b̈ɔ̂ŋ gɛ̀ nyúɔ fɔbə ndə məyú.” <verse eid="MRK 6:36" /><verse number="37" style="v" sid="MRK 6:37" />Bɔŋ ɔ bə̀ŋhə mbɔ, <char style="wj">“B̈ii kɔ́ fɔbə tʉ bɔŋ, b̈ɔ̂ŋ yú.”</char> Bɔ̂ŋ bíʼtə mbɔ, “B̈aʼa gɛ̀ nyúɔ bele nə kyʉə ndə bəkɔ bə fɔ̀ʼ ndə bəchi fɔ̂ŋ buŋ gwè yúʼ bɔŋ chɔ mɛ?” <verse eid="MRK 6:37" /><verse number="38" style="v" sid="MRK 6:38" />Ɔ bíʼtə tʉ bɔŋ mbɔ, <char style="wj">“Bii kie mbyu-bele-hə isɛʼɛ? B̈ii gɛ̀ lɛ́nə.”</char> Bɔ̂ŋ kʉ̂ʉ gɛ̀ lɛ́nə gwè ghɔ̀ŋ mbɔ, “Nɔ mbyuhə itaa leʼnə mbyu-mbɔʼ-hə ibûu.” <verse eid="MRK 6:38" /><verse number="39" style="v" sid="MRK 6:39" />Ɔ kàhə bɔŋ bənchəŋ ndə mədùʼtə ndəŋ ŋkɔ nchʉʉnchʉʉ tənuɔtənuɔ. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Ndʉʉmɛ, bɔ̂ŋ dùʼtə ndəŋ ŋkɔ ndə nuɔtə təghyʉʉtəghyʉʉ leʼnə wuŋ taa wuŋ taa. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Ɔ kʉ̂ʉ lʉ̀ mbʉ mbyu-bele-hə itaa ghɔŋbə mbʉ mbyu-mbɔʼ-hə ibûu, lɛ́nə yuo, kɔ́ ndɔ, bə́ʼtə, kɔ́ tʉ vâafɔʼɔ-bi mbɔ bɔ̂ŋ gyʉ̀ətə tʉ mbʉ bʉə. Bɔŋleʼ gyʉ̀əhə mbʉ mbyu-mbɔʼ-hə ibûu kətʉ-bɔŋ bənchəŋ. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Bɔ̂ŋ bənchəŋ yú tə yúotə. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />Bɔ̂ŋ lɛ̀ʼtə shyiibə njuɔ bûu nə wuŋ i lə́ŋtə nə kwuʼkwuʼ-bele ghɔŋbə mbʉ mbɔʼ. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Bʉə ndə bɔ̂ŋ kə kwó mbʉ bele nɔ nə bɛ ŋkɔŋ-bələŋ-hə itaa.<verse eid="MRK 6:44" /></para>
  <para style="s">Jiso tòʼ ndəŋ muu</para>
  <para style="r">(<ref loc="MAT 14:22-36">Matia 14:22-36</ref>; <ref loc="JHN 6:15-21">Jɔŋ 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Haʼ ndʉʉmɛ ndə yɔ̄ŋ-yə tíŋ, Jiso téʼ tʉ vâafɔʼɔ-bi bɔ̂ŋ bʉ̀nə kóʼ mu kəbuu, gɛ̀ bəshʉ ndə ibɛʼ-yə via-kətaanə-kəghəŋ-kə, Bɛsieda, ndə ɔ tʉʼ wɔ̀ʼhə mbʉ nuɔ-bʉə b̈ɔ̂ŋ bʉ̀nə gɛ̀tə chu təlɔʼ-bɔŋ. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Bɔŋ ndʉʉ ndə ɔ tíŋhə bɔŋ, ɔ kóʼ gɛ̀ kwɔŋ ndə məgháaNyii.<verse eid="MRK 6:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47" />Kʉ̂ʉ bɛ ndʉʉbuumbi, mbʉ kəbuu ndə vâafɔʼɔ-bi kə bɛ ndəŋ ghɔ kə́ bɛ ntəŋntəŋ muu, Jiso kə́ bɛ njəŋmbi tətɛʼ ɔ. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Ɔ nyíɛ mbɔ bɔ̂ŋ nɔ kə kə́ kɔ̀ɔtəkɔ̀ɔtə buŋ kə́ te mbʉ kəbuu, bʉʼka fʉʉkə nɔ kə́ bə̀ŋhə bɔŋ. Kʉ̂ʉ bɛ ndʉʉ ndə bəŋkʉəʼə-ndʉʉfiimbi tʉʼ tʉʉ, ɔ gwè bìatə bɔŋ, kə́ tòʼ ndəŋ muu. Ɔ kə́ kʉ́ʉ bìa tíŋ mbʉə bɔŋ, <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />bɔŋ ndʉʉ ndə bɔ̂ŋ kə nyíɛ ɔŋ, ɔ kə́ tòʼ ndəŋ muu, bɔ̂ŋ kwɔ̀ʼtə mbɔ la ŋkwusêkə, i chìi bɔ̂ŋ tíitə nə ghʉəʼkə, <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />bʉʼka bɔ̂ŋ bənchəŋ nɔ kə nyíɛ ɔŋ, i fɛ̀ŋhə bɔŋ. Ɔ bɔŋ kwə́ʼ tʉ bɔŋ haʼ ndʉʉmɛ, ghɔ̀ŋ mbɔ, <char style="wj">“B̈ii yá fyiihə-ii, nɔ bɛ mɔ. Kə bii mə leʼ fàa fɛ.”</char> <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Ɔ kóʼ mu mbʉ kəbuu bìatə bɔŋ mbʉ kəfʉʉ tə́nə. I chàa bɔŋ daa, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />bʉʼka bɔ̂ŋ kə kínə nukə ndə məyúʼ mbʉ ŋkɔŋ-bʉə-hə itaa kə bɛ yɔŋ fɛ, i bʉnəleʼ shʉ́əhə fyiihə-ʉə shʉ́əhə.<verse eid="MRK 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Kʉ̂ʉ bɛ ndʉʉ ndə bɔ̂ŋ dàa mbʉ kətaanə-kəghəŋ, bɔ̂ŋ kóʼ mbi lɔʼɔ Gɛnɛsɛlɛ, kɔ́ʼ mbʉ kəbuu ŋgwuu-muu. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Bɔŋ ndʉʉ ndə bɔ̂ŋ kóʼ mu mbʉ kəbuu, bʉə chèʼnə ɔŋ, haʼ ndʉʉmɛ <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />nyʉ́ʉ wɔ̀ʼnə mbʉ mu kəyəŋ inchəŋ, chʉ́ʉhə kə́ bɛ̀ʼ bʉə-bəyɔʼ ndəŋ mbyuubə-ʉə gɛ̀ nə bɔŋ ndə yəŋkə təmiyɔŋ ndə bɔ̂ŋ yʉ́ mbɔ ɔ bɛ chɔ. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Bɔŋ yəŋkə təmiyɔŋ ndə ɔ gwè chɔ kə bɛ mu lɔʼɔ, kə bɛ mu kəyəŋkwɛʼtəŋ, kə bɛ mu ntəʼhə, bɔ̂ŋ gwè nə bʉə-bəyɔʼ ndə yəŋ-vyii-bə, kə́ fʉ̀ʉtə ɔŋ mbɔ b̈ɔ̂ŋ buŋ kə̀ŋ bə haʼ tiɛŋ-ndyi-i. Bɔŋ bʉə bənchəŋ ndə bɔ̂ŋ kə̀ŋtə, i chìi bɔŋ kie nchʉʼ.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">Nuʼ-lɔʼɔ ghɔŋ nuʼ-Nyii</para>
  <para style="r">(<ref loc="MAT 15:1-9">Matia 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Ndʉʉ ndə bʉə-Falasi chə̀ŋtə mbʉə ɔ, ghɔŋbə bəbɛʼbʉə dàhə nuʼ-Mushi ndə bɔ̂ŋ gwè hə Jɛlosalɛŋ, <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />bɔ̂ŋ nyíɛ ndə vâafɔʼɔ-bi-bɛʼbə tʉʼ yú fɔbə təmə nɔʼ búu ŋwɔŋ-yʉə ndə məsʉ̀ ghɔkə-ʉə fɛ. <verse eid="MRK 7:2" /><verse number="3" style="v" sid="MRK 7:3" />Bʉʼka bʉə-Falasi ghɔŋbə bʉə-Juu bənchəŋ kyinə yú fɔbə təmə nɔʼ búu ŋwɔŋ-yʉə, ndə mətʉ́ʼ nuʼ bəntəŋbəshʉ fɛ. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Bɔ̂ŋ kə́ chìi haʼ nɔ, ndʉʉ ndə bɔ̂ŋ bʉ̀nə bəyəŋ vyii nɔ, bɔ̂ŋ búu ŋwɔŋ-yʉə ndə məsʉ̀ ghɔkə-ʉə buŋ yú fɔkə. Bəbɛʼbə ntɛ-nuʼ-hə nɔ nə bɛ ghɔ buŋmbi ndə bɔ̂ŋ kə́ búu, nuʼ ndə məsʉ̀ ndʉʉhə, sʉ̀ kyʉʉtə, sʉ̀ bɔʼ-kətəŋ-bə leʼnə fɔŋbə.<note caller="+" style="f"><char style="fr" closed="false">7:4 </char><char style="ft" closed="false">Bəbɛʼbəŋwɔʼnə kəŋgie-Gili kie </char><char style="it">fɔŋbə</char> chɔ fɛ.</note> <verse eid="MRK 7:4" /><verse number="5" style="v" sid="MRK 7:5" />Bəbɛʼbə bʉə-Falasi ghɔŋbə bʉə dàhə nuʼ-Mushi bíʼtə mbɔ, “Chìi ka təmə vâafɔʼɔ-ba kə́ tʉ́ʼ nuʼ bəntəŋbəshʉ, bɔŋ bɔ̂ŋ kə́ yú fɔbə təmə nɔʼ búu ŋwɔŋ-yʉə fɛ.” <verse eid="MRK 7:5" /><verse number="6" style="v" sid="MRK 7:6" />Jiso bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“Adaya nɔ kə gìe i kʉ̀ʼnə te bii ndə ɔ kə téʼ ntəŋ ndə i kə gwè hə kəghɔ-Nyii te bii, bʉə làhə shʉ mu ŋwɔʼnə-i ndə ɔ kə nyɔ̀ʼ mbɔ,</char></para>
  <para style="q1" vid="MRK 7:6">
    <char style="wj">‘Bʉə-bɔ̄ŋ nɔ tʉʼ lə̀ʼtə mɔ nə wuochubə-ʉə,</char></para>
  <para style="q2" vid="MRK 7:6">
    <char style="wj">bɔŋ fyiihə-ʉə dɔ̀ŋnə mbʉə mɔ,</char><verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />
    <char style="wj">Bɔ̂ŋ nɔ tʉʼ lə̀ʼtə mɔ njʉnjʉ,</char></para>
  <para style="q2" vid="MRK 7:7">
    <char style="wj">bʉʼka bɔ̂ŋ nɔ tʉʼ dàhə nuʼ-bʉəməsʉʉ, fi nə bɛ nuʼ-Nyii.’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">7:7 </char>
      <char style="ft" closed="false">Adaya 29:13.</char>
    </note><verse eid="MRK 7:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MRK 7:8" />
    <char style="wj">Bii nɔ mɛ̀ʼtə nuʼ-Nyii yá bə nuʼ-bʉəməsʉʉ tə́nə chɔ.”</char><verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />Ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Bii nɔ kie ndaa ndə mətʉ́ʉhə nuʼ-Nyii tʉ́ʼ bɔ̌ŋ, lʉ̀ nuʼ-lɔʼɔ-yii tʉ́ʼ bəshʉ.</char> <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" /><char style="wj">Bʉʼka Mushi nɔ nə kàhə mbɔ, ‘Kɔ́ kuŋhə tʉ naa-aŋ ghɔŋ tie-a’ bɔŋleʼ kàhə mbɔ, ‘Wotəmiyɔŋ ndə ɔ gìe nu-bʉə-kə kətʉ tie-e byuunɔ kətʉ ŋkwê-i nɔ kie ndə məkwú.’</char> <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" /><char style="wj">Bii bɔŋ tʉʼ dàhə mbɔ kaʼ wo gìe tʉ tie-e byuunɔ ŋkwê-i mbɔ, ‘Fɔkə ndə mɔ kie ndə məkɔ́ tʉ a nɔʼ Kubaŋ’ (ndə i bɛ mbɔ nɔ yi-Nyii-yə),</char> <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" /><char style="wj">ndʉʉmɛ bii bɛ́ŋ kɔ́ tʉ ɔŋ mbɔ ɔ nɔ chìi i kʉ̀ʼnə mbɔ ɔ mə kwáa tie-e byuunɔ ŋkwê-i fɛ,</char> <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" /><char style="wj">kə́ chìi haʼ nɔ, bʉ́əhə ŋgieNyiikə nə nuʼ ndə i tʉʼ lɔ̀ hə chu dàa chu. Bəbɛʼnubə nɔ ghɔ buŋmbi ndə bii tʉʼ chìi haʼ nɔ.”</char><verse eid="MRK 7:13" /></para>
  <para style="s">Nukə ndə i bʉ́əhə wo</para>
  <para style="r">(<ref loc="MAT 15:10-20">Matia 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Jiso bìʼ tíi mbʉ bʉə mbʉə ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“B̈ii bənchəŋ yʉ́ chʉʼ kínə,</char> <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" /><char style="wj">fɔbɛʼkə kaa ghɔ ndə kaʼ i lɔ̀ hə njəŋmbi ŋíi mu mbʉə-a i bʉ́əhə a fɛ, bɔŋ nɔ bɛ fɔkə ndə ĩ fyú hə mu mbʉə-a ndə i bʉ́əhə a.”</char> <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" /><char style="wj">[“Kaʼ wotəmiyɔŋ kie tyunəkə, ɔ̈ yʉ́.”]</char><verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />Ndʉʉ ndə ɔ sʉ́ʉ mu njaa mɛ̀ʼtə mbʉ bʉə mbi, mbʉ vâafɔʼɔ-bi bíʼtə nukə tʉ ɔŋ ndə mbʉ kəchəŋ bɛ yɔŋ. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Jiso bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“I dʉ̀ʼ mbɔ mbəŋ-yii kínə ghɔ fɛ mɛ? Bii kínə mbɔ fɔkə təmiyɔŋ ndə ĩ sʉ́ʉ mu bətɔ wo lɔ̀ hə njəŋmbi mə bʉ́əhə ɔŋ fɛ,</char> <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" /><char style="wj">bʉʼka mbɔ i tʉʼ sʉ́ʉ mu fyii-ɔ fɛ, i nɔ tʉʼ sʉ́ʉ bə mu bətɔ-ɔ, ɔ nɔ́ kəbu fe?”</char> Ndʉʉ ndə ɔ gìe yɔ̄ŋ-yə, i dʉ̀ʼ mbɔ fɔyubə inchəŋ nɔ bʉ̀ʉ ndə məyú. <verse eid="MRK 7:19" /><verse number="20" style="v" sid="MRK 7:20" />Bɔŋ ɔ ghɔ̀ŋ mbɔ, <char style="wj">“Nɔ bɛ fɔkə ndə ĩ fyú hə mu mbʉə wo ndə i bʉ́əhə ɔŋ.</char> <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" /><char style="wj">Bʉʼka mu f̃yii-wo nɔ fyúhə fɔbə nə, bəŋkwɔʼtə bʉəbʉə, bəsəŋ ntɛntɛhə, lʉʼbə, məyí wo,</char> <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" /><char style="wj">bəsəŋ, ntɔmə, buuŋbʉə, fə́ʼhə, ŋkwɔʼtə-bəsəŋ, məbàabʉʉ, məbʉ́əhə-yie, tʉʉ gʉənə, bənɔ̌ʼɔ.</char> <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" /><char style="wj">Ñu-bʉəbʉə-bə-ɔ̄ŋ inchəŋ nɔ fyú hə mu fyii-wo, i bʉ́əhə mbʉ wo.”</char><verse eid="MRK 7:23" /></para>
  <para style="s">Məmɔʼfyii-woke ndə ɔ gòʼ təmə bɛ woke Juu fɛ ndəŋ Nyii</para>
  <para style="r">(<ref loc="MAT 15:21-28">Matia 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Jiso kʉ̂ʉ lɔ̀ hə chɔ gɛ̀ mu bie Taa ghɔŋ Sidɔŋ<note caller="+" style="f"><char style="fr" closed="false">7:24 </char><char style="ft" closed="false">Bəbɛʼbəŋwɔʼnə kəŋgie-Gili bìʼ </char><char style="it">Sidɔŋ</char> chɔ fɛ.</note>. Ɔ gɛ̀ sʉ́ʉ mu njaabɛʼ təmə kʉ̀ʉ mbɔ wo kínə fɛ, bɔŋ líi kəŋkaa. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Bɔŋ haʼ ndʉʉmɛ, wokebɛʼ ndə lyʉʉhənyaatəkə bɛ mu mbʉə vaa-ɛ vaabəke tîetîe yʉ́ mbɔ ɔ nɔʼ gwè, ɔ gwè gwù bəshʉ ɔ. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Woke-ghɔ̄ kə bɛ woke Juu fɛ, bə nɔ nə bí ɔ Fɔnishia mu Silia. Ɔ fʉ̀ʉtə Jiso mbɔ ɔ̈ jə̀ŋ mbʉ kəlyʉʉhəbʉəbʉə hə mu mbʉ vaa-ɛ. <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />Ɔ bə̀ŋhə tʉ ɔŋ mbɔ, <char style="wj">“N̈ɔʼ vâambuɔ yú yuo ŋkəŋ, bʉʼka i kʉ̀ʼnə ndə məlʉ̀ fɔyu-vaambuɔ-bə mɛ̀ʼ tʉ bûhə fɛ.”</char> <verse eid="MRK 7:27" /><verse number="28" style="v" sid="MRK 7:28" />Bɔŋ ɔ bə̀ŋhə mbɔ, “Ɔŋ, Tiekətʉ, bɔŋ bɛ le, b̃ûhə ndə bɔ̂ŋ nʉ̀ʉ tɔʼɔ tebele nɔ lɛ̀ʼtə kwuʼkwuʼ-bəfɔ ndə i tʉʼ gwùtə kəghɔ-vâambuɔ.” <verse eid="MRK 7:28" /><verse number="29" style="v" sid="MRK 7:29" />Jiso ghɔ̀ŋ tʉ ɔŋ mbɔ, <char style="wj">“Bʉʼka ŋgiekə-ɔ̄ŋ, gɛ̀ nə wa, mbʉ kəlyʉʉhəbʉəbʉə nɔʼ fyú hə mbʉə vaa-a.”</char> <verse eid="MRK 7:29" /><verse number="30" style="v" sid="MRK 7:30" />Ɔ bʉ̀nə gɛ̀ chunjaa nyíɛ mbʉ vaa, ɔ kə nʉ̀ʉ ndəŋ kəbɔ tʉ mbʉ kəlyʉʉhəbʉəbʉə nɔʼ gɛ̀ nə wi.<verse eid="MRK 7:30" /></para>
  <para style="s">Jiso chʉ́ʼ wobɛʼ ndə ɔ bɛ chie bɔŋ-kə́-leʼ bɛ fʉ̀əŋtə bətyunə</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Ndʉʉ ndə Jiso kə bʉ̀nə mu bie Taa, ɔ tíŋ hə mu Sidɔŋ gɛ̀ dàa chu-kətaanə-kəghəŋ-Galili, ndə i bɛ mu bie Dɛkaboli ndə i bɛ mbɔ Yəŋkwɛʼtəŋbə Wuŋ. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Bə gwè nə wobɛʼ tʉ ɔŋ ndə ɔ bɛ fʉ̀əŋtə bətyunə, ɔ bɔŋleʼ kə́ kwə́ʼ kəŋkaa. Bɔ̂ŋ fʉ̀ʉtə ɔŋ mbɔ ɔ̈ mɔ̀ʼ ghɔkə-i ndəŋ ɔŋ. <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />Ɔ kʉ̂ʉ lʉ̀ ɔ fyúhə ɔŋ mu bʉə gɛ̀ bɔ̌ŋ, sʉ́ʉhə vâabəghɔ-bi bətyunə-ɔŋ, tyù ntɛmə kə̀ŋ lɛɛŋhəkə-i chɔ. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Ndʉʉ ndə ɔ lɛ́nə yuo, ɔ sɔ́ŋ ghɔ̀ŋ mbɔ, <char style="wj">“Ɛfata,”</char> ndə i bɛ mbɔ, <char style="wj">“Ŋɔ́ʼnə.”</char> <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />Tyunəbə-i ŋɔ́ʼnə, lɛɛŋhəkə-i yɔ̀ʼnə, ɔ chʉ́ʉhə kə́ kwə́ʼ jyujyu. <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />Jiso kàhə bɔŋ mbɔ bɔ̂ŋ mə shyíi wo fɛ. Bɔŋ ndə ɔ tʉʼ kàhə mbɔ b̈ɔ̂ŋ mə shyíi wo fɛ, bɔ̂ŋ kə́ bìʼ lɔ̀ʼlɔ̀ʼ gɛ̀. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />I chàa bɔ̂ŋ tə daa, bɔ̂ŋ kə́ ghɔ̀ŋ mbɔ, “Ɔ nɔʼ fɔ̀ʼ nubə inchəŋ i bɛ jyujyu. I bɛ tə ɔ chìi bəfʉ̀əŋtə bətyunə bɔ̂ŋ kə́ yʉ́ nukə bɔŋleʼ chìi bəchie bɔ̂ŋ kə́ kwə́ʼ.”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">Jiso yúʼ ŋkɔŋ-bʉə-hə kwi</para>
  <para style="r">(<ref loc="MAT 15:32-39">Matia 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Kʉ̂ʉ bɛ mu bəchî-ghɔ̄ ndʉʉ ndə nuɔ-bʉə-buŋmbi bìʼ chə̀ŋtə, təmə kie fɔkə ndə məyú fɛ, Jiso tíi vâafɔʼɔ-bi ghɔ̀ŋ tʉ bɔŋ mbɔ, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" /><char style="wj">“Tʉkə-ɔŋ nɔ tʉʼ vyíi ndəŋ nuɔ bʉə-bɔ̄ŋ, bʉʼka bɔ̂ŋ nɔʼ bɛ baʼa bɔŋ ndə chîbə itia təmə kie fɔkə ndə məyú fɛ.</char> <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" /><char style="wj">Kaʼ mɔ téʼ mbɔ b̈ɔ̂ŋ bʉ̀nə chu-təlɔʼ-bɔŋ nə jyʉʉ, bɔ̂ŋ fyú gwùtə sêfia. Bɔŋ bəbɛʼbə mu bɔŋ nɔ lɔ̀ hə dɔdɔ.”</char> <verse eid="MRK 8:3" /><verse number="4" style="v" sid="MRK 8:4" />Vâafɔʼɔ-bi bə̀ŋhə tʉ ɔŋ mbɔ, “Bəkɔ wo kie fɔyubə fa muŋkɔ fɛ̄ŋ ndə məyúʼ ntyʉʉ bʉə-bɔ̄ŋ?” <verse eid="MRK 8:4" /><verse number="5" style="v" sid="MRK 8:5" />Ɔ bíʼtə tʉ bɔŋ mbɔ, <char style="wj">“Bii kie mbyu-bele-hə isɛʼɛ?”</char></para>
  <para style="p" vid="MRK 8:5">Bɔ̂ŋ bə̀ŋhə mbɔ, “Təkwiitia.”<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />Ɔ téʼ tʉ mbʉ nuɔ-bʉə mbɔ b̈ɔ̂ŋ dùʼtə sê. Ɔ kʉ̂ʉ lʉ̀ mbʉ mbyu-bele-hə təkwiitia, kɔ́ ndɔ chɔ, bə́ʼtə mbʉ bele kɔ́ tʉ vâafɔʼɔ-bi mbɔ bɔ̂ŋ gɛ̀ gyʉ̀ətə tʉ mbʉ bʉə, bɔ̂ŋ gɛ̀ gyʉətə tʉ bɔŋ. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Bɔ̂ŋ kie mbyu-mbɔʼ-hə məniʼ, ɔ kʉ̂ʉ kɔ́ ndɔ chɔ tʉ Nyii, téʼ tʉ bɔŋ mbɔ b̈ɔ̂ŋ gɛ̀ tʉ́ʼtə bəshʉ bɔŋ. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Bɔ̂ŋ yú tə yúotə, mbʉ vâafɔʼɔ bʉ̀nə byíi kwuʼkwuʼ-i, i lə́ŋ shyiibə təkwiitia. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Bʉə nɔ nə bɛ chɔ tə kə́ gɛ̀ nə ŋkɔŋ-bʉə-hə kwi. Ɔ téʼ mbɔ b̈ɔ̂ŋ gɛ̀ nə wʉə. <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />Haʼ ndʉʉmɛ, ɔ kóʼ mu kəbuu ghɔŋbə vâafɔʼɔ-bi gɛ̀ mu bie Damanuta.<verse eid="MRK 8:10" /></para>
  <para style="s">Bʉə-Falasi kə́ kʉ́ʉ ndə mənyíɛ nukəcheʼkə</para>
  <para style="r">(<ref loc="MAT 16:1-4">Matia 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />Bʉə-Falasi gwè chʉ́ʉhə mətúŋ bəŋʉʉ ghɔŋbə Jiso, kə́ bíʼtə tʉ ɔŋ mbɔ ɔ̈ chìi nukəcheʼkə ndə i lɔ̀ hə kəghɔ-Nyii. Bɔ̂ŋ nɔ kə chìi yɔ̄ŋ-yə ndə məmùutə ɔŋ, <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />Ɔ sɔ́ŋ shʉ́əshʉ́ə mu fyii-ɔ ghɔ̀ŋ mbɔ, <char style="wj">“Chìi ka ŋgwie-wo-ɔ̄ kə́ kʉ́ʉ cheʼkə? Ndə shʉəŋ nɔʼ m̈ɔ shyíi bii mbɔ bə kʉʉ dʉ̀ʼ cheʼkə tʉ ŋgwie-wo-ɔ̄ fɛ.”</char> <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />Ndʉʉmɛ, ɔ mɛ̀ʼtə bɔŋ bìʼ kóʼ mu kəbuu dàa gɛ̀ ndəŋ ibɛʼ-yə via-muu-kə.<verse eid="MRK 8:13" /></para>
  <para style="s">Yî-bʉə-Falasi ghɔŋbə Hɛlo</para>
  <para style="r">(<ref loc="MAT 16:5-12">Matia 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Ndʉʉmɛ, tʉ vâafɔʼɔ-bi nɔʼ kə lèʼnə ndə məlʉ̀ bele, kie haʼ mbyu bele imɔʼ mu kəbuu. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />Ɔ shyùu tyunəkə-ʉə ghɔ̀ŋ mbɔ, <char style="wj">“B̈ii láa, kə́ lɛ́nə jyujyu te yî-bʉə-Falasi ghɔŋbə yî Hɛlo.”</char><verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />Bɔ̂ŋ chʉ́ʉhə kə́ kwə́ʼ mu bɔŋ kə́ ghɔ̀ŋ mbɔ ɔ la tʉʼ ghɔ̀ŋ yɔ̄ŋ-yə bʉʼka mbɔ bɔ̂ŋ la kə lʉ̀ bele fɛ. <verse eid="MRK 8:16" /><verse number="17" style="v" sid="MRK 8:17" />Jiso kə́ kínə nukə ndə bɔ̂ŋ kə́ gìe, ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Chìi ka bii kə́ kwə́ʼ mbɔ bii kie bele fɛ? Bii chʉʼ nyíɛ chèʼnə fe? Bii bíe shʉ́əhə haʼ fyiihə-ii mɛ?</char> <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" /><char style="wj">‘Bii kie shʉ təmə kə́ nyíɛ fɛ mɛ? Bii kie tyunəbə təmə kə́ yʉ́ fɛ mɛ? Bii kyi kwɛ́nə nukə fe?’</char> <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" /><char style="wj">Ndʉʉ ndə mɔ kə bə́ʼtə mbyu-bele-hə itaa yúʼ ŋkɔŋ-bʉə-hə chɔ itaa le, bii kə byíi kwuʼkwuʼ-i, i lə́ŋ shyiibə isɛʼɛ?”</char> Bɔ̂ŋ bə̀ŋhə mbɔ, “Shyiibə njuɔ bûu nə wuŋ.”<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />
    <char style="wj">“Mɔ kə bə́ʼtə mbyu-bele-hə təkwiitia tʉ ŋkɔŋ-bʉə-hə kwi le, bii byíi kwuʼkwuʼ-i, i lə́ŋ shyiibə isɛʼɛ?”</char> Bɔ̂ŋ bə̀ŋhə mbɔ, “Təkwiitia.” <verse eid="MRK 8:20" /><verse number="21" style="v" sid="MRK 8:21" />Ndʉʉmɛ, ɔ bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“I bìʼ shʉ́ə tʉ bii ndə məkínə mɛ?”</char><verse eid="MRK 8:21" /></para>
  <para style="s">Jiso chʉ́ʼ fʉ̀əŋtəshʉ</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Ndʉʉ ndə Jiso kə gwè dàa Bɛsieda, bʉəbɛʼbə gwè nə wobɛʼ ndə shʉ-i nɔʼ fʉ̀əŋtə tʉ Jiso, fʉ̀ʉtə ɔŋ mbɔ ɔ̈ kə̀ŋ wo-ghɔ̄. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Ɔ yá kwii mbʉ wo ndə shʉ-i nɔʼ fʉ̀əŋtə le fyú nə nɔŋ mu mbʉ lɔʼɔ, tyù ntɛmə shʉ mbʉ wo-ghɔ̄, mɔ̀ʼ ghɔkə-i ndəŋ ɔŋ bíʼtə mbɔ, <char style="wj">“A nyíɛ fɔkə mɛ?”</char> <verse eid="MRK 8:23" /><verse number="24" style="v" sid="MRK 8:24" />Ɔ chɔ̀ʼhə shʉ-i lɛ́nə ghɔʼ ghɔ̀ŋ mbɔ, “Mɔ nɔ nyíɛ bʉə bɔ̂ŋ kə́ tòʼ nə tyʉbə.” <verse eid="MRK 8:24" /><verse number="25" style="v" sid="MRK 8:25" />Ndʉʉmɛ, Jiso bìʼ mɔ̀ʼ ghɔkə-i shʉ-ɔ, ɔ ŋɔ́ʼhə shʉ-i, shʉ-i tʉ́ʉnə, ɔ kə́ nyíɛ yəŋkə jyujyu, nyíɛ fɔbə inchəŋ jyujyu. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Ɔ téʼ tʉ ɔŋ ɔ gɛ̀ nə wi chunjaa-ɔ, ghɔ̀ŋ mbɔ, <char style="wj">“Kə a mə buŋ tíŋ hə mu lɔʼɔ fɛ.”</char><verse eid="MRK 8:26" /></para>
  <para style="s">Bita ghɔ̀ŋ mbɔ Jiso la bɛ mbʉ Wo ndə Nyii Kùŋ Tə́ŋ</para>
  <para style="r">(<ref loc="MAT 16:13-20">Matia 16:13-20</ref>; <ref loc="LUK 9:18-21">Luk 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Jiso lɔ̀ ghɔŋbə vâafɔʼɔ-bi gɛ̀ mu lɔʼ-bətə̂ŋ-tə ndə i bɛ mbʉə Kasalia Filibai. Ndə bɔ̂ŋ kə́ gɛ̀, ɔ bíʼtə tʉ vâafɔʼɔ-bi mbɔ, <char style="wj">“Bʉə tʉʼ ghɔ̀ŋ mbɔ mɔ bɛ nda?”</char> <verse eid="MRK 8:27" /><verse number="28" style="v" sid="MRK 8:28" />Bɔ̂ŋ gìe tʉ ɔŋ mbɔ, “Jɔŋ ndə ɔ̃ kɔ́ muu, bəbɛʼbə kə́ ghɔ̀ŋ mbɔ a la bɛ Ɛlaja, bəbɛʼbə kə́ ghɔ̀ŋ mbɔ a la bɛ mbyu yʉkəŋgieNyiibɛʼ.” <verse eid="MRK 8:28" /><verse number="29" style="v" sid="MRK 8:29" />Ɔ bíʼtə tʉ bɔŋ mbɔ, <char style="wj">“Bɔŋ bii tʉʼ ghɔ̀ŋ mbɔ mɔ bɛ nda?”</char> Bita bə̀ŋhə mbɔ, “A nɔ bɛ Wo ndə Nyii Kùŋ Tə́ŋ.” <verse eid="MRK 8:29" /><verse number="30" style="v" sid="MRK 8:30" />Ɔ shyùu tyunəkə-ʉə jyujyu mbɔ bɔ̂ŋ mə yi shyíi wo nə yɔŋ fɛ.<verse eid="MRK 8:30" /></para>
  <para style="s">Jiso kwə́ʼ te kwu-i</para>
  <para style="r">(<ref loc="MAT 16:21-28">Matia 16:21-28</ref>; <ref loc="LUK 9:22-27">Luk 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Jiso chʉ́ʉhə mədàhə vâafɔʼɔ-bi mbɔ Vaa-Woməsʉʉ bu yaʼ nyíɛ ŋgʉəʼ ndə nubə buŋmbi, bəntəŋbəshʉ, mbʉ bətiefɛ̀ʼndɛŋNyii leʼnə mbʉ bʉə dàhə nuʼ-Mushi bu tɛ́ŋ ɔŋ, bɔŋleʼ yí ɔ, chîbə kʉ̂ʉ tíŋ itia nɔ ɔ bʉ̀nə kóʼ. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Ndə ɔ kə kə́ kwə́ʼ yɔ̄ŋ-yə, ɔ yɔ̀ʼ tiɛŋ-ɛŋ tʉ bɔŋ, Bita lʉ̀ ɔ ghɔ́ŋ ɔŋ fí ŋwɔŋ-yʉə ɔ bɔ̌ŋ, ɔ chʉ́ʉhə kə́ sɔ́ʼ ɔ. <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />Jiso kʉ̂ʉ kíahə ŋwɔŋ-ɛŋ lɛ́nə vâafɔʼɔ-bi, sɔ́ʼ Bita ghɔ̀ŋ mbɔ, <char style="wj">“Bʉ̀nə bɔ̌ŋ mɔ, Sata! Bʉʼka a tʉ́ʼ ndaahə-a ndəŋ nu-Nyii-bə fɛ, a nɔ tʉ́ʼ bə ndəŋ nu-bʉəməsʉʉ-bə.”</char><verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />Ndʉʉmɛ, ɔ tíi nuɔ-bʉə ghɔŋbə vâafɔʼɔ-bi mbʉə ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Kaʼ wo mu bii kʉ̀ʉ ndə məgwè hə bɔ̌ŋ mɔ, ɔ nɔ kie ndə mətɛ́ŋ ŋwɔŋ-ɛŋ, bɛ̀ʼ tyʉntɔɔnəkə-i, gwè hə bɔ̌ŋ mɔ.</char> <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" /><char style="wj">Bʉʼka wo ndə ɔ kʉ̀ʉ ndə məkwáa ŋkwiitʉ-e bu bɛ́, bɔŋ wo ndə ɔ kɔ́ ŋkwiitʉ-e bʉʼka mɔ ghɔŋbə mbʉ ntəŋjyujyu, bu kie ŋkwiitʉ-e.</char> <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" /><char style="wj">Bəkɔ wo síi ka, kaʼ ɔ kie wʉʉnəmbikə inchəŋ bɔŋ bɛ́ ŋkwiitʉ-e.</char> <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" /><char style="wj">Bɛ ka ndə bəkɔ wo kɔ́ ndə mənyúɔ ŋkwiitʉ-e?</char> <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" /><char style="wj">Bɔŋ wotəmiyɔŋ ndə tʉkə-i tʉʼ vyíi bʉʼka mɔ ghɔŋbə ŋgiekə-ɔŋ mu ŋgwie-bəsəŋ-ɔ̄ŋ ghɔŋbə ŋgwie-bʉ̂ʼʉ-ɔ̄, tʉ-Vaa-Woməsʉʉ-kə bu vyíi te ɔ, ndʉʉ ndə ɔ bu gwè mu məŋwɔʼ Tie-e ghɔŋbə bʉəntəŋNyii ndə bɔ̂ŋ bɛ ŋkʉʉ.”</char><verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Jiso kə́ gɛ̀ nə shʉbə ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“M̈ɔ shyíi bii nə shʉəŋ mbɔ bəbɛʼbʉə mu bii ndə bɔ̂ŋ tə́nə fɛ̄ŋ, kʉʉ yúotə kwú fɛ, tə bɔ̂ŋ yaʼ yi nyíɛ ndə Sɔ́ʼ-Nyii bu gwè nə ghʉəʼkə.”</char><verse eid="MRK 9:1" /></para>
  <para style="s">Jiso fyú mu məŋwɔʼmə-ì</para>
  <para style="r">(<ref loc="MAT 17:1-13">Matia 17:1-13</ref>; <ref loc="LUK 9:28-36">Luk 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />Chîbə kʉ̂ʉ tíŋ ntʉʼʉ Jiso lʉ̀ Bita, Jɛŋ leʼnə Jɔŋ ghɔŋ bɔŋ kóʼ gɛ̀ ndəŋ kwɔŋ ndə i də̀ʼ ghɔʼ, gɛ̀ bɛ chɔ tətɛʼ bɔŋ. Ɔ bə̀ŋ bəshʉ bɔŋ fyú mu məŋwɔʼmə-i. <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />Ndyihə-i fyûʼ tə kə́ lèʼnə təmə wo kəwʉʉnəmbi fɛ̄ŋ mə nə chìi ndyi, i fyûʼ nɔ fɛ. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Ndʉʉmɛ, Ɛlaja fyú ghɔŋ Mushi, kə́ kwə́ʼ ghɔŋbə Jiso. <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />Bita ghɔ̀ŋ tʉ Jiso mbɔ, “Chicha, i nɔ bʉ̀ʉ ndə bâʼa bɛ fɛ̄ŋ nɔ. B̈âʼa fʉ̀ə lɛʼbə itia, imɔʼ tʉ a, imɔʼ tʉ Mushi leʼnə imɔʼ tʉ Ɛlaja.” <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />Ɔ kə kínə nukə ndə ɔ gìe fɛ, bʉʼka i nɔ nə fɛ̀ŋhə bɔŋ daa.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />Ndʉʉmɛ, mbɔʼkə kwóhə bɔŋ, gyʉʉ gìe mu mbʉ kəmbɔʼ mbɔ, “Nɔ bɛ mbʉətə vaa-ɔŋ nɔ ndə mɔ kʉ̀ʉ, b̈ii yʉ́ chu-i.” <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />Bɔŋ kə kwɔnə lɛ́nə təmə leʼ nyíɛ wo fɛ, yaʼkɛŋ Jiso tətɛʼ ɔ. <verse eid="MRK 9:8" /><verse number="9" style="v" sid="MRK 9:9" />Ndə bɔ̂ŋ kə́ shíʼ ndəŋ mbʉ kwɔŋ, ɔ kàhə bɔŋ mbɔ bɔ̂ŋ mə yi shyíi wo nə nukə ndə bɔ̂ŋ nɔʼ nyíɛ fɛ, tə Vaa-Woməsʉʉ yi bʉ̀nə kóʼ hə ndəŋ kwu. <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />Bɔ̂ŋ káa nə nu-ghɔ̄-kə bətɔ-bɔŋ, kə́ bíʼtə tʉ ŋwɔŋtə-ʉə nukə te ndə məbʉnə-kóʼ-ɔ̄ hə ndəŋ kwú bɛ yɔŋ.<verse eid="MRK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11" />Bɔ̂ŋ chʉ́ʉhə kə́ bíʼtə tʉ ɔŋ mbɔ, “Chìi ka bʉə dàhə nuʼ-Mushi kə́ ghɔ̀ŋ mbɔ Ɛlaja kie ndə mə-fəŋ-gwè ŋkəŋ?”<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />Ɔ bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“Ndə shʉəŋ, Ɛlaja nɔ kie ndə mə-fəŋ-gwè shʉ̀tə nubə nchəŋnchəŋ-ɛŋ, i bɛ ndyʉndyʉ ndə ntɛhə ndə i kə bɛ hə bəshʉ. Bə bɔŋ nyɔ̀ʼ mu ŋwɔʼnə-Nyii bʉʼka ka ndʉʉmɛ mbɔ Vaa-Woməsʉʉ bu yaʼ nyíɛ ŋgʉəʼ ndə nubə buŋmbi, bə tɛ́ŋ ɔŋ?</char> <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" /><char style="wj">Nɔʼ m̈ɔ bɔŋ shyíi bii mbɔ Ɛlaja nɔ kə gwè, bɔ̂ŋ fɔ̀ʼ nə nɔŋ ndə bɔ̂ŋ kʉ̀ʉ, haʼ ndə bə kə nyɔ̀ʼ mu ŋwɔʼnə-Nyii te ɔ.”</char><verse eid="MRK 9:13" /></para>
  <para style="s">Jiso chʉ́ʼ vaabələŋ ndə ɔ kie lyʉʉhəbʉəbʉəkə mu mbʉə-ɔ</para>
  <para style="r">(<ref loc="MAT 17:14-19">Matia 17:14-19</ref>; <ref loc="LUK 9:37-43">Luk 9:37-43</ref>a)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Ndʉʉ ndə bɔ̂ŋ kə gwè bìatə bəbɛʼbə vâafɔʼɔ-bʉə, bɔ̂ŋ nyíɛ nuɔ-bʉə-buŋmbi yə̀ŋhə bɔŋ fúu, bʉə dàhə nuʼ-Mushi kə́ túŋ bəŋʉʉ ghɔŋ bɔŋ. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Ndʉʉ ndə mbʉ nuɔ-bʉə bənchəŋ kə nyíɛ Jiso, i chàa bɔŋ daa, bɔ̂ŋ nyʉ́ʉ gɛ̀ mbʉə ɔ, gɛ̀ gìe tʉ ɔŋ. <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />Ɔ bíʼtə tʉ bɔŋ mbɔ, <char style="wj">“Bii tʉʼ túŋ bəŋʉʉ ka bii bɔŋ?”</char><verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />Wobɛʼ mu mbʉ nuɔ-bʉə bə̀ŋhə mbɔ, “Chicha, mɔ nɔ gwè nə vaa-ɔŋ tʉ a, bʉʼka ɔ nɔ kie lyʉʉhəbʉəbʉəkə ndə i nɔʼ chìi təmə ɔ kə́ leʼ kwə́ʼ fɛ. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Ndʉʉtəmiyɔŋ ndə i yá ɔ nɔ, i mɔ̀ʼ ɔ sê, lukə fyùʼ chu-ɔ, ɔ kwó gyʉəʼə-ɛ, mbʉə-e tɛ̀nə. Mɔ nɔʼ fʉ̀ʉtə vâafɔʼɔ-ba mbɔ b̈ɔ̂ŋ jə̀ŋ ɔŋ, bɔŋ bɔ̂ŋ mùutə kəŋkaa.” <verse eid="MRK 9:18" /><verse number="19" style="v" sid="MRK 9:19" />Ɔ bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“Oo ŋgwie-bʉə ndə bɔ̂ŋ gòʼ təmə mɔ̀ʼfyiihə-ʉə ndəŋ mɔ fɛ, mɔ kie ndə məbɛ bʉʼʉ ntyʉʉ təka? Mɔ kie ndə məyá fyii-ɔ te nə bii ntyʉʉ təka? B̈ii gwè nə ɔŋ tʉ mɔ.”</char> <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />Bɔ̂ŋ gwè nə mbʉ vaa tʉ ɔŋ. Ndʉʉ ndə mbʉ kəlyʉʉhəbʉəbʉə nyíɛ ɔŋ, ɔ mɔ̀ʼ mbʉ vaa sê ndəŋ ŋgɛŋ haʼ ndʉʉmɛ, ɔ gwù sê kə́ kíatə, lukə kə́ fyùʼ chu-ɔ. <verse eid="MRK 9:20" /><verse number="21" style="v" sid="MRK 9:21" />Jiso bíʼtə tʉ tie-e mbɔ, <char style="wj">“I nɔʼ chìi nə nɔŋ mənɔ ntyʉʉ təka?”</char> Ɔ bə̀ŋhə mbɔ, “Lʉ̀ hə vaambuɔ. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />Ĩ bɔŋ-nɔ-leʼ chʉʼ mɔ̀ʼ ɔ mu viʼi leʼnə mu muu ndə məyí ɔ. Bɔŋ kaʼ bɛ mbɔ bəkɔ a chìi nukə, ẗʉkə-a vyíi ndəŋ baʼa, ä kwáa baʼa.”<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />Jiso bə̀ŋhə mbɔ, <char style="wj">“Məghɔ̀ŋ mbɔ, ‘Kaʼ bɛ mbɔ bəkɔ a chìi nukə’? Bəkɔ nubə inchəŋ tòʼ kaʼ wo bɛ́ŋ Nyii.”</char><verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />Haʼ ndʉʉmɛ, mbʉ tie-vaa tíi nə ghʉəʼkə<note caller="+" style="f"><char style="fr" closed="false">9:24 </char><char style="ft" closed="false">Bəbɛʼbəŋwɔʼnə kəŋgie-Gili nɔ bìʼ </char><char style="it">tə shʉmə fyú shʉ-ɔ.</char></note> ghɔ̀ŋ mbɔ, “Mɔ nɔ bɛ́ŋ, kwáa mɔ təmə mɔ kə́ jínə fɛ!”<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />Bɔŋ ndʉʉ ndə Jiso nyíɛ mbɔ nuɔ-bʉə kə́ nyʉ́ʉ ndʉʉ ntyuu, ɔ sɔ́ʼ mbʉ kəlyʉʉhənyaatə kə́ ghɔ̀ŋ mbɔ, <char style="wj">“Mbəŋ-aŋ, lyʉʉhəkə ndə ɔ chìi wo ɔ bə̀ŋ chie bɔŋleʼ fʉ̀əŋtə tyunəbə-i, mɔ nɔ tʉʼ kàhə a, fyú hə mbʉə-ɔ, kə a mə leʼnə bìʼ sʉ́ʉ fɛ.”</char> <verse eid="MRK 9:25" /><verse number="26" style="v" sid="MRK 9:26" />Ndʉʉmɛ, ndə mbʉ kəlyʉʉhə tíi, mɔ̀ʼ ɔ sê ndə ŋgɛŋ shʉ́əshʉ́ə, fyú hə mbʉə-ɔ, mbʉ vaa-ghɔ̄ bɛ nə ŋkwu-wo-kə, i chìi bʉə buŋmbi ghɔ̀ŋ mbɔ ɔ la nɔʼ kwú. <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Bɔŋ Jiso yá kwii-i chɔ̀ʼhə ɔŋ ghɔʼ, ɔ lɔ̀ hə sê.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />Ndʉʉ ndə ɔ ŋíi mu njaa, vâafɔʼɔ-bi gwè bíʼtə tʉ ɔŋ bɔ̌ŋbɔ̌ŋ mbɔ, “Chìi ka baʼa jə̀ŋ ɔŋ kəŋkaa?” <verse eid="MRK 9:28" /><verse number="29" style="v" sid="MRK 9:29" />Ɔ bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“Bəkɔ fɔkə mə fyúhə ntɛ yɔ̄ŋ-yə fɛ, yaʼkɛŋ nə məgháaNyii.”</char> <note caller="+" style="f"><char style="fr" closed="false">9:29 </char><char style="ft" closed="false">Bəbɛʼbəŋwɔʼnə kəŋgie-Gili nɔ bìʼ </char><char style="it">məjì muu.</char></note><verse eid="MRK 9:29" /></para>
  <para style="s">Jiso bìʼ kwə́ʼ te kwu-i</para>
  <para style="r">(<ref loc="MAT 17:22-23">Matia 17:22-23</ref>; <ref loc="LUK 9:43-45">Luk 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Bɔ̂ŋ lɔ̀ hə chɔ tíŋ hə mu Galili, təmə ɔ kʉ̀ʉ mbɔ wo kínə fɛ, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />bʉʼka ɔ nɔ kə́ dàhə vâafɔʼɔ-bi, ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Bə bu chɔ̀ʼhə Vaa-Woməsʉʉ kɔ́ mu kəghɔ-bʉə-məsʉʉ, bɔ̂ŋ yi ɔ. Ndʉʉ ndə bə bu yi ɔ, chîbə kʉ̂ʉ tíŋ itia nɔ ɔ bʉ̀nə kóʼ.”</char> <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />Bɔŋ təmə bɔ̂ŋ kínə nukə ndə ɔ kə́ gìe fɛ, bɔ̂ŋ fàa ndə məbíʼtə.<verse eid="MRK 9:32" /></para>
  <para style="s">Bu bɛ nda bɛ wokwɛʼtəŋ?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Matia 18:1-5</ref>; <ref loc="LUK 9:46-48">Luk 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />Ndʉʉ ndə bɔ̂ŋ dàa Kabanu, kʉ̂ʉ bɛ ndʉʉ ndə ɔ bɛ mu njaa, ɔ bíʼtə tʉ bɔŋ mbɔ, <char style="wj">“Bii kə kə́ túŋ bəŋʉʉ ndə ka sêfia?”</char> <verse eid="MRK 9:33" /><verse number="34" style="v" sid="MRK 9:34" />Təmə bɔ̂ŋ bə̀ŋhə fɛ, bʉʼka bɔ̂ŋ nɔ kə kə́ túŋ bəŋʉʉ mu bɔŋ te nə wo ndə ɔ bɛ fɔŋ wokwɛʼtəŋ. <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />Ɔ dùʼ sê tíi mbʉ vâafɔʼɔ njuɔ bûu nə wuŋ, ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Kaʼ wotəmiyɔŋ kə́ kʉ́ʉ bɛ fəŋ, ɔ nɔ kie ndə məbɛ ndyiʼtəkə mu bʉə bənchəŋ, bɔŋleʼ bɛ vaafɔ̀ʼ tʉ bʉə bənchəŋ.”</char> <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />Ɔ lʉ̀ vaambuɔ tîetîe tʉ́ʼ ɔ ntəŋntəŋ bɔŋ, kʉ̂ʉ chɔ̀ʼhə mbʉ vaa ghɔʼ ndəŋ kwiitə-i, ghɔ̀ŋ tʉ bɔŋ mbɔ, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" /><char style="wj">“Wotəmiyɔŋ ndə ɔ lʉ̀ vaambuɔ nə yɔ̄ŋ-yə yie-mɔ, nɔ lʉ̀ mɔ, bɔŋ wotəmiyɔŋ ndə ɔ leʼ lʉ̀ mɔ, lʉ̀ bə mɔ fɛ, ɔ nɔ lʉ̀ wo ndə ɔ tə́ŋ mɔ.”</char><verse eid="MRK 9:37" /></para>
  <para style="s">Wo ndə ɔ gòʼ təmə tɛ́ŋ bʉʼʉ fɛ nɔ bɛ kəvia-bʉʼʉ</para>
  <para style="r">(<ref loc="LUK 9:49-50">Luk 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Jɔŋ ghɔ̀ŋ tʉ Jiso mbɔ, “Chicha, baʼa nɔ nyíɛ wobɛʼ, ɔ kə́ jə̀ŋ lyʉʉhəbʉəbʉəbə nə yie-a, baʼa kə́ kɔ̀ɔtə ndə məkɔ́tuu tʉ ɔŋ, bʉʼka ɔ kaa wo nuɔ-yʉʼʉ fɛ.” <verse eid="MRK 9:38" /><verse number="39" style="v" sid="MRK 9:39" />Bɔŋ Jiso bə̀ŋhə mbɔ, <char style="wj">“Kə bii mə kɔ́tuu tʉ ɔŋ fɛ, bʉʼka wo kaa ghɔ ndə ɔ tʉʼ fɔ̀ʼ nu-shʉ́əshʉ́ə-bə yie-mɔ ndə bəkɔ ɔ chʉʼ tíi yie-ɔ bʉəbʉə fɛ.</char> <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" /><char style="wj">Bʉʼka mbɔ wo ndə ɔ gòʼ təmə tɛ́ŋ bʉʼʉ fɛ, nɔ bɛ kəvia-bʉʼʉ.</char> <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" /><char style="wj">Bʉʼka ndə ŋgie-shʉəŋ-kə, m̈ɔ shyíi bii mbɔ wotəmiyɔŋ ndə ɔ kɔ́ ndʉ̂ʉ muu tʉ bii ndə mənú bʉʼka Wo ndə Nyii Kùŋ Tə́ŋ, mə bɛ́ kɛŋbə-i fɛ.</char><verse eid="MRK 9:41" /></para>
  <para style="s">Məmùutə wo mbɔ ɔ gwù mu bʉ̂ʼʉ</para>
  <para style="r">(<ref loc="MAT 18:6-9">Matia 18:6-9</ref>; <ref loc="LUK 17:1-2">Luk 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />
    <char style="wj">“Wotəmiyɔŋ ndə ɔ chìi mbyu vaambuɔ tîetîe hə mu vâa-bɔ̄ŋ ndə bɔ̂ŋ bɛ́ŋ mɔ, gwù mu nubə ndə ĩ chìi wo chìi bʉ̂ʼʉ, nɔ bʉ̀ʉ mbɔ b̈ə chyúu lɔkɔʼ tê mii-ɔ, mɛ̀ʼ ɔŋ mu muukwɛʼtəŋmə.</char> <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" /><char style="wj">Bɔŋ kaʼ ghɔkə-a chìi a chìi bʉ̂ʼʉ, ä chʉ̀ə fyúhə mɛ̀ʼ. Bʉʼka i nɔ bʉ̀ʉ tʉ a ndə məbɛ lɛŋ, kie məchímbi təmə liʼ-i ghɔ fɛ, tə chàa ndə məgɛ̀ mu viʼi nə ghɔbə-a ibûu, mu viʼi təmə i mə nə lʉ́əŋnə fɛ,</char> <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" /><char style="wj">[‘kəyəŋ ndə ntyʉəbə-ʉə mə nə kwú fɛ, təmə viʼi-yʉə mə nə lʉ́əŋnə fɛ.’]</char> <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" /><char style="wj">Bɔŋ kaʼ kʉ̀ʼ mbɔ kwii kəwu-a chìi a chìi bʉ̂ʼʉ, ä chʉ̀ə mɛ̀ʼ. Bʉʼka i nɔ bʉ̀ʉ tʉ a ndə məbɛ lɛŋ, kie məchímbi təmə liʼ-i ghɔ fɛ, tə chàa mbɔ a kie wubə-a ibûu gɛ̀ mu viʼi,</char> <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" /><char style="wj">[‘kəyəŋ ndə ntyʉəbə-ʉə mə nə kwú fɛ, təmə viʼi-yʉə mə nə lʉ́əŋnə fɛ.’]</char> <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" /><char style="wj">Bɔŋ kaʼ kʉ̀ʼ mbɔ vaashʉ-a chìi a chìi bʉ̂ʼʉ, ä chʉʼ fyúhə mɛ̀ʼ. I nɔ bʉ̀ʉ tʉ a ndə məŋíi ntoʼ-Nyii nə vaashʉ-a imɔʼ, tə chàa ndə məkie vâabəshʉ ibûu, bə mɛ̀ʼ aŋ mu viʼi,</char> <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" /><char style="wj">‘kəyəŋ ndə ntyʉəbə-i mə nə kwú fɛ, təmə viʼi-i mə nə lʉ́əŋnə fɛ.’</char> <verse eid="MRK 9:48" /><verse number="49" style="v" sid="MRK 9:49" /><char style="wj">Bʉʼka bə bu sùu bʉə bənchəŋ nə viʼi ndə bə kùŋ mbɔʼ nə chʉəʼ le.</char> <note caller="+" style="f"><char style="fr" closed="false">9:49 </char><char style="ft" closed="false">Bəbɛʼbəŋwɔʼnə kəŋgie-Gili nɔ bìʼ </char><char style="it">Bə bu kùŋ fɔ-fɛ̀ʼndɛŋ-bə inchəŋ nə chʉəʼ.</char></note> <verse eid="MRK 9:49" /><verse number="50" style="v" sid="MRK 9:50" /><char style="wj">Chʉəʼ nɔ bʉ̀ʉ, bɔŋ kaʼ məsʉ́ʼnə-i fyú chɔ, a bu chìi ka chɔ i buŋ leʼ sʉ́ʼnə? Bii nɔ kie ndə məbɛ nə chʉəʼ tʉ ŋwɔŋtə-ii, bɔŋleʼ kie fyiighʉ́ənə mu bii.”</char><verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">Kwəʼ te məwɔ̀ʼtə lɔŋ leʼnə məbʉ̀nə lɔŋ</para>
  <para style="r">(<ref loc="MAT 19:1-12">Matia 19:1-12</ref>; <ref loc="LUK 16:18">Luk 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Ndʉʉ ndə Jiso kə lɔ̀ hə Kabanu, ɔ gɛ̀ mu bie Judia, gɛ̀ tə dàa ŋgwɛŋ Jodaŋ gɛ̀ nə shʉbə, bʉə buŋmbi bìʼ chə̀ŋtə mbʉə-ɔ. Ɔ bìʼ chìi haʼ ndə ɔ̃ chìi, chʉ́ʉhə kə́ dàhə bɔŋ.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />Bʉə-Falasi kóʼ gwè ndə məmùutə ɔŋ bíʼtə tʉ ɔŋ mbɔ, “Nuʼ Mushi bɛ́ŋ mbɔ ẅoləŋ wɔ̀ʼtə lɔŋ ghɔŋ vi-i mɛ?”<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />Ɔ bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“Mushi kə kàhə bii mbuka?”</char><verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />Bɔ̂ŋ ghɔ̀ŋ mbɔ, “Mushi nɔ nə bɛ́ŋ mbɔ bəkɔ woləŋ kɔ́ ŋwɔʼnə tʉ vi-i ndə mədʉ̀ʼ mbɔ ghɔŋ ɔŋ nɔʼ wɔ̀ʼtə lɔŋ, ndə məjə̀ŋ ɔŋ ɔ̈ gɛ̀ nə wi.”<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />Jiso ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Nɔ kə bɛ bʉʼka məshʉ́əhə-fyii ndə bii kə shʉ́əhə fyiihə-ii ndə i chìi Mushi buŋ nyɔ̀ʼ mbyu ŋkahə-ɔ̄ŋ tʉ bii.</char> <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" /><char style="wj">Bɔŋ lʉ̀ hə ndəŋ ŋgwunə-mbi, ‘Nyii nɔ nə chìi bɔŋ ndə woləŋ ghɔŋ woke.’</char> <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" /><char style="wj">‘Nɔ, bʉʼka luu-ɔ̄, woləŋ nɔ kie ndə məmɛ̀ʼtə tie-e ghɔŋ ŋkwê-i, gɛ̀ tùonə ghɔŋ vi-i,</char> <note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">Bəbɛʼbəŋwɔʼnə kəŋgie-Gili nɔ fyúhə </char><char style="it">tyʉ̀nə ghɔŋ vi-i.</char></note> <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" /><char style="wj">mbʉ b̈ʉə bəbûu bɛ mbyu mbʉə imɔʼ.’ Bɔ̂ŋ leʼbie bʉə bəbûu fɛ, bɔ̂ŋ bəbûu bu bɛ mbyu mbʉə imɔʼ.</char> <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" /><char style="wj">Nɔ, fɔkə ndə Nyii nɔʼ tùo, kə wo mə mùutə mbɔ ɔ wɔ̀ʼhə fɛ.”</char><verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Ndʉʉ ndə bɔ̂ŋ kə bɛ mu njaa, vâafɔʼɔ-bi bìʼ bíʼtə tʉ ɔŋ te nukə ndə ɔ kə gìe. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Ɔ bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“Wotəmiyɔŋ ndə ɔ wɔ̀ʼtə lɔŋ ghɔŋ vi-i, lʉ̀ yi-kədɔŋ-yə, nɔʼ chìi bʉ̂ʼʉ tʉ vi-i ndə məgháa bəsəŋ.</char> <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" /><char style="wj">Bɔŋ kaʼ woke leʼ wɔ̀ʼtə lɔŋ ghɔŋ ləŋ-ɛŋ gɛ̀ lʉ̀ woləŋ kədɔŋ, təmə ɔ nɔʼ gháa bəsəŋ.”</char><verse eid="MRK 10:12" /></para>
  <para style="s">Jiso túu biʼbə kɔ́ tʉ vâambuɔ</para>
  <para style="r">(<ref loc="MAT 19:13-15">Matia 19:13-15</ref>; <ref loc="LUK 18:15-17">Luk 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Nɔ nə bɛ yɔŋbɛʼ, bətie-vâa-bɛʼbə kə́ gwè nə vâa-bʉə tʉ Jiso mbɔ ɔ̈ mɔ̀ʼ ghɔkə-i ndəŋ bɔŋ, vâafɔʼɔ-bi sɔ́ʼ bɔŋ. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />Bɔŋ ndʉʉ ndə Jiso nyíɛ, tʉʉ-i byʉ́ʼ, ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“B̈ii mɛ̀ʼtə v̈âambuɔ gwè tʉ mɔ, kə bii mə leʼ chíe bɔŋ fɛ bʉʼka Sɔ́ʼ-Nyii nɔ bɛ tʉ ntɛ bʉə nə bɔ̄ŋbə.</char> <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" /><char style="wj">Nɔʼ m̈ɔ shyíi bii nə shʉəŋ mbɔ wotəmiyɔŋ ndə ɔ gòʼ təmə kɔ́ ŋwɔŋ-ɛŋ mbɔ Nyii sɔ́ʼ ɔ nə vaambuɔ fɛ, ɔ mə nə ŋíi mu Sɔ́ʼ-Nyii fɛ.”</char> <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Ɔ kwétə bɔŋ chu fyii-ɔ, mɔ̀ʼ ghɔkə-i ndəŋ bɔŋ túu biʼkə kɔ́ tʉ bɔŋ.<verse eid="MRK 10:16" /></para>
  <para style="s">Wo-kəfʉʼ</para>
  <para style="r">(<ref loc="MAT 19:16-30">Matia 19:16-30</ref>; <ref loc="LUK 18:18-30">Luk 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Ndʉʉ ndə Jiso kə́ gɛ̀ mətòʼ, wobɛʼ nyʉ́ʉ kóʼ gwè tʉ ɔŋ, gwè bè kweʼtəbə-i bəshʉ ɔ, bíʼtə tʉ ɔŋ mbɔ, “Tie-ɔ chicha, a nɔ wo-nuʼ-jyujyu, bɛ ka ndə mɔ kie ndə mə-yaʼ-chìi ndə məkie məchímbi təmə liʼ-i ghɔ fɛ?” <verse eid="MRK 10:17" /><verse number="18" style="v" sid="MRK 10:18" />Jiso bə̀ŋhə tʉ ɔŋ mbɔ, <char style="wj">“A tíi mɔ nə wo-nuʼ-jyujyu bʉʼka ka? Wo kaa ghɔ ndə ɔ kie nuʼ-jyujyu fɛ yaʼkɛŋ Nyii tətɛʼ ɛ.</char> <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" /><char style="wj">Bii nɔ kínə bəŋkahə Nyii ndə i ghɔ̀ŋ mbɔ, ‘Kə a mə yí wo fɛ, kə a mə gháa bəsəŋ fɛ, kə a mə lʉ́ʼ fɛ, kə a mə tɔ́ŋ bɔ̌ŋ wo ndəŋ lɛɛŋkə fɛ, kə a mə yú ŋkwo fɛ, kɔ́ kuŋhə tʉ naa-aŋ ghɔŋ tie-a.’ ”</char><verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />Ɔ bə̀ŋhə tʉ Jiso mbɔ, “Chicha, mɔ nɔʼ kɛŋ fɔ̀ʼ nubə-ɔ̄ŋ inchəŋ lʉ̀ hə vaambuɔ.”<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />Ndʉʉ ndə Jiso tʉʼ lɛ́nə ɔŋ, ɔ kie ŋkʉ̂ʉ tʉ ɔŋ, ghɔ̀ŋ tʉ ɔŋ mbɔ, <char style="wj">“A nɔ byúu mbyu kənu imɔʼ, gɛ̀ fɛ̀ŋ fɔbə inchəŋ ndə a kie kɔ́ tʉ bʉə-mbʉʼ, kaʼ a chìi nɔ, a kie lə̂ŋ-aŋ yuo, ndʉʉmɛ, gwè, kə́ gwè hə bɔ̌ŋ mɔ.”</char> <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />Bʉʼka ŋgiekə-ɔ̄ŋ, shʉ-i jyùu, ɔ lɔ̀ kə́ gɛ̀ vínəvínə, bʉʼka ɔ nɔ nə kie fɔbə yɔ́ŋyɔ́ŋ.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />Jiso lɛ́nə vâafɔʼɔ-bi mbʉə-ɔ, ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“I bu shʉ́ə daa tʉ bʉə-kəfʉʼ ndə məŋíi mu Sɔ́ʼ-Nyii!”</char> <verse eid="MRK 10:23" /><verse number="24" style="v" sid="MRK 10:24" />Ŋgiekə-i chíe chu vâafɔʼɔ-bi. Bɔŋ Jiso gìe tʉ bɔŋ mbɔ, <char style="wj">“Vâambuɔ, i nɔ shʉ́ə daa</char> <note caller="+" style="f"><char style="fr" closed="false">10:24 </char><char style="ft" closed="false">Bəbɛʼbəŋwɔʼnə kəŋgie-Gili nɔ bìʼ </char><char style="it">tʉ bʉə ndə bɔ̂ŋ mɔ̀ʼfyiihə-ʉə ndəŋ fʉʼkə.</char></note> <char style="wj">ndə məŋíi mu Sɔ́ʼ-Nyii!</char> <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" /><char style="wj">I nɔ yùhə tʉ nyaa-bəkatə</char> <note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="ft" closed="false">Mu fəŋ ŋwɔʼnə, bə nɔ nyɔ̀ʼ muŋgɔ mbɔ </char><char style="it">kamɛ.</char></note> <char style="wj">ndə məsʉ́ʉ hə ndəŋ gyii-sɔʼ-kə tə chàa ndə i bɛ tʉ wo-kəfʉʼ ndə məŋíi mu Sɔ́ʼ-Nyii.”</char><verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />I chíe chu-vâafɔʼɔ-bi daa, bɔ̂ŋ bíʼtə tʉ ɔŋ mbɔ, “Bɛ nda ndʉʉghɔfii ndə bəkɔ ɔ kie ŋkwaaNyii?”<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />Jiso lɛ́nə bɔŋ ghɔ̀ŋ mbɔ, <char style="wj">“Yɔ̄ŋ-yə nɔ chàa ghʉəʼ-woməsʉʉ-kə, bɔŋ nubɛʼkə kaa ghɔ ndə i chàa Nyii fɛ. Bʉʼka nubə inchəŋ nɔ yùhə tʉ Nyii.”</char><verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />Bita chʉ́ʉhə kə́ ghɔ̀ŋ tʉ ɔŋ mbɔ, “Nyíɛ! Baʼa nɔʼ mɛ̀ʼtə fɔbə inchəŋ ndə məgwè hə bɔ̌ŋ aŋ.”<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />Jiso gìe tʉ bɔŋ mbɔ, <char style="wj">“Nɔʼ m̈ɔ shyíi bii nə shʉəŋ mbɔ, wo kaa ghɔ ndə ɔ nɔʼ mɛ̀ʼtə fɔbə nə njaa-ɛ byuunɔ bəliŋ-bi, bələŋ ghɔŋbə bəke, byuunɔ ŋkwê-i byuunɔ tie-e byuunɔ vâa-bi byuunɔ tɔ̂bə-i bʉʼka mɔ leʼnə ntəŋjyujyu,</char> <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" /><char style="wj">ndə ɔ bu gòʼ təmə kie yɔ́ŋyɔ́ŋ tə dàa nə vɛʼ ghyʉʉ tíŋ ndə ɔ kə fəŋ kie ndə mbi-laa-ɔ̄ nɔ fɛ, ndə njaahə leʼnə bəliŋ-bi, bələŋ ghɔŋbə bəke, leʼnə bənaa-bi leʼnə vâa leʼnə tɔ̂bə leʼnə ŋgʉəʼ ghɔŋbə məchímbi təmə liʼ-i ghɔ fɛ ndə i bɛ bəshʉ gwè.</char> <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" /><char style="wj">Bɔŋ bʉə buŋmbi ndə bɔ̂ŋ bɛ fəŋtə bu yi bɛ ndyiʼtəbə, ndyiʼtəbə bɛ fəŋtə.”</char><verse eid="MRK 10:31" /></para>
  <para style="s">Jiso bìʼ kwə́ʼ te kwu-i</para>
  <para style="r">(<ref loc="MAT 20:17-19">Matia 20:17-19</ref>; <ref loc="LUK 18:31-34">Luk 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Ndʉʉ ndə Jiso kə bɛ sêfia ghɔŋbə vâafɔʼɔ-bi, kə́ kóʼ gɛ̀ Jɛlosalɛŋ, Jiso nɔ nə kə́ gɛ̀ hə bəshʉ bɔŋ. I chíe chutə-ʉə, bʉə ndə bɔ̂ŋ kə́ gwè hə bɔ̌ŋ liɛŋ-bɔŋ kə́ fàa. Ndʉʉ ndə Jiso ghɔŋbə mbʉ vâafɔʼɔ-bi njuɔ bûu nə wuŋ fí ŋwɔŋ-yʉə-bɔŋ bɔ̌ŋ, ɔ chʉ́ʉhə kə́ shyíi bɔŋ nə nukə ndə i bu fyú chíe ɔ. <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" /><char style="wj">“B̈ii nyíɛ, bʉʼʉ nɔ tʉʼ kóʼ gɛ̀ Jɛlosalɛŋ, bə bɔŋ bu chɔ̀ʼhə Vaa-Woməsʉʉ, kɔ́ kəghɔ-bətiefɛ̀ʼndɛŋNyii leʼnə bʉə dàhə nuʼ-Mushi, bɔ̂ŋ chʉ̀ə ŋkwɛ mbɔ b̈ə yí ɔ. Bə bɔŋ-bu-leʼ chɔ̀ʼhə ɔŋ kɔ́ mu kəghɔ-bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ.</char> <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" /><char style="wj">Bɔ̂ŋ bu dʉ̀ʉhə ɔŋ, tyù ntɛmə mbʉə-ɔ, kɛŋ gwúu ɔ yí, kʉ̂ʉ bɛ chîbə itia nɔ ɔ bʉ̀nə kóʼ.”</char><verse eid="MRK 10:34" /></para>
  <para style="s">Jiso dàhə ndə mə-kə́-fɔ̀ʼ tʉ bəbɛʼbʉə</para>
  <para style="r">(<ref loc="MAT 20:20-28">Matia 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Jɛŋ ghɔŋ Jɔŋ vâa-Sabɛdi kóʼ gwè tʉ Jiso ghɔ̀ŋ tʉ ɔŋ mbɔ, “Chicha, baʼa nɔ tʉʼ kʉ́ʉ mbɔ nukə təmiyɔŋ ndə baʼa bíʼtə tʉ a, ä fɔ̀ʼ tʉ baʼa.”<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />Ɔ bíʼtə tʉ bɔŋ mbɔ, <char style="wj">“Bɛ ka ndə bii tʉʼ kʉ́ʉ mbɔ m̈ɔ fɔ̀ʼ tʉ bii?”</char><verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />Bɔ̂ŋ ghɔ̀ŋ tʉ ɔŋ mbɔ, “Chìi mbɔ mbyu wo-imɔʼ mu baʼa yi dùʼ kwiimɔʼnə-aŋ, mbyu wo-imɔʼ dùʼ kwiiŋkwie-a ndʉʉ ndə a bu yi kə́ sɔ́ʼ fɔŋ mu məŋwɔʼmə-a.”<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />Jiso bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“Bii kínə nukə ndə bii tʉʼ bíʼtə fɛ. Bəkɔ bii nú hə mu ndʉ̂ʉ ŋgʉəʼ ndə mɔ bu nú hə chɔ, byuunɔ fí ntɛ muu, ndə bɛ ŋgʉəʼ, ndə mɔ bu fí mɛ?”</char> <verse eid="MRK 10:38" /><verse number="39" style="v" sid="MRK 10:39" />Bɔ̂ŋ bə̀ŋhə tʉ ɔŋ mbɔ, “Bəkɔ baʼa chìi.” Jiso ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Mbʉ ndʉ̂ʉ ŋgʉəʼ ndə mɔ bu nú hə chɔ, bii bu nú ntɛ muu-ŋgʉəʼ-mə ndə mɔ bu fí, bii bu fí.</char> <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" /><char style="wj">Bɔŋ mədùʼ kwiimɔʼnə-mɔ byuunɔ kwiiŋkwie-mɔ, kaa yəŋkə-ɔŋ ndə məgìe fɛ, bə bɔŋ bu kɔ́ bə haʼ tʉ bʉə ndə bə nɔʼ kə shʉ̀tə tʉ bɔŋ.”</char> <verse eid="MRK 10:40" /><verse number="41" style="v" sid="MRK 10:41" />Bɔŋ ndʉʉ ndə bəʼ-vâafɔʼɔ-Jiso-kə wuŋ kə yʉ́ yɔ̄ŋ-yə, tʉʉ-yʉə chʉ́ʉhə ndə məbyʉ́ʼ ndəŋ Jɛŋ ghɔŋ Jɔŋ. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />Jiso tíi bɔŋ mbʉə ɔ, ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Bii nɔ kínə mbɔ bʉə ndə bə kínə bɔŋ ndə bəfɔŋ, bɔ̂ŋ kə́ sɔ́ʼ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ, nɔ tʉʼ gìe kətʉ-bɔŋ, bəntəŋbəshʉ-bʉə kə́ bʉ́bʉ́ kətʉ-bɔŋ ndə nubə inchəŋ.</char> <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" /><char style="wj">I bɔŋ kie ndə məbɛ nɔ mu bii fɛ. Bɔŋ kaʼ wo hə mu bii leʼ kʉ̀ʉ ndə məbɛ wokwɛʼtəŋ, ɔ nɔ kie ndə məlʉ̀ ŋwɔŋ-ɛŋ ndə vaafɔ̀ʼ,</char> <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" /><char style="wj">bɔŋ kaʼ wo mu bii kʉ̀ʉ ndə məbɛ fəŋ, ɔ nɔ kie ndə məbɛ fʉə tʉ bʉə bənchəŋ.</char> <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" /><char style="wj">Bʉʼka buŋ Vaa-Woməsʉʉ kə gwè mbɔ b̈ə kə́ fɔ̀ʼ tʉ ɔŋ fɛ, ɔ nɔ gwè ndə məfɔ̀ʼ bɔŋleʼ kɔ́ məchimbi-i ndə məchʉ̀ʼ tʉ-bʉə-buŋmbi-kə.”</char><verse eid="MRK 10:45" /></para>
  <para style="s">Jiso chʉ́ʼ Batimu ndə ɔ bɛ fʉ̀əŋtəshʉ</para>
  <para style="r">(<ref loc="MAT 20:29-34">Matia 20:29-34</ref>; <ref loc="LUK 18:35-43">Luk 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Bɔ̂ŋ gwè dàa Jɛliko. Kʉ̂ʉ bɛ ndʉʉ ndə ɔ tʉʼ lɔ̀ hə Jɛliko ghɔŋbə vâafɔʼɔ-bi leʼnə nuɔ-bʉə-buŋmbi, Batimu, ndə ɔ bɛ fʉ̀əŋtəshʉ bəghaa kə́ bɛ vaa-Timu, kə́ dùʼ kəmbia fia. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Ndʉʉ ndə ɔ kə yʉ́ mbɔ Jiso ndə ɔ lɔ̀ hə Nasalɛ kə́ gwè, ɔ chʉ́ʉhə mətíi nə ghʉəʼkə kə́ ghɔ̀ŋ mbɔ, “Jiso, V̈aa-Dɛbi, kə ẗʉkə-a vyíi ndəŋ mɔ le!” <verse eid="MRK 10:47" /><verse number="48" style="v" sid="MRK 10:48" />Bʉə buŋmbi sɔ́ʼ ɔ, kə́ ghɔ̀ŋ mbɔ ɔ̈ líitə. Bɔŋ ɔ bìʼ tíitíi nə ghʉəʼkə, mbɔ, “V̈aa-Dɛbi, kə ẗʉkə-a vyíi le ndəŋ mɔ!” <verse eid="MRK 10:48" /><verse number="49" style="v" sid="MRK 10:49" />Jiso tə́nə ghɔ̀ŋ mbɔ, <char style="wj">“B̈ii tíi ɔ.”</char> Bɔ̂ŋ tíi mbʉ fʉ̀əŋtəshʉ, ghɔ̀ŋ tʉ ɔŋ mbɔ, “Kie fyii, lɔ̀ hə sê gwè, ɔ tʉʼ tíi a.” <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />Ɔ shùɔ ndyi-fəʼə-ɛ mɛ̀ʼ, sɛ́ʼ gɛ̀ tʉ Jiso. <verse eid="MRK 10:50" /><verse number="51" style="v" sid="MRK 10:51" />Jiso bíʼtə tʉ ɔŋ mbɔ, <char style="wj">“A tʉʼ kʉ́ʉ mbɔ m̈ɔ bɛ təka nə naŋ?”</char> Mbʉ fʉ̀əŋtəshʉ bə̀ŋhə mbɔ, “Chicha, mɔ nɔ tʉʼ kʉ́ʉ mə-kə́-bʉ̀nə nyíɛ yəŋkə.” <verse eid="MRK 10:51" /><verse number="52" style="v" sid="MRK 10:52" />Jiso ghɔ̀ŋ tʉ ɔŋ mbɔ, <char style="wj">“Gɛ̀ nə wa, bʉʼka a mɔ̀ʼfyii-a ndəŋ mɔ, mɔ nɔʼ chìi a kie nchʉʼ.”</char> Haʼ ndʉʉmɛ, ɔ bʉ̀nə nyíɛ yəŋkə, chʉ́ʉhə kə́ tòʼ gɛ̀ hə bɔ̌ŋ Jiso.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">Jiso sʉ̀ʉnə mu Jɛlosalɛŋ ndə məsɛ́ʼ ŋgʉʼʉ</para>
  <para style="r">(<ref loc="MAT 21:1-11">Matia 21:1-11</ref>; <ref loc="LUK 19:28-40">Luk 19:28-40</ref>; <ref loc="JHN 12:12-19">Jɔŋ 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Ndʉʉ ndə Jiso ghɔŋbə vâafɔʼɔ-bi gɛ̀ tə kə́ kə́ŋhə Jɛlosalɛŋ, mbʉə Befe ghɔŋbə Bɛtani ndə i kə bɛ mbʉə Kwɔŋ-bəTyʉ-Oli, Jiso tə́ŋ vâafɔʼɔ-bi bəbûu, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“B̈ii gɛ̀ mu lɔʼɔ-fīi bəshʉ bii le, haʼ ndə bii tʉʼ sʉ́ʉ nɔ, bii bu nyíɛ vaaŋgwɔŋ-jakashi ndə bə chyúu ɔ, təmə wo nɔʼ nə kóʼ ndəŋ ɔŋ fɛ. B̈ii yɔ̀ʼ ɔ gwè nə nɔŋ.</char> <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" /><char style="wj">Kaʼ wo bíʼtə tʉ bii mbɔ, ‘Bii tʉʼ yɔ̀ʼ ɔ bʉʼka ka?’ B̈ii ghɔ̀ŋ mbɔ, ‘Mbʉ Tiekətʉ nɔ kie fɔʼɔ nə yɔŋ, bɔŋ-bu-leʼ byʉ̀hə kɔ́ fɛ̄ŋ haʼ ndʉʉ ndə ɔ liʼ.’ ”</char> <verse eid="MRK 11:3" /><verse number="4" style="v" sid="MRK 11:4" />Bɔ̂ŋ lɔ̀ gɛ̀, gɛ̀ nyíɛ vaaŋgwɔŋ-jakashi ndə bə chyúu ɔ mbʉə chusiibɛʼ kəmbia fia, bɔ̂ŋ yɔ̀ʼ ɔ. <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />Bʉəbɛʼbə ndə bɔ̂ŋ kə́ nyíɛ bɔŋ ghɔ̀ŋ tʉ bɔŋ mbɔ, “Bii tʉʼ yì ka, bii tʉʼ yɔ̀ʼ bə mbʉ vaaŋgwɔŋ-jakashi mɛ?” <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />Bɔ̂ŋ shyíi bɔŋ nə nukə ndə mbʉ Jiso kə ghɔŋ, bɔ̂ŋ mɛ̀ʼtə bɔŋ, mbɔ b̈ɔ̂ŋ gɛ̀ nə yɔŋ. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Bɔ̂ŋ gwè nə mbʉ vaaŋgwɔŋ-jakashi tʉ Jiso, gwè shùɔ ndyi-fəʼə-hə-ʉə sɛ̀nə ndəŋ mbʉ jakashi, ɔ kóʼ dùʼ ndəŋ ghɔ. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Bʉə buŋmbi kə́ sɛ̀nə ndyi-fəʼə-hə-ʉə sêfia, bəbɛʼbə sɛ̀nə yuu-tɛ́ŋ-bə sêfia ndə bɔ̂ŋ bə́ʼtə muŋkɔ. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Bʉə ndə bɔ̂ŋ kə́ gɛ̀ hə bəshʉ ghɔŋbə bʉə ndə bɔ̂ŋ kə́ gwè hə bɔ̌ŋ kə́ tòʼ tíitə ghɔ̀ŋ mbɔ,</para>
  <para style="q1" vid="MRK 11:9">“Osana!<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="ft" closed="false">“Osana” nɔ bɛ ŋgie-Hibulu-kə ndə i bɛ mbɔ, “N̈yii kwáa baʼa nduɔ,” bɔŋ ndə mbi kə kwɛ̀ʼtə gɛ̀ bɛ mbɔ “Bʉʼʉ lə̀ʼtə Nyii.”</char></note></para>
  <para style="q2" vid="MRK 11:9">Tə Nyii bìʼ wo ndə ɔ gwè yie-Tiekətʉ!<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="ft" closed="false">Ŋwɔʼnə-təLyuu 118:25-26.</char></note><verse eid="MRK 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10" />N̈yii bìʼ sɔ́ʼ-tie-yʉʼʉ-Dɛbi ndə i tʉʼ gwè!</para>
  <para style="q2" vid="MRK 11:10">B̈ə kɔ́ kuŋhə tʉ Nyii gɛ̀ tə dàa liʼ yuo!”<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Ɔ ŋíi mu Jɛlosalɛŋ gɛ̀ ŋíi mu chunjaafɛ̀ʼndɛŋNyii. Ndʉʉ ndə ɔ nɔʼ lɛ́nə fɔbə inchəŋ, bʉʼka mbi nɔʼ kə gɛ̀ dàa, ɔ fyú gɛ̀ Bɛtani ghɔŋbə vâafɔʼɔ-bi njuɔ bûu nə wuŋ.<verse eid="MRK 11:11" /></para>
  <para style="s">Jiso chɛ̀ŋ tyʉ-fik-kə</para>
  <para style="r">(<ref loc="MAT 21:18-19">Matia 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Mbi kʉ̂ʉ sɛŋ fíi, ndʉʉ ndə bɔ̂ŋ bʉ̀nə hə Bɛtani, jyʉʉ yɔ́ʼ ɔ. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Ɔ dùhə nyíɛ tyʉbɛʼkə ndə bə kə́ tíi nə tyʉ-fik-kə dɔdɔ ndə i nɔʼ fyùʼtə, ɔ kwɛ̀ʼtə gɛ̀ lɛ́nə ndə mənyíɛ mbɔ bəkɔ ɔ nyíɛ ntɔŋmə kətʉ-ghɔ̄ mɛɛ. Ndʉʉ ndə ɔ gɛ̀ dàa chɔ, təmə nyíɛ fɔkə fɛ, yaʼkɛŋ fyuŋbə, bʉʼka ndʉʉ kʉʉnə-i nɔʼ kə kʉ̀ʼnə fɛ.<figure style="fig" alt="Jesus curses the fig tree" file="hk00088c.tif" size="col" copy="Horace Knowles" ref="11:13">Jiso chɛ̀ŋ tyʉ-fik-kə</figure> <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Jiso ghɔ̀ŋ tʉ mbʉ kətyʉ mbɔ, <char style="wj">“Kə wo mə leʼnə bìʼ yú ntɔŋmə ndəŋ aŋ fɛ.”</char> Vâafɔʼɔ-bi yʉ́.<verse eid="MRK 11:14" /></para>
  <para style="s">Jiso sʉ̀ mu njaafɛ̀ʼndɛŋNyii</para>
  <para style="r">(<ref loc="MAT 12:12-17">Matia 12:12-17</ref>; <ref loc="LUK 19:45-48">Luk 19:45-48</ref>; <ref loc="JHN 2:13-22">Jɔŋ 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Bɔ̂ŋ kʉ̂ʉ gwè dàa Jɛlosalɛŋ, ɔ ŋíi mu chunjaafɛ̀ʼndɛŋNyii chʉ́ʉhə kə́ jə̀ŋ bʉə ndə bɔ̂ŋ tʉʼ fɛ̀ŋ fɔbə ghɔŋbə bʉə ndə bɔ̂ŋ tʉʼ nyúɔ fɔbə, kíahə bətebele-bʉə ndə bɔ̂ŋ tʉʼ kwɛ́nə kyʉə ghɔŋbə fɔŋ-bʉə-bə ndə bɔ̂ŋ tʉʼ fɛ̀ŋ bətambʉətə kwóhə sê. <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />Təmə ɔ bɔŋ mɛ̀ʼtə wotəmiyɔŋ ɔ bɛ̀ʼ fɔkə tíŋ nə yɔŋ mu chunjaafɛ̀ʼndɛŋNyii fɛ. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Ɔ kə́ dàhə bɔŋ, kə́ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Bə nɔ nyɔ̀ʼ mu ŋwɔʼnə-Nyii mbɔ, ‘Bə bu kə́ tíi njaa-ɔ̄ nə njaagháaNyii tʉ lɔʼ-bətə̂ŋ-tə inchəŋ’ fe? Bɔŋ bii nɔʼ lʉ̀ i bə̀ŋ chəŋ-bəlʉʼʉ-shùɔ-bʉə.”</char> <verse eid="MRK 11:17" /><verse number="18" style="v" sid="MRK 11:18" />Mbʉ bətiefɛ̀ʼndɛŋNyii ghɔŋbə bʉə dàhə nuʼ-Mushi yʉ́ yɔ̄ŋ-yə, kə́ kʉ́ʉ fia ndə məyí ɔ, bʉʼka bɔ̂ŋ nɔ kə kə́ fàa ɔ bʉʼka i nɔ kə chíe chu bʉə bənchəŋ ndə ntɛ ndə ɔ nə kə́ dàhə. <verse eid="MRK 11:18" /><verse number="19" style="v" sid="MRK 11:19" />Kʉ̂ʉ bɛ ndʉʉbuumbi, bɔ̂ŋ fyú hə mu mbʉ kəyəŋkwɛʼtəŋ.<verse eid="MRK 11:19" /></para>
  <para style="s">Nukə ndə mbʉ kətyʉ-fik tʉʼ dàhə</para>
  <para style="r">(<ref loc="MAT 21:20-22">Matia 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Bɔ̂ŋ kʉ̂ʉ tíŋ ndʉʉsɛŋkə, tʉ mbʉ kətyʉ-fik nɔʼ yə́ŋ tə kɔ́ ndə ghûutə-i. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Bita kwɛ́nə, gìe tʉ ɔŋ mbɔ, “Chicha, nyíɛ! Tyʉ-fik-kə-īŋ ndə a kə chɛ̀ŋ le, nɔʼ yəŋ.” <verse eid="MRK 11:21" /><verse number="22" style="v" sid="MRK 11:22" />Jiso bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“B̈ii mɔ̀ʼfyiihə-ii ndəŋ Nyii.</char> <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" /><char style="wj">Shʉəŋshʉəŋ, m̈ɔ shyíi bii mbɔ, wotəmiyɔŋ ndə ɔ gìe tʉ kwɔŋ mbɔ, ‘Sòʼ ŋwɔŋ-aŋ gɛ̀ gwù mu muukwɛʼtəŋmə,’ təmə jínə mu fyii-ɔ fɛ, bɔŋ bɛ́ŋ mbɔ nukə ndə ɔ gìe bu fyú shʉəŋ, bə bu fɔ̀ʼ tʉ ɔŋ.</char> <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" /><char style="wj">Ndə nɔ, nukə təmiyɔŋ ndə bii bíʼtə hə kəghɔ-Nyii, b̈ii bɛ́ŋ mu fyii-bii mbɔ bii la nɔʼ kie, i bu bɛ yii-yə.</char> <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" /><char style="wj">Ndʉʉtəmiyɔŋ ndə bii tə́nə kə́ gháaNyii, b̈ii sʉ̀fyiihə-ii hə ndəŋ bʉ̂ʼ-bəbɛʼbʉə-tə ndə bɔŋ chìi tʉ bii kə mbɔ Tie-yii ndə ɔ bɛ yuo, bu sʉ̀fyii-i ndə yii-yə bʉ̂ʼʉ ghɔ.”</char> <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" /><char style="wj">[Bɔŋ kaʼ bii gòʼ təmə sʉ̀fyiihə-ii hə ndəŋ bʉ̂ʼ-bəbɛʼbʉə-tə fɛ, Tie-yii ndə ɔ bɛ yuo kʉʉ sʉ̀fyii-i hə ndəŋ yii-yə bʉ̂ʼtə fɛ.]</char><verse eid="MRK 11:26" /></para>
  <para style="s">Bə dʉ̀ʉhə ghʉəʼ-Jiso-kə</para>
  <para style="r">(<ref loc="MAT 21:23-27">Matia 21:23-27</ref>; <ref loc="LUK 20:1-8">Luk 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Bɔ̂ŋ bìʼ gwè Jɛlosalɛŋ. Ndə ɔ kə́ tòʼ mu chunjaafɛ̀ʼndɛŋNyii, bətiefɛ̀ʼndɛŋNyii leʼnə bʉə dàhə nuʼ-Mushi leʼnə bəntəŋbəshʉ gwè tʉ ɔŋ, <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />bíʼtə tʉ ɔŋ mbɔ, “A tʉʼ fɔ̀ʼ nubə-ɔ̄ŋ nə ghʉəʼ-nda-kə? Byuunɔ, kɔ́ nda kɔ́ ghʉəʼkə tʉ a ndə mə-kə́-fɔ̀ʼ nubə-ɔ̄ŋ?” <verse eid="MRK 11:28" /><verse number="29" style="v" sid="MRK 11:29" />Jiso ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Mɔ bu bíʼtə mbyu kənu tʉ bii imɔʼ, bii bə̀ŋhə tʉ mɔ, mbəŋ-ɔŋ buŋ shyíi bii ghɔ nə yəŋkə ndə mɔ lʉ̀ ghʉəʼkə-ɔŋ chɔ ndə məfɔ̀ʼ nubə-ɔ̄ŋ.</char> <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" /><char style="wj">Jɔŋ nə kə́ báa bʉə muu le, ghʉəʼkə-i kə́ lɔ̀ hə yuo mɛ, kə hə kəghɔ-bʉə-məsʉʉ? B̈ii bə̀ŋhə mɔ.”</char> <verse eid="MRK 11:30" /><verse number="31" style="v" sid="MRK 11:31" />Bɔ̂ŋ jìʼtə mbʉ kənu-ghɔ̄ mu bɔŋ, kə́ ghɔ̀ŋ mbɔ, “Kaʼ bʉʼʉ ghɔ̀ŋ mbɔ, ‘I kə lɔ̀ hə yuo,’ ɔ bu ghɔ̀ŋ mbɔ, ‘Kə chìi ka təmə bii bɛ́ŋ ɔŋ fɛ?’ <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Bɔŋ kaʼ bʉʼʉ ghɔ̀ŋ mbɔ, ‘I nɔ nə lɔ̀ hə kəghɔ-bʉə-məsʉʉ’? Heee.” Bɔ̂ŋ nɔ kə́ fàa mbʉ bʉə, bʉʼka bʉə bənchəŋ nɔ nə yá mu kətʉ-bɔŋ mbɔ Jɔŋ la kə bɛ yʉkəŋgieNyii. <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />Nɔ, bɔ̂ŋ bə̀ŋhə tʉ Jiso mbɔ, “Baʼa kínə fɛ.” Jiso gìe tʉ bɔŋ mbɔ, <char style="wj">“Yɔŋ mbəŋ ghɔ kʉʉ shyíi bii nə yəŋkə ndə ghʉəʼkə-ɔŋ lɔ̀ hə chɔ ndə məfɔ̀ʼ nubə-ɔ̄ŋ fɛ.”</char><verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">Chəŋkə te bʉə-bʉ̂ʼʉ ndə bɔ̂ŋ tʉʼ fɔ̀ʼ mutɔ</para>
  <para style="r">(<ref loc="MAT 21:33-46">Matia 21:33-46</ref>; <ref loc="LUK 20:9-19">Luk 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Ndʉʉmɛ, ɔ chʉ́ʉhə ndə məkwə́ʼ tʉ bɔŋ nə chəŋbə mbɔ, <char style="wj">“Wobɛʼ nɔ nə bè tɔ-təlyʉʼ-kə-i ndə i kʉ́ʉnə ntɔŋmə bə kə́ tíi nə geleb, kɔ́ʼ lɔ̂ŋ chɔ yə̀ŋhə fúu, tyúu byʉʉ chɔ, bɔ́ŋ ŋkyʉʉkə ndə mə-kə́-lyúʼ mbʉ məntɔŋ muŋgɔ, bɔ́ŋ yəŋkə ndə nchyii bu kə́ kóʼ tə́nə chɔ lɛ́nə mutɔ. Ndʉʉmɛ, chɔ̀ʼhə kɔ́ tʉ bəbɛʼbʉə mutɔ ndə bɔ̂ŋ bu kə́ yú bɔŋleʼ shyíi, lɔ̀ gɛ̀ lɔʼɔ kətə̂ŋ kədɔŋ.</char> <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" /><char style="wj">Ndʉʉ kwɛ̀tə məntɔŋ kʉ̂ʉ kʉ̀ʼnə, ɔ tə́ŋ vaafɔ̀ʼ-ɛ mbɔ ɔ̈ gɛ̀ fí shyîikə-i hə kəghɔ mbʉ bʉə-mutɔhə.</char> <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" /><char style="wj">Bɔ̂ŋ lʉ̀ ɔ gwúu ɔ, jə̀ŋ ɔŋ, ɔ gɛ̀ ghɔghɔ.</char> <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" /><char style="wj">Ɔ bìʼ tə́ŋ ibɛʼ-yə vaafɔ̀ʼ, bɔ̂ŋ gwúu ɔ kətʉ-ɔ, mɔ̀ʼ tʉvyiikə mbʉə-bɔŋ.</char> <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" /><char style="wj">Ɔ bìʼ tə́ŋ ibɛʼ-yə, bɔ̂ŋ yí ɔ. Bɔ̂ŋ chìi haʼ nɔ tʉ bəbɛʼbʉə buŋmbi. Bɔ̂ŋ gwúu bəbɛʼbə bɔŋleʼ yítə bəbɛʼbə.</char> <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" /><char style="wj">Ɔ bìʼ kie ibɛʼ-yə mbyu wo ndə mətə́ŋ, kə́ bɛ vaa-ɛ ndə ɔ kʉ̀ʉ ɔ daa. Kəliʼ ɔ tə́ŋ ɔŋ tʉ bɔŋ, ghɔ̀ŋ mbɔ, ‘Bɔ̂ŋ bu fàa ɔ.’</char> <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" /><char style="wj">Bɔŋ mbʉ bʉə-mutɔhə gìe tʉ ŋwɔŋtə-ʉə mbɔ, ‘Nɔ bɛ mbʉ nju-i nɔ, b̈ii gwè b̈ʉʼʉ yí ɔ mbʉ bəfɔ chʉʼ bɛ yʉʼʉ-yə.’</char> <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" /><char style="wj">Ndʉʉmɛ, bɔ̂ŋ yá ɔ, yí ɔ, fyúhə ɔŋ hə mbʉ mutɔ, mɛ̀ʼ ɔŋ mbi.</char> <verse eid="MRK 12:8" /><verse number="9" style="v" sid="MRK 12:9" /><char style="wj">Mbʉ ŋwɔ̌ŋ-mutɔ bu bɛ təka? Ɔ bu gwè yítə mbʉ bʉə-fɔʼɔ-mutɔ, fí mbʉ mutɔ kɔ́ tʉ bʉə-kədɔŋ.</char> <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" /><char style="wj">Bii chʉʼ nə tíi ŋwɔʼnə-Nyii ndə i ghɔ̀ŋ mbɔ:</char></para>
  <para style="q1" vid="MRK 12:10">
    <char style="wj">‘Mbʉ ŋgoʼ ndə bʉə bɔ́ŋ njaa kə bìe mɛ̀ʼ, nɔ bɛ ŋgoʼ-fûu-njaa nduɔ,</char><verse eid="MRK 12:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="MRK 12:11" />
    <char style="wj">kə́ bɛ fɔʼɔ-Tiekətʉ, i bɔŋleʼ bʉ̀ʉ shʉ-baʼa daa’ fe?”</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">12:11 </char>
      <char style="ft" closed="false">Ŋwɔʼnə-təLyuu 118:22-23.</char>
    </note><verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Bəntəŋbəshʉ* bʉə-Juu kə́ kʉ́ʉ fia ndə məyá Jiso, bʉʼka bɔ̂ŋ nɔ kə́ nyíɛ mbɔ ɔ nɔ nə mɔ̀ʼ mbʉ kəchəŋ te bɔŋ, bɔ̂ŋ bɔŋ fàa mbʉ bʉə. Ndʉʉmɛ, bɔ̂ŋ mɛ̀ʼtə ɔŋ gɛ̀ nə wʉə.<verse eid="MRK 12:12" /></para>
  <para style="s">Məlɔ̀ʼ tashi tʉ Fɔŋ-Luŋ</para>
  <para style="r">(<ref loc="MAT 22:15-22">Matia 22:15-22</ref>; <ref loc="LUK 20:20-26">Luk 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Bəntəŋbəshʉ-bʉə-Juu nɔ nə tə́ŋ bʉə-Falasibɛʼbə ghɔŋbə bəbɛʼbʉə-nuɔ-Hɛlo ndə məgɛ̀ mɔ̀ʼ sɔʼnduɔŋ tʉ Jiso ndə ntɛ kwəʼ-ɛ.<verse eid="MRK 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 12:14" />Bɔ̂ŋ gwè ghɔ̀ŋ tʉ ɔŋ mbɔ, “Chicha, baʼa nɔ kínə mbɔ a nɔ bɛ wo-kəŋgie-shʉəŋ, təmə kə́ fàa shʉ-wo fɛ, bʉʼka a kyi kə́ lɛ́nə ntɛ-wo-hə fɛ, bɔŋ kə́ dàhə fia-Nyii nə shʉəŋ. Nuʼ bɛ́ŋ mbɔ b̈ə lɔ̀ʼ tashi tʉ Fɔŋ-Luŋ mɛ, kə mbee? B̈aʼa lɔ̀ʼ mɛ, kə baʼa mə lɔ̀ʼ fɛ?” <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />Bɔŋ ɔ kʉ̂ʉ nyíɛ mənaa ndə i bɛ mu fyii-bɔŋ, ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Bii tʉʼ mùutə mɔ mbuka? B̈ii gwè nə mbyu kyʉə-kətəŋ, m̈ɔ lɛ́nə nyíɛ.”</char> <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />Bɔ̂ŋ gwè nə mbyu imɔʼ. Ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Bɛ ŋkwutə-kətʉ-nda-kə leʼnə yie nda ndəŋ ghɔ?”</char> Bɔ̂ŋ bə̀ŋhə mbɔ, “Yi-Fɔŋ-Luŋ-yə.” <verse eid="MRK 12:16" /><verse number="17" style="v" sid="MRK 12:17" />Jiso ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“B̈ii kɔ́ fɔ-Fɔŋ-Luŋ-bə tʉ Fɔŋ-Luŋ, kɔ́ yi-Nyii-yə tʉ Nyii.”</char> Ntɛ ndə ɔ bə̀ŋhə, i chíe chu-yʉə.<figure style="fig" alt="Give to Cesar what is Cesar" file="42_Mark12.15_DenariusCoin.tif" size="col" copy="Gordon Thomson" ref="12:17">Kɔ́ fɔ-Kasa-kə tʉ Kasa</figure><verse eid="MRK 12:17" /></para>
  <para style="s">Kwəʼ te məbʉ̀nə kóʼ</para>
  <para style="r">(<ref loc="MAT 22:23-33">Matia 22:23-33</ref>; <ref loc="LUK 20:27-40">Luk 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Bʉə-Sadusi-bɛʼbə ndə bɔ̂ŋ tɛ́ŋ mbɔ məbʉ̀nə kóʼ bɛ ghɔ fɛ, gwè tʉ Jiso nə mbyu mbiʼtə kə́ ghɔ̀ŋ mbɔ, <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />“Chicha, Mushi nɔ nə nyɔ̀ʼ tʉ baʼa mbɔ kaʼ liŋ-wo kwú mɛ̀ʼtə vi-i təmə bí vaa chɔ fɛ, mbʉ liŋ-iŋ yaʼ lʉ̀ mbʉ woke, bí vaa chɔ ndə mətʉ́ʼ yie-mbʉ-ŋkwu-liŋ-iŋ. <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Vâabələŋbɛʼbə nɔ nə bɛ chu ŋkwê-bɔŋ təkwiitia, fəŋ lʉ̀ woke, kwú təmə kie vâa fɛ. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Ntyunəkə lʉ̀ mbʉ woke, kwú təmə bí fɛ, ntyunə-kəntyunə-kə bìʼ lʉ̀. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />Bɔ̂ŋ təkwiitia bənchəŋ lɔŋ ɔŋ təmə bí fɛ. Kəliʼ, ndə nchəŋnchəŋ-ɛŋ mbʉ woke kwú ghɔ. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Bu yi bɛ chîkə ndə bʉə ndə bɔ̂ŋ nɔʼ kwútə bu bʉ̀nə kóʼ nɔ, ɔ bɛ vi nda mu bɔŋ? Bʉʼka bɔ̂ŋ təkwiitia bənchəŋ, nɔ nə lʉ̀ ɔ ndə vi-yʉə.”<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />Jiso bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“Nɔ luu nɔ ndə bii nɔʼ fyùu chɔ, bʉʼka bii kínə nukə ndə ŋwɔʼnə-Nyii ghɔŋ fɛ, təmə bɔŋleʼ kínə ghʉəʼ-Nyii-kə fɛ.</char> <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" /><char style="wj">Bʉʼka ndʉʉ ndə bʉə bu yi bʉ̀nə kóʼ ndəŋ kwú nɔ, bə kʉʉ yi kə́ gɛ̀ lɔŋ fɛ, təmə bɔŋ kʉʉ yi leʼ kə́ kɔ́ vâa lɔŋ fɛ, bə bɔŋ bu yi bɛ nə bʉəntəŋNyii ndə bɔ̂ŋ bɛ yuo.</char> <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" /><char style="wj">Bɔŋ te nə məbʉ̀nə kóʼ ndəŋ kwú, bii chʉʼ kə tíi mu ŋwɔʼnə-Mushi, te nə vaa-yuu ndə i tʉʼ kyʉ́ʉ, ndə Nyii kə kwə́ʼ tʉ ɔŋ chɔ fe, kə́ ghɔ̀ŋ mbɔ, ‘Mɔ nɔ bɛ Nyii-Ablahaŋ, kə́ bɛ Nyii-Aisi, bɔŋ-kə́-leʼ bɛ Nyii-Jakɔ’ fe?</char> <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" /><char style="wj">Ɔ kaa Nyii-bəŋkwusê fɛ, ɔ nɔ bɛ Nyii-bʉə ndə bɔ̂ŋ bíe ŋɛnə. Bii nɔʼ kɛŋ fyùu.”</char><verse eid="MRK 12:27" /></para>
  <para style="s">Fɔŋ ŋkahəkwɛʼtəŋ</para>
  <para style="r">(<ref loc="MAT 22:34-40">Matia 22:34-40</ref>; <ref loc="LUK 10:25-28">Luk 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Mbyu wobɛʼ mu bʉə dàhə nuʼ-Mushi kóʼ gwè yʉ́ ndə bɔ̂ŋ tʉʼ túŋ bəŋʉʉ mu bɔŋ, kʉ̂ʉ nyíɛ mbɔ Jiso nɔ nə bə̀ŋhə tʉ bɔŋ jyujyu, ɔ bíʼtə mbɔ, “Bɛ yɔ̂ŋ-yə ŋkahə bɛ fɔŋ ɛŋ mu bɔŋ bənchəŋ?” <verse eid="MRK 12:28" /><verse number="29" style="v" sid="MRK 12:29" />Jiso bə̀ŋhə mbɔ, <char style="wj">“Fɔŋ ɛŋ nɔ bɛ mbɔ, ‘B̈ii yʉ́, Oo bʉə-Isilɛ. Mbʉ Nyii Tiekətʉ-yʉʼʉ, Tiekətʉ nɔ bɛ mbyu Tiekətʉ imɔʼ.</char> <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" /><char style="wj">A bɔŋ kie ndə məkʉ̀ʉ Nyii Tiekətʉ-a nə fyii-a inchəŋ nə lyʉʉhəkə-a inchəŋ, nə ndaahə-a inchəŋ leʼnə ghʉəʼkə-a inchəŋ.’</char> <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" /><char style="wj">Biitəkə nɔ bɛ mbɔ, ‘Kʉ̀ʉ wo-kətoʼ-a ndə a kʉ̀ʉ ŋwɔŋ-aŋ.’ Ŋkahəbɛʼ bɛ ghɔ ndə i chàa bɔ̄ŋbə fɛ.”</char> <verse eid="MRK 12:31" /><verse number="32" style="v" sid="MRK 12:32" />Mbʉ wo dàhə nuʼ-Mushi ghɔ̀ŋ tʉ ɔŋ mbɔ, “Chicha, a nɔ gìe i kʉ̀ʼnə. A nɔ gìe shʉəŋ mbɔ ɔ la bɛ haʼ mbyu Nyii imɔʼ təmə ibɛʼ-yə bɛ ghɔ fɛ. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Ndə məkʉ̀ʉ ɔ nə fyii-a inchəŋ, nə ndaahə-a inchəŋ, leʼnə ghʉəʼkə-a inchəŋ, leʼnə məkʉ̀ʉ wo-kətoʼ-a ndə a kʉ̀ʉ ŋwɔŋ-aŋ nɔ gʉ́ə daa tə chàa kɔ-tɔ̀ŋ-kə* inchəŋ leʼnə məfɛ̀ʼndɛŋ.” <verse eid="MRK 12:33" /><verse number="34" style="v" sid="MRK 12:34" />Ndʉʉ ndə Jiso nyíɛ mbɔ ɔ bə̀ŋhə nə ndaa, ɔ ghɔ̀ŋ tʉ ɔŋ mbɔ, <char style="wj">“A dɔ̀ŋnə mbʉə Sɔ́ʼ-Nyii fɛ.”</char> Maa-yɔ̄ŋ kʉ̂ʉ tíŋ təmə wo leʼ mùutə ndə mə-leʼ-bíʼtə nukə tʉ ɔŋ fɛ.<verse eid="MRK 12:34" /></para>
  <para style="s">Wo ndə Nyii Kùŋ Tə́ŋ bɛ vaa nda?</para>
  <para style="r">(<ref loc="MAT 22:41-46">Matia 22:41-46</ref>; <ref loc="MAT 23:1-36">23:1-36</ref>; <ref loc="LUK 20:41-47">Luk 20:41-47</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Ndʉʉ ndə Jiso kə́ dàhə mu chunjaafɛ̀ʼndɛŋNyii, ɔ bíʼtə mbɔ, <char style="wj">“Bəkɔ bʉə dàhə nuʼ-Mushi ghɔ̀ŋ mbɔ mbʉ Wo ndə Nyii Kùŋ Tə́ŋ bɛ vaa-Dɛbi təka?</char> <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" /><char style="wj">Dɛbi nə mbəŋ-ɛŋ nə ghʉəʼ-kəLyʉʉhəNyii-kə mbʉə-ɔ nɔ kə ghɔ̀ŋ mbɔ,</char></para>
  <para style="q1" vid="MRK 12:36">
    <char style="wj">‘Mbʉ Tiekətʉ nɔ nə ghɔ̀ŋ tʉ Tiekətʉ-ɔ mbɔ,</char></para>
  <para style="q2" vid="MRK 12:36">
    <char style="wj">Dùʼ kwiiləŋ-mɔ tə mɔ yi mɔ̀ʼ bʉə-bàa-ba sê bəshʉ a.’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">12:36 </char>
      <char style="ft" closed="false">Ŋwɔʼnə-təLyuu 110:1.</char>
    </note><verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />
    <char style="wj">Dɛbi nə mbəŋ-ɛŋ tíi ɔ nə Tiekətʉ. Nɔ, bəkɔ ɔ bʉ̀nə bɛ vaa-ɛ təka?”</char> Mbʉ nuɔ-bʉə-buŋmbi yʉ́ ɔ nə fyii jyujyu.<verse eid="MRK 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />Ndə ɔ kə́ dàhə bɔŋ, ɔ gìe tʉ bɔŋ mbɔ, <char style="wj">“B̈ii láa bʉə dàhə nuʼ-Mushi, bɔ̂ŋ nɔ kʉ̀ʉ məmɔ̀ʼ bəgaŋ kyʉə mbʉə-bɔŋ kə́ tòʼ ghʉ́ʉ nə yɔŋ, kʉ̀ʉ mbɔ b̈ə kə́ bʉ́ʉnə tʉ bɔŋ ndəŋ yəŋ-vyii-bə,</char> <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" /><char style="wj">kʉ̀ʉ ndə mədùʼ ndəŋ fɔŋkwɛʼtəŋbə mu njaagháaNyii ghɔŋbə yəŋkwɛʼtəŋbə ndəŋ yəŋ-nchəŋtə-bə.</char> <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" /><char style="wj">Bɔ̂ŋ nɔ tʉʼ kwò fɔ-bəkwuʼ-bəke-bə. Bɔ̂ŋ nɔ tʉʼ gháaNyii duhəduhə kə́ làhə shʉ mbɔ bɔ̂ŋ bɛ ndyʉndyʉ. Bʉʼka yɔ̄ŋ-yə, fɛʼɛ-yʉə bu yi shʉ́ə daa.”</char><verse eid="MRK 12:40" /></para>
  <para style="s">Kɔ-kwuʼ-woke-kə</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luk 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Ndʉʉ ndə Jiso kə bɛ mu njaafɛ̀ʼndɛŋNyii, ɔ dùʼ bə̀ŋhə yəŋ-mɔ̀ʼ-kyʉə-kə, kə́ nyíɛ ndə bʉə tʉʼ mɔ̀ʼ kyʉə mu tɔŋ-mɔ̀ʼ-kyʉə-kə. Bʉə-kəfʉʼ buŋmbi kə́ mɔ̀ʼ kyʉə yɔ́ŋyɔ́ŋ. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Kwuʼ wokebɛʼ ndə ɔ kə byúu daa gwè mɔ̀ʼ vâabədyʉʼ-kyʉə-bi ibûu ndə kaʼ bə chə̀ŋtə i kɔ́ haʼ vaadyʉʼʉ kyʉə. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />Ɔ tíi vâafɔʼɔ-bi mbʉə ɔ, ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“M̈ɔ shyíi bii nə shʉəŋ, kwuʼ woke kəbyuu-ɔ̄ nɔʼ kɔ́ kɔkə chàa bʉə bənchəŋ ndə bɔ̂ŋ tʉʼ mɔ̀ʼ mu tɔŋ-mɔ̀ʼ-kyʉə-kə-ɔ̄ŋ.</char> <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" /><char style="wj">Bʉʼka bɔ̂ŋ bənchəŋ nɔ tʉʼ kɔ́ hə mu buŋmbi ndə bɔ̂ŋ kie, bɔŋ kwuʼ-woke-ɔ̄ ndə ɔ gòʼ təmə kie fɛ, mu byuukə-i nɔʼ kɔ́ fɔkə təmiyɔŋ ndə ɔ kie, nchəŋnchəŋ bəfɔ ndə ɔ kie.”</char><verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">Jiso kwə́ʼ te məkuu-njaafɛ̀ʼndɛŋNyii ndʉʉ-i buŋ yi kʉ̀ʼnə</para>
  <para style="r">(<ref loc="MAT 24:1-44">Matia 24:1-44</ref>; <ref loc="LUK 21:5-33">Luk 21:5-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Ndʉʉ ndə Jiso kə́ fyú hə mu njaafɛ̀ʼndɛŋNyii, mbyu vaafɔ̀ʼ-ɛ gìe tʉ ɔŋ mbɔ, “Chicha, nyíɛ ka mbʉətə ŋgoʼbɛʼhə nyíɛ ghɔŋbə mbʉətə njaabɛʼhə!” <verse eid="MRK 13:1" /><verse number="2" style="v" sid="MRK 13:2" />Bɔŋ Jiso ghɔ̀ŋ tʉ ɔŋ mbɔ, <char style="wj">“A nyíɛ bəlɔkɔʼɔ njaahə-ɔ̄ŋ mɛ? Mbyu ŋgoʼ kʉ̂ʉ yi káa liɛŋ liŋ-iŋ chɔ təmə bə kùu mɛ̀ʼ sê fɛ.”</char><verse eid="MRK 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Ndʉʉ ndə Jiso kə dùʼ ndəŋ Kwɔŋ-bəTyʉ-Oli ndə i bə̀ŋhə njaafɛ̀ʼndɛŋNyii, Bita, Jɛŋ, Jɔŋ leʼnə Andolo gwè tʉ ɔŋ bɔ̌ŋbɔ̌ŋ kə́ bíʼtə mbɔ, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“Shyíi baʼa, bɛ ndʉʉka ndə nubə-ɔ̄ŋ inchəŋ bu yi fyú chɔ, leʼnə ntɛ kəcheʼ ndə i bu yi dʉ̀ʼ?” <verse eid="MRK 13:4" /><verse number="5" style="v" sid="MRK 13:5" />Jiso chʉ́ʉhə məghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“B̈ii láa mbɔ wo mə yi fə́ʼhə bii fɛ.</char> <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" /><char style="wj">Bʉə buŋmbi bu yi gwè yie-mɔ, kə́ ghɔ̀ŋ mbɔ, ‘Mɔ nɔ bɛ mbəŋ-ɛŋ,’ bɔ̂ŋ bu fə́ʼhə bʉə buŋmbi.</char> <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" /><char style="wj">Ndʉʉ ndə bii yʉ́ chɔ̂tə ghɔŋbə nchyʉhə-chɔ̂-mə, kə i mə chɔ́ŋhə bii fɛ. Nubə-ɔ̄ŋ nɔ kie ndə məfyú sê, təmə bɔŋ nɔʼ bɛ bə mə lìʼ mbi fɛ.</char> <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" /><char style="wj">Bʉʼka lɔʼ-bətə̂ŋ-tə bu lɔ̀ tə́nə ghɔŋbə bəbɛʼbə lɔʼ-bətə̂ŋ-tə, bəfɔŋ bətə̂ŋ bu lɔ̀ tə́nə ghɔŋbə bəbɛʼbə bəfɔŋ bətə̂ŋ. Chisêkə bu ŋʉ̀ʼnə bəyəŋbəyəŋ, chyʉʉ bu gwù mbi. Nubə-ɔ̄ŋ nɔ bɛ haʼ nchʉʉhə-kəyɔʼ-Nyii ndə ĩ byùu woke.</char> <verse eid="MRK 13:8" /><verse number="9" style="v" sid="MRK 13:9" /><char style="wj">Bɔŋ b̈ii láa, bʉʼka bə bu yátə bii gɛ̀ nə bii mu bəkaŋsotə, bə bu gwúu bii mu-njaagháaNyii-hə, bə bu lʉ̀ bii gɛ̀ nə bii bəshʉ bəgɔməna ghɔŋbə bəfɔŋ bʉʼka mɔ, ndʉʉmɛ, bəkɔ bii lɔ̀ʼ ntəŋjyujyu tʉ bɔŋ.</char> <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" /><char style="wj">Bə nɔ kie ndə mə-fəŋ-lɔ̀ʼ ntəŋjyujyu tʉ lɔʼ-bətə̂ŋ-tə inchəŋ.</char> <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" /><char style="wj">Ndʉʉ ndə bə lʉ̀ bii mu njaafɛ̀ʼ, ndə məchɔ̀ʼhə bii kɔ́, kə bii mə kə́ kwɔ̀ʼtə te nukə ndə bii bu gìe fɛ, b̈ii gìe bə nukə ndə bə bu kɔ́ tʉ bii ndʉʉmɛ, bʉʼka tʉʼ kwə́ʼ yá mbəŋ fɛ, bɔŋ nɔ tʉʼ kwə́ʼ LyʉʉhəNyiikə.</char> <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" /><char style="wj">Bəliŋ bu chɔ̀ʼhə bəliŋ-bʉə, kɔ́ b̈ə yi, tie-vaa chɔ̀ʼhə vaa-ɛ, kɔ́ b̈ə yí, vâa bu dʉ̀ʼ ghɔbə-ʉə chu bətie-bʉə chɔ̀ʼhə bɔŋ, kɔ́ b̈ə yí.</char> <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" /><char style="wj">Bʉə bənchəŋ bu bàa bii bʉʼka bii mɔ̀ʼfyiihə-ii ndəŋ mɔ. Bɔŋ wo ndə ɔ lyʉ̀ʉtə́nə tə gɛ̀ dàa ndə liʼ-i bu kie ŋkwaaNyii.</char><verse eid="MRK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />
    <char style="wj">“Bɔŋ ndʉʉ ndə bii bu nyíɛ nu-ŋkwɔŋŋkwɔŋ-kə ndə i bʉ́əhə njaa-Nyii kə́ tə́nə kəyəŋ ndə i gòʼ təmə kie ndə məbɛ chɔ fɛ nɔ, (ẅo ndə ɔ tʉʼ tíi ŋwɔʼnə-ɔ̄ŋ kínə), ndʉʉ ndə yɔ̄ŋ-yə fyú sê ndʉʉmɛ, b̈ʉə ndə bɔ̂ŋ bɛ mu Judia nyʉ́ʉ kóʼ ndəŋ kwɔŋhə.</char> <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" /><char style="wj">Wo ndə ɔ bɛ kətʉ njaa</char><note caller="+" style="f"><char style="fr" closed="false">13:15 </char><char style="ft" closed="false">Bʉə-Juu nɔ nə kə́ bɔŋ njaahə-ʉə nɔ bɔ̂ŋ mɔ̀ʼ ghɔ̂ʼ chɔ, lyʉ́ʉ tʉkə-i nə chiabə təmə kwɛ̀ŋkwɛ̀ŋ fɛ. Chìi yuhəbə mbi ndə məkóʼ gɛ̀ kətʉ ghɔ.</char></note> <char style="wj">kə ɔ mə shíʼ sê fɛ, kə ɔ mə sʉ́ʉ mu njaa-ɔ ndə məlʉ̀ fɔkə təmiyɔŋ fɛ,</char> <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" /><char style="wj">kə wo ndə ɔ bɛ mutɔ mə leʼ bʉ̀nə chunjaa ndə məlʉ̀ ndyihə-i fɛ.</char> <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" /><char style="wj">I bu nə tɛ̀nə tʉ bəke gʉʼnə ghɔŋbə bəke ndə bɔ̂ŋ tʉʼ nyùuhə vâa ndəŋ chî-ghɔ̄-bə.</char> <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" /><char style="wj">B̈ii gháaNyii mbɔ i mə yi bɛ ndəŋ shyʉʉ-fəʼə fɛ.</char> <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" /><char style="wj">Bʉʼka bu yi bɛ chî-ghɔ̄-bə nɔ, bʉə nyíɛ ŋgʉəʼ təmə ntɛ-ɛ nɔʼ nə bɛ ghɔ fɛ, lʉ̀ hə ndəŋ ŋgwunə-mbi ndə Nyii nə chìi wʉʉnəkə tə gwè dàa laa təmə bɔŋ-bu-leʼnə bɛ ghɔ fɛ.</char> <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" /><char style="wj">Kaʼ Tiekətʉ kʉ̌ʉ kə gòʼ təmə nɔʼ shùʼtə chî-ghɔ̄-bə fɛ, təmə mbyu woməsʉʉ imɔʼ nə bìi fɛ. Bɔŋ bʉʼka bʉə ndə ɔ nɔʼ kə séʼ bɔŋ, ɔ nɔʼ shùʼtə mbʉ bəchî.</char><verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21" />
    <char style="wj">“Bɔŋ kaʼ wo gìe tʉ bii ndʉʉghɔfii mbɔ, ‘B̈ii nyíɛ! Mbʉ Wo ndə Nyii Kùŋ Tə́ŋ nɔ fɛ̄ŋ’ byuunɔ, ‘B̈ii nyíɛ! Ɔ le fīi,’ kə bii mə bɛ́ŋ fɛ.</char> <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" /><char style="wj">Bʉə-mbii ndə bɔ̂ŋ tʉʼ lʉ̀ ŋwɔŋ-yʉə ndə məbɛ bʉə ndə Nyii Kùŋ Tə́ŋ ghɔŋbə bʉəyʉkəŋgieNyii nə mbii bu kóʼ kə́ chìi nubəcheʼbə leʼnə nuchíechubə ndə məfə́ʼhə bʉə, kaʼ i kʉ̌ʉ yùhə təmə bɔ̂ŋ nɔ buŋ fə́ʼhə bʉə ndə bə nɔʼ kə séʼ bɔŋ.</char> <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" /><char style="wj">Bɔŋ b̈ii láa, mɔ nɔʼ shyíi bii nə nubə-bɔ̄ŋ inchəŋ, i buŋ yi fyú sê.</char><verse eid="MRK 13:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="MRK 13:24" />
    <char style="wj">Bɔŋ kʉ̂ʉ nə bɛ mu bəchî-ghɔ̄ ndə ŋgʉəʼ shʉ́əshʉ́ə nɔʼ tíŋ nɔ,</char></para>
  <para style="q2" vid="MRK 13:24">
    <char style="wj">njəŋkə gwù ndəŋ chichi, təmə chisuu leʼ báa fɛ,</char><verse eid="MRK 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25" />
    <char style="wj">bəlɔʼɔ kə́ gwùtə hə yuo,</char></para>
  <para style="q2" vid="MRK 13:25">
    <char style="wj">bə bɔŋleʼ ŋɛ̀hə nu-shʉ́əshʉ́ə-bə ndə bɔ̂ŋ bɛ yuo.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">13:25 </char>
      <char style="ft" closed="false">Adaya 13:10, 34:4; Joɛ 2:10.</char>
    </note><verse eid="MRK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26" />
    <char style="wj">“Ndʉʉmɛ, bɔ̂ŋ bu nyíɛ Vaa-Woməsʉʉ, ɔ kə́ shíʼ gwè hə mu kəmbɔʼ nə fɔŋ ghʉəʼ-shʉ́əshʉ́ə-kə leʼnə məŋwɔʼ.</char> <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" /><char style="wj">Ndʉʉmɛ, ɔ bu tə́ŋ bʉəntəŋ-bi kɔ́ mbi chə̀ŋtə bʉə-bi ndə ɔ nɔʼ kə séʼ bɔŋ ndə byûu-mbi-tə kwi, lʉ̀ hə ndəŋ byûu-mbi-tə, tə gɛ̀ dàa ndəŋ byûu-yuo-tə.</char><verse eid="MRK 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />
    <char style="wj">“B̈ii lʉ̀ ndaa ndəŋ tyʉ-fik-kə nduɔ. Ndʉʉ ndə ntɔŋtə-i wùʼtə chʉ́ʉhə məkɔ́ fyuŋ-fefe-bə, bii kínə mbɔ ndʉʉkəbyʉʉ nɔʼ kə́ŋhə.</char> <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" /><char style="wj">Nɔ bɛ haʼ nɔ ghɔ, ndʉʉ ndə bii nyíɛ nubə-ɔ̄ŋ kə́ fyú sê, b̈ii kínə mbɔ ɔ nɔʼ kə́ŋhə, mbʉə mbʉ təchulɔŋ.</char> <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" /><char style="wj">Nɔʼ m̈ɔ shyíi bii nə shʉəŋ mbɔ, ŋgwie-wo-ɔ̄ kʉʉ mì təmə nubə-ɔ̄ŋ inchəŋ nɔʼ fyú sê fɛ.</char> <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" /><char style="wj">Yuo ghɔŋbə chisêkə bu mì təmə ŋgiekə-ɔŋ bɔŋ bu nə mì fɛ.</char><verse eid="MRK 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />
    <char style="wj">“Bɔŋ ndə chî-ghɔ̄-kə byuunɔ mbʉ ndʉʉ ndə ɔ bu gwè chɔ, wotəmiyɔŋ kínə fɛ, tə buŋ kɔmə bʉəntəŋNyii ndə bɔ̂ŋ bɛ yuo, byuunɔ mbʉ Vaa, nɔ bɔŋ kínə haʼ mbʉ Tie tətɛʼ ɔ.</char> <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" /><char style="wj">B̈ii láa, gòʼ nə tʉbə-ii ghɔʼ,</char> <note caller="+" style="f"><char style="fr" closed="false">13:33 </char><char style="ft" closed="false">Bəbɛʼbəŋwɔʼnə kəŋgie-Gili nɔ bìʼ </char><char style="it">kə́ gháaNyii.</char></note> <char style="wj">bʉʼka bii kínə ndʉʉ ndə mbʉ ŋgwɔʼmbi bu gwè chɔ fɛ.</char><verse eid="MRK 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 13:34" />
    <char style="wj">“Məgwè wo ndə Nyii Séʼ bəkɔ bə fʉ̀ʼ mbʉə wo ndə ɔ tʉʼ gɛ̀ mətòʼ, ndʉʉ ndə ɔ kə lɔ̀ hə fu-ɔ, ɔ kɔ́ fɔʼtə mu kəghɔ-vâafɔʼɔ-bi, kàhə vaafɔ̀ʼ ndə ɔ tʉʼ chyìi chulɔŋ mbɔ ɔ̈ gòʼ nə tʉkə-i ghɔʼ.</char> <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" /><char style="wj">Nɔ, b̈ii káa nə tʉbə-i ghɔʼ bʉʼka bii kínə ndʉʉ ndə mbʉ ŋwɔ̌ŋ-njaa bu gwè chɔ fɛ, kə bu bɛ ndʉʉbuumbi, kə bu bɛ ndʉʉkwɔnəmbi, kə bu bɛ ndʉʉfiimbi ndə ŋkʉəʼə bu tʉʉ, byuunɔ ndʉʉsɛŋkə</char> <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" /><char style="wj">kə ɔ mə nə kə kwɔnə gwè nyíɛ bii, bii kə́ bɛ́ŋbɛ́ŋ fɛ.</char> <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" /><char style="wj">Nukə ndə mɔ tʉʼ gìe tʉ bii, mɔ nɔ tʉʼ gìe tʉ bʉə bənchəŋ. B̈ii gòʼ nə tʉbə-i ghɔʼ.”</char><verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">Bə yóʼ Jiso Bɛtani</para>
  <para style="r">(<ref loc="MAT 26:1-13">Matia 26:1-13</ref>; <ref loc="LUK 22:1-2">Luk 22:1-2</ref>; <ref loc="JHN 11:45-53">Jɔŋ 11:45-53</ref>; <ref loc="JHN 12:1-8">12:1-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Nɔ kə bíe chîbə ibûu chî-Yíɛʼsii-kə buŋ gwè ghɔŋbə chî-Nchəŋtə-kə ndə bə Kwó Bele təmə yî chɔ fɛ. Bətiefɛ̀ʼndɛŋNyii ghɔŋbə bʉə dàhə nuʼ-Mushi nɔ nə kə́ kʉ́ʉ fia ndə məyá Jiso bɔ̌ŋbɔ̌ŋ yi ɔ. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />Bʉʼka bɔ̂ŋ nɔ nə kə́ ghɔ̀ŋ mbɔ, “Bɔŋ i kie ndə məbɛ ndə chî-nchəŋtə-kə fɛ, bʉʼka bʉə mə yi ŋɛ̀hə ntɔŋntɔŋ.”<verse eid="MRK 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Ndʉʉ ndə Jiso kə bɛ Bɛtani mu njaa-Samu ndə ɔ bɛ wo-kəlɔ. Ndə ɔ kə dùʼ tiɛŋ tebele ndə məyú fɔbə, wokebɛʼ gwè nə vaakətəŋ-məŋgwo ndə bə chìi nə ŋgoʼbɛʼ bə kə́ tíi nə alabasta leʼnə ŋkɛŋ ŋgwo-chuɔŋ-chyʉʉchyʉʉ-mə muŋgɔ. Ŋgwomə-ɔ̄ŋ yɔ̂ʼkə-i nɔ kə bʉ̀ʉ daa, bə chìi nə tyʉbɛʼkə ndə bə kə́ tíi nə naa təmə bə nɔʼ fyìʼnə fɛ. Ɔ sáa mbʉ kətəŋ véʼ kətʉ Jiso. <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />Bəbɛʼbʉə ndə bɔ̂ŋ kə bɛ chɔ, kə́ bíʼtə tʉ bəbɛʼbʉə nə tʉʉbʉə mbɔ, “Chìi ka bə kə́ bʉ́əhə ŋgwo-chuɔŋ-chyʉʉchyʉʉ-mə-ɔ̄ŋ mənɔ? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Bə nɔ kə kə́ kʉ̌ʉ fɛ̀ŋ ŋgwomə-ɔ̄ŋ i tíŋ kyʉə-fɔʼɔ-ŋgʉʼʉmbi, gyʉ̀ətə kyʉə-ɛ tʉ bʉə-mbʉʼ.” Bɔ̂ŋ sɔ́ʼ ɔ shʉ́əshʉ́ə. <verse eid="MRK 14:5" /><verse number="6" style="v" sid="MRK 14:6" />Bɔŋ Jiso bə̀ŋhə mbɔ, <char style="wj">“B̈ii mɛ̀ʼtə ɔŋ chɔ, bii tʉʼ chɔ́ŋhə woke-ɔ̄ mbuka? Ɔ nɔʼ fɔ̀ʼ yʉʼ kənu ndəŋ mɔ.</char> <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" /><char style="wj">Bʉʼka biibə bʉə-mbʉʼ bu kə́ bɛ mɔʼɔ, ndʉʉtəmiyɔŋ ndə bii kʉ̀ʉ, bii bu fɔ̀ʼ nu-jyujyu-bə tʉ bɔŋ. Bɔŋ təmə kʉʉ kə́ kie mɔ təvɛʼtəvɛʼ fɛ.</char> <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" /><char style="wj">Ɔ nɔʼ fɔ̀ʼ nukə ndə bəkɔ ɔ fɔ̀ʼ, ɔ nɔʼ yóʼ mbʉə-ɔ, mɔ buŋ yi kwú bə tyúu mɔ.</char> <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" /><char style="wj">M̈ɔ shyíi bii nə shʉəŋ mbɔ yəŋkə təmiyɔŋ ndə bə lɔ̀ʼ mbʉ ntəŋjyujyu chɔ mu kəwʉʉnəmbi inchəŋ, nukə ndə woke-ɔ̄ nɔʼ chìi, bə bu kə́ fʉ̀ʼtə ndə mə-kə́-kwɛ́nə ɔŋ.”</char><figure style="fig" alt="Jesus anointed in the house of Simon the leper" file="WA03839b.tif" size="col" copy="Graham Wade" ref="14:9">Bə núʼ Jiso mu njaa Simu wo-kəlɔ</figure><verse eid="MRK 14:9" /></para>
  <para style="s">Juda bɛ́ŋ ndə məfɛ̀ŋ Jiso</para>
  <para style="r">(<ref loc="MAT 26:14-16">Matia 26:14-16</ref>; <ref loc="LUK 22:3-6">Luk 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Juda Iskalo ndə ɔ kə bɛ mbyu wo mu vâafɔʼɔ-bi njuɔ bûu nə wuŋ, lɔ̀ gɛ̀ bìatə bətiefɛ̀ʼndɛŋNyii ndə məfɛ̀ŋ Jiso tʉ bɔŋ. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Ndʉʉ ndə bɔ̂ŋ kə yʉ́, tʉʉ-yʉə bʉ̀ʉ, bɔ̂ŋ kɔ̀ʼnə ndə məkɔ́ kyʉə tʉ ɔŋ. Ɔ kə́ kʉ́ʉ yʉʼ fia ndə məfɛ̀ŋ ɔŋ tʉ bɔŋ.<verse eid="MRK 14:11" /></para>
  <para style="s">Jiso yú nchəŋtə Yíɛʼsii ghɔŋbə vaafɔ̀ʼ-bi</para>
  <para style="r">(<ref loc="MAT 26:17-30">Matia 26:17-30</ref>; <ref loc="LUK 22:7-23">Luk 22:7-23</ref>; <ref loc="JHN 13:21-30">Jɔŋ 13:21-30</ref>; <ref loc="1CO 11:23-25">1 Kɔlɛŋ 11:23-25</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Nɔ nə bɛ ndəŋ fəŋ kəchî Nchəŋtə ndə bə Kwó Bele təmə yî chɔ fɛ le, chîkə ndə bə síi Vaabinjyʉʉ Yíɛʼsii chɔ ndə məfɛ̀ʼndɛŋ nə yɔŋ. Vâafɔʼɔ-bi bíʼtə tʉ ɔŋ mbɔ, “A kʉ̀ʉ mbɔ baʼa gɛ̀ shʉ̀tə fa tʉ a ndə məyú mbʉ Yíɛʼsii?” <verse eid="MRK 14:12" /><verse number="13" style="v" sid="MRK 14:13" />Ɔ tə́ŋ vâafɔʼɔ-bi bəbûu, ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“B̈ii gɛ̀ mu kəyəŋkwɛʼtəŋ, woləŋbɛʼ bu bìatə bii ndə ɔ bɛ̀ʼ təŋ-muu-kə, b̈ii gɛ̀ hə bɔ̌ŋ ɔŋ.</char> <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" /><char style="wj">Yəŋkə təmiyɔŋ ndə ɔ sʉ́ʉ chɔ, bii gìe tʉ mbʉ ŋwɔ̌ŋ-njaa mbɔ, ‘Chicha nɔ tʉʼ bíʼtə tʉ a mbɔ njəŋ-njaa-bʉə-mətòʼ ba, ndə bəkɔ mɔ yú fɔ-Yíɛʼsii-bə chɔ baʼabə vâafɔʼɔ-bɔŋ?’</char> <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" /><char style="wj">Ɔ bu dʉ̀ʼ njəŋ-njaakwɛʼtəŋ tʉ bii kweghɔʼ ndə bə nɔʼ shʉ̀tə mu-i tə i kʉ̀ʼnə, b̈ii shʉ̀tə chɔ tʉ bʉʼʉ.”</char> <verse eid="MRK 14:15" /><verse number="16" style="v" sid="MRK 14:16" />Mbʉ vâafɔʼɔ-bi lɔ̀ gɛ̀ mbʉ mu kəyəŋkwɛʼtəŋ-ghɔ̄, gɛ̀ nyíɛ nubə kɛŋ haʼ ndə ɔ kə shyíi bɔŋ, bɔ̂ŋ shʉ̀tə mbʉ bəfɔ Yíɛʼsii chɔ.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />Kʉ̂ʉ bɛ ndʉʉbuumbi, ɔ gwè ghɔŋbə vâafɔʼɔ-bi njuɔ bûu nə wuŋ. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Ndə bɔ̂ŋ dùʼtə mbʉə tebele kə́ yú fɔbə, Jiso ghɔ̀ŋ mbɔ, <char style="wj">“Nɔʼ m̈ɔ shyíi bii nə shʉəŋ mbɔ, mbyu wo mu bii bu fɛ̀ŋ mɔ, wo ndə baʼa ɔ tʉʼ yú mɔʼɔ.”</char><verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />I chʉ́ʉhə məchɔ́ŋhə bɔŋ, bɔ̂ŋ kə́ bíʼtə tʉ ɔŋ bəmɔʼbəmɔʼ mbɔ, “Bɛ mɔ mɛ?”<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />Ɔ bə̀ŋhə tʉ bɔŋ mbɔ, <char style="wj">“Nɔ bɛ mbyu wo-imɔʼ mu mbʉ bʉə njuɔ bûu nə wuŋ, wo ndə ɔ tʉʼ chùo bele baʼa ɔ mɔ̀ʼ mu kyʉʉ.</char> <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" /><char style="wj">Bʉʼka Vaa-Woməsʉʉ bu gɛ̀ haʼ ndə bə nɔʼ kə nyɔ̀ʼ te ɔ, bɔŋ ŋgʉəʼ kətʉ wo ndə ɔ bu fɛ̀ŋ ɔŋ! I nɔ kə buŋ bɛ jyujyu tʉ wo-ghɔ̄ kaʼ bə kʉ̌ʉ kə gòʼ təmə bí ɔ fɛ.”</char><verse eid="MRK 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Ndə bɔ̂ŋ kə́ yú fɔbə, ɔ lʉ̀ bele, kʉ̂ʉ kɔ́ ndɔ chɔ tʉ Nyii, bə́ʼtə, kɔ́ tʉ vâafɔʼɔ-bi, ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“B̈ii kɔ́, nɔ bɛ mbɔʼ mbʉə-ɔ nɔ.”</char> <verse eid="MRK 14:22" /><verse number="23" style="v" sid="MRK 14:23" />Ɔ leʼ lʉ̀ ndʉ̂ʉ, kʉ̂ʉ kɔ́ ndɔ tʉ Nyii, chɔ̀ʼhə kɔ́ tʉ bɔŋ, bɔ̂ŋ bənchəŋ nú hə muŋgɔ. <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />Ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Nɔ bɛ fɔbʉəkə-ɔŋ nɔ ndə i kɔ́ʼ mbʉ məŋkaa, ndə bə tyú yie bʉə buŋmbi.</char> <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" /><char style="wj">Nɔʼ m̈ɔ shyíi bii nə shʉəŋ mɔ bieleʼ nə bìʼ nú ndʉʼmə-ɔ̄ŋ fɛ, tə chî-ghɔ̄-kə nə gwè ndʉʉ ndə mɔ bu nú fefe ndʉʉ ndə Nyii bu sɔ́ʼ bʉə-bi ndə fɔŋ.”</char> <verse eid="MRK 14:25" /><verse number="26" style="v" sid="MRK 14:26" />Ndʉʉmɛ, bɔ̂ŋ yùɔ lyuu, lɔ̀ kóʼ gɛ̀ ndəŋ Kwɔŋ-bəTyʉ-Oli.<verse eid="MRK 14:26" /></para>
  <para style="s">Jiso núhə tʉ Bita mbɔ ɔ la bu tɛ́ŋ ɔŋ i buŋ yi fyú sê</para>
  <para style="r">(<ref loc="MAT 26:31-35">Matia 26:31-35</ref>; <ref loc="LUK 22:31-34">Luk 22:31-34</ref>; <ref loc="JHN 13:36-38">Jɔŋ 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />Jiso ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Bii bənchəŋ bu nyʉ́ʉ wɔ̀ʼnə tʉ́ʼ mɔ, bʉʼka bə nɔ nə nyɔ̀ʼ mu ŋwɔʼnə-Nyii mbɔ, ‘Mɔ bu yi nchyii-binjyʉʉhə, mbʉ binjyʉʉhə nyʉ́ʉ wɔ̀ʼnə.’</char> <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" /><char style="wj">Bɔŋ ndʉʉ ndə mɔ bu bʉ̀nə kóʼ nɔ, mɔ bu gɛ̀ bəshʉ mu Galili.”</char> <verse eid="MRK 14:28" /><verse number="29" style="v" sid="MRK 14:29" />Bita ghɔ̀ŋ tʉ ɔŋ mbɔ, “Kaʼ buŋ kʉ̀ʉ bʉə bənchəŋ nyʉ́ʉ wɔ̀ʼnə tʉ́ʼ a, mɔ kʉʉ nyʉ́ʉ fɛ.” <verse eid="MRK 14:29" /><verse number="30" style="v" sid="MRK 14:30" />Jiso ghɔ̀ŋ tʉ ɔŋ mbɔ, <char style="wj">“Mɔ shyíi a nə shʉəŋ mbɔ, ndʉʉbətyuʼ-ɔ̄ ŋkʉəʼə bu yi kə tʉ́ʉ vɛʼ bûu nɔ, tʉ a nɔʼ kɔ́tuu a vɛʼ tia mbɔ a la kínə mɔ fɛ.”</char> <verse eid="MRK 14:30" /><verse number="31" style="v" sid="MRK 14:31" />Bita gìe shʉ́əshʉ́ə mbɔ, “Kaʼ kʉ̀ʉ i bɛ mbɔ b̈aʼa kwú mɔʼɔ, mɔ mə nə tɛ́ŋ aŋ fɛ.” Bɔ̂ŋ bənchəŋ bə̀ŋhə haʼ nɔ.<verse eid="MRK 14:31" /></para>
  <para style="s">Jiso gháaNyii Gɛsemani</para>
  <para style="r">(<ref loc="MAT 26:36-46">Matia 26:36-46</ref>; <ref loc="LUK 22:39-46">Luk 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Bɔ̂ŋ gɛ̀ dàa kəyəŋbɛʼ bə kə́ tíi nə Gɛsemani. Ɔ gìe tʉ vâafɔʼɔ-bi mbɔ, <char style="wj">“B̈ii dùʼtə fɛ̄ŋ, m̈ɔ gɛ̀ gháaNyii.”</char> <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Ɔ lʉ̀ Bita, Jɛŋ leʼnə Jɔŋ, mbʉə-e chʉ́ʉhə kə́ dìe daa, bɔŋ-kə́-leʼ chɔ́ŋhə ɔŋ. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Fyii-ɔ tʉʼ chɔ́ŋhə mɔ daa, tə kə́ dʉ̀ʼ kwú. B̈ii káa fɛ̄ŋ, kə́ kíi dyʉʼbə.”</char><verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />Ɔ kʉ̂ʉ kwɛ̀ʼtə gɛ̀ məniʼ, bè kweʼtəbə-i sê gháaNyii mbɔ, <char style="wj">“Kaʼ kʉʉ bɛ mbɔ i yùhə, ŋ̈gwɔʼmbi-ɔ̄ kwɛ̀ʼtə mbʉə mɔ.”</char> <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />Ɔ ghɔ̀ŋ mbɔ, <char style="wj">“Baba, Tie-ɔ, nubɛʼkə bɛ ghɔ ndə i chàa a fɛ. Fí ndʉ̂ʉ ŋgʉəʼ-ɔ̄ hə kəghɔ-mɔ, kə a mə fɔ̀ʼ bə ŋkʉʉnə-tʉʉ-ɔ fɛ, fɔ̀ʼ bə ya-yə ŋkʉʉnə tʉʉ.”</char> <verse eid="MRK 14:36" /><verse number="37" style="v" sid="MRK 14:37" />Ɔ gwè nyíɛ bɔŋ, bɔ̂ŋ kə́ bɛ́ŋbɛ́ŋ, ɔ ghɔ̀ŋ tʉ Bita mbɔ, <char style="wj">“Samu, a tʉʼ bɛ́ŋbɛ́ŋ mɛ? Bɛ mbɔ a mə kíi dyʉʼbə ndə vaa kəkʉʉ mbi fe?</char> <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" /><char style="wj">B̈ii kə́ kíi dyʉʼbə bɔŋleʼ gháaNyii bʉʼka bii mə yi gwù mu nubə ndə i mùutə wo ndə məgwù mu bʉ̂ʼʉ. Mbʉ fyii nɔ bɛ chɔ, bɔŋ mbɔʼ mbʉə lʉ́ʉtə.”</char><verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />Ɔ bìʼ gɛ̀ gháaNyii kə́ gìe haʼ nubə ndə ɔ nɔʼ kə gìe. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Ɔ bʉ̀nə bìʼ gwè nyíɛ bɔŋ, bɔ̂ŋ kə́ bɛ́ŋbɛ́ŋ, bʉʼka shʉtə-ʉə nɔ nə bɛ idìenə daa nə mbɛŋhə, təmə bɔ̂ŋ kínə nukə ndə məgìe tʉ ɔŋ fɛ. <verse eid="MRK 14:40" /><verse number="41" style="v" sid="MRK 14:41" />Ɔ bʉ̀nə bìʼ gwè ndə vɛʼ tia, ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Bii bíe bɛ́ŋ mbɛŋhə-ii kə́ káa mɛ? I nɔʼ kʉ̀ʼnə, mbʉ ndʉʉ-ghɔ̄ nɔʼ gwè. Bə nɔʼ kɔ́ Vaa-Woməsʉʉ mu kəghɔ-bʉə bʉ̂ʼʉ.</char> <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" /><char style="wj">B̈ii lɔ̀ hə sê b̈ʉʼʉ kə́ gɛ̀, b̈ii nyíɛ, wo ndə ɔ fɛ̀ŋ mɔ nɔʼ kə́ŋhə.”</char><verse eid="MRK 14:42" /></para>
  <para style="s">Bə fɛ̀ŋ Jiso bɔŋleʼ yá ɔ</para>
  <para style="r">(<ref loc="MAT 26:47-56">Matia 26:47-56</ref>; <ref loc="LUK 22:47-53">Luk 22:47-53</ref>; <ref loc="JHN 18:3-12">Jɔŋ 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Haʼ ndʉʉmɛ, ndə ɔ kə́ bíe kwə́ʼ, Juda gwè, ndə ɔ bɛ mbyu wo mu vâafɔʼɔ-bi njuɔ bûu nə wuŋ, ghɔŋbə nuɔ-bʉə nə setəbə ghɔŋbə mbuuhə kəghɔ-bɔŋ. Nɔ kə tə́ŋ bətiefɛ̀ʼndɛŋNyii, bʉə dàhə nuʼ-Mushi leʼnə bəntəŋbəshʉ tə́ŋ bɔŋ. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />Mbʉ wo ndə ɔ kə fɛ̀ŋ ɔŋ nɔʼ kə kɔ́ cheʼkə tʉ bɔŋ, ghɔ̀ŋ mbɔ, “Wo ndə mɔ bu bɔ́nə ɔŋ ndə nchaʼtə nɔ bɛ mbʉ wo-ghɔ̄. B̈ii yá ɔ, lʉ̀ ɔ, kə́ chyìi ɔ, gɛ̀ nə nɔŋ.” <verse eid="MRK 14:44" /><verse number="45" style="v" sid="MRK 14:45" />Ndʉʉ ndə Juda kə gwè, ɔ kwɛ̀ʼtə gɛ̀ mbʉə-Jiso, ghɔ̀ŋ tʉ ɔŋ mbɔ, “Chicha!” yá ɔ, bɔ́nə ɔŋ. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Bɔ̂ŋ mɔ̀ʼ ghɔbə-ʉə ndəŋ ɔŋ, yá ɔ. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Bɔŋ ibɛʼ-yə mbyu wo ndə bɔ̂ŋ kə tə́nə chɔ, sʉ̀ʉ setəkə-i gwìa tyunə-fʉə-tiefɛ̀ʼndɛŋkwɛʼtəŋNyii-kə chɔ chʉ̀ə. <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />Jiso ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“Bii tʉʼ gwè tʉ mɔ nə setəbə ghɔŋbə mbuuhə təka fi nə bii tʉʼ gwè tʉ lʉʼ shùɔ wo ndə məyá mɔ?</char> <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" /><char style="wj">Mɔ nɔ nə kə́ bɛ bʉʼʉ kə́ dàhə mu chunjaafɛ̀ʼndɛŋNyii bəchibəchi təmə bii yá mɔ fɛ. Bɔŋ yɔ̄ŋ-yə nɔ bɛ ndə məchìi ŋgieNyiikə fyú shʉəŋ.”</char><verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />Vâafɔʼɔ-bi bənchəŋ mɛ̀ʼtə ɔŋ nyʉ́ʉ nə wʉə. <verse eid="MRK 14:50" /><verse number="51" style="v" sid="MRK 14:51" />Vaakəyɔwobɛʼ nɔ nə gɛ̀ hə bɔ̌ŋ liɛŋ-ɔŋ təmə mɔ̀ʼ ndyi fɛ, lʉ́əŋ bə haʼ vaa-kwii-ndyi mbʉə-ɔ. Mbʉ nuɔ-bʉə kʉ̂ʉ kə́ kɔ̀ɔtə ndə məyá ɔ, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />ɔ nyʉ́ʉ mɛ̀ʼ mbʉ ndyi, nyʉ́ʉ lɔŋlɔŋ.<verse eid="MRK 14:52" /></para>
  <para style="s">Bə gɛ̀ nə Jiso mu kaŋsotə</para>
  <para style="r">(<ref loc="MAT 26:57-68">Matia 26:57-68</ref>; <ref loc="LUK 22:54-55">Luk 22:54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Jɔŋ 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Bə lʉ̀ Jiso gɛ̀ nə nɔŋ fu-tiefɛ̀ʼndɛŋkwɛʼtəŋNyii. Bətiefɛ̀ʼndɛŋNyii bənchəŋ ghɔŋbə bəntəŋbəshʉ leʼnə bʉə dàhə nuʼ-Mushi chə̀ŋtə bənchəŋ. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Bita nɔ kə kə́ gwè hə bɔ̌ŋ ɔŋ dɔdɔ, gwè tə ŋíi mu sêfu-tiefɛ̀ʼndɛŋkwɛʼtəŋNyii. Ɔ gwè dùʼ ghɔŋbə bʉə chyìi mbʉ kəyəŋ kə́ yóʼ viʼi.<verse eid="MRK 14:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55" />Nduɔ, bətiefɛ̀ʼndɛŋNyii ghɔŋbə ŋguu-kaŋsotə-hə bənchəŋ kə́ kʉ́ʉ wo ndə ɔ bu bɛ́ŋ mbɔ Jiso bɛ wo-bʉ̂ʼʉ, bɔ̂ŋ chʉʼ yi ɔ, bɔŋ təmə bɔ̂ŋ nyíɛ wo fɛ. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Bʉʼka bʉə buŋmbi nɔ kə́ chʉ̀ə lɛɛŋkə kətʉ-ɔ, bɔŋ nubə ndə bɔ̂ŋ kə́ gìe kətʉ-ɔ nɔ kə bɛ ŋkʉʉŋkʉʉ. <verse eid="MRK 14:56" /><verse number="57" style="v" sid="MRK 14:57" />Bəbɛʼbʉə lɔ̀ tə́nə kə́ chʉ̀ə lɛɛŋkə kətʉ-ɔ kə́ ghɔ̀ŋ mbɔ, <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />“Baʼa nɔ yʉ́ ɔ, ɔ kə́ ghɔ̀ŋ mbɔ, ‘Mɔ bu kùu njaafɛ̀ʼndɛŋNyii-ɔ̄ŋ ndə bɔ́ŋ woməsʉʉ nə ghɔkə, bɔ́ŋ yi-kədɔŋ-yə ndə chîbə itia, təmə bə bɔ́ŋ nə ghɔkə fɛ.’ ” <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Buŋ ndə nubə ndə bɔ̂ŋ kə́ gìe nɔ, bɔ̂ŋ kə kie ŋgiekə imɔʼ fɛ.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />Ndʉʉmɛ, tiefɛ̀ʼndɛŋkwɛʼtəŋNyii lɔ̀ tə́nə bəshʉ bəbɛʼbʉə, bíʼtə tʉ Jiso mbɔ, “A kie ŋgiekə ndə məbə̀ŋhə tʉ bɔŋ fe? Bɛ ka ndə a kie ndə məgìe te nubə-ɔ̄ŋ ndə bʉə-bɔ̄ŋ gìe kətʉ-a nɔ?” <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />Ɔ líitə mbɔ loʼo təmə bə̀ŋhə nukə fɛ. Mbʉ tiefɛ̀ʼndɛŋkwɛʼtəŋNyii bíʼtə tʉ ɔŋ mbɔ, “A bɛ mbʉ Wo ndə Nyii Kùŋ Tə́ŋ mɛ, Vaa-Wo ndə baʼa tʉʼ lə̀ʼtə ɔŋ mɛ?” <verse eid="MRK 14:61" /><verse number="62" style="v" sid="MRK 14:62" />Jiso bə̀ŋhə mbɔ, <char style="wj">“Mɔ nɔ bɛ ɔ, bii bɔŋ bu nyíɛ Vaa-Woməsʉʉ, ɔ kə́ dùʼ ndəŋ kwiiləŋ wo shʉ́əshʉ́ə, kə́ gwè hə ndəŋ mbɔʼ-yuo-kə.”</char> <verse eid="MRK 14:62" /><verse number="63" style="v" sid="MRK 14:63" />Bɔŋ mbʉ tiefɛ̀ʼndɛŋkwɛʼtəŋNyii jɔ̀ʼtə ndyihə-i ghɔ̀ŋ mbɔ, “Bʉʼʉ tʉʼ kʉ́ʉ leʼ yʉ́ ka nduɔ kəghɔ-bəbɛʼbʉə te ɔ? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />Bii nɔʼ yʉ́ ndə ɔ bʉ́əhə yie Nyii. Bii ghɔ̀ŋ mbuka chɔ?” Bɔ̂ŋ bənchəŋ ghɔ̀ŋ mbɔ ɔ la nɔʼ gwù, bə kie ndə məyí ɔ.<verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />Bəbɛʼbʉə chʉ́ʉhə mətyùtə ntɛmə ndəŋ ɔŋ, kə́ bɔ̀ŋ shʉ-i bɔŋ-kə́-leʼ gwúu ɔ, kə́ ghɔ̀ŋ tʉ ɔŋ mbɔ, “Tɔ wo ndə ɔ kwɔ̀ŋ aŋ!” Mbʉ bʉə ndə bɔ̂ŋ kə́ chyìi yəŋbə lʉ̀ ɔ nə fʉəŋbə.<verse eid="MRK 14:65" /></para>
  <para style="s">Bita tɛ́ŋ Jiso</para>
  <para style="r">(<ref loc="MAT 26:69-75">Matia 26:69-75</ref>; <ref loc="LUK 22:56-62">Luk 22:56-62</ref>; <ref loc="JHN 18:15-18">Jɔŋ 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Ndə Bita kə dùʼ tiɛŋ mbɔŋ sêfu, mbyu vaafɔ̀ʼ tiefɛ̀ʼndɛŋkwɛʼtəŋNyii ndə ɔ bɛ vaabəke gwè, <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />nyíɛ Bita ɔ kə́ yóʼ viʼi, ɔ lɛ́nə ɔŋ shʉ-ɔ, ghɔ̀ŋ mbɔ, “Mbəŋ-aŋ ghɔ nɔ nə bɛ bii Jiso ndə ɔ lɔ̀ hə Nasalɛ.” <verse eid="MRK 14:67" /><verse number="68" style="v" sid="MRK 14:68" />Ɔ kɔ́tuu-i, ghɔ̀ŋ mbɔ, “Mɔ kínə fɛ byuunɔ kə́ yʉ́ nukə ndə a tʉʼ gìe fɛ.” Ɔ lɔ̀ gɛ̀ chulɔŋ, ŋkʉəʼə tʉʉ.<note caller="+" style="f"><char style="fr" closed="false">14:68 </char><char style="ft" closed="false">Bəbɛʼbəŋwɔʼnə kəŋgie-Gili kie </char><char style="it">ŋkʉəʼə tʉʉ</char> fɛ.</note> <verse eid="MRK 14:68" /><verse number="69" style="v" sid="MRK 14:69" />Mbʉ vaafɔ̀ʼ, vaabəke-ghɔ̄ nyíɛ ɔŋ, bìʼ chʉ́ʉhə kə́ gìe tʉ bʉə ndə bɔ̂ŋ kə tə́ŋtə chɔ mbɔ, “Wo-ɔ̄ nɔ bɛ mbyu wo-imɔʼ mu bɔŋ.” <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Ɔ bìʼ tɛ́ŋ. Kʉʉkə məniʼ, mbʉ bʉə ndə bɔ̂ŋ kə tə́ŋtə chɔ, bìʼ gìe tʉ Bita mbɔ, “A nɔ bɛ mbyu wo-yʉə leʼ shʉəŋ bʉʼka a nɔ lɔ̀ hə Galili.” <verse eid="MRK 14:70" /><verse number="71" style="v" sid="MRK 14:71" />Bɔŋ ɔ chʉ́ʉhə ndə mətíi ndɔŋ kɔ́ kətʉ-ɔ bɔŋleʼ kàa nukə, ghɔ̀ŋ mbɔ, “Mɔ buŋ kínə wo-ɔ̄ ndə bii tʉʼ kwə́ʼ te ɔ nɔ fɛ.” <verse eid="MRK 14:71" /><verse number="72" style="v" sid="MRK 14:72" />Haʼ ndʉʉmɛ, ŋkʉəʼə bìʼ tʉ́ʉ ndə vɛʼ bûu. Bita kwɛ́nə nukə ndə Jiso kə gìe tʉ ɔŋ mbɔ, <char style="wj">“Ŋkʉəʼə bu yi kə tʉ́ʉ vɛʼ bûu nɔ, tʉ a nɔʼ kɔ́tuu vɛʼ tia mbɔ a la kínə mɔ fɛ.”</char> I bə́ʼtə Bita, ɔ gwía.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">Bə chɔ̀ʼhə Jiso kɔ́ mu kəghɔ-Bale</para>
  <para style="r">(<ref loc="MAT 27:1-2">Matia 27:1-2</ref>,<ref loc="MAT 27:11-26">11-26</ref>; <ref loc="LUK 23:1-5">Luk 23:1-5</ref>,<ref loc="LUK 23:13-25">13-25</ref>; <ref loc="JHN 18:28-19:16">Jɔŋ 18:28–19:16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Ndʉʉ ndə mbi kə fíi, bətiefɛ̀ʼndɛŋNyii yá nchəŋtə ghɔŋbə bəntəŋbəshʉ leʼnə bʉə dàhə nuʼ-Mushi leʼnə bʉə mu kaŋsotə bənchəŋ. Bɔ̂ŋ kɔ́ʼ Jiso, lʉ̀ ɔ gɛ̀ nə nɔŋ, gɛ̀ chɔ̀ʼhə ɔŋ kɔ́ kəghɔ-Bale. <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />Ndʉʉmɛ, Bale bíʼtə tʉ Jiso mbɔ, “A bɛ mbʉ Fɔŋ-bʉə-Juu mɛ?” Jiso bə̀ŋhə mbɔ, <char style="wj">“Nɔ bɛ ndə a ghɔ̀ŋ.”</char> <verse eid="MRK 15:2" /><verse number="3" style="v" sid="MRK 15:3" />Mbʉ bətiefɛ̀ʼndɛŋNyii súu nubə kətʉ-ɔ buŋmbi. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Bale bìʼ bíʼtə tʉ ɔŋ mbɔ, “A kie nukə ndə məgìe fe? Nyíɛ! Ntyʉʉ bənu ndə bə súu yie-a.” <verse eid="MRK 15:4" /><verse number="5" style="v" sid="MRK 15:5" />Təmə Jiso leʼ bə̀ŋhə fɛ, i chàa Bale.<verse eid="MRK 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Nɔ nə kə́ bɛ ndəŋ chî-nchəŋtə-Yíɛʼsii-kə nɔ, gɔməna fyúhə mbyu wo hə njaa-chaŋ ndə bʉə fʉ̀ʉtə mbɔ ɔ fyúhə. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Ndʉʉ-ghɔ̄ wobɛʼ ndə yie kə bɛ Balaba kə́ bɛ mu njaa-chaŋ ghɔŋbə bəbɛʼbʉə ntɔŋntɔŋ ndə bɔ̂ŋ nɔʼ kə yítə bʉə ndə ntɔŋntɔŋ. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Mbʉ nuɔ-bʉə gwè tʉ Bale kə́ bíʼtə tʉ ɔŋ ndə məchìi haʼ ndə ɔ̃ chìi tʉ bɔŋ. <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />Bɔŋ Bale bə̀ŋhə tʉ bɔŋ mbɔ, “Bii kʉ̀ʉ mbɔ m̈ɔ fyúhə Fɔŋ-bʉə-Juu kɔ́ tʉ bii mɛ?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Bʉʼka ɔ nɔ nə kínə mbɔ bətiefɛ̀ʼndɛŋNyii nɔ nə chɔ̀ʼhə Jiso kɔ́ kəghɔ-ɔ bʉʼka məbàabʉʉ ndə bɔ̂ŋ kie tʉ ɔŋ. <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />Bɔŋ mbʉ bətiefɛ̀ʼndɛŋNyii kɔ́ buŋ mbʉ nuɔ-bʉə mbɔ b̈ɔ̂ŋ téʼ mbɔ ɔ̈ fyúhə Balaba kɔ́ tʉ bɔŋ. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />Bale bìʼ bíʼtə tʉ bɔŋ mbɔ, “Nduɔ, m̈ɔ bɛ təka nə wo ndə bii tʉʼ tíi ɔ nə Fɔŋ-bʉə-Juu nɔ?” <verse eid="MRK 15:12" /><verse number="13" style="v" sid="MRK 15:13" />Bɔ̂ŋ tíitə mbɔ, “Kwɛ̀ŋ ɔŋ yí.” <verse eid="MRK 15:13" /><verse number="14" style="v" sid="MRK 15:14" />Ndʉʉmɛ, Bale ghɔ̀ŋ tʉ bɔŋ mbɔ, “Bʉʼka ka, bɛ ntɛ bʉ̂ʼʉ ka ndə ɔ chìi?” Bɔŋ bɔ̂ŋ bìʼ tíitə nə ghʉəʼkə ghɔ̀ŋ mbɔ, “Kwɛ̀ŋ ɔŋ yi.”<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />Nɔ, bʉʼka Bale kə kʉ̀ʉ mbɔ ɔ chìi tʉʉ mbʉ nuɔ-bʉə bʉ̀ʉ, ɔ fyúhə Balaba kɔ́ tʉ bɔŋ. Kʉ̂ʉ téʼ bə gwúu Jiso nə ŋgwɔŋhə, ɔ chɔ̀ʼhə ɔŋ kɔ́ mbɔ b̈ə gɛ̀ kwɛ̀ŋ ɔŋ yí.<verse eid="MRK 15:15" /></para>
  <para style="s">Bəsɔge dʉ̀ʉhə Jiso</para>
  <para style="r">(<ref loc="MAT 27:27-31">Matia 27:27-31</ref>; <ref loc="JHN 19:2-3">Jɔŋ 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Mbʉ bəsɔge lʉ̀ ɔ gɛ̀ nə nɔŋ mu ntoʼ, sêfu gɔməna, tíi mbʉ nuɔ bəsɔge bənchəŋ. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />Bɔ̂ŋ mɔ̀ʼ ndyi kəmbuu fʉ́əŋ mbʉə-ɔ, túŋ bɛnə nə ŋkinəŋkia, bìa kətʉ-ɔ. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Bɔ̂ŋ chʉ́ʉhə məchàʼtə ɔŋ kə́ ghɔ̀ŋ mbɔ, “C̈hichi báa b̈ə yóʼ bənchəŋ, Fɔŋ-bʉə-Juu!” <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Bɔ̂ŋ kə́ gwúu vaakətyʉ kətʉ-ɔ bìʼ gwúu, kə́ tyùtə ntɛmə ndəŋ ɔŋ bɔŋ-kə́-leʼ bè kweʼtəbə-ʉə sê bəshʉ ɔ ndə məkɔ́ məgʉ́ə tʉ ɔŋ. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Bɔ̂ŋ kʉ̂ʉ dʉ̀ʉhə ɔŋ liʼ, shùɔ mbʉ ndyi kəmbuu fʉ́əŋ, mɔ̀ʼ yi-yə ndyihə mbʉə-ɔ, lʉ̀ ɔ gɛ̀ nə nɔŋ ndə məgɛ̀ kwɛ̀ŋ ɔŋ yí.<verse eid="MRK 15:20" /></para>
  <para style="s">Bə kwɛ̀ŋ Jiso yí</para>
  <para style="r">(<ref loc="MAT 27:32-44">Matia 27:32-44</ref>; <ref loc="LUK 23:26-43">Luk 23:26-43</ref>; <ref loc="JHN 19:17-27">Jɔŋ 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />Wobɛʼ ndə bə kə́ tíi ɔ nə Samu ndə ɔ lɔ̀ hə Silɛŋ, kə́ gwè mu lɔʼɔ ndʉʉ-ghɔ̄, bɔ̂ŋ kwɛ̀ŋhə ɔŋ ɔ bɛ̀ʼ tyʉntɔɔnə-Jiso-kə. Samu nɔ kə bɛ tie-Alɛsaŋnda ghɔŋ Lufɔ. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />Bɔ̂ŋ gɛ̀ dàa nə nɔŋ kəyəŋbɛʼ, bə kə́ tíi nə Gogota (ndə i bɛ mbɔ, “Yəŋ-kəGhʉəʼ-kəTʉ-Wo-kə”). <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Bɔ̂ŋ kɔ́ ndʉʼmə tʉ ɔŋ ndə bə nɔʼ fìnə nə məə<note caller="+" style="f"><char style="fr" closed="false">15:23 </char><char style="ft" closed="false">M̃əə nɔ bɛ jyʉʉhə ndə i lɔ̀ hə ndəŋ tyʉbɛʼkə ndə kaʼ bə fìnə ndʉʼmə kɔ́ tʉ wo ndə yəŋkə tʉʼ líŋ ɔŋ mbʉə-ɔ, i búɔhə məlíŋ.</char></note>, bɔŋ təmə ɔ bɛ́ŋ ndə mənú fɛ. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Bɔ̂ŋ kwɛ̀ŋ ɔŋ, lʉ̀ ndyihə-i gyʉ̀ə kətʉ-bɔŋ, kə́ mɔ̀ʼ njoʼ ndə məkínə ntɛ-kəfɔ ndə bɔ̂ŋ kie ndə məkɔ́ tʉ mbyu wo-imɔʼ. <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />Ndʉʉ ndə bɔ̂ŋ kə kwɛ̀ŋ ɔŋ chɔ, nɔ nə bɛ bəchî bɔmɔʼ ndʉʉsɛŋkə. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Bɔ̂ŋ nyɔ̀ʼ ŋwɔʼnə ndə mədʉ̀ʼ nukə ndə bə kə kwɛ̀ŋ ɔŋ bʉʼka yɔŋ, bíahə ndə i kə́ ghɔ̀ŋ mbɔ, “Fɔŋ-bʉə-Juu.” <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />Bɔ̂ŋ kwɛ̀ŋ ɔŋ ghɔŋbə bəlʉʼʉ shùɔ wo bəbûu mɔʼɔ, mbyu wo-imɔʼ kwiimɔʼnə, ibɛʼ-yə kwiiŋkwie. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />[Ndʉʉghɔfii, ŋgieNyiikə nɔ nə fyú shʉəŋ ndə i ghɔ̀ŋ mbɔ, “Bə nɔ nə súu ɔ mu bʉə-bʉ̂ʼʉ.”] <verse eid="MRK 15:28" /><verse number="29" style="v" sid="MRK 15:29" />Bʉə ndə bɔ̂ŋ kə́ tíŋtə sêfia kə́ chɛ̀ŋtə ɔŋ bɔŋleʼ ŋʉ̀ʼ tʉbə-ʉə ghɔ̀ŋ mbɔ, “Əŋhəŋ! Mbəŋ-aŋ ndə a bu kùu njaafɛ̀ʼndɛŋNyii bʉ̀nə bɔŋ ndə chîbə itia, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />kwáa ŋwɔŋ-aŋ, shíʼ ndəŋ mbʉ kətyʉntɔɔnə!” <verse eid="MRK 15:30" /><verse number="31" style="v" sid="MRK 15:31" />Bətiefɛ̀ʼndɛŋNyii ghɔŋbə bʉə dàhə nuʼ-Mushi kə́ leʼ dʉ̀ʉhə ɔŋ, kə́ ghɔ̀ŋ haʼ nɔ tʉ mbəŋtə-ʉə mbɔ, “Ɔ nɔ nə kə́ kwáa bəbɛʼbʉə, təmə bɔŋ mə kwáa ŋwɔŋ-ɛŋ fɛ. <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />M̈bʉ Wo ndə Nyii Kùŋ Tə́ŋ, Fɔŋ-bʉə-Isilɛ, shíʼ nduɔ ndəŋ mbʉ kətyʉntɔɔnə b̈aʼa nyíɛ chʉʼ bɛ́ŋ ɔŋ.” Mbʉ bʉə ndə bə kə kwɛ̀ŋ ɔŋ ghɔŋ bɔŋ mɔʼɔ kə́ leʼ chɛ̀ŋtə ɔŋ ghɔ.<verse eid="MRK 15:32" /></para>
  <para style="s">Kwu-Jiso</para>
  <para style="r">(<ref loc="MAT 27:45-56">Matia 27:45-56</ref>; <ref loc="LUK 23:44-49">Luk 23:44-49</ref>; <ref loc="JHN 19:28-30">Jɔŋ 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Kʉ̂ʉ bɛ ndʉʉbeʼ, njəŋkə gwù mu lɔʼɔ-ghɔ̄ inchəŋ tə gɛ̀ dàa ndə bəchî itia ndʉʉnəchî. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Kʉ̂ʉ bɛ ndə bəchî itia ndʉʉnəchî Jiso tíi nə gyʉʉ dədə ghɔ̀ŋ mbɔ, <char style="wj">“Ɛlo, Ɛlo, lema sabatani?”</char> Ndə i bɛ mbɔ, <char style="wj">“Oo Nyii, Oo Nyii, a mɛ̀ʼtə mɔ mbuka?”</char> <verse eid="MRK 15:34" /><verse number="35" style="v" sid="MRK 15:35" />Bəbɛʼbʉə ndə bɔ̂ŋ kə tə́ŋtə mbʉə ɔ kʉ̂ʉ yʉ́, ghɔ̀ŋ mbɔ, “B̈ii yʉ́, ɔ tʉʼ tíi Ɛlaja.” <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />Wobɛʼ nyʉ́ʉ gɛ̀ chùo kɔŋ-búɔnə-kə mu ndʉʼ-chyʉ́ʉtə-mə, fùɔ kətʉ kətyʉ, kɔ́ tʉ ɔŋ mbɔ ɔ̈ nú, kə́ ghɔ̀ŋ mbɔ, “B̈ii tə́nə, b̈ʉʼʉ nyíɛ ndə Ɛlaja bu gwè shúʼhə ɔŋ.” <verse eid="MRK 15:36" /><verse number="37" style="v" sid="MRK 15:37" />Jiso tíi nə ghʉəʼkə yìhə ndyiʼtə-bəyihə-kə-i. <verse eid="MRK 15:37" /><verse number="38" style="v" sid="MRK 15:38" />Ndyi ndə bə kə chyúu kyʉ̀hə mu njaafɛ̀ʼndɛŋNyii nə yɔŋ jɔ̀ʼnə fyú viabə ibûu, lʉ̀ hə kweghɔʼ gɛ̀ dàa sê. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Wokwɛʼtəŋ-bəsɔge-ghyʉʉ ndə ɔ kə tə́nə bə̀ŋhə ɔŋ, kʉ̂ʉ nyíɛ ntɛ ndə ɔ yìhə ndyiʼtə-bəyihə-kə, ɔ ghɔ̀ŋ mbɔ, “Ndə shʉəŋ, wo-ɔ̄ nɔ kə bɛ VaaNyii!”<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />Bəke nɔ nə bɛ ghɔ ndə bɔ̂ŋ kə tə́nə kə́ lɛ́nə dɔdɔ, bɔ̂ŋ nɔ nə bɛ Mɛli Matalina, Mɛli ŋkwê-Jɛŋ vaakəyɔwo ghɔŋbə Jɔsɛ leʼnə Salomɛ. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />Ndʉʉ ndə Jiso kə bɛ Galili bɔ̂ŋ gɛ̀ hə bɔ̌ŋ ɔŋ kə́ kwáa ɔ. Bəbɛʼbəke ghɔ nɔ nə bɛ chɔ buŋmbi ndə ghɔŋ bɔŋ kə kóʼ gɛ̀ Jɛlosalɛŋ.<verse eid="MRK 15:41" /></para>
  <para style="s">Mətyúu-Jiso</para>
  <para style="r">(<ref loc="MAT 27:57-61">Matia 27:57-61</ref>; <ref loc="LUK 23:50-56">Luk 23:50-56</ref>; <ref loc="JHN 19:38-42">Jɔŋ 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Nɔ nə bɛ le kəChîlɔʼ, kə́ bɛ chîkə ndə bə shʉ̀tə ŋwɔŋ chɔ, ndʉʉbuumbi kʉ̂ʉ kə́ kə́ŋhə gwè, <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />Jɔsɛ ndə ɔ lɔ̀ hə Alamatia, kə́ bɛ ŋguu kaŋsotə ndə b̃ə kɔ́ kuŋhə tʉ ɔŋ ndə ɔ kə́ kʉ́ʉ ndə məkie Sɔ́ʼ-Nyii ghɔ nə mbəŋ-ɛŋ, kie fyii shʉ́əshʉ́ə gɛ̀ tʉ Bale bíʼtə ŋkwu-Jiso-kə. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />I chàa Bale ndə məyʉ́ mbɔ Jiso nɔʼ kwú. Ɔ tíi mbʉ wokwɛʼtəŋ-bəsɔge ndə məyʉ́ kəghɔ-ɔ mbɔ Jiso nɔʼ kwú mɛ? <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Kʉ̂ʉ yʉ́ hə kəghɔ mbʉ wokwɛʼtəŋ-bəsɔge mbɔ Jiso nɔʼ kwú, ɔ bɛ́ŋ Jɔsɛ gɛ̀ lʉ̀ ŋkwukə-i. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Jɔsɛ gɛ̀ nyúɔ ŋkia-ndyi-kəfyuʼ-kə, gwè shúʼhə ŋkwu-Jiso-kə, lʉ́əŋtə mu mbʉ ndyi kəfyuʼ, gɛ̀ mɔ̀ʼ mu sě ndə bə nɔʼ kə sáa ndəŋ ŋgoʼ. Tʉ́ʉhə ŋgoʼ gɛ̀ chíe mbʉ chu-sě nə yɔŋ. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Mɛli Matalina ghɔŋbə Mɛli ŋkwê Jɔsɛ nyíɛ yəŋkə ndə bə kə mɔ̀ʼ ɔ chɔ.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">Məbʉ̀nə kóʼ</para>
  <para style="r">(<ref loc="MAT 28:1-8">Matia 28:1-8</ref>; <ref loc="LUK 24:1-12">Luk 24:1-12</ref>; <ref loc="JHN 20:1-10">Jɔŋ 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Chîlɔʼkə kʉ̂ʉ tíŋ, Mɛli Matalina ghɔŋbə Mɛli ndə ɔ bɛ ŋkwê-Jɛŋ leʼnə Salomɛ nyúɔ ŋgwo-lùŋ-mə ndə məgɛ̀ yóʼ ŋkwukə-i nə yɔŋ. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Kʉ̂ʉ bɛ ndʉʉsɛŋkə bətyuʼbətyuʼ ndəŋ fəŋ kəchî mu vyii mbi<note caller="+" style="f"><char style="fr" closed="false">16:2 </char><char style="ft" closed="false">Nɔ kə bɛ Sɔŋnde.</char></note> ndə chichi sɔ́ʼ, bɔ̂ŋ gɛ̀ mbʉ chu-sě. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />Bɔ̂ŋ kə́ bíʼtə tʉ mbəŋtə-ʉə mbɔ, “Bu tʉ́ʉhə nda tʉ́ʉhə mbʉ ŋgoʼ ndə mbʉ chu-sě kɔ́ tʉ bʉʼʉ?” <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />Bɔŋ ndʉʉ ndə bɔ̂ŋ dàa chɔ, kə́ chɔ̀ʼhə shʉtə-ʉə lɛ́nə, nyíɛ mbʉ ŋgoʼ ndə i kə gʉ́ə daa tʉ bə nɔʼ tʉ́ʉhə. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Bɔ̂ŋ kʉ̂ʉ ŋíi mu mbʉ sě nyíɛ vaakəyɔwobɛʼ ɔ kə́ dùʼ kwiimɔʼnə, mɔ̀ʼ ndyi-kəfyuʼ-hə mbʉə-ɔ, i chíe chu-yʉə. <verse eid="MRK 16:5" /><verse number="6" style="v" sid="MRK 16:6" />Bɔŋ ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, “Kə i mə leʼ chàa bii fɛ, bii nɔ tʉʼ kʉ́ʉ Jiso ndə ɔ lɔ̀ hə Nasalɛ ndə bə kə kwɛ̀ŋ ɔŋ yí le. Ɔ nɔʼ bʉ̀nə kóʼ, ɔ kaa fɛ̄ŋ fɛ. B̈ii nyíɛ yəŋkə ndə bə kə mɔ̀ʼ ɔ chɔ. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />B̈ii gɛ̀ shyíi vâafɔʼɔ-bi leʼnə Bita mbɔ ɔ la tʉʼ gɛ̀ hə bəshʉ bii mu Galili. Bii bu nyíɛ ɔŋ chɔ haʼ ndə ɔ kə shyíi bii.”<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />Bɔ̂ŋ fyú hə mu mbʉ sě nyʉ́ʉ bʉʼka ŋgwonəkə nɔʼ kə yá bɔŋ, chu-yʉə chíe, təmə bɔ̂ŋ gìe nubɛʼkə tʉ wotəmiyɔŋ fɛ bʉʼka bɔ̂ŋ nɔ kə kə́ fàa.<verse eid="MRK 16:8" /></para>
  <para style="s">
    <char style="add">[Bəbɛʼbənduɔŋ bəŋwɔʼnə nɔ bìʼ yuhəbə 9-20 fɛ.]</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">16:9 </char>
      <char style="ft" closed="false">Mbyu-bəŋwɔʼnə-hə kəŋgie-Gili nɔ kie liʼ ntuŋntuŋ-ɔ̄ŋ: </char>
      <char style="it">Bɔ̂ŋ fʉ̀ʼtə nubə-ɔ̄ŋ nchəŋnchəŋ-ɛŋ tʉ Bita ghɔŋbə bʉə-nuɔ-bi məniʼ. Yɔ̄ŋ-yə kʉ̂ʉ tíŋ, Jiso tə́ŋ bɔŋ mbi lʉ̀ hə kwii ndə chichi sɔ́ʼ chɔ tə gɛ̀ dàa kwii ndə chichi sʉ́ʉ chɔ chusii-ɔ, bɔ̂ŋ kə́ tòʼ lɔ̀ʼ ntəŋ te ŋkwaaNyii ndə i bɛ ŋkʉʉ təmə kyinə mɔ̀ʼ wo sê fɛ bɔŋ-kə́-leʼ kɔ́ məchímbi təmə liʼ-i ghɔ fɛ.</char>
    </note></para>
  <para style="s">Jiso fyú tʉ Mɛli Matalina</para>
  <para style="r">(<ref loc="MAT 28:9-10">Matia 28:9-10</ref>,<ref loc="MAT 28:16-20">16-20</ref>; <ref loc="LUK 24:13-49">Luk 24:13-49</ref>; <ref loc="JHN 20:11-23">Jɔŋ 20:11-23</ref>; <ref loc="ACT 1:6-8">Fɔʼɔ 1:6-8</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />[Jiso kʉ̂ʉ kóʼ ndʉʉsɛŋkə bətyuʼbətyuʼ ndə fəŋ kəchî mu vyii mbi, fəŋ fyú tʉ Mɛli Matalina ndə ɔ nɔʼ kə jə̀ŋ lyʉʉhəbʉəbʉəbə mbʉə-ɔ təkwiitia. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Ɔ gɛ̀ shyíi bʉə ndə ghɔŋbə Jiso kə bɛ mɔʼɔ, ndʉʉ ndə bɔ̂ŋ kə́ lí bɔŋleʼ gwía. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Bɔŋ ndʉʉ ndə bɔ̂ŋ kə yʉ́ mbɔ ɔ nɔʼ bʉ̀nə kóʼ, ɔ nɔʼ nyíɛ ɔŋ, təmə bɔ̂ŋ bɛ́ŋ nukə ndə ɔ kə gìe fɛ. <verse eid="MRK 16:11" /><verse number="12" style="v" sid="MRK 16:12" />Nubə-ɔ̄ŋ kʉ̂ʉ tíŋ, ɔ bʉ̀nə bìʼ fyú ntɛ kədɔŋ tʉ vâafɔʼɔ-bi bəbûu, ndə bɔ̂ŋ kə́ tòʼ gɛ̀ mu lɔʼɔ. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Bɔ̂ŋ bʉ̀nə gɛ̀ shyíi bəʼkə, təmə bɔ̂ŋ bɛ́ŋ fɛ. <verse eid="MRK 16:13" /><verse number="14" style="v" sid="MRK 16:14" />Ɔ bʉ̀nə bìʼ fyú tʉ vâafɔʼɔ-bi njuɔ mɔʼ nə wuŋ ndʉʉ ndə bɔ̂ŋ kə dùʼtə ndəŋ tebele kə́ yú fɔbə, ɔ sɔ́ʼ bɔŋ bʉʼka məjínə-nubə leʼnə məshʉ́əhə-fyiihə-ʉə, bʉʼka bɔ̂ŋ kə bɛ́ŋ bʉə ndə bɔ̂ŋ kə nyíɛ ɔŋ ndʉʉ ndə ɔ nɔʼ kə kóʼ, gwè shyíi bɔŋ fɛ. <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />Ɔ ghɔ̀ŋ tʉ bɔŋ mbɔ, <char style="wj">“B̈ii gɛ̀ mu kəwʉʉnəmbi inchəŋ gɛ̀ lɔ̀ʼ ntəŋjyujyu chɔ tʉ bʉə bənchəŋ.</char> <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" /><char style="wj">Wotəmiyɔŋ ndə ɔ bɛ́ŋ, fí muu, bu kie ŋkwaaNyii, wotəmiyɔŋ ndə ɔ gòʼ təmə bɛ́ŋ fɛ nɔʼ gwù fɛʼɛ.</char> <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" /><char style="wj">Bʉə ndə bɔ̂ŋ bɛ́ŋ, nubəcheʼbə-ɔ̄ŋ bu gɛ̀ hə bɔ̌ŋ bɔŋ. Nə yie-ɔ, bɔ̂ŋ bu jə̀ŋ lyʉʉhəbʉəbʉəbə, kwə́ʼ ŋgie-bətə̂ŋ-fefe-bə.</char> <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" /><char style="wj">Bɔ̂ŋ bu yá yɔhə nə ghɔbə-ʉə, kaʼ bɔ̂ŋ nú ndyʉʼ shʉ́əshʉ́ə təmiyɔŋ i yi nukə nə bɔŋ fɛ, bɔ̂ŋ bu mɔ̀ʼ ghɔbə-ʉə ndəŋ bʉə-bəyɔʼ, bɔ̂ŋ bìi.”</char><verse eid="MRK 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Nɔ, ndʉʉ ndə Jiso Tiekətʉ nɔʼ kwə́ʼ tʉ bɔŋ liʼ, bə lʉ̀ ɔ gɛ̀ nə nɔŋ yuo, ɔ dùʼ kwiiləŋ Nyii. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Bɔ̂ŋ fyú gɛ̀ lɔ̀ʼ ŋgieNyiikə ndə yəŋbə inchəŋ, Tiekətʉ kə́ fɔ̀ʼ mu bɔŋ kə́ dʉ̀ʼ mbɔ mbʉ ntəŋ ndə bɔ̂ŋ tʉʼ téʼ nɔ bɛ shʉəŋ, nə nubəcheʼbə.]<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>