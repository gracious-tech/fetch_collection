<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Bamunka New Testament</book>
  <para style="h">Ɛfɛso</para>
  <para style="toc1">Ŋwɔʼnə ndə Bɔɔ nyɔ̀ʼ kɔ́ tə Chɔshi ndə i bɛ Ɛfɛso</para>
  <para style="toc2">Ɛfɛso</para>
  <para style="toc3">Ɛfɛ</para>
  <para style="mt2">Ŋwɔʼnə ndə Bɔɔ kə nyɔ̀ʼ kɔ́ tʉ</para>
  <para style="mt2">Chɔshi ndə i bɛ</para>
  <para style="mt1">Ɛfɛso</para>
  <para style="imt">Nchoʼtə bətʉ bənu</para>
  <para style="ip">Bɔɔ nɔ kə nyɔ̀ʼ ŋwɔʼnə-ɔ̄ŋ kə́ fʉ̀ʼtə nubə ndə Nyii nə kɔ̀ʼnə te fɔbə inchəŋ ndə ɔ kə chìi kəwʉʉnəmbi ghɔŋbə bī-yuo-bə. Ɔ chìi bə kínə mu ŋwɔʼnə-fɛ̄ŋ mbɔ fɔbə inchəŋ la bu yʉ́ bə kəghɔ-Klai.</para>
  <para style="ip">Mu fəŋ kəyəŋ mu ŋwɔʼnə-fɛ̄ŋ, Bɔɔ nɔ kwə́ʼ te gyʉʉ imɔʼ bɔŋ leʼnə ntɛhə ndə Nyii Tiekətʉ tíŋ hə bɔ̌ŋ ghɔ ndə məséʼ bʉə-bii ghɔŋbə ntɛhə ndə ɔ nɔʼ sʉ̀fyii hə ndəŋ bʉ̂ʼtə-ʉə bɔŋleʼ fyúhə bɔŋ mu bʉ̂ʼtə-ʉə tíŋ hə bɔ̌ŋ Jiso Klai vaa-ɛ. Ɔ bìʼ fʉ̀ʼtə te ntɛhə ndə ŋkɔʼnə-Nyii bu yaʼ gwè ndə məfyú sê nchəŋnchəŋ tíŋ hə bɔ̌ŋ LyʉʉhəNyiikə.</para>
  <para style="ip">Bɔɔ nɔ lʉ̀ fʉʼkənu ndə nubə buŋmbi ndə mədʉ̀ʼ mbɔ mu vâa-Nyii bənchəŋ la bɛ fɔkə imɔʼ tíŋ hə bɔ̂ŋ mə bɛ nukə imɔʼ ghɔŋbə Jiso. Ɔ nyɔ̀ʼ mbɔ chɔshi la bɛ nə mbʉə-wo, Jiso Klai kə́ bɛ tʉkə-i, mbɔ chɔshi la bɛ njaa, bɔŋ Jiso Klai la kə́ bɛ ŋgoʼ-mbʉ-fuunjaa mbɔ chɔshi la bɛ woke, Klai kə́ bɛ ləŋ-ɛŋ.</para>
  <para style="ip">Bɔɔ nɔ chìi bə kínə mu ŋwɔʼnə-fɛ̄ŋ mbɔ bʉʼka ŋkʉ̂ʉ ndə Jiso Klai kie tʉ bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii ghɔŋbə məchimbi-i ndə ɔ kɔ́ yie-bɔŋ bìa nə məsʉ̀fyii ndə ɔ kə chìi bɔŋ kie leʼnə buuŋjyu ndə ɔ kə dʉ̀ʼ tʉ bɔŋ, i nɔ tʉʼ dʉ̀ʼ mbɔ bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii nɔ kie ndə məmɛ̀ʼ nuʼ bʉəbʉə kə́ chí məchímbi ndə i bɛ tʉ́ʉnə.</para>
  <para style="iot">Nubə ndə i bɛ mu ŋwɔʼnə-fɛ̄ŋ</para>
  <para style="io1">Nchʉʉhə-bənu 1:1-2</para>
  <para style="io1">Klai ghɔŋbə chɔshi 1:3–3:21</para>
  <para style="io1">Məchímbi fefe ndə i bɛ mu Klai 4:1–6:20</para>
  <para style="io1">Liʼ-bənu 6:21-24</para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="s">Nchaʼtə ndə i gwè hə kəghɔ-Bɔɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />Nɔ nyɔ̀ʼ mbəŋ-ɔŋ Bɔɔ nyɔ̀ʼ ŋwɔʼnə-ɔ̄ŋ, ndə Nyii kə séʼ mɔ ndə ŋkʉʉnə tʉʉ-i, ndə məbɛ lɔntəŋ gìe shʉəŋ mu Klai Jiso.</para>
  <para style="p" vid="EPH 1:1">Mɔ nɔ tʉʼ nyɔ̀ʼ tʉ bʉə-Nyii ndə bɔ̂ŋ bɛ mu Ɛfɛso, bʉə ndə bɔ̂ŋ lyʉ̀ʉtə́nə ghɔŋbə Klai Jiso mɔʼɔ. <verse eid="EPH 1:1" /><verse number="2" style="v" sid="EPH 1:2" />Tə Nyii Tie-yʉʼʉ ghɔŋbə Jiso Klai Tiekətʉ, dʉ̀ʼ buuŋjyu tʉ bii ghɔŋbə fyiighʉ́ənə.<verse eid="EPH 1:2" /></para>
  <para style="s">Biʼbə ndə i gwè hə kəghɔ-LyʉʉhəNyiikə tíŋ hə bɔ̌ŋ Jiso Klai</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />B̈ʉʼʉ lə̀ʼtə Nyii, mbʉ Tie Tiekətʉ-yʉʼʉ Jiso Klai ndə ɔ nɔʼ bìʼ bʉʼʉ ndə bʉʼʉ bɛ mu Klai nə ntɛ-bəbiʼ-hə inchəŋ, ndə i gwè hə kəghɔ-LyʉʉhəNyiikə lɔʼɔ ŋguu. <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />Buŋ ndə wʉʉnəmbikə nə kə̂ chʉ́ʉhə, tʉ ɔ nɔʼ kə séʼ bʉʼʉ mbɔ bʉʼʉ bɔŋ bɛ fɔkə imɔʼ, mbɔ bʉʼʉ chʉʼ bɛ ŋkʉʉ təmə kie kwɔtəkə bəshʉ ɔ fɛ. Bʉʼka ŋkʉ̂ʉ-Nyii, <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />ɔ nɔʼ kə shʉ̀tə mbɔ bʉʼʉ bu nə bɛ vâanchinə-bi tíŋ hə bɔ̌ŋ Jiso Klai, ɔ nɔ nə chìi haʼ ndə ɔ nɔʼ kə shʉ̀tə ndə ŋkʉʉnə tʉʉ-i.<verse eid="EPH 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 1:6" />Ɔ nɔ nə chìi nɔ mbɔ bʉʼʉ chʉʼ kə́ lə̀ʼtə ɔŋ, bʉʼka fɔŋ buuŋjyu-i ndə ɔ dʉ̀ʼ tʉ bʉʼʉ, tíŋ hə bɔ̌ŋ Vaa-ɛ ndə ɔ kʉ̀ʉ daa. <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" />Ɔ nɔʼ chʉ̀ʼ tʉkə-ʉʼʉ nə fɔbʉə-Jiso-Klai-kə<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">Fɔbʉə-Jiso-Klai-kə fɛ̀ŋ nɔ bɛ ndə ɔ kɔ́ məchimbi-i bə yí ɔ nə fɔ-fɛ̀ʼndɛŋ-kə.</char></note>, bɔŋleʼ sʉ̀fyii hə ndəŋ bʉ̂ʼtə-ʉʼʉ, yɔ̄ŋ-yə nɔ bɛ bʉʼka buuŋjyu yɔ́ŋyɔ́ŋ-ɛŋ, <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />ndə ɔ véʼ ndəŋ bʉʼʉ yɔ́ŋyɔ́ŋ, nə mukətʉ-súunə leʼnə ŋkwɔʼtə jyujyu.<verse eid="EPH 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 1:9" />Nyii chìi bʉʼʉ kínə nubə ndə ɔ kə kʉ̀ʉ, lə̀ŋ bətɔ-ɔ haʼ ndə ɔ nɔʼ kə shʉ̀tə mbɔ Klai fɔ̀ʼ nubə ndə ɔ kʉ̀ʉ. <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />Nubə-ɔ̄ŋ ndə Nyii nɔʼ kə shʉ̀tə nɔ, ɔ bu mìʼtə ndʉʉ ndə ŋgwɔʼmbi bu yi kʉ̀ʼnə, ɔ chìi fɔbə inchəŋ bɛ nukə imɔʼ Klai kə́ gìe kətʉ-bɔŋ, fɔbə ndə i bɛ yuo ghɔŋbə fɔbə ndə i bɛ kəchisê. <verse eid="EPH 1:10" /><verse number="11" style="v" sid="EPH 1:11" />Nyii nɔʼ kə séʼ baʼa mbɔ baʼa bɛ yi-yə bʉə ndə bɔ̂ŋ bɛ nukə imɔʼ ghɔŋbə Klai, bʉʼka nukə ndə ɔ tʉʼ kʉ́ʉ nɔ bɛ nɔ ndə ɔ nɔʼ kə shʉ̀tə mbɔ i bu yi bɛ, nubə ndə i bɛ mu fyii-ɔ nɔ bɛ mbɔ nubə inchəŋ yi bɛ haʼ ndə ɔ kə shʉ̀tə. <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />Ɔ nɔ nə chìi nɔ mbɔ mbəŋ-yaʼ ndə baʼa kə bɛ fəŋ ndə məyʉ́əʼnə ndəŋ məgwè-Klai, chʉʼ kə́ lə̀ʼtə Nyii ndə məgʉə-e. <verse eid="EPH 1:12" /><verse number="13" style="v" sid="EPH 1:13" />Mbəŋ-yii ghɔ nɔ nə leʼ bɛ vâa-Nyii, ndʉʉ ndə bii kə yʉ́ ŋgie-shʉəŋ-kə, kə́ bɛ ntəŋjyujyu ndə i kə kwáa bii. Ndʉʉ ndə bii kə bɛ́ŋ Jiso Klai, Nyii chèʼ bii nə Lyʉʉhəkə-i haʼ ndə ɔ nɔʼ kə kɔ̀ʼnə. <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />Mbʉ kəLyʉʉhəNyii ndə bʉʼʉ kə kie, nɔ tʉʼ dʉ̀ʼ mbɔ bʉʼʉ bu yi kie fɔbə ndə Nyii nɔʼ kə kɔ̀ʼnə tʉ bʉʼʉ, ndʉʉ ndə Nyii bu yi kɛŋ chʉ̀ʼ tʉkə-ʉʼʉ gɛ̀ kùu. Yɔ̄ŋ-yə bu chìi bʉə lə̀ʼtə Nyii bʉʼka məgʉə-e.<verse eid="EPH 1:14" /></para>
  <para style="s">Bɔɔ gháaNyii mbɔ ɔ̈ kɔ́ mukətʉ-súunə tʉ bʉə-bi</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />Bʉʼka nchəŋnchəŋ bənu ndə Nyii nɔʼ fɔ̀ʼ, lʉ̀ hə mbi ndə mɔ kə yʉ́ ndə bii mɔ̀ʼfyiihə-ii ndəŋ Jiso Tiekətʉ, leʼnə ntɛ-ŋkʉ̂ʉ ndə bii kə kie ndəŋ bʉə-Nyii bənchəŋ, <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />mɔ chʉʼ nə káa ndə məkɔ́ ndɔ tʉ Nyii yie-bii fɛ, kə́ kwɛ́nə bii ndʉʉ ndə mɔ tʉʼ gháaNyii, <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />mbɔ N̈yii mbʉ Tie-məgʉ́ə, ndə ɔ bɛ Tie Tiekətʉ-yʉʼʉ Jiso Klai, kɔ́ bii nə fyii ndə məkie mukətʉ-súunə ndə i gwè hə kəghɔ-LyʉʉhəNyiikə bɔŋleʼ kɛ̀ʼ ŋwɔŋ-ɛŋ tʉ bii mbɔ bii kínə ɔŋ jyujyu, <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />mbɔ b̈ə ŋɔ́ʼhə shʉ mu fyiihə-ii, mbɔ b̈ii nyíɛ nukə ndə ɔ kə tíi bii, b̈ii yʉ́əʼnə chɔ b̈ii kə́ chyìi ndə məkie, ghɔŋbə buŋmbi fɔ-jyujyu-bə ndə ɔ nɔʼ kɔ̀ʼnə tʉ bʉə-bi. <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />Bɔŋleʼ nyíɛ ntɛ fɔŋ kəghʉəʼ təmə fʉʼ-e ghɔ fɛ ndə ɔ kie tʉ bʉʼʉ ndə bʉʼʉ bɛ́ŋ ɔŋ. Ghʉəʼkə-ɔ̄ŋ ndə i tʉʼ fɔ̀ʼ mu bʉʼʉ nɔ, nɔ bɛ ntɛ-fɔŋ-kəghʉəʼ ndə ɔ kie, <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />nɔ bɛ ntɛ-kəghʉəʼ ndə ɔ kə bʉ̀nə kóʼhə Klai nə yɔŋ, ndʉʉ ndə ɔ kə kwú, dùʼhə ɔŋ kwiiləŋ Nyii mu njəŋ-yuo-hə, <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />nɔ yəŋkə ndə Jiso Klai tʉʼ sɔ́ʼ bʉəkwɛʼtəŋ chɔ bənchəŋ ndə bɔ̂ŋ tʉʼ sɔ́ʼ njəŋ-yuo-hə, bʉəkwɛʼtəŋ leʼnə bʉə kəghʉəʼ leʼnə bətiekətʉ. Yetəkə-i nɔ chàa yetəbə inchəŋ ndə i bɛ kəchisê fɛ̄ŋ laa inchəŋ leʼnə mbi ndə i bɛ bəshʉ gwè. <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />Ɔ chìi ɔ kə́ gìe kətʉ fɔbə inchəŋ bɔŋleʼ chìi ɔ kə́ gìe kətʉ fɔbə inchəŋ mu chɔshi, <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />ndə bɛ mbʉə-e, Klai kwóhə chɔshi nə ghʉəʼkə-i inchəŋ, ɔ bɔŋleʼ kwóhə fɔbə inchəŋ ndə yəŋbə inchəŋ nə ghʉəʼkə-i.<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s">Məfyú mu kwú, bɛ mu məchímbi</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />Bii nɔʼ kə fəŋ kwú mu mɔ̀ʼmbɛ ghɔŋbə bʉ̂ʼtə <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />ndə bii kə fəŋ tə́nə chɔ, kə́ tòʼ ndəŋ fia-kəwʉʉnəmbi-tə, kə́ chìi nubə gɛ̀ hə bɔ̌ŋ fɔŋ-wokwɛʼtəŋ-kəlyʉʉhəbʉəbʉə ndə ɔ tʉʼ sɔ́ʼ lyʉʉhəbʉəbʉəbə mu yuo, kə́ bɛ ntɛ kəlyʉʉhə ndə i tʉʼ fɔ̀ʼ mu mbʉə bʉə ndə bɔ̂ŋ tʉʼ kwɛ̀ŋhə tʉ Nyii. <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />Bʉʼʉ bənchəŋ nɔʼ nə bɛ haʼ ndə bɔŋ, kə́ fɔ̀ʼ nubə ndə bɔ̂ŋ tʉʼ fɔ̀ʼ bʉʼka ntɔmə ndə i kə bɛ mu fyii-bʉʼʉ, kə́ fɔ̀ʼ nubə ndə mbʉə-yʉʼʉ kʉ̀ʉ ghɔŋbə ndaahə-ʉʼʉ, bʉʼka yɔ̄ŋ-yə, bʉʼʉ nɔ nə kie ndə mənyíɛ ŋgʉəʼ bʉʼka tʉʉbʉə-Nyii haʼ ndə bəʼ-bʉəməsʉʉ-kə, kə kie ndə mənyíɛ. <verse eid="EPH 2:3" /><verse number="4" style="v" sid="EPH 2:4" />Bɔŋ bʉʼka Nyii kie tʉvyiikə daa, bʉʼka ŋkʉ̂ʉ yɔ́ŋyɔ́ŋ ndə ɔ kʉ̀ʉ bʉʼʉ chɔ, <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />buŋ ndʉʉ ndə bʉʼʉ nɔʼ kə kwú mu bʉ̂ʼtə-ʉʼʉ, ɔ chìi bʉʼʉ bʉ̀nə kie məchímbi bʉʼʉbə Klai, bʉʼka buuŋjyu bə nɔʼ kwáa bii. <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />Ɔ chìi bʉʼʉ bʉ̀nə kóʼ kie məchímbi bʉʼʉ bɔŋ, dùʼhə bʉʼʉbə Klai Jiso mɔ̀ʼ mu njəŋ-yuo-hə. <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />Ɔ nɔ kə chìi yɔ̄ŋ-yə mbɔ kʉ̂ʉ bɛ ndə mbi inchəŋ ndə i bíe bəshʉ gwè nɔ, bʉə chʉʼ nyíɛ ndə ɔ nɔʼ dʉ̀ʼ fɔŋ buuŋjyu-i tʉ bʉʼʉ təmə liʼ-i ghɔ fɛ nə nuʼ jyujyu tíŋ hə bɔ̌ŋ Klai Jiso. <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />Bʉʼka buuŋjyu-Nyii ndə ɔ dʉ̀ʼ tʉ bii, nɔ kwáa yɔŋ kwáa bii bʉʼka bii mɔ̀ʼfyiihə-ii ndəŋ Jiso Klai. Kaa fɔʼɔ-yii fɛ, nɔ kɔ-Nyii-kə, <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />kaa bə bʉʼka fɔ̀ʼ fɛ bʉʼka wo mə yi kə́ kwɛ̀ŋ fyii-i. <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />Bʉʼʉ nɔ bɛ ghɔ-fɔ̀ʼ-Nyii-kə, ndə ɔ chìi, bʉʼʉ bɛ fefe tíŋ hə bɔ̌ŋ Klai Jiso mbɔ bʉʼʉ kə́ fɔ̀ʼ fɔʼɔ-jyujyu-tə ndə ɔ nɔʼ kə shʉ̀tə bəshʉ tʉ bʉʼʉ ndə məfɔ̀ʼ.<verse eid="EPH 2:10" /></para>
  <para style="s">Bʉʼʉ nɔ bɛ fɔkə imɔʼ mu Jiso Klai</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />Kə bii mə lèʼnə mbɔ mbəŋ-yii ndə bə kə bí bii təmə bii kə bɛ bʉə-Juu fɛ, bʉə ndə bə gòʼ təmə nɔʼ fɔ̀ʼ bɔŋ fɛ, kə́ tíi bii nə “bʉə ndə bə nɔʼ fɔ̀ʼ bɔŋ” buŋ ndə nɔ, nɔ nə bɛ nukə ndə bə fɔ̀ʼ mbʉə-bɔŋ nə ghɔ-woməsʉʉ-kə. <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />B̈ii kə́ kwɛ́nə mbɔ kə bɛ ndʉʉ-ghɔ̄ le, biibə Klai kə bɛ mɔʼɔ fɛ, bə nɔʼ kə fyúhə bii mu bʉə-Nyii, bʉə-Isilɛ, bii kə kie nukə ndə məchìi mu ŋkaa-Nyii-mə ndə i kə kie ŋkɔʼnə muŋgɔ fɛ, bii kə́ chí mu kəwʉʉnəmbi nə bʉə ndə bɔ̂ŋ kie yəŋ-yʉ́əʼnə-kə fɛ təmə kínə Nyii fɛ. <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />Bɔŋ nduɔ, mu Klai Jiso mbəŋ-yii ndə bii kə fəŋ bɛ dɔdɔ, nɔ bɛ ŋkəŋŋkəŋ bʉʼka fɔbʉəkə-i.<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false"><char style="it">bʉʼka fɔbʉəkə-i</char> Bəkɔ bə kíahə yəŋkə-ɔ̄ŋ ghɔ mbɔ </char><char style="it">bʉʼka kwu-i ndə i kə fɛ̀ʼndɛŋ kətʉ-bʉʼʉ.</char></note><verse eid="EPH 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 2:14" />Bʉʼka nɔ bɛ mbəŋ-ɛŋ bɛ fyiighʉ́ənə-yʉʼʉ, ndə ɔ nɔʼ chìi bʉʼʉ bəbûu, bɛ mbyu wo-imɔʼ bə́ʼtə lʉʉ-búɔ-kə ndə i kə wɔ̀ʼtə bʉʼʉ nə kwu-i. <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />Ɔ byùutə ŋkʉʉŋkʉʉ ndə i kə bɛ mu bʉʼʉ nə kwu, ndə i gwè bʉʼka nuʼ-bʉə-Juu ghɔŋbə bəŋkahə-bi leʼnə bɛŋtə-i, mbɔ ɔ chʉʼ chìi wo fefe imɔʼ ndə nuɔ-bʉə-tə ibûu ndə məgwè nə fyiighʉ́ənə mu bɔŋ. <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />Tíŋ hə bɔ̌ŋ kwu-i ndə ɔ kə kwú ndəŋ tyʉntɔɔnəkə, ɔ yí ŋkʉʉŋkʉʉ ndə i kə bɛ mu bʉʼʉ, chìi bʉʼʉ fúu ŋwɔŋ-yʉʼʉ ndə məbɛ mbyu wo-imɔʼ bɔŋleʼ fúu bʉʼʉbə Nyii. <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />Ɔ gwè lɔ̀ʼ ntəŋjyujyu ndə ĩ gwè nə fyiighʉ́ənə tʉ bii ndə bii kə bɛ dɔdɔ leʼnə bʉə ndə bɔ̂ŋ bɛ ŋkəŋŋkəŋ. <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />Tíŋ hə bɔ̌ŋ mbəŋ-ɛŋ, bʉʼʉ bənchəŋ nɔʼ kie fia ndə məgɛ̀ tʉ mbʉ Tie nə Lyʉʉhəkə imɔʼ.<verse eid="EPH 2:18" /></para>
  <para style="s">Bii nɔ bɛ njaafɛ̀ʼndɛŋ Tiekətʉ</para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />Nɔ nduɔ, mbəŋ-yii ndə bii gòʼ təmə bɛ bʉə-Juu fɛ, leʼbie bʉə-mətòʼ fɛ, təmə kə́ bɛ ndɔ-fɔŋ-kə fɛ. Bɔŋ bii nɔ bɛ vâa sê lɔʼɔ bii bəbʉə ndə bɔ̂ŋ nə bɛ bʉə-Nyii leʼnə nchinjaa-Nyii-hə. <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />Bii nɔ bɛ njaa-ɛ ndə bə bɔ́ŋ ndəŋ yiesê ndə bɛ bəlɔntəŋ-bi ghɔŋbə bʉəyʉkəŋgieNyii-bi ndə Klai Jiso nə mbəŋ-ɛŋ bɛ mbʉ ŋgoʼ-fûu-njaa. <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />Mbʉ bəsɔʼɔ njaa inchəŋ nɔ gwè fú ndəŋ ɔŋ, kóʼ bɛ njaafɛ̀ʼndɛŋNyii ndə i bɛ ŋkʉʉ tʉ Tiekətʉ. <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />Tíŋ hə bɔ̌ŋ mbəŋ-ɛŋ, bii bɔŋ ghɔŋbə bəbɛʼbʉə nɔʼ fúu ŋwɔŋ-yii bɔŋ ndə məbɛ njaa ndə Nyii bu kə́ chí muŋgɔ nə Lyʉʉhəkə-i.<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s">Nyii kɛ̀ʼ nukə ndə ɔ nɔʼ kə kɔ́ʼ lə̀ŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />Nɔ kə bɛ luu-i nɔ, ndə mbəŋ-ɔŋ Bɔɔ, ndə mɔ bɛ wo-njaa-chaŋ bʉʼka Klai Jiso, tʉʼ gháaNyii tʉ bii, ndə bii gòʼ təmə bɛ bʉə-Juu fɛ. <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />Mɔ nɔ kwɔ̀ʼtə mbɔ mbəŋ-yii nɔ kínə fɔ̀ʼ ndə Nyii nɔʼ kə kɔ́ kəghɔ-mɔ ndə məshyíi bii nə buuŋjyu ndə ɔ kie tʉ bii ndə bii gòʼ təmə bɛ bʉə-Juu fɛ. <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />Nyii nɔʼ kɛ̀ʼ nukə tʉ mɔ, ndə ɔ nɔʼ kə shʉ̀tə bəshʉ bɔŋ lə̀ŋ, haʼ ndə mɔ nɔʼ kə fəŋ nyɔ̀ʼ tʉ bii məniʼ. <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />Kaʼ bii tíi nukə ndə mɔ kə nyɔ̀ʼ, bii bu kínə ntyʉʉ ndə mɔ nɔʼ kínə te nukə ndə Nyii kə lə̀ŋ yie-Klai. <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />Nyii nɔ nə lə̀ŋ nukə-ɔ̄ŋ kəghɔ-bʉə bəshʉ, bɔŋ nɔʼ kɛ̀ʼ laa tʉ bəlɔntəŋ-bi ndə bɔ̂ŋ bɛ ŋkʉʉ ghɔŋbə bʉəyʉkəŋgieNyii-bi tíŋ hə ndəŋ Lyʉʉhəkə-i.<verse eid="EPH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 3:6" />Mbʉ kənu ndə Nyii kə lə̀ŋ nɔ bɛ mbɔ tíŋ hə bɔ̌ŋ ntəŋjyujyu ndə bʉə ndə bɔ̂ŋ bɛ́ŋ ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ, nɔʼ bɛ njuhə, bìa bʉə-Juu ndə məbɛ lɔŋkə imɔʼ, bɔ̂ŋ bənchəŋ bu kie biʼkə ndə Nyii nɔʼ kə kɔ̀ʼnə mbɔ Klai Jiso yi gwè nə yɔŋ. <verse eid="EPH 3:6" /><verse number="7" style="v" sid="EPH 3:7" />Nyii nɔʼ kə chìi mɔ ndə məbɛ wofɔ̀ʼ-ɛ ndə ntəŋjyujyu-ɔ̄ ndə bɛ kɔ-buuŋjyu-kə-i. Ɔ nɔ nə fɔ̀ʼ yɔ̄ŋ-yə nə ghʉəʼkə-i. <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />Ndə mbəŋ-ɔŋ, mɔ nɔ bɛ ndyiʼtə-wo-kə mu bʉə-bi bənchəŋ bɔŋ ɔ dʉ̀ʼ buuŋjyu-ɔ̄ tʉ mɔ, ndə məlɔ̀ʼ tʉ bʉə ndə bɔ̂ŋ gòʼ təmə bɛ bʉə-Juu fɛ, fʉʼkə ndə i bɛ mu Klai chàa ghʉəʼ-woməsʉʉ-kə ndə məkínə, <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />ndə məchìi bʉə bənchəŋ kínə mbʉ kənu ndə Nyii nɔʼ kə shʉ̀tə bɔŋ lə̀ŋ kəghɔ-bʉə ŋgʉʼŋgʉʼhə, kə bɛ Nyii ndə ɔ chìi fɔbə inchəŋ.<verse eid="EPH 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 3:10" />Mbɔ tíŋ hə bɔ̌ŋ chɔshi bʉəntəŋNyii ghɔŋbə lyʉʉhəbʉəbʉəbə ndə bɔ̂ŋ tʉʼ sɔ́ʼ nə bəfɔŋ bɔŋleʼ kə́ bɛ bəntəŋbəshʉ ndə njəŋ-yuo-hə yi kínə ntɛ-mukətʉ-súunə-hə ndə Nyii kie inchəŋ. <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />Nɔ nukə nɔ ndə ɔ nə kie mu fyii-ɔ təmə nchʉʉhə-i byuunɔ liʼ-i bɛ ghɔ fɛ, ɔ bɔŋ fɔ̀ʼ nduɔ tíŋ hə bɔ̌ŋ Klai Jiso Tiekətʉ-yʉʼʉ.<verse eid="EPH 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EPH 3:12" />Mu Klai, bʉʼʉ nɔ kie fyii tə̀ŋnə leʼnə fyii shʉ́əshʉ́ə ndə mətə́nə bəshʉ-Nyii tíŋ hə bɔ̌ŋ məmɔʼfyiihə-ʉʼʉ ndəŋ ɔŋ. <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />Nɔ, mɔ nɔ tʉʼ fʉ̀ʉtə bii mbɔ kə ŋgʉəʼ ndə mɔ bɛ muŋgɔ mə kə́ chɔ́ŋhə bii fɛ, mɔ nɔ tʉʼ nyíɛ yie-bii bɔŋ kə́ bɛ məgʉə-yii.<verse eid="EPH 3:13" /></para>
  <para style="s">Bɔɔ gháaNyii mbɔ N̈yii kɔ́ ghʉəʼ-kəLyʉʉhəNyii-kə tʉ bɔŋ</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />Bʉʼka nubə-ɔ̄ŋ, mɔ nɔ tʉʼ bè kweʼtəbə-ɔŋ sê bəshʉ-Nyii, mbʉ Tie, <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />ndə tʉʼ tyú ɔ tyú yietə tʉ chu-fu-tə inchəŋ ndə i bɛ yuo ghɔŋbə chisêkə. <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />Mbɔ tíŋ hə bɔ̌ŋ fɔŋ məgʉə-e ndə i yɔ́ŋ daa, ɔ chʉʼ kɔ́ bii nə ghʉəʼkə tíŋ hə bɔ̌ŋ Lyʉʉhəkə-i mbɔ bii chʉʼ kie fyii shʉ́əshʉ́ə mu mbʉə-bii. <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />Mbɔ Klai chʉʼ shʉ̀tə yəŋ-chí-kə-i mu fyiihə-ii tíŋ hə bɔ̌ŋ məmɔʼfyiihə-ii ndəŋ ɔŋ, mbɔ ŋkʉ̂ʉ-Nyii bɔŋleʼ dùhə ghûutə-i, i yá sê mu fyii-bii, <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />bii chʉʼ kie ghʉəʼkə biibə bʉə-Nyii bənchəŋ ndə məkínə ghʉə-e, tyʉ-i, mədəʼ-ɛ leʼnə mədɔŋnə-iŋ, <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />bɔŋleʼ kínə ŋkʉ̂ʉ-Klai ndə i chàa ndaa mbɔ məchímbi ghɔŋbə ghʉəʼkə chʉʼ lə́ŋ mu mbʉə-bii ndə i gwè hə kəghɔ-Nyii.<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />Nduɔ, tə mbəŋ-ɛŋ ndə bəkɔ ɔ chìi i yɔ́ŋ tíŋ ntyʉʉ-i ndə bʉʼʉ tʉʼ bíʼtə bɔŋ-kə́-leʼ kwɔ̀ʼtə, tíŋ hə bɔ̌ŋ ghʉəʼkə ndə i tʉʼ fɔ̀ʼ mu mbʉə-bʉʼʉ, <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />tə məgʉ́ə bɛ tʉ ɔŋ mu chɔshi ghɔŋbə Klai Jiso ndə kwinə-bʉə-bə inchəŋ təmə liʼ-i bɛ ghɔ fɛ. Ï bɛ haʼ nɔ.<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s">Gyʉʉ imɔʼ mu mbʉ mbʉə</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />Ndʉʉghɔfii, mbəŋ-ɔŋ ndə mɔ bɛ wo-njaa-chaŋ Tiekətʉ bʉʼka mɔ tʉʼ fɔ̀ʼ tʉ ɔŋ, nɔ tʉʼ kwèʼhə bii mbɔ məchimbi-yii kə́ gɛ̀ haʼ nukə imɔʼ ghɔŋbə fia ndə bə kə tíi bii ndə mətə́nə chɔ. <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />B̈ii lʉ̀ ŋwɔŋ-yii sê ndə ntɛhə inchəŋ ghɔŋbə buɔnəbə, bɔŋleʼ kə́ yá fyii, kə́ bɛ́ŋ wotəmiyɔŋ ndə ntɛhə ndə ɔ bɛ ndə mədʉ̀ʼ ŋkʉ̂ʉ-a tʉ ɔŋ. <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />B̈ii kə́ kɔ̀ɔtə ndə məfúu ŋwɔŋ-yii mu LyʉʉhəNyiikə nə fyiighʉ́ənə.<verse eid="EPH 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 4:4" />Bʉʼʉ nɔ bɛ mbʉə imɔʼ bɔŋleʼ kie LyʉʉhəNyiikə imɔʼ, haʼ ndə bɛ mbyu kənu imɔʼ ndə məyʉ́əʼnə ndəŋ ghɔ ndʉʉ ndə Nyii kə tíi bii. <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />Nɔ bɛ mbyu Tiekətʉ imɔʼ, məmɔ̀ʼfyii imɔʼ, luu məfì muu imɔʼ, <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />leʼnə Nyii imɔʼ ndə ɔ bɛ Tie bʉə bənchəŋ, kə́ gìe kətʉ bʉə-bi bənchəŋ, kə́ fɔ̀ʼ mu bʉə bənchəŋ bɔŋ-kə́-leʼ chí mu bʉə bənchəŋ. <verse eid="EPH 4:6" /><verse number="7" style="v" sid="EPH 4:7" />Bɔŋ wotəmiyɔŋ mu bʉʼʉ nɔ tʉʼ kie buuŋjyu-Nyii haʼ ghʉə ndə Klai kʉ̀ʉ ndə məkɔ́ tʉ ɔŋ. <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />Ŋwɔʼnə Nyii nɔ ghɔ̀ŋ ndʉʉmɛ mbɔ,</para>
  <para style="q1" vid="EPH 4:8">“Ndʉʉ ndə ɔ kə kóʼ kweghɔʼ, ɔ lʉ̀ nuɔ bəŋgwìa chɔ̂ kóʼ nə bɔŋ bɔŋleʼ kɔ́ kɔkə tʉ bʉəməsʉʉ.”<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">Ŋwɔʼnə təLyuu 68:18.</char></note><verse eid="EPH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 4:9" />Məghɔ̀ŋ mbɔ ɔ kə kóʼ kweghɔʼ bɛ mbuka yaʼkɛŋ mbɔ ɔ nɔʼ kə fəŋ shíʼ gɛ̀ mu sê? <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />Mbəŋ-ɛŋ ndə ɔ kə shíʼ nɔ bɛ haʼ mbəŋ-ɛŋ ndə ɔ kə kóʼ gɛ̀ kweghɔʼ dɔ̀ŋnə tə tíŋ yuo mbɔ ɔ chʉʼ bɛ ndə yəŋbə inchəŋ. <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />Nɔ bɛ mbəŋ-ɛŋ ndə ɔ kə séʼ bəbɛʼbʉə ndə məbɛ bəlɔntəŋNyii, bəbɛʼbə ndə bʉəyʉkəŋgieNyii, bəbɛʼbə ndə məbɛ bʉə lɔ̀ʼ ntəŋjyujyu, bəbɛʼbə ndə məbɛ bəbasto ghɔŋbə bʉə dàhə mbʉ kəŋgie, <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />ndə məshʉ̀tə bʉə-Nyii ndə mbʉ fɔʼɔ-Nyii, mbɔ bɔ̂ŋ chʉʼ bɔ́ mbʉ mbʉə-Klai. <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />I bu bɛ haʼ nɔ tə ndʉʉ nə kʉ̀ʼnə ndə bʉʼʉ bənchəŋ bu nə bɛ nukə imɔʼ ndə məmɔʼfyiihə-ʉʼʉ ndəŋ Klai bɔŋleʼ kínə VaaNyii, tʉ bʉʼʉ nə tə̀ŋ, tə bɛ nə wo ndə Klai bɛ yɔŋ inchəŋ. <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />I nɔ bɛ nɔ bʉʼka bʉʼʉ məkóʼ káa vaavaa, lɛɛŋhə-muu-kə kə́ bɛ̀ʼ bʉʼʉ gháhə kɔ́ bəviabəvia, fʉʉkə kə́ bɛ̀ʼ bʉʼʉ kə́ bɛ ntɛ-bənu-hə ndə bʉə mənaa ghɔŋbə bʉə fə́ʼhə bʉə tʉʼ dàhə ntɛntɛhə, kə́ bɛ fiatə ndə məfə́ʼhə bʉʼʉ. <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />Ndə mətə̀nə ndəŋ shʉəŋ mu ŋkʉ̂ʉ, bʉʼʉ nɔ kie ndə mə-kə́-kʉ̀ʼ ndəŋ fiatə inchəŋ mu mbəŋ-ɛŋ Klai ndə ɔ bɛ tʉ-mbʉ-chɔshi-kə. <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />Kə́ bɛ ɔ ndə yəŋ-mbʉə-bə inchəŋ chyúnə ndəŋ ɔŋ nə yuhəbə ndə bə kɔ́ tʉ ɔŋ, ndʉʉ ndə mbyu kəyəŋ təmiyɔŋ tʉʼ fɔ̀ʼ yi-yə-fɔ̀ʼ jyujyu nɔ, i chìi mbʉ mbʉə kə́ kóʼ, bɔ́ ŋwɔŋ-ɛŋ mu ŋkʉ̂ʉ.<verse eid="EPH 4:16" /></para>
  <para style="s">Məchímbi fefe</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />Nduɔ yie-Tiekətʉ, nɔʼ m̈ɔ shyùu tyunəkə-i mbɔ b̈ii leʼ kie ndə mə-kə́-chìi ntɛ-bənu-hə nə bʉə ndə bɔ̂ŋ gòʼ təmə bɛ́ŋ Nyii tʉʼ chìi nə ŋkwɔʼtə njʉnjʉ-yʉə fɛ. <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />Tʉkə-ʉə nɔ nə bɛ i chíenə, bɔ̂ŋ nɔʼ fyú hə mu fia-Nyii ndə ɔ̃ kɔ́ məchímbi bʉʼka byuu-ndaa-kə, chìi ndə bɔ̂ŋ kə shʉ́əhə fyiihə-ʉə. <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />Tʉkə-ʉə nɔʼ yə́ŋhə, bɔ̂ŋ kɔ́ ŋwɔŋ-yʉə ndə nu-nyàatəŋwɔŋ-bə ntɛntɛhə, kie ntɔmə ndə mə-kə́-fɔ̀ʼ nu-nyàatəŋwɔŋ-bə təmiyɔŋ. <verse eid="EPH 4:19" /><verse number="20" style="v" sid="EPH 4:20" />Bɔŋ kaa ntɛ nɔ ndə bə kə dàhə bii te Klai fɛ! <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />B̈ʉʼʉ lʉ̀ mbɔ bii nɔʼ kə yʉ́, bə bɔŋleʼ dàhə bii nə shʉəŋ te nə wo ndə Jiso bɛ yɔŋ, <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />nɔ b̈ii mɛ̀ʼ nduɔŋ nuʼ ndə i kə fəŋ bɛ mu mbʉə-bii, b̈ii kə́ chìi nubə nə yɔŋ, ndə ĩ kə́ bʉ́əhə bii, bʉʼka nu-bʉəbʉə-bə ndə b̈ii kə kʉ̀ʉ ndə məfɔ̀ʼ i fə́ʼhə bii, <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />lʉ̀ fyii fefe ghɔŋbə ndaa fefe. <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />Bii bɔŋ kie ndə məmɔ̀ʼ gwo mbʉə fefe ndə bɛ finə-Nyii, kə́ bɛ ndyʉndyʉ nə shʉəŋ bɔŋleʼ bɛ tʉ́ʉnə.<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />Nɔ, ndʉʉ ndə bii nɔʼ mɛ̀ʼtə lɛɛŋkə, ẅotəmiyɔŋ mu bii nɔ kie ndə mə-kə́-gìe shʉəŋ tʉ wo-kətoʼ-e bʉʼka bʉʼʉ nɔ bɛ nə yəŋ-mbʉə-bə ndə i bɛ ndəŋ mbʉə imɔʼ. <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />Tʉʉ-a byʉ́ʼ, kə a mə bɔŋ chìi bʉ̂ʼʉ fɛ, kə a mə mɛ̀ʼtə chichi bùu chusii-ɔ tʉʉ-a kə́ bíe ibyʉ́ʼnə fɛ. <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />Kə bii mə kɔ́ saa tʉ Debulu ndə məfə́ʼhə bii fɛ. <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />Wo ndə ɔ tʉʼ lʉ́ʼ kə ɔ mə leʼ lʉ́ʼ fɛ, bɔŋ ɔ̈ kə́ fɔ̀ʼ nə shʉəŋ nə yi-yə ghɔkə chʉʼ kie fɔkə ndə məkɔ́ tʉ wotəmiyɔŋ mu bii ndə ɔ gòʼ təmə kie fɛ. <verse eid="EPH 4:28" /><verse number="29" style="v" sid="EPH 4:29" />Kə ŋgie-bʉəbʉə-kə mə fyú chu bii fɛ, b̈ii bɔŋ kə́ kwə́ʼ haʼ ntɛ-bəŋgie-hə ndə bəkɔ i bɔ́ yəŋkə bɔŋleʼ bʉ̀ʉ ndə ntɛ kəyəŋ-ɛŋ, mbɔ i chʉʼ gwè nə bʉʉ tʉ bʉə ndə bɔ̂ŋ tʉʼ yʉ́.<verse eid="EPH 4:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EPH 4:30" />Kə bii mə chìi tʉʉ kəLyʉʉhəNyii byʉ́ʼ fɛ, kə́ kwɛ́nə mbɔ nɔ bɛ cheʼ-Nyii-kə ndə ɔ chèʼ bii nə yɔŋ, ndə mədʉ̀ʼ mbɔ ɔ bu chʉ̀ʼ tʉkə-ii ndəŋ ndyiʼtə-kəchî-kə.<verse eid="EPH 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EPH 4:31" />B̈ii fyúhə kechʉʼ mu fyiihə-ii inchəŋ, fyiighɔ́ʼnə, tʉʉbʉə, chyuutə, leʼnə məgìe nu-bʉəbʉə-bə kətʉ wo, leʼnə məmʉ̀ʉ bʉ̂ʼʉ te wo mu fyii-a, <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />b̈ii dʉ̀ʼ buuŋjyu tʉ ŋwɔŋtə-ii, kie fyii búɔnə, kə́ sʉ̀fyiihə-ii hə ndəŋ bʉ̂ʼ-bəbɛʼbʉə-tə, haʼ ndə Nyii kə sʉ̀fyii-i hə ndəŋ bʉ̂ʼtə-ii tíŋ hə bɔ̌ŋ Klai.<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="s">Mədùʼ nə ŋkʉ̂ʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />Nɔ, b̈ii lʉ̀ hə kəwu Nyii, ndə vâa ndə ɔ kʉ̀ʉ bɔŋ daa. <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />B̈ii dùʼ nə ŋkʉ̂ʉ, haʼ ndə Klai kə kʉ̀ʉ bʉʼʉ kɔ́ məchimbi-i yie bʉʼʉ, ndə i bɛ nə fɔ-fɛ̀ʼndɛŋ-jyujyu-bə, kɔkə ndə yɔ̂ʼkə-i lùŋ bʉ̀ʉ daa tʉ Nyii.<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />Bɔŋ kə bə mə yʉ́ bəsəŋ, ntɛ-kənu nyàatəŋwɔŋ təmiyɔŋ leʼnə ntɔmə mu bii fɛ, ndə i kʉ̀ʼnə ndə məbɛ mu bʉə-Nyii fɛ. <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />Kə bə məyʉ́ kwə́ʼ nyàatə ŋwɔŋ, byuunɔ kwə́ʼ bənɔ̌ʼɔ byuunɔ mbɛʼnə bənɔ̌ʼɔ mu bii fɛ, bii nɔ kie ndə mə-kə́-kɔ́ bə ndɔ tʉ Nyii. <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />B̈ii kə́ kínə mbɔ wotəmiyɔŋ ndə ɔ bɛ ŋgaa bəsəŋ, kə́ nyàatə ŋwɔŋ-ɛŋ, kə́ chìi ntɔmə nɔ bɛ nə wo ndə ɔ tʉʼ gháa bənyii kədɔŋ. Ɔ kie yəŋkə ntoʼ Klai ghɔŋbə Nyii fɛ. <verse eid="EPH 5:5" /><verse number="6" style="v" sid="EPH 5:6" />Kə bii mə mɛ̀ʼtə wo fə́ʼhə bii nə kwə́ʼ njʉnjʉ fɛ, bʉʼka nubə-ɔ̄ŋ, tʉʉbʉə-Nyii bu shíʼ ndəŋ bʉə ndə bɔ̂ŋ gòʼ təmə kə́ yʉ́ chu-i fɛ. <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />Nɔ, kə a mə fúu nuɔ bii bɔŋ fɛ. <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />Bii nɔ nə fəŋ bɛ njəŋkə vɛʼbɛʼ, bɔŋ nduɔ ndə bii bɛ bʉə-Tiekətʉ nɔ, bii nɔ bɛ kɛʼɛ, nuʼ-yii kie ndə mədʉ̀ʼ. <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />Mbʉ kɛʼɛ ndə i bɛ mu bii nɔ kie ndə mə-kə́-dʉ̀ʼ ŋwɔŋ-ɛŋ haʼ ndəŋ nubə ndə i bɛ jyujyu, kə́ bɛ kʉ̀ʼnə bɔŋleʼ kə́ bɛ shʉəŋ, <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />kə́ kɔ̀ɔtə ndə mətyúutə nukə ndə i bu kɔ́ tʉʉjyu tʉ Tiekətʉ. <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />Kə bii mə kɔ́ ghɔkə-ii ndə nu-mu-kənjəŋ-bə ndə i mə kwáa fɛ, b̈ii kə́ kɛ̀ʼ, kɛ̀ʼ. <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />Bʉʼka i nɔ bɛ nu-kətʉ-vyíinə-bə ndə mə-kə́-fʉ̀ʼtə nubə ndə bɔ̂ŋ tʉʼ chìi mu kənjəŋ. <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />Ndʉʉ ndə nukə təmiyɔŋ gwè mu kɛʼɛ, i dʉ̀ʼ ŋkɛŋ kənu ndə i bɛ yɔŋ, <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />bʉʼka fɔkə təmiyɔŋ ndə i gwè hə mu kɛʼɛ nɔʼ bɛ kɛʼɛ. Nɔ bɛ yɔŋ ndə bə kə nyɔ̀ʼ mbɔ,</para>
  <para style="q1" vid="EPH 5:14">“B̈ii gwùʼtə mbɛŋhə, bii ndə bii tʉʼ bɛ́ŋbɛ́ŋ,</para>
  <para style="q2" vid="EPH 5:14">bii ndə bii nɔʼ kwú b̈ii lɔ̀ hə sê</para>
  <para style="q3" vid="EPH 5:14">Klai bu báa ndəŋ bii.”<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />B̈ii láa le ndə ntɛhə ndə bii tʉʼ chìi nubə, kə bii mə kə́ chí mbi ndə bənɔ̌ʼɔ fɛ, b̈ii kə́ chí nə bʉə ndaa. <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />Kaʼ bii kie fia ndə məchìi nukə b̈ii chìi jyujyu bʉʼka mbi nɔʼ byʉ́ʼ. <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />Ndʉʉmɛ, kə bii mə bɛ bənɔ̌ʼɔ fɛ, b̈ii bɔŋ kə́ kínə nukə ndə Tiekətʉ kʉ̀ʉ. <verse eid="EPH 5:17" /><verse number="18" style="v" sid="EPH 5:18" />Kə bii mə búu nə ndʉʼmə fɛ, bʉʼka mbɔ i bu chìi bii chìi nubə ndə i bu bʉ́əhə bii, bɔŋ b̈ii mɛ̀ʼtə jyʉ́ʉhə bə L̈yʉʉhəNyiikə jyʉ́ʉhə bii. <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />B̈ii yùɔ ntɛ-təlyuu-Nyii-hə ndə Dɛbi kə yùɔ tʉ bəbɛʼbʉə bɔŋleʼ kə́ yùɔ ibɛʼ-yə ntɛ-təlyuu-hə ndə i gwè hə kəghɔ-LyʉʉhəNyiikə bɔŋleʼ bʉ̂ʼtə fɔbə ndə mələ̀ʼtə Tiekətʉ nə fyiihə-ii inchəŋ, <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />kə́ kɔ́ ndɔ ndə nubə inchəŋ təvɛʼtəvɛʼ tʉ Nyii mbʉ Tie yie-Tiekətʉ-yʉʼʉ Jiso Klai.<verse eid="EPH 5:20" /></para>
  <para style="s">Bəke ghɔŋbə bələŋ</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21" />B̈ii kə́ ké ŋwɔŋtə-ii tʉ bəbɛʼbʉə, kə́ fàa bə Klai.<verse eid="EPH 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />Bəke, b̈ii ké ŋwɔŋ-yii tʉ bələŋ-bii, fi nə bii tʉʼ nʉ̀ʉ sê bəshʉ Tiekətʉ. <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />Bʉʼka woləŋ nɔ tʉʼ gìe kətʉ vi-i, haʼ ndə Klai tʉʼ gìe kətʉ chɔshi, ndə i bɛ mbʉə-e, mbəŋ-ɛŋ kə́ bɛ Ŋkwaa-ɛ. <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />Nduɔ ndə chɔshi tʉʼ yʉ́ kəghɔ-Klai nɔ, bəke ghɔ nɔ kie ndə məké ŋwɔŋtə-ʉə tʉ bələŋ-bʉə ndə nubə inchəŋ.<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />Bələŋ, b̈ii kʉ̀ʉ bəke-bii, haʼ ndə Klai kə kʉ̀ʉ chɔshi tə kwú yie-ɔ. <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />Ɔ nɔ nə chìi ɔ, mbɔ ɔ bɛ ŋkʉʉ, ndə ɔ kə sʉ̀ ɔ nə muu ndə ɔ fí ndə bɛ ŋgieNyiikə. <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />Jiso nɔ chìi yɔ̄ŋ-yə mbɔ chɔshi chʉʼ bʉ̀ʉ shʉ-ɔ, təmə kie kwɔtəkə mbʉə-ɔ ghɔŋbə shʉ núʼtə fɛ, byuunɔ ntɛ-kənu ndə maa-yɔ̄ŋ fɛ, mbɔ ɔ chʉʼ bɛ ŋkʉʉ təmə bə mə kie nukə ndə məgìe kətʉ-ɔ fɛ. <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />Nɔ bɛ haʼ nɔ, bələŋ nɔ kie ndə məkʉ̀ʉ bəke-bʉə haʼ ndə bɔ̂ŋ kʉ̀ʉ mbʉəhə-ʉə. Wo ndə ɔ kʉ̀ʉ vi-i, nɔ kʉ̀ʉ ŋwɔŋ-ɛŋ. <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />Bʉʼka wo kaa ghɔ ndə ɔ bàa mbɔʼ-mbʉə-e fɛ, ɔ̃ nɔ yúʼ ɔ bɔŋleʼ lɛ́nə ɔŋ haʼ ndə Klai chìi tʉ chɔshi. <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />Bʉʼka bʉʼʉ bənchəŋ nɔ bɛ yəŋ-mbʉə-bə-i.<verse eid="EPH 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EPH 5:31" />“Bʉʼka luu-ɔ̄, woləŋ nɔ kie ndə məmɛ̀ʼtə tie-e ghɔŋbə ŋkwê-i gɛ̀ tùonə ghɔŋ vi-i, mbʉ b̈ʉə bəbûu chʉʼ bɛ mbyu mbʉə imɔʼ.” <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />Ŋguu shʉ́əshʉ́ə nɔ ghɔ ndə bə kɛ̀ʼ ndə yəŋkə-ɔ̄ŋ, mɔ kə́ ghɔ̀ŋ mbɔ i nɔ bɛ te Klai ghɔŋbə chɔshi. <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />Buŋ ndə nɔ, ẅotəmiyɔŋ mu bii kʉ̀ʉ vi-i ndə ɔ kʉ̀ʉ ŋwɔŋ-ɛŋ, mbʉ woke-ghɔ̄ nɔ kie ndə məbú ləŋ-ɛŋ.<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s">Vâambuɔ ghɔŋbə bətie-bʉə</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />Vâambuɔ, bʉʼka bii bɛ fɔkə imɔʼ biibə Tiekətʉ, b̈ii yʉ́ chu bətie-bii, nɔ bɛ nukə ndə i kʉ̀ʼnə. <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />Bə nɔ nyɔ̀ʼ mu ŋwɔʼnə-Nyii mbɔ, “Kɔ́ kuŋhə tʉ naa-aŋ ghɔŋ tie-a.” Nɔ bɛ fəŋ ŋkahə nɔ ndə i kie ŋkɔʼnə, <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />“mbɔ nubə inchəŋ chʉʼ bʉ̀ʉ tʉ a, a bɔŋleʼ chí kəwʉʉnəmbi dɔ̀ŋnə.” <verse eid="EPH 6:3" /><verse number="4" style="v" sid="EPH 6:4" />Bətie-vâa, kə bii mə kə́ byìi tʉʉ vâa-bii fɛ, b̈ii chìi b̈ɔ̂ŋ kóʼ nə nuʼ ghɔŋbə tʉ̂ʼ-Tiekətʉ.<verse eid="EPH 6:4" /></para>
  <para style="s">Fʉəhə ghɔŋbə bətiefɔʼɔ</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />Fʉəhə, b̈ii yʉ́ chu bətiefɔʼɔ-bii nə faakə ghɔŋbə ŋgwonəkə kəwʉʉnəmbi-fɛ̄ŋ nə fyiihə-ii inchəŋ, fi nə bii tʉʼ chìi tʉ Klai. <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />Kə bii mə kə́ yʉ́ chu-yʉə bə ndə məfàa shʉ ndʉʉ ndə bɔ̂ŋ bɛ sê, mbɔ bɔ̂ŋ chʉʼ kə́ tíi yie-yii jyujyu fɛ, bii bɔŋ kie ndə məbɛ ndə vâafɔʼɔ-Klai, kə́ fɔ̀ʼ nukə ndə Nyii kʉ̀ʉ, mu fyii-bii, <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />kə́ fɔ̀ʼ nə mu fyii jyujyu tʉ Tiekətʉ, kaa tʉ woməsʉʉ fɛ, <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />kə́ kínə mbɔ nu-jyujyu-kə təmiyɔŋ ndə wo tʉʼ fɔ̀ʼ, nɔ bɛ haʼ yɔŋ ndə ɔ bu bʉ̀nə kie kəghɔ-Tiekətʉ, kə ɔ bɛ fʉə, kə ɔ gòʼ təmə bɛ fʉə fɛ. <verse eid="EPH 6:8" /><verse number="9" style="v" sid="EPH 6:9" />Bətiefɔʼɔ, b̈ii kə́ chìi haʼ nɔ, kaa məfyúhə shʉ-yii, kə́ kínə mbɔ mbəŋ-ɛŋ ndə ɔ bɛ Tiefɔʼ-yʉə bɔŋ-kə́-leʼ bɛ yii-yə ghɔ, nɔ bɛ yuo, təmə bɔŋ kyinə túhə shʉ fɛ.<verse eid="EPH 6:9" /></para>
  <para style="s">Fɔ-chɔ-Nyii-bə inchəŋ</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />Ndə məlìʼ, b̈ii tə́nə shʉ́əshʉ́ə mu Tiekətʉ, kə́ shʉ́ə bə nə ghʉəʼkə-i. <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />B̈ii mɔ̀ʼ fɔ-chɔ̂-Nyii-bə inchəŋ mbʉə bii, i chʉʼ kwáa bii ndə mələ́ʼ mənaa Debulu. <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />Bʉʼka bʉʼʉ tʉʼ gwúu byuʼu bə bʉʼʉbə bʉəməsʉʉ fɛ, bʉʼʉ nɔ tʉʼ gwúu byuʼu bʉʼʉbə bʉə njəŋ kədɔŋ, kə́ gwúu byuʼu bʉʼʉbə lyʉʉhəbə ndə bɔ̂ŋ tʉʼ sɔ́ʼ nə bəfɔŋ njəŋ kədɔŋ, kə́ gwúu bʉʼʉbə ghʉəʼ-bʉəbʉə-bə ndə bɔ̂ŋ bɛ mu njəŋ-yuo-hə. <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />Nɔ, b̈ii mɔ̀ʼ fɔ-chɔ̂-Nyii-bə inchəŋ mbʉə-bii, mbɔ i chʉʼ yi kwáa bii ndə mətə́nə ndə mbi bʉəbʉə, ndʉʉ ndə bii nɔʼ mɔ̀ʼ inchəŋ, b̈ii tə́nə shʉ́əshʉ́ə. <verse eid="EPH 6:13" /><verse number="14" style="v" sid="EPH 6:14" />Nɔ, b̈ii tə́nə shʉ́əshʉ́ə, kɔ́ʼ kwɔ-shʉəŋ-kə kəlyuʼ-bii, mɔ̀ʼ fɔ-chɔ̂-bə ndə məkyʉ̀hə fyiihə-ii nə yɔŋ, kə́ bɛ mətə́nə ndyʉndyʉ, <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />takwubə-ii, kə́ bɛ məshʉ̀tə ŋwɔŋ-yii ndə məgɛ̀ nə ntəŋjyujyu ndə i gwè nə fyiighʉ́ənə. <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />Ndə nubə inchəŋ, b̈ii chɔ̀ʼhə ŋgɔŋ-chɔ̂-hə-ii kɔ́ ghɔʼ kə́ bɛ məmɔ̀ʼfyii ndəŋ Nyii, kə́ bɛ fɔkə ndə bəkɔ i kwáa bii ndə məyùʼ mənyɔ ndə i fyú hə ndəŋ ghʉ̂ʉ ŋwɛŋ ndə bəkɔ Wo bʉəbʉə mɔ̀ʼ bii nə yɔŋ. <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />B̈ii kwóhə ghʉʉkə kətʉ-bii kə́ bɛ ŋkwaa ndə i gwè hə kəghɔ-Nyii, bɔŋleʼ yá setə-chɔ̂-kəLyʉʉhəNyii-kə ndə bɛ ŋgieNyiikə kəghɔ-bii. <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />B̈ii kə́ gháaNyii təvɛʼtəvɛʼ haʼ ndə LyʉʉhəNyiikə tʉʼ ŋɔ́ʼhə shʉ-yii, nə ntɛ-məgháaNyii-hə inchəŋ bɔŋ-kə́-leʼ fʉ̀ʉtə Nyii. B̈ii kaa nə tʉbə-ii ghɔʼ, lyʉ̀ʉtə́nə ndə mə-kə́-gháaNyii tʉ bʉə-Nyii bənchəŋ. <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />Bɔŋleʼ kə́ gháaNyii tʉ mɔ ghɔ mbɔ b̈ə kɔ́ ŋgiebə chu mɔ ndə məghə̀ŋ fyii ndʉʉ ndə mɔ tʉʼ kɛ̀ʼ nubə tʉ bʉə ndə bə kə lə̀ŋ mu ntəŋjyujyu. <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />Bə nɔ nə kɔ́ʼtə mɔ nə bəchaŋ bʉʼka mɔ bɛ ntyukətʉ-Jiso Klai kə́ lɔ̀ʼ ntəŋjyujyu-ɔ̄. B̈ii gháaNyii mbɔ m̈ɔ lɔ̀ʼ mbʉ ntəŋ nə fyii shʉ́əshʉ́ə ndə ntɛhə ndə mɔ kie ndə məlɔ̀ʼ.<verse eid="EPH 6:20" /></para>
  <para style="s">Ndyiʼtə-nchaʼtə-kə</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />Ndə mə-leʼ-chìi ghɔ bii kínə ntɛhə ndə mɔ bɛ ghɔŋbə ntɛ-kənu ndə mɔ tʉʼ fɔ̀ʼ, Taikiku liŋ-ɔŋ ndə mɔ kʉ̀ʉ ɔ daa bɔŋleʼ kə́ bɛ wo ndə ɔ tʉʼ fɔ̀ʼ tʉ Tiekətʉ nə fyii-i imɔʼ, bu shyíi bii nə nubə inchəŋ. <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />Mɔ nɔ tʉʼ tə́ŋ ɔŋ tʉ bii bʉʼka luu-ɔ̄, mbɔ bii chʉʼ kínə ndə baʼa bɛ, ɔ bɔŋleʼ kwèʼhə bii.<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />Nyii mbʉ Tie ghɔŋbə Jiso Klai Tiekətʉ, kɔ́ fyiighʉ́ənə tʉ bʉə-Nyii bənchəŋ, chìi bɔŋ kʉ̀ʉ ŋwɔŋtə-ʉə bɔŋleʼ mɔ̀ʼfyiihə-ʉə ndəŋ Jiso. <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />Tə Nyii dʉ̀ʼ buuŋjyu tʉ bʉə bənchəŋ ndə bɔ̂ŋ kʉ̀ʉ Tiekətʉ-yʉʼʉ Jiso Klai nə ŋkʉ̂ʉ təmə liʼ-i ghɔ fɛ.<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>