<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Bamunka New Testament</book>
  <para style="h">Jɛŋ</para>
  <para style="toc1">Ŋwɔʼnə ndə Jɛŋ kə nyɔ̀ʼ</para>
  <para style="toc2">Jɛŋ</para>
  <para style="toc3">Jɛŋ</para>
  <para style="mt2">Ŋwɔʼnə ndə</para>
  <para style="mt1">Jɛŋ</para>
  <para style="mt2">kə nyɔ̀ʼ</para>
  <para style="imt">Nchoʼtə bətʉ bənu</para>
  <para style="ip">Ŋwɔʼnə-ɔ̄ŋ nɔ bɛ ŋwɔʼnə ndə Jɛŋ kə chə̀ŋtə bəbɛʼnu-jyujyu-bə ndə ɔ kə́ tòʼ dàhə kəyəŋ kəmɔʼ muŋgɔ, nyɔ̀ʼ kɔ́ tʉ bʉə-Nyii bənchəŋ ndə bɔ̂ŋ wɔ̀ʼnə mu kəwʉʉnəmbi inchəŋ. Jɛŋ nɔ lʉ̀ nubə ndə fʉʼkənu gɛ̀ dʉ̀ʼ nubə chɔ ndə ɔ tʉʼ dàhə nə fɔ-ghɔ̄-bə, ndə mədàhə te mukətʉ-súunə ndə ĩ fɔ̀ʼ ghɔŋbə ntɛhə ndə nuʼ bʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii kie ndə məbɛ.</para>
  <para style="ip">Lʉ̀ hə ndə ntɛhə ndə b̃ʉə ndə bɔ̂ŋ nɔʼ bɛ́ŋ Nyii lɛ́nə nubə, ɔ nɔʼ kwə́ʼ ndəŋ nubə nə fʉʼkə, byuukə, ŋgʉəʼ, nuʼ jyujyu, mətúhə shʉ, məbɛ́ŋ Nyii ghɔŋ fɔʼtə, məyá tʉ-kəlɛɛŋhə-kə, mukətʉ-súunə, məmɔ̀ʼ chyuu, mədʉ̀ʼ ŋwɔŋ ghɔŋ mbuɔnəbə, məchʉ̀ə ŋkwɛ bəbɛʼbʉə, məkwɛ̀ŋ fyii, məyá fyii leʼnə məgháaNyii.</para>
  <para style="ip">Ɔ nɔʼ kə kwə́ʼ shʉ́əshʉ́ə te nu-jyujyu-bə ndə i bɛ mu fɔʼtə ghɔŋbə məmɔ̀ʼfyii ndəŋ Nyii tʉ wo ndə ɔ tʉʼ gɛ̀ hə bɔ̌ŋ Klai.</para>
  <para style="iot">Nubə ndə i bɛ mu ŋwɔʼnə-fɛ̄ŋ</para>
  <para style="io1">Nchʉʉhə-bənu 1:1</para>
  <para style="io1">Məmɔ̀ʼfyii ghɔŋbə mukətʉ-súunə 1:2-8</para>
  <para style="io1">Byuukə ghɔŋbə nchuɔ 1:9-11</para>
  <para style="io1">Mə-kə́-yúotə wo ghɔŋbə mə-kə́-mùutə wo mbɔ ɔ chìi bʉ̂ʼʉ 1:12-18</para>
  <para style="io1">Mə-kə́-yʉ́ ghɔŋbə mə-kə́-fɔ̀ʼ 1:19-27</para>
  <para style="io1">Məshyùu tyunəkə te mətúhə shʉ 2:1-13</para>
  <para style="io1">Məmɔ̀ʼfyii ghɔŋbə fɔʼɔ 2:14-26</para>
  <para style="io1">Kʉlʉtɛŋ ghɔŋbə tʉ-kəlɛɛŋhə-kə-i 3:1-18</para>
  <para style="io1">Kʉlʉtɛŋ ghɔŋbə wʉʉnəmbikə 4:1–5:6</para>
  <para style="io1">Tʉʼtə ntɛntɛhə 5:7-20</para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="s">Nchaʼtə ndə i gwè hə kəghɔ-Jɛŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />Nɔ nyɔ̀ʼ mbəŋ-ɔŋ Jɛŋ, nyɔ̀ʼ ŋwɔʼnə-ɔ̄ŋ, ndə mɔ bɛ vaantie Nyii ghɔŋbə Jiso Klai mbʉ Tiekətʉ.</para>
  <para style="p" vid="JAS 1:1">Mɔ nɔ nyɔ̀ʼ tʉ bʉə-Nyii ndə bɔ̂ŋ bɛ mu lɔŋ-Isilɛ-bə njuɔ bûu nə wuŋ ndə bɔ̂ŋ kə nyʉ́ʉ wɔ̀ʼnə mu lɔʼɔ-bətə̂ŋ-kədɔŋ-tə.</para>
  <para style="p" vid="JAS 1:1">Mɔ gìe tʉ bii.<verse eid="JAS 1:1" /></para>
  <para style="s">Məmɔ̀ʼfyii ndəŋ Nyii ghɔŋ məyá fyii</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />Bəliŋ-bɔŋ, b̈ii lʉ̀ ndə tʉʉjyu, ndʉʉ ndə nu-shʉ́əshʉ́ə-bə gwè tʉ bii ntɛntɛhə, <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />kə́ kínə mbɔ məmùutə ndə bə bu mùutə bii bʉʼka məmɔʼfyiihə-ii ndəŋ Jiso Klai, bu gwè nə məlyʉ̀ʉtə́nə. <verse eid="JAS 1:3" /><verse number="4" style="v" sid="JAS 1:4" />B̈ii mɛ̀ʼtə məlyʉ̀ʉtə́nə fɔ̀ʼ fɔʼɔ-ɛ gɛ̀ lìʼ, mbɔ bii chʉʼ kɛŋ bɛ kʉ̀ʼnə təmə kə́ byúu nubɛʼkə mu məchimbi-bii fɛ.<verse eid="JAS 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 1:5" />Kaʼ wo mu bii byúu mukətʉ-súunə, ɔ̈ bíʼtə tʉ Nyii ndə ɔ̃ kɔ́ yɔ̀ʼ ghɔkə-i təmə kə́ sɔ́ʼ wo ndə ɔ bíʼtə fɛ, bə bu kɔ́ tʉ ɔŋ. <verse eid="JAS 1:5" /><verse number="6" style="v" sid="JAS 1:6" />Ɔ kʉ̂ʉ bɔŋ kə́ bíʼtə nɔ, mɔ̀ʼfyii-i ndəŋ Nyii təmə kə́ jínə fɛ, bʉʼka wo ndə ɔ̃ jínə nukə nɔ bɛ nə lɛɛŋhə-muu-kə ndə fʉʉkə tʉ́ʉhə kɔ́ bəviabəvia. <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />Ntɛ wo-maa-ɔ̄ŋ kie ndə mə-kə́-kwɔ̀ʼtə mbɔ ɔ bu kie fɔkə kəghɔ-Tiekətʉ fɛ. <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />Ɔ nɔ bɛ nə wo təbuuŋ bûu təmə tə́nə ndəŋ fia imɔʼ ndə nubə inchəŋ ndə ɔ tʉʼ fɔ̀ʼ fɛ.<verse eid="JAS 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />Wo ndə ɔ mɔ̀ʼfyii-i ndəŋ Nyii təmə fɔkə-i bɛ ghɔ fɛ, ẗʉʉ-i kə́ bʉ̀ʉ bʉʼka mbɔ Nyii nɔʼ chɔ̀ʼhə ɔŋ ghɔʼ. <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />Bɔŋ ẗʉʉ wo-kəfʉʼ kə́ bʉ̀ʉ bʉʼka Nyii nɔʼ shúʼhə bɔŋ sê, bʉʼka bɔ̂ŋ nɔ bɛ nə yii-ŋkɔ-bə muŋkɔ ndə i bu yi yúɔnə mì. <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />Bʉʼka c̃hichi nɔ sɔ́ʼ nɔ, i tɔ̀ŋ, chìi ŋkɔ yúɔnə, yii-ŋkɔ-bə-bi chóʼnə gwùtə sê, məbʉʉ-i mì. Nɔ bɛ haʼ nɔ ndə wo ndə ɔ tʉʼ nyʉ́ʉ bɔ̌ŋ kəfʉʼ bu sɛ̀nə mì.<verse eid="JAS 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />Tʉʉjyu nɔ bɛ yi-wo-yə ndə ɔ lyʉ̀ʉtə́nə shʉ́əshʉ́ə ndʉʉ ndə nu-shʉ́əshʉ́ə-bə tʉʼ gwè tʉ ɔŋ, bʉʼka mbɔ ndʉʉ ndə ɔ bu tə́nə tə gɛ̀ lìʼ nɔ, bə bɛ́ŋ ɔŋ, fùɔ ŋgʉʼʉ məchímbi kətʉ-ɔ təmə liʼ-i ghɔ fɛ, ndə Nyii nɔʼ kɔ̀ʼnə tʉ bʉə ndə bɔ̂ŋ kʉ̀ʉ ɔ. <verse eid="JAS 1:12" /><verse number="13" style="v" sid="JAS 1:13" />Kaʼ bə kə́ mùutə wo ndə məgwù mu bʉʼʉ, kə ɔ məghɔ̀ŋ mbɔ, “Nɔ tʉʼ mùutə Nyii mùutə mɔ fɛ.” Bʉʼka mbɔ bə mə mùutə Nyii ndə məchìi bʉ̂ʼʉ fɛ, təmə mbəŋ-ɛŋ bɔŋ kyinə mùutə wo ndə məgwù mu bʉʼʉ fɛ. <verse eid="JAS 1:13" /><verse number="14" style="v" sid="JAS 1:14" />Ndʉʉ ndə b̃ə mùutə wo mbɔ ɔ gwù mu bʉʼʉ nɔ, ĩ nɔ gwè hə ndə ŋkwɔʼtə mu fyii-i ndə i tʉʼ lóʼtə ɔŋ ndə məshyùu ɔ gɛ̀ nə yɔŋ. <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />Ndʉʉ ndə mbʉ ŋkwɔʼtə gʉ́ə nɔ, i bí bʉ̂ʼʉ, mbʉ bʉ̂ʼʉ bɔŋleʼ kɛŋ shʉ̀tə tə̀ŋ nɔ, gwè nə kwu.<verse eid="JAS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16" />Kə wo mə fə́ʼhə bii fɛ ŋkɛŋ bəliŋ-bɔŋ, <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />kɔ-jyujyu-kə təmiyɔŋ ghɔŋ ŋkɛŋ kəkɔ təmiyɔŋ nɔ lɔ̀ hə kweghɔʼ, shíʼ gwè hə kəghɔ-Tie bəfɔ ndə i tʉʼ báa yuo inchəŋ təmə kyinə kíahə ndə mbi kíahə ŋwɔŋ-ɛŋ kɔ́ njəŋkə nɔ fɛ. <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />Nɔ kə bɛ ŋkʉʉnə tʉʉ-i ndə məbí bʉʼʉ tíŋ hə bɔ̌ŋ ŋgie-shʉəŋ-kə-i, mbɔ b̈ʉʼʉ bɛ ntɛ fəŋ kəfɔ mu fɔbə ndə ɔ nə chìi.<verse eid="JAS 1:18" /></para>
  <para style="s">Məyʉ́ ghɔŋbə məfɔ̀ʼ mbʉ kəŋgie</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />Ŋkɛŋ bəliŋ-bɔŋ, b̈ii yʉ́ yɔ̄ŋ-yə, ẅotəmiyɔŋ kə́ chʉʼ yʉ́ nukə, kə́ yá ŋwɔŋ-ɛŋ buŋ kə́ kwə́ʼ, təmə kə́ chʉʼ bàa tʉʉ fɛ, <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />bʉʼka tʉʉbʉə kyinə chìi wo bɛ ndyʉndyʉ shʉ-Nyii fɛ.<verse eid="JAS 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JAS 1:21" />Nɔ, b̈ii mɛ̀ʼtə mənyàatə ŋwɔŋ-aŋ, fyúhə nu-bʉəbʉə-bə mbʉə-a, lʉ̀ ŋwɔŋ-aŋ sê fí ŋgieNyiikə ndə bə nɔʼ bè mu mbʉə-a, ndə bəkɔ i kwáa a.<verse eid="JAS 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22" />B̈ii bɔŋ kə́ fɔ̀ʼ nukə ndə mbʉ kəŋgie tʉʼ ghɔ̀ŋ tʉ bii, kə bii mə kə́ fə́ʼhə ŋwɔŋ-yii ndə mə-kə́-yʉ́ haʼ yʉ́ fɛ. <verse eid="JAS 1:22" /><verse number="23" style="v" sid="JAS 1:23" />Bʉʼka mbɔ kaʼ wo kə́ yʉ́ haʼ mbʉ kəŋgie yʉ́ təmə kə́ fɔ̀ʼ fɛ, ɔ bɛ nə wo ndə ɔ lʉ̀ fɔ-lɛ́nə-shʉ-kə kíi mbe-shʉ-i nə yɔŋ, <verse eid="JAS 1:23" /><verse number="24" style="v" sid="JAS 1:24" />bʉʼka mbɔ ɔ lɛ́nə ŋwɔŋ-ɛŋ kʉ̂ʉ kíahə shʉ-i haʼ ndʉʉmɛ, tuŋ leʼnə ntɛhə ndə ɔ bɛ. <verse eid="JAS 1:24" /><verse number="25" style="v" sid="JAS 1:25" />Bɔŋ wo ndə ɔ kíi mu ŋkɛŋ nuʼ-Nyii, ñuʼ ndə i ŋɔ́ʼhə fia tʉʼ ighʉ́ʉnə tʉ bʉə, kaʼ ɔ tʉ́ʼ ndaahə-i chɔ təmə bɛ wo ndə ɔ tʉʼ yʉ́ bʉ̀nə leʼnə fɛ, bɔŋ-kə́-leʼ bɛ wo ndə ɔ tʉʼ fɔ̀ʼ mbʉ kənu ndə ɔ̈ yʉ́, ɔ bu kie tʉʉjyu ndə nubə ndə ɔ tʉʼ fɔ̀ʼ.<verse eid="JAS 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26" />Kaʼ wotəmiyɔŋ kwɔ̀ʼtə mbɔ ɔ bɛ wo-Nyii, təmə kə́ yá tʉ-kəlɛɛŋhə-kə-i fɛ, ɔ nɔ tʉʼ fə́ʼhə ŋwɔŋ-ɛŋ, ntɛ wo-ɔ̄ məghaaNyii-i nɔ bɛ njʉnjʉ. <verse eid="JAS 1:26" /><verse number="27" style="v" sid="JAS 1:27" />MəgháaNyii, ndə bɛ ŋkɛŋ ɛŋ təmə bə nɔʼ bʉ́əhə bəshʉ-Nyii mbʉ Tie fɛ, nɔ bɛ məlɛ́nə vâabəti ghɔŋbə bəkwuʼ bəke mu ŋgʉəʼ-yʉə leʼnə məyá fyii-a ndəŋ wʉʉnəmbikə ndə məbʉ́əhə a.<verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="s">Məshyùu tyunəkə te mətúhə shʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />Bəliŋ-bɔŋ, nduɔ ndə bii nɔʼ mɔ̀ʼfyiihə-ii ndəŋ Jiso Klai Tiekətʉ, ɔ kə́ bɛ Tiekətʉ məgʉ́ə nɔ, bii mə kə́ túhə shʉ fɛ.<verse eid="JAS 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 2:2" />Ndə fʉʼkənu, kaʼ wo gwè nchəŋtə-bii, kɔ́ vâafyîi goo kəghɔ-ɔ bɔŋleʼ kɔ́ʼ ŋwɔŋ-ɛŋ nə ndyi-kyʉə-hə, wokəbyuubɛʼ ghɔ leʼ gwè nə ndyi-jɔ̀ʼnə-hə mbʉə-ɔ <verse eid="JAS 2:2" /><verse number="3" style="v" sid="JAS 2:3" />kaʼ bii lɛ́nə wo ndə ɔ kɔ́ʼ ŋwɔŋ-ɛŋ nə ndyi-kyʉə-hə gìe tʉ ɔŋ mbɔ, “Dùʼ fɛ̄ŋ ndəŋ yəŋ-jyujyu-kə,” ndʉʉmɛ, bii gìe tʉ wokəbyuu-i mbɔ, “Gɛ̀ dùʼ fīi,” byuunɔ, “Shyíʼ dùʼ sê bəshʉ-mɔ,” <verse eid="JAS 2:3" /><verse number="4" style="v" sid="JAS 2:4" />təmə bii chʉʼ túhə shʉ mu bii ndə məkwɛ̀ ŋkwɛ nə ŋkwɔʼtə bʉəbʉə fe?<verse eid="JAS 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5" />B̈ii yʉ́, ŋkɛŋ bəliŋ-bɔŋ, Nyii chʉʼ séʼ bʉə-kəbyuu kəchisê fɛ̄ŋ ndə məkie fʉʼkə tíŋ hə bɔ̌ŋ məmɔʼfyiihə-ʉə ndəŋ Nyii bɔŋleʼ bɛ njuhə ntoʼ-Nyii, ndə ɔ nɔʼ kə kɔ̀ʼnə tʉ bʉə ndə bɔ̂ŋ kʉ̀ʉ ɔ fe? <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />Bɔŋ bii nɔ mɔ̀ʼ tʉvyii-wokəbyuu-kə. Bɔŋ kaa bʉə-kəfʉʼ ndə bɔ̂ŋ tʉʼ chɔ́ŋhə bii, bɔŋleʼ dùu bii gɛ̀ nə yɔŋ mu njaafɛ̀ʼ fe? <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />Kaa bɔ̂ŋ ndə bɔ̂ŋ tʉʼ dʉ̀ʉhə yie-Jiso ndə bɛ yiekwɛʼtəŋ ndə bə tʉʼ tíi bii nə yɔŋ fe?<verse eid="JAS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8" />Kaʼ tʉ́ʼ nuʼ ntoʼ-Nyii shʉəŋshʉəŋ kɛŋ haʼ ndə i bɛ mu ŋwɔʼnə-Nyii, “Kʉ̀ʉ wo-kətoʼ-a haʼ ndə a kʉ̀ʉ ŋwɔŋ-aŋ,” təmə a nɔ tʉʼ fɔ̀ʼ jyujyu. <verse eid="JAS 2:8" /><verse number="9" style="v" sid="JAS 2:9" />Bɔŋ kaʼ bii kə́ túhə shʉ, təmə bii nɔ tʉʼ chìi bʉ̂ʼʉ bɔŋ ndə nuʼ-Nyii bə bu lʉ̀ bii nə bʉə-bʉ̂ʼʉ ndə bɔ̂ŋ tʉʼ bə́ʼ nuʼ-Nyii.<verse eid="JAS 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JAS 2:10" />Bɔŋ wotəmiyɔŋ ndə ɔ tʉ́ʼ mbʉ nuʼ inchəŋ bɔŋ bə́ʼ imɔʼ nɔʼ gwù mbʉ nuʼ inchəŋ. <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />Nyii ndə ɔ kə ghɔ̀ŋ mbɔ, “Kə a mə gháa bəsəŋ fɛ,” nɔ leʼ gìe ghɔ mbɔ, “Kə a mə yí wo fɛ.” Kaʼ gòʼ təmə kə́ gháa bəsəŋ fɛ, bɔŋ kə́ yi wo, təmə a nɔʼ bə́ʼ nuʼ.<verse eid="JAS 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 2:12" />Nɔ, nukə təmiyɔŋ ndə a gìe, byuunɔ yi ndə a chìi, kə́ kwɛ́nə mbɔ bə bu chʉ̀ə ŋkwɛ-a bʉəbʉə nə nuʼ-Nyii ndə i chìi tʉkə-a lʉ́ʉ a. <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />Bʉʼka bə mədʉ̀ʼ tʉvyiikə tʉ wotəmiyɔŋ ndə ndʉʉ məchʉ̀ə ŋkwɛ ndə ɔ nɔʼ nə gòʼ təmə dʉ̀ʼ tʉvyiikə fɛ. Tʉ-Nyii-kə bu vyíi tʉ wotəmiyɔŋ ndə ɔ dʉ̀ʼ tʉvyiikə ndʉʉ ndə Nyii tʉʼ chʉ̀ə ŋkwɛ-ɛ.<verse eid="JAS 2:13" /></para>
  <para style="s">Məmɔ̀ʼfyii ndəŋ Nyii təmə kə́ fɔ̀ʼ fɛ nɔ kwú</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />Bəliŋ-bɔŋ, bɛ yɔ̂ŋ-yə nu-jyujyu-kə ndə i bɛ tʉ wo kaʼ ɔ ghɔ̀ŋ mbɔ ɔ mɔ̀ʼfyii ndəŋ Nyii təmə bɔŋ kə́ fɔ̀ʼ fɛ? Bəkɔ ntɛ məmɔʼfyii-maa-ɔ̄ŋ kwáa ɔ mɛ? <verse eid="JAS 2:14" /><verse number="15" style="v" sid="JAS 2:15" />Kaʼ liŋ-aŋ woləŋ byuunɔ woke mu Nyii, byúu ndyi ndə məmɔ̀ʼ byuunɔ təmə kie fɔyubə bəchibəchi ndə məyú fɛ, <verse eid="JAS 2:15" /><verse number="16" style="v" sid="JAS 2:16" />bɔŋ mbyu wo mu bii gìe tʉ ɔŋ mbɔ, “Tòʼ jyu, gɛ̀ mbʉə-a ghɔʼ, bɔŋleʼ yú yuo,” təmə bɔŋ kɔ́ fɔkə tʉ ɔŋ ndə ɔ tʉʼ byúu fɛ, bɛ yɔ̂ŋ-yə nu-jyujyu-kə ndə bii fɔ̀ʼ nə nɔŋ?<verse eid="JAS 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 2:17" />Nɔ bɛ haʼ nɔ ndə məmɔ̀ʼfyii bɛ nə mbəŋ-ɛŋ, kaʼ məmɔ̀ʼfyii gòʼ təmə dʉ̀ʼ ndə fɔ̀ʼ fɛ, təmə i nɔʼ kwú.<verse eid="JAS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18" />Bɔŋ wobɛʼ bu ghɔ̀ŋ mbɔ, “A nɔ mɔ̀ʼfyii-a ndəŋ Nyii, mɔ bɔŋ kə́ fɔ̀ʼ yɔŋ-yə bɛ fɔ̀ʼ.” Dʉ̀ʼ tʉ mɔ ndə a mɔ̀ʼfyii-a ndəŋ Nyii təmə fɔ̀ʼ fɛ, mɔ dʉ̀ʼ tʉ a ndə mɔ mɔ̀ʼfyii-ɔ ndəŋ Nyii nə fɔʼɔ-ɔ.<verse eid="JAS 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 2:19" />A nɔ kínə mbɔ Nyii nɔ bɛ imɔʼ, i nɔ kʉ̀ʼnə. Buŋ lyʉʉhəbʉəbʉəbə nɔ kínə haʼ nɔ ghɔ, tə bɔ̂ŋ kə́ gwònə. <verse eid="JAS 2:19" /><verse number="20" style="v" sid="JAS 2:20" />Nɔ̌ʼ-ɔ̄ŋ, a tʉʼ kʉ́ʉ mbɔ b̈ə dʉ̀ʼdʉ̀ʼ tʉ a, mbɔ məmɔ̀ʼfyii ndəŋ Nyii təmə fɔ̀ʼ fɛ, bɛ njʉnjʉ mɛ? <verse eid="JAS 2:20" /><verse number="21" style="v" sid="JAS 2:21" />Bə kə́ lʉ̀ tie-yʉʼʉ Ablahaŋ ndə məbɛ ndyʉndyʉ tíŋ hə bɔ̌ŋ fɔʼɔ-ɛ bʉʼka ɔ kə fɛ̀ʼndɛŋ nə vaa-ɛ, Aisi, ndəŋ kəyəŋfɛ̀ʼndɛŋNyii fe? <verse eid="JAS 2:21" /><verse number="22" style="v" sid="JAS 2:22" />Bəkɔ a nyíɛ mbɔ məmɔʼfyii-i nɔ kə́ tòʼ ghɔŋbə fɔʼɔ-ɛ, məmɔʼfyii-i nɔ kə gɛ̀ kùu tíŋ hə bɔ̌ŋ fɔʼɔ-ɛ. <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />Ŋwɔʼnə Nyii nɔ nə fyú shʉəŋ ndə i kə ghɔ̀ŋ mbɔ, “Ablahaŋ nɔ nə bɛ́ŋ Nyii, i chìi bə lʉ̀ mbɔ ɔ la bɛ ndyʉndyʉ bəshʉ-Nyii.” Bə tíi ɔ nə tiekənu Nyii. <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />A le nyíɛ nduɔ mbɔ w̃o nɔ bɛ kʉ̀ʼnə bəshʉ-Nyii ndə fɔ̀ʼ kaa bə haʼ ndə məmɔ̀ʼfyii ndəŋ Nyii fɛ.<verse eid="JAS 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25" />Nɔ bɛ haʼ nɔ ndə Laha, ndə ɔ kə́ bɛ sɔkʉʉ, kə bɛ ndyʉndyʉ bəshʉ-Nyii ndʉʉ ndə ɔ kə lʉ̀ mbʉ bʉə-ntəŋ-ghɔ̄bə fyúhə bɔŋ kɔ́ mbi ndə ibɛʼ-yə fia fe? <note caller="+" style="f"><char style="fr" closed="false">2:25 </char><char style="ft" closed="false">Ŋwɔʼnə Joshua kuŋkə ibûu nɔ tʉʼ gìe yɔ̄ŋ-yə.</char></note> <verse eid="JAS 2:25" /><verse number="26" style="v" sid="JAS 2:26" />Bʉʼka mbɔ haʼ ndə ŋkwê mbʉə-a bɛ təmə lyʉʉhəkə fɛ bɛ kwu, məmɔ̀ʼfyii ndəŋ Nyii təmə fɔ̀ʼ fɛ nɔ bɛ kwu.<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="s">Yá tʉkə lɛɛŋhəkə-a</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />Bəliŋ-bɔŋ, kə bʉə buŋmbi mə-kə́-fʉʼ fʉʼkə ndə mə kə́ dàhə mu njaa-Nyii fɛ, bʉʼka bii nɔ kínə mbɔ bʉʼʉ ndə bʉʼʉ tʉʼ dàhə, Nyii bu kwɛ̀ sɔ́ʼ-yʉʼʉ shʉ́əshʉ́ə.<verse eid="JAS 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 3:2" />Bʉʼʉ nɔ tʉʼ gwù ndə fiatə buŋmbi, kaʼ wo gòʼ təmə gwù ndə ŋgie-chu-kə-i fɛ, təmə ɔ nɔ kɛŋ bɛ ŋkɛŋ wo təmə mɔ̀ʼmbɛ mu məchimbi-ɔ fɛ. Bəkɔ ɔ yá ŋwɔŋ-ɛŋ. <verse eid="JAS 3:2" /><verse number="3" style="v" sid="JAS 3:3" />Kaʼ bə kɔ́ fyîihə chu bənyaa bəkatə mbɔ b̈ɔŋ kə́ yʉ́ nukə, mbʉ fyîihə kə́ fɔ̀ʼ ndə mbʉə-yʉə inchəŋ ghɔ. <verse eid="JAS 3:3" /><verse number="4" style="v" sid="JAS 3:4" />B̈ii nyíɛ ndə buukwɛʼtəŋbə ndə i bɛ mu muu ghɔ, buŋ ndə bɔ̂ŋ gyʉ̀ətə daa, fʉʉ-shʉ́əshʉ́ə-bə kə bɛ̀ʼ tòʼ nə yɔŋ nɔ, fɔ-kíahə-mbʉ-kəbuukwɛʼtəŋ-kə ndə bə te nə yɔŋ nɔ vaantikəniʼ kəfɔ, i bɔŋ kə́ kíahə ɔŋ kɔ́ ndə viakə təmiyɔŋ ndə wo ténə-i tʉʼ kʉ́ʉ ndə məkíahə kɔ́ chɔ. <verse eid="JAS 3:4" /><verse number="5" style="v" sid="JAS 3:5" />Nɔ bɛ haʼ nɔ ndə lɛɛŋhəkə-a bɛ, ṽaa kəfɔ mu mbʉə-a bɔŋ nɔ kwɛ̀ŋ fyii ndə nukwɛʼtəŋbə.</para>
  <para style="p" vid="JAS 3:5">Nɔ kə bɛ haʼ nɔ ndə vaambunə viʼi tɔ̀ŋ bɔʼɔkwɛʼtəŋ. <verse eid="JAS 3:5" /><verse number="6" style="v" sid="JAS 3:6" />Lɛɛŋhə-wo-kə nɔ bɛ viʼi ghɔ, i nɔ bɛ yəŋ-bʉəbʉəkwɛʼtəŋ-kə mu yəŋ-mbʉə-bə. Ñɔ bʉ́əhə yɔŋ bʉ́əhə wo inchəŋ. Ĩ nɔ kíahə məchímbi wo inchəŋ kɔ́ viʼi kyʉ́ʉ, m̃bʉ kəlɛɛŋhə nɔ kie viʼi-i hə kəghɔ-Sata.<verse eid="JAS 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 3:7" />Bʉəməsʉʉ nɔ nə kə́ lóʼtə bɔŋ kə́ bíe lóʼtə ntɛ-nyaa-hə inchəŋ ghɔŋbə nuɔmə, nyaahə ndə bɔŋ shyìi ndyʉndyʉ ghɔŋbə fɔ-mu-muu-bə, <verse eid="JAS 3:7" /><verse number="8" style="v" sid="JAS 3:8" />təmə woməsʉʉ bɔŋ məlóʼtə tʉ-kəlɛɛŋhə-kə-i fɛ. Nɔ bɛ fɔ-bʉəbʉə-kə ndə wo mə nə gìe kətʉ-ɔ fɛ, nɔ bɛ kɛŋ ndyʉʼ yí wo. <verse eid="JAS 3:8" /><verse number="9" style="v" sid="JAS 3:9" />B̃ʉʼʉ nɔ lə̀ʼtə Nyii Tiekətʉ ndə bɛ Tie-yʉʼʉ nə tʉ-kəlɛɛŋhə-kə, bʉʼʉ lʉ̀ haʼ yɔŋ túu ndɔŋ kɔ́ kətʉ bʉə ndə Nyii chìi ndə finə-i. <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />Ndəŋ tʉ-kəlɛɛŋhə-kə imɔʼ, b̃ə nɔ lə̀ʼtə bʉ̀nə chɛ̀ŋ haʼ nə yɔŋ. Bəliŋ-bɔŋ, i kie ndə məbɛ nɔ fɛ. <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />Bəkɔ ŋgwɛŋ imɔʼ kie muu-ghʉ́ə-mə ghɔŋbə muu-ghɔʼ-mə mɛ? <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />Bəliŋ-bɔŋ, bəkɔ bìa kʉ́ʉnə maŋgutə mɛ, byuunɔ bəkɔ yɔŋ məkʉ́ʉnə bìa mɛ? Təmə a bɔŋ mətʉ́ muu-ghʉ́ə-mə mu byʉʉ muu-ghɔʼ-nə fɛ.<verse eid="JAS 3:12" /></para>
  <para style="s">Mu kətʉ súunə nɔ gwè hə kəghɔ-Nyii</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />Bɛ nda mu bii ndə ɔ kie mukətʉ-súunə bɔŋleʼ kə́ kínə nukə? Ɔ̈ fɔ̀ʼ ndə mədʉ̀ʼ nuʼ jyujyu-i bɔŋleʼ lʉ̀ ŋwɔŋ-ɛŋ sê ndə mədʉ̀ʼ mukətʉ súunə-i. <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />Kaʼ a kɛŋ kə́ túunə bəfyuʼ mu fyii-a shʉ́əshʉ́ə leʼnə mu fyii ndə məkie tətɛʼ-a inchəŋ, kə a mə kə́ ŋàʼtə nə yɔŋ, kə́ bɔŋ shʉəŋ sê fɛ. <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />Yɔ̄ŋ-yə kaa mukətʉ-súunə ndə i shíʼ gwè hə yuo fɛ, i nɔ lɔ̀ hə kəchisê, kə́ bɛ ŋkoʼnə bətɔ woməsʉʉ, gwè hə kəghɔ-Debulu. <verse eid="JAS 3:15" /><verse number="16" style="v" sid="JAS 3:16" />Bʉʼka ỹəŋkə ndə bə túunə bəfyuʼ chɔ, wo kə́ kwɔ̀ʼtə bə haʼ yi-yə ŋwɔŋ, m̃byuutəmbyuutə nɔ bɛ chɔ ghɔŋ ntɛ bənu-bʉəbʉə-hə inchəŋ.<verse eid="JAS 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 3:17" />Bɔŋ mukətʉ-súunə ndə i shíʼ hə yuo, ĩ nɔ bɛ tʉ́ʉnə, kə́ kʉ́ʉ nu-fyiighʉ́ənə-bə, kə́ kie mbuɔnəbə, kʉ̀ʉ ndə məjìʼtə nubə, kə́ kie tʉvyii-yɔ́ŋyɔ́ŋ-kə bɔŋleʼ kə́ kʉ́ʉnə ntɔŋ-jyujyu-mə, təmə kə́ túhə shʉ fɛ, təmə bɔŋ-kə́-leʼ làhə shʉ fɛ. <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />B̃ʉə ndə bɔŋ chìi fyii-bʉə-hə ghʉ́ə, ndə b̃ɔ̂ŋ shùɔ ŋgwie sê kə́ bɛ fyiighʉ́ənə, nɔ kwɛ̀ ntɔŋmə ndə i bɛ jyujyu.<verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="s">Məkwɛ̀ʼtə gwè mbʉə Nyii</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />Tʉʼ gwè ka nə chyuutə ghɔŋbə byuʼtə mu bii? Kaa ŋkwɔʼtə bʉəbʉə ndə i tʉʼ gwúu byuʼu mu fyii-bii fe? <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />Bii nɔ tʉʼ mʉ̀ʉ təmə kə́ kie fɛ, ndʉʉmɛ, i gwè nə bàa ndə bəkɔ i yí wo. Bii kə́ kʉ́ʉ mbɔ f̈ɔ-bʉə-bə bɛ yii-yə təmə kə́ kie fɛ, ndʉʉmɛ bii kə́ gwúu byuʼtə bɔŋleʼ mɔ̀ʼ chyuutə. Bii tʉʼ kie fɛ, bʉʼka bii tʉʼ bíʼtə fɛ. <verse eid="JAS 4:2" /><verse number="3" style="v" sid="JAS 4:3" />Bii nɔ tʉʼ bíʼtə təmə kə́ kie fɛ, bʉʼka bii nɔ tʉʼ bíʼtə nə luu bʉəbʉə, ndə məyú ndə ntɛhə ndə fyii-ii tʉʼ kʉ́ʉ.<verse eid="JAS 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JAS 4:4" />Bii bəŋghaa-bəsəŋ! Bii kínə mbɔ məchìi bətieŋkɔŋ biibə wʉʉnəmbikə, bɛ bàa tʉ biibə Nyii fe? Nɔ, wotəmiyɔŋ ndə ɔ kʉ̀ʉ ndə məchìi bətieŋkɔŋ ghɔŋbə wʉʉnəmbikə nɔ bɛ wobàa Nyii. <verse eid="JAS 4:4" /><verse number="5" style="v" sid="JAS 4:5" />Byuunɔ, bii kwɔ̀ʼtə mbɔ ŋwɔʼnə-Nyii kə mɔ̀ʼ bɛ́ ndə məghɔ̀ŋ mbɔ, “Nyii nɔ tʉʼ túunə bəfyuʼ shʉ́əshʉ́ə ndə lyʉʉhəkə<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="ft" closed="false">Bəkɔ </char><char style="it">lyʉʉhəkə</char> fɛ̄ŋ bɛ <char style="it">LyʉʉhəNyiikə</char> ghɔ.</note> ndə ɔ kɔ́ mu mbʉə-bʉʼʉ” mɛ? <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />Bɔŋ ɔ nɔ dʉ̀ʼ buuŋjyu yɔ́ŋyɔ́ŋ, ndə ŋwɔʼnə-Nyii ghɔ̀ŋ mbɔ,</para>
  <para style="q1" vid="JAS 4:6">“Nyii nɔ tʉʼ dʉ̀ʼ ghɔkə-i chu bʉə ndə bɔ̂ŋ kie tʉʉ gʉənə</para>
  <para style="q2" vid="JAS 4:6">bɔŋ ɔ nɔ tʉʼ dʉ̀ʼ buuŋjyu tʉ bʉə ndə bɔ̂ŋ lʉ̀ ŋwɔŋ-yʉə sê.”<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">Mbɔ̂hə 3:34.</char></note><verse eid="JAS 4:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="JAS 4:7" />Nɔ, b̈ii ké ŋwɔŋ-yii tʉ Nyii, kwɛ̀ŋhə tʉ Debulu, ɔ bu nyʉ́ʉ bii. <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />B̈ii kwɛ̀ʼtə gɛ̀ mbʉə Nyii, Nyii bu kwɛ̀ʼtə gwè mbʉə-bii. B̈ii sʉ̀ ghɔbə-ii, bii bʉə-bʉ̂ʼʉ, sʉ̀fyiihə-ii, bʉə təbuuŋ bûu. <verse eid="JAS 4:8" /><verse number="9" style="v" sid="JAS 4:9" />B̈ii vínə, lí bɔŋleʼ gwía. B̈ii kíahə chʉ́əʼtə-ii ndə gwia, kíahə tʉʉjyu-yii ndə məvínə. <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />B̈ii shúʼhə ŋwɔŋ-yii sê bəshʉ Tiekətʉ, ɔ bu kóʼhə a ghɔʼ.<verse eid="JAS 4:10" /></para>
  <para style="s">B̈ii láa ndə mə-kə́-chʉ̀ə ŋkwɛ bəbɛʼbʉə bʉəbʉə</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />Bəliŋ-bɔŋ, b̈ii mə kə́ tòʼ tíi yie-bəbɛʼbʉə-tə bʉəbʉə fɛ. Wo ndə ɔ tʉʼ tòʼ tíi yie liŋ-iŋ, byuunɔ kə́ chʉ̀ə ŋkwɛ-ɛ bʉəbʉə, nɔ tʉʼ gìe bʉ̂ʼʉ te nuʼ-Nyii bɔŋ-kə́-leʼ chʉ̀ə ŋkwɛ bʉəbʉə te mbʉ nuʼ. Bɔŋ kaʼ wo chʉ̀ə ŋkwɛ bʉəbʉə te mbʉ nuʼ-Nyii, təmə ɔ kaa wo ndə ɔ tʉʼ tʉ́ʼ nuʼ fɛ bɔŋ kə́ bɛ wo ndə ɔ tʉʼ kwɛ̀ nubə bʉəbʉə te mbʉ nuʼ. <verse eid="JAS 4:11" /><verse number="12" style="v" sid="JAS 4:12" />Nɔ bɛ haʼ mbyu wo-imɔʼ ndə ɔ̃ kɔ́ nuʼ, kə́ chʉ̀ə ɔ chʉ̀ə ŋkwɛ, kə́ bɛ mbəŋ-ɛŋ ndə ɔ kie ghʉəʼkə ndə məkwáa bɔŋleʼ kie ghʉəʼkə ndə məbʉ́əhə. A bɛ nda ndə mə-kə́-chʉ̀ə ŋkwɛ wo-kətoʼ-a?<verse eid="JAS 4:12" /></para>
  <para style="s">B̈ii láa ndə mə-kə́-kwɛ̀ŋ fyii te nə yɔ̂ŋ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />B̈ii yʉ́, bii ndə bii tʉʼ ghɔ̀ŋ mbɔ, “Laa byuunɔ yɔ̂ŋ baʼa bu gɛ̀ lɔʼɔ-fɛ̄ŋ byuunɔ lɔʼɔ fīi, gɛ̀ chí chɔ ndə ŋgʉʼʉmbi chìi mbɛʼnə kie sii.” <verse eid="JAS 4:13" /><verse number="14" style="v" sid="JAS 4:14" />B̈ii kínə ntɛ-kənu ndə i bu sɛŋ bɛ yɔ̂ŋ tʉ bii fɛ. Məchimbi-yii bɛ ka? Bii nɔ bɛ nə vaakəmbɔʼ ndə ĩ lɔ̀ hə sê kʉʉkə məniʼ nɔ i sɛ̀nə mì. <verse eid="JAS 4:14" /><verse number="15" style="v" sid="JAS 4:15" />Bii nɔ kie ndə məghɔ̀ŋ bə mbɔ, “Kaʼ Tiekətʉ bɛ́ŋ, baʼa chí mbi, kə́ fɔ̀ʼ yɔ̄ŋ-yə byuunɔ yīŋ-yə.” <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />Bɔŋ nduɔ, bii nɔ tʉʼ kwɛ̀ŋ fyii bə ndə yi-yə məgʉ́ə. Yɔ̄ŋ-yə ntɛ məkwɛ̀ŋ fyii nɔ bɛ yi-bʉəbʉə-yə.<verse eid="JAS 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17" />Nɔ, wo ndə ɔ kínə nu-shʉəŋ-kə ndə məfɔ̀ʼ bɔŋ tɛ́ŋ ndə məfɔ̀ʼ nɔʼ chìi bʉ̂ʼʉ.<verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="s">B̈ʉə-kəfʉʼ láa</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />B̈ii yʉ́ bʉə-kəfʉʼ, b̈ii gwía bɔŋleʼ tíi bʉʼka ŋgʉəʼ ndə i bu shíʼ ndəŋ bii. <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" />Nchuɔ-yii nɔʼ byʉ́ʼ, tuŋnchɛʼnchɛʼ kwó ndyihə-i. <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />Kɔŋkə nɔʼ kwó kyʉə-yii, mbʉ kəkɔŋ bu tə́nə ndəŋ cheʼkə yie-bii bɔŋ-bu-leʼ kwó mbɔʼ-mbʉə-yii nə viʼi ghɔ. Bii nɔʼ kóʼhə nchuɔ mu ndyiʼtə-bəchî-bə-ɔ̄ŋ. <verse eid="JAS 5:3" /><verse number="4" style="v" sid="JAS 5:4" />B̈ii nyíɛ! Kyʉə-bʉə-tə ndə bɔ̂ŋ tʉʼ fɔ̀ʼ mutɔ-bii, bii kə́ chìi ŋkwo təmə kə́ lɔ̀ʼ fɛ, tʉʼ gwía te bii, gwía bʉə ndə bɔ̂ŋ tʉʼ lʉ̀ fɔbə mutɔ-a nɔʼ dàa tʉ Tiekətʉ, ndə ɔ kie ghʉəʼkə inchəŋ.<verse eid="JAS 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 5:5" />Bii nɔʼ lʉ̀ məchimbi-yii ndə məyú mbi bɔŋleʼ kə sàtə ŋwɔŋ-yii. Bii nɔ tʉʼ yúʼ ŋwɔŋ-yii, kə́ chyìi chîkə ndə bə bu gwìatə bii chɔ. <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />Bii nɔʼ chʉ̀ə ŋkwɛ nə mbii bɔŋleʼ yítə bʉə ndə bɔŋ tə́nə ndyʉndyʉ təmə bɔ̂ŋ bɔŋ dʉ̀ʼ ghɔkə-ʉə chu bii fɛ.<verse eid="JAS 5:6" /></para>
  <para style="s">B̈ii yá fyiihə-ii mu ŋgʉəʼ</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />Bəliŋ-bɔŋ, b̈ii ghʉ́əhə fyiihə-ii tə chîkə dàa ndə Tiekətʉ bu yi gwè. B̈ii kwɔ̀ʼtə ndə wo-mutɔ chyìi mbɔ mutɔ-ɛ kʉ́ʉnə ntɔŋ-jyujyu-mə, ɔ yá fyii-i kə chyìi fəŋ wyuu ghɔŋbə ndyiʼtə-wyuu-kə ndə məfyíi. <verse eid="JAS 5:7" /><verse number="8" style="v" sid="JAS 5:8" />Mbəŋ-yii ghɔ, nɔ kie ndə məyá fyiihə-ii, tə́nə shʉ́əshʉ́ə, bʉʼka məgwè Tiekətʉ nɔʼ kə́ŋhə.<verse eid="JAS 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9" />Bəliŋ-bɔŋ, kə bii mə kə́ luŋtə te ŋwɔŋtə-ii fɛ, bʉʼka bə mə yi chʉ̀ə ŋkwɛ-yii bʉəbʉə, nyíɛ, Wo-kwɛ̀-fɛʼɛ nɔ tə́nə chusii.<verse eid="JAS 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JAS 5:10" />Bəliŋ-bɔŋ, ndə via-ŋgʉəʼ-kə leʼnə məyá fyii b̈ii lʉ̀ fʉʼkənu hə ndəŋ bʉəyʉkəŋgieNyii ndə bɔ̂ŋ nə kə kwə́ʼ yie-Tiekətʉ. <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />B̈ii kə́ kínə mbɔ bʉʼʉ nɔ kínə mbɔ bʉə ndə bɔ̂ŋ lyʉ̀ʉtə́nə nɔ bɛ bʉə-kətʉjyu. Bii nɔʼ kə yʉ́ ndə Jub kə lyʉ̀ʉtə́nə, bɔŋleʼ nyíɛ nukə ndə Tiekətʉ kə fɔ̀ʼ tʉ ɔŋ, ntɛ ndə Nyii kə kie tʉvyiikə ndəŋ ɔŋ bɔŋleʼ dʉ̀ʼ tʉvyii-yɔ́ŋyɔ́ŋ-kə tʉ ɔŋ.<verse eid="JAS 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12" />Bɔŋ ndə nchəŋnchəŋ-ɛŋ, bəliŋ-bɔŋ, kə a mə kə́ kàa nukə fɛ, kə bɛ sê, kə bɛ yuo təkɔmə fɔbɛʼkə təmiyɔŋ, bɔŋ əŋ-aŋ nɔ kie ndə məbɛ əŋ, mbee-a kə́ bɛ mbee, byuunɔ bə bu yi chʉ̀ə ŋkwɛ-a bʉəbʉə.<verse eid="JAS 5:12" /></para>
  <para style="s">Ghʉəʼkə ndə i bɛ ndə məgháaNyii</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13" />Wo bɛ mu bii ndə ɔ tʉʼ nyíɛ ŋgʉəʼ mɛ? Ɔ̈ gháaNyii. Wo bɛ mu bii ndə tʉʉ-i tʉʼ bʉ̀ʉ mɛ? Ɔ̈ lə̀ʼtə Nyii nə lyuu.<verse eid="JAS 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 5:14" />Wo bɛ mu bii ndə ɔ tʉʼ yɔ́ʼyɔ́ʼ mɛ? Ɔ̈ tə́ŋ tíi bəntəŋbəshʉ mu chɔshi, b̈ɔ̂ŋ gwè gháaNyii kətʉ-ɔ, yóʼ ɔ nə ŋgwomə yie-Tiekətʉ. <verse eid="JAS 5:14" /><verse number="15" style="v" sid="JAS 5:15" />Ndʉʉ ndə bɔ̂ŋ tʉʼ gháaNyii mɔ̀ʼfyiihə-ʉə ndəŋ ɔŋ, i bu kwáa ŋgɛɛ ndə ɔ tʉʼ yɔ́ʼyɔ́ʼ, Tiekətʉ chʉ́ʼ ɔ. Kaʼ ɔ nɔʼ kə chìi bʉ̂ʼʉ, bə bu sʉ̀fyii hə ndəŋ bʉ̂ʼʉ-e.<verse eid="JAS 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 5:16" />Ndʉʉmɛ, b̈ii gwía fyùufyùu tʉ ŋwɔŋtə-ii, gháaNyii tʉ ŋwɔŋtə-ii, mbɔ Nyii chʉʼ chʉ́ʼ bii. MəgháaNyii wo ndə ɔ tə́nə ndyʉndyʉ tʉ Nyii nɔ kie ghʉəʼ-shʉ́əshʉ́ə-kə ndə məfɔ̀ʼ. <verse eid="JAS 5:16" /><verse number="17" style="v" sid="JAS 5:17" />Ɛlaja nɔ nə bɛ haʼ woməsʉʉ ndə bʉʼʉ, ɔ gháaNyii shʉ́əshʉ́ə mbɔ wyuu mə fyíi fɛ, ndə ŋgʉʼhə itia nə bəchi ntʉʼʉ təmə wyuu chə́ŋ sê fɛ. <verse eid="JAS 5:17" /><verse number="18" style="v" sid="JAS 5:18" />Ndʉʉmɛ, ɔ bìʼ gháaNyii, yuo ŋɔ́ʼnə wyuu fyíi fɔ-sê-bə kʉ́ʉnə.<verse eid="JAS 5:18" /></para>
  <para style="s">Məbʉ̀nə gwè nə bʉə ndə bɔ̂ŋ nɔʼ kə bɛ́ŋ Nyii buŋ gwù</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19" />Bəliŋ-bɔŋ, kaʼ wo mu bii ndə ɔ nɔʼ kə bɛ́ŋ Nyii fɔ̀ʼ ŋwɔŋ-ɛŋ fyuhə hə ndəŋ fia shʉəŋ, ibɛʼ-yə wo bʉ̀nə gwè nə nɔŋ, <verse eid="JAS 5:19" /><verse number="20" style="v" sid="JAS 5:20" />ɔ̈ kínə mbɔ wotəmiyɔŋ ndə ɔ bʉ̀nə gwè nə nɔŋ ndəŋ bʉ̂ʼʉ-e, bu kwáa tʉkə-i hə ndəŋ kwú, i bɔŋleʼ sʉ̀ bʉ̂ʼʉ-e.<verse eid="JAS 5:20" /></para>
  <chapter eid="JAS 5" />
</usx>