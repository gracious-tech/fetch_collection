  <para style="h">Obadaiya</para>
  <para style="toc1">Obadaiya</para>
  <para style="toc2">Obadaiya</para>
  <para style="toc3">Oba</para>
  <para style="mt1">Obadaiya</para>
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="s1">Ñkukịd Obadaiya</para>
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />Ñkukịd Obadaiya</para>
  <para style="b" vid="OBA 1:1" />
  <para style="b" vid="OBA 1:1" />
  <para style="p" vid="OBA 1:1">Se <char style="nd">Abọọñ</char> Andikara atañ abaña Edọm ado ami,</para>
  <para style="q1" vid="OBA 1:1">Ñnyịn imikop etob ito <char style="nd">Abọọñ</char>:</para>
  <para style="q2" vid="OBA 1:1">Emaedọñ isʌñutom aka mme idịd akebo,</para>
  <para style="q1" vid="OBA 1:1">“Dakka da, yak ñnyịn ika ikinwana ekọñ ye anye.”<verse eid="OBA 1:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2" />“Se, ami ñyaanam afo asịp ke atu mme idịd;</para>
  <para style="q2" vid="OBA 1:2">eyaenekke usọọn fiin.<verse eid="OBA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3" />Ntañidem esịd mfo ubiaña fiin,</para>
  <para style="q2" vid="OBA 1:3">afo a-adʌññọ ke mme aba ikpọitiad,</para>
  <para style="q2" vid="OBA 1:3">anyʌñ abọp ufọk mfo ke anyọñ,</para>
  <para style="q1" vid="OBA 1:3">afo a-abooho idem mfo,</para>
  <para style="q2" vid="OBA 1:3">‘Anie akeme adinsuuhọ miin nnịm ke isọñ?’<verse eid="OBA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4" />Akpesʌkado afo afuurọke nte ntrukpuum</para>
  <para style="q2" vid="OBA 1:4">anyʌñ abọp efọk mfo ke atu mme ntantaafiọñ,</para>
  <para style="q2" vid="OBA 1:4">ke itie ado ami ñyausuuhọ fiin nnịm ke isọñ,”</para>
  <para style="q2" vid="OBA 1:4">
    <char style="nd">Abọọñ</char> atañ.<verse eid="OBA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5" />“Adieke mme inọ ekpediighe ubịne fiin,</para>
  <para style="q2" vid="OBA 1:5">me mme amauke ekpediighe ke akonayio;</para>
  <para style="q1" vid="OBA 1:5">o, nsoo nsobo ada ubet fiin!</para>
  <para style="q2" vid="OBA 1:5">Nte ammọ ikpiyịppe kpa ñkpọ se ammọ eyem kpọd?</para>
  <para style="q1" vid="OBA 1:5">Adieke mbon e-ekịppeke kreb ekpediighe ubịne fiin,</para>
  <para style="q2" vid="OBA 1:5">nte ammọ ikpisʌhọke idem kreb ifañ?<verse eid="OBA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6" />Ado se naña ediibịme Isọ,</para>
  <para style="q2" vid="OBA 1:6">afịd mme ndedịbe inie amọ eyaekoono!<verse eid="OBA 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7" />Afịd mme nsaña mfo eyaunək fiin ekenịm ke adaña;</para>
  <para style="q2" vid="OBA 1:7">mme ufan mfo eyaubiaaña enyʌñ ukan fiin udịd;</para>
  <para style="q1" vid="OBA 1:7">mbon e-etaaha uyo mfo eyaekọọk afia enịm unọ fiin,</para>
  <para style="q2" vid="OBA 1:7">ado afo uduudiọọñọke.<verse eid="OBA 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8" />“Ke usen ado,” <char style="nd">Abọọñ</char> atañ,</para>
  <para style="q2" vid="OBA 1:8">“nte ami ndiisoboke mbon aniọñ Edọm,</para>
  <para style="q2" vid="OBA 1:8">mme anie ifiọk awo ke mme abod Isọ?<verse eid="OBA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9" />Mbon ekọñ mfo, Teman, eyaekop ndịk,</para>
  <para style="q2" vid="OBA 1:9">ye afịd awo ke mme ikpọabod Isọ</para>
  <para style="q2" vid="OBA 1:9">eyaekpịkke ammọ esio.<verse eid="OBA 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10" />Ato ke ntak afai a-afo anamma ye ayịneka mfo Yekọb,</para>
  <para style="q2" vid="OBA 1:10">abuud ayaufʌk fiin;</para>
  <para style="q2" vid="OBA 1:10">eyausobo fiin ke nsi-nsi.<verse eid="OBA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11" />Ke usen a-afo akedaaha nsan-nsan</para>
  <para style="q2" vid="OBA 1:11">idaha i-isenawo eketañña inie amọ enyọñ,</para>
  <para style="q1" vid="OBA 1:11">mbon asenidịd enyʌñ edʌk mme inuaatob amọ,</para>
  <para style="q2" vid="OBA 1:11">enyʌñ esịn afia ebaña Yeruselem,</para>
  <para style="q2" vid="OBA 1:11">afo akeba nte awo ammọ keed.<verse eid="OBA 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12" />Inaaha afo adaara abaña ayịneka mfo</para>
  <para style="q2" vid="OBA 1:12">ke usen nnananyen amọ,</para>
  <para style="q1" vid="OBA 1:12">me adaara abaña mbon Yuda</para>
  <para style="q2" vid="OBA 1:12">ke usen nsobo ammọ,</para>
  <para style="q1" vid="OBA 1:12">me aduaak inua eti-eti</para>
  <para style="q2" vid="OBA 1:12">ke usen mfịna ammọ.<verse eid="OBA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13" />Inaaha afo asaña aboiyo ke inuaatob ikọd mmi</para>
  <para style="q2" vid="OBA 1:13">ke usen afanekọñ ammọ,</para>
  <para style="q1" vid="OBA 1:13">me asak ammọ ke mfịna ammọ</para>
  <para style="q2" vid="OBA 1:13">ke usen afanekọñ ammọ,</para>
  <para style="q1" vid="OBA 1:13">me aben inie ammọ</para>
  <para style="q2" vid="OBA 1:13">ke usen afanekọñ ammọ.<verse eid="OBA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14" />Inaaha afo ada ke mme ñwaaña usʌñ</para>
  <para style="q2" vid="OBA 1:14">adikpịkke mbon efeeñeke mfịna,</para>
  <para style="q1" vid="OBA 1:14">me asaana mme ñyọhọnsʌhọ ammọ anọ</para>
  <para style="q2" vid="OBA 1:14">ke usen mfịna ammọ.<verse eid="OBA 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15" />“Usen <char style="nd">Abọọñ</char> akpere</para>
  <para style="q2" vid="OBA 1:15">anọ afịd mme idịd.</para>
  <para style="q1" vid="OBA 1:15">Naña afo anam, ediinam ntoro unọ fiin;</para>
  <para style="q2" vid="OBA 1:15">mme adinam mfo ayaatịmme udoro fiin ke iwuod.<verse eid="OBA 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16" />Kpa naña afo akenwọñ ke adisana abod mmi,</para>
  <para style="q2" vid="OBA 1:16">ntoro ke afịd mme idịd ediikaiso inwọñ;</para>
  <para style="q1" vid="OBA 1:16">ammọ eyaenwọñ emaana enwọñ,</para>
  <para style="q2" vid="OBA 1:16">anyʌñ aba nte ammọ akenaanam ibaaha.<verse eid="OBA 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17" />Ado ubọkkọ adiiba ke Abod Saiyọn;</para>
  <para style="q2" vid="OBA 1:17">anye adiido adisana,</para>
  <para style="q2" vid="OBA 1:17">ndin Yekọb ayaaben udeeme amọ anie.<verse eid="OBA 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18" />Yekọb adiido ikañ;</para>
  <para style="q2" vid="OBA 1:18">Yosef ado edemeikañ;</para>
  <para style="q1" vid="OBA 1:18">Isọ adiido ikpotok,</para>
  <para style="q2" vid="OBA 1:18">ndin ammọ eyaesịn ikañ ke anye enyʌñ esobo anye.</para>
  <para style="q1" vid="OBA 1:18">Nsʌhọ ndomokeed idiibaaha</para>
  <para style="q2" vid="OBA 1:18">a-atooho Isọ.”</para>
  <para style="q1" vid="OBA 1:18">
    <char style="nd">Abọọñ</char> atañ.<verse eid="OBA 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19" />Mbon e-etooho Nekef ediidʌñ</para>
  <para style="q2" vid="OBA 1:19">ke ikpọabod Isọ,</para>
  <para style="q1" vid="OBA 1:19">ndin mbon usuuk abod eyaedat</para>
  <para style="q2" vid="OBA 1:19">isọñ mbon Filistia enie.</para>
  <para style="q1" vid="OBA 1:19">Ammọ eyaedʌñ ke inwañ Ifrem ye Sameria,</para>
  <para style="q2" vid="OBA 1:19">ndin Benyamin ayaadat Kilied.<verse eid="OBA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20" />Mbon Isrel e-eketañña efep e-edʌññọ ke Kenan</para>
  <para style="q2" vid="OBA 1:20">eyaedat isọñ Sarefad enie;</para>
  <para style="q1" vid="OBA 1:20">mbon ekebịneke esio ke Yeruselem e-ebaaha ke Sefarad</para>
  <para style="q2" vid="OBA 1:20">eyaedat mme abio Nekef enie.<verse eid="OBA 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21" />Mme anyaaña awo eyaedọọk ekaa ke Abod Saiyọn,</para>
  <para style="q2" vid="OBA 1:21">nọ ekekaara mme ikpọabod Isọ.</para>
  <para style="q2" vid="OBA 1:21">Ndin abioubọọñ adiinie <char style="nd">Abọọñ</char>.<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>