  <para style="h">Sefanaiya</para>
  <para style="toc1">Sefanaiya</para>
  <para style="toc2">Sefanaiya</para>
  <para style="toc3">Sef</para>
  <para style="mt1">Sefanaiya</para>
  <chapter number="1" style="c" sid="ZEP 1" />
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1" />Ikọ <char style="nd">Abọọñ</char> a-akediighe abịne Sefanaiya ayịn Kuusi, ayịn Kedalia, ayịn Amaria, ayịn Hesikaiya, ke ini ukara Yosaiya ayịn Amọn, adidem Yuda:<verse eid="ZEP 1:1" /></para>
  <para style="b" />
  <para style="s1">Ubiomikpe Afịd Ederimbod ke Usen <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 1:2" />“Ami ñyaakwọọk afịd ñkpọ nsịññe</para>
  <para style="q2" vid="ZEP 1:2">ke iso isọñ,”</para>
  <para style="q2" vid="ZEP 1:2">
    <char style="nd">Abọọñ</char> atañ.<verse eid="ZEP 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 1:3" />“Ami ñyaakwọọk awo ye unam naña iba nduọọk;</para>
  <para style="q2" vid="ZEP 1:3">ami ñyaakwọọk mme inuen ke anyọñ</para>
  <para style="q2" vid="ZEP 1:3">ye iyak ke akpainyañ,</para>
  <para style="q2" vid="ZEP 1:3">ye mme ubobodñkpọ e-ekenamma mbon ibak eduọññọ.”</para>
  <para style="b" vid="ZEP 1:3" />
  <para style="q1" vid="ZEP 1:3">“Ke ini ami nsoboke afịd ubon awo</para>
  <para style="q2" vid="ZEP 1:3">ke iso isọñ,”</para>
  <para style="q2" vid="ZEP 1:3">
    <char style="nd">Abọọñ</char> atañ,<verse eid="ZEP 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 1:4" />“Ami ñyaanyan ubọk mmi ñnwana ye Yuda,</para>
  <para style="q2" vid="ZEP 1:4">ye afịd mbon se idʌñọ ke Yeruselem.</para>
  <para style="q1" vid="ZEP 1:4">Ami ñyaasobo afịd nsʌhọ mbon ukpono Baal ke itie ami,</para>
  <para style="q2" vid="ZEP 1:4">kpa mme anyịñ mme aku ndem,<verse eid="ZEP 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 1:5" />mbon e-etuakka iwuod ke anyọñ akọm</para>
  <para style="q2" vid="ZEP 1:5">ekpono mme ntantaafiọñ,</para>
  <para style="q1" vid="ZEP 1:5">mbon e-etuakka iwuod enyʌñ enwọñọ ke anyịñ <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="ZEP 1:5">ye mbon e-enwọñọke ke anyịñ Molek<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">Ke usem Hibru ado </char><char style="fqa" closed="false">Malkam</char></note>,<verse eid="ZEP 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 1:6" />mbon e-ewọññọke edem ekpọñ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ZEP 1:6">inyʌññọ iyem <char style="nd">Abọọñ</char> me adibịp mbaña anye.”<verse eid="ZEP 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 1:7" />Idop uyio ke iso <char style="nd">Abọọñ</char> Andikara,</para>
  <para style="q2" vid="ZEP 1:7">sia usen <char style="nd">Abọọñ</char> akpere.</para>
  <para style="q1" vid="ZEP 1:7">
    <char style="nd">Abọọñ</char> a-abeeñe uwa;</para>
  <para style="q2" vid="ZEP 1:7">anye amaadiọñ mbon se anye akekoot idem.<verse eid="ZEP 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 1:8" />“Ke usen uwa <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="ZEP 1:8">ami ñyaanọ mme adaaha ufen,</para>
  <para style="q2" vid="ZEP 1:8">ye nditọ adidem</para>
  <para style="q1" vid="ZEP 1:8">ye mbon esịneke</para>
  <para style="q2" vid="ZEP 1:8">mme afọñ isen idịd.<verse eid="ZEP 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 1:9" />Ke usen ado ñyaaben ufen nnọ</para>
  <para style="q2" vid="ZEP 1:9">afịd mbon e-etreke adidọọk ke inuausʌñ,</para>
  <para style="q1" vid="ZEP 1:9">e-eyọhọke tembịd mme abasi ammọ</para>
  <para style="q2" vid="ZEP 1:9">ye afai ye abiaña.<verse eid="ZEP 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 1:10" />“Ke usen ado,”</para>
  <para style="q2" vid="ZEP 1:10">
    <char style="nd">Abọọñ</char> atañ,</para>
  <para style="q1" vid="ZEP 1:10">“aseeme ayaadọọk ato ke Inuaatob Iyak,</para>
  <para style="q2" vid="ZEP 1:10">ntuaña ato ke Ufa Efaak,</para>
  <para style="q2" vid="ZEP 1:10">ñkpo anyʌñ asuana ke mme ntək abod.<verse eid="ZEP 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 1:11" />Itua, ndufo e-edʌñọke ke anwa udua;</para>
  <para style="q2" vid="ZEP 1:11">eyaesobo afịd mme anyam udua ndufo esịññe,</para>
  <para style="q2" vid="ZEP 1:11">eyaesobo afịd mbon e-enyamma udua ke silfa.<verse eid="ZEP 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 1:12" />Ke ini ado ami ñyaakama mme utuenikañ ñyeem Yeruselem</para>
  <para style="q2" vid="ZEP 1:12">ñnyʌñ nnọ mbon e-ebaaha ke ndueidem ufen,</para>
  <para style="q2" vid="ZEP 1:12">e-etieghe nte ukọd a-asʌhọke ke anyọñ ntak amọ,</para>
  <para style="q1" vid="ZEP 1:12">e-ekereke ebo ke, ‘<char style="nd">Abọọñ</char> idiinamma ñkpọ ndomokeed,</para>
  <para style="q2" vid="ZEP 1:12">me eti me idiọọk.’<verse eid="ZEP 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 1:13" />Eyaetañ inie ammọ ke mbịme,</para>
  <para style="q2" vid="ZEP 1:13">ewuut mme ufọk ammọ.</para>
  <para style="q1" vid="ZEP 1:13">Akpekọm ammọ ebọọp mme ufọk,</para>
  <para style="q2" vid="ZEP 1:13">ammọ idiidʌññọ ke esịd;</para>
  <para style="q1" vid="ZEP 1:13">akpekọm ammọ etọ mme inwañ fain,</para>
  <para style="q2" vid="ZEP 1:13">ammọ idiinwọññọ ukọd ado.”<verse eid="ZEP 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 1:14" />Ekamba usen <char style="nd">Abọọñ</char> akpere,</para>
  <para style="q2" vid="ZEP 1:14">akpere anyʌñ adi usọp-usọp.</para>
  <para style="q1" vid="ZEP 1:14">Ayịd ke usen <char style="nd">Abọọñ</char> ado ndod-ndod;</para>
  <para style="q2" vid="ZEP 1:14">Uko ke Ekọñ a-asio ñkpo ekọñ amọ.<verse eid="ZEP 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 1:15" />Usen ado adiido usen ifiobesịd,</para>
  <para style="q2" vid="ZEP 1:15">usen ukuud ye nnananyen,</para>
  <para style="q3" vid="ZEP 1:15">usen mfịna ye nsobo,</para>
  <para style="q2" vid="ZEP 1:15">usen ekịm ye akonayio,</para>
  <para style="q3" vid="ZEP 1:15">usen ntọñanyọñ ye abubịd,<verse eid="ZEP 1:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="ZEP 1:16" />usen adukpoñ ye uyom ñkpo ekọñ</para>
  <para style="q1" vid="ZEP 1:16">abaña mme abio ebọppọ nọ asọñ,</para>
  <para style="q2" vid="ZEP 1:16">anyʌññọ abaña mme itiad inuuk tọwa.<verse eid="ZEP 1:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 1:17" />“Utọ ukuud ado ke ndiiben nsọk afịd awo,</para>
  <para style="q2" vid="ZEP 1:17">nọ ammọ eweweere ubọk esaña nte mbon edọñọke nnan,</para>
  <para style="q2" vid="ZEP 1:17">sia ammọ enam <char style="nd">Abọọñ</char> idiọọkñkpọ.</para>
  <para style="q1" vid="ZEP 1:17">Eyaenwañña iyiib ammọ nte ntọñ</para>
  <para style="q2" vid="ZEP 1:17">ñkpọ esịdidịb ammọ nte uduañ.<verse eid="ZEP 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 1:18" />Kpak silfa me kold ammọ</para>
  <para style="q2" vid="ZEP 1:18">idiikanna inyaaña ammọ</para>
  <para style="q2" vid="ZEP 1:18">ke usen ifiobesịd <char style="nd">Abọọñ</char>.”</para>
  <para style="b" vid="ZEP 1:18" />
  <para style="q1" vid="ZEP 1:18">Ikañ ufịb amọ</para>
  <para style="q2" vid="ZEP 1:18">ayaata afịd ederimbod,</para>
  <para style="q1" vid="ZEP 1:18">sia anye ayaanam utịd adi ini keed</para>
  <para style="q2" vid="ZEP 1:18">abaña afịd awo e-edʌñọke ke ederimbod.<verse eid="ZEP 1:18" /></para>
  <chapter eid="ZEP 1" />
  <chapter number="2" style="c" sid="ZEP 2" />
  <para style="s1">Ekpe Ikpe Yuda ye Yeruselem ye mme Idịd</para>
  <para style="s2">Ekoot Yuda Ebo Akappa Esịd</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 2:1" />Isoobo atọ keed, isoobo idem ndufo atọ keed,</para>
  <para style="q2" vid="ZEP 2:1">ndufo idịd ndọk,<verse eid="ZEP 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 2:2" />mbemiso ewʌhọ ado atọọñọ adat itie</para>
  <para style="q2" vid="ZEP 2:2">ndin usen ado aboiyo nte mbio ake afịm abenne,</para>
  <para style="q1" vid="ZEP 2:2">mbemiso ikañ-ikañ iyadesịd <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="ZEP 2:2">adi ibịne ndufo,</para>
  <para style="q1" vid="ZEP 2:2">mbemiso usen ifiobesịd <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="ZEP 2:2">adi ibịne ndufo,</para>
  <para style="q1" vid="ZEP 2:2">mbemiso usen ifiobesịd <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="ZEP 2:2">adi ibịne ndufo.<verse eid="ZEP 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 2:3" />Iyem <char style="nd">Abọọñ</char>, afịd ndufo mbon nsuukidem ke isọñ,</para>
  <para style="q2" vid="ZEP 2:3">ndufo e-enamma se anye awuuk.</para>
  <para style="q1" vid="ZEP 2:3">Iyem adinenido, iyem nsuukidem;</para>
  <para style="q2" vid="ZEP 2:3">akpenam me eyainọ ndufo itie udịbe</para>
  <para style="q2" vid="ZEP 2:3">ke usen iyadesịd <char style="nd">Abọọñ</char>.<verse eid="ZEP 2:3" /></para>
  <para style="s2">Filistia</para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 2:4" />Eyaewuọñọ ekpọñ Kasa</para>
  <para style="q2" vid="ZEP 2:4">ndin eyaekpọñ Askelọn ke nsobo.</para>
  <para style="q1" vid="ZEP 2:4">Ke ufọọd uweemeayio Asdọd adiina ukpọk,</para>
  <para style="q2" vid="ZEP 2:4">enyʌñ ewịppe Ekrọn esio.<verse eid="ZEP 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 2:5" />Adọdiọọk inọ ndufo mbon e-edʌñọke ke mben akpainyañ,</para>
  <para style="q2" vid="ZEP 2:5">ndufo mbon Kered;</para>
  <para style="q1" vid="ZEP 2:5">ikọ <char style="nd">Abọọñ</char> a-asua inọ ndufo,</para>
  <para style="q2" vid="ZEP 2:5">Kenan, isọñ mbon Filistia.</para>
  <para style="q1" vid="ZEP 2:5">Anye abo, “Ami ñyaisobo ndufo,</para>
  <para style="q2" vid="ZEP 2:5">ndin ndomokeed idiisʌhọke.”<verse eid="ZEP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 2:6" />Isọñ ke mben akpainyañ ayaakappa ado udia ufene,</para>
  <para style="q2" vid="ZEP 2:6">a-anieñeke ube mmọọñ anọ mme akpemeedọñ</para>
  <para style="q2" vid="ZEP 2:6">ye aba ubono udịmedọñ.<verse eid="ZEP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 2:7" />Isọñ ado ayaakappa anie</para>
  <para style="q2" vid="ZEP 2:7">nsʌhọ mbon Yuda;</para>
  <para style="q2" vid="ZEP 2:7">do ke ammọ ediikịt udia ufene.</para>
  <para style="q1" vid="ZEP 2:7">Ke ndubiayio ammọ eyaesuuk enaa</para>
  <para style="q2" vid="ZEP 2:7">ke mme ufọk Askelọn.</para>
  <para style="q1" vid="ZEP 2:7">
    <char style="nd">Abọọñ</char> Abasi ammọ ayaakpeme ammọ;</para>
  <para style="q2" vid="ZEP 2:7">anye ayaatịmme anọ ammọ inie ammọ.<verse eid="ZEP 2:7" /></para>
  <para style="s2">Mọb ye Amọn</para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 2:8" />“Ami mmaakop mme usọñanyen mbon Mọb</para>
  <para style="q2" vid="ZEP 2:8">ye mme nsueñ mbon Amọn,</para>
  <para style="q1" vid="ZEP 2:8">e-ekesọññọ ikọd mmi anyen,</para>
  <para style="q2" vid="ZEP 2:8">enyʌñ enam adusad ebaña idʌñ ammọ.<verse eid="ZEP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 2:9" />Ke ntoro, ma uwem mmi,”</para>
  <para style="q2" vid="ZEP 2:9">
    <char style="nd">Abọọñ</char> Andikponñkan atañ,</para>
  <para style="q2" vid="ZEP 2:9">kpa Abasi Isrel,</para>
  <para style="q1" vid="ZEP 2:9">“ke akpanikọ Mọb ayaakappa atie nte Sọdọm,</para>
  <para style="q2" vid="ZEP 2:9">mbon Amọn nte Komora,</para>
  <para style="q1" vid="ZEP 2:9">itie a-mbid akọttọ ye itie mme ube inʌñ,</para>
  <para style="q2" vid="ZEP 2:9">nsi-nsi ndoon.</para>
  <para style="q1" vid="ZEP 2:9">Ikọd mmi se isʌhọ eyaetañ ammọ nte mbịme;</para>
  <para style="q2" vid="ZEP 2:9">mme aduuwem ke idịd mmi eyaedat isọñ ammọ enie.”<verse eid="ZEP 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 2:10" />Ami ado se ammọ ediibọ nte utịb ntañidem ammọ,</para>
  <para style="q2" vid="ZEP 2:10">ke ammọ adisuenne ñnyʌñ mmiom</para>
  <para style="q2" vid="ZEP 2:10">ikọd <char style="nd">Abọọñ</char> Andikponñkan.<verse eid="ZEP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 2:11" />
    <char style="nd">Abọọñ</char> ayaado uteeñe anọ ammọ</para>
  <para style="q2" vid="ZEP 2:11">ke ini anye asoboke afịd mme abasi ke ederimbod.</para>
  <para style="q1" vid="ZEP 2:11">Mme idịd ke anyan itie eyaetuak iwuod enọ anye,</para>
  <para style="q2" vid="ZEP 2:11">afịd ammọ ke isọñ ammọ.<verse eid="ZEP 2:11" /></para>
  <para style="s2">Kuus</para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 2:12" />“Ndufo mbon Kuus, ñko,</para>
  <para style="q2" vid="ZEP 2:12">eyaekpañña ke akañkañ mmi.”<verse eid="ZEP 2:12" /></para>
  <para style="s2">Asiria</para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 2:13" />Anye ayaanyan ubọk amọ ase adoro,</para>
  <para style="q2" vid="ZEP 2:13">anyʌñ asobo Asiria,</para>
  <para style="q1" vid="ZEP 2:13">akpọñ Ninife ataa ukpọk</para>
  <para style="q2" vid="ZEP 2:13">ye nsaad nte akpautatan.<verse eid="ZEP 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 2:14" />Mme udịmedọñ ye udịmenañ eyaesuuk enaa do,</para>
  <para style="q2" vid="ZEP 2:14">afịd aduuk mme unam.</para>
  <para style="q1" vid="ZEP 2:14">Ñkịdikịd akpautatan ye asio ñkpo ñkịdikịd</para>
  <para style="q2" vid="ZEP 2:14">eyaedọñọ ke mme adaaha amọ.</para>
  <para style="q1" vid="ZEP 2:14">Eyaekop uyio ammọ ke mme ubenafịm,</para>
  <para style="q2" vid="ZEP 2:14">ñwuudo ammọ ayaayọhọ ke mme inuausʌñ</para>
  <para style="q2" vid="ZEP 2:14">eyaefuuño mme atekke sida.<verse eid="ZEP 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 2:15" />Anye ami ado abio akpọsọñ uyom idaara</para>
  <para style="q2" vid="ZEP 2:15">a-akesibaaha ke ifuuro.</para>
  <para style="q1" vid="ZEP 2:15">Anye akebo idem amọ,</para>
  <para style="q2" vid="ZEP 2:15">“Ami ndo ukweeñe-ukweeñe! Ndin mfen ibaaha ke imiibọhọke ami.”</para>
  <para style="q1" vid="ZEP 2:15">Anye anam die akappa nsobo,</para>
  <para style="q2" vid="ZEP 2:15">itie nnaa mme ndiọi unam!</para>
  <para style="q1" vid="ZEP 2:15">Afịd mbon e-esañake eboiyo anye esaha</para>
  <para style="q2" vid="ZEP 2:15">enyʌñ efʌñ ubọk ammọ.<verse eid="ZEP 2:15" /></para>
  <chapter eid="ZEP 2" />
  <chapter number="3" style="c" sid="ZEP 3" />
  <para style="s2">Yeruselem</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 3:1" />Adọdiọọk anọ abio mbon ufiik awo,</para>
  <para style="q2" vid="ZEP 3:1">e-esọọñọ iwuod enyʌñ esappa idem!<verse eid="ZEP 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 3:2" />Anye ikoppo item inọ awo ndomokeed,</para>
  <para style="q2" vid="ZEP 3:2">anye inyịmmeke ntʌnọ.</para>
  <para style="q1" vid="ZEP 3:2">Anye ibuọttọ idem ye <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ZEP 3:2">anye isịkkeke ikpere Abasi amọ.<verse eid="ZEP 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 3:3" />Mme adaaha ke esịd amọ</para>
  <para style="q2" vid="ZEP 3:3">edoñño mme ekpe e-ekuunọkuun;</para>
  <para style="q1" vid="ZEP 3:3">mme andikara amọ edoñño ewaikọd ndubiayio,</para>
  <para style="q2" vid="ZEP 3:3">i-imiisʌhọke ñkpọ ndomokeed inịm inọ ubakusen.<verse eid="ZEP 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 3:4" />Mme prọfed amọ ikponoke idem;</para>
  <para style="q2" vid="ZEP 3:4">ammọ edoñño mbon mbubịk.</para>
  <para style="q1" vid="ZEP 3:4">Mme aku amọ esappa adisana itie,</para>
  <para style="q2" vid="ZEP 3:4">enyʌñ enam afai ke mbed.<verse eid="ZEP 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 3:5" />
    <char style="nd">Abọọñ</char> a-abaaha ke esịd amọ ado adinen;</para>
  <para style="q2" vid="ZEP 3:5">anye inamma ndudue.</para>
  <para style="q1" vid="ZEP 3:5">Kwa ubakusen anye akpe ikpe amọ ke unen,</para>
  <para style="q2" vid="ZEP 3:5">ndin afịd ufa usen anye itreke,</para>
  <para style="q2" vid="ZEP 3:5">kpayeado awo ukwañido ikoppo abuud.<verse eid="ZEP 3:5" /></para>
  <para style="s2">Yeruselem Ikappake Esịd</para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 3:6" />“Ami mmesobo mme idịd;</para>
  <para style="q2" vid="ZEP 3:6">mmewuut mme ñkpọsọñ itie ammọ.</para>
  <para style="q1" vid="ZEP 3:6">Ami mmekpọñ mme efaak ammọ ukpọk,</para>
  <para style="q2" vid="ZEP 3:6">awo ndomokeed isañake iboiyo.</para>
  <para style="q1" vid="ZEP 3:6">Mme abio ammọ enaa nte anaan;</para>
  <para style="q2" vid="ZEP 3:6">mme awo ibaaha, ena ukpọk.<verse eid="ZEP 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 3:7" />Ke abaña Yeruselem ami ñkekere,</para>
  <para style="q2" vid="ZEP 3:7">‘Ke afo ayañkpono miin ke akpanikọ,</para>
  <para style="q2" vid="ZEP 3:7">anyʌñ anyịmme ibọ ntuunọ!’</para>
  <para style="q1" vid="ZEP 3:7">Ndin awo ikpisoboke itie udịbe amọ,</para>
  <para style="q2" vid="ZEP 3:7">afịd mme ufen mmi ikpidoroke anye ke idem.</para>
  <para style="q1" vid="ZEP 3:7">Ado ammọ ekesʌk eyeyem</para>
  <para style="q2" vid="ZEP 3:7">adinam ñwo ke afịd se ammọ enam.<verse eid="ZEP 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 3:8" />Ke ntoro ida imbet miin,” <char style="nd">Abọọñ</char> atañ,</para>
  <para style="q2" vid="ZEP 3:8">“ke usen a-ami ndiidakka nda nnọ ikọ ntiense.</para>
  <para style="q1" vid="ZEP 3:8">Ami mmaanyịmme aditañ mme idịd mbon,</para>
  <para style="q2" vid="ZEP 3:8">adibon mme abio ndidem,</para>
  <para style="q1" vid="ZEP 3:8">ñnyʌñ ñnwañña ifiobesịd mmi ndoot ammọ ke idem,</para>
  <para style="q2" vid="ZEP 3:8">afịd ikañ-ikañ iyadesịd mmi.</para>
  <para style="q1" vid="ZEP 3:8">Eyaesobo afịd ederimbod</para>
  <para style="q2" vid="ZEP 3:8">ke ikañ iyadesịd ufịb mmi.<verse eid="ZEP 3:8" /></para>
  <para style="s1">Utañ Nsʌhọ Isrel Ntịmme Ñnyọñ</para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 3:9" />“Amaakem ami ñyaanam mme ñkpọkinua ikọd mmi esana,</para>
  <para style="q2" vid="ZEP 3:9">nọ afịd ammọ ekpekoot anyịñ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ZEP 3:9">enyʌñ enam ñkpọ enọ anye esịd keed.<verse eid="ZEP 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 3:10" />Tọọñọ ke edem inyañ Kuus,</para>
  <para style="q2" vid="ZEP 3:10">mbon e-eñkponoke miin, ikọd mmi e-ekesuanake,</para>
  <para style="q2" vid="ZEP 3:10">eyaeben mme enọ ensọk miin.<verse eid="ZEP 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 3:11" />Ke usen ado afo, Yeruselem, abuud iduunamma fiin</para>
  <para style="q2" vid="ZEP 3:11">ke afịd ndudue a-afo akennamma miin,</para>
  <para style="q1" vid="ZEP 3:11">sia ami ñyaasio ke idem mfo mfep</para>
  <para style="q2" vid="ZEP 3:11">mbon ñkokkoidem ye ñkpooninua.</para>
  <para style="q1" vid="ZEP 3:11">Ndufo idiinieghe ntañidem aba</para>
  <para style="q2" vid="ZEP 3:11">ke adisana abod mmi.<verse eid="ZEP 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 3:12" />Ado ñyaakpọñ ke atu ndufo</para>
  <para style="q2" vid="ZEP 3:12">mbon ime ye nsuukidem.</para>
  <para style="q1" vid="ZEP 3:12">Nsʌhọ Isrel</para>
  <para style="q2" vid="ZEP 3:12">eyaebuọt idem ke anyịñ <char style="nd">Abọọñ</char>.<verse eid="ZEP 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 3:13" />Mme ñyọhọnsʌhọ Isrel idiinamma ndudue;</para>
  <para style="q2" vid="ZEP 3:13">ammọ idiisʌhọke nsu.</para>
  <para style="q1" vid="ZEP 3:13">Edeme abiaña</para>
  <para style="q2" vid="ZEP 3:13">idiibaaha ke inua ammọ.</para>
  <para style="q1" vid="ZEP 3:13">Ammọ eyaedia ñkpọ enyʌñ esuuk enaa</para>
  <para style="q2" vid="ZEP 3:13">ndin awo ndomokeed idiinamma ammọ ekop ndịk.”<verse eid="ZEP 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 3:14" />Kwọ ikwọ, Adiaha Saiyọn;</para>
  <para style="q2" vid="ZEP 3:14">sio ñkpo, Isrel!</para>
  <para style="q1" vid="ZEP 3:14">Nem esịd nyʌñ daara ke afịd esịd mfo,</para>
  <para style="q2" vid="ZEP 3:14">Adiaha Yeruselem!<verse eid="ZEP 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 3:15" />
    <char style="nd">Abọọñ</char> a-abenne ufen mfo afep,</para>
  <para style="q2" vid="ZEP 3:15">anye amaanam mme asua mfo etịmme edem.</para>
  <para style="q1" vid="ZEP 3:15">
    <char style="nd">Abọọñ</char>, Adidem Isrel, mmọdo ye afo;</para>
  <para style="q2" vid="ZEP 3:15">afo uduufegheke ndịk aba ubaña idiọọk ndomokeed.<verse eid="ZEP 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 3:16" />Ke usen ado</para>
  <para style="q2" vid="ZEP 3:16">ammọ eyaebo Yeruselem,</para>
  <para style="q1" vid="ZEP 3:16">“Kuufeghe, Saiyọn;</para>
  <para style="q2" vid="ZEP 3:16">kuuyak ubọk mfo amem.<verse eid="ZEP 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 3:17" />
    <char style="nd">Abọọñ</char> Abasi mfo mmọdo ye afo,</para>
  <para style="q2" vid="ZEP 3:17">Uko ke Ekọñ a-anyaañake.</para>
  <para style="q1" vid="ZEP 3:17">Anye ayaanie ekamba idadesịd ke afo;</para>
  <para style="q2" vid="ZEP 3:17">ke ima amọ anye iduuduatta fiin aba ke nsuannọ,</para>
  <para style="q2" vid="ZEP 3:17">ado ayaudaara fiin ke ikwọ.”<verse eid="ZEP 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 3:18" />“Ami ñyaasịññe ke atu ndufo,</para>
  <para style="q2" vid="ZEP 3:18">afịd mbon se ifʌhọ ibaña mme adimek usọrọ mfo,</para>
  <para style="q2" vid="ZEP 3:18">a-adooho mbiomo ye asuenne inọọ ndufo.<verse eid="ZEP 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ZEP 3:19" />Ke ini ado ami ñyaafʌnnọ</para>
  <para style="q2" vid="ZEP 3:19">afịd mbon e-ekifiighe ndufo.</para>
  <para style="q1" vid="ZEP 3:19">Ami ñyaanyaaña mbʌñọ;</para>
  <para style="q2" vid="ZEP 3:19">ñyaatañ mbon ntañmfeb mbok.</para>
  <para style="q1" vid="ZEP 3:19">Ami ñyaanọ ammọ itooro ye ukpono</para>
  <para style="q2" vid="ZEP 3:19">ke afịd idʌñ a-ammọ ekebọọhọ ufen abuud.<verse eid="ZEP 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ZEP 3:20" />Ke ini ado ami ñyaitañ ndufo mbon;</para>
  <para style="q2" vid="ZEP 3:20">ke ini ado ami ñyaiben ndufo ñnyọñ ufọk.</para>
  <para style="q1" vid="ZEP 3:20">Ami ñyainọ ndufo ukpono ye itooro</para>
  <para style="q2" vid="ZEP 3:20">ke atu afịd mbon awo ke ederimbod,</para>
  <para style="q1" vid="ZEP 3:20">ke ini ami ntịmmeke inọọ ndufo inie ndufo</para>
  <para style="q2" vid="ZEP 3:20">kpa ke iso ndufo,”</para>
  <para style="q2" vid="ZEP 3:20">
    <char style="nd">Abọọñ</char> atañ.<verse eid="ZEP 3:20" /></para>
  <chapter eid="ZEP 3" />
</usx>