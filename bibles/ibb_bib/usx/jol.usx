  <para style="h">Yuel</para>
  <para style="toc1">Yuel</para>
  <para style="toc2">Yuel</para>
  <para style="toc3">Yuel</para>
  <para style="mt1">Yuel</para>
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />Anye ami ado ikọ <char style="nd">Abọọñ</char> a-akediighe abịne Yuel ayịn Petuel.<verse eid="JOL 1:1" /></para>
  <para style="b" />
  <para style="s1">Nsobo Ñkukuñkpọyọriyọ</para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2" />Ndufo mme ñkpisọñ, ikop ami;</para>
  <para style="q2" vid="JOL 1:2">afịd mbon se idʌñọ ke isọñ ikpañ utọñ.</para>
  <para style="q1" vid="JOL 1:2">Nte utọ ñkpọ se iba ntom atịppe akpa ke ayio ndufo,</para>
  <para style="q2" vid="JOL 1:2">me ke ini mme eteete ndufo?<verse eid="JOL 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3" />Itañ inọ nditọ ndufo,</para>
  <para style="q2" vid="JOL 1:3">nọ nditọ ndufo ñko etañ enọ nditọ ammọ,</para>
  <para style="q2" vid="JOL 1:3">nditọ ammọ enyʌñ etañ enọ emana mfen.<verse eid="JOL 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4" />Se mme udịm ñkukuñkpọyọriyọ eta esʌhọ</para>
  <para style="q2" vid="JOL 1:4">mme ikpọ ñkukuñkpọyọriyọ e-eta;</para>
  <para style="q1" vid="JOL 1:4">se mme ikpọ ñkukuñkpọyọriyọ eta esʌhọ</para>
  <para style="q2" vid="JOL 1:4">mme ñyịn ñkukuñkpọyọriyọ e-eta;</para>
  <para style="q1" vid="JOL 1:4">se mme ñyịn ñkukuñkpọyọriyọ eta esʌhọ</para>
  <para style="q2" vid="JOL 1:4">mme ñkukuñkpọyọriyọ mfen e-eta.<verse eid="JOL 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5" />Ndufo mbon inaam ukọd, idemme, inyʌñ itua ayịd!</para>
  <para style="q2" vid="JOL 1:5">Etua ebọñ ñkpo, afịd ndufo mme anwọñ ukọd;</para>
  <para style="q1" vid="JOL 1:5">itua ibọñ ñkpo ke ntak ufa ukọd,</para>
  <para style="q2" vid="JOL 1:5">sia ifịppe ndufo ukọd esio ke ñkpọkinua.<verse eid="JOL 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6" />Idịd keed a-adʌk adi anwan ke abio mmi,</para>
  <para style="q2" vid="JOL 1:6">akwa udịmekọñ a-awo idiikanna ibat;</para>
  <para style="q1" vid="JOL 1:6">anye anie eded ekpe,</para>
  <para style="q2" vid="JOL 1:6">anie mbañ uman ekpe.<verse eid="JOL 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7" />Anye a-abiat inwañ fain mmi,</para>
  <para style="q2" vid="JOL 1:7">anyʌñ asobo mme eto fik mmi.</para>
  <para style="q1" vid="JOL 1:7">Anye a-akwat mme ikpọk eto ayaaña,</para>
  <para style="q2" vid="JOL 1:7">anyʌñ atop anye aduọọk,</para>
  <para style="q2" vid="JOL 1:7">akappa mme ñkọk ammọ anịm afia.<verse eid="JOL 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8" />Fʌhọ nte mboppo a-asịneke afọñikpo,</para>
  <para style="q2" vid="JOL 1:8">a-atuaha abaña ebe uyịn amọ.<verse eid="JOL 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9" />E-ebiat enọ ñkpasi ye mme enọ ukọd</para>
  <para style="q2" vid="JOL 1:9">efep ke ufọk <char style="nd">Abọọñ</char>.</para>
  <para style="q1" vid="JOL 1:9">Mme aku eba ke ntuaña,</para>
  <para style="q2" vid="JOL 1:9">mbon e-enamma utom ke iso <char style="nd">Abọọñ</char>.<verse eid="JOL 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10" />E-esobo mme inwañ ado,</para>
  <para style="q2" vid="JOL 1:10">isọñ asat;</para>
  <para style="q1" vid="JOL 1:10">e-esobo mme ñkpasi,</para>
  <para style="q2" vid="JOL 1:10">ufa ukọd asat,</para>
  <para style="q2" vid="JOL 1:10">adan ọlif iwuọhọ aba.<verse eid="JOL 1:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11" />Ndufo mme atọ inwañ iduọọk idodanyen,</para>
  <para style="q2" vid="JOL 1:11">isio ñkpo, ndufo mme atọ fain;</para>
  <para style="q1" vid="JOL 1:11">ifʌhọ ibaña abakpa mbakara ye baali,</para>
  <para style="q2" vid="JOL 1:11">sia esobo idọk inwañ.<verse eid="JOL 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12" />Fain asaat</para>
  <para style="q2" vid="JOL 1:12">ñko eto fik ayeppe;</para>
  <para style="q1" vid="JOL 1:12">mme pomekrened, ayob ye eto apịl,</para>
  <para style="q2" vid="JOL 1:12">afịd mme eto ke inwañ, esaat.</para>
  <para style="q1" vid="JOL 1:12">Ke akpanikọ idaara mme awo</para>
  <para style="q2" vid="JOL 1:12">akpa mfʌhọ.<verse eid="JOL 1:12" /></para>
  <para style="s1">Ikood Adinam Aseeme</para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13" />Ndufo mme aku, isịne afọñikpo, inyʌñ ifʌhọ;</para>
  <para style="q2" vid="JOL 1:13">itua ayịd, ndufo e-enamma utom ke iso akpokoro uwa.</para>
  <para style="q1" vid="JOL 1:13">Ndufo idi, isịne afọñikpo ke afịd akonayio,</para>
  <para style="q2" vid="JOL 1:13">ndufo e-enamma ñkpọ ke iso Abasi mmi,</para>
  <para style="q1" vid="JOL 1:13">sia emʌm mme enọ ñkpasi ye mme enọ ukọd</para>
  <para style="q2" vid="JOL 1:13">ekama ke ufọk Abasi ndufo.<verse eid="JOL 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14" />Ndufo ikoot adisana utreudia;</para>
  <para style="q2" vid="JOL 1:14">ikoot akwa esob mbon nti esịd.</para>
  <para style="q1" vid="JOL 1:14">Idọñ ekoot mme ñkpisọñ</para>
  <para style="q2" vid="JOL 1:14">ye afịd awo se idʌñ ke abio,</para>
  <para style="q1" vid="JOL 1:14">yak edi ufọk Abọọñ Abasi ndufo,</para>
  <para style="q2" vid="JOL 1:14">enyʌñ eseeme enọ <char style="nd">Abọọñ</char>.<verse eid="JOL 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15" />Mbọm usen ado!</para>
  <para style="q2" vid="JOL 1:15">Sia usen <char style="nd">Abọọñ</char> akpere;</para>
  <para style="q2" vid="JOL 1:15">anye adiidi nte nsobo a-atooho Andikponñkan<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">Ke usem Hibru ado </char><char style="fqa" closed="false">Sadai</char></note>.<verse eid="JOL 1:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16" />Nte awo ikpịkkeke ndidia isio</para>
  <para style="q2" vid="JOL 1:16">ke iso ñnyịn,</para>
  <para style="q1" vid="JOL 1:16">idaara ye inemesịd</para>
  <para style="q2" vid="JOL 1:16">ifep ke ufọk Abasi ñnyịn?<verse eid="JOL 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17" />Mme ñkpasi e-efiime</para>
  <para style="q2" vid="JOL 1:17">ke idak ebohontan.</para>
  <para style="q1" vid="JOL 1:17">Mme afe ubonoñkpọ e-ewuudo,</para>
  <para style="q2" vid="JOL 1:17">e-ewuut mme aba ubono ñkpasi,</para>
  <para style="q2" vid="JOL 1:17">sia mme ñkpasi ndidia e-esaat.<verse eid="JOL 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18" />Mme ufene eba ke mmịm!</para>
  <para style="q2" vid="JOL 1:18">Mme udịmenañ ewuọñọ ekpọọrọ,</para>
  <para style="q1" vid="JOL 1:18">sia ammọ inieghe itie awawa mbid;</para>
  <para style="q2" vid="JOL 1:18">kpa mme udịmedọñ ñko esʌk ebọ ufen.<verse eid="JOL 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19" />
    <char style="nd">Abọọñ</char>, afo ke ami mbọọñ ñkoot,</para>
  <para style="q2" vid="JOL 1:19">sia ikañ asobo mme itie awawa mbid ke anaan,</para>
  <para style="q2" vid="JOL 1:19">edemeikañ a-anyʌñ ata afịd eto ke inwañ.<verse eid="JOL 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20" />Itọñ mfo adọñ kpa mme ndiọi unam;</para>
  <para style="q2" vid="JOL 1:20">mme idịm mmọọñ esat</para>
  <para style="q2" vid="JOL 1:20">ñko ikañ afọp mme itie awawa mbid ke anaan.<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="s1">Udịmekọñ Ñkukuñkpọyọriyọ</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1" />Ifịt adukpoñ ke Saiyọn;</para>
  <para style="q2" vid="JOL 2:1">Ibọñ ñkpọ ke adisana abod mmi.</para>
  <para style="b" vid="JOL 2:1" />
  <para style="q1" vid="JOL 2:1">Yak afịd mbon se idʌñ ke abio enyeñ idem,</para>
  <para style="q2" vid="JOL 2:1">sia usen adidi <char style="nd">Abọọñ</char> asʌk adi.</para>
  <para style="q1" vid="JOL 2:1">Anye akpere ama,<verse eid="JOL 2:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="JOL 2:2" />usen ekịm ye mfʌhọ,</para>
  <para style="q2" vid="JOL 2:2">usen ntọñanyọñ ye ekịm.</para>
  <para style="q1" vid="JOL 2:2">Nte naña usiere atara afʌk mme ikpọabod,</para>
  <para style="q2" vid="JOL 2:2">ekamba ye akpọsọñ udịmekọñ esʌk edi,</para>
  <para style="q1" vid="JOL 2:2">utọ i-idiikibaaha akpa ke ini esed,</para>
  <para style="q2" vid="JOL 2:2">idiinyʌññọ ibaba ke mme ini iso.<verse eid="JOL 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3" />Ikañ abem ammọ iso asobo,</para>
  <para style="q2" vid="JOL 2:3">edemeikañ ñko asak akeene ammọ ke edem.</para>
  <para style="q1" vid="JOL 2:3">Isọñ ke iso ammọ aba nte inwañ Idịn,</para>
  <para style="q2" vid="JOL 2:3">ukpọk akpautatan aba ammọ ke edem,</para>
  <para style="q2" vid="JOL 2:3">ñkpọ ndomokeed ibọhọke ammọ.<verse eid="JOL 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4" />Ammọ ebit mme enañmbakara;</para>
  <para style="q2" vid="JOL 2:4">enyʌñ etaam itọk nte mbon ekọñ ewatta enañmbakara.<verse eid="JOL 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5" />Ammọ etataam ke mme anyọñ ikpọabod,</para>
  <para style="q2" vid="JOL 2:5">ye uyom a-abaaha nte ake mme sariọd,</para>
  <para style="q1" vid="JOL 2:5">ukem nte edemeikañ a-ataaha ikpotok abakpa,</para>
  <para style="q2" vid="JOL 2:5">nte akpọsọñ mbon ekọñ e-ekaaha iso ekọñ.<verse eid="JOL 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6" />Mme idịd eba ke ayeemensia, ke adikịt ammọ iso;</para>
  <para style="q2" vid="JOL 2:6">afịd iso awo aduọkkọ.<verse eid="JOL 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7" />Ammọ ebịmme nte mme anwana ekọñ;</para>
  <para style="q2" vid="JOL 2:7">ammọ etamma ndibene nte mbon ekọñ.</para>
  <para style="q1" vid="JOL 2:7">Afịd ammọ esaña ke udịm,</para>
  <para style="q2" vid="JOL 2:7">ammọ iwuọhọ ikpọñ usʌñisañ ammọ.<verse eid="JOL 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8" />Ammọ idutọọrọke ye emọ-emọ;</para>
  <para style="q2" vid="JOL 2:8">ammọ keedekeed esaña ekaa iso ke nnen-nnen usʌñ.</para>
  <para style="q1" vid="JOL 2:8">Ammọ etamma efrọ mme ñkpọ ubiọọñọ,</para>
  <para style="q2" vid="JOL 2:8">ado idutịmeke udịm ammọ.<verse eid="JOL 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9" />Ammọ ebịmme edʌk abio;</para>
  <para style="q2" vid="JOL 2:9">enyʌñ efeeñe eboiyo ke anyọñ ndibene.</para>
  <para style="q1" vid="JOL 2:9">Ammọ edọọk edʌk mme ufọk;</para>
  <para style="q2" vid="JOL 2:9">ammọ eto ubenafịm edʌk nte mbon inọ.<verse eid="JOL 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10" />Isọñ anyeeñe ke iso ammọ,</para>
  <para style="q2" vid="JOL 2:10">anyọñ ñko anyeeñe,</para>
  <para style="q1" vid="JOL 2:10">utịn ye afiọñ ekappa abubịd,</para>
  <para style="q2" vid="JOL 2:10">ntantaafiọñ ñko iyammake aba.<verse eid="JOL 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11" />
    <char style="nd">Abọọñ</char> aduat ke akpọsọñ uyio,</para>
  <para style="q2" vid="JOL 2:11">ke iso mbon ekọñ amọ;</para>
  <para style="q1" vid="JOL 2:11">awo ikanna ibat udịmekọñ amọ,</para>
  <para style="q2" vid="JOL 2:11">mbon ekọñ se ikop uyio amọ edo mme ñkpọsọñ.</para>
  <para style="q1" vid="JOL 2:11">Usen <char style="nd">Abọọñ</char> akpon;</para>
  <para style="q2" vid="JOL 2:11">anyʌñ anie ataa ndịk.</para>
  <para style="q2" vid="JOL 2:11">Anie akeme adiyọ anye?<verse eid="JOL 2:11" /></para>
  <para style="s1">Iwai Esịd Ndufo</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12" />
    <char style="nd">Abọọñ</char> abo, “Kpa idahami,</para>
  <para style="q2" vid="JOL 2:12">itịmme imbịne miin ke afịd esịd ndufo,</para>
  <para style="q2" vid="JOL 2:12">ke utreudia ye ntuaña ye mfʌhọ.”<verse eid="JOL 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13" />Iwai esịd ndufo,</para>
  <para style="q2" vid="JOL 2:13">ikiiwai mme afọñ ndufo.</para>
  <para style="q1" vid="JOL 2:13">Itịmme ibịne <char style="nd">Abọọñ</char> Abasi ndufo,</para>
  <para style="q2" vid="JOL 2:13">sia anye afọn ido anyʌñ anie mbọm,</para>
  <para style="q1" vid="JOL 2:13">isọppọ iyadesịd ado ayọhọ ye ima,</para>
  <para style="q2" vid="JOL 2:13">ñko anye iwakka adinọ awo ufen.<verse eid="JOL 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14" />Anie idiọọñọ? Anye akeme ikappa esịd anyʌñ akpəho</para>
  <para style="q2" vid="JOL 2:14">ndin akappa anọ adidiọñ,</para>
  <para style="q1" vid="JOL 2:14">mme enọ ñkpasi ye mme enọ ukọd,</para>
  <para style="q2" vid="JOL 2:14">enọ <char style="nd">Abọọñ</char> Abasi ndufo.<verse eid="JOL 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15" />Ifịt adukpoñ ke Saiyọn,</para>
  <para style="q2" vid="JOL 2:15">isian adisana utreudia,</para>
  <para style="q2" vid="JOL 2:15">ikoot akwa esob mbon nti esịd.<verse eid="JOL 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16" />Ikoot mme awo ibok,</para>
  <para style="q2" vid="JOL 2:16">idiọñ esob mbon nti esịd,</para>
  <para style="q1" vid="JOL 2:16">ikoot mme ñkpisọñ ibok itie keed,</para>
  <para style="q2" vid="JOL 2:16">ikoono ntəkayịn ibono itie keed,</para>
  <para style="q2" vid="JOL 2:16">kpa ye mbon se iwọp eba.</para>
  <para style="q1" vid="JOL 2:16">Yak ebendọ akpọñ ubeed amọ,</para>
  <para style="q2" vid="JOL 2:16">anwaan ndọ anyʌñ akpọñ ikʌk ndọ amọ.<verse eid="JOL 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17" />Yak mme aku, e-enamma utom ke iso <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="JOL 2:17">etua ayịd ke ufọọd esa ye akpokoro uwa.</para>
  <para style="q1" vid="JOL 2:17">Yak amọ ebo: “<char style="nd">Abọọñ</char>, tua ikọd mfo mbọm.</para>
  <para style="q2" vid="JOL 2:17">Kuuyak ikọd mfo edo ñkpọ nsaha,</para>
  <para style="q2" vid="JOL 2:17">ñkpọ ekpọhọ ikọ ke atu mme idịd.</para>
  <para style="q1" vid="JOL 2:17">Nsoo ido ntak a-ammọ ekpebooho ke atu mme awo ete,</para>
  <para style="q2" vid="JOL 2:17">‘Abasi ammọ aba ke mmọọ?’ ”<verse eid="JOL 2:17" /></para>
  <para style="s1">Ibọọrọ <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18" />Akem <char style="nd">Abọọñ</char> amaafịbe ufịb abaña isọñ amọ,</para>
  <para style="q2" vid="JOL 2:18">anyʌñ akop mbọm anọ ikọd amọ.<verse eid="JOL 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOL 2:19" />Ndin <char style="nd">Abọọñ</char> amaabọọrọ ammọ ate:</para>
  <para style="q1" vid="JOL 2:19">“Ami ñyaanọ abakpa, ufa ukọd ye adan ọlif isọk ndufo,</para>
  <para style="q2" vid="JOL 2:19">se idiikem inyʌñ inekke iyʌkkọ ndufo;</para>
  <para style="q1" vid="JOL 2:19">tutu amama ami ndiinamma ndufo edo ñkpọ nsaha aba</para>
  <para style="q2" vid="JOL 2:19">enọ mme idịd.<verse eid="JOL 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20" />“Ami ñyaabịne uwak atu awo e-etooho adoro ñkaa anyan usʌñ ikpọñ ndufo,</para>
  <para style="q2" vid="JOL 2:20">ñyaanək ammọ ñkedọñ ke nsaad ikpu-ikpu isọñ;</para>
  <para style="q1" vid="JOL 2:20">atu mbon ammọ ke usakkautịn eyaesịp ke Ñkpaikpa Inyañ.</para>
  <para style="q2" vid="JOL 2:20">Ñko atu mbon ammọ ke usobutịn eyaesịp ke Akpainyañ Mediterenia.</para>
  <para style="q1" vid="JOL 2:20">Ñko utebe ammọ ayaawuọ adọọk;</para>
  <para style="q2" vid="JOL 2:20">ufịk ammọ ayaawuọ adọọk adi.”</para>
  <para style="b" vid="JOL 2:20" />
  <para style="q1" vid="JOL 2:20">Ke akpanikọ anye a-anam mme ikpọ ñkpọ!<verse eid="JOL 2:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="JOL 2:21" />Isọñ Yuda, kuufeghe ndịk;</para>
  <para style="q2" vid="JOL 2:21">nem esịd nyʌñ daara.</para>
  <para style="q1" vid="JOL 2:21">Ke akpanikọ <char style="nd">Abọọñ</char> a-anam mme ikpọ ñkpọ!<verse eid="JOL 2:21" /></para>
  <para style="q2">
    <verse number="22" style="v" sid="JOL 2:22" />Ndufo mme ndiọi unam, ikiifeghe ndịk,</para>
  <para style="q2" vid="JOL 2:22">sia mme mbid ke unaisọñ etọọñọ ediseghe.</para>
  <para style="q1" vid="JOL 2:22">Mme eto esʌk enwịm mfịd;</para>
  <para style="q2" vid="JOL 2:22">eto fik ye fain enwịm ayọhọ mfịd ammọ.<verse eid="JOL 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23" />Nditọ Saiyọn, inem esịd,</para>
  <para style="q2" vid="JOL 2:23">idaara ke <char style="nd">Abọọñ</char> Abasi ndufo,</para>
  <para style="q1" vid="JOL 2:23">sia anye inọọ ndufo akpa inua edịm,</para>
  <para style="q2" vid="JOL 2:23">sia anye ado anam akpanikọ.</para>
  <para style="q1" vid="JOL 2:23">Anye inọọ ndufo uwak mbara,</para>
  <para style="q2" vid="JOL 2:23">akpa inua edịm ye akpatre inua edịm, naña akesido.<verse eid="JOL 2:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24" />Eyaedọñ abakpa ayọhọ mme afe ubeek abakpa,</para>
  <para style="q2" vid="JOL 2:24">ikịm ayaayọhọ aduọiyọ ye ufa ukọd ye adan ọlif.<verse eid="JOL 2:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25" />“Ami ñyainọ ndufo usiene ke abaña mme isua edem a-mme ñkukuñkpọyọriyọ eketaaha,</para>
  <para style="q2" vid="JOL 2:25">ikpọ ñkukuñkpọyọriyọ ye ñyịn ñkukuñkpọyọriyọ,</para>
  <para style="q2" vid="JOL 2:25">mme utọ ñkukuñkpọyọriyọ mfen, ye ekamba udịm ñkukuñkpọyọriyọ,</para>
  <para style="q1" vid="JOL 2:25">ekamba udịmekọñ a-ami ñkenọọhọ adi atu ndufo.<verse eid="JOL 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26" />Ndufo eyaenie uwak ndidia se edia tutu iyʌkkọ ndufo,</para>
  <para style="q2" vid="JOL 2:26">eyaenyʌñ etooro anyịñ <char style="nd">Abọọñ</char> Abasi ndufo,</para>
  <para style="q2" vid="JOL 2:26">a-anamma mme utịppeñkpọ inọọ ndufo;</para>
  <para style="q1" vid="JOL 2:26">ñko ikọd mmi idiikịtte abuud aba ke nsi-nsi.<verse eid="JOL 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27" />Ndin ndufo eyaediọọñọ ke ami mmọdo ke Isrel,</para>
  <para style="q2" vid="JOL 2:27">ke ami ndo <char style="nd">Abọọñ</char> Abasi ndufo,</para>
  <para style="q2" vid="JOL 2:27">ñko ke mfen ibaaha;</para>
  <para style="q1" vid="JOL 2:27">ikọd mmi idiikịtte abuud aba ke nsi-nsi.<verse eid="JOL 2:27" /></para>
  <para style="s1">Usen <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28" />“Ndin ke ami amaaboiyo,</para>
  <para style="q2" vid="JOL 2:28">ami ñyaanwañña Sịbidịd mmi nduọk afịd awo ke idem.</para>
  <para style="q1" vid="JOL 2:28">Nditọ ndufo ideen ye ibaan eyaetañ prọfesi,</para>
  <para style="q2" vid="JOL 2:28">ñkaan ideen ndufo eyaedappa ndab,</para>
  <para style="q2" vid="JOL 2:28">ñkparawa ideen ndufo eyaekịt ñkukịd.<verse eid="JOL 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29" />Kpa ye nditọufọk mmi, ideen ye ibaan,</para>
  <para style="q2" vid="JOL 2:29">ami ñyaanwañña Sịbidịd mmi ndot ammọ ke mme usen ado.<verse eid="JOL 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30" />Ami ñyaawọt mme utịppeñkpọ ke mme hefịn</para>
  <para style="q2" vid="JOL 2:30">ye ke isọñ,</para>
  <para style="q2" vid="JOL 2:30">iyiib ye ikañ ye mme eboho nsʌñikañ.<verse eid="JOL 2:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31" />Utịn ayaakappa ado ekịm,</para>
  <para style="q2" vid="JOL 2:31">afiọñ ayaanyʌñ akappa iyiib,</para>
  <para style="q2" vid="JOL 2:31">mbemiso adidi ekamba ye anie ndịk usen <char style="nd">Abọọñ</char>.<verse eid="JOL 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32" />Ndin afịd awo se ikoot</para>
  <para style="q2" vid="JOL 2:32">anyịñ <char style="nd">Abọọñ</char> eyaebọkkọ;</para>
  <para style="q1" vid="JOL 2:32">sia ke Abod Saiyọn ye ke Yeruselem</para>
  <para style="q2" vid="JOL 2:32">ke ubọkkọ adiiba,</para>
  <para style="q2" vid="JOL 2:32">kpa naña <char style="nd">Abọọñ</char> atañ,</para>
  <para style="q1" vid="JOL 2:32">kpa ke atu mbon se isʌhọ</para>
  <para style="q2" vid="JOL 2:32">
    <char style="nd">A-Abọọñ</char> akoodo<note caller="+" style="f"><char style="fr" closed="false">2:32 </char><char style="ft" closed="false">Ke mme ikpañwed Hibru ewet Yu 2:28-32 nte Yu 3:1-5.</char></note>.<verse eid="JOL 2:32" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="s1">Ebiere ikpe mme Idịd</para>
  <para style="q1">
    <note caller="+" style="f">
      <char style="fr" closed="false">3: </char>
      <char style="ft" closed="false">Ke mme ikpañwed Hibru ewet Yu 3:1-21 nte Yu 4:1-21.</char>
    </note> <verse number="1" style="v" sid="JOL 3:1" />“Ke mme usen ado ye ke ini ado,</para>
  <para style="q2" vid="JOL 3:1">ke idaha a-ami mmaamaana ñkappa uforo nnọ Yuda ye Yeruselem,<verse eid="JOL 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2" />ami ñyaakoono afịd mme idịd mbok itie keed,</para>
  <para style="q2" vid="JOL 3:2">ñnyʌñ mben ammọ nsuuhọ ndi ke Abedeñ Yehosafad.<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fq" closed="false">Yehosafad</char><char style="ft" closed="false">awuọñọ </char><char style="fqa" closed="false">ke <char style="nd">Abọọñ</char></char><char style="fqa" closed="false">akpe ikpe;</char><char style="ft" closed="false">se ñko ke <char style="xt"><ref loc="JOL 3:12">Yuel 3:12</ref></char>. </char></note></para>
  <para style="q1" vid="JOL 3:2">Do ke ami ndiidaaha ammọ ke ikpe,</para>
  <para style="q2" vid="JOL 3:2">ke abaña se ammọ ekenam ye udeeme mmi, ikọd mmi Isrel,</para>
  <para style="q1" vid="JOL 3:2">sia ammọ emaesuan ikọd mmi ke atu mme idịd,</para>
  <para style="q2" vid="JOL 3:2">enyʌñ ebakka isọñ mmi.<verse eid="JOL 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3" />Ammọ emaesịn afia enọ ikọd mmi,</para>
  <para style="q2" vid="JOL 3:3">enyʌñ enyam nditọ ideen esịn ke akpara;</para>
  <para style="q2" vid="JOL 3:3">ammọ enyam nditọ ibaan enyʌñ edat akʌk ekama enwọñ ukọd.<verse eid="JOL 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4" />“Idahami nsoo ke ndufo enie edinam ye ami, Tai ye Sidọn ye afịd ndufo mbon Filistia? Ado nte ndufo ensio miin usiene ebaña ñkpọ se ami ñkenam? Akpedo ensio miin usiene, ami ñyaasọsọp mben usiene ñkpọ se ndufo enam idot ndufo ke iwuod. <verse eid="JOL 3:4" /><verse number="5" style="v" sid="JOL 3:5" />Sia ndufo emaetañ silfa ye kold mmi, enyʌñ ekoono ataa nti inie mmi esio ekaa ke tembịd ndufo. <verse eid="JOL 3:5" /><verse number="6" style="v" sid="JOL 3:6" />Ndufo emaenyam mbon Yuda ye Yeruselem enọ mbon Krik, nọ etañ ammọ esio eka ke anyan usʌñ ekpọñ isọñ emana ammọ.<verse eid="JOL 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOL 3:7" />“Se, ami ñyaademme ammọ nọ ewuọñọ eto mme itie se ndufo ekenyam ammọ, ñko ami ñyaaben usiene se ndufo ekenam ntịmme ndot ke iwuod ndufo. <verse eid="JOL 3:7" /><verse number="8" style="v" sid="JOL 3:8" />Ami ñyaanyam nditọ ideen ye ibaan ndufo nnọ ikọd Yuda, ndin ammọ eyaenyʌñ enyam ammọ enọ mbon Sabiin, a-adooho anyan idịd,” <char style="nd">Abọọñ</char> atañ.<verse eid="JOL 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9" />Isian ami ke atu mme idịd:</para>
  <para style="q2" vid="JOL 3:9">Ibeeñe idem inọ ekọñ!</para>
  <para style="q1" vid="JOL 3:9">Idemme mme anwana ekọñ!</para>
  <para style="q2" vid="JOL 3:9">Yak afịd ideen se isinwana ekọñ esaña ekpere enyʌñ enwana.<verse eid="JOL 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10" />Imia mme ukwak ukịmisọñ ndufo nọ ekappa akañkañ,</para>
  <para style="q2" vid="JOL 3:10">inyʌñ imia mme akọbọ udiọñeto ndufo nọ ekappa eduad,</para>
  <para style="q1" vid="JOL 3:10">Yak mme idek ebo,</para>
  <para style="q2" vid="JOL 3:10">“Ami mmekop adudu!”<verse eid="JOL 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11" />Isọp idi, afịd mme idịd ke afịd itie,</para>
  <para style="q2" vid="JOL 3:11">inyʌñ ibono do.</para>
  <para style="b" vid="JOL 3:11" />
  <para style="q1" vid="JOL 3:11">
    <char style="nd">Abọọñ</char>, ben mme anwana ekọñ mfo sọiyọ di!<verse eid="JOL 3:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12" />“Yak mme idịd edakka eda;</para>
  <para style="q2" vid="JOL 3:12">yak ammọ edʌk eka ke Abedeñ Yehosafad,</para>
  <para style="q1" vid="JOL 3:12">sia do ke ami ndiitie</para>
  <para style="q2" vid="JOL 3:12">adibiide ikpe nnọọ afịd mme idịd ke mme ñkanñkʌk.<verse eid="JOL 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13" />Ifịm ikwa ukpeeñe,</para>
  <para style="q2" vid="JOL 3:13">sia ini idọk akem.</para>
  <para style="q1" vid="JOL 3:13">Ndufo idi, inuak mme kreb,</para>
  <para style="q2" vid="JOL 3:13">sia ukwak unam ukọd ayọhọ,</para>
  <para style="q2" vid="JOL 3:13">mme abañ ukọd enyʌñ eyọhọ eduọi,</para>
  <para style="q1" vid="JOL 3:13">ibak ammọ anekke akpon!”<verse eid="JOL 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14" />Mme udịm awo, mme udịm awo</para>
  <para style="q2" vid="JOL 3:14">ke abedeñ ñkpembiere!</para>
  <para style="q1" vid="JOL 3:14">Sia usen <char style="nd">Abọọñ</char> adikpere</para>
  <para style="q2" vid="JOL 3:14">ke abedeñ ñkpembiere.<verse eid="JOL 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15" />Utịn mme afiọñ eyaenwen,</para>
  <para style="q2" vid="JOL 3:15">ndin ntantaafiọñ idiiyammake aba.<verse eid="JOL 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16" />
    <char style="nd">Abọọñ</char> ayaato ke Saiyọn akuun,</para>
  <para style="q2" vid="JOL 3:16">anyʌñ asakka nte aduma ato ke Yeruselem;</para>
  <para style="q2" vid="JOL 3:16">isọñ ye mme anyọñ eyaenyeeñe.</para>
  <para style="q1" vid="JOL 3:16">Ado <char style="nd">Abọọñ</char> ayaado itie udịbe anọ ikọd amọ,</para>
  <para style="q2" vid="JOL 3:16">ayaado itie ubọkkọ anọ mbon Isrel.<verse eid="JOL 3:16" /></para>
  <para style="s1">Adidiọñ Ikọd Abasi</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17" />“Do ndin afo ayaadiọọñọ ke ami, <char style="nd">Abọọñ</char> Abasi mfo,</para>
  <para style="q2" vid="JOL 3:17">ndʌñ ke Saiyọn, adisana abod mmi.</para>
  <para style="q1" vid="JOL 3:17">Yeruselem adiido adisana;</para>
  <para style="q2" vid="JOL 3:17">mme isenawo idiinamma ekọñ ye anye aba.<verse eid="JOL 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18" />“Ke usen ado ufa ukọd ayaatọi ato ke mme ikpọabod adi,</para>
  <para style="q2" vid="JOL 3:18">mmọọñeba ayaanyʌñ afiọrọ ke mme ntək abod;</para>
  <para style="q2" vid="JOL 3:18">ñko mmọọñ ayaafeghe ke afịd mme itịkke Yuda.</para>
  <para style="q1" vid="JOL 3:18">Inua mmọọñ ayaawuọ ato ufọk <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="JOL 3:18">ayaanyʌñ akedeññe abedeñ akasia.<verse eid="JOL 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19" />Ado Iyib ayaadʌk ke ñwuudo,</para>
  <para style="q2" vid="JOL 3:19">Edọm ñko adiido ukpọk akpautatan,</para>
  <para style="q1" vid="JOL 3:19">ato ke ntak afai e-ekenamma mbon Yuda,</para>
  <para style="q2" vid="JOL 3:19">ke adiduọk iyiib mbon i-imiidueghe ke isọñ ammọ.<verse eid="JOL 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20" />Mme awo eyaedʌñ ke Yuda ke nsi-nsi,</para>
  <para style="q2" vid="JOL 3:20">eyaenyʌñ edʌñ ke Yeruselem ke afịd emana.<verse eid="JOL 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21" />Nte ami ñyaayaak iyiib mbon se imiidueghe ñkpọ atak?</para>
  <para style="q2" vid="JOL 3:21">Iyoo, ami ndiiyakka.”</para>
  <para style="b" vid="JOL 3:21" />
  <para style="qc" vid="JOL 3:21">
    <char style="nd">Abọọñ</char> adọdʌñ ke Saiyọn!<verse eid="JOL 3:21" /></para>
  <chapter eid="JOL 3" />
</usx>